( បាត់ដំបង ) ៖ លោក បណ្ឌិត កៅ ថា ច ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ ធនាគារ អភិវឌ្ឍន៍ ជនបទ និង កសិកម្ម និង ឧកញ៉ា ចាន់ សុឃាំង ប្រធាន សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា (CRF) នៅ ព្រឹក ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ចូលរួម កិច្ចប្រជុំ ប្រចាំ ខែ ដើម្បី ពិនិត្យ តាមដាន ស្ថានភាព ស្រូវ អង្ករ ។
កិច្ចប្រជុំ ប្រចាំ ខែ នេះ ធ្វើឡើង ក្នុង គោលបំណ ង៖
១ - ពង្រឹង សាមគ្គីភាព នៃ ពាណិជ្ជករ ក្នុង វិស័យ ស្រូវ អង្ករ រួម មាន៖ រោង ម៉ាស៊ីន កិន ស្រូវ ក្រុមហ៊ុន កែច្នៃ សម្រាប់ ការនាំចេញ ក្នុង ខេត្ត បាត់ដំបង បន្ទាយមានជ័យ និង ពោធិ៍សាត់
៣ - ពិនិត្យ និង ពិភាក្សា លើ ស្ថានភាព ទីផ្សារ នាំចេញ អង្ករ ដូច ជា៖ ប្រទេស ឥណ្ឌូនេស៊ី ហ្វីលីពីន ជាដើម
៤ - ពិភាក្សា លើ បញ្ហា ប្រឈម នានា . និង លើក ដំដោះស្រាយ ដើម្បី កែលម្អ និង ដាក់ចេញ នូវ ចំណាត់ការ ចំពោះមុខ ក្នុង កំរិត សមាជិក នៃ សហព័ន្ធ ស្រូវ អង្ករ និង
សូម បញ្ជាក់ ផងដែរ ថា នេះ ជា កិច្ចប្រជុំ ធ្វើឡើង ជារៀងរាល់ ខែ និង ជាប្រចាំ ដើម្បី តាមដាន ស្ថានភាព ស្រូវ អង្ករ រវាង ធនាគារ អភិវឌ្ឍន៍ ជនបទ និង កសិកម្ម និង សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ដែល មាន ការចូលរួម ពី តំណាង រោង ម៉ាស៊ីន កិន ស្រូវ និង ក្រុមហ៊ុន នាំចេញ អង្ករ ប្រចាំ ខេត្ត ពោធិ៍សាត់ បាត់ដំបង និង ខេត្ត បន្ទាយមានជ័យ ៕ ស្អែក នេះ រដ្ឋមន្ដ្រី កែវ រតនៈ នឹង អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង អគ្គ នាយក ថ្មី របស់ អគ្គិសនី កម្ពុជា
( ភ្នំពេញ ) ៖ តាម ការគ្រោងទុក នៅ ព្រឹក ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២៣ ស្អែក នេះ លោក កែវ រតនៈ រដ្ឋមន្ដ្រី ក្រសួង រ៉ែ និង ថាមពល នឹង អញ្ជើញ ចូលរួម ជា អធិបតីភាព ក្នុង ពិធី ប្រកាស ចូលកាន់ តំណែង អគ្គ នាយក ថ្មី របស់ អគ្គិសនី កម្ពុជា លោក ប្រាំង ជល សា ដែល ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង នា ពេល ថ្មី ៗ កន្លងទៅ នេះ ។
ពិធី ប្រកាស ចូលកាន់ តំណែង នេះ មាន ការអញ្ជើញ ចូលរួម ពី ឥស្សរជន និង ថ្នាក់ដឹកនាំ មក ពី ក្រសួង រ៉ែ និង ថាមពល . ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ . អាជ្ញាធរ អគ្គិសនី កម្ពុជា និង អគ្គិសនី កម្ពុជា ។ ពិធី នេះ នឹង ធ្វើឡើង នាទី ស្ដីការអគ្គិសនី កម្ពុជា ។
សូម រំលឹក ថា អគ្គ នាយក ថ្មី អគ្គិសនី កម្ពុជា លោក ប្រាំង ជល សា កើត ក្នុង ឆ្នាំ ១៩៧៤ នៅ រាជធានី ភ្នំពេញ ។ ក្រោយពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ត្រូវបាន ផ្តួលរលំ លោក បាន ត្រលប់ ពី ការជម្លៀស ជិត ៤ឆ្នាំ មក ភ្នំពេញ វិញ ហើយ បាន ចូល រៀន នៅ សាលា ឫស្សីកែវ និង បញ្ចប់ មធ្យមសិក្សា កម្រិត ២ នៅ សាលា ភ្នំ ដូន ពេញ នៅ ឆ្នាំ ១៩៩០ ។
លោក ប្រាំង ជល សា បាន បន្ត ការសិក្សា នៅ វិទ្យាស្ថាន បច្ចេកទេស ជាន់ ខ្ពស់ មិត្តភាព កម្ពុជា សូវៀត តាមរយៈ ការប្រឡង ប្រជែង ដ៏ តឹងរ៉ឹង ហើយ បាន បញ្ចប់ ថ្នាក់ វិស្វករ អគ្គិសនី នៅ ឆ្នាំ ១៩៩៥ ។
លោក ក៏ បាន ទទួល ការបណ្តុះបណ្តាល ក្នុង វគ្គ អប់រំនយោបាយ សម្រាប់ យុវជន បន្ត វេន កម្រិត ១ ក្នុង ជំនាន់ ទី២៥ និង កម្រិត ២ ក្នុង ជំនាន់ ទី១ នៅ ទីស្នាក់ការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ផងដែរ ។
លោក ប្រាំង ជល សា បាន ចូល ក្របខ័ណ្ឌ អគ្គិសនី កម្ពុជា នៅ ឆ្នាំ ១៩៩៦ ហើយ បាន ធ្វើ ការ ជាប់ លាប់ ចាប់ពី ដើម ឆ្នាំ ២០០១ បន្ទាប់ពី បញ្ចប់ ការសិក្សា នៅ ប្រទេស បារាំង ។
លោក បាន បន្ត ការងារ តាម លំដាប់ថ្នាក់ មាន តួនាទី តាំងពី មន្រ្តី ធម្មតា រហូតដល់ ទទួលបាន ការតែងតាំង ជា អគ្គ នាយក អគ្គិសនី កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០២៣ ដែល មាន បទពិសោធន៍ ជា អ្នកបច្ចេកទេស នាំមុខ ក្នុង ការងារ ដោះស្រាយ ការងារ នានា ទាំង បញ្ហា ប្រឈម បន្ទាន់ ក៏ ដូចជា យុទ្ធសាស្រ្ត វែងឆ្ងាយ ដោយ ផ្តោត យក ផលប្រយោជន៍ ជាតិ ជា ចំបង និង បាន កសាង ប្រព័ន្ធ អគ្គិសនី រួមទាំង ការងារ សហប្រតិបត្តិការ ជាមួយ ស្ថាប័ន បរទេស នាំមក នូវ ផ្លែ ផ្កា ជា ទី មោទនៈ ជូន ជាតិ ។
ក្រៅពី ការងារ ជំនាញ លោក ប្រាំង ជល សា តែងតែ ចូលរួម យ៉ាង សកម្ម ក្នុង ការងារ សង្គម មនុស្សធម៌ នយោបាយ ដើម្បី គាំទ្រ គោល នយោបាយ រាជ រដ្ឋាភិបាល ដែល ទទួលបាន លទ្ធផល ល្អ ប្រសើរ គួរ ជា ទី គាប់ ចិត្ត ។ ភាពជោគជ័យ ការងារ របស់ លោក ប្រាំង ជល សា ទទួលបាន ដោយសារ ការបណ្តុះបណ្តាល ណែនាំ និង គាំទ្រ បន្ថែម ពី ថ្នាក់ដឹកនាំ មន្រ្តី គ្រប់ លំដាប់ថ្នាក់ ទាំងអស់ ក្នុង វិស័យ ថាមពល ក៏ដូចជា មហាជន ទូទៅ ជាពិសេស ដោយ ផ្ទាល់ ពី លោក កែវ រតនៈ និង លោក ស៊ុយ សែម ៕
របាយការណ៍ បញ្ជាក់ ទៀត ថា គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ៣០២ លើក បាន ឆក់ យក ជីវិត ប្រជាពលរដ្ឋ ចំនួន ១៣៩ នាក់ ( ស្លាប់ ៤.៤នាក់ ក្នុង ១ ថ្ងៃ ) ក្នុង នោះ អ្នកស្លាប់ ១០៩ នាក់ ឬ ៧៨ ភាគរយ ជា អ្នកធ្វើដំណើរ ដោយ ម៉ូតូ ខណៈ ៨នាក់ អ្នកធ្វើដំណើរ ដោយ រថយន្ត តូច . ៣នាក់ អ្នកធ្វើដំណើរ ដោយ រថយន្ត ធំ . ៧នាក់ ធ្វើដំណើរ តាម យាន ផ្សេង ៗ និង ១២នាក់ ជា អ្នក ថ្មើរជើង ។
ដោយឡែក សម្រាប់ អ្នក រងរបួស វិញ នៅ ខែសីហា ឆ្នាំ ២០២៣ អ្នក រងរបួស ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ មាន ចំនួន ៤០៩ នាក់ ( ១៣នាក់ ក្នុង ១ ថ្ងៃ ) ក្នុង នោះ អ្នកធ្វើដំណើរ ដោយ ម៉ូតូ ចំនួន ២៨២ នាក់ ស្មើនឹង ៦៩% . ធ្វើដំណើរ តាម រថយន្ត តូច ៩០ នាក់ . ធ្វើដំណើរ តាម រថយន្ត ធំ ១៤ នាក់ . ធ្វើដំណើរ តាម យាន ផ្សេង ៗ ៩នាក់ និង ថ្មើរជើង ១៤នាក់ ៕ ក្រុមការងារ គណបក្ស ចុះ ជួយ មូលដ្ឋាន ឃុំ ឆ្នុក ទ្រូ ចុះ ជួប សំណេះសំណាល និង ថ្លែងអំណរ អរគុណ ក្រុមការងារ ថ្នាក់ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ ( ខ្មែរ ឥស្លាម )
( កំពង់ឆ្នាំង ) ៖ ក្រុមការងារ គណបក្ស ចុះ ជួយ មូលដ្ឋាន ឃុំ ឆ្នុក ទ្រូ នា ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ ដឹកនាំ ដោយ លោក សូ ស៊ី នួន និង លោកស្រី ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ មូលដ្ឋាន ឃុំ ឆ្នុក ទ្រូ បាន ចុះ ជួប សំណេះសំណាល និង ថ្លែងអំណរ អរគុណ ដល់ ក្រុមការងារ ថ្នាក់ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ ( ខ្មែរ ឥស្លាម ) ចំណុច យុគន្ធរ នៅ ភូមិ ឆ្នុក ទ្រូ ។
ក្នុង នោះ ក៏ មាន ការ អម ដំណើរ ពី លោក ប៉ែន សំបូរ . លោក សុខ សន និង លោកស្រី អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ព្រមទាំង លោក សោម ភិរុណ និង ស្រី ក្រុមការងារ ថ្នាក់ ខេត្ត ។
ពី ធី នេះ ដោយ មាន ការចូលរួម យ៉ាង ច្រើន កុះករ ពី ប្រជាពលរដ្ឋ ដែល បាន ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ សម្រាប់ នីតិកាល ទី៧ កាលពី ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ កន្លងមក នេះ មាន សម្លេង គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា លេខរៀង ទី ១៨ ទទួលបាន នូវ លទ្ធផល ល្អ យ៉ាង គាប់ ប្រសើរ មាន អត្រា សម្លេង សន្លឹក ស្មើនឹង ៩៧. ២៤% នៃ ចំនួន សមាជិក បក្ស សរុប ក្នុង ឃុំ ទាំងមូល ។
ទិដ្ឋភាព នេះ ប្រព្រឹត្តទៅ ដោយ មាន ការរៀបចំ អាហារ សាមគ្គី ប្រកបដោយ ក្តី រីករាយ សាទ រ ក្រៃលែង ផងដែរ ៕
អភិបាល ខេត្ត កំពង់ធំ ចុះ ដោះស្រាយ សំណូមពរ ពលរដ្ឋ ១៣១ គ្រួសារ លើ ទីតាំង ដី ប្រជាពលរដ្ឋ ប្រើប្រាស់ និង អាស្រ័យ ផល ក្នុង សហគមន៍ នេសាទ ស្រុក កំពង់ស្វាយ
លោក ងួន រតនៈ បាន ធ្វើ ការពិភាក្សា ជាមួយ អាជ្ញាធរ មូលដ្ឋាន មេភូមិ ប្រធាន សហគមន៍ ទាំង ពីរ និង ប្រជាពលរដ្ឋ ដែល បាន អាស្រ័យ នៅ តំបន់ នោះ ដើម្បី ដោះស្រាយ នូវ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ទាំង ១៣១ គ្រួសារ ស្នើសុំ កាត់ ជ្វាល ដី ធ្វើ ប័ណ្ណ កម្មសិទ្ធិ ស្រប ច្បាប់ ព្រោះ បច្ចុប្បន្ន ពួកគាត់ មិន ទាន់ មាន ប័ណ្ណ កម្មសិទ្ធិ នៅឡើយ ។
លោក ងួន រតនៈ បន្ត ទៀត ថា អាជ្ញាធរ ខេត្ត តែងតែ ខិតខំ ក្នុង ការដោះស្រាយ នូវ រាល់ សំណូមពរ និង បញ្ហា ជាក់ស្តែង របស់ ប្រជាពលរដ្ឋ តួយ៉ាង កន្លង មក រាជ រដ្ឋាភិបាល បាន សម្រេច ចេញ ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី ជូន ប្រជាពលរដ្ឋ ទទួលបាន យ៉ាង ច្រើន រួច មកហើយ ក្នុង ខេត្ត កំពង់ធំ យើង នេះ ដើម្បីឲ្យ ពួកគាត់ ប្រើប្រាស់ បាន ដោយ ស្រប ច្បាប់ និង មាន សិទ្ធិ ជា អចិន្ត្រៃយ៍ រហូត ។
អភិបាល ខេត្ត កំពង់ធំ ជំរុញ ការដោះស្រាយ កិច្ចការ នេះ ឱ្យ កាន់តែ ឆាប់រហ័ស ជាមួយ អាជ្ញាធរ មូលដ្ឋាន និង មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ទាំងអស់ ដែល មាន សិទ្ធិ សម្រេច កិច្ចការងារ នេះ មិន ទុកឲ្យ ប្រជាពលរដ្ឋ នៅ រងចាំ បន្ត ទៀត នោះ ទេ ។
លោក ងួន រតនៈ សំណូមពរ ដល់ ប្រជាពលរដ្ឋ សូម ចូលរួម សហការ ជាមួយ សមត្ថកិច្ច ក្នុង ការ ការពារ ទប់ស្កាត់ បទល្មើស នេសាទ គ្រប់ ប្រភេទ ដើម្បី អភិរក្ស ពូជ ត្រី ក្នុង ដែន សហគមន៍ នេសាទ ។
តាម ការបញ្ជាក់ ពី លោក អ៊ុត វណ្ណារ៉ា អភិបាល ស្រុក កំពង់ស្វាយ បាន ធ្វើ របាយការណ៍ សង្ខេប អំពី ប្រវត្តិ នៃ ការកកើត សហគមន៍ នេសាទ ទាំង ពីរ នេះ មាន ផ្ទៃដី សរុប ចំនួន ៩៣៩ ហិចតា ក្នុង នោះ ប្រជាពលរដ្ឋ ចំនួន ១៣១ គ្រួសារ ស្នើសុំ កាត់ ជ្វាល ដី ពី សហគមន៍ ទាំង ពីរ មាន ចំនួន ៧០. ៨៩ ហិចតា ហើយ ដី តំបន់ ខាងលើ ពោ ពេញ ទៅ ដោយ ទឹក លិច នៅ រដូវ វស្សា ដូចនេះ ប្រជាពលរដ្ឋ អាស្រ័យ ផល តាម អាកាសធាតុ និង តាម រដូវកាល ៕
អាវុធហត្ថ បញ្ជូន ក្មេង ទំនើង ៣នាក់ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី ហិង្សា នៅ ក្រុង ប៉ោយប៉ែត
( បន្ទាយមានជ័យ )៖ កាលពី វេលា ម៉ោង ២០៖ ១៥នាទី ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ប៉ោយប៉ែត ដឹកនាំ ដោយ លោក វរសេនីយ៍ ត្រី នួន នីណារ៉ូ មេបញ្ជាការ កងរាជអាវុធហត្ថ ក្រុង បាន ចុះ ឃាត់ខ្លួន ជនសង្ស័យ ៣នាក់ ករណី ហិង្សា ដោយ ចេតនា និង កាន់កាប់ ឬ ដឹកជញ្ជូន អាវុធ ដោយ គ្មាន ការអនុញ្ញាត នៅ ចំណុច មុខ កាស៊ីណូ ផារ៉ាម៉ិក ស្ថិត នៅ ភូមិ ក្បាល ស្ពាន ១ សង្កាត់ អូរ ជ្រៅ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
លោក វរសេនីយ៍ ត្រី នួន នីណារ៉ូ បាន ឱ្យដឹង ថា ការឃាត់ខ្លួន ជនសង្ស័យ ខាងលើ តាម ពាក្យបណ្តឹង ឈ្មោះ យាន ស៊ីណាត អាយុ ២២ ឆ្នាំ មាន ទីលំនៅ ភូមិបាលិលេយ្យ២ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
លោក វរសេនីយ៍ ត្រី នួន នីណារ៉ូ បាន ឱ្យដឹង ទៀត ថា ជនសង្ស័យ ទាំង ៣នាក់ រួម មាន៖
* ទី១៖ ឈ្មោះ សាត ពិសាល អាយុ ១៧ ឆ្នាំ បច្ចុប្បន្ន រស់ នៅ ភូមិ ក្បាល កោះ សង្កាត់ អូរ ជ្រៅ ក្រុង ប៉ោយប៉ែត* ទី២៖ ឈ្មោះ ទូច ចិត្រា អាយុ ១៧ ឆ្នាំ បច្ចុប្បន្ន រស់ នៅ ភូមិបាលិលេយ្យ១ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត* ទី៣៖ ឈ្មោះ វុធ សាវីន អាយុ ១៧ ឆ្នាំ បច្ចុប្បន្ន រស់ នៅ ភូមិ ក្បាល ស្ពាន ១ សង្កាត់ អូរ ជ្រៅ ក្រុង ប៉ោយប៉ែត ។ វត្ថុតាង ចាប់ យក រួម មាន៖ ១. កាំបិត កែច្នៃ ប្រវែង ៦០សង់ទីម៉ែត្រ ចំនួន ០១ ដើម . ២. ម៉ូតូ ២គ្រឿង ។
ក្រោយ ឃាត់ខ្លួន និង សួរចម្លើយ ជនសង្ស័យ បាន សារភាព ថា ក្រុម ពួក ខ្លួន ពិតជា បាន ដេញ កាប់ ជនរងគ្រោះ ពិតប្រាកដ មែន ។ ដោយ ផ្អែក លើ ចម្លើយ សារភាព និង មាន វត្ថុតាង ជាក់ស្តែង កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង បាន កសាង សំណុំរឿង បញ្ជូន មកកាន់ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត ចាត់ការ បន្ត តាម នីតិវិធី ។
លោក វរសេនីយ៍ ឯក ម៉ែន ភិរម្យ មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខេត្ត ទទួល ការងារ ស្រាវជ្រាវ និង បង្ក្រាប បទល្មើស បាន ឱ្យដឹង ថា ការបង្ក្រាប ករណី ខាងលើ នេះ បាន ធ្វើឡើង ក្រោម បញ្ជា ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត និង មាន ការសម្របសម្រួល នីតិវិធី ពី លោក កើត វណ្ណារ៉េត ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ផងដែរ ។
ទេសរដ្ឋមន្ត្រី កែវ រ៉េមី ក៏ បាន សន្យា ពាំនាំ សំណូមពរ ទាំង ពីរ ខាងលើ ដល់ ប្រមុខ រាជ រដ្ឋាភិបាល និង ក៏ បាន ជូន ពរ លោកស្រី ឯក អគ្គ រដ្ឋទូត មាន សុខភាព ល្អ និង ទៅ បំពេញ ការងារ ថ្មី ជា ឯក អគ្គ រដ្ឋទូត នៅ ប្រទេស ស្រីលង្ការ ឱ្យ ទទួលបាន ជោគជ័យ ៕ អាវុធហត្ថ ខេត្ត តាកែវ ប្រគល់ រថយន្ត ដែល ក្រុម ចោគាស់ ផ្ទះ លួច ឲ្យ ទៅ ម្ចាស់ ដើម វិញ
( តាកែវ )៖ រថយន្ត កាមរី មួយ គ្រឿង ដែល ក្រុម ចោបាន លួច កាលពី ថ្ងៃទី៣០ ខែសីហា ម្សិលមិញ នេះ ត្រូវបាន កម្លាំង កងរាជា អាវុធ ខេត្ត តាកែវ បាន រកឃើញ មកវិញ និង បាន ប្រគល់ ដល់ ម្ចាស់ ដើម វិញ នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ ដោយ ទទួលបាន បទបញ្ជា ពី លោក ឧត្តមសេនីយ៍ ត្រី សេង មហា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត តាកែវ និង មាន ការសម្របសម្រួល នីតិវិធី ដោយ លោក ឯក ឆេង ហួត ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត តាកែវ ។
លោក វរសេនីយ៍ ត្រី ជុំ ម៉ៅ មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក សំរោង បាន ប្រគល់ រថយន្ត ម៉ាក កាមេរី ស៊េរី ឆ្នាំ ១៩៩៩ ពណ៌ ទឹក មាស ពាក់ ស្លាកលេខ ភ្នំពេញ 2M. 4128 ឲ្យ ទៅ ជនរងគ្រោះ ឈ្មោះ សាយ ពេជ្រ ពន្លឺ ភេទ ប្រុស អាយុ ៣០ ឆ្នាំ ទីលំនៅ ភូមិ កន្លែង ខ្លា ឃុំ ចំបក់ ស្រុក បាទី ខេត្ត តាកែវ ។
គួរ បញ្ជាក់ ថា ក្នុង ករណី អំពើ លួច កាត់ សោ ផ្ទះ លួច រថយន្ត ខាងលើ បាន កើតឡើង កាលពី វេលា ម៉ោង ១១៖០០ នាទី ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០២៣ នៅ ភូមិ កន្លែង ខ្លា ឃុំ ចំបក់ ស្រុក បាទី ខេត្ត តាកែវ ដោយ ជនសង្ស័យ មិន ស្គាល់ សាវតា ។ ហើយ រថយន្ត ដែល លួច បាន មក ទុកចោល នៅ ភូមិ ខ្នាច ខាងត្បូង ឃុំ បឹងត្រាញ់ ខាងជើង ស្រុក សំរោង ខេត្ត តាកែវ ។
ក្រោយ កើត ហេតុ ភ្លាម ៗ លោក ឧត្តមសេនីយ៍ ត្រី សេង មហា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត បាន បញ្ជា ទៅ គ្រប់ បណ្តា អង្គភាព ចំណុះ ទាំងអស់ ចេញ បង្ក្រាប ករណី នេះ ។
លុះ នៅ វេលា ម៉ោង ១១៖៣០ នាទី ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០២៣ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក សំរោង សហការ ជាមួយ កម្លាំង ស្នាក់ការសន្តិសុខ ៣០១ បាន ចុះ ទៅ យក រថយន្ត ខាងលើ មក រក្សាទុក នៅ មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក សំរោង និង បាន ប្រគល់ជូន ជនរងគ្រោះ វិញ ។
បច្ចុប្បន្ន កម្លាំង ជំនាញ កងរាជអាវុធហត្ថ ខេត្ត តាកែវ កំពុង កសាង សំណុំរឿង និង ស្វែងរក ចាប់ខ្លួន ជនសង្ស័យ បញ្ជូន ទៅ តុលាការ ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕
អភិបាល ខេត្ត កណ្ដាល ជួប សំណេះសំណាល ពលរដ្ឋ ជាង ៤០០ នាក់ ដែល មក ធ្វើ បុណ្យ នៅ វិហារ អ្នកតា ធំ ចិន ក្រុង តាខ្មៅ
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល ក្នុង ដំណើរ ទៅ ធ្វើការ នៅ សាលា ខេត្ត បាន ឆ្លៀត ចុះ ជួប សំណេះសំណាល បងប្អូន ប្រជាពលរដ្ឋ ជាង ៤០០ នាក់ ដែល កំពុង ជួបជុំ ធ្វើ បុណ្យ នៅ វិហារ អ្នកតា ធំ ចិន ក្រុង តាខ្មៅ នា ព្រឹក ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ ដោយ បាន ជម្រាប ជូន ពលរដ្ឋ ពី តម្លៃ ដ៏ មហាសាល នៃ សុខ សន្តិភាព នៃ យើង និង រួមគ្នា ថែរក្សា សន្តិភាព ទាំងអស់ គ្នា ដើម្បី ប្រទេសជាតិ រីកចម្រើន ទៅ មុខ ជាលំដាប់ ។
ស្ថិត ក្នុង ជំនួប សំណេះសំណាល នេះ លោក គង់ សោភ័ណ្ឌ បាន ថ្លែង ប្រាប់ ដល់ ពលរដ្ឋ ពី តម្លៃ សុខ សន្តិភាព ដែល រកបាន ដោយ លំបាក លំបិន ហើយ ប្រទេសជាតិ កំពុង មាន សន្តិភាព ទើប ពលរដ្ឋ យើង មាន ឱកាស គ្រប់ ៗ គ្នា មកវិហារ ធំ អ្នក ចិន ដើម្បី អុច ធូប បន់ស្រន់ ធ្វើ បុណ្យ ទៀន យ៉ាង ដូច្នេះ ។
លោក ថា « កត្តា សន្តិភាព នេះ ហើយ ជា ឫសគល់ ដ៏ រឹងមាំ ដែល នាំ នាវា កម្ពុជា យើង ស្គាល់ តែ ភាព សម្បូរសប្បាយ រីករាយ រីកចម្រើន ទៅ មុខ ជាលំដាប់ ពិសេស យើង មាន នាយក រដ្ឋមន្ត្រី វ័យ ក្មេង បន្ត វេន ដ៏ មាន សមត្ថភាព គឺ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ដែល កាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី នា ពេល បច្ចុប្បន្ន នេះ » ។
លោក អភិបាល ខេត្ត បាន ផ្ដាំផ្ញើ ដល់ ពលរដ្ឋ ត្រូវ ថែទាំ សុខភាព ឲ្យបាន ល្អ ហូប ស្អាត ផឹក ស្អាត រស់ នៅ ស្អាត ហើយ បើ មាន ជំងឺ ណាមួយ ត្រូវ អញ្ជើញ ទៅ មន្ទីរពេទ្យ ខេត្ត ដែល មាន វេជ្ជបណ្ឌិត ឯកទេសរង់ចាំ ព្យាបាល ជូន ដោយ ឥត គិត ថ្លៃ ជាមួយនឹង សេវា ប្រកបដោយ គុណភាព និង ទំនុកចិត្ត បំផុត ។
មន្ត្រី ឥណ្ឌា ២រូប អ្នកការទូត ម្នាក់ មាន មូលដ្ឋាន នៅក្នុង ប្រទេស ចិន និង មន្ត្រី ម្នាក់ ធ្វើ ការ ឲ្យ រដ្ឋាភិបាល នៃ ប្រទេស G20 ផ្សេង ទៀត បាន និយាយ ថា នាយក រដ្ឋមន្ត្រី ចិន លោក លី ឈាង (Li Qiang) ត្រូវបាន គេ រំពឹង ថា នឹង ទៅ ចូលរួម ជា តំណាង ឲ្យ ទីក្រុង ប៉េកាំង សម្រាប់ កិច្ចប្រជុំ កំពូល ថ្ងៃទី ៩ ដល់ ថ្ងៃទី ១០ ខែកញ្ញា នៅ ទីក្រុង ញូវ ដេលី ។ យ៉ាង នេះ ក្តី អ្នកនាំពាក្យ ក្រសួង ការបរទេស ឥណ្ឌា និង ចិន មិន បាន ឆ្លើយតប ចំពោះ សំណើ សុំ ការអត្ថាធិប្បាយ នោះ ទេ ។
គួរ បញ្ជាក់ ថា កិច្ចប្រជុំ កំពូល G20 នៅ ឥណ្ឌា ត្រូវបាន គេ មើលឃើញ ថា ជា កន្លែង មួយ ដែល មេដឹកនាំ ចិន និង សហរដ្ឋ អាមេរិក អាចនឹង ជួបគ្នា ខណៈ ដែល ប្រទេស មហា អំណាច ទាំង ពីរ នេះ កំពុង ព្យាយាម ធ្វើឲ្យ ទំនាក់ទំនង មាន ស្ថេរភាព ដោយសារតែ ភាពតានតឹង ផ្នែក ពាណិជ្ជកម្ម និង កត្តា ភូមិសាស្រ្ត នយោបាយ ៕
អាជ្ញាធរ បន្ត បើក ប្រតិបត្តិការ ចុះ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស នេសាទ នៅ រដូវ បិទ នេសាទ នៅ ស្រុក កំពង់លែង ខេត្ត កំពង់ឆ្នាំង
( កំពង់ឆ្នាំង ) ៖ នៅក្នុង អំឡុង ខេត្ត សីហា នេះ គណៈ បញ្ជាការ ឯកភាព តាម បណ្ដា ស្រុក មួយចំនួន ជាប់ បឹង ទន្លេ សាប ក្នុង ខេត្ត កំពង់ឆ្នាំង បាន និង កំពុង សម្រុក ធ្វើ សកម្មភាព យ៉ាង មមាញឹក ក្នុង ការរុះរើ និង កាប់បំផ្លាញ ចោល នូវ ឧបករណ៍ នេសាទ ខុស ច្បាប់ ពិសេស គឺ ឧបករណ៍ នេសាទ របាំង ស្បៃ មុង ដែល ក្រុម ជន ខិលខូច មួយចំនួន បាន ដាក់ ចាប់ ត្រី នៅក្នុង រដូវ បិទ នេសាទ នេះ ដើម្បី រំដោះ ពូជ កូន មច្ឆា ជាតិ ។
ជុំវិញ ការចុះបង្ក្រាប និង ទប់ស្កាត់ សកម្មភាព បទល្មើស នេសាទ ខាងលើ នេះ នៅក្នុង ស្រុក កំពង់លែង ក៏ បាន បើក ប្រតិបត្តិការ ចុះ ទប់ស្កាត់ និង ធ្វើ ការបំផ្លិចបំផ្លាញ ចោល បករណ៍ នេសាទ ល្មើស ច្បាប់ ស្ទើរ ជារៀងរាល់ ថ្ងៃ ផងដែរ ។
លោក អភិបាល ស្រុក បាន បន្ត ថា មិន តែ ប៉ុណ្ណោះ លោក ក៏ បាន ចេញ បទបញ្ជា យ៉ាង ម៉ឺងម៉ាត់ នៅ តាម បណ្ដា រដ្ឋបាល ឃុំ ត្រូវ ទទួលខុសត្រូវ ទៅ លើ បទល្មើស នេសាទ តែ កើតមាន នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន បើ ជា ទ្រង់ទ្រាយ ធំ ត្រូវ សហការ ជាមួយ រដ្ឋបាល ស្រុក ដើម្បី ចុះ ទប់ស្កាត់ និង បង្ក្រាប ឱ្យ បាន ទាន់ ពេល វេលា ។
លោក យ៉ែម លក្ខិណា បាន បន្ថែម ថា នៅក្នុង រដូវ បើក នេសាទ ខាងមុខ នេះ លោក សូម ណូមពរ ដល់ ប្រជា នេសាទ ទាំងអស់ ត្រូវ ធ្វើ ការ នេសាទ ទៅ តាម ការណែនាំ របស់ មន្ត្រី ជំនាញ ឬ ទៅ តាម ច្បាប់ ស្ដីពី ជល ផល ឱ្យ បាន ដាច់ខាត ចៀសវាង ការប្រើ ឧបករណ៍ ល្មើស ច្បាប់ ដែល ច្បាប់ មិន អនុញ្ញាត ។ ករណី នៅតែ មាន ការប្រើ ឧបករណ៍ ខុស ច្បាប់ ទៀត នោះ លោក នឹង អនុវត្ត ទៅតាម នីតិវិធី ជាដាច់ខាត ដោយ មិន មាន ការយោគយល់ នោះ ឡើយ ។
សូម បញ្ជាក់ ថា ចំពោះ ករណី ការប្រើប្រាស់ ឧបករណ៍ នេសាទ ខុស ច្បាប់ និង ការធ្វើ ការនេសាទ ល្មើស ច្បាប់ នៅក្នុង បឹង ទន្លេ សាប ក្នុង ដែន ទឹក ខេត្ត កំពង់ឆ្នាំង នេះ ដែរ កន្លងមក លោក នាយ ខណ្ឌ រដ្ឋបាល ជលផល កំពង់ឆ្នាំង ក៏ តែង បាន ប្រាប់ ថា រាល់ សកម្មភាព បទល្មើស នេសាទ ដែល កើតមាន នៅក្នុង ប្រទេស ខេត្ត កំពង់ឆ្នាំង គឺជា ការឆ្លៀត ឱកាស របស់ ជន ខិលខូច តែ ប៉ុណ្ណោះ មន្ត្រី ជំនាញ មិន ដែល មាន ការពាក់ព័ន្ធ ឬ ក៏ គប់ គិត នោះ ឡើយ ។
ក្នុង នោះ លោក បាន បញ្ជាក់ ថា នៅ ឆ្នាំ ២០២៣ នេះ ចំពោះ ការនេសាទ ដោយ ប្រើ ឧបករណ៍ ដាក់ របាំង រាំង ព្រួល ភ្ជិត ព្រែក លោក នឹង មិន អនុញ្ញាតអោយ ទៀត ឡើយ ។ បើ ទោះជា សហគមន៍ នេសាទ ឲ្យ លោក ធ្វើ សំណើ សុំ ច្បាប់ អនុញ្ញាត ពី រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម ក៏ដោយ ក៏ លោក នឹង មិន ស្នើសុំ ទៀត នោះ ទេ ដោយសារ ការ នេសាទ ប្រភេទ ដាក់ របាំង ព្រួល ភ្ជិត ព្រែក នេះ ជួប បញ្ហា មិន ចេះ ចប់ កន្លងមក ។
ប្រជា នេសាទ ភាគ ច្រើន លើសលុប ដែល ពួកគាត់ មាន មុខរបរ នេសាទ តូចតាច និង នេសាទ ជា លក្ខណៈ គ្រួសារ នៅ តាម ដងទន្លេ ពួកគាត់ រីករាយ និង សាទ រ យ៉ាង ក្រៃលែង ចំពោះ ចំណាត់ការ របស់ សមត្ថកិច្ច ដែល បាន ចុះ ធ្វើ សកម្មភាព បង្ក្រាប បទល្មើស នេសាទ របស់ ក្រុម ឈ្មួញ ធំ ៗ នៅ គ្រប់ ស្រុក នា ពេល បច្ចុប្បន្ន នេះ ។ ដែល ឧបករណ៍ ទាំងអស់ នោះ ភាគ ច្រើន ពួកគេ បាន ដាក់ របាំង ស្បៃ មុង ហើយ ឧបករណ៍ នេះ ជា ឧបករណ៍ មួយ ប្រភេទ ដែល វា បាន នាំមក នូវ ការបំផ្លិចបំផ្លាញ យ៉ាង ធ្ងន់ធ្ងរ នូវ ពូជ មច្ឆា ជាតិ ទាំង តូច ទាំង ធំ ផងដែរ ។
ម្យ៉ាង វិញ ទៀត ពួកគាត់ ក៏ សូម គាំទ្រ នូវ ប្រសាសន៍ របស់ លោក នាយ ខណ្ឌ រដ្ឋបាល ជលផល កំពង់ឆ្នាំង ដែល លោក បាន អះអាង ថា ឆ្នាំ នេះ លោក នឹង មិន អនុញ្ញាតឱ្យ មាន ការធ្វើ របាំង រាំង ព្រួល ភ្ជិត ព្រែក នៅ តាម បណ្ដា ឡូនេសាទ ទាំងអស់ ក្នុង ខេត្ត កំពង់ឆ្នាំង នេះ ជាបន្ត ទៀត នេះ គឺជា ឱកាស មួយ ដែល ប្រជា នេសាទ មាន លទ្ធភាព ក្នុង ការរក នេសាទ បានជាសាធារណៈ គ្រប់ ៗ គ្នា និង ស្មើភាព គ្នា ឡើងវិញ ផងដែរ ៕
សមាគម មូលនិធិ សម្ដេច តេជោ ដើម្បី អភិវឌ្ឍន៍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា ចេញ លិខិត ថ្លែងអំណរគុណ អ្នក ឧកញ៉ា ហ៊ួរ ហាក់ សេង និង លោកជំទាវ ហេង សុផាណែត ដែល ចូលរួម បរិច្ចាគ ថវិកា ១មុឺន ដុល្លារ ដើម្បី រួមចំណែក អភិវឌ្ឍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ សមាគម មូលនិធិ សម្ដេច តេជោ ដើម្បី អភិវឌ្ឍន៍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា បាន ចេញ លិខិត ថ្លែងអំណរគុណ ជូន ចំពោះ អ្នក ឧកញ៉ា ហ៊ួរ ហាក់ សេង និង លោកជំទាវ ហេង សុផាណែត ដែល ចូលរួម បរិច្ចាគ ថវិកា ១មុឺន ដុល្លារ ជូន សមាគម ដើម្បី រួមចំណែក ក្នុង ការអភិវឌ្ឍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា ស្រប តាម គោល នយោបាយ និង យុទ្ធសាស្ត្រ ចតុកោណ របស់ រាជ រដ្ឋាភិបាល ៕
ខាងក្រោម នេះ ជា លិខិត ថ្លែងអំណរគុណ ជូន ចំពោះ អ្នក ឧកញ៉ា ហ៊ួរ ហាក់ សេង និង លោកជំទាវ ហេង សុផាណែ ត៖
នាយ ឧត្តមសេនីយ៍ ស ថេត និង លោក គួច ចំរើន ណែនាំ ស្នងការ ថ្មី នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ ត្រូវ បន្ដ រក្សា សាមគ្គី ផ្ទៃក្នុង ដើម្បី ប្រសិទ្ធភាព ក្នុង ការបំពេញ ការងារ បម្រើ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន
( ព្រះសីហនុ) ៖ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ និង លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន ណែនាំ ដល់ លោក ឧត្តមសេនីយ៍ ឯក ស រដ្ឋា ដែល ទើប ប្រកាស ចូលកាន់ តំណែង ជា ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ នៅ ព្រឹក ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ នេះ បន្ត ការប្រឹងប្រែង សហការ គ្នា សាមគ្គីភាព ផ្ទៃក្នុង ឲ្យបាន ល្អ ដេីម្បី បម្រេី អង្គភាព និង ប្រជាពលរដ្ឋ រក្សា ឲ្យបាន នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណ ជូន ប្រជាពលរដ្ឋ អ្នក វិនិយោគ ជាពិសេស ភ្ញៀវ ទេសចរណ៍ ជាតិ អន្តរជាតិ ។
នាយ ឧត្តមសេនីយ៍ ស ថេត បាន ដាស់តឿន ដល់ លោក ស្នងការ ក្នុង នាម ជា ប្រធាន អង្គភាព ត្រូវ មាន ការទទួលខុសត្រូវ ខ្ពស់ លេី ការដឹកនាំ បញ្ជា កងកម្លាំង ក៏ ដូចជា ការគ្រប់គ្រង និង អភិវឌ្ឍ អង្គភាព ។ ចំពោះ មន្ត្រី បេី ធ្វេី ល្អ ត្រូវ មាន ការលេីក ទឹកចិត្ត ទទួល ការលេីក សរសេី រ បេី ធ្វេី ខុស ត្រូវ ដាក់ វិន័យ តាម កងកម្លាំង ០០៦ ឬ អនុវត្ត តាម ច្បាប់ ហើយ មន្ដ្រី ត្រូវតែ ផ្ដល់ ការគាំទ្រ ដល់ ប្រធាន អង្គភាព ផងដែរ ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ ស ថេត បាន ជំរុញ ប្រធាន អង្គភាព ត្រូវ ខិតខំ ពង្រឹង បន្ថែម របៀប របប ធ្វេី ការងារ ប្រចាំ ថ្ងៃ ឲ្យបាន ល្អ . ត្រូវ មាន ការ រៀបចំ កិច្ចប្រជុំ ជាប្រចាំ ដេីម្បី ទទួលយក ព័ត៌មាន ឲ្យបាន គ្រប់ ជ្រុងជ្រោយ យក មកវិភាគ និង រៀបចំ ផែនការ ដេីម្បី ដាក់ ចេញ ឲ្យ អនុវត្ត ។ ផែនការងារ សន្តិសុខ ដេីរតួ សំខាន់ ឈានដល់ ការគ្រប់គ្រង មុខ សញ្ញា ដេីម្បី ងាយស្រួល ក្នុង ការបង្ក្រាប បទល្មេីស ។
ដោយឡែក ការគ្រប់គ្រង អាវុធ ជាតិ ផ្ទុះ ការកាន់កាប់អាវុធ ខុស ច្បាប់ ត្រូវ អនុវត្ត ជាប្រចាំ ដោយ មាន ការចូលរួម ពី គណៈ បញ្ជាការ ឯកា ព ហើយ មាន ការដឹកនាំ បញ្ជា ឲ្យ តំណាង អយ្យការ ។ លើស ពី នេះ ត្រូវ ពង្រឹង អង្គភាព អធិការដ្ឋាន នគរបាល ខណ្ឌ ក្រុង ស្រុក ប៉ុស្តិ៍ ត្រួតពិនិត្យ កម្លាំង ឲ្យបាន ច្បាស់លាស់ ត្រូវ មាន កម្លាំង ប្រចាំ ការ២៤ ម៉ោង លើ ២៤ ម៉ោង ដេីម្បី ដោះស្រាយ បញ្ហា ប្រឈម ជូន ប្រជាពលរដ្ឋ និង ទទួល ពាក្យបណ្តឹង ។
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន បញ្ជាក់ ថា ពន្ធ លើ អចលន ទ្រព្យ ប្រចាំ ឆ្នាំ ២០២៣ នឹង ផុត កំណត់ នៅ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០២៣ ខាងមុខ ក្នុង ករណី ខកខាន មិន បាន អនុវត្ដ កាត្វ កិច្ច ពន្ធ លើ អចលន ទ្រព្យ តាម កាលបរិច្ឆេទ កំណត់ ម្ចាស់ អចលន ទ្រព្យ នឹង ទទួលរង នូវ ការ ពិន័យ ទោសទណ្ឌ ផ្សេង ៗ ស្រប តាម ច្បាប់ ជាធរមាន ៕
បទ អត្ថាធិប្បាយ៖ នេះ ជា ការបង្ក រឿង ហេតុ ចំពោះ មនុស្សជាតិ និង ជា ការប្រកាស សង្គ្រាម ដល់ បណ្តា ប្រទេស នៅ តាម ឆ្នេរសមុទ្រ ប៉ាស៊ីហ្វិក ទាំងអស់ !
អត្ថបទ និង រូប ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ចំណេះដឹង ទូទៅ៖ ធ្លាប់ តែ ឮ ផ្លូវ សូត្រ លើ គោក ឥឡូវ មក ស្គាល់ ផ្លូវ សូត្រ សមុទ្រ ម្ដង
( ភ្នំពេញ ) ៖ ផ្លូវ សូត្រ គឺជា បណ្ដាញ ផ្លូវ ពាណិជ្ជកម្ម បុរាណ មួយ ដែល បាន រីកចម្រើន ដំបូង ចាប់ពី ឆ្នាំ ១០០ មុន គ្រិស្ដ សករាជ ដល់ ឆ្នាំ ១៥០០ នៃ គ្រិស្ដ សករាជ ។ ការធ្វើ ជំនួញ សូត្រ នេះ រាប់ ចាប់ពី ប្រទេស ចិន ប៉ែក ខាងកើត ទៅដល់ តំបន់ អាស៉ី កណ្ដាល មជ្ឈិមបូព៌ា និង សមុទ្រ មេឌីទែរ៉ាណេ ។ នេះ គឺជា ផ្លូវ សូត្រ នៅលើ គោក ប៉ុន្តែ នៅ មាន ផ្លូវ សូត្រ សមុទ្រ ថែម ទៀត ។
ផ្លូវ សូត្រ សមុទ្រ សំដៅ លើ ផ្លូវ ពាណិជ្ជកម្ម តាម សមុទ្រ រវាង បូព៌ា ប្រទេស និង បស្ចិម ប្រទេស នា បុរាណ សម័យ ហើយ មាន ជាប់ទាក់ទង នឹង ផ្លូវ ជំនួញ សូត្រ នៅលើ គោក ដែរ ។ ខុសពី ផ្លូវ សូត្រ នៅលើ គោក ទំនិញ ផ្លូវ សូត្រ នៅលើ សមុទ្រ មាន ការជួញដូរ ទំនិញ ច្រើន ប្រភេទ ។ ក្រៅពី ក្រណាត់ សូត្រ ក៏ មាន ពរ្សឺឡែន គ្រឿង ក្រអូប និង តែ ទៀត ដែរ ដែល ជា ទំនិញ ជួញដូរ ភាគ ច្រើន ម្ល៉ោះហើយ ផ្លូវ សូត្រ សមុទ្រ ក៏ ត្រូវ គេ ហៅ ម្យ៉ាងទៀត ថា ផ្លូវ ពរ្សឺ ឡែន ឬ ផ្លូវ គ្រឿ ក្រអូប ។
ក្រោយពី សតវត្ស ទី ១៦ រួម នឹង ការមកដល់ របស់ ជនជាតិ អឺរ៉ុប ផ្លូវ សូត្រ ប៉ាស៉ី ហ្វិក បាន បង្កើតឡើង និង បាន ក្លាយជា ផ្លូវ ពាណិជ្ជកម្ម ពី ចិន ទៅកាន់ ហ្វីលីពីន ហើយ បន្ទាប់មក ឆ្លងកាត់ មហាសមុទ្រ ប៉ា ស៉ីហ្វិក ទៅ ទ្វីប អាមេរិក ។
យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៣១ ខែសីហា៖ បង្ក្រាប ៩ករណី ឃាត់ខ្លួន ៤៥ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៩ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១ករណី . ដឹកជញ្ជូន រក្សាទុក ៧ករណី និង ជួញដូរ ១ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៤៥ នាក់ ។
ទេសរដ្ឋមន្រ្តី លី ធុជ៖ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត ផ្តល់ កាដូ ពិសេស ជូន ប្រជាពលរដ្ឋ ខេត្ត កោះកុង តាមរយៈ ការប្រើប្រាស់ ដី សុវត្ថិភាព ពី ការគំរាមកំហែង ដោយសារ គ្រាប់ មីន
( កោះកុង ) ៖ លោក បណ្ឌិត លី ធុជ ទេសរដ្ឋមន្រ្តី អនុប្រធាន ទី១ អាជ្ញាធរ មីន នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ជា អ្នកទទួល ផល ពី ការងារ បោសសម្អាត មីន ក្នុង ភូមិ ត្រពាំង រូង ឃុំ ត្រពាំង រូង ស្រុក កោះ កុង ខេត្ត កោះកុង ក្រោម ការគាំទ្រ ពី រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ ឥណ្ឌា ក្រោម ក្របខណ្ឌ គម្រោង ផ្តល់ ផល រហ័ស ដែល ពិធី នេះ ប្រព្រឹត្តិ ទៅ នៅ សាលា ស្រុក កោះ កុង ។
ក្នុង ពិធី សំណេះសំណាល នេះ លោក បណ្ឌិត លី ធុជ បាន លើកឡើង ថា បន្ទាប់ពី ឡើង កាន់ ដំណែង ជា នាយក រដ្ឋមន្រ្តី បាន ប៉ុន្មាន ថ្ងៃ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ផ្តល់ នូវ កាដូរ ពិសេស មួយ ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ខេត្ត កោះកុង តាមរយៈ គម្រោង បោសសម្អាត មីន និង ការបង្កបង្កើន ផល លើ ដី ប្រកបដោយ សុវត្ថិភាព ដែល នេះ ជា ផ្នែក មួយ យ៉ាង សំខាន់ ក្នុង ចូលរួម លើកកម្ពស់ ជីវភាព រស់ នៅ និង ពង្រឹង សន្តិសុខ សុវត្ថិភាព ជូន ដល់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ។
លោក ទេសរដ្ឋមន្រ្តី បាន ជម្រាប ប្រាប់ ប្រជាពលរដ្ឋ និង មន្រ្តី រាជការ ខេត្ត កោះកុង ថា ក្រោយ ឆ្នាំ ២០២៣ ស្រុក ក្រុង ស្ទើរ ទាំងអស់ ក្នុង ខេត្ត កោះកុង នឹង អស់ មាន ការគំរាមកំហែង ដោយ គ្រាប់ មីន ដែល យើង បាន ដឹង នៅសល់ តែ ស្រុក មណ្ឌល សីម៉ា មួយ តែ ប៉ុណ្ណោះ នៅ មាន បន្ត រង ផល ប៉ះពាល់ ដោយសារ គ្រាប់ មីន ហើយ មាន ភាពស្មុគស្មាញ ខ្លាំង ដែល តម្រូវឲ្យ យើង រួមគ្នា ដោះស្រាយ បន្ត ទៀត ។
បទ អត្ថាធិប្បាយ៖ អរិយធម៌ មិន ត្រូវ បែងចែក ឋានៈ ខ្ពស់ ទាប ឬ ល្អ អាក្រក់ ឡើយ
ក្នុង ន័យ នេះ មិន ថា ប្រទេស ដែល មាន ប្រវត្តិសាស្ត្រ រាប់ ពាន់ ឆ្នាំ ឬ រាប់ រយ ឆ្នាំ នោះ ទេ គឺ សុទ្ធតែ មាន អរិយធម៌ ដែល បង្ហាញ ពី អត្តសញ្ញាណ ជាតិ រៀង ៗ ខ្លួន បើ ទោះបីជា ប្រទេស ដែល បាន បំបែក ខ្លួន ពី គ្នា ក្តី ក៏ រមែង តែ មាន ភាពខុសប្លែក គ្នា ខ្លះ ៗ ផងដែរ តួយ៉ាង ដូចជា ប្រទេស សិង្ហបុរី និង ម៉ាឡេស៊ី ជាដើម ។
ដោយសារតែ មាន អរិយធម៌ ខុស ៗ គ្នា តាម ជាតិ សាសន៍ នីមួយ ៗ ដូច្នេះ ទើប បាន ធ្វើឱ្យ ពិភពលោក យើង មាន ភាព ចម្រុះ បែប តែ ទន្ទឹមនឹង នេះ ក៏ បាន នាំមក នូវ ភាព មិន ចុះចម្រុង មួយចំនួន ខាង អរិយធម៌ ផងដែរ ដែល សឹងតែ កើតមាន ការរើសអើង ខាង ពូជសាសន៍ និង ការប្រទូសរ៉ាយ ខាង សាសនា ទៀតផង ។
កន្លងមក បញ្ហា រើស អើង ពូជសាសន៍ បាន បង្ក ផលវិបាក យ៉ាង ធ្ងន់ធ្ងរ សម្រាប់ សង្គម មនុស្សជាតិ ។ ជនជាតិ ស្បែក ស មួយចំនួន តែង ចាត់ទុក ខ្លួន មាន « ឋានៈ » ខ្ពស់ ជាង ជនជាតិ ស្បែក ខ្មៅ ដែល នាំឱ្យ កើត ចេញ ជា ការស្អប់ខ្ពើម និង ការចង គំនុំ ខាង ពូជសាសន៍ បង្កឱ្យ កើតមាន ការប្រទូសរ៉ាយ រហូតដល់ បណ្តាលឱ្យ មាន មនុស្ស ស្លាប់ និង រងរបួស យ៉ាង ច្រើន ។ ផ្នត់គំនិត បែប នេះ បាន ចាក់ ស្រែះ ក្នុង សង្គម នៃ ប្រទេស មួយចំនួន វា ជា ហានិភ័យ លាក់ កំបាំង ដែល អាចនឹង ផ្ទុះ បញ្ហា ធ្ងន់ធ្ងរ គ្រប់ ពេល ។
ដោយឡែក ទោះបី ការ ដែល អ្នកនយោបាយ នៅ កូរ៉េ ខាងត្បូង សម្រេច ជ្រើសរើស ធ្វើ កូដកម្ម បង្អត់ អាហារ ដើម្បី ទាមទារ ការយកចិត្តទុកដាក់ មក លើ គោលជំហរ របស់ ពួកគេ មិន មែន ជា រឿង ចម្លែក ខ្លាំង ក៏ដោយ វា គឺជា រឿង កម្រ ដែល មេដឹកនាំ នៃ គណបក្ស នយោបាយ ធំ មួយ សម្រេច ជ្រើសរើស ធ្វើ បែប នោះ ៕
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ចូលរួម កម្មវិធី អ្នកដឹកនាំ ក្នុង អភិបាលកិច្ច លើក ទី ១៥ នៅ សឹង្ហបុរី
ដោយ អំពាវនាវ ជាថ្មី ចំពោះ រដ្ឋាភិបាល កុំ ឲ្យ ងាក មក កាត់បន្ថយ ការចំណាយ លើ វិស័យ ការពារ ជាតិ របស់ ប្រទេស លោក វ៉ាឡេស បាន គូសបញ្ជាក់ ថា « ក្រសួង ការពារ ជាតិ ត្រូវតែ ទទួល ការគាំទ្រ មិន ថា តែ នៅលើ មាគ៌ា លំដាប់ ពិភពលោក ឬ ក្នុង ប្រទេស នោះ ទេ » ។ ក្នុង លិខិត ឆ្លើយតប លោក នាយក រដ្ឋមន្រ្តី ស៊ូណាក់ បាន សរសើរ លោក វ៉ាឡេស សម្រាប់ ការងារ បម្រើ ប្រទេសជាតិ ហើយ ថា យល់ ច្បាស់ ពី បំណងប្រាថ្នា របស់ លោក វ៉ាឡេស ក្នុង ការសម្រេចចិត្ត ចុះ ចេញ ពី តំណែង នេះ ។
គួរ បញ្ជាក់ ថា លោក Grant Shapps ដែល បច្ចុប្បន្ន ជា រដ្ឋមន្រ្តី សន្តិសុខ ថាមពល ត្រូវបាន តែងតាំង ជា រដ្ឋមន្រ្តី ការពារ ជាតិ ថ្មី ។ លោក វ៉ាឡេស ដែល ទទួលបន្ទុក ដឹកនាំ លើ ការឆ្លើយតប របស់ ចក្រភព អង់គ្លេស ចំពោះ ការឈ្លានពាន របស់ រុស្ស៉ី នៅ អ៊ុយក្រែន ធ្លាប់ បាន និយាយ កាលពី ខែកក្កដា ថា លោក ចង់ ចុះចេញ ពី តំណែង សព្វ ថ្ងៃ ដែល កាន់ អស់ រយៈពេល ៤ ឆ្នាំ ហើយ នឹង លា លែង ពី តំណែង ជា សមាជិក សភា នៅ ការបោះឆ្នោត បន្ទាប់ ដើម្បី ស្វែងរក ឱកាស ថ្មី ៗ ៕
ប្រធាន គ.ជ. ប ដឹកនាំ កិច្ចប្រជុំ ដើម្បី ផ្សព្វផ្សាយ អំពី ប្រតិទិន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២៣
( ភ្នំពេញ ) ៖ នា ព្រឹក ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ នៅ សាល សន្និសីទ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) មាន កិច្ចប្រជុំ ជាមួយ ភាគី ពាក់ព័ន្ធ នឹង ការបោះឆ្នោត ក្រោម អធិបតីភាព លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ. ប និង ជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ ដើម្បី ផ្សព្វផ្សាយ អំពី ប្រតិទិន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២៣ ការងារ ពាក់ព័ន្ធ នឹង ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ។
ថ្លែង នៅក្នុង កិច្ចប្រជុំ នោះ លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ. ប បាន លើកឡើង ថា ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត គឺជា ដំណើរការ នៃ ការធ្វើ បច្ចុប្បន្នភាព បញ្ជី បោះឆ្នោត តាម គោលការណ៍ ប្រព័ន្ធ បញ្ជី បោះឆ្នោត អចិន្រ្តៃយ៍ ដើម្បី ធានា ឲ្យ បញ្ជី បោះឆ្នោត មាន គុណភាព ខ្ពស់ មាន ភាព ពេញលេញ ត្រឹមត្រូវ និង មាន បច្ចុប្បន្នភាព ព្រមទាំង ធានា បាន នូវ ការ សម្ងាត់ សន្តិសុខ និង សុវត្ថិភាព ទិន្នន័យ អត្តសញ្ញាណ របស់ អ្នកបោះឆ្នោត ។
ប្រតិទិន ការងារ ខាងលើ នេះ ត្រូវបាន ធ្វើ ការផ្សព្វផ្សាយ ជាសាធារណៈ ។ សាធារណជន និង ភាគី ពាក់ព័ន្ធ នានា អាច ទាញយក នូវ ប្រតិទិន ការងារ នេះ ចេញ ពី គេហទំព័រ របស់ គ.ជ. ប ឬ អាច យក ពី បណ្តាញ ទំនាក់ទំនង សង្គម របស់ គ.ជ.ប ។
លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ. ប បាន បញ្ជាក់ ជូន បន្ត ទៀត ថា ‍ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត និង ការផ្តល់ សុពលភាព លើ បញ្ជី បោះឆ្នោត ឆ្នាំ ២០២៣ ត្រូវ ចាប់ផ្តើម ពី ថ្ងៃទី ១ ខែតុលា ដល់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២៣ ។ ហើយ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត នៅ តាម ឃុំ សង្កាត់ មាន រយៈពេល ១៩ ថ្ងៃ គឺ ចាប់ផ្តើម ពី ថ្ងៃទី១ រហូតដល់ ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០២៣ ។
សម្រាប់ អ្នកសារព័ត៌មាន ជាតិ និង អន្តរជាតិ អាច ដាក់ពាក្យ សុំ ចុះឈ្មោះ អ្នកសារព័ត៌មាន ជាតិ និង អន្តរជាតិ ដោយ ទាញយក ទម្រង់ ចេញ ពី គេហទំព័រ របស់ គ.ជ. ប ឬ អាច មក យក ពាក្យ ដោយ ផ្ទាល់ នៅ នាយកដ្ឋាន ព័ត៌មាន និង ទំនាក់ទំនង សាធារណៈ នៅ ទីស្តីការ គ.ជ. ប ដោយ ឥត គិត ថ្លៃ ។
នេះ ជា កិច្ចប្រជុំ លើក ទី១ ជាមួយ ភាគី ពាក់ព័ន្ធ សម្រាប់ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២៣ ដែល សមាសភាព ចូលរួម ក្នុង កិច្ចប្រជុំ នេះ មាន មក ពី ក្រសួង ការពារ ជាតិ ក្រសួង មហាផ្ទៃ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា ក្រុមប្រឹក្សា ធម្មនុញ្ញ ក្រសួង ព័ត៌មាន តំណាង ស្ថានទូត រុស្ស៊ី តំណាង គណបក្ស នយោបាយ តំណាង អង្គការ មិន មែន រដ្ឋាភិបាល ព្រមទាំង អ្នកសារព័ត៌មាន សរុប ចំនួន ប្រមាណ ជាង ៥០ នាក់ ៕
លោក បណ្ឌិត តូច ប៉ូលីវ៉ា អញ្ជើញ សំណេះសំណាល សួរសុខទុក្ខ និង ចែក អំណោយ សង្រ្គោះ របស់ រាជ រដ្ឋាភិបាល តាមរយៈ មន្ទីរ សង្គមកិច្ច ជូន គ្រួសារ អតីត យុទ្ធជន និង គ្រួសារ អតីត មន្រ្តី រាជការ ស៉ី វិល នៅក្នុង ឃុំ ថ្នា ធ្នង់ ស្រុក រំដួល
( ស្វាយរៀង ) ៖ លោក បណ្ឌិត តូច ប៉ូលីវ៉ា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ ថ្នា ធ្នង់ បាន អញ្ជើញ សំណេះសំណាល សួរសុខទុក្ខ និង ចែក អំណោយ សង្រ្គោះ របស់ រាជ រដ្ឋាភិបាល តាមរយៈ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត ជូន ដល់ គ្រួសារ អតីត យុទ្ធជន និង គ្រួសារ អតីត មន្រ្តី រាជការ ស៉ី វិល នៅក្នុង ឃុំ ថ្នា ធ្នង់ ស្រុក រំដួល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃព្រហស្បតិ៍ ទី៣១ ខែសីហា ឆ្នាំ ២០២៣ ។
នៅក្នុង ឱកាស នោះ លោក បណ្ឌិត ក៏ បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ខេត្ត និង លោក ប៉េង ពោធិ៍សា អភិបាល ខេត្ត មក ជូន ដល់ អង្គ ពិធី ថែម ទៀត ផង ។
ទន្ទឹមនឹង នេះ លោក បាន បន្ត ថា ថ្វីត្បិតតែ អំណោយ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល បាន ផ្តល់ឲ្យ តាមរយៈ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត នាំយក មក ចែកជូន បងប្អូន នា ពេលនេះ មាន ចំនួន តិចតួច ក្ដី ក៏ ពិត មែន តែ ក៏ អាច ជួយ សម្រាល ទុក្ខលំបាក ជីវភាព របស់ បងប្អូន បាន មួយ កម្រិត ផងដែរ ហើយ អំណោយ ដែល ផ្តល់ ជូន នា ពេលនេះ មាន ចំនួន ៨៣ គ្រួសារ ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន អង្ករ មី ត្រីខ ទឹកត្រី ឃីត ០១ កញ្ចប់ និង សម្ភារៈ មួយចំនួន ផងដែរ ។
ជា ទីបញ្ចប់ លោក បាន ចែក អំណោយ ទាំងនោះ ជូន ដល់ ពួកគាត់ ហើយក៏ បាន ផ្តាំផ្ញើ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ថែរក្សា សុខភាព មាន អនាម័យ ហូប ស្អាត រស់ នៅ ស្អាត ចូលរួម គោរព ច្បាប់ ណែនាំ កូន ចៅ ឲ្យ ចៀស ឆ្ងាយ ពី ការប្រើប្រាស់ គ្រឿងញៀន និង រួមគ្នា ថែរក្សា សុខ សន្តិភាព ឲ្យ នៅ គង់វង្ស ដើម្បី អោយ ប្រទេសជាតិ យើង កាន់តែ មាន ការអភិវឌ្ឍន៍ និង រីកចម្រើន តទៅ មុខ បន្ថែម ទៀត ជា និរន្តន៍ ។
ក្នុង ពិធី នេះ ក៏ មាន ការចូលរួម ពី អភិបាល នៃ គណៈអភិបាល ស្រុក លោក ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត លោក លោកស្រី សមាជិក ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ លោក មេឃុំ លោក នាយ ប៉ុសិ៍ រដ្ឋបាល ឃុំ លោក លោកស្រី មន្រ្តី ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ៕
បញ្ជាការដ្ឋាន ភូមិភាគ ខាងកើត នៃ យោធា ចិន បាន និយាយ ក្នុង សេចក្តីថ្លែងការណ៍ ថា ពេល ថ្មី ៗ នេះ នៅ ទីតាំង មួយ ក្នុង សមុទ្រ ចិន ខាងត្បូង ក្រុម យន្តហោះ ល្បាត ប្រឆាំង នាវា មុជទឹក របស់ ចិន បាន ធ្វើ ការហោះហើរ ឥត ឈប់ សម្រាប់ រយៈពេល ជាង ៤០ ម៉ោង ដែល ផ្តោត ទៅ លើ ការស្វែងរក វត្តមាន នាវា មុជទឹក ហើយ ហាត់ សម ធ្វើ ដូចជា បើក ការវាយប្រហារ ទៅ លើ ពួក វា ។
យោធា ចិន បាន និយាយ ថា សមយុទ្ធ នោះ បាន ជួយ ដុសខាត់ សមត្ថភាព ប្រឆាំង នាវា មុជទឹក តាម ផ្លូវ អាកាស ហើយ ការហ្វឹកហាត់ ត្រូវបាន ធ្វើឡើង នៅ វេលា យប់ ជ្រៅ និង ទាប ភ្លឺ ដើម្បី បង្កើន បទពិសោធ ធ្វើ ប្រតិបត្តិការ នៅ ម៉ោង ខុស ៗ គ្នា ។ យ៉ាងណាមិញ សេចក្តីថ្លែងការណ៍ ខាងលើ មិន បាន បង្ហើប ថា តើ មាន នាវា មុជទឹក ដែល មិន មែន ជា របស់ ចិន ត្រូវបាន រកឃើញ នៅក្នុង តំបន់ ដែរ ឬក៏ អត់ ឡើយ ។
គួរ បញ្ជាក់ ថា លំហាត់ យោធា ខាងលើ ស្ថិត ក្នុង ចំណោម សមយុទ្ធ ស្រដៀង គ្នា មួយចំនួន ទៀត ដែល បាន ប្រព្រឹត្តទៅ ក្នុង ឆ្នាំ នេះ ហើយ វា គឺជា ផ្នែក នៃ សកម្មភាព យោធា យ៉ាង ទូលំទូលាយ ដែល យោធា ចិន បាន ធ្វើ នៅក្នុង តំបន់ ឥណ្ឌូ - ប៉ា ស៉ីហ្វិក ។ ចំណែក សហរដ្ឋ អាមេរិក និង សម្ព័ន្ធមិត្ត ក៏ បាន បង្កើន សកម្មភាព យោធា របស់ ពួកគេ ផងដែរ ជាពិសេស នៅ សមុទ្រ ចិន ខាងត្បូង ជា ទី ដែល ចិន មាន បញ្ហា វិវាទ ទឹកដី ជាមួយ បណ្តា ប្រទេស ដទៃ ទៀត ដែល នៅជាប់ តំបន់ សមុទ្រ នោះ ៕
តំណាង សម្តេច តេជោ ហ៊ុន សែន នាំ ទៀន ព្រះវស្សា និង ទេយ្យ ទាន ប្រគេន ដល់ ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា នៃ វត្ត សាលា អណ្ដែត
( កណ្ដាល ) ៖ អ្នក ឧកញ៉ា បណ្ឌិត លី សាម៉េត ទីប្រឹក្សា ផ្ទាល់ និង ជា តំណាង សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ បាន នាំ ទៀន ព្រះវស្សា និង ទេយ្យ ទាន ព្រមទាំង បច្ច័យ មួយចំនួន ប្រគេន ដល់ ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា នៃ វត្ត សាលា អណ្ដែត ( ហៅ វត្ត អណ្ដូង ) ស្ថិត នៅ ភូមិ អណ្ដូង ឃុំ ក្រាំង យ៉ូវ ស្រុក ស្អាង ខេត្ត កណ្ដាល ។
សកម្មភាព នេះ អម ដំណើរ ដោយ លោក សាស្ត្រាចារ្យ បណ្ឌិត ស៊ុំ ឈុំឡុង . ឧកញ៉ា បណ្ឌិត ឡាច សំរោង សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ឥន្ទ្រវិជ្ជា . លោក បណ្ឌិត ឈឿន សាវន . លោកស្រី បណ្ឌិត ហង្ស បូរី . លោក បណ្ឌិត ទិត ផល្លា ព្រមទាំង ក្រុមការងារ ។
( ភ្នំពេញ ) ៖ បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន ទេសរដ្ឋមន្ដ្រី ប្រធាន ក្រុមប្រឹក្សា ស្ដារ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម និង ជនបទ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ ជំរុញ ចលនា ភូមិ មួយ ផលិតផល មួយ នឹង ជំរុញ ចលនា ភូមិ មួយ ផលិតផល មួយ ឱ្យ បង្កើន ប្រសិទ្ធភាព ការងារ សំដៅ ក សាង មូលដ្ឋានគ្រឹះ ឆ្ពោះទៅ សម្រេច ចក្ខុវិស័យ កម្ពុជា ឆ្នាំ ២០៥០ ប្រជាពលរដ្ឋ កម្ពុជា មាន ប្រាក់ ចំណូល ខ្ពស់ ។
បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន បាន ថ្លែង ថា ការធ្វើឲ្យ សម្រេចបាន ដូច្នោះ គឺ ស្រប តាម យុទ្ធសាស្រ្ដ បញ្ចកោណ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ឯកឧត្ដម កិត្ដិ ទេ សា ភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន ទេសរដ្ឋមន្ដ្រី ថ្លែង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ ជាមួយ ថ្នាក់ដឹកនាំ មន្ដ្រីរាជការ នៅ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ស្ដារ អភិវឌ្ឍន៍ វិស យ័កសិកម្ម និង ជនបទ នា ព្រឹក ថ្ងៃទី ៣១ សីហា ឆ្នាំ ២០២៣ នៅ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី ។
បណ្ឌិត សភាចារ្យ បាន បញ្ជាក់ ថា « ខ្ញុំ សូម ជំរុញ ក្រុមការងារ ជំនាញ បន្ដ ការអនុវត្តន៍ រាល់ ភារកិច្ច ស្រប តាម តួនាទី រៀង ៗ ខ្លួន ឱ្យ បាន សកម្ម ព្រម ៗ គ្នា ឱ្យ អស់ ពី សមត្ថភាព តាម លទ្ធភាព ជាក់ស្ដែង ដើម្បី បម្រើ ជាតិ ប្រជាជន ក្នុង គ្រប់ កាលៈ ទេសៈ ក្នុង ការ បន្ត ការពារ និង កសាង មាតុភូមិ ឆ្ពោះ ទៅ រក អនាគត មួយ ដ៏ រុងរឿង ពិសេស ប្រែក្លាយ កម្ពុជា ជា អរិយៈ ប្រទេស ជឿនលឿន ល្បី ល្បាញ មួយ ដូច សម័យ អង្គរ ស្រប តាម ឆន្ទៈ និង បំណងប្រាថ្នា របស់ ប្រជាជន » ។
លោក សុទ្ធ សឺន អនុប្រធាន ក្រុមប្រឹក្សា ស្ដារ អភិវឌ្ឍ ន៏ វិស័យ កសិកម្ម និង ជនបទ បាន បញ្ជាក់ ថា ក្រុមប្រឹក្សា ស្តារ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម និង ជនបទ មាន តួនាទី ជា គណៈ បញ្ជាការ ឯកភាព មួយ ជួយ ដល់ រាជ រដ្ឋាភិបាល ក្នុង ការសម្របសម្រួល លើ ការអភិវឌ្ឍន៍ វិស័យ កសិកម្ម និង ជនបទ ដោយ សហការ យ៉ាង ជិតស្និត ជាមួយនឹង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ថ្នាក់ ក្រោម ជាតិ ដៃគូរ អភិវឌ្ឍន៍ សង្គម ស៊ីវិល និង វិស័យ ឯកជន ។
ក្រុមប្រឹក្សា ស្ដារ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម និង ជនបទ មាន ភារកិច្ច ទទួលបន្ទុក ចាត់ចែង សម្របសម្រួល តាមដាន វាយតម្លៃ និង ផ្តល់ យោបល់ លើ ការរៀបចំ ការអភិវឌ្ឈកម្មវិធី គោល នយោបាយ ព្រមទាំង យុត្តិសាស្ត្រ នានា របស់ រាជ រដ្ឋាភិបាល លើ ការអភិវឌ្ឍន៍ វិស័យ កសិកម្ម និង ជនបទ និង វិស័យ សន្តិសុខ ស្បៀង និង អាហារ រូបត្ថម្ភ ស្រប តាម គោលការណ៍ អភិវឌ្ឈន៍ ប្រកបដោយ ចីរភាព ឆ្នាំ ២០១៦ - ២០៣០ ។
គោលដៅ ទី២ បញ្ចប់ ភាពអត់ឃ្លាន សម្រេច ឱ្យ បាន សន្តិសុខ ស្បៀង ធ្វើឱ្យ ប្រសើរឡើង នូវ ស្ថេរភាព អាហារូបត្ថម្ភ និង លើកកម្ពស់ វិស័យ កសិកម្ម ប្រកបដោយ ចីរភាព ។
រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ដឹកនាំ ដោយ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន សម្រេច ដាក់ចេញ នូវ « យុទ្ធសាស្ត្រ បញ្ចកោណ » ជា កម្មវិធី នយោបាយ របស់ ខ្លួន សម្រាប់ ការកសាង និង ការពារ មាតុភូមិ ឆ្នាំ ២០២៣ - ២០២៨ ។
យុទ្ធសាស្ត្រ បញ្ចកោណ ត្រូវបាន ផ្តោត យកចិត្តទុកដាក់ ទៅ លើ ការអភិវឌ្ឍន៍ មូលធន មនុស្ស . ការធ្វើ ពិពិធកម្ម សេដ្ឋកិច្ច និង ការបង្កើន ភាពប្រកួតប្រជែង . ការអភិវឌ្ឍ វិស័យ ឯកជន និង ការងារ . ការអភិវឌ្ឍ ប្រកបដោយ ភាពធន់ . ចីរភាព និង បរិយាប័ន្ន និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ឌីជីថល ៕ គួរឲ្យ អាសូរ ណាស់ ! យុវជន ២នាក់ នៅ ក្រុង ដូន កែវ ខេត្ត តាកែវ លង់ទឹក ស្លាប់ នៅក្នុង ស្រះ វត្ត
សមត្ថកិច្ច ក្រុង ដូន កែវ បាន ឲ្យដឹង ថា ជនរងគ្រោះ ទី១ ឈ្មោះ តេត រតនា អាយុ ១៤ ឆ្នាំ រស់ នៅ ភូមិ ក្រាំង តា ពូង សង្កាត់ បារាយណ៍ ក្រុង ដូន កែវ និង ជនរងគ្រោះ ទី២ឈ្មោះ គក ដាវីន អាយុ ១៣ ឆ្នាំ រស់ នៅ ភូមិ ស្វាយ ឬ ស្សី សង្កាត់ បារាយណ៍ ក្រុង ដូន កែវ ។
លោក ឥន មណ្ឌល អធិការ នគបាល ក្រុង ដូន កែវ បាន ថ្លែង ឲ្យដឹង ថា មុនពេល កើត ហេតុ មាន ក្មេង ៧នាក់ បាន ជិះ ទូក លេង នៅក្នុង ស្រះ វត្ត បារាយ៍ ក្រោយមក ទូក ឃ្លីង ឃ្លោង លិច ពេល នោះ ក្មេងប្រុស ៥នាក់ បាន ហែល រួច ខ្លួន ដោយឡែក ជនរងគ្រោះ ២នាក់ ក៏ បាន លង់ទឹក ស្លាប់ តែម្ដង ។
បច្ចុប្បន្ន សុខ ជនរងគ្រោះ ទាំង ពីរ នាក់ ត្រូវបាន បញ្ជូន មកដល់ ផ្ទះ ដើម្បី ធ្វើ បុណ្យ តាម ប្រពៃណី ៕ CUS និង សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា រួមគ្នា អភិវឌ្ឍ ធនធាន មនុស្ស លើ វិស័យ មីក្រូ ហិរញ្ញវត្ថុ
( ភ្នំពេញ ) ៖ ដើម្បី ឆ្លើយតប ការរីកចម្រើន ឥត ឈប់ឈរ របស់ វិស័យ ហិរញ្ញវត្ថុ ក៏ ដូចជា តម្រូវការ ទីផ្សារ ការងារ របស់ និស្សិត នៅ តាម គ្រឹះស្ថាន ឧត្តម សិក្សា សាកលវិទ្យាល័យ ឯកទេស នៃ កម្ពុជា (CUS) និង សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា បាន សហការ គ្នា អភិវឌ្ឍ ធនធាន មនុស្ស លើ វិស័យ មីក្រូ ហិរញ្ញវត្ថុ ។
ពិធី ចុះ អនុស្សារណៈ យោគយល់ លើ កិច្ចសហប្រតិបត្តិការ បណ្តុះបណ្តាល ធនធាន មនុស្ស លើ វិស័យ មីក្រូ ហិរញ្ញវត្ថុ បាន ធ្វើឡើង កាលពី ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០២៣ នៅ ទីតាំង គោល របស់ CUS នៅ ខណ្ឌ ទូល គោក រាជធានី ភ្នំពេញ ។
ថ្លែ ក្នុង ឱកាស នោះ លោក បណ្ឌិត កែវ ជា សាកលវិទ្យាធិការ រង CUS បាន បង្ហាញ មោទនភាព ក្រៃលែង ចំពោះ ការរៀបចំ ពី ធី ដ៏ មាន សារៈសំខាន នេះ ឡើង ។
លោក បណ្ឌិត បញ្ជាក់ ថា កិច្ចសហប្រតិបត្តិការ រវាង CUS និង សមាគម មីក្រូ ហិរញ្ញវត្ថុ បាន បង្ហាញ ពី សុឆន្ទៈ សហប្រតិបត្តិការ និង ការចែករំលែក ពុទ្ធិ ដែល ជា មូលដ្ឋាន ក្នុង ការលើកកម្ពស់ សមត្ថភាព - ជំនាញ នៃ ការសិក្សា និង ង ប្រសិទ្ធភាព លើ ការងារ គ្រប់គ្រង ទាក់ទង វិស័យ ធនាគារ - ហិរញ្ញវត្ថុ នៅ តាម ស្ថាប័ន ទាំង រដ្ឋ និង ឯកជន ពាក់ព័ន្ធ ជំនាញ ដូចជា ការគ្រប់គ្រង រដ្ឋបាល ធនធាន មនុស្ស គណនេយ្យ សវនកម្ម ច្បាប់ និង ព័ត៌មានវិទ្យា ជាដើម ។
បច្ចុប្បន្ន សាកលវិទ្យាល័យ CUS មាន ៨ទីតាំង គឺ ២ទីតាំង នៅ រាជធានី ភ្នំពេញ និង ៦ទីតាំង ទៀត នៅ តាម បណ្តា ខេត្ត រួម មាន ខេត្ត កំពង់ចាម កំពង់ធំ សៀមរាប បន្ទាយមានជ័យ បាត់ដំបង និង ខេត្ត កំពត ។
កន្លងមក សាកលវិទ្យាល័យ ឯកទេស នៃ កម្ពុជា បាន ធ្វើ កិច្ចសហប្រតិបត្តិការ ជាមួយ ស្ថាប័ន ក្រុមហ៊ុន ដៃគូ ក្នុង និង ក្រៅ ប្រទេស ជាង ៥០០ ព្រមទាំង ចុះ អនុស្សរណៈ យោគយល់ ជាមួយ សាកលវិទ្យាល័យ និង ស្ថាប័ន បរទេស ចំនួន ជាង ៥០ ដូចជា ប្រទេស ថៃ កូរ៉េ ចិន ហ្វីលីពីន ឥណ្ឌូនេស៊ី អាឡឺម៉ង់ វៀតណាម អ៊ីស្រាអែល ឥណ្ឌា បង់ក្លាដេស ជប៉ុន អង់គ្លេស ម៉ាឡេស៊ី ។ល ។
ផ្អែក លើ បទពិសោធន៍ ជាង ២០ ឆ្នាំ និង ភាពជោគជ័យ ដែល សម្រេចបាន សាកលវិទ្យាល័យ ដ៏ ធំ មួយ នេះ ក៏ បាន ដាក់ចេញ នូវ ផែន ការ ច្បាស់លាស់ ដើម្បី សម្រេច ឱ្យ បាន ចក្ខុវិស័យ ប្រកួតប្រជែង ជាមួយ សាកលវិទ្យាល័យ អន្តរជាតិ ក្នុង តំបន់ អាស៊ី - ប៉ាស៊ីហ្វិក នៅ ឆ្នាំ ២០២៧ ខាងមុខ នេះ ៕
អាជ្ញាធរ មីន និង ស្ថានទូត ឥណ្ឌា ប្រចាំ កម្ពុជា ចុះហត្ថលេខា លើ គម្រោង បោសសម្អាត មីន នៅ ស្រុក ចំនួន ៤ ក្នុង ខេត្ត កោះកុង ប្រើប្រាស់ ថវិកា សរុប ជាង ៤២ ម៉ឺន ដុល្លារ
ទេសរដ្ឋមន្រ្តី លី ធុជ បាន លើកឡើង ថា តាមរយៈ ការគាំទ្រ ពី រាជ រដ្ឋាភិបាល ឥណ្ឌា អាជ្ញាធរ មីន បាន រៀបចំ ផែនការបោសសម្អាត មីន ក្នុង ស្រុក បុទុម សាគរ ស្រុក ស្រែ អំបិល ស្រុក ថ្ម បាំង និង ស្រុក កោះ កុង លើ ទំហំ ផ្ទៃដី ១. ៩៧២.០៩១ ម៉ែត្រ ក្រឡា ស្មើនឹង ៣៣ ចម្ការ មីន ដោយ ត្រូវ ប្រើប្រាស់ ថវិកា សរុប ៤២៦.៧០៩ ដុល្លារ អាមេរិក ។ គម្រោង នេះ នឹង ប្រែក្លាយ ស្រុក ទាំង៤ ខាងលើ ជា ស្រុក អស់ មីន ព្រមទាំង មាន ប្រជាពលរដ្ឋ ទទួល ផល សរុប ចំនួន ២០. ៣១៩ គ្រួសារ ស្មើនឹង ៨៦.៣៦៧ នាក់ ។
( រតនគិរី ) ៖ ថ្នាក់ដឹកនាំ ខេត្ត ដែល នៅជាប់ ព្រំដែន មុំ ៣ គឺ ខេត្ត រន គិរី . ខេត្ត អត្តពឺ របស់ ឡាវ និង ខេត្ត កន្ទូម របស់ វៀតណាម បាន ជួបប្រជុំ ពិភាក្សា ផ្លាស់ប្តូរ យោបល់ និង ឯកភាព គ្នា ស្នើ ទៅ ថ្នាក់ដឹកនាំ នៃ ភាគី នីមួយ ៗ ធ្វើ ការពិនិត្យ កែសម្រួល និង កសាង សំណង់ នៅក្នុង តំបន់ បង្គោល ព្រំដែន មុំ ៣ ។
អង្គប្រជុំ ធ្វើ ការផ្លាស់ប្តូរ មតិ យោបល់ គ្នា និង ឯកភាព គ្នា លើ ខ្លឹមសារ កំណត់ហេតុ ការងារ រវាង គណកម្មាធិការ កិច្ចការ ព្រំដែន ខេត្ត កន្ទូម នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ជាមួយ គណៈកម្មាធិការ កិច្ចការ ព្រំដែន ខេត្ត រតគិរី នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង គណៈកម្មាធិការ កិច្ចការ ព្រំដែន ខេត្ត អត្តពឺ នៃ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ ផងដែរ ៕
សំណើ ខាងលើ នេះ គឺ សម្រាប់ ឆ្នាំ ទី២ នៃ គម្រោង របស់ នាយក រដ្ឋមន្រ្តី ជប៉ុន លោក ហ្វូមី អុ គីស៉ី ដា ដែល សំដៅ បង្កើន ថវិកា ការពារ ជាតិ ទ្វេ ដង ឱ្យ ដល់ កម្រិត ២ភាគរយ នៃ GPD របស់ ប្រទេស ជប៉ុន នៅ ត្រឹម ឆ្នាំ ២០២៧ ស្រប ពេល ដែល ប្រទេស របស់ លោក ត្រូវ ប្រឈមមុខ នឹង ការកើនឡើង ឥទ្ធិពល របស់ ប្រទេស ចិន ហើយនិង ភាពពិបាក ប៉ាន់ស្មាន នៃ ប្រទេស កូរ៉េ ខាងជើង ។
សំណើ កញ្ចប់ ថវិកា ការពារ ជាតិ សម្រាប់ ឆ្នាំ សារពើពន្ធ ២០២៤ ដែល ត្រូវបាន ដាក់ ទៅកាន់ ក្រសួង ហិរញ្ញវត្ថុ ជប៉ុន គឺ បន្ថែម ជិត១ ទ្រីលាន យេន ( ៦.៨ ពាន់ លាន ដុល្លារ ) លើ កញ្ចប់ ថវិកា ឆ្នាំ ២០២៣ ដែល មាន ទំហំ ៦.៨ទ្រី លាន យេន ( ៤៦. ៥ពាន់ លាន ដុល្លារ ) ។ ប្រសិន ត្រូវបាន អនុម័ត កញ្ចប់ ថវិកា ការពារ ជាតិ ជប៉ុន នឹង បន្ត កើន ក្នុង ចំនួន ខ្ទង់ ១ទ្រី លាន យេន សម្រាប់ រយៈពេល ២ឆ្នាំ ជាប់ ៗ គ្នា ដែល មិន ធ្លាប់ មាន ពីមុន មក ឡើយ ។
គួរ បញ្ជាក់ ថា ការបង្កើន ការចំណាយ លើ វិស័យ ការពារ ជាតិ នេះ ដោយ ប្រទេស ជប៉ុន គឺ កើត មាន ឡើង បន្ទាប់ពី ទីក្រុង តូក្យូ បាន ប្រកាន់ខ្ជាប់ នូវ គោល នយោបាយ បាយ សន្តិនិយម អស់ រយៈពេល រាប់ ទសវត្សរ៍ មក ហើយ ។ កាលពី ឆ្នាំ ១៩៤៧ សហរដ្ឋ អាមេរិក ដែល បច្ចុប្បន្ន ជា សម្ព័ន្ធមិត្ត របស់ ទីក្រុង តូក្យូ បាន សរសេរ រដ្ឋធម្មនុញ្ញ ថ្មី ឱ្យ ប្រទេស ជប៉ុន ដែល លះបង់ ចោល សិទ្ធិ ក្នុង ការធ្វើ សង្រ្គាម បន្ទាប់ពី ជប៉ុន ចុះ ចាញ់ សង្រ្គាម លោក លើក ទី២៕
លោក បូរ៉ែ ល បាន ឲ្យដឹង ថា មាន កិច្ចព្រមព្រៀង មួយ ជាមួយ ក្រុមហ៊ុន ផលិត អាវុធ ដើម្បី អនុញ្ញាតឲ្យ ប្រទេស សមាជិក EU ដាក់ ការបញ្ជាទិញ រួមគ្នា នូវ គ្រាប់ សម្រាប់ កាំភ្លើង ធំ ១៥៥ មីលីម៉ែត្រ ដែល អ៊ុយក្រែន កំពុង ត្រូវការ ប្រយុទ្ធ ប្រឆាំង នឹង ការឈ្លានពាន របស់ រុស្ស៉ី ។
លោក បូរ៉ែ ល បាន ប្រាប់ អ្នកយកព័ត៌មាន បន្ទាប់ពី កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ EU នៅ ទីក្រុង តូឡេដូ (Toledo) របស់ អេស្ប៉ាញ យ៉ាង ដូច្នេះ ថា « ឥឡូវនេះ ប្រទេស ជា សមាជិក ទាំងអស់ ត្រូវតែ អនុម័ត ការបញ្ជាទិញ ជាក់ស្តែង ទៅ តាម ក្របខណ្ឌ នៃ កិច្ចព្រមព្រៀង ជាមួយ ខាង ឧស្សាហកម្ម ផលិត » ។
នាយក រដ្ឋមន្រ្តី ប្រទេស លុចសំបួ ផ្ញើ សារ អបអរសាទរ ជូន ឯកឧត្តម កិត្តិទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត សម្រាប់ ការចូលកាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ថ្មី របស់ កម្ពុជា
ខាងក្រោម នេះ ជា សារលិខិត អបអរសាទរ របស់ នាយក រដ្ឋមន្រ្តី ប្រទេស លុចសំបួ៖
ប៉ុន្តែ ក្រសួង ការបរទេស អាមេរិក ក៏ បាន អះអាង ដែរ ថា ការផ្ទេរ បរិក្ខារ យោធា នៅក្រោម កម្មវិធី FMF មិន មែន ឆ្លុះបញ្ចំាង ពី ការប្រែប្រួល នៅក្នុង គោល នយោបាយ ស្ដីពី ឋានៈ របស់ កោះ តៃវ៉ាន់ នោះ ទេ ដោយ ចង់ សំដៅ លើ គោល នយោបាយ ចិន តែ មួយ ។ ចំណែក ខាង ក្រសួង ការពារ ជាតិ តៃវ៉ាន់ ក៏ បាន ថ្លែងអំណរគុណ ដល់ សហរដ្ឋ អាមេរិក ផងដែរ តែ មិន បាន ធ្វើ អត្ថាធិប្បាយ លម្អិត អ្វី លើ ជំនួយ យោធា អាមេរិក នោះ ទេ ។
នាយក រដ្ឋមន្រ្តី ស៊ែប៊ី ផ្ញើ សារ អបអរសាទរ ជូន ឯកឧត្តម កិត្តិទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត សម្រាប់ ការចូលកាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ថ្មី របស់ កម្ពុជា
ខាងក្រោម នេះ ជា សារលិខិត អបអរសាទរ របស់ នាយក រដ្ឋមន្រ្តី ប្រទេស ស៊ែប៊ី៖ នាយក រដ្ឋមន្រ្តី ហូឡង់ ផ្ញើ សារ អបអរសាទរ ជូន ឯកឧត្តម កិត្តិទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត សម្រាប់ ការចូលកាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ថ្មី របស់ កម្ពុជា
ខាងក្រោម នេះ ជា សារលិខិត អបអរសាទរ របស់ នាយក រដ្ឋមន្រ្តី ហូឡង់៖ កម្ពុជា - ចិន លើកឡើង ពី ផ្លែ ផ្កា នៃ កិច្ចសហប្រតិបត្តិការ វិស័យ វប្បធម៌ បេតិកភណ្ឌ បុរាណវិទ្យា ទេសចរណ៍ វិនិយោគ នៅ ខេត្ត សៀមរាប
កម្មវិធី នេះ ដែរ ក៏ ដើម្បី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៦៥ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត រវាង កម្ពុជា និង ចិន ក៏ ដូចជា ខួប លើក ទី១០ នៃ ការកសាង រួមគ្នា លើ គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » ដើម្បី បង្ហាញ អំពី ទំនាក់ទំនង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង ប្រទេស ទាំង ពីរ ដែល មាន ទំនាក់ទំនង គ្នា តាំងតែពី សម័យ អង្គរ មកហើយ ។
លោក លីវ ជឺជី បាបញ្ជាក់ ថា ដើម្បី ការពារ រមណីយដ្ឋាន អង្គរ ប្រកបដោយ ចីរភាព ចិន បាន ឆ្លើយតប តាម ការអំពាវនាវ របស់ អង្គការ យូណេស្កូ និង រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ដ៏ ទំនើប លើ ទុន វិនិយោគ ចំនួន ជាង ១ ពាន់ លាន ដុល្លារ អាមេរិក ផងដែរ ។
លោក អភិបាល រង ខេត្ត បាន បន្ត ទៀត ថា ក្រោយពី ការចុះ ក្នុង បញ្ជីសម្បត្តិ បេតិកភណ្ឌ ពិភពលោក នៅ ឆ្នាំ ១៩៩២ ដោយ គ្របដណ្តប់ ដោយ ផ្ទៃដី ប្រមាណ ៤០១ គីឡូម៉ែត្រ ក្រឡា ប្រាសាទ នានា ក្នុង តំបន់ រមណីយដ្ឋាន អង្គរ ទទួលបាន ការអភិរក្ស និង ជួសជុល សា ជា ថ្មី ក្រោម កិច្ចសហការ របស់ អង្គការ UNESCO និង រាជ រដ្ឋាភិបាល កម្ពុជា អាជ្ញាធរ ខេត្ត អាជ្ញាធរ ជាតិ អប្សរា និង ភាគី ជាតិ - អន្តរជាតិ ពាក់ព័ន្ធ ដទៃ ទៀត បាន ចូលរួម ប្រែក្លាយ តំបន់ ដែល ធ្លាប់ រង គ្រោះ ដោយ សង្គ្រាម ទៅជា តំបន់ រមណីយដ្ឋាន ទេសចរណ៍ ដ៏ ទាក់ទាញ របស់ ពិភពលោក ។
កាលពី ថ្ងៃទី ២៣ ខែសីហា ឆ្នាំ ២០២៣ កន្លងទៅ ឯកឧត្តម កិត្តិទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ផ្ទេរ ភារកិច្ច លោក ឧត្តមសេនីយ៍ ឯក ស រដ្ឋា ពី អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ មក ជា អគ្គ ស្នងការ រង នគរបាល ជាតិ ។
រំលង បាន មួយ ថ្ងៃ ពោល នៅ ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០២៣ លោក អភិសន្ដិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ បាន ចេញ ប្រកាស ប្រគល់ ភារកិច្ច ជូន លោក ឧត្តមសេនីយ៍ ឯក ស រដ្ឋា អគ្គ ស្នងការ រង នគរបាល ជាតិ ឲ្យ ទទួល ជា ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ ៕
EDC ជូនដំណឹង ពី ការរអាក់រអួល ចរន្ត ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ០៣ ខែកញ្ញា ដើម្បី រុះរើ គន្លង ខ្សែ បណ្តាញ ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ ដំឡើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ ដល់ ថ្ងៃទី ០៣ ខែកញ្ញា ឆ្នាំ ២០២៣ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
ដោយ បង្ហាញ វត្តមាន តាមរយៈ ប៉ុស្តិ៍ ទូរទស្សន៍ Gabon 24 ក្រុម មន្រ្តី យោធា ខាងលើ បាន អះអាង ថា ពួកគេ តំណាង ឱ្យ កងកម្លាំង សន្តិសុខ និង ការពារ ជាតិ ទាំងអស់ នៅក្នុង ប្រទេស ហ្កាបុង ។ ពួកគេ បាន បន្ត ថា លទ្ធផល នៃ ការបោះឆ្នោត ដែល ទើបតែ បាន ប្រព្រឹត្តទៅ កាលពី ថ្ងៃសៅរ៍ ចុង សប្តាហ៍ មុន គឺ ត្រូវបាន ចាត់ ទុក ជា មោឃៈ ខណៈ ព្រំប្រទល់ ទាំងអស់ របស់ ប្រទេស ត្រូវ បិទ រហូតដល់ មាន ការជូនដំណឹង ជាថ្មី ហើយ ស្ថាប័ន រដ្ឋ នានា ត្រូវបាន រំលាយ ចោល ។
ក្រុម មន្រ្តី យោធា ដដែល បាន និយាយ យ៉ាង ដូច្នេះ ថា « តាង នាម ឱ្យ ប្រជាជន ហ្កា បុង ទាំងអស់ យើង បាន សម្រេចចិត្ត ការពារ សន្តិភាព តាមរយៈ ការបិទ បញ្ចប់ របប ដឹកនាំ បច្ចុប្បន្ន » ។ ក្រុម អ្នកកាសែត អន្តរជាតិ មួយចំនួន ដែល នៅ យក ការណ៍ ក្នុង តំបន់ បាន ឱ្យដឹង ថា មាន សំឡេង កាំភ្លើង ត្រូវបាន លឺ នៅក្នុង រដ្ឋធានី លីប្រឺ វីល (Libreville) ក្រោយ ការចេញមុខ ប្រកាស តាម កញ្ចក់ ទូរទស្សន៍ របស់ ក្រុម យោធា ។
ប៉ុន្មាន ថ្ងៃ ចុងក្រោយ នេះ ភាពតានតឹង គឺ ស្ថិត ក្នុង កម្រិត ខ្ពស់ ចំពោះ មុខ ក្តី ព្រួយបារម្ភ អំពី ភាពវឹកវរ ក្រោយ ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី ដែល បាន មើលឃើញ លោក Bongo ព្យាយាម បន្ត រក្សា ការកាន់អំណាច ដែល មាន រយៈពេល សរុប ប្រមាណ ជា ៥៦ ឆ្នាំ មកហើយ នៃ គ្រួសារ របស់ លោក ស្រប ពេល ដែល ក្រុម ប្រឆាំង ព្យាយាម ប្រឹងប្រែង ចង់ឱ្យ មាន ការផ្លាស់ប្តូរ ។
ដោយ មើលឃើញ ពី គំរូ យោធា នៅ ប្រទេស ឆាដ និង ប្រទេស អាហ្វ្រិក ដែល ធ្លាប់ បាន ធ្វើ រដ្ឋប្រហារ កន្លងមក មិន ទទួលរង ការផ្តន្ទាទោស ធ្ងន់ធ្ងរ ពី សហគមន៍ អន្តរជាតិ យោធា នៅ តាម ប្រទេស អាហ្វ្រិក ដទៃ ទៀត ដែល មាន អំណាច និង អាវុធ នៅក្នុង ដៃ ប្រហែលជា អាច គិត ឬ ចោទ សួរ ខ្លួន ឯង ថា « គេ ផ្សេង អាច ធ្វើ រដ្ឋប្រហារ បាន ហេតុ អ្វី បានជា ពួកគេ មិន ធ្វើ រដ្ឋប្រហារ នឹង គេ ដែរ ទៅ » ៕
( ព្រះសីហនុ) ៖ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ តំណាង លោក អភិសន្ដិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ នៅ ព្រឹក ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ ស្អែក នេះ នឹង អញ្ជើញ ជា អធិបតីភាព ប្រកាស ចូលកាន់ តំណែង លោក ឧត្តមសេនីយ៍ ឯក ស រដ្ឋា ជា អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ និង ថ្នាក់ដឹកនាំ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នាយ នគរបាល ពាក់ព័ន្ធ ស្នងការ រង នាយ ការិយាល័យ អធិការ ក្រុង ស្រុក និង នាយ ប៉ុស្ដិ៍ នគរបាល រដ្ឋបាល ទាំងអស់ ចំណុះ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ ។
មនុស្ស ៦នាក់ បាន ស្លាប់ ក្នុង អគ្គីភ័យ ឆេះ អគារ លំនៅដ្ឋាន មួយ នៅ ភាគ ខាងកើត ប្រទេស ចិន
រដ្ឋាភិបាល ក្នុង តំបន់ បាន និយាយ ថា អគ្គីភ័យ បាន កើតឡើង នៅ ម៉ោង ប្រហែល ៣និង ៤០ នាទី ទៀប ភ្លឺ ក្នុង ភូមិ មួយ នៃ ទីក្រុង Taizhou ។ ក្រុម អ្នក ជួយសង្គ្រោះ បាន ប្រញាប់ប្រញាល់ ទៅកាន់ កន្លែង កើត ហេតុ បន្ទាប់ពី ទទួលបាន របាយការណ៍ ពី ប៉ូលីស ដែល ពួកគេ បាន រកឃើញ មនុស្ស ចំនួន ៦នាក់ ដែល ជាប់ នៅក្នុង អគ្គីភ័យ នេះ ។
សាកសព ៣នាក់ ត្រូវបាន គេ រកឃើញ នៅ កន្លែង កើត ហេតុ ខណៈ ៣នាក់ ផ្សេង ទៀត បាន ស្លាប់ ដោយសារ របួស ទោះបី ខំ ជួយសង្គ្រោះ នៅ មន្ទីរពេទ្យ ក៏ដោយ ។
ចំណែក មូលហេតុ នៃ គ្រោះ អគ្គីភ័យ នេះ កំពុង ត្រូវបាន ស៊ើបអង្កេត បន្ថែម ៕
អភិបាល ខេត្ត កែប ដឹកនាំ កិច្ចប្រជុំ ឆ្លង សេចក្តីព្រាង របាយការណ៍ ប្រចាំ ខែសីហា ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ខែ បន្ទាប់
( កែប )៖ នា ថ្ងៃទី ៣០ ខែសីហា ឆ្នាំ ២០២៣ លោក បណ្ឌិត សោម ពិសិដ្ឋ អភិបាល ខេត្ត កែប បាន ដឹកនាំ កិច្ចប្រជុំ ឆ្លង សេចក្តីព្រាង របាយការណ៍ ប្រចាំ ខែសីហា ឆ្នាំ ២០២៣ និង លើក ទិសដៅ សម្រាប់ អនុវត្ត ខែកញ្ញា ឆ្នាំ ២០២៣ ដោយ មាន ការចូលរួម ពី បណ្តា មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត នាយក រដ្ឋបាល សាលា ខេត្ត នាយក ទី ចាត់ការ នានា ចំណុះ រដ្ឋបាល ខេត្ត អភិបាល ក្រុង ស្រុក និង មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ជាច្រើន ទៀត ។
ថ្លែង បើក កិច្ចប្រជុំ នេះ លោក បណ្ឌិត សោម ពិសិដ្ឋ បាន គូសបញ្ជាក់ ថា ក្រៅពី ឆ្លង របាយការណ៍ ប្រចាំ ខែសីហា ឆ្នាំ ២០២៣ និង ទិសដៅ ការងារ បន្ទាប់ ក៏ នឹង ផ្សព្វផ្សាយ សេចក្តីព្រាង កែសម្រួស សមាសភាព គណៈកម្មការពិគ្រោះ យោបល់ ស្រ្តី និង កុមារ ក្រុមប្រឹក្សា ខេត្ត សេចក្តីព្រាង សេចក្តីសម្រេច កែសម្រួល សមាសភាព គណៈកម្មការ លទ្ធកម្ម និង គណៈកម្មការ សម្របសម្រួល បច្ចេកទេស ក្រុមប្រឹក្សា ខេត្ត និង ធ្វើ ការផ្សព្វផ្សាយ នូវ សេចក្តីព្រាង កែសម្រួល សមាសភាព មន្ត្រី ទទួលបន្ទុក ព័ត៌មាន រដ្ឋបាល ខេត្ត ។
ក្នុង នោះ ដែរ លោក អភិបាល ខេត្ត ក៏ បាន សង្កត់ធ្ងន់ ឲ្យ គ្រប់ មន្ទីរ អង្គភាព នានា ធ្វើ ការបណ្តុះបណ្តាល មន្ត្រី ស្នូល ដែល មាន សមត្ថភាព មាន លទ្ធភាព ក្នុង ការធ្វើជា អ្នកនាំពាក្យ ក្នុង អង្គភាព របស់ ខ្លួន ។ ហើយ មន្ត្រី នាំ ពាក្យ ក្នុង មន្ទីរ ឬ អង្គភាព មួយ ពិតជា មាន សារសំខាន់ ក្នុង ការឆ្លើយតប បន្ទាន់ នូវ រាល់ ហេតុការណ៍ ឬ បញ្ហា ណាមួយ ក្នុង ស្ថាប័ន និង ទាមទា អោយ មាន ចំណេះដឹង គ្រប់គ្រាន់ លើ ដែន សមត្ថកិច្ច ទទួលខុសត្រូវ និង មាន មូលដ្ឋាន យោង ច្បាស់លាស់ ។
ទន្ទឹម នេះ លោក អភិបាល ខេត្ត ស្នើឲ្យ គ្រប់ អ្នក ពាក់ព័ន្ធ ពិនិត្យ អោយ បានជាក់លាក់ នូវ ខ្លឹមសារ និង ទិន្នន័យ ពាក់ព័ន្ធ សមត្ថកិច្ច របស់ ខ្លួន ឲ្យ មាន ភាពត្រឹមត្រូវ ដើម្បី ដាក់ ជូន ក្រុមប្រឹក្សា ខេត្ត អនុម័ត និង ធ្វើ ការបោះពុម្ព ជា ផ្លូវការ ផ្ញើ ជូន ថ្នាក់ ជាតិ ឲ្យបាន ទាន់ ពេលវេលា ៕ លោក ជា សឿន ត្រូវបាន ប្រកាស តែងតាំង ជា សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ជាតិ មាន ជ័យ
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០២៣ លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្រ្តី ក្រសួង អប់រំ យុវជន និង កីឡា បាន អញ្ជើញ ចូលរួម ជា អធិបតី ក្នុង ពិធី ប្រកាស ចូលកាន់ មុខតំណែង របស់ ឯកឧត្ដម ជា សឿន ជា សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ជាតិ មានជ័យ ខេត្ត បន្ទាយមានជ័យ ។
សម្រាប់ ទិសដៅ ចម្បង របស់ ក្រសួង នា ពេលនេះ គឺ ការកសាង សមត្ថភាព ស្ថាប័ន និង បង្កើត ឱ្យ មាន ប្រព័ន្ធ អេកូឡូស៊ី ពេញលេញ មួយ ដើម្បី លើកកម្ពស់ ឧត្តមភាព របស់ អ្នកស្រាវជ្រាវ និង ការបណ្តុះ ឱ្យ មាន ចរន្ត ស្រាវជ្រាវ ជាប្រចាំ នៅ តាម គ្រឹះស្ថាន ឧត្ដម សិក្សា ដែល កិច្ចការ ស្រាវជ្រាវ នេះ ជា គន្លឹះ ដ៏ សំខាន់ ក្នុង ការជំរុញ កំណើន សេដ្ឋកិច្ច កម្ពុជា ឱ្យ ប្រែក្លាយជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ ក្នុង ឆ្នាំ ២០៣០ និង ប្រទេស មាន ចំណូល ខ្ពស់ ក្នុង ឆ្នាំ ២០៥០ ។
នា ឱកាស នេះ លោក បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន លើកឡើង បន្ថែម ទៀត ផងដែរ ថា ក្រសួង នឹង បន្ត អនុវត្ត កំណែទម្រង់ នៅ ឧត្តម សិក្សា ដើម្បី ធានា បាន នូវ ការបណ្តុះ ធនធាន មនុស្ស សម្រាប់ បម្រើ ដល់ ការ អភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច កម្ពុជា ដោយ ផ្តោត លើ៖
* ទី១៖ ការពង្រឹង អភិបាលកិច្ច នៅ តាម គ្រឹះស្ថាន ឧត្តម សិក្សា * ទី២៖ ការលើកកម្ពស់ គុណ វុឌ្ឍិ សាស្ត្រាចារ្យ ឱ្យ មាន សញ្ញាបត្រ ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ និង ថ្នាក់ បណ្ឌិត * ទី ៣៖ ការជំរុញ ការសិក្សា ការបណ្តុះបណ្តាល និង កសាង ជំនាញ ផ្នែក ឌីជីថល និង ជំនាញ ថ្មី ៗ * ទី៤៖ ការជំរុញ សកម្មភាព ស្រាវជ្រាវ និង អភិវឌ្ឍន៍ ព្រមទាំង ន វានុវត្តន៍ ផ្នែក ឌីជីថល * ទី ៥៖ ការកសាង ភាពជាដៃគូ ជាមួយនឹង វិស័យ ឯកជន ក្នុង ការជំរុញ និង ការអភិវឌ្ឍ ការងារ ស្រាវជ្រាវ អភិវឌ្ឍន៍ និង ន វានុវត្តន៍ ។
យោង តាម អនុសាសន៍ របស់ កិត្តិទេសាភិបាល បណ្ឌិត នាយក រដ្ឋមន្ត្រី នៅក្នុង កិច្ចប្រជុំ ដំបូង គណៈ រដ្ឋមន្ត្រី សម្រាប់ នីតិកាល ទី៧ ( ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០២៣ ) ដើម្បី លើកកម្ពស់ គុណភាព អប់រំ ដោយ ផ្តោត លើ ការពង្រឹង គុណភាព គ្រឹះស្ថាន សិក្សា រដ្ឋ ចាប់ពី ថ្នាក់ មត្តេយ្យ សិក្សា ដល់ មធ្យមសិក្សា តាមរយៈ ការពង្រឹង កិច្ចការ សំខាន់ ៗ រួម មាន៖
បណ្តា សហគមន៍ មកពី ខេត្ត ៥ រៀបចំ កិច្ចសន្ទនា ស្តីពី ការពារ ធន ធម្មជាតិ ដើម្បី ផ្លាស់ប្តូរ បទពិសោធន៍ និង ស្វែងរក ដំណោះស្រាយ បញ្ហា ប្រឈម
( ស្ទឹងត្រែង ) ៖ ក្រោម កិច្ចសហការ គាំទ្រ ពី អង្គការ ក្រុមប្រឹក្សា យុវជន កម្ពុជា ហៅ កាត់ ថា YCC បណ្តា សហគមន៍ ការពារ ធនធាន ធម្មជាតិ មកពី ខេត្ត ស្ទឹងត្រែង ខេត្ត ក្រចេះ ខេត្ត ព្រះវិហារ ខេត្ត កំពង់ធំ និង ខេត្ត ឧត្តមានជ័យ បាន រៀបចំ កិច្ចសន្ទា នា មួយ ក្នុង គោលបំណង ផ្លាស់ប្តូរ បទពិសោធន៍ គ្នា ទៅវិញ មក និង ស្វែងរក ដំណោះស្រាយ ពី អាជ្ញាធរ ពាក់ព័ន្ធ ដើម្បី ធ្វើ យ៉ាង អាច ការពារ ធនធាន ធម្មជាតិ នៅក្នុង សហគមន៍ របស់ ខ្លួន ។
កិច្ចសន្ទានា នេះ ធ្វើឡើង នៅ សណ្ឋាគារ រស្មី ពេជ្រ នា ថ្ងៃទី ៣០ ខែសីហា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព លោក ចៅ មុន្នីរ៉ា អភិបាល រង ខេត្ត និង តំណាង លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ស្ទឹងត្រែង ព្រមទាំង មាន ការចូលរួម ពី មន្ត្រី បរិស្ថាន នាយ ខណ្ឌ រដ្ឋបាល ព្រៃឈើ ខេត្ត និង នាយ ខណ្ឌ ជល ផល ផងដែរ ។
ឆ្លើយតម ចំពោះ ការស្នើរ របស់ សហគមន៍ លោក ចៅ មុន្នីរ៉ា បាន សន្យា យក បញ្ហា ប្រឈម ទាំងឡាយ ដែល សហគមន៍ បាន លើកឡើង ជម្រាប់ ជូន ដល់ ថ្នាក់ដឹកនាំ ខេត្ត និង ជំរុញ បន្ថែម ដល់ អ្នក ពាក់ព័ន្ធ ចុះ ពិនិត្យ ស្រាវជ្រាវ ទប់ស្កាត់ និង ដោះស្រាយ លើ បញ្ហា នេះ ។
អភិបាល រង ខេត្ត ស្ទឹងត្រែង បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា អាជ្ញាធរ ខេត្ត ស្ទឹងត្រែង បាន យកចិត្តទុកដាក់ លើ បញ្ហា ការពារ ធន ធម្មជាតិ នេះ ព្រមទាំង មាន វិធានការ ទប់ស្កាត់ នូវ រាល់ បទល្មើស នានា ដែល បាន កើតឡើង នូវ ក្នុង ភូមិសាស្ត្រ ខេត្ត ស្ទឹងត្រែង ដើម្បី ធ្វើ យ៉ាងណា ឲ្យ ធនធាន ធម្មជាតិ ក្នុង ខេត្ត នៅ គង់វង្ស សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ ។
គួរ បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ នៅក្នុង ខេត្ត ស្ទឹងត្រែង មាន តំបន់ ការពារ ធនធាន ធម្មជាតិ ចំនួន ៦ សហគមន៍ ព្រៃឈើ ចំនួន ២២ សហគមន៍ ជនជាតិ ដើម ភាគ តិច ចំនួន ១៨ និង សហគមន៍ នេសាទ ចំនួន ៦២ ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៣៥ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ៣០ ខែសីហា ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២៨៨ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៤៤ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២២៧ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ។ ដោយឡែក រថយន្ត រួម មាន៖ ល្មើស ល្បឿន និង ល្មើស សញ្ញា ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៥ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៣ នាក់ របួស ចំនួន ០១នាក់ ( របួស ធ្ងន់ ចំនួន ០១នាក់ ) ។ រយៈពេល ៣០ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ២៨៨ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១៣២ នាក់ របួស ៣៩៦ នាក់ ( របួស ធ្ងន់ ២៤៦ នាក់ )៕
ក្រុម មន្ត្រី នៃ កងកម្លាំង អវកាស បាន ប្រាប់ អ្នកយកព័ត៌មាន ក្នុង សន្និសីទ សារព័ត៌មាន មួយ នៅឯ មូលដ្ឋាន ទ័ព អាកាស អូសាន (Osan) ភាគ ខាងត្បូង ទីក្រុង សេអ៊ូល ថា ព័ត៌មាន លម្អិត នៃ កិច្ចសហប្រតិបត្តិការ ត្រី ភាគី នោះ កំពុង ដោះស្រាយ នៅ កម្រិត ខ្ពស់ ជាង នេះ ។
មន្ទីរ កសិកម្ម ខេត្ត ព្រៃវែង ចាក់ វ៉ាក់សាំង ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ ឆ្លង ដល់ សត្វ គោ ក្របី នៅ ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ លោក អ៊ុក សំណាង ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រៃវែង នា ថ្ងៃទី ៣០ ខែសីហា ឆ្នាំ ២០២៣ បាន ដឹកនាំ មន្ត្រី ជំនាញ បន្ត ជំរុញ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ ឆ្លង ដល់ សត្វ គោ ក្របី ជាពិសេស ជំងឺ សារ ទឹក អុត ក្ដាម និង ជំងឺ ដុំ ពក លើ ស្បែក នៅ ភូមិ ស្រះ ឃុំ រំចេក ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង ។
លោក ប្រធាន មន្ទីរ កសិកម្ម បាន បញ្ជាក់ ថា ការចាក់ វ៉ាក់សាំង នេះ មាន សារសំខាន់ ណាស់ ព្រោះ ផលិតកម្ម សត្វ បាន រួមចំណែក ក្នុង ការបង្កើន ចំណូល សេដ្ឋកិច្ច ដល់ គ្រួសារ កសិករ ក៏ ដូចជា ការទ្រ ទ្រុង ចំណូល សេដ្ឋកិច្ច ជាតិ ផងដែរ ។
លោក អ៊ុក សំណាង បាន បន្ត ថា ដើម្បី ទប់ស្កាត់ ជំងឺ ឆ្លង សត្វ ជារៀងរាល់ ឆ្នាំ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ អគ្គ នាយកដ្ឋាន សុខភាព សត្វ និង ផលិតកម្ម សត្វ បាន យកចិត្ត ខ្ពស់ ក្នុង ការផ្តល់ នូវ សម្ភារៈ បរិក្ខារ ថ្នាំ ព្យាបាល នឹង វ៉ាក់សាំង ការពារ មក មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ក៏ ដូចជា ការិយាល័យ ផលិតកម្ម និង បសុព្យាបាល សម្រាប់ ប្រើប្រាស់ ក្នុង យុទ្ធ ការចាក់ វ៉ាក់សាំង ការពារ និង ព្យាបាល សត្វ ពាហនៈ ជូន ប្រជាពលរដ្ឋ បាន យ៉ាង ទូលំទូលាយ ក្នុង ខេត្ត ព្រៃវែង ។
ជាមួយគ្នា នេះ លោក ប្រធាន មន្ទីរ ក៏ បាន សំណូមពរ ដល់ អាជ្ញាធរ មូលដ្ឋាន ជួយ ផ្សព្វផ្សាយ ឲ្យបាន ទូលំទូលាយ ដល់ អ្នក ចិញ្ចឹម សត្វ ក្នុង ការនាំ សត្វ មក ចាក់ វ៉ាក់សាំង ឲ្យបាន ជោគជ័យ ក្នុង ការគាំពារ សុខភាព សត្វ ជូន ប្រជាពលរដ្ឋ អ្នក ចិញ្ចឹម សត្វ ផងដែរ ៕
ត្រូវ និយាយ ថា ទេ ចំពោះ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែសីហា៖ បង្ក្រាប ១២ករណី ឃាត់ខ្លួន ២១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៣ករណី . ជួញដូរ ១ករណី . ចាត់ចែង សម្រួល ១ករណី និង ដឹកជញ្ជូន រក្សាទុក ៧ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ២១ នាក់ ។
ករណី ទឹក ហូរ នៅ ជាន់ ទី៥ នៃ អគារ ទីស្តីការ ថ្មី ក្រសួង មហាផ្ទៃ បាន កើតឡើង កាលពី វេលា ម៉ោង ១១. ០០នាទី នា ថ្ងៃទី ៣០ ខែសីហា ឆ្នាំ ២០២៣ ជា ថ្ងៃ សែន ក្បាល ទឹក ប៉ុន្តែ គណៈកម្មការ សាងសង់ អគារ ក៏ បាន ចាត់ វិធានការ ភ្លាម ៗ និង គ្រប់គ្រង បាន ទាន់ ពេលវេលា មិន បណ្តាល ឱ្យ មាន ហានិភ័យ អ្វី នោះ ឡើយ ។
បើ តាម នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ បាន ឱ្យដឹង ថា ក្រោយពី បើក ការស្រាវជ្រាវ គណៈកម្មការ សាងសង់ អគារ បាន រកឃើញ ថា មាន បុគ្គល មិន ស្គាល់ អត្តសញ្ញាណ ម្នាក់ បាន ឆ្លៀត ឱកាស នៅ ចុង ម៉ោង ធ្វើការលប បើក ក្បាល ទុយោ ទឹក សម្រាប់ សង្គ្រោះ បន្ទាន់ ករណី មាន អគ្គិភ័យ ធ្វើឱ្យ ទឹក ហូរ ចេញមក ។ ទន្ទឹម នេះ គណៈកម្មការ សាងសង់ អគារ ក៏ បាន រកឃើញ មន្ត្រី នគរបាល ថ្នាក់ អនុ សេនីយ៍ ឯក ម្នាក់ ជា អ្នកថត វីដេអូ សកម្មភាព ប៉ុន្តែ ពុំ ទាន់ ដឹង ថា តើ បុគ្គល ណា ជា អ្នកទម្លាយ វីដេអូ ចេញ ទៅ ខាងក្រៅ នៅ ឡើយ ។
តាម សេចក្តីសន្និដ្ឋាន របស់ គណៈកម្មការ សាងសង់ អគារ បញ្ជាក់ ថា ករណី នេះ ពុំ មែន បណ្ដាល មកពី លក្ខណៈ បច្ចេកទេស សំណង់ នោះ ឡើយ គឺ អាច ជា ចេតនា ទុច្ចរិត របស់ បុគ្គល ដែល មិន សប្បាយ ចិត្ត នឹង សមិទ្ធផល ដ៏ ល្អ វិចិត្រ ផូរផង់ ក្រោម ការគ្រប់គ្រង ចាត់ចែង របស់ គណៈកម្មការ សាងសង់ អគារ ថ្មី នេះ ក្នុង បំណង មិន ល្អ ធ្វើឱ្យ ប៉ះពាល់ កិត្តិយស របស់ គណៈកម្មការ សាងសង់ អគារ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ បាន បញ្ជាក់ ជូន ផងដែរ ថា ទោះបី កាមេរ៉ា សុវត្ថិភាព ពុំ ទាន់ បំពាក់ រួច រាល់ គ្រប់ ជ្រុង នៅឡើយ ក៏ គណៈកម្មការ សាងសង់ អគារ បាន កំពុង បន្ត នីតិវិធី ស្រាវជ្រាវ រក អត្តសញ្ញណ បុគ្គល ដែល លប លួច បើក ក្បាល ទុយោ ទឹក និង បុគ្គល ដែល ទម្លាយ វីដេអូ ចេញ ទៅ ខាងក្រៅ ដើម្បី ចាត់ការ តាម ច្បាប់ និង អនុវត្ត វិន័យ តាម លក្ខន្តិកៈ មន្ត្រី នគរបាល ជាតិ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ សូម ថ្លែងអំណរគុណ ចំពោះ បណ្តា អង្គភាព សារព័ត៌មាន និង សាធារណជន គ្រប់ មជ្ឈដ្ឋាន ដែល តែងតែ សហការ គាំទ្រ និង តាមដាន យ៉ាង យកចិត្តទុកដាក់ រាល់ កិច្ចការ របស់ ក្រសួង មហាផ្ទៃ ៕ ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ កម្ពុជា ជាច្រើន រូប បាន ចូលរួម អបអរសាទរ ខួប លើក ទី ៧៨ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ របស់ វៀតណាម
( ភ្នំពេញ ) ៖ ស្ថានទូត វៀតណាម ប្រចាំ ព្រះរាជាណាចក្រ កម្ពុជា នៅ រាត្រី ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០២៣ ម្សិលមិញ បាន រៀបចំ បាន ប្រារព្ធ ពិធី អបអរសាទរ ខួប លើក ទី ៧៨ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ( ថ្ងៃទី២ ខែកញ្ញា ឆ្នាំ ១៩៤៥ ដល់ ថ្ងៃទី២ ខែកញ្ញា ឆ្នាំ ២០២៣) ។ ពិធី នេះ បាន ធ្វើ នៅ សណ្ឋាគារ សូហ្វី តែ ល រាជធានី ភ្នំពេញ ។
វា បុណ្យ ឯករាជ្យ ជាតិ នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ . លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី ប្រធាន រដ្ឋសភា កម្ពុជា . ឧប នាយក រដ្ឋមន្ត្រី សុខ ចិន្តា សោភា រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ . ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ ព្រមទាំង ឥស្សរជន ជាន់ ខ្ពស់ កម្ពុជា ជាច្រើន រូប ទៀត ។
ឆ្លៀត ឱកាស ដ៏ មហោឡារឹក នេះ ឯក អគ្គ រដ្ឋទូត វៀតណាម សូម សំដែង នូវ ការដឹងគុណ ដ៏ ស្មោះសរ ជូន ចំពោះ ថ្នាក់ដឹកនាំ និង ប្រជាជន កម្ពុជា គ្រប់ ជំនាន់ ព្រមទាំង មិត្តភ័ក្ត អន្តរជាតិ ដែល បាន ផ្ដល់ នូវ ការគាំទ្រ និង កិច្ចសហប្រតិបត្តិការ ដ៏ ថ្លៃថ្លា ដល់ ប្រជាជន វៀតណាម ទាំងមូល ក្នុង បុព្វហេតុ នៃ ការតស៊ូ ដណ្តើម ឯករាជ ជាតិ កាលពី មុន ក៏ ដូចជា ក្នុង កិច្ចការ ក សាង អភិវឌ្ឍ ប្រទេសជាតិ នា ពេល បច្ចុប្បន្ន នេះ ។
នា ឱកាស នោះ ដែរ ឧប នាយក រដ្ឋមន្ត្រី សុខ ចិន្តា សោភា បាន អបអរសាទរ ចំពោះ សមិទ្ធផល ជាច្រើន ឥត គណនា ដែល បក្ស រដ្ឋ និង ប្រជាជន នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម សម្រេចបាន ក្នុង រយៈពេល ៧៨ ឆ្នាំ កន្លងមក នេះ គួរ ជា ទី មោទនៈ និង គួរឱ្យ ស្ញប់ស្ញែង យ៉ាង ក្រៃលែង ដែល បាន បង្ហាញ ក្តីសង្ឃឹម យ៉ាង មុតមាំ ថា ក្រោម ការដឹកនាំ របស់ គណបក្ស កម្មុយនីស្ត វៀតណាម នឹង បន្ត ទទួលបាន ជោគជ័យ យ៉ាង ត្រចះត្រចង់ បន្ថែម ទៀត ក្នុង ការអភិវឌ្ឍ ប្រទេស ប្រកបដោយ សុខ សន្តិភាព ស្ថិរភាព រឹងមាំ រៀង រហូត ទៅ ។
នៅក្នុង ឱកាស ចូលរួម កម្មវិធី នេះ ថ្នាក់ដឹកនាំ កម្ពុជា បាន ជួប ប្រាស្រ័យសន្ទនា ជាមួយ បណ្តា ឯក អគ្គ រាជ ទូត - រដ្ឋ ទូត និង បណ្តា អង្គការ ដៃគូ អន្តរជាតិ ជាច្រើន ក្នុង ការពង្រឹង ពង្រីក ចំណង មិត្តភាព សាមគ្គីភាព កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ ទាំង ស្ថាប័ន នីតិប្បញ្ញត្តិ និង នីតិប្រតិបត្តិ ឱ្យ កាន់តែ រឹងមាំ ថែម ទៀត ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៦២ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី៣០ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៦២ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ៣០ ខែសីហា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២៣ នេះ ។
