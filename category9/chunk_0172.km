( ស្វាយរៀង ) ៖ ដោយសារតែ ខឹង ប្រពន្ធ ផឹក ស៊ី រាល់ ថ្ងៃ មិន គិត កូន ចៅ បុរស ជនសង្ស័យ ជា ប្ដី បាន ទាញ ដំបង ឬ ស្សី វាយ ប្រពន្ធ បណ្ដាលឱ្យ ស្លាប់ ត្រូវបាន សមត្ថកិច្ច ធ្វើ ការឃាត់ខ្លួន ។
ហេតុការណ៍ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ៤និង ៣០នាទី ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ ស្ថិត នៅ ភូមិ គោក កណ្ដោល ឃុំ ក្រោល គោ ស្រុក ស្វាយ ជ្រំ ។
សមត្ថកិច្ច បាន ឲ្យដឹង ថា ជនសង្ស័យ មាន ឈ្មោះ នេត សុភ័ណ្ឌ អាយុ ៤២ ឆ្នាំ មុខរបរ កសិករ ត្រូវ ជា ប្ដី រស់ នៅ ភូមិ គោក កណ្ដោល ឃុំ ក្រោល គោ ស្រុក ស្វាយ ជ្រំ ។ ចំណែក ស្ត្រី រងគ្រោះ មាន ឈ្មោះ ង៉ែត សុបិន អាយុ ៥៩ ឆ្នាំ មុខរបរ កសិករ រស់ នៅ ភូមិ ឃុំ កើត ហេតុ ខាង លើ ។
អ្នកភូមិ បាន ឲ្យដឹង ថា នៅ មុនពេល កើត ហេតុ ជនរងគ្រោះ និង ប្តី បាន ឈ្លោះប្រកែកគ្នា យ៉ាង ខ្លាំង ខណៈ ប្ដី ស្ដី បន្ទោស រឿង គិត តែ ផឹក ស្រា រាល់ ថ្ងៃ រួច ក្រោយមក ស្រាប់តែ ឃើញ ស្ទុះ យក បាន ដំបង ឬ ស្សី មក វាយ ប្រពន្ធ ស្លាប់ ទើប បង្ក ការភ្ញាក់ផ្អើល ដល់ អ្នកភូមិ និង រាយការណ៍ មក សមត្ថកិច្ច តែម្ដង ។
បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន និង បាន បញ្ជូន មក ស្នងការ នគរបាល ខេត្ត ដើម្បី ចាត់ការ បន្ត តាម នីតិវិធី ចំណែក សព ជនរងគ្រោះ ត្រូវបាន បងប្អូន សាច់ញាតិ ចាត់ចែង ធ្វើ បុណ្យ តាម ប្រពៃណី ៕ ឧត្ដមសេនីយ៍ ត្រី បោន ប៊ិន នាំ ថវិកា នាយ ឧត្តមសេនីយ៍ សៅ សុខា ចូល បុណ្យ គ្រួសារ សព អតីត យោធិន នៃ កងរាជអាវុធហត្ថ ចូល សោធន និវត្តន៍ ២គ្រួសារ
( បន្ទាយមានជ័យ )៖ លោក ឧត្ដមសេនីយ៍ ត្រី បោន ប៊ិន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ និង សហការី នៅ ព្រឹក ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ បាន នាំយក ថវិកា ផ្ទាល់ខ្លួន របស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កង យោពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ប្រគល់ ជូន ដល់ គ្រួសារ សព ចំនួន ២គ្រួសារ ។
គ្រួសារ សពទ ទាំង នេះ រួម មាន ទី១៖ លោក វរសេនីយ៍ ត្រី នួម ឆៃរ៉ាត់ . និង ទី ២៖ នាយ ចំណង់ ប្លុង ម៉ៅ ( អតីត យោធិន នៃ កងរាជអាវុធហត្ថ ចូល សោធន និវត្តន៍ ) ក្នុង មួយ គ្រួសារ ទទួលបាន ថវិកា ៥លាន រៀល រួម នឹង ថវិកា ផ្ទាល់ខ្លួន របស់ លោក ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន ចំនួន ៥០ ម៉ឺន រៀល ផងដែរ ។
នា ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន ក៏ បាន ចូលរួម សម្តែង នូវ មរណៈ ទុក្ខ ដ៏ ក្រៀមក្រំ ចំពោះ ក្រុមគ្រួសារ សព លោក វរសេនីយ៍ ត្រី នួម ឆៃរ៉ាត់ និង លោក នាយ ចំណង់ ប្លុង ម៉ៅ ដែល បាន លាចាក ឆ្ងាយ ពី ក្រុមគ្រួសារ គ្មាន ថ្ងៃ វិលត្រឡប់ ចោល ប្រពន្ធ និង កូន បងប្អូន សាច់ញាតិ ទាំង ក្តី អាឡោះអាល័យ ជា ទីបំផុត ។
ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន បាន បន្ត ថា នាយ ឧត្តមសេនីយ៍ សៅ សុខា តែងតែ គិតគូរ ពី សុខ ទុក្ខ ជីវភាព របស់ មន្ត្រី អាវុធហត្ថ ក្រោម ឱវាទ ជាពិសេស បេី ទោះបីជា អាវុធហត្ថ សោធន និវត្តន៍ ដែល ទទួលមរណៈភាព ក៏ដោយ ក៏ នាយ ឧត្តមសេនីយ៍ សៅ សុខា នៅតែ យកចិត្តទុកដាក់ ជួយ ជា ថវិកា ផ្ទាល់ខ្លួន ចូលរួម បុណ្យ សព ផងដែរ ។
សូម បញ្ជាក់ ផងដែរ ថា លោក វរសេនីយ៍ ត្រី នួម ឆៃរ៉ាត់ បាន ទទួលមរណភាព កាលពី ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២២ . នាយ ចំណង ប្លុង ម៉ៅ បាន ទទួលមរណភាព នៅ ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២៣ ៕
ជំនួប ជាមួយ រដ្ឋមន្ត្រី ប៉េង ពោធិ៍នា . អូស្ត្រាលី បង្ហាញ គោលជំហរ បន្ត កិច្ចសហប្រត្តិបត្តិការ ក្នុង វិស័យ សាធារណការ និង ដឹកជញ្ជូន បន្ថែម ទៀត
( ភ្នំពេញ ) ៖ លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នា ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ បាន អនុញ្ញាតឱ្យ លោក Justin Whyatt ឯក អគ្គ រដ្ឋទូត អូស្ត្រាលី ប្រចាំ កម្ពុជា អម ដោយ សហការី ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ នៅ ទីស្តីការ ក្រសួង ដោយ មាន ការអញ្ជើញ ចូលរួម ផងដែរ ពីសំណាក់ លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ និង មន្ត្រី ពាក់ព័ន្ធ ។
លោក ឯក អគ្គ រដ្ឋទូត បាន បន្ថែម ថា ជាមួយនឹង ការរៀបចំ រាជ រដ្ឋាភិបាល សម្រាប់ នីតិកាល ថ្មី ភាគី អូស្ត្រាលី នៅតែ មាន គោលជំហរ បន្ត កិច្ចសហប្រត្តិបត្តិការ ល្អ ៗ ក្នុង វិស័យ សាធារណការ និង ដឹកជញ្ជូន បន្ថែម ទៀត ដោយ ផ្តោត សំខាន់ លើ ការបន្ត អភិវឌ្ឍ លើ ការងារ គ្រប់គ្រង ទឹក កខ្វក់ វិស័យ ភស្តុភារកម្ម និង ខ្សែ ច្រវាក់ ផ្គត់ផ្គង់ ត្រជាក់ (Cold Chain) ។
ការដាក់ចេញ អនុសាសន៍ ការងារ ធានា ប្រយោជន៍ ជូន កម្មករ និយោជិត នេះ ធ្វើឡើង ក្នុង ឱកាស ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បង្ហាញ មុខ ក្នុង វេទិកា សាធារណៈ លើក ដំបូង ក្រោយ បង្កើត រាជ រដ្ឋាភិបាល លើ វេទិកា សំណេះសំណាល ជាមួយ កម្មករ និយោជិត នៅ តំបន់ ព្រៃ ស្ពឺ ខណ្ឌ ពោធិ៍សែនជ័យ នា ព្រឹក ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ នេះ ។
ការងារ អាទិភាព ទាំង៦ ចំណុច ដែល ប្រមុខ រាជ រដ្ឋាភិបាល ដាក់ ជូន ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នេះ រួម មាន៖
១៖ ខិតខំ សម្របសម្រួល ការពិភាក្សា ប្រាក់ ឈ្នួល អប្បបរមា ឱ្យ បាន ល្អ ដោយ ឈរ លើ លក្ខខណ្ឌ វិទ្យាសាស្ត និង លក្ខខណ្ឌ វិនិច្ឆ័យ ដែល មាន ចែង ក្នុង ច្បាប់ ស្តីពី ប្រាក់ ឈ្នួល អប្បបរមា ឱ្យ បាន មុនពេល ឈប់ សម្រាក បុណ្យ ភ្ជុំ បិណ្ឌ ខាងមុខ នេះ ។
ជាមួយគ្នា នោះ ឯកឧត្តម បណ្ឌិត នាយក រដ្ឋមន្ត្រី ក៏ បាន ណែនាំ នូវ ផែនការ សកម្មភាព ក្នុង រយៈពេល ពីរ ឆ្នាំ ខាងមុខ ទៀត ដែល ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ត្រូវ អនុវត្តន៍ រួម មាន៖
៤៖ ជំរុញ កម្មវិធី ធ្វើតេស្ត ទទួលស្គាល់ ជំនាញ ដែល ជា ឱកាស សម្រាប់ កម្មករ និយោជិត ទាំង ក្នុង និង ក្រៅ ប្រទេស អាច មាន វិញ្ញាបនបត្រ ទទួលស្គាល់ ជំនាញ មួយ ដើម្បី បង្ហាញ ពី សមត្ថភាព និង កម្រិត ជំនាញ របស់ ខ្លួន ៕
រដ្ឋមន្រ្តី ការបរទេស អង់គ្លេស នឹង បំពេញ ទស្សនកិច្ច ទៅកាន់ ប្រទេស ចិន នា ថ្ងៃពុធ សប្តាហ៍ នេះ
ប្រធាន ក្រុមប្រឹក្សា អឺរ៉ុប៖ EU ចាំបាច់ ត្រូវ ត្រៀមខ្លួន ឱ្យ រួចរាល់ នៅ ត្រឹម ឆ្នាំ ២០៣០ សម្រាប់ ការទទួលយក សមាជិក ថ្មី
ថ្លែង ក្នុង វេទិកា មួយ នៅឯ ប្រទេស ស្លូវេនី លោក មី ឈែល បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « បើ តាម ការជឿជាក់ របស់ ខ្ញុំ ផ្ទាល់ គឺ ពួកយើង ត្រូវតែ ត្រៀមខ្លួន ឱ្យ បាន រួចរាល់ នៅ ត្រឹម ឆ្នាំ ២០៣០ ដើម្បី ពង្រីក សមាជិក បន្ថែម ។ គោលដៅ នេះ គឺជា មហិច្ឆតា ធំ មួយ ប៉ុន្តែ វា ជា រឿង ដែល ចាំបាច់ ។ វា បង្ហាញ ឱ្យ ឃើញ ថា ពួកយើង មាន ភាពប្រាកដប្រជា ច្បាស់លាស់ » ។
បច្ចុប្បន្ន ប្រទេស នៅ តំបន់ បាល់ កង់ ខាងលិច ចំនួន ៦ រួម មាន អាល់ បានី បូស្នី កូសូវ៉ូ ម៉ុង តេណេហ្គ្រោ ម៉ាសេដ្វាន ខាងជើង និង ស៊ែប៊ី គឺ កំពុង ស្ថិត នៅ ដំណាក់កាល ខុស ៗ គ្នា នៃ ដំណើរការ ចូល ជា សមាជិក របស់ សហភាព អឺរ៉ុប ។ កាលពី ឆ្នាំ ២០២២ ម៉ុល ដាវី និង អ៊ុយក្រែន ក៏ ទទួលបាន នូវ ឋានៈ ជា បេក្ខភាព សមាជិក EU ផងដែរ ខណៈ ហ៊្សក ហ្ស៉ី កំពុង រង់ចាំ ទទួលបាន ឋានៈ នោះ ដូចគ្នា ។
លោក មី ឈែល បាន និយាយ ថា ដើម្បី អាច ចូល ជា សមាជិក EU បណ្តា អនាគត រដ្ឋ ជា សមាជិក ត្រូវតែ អនុវត្ត ការធ្វើ កំណែទម្រង់ ផ្សេង ៗ ដើម្បី ធានា នូវ ប្រព័ន្ធ យុត្តិធម៌ ដែល មាន ឯករាជ្យ ប្រយុទ្ធ ប្រឆាំង ឧក្រិដ្ឋកម្ម និង អំពើពុករលួយ ជា ប្រព័ន្ធ ហើយ តម្រែ តម្រង់ គោល នយោបាយ ការបរទេស របស់ ពួកគេ ឱ្យ ស្រប គ្នា ជាមួយ បណ្តា រដ្ឋ ជា សមាជិក របស់ EU ។ ជាមួយគ្នា នេះ លោក ក៏ បាន ទទូច ឱ្យ ប្រទេស ដែល ចង់ ក្លាយជា សមាជិក ដោះស្រាយ ឱ្យ ដាច់ស្រេច នូវ ជម្លោះ ទ្វេ ភាគី ទាំងឡាយ មុន ចូលរួម ក្នុង EU ផងដែរ ។
គួរ បញ្ជាក់ ថា សព្វ ថ្ងៃ សហភាព អឺរ៉ុប មាន រដ្ឋ សមាជិក ចំនួន ២៧ រួម មាន អូទ្រី ស បែល ហ្ស៉ិក ប៊ុល ហ្ការី ក្រូ អាស៉ី ស៉ីប សាធារណរដ្ឋ ឆែក ដាណឺម៉ាក អេស្តូនី ហ្វាំងឡង់ បារាំង អាល្លឺម៉ង់ ក្រិក ហុង គ្រី អៀរឡង់ អ៉ីតាលី ឡេតូនី លីទុយ អានី លុច សំបួ ម៉ាល់ត៍ ហូឡង់ ប៉ូឡូញ ព័រទុយហ្កាល់ រ៉ូម៉ានី ស្លូវ៉ាគី ស្លូវេនី អេស៉្បាញ និង ស៊ុយអែត ៕ ក្រសួង សង្គមកិច្ច បន្ត បើក កិច្ចប្រជុំ ពី នីតិវិធី ប្រតិបត្តិ បទដ្ឋាន ក្នុង ការកំណត់ អត្តសញ្ញាណ និង ការធ្វើ មាតុភូមិ និវត្តន៍ ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស
( ភ្នំពេញ ) ៖ ក្រុមការងារ បច្ចេកទេស ដឹកនាំ ដោយ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន បើក កិច្ចប្រជុំ បច្ចេកទេស ស្តីពី ការធ្វើ បច្ចុប្បន្នភាព លើ កិច្ចព្រមព្រៀង សហប្រតិបត្តិការ រវាង រដ្ឋាភិបាល កម្ពុជា និង រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ពី នីតិវិធី ប្រតិបត្តិ បទដ្ឋាន ក្នុង ការកំណត់ អត្តសញ្ញាណ និង ការធ្វើ មាតុភូមិ និវត្តន៍ ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស ។
ក្នុង បរិបទ នេះ លោកសង្ឃឹម យ៉ាង មុតមាំ ថា ការចូលរួម ក្រុមការងារ បច្ចេកទេស ( អ្នក អនុវត្ត ជាក់ស្តែង ) របស់ លោក លោកស្រី និង ធ្វើឱ្យ សិក្ខាមួយ នេះ មាន អត្ថន័យ ក្នុង ចូលរួម មតិ យោបល់ ធាតុ ចូល ផ្សេង ៗ ដើម្បី ជា ប្រយោជន៍ ដល់ ជនរង់ គ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស និង រំលោភបំពាន ផ្លូវភេទ ពិសេស ស្រ្តី និង កុមារ រងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស និង កេងប្រវ័ញ្ច ផ្លូវភេទ នៅ កម្ពុជា ឬ នៅ ប្រទេស គោលដៅ ណាមួយ ។
ទន្ទឹមនឹង នេះ ដែរ លោក ក៏ សូម អំពាវនាវ ដល់ អង្គការ ដៃគូ អភិវឌ្ឍន៍ ទាំងអស់ មេត្តា ជួយ គាំទ្រ និង មាន កិច្ចសហការបន្ត ជាមួយ ក្រសួង សង្គមកិច្ច ឱ្យ បាន ច្រើន ជាង នេះ ដើម្បី រួមគ្នា ការពារ និង ទប់ស្កាត់ ជនរងគ្រោះ អំពើ ជួញដូរ មនុស្សនា ពេល អនាគត់ ។
ជាមួយគ្នា នេះ លោកសង្ឃឹម យ៉ាង មុតមាំ ថា ឯកសារ នេះ នឹង ក្លាយជាពិសេស មធ្យោបាយ សម្រាប់ ការអនុវត្ត ការងារ ជាក់ស្ដែង ប្រកបដោយ ប្រសិទ្ធិភាព ខ្ពស់ និង ជា ជំនួយ ស្មារតី ដល់ អ្នក ផ្តល់ សេវា ថែទាំ ជនរងគ្រោះ ការកំណត់ អត្តសញ្ញាណ បឋម ការផ្តល់ សេវា និង ការសម្របសម្រួល ក្នុង ការធ្វើ មាតុភូមិ និវត្ត ជនរងគ្រោះ នៃ ជនជាតិ ទាំង ពីរ គឺ កម្ពុជា និង វៀតណាម ៕ នាយ ឧត្តមសេនីយ៍ ស ថេត ណែនាំង កងកម្លាំង នគរបាល ទាំងអស់ ត្រូវ ខិតខំ បំពេញ ការងារ លើក មុខមាត់ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ បាន ណែនាំ ទៅ ថ្នាក់ដឹកនាំ និង កងកម្លាំង នគរបាល ទាំងអស់ ត្រូវ កែសម្រួល អត្តចរិក និង ខិតខំ បំពេញ ភារកិច្ចការងារ ឲ្យបាន ល្អ ប្រសើរ ដើម្បី លើក មុត មាត់ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី និង មាន ទំនុកចិត្ត ពី ប្រជាពលរដ្ឋ ។
ក្នុង ឱកាស ប្រកាស តែងតាំង មុខ តំណែង អគ្គ ស្នងការរង គរបាល ជាតិ និង ប្រគល់ ភារកិច្ច ជា ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ នេះ នាយ ឧត្តមសេនីយ៍ ស ថេត បាន បញ្ជាក់ ថា មន្ត្រី នគរបាល ទាំងអស់ ត្រូវ ចងចាំ ថា ការទទួលបាន នូវ ភារកិច្ច តួនាទី របស់ ខ្លួន សុទ្ធសឹងតែ ជា ការទុកចិត្ត ពីសំណាក់ ថ្នាក់ដឹកនាំ ពី ជំនាន មុន រហូតដល់ បច្ចុប្បន្ន ដូចនេះ ត្រូវ បំពេញ ភារកិច្ច ឲ្យបាន ត្រឹមត្រូវ ។
អគ្គ ស្នងការ នគរបាល ជាតិ រូប នេះ បាន បន្ត ថា ការបំពេញ ភារកិច្ច នេះ ត្រូវ ធ្វើ ទៅ តាម ច្បាប់ មិន ត្រូវ ធ្វើ អ្វី ដែល ខុស ដើម្បី ផលប្រយោជន៍ ខ្លួន ប៉ះពាល់ ប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ និង ធ្វើឲ្យ អាប អោន ដល់ កិត្តិយស របស់ ថ្នាក់ដឹកនាំ នៅក្នុង អាណត្តិ ថ្មី នឹង ធ្វើឲ្យ មាន ការរិះគន់ ពី មហាជន ។
លោក បន្ថែម ថា ចំពោះ ការបម្រើ សេវា ជូន ប្រជាពលរដ្ឋ គឺ នៅ តាម ប៉ុស្តិ៍ នគរបាល នីមួយ ៗ ត្រូវ មាន កម្លាំង នៅ ប្រចាំ ការ មិន មែន ពេល មាន ពលរដ្ឋ ទៅ ដាក់ពាក្យបណ្ដឹង គ្មាន អ្នក ចាំ ទទួលបណ្ដឹង ធ្វើឲ្យ ពួកគេ ពិបាក ក្នុង ការសុំ អន្តរាគមន៍ ពី សមត្ថកិច្ច នៅពេល មាន កើត ហេតុ ណាមួយ ។ មួយ វិញទៀត ប្រព័ន្ធ Hot Line ត្រូវ មាន អ្នកប្រចាំ ការ ២៤ ម៉ោង លើ ២៤ ដើម្បី លើក ទូរស័ព្ទ ឆ្លើយតប ការសុំ អន្តរាគមន៍ ពី ប្រជាពលរដ្ឋ ។
នាយ ឧត្តមសេនីយ៍ ស ថេត បាន បន្ដ ទៀត ថា កម្លាំង នគរបាល នៅ គ្រប់ រាជធានី ខេត្ត ត្រូវ ខិតខំ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស នានា ដែល កើតឡើង នៅ តាម មូលដ្ឋាន ដូចជា បញ្ហា ចោរកម្ម ក្មេង ទំនើង និង បញ្ហា គ្រឿងញៀន ជាដើម ដើម្បី កុំ ឲ្យ មាន ការព្រួយបារម្ភ ដល់ ប្រជាពលរដ្ឋ ហើយ កុំ ឲ្យ បទល្មើស ទាំងអស់ នោះ ក្លាយជា ជំងឺ រ៉ាំរ៉ៃ ។
ជាមួយគ្នា នេះ លោក ក៏ បាន ជំរុញ ដល់ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ដែល ទើប ទទួល តំណែង ជា អគ្គ ស្នងការ រង និង ជា ស្នងការ រាជធានី ភ្នំពេញ ត្រូវតែ ខិតខំ ថែរក្សា សុខ សុវត្ថិភាព ក្នុង រាជធានី ភ្នំពេញ ដែល ជា គោលដៅ ស្នូល ក្នុង ការការពារ ព្រោះ មាន បណ្ដុំ ដោយ ថ្នាក់ដឹកនាំ ជាតិ កំពូល ៗ បណ្ដា អង្គ ទូត និង ស្ថាប័ន អង្គការ អន្តរជាតិ ធំ ៗ ជាច្រើន ។
ដើម្បី តបស្នង សង គុណ ចំពោះ ថ្នាក់ដឹកនាំ គ្រប់ ថ្នាក់ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល រាជធានី ភ្នំពេញ សូម ធ្វើ ការប្ដេជ្ញាចិត្ត ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ចំពោះ តួនាទី របស់ លោក ដូច ខាងក្រោម៖
* ទី២៖ ការពារ ដាច់ខាត រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល ប្រសូត ចេញ ពី ឆន្ទៈ រាស្ត្រ និង ចូលរួម អនុវត្ត ឲ្យ បាន សម្រេច ជោគជ័យ នូវ គ្រប់ កម្មវិធី នយោបាយ យុទ្ធសាស្ត្រ បញ្ចកោណ គ្រប់ ដំណាក់កាល របស់ រាជ រដ្ឋាភិបាល ជាពិសេស រក្សា ការពារ ឲ្យបាន ស្ថិតស្ថេរ គង់វង្ស នូវ សុខ សន្តិភាព ស្ថិរភាព នយោបាយ និង សមិទ្ធផល នានា ដែល រាជ រដ្ឋាភិបាល ខិតខំ កសាង តាំងពី បាត ដៃ ទទេ រ រហូតមក ទល់ បច្ចុប្បន្ន និង ទៅ ថ្ងៃ អនាគត
* ទី ៣៖ គោរព និង អនុវត្ត យ៉ាង ម៉ឺងម៉ាត់ តាម ច្បាប់ បទបញ្ញត្តិ បទបញ្ជា និង គោលការណ៍ នានា របស់ ថ្នាក់ ដឹកនាំ គ្រប់ ថ្នាក់ ជាពិសេស បទបញ្ជា ០០៦ របស់ កងកម្លាំង នគរបាល ជាតិ
* ទី៤៖ ដឹកនាំ មន្ត្រី ក្រោម ឱវាទ ប្រកបដោយ គុណធម៌ បង្កើន ចំណង សាមគ្គីភាព ផ្ទៃក្នុង ឲ្យបាន រឹងមាំ រួម សុខ រួម ទុក្ខ ជាមួយ មន្ត្រី គ្រប់ កាលៈទេសៈ ។ ទន្ទឹម នោះ ខិតខំ លើកកម្ពស់ គុណភាព មន្រ្តី ទាំង សមត្ថភាព ជំនាញ វិន័យ សីលធម៌ វិជ្ជាជីវៈ សេចក្ដីថ្លៃថ្នូរ សំដៅ លើកស្ទួយ កិត្តិយស និង កិត្យានុភាព របស់ កងកម្លាំង នគរបាល ជាតិ
* ទី៥៖ តម្កល់ ផលប្រយោជន៍ អង្គភាព ខ្ពស់ ដោយ ខិតខំ បន្ត កសាង សមិទ្ធផល នានា ចំណុះ ស្នងការដ្ឋាន ឲ្យ ស័ក្តិសម ជា បង្អែក ផ្នែក សន្តិសុខ យ៉ាង រឹងមាំ សម្រាប់ ប្រជាពលរដ្ឋ គ្រប់ រូប
* ទី៦៖ បង្កើន កិច្ចសហការ ជិតស្និទ្ធ ជាមួយ មន្ទីរ អង្គភាព ពាក់ព័ន្ធ នានា ក៏ ដូចជា បណ្តា ខេត្ត ជាប់ ព្រំប្រទល់ ដើម្បី ការពារ ធានា រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ និង សុវត្ថិភាព សង្គម
* ទី៧ លើកកម្ពស់ ការងារ អនុវត្ត គោល នយោបាយ « ភូមិ ឃុំ - សង្កាត់ មាន សុវត្ថិភាព » ដោយ ខិតខំ ជំរុញ ការផ្តល់ សេវា តម្រូវ ការចាំបាច់ សេវា ផ្នែក សន្តិសុខ ទាំង ផ្លូវកាយ និង ផ្លូវចិត្ត ជូន ប្រជាពលរដ្ឋ ដោយ ភក្តីភាព និង មាន តម្លាភាព សំដៅ បង្កើន ភាព កក់ក្តៅ និង ជំនឿ ជឿជាក់ របស់ ប្រជាពលរដ្ឋ មក លើ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ៕ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា កោះអញ្ជើញ ម្ចាស់ ក្រុមហ៊ុន មួយ ទៀត ឱ្យ ចូលមក បំពេញ កាតព្វកិច្ច ពន្ធ អាករ និង ពិន័យ
រដ្ឋមន្ត្រី ក្រសួង អប់រំ បំពាក់ គ្រឿង ឥស្សរិយយស ការងារ ជូន បុគ្គលិក ក្រោម ឱវាទ មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ពោធិ៍សាត់ ចំនួន ៧៧៣ នាក់
លោក បណ្ឌិត សផាចារ្យ ហង់ ជួន ណារ៉ុន បាន លើកឡើង ទៀត ថា ការបង្កើន គុណភាព ធនធាន មនុស្ស អាច ជួយ អភិវឌ្ឍន៍ ប្រទេស កម្ពុជា ឲ្យ សម្រច បាន តាម គោលដៅ ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ គឺ យុទ្ធសាស្ត្រ បញ្ចកោណ - ដំណាក់កាល ទី១ ។ ដើម្បី សម្រេច គោលដៅ នេះ បាន លុះត្រាតែ មាន ការចូលរួម គាំទ្រ ពី មហាជន រួមទាំង ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ ថ្នា្កក់ ជាពិសេស ជាមួយ ដៃគូរ អភិវឌ្ឍន៍ លោកគ្រូ អ្នកគ្រូ ផ្ទាល់ តែម្តង ។
លោក បណ្ឌិត សភាចារ្យ បាន អំពាវនាវ ដល់ លោកគ្រូ អ្នកគ្រូ និង បុគ្គលិក ក្រោម ឱវាទ មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ពោធិ៍សាត់ បន្ត សកម្មភាព នេះ ឲ្យ កាន់តែ ទូលំទូលាយ ប្រយោជន៍ បង្កើន បាន ធនធាន មនុស្ស និង តម្រូវ ទីផ្សារ ពលកម្ម ទាំង ក្នុង និង ក្រៅ ប្រទេស កាន់តែ សម្បូរបែប និង ជឿនលឿន ។ ក្នុង ខណៈ នោះ ដែរ លោក បណ្ឌិត សភាចារ្យ បាន សម្តែង ការអបអរសាទរ លទ្ធផល នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា ដែល ទទួលបាន ចំណាត់ថ្នាក់ លេខ ១ ទូទាំង ប្រទេស គឺជា មោទនៈ ភាព នៃ ខេត្ត ពោធិ៍សាត់ ។
ការរំលឹក ដំបូល ន្មាន បែប នេះ របស់ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង ក្នុង ឱកាស ដែល ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត បាន អញ្ជើញ ចុះ ជួប កម្មករ ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដែល ជា វេទិកា សារធារណៈ លើក ដំបូង ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី នៅ ព្រឹក ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ នេះ ។
នា ឱកាស នោះ ដែរ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ឥទ្ធិពល កើត ចេញពី ការជឿទុកចិត្ត របស់ ប្រជាពលរដ្ឋ ពី ភាពកក់ក្តៅ របស់ គាត់ មិន មែន ដោយសារ យើង ដាក់ ខ្លួន ជា គម្លាត តែ ត្រូវ ដាក់ ខ្លួន ឱ្យ ជាប់ ជាមួយ ប្រជាពលរដ្ឋ ។
ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន រំលឹក យ៉ាង ដូច្នេះ ថា៖ « ហើយ កិច្ចការងារ នេះ ឪ ខ្ញុំ បង្រៀន ប្រាប់ ខ្ញុំ តាំងពី ក្មេង គាត់ ប្រាប់ ថា កូន ឯង ហាម ដាច់ខាត កុំ ឱ្យ គិត ថា ខ្លួន ជា កូន នាយក រដ្ឋមន្ត្រី តែ ត្រូវ ប្រកាន់ខ្លួន ថា ជា ចៅ របស់ កសិករ ជាប្រចាំ ព្រោះ តា យាយ កូន ឯង ជា កសិករ ទេ កុំ ភ្លេច កំណើត ត្រូវ នៅជាប់ ជាមួយ ប្រជាពលរដ្ឋ » ។
ជាមួយនឹង តួនាទី ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា សម្រាប់ អាណត្តិ ទី៧ នេះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា ការងារ បម្រើ ប្រជាពលរដ្ឋ គឺជា រង្វាន់ សម្រាប់ ខ្លួន ឯង ពិត ណាស់ ច្រើន ពិត ណាស់ វា ធ្ងន់ តែ ជា រង្វាន់ នៅក្នុង ជីវិត របស់ ឯកឧត្តម ដែល មាន ឱកាស បាន ទទួល ការទុកចិត្ត ពី ប្រជាពលរដ្ឋ និង គណបក្ស ដើម្បីឱ្យ ដឹង នាំ រាជ រដ្ឋាភិបាល ដើម្បី បម្រើ ប្រជាពលរដ្ឋ បន្ត ទៅ ទៀត ។
ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា មាន អំណាច មិន ប្រាកដ ថា មាន ឥទ្ធិពល នោះ ទេ ។ ដូចជា របប ខ្មែរ ក្រហម មាន អំណាច តែ គ្មាន ឥទ្ធិពល នោះ ទេ ។ ឥទ្ធិពល គឺ បាន មកពី ប្រជាពលរដ្ឋ ៕
ពាក្យ នេះ ត្រូវបាន ឯកឧត្តម លើកឡើង កន្លងមក ប៉ុន្តែ ជា ពាក្យស្លោក របស់ អតីត នាយក រដ្ឋមន្រ្តី ក្នុង សម័យ សង្គ្រាម លោក លើក ទី២ គឺ លោក វីន ស្តុន ឆឺ ឈីល តែ ប៉ុណ្ណោះ ។
ចំណុច នេះ ដែល ឯកឧត្តម ធ្លាប់ បាន និយាយ កន្លងទៅ គឺ ឯកឧត្តម បណ្ឌិត មិន បាន ហៅ នរណា ម្នាក់ ជា « សត្វ ឆ្កែ » នោះ ទេ គឺ និយាយ តាម ពាក្យ របស់ អតីត នាយក រដ្ឋមន្រ្តី អង់គ្លេស ប៉ុណ្ណោះ ។
ឯកឧត្តម លើកឡើង ថា៖ « រាល់ ការវាយប្រហារ មក លើ ខ្ញុំ ខ្ញុំ មិន ចាំបាច់ ត្រូវ ឆ្លើយតប គ្រប់ ពេល តេ ខ្ញុំ ត្រូវ ផ្តោត អារម្មណ៍ ដើរ ឱ្យ ដល់ គោលដៅ គោលដៅ របស់ ខ្ញុំ ត្រូវ បម្រើ ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ឱ្យ ប្រជាពលរដ្ឋ នៅតែ បន្ត ជឿ ទុកចិត្ត ទៅ លើ គណបក្ស ប្រជាជន កម្ពុជា ហើយ ឆ្នាំ ២០២៧ - ២០២៨ នឹង បោះឆ្នោត ឱ្យ គណបក្ស ប្រជាជន កម្ពុជា ដឹកនាំ បន្ត ទៀត » ។
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ បាន ចេញ សេចក្តីប្រកាស មួយ នៅ ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ នេះ ដោយ ពន្យល់ សាធារណជន ឱ្យ បាន ជ្រាប ច្បាស់ ចំពោះ អនុសាសន៍ របស់ លោក អភិសន្តិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ពាក់ព័ន្ធ នឹង « ការសិក្សា ធ្វើ ប័ណ្ណ បើកបរ ទោចក្រយានយន្ត ( ម៉ូតូ ) ដែល មាន កម្លាំង ចាប់ពី «60CC» ។
ចេតនា នៃ ប្រសាសន៍ នេះ គឺ ដើម្បី ចូលរួម ទប់ស្កាត់ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង បច្ចុប្បន្ន និង អនាគត ដែល លោក បាន លើកឡើង នា ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ ក្នុង ពិធី ប្រកាស ចូលកាន់ តំណែង និង បំពាក់ ឋានន្តរស័ក្តិ នាយ ឧត្ដមសេនីយ៍ ជូន អគ្គ ស្នងការ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ ទីស្តីការ ក្រសួង មហាផ្ទៃ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ បាន លើកឡើង ថា ការដកស្រង់ ពុំ បាន ពេញលេញ ស៊ីជម្រៅ និង ផ្សព្វផ្សាយ អនុសាសន៍ របស់ អភិសន្តិ បណ្ឌិត បាន ធ្វើឱ្យ មតិ សាធារណៈ មាន ការយល់ ច្រឡំ និង សម្ដែង ទស្សនៈ ផ្សេង ៗ ។
ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត ណែនាំ រដ្ឋមន្ត្រី វប្បធម៌ ឱ្យ បង្កើន អ្នកប្រវត្តិសាស្ត្រ ហើយ សរសេរ សៀវភៅ ប្រវត្តិសាស្ត្រ ខ្មែរ ដោយ ជនជាតិ ខ្មែរ (Video inside) ( ភ្នំពេញ ) ៖ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ណែនាំ ដល់ លោកស្រី បណ្ឌិត សភាចារ្យ ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ឱ្យ បង្កើន អ្នកស្រាវជ្រាវ ប្រវត្តិសាស្ត្រ ហើយ សរសេរ សៀវភៅ ប្រវត្តិសាស្ត្រ ខ្មែរ ដោយ ជនជាតិ ខ្មែរ ។
ថ្លែង នៅ ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ ពេល អញ្ជើញ ជួប កម្មករ ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ រាជធានី ភ្នំពេញ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បង្ហើប ថា រឿង សរសេរ ប្រវត្តិសាស្ត្រ ខ្មែរ និង តាម បែប ទ ខ្មែរ នេះ ត្រូវបាន លោក ពិភាក្សា ជាមួយ លោកស្រី រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ រួចហើយ ។
បើ តាម ការថ្លែង របស់ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត កន្លងមក អ្នក សរសេរ ប្រវត្តិសាស្ត្រ ខ្មែរ ជា ជនជាតិ ខ្មែរ មិន សូវ មាន ទេ ។ ហេតុ នេះ ហើយ ឯកឧត្តម បណ្ឌិត ជំរុញ ឲ្យ បង្កើន ក្រុម ស្រាវជ្រាវ ប្រវត្តិសាស្ត្រ ផ្ទៀងផ្ទាត់ មើល ថា តើ ប្រវត្តិសាស្ត្រ ត្រូវបាន សរសេរ កន្លងមក ស្រប នឹង អ្វី ដែល ជា របស់ ខ្មែរ ឬ ទេ ។
ការថ្លែង បែប នេះ របស់ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង ក្នុង ឱកាស ដែល ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត បាន អញ្ជើញ ចុះ ជួប កម្មករ ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដែល ជា វេទិកា សារធារណៈ លើក ដំបូង ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី នៅ ព្រឹក ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ នេះ ។
ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បន្ត ថា ថ្នាក់ដឹកនាំ រាជ រដ្ឋាភិបាល បាន ប្តេជ្ញា ប្រឹងប្រែង រក្សា សមិទ្ធផល ដែល អ្នក ចាស់ បន្សល់ទុក ហើយ បន្ត ប្រឹងប្រែង បង្កើត សមិទ្ធផល ថ្មី ជា បន្តបន្ទាប់ ទៀត ។
ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា គឺ នៅ បន្ត លើ គោលដៅ ២ គោលដៅ ទី១ ថែរក្សា ឱ្យ បាន ដាច់ខាត នូវ សមិទ្ធផល ដែល គណបក្ស ប្រជាជន កម្ពុជា ដឹកនាំ ប្រទេស សម្រេចបាន ក្នុង ៤៤ ឆ្នាំ មក នេះ ដែល រួម មាន កត្តា សំខាន់ បំផុត ការថែរក្សា សុខ សន្តិភាព ស្ថិរភាព និង ជំរុញ ការអភិវឌ្ឍ ជូន ប្រជាពលរដ្ឋ និង ការឯកភាព ជាតិ ទឹកដី ត្រូវ ដាច់ខាត ត្រូវតែ រក្សា ឱ្យ បាន » ។
ជាមួយគ្នា នេះ ដែរ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា សន្តិភាព វា សំខាន់ ៤០ ឆ្នាំ មុន សន្តិភាព សំខាន់ ២០ ឆ្នាំ មុន សន្តិភាព ក៏ នៅ សំខាន់ ថ្ងៃ នេះ សន្តិភាព ក៏ នៅ សំខាន់ ១០០ ឆ្នាំ បន្ត ទៅ ទៀត សម្រាប់ កម្ពុជា ។ ត្រង់ ចំណុនេះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ចោទ ជា សំណួរ ថា « ពេលណា យើង បាត់ សន្តិភាព កុំ និយាយ ថា បង្កើត ការងារ នោះ ស្ថិរភាព វា ត្រូវតែ សំខាន់ អ៊ឹចឹង យើង ត្រូវតែ ថែរក្សា ឱ្យ បាន » ។
ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា នៅ មុនពេល បោះឆ្នោត បែប ណា នៅ ក្រោយពេល បោះឆ្នោត គឺ អនុវត្តន៍ បែប នោះ មិន មាន ប្រែប្រួល នោះ ឡើយ ។ ប៉ុន្តែ គ្រាន់ ពង្រីក បន្ថែម ស្រប តាម គោល នយោបាយ ដែល មាន ពីមុន ហើយ គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន សន្យា ជាមួយ ប្រជាពលរដ្ឋ ពេល មុន បោះឆ្នោត គឺ ត្រូវ ចេញ ជា ផែនការ សកម្មភាព ដើម្បី អនុវត្តន៍ ហើយ គោល នយោន បាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា មិន មែន សន្យា ខ្យល់ នោះ ទេ ។
« យើង សន្យា គោល នយោបាយ បែប ណា ក្រោយ បោះឆ្នោត យើង ត្រូវ ដាក់ ចេញ គោល នយោបាយ បែប នោះ ហើយ គោល នយោបាយ ដែល រាជ រដ្ឋាភិបាល ដាក់ ចេញ គឺ គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន អនុម័ត ដោយ អង្គ សន្និបាត គឺ ដើម្បី បន្ត និរន្តរភាព របស់ យើង គោល នយោបាយ របស់ គណ ប្រជាជន កម្ពុជា មិន មែន កសាង ឆក់ កណ្តៀត ឬ ដោយ អារម្មណ៍ នោះ ទេ » ។ នេះ ជា ការលើកឡើង បន្ថែម របស់ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត ។
បន្ថែម ពី នេះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា មិន មែន ធ្វើឡើង តាម ការ នឹកឃើញ ដោយ បុគ្គល ម្នាក់ ឬ ២នាក់ វិភាគ ឬ ឃើញ នោះ ទេ គឺ ធ្វើឡើង ដោយ ក្រុម អ្នកជំនាញ មាន បទពិសោធន៍ មាន ការសិក្សា ច្បាស់លាស់ ៕
បើ តាម ការថ្លែង របស់ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត UN បាន ទទួលស្គាល់ ឯកឧត្តម រួចហើយ ទើប គេ អញ្ជើញ ឯកឧត្តម ទៅ ថ្លែង សុន្ទរកថា នៅ ថ្ងៃទី ២២ ខាងមុខ នេះ ។ ហេតុ នេះ ហើយ បានជា ឯកឧត្តម លើកឡើង ថា ផែនការ នៃ ការធ្វើ បាតុកម្ម របស់ អ្នកប្រឆាំង ត្រូវបាន បរាជ័យ រួច ជាស្រេច ទៅ ហើយ ។
ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត ថ្លែង បែប នេះ ពេល អញ្ជើញ ជួប កម្មករ ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ រាជធានី ភ្នំពេញ ដែល ជា វេទិកា សារធារណៈ លើក ដំបូង ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី ។
ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ថ្លែង ទៀត ថា អ្នក ចង់ ធ្វើ បាតុកម្ម ប្រឆាំង ឯកឧត្តម នោះ គឺ ឯកឧត្តម មិន ជំទាស់ ទេ ព្រោះ ជា សិទ្ធិ របស់ ពួកគាត់ ប៉ុន្តែ ឯកឧត្តម ស្នើ ធ្វើ អ្វី សូម គោរព ច្បាប់ អាមេរិក ផង ប្រយ័ត្ន ល្មើស ច្បាប់ ។
ការនាំយក នូវ ពាក្យពេចន៍ ផ្តាំផ្ញើ របស់ សម្តេច តេជោ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត អញ្ជើញ ចុះ ជួប កម្មករ ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដែល ជា វេទិកា សារធារណៈ លើក ដំបូង ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី នា ព្រឹក ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ ។
ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ សូម ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន ដែល លោក បាន ដឹកនាំ ប្រទេស ក្នុង រយៈពេល ជាង ៣ទស្សវ ត្ស៍រ ក សាង ប្រទេស តាំងពី បាត់ ដៃ ទទេ រ បែកបាក់ រហូតដល់ មាន សុខ សន្ដិភាព ស្ថេរភាព និង ការអភិវឌ្ឍន៍ » ។
ទន្ទឹម គ្នា នេះ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា លទ្ធផល ដែល បងប្អូន កម្មករ - កម្ម ការិនី អង្គុយ នៅ ទីនេះ ១ម៉ឺន ៨ ពាន់ នាក់ មាន អាជីព ច្បាស់លាស់ មាន ការថែទាំ មាន បៀវត្សន៍ ហើយ អ្នក ជាច្រើន ដែល រំពឹង លើ បងប្អូន ដូចជា កូន ដូចជា ឪពុក ម្ដាយ ដែល យើង អាច ជួយ បន្ទុក ក៏ ជា លទ្ធផល ការងារ ដែល សម្ដេច តេជោ និង ថ្នាក់ដឹកនាំ រាជ រដ្ឋាភិបាល អាណត្ដិ មុន ៗ បាន ដឹកនាំ ។
ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ក៏ បាន សម្ដែង នូវ ការដឹង គុណ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការដឹកនាំ ប្រទេស មកដល់ ពេលនេះ និង សូម អរគុណ ដល់ ថ្នាក់ដឹកនាំ ក្រសួង ការងារ ដែល បាន ដឹកនាំ នា ពេល កន្លងមក ផងដែរ ។
ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា សម ទ្ធិផល ដែល បាន ថ្ងៃ នេះ មិន មែន កើត មក មួយ ថ្ងៃ នោះ ទេ សម ទ្ធិផល ដែល បាន មក នេះ គឺ បាន បន្ដ បន្ទាប់ ជាង ៤០ ឆ្នាំ មុន មក ម្ល៉េះ ដែល វា ផ្ដើម ចេញ ពី ការបែកបាក់ គ្នា ពី ការបញ្ចប់ សង្គ្រាម មួយ ដែល លំបាក ពី ការរំដោះ ប្រជាពលរដ្ឋ ពីរ ណ្ដៅជ្រោះ មរណៈ ។
ការប្រកាស ជាថ្មី អំពី គោល នយោបាយ អាទិភាព ទាំង ៦ នេះ ធ្វើឡើង ក្នុង ឱកាស ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត អញ្ជើញ ចុះ ជួប កម្មករ ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដែល ជា វេទិកា សារធារណៈ លើក ដំបូង ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី ។
ឯកឧត្តម បណ្ឌិត បាន ថ្លែង ពី គោល នយោបាយ ទាំង៦ រួម មាន៖
២៖ ការបណ្តុះបណ្តាល ជំនាញ ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ ដែល មាន គោលដៅ ចំនួន ១.៥លាន នាក់ ។ ការបណ្តុះបណ្តាល ជំនាញ នេះ មាន វគ្គ ខ្លី វគ្គ មធ្យម វគ្គ វែង ហើយ យុវជន ដែល សិក្សា មិន ត្រឹមតែ មិន បង់ប្រាក់ ទេ ថែមទាំង ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ផងដែរ ។
៣៖ ការពង្រីក ការគ្រប់ ដណ្តប់ កម្មវិធី ជាតិ ជួយ សង្គម និង គ្រប់ ខណ្ឌ គាំពារ សង្គម លើ ប្រជាពលរដ្ឋ ប្រមាណ ៤.៥លាន នាក់ តាមរយៈ ទី១៖ កម្មវិធី ជាតិ ជួយ សង្គម ជា កញ្ចប់ គ្រួសារ សម្រាប់ ផ្តល់ ប្រាក់ ឧបត្ថម្ភ ជួយ គ្រួសារ ក្រីក្រ ងាយ រងគ្រោះ ជាង ៧០ ម៉ឺន គ្រួសារ សរុប ជាង ២. ៨លាន នាក់ ។ ទី២៖ ពង្រីក ក្របខណ្ឌ គាំពារ ដើម្បី ឆ្លើយតប នូវ គ្រោះអាសន្ន សម្រាប់ ទ្រទ្រង់ ផ្តល់ ការគាំពារ ជូន ប្រជាជន មាន លក្ខខណ្ឌ ជា ប្រព័ន្ធ ដើម្បីឱ្យ មាន និរន្តភាព ។
៤៖ ការដាក់ចេញ យុទ្ធសាស្ត្រ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ដូចជា អ្នក រត់ ម៉ូតូ ឌុប អ្នក រត់ កង់ បី កម្មករ សំណង់ អ្នកលក់ដូរ ជាដើម ឱ្យ មាន លទ្ធភាព ចូលរួម ក្នុង សេដ្ឋកិច្ច ក្នុង ប្រព័ន្ធ និង អាច ទទួលបាន ផលប្រយោជន៍ ពី ប្រព័ន្ធ គាំពារ សង្គម ផ្លូវការ ។
៥៖ ដាក់ចេញ នូវ កញ្ចប់ ថវិកា ជាក់លាក់ សម្រាប់ ជួយ ដល់ វិស័យ កសិកម្ម ។ ឯកឧត្តម នាយក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល បាន ត្រៀម ថវិកា ១០០ លាន ដុល្លារ អាមេរិក ដើម្បី អន្តរាគមន៍ ដល់ កសិផល ផលិតផល កសិកម្ម ស្រូវ អង្ករ បន្លែ ជាដើម តាមរយៈ កម្មវិធី ផ្សេង ៗ ដែល ចាំបាច់ របស់ រាជ រដ្ឋាភិបាល ។
ឯកឧត្តម នាយក រដ្ឋមន្រ្តី វ័យ ៤៥ ឆ្នាំ របស់ កម្ពុជា បាន ថ្លែង បែប នេះ ខណៈ ឯកឧត្តម ចុះ ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ដែល កំពុង បម្រើ ការងារ នៅ តាម បណ្តា រោង ចក្រ សហ គ្រាស នានា ក្នុង រាជធានី ភ្នំពេញ សរុប ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០ ២៣នេះ ។
ឯកឧត្តម បណ្ឌិត បាន មានប្រសាសន៍ ដូច្នេះ ថា៖ « ខ្ញុំ ធ្វើ ខ្ញុំ ទទួលខុសត្រូវ ការរិះគន់ ដើម្បី ស្ថាបនា គ្រប់ ទាំងអស់ ខ្ញុំ ទទួល តែ ការវាយប្រហារ បង្កើត រឿង ប្រឌិត រឿង អត់ ប្រយោជន៍ ខ្ញុំ នឹង មិន ឆ្លើយតប នាំ ខាត ពេល ខ្ញុំ » ។
ជាមួយនឹង ការបញ្ជាក់ នេះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ក៏ បាន បង្ហើប អំពី ការណែនាំ ជូន ដល់ លោក មាស សុភ័ណ្ឌ អ្នកនាំពាក្យ នាយក រដ្ឋមន្រ្តី ផងដែរ ដោយ បញ្ជាក់ ថា « អ្នកនាំពាក្យ មិន មែន ឆ្លើយតប គ្រប់ តែ រឿង នោះ ទេ » ។
ទោះជា យ៉ាងណា ឯកឧត្តម ក៏ បាន កោតសរសើរ ដល់ លោក មាស សុភ័ណ្ឌ ផងដែរ ថា ជា បុគ្គល ដែល មាន សមត្ថភាព និង មាន ចរិត ស្លូតបូត ដែល អាណត្តិ មុន លោក ក៏ ជា អ្នកនាំពាក្យ របស់ ក្រសួង ព័ត៌មាន ផងដែរ ៕
ការលើកឡើង នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា អនុញ្ញាតឱ្យ គណ: ប្រតិភូ មន្ត្រី ព្រឹទ្ធសភា អាមេរិក ដឹកនាំ ដោយ លោក អាឡិច ខានស៍ (Alex Carnes) ចូល ជួប សម្តែង ការគួរសម នា ល្ងាច ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ នៅ វិមាន សន្តិភាព ។
ជា កិច្ច ចាប់ផ្តើម ឯកឧត្តម កិតិ្ត ទេសាភិបាល បណ្ឌិត នាយក រដ្ឋមន្រ្តី បាន សម្ដែង នូវ ការស្វាគមន៍ យ៉ាង កក់ក្ដៅ ចំពោះ ការបំពេញ ទស្សនកិច្ច របស់ គណៈប្រតិភូ មន្រ្តី ព្រឹទ្ធសភា អាមេរិក មកកាន់ ព្រះរាជាណាចក្រ កម្ពុជា ដែល ឆ្លុះបញ្ចាំង អំពី ទំនាក់ទំនង ល្អ ប្រសើរ រវាង កម្ពុជា - អាមេរិក ។
លោក អាឡិច ខានស៍ បាន សម្ដែង នូវ ការអបអរសាទរ ជូន ចំពោះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ដែល ត្រូវបាន ជ្រើសតាំង ជា នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល ជា ការបើក ទំព័រ ថ្មី មួយ ឈាន ទៅរក ការធ្វើឱ្យ ប្រសើរឡើង នៃ ទំនាក់ទំនង កម្ពុជា - អាមេរិក ។ លោក បាន វាយតម្លៃ ខ្ពស់ ទៅ លើ កិច្ចសហប្រតិបត្តិការ អាមេរិក - កម្ពុជា ដែល មាន ចំណង ការទូត ដ៏ យូរអង្វែង មក ហើយ និង ការចូលរួម របស់ សហរដ្ឋ អាមេរិក តាមរយៈ កម្មវិធី ជំនួយ អភិវឌ្ឍ សង្គម . ការលើកកម្ពស់ ផ្នែក សុខាភិបាល និង ការអប់រំ នៅ កម្ពុជា ។
ជា ការឆ្លើយតប ឯកឧត្តម កិតិ្ត ទេសាភិបាល បណ្ឌិត បាន គូសបញ្ជាក់ ថា កម្ពុជា បើក ទ្វារ ចំហ និង ទទួលស្វាគមន៍ ជានិច្ច នូវ រាល់ គំនិត ផ្តួចផ្តើម និង កិច្ចសហប្រតិបត្តិការ នានា ដែល ធ្វើឱ្យ កាន់តែ ប្រសើរឡើង នូវ ទំនាក់ទំនង កម្ពុជា - អាមេរិក ។ កម្ពុជា ពិតជា ចង់បាន ទំនាក់ទំនង ល្អ ជាមួយ សហរដ្ឋ អាមេរិក ដោយ ឈរ លើ មូលដ្ឋាន នៃ ការគោរព គ្នា និង ការផ្ដល់ ផលប្រយោជន៍ ឱ្យ គ្នា ទៅ វិញ ទៅមក ដោយ សំលឹង ទៅ មុខ ឱ្យ លើស ពី ផលប្រយោជន៍ នយោបាយ តែ មួយ មុខ ។
បើ តាម យោធា កូរ៉េ ខាងត្បូង ប្រទេស ជា សម្ព័ន្ធមិត្ត ទាំង៣ បាន ចាប់ផ្ដើម ធ្វើ សមយុទ្ធ យោធា នៅឯ ដែន ទឹក អន្តរជាតិ នៃ កោះ ចេជូ (Jeju) នៃ ភាគ ខាងត្បូង ប្រទេស កូរ៉េ ខាងត្បូង ដើម្បី ធ្វើឱ្យ ប្រសើរឡើង នូវ សមត្ថភាព ចាប់ សញ្ញា និង កំណត់ គោលដៅ ព្រមទាំង ការចែករំលែក ព័ត៌មាន នៅក្នុង ករណី មាន ការបង្ក ហេតុ ណាមួយ ពីសំណាក់ ទីក្រុង ព្យុងយ៉ាង ។
តាមរយៈ ការដកស្រង់ សម្ដី ដោយ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ កូរ៉េ ខាងជើង KCNA លោក គីម ជុង អ៊ុន បាន គូសបញ្ជាក់ ដូច្នេះ ថា « ដោយសារតែ សកម្មភាព ប្រឈមមុខ ដាក់ គ្នា យ៉ាង គឃ្លើន របស់ សហរដ្ឋ អាមេរិក និង កម្លាំង អរិភាព ដទៃ ទៀត តំបន់ ដែន ទឹក នៃ ឧបទ្វីប កូរ៉េ កំពុង ប្រែក្លាយ បន្តិច ម្តង ៗ ទៅជា កន្លែង ប្រមូលផ្ដុំ នៃ បរិក្ខារ សង្រ្គាម ដ៏ ធំ បំផុត មួយ នៅលើ ពិភពលោក ព្រមទាំង ក្លាយទៅជា តំបន់ ដែន ទឹក ដ៏ អស្ថិរភាព បំផុត ជាមួយ គ្រោះថ្នាក់ នៃ ការផ្ទុះ សង្រ្គាម នុយក្លេអ៊ែរ » ។
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្រ្តី សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ បាន ណែនាំ ដល់ ថ្នាក់ដឹកនាំ និង មន្រ្តី ទាំងអស់ ឱ្យ បន្ត និរន្តរភាព អ្វី ដែល មាន ពីមុន និង បន្ត បង្កើន ប្រសិទ្ធភាព តទៅ មុខ ទៀត យកចិត្តទុកដាក់ អនុវត្ត ការងារ ជាប្រចាំ ធ្វើ យ៉ាងណា ពន្លឿន ការចុះបញ្ជី ដីធ្លី ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ឆាប់ រហ័ស ដើម្បី ផ្តល់ បណ្ណ កម្មសិទ្ធិ ស្រប ច្បាប់ ជូន ពួកគាត់ ប្រកបដោយ ទំនុកចិត្ត និង ប្រសិទ្ធភាព ។
ការណែនាំ បែប នេះ របស់ ឧប នាយក រដ្ឋមន្រ្តី សាយ សំអាល់ បាន ធ្វើឡើង នៅក្នុង ឱកាស លោក បាន ដឹកនាំ កិច្ចប្រជុំ ជីវភាព ដើម្បី ពិនិត្យ និង វាយតម្លៃ វឌ្ឍនភាព ការងារ សុរិយោដី និង ភូមិសាស្រ្ត ការងារ រៀបចំ ដែនដី នគរូបនីយកម្ម និង ការងារ ដោះស្រាយ វិវាទ ដីធ្លី ដែល បាន នឹង កំពុង អនុវត្ត ដើម្បី កំណត់ ទិសដៅ ត្រូវ អនុវត្ត បន្ត នៅ ទីស្តីការ ក្រសួង រៀបចំ ដែនដី នគរ រូបនីយកម្ម និង សំណង់ នា ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ ម្សិលមិញ ។
គិត ត្រឹម ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២៣ ក្រសួង បាន ចេញ បណ្ណ កម្មសិទ្ធ ដីធ្លី ជូន ប្រជាពលរដ្ឋ បាន ៦.៩៤៥ . ០៦៩ បណ្ណ ស្មើនឹង ៩៩. ២% នៃ ចំនួន ក្បាល ដី ប៉ាន់ស្មាន ដំបូង ចំនួន ៧លាន ក្បាល ដី នៅក្នុង ភូមិ ចំនួន ៧. ៥០៨ នៃ ឃុំ ចំនួន ៦៥០ នៃ ក្នុង ក្រុង ស្រុក ចំនួន ៣០ ទូទាំង ប្រទេស តាម របាយការណ៍ របស់ អគ្គ នាយកដ្ឋាន សុរិយោដី និង ភូមិសាស្រ្ត ។
គិត ចាប់ពី ពេល ផ្តើម អនុវត្ត ដល់ ខែកក្កដា ឆ្នាំ ២០២៣ ក្រសួង បាន ដោះស្រាយ វិវាទ ដីធ្លី តាមរយៈ ទាំង ៣យន្តការ ដោយ បាន ដោះស្រាយ បញ្ចប់ នីតិវិធី ចំនួន ១១. ២៧៥ ពី ក្នុង ពាក្យបណ្តឹង សរុប ចំនួ ១៤. ៨១៤ ករណី និង កំពុង ដោះស្រាយ ជា បន្តបន្ទាប់ ទៀត ។ ក្រៅពី នេះ ក្រសួង ក៏ សំរេច បាន នូវ លទ្ធផល ការងារ ល្អ ប្រសើរ ជាច្រើន ទាក់ទិន នឹង ការងារ សុរិយោដី និង ភូមិសាស្រ្ត និង ការងារ រៀបចំ ដែនដី នគរូបនីយកម្ម ផងដែរ ។
បច្ចុប្បន្នភាព ប្រចាំ ថ្ងៃ៖ គិត ត្រឹម ព្រឹក ថ្ងៃ ២៩ ខែសីហា ការឆ្លង តំបន់ អាស៊ាន មាន អ្នក ឆ្លង កូវីដ១៩ មាន ការប្រែប្រួល តិចតួច ខណៈ អ្នក ឆ្លង មាន ចំនួន ជាង ៣៦. ៣លាន នាក់
បើ តាម យោធា អ៊ុយក្រែន កងកម្លាំង របស់ ខ្លួន កាលពី សប្ដាហ៍ មុន បាន ដោត ទង់ជាតិ នៅក្នុង ភូមិ យុទ្ធសាស្ត្រ រ៉ូប៉ូទីន (Robotyne) និង បាន បង្ហោះ ជា វីដេអូ នៅលើ បណ្ដាញ ទំនាក់ទំនង សង្គម បង្ហាញ ពី សកម្មភាព ដោត ទង់ជាតិ នេះ ផងដែរ ។ បន្ទាប់ពី នោះ កងកម្លាំង អ៊ុយក្រែន បាន បើក ប្រតិបត្តិការ បោសសម្អាត សត្រូវ នៅ សេសសល់ រហូត ទាល់តែ ពួកគេ ទទួលស្គាល់ ជា ផ្លូវការ ពី ការគ្រប់គ្រង និង រំដោះ បាន ភូមិ នេះ បាន ទាំងស្រុង នៅ ថ្ងៃចន្ទ សប្ដាហ៍ នេះ ។
( ភ្នំពេញ ) ៖ លោក ប៊ិន ត្រឈៃ រដ្ឋមន្ត្រី ក្រសួង ផែនការ បាន ចេញ សេចក្តីសម្រេច ស្តីពី របៀបរបប ការងារ និង ការបែងចែក ភារកិច្ច របស់ ថ្នាក់ដឹកនាំ ក្រសួង ផែនការ ដល់ រដ្ឋលេខាធិការ និង អនុ រដ្ឋលេខាធិការ ។ នេះ បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ ៕
ខាងក្រោម នេះ ជា សេចក្តីសម្រេច៖ គ្រោះ រញ្ជួយ ដី កម្រិត ៧. ០រ៉ិច ទ័រ វាយប្រហារ លើ សមុទ្រ បាលី ប្រទេស ឥណ្ឌូណេស៊ី
មិន ត្រូវ បើកបរ លើស ល្បឿន កំណត់ ជាដាច់ខាត ! ស្លាប់ ៦នាក់ និង របួស ៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៨ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ ស្រាល ៦នាក់ ។
អឺរ៉ុប កូរ៉េ ទីម័រ និង អាមេរិក ជា ភ្ញៀវ បរទេស ដែល ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត ទទួល ជួប លើក ដំបូង ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី (Video inside) ( ភ្នំពេញ ) ៖ បន្ទាប់ពី ការចេញដំណើរ ជា ផ្លូវការ ដោយ ការបើក កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី ដំបូង កាលពី ថ្ងៃទី ២៤ ខែសីហា កាលពី សប្តាហ៍ មុន ហើយ នោះ នៅ ថ្ងៃចន្ទ ទី២៨ ខែសីហា នេះ ប្រមុខ រាជ រដ្ឋាភិបាល ថ្មី របស់ កម្ពុជា ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ក៏ បាន ចាប់ផ្តើម របៀបវារៈ ការងារ របស់ ខ្លួន ។
របៀបវារៈ ការងារ ថ្ងៃ ដំបូង របស់ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត មាន រហូតដល់ទៅ ៥កម្មវិធី រវល់ តាំងពី ព្រលឹម ទល់ ព្រលប់ តែម្តង ។ កម្មវិធី ទី១ សម្រាប់ ថ្ងៃ នេះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត រួម និង ឧត្តម ភរិយា បាន អញ្ជើញ ថ្វាយ ព្រះរាជ ដំណើរ ព្រះមហាក្សត្រ និង ព្រះមហាក្សត្រី យាង ទៅ ពិនិត្យ ព្រះរាជ សុខភាព នាទីក្រុង បេកាំង ប្រទេស ចិន ។
បន្ទាប់ពី ថ្វាយ ព្រះរាជ ដំណើរ ព្រះមហាក្សត្រ និង ព្រះមហាក្សត្រី នៅឯ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ ហើយ នោះ ឯកឧត្តម បណ្ឌិត ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន ធ្វើដំណើរ ឆ្ពោះ មកកាន់ វិមាន សន្តិភាព ដើម្បី ជួប ភ្ញៀវ បរទេស ។ ថ្ងៃ នេះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត បាន ជួប ភ្ញៀវ បរទេស ជា បន្តបន្ទាប់ រហូតដល់ទៅ ៤ភ្ញៀវ ។
ក្នុង ជំនួប ទាំង ៤នេះ ភ្ញៀវ បរទេស ទាំងអស់ សុទ្ធតែ បាន បង្ហាញ ការសាទរ ជូន ចំពោះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ដែល ទទួលបាន ការគាំទ្រ ជា នាយក រដ្ឋមន្ត្រី កម្ពុជា ។ ភ្ញៀវ បរទេស ជា មិត្ត ក៏ បាន បង្ហាញ ជំនឿចិត្ត របស់ ពួកគេ ផងដែរ ថា ក្រោម ការដឹកនាំ របស់ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត នឹង ធ្វើឱ្យ កម្ពុជា អភិវឌ្ឍន៍ រីកចម្រើន លូតលាស់ កាន់តែ ខ្លាំង បន្ថែម ទៀត ។
ក្រៅតែ ពី បាន បង្ហាញ ការសាទរ ចំពោះ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត ហើយ នោះ ក្នុង ជំនួប ទាំង ៤នេះ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត និង ភ្ញៀវ ជា មិត្ត ក៏ បាន បង្ហាញ ជំហ ពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ នានា ឱ្យ កាន់តែ ល្អ ប្រសើរ ផងដែរ ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ លំអិត នៃ ជំនួប នីមួយ ៗ៖
៤៖ ប្រតិភូ មន្ត្រី ព្រឹទ្ធសភា អាមេរិក អបអរសាទរ ជូន ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ដែល ត្រូវបាន ជ្រើសតាំង ជា នាយក រដ្ឋមន្រ្តី ថ្មី កម្ពុជា និង ចាត់ទុក ថា ជា ការបើក ទំព័រ ថ្មី មួយ ឈាន ទៅរក ការធ្វើឱ្យ ប្រសើរឡើង នៃ ទំនាក់ទំនង កម្ពុជា
លោក រដ្ឋមន្ដ្រី ឈាង រ៉ា ចុះ សំណេះសំណាល សួរសុខទុក្ខ ប្រជាពលរដ្ឋ ដែល មក ទទួល សេវា សុខាភិបាល នៅ តាម មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ ក្នុង ខេត្ត កំពង់ធំ (Video inside) ( កំពង់ធំ ) ៖ រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល លោក សាស្ត្រាចារ្យ ឈាង រ៉ា នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន ចុះ សំណេះសំណាល សួរសុខទុក្ខ ប្រជាពលរដ្ឋ ដែល មក ទទួល សេវា សុខាភិបាល នៅ មណ្ឌល សុខភាព ប្រឡាយ មន្ទីរពេទ្យ ខេត្ត កំពង់ធំ និង មន្ទីរពេទ្យ បង្អែក បារាយ និង សន្ទុក ក្នុង ខេត្ត កំពង់ធំ ។
ក្នុង ឳកាស នោះ លោក សាស្ត្រាចារ្យ ឈាង រ៉ា ក៏ បាន ពិនិត្យមើល នូវ ស្ថានភាព របស់ អ្នកជំងឺ ដោយ ផ្ទាល់ និង ផ្តល់ ការណែនាំ ដល់ អ្នកជំងឺ និង ក្រុមគ្រួសារ អ្នកជំងឺ ពី ការថែទាំ សុខភាព និង ការបង្ការ ទប់ស្កាត់ និង ការពារ ពី ជំងឺ ឆ្លង និង មិន ឆ្លង ផងដែរ ។
ទន្ទឹម នឹង នោះ លោក សាស្ត្រាចារ្យ ក៏ បាន បង្ហាញ ពី វិធីសាស្ត្រ មើល ថែ និង ព្យាបាល អ្នកជំងឺ ជាពិសេស របៀប សង្គ្រោះ បន្ទាន់ ប្រកបដោយ គុណភាព និង ប្រសិទ្ធភាព ដល់ ក្រុម គ្រូពេទ្យ នៅ តាម មណ្ឌល សុខភាព មន្ទីរពេទ្យ បង្អែក និង មន្ទីរពេទ្យ ខេត្ត ។
ជុំវិញ នឹង ការចុះ សួរសុខទុក្ខ នេះ ប្រជាពលរដ្ឋ ដែល បាន មក ទទួល ការព្យាបាល ជំងឺ បាន សម្តែង នូវ ការពេញចិត្ត យ៉ាង ខ្លាំង ចំពោះ ការយកចិត្ត ដាក់ របស់ លោក រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ។
លើស ពី នោះ ប្រជាពលរដ្ឋ បាន សម្តែង ការសប្បាយ ចិត្ត យ៉ាង ខ្លាំង ពេល ទទួលបាន ដំណឹង ថា រដ្ឋមន្ត្រី សុខាភិបាល ក្នុង អណត្តិ ទី៧ នេះ នឹង ខិតខំ ជំរុញ ធ្វើ យ៉ាងណា ឲ្យ វិស័យ សុខាភិបាល មាន ការរីកចម្រើន ទាំង ហេដ្ឋាន រចនាសម្ព័ន្ធ សម្ភារៈ បរិក្ខារ ពេទ្យ ជាពិសេស ពង្រឹង គុណភាព និង ប្រសិទ្ធភាព នៃ ការព្យាបាល ជំងឺ កាន់តែ ប្រសើរ ។
ក្នុង នោះ លោក រដ្ឋមន្ត្រី ឈាង រ៉ា ក៏ បាន គូសបញ្ជាក់ ថា នឹង ពង្រឹង វិស័យ សុខាភិបាល នៅក្នុង មូលដ្ឋាន ឲ្យ មាន សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការពិនិត្យ ព្យាបាល ។ បើ ករណី អ្នកជំងឺ មក ក្នុង ស្ថានភាព ធ្ងន់ធ្ងរ ខ្លាំង មណ្ឌល សុខភាព យើង ត្រូវ មាន សមត្ថភាព គ្រប់គ្រាន់ ដើម្បី សង្គ្រោះ បឋម ឲ្យ ទាន់ ពេលវេលា និង ប្រកបដោយ សុវត្ថិភាព មុន បញ្ជូន ទៅ ទីតាំង មួយ ទៀត ។
ប៉ុន្តែ នៅក្នុង កម្រិត មន្ទីរពេទ្យ បង្អែក និង ថ្នាក់ ខេត្ត គឺ ពង្រឹង សមត្ថភាព ក្នុង ការជួយសង្គ្រោះ ឲ្យបាន ខ្លាំង ដើម្បី កាត់បន្ថយ ពី ការបញ្ជូន អ្នកជំងឺ ពី ខេត្ត ឆ្ងាយ មក រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ថា បន្ទាប់ពី បាន ចូលកាន់ តំណែង ជា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល ក្នុង អាណត្ដិ ទី៧ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា បាន ដឹកនាំ គណៈប្រតិភូ សុខាភិបាល ចុះ ពិនិត្យ ស្ថានភាព មូលដ្ឋាន សុខាភិបាល នៅ តាម បណ្ដា ខេត្ដ នៅ ជុំវិញ បឹង ទន្លេ សាប ចាប់ពី ថ្ងៃទី ២៥ - ២៨ ខែសីហា ឆ្នាំ ២០២៣ នេះ ដោយ បាន ចុះ ទៅដល់ មណ្ឌល សុខភាព មន្ទីរពេទ្យ បង្អែក និង មន្ទីរពេទ្យ ខេត្ត ក្នុង ខេត្ត ចំនួន ៦ រួម មាន៖ កំពង់ឆ្នាំង ពោធិ៍សាត់ បាត់ដំបង បន្ទាយមានជ័យ សៀមរាប និង ខេត្ត កំពង់ធំ ។
ឱកាស ចុះ បេសកកម្ម ដំបូង នេះ លោក រដ្ឋមន្ត្រី ក៏ បាន សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ និង មន្ត្រី សុខាភិបាល ដោយ បាន លើ យក នូវ យុទ្ធសាស្ត្រ ក្នុង ការផ្តល់ សេវា ថែទាំ និង ព្យាបាល អ្នកជំងឺ ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ក្នុង នោះ រួម មាន៖
១៖ បង្កើន សកម្មភាព អប់រំ សុខភាព ជូន ប្រជាពលរដ្ឋ ដើម្បី លើកកម្ពស់ សុខភាព ជូន ប្រជាជន ឱ្យ កាន់តែ ប្រសើរឡើង ។
៣៖ ទប់ស្កាត់ នឹង ការរីករាលដាល ជំងឺ ឆ្លង ជា សាកល ដែល កើតមាន ។
៤៖ ប្រយុទ្ធ នឹង ជំងឺ មិន ឆ្លង ដូចជា ជំងឺ មហារីក ជំងឺ ទឹកនោម ផ្អែម ជំងឺ បេះដូង ។ល ។
៥៖ ប្រយុទ្ធ នឹង ផល ប៉ះពាល់ ដល់ សុខភាព បណ្តាល មកពី ការប្រែប្រួល អាកាសធាតុ ។
៦៖ ធ្វើឱ្យ កាន់តែ ប្រសើរឡើង ការពិនិត្យ ព្យាបាល ទូលំទូលាយ នៅក្នុង សហគមន៍ ក៏ ដូចជា ធ្វើឱ្យ កាន់តែ ប្រសើរឡើង កម្មវិធី គាំពារ សង្គម ដូចជា ប.ស. ស មូលនិធិ សមធម៌ ។
៧៖ លើកកម្ពស់ គុណភាព ថែទាំ ទាំង សេវា សាធារណៈ និង ឯកជន ។
៨៖ អភិវឌ្ឍន៍ ធនធាន មនុស្ស សុខាភិបាល ទូទាំង ប្រទេស ដើម្បី បញ្ជូន អ្នកជំនាញ ឱ្យ ដល់ មូលដ្ឋាន ពោលគឺ បង្ខិត សេវា ឱ្យ កាន់តែ គៀក ប្រជាពលរដ្ឋ ។
៩៖ អភិវឌ្ឍន៍ សុខភាព ឌីជីថល ។
លោក រដ្ឋមន្ដ្រី បាន បន្ដ ទៀត ថា អាទិភាព មួយ ក្នុង ចំណោម អាទិភាព ទាំងឡាយ សម្រាប់ អណត្តិ ទី៧នេះ គឺ សេវា ថែទាំ ដែល នឹង ត្រូវ ធ្វើឱ្យ កាន់តែ ប្រសើរ ថែម ទៀត ដោយ នៅ ចំពោះមុខ នេះ ក្រសួង នឹង អនុវត្ត ផែនការ សកម្មភាព ចំនួន ៣ រួម មាន៖
* ពង្រឹង មណ្ឌល សុខភាព ដោយ កែលម្អ អគារ បំពាក់ សម្ភារៈ បរិក្ខារ បន្ថែម រួមទាំង ការផ្គត់ផ្គង់ ឱសថ ពង្រឹង សមត្ថភាព បុគ្គលិក ដើម្បី ធានា ការ ផ្តល់ សេវា ២៤ ម៉ោង
* ពង្រឹង គុណភាព ប្រសិទ្ធភាព សុវត្ថិភាព និង សមធម៌ នៃ សេវា ទាំង នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក ខេត្ត និង មន្ទីរពេទ្យ ជាតិ ព្រមទាំង និយ័តកម្ម សេវា ឯកជន ឱ្យ កាន់តែ ប្រសើរឡើង និង ត្រូវ យក សេវា ឯកជនជា ដៃគូ នឹង សេវា សាធារណៈ ។
* ពង្រឹង ស្ថាប័ន តាមរយៈ ការបណ្តុះបណ្តាល ជា បន្តបន្ទាប់ លើ ភាព ជា អ្នកដឹកនាំ ជំនាញ ដល់ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ ។
១៖ ព្រះមហាក្សត្រ និង សម្តេច ម៉ែ បាន យាង ចាកចេញ ពី រាជធានី ភ្នំពេញ ហើយ ដើម្បី ពិនិត្យ ព្រះរាជ សុខភាព នៅ ទីក្រុង ប៉េកាំង ប្រទេស ចិន
៣៖ ក្រសួង សុខាភិបាល៖ ថ្ងៃ នេះ មិន មាន រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ នោះ ទេ ខណៈ អ្នក ជាសះស្បើយ ក៏ គ្មាន ដែរ
៥៖ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត និង សហភាព អឺរ៉ុប ប្តេជ្ញា បន្ត ជំរុញ និង លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ កម្ពុជា និង សហភាព អឺរ៉ុប ឱ្យ កាន់ ជិតស្និទ្ធ
៦៖ ក្រុម នាវា ចម្បាំង រុស្ស៉ី ត្រឡប់ មកពី ធ្វើ ប្រតិបត្តិការ ល្បាត រយៈពេល ជាង ៣សប្តាហ៍ នៅ មហាសមុទ្រ ប៉ាស៉ី ហ្វិក រួមគ្នា ជាមួយ ក្រុម នាវា ចម្បាំង ចិន
៧៖ មន្ត្រី ជាន់ ខ្ពស់ របស់ កូរ៉េ ខាងត្បូង ជឿ ថា កម្ពុជា កាន់តែ រីកចម្រើន ក្រោម ការដឹកនាំ របស់ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត
៨៖ លោក ហ្សេលេន ស្គី៖ លោក ខាងលិច នឹង មិន គាំទ្រ អ៊ុយក្រែន ឡើយ ចំពោះ ការវាយប្រហារ លើ ទឹកដី រុស្ស៉ី
៩៖ កម្ពុជា - ទីម័រ ខាងកើត ឯកភាព ពន្លឿន ការចុះ MoU ជំរុញ កិច្ចសហប្រតិបត្តិការ ទេសចរណ៍ ដើម្បី លើកកម្ពស់ សេដ្ឋកិច្ច វប្បធម៌ និង ពង្រឹង ទំនាក់ទំនង ប្រជាជន
១០៖ ចៅហ្វាយ ក្រុង មូស្គូ៖ យន្ដហោះ ដ្រូន របស់ អ៊ុយក្រែន ត្រូវបាន បាញ់ ទម្លាក់ ក្បែរ ទីក្រុង មូស្គូ
១១៖ លោក ហ៊ុន ម៉ានី៖ ការអនុវត្ត ចក្ខុវិស័យ នាយក រដ្ឋមន្ត្រី ការជំរុញ កំណែទម្រង់ និង ពង្រឹង រដ្ឋបាល សាធារណៈ និង ការធ្វើ ទំនើបកម្ម ស្ថាប័ន សាធារណៈ គឺជា បេសកកម្ម ចម្បង ០៣ របស់ ក្រសួង មុខងារ សាធារណៈ ក្នុង អាណត្តិ ទី៧
១៣៖ កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ការប្រកួត រ៉ូបូត ដ៏ ធំ ជាង គេ នៅ អាស៊ី ប៉ាស៊ីហ្វិក ២០២៣ . ជប៉ុន ទទួលបាន ជ័យលាភី លេខ ១
១៤៖ ជប៉ុន និង សហរដ្ឋ អាមេរិក គ្រោង រៀបចំ សមយុទ្ធ យោធា នៅ សមុទ្រ ចិន ខាងកើត
១៥៖ ចិន សម្រេច លែង តម្រូវ ឱ្យ មាន ការធ្វើតេស្ត រក កូវីដ១៩ ត ទៀត ហើយ សម្រាប់ អ្នកដំណើរ ដែល ចូលទៅ ប្រទេស ខ្លួន
១៧៖ រុស្ស៉ី ចោទប្រកាន់ អតីត បុគ្គលិក ស្ថាន កុល ស៊ុល អាមេរិក ពី បទ ធ្វើ ចារកម្ម
១៨៖ ជប៉ុន ផ្អាក ការបញ្ជូន យាន រ៉ូបូត ឱ្យ ទៅ ចុះចត លើ ឋាន ព្រះចន្ទ ដោយសារ អាកាសធាតុ មិន អំណោយផល
១៩៖ ក្រុម មន្ត្រី ចិន ព្រមាន ពី ភ្លៀង ធ្លាក់ ខ្លាំង និង គ្រោះ ទឹក ជំនន់ នៅ តាម ខេត្ត ជាច្រើន នៃ ប្រទេស
២០៖ ក្រុម តាលី បង់ ហាមឃាត់ ស្រ្តី ទៅ កម្សាន្ត នៅឯ ឧទ្យាន ជាតិ អាហ្វហ្កានីស្ថាន
២១៖ ទាហាន ម៉ារីន អាមេរិក ៣នាក់ ស្លាប់ ក្នុង ហេតុការណ៍ ធ្លាក់ ឧទ្ធម្ភាគចក្រ អំឡុង សមយុទ្ធ យោធា នៅ អូស្ត្រាលី
២២៖ អង្គការ សន្តិសុខ ដឹកនាំ ដោយ រុស្ស៉ី អញ្ជើញ ក្រុម អ្នក សង្កេតការណ៍ ពី អារ៉ាប់ប៊ី សាអូឌីត អ៉ឺរ៉ង់ ចិន និង ម៉ុងហ្គោលី ចូលរួម ក្នុង សមយុទ្ធ យោធា
ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ថ្លែង ដូចនេះ នា ព្រឹក ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ចុះ ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ដែល កំពុង បម្រើ ការងារ នៅ តាម បណ្តា រោងចក្រ សហគ្រាស នានា ក្នុង រាជធានី ភ្នំពេញ សរុប ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ថ្លែង ដូចនេះ ថា « បើ សហគមន៍ អន្តរជាតិ កាលពី ថ្ងៃទី ២៥ ខ្ញុំ បាន ទទួល ពី ប្រធាន គណៈកម្មការ អឺរ៉ុប ហើយ បើ ក្នុង អឺរ៉ុប គាត់ ក្នុង ចំណោម ថ្នាក់ដឹកនាំ ធំ យើង មិន បាច់ ចាំ បាន ពី ប្រទេស អឺរ៉ុប នោះ ទេ គាត់ ជា តំណាង ប្រទេស អឺរ៉ុប ទាំង ប៉ុន្មាន រួចទៅហើយ ២០ ប្រទេស ជាង គាត់ ចេញ សារ អបអរសាទរ បើសិន ជា សមាជិក មួយ ៗ មិន អបអរសាទរ គាត់ មិន ឱ្យ ប្រធាន គាត់ ចេញ សារ អបអរ នោះ ទេ » ។
ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ថ្លែង យ៉ាង ដូច្នេះ ក្នុង ពិធី សំណេះសំណាល ជាមួយ កម្មករ និយោជិត នៅ តាម រោងចក្រ សហគ្រាស នៅ តំបន់ ព្រៃ ស្ពឺ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ នា ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ ។
នា ឱកាស នោះ ឯកឧត្តម បណ្ឌិត បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ គឺ មាន គោលដៅ បន្ត ថែរក្សា ឱ្យ បាន នូវ សមិទ្ធផល ដែល គណបក្ស ប្រជាជន កម្ពុជា សម្រេចបាន ក្នុង រយៈពេល ៤៤ ឆ្នាំ មក នេះ គឺ រួម មាន ការថែរក្សា ឱ្យ បាន នូវ សុខ សន្តិភាព ស្ថិរភាព ការអភិវឌ្ឍ ជូន ប្រជាពលរដ្ឋ និង ការឯកភាព ជាតិ ទឹកដី ។
ឯកឧត្តម នាយក រដ្ឋមន្ត្រី បាន បន្ត ថា « ការនិយាយ ម្ដង ហើយ ម្ដង ទៀត នេះ គឺជា រឿង សំខាន់ ដែល ត្រូវតែ និយាយ សន្តិភាព គឺ ពិតជា សំខាន់ កាលពី ៤០ ឆ្នាំ មុន សន្តិភាព នៅតែ សំខាន់ កាលពី ២០ ឆ្នាំ មុន ហើយក៏ នៅតែ សំខាន់ ក្នុង ពេល បច្ចុប្បន្ន នេះ និង នៅតែ សំខាន់ សម្រាប់ កម្ពុជា ក្នុង ពេល ត ទៅ មុខ ទៀត បើ គ្មាន សន្តិភាព កុំ និយាយ អំពី ការបង្កើត ការងារ នោះ ដូច្នេះ ត្រូវតែ ថែរក្សា ឱ្យ បាន » ។
លោក កាមីន ស្គី បាន បន្ថែម ថា « ប្រសិនបើ មាន ឧបទ្ទវហេតុ ធ្ងន់ធ្ងរ ណាមួយ កើតឡើង មិន ថា នៅក្នុង ព្រំដែន ប៉ូឡូញ ឬ លីទុយ អានី នោះ ទេ យើង នឹង សងសឹក វិញ ភ្លាម ៗ ហើយ ច្រក ព្រំដែន ទាំងអស់ នឹង ត្រូវ បិទ ផងដែរ » ។
គួរ បញ្ជាក់ ថា សមាជិក EU និង NATO ដូចជា ឡេតូនី លីទុយ អានី និង ប៉ូឡូញ កំពុង ព្រួយបារម្ភ អំពី កើនឡើង នូវ ការគំរាមកំហែង សន្តិសុខ ចាប់តាំងពី ក្រុម ទាហាន ស៊ីឈ្នួល រុស្ស៉ី Wagner បាន មកដល់ ទឹកដី បេឡារុស ។ នៅ ឆ្នាំ ២០២៣ នេះ ប៉ូឡូញ បាន បិទ ច្រក ព្រំដែន ទាំងអស់ រួចហើយ នៅសល់ តែ ច្រក ឆ្លងកាត់ មួយ ប៉ុណ្ណោះ បន្ទាប់ពី មាន ការចាប់ អ្នកកាសែត ដើមកំណើត ប៉ូឡូញ ដាក់ ពន្ធនាគារ និង ការបណ្តេញ អ្នកការទូត ប៉ូឡូញ ចេញ ពី បេឡារុស ៕
ឧប នាយក រដ្ឋមន្រ្ដី សុខ ចិន្តា សោភា ជួប សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ មន្រ្ដី រាជការ និង បុគ្គលិក ក្រសួង ទាំងអស់
ការវាយប្រហារ បំផ្ទុះ គ្រាប់បែក ខាងលើ គឺ ស្ថិត នៅក្នុង ចំណោម ការវាយប្រហារ បំផ្ទុះ គ្រាប់បែក ដែល បាន ផ្ដាច់ ជីវិត មនុស្ស ច្រើន បំផុត នៅលើ ពិភព ក លោក បន្ទាប់ពី ការវាយប្រហារ ភេរវកម្ម លើ សហរដ្ឋ អាមេរិក កាលពី ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០០១ ។ បើ តាម ក្រុម មន្ត្រី អ៉ីរ៉ាក់ ការវាយប្រហារ បំផ្ទុះ គ្រាប់បែក បង្កៃ លើ រថយន្ដ ក្នុង សង្កាត់ ទីប្រជុំជន ការ៉ាដា (Karrada) នៃ រដ្ឋធានី បាកដាដ កាលពី ថ្ងៃទី ៣ ខែកក្កដា ឆ្នាំ ២០១៦ បាន សម្លាប់ មនុស្ស ៣២៣ នាក់ ។
គួរ បញ្ជាក់ ថា សេចក្ដីថ្លែងការណ៍ របស់ ការិយាល័យ នាយក រដ្ឋមន្ត្រី អ៉ីរ៉ាក់ មិន បាន បញ្ជាក់ លម្អិត ពី ឈ្មោះ អ្នកទោស ដែល ត្រូវបាន ប្រហារជីវិត ខាងលើ នោះ ទេ ហើយក៏ មិន បាន ប្រាប់ ឱ្យដឹង ច្បាស់ ពី កាលបរិច្ឆេទ នៃ ការផ្តន្ទាទោស អ្នក ទាំង នេះ នោះ ដែរ ដោយ គ្រាន់តែ ឱ្យដឹង ថា ការប្រហារជីវិត ធ្វើឡើង កាលពី យប់ ថ្ងៃអាទិត្យ និង ព្រឹក ថ្ងៃចន្ទ ដើម សប្ដាហ៍ កន្លងទៅ នេះ ៕
អគ្គ មេបញ្ជាការប្រកាស មុខតំណែង ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ ជា អគ្គមេបញ្ជាការ រង និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ប្រកាស ចូលកាន់ មុខ តំណែង របស់ ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ ជា អគ្គមេបញ្ជាការ រង និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក នា ព្រឹក ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ នៅ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក ។
ថ្លែង ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល កម្ពុជា នីតិកាល ទី៧ ក្រោម ការដឹកនាំ របស់ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បន្ត ដឹកនាំ នាវា កម្ពុជា ធានា បាន និរន្តរភាពជាតិ សន្តិភាព ស្ថិរភាព យូរអង្វែង ដែល ជា មូលដ្ឋានគ្រឹះ ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ ក៏ ដូចជា លទ្ធិ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ។
ក្នុង ន័យ នេះ កងយោធពល ខេមរភូមិន្ទ ប្តេជ្ញា គាំទ្រ ពេញ ទំហឹង និង ចូលរួម អនុវត្ត យ៉ាង សកម្ម ជាមួយ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ក្នុង ការអនុវត្ត វិធានការ គោល នយោបាយ និង កម្មវិធី នានា នៅក្នុង ក្របខណ្ឌ នៃ « យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ » ។
ជាមួយ នោះ កងយោធពល ខេមរភូមិន្ទ សូម ប្តេជ្ញា ការពារ រាជដ្ឋាភិបាល ស្រប ច្បាប់ កើត ចេញពី ការបោះឆ្នោត និង កម្ទេចចោល រាល់ អំពើ ក្បត់ ជាតិ ម នោគមន៍វិជ្ជា ជ្រុលនិយម ដែល មាន គោលបំណង ចង់ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ។
នាយ ឧត្តមសេនីយ៍ អគ្គ មេបញ្ជាការ ក៏ បាន ផ្តាំផ្ញើ ដល់ គ្រប់ កង ឯកភាព យកចិត្តទុកដាក់ កសាង ធនធាន មនុស្ស គ្រប់ ជំនាញ ឲ្យ សមស្រប ទៅនឹង ផែនការ យុទ្ធសាស្ត្រ កំណែទម្រង់ កងយោធពល ខេមរភូមិន្ទ ដោយ ធ្វើ ការបណ្តុះបណ្តាល នាយ ទាហាន វ័យ ក្មេង មាន សមត្ថភាព ឱ្យ ចូលក្នុង ជួរ ថ្នាក់ដឹកនាំ ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត ជួប កម្មករ ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ រាជធានី ភ្នំពេញ ជា វេទិកា សារធារណៈ លើក ដំបូង ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី
( ភ្នំពេញ ) ៖ មិន បង្អង់ យូរ ឡើយ បន្ទាប់ពី រាជ រដ្ឋាភិបាល នីតិកាល ថ្មី ត្រូវបាន បង្កើត រួចរាល់ ហើយ នោះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី ដ៏ មាន ប្រជាប្រិយភាព របស់ កម្ពុជា ក៏ បាន ដាក់ចេញ នូវ របៀបវារៈ ការងារ របស់ ខ្លួន ជា បន្តបន្ទាប់ ប្រកបដោយ ភាពស្វាហាប់ និង ការទទួលខុសត្រូវ ខ្ពស់ ។ ឯកឧត្តម បណ្ឌិត ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន វ័យ ៤៥ ឆ្នាំ ក៏ បាន ដាក់ចេញ ការងារ ចុះ ជួប មហាជន ភ្លាម ៗ ផងដែរ ។
ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត បាន អញ្ចើញ ចុះ ជួប កម្មករ ជិត ២ម៉ឺន នាក់ នៅ តំបន់ ព្រៃ ស្ពឺ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដែល ជា វេទិកា សារធារណៈ លើក ដំបូង ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ ឯកឧត្តម នាយក រដ្ឋមន្រ្តី ដែល បាន ថ្លែង សំណេះសំណាល ជាង ពីរ ម៉ោ ង៖
* ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន នាំយក នូវ ពាក្យពេចន៍ ផ្តាំផ្ញើ របស់ សម្តេច តេជោ ជូន ដល់ កម្មករ កម្ម ការិនី ព្រមទាំង បាន គូស រំលេច ពី វីរភាព និង គុណ បំណាច់ របស់ សម្តេច តេជោ ដែល ខិតខំ ដឹកនាំឱ្យ កម្ពុជា ឆ្ពោះ មកកាន់ ដំណាក់កាល សុខសាន្ត និង រីកចម្រើន ។
* ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សមិទ្ធផល ដែល កម្ពុជា មាន ថ្ងៃ នេះ គឺ បាន ពី ការប្រឹងប្រែង ជា បន្តបន្ទាប់ តាំងពី ជាង ៤០ ឆ្នាំ មុន មក ម្ល៉េះ ។
* ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ថ្នាក់ដឹកនាំ រាជ រដ្ឋាភិបាល ប្តេជ្ញា ប្រឹងប្រែង រក្សា សមិទ្ធផល ដែល អ្នក ចាស់ បន្សល់ទុក ហើយ បន្ត ប្រឹងប្រែង បង្កើត សមិទ្ធផល ថ្មី ជា បន្តបន្ទាប់ ទៀត ។
* ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ចាត់ទុក ការជួប ជាមួយ បងប្អូន កម្មករ កម្ម ការិនី នៅ តំបន់ ព្រៃ ស្ពឺ នា ពេលនេះ គឺជា និស្ស័យ ។
