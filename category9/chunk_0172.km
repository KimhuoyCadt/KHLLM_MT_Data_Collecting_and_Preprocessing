( ត្បូងឃ្មុំ ) ៖ កម្លាំង គយ ចល័ត តំបន់ ៦ ដឹកនាំ ដោយ លោក ព្រាប គារ៉ាត ប្រធាន ការិយាល័យ ស្រាវជ្រាវ និង បង្ក្រាប អំពើ រត់ ពន្ធ តំបន់ ៦ បាន ដឹកនាំ កម្លាំង ចុះបង្ក្រាប ទីតាំង ផលិត បារី ក្លែងក្លាយ ម៉ាក ESSE មួយ កន្លែង និង ឃ្លាំង ស្ដុក បារី មួយ កន្លែង ទៀត គ្មាន ច្បាប់ អនុញ្ញាត នៅ ឃុំ ដា ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ជាប់ ផ្លូវ ចូល មាត់ ច្រក ទា្វរ ភាគី ដា ។
សេចក្ដីរាយការណ៍ ពី ភ្នាក់ងារ Fresh News បាន ឲ្យដឹង ថា ប្រតិបត្តិការ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ ដោយ មាន ការចូលរួម ពី មន្ត្រី កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស . មន្ត្រី កងរាជអាវុធហត្ថ ខេត្ត . មន្ត្រី ស្នងការដ្ឋាន នគរបាល ខេត្ត ដោយ មាន ការសម្របសម្រួល ពី ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ត្បូងឃ្មុំ ជំនួស ដោយ លោក សូ សុវិទ្យា ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត ត្បូងឃ្មុំ ។
បើ តាម សេចក្ដីរាយការណ៍ នៅក្នុង ពេល ប្រតិបត្តិការ របស់ កម្លាំង សមត្ថកិច្ច មាន ឧកញ៉ា ម្នាក់ បាន ទូរស័ព្ទ មក គំរាម សមត្ថកិច្ច ដែល កំពុង អនុវត្ត តួនាទី ភារកិច្ច ប៉ុន្ដែ ការគំរាម តាម ទូរស័ព្ទ មិន មាន ប្រសិទ្ធភាព ឡើយ ពោល កម្លាំង សមត្ថកិច្ច នៅតែ បន្ដ ប្រតិបត្តិការ ហើយ អនុវត្ត វិធានការ ច្បាប់ យ៉ាង តឹងរឹង បំផុត ចំពោះ សកម្មភាព ខុស ច្បាប់ នេះ ៕
រដ្ឋមន្ត្រី អ៊ាង សុផល្លែត ចុះ ពង្រឹង ការគ្រប់គ្រង ធនធាន ធម្មជាតិ និង បរិស្ថាន នៅ ឧទ្យាន ជាតិ ព្រះសុរាម្រិត កុសុមៈ គិរីរម្យ
( កំពង់ស្ពឺ ) ៖ លោក អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ធ្វើដំណើរទស្សនកិច្ច ជួប សំណេះសំណាល ជាមួយ មន្រ្តី ឧទ្យាន ជាតិ ព្រះសុរាម្រិត កុសុមៈ គិរីរម្យ ក្នុង ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ នា ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០២៣ ម្សិលមិញ ។
ដំណើរទស្សនកិច្ច របស់ លោក រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន គឺ លើក ទី ១៖ ចុះ ពិនិត្យ ទីតាំង ដាំ កូន ឈើ . ទី ២៖ បន្ត ចូល ដុត ធូប នៅ ព្រះអង្គ គោក ធ្លក បន្ទា ទី ៣៖ ពិនិត្យមើល តំបន់ អាណាធិបតេយ្យ ក្នុង ឧទ្យាន ជាតិ គិរីរម្យ . ទី ៤៖ បន្ត មើល ទីតាំង ឧទ្យាន បោះ តង់ គិរីរម្យ និង ទី ៥៖ ចុះ ជួប ពិនិត្យមើល សហគមន៍ ចំបក់ និង សិប្បកម្ម កែច្នៃ ឬ ស្សី ។
គួរ រម្លឹក ជូន ថា ក្រសួង បរិស្ថាន បាន សម្រេច ដាំ ដើមឈើ ប្រមាណ ជិត ២ម៉ឺន ដើម នៃ ផែនការ សរុប ប្រមាណ ៣ម៉ឺន ដើម លើ ផ្ទៃដី ជាង ២ហិកតា ក្នុង បរិវេណ មជ្ឈមណ្ឌល វប្បធម៌ ព្រះពុទ្ធ សាសនា នៅ ឧទ្យាន ជាតិ ព្រះសុរាម្រិត កុសុមៈ គិរីរម្យ ៕
ប្រធានាធិបតី តួកគី ផ្ញើ សារ អបអរសាទរ ជូន ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ក្នុង ឱកាស ចូលកាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ថ្មី កម្ពុជា
ខាងក្រោម នេះ ជា សារលិខិត របស់ ប្រធានាធិបតី តួក គី៖
នាយក រដ្ឋមន្រ្តី អ៊ុយក្រែន ផ្ញើ សារ អបអរសាទរ ជូន ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ក្នុង ឱកាស ចូលកាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ថ្មី កម្ពុជា
ខាងក្រោម នេះ ជា សារលិខិត របស់ នាយក រដ្ឋមន្រ្តី អ៊ុយក្រែន៖ ដំណឹង មរណទុក្ខ ! លោក ណី លន់ រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម បាន ទទួលមរណភាព
បច្ចុប្បន្ន សព លោក ណី លន់ ត្រូវបាន ក្រុមគ្រួសារ តំកល់ទុក នៅ គេហដ្ឋាន ស្ថិត ក្នុង បុរី ពិភព ថ្មី ចំការ ដូង ១ ផ្ទះ លេខ ២៥ ផ្លូវ លេខ ០៣ ភូមិ សំបួរ សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ . ដើម្បី រៀបចំ ពិធី បុណ្យ តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា ។
ជនជាតិ ចិន មួយ ក្រុម និង ជនជាតិ វៀតណាម មួយ ក្រុម កាប់ ប្រហារ គ្នា នៅ ក្រុង ព្រះសីហនុ ត្រូវ កម្លាំង នគរបាល ចាប់ខ្លួន សរុប ១៥ នាក់
( ព្រះសីហនុ) ៖ នៅ យប់ រំលង អធ្រាត ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ កម្លាំង ការិយាល័យ នគរបាល ព្រហ្មណ្ឌ កម្រិត ធ្ងន់ បាន ទទួល ព័ត៌មាន ថា មាន ករណី ហិង្សា មួយ បាន កើតឡើង រវាង ជនជាតិ វៀតណាម និង ជនជាតិ ចិន ២ក្រុម ( ក្នុង នោះ ១ ក្រុម មាន គ្នា ម្នាក់ឯង និង ១ ក្រុម ទៀត មាន គ្នា ១២ នាក់ ) ស្ថិត នៅមុខ អាគារ កាស៊ីណូ វ៉ាង ឆាវ ជាប់ សាលា បឋមសិក្សា កម្មករ ស្ថិត នៅ ភូមិ ៤ សង្កាត់ ៤ ក្រុង - ខេត្ត ព្រះសីហនុុ ។
របាយការណ៍ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ បាន ឲ្យដឹង ថា ក្រោយពី ទទួល ដំណឹង ភ្លាម ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ ធ្ងន់ បាន ចុះ ទីតាំង កើត ហេតុ ខាងលើ និង ដោយ មាន ការសម្រសម្រួល នីតិវិធី ពី លោក ពេញ ពិសិដ្ឋ ព្រះរាអាជ្ញា រង អម សាលាដំបូង ខេត្ត ព្រះសីហនុ បាន ធ្វើ ស្រាវជ្រាវ ឆែកឆេរ នៅក្នុង អាគារ កាស៊ីណូ ខាងលើ ឃាត់ខ្លួន បាន មនុស្ស ចំនួន ១៣នាក់ ពាក់ព័ន្ធ ករណី ហិង្សា ( វាយ គ្នា ទៅ វិញ ទៅមក ) ។
( ភ្នំពេញ ) ៖ ក្រោយ ទទួលបាន តំណែង ជា រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន នៅក្នុង អាណត្តិ ទី៧ នៃ រដ្ឋសភា លោក អ៊ាង សុផល្លែត បាន ផ្តាំផ្ញើ បន្ថែម ចំពោះ ថ្នាក់ដឹកនាំ និង មន្រ្តី ក្រោម ឱវាទ ទាំងអស់ ឱ្យ សិក្សា ស្វែងយល់ បន្ថែម លើ យុទ្ធសាស្រ្ត ស៊ីជម្រៅ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ទី ១៖ ត្រូវ ដឹង . ទី ២៖ ត្រូវ ចេះ និង អនុវត្ត ឱ្យ បានជា លទ្ធផល ល្អ ប្រសើរ ក្នុង បុព្វហេតុ ជួយ ជាតិ មាតុភូមិ ។
ការផ្តាំផ្ញើ បែប នេះ របស់ លោក រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ នេះ ក្នុង ជំនួប លើក ដំបូង រវាង លោក ជាមួយ ថ្នាក់ដឹកនាំ និង មន្រ្តី ក្រោម ឱវាទ នៃ ក្រសួង បរិស្ថាន ជា លើក ដំបូង ។
នា ឱកាស នោះ ដែរ លោក អ៊ាង សុផល្លែត បាន ថ្លែង ថា ការបំពេញ ការងារ ដោយ ភាព ឆ្នៃ ប្រឌិត វាង វៃបត់បែន ទៅ តាម ជំនាញ និង មាន វិន័យ គឺជា ដើម ចម ដែល ជួយ ឱ្យ ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ គ្រប់ លំដាប់ថ្នាក់ របស់ ក្រសួង បរិស្ថាន សម្រេចបាន នូវ គោលដៅ រួម សុក្រឹតកម្ម បរិស្ថាន កិច្ច ។
លោក បាន បន្ត ថា ពីព្រោះថា ថ្នាក់ដឹកនាំ និង មន្រ្តី នៃ ក្រសួង បរិស្ថាន គឺជា តំណាង ឱ្យ ប្រជាពលរដ្ឋ ជាង ១៧លាន នាក់ ដែល ពួកគាត់ បាន ផ្តល់ឱ្យ ថ្នាក់ដឹកនាំ និង មន្រ្តី ទាំងអស់ នៃ ក្រសួង បរិស្ថាន ក្លាយជា តំណាង និង ជា អ្នកបម្រើ ឱ្យ ផលប្រយោជន៍ របស់ ពួកគាត់ ។
បុរស ដែល ទះ កំផ្លៀង នារី ម្នាក់ នៅ តាម ដងផ្លូវ គ្រាន់តែ ផ្តើម ចេញ ពី ជិះ ម៉ូតូ សាច ទឹក ដាក់ គ្នា រហូត មាន ការចែកចាយ ពេញ បណ្ដាញ សង្គម ត្រូវ កម្លាំង សមត្ថកិច្ច ឃាត់ខ្លួន បាន ហើយ
ចំពោះ ករណី នេះ ត្រូវបាន ប្រជាពលរដ្ឋ អ្នកលេង បណ្តាញ សង្គម បាន នាំគ្នា ចែកចាយ យ៉ាង ព្រោងព្រាត ។ ភ្លាម ៗ ក្រោយ មាន ហេតុការណ៍ នេះ កើតឡើង កម្លាំង សមត្ថកិច្ច បាន បើក ការស្រាវជ្រាវ រក ឃាត់ខ្លួន បុរស ម្នាក់ នេះ បាន ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News លោក ឧត្តមសេនីយ៍ ត្រី សាន សុខ សីហា អ្នកនាំពាក្យ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា បន្ទាប់ពី បាន ឃើញ វីដេអូ នៅលើ បណ្តាញ សង្គម ភ្លាម នាយ ឧត្តមសេនីយ៍ ស ថេត បាន ដាក់ បទបញ្ជា ដល់ សមត្ថកិច្ច ត្រូវ ស្រាវជ្រាវ និង តាម ឃាត់ បុរស រូប នេះ ដើម្បី នាំមក ផ្តន្ទាទោស តាម ផ្លូវ ច្បាប់ ៕
ការថ្លែង បែប នេះ របស់ លោក ហ៊ុន ម៉ានី បាន ធ្វើឡើង ក្នុង ពិធី សំណេះសំណាល និង កំណត់ ទិសដៅ ការងារ នៃ ក្រសួង មុខងារ សាធារណៈ លើក ដំបូង ក្នុង អាណត្តិ ទី៧ ជាមួយ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ក្នុង វិស័យ មុខងារ សារធារណៈ ទូទាំង រាជធានី - ខេត្ត សរុប ប្រមាណ ជាង ១០០០ នាក់ នា ព្រឹក ថ្ងៃច័ន្ទ ទី២៨ ខែសីហា ឆ្នាំ ២០២៣ ។
ពិធី សំណេះសំណាល នេះ ដែរ ត្រូវបាន រៀបចំឡើង ក្នុង គោលបំណង ដើម្បី ជួប សំណេះសំណាល និង ថ្លែងអំណរគុណ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង បំពេញ ការងារ នា អាណត្តិ កន្លងមក ក៏ ដូចជា ការកំណត់ ទិសដៅ ការងារ ជា អាទិភាព ឆ្ពោះទៅ មុខ សម្រាប់ ក្រសួង មុខងារ សាធារណៈ ។
ក្នុង ឱកាស ដ៏ ពិសេស នៃ ពិធី សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ នៃ ក្រសួង មុខងារ សាធារណៈ លោក ហ៊ុន ម៉ានី បាន ចាប់ផ្តើម ប្រសាសន៍ ដោយ ការថ្លែងអំណរគុណ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ផ្តល់ សេចក្តីទុកចិត្ត ឱ្យ កាន់ មុខតំណែង ជា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សារធារណៈ សម្រាប់ អាណត្តិ ទី៧ ។
លោក រដ្ឋមន្ត្រី ក៏ បាន គូសបញ្ជាក់ រំម្លឹក នូវ កិច្ច ខិតខំ ប្រឹងប្រែង និង សមិទ្ធផល សំខាន់ ៗ កន្លងមក ក្រោម ការដឹកនាំ ក្រសួង គ្រប់ ៗ រូប និង មន្ត្រី ទាំងអស់ នៃ ក្រសួង មុខងារ សាធារណៈ ដែល បាន បំពេញ ការងារ យ៉ាង សកម្ម ចាប់តាំងពី ការកកើត ស្ថាប័ន នេះ រហូតដល់ បច្ចុប្បន្ន ។
ជាមួយគ្នា នេះ លោក ហ៊ុន ម៉ានី បាន កំណត់ បេសកកម្ម ចម្បង ក្នុង ការដឹកនាំ ក្រសួង មុខងារ សាធារណៈ មាន ៣ ចំណុច ដូចជា ទី ១៖ ការអនុវត្ត ចក្ខុវិស័យ របស់ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា . ទី ២៖ ការជំរុញ កំណែទម្រង់ និង ពង្រឹង រដ្ឋបាល សាធារណៈ ប្រកបដោយ ប្រសិទ្ធភាព និង ប្រសិទ្ធផល ក្នុង រដ្ឋាភិបាល អាណត្តិ ទី៧ ឆ្ពោះទៅ ឆ្នាំ ២០២៨ និង អនាគត និង ( ៣៖ ចូលរួមចំណែក ក្នុង ការលើកស្ទួយ និង ការធ្វើ ទំនើបកម្ម ស្ថាប័ន សាធារណៈ ) ។
ពិធី សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ ក្រសួង មុខងារ សាធារណៈ នា ព្រឹក នេះ បាន បញ្ចប់ ដោយ ប្រកបដោយ ភាតរភាព និង សាមគ្គីភាព ព្រមទាំង ភាពជឿជាក់ យ៉ាង មុតមាំ ក្នុង ការរួមគ្នា ដោះស្រាយ បញ្ហា នានា និង ចូលរួម ក្នុង ការអនុវត្ត ការងារ កែទម្រង់ រដ្ឋបាល សាធារណៈ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា ៕
លោក ឃ្លាំង ហួត ត្រូវបាន តែងតាំង ជា ទីប្រឹក្សា របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា
សូម បញ្ជាក់ ថា បច្ចុប្បន្ន លោក ឃ្លាំង ហួត ជា សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង មាន តួនាទី ជា អភិបាល រង រាជធានី ភ្នំពេញ ផងដែរ ។
កម្លាំង ចម្រុះ ចុះបង្រ្កាប បទល្មើស ព្រៃឈើ នៅ ឃុំ វឌ្ឍនៈ ក្នុង ស្រុក សំបូរ ដកហូត ឈើ សុក្រម លេខ ១ បាន ជាង ១ម៉ែត្រ គីប
( ក្រចេះ )៖ គណៈ បញ្ជាការ ឯកភាព ស្រុក សំបូរ ដឹកនាំ ដោយ លោក គង់ មេត្តា អភិបាល ស្រុក សំបូរ នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ បាន ដឹកនាំ កម្លាំង ចុះបង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ នៅ ភូមិសាស្រ្ដ ឃុំ វឌ្ឍនៈ ស្រុក សំបូរ ខេត្ត ក្រចេះ ជា លទ្ធផល ក្រុមការងារ បាន ចុះ ចាប់ ឃាត់ ឈើ អារ លេខ ១ ( សុក្រម ) ចំនួន ២៤ ដុំ ស្មើនឹង ១.៤៤៩ ម៉ែត្រ ត្រី គុណ នៅ ភូមិសាស្ត្រ ឃុំ វឌ្ឍន : ស្រុក សំបូរ ខេត្ត ក្រចេះ ។
យោង តាម របាយការណ៍ របស់ រដ្ឋបាល ស្រុក សំបូរ បញ្ជាក់ ឲ្យដឹង ថា ក្នុង ប្រតិបត្តិការ នេះ បាន ឃាត់ គោយន្ត កន្ត្រៃ ដឹក អុស ចំនួន ០៣ គ្រឿង នៅ ចំណ ភូមិ ត្រាំ ដុំ ឃុំ វឌ្ឍន : ដែល មាន ម្ចាស់ ឈ្មោះ ១៖ ឌួន ម៉េង លីន ភេទ ប្រុស អាយុ ២០ ឆ្នាំ ២៖ ឌួន ហួង ភេទ ប្រុស អាយុ ២១ ឆ្នាំ ៣៖ ឃឿន ធី ភេទ ប្រុស អាយុ ២៥ ឆ្នាំ អ្នក ទាំង ០៣ នាក់ មាន ទីលំនៅ បច្ចុប្បន្ន នៅ ភូមិ កែង ឃុំ ជ្រោយ បន្ទាយ ស្រុក ព្រែក ប្រសព្វ ខេត្ត ក្រចេះ បាន ធ្វើ ការណែនាំឲ្យ បញ្ឈប់ សកម្មភាព ដឹកជញ្ជូន អុស ដោយ ខុស ច្បាប់ ហើយ ឲ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ ។
ដោយឡែក គោយន្ត កន្ត្រៃ ចំនួន ២គ្រឿង ដឹកជញ្ជូន អុស និង មាន រណា យន្ត ចំនួន ០២ គ្រឿង បាន ធ្វើ ការណែនាំ និង ដកហូត រណា យន្ត ពី ម្ចាស់ ឈ្មោះ ១៖ ចាន់ លាន ភេទ ប្រុស អាយុ ៤៥ ឆ្នាំ និង ឈ្មោះ ជូត ពិសី អាយុ ២៥ ឆ្នាំ អ្នក ទាំង ពីរ មាន លំនៅ បច្ចុប្បន្ន នៅ ភូមិ ជ្រោយ បន្ទាយ ឃុំ ជ្រោយ បន្ទាយ ស្រុក ព្រែក ប្រសព្វ ខេត្ត ក្រចេះ ហើយ ឲ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ ។
សូម បញ្ជាក់ ថា បន្ទាប់ពី មាន ពាក្យបណ្ដឹង របស់ ប្រជាពលរដ្ឋ អាជ្ញាធរ និង ម្ចាស់ ហាង ព្រមទាំង ប្រជាពលរដ្ឋ បាន ចូលរួម ដើម្បី ធ្វើ ការដោះស្រាយ ប៉ុន្តែ លទ្ធផល ខាង ម្ចាស់ ហាង ហាក់ដូចជា ពុំ មាន ឆន្ទៈ ក្នុង ការអនុវត្ត តាម ការណែនាំ របស់ អាជ្ញាធរ និង សំណូមពរ របស់ ប្រជាពលរដ្ឋ ។
ពាក់ព័ន្ធ ក្នុង ករណី នេះ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ អភិបាល ខណ្ឌ ចំការមន ថា បាន ធ្វើ ការសម្របសម្រួល ឱ្យ ម្ចាស់ ហាង ត្រូវ រៀបចំ យ៉ាងណា កុំ បំពង សំឡេង ខ្លាំង ប៉ះពាល់ ដល់ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ។
លោក អភិបាល ក៏ សំណូមពរ ឱ្យ ប្រជាពលរដ្ឋ ដែល រង ការរំខាន ពី ក្លឹប ទាំងនោះ អាច ទំនាក់ទំនង ទូរស័ព្ទ មក លោក ផ្ទាល់ គឺ លោក ត្រូវតែ ដឹកនាំ កម្លាំង អាជ្ញាធរ ចុះ ទៅ ពិនិត្យ ជាក់ស្ដែង ជូន ប្រជាពលរដ្ឋ ៕
រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង នាយ ឧត្តមសេនីយ៍ ស ថេត ជា អគ្គ ស្នងការ នគរបាល ជាតិ
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ នេះ លោក អភិសន្ដិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ជំនួស នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន ដែល ត្រូវបាន តែងតាំង ជា ឧប នាយក រដ្ឋមន្ដ្រី សម្រាប់ នីតិកាល ទី៧ ។
ពិធី ប្រកាស ចូលកាន់ មុខតំណែង អគ្គ ស្នងការ ថ្មី នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នេះ ត្រូវបាន ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង មហាផ្ទៃ ដែល មាន ការចូលរួម ពី អគ្គ ស្នងការ រង នគរបាល ជាតិ . ប្រធាន នាយកដ្ឋាន កណ្ដាល . អនុប្រធាន នាយកដ្ឋាន . ប្រធាន នាយកដ្ឋាន និង ស្នងការ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី - ខេត្ត ។
គួរ ជម្រាប ថា ចាប់ពី ឆ្នាំ ២០០៨ រហូតមកដល់ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២៣ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ដឹកនាំ ដោយ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន ជា អគ្គ ស្នងការ ប៉ុន្ដែ ពេល រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ដឹកនាំ ដោយ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ចូលកាន់ តំណែង នោះ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន ត្រូវបាន តែងតាំង ជា ឧប នាយក រដ្ឋមន្ដ្រី ។
ក្នុង រយៈកាល ប្រមាណ ជាង ១៥ ឆ្នាំ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ក្រោម ការដឹកនាំ របស់ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន ក៏ កសាង ស្នាដៃ និង សមិទ្ធផល សំខាន់ ៗ ជាច្រើន គួរឲ្យ កត់សម្គាល់ ពិសេស គឺ ចូលរួម ថែរក្សា ការពារ សន្ដិភាព ធានា បាន ស្ថេរភាព នយោបាយ ពិសេស សន្ដិសុខ ផ្ទៃក្នុង ការពារ បាន ប្រក្រតីភាព របស់ ស្ថាប័ន កំពូល ៗ រួមទាំង ស្ថាប័ន ព្រះមហាក្សត្រ ។
កាន់តែ សំខាន់ ទៀត នោះ គឺ ទប់ស្កាត់ និង ការពារ រាល់ ការប៉ុនប៉ង ចង់ បំផ្លាញ កម្ពុជា ពីសំណាក់ ក្រុម ឧបបាយកល ពួក អគតិ ជ្រុលនិយម ពោល សកម្មភាព ទាំងឡាយ ដែល ចង់ បំផ្លាញ សន្ដិភាព និង រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល កើត ចេញពី ការបោះឆ្នោត នេះ មិន អាច ប្រព្រឹត្តទៅ បាន នោះ ទេ ។ ជា ការកត់សម្គាល់ សមត្ថភាព របស់ កងកម្លាំង នគរបាល ជាតិ ទាំងអស់ ក៏ ត្រូវបាន ពង្រឹង និង លើកកម្ពស់ ជា បន្ដ បន្ទាប់ ដើម្បី ដើរ ឲ្យ ទាន់ ស្ថានការណ៍ សកល ដែល កាន់តែ វិវឌ្ឍន៍ ទៅ មុខ ផងដែរ ។
ដោយឡែក សម្រាប់ អគ្គ ស្នងការ ថ្មី នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ដែល ត្រូវបាន ប្រកាន់ ចូលកាន់ តំណែង នេះ គឺ នាយ ឧត្តមសេនីយ៍ ស ថេត ។ លោក ស ថេត កំពុង កាន់ មុខតំណែង ជា អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ហើយ ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តម្លើង ឋានន្ដរស័ក្ដិ ថ្នាក់ នាយ ឧត្តមសេនីយ៍ និង ជា អគ្គ ស្នងការ នគរបាល ជាតិ កាលពី ថ្ងៃទី ២៣ ខែសីហា ឆ្នាំ ២០២៣ ។
( ភ្នំពេញ ) ៖ លោកស្រី រួអេដា អិល ហាច តំណាង ការិយាល័យ ឧត្តម ស្នងការទទួលបន្ទុក សិទ្ធិ មនុស្ស ប្រចាំ កម្ពុជា បាន សាទរ ប្រទេស កម្ពុជា ដែល ជា ប្រទេស ដំបូង ដែល បាន ធ្វើ សកម្មភាព ក្នុង ការបេ្តជ្ញាចិត្ត រៀបចំ ខួប លើក ទី ៧៥ ដោយ មាន ការតែងតាំង ជន បង្គោល ក្នុង ការរៀបចំ ទិវា នេះ ព្រមទាំង សកម្មភាព ផ្សេង ៗ ទៀត ដែល នេះ បង្ហាញ ពី ការឆន្ទៈ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការលើកកម្ពស់ និង គោរព សិទ្ធិ មនុស្ស ។
នា ឱកាស នោះ ទេសរដ្ឋមន្ត្រី កែវ រ៉េមី បាន ថ្លែងអំណរគុណ លោកស្រី តំណាង OHCHR ដែល តែងតែ សហការ លើ វិស័យ សិទ្ធិ មនុស្ស កន្លងមក នេះ ហើយ យើង នឹង បន្ត សហការ ជាមួយគ្នា តទៅទៀត ។
ទេសរដ្ឋមន្ត្រី កែវ រ៉េមី បាន លើកឡើង ថា ជា ការអបអរសាទរ ខួប លើក ទី ៧៥ នេះ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន ធ្វើ ការបញ្ជ្រៀប សកម្មភាព ចំនួន ២លើក រួច មកហើយ នោះ គឺ បាន រៀបចំ សិក្ខាសាលា ចំនួន ២ ដែល ជា យុទ្ធនាការ ៣៦៥ ថ្ងៃ នោះ គឺ សិក្ខាសាលា ស្តីពី សិទ្ធិ ពលរដ្ឋ និង នយោបាយ នៅ ខេត្ត បាត់ដំបង និង ផ្សព្វផ្សាយ របាយការណ៍ ជាតិ ស្តីពី ការអនុវត្ត អនុសញ្ញា អន្តរជាតិ ស្តីពី ការលុបបំបាត់ រាល់ ទម្រង់ នៃ ការរើសអើង ពូជសាសន៍ នៅ ខេត្ត បន្ទាយមានជ័យ ។
បន្ថែម ទៅ លើ ការពិភាក្សា សម្រាប់ ការងារ រៀបចំ អបអរ ខួប លើក ទី៧៥ នេះ ភាគី ទាំង ពីរ បាន ពិភាក្សា លើ ការងារ ជា អាទិភាព របស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស ដូច ជា៖
ទី១៖ ការដាក់ ប្រអប់ បណ្តឹង របស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស នៅ តាម ពន្ធនាគារ ក្នុង រាជកធានី ភ្នំពេញ ដែល ជា យន្តការ មួយ ដ៏ មាន ប្រសិទ្ធិភាព សម្រាប់ អោយ ជន ជាប់ ឃុំ អាច រាយការណ៍ ពី ករណី រំលោភ សិទ្ធិ មនុស្ស នៅក្នុង ពន្ធនាគារ បាន ។
២៖ ការដាក់ ឱ្យ ប្រើប្រាស់ ការទទួល ពាក្យបណ្តឹង តាម ប្រព័ន្ធ ទូរស័ព្ទ ដៃ (CHRC Apps) របស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ដើម្បី សម្រួល ដល់ ការដាក់ ពាក្យ បណ្តឹង របស់ ប្រជាពលរដ្ឋ នៅ តាម បណ្តា រាជធានី ខេត្ត ។
៤៖ ការរៀបចំ បង្កើត គណៈកម្មាធិការ ជាតិ សិទ្ធិ មនុស្ស មួយ ដែល ឯករាជ្យ ស្រប តាម គោលការណ៍ ទីក្រុង ប៉ារីស ដែល គ្រោង នឹង បង្កើត នៅពេល ខាងមុខ ។
លោកស្រី តំណាង ការិយាល័យ ឧត្តម ស្នងការទទួលបន្ទុក សិទ្ធិ មនុស្ស ប្រចាំ កម្ពុជា សង្ឃឹម នឹង សំណូមពរ ឱ្យ រក្សា គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បច្ចុប្បន្ន ដោយ យោង ទៅ លើ ភាពចាំបាច់ បើ ទោះជា គណៈកម្មាធិការ ជាតិ សិទ្ធិ មនុស្ស ត្រូវបាន បង្កើតឡើង ក៏ដោយ ។
លោកស្រី រួអេដា អិល ហាច បាន សង្ឃឹម ថា ស្ថាប័ន ទាំង ពីរ នឹង សហការ ជាមួយគ្នា ដើម្បី លើកកម្ពស់ និង ពង្រឹង ស្ថានភាព សិទ្ធិ មនុស្ស នៅ កម្ពុជា ។
គួរ បញ្ជាក់ ផងដែរ ថា គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា និង ការិយាល័យ ឧត្តម ស្នងការទទួលបន្ទុក សិទ្ធិ មនុស្ស ប្រចាំ កម្ពុជា នឹង រៀបចំ សិក្ខាសាលា ដើម្បី ផ្សព្វផ្សាយ ពី របាយការណ៍ សិទ្ធិ សេដ្ឋកិច្ច សង្គមកិច្ច និង វប្បធម៌ ព្រមទាំង កិច្ចពិគ្រោះយោបល់ លើ របាយការណ៍ ត្រួតពិនិត្យ ជា សកល តាម កាល កំណត់ (UPR) នា ពេល ខាងមុខ ។
ជា កិច្ច បញ្ចប់ ទេសរដ្ឋមន្ត្រី បាន ជម្រាប ទៅកាន់ តំណាង ការិយាល័យ ឧត្តម ស្នងការទទួលបន្ទុក សិទ្ធិ មនុស្ស ប្រចាំ កម្ពុជា ថា លោក មាន ជំនឿ ជឿជាក់ ទៅ លើ សមាសភាព រាជ រដ្ឋាភិបាល ដោយសារតែ លោក ជឿជាក់ លើ សមត្ថភាព ដឹកនាំ របស់ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ក្នុង ការដឹកនាំ រាជ រដ្ឋាភិបាល ជាពិសេស លើ វិស័យ សិទ្ធិ មនុស្ស នេះ តែម្តង ៕ គណៈប្រតិភូ តំណាង អនុសញ្ញា អូតា វ៉ា គាំទ្រ ទស្សនវិស័យ និង ការប្តេជ្ញាចិត្ត របស់ ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត ក្នុង ការដោះស្រាយ បញ្ហា មីន នៅ កម្ពុជា
ក្នុង ជំនួប ជាមួយ ទេសរដ្ឋមន្ត្រី លី ធុជ នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ នាទី ស្នាក់ការ អាជ្ញាធរ មីន លោក ក៏ បាន សម្តែង នូវ អំណរ សាទរ ជូន ចំពោះ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ដែល ត្រូវ សភា បោះឆ្នោត ជ្រើសរើស ឱ្យ ធ្វើជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា សម្រាប់ នីតិកាល ទី៧ នៃ រដ្ឋសភា ។
ក្នុង នាម ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន អាជ្ញាធរ មីន លោក ទេសរដ្ឋមន្រ្តី លី ធុជ បាន ថ្លែងអំណរគុណ ISU-APMBC ដែល តែងតែ ផ្តល់ ការគាំទ្រ ដល់ កម្ពុជា ក្នុង ការរៀបចំ ផែនការបោសសម្អាត មីន ឱ្យ សម្រេចបាន នូវ កាតព្វកិច្ច នៃ អនុសញ្ញា អូតា វ៉ា ក្នុង នាម កម្ពុជា ជា រដ្ឋ ភាគី ។
( ភ្នំពេញ ) ៖ បន្ទាប់ពី បាន ចូលកាន់ តំណែង ជា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល ក្នុង អាណត្ដិ ទី៧ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា នៅ ថ្ងៃទី ២៥ - ២៨ ខែសីហា ឆ្នាំ ២០២៣ បាន ដឹកនាំ គណៈប្រតិភូ សុខាភិបាល ចុះ ពិនិត្យ ស្ថានភាព មូលដ្ឋាន សុខាភិបាល នៅ តាម បណ្ដា ខេត្ដ នៅ ជុំវិញ បឹង ទន្លេ សាប ។
លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី បាន ថ្លែង បន្ត ថា លោក នឹង បន្ត ដឹកនាំ ក្រុមការងារ សុខាភិបាល ចុះ ពិនិត្យមើល ស្ថានភាព មូលដ្ឋាន សុខាភិបាល នៅ ទូទាំង ប្រទេស តែ ជា ជំហាន ដំបូង នេះ គឺ ចុះ នៅ ខេត្ត ជុំវិញ បឹង ទន្លេ រ សាប ដូចជា ខេត្ដ កំពង់ឆ្នាំង ពោធិ៍សាត់ បាត់ដំបង បន្ទាយមានជ័យ សៀមរាប និង កំពង់ធំ ។
បរធន បាល បរធន បាល ទាយក ឬ អ្នក ផ្ដល់ វិភាគទាន បរធន បាលកិច្ច បុគ្គល ផ្ដល់ សេវា ពាក់ព័ន្ធ ក្នុង វិស័យ បរធន បាលកិច្ច និង សាធារណជន ទាំងអស់ ដែល មាន បំណង ប្រើប្រាស់ សេវា វាយតម្លៃ ក្នុង វិស័យ បរធន បាលកិច្ច អាច ទំនាក់ទំនង ទៅកាន់ ក្រុមហ៊ុន អ៊ីនវ៉ា រៀល អ៊ីស្ទេត អ៊ិន វេសម៉ិន អេន វ៉ាលូ អេ សិន ឯ . ក ៕ មូលនិធិ ជាតិ ជំនួយ សង្គម ជូនដំណឹង ពី ការបើកប្រាក់ សោធន របប សន្តិសុខ សង្គម លើក ទី២ ប្រចាំ ខែសីហា ឆ្នាំ ២០២៣ ជូន អតីត យុទ្ធជន អតីត មន្ត្រីរាជការ ស៊ីវិល និង អ្នក នៅក្នុង បន្ទុក នា ថ្ងៃទី ២៩ ខែសីហា
ការបើក ផ្តល់ ធ្វើឡើង តាមរយៈ ប្រព័ន្ធ ធនាគារ ដៃគូ ដូច ខាងក្រោម៖ ១៖ សម្រាប់ អតីត យុទ្ធជន អតីត មន្ត្រីរាជការ ស៊ីវិល និង អ្នក នៅក្នុង បន្ទុក ដែល មាន អាសយដ្ឋាន នៅ រាជធានី ភ្នំពេញ អាច ទៅ បើក ប្រាក់ សោធន បាន តាម ប្រព័ន្ធ ធនាគារ កាណាឌីយ៉ា ក. អ. នៅ គ្រប់ សាខា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ទូទាំង ប្រទេស ដោយ ត្រូវ យក ភ្ជាប់ មក ជាមួយ នូវ សៀវភៅ គណនី របស់ ធនាគារ កាណាឌីយ៉ា ក. អ. និង អត្តសញ្ញាណប័ណ្ណ សញ្ញាតិ ខ្មែរ ឬ កាត អេធី អឹម ( ប្រើ តាម ទូ ATM) ។
( ព្រះសីហនុ) ៖ នៅ យប់ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០២៣ កម្លាំង ជំនាញ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ បាន ទទួល ព័ត៌មាន ថា មាន ជនសង្ស័យ មួយ ក្រុម ជិះ រថយន្ត៣ គ្រឿង បាន ធ្វើ សកម្មភាព ចាប់ បុរស ជនជាតិ ចិន ម្នាក់ ចេញ ពី ផ្ទះ វីឡា មួយ កន្លែង ដែល មាន ទីតាំង ស្ថិត នៅ ភូមិ ៥ សង្កាត់ ៤ ក្រុង ព្រះសីហនុ ។
បន្ទាប់ពី ទទួលបាន ព័ត៌មាន នេះ ភ្លាម កម្លាំង ជំនាញ ផែនការងារ នគរបាល ព្រហ្មទណ្ឌ បាន សហការ ជាមួយ កម្លាំង អធិការដ្ឋាន នគរបាល ក្រុង ព្រះសីហនុ និង កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក ព្រៃនប់ ធ្វើ ការស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ រហូតដល់ វេលា ម៉ោង ១០៖៣០ នាទី យប់ ថ្ងៃ ដដែល កម្លាំង ជំនាញ បាន ទទួល ព័ត៌មាន ថា ជនរងគ្រោះ ត្រូវបាន ក្រុម ជនសង្ស័យ ដោះលែង ដោយ ជនរងគ្រោះ រងរបួស បន្តិចបន្តួច ហើយ កំពុង ព្យាបាល នៅ មន្ទីពេទ្យ ថៃ ខាង ទើប កម្លាំង សមត្ថកិច្ច បាន ទៅ ជួប ជនរងគ្រោះ ។
ក្រោយ បាន ចូល ត្រួតពិនិត្យ កម្លាំង សមត្ថកិច្ច បាន រកឃើញ ជញ្ជីង ថ្លឹង២ គ្រឿង និង ថង់ សម្រាប់ វេចខ្ចប់ មួយចំនួន ( សង្ស័យ សម្រាប់ ថ្លឹង និង វេចខ្ចប់ សារធាតុ ញៀន ) នៅក្នុង បន្ទប់ របស់ បុរស ជនជាតិ ចិន ម្នាក់ នោះ ទើប ឃាត់ខ្លួន យកមក ធ្វើ ការសាកសួរ ។ ចំពោះ ករណី នេះ ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល កំពុង បន្ត នីតិវិធី ៕
តំបន់ សាង ស៊ី (Sangzhi) បាន កត់ត្រា កម្រិត ទឹកភ្លៀង ខ្ពស់ បំផុត ក្នុង ឆ្នាំ ២០២៣ នេះ ជាមួយ កម្រិត ទឹកភ្លៀង អតិបរមា ២៥៦ មីលីម៉ែត្រ កាលពី យប់ ថ្ងៃសៅរ៍ ដល់ ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ ហើយ នេះ គឺជា កម្រិត ទឹកភ្លៀង ច្រើន មិន ធ្លាប់ មាន ក្នុង តំបន់ មួយ នេះ ចាប់តាំងពី ឆ្នាំ ១៩៩៨មក ។
នាយក រដ្ឋមន្ត្រី ថ្មី កម្ពុជា ទទួល ជួប ឯក អគ្គ រដ្ឋទូត សហភាព អឺរ៉ុប ប្រចាំ កម្ពុជា ដែល ចប់ អាណត្តិ
នេះ គឺជា ជំនួប ជាមួយ តំណាង ភាគី បរទេស លើក ដំបូង បន្ទាប់ពី ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ឡើង កាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ថ្មី របស់ កម្ពុជា នៅក្នុង អាណត្តិ ទី ៧នេះ ៕
ឯកឧត្តម វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី ប្រធានាធិបតី អ៊ុយក្រែន ផ្ញើ សារ អបអរសាទរ ជូន ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ក្នុង ឱកាស ចូលកាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ថ្មី កម្ពុជា
ខាងក្រោម នេះ ជា សារលិខិត របស់ ឯកឧត្តម វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី ប្រធានាធិបតី អ៊ុយក្រែន៖ មុខ សញ្ញា លួច ម៉ូតូ នៅ ក្រុង ព្រះសីហនុ ត្រូវ កម្លាំង នគរបាល ស្រាវជ្រាវ ចាប់ខ្លួន បាន
( ព្រះសីហនុ) ៖ មុខ សញ្ញា លួច ម៉ូតូ ម្នាក់ នៅ ក្រុង ព្រះសីហនុ ត្រូវបាន កម្លាំង នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ ធ្វើ ការស្រាវជ្រាវ និង ឈានដល់ ការចាប់ខ្លួន បាន នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០២៣ ។
បន្ទាប់ពី ទទួលបាន បណ្តឹង របស់ ជនរងគ្រោះ កម្លាំង ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល បាន ធ្វើ ការស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ រហូតដល់ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០២៣ បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ដែល ជា បក្ខពួក នៅ ចំណុច កាស៊ីណូ ឈ្មោះ DV ស្ថិត នៅ ភូមិ ៤សង្កាត់ ៤ ក្រុង ព្រះសីហនុ ។ ពេល ដែល សមត្ថកិច្ច កំពុង ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ក៏ មាន បក្ខពួក បងប្អូន របស់ ជន ស្ស័យ បាន រារាំង សម្ថកិច្ច និង បាន ប្រតាយ ប្រតប់ និង រឹតកសម្ថកិច្ច បណ្តា ឲ្យ រងរបួស ស្រាល ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង និង ផ្ដល់ ឋានៈ ទីប្រឹក្សា និង ជំនួយការ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី ចំនួន ៩៧ រូប
អាវុធហត្ថ ខេត្ត ស្វាយរៀង ចាប់ខ្លួន មនុស្ស ៩នាក់ ពាក់ព័ន្ធ ករណី ចាប់បង្ខាំង មនុស្ស ដោយ ខុស ច្បាប់ នៅ ក្រុង បាវិត
( ស្វាយរៀង ) ៖ មនុស្ស ៩នាក់ ក្នុង នោះ ជនជាតិ ខ្មែរ ៨នាក់ និង វៀតណាម ម្នាក់ ត្រូវបាន កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ស្វាយរៀង ចាប់ខ្លួន និង បញ្ជូន ទៅ សាលាដំបូង ខេត្ត នៅ ថ្ងៃទី ២៦ ខែសីហា ឆ្នាំ ២០២៣ ពាក់ព័ន្ធ ករណី ចាប់ ឃុំឃាំង និង បង្ខាំង មនុស្ស ដោយ ខុស ច្បាប់ ។
វត្ថុតាង ដកហូត រួម មាន ទូរស័ព្ទដៃ ចំនួន ១០គ្រឿង . រថយន្ត ចំនួន ០២ គ្រឿង . ពិល ឆក់ ចំនួន ០៣. ដំបង ឈើ ចំនួន ០១. កូន កាំបិត ចំនួន ០១. ថ្នាំ ក្រាម សថ្លា ចំនួន ០១ កញ្ចប់ និង សម្ភារៈ ប្រើប្រាស់ គ្រឿងញៀន មួយចំនួន ។ បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង បញ្ជូន ទៅ តុលាការ ខេត្ត ស្វាយរៀង អនុវត្ត តាម នីតិវិធី ៕
ព្រឹត្តិការណ៍ នេះ មាន ការចូលរួម បណ្តា ប្រទេស ចិន ជប៉ុន ឥណ្ឌា អេហ្ស៊ីប ឥណ្ឌូនេស៊ី ម៉ាឡេស៊ី ថៃ វៀតណាម ម៉ុងហ្គោលី នេប៉ាល់ ស្រីលង្កា ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន . លោក ហេង សួរ រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ព្រមទាំង បណ្តាល ថ្នាក់ដឹកនាំ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ក្រុម ទាំង ថ្នាក់ដឹកនាំ ក្រុម បច្ចេកវិទ្យា មួយចំនួន ផងដែរ ។
លោក នេត្រ ភក្ត្រា បាន ថ្លែង នេះ ពិតជា មាន មោទនភាព យ៉ាង ក្រៃលែង ដែល កម្ពុជា បាន ទទួល សិទ្ធិ ធ្វើជា ម្ចាស់ ផ្ទះ ក្នុង ការរៀបចំ ការប្រកួតប្រជែង រ៉ូបូត ថ្នាក់ អន្តរជាតិ ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា ព្រះរាជាណាចក្រ កម្ពុជា សម្រេចបាន នូវ សមិទ្ធផល ជា ប្រវត្តិសាស្ត្រ ជាច្រើន ដូចជា ព្រឹត្តិការណ៍ កីឡា ស៊ីហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម និង ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ជាដើម ដែល នេះ ដោយសារតែ កត្តា សុខ សន្តិភាព យ៉ាង ពេញលេញ ។
លោក ហេង សួរ បាន បង្ហាញ ក្តី សប្បាយរីករាយ ដែល វិទ្យាស្ថាន ពហុ បច្ចេកវិទ្យា កម្ពុជា (NPIC) និង វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា (ITC) ជា តំណាង ឱ្យ ប្រទេស កម្ពុជា សម្រាប់ ការប្រកួត ក្នុង ព្រឹត្តិការណ៍ កម្រិត អន្តរជាតិ ។
លោក បាន ចាត់ទុក ថា នេះ ជា មោទនភាព ដែល បាន ឃើញ ប្អូន ៗ និស្សិត របស់ យើង បាន បញ្ចេញ សមត្ថភាព ប្រកួតប្រជែង កម្រិត អន្តរជាតិ ដែល ជា ការបញ្ជាក់ ឱ្យ ឃើញ ពី ចក្ខុវិស័យ ដ៏ ត្រឹមត្រូវ ឥត ខ្ចោះ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន ផ្តល់ អាទិភាព វិនិយោគ លើ វិស័យ អប់រំ និង វិស័យ បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
បន្ថែម ពី នេះ លោក ក៏ បាន លើកទឹកចិត្ត ថា « បើ ទោះបី និស្សិត របស់ យើង មិន ទទួលបាន ជ័យលាភី ក្នុង ការប្រកួត ក្តី ប៉ុន្តែ ការឡើង មកដល់ វគ្គ ជម្រុះ ៨ ក្រុម ចុងក្រោយ នេះ បាន បង្ហាញ ថា និស្សិត យើង មាន សមត្ថភាព ខ្ពស់ និង ត្រដំត្រសង ជាមួយនឹង និស្សិត បណ្តា ប្រទេស ធំ ៗ ដែល មាន បច្ចេកវិទ្យា ជឿនលឿន រួចទៅហើយ ។ ខ្ញុំ ក៏ សូម ជូនពរ ដល់ និស្សិត របស់ យើង ដែល បាន ចូលរួម ប្រកួត នៅ ថ្ងៃ នេះ ឱ្យ មាន សុខភាព ល្អ ហើយ មិន ត្រូវបាក់ទឹកចិត្ត នោះ ទេ » ។
ព្រឹក ថ្ងៃ នេះ ព្រះមហាក្សត្រ និង សម្តេច ម៉ែ យាង ទៅ ពិនិត្យ ព្រះរាជ សុខភាព នៅ ទីក្រុង ប៉េកាំង ប្រទេស ចិន
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា និង ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ទ្រង់ យាង ទៅ ពិនិត្យ ព្រះរាជ សុខភាព នៅ ទីក្រុង ប៉េកាំង ប្រទេស ចិន ចាប់ពី ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២៣ ។ នេះ បើ តាម ព្រះរាជ សារ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
នៅក្នុង ឱកាស ព្រះរាជ អវត្តមាន របស់ ព្រះអង្គ នៅក្នុង ប្រទេស នេះ ព្រះករុណា ជា អម្ចាស់ ជីវិត តម្កល់ លើ ត្បូង ទ្រង់ ប្រគល់ ភារកិច្ច ជូន សម្ដេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា ទទួល ជួយ ព្រះអង្គ បំពេញ តួនាទី ជា ប្រមុខរដ្ឋ ស្តីទី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
នៅក្នុង ឱកាស នេះ ព្រះករុណា ជា អម្ចាស់ ជីវិត តម្កល់ លើ ត្បូង ទ្រង់ បាន ថ្វាយ ព្រះពរ សម្ដេច ព្រះមហាសង្ឃរាជ ទាំង ពីរ គណៈ សូម ប្រគេន ពរ ព្រះថេរានុត្ថេរៈ គ្រប់ ព្រះអង្គ និង សូម ជូនពរ សម្តេច ឯកឧត្តម លោកជំទាវ អស់ លោក លោកស្រី លោក តា លោកយាយ មាមីង បងប្អូន ក្មួយ ៗ ជន រួម ជាតិ ទាំងអស់ សូម បាន ប្រកប តែ នឹង ព្រះពុទ្ធ ពរ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០២៣ !
( បាត់ដំបង - បន្ទាយមានជ័យ )៖ មួយ ថ្ងៃ ពេញ នៃ បេសកកម្ម នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០២៣ នេះ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន ដឹកនាំ គណៈប្រតិភូ និង ក្រុមការងារ បច្ចេកទេស សុខាភិបាល ចុះ ពិនិត្យ ការផ្តល់ សេវា សុខាភិបាល មូលដ្ឋាន នៅ មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ បង្អែក ព្រមទាំង សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ និង មន្ត្រី - បុគ្គលិក ក្នុង ខេត្ត បាត់ដំបង និង បន្ទាយ ជ័យ ផងដែរ ។
ក្នុង ឳកាស នោះ លោក រដ្ឋមន្ដ្រី ឈាង រ៉ា បាន ថ្លែង ថា ក្នុង នាម លោក ជា អ្នកបន្ដ វេន ក្នុង ការដឹកនាំ ក្រសួង សុខាភិបាល ក្នុង អណត្ដិ ទី ៧នេះ លោក នឹង ខិតខំ ប្រឹងប្រែង ដំណើរការងារ ឱ្យ បាន ប្រសើរឡើង ដើម្បី ជា ការដឹងគុណ ដល់ ថ្នាក់ដឹកនាំ ជំនាន់ មុន ដែល បាន អនុវត្ដន៍ ការងារ កន្លងមក ។ ដូច្នេះ វិធីសាស្ត្រ បន្ដ ទៅ នេះ លោក សាស្ដ្រាចារ្យ បាន អំពាវនាវ ដល់ មន្ដ្រី បុគ្គលិក ត្រូវតែ បុរេសកម្ម និង ពួត ដៃ គ្នា ដើម្បី បម្រើ ប្រជាពលរដ្ឋ ។
លោក សាស្ដ្រាចារ្យ បន្ដ ថា សុខភាព ជា គោលដៅ សំខាន់ ដែល ប្រជាពលរដ្ឋ ទន្ទឹម រង់ចាំ ព្រោះ សុខភាព ជា ទ្រព្យសម្បត្ដិ ដ៏ មាន តម្លៃ សម្រាប់ ពលរដ្ឋ យើង ។ ដើម្បី សម្រេច ជោគជ័យ លើ វិស័យ សុខាភិបាល នេះ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា បាន ផ្ដល់ អនុសាសន៍ ដល់ មន្រី្ដ - បុគ្គលិក ដើម្បី អនុវត្ត ដូច ជា៖
៦៖ ធ្វើឱ្យ កាន់តែ ប្រសើរឡើង ការពិនិត្យ ព្យាបាល ទូលំទូលាយ នៅក្នុង សហគមន៍ ក៏ ដូចជា ធ្វើឱ្យ កាន់តែ ប្រសើរឡើង កម្មវិធី គាំពារ សង្គម ដូចជា ប.ស. ស មូលនិធិ សមធម៌ ។
លោក រដ្ឋមន្ដ្រី បាន បន្ដ ទៀត ថា អាទិភាព មួយ ក្នុង ចំណោម អាទិភាព ទាំងឡាយ សម្រាប់ អាណត្តិ ទី៧នេះ គឺ សេវា ថែទាំ ដែល នឹង ត្រូវ ធ្វើឱ្យ កាន់តែ ប្រសើរ ថែម ទៀត ដោយ នៅ ចំពោះមុខ នេះ ក្រសួង នឹង អនុវត្ត ផែនការ សកម្មភាព ចំនួន ៣ រួម មាន៖ * ពង្រឹង មណ្ឌល សុខភាព ដោយ កែលម្អ អគារ បំពាក់ សម្ភារៈ បរិក្ខារ បន្ថែម រួមទាំង ការផ្គត់ផ្គង់ ឱសថ ពង្រឹង សមត្ថភាព បុគ្គលិក ដើម្បី ធានា ការ ផ្តល់ សេវា ២៤ ម៉ោង
ប្រតិបត្តិការ រជម្លៀស ប្រជាជន នៅតែ បន្ត នៅ តំបន់ រងគ្រោះ ដោយ ទឹក ជំនន់ ក្នុង ខេត្ត Punjab ប្រទេស ប៉ាគីស្ថាន ខណៈ មនុស្ស ជាង ២៥០.០០០ នាក់ ហើយ ត្រូវបាន ជម្លៀស
( អ៊ីស្លា ម៉ា បាដ) ៖ ក្រុម អ្នក ជួយសង្គ្រោះ បាន បន្ត ជម្លៀស ប្រជាជន ចេញ ពី តំបន់ រងគ្រោះ ដោយ ទឹក ជំនន់ ក្នុង ខេត្ត Punjab របស់ ប្រទេស ប៉ាគីស្ថាន រហូតដល់ ចុង សប្តាហ៍ នេះ ដែល រហូតមកដល់ ពេលនេះ មនុស្ស ប្រហែល ២៥០.០០០ នាក់ បាន ផ្លាស់ប្តូរ ទៅកាន់ ទីតាំង ដែល មាន សុវត្ថិភាព ជាង ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០២៣ ។
អាជ្ញាធរ ប៉ាគីស្ថាន បាន និង កំពុង ជម្លៀស ប្រជាជន នៅក្នុង ខេត្ត នេះ បន្ទាប់ពី ប្រទេស ជិតខាង ឥណ្ឌា បាន បង្វែរ ទឹក ចេញ ពី អាង ស្តុក ទឹក របស់ ខ្លួន ក្នុង រដូវ មូសុង នេះ ហើយ បាន ពង្រីក ប្រតិបត្តិការ ជួយសង្គ្រោះ នៅ ពេល ដែល ទន្លេ Sutlej ចាប់ផ្តើម ហក់ ឡើង និង បាន ជន់ លិច ស្រុក មួយចំនួន នៅក្បែរ នោះ ។
មន្ត្រី អាជ្ញាធរ គ្រប់គ្រង គ្រោះមហន្តរាយ ជាតិ បាន និយាយ ថា « ប៉ូលិស និង រដ្ឋបាល ស្រុក កំពុង ធ្វើ ការជម្លៀស ប្រជាជន ទៅ កន្លែង មាន សុវត្ថិភាព ហើយ ធនធាន ដែល អាច មាន ទាំងអស់ ត្រូវបាន ប្រើប្រាស់ ដើម្បី ការពារ អាយុជីវិត និង ទ្រព្យសម្បត្តិ របស់ មហាជន » ។
យោង តាម អាជ្ញាធរ ដដែល នេះ បាន ឱ្យដឹង ទៀត ថា យ៉ាងហោចណាស់ មនុស្ស ២១៣ នាក់ បាន ស្លាប់ នៅក្នុង ប្រទេស ប៉ាគីស្ថាន នៅក្នុង ឧបទ្ទវហេតុ ដែល ទាក់ទង នឹង ភ្លៀង ធ្លាក់ ខ្លាំង ចាប់តាំងពី ការចាប់ផ្តើម រដូវ មូសុង នៅ ចុង ខែមិថុនា ។ មនុស្ស ប្រហែល ២៥០.០០០ នាក់ ត្រូវបាន ជម្លៀស ចេញ ពី តំបន់ រងគ្រោះ ខណៈ ដែល អាជ្ញាធរ បាន ចល័ត ទូក និង បុគ្គលិក រាប់ រយ នាក់ សម្រាប់ កិច្ច ខិតខំ ប្រឹងប្រែង ជួយសង្គ្រោះ ។
គួរ បញ្ជាក់ ថា កាលពី ឆ្នាំ មុន ប្រទេស ប៉ាគីស្ថាន ត្រូវបាន បំផ្លិចបំផ្លាញ ដោយ គ្រោះ ទឹក ជំនន់ ដ៏ អាក្រក់ ដែល មិន ធ្លាប់ មាន ពីមុន មក ជាច្រើន សប្តាហ៍ ដោយ មួយ ភាគ បី នៃ ផ្ទៃ ប្រទេស ត្រូវបាន ជន់ លិច និង បង្ក ផល ប៉ះពាល់ ដល់ មនុស្ស ចំនួន ៣៣ លាន នាក់ និង បាន ឆក់ យក ជីវិត មនុស្ស ១. ៧៣៩ នាក់ ។ ទឹក ជំនន់ ក៏ បាន បង្ក ការខូចខាត ដល់ សេដ្ឋកិច្ច ប៉ាគីស្ថាន ដែល មាន តម្លៃ ៣០ ពាន់ លាន ដុល្លារ ផងដែរ ៕
រដ្ឋមន្ត្រី អភិវឌ្ឍន៍ ជនបទ ជំរុញឱ្យ មន្ត្រី ខិតខំ ពង្រីក ស្នាដៃ និង សមិទ្ធផល ថ្មី បន្ថែម ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧
( សៀមរាប ) ៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្រ្ដី ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន ផ្ដល់ អនុសាសន៍ ជំរុញឱ្យ មន្ត្រីរាជការ នៃ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ទាំងឡាយ ត្រូវ ខិតខំ បំពេញ តួនាទី និង ភារកិច្ច ក្នុង ការពង្រីក ស្នាដៃ និង សមិទ្ធផល ថ្មី បន្ថែម ទៀត ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ។
នា រសៀល ថ្ងៃ ដដែល លោក រដ្ឋមន្រ្ដី និង ប្រតិភូ អម ដំណើរ បាន ជួប សំណេះសំណាល និង សួរសុខទុក្ខ ជាមួយ ថ្នាក់ដឹកនាំ និង មន្រ្ដី រាជការ នៅ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត សៀមរាប ក្រោម បរិយាកាស ភាតរភាព និង ស្និទ្ធស្នាល បំផុត ។
ក្នុង ឱកាស នោះ លោក រដ្ឋមន្រ្តី បាន ណែនាំ ដល់ មន្ត្រី មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត នូវ អនុសាសន៍ ចំនួន ៣ចំណុច សំខាន់ ៗ ដូច ខាងក្រោម៖
១. ផ្អែក លើ សមិទ្ធផល ដែល មាន ស្រាប់ ក្នុង នីតិកាល កន្លងមក ត្រូវ ខិតខំ បំពេញ តួនាទី និង ភារកិច្ច ក្នុង ការពង្រីក ស្នាដៃ និង សមិទ្ធផល ថ្មី បន្ថែម ទៀត ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ។
២. ត្រូវ ខិតខំ ធ្វើជា សេនាធិការ ដ៏ ល្អ ដល់ រដ្ឋបាល ខេត្ត និង ពង្រឹង កិច្ឋសហប្រតិបត្តិការ ជាមួយ ស្ថាប័ន ពាក់ព័ន្ធ ។
៣. រក្សា សាមគ្គីភាព ផ្ទៃក្នុង ឱ្យ កាន់តែ រឹងមាំ និង ស្អិត ល្មួត ថែម ទៀត ។
គួរ ជម្រាប ថា តំបន់ អភិវឌ្ឍន៍ ភូមិ ធម្មជាតិ រុន តា ឯក និង តំបន់ អភិវឌ្ឍន៍ តំបន់ ពាក់ ស្នែង ជា តំបន់ អភិវឌ្ឍន៍ ដ៏ សំខាន់ ដែល រាជ រដ្ឋាភិបាល បាន រៀបចំឡើង សម្រាប់ ប្រជាជន ដែល ស្ម័គ្រចិត្ត ផ្លាស់ ពី តំបន់ បេតិកភណ្ឌ អង្គរ មក តាំង ទីលំនៅ ថ្មី នៅ តំបន់ ទាំង ពីរ នេះ ៕
លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ អាជ្ញាធរ ជាតិ ទទួលបន្ទុក កិច្ចការ ព្រំដែន នៃ ទីស្តីការ គណៈ រដ្ឋមន្រ្តី ប្រកាស បដិសេធ និង ច្រានចោល ទាំងស្រុង ចំពោះ ការចុះផ្សាយ របស់ RFA ពាក់ព័ន្ធ នឹង ព្រែក កំពង់ស្វាយ (Video inside)
( ភ្នំពេញ ) ៖ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី បាន ចេញ សេចក្តីប្រកាស បដិសេធ និង ច្រានចោល ទាំងស្រុង ចំពោះ ការចុះផ្សាយ របស់ វិទ្យុ អាស៊ី សេរី កាលពី ថ្ងៃទី ២៦ ខែសីហា ឆ្នាំ ២០២៣ ជាមួយនឹង អត្ថបទ មួយ ក្រោម ចំណងជើង ថា « ពលរដ្ឋ សោកស្តាយ ព្រែក មួយ ដែល ខ្មែរ ក្រហម ជីក បាត់បង់ ទៅ វៀតណាម ក្រោយ បោះ បង្គោល ព្រំដែន » ។
ទីស្តីការ គណៈ រដ្ឋមន្ត្រី បាន សម្ដែង ការសោកស្តាយ ជា ទីបំផុត ចំពោះ ការផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត គ្មាន មូលដ្ឋាន ខ្វះ ការយល់ដឹង ធ្វើឡើង ក្នុង ចេតនា ទុច្ចរិត និង បំភាន់ សាធារណជនជាតិ និង អន្តរជាតិ ។
ទីស្តីការ គណៈ រដ្ឋមន្ត្រី សូម ធ្វើ ការបំភ្លឺ និង បញ្ជាក់ ជូន សាធារណជនជាតិ - អន្តរជាតិ និង ជន រួម ជាតិ ទាំង ក្នុង និង ក្រៅ ប្រទេស ដូច ខាងក្រោម៖
លោក ហ៊ុន ម៉ានី បាន បំពេញ ការសន្យា ជូន អ្នកគាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា នៅ ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០២៣ នេះ លោក ហ៊ុន ម៉ានី អនុប្រធាន ទី១ នៃ ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ បាន បន្ត អញ្ជើញ ជួប សំណេះសំណាល និង ថ្លែងអំណរគុណ ជូន ដល់ ក្រុមការងារ រចនាសម្ព័ន្ធ គណៈកម្មាធិការ គណបក្ស និង សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ឃុំ ជង្រុក ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ ដើម្បី អបអរសាទរ ជ័យជម្នះ ជា រួម របស់ គណបក្ស ប្រជាជន កម្ពុជា ទូទាំង ប្រទេស និង ដោយឡែក សម្រាប់ ឃុំ ដែល ទទួលបាន ជ័យជម្នះ លេខ១ ក្នុង ស្រុក គងពិសី ។
ក្រោម បរិយាកាស ប្រកបដោយ ភាពស្និទ្ធស្នាល នៃ ជំនួប នេះ លោក ហ៊ុន ម៉ានី បាន ផ្ដាំផ្ញើ ការសួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន រួមទាំងប្រសាសន៍ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ផងដែរ ។
លោក ហ៊ុន ម៉ានី បាន ថ្លែងអំណរគុណ ដល់ គណៈកម្មការ ចុះ ជួយ ឃុំ ជង្រុក ក្រុមការងារ រួមទាំង សមាជិក សមាជិកា បក្ស ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង លះបង់ កម្លាំង កាយ ចិត្ត បំពេញ ភារកិច្ច ផ្ដល់ ជំនឿចិត្ត ជូន គណបក្ស ប្រជាជន កម្ពុជា រហូត ទទួលបាន ជ័យជម្នះ យ៉ាង ត្រចះត្រចង់ នា ពេលនេះ ។
