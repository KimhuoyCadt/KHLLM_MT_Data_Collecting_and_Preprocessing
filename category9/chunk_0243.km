( ភ្នំពេញ ) ៖ លោក ពុត ចន្ដារិទ្ធ អគ្គ លេខាធិការ នៃ សមាគម ឧស្សាហកម្ម ស៊ីម៉ងតិ៍ កម្ពុជា (CCMA) បាន បញ្ជាក់ ឲ្យដឹង ថា នៅ ឆ្នាំ ២០២០ ក្នុង វិបត្តិ ជំងឺ កូវីដ១៩ កម្ពុជា ផលិត ស៊ីម៉ងតិ៍ បាន ជាង ៨លាន តោន កើនឡើង ៧ភាគរយ ខណៈ តម្លៃ មាន ការកើនឡើង ធម្មតា វិញ បន្ទាប់ពី តម្លៃ បាន ធ្លាក់ចុះ នៅ ឆ្នាំ ២០១៩ កន្លងទៅ ។
លោក បញ្ជាក់ ថា ទន្ទឹមនឹង មិន មាន ការនាំចេញ ក្នុង នោះ យើង បាន ជួប ជាមួយនឹង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ហើយ បាន ស្នើសុំ ឲ្យ ក្រសួង មាន វិធាន ពិនិត្យ ក្នុង ការ មិន ឲ្យ មាន ការនាំចូល ស៊ីម៉ង់តិ៍ និង ការទប់ស្កាត់ ស៊ីម៉ង់តិ៍ ដែល គេច ពន្ធ ផងដែរ ។
លោក បន្ដ ថា « ក្រុមហ៊ុន ស៊ីម៉ង់តិ៍ យើង គឺ បាន បង់ សួយ សារ រ៉ែ គ្រប់ ប្រភេទ ដែល ជា វត្ថុធាតុ ដើម ព្រមទាំងមូលនិធិ បរិស្ថាន និង មូលនិធិ សង្គម តាម មូលដ្ឋាន ផងដែរ » ។
លោក បន្ថែម ថា កម្ពុជា មាន ក្រុមហ៊ុន ផលិត ស៊ីម៉ងតិ៍ ចំនួន ៥ក្រុមហ៊ុន ដែល បាន ដំណើរការ ផលិត សម្រាប់ ផ្គត់ផ្គង់ តម្រូវការ ក្នុង ស្រុក ដែល ក្នុង នោះ មាន សំណង់ ធំ ៗ និង សំណង់ តូច - មធ្យម ផងដែរ ។
លោក បន្ថែម ទៀត ថា ការផ្គត់ផ្គង់ ស៊ីម៉ងតិ៍ នៅក្នុង ស្ថានភាព ជំងឺ កូវីដ១៩ នេះ ឃើញ ថា មាន ការថមថយ បន្តិច ទៅ លើ តម្រូវការ សំណង់ ធំ ៗ ដែល ជា គម្រោង របស បរទេស ដោយ មាន ការផ្អាក ខ្លះ ៗ ប៉ុន្ដែ សម្រាប់ សំណង់ តូច - មធ្យម វិញ ឃើញ ថា មាន តម្រូវ ជាធម្មតា ដូចជា ការវិនិយោគ ជា គម្រោង បុរី គម្រោង លំនៅឋាន ផ្ទះ វីឡា របស់ វិនិយោគ ក្នុង ស្រុក វិញ មិន បាន ផ្អាក ដំណើរការ នោះ ទេ ។
លោក ឃាង ភារម្យ អ្នកនាំពាក្យ សាលា ខេត្ត ព្រះសីហនុ បាន បញ្ជាក់ ថា « ក្នុង ខេត្ត ព្រះសីហនុ ជុំវិញ វិបត្តិ ជំងឺ កូវីដ១៩ នៅក្នុង ឆ្នាំ ២០២០ មាន ផល ប៉ះពាល់ ខ្លាំង មែនទែន ជាពិសេស ភាគ ច្រើន ប៉ះពាល់ ជាមួយនឹង អ្នក វិនិយោគ បរទេស ដែល ភាគ ច្រើន ជា ជនជាតិ ចិន ។ មាន សំណង់ ដែល វិនិយោគ ដោយ បរទេស ជាង ១ ពាន់ កន្លែង បាន ផ្អាក ដំណើរការ ខណៈ សំណង់ មាន ម្ចាស់ ជា ខ្មែរ ជិត ៩០កន្លែង កំពុង ដំណើរការ ជាធម្មតា » ។
លោក ឃាង ភារម្យ បញ្ជាក់ ទៀត ថា ក្នុង បរិបទ ជំងឺ កូវីដ១៩ វា ជា វិបត្តិ សកល គឺ មិន មែន មាន តែ កម្ពុជា នោះ ទេ ហើយ វិបត្តិ នេះ បាន ជះ ឥទ្ធិពល ច្រើន លើ គ្រប់ វិស័យ ។ ជាក់ស្ដែង ដូចជា វិស័យ សំណង់ ក្នុង ខេត្ត ព្រះសីហនុ វិញ ឃើញ ថា ក្នុង ឆ្នាំ ២០២០ សកម្មភាព នៃ ការសាងសង់ គឺ មាន ការថយចុះ ដោយ សំណង់ ដែល បាន សាងសង់ ទាំងអស់ មាន ចំនួន ១. ៥១៤ ទីតាំង ដោយឡែង ក្នុង នោះ មាន សំណង់ តែ ៨៩ ទីតាំង ប៉ុណ្ណោះ កំពុង ដំណើរការ សាងសង់ ហើយ ក្រៅពី នេះ គឺ មាន ការផ្អាក់ ការសាងសង់ ផងដែរ ៕
មន្ត្រី ជាន់ ខ្ពស់ អាកាសចរ ស៊ីវិល៖ ការសាងសង់ គម្រោង ព្រលានយន្តហោះ ខេត្ត មណ្ឌលគិរី អាចនឹង ចាប់ផ្តើម នៅ ឆ្នាំ ក្រោយ (Video inside) ( ភ្នំពេញ ) ៖ មន្ត្រី ជាន់ ខ្ពស់ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល បាន បង្ហាញ នូវ ការរំពឹង ថា ការសាងសង់ ព្រលានយន្តហោះ នៅ ខេត្ត មណ្ឌលគិរី អាចនឹង ចាប់ផ្ដើម សាងសង់ នា ឆ្នាំ ២០២២ ។
លោក ស៊ិន ចាន់ សិរី វុត្ថា បាន ឲ្យដឹង ថា គម្រោង អភិវឌ្ឍ អាកាសយានដ្ឋាន នៅ ខេត្ត មណ្ឌលគិរី មិន មាន អ្វី ប៉ះពាល់ ឡើង ចំពោះ បញ្ហា កូវីដ - ១៩ ខណៈ ដែល បច្ចុប្បន្ន កំពុងតែ អនុវត្ត ដំណើរការ និង អនុវត្ត និតិវិធី ដំណើរ រៀបចំ លើ កិច្ចការ អភិវឌ្ឍន៍ លើ អាកាសយានដ្ឋាន នេះ ។
អ្នកនាំពាក្យ អាកាសចរ ស៊ីវិល បាន គូសបញ្ជាក់ ថា បើ គិត ពេល ឥឡូវនេះ ទៅការសិក្សា នៃ ការអភិវឌ្ឍ អាកាសយានដ្ឋាន នៅក្នុង ខេត្ត មណ្ឌលគិរី នេះ អាចនឹង បញ្ចប់ ការសិក្សា នៅ ដើម ខែកុម្ភៈ ឆ្នាំ ២០២១ ដើម្បី ដាក់ ការសិក្សា ជូន រាជ រដ្ឋាភិបាល ធ្វើ ការសម្រេច ។
លោក ស៊ិន ចាន់ សិរី វុត្ថា បាន បន្ដ ទៀត ថា នៅ ពេល ដែល ភាគី ទាំង ពីរ ធ្វើ ការសិក្សា ចប់ ត្រូវ យក ព័ត៌មាន ទាំងអស់ នោះ មក ពិភាក្សា និង ចរចា គ្នា បន្ទាប់មក យកព័ត៌មាន និង កិច្ចព្រមព្រៀង ទាំងអស់ នោះ ដាក់ ក្នុង កិច្ចព្រមព្រៀង សម្បទាន ដែល ត្រូវការពេល ប្រហែលជា ជិត ១ឆ្នាំ ទៀត ទើប អាច ចាប់ផ្ដើម បាន ។
លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី ក៏ បាន ធ្លាប់ ប្រាប់ ឲ្យដឹង ផងដែរ ថា ខេត្ត បាន ត្រៀម ដី របស់ រដ្ឋ រួចរាល់ ប្រមាណ ៦០០ ហិកតា នៅពេល រាជ រដ្ឋាភិបាល ត្រូវការ ក្នុង ការសង សាង់ ព្រលានយន្ដហោះ ថ្មី ហើយ ទីតាំង គម្រោង នេះ មាន ចម្ងាយ ប្រហែល ២០ គីឡូម៉ែត្រ ពី ទីក្រុង សែនមនោរម្យ ៕
សភា ពាណិជ្ជកម្ម អឺរ៉ុប បើក ការប្រកួត ពានរង្វាន់ « ទំនួល ខុសត្រូវ សង្គម » ប្រចាំ ឆ្នាំ ២០២១
ក្នុង នាម ជា កម្មវិធី ប្រកួតប្រជែង ដែល ឈាន មុខ គេ ប្រចាំ ប្រទេស កម្មវិធី ប្រកួត ទំនួល ខុសត្រូវ សង្គម CSR របស់ សភា ពាណិជ្ជកម្ម អឺរ៉ុប មាន ភាពល្បីល្បាញ ដែល មាន រួមបញ្ចូល ម៉ាក ល្បី ៗ និង ក្រុមហ៊ុន ធំ ៗ ដែល ត្រូវបាន គេ ទទួលស្គាល់ ទូទាំង ប្រទេស រួម មាន ទាំង ធុរកិច្ច ចម្រុះ ជាច្រើន ប្រភេទ ផងដែរ ។
អ្វី ដែល ជា ការអភិវឌ្ឍ ថ្មី និង គួរឲ្យ ចាប់អារម្មណ៍ សម្រាប់ ឆ្នាំ នេះ គឺ កម្មវិធី ប្រកួតប្រជែង បាន ទទួល គ្រប់ ធុរកិច្ច កម្ពុជា និង ធុរកិច្ច បរទេស ណា ដែល សមស្រប នឹង លក្ខខណ្ឌ ជាក់លាក់ របស់ កម្មវិធី ( លក្ខខណ្ឌ រួម មាន ធុរកិច្ច ដែល កំពុង មាន វត្តមាន នៅក្នុង ប្រទេស កម្ពុជា និង មាន ការប្តេជ្ញាចិត្ត យ៉ាង មុះ មុត ចំពោះ កម្មវិធី ទំនួល ខុសត្រូវ សង្គម ) ។
ខណៈពេល ដែល ជាធម្មតា ការផ្សព្វផ្សាយ ទំនួល ខុសត្រូវ សង្គម ត្រូវបាន ចាត់ទុក ថា សម្រាប់ តែ សហគ្រាស ធុន ធំ ៗ ការលូតលាស់ របស់ សហគ្រាស ធុន តូច និង មធ្យម បាន ជួយ ឲ្យ ក្រុមហ៊ុន តូច ៗ បង្កើន ការប្តេជ្ញាចិត្ត ចំពោះ ការផ្លាស់ប្តូរ វិជ្ជមាន សំរាប់ សង្គម និង បរិស្ថាន ។
ហេតុ ដូច្នេះហើយ ទើប សភា ពាណិជ្ជកម្ម អឺរ៉ុប លើកទឹកចិត្ត សហគ្រាស ធុន តូច និង មធ្យម ឲ្យ ចូលរួម ក្នុង កម្មវិធី នេះ ដែល ពួកគេ នឹង ធ្វើ ការប្រកួតប្រជែង ក្នុង ជំពូក សម្រាប់ តែ សហគ្រាស ធុន តូច និង មធ្យម តែ ប៉ុណ្ណោះ ដែល ខុសពី ការប្រកួត រៀបចំ សម្រាប់ សហគ្រាស ធំ ៗ ។
តាមរយៈ គំនិត ផ្តួចផ្តើម នេះ សភា ពាណិជ្ជកម្ម អឺរ៉ុប កំពុង ជួយ ជំរុញ អ្នកច្នៃប្រឌិត ជំនាន់ ក្រោយ តាមរយៈ ការបង្កើត ទំនាក់ទំនង ជាមួយ អ្នកដឹកនាំ តាម វិស័យ នា ពេល បច្ចុប្បន្ន ។
ខណៈពេល ដែល កម្មវិធី ប្រកួតប្រជែង សរុប មាន ១៤រង្វាន់ លើ ពីរ ជំពូក សំខាន់ ៗ ក្នុង នោះ ជំពូក សំរាប់ ក្រុមហ៊ុន ចែក ជា៤ អនុជំពូក និង ១២រង្វាន់ ។ ហើយ ការប្រកួតប្រជែង ប្រភេទ ថ្មី សំរាប់ ជំពូក យុវជន នឹង មាន ១ជំពូក ជាមួយនឹង ២រង្វាន់ ។
ក្រុមហ៊ុន ដែល បាន ចុះឈ្មោះ នៅក្នុង ប្រទេស កម្ពុជា សមាគម យុវជន ឬ ឯកត្ត បុគ្គល ដែល មាន អាយុ តិច ជាង ២៥ ឆ្នាំ និង មាន វត្តមាន នៅ ប្រទេស កម្ពុជា ដែល ចង់បាន ការទទួលស្គាល់ សម្រាប់ ការងារ ទំនួល ខុសត្រូវ សង្គម ឬ ការចូលរួម ជាមួយ សហគមន៍ នឹង ត្រូវបាន ស្វាគមន៍ ឲ្យ ដាក់ ពាក្យ មុន ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២១ ។
កម្មវិធី នេះ ផ្តល់ ជូន នូវ ឱកាស ពិសេស សម្រាប់ វិស័យ ឯកជន នៅក្នុង ប្រទេស កម្ពុជា ក្នុង ការបង្ហាញ ពី ការខិតខំ ប្រឹងប្រែង និង ដំណោះស្រាយ ទំនួល ខុសត្រូវ សង្គម ដើម្បី ក្លាយជា ផ្នែក មួយ នៃ វេទិកា ដែល ជំរុញ ឲ្យ មាន ការច្នៃប្រឌិត និង ជួយ អាជីវកម្ម ក្នុង ការកសាង ជំហ៊រ និង ជំនះ ឧបសគ្គ ។
គូសបញ្ជាក់ ថា ការប្រកួត នេះ ត្រូវបាន បើក ទូលាយ សម្រាប់ អាជីវកម្ម នៅ កម្ពុជា និង ក្រុមហ៊ុន ទាំងឡាយ ដែល បាន ប្តេជ្ញាចិត្ត ក្នុង កម្មវិធី ទំនួល ខុសត្រូវ សង្គម ហើយ មិន បាន ការតម្រូវ ឲ្យ ចុះឈ្មោះ តាមរយៈ សភា ពាណិជ្ជកម្ម អឺរ៉ុប (EuroCham) នោះ ទេ ។
កម្មវិធី នេះ នឹង ត្រូវបាន ចូលរួម ជា អធិបតីភាព លោក សុខ ចិន្តា សោភា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ព្រមទាំង លោកស្រី Carmen Moreno ឯក អគ្គ រដ្ឋទូត សហភាព អឺរ៉ុប ប្រចាំ កម្ពុជា ។
គណៈ វិនិច្ឆ័យ ផ្សេង ទៀត រួម មាន អ្នកជំនាញ ជាន់ ខ្ពស់ និង ជា តំណាង មកពី អង្គការ អន្តរជាតិ ក្រុមប្រឹក្សាភិបាល និង គណៈកម្មាធិការ ធុរកិច្ច បៃតង របស់ សភា ពាណិជ្ជកម្ម អឺរ៉ុប អ្នកជំនាញ មកពី វិស័យ អប់រំ និង វិស័យ ឯកជន នានា ។
