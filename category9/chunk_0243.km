( ភ្នំពេញ ) ៖ អង្គភាព ប្រឆាំង អំពើពុករលួយ ហៅ កាត់ ថា ACU នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី លទ្ធផល នៃ ការទទួល ឯកសារ ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល តាមរបប ២ ឆ្នាំ សម្រាប់ ឆ្នាំ ២០២១ ។
សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា នាយកដ្ឋាន ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល បាន ទទួល ឯកសារ ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ចំនួន ២៤០ ច្បាប់ ។ ជា រួម ឯកសារ ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ដែល បាន ទទួល មាន ចំនួន សរុប ២៤. ៣៧២ ច្បាប់ ហើយ ៕ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បរិច្ចាក ថវិកា សរុប ចំនួន ៨០.០០០.០០០ រៀល ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី បន្ត ការ ការពារ និង ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩
ការចូលរួម នេះ គឺ បង្ហាញ ឱ្យ ឃើញ នូវ សាមគ្គីភាព របស់ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ក្នុង ខឿន ការពារ សុខភាព របស់ ប្រជាជន កម្ពុជា ៕ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស រយៈពេល ៦ខែ ជូន ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី អនុប្រធាន ទី២ នៃ រដ្ឋសភា នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
សហភាព អឺរ៉ុប ដែល មាន ប្រទេស អឺរ៉ុប ជា សមាជិក ចំនួន ២៧ ធ្លាប់ បាន បង្ហើប ម្ដង រួច មកហើយ កាលពី ថ្ងៃទី ០៦ ខែមករា កន្លងទៅ នេះ ថា ពួកគេ អាចនឹង លែង ទទួលស្គាល់ លោក Guaido ជា ប្រធានាធិបតី វេណេស៊ុយអេឡា ស្ដី ទី បន្ទាប់ពី លោក បាន បាត់បង់ តំណែង ជា ប្រធាន សភា ក្នុង ការបោះឆ្នោត សភា កាលពី ខែធ្នូ ឆ្នាំ ២០២០ បើ ទោះជា សហភាព អឺរ៉ុប មិន បាន ទទួលស្គាល់ ការបោះឆ្នោត នេះ ក៏ដោយ ។ តែ យ៉ាងណា លោក Guaido នៅតែ ទទួលបាន ការគាំទ្រ ពី សហរដ្ឋ អាមេរិក និង ចក្រភព អង់គ្លេស ដដែល ។
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង ជា ប្រធាន គណៈកម្មការ ទី៧ នៃ រដ្ឋសភា បាន លើកឡើង ថា ការជាប់ ឆ្នោត ជា បន្តបន្ទាប់ របស់ គណបក្ស ប្រជាជន កម្ពុជា ពី មួយ អាណត្តិ ទៅ មួយ អាណត្តិ មិន មែន ជា រឿង ចៃដន្យ ឡើយ ប៉ុន្តែ ជា ការសរបញ្ជាក់ ឱ្យ ឃើញ យ៉ាង ច្បាស់ ពី ការប្រគល់ នូវ ការជឿទុកចិត្ត និង ការគាំទ្រ មិន ងាក រេ របស់ ប្រជាជន គ្រប់ ស្រទាប់ វណ្ណៈ ។
តាមរយៈ បណ្តាញ សង្គម Facebook នៅ ថ្ង ទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ តំណាងរាស្រ្ត វ័យ ក្មេង លោក ហ៊ុន ម៉ានី បាន លើកឡើង យ៉ាង ដូច្នេះ ថា៖ « គណបក្ស ប្រជាជន កើត ចេញ ពី ប្រជាជន ដើម្បី ប្រជាជន និង សម្រាប់ ប្រជាជន ។ ការជាប់ ឆ្នោត ជា បន្តបន្ទាប់ របស់ គណបក្ស ប្រជាជន កម្ពុជា ពី មួយ អាណត្តិ ទៅ មួយ អាណត្តិ មិន មែន ជា រឿង ចៃដន្យ ឡើយ ប៉ុន្តែ ជា ការសរបញ្ជាក់ ឱ្យ ឃើញ យ៉ាង ច្បាស់ ពី ការប្រគល់ នូវ ការជឿទុកចិត្ត និង ការគាំទ្រ មិន ងាក រេ របស់ ប្រជាជន គ្រប់ ស្រទាប់ វណ្ណៈ មក លើ គណបក្ស យើង » ។
ជាមួយគ្នា នេះ ដែរ លោក ហ៊ុន ម៉ានី បាន បន្ត ថា ការជឿជាក់ និង ការបន្ត គាំទ្រ ពីសំណាក់ ប្រជាពលរដ្ឋ គ្រប់ ស្រទាប់ វណ្ណៈ មក លើ ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា គឺ បាន ស្តែង ចេញពី អ្វី ដែល ពួកគាត់ ទាំងអស់ បាន និង កំពុង ទទួល ដែល ក្នុង នោះ គឺ ការរស់នៅក្នុង សន្តិភាព និង ការអភិវឌ្ឍ ជាមួយនឹង ក្តីសង្ឃឹម របស់ ពួកគាត់ ទៅ ថ្ងៃ អនាគត ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
កាលពី ព្រឹក មិញ ក្រុមការងារ ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ស្វែងរក ម្ចាស់ គណនី ហ្វេសបុក មួយ នេះ ឱ្យ ចូលខ្លួន បំភ្លឺ អំពី ការចុះផ្សាយ ព័ត៌មាន មិន មាន ប្រភព ច្បាស់លាស់ ព័ត៌មាន មិន ពិត ដែល ធ្វើឱ្យ ប្រជាពលរដ្ឋ ទូទៅ មាន ការយល់ ច្រឡំ និង ស្អប់ សមត្ថកិច្ច លើ ការអនុវត្ត រឹតបន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ។
បន្ទាប់ពី បាន ឃើញ ការចុះផ្សាយ នៅលើ ផេក ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ឈ្មោះ ឡា កុសល ក៏ បាន ចូលខ្លួន មក ទទួល កំហុស របស់ ខ្លួន ដែល បាន ប្រើប្រាស់ គណនី ហ្វេ បុក ឈ្មោះ «La kosal» ធ្វើ ការបង្ហោះ ព័ត៌មាន មិន ពិត មើលងាយ ដល់ សមត្ថកិច្ច ក៏ ដូចជា បង្ខូច កិត្ត យ សមត្ថកិច្ច បន្ទាប់ពី រូប គាត់ ត្រូវបាន សម្ថកិច្ច ផាក ពិន័យ ករណី ការបើកបរ ល្មើស ច្បាប់ ចរាចរណ៍ កាលពី ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ នៅ ត្រង់ ចំណុច ស្តុប ស្ថាន ទុត វៀតណាម ។
ពេល នោះ យុវជន រូប នេះ បាន បើកបរ ល្មើស ភ្លើង សញ្ញា ចរាចរណ៍ ហើយ ដោយសារតែ ការខឹង និង ខ្វះ ការពិចារណាមួយ ពេល ក៏ បាន បង្ហោះ សារជា អក្សរ ក្នុង ហ្វេសបុក នូវ ព័ត៌មាន មិន ពិត កាលពី ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ ដែល មាន ខ្លឹមសារ ធ្វើឲ្យ ប៉ះពាល់ កិត្តិយស សេចក្តីថ្លៃថ្នូ ដល់ កិត្តិយស របស់ នគរបាល ជាតិ ។
ម្ចាស់ ហ្វេសបុក រូប នេះ បាន ទទួលស្គាល់ នូវ កំហុស និង សូម សន្យា ថា ឈប់ ប្រព្រឹត្ត អំពើ បែប នេះ តទៅទៀត ហើយ ។ អាស្រ័យ ហេតុ នេះ សូម បង ៗ សមត្ថកិច្ច ក៏ ដូចជា ប្រជាពលរដ្ឋ ទាំងអស់ មេត្តា យោគយល់ និង លើកលែង ទោស ដល់ រូប គាត់ ផង ។ ជា ចុងបញ្ចប់ ម្ចាស់ ហ្វេសបុក រូប នេះ សូម សំណូមពរ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី ការពារ អាយុជីវិត ទ្រព្យសម្បត្តិ របស់ ខ្លួន ឯង និង អ្នក ដ៏ទៃ ៕
រដ្ឋមន្រ្តី វេង សាខុន ប្រកាស បរិច្ចាគ ថវិកា ៤០ លាន រៀល ជូន ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នា ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស បរិច្ចាគ ថវិកា ចំនួន ៤០ លាន រៀល ជូន ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ។
ជំរឿន ឆ្នាំ ២០១៩៖ ភ្នំពេញ មាន ពលរដ្ឋ ច្រើន ជាង គេ ខណៈ កែប មាន ពលរដ្ឋ តិច ជាង គេ
បន្ថែម ពី នេះ បើ តាម លទ្ធផល ជំរឿន ដដែល បាន ឱ្យដឹង ដែរ ថា សម្រាប់ ដង់ស៊ីតេ ប្រជាជន ក្នុង មួយ គីឡូម៉ែត្រ ក្រឡា បាន កើនឡើង ពី ៧៥ នាក់ នៅ ឆ្នាំ ២០០៨ ទៅ ៨៧ នាក់ នៅ ឆ្នាំ ២០១៩ ។ ដង់ស៊ីតេ នេះ ប្រជាជន កម្ពុជា នៅ ទាប ជាង ច្រើន បើ ធៀប នឹង ដង់ស៊ីតេ ប្រជាជន នៃ បណ្តា ប្រទេស នៅ អាស៊ី អាគ្នេយ៍ ។
ដោយឡែក រាជធានី ភ្នំពេញ ជា តំបន់ ប្រមូលផ្តុំ ដោយ មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម សេដ្ឋកិច្ច សង្គមកិច្ច និង វប្បធម៌ ដែល ជា ប្រភព ទាក់ទាញ ស្រូបយក ការធ្វើ ចំណាកស្រុក មកពី បណ្តា ខេត្ត ផ្សេង ទៀត ដោយសារ ផ្តល់ ប្រភព ការងារ និង ការរីកចំរើន វិស័យ ឧស្សាហកម្ម កាត់ដេរ សំណង់ សណ្ឋាគារ ទេសចរណ៍ និង អប់រំ ។ល ។
នៅ រាជធានី ភ្នំពេញ មាន ដង់ស៊ីតេ ប្រជាជន ខ្ពស់ បំផុត គឺ ៣. ៣៦១ នាក់ ក្នុង ផ្ទៃដី មួយ គីឡូម៉ែត្រ ការ៉េ ។ ខេត្ត កោះកុង និង ខេត្ត មណ្ឌលគីរី ជា ខេត្ត មាន ដង់ស៊ីតេ ប្រជាជន ទាប បំផុត ( ១២នាក់ និង ៦នាក់ ) ក្នុង ផ្ទៃដី មួយ គីឡូម៉ែត្រ ការ៉េ ៕
ខាងក្រោម នេះ ជា ក្រាប ចំនួន ប្រជាជន កម្ពុជា នៅ តាម បណ្ត រាជធានី - ខេត្ត ទាំង ២៥៖
អគ្គ រដ្ឋទូត ស្តីទី កូរ៉េ ខាងជើង ប្រចាំ គុយ វ៉ែត រត់ ទៅ សុំ សិទ្ធិ ជ្រកកោន នៅ កូរ៉េ ខាងត្បូង . នេះ បើ តាម ប្រភព ពី កូរ៉េ ខាងត្បូង
ទោះជា បែប នេះ ក្ដី បើ តាម លោក Ha ទីភ្នាក់ងារ ស៊ើបការណ៍ សម្ងាត់ មិន បាន បញ្ជាក់ ថា តើ បេសកកម្ម ការ ទូត កូរ៉េ ខាងត្បូង ប្រចាំ ប្រទេស ណាមួយ ជា អ្នក ដែល បាន ជួយ មន្ត្រី ការទូត កូរ៉េ ខាងជើង ខាងលើ នេះ ឡើយ ហើយក៏ មិន បាន ឱ្យដឹង ថា តើ ហេតុ អ្វី បានជា រូប គេ សម្រេចចិត្ត រត់ មកកាន់ កូរ៉េ ខាងត្បូង នោះ ដែរ ខណៈ រដ្ឋាភិបាល គុយ វ៉ែត និង ទីក្រុង ព្យុងយ៉ាង មិន ទាន់ ធ្វើ ការអត្ថាធិប្បាយ អ្វី ឡើយ ។
ទន្ទឹម នេះ លោក រដ្ឋលេខាធិការ ឯម ច័ន្ទ មករា ក៏ បាន ជំរុញ ឱ្យ បង្កើន ការប្រើប្រាស់ ភាសា សញ្ញា អក្សរ រត់ អក្សរ ប្រៃយ៍ ( អក្សរ ស្ទាប ) អក្សរ ពុម្ព ធំ សំឡេង ឲ្យបាន ទូលំទូលាយ ដើម្បី ផ្តល់ ឱកាស ទំនាក់ទំនង ការបញ្ចេញមតិ យោបល់ និង ទទួលបាន ព័ត៌មាន សម្រាប់ ជន មាន ពិការភាព គ្រប់ ប្រភេទ ៕ រដ្ឋមន្រ្តី ក្រសួង ធនធាន ទឹក ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស៦ ខែ ជូន ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក លឹម គាន ហោ រដ្ឋមន្រ្តី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ចំនួន ៦ខែ ចាប់ពី ខែកុម្ភៈ ដល់ ខែកក្កដា ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
ការបញ្ជាក់ បែប នេះ របស់ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួម ហាផ្ទៃ បាន ធ្វើឡើង ក្នុង ពិធី ប្រកាស ផ្សព្វផ្សាយ របាយការណ៍ ជាតិ ស្តីពី លទ្ធផល ចុងក្រោយ ជំរឿន ទូទៅ ប្រទេស កម្ពុជា ឆ្នាំ ២០១៩ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ នៅ សណ្ឋាគារ សូហ្វី តែ ល ភ្នំពេញ ។
សម្តេច ក្រឡាហោម ស ខេង បាន ឱ្យដឹង ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើ កំណែទំរង់ គ្រប់ វិស័យ ក្នុង គោលដៅ កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាជន ដែល ជា ស្នូល ក្នុង គ្រប់ គោល នយោបាយ និង យុទស្ធា្រស្ត អភិវឌ្ឍន៍ របស់ រាជ រដ្ឋាភិបាល ។ ជាក់ស្តែង ទិន្នន័យ ស្ថិតិ គឺជា មូលដ្ឋាន ដ៏ មាន សារៈសំខាន់ សម្រាប់ ការរៀបចំ គោល នយោបាយ យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល និង ជា ឧបករណ៍ សម្រាប់ វាយតម្លៃ ពី វឌ្ឍនភាព នៃ កិច្ចការ ទាំងនោះ ផងដែរ ។
បន្ថែម ពី នេះ សម្តេច ក្រឡាហោម ថា បើ តាម ទិន្នន័យ ស្ថិតិ ដែល ប្រមូល បាន ពី ជំរឿន និង អង្កេត ទាំងឡាយ បាន ផ្តល់ ជា មូលដ្ឋាន ដ៏ សំខាន់ សម្រាប់ រៀបចំ និង តាមដាន ផែនការ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ ជាតិ វាយតម្លៃ ស្ថានភាពក្រីក្រ នៅ កម្ពុជា និង ការសំរេច គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព កម្ពុជា ក៏ ដូចជា ជួយ ដល់ អ្នកសិក្សា ស្រាវជ្រាវ នៅ ថ្នាក់ ជាតិ រួមទាំង សហគមន៍ ជាតិ និង អន្តរជាតិ ដ៏ ទូលំទូលាយ ។
បណ្តា ប្រទេស និង ដៃគូ អភិវឌ្ឍន៍ កំពុង ប្រឈមមុខ នឹង ការសម្រេចបាន ការអនុវត្ត គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ដែល បាន ឯកភាព ជា សកល តាមរយៈ សេចក្តីថ្លែងការណ៍ ឆ្នាំ ២០១៦ ។ ទោះបី យ៉ាងណា ក៏ដោយ រង្វាស់ នៃ ដំណើរការ រីកចម្រើន របស់ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព គឺ ផ្អែក លើ ព័ត៌មាន និង ទិន្នន័យ ជំរឿន ដែល មាន ។ ប្រភព ទិន្នន័យ បឋម នៃ ព័ត៌មាន ពី ចំនួន និង ចរិត លក្ខណៈ ប្រជាជន និង លំនៅដ្ឋាន គឺ សំខាន់ ណាស់ សម្រាប់ សម្រេចបាន នូវ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព និង សម្រាប់ ផែនការអភិវឌ្ឍន៍ ផ្សេង ៗ ។
សម្តេច ក្រឡាហោម បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ព័ត៌មាន ជំរឿន គឺជា មូលដ្ឋានគ្រឹះ ដ៏ រឹងមាំ សម្រាប់ ផ្តល់ នូវ សូចនាករ ផ្ទាល់ សម្រាប់ តាមដាន ត្រួតពិនិត្យ គោលដៅ អប់រំ យេនឌ័រ មរណភាព និង បរិស្ថាន បន្ថែម ពីលើ អង្កេត សេដ្ឋកិច្ច សង្គមកិច្ច និង អង្កេត ប្រជាស្ត្រ និង សុខភាព ដែល បាន ផ្តល់ នូវ សូចនាករ ផ្ទាល់ សម្រាប់ តាមដាន ភាពក្រីក្រ និង សូចនាករ មួយចំនួន ទៀត » ។
សម្តេច ក្រឡាហោម ស ខេង បាន បញ្ជាក់ បន្ថែម ថា របាយការណ៍ ពាក់កណ្តាល អណត្តិ នៃ ផែនការ យុទ្ឋ សាស្ត្រ អភិវឌ្ឍន៍ ជាតិ ២០១៩ - ២០២៣ របស់ កម្ពុជា នឹង ត្រូវបាន វាយតម្លៃ និង ត្រួតពិនិត្យ ជា ប្រក្រតី ។ របាយការណ៍ ជំរឿន នេះ នឹង ជួយ កែលម្អ ជា ចាំបាច់ និង កែ សំរួល នៅក្នុង គោលដៅ ទិសដៅ និង ផែនការស្រប ជាមួយនឹង ទិន្នន័យ ថ្មី ៗ និង តថ ភាព ។
ប្រធានបទ សំខាន់ ៗ នៃ កិច្ចប្រជុំ គឺ ផ្តោត លើ ការអភិរក្ស និង អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព នៅក្នុង តំបន់ អង្គរ ការតាមដាន អំពី ការអនុវត្ត នូវ រាល់ អនុសាសន៍ ដែល កិច្ចប្រជុំ អាយ ស៊ីស៊ី - អង្គរ បាន សម្រេច នា ពេល កន្លងមក ការពិភាក្សា ផ្លាស់ប្តូរ យោបល់ រវាង អ្នកជំនាញ អាដហុក អំពី កិច្ចការ ផ្សេង ៗ ដែល កំពុង និង ត្រៀម អនុវត្ត នា ពេល អនាគត ។ ក្នុង នោះ ដែរ កិច្ចប្រជុំ ក៏ នឹង សម្រេច អនុម័ត នូវ អនុសាសន៍ ថ្មី ៗ បន្ថែម ដល់ ក្រុមការងារ ជំនាញ ដើម្បី អនុវត្ត ស្រប តាម ផែនការអនុវត្ត គម្រោង នីមួយ ៗ ។
ចំពោះ ការចូលរួម ដោយ ផ្ទាល់ ពី អ្នកជំនាញ ជាតិ - អន្តរជាតិ នៅ សណ្ឋាគារ សូហ្វី តែ ល គឺ ប្រកាន់ខ្ជាប់ នូវ វិធានការ អនាម័យ និង ការរក្សា គម្លាត សង្គម ក្នុង នោះ បាន កំណត់ ចំនួន អ្នកចូលរួម ផ្ទាល់ ចំនួន តែ ៧០ នាក់ ប៉ុណ្ណោះ ៕
ឧត្តមសេនីយ៍ ឯក យឹម លាង ដឹកនាំ កិច្ចប្រជុំ ផែនការ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ ក្នុង ឱកាស ប្រារព្ធ ពិធី បុណ្យ មាឃ បូជា
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក យឹម លាង អគ្គ ស្នងការ រង នគរបាល ជាតិ តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ បាន អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ នៅ នាយកដ្ឋាន អង្គរក្ស នា ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ ស្ដីពី ផែនការ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ ក្នុង ឱកាស ប្រារព្ធ ពិធី បុណ្យ មាឃ បូជា ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី អភិបាល រង ខេត្ត កណ្តាល តំណាង អភិបាល រាជធានី ភ្នំពេញ មេបញ្ជាការ រង លើ ផ្ទៃ ប្រទេស ប្រធាន នាយកដ្ឋាន អង្គរក្ស ប្រធាន មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ ស្នងការ រង ខេត្ត កណ្តាល ស្នងការ ខេត្ត កំពង់ឆ្នាំង ស្នងការ រង ខេត្ត កំពង់ស្ពឺ និង សម ត្ថកិច្ច ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ផងដែរ ។
សូម បញ្ជាក់ ថា ពិធី បុណ្យ មាឃ បូជា ជា ពិធី បុណ្យ សាសនា ដ៏ ធំ មួយ របស់ កម្ពុជា ដែល នឹង ត្រូវ ប្រារព្ធ ធ្វើឡើង នៅ ថ្ងៃទី ២៨ ខែមករា ឆ្នាំ ២០២១ ខាងមុខ នេះ ។
( ឧត្តរមានជ័យ )៖ លោក កែវ រតនៈ រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី ទទួលបន្ទុក ជា អគ្គ នាយក អគ្គិសនី កម្ពុជា នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ប្រតិភូ អគ្គិសនី កម្ពុជា និង ក្រុមហ៊ុន LYP Group ចុះ សួរសុខទុក្ខ កងកម្លាំង ជួរ មុខ និង គ្រួសារ កងកម្លាំង នៅ អង្គភាព កងពល តូច ថ្មើរជើង លេខ ៤២ និង វរសេនា តូច នគរបាល ការពារ ព្រំដែន គោក លេខ ៧០២ ប្រចាំ ទិស ប្រាសាទ តា មាន់ ខេត្ត ឧត្តរមានជ័យ ដែល ជា អង្គភាព សម្ព័ន្ធ មេត្រីភាព ជាមួយ អគ្គិសនី កម្ពុជា ។
លោក កែវ រតនៈ បាន បញ្ជាក់ ឲ្យដឹង ថា ជា ប្រពៃណី នៅ រៀងរាល់៣ ខែម្តង ក្រុមហ៊ុន ទាំង ពីរ គឺ អគ្គិសនី កម្ពុជា និង ក្រុមហ៊ុន LYP Group ដែល មាន ចំណង មេត្រីភាព ជាមួយ អង្គភាព កងពល តូច ថ្មើរជើង លេខ ៤២ និង វរសេនា តូច នគរបាល ការពារ ព្រំដែន គោក លេខ ៧០២ ប្រចាំ ទិស ប្រាសាទ តា មាន់ តែងតែ ចុះ សាកសួរ សុខទុក្ខ និង នាំយក អំណាយ ទៅ ប្រគល់ ជូន បងប្អូន កងទ័ព ដែល កំពុង ឈរជើង ការពារ ខ្សែ បន្ទាប់ ព្រំដែន ដោយ មិន ដែល កាត់ផ្តាច់ ពី គ្នា បាន ឡើយ រវាង សមរភូមិ មុខ និង សមរភូមិ ក្រោយ ។
ក្នុង ឱកាស ចុះ សួរសុខទុក្ខ នេះ លោក កែវ រតនៈ បាន នាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល តែងតែ យកចិត្តទុកដាក់ គិតគូរ ជានិច្ច ដល់ សុខ ទុក្ខ របស់ កងកម្លាំង នគរបាល និង យោធា ដែល កំពុង ឈរជើង ការពារ ព្រំដែន ។
លោក កែវ រតនៈ ក៏ សម្តែង ការកោតសរសើរ ដល់ ជីវភាពពុះពារ ការលំបាក ខិតខំ បំពេញ ភារកិច្ច របស់ កង ម្លាំង ដោយ មាន កិច្ចសហការ ឧបត្ថម្ភ គាំទ្រ ពីសំណាក់ អាជ្ញាធរដែនដី និង បណ្តា សមត្ថកិច្ច ដទៃ ទៀត តាម បណ្តោយ ព្រំដែន ក្នុង កិច្ចការពារ បូរណភាព ទឹកដី អធិបតេយ្យ ជាតិ ចូលរួម កសាង ព្រំដែន មិត្តភាព សន្តិភាព សហប្រតិបត្តិការ ជាមួយ ប្រទេស ជិតខាង ជា មិត្ត ភូមិ ផង របង ជាមួយ បាន ល្អ ប្រសើរ គួរឲ្យ កត់សម្គាល់ និង ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ ផងដែរ ។
លោក កែវ រតនៈ បាន បន្ដ ថា ស្នាដៃ នេះ គឺជា ចំណែក នៃ សមិទ្ធផល ដ៏ ធំធេង សម្រេចបាន របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ក្នុង ការដឹកនាំ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន ជឿនលឿន ជាលំដាប់ ។
លោក កែវ រតនៈ ក៏ បាន អំពាវនាវ ដល់ បងប្អូន កងទ័ព និង នគរបាល សូម ប្រុងប្រយ័ត្ន ចំពោះ ជំងឺ កូវីដ១៩ និង បន្ត រឹង ប៉ឹង ថែម ទៀត ក្នុង ការការពារ បូរណភាព ទឹកដី ដោយ សមរភូមិ ក្រោយ នៅតែ បន្ត គាំទ្រ កងទ័ព និង នគរបាល ការពារ ព្រំដែន ដែល មាន វីរភាព អង់អាច ក្លាហាន ការពារ ទឹកដី បាន គង់វង្ស ។
ការបញ្ជាក់ របស់ សម្តេច ក្រឡាហោម ស ខេង បាន ធ្វើឡើង បន្ទាប់ពី អ្នកសារ ព ័ត៌មាន បាន ចោទសួរ អំពី ការធ្វើ កំណែទម្រង់ នគរបាល បន្ទាប់ពី សម្តេច កាលពី ថ្ងៃទី ១២ ខែមករា បាន បង្កើត គណៈកម្មការ និង សមាសភាព ដើម្បី រៀបចំ ធ្វើ កំណែទម្រង់ នគរបាល ជាតិ នៅពេល ខាងមុខ នេះ ។
សម្តេច បាន បន្ថែម ថា៖ « អ្នកណា ថា អី មិន ដឹង ទេ តែ យើង ធ្វើ កំណែទម្រង់ ដើម្បី ប្រទេសជាតិ សម្រាប់ ប្រជាពលរដ្ឋ យើង អត់ ធ្វើ សម្រាប់ បុគ្គល ណា ទេ » ។ បើ តាម សម្តេច ក្រឡាហោម . សម្រាប់ ការធ្វើ កំណែទម្រង់ មន្ត្រី នគរបាល គឺ ដើម្បី ធ្វើ យ៉ាងណា បង្កើន គុណភាព សមត្ថភាព របស់ មន្ត្រី ដើម្បី ឆ្លើយតប ទៅនឹង ការវិវត្ត ទៅ មុខ ឥត ឈប់ របស់ សង្គមជាតិ ជាដើម ។
ប្រកាស តែងតាំង មុខ តំណែង មន្រ្តី រាជការ ក្នុង រចនាសម្ព័ន្ធ របស់ រដ្ឋបាល ខេត្ត តាកែវ . មន្រ្តី ត្រូវ ចងចាំ អនុសាសន៍ សម្ដេច តេជោ ហ៊ុន សែន « មន្រ្តី រាជការ ជា ខ្ញុំ បម្រើ ដ៏ ស្មោះត្រង់ របស់ ប្រជាពលរដ្ឋ »
( តាកែវ )៖ នៅក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព នៅ ពិធី ប្រកាស តែងតាំង មុខ តំណែង មន្រ្តី រាជការ ក្នុង រចនាសម្ព័ន្ធ របស់ រដ្ឋបាល ខេត្ត តាកែវ នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ លោក មូល វិចិត្រ អភិបាល រង ខេត្ត តាកែវ បាន ធ្វើ ក្រើន រំលឹក មន្រ្តី រាជការ ទាំងអស់ របស់ សាលា ខេត្ត តាកែវ ត្រូវតែ ចងចាំ អនុសាសន៍ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន បាន លើកឡើង ថា « មន្រ្តី រាជការ គឺជា ខ្ញុំ បម្រើ ដាច់ ថ្លៃ របស់ ប្រជាពលរដ្ឋ » ។
លោក មូល វិចិត្រ បាន ណែនាំ ដល់ មន្រ្តី សាលា ខេត្ត ទាំងអស់ ដែល ទទួលបាន ការតម្លើង តំណែង មិន ត្រូវ មាន ឥរិយាបថ ពើង ទ្រូង នោះ ទេ ភាព ពើង ទ្រូង ណាមួយ តែង នាំ ទៅ ដល់ ក្ដី វិនាស នៃ មន្រ្តី ទាំងនោះ ។ ភាព ពើង ទ្រូង របស់ មន្រ្តី ចំពោះ ប្រជាជន ភាពខ្វះ សីលធម៌ ចំពោះ ប្រជាជន វា នឹង នាំឲ្យ ប្រជាជន ខឹង គោ វាយ រទេះ ស្អប់ អភិបាល ស្រុក អភិបាល ខេត្ត មក ខឹង ដល់ ថ្នាក់ដឹក រាជ រដ្ឋាភិបាល ទៅ វិញ ។ រឿង នេះ គឺជា រឿង ដែល ប្រមុខ រាជ រដ្ឋាភិបាល លោក តែងតែ ធ្វើ ការវះកាត់ ។
ករណី នេះ បាន កើតឡើង កាលពី ថ្ងៃទី ២០ ខែមករា ឆ្នាំ ២០២១ វេលា ម៉ោង ០៤៖៣០ នាទី ទៀប ភ្លឺ នៅលើ ផ្លូវ ជាតិ លេខ ៦ ចន្លោះ គីឡូម៉ែត លេខ ២១ - ២២ ត្រង់ ចំណុច មុខ ផ្សារ ព្រែក អញ្ចាញ ស្ថិត នៅ ភូមិ ក្រោម ឃុំ ព្រែក អញ្ចាញ ស្រុក មុខ កំពូល ខេត្ដ កណ្ដាល ។
ពេល នោះ បាន មក បុក រថយន្ត នីសាន់ ដែល ឈប់ លើ ទ្រូងផ្លូវ ខាងលើ បណ្ដាលឲ្យ ស្លាប់ ឈ្មោះ សុខ សារ៉ុម ពេល បញ្ចូន ទៅ ពេទ្យ ស្រុក មុខ កំពូល និង មនុស្ស ៦នាក់ ទៀត បាន រងរបួស ធ្ងន់ - ស្រាល បញ្ចូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ ។
ក្រោយពី ទទួលបាន ព័ត៌មាន កំលាំង ប៉ុស្តិ៍ ព្រែក អញ្ចាញ និង កំលាំង ជំនាញ បាន ចុះ ទៅដល់ កន្លែង កើត ហេតុ ហើយ បាន ពិនិត្យ កន្លែង កើត ហេតុ និង វាស់វែង រួច បាន យក រថយន្ត ទាំង២ មក រក្សាទុក នៅ អធិការដ្ឋាន នគរបាល ស្រុក មុខ កំពូល ៕
ចាប់ មេក្លោង នាំ ប្រជាពលរដ្ឋ ទៅ ចាប់ ដី រដ្ឋ យក ធ្វើជា កម្មសិទ្ធិ នៅ ចំណុច ដី សម្បទាន សង្គមកិច្ច ឃុំ ទំនប់ រលក ស្រុក ស្ទឹង ហាវ ខេត្ត ព្រះសីហនុ
( ព្រះសីហនុ) ៖ ជនសង្ស័យ ម្នាក់ ដែល សមត្ថកិច្ច និង អាជ្ញាធរ ចាត់ ថា ជា មេក្លោង រឿង ដីធ្លី នោះ ត្រូវបាន ចាប់ខ្លួន ក្រោយ បុរស រូប នេះ បាន នាំ ប្រជាពលរដ្ឋ ទៅ ចាប់ ដី រដ្ឋ យក ធ្វើជា កម្មសិទ្ធិ កាលពី ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ ស្ថិត នៅ ចំណុច ដី សម្បទាន សង្គមកិច្ច ក្នុង ក្រុម ២១ ភូមិ ១ ឃុំ ទំនប់ រលក ស្រុក ស្ទឹង ហាវ ខេត្ត ព្រះសីហនុ ។
ជនសង្ស័យ មាន ឈ្មោះ អឿន ម៉ាប់ អាយុ ៤១ ឆ្នាំ មុខរបរ ជាង ម៉ាស៊ីន ត្រជាក់ មាន ស្រុក កំណើត ភូមិ ខ្ទុំ កណ្ដាល ឃុំ ជីគរ ស្រុក ត្បូងឃ្មុំ ខេត្ត កំពង់ចាម បច្ចុប្បន្ន ស្នាក់ នៅ ឃុំ ស្មាច់ ដែង ស្រុក ព្រៃនប់ ត្រូវបាន ចោទ ថា « ញុះ ញុង់ ឲ្យ ប្រព្រឹត្ត បទឧក្រិដ្ឋ លើ អចលន ទ្រព្យ របស់ រដ្ឋ » ។
កម្លាំង នគរបាល ស្រុក ស្ទឹង ហាវ បាន ឃាត់ខ្លួន ជនសង្ស័យ រូប នេះ រួច បញ្ជូន មក ការិយាល័យ ជំនាញ ចាត់ការ បន្ត ។
ក្នុង លិខិត របស់ រដ្ឋមន្ត្រី ក្រសួង អប់រំ បាន ឲ្យដឹង យ៉ាង ដូច្នេះ ថា សូម ជម្រាប ជូន លោក - លោកស្រី ប្រធាន ជ្រាប ថា៖ សម្រាប់ ឆ្នាំ សិក្សា ២០១៩ - ២០២០ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ចេញ សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ សម័យ ប្រឡង៖ ២១ ធ្នូ ២០២០ ជូន បេក្ខជន ដែល ទើប បាន សម្រេច ឲ្យ ជាប់ ដោយ ស្វ័យប្រវត្តិ ដើម្បី យក ទៅ ប្រើប្រាស់ តាម ច្បាប់ អនុញ្ញាត ។
អាស្រ័យ ដូច បាន ជម្រាប ជូន ខាងលើ សូម លោក - លោកស្រី ប្រធាន ចាត់តាំង តំណាង ដោយ ភ្ជាប់ មក ជាមួយ នូវ លិខិត ឧទ្ទេសនាម ដែល ប្រើប្រាស់ ថវិកា អង្គភាព មន្ទីរ សាមី ឲ្យ មក ទទួលយក សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ សម័យ ប្រឡង៖ ២១ ធ្នូ ២០២០ នៅ នាយកដ្ឋាន កិច្ចការ ប្រឡង ចាប់ពី ថ្ងៃទី ០២ ខែកុម្ភៈ ឆ្នាំ ២០២១ ត ទៅ ដើម្បី យក ទៅ ចែកជូន បេក្ខជន ដោយ ឥត គិត ថ្លៃ ៕
ខាងក្រោម នេះ លិខិត របស់ រដ្ឋមន្ត្រី ក្រសួង អប់ រំ៖ កម្លាំង ជំនាញ ចុះបង្ក្រាប ទីតាំង គ្រឿង សម្អាង ក្លែងក្លាយ និង សម្ភារ បរិក្ខារ ពេទ្យ គ្មាន ច្បាប់ អនុញ្ញាត នៅ ខណ្ឌ ច្បារអំពៅ ដកហូត វត្ថុតាង បាន រាប់ តោន
( ភ្នំពេញ ) ៖ កម្លាំង ជំនាញ នៃ នាយកដ្ឋាន នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច បាន ចុះបង្ក្រាប ករណី នាំចូល ស្តុក ទុក និង ចែកចាយ គ្រឿង សម្អាង ក្លែងក្លាយ និង សម្ភារ បរិក្ខារ ពេទ្យ គ្មាន ច្បាប់ អនុញ្ញាត ស្ថិត នៅ ឃ្លាំង គ្មាន លេខ ផ្លូវ ៦៤៧ សង្កាត់ និរោធ ខណ្ឌ ច្បារអំពៅ ដោយ ដកហូត វត្ថុតាង បាន ជាច្រើន តោន ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង នា ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ ដោយ មាន ការចូលរួម ពី ក្រសួង សុខាភិបាល អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ និង អាជ្ញាធរ មូលដ្ឋាន ដឹកនាំ សម្របសម្រួល នីតិវិធី ដោយ លោក ម៉ុត ដារ៉ា ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
បន្ទាប់មក ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន សម្រេច ឲ្យ សមត្ថកិច្ច ចម្រុះ ធ្វើ ការឃាត់ទុក សម្ភារៈ ទាំងអស់ នៅក្នុង ឃ្លាំង ជា បណ្តោះអាសន្ន និង បិទ ផ្លុំ បេទីតាំង ខាងលើ និង បាន នាំ តំណាង ម្ចាស់ ទីតាំង ខាងលើ មក នាយកដ្ឋាន ដើម្បី បន្ត នីតិវិធី ៕ ទេសរដ្ឋមន្ត្រី គន់ គីម ជំរុញ មន្ត្រី គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ព្រះវិហារ បន្ត យកចិត្តទុកដាក់ លេី ការងារ គ្រោះមហន្តរាយ
( ព្រះវិហារ ) ៖ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន ជំរុញ មន្ត្រី គ្រប់គ្រង គ្រោះមហន្តរាយ បន្ត យកចិត្តទុកដាក់ លេី ការងារ គ្រោះមហន្តរា យ ហេីយ ត្រូវ ធ្វេី សកម្មភាព ជួយ ប្រជាពលរដ្ឋ រងគ្រោះ ឱ្យ បាន ទាន់ ពេលវេលា ។
លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ក្នុង ឱកាស ដឹកនាំ កិច្ចប្រជុំ ត្រួតពិនិត្យ ការងារ ឆ្នាំ ២០២០ និង លើក ទិសដៅ បន្តរ ឆ្នាំ ២០២១ របស់ គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ បាន វាយតម្លៃ និង កោតសរសេី រ ថ្នាក់ដឹកនាំ និង មន្ត្រី គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ក៏ ដូចជា កងកម្លាំង ប្រដាប់ អាវុធ និង អាជ្ញាធរ មូលដ្ឋាន ដែល បាន ប្រឹងប្រែង ដោះស្រាយ ការលំបាក និង សង្គ្រោះ ប្រជាពលរដ្ឋ នៅពេល ជួប គ្រោះមហន្តរាយ ។
លោក ទេសរដ្ឋមន្ត្រី បាន លេីក ឡេីង ថា ការជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ពី គ្រោះមហន្តរាយ និង ដោះស្រាយ ការលំបាក ពេល មាន អាសន្ន និង គ្រោះ ធម្មជាតិ ផ្សេង ៗ ជា ស្មារតី ដ៏ មុតមាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ។
« ការងារ គ្រោះមហន្តរាយ នេះ ជា រឿង ចាំបាច់ ណាស់ សម្រាប់ ប្រទេស ក៏ ដូច លេី ពិភពលោក ព្រោះ កត្តា ធម្មជាតិ មាន ការប្រែប្រួល កាន់តែ ខ្លាំង ។ ដូច្នេះ យេីង ត្រូវ យកចិត្តទុកដាក់ ឱ្យ បាន ខ្ពស់ ដេីម្បី យេីង ជួយ ប្រជាពលរដ្ឋ បាន ទាន់ ពេលវេលា ពេល មាន គ្រោះ ធម្មជាតិ វាយប្រហារ » ។ លោក ទេសរដ្ឋមន្ត្រី បាន ក្រេីន រំលឹក ។
យោង តាម របាយការណ៍ របស់ លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រះវិហារ បាន ឱ្យដឹង ថា ក្នុង ឆ្នាំ ២០២០ កន្លងទៅ ខេត្ត ព្រះវិហារ បាន ជួបប្រទះ និង គ្រោះមហន្តរាយ ធម្មជាតិ មួយចំនួន ដូច ជា៖ ជំនន់ ទឹកភ្លៀង បាន ធ្វើឱ្យ ប៉ះពាល់ ផ្ទះ ប្រជាពលរដ្ឋ ចំនួន ៤១៨ ខ្នង ផ្ទះ ស្មើនឹង ៤៣៨ គ្រួសារ . ប៉ះពាល់ លើ ដី ស្រែ ចម្ការ ចំនួន ៣. ៧១៤ ហិកតា ស្មើនឹង ២. ៤៣៦ គ្រួសារ . ផ្ទៃដី ខូចខាត សរុប ១. ៤៨៤ ហិកតា ស្មើនឹង ១. ៣១៧ គ្រួសារ ។
ជាមួយគ្នា នេះ ខ្យល់ កន្ទ្រាក់ កើតឡើង ចំនួន ១៤លើក ប៉ះពាល់ ៥០៩ គ្រួសារ និង រន្ទះ បាញ់ កើតឡើង ចំនួន ១១ បណ្តាលឱ្យ របួស ចំនួន ៣នាក់ និង ស្លាប់ ចំនួន ៥នាក់ ។
ជា ការឆ្លេី យតប នឹង គ្រោះ ធម្មជាតិ នេះ គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ដោយ មាន ការគាំទ្រ ពី គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ សប្បុរសជន នានា ព្រមទាំង មាន កិច្ចសហការ ជាមួយ សាខា កាកបាទ ក្រហម ខេត្ត និង កាកបាទ ក្រហម កម្ពុជា បាន ចុះ សួរសុខទុក្ខ និង ចែក ពូជ ស្រូវ ដែល ជា អំណោយ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដល់ គ្រួសារ រងគ្រោះ ដោយ គ្រោះ មហន្តរាយ បាន ទាន់ ពេល វា លា ផងដែរ ៕
លោក Trong បាន លើកឡើង ថា ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ប្រទេស វៀតណាម បាន បន្ត អភិវឌ្ឍ ទៅ មុខ យ៉ាង ឆាប់រហ័ស និង ប្រកបដោយ និរន្តរភាព ហើយ ធ្វើឲ្យ ប្រជាជន វៀតណាម កាន់តែ មាន ទំនុកចិត្ត រឹងមាំ លើ គណបក្ស រដ្ឋាភិបាល និង របប សង្គម និយម របស់ វៀតណាម ។
បើ ក្រឡេក មើល ផ្នែក សេដ្ឋកិច្ច វៀតណាម បាន មើលឃើញ សេដ្ឋកិច្ច របស់ ខ្លួន ទទួល កំណើន យ៉ាង លឿន ជាង ប្រទេស ជាច្រើន ទៀត នៅក្នុង តំបន់ អាស៉ី ក្នុង អំឡុង ពេល មួយ ឆ្នាំ កន្លងមក នេះ រីឯ វិបត្តិ ជំងឺ រាតត្បាត សកល COVID-19 ក៏ ត្រូវបាន ទប់ស្កាត់ យ៉ាង ល្អ ក្នុង ប្រទេស វៀតណាម ផងដែរ ។
គួរ បញ្ជាក់ ថា សម្រាប់ រយៈពេល ប្រជុំ សរុប ៩ ថ្ងៃ ប្រតិភូ នៃ អង្គ សមាជ គណបក្ស កុម្មុយនិស្ត វៀតណាម នឹង ធ្វើ ការជ្រើសរើស ក្រុម ថ្នាក់ដឹកនាំ ថ្មី ព្រមទាំង ដាក់ ចេញ ផែនការ យុទ្ធសាស្រ្ត ថ្មី ៗ សម្រាប់ រយៈពេល ប៉ុន្មាន ឆ្នាំ ខាងមុខ ។ បក្ស កុម្មុយនិស្ត វៀតណាម បើក ប្រជុំ សមាជ រៀងរាល់ ៥ ឆ្នាំម្តង ៕
មន្ទីរ សុខាភិបាល ខេត្ត រតនគិរី បើក សិក្ខាសាលា ប្រព័ន្ធ បញ្ជូន អ្នកជំងី ដល់ បុគ្គលិក មណ្ឌល សុខភាព និង ស្រុក ប្រតិបត្តិ
( រតនគិរី ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ មន្ទីរ សុខាភិបាល ខេត្ត រតនគិរី សហការ ជាមួយ អង្គការ ហ្គូដណេប៊ឺស និង កូយ កាបាន បើក សិក្ខាសាលា ប្រព័ន្ធ បញ្ជូន អ្នកជំងឺ ជូន បុគ្គលិក មណ្ឌល សុខភាព និង ស្រុក ប្រតិបត្តិ ដែល មាន អ្នកចូលរួម ចំនួន ៤០ នាក់ ក្នុង នោះ មកពី ខេត្ត មណ្ឌលគិរី ចំនួន ៥នាក់ ។
ថ្លែង ទៅកាន់ សិក្ខាកាម លោក វេជ្ជបណ្ឌិត អ៊ុង រតនា បាន លើកឡើង ថា គម្រោង ខាងលើ គឺជា ការគិតគូរ រវាង មន្ទីរ និង ម្ចាស់ គម្រោង ពោលគឺ មិន មែន ជា ការកើតឡើង ដោយ ចៃដន្យ នោះ ទេ . ដូច្នេះ លោក ស្នើឲ្យ មន្ត្រី អនុវត្ត គម្រោង ខិតខំ ជាមួយគ្នា ឲ្យ អស់ ពី កម្លាំង កាយ កម្លាំងចិត្ត ដើម្បី ទទួលបាន ភាពជោគជ័យ ហើយ រូបលោក ក៏ បាន ថ្លែងអំណរគុណ មិត្ត កូរ៉េ ដែល ជួយ កម្ពុជា ។
សូម បញ្ជាក់ ថា មណ្ឌល សុខភាព និង ការិយាល័យ ប្រតិបត្តិ ស្រុក ទទួល កាណូត ចំនួន ១១គ្រឿង ( ខេត្ត រតនគិរី ) និង ម៉ូតូ ចំនួន ១២ គ្រឿង ក្នុង នោះ ខេត្ត មណ្ឌលគិរី ចំនួន ៣គ្រឿង ៕ អភិបាល ខេត្ត ស្វាយរៀង ជំរុញ ឲ្យ មន្ត្រី ដែល ពាក់ព័ន្ធ ទាំងអស់ អនុវត្ត ការងារ គ្រប់គ្រង ហិរញ្ញវត្ថុ នៅ ថ្នាក់ ក្រោម ជាតិ ឲ្យបាន កាន់តែ មាន ប្រសិទ្ធភាព និង ប្រសិទ្ធផល
( ស្វាយរៀង ) ៖ នៅក្នុង កិច្ចប្រជុំ ផុ្សព្វផ្សាយ សារាចរ ណ៏ លេខ ០១៥ សហវ ចុះ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ស្តីពី ការអនុវត្ត ច្បាប់ ស្តីពី ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០២១ របស់ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ
លោក ម៉ែន វិបុល បាន ស្នើ ដល់ ប្រធាន មន្ទីរ - អង្គភាព និង មន្ត្រី ពាក់ព័ន្ធ ត្រូវ ជំរុញ អនុវត្ត ឲ្យបាន ជោគជ័យ នូវ បណ្តា ផែនការ សកម្មភាព និង វិធានការកែលម្អ ការគ្រប់គ្រង ថវិកា និង បន្ត ដាក់ចេញ នូវ ផែនការ សកម្មភាព និង វិធានការ ថ្មី ៗ ទៀត ក្នុង ក្របខ័ណ្ឌ នៃ កម្មវិធី កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ និង យុទ្ធសាស្ត្រ នៃ ការកែទម្រង់ ប្រព័ន្ធ ថវិកា ឆ្នាំ ២០១៨ - ២០២៥ ។
( ភ្នំពេញ ) ៖ លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
រង្វង់ សិលា នេះ មាន សណ្ឋាន ជា រង្វង់ ខាងក្រៅ រង្វង់ កណ្ដាល និង រង្វង់ ខាងក្នុង ។ រង្វង់ ខាងក្រៅ មាន អង្កត់ផ្ចិត ៣០.៥ ម៉ែត្រ ដែល មាន សិលា ចំនួន ៣០ ដុំ ដោយ ក្នុង មួយ ដុំ ៗ មាន កម្ពស់ ជាង ៣ ម៉ែត្រ រីឯ រង្វង កណ្ដាល មាន អង្កត់ផ្ចិត ២៣ ម៉ែត្រ ដែល មាន សិលា ចំនួន ៤០ ដុំ ប៉ុន្តែ មាន តែ ២ ដុំ ប៉ុណ្ណោះ ដែល នៅ ឈរ ត្រង់ ហើយ មាន កម្ពស់ ៦.៧ ម៉ែត្រ ចំណែកឯ សិលា នៅ រង្វង់ ខាងក្នុង វិញ មាន អង្កត់ផ្ចិត ១៥ ម៉ែត្រ ដែល មាន សិលា ចំនួន ៤២ ដុំ កម្ពស់ ចន្លោះ ពី ២.១ ដល់ ៤ ម៉ែត្រ និង មាន ទម្ងន់ ជា មធ្យម ២៥ តោន ។
សំណង់ សិលា ទាំង នេះ ត្រូវបាន ក្រុម អ្នក បុរាណវិទ្យា សន្មត ថា ប្រហែលជា ត្រូវបាន កសាងឡើង តាំងពី ឆ្នាំ ៣០០០ - ២០០០ មុន គ្រិស្ដ សករាជ ពោលគឺ តាំងពី ជាង ៥០០០ ឆ្នាំ មុន មក ម្ល៉េះ ។
ក្នុង យុគសម័យ ទំនើប នេះ ស្តូន ហ៊ែង ជិ៍ គឺជា តំបន់ ទេសចរណ៍ ដ៏ ល្បីល្បាញ ប្រចាំ ចក្រភព អង់គ្លេស ហើយក៏ ជា និម្មិត រូប វប្បធម៌ របស់ ប្រទេស មហា អំណាច មួយ នេះ ផងដែរ ។ កាលពី ឆ្នាំ ១៨៨២ សភា អង់គ្លេស បាន អនុវត្ត កិច្ចអភិរក្ស នៅ តំបន់ ស្តូន ហ៊ែង ជិ៍ នេះ ប្រកបដោយ ភាពជោគជ័យ ដោយ ចាត់ទុក តំបន់ នេះ ជា តំបន់ បេតិកភណ្ឌ ដ៏ សំខាន់ មួយ របស់ ជាតិ ។ រហូតដល់ ឆ្នាំ ១៩៨៦ តំបន់ ស្តូន ហ៊ែង ជិ៍ ទាំងមូល ត្រូវបាន ចុះ ក្នុង បញ្ជីសម្បត្តិ បេតិកភណ្ឌ ពិភពលោក របស់ អង្គការ យូណេស្កូ ។
បច្ចុប្បន្ន តំបន់ បេតិកភណ្ឌ ពិភពលោក នេះ ស្ថិត នៅក្រោម ការគ្រប់គ្រង របស់ ព្រះរាជ វង្សានុវង្ស ចក្រភព អង់គ្លេស សហការ ជាមួយ អាជ្ញាធរ ជាតិ បេតិកភណ្ឌ អង់គ្លេស ដើម្បី អភិរក្ស ថែរក្សា និង គ្រប់គ្រង សម្បត្តិ បេតិកភណ្ឌ របស់ ជាតិ មួយ នេះ ឱ្យ បាន ល្អ ប្រសើរ ។
ក្រសួង សង្គមកិច្ច បាន ឈានដល់ ការគ្រប់គ្រង ទិន្នន័យ ជន មាន ពិការភាព ដោយ ប្រើ បច្ចេកវិទ្យា ឌីជីថល
លោក សួង ម៉េង ឡុង រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន លើកឡើង ក្នុង វគ្គ បណ្តុះបណ្តាល គ្រូ បង្គោល ថ្នាក់ ខេត្ត ស្តីពី ការប្រើប្រាស់ ប្រព័ន្ធ បច្ចេកវិទ្យា គ្រប់គ្រង ព័ត៌មាន ពិការភាព សម្រាប់ ២៥ រាជធានី ខេត្ត នា ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ ដែល មាន សមាសភាព អញ្ជើញ ចូលរួម ពី តំណាង មន្រ្តី នៃ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ទាំង ២៥ រាជធានី ខេត្ត តំណាង អង្គការ យូនី សេហ្វ ប្រចាំ កម្ពុជា ស្ថាប័ន ពាក់ព័ន្ធ នានា ។
លោក មាន ជំនឿ យ៉ាង មុតមាំ ថា តាមរយៈ ការអនុវត្តន៍ កម្មវិធី នេះ រាជ រដ្ឋាភិបាល អាច គ្រប់គ្រង ទិន្នន័យ ជន មាន ពិការភាព នៅ ទូទាំង ប្រទេស ការផ្តល់ សេវា ដល់ ជន មាន ពិក ការភាព កាន់តែ ប្រសើ ដែល ផ្តល់ អត្ថប្រយោជន៍ ជាច្រើន ដល់ ជន មាន ពិការ ភាពក្រីក្រ កាន់តែ ងាយស្រួល និង មាន ប្រសិទ្ធិភាព ដែល ជា ការលើកស្ទួយ ជីវភាព រស់ នៅ ធានា បាន ការរស់នៅ ដោយ ឯករាជ្យ សម្រាប់ ជន មាន ពិការភាព ៕
កុំ ចង់ សាកល្បង ប្រើ គ្រឿងញៀន សូម្បីតែ គិត ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៦ ខែ មក រា៖ បង្ក្រាប ៣៣ ករណី ឃាត់ខ្លួន ៧៧ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣៣ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១២ករណី . ជួញដូរ ២១ ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ៧៧ នាក់ ។
លោក ឧត្តមសេនីយ៍ ឯក យឹម លាង ប្រកាស បរិច្ចាគ បៀវត្ស រយៈពេល ៧ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក យឹម លាង នាយក រង ខុទ្ទកាល័យ សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា និង ជា អគ្គ ស្នងការ រង នគរបាល ជាតិ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស រយៈពេល ៧ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
ឧប នាយក រដ្ឋមន្ត្រី ម៉ែន សំអន ប្រកាស កាត់ បៀវត្ស រយៈពេល ៥ខែ ជូន ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច នា ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស កាត់ប្រាក់ បៀវត្ស រយៈពេល ៥ខែ ជូន ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ។
យោធា តៃវ៉ាន់ បាន ឲ្យដឹង ថា កង យន្តហោះ ចម្បាំង តៃវ៉ាន់ ជាធម្មតា តែងតែ ធ្វើ ប្រតិបត្តិការ ដោយ មាន បំពាក់ អាវុធ ដូចជា កាំភ្លើង យន្ត និង គ្រាប់ មីស៉ីល នៅពេល ឆ្លើយតប ចំពោះ សកម្មភាព របស់ យន្តហោះ ចម្បាំង ចិន ហើយ ពួកគេ មាន សមត្ថភាព អាច ចេញ ធ្វើ ការឆ្លើយតប បាន គ្រប់ ពេលវេលា ។
( ភ្នំពេញ ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ចំនួន ៧ខែ ចាប់ពី ខែកុម្ភៈ ដល់ ខែសីហា ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
គណៈ ចលនា មហាជន របស់ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២០ និង លើក ទិសដៅ ការងារ បន្ត
( ភ្នំពេញ ) ៖ នា ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នៅ វិមាន ៧មករា ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច និង ជា ប្រធាន គណៈ ចលនា មហាជន នៃ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា បាន ដឹកនាំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២០ និង លើក ទិសដៅ ការងារ បន្ត របស់ គណៈ ចលនា មហាជន ដោយ មាន ការអញ្ជើញ ចូលរួម សំណាក់ លោក លោកស្រី ដែល ជា អនុប្រធាន សមាជិក សមាជិកា ។
ក្នុង ដំណើរការកិច្ចប្រជុំ នេះ អគ្គ លេខាធិការដ្ឋាន នៃ គណៈ ចលនា មហាជន បាន ធ្វើ របាយការណ៍ ប្រចាំ ឆ្នាំ របស់ គណៈ ជំនាញ ទាំង៤គឺ គណៈ ចលនា យុវជន គណៈ ចលនា ស្ត្រី គណៈ ចលនា សហជីព និង គណៈ ចលនា អង្គការ សមាគមន៍ និង ដៃគូ អភិវឌ្ឍន៍ ពី សមិទ្ធផល នានា ដែល សម្រេចបាន ទោះបីជា សកម្មភាព មួយចំនួន ត្រូវបាន ប៉ះពាល់ ដោយ វិបត្តិ នៃ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ក៏ដោយ ក៏ នៅតែ អាច ទទួលបាន លទ្ធផល គួរ ជា ទី មោទនៈ ។
របាយកាណ៍ ក៏ បាន រៀបរាប់ ផងដែរ ពី បេសកកម្ម របស់ អគ្គ លេខាធិការដ្ឋាន ដែល ដឹកនាំ ដោយ លោក ហ៊ុន ម៉ានី ទៅកាន់ រាជធានី - ខេត្ត ចាប់ពី ចុង ឆ្នាំ ២០១៨ ឆ្នាំ ២០១៩ និង ឆ្នាំ ២០២០ ដើម្បី ណែនាំ តម្រង់ ទិស ពង្រឹង រចនាសម្ព័ន្ធ និង ពង្រឹង របៀបរបប ធ្វើ ការងារ ឲ្យបាន កាន់តែ ល្អ ប្រសើរ និង កាន់តែ មាន ប្រសិទ្ធភាព ។
ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន បាន ថ្លែង អបអរសាទរ និង ថ្លែងអំណរគុណ ដល់ ការខិតខំ ប្រឹងប្រែង របស់ គណៈ ទាំង៤ រួមទាំង អគ្គ លេខាធិការដ្ឋាន ដែល បាន សម្រេច ការងារ យ៉ាង ច្រើន ទោះបីជា ស្ថិត ក្នុង បរិបទ នៃ ការរីករាល នៃ ជំងឺ កូវីដ - ១៩ ក៏ដោយ ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ មាន យានយន្ត ៩០០ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ២៦ ថ្ងៃ នៃ ឆ្នាំ ២០២១ ការអនុវត្ត តាម អនុក្រឹត្យ លេខ ៣៩ ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៩ លើក ក្នុង នោះ ស្លាប់ ០៤ នាក់ របួស ១៧នាក់ ( របួស ធ្ងន់ ១២នាក់ ) ។
ស្រ្តី ម្នាក់ ដាក់ ពាក្យ បណ្តឹង មន្រ្តី យោធា ផ្កាយ ២ម្នាក់ ទៅ តុលាការ ខេត្ត កំពង់ស្ពឺ ពី បទ វាយតប់ និង គម្រាម បាញ់ សម្លាប់
( កំពង់ស្ពឺ ) ៖ ស្ត្រី រងគ្រោះ ម្នាក់ ឈ្មោះ ឌួង ហេម៉ាលី ស ដែល ត្រូវ យោធា ផ្កាយ ២ឈ្មោះ សូយ ចាន់ សឿន តួនាទី ជា នាយ រង ទី ចាត់ការអភិវឌ្ឍន៍ អគ្គ បញ្ជាការ ក្រសួង ការពារ ជាតិ វាយតប់ ខ្លួន ឲ្យ មាន របួស ស្នាម ធ្ងន់ធ្ងរ និង គម្រាម សម្លាប់ ផង នោះ បាន ប្ដឹង ចូល អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ស្ពឺ ដោយ ចោទប្រកាន់ ពី បទ « ប្រើ អំពើហិង្សា ដោយ មាន ស្ថាន ទម្ងន់ និង បង្ខាំង ដោយ ខុស ច្បាប់ » ដែល បាន ប្រព្រឹត្ត មក លើ ខ្លួន កាលពី ថ្ងៃទី ២២ ខែមករា ឆ្នាំ ២០២១ កន្លងទៅ ថ្មី នេះ ។
ស្ត្រី រងគ្រោះ បាន ប្រាប់ មក ភ្នាក់ងារ អង្គភាព ព័ត៌មាន Fresh News ឲ្យដឹង ថា ដើមហេតុ ដែល នាំឲ្យ កើត ហិង្សា យ៉ាង ដូច្នេះ និង ដំណើរ រឿង ថា ដោយសារតែ ទាស់ សំដី គ្នា បន្តិចបន្តួច ពាក់ព័ន្ធ ការផ្ដល់ យោបល់ ផ្លូវ ច្បាប់ ជុំវិញ ករណី ប្ដឹង ប្ដល់ គ្នា លើ ករណី វិវាទ ដីធ្លី របស់ លោក សូយ ចាន់ សឿន ហើយ បុគ្គល រូប នេះ កើត ការខឹងសម្បា ដូច កម្រោល ចូល ក៏ បាន ដាល់ ចំភ្នែក កញ្ចឹងក និង លើ ទ្រូង ជាច្រើន ដៃ បណ្ដាលឲ្យ វិលមុខ ដែល ការវាយ នេះ នៅ ម្ដុំ រង្វង់ មូល តា ខ្មៅ ខេត្ត កណ្ដាល ។
ស្ត្រី ដដែល បាន បញ្ជាក់ ទៀត ថា ខ្លួន បាន ដាក់បណ្ដឹង ចូល អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ស្ពឺ រួចរាល់ហើយ ដើម្បី រក យុត្តិធម៌ ជូន ខ្លួន ព្រោះ ការឈឺចាប់ ផ្លូវកាយ និង ផ្លូវចិត្ត នេះ មាន ទំហំ ធំធេង ណាស់ ខណៈ ខ្លួន ជា នារី ទន់ខ្សោយ ប៉ុន្តែ បែរជា ត្រូវ បុរស មាឌ ធំ ម្នាក់ វាយប្រហារ យ៉ាង សាហាវ យ៉ាង ដូច្នេះ ដោយ គ្មាន គោរ សិទ្ធិ ស្ត្រី សូម្បី បន្តិច ។
ខាងក្រោម ជា ពាក្យ បណ្តឹង របស់ ជនរង ជា ស្រ្តី ឈ្មោះ ឌួង ហេម៉ាលី ស៖ រដ្ឋមន្ត្រី ថោង ខុន ប្រកាស កាត់ បៀវត្ស រយៈពេល ៧ខែ ជូន ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ នា ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស កាត់ប្រាក់ បៀវត្ស រយៈពេល ៧ខែ ចាប់ពី ខែកុម្ភៈ ដល់ ខែសីហា ជូន ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច ឯកឧត្តម លោកជំទាវ លោក លោកស្រី ទាំង ស្ថាបន័ស៊ីវិល និង កម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ដែល បាន បរិច្ចាគ ដោយ ការកាត់ បៀវត្ស ទាំងស្រុង ឬមួយ ផ្នែក រយៈពេល ខ្លី ឬ វែង តាម ការស្ម័គ្រចិត្ត ជួយ ដល់ ការងារ ប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ ដែល បង្ហាញ ឱ្យ ឃើញ នូវ សាមគ្គីភាព ក្នុង ខឿន ការពារ សុខភាព របស់ ប្រជាជន កម្ពុជា ៕ UPDATE: ស្ត្រី ម្នាក់ ត្រូវបាន ឃាតក អារ - ក បណ្ដាលឲ្យ ស្លាប់ ចោល កូន តូច ៗ កំព្រា៣ នាក់ . សមត្ថកិច្ច កំពុង តាម ចាប់ ឃាតក យកមក ផ្តន្ទាទោស
