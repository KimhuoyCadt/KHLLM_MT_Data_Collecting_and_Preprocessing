* ត្រូវ ចេះ ការពារ ខ្លួន និង ធ្វើ អនាម័យ ជាប្រចាំ ដើម្បី ចៀស ផុត ពី ជម្ងឺ គ្រប់ ប្រភេទ ពិសេស COVID-19* ត្រូវ បន្ត អនុវត្ត ឲ្យបាន ជោគជ័យ នូវ ទិសដៅ ការងារ ឆ្នាំ ២០២១ របស់ សាខា និង ពង្រឹង រចនាសម្ព័ន្ធ រក្សា ស្មារតី សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ឲ្យ កាន់តែ រឹងមាំ * ពង្រឹង សមត្ថភាព ផ្ទាល់ខ្លួន ជាប្រចាំ ទាំង ផ្នែក ជំនាញ និង បច្ចេកទេស ដើម្បី ជា ផលប្រយោជន៍ និង ឆ្លើយតប នឹង សេចក្តីត្រូវការ របស់ ប្រជាពលរដ្ឋ គ្រប់ លំដាប់ថ្នាក់ ពិសេស ស្ត្រី និង កុមារ ៕
នៅក្នុង សេចក្ដីជូនដំណឹង រដ្ឋបាល សុវត្ថិភាព សមុទ្រ នៃ រដ្ឋាភិបាល ចិន បាន បញ្ជាក់ ពី ការហាមឃាត់ ការធ្វើដំណើរ ចូល ទៅកាន់ តំបន់ ខ្លះ ចាប់ពី ដែន ទឹក ក្នុង តំបន់ ឈូង សមុទ្រ តង់ កឹង រហូតដល់ ភាគ ខាងលិច នៃ ឧបទ្វីប Leizhou ស្ថិត នៅ នីរតី នៃ ប្រទេស ចាប់ពី ថ្ងៃទី ២៧ រហូតដល់ ថ្ងៃទី៣០ ខែមករា នេះ ។ ប៉ុន្តែ រដ្ឋបាល សុវត្ថិភាព សមុទ្រ ចិន មិន បាន លម្អិត ថា តើ សមយុទ្ធ យោធា នេះ មាន លក្ខណៈ ទ្រង់ទ្រាយ ធំ ឬ តូច នោះ ទេ ហើយក៏ មិន បាន ឱ្យដឹង ថា វា នឹង ធ្វើឡើង នៅ ពេលណា ឱ្យ ប្រាកដ នោះ ដែរ ។
ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា ប្រកាស កាត់ បៀវត្ស រយៈពេល ៧ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស កាត់ បៀវត្ស រយៈពេល ៧ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច ឯកឧត្តម លោកជំទាវ លោក លោកស្រី ទាំង ស្ថាបន័ស៊ីវិល និង កម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ដែល បាន បរិច្ចាគ ដោយ ការកាត់ បៀវត្ស ទាំងស្រុង ឬមួយ ផ្នែក រយៈពេល ខ្លី ឬ វែង តាម ការស្ម័គ្រចិត្ត ជួយ ដល់ ការងារ ប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ ដែល បង្ហាញ ឱយ ឃើញ នូវ សាមគ្គីភាព ក្នុង ខឿន ការពារ សុខភាព របស់ ប្រជាជន កម្ពុជា ៕ លោក មួន សារ៉ន ប្រកាស កាត់ បៀវត្ស រយៈពេល ៧ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក មួន សារ៉ន ទីប្រឹក្សា ផ្ទាល់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស កាត់ បៀវត្ស រយៈពេល ៧ខែ ទៀត ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ គឺ ចាប់ពី ខែកុម្ភៈ ដល់ ខែសីហា ឆ្នាំ ២០២១ ។
ការប្រកាស របស់ លោក មួន សារ៉ន នេះ បាន ធ្វើឡើង ភ្លាម ៗ បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ប្រកាស បន្ត កាត់ បៀវត្ស រយៈពេល ៧ខែ ទៀត ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ការកាត់ បៀវត្ស របស់ លោក មួន សារ៉ន រយៈពេល ៧ខែ ទៀត នេះ គឺជា លើក ទី២ ហើយ ដែល កន្លងមក លោក ធ្លាប់ បាន ប្រកាស កាត់ បៀវត្ស រយៈពេល ៧ខែ លើក ទី១ ក្នុង ឆ្នាំ ២០២០ ។
សមាគម សភា ពាណិជ្ជកម្ម ចិន ខេត្ត ហ៊ូណាន នៅ កម្ពុជា ផ្ដល់ សម្ភារ បរិក្ខារ វេជ្ជសាស្ដ្រ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ ដល់ ក្រសួង សុខាភិបាល
( ភ្នំពេញ ) ៖ សមាគម សភា ពាណិជ្ជកម្ម ចិន ខេត្ត ហ៊ូណាន នៅ កម្ពុជា បាន ផ្ដល់ សម្ភារ បរិក្ខារ វេជ្ជសាស្ដ្រ សម្រាប់ ប្រើប្រាស់ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ ដល់ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ ។
ពិធី ប្រគល់ - ទទួល នេះ បាន ធ្វើឡើង នាទី ស្ដីការ ក្រសួង សុខាភិបាល ក្រោម អធិបតីភាព លោកស្រី យក់ សម្បត្ដិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន ក្រុមការងារ ប្រតិបត្តិការ បច្ចេកទេស និង ផ្គត់ផ្គង់ នៃ គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ និង ថ្នាក់ដឹកនាំ ជាច្រើន រូប ទៀត ។
ក្នុង ឱកាស នោះ លោកស្រី យក់ សម្បត្ដិ បាន សម្តែង ការថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន ចិន រួមទាំង សមាគម សភា ពាណិជ្ជកម្ម ចិន ខេត្ត ហ៊ូណាន នៅ កម្ពុជា ដែល តែងតែ ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ វិស័យ សុខាភិបាល កម្ពុជា ។
លោកស្រី ថ្លែង បន្ត ថា ជំនួយ ទាំងនេះ បាន បញ្ជាក់ ពី ការយកចិត្តទុកដាក់ ខ្ពស់ របស់ សមាគម សភា ពាណិជ្ជកម្ម ចិន ខេត្ត ហ៊ូណាន នៅ កម្ពុជា ចំពោះ រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា ជាពិសេសេ ក្នុង កាលៈទេសៈ បច្ចុប្បន្ន ដែល យើង កំពុង បាន ខិតខំ ប្រឹងប្រែង រួមគ្នា ដើម្បី ជំរុញ វិធានការ ការពារ ទប់ស្កាត់ និង ឆ្លើយតប ការរាតត្បាត នៃ ជំងឺ កូវីដ - ១៩ ឲ្យបាន កាន់តែ ឆាប់រហ័ស ៕
ចិន និង នូវែលសេឡង់ ចុះ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម ថ្មី មួយ សំដៅ កាត់បន្ថយ របាំង ពាណិជ្ជកម្ម (Video inside) ( នូវែលសេឡង់ ) ៖ ចិន និង នូវែលសេឡង់ បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ថ្មី មួយ ដែល នឹង ធ្វើឱ្យ កាន់តែ ល្អ ប្រសើរឡើង នូវ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី ដែល មាន ស្រាប់ រវាង ប្រទេស ទាំង២ ខណៈ ទីក្រុង ប៉េកាំង កំពុង ស្នើ ឱ្យ មាន ការចូលរួម កាត់បន្ថយ របាំង ពាណិជ្ជកម្ម សកល ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA នៅ ថ្ងៃអង្គារ ទី ២៦ ខែមករា ឆ្នាំ ២០២១ ។
គួរ បញ្ជាក់ ថា បើ តាម កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម ថ្មី ខាងលើ ពន្ធ លើ ផលិតផល មួយចំនួន ធំ របស់ នូវែលសេឡង់ ចូលក្នុង ប្រទេស ចិន ក្នុង នោះ រួម មាន ចំណីអាហារ ធ្វើ ពី ទឹកដោះ គោ និង គ្រឿង សមុទ្រ ជាដើម នឹង ត្រូវបាន លុបចោល ឬ ក៏ កាត់បន្ថយ ។ ចិន បច្ចុប្បន្ន ជា ដៃគូ ពាណិជ្ជកម្ម ដ៏ ធំ របស់ នូវែលសេឡង់ ដោយ ទំហំ ពាណិជ្ជកម្ម ទាំង នាំចេញ និង នាំចូល ប្រចាំ ឆ្នាំ រវាង ប្រទេស ទាំង២ គឺ មាន ប្រហែល ២១.៥៨ ពាន់ លាន ដុល្លារ ៕
គួរ បញ្ជាក់ ថា ការសម្រេចចិត្ត ខាងលើ របស់ លោក ចូ បៃ ដិន កើត មាន ឡើង តែ ជាង មួយ សប្ដាហ៍ ប៉ុណ្ណោះ បន្ទាប់ពី លោក ដូណាល់ ត្រាំ នៅ មុន ផុត អាណត្តិ ជា ប្រធានាធិបតី បាន ចុះហត្ថលេខា លើ បទបញ្ជា ប្រតិបត្តិ មួយ ដោយ បង្គាប់ឱ្យ លុបចោល ការរឹតត្បិត ការធ្វើដំណើរ មកកាន់ សហរដ្ឋ អាមេរិក លើ បណ្ដា ប្រទេស ទាំងនោះ ដែល ត្រូវ ចូល ជាធរមាន កាលពី ថ្ងៃទី ២៦ ខែមករា កន្លងទៅ ៕
ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ ចេញ លិខិត បំភ្លឺ អំពី ដំណើរ រឿង នៃ ការរឹបអូស រថយន្ត ៥០ គ្រឿង ពី ក្រុមហ៊ុន ចិន្តា សុវណ្ណ
( ភ្នំពេញ ) ៖ ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ចេញ លិខិត បំភ្លឺ អំពី ដំណើរ រឿង នៃ ការរឹបអូស រថយន្ត ៥០ គ្រឿង ពី ក្រុមហ៊ុន ចិន្តា សុវណ្ណ កាលពី ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ ។
ខាងក្រោម ជា លិខិត បំភ្លឺ ទាំងស្រុង របស់ ក្រុម មេធាវី កម្ព ជា សហប្រតិបត្តិការ អន្តរជាតិ ជូន សាធារណជន ដូច ខាងក្រោម នេះ៖
លោក ដូណាល់ ត្រាំ បើក ការិយាល័យ ផ្ទាល់ខ្លួន ក្នុង នាម ជា អតីត ប្រធានាធិបតី
( វ៉ាស៉ីន តោន ) ៖ លោក ដូណាល់ ត្រាំ នា ថ្ងៃចន្ទ សប្តាហ៍ នេះ ( ពេលវេលា នៅ សហរដ្ឋ អាមេរិក ) បាន បើក ការិយាល័យ មួយ ដែល នឹង ទទួលបន្ទុក ចាត់ចែង កាតព្វកិច្ច របស់ លោក ក្នុង នាម ជា អតីត ប្រធានា ធីបតី អាមេរិក ម្នាក់ ព្រមទាំង បន្ត ជំរុញ គោលដៅ នៃ អតីត រដ្ឋបាល របស់ លោក ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA នៅ រសៀល ថ្ងៃអង្គារ ទី ២៦ ខែមករា ឆ្នាំ ២០២១ ។
ការិយាល័យ ខាងលើ នឹង មាន តួនាទី រៀបចំ កិច្ចការ សំខាន់ មួយចំនួន ដូចជា ការទំនាក់ទំនង . សេចក្តីថ្លែងការណ៍ . ការបង្ហាញ វត្តមាន . និង សកម្មភាព ផ្លូវការ នានា របស់ លោក ដូណាល់ ត្រាំ ក្រោម គោលដៅ ជំរុញ ក៏ ដូចជា បន្ត លើកកម្ពស់ ផលប្រយោជន៍ ជាតិ អាមេរិក ព្រមទាំង បន្ត នូវ គោលដៅ នៃ អតីត រដ្ឋបាល របស់ លោក តាមរយៈ ការចូលរួម សកម្មភាព ផ្សេង ៗ ។
រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង ចាប់ផ្ដើម នា វេលា ម៉ោង ៩ព្រឹក រហូតដល់ ម៉ោង ៤នាទី ល្ងាច ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ ចាប់ពី ចំណុច កោះ ទន្លា ក្រាស់ តំបន់ កដប ស្ថិត ក្នុង ភូមិ កំពង់ថ្គោល ឃុំ អន្សា ចំបក់ ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ រហូតដល់ ព្រំប្រទល់ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង ( លើ ផ្ទៃ ទឹក បឹង ទន្លេ សាប ) ។
លោក វរសេនីយ៍ ទោ បាន បន្ត ថា ក្នុង ប្រតិបត្តិការ នេះ កម្លាំង ជំនាញ ធ្វើ មួយ ថ្ងៃ ពេញ ហើយ ប្រសិនបើ ជា នៅ មាន បន្ត ទៀត នឹង អនុវត្ត នៅ ថ្ងៃ បន្តបន្ទាប់ រហូត បទល្មើស បាន ស្រាកស្រាន្ត ។ លោក ស្នងការ រង បន្ថែម ថា ភាគ ច្រើន បទល្មើស គឺ មកពី ខេត្ត កំពង់ឆ្នាំង ខេត្ត កំពង់ធំ និង ខេត្ត សៀមរាប ដោយ ពួកគេ ចូលមក ដាក់ របាំង សាច់ អួន . បរ និង សម្រាស់ នៅលើ តំបន់ កដប ស្ថិត ក្នុង ភូមិសាស្ត្រ ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ ។
លោក បន្ថែម ថា ឧបករណ៍ ល្មើស ច្បាប់ ទាំងនោះ គឺ សុទ្ធសឹង ជា ឧបករណ៍ ដែល ថ្មី និង ទំនើប ដែល អាច ស្ទាក់ ចាប់ ត្រី ចម្រុះ គ្រប់ ប្រភេទ ជាពិសេស ធ្វើឲ្យ ខាតបង់ ធនធាន ជល ផល ស្ទើរ គ្មាន សល់ ។
ចំពោះ វត្ថុតាង ត្រូវបាន កាប់បំផ្លាញ ចោល នៅនឹង កន្លែង ដោយឡែក ជនសង្ស័យ កម្លាំង ជំនាញ បាន និង កំពុង កំណត់ មុខ សញ្ញា នាំ ខ្លួន មក ចាត់ការ តាម នីតិវិធី ៕
យោង តាម លោក Whitley ការរក្សាទុក កម្លាំង ឆ្មាំ ជាតិ ច្រើន បែប នេះ ឲ្យ នៅ ឈរ ជើង ក្នុង ទីក្រុង វ៉ាស៉ីនតោន រហូតដល់ ពាក់កណ្តាល ខែមីនា គឺ ដោយសារតែ មាន ការព្រួយបារម្ភ បញ្ហា សន្តិសុខ ជុំវិញ លទ្ធភាព នៃ ការផ្ទុះឡើង នូវ ការធ្វើ បាតុកម្ម ក៏ ដូចជា ភាពវឹកវរ ក្នុង អំឡុង ពេល ប៉ុន្មាន សប្តាហ៍ ខាងមុខ ។
កន្លងមក នេះ កងកម្លាំង ឆ្មាំ ជាតិ រហូតដល់ ២៥.០០០ នាក់ ត្រូវបាន ដាក់ពង្រាយ នៅ ទីក្រុង វ៉ាស៉ីនតោន ដើម្បី រក្សា សន្តិសុខ ពិធី ស្បថ ចូលកាន់ តំណែង របស់ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន បន្ទាប់ពី មាន ការ ធ្វើ កុបកម្ម យ៉ាង កក្រើក នៅ វិមាន សភា អាមេរិក កាលពី ថ្ងៃទី ០៦ ខែមករា ។ បច្ចុប្បន្ន នៅ មាន វត្តមាន កងកម្លាំង ឆ្មាំ ជាតិ ១៥.០០០ នាក់ ក្នុង រដ្ឋធានី របស់ អាមេរិក ។ វា នឹង ត្រូវ បន្ថយ នៅ ៧.០០០ នាក់ ត្រឹម ចុង សប្តាហ៍ នេះ ហើយ នឹង បន្ត ថយ ទៀត នៅ ខ្ទង់ ៥. ៦០០ នាក់ ត្រឹម ពាក់កណ្តាល ខែមីនា ។
គួរ បញ្ជាក់ ថា ព្រឹទ្ធសភា អាមេរិក បើក សវនាការ ជំនុំជម្រះ លើ « ដំណើរការ កាត់ទោស អតីត ប្រធានាធិបតី លោក ដូណាល់ ត្រាំ » នៅ សប្តាហ៍ ទី២ នៃ ខែកុម្ភៈ ហើយ ត្រូវ គេ រំពឹង ថា អាចនឹង បន្ត រហូតដល់ ខ្ទង់ ពាក់កណ្តាល ខែមីនា ៕
នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន ប្រកាស កាត់ បៀវត្ស រយៈពេល ៧ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស កាត់ បៀវត្ស រយៈពេល ៧ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
ការប្រកាស របស់ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន នេះ បាន ធ្វើឡើង ភ្លាម ៗ បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ប្រកាស បន្ត កាត់ បៀវត្ស រយៈពេល ៧ខែ ទៀត ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ការកាត់ បៀវត្ស របស់ សម្តេច តេជោ ហ៊ុន សែន រយៈពេល ៧ខែ ទៀត នេះ គឺ ចាប់ពី ខែកុម្ភៈ ដល់ ខែសីហា ឆ្នាំ ២០២១ ។
ចាប់ខ្លួន ឃាត ក រំលោភ សម្លាប់ ស្ត្រី មេម៉ាយ ខណៈ នាង ពឹង អោយ ជូន ទៅ ផ្ទះ លេង កូន
( កោះកុង) ៖ ដោយ អនុវត្តន៍ តាម បទបញ្ជា របស់ ក្រសួង មហាផ្ទៃ និង ការចង្អុលបង្ហាញ របស់ ឧត្តមសេនី យ៏ ទោ គង់ ម នោ ស្នងការ នគរបាល ខេត្ត កោះកុង នៅ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២១ សមត្ថកិច្ច ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កោះកុង បាន សហការណ៍ ជាមួយ កម្លាំង អធិការ នគរបាល ស្រុក កោះ កុង ស្រាវជ្រាវ រក ជន ដៃ ដល់ ករណី រំលោភ សម្លាប់ គិត ទុក ជាមុន ស្ថិត នៅ ចំណុច ដី ខ្មៅ ភូមិ ដី ទំនាប់ ឃុំ ត្រពាំង រូង ស្រុក កោះ កុង ខេត្ត កោះកុង ។
លោក វរៈ សេនីយ៍ ឯក ឡាយ ទីរ៉ូ នាយ ការិល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ បាន ឲ្យដឹង ថា ករណី ឃាតកម្ម គិត ទុក ជា មុន នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ៦ និង ៣០ នាទី ល្ងាច ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០២១ ស្ថិត នៅ ចំណុច ដី ខ្មៅ ភូមិ ដី ទំនាប់ ឃុំ ត្រពាំង រូង ស្រុក កោះ កុង ខេត្ត កោះកុង ។
ជនសង្ស័យ ឈ្មោះ ហុីម សា អាត ហៅ អ៊ូ អារី ហ្វីន ភេទ ប្រុស អាយុ ១៨ ឆ្នាំ ជនជាតិ ខ្មែរ ឥស្លាម មុខរបរ កម្មករ រោងចក្រ KK១ ស្នាក់ នៅ បណ្តោះអាសន្ន នៅ ភូមិ ៤ សង្កាត់ ដង ទង់ ក្រុង ខេមរភូមិន្ទ ។
តាម ការសាភាព របស់ ជនសង្ស័យ បាន សាភាព ថា ខ្លួន និង ជនរងគ្រោះ មាន ទីលំនៅ ភូមិ សុវណ្ណ បៃតង ឃុំ កណ្តោល ស្រុក បុទុម សាគរ ខេត្ត កោះកុង ជាមួយគ្នា ។ ជនសង្ស័យ បាន បន្ត ថា ខ្លួន បាន ដឹង ថា ជនរងគ្រោះ ចង់ ទៅ លេង ផ្ទះ ដោយ នឹក កូន ខ្លួន ក៏ សន្យា ថា ខ្លួន នឹង ជូន ទៅ ដោយ ជិះ ម៉ូតូ ទៅ ជាមួយគ្នា ដល់ ចំណុច កើត ហេតុ ខ្លួន ជា ជនសង្ស័យ បាន ឈប់ ម៉ូតូ ហើយ ចាប់ ជនរងគ្រោះ ចូល ព្រៃ ធ្វើ សកម្មភាព រំលោភ តែ នាង រើ បម្រះ ខ្លាំង ដោយ ខ្លាច បែក ការណ៏ក៍ សម្លាប់ បំបិត មាត់ ម្តង ទៅ ។
លោក វរសេនី យ៏ ឯក ឡាយ ទីរ៉ូ បាន បញ្ជាក់ ថា ចំពោះ សាកសព ជនរងគ្រោះ ក្រោយពី ធ្វើ កោសល វិច្ច័យ រួចរាល់ ហើយ បាន ប្រគល់ជូន សាច់ញាតិ យក ទៅ ធ្វើ បុណ្យ ទៅ តាម ប្រពៃណី ។ ចំពោះ ជនសង្ស័យ សមត្ថកិច្ច បាន កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ដើម្បី វិនិច្ច័យ ទោស ទៅ តាម ផ្លូវ ច្បាប់ ៕ រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
ការប្រកាស របស់ រដ្ឋមន្ត្រី ជា វ៉ាន់ ដេត នេះ ធ្វើឡើង ភ្លាម ៗ បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ប្រកាស បន្ត កាត់ បៀវត្ស រយៈពេល ៧ខែ ទៀត ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ការកាត់ បៀវត្ស របស់ សម្តេច តេជោ ហ៊ុន សែន រយៈពេល ៧ខែ ទៀត នេះ គឺ ចាប់ពី ខែកុម្ភៈ ដល់ ខែសីហា ឆ្នាំ ២០២១ ។
សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ សាលា បឋមសិក្សា ១ខ្នង . លោកស្រី មិថុនា ភូថង ជំរុញ ឱ្យ សិស្សានុសិស្ស ត្រូវ យក ការសិក្សា ជា ចម្បង ដើម្បី អនាគត ខ្លួន និង ក្រុមគ្រួសារ
( កោះកុង ) ៖ លោកស្រី មិថុនា ភូថង អភិបាល ខេត្ត កោះកុង បាន ដឹកនាំ មន្រ្តី ក្រោម ឱវាទ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ អគារ សិក្សា ០១ ខ្នង មាន ០៥ បន្ទប់ ដែល ជា ហេដ្ឋារចនាសម្ព័ន្ធ ថ្មី មួយ ក្នុង វិស័យ អប់រំ ផ្តល់ ជូន មូលដ្ឋាន តំបន់ ដាច់ស្រយាល ដែល ត្រូវបាន សាងសង់ ឡើង ក្នុង បរិវេណ សាលា បឋមសិក្សា តា មាឃ ស្ថិត ក្នុង ភូមិ តា មាឃ ឃុំ អណ្តូង ទឹក ស្រុក បូទុម សាគរ ខេត្ត កោះកុង ក្រោម ជំនួយ ឧបត្ថម្ភ ពី អង្គការ ដៃគូ អភិវឌ្ឍន៍ ។
ពិធី សម្ភោធ នេះ ដែរ បាន ធ្វើឡើង នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ ក្នុង បរិវេណ សាលា បឋមសិក្សា តា មាឃ និង ដោយ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ជាច្រើន នាក់ ផងដែរ ។
លោកស្រី អភិបាល ខេត្ត បាន ថ្លែង បន្ត ថា នៅ ឆ្នាំ សិក្សា ថ្មី នេះ ក៏ នៅតែ ផ្តោត លើ ការស្វែងរក និង ប្រមូល កុមារ ឱ្យ បាន ចូល រៀន គ្រប់ ៗ គ្នា ទោះបី ពួកគេ ស្ថិត នៅ ទីណា ក្នុង ស្ថាន ភាព បែប ណា ក៏ដោយ ។ ពោលគឺ ត្រូវ ទៅ ឱ្យ ដល់ កន្លែងណា ដែល យើង ទៅ មិន ទាន់ ដល់ ស្រប ពេល ជាមួយគ្នា នឹង ការពង្រឹង គុណភាព និង ចីរភាព ដើម្បី ធានា បាន នូវ ការផ្តល់ សេវា អប់រំ ឱ្យ បាន គ្រប់ ទីកន្លែង និង គ្រប់ ស្ថានភាព ទាំង តំបន់ ជួប ការលំបាក តំបន់ ដាច់ស្រយាល ។
ជាមួយគ្នា នេះ ក៏ ត្រូវ យកចិត្តទុកដាក់ អនុវត្ត សិទ្ធិ កុមារ នៅ គ្រប់ គ្រឹះស្ថាន សិក្សា ដោយ ទាក់ទាញ ឱ្យ មាន ការចូលរួម ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ជាពិសេស មាតាបិតា អាណា ព្យាបាល សិស្ស ក្នុង ការបង្កើន បរិស្ថាន រៀនសូត្រ ឱ្យ ដល់ សិស្សានុសិស្ស ឱ្យ ប្រកបដោយ ផាសុកភាព ទាំង ផ្លូវកាយ និង ផ្លូវចិត្ត ។ ពោលគឺ ត្រូវ ចៀសវាង អំពើហិង្សា នានា ចំពោះ កុមារ ។
លោកស្រី បន្ត ថា នេះ ជា កាតព្វកិច្ច ធំ ធេង ណាស់ សម្រាប់ លោកគ្រូ អ្នកគ្រូ ទាំងអស់ ដែល ត្រូវ យកចិត្តទុកដាក់ នៅ គ្រប់ ទីកន្លែង ទោះជា តំបន់ ជួប ការលំបាក តំបន់ ដាច់ ស្រយាល និង តំបន់ ព្រំដែន ជាដើម ។ លោកស្រី ក៏ បាន ផ្តាំផ្ញើ ដល់ សិស្សានុសិស្ស ទាំងអស់ ត្រូវ ជៀស ឲ្យ ពី គ្រឿងញៀន ត្រូវ យក ការសិក្សា ជា ចម្បង ដើម្បី អនាគត ខ្លួន និង គ្រួសារ និង ប្រទេសជាតិ ពីព្រោះ សិស្សានុសិស្ស គឺជា ទំពាំង ស្នង ឬស្សី នៃ ប្រទេសជាតិ ។
លោកស្រី បញ្ជាក់ ថា រដ្ឋបាល ខេត្ត ក៏ ដូចជា សំណូមពរ របស់ លោកស្រី គឺ សូម ស្នើឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ បន្ត ការចូលរួម និង បន្ត អនុវត្ត យ៉ាង ម៉ឺងម៉ាត់ នូវ យុទ្ធសាស្ត្រ ដែល បាន ដាក់ចេញ ដោយ រាជ រដ្ឋាភិបាល ព្រមទាំង គោលការណ៍ ណែនាំ នានា របស់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ នេះ ឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ បន្ត ទៀត ៕
រដ្ឋបាល ខណ្ឌ ជ្រោយ ចង្វារ ចេញ សេចក្តីប្រកាស ព័ត៌មាន បកស្រាយ ចំពោះ ការចុះ ពិនិត្យ ស្រាវជ្រាវ និង វាស់វែង ដីធ្លី តាម សំណើ របស់ មន្ទីរ និង ម្ចាស់ ដី
( ភ្នំពេញ ) ៖ រដ្ឋបាល ខណ្ឌ ជ្រោយ ចង្វារ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ករណី ចុះ ពិនិត្យ ស្រាវជ្រាវ និង វាស់វែង ដី កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ មាន ទីតាំង ស្ថិត នៅ ផ្លូវ ទន្លេ មេគង្គ ក្រុម ទី២ ភូមិ ១សង្កាត់ ជ្រោយចង្វារ ខណ្ឌ ជ្រោយ ចង្វារ ក្រោយ មាន សំណើ របស់ មន្ទីរ ជំនាញ និង ម្ចាស់ ដី ក្រោយ មាន ការផ្សព្វផ្សាយ ថា អាជ្ញាធរ ខណ្ឌ បាន ដោះស្រាយ ដោយ អយុធម៌ សម្រាប់ ភាគី ម្ខាង ទៀត ។
ខាងក្រោម នេះ ជា ការបញ្ជាក់ របស់ សាលា ខណ្ឌ ជ្រោយ ចង្វា រ៖
គ្រួសារ សព មន្ត្រី ពន្ធនាគារ ខេត្ត កំពង់ឆ្នាំង ទទួលបាន អំណោយ ពី លោក ឌី វិជ្ជា និង លោកស្រី ហ៊ុន ម៉ាណា រួមទាំង ថវិកា សមាគម ផងដែរ ក្រោយមន្ត្រី មិន ព្រម បើក អោយ អស់ រយៈពេល ៣ ខែ
( កំពង់ឆ្នាំង ) ៖ តំណាង លោក ឌី វិជ្ជា និង លោកស្រី ហ៊ុន ម៉ាណា នៅ ល្ងាច ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ បាន នាំយក អំណោយ ទៅ ប្រគល់ ជូន លោកស្រី វង្ស សុវណ្ណារី អាយុ ៦០ ឆ្នាំ ជា ភរិយា លោក វរសេនីយ៍ ទោ ពេជ្រ សុខ ជា មន្ត្រី ពន្ធនាគារ ខេត្ត កំពង់ឆ្នាំង ដែល បាន ទទួលមរណភាព ជាង ៣ខែ មក ហើយ ដោយ រោគារ ពាធ ដែល មាន ទីលំនៅ ក្នុង ភូមិ ដំណាក់ ពពូល សង្កាត់ កំពង់ឆ្នាំង ក្រុង កំពង់ឆ្នាំង ។ ក្នុង នោះ ថវិកា សមាគម ដែល មន្ត្រី សាលា ខេត្ត
បើ តាម លោកស្រី វង្ស សុវណ្ណារី បាន ឱ្យដឹង ថា អំណោយ របស់ លោក ឌី វិជ្ជា និង លោកស្រី ហ៊ុន ម៉ាណា ដែរ គាត់ ទទួលបាន រួម មាន៖ ថវិកា ៥លាន រៀល រួម និង ភេសជ្ជៈ មួយចំនួន ទៀត ផងដែរ ។
ជាមួយគ្នា នោះ លោកស្រី វង្ស សុវណ្ណារី បាន បញ្ជាក់ ឱ្យដឹង ទៀត ថា ក្រោយ មាន ការជួយសម្របសម្រួល ពី នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ នៅ វេលា ម៉ោង ១០ និង ៣០ នាទី ព្រឹក ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ លោកស្រី ត្រូវបាន មន្ត្រី ហិរញ្ញវត្ថុ សាលា ខេត្ត កំពង់ឆ្នាំង ហៅ ឲ្យ ទៅ បើក ប្រាក់ សមាគម មន្ត្រី ពន្ធនាគារ រួចហើយ មាន ចំនួន ៤.៥០០.០០០ រៀល សម្រាប់ ឧបត្ថម្ភ បុណ្យ សព លោក ពេជ្រ សុខ ជា ស្វាមី ផងដែរ ។
លោកស្រី វង្ស វណ្ណារី រួម និង កូន ចៅ បាន គោរព ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន . លោក ឌី វិជ្ជា និង លោកស្រី ហ៊ុន ម៉ាណា រួម នឹង អភិបាល ខេត្ត កំពង់ឆ្នាំង ដែល បាន ជួយ សម្រួល ដល់ ការលំបាក របស់ គាត់ និង បាន គោរព ជូនពរ សូម ទទួលបាន ជ័យជំនះ គ្រប់ ការងារ ភារកិច្ច ដែល ប្រមុខ រាជ រដ្ឋាភិបាល ប្រគល់ ជូន និង សូម ទទួលបាន សេចសុខ គ្រប់ ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
អភិបាល ខេត្ត កំពត ណែនាំ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ បង្កើន សកម្មភាព ការងារ ឱ្យ មាន ប្រសិទ្ធភាព ទ្វេរ ដង នៅ ឆ្នាំ ២០២១ នេះ
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត បាន ណែនាំ និង ដាក់ ទិសដៅ ដល់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ នៃ មន្ទីរ ស្ថាប័ន អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ សមត្ថកិច្ច ពាក់ព័ន្ធ និង អង្គភាព ចំណុះ ជុំវិញ ខេត្ត កំពត ត្រូវ បង្កើន និង ពង្រឹង សកម្ម ការងារ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ទ្វេរ ដង នៅ ឆ្នាំ ២០២១ នេះ ។
លោក ជា វ តាយ បាន ណែនាំ ដូចនេះ ក្នុង ឱកាស ដឹកនាំ ក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត កំពត លើក ទី ៣២ និង ធ្វើ ការបូកសរុប លទ្ធផល ការងារ ប្រចាំ ត្រីមាស ទី៤ ឆ្នាំ ២០២០ នៅ សាលា ខេត្ត កំពត នា ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ ។
ខាងក្រោម នេះ ជា លិខិត របស់ លោក ម៉ម ប៊ុន ហេង៖
នៅ មុន ការបោះឆ្នោត អនុម័ត ខាងលើ មេដឹកនាំ ព្រឹទ្ធសភា សំឡេង ភាគ ច្រើន មកពី គណបក្ស ប្រជាធិបតេយ្យ លោក ឆាក់ ស្កាំ មើ (Chuck Schumer) បាន កត់សម្គាល់ ថា លោកស្រី Yellen មាន ការគាំទ្រ ពី គណៈ បក្ស ទាំង ពីរ ព្រោះ លោកស្រី មាន បទពិសោធន៍ ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ហើយ ការគាំទ្រ ឲ្យ តែងតាំង លោកស្រី បាន ឆ្លុះបញ្ចាំង យ៉ាង ច្បាស់ ថា តើ លោកស្រី ស័ក្តិសម យ៉ាងណា ដើម្បី គ្រប់គ្រង ការប្រកួតប្រជែង សេដ្ឋកិច្ច នៅ សម័យកាល របស់ យើង ជាពិសេស អំឡុង ពេល នៃ វិបត្តិ សេដ្ឋកិច្ច នេះ ។
មុនពេល មាន ការអនុម័ត ពី សមាជិក ព្រឹទ្ធសភា ទាំងមូល លោកស្រី Yellen បាន ទទួល ការគាំទ្រ ជា ឯកច្ឆន្ទ ពី គណៈកម្មាធិការ ហិរញ្ញវត្ថុ ព្រឹទ្ធសភា ផងដែរ ។
គួរ បញ្ជាក់ ថា ក្នុង នាម ជា រដ្ឋមន្រ្តី រតនាគារ អាមេរិក លោកស្រី Yellen ដែល មាន អាយុ ៧៤ ឆ្នាំ នឹង ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការរៀបចំ និង ដឹកនាំ គោល នយោបាយ សេដ្ឋកិច្ច របស់ លោក ចូ បៃ ដិន ។ លោកស្រី Yellen ចូល បម្រើ ការងារ នៅ រតនាគារ បន្ទាប់ពី បាន បម្រើ កិច្ចការងារ ផ្នែក សេដ្ឋកិច្ច សំខាន់ ៗ អស់ រយៈពេល ជាច្រើន ឆ្នាំ ក្នុង នោះ រាប់បញ្ចូល ទាំង លោកស្រី ជា ស្ត្រី ដំបូង បំផុត ដែល បម្រើការ ជា ប្រធាន ធនាគារ កណ្ដាល អាមេរិក ចាប់ពី ឆ្នាំ ២០១៤ ដល់ ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ផងដែរ ៕
សម្តេច ក្រឡាហោម ស ខេង អញ្ជើញ ប្រកាស ផ្សព្វផ្សាយ របាយការណ៍ ជាតិ ស្តីពី លទ្ធផល ចុងក្រោយ ជំរឿន ទូទៅ ប្រទេស កម្ពុជា ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ប្រកាស ផ្សព្វផ្សាយ របាយការណ៍ ជាតិ ស្តីពី លទ្ធផល ចុងក្រោយ ជំរឿន ទូទៅ ប្រទេស កម្ពុជា ឆ្នាំ ២០១៩ ។
ពិធី នេះ បាន ប្រព្រឹត្ត ធ្វើឡើង នៅ សណ្ឋាគារ សូហ្វី តែ ល រាជធានី ភ្នំពេញ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក កិត្តិ សេដ្ឋា បណ្ឌិត ឆាយ ថន ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ផែនការ និង ជា អនុប្រធាន គណៈកម្មាធិការ ជាតិ ជំរឿន ទូទៅ ប្រជាជន កម្ពុជា ឆ្នាំ ២០១៩. តំណាង អង្គការ សហ ប្រជាជាតិ សម្រាប់ ប្រជាជន កម្ពុជា (UNFPA) . តំណាង ស្ថានទូត ប្រទេស ជា មិត្ត ប្រចាំ កម្ពុជា ព្រមទាំង ថ្នាក់ដឹកនាំ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ យ៉ាង ច្រើន ផងដែរ ។
បើ តាម លោកស្រី ហង់ លីណា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក អគ្គ នាយក វិទ្យាស្ថាន ស្ថិតិ នៃ ក្រសួង ផែនការ បាន បញ្ជាក់ ថា លទ្ធផល នៃ ការធ្វើ ជំរឿន ទូទៅ ប្រជាជន ឆ្នាំ ២០១៩ មាន តម្លាភាព និង ត្រឹមត្រូវ រហូតដល់ ៩៧. ៥ភាគរយ ដែល អាច ឲ្យ ស្ថាប័ន ពាក់ព័ន្ធ យក ទៅ ប្រើប្រាស់ តាម តម្រូវការ ពិសេស សម្រាប់ ការយក ទៅ ធ្វើ ផែនការ ផ្សេង ៗ ខណៈ តួលេខ នេះ ក៏ ត្រូវបាន បញ្ជូន ទៅ អង្គការ សហ ប្រជាជាតិ ផងដែរ ។
សូម ជម្រាប ថា អត្រា កំណើន ប្រជាជន ប្រចាំ ឆ្នាំ បាន ថយចុះ ពី ១.៥ភាគរយ ក្នុង ចន្លោះ ឆ្នាំ ១៩៩៨ និង ២០០៨ មក ១.២ភាគរយ ក្នុង ចន្លោះ ឆ្នាំ ២០០៨ និង ២០១៩ ។ អត្រា កំណើន ប្រចាំ ឆ្នាំ របស់ កម្ពុជា ក្នុង ទសវត្ស ចុងក្រោយ នេះ យើង ពិនិត្យ ឃើញ ថា ខ្ពស់ ជាង អត្រា កំណើន មធ្យម នៅ អាស៊ី អាគ្នេយ៍ ដែល មាន តែ ១.០ ភាគរយ ។
រាជធានី - ខេត្ត ដែល មាន ចំនួន ប្រជាជន ច្រើន ជាង គេ បំផុត គឺ ភ្នំពេញ មាន ២. ១២៩. ៣៧១ នាក់ ហើយ ខេត្ត កែប មាន ប្រជាជន តិច ជាង គេ បំផុត ៤១. ៧៩៨ នាក់ ប៉ុណ្ណោះ ។ ដង់ស៊ីតេ ប្រជាជន ស្មើនឹង ៨៦ នាក់ ក្នុង ផ្ទៃដី មួយ គីឡូម៉ែត្រ ការ៉េ នៅ ឆ្នាំ ២០១៩។ អត្រា ភេទ តាម តួលេខ បណ្តោះអាសន្ន នៃ ជំរឿន ប្រជាជន ឆ្នាំ ២០១៩ មាន បុរស ៩៤ នាក់ ក្នុង ចំណោម ស្ត្រី ១០០ នាក់ ដោយ មិន មាន ការប្រែប្រួល បើ ប្រៀបធៀប នឹង ឆ្នាំ ២០០៨ ។
អបអរសាទរ ទិវា សាធារណរដ្ឋ ឥណ្ឌា ខួប លើក ទី ៧២
ថ្ងៃស្អែក នេះ ក្រសួង សេដ្ឋកិច្ច នឹង រៀបចំ វេទិកា សាធារណៈ ស្តីពី ការគ្រប់គ្រង ម៉ាក្រូ សេដ្ឋកិច្ច និង ច្បាប់ ថវិកា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នឹង រៀបចំ វេទិកា សាធារណៈ ស្តីពី គ្រប់គ្រង ម៉ាក្រូ សេដ្ឋកិច្ច និង ច្បាប់ ស្តីពី ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០២១ ដូច រាល់ ឆ្នាំ កន្លងមក នៅ ថ្ងៃពុធ ១៤ កើត ខែ មាឃ ឆ្នាំ ជូត ទោស័ក ព .ស ២៥៦៤ ត្រូវនឹង ថ្ងៃទី ២៧ ខែ មក រា ឆ្នាំ ២០២១ ស្អែក នេះ នៅ សណ្ឋាគារ សូហ្វី តែ ល ភ្នំពេញ ភូគី ត្រា ដើម្បី ធ្វើ ការផ្សព្វផ្សាយ ឱ្យ កាន់តែ ទូលំទូលាយ ដល់ សាធារណជន ទូទៅ បាន ស្វែងយល់ លំអិត អំពី ការគ្រប់គ្រង ម៉ាក្រូ សេដ្ឋកិច្ច និង ច្បាប់ ថវិកា ឆ្នាំ ២០២១ បន្ថែម ទៀត ។
អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ថ្មី ទាំង ២នាក់ រួម មាន៖
១៖ បុរស ជនជាតិ ឥណ្ឌូណេស៊ី អាយុ ២៤ ឆ្នាំ មាន អាសយដ្ឋាន ស្នាក់ នៅ ខេត្ត ព្រះសីហនុ ជា អ្នកដំណើរ មក ពី ប្រទេស ឥណ្ឌូណេស៊ី បន្ត ជើងហោះហើរ នៅ ប្រទេស សិង្ហបុរី មកដល់ កម្ពុជា នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ លទ្ធផល ធ្វើតេស្ត វត្ថុ សំណាក លើក ទី ០២ របស់ បុរស ខាងលើ នេះ ផ្តល់ ដោយ វិទ្យាស្ថាន ជាតិ សុខ ភាពសាធារណៈ នៃ ក្រសួង សុខាភិបាល គឺ វិជ្ជមាន វីរុស កូវីដ - ១៩ ហើយ បច្ចុប្បន្ន អ្នកជំងឺ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មជ្ឈមណ្ឌល ជាតិ កម្ចាត់ រោគរ បេង និង ហង់ សិន រាជធានី ភ្នំពេញ ។
២៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ២៣ ឆ្នាំ មាន អាសយដ្ឋាន ស្នាក់ នៅ ភូមិ សាមគ្គី មាន ជ័យ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ លទ្ធផល ធ្វើតេស្ត វត្ថុ សំណាក លើក ទី ០៣ របស់ ស្ត្រី រូប នេះ ផ្តល់ ដោយ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា រាជធានី ភ្នំពេញ គឺ វិជ្ជមាន វីរុស កូវីដ - ១៩ ហើយ បច្ចុប្បន្ន អ្នកជំងឺ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មន្ទីរ ពេទ្យ បង្អែក ខេត្ត បន្ទាយមានជ័យ ។
ចំណែក អ្នក ជាសះស្បើយ ទាំង ៣នាក់ រួម មាន៖
១៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ១៧ ឆ្នាំ មាន អាសយដ្ឋាន ស្នាក់ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ជា អ្នកដំណើរ មកពី ប្រទេស សហរដ្ឋ អាមេរិក បន្ត ជើងហោះហើរ នៅ ប្រទេស សិង្ហបុរី មកដល់ កម្ពុជា នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ ។ ស្ត្រី រូប នេះ ត្រូវបាន ព្យាបាល ជាសះស្បើយ ដោយ ទទួលបាន លទ្ធ ផល តេស្ត អវិជ្ជមាន វីរុស កូវីដ - ១៩ ចំនួន ០២ លើក ត្រូវបាន អនុញ្ញាតឱ្យ ចេញ ពី មជ្ឈមណ្ឌល ជាតិ កម្ចាត់ រោគរ បេង និង ហង់ សិន ។
២៖ បុរស ជនជាតិ ឥណ្ឌូណេស៊ី អាយុ ៣៤ ឆ្នាំ មាន អាសយដ្ឋាន ស្នាក់ នៅ ខេត្ត សៀមរាប ជា អ្នកដំណើរ មកពី ប្រទេស ឥណ្ឌូណេស៊ី បន្ត ជើងហោះហើរ នៅ ប្រទេស សិង្ហបុរី មកដល់ កម្ពុជា នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ ។ បុរស រូប នេះ ត្រូវបាន ព្យាបាល ជាសះស្បើយ ដោយ ទទួលបាន លទ្ធផល តេស្ត អវិជ្ជមាន វីរុស កូវីដ - ១៩ ចំនួន ០២ លើក ត្រូវបាន អនុញ្ញាតឱ្យ ចេញ ពី មជ្ឈមណ្ឌល ជាតិ កម្ចាត់ រោគរ បេង និង ហង់ សិន ។
៣៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ២១ ឆ្នាំ មាន អាសយដ្ឋាន ស្នាក់ នៅ ស្រុក ពាម ជ ខេត្ត ព្រៃវែង បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២១ ។ ស្ត្រី រូប នេះ ត្រូវបាន ព្យាបាល ជាសះស្បើយ ដោយ ទទួលបាន លទ្ធផល តេស្ត អវិជ្ជមាន វីរុស កូវីដ - ១៩ ចំនួន ០២ លើក ឱ្យ ចេញ ពី មន្ទីរពេទ្យ បង្អែក ខេត្ត បន្ទាយមានជ័យ ។
បំបែក សំណុំរឿង ឃាតកម្ម ! ជន ដៃ ដល់ កាប់ បង ជីដូនមួយ នៅ ស្រុក បាធាយ ខេត្ត កំពង់ចាម ត្រូវ កម្លាំង នគរបាល ចាប់ខ្លួន បាន ហើយ
( កំពង់ចាម ) ៖ សំណុំរឿង ឃាតកម្ម មួយ ដែល បាន កើតឡើង នៅ យប់ ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០២១ ចំណុច ភូមិ តាំង ជ្រៃ ឃុំ សណ្ដែក ស្រុក បាធាយ ខេត្ត កំពង់ចាម ត្រូវ កម្លាំង នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម បំបែកបាន ដោយ ជោគជ័យ ក្រោយ ស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ រហូត បាន ចាប់ ជន ដៃ ដល់ នៅ វេលា ម៉ោង ៨យប់ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ នេះ ។
ក្រោយ ទទួលបាន សេចក្ដីរាយការណ៍ ពី អធិការ នគរបាល ស្រុក បាធាយ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត បាន ចាត់ ឲ្យ វរសេនីយ៍ ឯក ចាន់ ហោ អនុប្រធាន ផែនការងារ នគរបាល ព្រហ្មទណ្ឌ ខេត្ត ដឹកនាំ កម្លាំង ជំនាញ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ កម្លាំង ជំនាញ បច្ចេកទេស វិទ្យាសាស្រ្ត ខេត្ត កម្លាំង ជំនាញ ស្រុក ដឹកនាំ ដោយ វរសេនីយ៍ ឯក សំ ណាល់ អធិការ នគរបាល ស្រុក និង កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល សណ្ដែក ចុះ ដល់ ទីតាំង កើត ហេតុ ធ្វើ ការស្រាវជ្រាវ ស៊ើបអង្កេត ជាបន្ទាន់ ។
បន្ទាប់ពី បាន ធ្វើ ការសាកសួរ ជនសង្ស័យ បាន ឆ្លើយ សារភាព ថា ខ្លួន ពិតជា បាន ធ្វើ សកម្មភាព យក ដាវ កាប់ ទៅ លើ ជនរងគ្រោះ ដែល ត្រូវ ជា បង ជីដូនមួយ នេះ ពិតប្រាកដ មែន ហើយ មូលហេតុ កាប់ ច្រឡំ រឿង គំនុំ ពី ថ្ងៃ ជាមួយ ភ្ញៀវ ខាង កូនកំលោះ ។ ក្នុង នោះ កម្លាំង ជំនាញ ដកហូត បាន ដាវ ចំនួន ០១ ផងដែរ ។
បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន ឃុំ ខ្លួន បណ្ដោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ស្រុក បាធាយ តាម បទបញ្ជា របស់ ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង ខេត្ត និង កំពុង ចង ក្រង សំណុំរឿង ដើម្បី បញ្ជូន ទៅ សាលាដំបូង ខេត្ត កំពង់ចាម ៕
លោកស្រី ជា សិរី អគ្គ នាយក បច្ចេកទេស ធនាគារ ជាតិ នៃ កម្ពុជា បាន ឲ្យដឹង ថា ការប្រើប្រាស់ ប្រព័ន្ធ ទូទាត់ អេឡិចត្រូនិក ‍‍‍‍‍‍‍‍‍ Retail Pay បាន ផ្ដល់ អត្ថប្រយោជន៍ ជាច្រើន ដល់ វិស័យ ធនាគារ និង អ្នកប្រើប្រាស់ ព្រោះ ប្រព័ន្ធ ទូទាត់ នេះ ប្រើប្រាស់ ដោយ ទូលំទូលាយ មាន ភាពងាយស្រួល និង ប្រើប្រាស់ បាន ពិសេស ដល់ អាជីវករ ប្រកប អាជីវកម្ម ផ្សេង ៗ ។
លោកស្រី បាន បន្ថែម ថា ការប្រើប្រាស់ ប្រព័ន្ធ ទូទាត់ អេឡិចត្រូនិក មាន ភាពងាយស្រួល ជាង ការចាយវាយ ជា ក្រដាស់ ប្រាក់ ព្រោះថា ការចាយ ក្រដាស់ ប្រាក់ ហុច ពី ដៃ មួយ ទៅ ដៃ មួយ ធ្វើឲ្យ មាន មេរោគ កខ្វក់ ជាប់ ក្រដាស់ ប្រាក់ និង គ្មាន សុវត្ថិភាព សម្រាប់ អ្នកប្រើប្រាស់ ជា ស្ដែង ដូច ក្នុង បរិបទ នៃ ជំងឺ កូវីដ១៩ នេះ ។ មួយ វិញទៀត ការផលិត ក្រដាស់ ប្រាក់ មាន តម្លៃ ថ្លៃ ពិបាក ក្នុង ការប្រមូល ក្រដាស់ ប្រាក់ ចាស់ ៗ មក វិញ និង ជំនួស ដោយ ក្រដាស់ ប្រាក់ ថ្មី ។
បើ តាម លទ្ធផល ជំរឿន ឆ្នាំ ២០១៩ ដែល ត្រូវបាន ប្រកាស ផ្សព្វផ្សាយ ក្រោម អធិបតីភាព របស់ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ ។ លោក កិត្តិ សេដ្ឋា បណ្ឌិត ឆាយ ថន រដ្ឋមន្រ្តី ក្រសួង ផែនការ បាន ឱ្យដឹង យ៉ាង ដូច្នេះ ថា៖ « ជំរឿន លើក ទី ៤នេះ ត្រូវបាន លើក ពេល មក ធ្វើ នៅ ឆ្នាំ ២០១៩ វិញ ដោយ ប្រើប្រាស់ ថវិកា ជាតិ ស្ទើរតែ ទាំងស្រុង ដែល បាន ប្រើប្រាស់ ថវិកា សរុប ប្រមាណ ៩លាន ៩សែន ដុល្លារ សហរដ្ឋ អាមេរិក » ។
ឆ្លៀត ឱកាស នេះ លោក កិត្តិ សេដ្ឋា បណ្ឌិត ឆាយ ថន បាន ថ្លែងអំណរគុណ ដល់ អង្គការ មូលនិធិ សហ ប្រជាជាតិ សម្រាប់ ប្រជាជន (UNFPA) ដែល បាន ជួយ គៀង គរ ថវិកា និង ជំនួយ បច្ចេកទេស រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ធ្វើឱ្យ ដំណើរការ អនុវត្ត ការធ្វើ ជំរឿន ទូទៅ ប្រជាជន នៅ កម្ពុជា ឆ្នាំ ២០១៩ ប្រព្រឹត្តទៅ មាន ដំណើរការ ល្អ តាម ការគ្រោងទុក ។
បន្ថែម ពី នេះ សម្តេច ក្រឡាហោម ស ខេង បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុន្នីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដែល បាន អនុញ្ញាតឲ្យ ប្រើប្រាស់ ថវិកា ជាតិ និង ជួយ សម្រួល ផ្តល់ ថវិកា បាន ទាន់ ពេលវេលា សម្រាប់ រាល់ កិច្ចការ ជំរឿន ។
អត្រា កំណើន ប្រជាជន ប្រចាំ ឆ្នាំ បាន ថយចុះ ពី ១.៥ភាគរយ ក្នុង ចន្លោះ ឆ្នាំ ១៩៩៨ និង ២០០៨ មក ១.២ភាគរយ ក្នុង ចន្លោះ ឆ្នាំ ២០០៨ និង ២០១៩ ។ អត្រា កំណើន ប្រចាំ ឆ្នាំ របស់ កម្ពុជា ក្នុង ទសវត្ស ចុងក្រោយ នេះ យើង ពិនិត្យ ឃើញ ថា ខ្ពស់ ជាង អត្រា កំណើន មធ្យម នៅ អាស៊ី អាគ្នេយ៍ ដែល មាន តែ ១.០ ភាគរយ ។
រាជធានី - ខេត្ត ដែល មាន ចំនួន ប្រជាជន ច្រើន ជាង គេ បំផុត គឺ ភ្នំពេញ មាន ២. ១២៩. ៣៧១ នាក់ ហើយ ខេត្ត កែប មាន ប្រជាជន តិច ជាង គេ បំផុត ៤១. ៧៩៨ នាក់ ប៉ុណ្ណោះ ។ ដង់ស៊ីតេ ប្រជាជន ស្មើនឹង ៨៦ នាក់ ក្នុង ផ្ទៃដី មួយ គីឡូម៉ែត្រ ការ៉េ នៅ ឆ្នាំ ២០១៩ ។ អត្រា ភេទ តាម តួលេខ បណ្តោះអាសន្ន នៃ ជំរឿន ប្រជាជន ឆ្នាំ ២០១៩ មាន បុរស ៩៤ នាក់ ក្នុង ចំណោម ស្ត្រី ១០០ នាក់ ដោយ មិន មាន ការប្រែប្រួល បើ ប្រៀបធៀប នឹង ឆ្នាំ ២០០៨ ៕
លោក ភួង សោភា រដ្ឋលេខាធិការ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ភួង សោភា រដ្ឋលេខាធិការ ក្រសួង អភិវឌ្ឍន៍ ជនបទ នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច ឯកឧត្តម លោកជំទាវ លោក លោកស្រី ទាំង ស្ថាបន័ស៊ីវិល និង កម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ដែល បាន បរិច្ចាគ ដោយ ការកាត់ បៀវត្ស ទាំងស្រុង ឬមួយ ផ្នែក រយៈពេល ខ្លី ឬ វែង តាម ការស្ម័គ្រចិត្ត ជួយ ដល់ ការងារ ប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ ដែល បង្ហាញ ឱយ ឃើញ នូវ សាមគ្គីភាព ក្នុង ខឿន ការពារ សុខភាព របស់ ប្រជាជន កម្ពុជា ៕ រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
ការប្រកាស របស់ រដ្ឋមន្ត្រី អ៊ុក រ៉ាប៊ុន នេះ ធ្វើឡើង ភ្លាម ៗ បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ប្រកាស បន្ត កាត់ បៀវត្ស រយៈពេល ៧ខែ ទៀត ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ការកាត់ បៀវត្ស របស់ សម្តេច តេជោ ហ៊ុន សែន រយៈពេល ៧ខែ ទៀត នេះ គឺ ចាប់ពី ខែកុម្ភៈ ដល់ ខែសីហា ឆ្នាំ ២០២១ ។
លោក ស្វាយ ស៊ី ថា ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ក្នុង ១ ខែ៥០ ម៉ឺន រៀល ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ស្វាយ ស៊ី ថា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៃ ទីស្ដីការ គណៈ រដ្ឋមន្រ្ដី នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ប្រកាស កាត់ បៀវត្ស រយៈពេល ៦ខែ ក្នុង ១ ខែ៥០ ម៉ឺន រៀល ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
ការប្រកាស របស់ លោក ស្វាយ ស៊ី ថា នេះ ធ្វើឡើង ភ្លាម ៗ បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ប្រកាស បន្ត កាត់ បៀវត្ស រយៈពេល ៧ខែ ទៀត ជូន ទៅ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ការកាត់ បៀវត្ស របស់ សម្តេច តេជោ ហ៊ុន សែន រយៈពេល ៧ខែ ទៀត នេះ គឺ ចាប់ពី ខែកុម្ភៈ ដល់ ខែសីហា ឆ្នាំ ២០២១ ។
ទេសរដ្ឋមន្ត្រី គន់ គីម ណែនាំ មន្ត្រី និង អ្នក ពាក់ព័ន្ធ នៅ ខេត្ត កំពង់ធំ ត្រូវ រួមគ្នា ត្រៀម ឆ្លើយតប ក្នុង ការងារ ជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ ដែល ងាយ រងគ្រោះ និង រងគ្រោះ ដោយ គ្រោះ មហន្តរាយ ធម្មជាតិ ឲ្យ ទាន់ ពេល និង មាន ប្រសិទ្ធភាព
អភិបាល ខេត្ត កំពង់ធំ ថ្លែង ថា នៅក្នុង ឆ្នាំ ២០២០ នេះ ខេត្ត កំពង់ធំ រង ផល ប៉ះពាល់ ដោយ គ្រោះ មហន្តរាយ ធម្មជាតិ ដូចជា ជំនន់ ទឹកភ្លៀង ប៉ះពាល់ ប្រជាជន ១១. ៦៩៥ គ្រួសារ ស្លាប់ ៩នាក់ ប៉ះពាល់ ស្រូវ ១៨. ៨៥០ ហិកតា ខូចខាត ១០. ៣៣៥ ហិកតា ( ស្មើ ១២. ៣៦៥ គ្រួសារ ) ប៉ះពាល់ ផ្លូវ កៅស៊ូ ៩.៧០០ ម៉ែត្រ ប៉ះពាល់ ផ្លូវ គ្រួស ក្រហម ៥៩ .១៩៦ ម៉ែត្រ ប៉ះពាល់ ផ្លូវ ដី ស ៨.៣៨៤ ម៉ែត្រ ប៉ះពាល់ សាលា ៤១ សាលា និង ជម្លៀស សត្វ ៦.០១១ ក្បាល - ខ្យល់ កន្ត្រាក់ ៤៧ករណី រន្ទះ បាញ់ ស្លាប់ ៩នាក់ របួស ១នាក់ ។
លោក ទេសរដ្ឋមន្ត្រី អរគុណ និង កោតស សើរ ហើយ ចាត់ទុក ថា នេះ ជា កាយវិការ មួយ ល្អ ណាស់ សម្រាប់ ជា ការតបស្នង សង គុណ បងប្អូន អតីត យុទ្ធជន យើង ដែល ពួកគាត់ សុទ្ធតែ មាន គុណ បំណាច់ សម្រាប់ សង្គមជាតិ យើង ។ ព្រោះតែ ការលះបង់ ក្នុង បុព្វហេតុ ជាតិ នេះ ហើយ ទើប រក្សា បាន នូវ សុខ សន្តិភាព និង ផ្តល់ ឱកាស ល្អ សម្រាប់ ការរកស៊ី ការវិនិយោគ រហូត មាន ជីវភាពល្អ ។ ដូច្នេះ យើង ត្រូវ ចេះ តបស្នង សង គុណ ពួក គាត់ ។
ទន្ទឹម នឹង នោះ ដែរ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន កោតស សើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការខិតខំ របស់ គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត និង សមាគម អតីត យុទ្ធជន ខេត្ត ចំពោះ អ្នក ពាក់ព័ន្ធ ទាំងអស់ ដែល ខិតខំ ជួយ សង្គ្រោះ លើ កិច្ចការងារ នេះ ដោយ បាន បំពេញ មុខ នាទី របស់ ខ្លួន បាន ល្អ ប្រសើរ ពេល មាន ហេតុការណ៍ កើតឡើង ខេត្ត ម្ចាស់ ការចុះ ទៅ ដោះស្រាយ ភ្លាម បាន ទាន់ ពេល វេលា ។
រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ ជូនដំណឹង ដល់ ប្រជាពលរដ្ឋ ឲ្យ ធ្វើចរាចរណ៍ មក ផ្លូវ លេខ ៥៩៨វិញ ខណៈ កំណាត់ ផ្លូវ ជាតិ លេខ ៥ កំពុង ជួសជុល ពង្រី ផ្លូវ រយៈពេល ៣០ ថ្ងៃ
( ភ្នំពេញ ) ៖ រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ សូម ជម្រាប ជូនដំណឹង ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ក្នុង រាជធានី ភ្នំពេញ ជាពិសេស ក្នុង មូលដ្ឋាន ខណ្ឌ ឫស្សីកែវ ឲ្យបាន ជ្រាប ថា រដ្ឋបាល រាជធានី និង មន្ទីរ សាធារណៈ ការដឹក ជញ្ជូន រាជធានី ភ្នំពេញ បាន ធ្វើ ការជួសជុល និង ពង្រីក ផ្លូវ ដើម្បីឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ងាយស្រួល ក្នុង ការធ្វើចរាចរណ៍ ឆ្លងកាត់ ដោយ ចំណាយ ពេល អនុវត្ត ការងារ រយះពេល ៣០ ថ្ងៃ គិត ចាប់ពី ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ ត ទៅ ។
ដូចនេះ ដើម្បីឲ្យ ការងារ ខាងលើ ប្រព្រឹត្តទៅ ដោយ រលូន ស្នើ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ មេត្តា ជ្រាប យោគយល់ អធ្យាស្រ័យ និង ដើម្បី បញ្ជៀស ការធ្វើដំណើរ ឆ្លងកាត់ ទីតាំង ខាងលើ ដោយ ធ្វើដំណើរវាង ទៅ ផ្លូវ ៥៩៨ ឫ ផ្លូវ ជា សុផារ៉ា ជា បណ្ដោះអាសន្ន វិញ ដើម្បី កាត់បន្ថយ ការកកស្ទះ ចរាចរណ៍ និង គ្រោះថ្នាក់ កើតឡើង ជា យថាហេតុ ពីព្រោះ ក្រុមការងារ ត្រូវ ប្រើប្រាស់ គ្រឿងចក្រ និង រថយន្ដ ធន់ ធ្ងន់ សម្រាប់ ស្ថាបនា ផ្លូវ ។
ការកាត់ បៀវត្ស របស់ សម្តេច តេជោ ហ៊ុន សែន រយៈពេល ៧ខែ ទៀត នេះ គឺ ចាប់ពី ខែកុម្ភៈ ដល់ ខែសីហា ឆ្នាំ ២០២១ ។
អាស្រ័យ ដោយ កូវីដ១៩ បាន នឹង កំពុង កើតមាន បន្ត នៅ ទូទាំង ពិភពលោក រាប់ ទាំង កម្ពុជា យើង ផង ខ្ញុំ សូម ប្រកាស បន្ត កាត់ បៀវត្ស ទាំងអស់ ក្រោយ ការបង់ ពន្ធ រយៈពេល ៧ខែ ទៀត ជូន ទៅ ក្រសួង សុខាភិបាល ដោយ ចាប់ពី ខែកុម្ភៈ ឆ្នាំ ២០២១ ដល់ ខែសីហា ឆ្នាំ ២០២១ ។
ខ្ញុំ ឆ្លៀត យក ឱកាស នេះ ថ្លែងអំណរគុណ ចំពោះ សម្តេច ឯកឧត្តម លោកជំទាវ លោក លោកស្រី ទាំង ស្ថាបន័ស៊ីវិល និង កម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ដែល បាន បរិច្ចាគ ដោយ ការកាត់ បៀវត្ស ទាំងស្រុង ឬមួយ ផ្នែក រយៈពេល ខ្លី ឬ វែង តាម ការស្ម័គ្រចិត្ត ជួយ ដល់ ការងារ ប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ ដែល បង្ហាញ ឱយ ឃើញ នូវ សាមគ្គីភាព ក្នុង ខឿន ការពារ សុខភាព របស់ ប្រជាជន យើង »៕
សមាជិក សភា តំណាងរាស្ត្រ លោក ជែមី រ៉ាស គីន (Jamie Raskin) បាន អាន ពាក្យ ចោទប្រកាន់ លោក ដូណាល់ ត្រាំ នៅឯ ព្រឹទ្ធសភា ជា ទី ដែល អតីត ប្រធានាធិបតី វ័យ ៧៤ ឆ្នាំ រូប នេះ នៅតែ ទទួលបាន ការគាំទ្រ ពី សមាជិក ព្រឹទ្ធសភា សាធារណរដ្ឋ ភាគ ច្រើន ។ សវនាការ កាត់ទោស លោក ត្រាំ នៅក្នុង ព្រឹទ្ធសភា ត្រូវបាន គេ រំពឹង ថា នឹង ប្រព្រឹត្តទៅ នៅ សប្ដាហ៍ ទី ២ ក្នុង ខែកុម្ភៈ បន្ទាប់ពី សភា តំណាងរាស្ត្រ បាន បោះឆ្នោត ចោទ ប្ដឹង ដក តំណែង លោក ដូណាល់ ត្រាំ កាលពី ថ្ងៃទី ១៣ ខែមករា ។
តាមរយៈ ការសម្រេចចិត្ត ខាងលើ នេះ បាន ធ្វើឱ្យ លោក ដូណាល់ ត្រាំ ក្លាយជា ប្រធានាធិបតី ដំបូង គេ ក្នុង ប្រវត្តិសាស្ត្រ អាមេរិក ដែល ត្រូវ គេ ចោទ ប្ដឹង ជា លើក ទី ២ ហើយ មិន តែ ប៉ុណ្ណោះ លោក ត្រាំ ក៏ បាន បំបែក កំណត់ត្រា ថ្មី មិន ធ្លាប់ មាន ផងដែរ នោះ គឺ ក្លាយជា អតីត ប្រធានាធិបតី អាមេរិក ដំបូង បំផុត ដែល ប្រឈមមុខ នឹង សវនាការ កាត់ទោស នៅក្នុង ព្រឹទ្ធសភា ។
រាជធានី - ខេត្ត ដែល មាន ចំនួន ប្រជាជន ច្រើន ជាង គេ បំផុត គឺ ភ្នំពេញ មាន ២. ១២៩. ៣៧១ នាក់ ហើយ ខេត្ត កែប មាន ប្រជាជន តិច ជាង គេ បំផុត ៤១. ៧៩៨ នាក់ ប៉ុណ្ណោះ ។ ដង់ស៊ីតេ ប្រជាជន ស្មើនឹង ៨៦ នាក់ ក្នុង ផ្ទៃដី មួយ គីឡូម៉ែត្រ ការ៉េ នៅ ឆ្នាំ ២០១៩ ។ អត្រា ភេទ តាម តួលេខ បណ្តោះអាសន្ន នៃ ជំរឿន ប្រជាជន ឆ្នាំ ២០១៩ មាន បុរស ៩៤ នាក់ ក្នុង ចំណោម ស្ត្រី ១០០ នាក់ ដោយ មិន មាន ការប្រែប្រួល បើ ប្រៀបធៀប នឹង ឆ្នាំ ២០០៨ ៕
( អាឡាស្កា) ៖ ការសិក្សា ថ្មី មួយ បាន បង្ហាញ ថា បរិមាណ ផ្ទាំង ទឹកកក របស់ ផែនដី យើង សព្វ ថ្ងៃ នេះ កំពុងតែ ជួបប្រទះ ការរលាយ ក្នុង កម្រិត យ៉ាង ឆាប់រហ័ស ខ្លាំង បើ ធៀប នឹង កាលពី អំឡុង ពាក់កណ្តាល ទសវត្សរ៍ ១៩៩០ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA នៅ ព្រឹក ថ្ងៃអង្គារ ទី ២៦ ខែមករា ឆ្នាំ ២០២១ ។
យោង តាម ការសិក្សា ថ្មី ខាងលើ ដែល ត្រូវបាន ចងក្រង ដោយ ក្រុម អ្នកវិទ្យាសាស្រ្ត នៅ ចក្រភព អង់គ្លេស និង ចេញផ្សាយ នៅ ថ្ងៃចន្ទ សប្តាហ៍ នេះ ទឹកកក ប្រហែល ២៨ ទ្រីលាន តោន បាន រលាយ នៅលើ ផែនដី គិត ចាប់តាំងពី ពាក់កណ្តាល ទសវត្សរ៍ ឆ្នាំ ១៩៩០ មក ទល់នឹង ពេលនេះ ។ បើ គិត ជា អត្រា ប្រចាំ ឆ្នាំ កម្រិត រលាយ ទឹកកក បច្ចុប្បន្ន នេះ ស្ថិត នៅ កម្រិត ៥៧ ភាគរយ លឿន ជាង កម្រិត រលាយ ទឹកកក កាលពី ជិត ៣ទសវត្សរ៍ មុន ។
តាមរយៈ ការប្រើប្រាស់ ទិន្នន័យ ពី ផ្កាយ រណប ចាប់ពី ឆ្នាំ ១៩៩៤ ដល់ ឆ្នាំ ២០១៧ ក្រុម អ្នកវិទ្យាសាស្រ្ត ខាងលើ បាន គណនា ឃើញ ថា ពិភពលោក បាន បាត់បង់ ទឹកកក ជា មធ្យម ០.៨ ទ្រីលាន តោន ក្នុង មួយ ឆ្នាំ នៅ អំឡុង ទសវត្សរ៍ ឆ្នាំ ១៩៩០ ប៉ុន្តែ អំឡុង ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ វិញ ផែនដី បាន បាត់បង់ ទឹកកក ជា មធ្យម ដល់ ទៅ ១.២ ទ្រីលាន តោន ក្នុង មួយ ឆ្នាំ ។
គួរ បញ្ជាក់ ថា ការសិក្សា ជ្រាវជ្រាវ ជាច្រើន ផ្សេង ទៀត នា ពេល កន្លងមក ដោយ ក្រុម អ្នកវិទ្យាសាស្រ្ត នៅ ជុំវិញ ពិភពលោក ក៏ បាន រកឃើញ ពី អត្រា គួរឲ្យ បារម្ភ នៃ ការរលាយ ផ្ទាំង ទឹកកក លើ ផែនដី ក៏ ដូចជា ការកើនឡើង កម្តៅ នៃ ភព របស់ យើង ផងដែរ ៕
ខាងក្រោម ជា ទិន្នន័យ ប្រទេស ចំនួន ២០ ដែល មាន អ្នក ឆ្លង ជំងឺ COVID-19 ច្រើន ជាង គេ៖ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៦០ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន ថ្ងៃទី ២៥ ខែមករា ម្សិលមិញ
