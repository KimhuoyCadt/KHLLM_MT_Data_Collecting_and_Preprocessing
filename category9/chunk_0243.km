ខាងក្រោម នេះ ជា ព្រះរាជ ក្រឹត្យ តែងតាំង លោក ង៉ោ សុវណ្ណ៖
ប្រើ គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គមជាតិ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែកុម្ភៈ៖ បង្ក្រាប ១១ករណី ឃាត់ខ្លួន ៣១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែកុម្ភៈ ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១១ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៦ករណី និង ជួញដូរ ៨ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣១ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ១១ ខែកុម្ភៈ ឆ្នាំ ២០២១ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ២៤៦ ករណី ឃាត់ មនុស្ស ៦០១ នាក់ ( ស្រី ២៤ នាក់ )៕
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ពី កម្មវិធី ចាក់ វ៉ាក់សាំង ដោយ ឈរ លើ គោលការណ៍ ស្ម័គ្រចិត្ត សម្រាប់ ថ្ងៃទី ១១ ខែកុម្ភៈ ឆ្នាំ ២០២១ និង ថ្ងៃ ជា បន្តបន្ទាប់ ទៀត ដែល មាន ដូច ខាងក្រោម នេះ៖
លោក លោកស្រី ដែល នៅក្នុង ក្រុម ដែល ក្រសួង សុខាភិបាល បាន ជូន ព័ត៌មាន កាលពី ថ្ងៃទី ០៨ ខែកុម្ភៈ ឆ្នាំ ២០២១ រួចហើយ នោះ ហើយ ដែល មិន ទាន់ បាន អញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ សូមអញ្ជើញ ទៅ ចាក់ តាម ទីកន្លែង ដែល ក្រសួង សុខាភិបាល បាន ជូន ព័ត៌មាន កាលពី ថ្ងៃទី ០៨ ខែកុម្ភៈ ឆ្នាំ ២០២១ រួចហើយ ។
* ក្រម គ្រូពេទ្យ នៅ តាម មន្ទីរពេទ្យ កាល់ម៉ែត មន្ទីរពេទ្យ ព្រះអង្គ ឌួង មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត និង មន្ទីរពេទ្យ កុមារ ជាតិ ដែល ជា ទីតាំង ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ សូម ចាត់ចែង ចាក់ ជូន បុគ្គលិក របស់ ខ្លួន ឲ្យបាន គ្រប់ ៗ គ្នា នៅ តាម ទីតាំង រៀង ៗ ខ្លួន ។
* មន្ទីរពេទ្យ កុមារ ជាតិ ( លោក សាស្ត្រាចារ្យ ញឹម អង្គារ បុស្ស ០១១ ៨១១ ១៣២ ) ៖ សម្រាប់ បុគ្គលិក - មន្ត្រីរាជការ នៃ ក្រសួង សុខាភិបាល ទាំងអស់ ក្រុម គ្រូពេទ្យ នៅ តាម មន្ទីរពេទ្យ ព្រះកុសមៈ មជ្ឈមណ្ឌល ជាតិ គាំពារ មាតា និង ទារក និង មជ្ឈជាតិ កំចាត់ រោគរ បេង និង ហង់ សិន ទាំងអស់ ដែល ត្រូវ ចែក ពេល គ្នា ទៅ ចាក់ កុំ ឲ្យ រាំងស្ទះ ដល់ ដំណើរការ មន្ទីរពេទ្យ ។
* មន្ទីរពេទ្យ កាល់ម៉ែត ( សាស្រ្តាចារ្យ គង់ សន្យា ០១២ ៩៦៥ ៩៥៤ ) ៖ សម្រាប់ សមាជិក ព្រឹទ្ធសភា និង រដ្ឋសភា និង អង្គរក្ស ថ្នាក់ដឹកនាំ កំពូល ៗ ។
* មន្ទីរពេទ្យ ព្រះអង្គ ឌួង ( សាស្រ្តាចារ្យ លូ លី ឃាង ០៧៦ ៨៨៣ ៧៨៧៨) ៖ សម្រាប់ បុគ្គលិក - មន្ត្រីរាជការ ព្រឹទ្ធសភា រដ្ឋសភា និង ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ទាំងអស់ ។
* មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ( សាស្រ្តាចារ្យ ង ម៉េង ០៧៨ ៩៩៧ ៩៧៨ ) ៖ សម្រាប់ កងកម្លាំង នគ បាល ជាតិ នៅ ក្រសួង មហាផ្ទៃ និង នៅ រាជធានី ភ្នំពេញ ទាំងអស់ ព្រមទាំង បុគ្គលិក - មន្ត្រីរាជការ នៃ មជ្ឈមណ្ឌល សកម្មភាព កំចាត់ មីន កម្ពុជា ទាំងអស់ ។
ក្រសួង សុខាភិបាល បន្ត ជូនដំណឹង ដល់ សាធារណជន អំពី ក្រុម អាយុ ពី ១៨ ឆ្នាំ ដល់ ៥៩ ឆ្នាំ ផ្សេង ៗ ទៀត ដែល នឹង សូមអញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដោយ ស្ម័គ្រចិត្ត នៅ ពេល ក្រោយ ៗ ទៀត ។
ក្រសួង បន្ត ថា សូម បងប្អូន ប្រជាពលរដ្ឋ ដែល ស្ថិត នៅក្នុង ក្រុម អាទិភាព ផ្សេង ៗ ទៀត នោះ ដែល ស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ មេត្តា អធ្យាស្រ័យ ប្រសិនបើ មិន ទាន់ ដល់ វេន របស់ ខ្លួន ទេ នោះ សូម មេត្តា រងចាំ បន្តិច សិន ដោយសារ វ៉ាក់សាំង មាន ចំនួន កំណត់ នៅ ពេល នេះ និង ដើម្បីឲ្យ អ្នក ដែល បាន ស្ម័គ្រចិត្ត ចាក់ រួចហើយ នោះ មាន វ៉ាក់សាំង គ្រប់គ្រាន់ សម្រាប់ ដូស លើក ទី ពីរ ទៀត ផងដែរ ៕
វ៉ាក់សាំង ប្រឆាំង កូវីដ១៩៖ ការពិត មិន មែន នយោបាយ
( ភ្នំពេញ ) ៖ ក្នុង រយៈពេល តែ ជាង មួយ ឆ្នាំ ប៉ុណ្ណោះ ជំងឺ កូវីដ១៩ បាន បង្ក អសិ្ថរភាព ពិភពលោក ដោយ បាន ធ្វើឱ្យ មនុស្ស ជាង ២.៣លាន នាក់ បាត់បង់ជីវិត និង មាន មនុស្ស ជាង ១០៧ លាន នាក់ បាន ឆ្លង ជំងឺ ។ ជំងឺ រាតត្បាត នេះ ក៏ បាន បង្ក បញ្ហា សេដ្ឋកិច្ច និង សង្គម ដ៏ រ៉ាំរ៉ៃ នៅ ទូទាំង សាកលលោក ទាំងមូល ។ បើ គិត ឱ្យ វិជ្ជមាន ទៅ អ្នកវិទ្យាសាស្ត្រ បាន បង្កើត វ៉ាក់សាំង ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ក្នុង ល្បឿន មួយ លឿន ដែល មិន ធ្លាប់ មាន ពីមុន មក ។ ការពិត នេះ ជា ហេតុផល មួយ សម្រាប់ ការសាទរ ។
ទោះជា យ៉ាងណា ក៏ដោយ ថ្នាំ ទាំង នេះ ត្រូវបាន អនុញ្ញាតឱ្យ ប្រើប្រាស់ ជាសាធារណៈ នៅ តាម បណ្តា ប្រទេស លោក ខាងលិច រួច មកហើយ ។ វ៉ាក់សាំង ប្រឆាំង ជំងឺ កូវីដ១៩ ផលិត ដោយ SinoPharm ត្រូវបាន បង្ហាញ ថា មាន សុវត្ថិភាព និង ប្រសិទ្ធភាព ហើយ ប្រទេស ជាច្រើន នៅលើ ពិភពលោក បាន អនុម័ត ទទួលស្គាល់ ឱ្យ មាន ការប្រើប្រាស់ វា ។
លើកលែងតែ អ្នក ដែល ព្យាយាម ស្វែងរក ផលប្រយោជន៍ នយោបាយ គ្រប់ ពេលវេលា ពុំ មាន នរណា ម្នាក់ រួមទាំង ប្រជាជន របស់ ពួកគេ ផងដែរ ជឿ ថា រដ្ឋាភិបាល ជាច្រើន នៅលើ ពិភពលោក តាំងពី កម្ពុជា ដល់ តួកគី ពី អេហ្ស៊ីប ដល់ ឥណ្ឌូនេស៊ី និង ពី ហុង គ្រី ដល់ អេមីរ៉ាត អារ៉ាប់ រួម នឹង យល់ព្រម ប្រើប្រាស់ វ៉ាក់សាំង ប្រឆាំង ជំងឺ កូវីដ១៩ ដែល ផលិត ដោយ SinoPharm ដើម្បី ធ្វើបាប ប្រជាជន របស់ ខ្លួន ក្នុង ចេតនា ផ្គាប់ ចិត្ត ប្រទេស ចិន នោះ ឡើយ ។
** អត្ថបទ ទស្សនៈ អ្នកនិពន្ធ នេះ ត្រូវបាន បោះពុម្ព ផ្សាយ ដោយ មជ្ឈមណ្ឌល អភិវឌ្ឍន៍ កម្ពុជា នៅ ថ្ងៃទី ១០ ខែកុម្ភៈ ឆ្នាំ ២០២១ ។ ខ្លឹមសារ នៃ អត្ថបទ នេះ គឺជា គំនិត របស់ អ្នកនិពន្ធ ផ្ទាល់ និង មិន ឆ្លុះបញ្ចាំង អំពី ទស្សនៈ របស់ មជ្ឈមណ្ឌល អភិវឌ្ឍន៍ កម្ពុជា ៕
