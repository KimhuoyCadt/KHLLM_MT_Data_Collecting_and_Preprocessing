( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ឆាយ ណា ហ៊រ ទាន ( ហៅ កាត់ ថា ក្រុមហ៊ុន CHD) ត្រូវ បង្កើតឡើង នៅ ឆ្នាំ ២០០២ ជា សហគ្រាស ផលិត ថាមពល អគ្គិសនី របស់ ប្រទេស ចិន ដែល បាន ឈរ នៅ លំដាប់ថ្នាក់ នៃ សហគ្រាស កំពូល ទាំង៥០០ លើ ពិភពលោក ។ ក្រុមហ៊ុន ឆាយ ណា ហ៊រ ទាន សំខាន់ គឺ ប្រកប អាជីវកម្ម ដូចជា ផលិត ថាមពល អគ្គិសនី ផលិត និង ផ្គត់ផ្គង់ ថាមពល កម្តៅ ព្រម និង ផ្តល់ សេវាកម្ម ខាង ការអភិវឌ្ឍ ថាមពល ធម្មជាតិ និង បច្ចេកវិទ្យា ពាក់ព័ន្ធ ដូចជា ធ្យូងថ្ម ជាដើម ដែល ពាក់ព័ន្ធ នឹង ថាមពល អគ្គិសនី ។
ក្នុង ឱកាស ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន ក្រុមហ៊ុន ឆាយ ណា ហ៊រ ទាន បាន ចេញផ្សាយ វីដេអូ « បំភ្លឺ អនាគត បំភ្លឺ កម្ពុជា » ។ ក្នុង ឆ្នាំ ថ្មី ក្រុមហ៊ុន ឆាយ ណា ហ៊រ ទាន នឹង បន្ត ពួត ដៃ ប្រជាជន កម្ពុជា ដើម្បី រួមគ្នា បំភ្លឺ អនាគត និង កសាង ប្រទេស កម្ពុជា ឱ្យ កាន់តែ ល្អ បវរ ៕ លោក បណ្ឌិត ម៉ា ឈឿន បើក សន្និបាត បូកសរុប ការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក ជើង ព្រៃ ឆ្នាំ ២០២០ និង ទិសដៅ ភារកិច្ច បន្ដ ២០២១
( កំពង់ចាម ) ៖ លោក បណ្ឌិត ម៉ា ឈឿន តំណាងរាស្ដ្រ មណ្ឌល កំពង់ចាម សមាជិក គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក ជើង ព្រៃ និង លោកស្រី កិត្ដិ បណ្ឌិត អ៊ុក ម៉ាលី ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល បាន បើក សន្និបាត បូកសរុប ការងារ គណបក្ស ឆ្នាំ ២០២០ និង ទិសដៅ ភារកិច្ច ឆ្នាំ ២០២១ ។
កិច្ចប្រជុំ នេះ បាន ព្រឹត្ដទៅ នៅ ថ្ងៃទី ០៧ ខែកុម្ភៈ ឆ្នាំ ២០២១ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក ជើង ព្រៃ ខេត្ដ កំពង់ចាម ។ សន្និបាត នេះ លោក បណ្ឌិត ម៉ាឈឿន បាន លើក ពី សកម្មភាព ក្រុមការងារ គណបក្ស ដែល សម្រេចបាន ក្នុង ឆ្នាំ ២០២០ កន្លងទៅ និង លើក ទិសដៅ ឆ្នាំ ២០២១ រៀបចំ ជា កិច្ចការ អាទិភាព ដើម្បី ធានា បាន ជ័យជម្នះ ជូន គណបក្ស សម្រាប់ ការបោះឆ្នោត នា ពេល ខាងមុខ ដែល ត្រូវ ត្រៀមលក្ខណៈ ជាមុន ឲ្យបាន គ្រប់គ្រាន់ និង គ្រប់ ជ្រុងជ្រោយ ។
ជាពិសេស លោក បណ្ឌិត ម៉ា ឈឿន បាន លើកឡើង ពី ផែនការ មុខ ស្រួច ក្នុង ការគ្រប់គ្រង ការងារ ដើម្បី បម្រើ និង ដោះស្រាយ រាល់ បញ្ហា ខ្វះខាត ដែល ប្រជាពលរដ្ឋ តាម ភូមិ ឃុំ ជួបប្រទះ ។ លើស ពី នោះ ក៏ ត្រូវ ប្ដេជ្ញា រួមគ្នា សាមគ្គី គ្នា ដើម្បី បម្រើ សេវា សាធារណៈ ជូន ប្រជាជន ឱ្យ បាន ល្អ ប្រសើរ និង កសាង ជាតិ ឱ្យ មាន ការចម្រើន ។
ក្នុង ឱកាស នោះ ដែរ លោកស្រី កិត្ដិ បណ្ឌិត អ៊ុក ម៉ាលី ក៏ បាន ថ្លែង បញ្ជាក់ ថា គណបក្ស ប្រជាជន កម្ពុជា គឺ បាន យកចិត្ដទុកដាក់ គ្រប់ ពេលវេលា ទាំងអស់ លើ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ជាពិសេស សុខុមាលភាព ពលរដ្ឋ ជា ចម្បង ជាក់ស្ដែង ក្នុង វិបត្ដិ ជំងឺ កូវីដ១៩ នេះ ការពារ និង ជ្រោមជ្រែង កូន ចៅ មិន ឱ្យ នរណា ម្នាក់ ស្លាប់ ដោយសារ កូវី ដ១៩ និង ការអត់ឃ្លាន នោះ ឡើយ ។
គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រធាន និង ប្រមុខ ដឹកនាំ ប្រទេស កម្ពុជា ដ៏ រឹងមាំ ឈ្លាសវៃ គឺ តែងតែ រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេសៈ ។
ដូច្នេះ លោកស្រី បាន ជំរុញ ដល់ ក្រុមការងារ ត្រូវ ខិតខំ បន្ដ កិច្ចការ ការងារ ដ៏ ល្អ បន្ថែម ទៀត បម្រើ ប្រជាពលរដ្ឋ រួមទាំង ការផ្សព្វផ្សាយ អំពី គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា និង សមទ្ធិផល ថ្មី ៗ ជូន ពលរដ្ឋ ផងដែរ ។
ជាមួយគ្នា នោះ លោក បណ្ឌិត ម៉ា ឈឿន និង លោកស្រី កិត្ដិ បណ្ឌិត អ៊ុក ម៉ាលី ក៏ បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ សមាជិក សមាជិកា ដែល កន្លងមក នេះ បាន បម្រើ ជាតិ និង ប្រជាជន បាន យ៉ាង ល្អ រួមទាំង រួមគ្នា បន្ដ បេ្ដជ្ញា ពង្រឹង ការងារ ឱ្យ កាន់តែ ប្រសើរ ជូន ប្រជាពលរដ្ឋ ៕ ប្រជាពលរដ្ឋ ខ្វះខាត ៩៨ គ្រួសារ ទទួលបាន អំណោយ មនុស្សធម៌ ពី សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ ប្រធាន សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា នៅ ព្រឹក ថ្ងៃទី ០៨ ខែកុម្ភៈ ឆ្នាំ ២០២១ បាន ដឹកនាំ ក្រុមការងារ ចុះ សំណេះសំណាល និង ចែក អំណោយ មនុស្សធម៏ របស់ សាខា កាកបាទ ក្រហម ខេត្ត ជូន ប្រជាពលរដ្ឋ ខ្វះខាត ជីវភាព ចំនួន ៩៨ គ្រួសារ មកពី ភូមិ បឹង បាសាក់ ៤៥ គ្រួសារ ភូមិ កំពង់ រលីង ១៥ គ្រួសារ និង ភូមិ តាណេង ៣៨ គ្រួសារ ដែល ពិធី នេះ ធ្វើឡើង នៅក្នុង បរិវេណ វត្ត បឹង បាសាក់ សង្កាត់ សំបួរ មាស ក្រុង កំពង់ចាម ។
គណៈ មេធាវី អំពាវនាវ ឱ្យ សមាជិក ខ្លួន ទាំងអស់ ស្ម័គ្រចិត្ត ចូលរួម ការពារ ក្តី ជូន ពលរដ្ឋ ក្រីក្រ ដោយ ឥត គិត កម្រៃ
( ភ្នំពេញ )៖ គណៈ មេធាវី កម្ពុជា នៅ ថ្ងៃទី ០៨ ខែកុម្ភៈ ឆ្នាំ ២០២១ប នេះ បាន អំពាវនាវ ដល់ សមាជិក - សមាជិកា មេធាវី ទាំងអស់ ចូលរួម ឱ្យ បាន ច្រើន ធ្វើជា មេធាវី ស្ម័គ្រចិត្ត របស់ គណៈ មេធាវី ក្នុង ការប្រឹក្សា យោបល់ ផ្នែក ច្បាប់ ក៏ ដូចជា ការការពារ ក្តី ជូន ប្រជាពលរដ្ឋ ក្រីក្រ និង កម្មករ និយោជិត ដែល ខ្វះ លទ្ធភាព ពឹងពាក់ មេធាវី ដើម្បី ធ្វើ ការ ការពារ សិទ្ធិ របស់ ខ្លួន តាម ផ្លូវ ច្បាប់ ។
សេចក្តី អំពាវនាវ របស់ គណៈ មេធាវី ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃ នេះ បាន បញ្ជាក់ ថា ដើម្បី ចូលរួមចំណែក ក្នុង ការបម្រើ វិស័យ យុត្តិធម៌ សង្គម ឱ្យ កាន់តែ ប្រសើរឡើង គណៈ មេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ដាក់ចេញ នូវ គោល នយោបាយ ស្តីពី ការពិគ្រោះយោបល់ និង ការការពារ ក្តី ជូន ជន ក្រីក្រ ដោយ ឥត គិត កម្រៃ ។
គណៈ មេធាវី បាន បញ្ជាក់ ថ ដើម្បី សម្រេចបាន នូវ គោល នយោបាយ នេះ គណៈ មេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវ ការចាំបាច់ នូវ ការចូលរួម ពី សមាជិក - សមាជិកា មេធាវី ទាំងអស់ ដោយ ស្ម័គ្រចិត្ត ក្នុង ដំណើរការលើ ការពិគ្រោះយោបល់ ច្បាប់ និង ការ ការពារ ក្តី ជូន ជន ក្រីក្រ ។
តាមរយៈ នេះ គណៈ មេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ធ្វើ ការអំពាវនាវ ដល់ សមាជិក - សមាជិកា មេធាវី ទាំងអស់ មេត្តា ចូលរួម ឱ្យ បាន ច្រើន ធ្វើជា មេធាវី ស្ម័គ្រចិត្ត របស់ គណៈ មេធាវី ក្នុង ការប្រឹក្សា យោបល់ ផ្នែក ច្បាប់ ក៏ ដូចជា ការការពារ ក្តី ជូន ប្រជាពលរដ្ឋ ក្រីក្រ និង កម្មករ និយោជិត ដែល ខ្វះ លទ្ធភាព ពឹងពាក់ មេធាវី ដើម្បី ធ្វើ ការ ការពារ សិទ្ធិ របស់ ខ្លួន តាម ផ្លូវ ច្បាប់ ៕
