( ប៉ៃលិន) ៖ នៅ រសៀល ថ្ងៃសុក្រ ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២១ លោកស្រី បណ្ឌិត បាន ស្រី មុំ អភិបាល ខេត្ត ប៉ៃលិន បាន អញ្ជើញ ជួប សំណេះសំណាល សួរសុខទុក្ខ ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ ចំនួន ពីរ មន្ទីរ ផ្សេង គ្នា គឺ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត ។
ក្នុង កីច្ច សំណេះសំណាល នេះ ដែរ លោកស្រី អភិបាល ខេត្ត ជាមួយ មន្ទីរ ពាក់ព័ន្ធ នីមួយ ៗ ដើម្បី សម្រួល បែប បទ រដ្ឋបាល ផ្សេង ៗ ឲ្យ ការងារ ដំណើរការ ទៅ ដោយ រលូន ក្នុង ការបំរើ ការងារ មាន ភាពទទួលខុសត្រូវ និង តម្លាភាព ។
ជាមួយគ្នា នោះ ដែរ លោកស្រី អភិបាល ខេត្ត បាន ណែនាំ ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជា ការ នៅ តាម មន្ទីរ នីមួយ ៗ ត្រូវ មាន សាមគ្គីភាព ផ្ទៃក្នុង សហការ គ្នា ក្នុង មន្ទីរ សាម៉ី និង នៅ អង្គភាព ដ៍ទៃ បំពេញ ការងារ តាម តួនាទី ដោយ ទទួល ខ្ពស់ ពិសេស ត្រូវ ខិតខំ បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលដ្ឋ អោយ បាន លឿន និង មាន ប្រសិទ្ធភាព កុំ ប្រកាន់ បក្ខពួក សាច់ញាតិ បងប្អូន ឡើយ ។
លើស ពី នេះ ត្រូវ ចូលរួម សម្អាត បរិស្ថាន អនាម័យ នៅ តាម កន្លែង ធ្វើការ របស់ ខ្លួន ឲ្យ ស្រស់ស្អាត គ្មាន សម្រាម ដើម្បី រក្សា សោភ័ណភាព ទាក់ទាញ ការចាប់អារម្ភ ពី ភ្ញៀវ ទេសចរ និង ចូលរួម ផ្សព្វផ្សាយ បង្ការ ទប់ស្កាត់ ការរីករាលដាល វីរុស កូវី ដ១៩ ចូលក្នុង សហគមន៍ ៕ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ផ្ញើ សារំលែក ព្រះមរណទុក្ខ ចំពោះ ការយាង ចូល ព្រះទិវង្គត សម្តេច ព្រះបរម រាមា នរោត្តម យុវនា ថ
( ភ្នំពេញ ) ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា នៅ ថ្ងៃទី ១៦ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ ព្រះរាជ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ ការយាង ចូល ព្រះទិវង្គត សម្តេច ព្រះបរម រាមា នរោត្តម យុវនាថ ។
សារ រំលែក ព្រះមរណទុក្ខ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន មាន ខ្លឹមសារ ទាំងស្រុង យ៉ាង ដូច្នេះ ថា៖ « ខ្ញុំ និង ភរិយា មាន សេចក្តីក្រៀមក្រំ បំផុត ដោយ ទទួល បាន ដំណឹង សម្តេច ព្រះបរម រាមា នរោត្តម យុវនា ថ ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ទ្រង់ យាង ចូល ព្រះទិវង្គត នៅ ថ្ងៃព្រហស្បតិ៍ ១កើត ខែ មាឃ ឆ្នាំ ជូត ទោស័ក ព .ស ២៥៦៤ ត្រូវនឹង ថ្ងៃទី ១៤ ខែមករា ឆ្នាំ ២០២១ នៅ សហរដ្ឋ អាមេរិក ក្នុង ព្រះជន្មាយុ ៧៨ ព្រះវស្សា ដោយ ព្រះរោគា ពាធ ។
ខ្ញុំ សូម ឧទ្ទិស បួងសួង ដល់ ព្រះវិញ្ញាណក្ខន្ធ សម្តេច ព្រះបរម រាមា នរោត្តម យុវនា ថ ទ្រង់ យាង យោន យក កំណើត កើត ក្នុង សុគតិភព គ្រប់ ៗ ព្រះជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ » ។
បន្ថែម ពី ខាងលើ នេះ រដ្ឋមន្ត្រី មកពី ប្រទេស ស៊ុយអែត . ដាណឺម៉ាក . ហ្វាំងឡង់ . លីទុយ អានី . ឡាត វី និង អេស្តូនី ក៏ បាន សង្កត់ធ្ងន់ បន្ថែម ផងដែរ ថា « វា មិន ត្រឹមតែ ធ្វើឲ្យ ប៉ះពាល់ ដល់ កាលវិភាគ នៃ កម្មវិធី ចាក់ វ៉ាក់សាំង ដែល បាន គ្រោង ទុក ប៉ុណ្ណោះ ទេ វា ថែមទាំង កាត់បន្ថយ ភាពជឿជាក់ នៃ ដំណើរការចាក់ វ៉ាក់សាំង ផងដែរ » ។
លោក គីម ជុង អ៊ុន អគ្គ លេខាធិការ នៃ គណបក្ស ពលករ កូរ៉េ និង ជា ប្រធាន គណៈកម្មការ កិច្ចការ រដ្ឋ (SAC) ព្រមទាំង ជា អគ្គមេបញ្ជាការ នៃ កងកម្លាំងប្រដាប់អាវុធ របស់ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត កូរ៉េ ( កូរ៉េ ខាងជើង ) បាន បង្ហាញ វត្តមាន នៅឯ ទីលាន ខាងលើ នេះ ។ គ្រប់ គ្នា បាន ទះដៃ និង ស្រែក ហ៊ោរក ញ្ចៀវ ជា កិច្ច ស្វាគមន៍ ចំពោះ លោក គីម ជុង អ៊ុន និង អរគុណ ចំពោះ ការលះបង់ សម្រាប់ វិស័យ ការពារ ជាតិ ដែល នាំឲ្យ រញ្ជួយ មេឃ និង ធរណី អម ដោយ ពន្លឺ កាំ ជ្រួច ចំរុះ ពណ៌ លម្អ ផ្ទៃ មេឃ នា ពេល រាត្រី ។
( កំពង់ចាម ) ៖ នា ព្រឹក ថ្ងៃទី ១៦ ខែមករា ឆ្នាំ ២០២១ លោក លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម អម ដំណើរ ដោយ លោក ចាន់ ស៊ីណាត អនុ រដ្ឋលេខាធិការ ក្រុមប្រឹក្សា ខេត្ត កំពង់ចាម លោក ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត កំពង់ចាម ក្រុម មន្រ្តី បច្ចេកទេស និង អាជ្ញាធរ មូលដ្ឋាន បាន ចុះ ពិនិត្យ ការដ្ឋាន សាងសង់ ប្រព័ន្ធ ធារាសាស្រ្ត ព្រែក ពោធិ៍ នៅ ស្រុក ស្រីសន្ធ រ ខេត្ត កំពង់ចាម ។
គម្រោង សាងសង់ ប្រព័ន្ធ ធារាសាស្រ្ត ទំនើប នេះ ជា ជំនួយ ហិរញ្ញប្បទាន ពី ធនាគារ អភិវឌ្ឍន៍ អាស៊ី (ADB ) បើ តាម ផែនការ គឺ ត្រូវបាន សាងសង់ រួចរាល់ ហើយ តែ ដោយសារ ការរីករាល នៃ ជំងឺ កូវីដ - ១៩ បាន បង្ក ភាពយឺត យាវ ដល់ ការអនុវត្ត គម្រោង ដែល រហូតមកដល់ ពេលនេះ ទើប សម្រេចបាន ប្រមាណ តែ ៣០% ប៉ុណ្ណោះ ។
មិន ចំពោះ តែ គម្រោង នេះ បណ្តា គម្រោង ផ្សេង ៗ ទៀត ដែល សហការ ជាមួយ ប្រទេស ជា មិត្ត ផ្តល់ ជំនួយ និង ដៃគូ អភិវឌ្ឍន៍ នានា សុទ្ធតែ ជួប ភាព រាំងស្ទះ ដោយសារ ការ ពិបាក ធ្វើដំណើរ រចុះ ពិនិត្យ វាយតំលៃ មុននឹង អាច ដំណើរ សាងសង់ របស់ ក្រុម ជំនាញ ការបរទេស ក្នុង បរិបទ ការរាតត្បាត ជា សកល នៃ ជំងឺ កូវីដ - ១៩ នេះ ។
សូម បញ្ជាក់ ថា ទំហំ ការងារ នៃ គម្រោង ប្រព័ន្ធ ធារាសាស្រ្ត ព្រែក ពោធិ៍ រួម មាន៖
គម្រោង ប្រព័ន្ធ ធារាស្រ្ត នេះ មាន លក្ខណៈ គ្រប់ ជ្រុងជ្រោយ ជា ប្រព័ន្ធ បេតុង ទាំងអស់ និង បំពាក់ ដោយ ស្ថានីយ បូម ទឹក ទំនើប ក្នុង និយាម អន្តរជាតិ ធ្វើ ការបូម ទឹក ពី អាង ទន្លេ មេគង្គ រង ដែល ជា សមិទ្ធិផល ថ្មី មួយ ទៀត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក រដ្ឋមន្រ្តី បាន កោតសរសើរ ដល់ ក្រុមការងារ បច្ចេកទេស សាងសង់ ដែល បាន ខិតខំ ធ្វើ ការ ទោះ ជួប ឧបសគ្គ និង បញ្ហា ប្រឈម ខ្លះ ៗ មួយចំនួន និង ណែនាំ ដល់ មន្ទីរ ត្រូវ បន្ត តាមដាន និង សហការ ជាមួយ អាជ្ញាធរដែន ដី បន្ថែម ធ្វើ យ៉ាងណា ឲ្យ សំណង់ នេះ មាន គុណភាព រឹងមាំ យូរអង្វែង ដើម្បី បម្រើ ជា ប្រយោជន៍ ដល់ ការងារ បង្កបង្កើន ផល និង ផ្តត់ ផ្គង់ ទឹក ប្រើប្រាស់ ដល់ ជីវភាព ប្រចាំ ថ្ងៃ របស់ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង តំបន់ ។
