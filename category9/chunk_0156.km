ទៀត អាចនឹង ពិនិត្យ ពិចារណា លើ បញ្ហា នេះ ។
ដោយ ពួកគាត់ មិន យល់ ពី ផល ប៉ះពាល់ ដល់ សុខភាព ឡើយ ។
ក្នុង ពេល បច្ចុប្បន្ន ព្រោះថា លទ្ធផល នៃ ការងារ ទាំងឡាយ មិន អាច សម្រេច មក អំពី ការបន់ស្រន់ នោះ ឡើយ ៕
ក្រោយមក ដើម ខ្នុរ នេះ ត្រូវបាន កាប់ ចោល ហើយ ។
តែ ធម្មតា របៀប ប្រើ កាំភ្លើង គឺ អញ្ចឹង !
ឯកសារ បាន ឱ្យដឹង ថា ៖
ព្រះយេស៊ូវ ប្រាប់ ថា ទ្រង់ នឹង ដំកើង ខ្ញុំ ដ្បិត ទ្រង់ នឹង យក សេចក្តី ដែល តម្រូវពី ខ្ញុំ មក ប្រាប់ ដល់ អ្នក រាល់គ្នា យ៉ូហាន ១៦១៤ ឬ ដូច ទ្រង់ ប្រាប់ នៅក្នុង យ៉ូហាន ១៥២៦ ព្រះវិញ្ញាណ បរិសុទ្ធ នឹង ធ្វើ បន្ទាល់ ពី ខ្ញុំ ។
លោក បាន សរសេរ ថា សួស្តី អ្នក រាល់គ្នា ពីរ ថ្ងៃ មុនពេល កំពុង ថត នៅ ស៊័ង សាន ខ្ញុំ បាន រងរបួស ភ្នែក ស្តាំ ដោយ ចៃដន្យ ហើយ វេជ្ជបណ្ឌិត បាន ដេរ ខ្ញុំ ៨ថ្នេរ ។
នាយក ប្រតិបត្តិ ពាណិជ្ជកម្មសិង្ហបុរី មួយ រូប បាន និយាយ ថា លោក សង្ឃឹម ថា ផ្សាយ នូវ សុឆន្ទៈ
នោះ ឡើយ គឺ សុទ្ធតែ ជា លទ្ធផល នៃ ការអប់រំ ចម្រើន ទាំងអស់ ។
ក៏ប៉ុន្តែ យើង មិន បាន ទៅដល់ ចំណុច នោះ នៅឡើយ ទេ ។
ទៀត ពោលគឺ ទំនាក់ទំនង នៃ ប្រទេស ទាំង ពីរ មាន លក្ខណៈ សំខាន់ បំផុត ។
ផ្ទុយទៅវិញ អ្នក ត្រូវ បញ្ចេញ នូវ គំនិត ឬ យោបល់ របស់ អ្នក ។
បញ្ញត្តិ អំណាច គឺ ភ្ជាប់ នឹង សិទ្ធិ សម្រេច ដែល ប្រកបដោយ ការទទួលខុសត្រូវ ។
ចំនួន ៥គ្រឿង ដឹក ឈើ ចេញពី បរិវេណ ក្រុមហ៊ុន ៩៥ ហើយ ពួកគាត់ មិន ដឹង ថា ឈើ ទាំងនោះ មាន ច្បាប់ អនុញ្ញាត ឬ គ្មាន នោះ ទេ ។
តើ អ្នក ចាប់ផ្តើម ចេះ ច្រៀង តាំងពី ពេលណា មក ?
គ្រប់ ក្រុម មិន ថា បក្ស នយោបាយ ឬ ក្រុមគ្រួសារ សុទ្ធតែ មាន គំនិត ខុសប្លែក គ្នា វា ជា ច្បាប់ ធម្មជាតិ ។
បើសិន ពួកគេ យក បាន រថយន្ត នេះ ពួកគេ អាច បើក បុក ចូល កងកម្លាំង ប៉ូលិស ផ្សេង ទៀត ៕
គេ ក៏ ត្រូវការ ពេលវេលា តែ ម្នាក់ឯង ដើម្បី បញ្ចូល ថាមពល ឱ្យ ខ្លួន គេ ដែរ ។
យក យាន្ត អវកាស ក្នុង ភាពយន្ត អាមេរិក មក សង់ ជា អាគារ ក្រុមហ៊ុន
សេចក្តីព្រាង ច្បាប់ ស្តីពី បត្យាប័ន នេះ ដែល នឹង អនុញ្ញាតឱ្យ ចាប់ បញ្ជូន ខ្លួនអ្នកទោស ដែល គេចខ្លួន ទៅ ប្រទេស ចិន វិញ ។
រីឯ ម្នាក់ ទៀត ទើបតែ ចាប់ផ្តើម ការងារ នេះ ប៉ុន្មាន ខែ ប៉ុណ្ណោះ ដោយសារ ខ្វះខាត ជីវភាព ។
នេះ មិន និយាយ ពី អាមេទ ព័បាញ់ អាចម៍ ផង ។
លោក យល់ ថា ការសម្រេច របស់ តុលាការ ថ្នាក់ ក្រោម ត្រឹមត្រូវ ហើយ ។
សារ វិជ្ជមាន គឺ ផ្នែក សេដ្ឋកិច្ច រីឯ សារ អវិជ្ជមាន វិញ គឺ ផ្នែក យោធា
ទេ ដោយ ហួស ពី ការទ្រទ្រង់ បាន របស់ រោងចក្រ ៕
ទេសចរ នៅ ក្រុង ព្រះសីហនុ ថយចុះ តែ នៅ ២៥ ខេត្ត ក្រុង មាន ការកើនឡើង
ព័ត៌មាន ភ្នំពេញ សេដ្ឋកិច្ច
ការងារ ល្អ ប្រសើរ មាន ឱកាស ឡើង តំណែង ។
សមយុទ្ធ ដែល ចិន គ្រោង ធ្វើជា ទៀងទាត់ ជា សេណារីយ៉ូ មួយ ចង់ ក្តោប យក កោះ តៃវ៉ាន់ ?
ឃ. ធ្វើ ដូច្នេះ មួយ ទៅ ពីរ ដង ក្នុង មួយ សប្ត ហា៍ ដើម្បី ទទួលបាន ប្រសិទ្ធភាព ខ្ពស់ ។
រយៈពេល នៅ វែងឆ្ងាយ ហេតុ នេះ ព្រឹត្តិការណ៍ ប្រហែលជា មិន លុបចោល នោះ ទេ ។
ចុច អនុវត្ត ហើយ បន្ទាប់មក យល់ព្រម ។
ដូច្នេះ យើង អាចនឹង ឃើញ មាន ការ ចំណាកស្រុក របស់ ប្រជាពលរដ្ឋ ដែល ប៉ះពាល់ ដល់ រលក ថ្មី មួយ របស់ ប្រជាជន វៀតណាម ដែល រស់ នៅ លើ ទូក ។
ក្នុង ការរៀបចំ កន្លែង ធ្វើការ ឱ្យ មាន ហុង ស៊ុយល្អ ។
ទោះជាង យ៉ាង នេះ នា ពេលនេះ សមត្ថកិច្ច កំពុង ចេញ ទៅ អន្តរាគមន៍ បាញ់ ពន្លត់ ៕
នេះ បើ តាម ការអះអាង របស់ អ្នកស្រី …
យ៉ាងណាមិញ បើ នារី ៗ
ក្រោយ កើត ហេតុ សមត្ថកិច្ច ជំនាញ បាន បញ្ជូន ជនរងគ្រោះ ទៅ មន្ទីរពេទ្យ ។
ប្រទេស ថៃ ពោរពេញ ទៅ ដោយ គំនិត សិល្បៈ និង សិប្បកម្ម ។
ជំរាប សួរ នឹង សូមស្វាគមន៍ ណា ច័ន្ទ
អគ្គិភ័យ ឆាប ផ្ទះ មេភូមិ ១ខ្នង នៅ សង្កាត់ មនោរម្យ ខណ្ឌ ៧មករា
បុរស ម្នាក់ ត្រូវ សមត្ថកិច្ច ឃាត់ ពី បទ ប្រទូស្ត កេរ្តិ៍ ខ្មាស
តំណាង ខុទ្ទកាល័យ លោក នាយក រដ្ឋមន្ត្រី ក៏ បាន មក ជួប ពួក គាត់ ដើម្បី សាកសួរ ពី គោលបំណង ស្នើសុំ នេះ ។
មនុស្ស ទាំងអស់ ស្ថិត នៅក្រោម អំណាច នៃ អំពើ បាប ឥត មាន ទីសង្ឃឹម ហើយ គ្មាន ព្រះក្នុង លោកីយ៍ នេះ ដែរ អេភេសូរ ២១២ ។
លោក ហេង សំរិន ប្រធាន រដ្ឋសភា បាន បញ្ជាក់ នៅក្នុង លិខិត ជូន លោក តំណាង
ឱ្យ តែ គេ បកស្រាយ សមហេតុសមផល យើង ទទួលយក បាន ហើយ ។
នេះ បើ តាម ការបញ្ជាក់ របស់ លោក ពិទ័រ ហ្ស៊ីហ្សារ តូ ។
ច្បាប់ ប្រទេស មិន ដូច វិធាន សីលធម៌ ឡើយ ។
យើង មិន ចង់ឱ្យ មាន ការបាត់បង់ជីវិត ក្មេង ៗ
រូបថត ពីមុន និង បច្ចុប្បន្ន របស់ នាង ពេល ដាក់ ជិត គ្នា
ក្រសួង ធនធាន ទឹក បាន បញ្ជាក់ យ៉ាង ច្បាស់ ថា សូម បង្កើន ការប្រុងប្រយ័ត្ន ខណៈ ទឹក ស្ទឹង សែន កំពុង ហក់ ឡើង ខ្លាំង !
រដ្ឋាភិបាល ស្នើ ច្បាប់ វា ជា រឿង ធម្មតា ។
ទូទ្វា ហែក សាសុង មាន ចុច ទឹក ផលិត ទឹកកក ទើចូល ស្តុក
លោក មហា បូជាចារ្យ សួរ ព្រះអង្គ ទៀត ថា ៖
យើង សង្ឃឹម ថា រឿង នេះ មិន ត្រូវបាន គេ បកស្រាយ ហួសហេតុ ពេក ទេ ។
ក្រុម ស្ត្រី និង យុវជន
ទ្រង់ ប្រារព្ធ នឹង ព្រះឆន្នៈ មាន អាយុ ។
១ របៀប ទាញយក កូដ
ប៉ុន្តែ ការរស់នៅ របស់ គាត់ ក៏ មិន រីករាយ រហូត នោះ ដែរ ។
ធ្វើឱ្យ បាត់បង់ ស្មារតី ទប់ អារម្មណ៍ មិន បាន មិន អាច គ្រប់គ្រង ខ្លួន បាន ។
បើសិន បក្ខពួកគាត់ គាត់ ដក មុខវិជ្ជា ផ្សេង ៗ
វា ជា ការសំខាន់ ណាស់ ដែល អ្នក ត្រូវ បំភ្លេច ចោល នូវ ការបារម្ភ និង ស្ត្រេស ។
ស្ថានភាព បច្ចុប្បន្ន
សេវា ឥណទាន អរគុណ ជាពិសេស ចំពោះ
ប៉ុន្តែ មាន មនុស្ស តែ ម្នាក់ គត់ ដែល មិន ទាន់ មកដល់ គឺ ប្រធាន ។
៦ហេតុ នេះ សូម្បីតែ មនុស្ស ស្លាប់ ក៏ ព្រះអង្គ បាន នាំ ដំណឹង ល្អ ទៅ អោយ គេ ឮ ដែរ ។
ទៀត អ៊ីចឹង គាត់ អាច មើល សៀវភៅ ហ្នឹង ។
មាន ៨ ចំណុច ដើម្បី លើកស្ទួយ ឱ្យ វិស័យ សណ្ឋាគារ រីកចម្រើន
លោក គូតេរ៉េ បាន អំពាវនាវ ឱ្យ ក្រុម អ្នកនយោបាយ បញ្ជូន សារ ច្បាស់ ៗ
មនុស្ស ស្រី ត្រូវ ចាំ ថា គ្មាន មនុស្ស ប្រុស ណារវល់ រហូត សូម្បីតែ គ្មាន ពេល សម្រាប់ នារី ដែល ខ្លួន ស្រលាញ់ មិន បាន នោះ ទេ តែ គ្រាន់ គេ មិន ចង់ ។
នៅក្នុង ទសវត្សរ៍ ទី
យើង គួរតែ ប្រៀបធៀប វា ជាមួយ ប្រទេស ផ្សេង ទៀត ដូចជា ប្រទេស ថៃ វៀតណាម និង ម៉ាឡេស៊ី ។
អ្នក ក៏ ត្រូវ រង នូវ សម្ពាធ ហិរញ្ញវត្ថុ ផងដែរ ក្នុង ទំនាក់ទំនង ផ្សេង ៗ
ជា លទ្ធផល ភ្ញៀវ ទេសចរ ៥ ពាន់ នាក់ ចូលមក លេង កម្សាន្ត នៅ តំបន់ ឆ្នេរ នេះ ជារៀងរាល់ ថ្ងៃ ។
ប៉ុន្តែ ប្រសិនបើ ក្រុមហ៊ុន អាកាសចរណ៍ ផ្អាក ជើងហោះហើរ ៨០ ភាគរយ ទៅកាន់ តំបន់ វីរុស អេបូឡា គឺ ការឆ្លង រាលដាល អាច នៅ កម្រិត តែ ២៥ ឬ ១៥ ភាគរយ ប៉ុណ្ណោះ ។
១៥ បងប្អូន បាន អោយ គេ ធ្វើ គុត ម្ចាស់ នៃ ជីវិត ប៉ុន្តែ ព្រះជាម្ចាស់ បាន ប្រោស អោយ ព្រះអង្គ មាន ព្រះជន្ម រស់ ឡើងវិញ យើងខ្ញុំ ជា សាក្សី អំពី ហេតុការណ៍ នេះ ។
ប្រទេស កម្ពុជា ក៏ មាន នៅក្នុង នោះ ដែរ ។
កម្មករ និយោជិត ដែល ឈប់ សម្រាក បុណ្យ ចូល ឆ្នាំ នឹង ត្រូវ ដាក់ ដាច់ដោយឡែក ១៤ ថ្ងៃ ដោយ មិន ទទួលបាន ប្រាក់ ឈ្នួល
រីឯ បញ្ហា ស្នេហា មាន ស្ថានភាពល្អូកល្អ នឺ ។
ដល់ ពេល ក្នុង ឆ្នាំ ២០០៩ រហូតដល់ ឆមាស ទី១ ហ្នឹង យើង អត់ មាន គម្រោង ធំ
វា ជា កីឡា ដែល កំពុង ពេញនិយម ហើយ មនុស្ស នឹង មាន កន្លែង ដើម្បី អនុវត្ត វា ។
ពលរដ្ឋ ខេត្ត កំពង់ចាម ទាមទារ ឱ្យ មាន ការជ្រើសរើស មេភូមិ ថ្មី ចេញ ពី ពលរដ្ឋ ភាគ ច្រើន
យ៉ាងណាមិញ តាំងពី ដំបូង មក ពួកគេ មិន ដែល ចាប់អារម្មណ៍ ឆ្លើយ នឹង សំណួរ ហេតុ អ្វី ទើប ពួកគេ ធ្វើ វា នោះ ទេ ។
សម្តេច ព្រះមហាសង្ឃរាជ និល ទៀង រូបថត វត្ត ខេមររតនា រាម
បោះឆ្នោត ជូន គណបក្ស ប្រជាជន គឺ បោះឆ្នោត ឱ្យ ខ្លួន ឯង បោះឆ្នោត ការពារ សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ គ៨៥
ចិន គ្រោង ពង្រឹង ទំនាក់ទំនង យោធា ជាមួយ អាមេរិក
រុស្ស៊ី អ៊ីស្រាអែល
អនុប្រធាន សហគមន៍ លោក ឈុំ សឿត បញ្ជាក់ ថា ក្នុង សហគមន៍ របស់ យើង មាន ២០រ ទេះគោ ។
អ្នកភូមិ មកពី សហគមន៍ ព្រៃឈើ ក្នុង ខេត្ត ចំនួន ៩ កាលពី ម្សិលមិញ បាន អំពាវនាវ ឱ្យ រដ្ឋាភិបាល ចាត់ វិធានការ ទៅ លើ ករណី បុគ្គល អ្នក មាន និង មាន អំណាច ដែល កំពុង បង្កឱ្យ មាន ការបំផ្លាញ ធ្ងន់ធ្ងរ ទៅ លើ ជីវភាព របស់ ពួកគេ ។
អញ្ចឹង ត្រី ហ្គូប៊ី ចាំបាច់ ត្រូវតែ ការពារ ជម្រក របស់ វា ។
គ. ថ្នាល ដាប៉ុក
ពត៌មាន ប្រចាំ ថ្ងៃ កុរ ខាល និង ម្សាញ់ ភាគ ច្រើន ជា សេដ្ឋី
គ្មាន ជន ណា ម្នាក់ រងគ្រោះ ក្នុង ហេតុការណ៍ នេះ ទេ ។
បាញ់ ហយ ទាយាទ នៃ សម្បត្តិ វប៌្បធ ម
មន្ត្រី អង្គការ សង្គម ស៊ីវិល ហៅ ទង្វើ នេះ ថា ជា ការអនុវត្ត ខុស ច្បាប់ ។
លទ្ធផល ពិតជា នឹកស្មាន មិន ដល់ ព្រោះតែ …
ការចាកចេញ ឆ្លង ដែន ខុស ច្បាប់ របស់ ពលករ ខ្មែរ នៅតែ បន្ត កើតមាន ជា ដដែល ៗ
កញ្ញា វរវង្ស និយាយ បែប នេះ ។
ពី ខាងក្រៅ ពួកគេ បាន ឮ សូរ តែ សម្រែក ស្រែក ខ្លាំង ៗ
មនុស្ស ស្រី រឹងមាំ គឺជា បុគ្គល ដែល អាច ដោះស្រាយ បញ្ហា បាន ដោយ ខ្លួន ឯង ដោយ មិន ចាំបាច់ ត្រូវការ ជំនួយ ពី នរណា ។
ម្យ៉ាង ប្រជាពលរដ្ឋ យើងខ្ញុំ គ្មាន សិទ្ធិ អំណាច អី ទេ … ខ្ញុំ ក៏ មិន ដឹង ដែរ ខាង ហ្នុង អាជ្ញាធរ ប្រហែលជា គេ ផ្សំ គំនិត ជាមួយគ្នា ដឹង បានជា ទៅ ស្រួល អ៊ីចឹង ។
អ្នក រាល់គ្នា នឹង ច្រូត បាន ភក្តីភាព យ៉ាង បរិបូណ៌ !
ទី២. ការអនុវត្ត វិធីសាស្ត្រ ល្អ ៗ
ខ្មែរ ម្ចាស់ ស្រុក ៖
ប៉ុន្តែ បើ មាន រឿង ដូច កាលើកឡើង នោះ មែន លោក ហ្នឹង ធ្វើ ការស្រាវជ្រាវ ព្រោះ មន្ត្រី ទាំងនោះ អាច ហ្នឹង បាន កន្ទេល ធំ បន្លំ ដេក ៕
យ៉ាងណាមិញ វិធី ទាំងនេះ មិន មែន ជា ក្បួន តម្រា ដែល បាន ចារ លើ សិលាចារឹក នោះ ទេ ។
មាន គោលបំណង ផ្ទាល់ខ្លួន តុល្យភាព ដើម្បី និយាយ ។
នេះ លោក ជា អ្នក បរិសុទ្ធ របស់ ព្រះ
ពាក្យ បណ្តឹង ផ្តោត លើ ការជំរឿន ប្រជាជន …
មាន ទំរង់ ការកែសម្ភស្ស ជាច្រើន ប្រភេទ ដែល អ្នក អាច ធ្វើ វា បាន ដើម្បី កាត់បន្ថយ នូវ ស្នាម ខ្មៅ ដែល មាន នៅ ជុំវិញ ភ្នែក របស់ អ្នក ដែល វា មិន បាន បាត់ ទៅវិញ បើ ទោះជា អ្នក បាន អនុវត្ត នូវ វិធីសាស្ត្រ ជាច្រើន រួច មកហើយ ។
នេះ បើ យោង តាម អ្នកវិទ្យាសាស្ត្រ មិន បញ្ចេញ ឈ្មោះ ម្នាក់ ដោយសារតែ ភាពរសើប នៃ គម្រោង នេះ ។
គ្នា ឈានដល់ តួលេខ ២ខ្ទង់ ។
នេះ បញ្ជាក់ ពី ចេតនា ហើយ សម្តេច មិន សុខចិត្ត ។
ក្រសួង នោះ បញ្ជាក់ ថា យើង មាន ការខកចិត្ត ចំពោះ ការធ្លាយ ចេញ នេះ ហើយ យើង សុំទោស ។
ខណៈពេល ដែល វា បាន បម្លែង ចប់ អ្នក អាច បើក មើល ទៅកាន់ ទីតាំង ដែល អ្នក កំណត់ ការរក្សាទុក ជា ការស្រេច ។
១. បើកបរ រថយន្ត
១. ច្រកទ្វារ កូវ៉ាក់ ៖
គេ នៅ ចាំ បាន ថា កាលពី ក្រោយ ការបោះឆ្នោត ឆ្នាំ ២០១៣ នៅ កម្ពុជា ក៏ មាន ផ្ទុះឡើង នូវ
អគ្គ នាយកដ្ឋាន គយ សម្រេច បន្ថយ ពន្ធ ចំពោះ រថយន្ត គ្មាន ពន្ធ នាំចូល បូក គោ ញូស
ក្មេងប្រុស ម្នាក់ កើត មក ជាមួយ ទេពកោសល្យ ។
ទំហំ ប្តូរ តាម បំណង សន្លឹក កម្រាល ប្លាស្ទិច
ការទទួលបាន នូវ ការ គេង ពេល យប់ គឺជា អ្វី ដែល អ្នក ត្រូវការ ដើម្បីឱ្យ អ្នក មានអារម្មណ៍ ប្រសើរឡើង នៅ ថ្ងៃស្អែក ។
តាំងពី កុមារភាព នាងខ្ញុំ ចង់ ក្លាយជា មនុស្ស ជោគជ័យ ម្នាក់ ពិសេស ផ្នែក ជំនួញ ថ្វីបើ នាងខ្ញុំ មិន មែន ជា កូន អ្នកជំនួញ ធំ ក៏ដោយ ។
ដល់ ពេល ប្រជាពលរដ្ឋ គាត់ មាន ទុក្ខលំបាក បញ្ហា អ្វី មួយ គាត់ អត់ សូវ យកចិត្តទុកដាក់ ។
នេះ ប្រសិនជា គ្មាន ការជំទាស់ ពី ប្រជាពលរដ្ឋ នោះ ។
ការ មិន គិត ពី គោលការណ៍ សិទ្ធិ មនុស្ស នោះ នឹង ធ្វើឱ្យ រឿង យុត្តិធម៌ នេះ ទៅជា រឿង នយោបាយ នៅ ទីបំផុត ។
ធនាគារ ឌូស ខេ បេង ខ៏ កំណើន
គ្នា ហើយ ចំណង់ចំណូលចិត្ត ទាំងនោះ អាច មាន ដូចជា ការស្លៀកពាក់ ចំណីអាហារ និង របស់ ផឹក ជាដើម ។
ពួកគេ ប្រញាប់ប្រញាល់ នាំគ្នា ធ្វើដំណើរ ទៅ ឃើញ ម៉ារីយ៉ូ សែប ព្រមទាំង ព្រះឱរសផ្ទំ ក្នុង ស្នូក សត្វ ។
ខាង ខេស៊ី មិន គេ មិន អាច យក គាត់ ចូល ធ្វើ ការវិញ កើត ទេ ពីព្រោះ គាត់ ធ្លាប់ មាន បញ្ហា កន្លងមក ។
ធនាគារ ពិភពលោក ស្នើ ឱ្យ វិស័យ ឯកជន ជួយ ដល់ ផ្នែក ដឹកជញ្ជូន វៀតណាម
ការបាញ់ សម្លាប់ មនុស្ស ដោយ យក ពាក្ស ថា ញុះញង់ ជ្ោតុផល វា ជា រឿង ល្ងង់ខ្លៅ បំផុត ។
នេះ បច្ចេកទេស នេះ ត្រូវបាន កែតម្រូវ ដើម្បី បន្ស៊ាំ ទៅនឹង ស្ថានភាពប្រែប្រួល ដែរ ឬ ទេ ?
កម្ព ជា កំពុង ទទួល រង ឥទ្ធិពល ពី បាតុភូត ធម្មជាតិ ចំនួន ៣ព្រម ៗ
ទាំង ក្រសួង ការពារ ជាតិ និង ក្រសួង ការបរទេស ចិន មិន បាន ឆ្លើយតប ភ្លាម ៗ
ដើម្បី គ្រប់គ្រង ការបញ្ចេញ ទឹក កាម ។
កម្ពុជា មាន សក្តានុពល ខ្ពស់ ជា ឱកាស ល្អ សម្រាប់ ជនជាតិ អាមេរិក មកវិនិយោគ
មួយ ថ្ងៃ របស់ ខ្ញុំ សេង វិសាល
យើង ត្រូវ អនុវត្ត កាតព្វកិច្ច របស់ យើង ក្នុង ការត្រួតពិនិត្យ ។
គូស្នេហ៍ អ្នក នឹង ឈឺចាប់ ធុញទ្រាន់ ហើយ គ្មាន ក្តីសុខ ។
សង្គម កាន់តែ ជឿនលឿន ទៅ សង្គម ចាត់ទុក ថា យើង ម្នាក់ ៗ
ក្តីស្នេហា មិន អាច ហាមឃាត់ បាន ទេ តែ សូម អោយ ដើរ តាម គន្លង ប្រពៃណី ។
ចង់ ដឹង វា ឆ្លាត យ៉ាងណា សូមើល វីដេអូ ទាំងអស់ គ្នា ៕
ខ្ញុំ មិន ដែល ទទួល ពាក្យ ជោគជ័យ ទេ ទោះបីជា ខ្ញុំ ក្លាយជា អគ្គ នាយក ក្រុមហ៊ុន ក៏ដោយ
ខ្ញុំ ព្រះករុណា ខ្ញុំ ពិតជា មាន មោទនភាព ដែល បាន ក្លាយទៅជា សមាជិក នៃ អង្គការ នេះ ហើយ ខ្លួនខ្ញុំ ព្រះករុណា ខ្ញុំ ផ្ទាល់ ក៏ បាន ក្លាយទៅជា សមាជិក ដំបូង នៃ អង្គការ នេះ ក្នុង ឋានៈ ជា ជនជាតិ កម្ពុជា នៅ ឆ្នាំ ២០០២ កន្លងទៅ ។
មាន ន័យ ថា ភាសា ដែល អ្នក និយាយ ទៅ គឺជា ភាសា បែប អ្នក មាន គំនិត ប្រាជ្ញា ជា បុគ្គល ដែល មាន ការយល់ដឹង ខ្ពស់ ជា បុគ្គល ដែល មាន ក្រមសីលធម៌ ល្អ ។
ដើម្បី ផ្តោត លើ ការបំពេញ តួនាទី របស់ ពួកគេ ក្នុង នាម ជា តំណាងរាស្ត្រ ជាប់ ឆ្នោត ។
វា ជា រឿង ដាច់ដោយឡែក សម្រាប់ គ្រូបង្រៀន ម្នាក់ ប៉ុណ្ណោះ សូម លោកគ្រូ អ្នកគ្រូ មេត្តា យល់ និង អធ្យាស្រ័យ ។
អាស៊ី សេរី ពុំ អាច សុំ ប្រតិកម្ម ចំពោះ ជុំវិញ រឿង នេះ បាន ភ្លាម ៗ
រហូត មាន ក្រុមហ៊ុន ឯកជន ខ្លះ សម្រេច ឱ្យ បុគ្គលិក ធ្វើការចេញ ពី ផ្ទះ រៀង ៗ
ការស្លាប់ ផ្នែក ស្មារតី គឺ ការបែក ចេញ ពី ព្រះជាម្ចាស់ ។
គ្រាន់តែ ដោយសារ អ្នក មិន សូវ សម្បូរ ប្រាក់ មិន មែន មាន ន័យ ថា អ្នក មិន អាច បង្កើត ភាពរ៉ូមែនទិច ជាមួយនឹង គូស្នេហ៍ របស់ អ្នក បាន នោះ ទេ ។
ខ្លួន មុន ពួកគេ បង្ហាញ ខាងលើ ។
ក៏ប៉ុន្តែ លោក មិន បាន បញ្ចេញ ផែនការវាយប្រហារ ជាក់លាក់ ទេ ។
សូច ចុច ទីនេះ ដើម្បី អាន អត្ថបទ ផ្សេង ទៀត
ជាតិ គឺ រដ្ឋាភិបាល ហើយ រដ្ឋាភិបាល គឺ ហ៊ុន សែន !
ឃើញ ថា វា ពិតជា មាន ទិដ្ឋភាព ចម្លែក មែន ។
ទាំង ផ្តាំ ថា ចូរ យក ប្រាក់ នេះ ទៅ រកស៊ី រហូតដល់ ខ្ញុំ ត្រឡប់ មកវិញ ។
ដូច្នេះ លោក សង្ឃឹម ថា នឹង មាន អ្នក ចូល ទស្សនា យ៉ាង ច្រើន កុះករ ក្នុង វគ្គ ដណ្តើម ជើងឯក នេះ ។
ប៉ុន្តែ ខ្ញុំ គិត ថា យើង អាច បង្កើត គំរូ មួយ ដែល ប្រទេស នីមួយ ៗ
ដូច្នេះ ប្រសិនបើ យើង កំពុង ធ្វើដំណើរ ទៅកាន់ ការគោរព រដ្ឋាភិបាល ដែល ត្រូវ
ជាមួយគ្នា នេះ ដែរ ក្រុម អ្នកស្រាវជ្រាវ ក៏ បាន ធ្វើ ការពិស …
គួរ ណាស់ វ័យ ប៉ុណ្ណឹង វា គួរ ប្រមូលផ្តុំ លើ ការរៀនសូត្រ លេង កំសាន្ត ប៉ុន្តែ …
ប្រជាជន ភាគ ច្រើន នៅក្នុង ខេត្ត នេះ ជា កសិករ ធ្វើ ស្រែ និង ចំការ ។
លោក ហ៊ុន ម៉ាណែត ស្នើ ឱ្យ ផ្តល់ ដំណឹង ទាក់ទង នឹង ភាព មិន ប្រក្រតី នៃ ការប្រឡង ធ្វើ កងទ័ព
ប្រពន្ធ ជា បងប្អូន មាន លក្ខណៈ ពីរ ប្រការ ៖
បែប នេះ ល្អ ជាង ម៉ានិត ទាញយក
ក្រុម មន្ត្រី និយាយ ថា អ្នក ជួយសង្គ្រោះ បាន ជួយសង្គ្រោះ មនុស្ស ៧៣ នាក់ ចេញ ពី នាវា កាលពី ថ្ងៃអង្គារ ។
អំណាច ចេស្តា របស់ ព្រះមាន ភាពអស្ចារ្យ មិន អាច វាស់ស្ទង់ បាន តែ មាន ភាពច្បាស់លាស់ ល្មម នឹង ឱ្យ យើង យល់ បាន ។
ប៉ុន្តែ អង្គុយ រង់ចាំ ពេញ មួយ ថ្ងៃ ក៏ មិន មាន អតិថិជន ណា ម្នាក់ មក សួរ នាំ ។
នៅ ឆ្នាំ ២០២១ ក៏ មិន មាន ជ្រើសរើស មន្ត្រីរាជការ ថ្មី ដូច ឆ្នាំ ២០២០ ដែរ ។
ពួកគេ ចាំបាច់ ត្រូវ មាន តម្លៃ ខ្លះ ក្នុង ចិត្ត ពួកគេ ក្នុង ការបំពេញ បេសកកម្ម នេះ ។
នៅ ចុង ខែឧសភា នេះ ដើម្បី ស្វែងរក ដំណោះស្រាយ ឱ្យ ប្រសើរ បំផុត ។
ថ្ងៃស្អែក ជា ទិវា សម្អាត អនាម័យ ពិភពលោក
ផលិតផល បរទេស ដូចជា ស្រាបៀរ សាប៊ូ កក់ សក់ ថ្នាំ
ដំណោះស្រាយ នយោបាយ មួយ នៅតែ ជា ច្រក ចេញ ។
ហ្វេសប៊ុក លីង អីន យូធូប
រដ្ឋអាជ្ញា គមនាគមន៍ បាន និយាយ ថា ពួកគេ កំពុង ស៊ើបអង្កេត ឧបទ្ទវហេតុ ដែល បាន កើតឡើង កាលពី ថ្ងៃអង្គារ ។
លោក ហ៊ុន សែន អួត ខុស ទំនង
៥ខ្ញុំ ពុំ ដែល បោកប្រាស់ គេ
យើង នឹង នាំ ដំណើរកម្សាន្ត អ្នក ទាំងអស់ គ្នា ឱ្យ មាន អារម្មណ៍ ប្លែក ។
តាមរយៈ សកម្មភាព ទាំងនេះ ក្រុមហ៊ុន រំពឹង ថា នឹង មាន ការបញ្ជាទិញ ប្រមាណ ៥ ពាន់ គ្រឿង ពី តំបន់ ទាំង ពីរ នេះ ។
ចង់ ចេះ គឺ ប្រឹង រៀន
ការប្រកាស វិលត្រឡប់ ចូល ប្រទេស របស់ ទណ្ឌិត សម រង្ស៊ី គឺ គ្រាន់តែ ជា ការកំដរ នយោបាយ ទ័ល ច្រក តែ ប៉ុណ្ណោះ ។
ចាប់ពី ថ្ងៃស្អែក ទៅ ក្រុម ចល័ត នឹង ចុះ ផ្តល់ លិខិត …
អាគ្នេយ៍ ពាយ័ព្យ ក្រហម ម្សាញ់ ។
ពីរ ចំណុច ខាងក្រោម នេះ ខ្ញុំ នៅ មិន ទាន់ យល់ នៅឡើយ ទេ ។
មួយចំនួន នៅ ពីក្រោយ នៃ ការចេញមក ធ្វើ បាតុកម្ម របស់ អ្នកតវ៉ា រឿង ដីធ្លី ទាំងនោះ ។
ព្រះអង្គ នឹង យាង ត្រឡប់ មកវិញ តាម របៀប ដូច ដែល អ្នក រាល់គ្នា បាន ឃើញ ទ្រង់ យាង ឡើង ទៅ ស្ថាន បរម សុខ ដែរ ។
ហើយក៏ សូម បញ្ជាក់ ដែរ ថា វា មិន បញ្ចេញ ពណ៌ ភ្លាម ៗ
