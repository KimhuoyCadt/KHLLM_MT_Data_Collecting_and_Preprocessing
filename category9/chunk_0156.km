ប៉ុន្តែ ក្រៅពី រ បប អាហារ និង ឥរិយាបថ ប្រចាំ ថ្ងៃ បញ្ហា ផ្លូវ អារម្មណ៍ ក៏ ជា រឿង សំខាន់ ណាស់ ដែរ ដែល អនាគត ម្តាយ គួរតែ យកចិត្តទុកដាក់ ។
ព្រោះតែ ហេតុ នេះ ហើយ ទើប សម្តេច បង្កើត មូលនិធិ ត្រី ចក្រ យាន ហើយ គ្រប់គ្រង ដោយ ខ្លួន ឯង ។
សេចក្តី អំពាវនាវ របស់ ខ្ញុំ ជូន ចំពោះ កម្មករ កម្ម ការិនី ពលករ ទាំងអស់ ដែល ធ្វើ កា …
បើសិនជា អ្នកឧស្សាហ៍ រាក ដោយសារតែ មក រដូវ មាន រឿង មួយចំនួន ដែល អ្នក អាច ធ្វើ បាន ដើម្បី បន្ថយ ការរាក រូស នេះ បាន ។
នេះ បើ យោង តាម គេហទំព័រ របស់ លោក ប្រធានាធិបតី ។
សុទ្ធតែ ទទួលបាន ប្រាក់ ចំណេញ កាលពី ឆ្នាំ មុន
អាហារ ប៊ូហ្វេ ដ៏ ពិសេស នៅ រៀងរាល់ ថ្ងៃអាទិត្យ ដែល លោក អ្នក មិន គួរ មើល រំលង
ជាច្រើន ដែល នាំ ទៅដល់ ការចែក ផ្លូវ គ្នា ។
៥ការសាងសង់ វ៉ាល់ ៖
រីឯ ជនជាតិ ដើម ភាគ តិច មួយចំនួន តួច មិន ខ្វល់ ពី ការអភិរក៌្ស វប្បធម របស់ ខ្លួន នោះ ទេ ។
តាម គម្រោង ថ្មី របស់ យើង យើង នឹង ផ្តោត តែ លើ គ្រួសារ ទោល ដោយ អនុញ្ញាតឱ្យ ធានា បាន តែ ប្តី ប្រពន្ធ និង កូន ជា អនីតិជន តែ ប៉ុណ្ណោះ ។
ឯកឧត្តម ទេ ពងន អនុប្រធាន ទី១
ដោយ ក្តីអាណិតអាសូរ អូន ហុង ពេក ពេលនេះ ចំប៉ី ខ្មៅ សម្រេច ធ្វើ រឿង មួយ នេះ ជូន ហើយ នោះ គឺ … មាន វីដេអូ
ដើម្បីឱ្យ ស្ថាប័ន ទាំងនោះ បំពេញ ការងារ ឱ្យ ទាន់ ពេលវេលា កំណត់ ។
ប្រភេទ ទី២គឺ ពពួក ថ្នាំ ប្រឆាំង នឹង ការរលាក ដែល មិន មែន ជា ស្តេរ៉ូអ៊ីត ។
កិច្ចប្រជុំ ណែនាំ ពី ការប្រមូល តម្រូវការ អាទិភាព សម្រាប់ កសាង កម្មវិធី វិនិយោគ បី ឆ្នាំ រំកិល ខេត្ត
លោក ឧត្តមសេនីយ៍ ឯក កុំ ឱ្យ អនុ សេនីយ៍ ទោឡុង ស្រី អូន ទៅ អី ព្រោះ អាចនឹង មាន គ្រោះថ្នាក់ ។
ក្រៅពី ទិញ ឡាន ថ្លៃ ៗ
ហិហិអរគុណ ច្រើន សម្លាញ់ ដែល បាន ចូល លេង !
ចំណែកឯ បណ្ឌិត កែម ឡី វិញ ក៏ មិន ដែល មាន វត្តមាន ក្នុង ភូមិ ចំការគ ដូចគ្នា ។
វា ជា ពេលវេលា ដែល មនុស្ស ជាច្រើន តាមដាន ទស្សនា ។
បង្រៀន មនុស្ស ម្នាក់ ពិបាក ច្រើន នាក់ រឹតតែ ពិបាក !
ឥឡូវនេះ ពួកគេ ត្រូវ អាម៉ាស់ មុខ ហើយ ។
ក្លោងទ្វារ ចេញ ទៅ ខាងក្រោយ វត្ត
ការគេង គឺជា មុខងារ សំខាន់ បំផុត របស់ រាងកាយ ហើយ យើង មិន អាច ព្រងើយ កន្តើយ បាន ទេ ។
ខ. ផ្នែក កវីនិពន្ធ ដែល មាន បេក្ខជន ៨៧ នាក់ បាន ដាក់ កំណាព្យ ប្រលង
មួយ ទៀត មាន បុរស ម្នាក់ បាន កាប់ ព្រៃ យ៉ាង ច្រើន ដើម្បី ចង់បាន លុយ ។
ការសម្តែង នេះ ត្រូវបាន លុបចោល កាលពី ថ្ងៃសៅរ៍ ក្រោយ លេចឮ ដំណឹង ថា នាង បាន ស្លាប់ ។
ផ្ទះ ព័ត៌មាន ជាតិ បុរស អ្នក ដាំ ដំ…
រឿង លិខិត ឆ្លង ដែន មន្ត្រី មាន ការសម្រេច ថ្មី ទៀត ហើយ
ហើយ ឪពុក និង ម្តាយ ត្រូវ រួមដៃ គ្នា ធ្វើ រឿង នេះ ។
ឆ្នាំ របស់ ពួកគេ ឡើយ ។
លោក បាន ថ្លែង នៅក្នុង ហ្វេសប៊ុក នោះ ដោយ ចង់ សំដៅ ទៅ រដ្ឋាភិបាល ថា ៖
នៅ ពោះ ខ្នង … ពេលនេះ ត្រូវ ប្រញាប់ ទៅ ពិនិត្យ ផ្នែក តម្រងនោម ដើម្បី ព្យាបាល ទាន់ ពេល ។
ខ្មែរ នឹង មិន យក ខ្មែរ ជា សត្រូវ ដូច ដែល ខ្មែរ ក្រហម បាន ប្រព្រឹត្ត នោះ ទេ ។
ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ នេះ បាន នាំមក នូវ ករណី ថ្មី ចំនួន ៣៦០. ៩៦០ ដែល ជា ចំនួន ធំ បំផុត នៅលើ ពិភពលោក ដោយ មាន ការឆ្លង សរុប នៅ ឥណ្ឌា រហូតដល់ ជិត ១៨លាន នាក់ ៕
អ្នក បង្កើត ហាង នេះ ដឹង ពី អ្វី ដែល យើង ត្រូវការ និង ចង់បាន ។
ត្រូវ បញ្ចេញ អស់ ពី សមត្ថភាព ដើម្បី ទាក់ចិត្ត គណៈកម្មការ ។
ក្រៅពី នេះ នៅ មាន ពិធី ស្រង់ ទឹក ព្រះបដិមា ដូចជា ប្រទេស ដទៃ ទៀត ដែល មាន ចូល ឆ្នាំ ដូចគ្នា ។
នៅពេល នាយក រដ្ឋមន្ត្រី ដាក់ បញ្ជា ទៅ ។
ក្រៅពី នេះ ហើយ ខាងក្រោម គឺជា អ្វី ដែល ពួកគេ មិន ធ្វើជា ដាច់ខាត ៖
ការសម្តែង តួ របស់ ខ្ញុំ នេះ តម្រូវ ឱ្យ ខ្ញុំ និយាយ តែ ទោះ យ៉ាងណា អរគុណ អ្នក ទាំងអស់ គ្នា សម្រាប់ ការលើក សរសើរ នេះ ។
ជា ចុងក្រោយ ឯកឧត្តម បាន សំនូមពរ ដល់ ភាគី កាស៊ីណូ មាន ដូចជា ៖
កិច្ចប្រជុំ នេះ ក៏ បាន ទាក់ទាញ ការយកចិត្តទុកដាក់ ពី មជ្ឈដ្ឋាន ផ្សព្វផ្សាយ អន្តរជាតិ ច្រើន បំផុត តាំងពី មុន មក ។
ខាងក្រោម នេះ ជា រឿង ចាំបាច់ ដែល ម៉ាក់ ប៉ា គ្រប់ រូប ត្រូវ ធ្វើ បើ ចង់ឱ្យ ខួរក្បាល កូន ឆ្លាត វាង វៃ ដោយ គិត ចាប់ពី ពេល កូន កើត មក ភ្លាម ។
ឱ្យ បេះដូង ពិត មិន ព្រម យក សាន សុជា
ថ្ងៃ នេះ ក្មួយ ស្រី បាន ធូរស្រាល ខ្លះ ហើយ ។
ឬ សនៃ បញ្ហា ទាំងនេះ គឺ
អីចឹង ទៅជា ប្រជាពលរដ្ឋ មិន ទាន់ យល់ ពី លទ្ធិ ប្រជាធិបតេយ្យ យ៉ាងម៉េច ផង ។
សម្បូណ៌ ព្រៃ គុក កំពង់ចាម កំពង់ចិត្ត
អ្នក ត្រូវ កំនត់ ថា ក្នុង ជីវិត មនុស្ស គឺ មិន មាន ភាពស្មើគ្នា ទេ ។
នេះ គឺជា ទស្សនៈ របស់ បុរស ជាច្រើន នាក់ នៅក្នុង ប្រទេស ឥណ្ឌា ។
រូប ចំលាក់ ទាំងនេះ ត្រូវបាន គាស់ ចេញ តាំងពី ប៉ុន្មាន ទស្ស វត្ត មុន ហើយ បច្ចុប្បន្ន …
ដូចនេះ មាន ន័យ ថា ទីក្រុង សេអ៊ូល និង តំបន់ ធំ ៗ
នេះ គឺជា ស្មាតហ្វូន ដែល បង្កើតឡើង ដោយ ឳពុករប …
ចៅហ្វាយ ក្រុង ហាមប្រាម មិន អោយ ប្…
ជឿជាក់ ទៅ លើ ការវាយ របស់ ខ្ញុំ ព្រោះ ខ្ញុំ
និស្សិត ស្ទើរតែ គ្រប់ គ្នា តែង រអ៊ូរទាំ រឿង ការចំណាយ មិន គ្រប់គ្រាន់ ឬ អស់ មុនពេល កំណត់ ។
និង កូន ម្នាក់ មួយ ៗ
តែ យើងខ្ញុំ បាន ទទួលយក ករណី លំបាក នេះ ។
ក្រុមគ្រួសារ របស់ អ្នកទោស ម្នាក់ រង់ចាំ ការដោះលែង អ្នកទោស នោះ នៅមុខ ខ្លោងទ្វារ ពន្ធនាគារ Insein ក្នុង ទីក្រុង រ៉ង់ ហ្គូន ។
យញ្ញ បូជា របស់ ព្រះបាទ សាឡូម៉ូន
ក្នុង ពេល នេះ ខ្ញុំ នឹង ធ្វើដំណើរ ទៅ ឆ្ងាយ ហើយ រស់ នៅក្នុង ជីវិត សាមញ្ញ ។
ដើម្បីឱ្យ កម្លាំង របស់ លោក ចុះ ទៅ បង្ក្រាប ឱ្យ បាន ទាន់ ពេលវេលា ផងដែរ ៕
