( ភ្នំពេញ ) ៖ លោក ឡី សុភាព ប្រធាន គណៈកម្មាធិការ គណបក្ស មូលដ្ឋាន យុវជន សេដ្ឋកិច្ច រាជធានី ភ្នំពេញ បាន លើកឡើង ថា សង្គ្រាម រុស្ស៊ី - អ៊ុយក្រែន កាន់តែ ធ្វើឲ្យ សមាជិក សមាជិកា ទទួលស្គាល់ នូវ តម្លៃ ពិតប្រាកដ និង មហិមា នៃ សន្តិភាព ព្រោះ ក្នុង សង្គ្រាម គេ មិន អាច និយាយ ពី សិទ្ធិ សេរីភាព ប្រជាធិបតេយ្យ និង ការអភិវឌ្ឍ អ្វី ឡើយ ។
ការលើកឡើង របស់ លោក ឡី សុភាព ក្នុង ពិធី សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា នៃ គណៈកម្មាធិការ គណបក្ស មូលដ្ឋាន យុវជន សេដ្ឋកិច្ច និង រចនាសម្ព័ន្ធ ចាត់តាំង ចំណុះ ក្រោម អធិបតីភាព លោក សួន រិន ឌី អ្នកតំណាងរាស្ត្រ មណ្ឌល រាជធានី ភ្នំពេញ សមាជិក គណៈ អចិន្ត្រៃយ៍ គណបក្ស រាជធានី និង ជា ប្រធាន គណៈ ចាត់តាំង គណបក្ស រាជធានី ភ្នំពេញ ដែល មាន សមាជិក សមាជិកា ប្រមាណ ជាង ១ ពាន់ នាក់ ចូលរួម នៅ សាល អគារ The Grand Terrace ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ នា ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២២ ។
លោក បាន បញ្ជាក់ ទៀត ថា « តាមរយៈ បណ្តាញ សារព័ត៌មាន យើង ឃើញ ហើយ ថា សង្គ្រាម រុស្ស៊ី - អ៊ុយក្រែន កាន់តែ ធ្វើឲ្យ សមាជិក សមាជិកា យើង ទទួលស្គាល់ នូវ តម្លៃ ពិតប្រាកដ និង មហិមា នៃ សន្តិភាព ព្រោះ ក្នុង សង្គ្រាម គេ មិន អាច និយាយ ពី សិទ្ធិ សេរីភាព ប្រជាធិបតេយ្យ និង ការអភិវឌ្ឍ អ្វី ឡើយ ។ នៅពេល បាន ជួប ការលំបាក គ្មាន គណបក្ស ណា មក ជួយ ក្រៅពី គណបក្ស ប្រជាជន កម្ពុជា នោះ ទេ » ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក បណ្ឌិត ឡី សុភាព ក៏ បាន ប្រកាស បន្ត គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ជា បេក្ខភាព រដ្ឋមន្ត្រី និង ការជ្រើសតាំង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី សម្រាប់ ពេល អណាគត ។
គួរឲ្យដឹង ថា គណៈកម្មាធិការ គណបក្ស មូលដ្ឋាន យុវជន សេដ្ឋកិច្ច រាជធានី មាន ប្រភព ដើម ជា សាខា គណបក្ស យុវជន សេដ្ឋកិច្ច រាជធានី អាស្រ័យ ដោយ មាន ការវិវឌ្ឍ ខ្លួន និង ពង្រឹង ពង្រីក វិសាលភាព ជា បន្តបន្ទាប់ ទើប គណកម្មាធិការ គណបក្ស រាជធានី ភ្នំពេញ សម្រេច បង្កើត ជា អង្គការ ចាត់តាំង គណបក្ស នេះ ឡើង ។ បច្ចុប្បន្ន នេះ គណៈកម្មាធិការ គណបក្ស មូលដ្ឋាន យុវជន សេដ្ឋកិច្ច រាជធានី មាន សាខា ចំនួន ៦ អនុសាខា ចំនួន ៣០ ក្រុម បក្ស ចំនួន ៥០ និង មាន សមាជិក សរុប ២៤៥៣ រូប ( ស្រី ៧៥៩ រូប ) ៕
ចម្ងល់ និង សំណើ ជាច្រើន ត្រូវបាន បកស្រាយ ភ្លាម ៗ ជូន ប្រជាពលរដ្ឋ នៅ ឃុំ កោះ រកា នៅ ស្រុក ពាម ជរ ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ ចម្ងល់ និង សំណើ ជាច្រើន របស់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង ឃុំ កោះ រកា ស្រុក ពាម ជរ ខេត្ត ព្រៃវែង ត្រូវបាន សមត្ថកិច្ច នៅ ច្រកទ្វារ ព្រំដែន កោះ រកា និង ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ឃុំ កោះ រកា ស្រុក ពាម ជរ ខេត្ត ព្រៃវែង ធ្វើ ការបកស្រាយ ភ្លាម ៗ ។
ចម្ងល់ របស់ ប្រជាពលរដ្ឋ ដែល ត្រូវបាន សមត្ថកិច្ច និង ប្រធាន ក្រុមការងារ ធ្វើ ការបកស្រាយ នោះ រួម មាន៖
ប្រជាពលរដ្ឋ មាន ចម្ងល់ ថា ការឆ្លង ដែន ចូលទៅ ប្រទេស វៀត មាន ការលំបាក ហើយ មិន មាន តម្លាភាព ចំណែក ជនជាតិ វៀតណាម ចូលមក ប្រទេស កម្ពុជា វិញ ងាយស្រួល ម្លេះ ។ ហាមឃាត់ មិន ឱ្យ នាំយក លាមក គោ ( អាច ម៌ គោ ) ចូលទៅ លក់ នៅ ប្រទេស វៀតណាម និង ចម្ងល់ ករណី ចាប់ ចម្រៀក ឈើ ដើម ប្រេង ខ្យល់ ដើម ច័ន្ទ គិរី របស់ ប្រជាពលរដ្ឋ ។ ក្រៅពី ចម្ងល់ ទាំងនេះ ក៏ នៅ មាន សំណើ ជាច្រើន ដូចជា ស្នើសុំ ជួយ ទប់ស្កាត់ ករណី ចោរកម្ម ករណី គ្រឿង ញឿន ជួយ ដោះស្រាយ ទំនាស់ ដីធ្លី និង ធ្វើ ផ្លូវ ជាដើម ។
ចម្ងល់ និង សំណើ នេះ ប្រជាពលរដ្ឋ បាន ធ្វើឡើង នៅក្នុង វេទិកា សាធារណៈ ពិគ្រោះយោបល់ ដោះស្រាយ បញ្ហា និង តម្រូវការ របស់ ប្រជាពលរដ្ឋ ក្នុង ឃុំ កោះ រកា ស្រុក ពាម ជរ ខេត្ត ព្រៃវែង នា ល្ងាច ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២២ ក្រោម អធិបតីភាព លោក ពឹម សំណាង អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ កោះ រកា និង ឃុំ ព្រែក សំបួរ ស្រុក ពាម ជរ ខេត្ត ព្រៃវែង ។
ក្នុង អង្គ វេទិការ លោក ឧត្តមសេនីយ៍ ត្រី កែវ ជា បាន ឆ្លើយតប ភ្លាម ៗ ថា យោង តាម សេចក្តីជូនដំណឹង របស់ ក្រសួង សុខាភិបាល លេខ ០៩៨ មិន តម្រូវឲ្យ មាន ការធ្វើតេស្ត រហ័ស នៅ មាត់ ច្រកទ្វារ ទៀត ទេ រាល់ ភ្ញៀវ ទេសចរ អាជីវករ ប្រជាពលរដ្ឋ ចេញ ចូល ត្រូវ មាន លិខិត ឆ្លង ដែន និង លិខិត ដែល មាន តម្លៃ ស្មើ លិខិត ឆ្លង ដែន មាន ប័ណ្ណ ចាក់ វ៉ាក់សាំង គ្រប់ ដូស គឺ យើង អនុញ្ញាតឲ្យ ចូល ប្រទេស យើង ហើយ ។
ក្រៅពី ចម្ងល់ របស់ ប្រជាពលរដ្ឋ ត្រូវបាន បកស្រាយ ក៏ នៅ សំណើ ជាច្រើន ត្រូវបាន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ដោះស្រាយ ជូន ប្រជាពលរដ្ឋ ភ្លាម ៗ ផងដែរ ។ ប្រជាពលរដ្ឋ ក៏ បាន ទទួលយក ការដោះស្រាយ និង សប្បាយ ចិត្ត ជាខ្លាំង ចំពោះ បញ្ហា និង ចម្ងល់ ជាច្រើន ត្រូវបាន ដោះស្រាយ បញ្ចប់ និង បាន ពន្យល់ បកស្រាយ ពី ភាព ជាក់ស្តែង និង ពិតប្រាកដ ដែល ពួកគាត់ ទទួលយក បាន ។
ជាមួយនឹង ក្តី សប្បាយ ចិត្ត នេះ ប្រជាពលរដ្ឋ ក៏ បាន លើកឡើង ពី សកម្មភាព ការងារ របស់ លោក កែវ ជា ដែល បាន ខិតខំ ធ្វើ ការសម្របសម្រួល ជាមួយ គាគី វៀតណាម បាន ឱ្យ ពួកគាត់ បាន ឆ្លង ចូល ប្រទេស វៀតណាម ដើម្បី ប្រកប មុខរបរ រស់ នៅ សព្វ ថ្ងៃ នេះ ជាពិសេស ប្រជាពលរដ្ឋ បាន លើកឡើង ពី ការ មិន យក លុយ ពី ពួកគាត់ ក្នុង ការឆ្លង ចេញ ចូល ប្រទេស វៀតណាម ។
ជាមួយគ្នា នេះ លោក ពឹម សំណាង ក៏ បាន កោតសរសើរ ចំពោះ ការងារ សម្របសម្រួល ល្អ របស់ លោក កែវ ជា នៅ ច្រកទ្វារ ព្រំដែន ដែល មិន ធ្វើឱ្យ លោក ឈឺ ក្បាល នូវ ព័ត៌មាន មិន ល្អ ដែល ប្រជាពលរដ្ឋ លើកឡើង ចំពោះ សកម្មភាព របស់ មន្ត្រី ប៉ូលីស ច្រកទ្វារ កន្លងមក មុន លោក កែវ ជា មកកាន់ ជា ប្រធាន ប៉ុស្តិ៍ នគរបាល ច្រកទ្វារ ព្រំដែន អន្តរជាតិ កោះ រកា នេះ ៕
សម្តេច ហេង សំរិន ទទួល ជួប សវនាការ ជាមួយ លេខា បក្ស រដ្ឋធានី ហាណូយ
សម្តេច តេជោ ហ៊ុន សែន ណែនាំ ឱ្យ ពិនិត្យ លទ្ធភាព ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រាជធានី ភ្នំពេញ និង ក្រុង ហាណូយ ឱ្យ កាន់តែ ប្រសើរ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ណែនាំ ឱ្យ ពិនិត្យ លទ្ធភាព ពង្រឹង ក្នុង ការពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ នានា ឱ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត រវាង រាជធានី ភ្នំពេញ របស់ កម្ពុជា និង ទីក្រុង ហាណូយ របស់ វៀតណាម ។
ការជំរុញ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង ក្នុង ឱកាស សម្តេច អនុញ្ញាតឱ្យ លោក ឌិញ ទៀន ហ្ស៊ង សមាជិក ការិយាល័យ នយោបាយ បក្ស កុម្មុយនិស្ត វៀតណាម និង ជា លេខា បក្ស កុម្មុយនិស្ត វៀតណាម ប្រចាំ ក្រុង ហាណូយ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ នៅ វិមាន សន្តិភាព នា ព្រឹក ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២២ ។
នៅក្នុង ជំនួប នេះ លោក ឌិញ ទៀន ហ្ស៊ង បាន គោរព ថ្លែងអំណរគុណ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន ចំណាយ ពេលវេលា អនុញ្ញាតឱ្យ រូប លោក បាន ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ មួយចំនួន ។ លេខា បក្ស កុម្មុយនិស្ត វៀតណាម ប្រចាំ ក្រុង ហាណូយ រូប នេះ ក៏ បាន នាំយក នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ របស់ ថ្នាក់ដឹកនាំ វៀតណាម ជូន សម្តេច តេជោ តេជោ ហ៊ុន សែន ផងដែរ ។
លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រាប់ ក្រុម អ្ន ក ព័ត៌មាន ថា ក្នុង ជំនួប នេះ លោក ឌិញ ទៀន ហ្ស៊ន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការចាត់ វិធានការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ របស់ កម្ពុជា ។ លោក ក៏ បាន គោរព រាយការណ៍ ពី ស្ថានភាព ជំងឺ កូវីដ១៩ នៅ ទីក្រុង ហាណូយ ក៏ ដូចជា ស្ថានភាព សេដ្ឋកិច្ច និង ទិសដៅ អភិវឌ្ឍន៍ ក្នុង ក្រុង ហាណូយ ផងដែរ ។
បើ តាម លោក អ៊ាង សុផល្លែត នៅក្នុង ជំនួប សម្តែង ការគួរសម នេះ លោក ឌិញ ទៀន ហ្ស៊ន ក៏ បាន បង្ហាញ ការប្តេជ្ញាចិត្ត ពង្រឹង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង រដ្ឋធានី ហាណូយ និង រាជធានី ភ្នំពេញ ដោយ អនុវត្តន៍ រាល់ សេចក្តីថ្លែងការណ៍ និង កិច្ចព្រមព្រៀង ទាំងឡាយ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា និង រដ្ឋាភិបាល វៀតណាម បាន ដាក់ចេញ ។
ជា កិច្ច ឆ្លើយតប សម្តេច តេជោ ហ៊ុន សែន បាន សម្តែង នូវ ក្តីរីករាយ ចំពោះ ការរីកចម្រើន ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ទាំងឡាយ រវាង កម្ពុជា និង វៀតណាម ។ សម្តេច តេជោ ហ៊ុន សែន បាន គូស រំលេច ថា ទំហំ ពាណិជ្ជកម្ម រវាង កម្ពុជា និង វៀតណាម បាន កើនឡើង លើស ផែនការ ៥ពាន់ លាន ដុល្លារ តែ ទោះ យ៉ាងណា សម្តេច បាន ជំរុញ ឱ្យ យកចិត្តទុកដាក់ បន្ថែម ទៀត លើ កិច្ចសហប្រតិបត្តិការ ផ្នែក សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម ។
វិទ្យាស្ថាន ចក្ខុវិស័យ អាស៊ី រៀបចំ សិក្ខាសាលា ស្តី អំពី លទ្ធផល នៃ កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្ត្រី សម្រាប់ កិច្ចសហប្រតិបត្តិការ នៅក្នុង តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក
អ្នកចូលរួម សិក្ខាសាលា នេះ រួម មាន ក្រសួង រដ្ឋាភិបាល កម្ពុជា ស្ថានទូត បរទេស នៅ ទីក្រុង ភ្នំពេញ អង្គការ ក្រៅ រដ្ឋាភិបាល ក្នុង និង ក្រៅ ប្រទេស ស្ថាប័ន សិក្សា ស្រាវជ្រាវ គ្រឹះស្ថាន សិក្សា អ្នកសង្កេតការណ៍ នៅ កម្ពុជា ក្រុម បញ្ញា វ័ន្ត អ្នកជំនាញ និង សិស្សានុសិស្ស នៅក្នុង ប្រទេស និង តំបន់ ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង ទីប្រឹក្សា រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល៤រូប មាន ឋានៈ ស្មើ អនុ រដ្ឋលេខាធិការ
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង ជា ទីប្រឹក្សា រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល មាន ឋានៈ ស្មើ អនុ រដ្ឋលេខាធិការ ដោយ ពុំ ទទួល ប្រាក់ បំណាច់ មុខងារ ។ នេះ បើ យោង តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២២ ។
ការតែងតាំង នេះ គឺជា ការទទួលស្គាល់ ចំពោះ លទ្ធផល ដ៏ ល្អ ប្រសើរ របស់ ក្រុម មេធាវី ក្នុង ការចូលរួមចំណែក ជួយ ដល់ កិច្ចការ ច្បាប់ និង ផែនការ យុទ្ធសាស្រ្ត អភិវឌ្ឍ វិស័យ អាកាស ស៉ី វិល នៅ កម្ពុជា ៕ ខេត្ត ប៉ៃលិន ទទួលបាន ការផ្គត់ផ្គង់ អគ្គិសនី ពី ប្រភព ជាតិ តាមរយៈ ខ្សែ បញ្ជូន តង់ ស្យុង ខ្ពស់ ១១៥ គីឡូ វ៉ុល
( ប៉ៃលិន ) ៖ លោក កែវ រតនៈ រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី និង ជា អគ្គ នាយក អគ្គិសនី កម្ពុជា បាន ថ្លែង ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២២ នេះ ថា អគ្គិសនី កម្ពុជា បាន បញ្ចប់ ការធ្វើតេស្ដ និង ដាក់ ឲ្យ ដំណើរការអនុស្ថានីយ អគ្គិសនី ប៉ៃលិន កម្លាំង ៥០ មេហ្កាវ៉ាត់ នៅ ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន ។
ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន គូសបញ្ជាក់ ពី ការសម្រេចបាន នូវ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម នៅ កម្ពុជា ដោយ បន្ត ថា កំណើន ផលិតផល ក្នុង ស្រុក សរុប ប្រចាំ ឆ្នាំ ជា មធ្យម លើស ពី ៧% ក្នុង រយៈពេល ពីរ ទស្សវត្សរ៍ កន្លងមក បាន ធ្វើឱ្យ ប្រទេស កម្ពុជា ងើប ចេញ ពី ប្រទេស មាន ចំណូល ទាប ទៅជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ទាប នៅក្នុង ឆ្នាំ ២០១៥ ។ លោក បាន ថ្លែងអំណរគុណ ចំពោះ ការចូលរួមចំណែក របស់ ប្រទេស អូស្ត្រាលី ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម នៅ កម្ពុជា ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន ជម្រាប ជូន ឧត្ដមសេនីយ៍ ឯក សេន ដឺ សុន ផងដែរ អំពី មោទនភាព របស់ កម្ពុជា ក្នុង ការប្រែក្លាយ ពី ប្រទេស ដែល ទទួលយក កងកម្លាំង ថែរក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ ទៅជា ប្រទេស មួយ ដែល រហូតមកដល់ ពេលនេះ បាន បញ្ជូន កងកម្លាំង កម្ពុជា ជាង ៨ ពាន់ នាក់ ទៅ ចូលរួម ក្នុង បេសកកម្ម ថែរក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ នៅ ប្រទេស ចំនួន ៨ នៅ ទ្វីប អាហ្វ្រិក និង មជ្ឈឹម បូព៌ា ។
ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន និង ឧត្តមសេនីយ៍ ឯក សេន ដឺ សុន បាន សម្តែង ការពេញចិត្ត ចំពោះ មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ ប្រសើរ និង យូរអង្វែង ចាប់តាំងពី ការបង្កើត ទំនាក់ទំនង ការទូត រវាង ប្រទេស ទាំង ពីរ នៅក្នុង ឆ្នាំ ១៩៥១ មក ។
ឧត្តមសេនីយ៍ ឯក សេន ដឺ សុន បាន សម្តែង នូវ ការកោតសរសើរ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការអភិវឌ្ឍ ដ៏ ឆាប់រហ័ស នៅ កម្ពុជា និង បាន កោតសរសើរ រាជ រដ្ឋាភិបាល កម្ពុជា ចំពោះ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ប្រកបដោយ ជោគជ័យ ក៏ ដូចជា ការបញ្ជូន កងកម្លាំង កម្ពុជា រាប់ ពាន់ នាក់ ទៅ ចូលរួម ក្នុង ប្រតិបត្តិការ រក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ នៅ ប្រទេស ផ្សេង ៗ គ្នា ជុំវិញ ពិភពលោក ។
ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន ជម្រាប ជូន ដៃគូ សន្ទនា របស់ លោក អំពី លទ្ធផល នៃ ដំណើរទស្សនកិច្ច ជា លើក ដំបូង របស់ លោក ទៅកាន់ ប្រទេស មីយ៉ាន់ម៉ា កាលពី ខែមីនា ដោយ គូសបញ្ជាក់ អំពី បញ្ហា ប្រឈម នានា ជាពិសេស ភាព ស្មុគស្មាញ សម្រាប់ កិច្ចសន្ទនា ស្វែងរក សន្តិភាព ក្នុង ចំណោម ភាគី ពាក់ព័ន្ធ ទាំងអស់ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បាន សង្កត់ធ្ងន់ លើ អាទិភាព បន្ទាន់ ចំនួន បី គឺ រួម មាន៖ ( ១ ) ការបោះជំហាន ឆ្ពោះ ទៅរក ការបញ្ចប់ អំពើហិង្សា . ( ២) ការសម្របសម្រួល ការចែកចាយ ជំនួយ មនុស្សធម៌ . និង ( ៣) ការកសាង ទំនុកចិត្ត និង ការបង្កើត បរិយាកាស ដែល ចាំបាច់ សម្រាប់ កិច្ចសន្ទនា នយោបាយ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន លើកឡើង ផងដែរ អំពី ផែនការ របស់ លោក ក្នុង ការរៀបចំ កិច្ចប្រជុំ ពិគ្រោះយោបល់ ស្តីពី ជំនួយ មនុស្សធម៌ នៅ រាជធានី ភ្នំពេញ ដើម ខែឧសភា ឆ្នាំ ២០២២ ខាងមុខ នេះ ។
ឧត្តមសេនីយ៍ ឯក សេន ដឺ សុន បាន កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ក្នុង ឋានៈ ជា ប្រធាន អាស៊ាន និង របស់ លោក ឧប នាយក រដ្ឋមន្ត្រី ផ្ទាល់ ក្នុង ឋានៈ ជា ប្រេសិត ពិសេស របស់ ប្រធាន អាស៊ាន សម្រាប់ មីយ៉ាន់ម៉ា ក្នុង ការស្វែងរក ដំណោះស្រាយ សម្រាប់ វិបត្តិ បច្ចុប្បន្ន នៅ មីយ៉ាន់ម៉ា ជាពិសេស តាមរយៈ ការប្រើប្រាស់ បទពិសោធន៍ របស់ កម្ពុជា ។
ប្រទេស ដែល មាន ប្រជាជន ចំនួន ២២លាន នាក់ នេះ បាន ស្នើសុំ ប្រាក់ កម្ចី ពី មូលនិធិ IMF ខណៈ ដែល ប្រទេស នេះ កំពុង ជម្នះ ក្នុង ការចំណាយ លើ ការនាំចូល ទំនិញ សំខាន់ ៗ ក្នុង គ្រា ដែល ជួបប្រទះ វិបត្តិ បំណុល និង ការធ្លាក់ចុះ យ៉ាង ខ្លាំង នៃ ប្រាក់ បម្រុង រូបិយប័ណ្ណ បរទេស ដែល បាន ជំរុញ ឱ្យ មាន ការកើនឡើង អតិផរណា ។
លោក Ali Sabry រដ្ឋមន្ត្រី ហិរញ្ញវត្ថុ ស្រីលង្កា ស្ថិត នៅក្នុង ទីក្រុង វ៉ាស៊ីនតោន កាលពី សប្តាហ៍ មុន ដើម្បី ពិភាក្សា ជាមួយ IMF ធនាគារ ពិភពលោក ឥណ្ឌា និង ប្រទេស ដទៃ ទៀត អំពី ជំនួយ ហិរញ្ញវត្ថុ សម្រាប់ ប្រទេស របស់ លោក ដែល បាន ផ្អាក ការទូទាត់ សម្រាប់ បំណុល បរទេស ចំនួន ៥១ប៊ីលាន ដុល្លារ ។
លោកស្រី បាន បន្ថែម ថា៖ « គោល នយោបាយ រូបិយវត្ថុ ត្រូវតែ រឹតបន្តឹង ដើម្បី រក្សា អតិផរណា ឱ្យ ស្ថិត ក្នុង ការគ្រប់គ្រង បាន ។ យើង មើលឃើញ តម្រូវការ ឱ្យ មាន អត្រា ប្តូរ ប្រាក់ ដែល មាន ភាពបត់បែន » ។
( ប៉េកាំង ) ៖ លោក Wang Wenbin អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន បាន សង្កត់ធ្ងន់ នៅក្នុង សន្និសីទ សារព័ត៌មាន ជា ប្រចាំ កាលពី ថ្ងៃទី ២៥ ខែមេសា ថា ជានិច្ចកាល ប្រទេស ចិន តែងតែ ប្រើប្រាស់ ទី អវកាស ដោយ សន្តិភាព ក្នុង ស្មារតី បម្រើ ផលប្រយោជន៍ រួម របស់ មនុស្សជាតិ ទាំងមូល ។
ភាគី ចិន បាន បង្កើត ប្រព័ន្ធ ការពារ សម្រាប់ ផ្កាយ ព្រះគ្រោះ តូច ៗ ដែល នៅជិត ផែនដី ក្នុង គោលបំណង ឆ្លើយតប នឹង ហានិភ័យ រួម ដែល មនុស្សជាតិ ត្រូវ ប្រឈម គឺ ផ្កាយ ព្រះគ្រោះ តូច ៗ ដែល នៅជិត ផែនដី អាចនឹង បុក ផែនដី ។ ប្រទេស ចិន នឹង បន្ត ធ្វើ ការផ្លាស់ប្តូរ និង កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេស ផ្សេង ទៀត តាមរយៈ យន្តការ ពហុ ភាគី ពាក់ព័ន្ធ ដូចជា គណៈកម្មាធិការ អង្គការ សហ ប្រជាជាតិ ស្តីពី ការប្រើប្រាស់ លំហ អាកាស ដោយ សន្តិភាព ជាដើម ក្នុង ន័យ រួមចំណែក ដល់ ការការពារ ភព ផែនដី និង សន្តិសុខ របស់ មនុស្សជាតិ ៕
រដ្ឋមន្រ្តី សុខាភិបាល ចុះ ពិនិត្យមើល ដំណើរការ សាងសង់ អគារ « តេជោ អភិវឌ្ឍន៍ » នៅ មន្ទីរពេទ្យ កាល់ម៉ែត . ពេលនេះ សម្រេចបាន ជាង ៩២ ភាគរយ ហើយ
( ភ្នំពេញ ) ៖ លោក សាស្រ្តាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល នៅ ព្រឹក ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ គណៈប្រតិភូ ចុះ ពិនិត្យមើល ដំណើរការ សាងសង់ អគារ ថ្មី « តេជោ អភិវឌ្ឍន៍ » នៅក្នុង មន្ទីរពេទ្យ កាល ម៉ែត ដែល រហូតដល់ ពេលនេះ សម្រេចបាន ប្រមាណ ជាង ៩២ ភាគរយ ហើយ ។
នៅក្នុង ឱកាស ចុះ ពិនិត្យមើល ការសាងសង់ នេះ លោក រដ្ឋមន្រ្តី បាន ឱ្យដឹង ថា នេះ ជា ការអភិវឌ្ឍ មួយ ជំហាន នៅក្នុង វិស័យ សុខាភិបាល របស់ ប្រទេស កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ដោយ មន្ទីរពេទ្យ កាល់ម៉ែត នឹង ក្លាយទៅជា មន្ទីរពេទ្យ ទំនើប កាន់តែ មាន លក្ខណៈ គ្រប់គ្រាន់ ដើម្បី ថែទាំ និង ព្យ បាល ប្រជាពលរដ្ឋ ក៏ ដូចជា ថ្នាក់ ជាន់ ខ្ពស់ របស់ យើង ឲ្យបាន ល្អ ប្រសើរ មិន ឲ្យ ចាញ់ ប្រទេស គេ ។
អគារ ថ្មី នៃ មន្ទីរពេទ្យ កាល់ម៉ែត ដែល កំពុង សាងសង់ នេះ មាន គ្រែ អ្នកជំងឺ ចំនួន ៤៦៥ បើ គិត ជា ម៉ែត្រ ការ៉េ មាន ចំនួន ជាង ៤មឺុន ម៉ែត្រ ការ៉េ ដែល អាច ថែទាំ អ្នកជំងឺ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព និង សុវត្ថិភាព ។ រហូតមកដល់ ពេលនេះ ដំណើរការ សាងសង់ បាន ៩២. ០២% សម្រាប់ ការសាងសង់ អាច និង បញ្ចប់ ចុង ឆ្នាំ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ លោក ម៉ម ប៊ុន ហេង ។
លោក រដ្ឋមន្រ្ដី បាន បន្ថែម ទៀត ថា អគារ ថ្មី នេះ មាន កន្លែង សង្រ្គាះ បន្ទាន់ កន្លែង វិនិច្ឆ័យ គ្រប់គ្រាន់ អាច មាន កន្លែង ថែទាំ ព្យាបាល និង អ្នកឯកទេស ជំនាញ គ្រប់ ផ្នែក នឹង បំពេញ ភារកិច្ច បន្ថែម លើ អគារ ចាស់ ដែល បំពេញ នូវ តម្រូវការ របស់ ប្រជាពលរដ្ឋ យើង ធ្វើ យ៉ាងម៉េច ឆ្លើយតប តម្រូវការ របស់ ប្រជាពលរដ្ឋ យើង មាន បញ្ហា បន្តិច បន្ទួច ចេះតែ ទៅ ខាងក្រៅ ។ ដូច្នេះ ត្រូវតែ មាន កន្លែង ទទួល ថែទាំ ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ ។
លោក បាន កោត សើរ មន្រ្ដី បុគ្គលិក របស់ ក្រសួង សុខាភិបាល និង មន្ទីរពេទ្យ កាល់ម៉ែត ដែល បាន ខិតខំ អស់ ពី កម្លាំងចិត្ដ អនុវឌ្ឍ នូវ គោល នយោបាយ ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ឆ្លើយតប ទៅនឹង តម្រូវការ របស់ ប្រជាពលរដ្ឋ ៕
ក្រសួង ពាណិជ្ជកម្ម៖ ក្រោយ ចូល អង្គការ កម្មសិទ្ធិ បញ្ញា ពិភពលោក ជិត ៣០ ឆ្នាំ កម្ពុជា ចុះបញ្ជី ម៉ាក បាន ជាង ៨ម៉ឺន ម៉ាក
កម្ពុជា បាន ចូលរួម ជាមួយ អង្គការ WIPO ក្នុង ឆ្នាំ ១៩៩៥ បន្ទាប់ពី ការប្តេជ្ញាចិត្ត ក្នុង ការអនុម័ត ច្បាប់ សំខាន់ ៗ មួយចំនួន រួមទាំង ច្បាប់ កម្មសិទ្ធិ បញ្ញា ជាតិ និង បទប្បញ្ញត្តិ ពាក់ព័ន្ធ មួយ ចំនួន ។ ក្រោយ ចូលរួម បាន ២ ឆ្នាំ ពោលគឺ នៅ ឆ្នាំ ១៩៩៧ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន សម្រេច ចេញ អនុក្រឹត្យ បង្កើត នាយកដ្ឋាន កម្មសិទ្ធិ បញ្ញា ក្រោម ក្រសួង ពាណិជ្ជកម្ម ។
នៅ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ នាយកដ្ឋាន កម្មសិទ្ធិ បញ្ញា ក្រសួង ពាណិជ្ជកម្ម ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ និង អង្គការ WIPO ក៏ បាន រៀបចំ កម្មវិធី ទិវា កម្ម សិទ្ធិ បញ្ញា ពិភពលោក ក្រោម ប្រធានបទ កម្មសិទ្ធិ បញ្ញា និង យុវជន « ការបង្កើត ថ្មី សម្រាប់ អនាគត កាន់តែ ប្រសើរ » នៅ ផ្សារ ទំនើប អ៉ី អន ម៉ល សែន សុខ ស៉ី ធី ( ជាន់ ទី៣) ផងដែរ ។
ទិវា កម្ម សិទ្ធិ បញ្ញា ពិភពលោក ឆ្នាំ ២០២២ ត្រូវ រៀបចំឡើង ក្រោម អធិបតីភាព លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង កម្មសិទ្ធិ បញ្ញា ដោយ មាន ការចូលរួម ពី លោកស្រី បណ្ឌិត សភាពចារ្យ ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ លោក Daren Tan អគ្គ នាយក WIPO តំណាង ឯក អគ្គ រដ្ឋទូត អាមេរិក ប្រចាំ កម្ពុជា តំណាង ឯក អគ្គ រដ្ឋទូត សហភាព អឺរ៉ុប ប្រចាំ កម្ពុជា និង ភាគី ពាក់ព័ន្ធ ទៀតផង ។
( ស្វាយរៀង ) ៖ លោក បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន រដ្ឋមន្រ្ដី ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន ថ្លែង ថា ស្វាយរៀង ជា ខេត្ត ទី១ ក្នុង ចំណោម ២៥ រាជធានី ខេត្ត ត្រូវបាន ប្រកាស ទទួលស្គាល់ ជា ផ្លូវការ បញ្ចប់ ការបន្ទោបង់ ពាសវាលពាសកាល (ODF) លើក ដំបូង ពោល គឺ មាន បង្គន់ អនាម័យ ប្រើប្រាស់ គ្រប់ ខ្នង ផ្ទះ នៅ ឆ្នាំ ២០២២ នេះ ។
ការថ្លែង បែប នេះ ក្នុង ឱកាស ដែល លោក បណ្ឌិត សភាចារ្យ រដ្ឋមន្រ្ដី អ៊ុក រ៉ាប៊ុន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស ទទួលស្គាល់ ជា ផ្លូវការ ខេត្ត ស្វាយរៀង ជា ខេត្ត « បាន បញ្ចប់ ការបន្ទោបង់ ពាសវាលពាសកាល » នៅ វិមាន ឯករាជ្យ ខេត្ត ស្វាយរៀង នា ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២២ នេះ ។
បណ្ឌិត សភាចារ្យ រដ្ឋមន្រ្ដី បាន បន្ត ថា៖ រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ ផែនការ យុទ្ធសាស្រ្ដ ជាតិ ផែនការ សកម្មភាព ជាតិ និង ផែនការ សកម្មភាព ខេត្ត ដើម្បី សម្រេច ឲ្យបាន គោលដៅ អភិវឌ្ឍន៍ ជាតិ ប្រកបដោយ ចីរភាព គឺ « នៅ ឆ្នាំ ២០២៥ ប្រជាពលរដ្ឋ គ្រប់ រូប នៅ តាម សហគមន៍ ជនបទ មាន លទ្ធភាព ទទួល សេវា ផ្តត់ ផ្គង់ ទឹក ស្អាត និង ការរស់នៅ ក្នុង បរិស្ថាន ដែល មាន អនាម័យ ល្អ ប្រកបដោយ និរន្តរភាព » ។
ដើម្បី សម្រេចបាន នូវ គោលដៅ ខាងលើ ក្រសួង ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន និង កំពុង បន្ត អនុវត្ត នូវ ផែនការ យុទ្ធសាស្រ្ដ ជាតិ ស្តីពី ការផ្គត់ផ្គង់ ទឹក ការសម្អាត និង អនាម័យ ជនបទ ឆ្នាំ ២០១៤ - ២០២៥ និង ផែនការ សកម្មភាព ជាតិ ជំហាន ទី២ ស្ដីពី ការផ្គត់ផ្គង់ ទឹក ការសម្អាត និង អនាម័យ ជន បទ ឆ្នាំ ២០១៩ - ២០២៣ ស្រប តាម យុទ្ធសាស្រ្ដ ចតុកោណ របស់ រាជ រដ្ឋាភិបាល ។
លោក បណ្ឌិត សភាចារ្យ បាន បន្ត ទៀត ថា យោង តាម របាយការណ៍ អង្កេត សេដ្ឋកិច្ច សង្គមកិច្ច កម្ពុជា ឆ្នាំ ២០១៩ - ២០២០ បាន ឲ្យដឹង ថា ឆ្នាំ ២០២២ អត្រា ប្រជាជន មាន ប្រភព ទឹក កែលម្អ ប្រើប្រាស់ មាន ៨០% ចំណែកឯ អត្រា ប្រជាជន មាន បង្គន់ អនាម័យ កែលម្អ ប្រើប្រាស់ មាន ៨០% និង គ្រួសារ ប្រមាណ ៨៩ % ប្រើប្រាស់ ឧបករណ៍ ផ្សេង ៗ សម្រាប់ លាងសម្អាត ដៃ នៅក្នុង បរិវេណ ផ្ទះ ។
ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន កំណត់ យក ខេត្ត គោលដៅ ចំនួន ៥ គឺ ខេត្ត កំពង់ស្ពឺ ខេត្ត កំពង់ឆ្នាំង ខេត្ត កែប ខេត្ត ព្រៃវែង និង ខេត្ត កណ្ដាល ឲ្យ ក្លាយជា ខេត្ត ដែល បញ្ចប់ ការបន្ទោបង់ ពាសវាលពាសកាល នៅ ឆ្នាំ ២០២៣ ។
បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន ក៏ បាន ផ្ដល់ អនុសាសន៍ ឲ្យ អភិបាល រង រាជធានី ខេត្ត ក្រុមការងារ ពាក់ព័ន្ធ អង្គការ ដៃគូ អភិវឌ្ឍន៍ នានា វិស័យ ឯកជន អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ មន្ទីរ ជំនាញ បន្ត កៀរគរ គ្រប់ ធនធាន ចូលរួម គាំទ្រ វិស័យ ផ្គត់ ផ្គង់ ទឹក ស្អាត និង អនាម័យ ជនបទ ដើម្បី សម្រេច ឲ្យបាន តាម ផែនការ យុទ្ធសាស្រ្ដ ជាតិ ដែល បាន កំណត់ ថា នៅ ឆ្នាំ ២០២៥ សម្រេច ឲ្យបាន ៩០% និង នៅ ឆ្នាំ ២០៣០ សម្រេច ឲ្យបាន ១០០ % ។
បណ្ឌិត សភាចារ្យ រដ្ឋមន្រ្ដី បាន លើកឡើង ថា សម្ដេច តេជោ នាយក រដ្ឋមន្រ្ដី បាន លើកលែង កាតព្វកិច្ច ពាក់ ម៉ាស់ នៅ ទូទាំង ប្រទេស ដែល នៅ ទី សាធារណៈ ជា ទីលំហ ឬ ទីកន្លែង ដែល មាន ចរន្ត ខ្យល់ ចេញ ចូល ល្អ និង ការចូលរួម ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ដូស ទី៣ ដើម្បី ប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ក្នុង គោលដៅ បន្ត ធានា នូវ និរន្តរភាព នៃ ភាពរឹងមាំ នៃ ភាពស៊ាំ សហគមន៍ និង ការលើកលែង នូវ កាតព្វកិច្ច ពាក់ ម៉ាស់ ។
បន្ទាប់ពី របាយការណ៍ របស់ លោក តូច ប៉ូលីវ៉ា អភិបាល រង ខេត្ត និង ជា ប្រធាន ក្រុមការងារ ផ្គត់ផ្គង់ ទឹក និង អនាម័យ ជនបទ ខេត្ត ស្វាយរៀង ស្ដីពី វឌ្ឍនភាព វិស័យ ផ្គត់ផ្គង់ ទឹក និង អនាម័យ ជនបទ រួច មក លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន ថ្លែងអំណរគុណ និង សាទ រ ចំពោះ សមិទ្ធផល ដែល សម្រេចបាន ជាពិសេស វឌ្ឍនភាព វិស័យ ផ្គត់ផ្គង់ ទឹក ស្អាត និង អនាម័យ ជន បទ ក្រោម កិច្ចសហប្រតិបត្តិការ ជាមួយ ក្រុមការងារ របស់ ក្រសួង និង អង្គការ ដៃគូ និង វិស័យ ឯកជន ផ្សេង ៗ ទៀត ។
តុលាការ មីយ៉ាន់ម៉ា ផ្តន្ទាទោស លោកស្រី អោង សាន ស៊ូជី ឱ្យ ជាប់ ពន្ធនាគារ ៥ឆ្នាំ បន្ថែម សម្រាប់ សំណុំរឿង ពុករលួយ (Video inside) ( ណៃ ពិដោ) ៖ តុលាការ នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា ដែល បច្ចុប្បន្ន ស្ថិត ក្រោម ការគ្រប់គ្រង របស់ រដ្ឋាភិបាល យោធា នៅ ថ្ងៃពុធ នេះ បាន សម្រេច ផ្តន្ទាទោស អតីត មេដឹកនាំ រដ្ឋាភិបាល ស៉ី វិល គឺ លោកស្រី អោង សាន ស៊ូជី ឱ្យ ជាប់ ពន្ធនាគារ រយៈពេល ៥ ឆ្នាំ សម្រាប់ សំណុំរឿង ពុករលួយ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃពុធ ទី ២៧ ខែមេសា ឆ្នាំ ២០២២ ។
