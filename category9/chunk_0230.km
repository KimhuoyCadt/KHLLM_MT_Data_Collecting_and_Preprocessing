( ស្ទឹងត្រែង ) ៖ លោក វ៉ា គឹម ហុង ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក កិច្ចការ ព្រំដែន កាលពី ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ បាន ដឹកនាំ គណៈប្រតិភូ និង អាជ្ញាធរ មូលដ្ឋាន ចុះ ពិនិត្យមើល ព្រំដែន និង ផ្លូវ ក្រវ៉ាត់ ព្រំដែន ដែល នៅជាប់ ជាមួយនឹង ប្រទេស ឡាវ ។
ការចុះ ពិនិត្យ ព្រំដែន នេះ ក៏ មាន ការចូលរួម ដោយ លោកស្រី បណ្ឌិត កុយ ពិសី រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង ជា អនុប្រធាន លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ នៃ អាជ្ញាធរ ជាតិ ទទួលបន្ទុក កិច្ចការ ព្រំដែន . នាយ ឧត្តមសេនីយ៍ ខ្វាន់ សៀម អគ្គ មេបញ្ជាការ រង កងយោធពល ខេម ភូមិន្ទ និង មេបញ្ជាការបញ្ជាការដ្ឋាន វិស្វកម្ម អគ្គ បញ្ជាការ . ឧត្តមសេនីយ៍ ឯក ហួត ឈាង មេបញ្ជាការ រង កងទ័ព ជើងគោក និង ជា មេបញ្ជាការ យោធ ភូមិភាគ ទី១ និង លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ស្ទឹងត្រែង ផងដែរ ។
លោកស្រី បណ្ឌិត កុយ ពិសី អនុប្រធាន លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ នៃ អាជ្ញាធរ ជាតិ ទទួលបន្ទុក កិច្ចការ ព្រំដែន បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅក្នុង ឱកាស នោះ លោក វ៉ា គឹម ហុង បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សកម្មភាព កសាង ផ្លូវ និង ហេដ្ឋារចនាសម្ព័ន្ធ ព្រំដែន នេះ ទោះបីជា កម្ពុជា ស្ថិត ក្នុង បរិបទ នៃ ជំងឺ កូវីដ - ១៩ យ៉ាងណា ក៏ដោយ ក៏ ការស្ថាបនា រហូតមកដល់ ថ្ងៃ នេះ ទទួលបាន លទ្ធផល យ៉ាង ច្រើន គួរ ជាទីមោទន : ។
លោក បញ្ជាក់ ថា សមិទ្ធផល ផ្លូវ ខ្សែក្រវាត់ ព្រំដែន ទាំងអស់ នេះ ជា មរតក ប្រវត្តិសាស្រ្ត មាន តម្លៃ ជា យុទ្ធសាស្ត្រ មិន អាច កាត់ថ្លៃ បាន ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដើម្បី កសាង ព្រំដែន កម្ពុជា ទៅជា ព្រំដែន សន្តិភាព មិត្តភាព សហប្រតិបត្តិការ អភិវឌ្ឍន៍ និង សុខដុមនីយកម្ម ៕
គួរ បញ្ជាក់ ថា ចាប់តាំងពី រុស្ស៉ី បើក ការលុកលុយ ចូល អ៊ុយក្រែន កាលពី ថ្ងៃ២៤ ខែកុម្ភៈ បាន បង្ក ការព្រួយបារម្ភ ជាខ្លាំង ថា ចិន អាចនឹង ប្រើ កម្លាំង វាយ យក កោះ តៃវ៉ាន់ បើ ទោះជា ទីក្រុង ប៉េកាំង អះអាង ថា តៃវ៉ាន់ និង អ៊ុយក្រែន មិន ដូចគ្នា ឡើយ ព្រោះថា តៃវ៉ាន់ ជា ផ្នែក មួយ របស់ ចិន រួចទៅហើយ ។
ការអនុវត្ត គោល នយោបាយ គ្មាន ជំងឺ កូវីដ១៩ គឺជា ជម្រើស ប្រកបដោយ ប្រសិទ្ធភាព ក្នុង ការស្តារ កំណើន សេដ្ឋកិច្ច ចិន បាន យ៉ាង ល្អ
( ប៉េកាំង ) ៖ វីរុស កូវីដ១៩ បំប្លែង ថ្មី អូមី ក្រុង អាច ឆ្លង ឆាប់រហ័ស ជាង វីរុស កូវី ដ១៩ ប្រភេទ មុន ៗ ហើយ រោគសញ្ញា នៃ ការឆ្លង វីរុស កូវីដ១៩ បំប្លែង ថ្មី អូមី ក្រុង ក៏ មិន ងាយ បង្ហាញ ចេញ ផងដែរ ដែល ធ្វើឲ្យ ការស្វែងរក អ្នក ឆ្លង វីរុស ប្រភេទ ថ្មី នេះ ជួបប្រទះ ការលំបាក ជាង មុន ។ អ្នកជំនាញ ផ្នែក សុខាភិបាល បាន អះអាង ថា ការទប់ស្កាត់ ការរីករាលដាល វីរុស កូវីដ១៩ បំប្លែង ថ្មី អូមី ក្រុង គឺ លំបាក ជាង ការទប់ស្កាត់ ការរីករាលដាល វីរុស កូវី ដ១៩ ប្រភេទ ដែល តា រហូតដល់ទៅ ជាង ១០ដង ។
នៅ គ្រា ដំបូង បស្ចិម ប្រទេស នានា បាន រិះគន់ វាយប្រហារ យុទ្ធសាស្រ្ត គ្មាន ជំងឺ កូវីដ១៩ របស់ ប្រទេស ចិន ប៉ុន្តែ ក្រោយមក ពួកគេ ក៏ បាន អនុវត្ត យុទ្ធសាស្រ្ត ដូចគ្នា នេះ ផងដែរ ។ ប៉ុន្តែ ពួកគេ អនុវត្ត ដោយ មិន ពេញលេញ និង មិន ម៉ឺងម៉ាត់ ដែល បង្កឲ្យ មាន ផលវិបាក យ៉ាង ធ្ងន់ធ្ងរ នៅក្នុង ប្រទេស ពួកគេ ដោយ មនុស្ស ជាច្រើន បាន ឆ្លង វីរុស កូវីដ១៩ និង បាន ស្លាប់ ។
តែ ផ្ទុយទៅវិញ នៅ មុនពេល នៃ ការផ្ទុះ ឡើងវិញ នា ពេល ថ្មី ៗ នេះ ប្រទេស ចិន ទទួលបាន ជោគជ័យ គួរឲ្យ កត់សម្គាល់ ក្នុង ការទប់ស្កាត់ ជំងឺ រាតត្បាត នេះ ។ គោល នយោបាយ គ្មាន ជំងឺ កូវីដ១៩ នេះ ហើយ ដែល ធ្វើឲ្យ ចំនួន អ្នក ឆ្លង វីរុស កូវីដ១៩ ចំនួន អ្នកជំងឺ ធ្ងន់ធ្ងរ និង ចំនួន អ្នក បាត់បង់ជីវិត នៅក្នុង ប្រទេស ចិន ស្ដិត នៅក្នុង កម្រិត ទាប បើ ទោះបីជា ប្រទេស ចិន មាន ប្រជាជន ច្រើន ជាង គេ បំផុត នៅលើ ពិភពលោក ក៏ដោយ ។
គោល នយោបាយ គ្មាន ជំងឺ កូវីដ១៩ គឺជា យុទ្ធសាស្រ្ត មួយ ដែល ផ្អែក លើ មូលដ្ឋាន វិទ្យាសាស្រ្ត និង ត្រូវបាន បង្ហាញ ថា មាន ប្រសិទ្ធភាព ខ្ពស់ ក្នុង ការទប់ស្កាត់ ការឆ្លង រាលដាល ក្នុង រយៈពេល ត្រឹមតែ ពីរ បី សប្ដាហ៍ ។ តាមរយៈ ការអនុវត្ត គោល នយោបាយ គ្មាន ជំងឺ កូវីដ នេះ ទីក្រុង ហ្សិន ចិន ដែល ជា ទីក្រុង ដ៏ ធំ មួយ ដែល មាន ប្រជាជន ជាង ១៧លាន នាក់ អាច គ្រប់គ្រង ការរីករាលដាល វីរុស កូវីដ១៩ បំប្លែង ថ្មី អូមី ក្រុង ក្នុង រយៈពេល ត្រឹម មួយ ខែ ។
សម្តេច តេជោ ហ៊ុន សែន ទទួល ជួប លេខា បក្ស កុម្មុយនិស្ត វៀតណាម ប្រចាំ ក្រុង ហាណូយ
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ព្រឹក ថ្ងៃពុធ ទី ២៧ ខែមេសា ឆ្នាំ ២០២២ នេះ អនុញ្ញាតឱ្យ លោក ឌិញ ទៀន ហ្ស៊ង សមាជិក ការិយាល័យ នយោបាយ បក្ស កុម្មុយនិស្ត វៀតណាម និង ជា លេខា បក្ស កុម្មុយនិស្ត វៀតណាម ប្រចាំ ក្រុង ហាណូយ ចូល ជួប សម្តែង ការគួរសម និង សម្តែង ការងារ ។
សូម បញ្ជាក់ ថា លោក ឌិញ ទៀន ហ្ស៊ង កំពុង ទស្សនកិច្ច នៅ កម្ពុជា ដើម្បី ស្វែងរក ការពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ នានា ជាមួយ ប្រទេស កម្ពុជា ជាពិសេស ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង រាជធានី ភ្នំពេញ និង ទីក្រុង ហាណូយ ៕
ទីក្រុង កៀវ រុះ ចោល រូបសំណាក សម័យ សូវៀត ដែល ជា និមិត្តរូប នៃ មិត្តភាព រុស្ស៉ី - អ៊ុយក្រែន
( កៀវ ) ៖ អាជ្ញាធរ អ៊ុយក្រែន នៅ ថ្ងៃអង្គារ សប្តាហ៍ នេះ បាន រុះរើ រូបសំណាក ដ៏ ធំ មួយ សល់ ពី អតីត សម័យ សហភាព សូវៀត ដែល ជា និមិត្តរូប នៃ មិត្តភាព រវាង រុស្ស៊ី និង អ៊ុយក្រែន ស្ថិត នៅ ចំ កណ្តាល ទីក្រុង កៀវ ជា ការឆ្លើយតប ទៅនឹង ការឈ្លានពាន របស់ ទីក្រុង មូស្គូ ។ នេះ បើ យោង តាម ការចុះផ្សាយ របស់ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃពុធ ទី ២៧ ខែមេសា ឆ្នាំ ២០២២ ។
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ មាន ១៤. ៨១៦ ករណី ជា ករណី ឆ្លង ក្នុង សហគមន៍ និង ៧១ ករណី ទៀត ជា ករណី នាំចូល ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ១២៥ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ១៨. ៩១៩ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
លោក បាន បន្ថែម ថា៖ « ហានិភ័យ នៃ ភាពទ្រឹង នៃ សេដ្ឋកិច្ច ក៏ នឹង អាស្រ័យ យ៉ាង ខ្លាំង ទៅ លើ រយៈពេល នៃ កើតមាន សង្គ្រាម ផងដែរ »៕
ជាង នេះ ទៅ ទៀត លោកស្រី បាន កត់សម្គាល់ ថា អតិផរណា នៅ អាស៊ី ក៏ ចាប់ផ្តើម កើនឡើង ផងដែរ នៅ ពេល ដែល ការការថមថយ សេដ្ឋកិច្ច របស់ ប្រទេស ចិន កំពុង បន្ថែម សម្ពាធ លើ កំណើន សេដ្ឋកិច្ច ក្នុង តំបន់ ។
លោកស្រី Gulde-Wolf បាន ប្រាប់ សន្និសីទ សារព័ត៌មាន តាម អ៊ីនធឺណិត នៅ ទីក្រុង វ៉ាស៊ីនតោន ថា៖ « ដូច្នេះហើយ តំបន់ នេះ ប្រឈមមុខ នឹង ទស្សនវិស័យ ភាព នៅ ទ្រឹង នៃ សេដ្ឋកិច្ច និង កំណើន អតិផរណា ដោយ មាន កំណើន សេដ្ឋកិច្ច ទាប ជាង ការរំពឹងទុក កន្លងមក ហើយ កំណើន អតិផរណា ខ្ពស់ ជាង មុន » ។
