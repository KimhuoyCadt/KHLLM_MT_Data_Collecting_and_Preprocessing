( ប៉េកាំង ) ៖ ប្រធានាធិបតី ចិន លោក ស៊ី ជីន ពីង បាន និយាយ នៅក្នុង អំឡុង ដំណើរទស្សនកិច្ច ទៅកាន់ កោះ ហៃ ណាន ភាគ ខាងត្បូង ប្រទេស នៅ ថ្ងៃពុធ ទី ១៣ មេសា នេះ ថា ប្រទេស ចិន មិន ត្រូវ បន្ធូរបន្ថយ វិធានការគ្រប់គ្រង និង បង្ការ ជំងឺ កូវីដ - ១៩ ឡើយ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន AP ។
ការអត្ថាធិប្បាយ របស់ លោក បាន កើតឡើង នៅ ពេល ដែល រដ្ឋធានី ពាណិជ្ជកម្ម របស់ ប្រទេស ចិន គឺ ទីក្រុង សៀងហៃ បាន រាយការណ៍ ពី ករណី ថ្មី ជាង ២៥.០០០ ករណី នៅ ថ្ងៃ នេះ ។ ចាប់តាំងពី មេរោគ នេះ ត្រូវបាន រកឃើញ ដំបូង នៅ ទីក្រុង Wuhan របស់ ប្រទេស ចិន កាលពី ចុង ឆ្នាំ ២០១៩មក ស្ថានភាព បច្ច ប្បន្ន នេះ វា ជា សម្ពាធ ដ៏ ធំ បំផុត របស់ ប្រទេស ចិន ក្នុង ការទប់ស្កាត់ កូវីដ១៩ ។
លោក ស៊ី បាន និយាយ ថា ប្រទេស ចិន ត្រូវតែ បន្ត ជាមួយនឹង គោល នយោបាយ « បោស សំអាត កូវីដ១៩ ដ៏ តឹងរ៉ឹង » របស់ ខ្លួន ខណៈពេល ដែល កំពុង ព្យាយាម កាត់បន្ថយ ផល ប៉ះពាល់ នៃ វិធានការមក លើ សេដ្ឋកិច្ច និង សង្គម ៕
សម្ដេច ព្រះពោធិវ័ង្ស អំ លឹម ហេង ព្រះរាជ ប្រកាស នីយបត្រ តែងតាំង ព្រះសុខាចារ្យ ណំ សុភ័ក្រ្តា ឡើង ទី ជា ព្រះគ្រូ វិរិយ ធម្មគុត្ត ព្រះអនុគណស្រុក កំពង់ស្វាយ
( ភ្នំពេញ ) ៖ សម្ដេច ព្រះពោធិវ័ង្ស កិត្តិបណ្ឌិត អំ លឹម ហេង សម្ដេច ព្រះសង្ឃ នាយក រង ទី១ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន និមន្ត ជា ព្រះរាជា ធិបតីភាព ក្នុង ពិធី ប្រគេន ព្រះរាជ ប្រកាស នីយបត្រ តែងតាំង ព្រះសុខាចារ្យ ណំ សុភ័ក្រ្តា ឡើង ទី ជា ព្រះគ្រូ វិរិយ ធម្មគុត្ត ព្រះអនុគណស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ។
( ភ្នំពេញ ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម នា ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន ចេញ សារលិខិត ជូន ពរ មន្ត្រីរាជការ និង កងកម្លាំង ទាំងអស់ ដែល ចំណុះ ក្នុង ខេត្ត ព្រមទាំង ប្រជាជន នៅក្នុង ខេត្ត កំពង់ចាម ផងដែរ នា ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស . ២៥៦៦ ។
ខាងក្រោម នេះ ជា សារលិខិត ជូន ពរ របស់ អភិបាល ខេត្ត កំពង់ចាម៖ សង្ក្រាន្ត ខេត្ត កណ្ដាល នឹង ចាប់ផ្ដើម នៅ ថ្ងៃស្អែក ! អភិបាល ខេត្ត អំពាវនាវ ពលរដ្ឋ មក លេង កម្សាន្ត ឲ្យបាន ច្រើន កុះករ និង ត្រូវ ពាក់ ម៉ាស់ ឱ្យ បាន គ្រប់ ៗ គ្នា
( កណ្ដាល ) ៖ សង្ក្រាន្ត ខេត្ត កណ្ដាល នឹង ចាប់ផ្ដើម បើក ឱ្យ ចូល កម្សាន្ត ចាប់ពី ថ្ងៃស្អែក នេះ ក្នុង នោះ អភិបាល ខេត្ត កណ្ដាល លោក គង់ សោភ័ណ្ឌ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ដែល មក ចូលរួម ទស្សនា កម្សាន្ត សប្បាយ ក្នុង ឱកាស ពិធី សង្រ្កាន ខេត្ត កណ្ដាល ត្រូវ ប្រកាន់ខ្ជាប់ នូវ វិធានការ របស់ ក្រសួង សុខាភិបាល និង ត្រូវ ពាក់ ម៉ាស់ ឱ្យ បាន គ្រប់ ៗ គ្នា ។
លោក អភិបាល ខេត្ត បាន ថ្លែង យ៉ាង ដូច្នេះ នៅក្នុង កិច្ចប្រជុំ ត្រួតពិនិត្យ វឌ្ឍនភាព ការងារ រៀបចំ ពិធី បុណ្យ សង្រ្កាន្ត សង្ក្រាន្ត ខេត្ត កណ្តាល ដើម្បី ទទួល ទេវតា ឆ្នាំ ថ្មី ឆ្នាំ ខាល ចត្វា ស័ក ព .ស .២៥៦៦ នៅ សួនច្បារ មាត់ ទន្លេបាសាក់ ក្រុង តាខ្មៅ នា ព្រឹក ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០២២ នេះ ។
លោក អភិបាល ខេត្ត បន្ត ថា រដ្ឋបាល ខេត្ត កណ្ដាល បាន រៀបចំ រួចជាស្រេច នូវ ព្រឹត្តិការណ៍ សង្ក្រាន្ត ខេត្ត កណ្ដាល ដែល មាន កម្មវិធី កម្សាន្ត សប្បាយ ជាច្រើន រួម មាន ការតាំងពិព័ណ៌ ផលិតផល ក្នុង ស្រុក ការប្រគុំតន្ត្រី សម័យ ដោយ មាន ការចូលរួម ដោយ តារា ល្បី ជាច្រើន រួម មាន លោក ខេមរៈ សិរីមន្ត . លោក ខេម . កញ្ញា តន់ ច័ន្ទ ស៊ីមា . លោក ដួង វីរៈ សិទ្ធ និង តារា ល្បី ៗ ជាច្រើន រូប ទៀត ។
ជាមួយគ្នា នេះ ដែរ រដ្ឋបាល ខេត្ត កណ្ដាល បាន រៀបចំ ការលេង ល្បែង ប្រជាប្រិយ សួន កម្សាន្ត រូប ខ្លា និង ការតុបតែង អម ទៅ ដោយ ភ្លើង ពណ៌ ជាច្រើន ដែល បាន ធ្វើឱ្យ មិត្តភាព នៅក្នុង ក្រុង តាខ្មៅ មាន ភាពទាក់ទាញ ជូន ភ្ញៀវ ជាតិ - អន្តរជាតិ មក ចូលរួម ទស្សនា កម្សាន្ត នា ថ្ងៃទី ១៤ - ១៤ - ១៦ ខែមេសា ឆ្នាំ ២០២២ ខាងមុខ នេះ ផងដែរ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៨ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ២ករណី . ដឹកជញ្ជូន រក្សាទុក ១ករណី . ជួញដូរ ៥ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ១២នាក់ ។
ប៉ុន្តែ ភ្លាម ៗ នៅ មិន ទាន់ មាន សេចក្តីរាយការណ៍ ឆ្លើយតប ណាមួយ ពី ភាគី អ៊ុយក្រែន ទៅនឹង សេចក្តីថ្លែងការណ៍ របស់ ក្រសួង ការពារ ជាតិ រុស្ស៉ី នៅឡើយ ទេ ។
មេដឹកនាំ ទាំង ៤រូប បាន ចូលរួម ជាមួយ អ្នកនយោបាយ អឺរ៉ុប ជាច្រើន ក្នុង ការបំពេញ ទស្សនកិច្ច ទៅកាន់ រដ្ឋធានី របស់ អ៊ុយក្រែន ចាប់តាំងពី កងកម្លាំង រុស្ស៊ី ត្រូវបាន បណ្តេញ ចេញ ពី ភាគ ខាងជើង នៃ ប្រទេស កាលពី ដើម ខែមេសា នេះ ។
ដំណើរទស្សនកិច្ច ខាងលើ បាន កើតឡើង មួយ ថ្ងៃ បន្ទាប់ពី ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន បាន និយាយ ថា អំពើ ឃោរឃៅ ដែល បាន កើតឡើង កំលុង ការឈ្លានពាន របស់ រុស្ស៉ី លើ អ៊ុយក្រែន គឺជា អំពើ ប្រល័យ ពូជសាសន៍ ខណៈ ដែល ប្រធានាធិបតី រុស្ស៉ី លោក វ្ល៉ាឌីមៀ ពូទីន (Vladimir Putin) បាន សន្យា ថា ប្រទេស រុស្ស៊ី នឹង បន្ត ប្រតិបត្តិការ របស់ ខ្លួន ដោយ សន្សឹម ៗ និង ស្ងប់ស្ងាត់ ដើម្បី សម្រេច ឱ្យ បាន នូវ គោលដៅ របស់ ខ្លួន ៕
ឧកញ៉ា ក៏ បាន ឲ្យដឹង ផងដែរ ថា អ្វី ដែល រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ឃើញ ថា ការគ្រប់គ្រង កូវីដ - ១៩ នៅក្នុង អំឡុង ពេល ២ឆ្នាំ នេះ គឺ មាន យុទ្ធសាស្ត្រ មួយ ច្បាស់លាស់ ហើយ ជា យុទ្ធសាស្ដ្រ មួយ ដ៏ ល្អ ។ អ្វី ដែល ឃើញ ថា ល្អ បំផុត នោះ គឺ ការគ្រប់គ្រង ដោយ ការពន្លឿន នៃ ការចាក់ វ៉ាក់សាំង នៅក្នុង ប្រទេស កម្ពុជា របស់ យើង ដែល ធ្វើឲ្យ ប្រជាជន ស៊ាំ នឹង ជំងឺ កូវីដ - ១៩ ក្នុង សហគមន៍ ។
ឧកញ៉ា បន្ត ថា ពេល ដែល រដ្ឋាភិបាល កម្ពុជា បើក ប្រទេស ឡើងវិញ គឺជា ផល ល្អ ព្រោះថា សូម្បីតែ ភ្ញៀវ ទេសចរ ដែល ចង់ មក ដើរលេង នៅ ស្រុក ខ្មែរ ក៏ លែង ពិបាក ដូច មុន ។ បើ ទោះ រី រុស បំប្លែង ថ្មី « អូមី ក្រុង » មាន ការរីករាលដាល ច្រើន នៅ ប្រទេស កម្ពុជា ប៉ុន្ដែ ផល ប៉ះពាល់ តិច តូច ប៉ុណ្ណោះ គឺ ដោយសារតែ ប្រទេស កម្ពុជា មាន ការចាក់ វ៉ាក់សាំង លើ ប្រជាជន ។
ឧកញ៉ា លាង ពៅ ជឿជាក់ ថា អ្វី ដែល រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន សម្រេច បើក ប្រទេស ឡើងវិញ នេះ គឺ ពិតជា ត្រឹមត្រូវ ហើយ ប្រទេស កម្ពុជា នឹង មាន កំណើន សេដ្ឋកិច្ច ឡើងវិញ ។
លោក ឧកញ៉ា ជា ម ឃុន ណាត និង លោកជំទាវ អគ្គ នាយក បុរី មេគង្គ លែន បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា ជា ម ឃុន ណាត និង លោកជំទាវ អគ្គ នាយក បុរី មេគង្គ លែន បាន បរិច្ចាគ ថវិកា ចំនួន ២០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក លោក ឧកញ៉ា ជា ម ឃុន ណាត និង លោកជំទាវ អគ្គ នាយក បុរី មេគង្គ លែន តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ថ្នាក់ដឹកនាំ និង មន្ត្រី ទាំងអស់ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម បរិច្ចាគ ថវិកា១.០០០ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង មន្ត្រី ទាំងអស់ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម បាន បរិច្ចាគ ថវិកា ចំនួន ១.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ថ្នាក់ដឹកនាំ និង មន្ត្រី ទាំងអស់ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
នា កន្លងមក លោក LIU REN តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្ដម អ្នក ឧកញ៉ា ខូវ សម្បត្តិ អគ្គ នាយក ក្រុមហ៊ុន ថៃ ប៊ុន រ៉ុង បាន បរិច្ចាគ ថវិកា ចំនួន ២០០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម អ្នក ឧកញ៉ា ខូវ សម្បត្តិ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក Xi Jinping បាន ថ្លែង ប្រាប់ អ្នក ទាំងអស់ គ្នា ថា « យើង បាន កសាង រួច នូវ សង្គម ដែល ប្រជាជន មាន ជីវភាព ធូរធារ បង្គួរ ដោយ គ្រប់ ជ្រុងជ្រោយ បន្ទាប់មក នឹង ឈាន ទៅ រក ទំនើប ភាវូបនីយកម្ម ដើម្បី ជំរុញ វិបុលភាព រួម ។ ត្រូវ បំពេញ ការងារ អភិវឌ្ឍ ជនបទ យ៉ាង ប្រាកដប្រជា ដំបូង គឺ ត្រូវ ពង្រឹង និង ពង្រីក សមិទ្ធផល នៃ ការចេញ ផុត ពី ភាពក្រីក្រ រួច តភ្ជាប់ ដោយ មាន ប្រសិទ្ធភាព ជាមួយ ការអភិវឌ្ឍ ជនបទ ដោយ គ្រប់ ជ្រុងជ្រោយ » ។
( ត្បូងឃ្មុំ ) ៖ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ ចូល លេង កម្សាន្ត ឱ្យ បាន កុះករ ជាមួយ ព្រឹត្តិការណ៍ សង្ក្រាន្ត ត្បូងឃ្មុំ ឆ្នាំ ថ្មី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ កុរ ឯកស័ក ព .ស ២៥៦៦ ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន បន្ថែម ទៀត ថា ក្រោយពី មាន ថ្ងៃ ៧មករា ក្រោម ការដឹកនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី កម្ពុជា មក មាន ស្ថិរភាព នយោបាយ ពេញ លេង មាន ការកសាង ការអភិវឌ្ឍ សមិទ្ធផល ថ្មី ៗ មាន ជា បន្តបន្ទាប់ និង មាន បន្ត ការលើកកម្ពស់ ជីវភាព របស់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន អំឡុង ពេល កម្ពុជា ជួប វិបត្តិ កូវីដ ដោយ មិន ឲ្យ កម្ពុជា ទៅ រក ភាព អតីតកាល ឡើយ ។
នៅក្នុង ពិធី ដ៏ ឱឡារិក នេះ ប្រតិភូ នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ទទួលបាន ការស្វាគមន៍ ដោយ ផ្ទាល់ ពី ឧត្តមសេនីយ៍ ឯក កែវ ធី មេបញ្ជាការ រង កងទ័ព ជើងគោក មេបញ្ជាការ កងពល ធំ អន្តរាគមន៍ លេខ ២ អម ដោយ មេបញ្ជាការ រង នាយ ទាហាន និង ពល ទាហាន ។
ឧត្តមសេនីយ៍ ឯក កែវ ធី មេបញ្ជាការ រង កងទ័ព ជើងគោក និង ជា មេបញ្ជាការ កងពល ធំ អន្តរាគមន៍ លេខ ២ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ប្រមុខ រាជ រដ្ឋាភិបាល . ថ្នាក់ដឹកនាំ និង មន្ត្រី នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ដែល តែងតែ យកចិត្តទុកដាក់ ឧបត្ថម្ភ គាំទ្រ ដល់ កងពល ធំ អន្តរាគមន៍ លេខ ២ និង ជាពិសេស ក្នុង ស្ថានការណ៍ ដ៏ លំបាក នៃ ការរាត ត្បាត ជំងឺ កូវីដ - ១៩ ។
ក្នុង ន័យ ដើម្បី ពង្រឹង ចំណង សម្ព័ន្ធ មេត្រីភាព នេះ បន្ថែម ទៀត អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា នឹង បន្ត បេសកកម្ម ក្នុង ការចុះ សួរសុខទុក្ខ ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ក្នុង កងពល ធំ អន្តរាគមន៍ លេខ ២ នេះ ជាបន្ត ទៀត នា ពេល ខាងមុខ ៕
ក្រុមការងារ យុវជន គណបក្ស ខេត្ត ត្បូងឃ្មុំ រៀបចំ សង្ក្រាន្ត យុវជន ឃុំ អញ្ជើញ ស្រុក ត្បូងឃ្មុំ និង កម្មវិធី កម្សាន្ត ជាច្រើន ទៀត
( ត្បូងឃ្មុំ ) ៖ លោក ហាក់ សុខ មករា អភិបាល រង ខេត្ត និង ជា ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន ខេត្ត ត្បូងឃ្មុំ លោក គន់ សុភា អភិបាល រង ខេត្ត រួម ជាមួយ ក្រុមការងារ យុវជន ស្រុក ត្បូងឃ្មុំ និង យុវជន ឃុំ អញ្ជើញ បាន រៀបចំ ពិធី សង្ក្រាន្ត យុវជន ឃុំ អញ្ជើញ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ក្នុង នោះ មាន កម្មវិធី ប្រលង ចម្រៀង សម័យ យុវជន ស្តង់ ពិព័រណ៍ និង លេង ល្បែង ប្រពៃណី ។
លោក ហាក់ សុខ មករា បាន នាំយក ថវិកា របស់ លោក ហ៊ុន ម៉ាណែត ចំនួន ២លាន ៨០ ម៉ឺន រៀល ឧបត្ថម ដល់ បេក្ខជន ជ័យលាភី ប្រលង ជាប់ ចំណាត់ថ្នាក់ គណៈកម្មការចម្រៀង និង គណៈកម្មការរៀបចំ កម្មវិធី ផងដែរ ។
លោក ហាក់ សុខ មករា បាន គោរព អរគុណ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន អនុវត្ត គោល នយោបាយ ចាក់ វ៉ាក់សាំង របស់ រាជ រដ្ឋាភិបាល និង សុខ សន្តិភាព បាន អនុញ្ញាតឲ្យ យុវជន អាច រីករាយ ជួបជុំ ក្នុង ក្រុមគ្រួសារ សប្បាយរីករាយ និង ធ្វើដំណើរកម្សាន្ត ទៅកាន់ តំបន់ ទេសចរណ៍ នានា ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ខ្មែរ ប្រពៃណី ជាតិ នា ពេលនេះ ៕
អភិបាល ខេត្ត កំពង់ចាម ចុះ ពិនិត្យ វឌ្ឍនភាព ការងារ រៀបចំ ទីតាំង ប្រារព្ធ សង្រ្កាន្ត ឆ្នាំ ថ្មី ក្នុង ក្រុង កំពង់ចាម
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា នា ព្រឹក ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០២២ បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យ វឌ្ឍនភាព ការងារ រៀបចំ ទីតាំង ប្រារព្ធ សង្រ្កាន្ត ឆ្នាំ ថ្មី ២០២២ ក្នុង ក្រុង កំពង់ចាម ។
តាម មន្ត្រី រដ្ឋបាល ខេត្ត កំពង់ចាម បាន ឲ្យដឹង ថា ឆ្នាំ ២០២២ នេះ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន រៀបចំ ទីតាំង ប្រារព្ធ « សង្រ្កាន្ត កំពង់ចាម » ឆ្នាំ ថ្មី ដើម្បី ចូលរួម អបអរសារទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ឆ្នាំ ខាល ចត្វា ស័ក ព .ស ២៥៦៦ និង ការរៀបចំ វឌ្ឍនភាព នៃ សួន កុមារ សន្តិភាព ដើម្បី ត្រៀម ទទួល ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ មក លេង កម្សាន្ត ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ។
( ព្រះវិហារ ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ច័ន្ទ សុភ័ក្ត្រា មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះវិហារ នា ព្រឹក ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ នាយ ទាហាន នាយ ទាហាន រង ចុះ សួរសុខទុក្ខ សំណេះសំណាល និង នាំ ថវិកា សម្ភារ ប្រគល់ ជូន ជា ការលើកទឹកចិត្ត ដល់ កងទ័ព ដែល កំពុង ឈរជើង ការពារ តាម ព្រំដែន កម្ពុជា - ថៃ កម្ពុជា - ឡាវ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ។
នៅក្នុង ឱកាស នេះ ដែរ លោក ឧត្ដមសេនីយ៍ ទោ ច័ន្ទ សុភ័ក្ដ្រា បាន ថ្លែង ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី ថ្នាក់ដឹកនាំ យោធ ភូមិភាគ ទី៤ និង គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ព្រះវិហារ ដែល តែងតែ គិតគូរ ពី សុខ ទុក្ខ និង ការរស់នៅ របស់ កងទ័ព ពិសេស នា ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ នេះ ។
លោក ឧត្តមសេនីយ៍ ទោ មេបញ្ជាការ ខេត្ត បាន ណែនាំ ដល់ នាយ និង ពល ទាហាន ទាំងអស់ ត្រូវ គោរព ឱ្យ បាន ខ្ជាប់ ខ្លួន នូវ បទបញ្ជារ របស់ កងទ័ព វិន័យ របស់ កងទ័ព ពិសេស ត្រូវ យកចិត្តទុកដាក់ ការពារ តាម ខ្សែ របន្ទាត់ ព្រំដែន របស់ យើង ឱ្យ បាន ល្អ និង ត្រូវ ទប់ស្កាត់ គ្រប់ ប្រភេទ រាល់ បទល្មើស នៅ តាម ព្រំដែន ពិសេស ទប់ស្កាត់ ការជួញដូរ គ្រឿងញៀន និង ទប់ស្កាត់ ការឆ្លង ដែន ខុស ច្បាប់ របស់បស់ ជា ពលរដ្ឋ ។
ជាមួយ ការអញ្ជើញ ដល់ ក្រុង ព្រះសីហនុ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត នៅ ទី សក្ការៈ រង្វង់ មូល ព្រះឧមា - មហេសូរ ចំណុច ប្រសព្វ នៃ មហាវិថី ឆ្នេរ រាម និង មហាវិថី រាម ក្នុង ភូមិសាស្រ្ត ភូមិ អុង ឃុំ រាម ស្រុក ព្រៃ នប់ ខេត្ត ព្រះសីហនុ ទទួលបាន ការធ្វើ គារវកិច្ច ស្វាគមន៍ យ៉ាង ស្និទ្ធស្នាល រ៉ាក់ទាក់ បំផុត ពី លោក គួច ចំរើន អភិបាល នៃ គណៈអភិបាល ខេត្ត ព្រះសីហនុ ព្រមទាំង វត្តមាន ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ខេត្ត ព្រះសីហនុ ជាច្រើន រូប ។
នៅ រង្វង់ មូល ព្រះឧមា - មហេសូរ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន អញ្ជើញ ថត រូប អនុស្សាវរីយ៍ ជាមួយ ទេសភាព ដ៏ ស្រស់ស្អាត គ្មាន ពីរ នៃ តំបន់ ឆ្នេរសមុទ្ទ តារារៈ ទិស និរតី តំបន់ សមុទ្ទ របស់ ព្រះរាជាណាចក្រ កម្ពុជា ។
សូម បញ្ជាក់ ដែរ ថា រង្វង់ មូល ព្រះឧមា - មហេសូរ គឺជា មហាសមិទ្ធផល ថ្មី ស្រឡាង ប្រសូត្រ ចេញ ក្រោម ម្លប់ សន្តិភាព សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ហ៊ុន សែន បន្ទាប់ពី ការដាក់ចេញ នយោបាយ ឈ្នះ - ឈ្នះ ។ រង្វង់ មូល នេះ មិន គ្រាន់តែ ជា ទី សក្ការៈ របស់ បងប្អូន ពុទ្ធសានិក ជន ប៉ុណ្ណោះ ទេ ប៉ុន្តែ បាន ក្លាយជា តំបន់ ទេសចរណ៍ ដ៏ ទាក់ទាញ តាមរយៈ ការកសាងឡើង នូវ មហាវិថី ជាច្រើន តាម បណ្តា ឆ្នេរ ដ៏ ស្រស់ស្អាត នៃ តំបន់ ឆ្នេរ រាម ដែល បាន លាក់ ទុក ដ៏ យូរ លង់ មកហើយ នោះ ។
បន្ទាប់ពី ការត្រួសត្រាយ ផ្លូវ ឡើងវិញ តំបន់ ឆ្នេរ រាប បាន ភ្ជាប់ ទៅ និង ក្រុង ព្រះសីហនុ ជាមួយនិង មហាវិថី រុក្ខវិថី និង វិថី ទាំង ៣៨ ខ្សែ ដែល បាន សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា សម្បត្តិ សាធារណៈ កាក់ ពី ថ្ងៃទី២ ខែធ្នូ ឆ្នាំ ២០២១ កន្លងទៅ ថ្មី ៗ នេះ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
បន្ទាប់មក សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន អញ្ជើញ បន្ត ដំណើរទស្សនា មហាសមិទ្ធផល ថ្មី មួយ ទៀត គឺ រូបសំណាក់ ព្រះថោង តោង ស្បៃ នាង នាគ ស្ថិត លើ រង្វង់ មូល នៃ ភូមិ គគីរ ឃុំ បិត ត្រាំង ស្រុង ព្រៃ នប់ ខេត្ត ព្រះសីហនុ ដែល ទើប បញ្ចប់ ការសាងសង់ កាលពី វេលា ម៉ោង ១២ និង ៣០នាទី ថ្ងៃទី ១២ ឈានចូល ព្រឹក ថ្ងៃទី ១៣ ខែមេសា នេះ ។
រូបសំណាក ព្រះថោង នាង នាគ និង ប្រារព្វ ពិធី បុណ្យ អភិសេក តាម គន្លង ប្រពៃណី សាសនា នា ថ្ងៃទី ១៦ ខែមេសា ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដើម្បី ទុក ជា ឧត្តម ប្រយោជន៍ របស់ មនុស្សជាតិ ជា យូរអង្វែង ត រៀង ទៅ ។
នៅ រង្វង់ មូល ព្រះថោង នាង នាគ និង កន្លែង ចារឹក អក្សរ « ខ្មែរ ធ្វើ បាន » សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន អញ្ជើញ ថត រូប អនុស្សាវរីយ៍ ជាមួយ ទិដ្ឋ ដ៏ ល្អ ឯក ដែល កូន ខ្មែរ ធ្វើ បាន មុននឹង បន្ត ដំណើរ ទៅ ស្នាក់ អាស្រ័យ នៅ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
សូម ទេវតា ឆ្នាំ ថ្មី ព្រះនាម កិរិណី ទេវី ជួយ អភិបាល គ្រប់គ្រង ជួយ បីបាច់ ថែរក្សា គាំពារ និង ប្រសិទ្ធ ពរ ជ័យ ដល់ ប្រជាជន ខ្មែរ គ្រប់ រូប ឱ្យ មាន សមាន ចិត្ត ជា កុសល យោគយល់ គ្នា រួបរួម សាមគ្គី គ្នា ជា មហា គ្រួសារ ខ្មែរ តែ មួយ នៅលើ ទឹកដី មាតុភូមិ អង្គរ ជា ទី ស្នេហា ដោយ សេចក្តីសុខ ក្សេមក្សាន្ត និង ប្រកបដោយ កិត្តិយស សេចក្តីថ្លៃថ្នូរ ក្នុង ឯករាជ្យ សន្តិភាព សេរីភាព ប្រជាធិបតេយ្យ អព្យាក្រឹត និង វឌ្ឍនភាព សង្គម ត រៀង ទៅ ៕
អាល្លឺម៉ង់ គ្រោង អញ្ជើញ សេណេហ្កាល់ អាហ្រ្វិក ខាងត្បូង និង ឥណ្ឌូណេស៉ី ឱ្យ ធ្វើជា ភ្ញៀវ កិត្តិយស ចូលរួម ក្នុង កិច្ចប្រជុំ កំពូល G7 ដែល នឹង ប្រារព្ធ ឡើង នៅ រដ្ឋ បារ៉ា វៀ (Baravia) ប៉ុន្តែ សម្រាប់ ឥណ្ឌា គឺ កំពុង ស្ថិត ក្រោម ការពិចារណា ឡើងវិញ ។ បើ តាម ប្រភព ដដែល ឥណ្ឌា តាមពិត ស្ថិត ក្នុង បញ្ជី ឈ្មោះ ភ្ញៀវ អាល្លឺម៉ង់ ចង់ អញ្ជើញ ដែល ត្រូវបាន ព្រាង ឡើង តាំងតែពី មុនពេល សង្រ្គាម អ៊ុយក្រែន ផ្ទុះឡើង ទៅ ទៀត ។ យ៉ាងណា ក្តី មិន ទាន់ មាន ការសម្រេចចិត្ត ចុងក្រោយ នៅឡើយ ទេ ។
ឥណ្ឌា ស្ថិត ក្នុង ចំណោម ប្រទេស ជាង ៥០ ដែល បាន ធ្វើ អនុប វាទ ក្នុង ការបោះឆ្នោត របស់ អង្គការ សហ ប្រជាជាតិ ស្តីពី ការផ្អាក សមាជិកភាព របស់ រុស្ស៉ី នៅ ក្រុមប្រឹក្សា សិទ្ធិ មនុស្ស UN ហើយ មិន បាន ដាក់ទណ្ឌកម្ម ណាមួយ ឡើយ ប្រឆាំង នឹង ទីក្រុង មូស្គូ ។ ឥណ្ឌា ក៏ ជា ប្រទេស ដែល ទិញ សព្វាវុធ យ៉ាង ច្រើន ពី រុស្ស៉ី ផងដែរ ។
គួរ បញ្ជាក់ ថា ក្រុម ប្រទេស G7 ដែល រួម មាន សហរដ្ឋ អាមេរិក កាណាដា ចក្រភព អង់គ្លេស បារាំង អាល្លឺម៉ង់ អ៉ីតាលី និង ជប៉ុន បាន និង កំពុង ដឹកនាំ កិច្ចប្រឹងប្រែង ដាក់ទណ្ឌកម្ម សេដ្ឋកិច្ច យ៉ាង ចាស់ ដៃ លើ ប្រទេស រុស្ស៉ី សម្រាប់ ការឈ្លានពាន លើ អ៊ុយក្រែន ៕
ក្រុមហ៊ុន សំណង់ វិស្វកម្ម ចិន ទី៣ ដែល កំពុង សាងសង់ ព្រលានយន្តហោះ អន្តរជាតិ តេជោ ត្រូវបាន អញ្ជើញ ចូលរួម គាំទ្រ ការប្រកួត « ស្តេច ប្រដាល់ អង្គរ » ដើម្បី ថ្លែងអំណរគុណ ការរួមចំណែក ក្នុង ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច របស់ កម្ពុជា
ការចូលរួម ទស្សនា ការប្រកួត នេះ ជា បង្ហាញ ឱ្យ ឃើញ នូវ ស្មារតី គាំទ្រ ដ៏ មុតមាំ របស់ ក្រុមហ៊ុន សំណង់ វិស្វកម្ម ចិន ទី៣ លើ ចំណង មិត្តភាព រវាង កម្ពុជា និង ចិន និង ការលើកកម្ពស់ ទំនាក់ទំនង ផ្នែក វប្បធម៌ រវាង ប្រទេស ទាំង ពីរ ។
ថ្នាក់ដឹកនាំ និង បុគ្គលិក របស់ ក្រុមហ៊ុន សំណង់ វិស្វកម្ម ចិន ទី៣ បាន បង្ហាញ ការរីករាយ និង ស្ញប់ស្ញែង ផងដែរ ចំពោះ ការរៀបចំ ឱ្យ មាន ព្រឹត្តិការណ៍ ប្រកួត « ស្តេច ប្រដាល់ អង្គរ » ។ ពួកគេ បាន ចាត់ទុក ព្រឹត្តិការណ៍ នេះ ជា ការរួមចំណែក លើ កម្ពស់ ទំនាក់ទំនង រវាង ប្រជាជន កម្ពុជា និង ចិន ឱ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ។
សូម បញ្ជាក់ ថា ព្រឹត្តិការណ៍ ប្រកួត « ស្តេច ប្រដាល់ អង្គរ » ដែល ជា ការប្រកួត លើក ដំបូង រវាង កីឡាករ ល្បី ៗ របស់ កម្ពុជា និង ចិន ត្រូវបាន ធ្វើឡើង កាលពី យប់ ថ្ងៃអាទិត្យ ទី១០ ខែមេសា កន្លងទៅ នេះ នៅមុខ ប្រាសាទ អង្គរ ក្នុង ក្រុង សៀមរាប ។ ការប្រកួត ខ្នាត យក្ស មួយ នេះ មាន ការប្រកួត រវាង កីឡាករ និង កីឡការ កម្ពុជា និង ចិន ចំនួន ១០គូ ។
ការប្រកួត ចំនួន ១០គូ នេះ កីឡាករ ជើង ខ្លាំង របស់ កម្ពុជា ឡៅ ចន្ទ្រា . សូត្រ វាសនា និង ឈឿង ល្វៃ បាន សន្លប់ ត្រឹម ទឹក ទី១ ក្រោម កណ្តាប់ដៃ របស់ អ្នកប្រដាល់ ចិន ។ រីឯ ជើង ខ្លាំង ឡៅ ចិត្ត្រា . ផល សោភ័ណ្ឌ និង ព្រំ សំណាង ក៏ បាន ចាញ់ ពិន្ទុ កីឡាករ ចិន ផងដែរ ។ មាន តែ កីឡាករ ល ន បញ្ញា និង កីឡាការិនី នូវ ស្រី ពៅ ប៉ុណ្ណោះ ដែល បាន យកឈ្នះ អ្នក ប្រយុទ្ធ របស់ ចិន ទទួលបាន ពាន សម្រាប់ ការប្រកួត « ស្តេច ប្រដាល់ អង្គរ » ជា លើក ដំបូង នេះ ។
សូម បញ្ជាក់ ថា ក្រុមហ៊ុន សំណង់ វិស្វកម្ម ចិន ទី៣ គឺជា ក្រុមហ៊ុន ដែល ទទួលបាន ការ ទុកចិត្ត ពី ក្រុមហ៊ុន វិនិយោគ អនិកជន ខ្មែរ OCIC ឱ្យ សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ តេជោ នៅក្នុង ខេត្ត កណ្តាល ។
លោក ហង់ អមតៈ ដែល ជា តំណាង បុគ្គលិក ក្រុមហ៊ុន សំណង់ វិស្វកម្ម ចិន ទី៣ បាន លើកឡើង ថា គម្រោង អាកាសយានដ្ឋាន អន្តរជាតិ តេជោ ជា គម្រោង ដ៏ ធំ សម្បើម មួយ ប្រចាំ ប្រទេស កម្ពុជា ។ ពេល ចាប់ផ្តើម ដំណើរការ សាងសង់ គម្រោង មិន ទាន់ មាន ការប៉ះពាល់ នៃ ជំងឺ កូវីដ កើតឡើង នោះ ទេ ហើយ ជា គម្រោង ដែល ទទួលបាន ការ រួច ពន្ធ នាំចូល ពី រដ្ឋ ផងដែរ ។
ចាប់តាំងពី ឆ្នាំ ២០២០ មកដល់ ពេល បច្ចុប្បន្ន មាន ឧបសគ្គ ជាច្រើន កើតឡើង ដោយសារ ជំងឺ កូវីដ១៩ ។ គម្រោង ជាច្រើន ត្រូវបាន បិទ ប៉ុន្តែ គម្រោង សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ តេជោ នៅតែ ដំណើរការ ធម្មតា ។
វិស្វករ ក្រុមហ៊ុន សំណង់ វិស្វកម្ម ចិន ទី បី បាន ដឹកនាំ អ្នកសាងសង់ ជាង ៣.០០០ នាក់ បញ្ចប់ ការបិទ ដំបូល នៃ គ្រោង អគារ ស្ថានីយ អ្នកដំណើរ អគារ ស្ថានីយ រង់ចាំ ការហោះហើរ និង ស្ថានីយ ថាមពល ហើយ ទទួល ការវាយតម្លៃ ខ្ពស់ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន ពេល អញ្ជើញ ទស្សនា គម្រោង រយៈពេល ពីរ ដង នា ពេល កន្លងមក ។
ទិន្នន័យ បាន បង្ហាញ ថា បើ ប្រៀបធៀប នឹង ខែកុម្ភៈ នៅ ខែមីនា កម្រិត កំណើន ប្រៀបធៀប នឹង ខែ មុន និង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ មុន សុទ្ធតែ បាន កើនឡើង យ៉ាង ខ្លាំង ដែល បាន បង្ហាញ ថា អតិផរណា របស់ អាមេរិក មាន ភាព តឹងរ៉ឹង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។ នៅ ខែមីនា ដោយ រង ឥទ្ធិពល ពី កត្តា ដូចជា ការប៉ះទង្គិច រវាង រុស្ស៊ី និង អ៊ុយក្រែន និង ការផ្តាច់ ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ ជាដើម បានជា ថាមពល ការស្នាក់ នៅ និង ស្បៀងអាហារ សុទ្ធតែ បាន ឡើង ថ្លៃ យ៉ាង ច្បាស់លាស់ ។
