( ភ្នំពេញ ) ៖ ទូរគមនាគមន៍ កម្ពុជា នៅ ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ដល់ សាធារណជន ស្ដីពី ការខកខាន ផ្តល់ សេវា ជូន អតិថិជន ប្រើប្រាស់ ទូរស័ព្ទ និង អ៉ិនធើណិត ស្ថិត នៅ ទីតាំង ជ្រុង ខាងជើង ឆៀង ខាងកើត នៃ ផ្សារ អូឡាំពិក ដោយសារ ជន មិន ស្គាល់ មុខ ធ្វើ សកម្មភាព លួច កាត់ បំផ្លាញ បណ្តាញ កាប្តិ៍ FTTH របស់ ទូរគមនាគមន៍ កម្ពុជា ។
យោង តាម សេចក្ដីជូនដំណឹង បញ្ជាក់ ថា ការខកខាន ផ្តល់ សេវា បណ្តាល មកពី ជន មិន ស្គាល់ មុខ បាន ធ្វើ សកម្មភាព លួច កាត់ បំផ្លាញ បណ្តាញ កាប្តិ៍ FTTH របស់ ទូរគមនាគមន៍ ភ្លាម ៗ នោះ ដែរ ។ ដើម្បី ធានា បាន នូវ ប្រសិទ្ធភាព ក្នុង ការផ្គត់ផ្គង់ សេវា ទូរគមនាគមន៍ កម្ពុជា បាន ជួល ជុល និង ផ្លាស់ប្តូរ បរិក្ខារ មួយចំនួន តភ្ជាប់ បណ្តាញ ជូន អតិថិជន ដំណើរការធម្មតា ឡើងវិញ ។
ករណី លួច កាត់ បំផ្លាញ បណ្តាញ ខ្សែ កាប្តិ៍ ទូរគមនាគមន៍ កម្ពុជា ជា អំពើ ប្រព្រឹត្ត ផ្ទុយ នឹង ច្បាប់ បង្ក ការខូចខាត ដល់ ទូរគមនាគមន៍ កម្ពុជា និង អតិថិជន ខកខាន ក្នុង ការរក ចំណូល ថវិកា ជាតិ ។
ទូរគមនាគមន៍ កម្ពុជា ស្នើ សូម អតិថិជន ទាំងអស់ សហការផ្តល់ ពត៌មាន និង ផ្តល់ រូបភាព ស្ដីពី សកម្មភាព ចោរកម្ម លួច កាត់បណ្តាញ ខ្សែ កាប្តិ៍ ដើម្បី សមត្ថកិច្ច ផ្តន្ទាទោស ជនល្មើស តាម ច្បាប់ ជាធរមាន ។ សូម ទូរស័ព្ទ ទំនាក់ទំនង លេខ៖ លោក ហ៊ុន ប្រុស ០១២ ៨៧៣ ១២១ . លោក សុ សុធី រ ០១៧ ៥៩៧ ៥៧៦ និង លោក ទេព កោសល្យ ០៨៩ ៦៦២ ៣៥៦ ៕
សូម អាន សេចក្ដីជូនដំណឹង របស់ ទូរគមនាគមន៍ ទាំង ស្រុង៖ ទេសរដ្ឋមន្ត្រី លី ធុជ ចែករំលែក បទពិសោធន៍ និង ការដឹកនាំ វិស័យ សកម្មភាព មីន នៅ កម្ពុជា ជូន គណៈប្រតិភូ សកម្មភាព មីន ហ្វីលីពីន
( ភ្នំពេញ ) ៖ ក្នុង នាម សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង ជា ប្រធាន អាជ្ញាធរ មីន ទេសរដ្ឋមន្រ្តី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន នៅ ព្រឹក ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន ចែករំលែក បទពិសោធន៍ និង ការដឹកនាំ វិស័យ សកម្មភាព មីន នៅ កម្ពុជា ជូន ដល់ គណៈប្រតិភូ សកម្មភាព មីន នៃ ប្រទេស ហ្វីលីពីន និង ភាគី ពាក់ព័ន្ធ ក្នុង សិក្ខាសាលា ស្តីពី អ្នក ពាក់ព័ន្ធ វិស័យ សកម្មភាព មីន ហ្វីលីពីន ដែល កម្ពុជា បាន ធ្វើជា ម្ចាស់ ផ្ទះ ។
ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា ទេសរដ្ឋមន្រ្តី បាន ជម្រាប ប្រាប់ ដល់ អង្គ សិក្ខាសាលា ថា កម្ពុជា ដែល មាន អាជ្ញាធរ មីន ជា សេនាធិការ បាន ប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ ចំពោះ កិច្ចសហប្រតិបត្តិការ នេះ និង បាន ត្រៀម ខ្លួន រួច ជាស្រេច ដើម្បី ចូលរួម គាំទ្រ ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង សកម្មភាព មីន នៅក្នុង តំបន់ មិន ត្រឹមតែ ក្នុង អំឡុង ពេល ឆ្នាំ នេះ ដែល ជា ឆ្នាំ នៃ ការធ្វើជា ប្រធាន អាស៊ាន របស់ កម្ពុជា ប៉ុណ្ណោះ ទេ ប៉ុន្តែ នៅ គ្រប់ ពេលវេលា ។
ទេសរដ្ឋមន្រ្តី បាន លើកឡើង ថា កាលពី ឆ្នាំ ២០១២ កម្ពុជា ក្នុង នាម ជា ប្រធាន អាស៊ាន បាន ផ្តួចផ្តើម គំនិត បង្កើត ឱ្យ មាន មជ្ឈមណ្ឌល តំបន់ អាស៊ាន សម្រាប់ សកម្មភាព មីន ដោយ យល់ឃើញ ថា ការថែរក្សា សន្តិសុខ មនុស្សជាតិ គឺជា ផ្នែក សំខាន់ មួយ យ៉ាង សំខាន់ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ការកសាង សហគមន៍ អាស៊ាន និង ព្យាយាម ធានា ថា រដ្ឋ ជា សមាជិក អាស៊ាន ទាំងអស់ និង គ្រប់ វិស័យ សង្គម ទទួលបាន អត្ថប្រយោជន៍ ពី ដំណើរការ នេះ ។
ក្នុង ឱកាស នោះ ទេសរដ្ឋមន្រ្តី បាន កោតសរសើរ ចំពោះ ការតាំងចិត្ត ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ក្នុង ការផ្តល់ កិច្ចសហការ កាន់តែ ខ្លាំង នៅក្នុង តំបន់ និង ធ្វើការ យ៉ាង ជិតស្និទ្ធ ជាមួយ អ្នក បន្ត បេសកកម្ម សម្រាប់ សកម្មភាព មីន ក្នុង ការលើកកម្ពស់ សុខ សុវត្ថិភាព និង ជួយ ដល់ ជន ងាយ រងគ្រោះ ដែល រង ផល ប៉ះពាល់ ដោយ សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ។
ទេសរដ្ឋមន្រ្តី បាន បញ្ជាក់ បន្ថែម ថា ការងារ បោសសម្អាត មីន គឺជា បេសកកម្ម របស់ យើង ទាំងអស់ គ្នា ហើយ គ្រប់ ដៃគូ អភិវឌ្ឍន៍ និង ភាគី ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ចូលរួម ឆ្ពោះ ទៅរក ពិភពលោក គ្មាន មីន ឆ្នាំ ២០២៥ ៕ អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា និង លោកជំទាវ នាំយក ថវិកា ឧបត្ថម្ភ ២លាន ដុល្លារ ប្រគល់ ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
គួរ បញ្ជាក់ ផងដែរ អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា និង លោកជំទាវ ឈឺ ន ស្រី ម៉ាច តែង ឧបត្ថម្ភ ទៅកាន់ កាកបាទ ក្រហម កម្ពុជា ជារៀងរាល់ ឆ្នាំ ជាពិសេស ជានិច្ចកាល បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការគាំទ្រ ដល់ យុទ្ធនាការសប្បុរសធម៌ របស់ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ដាក់ចេញ នូវ កម្មវិធី មនុស្សធម៌ ជាច្រើន ដើម្បី រួមចំណែក ទ្រទ្រង់ សង្គមជាតិ ៕
ឧកញ៉ា បណ្ឌិត ឡាច សំរោង ផ្ញើ លិខិត អបអរសារទរ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ ក្នុង ឱកាស ទទួលបាន គោរមងារ « បណ្ឌិត » ពី សាកលវិទ្យាល័យ ថុន បូរី នៃ ប្រទេស ថៃ
( ភ្នំពេញ ) ៖ ឧកញ៉ា បណ្ឌិត ឡាច សំរោង សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ឥន្ទ្រវិជ្ជា (UI) បាន ផ្ញើ សារលិខិត អបអរសារទរ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ សមាជិក ព្រឹទ្ធសភា និង ជា អនុប្រធាន កិត្តិយស នៃ សមាគម មូលនិធិ សម្តេច តេជោ ដើម្បី អភិវឌ្ឍន៍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា ក្នុង ឱកាស ទទួលបាន គោរមងារ « បណ្ឌិត » ពី សាកលវិទ្យាល័យ ថុន បូរី នៃ ប្រទេស ថៃ ។
ក្នុង សារលិខិត អបអរសាទរ បាន សរសេរ ថា « ក្នុង នាម សាកលវិទ្យាល័យ ឥន្ទ្រវិជ្ជា (UI) និង ក្នុង នាម ខ្ញុំ ផ្ទាល់ សូម អនុញ្ញាត សម្តែង ក្តីអំណរ សាទរ យ៉ាង ស្មោះស្ម័គ្រ បំផុត ជូន ចំពោះ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ សមាជិក ព្រឹទ្ធសភា និង ជា អនុប្រធាន កិត្តិយស នៃ សមាគម មូលនិធិ សម្តេច តេជោ ដើម្បី អភិវឌ្ឍន៍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា ក្នុង ឱកាស ដ៏ ពិសិដ្ឋ ថ្លៃថ្លា នៃ ទទួលបាន គោរមងារ បណ្ឌិត ពី សាកលវិទ្យាល័យ ប៊ុន បូរី នៃ ប្រទេស ថៃ » ។
( ត្បូងឃ្មុំ ) ៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន មាន សទ្ធា ជ្រះថ្លា ប្រគេន បច្ច័យ សម្រាប់ សាងសង់ បង្ហើយ ព្រះវិហារ នៅ វត្ត បារាយណ៍ និង គូរ គំនូរ ក្នុង ព្រះវិហារ វត្ត បារាយណ៍ នេះ ទៀត ផងដែរ ដើម្បី ទុក ជា សមិទ្ធផល ក្នុង ព្រះពុទ្ធ សាសនា ដែល ជា ទីកសាង កុសល ផល បុណ្យ នៃ ប្រជាពុទ្ធ បរិស័ទ គ្រប់ គ្នា ។
គួរ បញ្ជាក់ ថា វត្ត បារាយណ៍ គឺ ស្ថិត នៅ ភូមិ បារាយណ៍ ឃុំ ឈូក ស្រុក ក្រូចឆ្មារ ខេត្ត ត្បូងឃ្មុំ ។ ព្រះវិហារ នៃ វត្ត នេះ គឺ ត្រូវបាន កសាង តាំងពី ឆ្នាំ ២០១៦ ហើយ រហូតដល់ ឆ្នាំ ២០២០ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក៏ បាន ចូលរួម បច្ច័យ ដើម្បី កសាង បង្ហើយ នូវ ព្រះវិហារ នេះ ។ មកដល់ ពេល បច្ចុប្បន្ន ការកសាង ព្រះវិហារ នៅ វត្ត បារាយណ៍ នេះ គឺ សម្រេច រួចរាល់ ហើយ នៅឡើយ តែ ការគូរ គំនូរ ក្នុង ព្រះវិហារ ដែល មិន ទាន់ រួចរាល់ ជា ស្ថាពរ ។
ក្នុង ឱកាស អញ្ជើញ ទៅ ស្រុក កំណើត នា ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២២ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក៏ បាន អញ្ជើញ ចូល ទៅកាន់ ទី វត្តអម្ព វ័ន ហៅ វត្ត ស្វាយ ដំណាក់ ដោយ បាន ចូល ថ្វាយបង្គំ ចំពោះ ព្រះវិញ្ញូវេទី តេង ហែ ព្រះបាឡាត់ គណ ខេត្ត ត្បូងឃ្មុំ និង ជា ព្រះចៅ អធិការ វត្ត អម្ព វ័ន នោះ ស្រាប់ ។ ទីបរម ភូមិ នេះ ហើយ ដែល បាន បន្សល់ នូវ អនុស្សាវរីយ៍ កាលពី វ័យ ក្មេង និង វ័យ សិក្សា របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន មាតា មនុស្សធម៌ នៃ ប្រជាជាតិ ខ្មែរ ។
ជាមួយគ្នា នោះ ព្រះចៅ អធិការ វត្ត អម្ព វ័ន ក៏ បាន មាន សង្ឃ ដីកា អំពី ការគូរ គំនូរ នៅក្នុង ព្រះវិហារ វត្ត បារាយណ៍ ដែល ស្ថិត នៅ ភូមិ បារាយណ៍ ឃុំ ឈូក ដោយ បច្ចុប្បន្ន កំពុង ត្រូវការ បច្ច័យ បន្ថែម ដើម្បី គូរ បង្ហើយ ឱ្យ បាន រួចរាល់ ដូច្នេះហើយ ព្រះចៅ អធិការ វត្ត អម្ព វ័ន ជំនួស មុខ ឱ្យ គណៈកម្មការ វត្ត និង ប្រជាពុទ្ធ បរិស័ទ នៅ វត្ត បារាយណ៍ ក៏ មាន សង្ឃ ដីកា ស្នើសុំ ឱ្យ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ជួយ ក្នុង កិច្ចការ នេះ តាម សទ្ធា ជ្រះថ្លា ។
នា បរិយាកាស គួរ ជា ទី រមណីយ ជ្រះថ្លា នោះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក៏ បាន ប្រគេន នូវ បច្ច័យ បន្ថែម តាមរយៈ ព្រះអង្គ តេង ហែ ដើម្បី ចូលរួម ក្នុង ការគូរ គំនូរ នៅក្នុង ព្រះវិហារ វត្ត បារាយណ៍ ដើម្បី ទុក ជា សមិទ្ធផល ក្នុង ព្រះពុទ្ធ សាសនា និង សម្រាប់ ឱ្យ ប្រជាពុទ្ធ បរិស័ទ ងាយស្រួល ក្នុង ការប្រារព្ធ ពិធី បុណ្យ ទាន ផ្សេង ៗ នៅក្នុង វត្ត ក៏ ដូចជា នៅក្នុង ព្រះវិហារ ជាដើម ។
ព្រះវិញ្ញូវេទី តេង ហែ មាន សង្ឃ ដីកា ថា បច្ច័យ ដែល ជា សទ្ធា ជ្រះថ្លា របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន គឺ សម្រាប់ គូរ គំនូរ នៅ តាមពិដាន នៃ ព្រះវិហារ វត្ត បារាយណ៍ ដែល មាន ទំហំ សរុប ៣២៥ ម៉ែត្រ ការ៉េ ។
ព្រះចៅ អធិការ វត្ត អម្ព វ័ន មាន សង្ឃ ដីកា បន្ត ថា បច្ច័យ ដែល ប្រើប្រាស់ សម្រាប់ ការកសាង បង្ហើយ ព្រះវិហារ និង ការគូរ គំនូរ ក្នុង ព្រះវិហារ នៃ វត្ត បារាយណ៍ នេះ គឺ មាន ចំនួន សរុប ១០០.០០០ ( មួយ រយ ពាន់ ) ដុល្លារ អាមេរិក ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា លី ហួរ ប្រធាន សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា បាន ចេញ សារលិខិត អបអរសាទរ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ សមាជិក ព្រឹទ្ធសភា និង ជា ប្រធាន សមាគម ឧកញ៉ា កម្ពុជា និង ជា ឧត្តម ទីប្រឹក្សា នៃ សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា ក្នុង ឱកាស ទទួលបាន គោរមងារ បណ្ឌិត ពី សាកលវិទ្យាល័យ ថុន បូរី នៃ ប្រទេស ថៃ ។
ក្នុង សារលិខិត អបអរសាទរ បាន សរសេរ ថា តាង នាម ឲ្យ សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា ខ្ញុំ និង ភរិយា ព្រមទាំង ថ្នាក់ដឹកនាំ សមាជិក - សមាជិកា សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា ទាំងអស់ សូម សម្តែង នូវ មនោសញ្ចេតនា រំភើប រីករាយ អបអរសាទរ យ៉ាង ក្លៀវក្លា បំផុត ជូន ចំពោះ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ សមាជិក ព្រឹទ្ធសភា និង ជា ប្រធាន សមាគម ឧកញ៉ា កម្ពុជា និង ជា ឧត្តម ទីប្រឹក្សា នៃ សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា ក្នុង ឱកាស ទទួលបាន គោរមងារ « បណ្ឌិត » ពី សាកលវិទ្យាល័យ ប៉ុន បូរី នៃ ប្រទេស ថៃ ។
ជាថ្មី ម្តង ទៀត ខ្ញុំ និង ភរិយា ព្រមទាំង ថ្នាក់ដឹកនាំ សមាជិក - សមាជិកា សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា ទាំងអស់ សូម គោរព ជូនពរ អ្នក ឧកញ៉ា និង លោកជំទាវ ព្រមទាំង បុត្រា បុត្រី សូម ប្រកបដោយ សុខភាព មាំមួន ប្រាជ្ញា ភ្លឺ ថ្លា ដើម្បី សម្រេច ភារកិច្ច ដ៏ ឧត្តុងឧត្តម និង សូម ប្រកបដោយ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ « សង្រ្កាន្ត រតនគិរី » នឹង ត្រូវ រៀបចំ យ៉ាង គគ្រឹកគគ្រេង នៅ បរិវេណ មន្ទីរ វប្បធម៌ ខេត្ត រតនគិរី
ក្នុង កិច្ចប្រជុំ ដែល បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២២ លោក ញ៉ែ ម សំអឿន បាន ឲ្យដឹង ថា ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មៃរ ដែល នឹង ចូល មកដល់ នា ពេល ដ៏ ខ្លី ខាងមុខ នេះ រដ្ឋបាល ខេត្ត នឹង រៀបចំ ធ្វើ សង្រ្កាន្ត ឆ្នាំ ថ្មី មាន ឈ្មោះ ថា « សង្រ្កាន្ត រតនគិរី » នៅ បរិវេណ មន្ទីរ វប្បធម៌ និង វិចិត្រ សិល្បៈ ខេត្ត ជា ការអបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១៤ - ១៥ - ១៦ ខែមេសា ឆ្នាំ ២០២២ ។
( កំពង់ស្ពឺ ) ៖ លោក ថេង ច័ន្ទ សង្វារ រដ្ឋលេខាធិការ តំណាង ឧប នាយក រដ្ឋមន្ដ្រី ជា សុផារ៉ា រដ្ឋមន្ដ្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជាធិបតី ក្នុង ពិធី សួរសុខទុក្ខ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៅ បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ៣ ស្ថិត ក្នុង ខេត្ត កំពង់ស្ពឺ ។
ឋិត ក្នុង បរិយាកាស ដ៏ មហោឡារិក អធិកអធម និង ក្តី មោទកៈភាព យ៉ាង ជ្រាលជ្រៅ នា ពេលនេះ នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន ទាំងអស់ នៅ ទូទាំង យោធភូមិភាគ បាន សម្តែង នូវ ក្តីកតញ្ញូតាធម៌ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូប ណីយកម្ម និង សំណង់ ដែល បាន យកចិត្តទុកដាក់ ចាត់តាំង ប្រតិភូ អញ្ជើញ មកដល់ អង្គភាព យោធ ភូមិភាគ ទី៣ ។
ក្នុង គោលបំណង សាកសួរ សុខទុក្ខ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស ២៥៦៦ នា ពេល ខាងមុខ នេះ កាយវិការ ដ៏ សប្បុរសធម៌ នេះ បង្ហាញ ឲ្យ ឃើញ ច្បាស់ អំពី ស្មារតី យកចិត្តទុកដាក់ គិត គូ ដល់ សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ កងទ័ព និង សូម ធ្វើ គារវកិច្ច ស្វាគមន៍ យ៉ាង កក់ក្តៅ បំផុត ចំពោះ វត្តមាន របស់ លោក រដ្ឋលេខាធិការ តំណាង ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា ដែល បាន ឆ្លៀត ឱកាស ដ៏ មមាញឹក ដឹកនាំ ប្រតិភូ របស់ ក្រសួង ចុះ មកដល់ អង្គភាព ទ័ព នៅ ពេល នេះ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ថេង ច័ន្ទ សង្វារ បាន នាំយក នូវ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ របស់ ឧប នាយក រដ្ឋមន្ដ្រី ជា សុផារ៉ា ជូន ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៅ បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ៣ ខេត្ត កំពង់ស្ពឺ ដោយ ក្ដី នឹករលឹក ។ លោក ក៏ បាន កោតសរសើរ និង ថ្លែងអំណរគុណ ដល់ កងទ័ព ទាំងអស់ ដែល បាន លះបង់ សាច់ ស្រស់ ឈាម ស្រស់ ដើម្បី ការពារ ជាតិ មាតុភូមិ ។
បន្ថែម ពី នេះ លោក ថេង ច័ន្ទ សង្វារ ក៏ បាន ក្រើន រំលឹក ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៅពេល ដល់ វេលា ត្រូវ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូស ជំរុញ ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី បង្កើន នូវ កង ការពារ ពី ជំងឺ កូវីដ១៩ ។ បើ ទោះបី ចាក់ វ៉ាក់សាំង ហើយ ក្ដី ក៏ មិន ត្រូវ ប្រហែស នោះ ដែរ ពោល ត្រូវតែ អនុវត្ត ឲ្យបាន ត្រឹមត្រូវ នូវ វិធាន សុខាភិបាល និង វិធាន « ៣ការពារ និង ៣កុំ » ដើម្បី ជៀស ផុត ពី ជំងឺ កូវីដ១៩ ៕
ការសម្រេច ខាងលើ ធ្វើឡើង បន្ទាប់ពី ការប្រកាស គ្រោង ផ្តល់ ជំនួយ បន្ថែម ដល់ អ៊ុយក្រែន ដោយ នាយក រដ្ឋមន្រ្តី ជប៉ុន លោក ហ្វូមី អូ គីស៉ី ដា (Fumio Kishida) កាលពី ប៉ុន្មាន សប្តាហ៍ កន្លងទៅ ដើម្បី ឆ្លើយតប ចំពោះ តម្រូវ ការចាំបាច់ នៅក្នុង ផ្នែក ដូចជា សុខាភិបាល . ស្បៀងអាហារ . និង ការការពារ ជនភៀសខ្លួន ទាំង នៅក្នុង អ៊ុយក្រែន ផ្ទាល់ និង នៅ តាម ប្រទេស ជិតខាង ដូចជា ម៉ុល ដាវី. ប៉ូឡូញ . ហុង គ្រី . រ៉ូម៉ានី និង ស្លូវ៉ាគី ។
គួរ បញ្ជាក់ ថា ជំនួយ ខាងលើ នឹង ត្រូវ ផ្តល់ តាមរយៈ ស្ថាប័ន អន្តរជាតិ ចំនួន ៩ រួម និង អង្គការ ក្រៅ រដ្ឋាភិបាល របស់ ជប៉ុន ចំនួន ២។ បន្ថែម ជាមួយ ជំនួយ ថ្មី ចុងក្រោយ នេះ ការគាំទ្រ របស់ ជប៉ុន សម្រាប់ វិបត្តិ នៅ អ៊ុយក្រែន សរុប កើន ដល់ ២០០ លាន ដុល្លារ ។ រដ្ឋាភិបាល ជប៉ុន បាន សង្កត់ធ្ងន់ ថា ខ្លួន នឹង នៅតែ បន្ត ផ្តល់ ការជួយជ្រោមជ្រែង ដល់ ប្រជាជន អ៊ុយក្រែន ក្រោម ការសហការ ជាមួយ សហគមន៍ អន្តរជាតិ ៕
នាយ ឧត្តមសេនីយ៍ សៅ សុខា បើក កិច្ចប្រជុំ ត្រួតពិនិត្យ របាយការណ៍ បូកសរុប ការងារ កងរាជអាវុធហត្ថ ត្រីមាស ទី១ និង លើក ទិសដៅ ផែនការ សកម្មភាព ការងារ ត្រីមាស ទី២ ឆ្នាំ ២០២២
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង និង មេបញ្ជាការ កងរា អាវុធហត្ថ លើ ផ្ទៃ ប្រទេស នៅ ព្រឹក ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន បើក កិច្ចប្រជុំ ត្រួតពិនិត្យ របាយការណ៍ បូកសរុប ការងារ កងរាជអាវុធហត្ថ ប្រចាំ ត្រីមាស ទី១ និង លើក ទិសដៅ ផែនការ សកម្មភាព ការងារ កងរាជអាវុធហត្ថ ត្រីមាស ទី២ ឆ្នាំ ២០២២ ។
កិច្ចប្រជុំ នេះ បាន ប្រព្រឹត្ត ធ្វើឡើង នៅ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ដោយ មាន ការអញ្ជើញ ចូលរួម ពី មេបញ្ជាការ រង នាយ នាយ រង សេនាធិការ ស្នងការ ស្នងការ រង និង មេបញ្ជាការ រាជធានី - ខេត្ត ព្រមទាំង នាយ ការិយាល័យ ចំណុះ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស តាមរយៈ ប្រព័ន្ធ Video Conterence ៕
ដោយឡែក ដោយ សង្កត់ធ្ងន់ ទៅ លើ សារៈសំខាន់ នៃ មេរៀន ដែល បាន ឆ្លងកាត់ អំពី វិបត្តិ និង ការស្វែងរក សន្តិសុខ យូរអង្វែង នៅ អឺរ៉ុប លោក វ៉ាង បាន ស្នើ ឲ្យ មាន ការសន្ទនា ដោយ ស្មើភាព ក្នុង ក្របខណ្ឌ សន្តិសុខ និង ផ្អែក លើ គោលការណ៍ សន្តិភាព ដ៏ រឹងមាំ ក្នុង តំបន់ អឺរ៉ុប ។ លោក បន្ថែម ថា « ចិន នឹង រក្សា នូវ គោលជំហរ ដែល មាន លក្ខណៈ យុត្តិធម៌ ហើយ បន្ត ដើរ តួនាទី ស្ថាបនា វិបត្តិ នេះ តាម វិធី របស់ ខ្លួន » ។
ជា ការឆ្លើយតប រដ្ឋមន្រ្តី ការបរទេស អ៊ុយក្រែន លោក Kuleba បាន យល់ស្រប ចំពោះ ទស្សនៈ របស់ ចិន លើ បញ្ហា អ៊ុយក្រែន ហើយ លោក បាន បញ្ជាក់ ថា អ៊ុយក្រែន មាន ឆន្ទៈ ក្នុង ការរក្សា ទំនាក់ទំនង ជាមួយ ប្រទេស ចិន និង សង្ឃឹម ថា ចិន បន្ត ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការបញ្ចប់ ជម្លោះ ដែល កំពុង អូសបន្លាយ នេះ ។
គួរ បញ្ជាក់ ថា នេះ ជា ជំនួប តាម ទូរស័ព្ទ លើក ទី២ ហើយ រវាង រដ្ឋមន្រ្តី ទូត ជាន់ ខ្ពស់ របស់ ចិន និង អ៊ុយក្រែន ចាប់តាំងពី មាន ការវាយប្រហារ របស់ រុស្ស៊ី លើ អ៊ុយក្រែន រីឯ កាកបាទ ក្រហម របស់ ចិន បាន ផ្តល់ ជំនួយ មនុស្សធម៌ ជាច្រើន ដល់ ប្រទេស អ៊ុយក្រែន ៕ រដ្ឋបាល ខេត្ត រតនគិរី បើក កិច្ចប្រជុំ សាមញ្ញ លើក ទី៣៤ អាណត្តិ ទី៣ របស់ ក្រុមប្រឹក្សា ខេត្ត
( រតនគិរី ) ៖ រដ្ឋបាល ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន បើក កិច្ចប្រជុំ សាមញ្ញ លើក ទី៣៤ អាណត្តិ ទី៣ របស់ ក្រុមប្រឹក្សា ខេត្ត រតនគិរី ក្រោម អធិបតីភាព លោក ណាប់ ប៊ុន ហេង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី ។
ក្នុង កិច្ចប្រជុំ បាន លើកឡើង នូវ របៀបវារៈ មួយចំនួន ដោយ បាន ធ្វើ ការពិនិត្យ ពិភាក្សា និង អនុម័ត លើ សេចក្តីព្រាង របាយការណ៍ រួម មាន៖
* ពិនិត្យ ពិភាក្សា និង អនុម័ត សេចក្តីព្រាង កំណត់ហេតុ កិច្ចប្រជុំ សាមញ្ញ លើក ទី ៣៣ របស់ ក្រុមប្រឹក្សា ខេត្ត ។ * ពិនិត្យ ពិភាក្សា និង អនុម័ត សេចក្តីព្រាង របាយការណ៍ ស្តីពី ការអនុវត្ត ការងារ របស់ រដ្ឋបាល ខេត្ត ប្រចាំ ខែមីនា និង លើក ទិសដៅ ការងារ ២០២២ របស់ រដ្ឋបាល ខេត្ត ប្រចាំ ខែមេសា ឆ្នាំ ២០២២ ។ * ពិនិត្យ ពិភាក្សា និង អនុម័ត សេចក្តីព្រាង របាយការណ៍ ស្តីពី ការអនុវត្ត ការងារ របស់ រដ្ឋបាល ខេត្ត ប្រចាំ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ការងារ ប្រចាំ ឆ្នាំ ២០២២ របស់ រដ្ឋបាល ខេត្ត ។
ជាមួយគ្នា នោះ លោក ញ៉ែ ម សំអឿន ក៏ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ អ្នក ពាក់ព័ន្ធ ទាំងអស់ ដែល ខិតខំ បំពេញ ការងារ នា ពេល កន្លងមក ពិសេស លោក លោកស្រី ក្នុង ជួរ ក្រុមប្រឹក្សា ខេត្ត ដែល បាន ជួយ ជំរុញ ឲ្យ ការងារ រដ្ឋបាល ខេត្ត រតនគិរី សម្រេចបាន លទ្ធផល យ៉ាង ល្អ ប្រសើរ ជា បន្តបន្ទាប់ ។
ការសម្រេច លុប ឈ្មោះ បេក្ខជន និង បញ្ជី ឈ្មោះ គណបក្ស ទាំងនេះ បាន ធ្វើឡើង បន្ទាប់ពី គ.ជ. ប បាន ដោះស្រាយ បណ្តឹង មួយចំនួន ដែល ក្នុង នោះ មាន បណ្តឹង សុំ ដក ខ្លួន ចេញ ពី ការឈរ ជា បេក្ខជន ឈរឈ្មោះ . បណ្តឹង សុំ ឱ្យ លុប ឈ្មោះ បេក្ខជន ដែល មិន គ្រប់ លក្ខខណ្ឌ និង ប្រភេទ បណ្តឹង ស្នើសុំ ឱ្យ លុប បញ្ជី បេក្ខជន ជាដើម ។
អ្នកនាំពាក្យ គ.ជ. ប បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « មាន បេក្ខជន ចំនួន ៨៦ នាក់ ត្រូវបាន គ.ជ. ប លុប ឈ្មោះ ចេញ ពី បញ្ជី បេក្ខជន ឈរឈ្មោះ គណបក្ស នយោបាយ ហើយ ក្នុង នោះ មាន បណ្តឹង ស្នើសុំ លុប ដោយ ប្រជាពលរដ្ឋ មាន ចំនួន ៣៦ នាក់ និង បណ្តឹង ដែល សាមីខ្លួន ជា បេក្ខជន សុំ លុប មាន ៥៣ នាក់ ហើយ ចំពោះ ការលុប បញ្ជីវិញ គឺ មាន ការលុប បញ្ជី ឈ្មោះ គណបក្ស នយោបាយ ចំនួន ១៣ ឃុំ / សង្កាត់ ដូច្នេះ មាន ន័យ ថា គណបក្ស ទាំងនោះ មិន មាន ឱកាស ក្នុង ការប្រកួតប្រជែង ក្នុង ឃុំ សង្កាត់ នោះ ទៀត ទេ » ។
ឯកឧត្ដម ហេង សុខ ណាង និង លោកជំទាវ បរិច្ចាគ ថវិកា ១០លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ហេង សុខ ណាង អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០.០០០ រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម ហេង សុខ ណាង និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម ឧកញ៉ា ស៊ន សុខ ណា និង លោកជំទាវ មុំ ថា វី បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ឧកញ៉ា ស៊ន សុខ ណា និង លោកជំទាវ មុំ ថា វី បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម ឧកញ៉ា ស៊ន សុខ ណា និង លោកជំទាវ មុំ ថា វី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សម្ដេច ក្រឡាហោម ស ខេង និង លោកជំទាវ ញ៉ែ ម សាខ ន បរិច្ចាគ ថវិកា ៥ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង លោកជំទាវ ញ៉ែ ម សាខ ន បាន បរិច្ចាគ ថវិកា ចំនួន ៥.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក សម្ដេច ក្រឡាហោម ស ខេង និង លោកជំទាវ ញ៉ែ ម សាខ ន តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គម្រោង តុក្កតា យក្ស នឹង រៀបចំ ពិធី ដង្ហែ នៅ ថ្ងៃទី ១៣ មេសា
( សៀមរាប ) ៖ គម្រោង តុក្កតា យក្ស ដែល រៀបចំឡើង ដោយ អភិបាល ស្រុក បន្ទាយស្រី គ្រោង រៀបចំ ដង្ហែ ក្បួន នៅ ថ្ងៃទី ១៣ ខែមេសា ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ខាងមុខ នេះ ។
មន្ត្រី រដ្ឋបាល ស្រុក បន្ទាយស្រី បាន ឱ្យដឹង ថា គម្រោង តុក្កតា យក្ស គ្រោង រៀបចំ ពិធី ដង្ហែ ជា ផ្លូវការ នៅ ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០២២ លើ កំណាត់ ផ្លូវ ក្នុង ភូមិ ព្រះដាក់ ដើម្បី បង្ហាញ ដល់ សាធារណជន កម្សាន្ត ។
កន្លងមក លោក ឃឹម ហ្វីណង់ អភិបាល ស្រុក បន្ទាយស្រី បាន ប្រកាស ថា តុក្កតា យក្ស នេះ រៀបចំឡើង ដោយ រដ្ឋបាល ស្រុក និង ក្រុមការងារ ។ ដើម ឡើយ គម្រោង តុក្កតា យក្ស គ្រោង ធ្វើ ដើម្បី អបអរ ទិវា វប្បធម៌ ជាតិ លើក ទី២៤ និង ទិវា សិទ្ធិ នារី អន្តរជាតិ ។ តែ គម្រោង នេះ ត្រូវបាន អាក់ខាន វិញ ដោយសារ អំឡុង ពេល នោះ មាន ការរាលដាល ជំងឺ កូវីដ ខ្លាំង ។
តុក្កតា យក្ស នេះ ធ្វើឡើង ពី ផ្តៅ រពាក់ ឬ ស្សី ក្រដាស់ ពណ៌ និង មាន ការបង្កប់ អំពូលភ្លើង ខាងក្នុង ព្រមទាំង មាន កង់ រទេះ ទម្រ ពីក្រោម សម្រាប់ ការដង្ហែរ ក្បួន ផងដែរ ។ រូប តុក្កតា មាន ទម្រង់ ខុស ៗ គ្នា មាន រូប សត្វ ខ្លា តំណាង ឆ្នាំ ខាល រូប ល្ខោន ខោល រូប ស្រ្តី គ្រប់ លក្ខណ៍ នៃ ប្រាសាទ បន្ទាយស្រី រូប សត្វ ខ្សឹប ដែល ជា សត្វ ជិត ផុត ពូជ រូប ខ្នែង ឯក រូប សត្វ នាគ រូប អ្នកលក់ នំបញ្ចុក រូប អ្នករែក ទឹក ត្នោត និង រូប ផ្លែ ត្រសក់ ផ្អែម ។
តាម ការបញ្ជាក់ ពី លោក ឃឹម ហ្វីណង់ តុក្កតា យក្ស ទាំងនេះ គឺជា រូប ត្លុក ទីង មោង កំប្លែង បែប សិល្បៈ ដែល មាន កាយវិការ បង្ក បរិយាកាស រីករាយ ដល់ អ្នកទស្សនា ។
ឯកឧត្តម វង្សី វិស្សុត ផ្ញើ លិខិត អបអរសារទរ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ ក្នុង ឱកាស ទទួលបាន គោរមងារ « បណ្ឌិត » ពី សាកលវិទ្យាល័យ ថុន បូរី នៃ ប្រទេស ថៃ
( ភ្នំពេញ ) ៖ ឯកឧត្តម វង្សី វិស្សុត រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី និង ជា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ផ្ញើ សារលិខិត អបអរសារទរ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ សមាជិក ព្រឹទ្ធសភា និង ជា អនុប្រធាន កិត្តិយស នៃ សមាគម មូលនិធិ សម្តេច តេជោ ដើម្បី អភិវឌ្ឍន៍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា ក្នុង ឱកាស ទទួលបាន គោរមងារ « បណ្ឌិត » ពី សាកលវិទ្យាល័យ ថុន បូរី នៃ ប្រទេស ថៃ ។
គួរ បញ្ជាក់ ថា អ៊ុយក្រែន កាលពី ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ បាន ចោទប្រកាន់ កងកម្លាំង រុស្ស៉ី ថា បាន សម្លាប់ រង្គាល ជន ស៉ី វិល នៅក្នុង ទីក្រុង ប៊ូចា (Bucha) នៃ ប្រទេស អ៊ុយក្រែន ដែល នាំឱ្យ មេដឹកនាំ បណ្ដា ប្រទេស លោក ខាងលិច បាន ប្រតិកម្ម ជាមួយនឹង ការខឹងសម្បារ ចំពោះ រូបភាព នៃ សាកសព នៅ ពាសពេញ ផ្លូវ នៃ ទីក្រុង ។ ប៉ុន្តែ រុស្ស៊ី បាន បដិសេធ ការចោទប្រកាន់ របស់ អ៊ុយក្រែន ៕
( កណ្ដាល ) ៖ លោកគ្រូ តឿ ដែល ត្រូវបាន សមត្ថកិច្ច ហៅ មក សួរ នាំ និង ធ្វើ កិច្ចសន្យា អប់រំ ក្រោយ បង្ហោះ វីដេអូ លើ បណ្ដាញ សង្គម បណ្ដាលឲ្យ មាន ការរិះគន់ រឿង សម្ដែង ស៉ី អាច ម៌ បាន សារភាព នៅ ចំពោះមុខ សមត្ថកិច្ច ថា វីដេអូ នោះ ខ្លួន គ្រាន់តែ សម្ដែង លេង ប៉ុណ្ណោះ ហើយ មិន បាន ស៉ី អាច ម៌ ពិតប្រាកដ នោះ ទេ ។
បុគ្គល ឈ្មោះ ជឹម សុភ័ក្រ ហៅ គ្រូ តឿ អាយុ ២៩ ឆ្នាំ បាន សារភាព ថា ខ្លួន ពិតជា បាន កាន់ អាច ម៌ គោ ប្រាកដ មែន ប៉ុន្ដែ គ្រាន់តែ ជា ការសម្ដែង ប៉ុណ្ណោះ លុះ នៅពេល ដាក់ ចូល មាត់ មិន មែន ស៉ី អាច ម៌ គោ នោះ ទេ គឺជា ស្ករ សូកូឡា ដែល ដាក់ នៅ ខាងក្រោម ដៃ ។ ស្ពាន ថ្ម ឆ្លងកាត់ ស្ទឹង សែន ខេត្ត កំពង់ធំ តម្លៃ ជិត ៧០ ម៉ឺន ដុល្លារ នឹង សម្ពោធ ឲ្យ ប្រើប្រាស់ នៅ ចុង សប្តាហ៍ នេះ
ស្ពាន ថ្ម នេះ បង្ក លក្ខណៈ ងាយស្រួល ដល់ សិស្សានុសិស្ស បាន ទៅ សិក្សា រៀនសូត្រ និង ប្រជាពលរដ្ឋ បាន ដឹក កសិផល ពី ត្រើយ ម្ខាង ទៅ ត្រើយ ម្ខាង ឬ ពី ស្រុក មួយ ទៅ ស្រុក មួយ ផងដែរ ។
លោកស្រី ឃួន ឃុន ឌី បាន លើកឡើង ថា « យើង បាន សុខ មកដល់ ថ្ងៃ នេះ ក៏ ដោយសារតែ កត្តា សុខ សន្តិភាព ដូច្នេះ បងប្អូន ទាំងអស់ ត្រូវ នាំគ្នា រក្សា សន្តិភាព ឱ្យ បាន យូរអង្វែង ជាមួយនឹង រដ្ឋាភិបាល ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បីឱ្យ ប្រទេស របស់ យើង មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ » ។
លោកស្រី បាន បន្ត ថា ដោយសារ ប្រទេសជាតិ មាន សុខ សន្តិភាព សេដ្ឋកិច្ច ជាតិ មាន ការរីកចម្រើន ធ្វើឱ្យ ប្រជាពលរដ្ឋ មាន ឱកាស បាន ធ្វើ បុណ្យ ទាន កើត ចេញ ពី ទឹកចិត្ត ជ្រះថ្លា របស់ ប្រជាពលរដ្ឋ អាជីវករ មន្រ្តី រាជការ កងកម្លាំង និង បងប្អូន ទី ជិត ទី ឆ្ងាយ មួយចំនួន យកមក កសាង ស្ពាន ថ្ម នេះ ឡើង ។ ជាមួយគ្នា នោះ ដែរ លោកស្រី បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម ថែរក្សា សុខ សន្តិភាព នេះ ដើម្បី បន្ត អភិវឌ្ឍ ប្រទេស ឲ្យបាន រីកចម្រើន ដល់ ទៀត ។
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ សិស្សានុសិស្ស សប្បាយ ចិត្ត រីករាយ យ៉ាង ខ្លាំង រក អ្វី ប្រៀបផ្ទឹម ពុំ បាន ដោយ ទទួលបាន ស្ពាន ថ្ម ដែល មិន ធ្លាប់ មាន ពីមុន មក ព្រោះ ធ្លាប់ តែ លំបាក ក្នុង ការធ្វើដំណើរ ពិសេស នៅ រដូវ វស្សា ។
ក្នុង នោះ ដែរ លោក អ៊ឹម ជុង គណៈកម្មការ អាចារ្យ វត្ត កំពង់ស្វាយ បាន លើកឡើង ថា ការសាងសង់ ស្ពាន នេះ គឺជា ការចូលរួម ជាមួយនឹង ពុទ្ធ បរិស័ទ តាម កម្លាំង សទ្ធា ដោយ បាន កសាង តាំងពី ឆ្នាំ ២០១៨ និង រួចរាល់ ជា ស្ថាពរ នៅ ឆ្នាំ ២០២១ ហើយ ការសាងសង់ ស្ពាន ថ្ម មាន ប្រវែង ១៥១.២ ម៉ែត្រ ទទឹង ៦.៥០ ម៉ែត្រ និង កម្ពស់ ៨ម៉ែត្រ ដោយ ចំណាយ ថវិកា អស់ ជិត ៧០ ម៉ឺន ដុល្លារ ។
លោក បាន បន្ត ថា នេះ គឺជា កម្លាំង សាមគ្គី មួយ មិន ដែល មាន ប្រជាពលរដ្ឋ ក៏ ដូចជា សហគមន៍ ណា ធ្វើ បាន ស្ពាន ដែល មាន តម្លៃ ច្រើន ហួស ប្រមាណ ហើយ ស្ពាន នេះ នឹង សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ថ្ងៃទី ៨- ៩ និង ទី១០ ខែមេសា ឆ្នាំ ២០២២ ខាងមុខ នេះ ក្រោម អធិបតីភាព លោកស្រី ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច ៕
ក្រសួង បរិស្ថាន និង រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង ចែក ស្បៀងអាហារ ដល់ កងកម្លាំងប្រដាប់អាវុធ តាម ខ្សែ បន្ទាត់ ព្រំដែន កម្ពុជា - ឡាវ
ក្នុង សកម្មភាព ដែល បាន ធ្វើឡើង នៅ ថ្ងៃទី ០៤ ខែ មេសា ឆ្នាំ ២០២២ លោក ស្វាយ សំអ៊ាង បាន នាំ បណ្តាំ សាកសួរ សុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច ក្រឡាហោម ស ខេង ជូន កងកម្លាំង ទាំងអស់ ដែល ជានិច្ចកាល សម្តេច តែងតែ គិតគូរ ពី សុខ ទុក្ខ គ្រប់ កាលៈទេសៈ ពិសេស ជិត ចូល ឆ្នាំ ប្រពៃណី ជាតិ ខ្មែរ មកដល់ នា ពេល ខាងមុខ នេះ ។
លោក បន្ត ថា ការនាំយក អំណោយ នៅ ពេល នេះ គឺ សរ បញ្ជាក់ ឲ្យ ឃើញ ពី ការផ្សារ ភ្ជាប់ រវាង កម្លាំង ជួរ មុខ ដែល មាន កងកម្លាំង កងទ័ព ក៏ ដូច កម្លាំង នគរបាល ខ្សែ បន្ទាត់ ព្រំដែន និង កម្លាំង ជួរ ក្រោយ ដែល មាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត ដោយ លោក អភិបាល ខេត្ត ជា ប្រធាន នឹង មន្ទីរ អង្គភាព ជា សេនាធិការ ឲ្យ រដ្ឋបាល ខេត្ត ។
លោក ស្វាយ សំអ៊ាង បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចខិតខំ របស់ បងប្អូន កងទ័ព ដែល បាន ពាក់ លី នូវ សាច់ ស្រស់ ឈាម ស្រស់ តស៊ូ រស់ នៅ ឆ្ងាយ ពី គ្រួសារ ដើម្បី ការពារ បូរណភាព ទឹកដី ជាតិ មាតុភូមិ ដោយ ក្នុង នោះ ដែរ លោក អភិបាល ខេត្ត បាន រំលឹក ដល់ កងកម្លាំង ទាំងអស់ ថា ភារៈកិច្ច កងកម្លាំង នៅ ពេល នេះ ក្រៅពី ការពារ បូរណភាព ទឹកដី កងកម្លាំង ទាំងអស់ ក៏ ត្រូវ បង្ក្រាប បទល្មើស ផ្សេង ៗ ដែល តែង កើត មាន នៅ តាម ខ្សែ ព្រំដែន ។
លោក ផៃ ប៊ុន ឈឿន ក៏ បាន លើកឡើង អំពី តម្លៃ នៃ សន្តិភាព ដោយ បាន បញ្ជាក់ ថា ប្រទេស កម្ពុជា មាន សន្តិភាព ដូច សព្វ ថ្ងៃ នេះ ដោយ បាន ការដឹកនាំ ដ៏ ឆ្លាតវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល តែ ស្វែងរក សន្តិភាព ជូន ជាតិ មាតុភូមិ និង បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា មាន ការអភិវឌ្ឍ ទៅ មុខ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។
( ភ្នំពេញ ) ៖ លោក សុខ សូកេន រដ្ឋលេខាធិការ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន លើកឡើង ថា ប្រទេស កម្ពុជា ត្រៀមខ្លួន ជានិច្ច សម្រាប់ ការធានា នូវ សន្តិភាព វិបុលភាព និង កិច្ចសហប្រតិបត្តិការ នៅក្នុង ទ្វីប អាស៊ី ។
តាង នាម ឱ្យ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ . លោក សុ សូកេន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ CICA ដែល ជា វេទិកា ពហុ ភាគី ដ៏ មាន ប្រសិទ្ធភាព មួយ ដែល ជំរុញ កិច្ចសហ ប្រតិបត្តិការ និង លើកកម្ពស់ សន្តិភាព សន្តិសុខ និង ស្ថិរភាព នៅក្នុង តំបន់ អាស៊ី និង សកលលោក ផងដែរ ។
លោក សុខ សូកេន ក៏ បាន អបអរសាទរ ដល់ ប្រទេស កាហ្សាក់ ស្ថាន ដែល បាន បន្ត អាណត្តិ របស់ ខ្លួន ជា ប្រធាន CICA សម្រាប់ ឆ្នាំ ២០២២ - ២០២៤ និង ការប្រារព្វ ខួប ៣០ ឆ្នាំ របស់ CICA ។ ទន្ទឹមនឹង នេះ កម្ពុជា បាន ផ្ញើ នូវ រឿង ព្រេង រួម ជាមួយនឹង រូបភាព និង សំណេរ ពី តំបន់ អេកូ ទេសចរណ៍ សំខាន់ ៗ របស់ កម្ពុជា ទៅកាន់ លេខាធិការដ្ឋាន CICA ដើម្បី បោះពុម្ព និង ផ្សាយ ពី ពិពិធភាព នៃ វប្បធម៌ ដ៏ សម្បូរបែប របស់ តំបន់ អាស៊ី សម្រាប់ អបអរសាទរ ពេលវេលា ដ៏ ឧត្តុង្គឧត្តម នេះ ។
ប្រធាន ប្រតិបត្តិ រូប នេះ ក៏ បាន អបអរសាទរ កម្ពុជា ក្នុង ការធ្វើជា ប្រធាន ប្ដូរ វេន អាស៊ាន ក្នុង ឆ្នាំ ២០២២ និង បាន សន្យា ថា នឹង ខិតខំ សហការ ជាមួយ កម្ពុជា បន្ថែម ទៀត ក្នុង គោលបំណង រួម ដើម្បី ចូលរួម ដោះស្រាយ បញ្ហា ប្រឈម រួម នៅ តំបន់ អាស៊ី ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ក៏ បាន ប្រគល់ ជូន នូវ លិខិត អញ្ជើញ ផ្លូវការ របស់ ប្រធានាធិបតី កាហ្សាក់ ស្ថាន ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ចូលរួម កិច្ចប្រជុំ កំពូល CICA លើក ទី៦ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១២ - ១៣ ខែតុលា ឆ្នាំ ២០២២ នៅ ទីក្រុង នូ- ស៊ុលតង់ សាធារណរដ្ឋ កាហ្សាក់ ស្ថាន ។
ជុំវិញ ការរកើនឡើង នៃ ករណី ឆ្លង ជំងឺ COVID-19 យ៉ាង គំហុក នេះ អាជ្ញាធរ ចិន បាន ប្រកាស កាលពី ល្ងាច ថ្ងៃចន្ទ ដើម សប្ដាហ៍ នេះ ថា វិធានការរឹតត្បឹត បន្ថែម ទៀត នឹង ត្រូវបាន អនុវត្ត លើ បណ្តាញ ដឹកជញ្ជូន ក្នុង ទីក្រុង ចាប់ពី ថ្ងៃអង្គារ នេះ តទៅ ខណៈ ខ្សែ រថភ្លើង ក្រោម ដី ជាច្រើន ខ្សែ បន្ថែម ទៀត ក៏ ត្រូវបាន ផ្អាក ផងដែរ ។
គួរ បញ្ជាក់ ថា ទីក្រុង សៀងហៃ បាន អនុវត្ត វិធានការបិទ ខ្ទប់ កាលពី សប្តាហ៍ មុន ខណៈ អាជ្ញាធរ កំពុង ប្រឹងប្រែង ព្យាយាម ទប់ស្កាត់ ការផ្ទុះឡើង នៃ ករណី ឆ្លង ជំងឺ COVID-19 ដ៏ ធំ បំផុត ដែល មិន ធ្លាប់ មាន មុន មក ។ វិធានការបិទ ខ្ទប់ ដែល ត្រូវបាន កំណត់ ដំបូង នឹង ត្រូវ បញ្ចប់ នៅ ថ្ងៃអង្គារ នេះ នៅក្នុង តំបន់ ភាគ ខាងលិច នៃ ទីក្រុង ប៉ុន្តែ នា ពេល ឥឡូវនេះ ត្រូវបាន បន្ត អនុវត្ត រហូតដល់ មាន ការជូនដំណឹង ជាថ្មី ។
នគរបាល កម្ពុជា - វៀតណាម ឯកភាព គ្នា បង្ក្រាប បទល្មើស គ្រប់ ប្រភេទ នៅ តាម ព្រំដែន និង ផ្ដល់ ព័ត៌មាន ឲ្យ គ្នា ទៅ វិញ ទៅ មក ពិសេស បទល្មើស គ្រឿងញៀន
( មណ្ឌលគិរី ) ៖ ស្នងការដ្ឋាន នគរបាល ខេត្ត មណ្ឌលគិរី និង ស្នងការដ្ឋាន នគរបាល ខេត្ត ដាក់ ឡាក់ នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម បាន បើក កិច្ចប្រជុំ បូកសរុប សហភាពការណ៍ និង លទ្ធផល កិច្ចសហប្រតិបត្តិការ បង្ការ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស នៅ តាម ព្រំដែន ប្រចាំ ឆ្នាំ ២០២០ - ២០២១ និង លើក ទិសដៅ បន្ដ ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២២ ដែល ភាគី កម្ពុជា ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ទោ ឡោ សុខា ស្នងការ នគរបាល ខេត្ត មណ្ឌលគិរី តំណាង នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ភាគី វៀតណាម ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ឡេ វិញ គ្វី ស្នងការ នគរបាល ខេត្ត ដាក់ ឡាក់ ។ កិច្ចប្រជុំ នេះ ធ្វើឡើង នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ដ មណ្ឌលគិរី ។
ជា កិច្ច ចាប់ផ្តើម បើក កិច្ចប្រជុំ លោក ឧត្តមសេនីយ៍ ទោ ឡោ សុខា បាន ថ្លែង បើក កិច្ចប្រជុំ និង បាន អនុញ្ញាតឲ្យ លោក វរសេនីយ៍ ឯក មុំ អុីន នាយ ការិយាល័យ សរុប និង វិភាគ ឡើង អាន របាយការណ៍ សង្ខេប ស្តីពី កិច្ចសហប្រត្តិបត្តិការ បង្ការ បង្រ្កាប បទល្មើស នៅ តាម ខ្សែ បន្ទាត់ ព្រំដែន រវាង ខេត្ត ទាំង ពីរ មណ្ឌលគិរី និង ខេត្ត ដាក់ ឡាក់ សាធារណ: រដ្ឋ សង្គម និយម វៀតណាម ។
ក្នុង ឆ្នាំ ២០២០ និង ឆ្នាំ ២០២១ កន្លងមក នេះ ដោយ សភាពការណ៍ ជំងឺ កូវីដ១៩ បាន ផ្ទុះឡើងវិវឌ្ឍន៍ ខ្លួន យ៉ាង ឆាប់រហ័ស និង យ៉ាង ស្មុគស្មាញ លើ ពិភពលោក យើង ទាំងមូល ដែល ជា ផ្នែក មួយ បាន ជះ ឥទ្ធិពល យ៉ាង ខ្លាំង ដល់ កិច្ចសហប្រតិបត្តិការ បង្ការ ទប់ស្កាត់ បទល្មើស រវាង ស្នងការ នគរបាល ខេត្ត មណ្ឌលគិរី និង ស្នងការដ្ឋាន នគរបាល ខេត្ត ដាក់ ឡាក់ ។
ភាគី ទាំង ពីរ បាន ឯកភាព គ្នា បន្ត អនុវត្ត ឲ្យ មាន ប្រសិទ្ធភាព តាម ផែនការសហប្រតិបត្តិការ ប្រចាំ ឆ្នាំ រវាង ក្រសួង មហាផ្ទៃ កម្ពុជា និង ក្រសួង នគរបាល វៀតណាម ដែល ថ្នាក់ដឹកនាំ ក្រសួង ទាំង ពីរ ជា ហត្ថលេខី ព្រមទាំង បន្ត អនុវត្ត យ៉ាង ម៉ឺងម៉ាត់ នៅ ខ្លឹមសារ នៃ កិច្ចសហប្រតិបត្តិការ បង ការទប់ស្កាត់ និង បង្ក្រាប បទល្មើស នានា នៅ តាម តំបន់ ព្រំដែន ដែល ស្នងការ នគរបាល ខេត្ត ទាំង ពីរ ឯកភាព គ្នា ។
បន្ត កិច្ច ប្រតិបត្តិការ ប្ដូរ ព័ត៌មាន អំពី សភាពការណ៍ សន្តិសុខ សណ្ដាប់ធ្នាប់ ព្រំដែន ដូចជា សកម្មភាព អានុភាព និង អង្កា ចាត់តាំង ជីវកម្ម អន្តរជាតិ ព្រមទាំង មុខ សញ្ញា ធ្វើ សកម្មភាព បំពាន ច្បាប់ របស់ ប្រទេស នីមួយ ៗ មិន តែ ប៉ុណ្ណោះ ភាគី កម្ពុជា បាន ស្នើសុំ ឲ្យ ភាគី វៀតណាម នៃ ខេត្ត ដាក់ ឡាក់ បន្ត និង សហការណ៍ ជួយ ទប់ស្កាត់ បទល្មេី ស ឆ្លង ដែន ខុស ច្បាប់ បទល្មើស សេដ្ឋកិច្ច ការជួញដូរ ស្រ្តី និង កុមារ និង បទល្មើស ការជួញដូរ គ្រឿងញៀន ឆ្លង ដែន ខុស ច្បាប់ រយៈពេល កន្លងមក នេះ ។
បើ តាម របាយការណ៍ ភាគី ទាំង ពីរ បាន សហការណ៍ គ្នា បាន ល្អ ជាមួយ សមត្ថកិច្ច ពាក់ព័ន្ធ ម្ចាស់ ការក្តាប់ បាន នៅ សភាពការណ៍ ដែល ពាក់ព័ន្ធ រកឃើញ ទាន់ ពេលវេលា និង បាន ជូន ដំណឹង គ្នា ទៅ វិញ ទៅ មក ទាន់ ពេលវេលា អំពី សភាពការណ៍ បទល្មើស ដើម្បី សហការណ៍ បង្ការ ទប់ស្កាត់ និង បង្រ្កាប ប្រកបដោយ ប្រសិទ្ធភាព និង ទាន់ ពេល វេលា ។
បន្ទាប់មក លោក ឧត្ត សេនីយ៍ ត្រី ឡេ វិញ គ្វី បាន ឯកភាព ទៅ តាម សំណើ ស្នើសុំ របស់ ភាគី កម្ពុជា និង បាន លើកឡើង ពី ចំណង សាមគ្គីភាព និង កិច្ចសហប្រត្តិបត្តិការ រវាង ស្នងការដ្ឋាន នគរបាល ខេត្ត មណ្ឌលគិរី និង មន្ត្រី នគរបាល នៃ ខេត្ត ដាក់ ឡាក់ ( សាធារណៈ រដ្ឋ សង្គម និយម វៀតណាម ) ជានិច្ច ជាកាល ភាគី ទាំង ពីរ តែងតែ មាន ទំនាក់ទំនង និង គ្នា បាន ល្អ ប្រសើរ ក្នុង ការទប់ស្កាត់ បទល្មើស នៅ តាម ខ្សែ បន្ទាត់ ព្រំដែន រវាង ខេត្ត ទាំង ពីរ ដែល ជា អ្នកភូមិ ផង របង តែ មួយ ។
ស្ថិត ក្នុង បរិយាកាស ស្និទ្ធស្នាល ប្រកបដោយ ភាព សាមគ្គីភាព មិត្តភាព និង មាន ការយោគយល់ គ្នា ទៅ វិញ ទៅ មក ភាគី ទាំង ពីរ បាន បន្ត និង ពិភាក្សា និង បាន ឯកភាព គ្នា លើក ទិសដៅ សហប្រត្តិបត្តិការ សម្រាប់ ឆ្នាំ ២០២០ - ២០២១ មាន ចំនួន ១២ ចំណុច សំខាន់ ៗ ក្នុង កិច្ចសហប្រត្តិបត្តិការ រវាង ស្នងការដ្ឋាន នគរបាល នៃ ខេត្ត ទាំង ពីរ និង បញ្ហា សេសសល់ មួយចំនួន ទៀត និង គ្រោង ធ្វើ នៅពេល ខាងមុខ បន្ត ទៀត ។
ប្រតិកម្ម របស់ លោក ម៉េដវ៉េ ដេវ កើត មាន ឡើង បន្ទាប់ពី បារំាំង នៅ ថ្ងៃ ថ្ងៃចន្ទ សប្ដាហ៍ នេះ បាន ប្រកាស ថា នឹង បណ្ដេញ មន្ត្រី ទូត រុស្ស៊ី ចំនួន ៣៥រូប ចេញ ពី ប្រទេស ដោយសារតែ សកម្មភាព របស់ ពួកគេ បាន ប្រឆាំង នឹង ផលប្រយោជន៍ សន្តិសុខ បារាំង ខណៈ អាល្លឺម៉ង់ ក៏ បាន ប្រកាស ដែរ ថា នឹង បណ្តេញ បុគ្គលិក ស្ថានទូត រុស្ស៊ី ចំនួន ៤០ នាក់ ចេញ ពី ប្រទេស ក្រោម ហេតុផល ផ្តល់ ព័ត៌មាន សម្ងាត់ ដល់ រដ្ឋាភិបាល ទីក្រុង មូស្គូ ។
ក្រុម មន្រ្តី អ៊ុយក្រែន បាន អះអាង ថា ជន ស៉ី វិល រាប់ រយ នាក់ ត្រូវបាន គេ បាញ់ សម្លាប់ នៅ ក្រុង ប៊ូឆា (Bucha) ក្បែរ រដ្ឋធានី កៀវ ខណៈ ក្រុង មួយ នេះ ទើបតែ ត្រូវបាន កងកម្លាំង អ៊ុយក្រែន ដណ្តើម បាន មកវិញ ពី កងទ័ព រុស្ស៉ី ។ ឆ្លើយតប ចំពោះ ការស្លាប់ យ៉ាង រង្គាល បែប នេះ អាមរិក និង អឺរ៉ុប កំពុង ពិចារណា ដាក់ទណ្ឌកម្ម កាន់តែ ធ្ងន់ បន្ថែម ទៀត ទៅ លើ ប្រទេស រុស្ស៉ី ។ យ៉ាងណា ក្តី ខាង ទីក្រុង មូស្គូ បាន ចេញមុខ ច្រានចោល ការចោទប្រកាន់ ពាក់ព័ន្ធ នឹង ករណី ក្រុង Bucha ។
