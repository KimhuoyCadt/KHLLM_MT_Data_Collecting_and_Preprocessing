( បន្ទាយមានជ័យ ) ៖ នា ព្រឹក ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២២ ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន និង ជា អគ្គ លេខាធិការដ្ឋាន សមាគម អតីត យុទ្ធជន កម្ពុជា រួម ជាមួយ លោក អ៊ុ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ និង លោក ខេង ស៊ុម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាន ជួប សំណេះសំណាល និង សួរសុខទុក្ខ ជាមួយ សមាជិក អតីត យុទ្ធជន ។
នា ឱកាស នោះ ទេសរដ្ឋមន្រ្តី គន់ គីម បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ជូន ដល់ អតីត យុទ្ធជន ជាពិសេស បាន ផ្តាំផ្ញើ ដល់ អតីត យុទ្ធជន ទាំងអស់ បន្ត អនុវិធានការ សុខាភិបាល និង ទៅ ចាក់ វ៉ាក់សាំង ដូស ជំរុញ ឱ្យ បាន គ្រប់ ៗ គ្នា ។
ទេសរដ្ឋមន្រ្តី គន់ គីម បាន ថ្លែងអំណរគុណ អភិបាល ខេត្ត និង ជា ប្រធាន កិត្តិយស សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត ដែល តែង យកចិត្តទុកដាក់ ជួយ ឧបត្ថម្ភ ថវិកា បរិភោគ ព្រមទាំង សម្ភារ ប្រើប្រាស់ ដល់ អតីត យុទ្ធជន ដែល មាន ជីវភាព ក្រីក្រ ជាពិសេស បាន ចុះ ប្រគល់ ថវិកា បេឡាម រណៈ សង្គ្រោះ ជូន ដល់ គ្រួសារ សព សមាជិក សមាគម បាន ទាន់ ពេល វេលា ។
ជាមួយគ្នា នេះ ទេសរដ្ឋមន្រ្តី គន់ គីម បាន ស្នើ ដល់ សមាគម អតីត យុទ្ធជន ខេត្ត ត្រូវ បន្ត ពិនិត្យ ស្ថានភាព រស់ នៅ របស់ អតីត យុទ្ធជន ខណៈ កាលពី ថ្មី ៗ នេះ ខេត្ត បាន ប្រគល់ បង្គ្រប់ ផ្ទះ និង ដី សម្បទាន សង្គមកិច្ច ជូន អតីត យុទ្ធជន ។
ទេសរដ្ឋមន្រ្តី បន្ត ថា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា តែងតែ បន្ត យកចិត្តទុកដាក់ ចំពោះ អតីត យុទ្ធជន គ្រប់ រូប ជាប្រចាំ ដូចជា ការផ្តល់ ដី សម្បទាន សង្គមកិច្ច ការសាងសង់ ផ្ទះ ការផ្តល់ របប សន្តិសុខ សង្គម ជាពិសេស ការពិនិត្យ សុខភាព ដោយ ឥត គិត ថ្លៃ និង ការទទួល ប្រាក់ សោធន និវត្តន៍ ជារៀងរាល់ ខែ ។
នា ឱកាស នោះ ទេសរដ្ឋមន្ត្រី ក៏ បាន នាំយក អំណោយ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ផ្តល់ ជូន អតីត យុទ្ធជន ពិការ ក១ និង ក២ ចំនួន ៤៤២ នាក់ ដោយ ក្នុង ម្នាក់ ៗ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម មី១ កេស ទឹកត្រី ៦ដប និង ថវិកា ១០ម៉ឺន រៀល និង នាយ ប៉ុស្តិ៍ រដ្ឋបាល ទាំង ៦៥ ឃុំ សង្កាត់ ក្នុង ម្នាក់ ទទួលបាន ថវិកា ៥ម៉ឺន រៀល ផងដែរ ៕
( សៀមរាប ) ៖ ផ្លូវ ៣៨ ខ្សែ ក្នុង ខេត្ត សៀមរាប បាន បញ្ចប់ ការសាងសង់ ជា ស្ថាពរ ទាំងស្រុង ហើយ ត្រូវ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ ក្រោម អធិបតីភាព របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២២ ស្អែក នេះ ។
ផ្លូវ ទាំង ៣៨ ខ្សែ នេះ គឺជា ចំណង ដៃ ថ្មី បន្ថែម ទៀត សម្រាប់ ប្រជាពលរដ្ឋ នៅ ខេត្ត សៀមរាប និយាយ ដោយឡែក និង និយាយ ជា រួម សម្រាប់ ប្រជាពលរដ្ឋ កម្ពុជា ទាំងមូល ដែល កើត ចេញ ពី ម្លប់ សន្ដិភាព ។ ស្ថានភាព ខេត្ត សៀមរាប ក៏ បាន ប្រែប្រួល ក្រោយ ទទួលបាន ផ្លូវ នេះ ទាំង ការវិនិយោគ និង វិស័យ ទេសចរណ៍ ជាដើម ។
ប្រជាពលរដ្ឋ នៅ ខេត្ត សៀមរាប បាន សម្តែង ការសាទរ និង ស្វាគមន៍ ដោយ ក្តីរីករាយ ចំពោះ សមិទ្ធផល ជា ប្រវត្តិសាស្ត្រ នេះ ។ សមិទ្ធផល នេះ បាន ប្រែក្លាយ និង លើកកម្ពស់ មុខមាត់ ក្រុង ទេសចរណ៍ វប្បធម៌ កាន់តែ មាន ភាពស្រស់បំព្រង ថែម ទៀត ។
បន្ថែម ពីលើ ក្ដីសប្បាយរីករាយ ពួកគាត់ ក៏ មិន ភ្លេច នូវ ការអរគុណ ជា អនេក ទៅកាន់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ដែល បាន បញ្ចេញ កញ្ចប់ ថវិកា ជាតិ សាងសង់ នូវ ផ្លូវ ៣៨ ខ្សែ នេះ ដែល ធ្វើឲ្យ ហេដ្ឋារចនាសម្ព័ន្ធ នៅក្នុង ខេត្ត សៀមរាប ធ្លាប់ តែ ជួប ការលំបាក ក្នុង ការធ្វើដំណើរ ប្រែក្លាយជាថ្មី ស្រឡាង និង កាន់តែ លើកម្ពស់ មុខមាត់ ខេត្ត មួយ នេះ ថែម ទៀត ផង ។ ពួកគាត់ មាន ជំនឿ ជឿជាក់ ថា តទៅ នេះ ខេត្ត សៀមរាប នឹង កាន់តែ មាន ភាពទាក់ទាញ បន្ថែម ទៀត ទាំង ការវិនិយោគ និង ទេសចរណ៍ ។
សូម ជម្រាប ថា ខ្សែ ផ្លូវ ទាំង ៣៨ ខ្សែ នេះ គឺជា ខ្សែ ផ្លូវ ដែល បាន សាងសង់ ឡើង ដោយ គិតគូរ យ៉ាង ល្អិតល្អន់ អំពី បទដ្ឋាន លក្ខណៈ បច្ចេកទេស និង គំនូស ប្លង់ នគរូបនីយកម្ម ផ្លូវ ការបែងចែក ខ្សែ ផ្លូវ អាទិភាព ស្រប ទៅតាម រូប សាស្ដ្រ ទីក្រុង ដែល មាន សង្គតិភាព នគរូបនីយកម្ម មាន មេត្រីភាព នឹង ទឹក ព្រៃឈើ និង ប្រាសាទ បុរាណ៍ និង ស្រប ជាមួយ ប្លង់ គោល ប្រើប្រាស់ ដី ក្រុង សៀមរាប និង ផែនការ មេអភិវឌ្ឍ ទេសចរណ៍ ខេត្ត សៀមរាប ចក្ខុវិស័យ ឆ្នាំ ២០៣៥ ។
គម្រោង នេះ ត្រូវបាន ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស ដោយ ក្រុមការងារ អន្តរ ក្រសួង សម្រាប់ ត្រួតពិនិត្យ និង វាយតម្លៃ ការងារ និង ក្រុមការងារ បច្ចេកទេស អន្តរ ក្រសួង ចំនួន ៩ក្រុម ទៀត ដែល ប្រចាំ ការ នៅ តាម ការដ្ឋាន ផ្ទាល់ ។ គម្រោង នេះ បាន ចំណាយ ថវិកា អស់ ជិត ១៥០ លាន ដុល្លារ អាមេរិក ជា កញ្ចប់ ថវិកា ជាតិ ដែល បាន អនុម័ត ផ្តល់ ដោយ រាជ រដ្ឋាភិបាល កម្ពុជា ៕ អ៊ុយក្រែន ចង់បាន លុយ របស់ រុស្ស៊ី ដែល ត្រូវបាន បង្កក ទុក នៅ បរទេស យកមក កសាង ប្រទេស របស់ ខ្លួន ឡើងវិញ បន្ទាប់ពី សង្គ្រាម
( កៀវ ) ៖ ទេសាភិបាល ធនាគារ កណ្តាល អ៊ុយក្រែន បាន និយាយ ថា ទ្រព្យសម្បត្តិ របស់ រុស្ស៊ី ដែល ត្រូវ បង្កក នៅ បរទេស គួរតែ ត្រូវ ប្រើប្រាស់ ដើម្បី កសាង អ៊ុយក្រែន ឡើងវិញ បន្ទាប់ពី សង្គ្រាម ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន BBC នៅ ថ្ងៃអាទិត្យ ទី០៣ ខែមេសា ឆ្នាំ ២០២២ ។
គួរ បញ្ជាក់ ថា ភាគ ច្រើន នៃ ទុន បម្រុង រូបិយប័ណ្ណ បរទេស ចំនួន ៦៣០ ពាន់ លាន ដុល្លារ អាមេរិក របស់ រុស្ស៊ី ដែល រក្សាទុក នៅ បរទេស ត្រូវបាន បង្កក ដោយ ប្រសិទ្ធភាព ដោយ ទណ្ឌកម្ម ពី សហរដ្ឋ អាមេរិក និង សហភាព អឺរ៉ុប ៕ ទីប្រឹក្សា សម្តេច សាយ ឈុំ ដឹកនាំ គ្រូពេទ្យ ចុះ ពិនិត្យ ព្យាបាល និង លាង មុខរបួស ជូន ស្ត្រី ក្រីក្រ រងគ្រោះ ដោយសារ ប្តី ជះ ទឹក អាស៊ីត នៅ សង្កាត់ បាក់ខែង ខណ្ឌ ជ្រោយ ចង្វារ
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២២ នេះ លោក ឡេង ប៊ុន តេង ទីប្រឹក្សា សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ និង ក្រុមការងារ ចុះ មូលដ្ឋាន ខណ្ឌ ជ្រោយ ចង្វារ បាន ដឹកនាំ គ្រូពេទ្យ ចុះ ពិនិត្យ ព្យាបាល និង លាង មុខរបួស ជូន ស្ត្រី ក្រីក្រ រងគ្រោះ ដោយសារ ប្តី ជះ ទឹក អាស៊ីត លើ និង មាន កូន ០៦ នាក់ នៅក្នុង បន្ទុក ស្ថិត នៅ ភូមិ ក្តី ចាស់ សង្កាត់ បាក់ខែង ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ។
ជាមួយគ្នា នោះ លោក បាន ក្រើន រំលឹក ដល់ កូន ៗ តូច ទាំងអស់ ត្រូវ រក្សា អនាម័យ ហូប ស្អាត រស់ នៅ អោយ បង្កើន ការប្រុងប្រយ័ត្ន ចំពោះ សុខភាព និង សូម គោរព អនុវត្ត តាម វិធានការ នានា របស់ រាជ រដ្ឋាភិបាល ក្រសួង សុខាភិបាល និង រដ្ឋបាល រាជធានី ភ្នំពេញ ជាពិសេស សូម បន្ត អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន តាម អនុសាសន៍ ដ៍ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នូវ វិធានការ ការពារ ខ្លួន ពី ជំងឺ កូវីដ - ១៩ គឺ « ៣កុំ និង ៣ការពារ » ដើម្បី ចូលរួម ទប់ស្កាត់ និង ការពារ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ផ្ញើ សារ គោរព ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ឱកាស ចម្រើន ជន្មាយុ គម្រប់ ៦៩ ឈាន ចូល ៧០ ឆ្នាំ
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ សូម គោរព ជូនពរ សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ឱកាស ដ៏ មង្គល សួស្ដី ប្រពៃ ថ្លៃថ្លា ចម្រើន ជន្មាយុ គម្រប់ ៦៩ ឈាន ចូល ៧០ ឆ្នាំ ។
ក្នុង របាយការណ៍ ថ្ងៃអាទិត្យ នេះ ដែរ ក្រសួង សុខាភិបាល វៀតណាម ក៏ បាន ប្រកាស ពី ករណី អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ៣៧ នាក់ បន្ថែម ទៀត ផងដែរ ។
ប្រធាន ក្រុមការងារ CPP ចុះ ជួយ ស្រុក អូរ រាំ ង៖ យុទ្ធនាការ ស្រោចស្រព វ៉ាក់សាំង បាន ធ្វើឱ្យ កាត់បន្ថយ ហានិភ័យ ធ្ងន់ធ្ងរ ពី ជំងឺ កូវីដ១៩ និង ធ្វើឱ្យ ពលរដ្ឋ អាច ជួបជុំគ្នា ជា លក្ខណៈ ទ្រង់ទ្រាយ ធំ
( ត្បូងឃ្មុំ ) ៖ លោក អ៊ាង សុផល្លែត ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក អូរ រាំង ខេត្ត ត្បូងឃ្មុំ បាន លើកឡើង ថា យុទ្ធនាការ ស្រោចស្រព វ៉ាក់សាំង ទាំង ដូស មូលដ្ឋាន និង ដូស ជំរុញ បាន ធ្វើឱ្យ សុខ មាលភាព របស់ ប្រជាជន អាច កាត់បន្ថយ ហានិភ័យ ធ្ងន់ធ្ងរ ពី ជំងឺ កូវីដ១៩ និង ធ្វើឱ្យ ប្រជាជន អាច ជួបជុំគ្នា ជា លក្ខណៈ ទ្រង់ទ្រាយ ធំ ដូចនេះ ក្នុង គន្លង ប្រក្រតី ថ្មី ។
ការលើកឡើង បែប នេះ របស់ លោក អ៊ាង សុផល្លែត បាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា ជា មេ ក្រុម បក្ស នៅ ឃុំ ព្រះធាតុ ចំនួន ៦៥៩ នាក់ នៅ ព្រឹក ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២២ នេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក សូរ ខន ឬ ទ្ធី គុណ អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ អំពិល តា ពក លោក រ័ត្ន វីរៈ ប្រធាន លេខាធិការដ្ឋាន និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ ព្រះធាតុ លោក លោកស្រី សមាជិក សមាជិកា ជាច្រើន រូប ទៀត ។
នា ឱកាស នោះ ដែរ ប្រធាន ក្រុមការងារ ក៏ បាន លើកឡើង ថា គណបក្ស ប្រជាជន កម្ពុជា គឺ តែងតែ នៅ រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ដោយ បាន ដោះស្រាយ ទុក្ខលំបាក ផ្សេង ៗ ជូន ប្រជាពលរដ្ឋ ជានិច្ច ។
ប្រធាន ក្រុមការងារ ក៏ បាន ផ្តាំផ្ញើរ ថា ក្នុង នាម ជា មេ ក្រុម បក្ស ជា សមាជិក សមាជិកា របស់ គណបក្ស ប្រជាជន កម្ពុជា សូម បន្ត កសាង អំពើ ល្អ ត្រូវ មាន កាយវិការ និង ពាក្យសំដី ប្រកបដោយ គុណធម៌ សីលធម៌ និង ដាស់តឿន ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ សច្ចៈ ធម៌ ជានិច្ច ។
ជាង នេះ ទៅ ទៀត ដើម្បី ធានា បាន នូវ សុខ សន្តិភាព ស្ថេរភាព និង ការអភិវឌ្ឍ រយៈពេង វែង សម្តេច ប្រធាន បាន គិតគូរ បេក្ខភាព លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្រ្តី នា ពេល អនាគត ស្រប តាម ឆន្ទៈ ប្រជាធិតេយ្យ ក្នុង ប្រទេស និង ការទទួលស្គាល់ ពី ឆាក អន្តរជាតិ ផងដែរ ៕
លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ មន្រ្តី គណបក្ស ១១៩ នាក់ នៅ ស្រុក លើក ដែក
លោកស្រី ក៏ បាន សម្តែង ការអរគុណ ចំពោះ ក្រុម យុទ្ធជន អាវ ស អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ដែល ជា កោសិកា ទាំងមូល ក្នុង សង្គម ដែល បាន ចូលរួមចំណែក ធ្វើឱ្យ យុទ្ធសាស្ត្រ នៃ ការប្រយុទ្ធ ប្រឆាំង ជាមួយ ជំងឺ កូវីដ១៩ ជា ជម្ងឺ រាតត្បាត ដ៏ សាហាវ ដែល សម្តេច តេជោ បាន ប្រៀប ទៅនឹង សង្គ្រាម រំដោះ ប្រទេស ។
ជាមួយគ្នា នេះ លោកស្រី បាន មានប្រសាស ន៏ គាំទ្រ ចំពោះ ទិសដៅ ការងារ អនុវត្ត បន្ត របស់ គណបក្ស ស្រុក និង បាន រំលឹក ផងដែរ ថា សុខ សុវត្ថិភាព នា ឱកាស ពេល បោះឆ្នោត គឺជា កត្តា សំខាន់ ណាស់ ដើម្បីឱ្យ អ្នកសង្កេតការណ៍ ជាតិ អន្តរជាតិ វាយតម្លៃ ថា ការបោះឆ្នោត ប្រព្រឹត្តទៅ ដោយ សេរី យុត្តិធម៌ និង គ្មាន អំពើហិង្សា ។
សម្តេច តេជោ ហ៊ុន សែន ឆ្លៀត វាយ កូនហ្គោល នៅ ខេត្ត សៀមរាប
( សៀមរាប ) ៖ នៅ ល្ងាច ថ្ងៃអាទិត្យ ទី០៣ ខែមេសា ឆ្នាំ ២០២២ នេះ ខណៈ ចុះ ពិនិត្យ សមិទ្ធផល នា នៅ ខេត្ត សៀមរាប សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ឆ្លៀត ពេល វាយ កូនហ្គោល នៅ ខេត្ត ទេសចរណ៍ មួយ នេះ ។
តាម បណ្តាញ សង្គម ហ្វេសបុក សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា៖ « ល្ងាច នេះ ឆ្លៀត វាយ កូនគោល នៅ ខេត្ត សៀមរាប ។ កម្លាំង ដូច អាយុ ជាង ៣០ ឆ្នាំ គ្រាន់តែ ទម្ងន់ កើនឡើង ជាង មុន បន្តិច ។ អរគុណ សន្តិភាព » ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន កំពុង មាន វត្តមាន នៅ ខេត្ត សៀមរាប ដោយ សម្តេច បាន អញ្ជើញ ចុះ ពិនិត្យមើល វឌ្ឍនភាព នៃ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ នៅ ថ្ងៃ នេះ ហើយ នឹង សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ហេដ្ឋ រចនាសម្ព័ន្ធ ផ្លូវ ៣៨ ខ្សែ ក្នុង ខេត្ត នេះ នៅ ថ្ងៃស្អែក ផងដែរ ៕ យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៣ ខែ មេសា៖ បង្ក្រាប ៨ករណី ឃាត់ខ្លួន ២១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៨ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៣ករណី . ដឹកជញ្ជូន រក្សាទុក ១ករណី និង ជួញដូរ ៤ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ២១ នាក់ ។
ប្រធាន សមាគម សហព័ន្ធ អភិវឌ្ឍន៍ ដីធ្លី និង សំណង់ កម្ពុជា ប្ដេជ្ញា ចូលរួម ធ្វើ កំណែទម្រង់ នៃ ការអភិវឌ្ឍ ដីធ្លី និង សំណង់ ឱ្យ បាន សមស្រប
( ភ្នំពេញ ) ៖ ប្រធាន សមាគម សហព័ន្ធ អភិវឌ្ឍន៍ ដីធ្លី និង សំណង់ កម្ពុជា លោក បណ្ឌិត ឡី សុភាព បាន ប្ដេជ្ញា ពង្រឹង ចំណេះដឹង វិជ្ជាជីវៈ របស់ សមាជិក សមាគម របស់ ខ្លួន ចូលរួម ធ្វើ កំណែទម្រង់ នៃ ការអភិវឌ្ឍ ដីធ្លី និង សំណង់ នៅ កម្ពុជា ឱ្យ បាន សមស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ដែល មាន ជាធរមាន ខណៈ ដែល លោក បាន មើលឃើញ ពី បញ្ហា ច្រើន ក្នុង សកម្មភាព ដីធ្លី បច្ចុប្បន្ន ។
ការប្ដេជ្ញា យ៉ាង ដូច្នេះ របស់ លោក បណ្ឌិត ឡី សុភាព ត្រូវបាន ធ្វើឡើង ក្នុង ពិធី ពិធី ប្រកាស បញ្ចូល សមាជិក សកម្ម នៃ សមាគម សហព័ន្ធ អភិវឌ្ឍន៍ ដីធ្លី និង សំណង់ កម្ពុជា ចំនួន ៣៧២ នាក់ ព្រមទាំង មាន ការប្រកាស តែងតាំង សមាជិកភាព គណៈកម្មការ ប្រតិបត្តិ សមាគម ចុះ មូលដ្ឋាន រាជធានី ខណ្ឌ ខេត្ត ចំនួន ១៥៤ នាក់ ប្រគល់ ពានរង្វាន់ បុគ្គល ឆ្នើម ចំនួន ១០នាក់ និង ប្រគល់ លិខិត សរសើរ ចំនួន ៤រូប នា រសៀល ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ នៅ ភោជនីយដ្ឋាន The Grand Terrace ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ។
លោក ថា កំណែទម្រង់ នេះ នឹង ធ្វើ ទៅដល់ ថ្នាក់ មូលដ្ឋាន តែម្ដង ជាក់ស្ដែង នា ថ្ងៃ នេះ សមាគម ក៏ បាន បញ្ចូល សមាជិក ដែល បាន យល់ដឹង អំពី បញ្ហា ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ នឹង វិស័យ ដីធ្លី និង សំណង់ ។
លោក បាន បន្ត ថា កំណែទម្រង់ ព្រម ៗ គ្នា នេះ ត្រូវតែ ប្រកបដោយ ចំណេះដឹង វិជ្ជាជីវៈ ព្រោះ ដើម្បី អភិវឌ្ឍ វិស័យ មួយ ត្រូវតែ មាន ធនធាន ប្រកបដោយ វិជ្ជាជីវៈ ដូច្នេះហើយ បានជា រាជ រដ្ឋាភិបាល បង្កើត នូវ គោល នយោបាយ សិក្សា ពេញ មួយ ជីវិត និង គោល នយោបាយ ជាតិ ស្ដីពី ការបណ្ដុះបណ្ដាល បច្ចេកទេស និង វិជ្ជាជីវៈ (TVET) ដែល សមាគម ក៏ បាន ប្រជុំ និង បណ្ដុះបណ្ដាល ដល់ មូលដ្ឋាន ថែម ទៀត ផង ។
លោក ក៏ បាន ណែនាំ ដល់ សមាជិក សមាគម ត្រូវ មាន ចរិយា ធម៌ ក្នុង ខ្លួន ដូចជា សច្ចៈ គឺ សេចក្ដីស្មោះត្រង់ ខន្តី គឺ សេចក្ដីអន់ ធន់ កត្តញ្ញូតា គឺ សេចក្ដីដឹង គុណ ត្រូវតែ ប្រកាន់ខ្ជាប់ នៅពេល ចេញ ទៅ ធ្វើការ ឬ ប្រកបរបរ អាជីវកម្ម ។ ហើយក៏ ត្រូវតែ ប្រកាន់ខ្ជាប់ នូវ ព្រហ្មវិហារ ធម៌ ទាំង ៤ រួម មាន « មេត្តា ក រុណា មុទិតា និង ឧបេក្ខា » មាន កិច្ចការ អ្វី ត្រូវ ជំនុំ គ្នា ពិភាក្សា គ្នា ដឹកនាំ ទៅ ដោយ គតិបណ្ឌិត ទីណា មាន ការប្រឹក្សា យោបល់ ទីនោះ មាន ការរីកចម្រើន ។
អ្នក ឧកញ៉ា ទ្រី ភាព៖ បក្ស ប្រជាជន កម្ពុជា ជា អ្នក រំដោះ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ពី ក្រញាំ បន ប្រល័យ ពូជសាសន៍ កូន ខ្មែរ មិន គួរ ភ្លេច
( កណ្តាល ) ៖ អ្នក ឧកញ៉ា បណ្ឌិត ទ្រី ភាព ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា អនុប្រធាន ទី២ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កណ្តាល ស្ទឹង បាន គូស រំលេច ថា សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ឥស្សរជនជា ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា គឺជា អ្នក ដែល បាន ដឹកនាំ ចលនា តស៊ូ រំដោះ យក មកវិញ នូវ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ត្រឡប់ មកវិញ កាលពី ៤៣ ឆ្នាំ មុន ។
អ្នក ឧកញ៉ា ទ្រី ភាព នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី០៣ ខែមេសា ឆ្នាំ ២០២២ ក្នុង ពិធី ជួបជុំ សំណេះសំណាល និង ពិសារ អាហាសាមគ្គី ជាមួយ សមាជិក សមាជិក និង ប្រជាពលរដ្ឋ ស្រឡាញ់ គាំទ្រ គណបក្ស ក្នុង ឃុំ ត្បែង ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល ដើម្បី អបអរសាទរ ថ្ងៃ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល ឈានចូល មកដល់ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
ក្នុង ពិធី នោះ អ្នក ឧកញ៉ា ទ្រី ភាព បាន លើកឡើង ថា ប្រជាពលរដ្ឋ ខ្មែរ ខកខាន ការដើរកម្សាន្ត ការជួបជុំ ក្នុង ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ អស់ រយៈពេល ពីរ ឆ្នាំ មកហើយ ដោយសារតែ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ ។ អ្នក ឧកញ៉ា បន្ថែម ថា រយៈពេល ពីរ ឆ្នាំ នេះ ទោះ មិន បាន ចូល ឆ្នាំ តែ ក៏ បាន រក្សា ជីវិត គង់ ពី ជំងឺ កូវីដ១៩ ដែល ផ្ទុយ ពី ការខកខាន ការចូល ឆ្នាំ ថ្មី ក្នុង របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។ ក្នុង របប នេះ កុំ ថា ឡើយ មិន បាន ប្រារព្ធ ពិធី បុណ្យ ចូល ឆ្នាំ សូម្បីតែ ជីវិត ក៏ រក្សា មិន បាន ផង ។
« ពីរ ឆ្នាំ មក នេះ បងប្អូន យើង អត់ បាន ប្រារព្ធ ពិធី បុណ្យ ចូល ឆ្នាំ ព្រោះ យើង ត្រូវ រួមគ្នា ជាមួយ សម្តេច តេជោ ជាមួយ រាជ រដ្ឋាភិបាល ការពារ ជំងឺ កូវីដ១៩ ។ យើង ខកខាន ប្រារព្ធ ពិធី គឺ ដើម្បី រក្សា ការពារ ជីវិត ពី ជំងឺ ផ្ទុយ ពី ការខកខាន បុណ្យ ចូល ឆ្នាំ ក្នុង របប ប្រល័យ ពូជសាសន៍ ដែល សូម្បីតែ ជីវិត ក៏ មិន គង់ ផង »។ នេះ ជា ការបញ្ជាក់ របស់ អ្នក ឧកញ៉ា ទ្រី ភាព ។
រំលឹក ដល់ របប ប្រល័យ ពូជសាសន៍ នេះ អ្នក ឧកញ៉ា បាន រំលឹក ពី ភាពយង់ ខ្នង ក្នុង របប នេះ ដែល លុបបំបាត់ រាល់ ពិធី បុណ្យ ជា ប្រពៃណី ជាតិ ខ្មែរ ដែល ជា របប ដ៏ ព្រៃផ្សៃ មិន អាច បំភ្លេច បាន ។ អ្នក ឧកញ៉ា បាន ផ្តាំផ្ញើ ដល់ សមាជិក សមាជិក និង អ្នក ស្រឡាញ់ គាំទ្រ បក្ស ឱ្យ ចងចាំ នូវ គុណ បំណាច់ របស់ ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន វាយ ផ្តួលរំលំ របប នេះ ហើយ រំដោះ អាយុជីវិត ប្រជាពលរដ្ឋ ព្រមទាំង ពិធី ប្រពៃណី ផ្សេង ៗ របស់ ខ្មែរ ត្រឡប់ មកវិញ ។
អ្នក ឧកញ៉ា ទ្រី ភាព បាន រំលឹក យ៉ាង ដូច្នេះ « យើង ត្រូវតែ ចងចាំ នូវ គុណូបការៈ របស់ សម្តេច តេជោ និង ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ។ ព្រោះតែ ការលះបង់ របស់ ពួកគាត់ ទើប រក្សា អាយុជីវិត ជីដូន ជីតា ឪពុក ម្តាយ របស់ យើង និង បាន រំដោះ មកវិញ ទាំង ពិធី បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ របស់ ខ្មែរ យើង ផងដែរ ។ យើង អ្នកកាន់ ព្រះពុទ្ធ សាសនា កាន់ សច្ច ទៀង ត្រង់ មិន ត្រូវ រ មិល គុណ បំភ្លេច នូវ ការលះបង់ ដ៏ ធំធេង មួយ នេះ ឡើយ » ។
អ្នក ឧកញ៉ា ទ្រី ភាព ក៏ បាន រំលឹក ដល់ ភាពជោគជ័យ លើ ការដឹកនាំ របស់ សម្តេច តេជោ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។ សម្រាប់ អ្នក ឧកញ៉ា ព្រោះតែ ភាពជោគជ័យ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នេះ ហើយ ទើប អនុញ្ញាតឱ្យ ពលរដ្ឋ ខ្មែរ ប្រារព្ធ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រកបដោយ ភាពសប្បាយរីករាយ នៅ ឆ្នាំ នេះ ។
សូម បញ្ជាក់ ថា នៅក្នុង ពិធី នា ព្រឹក មិញ នេះ អ្នក ឧកញ៉ា បណ្ឌិត ទ្រី ភាព បាន នាំយក នូវ អំណោយ ទេយ្យ ទាន ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ ប្រគេន និង ចែកជូន មន្ត្រី គណបក្ស ឃុំ គណបក្ស ស្រុក កងកម្លាំង និង សមាជិក បក្ស ព្រមទាំង ព្រះសង្ឃ ចំនួន ៧វត្ត ដែល សរុប ជា វិកា អស់ ប្រមាណ ៩៦.០០០.០០០ រៀល ៕ ផ្លែ ឈើ ថៃ ត្រូវបាន ដឹកជញ្ជូន ទៅកាន់ ប្រទេស ចិន តាមរយៈ ផ្លូវ ដែក ចិន - ឡាវ ជា លើក ដំបូង
តាម ការប៉ាន់ប្រមាណ របស់ ក្រុមហ៊ុន ដែល ទទួលបន្ទុក ដំណើរការ កំណាត់ ឡាវ នៃ ផ្លូវ ដែក ចិន - ឡាវ ត ទៅ ថ្ងៃ មុខ នឹង មាន កសិផល ថៃ កាន់តែ ច្រើន ដឹកជញ្ជូន ទៅកាន់ ប្រទេស ចិន ឬ ទ្វីប អឺរ៉ុប តាមរយៈ ផ្លូវ ដែក ចិន - ឡាវ ដែល រំលេច ថែម មួយ កម្រិត ទៀត ពី តួនាទី សំខាន់ របស់ ផ្លូវ ដែក ចិន - ឡាវ ក្នុង ការជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្នុង តំបន់ ៕
( ភ្នំពេញ ) ៖ លោក ឡី សុភាព ប្រធាន សមាគម សម្ពន្ធភាព អង្កការ - សមាគម និង វិស័យ ឯកជន នៅ កម្ពុជា និង ជា នាយក វិទ្យាស្ថាន អាជីវកម្ម អន្តរជាតិ បាន បង្ហាញ សាទរ និង គាំទ្រ គោល នយោបាយ ជាតិ ស្ដីពី ការអប់រំ បណ្តុះបណ្តាល ជំនាញ បច្ចេកទេស និង វិជ្ជាជីវៈ ហៅ កាត់ TVET និង គោល នយោបាយ ជាតិ សម្រាប់ ការសិក្សា ពេញ មួយ ជីវិត ខណៈ សមាគម និង វិទ្យាស្ថាន ទាំងឡាយ ដែល ស្ថិត ក្រោម ការដឹកនាំ និង គ្រប់គ្រង របស់ លោក ក៏ កំពុង ចូលរួម យ៉ាង សកម្ម ក្នុង ការអនុវត្ត តាម គោល នយោបាយ ជាតិ ទាំង ពីរ នេះ ផងដែរ ។
លោក បាន ប្រកាស សាទ រ និង គាំទ្រ ដល់ គោល នយោបាយ ជាតិ ស្ដីពី ការអប់រំ បណ្តុះបណ្តាល ជំនាញ បច្ចេកទេស និង វិជ្ជាជីវៈ ហៅ កាត់ TVET ជូន ដល់ សិក្ខាកាម ដែល ជា ធនធាន មិន អាច ខ្វះ បាន ដល់ ការអភិវឌ្ឍ ជាតិ មាតុភូមិ និង គាំទ្រ ដល់ គោល នយោបាយ សិក្សា ពេញ មួយ ជីវិត របស់ ប្រមុខ ថ្នាក់ដឹកនាំ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក បាន លើកឡើង ពី គោល នយោបាយ នៅក្នុង ថ្នាក់ មូលដ្ឋាន ជា គោល នយោបាយ ជាតិ មួយ ដែល មិន អាច ខ្វះ បាន ដែល នេះ បង្ហាញ ឲ្យ ឃើញ នូវ តម្រូវការ ធនធាន មនុស្ស ដែល ពោល ពេញ ដោយ ចំណេះដឹង វិជ្ជាជីវៈ ដែល មាន ដូចជា សិក្ខាកាម ទាំងអស់ ដែល បញ្ជប់ ជ័យលាភី និង ទទួលបាន វិញ្ញាបនបត្រ ទាំងអស់ នៅ ពេល នេះ ហើយ ទាំងអស់ គ្នា ត្រូវ ចងចាំ ថា ចូល ដើម្បី រៀន ចេញ ដើម្បី បម្រើ នៅ តាម មូលដ្ឋាន ។ ជ័យលាភី ទាំងអស់ នេះ ជា កិត្តិយស សម្រាប់ ជាតិ មាតុភូមិ ចូល ដើម្បី រៀន ចេញ ដើម្បី បម្រើ ។
បដិសេធ មិន ព្រម ធ្វើ កិច្ចចរចា ដាក់ពង្រាយ អាវុធ ធ្វើ សមយុទ្ធ យោធា ។ល ។ ទង្វើ របស់ អង់គ្លេស បាន បង្ហាញ ថា « ខួរក្បាល របស់ អង់គ្លេស នៅតែ ឋិត ក្នុង សម័យ អាណានិគម » ដដែល ដែល មិន បាន គោរព អធិបតេយ្យភាព របស់ ប្រទេស កំពុង អភិវឌ្ឍន៍ ទាល់តែសោះ ។ បញ្ហា អំពី ប្រជុំ កោះ Malvinas មិន ត្រឹមតែ ជា បញ្ហា របស់ ប្រទេស អាហ្សង់ទីន ប៉ុណ្ណោះ ទេ ថែមទាំង ក៏ ជា បញ្ហា ប្រកបដោយ លក្ខណៈ តំបន់ និង សកល ផងដែរ ។ បណ្តា ភាគី នានា គួរតែ ប្រឆាំង អង់គ្លេស ដែល នៅតែ អនុវត្ត អាណានិគម និយម លើ ដែនដី របស់ អាហ្សង់ទីន ជា បន្ត ទៀត ។
គិត រហូតដល់ បច្ចុប្បន្ន នេះ សម័យ ដែល ពួក អាណានិគម ធ្វើ តាម តែ ទំនើងចិត្ត បាន កន្លងផុត ទៅ ហើយ ។ អង់គ្លេស គួរតែ ដើរ ចេញ ពី សុបិន អាណានិគម អនុវត្ត សេចកី្ត សម្រេចចិត្ត របស់ អង្គការ សហ ប្រជាជាតិ ចាប់ផ្តើម ធ្វើ កិច្ចចរចា ជាមួយ អាហ្សង់ទីន ក្នុង ន័យ ដោះស្រាយ វិវាទ ដោយ សន្តិវិធី ។ ក្នុង បរិបទ នៃ ការធ្វើ ប្រជាធិបតេយ្យ ភាវូបនីយកម្ម ទំនាក់ទំនង អន្តរជាតិ នា ពេល បច្ចុប្បន្ន នេះ ប្រជុំ កោះ Malvinas មិន ត្រូវ ក្លាយជា ការឈឺចាប់ ជារៀងរហូត របស់ ប្រទេស អាហ្សង់ទីន ៕
( សៀមរាប ) ៖ លោក តឹករ៉េត សំរេច រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋលេខាធិការ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី បាន គូសបញ្ជាក់ ថា ព្រលានយន្តហោះ ខេត្ត សៀមរាប ដែល កំពុង ប្រើប្រាស់ នា ពេល បច្ចុប្បន្ន នេះ នឹង ត្រូវ ផ្អាក សកម្មភាព ក្រោយពេល ព្រលានយន្តហោះ ថ្មី ដាក់ ឱ្យ ដំណើរការ នៅ ចុង ឆ្នាំ ២០២៣ ។
ឆ្លើយតប នឹង សំណួរ របស់ អ្នក ព័ត៌មាន អង្គភាព ព័ត៌មាន Fresh News នា ព្រឹក ថ្ងៃអាទិត្យ ទី០៣ ខែមេសា ឆ្នាំ ២០២២ លោក តឹករ៉េត សំរេច ដែល មាន តួនាទី ជា ប្រធាន គណៈកម្មការ តម្រង់ ទិស សម្រាប់ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ បាន ឱ្យដឹង ថា អាកាសយានដ្ឋាន សៀមរាប ដែល កំពុង ប្រើប្រាស់ បច្ចុប្បន្ន មាន ចម្ងាយ តែ ប្រមាណ ២.៥០០ម៉ែត្រ ប៉ុណ្ណោះ ពី ប្រាសាទ អង្គរ ធំ ។ ចម្ងាយ នេះ ជា បច្ច័យ មិន ល្អ ហើយក៏ គំរាមកំហែង បង្ក ហានិភ័យ ដល់ ប្រាសាទ បុរាណ ផងដែរ ។
បើ តាម លោក តឹករ៉េត សំរេច ព្រោះតែ បញ្ហា នេះ ហើយ ទើប គណៈកម្មាធិការ អន្តរជាតិ ដើម្បី សម្របសម្រួល កិច្ច គាំពារ និង អភិវឌ្ឍន៍ រមណីយដ្ឋាន ប្រវត្តិសាស្ត្រ អង្គរ ហៅ កាត់ ថា ICC-Angkor បាន ជំរុញ ឱ្យ ពន្លឿន ការងារ សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ដែល ជា អាកាសយានដ្ឋាន ថ្មី ដើម្បី ដាក់ ឱ្យ ដំណើរការ ជំនួស អាកាសយានដ្ឋាន ចាស់ ។
បច្ចុប្បន្ន នេះ ក្រោម ការវិនិយោគ របស់ ក្រុមហ៊ុន ចិន ជាមួយ ទុន ប្រមាណ ៨៨០ លាន ដុល្លារ អាមេរិក អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ បាន និង កំពុង ដំណើរការ សាងសង់ លើ ផ្ទៃដី ប្រមាណ ជា ៧០០ ហិកតា ស្ថិត នៅក្នុង ភូមិ ក្រៀល ពង ឃុំ ពពេល និង ភូមិ ប្រវ៉ាល ឃុំ តា យ៉ែក ស្រុក សូទ្រនិគម ខេត្ត សៀមរាប ។ អាកាសយានដ្ឋាន នេះ មាន ចម្ងាយ ប្រមាណ ៥០ គីឡូម៉ែត្រ ពី ទីប្រជុំជន ក្រុង សៀមរាប និង ចម្ងាយ ៤០ គីឡូម៉ែត្រ ពីរ មណិយដ្ឋាន អង្គារ ដែល ចម្ងាយ នេះ មិន ធ្វើឱ្យ ប៉ះពាល់ ដល់ តំបន់ ការពារ បេតិកភណ្ឌ នោះ ទេ ។
ពាក់ព័ន្ធ ទីតាំង អាកាសយានដ្ឋាន មាន ផល ប៉ះពាល់ ដល់ ប្រាសាទ ដែរ ឬ យ៉ាងណា នោះ លោក តឹករ៉េត សំរេច បាន បញ្ជាក់ ដូច្នេះ « ទីតាំង នេះ យើង បាន ពិភាក្សា តាំងពី ដំបូង ឆ្នាំ ២០០៤. ២០០៥ មក ជំនាញ បុរាណវិទ្យា យូណេស្កូ គេ ថា កន្លែង ហ្នឹង ធ្វើ បាន ។ អ៊ីចឹង បាន យើង រៀបចំ កន្លែង ហ្នឹង » ។
លោក តឹករ៉េត សំរេច បាន អះអាង ថា ដំណើរការ សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ នឹង សម្រេច ទៅ តាម ផែនការគ្រោងទុក ដោយ មិន មាន ឧបសគ្គ អ្វី នោះ ឡើយ ។ ពាក់ព័ន្ធ អ្នកដំណើរ ចេញ ចូល អាកាសយានដ្ឋាន នេះ វិញ លោក តឹករ៉េត សំរេច បាន បង្ហាញ ក្តី រំពឹង ថា ក្រៅតែ ពី អ្នក អ្នកទេសចរ ហើយ នោះ ក៏ មាន អ្នក វិនិយោគ ចូលមក វិនិយោគ ក្នុង ខេត្ត សៀមរាប ផងដែរ ។
ក្នុង ឱកាស អញ្ជើញ ត្រួតពិនិត្យ វឌ្ឍនភាព នៃ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ នា ព្រឹក ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២២ សម្តេច តេជោ ហ៊ុន សែន បាន ហៅ វត្តមាន អាកាសយានដ្ឋាន លើ ទីតាំង ដី សមរភូមិ សង្គ្រាម នេះ ថា គឺជា ផ្លែ ផ្កា កើត ចេញ ពី សុខ សន្តិភាព និង ជា ផ្លែ ផ្កា កើត ចេញ ពី កិច្ចសហប្រតិបត្តិការ ល្អ រវាង កម្ពុជា និង ចិន ។
សម្តេច តេជោ ហ៊ុន សែន ថែម បាន ថ្លែង កោតសរសើរ ការវិនិយោគ របស់ ក្រុមហ៊ុន ចិន ថា ជា ការវិនិយោគ ដែល ផ្តល់ ប្រយោជន៍ ច្រើន សម្រាប់ កម្ពុជា ដោយ សម្តេច ប្រដូច ការវិនិយោគ របស់ ចិន ទៅនឹង ការយក ម្ស៉ៅ មក ធ្វើ នំ ជូន ប្រជាពលរដ្ឋ កម្ពុជា បរិភោគ ។
បើ តាម លោក តឹករ៉េត សំរេច ក្រៅតែ ពី ការវិនិយោគ អាកាសយានដ្ឋាន ហើយ នោះ ក្រុមហ៊ុន ក៏ នឹង វិនិយោគ តំបន់ ពាណិជ្ជកម្ម នៅក្បែរ ព្រលាន ហើយ គម្រោង ក៏ មាន សាងសង់ ផ្លូវ ល្បឿន លឿន សម្រាប់ ការធ្វើដំណើរ ចូលទៅ ក្រុង សៀមរាប ផងដែរ ។ លោក រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី ក៏ រំពឹង ដែរ ថា តាមរយៈ ការវិនិយោគ សាងសង់ ព្រលានយន្តហោះ នេះ នឹង ធ្វើឱ្យ អ្នក វិនិយោគ ក្នុង ស្រុក ចាប់អារម្មណ៍ មក វិនិយោគ នៅ តំបន់ ជុំវិញ ព្រលាន ដែល នឹង ប្រែក្លាយ តំបន់ ស្ងប់ស្ងាត់ មួយ នេះ ទៅជា តំបន់ ពាណិជ្ជកម្ម ដ៏ រស់រវើក ៕
លើស ពី នោះ ទៀត លោក ប៉ាន សូរស័ក្តិ បាន គូសបញ្ជាក់ ថា នៅពេល អ្នករកស៊ី លក់ អាហារ តាម ផ្លូវ ទាំងអស់ នាំគ្នា រៀបចំ អនាម័យ អាហារ របស់ ខ្លួន ដែល មាន អនាម័យ និង គុណភាព ល្អ នោះ វា នឹង នាំឲ្យ យើង ក្លាយជា ពលរដ្ឋ ម្នាក់ ដែល បាន ជួយ ប្រទេសជាតិ ក្នុង ការអភិវឌ្ឍន៍ ផងដែរ ។
បន្ថែម ពី នោះ ទៀត លោក ប៉ាន សូរស័ក្តិ បាន បញ្ជាក់ ថា ក្រសួង ពាណិជ្ជកម្ម ក៏ កំពុងតែ ជំរុញ លើ ការងារ ម្ហូប អាហារ នេះ ហើយ អ្នក រកស៊ី លក់ អាហារ ទាំងអស់ ក៏ ត្រូវតែ ចូលរួម ទាំងអស់ គ្នា ធ្វើ យ៉ាងណា ឲ្យ មាន ការរៀបចំ អនាម័យ ខ្ពស់ ប្រកបដោយ គុណភាព និង មាន តម្លៃ សមរម្យ ផងដែរ ។
រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន គូសបញ្ជាក់ ថា សុវត្ថិភាព ម្ហូប អាហារ គឺ ផ្នែក មួយ ដ៏ សំខាន់ ក្នុង ការទាក់ទាញ ភ្ញៀវ ទេសចរ ។
សូម បញ្ជាក់ ថា សេចក្ដីព្រាង ច្បាប់ ស្ដីពី សុវត្ថិភាព ម្ហូប អាហារ ត្រូវបាន សម័យ ប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី អនុម័ត ទាំងស្រុង កាលពី ថ្ងៃទី១ ខែមេសា ឆ្នាំ ២០២២ ។
លោក ប៉ាន សូរស័ក្តិ បាន ឲ្យដឹង ថា សេចក្ដីព្រាង ច្បាប់ ស្ដីពី សុវត្ថិភាព ម្ហូប អាហារ នេះ គឺជា លិខិត តុបករណ៍ ដ៏ សំខាន់ មួយ ទៀត របស់ រាជ រដ្ឋាភិបាល ដែល មាន ក្រសួង ពាណិជ្ជកម្ម ជា សេនាធិការ ដើម្បី ជួយ សម្រួល ដល់ បរិយាកាស ធុរកិច្ច នៅ កម្ពុជា ឲ្យ កាន់តែ ប្រសើរឡើង ។
លោក រដ្ឋមន្ត្រី បាន រំលឹក ថា សេចក្ដីព្រាង ច្បាប់ នេះ ត្រូវបាន ផ្ដួច ផ្ដើម តាក់តែង ឡើង ដោយ ក្រសួង ពាណិជ្ជកម្ម នៅ ឆ្នាំ ២០១៤ និង បញ្ចប់ ការរៀបចំ នៅ ឆ្នាំ ២០១៥ ហើយ នៅ ឆ្នាំ ២០១៦ សេចក្ដីព្រាង ច្បាប់ នេះ ត្រូវបាន បញ្ជូន ទៅ ប្រជុំ ដើម្បី ពិនិត្យ និង ពិភាក្សា កម្រិត បច្ចេកទេស នៅ ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី រហូត ឈាន ដល់ ការដាក់ ឆ្លង កិច្ចប្រជុំ អន្តរ ក្រសួង ដើម្បី ពិនិត្យ និង កែសម្រួល នៅ ឆ្នាំ ២០១៩ ។
អស់ រយៈពេល ៤ ឆ្នាំ តាមរយៈ កិច្ចពិភាក្សា ផ្ដល់ ធាតុ ចូល ដើម្បី កែសម្រួល ទាំង ក្នុង កិច្ចប្រជុំ អន្តរ ក្រសួង និង អន្តរ ក្រសួង ចង្អៀត ជាច្រើន លើក ទើប ឈានដល់ ការដាក់ ឆ្លង កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី នៅ ថ្ងៃទី១ ខែមេសា ឆ្នាំ ២០២២ ។
លោក ប៉ាន សូរស័ក្តិ បាន បញ្ជាក់ ថា សេចក្ដីព្រាង ច្បាប់ ស្តីពី សុវត្ថិភាព ម្ហូប អាហារ ពិតជា មាន សារៈសំខាន់ ណាស់ ក្នុង ការកំណត់ គោលការណ៍ ជា មូលដ្ឋាន ដើម្បី ជំរុញ ឲ្យ ផលិតផល ម្ហូប អាហារ ទាំងអស់ មាន សុវត្ថិភាព គុណភាព និង ស្រប តាម ស្តង់ដា កំណត់ សំដៅ ធានា កម្រិត នៃ ការការពារ អាយុជីវិត និង សុខភាព ប្រជាពលរដ្ឋ ព្រមទាំង ធានា បាន នូវ ប្រសិទ្ធភាព នៃ ការការពារ ផលប្រយោជន៍ អ្នកប្រើប្រាស់ និង រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ ជូន ប្រជាពលរដ្ឋ ៕
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ៩៧ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ២៣.៤១២ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្ដាល នា ថ្ងៃទី ២ ខែមេសា ឆ្នាំ ២០២២ បាន នាំយក ថវិកា ចំនួន ២ម៉ឺន ដុល្លារ ប្រគល់ ជូន ដល់ កាកបាទ ក្រហម កម្ពុជា ដើម្បី ជា ការអបអរសាទរ ខួប លើក ទី ១៥៩ ទិវា ពិភព កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២ ក្រោម ប្រធានបទ « ទាំងអស់ គ្នា រួមគ្នា ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដោះស្រាយ បញ្ហា ប្រឈម នានា និង បន្ត ពង្រឹង ភាពធន់ សហគមន៍ » ក្រោម អធិបតីភាព លោកស្រី អានី្ន សុខ អាន អនុប្រធាន កាកបាទ ក្រហម កម្ពុជា ។
លោកស្រី អានី្ន សុខ អាន បាន ថ្លែងអំណរគុណ ដល់ លោក ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្ដាល និង ប្រតិភូ ក្រុម ប្រតិបត្តិ សាខា ដែល បាន នាំយក មក នូវ ថវិកា ចំនួន ២ម៉ឺន ដុល្លារ ឧបត្ថម្ភ ជូន កបាល ក្រហម កម្ពុជា នៅ ពេល នេះ ។
កម្លាំង នគរបាល ខេត្ត ព្រះសីហនុ តាម បង្ក្រាប ចោរ ឆក់ ជនជាតិ វៀតណាម ម្នាក់ ក្រោយ ធ្វើ សកម្មភាព លើ ជនរងគ្រោះ និង ដកហូត បាន វត្ថុតាង មួយចំនួន
ឧត្តមសេនីយ៍ ទោ បាន ឱ្យដឹង ថា នា វេលា ម៉ោង ប្រហែល២២៖ ០០ នាទី នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២២ មាន ប្រជាពលរដ្ឋ ដែល ជា ម្ចាស់ កាបូប បាន រាយការណ៍ ប្រាប់ សមត្ថកិច្ច ថា៖ មាន ជនសង្ស័យ បាន ឆក់ កាបូប របស់ គាត់ នៅ ចំណុច ផ្លូវ ក្រោយ ផ្សារ ទំនើប Orange ស្ថិត ក្នុង សង្កាត់ ៤ ក្រុង - ខេត្ត ព្រះសីហនុ ។
លោក ស្នងការបាន បន្ត ថា បន្ទាប់ពី ទទួលបាន ព័ត៌មាន ពី ជនរងគ្រោះ កម្លាំង ល្បាត បាន ធ្វើ ការស្រាវជ្រាវ ចេញ ពួន ស្ទាក់ រហូត កម្លាំង ជំនាញ នៃ ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ ចាប់ បាន ជនសង្ស័យ ម្នាក់ នៅ ចំណុច ម្តុំ ចំការស្ពៃ ស្ថិត ក្នុង សង្កាត់ ៤ ក្រុង - ខេត្ត ព្រះសីហនុ ។
ជនរងគ្រោះ មាន ឈ្មោះ ផង់ ចាន់ ភេទ ប្រុស អាយុ ៣០ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ ជា មន្ត្រី គយ កំពង់ផែ ស្វយ័ត ខេត្ត ព្រះសីហនុ ស្នាក់ នៅ ភូមិ ៣ សង្កាត់ ១ ក្រុង - ខេត្ត ព្រះសីហនុ ។
បច្ចុប្បន្ន នេះ កម្លាំង ជំនាញ នៃ ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ កំពុង សាកសួរ បន្ត នីតិវិធី ជំនាញ ៕ លោក បណ្ឌិត អូស្មាន ហាស្សាន់ ជួប សំណេះសំណាល និង ជំរុញ សកម្មភាព គណៈ ចលនា សាសនិក ឥស្លាម ខេត្ត កែប ដើម្បី ត្រៀម បោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់
( កែប )៖ លោក បណ្ឌិត អូស្មាន ហាស្សាន់ សមាជិក គណៈកម្មាធិការ កណ្តាល របស់ គណបក្ស ប្រជាជន កម្ពុជា ជា បេសកជន ពិសេស របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈ ចលនា សាសនិក ឥស្លាម របស់ គណបក្ស ប្រជាជន កម្ពុជា នៅ ល្ងាច ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សកម្មជន និង ថ្នាក់ដឹកនាំ គណៈ ចលនា សាសនិក ឥស្លាម ខេត្ត កែប ដើម្បី ត្រៀម បោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២២ ខាងមុខ នេះ ។
ពិធី ខាងលើ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី សំ សារីន ប្រធាន គណៈកម្មាធិការ គណបក្ស ខេត្ត និង ជា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កែប . លោក លោកស្រី ដែល ជា ថ្នាក់ដឹកនាំ គណៈ ចលនា សាសនិក ឥស្លាម កម្ពុជា . សកម្មជន និង ថ្នាក់ដឹកនាំ គណៈ ចលនា សាសនិក ឥស្លាម របស់ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កែប ជាច្រើន រូប ផងដែរ ។
បន្ថែម ពី នេះ លោក បណ្ឌិត ក៏ បាន រំលឹក នូវ សមិទ្ធផល ដែល សហគមន៍ ឥស្លាម កម្ពុជា ទទួលបាន ពី រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន សហគមន៍ ឥស្លាម ទទួលបាន សិទ្ធិ ពេញលេញ ក្នុង ការរស់នៅ និង សិទ្ធិ ប្រតិបត្តិ សាសនា ។ លើស ពី នោះ ទៀត នោះ សហគមន៍ ឥស្លាម កម្ពុជា ក៏ មាន ឱកាស ចូលរួម បម្រើ ការងារ ជួរ រាជ រដ្ឋាភិបាល ជាច្រើន រូប ហើយ ក្នុង ឆ្នាំ ២០១៥ រដ្ឋាភិបាល ក៏ បាន ផ្តល់ ជូន សហគមន៍ ឥស្លាម កម្ពុជា នូវ គ្រូ ក្របខ័ណ្ឌ រដ្ឋ ចំនួន ១. ៥០០ នាក់ ផងដែរ ។
លោក បណ្ឌិត ក៏ បាន រំលឹក និង ថ្លែងអំណរគុណ ដល់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ថ្មី ៗ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី បាន ស្នេី រៀបចំ ឲ្យ មាន យ៉ាងហោចណាស់ អភិបាល រង ស្រុក - ខណ្ឌ និង អភិបាល រង ខេត្ត ម្នាក់ ដែល មាន សម្ថភាព សម្រាប់ មូលដ្ឋាន ដែល មាន សាសនិក ឥស្លាម រស់ នៅ ច្រេីន ដើម្បី ភាពងាយស្រួល ទំនាក់ទំនង ក្នុង សហគមន៍ និង សុខដុម រមណី សាសនា ។
ជាមួយគ្នា នោះ លោក បណ្ឌិត ក៏ បាន លើក ថា អង្គការ សហប្រតិបត្តិការ ឥស្លាម ហៅ កាត់ ថា OIC ដែល មាន ប្រទេស ៥៧ ប្រទេស ជា សមាជិក និង មាន ប្រជាជន ជាង ពីរ ពាន់ លាន នាក់ បាន កោតសរសើរ ពី ការដឹកនាំ ប្រទេស ដ៏ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដែល ធ្វើឲ្យ កម្ពុជា មាន សុខ សន្តិភាព សុខដុមរមនា និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ដូច សព្វ ថ្ងៃ នេះ ។
ក្នុង ឱកាស អញ្ជើញ ចុះ ពិនិត្យ វឌ្ឍនភាពអាកាសយានដ្ឋាន សៀមរាប - អង្គ រ ខេត្ត សៀមរាប សម្ដេច តេជោ ហ៊ុន សែន បាន អះអាង ច្បាស់ ៗ ថា កម្ពុជា មិន ល្ងង់ រហូតដល់ ឲ្យ ទឹកដី របស់ ខ្លួន ក្លាយជា ទីតាំង កងទ័ព បរទេស ខុសពី រដ្ឋធម្មនុញ្ញ នោះ ឡើយ ។
ការបញ្ជាក់ បែប នេះ របស់ សម្ដេច តេជោ ហ៊ុន សែន ធ្វើឡើង ដើម្បី កុំ ឲ្យ អ្នកវិភាគ មួយចំនួន ចេះតែ វិភាគ ដោយ គ្មាន មូលដ្ឋាន ច្បាស់លាស់ ឬ វិភាគ ឲ្យ តែ បាន ហៅ ថា អ្នកវិភាគ ពាក់ព័ន្ធ ដំណើរការ សាងសង់ អាកាសយានដ្ឋាន អន្ដរជាតិ សៀមរាប - អង្គរ ដែល ទទួល សិទ្ធិ សាងសង់ ដោយ ក្រុមហ៊ុន ចិន និង គម្រោង ផ្សេង ទៀត ដែល កម្ពុជា កំពុង ធ្វើការ ជាមួយ ភាគី ចិន ។
សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ បែប នេះ ថា « កម្ពុជា មិន ល្ងង់ រហូត ទៅដល់ ឲ្យ ទឹកដី របស់ ខ្លួន បោះ កងទ័ព បរទេស ខុសពី ធម្មនុញ្ញ របស់ ខ្លួន ហើយ យក ទ័ព បរទេស កងទ័ព ចិន មក ដាក់ ស្រុក ខ្មែរ ដើម្បី អី ។ យោធា បរទេស នៅ បាន ប៉ុន្ដែ នៅក្នុង ឋានៈ ជា អនុព័ន្ធ យោធា យើង អត់ ត្រូវការ ទីប្រឹក្សា យោធា បរទេស នៅ ស្រុក ខ្មែរ ទេ » ។
ព្រម ពេល ជាមួយគ្នា នេះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ ឆ្លៀត ផ្ដាំផ្ញើ ដល់ អ្នកវិភាគ ដែល ជា ជនជាតិ ខ្មែរ ឬ ខ្លះ មាន ជា ជនជាតិ បរទេស ប្រយ័ត្ន រង់ ការស្ដី បន្ទោស ពី សម្ដេច ក្នុង ករណី វិភាគ ខុស រឿង ពាក់ព័ន្ធ ព្រលានយន្ដហោះ នៅ ខេត្ត សៀមរាប នេះ ហើយ សម្ដេច សង្ឃឹម ថា អ្នកវិភាគ មិន វិភាគ ទៅ ជ្រុល ហួស រឿង អនុញ្ញាតឲ្យ មាន ការបោះ មូលដ្ឋាន ទ័ព បរទេស នៅ កម្ពុជា ពិសេស នៅពេល សាងសង់ ព្រលានយន្ដហោះ ថ្មី ម្ដង ៗ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ អំពី យុទ្ធសាស្ដ្រ យោធា ប្រាប់ ទៅ អ្នកវិភាគ ទាំងអស់ នោះ ថា ក្នុង ករណី យន្ដហោះ កងទ័ព បរទេស ចង់ បើក ប្រតិបត្តិការ យោធា នៅ កម្ពុជា មិន ចាំបាច់ អី ត្រូវ សាងសង់ អាកាសយានដ្ឋាន ថ្មី នោះ ទេ ពោល ប្រើប្រាស់ ទីតាំង ដែល មាន ស្រាប់ រួច បាត់ ទៅ ហើយ ប៉ុន្ដែ កម្ពុជា មិន មាន តម្រូវការ បែប នេះ ឡើយ ។
សម្ដេចក៏ បាន រំលឹក រឿង កាលពី ជួប ជាមួយ ឯក អគ្គ រដ្ឋទូត អូស្ដ្រាលី និង អនុព័ន្ធ យោធា អូស្ដ្រាលី កាលពី ថ្មី ៗ នេះ ដែរ ថា ក្នុង ជំនួប នោះ សម្ដេច បាន បញ្ជាក់ ទៅកាន់ ឯក អគ្គ រដ្ឋទូត អូស្ដ្រាលី ថា កម្ពុជា មិន ត្រូវការកងទ័ព បរទេស ហើយក៏ មិន ត្រូវការ ទីប្រឹក្សា យោធា បរទេស នោះ ដែរ កម្ពុជា អនុញ្ញាតឲ្យ តែ អនុព័ន្ធ យោធា នៅតែ ប៉ុណ្ណោះ ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី អាកាសយានដ្ឋាន អន្ដរជាតិ សៀមរាប - អង្គរ ស្វាគមន៍ គ្រប់ យន្ដហោះ បរទេស ទាំងអស់ ដែល ចង់ ចុះចត ក្នុង ក្របខ័ណ្ឌ ទេសចរណ៍ ដោយ គ្មាន ការរើង អើស ឬ កំណត់ ប្រទេស នោះ ទេ ។ ចំណុច នេះ សម្ដេច បាន បញ្ជាក់ ច្បាស់ ៗ ថា អាកាសយានដ្ឋាន ទាំងអស់ របស់ កម្ពុជា គឺ បម្រើ ឲ្យ វិស័យ ទេសចរណ៍ និង ដឹកជញ្ជូន ។
ការលើកឡើង បែប នេះ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី០៣ ខែមេសា ឆ្នាំ ២០២២ នេះ ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ពិនិត្យ វឌ្ឍនភាព នៃ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ស្ថិត នៅក្នុង ឃុំ ពពេល និង ឃុំ តា យ៉ែក ស្រុក សូទ្រនិគម ខេត្ត សៀមរាប ។
សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តល់ យោបល់ យ៉ាង ដូច្នេះ ថា៖ « មុន ចូល ឆ្នាំ ថ្មី ថ្ងៃ នេះ យើង មក ពិនិត្យ ហើយ សង្ឃឹម ឆ្នាំ ក្រោយ ថា ខ្ញុំ គិត ថា បន្ទាប់ពី ការចុះចត សាកល្បង រួចហើយ ខ្ញុំ ក៏ នឹង ធ្វើដំណើរ តាមរយៈ យន្តហោះ ពិសេស ចុះចត នៅ ហ្នឹង ហើយ ប្រហែល ពេល នោះ យល់ ល្អ យាង ព្រះមហាក្សត្រ ដើម្បី ព្រះអង្គ អាច ចុះចត បាន មុន សម្រាប់ ព្រលានយន្តហោះ សៀមរាប ថ្មី របស់ យើង » ។
ជាមួយគ្នា នេះ ដែរ ប្រមុខ នៃ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ថា វិនិយោគ នៅ ទីនេះ គ្រាន់តែ វិនិយោគ លើ ផ្លូវ ជាង ១១០ លាន ដុល្លារ គ្រាន់តែ ធ្វើ ផ្លូវ ដើម្បី ធានា ពី បញ្ហា នៅលើ ផ្លូវ សម្រាប់ ការចុះចត និង ការធ្វើដំណើរ ដល់ ទីក្រុង សៀមរាប ដូច្នេះហើយ ត្រូវ មាន ផ្លូវ ហាយ វេមួយ ចេញ ទៅ ផ្លូវ ជាតិ លេខ ៦ ដែល នឹង ត្រូវ ភ្ជាប់ ប្រមាណ ១៥គីឡូម៉ែត្រ ទៀត ។
ដើម្បីឱ្យ ដំណើរ ចុះចត និង ការធ្វើដំណើរកាន់តែ មាន ភាពងាយស្រួល សម្រាប់ ភ្ញៀវ ទេសចរ នានា នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ផ្តល់ យោបល់ ឱ្យ ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ស្នើសុំ ជំនួយ ឥត សំណង់ ទៅ មិត្ត ចិន តែ ម្តង ដើម្បី ជួយ ស្ថាបនា ផ្លូវ មួយ ខ្សែ នេះ តភ្ជាប់ ពី ព្រលានយន្ត សៀមរាប ថ្មី នេះ មក ទីក្រុង សៀមរាប ។
ទន្ទឹមនឹង នេះ ដែរ នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក៏ បាន ថ្លែង កោតសរសើរ អាជ្ញាធរ ខេត្ត សៀមរាប ដែល បាន ខិតខំ សម្របសម្រួល គ្រប់ បែបយ៉ាង ដើម្បី ដំណើរការ សាងសង់ ព្រលានយន្តហោះ អន្តរជាតិ សៀមរាប - អង្គរ ។ បន្ថែម ពី នេះ សម្រាប់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ជា ផ្លែ ផ្កា កើត ចេញ ពី សុខ សន្តិភាព និង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង កម្ពុជា និង ចិន ។
សៀមរាប ដែល ជា ខេត្ត ទេសចរណ៍ ដ៏ សំខាន់ របស់ ប្រទេស កម្ពុជា កំពុង លេចចេញ នូវ សមិទ្ធផល សំខាន់ ៗ ជាច្រើន ។ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ គ្រោង ចំណាយ ទុន វិនិយោគ ប្រមាណ ៨៨០ លាន ដុល្លារ អាមេរិក បាន ចាប់ផ្តើម សាងសង់ នៅ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២០ ហើយ គ្រោង នឹង បញ្ចប់ ការសាងសង់ នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ដោយ នឹង ដាក់ ឱ្យ ដំណើរការ សាកល្បង ជា លើក ដំបូង នៅ ខែតុលា ឆ្នាំ ២០២៣ ។ បច្ចុប្បន្ន ការសាងសង់ សម្រេចបាន ប្រមាណ ២២ ភាគរយ នៃ ផែនការសរុប ។
ដោយឡែក នៅ ថ្ងៃទី ០៤ ខែមេសា ស្អែក នេះ ខេត្ត សៀមរាប ក៏ នឹង សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ហេដ្ឋ រចនាសម្ព័ន្ធ ផ្លូវ ៣៨ ខ្សែ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ផងដែរ ។
ម្រោង កែលម្អ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ ក្នុង ក្រុង សៀមរាប ខេត្ត សៀមរាប ចំនួន ៣៨ ខ្សែ នេះ មាន ប្រវែង សរុប ១០៦. ៤២ គីឡូម៉ែត្រ ប្រើប្រាស់ ថវិកា ជាតិ សរុប ជាង ១៤៩. ២១៦.៥៩៥ ដុល្លារ អាមេរិក ។ ក្នុង នោះ ចំនួន ៩លាន ដុល្លារ អាមេរិក ចំណាយ លើ ការងារ ចាំបាច់ ក្នុង ការរៀបចំ ស្ថាបនា ប្រព័ន្ធ បង្ហូរ ទឹកភ្លៀង និង ទឹក កខ្វក់ ស្ថិត ក្រៅ គម្រោង សាងសង់ ខ្សែ ផ្លូវ ទាំង ៣៨ ខ្សែ ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ១៩៤ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២២
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គឺ ភាគ ច្រើន អត់ មួក ទូរស័ព្ទ បត់ ជែង ស្លាកលេខ និង ល្មើស សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត ល្មើស ល្បឿន ល្មើស សញ្ញា អត់ ប័ណ្ណ បើកបរ អត់ ស្លាកលេខ លើស ចំណុះ ខ្សែក្រវ៉ាត់ ស្រវឹង ទូរស័ព្ទ អាជីវកម្ម និង ឆៀក ដើម ។
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ទាំងនោះ មាន ៣៦ នាក់ ករណី នាំចូល ពី ក្រៅ ប្រទេស ហើយ រដ្ឋធានី វៀង ចន្ទន៍ ជា កន្លែង ដែល រាយការណ៍ ករណី ឆ្លង ក្នុង ស្រុក ច្រើន ជាង គេ គឺ ៧៣៧ ករណី ។ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដដែល ឡាវ ក៏ បាន រាយការណ៍ ពី អ្នកជំងឺ ស្លាប់ ថ្មី ៦នាក់ ផងដែរ ។
លោក ខ្វៃ អាទិត្យា៖ CPP របស់ ប្រជាជន បម្រើ ប្រជាជន រួមរស់ រួម ទុក្ខ ជាមួយ ប្រជាជន មិន ដែល រត់ ចោល ប្រជាជន ម្តង ណាមួយ ឡើយ
( ត្បូងឃ្មុំ ) ៖ លោក ខ្វៃ អាទិត្យា អនុប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ បាន បង្ហាញ ឱ្យ ឃើញ ថា គណបក្ស ប្រជាជន កម្ពុជា បម្រើ ប្រជាជន មិន រត់ចោល ប្រជាជន នៅ រួមរស់ រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន គ្រប់ កាលៈទេសៈ ។
ការលើកឡើង បែប នេះ របស់ លោក ខ្វៃ អាទិត្យា បាន ធ្វើ ក្នុង ឱកាស លោក ចូលរួម ជាមួយ លោក ស ស៊ីណា អនុប្រធាន្រុម ការងារ ចុះ មូលដ្ឋាន ឃុំ ព្រះធាតុ ទទួលបន្ទុក ភូមិ បឹងកាង និង ស្រែ មាន បាន ដឹកនាំ ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ ព្រះធាតុ និង បេក្ខជន ក្រុមប្រឹក្សា ឃុំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ជួប សំណេះសំណាល ជាមួយ ប្រធាន ក្រុម បក្ស នៅ តាម មូលដ្ឋាន ក្នុង ភូមិ បឹងកាង និង ភូមិ ស្រែ មៀន ក្នុង ឃុំ ព្រះធាតុ ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ នា ថ្ងៃទី ០២ ខែមីនា ឆ្នាំ ២០២២ ម្សិលមិញ ។
ក្នុង ឱកាស នេះ ដែរ លោក ខ្វៃ អាទិត្យា បាន ថ្លែងអំណរគុណ ចំពោះ ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម និង គាំទ្រ នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា ព្រោះ បាន ឃើញ ជាក់ស្តែង គណបក្ស ប្រជាជន កម្ពុជា ដែល ជា គណបក្ស តែ មួយ គត់ ដែល មាន វ័យ ចំណាស់ ខាង នយោបាយ និង មាន បទពិសោធន៍ ជាង ៧០ ឆ្នាំ មក ហើយ គឺ មាន គោល នយោបាយ ច្បាស់លាស់ ដឹកនាំ ប្រទេស ឈាន ទៅរក ភាពរីកចម្រើន លើ គ្រប់ វិស័យ ។
សូម បញ្ជាក់ ថា បន្ទាប់ពី ពិធី ជួប សំណេះសំណាល ជាមួយ ប្រធាន ក្រុម បក្ស នៅ តាម មូលដ្ឋាន ប្រតិភូ បាន ចុះ ជួប សួរ សុខទុក្ខ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត ជា ស្រ្តី មេម៉ាយ និង ជន ពិកា ចំនួន ៣គ្រួសារ និង បាន ឧបត្ថម្ភ គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា មួយ ចំនួន ៕ កិច្ចប្រជុំ តាម ប្រព័ន្ធ វីដេអូ និង ទូរស័ព្ទ ស្តីពី ផលិតកម្ម ប្រកបដោយ សុវត្ថិភាព ទូទាំង ប្រទេស ចិន បើក ធ្វើ នៅ ក្រុង ប៉េកាំង ដើម្បី អនុវត្ត ស្មារតី នៃ អនុសាសន៍ សំខាន់ របស់ លោក Xi Jinping
នៅ ថ្ងៃទី ៣១ ខែមីនា លោក Xi Jinping បាន ធ្វើជា អធិបតី ក្នុង កិច្ចប្រជុំ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ នៃ ការិយាល័យ នយោបាយ នៃ គណៈកម្មាធិការ មជ្ឈមិ បក្ស កុម្មុយនិស្ត ចិន ដើម្បី ស្តាប់ របាយការណ៍ អំពី សភាព ដោះស្រាយ បន្ទាន់ សិក្សា ស្រាវជ្រាវ និង រៀបចំ ចាត់ចែង ការងារ ជំហាន បន្ទាប់ ព្រម និង ថ្លែង សុន្ទរកថា គន្លឹះ ។
លោកស្រី ហ៊ុន ម៉ាណា អញ្ជើញ ប្រគល់ ផ្ទះ ទេវតា ៤ខ្នង ជូន ទុរគត ជន ជន ចាស់ជរា គ្មាន ទីពឹង និង សួរសុខទុក្ខ កុមារ នៅ មណ្ឌលកុមារ កំព្រា និង ប្រគេន ទេយ្យ វត្ថុ ដល់ វត្ត ចំនួន ៥ ក្នុង ខេត្ត ប៉ៃលិន
( ប៉ៃលិន) ៖ នៅ ព្រឹក ថ្ងៃទី ២ ខែមេសា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ លោកស្រី ហ៊ុន ម៉ាណា អគ្គ នាយិកា វិទ្យុ និង ទូរទស្សន៍ បាយ័ន និង ជា ប្រធាន កម្មវិធី ផ្ទះ ទេវតា បាន ដឹកនាំ ក្រុមការងារ អញ្ជើញ ចុះ ប្រគល់ ផ្ទះ ទេវតា ចំនួន ៤ខ្នង ជូន ទុរគត ជន ជន ចាស់ជរា គ្មាន ទីពឹង នៅក្នុង ខេត្ត ប៉ៃលិន ។ ពិធី នេះ ក៏ មាន កិត្តិយស ទទួលបាន ការអញ្ជើញ ចូលរួម ពី លោកស្រី បាន ស្រី មុំ អភិបាល នៃ គណៈអភិបាល ខេត្ត ប៉ៃលិន ផងដែរ ។
ផ្ទះ ទេវតា ដែល បាន ប្រគល់ ជូន ទុរគត ជន ជន ចាស់ជរា គ្មាន ទីពឹង នេះ រួម មាន៖
* ផ្ទះ ទី៣ ប្រគល់ ជូន លោកយាយ ពេជ្រ សក្តិ មាន អាយុ ៨៨ ឆ្នាំ រស់ នៅ ភូមិ ព្រៃ មង្គល សង្កាត់ អូតា វ៉ៅ ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន ។ ផ្ទះ នេះ ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិតិ្ត ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ព្រមទាំង បុត្រ និង ចៅ ៗ ។
* ផ្ទះ ទី៤ ត្រូវបាន ប្រគល់ ជូន លោក សឿន ម៉ុន អាយុ ៦១ ឆ្នាំ និង ប្រពន្ធ ឈ្មោះ ពោន ហ៊ន អាយុ ៤៤ ឆ្នាំ រស់ នៅ ភូមិ ភ្នំ ដំបង សង្កាត់ អូរ តាវ៉ៅ ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន ។ ផ្ទះ នេះ ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិតិ្ត ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ព្រមទាំង បុត្រ និង ចៅ ៗ ។
នៅក្នុង ឱកាស នោះ លោកស្រី ហ៊ុន ម៉ាណា បាន នាំយក នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន ដល់ លោកយាយ លោក តា និង ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម ។ លោកស្រី បាន លើកឡើង ថា ជានិច្ចកាល សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត តែង គិតគូរ អំពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ ទីកន្លែង និង គ្រប់ ពេលវេលា ។
បន្ទាប់ពី បាន ប្រគល់ ផ្ទះ ទេវតា រួចរាល់ នៅ ថ្ងៃ ដដែល នេះ លោកស្រី ហ៊ុន ម៉ាណា ក៏ បាន អញ្ជើញ ទៅ ប្រគេន ទេយ្យ វត្ថុ ដែល មាន ស្បៀងអាហារ គ្រឿង ឧបភោគ - បរិភោគ និង សម្ភារៈ ប្រើប្រាស់ ជាច្រើន មុខ របស់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ប្រគេន ដល់ ដល់ វត្ត ចំនួន ៥ នៅក្នុង ខេត្ត ប៉ៃលិន នេះ ដែល ពិធី ត្រូវបាន ធ្វើ រួមគ្នា នៅ វត្ត បុព្វា រាម ស្ថិត នៅ ភូមិ ទួល ខ្ពស់ ឃុំ ស្ទឹងត្រង់ ស្រុក សាលា ក្រៅ ខេត្ត ប៉ៃលិន ។
លោកស្រី បាន មានប្រសាសន៍ ថា ជានិច្ចកាល សម្តេច ទាំង ទ្វេ តែងតែ គិតគូរ អំពី ទុក្ខលំបាក របស់ ព្រះសង្ឃ គ្រប់ ព្រះអង្គ តាម ទី អារាម ក្នុង ប្រទេស កម្ពុជា ។ ការនាំយក ទេយ្យ វត្ថុ មក ប្រគេន ជូន នៅ ពេល នេះ អាច ជួយ សម្រាល នូវ ការលំបាក របស់ ព្រះសង្ឃ គ្រប់ អង្គ បាន មួយ រយៈ ផងដែរ ជាពិសេស នៅក្នុង វិបត្តិ កូវីដ - ១៩ នេះ ។
ថ្ងៃទី២ ខែមេសា ឆ្នាំ ២០២២ គឺជា ខួប ទី ៤០ នៃ ការផ្ទុះឡើង នៃ សង្រ្គាម ប្រជុំ កោះ Malvinas ។ ថ្វីត្បិតតែ សង្គ្រាម បាន បញ្ចប់ ទៅ ហើយ ប៉ុន្តែ សង្រ្គាម នេះ ជា ការចងចាំ ដែល មិន អាច បំភ្លេច បាន សម្រាប់ ប្រជាជន អាហ្សង់ទីន ជាពិសេស អតីត យុទ្ធជន អាហ្សង់ទីន ដែល បាន ចូលរួម ក្នុង សង្គ្រាម ។
លោក Ramon Lopez ប្រធាន សហព័ន្ធ អតីត យុទ្ធជនជាតិ អាហ្សង់ទីន ដែល មាន អាយុ ៥៩ ឆ្នាំ បាន ថ្លែង ថា បទពិសោធន៍ ដែល ខ្ញុំ ចងចាំ បំផុត គឺ ការប្រយុទ្ធ នៅ យប់ ថ្ងៃទី១ ខែឧសភា ។ ការទម្លាក់ គ្រាប់បែក ដោយ កងទ័ព ជើងទឹក អង់គ្លេស នៅ យប់ នោះ គឺ មិន នឹកស្មាន ដល់ ទេ សម្រាប់ ពួកយើង ហើយ ទ្រង់ទ្រាយ នៃ ការទម្លាក់ គ្រាប់បែក ក៏ មិន អាច បំភ្លេច បាន ដែរ ។
ប្រកាស បញ្ចូល សមាជិក ថ្មី បក្យ ប្រជាជន ជាង ៥០០ នាក់ នៅ ស្រុក ព្រែក ប្រសព្វ ខេត្ត ក្រចេះ
( ក្រចេះ ) ៖ លោក សរ ចំរ៉ុង សមាជិក គណៈកម្មការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ប្រធាន គណៈកម្មការ ទី១ រដ្ឋសភា ជា អ្នកតំណាងរាស្ត្រ មណ្ឌល ខេត្ត ក្រចេះ និង ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក ព្រែក ប្រសព្វ នា ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន ប្រកាស បញ្ចូល សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ឃុំ ជ្រោយ បន្ទាយ ចំនួន ៥២៣ នាក់ ថ្មី បន្ថែម ទៀត ដែល ស្ម គ្រ័ចិត្ត ចូលរួមរស់ ជាមួយ គណបក្ស ។
ក្នុង ឱកាស នោះ សរ ចំរុង បាន គូសបញ្ជាក់ ថា តាមរយៈ សមិទ្ធផល ដែល គណបក្ស បន្សល់ទុក រយៈពេល ជាង ៤០ ឆ្នាំ កន្លងមក នេះ គឺ ផ្ដើម ពី ជ័យជម្នះ ៧មករា ដែល គណបក្ស ប្រជាជន កម្ពុជា បាន សម្រេច នូវ ការផ្លាស់ប្តូរ សង្គម យ៉ាង ធំធេង ដោយ ពុំ អាច នឹកស្មាន ដល់ ។ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន នាំមក នូវ សន្តិភាព ឯកភាព ស្ថិរភាព សេរីភាព ប្រជាធិបតេយ្យ នីតិរដ្ឋ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ដែល ធ្វើឱ្យ ប្រជាជន គ្រប់ រូប បាន រស់ នៅ យ៉ាង សុខដុមរមនា ក្រោម ដំបូល នៃ រដ្ឋធម្មនុញ្ញ តែ មួយ ។
លោក បន្ថែម ទៀត ថា ការសម្រេចចិត្ត របស់ សមាជិក ដែល ទើប បញ្ចូល ថ្មី នេះ គឺជា សម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ បំផុត ព្រោះ គណបក្ស ប្រជាជន កម្ពុជា មាន គុណ បំណាច់ យ៉ាង ធំធេង ចំពោះ ប្រទេសជាតិ មាតុភូមិ ធានា បាន នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ប្រទេស ។ មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ទេ ដែល មិន រត់ចោល ប្រជាពលរដ្ឋ គឺ តែងតែ នៅ រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ រីឯ គណបក្ស ផ្សេង វិញ មិន ដែល ធ្វើ អ្វី សោះ បាន តែ ថា គឺ តែងតែ បង្ក អសន្តិសុខ ញុះញង់ បំពុល បរិយាកាស សង្គម ។
សន្តិភាព គឺជា មូលដ្ឋានគ្រឹះ នៃ ការអភិវឌ្ឍ ហើយ សម្តេច តេជោ ប្រមុខ ដឹកនាំ បាន បញ្ជាក់ ថា ទោះ ក្នុង តម្លៃ ណា ក៏ដោយ ក៏ មិន ត្រូវ ឲ្យ នរណា ម្នាក់ មក បំពាន និង មក បំផ្លាញ នូវ សុខ សន្តិភាព របស់ ប្រទេសជាតិ នោះ ដែរ គឺ ត្រូវ ប្រឆាំង ការពារ ដាច់ខាច ដូច្នេះ ប្រជាជន គ្រប់ រូប ត្រូវ ចូលរួមគ្នា ជាមួយ រាជ រដ្ឋាភិបាល និង គណបក្ស ក្នុង ការកសាង និង ថែរក្សា នូវ សុខ សន្តិភាព របស់ ប្រទេសជាតិ ឲ្យ បន្ត ឆ្ពោះទៅ មុខ ជារៀងរហូត ។
លោក ក៏ បាន ជំរុញ ដល់ អាជ្ញាធរ មូលដ្ឋាន ត្រូវ បន្ត ធ្វើ អំពើ ល្អ ជាមួយ ប្រជាពលរដ្ឋ ឲ្យបាន កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ព្រមទាំង ត្រូវ ផ្ដល់ សេវា សាធារណៈ ផ្សេង ៗ ឲ្យ បាន ឆាប់ រហ័ស និង ផ្សព្វផ្សាយ ឲ្យបាន ទូលំទូលាយ នូវ សេវា អត់ បង់ ប្រាក់ ជាពិសេស គោល នយោបាយ វ៉ាក់សាំង របស់ គណបក្ស ដើម្បីឲ្យ ប្រជាពលរដ្ឋ បាន យល់ដឹង ជ្រួតជ្រាប ជៀសវាង ការភាន់ច្រឡំ និង ចាញ់បោក ការឃោសនា ញុះ ញុង ពី ក្រុម ប្រឆាំង នឹង រាជ រដ្ឋាភិបាល ក៏ ដូចជា គោល នយោបាយ ដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
ក្នុង នោះ ដែរ លោក សរ ចំរុង បាន អំពាវនាវ ដល់ សមាជិក ក៏ ដូចជា ប្រជាពលរដ្ឋ ទាំងអស់ ដែល មិន ទាន់ បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ដូស ទី២និង ទី៣ សូម ប្រញាប់ ទៅ ទទួល ការចាក់ វ៉ាក់សាំង បន្ថែម ទៀត ដើម្ប បង្កើន ប្រព័ន្ធ ការពារ ជំងឺ កូវីដ - ១៩ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ ៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច៖ សុខ សន្តិភាព ជា មូលដ្ឋានគ្រឹះ នៃ សិទ្ធិ សេរីភាព និង ការអភិវឌ្ឍ រីកចម្រើន
( កំពត ) ៖ លោក ណុប ចាន់ ណារិន្ទ រដ្ឋលេខាធិការ ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន ថ្លែង ថា សុខ សន្តិភាព គឺជា មូលដ្ឋានគ្រឹះ នៃ សិទ្ធិ សេរីភាព និង ការអភិវឌ្ឍ រីកចម្រើន ។
លោក ថ្លែង នៅក្នុង ពិធី សម្ភោធ ផ្លូវ បេតុង មួយ ខ្សែ ប្រវែង ២០០០ ម៉ែត្រ តភ្ជាប់ ពី ផ្លូវ ជាតិ លេខ ៣ ឆ្ពោះ ចូល ទៅកាន់ វត្ត រួម នឹង សមិទ្ធផល នានា ក្នុង វត្ត សិរី ធានី ស្ថិត ក្នុង ភូមិ គគីរ ឃុំ កណ្ដោល ស្រុក ទឹក ឈូ ខេត្ត កំពត កាលពី រសៀល ថ្ងៃទី១ ខែមេសា ឆ្នាំ ២០២២ ។
លោក រដ្ឋលេខាធិការ ក៏ បាន កោតសរសើរ ចំពោះ សប្បុរសជន និង ប្រជាពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ទាំងអស់ ដែល បាន ចូលរួម បរិច្ចាគ ធនធាន ថវិកា ប្រកបដោយ សទ្ធា ជ្រះថ្លា ក្នុង ការកសាង នូវ សមិទ្ធផល នានា ក្នុង ទី អារាម វត្ត សេរី ធានី នេះ ដើម្បី រួមគ្នា ជ្រោង វិស័យ ព្រះពុទ្ធ សាសនា ដែល ជា សាសនា របស់ រដ្ឋ ឱ្យ មាន ការរីកចម្រើន បន្តបន្ទាប់ ។
នា ឱកាស នោះ មន្ត្រី ជាន់ ខ្ពស់ រូប នេះ ក៏ បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ដែល គ្រប់ អាយុ បោះឆ្នោត ត្រូវ ត្រៀមលក្ខណៈ សម្បត្តិ ដើម្បី ចូលរួម បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ឆ្នាំ ២០២២ ខាងមុខ ឱ្យ បាន គ្រប់ ៗ គ្នា ហើយ ត្រូវ ជ្រើសរើស តំណាង របស់ ខ្លួន ដែល តែងតែ ជួយ ទុក្ខ ធុរៈ និង ផ្សារភ្ជាប់ ជាមួយ ប្រជាពលរដ្ឋ និង មាន ការអភិវឌ្ឍ ក្នុង មូលដ្ឋាន មាន ការរីកចម្រើន ពី ដើម រៀង រហូតមក ។
ក្នុង ឱកាស នោះ គណៈអធិបតី ក៏ បាន ប្រគេន បច្ច័យ ដល់ ព្រះសង្ឃ សម្រាប់ បន្ត ការអភិវឌ្ឍ សមិទ្ធិផល នានា ក្នុង វត្ត បន្ត ទៀត ចំនួន ជាង ១ម៉ឺន ២ពាន់ ៤រយ ដុល្លារ ជា ការចូលរួម ពី សប្បុរសជន ក្នុង គ្រុប បណ្តាញ សង្គម អ្នក ឧកញ៉ា ប៉ោ សំអឿន និង លោក ឧកញ៉ា ថាច់ សុខ វិជ័យ ។
ទន្ទឹម នឹង នោះ ក៏ មាន សម្លៀកបំពាក់ ជា អំណោយ របស់ អ្នក ឧកញ៉ា ប៉ោ សំអឿន . សារុង ក្រមា និង ថា វិកា មួយ ចំនួន ជា ការចូលរួម ឧបត្ថម្ភ ពី លោក នួន ប៊ុន ថេត សម្រាប់ ចែកជូន ប្រជាពលរដ្ឋ លោកយាយ លោក តា និង ជូន ថវិកា ដល់ កងកម្លាំង ការពារ ក្នុង មូលដ្ឋាន ផងដែរ ៕
អគ្គ មេបញ្ជាការ សួរសុខទុក្ខ កងទ័ព នៅ តំបន់ ព្រំដែន ទិសទី១ ខេត្ត បន្ទាយមានជ័យ ដើម្បី អបអរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ
( បន្ទាយមានជ័យ )៖ នៅ ព្រឹក ថ្ងៃទី ០៣ ខែមេសា នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ បាន ដឹកនាំ ប្រតិភូ ចុះ សួរសុខទុក្ខ កងទ័ព នៅ តំបន់ ព្រំដែន ទិសទី១ ក្នុង ខេត្ត បន្ទាយមានជ័យ ដើម្បី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ ។
ក្នុង មតិ សំណេះសំណាល នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន តំណាង សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ស្មារតី លះបង់ របស់ ថ្នាក់ដឹកនាំ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ឈរ ជើង នៅ ទិសទី១ ខេត្ត បន្ទាយមានជ័យ ក្នុង កិច្ចខិតខំ អនុវត្ត ភារកិច្ចការពារ បូរណភាព ទឹកដី ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន បង្ហាញ ពី អត្ថន័យ ដ៏ ជ្រាលជ្រៅ និង សារៈសំខាន់ បំផុត នៃ ពាក្យ ថា “ អរគុណ សន្តិភាព ! អរគុណ នយោបាយ ឈ្នះ ឈ្នះ ! ដឹង គុណ ស្ថាបនិក មគ្គុទ្ទេស ក៏ ឯក និង ប្រតិបត្តិករ នយោបាយ ឈ្នះ ឈ្នះ ដែល នាំមក នូវ សន្តិភាព និង ការឯកភាព ជាតិ ពេញលេញ “ ។
« សន្តិភាព និង ស្ថិរភាព នយោបាយ គឺជា មូលដ្ឋានគ្រឹះ សម្រាប់ ការអភិវឌ្ឍ និង ការរស់នៅ ប្រកបដោយ ភាពសុខ ក្សេមក្សាន្ត របស់ ប្រជាជន ។ ដូច្នេះ កងកម្លាំង ត្រូវតែ ថែរក្សា ការពារ ឲ្យបាន គត់ មត់ មិន អនុញ្ញាតឲ្យ កម្លាំង ណាមួយ មក បំផ្លាញ បាន ឡើយ » ។ នេះ ជា ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ។
ពាក់ព័ន្ធ ដល់ ស្ថានកសរណ៍ បច្ចុប្បន្ន នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន លើកឡើង ពី វិបត្តិ ធ្ងន់ធ្ងរ នៃ ជំងឺ រាត ល្បាត សាកល កូវីដ - ១៩ ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខ មាលភាព អាយុជីវិត និង សេដ្ឋកិច្ច ជាតិ ។ ប្រឈម បញ្ហា នេះ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ យុទ្ធវីធី និង យុទ្ធសាស្ត្រ ទាន់ ហេតុការ ណ៏ ពិសេស ការស្វែងរក វ៉ាក់សាំង ជូន ដោយ ឥត គិត ថ្លៃ និង ការពារ បាន អាយុជីវិត ប្រជាពលរដ្ឋ ពី ជំងឺ ដ៏ កាច សាហាវ នេះ ។
( ប៉ៃលិន ) ៖ ក្នុង ពិធី ចុះ ជួប សំណេះសំណាល ជាមួយ លោក មេភូមិ អនុភូមិ និង សមាជិក ភូមិ ទាំង ១៦ នៅក្នុង ឃុំ ស្ទឹងត្រង់ ស្រុក សាលា ក្រៅ ខេត្ត ប៉ៃលិន នា ថ្ងៃទី ២ ខែមីនា ឆ្នាំ ២០២២ នេះ លោកស្រី បាន ស្រី មុំ អភិបាល ខេត្ត ប៉ៃលិន បាន ចង្អុលបង្ហាញ ការងារ ៤ចំណុច ដល់ មេភូមិ អនុភូមិ និង សមាជិក ភូមិ នៅ ឃុំ ស្ទឹងត្រង់ ស្រុក សាលា ក្រៅ អនុវត្ត ឲ្យបាន ល្អ ប្រសើរ ដើម្បី ប្រជាជន មូលដ្ឋាន ។
ការងារ ទាំងនោះ រួម មាន៖
* ទី ១៖ ក្តាប់ ឱ្យ បាន ពី ចំនួន ប្រជាពលរដ្ឋ ដែល ធ្វើ ចំណាកស្រុក ទៅ ធ្វើការ នៅ ក្រៅ ប្រទេស ។
* ទី ២៖ ក្តាប់ ឱ្យ បាន ពី ចំនួន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត ពិតប្រាកដ នៅក្នុង ភូមិ ដើម្បី ធ្វើ ការផ្ដល់ ជំនួយ ឧបត្ថម្ភ ដល់ ពួកគាត់ ។
* ទី ៣៖ ក្តាប់ ឲ្យបាន ពី ចំនួន ប្រជាពលរដ្ឋ ដែល មាន ឈ្មោះ ក្នុង បញ្ជី ឈ្មោះ បោះឆ្នោត និង ជំរុញ ណែនាំឲ្យ ពួកគាត់ ត្រៀម ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ គ្នា ។
* ទី ៤៖ ចូលរួម ឱ្យ បាន សកម្ម ក្នុង ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព របស់ រាជ រដ្ឋាភិបាល ដូចជា ការងារ ទប់ស្កាត់ ការលេង ល្បែងស៊ីសង គ្រប់ ប្រភេទ នៅក្នុង ភូមិ ការងារ ជួញដូរ ការប្រើប្រាស់ គ្រឿងញៀន នៅក្នុង ភូមិ ការចូលរួម អនុវត្ត ច្បាប់ ចរាចរណ៍ ឲ្យបាន ល្អ ប្រសើរ និង ការអប់រំ ណែនាំ កូន ចៅ ឱ្យ ប្រព្រឹត្ត នូវ អំពើ ល្អ កុំ ឱ្យ មាន ក្មេង ទំនើង ក្នុង ភូមិ ជាដើម ។
ការលើកឡើង បែប នេះ ក្នុង ឱកាស ដែល សម្ដេច តេជោ ហ៊ុន សែន អញ្ជើញ ពិនិត្យ វឌ្ឍនភាព នៃ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ស្ថិត នៅក្នុង ឃុំ ពពេល និង ឃុំ តា យ៉ែក ស្រុក សូទ្រនិគម ខេត្ត សៀមរាប នៅ ព្រឹក ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២២ នេះ ។
ជាមួយគ្នា នេះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន ជូន ពរ អ្នកធ្វើការ នៅ ទីនេះ បន្ដ ការងារ ប្រកដ ដោយ ជោគជ័យ ជាមួយនឹង ពុទ្ធ ពរ និង ទាំង ៥ប្រការ អាយុ វណ្ណៈ សុខៈ ពលៈ និង បដិភាណៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សូម បញ្ជាក់ ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ គ្រោង ចំណាយ ទុន វិនិយោគ ប្រមាណ ៨៨០ លាន ដុល្លារ អាមេរិក ។ អាកាសយានដ្ឋាន នេះ បាន ចាប់ផ្តើម ដំណើរការ សាងសង់ នៅ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២០ ហើយ គ្រោង ប្រើ រយៈពេល សាងសង់ សរុប ចំនួន ៣៦ ខែ ឬ ៣ ឆ្នាំ ដោយ បាន ប្រើប្រាស់ កម្មករ ប្រមាណ ជាង ១.០០០ នាក់ ក្នុង នោះ ៧០ ភាគរយ ជា ពលករ ខ្មែរ ។
តាម គម្រោង អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ គ្រោង នឹង បញ្ចប់ ការសាងសង់ នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២៣ និង ដំណើរការ សាកល្បង ជា លើក ដំបូង នៅ ខែតុលា ឆ្នាំ ២០២៣ ។ បច្ចុប្បន្ន ការសាងសង់ សម្រេចបាន ប្រមាណ ២២ ភាគរយ នៃ ផែនការ សរុប ។
អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ជា ប្រភេទ អាកាសយានដ្ឋាន អន្តរជាតិ កម្រិត / លំដាប់ថ្នាក់ 4E ត្រូវបាន សាងសង់ ឡើង លើ ផ្ទៃដី ទំហំ ៧០០. ០៦ ហិកតា ។
ប្រមុខ ដឹកនាំ កំពូល រាជ រដ្ឋាភិបាល កម្ពុជា ថ្លែង បែប នេះ ក្នុង ឱកាស អញ្ជើញ ពិនិត្យ វឌ្ឍនភាព នៃ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ នៅ ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២២ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី មានប្រសាសន៍ បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « សូម ក្រុម អ្នកវិភាគ ទាំងឡាយ តិច មាន ការវិភាគ ថា អា នេះ ជា មូលដ្ឋាន ចុះ យន្តហោះ ចិន ។ កុំ នាំគ្នា វិភាគ អាធន់ ហ្នឹង ណា ! បើ គេ ចង់ ចុះ និយាយ ឲ្យ ត្រង់ គេ ចុះ នៅ ឯណា ក៏ បាន ដែរ ។ បើ គេ ចង់ ចុះ ឧបមាថា គេ បើក ប្រតិបត្តិការ យោធា គេ ចុះ នៅ ឯណា ក៏ បាន ដែរ ។ សង្ឃឹម ថា អ្នកវិភាគ ឬ អ្នកធ្វើ អត្ថាធិប្បាយ ចាត់ទុក ថា អាកាសយានដ្ឋាន នេះ ជា ផ្នែក មួយ នៃ ការពង្រឹង សមត្ថភាព យោធា ចិន នៅ ក្រៅ ប្រទេស នៅក្នុង ប្រទេស កម្ពុជា នេះ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ទៀត ថា កម្ពុជា មិន ត្រូវការកងទ័ព បរទេស នោះ ទេ គឺ ត្រូវការ តែ អ្នកទេសចរ បរទេស តែ ប៉ុណ្ណោះ ។ សម្តេច តេជោ ហ៊ុន សែន បាន បន្ត ថា កម្ពុជា មិន ល្ងង់ រហូត ទៅដល់ ឱ្យ ទឹកដី ក្លាយជា ទីតាំង ទ័ព បរទេស ខុសពី រដ្ឋធម្មនុញ្ញ នោះ ឡើយ ។
អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ គ្រោង ចំណាយ ទុន វិនិយោគ ប្រមាណ ៨៨០ លាន ដុល្លារ អាមេរិក ។ អាកាសយានដ្ឋាន នេះ បាន ចាប់ផ្តើម ដំណើរការ សាងសង់ នៅ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២០ ហើយ គ្រោង ប្រើ រយៈពេល សាងសង់ សរុប ចំនួន ៣៦ ខែ ឬ ៣ ឆ្នាំ ដោយ បាន ប្រើប្រាស់ កម្មករ ប្រមាណ ជាង ១.០០០ នាក់ ក្នុង នោះ ៧០ ភាគរយ ជា ពលករ ខ្មែរ ។
តាម គម្រោង អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ គ្រោង នឹង បញ្ចប់ ការសាងសង់ នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២៣ និង ដំណើរការ សាកល្បង ជា លើក ដំបូង នៅ ខែតុលា ឆ្នាំ ២០២៣ ។ បច្ចុប្បន្ន ការសាងសង់ សម្រេចបាន ប្រមាណ ២២ ភាគរយ នៃ ផែនការសរុប ។
យោង តាម អាជ្ញាធរ ប្រេស៉ីល មនុស្ស ១៤៤ នាក់ ត្រូវបាន ជួយ សង្រ្គោះ ចេញ ពី តំបន់ រង ការប៉ះពាល់ ទៅកាន់ ទី សុវត្ថិភាព ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ខណៈ ប្រជាជន សរុប ៧០ គ្រួសារ ពុំ មាន កន្លែង ជ្រកកោន ដែល ជា ហេតុ នាំវ ឱ្យ អាជ្ញាធរ ជួយ ផ្តល់ ទីកន្លែង ស្នាក់ នៅ បណ្តោះអាសន្ន សម្រាប់ ពួកគេ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា ការវិនិយោគ លើ ព្រលានយន្តហោះ ដែល កំពុង ដំណើរការ ទាំង៣ គឺ រាជ រដ្ឋាភិបាល កម្ពុជា មាន ការចូលរួម ក្នុង ចំណែក ទុន ដ៏ ធំ មួយ ចូលរួម ជាមួយ ក្រុមហ៊ុន បារាំង បង្កើត បានជា សមិទ្ធផល សម្រាប់ បម្រើ សេចក្តីត្រូវការ របស់ ប្រជាពលរដ្ឋ ។ ដោយឡែក សម្រាប់ ការវិនិយោគ ព្រលានយន្តហោះ សៀមរាប ថ្មី នេះ គឺជា ការវិនិយោគ ទាំងស្រុង ដោយ ក្រុមហ៊ុន ចិន ដែល មាន ទុន ជិត ១ ពាន់ លាន ដុល្លារ អាមេរិក ខណៈ រាជ រដ្ឋាភិបាល កម្ពុជា ចូលរួម ផ្តល់ ដី ប៉ុណ្ណោះ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន បន្ថែម ថា ដោយសារ ព្រលានយន្តហោះ សៀមរាប ដែល កំពុង ដំណើរការ បច្ចុប្បន្ន ស្ថិត នៅក្នុង ការគ្រប់គ្រង ដោយ បារាំង ដូច្នេះ រាជ រដ្ឋាភិបាល ត្រូវ ផ្តល់ សំណង សមរម្យ មួយ ដល់ ក្រុមហ៊ុន បារាំង នៅពេល ព្រលានយន្ត សៀមរាប ថ្មី ដំណើរការ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ទៀត ថា ការសម្រេច សាងសង់ ព្រលានយន្តហោះ ថ្មី នេះ ដើម្បី ឆ្លើយតម តម្រូវ ការចាំបាច់ នៃ ការអភិវឌ្ឍន៍ ក្នុង ការទទួល នូវ យន្តហោះ ធុន ធំ ដែល ហោះ ក្នុង ចំណាយ ឆ្ងាយ ឆ្លង ទ្វីប ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា ការសាងសង់ ព្រលានយន្តហោះ សៀមរាប - អង្គរ ថ្មី នេះ ដែល វិនិយោគ ដោយ ចិន នេះ គឺជា ការវិនិយោគ បែប BOT ( សាងសង់ . ប្រតិបត្តិការ និង ផ្ទេរ ឲ្យ កម្ពុជា វិញ ) ដូចគ្នា នឹង ការវិនិយោគ របស់ បារាំង លើ ព្រលានយន្តហោះ ទាំង៣ ដែល កំពុង ដំណើរការ ដែរ ប៉ុន្តែ ការវិនិយោគ ដោយ ចិន គឺ កម្ពុជា មាន តែ ដី ប៉ុណ្ណោះ ចំពោះ ថវិកា គឺ វិនិយោគ ទាំងស្រុង ដោយ ក្រុមហ៊ុន ចិន ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ព្រលានយន្តហោះ អន្តរជាតិ សៀមរាប - អង្គរ ថ្មី នេះ ក្រុមហ៊ុន ចិន គ្រប់គ្រង រយៈពេល ៥៥ ឆ្នាំ ផុត ពី ៥៥ ឆ្នាំ នៅ ប្រតិបត្តិការ ព្រលានយន្តហោះ ថ្មី នេះ ត្រូវ ប្រគល់ឲ្យ កម្ពុជា គ្រប់គ្រង ដាច់ វិញ តែ ម្តង ហើយ ព្រលានយន្តហោះ នេះ ក្រុមហ៊ុន ចិន វិនិយោគ ជិត ១ ពាន់ លាន ដុល្លារ អាមេរិក ។
យោង តាម សេចក្តីរាយការណ៍ របស់ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ កូរ៉េ ខាងជើង KCNA អ្នកនាង គីម បាន លើកឡើង ដូច្នេះ ថា « ការអត្ថាធិប្បាយ នោះ បាន ជំរុញ ឱ្យ ទំនាក់ទំនង អន្តរ កូរ៉េ និង ភាពតានតឹង ផ្នែក យោធា នៅក្នុង ឧបទ្វីប កូរ៉េ កាន់តែ ដុន ដាប អាក្រក់ ថែម ទៀត » ។ អ្នកនាង គីម ដែល ជា មន្រ្តី ជាន់ ខ្ពស់ មួយ រូប ក្នុង គណបក្ស កាន់អំណាច កូរ៉េ ខាងជើង ថែមទាំង បាន ព្រមាន ថា ប្រទេស អ្នកនាង នឹង ពិចារណា លើ រឿង ជាច្រើន ហើយ កូរ៉េ ខាងត្បូង អាចនឹង ត្រូវ ប្រឈម ការគំរាមកំហែង ធ្ងន់ធ្ងរ ដោយសារតែ សម្តី បែប នេះ ។
គួរ បញ្ជាក់ ថា ភាពតាន នៅ ឧបទ្វីប កូរ៉េ បាន កើនឡើង គួរឱ្យ កត់សម្គាល់ ចាប់តាំងពី តែ ពី កូរ៉េ ខាងជើង កាលពី សប្តាហ៍ មុន បាន បាញ់ សាកល្បង មី ស៉ីល ផ្លោង ICBM ដោយ ពេញលេញ ឡើងវិញ ជា លើក ដំបូង គិត ចាប់តាំង តាំងតែពី ឆ្នាំ ២០១៧មក ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ឱកាស អញ្ជើញ ពិនិត្យ វឌ្ឍនភាព នៃ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គ រ
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី០៣ ខែមេសា ឆ្នាំ ២០២២ នេះ អញ្ជើញ ពិនិត្យ វឌ្ឍនភាព នៃ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ស្ថិត នៅក្នុង ឃុំ ពពេល និង ឃុំ តា យ៉ែក ស្រុក សូទ្រនិគម ខេត្ត សៀមរាប ។
នៅក្នុង ឱកាស អញ្ជើញ ពិនិត្យ វឌ្ឍនភាព នៃ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ . សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង សុន្ទរកថា សំណេះសំណាល ប្រមាណ ជាង ១ ម៉ោង ។ ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច តេជោ៖
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង កោតសរសើរ ចំពោះ គម្រោង អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ដែល បាន បន្ត មាន វឌ្ឍនភាព ទោះបី ស្ថិត ក្នុង បរិបទ នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ជា គម្រោង ដ៏ ធំ មួយ ដែល ត្រូវបាន ចុះហត្ថលេខា ក្រោម អធិបតីភាព របស់ សម្តេច និង លោក ប្រធានាធិបតី ចិន ស៊ី ជីន ពីង ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ភាពចាំបាច់ នៃ ការសាងសង់ អាកាសយានដ្ឋាន ថ្មី នេះ ដោយសារ អាកាសយានដ្ឋាន បច្ចុប្បន្ន មិន អាច ទទួលយន្តហោះ ខ្នាត ធំ បាន នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ដែល មាន ចម្ងាយ ប្រមាណ ៤០ គីឡូម៉ែត្រ ពី អង្គរ នេះ គឺជា ចម្ងាយ មួយ ធានា ដល់ សុវត្ថិភាព របស់ ប្រាសាទ អង្គរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ អាច ទទួលបាន យន្តហោះ គ្រប់ កម្រិត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អាកាសយានដ្ឋាន យន្តហោះ ដែល បាន ធ្វើ ជាមួយ បារាំង គឺជា ការយក ម្ស៉ៅ មួយ ភាគ ធំ ទៅ គួបផ្សំ ជាមួយ ម្ស៉ៅ របស់ បារាំង ធ្វើ នំ ឱ្យ ខ្មែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ត្រូវ ទូទាត់ សំណង មួយចំនួន ទៅ ក្រុមហ៊ុន បារាំង ដែល ទទួលបាន សិទ្ធិ វិនិយោគ លើ អាកាសយានដ្ឋាន នៅ កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ចិន បាន យក ថវិកា មកវិនិយោគ បង្កើត អាកាសយានដ្ឋាន ហើយ ៥០ ឆ្នាំ ក្រោយ និង ប្រគល់ មក ឱ្យ ខ្មែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការវិនិយោគ ធ្វើ អាកាសយានដ្ឋាន រវាង ក្រុមហ៊ុន ចិន និង បារាំង គឺ ខុសគ្នា ។ ចិន យក ម្ស៉ៅ ធ្វើ នំ ឱ្យ ខ្មែរ រីឯ ក្រុមហ៊ុន បារាំង គឺ ខ្មែរ ចេញ ម្ស៉ៅ ភាគ ច្រើន ផ្សំ ជាមួយ ម៉្សៅ បារាំង ធ្វើ នំ ឱ្យ ខ្មែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កុំ ភ័ន្តច្រឡំ ថា ការវិនិយោគ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ផ្តល់ ប្រយោជន៍ ត្រឹម ចិន ព្រោះ ពេល ខាងមុខ កម្ពុជា ត្រូវ ទទួល អ្នកទេសចរ ក្នុង ទំហំ កាន់តែ ធំ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កាលពី ឆ្នាំ ២០១២ សម្តេច ចង់ រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន នៅ សៀមរាប តែ ព្រលានយន្តហោះ ខេត្ត សៀមរាប មិន អាច ឱ្យ យន្តហោះ ធំ ៗ របស់ មេដឹកនាំ ប្រទេស ដៃ គូ អាច ចុះចត បាន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ព្រលានយន្ត អន្តរជាតិ សៀមរាប - អង្គរ នឹង ជំរុញ ឱ្យ មាន ការអភិវឌ្ឍ នៅ តំបន់ នេះ ហើយក៏ ល្មម ឱ្យ កម្ពុជា ប្រកាស ពី តារា រះ ទិស ឧត្តរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ហៅ សមិទ្ធផល ព្រលានយន្ត អន្តរជាតិ សៀមរាប - អង្គរ គឺជា កិច្ចខិតខំ របស់ រាជ រដ្ឋាភិបាល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ទីតាំង សាងសង់ ព្រលានយន្តហោះ អន្តរជាតិ សៀមរាប - អង្គរ ជា អតីត សមរភូមិ ប្រយុទ្ធ ដ៏ ស្រួច ស្រាវ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ទីតាំង សាងសង់ ព្រលានយន្តហោះ អន្តរជាតិ សៀមរាប - អង្គរ ជា ទីតាំង មួយ នៃ គោលដៅ របស់ សម្តេច ក្នុង ការប្រែក្លាយ តំបន់ សង្គ្រាម ទៅជា តំបន់ អភិវឌ្ឍន៍ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សមិទ្ធផល ដែល ទទួលបាន នេះ មិន មែន ជា រឿង ចៃដន្យ នោះ ឡើយ គឺ បាន មកពី ការខិតខំ ក្នុង ការបញ្ចប់ សង្គ្រាម តាម នយោបាយ ឈ្នះ - ឈ្នះ នាំមក នូវ សុខ សន្តិភាព និង ការឯកភាព ទឹកដី ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ត្រូវ បន្ត រួមគ្នា ជំរុញ ការអភិវឌ្ឍ នៅ តំបន់ សាងសង់ ព្រលានយន្តហោះ ថ្មី ក្នុង ខេត្ត សៀមរាប នេះ ដូចជា តភ្ជាប់ បណ្តាញ អគ្គិសនី ផ្គត់ផ្គង់ ទឹក ស្អាត និង សាងសង់ ផ្លូវ ។ សម្រាប់ ផ្លូវ នឹង មាន ការធ្វើ ផ្លូវ ល្បឿន លឿន ចេញ ព្រលាន ហើយ ត្រូវ ពង្រីក ផ្លូវ ជាតិ លេខ ៦ ជា៤ គន្លង សម្រាប់ ចូលទៅ ក្រុង សៀមរាប ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នៅពេល ព្រលានយន្តហោះ ថ្មី ក្នុង ខេត្ត សៀមរាប សាងសង់ រួចរាល់ នឹង ផ្តល់ ការងារ ជូន ប្រជាពលរដ្ឋ ខ្មែរ មិន មែន ផ្តល់ ការងារ ជូន ចិន នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ហាម ទុក ជាមុន កុំ ឱ្យ មាន ការវិភាគ ថា ការធ្វើ ព្រលានយន្តហោះ ខេត្ត សៀមរាប មិន មែន ជា ការពង្រឹង សមត្ថភាព យោធា ចិន នៅ កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា មិន ត្រូវការកងទ័ព បរទេស នោះ ទេ គឺ ត្រូវការ តែ អ្នកទេសចរ បរទេស តែ ប៉ុណ្ណោះ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា មិន ល្ងង់ រហូត ទៅដល់ ឱ្យ ទឹកដី ក្លាយជា ទីតាំង ទ័ព បរទេស ខុសពី រដ្ឋធម្មនុញ្ញ នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន ណែនាំ ឱ្យ យាង ព្រះមហាក្សត្រ តាម យន្តហោះ មក ចុះចត នៅ ព្រលានយន្ត ថ្មី នៅ ខេត្ត សៀមរាប ពេល ដាក់ ដំណើរការ ។
* សម្តេច តេជោ ហ៊ុន សែន ណែនាំ ឱ្យ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ខ្ចី ថវិកា ចិន សម្រាប់ ការសាងសង់ ផ្លូវ ចូលទៅ ក្រុង សៀមរាប ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង កោតសរសើរ អាជ្ញាធរ ខេត្ត សៀមរាប ដែល បាន ខិតខំ សម្របសម្រួល គ្រប់ បែបយ៉ាង ដើម្បី ដំណើរការ សាងសង់ ព្រលានយន្តហោះ អន្តរជាតិ សៀមរាប - អង្គរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ជា ផ្លែ ផ្កា កើត ចេញ ពី សុខ សន្តិភាព និង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង កម្ពុជា និង ចិន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ចប់ ការថ្លែង សុន្ទរកថា នៅ វេលា ម៉ោង ៨៖ ៤៧ នាទី នា ព្រឹក ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២២៕ លោក ឃួង ស្រេង ណែនាំ ដល់ គណៈកម្មាធិការ គណបក្ស ខណ្ឌ ព្រែក ព្នៅ និង ក្រុមការងារ ត្រូវ យកចិត្តទុកដាក់ ថែរក្សា លើកទឹកចិត្ត សមាជិក គណបក្ស ដើម្បី ឈាន ឆ្ពោះ ទៅ យក ជ័យជម្នះ ក្នុង ការបោះឆ្នោត ក្រុមប្រឹក្សា សង្កាត់
ការណែនាំ បែប នេះ របស់ លោក ឃួង ស្រេង បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២ ខែមេសា ឆ្នាំ ២០២២ នេះ នៅក្នុង កិច្ចប្រជុំ ក្រុមការងារ គណបក្ស ចុះ ជួយ មូលដ្ឋាន ខណ្ឌ ព្រែក ព្នៅ ប្រចាំ ខែមីនា និង ទិសដៅ ខែមេសា ឆ្នាំ ២០២២ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ ព្រែក ព្នៅ ។
លោក ឃួង ស្រេង បាន បន្ត ថា ក្នុង នាម ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ ព្រែក ព្នៅ សង្កាត់ ទាំង៥ និង ក្រុមការងារ បក្ស ចុះ ជួយ ខណ្ឌ ព្រែក ព្នៅ ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ថែរក្សា លើកទឹកចិត្ត សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ឲ្យបាន ល្អ ប្រសើរ ដោយ ត្រូវ ជួយ ទំនុកបំរុង ទាំង សម្ភារៈ និង ស្មារតី ធ្វើ យ៉ាងណា ឲ្យ ការបោះឆ្នោត ក្រុមប្រឹក្សា សង្កាត់ អាណត្តិ ទី៥នេះ ទទួលបាន នូវ ភាពជោគជ័យ ។
លោក បន្ត ថា ក្នុង នាម សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ត្រូវ ធ្វើ ចុះ សួរសុខទុក្ខ និង ចលនា ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ឲ្យបាន ជាប់ ជាប្រចាំ ធ្វើ យ៉ាងណា ឲ្យ ពួកគាត់ ស្រឡាញ់ ពេញចិត្ត ជាមួយនឹង គណបក្ស ប្រជាជន កម្ពុជា ឈាន ទៅ បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ។
បន្ថែម ពីលើ នេះ ទៀត នោះ លោក ឃួង ស្រេង ក៏ បាន ណែនាំឲ្យ មន្ត្រី របស់ បក្ស ដែល ចុះ សួរសុខទុក្ខ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ត្រូវ ប្រាប់ ពួកគាត់ ពី គោលបំណង ល្អ ៗ របស់ បក្ស ហើយ បើ ពួក គាត់ មាន ជីវភាព ខ្វះខាត ពួកគាត់ អាច ទៅ រក នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា នៅ តាម សង្កាត់ នោះ គណបក្ស សង្កាត់ នឹង ជួយ ពួកគាត់ ដោយ មិន ទុក ឱ្យ ស្លាប់ ដោយ ការអត់ឃ្លាន នោះ ទេ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ២០ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០២ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ២០ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ០៣ ខែមេសា នេះ ។
