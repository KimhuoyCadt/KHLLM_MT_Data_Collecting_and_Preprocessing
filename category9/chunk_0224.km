( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១ករណី . ដឹកជញ្ជូន រក្សាទុក ៣ករណី និង ជួញដូរ ៨ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣០ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២២ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៥. ០១៨ ករណី ឃាត់ មនុស្ស ១១. ៨៤៩ នាក់ ( ស្រី ៧៤៤ នាក់ )៕ ក្រសួង ការពារ ជាតិ រុស្ស៉ី៖ « កងទ័ព របស់ ខ្លួន នៅ អ៊ុយក្រែន នៅតែ ទទួលបាន ការផ្គត់ផ្គង់ ចាំបាច់ ទាំងអស់ »
ការផ្ទុះ មួយ បាន កើតឡើង នៅ ថ្ងៃសៅរ៍ នេះ លើ ស្ពាន ដែល មាន ទាំង ផ្លូវថ្នល់ និង ផ្លូវ ដែក ដែល យុទ្ធជន រុស្ស៉ី ប្រើ សម្រាប់ ឆ្លងកាត់ និង នាំយក ការផ្គត់ផ្គង់ សម្រាប់ យោធា ឆ្លងកាត់ តំបន់ គ្រី មៀ ទៅ កាន់ ផ្នែក ផ្សេង ទៀត នៃ ភាគ ខាងត្បូង អ៊ុយក្រែន បណ្តាលឲ្យ រង ការខូចខាត ។ ក្រោយពី មាន ហេតុការណ៍ នេះ ក្រសួង ការពារ ជាតិ រុស្ស៉ី អះអាង ថា កងកម្លាំង របស់ ខ្លួន នៅតែ ទទួលបាន ការផ្គត់ផ្គង ជា ចាំបាច់ ទាំងអស់ ។
( ប៉េកាំង ) ៖ តំបន់ ផែ ស្ងួត អន្តរជាតិ ក្រុង Urumqi គឺជា គម្រោង ដ៏ សំខាន់ មួយ នៃ ការកសាង តំបន់ ស្នូល នៃ ខ្សែក្រវាត់ សេដ្ឋកិច្ច ផ្លូវ សូត្រ ។ បន្ទាប់ពី គម្រោង នេះ បាន បញ្ចប់ ការសាងសង នឹង ក្លាយជា វេទិកា ពាណិជ្ជកម្ម ដែល រួមបញ្ចូល មុខងារ ដូចជា ការជួញដូរ ផលិតផល គ្រាប់ ធញ្ញជាតិ និង ប្រេង ការតាំង បង្ហាញ ផលិតផល គ្រាប់ ធញ្ញជាតិ និង ប្រេង ការចរចា ខាង ធុរកិច្ច និង ការទូទាត់ មូល ជន ជាដើម នៃ ភូមិភាគ ស្វយ័ត Xinjiang ។
តាម ឧទ្ទេសនាម ឱ្យដឹង ថា ឆ្នាំ ២០២២ នេះ តំបន់ ផែ ស្ងួត អន្តរជាតិ Urumqi ក៏ នឹង រួមបញ្ចូល គ្នា នូវ ការកសាង គម្រោង និង ការអភិវឌ្ឍ ឧស្សាហកម្ម តាម គំនិត « សហគ្រាស ឈាន មុខ + ចង្កោម ឧស្សាហកម្ម » ដោយ ផ្តោត លើ វិស័យ ចរាចរណ៍ ទំនិញ ពាណ ជ្ជកម្ម ឧស្សហកម្ម ផលិត ជឿនលឿន និង សេវាកម្ម ទំនើប ដើម្បី ស្រូបទាញ សហគ្រាស ឈាន មុខ ជំរុញ ការអភិវឌ្ឍ បែប អន្តរជាតិ តូបនីយកម្ម ឯកទេស ភាវូបនីយកម្ម និង ឌីជីថល ភាវូបនីយកម្ម នៃ ផែ ស្ងួត នេះ ។
វិទ្យុ មិត្តភាព កម្ពុជា ចិន អភិបាល ខេត្ត ត្បូងឃ្មុំ បន្ត ចុះ សួរសុខទុក្ខ និង នាំ អំណោយ កាកបាទ ក្រហម ខេត្ត ចែកជូន ពលរដ្ឋ ១៣២ គ្រួសារ ដែល ជម្លៀស ទៅកាន់ ទី ទួល សុវត្ថិភាព
ក្នុង ឱកាស នោះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន នាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ប្រជាពលរដ្ឋ ទាំងអស់ ផងដែរ ។ លោក បណ្ឌិត បាន ណែនាំ ឲ្យ អាជ្ញាធរ សហការ ជាមួយ មន្ទីរ សុខាភិបាល ខេត្ត និង មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត រៀបចំ ការ រស់នៅ របស់ ពលរដ្ឋ ឲ្យបាន ល្អ មាន បង្គន់ អនាម័យ ក្រុម គ្រូពេទ្យ ថ្នាំ សង្កូវ និង ភ្លើង បំភ្លឺ នា ពេល យប់ ជាដើម ។
បន្ថែម ពី នេះ លោក អភិបាល ខេត្ត ក៏ បាន ក្រើន រំលឹក និង អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ថែរក្សា សុខភាព ពិសេស អ្នក រស់ នៅ តាម ដងទន្លេ បង្កើន ការប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ ។
លោក បាន ផ្ដល់ អនុសាសន៍ ថា រដ្ឋបាល ខេត្ត និង រដ្ឋបាល ក្រុង ស្រុក ទាំង៧ ដែល ចំណុះ ឲ្យ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ និង លោក មេឃុំ ចៅសង្កាត់ ទាំងអស់ បាន ខិតខំ ប្រឹងប្រែង ណាស់ ក្នុង ការសហការ ជាមួយ អាជ្ញាធរ មូល ដាន ភូមិ ឃុំ ពង្រឹង បង្ក្រាប នូវ ល្បែង សុី សង គ្រប់ ប្រភេទ ទាំងអស់ ដែល កើតមាន នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន តាម បទបញ្ជា របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន ផ្ដាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ថា បើសិន ឃើញ មាន ល្បែងស៊ីសង ឬ មាន ការប្រើប្រាស់ នូវ គ្រឿងញៀន សូម ជួយ រាយការណ៍ មកដល់ លោក មេភូមិ ហើយ លោក មេភូមិ រាយការណ៍ មក លោក មេឃុំ ចៅសង្កាត់ លោមេឃុំ ចៅសង្កាត់ រាយការណ៍ ទៅ លោក អភិបាល ស្រុក ហើយ លោក អភិបាល ស្រុក រាយការណ៍ ទៅ អភិបាល ខេត្ត ដើម្បី ចាត់ វិធានការ ឲ្យ កម្លាំង ចុះ មក បង្ក្រាប ឲ្យបាន ទាន់ ពេល វេលា ។
លោក បន្ត ថា ប្រសិនបើ មូលដ្ឋាន ណា កើត មាន ឡើង នៅ ល្បែង សុី សង់ អាជ្ញាធរ មូលដ្ឋាន នោះ ត្រូវ ទទួលខុសត្រូវ ទាំង មេភូមិ ទាំង មេឃុំ ក៏ ដូចគ្នា ជាមួយនឹង ប៉ុស្តិ៍ នគរបាល និង អធិកា មេបញ្ជាការ កងរាជអាវុធហត្ថ ឬ ក៏ អភិបាល ស្រុក ក្រុង ទាំងអស់ ដាច់ខាត ភូមិ ទាំងអស់ ៨៧៣ ភូមិ ដែល ចំណុះ ឲ្យ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ត្រូវតែ ជា ភូមិ « ស» ជា ភូមិ ផា សុខភាព គឺជា ភូមិ ដែល អាច រស់ នៅ ដោយ សុខសាន្ត មិន មាន ការរស់នៅ ដោយ ភិតភ័យ បញ្ហា ចោរកម្ម លួច ឆក់ ប្លន់ នោះ ទេ ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន បន្ថែម ទៀត ថា បើ បុគ្គល ណា ដែល មាន ពាក់ព័ន្ធ ត្រូវតែ មាន ទោស ទាន់ មិន ឲ្យ រួច ខ្លួន ទេ ជា ការក្រើន រំលឹក ទៅដល់ អាជ្ញាធរ នៅ មូលដ្ឋាន របស់ យើង កងកម្លាំង របស់ យើង នៅ តាម មូលដ្ឋាន អ្នក ដែល ប៉ះពាល់ ត្រូវតែ មាន ទោស ទាន់ ដក ចេញ ពី មន្ត្រីរាជការ ដក ចេញ ពី កងកម្លាំង ហើយ ត្រូវ មាន ទោស ទាន់ ថែម ទៀត ។
ជាមួយគ្នា នោះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ និង លោកស្រី បាន បន្ត សំណេះសំណាល និប្រគល់ ជូន អំណោយ និង ចែក ថវិកា លើកទឹកចិត្ត ដល់ កងកម្លាំង ប្រជាការពារ ក៏ ដូចជា ចែក នំ ចំណី ដល់ កុមារា កុមារី ដោយ ក្តីស្រលាញ់ ចេញ ពី បេះដូង យ៉ាង កក់ក្តៅ ផងដែរ ។
សូម ជម្រាប ថា ទឹក ទន្លេ មេគង្គ ថ្ងៃ នេះ មាន កម្ពស់ ១៣. ៤៣ម៉ែត្រ ធៀប ព្រឹក ថ្ងៃ ម្សិលមិញ ទឹក ស្រក ០. ១៥ម៉ែត្រ ធៀប នឹង ឆ្នាំ មុន ខ្ពស់ ជាង ៤.៤០ម៉ែត្រ កំពស់ ទឹក ប្រកាស អាសន្ន ១៥.២០ម៉ែត្រ ៕ គ.ជ. ប បញ្ជ្រាប ការយល់ដឹង ស្តីពី « សារៈសំខាន់ នៃ ការបោះឆ្នោត » ជូន ដល់ សិស្ស និស្សិត នៅ តាម គ្រឹះស្ថាន សិក្សា រដ្ឋ និង ឯកជន ក្នុង ខេត្ត ឧត្ដរ មានជ័យ និង បន្ទាយមានជ័យ
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន រៀបចំ វគ្គ អប់រំ ផ្សព្វផ្សាយ និង បញ្ជ្រាប ការយល់ដឹង ស្តីពី « សារៈសំខាន់ នៃ ការបោះឆ្នោត » ជូន ដល់ សិស្ស និស្សិត នៅ តាម គ្រឹះស្ថាន សិក្សា រដ្ឋ និង ឯកជន ក្នុង រាជធានី ខេត្ត ទាំង ២៥ ជា បន្តបន្ទាប់ ដោយ ចាប់ផ្តើម ពី ខេត្ត ឧត្ដរ មានជ័យ នៅ ថ្ងៃទី ០៦ ខែតុលា និង ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២២ ។
ក្នុង វគ្គ អប់រំ ផ្សព្វផ្សាយ នេះ ដោយ មាន ការផ្តល់ កិច្ចសហការ ពី ក្រសួង អប់រំ យុវជន និង កីឡា ក្នុង គោលបំណង លើកកម្ពស់ ការយល់ដឹង របស់ យុវជន ក្នុង សង្គម លទ្ធិ ប្រជាធិបតេយ្យ ឲ្យបាន ទូលំទូលាយ និង ដើម្បី ជំរុញ ការចូលរួម របស់ យុវជន ក្នុង ព្រឹត្តិការណ៍ នៃ ការបោះឆ្នោត ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
លោក ម៉ុក ដារ៉ា អគ្គ លេខាធិការ រង គ.ជ. ប បាន បញ្ជាក់ ថា វគ្គ អប់រំ ផ្សព្វផ្សាយ នេះ មាន គោលបំណង បញ្ជ្រាប ការយល់ដឹង ដល់ យុវជន អំពី មូលដ្ឋានគ្រឹះ នៃ សិទ្ធិ បោះឆ្នោត តាមរយៈ ភាព មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ឆ្ពោះ ទៅរក ការសម្រេចចិត្ត បោះឆ្នោត ជ្រើសរើស តំណាង របស់ ខ្លួន ព្រោះ ការបោះឆ្នោត គឺជា ស្នូល នៃ លទ្ធិ ប្រជាធិបតេយ្យ ។
លោក មាន ការជឿជាក់ ថា វគ្គ អប់រំ ផ្សព្វផ្សាយ នេះ នឹង ក្លាយជា ផ្នែក មួយ ជួយ ជំរុញ ដល់ យុវជន ដែល គ្រប់ អាយុ បោះឆ្នោត ក្នុង ការមក ចុះឈ្មោះ បោះឆ្នោត តាម ពេលវេលា កំណត់ របស់ គ.ជ.ប ។ ចំពោះ ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ នេះ នឹង ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ២០ ខែតុលា រហូតដល់ ថ្ងៃទី ០៨ ខែធ្នូ ឆ្នាំ ២០២២ ខាងមុខ នេះ ។
សូម ជម្រាប ជូន ថា ក្នុង វគ្គ អប់រំ ផ្សព្វផ្សាយ នេះ មាន ការធ្វើ បទបង្ហាញ ដោយ មន្រ្តី ជាន់ ខ្ពស់ របស់ គ.ជ. ប ទៅ លើ ប្រធានបទ ចំនួន ៤រួម មាន៖
* ប្រវត្តិ និង ដំណើរការ នៃ ការបោះឆ្នោត * ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ប្រចាំ ឆ្នាំ * សារៈសំខាន់ នៃ ការបោះឆ្នោត តាមរយៈ ការចូលរួម របស់ យុវជន ក្នុង សង្គម ប្រជាធិបតេយ្យ * ការចូលរួម របស់ យុវជន ក្នុង ដំណាក់កាល នៃ ការបោះឆ្នោត ។
សូម បញ្ជាក់ ថា សិក្ខាកាម ដែល បាន ចូលរួម នៅក្នុង វគ្គ អប់រំ ផ្សព្វផ្សាយ និង បញ្ជ្រាប ការយល់ដឹង ស្តីពី សារៈសំខាន់ នៃ ការបោះឆ្នោត នៅ តាម គ្រឹះស្ថាន សិក្សា រដ្ឋ និង ឯកជន សរុប ទាំង ពីរ ខេត្ត មាន ចំនួន ប្រមាណ ៦០០ នាក់ ដែល ជា សាស្រ្តាចារ្យ លោកគ្រូ អ្នកគ្រូ មន្រ្តី បោះឆ្នោត និង សិស្ស និសិ្សត ៕
គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ពោធិ៍សាត់ បង្ហាញ ពី ផល ប៉ះពាល់ បឋម នៃ គ្រោះ ទឹក ជំនន់
( ពោធិ៍សាត់ )៖ គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ពី របាយការណ៍ ផល ប៉ះពាល់ បឋម នៃ ទឹក ជំនន់ គិត ត្រឹម ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០២២ ។
* ទី១៖ ក្រុង ពោធិ៍សាត់ ទទួលរង ប៉ះពាល់៖
* ទី២៖ ស្រុក កណ្តៀង ទទួលរង ប៉ះពាល់៖
ក្នុង របាយការណ៍ នោះ បាន បន្ថែម ថា ក្រោម កិច្ចចង្អុល ការណ៍ របស់ លោក ជា វ តាយ អភិបាល ខេត្ត និង ជា ប្រធាន គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត បាន ប្រើប្រាស់ កម្លាំង សរុប មធ្យោបាយ សរុប រួម មាន៖ អាជ្ញាធរ ស្រុក ក្រុង ឃុំ សង្កាត់ និង ភូមិ រួមទាំង កម្លាំង យុវជន ស្ម័គ្រចិត្ត អន្តរាគមន៍ បាន ទាន់ ពេលវេលា ពុំ មាន ផល ប៉ះពាល់ ធ្ងន់ ធរ ដល់ អាយុជីវិត ប្រជាពលរដ្ឋ ឬ សត្វ ពាហៈនៈ នោះ ឡើយ ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន រៀបចំ បញ្ជូន សម្ភារ បរិក្ខា និង ឯកសារ បម្រើ ឲ្យ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ចាប់ពី ថ្ងៃទី ២០ ខែតុលា ដល់ ថ្ងៃទី ០៨ ខែធ្នូ ឆ្នាំ ២០២២ ខាងមុខ ។
ការស្រង់ ស្ថិតិ ប្រជាពលរដ្ឋ ប៉ាន់ស្មាន សម្រាប់ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ នេះ៖
( កំពង់ចាម ) ៖ នៅ ព្រឹក ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២២ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ដឹកនាំ កិច្ចប្រជុំ គណៈ អភិបាល ខេត្ត គណៈ អភិបាល ក្រុង - ស្រុក ទាំង១០ ប្រធាន មន្ទីរ និង មេបញ្ជាការ កម្លាំងប្រដាប់អាវុធ ទាំង បី ប្រភេទ ដើម្បី រៀបចំ ផែនការ រក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ សម្រាប់ ពិធី ប្រណាំង ទូក បណ្ដែត ប្រទី ប អុច កាំ ជ្រួច និង ការតាំងពិព័រណ៍ ដែល គ្រោង ប្រារព្ធ ធ្វើ នៅ ថ្ងៃទី ១០ ខែតុលា ខាងមុខ នេះ ។
បន្ថែម ពីលើ នេះ លោក អភិបាល ខេត្ត ក៏ បាន ជំរុញ និង លើ ទឹកចិត្ត ដល់ អាជ្ញាធរ និង កងកម្លាំង សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ទាំងអស់ ត្រូវ បង្កើន ការខិតខំ យកចិត្តទុកដាក់ បន្ត ទៀត លើ ការរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ និង ចូលរួម សំអាត អនាម័យ បរិស្ថាន និង ការតុបតែង លម្អ ឱ្យ មាន សោភ័ណភាព ស្រស់បំព្រង ដើម្បី ធ្វើ យ៉ាងណា បង្កើត បរិយាកាស ឱ្យ មាន ភាពសប្បាយរីករាយ ជូន បងប្អូន ប្រជាពលរដ្ឋ យើង ។
នៅពេល រាត្រី មាន ការរៀបចំ បណ្ដែត ប្រទី ប និង អុច កាំ ជ្រួច ផងដែរ ។ ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត ក៏ នឹង រៀបចំ ការតាំងពិព័រណ៍ សមិទ្ធផល របស់ រដ្ឋបាល ក្រុង - ស្រុក មន្ទីរ - អង្គភាព ជុំវិញ ខេត្ត និង ពិព័រណ៍ ភូមិ មួយ ផលិតផល មួយ និង ការប្រគុំតន្ត្រី មាន រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៩ - ១០ - ១១ ខែតុលា ឆ្នាំ ២០២២ ផងដែរ ៕
ប្រទេស ចិន ខិតខំ ស្វែងរក មាគ៌ា ពិសេស ឆ្លើយតប នឹង បញ្ហា សង្គម វ័យ ចំណាស់
បច្ចុប្បន្ន នេះ នៅ ប្រទេស ចិន ចំនួន មនុស្ស អាយុ លើស ពី ៦០ ឆ្នាំ មាន ចំនួន ២៦៧ លាន នាក់ ។ ដើម្បី ផ្តល់ ជីវភាព ប្រកបដោយ សុភមង្គល ដល់ មនុស្ស ចាស់ រដ្ឋាភិបាល ចិន បាន អនុវត្ត យុទ្ធសាស្ត្រ ជាតិ ពាក់ព័ន្ធ បន្ត កែសម្រួល ឯកសារ សំខាន់ មួយចំនួន ពាក់ព័ន្ធ ដូចជា « ច្បាប់ ធានា ផលប្រយោជន៍ មនុស្ស ចាស់ » ជាដើម ។
ពី ឆ្នាំ ២០១២ ដល់ ឆ្នាំ ២០២២ រយៈពេល ១០ឆ្នាំ កន្លងមក នេះ ប្រទេស ចិន បាន បន្ត ជំរុញ កែលម្អ ប្រព័ន្ធ សន្តិសុខ សង្គម សម្រាប់ ចាស់ ប្រព័ន្ធ សេវា ថែទាំ មនុស្ស ចាស់ និង ប្រព័ន្ធ គាំទ្រ សុខភាព សម្រាប់ មនុស្ស វ័យ ចំណាស់ ជាដើម ថវិកា រដ្ឋាភិបាល មជ្ឈិម សរុប បាន បណ្តាក់ទុន ចំនួន ៣៥ ពាន់ ៩រយ លាន យាន់ ប្រាក់ ចិន ក្នុង ការកសាង ស្ថាបនា សេវាកម្ម សោធន និវត្តន៍ សេវា ថែទាំ មនុស្ស ចាស់ ក្នុង សហគមន៍ បាន គ្រប់ ដណ្តប់ សហគមន៍ ក្នុង ទីក្រុង ជាទូទៅ និង តាម សហគមន៍ ជាង ពាក់កណ្តាល នៅ ទី ជនបទ ។
ប្រទេស ចិន កំពុង ខិតខំ ស្វែងរក និង ដើរ តាម មាគ៌ា ប្រកបដោយ លក្ខណៈ ពិសេស របស់ ខ្លួន ដើម្បី ទប់ទល់ នឹង បញ្ហា សង្គម វ័យ ចាស់ ដែល សង្គម ទាំងមូល គោរព ស្រលាញ់ មនុស្ស ចាស់ ថែទាំ មនុស្ស ចាស់ ដើម្បីឱ្យ មនុស្ស ចាស់ រាប់ រយ លាន នាក់ របស់ ចិន ទទួល ផលប្រយោជន៍ ពី លទ្ធផល នៃ កំណែទម្រង់ សេដ្ឋកិច្ច និង សង្គមកិច្ច រស់ នៅ ដោយ សប្បាយរីករាយ និង មាន សុភមង្គល ក្នុង វ័យ ចំណាស់ របស់ ខ្លួន ៕
( ភ្នំពេញ ) ៖ មន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន ថ្លែង ថា ភាគ ច្រើន នៃ ខ្សែភាពយន្ត ខ្មែរ បច្ចុប្បន្ន នេះ គ្មាន គុណភាព នោះ ទេ ដោយសារតែ សមត្ថភាព ផលិត ករ នៅ មាន កម្រិត ក៏ ដូចជា កង្វះខាត ថវិកា ក្នុង ការផលិត ។
ថ្លែង ក្នុង សន្និសីទ សារព័ត៌មាន ស្តីពី មហោស្រព ជាតិ ភាពយន្ត ខ្នាត ខ្លី កម្ពុជា លើក ទី៣ ឆ្នាំ ២០២២ នៅ សណ្ឋាគារ Rosewood នៅ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០២២ លោក ស៉ិន ចន្ទ សាយ៉ា ទីប្រឹក្សា ក្រសួង វប្បធម៌ បាន ឲ្យដឹង ថា ខ្សែភាពយន្ត ឥឡូវ ទាំង សំឡេង រូបភាព ស្រ្គីន ធំ និង ផាសុកភាព ជាដើម ក្តី ទៅ មិន ទាន់ ដល់ កម្រិត ទេ ។ បញ្ហា បច្ចេកទេស នៃ ការផលិត សមត្ថភាព ផលិត ករ និង កង្វះខាត ថវិកា សុទ្ធតែ ជា បញ្ហា ធំ ។
បើ តាម មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង វប្បធម៌ បាន ឲ្យដឹង ទៀត ថា បច្ចុប្បន្ន រោង ភាពយន្ត នៅ ខ្មែរ ទំនើប ល្អ ហើយ ប៉ុន្តែ ខ្សែភាពយន្ត ខ្មែរ ភាគ ច្រើន មិន អាច យក ទៅ បញ្ចាំង បាន នោះ ទេ ដោយសារតែ កម្រិត នៃ ខ្សែភាពយន្ត នៅ ស្ទើរ ។ លោក ប្រៀបធៀប ថា បើ ផ្សារ ទំនើប មួយ ចេះតែ ដាក់ ទំនិញ គ្មាន គុណភាព ចូល គ្មាន អ្នកទិញ នោះ ឡើយ ។
ក្នុង គោលបំណង ជំរុញ លើកទឹកចិត្ត យុវជន ក្នុង ការអភិវឌ្ឍ សមត្ថភាព ច្នៃប្រឌិត ដើម្បី រួមចំណែក អភិវឌ្ឍ វិស័យ ភាពយន្ត កម្ពុជា ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នឹង រៀបចំ មហោស្រព ភាពយន្ត ជាតិ ខ្នាត ខ្លី កម្ពុជា លើក ទី៣ ឆ្នាំ ២០២២ ក្រោម ពាក្យស្លោក « ភាពយន្ត ខ្នាត ខ្លី ជា ជំហាន ឆ្ពោះ ទៅកាន់ ភាពយន្ត ខ្នាត វែង » នៅ ថ្ងៃទី ១៦ ខែធ្នូ ឆ្នាំ ២០២២ និង បិទ វិញ នៅ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០២២ នៅឯ សាល សន្និសីទ ចតុម្មុខ និង រោង ភាពយន្ត នានា ក្នុង រាជធានី ភ្នំពេញ ។
លោក ស៉ិន ចន្ទ សាយ៉ា បាន ថ្លែង ដែរ ថា « ក្រសួង វប្បធម៌ យើង ពង្រីក ឲ្យ មាន ការយល់ដឹង ពី ការផលិត ខ្សែភាពយន្ត ។ អញ្ចឹង ហើយ មហោស្រព យើង មិន មែន ធ្វើឡើង ដើម្បី បង្អួត ស្នាដៃ តែ យើង ជួបជុំគ្នា ដើម្បី យើង មើលឃើញ ថា តើ យុវជន ណា ដាក់ចិត្ត ដាក់ កាយ ឈានជើង ចូល ទៅក្នុង វិស័យ ភាពយន្ត ជា អាជីព » ។
លោក មើលឃើញ ថា សមត្ថភាព ផលិត ករ នៅ មាន កម្រិត ដោយសារតែ ពេល ឈានជើង ចូលក្នុង វិស័យ នេះ គាត់ យល់ ថា មាន ការលំបាក ច្រើន ។ សព្វ ថ្ងៃ មាន ផលិតករ ដែល ទទួល ការបណ្តុះបណ្តាល ហើយ មាន សមត្ថភាព ខ្លាំង មាន តិច ណាស់ ។ ចំពោះ កង្វះខាត ថវិកា ធ្វើឲ្យ ផលិត ករ ខ្លះ ចូល សម្តែង ខ្លួន ឯង និង ថត ខ្លួន ឯង ទៀត ដែល ខុសពី ជំនាញ គាត់ ក៏ ធ្វើឲ្យ លទ្ធផល នៃ ខ្សែភាពយន្ត មិន ល្អ ដែរ ។
ជាមួយគ្នា នេះ លោក ប៉ុក បូរ ក្ស ប្រធាន នាយកដ្ឋាន ភាពយន្ត និង ផ្សព្វផ្សាយ វប្បធម៌ នៃ ក្រសួង វប្បធម៌ បាន ឲ្យដឹង ថា យ៉ាងហោចណាស់ ភាពយន្ត ខ្មែរ អាច ផលិត បាន ប្រមាណ ៣០ រឿង តែ មាន ច្រើន បំផុត ២រឿង ដែល អាច នាំចេញ ទៅ ទីផ្សារ បរទេស បាន ។
បន្ថែម លើ នេះ ដែរ លោក បាន លើកឡើង ពី ការផលិត មាតិកា ជា ភាពយន្ត ខ្លី ដែល ដាក់ផ្សាយ លើ បណ្តាញ សង្គម ហើយ ភាព ច្រើន មិន មាន គុណភាព ទាល់តែសោះ ។ គ្មាន គុណភាព ជា រឿង មួយ តែ គ្មាន អត្ថន័យ អប់រំ និង បញ្ចូល ពាក្យ អាសអាភាស ជា រឿង កាន់តែ គួរឲ្យ បារម្ភ ។
ក្នុង នាម មន្ត្រី ក្រសួង វប្បធម៌ លោក ប៉ុក បូរ ក្ស មិន បាន គាំទ្រ ការផលិត ដែល គ្មាន ការយល់ដឹង បែប នេះ ឡើយ ។ ទោះជា យ៉ាង នេះ ក្តី លោក បាន ស្នើឲ្យ ផលិត ករ គិតគូរ ឲ្យបាន ច្បាស់លាស់ ចំពោះ ការផលិត មាតិកា ជា ភាពយន្ត ខ្លី ៗ នោះ ។
បើ តាម មន្ត្រី ក្រសួង វប្បធម៌ ក្រសួង នៅតែ រក្សា យន្ត ការអប់រំ ចំពោះ ផលិត ករ ណា ដែល ផលិត រឿង ទៅ មាន ការប៉ះពាល់ ប៉ុន្តែ ចំពោះ ផលិតករ ដែល រឹង មិន ស្តាប់ ច្បាស់ជា ត្រូវ ទទួលយន្តការ ច្បាប់ ។ ក្រសួង វប្បធម៌ គោរព ការតែង និពន្ធ របស់ ផលិត ករ ដូច មាន ចែង ក្នុង បទដ្ឋាន គតិយុត្ត សកល ស្តីពី ការបញ្ចេញមតិ ជានិច្ច ។
ទន្ទឹម គ្នា នេះ លោក ឯក ប៊ុន ថា អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន បច្ចេកទេស វប្បធម៌ របស់ ក្រសួង វប្បធម៌ បាន លើកឡើង ថា ការផលិតភាពយន្ត មួយ ៗ មិន មែន ជា រឿង សាមញ្ញ ទេ ហើយ ទាល់តែ ផលិតករ ដែល មាន ទេពកោសល្យ ណាស់ ទើប ការផលិត នោះ មាន តម្លៃ ។ ហេតុ នេះ ហើយ ក្រសួង វប្បធម៌ បាន និង កំពុងតែ ខិតខំ ដុសខាត់ ស្វែងរក យុវវ័យ ជំនាន់ ក្រោយ ដែល ជួយ លើកស្ទួយ វិស័យ នេះ ឲ្យ រីកចម្រើន ទៅ មុខ ។
សូម ជម្រាប ថា មហោស្រព ជាតិ ភាពយន្ត ខ្នាត ខ្លី កម្ពុជា ត្រូវបាន បង្កើតឡើង ឆ្លាស់ គ្នា ជាមួយនឹង មហោស្រព ជាតិ ភាពយន្ត ខ្នាត វែង កម្ពុជា រៀងរាល់ ២ឆ្នាំ ម្តង ដោយ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ដែល មាន នាយកដ្ឋាន ភាពយន្ត និង ផ្សព្វផ្សាយ វប្បធម៌ ជា សេនាធិការ ។ មហោស្រព ជាតិ ភាពយន្ត ខ្នាត ខ្លី កម្ពុជា លើក ទី២ ប្រារព្ធ ឡើង នៅ ឆ្នាំ ២០១៨ តែ ខកខាន នៅ ឆ្នាំ ២០២០ ខណៈ មហោស្រព ជាតិ ភាពយន្ត ខ្នាត វែង កម្ពុជា ត្រូវបាន ខកខាន នៅ ឆ្នាំ ២០១៩ តែ បាន រៀបចំ នៅ ឆ្នាំ ២០២១ ជា លើក ទី៥ ។
សេចក្តីជូនដំណឹង របស់ ក្រសួង វប្បធម៌ បញ្ជាក់ ថា ការរៀបចំ មហោស្រព ភាពយន្ត ជាតិ ខ្នាត ខ្លី កម្ពុជា លើក ទី៣ ក៏ មាន ការប្រកួតប្រជែង ដោយ ការទទួលយក ខ្សែភាពយន្ត ខ្នាត ខ្លី របស់ ផលិត ករ មក វាយតម្លៃ ផ្តល់ ជ័យលាភី និង រង្វាន់ ផងដែរ ចាប់ពី ចំណាត់ថ្នាក់ លេខ ១ ដល់ លេខ ៣ ផងដែរ ។ ផុត កំណត់ នៃ ការទទួល ពាក្យ ចូលរួម ប្រកួត នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
ចំពោះ គោលការណ៍ វិនិច្ឆ័យ ជ្រើសរើស និង សិទ្ធិ ចាក់បញ្ចាំង ស្នាដៃ ភាពយន្ត ខ្នាត ខ្លី ទាំងអស់ ដែល បាន ចូលរួម នឹង ត្រូវ ដាក់បញ្ចាំង ជាសាធារណៈ នៅ សាល សន្និសីទ ចតុម្មុខ និង រោង ភាពយន្ត នានា នៅ រាជធានី ភ្នំពេញ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី ១៩ ខែធ្នូ ឆ្នាំ ២២០២២ ។
ចំពោះ ជ័យលាភី និង រង្វាន់ រួម មាន៖
( បាត់ដំបង ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ខេត្ត បាត់ដំបង និង ព្រៃវែង នៅ ព្រឹក ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ សម្ពោធ វេទិកា អុំ ទូក មាត់ ទន្លេ ស្ទឹង សង្កែ រ ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង ។
ថ្លែង ក្នុង ឱកាស នោះ សម្ដេច ក្រឡាហោម ស ខេង បាន សម្ដែង ការអបអរសាទរ និង កោតសរសើរ រដ្ឋបាល ខេត្ត បាត់ដំបង រួមទាំង ក្រុម ស្ថាបត្យករ វិស្វករ និង កម្មករ កម្មការ នី ទាំងអស់ ដែល បាន ដឹកនាំ និង មាន ការទទួលខុសត្រូវ ខ្ពស់ ក្នុង ការសាងសង់ វេទិកា អុំ ទូក នេះ បាន យ៉ាង លឿន ប្រកបដោយ គុណភាព និង សោភ័ណ្ឌភាព ។
សម្ដេច ស ខេង បាន អះអាង ថា តាមរយៈ វេទិកា អុំ ទូក ដ៏ ប្រណិត នេះ និង តាមរយៈ ការៀបចំ សោភ័ណ្ឌភាព ស្ទឹង សង្កែ ព្រមទាំង ស្ទឹង សង្កែ សម្បូរ ទឹក ផង នោះ ពិធី ប្រណាំង ទូក ខេត្ត បាត់ដំបង នៅ ឆ្នាំ នេះ នឹង ប្រារព្ធ ឡើង យ៉ាង រីករាយ បង្កបង្កើត បាន បរិយាកាស កាន់ តែ អធិកអធម ជូន ដល់ ប្រជាពលរដ្ឋ បាន ចូលរួម កម្សាន្ដ ក្នុង ពេល កូវីដ - ១៩ មាន ភាពធូរស្រាល ។
សម្ដេច បញ្ជាក់ ថា កីឡា ប្រណាំង ទូក គឺជា កីឡា ប្រពៃណី ជា កីឡា មហាជន ប៉ុន្តែ កីឡា នេះ បាន សម្ដែង ឲ្យ ឃើញ ពី ការរក្សា ប្រពៃណី ទំនៀមទំលាប់ ការរួម សាមគ្គី គ្នា របស់ ប្រជាពលរដ្ឋ ។ ជាមួយគ្នា នេះ ក៏ ជា ការរួមចំណែក លើកម្ពស់ វប្បធម៌ ជាតិ ហើយ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ បាន ជំរុញ លើកស្ទួយ គ្រប់ ប្រភេទ កីឡា ទាំងអស់ ។
នា ឱកាស នោះ ដែរ សម្ដេច ក្រឡាហោម ស ខេង ក៏ បាន ជម្រាប ជូន អង្គ ពិធី អំពី គម្រោង សាងសង់ វិមាន ឯករាជ្យ ខេត្ត បាត់ដំបង នា ពេល ខាងមុខ នេះ ។ សម្ដេច ថា វិមាន ឯករាជ្យ រួម នឹង ការរៀបចំ សំណង់ និង សោភ័ណ្ឌភាព នានា ទៀត ខេត្ត បាត់ដំបង នឹង កាន់តែ ទទួលបាន ការទាក់ទាញ ភ្ញៀវ ទេសចរណ៍ បន្ថែម ទៀត ។
សូម ជម្រាប ថា វេទិកា អុំ ទូក ថ្មី មាន បណ្តោយ ៣៦ ម៉ែត្រ ទទឹង ១៦ម៉ែត្រ និង កម្ពស់ ១៥.០៥ ម៉ែត្រ ដោយ បាន ចំណាយ រយៈពេល សិក្សា ប្លង់ ចំនួន ៥ខែ និង រយៈពេល នៃ ការសាងសង់ ចំនួន ៤ខែ បាន ក្រុង ពាលី សាងសង់ នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២២ និង បាន បញ្ចប់ ការសាងសង់ ជា ស្ថាពរ នៅ ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២២ ដោយ បាន ប្រើប្រាស់ នូវ សសរ គ្រឹះ ចំនួន ៩៨ ដើម និង បាន ប្រើប្រាស់ នូវ វិស្វករ ជំនាញ ចំនួន ៥នាក់ និង កម្លាំង កម្មករ ជា មធ្យម ចំនួន ៨០ នាក់ ដល់ ខ្ពស់ បំផុត ១៣៤ នាក់ ។
វេទិកា អុំ ទូក ថ្មី ត្រូវបាន រៀបចំឡើង តាម លំនាំ នៃ ស្នាដៃ ស្ថាបត្យកម្ម ពីរ ចនាបទ សំណង់ វត្ត អារាម បុរាណ ចាស់ ៗ អគារ សាលា ខេត្ត ចាស់ និង អគារ ព្រះរាជ ដំណាក់ ផែ ដែល មាន លក្ខណៈ ពិសេស នោះ គឺ មាន ដំបូល កាកបាទ សញ្ញា បូក បួន ទិស ធំ ៗ និង មាន បង្ហាញ នូវ ហោជាង យ៉ាង ស្រស់ ឆើតឆាយ ។ ផ្នែក ដំបូល ក្បឿង ស្រកាលេញ ត្រូវបាន សិក្សា និង យកមក ប្រើ នៅក្នុង គម្រោង វេទិកា អុំ ទូក ដោយ ក្បឿង ស្រកាលេញ គឺជា ក្បឿង ខ្មែរ ដែល ត្រូវបាន ប្រើប្រាស់ នៅ តាម ដំបូល ផ្ទះ ដំបូល កុដិ ដំបូល ព្រះវិហារ ចំណាស់ ៗ ជាដើម ។
ផ្នែក សសរ នៅ ខាងលើ ក្បាល សសរ ត្រូវបាន បំពាក់ ដោយ ទម្រ ទ្រេត ឬ ជន្ទល់ ដែល គេ ហៅ ថា ដៃ ស្នា ។ ដោយឡែក នៅ អម ជាប់ តាម បណ្តោយ ក្បាល សសរ ជុំវិញ អគារ ត្រូវបាន រចនា និង បំពាក់ ដោយ ក្បាច់ ទម្រជញ្ចាំង ។ ផ្នែក បាំង សាច ដោយសារ អគារ វេទិកា អុំ ទូក ខេត្ត ត្រូវបាន រចនា ដោយ បើក លំហ ទូលាយ ច្រើន ដូចនេះ ក្រុម ស្ថាបត្យករ បាន បំពាក់ បាំង សាច ខាងក្រៅ លម្អ ដោយ ជ្រី កំណោង កោង ដើម្បី កាត់បន្ថយ កុំ ឱ្យ មាន ទឹកភ្លៀង សាច ចូលក្នុង អគារ ។
ការលើកឡើង នេះ ស្រប ពេល ដែល លោក បាន គូសបញ្ជាក់ ពី ការយកចិត្តទុកដាក់ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ពិសេស សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ផ្ទាល់ ដែល សម្តេច ទាំង ពីរ តែងតែ យកចិត្តទុកដាក់ និង ខ្វាយខ្វល់ ពី សុខ ទុក្ខ កងទ័ព និង កងកម្លាំង ជួរ មុខ ទាំងអស់ ដែល កំពុង ឈរជើង ការពារ ទឹកដី និង ប្រជាពលរដ្ឋ ។
លោក ហ៊ុន ម៉ានី បាន បញ្ជាក់ ថា មុននឹង រដូវ រងា ធ្លាក់ ខ្យល់ ចូល មកដល់ សម្តេច ទាំង ទ្វេ បាន រៀបចំ ចាត់ចែង បែងចែក សម្ភារៈ ទៅ តាម ទិស ទុក ជូន កងទ័ព និង បាន ចាត់ លោក ផ្ទាល់ ជា តំណាង ដើម្បី ចុះ ចែកជូន ផ្ទាល់ និង ផ្តាំផ្ញើ នូវ ការសាកសួរ សុខទុក្ខ ទៅដល់ បងប្អូន កងកម្លាំង គ្រប់ អង្គភាព ។
សូម ជម្រាប ជូន ថា ទីតាំង ទី១ នៃ ពិធី ប្រគល់ អំណោយ គឺ ប្រព្រឹត្តទៅ នៅ កងពល តូច ថ្មើរជើង លេខ ៥១ ស្ថិត ក្នុង ឃុំ ជប់ វារី ស្រុក ព្រះនេត្រ ព្រះ ខេត្ត បន្ទាយមានជ័យ ។
ក្នុង ពិធី ប្រគល់ អំណោយ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី នាយ ឧត្តមសេនីយ៍ គីម ប៊ុន ថា ន អគ្គ មេបញ្ជាការង កងយោធពល ខេមរភូមិន្ទ . នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ អគ្គ ស្នងការ រង នគរបាល ជាតិ . លោក ឧត្តមសេនីយ៍ ទោ សេង ធារិន មេបញ្ជាការង និង ជា នាយ សេនាធិការ យោធ ភូមិភាគ ទី៥ និង លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ ៕
ក្នុង ឱកាស ដ៏ សោក សៅ បំផុត នេះ តាង នាម ឱ្យ រដ្ឋាភិបាល និង ប្រជាជន នៃ ព្រះរាជាណាចក្រ កម្ពុជា សម្តេច តេជោ សូម ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ និង ក្តី អាណិតអាសូរ ដោយ ស្មោះពី ចិត្ត បំផុត ជូន ចំពោះ លោក ប្រាយុទ្ធ ចាន់ អ៊ូចា ហើយ តាមរយៈ លោក បន្ត ជូន ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន ថៃ ជាពិសេស ក្រុមគ្រួសារ នៃ សព និង អ្នក ដែល រង របួស ។
សម្តេច បាន ថ្លែង ថា កម្ពុជា ឈរ នៅ ជាមួយ ថៃ ក្នុង ការកាន់ ទុក្ខ ចំពោះ ឧប្បត្តិហេតុ សម្លាប់ មនុស្ស យ៉ាង រង្គាល នេះ ហើយ សូម ជូនពរ អ្នករបួស ឱ្យ ឆាប់ ជាសះស្បើយ ឡើងវិញ ។
សូម បញ្ជាក់ ថា នៅ ថ្ងៃព្រហស្បតិ៍ ទី ០៦ ខែតុលា មាន បុរស ជនជាតិ ថៃ ម្នាក់ បាន ធ្វើ សកម្មភាព បាញ់ប្រហារ សម្លាប់ មនុស្ស យ៉ាងហោច ៣៨ នាក់ នៅ ខេត្ត ភាគ ឦសាន ប្រទេស ថៃ ។ ជនរងគ្រោះ ដែល បាន បាត់បង់ជីវិត នៅ ទីនោះ រួម មាន ក្មេង ៗ ដល់ ទៅ ២៤ នាក់ ផងដែរ ។
ប្រព័ន្ធ ផ្សព្វផ្សាយ ថៃ បាន ឱ្យដឹង ថា ខ្មាន់ កាំភ្លើង រូប នេះ ធ្លាប់ ជា អតីត មន្ត្រី ប៉ូលិស ម្នាក់ ដែល ត្រូវបាន បណ្ដេញចេញ ពី តួនាទី កាលពី ឆ្នាំ ២០២១ ដោយសារ ប្រើប្រាស់ គ្រឿងញៀន ។ អ្នក នៅក្នុង តំបន់ នោះ ផ្ទាល់ ក៏ សុទ្ធតែ ស្គាល់ យ៉ាង ច្បាស់ ថា ខ្មាន់ កាំភ្លើង រូប នេះ ជា មនុស្ស ញៀន ថ្នាំ ផងដែរ ។
