( ភ្នំពេញ ) ៖ នៅក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ឫស្សីកែវ លោក ឃ្លាំង ហួត អភិបាល រង ជា តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ជំរុញ ឲ្យ កម្លាំង មាន សមត្ថកិច្ច គ្រប់ និង អាជ្ញាធរ ពាក់ព័ន្ធ ក្នុង ដែន សមត្ថកិច្ច ខណ្ឌ ឫស្សីកែវ ត្រូវ បន្ត រួម សហការ ឲ្យបាន ហ្មឺង ម៉ាត់ បំផុត ដើម្បី បង្ក្រាប បទល្មើស ល្បែងស៊ីសង និង កុងស៊ី បញ្ចាំ ខុស ច្បាប់ ឲ្យ ដូច ភ្លៀង រលឹម ធ្វើ យ៉ាងណា ឲ្យ តំបន់ មួយ នេះ កាន់តែ មាន ភាព កក់ក្តៅ ជូន ប្រជាពលរដ្ឋ ។
ក្នុង នោះ លោក ឯក ឃុន ឌឿន អភិបាល ខណ្ឌ ឫស្សីកែវ បាន ជម្រាប ជូន អំពី របាយការណ៍ សង្ខេប នៃ វឌ្ឍនភាព ដែល សម្រេចបាន ក្នុង ឆ្នាំ កន្លងទៅ ក៏ ដូចជា ផែនការអនុវត្ត នៅ អនុសាសន៍ ណែនាំ ក្នុង យុទ្ធនាការ បង្ក្រាប ល្បែងស៊ីសង ខុស ច្បាប់ និង ហាង បញ្ចាំ ឬ កុងស៊ី បញ្ចាំ ខុស ច្បាប់ ក្នុង ដែនដី ខណ្ឌ ឬស្សីកែវ នា រសៀល ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០២២ នៅ សាលា ខណ្ឌ ឫស្សីកែវ ។
ថ្មី ៗ នេះ សមត្ថកិច្ច ពាក់ព័ន្ធ បាន ចុះបង្ក្រាប ល្បែងស៊ីសង ឆ្នោត ឡូតូ ឆ្នោត វៀតណាម ល្បែង អេឡិចត្រូនិច និង បាន ធ្វើ កិច្ចសន្យា ជាមួយ ភាគី ពាក់ព័ន្ធ បាន ចំនួន ៥០កន្លែង និង ហាង បញ្ចាំ ចំនួន ១១ទីតាំង ព្រមទាំង បើក យុទ្ធនាការ ក៏ ដូចជា ចុះ ត្រួតពិនិត្យ ការពារ ទប់ស្កាត់ ក្មេង ទំនើង ក្នុង មូលដ្ឋាន ឲ្យបាន យ៉ាង ល្អ ប្រសើរ ផងដែរ ។
ក្នុង ឱកាស នោះ លោក ឃ្លាំង ហួត បាន ថ្លែង ដោយ លើកឡើង ពី ការមើលឃើញ ពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ គណៈ អភិបាល ខណ្ឌ ក៏ ដូចជា មន្ត្រី ក្រោម ឱវាទ ក្នុង ការធ្វើឲ្យ ប្រសើរឡើង ថែម ទៀត នូវ សុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ។ លោក ឃ្លាំង ហួត ក៏ បាន សង្កត់ធ្ងន់ អំពី អនុសាសន៍ ណែនាំ របស់ អភិបាល រាជធានី ភ្នំពេញ ដែល បាន ទទួល នូវ អនុសាសន៍ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល លើ ការទប់ស្កាត់ និង បង្ក្រាប ល្បែងស៊ីសង ខុស ច្បាប់ ក៏ ដូចជា ហាង បញ្ចាំ នៅក្នុង ដែនដី រាជធានី ភ្នំពេញ ឲ្យបាន ខ្ជាប់ខ្ជួន និង ម៉ឺងម៉ាត់ បំផុត ។
លោក ឃ្លាំង ហួត បាន ជំរុញ ឲ្យ គណៈ អភិបាល ខណ្ឌ ឫស្សីកែវ ត្រូវ យក រឿង នេះ ជា បញ្ហា គោល ក្នុង ការអនុវត្ត ឲ្យបាន ជាពិសេស គឺ ត្រូវ ទទួលខុសត្រូវ ចំពោះ មុខ រាជ រដ្ឋាភិបាល ព្រោះ សេចក្តីសុខ របស់ ប្រជាពលរដ្ឋ គឺជា ការទទួលខុសត្រូវ របស់ អាជ្ញាធរ គ្រប់ ជាន់ ថ្នាក់ ។ លោក ចាត់ទុក ល្បែងស៊ីសង ខុស ច្បាប់ គឺ បាន នាំមក នូវ អស្ថេរភាព សង្គម ហើយ ទីតាំង បញ្ចាំ ខុស ច្បាប់ គឺជា កន្លែង ដែល ផ្តល់ នូវ ប្រភព ហិរញ្ញវត្ថុ ដែល បង្កើត ឲ្យ មាន ល្បែង ខុស ច្បាប់ អំពើ ចោរកម្ម និង ការប្រើប្រាស់ គ្រឿងញៀន ។
ដើម្បីឲ្យ ការងារ នេះ កាន់តែ មាន ប្រសិទ្ធភាព ថែម ទៀត នោះ លោក អភិបាល រង រាជធានី ភ្នំពេញ ជំរុញ ឲ្យ គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ យក បញ្ហា នេះ ធ្វើជា ប្រធានបទ ក្នុង ការអនុវត្ត តួនាទី ភារកិច្ច ប្រចាំ ថ្ងៃ របស់ ខ្លួន ឲ្យបាន ខ្ជាប់ខ្ជួន និង មាន របាយការណ៍ ជា ប្រចាំ ជូន ទៅ ថ្នាក់ លើ ដើម្បីឲ្យ បាន ដឹង កាន់តែ ច្បាស់ អំពី សកម្មភាព របស់ ខ្លួន ក្នុង ការអនុវត្ត នូវ អនុសាសន៍ ណែនាំ របស់ អភិបាល រាជធានី ភ្នំពេញ ។
សូម បញ្ជាក់ ថា គិត ពី ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០២២ អាជ្ញាធរ រាជធានី ភ្នំពេញ បាន ត្រួតពិនិត្យ និង បង្ក្រាប បទល្មើស ល្បែងស៊ីសង ខុស ច្បាប់ សរុប ចំនួន ១. ៣៣៨ ទីតាំង ត្រួតពិនិត្យ និង បង្ក្រាប បទល្មើស កុងស៊ី បញ្ចាំ ខុស ច្បាប់ សរុប ចំនួន ៧៤ ទីតាំង ៕
កម្ពុជា - វៀតណាម បេ្ដជ្ញា បន្ត ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ជាពិសេស លើ វិស័យ សុខាភិបាល
( ភ្នំពេញ ) ៖ ថ្លែង ក្នុង ជំនួប សម្ដែង ការគួរសម និង ពិភាក្សា ការងារ នៅ ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០២២ នេះ រវាង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល លោក សាស្រ្ដាចារ្យ ម៉ម ហេង និង លោក Nguyen Huy Tang ឯក អគ្គ រដ្ឋទូត វិសាមញ្ញ និង ពេញ សមត្ថភាព នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ប្រចាំ កម្ពុជា បាន ប្ដេជ្ញា រួមគ្នា បន្ត ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ជាពិសេស លើ វិស័យ សុខាភិបាល ។
រដ្ឋមន្ត្រី ម៉ម ប៊ុន ហេង ក៏ បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល និង ប្រជាជន វៀតណាម ដែល បាន ផ្តល់ ជំនួយ បន្ទាន់ សម្រាប់ ឆ្លើយតប នឹង ការរីករាលដាល ជំងឺ កូវីដ - ១៩ មួយចំនួន ដូច ជា៖ ថវិកា ចំនួន ២០ម៉ឺន ដុល្លារ អាមេរិក ម៉ាស ចំនួន ២លាន ម៉ាស N95 ចំនួន ៣០ម៉ឺន និង ម៉ាស៊ីន ជំនួយ ដកដង្ហើម ចំនួន ៨០០ គ្រឿង ។
លោក ឯក អគ្គ រដ្ឋទូត វៀតណាម ក៏ បាន សម្តែង នូវ ការអបអរសាទរ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល គ្រប់គ្រង ការរាលដាល នៃ ជំងឺ កូវីដ១៩ បាន យ៉ាង ល្អ ប្រសើរ ជំរុញឱ្យ កម្ពុជា អាច បើក ដំណើរការ ប្រទេស ឡើងវិញ ទាំង សេដ្ឋកិច្ច និង សង្គម តាំងពី ខែវិច្ឆិកា ឆ្នាំ ២០២១ ។
( ភ្នំពេញ ) ៖ លោក គី តិច ប្រធាន ក្រុម មេធាវី រាជ រដ្ឋាភិបាល និង ជា ប្រធាន ក្រុម មេធាវី ស័្ម គ្រចិត្ត សម្តេច តេជោ សែន នៅ ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០២២ សូម ផ្ញើ សារ សម្តែង នូវ ការអបអរសាទរ ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល ទទួលបាន យុត្តិធម៌ និង ភាពស្អាតស្អំ ពី តុលាការ យុត្តិធម៌ ទីក្រុង ប៉ារីស ប្រទេស បារាំង ក្នុង សំណុំរឿង បរិហាកេរ្តិ៍ ប្តឹង ទណ្ឌិត សម រង្ស៉ី ។
សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក ថា សេចក្តីសម្រេច របស់ តុលាការ ទីក្រុង ប៉ារីស ប្រទេស បារាំង ដែល សម្រេច ថា « សម្តេច តេជោ ហ៊ុន សែន មិន មាន ការពាក់ព័ន្ធ នឹង ការស្លាប់ របស់ លោក ហុក ឡង់ ឌី » នោះ គឺជា ការផ្តល់ យុត្តិធម៌ និង ភាពស្អាតស្អំ ជូន សម្តេច ។
កាលពី ថ្ងៃទី ១០ ខែតុលា អ្នកនាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម ចិន បាន ឆ្លើយតប ទៅនឹង សំណួរ របស់ អ្នកសារព័ត៌មាន ទាក់ទិន នឹង ករណី ដែល ក្រសួង ពាណិជ្ជកម្ម សហរដ្ឋ អាមេរិក រឹតបន្តឹង ថែម ទៀត នូវ ការគ្រប់គ្រង ការនាំចេញ របស់ ប្រទេស ចិន ក្នុង វិស័យ ផលិតផល ពាក់កណ្តាល ចម្លង និង វិស័យ ផ្សេង ទៀត ព្រមទាំង បាន កែសម្រួល « បញ្ជី ឈ្មោះ ដែល មិន បាន ពិនិត្យ បញ្ជាក់ » នៃ ការគ្រប់គ្រង ការនាំចេញ ។
ក្រោយ ការអំពាវនាវ របស់ អ៊ុយក្រែន ប្រធានាធិបតី សហរដ្ឋ អាមេរិក លោក ចូ បៃ ដិន បាន សន្យា ថា នឹង ផ្តល់ ប្រព័ន្ធ ការពារ ដែន អាកាស ទំនើប ៗ ខណៈ ដែល មន្ទីរ បញ្ចកោណ ធ្លាប់ បាន បាន ប្រកាស កាលពី ថ្ងៃទី ២៧ ខែកញ្ញា ថា ខ្លួន នឹង ចាប់ផ្តើម ផ្តល់ ប្រព័ន្ធ ការពារ មីស៉ីល កម្រិត ខ្ពស់ ក្នុង រយៈពេល ពីរ ខែ ខាងមុខ នេះ ដល់ ទីក្រុង កៀវ ។ ជាមួយគ្នា នេះ លោក បៃ ដិន និង ក្រុម មេដឹកនាំ ប្រទេស G7 នឹង បើក កិច្ចប្រជុំ មួយ ដើម្បី ពិភាក្សា ពី ការប្តេជ្ញាចិត្ត របស់ ពួកគេ ក្នុង ការគាំទ្រ អ៊ុយក្រែន បន្ថែម ទៀត ។
លោក រីយ៉ាប កូវ បាន គូសបញ្ជាក់ ប្រាប់ ទីភ្នាក់ងារ ព័ត៌មាន រដ្ឋ រុស្ស៉ី RIA យ៉ាង ដូច ច្នេះ ថា « យើង សូម ព្រមាន ទុក ជាមុន ហើយ សង្ឃឹម ថា ពួកគេ ដឹង ពី ការកើនឡើង នៃ គ្រោះថ្នាក់ ដែល មិន អាច គ្រប់គ្រង បាន នៅក្នុង ទីក្រុង វ៉ាស៊ីនតោន » ។
គួរ បញ្ជាក់ ថា ភាពតានតឹង បាន នឹង កំពុង កើនឡើង កាន់តែ ខ្លាំង ក្រោយ រុស្ស៉ី បាញ់ ស្រោច មីស៉ីល លើ ទីក្រុង នានា របស់ អ៊ុយក្រែន កាលពី ថ្ងៃចន្ទ ដើម សប្តាហ៍ ។ មន្ត្រី អ៊ុយក្រែន ក៏ បាន រាយការណ៍ ផងដែរ ថា ការវាយប្រហារ បន្ថែម ទៀត នៅ ថ្ងៃអង្គារ នេះ កើតឡើង នៅ ភាគ អាគ្នេយ៍ នៃ តំបន់ ហ្សាប៉ូរ៉ិច ហ្ស៉ី យ៉ា (Zaporizhzhia) សម្លាប់ មនុស្ស ម្នាក់ ៕
ទំនិញ ដែល កម្ពុជា នាំចេញ ច្រើន ជាង គេ គឺ សម្លៀកបំពាក់ មាន តម្លៃ ជាង ៧ ពាន់ លាន ដុល្លារ . ម៉ាស៊ីន និង ឧបករណ៍ អគ្គិសនី តម្លៃ ជាង ១២០០ លាន ដុល្លារ . ស្បែកជើង តម្លៃ ជាង ១៣០០ លាន ដុល្លារ . វត្ថុ ធ្វើ ពី ស្បែក និង រោម សត្វ ជាង ១៤០០ លាន ដុល្លារ និង ទំនិញ ផ្សេង ៗ ទៀត ដូចជា ធញ្ញជាតិ គ្រឿង សង្ហារឹម កៅស៊ូ បន្លែ ផ្លែ ឈើ ជាដើម ។
( ភ្នំពេញ ) ៖ សហព័ន្ធ ស្វាយចន្ទី កម្ពុជា បាន បោះឆ្នោត ជ្រើសរើស ក្បាល ម៉ាស៊ីន ដឹកនាំ របស់ ខ្លួន រួចហើយ នៅ ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២២ ។
លទ្ធផល សន្និបាត កំណើត ដំបូង ស្វាយចន្ទី កម្ពុជា និង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សាភិបាល សហព័ន្ធ ស្វាយចន្ទី កម្ពុជា ដោយ បាន ជ្រើសរើស សមាជិក ក្រុមប្រឹក្សាភិបាល សរុប ចំនួន ១១នាក់ ក្នុង នោះ លោក អាន ដារ៉ា ត្រូវបាន ជាប់ ឆ្នោត ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល . លោក ស៊ុយ កុក ធាន ជា អនុប្រធាន ទី១ និង លោកស្រី មុត ចរិយា ជា អនុប្រធាន ទី២ ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ពាណិជ្ជកម្ម បាន ចាត់ទុក ការចាប់កំណើត របស់ សហព័ន្ធ នេះ នឹង ក្លាយជា កម្លាំង ចលករ ដ៏ សំខាន់ ដើម្បី លើកកម្ពស់ វិស័យ ស្វាយចន្ទី លើ ទីផ្សារ អន្តរជាតិ ។
លោក ម៉ៅ ថូរ៉ា រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម បាន កោតសរសើរ ចំពោះ ការបង្កើត សហព័ន្ធ ស្វាយចន្ទី កម្ពុជា ជា សកម្មភាព អាទិភាព មួយ ក្នុង ចំណោម សកម្មភាព អាទិភាព ដែល បាន ដាក់ចេញ ក្នុង សេចក្តីព្រាង គោល នយោបាយ ជាតិ ស្តីពី ស្វាយចន្ទី ។
លោក លើកឡើង ថា ការចាប់កំណើត នៃ សហព័ន្ធ ស្វាយចន្ទី កម្ពុជា នឹង ក្លាយជា ជា កម្លាំង ចលករ យ៉ាង សំខាន់ ក្នុង ការលើកកម្ពស់ វិស័យ ស្វាយចន្ទី កម្ពុជា លើ ទីផ្សារ អន្តរជា ។
លោក ម៉ៅ ថូរ៉ា បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « សហព័ន្ធ ស្វាយចន្ទី នេះ នឹង ក្លាយជា កម្លាំង ចលករ យ៉ាង សំខាន់ ក្នុង ការជំរុញ អនុវត្ត គោល នយោបាយ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព និង ឆ្លើយតប នឹង តម្រូវការ ទីផ្សារ ក្នុង ស្រុក និង ពិភពលោក និង ចូលរួម លើកកម្ពស់ វិស័យ ស្វាយចន្ទី កម្ពុជា លើ ទីផ្សារ អន្តរជាតិ បន្ថែម ទៀត » ។
លោក រាជ រ៉ា រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម ក៏ បាន ផ្តល់ អនុសាសន៍ ចំនួន ៧ ចំណុច ជូន ដល់ សហព័ន្ធ ស្វាយចន្ទី ដែល ទើបនឹង ប្រសូត ឡើង រួម មាន៖
១៖ ត្រូវ ចងចាំ ថា សហព័ន្ធ ស្វាយចន្ទី នេះ មិន មែន បង្កើតឡើង ដើម្បី ប្រយោជន៍ បុគ្គល ឬ ប្រយោជន៍ របស់ ក្រុម ណាមួយ ឡើយ ប៉ុន្តែ សហព័ន្ធ នេះ បង្កើតឡើង ដើម្បី បម្រើ ឱ្យ ប្រយោជន៍ រួម របស់ អ្នក ដាំដុះ អ្នក កែច្នៃ និង អ្នកនាំចេញ ។
២៖ ត្រូវ រក្សា បាន នូវ សាមគ្គីភាព ផ្ទៃក្នុង ឱ្យ បាន រឹងមាំ ។
៣៖ ត្រូវ គ្រប់គ្រង ធនធាន ហិរញ្ញវត្ថុ ប្រកបដោយ តម្លាភាព និង គណនេយ្យភាព ។
៤៖ អនុវត្ត ឱ្យ បាន យ៉ាង ខ្ជាប់ខ្ជួន នូវ ចក្ខុវិស័យ គោលដៅ គោលបំណង និង ផែនការ សកម្មភាព ដូច មាន ចែង នៅក្នុង លក្ខន្តិកៈ និង កិច្ចការងារ ចាំបាច់ ក៏ ដូចជា តម្រូវការ ជាក់ស្តែង ដទៃ ទៀត ។
៥៖ ត្រូវ សហការ ឱ្យ បាន ល្អ ជាមួយ ក្រសួង ពាណិជ្ជកម្ម និង ធ្វើ ការសម្របសម្រួល សហការ ជាមួយ បណ្តា ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដទៃ ទៀត ផងដែរ ។
៦៖ ធ្វើ ការទំនាក់ទំនង ជាមួយ អង្គការ ជាតិ និង អន្តរជាតិ ដើម្បី ស្វែងរក ជំនួយ ជំនួយ បច្ចេកទេស ការបណ្តុះបណ្តាល ធនធាន មនុស្ស និង ការអនុវត្ត គម្រោង នានា ជាមួយ ក្រសួង ពាណិជ្ជកម្ម និង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ។
កាលពី ថ្ងៃទី ៦ ខែតុលា ទីក្រុង ប៉ារីស បាន ចេញមុខ រិះគន់ អ៉ីរ៉ង់ ថា ប្រព្រឹត្ត ទង្វើ បែប ផ្តាច់ការ និង យក ពលរដ្ឋ បារាំង ធ្វើជា ចំណាប់ខ្មាំង បន្ទាប់ពី មាន ការចាក់ផ្សាយ វីដេអូ មួយ ដែល ក្នុង នោះ ប្តី ប្រពន្ធ ជនជាតិ បារាំង ២នាក់ បាន និយាយ ឆ្លើយ សារ ភាព ចំពោះ ការធ្វើ ចារកម្ម ក្រោយ ទីក្រុង តេហេរ៉ង់ បាន អះអាង ថា ភាពវឹកវរ ជាច្រើន សប្តាហ៍ មក នេះ ដែល បាន ផ្ទុះឡើង នៅក្នុង ប្រទេស ខ្លួន គឺ មាន ជាប់ទាក់ទង ជាមួយ កម្លាំង បរទេស ។
រដ្ឋមន្ដ្រី ស៊ុយ សែម អញ្ជើញ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ផ្លូវ បេតុង មួយ ខ្សែ នៅ សង្កាត់ កោះ ទ្រុង ក្រុង ក្រចេះ ជា ថវិកា របស់ « មូលនិធិ រ៉ែ »
( ក្រចេះ ) ៖ លោក ស៊ុយ សែម រដ្ឋមន្រ្តី ក្រសួង រ៉ែ និង ថាមពល នៅ ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស ជា ផ្លូវការ ផ្លូវ បេតុង អាមេ១ ខ្សែ ប្រវែង ៩២០ ម៉ែត្រ ទទឹង ១.៥ម៉ែត្រ នៅ សង្កាត់ កោះ ទ្រុង ក្រុង ក្រចេះ ។ ក្នុង ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ និង លោក លោកស្រី ប្រធាន អនុប្រធាន មន្ទីរ កងកម្លាំង អាជ្ញាធរ ភូមិ ឃុំ ព្រមទាំង ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។
លោក រដ្ឋមន្ដ្រី អះអាង ថា សម្រាប់ ខេត្ត ក្រចេះ ចាប់តាំងពី ការបង្កើត « មូលនិធិ រ៉ែ » ក្រសួង បាន ធ្វើ ការប្រមូល ប្រាក់ មូលនិធិ រ៉ែ បាន ចំនួន ៥៩៨. ៣៦៦. ៤៥ ដុល្លារ ។ ដោយឡែក ក្រុង ក្រចេះ ប្រមូល ប្រាក់ មូលនិធិ រ៉ែ បាន ចំនួន ៨៨. ២៩៣. ៧៨ ដុល្លារ ក្រសួង បាន ទទួល នូវ សំណើ ពី អាជ្ញាធរ សង្កាត់ កោះ ទ្រង់ ចំនួន ២គម្រោង ក្នុង នោះ កាលពី ឆ្នាំ ២០១៨ កន្លងមក ក្រសួង បាន ផ្តល់ ជូន នូវ គម្រោង កសាង ផ្លូវ បេតុង ១ខ្សែ ប្រវែង៥០០ ម៉ែត្រ ទទឹង ១.៥០ ម៉ែត្រ កម្រាស់ ០. ១២ម៉ែត ប្រើប្រាស់ ថវិកា សរុប ចំនួន ១១. ២០០ ដុល្លារ ។
បច្ចុប្បន្ន រដ្ឋបាល សង្កាត់ កោះ ទ្រង់ បាន ទទួល គម្រោង កសាង ផ្លូវ បន្ត ១ខ្សែ ទៀត ប្រវែង ៩២០ ម៉ែត្រ ទទឹង ១.៥០ ម៉ែត្រ កម្រាស់ ០. ១២ម៉ែត្រ ប្រើប្រាស់ ថវិកា ចំនួន ៣១. ៥៥៦ ដុល្លារ សរុប ទាំង២ គម្រោង ប្រើប្រាស់ មូលនិធិ រ៉ែ សរុប ៤២. ៧៥៦ ដុល្លារ ដើម្បី បម្រើ ប្រយោជន៍ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ប្រកបរបរ ផ្សេង ៗ និង លើកស្ទួយ វិស័យ ទេសចរណ៍ នៅ តំបន់ នោះ ផងដែរ ។ បច្ចុប្បន្ន មូលនិធិ រ៉ែ នៅសល់ ក្នុង ក្រុង ក្រចេះ ចំនួន ៤៥. ៥៣៧. ៧៨ ដុល្លារ ទៀត ។
អភិបាល ស្រុក រំដួល ណែនាំ គ្រូពេទ្យ ត្រូវ ផ្តល់ ស្នាមញញឹម ដល់ អ្នកជំងឺ និង ព្យាបាល ដោយ ក្រមសីលធម៌ វិជ្ជាជីវៈ
( ស្វាយរៀង ) ៖ លោក ហែម ស៊ីណា អភិបាល ស្រុក រំដួល ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន ណែនាំ ដល់ ក្រុម គ្រូពេទ្យ ទាំងអស់ ត្រូវ ផ្តល់ ស្នាមញញឹម ដល់ អ្នកជំងឺ និង ព្យាបាល ដោយ ក្រមសីលធម៌ និង វិជ្ជាជីវៈ ដោយ គ្មាន ការរើសអើង ។
ក្នុង ឱកាស នោះ លោក បាន ថ្លែង នូវ ការកោតសរសើរ ចំពោះ សកម្មភាព ការងារ និង គុណភាព នៃ ការពិនិត្យ ព្យាបាល ជំងឺ របស់ ក្រុម គ្រូពេទ្យ ដែល ប្រសិទ្ធ នាម ថា « ជា កងទ័ព អាវ សជួរ មុខ » ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ដង្កាត់ ផ្សេង ៗ និង ជំងឺ ឆ្លង សកល កន្លងមក ដោយ គោរព ទៅ តាម ក្រមសីលធម៌ វិជ្ជាជីវៈ ជាពិសេស ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ដែរ ក្រុម គ្រូពេទ្យ បាន ដាក់ វេន ប្រចាំ ការ ដើម្បី ពិនិត្យ សុខភាព ប្រជាពលរដ្ឋ ក៏ ដូចជា ព្យាបាល ជំងឺ ទូទៅ បាន យ៉ាង ល្អ ។
លោក បាន បន្ត ថា មាន សុខភាព ល្អ អាច ធ្វើ កិច្ចការងារ អ្វី ៗ បាន ទាំងអស់ ទាំង សេដ្ឋកិច្ច គ្រួសារ និង សង្គមជាតិ កាលណា សុខភាព ទ្រុឌទ្រោម ការងារ អ្វី គឺ ត្រូវបាត់បង់ ដូច្នេះ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ សព្វ ថ្ងៃ ត្រូវការ កត្តា ពីរ សំខាន់ គឺ សុខភាព ផ្លូវចិត្ត និង សុខភាព ផ្លូវកាយ ដែល សុខភាព ទាំង ពីរ នេះ មិន អាច ខ្វះ មួយ ណា បាន នោះ ឡើយ ។
លោក អភិបាល ស្រុក បាន បញ្ជាក់ ថា សេដ្ឋកិច្ច គ្រួសារ រីកចម្រើន សង្គមជាតិ ក៏ រីកចម្រើន ដែរ ជាក់ស្ដែង នៅក្នុង ខេត្ត ស្វាយរៀង មាន វិស័យ វិនិយោគ បាន បណ្ដាក់ទុន រកស៊ី ដោយ មាន រោងចក្រ សហគ្រាស ជាច្រើន កន្លែង អាច ស្រូបយក កម្មករ និយោជិក ប្រមាណ ជិត ១០ម៉ឺន នាក់ កំពុង បម្រើ ការងារ និង ទាញយក សេដ្ឋកិច្ច ពី រោងចក្រ ដោយ ចំណូល ជា មធ្យម ក្នុង មួយ ខែ ប្រមាណ ជាង ២០លាន ដុល្លារ ដែល ធ្វើឲ្យ គ្រួសារ នីមួយ ៗ មាន ជីវភាព សមរម្យ ផងដែរ ។
ជាមួយគ្នា នេះ លោក បាន ផ្តាំផ្ញើ ដាស់តឿន ដល់ ក្រុម គ្រូពេពេទ្យ ត្រូវ ចេះ អភិវឌ្ឍន៍ សមត្ថភាព បច្ចេកទេស របស់ ខ្លួន ឲ្យបាន ជាប្រចាំ ត្រូវ មាន សុខភាព ល្អ មាំ មួន មាន ប្រជាប្រិយភាព មាន ចំណេះដឹង ផ្នែក IT ( ឧស្សាហកម្ម វេជ្ជសាស្ត្រ ) ប្រឹងប្រែង ធ្វើការងារ ឲ្យ មាន ប្រសិទ្ធភាព យ៉ាង ពិតប្រាកដ គិលាន សង្រ្គោះ ត្រូវ ត្រៀម ប្រតិបត្តិការ និង យាម ប្រចាំ ការ២៤ ម៉ោង / ២៤ ម៉ោង ។
( កណ្ដាល ) ៖ រយ : ពេល៣ ថ្ងៃ នៃ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង បុណ្យ ចេញ វស្សា នៅ ស្រុក ល្វាឯ ម ខេត្ត កណ្តាល ចាប់ពី ថ្ងៃទី ៨ - ១០ ខែតុលា ឆ្នាំ ២០២២ បាន ទាក់ទាញ ភ្ញៀវ ទេសចរណ៍ ទាំង ក្នុង ស្រុក និង ក្រៅ ស្រុក បាន ជាង ៨ម៉ឺន នាក់ ឯណោះ ជាមួយនឹង ស្នាមញញឹម សប្បាយរីករាយ ពេញចិត្ត យ៉ាង ខ្លាំង ស្រប ពេល ជាមួយនឹង ការរៀបចំ សន្តិសុខ សណ្ដាប់ធ្នាប់ អនាម័យ បាន ល្អ បំផុត និង កម្មវិធី ដំណើរ រលូន យ៉ាង ឥត ខ្ចោះ ។
លោក អភិបាល ស្រុក បាន ថ្លែង បញ្ជាក់ ទៀត ថា ៣ ថ្ងៃ នៃ ពិធី បុណ្យ ឃើញ មាន ភាពរលូន ល្អ និង ទទួលបាន ជោគជ័យ យ៉ាង ត្រចះត្រចង់ ដោយ ជ្រើស តើស បាន នូវ ជ័យលាភី សំរាប់ ទៅ ប្រកួត ថ្នាក់ ខេត្ត នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
( កំពង់ធំ )៖ លោក សាយ គឹម ឡម អភិបាល ស្រុក ស្ទោង និង សហការី នៅ រសៀល ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ ចុះ ចែកជូន ដល់ គ្រូពេទ្យ កំពុង ធ្វើ ការផ្តល់ សេវា និង អ្នកជំងឺ ជា ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ក្រីក្រ ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ បង្អែក ស្ទោង ចំនួន ៣១ នាក់ ។
លើកឡើង នា ឱកាស នោះ លោក សាយ គឹម ឡម ក៏ ណែនាំ ដល់ គ្រូពេទ្យ គ្រប់ រូប ត្រូវ ផ្តល់ សេវា និង ព្យាបាល ជំងឺ ប្រកបដោយ ក្រមសីលធម៌ វិជ្ជាជីវៈ ការទទួលខុសត្រូវ និង យកចិត្តទុកដាក់ ខ្ពស់ ដល់ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត ហើយ ពុំ មាន លទ្ធភាព គ្រប់គ្រាន់ ក្នុង ការចេញ ទៅ ព្យាបាល ជំងឺ នៅ ទីកន្លែង ផ្សេង ឲ្យបាន ឆាប់ ជាសះស្បើយ ឲ្យបាន គ្រប់ ៗ គ្នា ។
លោក សាយ គឹម ឡម បាន បន្ថែម ថា ទាំងនេះ សឲ្យ ឃើញ នូវ ការយកចិត្ត ទុក្ខ ដាក់ របស់ ថ្នាក់ដឹកនាំ ស្រុក ស្ទោង ជាមួយ មន្ត្រីរាជការ ក្រោម ឱវាទ ដែល បាន ខិតខំ បំពេញ កិច្ចការ របស់ ខ្លួន ប្រកបដោយ ផ្លែផ្កា និង ជោគជ័យ បំផុត ពិសេស ការព្យាបាល ជូន ពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន គួ ឲ្យ មោទ កក្រៃលែង លើស ពី នេះ ទៀត គឺ ការយកចិត្តទុកដាក់ ជាមួយ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ទីទ័ល ក្រ និង ងាយ រង ហានិភ័យ ផ្សេង ៗ ។
បន្ថែម លើស ពី នេះ ទៀត លោក សាយ គឹម ឡម ក៏ បាន អំពាវនាវ ឱ្យ អ្នកជំងឺ គ្រប់ រូប ត្រូវ ថែរក្សា សុខភាព ឱ្យ បាន ល្អ និង រស់ នៅ ប្រកបដោយ អនាម័យ ល្អ ដើម្បី ជៀសវាង មាន ជំងឺ ដង្កាត់ ផ្សេង ៗ ទៀត ផងដែរ ។
គួរ បញ្ជាក់ ផងដែ ថា លោកគ្រូ អ្នកគ្រូពេទ្យ និង អ្នកជំងឺ ទាំង ៣១ នាក់ ខាងលើ ម្នាក់ ៗ ទទួលបាន នូវ អង្ករ ១បេ មី១ កេស ទឹក សុទ្ធ ១ កេស ទឹកត្រី ១ យូរ ទឹក ស៊ីអ៊ីវ១យួរ និង ត្រី ខ ១យួរ ៕ លោក ឃួង ស្រេង ចាត់ តំណាង ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ ជូន មជ្ឈមណ្ឌល ឱកាស ខ្ញុំ និង មន្ទីរ សំចត សង្គមកិច្ច ព្រៃ ស្ពឺ ដើម្បី ជួយ សម្រាល ការលំបាក
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០២២ នេះ ដោយ មាន ការចិត្តទុកដាក់ គិត គូរ និង ការណែនាំ ពី លោក ឃួង ស្រេង ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ បាន ចាត់ ឲ្យ លោក ជិន ប៊ុន ធឿន នាយក ប្រតិបត្តិ សាខា ជា តំណាង ចុះ សំណេះសំណាល សួរសុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ ទៅ ផ្តល់ ជូន មជ្ឈមណ្ឌល ឱកាស ខ្ញុំ ស្ថិត នៅ សង្កាត់ ឃ្មួញ ខណ្ឌ សែនសុខ ដើម្បី ចូលរួម ជួយ សម្រាល ការលំបាក ដល់ អ្នក ដែល កំពុង ព្យាបាល បន្សាប គ្រឿងញៀន ចំនួន ១. ៨១៣ នាក់ ( ស្រី ១៩២ នាក់ ) ។
ជាមួយគ្នា នេះ លោក ជិន ប៊ុន ធឿន នាយក ប្រតិបត្តិ សាខា បាន បន្ត ចុះ សំណេះសំណាល សាកសួរ សុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ ទៅ ផ្តល់ ជូន មណ្ឌល សំចត សង្គមកិច្ច រាជធានី ភ្នំពេញ ( ព្រៃ ស្ពឺ ) ស្ថិត ក្នុង ភូមិ ស្រែ ជំរៅ សង្កាត់ ចោម ចៅ ទី២ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដែល កំពុង មាន ជន ចាស់ជរា ជន គ្មាន ទីពឹង ជន ពិការ ជន អនាថា ជន វិបល្លា ស ស្មារតី ស្ត្រី រងគ្រោះ ដោយ អំពើ ជួញដូរ ស្នាក់ នៅ បណ្តោះអាសន្ន សរុប ចំនួន ២៣៥ នាក់ ( ស្រី ៥០ នាក់ ) ។
ក្រសួង បរិស្ថាន និង អង្គការ WWF ដាក់ ឱ្យ អនុវត្ត គម្រោង ស្តីពី « ការប្រើប្រាស់ និង ផលិតកម្ម ដោយ និរន្តរភាព »
លោក ទិន ពន្លក បាន ថ្លែថា៖ « ការប្រើប្រាស់ និង ផលិតកម្ម ដោយ និរន្តរភាព (SCP) គឺជា ផ្នែក សំខាន់ មួយ ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម បៃតង រយៈពេល វែង របស់ ប្រទេស កម្ពុជា ដែល មាន ក្នុង គោល នយោបាយ ជាតិ ស្តីពី ការអភិវឌ្ឍ បៃតង និង ផែនការ យុទ្ធសាស្រ្ត ជាតិ ស្តីពី ការអភិវឌ្ឍ បៃតង ឆ្នាំ ២០១៣ - ២០៣០» ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង បរិស្ថាន បាន គូសបន្ថែម ថា៖ « ខ្ញុំ ក៏ សូម សំណូមពរ ផងដែរ ដល់ តួអង្គ ពាក់ព័ន្ធ សំខាន់ ៗ រួម មាន ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ វិស័យ ឯកជន ផលិត ករ អង្គការ សង្គម ស៊ីវិល និង ជាពិសេស សហគមន៍ ចូលរួម គាំទ្រ ការអនុវត្ត គម្រោង SCP នេះ ដើម្បី ជា ការរួមចំណែក ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការសម្រេចបាន គោលដៅ អភិវឌ្ឍន៍ ដោយ ចីរភាព » ។
បណ្ឌិត Ulf D. Jaeckel បាន លើកឡើង ថា៖ « ក្រសួង កិច្ចសហប្រតិបត្តិការ បរិស្ថាន ការអភិរក្ស ធម្មជាតិ សុវត្ថិភាព នុយក្លេអ៊ែរ និង កិច្ចការពារ អ្នកប្រើប្រាស់ នៃ រដ្ឋាភិបាល សហព័ន្ធ អាល្លឺម៉ង់ មាន មោទនភាព ក្នុង ការគាំទ្រ គម្រោង នេះ នៅ ប្រទេស កម្ពុជា និង ថៃ តាមរយៈ ភាព ជាដៃគូ របស់ យើង ជាមួយនឹង អង្គការ WWF អាល្លឺម៉ង់ ដោយ ឃើញ ថា គម្រោង នេះ ពិតជា មាន សារៈសំខាន់ ក្នុង ការដើរ តួនាទី វាស់វែង ភាពធន់ និង ការសម្រប ខ្លួន ទៅនឹង ផល ប៉ះពាល់ នៃ ការប្រែប្រួល អាកាសធាតុ » ។
កម្ពុជា ចាប់ផ្ដើម ដំណើរការស្ល រ៉ែ មាស នៅ ខេត្ដ ក្រចេះ ដោយ ក្នុង មួយ ខែ អាច ផលិត មាស បាន ២០ គីឡូក្រាម !
ការបើក ដំណើរការ កត់ត្រា ទិន្នន័យ ស្ល រ៉ែ មាស លើក ទី១ របស់ ក្រុមហ៊ុន នេះ ក៏ មាន ការចូលរួម ពី លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ ថ្នាក់ដឹកនាំ ក្រសួង និង មន្រ្តី ជំនាញ ពាក់ព័ន្ធ ជាច្រើន រូប នា ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២២ ។
តាម គម្រោង សាកល្បង ៣ខែ ដំបូង ក្រុមហ៊ុន គ្រោង ផលិត ឲ្យបាន ២០ គីឡូក្រាម ក្នុង មួយ ខែ ដែល គិត ត្រឹម ខែធ្នូ ឆ្នាំ ២០២២ ខាងមុខ នេះ ក្រុមហ៊ុន គ្រោង ផលិត ឲ្យបាន ចំនួន ៦០ គីឡូក្រាម ។
បន្ថែម ពី នោះ ទៀត លោក អ៊ឹង ឌីប៉ូឡា បាន ឲ្យដឹង ថា ទន្ទឹមនឹង ប្រយោជន៍ សេដ្ឋកិច្ច ដំណើរការ អាជីវកម្ម ស្ល រ៉ែ មាស នេះ គឺ ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការបង្កើត នូវ សមត្ថភាព ជាតិ ក៏ ដូចជា គំរូ ឧស្សាហកម្ម ថ្មី មួយ ទៀត សម្រាប់ ការធ្វើ អាជីវកម្ម ធនធាន រ៉ែ ប្រកបដោយ ការទទួលខុសត្រូវ និង ការអភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ។
លោក អ៊ឹង ឌីប៉ូឡា បាន លើកឡើង ថា ផលិតផល មាស ដែល បាន ពី ការធ្វើ អាជីវកម្ម រ៉ែ មាស នេះ គឺជា សម ទ្ធិផល ថ្មី និង ជា ប្រភព ចំណូល ថ្មី មួយ ដែល នឹង ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការបង្កើន ចំណូល រដ្ឋ និង ជា វិភាគទាន យ៉ាង សំខាន់ មួយ សម្រាប់ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ជាតិ នា ពេល បច្ចុប្បន្ន និង អនាគត ។
ក្រោយពី ទទួលបាន អាជ្ញាបណ្ណ ក្រុមហ៊ុន បាន តម្លើង ខ្សែ សង្វាក់ ផលិតកម្ម អាជីវកម្ម របស់ ខ្លួន តែ ដោយសារតែ បញ្ហា កូវីដ១៩ ក្រុមហ៊ុន ទើបតែ បាន បញ្ចប់ ការសាងសង់ និង រៀបចំ ខ្សែ សង្វាក់ ផលិតកម្ម របស់ ខ្លួន នៅក្នុង ខែតុលា ឆ្នាំ ២០២២ នេះ ៕
លិខិត មិត្ត អ្នកអាន៖ តុលាការ បារាំង បក របាំង មុខ ទណ្ឌិត រត់ ចោល ស្រុក សម រង្ស៊ី !
( ភ្នំពេញ ) ៖ តុលាការ ក្រុង ប៉ារីស ប្រទេស បារាំង បាន ចេញ សាលក្រម នៅ ថ្ងៃចន្ទ ទី ១០ តុលា នេះ ដោយ បាន សម្រេច ផ្តល់ ភាពស្អាតស្អំ ដល់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ថា មិន មាន ជាប់ពាក់ព័ន្ធ នឹង ការ ស្លាប់ របស់ លោក ហុក ឡង ឌី ដូច ការចោទប្រកាន់ របស់ ទណ្ឌិត សម រង្ស៊ី នោះ ទេ ។ តុលាការ បារាំង ក៏ បាន ចាត់ទុក ការចោទប្រកាន់ របស់ ទណ្ឌិត សម រង្ស៊ី មក លើ លោក នាយក រដ្ឋមន្ត្រី ថា ជា បទបរិហារ កេរ យ៉ាង ធ្ងន់ធ្ងរ ។ ប៉ុន្តែ តុលាការ បាន
អនុគ្រោះ ទោស ដល់ ទណ្ឌិត រូប នេះ ក្នុង ការសង ជំងឺ ចិត្ត ជា និមិត្តរូប១ អឺរ៉ូ ។ ទណ្ឌិត ត្រកូល ក្បត់ ជាតិ សម រង្ស៊ី ត្រូវបាន សម្តេច នាយក រដ្ឋមន្ត្រី និង លោក ឌី វិជ្ជា ប្តឹង ទៅ តុលាការ ប្រទេស បារាំង ពី បទ បរិហារ កេរបន្ទាប់ពី បុគ្គល នេះ បាន ចោទប្រកាន់ ដោយ គ្មាន មូលដ្ឋាន អ្វី ទាំងអស់ ថា លោក នាយក រដ្ឋមន្ត្រី ជា អ្នករៀបចំ ផែនការសម្លាប់ លោក ហុក ឡង ឌី តាមរយៈ ការបំផ្ទុះ ឧត្ថម្ភាគចក្រ ។
ទីបំផុត តុលាការ ក្រុង ប៉ារីស ក៏ បាន ផ្តល់ យុត្តិធម៌ ជូន សម្តេច នាយក រដ្ឋមន្ត្រី និង បាន ផ្តល់ ភាពស្អាតស្អំ ដល់ សម្តេច នាយក រដ្ឋមន្ត្រី ដែល រង ការនិយាយ មួល បង្កាច់ ដោយ គ្មាន ភស្តុតាង ពីសំណាក់ ទណ្ឌិត សម រង្ស៊ី ។
តាមពិត ការទាមទារ សំណង ជំងឺ ចិត្ត មួយ អឺរ៉ូបាន សបញ្ចាក់ ថា ដើម បណ្តឹង មិន មែន ចង់បាន ប្រាក់ នោះ ទេ ប៉ុន្តែ ចង់បាន យុត្តិធម៌ ដើម្បី លាង ជម្រះ ការ មួល បង្កាច់ របស់ បុគ្គល ម្នាក់ ដែល ខ្វះ ការទទួលខុសត្រូវ និង តែងតែ ប្រើ វិធី មួល បង្កាច់ អ្នកដទៃ ជា មធ្យោបាយ ដើម្បី ធ្វើ នយោបាយ តែ ប៉ុណ្ណោះ ។ ដូច្នេះ សាលក្រម របស់ តុលាការ បារាំង នា ពេលនេះ មាន អត្ថន័យ ធំ ធេង និង មិន ត្រឹមតែ សម្រាប់ ដើម បណ្តឹង ប៉ុណ្ណោះ ទេ ប៉ុន្តែ គឺ សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ ទូទាំង ប្រទេស ផងដែរ ។
អភិបាល ថ្មី ស្រុក វាលវែង នៃ ខេត្ត ពោធិ៍សាត់ នឹង ត្រូវ ប្រកាស ចូលកាន់ មុខតំណែង ជា ផ្លូវការ នា ថ្ងៃទី ១៤ ខែតុលា ឆាប់ ៗ ខាងមុខ
( ពោធិ៍សាត់ ) ៖ អភិបាល ថ្មី ស្រុក វាលវែង នៃ ខេត្ត ពោធិ៍សាត់ គឺ លោក វង្ស អេង នឹង ត្រូវ ធ្វើ ពិធី ប្រកាស ចូលកាន់ មុខតំណែង ជា ផ្លូវការ នា ថ្ងៃទី ១៤ ខែតុលា ឆ្នាំ ២០២២ ឆាប់ ៗ ខាងមុខ ក្រោម អធិបតីភាព លោក ម៉ក់ រ៉ា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ពោធិ៍សាត់ ។
