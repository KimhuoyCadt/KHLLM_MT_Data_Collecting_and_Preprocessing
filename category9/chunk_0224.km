( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៤១ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២៤ ខែតុលា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤១ នាក់ នោះ មាន ២០ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១០ករណី និង ជនសង្ស័យ ២១ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ០៩ ករណី ។
សម្តេច តេជោ ហ៊ុន សែន៖ មាន តែ គណបក្ស ប្រជាជន កម្ពុជា មួយ គត់ ដែល រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេស សង្ឃឹម ថា ខែកក្កដា ឆ្នាំ ២០២៣ បងប្អូន នឹង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា បន្ត ទៀត (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា នៅ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ដើម្បី ធានា ឲ្យបាន នូវ សន្តិភាព ។
ថ្លែង ក្នុង ឱកាស អញ្ជើញ ចែក ស្រូវ ពូជ ជូន ប្រជាពលរដ្ឋ ជាង ១ម៉ឺន គ្រួសារ នៅ ខេត្ត បាត់ដំបង សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន អះអាង ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា មួយ គត់ ដែល រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេស ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង មាន នៅពេល ប្រជាពលរដ្ឋ មាន ទុក្ខលំបាក គណបក្ស ប្រជាជន កម្ពុជា រត់ រក បងប្អូន មិន ចាំបាច់ ភ័យ ព្រួយ នោះ ទេ ។ ការបោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា គឺ ធានា នូវ សន្តិភាព ពេញលេញ ដើម្បី ការពារ អាយុជីវិត ប្រជាពលរដ្ឋ ពី សង្គ្រាម ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ប្រជាពលរដ្ឋ ខេត្ត បាត់ដំបង ដែល បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ព្រឹត្តិការណ៍ បោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ / សង្កាត់ នា ពេល កន្លងទៅ នេះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា លទ្ធផល បោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ / សង្កាត់ ជា មូលដ្ឋាន ជោគជ័យ សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ ឆ្នាំ ២០២៣ ៕
សម្តេច តេជោ ហ៊ុន សែន ណែនាំឲ្យ រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម សិក្សា ផលិត ពូជ ស្រូវ ឲ្យបាន សុទ្ធ ល្អ សម្រាប់ កសិករ បង្កបង្កើន បាន ផល ខ្ពស់ (Video inside) ( បាត់ដំបង ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន ណែនាំ ឱ្យ លោក ឌិត ទីណា រដ្ឋមន្ត្រី កសិកម្ម រក្ខា ប្រមាញ់ និង នេសាទ ពិចារណា ផលិត ពូជ ស្រូវ សម្រាប់ ទុក ជូន ប្រជាកសិករ ដើម្បីឲ្យ ពួក គាត់ បង្កបង្កើន ផល ទទួលបាន ទិន្នផល ខ្ពស់ ។
សម្តេច តេជោ បាន ផ្តល់ ជា យោបល់ ដល់ ក្រសួង កសិកម្ម ធ្វើ ការសិក្សា ផលិត ពូជ ស្រូវ ទៅ តាម តំបន់ ដើម្បីឲ្យ ត្រូវ ទៅនឹង ស្ថានភាព ដី នៅ តំបន់ នោះ ហើយ ការផលិត ពូជ ស្រូវ នេះ រដ្ឋ អាច សហការ ជាមួយ ប្រជាកសិករ ដោយ ធ្វើ កិច្ចសន្យា ឲ្យ ពួកគាត់ ផលិត នូវ ពូជ ដែល រដ្ឋ ត្រូវការ និង លក់ ឲ្យ មក រដ្ឋវិញ ពេល ប្រមូល ផល ។ ការណ៍ នេះ មិន ចាំបាច់ រដ្ឋ ត្រូវ មាន ផ្ទៃដី ផលិត ខ្លួន ឯង ឡើយ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា ទិន្នផល នៃ ការបង្កើន ផល របស់ ប្រជាកសិករ ក៏ ផ្តើម ចេញ ពី ការប្រើ ពូជ ត្រឹមត្រូវ ដែល បញ្ហា នេះ សម្តេច បាន ចំណាយ ពេល សឹង ពាក់កណ្តាល ជីវិត ដើម្បី កែប្រែ ឥរិយាបទ របស់ ប្រជាជន អំពី ការប្រើប្រាស់ ពូជ នេះ ។
ការថ្លែង របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស អញ្ជើញ ចែក ស្រូវ ពូជ និង សំណេះសំណាល ជាមួយ ប្រជាកសិករ ប្រមាណ ១១. ៥២៨ គ្រួសារ ដែល រង ផល ប៉ះពាល់ ដោយសារ ជំនន់ ទឹកភ្លៀង នៅ ខេត្ត បាត់ដំបង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២២ ។
សម្តេច បញ្ជាក់ បន្ថែម ថា « យើង មិន ចាំបាច់ ទៅ រក ដី ដើម្បី ផលិត ពូជ ខ្លួន ឯង ទេ ប្រជាពលរដ្ឋ របស់ យើង គាត់ ផលិត ស្រូវ ស្រាប់ ហើយ យើង គ្រាន់តែ ជ្រើសរើស តំបន់ ណាមួយ ដែល មាន ប្រភព ទឹក គ្រប់គ្រាន់ យើង ដាក់ ពូជ ដែល ល្អ សម្រាប់ ឲ្យ គាត់ ផលិត ពូជ នោះ ឲ្យ យើង តែម្តង ហើយ យើង ទិញ យកពី គាត់ មក ស្តុក ធ្វើ យ៉ាង ដូច្នេះ ធានា ថា ថ្ងៃ ក្រោយ យើង មាន លទ្ធភាព ផ្គត់ផ្គង់ ពូជ ស្រូវ ដែល ស្រប តាម តំបន់ នីមួយ ៗ » ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ទៀត ថា នៅពេល រដ្ឋ មាន ពូជ ស្រូវ ល្អ ប្រជាពលរដ្ឋ អាច យក ស្រូវ របស់ ពួកគាត់ មក ដូរ ជាមួយ ស្រូវ ពូជ របស់ រដ្ឋ បាន ហើយ រដ្ឋ ត្រូវ ដូរ ពូជ ជូន ឲ្យ គាត់ ។
សម្តេច តេជោ បញ្ជាក់ ជាថ្មី ម្តង ទៀត ថា ក្នុង រដ្ឋាភិបាល ដែល សម្តេច ដឹកនាំ នឹង មិន ឲ្យ គេ ដៀល ថា « អាអត់ ពូជ ទេ » ដែល អត់ ពូជ ត្រង់នេះ គឺ សំដៅ អត់ ពូជ ស្រូវ ពូជ ដំណាំ មិន មែន សំដៅ ដល់ ពូជ អំបូរ ឡើយ ។ រាជ រដ្ឋាភិបាល កម្ពុជា ធានា បាន នូវ ស្រូវ ពូជ គ្រប់គ្រាន់ សម្រាប់ ចែកជូន ប្រជាកសិករ ក្នុង ករណី មាន គ្រោះ ធម្មជាតិ កើតឡើង ដូចជា គ្រោះ ទឹក ជំនន់ ក្នុង ឆ្នាំ ២០២២ នេះ ជាដើម ។
សម្តេច បញ្ជាក់ ថា គ្រោះ ទឹក ជំនន់ ឆ្នាំ នេះ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ស្រូវ ពូជ សម្រាប់ ជូន អន្តរាគមន៍ ដល់ កសិករ ចំនួន ជាង ៧ពាន់ តោន ហើយ ដើម្បីឲ្យ កសិករ អាច ស្តារ ឡើងវិញ ក្នុង ពេល ឆាប់រហ័ស ៕
គួរ បញ្ជាក់ ថា គ្រាប់បែក កខ្វក់ ឬ ឧបករណ៍ កំចាយ សារធាតុ វិទ្យុសកម្ម គឺជា ប្រភេទ អាវុធ ដែល រួមបញ្ចូល គ្នា នូវ សារធាតុ វិទ្យុសកម្ម ជាមួយ គ្រឿង ផ្ទុះ ផ្សេង ទៀត ។ អាវុធ ប្រភេទ នេះ ប្រើ ដើម្បី បំពុល តំបន់ ជុំវិញ ឬ សម្រាប់ បំបែក ការប្រមូលផ្តុំ ណាមួយ ៕
គួរ បញ្ជាក់ ថា លោក ចន សុន បាន ចំណាយ ពេល ចុង សប្តាហ៍ កន្លងទៅ នេះ ព្យាយាម បញ្ចុះបញ្ចូល សមាជិក សភា បក្ស អភិរក្ស និយម ឱ្យ ផ្តល់ ការគាំទ្រ ចំពោះ រូប លោក ហើយ កាលពី ថ្ងៃអាទិត្យ លោក បាន អះអាង ថា រូប លោក ទទួលបាន ការគាំទ្រ ពី ពួកគេ ចំនួន ១០២ នាក់ ។ ប្រសិនបើ លោក មិន ដក ខ្លួន ចេញ ដូច ខាងលើ ទេ នោះ នៅ ថ្ងៃចន្ទ នេះ លោក ចនសុន នឹង ត្រូវ ប្រជែង ត ទល់ គ្នា ជាមួយ លោក ស៊ូណាក់ ក្នុង ការបោះឆ្នោត ពីសំណាក់ សមាជិក ប្រហែល ១៧០.០០០ នាក់ នៃ បក្ស អភិរក្ស និយម ។
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចែក ស្រូវ ពូជ ជូន ប្រជាពលរដ្ឋ ជាង ១ម៉ឺន គ្រួសារ នៅ ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ នៅ ព្រឹក ថ្ងៃចន្ទ ទី២៤ ខែតុលា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អញ្ជើញ ចែក ស្រូវ ពូជ និង សំណេះសំណាល ជាមួយ ប្រជាកសិករ ប្រមាណ ១១. ៥២៨ គ្រួសារ ដែល រង ផល ប៉ះពាល់ ដោយសារ ជំនន់ ទឹកភ្លៀង នៅ ខេត្ត បាត់ដំបង ។
ជំនួប ជាមួយ ប្រជាកសិករ នៅ ថ្ងៃ នេះ ក្រៅតែ ពី ផ្តល់ ស្រូវ ពូជ ហើយ នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន រៀបចំ កញ្ចប់ ស្បៀងអាហារ និង ថវិកា ជូន ដល់ ប្រជាកសិករ ដើម្បី ដោះស្រាយ ការលំបាក នៅក្នុង ជីវភាព ផងដែរ ។ ខេត្ត បាត់ដំបង គឺជា ខេត្ត មួយ នៅ ទិស ពាយព្យ ប្រទេស ដែល បាន រង ការជន់ លិច ធ្ងន់ធ្ងរ ផងដែរ ដោយសារ ជំនន់ ទឹកភ្លៀង និង ធ្លាក់ មកពី តំបន់ នានា ។
ក្នុង ឱកាស ចែក ស្រូវ ពូជ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង សំណេះសំណាល ប្រមាណ ១ ម៉ោង . ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ៖
* សម្តេច តេជោ ហ៊ុន សែន ចាប់ផ្តើម ថ្លែង សំណេះសំណាល ជាមួយ ប្រជាកសិករ ប្រមាណ ១១. ៥២៨ គ្រួសារ ដែល រង ផល ប៉ះពាល់ ដោយសារ ជំនន់ ទឹកភ្លៀង នៅ ខេត្ត បាត់ដំបង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២២
* ជា កិច្ច ចាប់ផ្តើម នូវ ប្រសាសន៍ សំណេះសំណាល សម្តេច តេជោ ហ៊ុន សែន បាន នាំយក នូវ ព្រះរាជ បណ្តាំ ព្រះមហាក្សត្រ និង សម្តេច ម៉េ សាកសួរ សុខទុក្ខ ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត បាត់ដំបង ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែង ចូលរួម សោកស្តាយ ជាមួយ ប្រជាកសិករ ទាំងអស់ ដែល បាន រងគ្រោះ ដោយ គ្រោះ មហន្តរាយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង កោតសរសើរ សម្តេច ក្រឡាហោម ស ខេង និង អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន រួមគ្នា ប្រឹងប្រែង ដោះស្រាយ បញ្ហា របស់ ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា វិសាលភាព ប៉ះពាល់ ទឹក ជំនន់ នៅ ឆ្នាំ នេះ ធំ ជាង ឆ្នាំ ២០២០ ។ សម្តេច តេជោ រំពឹង ថា អាជ្ញាធរ និង ប្រជាពលរដ្ឋ នឹង រួមគ្នា ជម្នះ ការលំបាក បង្ក ដោយ ទឹក ជំនន់ នា ពេលនេះ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ប្រជាពលរដ្ឋ ខេត្ត បាត់ដំបង ដែល បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ព្រឹត្តិការណ៍ បោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ / សង្កាត់ នា ពេល កន្លងទៅ នេះ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា លទ្ធផល បោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ / សង្កាត់ ជា មូលដ្ឋាន ជោគជ័យ សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ ឆ្នាំ ២០២៣ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ដ្បិត ប្រជាពលរដ្ឋ យើង ជួប ការលំបាក ដោយសារតែ ទឹក ជំនន់ តែ ក៏ មិន ទាន់ ដល់ ថ្នាក់ ត្រូវ ដេក យំ នោះ ដែរ ហើយ ត្រូវ ប្រឹងប្រែង រួមគ្នា ដោះស្រាយ ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ កងកម្លាំង ជួយ កម្លាំង ពលកម្ម ជូន ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន ណែនាំឱ្យ រដ្ឋមន្ត្រី កសិកម្ម ពិចារណា ផលិត ពូជ ស្រូវ ទុក ជូន ប្រជាកសិករ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ផល ស្រូវ ល្អ គឺ ផ្តើម ចេញ ពី ពូជ ស្រូវ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ចាប់តាំងពី សម្តេច ធ្វើជា នាយក រដ្ឋមន្ត្រី នា ឆ្នា ១៩៨៥ សម្តេច បាន ប្រឹងប្រែង ជម្នះ ប្តូរ ឥរិយាបថ ប្រជាកសិករ លើ ការងារ ប្រើប្រាស់ ពូជ ស្រូវ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការធ្វើ កសិកម្ម មិន ត្រូវ បន្ត ធ្វើ កសិកម្ម ធម្មតា ទេ ត្រូវ រិះរក វិធី ធ្វើ យ៉ាងណា ឱ្យ ប្រជាកសិករ មាន ផលចំណេញ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នៅ ថ្ងៃ ម្សិលមិញ នេះ មិន មាន ករណី ឆ្លង ជំងឺ កូវីដ១៩ នោះ ទេ នេះ ជា ថ្ងៃទី ៤ហើយ ដែល កម្ពុជា មិន មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ។ បើ ទោះបី មាន ករណី ឆ្លង ថ្មី តែ សម្តេច តេជោ ហ៊ុន សែន នៅតែ បន្ត អំពាវនាវ ប្រជាពលរដ្ឋ ចូលរួម អនុវត្តន៍ វិធានការ នានា ដើម្បី ការពារ ជំងឺ កូវីដ១៩ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា មួយ គត់ ដែល រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេស ហើយ សម្តេច ក៏ បាន អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល នឹង ប្រព្រឹត្តិ ទៅ នៅ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង មាន នៅពេល ប្រជាពលរដ្ឋ មាន ទុក្ខលំបាក គណបក្ស ប្រជាជន កម្ពុជា រត់ រក បងប្អូន មិន ចាំបាច់ ភ័យ ព្រួយ នោះ ទេ ។
ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា បឋម ភូមិ សម្រាប់ ឆ្នាំ សិក្សា ២០២១ - ២០២២ ក្រសួង អប់រំ យុវជន និង កីឡា បន្ត ប្រគល់ សិទ្ធិ អំណាច និង ការទទួលខុសត្រូវ ទាំងស្រុង ជូន គ្រឹះស្ថាន មធ្យមសិក្សា នីមួយ ៗ រៀបចំ ការប្រឡង ចាប់តាំងពី ការរៀបចំ វិញ្ញាសារ ដំណើរការសំណេរ កំណែ ស្រង់ បូក ពិន្ទុ និង ប្រកាស លទ្ធផល តាម គ្រឹះស្ថាន មធ្យមសិក្សា នីមួយ ៗ ។
លោក បន្ត ថា ដំណើរការ ប្រឡង គឺ ប្រគល់ ជូន មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី - ខេត្ត ជា អ្នករៀបចំ ដ៏ ដែល ដោយ រក្សា យន្តការ ដូច ឆ្នាំ កន្លងមក ។
ថ្ងៃ នេះ ជា ថ្ងៃទី ៥នៃ ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ សូម ប្រជាពលរដ្ឋ អញ្ជើញ ទៅ ពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ !
បើកបរ សូម គោរព ច្បាប់ ចរាចរណ៍ គ្រប់ វិនាទី ! ស្លាប់ ៤នាក់ និង របួស ៩នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៣ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ និង ស្រាល ៩នាក់ ។
លោក Xi បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ប្រទេស ចិន មិន អាច អភិវឌ្ឍ ដោយ គ្មាន ពិភពលោក បាន ទេ ហើយ ពិភពលោក ក៏ ត្រូវ ការ ប្រទេស ចិន ផងដែរ ។ បន្ទាប់ពី រយៈពេល ជាង ៤០ ឆ្នាំ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ឥត ឈប់ឈរ ឆ្ពោះ ទៅរក កំណែទម្រង់ និង ការបើកចំហរ យើង បាន បង្កើត អព្ភូតហេតុ ពីរ គឺ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច យ៉ាង ឆាប់រហ័ស និង ស្ថិរភាព សង្គម រយៈពេល វែង » ។
ទន្ទឹម នឹង នោះ លោក បាន សន្យា ថា នឹង ធ្វើ ការ ដោយ ឧស្សាហ៍ ព្យាយាម ក្នុង ការបំពេញ ភារកិច្ច ដើម្បី បញ្ជាក់ ថា សក្ដិសម នឹង ការទុកចិត្ត ដ៏ អស្ចារ្យ របស់ គណប ក្កុ ម្មុយនិស្ដ ស និង ប្រជាជន ចិន ៕
ព្រឹក ស្អែក សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចែក ស្រូវ ពូជ ជូន ប្រជាពលរដ្ឋ ជាង ១ម៉ឺន គ្រួសារ នៅ ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ នៅ ព្រឹក ថ្ងៃចន្ទ ទី២៤ ខែតុលា ឆ្នាំ ២០២២ ស្អែក នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នឹង អញ្ជើញ ចែក ស្រូវ ពូជ និង សំណេះសំណាល ជាមួយ ប្រជាកសិករ ប្រមាណ ១១. ៥២៨ គ្រួសារ ដែល រង ផល ប៉ះពាល់ ដោយសារ ជំនន់ ទឹកភ្លៀង នៅ ខេត្ត បាត់ដំបង ។
ជំនួប ជាមួយ ប្រជាកសិករ នៅ ថ្ងៃស្អែក នេះ ក្រៅតែ ពី ផ្តល់ ស្រូវ ពូជ ហើយ នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន រៀបចំ កញ្ចប់ ស្បៀងអាហារ និង ថវិកា ជូន ដល់ ប្រជាកសិករ ដើម្បី ដោះស្រាយ ការលំបាក នៅក្នុង ជីវភាព ផងដែរ ។
របាយការណ៍ របស់ ក្រសួង កសិកម្ម បាន ឱ្យដឹង ថា ទឹក បាន ជន់ លិច ស្រូវ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ជាង ២២ម៉ឺន ហិកតា ក្នុង នោះ ស្រូវ រង ការខូចខាត មាន ប្រមាណ ១១ម៉ឺន ហិកតា ។ ផ្ទៃដី ដែល រង ការខូចខាត នេះ អាច ស្តារ ឡើងវិញ បាន ប្រមាណ ជា ៧ម៉ឺន ហិកតា ប៉ុណ្ណោះ ។ រាជ រដ្ឋាភិបាល គ្រោង បញ្ចេញ ស្រូវ ពូជ ប្រមាណ ជា ៧ពាន់ តោន ជូន ប្រជាកសិករ បង្កបង្កើន ផល ឡើងវិញ ៕
លោកស្រី ឃួន ឃុន ឌី៖ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ ត្រូវ រួមគ្នា ធ្វើ រួមគ្នា ទទួលខុសត្រូវ ទើប ទទួលបាន ជោគជ័យ
( កំពង់ធំ )៖ លោកស្រី ឃួន ឃុន ឌី សមាជិក ព្រឹទ្ធសភា និង ជា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក ក កំពង់ស្វាយ បាន ថ្លែង ថា សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ ត្រូវ រួមគ្នា ធ្វើ រួមគ្នា ទទួលខុសត្រូវ ទើប ទទួលបាន ជោគជ័យ ។
លោកស្រី ឃួន ឃុន ឌី បាន ថ្លែង ក្នុង កិច្ចប្រជុំ ប្រចាំ ខែ ដើម្បី ពង្រឹង ក្រុមការងារ ចុះ មូលដ្ឋាន តាម បណ្តា ឃុំ ក្នុង ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០២៣ នៅ ស្នាក់ការ គណបក្ស ស្រុក កំពង់ស្វាយ ។
ទន្ទឹមនឹង លទ្ធផល នេះ លោកស្រី បាន ស្នើ ឱ្យ ក្រុមការងារ ត្រូវ ខិតខំ បន្ត អភិវឌ្ឍ សមត្ថភាព បន្ថែម ទៀត ដើម្បី ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត នា ពេល ខាងមុខ និង ត្រូវ រួម សហការ គ្នា ក្នុង ការអនុវត្ត ការងារ សំខាន់ ៗ រួម មាន៖ ត្រូវ ថែរក្សា សុខ សន្តិភាព ស្ថិរភាព នយោបាយ និង រួមគ្នា ទប់ស្កាត់ ប្រឆាំង ដាច់ខាត សកម្មភាព បច្ចា មិត្ត នានា ។
លោកស្រី បាន ណែនាំ ដល់ មន្ត្រី គ្រប់ រូប ត្រូវ ធ្វើ ខ្លួន ជា មន្ត្រី ល្អ ជា អ្នកធ្វើ ការបម្រើ ស្ថាប័ន អង្គភាព ឱ្យ មាន ការីកចម្រើន និង បម្រើ ប្រជាពលរដ្ឋ ឱ្យ បាន ពិតប្រាកដ ៕
ឃាត់ខ្លួន ជនជាតិ ចិន ៤នាក់ ទៀត បម្រុង លួច ឆ្លង ដែន ខុស ច្បាប់ ទៅ ប្រទេស ឡាវ តាម ច្រក ព្រំដែន កំពង់ស្រឡៅ
( ព្រះវិហារ ) ៖ ជនជាតិ ចិន ចំនួន ៤នាក់ ទៀត ត្រូវបាន កម្លាំង សមត្ថកិច្ច ចម្រុះ ធ្វើ ការឃាត់ខ្លួន ក្រោយ ប៉ុនប៉ង លួច ឆ្លង ដែន ខុស ច្បាប់ ទៅ ប្រទេស ឡាវ តាម ច្រក ព្រំដែន កំពង់ស្រឡៅ ក្នុង ស្រុក ឆែប ខេត្ត ព្រះវិហារ កាលពី ព្រឹក ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០២២ នេះ ។
