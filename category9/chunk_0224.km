( ភ្នំពេញ ) ៖ លោក ឌី វិជ្ជា កូនប្រុស របស់ លោក ហុក ឡង់ ឌី អតីត អគ្គ ស្នងការ នគរបាល ជាតិ បាន ផ្ញើ សារ មួយ ថ្លែងអំណរគុណ ដល់ តុលាការ ទីក្រុង ប៉ារីស ប្រទេស បារាំង និង ក្រុម មេធាវី កម្ពុជា - បារាំង ដែល បាន បំពេញ ភារកិច្ច ជោគជ័យ ក្នុង ការនាំយក ភាពសច្ចៈ និង ស្អាតស្អំ ជូន សម្ដេច តេជោ និង រូបលោក ពាក់ព័ន្ធ នឹង ការចោទប្រកាន់ ញុះញង់ របស់ លោក សម រង្ស៉ី ។
លោក សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ តុលាការ ប្រទេស បារាំង ពិសេស ក្រុម មេធាវី ប្រទេស កម្ពុជា និង ក្រុម មេធាវី ប្រទេស បារាំង ដែល បាន បំពេញ ភារកិច្ច ជោគជ័យ ក្នុង ការនាំយក ភាពសច្ចៈ និង ស្អាតស្អំ ជូន សម្ដេច តេជោ និង រូបលោក ។
ខាងក្រោម នេះ លោក ឌី វិជ្ជា សូម ដកស្រង់ នូវ ចំណុច ខ្លះ ៗ នៃ សាលក្រម របស់ សាលាដំបូង ទីក្រុង ប៉ារីស ប្រទេស បារាំង ជូន ជា ការពិចារ ណា៖
លោក ឌី វិជ្ជា បាន បន្ថែម ថា តាមរយៈ សម្រង់ ខ្លឹមសារ ខ្លះ ៗ នៃ សាលក្រម ខាងលើ គឺ ច្បាស់ ណាស់ ថា សម រង្ស៉ី ជា អ្នកនយោបាយ ទុច្ចរិត គ្មាន សច្ចធម៌ គុណធម៌ រវើរវាយ ភូត កុហក បោកប្រាស់ និង ជា អ្នកនយោបាយ ពោរពេញ ដោយ គំនុំ បុគ្គល គំនិត សងសឹក និង ចូលចិត្ត ប្រឌិត សាច់រឿង ញុះញង់ បំបែកបំបាក់ និង បង្ក ចលាចល តាម អារម្មណ៍ រវើរវាយ របស់ ខ្លួន ។ វា ជា រឿង ដ៏ គួរឱ្យ អស់ សំណើច ដែល មនុស្ស ចាស់ ចំណាស់ នេះ ហើយ នៅតែ មាន ចរិត និង ចិត្ត គំនិត បែប នេះ ។
ព្រះរាជអាជ្ញា ខេត្ត កំពង់ឆ្នាំង នាំយក អំណោយ សម្តេច ចៅហ្វា វាំង គង់ សំអុល ចែកជូន ពលរដ្ឋ នៅ ស្រុក បរិបូរណ៌ និង នាំសារ ពី ការកាត់ក្តី នៅ តុលាការ បារាំង ដែល ផ្តល់ ភាពស្អាតស្អំ យុត្តិធម៌ ដល់ សម្តេច តេជោ
( កំពង់ឆ្នាំង ) ៖ លោក អុិត សុធា ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង ដឹកនាំ ព្រះរាជអាជ្ញា រង ប្រធាន លេខាធិការដ្ឋាន និង មន្ត្រី បម្រើការ នៅក្នុង ស្ថាបន័អយ្យការ ខេត្ត កំពង់ឆ្នាំង នៅ ព្រឹក ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន អញ្ជេីញ ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយដ៍ ថ្លៃថ្លា របស់ សម្តេច ចៅហ្វា វាំង គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ដ្រី ក្រសួង ព្រះបរម រាជ វាំង និង លោក គុយ សុផល ចែកជូន ប្រជាពលរដ្ឋ នៅ ឃុំ ពេជ្រ ចង្វារ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង ។
ស្ថិត នៅក្នុង ឱកាស នោះ ដែរ លោក អុិត សុធា ក៏ បាន ពាំនាំ នូវ សារ ដ៏ ល្អ ពី តុលាការ ប្រទេស បារាំង ដែល បាន កាត់ក្តី ផ្តល់ ភាពយុត្តិធម៌ និង ភាពស្អាតស្អំ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅក្នុង សំណុំរឿង បរិហាកេរ្តិ៍ ប្តឹង ទណ្ឌិត សម រង្ស៉ី ជូន ដល់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ស្រុក បរិបូរណ៌ ឱ្យ បាន ដឹង ផងដែរ ។
ជាមួយគ្នា នេះ ដែរ លោក ព្រះរាជអាជ្ញា បាន បន្ត ថា សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ប្រទេស បាន គិតគូរ ពី ប្រទេសជាតិ គិតគូរ ពី ប្រជាជន ធ្វើ យ៉ាងណា ឱ្យ ប្រទេស រួចផុត ពី ភាពក្រីក្រ ប្រជាជន មាន ភាព សម្បូរសប្បាយ រុងរឿង មាន ការរីកចម្រើន និង មាន ជីវភាព ធូរធា រក្សា បាន នូវ សុខ សន្តិភាព ជូន ប្រជាពលរដ្ឋ ។
ឆ្លៀត ក្នុង ឱកាស នេះ ផងដែរ លោក អុិត សុធា បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំ ផ្ញេី សួរ សុខទុក្ខ ពីសំណាក់ សម្តេច ចៅហ្វា វាំង គង់ សំអុល . លោក គុយ សុផល . លោក កុល ប៊ុន លី និង លោក សំ ប្រជាមានិត ចំពោះ ប្រជាពលរដ្ឋ ដែល ជានិច្ចកាល សម្តេច និង លោក ទាំងអស់ តែងតែ យកចិត្តទុកដាក់ ចំពោះ ប្រជាពលរដ្ឋ ក្នុង មួលដ្ឋាន ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ នោះ ឡើយ ។
សូម បញ្ជាក់ ផងដែរ ថា អំណោយ ដែល នាំយក ទៅ ចែកជូន ប្រជាពលរដ្ឋ នា ពេលនេះ មាន៖ អង្ករ មី ទឹកត្រី ទឹក សុី អីវ ត្រី ខ ទឹក ផ្លែឈើ គ្រប់ មុខ និង ថវិកា មួយ ចំនួន ៕ ក្រសួង និង ស្ថាប័ន ពាក់ព័ន្ធ ប្រជុំ កំណត់ របៀបវារៈ និង ការត្រៀម រៀបចំ កិច្ចប្រជុំ កំពូល អាជីវកម្ម បរិយាប័ន្ន អាស៊ាន លើក ទី៥ នៅ ខេត្ត សៀមរាប
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២២ នេះ លោក បណ្ឌិត ហេង សុខ គង់ រដ្ឋលេខាធិការ ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្រ្ត បច្ចេកវិទ្យា និង ន វានុវត្តន៍ និង ជា ប្រធាន ក្រុមការងារ តម្រង់ ទិស អាជីវកម្ម បរិយាប័ន្ន បាន ដឹកនាំ កិច្ចប្រជុំ លើក ទី១ នៃ ក្រុមការងារ តម្រង់ ទិស អាជីវកម្ម បរិយាប័ន្ន ( ក .ត. អ. ប) នៅ ទីស្តីការ ក្រសួង ។
កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពី លោក លោកស្រី ជា អនុប្រធាន និង សមាជិក សមាជិកា ក្រុមការងារ តម្រង់ ទិស អាជីវកម្ម បរិយាប័ន្ន គណៈកម្មការ វាយតម្លៃ ទទួលស្គាល់ អាជីវកម្ម បរិយាប័ន្ន និង ក្រុម លេខាធិការដ្ឋាន អាជីវកម្ម បរិយាប័ន្ន ដែល អញ្ជើញ មក ពី អន្តរ ក្រសួង ស្ថាប័ន និង វិស័យ ឯកជន សរុប ប្រមាណ ៤០ រូប ។
គោលបំណង នៃ កិច្ចប្រជុំ គឺ ដើម្បី ពិភាក្សា លើ របៀបវារ : សំខាន់ ៗ មួយចំនួន ដូច ខាងក្រោម៖
សូម ជម្រាប ថា ក្រុមការងារ តម្រង់ ទិស អាជីវកម្ម បរិយាប័ន្ន ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន ចេញ សេចក្តីសម្រេច បង្កើត នៅ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២២ នេះ ដែល មាន សមាសភាព មកពី អន្តរ ក្រសួង ស្ថាប័ន និង វិស័យ ឯកជន ចំនួន ២២ រូប ក្នុង នោះ មាន ប្រធាន ១រូប អនុប្រធាន ៥រូប និង សមាជិក ១៦ រូប ។
ដើម្បី អាច ផ្តល់ ជា ប្រយោជន៍ ដល់ ប្រជាជន និង អាជីវកម្ម ក្នុង ពេល តែ មួយ វា ជា ការចាំបាច់ ក្នុង ការមាន វិធីសាស្ត្រ កាត់បន្ថយ ហានិភ័យ ដ៏ ល្អ មួយ ប្រភេទ អាជីវកម្ម ដែល សមស្រប និង ន វានុវត្តន៍ សង្គម និង គោលបំណង អាជីវកម្ម បរិយាប័ន្ន ដ៏ រឹងមាំ របស់ ក្រុមប្រឹក្សាភិបាល នៃ ក្រុមហ៊ុន ដែល ជំរុញ បន្ទាត់ អាជីវកម្ម បរិយាប័ន្ន ។
និយាម ទីផ្សារ និង ការផ្តល់ ដំណោះស្រាយ ថ្មី ៗ ប្រកបដោយ ការច្នៃប្រឌិត ត្រូវបាន ប្រើប្រាស់ ដើម្បី ពង្រឹង អំណាច សេដ្ឋកិច្ច និង ផ្តល់ ផល វិជ្ជមាន ដល់ សង្គម ពិសេស ជូន ដល់ ប្រជាជន ប្រមាណ ជាង ៣០០ លាន នាក់ ក្នុង បណ្តា ប្រទេស អាស៊ាន ដែល កំពុង ស្ថិត នៅ បាត នៃ ពីរ៉ាមីត ។
ការលើកឡើង របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើឡើង នៅក្នុង សុន្ទរកថា មួយ ថ្លែង ក្នុង ពិធី បិទ កិច្ច បជុំ កំពូល ស្រ្តី អាស៊ាន លើក ទី២ ក្រោម ប្រធានបទ « ការកសាង អនាគត ប្រកបដោយ ចីរភាព បរិយា បន្ន និង កាន់តែ រឹង មាំ៖ បំផុស សហគ្រិន ភាព របស់ ស្ត្រី នៅក្នុង អាស៊ាន » នៅ ល្ងាច ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២២ នេះ ។
សម្តេច តេជោ បាន លើកទឹកចិត្ត ឱ្យ អាស៊ាន បន្ត រៀបចំ កិច្ចប្រជុំ កំពូល នេះ នៅ ឆ្នាំ បន្តបន្ទាប់ ទៀត ដើម្បី ជា សក្ខីភាព នៃ ការប្ដេជ្ញាចិត្ត របស់ ថ្នាក់ដឹក នៃ បណ្តា ប្រទេស អាស៊ាន នៅក្នុង បុព្វហេតុ នៃ ការសម្រេច ឱ្យ បាន នូវ សមភាព យេនឌ័រ នៅក្នុង ប្រទេស និង ក្នុង តំបន់ ។
សម្តេច មាន ជំនឿ យ៉ាង មុតមាំ ថា សេចក្ដីថ្លែងការណ៍ ស្តីពី « ការកសាង អនាគត ប្រកបដោយ ចីរភាព បរិយា បន្ន និង កាន់តែ រឹង មាំ៖ ការបំផុស សហគ្រិន ភាព របស់ ស្ត្រី នៅក្នុង អាស៊ាន » ដែល យើង បាន ពិភាក្សា នា ថ្ងៃ នេះ នឹង ទទួលបាន ការគាំទ្រ និង ការអនុម័ត លើ នៅក្នុង កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ទី៤១ នៅក្នុង ខែវិច្ឆិកា ឆ្នាំ ២០២២ ខាងមុខ ៕
ការថ្លែង របស់ សម្តេច តេជោ ធ្វើឡើង ក្នុង ឱកាស ថ្លែង ក្នុង ពិធី បិទ កិច្ច បជុំ កំពូល ស្រ្តី អាស៊ាន លើក ទី២ ក្រោម ប្រធានបទ « ការកសាង អនាគត ប្រកបដោយ ចីរភាព បរិយា បន្ន និង កាន់តែ រឹង មាំ៖ បំផុស សហគ្រិន ភាព របស់ ស្ត្រី នៅក្នុង អាស៊ាន » ។
ក្នុង ឱកាស នោះ សម្តេច តេជោ បាន ថ្លែងអំណរគុណ ចំពោះ ថ្នាក់ដឹកនាំ នៃ បណ្តា ប្រទេស អាស៊ាន និង ប្រទេសជា ដៃគូ ដែល បាន ថ្លែង អំពី ការប្តេជ្ញាចិត្ត និង ឆន្ទៈ ដ៏ មុតមាំ ក្នុង ដំណើរ ឆ្ពោះទៅ មុខ ជាមួយគ្នា ក្នុង ការបំផុស សហគ្រិន ភាព របស់ ស្ត្រី នៅក្នុង អាស៊ាន ស្រប តាម ប្រធានបទ ដែល បាន ដាក់ចេញ ។
សម្តេច បន្ត ថា ការទទួលស្គាល់ ភាពចាំបាច់ នៃ ការពង្រឹង សហគ្រិន ភាព និង ភាពអង់អាច ផ្នែក សេដ្ឋកិច្ច របស់ ស្ត្រី គឺជា ការបោះជំហាន ទៅ មុខ យ៉ាង សំខាន់ និង ជា កត្តា ចាំបាច់ និង មិន អាច ខ្វះ បាន ។
សម្តេច បាន បង្ហាញ នូវ សេចក្តីរីករាយ និង មាន កម្លាំងចិត្ត ប្រកបដោយ សុទិដ្ឋិនិយម ដោយ បាន សង្កេតឃើញ ថា សមាជិក អាស៊ាន មាន ទស្សនៈ វិស័យ ដូចគ្នា និង មាន ជំហរ រួមគ្នា ក្នុង ការបន្ត លើកកម្ពស់ សមភាព យេនឌ័រ ការផ្តល់ សិទ្ធិ អំណាច និង ការគាំទ្រ ដល់ ស្ត្រី ដែល ជា គុណ តម្លៃ ដ៏ វិសេសវិសាល សម្រាប់ ការអភិវឌ្ឍ សហគមន៍ អាស៊ាន ទាំងមូល ជាពិសេស ក្នុង បរិការណ៍ នៃ ការស្ដារ សេដ្ឋកិច្ច ក្នុង តំបន់ ឡើងវិញ ប្រកបដោយ ចីរភាព បរិយា បន្ន និង ភាពរឹងមាំ ក្រោយពី វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ទៀត ថា « រដ្ឋាភិបាល នៃ បណ្ដា ប្រទេស អាស៊ាន ទាំងអស់ មាន កាតព្វកិច្ច ធានា ឱ្យ បាន នូវ សមភាព សម្រាប់ ស្រ្តី ក្នុង ការទទួលបាន ការអប់រំ ការបណ្ដុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ភាព ជា ម្ចាស់ លើ ការគ្រប់គ្រង ធនធាន ហិរញ្ញវត្ថុ សិទ្ធិ ចូលរួម ក្នុង ការសម្រេចចិត្ត និង ភាព ជា អ្នកដឹកនាំ ដើម្បីឱ្យ ស្ត្រី គ្រប់ រូប មាន ឱកាស ពេញលេញ ទាំង ក្នុង ទិដ្ឋភាព សង្គម - សេដ្ឋកិច្ច ពាណិជ្ជកម្ម និង ទិដ្ឋភាព នយោបាយ » ។
សេដ្ឋកិច្ច នៃ បណ្តា ប្រទេស ក្នុង អាស៊ាន ពឹងផ្អែក ខ្លាំង លើ សហគ្រាស ធុន មីក្រូ តូច និង មធ្យម ដែល ដឹកនាំ ដោយ ស្ត្រី ។ ជាក់ស្ដែង កម្ពុជា មាន សហគ្រាស ធុន មីក្រូ តូច និង មធ្យម រហូតដល់ទៅ ៩៨ % នៃ ចំនួន សហគ្រាស សរុប ដែល បាន ចូលរួមចំណែក ដល់ សេដ្ឋកិច្ច ជាតិ ប្រមាណ ៥៨ % និង បាន ផ្តល់ ការងារ ប្រមាណ ៧៣ % នៃ ការងារ សរុប ។
នៅ កម្ពុជា ស្ត្រី គឺជា អ្នកបង្កើត និង គ្រប់គ្រង ប្រមាណ ៦១ % នៃ ចំនួន សរុប នៃ សហគ្រាស ធុន មីក្រូ តូច និង មធ្យម ។ ការណ៍ នេះ បាន ធ្វើឱ្យ រាជ រដ្ឋាភិបាល កម្ពុជា កំណត់ និង ជំរុញ ការលើកតម្កើង ស្រ្តី ជា ឆ្អឹង ខ្នង នៃ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច ជាតិ តាមរយៈ ការបង្កើន ការវិនិយោគ លើ សមភាព យេនឌ័រ និង ការលើកកម្ពស់ តួនាទី របស់ ស្ត្រី នៅក្នុង កិច្ចអភិវឌ្ឍ នៅ គ្រប់ វិស័យ និង គ្រប់ កម្រិត ៕
ប្រធាន សាលាឧទ្ធរណ៍ និង អគ្គ ព្រះរាជអាជ្ញា សាលាឧទ្ធរណ៍ ភ្នំពេញ ដឹកនាំ កិច្ចប្រជុំ ពង្រឹង កិច្ចសហប្រតិបត្តិការ អនុវត្ត ច្បាប់ រវាង មន្ដ្រី នគរបាល យុត្តិធម៌ និង តុលាការ នៅ សាលាដំបូង ខេត្ត កណ្តាល
( កណ្ដល ) ៖ លោក សេង សុី វុត្ថា ប្រធាន សាលាឧទ្ធរណ៍ ភ្នំពេញ និង លោក អ៊ុក សាវុធ អគ្គ ព្រះរាជអាជ្ញា អម សាលាឧទ្ធរណ៍ នៅ ព្រឹក ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជា អធិបតីភាព បើក កិច្ចប្រជុំ ស្ដីពី « ការពង្រឹង កិច្ចសហប្រតិបត្តិការ អនុវត្ត ច្បាប់ រវាង មន្រ្តី នគរបាល យុត្តិធម៌ និង តុលាការ » នៅ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ខេត្ត ណ្ដាល ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី អនុប្រធាន សាលាឧទ្ធរណ៍ អគ្គ ព្រះរាជអាជ្ញា រង ចៅក្រម ទីប្រឹក្សា និង ក្រុមការងារ នៃ សាលាឧទ្ធរណ៍ និង មហា អយ្យការ អម សាលាឧទ្ធរណ៍ ភ្នំពេញ . លោក ហុក វ៉ាន់ធី ណា ប្រធាន សាលាដំបូង ខេត្ត កណ្ដា និង លោក លាវ ស្រេង ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កណ្ដាល និង លោក លោកស្រី ចៅក្រម ព្រះរាជអាជ្ញា រង លេខាធិការ នៃ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ខេត្ត កណ្ដាល និង អ្នក ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ផងដែរ ។
នៅក្នុង កិច្ចប្រជុំ នេះ មាន គោលបំណង ធំ ៗ ៣គឺ ទី ១៖ ការពង្រឹង កិច្ចសហប្រតិបត្តិការ អនុវត្ត ច្បាប់ រវាង ស្ថាប័ន តុលាការ - អយ្យការ ជាមួយ មន្រ្តី នគរបាល យុត្តិធម៌ . ទី ២៖ ការពង្រឹង តួនាទី ភារកិច្ច បេសកកម្ម របស់ មន្រ្តី នគរបាល យុត្តិធម៌ ក្នុង ការបង្ក្រាប បទល្មើស និង ការកសាង សំណុំរឿង ទៅ តុលាការ និង ទី ៣៖ ដោះស្រាយ បញ្ហា ប្រឈម នានា ក្នុង ការអនុវត្ត នីតិវិធី ច្បាប់ ។
លោក សេង សុី វុត្ថា បាន លើកឡើង ថា ក្នុង កិច្ចប្រជុំ នេះ បណ្តាល មកពី កត្តា សន្តិភាព និង ស្ថានភាព កូវីដ១៩ ស្ថិត ក្នុង ស្ថានភាពធូរស្រាល និង សម្តែង នូវ ការកោតស សើរ ជូន ចំពោះ មន្ត្រី នគរបាល យុត្តិធម៌ និង អាជ្ញាធរ តុលាការ ខេត្ត កណ្តាល ទាំងអស់ ដែល បាន រួម សហការ គ្នា អនុវត្ត ការងារ បាន ល្អ ប្រសើរ ប្រកបដោយ ជោគជ័យ ជូន ជាតិ និង ប្រជាជន ពិសេស ប្រជាជន ខេត្ត កណ្តាល ទាំងមូល ប្រកបដោយ ប្រសិទ្ធភាព និង ការទទួលខុសត្រូវ ខ្ពស់ ។
លោក ក៏ បាន លើកឡើង អំពី បទពិសោធន៍ ក្នុង ការអនុវត្ត ការងារ កន្លងមក ទាំង ខ្លឹមសារ ច្បាប់ ទាំង បច្ចេកទេស និង ឥរិយាបថ របស់ អ្នក អនុវត្ត ច្បាប់ ។
លោក គូសបញ្ជាក់ ថា នគរបាល យុត្តិធម៌ និង អាជ្ញាធរ តុលាការ ជា ស្ថាប័ន ជាតិ ដែល មាន បន្ទុក ទទួលខុសត្រូវ វិស័យ យុត្តិធម៌ និង ការផ្តល់ សេវា យុត្តិធម៌ ឆាប់រហ័ស ជូន ប្រជាពលរដ្ឋ ដោយ ផ្អែក លើ គោលការណ៍ ច្បាប់ ជាធរមាន ដើម្បី សម្រេច ជោគជ័យ និង ទទួលបាន ការគាំទ្រ ការជឿទុកចិត្ត ពី ប្រជាពលរដ្ឋ មក លើ ស្ថាប័ន អនុវត្ត ច្បាប់ ។
លោក បន្ថែម ទៀត ថា ក្នុង នាម ជា អ្នក អនុវត្ត ច្បាប់ « យល់ ត្រូវ អនុវត្ត ត្រូវ ជា ប្រយោជន៍ ដល់ ភាគី និង ទទួលបាន យុត្តិធម៌ បើ យល់ ខុស អនុវត្ត ខុស ភាគី ទទួលបាន អយុត្តិធម៌ » ។ ជាមួយគ្នា នេះ លោក ក៏ បាន ណែនាំ ដល់ មន្រ្តី នគរបាល យុត្តិធម៌ ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ពិនិត្យ ឱ្យ បាន ហ្មត់ចត់ និង គ្រប់ ជ្រុងជ្រោយ និង ជៀសវាង កង្វះ ការចាត់ចែង ក្នុង ពេល បំពេញ កិច្ច របស់ ខ្លួន ។
លោក សេង សុី វុត្ថា បាន ណែនាំ និង ផ្តាំផ្ញើ ដល់ សាលាដំបូង ខេត្ត និង អយ្យការ អម សាលាដំបូង ខេត្ត កណ្ដាល និង មន្រ្តី នគរបាល យុត្តិធម៌ ទាំងអស់ គ្រប់ ផ្នែក និង ជំនាញ នូវ ៥ចំណុច សំខាន់ ៗ មួយចំនួន រួម មាន៖
ទន្ទឹមនឹង សារ នេះ ដែរ លោក អ៊ុក សាវុធ បាន ណែនាំ ដល់ អាជ្ញាធរ តុលាការ និង មន្រ្តី នគរបាល យុត្តិធម៌ យកចិត្តទុកដាក់ ខ្ពស់ ជាមួយ សំណុំរឿង អនីតិជន ដោយ អនុវត្ត ឱ្យ ស្រប តាម នីតិវិធី កុមារ មេត្រី និង ស្រប តាម ច្បាប់ ជាធរមាន ជាពិសេស យកចិត្តទុកដាក់ ការបង្ក្រាប លើ បទល្មើស គ្រឿងញៀន និង បញ្ហា គុណភាព ទំនិញ ក្នុង មូលដ្ឋាន ខេត្ត កណ្ដាល ។
នៅ ឱកាស ក្នុង កិច្ចប្រជុំ នេះ សមាជិក សមាជិការ នៃ អង្គប្រជុំ ទាំងមូល បាន លើកឡើង ជា សំណួរ សំណូមពរ និង បញ្ហា ប្រឈម នានា ក្នុង ការអនុវត្ត ច្បាប់ យ៉ាង ផុសផុល ហើយ គណៈអធិបតី បាន ពន្យល់ បកស្រាយ និង ដោះស្រាយ ជូន អង្គប្រជុំ ទាំងមូល បាន ជោគជ័យ ប្រកបដោយ ស្មារតី សាមគ្គី និង ការទទួលខុសត្រូវ ខ្ពស់ ។
ត្រូវ និយាយ ថា ទេ ចំពោះ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១២ ខែតុលា៖ បង្ក្រាប ១៣ករណី ឃាត់ខ្លួន ២១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៣ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៣ករណី . ដឹកជញ្ជូន រក្សាទុក ៣ករណី និង ជួញដូរ ៧ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ២១ នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន៖ ទិវា ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ផ្ដល់ កម្ពុជា នូវ ការចងចាំ ពី ប្រទេស មាន គ្រោះមហន្តរាយ ធំ ធេង បង្ក ដោយ សង្គ្រាម មក ជា ប្រទេស មាន សន្តិភាព
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ថ្លែង ថា ទិវា ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ផ្ដល់ ដល់ កម្ពុជា នូវ ការចងចាំ ពី ប្រទេស មាន គ្រោះមហន្តរាយ ធំ ធេង បង្ក ដោយ សង្គ្រាម មក ជា ប្រទេស មាន សន្តិភាព ពេញលេញ ។
នេះ បើ តាម សារ លិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស នៃ ការប្រារព្ធ ទិវា ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ រួម ជាមួយ ទិវា អាស៊ាន គ្រប់គ្រង គ្រោះមហន្តរាយ និង ទិវា អន្តរជាតិ កាត់បន្ថយ ហានិភ័យ គ្រោះមហន្តរាយ ក្រោម មូល បទ « រួមគ្នា ដើម្បី លើកកម្ពស់ តុល្យការសកម្មភាព មូលដ្ឋានីយកម្ម សម្រាប់ ភាពធន់ នឹង គ្រោះមហន្តរាយ » ដែល ត្រូវ ធ្វើឡើង នៅ ថ្ងៃទី ១៣ ខែតុលា ឆ្នាំ ២០២២ ស្អែក នេះ ។
( ភ្នំពេញ ) ៖ កិច្ចប្រជុំ កំពូល ស្ត្រី អាស៊ាន លើក ទី២ ដែល ធ្វើឡើង ក្នុង ទម្រង់ ផ្ទាល់ និង អនឡាញ នៅ រសៀល ថ្ងៃពុធ ទី ១២ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន បិទ បញ្ចប់ ហើយ បន្ទាប់ពី មាន ការថ្លែង បង្ហាញ ទស្សនៈ និង មតិ នានា ពាក់ព័ន្ធ នឹង ប្រធានបទ ពីសំណាក់ ថ្នាក់ដឹកនាំ អាស៊ាន និង អ្នក ពាក់ព័ន្ធ ។
វា គ្មិន សំខាន់ ដែល បាន ថ្លែង ក្នុង កិច្ចប្រជុំ នេះ រួម មាន នាយក រដ្ឋមន្ត្រី ថៃ វៀតណាម ឡាវ ប្រធានាធិបតី ហ្វីលី ពិន អគ្គ លេខាធិការ អាស៊ាន ស្ត្រី ជា ថ្នាក់ដឹកនាំ លើ ការងារ ស្ត្រី មកពី ប្រទេស សមាជិក អាស៊ាន និង ស្ត្រី មកពី វិស័យ ឯកជន ពាក់ព័ន្ធ ការធ្វើ ធុរកិច្ច ផងដែរ ។
( ភ្នំពេញ ) ៖ សម្តេច ចៅហ្វា វាំង វរ វៀង ជ័យ អធិបតី ស្រឹង្គារ គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ព្រះបរម រាជ វាំង
នា ព្រឹក ថ្ងៃពុធ ទី ១២ ខែតុលា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ដង្ហែរ អង្គក ឋិន ដែល ជា ព្រះរាជ ទាន ព្រះករុណា សម្តេច ព្រះបាទ ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា និង សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ រួមទាំង ពុទ្ធ បរិស័ទ គ្រប់ ទិសទី ដង្ហែ មក ថ្វាយ ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ត ស្វាយ ពពែ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ។
តាមរយៈ បណ្តាញ ព័ត៌មាន Fresh News សម្តេច ព្រះមហាសង្ឃរាជ បួរ គ្រី ក៏ បាន មាន បន្ទូល ថ្លែងអំណរ ព្រះរាជ គុណ យ៉ាង ជ្រាវ ជ្រៅ បំផុត ចំពោះ ព្រះរាជ ទាន អង្គ ព្រះកឋិន ព្រះមហាក្សត្រ និង សម្តេច ព្រះមហាក្សត្រី រួមទាំង ពុទ្ធ បរិស័ទ គ្រប់ ទិសទី ដង្ហែ មក ថ្វាយ ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ត ស្វាយ ពពែ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ដើម្បី រួបរួម បច្ច័យ កសាង អគារ សិក្សា ថ្មី កម្ពស់ ៩ជាន់ នៃ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា ។
សូម រំលឹក ថា កាលពី ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០២២ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត តំណាង សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិតិ្ត ព្រឹទ្ធបណ្ឌិត បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បញ្ចុះ បឋមសិលា និង បុណ្យ ផ្កា សាមគ្គី កសាង អគារ សិក្សា ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា ស្ថិត ក្នុង វត្ត ស្វាយ ពពែ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ផងដែរ ។
កម្មវិធី នេះ គឺជា ការប្រកួតប្រជែង លើ ការវិភាគ ទិន្នន័យ ដែល មាន គោលបំណង គាំទ្រ និង ជំរុញ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ ធនធាន មនុស្ស ស្រប តាម ផែនការ មេបច្ចេកវិទ្យា គមនាគមន៍ និង ព័ត៌មាន អាស៊ាន ឆ្នាំ ២០២០ ។ ក្នុង នោះ ដែរ កម្មវិធី នេះ ធ្លាប់ បាន ទទួលស្គាល់ ដោយ ថ្នាក់ដឹកនាំ អាស៊ាន ថា ជា គំនិត ផ្តួចផ្តើម ឌីជីថល ប្រកបដោយ ភាពច្នៃប្រឌិត នៅក្នុង កិច្ចប្រជុំ កំពូល អាស៊ាន ចំនួន ២លើ ក រួច មកហើយ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី ជា វ៉ាន់ ដេត បាន លើកឡើង ថា ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ដែល ជា ក្រសួង ទទួលបន្ទុក លើ វិស័យ ឌីជីថល បាន នឹង កំពុង ជំរុញ ការអភិវឌ្ឍ បច្ចេកវិទ្យា ឌីជីថល នៅ កម្ពុជា ដើម្បី ជំរុញ ការកសាង សេដ្ឋកិច្ច និង សង្គម ឌីជីថល ៕
រុស្ស៉ី ចាប់ខ្លួន ជនសង្ស័យ ៨នាក់ ជុំវិញ ករណី បំផ្ទុះ ស្ពាន គ្រីមៀ
( មូស្គូ ) ៖ ទីភ្នាក់ងារ សន្តិសុខ សហព័ន្ធ (FSB) នៃ ប្រទេស រុស្ស៉ី នៅ ថ្ងៃពុធ នេះ បាន និយាយ ថា ខ្លួន បាន ឃាត់ខ្លួន ជនជាតិ រុស្ស៉ី ៥នាក់ ព្រមទាំង ពលរដ្ឋ អ៊ុយក្រែន និង អាមេនី សរុប ចំនួន ៣នាក់ ជុំវិញ ហេតុការណ៍ ផ្ទុះ ដែល បាន បង្ក ការខូចខាត ចំពោះ ស្ពាន គ្រីមៀ កាលពី ថ្ងៃសៅរ៍ ចុង សប្តាហ៍ មុន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃពុធ ទី ១២ ខែតុលា ឆ្នាំ ២០២២ ។
ទីភ្នាក់ងារ FSB បាន អះអាង ថា ការបំផ្ទុះ ខាងលើ ត្រូវបាន រៀបចំឡើង ដោយ នាយកដ្ឋាន ស៉ើបការណ៍ សម្ងាត់ នៃ ក្រសួង ការពារ ជាតិ របស់ អ៊ុយក្រែន ហើយនិង ប្រធាន នាយកដ្ឋាន នោះ គឺ លោក គីរីឡូ ប៊ូដា ណូវ (Kyrylo Budanov) ។ អ៊ុយក្រែន មិន បាន ចេញមុខ អះអាង ថា ខ្លួន មាន ជាប់ពាក់ព័ន្ធ ក្នុង ហេតុការណ៍ លើ ស្ពាន គ្រីមៀ ឡើយ ប៉ុន្តែ ក្រុម មន្រ្តី អ៊ុយក្រែន មួយចំនួន បាន នាំគ្នា សម្តែង ការសាទរ ចំពោះ ការខូចខាត នៃ ស្ពាន នោះ ។
ការផ្ទុះ កាលពី ថ្ងៃសៅរ៍ ចុង សប្តាហ៍ កន្លងទៅ នៅលើ ស្ពាន គ្រីមៀ បាន បំផ្លាញ ចំណុច មួយ កំណាត់ នៅ ផ្នែក ផ្លូវថ្នល់ របស់ ស្ពាន ដែល បណ្តាលឱ្យ ការធ្វើចរចារណ៍ ទៅ មក ត្រូវបាន ផ្អាក ជា បណ្តោះអាសន្ន ។ មិន តែ ប៉ុណ្ណោះ វា ក៏ បាន បំផ្លាញ ស៉ី ទែន ផ្ទុក ប្រេងឥន្ធនៈ មួយចំនួន ដែល ដឹកជញ្ជូន តាម ផ្នែក ផ្លូវ រថភ្លើង ចេញ ពី តំបន់ ភាគ ខាងត្បូង ប្រទេស រុស្ស៉ី ឆ្ពោះ ទៅកាន់ ឧបទ្វីប គ្រីមៀ ផងដែរ ។
ប្រទេស ចិន ឈានចូល ប្រទេស បែប ន វានុវត្តន៍ កម្លាំង ចលករ មកពី ន វានុវត្តន៍ កាន់តែ ខ្លាំងក្លា
ក្នុង មួយ ទសវត្សរ៍ ចុងក្រោយ នេះ កម្លាំង ន វានុវត្តន៍ របស់ ចិន រឹតតែ ខ្លាំងក្លា កិច្ច កសាង ប្រទេស ខ្លាំង ខាង វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា បាន ពន្លឿន ជំហាន ទៅ មុខ ។ សមត្ថភាព ន វានុវត្តន៍ ចម្រុះ របស់ ជាតិ បាន ឡើង ដល់ លេខរៀង ទី ១១ នៃ ពិភពលោក ដែល បាន ចាប់ផ្តើម ដំណាក់កាល ថ្មី នៃ ការជំរុញ ការកសាង ប្រទេស ខ្លាំង ខាង វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា ។ នេះ គឺ ទសវត្សរ៍ ដែល វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា ផ្តល់ កម្លាំង ចលករ ដល់ ការអភិវឌ្ឍ ប្រកបដោយ គុណភាព ខ្ពស់ ជា និរន្តរភាព ។
ការសម្រេច បច្ចេវិទ្យា គន្លឹះ សំខាន់ ៗ ជំរុញ ឧស្សាហកម្ម ឡើង ដល់ កម្រិត មធ្យម និង ខ្ពស់ ។ បរិក្ខា មាន សមត្ថភាព ខ្ពស់ មនុស្ស យន្ត វៃ ឆ្លាត ការផលិត ដោយ ឡាស៊ែ ដែល បាន សម្រេច បច្ចេកវិទ្យា ថ្មី បាន ជំរុញ យ៉ាង ខ្លាំង នូវ ការធ្វើឱ្យ ប្រសើរឡើង នូវ ឧស្សាហកម្ម ផលិត ទំហំ រថយន្ត ដើរ ដោយ ថាមពល ថ្មី និង ឧស្សាហកម្ម ម៉ូនីទ័រ បែប ថ្មី ជាប់ ចំណាត់ថ្នាក់ លេខ មួយ លើ ពិភពលោក រហូតដល់ បច្ចុប្បន្ន មាន លទ្ធផល បច្ចេកវិទ្យា អវកាស ចំនួន ជាង ២០០០ បាន បម្រើ ប្រទេសជាតិ និង ជីវភាព រស់ នៅ របស់ ប្រជាជន ។
អភិបាល រង ស្រុក បារាយណ៍ នាំយក អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ៣២ គ្រួសារ នៅ ភូមិ ចតុ លោក ឃុំ បារាយណ៍
( កំពង់ធំ )៖ លោកស្រី ហាក់ ពុទ្ធិ តុសិតា អភិបាល រង ស្រុក បារាយណ៍ និង ជា អនុប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ បារាយណ៍ និង ក្រុមការងារ បាន នាំយក អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ចំនួន ៣២ គ្រួសារ នៅ ភូមិ ចតុ លោក ឃុំ បារាយណ៍ ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២២ ។
ជាមួយគ្នា នេះ លោកស្រី ហាក់ ពុទ្ធិ តុ សិតា បាន ពាំនាំ ការសាកសួរ សុខទុក្ខ ពី ថ្នាក់ដឹកនាំ ដែល តែងតែ យកចិត្តទុកដាក់ ប្រជាពលរដ្ឋ ខ្វះខាត រងគ្រោះ និង ងាយ រងគ្រោះ ក្នុង ពេល ដែល កំពុង រង ផល ប៉ះពាល់ ដោយ គ្រោះ ធម្មជាតិ ជំនន់ ទឹកភ្លៀង នៅ តាម មូលដ្ឋាន នានា មួយចំនួន ក្នុង ស្រុក បារាយណ៍ ក៏ ដូចជា ខេត្ត កំពង់ធំ យើង ។
លោស្រី បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ត្រូវ មើល ថែទាំ កូន ចៅ តូច ៗ មិន ត្រូវ បណ្ដែតបណ្ដោយ ឱ្យ លេង ទឹក ខ្លាច មាន គ្រោះថ្នាក់ ដល់ អាយុជីវិត នឹង ត្រូវ ខិតខំ ថែរក្សា សុខភាព អនាម័យ ក្នុង ការបរិភោគ ចំណីអាហារ ជៀសវាង ឆ្លង ជំងឺ ដង្កាត់ ផ្សេង ៗ និង ត្រូវ ត្រៀមលក្ខណៈ រៀបចំ ការបង្កបង្កើន ផល ស្រូវ ឡើងវិញ នៅ រដូវ សម្រក ខាងមុខ នេះ ។
លោកស្រី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រៀល ជ្រៅ ដល់ សប្បុរសជន ជិត ឆ្ងាយ ទាំង ក្នុង ស្រុក និង ក្រៅ ស្រុក ដែល តែងតែ ផ្តល់ អំណោយ មនុស្សធម៌ ក៏ ដូចជា សហការ ជាមួយ រដ្ឋបាល ស្រុក ក្នុង ការផ្ដល់ នូវ សម្ភារ ថវិកា សម្រាប់ រដ្ឋបាល ស្រុក មាន លទ្ធភាព បន្ត ចែកជូន ដល់ ពលរដ្ឋ ដែល កំពុង រងគ្រោះ នៅក្នុង មូលដ្ឋាន ជាពិសេស ប្រជាពលរដ្ឋ ក្រីក្រ ។
លើស ពី នេះ លោកស្រី បាន ណែនាំ ដល់ រដ្ឋបាល ឃុំ ត្រូវ ចេះ កៀរគរ ធនធាន ពី សប្បុរសជន នានា ដើម្បី បានជា មូលនិធិ សម្រាប់ រដ្ឋបាល ឃុំ ក្នុង ការជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ឧបទ្ទវហេតុ ឬ ទឹក ជំនន់ ជាដើម និង ជា មូលនិធិ ក្នុង ការថែទាំ ជួសជុល ផ្លូវ លំ លូ ស្ពាន និង ហេដ្ឋារចនាសម្ព័ន្ធ នានា ដែល រង ខូចខាត ដោយ ទឹក ជំនន់ ជាដើម ។
ជា ចុងបញ្ចប់ លោកស្រី ហាក់ ពុទ្ធិ តុ សិតា បាន ជំរុញ ឲ្យ រដ្ឋបាល ឃុំ ត្រូវ ផ្សព្វផ្សាយ និង ជូន ដំណឹង ឲ្យបាន ទូលំទូលាយ ដល់ ប្រជាពលរដ្ឋ របស់ ខ្លួន ឲ្យ ទៅ ពិនិត្យ ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា ។ ប្រជាពលរដ្ឋ ៣២ គ្រួសារ ដោយ ក្នុង មួយ គ្រួសារ ទទួលបាន នូវ អង្ករ ចាន ឆ្នាំង មុង ភួយ និង ថវិកា ១ម៉ឺន រៀល ៕ NASA ប្រកាស ជោគជ័យ ក្នុង ការធ្វើតេស្ត បំបុក យានអវកាស ដើម្បី ផ្លាស់ប្តូរ គន្លង គោចរ របស់ អាចម៍ផ្កាយ កាលពី ខែកញ្ញា
