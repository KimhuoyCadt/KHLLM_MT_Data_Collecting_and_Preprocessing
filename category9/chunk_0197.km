យោង តាម ការស្រាវជ្រាវ មួយចំនួន ការត្រាំ ខ្លួន ក្នុង ទឹក ក្តៅ ធ្វើឱ្យ ស្ត្រី កំពុង ឈឺ ពោះ ហៀប នឹង សម្រាល អាច បន្ធូរ អារម្មណ៍ និង បង្កើន កម្លាំង កំហែង ដើម្បី ត្រៀម ប្រឹង បញ្ចេញ កូន មក ក្រៅ ។
ម តិ មួយចំនួន បាន អះអាង ថា ទឹក អាច សម្រួល ដល់ ការធ្វើ ចលនា បណ្តែត ខ្លួន របស់ ស្ត្រី និង ងាយ ឱ្យ ស្ត្រី ផ្លាស់ប្តូរ ឥរិយាបថ ក្នុង ការប្រឹង ឱ្យ ទារក ចេញមក ក្រៅ កាត់បន្ថយ ការឈឺចាប់ និង រហែក នៃ មាត់ ស្បូន ជាដើម ។
យ៉ាងណាមិញ ប្រធានបទ ពី ការបង្កើត កូន ក្នុង អាងទឹក នេះ មិន ទាន់ ត្រូវបាន អ្នកជំនាញ សិក្សា ស្រាវជ្រាវ ឱ្យ បាន ពេញលេញ នៅឡើយ ខណៈ ដែល វិធីសាស្ត្រ បង្កើត កូន នេះ ក៏ មាន មិន ច្រើន ករណី ដែរ ពោលគឺ ចន្លោះ ឆ្នាំ ១៩៨៥ដល់ ១៩៩៩ ក្នុង ពិភពលោក មាន ទារក ១៥ម៉ឺន នាក់ ប៉ុណ្ណោះ បាន កើត តាមរយៈ វិធី សម្រាល ក្នុង អាងទឹក ។
អំឡុង ពេល ៣០ ឆ្នាំ នេះ ថ្វីត្បិតតែ ការសម្រាល កូន ក្នុង អាងទឹក ហាក់ មាន ប្រជាប្រិយភាព ជាង មុន ប៉ុន្តែ មិន ទាន់ មាន ការស្រាវជ្រាវ ណាមួយ ផ្តោត លើ គ្រោះថ្នាក់ នៃ វិធីសាស្ត្រ ឆ្លង ទន្លេ បែប នេះ ទេ ។
ការស្រាវជ្រាវ របស់ អឺរ៉ុប បាន រកឃើញ ថា ការសម្រាល កូន ក្នុង ទឹក ប្រឈម នឹង អត្រា គ្រោះថ្នាក់ ដូចគ្នា ទៅនឹង ការសម្រាល កូន លើ គ្រែ ដែរ ។
យោង តាម ការសិក្សា មហាវិទ្យាល័យ សម្ភព និង រោគ ស្ត្រី រ៉ូយ៉ាល់ ខលីជ របស់ អង់គ្លេស ពេល សម្រាល កូន ក្នុង ទឹក ស្ត្រី ជា មាតា អាច ប្រឈម នឹង គ្រោះថ្នាក់ ប្រសិនបើ ទឹក ចូលក្នុង សរសៃ ឈាម ។
រីឯ ការសិក្សា របស់ អង់គ្លេស មួយ ទៀត បាន បង្ហាញ ថា ការសម្រាល កូន ក្នុង ទឹក អាច ប្រឈម នឹង គ្រោះថ្នាក់ តិចតួច ដែរ ក្នុង ករណី ដែល ទារក ហាមាត់ ដកដង្ហើម ឈ្លក់ ទឹក ពេល ចេញ ពី ផ្ទៃ ។
យ៉ាងណាមិញ អ្នកជំនាញ បាន អះអាង ថា ទារក នឹង មិន ទាន់ ដកដង្ហើម ដោយ ឯកឯង ទេ ដរាបណា ទង សុក មិន ទាន់ ត្រូវបាន កាត់ផ្តាច់ នោះ ។
ក្នុង ករណី ណា ដែល ស្ត្រី មិន គួរ ជ្រើសរើស ឆ្លង ទន្លេ ក្នុង អាងទឹក ?
ស្ត្រី ដែល មាន មេរោគ នៅ ទ្វារមាស អាច ធ្វើឱ្យ មាន ការឆ្លង លឿន ពី ម្តាយ ទៅ កូន តាមរយៈ ទឹក ។
ក្នុង ករណី ដែល ទារក មិន ដាំ ក្បាល ចុះក្រោម មក រក មាត់ ស្បូន ស្ត្រី ពិបាក នឹង សម្រាល កូន ក្នុង ទឹក ទាំង ទារកកើត ចេញ ជើង មក មុន ណាស់ ។
ស្ត្រី ព ពោះ ទារក ភ្លោះ មិន ត្រូវបាន ណែនាំ ឱ្យ សម្រាល ក្នុង ទឹក ឡើយ ។
ទារក កើត មុន កាល កំណត់ ក៏ មិន គួរ ជ្រើសរើស វិធី សម្រាល ក្នុង ទឹក ដែរ ។
ប្រសិនបើ ទឹក ភ្លោះ មាន ពណ៌ ខៀវ ដែល ជា សញ្ញា ថា ទារក ក្នុង ផ្ទៃ បញ្ចេញ លា មក លើក ដំបូង លាយឡំ នឹង ទឹក ភ្លោះ នោះ ស្ត្រី គួរ កុំ ឆ្លង ទន្លេ ក្នុង អាងទឹក ។
ស្ត្រី មាន សម្ពាធ ឈាម ខ្ពស់ និង មាន ជាតិ ស្ករ ក្នុង ឈាម ច្រើន ពេល កំពុង ពពោះ គួរ ពិភាក្សា ជាមួយ អ្នកជំនាញ សម្ភព មុននឹង ជ្រើសរើស យក វិធី នេះ ។
ប្រសិនបើ ទឹក ក្តៅ ពេក វា អាច បង្ក ទៅ អាការ ខ្សោះ ទឹក ដល់ មាតា និង បង្ក គ្រោះថ្នាក់ ខ្ពស់ ដល់ ទារក ។
អាងទឹក សម្រាប់ សម្រាល កូន មាន លក្ខណ ពិសេស ខុសពី អាងទឹក ទូទៅ ដោយ វា មាន ការ កំណត់ សីតុណ្ហភាព ត្រឹមត្រូវ ។
តើ ស្ត្រី ត្រូវ ត្រៀម អ្វី ខ្លះ ប្រសិនបើ ចង់ សម្រាល កូន ក្នុង អាងទឹក ?
មិន ខុសគ្នា ពី ការសម្រាល កូន លើ គ្រែ ទូទៅ ទេ ស្ត្រី ត្រូវ ធ្វើ ការពិនិត្យ ផ្ទៃពោះ និង ឈាម ហើយ ធ្វើ ការទាក់ទង ឆ្មប ជំនាញ ជាមុន ។
យ៉ាងណាមិញ នៅ ទូទាំង ពិភពលោក មាន មន្ទីរពេទ្យ សម្ភព មិន ច្រើន ទេ ដែល ផ្តល់ សេវា សម្រាល កូន ក្នុង អាងទឹក នេះ ៕
ការផិត ក្បត់ គឺជា រឿង អាស្រូវ ដែល មនុស្ស គ្រប់ គ្នា តែង យកមក និយាយ ដើម គ្នា ពីក្រោយ ខ្នង ទាំង ពួកគេ ធ្វើ ការសន្និដ្ឋាន ខុស ទាំងស្រុង ក៏ មាន ។
លោក ស្កុត ហាល់ ហស្ស មេន អ្នកឯកទេស ចិត្ត វិទ្យា នៃ សាកលវិទ្យាល័យ ប្រោន បាន ធ្វើ ការស្រាវជ្រាវ លើ បុរស ស្ត្រី ជីវិត គូស្នេហ៍ និង អាពាហ៍ពិពាហ៍ ជាង ១០ឆ្នាំ មកហើយ ។
លោក បាន លើកឡើង នូវ ការសន្និដ្ឋាន ខុស ទាំង១០ ចំណុច ដែល មនុស្ស យើង តែង យល់ ច្រឡំ ពី ទង្វើ ផិត ក្បត់ នេះ ។
នៅពេល បែកការណ៍ រឿង ផិត ក្បត់ គូស្នេហ៍ មិន អាច បន្ត រស់ នៅ រីករាយ ជាមួយគ្នា ទៀត ទេ ជា ការពិត ណាស់ លើ លោក នេះ គ្មាន អាថ៌កំបាំង ទេ ។
ជាក់ស្តែង ក្រោយពី ការបែកការណ៍ រឿង លួច លាក់ មាន អ្នក ថ្មី ក្រោយ ខ្នង គូស្នេហ៍ ប្រមាណ ជា ៥០ ភាគរយ បែរជា អាច ផ្សះផ្សា គ្នា កាន់តែ យល់ ចិត្ត គ្នា និង រឹត ចំណង ស្នេហ៍ ឱ្យ កាន់តែ រឹងមាំ ឡើង ថែម ទៀត ផង ។
អ្នក លួចលាក់ មាន សហាយ ច្រើន តែ មិន រីករាយ នឹង ជីវិត អាពាហ៍ពិពាហ៍ បច្ចុប្បន្ន យោង តាម ការស្ទាបស្ទង់ មតិ មនុស្ស រាប់ ពាន់ នាក់ ប្តី ប្រពន្ធ ដែល លួចលាក់ មាន ថ្មី មួយចំនួន មិន ចង់ ធ្វើ ការលែងលះ ទេ ។
ទង្វើ ផិត ក្បត់ មិន ត្រឹមតែ ជា ការឡើង គ្រែ ជាមួយ ដៃគូ ផ្សេង ទេ តែ វា ជា ការបែកចិត្ត តែម្តង ជួនកាល តម្រូវការសិច តែ ម្យ៉ាង ក៏ ធ្វើឱ្យ មនុស្ស ស្វែងរក ជន ទី បី មក បង្គ្រប់ ដែរ ប៉ុន្តែ មិន មែន មាន ន័យ ថា អ្នក នោះ នឹង ប្រគប់ បេះដូង ឱ្យ ជន ទី បី ដែរ ។
ពោលគឺ អ្នក ខ្លះ គ្រាន់តែ ចង់ រក ដៃគូ ថ្មី ដើម្បី សប្បាយ មួយ ពេល ឱ្យ ប្លែក អារម្មណ៍ ប៉ុណ្ណោះ មិន មែន ចង់ មាន ទំនាក់ទំនង ផ្លូវចិត្ត អ្វី វែងឆ្ងាយ ជាង ល្បែង លើ គ្រែ ឡើយ ។
បើ គ្មាន ការរួមរ័ក គេ មិន ហៅ ថា សកម្មភាព ផិត ក្បត់ ឡើយ ការផិត ក្បត់ ជាច្រើន ករណី មិន មាន សកម្មភាព រួមភេទ ទាល់តែសោះ ។
ជួនកាល អ្នក នឹង នឹកឃើញ ដល់ ជន ទី បី ហើយ អ្នក បាន ចំណាយ ពេល មួយ រាត្រី នៅក្នុង ការិយាល័យ ជាមួយគ្នា ជជែកគ្នា ពី អាថ៌កំបាំង និង រឿងរ៉ាវ ឯកជន ដទៃ ទៀត ដោយ មិន បាន ប៉ះពាល់ គ្នា ស៊ីជម្រៅ ទេ ។
ការផិត ក្បត់ គឺ កើតឡើង តែ ដោយសារ សិច ប៉ុណ្ណោះ ខុស ហើយ !
អ្នក ខ្លះ ចង់ សាក ម្ហូប ថ្មី ចង់ រួម សង្វាស ជាមួយ ដៃគូ ថ្មី ។
ប៉ុន្តែ អ្នក ខ្លះ ទៀត លួចលាក់ មាន សហាយ ដោយសារតែ ទទួលបាន អារម្មណ៍ កក់ក្តៅ ពី អ្នក ទី បី នោះ ប៉ុណ្ណោះ ។
គ្រួសារ មាន បញ្ហា ដៃគូ ប្រាកដជា ផិត ក្បត់ រក អ្នក ថ្មី ជីវិត គូ ស្រករណា ក៏ មាន បញ្ហា ដែរ ។
ការផិត ក្បត់ មិន មែន កើតឡើង ដោយសារ បញ្ហា ក្នុង គ្រួសារ ឡើយ ។
អ្វី ដែល ជា មូលហេតុ ចម្បង គឺ ប្តី ប្រពន្ធ ជួប បញ្ហា តែ មិន បាន ដោះស្រាយ ឱ្យ ល្អ ទើប ធ្វើឱ្យ ចំណង ស្នេហ៍ នេះ បាត់បង់ ភាព កក់ក្តៅ រហូតដល់ ភាគី ណាមួយ ត្រូវ លួច លាក់ ស្វែងរក អ្នក ថ្មី មក ស្អំ បេះដូង ។
អ្នក ធ្លាប់ មាន ប្រវត្តិ ផិត ក្បត់ ម្តង គឺ ក្បត់ មួយ ជីវិត ជា ការពិត ណាស់ ទម្លាប់ ផិត ក្បត់ អាច ជា ស្លាកស្នាម ដែល ពិបាក លុប ។
ប៉ុន្តែ តាម ការស្រាវជ្រាវ អ្នក ធ្លាប់ ខុស ម្តង ក៏ អាច កែ ខ្លួន និង ធ្វើឱ្យ ចំណង ស្នេហា កាន់តែ រឹងមាំ ផងដែរ ។
អ្នកជំនាញ ចិត្ត រូប នេះ បាន ណែនាំ ថា អ្នកផិត ក្បត់ ត្រូវតែ ចេះ សារភាព កំហុស បកស្រាយ ការពិត ទើប ព្យាបាល របួស ផ្លូវចិត្ត បាន ។
ការផិត ក្បត់ ជា ទីបញ្ចប់ នៃ ជីវិត អាពាហ៍ពិពាហ៍ តាម ទិន្នន័យ ប្តី ប្រពន្ធ ដែល ធ្លាប់ ឆ្លងកាត់ ទុក្ខ ព្រួយ ដោយសារ ទង្វើ មាន សហាយ របស់ ដៃគូ នោះ មាន ប្រមាណ ជាង ៥០ ភាគរយ មិន បាន លែងលះ គ្នា ទេ ។
ពោល ទោះជា មាន របួស បេះដូង ក្តី ក៏ ពួកគេ សុខចិត្ត រស់ នៅ ជា ប្តី ប្រពន្ធ ដដែល ។
ជន ទី បី ជា មនុស្ស ដែល ក្មេង និង ស្អាត ជាង ដៃគូ ជីវិត របស់ អ្នក មិន មែន ឱ្យ តែ ស្រី ថ្មី ត្រូវតែ ក្មេង ជាង ប្រពន្ធ ឡើយ ហើយ ប្រពន្ធ ដែល លួច មាន សហាយ មិន មែន សុទ្ធតែ ប្រព្រឹត្ត ខុស ជាមួយ ប្រុស ក្មេង ទេ ។
ការផិត ក្បត់ ជា ទង្វើ ចេតនា ការផិត ក្បត់ ភាគ ច្រើន មិន មែន កើតឡើង ដោយ ចេតនា ទេ ។
អ្នកបម្រើការ ជាមួយគ្នា អាច បង្កើត ទៅជា ភ្លើង ស្នេហ៍ ដើម រកា ដែក ព្រោះតែ ភាពស្និទ្ធស្នាល នឹង គ្នា រហូតដល់ ភ្លេច ប្តី ប្រពន្ធ ខ្លួន នៅ ផ្ទះ ។
នេះ មិន មែន ជា សកម្មភាព កើតឡើង ដោយ ចេតនា ទេ ៕
ក្នុង វីដេអូ សិច ទំហំ លិង្គ ខ្នាត យក្ស រូបរាង ប្រដាប់ ភេទ នារី ដ៏ រលោង គ្មាន រោម មួយ សរសៃ ក្បាច់ រួមភេទ ដ៏ ចម្លែក ដែល អ្នក មិន អាច ធ្វើ តាម បាន និង សំឡេង ថ្ងូរ ដ៏ ស្រើប ស្រាល គឺ សុទ្ធតែ ជា ការសម្តែង សុទ្ធសាធ ដែល មិន មែន ថត តែម្តង ចប់ នោះ ទេ ។
ខាងក្រោម គឺជា ហេតុផល ១០ ដែល បង្ហាញ ថា ជីវិត លើ គ្រែ ជាក់ស្តែង របស់ អ្នក គឺ ប្រសើរ ជាង ឈុត ឆាក រួមភេទ ក្នុង វីដេអូ សិច ។
អ្នក មិន ចាំបាច់ ធ្វើ រឿង ដដែល ៗ នៅក្នុង ឧស្សាហកម្ម ភាព យន្ត អាសអាភាស ការសម្តែង ឈុត ឆាក លើ គ្រែ មិន ពាក់ព័ន្ធ នឹង មនោសញ្ចេតនា ទេ ។
ជាទូទៅ តួអង្គ ប្រុស ស្រី ក្នុង វីដេអូ សិច មិន ងាយ សម្រេច ដល់ ចំណុច កំពូល ឡើយ ដោយ ពួកគេ ត្រូវ ធ្វើ សកម្មភាព ដដែល ៗ ឡើងវិញ ទាល់តែ ល្អ ឥត ខ្ចោះ សម តាម ចិត្ត អ្នកដឹកនាំរឿង ។
អ្នក មិន ខ្វល់ ពី កម្រិត ពន្លឺ យោង តាម អ្នកដឹកនាំ ថត ភាពយន្ត អាសអាភាស ពេល កំពុង ប្រតិបត្តិការ តួអង្គ សិច ត្រូវបាន គេ ផ្អាក ឱ្យ ប្តូរ ស្រោម លាប ទឹក រំអិល បន្ថែម និង បាញ់ ភ្លើង ឱ្យ ចំ តំបន់ អាថ៌កំបាំង ដែល ទាំងនេះ គឺជា រឿង ដ៏ គួរឱ្យ អៀន ខ្មាស បំផុត ។
ដោយឡែក រវាង អ្នក នឹង ដៃគូ ពិតប្រាកដ ការរួមភេទ គឺ ដំណើរការ យ៉ាង រលូន មិន មាន ការផ្អាក ឬ បញ្ឈប់ ដើម្បី ថែម ថយ គ្រឿង គ្រៅ ដូច្នោះ ទេ ។
អ្នក មិន ចាំបាច់ ប្រើ ដៃ សម្រេច កាម តួអង្គ ប្រុស ក្នុង កុន សិច ភាគ ច្រើន មិន អាច សម្រេច កាម គុណ តាមរយៈ ការស៊ក បញ្ចូល លិង្គ ឡើយ ។
ការពិត តួអង្គ ប្រុស ច្រើន តែ ប្រើ ដៃ របស់ ខ្លួន ដើម្បី បង្ខំឱ្យ ពស់ នាគរាជ បញ្ចេញ ពិស រួច ទើប ធ្វើ ការ កាត់ត រូបភាព បញ្ចូល គ្នា ឱ្យ មើល ទៅ ដូចជា ការបាញ់ ទឹក កាម ក្រោយ ប្រតិបត្តិការ វាយ សម្រុក លិង្គ ក្នុង យោនី មាត់ ឬ រន្ធ គូថ ជាដើម នោះ ។
អ្នក មិន ខ្វល់ ពី ការវាយតម្លៃ អ្នកដទៃ ពេល កំពុង ប្រតិបត្តិការ តួអង្គ សិច តែងតែ ត្រូវបាន អ្នកដឹកនាំ ថត រិះគន់ ឬ សរសើរ វាយតម្លៃ ពី សមត្ថភាព លើ គ្រែ របស់ ពួកគេ ។
ខុសប្លែក ពី ជីវិត ពិត ដែល ការរួមភេទ របស់ អ្នក មិន ចាំបាច់ ឱ្យ អ្នកដទៃ មក វាយតម្លៃ ឡើយ ។
ប្រការ សំខាន់ ឱ្យ តែ ដៃគូ ទាំង សងខាង ត្រេកត្រអាល ស្កប់ស្កល់ ដល់ ចំណុច កំពូល នោះ វា គឺជា សកម្មភាព សិច ដ៏ ជោគជ័យ ហើយ ។
អ្នក មិន ធ្វើ ការចរចា ដូច ផ្សារ ត្រី ទេ មុនពេល ថត តួអង្គ និង ក្រុមការងារ ផលិត វីដេអូ សិច តែងតែ ពិភាក្សា និង ចរចា ពី ក្បាច់ រយៈពេល និង ស្ទីល រួមភេទ ប្លែក ៗ ។
តារា សម្តែង គ្មាន សិទ្ធិ ក្នុង ការធ្វើ អ្វី ៗ តាម ចិត្ត ឡើយ ។
អ្នក ត្រូវ ដឹង ថា ការរួមភេទ គឺជា រឿង ធម្មជាតិ ដែល មនុស្ស ប្រុស ស្រី អនុវត្ត ទៅ តាម ដំណើរ ។
អ្នក មិន ស្មុគស្មាញ នឹង បញ្ហា ច្បាប់ ការផលិត វីដេអូ អាសអាភាស តម្រូវ ឱ្យ តួអង្គ និង ទីកន្លែង ថត ឆ្លងកាត់ ការត្រួតពិនិត្យ ផ្នែក សុវត្ថិភាព និង សុខភាព ពី អាជ្ញាធរ ។
ជួនកាល ពេល ដែល តួអង្គ កំពុងតែ រួមភេទ សុខ ៗ ស្រាប់តែ មាន មន្ត្រី សុខាភិបាល បញ្ជា ឱ្យ ផ្អាក ឱ្យ ធ្វើ ការត្រួតពិនិត្យ នៅ កន្លែង ក៏ មាន ។
ការរួមភេទ ជាក់ស្តែង គឺជា រឿង ឯកជន ដែល គ្មាន អ្នកណា មក បង្អាក់ ខណៈ អ្នក កំពុងតែ ជិត ឡើង ដល់ ឋានសួគ៌ នោះ ទេ ។
អ្នក មិន ចាំបាច់ ប្រើ របស់ សិប្បនិម្មិត តួអង្គ សិច ត្រូវ ឆ្លងកាត់ លក្ខខណ្ឌ ជាច្រើន ហើយ ពួកគេ គ្មាន សេរីភាព ចំពោះ របស់ កេរ្តិ៍ ឪពុក ម្តាយ ចែក ឱ្យ ទេ ។
តួយ៉ាង ដូចជា លិង្គ ឬ មាត់ទ្វារមាស ត្រូវតែ កោរ រោម ឬ ផាត់ ពណ៌ ស៊ីជម្ពូ បន្ថែម ។
អ្នក មិន បាច់ លេប ថ្នាំ វីយ៉ាក្រា ដើម្បី បញ្ឆេះ អារម្មណ៍ សិច និង ឱ្យ រឹង លិង្គ បាន យូរ តួ កុន សិច ភាគ ច្រើន សុទ្ធតែ ប្រើ ថ្នាំ សម្រើប វីយ៉ាក្រា ។
សម្រាប់ អ្នក ទោះ គ្មាន វីយ៉ា ក្រាក៏ អ្នក អាច ដឹក ដៃ គ្នា ឡើង ឋានសួគ៌ បាន ដែរ ។
អ្នក មិន បាច់ ប្រើ ទឹក កាម ក្លែងក្លាយ ក្នុង ខ្សែភាពយន្ត សិច មួយចំនួន ការបាញ់ ទឹក កាម គឺជា ទឹក កាម សិប្បនិម្មិត ប៉ុណ្ណោះ មិន ថា ចំពោះ តួ ប្រុស ឬ ស្រី នោះ ទេ ។
បុរស ក្រៅ ឆាក គួរតែ មាន មោទនភាព ដែល ខ្លួន អាច បញ្ចេញ ទឹក កាម ធម្មជាតិ ពេល ប្រតិបត្តិការ ដល់ កំពូល ។
អ្នក មិន បាច់ ផ្ទៀង នាឡិកា ទេ តួអង្គ សិច ត្រូវ អនុវត្ត ការរួមភេទ ឬ ក្បាច់ ណាមួយ តាម ពេលវេលា ។
ពេលនេះ អ្នក គួរតែ សរសើរ សំណាង ខ្លួន ឯង ទៅ ដែល ចាប់ផ្តើម និង បញ្ចប់ ប្រតិបត្តិការ លើ គ្រែ របស់ ខ្លួន ពេលណា ក៏ បាន តាមចិត្ត ចង់ នោះ ៕
ការ៉ុត ត្រូវ រកឃើញ មាន សមត្ថភាព ផលិត ទឹក កាម ខ្ពស់
តាំងពីដើម មក យើង តែង បាន ដឹង ពី អត្ថប្រយោជន៍ របស់ បន្លែ ការ៉ុត ថា មាន គុណ តម្លៃ យ៉ាង ច្រើន សម្រាប់ សុខភាព មនុស្ស ប៉ុន ណា ។
ប៉ុន្តែ ឥឡូវនេះ គេ បាន រកឃើញ ប្រយោជន៍ របស់ វា មួយ ផ្សេង ទៀត ហើយ គឺ អាច ជួយ បង្កើន ការផលិត ទឹក មេជីវិត របស់ បុរស បាន ផងដែរ ។
ក្រុម អ្នកស្រាវជ្រាវ បាន សិក្សា លើ លទ្ធផល ផ្លែ ឈើ និង បន្លែ នានា ដែល មាន ប្រយោជន៍ អាច បង្កើត នូវ ផលិតផល ទឹក មេជីវិត បុរស ខណៈ លទ្ធផល ឃើញ ថា បន្លែ ការ៉ុត មាន ទិន្នន័យ ល្អ ជាង គេ សម្រាប់ ការផលិត នេះ ។
ក្រុម អ្នកស្រាវជ្រាវ បាន បង្ហាញ ថា បន្លែ ការ៉ុត មាន លទ្ធផល បង្កើត នូវ កម្រិត ទឹក ស្ពែម បុរស ខ្លាំង ជាង គេ ក្នុង ពងស្វាស ។
ក្រុម អ្នកស្រាវជ្រាវ មកពី សាកលវិទ្យាល័យ ហាវ៉ើត សហរដ្ឋ អាមេរិក បាន ស្នើ ក្រុម បុរស វ័យ ក្មេង ចំនួន ២០០ នាក់ សម្រាប់ ការស្រាវជ្រាវ នេះ ដោយ គេ បាន ឱ្យ ពួកគេ ទទួលទាន បន្លែ និង ផ្លែ ឈើ ទាំងឡាយ មុននឹង ការធ្វើតេស្ត លើ កម្រិត ផលិត ទឹក មេជីវិត នេះ ។
លើស ពី នេះ ក្រុម អ្នកស្រាវជ្រាវ បាន ឱ្យដឹង ថា ការទទួលទាន បន្លែ និង ផ្លែ ឈើ ពណ៌ លឿង និង ទឹកក្រូច មាន លទ្ធផល ល្អ សម្រាប់ ការផលិត ទឹក ស្ពែ ម៉ាតូ សូអ៊ីត ។
អារម្មណ៍ ផ្លូវភេទ ដល់ ត្រើយ ស្រណុក សុខ ស្រួល មិន មែន សំដៅ តែ ទៅ លើ ការរួមភេទ រវាង មនុស្ស និង មនុស្ស ទេ ។
មិន ខុស អ្វី ពី បញ្ហា រួមភេទ ទ្វេ ឬ ពហុ ភាគី ទេ ការសម្រេច កាម ដោយ ខ្លួន ឯង ថ្វីដ្បិតតែ ជា រឿង និង សេរីភាព របស់ បុគ្គល ម្នាក់ ក៏ ពិត មែន ប៉ុន្តែ វា ជា បញ្ហា ដ៏ ចម្រូងចម្រាស និង ស្ថិត ក្រោម សម្ពាធ ផ្លូវចិត្ត និង គំនាប ពី វប៌្បធម របស់ បណ្តា ប្រទេស មួយចំនួន ផងដែរ ។
ការសម្រេច កាម ដោយ ខ្លួន ឯង គឺជា ការស្វែងរក ភាពស្រណុក សុខ ស្រួល ផ្លូវភេទ ដោយ គ្មាន វត្តមាន ភាគី ដទៃ ទៀត ។
មនុស្ស អាច សម្រេច កាម ដោយ ខ្លួន ឯង តាមរយៈ ការបបោស អង្អែល និង ប្រើ ដៃ ឬ ឧបករណ៍ ជំនួយ ផ្លូវភេទ នានា ដើម្បី បំពេញ ចំណង់ កាម គុណ ឱ្យ ដល់ ចំណុច កំពូល ។
ចំពោះ បុរស ការសម្រេច កាម ដោយ ខ្លួន ឯង ភាគ ច្រើន ប្រព្រឹត្តទៅ ដោយ ការប្រើ ដៃ កាន់ លិង្គ របស់ ខ្លួន ហើយ ធ្វើ ចលនា សាប់ ចុះ ឡើង តាម ចង្វាក់ រហូតដល់ បាញ់ ទឹក កាម ឬ ក៏ តាមរយៈ ការប្រើ ឧបករណ៍ សិច រាង ដូច ពែង ដែល មាន រន្ធ ស្រដៀង យោនី របស់ ស្ត្រី ។
រីឯ នារី ការសម្រេច កាម ខ្លួន ឯង ភាគ ច្រើន គឺជា ការប្រើ ម្រាម ដៃ ឬ លិង្គ សិប្បនិម្មត ស៊ិកបញ្ចូល ហើយ ធ្វើ ចលនា ចុះ ឡើង រហូតដល់ ចំណុច សម្រើប កំពូល ។
ជាទូទៅ ក្នុង អំឡុង ពេល អន្តរកាល ដែល ធ្វើឱ្យ មនុស្ស វិវឌ្ឍ ពី វ័យ កុមារ ទៅ វ័យ ជំទង់ ពួកគេ ក៏ មាន ការប្រែប្រួល ទាំង រូបរាងកាយ និង ផ្លូវ អារម្មណ៍ ។
កុមារ ធំ ពេញ វ័យ ទាំង រូបរាងកាយ និង ចិត្ត គំនិត ហើយ ពួកគេ ភាគ ច្រើន កើត ការងឿងឆ្ងល់ អំពី ផ្លូវភេទ ដោយសារ ការលូតលាស់ នៃ ប្រដាប់ ភេទ របស់ ខ្លួន គួរឱ្យ កត់សម្គាល់ ។
ក្មេង មួយចំនួន ចាប់ផ្តើម ទទួល អារម្មណ៍ ស្រើប ស្រាល ពេល ប៉ះពាល់ តំបន់ អាថ៌កំបាំង របស់ ខ្លួន ហើយ ជួនកាល ពួកគេ ក៏ បាន ស្វែងយល់ ពី មិត្តភក្តិ និង ប្រព័ន្ធ ផ្សព្វផ្សាយ ពី ការសម្រេច កាម ដោយ ខ្លួន ឯង នេះ ផងដែរ ។
ផ្ទុយ គ្នា ទៅនឹង ជំនឿ មួយចំនួន ដែល ថា ការសម្រេច កាម ដោយ ខ្លួន ឯង អាច ធ្វើ ក្មេង ដុះ រោម និង ក្លាយជា មនុស្ស អសមត្ថភាព មាន កូន ក្លាយទៅជា ងងឹត ភ្នែក ឬ វិវត្ត ទៅ រោគ ផ្លូវចិត្ត មួយចំនួន តាម ការពិត វេជ្ជបណ្ឌិត ឯកទេស ខាង បន្ត ពូជ បាន ចាត់ទុក ថា ការសម្រេច កាម ដោយ ខ្លួន ឯង ជា សេរីភាព របស់ បុគ្គល ម្នាក់ ៗ ហើយ វា មិន មាន ផល ប៉ះពាល់ អ្វី ទៅដល់ សុខភាព នោះ ទេ ដរាបណា វា ត្រូវបាន អនុវត្ត តាម បែបបទ ត្រឹមត្រូវ ។
ករណី ដែល មាន ផល ប៉ះពាល់ លុះត្រាតែ បុគ្គល នោះ អនុវត្ត នូវ វិធី នេះ ច្រើន ដង ហួស ហើយ យើង មិន អាច កំណត់ បាន ច្បាស់ ទេ ថា ធ្វើ ប៉ុន្មាន ដង ទើប ល្អ នោះ ព្រោះ វា អាស្រ័យ ទៅតាម សុខភាព របស់ បុគ្គល ម្នាក់ ៗ ។
តែ ជា ការផ្តល់ យោបល់ របស់ អ្នកស្រាវជ្រាវ គួរតែ ធ្វើ សកម្មភាព កុំ ឱ្យ ច្រើន ជាង ២ឬ ៣ដង ក្នុង មួយ សប្តាហ៍ ។
ការជួយ ខ្លួន ឯង នឹង មិន ប៉ះពាល់ ដល់ រដូវ ឬ ការមាន ផ្ទៃពោះ ដោយ ផ្ទាល់ នោះ ទេ ។
ប៉ុន្តែ ក្នុង ករណី ដែល វា ត្រូវបាន អនុវត្ត ដោយ ខ្វះ អនាម័យ វា អាច បង្ក ជា ជំងឺ ទ្វារមាស អាការ រមាស់ រោគ ផ្សិត ដាច់ រលាត់ សាច់ ខ្ចី និង បង្ក ជា ការចម្លង មេរោគ នានា ដែល អាច ធ្វើឱ្យ ប៉ះពាល់ ដល់ ដំណើរ មក រដូវ ឬ កាត់បន្ថយ អត្រា មាន កូន ដោយសារតែ សុខភាព ប្រដាប់ បន្ត ពូជ ចុះខ្សោយ ជាដើម ។
ការសម្រេច កាម ដោយ ខ្លួន ឯង ឬ រួមភេទ ដោយ ដៃ គឺជា ឥរិយាបថ ផ្លូវភេទ មួយ ដែល ច្រើន តែ ធ្វើឡើង នៅពេល មនុស្ស ម្នាក់ មិន អាច បំពេញ បំណង ផ្លូវភេទ របស់ ខ្លួន ឯង បាន ជាមួយ ដៃគូ ។
តាម ធម្មតា ការសម្រេច កាម ដោយ ខ្លួន ឯង មិន បង្កឱ្យ អសមត្ថភាព ក្នុង ការបង្កកំណើត ទេ ។
ប៉ុន្តែ បើសិនជា ការសម្រេច កាម ដោយ ខ្លួន ឯង គឺជា ទម្លាប់ មួយ ហើយ ច្រើន តែ ធ្វើ វា ជាញឹកញាប់ នោះ វា ពិតជា ធ្វើឱ្យ មិន អាច មាន កូន ជា លក្ខណៈ បណ្តោះអាសន្ន បាន ។
ដើម្បី អាច បង្កកំណើត បាន កោសិកា មេជីវិត ឈ្មោល មាន ការទុំ ឬ លូតលាស់ ជាមុន សិន ហើយ ដើម្បី អាច ទុំ ឬ លូតលាស់ បាន វា ត្រូវការ ពេលវេលា រហូតដល់ រយៈពេល ៧២ ម៉ោង ឯណោះ ។
បើសិនជា អ្នកឧស្សាហ៍ មាន បញ្ហា ដោយសារតែ ការសម្រេច កាម ដោយ ខ្លួន ឯង ពេក នោះ មាន ន័យ ថា មេជីវិត ឈ្មោល មិន ទាន់ ទុំ គ្រប់គ្រាន់ នឹង ធ្វើ ការបង្កកំណើត ឡើយ ។
មុននឹង ធ្វើ ការសម្រេច កាម ដោយ ខ្លួន ឯង បុគ្គល ម្នាក់ គួរតែ ពិចារណា លើ កត្តា សុខភាព អនាម័យ និង ផ្លូវចិត្ត ។
ម្រាម ដៃ និង ឧបករណ៍ ជំនួយ ផ្លូវភេទ ដែល ប្រើប្រាស់ ក្នុង ការសម្រេច កាម ដោយ ខ្លួន ឯង ចាំបាច់ ត្រូវតែ សម្អាត ដើម្បី ចៀសវាង ការចម្លង មេរោគ ។
ក្រចក ដៃ ត្រូវតែ កាត់ ឱ្យ ខ្លី និង រក្សា អនាម័យ ចៀសវាង ការដាច់ រលាត់ សាច់ ខ្ចី ឬ បង្ក ជា រោគ ផ្សិត ជាពិសេស ចំពោះ ប្រដាប់ ភេទ ស្ត្រី ។
អ្វី ដែល សំខាន់ អ្នក មិន ត្រូវ បណ្តោយ ខ្លួន ឱ្យ ក្លាយទៅជា ញៀន នឹង ល្បែង ផ្លូវភេទ នេះ ទេ ពីព្រោះ វា អាច បង្កឱ្យ បុគ្គល ម្នាក់ ផ្តាច់ ខ្លួន ពី សង្គម មាន អារម្មណ៍ ខ្មាស អៀន បាត់បង់ ជំនឿចិត្ត និង ពិបាក រក ដៃគូ ជីវិត ផងដែរ ៕
លិង្គ និង ពងស្វាស ជា អាហារ ប៉ូវ សុខភាព សិច បុរស អាស៊ី
ជាទូទៅ ឱ្យ តែ គ្រឿងផ្សំ អាហារ ណា ដែល មាន សណ្ឋាន ជា លិង្គ របស់ សត្វ នោះ វា គឺជា វត្ថុ មាន តម្លៃ ណាស់ សម្រាប់ មជ្ឈដ្ឋាន នៃ ការគិត របស់ ជនជាតិ ចិន ។
យ៉ាងណាមិញ គំនិត មួយ នេះ ក៏ ក្លាយជា ការនិយម មក ប្រើ ជា ឱសថ ប៉ូវ កម្លាំង ផ្នែក កាមត ម្រេក ឬ ជំនួយ សុខភាព ផ្លូវភេទ របស់ ជាតិ អាស៊ី ដែរ ។
ប្រភេទ លិង្គ សត្វ ទាំងនោះ រួម មាន លិង្គ សត្វ លាព ពែ ឆ្កែ គោ និង ក្តាន់ ជាដើម គឺ សុទ្ធតែ ជា អាហារ ឬ គ្រឿងផ្សំ ជា ឱសថ មាន ប្រយោជន៍ សម្រាប់ សុខភាព មនុស្ស ទាំងអស់ ។
លោក សាវ ដែល មាន បទពិសោធ ខាង រៀបចំ លិង្គ សត្វ សម្រាប់ ចម្អិន អាហារ ឱ្យ គ្រួសារ តាំងពី រូប លោក មាន វ័យ ១៣ ឆ្នាំ និង មាន ប្រវត្តិ បួន ប្រាំ ជំនាន់ មក នោះ បាន និយាយ ថា ៖
អ្នកស្រី ថា បណ្តា ភ្ញៀវ ដែល មក រក សេវាកម្ម អាហារ ធ្វើ សាច់ លិង្គ សត្វ ទាំងនោះ គឺជា បុរស ដោយ ពួកគេ មាន ជំនឿ ថា អាហារ នេះ អាច ផ្តល់ ថាមពល សិច ខ្លាំងក្លា ដល់ ពួកគេ បាន ។
ពេល មកដល់ ពួកគេ រមែង សាកសួរ រក លិង្គ សត្វ ចៀម ព្រៃ សត្វ គោ ព្រៃ សត្វ ភេសមុទ្រ និង សត្វ ពស់ ជាដើម ខណៈ ពួកគេ ទទួលទាន ម្តង មួយ គូ ។
អ្នកស្រី លី យ៉ាំង ហ្សី បន្ត ថា ៖
ការញ៉ាំ លិង្គ និង ពងស្វាស សត្វ អាច ជួយ បង្កើន សុខភាព ផ្លូវភេទ បុរស មាន លក្ខណៈ ខ្លាំងក្លា និង ប្រកបដោយ សក្តានុពល អស្ចារ្យ ។
គេ ក៏ នៅ ពុំ ទាន់ មាន ភ័ស្តុតាង ណា មួយ បញ្ជាក់ ចំពោះ ការអះអាង ខាងលើ នេះ បាន ឡើយ តែ មតិ ទូទៅ នៅ តំបន់ អាស៊ី បាន អះអាង មាន លក្ខណៈ ស្រដៀង គ្នា គ្រប់ ទីកន្លែង ។
សាច់ ខួរ អាច ផ្តល់ ថាមពល ផ្នែក ខួរក្បាល មនុស្ស ខណៈ ពង ស្វាស វិញ អាច ជួយ បង្កើន ថាមពល ប្រដាប់ ភេទ តែម្តង ។
ដោយឡែក នៅ តាម ដង វិថី នៃ ទីក្រុង ហ្សាការតា ប្រទេស ឥណ្ឌូនេស៊ី ឯណោះ វិញ គេ បាន ឃើញ ក្រុម បុរស ៗ ទាំងឡាយ កំពុងតែ នាំគ្នា ផឹក ឈាម ពស់ ដោយ ផឹក ម្តង តម្លៃ ៦,៤ដុល្លារ ខណៈ ពួកគេ ជឿ ថា ឈាម ពស់ នេះ អាច ធ្វើឱ្យ ថាមពល សិច ពួកគេ ដំណើរការបាន ល្អ ។
ចំណែក ប្រជាជន ខ្លះ មាន ជំនឿ ថា ទឹកឃ្មុំ មួយ ស្លាបព្រា ទៅ លើ សាច់ ទាំងនោះ វា មិន ត្រឹមតែ មាន ផលប្រយោជន៍ សម្រាប់ សុខភាព ប៉ុណ្ណោះ ទេ វា ថែមទាំង ជា ឱសថ ជួយ ព្យាបាល ជំងឺ ទឹកនោម ផ្អែម ការឡើង សម្ពាធ ឈាម និង ជំងឺ ដទៃ ទៀត ផង ។
សក់ របស់ ខ្ញុំ លែង សូវ ជ្រុះ ហើយ ឥឡូវ ខ្ញុំ មានអារម្មណ៍ ថា ខ្លួន ឯង មាន កម្លាំង ពេញ ខ្លួន តែម្តង ៕
វិធី បន្តឹង ស្បែក មុខ បែប កូរ៉េ មាន លក្ខណៈ ធម្មជាតិ ប្រឈម គ្រោះថ្នាក់ ទាប បំផុត
ផ្ទៃ មុខ បុរស ស្ត្រី គ្រប់ រូប មាន ការវិវត្ត គួរឱ្យ កត់សម្គាល់ ពេល ឈានដល់ វ័យ ៣០ ឆ្នាំ ទោះបីជា យើង ធ្វើ ការព្យាបាល ឬ ប្រើប្រាស់ ផលិតផល យ៉ាងណា ក៏ដោយ ។
បញ្ហា ចម្បង របស់ ផ្ទៃ មុខ ដែល ឈាន ទៅ រក ជ្រេ នោះ គឺ ស្បែក របស់ យើង តែង យារ ចុះ ការលេច ស្នាម ជ្រីវ ជ្រួញ នៅក្បែរ បបូរមាត់ ឬ ក៏ ការយារ ធ្លាក់ នូវ ស្បែក ក្រោម ថ្គាម ជាដើម ។
បញ្ហា ទាំងនេះ វា កាន់តែ ធ្ងន់ធ្ងរ ទៅ ទៀត ក្នុង ករណី ដែល យើង បាត់បង់ ជាតិ ខ្លាញ់ ក្រោម ស្បែក ឬ ទទួល សម្ពាធ ពី ការងារ ច្រើន ការអត់ងងុយ ឬ បញ្ហា ស្ត្រ សជោ ដើម ។
ដើម្បី ធ្វើ ការកែប្រែ នូវ បញ្ហា ទាំងនេះ មនុស្ស មួយចំនួន បាន ងាក ទៅ រក វិធីសាស្ត្រ វះកាត់ បណ្តឹង ស្បែក មុខ ។
ទោះជា ការវះកាត់ នេះ ហុច លទ្ធផល ខ្ពស់ ក៏ដោយ ក៏ វា ជា ការវះកាត់ មួយ ប្រឈម គ្រោះថ្នាក់ ផងដែរ ។
ការវះកាត់ តម្រូវ ឱ្យ យក ស្បែក ដែល លើស ចេញ និង បន្តឹង ស្បែក តាមរយៈ ការដេរ ភ្ជាប់ ប្រព័ន្ធ សាច់ដុំ ក្រោម ស្បែក ។
ដោយ ទំនោរ នៃ ការថែរក្សា សម្ផស្ស បច្ចុប្បន្ន ងាក ទៅ រក វិធីសាស្ត្រ ពុំ វះកាត់ ដោយសារតែ មនុស្ស ជាច្រើន ពុំ ហ៊ាន ទទួល ការវះកាត់ ឬ គ្មាន ពេលវេលា គ្រប់គ្រាន់ ដើម្បី សម្រាក ព្យាបាល ។
បង្កើតឡើង ដោយ វេជ្ជបណ្ឌិត ឯកទេស នៃ ប្រទេស កូរ៉េ ខាងត្បូង ការព្យាបាល ដោយ ប្រើ ខ្សែ វេជ្ជសាស្ត្រ អាច បំបាត់ នូវ ស្នាម ជ្រីវ ជ្រួញ ជុំវិញ ផ្ទៃ មុខ និង ព្យាបាល ស្បែក យារ ធ្លាក់ ហើយ ការឈប់ សម្រាក ពី ការងារ និង មិន បន្សល់ទុក នូវ ស្នាម ដូច ការវះកាត់ ឡើយ ។
វេជ្ជបណ្ឌិត ឯកទេស ហាន់ ជីន ខ្វុន បាន បង្កើត នូវ ប្រព័ន្ធ ម្យ៉ាង ដោយ គាត់ ចាក់បញ្ចូល ខ្សែ វេជ្ជសាស្ត្រ នៅ ក្រោម ស្បែក ដើម្បី ជួយ បង្កើន ភាព តឹង ណែន បង្កើន ទំហំ ផ្ទៃ មុខ និង បំបាត់ នូវ ស្នាម ជ្រីវ ជ្រួញ ។
វា គឺជា ប្រភេទ ខ្សែ ដែល អាច ស្រូប រលាយ ទៅវិញ ដូច ខ្សែ វេជ្ជសាស្ត្រ ដែល យើង ប្រើប្រាស់ នៅក្នុង ការវះកាត់ ដូច្នោះ ដែរ ។
វិធីសាស្ត្រ នេះ អាច ជំរុញ ឱ្យ មាន ការបង្កើន ឡើង នូវ ប្រព័ន្ធ សរសៃ ឈាម ក្នុង ស្បែក ជំរុញ ការបណ្តុះ កោសិកា ឡើងវិញ និង បង្កើន បរិមាណ កូឡា ហ្សែន ដែល ជា សារធាតុ ធ្វើឱ្យ ស្បែក របស់ យើង ហាប់ ណែន ពុំ ជ្រីវ ជ្រួញ ។
ជាធម្មតា វិធីសាស្ត្រ នេះ គឺ អនុវត្ត ដោយ ត្រូវការ ពេលវេលា ប្រមាណ ៣០នា នី អាស្រ័យ ទៅតាម ទីកន្លែង នៃ ការព្យាបាល និង បទពិសោធ របស់ វេជ្ជបណ្ឌិត ផ្ទាល់ ។
វា ពុំ មាន ផលវិបាក ណាមួយ ធ្ងន់ធ្ងរ គួរឱ្យ ចាប់អារម្មណ៍ នោះ ទេ ក្រៅ អំពី ការធ្វើឱ្យ ភាព រមាស់ ឬ ហើម បន្តិចបន្តួច ដែល អាច បាត់ ទៅវិញ ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ ។
យើង ក៏ ពុំ ត្រូវការពេល ឈប់ សម្រាក ពី ការងារ ដែរ ពោលគឺ អ្នក ព្យាបាល អាច វិល ទៅ ធ្វើ ការវិញ បាន ក្រោយពី ការព្យាបាល ។
ចំពោះ លទ្ធផល យើង អាច សម្គាល់ ឃើញ ភ្លាម ក្រោយពី ការប្រព្រឹត្តទៅ នៃ វិធីសាស្ត្រ ។
ប៉ុន្តែ វា គ្រាន់តែ ជា ការចាប់ផ្តើម ប៉ុណ្ណោះ ទេ ។
ខុសពី ការវះកាត់ ដែល បន្សល់ទុក នូវ ស្លាកស្នាម ខ្លះ ៗ តំបន់ ដែល ទទួល ការព្យាបាល មាន លក្ខណៈ ធម្មជាតិ ដោយ ស្បែក ពុំ តឹង ខ្លាំង ពេក ដូចជា ការវះកាត់ បន្តឹង ស្បែក ឡើយ ។
ការប្រើ ខ្សែ វេជ្ជសាស្ត្រ បន្តឹង គឺ អាច អនុវត្ត បាន នៅ គ្រប់ ទីកន្លែង លើ ផ្ទៃ មុខ និង ដង ខ្លួន ដូចជា លើ ដៃ និង ទ្រូង ជាដើម ។
សព្វ ថ្ងៃ វិធីសាស្ត្រ នេះ កំពុង ពេញនិយម ក្នុង បណ្តា ប្រទេស អាស៊ី រួម មាន ជប៉ុន ថៃ ឥណ្ឌា វៀតណាម និង រុស្ស៊ី អស់ រយៈពេល ២ឆ្នាំ ហើយ ។
វេជ្ជបណ្ឌិត ហាន់ ជីន ខ្វុន ត្រូវបាន គេ ស្គាល់ យ៉ាង ច្បាស់ ថា ជា អ្នកឯកទេស ដ៏ មាន ស្នាដៃ ក្នុង ការបង្កើត វិធីសាស្ត្រ បន្តឹង ស្បែក មុខ ដែល គ្មាន ភាពស្មុគស្មាញ និង មិន ប្រឈម គ្រោះថ្នាក់ ។
ស្វែងយល់ អំពី ជំងឺ ថ្លើម ពី វេជ្ជបណ្ឌិត មកពី បំរុង រ៉ាត់
មូលហេតុ អ្វី ដែល បណ្តាលឱ្យ មាន កើត ជំងឺ ថ្លើម ?
មូលហេតុ នាំឱ្យ កើត ជំងឺ ថ្លើម គឺ មកពី មេរោគ ច្រើន ប៉ះពាល់ ទៅដល់ ប្រព័ន្ធ រាងកាយ ។
មេរោគ គឺជា មីក្រូ ដ៏ តូច មួយ ធ្វើឱ្យ ប្រព័ន្ធ រាងកាយ ចុះខ្សោយ ហើយ វា ប៉ះពាល់ ដល់ ថ្លើម ខ្លាំង ជាង គេ ។
តើ មន្ទីរពេទ្យ បំរុង រ៉ាត់ ផ្តល់ ការព្យាបាល អ្វី ដល់ អ្នកជំងឺ ថ្លើម ?
សំខាន់ នោះ គឺ ធ្វើ ការ ការពារ សិន ហើយ ជំងឺ នេះ ជា ជំងឺ មួយ ដែល ឆ្លង តាម ឈាម អ៊ីចឹង យើង នឹង ការពារ តាមរយៈ ការប្រើប្រាស់ ម្ជុល និង កុំ ឱ្យ ប៉ះពាល់ គ្នា ពី មួយ ទៅ មួយ ។
ចំពោះ ប្រភេទ C វិញ គឺ ការឆ្លង តាមរយៈ ការរួមភេទ និង ឆ្លង តាម ម្តាយ ទៅ កូន ផងដែរ ។
ចំពោះ ជំងឺ ថ្លើម ប្រភេទ B វិញ ការឆ្លង ពី ម្តាយ ទៅ កូន គឺ វា តិចតួច ជាង ប្រភេទ C ហើយ ដើម្បី ការពារ ជំងឺ នេះ គឺ ចៀសវាង ការប្រើប្រាស់ ម្ជុល ជាមួយគ្នា និង ចំពោះ អ្នកម្តាយ ដែល សម្រាល កូន នោះ គឺ ត្រូវតែ ការពារ កូន ធ្វើ ម៉េច ឱ្យ ចេញ ឆ្ងាយ ពី ម្តាយ ដើម្បីឱ្យ ការឆ្លង នោះ វា មាន កម្រិត តិចតួច ។
ចំពោះ ការការពារ ទៅ លើ ជំងឺ នេះ អ្នក អាច ចាក់ ថ្នាំ វ៉ាក់សាំង ការពារ ចំពោះ កូនក្មេង តែ បី ដង ទេ ដើម្បី ការពារ ជំងឺ ថ្លើម ប្រភេទ B ក៏ប៉ុន្តែ ករណី រលាក ថ្លើម ប្រភេទ C វិញ គឺ គ្មាន វ៉ាក់សាំង ទេ ។
តើ មន្ទីរពេទ្យ បំរុងរ៉ាត់ អាច ព្យាបាល ជំងឺ ប្រភេទ B និង C ជាសះស្បើយ បាន តែ ម្តង ឬ ក៏ យើង ត្រូវតែ ប្រើប្រាស់ ថ្នាំ ជាប្រចាំ ?
ជាទូទៅ ជំងឺ រលាក ថ្លើម ប្រភេទ B យើង មាន ពីរ ប្រភេទ សម្រាប់ ពិនិត្យ និង ការពារ ទៅ លើ រោគ ថ្លើម ដោយ មាន ថ្នាំ ៥ ប្រភេទ សម្រាប់ លេប និង ១ ប្រភេទ សម្រាប់ ថ្នាំ ចាក់ ។
មន្ទីរពេទ្យ យើង ពិនិត្យ ព្យាបាល ត្រូវ ស្តង់ដារ អន្តរជាតិ ដូច នឹង ប្រទេស ដទៃ ទៀត ដែល ជឿនលឿន ផងដែរ ។
តើ ជំងឺ ថ្លើម នេះ មាន បញ្ចេញ រោគសញ្ញា យ៉ាងម៉េច ដែរ ?
ជំងឺ ថ្លើម នេះ មាន រោគសញ្ញា ភ្នែក លឿង ឈឺចាប់ ក្នុង សាច់ដុំ រក ក្អួត និង អស់ កម្លាំង ។
តើ មន្ទីរពេទ្យ អាច ដឹង ថា អ្នកជំងឺ ប្រឈម នឹង ឱកាស ជាសះស្បើយ ប៉ុន្មាន ភាគរយ ដែរ ឬ ទេ ?
វា យោង ទៅតាម អ្នកជំងឺ ដែរ ។
យើង មិន អាច ធានា បាន ១០០ ភាគរយ នោះ ទេ ប៉ុន្តែ អ្នកជំងឺ ខ្លះ ស្រួល ព្យាបាល ឯ អ្នកជំងឺ ខ្លះ ក៏ ពិបាក ។
អ្នកជំងឺ ខ្លះ គឺ ១០០ ភាគរយ ពិបាក ក្នុង ការព្យាបាល ណាស់ ហើយ អ្នក ខ្លះ ទៅ ពិបាក ព្យាបាល ៧០ ភាគរយ ។
បើសិនជា យើង ចាប់ផ្តើម ព្យាបាល គឺ យើង នឹង ប្រាប់ អ្នកជំងឺ ជាមុន ។
