ប៉ុន្តែ បើ អ្នក បណ្តោយ ឱ្យ ជំងឺ អញ្ចាញ ធ្មេញ បន្ត រាតត្បាត រយៈពេល យូរ វា ប្រាកដជា កាន់តែ រ៉ាំរ៉ៃ ពិបាក ស្រោចស្រង់ ។
ជំងឺ អញ្ចាញ ធ្មេញ មិន ត្រឹមតែ ប៉ះពាល់ មាត់ ធ្មេញ របស់ អ្នក ទេ ប៉ុន្តែ វា អាច ធ្វើឱ្យ អ្នក អាយុ ខ្លី ។
ដូច្នេះ ការថែទាំ មាត់ ធ្មេញ ជា ការថែទាំ សុខភាព ដ៏ ចាំបាច់ ដែល អ្នក ត្រូវតែ ធ្វើ ៕
ក្នុង មួយ ឆ្នាំ មាន ទាំង រដូវ ប្រាំង និង រដូវ វស្សា ដូចគ្នា ទៅនឹង ជីវិត របស់ មនុស្ស ម្នាក់ ៗ ដែល តែងតែ មាន វេលា មួយ រាំងស្ងួត ឃ្លាត ឆ្ងាយ ពី រសជាតិ ឡើង ឋានសួគ៌ កាម ទេព ពុំ ខាន ។
កត្តា ភូមិសាស្ត្រ ការប្រែប្រួល នៃ ដំណាក់កាល ក្នុង ជីវិត ដូចជា ការលែងលះ បាត់បង់ ដៃគូ ដោយ ប្រការ ណាមួយ ភាព មមាញឹក ក្នុង ការងារ វត្តមាន សមាជិក ថ្មី ក្នុង គ្រួសារ កត្តា អារម្មណ៍ ផ្លូវចិត្ត និង កត្តា សុខភាព គឺជា ដើម ចម ដែល នាំឱ្យ បុរស ស្ត្រី មួយចំនួន ខកខាន ចុះ សមរភូមិ លើ គ្រែ ។
មនុស្ស មួយចំនួន រយាល ពី សកម្មភាព រួម មេត្រី មួយ រយៈពេល វែង អាច ដោយសារ មូលហេតុ ឃ្លាត ឆ្ងាយ ពី ដៃគូ ជាក់លាក់ ។
គូស្នេហ៍ ដែល ឆ្លង ទ្វីប ប្រាកដជា ស្គាល់ នូវ អារម្មណ៍ នេះ ប្រសិនបើ ពួកគេ ពិតជា ប្តូរផ្តាច់ មិន លួច បង្កាត់ ភ្លើង តណ្ហា ជាមួយ អ្នកដទៃ ។
សម្រាប់ គូស្នេហ៍ ដែល ទើប ស្វាគមន៍ កំណើត កូន ជាទូទៅ ពួកគេ រង់ចាំ វេលា ប្រមាណ ៨ សប្តាហ៍ ទំរាំ រាងកាយ ដំណើរការបាន ដូច ដើម ។
សម្ពាធ ការងារ និង ស្ត្រេស ក៏ ធ្វើឱ្យ មនុស្ស មួយចំនួន លែង ខ្វាយខ្វល់ នឹង សិច ។
បើ ទោះជា ការបំពេញ កាមត ម្រេក ដោយ ខ្លួន ឯង អាច ដោះស្រាយ មួយ គ្រា ៗ ក៏ ពិត មែន ប៉ុន្តែ សកម្មភាព រួមភេទ ជាមួយ ដៃគូ ផ្ទាល់ ដែល ខកខាន រយៈពេល យូរ ពិតជា នាំមក នូវ ភាព ប្រែប្រួល ខ្លះ ដល់ រាងកាយ ។
ចំពោះ បុរស ភាព ប្រែប្រួល មិន មាន ច្រើន គួរឱ្យ កត់សម្គាល់ ទេ ប៉ុន្តែ តាម ការសិក្សា មួយចំនួន បាន រកឃើញ ថា បុរស ដែល មិន បាន រួមភេទ យូរ អាច ដល់ ត្រើយ សុខ លឿន ពេក ឬ ក៏ ប្រើ ពេល យូរ ពេក ទម្រាំ ដល់ ចំណុច កំពូល ពោលគឺ រយៈពេល ប្រតិបត្តិការ មិន ដូច គ្រា ដែល អនុវត្ត ញឹកញាប់ កាលពី មុន ឡើយ ។
ដោយឡែក ស្ត្រី ដែល ខាន រួមភេទ យូរ ចាប់ពី ២- ៣ខែ ឡើង ទៅ ភាព ប្រែប្រួល អាច មាន ច្រើន ជាង ដូចជា នាង មិន ងាយ មានអារម្មណ៍ កញ្ជ្រោល ទឹក រំអិល តិច ទ្វារមាស មាន សភាព ស្ងួត ការរួមភេទ អាច មាន ការឈឺចាប់ ខ្លះ ៗ និង ពិបាក ឡើង ដល់ ចំណុច ស្រណុក ស្រួល ។
សម្រាប់ ពួក នាង វា ហាក់បីដូចជា ភ្លេច មេរៀន ហើយ ទាមទារ ការរំឭក ឡើងវិញ ទើប អាច សូត្រ រត់ មាត់ ឡើងវិញ បាន ។
ចាប់ផ្តើម វិញ ដូចម្តេច ?
គូស្នេហ៍ ដែល ខកខាន ដឹក ដៃ គ្នា ឡើង ឋានសួគ៌ ជាទូទៅ ពួកគេ ភាគ ច្រើន តែង មាន ការរំពឹង ខ្ពស់ ថា ឱ្យ តែ បាន រួម មេត្រី នឹង គ្នា ត្រូវតែ ប្រតិបត្តិការ ឱ្យ អស់ចិត្ត តែម្តង ។
មិន ខុស អ្វី ពី វត្ថុ ដែល ទុក យូរ ទាមទារ ការសម្អាត ថែទាំ ឡើងវិញ ទើប អាច យកមក ប្រើប្រាស់ បាន ល្អ ដូច ដើម ។
រឿង សម្ព័ន្ធ ផ្លូវភេទ ក៏ ដូចគ្នា ដែរ គឺ បើ ឃ្លាត រយាល រយៈពេល យូរ ពេក អ្នក ត្រូវ ផ្សើម ភាពរាំងស្ងួត នោះ ដោយ សន្សឹម ៗ ។
ការសិក្សា ស្រាវជ្រាវ បែប ចិត្តសាស្ត្រ និង សុខភាព ផ្លូវភេទ រកឃើញ ថា គូស្នេហ៍ ដែល ខាន រួមភេទ ជាមួយគ្នា យូរ ជាពិសេស គឺ ភាគី ខាង ស្រី ទាមទារ ពេលវេលា យ៉ាងតិច ណាស់ ក៏ ៣ - ៤សមរភូមិ ដែរ ទើប នាង អាច ស្វែងរក អារម្មណ៍ ពុះកញ្ជ្រោល និង ដល់ ត្រើយ សុខ បាន ដូច ដើម ។
ក្រោយពី តម រួមភេទ រយៈពេល វែង ស្ត្រី មួយចំនួន ពេល ដែល ផ្តើម មាន ដៃគូ លើ គ្រែ ជាប់ លាប់ វិញ សមរភូមិ លើ គ្រែ អាច ធ្វើឱ្យ នាង មាន ការឈឺចាប់ តិចតួច រហូតដល់ ពីរ បី សប្តាហ៍ ទំរាំ រកឃើញ ត្រើយ សុខ វិញ ។
យ៉ាងណាមិញ ដៃគូ ទាំង សងខាង គួរតែ ស្វែងយល់ ពី ចំណុច តម្រូវការ ទាំង នេះ និង វិល មក បើក ទំព័រ ដំបូង វិញ នៅពេល ប្រតិបត្តិការ ។
ចូរ ធ្វើ ដោយ សន្សឹម ៗ និង យក អារម្មណ៍ មនោសញ្ចេតនា មក បញ្ឆេះ ភ្លើង តណ្ហា ជាជាង គិត តែ ពី វាយ សម្រុក ដោយ កម្រោល ។
សកម្មភាព យឺត ៗ អម ដោយ កាយវិការ បបោស អង្អែល គឺជា គន្លឹះ សំខាន់ ដែល ធ្វើឱ្យ ដៃគូ ខាន រួមភេទ យូរ អាច ស្វែងរក សេចក្តីសុខ លើ គ្រែ បាន ពេញលេញ ដូច ដើម វិញ ៕
ញ៉ាំ កាហ្វេ មួយ ថ្ងៃ ២ពែង អាច កាត់បន្ថយ បញ្ហា ប្រឈម ផ្លូវភេទ បុរស
ពិត ណាស់ ញ៉ាំ កាហ្វេ ពីរ ពែង ក្នុង មួយ ថ្ងៃ អាច កាត់បន្ថយ គ្រោះថ្នាក់ បញ្ហា ផ្លូវភេទ ៤២ ភាគរយ ប៉ុន្តែ មិន មែន មាន ន័យ ថា ទទួលទាន កាន់តែ ច្រើន ពេក កាន់តែ ល្អ នោះ ទេ ។
ការសិក្សា ក៏ បង្ហាញ ដែរ ថា ប្រសិនបើ ហ៊ាន ផឹក កាហ្វេ កើន ដល់ បី ពែង ក្នុង មួយ ថ្ងៃ នោះ វា បាន ជួយ កាត់បន្ថយ ការប្រឈម នឹង បញ្ហា សមត្ថភាព ផ្លូវភេទ បាន តែ ត្រឹមតែ ៣៩ ភាគរយ ប៉ុណ្ណោះ ។
ការស្រាវជ្រាវ បង្ហាញ ឱ្យដឹង បន្ត ទៀត ថា អត្ថប្រយោជន៍ កាត់បន្ថយ បញ្ហា សមត្ថភាព ផ្លូវភេទ បាន ពី ការផឹក កាហ្វេ នេះ សូម្បីតែ ក្រុម បុរស ធាត់ ដុះ ក្បាលពោះ និង អ្នក មាន ជំងឺ លើស ឈាម ក៏ ទទួល ផល ដូច បុរស មាន សុខភាព ល្អ ធម្មតា ដែរ លើកលែងតែ ក្រុម បុរស មាន ជំងឺ ទឹកនោម ផ្អែម ទើប មិន ទទួល ផល ពី ការផឹក កាហ្វេ ។
បុរស អាមេរិក ប្រមាណ ១៨ ភាគរយ មាន បញ្ហា សមត្ថភាព ផ្លូវភេទ ដែល ក្នុង នោះ សូម្បីតែ បុរស អាយុ ២០ ឆ្នាំ ក៏ ប្រឈម នឹង បញ្ហា នេះ ដែរ ៕
ការ កូរ ពោះ មិន មែន សញ្ញា ត្រូវ ញ៉ាំ តាមពិត ក្រពះ ធ្វើ ការសម្អាត សោះ
ក្រពះ របស់ យើង កូរ នៅពេល យើង ឃ្លាន ហើយ វា បាន កើតឡើង នៅ គ្រប់ ពេលវេលា នៅ ចន្លោះ ពេល ទទួលទាន អាហារ ទៅនឹង អាហារ ត្រូវបាន រំលាយ ពោះ ទំនេរ ។
ការទទួលទាន អាហារ ដើម្បី កុំ ឱ្យ កូរ ពោះ នឹង បញ្ឈប់ សំឡេង ក្រូក ក្រាក ភ្លាម ។
ប៉ុន្តែ ការញ៉ាំ អាហារ មាន ន័យ ថា ពោះ នឹង មិន ទំនេរ ឡើយ ។
នេះ គឺជា ហេតុផល មួយ ដែល អ្នកវិទ្យាសាស្ត្រ ផ្នែក ជីវជាតិ មួយចំនួន បាន ណែនាំ ថា យើង ទុក ពោះ ឱ្យ ទំនេរ រយៈពេល ៥ ម៉ោង ពី ចន្លោះ អាហារ មួយ ពេល ទៅ អាហារ មួយ ពេល ទៀត ។
ក្រពះ លាតសន្ធឹង ចាប់ពី ផ្នែក ខាងក្រោម សុដន់ ឆ្វេង ទៅ ចុង ផុត ខាងក្រោម ឆ្អឹងជំនីរ ខាងស្តាំ ដែល ស្ថិត នៅ ខ្ពស់ ឆ្ងាយ ពី ការគិត របស់ មនុស្ស ភាគ ច្រើន ។
ការឈឺចាប់ ផ្នែក ខាងក្រោម ពី ទីតាំង រៀបរាប់ ខាងលើ មិន អាច ចាត់ទុក ជា ការឈឺ ក្រពះ ឡើយ ។
៩ចំណុច សំខាន់ មែនទែន សម្រាប់ គូស្នេហ៍ ចង់បាន កូន
ទោះជា ធម្មជាតិ អាច កំណត់ វេលា ប្រទាន បុត្រ ដល់ អ្នក ប៉ុន្តែ មនុស្ស យើង ក៏ អាច ធ្វើ កិច្ចការ មួយចំនួន ដើម្បី បង្កើន អត្រា មាន គភ៌ តាម បំណង ផងដែរ ។
ខាងក្រោម នេះ ជា ការណែនាំ ៨ ចំណុច ដែល អ្នកជំនាញ ចង់ ចែករំលែក ជាមួយ គូស្នេហ៍ ប្រាថ្នា ចង់បាន ពន្លក ជីវិត ។
ស្ត្រី មួយចំនួន អាច សម្គាល់ វេលា នេះ តាមរយៈ ទឹក ដែល ធ្លាក់ តាម ទ្វារមាស មាន សភាព ថ្លា អន្ធិល និង រអិល ខុសប្លែក ពី ថ្ងៃ ផ្សេង ទៀត ដែល ទឹក នោះ មាន សភាព បីដូច ម្សៅ ស្ងួត ។
ស្ត្រី ដែល មាន វដ្ត រដូវ ២៨ ថ្ងៃ អាច បញ្ចេញ អូវុល នៅ ថ្ងៃទី ១៤បន្ទាប់ពី ថ្ងៃ មក រដូវ ។
ប៉ុន្តែ ស្ត្រី ខ្លះ អាច មាន វដ្ត រដូវ វែង ឬ ខ្លី ដែល គេ អាច ប្រើ វេបសាយ ឬ កម្មវិធី ទូរស័ព្ទ គណនា រក ថ្ងៃ បញ្ចេញ អូវុល ក៏ បាន ។
ប៉ុន្តែ បើ តាម ជាក់ស្តែង ក្បាច់ ឈរ ឬ អង្គុយ អាច កាត់បន្ថយ អត្រា មាន កូន ខ្លះ ដែរ ដោយសារតែ ទំនាញ ផែនដី ធ្វើឱ្យ មេជីវិត បុរស ពិបាក ហែល ក្នុង ទិសដៅ ចំណោត ឡើង ត្រង់ ។
វេលា នេះ អ្នក អាច បន្ត ផ្តល់ ការថ្នាក់ថ្នម យ៉ាង កក់ក្តៅ ចំពោះ គ្នា ខណៈ វា ក៏ អាច ទុក ឱកាស ឱ្យ មេជីវិត បុរស ធ្វើដំណើរ ឆ្ពោះ ទៅរក គោលដៅ បង្កកំណើត ដែរ ។
ក្រុម អ្នកជំនាញ បាន ណែនាំ ថា បើ ដល់ វេលា មាស ក្នុង ការបង្កកំណើត ហើយ ប្រតិបត្តិការ សិច ទៀងទាត់ ជារៀងរាល់ ២ ថ្ងៃ ម្តង ក៏ ប្រសើរ ដែរ ព្រោះ មេជីវិត បុរស អាច បន្ត នៅក្នុង ខ្លួន ស្ត្រី រយៈពេល ៧២ ម៉ោង ក្រោយពី រួមភេទ បាន សម្រេច ដល់ ត្រើយ ។
ចំពោះ ស្ត្រី វិញ ស្ត្រ សអោច ធ្វើឱ្យ ប៉ះពាល់ ដល់ ការបញ្ចេញ អូវុល ។
ដូច្នេះហើយ សូម ជម្រះ ភាពតានតឹង ទាំងនេះ និង ធ្វើឱ្យ អារម្មណ៍ ស្រស់ថ្លា ទើប ក្តី ប្រាថ្នា មាន បុត្រ បាន ដូច បំណង ។
ប៉ុន្តែ សម្រាប់ បុរស វិញ អ្នកជំនាញ ណែនាំ ថា បើ អាច គួរតែ ធីប ចោល សណ្តែក បៃតង និង សណ្តែក សៀង ។
ការស្រាវជ្រាវ ខ្លះ ថា ពពួក អាហារ ទាំង នេះ ធ្វើឱ្យ ចំនួន មេជីវិត ក្នុង ទឹក កាម មាន ការថមថយ ។
ស្រដៀង គ្នា នេះ ការត្រាំ ក្នុង អាងទឹក ក្តៅ និង ការដាក់ ទូរស័ព្ទ ក្នុង ហោប៉ៅ ខោ ជិត ពង ស្វាស អាច បង្កើន កម្តៅ ក្នុង បរិវេណ ពិសេស និង បន្ថយ គុណភាព ទឹក កាម ។
បញ្ឈប់ ការជក់ បារី ឬ ចេញ ពី បរិវេណ មាន ផ្សែង បារី ព្រោះ វា ពិតជា ប៉ះពាល់ ដល់ សមត្ថភាព មាន កូន ការបញ្ចេញ អូវុល និង កម្រិត អ័រម៉ូន អេស្ត្រូ ជិន ។
ប្រការ គួរ ចងចាំ ចូរ ធ្វើ អារម្មណ៍ ឱ្យ ស្រស់ថ្លា និង កុំ ដាក់ សម្ពាធ លើ ខ្លួន ឯង ព្រោះតែ ក្តីបារម្ភ ខ្លាច មិន មាន កូន ។
ក្រោយពី ប្រតិបត្តិ តាម ការណែនាំ នេះ ហើយ អំឡុង ពេល ១ ឆ្នាំ ស្ត្រី ជាង ៨០ ភាគរយ នឹង មាន ផ្ទៃពោះ ដូច ប្រាថ្នា ៕
ញ៉ាំ អំបិល ច្រើន នាំឱ្យ ក្មេង ពេញ វ័យ យឺតយ៉ាវ ប៉ះពាល់ សុខភាព បន្ត ពូជ
ការសិក្សា បាន រកឃើញ ថា អ្នក ញ៉ាំ អំបិល លើស ពី ៣ទៅ ៤ដង នៃ កម្រិត ណែនាំ ប្រចាំ ថ្ងៃ ពិតជា បង្កឱ្យ មាន ការលូតលាស់ យឺតយ៉ាវ ឆ្ពោះ ទៅរក ភាព ពេញ វ័យ ។
ក្រុម អ្នកស្រាវជ្រាវ អាមេរិក បាន និយាយ ថា នេះ អាច នាំឱ្យ មាន ការ កាត់បន្ថយ នូវ លទ្ធភាព បន្ត ពូជ និង បង្កើន កម្រិត ស្ត្រេស ខ្ពស់ ចំពោះ ក្មេង ជំទង់ ។
កម្រិត អំបិល ច្រើន ក្នុង របប អាហារ របស់ បស្ចិម ប្រទេស ទំនងជា ជះ ឥទ្ធិពល អាក្រក់ សម្រាប់ សុខភាព បន្ត ពូជ ចំពោះ មនុស្ស ជំនាន់ ថ្មី ។
អ្នកស្រី ដូរី ភីទីន ស្គី ជា អ្នកដឹកនាំ ការសិក្សា មកពី សាកលវិទ្យាល័យ វីយូមីង សន្និដ្ឋាន ថា ការញ៉ាំ អំបិល ពិតជា ចាំបាច់ សម្រាប់ ដំណើរ វិវឌ្ឍន៍ ឆ្ពោះ ទៅរក ភាព ពេញ វ័យ ប៉ុន្តែ ការបរិភោគ លើស ចំណុះ អាច ប៉ះពាល់ ដល់ សុខភាព បន្ត ពូជ វិញ ។
អង្គការ សុខភាព ពិភពលោក បាន រាយការណ៍ ថា ប្រជាជន ក្នុង ពិភពលោក កំពុង ប្រើ អំបិល ច្រើន ជាង កម្រិត ណែនាំ ៥ក្រាម ១ស្លាបព្រា កាហ្វេ ក្នុង មួយ ថ្ងៃ សម្រាប់ មនុស្ស ពេញ វ័យ ។
សារធាតុ សូដ្យូម ត្រូវបាន រកឃើញ ច្រើន ក្នុង អាហារ ប្រើ មេ ដូចជា នំប៉័ង សាច់ កែច្នៃ មាន សាច់ បី ជាន់ អាហារ សម្រន់ អាហារ ទាន់ចិត្ត និង គ្រឿងទេស ផ្សេង ៗ ៕
ហាត់ប្រាណ ត្រឹម ៣០នាទី ជា គន្លឹះ នាំឱ្យ បុរស វ័យ ចំណាស់ អាយុ វែង
ពួកគេ បាន បន្ត ថា ចំពោះ បុរស ក្នុង វ័យ ជ្រេ នេះ គ្រាន់តែ ហាត់ប្រាណ បន្តិចបន្តួច ជាប្រចាំ ក៏ ទទួលបាន ប្រយោជន៍ ស្មើនឹង ការឈប់ ជក់ បារី ដែរ ។
ចំពោះ ការស្រាវជ្រាវ នេះ ក្រុម វេជ្ជបណ្ឌិត បាន ត្រួតពិនិត្យ លើ បុរស រាប់ ពាន់ នាក់ កើត ក្នុង ចន្លោះ ឆ្នាំ ១៩២៣ និង ១៩៣២ ដែល មក ទទួល ការពិនិត្យ សុខភាព និង ស្ម័គ្រចិត្ត ផ្តល់ ព័ត៌មាន អំពី របៀបរបប នៃ ការរស់នៅ និង សកម្មភាព លំហាត់ប្រាណ របស់ ពួកគេ ។
ក្រុម ស្រាវជ្រាវ បាន ធ្វើ ការប្រៀបធៀប លទ្ធផល អំឡុង ឆ្នាំ ២០០០ និង ២០១១ នៅ ពេល ក្រុម អ្នកស្ម័គ្រចិត្ត ឈានដល់ វ័យ ៧០ - ៨០ ឆ្នាំ ។
ការសិក្សា របស់ ពួកគេ បាន រកឃើញ ថា ៖
