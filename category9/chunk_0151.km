ៃ ទិត យ្ទី១៩ ខែមករា
ហេតុ អ្វី យើង គួរ ស្វែងរក ចម្លើយ ចំពោះ សំនួរ ទាំង នេះ ?
អ៊ីរ៉ង់ មិន បាន បង្កើន បរិមាណ …
ដោយ ក្តីរីករាយ និង ស្វាគម ន័បំផុត
សូម រីករាយ កម្សាន្ត នៅ ឧទ្យាន ជាតិ វីរៈ ជ័យ ក្នុង ថ្ងៃ ឈប់សម្រាក !
ដូច្នេះ លើកទឹកចិត្ត កូន របស់ អ្នក ឱ្យ ធ្វើ លំហាត់ប្រាណ ឱ្យ បាន ច្រើន ។
តែ ទោះជា យ៉ាងណា លោក ឱ្យដឹង ថា កិច្ចពិភាក្សា នេះ នៅតែ អាច សម្រេច ជោគជ័យ ប្រកបដោយ ផ្លែផ្កា ។
តួអង្គ នេះ ស្រែក សន្ធាប់ ខ្ញុំ ត្រូវ ឃុំឃាំង ទីនេះ ៣ឆ្នាំ ហើយ !
ទំនោរ នៅក្នុង រូបថត ទាំងអស់ នោះ គឺ ប្រហែលជា ផ្នែក ដែល រំភើប ជាង គេ សម្រាប់ ខ្ញុំ ។
សូម សរសេរ ដំណើរ រឿង ខ្លី ប្រាប់ ពី របៀប ដែល អ្នក បាន សម្រេចចិត្ត ដើរ តាម ព្រះយេស៊ូវ ។
ហើយ លោក នាយ ឧត្តមសេនីយ៍ សៅ សុខា មិន គាំទ្រ អ្នកណា ដែល ធ្វើ ខុស ទេ ។
ព្រះសីហនុៈ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន …
បើ បាត់ខ្លួន ជនជាតិ គាត់ គាត់ មិន ធ្វើ ប្រតិកម្ម អី យើង ធ្វើ ម៉េច ?
ពួកគេ ក្រោក ពី ដេក នៅ ម៉ោង ៥ព្រឹក ដើម្បី ទៅ រក ប្រាក់ មួយចំនួន មុនពេល ទៅ សាលារៀន ។
ស្ត្រី មាន ជំងឺ ចង់ សិច គ្រប់ ពេល ម្នាក់ បាន ធ្វើ អត្តឃាត
អត្ថបទ បន្ទាប់ ប្រកាស តែងតាំង អភិបាល ខណ្ឌ ច្បារអំពៅ ថ្មី ជា ផ្លូវការ
ច្បាប់ ថ្មី ចេញ មិន ដល់ ២៤ ម៉ោង ផង ប៉ូលិស ចាប់ខ្លួន បាន ម្នាក់ បាត់
ទោះជា យ៉ាងណា ក៏ដោយ ជំងឺ រលាក ថ្លើម C អាច ត្រូវបាន ចម្លង តាម ឈាម ។
ឧសាន វាទ នេះ ត្រូវបាន ធ្វើឡើង ម្តង ទៀត កាលពី សប្តាហ៍ មុន ។
អាមុខ ស៊ី ក្មេងស្រី !
ទីបំផុត វា បាន ចូលទៅ ដែន ជម្រក សត្វ ព្រៃ មួយ ទៀត នៅក្នុង រដ្ឋ ម៉ាហា រ៉ាស្ត្រា ។
ស្លាប់ ៣ និង របួស ១៣នាក់ ក្នុង ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ១១លើក នៅ ថ្ងៃ នេះ - នគរបាល ជាតិ
នាង ត្រូវបាន គេ ចាប់រំលោភ ផ្លូវភេទ និង រឹតក សម្លាប់ ។
ធនាគារ ក៏ មិន ទាក់ទង លោក អ្នក ដើម្បី ស្នើសុំ ឱ្យ លោក អ្នក ផ្ទេរ ប្រាក់ ទៅកាន់ អ្នកណា ម្នាក់ ឬ ទៅកាន់ គណនី ណាមួយ ឡើយ ។
ត្រូវ នគរបាល សេដ្ឋកិច្ច បង្ក្រាប
គ្នា ហាក់ គ្មាន ការទទួលខុសត្រូវ ។
ពីមុន ប្រទេស វៀតណាម ទទួលបាន ផលចំណេញ ពី ប្រទេស ឡាវ ។
ក្នុង ឆ្នាំ ដដែល នេះ សម្តេច បាន និពន្ធ សៀវភៅ មួយ ឱ្យ ឈ្មោះ ថា អក្ខរវិធី សង្ខេប ។
សូម រីករាយ ស្តាប់ រឿង បេះដូង អូន ជា របស់ បង ដែល បញ្ចូល សម្លេង ដោយ សហការី វិទ្យុ វា យោ។
ស៊ីម៉ងត៍ ពណ៌ ខៀវ ចំនួន ២ស្រទាប់ ទំនាក់ទំនង ឥឡូវនេះ
ខ្ញុំ គិត ថា វា ប្រហែលជា ត្រឹមត្រូវ ក្នុង ការរំពឹង ថា រដ្ឋបាល បន្ទាប់ នឹង នៅតែ បន្ត ការងារ ទាំង នេះ ។
តារា ស្រី ស្រស់ស្អាត ២នាក់ កំពុង ផ្សាយ ផ្ទាល់ លើ ហ្វេសប៊ុក ធ្វើឱ្យ ប្រុស ៗ
ឆ្នាំ ទាំង៣ ដែល រឹតតែ ឈ្លោះ រឹតតែ មាន សុភមង្គល
ទោះ យ៉ាងណា ក្តី ពួកគាត់ នៅតែ ជួប បញ្ហា ប្រឈម មួយ ចំនួន ធំ នៅឡើយ ។
នេះ ជា លើក ទី មួយ ហើយ ដែល យុទ្ធជនជា ស្ត្រី ជនជាតិ ឃឺត បាន វាយប្រហារ ដោយ បំផ្ទុះ គ្រាប់បែក អត្តឃាត បែប នេះ ប្រឆាំង ក្រុម ឧទ្ទាម IS នេះ ។
មក ដូច ដើម ផងដែរ ខណៈ បច្ចុប្បន្ន កំពុង រស់ នៅ បែក លំនៅឋាន គ្នា ជាមួយ ប្រពន្ធ កូន នោះ ។
ឆ្នាំ ស្ថិត ក្នុង ការពិនិត្យ ឡើងវិញ ។
ប៉ុន្តែ អ្នកផលិត យ៉ាម៉ា បន្ត ទិញ វា រាប់ តោន ។
នាង និយាយ ថា ខ្ញុំ អាច គ្រប់គ្រង ស្ថានការណ៍ និង បង្កើត ប្រវត្តិសាស្ត្រ មួយ បាន ។
ក - ក្រុម ដឹកនាំ ការងារ ស្បៀង ពលកម្ម ប្រចាំ ក្រសួង អភិវឌ្ឍន៍ ជនបទ មាន ៦រូប
សូម មើល រូបភាព នេះ ក្នុង វីដេអូ ខាងក្រោម ទាំងអស់ គ្នា !
ព្រះកែវ ហ្វាពញា ញោម ក៏ ត្រូវ គេ ប្រហារជីវិត ចោល ទៅ ។
ទៀត ដើម្បី ផ្តល់ ជា ការកម្សាន្ត ដល់ កុមារ ក្នុង អង្គការ របស់ លោក ។
ពិការ មួយ គ្រួសារ ។
អា ហ្នឹង យើង តែងតែ ជួបប្រទះ កន្លងមក ។
បើ តាម ទំព័រ ហ្វេសប៊ុក ផ្លូវការមាតាម នុស៌្ស ធម បាន បង្ហោះ រូបភាព អម ជាមួយ សារ សរសេរ រៀបរាប់ ថា ៖
ដើម្បី ពង្រឹង ក្រុម ។
ទាន់សម័យ និង អ្នកសម្របសម្រួល ។
ទាញយក សៀវភៅ ដែល អ្នក ពេញចិត្ត
ម៉េច ដែរ ប្រិយមិត្ត តម្លៃ ប៉ុន នេះ អាច ពិចារណា បាន អត់ ?
លោក កឹម សុខា ដែល កំពុងតែ មាន អាការៈ ផ្តាសាយ ឈឺ បំពង់ ក ផង នោះ បញ្ជាក់ ថា រូប លោក មាន ការព្រួយបារម្ភ ខ្លះ ៗ
មិន អោយ កើតមាន តទៅទៀត ដោយ ត្រូវ គោរព បូរណភាព ទឹកដី របស់ ប្រទេស ជិតខាង ៕
ជារៀងរាល់ ឆ្នាំ អម្រឹត បាន និង កំពុង ពង្រីក បណ្តាញ ប្រតិបត្តិការ ទៅកាន់ ទីតាំង ជាច្រើន ទៀត ជា បន្តបន្ទាប់ ដើម្បី ជួយ ដល់ ប្រជាជន នៅ ទូទាំង ប្រទេស ធានា បាន នូវ អនាគត ល្អ ប្រសើរ ។
ស្រាប់តែ មាន បង ស្រី ម្នាក់ ដើរ មកហើយ សួរ ខ្ញុំ ថា ខ្ញុំ ត្រូវការ អី ។
ម្យ៉ាង វិញ ទៀត មន្ទីរពេទ្យ គឺជា កន្លែង ស្អាតស្អំ ។
លោក បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល មិន អាច រំលោភ កិច្ចសន្យា បាន ទេ ។
មហិច្ឆតា ជោគជ័យ នៃ មុខជំនួញ និង អាជីព ការងារ មិន ទាន់ គ្រប់គ្រាន់ ចំពោះ យុវជន របស់ យើង ឡើយ ។
មនុស្ស នឹង មិន សម្លឹងមើល ចម្ការ របស់ ខ្ញុំ ព្រោះតែ ពួកគេ រវល់ មើល រូប ស្រី ស្អាត សិចស៊ី ។
ពេល យុវជន យុវតី សង្គ្រោះ ជាតិ ដទៃ បាន រត់ ចូល ស្ថានទូត អាមេរិក នៅ ខែមករា៤,២០១៤,
ខ្លួន ហើយ ប្រឹង ស្រូបយក បទពិសោធ ថ្មី ៗ
សារព័ត៌មាន ដើម ត្នោត ផ្សាយ ក្នុង ៖
លោក ផៃ ស៊ីផាន មានប្រសាសន៍ បន្ថែម ថា ៖
លោក ឧត្តមសេនីយ៍ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ស្នងការ ខេត្ត កំពត នៅ ម៉ោង ៥ ៖
១១ព្រះបាទ សាឡូម៉ូន មាន ចំការទំពាំងបាយជូរ មួយ
ពួកវា បាន បង្ហាញ រូបរាង រាង ស្វ៊ែរ និង ផ្ទៃ រលោង រូបភាព ទី3 ។
គេ មិន ដែល ទៅ សន្និដ្ឋាន មុន តុលាការ គេ កាត់សេចក្តី នោះ ទេ ។
មាន ន័យ ថា អ្នកប្រើប្រាស់ អាច រក្សាទុក នូវ ព័ត៌មាន ដែល អ្នក បាន ឃើញ តែ មិន មាន ពេល គ្រប់គ្រាន់ អាន លំអិត ទុក សម្រាប់ អាន ពេល ក្រោយ ។
រាង ផ្លែ ប៉ោម ទម្ងន់ ច្រើន នៅ ត្រង់ កណ្តាល នៃ ខ្លួនប្រាណ
កម្រិត ជាតិ ស្ករ អាចនឹង កើនឡើង បើសិនជា រាងកាយ ស្ថិត ក្នុង ស្ថានភាពតានតឹង ពេក ។
គណៈកម្មការរៀបចំ មហោស្រព ភាពយន្ត ជាតិ លើក ទី៤ ឆ្នាំ ២០១៥ នៃ ក្រសួង វប៌្ប ធម និង វិចិត្រ សិល្បៈ បាន សម្រេច ជ្រើសរើស ខ្សែភាពយន្ត ចំនួន ៨រឿង ឱ្យ ចូលរួម ។
វា ជួយ ដល់ អ្នកប្រើប្រាស់ សម្រាប់ ការបញ្ចូល ទិន្នន័យ ឱ្យ បាន ងាយស្រួល ដល់ កម្រិត ទៀត
គួរ បញ្ជាក់ ថា សមត្ថកិច្ច ស្ទើរតែ គ្រប់ ជំនាញ ព្យាយា តាម ចាប់ រថយន្ត ដឹក ឈើ របស់ គេ ជា យូរ មកហើយ តែ មិន ដែល ចាប់ បាន ទាល់តែសោះ លុះ ជូប គ្រោះថ្នាក់ ចរាចរណ៍ នេះ ទើប ចាប់ បាន ។
ការកែលំអ ជា បន្តបន្ទាប់ នៃ លក្ខខ័ណ្ឌ ការងារ នៅ កម្ពុជា
ហេតុ អ្វី បានជា លោក ទៅ ហាង របស់ រ៉ូហ្សេត ញឹកញាប់ ម្ល៉េះ ?
នឹកឪ នឹក ម៉ែ កេរ ទ្រព្យ ដូនតា
ខាងក្រោម នេះ គឺជា វិធាន សំខាន់ ៗ
ប្រព័ន្ធ សង្គម វៀតណាម ហាក់ ពុំ បាន សម្តែង ការស្ងើចសរសើរ ពី ភាព មាន បាន របស់ គាត់ ទេ ។
ព្រោះ មេដឹកនាំ វ័យ ក្មេង រូប នេះ ពិបាក នឹង ស្មាន ចិត្ត ដឹង ណាស់ ។
មាន ភាពខុសគ្នា អាស្រ័យ លើ ទំហំ ដី ទីតាំង និង រចនាបទ ។
នេះ ជា ការមើលឃើញ ដំបូង ៗ
ត្រង់ ចំណុច នេះ ប្រធានាធិបតី ថ្មី បារាំង អាច ត្រូវតែ សំឡឹង មើល បញ្ហា ចំពោះ មុខ ជាក់ស្តែង នៅ ស៊ីរី ផ្ទាល់ ។
ការបោះឆ្នោត ដើម្បី ជ្រើសរើស រដ្ឋសភា ថ្មី នឹង ប្រព្រឹត្តទៅ ក្នុង រយៈពេល ៦០ ថ្ងៃ យ៉ាង យូរ ចាប់តាំងពី ថ្ងៃ រំលាយ សភា មក ។
ម៉េច ក៏ អូសបន្លាយ ពេល យូរ បែប នេះ ហើយ មិន ទាន់ ចប់ ទៀត មាន វីដេអូ
តើ ប្រទេស កម្ពុជា និង ម៉ាឡេស៊ី បាន ជួយ គ្នា យ៉ាងដូចម្តេច ក្នុង ការដោះស្រាយ បញ្ហា ជាមួយ ប្រទេស មហា អំណាច ដូចជា សហភាព អឺរ៉ុប និង សហរដ្ឋ អាមេរិក ?
ចំណែក អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ លោក ខៀវ សុភ័គ សុំ មិន ធ្វើ អត្ថាធិប្បាយ លើ រឿង នេះ ទេ ។
សកម្មភាព ប្រតិព័ទ្ធ ភេទ ដូចគ្នា គឺ ខុស ច្បាប់ នៅក្នុង ប្រទេស ម៉ាឡេស៊ី ដោយ សិទ្ធិ នៅក្រោម ច្បាប់ រដ្ឋ និង បញ្ញត្តិ សាសនា ហើយ ដែល អាច កេណ្ឌកម្ម ទោស ពន្ធនាគារ ឬ ការដាក់ទណ្ឌកម្ម មក លើ រូបរាងកាយ ។
ទំព័រ ដើម ព័ត៌មាន សន្តិសុខ សង្គម ទោះ មិន បាន កើត ក្នុង ថ្ងៃ តែ មួយ តែ ៨នាក់ នេះ បាន ចូល គុក ជាមួយគ្នា ក្នុង ថ្ងៃ តែ មួយ
ក៏ប៉ុន្តែ ចំនួន នេះ បាន ថយចុះ បន្តិច ម្តង ៗ
អាជីវករ ត្អួញ ថា នរណា ៗ
ប្រតិបត្តិការ តាម រុករក និង ជួយសង្គ្រោះ កំពុង បន្ត ៕
ត្រាំ ព្រមាន រុស្ស៊ី ឱ្យ ត្រៀម ទទួល មីស៊ីល បាញ់ ចូល ស៊ីរី !
បើ តាម សមត្ថកិច្ច ថា គ្រោះថ្នាក់ ចរាចរណ៍ ខាង លើ នេះ មិន មាន មនុស្ស រងគ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ទេ ។
គេ ឈ្មួញ ចង់បាន ដី បាន ដី ឡូតិ៍ ក្បែរ ផ្លូវ ។
១ - គ្រូពេទ្យ ប្រកប មុខរបរ គ្មាន លិខិត អនុញ្ញាត ពី ស្ថាប័ន ជំនាញ ពាក់ព័ន្ធ ។
ជាមួយគ្នា នេះ ស្ថានីយ វិទ្យុ និង ទូរស្សន៍ ក្នុង ស្រុក ខ្លះ ក៏ ផ្សាយ បន្ត ផ្ទាល់ អំពី សវនាការ នេះ ដែរ ។
លោកស្រី ប្រមុខ រដ្ឋាភិបាល អាល្លឺម៉ង់ ធ្វើ មិន ដឹង ឱ្យ អាមេរិក ឈ្លប ស្តាប់ អឺរ៉ុប ឬ ?
នេះ បាន ធ្វើ ទស្សនកិច្ច ទៅកាន់ ប្រទេស ចិន ជួប ជាមួយ មេដឹកនាំ យោធា ជាន់ ខ្ពស់ ចិន ជាច្រើន រូប ។
ប្រការ គួរ ហាម ប្រាម គ្រប់ ពេល ដែល ទល់ លាមក ម្តង ៗ
ម្ចាស់ បទ អចេតនា ដែល បាន ជាប់ ចំណាត់ថ្នាក់ លេខ ១ផ្ទួន ៗ
ទិន្នន័យ ភាគ ច្រើន បាន រាយការណ៍ ថា គល់ ឈើ កាត់ រួច មួយ ៗ
កម្មវិធី និរទេស នេះ បាន ក្លាយជា ចំណុច ក្តៅ គគុក រវាង អាមេរិក នឹង កម្ពុជា បន្ទាប់ពី កម្ពុជា បាន ផ្អាក ឈប់ ទទួលយក អ្នក ដែល ត្រូវ និរទេស ថ្មី កាលពី ឆ្នាំ មុន ដោយសារ បារម្ភ ពី ការប៉ះពាល់ ដល់ សិទ្ធិ មនុស្ស ។
ពិតជា វេទនា មែន បង ។
សសយក ខេត្ត បាត់ដំបង
បើ មិន លឿន បច្ចេកវិទ្យា នឹង ជំនួស ការងារ អ្នក
គ្មាន កិច្ចព្រមព្រៀង ត្រូវ ចុះហត្ថលេខា ឡើយ រវាង …
ក្រុមប្រឹក្សា ធម្មនុញ្ញ បកស្រាយ ថា ព្រឹទ្ធសភា អាច ស្នើសុំ ធ្វើ វិសោធនកម្ម ច្បាប់ បាន
