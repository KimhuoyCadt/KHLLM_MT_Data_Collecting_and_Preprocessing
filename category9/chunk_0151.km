សមិទ្ធិ ប្រេង គឺ មិន មែន កើតឡើង ដោយ ការអភិនិហា ដូច ក្នុង រឿង ព្រេងនិទាន ទេ ។
នេះ មាន មនុស្ស តិចតួច ប៉ុណ្ណោះ ដែល ជឿ ថា ករណី លោក ថាក់ស៊ីន ដូចគ្នា ជា
ស្តាប់ ឮ ឡើង ស៊ាំ គ្មាន ឃើញ ធ្វើ អ្វី មាន លទ្ធផល ធំដុំ សោះ ក្នុង នាម
បើសិនជា គ្មាន ជំនួយ របស់ គ្រួសារ ទេ នឹង មាន ឧបសគ្គ រាប់ មិន អស់ ។
លោក ចាត់ទុក ការអះអាង បន្ត ការស៊ើបអង្កេត នេះ គ្រាន់តែ ជា លេស ពន្យារ ពេល ដើម្បី បញ្ចប់ រឿង តែ ប៉ុណ្ណោះ ។
អ្នក វិនិយោគ ភាគ ច្រើន ផ្តោត ការសាងសង់ បុរី នៅ រាជធានី ភ្នំពេញ ប៉ុន្តែ ហេតុ អ្វី លោក មកវិនិយោគ នៅក្នុង ខេត្ត បាត់ដំបង ?
រ៉េន និយាយ ថា រូបភាព ដែល ថត ដោយ គ្រួសារ និង មិត្តភក្តិ ត្រូវបាន ប្រមូលផ្តុំ ក្នុង អាល់ប៊ុម មួយ ។
អ្វី ខ្លះ នោះ អាច ស្វែងយល់ តាម រយៈ ចំណុច មួយចំនួន ខាងក្រោម នេះ ៖
ប៉ុណ្ណោះ ទេ ថែមទាំង មាន បញ្ហា និទ្ទណ្ឌភាព ភាព រួច ទោស ចំពោះ អ្នកប្រព្រឹត្ត ទៀត ។
អា ប្រាហាំ បាន ស្លាប់ ហើយ ពួក អ្នកប្រកាស ទំនាយ ក៏ បាន ស្លាប់ ដែរ ប៉ុន្តែ អ្នក និយាយ ថា ៖
សូម ជម្រាប សួរ លោក លោកស្រី និង អ្នកនាង កញ្ញា !
បើ ការបោះឆ្នោត ពិតជា អាច ផ្លាស់ប្តូរ របប ផ្តាច់ការបាន ហេតុ អ្វី បានជា ប្រទេស នានា ជាច្រើន នៅលើ សាកលលោក កម្រ ផ្លាស់ របប ដឹកនាំ ប្រភេទ នេះ តាមរយៈ ការបោះឆ្នោត ខ្លាំង ម្ល៉េះ ?
សម្រាប់ ប្រទេស គេ មាន មហាវិទ្យាល័យ ចំណុះ ពី ៥ទៅ ៦ឯណោះ ។
បន្ទាប់ពី នោះ មក លោក បាន សំរេចចិត្ត ត្រលប់ ទៅ អាហ្វ្រិក ម្តង ទៀត ។
ចំនួន អនីតិជន នៅក្នុង ពាណិជ្ជកម្ម ផ្លូវភេទ បាន ធ្លាក់ចុះ
បំពាក់ នូវ ថេប្លិត ឌីជីថល ដែល មុខ ម្ហូប អាច ត្រូវបាន ជ្រើសរើស និង កុម្ម៉ង់ ។
អាមេរិក ទម្លាក់ គ្រាប់បែក ច្រើន ណាស់ នៅ អាហ្វហ្គានីស្ថាន ប៉ុន្តែ អត់ បាន ចុះ ក្នុង របាយការណ៍
គណៈកម្មការ បាន បញ្ជាក់ ទៀត ថា កម្មវិធី ផលិត ទូកង នេះ រៀបចំ ក្នុង គោលបំណង ដូចត ទៅៈ
ម្តងម្កាល មេ មាន់ លប ខ្តត ពី ច្បារ ស៊ុប ទ្រុប ពញ្ញាក់ រហោភាព ។
ភ្លើង ឆេះ ព្រៃ កាលពី ពីរ ឆ្នាំ មុន បាន បំផ្លាញ ព្រៃឈើ និង បង្កឱ្យ ដី មាន សភាព ធូររលុង ។
ដោយឡែក លោក ហេង ហ៊ុយ ពុំ អាច ទំនាក់ទំនង សុំ អត្ថាធិប្បាយ
នាង ហ្គីសែល និយាយ ថា នាង នឹង ប្រើ លុយ នេះ ដើម្បី បង់ ថ្លៃ មហាវិទ្យាល័យ ទិញ ផ្ទះ ថ្មី និង ធ្វើដំណើរ ជុំវិញ ពិភពលោក ។
បទភ្លេង មេត្តា រៀម ផង ក៏ មាន កំណើត ពី ប្រទេស ជប៉ុន
នោះ ក៏ យើង សម្រេចបាន មួយចំនួន ធំ ផងដែរ ដូចនេះ ជា រួម អាចនឹង រួចរាល់ នៅ ថ្ងៃស្អែក ។
រថភ្លើង មិន អាច ឈប់ បាន ភ្លាម ៗ
២៣ ក៏ប៉ុន្តែ បងប្អូន ត្រូវតែ កាន់ ជំនឿ អោយ បាន រឹង ប៉ឹង ខ្ជាប់ខ្ជួន ដើម្បី កុំ អោយ ឃ្លាត ចាក ពី សេចក្តីសង្ឃឹម ដែល បងប្អូន មាន តាំងពី បាន ឮ ដំណឹង ល្អមក នោះ គឺជា ដំណឹង ល្អ ដែល គេ បាន ប្រកាស ដល់ មនុស្សលោក ទាំងអស់ នៅក្រោម មេឃ ហើយ ខ្ញុំ ប៉ូល បាន ទទួល មុខងារ បំរើ ដំណឹង ល្អ នេះ ដែរ ។
បើ មន្ទីរ ធម្មការ និង សាសនា ខេត្ត ជឿជាក់ ថា អំណាច ធ្វើ ការសម្រេចចិត្ត វា ស្ថិត នៅ ក្រៅ ការគ្រប់
លោក បន្ត ទៀត ថា លោក នឹង បំផ្លាញ វរ បុរស ប្រដាល់ ហ្វីលីពីន ម្នាក់ នេះ ។
លោក បាន បន្ត ថា ខ្ញុំ នឹង ឱ្យ ក្រុម មេធាវី របស់ ខ្ញុំ ប្តឹង អ្នកណា ដែល ចោទប្រកាន់ ខ្ញុំ ថា បាន ធ្វើ ការប្រមាថ ព្រះមហាក្សត្រ ។
អង្គការ តម្លាភាព អន្តរជាតិ ៖
រឿង បញ្ចូន ហ្នឹង មាន បញ្ហា ពីរ រឿង ។
គ្រឿងទេស ដែល មិន មាន ជាតិ អាល់កុល - ម៉ឺនុយ
បន្ទាប់ពី ជួប គ្រោះថ្នាក់ ខាងលើ នេះ ។
ចំណាយ ពេល រហូតដល់ ជាង ២ ឆ្នាំ រហូតដល់ ចុង ឆ្នាំ ២០១៤ ទើប លោក បាន បោះពុម្ព សៀវភៅ នេះ ឡើង ។
ឪពុក ខ្ញុំ ខ្លះ ស្រី និង ខ្លះ ទៀត ប្រុស ថ្មី ៗ
ប្រធានាធិបតី ត្រាំ បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ ថា កិច្ចសហប្រតិបត្តិការ របស់ រដ្ឋាភិបាល ប៉ាគីស្ថាន ជា សញ្ញា មួយ ថា ប៉ាគីស្ថាន កំពុង គោរព បំណងប្រាថ្នា របស់ អាមេរិក ដើម្បី ធ្វើ កាន់តែ ច្រើន ឡើង ដើម្បី ផ្តល់ សន្តិសុខ នៅក្នុង តំបន់ ៕
ប៉ុន្តែ ទោះបី គណបក្ស ធំ ៗ
រូប គាត់ ផ្ទាល់ ជា អ្នកថែរក្សា អ្នកបរិច្ចាគ សរីរាង្គ ទាំងនោះ ដោយ យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង បំផុត ។
ឆ្នាំ ទាំង៣ឱ្យ តម្លៃ ការងារ ជាង ស្នេហា ទោះបីជា មាន លុយ ច្រើន តែ ត …
ជាមួយនឹង ផល រំខាន នៃ ការលូតលាស់ ទារក ក្នុង ផ្ទៃ គ្រប់គ្រាន់ នឹង ធ្វើឱ្យ អ្នក ពិបាក ទ្រាំ ណាស់ ហើយ ។
រថយន្ត បែន យីឌុប ដឹក ថ្ម បុក ម៉ូតូ ពីក្រោយ រួច កិន ស្ត្រី ម្នាក់ ខ្ទេច សាច់ ស្លាប់ យ៉ាង អណោច អធម៌
ជាក់ស្តែង នៅក្នុង ជួរ មន្ត្រីរាជ រដ្ឋ ភិបាល ជប៉ុន បច្ចុប្បន្ន គឺ មាន រដ្ឋមន្ត្រី ភេទ ស្រី តែ ម្នាក់ គត់ ។
ដូចជា ដី ហុយ និង មាន ជង្ហុក ជាដើម ដោយសារតែ ផ្លូវ ស្ថិត ក្រោម ការស្ថាបនា នៅឡើយ ។
លោក បន្ត ថា លោក នឹង នៅតែ ធ្វើ ការងារ ជា សកម្មជន ការពារ បរិស្ថាន បន្ត ក្នុង អំឡុង ពេល ដាក់ ឯកសារ ។
ខ្ញុំ សង្ឃឹម ថា នឹង បាន ទស្សនា សិល្បៈ បែប នេះ និង សិល្បៈ ថ្មី ៗ
ចំណែក លោក ឡុង កុសល បាន បញ្ជាក់ បន្ថែម ថា ហ្វូង សត្វ ស្វា កាច ៗ
ទោះ យ៉ាងណា ក៏ដោយ កំរិត នៃ ការប៉ះពាល់ ជំងឺ ឆ្លង នេះ ទៅ លើ ប្រទេស នានា មាន ការខុស ៗ
ប៉ុន្តែ រហូតមក តួកគី និង អាមេរិក …
នៅ ដើម ខែធ្នូ នេះ ខេត្ត សៀមរាប មាន ហេតុការណ៍ ពុល អាហារ ចំនួន ២លើក ហើយ ។
នេះ គឺជា ហេតុផល ទាំង១០ ថា ហេតុ អ្វី បានជា មនុស្ស ប្រុស មិន ចង់ រួមភេទ ៖
