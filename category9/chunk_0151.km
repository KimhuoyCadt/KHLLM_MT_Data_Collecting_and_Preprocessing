ជម្លោះ នៃ ការបោះឆ្នោត ជាតិ ក្នុង ខែកក្កដា ឆ្នាំ ២០១៣ នៅ កម្ពុជា បាន វិវត្តន៍ បន្តិច ម្តង ៗ
សូម ផ្តល់ ការគាំទ្រ ដោយ បញ្ចូល ព័ត៌មាន របស់ អ្នក ក្នុង ប្រអប់ ដែល បាន ផ្តល់ ជូន ។
សំយ៉ាប របង ផ្ទះ ប្រជាពលរដ្ឋ ។
សូម កញ្ញា កុំងស់សង្ឃឹម នឹង ជីវិត្ត អី ត្រូវ ខំប្រឹងប្រែង ដើម្បី បញ្ជាក់ ប្រាប់ ពួកគេ ថា កញ្ញា មិន មែន ជា នារី ម្នាក់ ទន់ខ្សោយ ត្រូវបាន គេ ជិះ ជាន់ ស្រេច តែ តាម អំពើចិត្ត នោះ ទេ ។
នរណា មិន ខ្នាញ់ បើ កូនស្រី ភិន សុដាលី ស ស្រស់ស្អាត ម្លឹង ៗ
តាម វិធី សមរម្យ មួយ ។
នេះ ជា ឧបទ្ទវហេតុ បាញ់ប្រហារ ចុងក្រោយ ក្នុង ចំណោម ការបាញ់ សម្លាប់ មនុស្ស ច្រើន ៗ
និង ខុសប្លែក ជាង រាល់ ដង ។
កាន់តែ ពិបាក ដោយសារ ការ រំលាយ អាហារ មិន បាន ល្អ នាំឱ្យ …
សម្រាប់ អនាគត នៃ ការស្រាវជ្រាវ ទៅ តំបន់ កាន់តែ ឆ្ងាយ ៗ
ខ្ញុំ គិត ថា អ្នក ដាក់ និយមន័យ អហ្នឹង ប្រហែលជា ច្រឡំ ពាក្យ ថា ឌួង ជាមួយ ពាក្យ ដូង មើល ទៅ ។
ពេល នោះ ខ្ញុំ កំពុងតែ ដើរលេង ក្នុង ពិធី បុណ្យ មួយ ហើយ
ពេល សង់ ទំនប់ វារី អគ្គិសនី រួចហើយ ពួកគេ នឹង រត់ បាត់ ។
នេះ បើ តាម លោក ជ្រើម ប្រែន អធិការង ស្រុក ពេជ្រាដា ។
លោក រុន សុផាន់ ណារ៉ា ទទួលស្គាល់ ថា យើង បារម្ភ ខ្វះ ទឹក មែន ។
អត្ថប្រយោជន៍ នៃ ផ្លែ ល្ពៅ ដែល អ្នក គួរតែ ដឹង !
យកហត្ថលេខា កីឡាករ វ័យ ២១ឆ្នាំ រូប នេះ ។
ក្រោយ បាន ចែករំលែក លើ អ៊ីនធឺណិត រួច លោក ត្រូវបាន រាយការណ៍ ថា ត្រូវ ចាប់ ឃាត់ខ្លួន ពីសំណាក់ សមត្ថកិច្ច ។
ជនភៀស សឹក ជាច្រើន ជាពិសេស កុមារ កំពុង កើត ជំងឺ ។
គាត់ បាន និយាយ ថា ខ្ញុំ គិត ថា វា មិន មាន ប្រសិទ្ធភាព ទាល់តែសោះ ពីព្រោះ ប្រាក់ខែ គ្រូបង្រៀន តិច ណាស់ ។
ក៏ប៉ុន្តែ គេ មិន អាច និយាយ ថា អ្នក ទាំងនោះ គ្មាន បាន ទទួលរង្វាន់ អ្វី សោះឡើយ ដោយ ហេតុ ថា តាំងពី សម័យ អង្គរ មាន ការប្រើ ពាក្យ ឈ្នួល ជួល សំរាប់ សំគាល់ នូវ មនុស្ស ដែល គេ ជួល ។
សភា អ៊ីស្រាអែល អនុម័ត ច្បាប់ ហូត ដី ពី …
សុំទោស ផង វា ឈ្មោះ ជាតិ គឺ សរសេរ ដូច ក្បត់ ជាតិ អព្ចឹាង ។
មាន ទឹក សម្ល និង របោយ បន្លែ ទៅតាម ចំណង់ចំណូលចិត្ត របស់ មនុស្ស ម្នាក់ ៗ
មាន បន្ទប់ ចំនួន ៦ជាន់ នៅ ជាន់ ខាងលើ ២ក្នុង វីឡា នីមួយ ៗ
ដូចនេះ ដើម្បី កុំ អោយ ខាត ពេល យូរ នោះ សូម តាមដាន ជាមួយ យើងខ្ញុំ ទាំងអស់ គ្នា !
បន្ទាប់ពី ផ្នែក ជំនាញ បាន ធ្វើតេស្ត ពិសោធន៍ យ៉ាង ច្បាស់ ក៏ រកឃើញ ថា វត្ថុសង្ស័យ ទាំងនោះ សុទ្ធតែ ជា គ្រឿងញៀន ទាំងអស់ ៕
តើ ឈ្មោះ ដំបូង ម៉ាសាវ៉ា មាន ន័យ យ៉ាងម៉េច ?
តួកគី រក្សា ការទាក់ទង់ គ្នា ជាមួយ ទីក្រុង ដាម៉ាស
បើ មាន ចម្ងល់ គួរ ប្រឹក្សា ជាមួយ គ្រូពេទ្យ បន្ថែម ។
ភាគី ទាំងអស់ ត្រូវតែ គោរព ដោយ ការបំបែក កិច្ចព្រមព្រៀង កម្លាំង ជាមួយ ប្រទេស ស៊ីរី
តំណាង ក្រុមហ៊ុន វិសិន ហ្វាន់ អន្តរជាតិ មិន ទាន់ អាច បញ្ជាក់ ពី ទឹកប្រាក់ នៃ កិច្ចព្រមព្រៀង ទិញ លក់ នេះ បាន ទេ នៅ ថ្ងៃ នេះ ។
លុះ ព្រឹក ថ្ងៃទី ១៨ ខែមេសា ប្រពន្ធ បាន ចូល បន្ទប់ សម្រាល កូន ។
យ៉ាងណាមិញ បើ សូម អាន បន្ត
នេះ បើ យោង ទៅតាម ការរៀបរាប់ របស់ លោក ផ្ទាល់ ក្នុង ពេល ថ្មី ៗ
ដូចគ្នា នេះ ដែរ ភាព មួរ មៅ របស់ ទារក អាចនឹង កើតឡើង នៅ ពេល ដែល គេ គេង មិន គ្រប់គ្រាន់ ។
ដូចនេះ សាធារណៈ ជន អាច ចូល ទស្សនា ដោយ មិន គិត ប្រាក់ ។
លោក ដួង វីរៈ សិទ្ធ ចំណាយ ពេល ២ ថ្ងៃ ដើម្បី និពន្ធ បទចម្រៀង ឱ្យ ប្អូន យឿន ពិសី សម្រេច បំណង របស់ គេ
ពលរដ្ឋ ចាំ មើល តើ លោក ហែម ដារឹទ្ធអភិបាល នៃ គណៈអភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ មាន វិធានការ យ៉ាងណា ចំពោះ ទីតាំង ណេត បង្កប់ ល្បែងស៊ីសងខាងលើ នេះ ?
បើ មិន ចង់ មាន ការ ប្រេះស្រាំ គូស្នេហ៍ ដែល នៅ ឆ្ងាយ គ្នា ត្រូវ មាន ចំណុច ទាំង ៤នេះ
លោក ត្រូវ ហ្វឹកហាត់ យ៉ាងតិច ៥ ម៉ោង ឯណោះ ។
តែ ទោះជា យ៉ាងណា ចំណាត់ថ្នាក់ នេះ មាន ន័យ ថា ស្ថានភាព ស្រេកឃ្លាន របស់ កម្ពុជា នៅ មាន លក្ខណៈ ធ្ងន់ធ្ងរ នៅឡើយ ។
ដូច យើង ដឹង ហើយ ថា តន្ត្រី ជា ប្រភព កម្សាន្ត និង ឆ្លុះបញ្ចាំង ជា រឿងរ៉ាវ ផ្សេង ៗ
អ្នកស្រី មូរ សុខ ហួរ ក៏ មាន ឈ្មោះ ក្នុង ដីកា កោះហៅ ដែរ ។
លោក ដូណាល់ ត្រាំ ទៅ សួរសុខទុក្ខ ទាហាន …
តើ មាន ភ័ស្តុតាង ក្នុង រឿងក្តី មន្ត្រី សមាគម អាដហុក ដែរ ទេ ?
ឯកឧត្តម បាន បន្ត ថា រហូតមកដល់ ពេលនេះ អាជ្ញាធរ ទម្លាក់ បាន ជាង ១០០ ស្លាក ហើយ ៗ
ត្រូវ កម្លាំង នគរបាល ចាប់ បាន ៥នាក់ រឹបអូស វត្ថុតាង មួយចំនួន
កសិករ វ័យ ចំណាស់ រូប នេះ បាន និយាយ ទាំង ទឹកមុខ សប្បាយ ររីករាយ នៅមុខ ចម្ការ ពោត របស់ ខ្លួន ដូច្នេះ ៖
លោក នាយក រដ្ឋមន្ត្រី ចង់ នាំឱ្យ មាន ភាព ផ្តាច់ការ ៕
ថែរក្សា ស្បែក អ្នក ឱ្យ ភ្លឺ រលោង តាម វិធី ទាំងនេះ
តើ នាង ឈឺចាប់ ប៉ុណ្ណា ពេល ត្រូវ ស្ត្រី ចិត្ត ខ្មៅ នោះ វាយដំ ធ្វើ ទារុណកម្ម បែប នេះ ?
ការអនុវត្ត ច្បាប់ អាជ្ញា សឹក មិន ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច ឡើយ សារព័ត៌មាន នគរ វត្ត
សេណារីយ៉ូ នេះ ជា ផល អាក្រក់ ខ្លាំង ណាស់ ។
តើ ជម្រើស វិទូ រុក្ខជាតិ និង អ្នក ដាំ ដំណាំ នៅ ជុំវិញ ពិភពលោក អាច បន្តបង្កើន ផលិតកម្ម ម្ហូប អាហារ នៅក្នុង ល្បឿន ស្រប គ្នា នឹង អត្រា កំណើន ប្រជាជន ពិភពលោក ដែល បាន ព្យាករណ៍ ថា នឹង កើន ពី ចំនួន ៧,២ពាន់ លាន នាក់ បច្ចុប្បន្ន ទៅ ៩,៦ពាន់ លាន នាក់ នៅ ឆ្នាំ ២០៥០ ឬ ទេ ?
ដែល លោក ហាបៀរ សូឡា ថត ពេល ខ្ញុំ មិន ដឹងខ្លួន ក្នុង ខណៈពេល ខ្ញុំ អង្គុយ មើល អ្នកផង រីករាយ ជាមួយ ទឹក ធ្លាក់ ។
ដែល កើតឡើង នៅ ជុំវិញ ខ្លួន មនុស្ស នេះ ឯង ។
