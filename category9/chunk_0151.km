ប្រការ នេះ ត្រូវបាន បណ្តា តំណាង អះអាំង នៅក្នុង ជំនួប សន្ទនា ៖
ករណី នៅ ស៊ីរី ប្រជុំ សន្តិសុខ នៅ អង្គការ សហ ប្រជាជាតិ ថ្មី ៗ
ទំនាក់ទំនង ជា មិត្តភាព រវាង កម្ពុជា និង ចិន កាន់តែ មាន ភាពជិតស្និទ្ធិ និង រឹង ម៉ាំ ទ្វេ ឡើង ។
ប៉ុន្តែ វា គ្រាន់តែ ជា ការណ៍ ពិត ដែល ខ្ញុំ អាច បង្ហាញ បន្ថែម ដោយ ការរៀបរាប់ លម្អិត នៃ សារ ដែល ខ្ញុំ ទទួលបាន នៅ ថ្ងៃ នោះ ពី ភ្នំពេញ ។
ចុះ ទម្រាំ ការ ទទួល ប្រជាពលករ រាប់ ម៉ឺន នាក់ នោះ ក៏ ពុំ ងាយស្រួល ឡើយ ។
លោក សម រង្ស៊ី អះអាង បោះចោល សញ្ជាតិ ខ្មែរ ក្នុង ការវិល ចូល ស្រុក ថ្ងៃ ៩វិច្ឆិកា ខាងមុខ នេះ ?
ចំពោះ សមត្ថភាព យើងខ្ញុំ មាន កម្រិត ខ្ញុំ សូម លើក ពាក្យសំណូមពរ មិត្ត ជួយ ឧបត្ថម្ភ ទំព័រ នេះ ដោយ វិជ្ជា ចំណេះដឹង របស់ មិត្ត ។
ហេតុ នេះ យើង ប្រគល់ គេ ទៅក្នុង កណ្តាប់ដៃ របស់ នេប៊ូក្នេ សា ជា ស្តេច ស្រុក បាប៊ីឡូន ហើយ ស្តេច នេប៊ូក្នេ សានឹង ប្រហារជីវិត អ្នក ទាំង ពីរ នៅមុខ អ្នក រាល់គ្នា ។
រដ្ឋាភិបាល តួកគី បាន ចាត់ទុក ហេតុការណ៍ នេះ ថា ជា អំពើ ភេរវកម្ម តែ ម្តង ។
មរណភាព របស់ លោក កេងវ៉ាន់ សាក់ ត្រូវបាន គេ ផ្សាយ តាម ទូរទស្សន៍
សម្តី របស់ យាយ នោះ ធ្វើឱ្យ ចង្វាក់ បេះដូង របស់ ខ្ញុំ លោត ឌុក ឌាក់ ។
នោះ ជា អនាគត ប្រសិនបើ ពួកគេ ចង់ឱ្យ មាន អន្តរកាល រលូន ។
ក្រៅពី រូបី លីន ក៏ មាន វត្តមាន របស់ តារា ល្បី ៗ
ដើម្បីឱ្យ ដំនើរការបាន នោះ អ្នកចាំបាច់ ត្រូវ ចុច Tab ជាមុន សិន បន្ទាប់មក ទើប អាច ប្រើ ក្តារ ចុច ផ្លូវ កាត់ បាន ។
ចម្លើយ គីម វេង គឺជា អភិជន ដែល ជា មនុស្ស វៃ ឆ្លាត ។
ក្នុង គោលបំណង ធ្វើ ទស្សនកិច្ច នៅ ព្រះរាជាណាចក្រ កម្ពុជា រយៈពេល មួយ ថ្ងៃ ។
យើង ត្រូវតែ កសាង វប៌្ប ធម មួយ ដែល ត្រូវ រក្សា លំនឹង សម្រាប់ រយៈពេល ដែល នៅសល់ ។
ក៏ប៉ុន្តែ ទង្វើ នេះ ត្រូវ យាយ ជី ម្នាក់ បាន ឃើញ ។
អាហារូបត្ថម្ភ ៤ប្រភេទ ដែល អ្នក អាច មើល រំលង ឬ ទទួលទាន មិន បាន គ្រប់គ្រាន់
ការពារ ជំងឺ មហារីក ពោះវៀន ធំ - ក្រសួង ព័ត៌មាន
បម្រុង ទៅ រួមរ័ក ជាមួយ ប្រពន្ធ ប៉ុន្តែ ប្រពន្ធ មិន ឱ្យ ។
មក ស្រប ពេល ដែល ការងារ នាង នៅ ទូរទស្សន៍ ហាក់ដូចជា កាន់តែ ស្ងប់ស្ងាត់ ទៅ ៗ
ស៊ុន ណារី និយាយ ទៅកាន់ បង ជីដូនមួយ ភ្លាម ។
ដូច្នេះហើយ គ្រាន់តែ ដោយសារ អ្នក បញ្ចេញ ដ៏ ច្រើន ក្នុង ពេល ហាត់ប្រាណ មិន មែន មាន ន័យ ថា អ្នក អាច បរិភោគ ប៊ឺហ្គឺរ បាន តាមចិត្ត នោះ ទេ ។
គ្រលៀស អណ្តាត ពីរ បី ជុំ ទើប លេប ក្អឹក ចូល ទៅក្នុង ពោះ ។
ដី សម្រាប់ ជួល ភ្ន ពេញ ថ្មី
ស្លាក ភ្នាក់ងារ ភ្នាក់ងារ
លើស ពី នេះ ពួកគេ ត្រូវបាន រារាំង យ៉ាង ខ្លាំង ដោយ កំលាំង ប៉ូលិស ទៀតផង ។
លោក បារម្ភ ថា ពួកគាត់ អាច ប្រឈម នឹង ផល ប៉ះពាល់ ដល់ សុខភាព ធ្ងន់ធ្ងរ នៅពេល ខាងមុខ ។
លោក ហ៊ុន សែន នៅក្នុង ពិធី មួយ នា ពេល កន្លងមក ។
លោក សុខ ណាន តំណាង ពលរដ្ឋ ទាំងអស់ បាន ប្រាប់ ឱ្យដឹង យ៉ាង ដូច្នេះ ថា ៖
មន្ត្រី ក្រសួង ការងារ កំពុង ជួប ជាមួយ …
និរត្តន៍ គ្រាប់ ពេជ្រ ថ្មី របស់ ថោន ប្រឹងប្រែង តស៊ូព្យាយាម ទម្រាំ មាន ថ្ងៃ នេះ .. !
ម្យ៉ាងទៀត ចិន ក៏ គាំទ្រ ការបោះឆ្នោត របស់ កម្ពុជា ដែរ ។
សូម ជួយ ឱ្យ ផែនដី ស្រស់ស្រាយ ឡើងវិញ ផង !
មិន មាន ដី សម្បទាន សេដ្ឋកិច្ច លើស ពី ១០០០០ ហិកតា ។
ទី មួយ គឺ អំណាច ទឹកប្រាក់ ។
អញ្ចឹង សមត្ថកិច្ច តុលាការ នឹង អាច ធ្វើ ការស្រាវជ្រាវ បន្ត ទៀត ហើយ យើង ឃើញ ថា មាន ឱកាស ច្រើន ណាស់ ដើម្បី ទប់ស្កាត់ នូវ បទល្មើស ញុះញង់ នេះ ។
រីកចំរើន នោះ ទេ ។
ព្រោះថា ខ្លួន នេះ ហើយ ជា ទីស្រឡាញ់ ជា ទី ពេញចិត្ត នៃ បុគ្គល មួយ រូប ៗ
ហើយ ភ្លើង នឹង ឆេះ បំផ្លាញ ពួកគេ ។
ការព្យាបាល ដោយ ថ្នាំ ផ្សះ ជា វិធី មាន ប្រសិទ្ធិភាព បំផុត ចំពោះ ជំងឺ នេះ ហើយ ថ្នាំ ផ្សះ ពេទ្យ ឱ្យ ប្រើ ជាញឹកញាប់ រួម មាន ៖
ដូច្នេះហើយ ការគិត ម្តង ហើយ ម្តង ទៀត
កូរ៉េ ខាងត្បូង ជា ជន រងគ្រោះ ដោយសារ នយោបាយ រដ្ឋាភិបាល លោក អាបេ
លោក ហង្ស ពុទ្ធា បន្ថែម ថា ៖
ទីក្រុង ព្យុងយ៉ាង ត្រៀមខ្លួន រួច ជាស្រេច ហើយ សម្រាប់ សង្គ្រាម ប្រសិនបើ លោក ដូណាល់ ត្រាំ ប្រធានាធិបតី អាមេរិក ចង់ ធ្វើ ។
ដំណើរការ និង សកម្មភាព របស់ ក្រុម អង្គការ ទាំង នេះ ត្រូវបាន រដ្ឋាភិបាល នៃ ប្រទេស លោក ខាងលិច ជាច្រើន ធ្វើ ការលើកទឹកចិត្ត ។
ញ៉ាំ ម្ហូប លើ កាយ អាក្រាត របស់ មនុស្ស មាន ផល អវិជ្ជមាន ដល់ សុខភាព
អាជ្ញាធរ បាន និយាយ កាលពី ថ្ងៃសៅរ៍ ថា តំបន់ មួយ ដែល មាន អាគារ ១៦ នៅ សង្កាត់ យ៉ាវ ស៊ីម ម៉ុង នឹង ត្រូវ បិទ រហូតដល់ អ្នក រស់ នៅក្នុង តំបន់ នេះ បាន ធ្វើតេស្តិ៍ ចប់ សព្វគ្រប់ ។
បុរស ជា គ្រូ រូប នោះ បាន នាំយក នាង ទៅ ផ្ទះ របស់ គាត់ នៅ ពេល យប់ និង ធ្វើ ការរំលោភបំពាន ផ្លូវភេទ លើ នាង អស់ រយៈពេល ជាង ១០ឆ្នាំ មកហើយ ។
មកដល់ ពេលនេះ សកម្មជន រូប នោះ ត្រូវបាន ឃុំ ខ្លួន ក្នុង ពន្ធនាគារ ជាង ៥ខែ ហើយ ។
មន្ទីរពេទ្យ ព្រះកុសុមៈ ដែល ជា អគារ របស់ រដ្ឋ បាន ផ្លាស់ប្តូរ ទម្រង់ ច្រក ចូល ថ្មី ហើយ ។
នៅ ទូទាំង សហរដ្ឋ អាមេរិក មាន មនុស្ស និង ស្ថាប័ន ជាច្រើន កំពុង ត្រូវ ចិន ទាក់ទាញ ។
ម្នាក់ ដែល គេ រាយការណ៍ ថា ជា
ភាពស្រស់ស្អាត មិន មែន ទទួលបាន មក តែ ពី ការតុបតែង ផ្នែក ខាងក្រៅ តែ មួយ មុខ នោះ ទេ ប៉ុន្តែ ផ្នែក ខាងក្នុង នៃ អារម្មណ៍ ក៏ មាន សារសំខាន់ ណាស់ ដែរ ។
ក្រុម ជន សកម្ម ប្រយុទ្ធ ១១នាក់ ត្រូវបាន សម្លាប់ ក្នុង ការបាញ់ត ដៃ ជាមួយ កងកម្លាំង សន្តិសុខ បង់ក្លាដែស
លោក សូរិយា បាន បន្ថែម ថា ៖
