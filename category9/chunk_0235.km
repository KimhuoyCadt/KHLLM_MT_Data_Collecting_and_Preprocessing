*កត្តា ទី១៖ លោក គឺជា ឥស្សរជន ជាន់ ខ្ពស់ ដែល មាន ភាព ចាស់ទុំ ពោរពេញ ដោយ បទពិសោធន៍ ក្នុង ការដឹកនាំ ស្ថាប័ន ជាតិ ពាក់ព័ន្ធ លើ វិស័យ ពាណិជ្ជកម្ម ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ នៅ កម្ពុជា ដែល ជា ចលករ ដ៏ ចាំបាច់ សម្រាប់ អង្គការ នីតិប្រតិបត្តិ ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ និង លើក កិត្តិយស ជាតិ លើ ឆាក អន្តរជាតិ ។
ចិន និង អាមេរិក នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ បាន ចេញផ្សាយ សេចក្ដីប្រកាស រួមគ្នា រវាង ប្រទេស មហា យក្ស សេដ្ឋកិច្ច ទាំង ពីរ ស្តីពី ការបង្កើន សកម្មភាព អាកាសធាតុ ក្នុង ទសវត្សរ៍ ២០២០ នៅឯ សម័យ ប្រជុំ លើក ទី ២៦ នៃ សន្និសីទ កំពូល ស្តីពី ការប្រែប្រួល អាកាសធាតុ (COP26) ដែល កំពុង ប្រព្រឹត្តទៅ នៅ ទីក្រុង Glasgow ប្រទេស ស្កុត លែន ។
ភាគី ទាំង ពីរ បាន សន្យា បន្ត ធ្វើ ការរួមគ្នា និង ជាមួយ គ្រប់ ភាគី ទាំងអស់ ដើម្បី ពង្រឹង ការអនុវត្ត កិច្ចព្រមព្រៀង អាកាសធាតុ ទីក្រុង ប៉ារីស ឆ្នាំ ២០១៥ ។ ប្រទេស ទាំង ពីរ បាន ឯកភាព ក្នុង ការបង្កើត ក្រុមការងារ មួយ ដើម្បី បង្កើន សកម្មភាព ដោះស្រាយ បញ្ហា បម្រែបម្រួល អាកាសធាតុ ក្នុង ទសវត្សរ៍ ២០២០ នេះ ក៏ ដូចជា ការជំរុញ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ និង ដំណើរការ បែប ពហុ ភាគី ទៅ ថ្ងៃ អនាគត ៕
ខាងក្រោម ជា ប្រកាស ស្តីពី ការកំណត់ មណ្ឌល ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ៖
តុលាការ ធម្មនុញ្ញ ថៃ សម្រេច ថា សុន្ទរកថា របស់ មេដឹកនាំ ក្រុម បាតុករ ៣រូប មាន ចេតនា ផ្ដួលរំលំ របប រាជានិយម (Video inside) ( បាងកក )៖ តុលាការ ធម្មនុញ្ញ ថៃ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ បាន ចេញ សេចក្ដីសម្រេច មួយ ដោយ បញ្ជាក់ ថា សុន្ទរកថា របស់ មេដឹកនាំ ក្រុម បាតុករ ៣រូប ដែល ទាមទារ ឱ្យ មាន ការធ្វើ កំណែទម្រង់ របប រាជានិយម ថៃ គឺ មាន ចេត ផ្ដួលរំលំ របប រាជានិយម នៃ ប្រទេស អាស៊ី អាគ្នេយ៍ មួយ នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃព្រហស្បតិ៍ ទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ។
សម្តេច តេជោ ហ៊ុន សែន ផ្តល់ អនុសាសន៍ ៦ ចំណុច ដើម្បី ជំរុញ ការតភ្ជាប់ ប្រព័ន្ធ ដឹកជញ្ជូន អាស៊ាន (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ផ្តល់ អនុសាសន៍ ៦ ចំណុច ទៅកាន់ រដ្ឋមន្ត្រី ដឹកជញ្ជូន ប្រទេស អាស៊ាន ឱ្យ ប្រឹងប្រែង យកចិត្តទុកដាក់ ក្នុង ការអនុវត្ត ដើម្បី ជំរុញ ដល់ ការតភ្ជាប់ ប្រព័ន្ធ ដឹកជញ្ជូន នៅ តំបន់ អាស៊ាន ។
អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន ត្រូវបាន ផ្តល់ ជូន រដ្ឋមន្ត្រី ដឹកជញ្ជូន អាស៊ាន ក្នុង ពេល សម្តេច អញ្ជើញ ថ្លែង សុន្ទរកថា បើក កិច្ចប្រជុំ រដ្ឋមន្ត្រី ដឹកជញ្ជូន អាស៊ាន លើក ទី ២៧ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ ព្រឹក ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ។ កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង តាម ប្រព័ន្ធ វីដេអូ ដោយ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន របស់ កម្ពុជា ជា ម្ចាស់ ផ្ទះ នៃ ការរៀបចំ កិច្ចប្រជុំ ។
បន្ថែម ពីលើ នោះ ការជំរុញ ការធ្វើ សមាហរណកម្ម សហគមន៍ អាស៊ាន តាម គន្លង ប្រក្រតី ភាព ថ្មី គឺជា កិច្ចការ ចាំបាច់ និង សមស្រប ដើម្បី បង្កើត ជា កម្លាំង មួយ ដ៏ ធំ សំដៅ ប្រែក្លាយ អាស៊ាន ទាំងមូល ទៅជា តំបន់ មួយ ដែល មាន ភាពធន់ ភាព ប្រកួតប្រជែង និង បរិយាប័ន្ន ។
សម្តេច តេជោ ក៏ បាន បង្ហាញ នូវ ការមើលឃើញ របស់ សម្តេច ផងដែរ ថា ផែនការ មេស្តីពី ការតភ្ជាប់ អាស៊ាន នឹង ដើរតួ ជា ផែនការ គន្លឹះ ដែល នឹង ធានា ការ រីកចម្រើន ខាង ផ្នែក សេដ្ឋកិច្ច ជាមួយ គម្លាត អភិវឌ្ឍន៍ តិចតួច និង ការតភ្ជាប់គ្នា ដោយ រលូន រវាង ប្រទេស ជា សមាជិក និង ជាមួយ ពិភពលោក តាមរយៈ ការធ្វើឱ្យ កាន់តែ ស៊ីសង្វាក់ គ្នា និង បរិយាប័ន្នភាព នៃ ការតភ្ជាប់ ទាំង៣ គឺ ការតភ្ជាប់ ហេដ្ឋារចនាសម្ព័ន្ធ ការតភ្ជាប់ ស្ថាប័ន និង ការតភ្ជាប់ ប្រជាជន ។
ដើម្បី កសាង បណ្តាញ តភ្ជាប់ នៅក្នុង តំបន់ អាស៊ាន នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ផ្តល់ នូវ អនុសាសន៍ ចំនួន ៦ ចំណុច យក ទៅ ពិចារណា ។ អនុសាសន៍ ទាំង៦ ចំណុច នោះ រួម មាន៖
ទី ២៖ អាស៊ាន ត្រូវ បន្ត ជំរុញ ធ្វើ សកម្មភាព បន្ថែម ទៀត ក្នុង គ្រប់ ផ្នែក ទាំងអស់ នៃ វិស័យ ដឹកជញ្ជូន ដើម្បី សម្រេច ឱ្យ បាន ជោគជ័យ នូវ ការអនុវត្ត ផែនការ យុទ្ធសាស្ត្រ ដឹកជញ្ជូន អាស៊ាន ២០១៦ - ២០២៥ រួមទាំង សកម្មភាព អាទិភាព នៃ ការពិនិត្យ ឡើងវិញ ពាក់កណ្តាល អាណត្តិ របស់ ផែនការ នេះ ដែល ជា ឆ្អឹង ខ្នង នៃ ចក្ខុវិស័យ សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន ២០២៥ ។
ព្រះមហាក្សត្រ ខ្មែរ យាង ដល់ ប្រទេស បារាំង ប្រកបដោយ ព្រះសុវត្ថិភាព (Video inside) ( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ ខ្មែរ ជាទីគោរព សក្តារៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត បាន យាង ដល់ ទីក្រុង ប៉ារីស ប្រទេស បារាំង ប្រកបដោយ ព្រះសុខ សុវត្ថិភាព ។
លោក កេត សុផាន់ ឯក អគ្គ រាជ ទូត ខ្មែរ ប្រចាំ ប្រទេស បារាំង បាន បង្ហោះ លើ ទំព័រ ហ្វេសប៊ុក កាលពី ៣ ម៉ោង មុន ដោយ បាន បង្ហាញ ព្រះរាជ សកម្មភាព របស់ ព្រះមហាក្សត្រ ខ្មែរ នៃ ការយាង ដល់ ព្រលានយន្តហោះ ។ លោក ឯក អគ្គ រាជ ទូត ក៏ បាន បង្ហាញ នូវ ក្តីរីករាយ ដែល បាន ក្រាប បង្គំ ទទួល ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្ស ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា ព្រះមហាក្សត្រ ខ្មែរ បាន យាង ចាកចេញ ពី កម្ពុជា កាលពី ព្រឹក ថ្ងៃពុធ ទី១០ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ដើម្បី ចូលរួម មហាសន្និបាត លើក ទី ៤១ របស់ អង្គការ យូណេស្កូ ដែល ធ្វើឡើង នៅ ទីក្រុង ប៉ារីស ប្រទេស បារាំង ។
ក្នុង ឱកាសយាង ចូលរួម មហាសន្និបាត នេះ នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ព្រះមហាក្សត្រ ខ្មែរ នឹង ថ្លែង ព្រះរាជ សុន្ទរកថា នៅក្នុង ពិធី បើក សម័យ ប្រជុំ ជា ផ្លូវការ នៃ មហាសន្និបាត ដោយ ផ្តោត លើ សមិទ្ធផល សំខាន់ ៗ របស់ អង្គការ យូណេស្កូ នៅក្នុង ប្រទេស កម្ពុជា ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៧៣ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៧៣ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ១១ ខែវិច្ឆិកា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៧៣ នាក់ នោះ មាន ៤៣ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ២២ ករណី និង ជនសង្ស័យ ៣០ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១១ករណី ។
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ រយៈពេល ៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ដល់ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
សូម ពាក់ មួក សុវត្ថិភាព ជានិច្ច ពេល បើកបរ ម៉ូតូ ! ស្លាប់ ៤នាក់ និង របួស ៤នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១០ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ ស្រាល ៤នាក់ ។
ការបដិសេធ នេះ វា មិន មែន ជា រឿង ភ្ញាក់ផ្អើល អ្វី ទេ ហើយ ទោះជា កិច្ចចរចា កើតឡើង ជាថ្មី មែន ក៏ គេ មាន សង្ឃឹម តិចតួច ណាស់ ថា អាមេរិក និង កូរ៉េ ខាងជើង អាច ផ្សះផ្សា ទំនាក់ទំនង ឬ ក៏ សម្រេចបាន លទ្ធផល ជា ដុំកំភួន ណាមួយ ជាពិសេស គឺ ការរំសាយ អាវុធ នុយក្លេអ៊ែរ នៅលើ ឧបទ្វីប កូរ៉េ ។ ស្ថានភាព នៃ ទំនាក់ទំនង បច្ចុប្បន្ន រវាង អាមេរិក និង កូរ៉េ ខាងជើង ត្រូវបាន ក្រុម អ្នកវិភាគ ខ្លះ យល់ ថា វា ប្រៀប បាន ដូចជា « ឆ្មា និង កណ្ដុរ » ដែល តាម ធម្មជាតិ មិន អាច រួមរស់ នៅ ជាមួយគ្នា បាន ទេ ។
ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន ធ្លាប់ បាន លើកឡើង ថា វត្ថុ បំណង របស់ លោក ក្នុង ការដោះស្រាយ បញ្ហា នៅលើ ឧបទ្វីប កូរ៉េ នោះ គឺ « ការរំសាយ អាវុធ នុយក្លេអ៊ែរ ទាំងស្រុង របស់ កូរ៉េ ខាងជើង » ។ គោល នយោបាយ នេះ បាន បរាជ័យ កាលពី អតីតកាល ហើយ នឹង នៅតែ បន្ត បរាជ័យ នៅពេល អនាគត ពីព្រោះថា អាវុធ នុយក្លេអ៊ែរ ត្រូវបាន លោក គីម ជុង អ៊ុន ចាត់ទុក ជា ចំណុច « ស្លាប់ រស់ » នៃ របប ដឹកនាំ របស់ លោក និង អនាគត គ្រួសារ ត្រកូល គីម ។
* កូរ៉េ ខាងជើង ជា ប្រទេស មាន ហេតុផល
របប ដឹកនាំ សាដាំ ហូសេន បាន ដួលរលំ ហើយ សាដំា ហូសេន ផ្ទាល់ ត្រូវបាន កាត់ទោស ដោយ ព្យួរ ក បន្ទាប់ពី អាមេរិក ឈ្លាន ពាន ចូល អ៉ីរ៉ាក់ កាលពី ឆ្នាំ ២០០៣ ក្រោម ហេតុផល ថា អតីត មេដឹកនាំ អី រ៉ាក់ រូប នេះ លួច កាន់កាប់អាវុធ នុយក្លេអ៊ែរ ។ មូអំា ម៉ា ហ្កាដា ហ្វី បាន សម្រេចចិត្ត បោះបង់ ចោល ការអភិវឌ្ឍ កម្មវិធី អាវុធ នុយក្លេអ៊ែរ ជា ថ្នូរ នឹង ការរួចផុត ពី ទណ្ឌកម្ម សេដ្ឋកិច្ច របស់ អាមេរិក ។ នៅ ចុងបញ្ចប់ . ហ្កាដាហ្វី ត្រូវបាន ក្រុម ឧទ្ទាម គាំទ្រ ដោយ អន្តរាគមន៍ យោធា របស់ អង្គការ NATO កាលពី ឆ្នាំ ២០១១ បាញ់ សម្លាប់ ចោល ។
