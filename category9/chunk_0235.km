( ភ្នំពេញ ) ៖ យុវជន ២នាក់ ត្រូវបាន កម្លាំង នគរបាល រាជធានី ភ្នំពេញ ឃាត់ខ្លួន បន្ទាប់ បាន ធ្វើ សកម្មភាព ជិះ ម៉ូតូ នាំមុខ រថយន្ដ សង្គ្រោះ បន្ទាន់ ដែល ជា រថយន្ដ មាន អាទិភាព នាំឲ្យ បាត់បង់ សណ្ដាប់ធ្នាប់ និង អាច បង្ក ហានិភ័យ គ្រោះថ្នាក់ ចរាចរណ៍ ដល់ អ្នកដទៃ ដែល កំពុង ធ្វើដំណើរ តាម ដងផ្លូវ ។
លោក វរសេនីយ៍ ឯក សាន សុខ សីហា អ្នកនាំពាក្យ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា នៅ រសៀល ថ្ងៃទី ០៥ ខែវិច្ឆិកា នេះ ការឃាត់ខ្លួន យុវជន ទាំង ២នាក់ នេះ ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ០៤ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ម្សិលមិញ ដោយ កម្លាំង អធិការដ្ឋាន នគរបាល ខណ្ឌ ឫស្សីកែវ នៅ ចំណុច មុខ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ច្រាំង ចំរេះ២ ផ្លូវ ជាតិ លេខ ៥ ភូមិ ក សង្កាត់ ច្រាំង ចំរេះ២ ខណ្ឌ ឫស្សីកែវ ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង កំពុង ឃាត់ខ្លួន នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ឫស្សីកែវ ដើម្បី ចាត់ការ បន្ត តាម នីតិធី ។
ជាមួយគ្នា នេះ លោក វរសេនីយ៍ ឯក សាន សុខ សីហា បាន បញ្ជាក់ ថា ការងារ ចាប់ខ្លួន ក្រុម អ្នក ជិះ ម៉ូតូ បើក មុខ រថយន្ដ សង្គ្រោះ បន្ទាន់ នេះ នឹង បន្ដ អនុវត្ត ជាប្រចាំ ដោយ អនុវត្ត តាម បទបញ្ជា របស់ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង លោក ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ។
លោក បាន អះអាង ថា សម្រាប់ រថយន្ដ សង្គ្រោះ បន្ទាន់ គឺជា រថយន្ដ ដែល មាន អាទិភាព ស្រាប់ ទៅ ហើយ ដូច្នេះ ការជិះ ម៉ូតូ បើក នាំមុខ រថយន្ដ សង្គ្រោះ បន្ទាន់ បែប នេះ គឺ អាច បង្ក គ្រោះថ្នាក់ ដទៃ បាន គ្រប់ ពេល ហើយ មួយ វិញទៀត អាច ធ្វើឲ្យ ខ្លួន ឯង គ្រោះថ្នាក់ ជា យថាហេតុ ផងដែរ ៕
ទេសរដ្ឋមន្រ្តី លី ធុជ ថ្លែងអំណរគុណ សមាគម ពុទ្ធ សាសនិក កម្ពុជា - ចិន ដែល ចូល ចំណែក ការងារ មនុស្សធម៌ និង ការងារ ប្រយុទ្ធ ប្រឆាំង នឹង កូវីដ១៩ នៅ ក្រុង បាវិត ខេត្ត ស្វាយរៀង
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន បាន ទទួល ជួប គណៈប្រតិភូ ចិន ដឹកនាំ ដោយ ព្រះតេជគុណ ចាង ស៊ីន ក្នុង ពិធី ប្រគល់ - ទទួល អំណោយ របស់ សមាគម ពុទ្ធ សាសនិក កម្ពុជា - ចិន និង សមាគម អ្នកស្រាវជ្រាវ វឌ្ឍនភាព កម្ពុជា - ចិន ជូន អាជ្ញាធរ មីន សម្រាប់ ការចូលរួមចំណែក ការងារ មនុស្សធម៌ និង ការងារ ប្រយុទ្ធ ប្រឆាំង នឹង កូវីដ១៩ នៅ ក្រុង បាវិត ខេត្ត ស្វាយរៀង នា ព្រឹក ថ្ងៃទី ០៤ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ម្សិលមិញ ។
ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា លោក ទេសរដ្ឋមន្ត្រី លី ធុជ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ទំនាក់ទំនង ជា ប្រវត្តិសាស្រ្ត រវាង ប្រទេស កម្ពុជា និង សាធារណរដ្ឋ ប្រជាមានិត ចិន ហើយ បាន ចាត់ ទុក ប្រទេស ចិន ជា មិត្ត ដ៏ ល្អ និង មាន កិច្ចសហប្រតិបត្តិការ យ៉ាង ជិតស្និទ្ធ ជាមួយ កម្ពុជា ។
ក្នុង ឱកាស នោះ ក្នុង នាម សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន អាជ្ញាធរ មីន លោក ទេសរដ្ឋមន្រ្តី លី ធុជ បាន ថ្លែងអំណរគុណ ចំពោះ ទឹកចិត្ត សប្បុរស របស់ គណៈប្រតិភូ ចិន ដឹកនាំ ដោយ ព្រះតេជគុណ Zhao Xin ដែល បាន ឧបត្តម្ភ ជូន អង្ករ ២៥ គីឡូ ចំនួន ៥០ បាវ អាកុល ចំណុះ ៣០លីត្រ ចំនួន ៥កាន និង ម៉ាស់ ចំនួន ១៥.០០០ បន្ទះ ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ជួយ ប្រជាជន ក្រីក្រ នៅ ខេត្ត ស្វាយរៀង ។
ជាមួយគ្នា នេះ ក្នុង ពិធី ប្រគល់ - ទទួល លោក ទេសរដ្ឋមន្រ្តី ក៏ បាន អនុញ្ញាតឱ្យ អ្នក វិនិយោគទុន ចិន និង សមាគម ចិន ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ស្វែងយល់ អំពី កម្ពុជា ៕
បទ វិភាគ៖ វឌ្ឍនភាពវិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា របស់ ប្រទេស ចិន បាន ស្វែងរក សុខ សុភមង្គល និង ផលប្រយោជន៍ ជូន ចំពោះ មនុស្សជាតិ ទាំងមូល
មហាសន្និបាត លើក នេះ បាន ជ្រើសរើស គម្រោង សរុប ២៦៤ ក្នុង នោះ ក្រុមការងារ លោក បណ្ឌិត សភាចារ្យ Zhong Nanshan ទទួលបាន រង្វាន់ ក្រុមការងារ ន វានុវត្តន៍ និង រង្វាន់ វឌ្ឍនភាពវិទ្យាសាស្រ្ត បច្ចេកវិទ្យា ។ អ្នកជំនាញ បរទេស ចំនួន ៨ រូប និង អង្គការ អន្តរជាតិ មួយ ទទួលបាន រង្វាន់ សហប្រតិបត្តិការ ខាង វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា អន្តរជាតិ នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
នា ពេល បច្ចុប្បន្ន នេះ អ្នកជំនាញ បច្ចេកវិទ្យា របស់ ប្រទេស ចិន បាន កើនឡើង ពី ៥៥ លាន ៥ សែន ៤ ពាន់ នាក់ នា ឆ្នាំ ២០១០ ដល់ ៧៨ លាន ៣ សែន ៩ ម៉ឺន ៨ ពាន់ នាក់ នា ឆ្នាំ ២០១៩ ចំនួន អ្នកសិក្សា ស្រាវជ្រាវ និង ផលិត សរុប បាន ឈរ នៅ លំដាប់ថ្នាក់ ទី មួយ នៅលើ ពិភពលោក ក្នុង រយៈពេល ៨ ឆ្នាំ ជាប់ ៗ គ្នា ក៏ ដូចជា ការស្នើសុំ ប៉ាតង់ អន្តរជាតិ របស់ ប្រទេស ចិន ក្នុង ឆ្នាំ ២០២០ មាន ចំនួន ៦ ម៉ឺន ៨ ពាន់ ៧ រយ ២០ ដែល បាន ឈរ នៅ លំដាប់ ទី មួយ នៅលើ ពិភពលោក ។
( ភ្នំពេញ ) ៖ កំណើន ផលិតភាព ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការទ្រទ្រង់ កំណើន សេដ្ឋកិច្ច នៃ ប្រទេស មួយ ដោយ ផ្តល់ លទ្ធភាព ឱ្យ សេដ្ឋកិច្ច ជាតិ នៃ ប្រទេស នោះ អាច ផលិត បាន ផលិតផល ដែល មាន តម្លៃ បន្ថែម កាន់តែ ច្រើន ខណៈពេល ដែល ការប្រើប្រាស់ ធនធាន កាន់តែ មាន ប្រសិទ្ធភាព រួមចំណែក ដល់ ការបង្កើន ភាពប្រកួតប្រជែង របស់ ប្រទេស ។ កំណើន ផលិតភាព ក៏ ជា មធ្យោបាយ សម្រាប់ សេដ្ឋកិច្ច ជាតិ មួយ ក្នុង ការដំឡើង ប្រាក់ ឈ្នួល ឱ្យ ប្រជាពលរដ្ឋ របស់ ខ្លួន ប្រកបដោយ ចីរភាព ។
ឆ្លង តាមរយៈ បទពិសោធន៍ នៃ បដិវត្តន៍ ឧស្សាហកម្ម ទី៤ និង បញ្ហា ប្រឈម នៃ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ បាន និង កំពុង ផ្តល់ នូវ ទស្សនា ទាន ថ្មី មួយ ទៀត សម្រាប់ ទីផ្សារ ការងារ ដែល តាមរយៈ ការស្រាវជ្រាវ បាន បង្ហាញ ថា ភាពខុសគ្នា រវាង សហគ្រាស គ្រឹះស្ថាន ដែល អាច បន្ត រក្សា ផលិតភាព និង សហគ្រាស គ្រឹះស្ថាន ដែល មិន សូវ មាន ផលិតភាព គឺ ពាក់ព័ន្ធ នឹង ការគ្រប់គ្រង លើក ត្តា៖ ពេលវេលា . ជំនាញ ឬ គុណវុឌ្ឍិ និង កម្លាំង ឬ ថាមពល របស់ កម្លាំង ពលកម្ម ទាំង មុនពេល និង អំឡុង ពេល ជួបប្រឈម នៃ ជំងឺ កូវីដ ៕
( ភ្នំពេញ ) ៖ រដ្ឋសភា កម្ពុជា នៅ ប៉ុន្មាន នាទី មុន នេះ បាន ចេញ សេចក្តីប្រកាស ផ្លូវការ អំពី មរណភាព របស់ លោក បណ្ឌិត ងួន ញិល អនុប្រធាន ទី១ នៃ រដ្ឋសភា និង បង្ហាញ ប្រវត្តិ រូប របស់ លោក ។
តាម លិខិត រដ្ឋសភា បាន ឱ្យដឹង ថា លោក កិត្តិនីតិកោសល បណ្ឌិត ងួន ញ៉ិល អនុប្រធាន ទី១ នៃ រដ្ឋសភា បាន ទទួលមរណភាព នៅ ថ្ងៃសុក្រ ១កើត ខែកត្តិក ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស .២៥៦៥ ត្រូវនឹង ថ្ងៃទី ៥ ខែវិច្ឆិកា ឆ្នាំ ២០២១ វេលា ម៉ោង ១០: ៣៦ នាទី ព្រឹក ក្នុង ជន្មាយុ ៧៩ ឆ្នាំ ដោយ រោគា ពាធ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស និង ប្រវត្តិ រូប លោក បណ្ឌិត ងួន ញិ ល៖
របាយការណ៍ ដែល ដកស្រង់ ពី ស្ថាប័ន គយ ថៃ បាន បញ្ជាក់ ថា « គិត ត្រឹមត្រីមាស ទី៣ ( មករា ដល់ ខែកញ្ញា ) ឆ្នាំ ២០២១ នេះ ការដោះដូរ ពាណិជ្ជកម្ម ទ្វេ ភាគី រវាង កម្ពុជា និង ថៃ ឡង់ ដ៏ សម្រេចបាន ទឹកប្រាក់ សរុប ៥. ៩៧ប៊ីលាន ដុល្លារ អាមេរិក កើនឡើង ១៨% ធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ ២០២០ ដែល មាន ទឹកប្រាក់ ៥. ០៨ប៊ីលាន ដុល្លារ អាមេរិក » ។
ស្ថានទូត កម្ពុជា ប្រចាំ ប្រទេស ថៃ បាន ឱ្យដឹង ថា ការ ដែល ទំហំ ពាណិជ្ជកម្ម ទ្វេ ភាគី កម្ពុជា - ថៃ នៅតែ បន្ត កើនឡើង ដោយសារតែ រាជ រដ្ឋាភិបាល ប្រទេស ទាំង ពីរ រឹតត្បិត ការធ្វើដំណើរ តែ ពុំ បាន រឹតត្បិត ចំពោះ ពាណិជ្ជកម្ម ឡើយ ពោលគឺ សកម្មភាព ដោះដូរ ពាណិជ្ជកម្ម ឆ្លងកាត់ ព្រំដែន រវាង ប្រទេស ទាំង ពីរ នៅ បន្ត ធ្វើឡើង រៀងរាល់ ថ្ងៃ ។
មុខ ទំនិញ សំខាន់ ៗ ដែល កម្ពុជា នាំចេញ ទៅកាន់ ប្រទេស ថៃ រួម មាន៖ វាយន ភណ្ឌ កសិផល ត្បូង ថ្ម មាន តម្លៃ វត្ថុធាតុ ដើម និង ប្រភេទ ពាក់កណ្តាល សម្រេច ខណៈ បាន ទិញ ចូល ពី ប្រទេស ថៃ វិញ នូវ ថាមពល ត្រី សាច់ បន្លែ រថយន្ត ជី សរីរាង្គ ស៊ីម៉ង់តិ៍ គ្រឿង ឧបភោគ - បរិភោគ គ្រឿង សំអាង និង សម្ភារៈ សំណង់ ។
ដោយឡែក សម្រាប់ ក្នុង ខែកញ្ញា ឆ្នាំ ២០២១ កម្ពុជា និង ថៃ សម្រេចបាន ទំហំ ពាណិជ្ជកម្ម ទ្វេ ភាគី ៧៣២ លាន ដុល្លារ អាមេរិក កើនឡើង ៤៨ % ធៀប នឹង ខែ ដូចគ្នា នៃ ឆ្នាំ ២០២០ ដែល មាន ទឹកប្រាក់ ត្រឹមតែ ៤៩៥ លាន ដុល្លារ អាមេរិក ៕
គ.ជ. ប បង្ហាញ ពី បញ្ហា ប្រឈម មួយ ចំនួន នៅក្នុង ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២១
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន បង្ហាញ ពី បញ្ហ ប្រឈម មួយ ចំនួន ក្នុង ដំណើរការ នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២១ ។ នេះ បើ តាម លោក ឌុច សុន សមាជិក គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) និង ជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ជាមួយ ភាគី ពាក់ព័ន្ធ នៅ ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ។
លោក ឌុច សុន បាន បញ្ជាក់ ថា ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២១ នេះ គឺជា ឆ្នាំ ទី៦ហើយ បើ គិត ចាប់តាំងពី ឆ្នាំ ២០១៦ មក ដែល គ.ជ. ប ធ្វើការ ជាមួយ ប្រព័ន្ធ បច្ចេកវិទ្យា ហើយ ដំណើរការ នេះ ក៏ ប្រព្រឹត្តទៅ ក្នុង រដូវ វស្សា និង អំឡុង ពេល មាន ជំងឺ កូវីដ១៩ ផងដែរ ។
ទោះជា យ៉ាងណា បើ ទោះបីជា មាន បញ្ហា អាកាសធាតុ និង បញ្ហា ប្រឈម មួយ ចំនួន ទៀត ដូច បាន លើកឡើង ខាងលើ ក៏ ពិត មែន លោក ឌុច សុន បាន ឱ្យដឹង ថា ប៉ុន្តែ ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២១ បាន ប្រព្រឹត្តទៅ ជា ធម្មតា ដោយ មាន ការសហការ យ៉ាង ស្អិត រមួត រវាង អ្នកបច្ចេកទេស ថ្នាក់ ជាតិ លេខាធិការដ្ឋាន រាជធានី - ខេត្ត រៀបចំ ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់ និង ក្រុម ចុះឈ្មោះ បោះឆ្នោត ដើម្បី ដោះស្រាយ បញ្ហា បច្ចេកទេស ផ្សេង ៗ បាន ទាន់ ពេលវេលា
លើស ពី នេះ មន្ត្រី ជាន់ ខ្ពស់ រូប នេះ បាន បន្ត ថា គ.ជ. ប ក៏ បាន គិត ដល់ ប្រជាពលរដ្ឋ ដែល មិន ទាន់ ចេះ ប្រើ បច្ចេកវិទ្យា ទំនើប នេះ ដោយ គ.ជ. ប បាន សហការណ៍ ជាមួយ មេឃុំ ចៅសង្កាត់ ក្នុង ការចែកជូន លិខិត អញ្ជើញ អ្នក ចុះឈ្មោះ បោះឆ្នោត ដោយ មាន លិខិត អញ្ជើញ នេះ ប្រជាពលរដ្ឋ អាច ដឹង ថា ឈ្មោះ ឬ ទិន្នន័យ របស់ ពួកគាត់ ត្រឹមត្រូវ ឬ មិន ត្រឹមត្រូវ និង ដឹង កាលបរិច្ឆេទ អំពី ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ។
យោង តាម ស្ថិតិ ប្រជាពលរដ្ឋ ប៉ាន់ស្មាន ឆ្នាំ ២០២១ នេះ គ.ជ. ប មាន ផែនការចុះឈ្មោះ អ្នកបោះឆ្នោត ថ្មី ចំនួន ជាង ១លាន ៦៣ម៉ឺន នាក់ និង លុប ឈ្មោះ ចេញ ពី បញ្ជី បោះឆ្នោត ចំនួន ជាង ៨ម៉ឺន ៣ពាន់ នាក់ បន្ថែម ទៀត ដើម្បី បម្រើ ឱ្យ ការបោះឆ្នោត ជ្រើសរើស សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២២ ខណៈ គិត ត្រឹម ឆ្នាំ ២០២០ មាន ពលរដ្ឋ ខ្មែរ ជាង ៨លាន ៨៣ ម៉ឺន ៕
គិត ត្រឹម ថ្ងៃទី ៥ ខែវិច្ឆិកា ឆ្នាំ ២០២១ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១១៨. ៩៤៨ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១១៥. ២៨៩ នាក់ . ស្លាប់ សរុប ចំនួន ២. ៨១៨នាក់ ៕ ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ ជា វេទិកា សំខាន់ ដែល ប្រទេស ចិន ចែករំលែក ទីផ្សារ និង កាលានុវត្តភាព នៃ ការអភិវឌ្ឍ របស់ ខ្លួន ជាមួយ ពិភពលោក
៣ឆ្នាំ កន្លងមក ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ ទទួលបាន សមិទ្ធផល ដ៏ គួរឱ្យ កត់សម្គាល់ ពិសេស បើ ទោះបីជា ស្ថិត ក្នុង បរិបទ ជំងឺ កូវីដ ១៩ ក្តី តែ ពិព័រណ៍ នេះ នៅតែ បាន ដំណើរការ យ៉ាង រលូន ក្រោម ការគាំទ្រ និង ការចូលរួម យ៉ាង សកម្ម ពីសំណាក់ ប្រទេស និង តំបន់ ជា មិត្ត ជា ដៃគូ របស់ ចិន នៅ ទូទាំង ពិភពលោក ដែល បង្ហាញ ពី ការប្តេជ្ញាចិត្ត របស់ សហគមន៍ អន្តរជាតិ ក្នុង ការគាំពារ ពហុ ភាគី និយម ពាណិជ្ជកម្ម សេរី និង ការបើក ទូលាយ ទីផ្សារ ។
ជាក់ស្តែង តាម ទិន្នន័យ របស់ ក្រសួង ពាណិជ្ជកម្ម ចិន នៅ ៣ត្រី មាស ដើម ឆ្នាំ ២០២១ នេះ ទំហំ នាំចេញ នាំចូល រវាង ប្រទេស ចិន ជាមួយ អាស៊ាន ត្រូវ ជា ៤.០៨ ទ្រី លាន យាន់ ប្រាក់ ចិន កើនឡើង ២១.១% បើ ធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ ២០២០ ពោលគឺ អាស៊ាន នៅតែ ស្ថិត ក្នុង ឋានៈ ជា ដៃគូ ពាណិជ្ជកម្ម ធំ ទី មួយ របស់ ចិន ដែល មាន អនុបាត ១៤.៤% ក្នុង ទីផ្សារ ចិន ។
ជាពិសេស នៅក្នុង ឆ្នាំ ២០២០ កន្លងទៅ បើ ទោះបីជា រង ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ពី ជំងឺ កូវីដ ១៩ ក្តី ប៉ុន្តែ ទំហំ ពាណិជ្ជកម្ម រវាង កម្ពុជា និង ចិន នៅតែ បន្ត កើនឡើង ១.៤% ដដែល ពោលគឺ សម្រេចបាន ៩.៥៦០ លាន ដុល្លារ អាមេរិក ។ ដោយឡែក បើ តាម ការបញ្ជាក់ របស់ លោក សុខ សុភ័ក្ដ្រ រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា ឱ្យដឹង ថា ទំហំ ពាណិជ្ជកម្ម ទ្វេ ភាគី រវាង កម្ពុជា និង ចិន សម្រេចបាន ជិត ៥.០០០ លាន ដុល្លារ អាមេរិក កើនឡើង ៣១ % ក្នុង រយៈពេល ខែ ៦ ដើម ឆ្នាំ ២០២១ នេះ ។
ជាពិសេស គឺ នៅ ខែកញ្ញា ឆ្នាំ ២០២០ ប្រទេស ចិន និង សហភាព អឺរ៉ុប បាន ចុះហត្ថលេខា លើ « កិច្ចព្រមព្រៀង ស្តីពី ផលិតផល សម្គាល់ ភូមិសាស្ត្រ ទំនិញ រវាង ចិន និង អឺរ៉ុប » ដែល ជា កម្លាំង ចលករ ថ្មី សម្រាប់ ជំរុញ ផលិតផល កសិកម្ម គុណភាព ខ្ពស់ របស់ ភាគី ទាំង ពីរ ឱ្យ ចូលទៅ ទីផ្សារ របស់ គូ ភាគី ដោយ កាន់តែ ងាយស្រួល និង ឆាប់រហ័ស ដែល បាន នាំមក នូវ ផលប្រយោជន៍ ថ្មី ជូន ដល់ ប្រជាជន នៃ ភាគី ទាំង ពីរ ។
គ្មាន អ្វី គួរឱ្យ សង្ស័យ ឡើយ ទីផ្សារ របស់ ប្រទេស ចិន គឺ ប្រកបដោយ សក្តានុពល ដ៏ ធំធេង ដែល មិន អាច មើល រំលង បាន ដែល ហាក់ដូចជា មេដែក ក៏ មាន កម្លាំង ទាក់ទាញ ដែល កំពុង ស្រូបទាញ ក្រសែចក្ខុ របស់ វិនិយោគិន នៃ បណ្តា ប្រទេស នានា លើ ពិភពលោក ។
ពេល បើក ទូក រ ដោយ បញ្ច្រាស ចរន្ត ទឹក បើ មិន ខំប្រឹង បរ ទៅ មុខ ទូក នឹង ថយ ក្រោយ ។ យើង ត្រូវតែ ក្តាប់ ជាប់ និន្នាការ ទូទៅ នៃ សកល ភាវូបនីយកម្ម សេដ្ឋកិច្ច សកល គាំទ្រ ប្រទេស ជុំវិញ ពិភពលោក ក្នុង ការបើក ទូលាយ ប្រឆាំង ឯកតោ ភាគី និយម និង ការពារ និយម ដើម្បី ជំរុញ មនុស្សជាតិ អោយ ឆ្ពោះ ទៅរក អនាគត កាន់តែ ល្អ បវរ ។
ប្រទេស ចិន នឹង ចូលរួម យ៉ាង សកម្ម ក្នុង ការឆ្លើយតប នឹង បម្រែបម្រួល អាកាសធាតុ គាំពារ សន្តិសុខ ស្បៀង និង សន្តិសុខ ថាមពល សកល ព្រម និង បន្ត ផ្តល់ ជំនួយ បន្ថែម ទៀត ដល់ ប្រទេស កំពុង អភិវឌ្ឍន៍ ផ្សេង ទៀត ក្នុង ក្របខ័ណ្ឌ នៃ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស កំពុង អភិវឌ្ឍន៍ ៕
ខាងក្រោម នេះ គឺជា អត្រា ចាក់ វ៉ាក់សាំង នៃ បណ្តា ប្រទេស និង តំបន់ មួយចំនួន នៅ អាស៊ី សម្រាប់ ដូស ដំបូង៖
ប្រធានាធិបតី អាមេរិក ចូ បៃ ដិន ថ្លឹងថ្លែង ពី តុល្យភាព ក្នុង ការដាក់ សម្ពាធ លើ អ៉ីរ៉ង់ ខណៈ កិច្ចចរចានុយក្លេអ៊ែរ ចាប់ផ្ដើម ឡើងវិញ
( វ៉ាស៊ីនតោន ) ៖ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន កំពុង ថ្លឹងថ្លែង ពី តុល្យភាព រវាង ការគំរាមកំហែង និង ការផ្ដល់ សម្បទាន ដើម្បី បញ្ចុះបញ្ចូល ឱ្យ អ៉ី រ៉ង់ ត្រឡប់មក អនុវត្ត ជាថ្មី នូវ កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ ឆ្នាំ ២០១៥ ខណៈ កិច្ចចរចានុយក្លេអ៊ែរ គ្រោង នឹង ចាប់ផ្ដើម ឡើងវិញ នៅក្នុង ខែវិច្ឆិកា នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសុក្រ ទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ។
អ៉ីរ៉ង់ បាន យល់ព្រម បើក កិច្ចចរចា ជាថ្មី ជាមួយ មហា អំណាច លោក ខាងលិច នៅឯ ទីក្រុង វីយ្យែន ប្រទេស អូទ្រី ស នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា នេះ បន្ទាប់ពី ពួកគេ បាន ចំណាយ ពេល អស់ ៥ខែ មក ហើយ ក្នុង ការសង្រ្គោះ កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ ឆ្នាំ ២០១៥ ដែល បាន ដាក់កំហិត លើ ការចម្រាញ់ សារធាតុ អ៊ុយរ៉ាញ៉ូម របស់ ទីក្រុង តេហេរ៉ង់ ជា ថ្នូរ នឹង ការបន្ធូរបន្ថយ ទណ្ឌកម្ម សេដ្ឋកិច្ច ។
ប៉ុន្តែ បច្ចុប្បន្ន អ៉ីរ៉ង់ ត្រូវបាន គេ រាយការណ៍ ថា នៅតែ បន្ត បង្កើន ចម្រាញ់ សារធាតុ អ៊ុយរ៉ាញ៉ូម លើស ពី អ្វី ដែល បាន កំណត់ នៅក្រោម កិច្ចព្រមព្រៀង ស្រប ពេល បណ្ដា ប្រទេស លោក ខាងលិច មួយចំនួន ដែល គាំទ្រ កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ ឆ្នាំ ២០១៥ ក៏ បាន ព្រមាន អ៉ីរ៉ង់ ផងដែរ ថា កិច្ចព្រមព្រៀង នេះ នឹង ប្រែ ជា គ្មាន តម្លៃ អ្វី ទាំងអស់ ប្រសិនបើ អ៉ី រ៉ង់ នៅតែ បង្កើន ការចម្រាញ់ សារធាតុ អ៊ុយរ៉ាញ៉ូម ។
