( ភ្នំពេញ ) ៖ លោក ឯក ឃុន ដឿន អភិបាល ខណ្ឌ ឫស្សីកែវ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឱ្យ យកចិត្តទុកដាក់ ប្រមូល ទុកដាក់ រាល់ កាកសំណល់ សំរាម ផ្សេង ៗ ការរក្សា អនាម័យ សម្អាត បរិស្ថាន ជុំវិញ ការ រស់នៅ ប្រកបដោយ ផាសុខភាព មាន របៀបរៀបរយ ដើម្បី ចូលរួម លើកកម្ពស់ សោភ័ណ្ឌភាព រាជធានី ភ្នំពេញ ។
ការអំពាវនាវ របស់ លោក ឯក ឃុន ដឿន ធ្វើឡើង ក្នុង ពេល លោក និង សហការី បាន នាំយក រថយន្ដ ចុះ ធ្វេី អនាម័យ សម្អាត បរិស្ថាន សណ្ដាប់ធ្នាប់ សាធារណ: និង លាង បោស សំអាត ផ្លូវ លេខ ៥៩៨ ផ្លូវ ៣០ម៉្រែត ផ្លូវ ហ្រ្គេន ភ្នំពេញ និង តាម បណ្ដារ ផ្លូវ តូច - ធំ ផ្សេង ៗ មួយចំនួន ទៀត ក្នុង មូលដ្ឋាន ខណ្ឌ បន្ទាប់ពី មាន កិច្ចសហការ ល្អ ពី មន្ទីរ សាធារណៈ ការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ៤ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខណ្ឌ ឫស្សីកែវ សូម សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ឱ្យ បញ្ឈប់ នូវ ការបោះចោល រាល់ កាកសំណល់ ផ្សេង ៗ និង ទុកដាក់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ តាម ដែល អាច ធ្វើ ទៅ បាន ដើម្បី ចូលរួម រក្សា នូវ អនាម័យ បរិស្ថាន ល្អ ជំវិញ ការ រស់នៅ ដោយ ផាសុខភាព និង ដើម្បី ចូលរួម លើកកម្ពស់ សោភ័ណ្ឌភាព រាជធានី ភ្នំពេញ ក្រោយពី មាន កិច្ចសហការ ល្អ ពី ក្រុមការងារ ការិយាល័យ សាធារណការ ដឹកជញ្ជូន អនាម័យ បរិស្ថាន និង សណ្ដាប់ធ្នាប់ សាធាណៈ ខណ្ឌ និង ក្រុមការងារ មន្ទីរ សាធាណ ការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ៕
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ សូម គោរព ជូនពរ ក្នុង ឱកាស ថ្ងៃ ខួបកំណើត សម្តេច ពិជ័យ សេនា ទៀ បាញ់ គម្រប់ ខួប ៧៦ ឈាន ចូល ៧៧ ឆ្នាំ
តាមរយៈ សារលិខិត នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ក្នុង ឱកាស ដ៏ វិសេសវិសាល ថ្លៃថ្លា នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម សម្តែង នូវ កតញ្ញូតាធម៌ ដ៏ ជ្រាលជ្រៅ បំផុត ចំពោះ គុណូបការៈ ដ៏ ថ្លៃថ្លា វីរភាព ដ៏ ឧត្តុង្គឧត្តម របស់ សម្តេច ពិជ័យ សេនា ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត ប្រាជ្ញា ស្មារតី ពុះពារ ឧបសគ្គ គ្រប់ បែបយ៉ាង បម្រើ បុព្វហេតុ ជាតិ សាសនា ព្រះមហាក្សត្រ ប្រកបដោយ ឆន្ទៈ មោះ មុត និង រួមចំណែក ដ៏ ធំធេង ក្នុង ការដឹកនាំ និង បម្រើ ជាតិ ទទួលបាន ជោគជ័យ ជា បន្តបន្ទាប់ » ។
( ភ្នំពេញ ) ៖ លោក អ៉ិត សំហេង រដ្ឋមន្រ្តី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ស្នើសុំ ការបន្ត សហការ ឱ្យ កាន់តែ ជិតស្និទ្ធ ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ដើម្បី បន្ត អនុវត្ត គម្រោង រោងចក្រ កាន់តែ ប្រសើរ នៅ កម្ពុជា និង កសាង វប្បធម៌ អនុលោម ភាព ការងារ នៅ កម្ពុជា សំដៅ ជំរុញ កំណើន ក្នុង វិស័យ វាយន ភណ្ឌ សម្លៀកបំពាក់ និង ផលិតផលិតផល ធ្វើដំណើរ និង កាបូប ។
តាមរយៈ កិច្ចសហប្រតិបត្តិការ យ៉ាង ជិតស្និទ្ធ និង ការផ្លាស់ប្តូរ បទពិសោធន៍ ការងារ ព្រមទាំង ការកសាង សមត្ថភាព របស់ អធិការ ការងារ និង អ្នក វាយតម្លៃ អនុលោម ភាព ការងារ ពិតជា បាន ជះ ឥទ្ធិពល វិជ្ជមាន ចំពោះ ការពង្រឹង ការអនុវត្ត លក្ខខណ្ឌ ការងារ និង ការកសាង វប្បធម៌ អនុលោម ភាព នៅ តាម រោងចក្រ សហគ្រាស ជាទូទៅ ៕ ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ បាន ដាក់បញ្ចូល កម្លាំង ចលករ ថ្មី សម្រាប់ កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម រវាង ប្រទេស ចិន និង កម្ពុជា
( ប៉េកាំង ) ៖ ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ លើក ទី៤ បាន សម្ពោធ បើក នៅ ទីក្រុង សៀងហៃ នៅ ថ្ងៃទី ៤ ខែវិច្ឆិកា ។ ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ មិន ត្រឹមតែ ត្រូវ រៀបចំ ធ្វើជា រៀង រាល់ ឆ្នាំ ប៉ុណ្ណោះ ទេ ថែមទាំង ត្រូវ រៀបចំ ធ្វើ ដោយ កម្រិត ខ្ពស់ មាន ប្រសិទ្ធភាព និង កាន់តែ ល្អ ប្រសើរឡើង ។
កម្ពុជា គឺជា ប្រទេស មួយ ក្នុង ចំណោម ប្រទេស កិត្តិយស នៅ ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ លើក២ ឆ្នាំ ២០១៩ កម្ពុជា បាន ចូលរួម ពិព័រណ៍ ជាតិ និង ពិព័រណ៍ សហគ្រាស ដោយ តាំង បង្ហាញ ផលិតផល ពិសេស របស់ កម្ពុជា ទៅកាន់ អ្នក បញ្ជាទិញ និង ទស្សនិកជន មកពី ពិភពលោក ទាំងមូល ។ បន្ទាប់ពី ចូលរួម ក្នុង ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ លើក ដំបូង ការនាំចេញ អង្ករ របស់ កម្ពុជា ទៅកាន់ ប្រទេស ចិន បាន កើនឡើង យ៉ាង លេចធ្លោ ហើយ ប្រទេស ចិន បាន ក្លាយជា ទីផ្សារ ធំ បំផុត សម្រាប់ ការនាំចេញ អង្ករ របស់ កម្ពុជា ។
ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ បាន ប៉ះពាល់ យ៉ាង ខ្លាំង ដល់ សេដ្ឋកិច្ច ពិភពលោក ពិព័រណ៍ អន្តរជាតិ ខ្នាត ធំ ជាច្រើន បាន ត្រូវ លុបចោល ឬ ពន្យារ ពេល សកម្មភាព ពាណិជ្ជកម្ម របស់ សហគ្រាស ឆ្លង ដែន រង ឥទ្ធិពល យ៉ាង ធ្ងន់ធ្ងរ ។ ក្នុង បរិបទ នេះ ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ បាន បើក ធ្វើ តាម ពេល កំណត់ នេះ បាន បង្ហាញ ពី សមិទ្ធផល សំខាន់ របស់ ប្រទេស ចិន ក្នុង ការបង្ការ និង គ្រប់គ្រង ជំងឺ កូវីដ១៩ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម ហើយ បន្ថែម ទំនុកចិត្ត ដល់ មជ្ឈដ្ឋាន ពាណិជ្ជកម្ម ពិភពលោក ។
ពេល ផ្តល់ បទសម្ភាសន៍ ជាមួយ អ្នកសារព័ត៌មាន ឥស្សរជន កម្ពុជា បាន ថ្លែង ថា ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ លើក ទី៣ ដែល បាន រៀបចំ នៅ ទីក្រុង សៀងហៃ បាន បង្ហាញ ថា ប្រទេស ចិន បាន ជំរុញ ដោយ រឹងមាំ នូវ ការធ្វើ សកល ភាវូបនីយកម្ម សេដ្ឋកិច្ច និង ការបើកចំហ ទីផ្សារ ចំពោះ ពិភពលោក ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ បាន ដើរ តួនាទី សំខាន់ សម្រាប់ ជំរុញ ការនាំចេញ ផលិតផល របស់ កម្ពុជា ៕
ថៃ ចេញ លិខិត ផ្លូវការបញ្ជាក់ ពី ការអនុញ្ញាត ឱ្យ ពលរដ្ឋ កម្ពុជា ចូល ប្រទេស ថៃ និង បង្ហាញ លក្ខខណ្ឌ មួយ ចំនួន ដែល ត្រូវ អនុវត្ត
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល ថៃ តាមរយៈ ស្ថានទូត របស់ ខ្លួន នៅ កម្ពុជា បាន ចេញ លិខិត ជូន ព័ត៌មាន ផ្លូវការ មួយ ទៅកាន់ ក្រសួង ការបរទេស កម្ពុជា បង្ហាញ ពី ការអនុញ្ញាតឱ្យ ពលរដ្ឋ កម្ពុជា អាច ធ្វើដំណើរ ចូលទៅ ប្រទេស ថៃ បាន ។
ក្នុង លិខិត ដែល Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៤ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ស្ថានទូត ថៃ បាន បញ្ជាក់ ថា ប្រទេស ថៃ បាន ដាក់បញ្ចូល កម្ពុជា ទៅក្នុង បញ្ជី ឈ្មោះ នៃ ក្រុម ប្រទេស ចំនួន ៦៣ ដែល ប្រជាជន ចាក់ វ៉ាក់សាំង ពេញលេញ រួចរាល់ ចំនួន ២ដូស ឡេីង ទៅ អាច ធ្វើដំណើរ ចូល ទៅកាន់ ប្រទេស ថៃ បាន តាម ផ្លូវ អាកាស ហើយ ត្រូវបាន លើកលែង ពី ការធ្វើចត្តាឡាស័ក គិត ចាប់ពី ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០២១ត ទៅ ។ ក្នុង លិខិត នោះ ស្ថានទូត ថៃ ក៏ បាន បង្ហាញ នូវ លក្ខខណ្ឌ មួយ ចំនួន តម្រូវ ឱ្យ អនុវត្ត មុននឹង ចូលទៅ ប្រទេស ថៃ ផងដែរ ។
តាមរយៈ ពាក្យ ស្នើសុំ ទម្រង់ ថ្មី នេះ គឺ មាន ជម្រើស៣ សម្រាប់ អ្នកដំណើរ ។ ជម្រើស ទាំង៣ នោះ រួម មាន៖
អ្នកជំនាញ ថា កូវីដ - ១៩ អាចនឹង ធ្វើឱ្យ អង់គ្លេស ជួប បញ្ហា ជាថ្មី នៅ ថ្ងៃ បុណ្យ ណូអែល ខាងមុខ
បើ តាម តួលេខ ផ្លូវការ ករណី ឆ្លង ជិត ៣៤.០០០ ករណី ត្រូវបាន កត់ត្រា កាលពី ថ្ងៃចន្ទ ដើម សប្ដាហ៍ នេះ ខណៈ អ្នកជំងឺ ចំនួន ២៩៣ នាក់ បាន ស្លាប់ ក្នុង រយៈពេល ២៨ ថ្ងៃ ចុងក្រោយ បន្ទាប់ពី ការធ្វើតេស្ត វិជ្ជមាន ចំពោះ ជំងឺ ឆ្លង រាតត្បាត ដ៏ កាច សាហាវ នេះ ។
( បាត់ដំបង ) ៖ កម្លាំង សមត្ថកិច្ច ចម្រុះ ព្រំដែន កម្ពុជា បាន បង្ក្រាប ករណី លួច ឆ្លង ដែន ទៅ ប្រទេស ថៃ ដោយ ខុស ច្បាប់ មួយ ករណី ដោយ ឃាត់ខ្លួន មេ ខ្យល់ ម្នាក់ និង ពលករ ប្រុស ស្រី ចំនួន ១៤នាក់ ។
ប្រតិបត្តិការ បង្ក្រាប បទល្មើស លួច ឆ្លង ដែន ខុស ច្បាប់ នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ០៣ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ត្រង់ ចំណុច ច្រកទ្វារ ព្រំដែន អូរ រំដួល ស្ថិត ក្នុង ភូមិ អូរ ថ្មី ឃុំ ពេជ្រ ចិន្តា ស្រុក ភ្នំព្រឹក ខេត្ត បាត់ដំបង ។
មេខ្យល់ ដែល កម្លាំង ចម្រុះ ឃាត់ខ្លួន បាន មាន ឈ្មោះ រ៉េន សុគន់ ភេទ ប្រុស អាយុ ២៥ ឆ្នាំ មាន ទីលំនៅ ភូមិ ភ្នំ តូច ឃុំ ពេជ្រ ចិន្តា ស្រុក ភ្នំព្រឹក ។
បើ តាម កម្លាំង ព្រំដែន កម្ពុជា បាន បញ្ជាក់ ថា បច្ចុប្បន្ន ជនសង្ស័យ ជា មេខ្យល់ ត្រូវបាន សមត្ថកិច្ច នគរបាល ស្រុក បញ្ជូន មក ការិយាល័យ ជំនាញ ដើម្បី អនុវត្ត តាម ច្បាប់ ។ ចំណែកឯ ប្រជាពលរដ្ឋ រងគ្រោះ ត្រុវ បាន អប់រំ ណែនាំ និង តម្រូវ ឱ្យ កិច្ចសន្យា បញ្ឈប់ ព្រមទាំង ឱ្យ វិលត្រឡប់ ទៅកាន់ លំនៅដ្ឋាន រៀង ៗ ខ្លួន វិញ ៕
ក្រសួង ការបរទេស ប្រកាស ពី លទ្ធផល នៃ សិក្ខាសាលា ផ្សព្វផ្សាយ ពី ច្បាប់ ស្ដីពី វិនិយោគ នៃ ព្រះរាជាណាចក្រក កម្ពុជា
( ភ្នំពេញ ) ៖ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ និង ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន រៀបចំ សិក្ខាសាលា តាម ប្រព័ន្ធ វីដេអូ ដើម្បី ផ្សព្វផ្សាយ ពី ច្បាប់ ស្ដីពី វិនិយោគ នៃ ព្រះរាជាណាចក្រក កម្ពុជា ជូន ដល់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង មន្ត្រី ការទូត កម្ពុជា នៅ តាម ស្ថាន តំណាង កម្ពុជា នៅ បរទេស ទាំងអស់ ។
សិក្ខាសាលា បាន ធ្វើឡើង នៅ ថ្ងៃទី ៣ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ក្រោម អធិបតីភាព ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ដោយ មាន ការចូលរួម ធ្វើ បទ - អន្តរាគមន៍ ដោយ លោក សុខ ចិន្តា សោភា រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ។
ថ្លែង នៅក្នុង ពិធី បើក សិក្ខាសាលា នេះ ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ថ្នាក់ដឹកនាំ និង ក្រុមការងារ នៃ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ដែល បាន ខិតខំ ប្រឹងប្រែង អស់ រយៈពេល ៦ ឆ្នាំ ក្នុង ការសិក្សា ស្រាវជ្រាវ និង តាក់តែង រហូត ធ្វើឱ្យ ច្បាប់ ស្តីពី វិនិយោគ ថ្មី នេះ លេចចេញ ជា រូបរាង ឡើង ។
លោក ឧប នាយក រដ្ឋមន្រ្ដី ក៏ បាន រំលេច ពី បច្ច័យ អវិជ្ជមាន ដែល កើត ចេញ ពី វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ និង សង្រ្គាម ពាណិជ្ជកម្ម ដែល ធ្វើឱ្យ សេដ្ឋកិច្ច សកល និង រំហូរ វិនិយោគ ផ្ទាល់ ពី បរទេស ទូទាំង ពិភពលោក មាន ការធ្លាក់ចុះ គួរឱ្យ កត់សម្គាល់ ឯ ការប្រកួតប្រជែង របស់ មហា អំណាច ដែល ធ្វើឱ្យ ប្រែប្រួល សណ្តាប់ធ្នាប់ អន្តរជាតិ ក៏ បាន ដាក់ សម្ពាធ ដល់ តំបន់ អាស៉ី - ប៉ាស៉ី ហ្វិក និង បាន ប៉ះពាល់ ដល់ មជ្ឈភាព និង សាមគ្គីភាព អាស៊ាន និង ទំនាក់ទំនង របស់ អង្គការ តំបន់ នេះ ជាមួយ ដៃគូ ខាងក្រៅ ។
ទន្ទឹម នេះ លោក ឧប នាយក រដ្ឋមន្រ្តី បាន គូសបញ្ជាក់ ថា ច្បាប់ វិនិយោគ ថ្មី នេះ នឹង ដើរ តួនាទី យ៉ាង សំខាន់ ដល់ ការអនុវត្ត យុទ្ធសាស្ត្រ ការទូត សេដ្ឋកិច្ច ឆ្នាំ ២០២១ - ២០២៣ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព និង ទទួលបាន ជោគជ័យ តាមរយៈ ស្ថាន តំណាង កម្ពុជា ប្រចាំ នៅ បរទេស ទាំងអស់ ដែល ជា សេនាធិការ របស់ ក្រសួង កបទ .ស អ ក្នុង ការកៀរគរ ដៃគូ វិនិយោគ ថ្មី ប្រកបដោយ សក្តានុពល ខ្ពស់ ចូលមក ប្រទេស កម្ពុជា ។
រដ្ឋមន្រ្តី ប្រតិភូ សុខ ចិន្តា សោភា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ វត្តមាន របស់ ឧប នាយក រដ្ឋមន្រ្ដី ប្រាក់ សុខុន ដែល បាន ចូលរួម ជ្រោមជ្រែង កិច្ច ខិតខំ ប្រឹងប្រែង ក្នុង ការផ្សព្វផ្សាយ ច្បាប់ ស្ដីពី វិនិយោគ ថ្មី នេះ ជូន ដល់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង មន្ត្រី ការទូត កម្ពុជា នៅ តាម ស្ថាន តំណាង កម្ពុជា នៅ បរទេស ទាំងអស់ ដែល ជា យុទ្ធសាស្រ្ត ដ៏ មុត ស្រួច ក្នុង ការបង្ហាញ ពី កាលានុវត្តភាព នៅ កម្ពុជា សំដៅ ទាក់ទាញ ការវិនិយោគ ប្រកបដោយ គុណភាព បន្ថែម ។
លើស ពី នេះ រដ្ឋមន្រ្តី ប្រតិភូ ក៏ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហការ ជាប្រចាំ របស់ ក្រសួង ការបរទេស ព្រមទាំង ស្ថាន តំណាង កម្ពុជា ប្រចាំ នៅ ក្រៅ ប្រទេស ទាំងអស់ ដែល ជានិច្ចកាល តែង រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការជំរុញ វិនិយោគ និង ផ្សព្វផ្សាយ ពី បរិស្ថាន វិនិយោគ នៅ កម្ពុជា ជូន ដល់ វិនិយោគិន បរទេស ៕
ក្រុមហ៊ុន វ៉ូជី សាន ចេញ សេចក្តី បំភ្លឺ៖ ដី ២១៨ ហិចតា នៅ ឃុំ ដាក់ ដាំ ស្រុក អូរ រាំង ខេត្ត មណ្ឌលគីរី គឺជា ដី ទទួលបាន សិទ្ធិ ស្រប ច្បាប់ ពី រាជ រដ្ឋាភិបាល ក្នុង ការវិនិយោគ ដាំ ដើម ស្រល់ មិន បាន រំលោភបំពាន ដី ប្រជាពលរដ្ឋ នោះ ឡើយ
ការចេញ សេចក្តី បំភ្លឺ ពីសំណាក់ ក្រុមហ៊ុន នៅ ពេល នេះ ធ្វើឡើង បន្ទាប់ពី កាល ពេល ថ្មី ៗ កន្លងទៅ នេះ មាន ប្រព័ន្ធ ផ្សព្វផ្សាយ នៅក្នុង បណ្ដាញ សង្គម មួយ ចំនួន បាន ធ្វើ ការចុះផ្សាយ ពាក់ព័ន្ធ នឹង ទីតាំង ដី ខាងលើ ដែល ក្រុមហ៊ុន វ៉ូជី សាន បាន ធ្វើការកាយ ក្រវ៉ាត់ ព្រំ និង មាន ការតវ៉ា ពី ប្រជាពលរដ្ឋ ចំនួន ប្រហែល ១២ គ្រួសារ ដែល ការចុះផ្សាយ នេះ ធ្វើ ហាក់ មិន បាន បង្ហាញ អំពី ការពិត និង បាន ធ្វើឱ្យ មហាជន មាន ការយល់ ច្រឡំ អំពី សិទ្ធិ និង ទំនាក់ទំនង គតិយុត្ត ក៏ ដូចជា ការធ្វើ សកម្មភាព លើ ទីតាំង ដី ខាងលើ ។
មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះវិហារ ប្តេជ្ញា មិន ឱ្យ កងទ័ព ក្រោម ឱវាទ ធ្វើ ទង្វើ ណាមួយ ដែល បំពាន ដល់ សេចក្តីសុខ របស់ ពលរដ្ឋ ជាដាច់ខាត
( ព្រះវិហារ ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ច័ន្ទ សុភ័ក្ត្រា មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះវិហារ បាន បញ្ជាក់ ថា ក្នុង នាម លោក ជា មេបញ្ជាការ ម្នាក់ គឺ មិន អាច ឱ្យ កងទ័ព ក្រោម ឱវាទ របស់ ខ្លួន ប្រព្រឹត្ត ទង្វើ មិន គាប្បី ណាមួយ ដែល បង្ក ការលំបាក ឬ ទៅ បំពាន លើ ប្រជាពលរដ្ឋ ជាដាច់ខាត ។
ការបញ្ជាក់ បែប នេះ របស់ លោក ឧត្តមសេនីយ៍ ទោមេបញ្ជាការ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ដឹកនាំ នាយ ទាហាន នាយ ទាហាន រង ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ គ្រួសារ កងទ័ព និង កងទ័ព ពិសេស គឺ ដើម្បី ស្វែងយល់ និង រក ដំណោះស្រាយ ជូន ពួកគាត់ ដែល មាន បញ្ហា ដីធ្លី ដែល ទូរទស្សន៍ អនឡាញ ក្នុង ស្រុក មួយ ផ្សាយ ជា បន្តបន្ទាប់ ធ្វើ ការចោទប្រកាន់ ថា អ្នក មាន ស័ក្តិយស ធំ ៗ រៀបចំ ជា ប្រព័ន្ធ រំលោភ យក នា ថ្ងៃទី ០៣ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ម្សិលមិញ ។
ឧត្តមសេនីយ៍ ទោ ច័ន្ទ សុភ័ក្ត្រា បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ក្នុង នាម លោក ជា មេបញ្ជាការ ម្នាក់ ដែល មាន សិទ្ធ គ្រប់គ្រង ទៅ លើ តំបន់ ដែល ខ្លួន ទទួលខុសត្រូវ គឺ មិន អាច ឱ្យ អ្នកណា ម្នាក់ ធ្វើ អំពើ អ្វី មួយ តាម អំពើចិត្ត បាន ទេ ។ នៅ តំបន់ នេះ ថ្វីត្បិតតែ លោក ទើប មក គ្រប់គ្រង តែ លោក ក៏ មិន អនុញ្ញាតឱ្យ អ្នកណា ម្នាក់ ដែល ជា កងកម្លាំងប្រដាប់អាវុធ ដែល កំពុង ស្ថិត ក្រោម ការគ្រប់គ្រង របស់ លោក ធ្វើ អំពើ ខុសឆ្គង ណាមួយ បំពាបំពាន ទៅ លើ ប្រជាពលរដ្ឋ បាន ទេ » ។
លោក មេបញ្ជាការ បាន បន្ត ថា ផ្អែក តាម សំដី ផ្ទាល់ របស់ ប្រជាពលរដ្ឋ គ្រួសារ កងទ័ព និង កងទ័ព មួយចំនួន ទៀត បាន បញ្ជាក់ យ៉ាង ច្បាស់ ថា ទាំង ៣៤ គ្រួសារ ដែល បាន ផ្តិត មេដៃ មិន មាន គោល គំនិត ណា ប្តឹង ក៏ វាយប្រហារ ទៅ លើ អង្គភាព ដែល នៅ ទីនេះ ឬ មក លើ រូបលោក ដែល ជា មេស្ថាប័ន មួយ ទេ ផ្ទុយទៅវិញ អ្វី ដែល ផ្តិត មេដៃ បង្ហាញ នូវ ភស្តុតាង មួយ នៅក្នុង លិខិត ប្តឹង គឺ បញ្ជាក់ អំពី ការប្តឹង តំណាង ក្រុមហ៊ុន ឯណោះ ទេ ចុះ ហេតុ អ្វី ក៏ គេ ផ្សាយ ចោទប្រកាន់ មក លើ កងកម្លាំង របស់ លោក ទៅ វិញ ។
