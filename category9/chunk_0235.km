សូម ជម្រាប ជូន ពី ដំណើរ ជីវិត និង ជីវប្រវត្តិ សង្ខេប របស់ លោក អ៊ុំ មាន ដូចត ទៅ៖
កាល វ័យ កុមារភាព កុមារា អ៊ុំ មាន រស់ នៅក្នុង បន្ទុក ឪពុក ម្តាយ និង ជា កូនប្រុស ដែល ប្រកបដោយ គន្លង ធម៌ មាន ចរិត ឫកពារ កិរិយា មាយាទ ស្លូតបូត សុភាព រាបសារ រម ទម មាន សេចក្តីព្យាយាម ខ្ពស់ ក្នុង ការសិក្សា រៀនសូត្រ និង ចេះ ជួយ យក អាសា អ្នកផង គ្នា កត្តា នេះ ហើយ បាន ធ្វើឱ្យ កុមារា គួរ ជាទី ស្រលាញ់ រាប់អាន ពី អ្នកផង ទាំងពួង ក្នុង សហគមន៍ ។
យុវជន អ៊ុំ មាន បាន រៀបអាពាហ៍ពិពាហ៍ ជាមួយ នាង កញ្ញា ជៃ គឹម យុក នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ១៩៦៧ ។ ជា ចំណង ដៃ នៃ ជីវិត អាពាហ៍ពិពាហ៍ នេះ លោក ទាំង ពីរ មាន បុត្រ ប្រុស ស្រី ចំនួន ៥នាក់ ស្លាប់ ១នាក់ ។
សម្រាប់ ប្រវត្តិការងារ របស់ លោក អ៊ុំ មាន វិញ អំឡុង ឆ្នាំ ១៩៦៥ ក្រោយពេល បញ្ចប់ ការសិក្សា លោក បាន ធ្វើជា គ្រូបង្រៀន នៅ អនុវិទ្យាល័យ ក្រគរ ខេត្ត ពោធិ៍សាត់ និង ឆ្នាំ ១៩៧០ ដល់ ១៩៧៥ បាន ធ្វើជា គ្រូបង្រៀន អនុវិទ្យាល័យ នៅ អនុវិទ្យាល័យ ព្រែក លាប ។
អំឡុង ឆ្នាំ ១៩៧៩ ក្នុង ស្ថានភាព ប្រទេស ទើប រួចផុត ពី ការកាប់ សម្លាប់ ការបំផ្លិចបំផ្លាញ ក្នុង សម័យ ប៉ុល ពត ប្រទេសជាតិ ត្រូវការ ធនធាន មនុស្ស ដើម្បី ចូលរួម ស្តារ និង អភិវឌ្ឍ ប្រទេស សា ជា ថ្មី លោក អ៊ុំ មាន បាន ចូល បម្រើ ការងារ នៅ អង្គភាព អគ្គិសនី កម្ពុជា រហូតដល់ ឆ្នាំ ១៩៩៥ លោក បាន ធ្វើ ការ ក្នុង នាម ជា ប្រធាន នាយកដ្ឋាន នៃ សហព័ន្ធ សហជីព កម្ពុជា ។
ឆ្នាំ ១៩៩៨ ដល់ ២០០៣ លោក អ៊ុំ មាន បាន ធ្វើ ការ ក្នុង តំណែង ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ការងារ នៅ ក្រសួង សង្គមកិច្ច ការងារ បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ និង យុវនីតី សម្បទា ។
នៅ ឆ្នាំ ២០០៨ ដល់ រហូតដល់ បច្ចុប្បន្ន លោក គឺជា រដ្ឋលេខាធិការ នៅ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ។
កាលពី ឆ្នាំ ២០១៨ លោក អ៊ុំ មាន ត្រូវបាន ជ្រើសតាំង ជា សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ក្នុង មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស របស់ គណបក្ស ប្រជាជន កម្ពុជា ។ ក្នុង ក្របខណ្ឌ ជា ថ្នាក់ដឹកនាំ បក្ស ក្រសួង លោក ជា សមាជិក គណៈ អចិន្រ្តៃយ៍ នៃ គណៈកម្មាធិការ គណបក្ស ក្រសួង និង ជា ប្រធាន គណៈ ឃោសនា អប់រំ នៃ គណៈកម្មាធិការ គណបក្ស ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
ក្នុង ជីវិត ការងារ របស់ លោក អ៊ុំ មាន លោក គឺជា ថ្នាក់ដឹកនាំ មួយ រូប ប្រកបដោយ គំរូល្អ សម្រាប់ មន្រ្តី ថ្នាក់ ក្រោម ឱវាទ លោក មាន សីលធម៌ ល្អ មាន ការអធ្យាស្រ័យ ខ្ពស់ លោក ជា មន្ត្រី ប្រកបដោយ ភក្តីភាព ចំពោះ ថ្នាក់ដឹកនាំ ហើយក៏ ជា មន្ត្រី គំរូ ស្អាតស្អំ ថ្លៃថ្នូរ ស្មោះត្រង់ វិជ្ជាជីវៈ មាន ឆន្ទៈ និង មនសិការ ស្នេហាជាតិ ខ្ពស់ ដោយ ឥត ងាក រេ ។
លោក អ៊ុំ មាន ក៏ ជា ពុទ្ធ សាសនិក មួយ រូប ដែល តែងតែ គោរព ប្រតិបត្តិ នូវ ឱវាទ របស់ ព្រះសម្មាសម្ពុទ្ធ ព្រះបរម គ្រូ ព្រះជិន្ន ស្រី នៃ យើង ។ ជាក់ស្តែង កន្លងមក នេះ លោក តែង បាន ចំណាយ ទ្រព្យធន ផ្ទាល់ខ្លួន រួម ជាមួយ ក្រុមគ្រួសារ បុត្រា បុត្រី សាច់ សាលោហិត ញាតិមិត្ត ជិត ឆ្ងាយ ដើម្បី ធ្វើ បុណ្យ ទាន សន្សំ កុសល តម្កល់ ទុក ជា ស្រែ បុណ្យ ទាំង ក្នុង វិស័យ ពុទ្ធ ចក្រ និង អាណាចក្រ ជាច្រើន រាប់ មិន អស់ ផងដែរ ៕
ទីបំផុត អាជ្ញាធរ អូស្ត្រាលី រកឃើញ ក្មេងស្រី អាយុ ៤ឆ្នាំ នៅ មាន ជីវិត បន្ទាប់ពី បាន បាត់ខ្លួន ជាង ២សប្តាហ៍
អភិបាល ខេត្ត ស្ទឹងត្រែង ស្នើ សភា ពាណិជ្ជកម្ម កម្ពុជា ប្រចាំ ៣ ខេត្ត បន្ត ចូលរួម ស្ដារ សេដ្ឋកិច្ច ក្រោយ រដ្ឋាភិបាល ដើម្បី ដំណើរការលើ គ្រប់ វិស័យ ឡើងវិញ បន្ទាប់ពី រងគ្រោះ ដោយសារ ជំងឺ កូវីដ១៩
( ស្ទឹងត្រែង ) ៖ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ស្ទឹងត្រែង បាន ស្នើ ដល់ សភា ពាណិជ្ជកម្ម កម្ពុជា ប្រចាំ ៣ ខេត្ត ឱ្យ បន្ត អនុវត្ត កិច្ចការងារ របស់ ខ្លួន ស្រប ទៅតាម តួនាទី ភារកិច្ច ដែល បាន ដាក់ចេញ ដើម្បី ធ្វើឱ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ពិសេស ក្នុង ឱកាស ដែល រដ្ឋាភិបាល សម្រេច ឱ្យ បើក នូវ ដំណើរការ ឡើងវិញ លើ ផ្នែក គ្រប់ វិស័យ ដើម្បី ស្ដារ សេដ្ឋកិច្ច របស់ ប្រទេស កម្ពុជា បន្ទាប់ពី រងគ្រោះ ដោយសារ ជំងឺ កូវីដ១៩ ដែល បាន អូសបន្លាយជាង ពីរ ឆ្នាំ មក នេះ ។
លោក កែវ សុទ្ធារិទ្ធ បាន ថ្លែង ថា ការចូល ជួប សំណេះសំណាល សម្តែង ការគួសម ជាមួយ ថ្នាក់ដឹកនាំ ខេត្ត ស្ទឹងត្រែង នា ពេលនេះ គឺ ដើម្បី ជម្រាប ដល់ ថ្នាក់ដឹកនាំ ខេត្ត ស្ទឹងត្រែង អំពី ភារកិច្ច និង ទិសដៅ ការងារ របស់ សភា ពាណិជ្ជកម្ម កម្ពុជា និង ដើម្បី បង្ហាញ ពី ការគាំទ្រ ចំពោះ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ធ្វើឱ្យ ប្រទេសជាតិ មាន ភាពរីកចម្រើម លើ គ្រប់ វិស័យ និង មាន សុខ សន្តិភាព ។
លោក កែវ សុទ្ធារិទ្ធ បាន បន្ត ថា ម៉្យាងទៀត ការចូល ជួប ការចូល ជួប សម្តែង ការគួសម ជាមួយ ថ្នាក់ដឹកនាំ ខេត្ត ស្ទឹងត្រែង ជាពិសេស លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត នា ពេលនេះ ក៏ ជា ការស្វាគមន៍ និង ចូលរួម អបសារទរ ចំពោះ លោក ដែល ត្រូវបាន រាជ រដ្ឋាភិបាល តែងតាំង ជា អភិបាល ខេត្ត ស្ទឹងត្រែង ថ្មី នា ពេល បច្ចុប្បន្ន ។
ក្នុង ឱកាស នោះ ដែរ លោក ស្វាយ សំអ៊ាង បាន ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ ការចូល ជួប សម្តែង ការគួ សម របស់ សភា ពាណិជ្ជកម្ម កម្ពុជា នា ពេលនេះ និង បាន បង្ហាញ ពី ការខិតខំ ប្រឹងប្រែង ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋា ភិបាល កម្ពុជា ក្នុង កិច្ចការងារ សង្គម នានា របស់ សភា ពាណិជ្ជកម្ម កម្ពុជា នា ពេល កន្លងមក នេះ ក្នុង ភូមិសាស្ត្រ ខេត្ត ស្ទឹងត្រែង ។
ទេសរដ្ឋមន្រ្តី លី ធុជ ណែនាំ ពលករ ខ្មែរ មិន ត្រូវ ធ្វើដំណើរ ទៅ តំបន់ មិន ស្គាល់ ភូមិសាស្រ្ត ច្បាស់ ដែល នាំឱ្យ មាន គ្រោះថ្នាក់ ដោយសារ គ្រាប់ មីន
( បន្ទាយមានជ័យ )៖ ទេសរដ្ឋមន្រ្តី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន បាន ណែនាំ ឱ្យ បងប្អូន ពលករ ខ្មែរ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ និង មិន ត្រូវ ប្រថុយប្រថាន ឬ ធ្វើដំណើរ ឆ្លងកាត់ ចូលទៅ តំបន់ ដែល មិន ស្គាល់ ទីតាំង ភូមិសាស្រ្ត ច្បាស់លាស់ ជាដាច់ខាត ដែល អាច បណ្តាលឱ្យ មាន គ្រោះថ្នាក់ ជា យថាហេតុ ណាមួយ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ។
ការណែនាំ បែប នេះ របស់ លោក ទេសរដ្ឋមន្ត្រី លី ធុជ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៣ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ក្នុង ឱកាស ដែល លោក និង លោក លី សារី អភិបាល រង ខេត្ត បន្ទាយមានជ័យ តំណាង លោក អ៊ុ រាត្រី បាន ចុះ ជួប សំណេះសំណាល ជាមួយ ពលករ ខ្មែរ មកពី ប្រទេស ថៃ តាម ច្រក បឹង ត្រួន ស្ថិត ក្នុង ឃុំ គោក រមៀត ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ដោយ មាន ការចូលរួម លី សារី អភិបាល រង ខេត្ត បន្ទាយមានជ័យ និង អាជ្ញាធរ មួយចំនួន ទៀត ។
ក្នុង ឱកាស នេះ ដែរ លោក ទេសរដ្ឋមន្ត្រី ព្រមទាំង អាជ្ញាធរ ខេត្ត បន្ទាយមានជ័យ ក៏ បាន ចូលរួម ក្នុង ពិធី ត ម្លេីង ផ្ទាំង ប៉ាណូ ផ្សព្វផ្សាយ ការអប់រំ យល់ដឹង អំពី មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម ។
