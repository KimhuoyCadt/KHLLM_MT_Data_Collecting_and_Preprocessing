( ព្រៃវែង ) ៖ លោក ជា សុមេធី អភិបាល ខេត្ត ព្រៃវែង នៅ ព្រឹក ថ្ងៃទី ៤ ខែវិច្ឆិកា ឆ្នាំ ២០២១ បាន ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ ប្រជាពលរដ្ឋ សមាជិក សហគមន៍ កសិកម្ម កសិករ ខ្មែរ និង ចុះ ពិនិត្យ ស្ថានភាព ផលិតកម្ម ដំណាំ បន្លែ នៅ ភូមិ ខ្ពប ឃុំ ព្រែក សំបួរ ស្រុក ពាម ជរ ខេត្ត ព្រៃវែង ។
នៅក្នុង ឱកាស នោះ ដែរ លោក ជា សុមេធី បាន ថ្លែង នូវ ការកោតសរសើរ ដល់ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ដែល បាន គាំទ្រ បង្កើត ឱ្យ មាន សហគមន៍ កសិកម្ម និង បណ្តុំ អាជីវកម្ម ផលិតកម្ម កសិកម្ម ជាច្រើន នៅក្នុង ខេត្ត ព្រៃវែង ដោយ បាន សហការបណ្តា ដៃគូរ អភិវឌ្ឍន៍ នានា ជួយ គាំទ្រ យ៉ាង សកម្ម ទាំ បច្ចេកទេស សម្ភារ ដើមទុន ដល់ សហគមន៍ ដើម្បី មាន លទ្ធភាព បង្កើន ការផលិត និង ការនាំ ទៅ លក់ នៅ ទីផ្សារ ។
លោក អភភិបាល ខេត្ត ក៏ បាន ថ្លែង ផ្តាំផ្ញើរ ដល់ សមាជិក សហគមន៍ ឱ្យ យកចិត្តទុកដាក់ ដាំដុះ បន្លែ បន្ថែម ទៀត ហើយ កាត់បន្ថយ ការប្រើប្រាស់ សារធាតុ គីមី ផ្សេង ៗ ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខភា អ្នកប្រើប្រាស់ ។ ហើយ លោក ប្រធាន មន្ទីរ និង មន្ត្រី ជំនាញ នៃ មន្ទី កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ យកចិត្តទុកដាក់ បន្ថែម ទៀត ក្នុង ការគាំទ្រ ដល់ សហគមន៍ ផលិត បន្លែ នេះ ឱ្យ កាន់តែ មាន ភាពប្រសើរឡើង ថែម ទៀត ។
សូម បញ្ជាក់ ថា លោក ជា សុមេធី និង ប្រតិភូត អម ដំណើរ បាន ចុះ ពិនិត្យមើល ស្ថានីយ៍ មូប ទឹក និង ប្រព័ន្ធ ស្រោចស្រព ដំណាំ បន្លែ ដែល បាន គាំទ្រ ដោយ អគ្គ នាយកដ្ឋាន កសិកម្ម នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ហើយក៏ បាន មើល ការដាំដុះ ដំណាំ បន្លែ របស់ កសិករ ជា សមាជិក សហគមន៍ កសិកម្ម កសិករ ខ្មែរ មាន ដូចជា ដំណាំ ល្ហុង ត្រសក់ ពពាយ ស្បែក ត្រប់ ល្ពៅ ពោត បារាំង សណ្តែក គួរ ជាដើម ។
នៅក្នុង ដំណើបេសកកម្ម នោះ លោក អភិបាល ខេត្ត បាន ជួប សំណេះសំណាល និង ចែក សម្ភារ ដល់ ក្រុម បណ្តុំ អាជីវកម្ម ផលិតកម្ម បន្លែ ចំនួន ៤០ គ្រួសារ ដោយ ក្នុង ១គ្រួសារ ទទួលបាន សំណាញ់ ១ដុំ និង គ្រាប់ បន្លែ មាន ស្ពៃ គ្រប់ ប្រភេទ ត្រប់ សណ្តែក គួរ និង គ្រាប់ ត្រកួន ដែល គាំទ្រ ដោយ កម្មវិធី ASPIRE ។ នៅក្នុង ពិធី នេះ ដែរ ក៏ មាន ការចូលរួម ជួយ ឧបត្ថម្ភ របស់ ក្រុមហ៊ុន ហ៊ូយន់ នូវ កំបោរ កសិកម្ម ចំនួន ២តោន ជី កសិកម្ម សរីរាង្គ១តោន និង ជី ទឹក សរីរាង្គ ចំនួន ៥កេស ។
ជាមួយគ្នា នេះ លោក ក៏ បាន ផ្តល់ ជូន នូវ ទឹក សុទ្ធ និង សម្ភារ ការពារ ឆ្លង ជំងឺ កូវីដ១៩ មាន ដូចជា ម៉ាស់ អាល់កុល និង ជេល លាង ដៃ ហើយ ថែមទាំង ផ្តល់ ប្រាក់ ដល់ សហគមន៍ ចំនួន ១លាន រៀល ជូន ដល់ សហគមន៍ និង ផ្តល់ ជូន សមាជិក សហគមន៍ ចូលរួម ចំនួន ៤០ នាក់ ដោយ ទទួលបាន ប្រាក់ ២ម៉ឺន រៀល ៕
លោក គ្លូក ម៉ាន់ បាន បន្ត ថា ដំណើរទស្សនកិច្ច នេះ គឺជា ការបោះជំហាន ដ៏ សំខាន់ មួយ ជា លើក ដំបូង ដើម្បី រួមគ្នា ឆ្ពោះទៅ កសាង ភាពជាដៃគូ ឲ្យ កាន់តែ រឹងមាំ ខ្លាំង ថែម ទៀត រវាង សហភាព អឺរ៉ុប និង កោះ តៃវ៉ាន់ ។ ដំណើរទស្សនកិច្ច ផ្លូវការ ខាងលើ បាន ចាប់ផ្តើម កាលពី ថ្ងៃពុធ សប្តាហ៍ នេះ ហើយ មាន រយៈពេល សរុប ៣ ថ្ងៃ ។ វា កើត មាន ឡើង ចំ ពេល ដែល ចិន បាន បង្កើន សកម្មភាព យោធា កាន់តែ ញឹកញាប់ នៅក្បែរ កោះ តៃវ៉ាន់ ជាពិសេស តាមរយៈ ការចល័ត ក្រុម យន្តហោះ យោធា ចូលក្នុង តំបន់ ការពារ ដែន អាកាស របស់ តៃវ៉ាន់ ។
ព័ត៌មាន នេះ ត្រូវបាន បញ្ជាក់ ដោយ ឧប នាយក រដ្ឋមន្ត្រី នៃ រាជ រដ្ឋាភិបាល ថៃ លោក វិស្នុ គ្រឿង ង៉ាម ក្នុង ពេល ជួប ពិភាក្សា ការងារ ជាមួយ លោក បណ្ឌិត សុខ សុក្រឹត្យា ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ នៅ ទីក្រុង បាងកក ប្រទេស ថៃ នា ពេល ថ្មី ៗ នេះ ។
លោក សុខ សុក្រឹត្យា បាន បន្ថែម ថា ក្នុង ជំនួប នោះ លោក៏ បាន លើក ពី បំណង របស់ សម្តេច តេជោ ហ៊ុន សែន រក កិច្ចសហប្រតិបត្តិការ ដើម្បី បាន ផ្តល់ ជា វ៉ាក់សាំង ចាក់ ជូន ប្រជាពលរដ្ឋ នៅក្នុង ប្រទេស ថៃ ផងដែរ ។
ឆ្លើយតប សំណើ ស្តីពី កិច្ចសហប្រតិបត្តិការ ដើម្បី ផ្តល់ វ៉ាក់សាំង ជូន ពលរដ្ឋ ខ្មែរ នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី ថៃ វិស្នុ គ្រឿង ង៉ាម ក៏ បាន បញ្ជាក់ ថា រដ្ឋាភិបាល ថៃ បាន ជជែក ហើយក៏ បាន សម្រេច ដែរ ថា កម្ពុជា អាច ផ្តល់ វ៉ាក់សាំង សម្រាប់ ចាក់ ជូន ពលរដ្ឋ រស់ នៅ និង ធ្វើការ ក្នុង ប្រទេស ថៃ បាន ។ ប៉ុន្តែ មិន អាច ទៅ ចាក់ ដោយ ខ្លួន ឯង បាន ឡើយ ពោលគឺ កម្ពុជា អាច ផ្តល់ វ៉ាក់សាំង ហើយ មន្ត្រី សុខាភិបាល ថៃ ជា អ្នក ចាក់ ជូន ។ ដោយឡែក មន្ត្រី កម្ពុជា អាច ចូលរួម សង្កេតការណ៍ លើ ការងារ ចាក់ នេះ បាន ។
ក្នុង ជំនួប នោះ លោក វិស្នុ គ្រឿង ង៉ាម ក៏ បាន បញ្ជាក់ ដែរ ថា ទោះបីជា យ៉ាងណា រដ្ឋាភិបាល ថៃ បាន យកចិត្តទុកដាក់ ដល់ ពលរដ្ឋ ខ្មែរ ហើយក៏ បាន ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន ពួកគេ ផងដែរ ប៉ុន្តែ មិន បាន លឿន នោះ ឡើយ ។
លោក វិស្នុ គ្រឿង ង៉ាម បាន លើកឡើង ថា ប្រសិនបើ កម្ពុជា អាច ផ្តល់ វ៉ាក់សាំង ទៅ ការចាក់ ជូន ពលរដ្ឋ ខ្មែរ អាច បាន លឿន ។ លោក ឧប នាយក រដ្ឋមន្ត្រី ថៃ ក៏ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការយកចិត្តទុកដាក់ របស់ សម្តេច តេជោ ហ៊ុន សែន លើ ប្រជាពលរដ្ឋ ខ្មែរ នៅក្នុង ប្រទេស ថៃ ។
លោក សុខ សុក្រឹត្យា បាន គូសបញ្ជាក់ ថា ពេលនេះ មន្ត្រី ក្រសួង ការបរទេស នៃ ប្រទេស ទាំង ពីរ កំពុង ជជែកគ្នា លើ ការងារ នេះ ដើម្បី រក យន្តការកិច្ចសហប្រតិបត្តិការ ឈាន ទៅ ការផ្តល់ វ៉ាក់សាំង ជូន ពលរដ្ឋ ខ្មែរ នៅ ថៃ ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ០១ ខែវិច្ឆិកា កន្លងទៅ នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បង្ហើប នូវ ព័ត៌មាន នៃ គម្រោង ផ្តល់ វ៉ាក់សាំង ទៅ ចាក់ ជូន ពលរដ្ឋ ខ្មែរ នៅក្នុង ប្រទេស ថៃ ផងដែរ ។
តាម ព័ត៌មាន នានា បាន បញ្ជាក់ ថា បច្ចុប្បន្ន មាន ពលរដ្ឋ ខ្មែរ ប្រមាណ ជា ១លាន នាក់ កំពុង ធ្វើ រស់ នៅ និង ធ្វើការ ក្នុង ប្រទេស ថៃ ហើយ រដ្ឋាភិបាល ថៃ បាន ចាក់ ជូន ពលរដ្ឋ ខ្មែរ បាន ប្រមាណ ២សែន ដូស ហើយ ៕
អភិបាល ខេត្ត ស្វាយរៀង បន្ត ក្រើន រំឮក ដល់ ពលរដ្ឋ កុំ ធ្វេសប្រហែស ជាមួយ ជំងឺ កូវីដ១៩ ឱ្យ សោះ បើ ទោះបី ស្ថានភាព ឆ្លង មាន ការធ្លាក់ចុះ ក៏ដោយ
( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន បន្ត ក្រើន រំឮក ដល់ ប្រជាពលរដ្ឋ សូម កុំ ធ្វេសប្រហែស ជាមួយនឹង ជំងឺ កូវីដ១៩ ឱ្យ សោះ ដោយ ត្រូវ អនុវត្តន៍ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការណ៍ របស់ រាជ រដ្ឋាភិបាល « ៣ការពារ និង ៣កុំ » ឱ្យ បាន ខ្ជាប់ខ្ជួន ខណៈ ដែល រាជ រដ្ឋាភិបាល បាន សម្រេច បើក ប្រទេស ឡើងវិញ ។
ការក្រើន រំឮក បែប នេះ របស់ លោក អភិបាល ខេត្ត បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក និង ក្រុមការងារ នាំយក អំណោយ មនុស្សធម៌ របស់ សាខា ចែកជូន ដល់ ជន ងាយ រងគ្រោះ មាន ចាស់ជរា ជន ពិការ កុមារ កំព្រា គ្រួសារ មាន ជំងឺ ប្រចាំ កាយ ស្ត្រី មេម៉ាយ មាន កូន ច្រើន អ្នក រស់ នៅ ជាមួយេមរោគ អេដស៍ និង ទីទ័ល ក្រ ក្នុង ស្ថានភាព ការជួប វិបត្តិ នៃ ជំងឺ កូវីដ១៩ ចំនួន ៦០ គ្រួសារ មកពី ៧សង្កាត់ ក្នុង ក្រុង ស្វាយរៀង នា ព្រឹក ថ្ងៃទី ៤ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ។
នា ឱកាស នោះ ដែរ លោក អភិបាល ខេត្ត បាន នាំមក នូវ ប្រសាសន៍ ផ្ដាំផ្ញើ សួរសុខទុក្ខ និង សេចក្ដី នឹករលឹក ពីសំណាក់ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ជានិច្ចកាល សម្ដេច តែងតែ យកចិត្តទុកដាក់ គិត គូរ ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ រូប មិន ប្រកាន់ វណ្ណៈ ពណ៌ សម្បុរ ជំនឿ សាសនា ឬ និន្នាការ នយោបាយ ណាមួយ ឡើយ ។
លោក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ឱ្យ បាន ត្រឹមត្រូវ ជាពិសេស ពេល ធ្វេី ដំណេីរ ដោយ ម៉ូតូ ត្រូវ ពាក់ មួក សុវត្ថិភាព ឱ្យ បាន គ្រប់ ៗ គ្នា ម្យ៉ាងទៀត ត្រូវ ធ្វេី ការអប់រំ ណែនាំ កូន ចៅ ឱ្យ ជៀស ឆ្ងាយ ពី បញ្ហា គ្រឿងញៀន ។
បណ្ឌិត អ៉ិត សំហេង អះអាង ថា ពិព័រណ៍ នេះ បាន ខិតខំ រិះរក វិធី កាន់តែ មាន ប្រសិទ្ធភាព ស្រប តាម តម្រូវការ របស់ និយោជក និង អ្នក ស្វែងរក ការងារ ដើម្បី បង្កើត នូវ បរិយាកាស ប្រកបដោយ ជវភាព និង ភាពឆ្លើយតប ទាន់ ពេលវេលា សម្តៅ ពង្រីក វិសាលភាព ការងារ និង ការស្រូបយក កម្លាំង ពលកម្ម ដែល មាន សក្តានុពល និង ជំនាញ គ្រប់ ប្រភេទ ចូល ទៅក្នុង ឱកាស ការងារ ទំនេរ គ្រប់ វិស័យ ។
បើ តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៣ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ក្រសួង ការងារ បាន បញ្ជាក់ ថា ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស អាច ពិភាក្សា ជាមួយ តំណាង កម្មករ និយោជិត ក្នុង ការរៀបចំ ឬ ផ្លាស់ប្តូរ ការឈប់ សម្រាក នេះ នៅ ពេល ណាមួយ ផ្សេង ទៀត ក្នុង ករណី មាន ការព្រមព្រៀង ពី កម្មករ និយោជិត ។
សម្រាប់ កម្មករ និយោជិត ដែល ធ្វើការ ថ្ងៃ ឈប់បុណ្យ នេះ មាន សិទ្ធិ ទទួល នូវ ប្រាក់ បំណាច់ បន្ថែម ដែល មាន ចំនួន ស្មើនឹង ប្រាក់ ឈ្នួល ថ្ងៃ ធ្វើ ការធម្មតា ៕ គ.ជ. ប៖ រយៈពេល ២២ ថ្ងៃ មាន ពលរដ្ឋ ជាង ២៥ម៉ឺន នាក់ បាន ចុះឈ្មោះ បោះឆ្នោត ថ្មី ឆ្នាំ ២០២១
គ.ជ. ប បាន បញ្ជាក់ ថា សរុប រយៈពេល ២២ ថ្ងៃ លទ្ធផល នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ ទទួលបាន ដូច ខាងក្រោម៖
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ៦៨ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ៨. ០២៩ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
ចំណេះដឹង ទូទៅ៖ តើ មាន ប្រទេស ប៉ុន្មាន ដែល ស្ថិត នៅ ចំ ខ្សែ អេក្វាទ័រ ?
( ភ្នំពេញ ) ៖ ខ្សែ អេក្វាទ័រ គឺ សំដៅ លើ ចំណុច ខ្សែ វ័ណ្ដ ខណ្ឌ ចែក នៅ ចំ កណ្ដាល ផែនដី ខណៈ នៅ តំបន់ អេក្វាទ័រ ច្រើន តែ មាន កម្ដៅ ខ្លាំង ពីព្រោះតែ តំបន់ ទាំងនោះ នៅជិត ព្រះអាទិត្យ ជាង តំបន់ ដទៃ ។ តើ មាន ប្រទេស ប៉ុន្មាន ដែល ស្ថិត នៅ ចំ ខ្សែ អេក្វាទ័រ នេះ ?
យោង តាម ផែនទី ពិភពលោក យើង ឃើញ ថា មាន ប្រទេស ចំនួន ១៣ ដែល ស្ថិត នៅ ចំ ខ្សែ អេក្វាទ័រ នេះ៖
* ទ្វីប អាមេរិក ខាងត្បូង
* ទ្វីប អាស៉ី និង មហាសមុទ្រ ប៉ាហ្វិក
ខាងក្រោម ជា ទិន្នន័យ ប្រទេស ចំនួន ២០ ដែល មាន អ្នក ឆ្លង ជំងឺ COVID-19 ច្រើន ជាង គេ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង ណែនាំឲ្យ បង្ហាញ ប័ណ្ណ ឬ លិខិត បញ្ជាក់ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ រាល់ ពេល ចូល គ្រឹះស្ថាន រដ្ឋ និង ឯកជន រួមទាំង ទីប្រជុំជន នានា
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង បាន ចេញ សេចក្ដីណែនាំ ពី ការបង្ហាញ ប័ណ្ណ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ឬ លិខិត បញ្ជាក់ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ រាល់ ពេល ចូល រក សេវា នៅ តាម ទីតាំង អាជីវកម្ម សេវាកម្ម ទេសចរណ៍ និង រមណីយដ្ឋាន ទេសចរណ៍ នានា ក្នុង ភូមិសាស្ត្រ ខេត្ត ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។ បើ តាម សេចក្តីណែនាំ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៤ ខែវិច្ឆិកា នេះ ។
រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា វិធានការ នេះ ធ្វើឡើង ដើម្បី បង្កើន ប្រសិទ្ធភាព ឱ្យ កាន់តែ ប្រសើរឡើង នូវ ការគ្រប់គ្រង ការរីករាលដាល ន ជំងឺ កូវីដ១៩ សំដៅ បង្កើន ភាពស៉ាំ សហគមន៍ ឱ្យ បាន រឹងមាំ ដើម្បី ទប់ទល់ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ ជាពិសេស មេរោគ បំប្លែង ថ្មី ប្រភេទ (Delta) ក៏ ដូចជា ដើម្បី ត្រៀមលក្ខណៈ សម្រាប់ ការរស់នៅ ជាមួយ កូវីដ១៩ តាម គន្លង ប្រក្រតី ភាព ថ្មី ឈាន ទៅរក ការបើក ដំណើរការ ឡើងវិញ លើ គ្រប់ វិស័យ នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
បន្ថែម ពី នេះ ទៀត រដ្ឋបាល ខេត្ត បាន ណែនាំ ដល់ រដ្ឋបាល ក្រុង - ស្រុក មន្ទីរ - អង្គភាព ជុំវិញ ខេត្ត គណៈ គ្រប់គ្រង គ្រឹះស្ថាន សិក្សា គណៈ គ្រប់គ្រង ផ្សារ ប្រតិបត្តិករ ទេសចរណ៍ ម្ចាស់ អាជីវកម្ម សេវាកម្ម ទេសចរណ៍ វិស័យ ឯកជន ប្រជាពលរដ្ឋ និង សាធារណៈ ជន ទាំងអស់ ត្រូវ អនុវត្ត តាម គោលការណ៍ ដូច ខាងក្រោម៖
* ទី១៖ គ្រប់ បុគ្គល ទាំងអស់ ដែល ចេញ ចូល - ចូល ក្នុង បរិវេណ សាលា ខេត្ត មន្ទីរ - អង្គភាព ជុំវិញ ខេត្ត សាលា ក្រុង - ស្រុក ត្រូវ មាន កាតព្វកិច្ច បង្ហាញ ប័ណ្ណ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ឬ លិខិត បញ្ជាក់ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដែល ចេញ ដោយ ក្រសួង សុខាភិបាល ឬ ចេញ ដោយ ក្រសួង ការពារ ជាតិ ។
* ទី៣៖ គ្រប់ គ្រឹះស្ថាន សិក្សា គណៈ គ្រប់គ្រង សាលា ទាំងអស់ ត្រូវ មាន កាតព្វកិច្ច រៀបចំ យន្តការ ដើម្បី ត្រួតពិនិត្យ ប័ណ្ណ ចាក់ វ៉ាក់សាំង របស់ លោកគ្រូ - អ្នកគ្រូ បុគ្គលិក អប់រំ សិស្ស និស្សិត ឱ្យ បាន ត្រឹមត្រូវ មុននឹង អនុញ្ញាតឱ្យ ចូល គ្រឹះស្ថាន សិក្សា របស់ ខ្លួន ។
* ទី៤៖ គ្រប់ គ្រឹះស្ថាន សិក្សា គណៈ គ្រប់គ្រង ម្ចាស់ អាជីវកម្ម ទាំងអស់ ត្រូវ មាន កាតព្វកិច្ច ត្រួតពិនិត្យ ទៅ លើ មន្ត្រី បុគ្គលិក និង អ្នកបម្រើ សេវា ទាំងអស់ ដែល ធ្វើការ នៅក្នុង ទីតាំង អាជីវកម្ម របស់ ខ្លួន ដើម្បី ធានា ឱ្យ ប្រាកដ ថា អ្នក ទាំងនោះ ទទួលបាន ការចាក់ វ៉ាក់សាំង រួចរាល់ ហើយ ។
* និង ទី៥៖ ករណី គ្រឹះស្ថាន សិក្សា គណៈ គ្រប់គ្រង ម្ចាស់ អាជីវកម្ម ណា ដែល ត្រូវបាន អនុញ្ញាតឱ្យ បើក ដំណើរការ ប៉ុន្តែ មិន អនុវត្ត តាម គោលការណ៍ ណែនាំ ខាងលើ ត្រូវ ប្រឈមមុខ នឹង ការដកហូត អាជ្ញាប័ណ្ណ ឬ លិខិត អនុញ្ញាត ប្រកប អាជីវកម្ម និង អាច ឈាន ទៅ បិទ ទីតាំង ព្រមទាំង ត្រូវ ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ( ស្រប តាម ច្បាប់ ស្តីពី វិធានការ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ និង ជំងឺ កាច សាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត ) និង លិខិត បទដ្ឋាន គតិយុត្តិ ពាក់ព័ន្ធ ជាធរមាន ៕
ការថ្លែង របស់ រដ្ឋមន្ត្រី ការពារ ជាតិ សិង្ហបុរី ខាងលើ នេះ បាន កើត មាន ឡើង នៅក្នុង ឱកាស នៃ វេទិកា សន្តិសុខ អាស្ពែន (ASF) ដែល កំពុង ប្រារព្ធ ឡើង នៅ រដ្ឋធានី វ៉ាស៊ីនតោន ។ វេទិកា នេះ គឺជា សន្និសីទ នយោបាយ ការបរទេស និង សន្តិសុខ ប្រចាំ ឆ្នាំ មួយ ដែល មាន មេដឹកនាំ និង តួអង្គ សំខាន់ ៗ ក្នុង សហគមន៍ វិស័យ ការពារ ជាតិ ចូលរួម ហើយ សិង្ហបុរី ក៏ បាន បង្ហាញ អំពី ទស្សនវិស័យ របស់ ខ្លួន នៅក្នុង កម្មវិធី នោះ ផងដែរ ។
គួរ បញ្ជាក់ ថា ធ្យូ ថ្ម គឺជា ឥន្ធនៈ ផូស៊ីល ដែល បំពុល បរិយាកាស ខ្លាំង បំផុត ហើយក៏ ជា មូលហេតុ ចម្បង នៃ ការបញ្ចេញ ឧស្ម័ន ផ្ទះ កញ្ចក់ ដែល ធ្វើឱ្យ ផែនដី ឡើង កម្ដៅ ដែរ ។ ដូច្នេះ ការបញ្ឈប់ ការប្រើប្រាស់ ធ្យូងថ្ម នៅ ទូទាំង ពិភពលោក ជា គោលដៅ ដ៏ សំខាន់ សំដៅ សម្រេច ឱ្យ បាន នូវ កិច្ចព្រមព្រៀង អាកាសធាតុ ជា សកល ៕
ខាងក្រោម នេះ ជា របាយការណ៍ នៃ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស អាស៊ាន គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៤ ខែវិច្ឆិកា ឆ្នាំ ២០២១៖
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៤១ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០៣ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៤១ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៣ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ០៤ ខែវិច្ឆិកា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤១ នាក់ នោះ មាន ១៦នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៥ករណី និង ជនសង្ស័យ ២៥ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៥ករណី ។
