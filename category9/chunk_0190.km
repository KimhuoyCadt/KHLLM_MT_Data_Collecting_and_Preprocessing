សម្រាប់ យើង ធនាគារ ថ្មី នេះ អាច ជា គូ ប្រជែង សំខាន់ មួយ ។
ទោះជា យ៉ាងណា យើង មិន មាន ការបារម្ភ ខ្លាំង ទេ ព្រោះ ទីផ្សារ កម្ពុជា នៅ ធំ នៅឡើយ ហើយ ប្រាសាក់ ក៏ បាន សាង បណ្តាញ ច្រើន មក ហើយ ក្នុង ប្រតិបត្តិការ ១៨ ឆ្នាំ មក នេះ ។
ប្រធាន នាយក ប្រតិបត្តិ ធនាគារ អេស៊ីលីដា លោក អ៊ិន ចាន់ នីយល់ ថា ការមាន ស្ថាប័ន ហិរញ្ញវត្ថុ ច្រើន នៅ ទីផ្សារ ដែល បង្កើត ជា ការប្រកួតប្រជែង នោះ ជា រឿង ល្អ ។
ទិន្នន័យ ពី ធនាគារ ជាតិ បង្ហាញ ថា មកដល់ ពេលនេះ កម្ពុជា មាន ធនាគារ ពាណិជ្ជ៣៤ ធនាគារ ឯកទេស ៧និង គ្រឹះស្ថាន ហរិញ្ញវត្ថុ ៣៧ ៕
មន្ត្រី អះអាង ពី ការរីកចម្រើន បន្ទាប់ពី ការចាប់ កែទម្រង់
ភ្នំពេញៈ មន្ត្រី អគ្គ នាយកដ្ឋាន គយ បាន បញ្ជាក់ កាលពី ម្សិលមិញ ថា ចំណូល ពី ការប្រមូល ពន្ធ គយ បាន កើនឡើង ជាង មុន ចាប់ពី ខែវិច្ឆិកា មក គឺ បន្ទាប់ពី រដ្ឋាភិបាល កំណត់ ពេល ៦០ ថ្ងៃ ឱ្យ អគ្គ នាយកដ្ឋាន គយ កែលម្អ ប្រសិទ្ធភាព ការងារ ខណៈ ឱសានវាទ នេះ នឹង មកដល់ ដំណាច់ ខែធ្នូ នេះ ។
កាលពី ថ្ងៃទី ២៥តុលា លោក ហ៊ុន សែន បាន រិះគន់ ទៅ លើ អំពើពុករលួយ របស់ មន្ត្រី គយ ហើយ បាន ទុក ពេល ពីរ ខែ ដល់ អគ្គ នាយកដ្ឋាន គយ ដើម្បីឱ្យ កែតម្រូវការងារ បាន ត្រឹមត្រូវ ។
លោក ប៊ូរ ប៊ុន ណារ៉ា ប្រធាន អង្គភាព ទំនាក់ទំនង សាធារណៈ នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ម្សិលមិញ ថា អគ្គ នាយកដ្ឋាន គយ បាន ធ្វើ ផែនការ ប្រតិបត្តិ នៃ សកម្មភាព រយៈពេល ខ្លី បី ចំណុច ដើម្បី អនុវត្ត គិត ចាប់ពី ខែវិច្ឆិកា មក រួម មាន ការពង្រឹង ប្រសិទ្ធភាព ការងារ ប្រមូល ចំណូល ពន្ធ គយ និង រដ្ឋាករ ការបង្ក្រាប ការនាំចូល ទំនិញ គេច ពន្ធ និង ពង្រឹង អភិបាលកិច្ច អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ ។
លោក កងច័ន្ទ តារា រ័ត្ន ប្រធាន វិទ្យាស្ថាន ដើម្បី ការសិក្សា អភិវឌ្ឍន៍ កម្ពុជា ឱ្យដឹង ថា នេះ ជា សញ្ញា វិជ្ជមាន សម្រាប់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច រយៈពេល វែង ។
កន្លងមក កម្ពុជា នៅតែ ពឹងផ្អែក លើ ជំនួយ និង បំណុល បរទេស ហើយ កាលបរិច្ឆេទ សង ក៏ ជិត មកដល់ ដែល ត្រូវតែ រក ប្រភព ចំណូល ដើម្បី ទ្រទ្រង់ មូលដ្ឋាន សេដ្ឋកិច្ច ៕
ភ្នំពេញៈ សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន AEC នឹង កាត់បន្ថយ ការិយាធិបតេយ្យ និង អនុញ្ញាតឱ្យ ធ្វើ ពាណិជ្ជកម្ម កាន់តែ សេរី រវាង ប្រទេស ជា សមាជិក ទាំង១០ របស់ ប្លុក នេះ ។
ធនាគារ នេះ និយាយ ថា ការកំណត់ ពេល នៅ ឆ្នាំ ២០១៥ មិន ប្រាកដ ទេ ហើយ ថា គេ ត្រូវការ រយៈពេល ១០ឆ្នាំ ទៀត ដើម្បី អនុវត្ត កិច្ចព្រមព្រៀង នេះ ឱ្យ បាន ពេញលេញ ។
របាយការណ៍ ដែល បាន ចេញផ្សាយ កាលពី សប្តាហ៍ មុន ហើយ មាន ចំណងជើង ថា ៖
មេដឹកនាំ ប្រទេស ជាច្រើន បាន ជំរុញ ឱ្យ មាន ការ ធ្វើឱ្យ បាន ល្អ តាម ការសន្យា របស់ ពួកគេ ដោយសារតែ ទាក់ទង នឹង លទ្ធផល បាន ពី ការអង្កេត ដែល ត្រូវ ប្រមូល បាន ពី ក្រុមហ៊ុន ៣៨១ នៅ តំបន់ អាស៊ាន ក្នុង នោះ មាន រោងចក្រ ចំនួន ១៣ និង សេវាកម្ម ពាណិជ្ជកម្ម ៤០ នៅ កម្ពុជា ។
របាយការណ៍ នេះ បាន និយាយ ថា ៖
នៅក្នុង ពិភពលោក ដ៏ ល្អ ឥត ខ្ចោះ កិច្ចព្រមព្រៀង នេះ នឹង ប្រែក្លាយ អាស៊ាន ទៅជា ឋានសួគ៌ ពាណិជ្ជកម្ម មួយ ដែល ទំនិញ សេវាកម្ម ការវិនិយោគ កម្មករ ជំនាញ និង លំហូរ ចូល ទុន វិនិយោគ យ៉ាង រលូន ឆ្លងកាត់ តាម ព្រំដែន ។
ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ADB បាន សន្និដ្ឋាន របាយការណ៍ មួយ មាន ៥៣០ ទំព័រ របស់ ខ្លួន ដែល បាន តាមដាន យ៉ាង ដិតដល់ ពី កាលបរិច្ឆេទ ការកំណត់ ពេលវេលា មិន គួរ ត្រូវបាន មើលឃើញ ថា ជា គោលដៅ មួយ ហើយ គួរ ជំនួស ដោយ ការចាត់ទុក ថា ជា ព្រឹត្តិការណ៍ ដ៏ សំខាន់ មួយ ដែល បញ្ជាក់ ថា អាស៊ាន មិន មាន ការរំពឹងទុក ពី ការជិត ចូល មកដល់ នៃ ទីផ្សារ តែ មួយ ត្រឹម ឆ្នាំ ២០១៥ ឬ សូម្បីតែ ត្រឹម ឆ្នាំ ២០២០ ឬ ក៏ ២០២៥ នោះ ទេ ។
គំរូ នៅ តំបន់ អាស៊ាន កំពុង សម្លឹងមើល ឆ្ពោះទៅ ក្រៅ គ្រឹះស្ថាន ធុន ស្រាល និង ការជំរុញ ទីផ្សារ ។
អាស្រ័យ ហេតុ នេះ ផលប្រយោជន៍ ជាតិ និង ផលប្រយោជន៍ តំបន់ អាច ដាក់ រួមគ្នា ដោយ ស្រួល ។
ទន្ទឹមនឹង នេះ ដែរ ការរំពឹង ថា ប្រទេស កម្ពុជា នឹង សម្រេចបាន សមាហរណកម្ម កម្រិត តំបន់ ត្រឹម ឆ្នាំ ២០១៥ ធ្វើឱ្យ មាន ទស្សនៈ ចម្រុះ គ្នា បាន ពី សេដ្ឋវិទូ និង អ្នកស្រាវជ្រាវ ។
លោក ចាប សុថារិទ្ធិ អ្នកស្រាវជ្រាវ នៅ វិទ្យាស្ថាន សហប្រតិបត្តិ និង សន្តិភាព កម្ពុជា បាន និយាយ ថា ទោះបីជា មាន លទ្ធផល ការអង្កេត នេះ ក៏ដោយ ក៏ លោក ជឿជាក់ ថា កម្ពុជា កំពុង ស្ថិត នៅក្នុង កន្លែង មួយ ដ៏ ល្អ ក្នុង ការឆ្លើយតប នឹង សេចក្តីត្រូវការ នៃ ការចាប់ផ្តើម របស់ AEC នៅ ឆ្នាំ ២០១៥ ស្ទើរ គ្រប់ វិស័យ ។
គិត មក ត្រឹម ខែតុលា ឆ្នាំ នេះ ប័ណ្ណ ពិន្ទុ AEC ដែល ផ្តល់ ចំណាត់ថ្នាក់ ប្រទេស ពឹងផ្អែក លើ ការរៀបចំ ក្នុង ការចូលក្នុង សហគមន៍ នេះ របស់ ពួកគេ បាន បង្ហាញ ថា កម្ពុជា បាន ឆ្លើយតប បាន នឹង វិធានការ ទាំងអស់ ក្នុង ការធានា ឱ្យ បាន នូវ លំហូរ ទុន វិនិយោគ កម្លាំង កម្មករ ដោយ សេរី និង ក្របខ័ណ្ឌ គោល នយោបាយ ប្រកួតប្រជែង តម្រូវឱ្យ មាន មុនពេល ការកំណត់ នេះ ប៉ុន្តែ គឺ មិន ទាន់ សម្រេចបាន តម្រូវការ ដូចគ្នា សម្រាប់ ការហូរ ចូល ដោយ សេរី នៃ ទំនិញ សេវាកម្ម ការវិនិយោគ ផ្ទាល់ ពី បរទេស ស្បៀង កសិកម្ម ការដឹកជញ្ជូន និង ថាមពល ទេ ។
ប៉ុន្តែ ប័ណ្ណ ពិន្ទុ នេះ បាន បង្ហាញ ថា កម្ពុជា វៀតណាម ឡាវ និង មីយ៉ាន់ម៉ា កំពុង នៅ ពីក្រោយ ក្នុង ការកាត់បន្ថយ ខ្សែ បន្ទាត់ ពន្ធ ទូទាំង តំបន់ នេះ ជាមួយនឹង អត្រា ការរីកចម្រើន រួម ដែល មាន ចំនួន ៦៧ ភាគរយ ធៀប នឹង ៩៩ ភាគរយ សម្រាប់ ប្រទេស ជា សមាជិក ដែល នៅសល់ ចំនួន ៦ទៀត ។
ការរកឃើញ ថ្មី មួយ បង្ហាញ ថា ប្រទេស កម្ពុជា ជា ទិសដៅ ដែល មាន ការទាក់ទាញ វិនិយោគ តិច បំផុត ក្នុង ចំណោម ប្រទេស នៅក្នុង តំបន់ អាស៊ាន ។
ការអង្កេត មួយ ស្តីពី ភាពប្រកួតប្រជែង ប្រទេស អាស៊ាន ឆ្នាំ ២០១៣ បាន ចេញផ្សាយ កាលពី សប្តាហ៍ មុន បាន បង្ហាញ ថា ប្រទេស កម្ពុជា ជាប់ ចំណាត់ថ្នាក់ ទី ពីរ រាប់ ពីក្រោម លើ ប្រទេស ប្រ៊ុយណេ មួយ ពិន្ទុ បើ និយាយ អំពី ភាពទាក់ទាញ របស់ វិនិយោគិន ។
ការអង្កេត បង្ហាញ ថា មាន តែ ២១ ភាគរយ ក្នុង ចំណោម អ្នកឆ្លើយតប ៥០២ នាក់ របស់ ការអង្កេត នេះ ដែល ពួកគេ ទាំងអស់ មកពី សហគមន៍ ពាណិជ្ជកម្ម ក្នុង អាស៊ាន បាន រកឃើញ ថា កម្ពុជា គឺជា ប្រទេស មួយ សម នឹង ទទួល ការវិនិយោគ ក្នុង ពេល អនាគត ។
មន្ត្រី រដ្ឋាភិបាល ជាន់ ខ្ពស់ ជាថ្មី ម្តង ទៀត បាន អំពាវនាវ ឱ្យ សហគ្រាស ក្នុង ស្រុក ពង្រឹង គុណភាព និង បង្កើន ផលិតភាព ដើម្បី ប្រកួតប្រជែង ជាមួយ លំហូរ ផលិតផល ក្រៅ ស្រុក នៅពេល សមាហរណកម្ម សេដ្ឋកិច្ច អាស៊ាន ចូល មកដល់ នៅ ឆ្នាំ ២០១៥ ។
ការអំពាវនាវ នេះ ធ្វើឡើង ក្នុង សិក្ខាសាលា ថ្នាក់ ជាតិ ពី ប្រព័ន្ធ គ្រប់គ្រង សុវត្ថិភាព ម្ហូប អាហារ បែប ទំនើប ពី សប្តាហ៍ មុន ។
ការចូលមកដល់ នៃ សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន នៅ ឆ្នាំ ២០១៥ មាន ន័យ ថា ទំនិញ ក្នុង ប្រទេស អាស៊ាន និង ហូរ ទៅ ហូរ មក កាត់ ព្រំដែន ដោយ មិន ជាប់ ពន្ធ ។
រដ្ឋមន្ត្រី ក្រសួង ឧស្សាហកម្ម លោក ចម ប្រសិទ្ធ បាន យល់ ថា វា ជា ឱកាស ប៉ុន្តែ បាន ចោទសួរ ថា តើ ទំនិញ កម្ពុជា ត្រៀមខ្លួន សម្រាប់ ការបញ្ជូន ទៅ ក្រៅ ស្រុក ហើយ ឬ នៅ ខណៈ ចង្វាក់ ផលិតកម្ម ក្នុង ស្រុក នៅ មាន កម្រិត ទាំង គុណភាព និង ស្តង់ដារ នៅឡើយ នោះ ។
លោក បាន បង្ហាញ សុទិដ្ឋិនិយម ថា ក្នុង រយៈពេល ពីរ ឆ្នាំ ទំនិញ កម្ពុជា អាច ពង្រឹង ខ្លួន ដើម្បី ទៅ ប្រកួតប្រជែង បើ សហគ្រាស ក្នុង ស្រុក មាន ឆន្ទៈ ក្នុង ការធ្វើឱ្យ ប្រសើរឡើង នូវ ស្តង់ដារ និង ការផលិត របស់ ខ្លួន ។
លោកស្រី ចន្ធី ប្រធាន សមាគម សេដ្ឋកិច្ច កម្ពុជា បាន និយាយ ថា ខណៈ ដែល ប្រទេស ផ្សេង ទៀត ដែល មាន សេដ្ឋកិច្ច ធំ នៅក្នុង តំបន់ មាន ដូចជា ប្រទេស សិង្ហបុរី ម៉ាឡេស៊ី និង ថៃ ត្រូវបាន រៀបចំ សម្រាប់ សមាហរណកម្ម របស់ AEC ឱ្យ បាន ពេញលេញ ការរៀបចំ របស់ កម្ពុជា កំពុង ទទួលបាន ទំនុកចិត្ត តិចតួច ។
ភ្នំពេញៈ រដ្ឋាភិបាល កម្ពុជា កាលពី ម្សិលមិញ បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង កម្ចី ទឹកប្រាក់ ចំនួន ២៦ លាន ដុល្លារ អាមេរិក ពី ទីភ្នាក់ងារ អភិវឌ្ឍន៍ បារាំង AFD ក្នុង គម្រោង ស្តារ ប្រព័ន្ធ ធារាសាស្ត្រ ឡើងវិញ នៅ ខេត្ត ចំនួន បី ។
លោក អូន ព័ន្ធ មុន្នីរ័ត្ន រដ្ឋមន្ត្រី នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ថ្លែង ក្នុង ពិធី ចុះហត្ថលេខា ថា ប្រាក់ កម្ចី ពី កិច្ចព្រមព្រៀង នេះ ជា ផ្នែក មួយ នៃ គម្រោង អភិវឌ្ឍន៍ វិស័យ ធារាសាស្ត្រ និង កសិកម្ម ដែល នឹង ស្តារ ឡើងវិញ នូវ ប្រព័ន្ធ ធារាសាស្ត្រ ចំនួន ១១កន្លែង គ្របដណ្តប់ លើ ផ្ទៃដី ១១០០០ ហិកតា ស្ថិត នៅក្នុង ខេត្ត កំពង់ធំ សៀមរាប និង បន្ទាយមានជ័យ ហើយក៏ នឹង ស្តារ ព្រែក ចំនួន ៣០កន្លែង ទៀត នៅ ខេត្ត កណ្តាល គ្របដណ្តប់ លើ ផ្ទៃដី ៥០០០ ហិកតា ។
លោក អូន ព័ន្ធ មុន្នីរ័ត្ន មានប្រសាសន៍ ថា ៖
នេះ គឺជា កម្ចីសម្បទាន លើក ដំបូង ដែល ផ្តល់ ដោយ ទីភ្នាក់ងារ អភិវឌ្ឍន៍ បារាំង AFD ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា បន្ទាប់ពី ស្ថាប័ន នេះ បាន ផ្តល់ ជំនួយ ឥត សំណង ប្រមាណ ៥,២លាន ដុល្លារ កាលពី ខែមីនា កន្លង ទៅដល់ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដើម្បី ពង្រឹង សមត្ថភាព ក្នុង ការគ្រប់គ្រង ធនធាន ទឹក ។
លោក ឃឹម សុផាណ្ណា អ្នក ប្រឹក្សា គម្រោង របស់ អង្គការ សេដាក់ បាន ឱ្យដឹង ថា បញ្ហា ប្រឈម របស់ កសិករ កម្ពុជា គឺ ការពឹងផ្អែក លើ ទឹកភ្លៀង ជា ប្រភព ស្រោចស្រព នៅឡើយ ។
លោក បាន បញ្ជាក់ ថា ប្រព័ន្ធ ស្រោចស្រព បន្ថែម នៅ កម្ពុជា មាន ដូចជា អាង ស្តុក ទឹក ទំនប់ ប្រឡាយ ស្រះ ទឹក ជាដើម បន្ថែម ពីលើ ទឹកភ្លៀង ប៉ុន្តែ មិន គ្រប់គ្រាន់ ស្រោចស្រព ផ្ទៃដី ដាំដុះ សរុប នោះ ទេ ។
ទិន្នន័យ ពី អង្គការ សេដាក បាន បង្ហាញ ថា ប្រព័ន្ធ ស្រោចស្រព បន្ថែម របស់ កម្ពុជា សរុប មាន ២០០០ ប្រឡាយ និង ព្រែក ជីក ប៉ុន្តែ មាន តែ ប្រព័ន្ធ ធារាសាស្ត្រ ១០ភាគរយ ប៉ុណ្ណោះ ដែល អាច ប្រើប្រាស់ បាន ។
ទាក់ទិន នឹង គម្រោង ស្តារ ឡើងវិញ នូវ ប្រព័ន្ធ ធារាសាស្ត្រ នេះ លោក ឃឹម សុផាណ្ណា បាន និយាយ ថា ៖
កន្លងមក មាន ច្រើន យើង ឃើញ មាន ការសាងសង់ ច្រើន ប៉ុន្តែ បញ្ហា ប្រឈម គឺ ការថែទាំ ដើម្បី ប្រើប្រាស់ ឱ្យ បាន យូរអង្វែង ។
សំខាន់ ប្រាក់ កម្ចី នោះ ត្រូវ យកមក ប្រើ ឱ្យ ចំ ទិសដៅ និង មាន ប្រសិទ្ធភាព គុណភាព ព្រោះ ការសាងសង់ អស់ លុយ ច្រើន ប្រសិនបើ សង់ គ្មាន គុណភាព ប្រើ មិន បាន ប៉ុន្មាន ផង ក៏ ត្រូវ ខូច ហើយក៏ ត្រូវ ដល់ ពេល សង លុយ គេ វិញ ទៅ ហើយ ។
កម្ពុជា មាន ផ្ទៃដី កសិកម្ម សរុប ប្រមាណ ៣លាន ហិកតា ដោយ មាន ប្រព័ន្ធ ធារាសាស្ត្រ គ្របដណ្តប់ សរុប១,៤លាន ហិកតា ស្មើនឹង ៦៣ ភាគរយ នៃ ផ្ទៃដី កសិកម្ម សរុប ។
នេះ បើ តាម ការ ឱ្យដឹង ពី លោក លឹម គាន ហោរដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ប្រាប់ មក ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ខែមករា ៕
