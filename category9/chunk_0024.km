( ភ្នំពេញ ) ៖ កាំភ្លើង ធុន ស្រាល ដែល ខូច គុណភាព សរុប ១១. ៩១៥ ដើម ដែល រក្សាទុក ក្នុង ឃ្លាំង របស់ អគ្គ ស្នងការដ្ឋាន គរបាល ជាតិ នៅ សង្កាត់ ព្រែក ប្រា ខណ្ឌ ច្បារអំពៅ ត្រូវបាន ប្រគល់ ជូន មជ្ឈមណ្ឌល សកម្មភាព កម្ចាត់ មីន កម្ពុជា ( ស៊ីម៉ាក់ ) យក ទៅ បន្សាប និង កម្ទេចចោល តាម បែបបទ បច្ចេកទេស ។
ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០១ ខែមីនា ឆ្នាំ ២០១៩ នេះ ក្រោម អធិបតីភាព លោក ឧត្តមសេនីយ៍ ឯក សេក ភូមី អគ្គ ស្នងការ រង នគរបាល ជាតិ តំណាង នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង លោក ហេង រតនា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក អគ្គ នាយក ស៊ីម៉ាក់ ។
លោក ឧត្តមសេនីយ៍ ឯក ធាម ប៊ុន សេង ប្រធាន នាយកដ្ឋាន គ្រប់គ្រង អាវុធ ជាតិ ផ្ទុះ បាន លើកឡើង អំពី ប្រវត្តិ នៃ កិច្ច ដំណើរការប្រមែ ប្រមូល និង ដកហូត អាវុធ ហើយនិង បាន ប្រារព្ធ ពិធី បំផ្លាញ អាវុធ ជា ផ្លូវការ របស់ កម្ពុជា ចំនួន ៥៤ លើក សរុប អាវុធ ជិត ២២ម៉ឺន ដើម ។
លើស ពី នេះ លោក ឧត្តមសេនីយ៍ ឯក សេក ភូមី ក៏ បាន គូសបញ្ជាក់ ថា ពិធី ដែល ធ្វើ នៅ ថ្ងៃ នេះ ជា ចំណែក មួយ នៃ ការអនុវត្ត តាម អនុស្សារណៈ នៃ ការយោគយល់ ស្តីពី កិច្ចសហប្រតិបត្តិការ រវាង អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ និង មជ្ឈមណ្ឌល សកម្មភាព កំចាត់ មីន កម្ពុជា លើ ការងារ កាត់បន្ថយ អត្រា គ្រោះថ្នាក់ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម ដែល បាន ចុះហត្ថលេខា កាលពី ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០១៨ កន្លងទៅ ។
ក្នុង នាម អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ លោក ឧត្តមសេនីយ៍ សេក ភូមី បាន ថ្លែងអំណរគុណ ចំពោះ អគ្គ នាយ មជ្ឈមណ្ឌល សកម្មភាព កំចាត់ មីន កម្ពុជា ដែល បាន យកចិត្តទុកដាក់ ក្នុង ការអនុវត្ត តាម កិច្ចសន្យា ទទួលយក សំណើ ក្នុង ការកម្ទេចចោល អាវុធ ខូច គុណភាព របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ហើយ សង្ឃឹម ថា ភាគី ទាំង២ នឹង បន្ត អនុវត្ត ឲ្យបាន កាន់តែ សម្រេច ច្រើន បន្ថែម ទៀត តាម ស្មារតី អនុស្សារណៈ យោគយល់ ។
ពិសេស ពេល ខាងមុខ នេះ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ និង ស៊ីម៉ាក់ នឹង អាច រៀបចំ នូវ ការប្រគល់ - ទទួល អាវុធយុទ្ធភ័ណ្ឌ ខូច គុណភាព មួយចំនួន ទៀត ដែល បច្ចុប្បន្ន កំពុងតែ ស្តុក ទុក នៅ តាម បណ្តា ស្នងការដ្ឋាន នគរបាល រាជធានី ខេត្ត ប្រគល់ឲ្យ អង្គភាព CMAC តាម តំបន់ យក ទៅ កម្ទេចចោល តាម បែប បច្ចេកទេស តាម ពេលវេលា សមស្រប ណាមួយ ។
អគ្គ នាយក ស៊ីម៉ាក់ រូប នេះ ក៏ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហការ ដ៏ ល្អ រវាង អគ្គ ស្នងការ នគរបាល ជាតិ និង មន្ត្រី នគរបាល ជាតិ ថ្នាក់ មូលដ្ឋាន ជាមួយ មន្ត្រី ស៊ីម៉ាក់ ហើយ លោក សង្ឃឹម យ៉ាង មុតមាំ ថា ភាគី ទាំង ពីរ នឹង បន្ត ពង្រឹង ពង្រីក ការសហការ គ្នា ឲ្យ កាន់តែ ល្អ ប្រសើរ ទ្វេ ឡើង ថែម ទៀត ដើម្បី គាំទ្រ នូវ ការ កាត់បន្ថយ គ្រោះថ្នាក់ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម និង ការអភិវឌ្ឍ មាតុភូមិ កម្ពុជា ជានិច្ច និរន្ត ។
តាង នាម មន្ត្រី និង បុគ្គលិក អង្គភាព ស៊ីម៉ាក់ ទាំងមូល សូម បន្ត ខិតខំ រួមគ្នា ជាមួយ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ជាពិសេស កងកម្លាំង នគរបាល ជាតិ ដើម្បី រួមគ្នា កាត់បន្ថយ និង លុបបំបាត់ កាកសំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម មិន ត្រឹមតែ គ្រាប់ យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ ប៉ុណ្ណោះ ទេ តែ ថែមទាំង អាវុធ ធ្ងន់ ស្រាល សល់ ពី សង្គ្រាម ខូច គុណភាព ដើម្បី ធានា បាន សុខ សុវត្ថិភាព កាន់តែ ប្រសើរ សម្រាប់ ប្រជាជន និង សង្គម កម្ពុជា ។
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការព្យាករណ៍ អាកាសធាតុ ប្រចាំ សប្តាហ៍ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០១៩ ។
សេចក្តីជូនដំណឹង របស់ ក្រសួង ធនធាន ទឹក បាន បញ្ជាក់ ថា បន្ទាប់ពី បាន តាមដាន លើ ស្ថានភាព អាកាសធាតុ រួច មក ឃើញ ថា៖
ក្រសួង ធនធាន ទឹក បាន បន្ថែម ទៀត ថា លក្ខណៈ បែប នេះ នឹង ធ្វើឲ្យ កំណួច ខ្យល់ មិន អាច ប្រមូលផ្ដុំ ពពក ទឹក បង្ក ជា ភ្លៀង បាន ផ្ទុយទៅវិញ វា ជា លក្ខខណ្ឌ សម ប្រកប សម្រាប់ ការកកើតឡើង នូវ បាតុភូត រន្ទះ និង ខ្យល់ កន្ត្រាក់ ។
ក្រសួង ក៏ អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ សូម បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ បាតុភូត រន្ទះ និង ខ្យល់ កន្ត្រាក់ ដែល អាចនឹង កើតមាន ជា យថាហេតុ ៕ ព្រឹក នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ បើក ការដ្ឋាន សាងសង់ មន្ទីរពេទ្យ ខេត្ត ត្បូងឃ្មុំ តម្លៃ ជិត ៥០ លាន ដុល្លារ
លោក ជា ចាន់តូ អញ្ជើញ បញ្ចុះ បឋមសិលា សាងសង់ អគារ សាខា ធនាគារ ជាតិ ខេត្ត តាកែវ
( តាកែវ )៖ លោក ជា ចាន់តូ អគ្គ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា នៅ ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី បញ្ចុះ បឋមសិលា សាងសង់ អគារ ធនាគារ ជាតិ នៃ កម្ពុជា ខេត្ត តាកែវ ។
អគារ ធនាគារ ជាតិ ខេត្ត តាកែវ សាងសង់ ឡើង ដើម្បី ឆ្លើយតប នឹង ការអភិវឌ្ឍន៍ រីកចម្រើន នៃ សេដ្ឋកិច្ច ក្នុង ខេត្ត តាកែវ ព្រមទាំង ជា តម្រូវ ការចាំបាច់ ក្នុង ការគ្រប់គ្រង និង សម្របសម្រួល ប្រតិបត្តិការ រូបិយវត្ថុ ក៏ ដូចជា ជំរុញ ការប្រើប្រាស់ ប្រាក់ រៀល ឱ្យ កាន់តែ ទូលំទូលាយ ថែម ទៀត ។
សមិទ្ធផល ថ្មី នេះ នឹង ចូលរួមចំណែក បង្ហាញ ពី ការអភិវឌ្ឍ រីកចម្រើន នៃ ប្រព័ន្ធ ធនាគារ នៅ ខេត្ត តាកែវ ព្រមទាំង ការអនុវត្ត កម្មវិធី កំណែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ របស់ រដ្ឋាភិបាល និង បង្កើន សោភ័ណភាព ខេត្ត តាកែវ ឱ្យ កាន់តែ ស្រស់ស្អាត ទៀតផង ។
ក្នុង ឱកាស នោះ លោក អគ្គ ទេសាភិបាល ក៏ បាន ផ្តាំផ្ញើ ឱ្យ មន្ត្រី បុគ្គលិក សាខា ធនាគារ ជាតិ ខេត្ត តាកែវ ទាំងអស់ អនុវត្ត មុខងារ ភារកិច្ច របស់ ខ្លួន ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ និង មាន ភាពស្មោះត្រង់ រក្សា ការសម្ងាត់ វិជ្ជាជីវៈ ខិតខំ អភិវឌ្ឍ ខ្លួន ឯង និង បន្ត ស្មារតី សាមគ្គី និង សហការ គ្នា ល្អ ជា ប្រពៃណី ព្រមទាំង ខិតខំ យកចិត្តទុកដាក់ បម្រើ សេវា ជូន ឱ្យ មន្ទីរ - អង្គភាព រដ្ឋធនាគារ ពាណិជ្ជ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ប្រកបដោយ ប្រសិទ្ធភាព ៕
( ពិភពលោក ) ៖ នា ថ្ងៃព្រហស្បតិ៍ ទី២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ជាពិសេស គឺ ព្រឹត្តិការណ៍ ជំនួប កំពូល ត្រាំ - គីម នៅក្នុង ប្រទេស វៀតណាម តែម្តង ។
ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ និង ប្រមុខ ដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន ជួប មុខ គ្នា នៅ ថ្ងៃទី ពីរ នៃ ជំនួប កំពូល នៅឯ ហាណូយ ប្រទេស វៀតណាម ។
២៖ លោក ដូណាល់ ត្រាំ ធ្វើ សន្និសីទ កាសែត មួយ ក្រោយពី ជំនួប កំពូល ជាមួយ លោក គីម ជុង អ៊ុន ត្រូវបាន បិទ បញ្ចប់ យ៉ាង តក់ ក្រហល់ និង ពុំ មាន ពិធី ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ឬ សេចក្តីថ្លែងការណ៍ អ្វី ទាំងអស់ ។
៤៖ អ្នកភូមិ ១១នាក់ រងរបួស និង លំនៅឋាន ជាង ១០០ ខ្នង ត្រូវ ខូចខាត ដោយសារ គ្រោះ រញ្ជួយ ដី កម្រិត ៥. ៦រ៉ិចទ័រ នៅ ខេត្ត ស៊ូម៉ាត្រា ខាងលិច ។
៦៖ អាហ្វហ្គានីស្ថាន ប្រារព្ធ ទិវា ជាតិ ដើម្បី ផ្តល់ ការលើកទឹកចិត្ត ដល់ កងទ័ព ។
៣៖ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន ជំរុញ ឱ្យ ពិនិត្យមើល បញ្ហា បក្ខពួក និយម តាម បណ្តា អង្គភាព នានា ( ចុច អាន )
៤៖ សម្តេច តេជោ ហ៊ុន សែន ជំរុញ ឱ្យ ទប់ស្កាត់ កុំ ឱ្យ ទំនាស់ ដីធ្លី ថ្មី កើតមាន ហើយ ដោះស្រាយ បញ្ហា ដីធ្លី ដែល សេសសល់ ( ចុច អាន )
៥៖ ក្រសួង ការបរទេស ប្រកាស ស្តីពី លទ្ធផល ប្រមុខ ការទូត កម្ពុជា ចូលរួម ក្នុង កិច្ចប្រជុំ ជាន់ ខ្ពស់ លើក ទី ៤០ នៃ ក្រុមប្រឹក្សា សិទ្ធិ មនុស្ស អង្គការ សហ ប្រជាជាតិ ( ចុច អាន )
៦៖ កម្ពុជា ចេញ សេចក្តីថ្លែងការណ៍ ស្នើឲ្យ ឥណ្ឌា និង ប៉ាគីស្ថាន រក្សា ការអត់ធ្មត់ ខ្ពស់ បំផុត ចៀសវាង ការប៉ះទង្គិច គ្នា ដោយ អាវុធ បន្ត ទៀត ( ចុច អាន )
៨៖ ស៊ើបអង្កេត ទ្រព្យសម្បត្តិ អតីត មេ កងរាជអាវុធហត្ថ ខេត្ត រតនគិរី ជិត ចប់ ហើយ ACU បន្ត ស្រាវជ្រាវ លើ ស្នងការរង ស្រេង សុខា ថែម ទៀត ( ចុច អាន )
១១៖ ក្លិប កំសាន្ត បារ បរទេស ខារ៉ាអូខេ និង ទីតាំង កំសាន្ត នៅ ភ្នំពេញ ជាង ១ ពាន់ កន្លែង ត្រូវបាន ធ្វើ កិច្ចសន្យា ពាក់ព័ន្ធ គ្រឿងញៀន ( ចុច អាន )
១២៖ អនុ រដ្ឋមន្ត្រី ក្រសួង ដីធ្លី ជប៉ុន ប្រាប់ វិនិយោគិន របស់ ខ្លួន ថា កម្ពុជា ជា ប្រទេស មាន សក្តានុពល ខ្លាំង មាន កំណើន សេដ្ឋកិច្ច ខ្ពស់ ជាង គេ បំផុត ក្នុង តំបន់ អាស៊ាន ( ចុច អាន )
៧៖ ជើងហោះហើរ អន្តរជាតិ រាប់ ពាន់ រង ការរំខាន ខណៈ ដែន អាកាស ប៉ាគីស្ថាន ត្រូវ បិទ ពីរ ថ្ងៃ ជាប់ គ្នា ( ចុច អាន )
៨៖ ប្រធានាធិបតី តួក គី៖ គ្មាន មន្ត្រី វេណេស៊ុយអេឡា ណា ម្នាក់ ភៀសខ្លួន មក ជ្រកកោន នៅ តួកគី នោះ ឡើយ ( ចុច អាន )
៩៖ របាយការណ៍៖ លោក នីកូឡាស់ ម៉ាឌូរ៉ូ ដឹក មាស ៨តោន ចេញ ពី ធនាគារ កណ្ដាល វេណេស៊ុយអេឡា ( ចុច អាន )
លោក ហេង រតនា បាន ឲ្យដឹង ថា នៅក្នុង ឆ្នាំ ២០១៩នេះ ស៊ីម៉ាក់ មាន ផែនការបោសសំអាត ដី ដែល មាន បញ្ហា មីន ឲ្យបាន ចំនួន ១០២ គីឡូម៉ែត្រ ការ៉េ ។
លោក បាន លើកឡើង ថា ខណៈ ខែ ដំបូង ក្នុង ខែមករា ឆ្នាំ ២០១៩ អង្គភាព ស៊ីម៉ាក់ បាន ធ្វើ ការបោសសម្អាត ផ្ទៃដី បាន ចំនួន ៦. ៩៥ គីឡូម៉ែត្រ ការ៉េ ស្មើ និង ៨៦ % នៃ ផែនការប្រចាំ ខែ និង រកឃើញ និង កំទេចចោល គ្រាប់ មីន និង គ្រាប់ យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ គ្រប់ ប្រភេទ សរុប ចំនួន ៣. ៣៩៦ គ្រាប់ ។
អគ្គ នាយក ស៊ីម៉ាក់ រូប នេះ បាន បន្ដ ទៀត ថា ក្នុង នោះ ផងដែរ ក៏ បាន បោះ ផ្លាក សញ្ញា ព្រំ ចំការមីន បាន ប្រវែង ៧.៨៧០ ម៉ែត្រ ក្នុង គោលបំណង ឆ្លើយតប តាម សំណើរ អន្តរាគមន៍ បាន ចំនួន ៣៥៧ សំណើរ ។
គូសបញ្ជាក់ ថា ពេញ មួយ ឆ្នាំ ២០១៨ កន្លងទៅ អង្គភាព ស៊ីម៉ាក់ បាន រកឃើញ និង កំទេច គ្រាប់ មីន និង យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ បាន ចំនួន ជាង ៤ម៉ឺន គ្រាប់ និង បោស សំអាត ផ្ទៃដី បាន ជិត ៩ម៉ឺន គីឡូម៉ែត្រ ការ៉េ ៕
ឧប នាយក រដ្ឋមន្រ្តី ជា សុផារ៉ា បើក កិច្ចប្រជុំ ចាត់ចែង ការងារ សាងសង់ ព្រលានយន្តហោះ ភ្នំពេញ ថ្មី លើ ផ្ទៃដី ២៦០០ ហិកតា នៅ ខេត្ត កណ្តាល និង តាកែវ
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៨ ឧប នាយក រដ្ឋមន្រ្តី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ និង ជា ប្រធាន គណៈកម្មការរៀបចំ ទីតាំង គម្រោង សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី បាន ដឹកនាំ កិច្ចប្រជុំ មួយ នៅ ទីស្តីការ ក្រសួង រៀបចំ ដែនដី ដើម្បី ចាត់ចែង ការងារ សម្រាប់ ការសាងសង់ ព្រលានយន្តហោះ ថ្មី នេះ ។
តាម ការប្រកាស របស់ ក្រសួង រៀបចំ ដែនដី បាន ឱ្យដឹង ថា ក្រោយ កិច្ចប្រជុំ មាន លទ្ធផល មួយចំនួន ដូចត ទៅ៖
១៖ ជម្រាប ជូន អំពី ការសម្រេច របស់ រាជ រដ្ឋាភិបាល ក្នុង ការបង្កើត អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី ខ្នាត 4F លើ ផ្ទៃដី ទំហំ ២៦០០ ហិកតា ដែល អាច ទទួលយន្តហោះ ខ្នាត ធំ បាន ស្ថិត នៅក្នុង ភូមិសាស្ត្រ ខេត្ត កណ្តាល និង ខេត្ត តាកែវ ។
២៖ ប្រគល់ ភារកិច្ច ជូន ឯកឧត្តម ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្ត្រី ទទួលបន្ទុក រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល រៀបចំ កិច្ចព្រមព្រៀង ដាក់ ពិគ្រោះយោបល់ ជាមួយ ស្ថាប័ន និង អង្គភាព ពាក់ព័ន្ធ និង សុំ ការសម្រេច ពី រាជ រដ្ឋាភិបាល ដើម្បី ចុះហត្ថលេខា ជាមួយ ក្រុមហ៊ុន ខេមបូឌា អ៊ែរ ផត អ៊ិន វេស មិន ឯ . ក និង សិក្សា កំណត់ តំបន់ សុវត្ថិភាព នៃ ការហោះហើរ ។
៣៖ ប្រគល់ ភារកិច្ច ជូន ក្រុមការងារ គាំទ្រ ដល់ ការរៀបចំ ទីតាំង គម្រោង សាងសង់ ចុះ កំណត់ និយាម កាទីតាំង គម្រោង អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី បោះ បង្គោល ព្រំ កំណត់ តំបន់ លំនៅឋាន និង កម្ពស់ អគារ រៀបចំ ប្លង់ លម្អិត នគរូបនីយកម្ម និង ប្លង់ ហេដ្ឋារចនាសម្ព័ន្ធ ។
៥៖ រដ្ឋបាល ខេត្ត កណ្តាល និង រដ្ឋបាល ខេត្ត តាកែវ សហការ ជាមួយ ក្រុមការងារ និង ក្រុមហ៊ុន ក្នុង ការអនុវត្ត តួនាទី និង ភារកិច្ច គាំទ្រ ដល់ គម្រោង សាងសង់ អាកាសយានដ្ឋាន ស្រប តាម ការសម្រេច របស់ រាជ រដ្ឋាភិបាល ។
៦៖ ប្រគល់ ភារកិច្ច ជូន រដ្ឋបាល ខេត្ត កណ្តាល រដ្ឋបាល ខេត្ត តាកែវ និង អគ្គ នាយកដ្ឋាន សុរិយោដី និង ភូមិសាស្ត្រ កំណត់ អត្តសញ្ញាណ ប្រជាពលរដ្ឋ ដែល មាន ដី នៅក្នុង ទីតាំង គម្រោង ឱ្យ បាន ច្បាស់លាស់ ដោយ ផ្អែក ទៅ តាម ការកាន់កាប់ ជាក់ស្តែង និង ឯកសារ ពាក់ព័ន្ធ ដើម្បី មាន មូលដ្ឋាន ក្នុង ការដោះស្រាយ ផល ប៉ះពាល់ ជូន ប្រជាពលរដ្ឋ ។ ជំហាន បន្ទាប់ តាម ការចាំបាច់ ផ្អាក ជា បណ្តោះអាសន្ន ការធ្វើចរន្ត ការ ដី ស្ថិត ក្នុង ទីតាំង ដែល បង្ក ការលំបាក និង រាំងស្ទះ ដល់ ដំណើរការ អនុវត្ត គម្រោង ។
៧៖ ស្នើ ស្ថាប័ន ពាក់ព័ន្ធ គិតគូរ ជាមុន អំពី ហេដ្ឋារចនាសម្ព័ន្ធ គាំទ្រ ជា អាទី ការបង្កប់ បំពង់ ហ្គាស បណ្តាញ ផ្គត់ផ្គង់ ទឹក ស្អាត ប្រព័ន្ធ អគ្គិសនី ប្រព័ន្ធ លូ ខ្សែកាប អុបទិក អាង ប្រព្រឹត្តកម្ម ទឹក កខ្វក់ ឱ្យ បាន ត្រឹមត្រូវ មុន បង្ហូរ ចូល លូសាធារណៈ អង់តែន ទូរសព្ទ និង ហេដ្ឋារចនាសម្ព័ន្ធ ក្រោម ដី ផ្សេង ទៀត ចៀសវាង រៀបចំ តាម ក្រោយ ដែល បង្កឱ្យ ខូចខាត ដល់ ផ្លូវថ្នល់ ជាពិសេស ប្រព័ន្ធ ការពារ និង រំដោះ ទឹក ជំនន់ ។
៨៖ ស្នើ ក្រុមហ៊ុន បង្កើត ទីស្នាក់ការ បណ្តោះអាសន្ន សម្រាប់ ធ្វើការ នៅលើ ទីតាំង ជ្រើសរើស បុគ្គលិក ចេញ ពី មូលដ្ឋាន ដែល មាន កាយសម្បទា និង លក្ខណសម្បត្តិ តាម ចំនួន សមស្រប មក បម្រើ ការងារ ចាំបាច់ ក្នុង ការអនុវត្ត គម្រោង ។ ជំហាន បន្ទាប់ អាច ជ្រើសរើស បុគ្គលិក បន្ថែម តាម តម្រូវការ ជាក់ស្តែង ។
៩៖ លើកទឹកចិត្ត ប្រើប្រាស់ ធនធាន មនុស្ស ក្នុង ស្រុក ទាំង អ្នកជំនាញ និង អ្នក គ្មាន ជំនាញ ឱ្យ អស់ លទ្ធភាព ក្នុង ការអនុវត្ត គម្រោង សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី ។
ភារកិច្ច របស់ គណៈកម្មការរៀបចំ ទីតាំង គម្រោង សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី រួម មាន៖
* ពិនិត្យ និង កំណត់ និយាម កាទីតាំង សម្រាប់ គម្រោង សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី
* សិក្សា វាយតម្លៃ ថ្លៃ ដី នៅ តំបន់ គម្រោង សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី
* សម្របសម្រួល ដោះស្រាយ បញ្ហា ពាក់ព័ន្ធ នឹង ទីតាំង ដី ដើម្បី បង្ក លក្ខណៈ ដល់ ដំណើរការ គម្រោង សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី
* សម្របសម្រួល ជាមួយ ក្រសួង ស្ថាប័ន និង អង្គភាព ពាក់ព័ន្ធ របស់ រាជ រដ្ឋាភិបាល និង ក្រុមហ៊ុន ដើម្បី ដំណើរការ អនុវត្ត គម្រោង ប្រព្រឹត្តទៅ ដោយ ជោគជ័យ
* ផ្តល់ អនុសាសន៍ ដល់ ក្រុមហ៊ុន ក្នុង ការបំពេញ បែបបទ ផ្សេង ៗ ដើម្បី ឆ្លើយតប បាន តាម តម្រូវការ សម្រាប់ ការអនុវត្ត គម្រោង
* ពិនិត្យ និង ផ្តល់ យោបល់ លើ ផែនការ មេរបស់ គម្រោង ក៏ ដូចជា សំណូមពរ ផ្សេង ៗ របស់ ក្រុមហ៊ុន តាមដាន និង ត្រួតពិនិត្យ ការអនុវត្ត គម្រោង សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី និង ហេដ្ឋារចនាសម្ព័ន្ធ ពាក់ព័ន្ធ
* ធ្វើ របាយការណ៍ អំពី លទ្ធផល ជូន នាយក ដ្ឋមន្ត្រី ដើម្បី ពិនិត្យ និង សម្រេច ជាដើម ។
ខ្ញុំ សូម ជំរាប ជូន បងប្អូន ក្រុម អ្នកគាំទ្រ លោក ប្រធាន កឹម សុខា ទាំងអស់ ឲ្យបាន ជ្រាប ថា ពួកយើង បាន ទ្រាំ រស់ នៅក្នុង សម្ព័ន្ធភាព ដ៏ ឈឺចាប់ ជាមួយ លោក សម រង្ស៊ី យូរ ពេក ហើយ ។ ពួកយើង បាន ដឹង តាំងពី ដំបូង ហើយ លោក កឹម សុខា ក៏ បាន និយាយប្រាប់ ពួកយើង ជារឿយ ៗ តាំងពី យូរ មក ហើយ ដែរ ថា លោក រង្ស៊ី ជា មនុស្ស ដែល មាន សារជាតិ និង ចារឹក យ៉ាងម៉េច នោះ ។ ប៉ុន្តែ ពួក យើង បាន បង្ខំ ចិត្ត ក្នុង ស្ថានភាព មួយ ដែល យើង គិត ថា ដើម្បី ប្រយោជន៍ ជាតិ ហើយក៏ សុខចិត្ត រួមរស់ ជាមួយ ក្រុម របស់ លោក សម រង្ស៊ី ទៅ ។
ចំណែក ពួកយើង ជា អ្នកគាំទ្រ លោក ប្រធាន កឹម សុខា ក៏ ទទួល បាន នូវ ការប្រមាថ មាក់ងាយ យ៉ាង ខ្លាំងក្លា ពី ក្រុម អ្នកគាំទ្រ លោក រង្ស៊ី តាម បណ្តាញ សង្គម ហ្វេសប៊ុក ដោយ គ្រាន់តែ ពួក យើង ការពារ ភាព ត្រឹមត្រូវ ការពារ លក្ខន្តិកៈ គណបក្ស និង ការពារ កិត្តិយស លោក ប្រធាន កឹម សុខា ។
ដូច្នេះ ខ្ញុំ យល់ឃើញ ថា ដល់ ពេល ហើយ ដែល ពួកយើង ជា ក្រុម កឹម សុខា និយម ត្រូវ រួមគ្នា គិតគូរ ពី សុខ ទុក្ខ និង ជោគវាសនា របស់ លោក ប្រធាន កឹម សុខា . សុខ ទុក្ខ របស់ សកម្មជន និង មន្ត្រី កឹម សុខា និយម ក៏ ដូចជា សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ យើង ជាពិសេស អ្នកគាំទ្រ លោក ប្រធាន យ៉ាង ច្រើន ។ ដល់ ពេល ហើយ ដែល យើង ត្រូវ រើ បម្រះ ចេញ ពី ការគាបសង្កត់ ផ្លូវចិត្ត ដោយ ការប្រមាថ របស់ ដៃគូ ដែល យើង បាន ទ្រាំ ជា យូរ មក ហើយ ។
លោក កឹម សុខា មាន ប្រជាប្រិយភាព នយោបាយ គ្រប់គ្រាន់ ហើយ គាត់ ក៍ ជា អ្នកនយោបាយ ម្នាក់ ដែល បាន លះបង់ គ្រប់ បែបយ៉ាង រាប់ ទាំង សេរីភាព របស់ ខ្លួន ផង គឺ ខុស ឆ្ងាយ ស្រឡះ ពី លោក សម រង្ស៊ី ។
ពី៖ អ្នក កឹម សុខានិយម ស្រុក បារាំង លោក គីម ជុង អ៊ុន នឹង បន្ត បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ វៀតណាម ក្រោយ បញ្ចប់ ជំនួប គ្មាន លទ្ធផល ជាមួយ លោក ដូណាល់ ត្រាំ
( ហាណូយ ) ៖ ក្រសួង ការបទេស វៀតណាម បាន ឱ្យដឹង ថា មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន នឹង ចាប់ផ្ដើម បំពេញ ដំណើរទស្សនកិច្ច ផ្លូវ រដ្ឋ រយៈពេល ២ ថ្ងៃ នៅក្នុង ប្រទេស វៀតណាម នៅ ថ្ងៃសុក្រ ស្អែក ស្រប ពេល លោក ដូណាល់ ត្រំា បាន ជិះ យន្ដហោះ ត្រឡប់ ទៅកាន់ ទីក្រុង វ៉ាស៊ីនតោន វិញ ហើយ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ។
ការប្រកាស ខាងលើ របស់ ក្រសួង ការបទេស វៀតណាម ធ្វើឡើង នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ ចេញផ្សាយ តែ ប៉ុន្មាន នាទី ប៉ុណ្ណោះ បន្ទាប់ពី ជំនួប កំពូល ត្រាំ - គីម លើក ទី២ ក្នុង ទីក្រុង ហាណូយ ដែល ចាប់ពី ថ្ងៃពុធ រហូតដល់ ថ្ងៃព្រហស្បតិ៍ នេះ បាន បិទ បញ្ចប់ ទៅ មុន កាល កំណត់ ដោយ គ្មាន កិច្ចព្រមព្រៀង អ្វី ទាំងអស់ ។ ចំណែកឯ លោក ដូណាល់ ត្រាំ វិញ ក៏ បាន អះអាង ដែរ ថា ដើរ ចេញ ពី កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ ដោយសារតែ មិន អាច ទទួលយក បាន នូវ សំណើ របស់ លោក គីម ជុំវិញ ការបន្ធរបន្ថយ ទណ្ឌកម្ម អន្តរជាតិ ដឹកនាំ ដោយ សហរដ្ឋ អាមេរិក ។
គួរ ជម្រាប ថា ក្រសួង ការបរទេស វៀតណាម មិន បាន បញ្ជាក់ លម្អិត ពី កាលវិភាគ នៃ ដំណើរទស្សនកិច្ច របស់ លោក គីម នៅ វៀតណាម នោះ ទេ ដោយ គ្រាន់តែ ឱ្យដឹង ថា មេដឹកនាំ កូរ៉េ ខាងជើង រូប នេះ អាចនឹង ស្ថិត នៅក្នុង ប្រទេស អាស៊ី អាគ្នេយ៍ មួយ នេះ រហូតដល់ ថ្ងៃសៅរ៍ ៕
ថ្លែង ប្រាប់ អ្នកសារព័ត៌មាន នៅក្នុង សន្និសីទ សារព័ត៌មាន ក្រោយ បិទ បញ្ចប់ កិច្ចប្រជុំ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ លោក ឈឹម ផល វរុណ អគ្គ លេខាធិការ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ បាន អះអាង យ៉ាង ដូច្នេះ ថា៖ « ពាក់ព័ន្ធ នឹង ដី នៅ ខេត្ត មណ្ឌលគិរី ដែល ជា ការលើកឡើង របស់ គណបក្ស ជនជាតិ ដើម ប្រជាធិបតេយ្យ ដែល សុំ ឱ្យ សម្តេច ជួយ ការពារ មជ្ឈមណ្ឌល វប្បធម៌ របស់ ជនជាតិ ដើម នៅ ទីនោះ ហើយ ការពិត ទៅ នៅ ទីនោះ គឺ មាន ស. ជ.ណ រួចទៅហើយ តែ បញ្ហា គឺ មិន បាន អនុវត្ត ឱ្យ មាន ប្រសិទ្ធភាព » ។
លោក បាន បន្ត ថា « សម្តេច តេជោ បាន បញ្ជា ឱ្យ គណៈ អភិបាល ខេត្ត មណ្ឌលគិរី និង ស្ថាប័ន ពាក់ព័ន្ធ ត្រូវ ទប់ស្កាត់ ជាបន្ទាន់ មិន អនុញ្ញាតឱ្យ បុគ្គល ណា ទៅ ទន្ទ្រាន យក ដី នៅ ភ្នំ ដោះ ក្រមុំ ទេ ហើយ សម្តេច នៅ ចងចាំ អ្វី ដែល សម្តេច ធ្លាប់ ទៅ កាលពី ឆ្នាំ ២០១២ នៅ ទីនោះ បន្តិច ទៀត ត្រូវ រឹបអូស និង ឈូសឆាយ វិញ ផ្តល់ លទ្ធភាព ឱ្យ អាជ្ញាធរ រដ្ឋ ប្រើប្រាស់ នូវ លទ្ធភាព ថវិកា ខ្លះ ដើម្បី ជួយ ធ្វើ របង ហ៊ុព័ទ្ធ សម្រាប់ ធានា ដល់ ទី សក្ការៈបូជា របស់ បងប្អូន ជនជាតិ ដើម ភាគ តិច » ។
ជំនួស មុខ ឱ្យ ជនជាតិ ដើម ភាគិតិច នៅ តំបន់ នោះ លោក បាន សម្តែង ភាពរីករាយ និង អរគុណ សម្តេច នាយក រដ្ឋមន្រ្តី ដែល បាន ដកហូត យក ភ្នំ ដោះ ក្រហម នោះ ត្រឡប់ មកវិញ ។ លោក បញ្ជាក់ ថា ភ្នំ ដោះ ក្រមុំ ក្រៅពី ទី សក្ការៈបូជា របស់ ជនជាតិ ដើម ភាគ តិច ក៏ ក្លាយទៅជា តំបន់ ទេសចរ ដ៏ សំខាន់ មួយ ផងដែរ ៕
អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ អំពាវនាវ ក្រុមហ៊ុន សន្ដិសុខ ឯកជន នៅ ខេត្ត កំពង់ឆ្នាំង ចាត់ បញ្ជូន ភ្នាក់ងារ របស់ ខ្លួន សហការ ជាមួយ សមត្ថកិច្ច ដើម្បី ការពារ សន្ដិសុខ ក្នុង ពិធី បុណ្យ ទន្លេ
( ភ្នំពេញ ) ៖ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ តាមរយៈ នាយកដ្ឋាន គ្រប់គ្រង សន្ដិសុខ ឯកជន ដែល ជា សេនាធិការ នៅ ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ បាន អំពាវនាវ ដល់ ក្រុមហ៊ុន សន្ដិសុខ ឯកជន ដែល មាន ទីតាំង នៅ ខេត្ត កំពង់ឆ្នាំង ជួយ ចាត់ បញ្ជូន ភ្នាក់ងារ របស់ ខ្លួន ដែល កំពុង បំពេញ ការងារ នៅ ទីនោះ សហការ ជាមួយ សមត្ថកិច្ច ដើម្បី ចូលរួម ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ ក្នុង ពិធី បុណ្យ ទន្លេ នា ពេល ខាងមុខ នេះ ។
ក្នុង ពិធី បិទ វគ្គ បំប៉ន់ ជំនាញ ភ្នាក់ងារ សន្ដិសុខ ឯកជន លើក ទី ១២ លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខា រស្មី ប្រធាន នាយកដ្ឋាន គ្រប់គ្រង សន្ដិសុខ ឯកជន បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « អគ្គ ស្នងការ នគរបាល ជាតិ សូម អំពាវនាវ ដល់ ក្រុមហ៊ុន សន្ដិសុខ នៅ ខេត្ត កំពង់ឆ្នាំង ជួយ ចាត់ បញ្ជូន ភ្នាក់ងារ របស់ ខ្លួន ចូលរួម សហការ ជាមួយ សមត្ថកិច្ច ដើម្បី ការពារ សន្ដិសុខ ក្នុង ពិធី បុណ្យ ទន្លេ ដែល នឹង ធ្វើឡើង នៅពេល ខាងមុខ នេះ » ។
ការអំពាវនាវ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ធ្វើឡើង បន្ទាប់ មើលឃើញ នូវ ភាពជោគជ័យ នា ពេល កន្លងមក ដែល ភ្នាក់ងារ សន្ដិសុខ ឯកជន បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក និង ពិធី សម្ពោធ វិមាន ឈ្នះ ឈ្នះ នា ពេល កន្លងទៅ ផងដែរ ។
លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខា រស្មី បាន បញ្ជាក់ ថា ភ្នាក់ងារ សន្ដិសុខ ឯកជន ជា កម្លាំង ជំនួយ ដល់ កងកម្លាំង នគរបាល ជាតិ និង ជា អ្នកការពារ ថែរក្សា សន្ដិសុខ សុវត្ថិភាព សណ្ដាប់ធ្នាប់ នៅនឹង កន្លែង ផ្ទាល់ ជាមួយ ប្រជាពលរដ្ឋ ដូច្នេះ បើ ភ្នាក់ងារ សន្ដិសុខ ឯកជន មាន វិជ្ជាជីវៈ ច្បាស់លាស់ នោះ វា នឹង ធ្វើឲ្យ ប្រសើរឡើង នូវ ការចូលរួម ថែរក្សា សន្ដិសុខ បាន យ៉ាង ល្អ ប្រសើរ ។
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៨ ខែកុម្ភៈ៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៨១៧ គ្រឿង និង ផាក ពិន័យ ៥៤៣ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៤.៩៣៩ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៨១៧ គ្រឿង ( ម៉ូតូ ៨១ %) អប់រំ២៧៤ គ្រឿង និង ផាក ពិន័យ ៥៤៣ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៨ ខែកុម្ភៈ នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ២. ៨៧៤ គ្រឿង . អប់រំ១៨៩ គ្រឿង និង ផាក ពិន័យ ៤៦៥ គ្រឿង ។
លោក ឈឹម ផល វរុណ បាន ថ្លែង ទៀត ថា ក្រៅពី ការបញ្ជា ទៅកាន់ ក្រសួង ពាក់ព័ន្ធ ឲ្យ ដោះស្រាយ ដីធ្លី ឆាប់ ចប់ នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន យក យុទ្ធសាស្ត្រ ដែល សម្តេច ធ្លាប់ ដោះស្រាយ បញ្ហា កន្លងមក ទៅ ធ្វើជា គោលការណ៍ ដើម្បី ដោះស្រាយ បញ្ហា ដីធ្លី ដែល នៅ សេសសល់ ដល់ សព្វ ថ្ងៃ នេះ ផងដែរ ។
លោក ឈឹម ផល វរុណ បញ្ជាក់ ថា៖ « មាន បញ្ហា គតិយុត្ត មួយចំនួន ដែល តុលាការ បាន កាត់ក្តី ហើយ បញ្ហា ខ្លះ មិន សមប្រកប ដោយ សម្តេច លោក មាន បទពិសោធន៍ ក្នុង ការដោះស្រាយ ដូចជា បទពិសោធន៍ មាន បញ្ហា អណ្តូង ទឹក នៅ ខេត្ត តាកែវ រឿង បញ្ហា ទាហាន នៅឯ បន្ទាយមានជ័យ ដែល សម្តេច បាន បង្ហាញ ពី ការកាត់សេចក្តី ដែល មិន សមប្រកប តាម តថភាព ដែល កើត មាន ឡើង ។ អញ្ចឹង យុត្តិសាស្ត្រ ដែល ធ្លាប់ មាន នេះ ក៏ សម្តេច បាន យកមក ដាក់ ក្នុង ការដោះស្រាយ បញ្ហា ដីធ្លី បច្ចុប្បន្ន នេះ »៕
អភិបាល ខណ្ឌ ឫស្សីកែវ ទទួល ទេយ្យទាន ជាង ៨លាន ពី ព្រះតេជគុណ គង់ នៅ វត្ត « ទួល អស់ លោក » ដើម្បី បន្ត ចែកជូន ជន ងាយ រងគ្រោះ ក្នុង មូលដ្ឋាន
ថ្លែង នៅក្នុង សន្និសីទ សារព័ត៌មាន ស្តីពី លទ្ធផលប្រជុំ ជាមួយ សមាជិក ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ . លោក ឈឹម ផល វរុណ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « អញ្ចឹង ជា អនុសាសន៍ មួយ ( របស់ សម្តេច តេជោ ) ឱ្យ ក្រសួង មហាផ្ទៃ ពិនិត្យ ក៏ ដូចជា ក្រសួង នានា ពិនិត្យ អំពី ភាព បក្ខពួក និយម ឱ្យ ផ្អែក លើ កត្តា អន្ត នោម័ត និង កត្តា សត្យានុម័ត ហើយ ជាពិសេស ទៅ ទៀត ឱ្យ ពិនិត្យ លើ ការជ្រើសរើស មន្ត្រីរាជការ ដោយ ផ្អែក ទៅ លើ លិខិត បទដ្ឋាន អ្នក មាន ស្នាដៃ » ។
បើ តាម លោក ឈឹម ផល វរុណ បាន បន្ត ថា ចំពោះ បញ្ហា នេះ សម្តេច តេជោ ហ៊ុន សែន តែងតែ បាន លើក នូវ ភស្តុតាង ជាក់ស្តែង ដែល ធ្លាប់ កើតមាន រួច មកហើយ នៅ នៅក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី កាលពី លើក មុន ៗ ដោយ មានប្រសាសន៍ ហាម ដាច់ខាត មិន ឱ្យ យក ក្រុមគ្រួសារ ឬ បក្ខពួក របស់ ខ្លួន ដែល គ្មាន សមត្ថភាព ចូលមក បម្រើការ នៅក្នុង ស្ថាប័ន ដោយ មិន ឆ្លងកាត់ ការប្រឡង នោះ ទេ ។
ជាមួយគ្នា នេះ ដែរ លោក ឈឹម ផល វរុណ ក៏ បាន លើកឡើង ថា មាន ថ្នាក់ដឹកនាំ មួយ បាន ធ្វើ លិខិត ស្នើសុំ ដើម្បី បញ្ចូល បងប្អូន ខ្លួន ចូល បម្រើ ការងារ នៅក្នុង ស្ថាប័ន ប៉ុន្តែ ត្រូវបាន ចារ បដិសេធ វិញ ដោយ ឧប នាយក រដ្ឋមន្ត្រី ប៊ិន ឈិន ថា សម្តេច ទើបតែ ណែនាំ ហើយ ថ្មី ៗ នេះ ។ ដូច្នេះ មិន អាច ធ្វើ ផ្ទុយទៅ លើ ការណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន នោះ ទេ ។
មន្ត្រី ជាន់ ខ្ពស់ រូប នេះ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « សម្តេច តេជោ បញ្ជា ទៅ ក្រសួង មហាផ្ទៃ តាមរយៈ វត្តមាន ឯកឧត្តម សក់ សេដ្ឋា ពាំនាំ កិច្ចការ នេះ ជូន សម្តេច ក្រឡាហោម ស ខេង ដើម្បី ពិនិត្យ ជាក់ស្តែង តែ ដោយ ឈរ លើ ភាពយុត្តិធម៌ មួយ ផ្អែក ទៅ លើ កត្តា អត្តនោម័ត ផង និង ផ្អែក លើ កត្តា សត្យានុម័ត ផង កុំ ឱ្យ ផ្តោត តែ មួយ ជ្រុង » ។
លោក ឈឹម ផល វរុណ បាន បន្ថែម ទៀត ថា ក្នុង ន័យ នេះ សម្តេច តេជោ ហ៊ុន សែន លោក មិន គាំទ្រ ទេ សម្រាប់ ថ្នាក់ដឹកនាំ ស្ថាប័ន ណាមួយ នៅក្នុង ប្រទេស កម្ពុជា យក បងប្អូន និង បក្ខពួក គ្រួសារនិយម របស់ ខ្លួន ចូល បម្រើ ការងារ នៅក្នុង អង្គភាព ណាមួយ ដែល ធ្វើឱ្យ បាត់បង់ នូវ ជោគវាសនា ស្មើ ៗ គ្នា របស់ យុវជន ជំនាន់ ក្រោយ ។ ដូច្នេះ យើង ឃើញ ថា ជា ចំណាត់ការ មួយ ប្រកបដោយ ប្រសិទ្ធភាព ដែល កាន់តែ រម្លឹក ឱ្យ កាន់តែ ខ្លាំង ថែមទៀត ការជ្រើសរើស មន្ត្រីរាជការ ដោយ ផ្អែក លើ នីតិវិធី ត្រឹមត្រូវ ៕
ស្ត្រី អ្នកលក់ លៀស ហាល ម្នាក់ នៅ ផ្សារ ស្គន់ ឈ្នះ រង្វាន់ ១០០ លាន រៀល ពី តែ បៃតង អ៊ីឈីតាន់
( ភ្នំពេញ ) ៖ ស្ត្រី វ័យ ចំណាស់ ម្នាក់ ដែល មាន មុខរបរ ជា អ្នកលក់ លៀស ហាល នៅ ផ្សារ ស្គន់ រស់ នៅ ភូមិ ថ្មី ឃុំ សូទិព្វ ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម មាន សំណាង បាន ឈ្នះ រង្វាន់ ធំ ពី តែ បៃតង អ៊ីឈីតាន់ នូវ ទឹកប្រាក់ ចំនួន ១០០ លាន រៀល កាលពី ចុង សប្ដាហ៍ កន្លងទៅ នេះ ។
អ្នកស្រី បាន បញ្ជាក់ ទាំង អារម្មណ៍ រំជើបរំជួល ទៀត ថា តាំងពី មុន មក អ្នកស្រី មិន ធ្លាប់ នឹក គិត ថា អាច មាន លុយ ច្រើន សន្ធឹកសន្ធាប់ ដូច្នេះ នោះ ទេ ព្រោះ គ្មាន មុខរបរ អ្វី ក្រៅពី លក់ លៀស ហាល ដើម្បី ចិញ្ចឹម ក្រពះ តែ ប៉ុណ្ណោះ ប៉ុន្តែ ពេលនេះ តែ បៃតង អ៊ីឈីតាន់ បាន ជួយ កែប្រែ ជោគវាសនា គ្រួសារ របស់ អ្នកស្រី ឱ្យ មាន ភាពល្អ ប្រសើរ ហើយ ។ ក្រោយពី ទទួលបាន លុយ រង្វាន់ ធំ ១០០ លាន រៀល អ្នកស្រី នឹង យក មួយចំនួន ទៅ សង បំណុល គេ ហើយ ទុក មួយ ចំណែក ទៀត សង់ ផ្ទះ និង បង្កើត មុខរបរ ដើម្បី ទ្រទ្រង់ ជីវភាព ទៅ ថ្ងៃ អនាគត ។
ក្រៅពី នោះ ភាគី ទាំង ពីរ ក៏ បាន ចែករំលែក គំនិត យោបល់ ស្តីពី ផែនការ នៃ ក្រសួង ក្នុង ការអនុម័ត គោល នយោបាយ និង ច្បាប់ ពាក់ព័ន្ធ សម្រាប់ កែលម្អ បរិយាកាស ធុរកិច្ច ទីផ្សារ ទូរគមនាគមន៍ ដើម្បី ជំរុញ ឲ្យ ប្រតិបត្តិករ វិនិយោគ បន្ថែម និង ទប់ស្កាត់ ការប្រកួតប្រជែង ដែល មាន លក្ខណៈ អវិជ្ជមាន ។
ជាមួយគ្នា នោះ លោក រដ្ឋមន្ត្រី ត្រាំ អ៊ីវតឹក ក៏ កោតសរសើរ ដល់ ក្រុមហ៊ុន Huawei ដែល ជា បាន ខិតខំ ប្រឹងប្រែង ប្រតិបត្តិការ ក្នុង ប្រទេស កម្ពុជា រយៈកាល កន្លងទៅ ហើយ លោក រដ្ឋមន្ត្រី ក៏ បាន បង្ហាញ នូវ សេចក្តី អបអរសាទរ ចំពោះ ខួប ២០ ឆ្នាំ នៃ ក្រុមហ៊ុន Huawei ប្រចាំ ប្រទេស កម្ពុជា ។
រដ្ឋមន្រ្តី ក្រសួង ប្រៃសណីយ៍ បាន បន្ដ ថា « ខ្ញុំ ជឿជាក់ ថា ក្រុមហ៊ុន Huawei អាច ចូលរួមចំណែក កាន់តែ ច្រើន សម្រាប់ ការផ្លាស់ប្តូ ឌីជីថល កម្ពុជា និង ជួយ ប្រទេស កម្ពុជា ឲ្យ ឆ្ពោះ ទៅរក ឧស្សាហកម្ម ជំនាន់ ទី៤ នៅ ថ្ងៃ អនាគត » ។
គួរ បញ្ជាក់ ផងដែរ ថា កម្មវិធី សមាជ ទូរស័ព្ទ ពិភពលោក MWC 2019 គឺជា ព្រឹត្តិការណ៍ នៃ បច្ចេកវិទ្យា ទូរគមនាគមន៍ ដ៏ ធំ បំផុត នៅលើ ពិភពលោក ដែល នាំមក នូវ បច្ចេកវិទ្យា ថ្មី ៗ និង បច្ចេកវិទ្យា ឈាន មុខ គេ ពី ក្រុមហ៊ុន ឈាន មុខ ចំនួន ជាង ២. ៤០០ក្រុមហ៊ុន ដែល មាន កម្មវិធី សន្និសីទ កំពូល ដោយ ប្រមូលផ្តុំ ដោយ ទស្សនវិទូ និង អ្នកជំនាញ ជាច្រើន ដើម្បី ស្វែងយល់ ពី ប្រធានបទ ថ្មី ៗ ដែល មាន ឥទ្ធិពល បំផុត សម្រាប់ ឧស្សាហកម្ម បច្ចេកវិទ្យា ។
កម្មវិធី នេះ ក៏ ជា ឱកាស ក្នុង ការស្វែងយល់ ពី កម្មវិធី ដែល ដឹកនាំ ដោយ ដៃគូ រាប់ ពាន់ ដូចជា សិក្ខាសាលា GSMA និង កិច្ចប្រជុំ កំពូល ជាច្រើន ទៀត ។ នៅក្នុង កម្មវិធី នេះ អ្នក អាច ស្វែងយល់ នូវ អ្វី ៗ គ្រប់ យ៉ាង ដែល អ្នក ចង់ ដឹង អំពី ឧស្សាហកម្ម នា ពេល បច្ចុប្បន្ន និង អាច លើស ពី នេះ ទៀត ។ MWC ២០១៩ សន្យា ថា នឹង ពង្រីក បណ្តាញ ទំនាក់ទំនង និង ជួយ អ្នក ឲ្យ សម្រេចបាន នូវ គោលដៅ របស់ អ្នក ៕
មន្ត្រី អ៊ីរ៉ាក់ ២៥នាក់ បញ្ចប់ ការហ្វឹកហ្វឺន ដោយ ជោគជ័យ ជំនាញ ប្រើប្រាស់ និង ថែទាំ គ្រឿងចក្រ កំទេច មីន នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ មន្ត្រី អ៊ីរ៉ាក់ ដែល មក ពី ក្រសួង មហាផ្ទៃ . ក្រសួង សុខាភិបាល និង បរិស្ថាន និង អង្គភាព បោស សំអាត មីន ចំនួន ២៥ នាក់ បាន បញ្ចប់ ដោយ ជោគជ័យ នូវ វគ្គ ហ្វឹកហ្វឺន ប្រើប្រាស់ និង ថែទាំ គ្រឿងចក្រ កំទេច មីន នៅ កម្ពុជា ។
វគ្គ ហ្វឹកហ្វឺន នេះ មាន រយៈពេល ៣៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៤ ខែមករា ឆ្នាំ ២០១៩ ដល់ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ដែល ហ្វឹកហ្វឺន ដោយ មជ្ឈមណ្ឌល សកម្មភាព កម្ចាត់ មីន កម្ពុជា ( ស៊ីម៉ាក់ ) គាំទ្រ ថវិកា ដោយ ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ ជប៉ុន (JICA) ។
ពិធី បិទ បញ្ចប់ វគ្គ ហ្វឹកហ្វឺន ត្រូវបាន រៀបចំឡើង នៅ បញ្ជាការ ស៊ីម៉ាក់ រាជធានី ភ្នំពេញ ក្រោម អធិបតីភាព លោក ហេង រតនា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក ស៊ីម៉ាក់ ។
មន្ត្រី ស៊ីម៉ាក់ បាន បញ្ជាក់ ឲ្យដឹង ថា ក្រោយ បញ្ជប់ ការហ្វឹកហ្វឺន នេះ នៅក្នុង ប្រទេស កម្ពុជា មន្ត្រី ជំនាញ អ៊ីរ៉ាក់ បាន សម្ដែង នូវ ការពេញចិត្ដ និង កោតសរសើរ ដល់ មន្ត្រី ជំនាញ ស៊ីម៉ាក់ ចំពោះ សមត្ថភាព ក្នុង ការបណ្ដុះបណ្ដាល ជំនាញ ប្រើប្រាស់ គ្រឿងចក្រ កំទេច មីន ។
មន្ត្រី ដដែល បាន បញ្ជាក់ ថា នេះ ជា វគ្គ ហ្វឹកហ្វឺន លើក ទី៤ ដែល ស៊ីម៉ាក់ បាន ផ្តល់ ការហ្វឹកហ្វឺន ជូន សិក្ខាកាម មកពី ប្រទេស អ៊ឺរ៉ាក់ ដែល ជា ការអនុវត្តន៍ ជាក់ស្តែង ទាំង ការប្រើប្រាស់ គ្រឿងចក្រ ការថែទាំ ដែល មាន ការពន្យល់ ទាំង ទ្រឹស្តី មិង ការអនុវត្ត ជាក់ស្តែង នៅ ទីតាំង ចំការ មីន ផ្ទាល់ តែម្តង ។
ក្នុង ការមក ហ្វឹកហ្វឺន ជំនាញ ប្រើប្រាស់ គ្រឿងចក្រ កំទេច មីន នៅក្នុង ប្រទេស កម្ពុជា នេះ មន្ត្រី ជំនាញ អ៊ីរ៉ាក់ បាន បង្ហាញ នៃ ក្ដីសប្បាយ ចិត្ត និង បាន អរគុណ ទៅដល់ ភ្នាក់ងារ កិច្ចសហប្រតិបតិ្តការអន្តរជាតិ JICA ដែល បាន រើស យកមន្ដ្រី ជំនាញ កម្ពុជា ដែល មាន សមត្ថភាព ខ្ពស់ និង ជំនាញ ច្បាស់លាស់ ក្នុង ការបណ្ដុះបណ្ដាល ទៅដល់ ពួកគាត់ ។
បន្ទាប់បញ្ចប់ វគ្គ ហ្វឹកហ្វឺត ទាំង ទ្រឹស្តី និង ការអនុវត្តន៍ នៅក្នុង ចំការមីន ពិត ៗ ហើយ នោះ សិក្ខាកាម ទាំងអស់ ត្រូវ ធ្វើ ការប្រឡង យ៉ាង យកចិត្តទុកដាក់ ដោយ មន្ត្រី អ៊ីរ៉ាក់ ទាំង២៥ រូប សុទ្ធតែ ទទួលបាន លទ្ធផល ល្អ ។ អ្វី ដែល ពិសេស នោះ មន្ត្រី អ៊ីរ៉ាក់ បាន បង្ហាញ នូវ ក្តី សប្បាយរីករាយ ក្នុង អំឡុង ពេល សិក្សា នៅ កម្ពុជា នេះ គឺ ផ្តល់ ភាគ កក់ក្តៅ ប្រៀប ដូចជា ផ្ទះ របស់ ពួកគាត់ ដូច្នេះ ដែរ ។
មន្ត្រី ជំនាញ អ៊ីរ៉ាក់ ទាំង ២៥ នាក់ ក៏ មាន ចូល ជួប សម្ដែង ការគួរសម ជាមួយ នាយ ឧត្តមសេនីយ៍ មាស សុភា ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង បាន ទៅ ទស្សនកិច្ច នៅ វិមាន ឈ្នះ ឈ្នះ ដើម្បី ស្វែងយល់ អំពី គោល នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ផងដែរ ។
( ក្រចេះ ) ៖ រដ្ឋបាល សាលា ខេត្ត ក្រចេះ នៅ ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ បាន ធ្វើ ពិធី បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៨ និង លើក ទិសដៅ អនុវត្តន៍ បន្ត ឆ្នាំ ២០១៩ ក្រោយ ពិបាន ពិភាក្សា យ៉ាង ផុសផុល អស់ រយៈពេល ២ ថ្ងៃ ក្រោម អធិបតីភាព លោក ពេជ្រ ប៊ុន ធិន រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ និង លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ ។
លោក បាន បញ្ជាក់ ទៀត ថា ការអភិវឌ្ឍ កម្មវិធី កំណែទម្រង់ ជា អាទិភាព ដែល បាន កំណត់ ក្នុង យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល សម្រាប់ នីតិកាល ទី៦ នៃ រដ្ឋសភា ដោយ ផ្អែក លើ មូលដ្ឋាន លទ្ធផល ដែល រាជ រដ្ឋាភិបាល ក៏ ដូច រដ្ឋបាល ខេត្ត សម្រេចបាន ក្នុង ឆ្នាំ ២០១៨ កន្លងមក ។
លោក ពេជ្រ ប៊ុន ធិន បន្ត ថា ក្នុង ឆ្នាំ ២០១៩ នេះ ត្រូវ បន្ត រួមគ្នា សម្រេច ឲ្យបាន នូវ ទិសដៅ ជា យុទ្ធសាស្ត្រ សំខាន់ ៗ របស់ រាជ រដ្ឋាភិបាល បន្ត ទៀត ។ លោក បាន ក្រើន រំលឹក ដល់ មន្ត្រី ថ្នាក់ដឹកនាំ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ជាន់ ថ្នាក់ ត្រូវ រួម សាមគ្គី គ្នា ក្នុង ការខិតខំ ថែរក្សា សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ សំដៅ បង្ក លក្ខណៈ សម្បត្តិ អនុគ្រោះ ដល់ ការរីកចម្រើន នៃ លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស និង ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្គម គ្រប់ វិស័យ ៕
ចោរ ឆក់ វ័យ ក្មេង យ៉ាង សកម្ម ៣នាក់ ត្រូវ អាវុធហត្ថ រាជធានី ភ្នំពេញ បញ្ជូន ទៅ តុលាការ
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ស្រាវជ្រាវ បទល្មើស ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បញ្ជូន ចោរ ឆក់ វ័យ ក្មេង យ៉ាង សកម្ម ០៣ នាក់ ទៅ តុលាការ ដើម្បី ផ្តន្ទាទោស តាម ច្បាប់ ក្នុង ចំណោម បក្សពួក ០៤ នាក់ ទៀត ដែល ម្នាក់ បាន បញ្ជូន ទៅ អង្គការ មូលនិធិ កុមារ កម្ពុជា ធ្វើ ការគ្រប់គ្រង អប់រំ វិញ ។
ពួកគេ ខាងលើ ត្រូវបាន កម្លាំង អាវុធហត្ថ មូលដ្ឋាន ខណ្ឌ មានជ័យ នៃ រាជធានី ភ្នំពេញ ធ្វើ ការឃាត់ខ្លួន បន្ទាប់ពី មាន ការប្តឹង ពី ណា អាព្យាបាល របស់ ឈ្មោះ ញ៉េ ប ពុទ្ធា ដែល ជា បក្ខពួក ក្រុម ចោរ ឆក់ យ៉ាង សកម្ម ក្នុង រាជធានី ភ្នំពេញ ។
ក្រោម វិធានការ ជំនាញ និង ចម្លើយ សារភាព នៅ ចំពោះមុខ សមត្ថកិច្ច អាវុធហត្ថ រាជធានី ភ្នំពេញ ពួកគេ ប្រាប់ ឲ្យដឹង ថា ពួកគេ តែងតែ ធ្វើ សកម្មភាព ឆក់ សម្ភារៈ ពី ប្រជាពលរដ្ឋ ដែល ធ្វើដំណើរ លើ ដង ផ្លូវ ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ យ៉ាង សកម្ម ជាញឹកញាប់ ដោយ ពួកគេ ម្នាក់ ៗ ធ្វើ សកម្មភាព ឆក់ បាន សម្រេច ០៦ ទៅ ០៧ លើក មក ហើយ រួម សម្ភារៈ ដែល ពួកគេ ឆក់ បាន មាន៖ ទូរស័ព្ទ . កាបូប លុយ . ខ្សែក និង សម្ភារៈ ជាច្រើន ផ្សេង ទៀត ។
ចំណែក ប្រាក់ និង សម្ភារៈ ដែល ពួកគេ ឆក់ បាន គឺ យក ទៅ លក់ ដើម្បី យក លុយ ទៅ ទិញ គ្រឿងញៀន ប្រើប្រាស់ ហើយនិង យក ទៅ លែង ល្បែង តាម អ៊ីនធើណែត នៅ ផ្សារ សុវណ្ណា ។ រីឯ បក្ខពួក របស់ ពួកគេ ដែល រត់គេចខ្លួន មាន ឈ្មោះ ចាន់ . ឈ្មោះ តាន់ ហៅ រាជ និង ឈ្មោះ ភ័ក្រ ។
* ឈ្មោះ សុខ សម្បត្តិ កាលពី ចុង ឆ្នាំ ២០១៨ និង ដើម ឆ្នាំ ២០១៩ ក្នុង ខែមករា . ខែកុម្ភៈ រូប គេ និង បក្សពួក ឆក់ បាន ប្រាក់ ២០ ដុល្លា អាមេរិក កាល ចុង ឆ្នាំ ២០១៨ នៅ ចំណុច រោង ការជិត ផ្សារ ប៉េសេ និង ទូរស័ព្ទ ០១ គ្រឿង នៅ ចំណុច រោង បុណ្យ ជិត ស្ពាន អាកាស ស្ទឹងមានជ័យ កាល អំឡុង ខែមករា ឆ្នាំ ២០១៩ ហើយ រូប គេ និង បក្សពួក បាន បន្ត ឆក់ ជា បន្តបន្ទាប់ ទៀត ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ បាន ប្រាក់ និង ទូរស័ព្ទ សម្រេច ជារឿយ ផងដែរ ។
ជុំវិញ បញ្ហា នេះ ដែរ អាជ្ញាធរ អាកាសចរណ៍ ស៊ីវិល ប៉ាគីស្ថាន បាន បញ្ជាក់ ថា ជើងហោះហើរ អន្តរជាតិ និង ពាណិជ្ជកម្ម នៅក្នុង ស្រុក ទាំងអស់ រួមទាំង ខាងក្រៅ ប្រទេស ប៉ាគីស្ថាន ត្រូវបាន លុបចោល រហូតដល់ មាន ការជូនដំណឹង ជាថ្មី ។ ចំណែកឯ មនុស្ស រាប់ ពាន់ នាក់ ក៏ បាន រង ផល ប៉ះពាល់ ផងដែរ តែ មិន មែន នៅក្នុង ទឹកដី ប៉ាគីស្ថាន តែ មួយ គត់ នោះ ទេ ពោលគឺ នៅ ទូទាំង ដែន អាកាស របស់ ប៉ាគីស្ថាន តែម្ដង ដែល ជា ផ្លូវ ហោះហើរ មួយ ដ៏ សំខាន់ ពី តំបន់ អាស៊ី អាគ្នេយ៍ ទៅកាន់ ទី្វប អឺរ៉ុប ។
ទោះបីជា លោក ដូណាល់ ត្រាំ ចាកចេញ មុន កាល កំណត់ ប៉ុន្មាន ម៉ោង ក្រោយ កិច្ចប្រជុំ បរាជ័យ ក៏ដោយ ក៏ លោក គីម ជុង អ៊ុន វិញ មិន ទាន់ ចេញ ទៅ ប្រទេស កំណើត វិញ ដែរ ដោយ លោក នៅ បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ វៀតណាម ជាមុន សិន តប តាម ការអញ្ជើញ ពី ប្រមុខរដ្ឋ វៀតណាម ៕
( ហាណូយ ) ៖ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន បញ្ចប់ សន្និសីទ សារព័ត៌មាន របស់ លោក ហើយ នៅ ម៉ោង ២៖ ៥៦ នាទី រសៀល ថ្ងៃពុធ នេះ បន្ទាប់ពី កិច្ចប្រជុំ កំពូល ជាមួយ មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន ក្នុង ទីក្រុង ហាណូយ ប្រទេស វៀតណាម បាន បិទ បញ្ចប់ ភ្លាម ៗ ដោយ គ្មាន កិច្ចព្រមព្រៀង អ្វី ទាំងអស់ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNN នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ។
ចាប់ខ្លួន ស្ត្រី ជនជាតិ វៀតណាម ជា មេក្លោង ជួញដូរ ថ្នាំ ញៀន ម្នាក់ និង ដកហូត ថ្នាំ ញៀន ជិត ៧គីឡូក្រាម នៅ ស្រុក ចន្ទ្រា ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ អាជ្ញាធរ កម្ពុជា សហការ ជាមួយ កងទ័ព ការពារ ព្រំដែន ប្រទេស វៀតណាម បាន ឃាត់ខ្លួន ស្ត្រី ជនជាតិ វៀតណាម ម្នាក់ ដែល ជា មេក្លោង ជួញដូរ គ្រឿងញៀន ឆ្លង ដែន ព្រមទាំង ដកហូត បាន ថ្នាំ ញៀន ជិត ៧គីឡូក្រាម ដោយ រកឃើញ ថ្នាំញៀន នៅក្នុង ទឹកដី វៀតណាម ចំនួន ៤. ៣០គីឡូក្រាម និង នៅក្នុង ទឹកដី ប្រកម្ពុជា នៅ ស្រុក ចន្ទ្រា ចំនួន ២. ០៥គីឡូក្រាម ។
បច្ចុប្បន្ន ស្នាក់ នៅ ផ្ទះ ជួល នៅ ភូមិ ចេក ឃុំ សំរោង ស្រុក ចន្រ្ទា ខេត្ត ស្វាយរៀង ដោយ រឹបអូស ថ្នាំ ញៀន ទម្ងន់ ៤.៣០ គីឡូក្រាម ហើយ ភាគី វៀតណាម បាន ស្នើ ខាង កម្ពុជា សហការ ឆែកឆេរ ផ្ទះ ជួល របស់ ជនសង្ស័យ ខាងលើ ក្នុង ទឹកដី ប្រទេស កម្ពុជា ។
សូម ជម្រាប ថា កាលពី ថ្ងៃទី ២៤ ដល់ ២៦ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន ដឹកនាំ គណៈប្រតិភូ ចូលរួម ក្នុង កិច្ចប្រជុំ ជាន់ ខ្ពស់ លើក ទី ៤០ នៃ ក្រុមប្រឹក្សា សិទ្ធិ មនុស្ស អង្គការ សហ ប្រជាជាតិ នៅ ទីក្រុង ហ្សឺណែវ ប្រទេស ស្វីស ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ៖ ក្រសួង ការងារ បើក សិក្ខាសាលា ផ្សព្វផ្សាយ ការអនុវត្ត ប្រព័ន្ធ វាយតម្លៃ ផ្អែក លើ សមត្ថភាព និង ការផ្តល់ គុណ វុឌ្ឍិ ដើម្បី មាន ឱកាស ស្វែងរក ការងារ តាម ជំនាញ
( ក្រចេះ ) ៖ អគ្គ នាយកដ្ឋាន អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ នៃ ក្រសួង ការងារ និង បណ្តុះ វិជ្ជាជីវៈ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ បាន ធ្វើ ការផ្សព្វផ្សាយ ស្តីពី ការអនុវត្ត ប្រព័ន្ធ វាយតម្លៃ ផ្អែក លើ សមត្ថភាព និង ការផ្តល់ គុណ វុឌ្ឍិ ជូន ដល់ មន្ត្រីរាជការ កម្មករ និយោជិត និង សិស្សានុសិស្ស ជាង ២០០ នាក់ ក្នុង គោលបំណង ធានា ដល់ ការអភិវឌ្ឍ ធនធាន មនុស្ស ដែល ជា តម្រូវ ការចាំបាច់ សម្រាប់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ជាតិ ទៅ ថ្ងៃ អនាគត ផងដែរ ។
ក្នុង សិក្ខាសាលា នេះ បាន ប្រព្រឹត្តិ ទៅ ក្រោម អធិបតីភាព លោក បណ្ឌិត ពេជ្រ សោភ័ណ រដ្ឋលេខាធិការ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ និង លោក ជាក់ ម៉េង ហ៊ាង អភិបាល រង ខេត្ត ក្រចេះ និង មាន ស្ថិត នៅ សណ្ឋាគារ ហ៊រ បុន្នី ក្នុង ក្រុង ក្រចេះ ។ ក្នុង សិក្ខាសាលា នេះ ក៏ នឹង ផ្តល់ ការទទួលស្គាល់ ជា ផ្លូវការ និង ការពារ គុណ វុឌ្ឍិ ដែល មាន តាមរយៈ ការសិក្សា ផ្លូវការ ការសិក្សា ក្នុង ប្រព័ន្ធ និង ការសិក្សា ក្រៅ ប្រព័ន្ធ និង ជា ការគាំទ្រ ដំណើរការទទួលស្គាល់ ជំនាញ គ្នា ទៅ វិញ ទៅមក ក្នុង អាស៊ាន ។
លោក ជាក់ ម៉េង ហ៊ាង អភិបាល រង ខេត្ត ក្រចេះ បាន សម្តែង ក្តីរីករាយ ដែល ខេត្ត ក្រចេះ ត្រូវបាន ជ្រើសរើស ជា ខេត្ត គោលដៅ របស់ កម្មវិធី អភិវឌ្ឍន៍ ជំនាញ ក្នុង ដំណាក់កាល ទី១ នេះ ហើយ ខេត្ត ក្រចេះ គឺជា ខេត្ត មួយ ស្ថិត នៅ តំបន់ ភូមិភាគ ឦសាន្ត នៃ ប្រទេស កម្ពុជា ដែល មាន សក្តានុពល នៃ ធនធាន ធម្មជាតិ ដែន ជម្រក សត្វ ព្រៃ ទន្លេ មេគង្គ ព្រៃ លិច ទឹក ពិសេស សត្វ ផ្សោត កម្រ ដែល ជា ទុន សម្រាប់ អភិវឌ្ឍន៍ ខេត្ត ផងដែរ ។
លោក បន្ថែម ថា « បរិបទ សេដ្ឋកិច្ច បច្ចេកវិទ្យា ពិភពលោក កំពុង មាន ការផ្លាស់ប្តូ យ៉ាង ខ្លាំង ដែល យើង ត្រូវ យកចិត្តទុកដាក់ ពិសេស ទាំង ប្រទេស កម្ពុជា និង បណ្តា ប្រទេស នានា ក្នុង សហគម អាស៊ាន កំពុង ផ្លាស់ប្តូរ ម្តង បន្តិច ៗ ដែល តម្រូវឲ្យ ប្រជាពលរដ្ឋ មាន ជំនាញ ច្បាស់លាស់ សម្រាប់ បម្រើ ការងារ ។ លោក បន្ថែម ទៀត ថា យើង ត្រូវតែ មាន ជំនាញ ដើម្បី បញ្ជៀសភាព ក្រីក្រ ហើយ ភាព ក្រមាន ៤យ៉ាង គឺ សង្គ្រាម . អវិជ្ជា . ផលិតភាព . និង គ្មាន ការទទួលខុសត្រូវ ។
ខាងក្រោម នេះ គឺ ការប្រៀបធៀប ត្រួស ៗ ពី កម្លាំង យោធា រវាង ប៉ាគីស្ថាន និង ឥណ្ឌា៖
* មីស៊ីល និង អាវុធ នុយក្លេអ៊ែរ
គួរ បញ្ជាក់ ថា តួលេខ ខាងលើ នេះ គឺជា ការបង្ហាញ អំពី សព្វាវុធ និង កម្លាំង ជាក់ស្តែង ដែល ប្រទេស ទាំង ពីរ នេះ មាន ប៉ុណ្ណោះ ខណៈ កត្តា ចម្បង មួយ ទៀត ដែល អាច ធ្វើឲ្យ ប្រទេស មួយ មាន ប្រៀប លើ ប្រទេស មួយ ទៀត បាន នោះ គឺ « យុទ្ធសាស្ត្រ នៃ ការធ្វើ សង្គ្រាម » ។ ទោះបីជា បែប នេះ ក្តី គ្មាន ប្រទេស ណាមួយ ចង់ឲ្យ ប្រទេស ធំ ៗ ទាំង ពីរ នេះ ផ្ទុះ សង្គ្រាម រវាង គ្នា នោះ ឡើយ ដោយ គ្រប់ គ្នា កំពុង អំពាវនាវ ឲ្យ រដ្ឋាភិបាល ញូ ដេលី និង អ៊ីស្លា ម៉ា បាដ មាន ការអត់ធ្មត់ និង ស្វែងរក កិច្ចសន្ទនា ដោះស្រាយ បញ្ហា ដោយ សន្តិវិធី ៕
អភិបាល ខណ្ឌ ច្បារអំពៅ បញ្ជា ឲ្យ មន្ដ្រី តាម ឃ្លាំមើល អ្នក ដែល យក សំរាម មក បោះចោល តាម ច្រាំង ទន្លេ ដើម្បី មាន វិធានការ វិន័យ
( ភ្នំពេញ ) ៖ លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ បាន លើកឡើង ថា កុំ ចាំ តែ អង្គុយ បក់ ផ្សែង ត្រូវ ពន្លត់ ភ្លើង នោះ ចេញ ទៅ នោះ បាន ទើប អស់ រឿង ។ លោក អភិបាល ខណ្ឌ និយាយ នេះ សំដៅ ទៅ លើ មន្រ្តី មូលដ្ឋាន សង្កាត់ ភូមិ មួយចំនួន ដែល ធ្វើការ មិន សូវ បាន ល្អ ជាពិសេស ផ្នែក អនាម័យ បរិស្ថាន នៅ តាម ច្រាំង ទន្លេ និង នៅ ចន្លោះ ស្ពាន ព្រះមុនីវង្ស ។
លោក ចេង មុនីរ៉ា បាន លើកឡើង ចំៗ ថា បច្ចុប្បន្ន បញ្ហា សំរាម នៅ ច្រាំង ទន្លេ គឺ មាន ពាក់ព័ន្ធ សង្កាត់ ចំនួន ២ គឺ សង្កាត់ ច្បារអំពៅ ទី១ និង សង្កាត់ ច្បារអំពៅ ទី២ ។ គេ តែងតែ សង្កេតឃើញ មាន ពលរដ្ឋ មួយចំនួន យក សំរាម មក ចាក់ ចោល នៅ តាម ច្រាំង ទន្ល និង នៅ ចន្លោះ គល់ ស្ពាន ព្រះមុនីវង្ស ។
លោក បាន បន្ត ថា ចាប់ពី ពេលនេះ ទៅ មន្រ្តី សង្កាត់ ទាំងអស់ ក្នុង មូលដ្ឋាន ជាពិសេស សង្កាត់ ច្បារអំពៅ ទី១ និង សង្កាត់ ច្បារអំពៅ ទី២ ត្រូវតែ ចាត់តាំង ឲ្យ មន្រ្តី ក្រោម ឱវាទ របស់ ខ្លួន អង្គុយ ឃ្លាំមើល ឲ្យបាន ជាប់ ជាប្រចាំ បើសិនជា ឃើញ ជន ណា ម្នាក់ យក សំរាម មក បោះចោល តាម ច្រាំង ទន្លេ និង នៅ ចន្លោះ គល់ ស្ពាន ព្រះមុនីវង្ស ត្រូវ ចាប់ ផាក ពិន័យ ទៅ តាម ច្បាប់ បរិស្ថាន ដែល បាន កំណត់ ។
លោក ចេង មុនីរ៉ា បាន លើកឡើង ដូច ច្នេះ ក្នុង ឱកាស អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ សាមញ្ញ លើក ទី ៥៧ របស់ ក្រុមប្រឹក្សា ខណ្ឌ ច្បារអំពៅ ដែល បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ ។
នៅក្នុង សេចក្តីណែនាំ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ស្តីពី ការគ្រប់គ្រង សំរាម សំណល់ រឹង នៅ រាជធានី ភ្នំពេញ ចុះ ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០១៩. ក្នុង ចំណុច ទី៧ យន្តការ សំរាប់ អនុវត្ត វិធានការពិន័យ អន្តរកាណ៍ ក្នុង ករណី មិន អនុវត្ត តាម ការណែនាំ ឬក៍ ប្រព្រឹត្ត ល្មើស និង ចំណុច ណាមួយ ម្ចាស់ ទីតាំង និង ក្រុមហ៊ុន ផ្តល់ សេវាកម្ម ទាំងអស់ ។
នៅក្នុង ចំនុច ១. ២ និង ៣ នៃ សេចក្តីណែនាំ នេះ នឹង ត្រូវ ទទួល ការពិន័យ អន្តរការណ៍ ដូច ខាងក្រោម៖
របាយការណ៍ ខាង លើ នេះ បាន រំលេចឡើង នៅក្នុង សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០១៨ និង លើក ទិសដៅ ការងារ បន្ត ឆ្នាំ ២០១៩ ដែល បាន ប្រព្រឹត្ត ធ្វើឡើង ពេញ១ ថ្ងៃ ក្រោម អធិបតីភាព ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ដោយ មាន ការចូលរួម ពី ស្នងការ រង នាយ នាយ រង ការិយាល័យ អធិការ - អធិការ រង នាយ - នាយ រង ប៉ុសិ៍ ត រដ្ឋបាល សរុប ២៥០ នាក់ ។
លោក អ៊ីវ ភារិទ្ធ នាយ ការិយាល័យ ប្រឆំាង បទល្មើស គ្រឿងញៀន បាន បញ្ជាក់ ថា នៅ តាម ក្លិប កំសាន្ត បារ បរទេស ខារ៉ាអូខេ និង ទីតាំង កំសាន្ត ផ្សេង ទៀត ជា កន្លែង ងាយ រងគ្រោះ ខ្លាំង ពាក់ព័ន្ធ បញ្ហា គ្រឿងញៀន ដូច្នេះហើយ ទើប ការិយាល័យ ជំនាញ និង អាជ្ញាធរ ពាក់ព័ន្ធ បាន ចុះ ទៅ ធ្វើ កិច្ចសន្យា ឲ្យ ម្ចាស់ ទីតាំង ទាំងនោះ រួម សហការ ជាមួយ សមត្ថកិច្ច ដើម្បី ទប់ស្កាត់ គ្រឿងញៀន ។
លោក បាន បន្ត ទៀត ថា សម្រាប់ ទីតាំង ទាំងនេះ ស្ថិត ក្រោម ការសង្ស័យ នៃ ការជួញដូរ ចែកចាយ និង ប្រើប្រាស់ គ្រឿងញៀន ដែល តម្រូវឲ្យ មាន វិធានការ ក្នុង ការចុះ ស៊ើបអង្កេត ស្រាវជ្រាវ បន្ត ទៀត ដោយ យើង មិន មាន ភស្តុតាង ណា មួយ អាច បញ្ជាក់ ថា ទីតាំង ទាំងនោះ មាន ការពាក់ព័ន្ធ គ្រឿងញៀន នោះ ទេ គឺ ត្រូវ រង់ចាំ ការស្រាវជ្រាវ តាម នីតិវិធី បន្ត ទៀត ។
លោក អ៊ីវ ភារិទ្ធ បាន បន្ត ទៀត ថា សកម្មភាព ដែល ភាគ ច្រើន មាន ការជួញដូរ ចែកចាយ និង ប្រើប្រាស់ គ្រឿងញៀន ភាគ ច្រើន កើតឡើង នៅ តាម សំណង់ មិន រៀបរយ ដូច ជា៖ តំបន់ បឹង ឈូក . នៅ បឹងកក់ សង្កាត់ ស្រះចក ក្នុង ខណ្ឌ ដូនពេញ តែ ក៏ មិន ជា ការលក់ដូរ ធំដុំ នោះ ទេ ភាគ ច្រើន ប្រើប្រាស់ លើ កុមារ តូច ៗ ក្មេង តូច ៗ ដែល មិន គ្រប់ អាយុ ហើយ មនុស្ស ទើប ចេញ ពី ពន្ធនាគារ បាន ធ្វើ សកម្មភាព នៅ តំបន់ មិន រៀបរយ នេះ ផងដែរ ៕
សម្តេច ស ខេង ឲ្យ អាជ្ញាធរ ដោះស្រាយ បញ្ហា ប្រឈម គ្រប់គ្រង ទឹក ពេល ជួប គ្រោះ រាំងស្ងួត ការពារ តំបន់ អភិរក្ស អប់រំ យុវជន រឿង គ្រឿងញៀន និង ជួយ កសិករ លើ ការងារ បង្កបង្កើន ផល
( បាត់ដំបង ) ៖ សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០១៨ និង លើក ទិសដៅ ការងារ សម្រាប់ អនុវត្ត ឆ្នាំ ២០១៩ របស់ រដ្ឋបាល ខេត្ត បាត់ដំបង ដែល បាន ដំណើរការ រយៈពេល ១ ថ្ងៃ កន្លះ នៅ សាល ប្រជុំ សាលា ខេត្ត បាន បិទ នា ព្រឹក ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ក្រោម អធិបតីភាព សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត បាត់ដំបង ។
នៅក្នុង កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ពី សមាជិក សមាជិកា រាជ រដ្ឋាភិបាល រដ្ឋសភា គណៈ អភិបាល ខេត្ត អភិបាល ស្រុក ក្រុង ឃុំ សង្កាត់ កងកម្លាំង ថ្នាក់ដឹកនាំ បណ្តា មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត និង មន្ត្រីរាជការ សាលា ខេត្ត តំណាង អង្គការ សមាគម សង្គម ស៊ីវិល ចូលរួម សរុប ១. ២៨១ នាក់ ។
សម្តេច បាន ថ្លែង ទៀត ថា ឆ្លង តាមរយៈ អង្គ សន្និបាត សម្តេច បាន សំណូមពរ គ្រប់ គណៈ បញ្ជាការ ឯកភាព បន្ត លុបបំបាត់ នូវ រាល់ បទល្មើស គ្រឿងញៀន គោរព ច្បាប់ ចរាចរណ៍ និង អនុវត្ត ឱ្យ ខាន តែ បាន គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ។
សម្តេច ស ខេង បាន ណែនាំ និង ផ្តាំផ្ញើ ដល់ រដ្ឋបាល ខេត្ត ស្រុក ក្រុង អាជ្ញាធរ មូលដ្ឋាន និង ស្ថាប័ន ពាក់ព័ន្ធ ក្នុង ខេត្ត ត្រូវ តាំងចិត្ត និង ខិតខំ ប្រឹងប្រែង បំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន ដោយ ផ្អែក តាម ផែនការ សកម្មភាព ការងារ ប្រចាំ ឆ្នាំ ស្រប តាម គោលការណ៍ ច្បាប់ របស់ ក្រសួង មហាផ្ទៃ ក៏ ដូចជា រាជ រដ្ឋាភិបាល ផងដែរ ។
នៅក្នុង ឱកាស នោះ សម្តេច សូមឲ្យ អាជ្ញាធរ មូលដ្ឋាន ដែល ជា មន្ត្រី ថ្នាក់ ក្រោម ជាតិ យកចិត្តទុកដាក់ ធ្វើ យ៉ាងណា ដោះស្រាយ បញ្ហា ប្រឈម នានា ដែល ប្រជាពលរដ្ឋ សំណូមពរ ថែរក្សា គ្រប់គ្រង ទឹក សម្រាប់ ជួប គ្រោះ រាំងស្ងួត ថែរក្សា ការពារ អភិរក្ស តំបន់ មួយចំនួន អប់រំ យុវជន កុំ ឲ្យ ប្រើប្រាស់ គ្រឿងញៀន ជួយ ដល់ ប្រជាកសិករ លើ ការងារ បង្កបង្កើន ផល ប្រកបដោយ គុណភាព ស្រប ទៅនឹង ទីផ្សារ ផងដែរ ។
សម្តេច ក៏ បាន ជំរុញ ឲ្យ អាជ្ញាធរ ខេត្ត រៀបចំ បរិវេណ ផ្សារ ឲ្យ មាន សណ្តាប់ធ្នាប់ មាន អនាម័យ សោភ័ណភាព មាន ទីកន្លែង ចាក់ សំរាម ឲ្យ មាន សណ្តាប់ធ្នាប់ ល្អ និង បាន បំពាក់ ឯកសណ្ឋាន និង សញ្ញា សក្តិ គ្រឿង ឥស្សរយ ស ជូន មន្ត្រីរាជការ ដែល មាន ស្នាដៃ ល្អ ផងដែរ ៕
រដ្ឋបាល ខេត្ត បាន នឹង កំពុង រៀបចំ ពហុកីឡដ្ឋាន របស់ ខ្លួន ឲ្យបាន ល្អ ស្អាត និង មាន លក្ខណៈ ស្តង ដារ ដើម្បី ជំរុញ និង លើកទឹកចិត្ត អ្នក ចូលចិត្ត និយម លេង កីឡា ។ លោក អភិបាល ខេត្ត បាន លើកឡើង ទៀត ថា វិស័យ អប់រំ កីឡា ក្នុង ខេត្ត កំពត មាន ការរីកចម្រើន គួរឲ្យ កត់សំគាល់ ដោយសារ មហាជន យុវវ័យ សិស្សានុសិស្ស ភាគ ច្រើន ស្រលាញ់ និង ចូលរួម លេង កីឡា យ៉ាង ផុល ផុស ។
លោក ថា « គ្រាប់ ពូជ កីឡា ដែល ដុះ ចេញ ពី ខេត្ត មួយ នេះ មាន ច្រើន ហើយ ល្បីល្បាញ តួយ៉ាង ដូចជា តារា បាល់ទាត់ ច័ន្ទ វឌ្ឍនាកា ជាដើម ហើយ ដើម្បី លើកទឹកចិត្ត និង លើកស្ទួយ វិស័យ អប់រំ កីឡា នេះ ឲ្យ ផុល ផុស ឡើង តាម លក្ខណៈ ស្តង់ដា អន្តរជាតិ » ។
លោក អភិបាល ខេត្ត បញ្ជាក់ ថា យោង តាម ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន កម្ពុជា នឹង ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ ការប្រកួត កីឡា អាស៊ី អាគ្នេយ៍ ២០២៣ (Sea Game 2023) ហើយ ដើម្បី ជំរុញ លើកទឹកចិត្ត ដល់ អ្នកស្រឡាញ់ ចូលចិត្ត លែង កីឡា និង ដើម្បី បណ្តុះបណ្តាល កីឡា ល្អ ៗ ផង នោះ រដ្ឋបាល ខេត្ត បាន នឹង កំពុង រៀបចំ កែលំអរ ពហុកីឡដ្ឋាន ឲ្យ ល្អ ស្អាត ស្រប តាម លក្ខណៈ ស្តង់ដារ ក្នុង នោះ ខេត្ត នឹង រៀបចំ ឲ្យ មាន ជា កៅអ៊ី សម្រាប់ អង្គុយ ទស្សនា យ៉ាងហោចណាស់ ឲ្យបាន ១៥០០កី អី ។
ក្រសួង ទេសចរណ៍ នឹង រៀបចំ ប្រឡង រើស អ្នក និយាយ ភាសា ចិន ឆ្នើម ឆ្នាំ ២០១៩ ផ្នែក សណ្ឋាគារ ចាប់ពី ខែមេសា - ឧសភា
( ភ្នំពេញ ) ៖ ដើម្បី ចូលរួម ជំរុញ យុទ្ធនាការ ផ្សព្វផ្សាយ « កម្ពុជា៖ ព្រះរាជាណាចក្រ អច្ឆរិយៈ ផ្ដល់ ភាពកក់ក្ដៅ » និង ដើម្បី ត្រៀម ទទួល ភ្ញៀវ ទេសចរ ចិន ដែល កំពុង មាន ការកើនឡើង រៀងរាល់ ឆ្នាំ ក្រសួង ទេសចរណ៍ នឹង រៀបចំ ការប្រឡង ជ្រើសរើស អ្នក និយាយ ភាសា ចិន ឆ្នើម ផ្នែក សណ្ឋាគារ ប្រចាំ ឆ្នាំ ២០១៩ ដែល នឹង ប្រព្រឹត្តទៅ ចាប់ពី ខែមេសា - ខែឧសភា ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ លម្អិត នៅក្នុង សេចក្ដីជូនដំណឹង របស់ ក្រសួង ទេសចរ ណ៍៖ លោក គីម ជុង អ៊ុន ឆ្លើយតប សំនួរ អ្នកកាសែត ម្នាក់៖ « បើ ខ្ញុំ មិន ចង់ រំសាយ អាវុធ នុយក្លេអ៊ែរ ខ្ញុំ មិន បាច់ មកកាន់ ទីនេះ ទេ »
( ហាណូយ ) ៖ មេដឹកនាំ កំពូល កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន បាន បង្ហាញ ឆន្ទៈ ក្នុង ការរំសាយ អាវុធ នុយក្លេអ៊ែរ ជាមួយ ការបញ្ជាក់ ថា បើសិនជា គ្មាន បំណង លុប បាត់ អាវុធ នុយក្លេអ៊ែរ នៅលើ ឧបទ្វីប កូរ៉េ ទេ ច្បាស់ ណាស់ លោក នឹង មិន មក ចូលរួម កិច្ចប្រជុំ កំពូល ក្នុង ទីក្រុង ហាណូយ ប្រទេស វៀតណាម ជាមួយ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ នោះ ទេ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNN នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ។
លោក គីម ជុង អ៊ុន ធ្វើការកត់សម្គាល់ បែប នេះ នៅ អំឡុង សន្និសីទ សារព័ត៌មាន ខ្លី មួយ មុននឹង ចូលរួម ជំនួប ជាមួយ លោក ត្រាំ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ នេះ និង ជា ការឆ្លើយតប ទៅនឹង អ្នកសារព័ត៌មាន ម្នាក់ ដែល បាន សួរ ថា តើ លោក មាន បំណង រំសាយ អាវុធ នុយក្លេអ៊ែរ ទាំងស្រុង ដែរ ឬ ទេ ? លោក គីម បាន បញ្ជាក់ នា ឱកាស នោះ យ៉ាង ដូច្នេះ ថា « បើ ខ្ញុំ មិន ចង់ រំសាយ អាវុធ នុយក្លេអ៊ែរ ខ្ញុំ មិន បាច់ មកកាន់ ទីនេះ ទេ » ។
គួរ បញ្ជាក់ ថា ជំនួប កំពូល រវាង លោក ដូណាល់ ត្រាំ និង លោក គីម ជុង អ៊ុន នឹង ត្រូវ បញ្ចប់ ថៃ្ង ព្រហស្បតិ៍ នេះ ហើយ មេដឹកនាំ ទាំង ពីរ ត្រូវបាន គេ រំពឹង ថា នឹង ធ្វើ សន្និសីទ ព័ត៌មាន រួមគ្នា មួយ នៅ ម៉ោង ៣៖ ៥០នាទី រសៀល នេះ ផងដែរ ខណៈ ព្រឹក ថ្ងៃព្រហស្បតិ៍ នេះ គឺ កិច្ចប្រជុំ កំពុងតែ បន្ត នៅឡើយ ក្នុង សណ្ឋាគារ នៃ ទីក្រុង ហាណូយ ៕
រដ្ឋមន្ត្រី អ៉ិត សំហេង៖ រាជ រដ្ឋាភិបាល យកចិត្តទុកដាក់ ឲ្យ ស្ត្រី ក្លាយជា កម្លាំង ចលករ ចូលរួម អភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច
( ភ្នំពេញ ) ៖ ក្នុង ពិធី អបអរសាទរ ខួប លើក ទី ១០៨ នៃ ទិវា អន្តរជាតិ នារី ៨មីនា លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ផ្តល់ ការយកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ក្នុង ការលើកកម្ពស់ សមភាព យេនឌ័រ និង ពង្រឹង ភាពអង់អាច ដល់ ស្រ្តី និង ក្មេងស្រី ដើម្បីឱ្យ ពួកគេ ក្លាយជា កម្លាំង ចលករ ចូលរួម ក្នុង កិច្ចអភិវឌ្ឍ សង្គម និង សេដ្ឋកិច្ច ។
គួរ ជម្រាប ថា ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨មីនា ត្រូវបាន ប្រារព្ធ ឡើង ជារៀងរាល់ ឆ្នាំ ដើម្បី រំលឹក អំពី វីរភាព នៃ ការតស៊ូ របស់ នារី ទូទាំង សកលលោក ក្នុង ការទាមទារ ឱ្យ មាន ការលើកកម្ពស់ សិទ្ធិ សេរីភាព ប្រជាធិបតេយ្យ និង ការអនុវត្ត សិទ្ធិ ស្មើគ្នា រវាង បុរស និង ស្រ្តី នៅក្នុង សង្គម ។
នៅ កម្ពុជា ទិវា អន្តរជាតិ នារី ៨មីនា ក្នុង ឆ្នាំ ២០១៩ នេះ ត្រូវបាន ធ្វើឡើង ក្រោម ប្រធានបទ « លើកកម្ពស់ សមភាព យេនឌ័រ និង ការគាំពារ សង្គម ដើម្បី អភិវឌ្ឍ ធនធាន មនុស្ស » ។ សម្រាប់ ក្រសួង ការងារ ពិធី អបអរសាទរ ខួប លើក ទី ១០៨ នៃ ទិវា អន្តរជាតិ នារី នេះ ត្រូវបាន ប្រារព្ធ ឡើង ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នៅ ទីស្តីការ ក្រសួង តែម្ដង ។
ក្នុង ពិធី នោះ លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « រាជ រដ្ឋាភិបាល កម្ពុជា បាន ផ្តល់ ការយកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ក្នុង ការលើកកម្ពស់ សមភាព យេនឌ័រ និង ពង្រឹង ភាពអង់អាច ដល់ ស្រ្តី និង ក្មេងស្រី ដើម្បីឱ្យ ពួកគេ ក្លាយជា កម្លាំង ចលករ មួយ ចូលរួម ក្នុង កិច្ចអភិវឌ្ឍ សង្គម និង សេដ្ឋកិច្ច » ។
លោក ថា គោលដៅ ជា យុទ្ធសាស្រ្ត របស់ រាជ រដ្ឋាភិបាល គឺ ការពង្រឹង សមភាព យេនឌ័រ និង ការគាំពារ សង្គម ដើម្បី លើកស្ទួយ ស្ថានភាព សង្គម - សេដ្ឋកិច្ច និង ពង្រឹង តួនាទី ស្រ្តី ដែល ជា ឆ្អឹង ខ្នង នៃ សេដ្ឋកិច្ច និង សង្គមជាតិ ។
រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ឆ្នាំ ២០១៦ - ២០២៥ ដែល មាន លក្ខណៈ ទូលំទូលាយ ដោយ ផ្តោត លើស សរ ស្តម្ភ ពីរ គឺ ប្រព័ន្ធ ជំនួយ សង្គម និង ប្រព័ន្ធ សន្តិសុខ សង្គម ។
ក្របខណ្ឌ គោល នយោបាយ នេះ នឹង ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការបង្កើន លទ្ធភាព ទទួលបាន សេវា ជំនួយ សង្គម និង សន្តិសុខ សង្គម ដែល ជា ការគិតគូរ ចំពោះ ស្រ្តី មាន ជាឤទិ៍ ៖
ទី១៖ កម្ម ការិនី សម្រាល កូន បាន ទទួល ប្រាក់ ឈ្នួល ចំនួន ១២០ % ចំនួន ៣ខែ ។ ចាប់ពី ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០១៨ រាជ រដ្ឋាភិបាល បាន អនុវត្ត កម្មវិធី ផ្តល់ ប្រាក់ ឧបត្ថម្ភ ដល់ កម្មការ នី សម្រាល កូន ដោយ ផ្តល់ ជូន កូន មួយ នាក់ ចំនួន ៤០ ម៉ឺន រៀល ចំពោះ កូន ភ្លោះ ទទួលបាន ៨០ ម៉ឺន រៀល និង កូន ភ្លោះ បី បាន ១លាន ២សែន រៀល ព្រមទាំង ទទួលបាន ថវិកា បន្ថែម ចំនួន ៥លាន រៀល ពី សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ផ្ទាល់ ។
ទី៣ ការអនុញ្ញាតឱ្យ កម្ម ការិនី ជា ស្រ្តី ដែល មាន ផ្ទៃពោះ ចេញមុន ម៉ោង យ៉ាងតិច ១៥នាទី ។ លើស ពី នេះ ទៀត គ្រប់ រោងចក្រ ទាំងអស់ ត្រូវ រៀបចំ បន្ទប់ បំបៅ កូន សម្រាប់ កម្មការ នី ដែល មាន កូន អាយុ ក្រោម ១២ខែ និង ត្រូវ មាន ទារកដ្ឋាន សម្រាប់ កម្មការ នី ដែល មាន កូន អាយុ លើស ពី ១៨ ខែ ។ គ្រប់ តំបន់ សេដ្ឋកិច្ច ពិសេស ឬ សួន ឧស្សាហកម្ម ត្រូវ រៀបចំ ឱ្យ មាន ទារកដ្ឋាន មួយ នៅក្នុង តំបន់ របស់ ខ្លួន ។
ទី ៤៖ ទន្ទឹមនឹង នេះ គ្រប់ រោងចក្រ ទាំងអស់ បាន អនុញ្ញាតឱ្យ កម្មករ និយោជិត ជា ស្រ្តី ខ្មែរ ឥស្លាម អាច ប្រើប្រាស់ សម្លៀកបំពាក់ តាម បែប ប្រពៃណី ឥស្លាម ។
ទី ៥៖ រាជ រដ្ឋាភិបាល ប្រកាស ផ្តល់ ជូន ប្រាក់ ឧបត្ថម្ភ ដល់ ស្ត្រី ជា មន្រ្តី រាជការ ស៊ីវិល នគរបាល និង កងកម្លាំងប្រដាប់ ឤវុធ ដែល បាន សម្រាល កូន ក្នុង នោះ កូន មួយ ទទួលបាន ៨០ ម៉ឺន រៀល កូន ភ្លោះ ទទួលបាន ១លាន ៦០ ម៉ឺន រៀល កូន ភ្លោះ ៣ ទទួលបាន ២លាន ៤០ ម៉ឺន រៀល រួម ជាមួយនឹង ការឈប់ សម្រាក លំហែ រ មាតុភាព រយៈពេល ៣ខែ ជាមួយ ប្រាក់ បៀវត្ស ១០០ % ។
ទាំងអស់ នេះ បាន បង្ហាញ ច្បាស់ ថា រាជ រដ្ឋាភិបាល តែង បាន យកចិត្តទុកដាក់ ខ្ពស់ ចំញេះ ស្ត្រី ដោយ ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ស្ត្រី តែង ទទួលបាន នូវ ផលប្រយោជន៍ ផ្ទាល់ ខួន ច្រើន និង កាត់បន្ថយ បន្ទុក គ្រួសារ កាន់តែ ច្រើន ដែល ជា ការលើកកម្ពស់ ដល់ សមភាព យេនឌ័រ កាន់តែ ប្រសើរឡើង នៅ គ្រប់ វិស័យ នៅ កម្ពុជា ៕ ក្រសួង ការងារ សហការ ជាមួយ Swisscontact បើក សិក្ខាសាលា ផ្សព្វផ្សាយ « ការអនុវត្ត ប្រព័ន្ធ វាយតម្លៃ ផ្អែក លើ សមត្ថភាព និង ការផ្តល់ គុណ វុឌ្ឍិ»
នៅក្នុង ពិធី នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក គោ ស៊ុប៊ុន សឿត អភិបាល រង ខេត្ត ព្រះវិហារ រួម នឹង ថ្នាក់ដឹកនាំ ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត និង អង្គការ ជាតិ អន្តរជាតិ ផងដែរ ។
លោក ពេជ្រ សោភ័ន បាន ឱ្យដឹង ថា ការបើក ដំណើរការសិក្ខាសាលា ផ្សព្វផ្សាយ ស្តីពីរ « ការអនុវត្ត ប្រពន្ធ វាយតម្លៃ ផ្អែក លើ សមត្ថភាព និង ការផ្តល់ គុណ វុឌ្ឍិ» គឺ ក្រោម ការរៀបចំ របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ជាមួយ និង SDP-SWisscontact ។ គោល នយោបាយ ជាតិ អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស វិជ្ជាជីវៈ បាន អនុម ត័ដោយ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៧ ។
លោក ពេជ្រ សោភ័ន បាន គូសបញ្ជាក់ ថា ដើម្បី អនុវត្ត គម្រោង ខាងលើ ឱ្យ មាន ប្រសិទ្ធិភាព ឆ្លើយតប ទៅនឹង គោល នយោបាយ ជាតិ ស្តីពី « ការអប់រំ បណ្តុះបណ្តាល បច្ចេកទេស វិជ្ជាជីវៈ ឆ្នាំ ២០១៧ ដល់ ឆ្នាំ ២០២៥ SWisscontact ស្នើរ សុំ ចុះ កិច្ចព្រមព្រៀង សហការ ជាមួយ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ស្តីពី ការទទួលស្គាល់ ការសិក្សា ដែល មាន ពីមុន និង ការបណ្តុះបណ្តាល ឆ្លាស់ ដែល មាន អគ្គ នាយកដ្ឋាន បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ ជា អង្គភាព អនុវត្ត ៕
( ព្រះសីហនុ) ៖ វីឡា លំហែ កាយ ឆ្នេរ ប្រាក់ បាន បើក ការដ្ឋាន សាងសង់ គំរោង វីឡា ទោល និង ដីឡូតិ៍ គម្រោង ទី ១ រួចរាល់ ហើយ កាលពី ព្រឹក ថ្ងៃទី ២៦ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ដោយ ទទួលបាន ការគាំទ្រ និង ទំនុក ខ្ពស់ ពី អតិថិជន គ្រប់ មជ្ឈដ្ឋាន ។
