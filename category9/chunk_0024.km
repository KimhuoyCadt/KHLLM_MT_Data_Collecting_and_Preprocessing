( សេអ៊ូល ) ៖ យន្តហោះ ចម្បាំង មួយ គ្រឿង របស់ កងទ័ព អាកាស កូរ៉េ ខាងត្បូង បាន ធ្លាក់ ចូល ទៅក្នុង ដែន សមុទ្រ ភាគ ខាងលិច ប្រទេស តែ សំណាង ល្អ ណាស់ ដែល អាកាសយានិក ដែល បញ្ជា លើ នោះ ទាំង ពីរ រូប បាន ចុច ឆ័ត្រ យោង លោត ចេញ ដោយ សុវត្ថិភាព ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ល្ងាច ថ្ងៃពុធ ទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ។
យន្តហោះ ចម្បាំង ធុន KF-16D ដែល ផ្ទុក អ្នកបើកបរ ០២ នាក់ របស់ កងទ័ព អាកាស កូរ៉េ ខាងត្បូង បាន ធ្លាក់ ទៅក្នុង ផ្ទៃ សមុទ្រ ភាគ ខាងលិច ប្រទេស កូរ៉េ ខាងត្បូង នា វេលា ថ្ងៃត្រង់ ថ្ងៃពុធ នេះ ក្រោយពី ហោះ ចាកចេញ ពី បន្ទាយ ទ័ព អាកាស មួយ កន្លែង នៅ ទីក្រុង កាន់ សាន (Gunsan) ដែល ស្ថិត នៅ ចម្ងាយ ប្រហែល ២៧០ គីឡូម៉ែត្រ ភាគ ខាងត្បូង រដ្ឋធានី សេអ៊ូល ដើម្បី ធ្វើ ការហោះហើរ ជា លក្ខណៈ ហ្វឹកហ្វឺន ។
គួរ ជម្រាប ថា មូលហេតុ ពិតប្រាកដ ដែល បង្កឲ្យ មាន គ្រោះថ្នាក់ ធ្លាក់ យន្តហោះ នេះ ពុំ ទាន់ ត្រូវបាន កំណត់ ច្បាស់ នៅឡើយ ទេ ប៉ុន្តែ អាកាសយានិក ទាំង ០២ នាក់ បាន ចុច កៅអី បាញ់ លោត ចេញពី យន្តហោះ ទាន់ និង ពុំ បាន ទទួលរង របួស អ្វី ឡើយ ៕
រដ្ឋមន្ត្រី វង សូត៖ អង្គការ របស់ ជប៉ុន មួយ សន្យា ជួយ សាងសង់ អគារ សិក្សា ដល់ សាលា បឋមសិក្សា ចំនួន ២ នៅ ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត ស្វាយរៀង
( ហាណូយ ) ៖ លោក ដូណាល់ ត្រាំ និង លោក គីម ជុង អ៊ុន កំពុង ស្ថិត ក្នុង ប្រទេស វៀតណាម ដើម្បី ត្រៀម ចូលរួម កិច្ចប្រជុំ កំពូល ជា លើក ទី ពីរ ប៉ុន្តែ មេដឹកនាំ ទាំង ពីរ មិន មែន ធ្វើដំណើរ មក តែ ឯង នោះ ឡើយ ។ រាល់ មេដឹកនាំ ពិភពលោក ដែល មក ចូលរួម កិច្ចប្រជុំ បែប នេះ សុទ្ធតែ មាន ប្រតិភូ អម មក ជាមួយ ប៉ុន្តែ សំណួរ ទាក់ទង រឿង ថា តើ បុគ្គល ណា ខ្លះ មក ជាមួយ គឺ កាន់តែ គួរឲ្យ ចាប់អារម្មណ៍ ខ្លាំង ថែម ទៀត សម្រាប់ ថ្នាក់ដឹកនាំ ដូចជា ប្រទេស កូរ៉េ ខាងជើង ។
ខណៈ ពិភព ខាងក្រៅ ពិបាក នឹង ដឹង រឿង ផ្ទៃក្នុង នៃ ប្រទេស កុម្មុយនិស្ត ដូចជា កូរ៉េ ខាងជើង នេះ ក៏ដោយ ក្តី រូបភាព នេះ បាន ឆ្លុះបញ្ចាំង យ៉ាង ច្បាស់ ថា អ្នកនាង គីម យ៉ូ ចុង មិន មែន គ្រាន់តែ ជា បុគ្គល ធម្មតា ៗ សម្រាប់ កាន់ ចាន គោះ បារី ឲ្យ លោក គីម ឡើយ ពោលគឺ អ្នកនាង ត្រូវ អ្នកវិភាគ អន្តរជាតិ ចាត់ទុក ថា ជា បុគ្គល ដែល ពោរពេញ ដោយ ឥទ្ធិពល ម្នាក់ ។
ជា ការពិត ណាស់ ព័ត៌មាន លម្អិត ទាក់ទិន នឹង អ្នកនាង គឺ ពិបាក នឹង ស្វែងរក ខ្លាំង ណាស់ មិន ខុសពី សមាជិក ដទៃ ៗ ទៀត នៃ គ្រួសារ របស់ អ្នកនាង ឡើយ ។ យោង តាម ក្រសួង ហិរញ្ញវត្ថុ អាមេរិក អ្នកនាង យ៉ូ ចុង ប្រហែល ស្ថិត ក្នុង វ័យ ខ្ទង់ ៣០ ឆ្នាំ ខណៈ ព័ត៌មាន នេះ ត្រូវបាន គេ ដឹង ជាសាធារណៈ នៅ ពេល ដែល ក្រសួង ហិរញ្ញវត្ថុ អាមេរិក បាន កត់ ឈ្មោះ អ្នកនាង ចូលក្នុង បញ្ជី ទណ្ឌកម្ម របស់ ខ្លួន កាលពី ខែមករា ឆ្នាំ ២០១៧ ។
កាល នោះ ក្រសួង ហិរញ្ញវត្ថុ អាមេរិក បាន ចុះឈ្មោះ អ្នកនាង ជា អនុប្រធាន នៃ នាយកដ្ឋាន ឃោសនា ការ នៃ គណបក្ស កាន់អំណាច របស់ កូរ៉េ ខាងជើង ដែល វា គឺជា តំណែង ជាន់ ខ្ពស់ មួយ ។ អ្នកនាង យ៉ូ ចុង មាន តួនាទី ដ៏ សំខាន់ មួយ នៅក្នុង វិស័យ ឃោសនា ព័ត៌មាន រដ្ឋ នៃ ប្រទេស កូរ៉េ ខាងជើង ។
ប្រភព ព័ត៌មាន៖ វែប សាយ ព័ត៌មាន និង វិភាគ Bustle ថ្ងៃ ដកស្រង់៖ ថ្ងៃពុធ ទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០១៩ មន្ត្រី ធនាគារ ជាតិ នៃ កម្ពុជា ប្រកាស ឲ្យ ពលរដ្ឋ ផ្ដល់ ដំណឹង ជាបន្ទាន់ ប្រសិនបើ ប្រទះឃើញ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ យក ការប្រាក់ លើស ១៨ %
( ព្រៃវែង ) ៖ លោក គិត សុវណ្ណា រិទ្ធ អគ្គ នាយក រង និង ជា ប្រធាន នាយកដ្ឋាន ត្រួតពិនិត្យ ដល់ ទីកន្លែង ធនាគារ ជាតិ នៃ កម្ពុជា បាន ប្រកាស ឲ្យ ពលរដ្ឋ និង អាជ្ញាធរ ទូទាំង ស្រុក ស្វាយអន្ទរ ខេត្ត ព្រៃវែង ទាំងអស់ សូម រាយការណ៍ ជាបន្ទាន់ មក ធនាគារ ជាតិ នៃ កម្ពុជា ប្រសិនបើ ប្រទះឃើញ ស្ថាប័ន ឬ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ណាមួយ ដែល យក ការប្រាក់ ពី ពលរដ្ឋ កម្ពុជា លើស ទី១៨ ភាគរយ ក្នុង មួយ ឆ្នាំ ។
ការអំពាវនាវ របស់ លោក គិត សុវណ្ណា រិទ្ធ ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៦ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ក្នុង សិក្ខាសាលា ផ្សព្វផ្សាយ ស្ដីពី « វិស័យ ហិរញ្ញវត្ថុ នៅ កម្ពុជា » ជូន មន្ត្រី អាជ្ញាធរ ចាប់ពី ថ្នាក់ ភូមិ ដល់ ថ្នាក់ ស្រុក ជិត ៥០០ នាក់ ទូទាំង ស្រុក ស្វាយអន្ទរ ។
ការអំពាវនាវ នេះ ជា ការឆ្លើយតប ទៅនឹង កង្វល់ របស់ លោក ប៉ិច សុង អភិបាល ស្រុក ក៏ ដូច សិក្ខាកាម ដែល បាន លើកឡើង ពី បញ្ហា ប្រឈម មួយ ចំនួន ដើម្បី ស្វែងរក ការអន្តរាគមន៍ និង ដំណោះស្រាយ ។
លោក គិត សុវណ្ណា រិទ្ធ បន្ត ថា ដើម្បី បញ្ជៀស បំណុល វ័ណ្ឌក ពី ការប្រាក់ កម្ចី អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ បន្ត ផ្សព្វផ្សាយ និង អប់រំ ពលរដ្ឋ ឲ្យ យល់ដឹង អំពី ច្បាប់ នៃ ការខ្ចី ប្រាក់ការប្រើប្រាស់ ប្រាក់ កម្ចី ឲ្យ ចំ គោលដៅ និង កាតព្វកិច្ច សង ប្រាក់ ។
លោក បន្ដ ថា ទន្ទឹមនឹង នេះ ត្រូវ សកម្ម ចូលរួម ទប់ស្កាត់ កុំ ឲ្យ ប្រជាពលរដ្ឋ ចាញ់បោក ជន ខិលខូច ឃោសនា ។ ដោយឡែក ចំពោះ គ្រឹះស្ថាន ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ ត្រូវ កំណត់ គោល នយោបាយ ឲ្យ ច្បាស់លាស់ និង ដាក់ ចេញ វិធានការ ចំពោះ មន្ត្រី និង បុគ្គលិក រូប ណា ដែល មិន គោលរព តាម បទបញ្ជា ដែល នាំឲ្យ ប៉ះពាល់ ដល់ ប្រតិបត្តិការ ខ្លួន ។
លោក គិត សុវណ្ណា រិទ្ធ បញ្ជាក់ « ដើម្បី កុំ ឲ្យ មាន ការយល់ ច្រលំ ដូច រយៈពេល កន្លងមក អាជ្ញាធរ គួរ បញ្ឈប់ សកម្មភាព សហការ ជាមួយ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ និង ប្រតិបត្តិការ ឥណទាន ជនបទ នានា ក្នុង ការដើរ ទារ ឬ ប្រមូល ប្រាក់ ពី ប្រជាពលរដ្ឋ ដែល នាំឲ្យ មាន ការយល់ច្រលំ ថា គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ឬ ប្រតិបត្តិការ ឥណទាន ជនបទ ទាំងនោះ ជា របស់ រដ្ឋ តទៅទៀត » ។
លោក បន្ថែម ថា ទោះបីជា វិស័យ នេះ ជួប បញ្ហា ប្រឈម ខ្លះ ៗ ប៉ុន្ដែ វិស័យ នេះ បាន រួមចំណែក លើកស្ទួយ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ និង សេដ្ឋកិច្ច ជាតិ ។
អ្នកលក់ ឆ្នើម ចំនួន ៣៥ នាក់ ទទួលបាន រង្វាន់ លើកទឹកចិត្ត ពី ក្រុមហ៊ុន ជី ប ម៉ុង អ៊ិន ស៊ី ស៊ី មេន
រង្វាន់ ផ្ដល់ជូន អ្នកលក់ ឆ្នើម ទាំង ៣៥ នាក់ នេះ គឺ ក្នុង ម្នាក់ ៗ ទទួលបាន ម៉ូតូ ហុង ដាស៊េរី ឆ្នាំ ២០១៩ ចំនួន ១ គ្រឿង ។ នេះ ជា ការលើកទឹកចិត្ត ដល់ អ្នកលក់ ឆ្នើម ដែល បាន ខិតខំ ប្រឹងប្រែង លក់ លើស កម្រិត កំណត់ របស់ ក្រុមហ៊ុន ។
លោក ឆុង យឿប ប្រធាន ផ្នែក លក់ នៃ ក្រុមហ៊ុន ជី ប ម៉ុង អ៊ីន ស៊ី ឲ្យដឹង ថា នេះ ជា ផ្នែក មួយ របស់ ក្រុមហ៊ុន ជី ប ម៉ុង អ៊ិន ស៊ី ដើម្បី ឆ្លើយតប នឹង កិច្ច ខិតខំ ប្រឹងប្រែង និង លើកទឹកចិត្ត ដល់ ដៃគូ ព្រមទាំង បណ្ដាញ ចែកចាយ របស់ ខ្លួន នៅ កម្ពុជា ។
លោក ឆុង យឿប បញ្ជាក់ ថា « ក្រុមហ៊ុន ពិតជា មាន ក្ដីសប្បាយរីករាយ ខ្លាំង ដែល មាន ដៃគូ ពោល ពេញ ដោយ សមត្ថភាព មួយ វិញទៀត ក្រុមហ៊ុន ពិតជា មាន ទំនុកចិត្ត ថា ពួកយើង នឹង បន្ត ដំណើរ ទៅ មុខ ទៀត កាន់តែ ប្រសើរ » ។
រោងចក្រ CMIC អាច មាន លទ្ធភាព ផលិត ស៊ីម៉ងត៍ រហូតដល់ ៦.០០០ តោន ក្នុង មួយ ថ្ងៃ ។ ក្រុមហ៊ុន បាន ចាត់ទុក ស៊ីម៉ងត៍ អូដ្ឋ ជា ផលិតផល សំខាន់ សម្រាប់ ផ្គត់ផ្គង់ លើ ទីផ្សារ ដោយ ត្រូវបាន បែងចែក ជា២ ប្រភេទ គឺ៖
១៖ ស៊ីម៉ងត៍ អូដ្ឋ ពណ៌ ទឹកក្រូ ច៖ ផ្ដោត លើ គុណភាព ល្អ ស័ក្ដិសម សម្រាប់ សំណង់ រឹងមាំ ល្អ ក៏ ដូចជា ការប្រើប្រាស់ ក្នុង គោលបំណង ទូទៅ ។ ២៖ ស៊ីម៉ងត៍ អូដ្ឋ ពណ៌ បៃត ង៖ មាន គុណភាព ពិសេស និង ល្អ បំផុត សម្រាប់ ការងារ បូក ៕
អភិបាល ខេត្ត ក្រចេះ ស្នើ ដល់ មន្រ្តី ទាំងអស់ ត្រូវ ខិតខំ ចូលរួម ពិភាក្សា ឲ្យបាន ផុសផុល អំពី សមិទ្ធិផល បញ្ហា ប្រឈម និង ដំណោះស្រាយ សម្រាប់ អនុវត្ត ទិសដៅ ការងារ ឆ្នាំ ២០១៩
( ក្រចេះ ) ៖ រដ្ឋបាល សាលា ខេត្ត ក្រចេះ នៅ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ បាន រៀបចំ បើក អង្គ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៨ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០១៩ នៅ សាល មហោស្រប ខេត្ត ក្រចេះ ក្រោម អធិបតីភាព លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ លោក នូ ភឿង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ព្រមទាំង អភិបាល រង ខេត្ត ស្រុក ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ព្រមទាំង កងកម្លាំង ទាំង បី ប្រភេទ ។
លោក វ៉ា ថន អភិបាល ខេត្ត បាន កោតសរសើរ និង វាយតម្លៃ ចំពោះ ពលិកម្ម និង ការខិតខំ ចូលរួម ប្រឹងប្រែង យ៉ាង សកម្ម ពុះពារ សម្រេចបាន លទ្ធផល នានា ជាច្រើន ក្នុង រយៈពេល កន្លងទៅ នេះ ។
លោក បន្ត ទៀត ថា ឆ្នាំ ២០១៨ កន្លងទៅ ជា ឆ្នាំ ចុងក្រោយ នៃ ការអនុវត្ត កម្មវិធី កំណែទម្រង់ ដែល បាន កំណត់ ក្នុង យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៣ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៥ នៃ រដ្ឋសភា ហើយក៏ ជា ឆ្នាំ ចាប់ផ្ដើម របស់ រដ្ឋាភិបាល សម្រាប់ នីតិកាល ទី៦ ផងដែរ ។
សន្និបាត នា ពេលនេះ ពិតជា មាន អត្ថន័យ និង ពិតជា មាន សារៈសំខាន់ សម្រាប់ ទាំងអស់ គ្នា ធ្វើ ការវាយតម្លៃ អំពី លទ្ធផល ការងារ ដែល សម្រេចបាន និង រួមគ្នា ធ្វើ ការពិនិត្យ វាយតម្លៃ អំពី បញ្ហា ប្រឈម ដែល នៅសល់ សម្រាប់ ជា មូលដ្ឋាន ក្នុង ការកំណត់ ទិសដៅ ការងារ សម្រាប់ អនុវត្ត កម្មវិធី កំណែទម្រង់ នានា ក្នុង ក្របខ័ណ្ឌ យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ថែម ទៀត ។
តាមរយៈ អង្គ សន្និបាត និង ធ្វើ ការបែងចែក ក្រុម ពិភាក្សា លើ ប្រធានបទ សំខាន់ ៗ ដើម្បី ប្រមូល ធាតុ ចូល ពី សមាជិក នៃ អង្គ សន្និបាត ទៅ លើ របាយការណ៍ និង ទិសដៅ ព្រមទាំង គោលការណ៍ សំខាន់ ៗ សម្រាប់ អនុវត្ត ក្នុង ឆ្នាំ ២០១៩ នេះ បន្ត ទៀត ។
ទន្ទឹមនឹង សមិទ្ធផល សំខាន់ ៗ ដែល ខេត្ត សម្រេចបាន នា ពេល កន្លងមក លោក បាន គូសបញ្ជាក់ ថា ខេត្ត ក៏ នៅ ជួបប្រទះ បញ្ហា ប្រឈម នានា ជាច្រើន ក្នុង ក្របខ័ណ្ឌ នៃ តួនាទី និង ការទទួលខុសត្រូវ របស់ រដ្ឋបាល ខេត្ត ជាពិសេស បញ្ហា ប្រឈម ពាក់ព័ន្ធ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ បញ្ហា កែទម្រង់ ស្ថាប័ន ក្នុង នោះ ការអភិវឌ្ឍន៍ មត្ថភាព ធនធាន មនុស្ស ការចុះបញ្ជី ដីធ្លី ការគ្រប់គ្រង ដី ចំណី ផ្លូវ បញ្ហា ទឹក ស្អាត អគ្គិសនី ក៏ នៅ មាន បញ្ហា ប្រឈម ជាច្រើន ដែល ត្រូវ ដោះស្រាយ ។
ជា ចុងក្រោយ ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា ក្រសួង មហាផ្ទៃ និង ក្នុង នាម ខ្លួន ឯង ផ្ទាល់ លោក បាន ស្នើ ដល់ សមាជិក សមាជិកា នៃ អង្គ សនិ្ន បាត ត្រូវ ខិតខំ យក អស់ កម្លាំង កាយ ចិត្ត ប្រាជ្ញា ស្មារតី ដើម្បី ចូលរួម ពិភាក្សា ឲ្យបាន ផុសផុល អំពី សមិទ្ធិផល បញ្ហា ប្រឈម និង ដំណោះស្រាយ ព្រម ជាមួយនឹង ការផ្ដល់ បទពិសោធន៍ ល្អ ៗ សម្រាប់ ជា មូលដ្ឋាន អនុវត្ត ទិសដៅ ការងារ ឆ្នាំ ២០១៩ ឲ្យ មាន ប្រសិទ្ធិភាព ថែម ទៀត ។
គួរ រំលឹក ថា អង្គ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៨ និង ការលើក ទិសដៅ អនុវត្ត ការងារ ឆ្នាំ ២០១៩ ប្រព្រឹត្តទៅ មាន រយៈពេល ២ ថ្ងៃ គឺ ថ្ងៃទី ២៧ - ២៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ដោយ មាន សមាជិក សមាជិក ចូលរួម ប្រមាណ ជិត ៤០០ នាក់ ។
( បន្ទាយមានជ័យ )៖ រយៈពេល ២ ថ្ងៃ ជាប់ គ្នា នេះ ប្រជាពលរដ្ឋ ចំនួន ១៥ នាក់ តំណាង ឲ្យ ប្រជាពលរដ្ឋ ចំនួន ២៨ គ្រួសារ បាន នាំគ្នា ផ្តិត មេដៃ សុំ ការអន្តរាគមន៍ ពី អាជ្ញាធរ ក្រុង ខេត្ត ឲ្យ ជួយ ទប់ស្កាត់ ជា បន្ទាន់ ចំពោះ លោក ហង្ស ម៉ៅ ដែល បាន ទន្ទ្រាន ដី ចាក់ ដី បំពេញ សាងសង់ និង បែងចែក ដី លក់ ទៅ លើ ដី មាន ទំនាស់ រ៉ាំរ៉ៃ អស់ ជាង ១០ឆ្នាំ មកហើយ តែ មិន ទាន់ ចប់ ឡើយ ស្ថិត នៅ ភូមិ ស្ទឹង បត់ សង្កាត់ ផ្សារ កណ្តាល ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
ប្រជាពលរដ្ឋ ចំនួន ១៥ នាក់ បាន ប្រាប់ ឲ្យដឹង នា ថ្ងៃទី ២៧ ខែកុម្ភៈ នេះ ថា យោង តាម អង្គប្រជុំ កាលពី ថ្ងៃទី ១៣ ខែធ្នូ ឆ្នាំ ២០១៨ លោក ហង្ស ម៉ៅ បាន អះអាង ថា លោក មិន បាន លក់ដូរ ឬ ធ្វើ សកម្មភាព អ្វី ទៅ លើ ដី កំពុង មាន ទំនាស់ នោះ ទេ ប៉ុន្តែ ថ្មី ៗ នេះ លោក ហង្ស ម៉ៅ បាន និង កំពុង ធ្វើ សកម្មភាព ចាក់ ដី សាងសង់ ធ្វើ របង និង បែងចែក ដី ទំនាស់ ខាងលើ នេះ ខណៈ ពុំ ទាន់ ដោះស្រាយ ជា ស្ថាពរ នៅឡើយ ។
ប្រជាពលរដ្ឋ ចំនួន ១៥ នាក់ បាន បន្ត ទៀត ថា កាលពី ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០១៩ កន្លងទៅ វេលា ម៉ោង ប្រមាណ ១០៖ ៤៥ នាទី ព្រឹក មាន មនុស្ស៤ ទៅ ៥នាក់ ចុះ មក វាស់វែង ដី បម្រុង បែងចែក ដី ដោយ អះអាង ថា ជា កូន ចៅ របស់ លោក ហង្ស ម៉ៅ ហើយ ចុះ មក នេះ គឺ តាម បញ្ជា របស់ លោក ហង្ស ម៉ៅ ផងដែរ ។ ភ្លាម ៗ នោះ ប្រជាពលរដ្ឋ ទាំងអស់ បាន ធ្វើ ការហាមឃាត់ ភ្លាម និង មិន ព្រម អនុញ្ញាតឲ្យ ពួកគេ វាស់វែង ដី ឡើយ ពួកគេ ដែល ជា កូន ចៅ របស់ លោក ហង្ស ម៉ៅ បាន ឆ្លើយ ថា មិន ដឹង ទេ ធ្វើ តាម បញ្ជា មេ ហើយក៏ ត្រឡប់ ទៅវិញ ។
បើ តាម ការបញ្ជាក់ ពី ប្រជាពលរដ្ឋ ដី នេះ ប្រជាពលរដ្ឋ បាន អាស្រ័យ ផល ធ្វើ ស្រែ ចំការ តាំងពី ឆ្នាំ ២០០០ រហូតមក ព្រមទាំង មាន សង់ ផ្ទះ របស់ នៅ ។ ក្រោយពី លោក អាំង មាល តី ចេញ សាលក្រម កាត់ ដី ពួកគាត់ លែង បាន អាស្រ័យ ផល ទៀត តាំងពី ពេល នោះ ម ។ អ្វី ចំណុច ពិសេស សព្វ ថ្ងៃ ដី នេះ កាន់កាប់ ដោយ ឈ្មោះ ហង្ស ម៉ៅ ហើយ លោក ហង្ស ម៉ៅ ត្រូវបាន គេ និយាយ ថា មាន ទំនាស់ ដីធ្លី ជាច្រើន កន្លែង ផដែរ នៅក្នុង ខេត្ត បន្ទាយមានជ័យ ៕
កម្លាំង នគរបាល ចុះបង្ក្រាប និង ចាប់ខ្លួន ជន គ្រឿងញៀន ១៤នាក់ ដកហូត ថ្នាំ ជាង ៤០ កញ្ចប់ នៅ ស្រុក ប្រាសាទ សំបូរ និង ស្រុក សណ្ដាន់
( កំពង់ធំ )៖ នៅ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ក្រោម ការបញ្ជា ពី លោក ស្នងការ និង ក្រោម ការសម្របសម្រួល ពី លោក អ៊ិត សុធា ព្រះរាជអាជ្ញា ខេត្ត កំពង់ធំ បាន ចុះបង្ក្រាប និង ចាប់ខ្លួនអ្នកប្រើប្រាស់ គ្រឿងញៀន ចំនួន ១៤នាក់ នៅ ស្រុក ប្រាសាទ សំបូរ និង ស្រុក សណ្ដាន់ ។
លោក ឧត្តមសេនីយ៍ ទោ អ៊ុក កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ធំ បាន ឲ្យ ថា កាលពី រសៀល ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០១៩ កម្លាំង នគរបាល របស់ លោក បាន ចុះបង្ក្រាប ករណី ជួញដូរ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន មួយ ករណី ឃាត់ខ្លួន ជនសង្ស័យ ដែល ជា មេក្លោង បាន ម្នាក់ ឈ្មោះ មាស ឆេង អាន ហៅ ឡុញ រួមទាំង ថ្នាំ ញៀន ចំនួន ៤៣ កញ្ចប់ ។ បន្ទាប់មក កម្លាំង ជំនាញ បន្ត ប្រើប្រាស់ វិធានការ ជំនាញ ឈាន ទៅ ធ្វើ ការឃាត់ខ្លួន មុខ សញ្ញា ពាក់ព័ន្ធ និង ប្រើប្រាស់ គ្រឿងញៀន បាន បន្ត បន្ទាប់ ចំនួន ១៣នាក់ ។
លោក ថា ការប្រើប្រាស់ គ្រឿងញៀន ធ្វើឲ្យ ខូច សុខភាព ក្រុមគ្រួសារ ពិសេស សង្គមជាតិ ទាំងមូល គ្រឿងញៀន ទាំងអស់ នេះ ហើយ ធ្វើឱ្យ មនុស្ស ដែល ប្រើប្រាស់ បាត់បង់ នូវ សតិ បញ្ញា ស្មារតី ហ៊ាន ធ្វើ សកម្មភាព ផ្សេង ៗ ទៅ លើ ឪពុក ម្ដាយ អ្នកដទៃ ឆក់ ប្លន់ កាប់ សម្លាប់ ដើម្បី ខ្លួន ឯង ។
ជា ចុងក្រោយ លោក ឧត្តមសេនីយ៍ ទោ អ៊ុក កុសល បាន ផ្ដាំផ្ញើ សូមឲ្យ បងប្អូន ទាំងអស់ ចៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន ព្រោះ គ្រឿងញៀន បំផ្លាញ អនាគត សុភមង្គល ក្រុមគ្រួសារ និង សង្គមជាតិ ដូចនេះ សូមឲ្យ ឪពុក ម្ដាយ ប្រជាពលរដ្ឋ ទាំងអស់ តាមដាន កម្មភាព កូន ចៅ របស់ បងប្អូន ពេល មាន សកម្មភាព អ្វី ផ្សេង ៗ ត្រូវ រាយការណ៍ មក អ្នក មាន សមត្ថកិច្ច នៅក្នុង មូលដ្ឋាន របស់ បងប្អូន ៕ មួយ ឆ្នាំ ៗ មនុស្ស ជាង ៧លាន នាក់ ស្លាប់ នៅ ទូទាំង ពិភពលោក ដោយសារ ការជក់ បារី . កម្ពុជា បើក សិក្ខាសាលា ជំរុញ ទីក្រុង គ្មាន ផ្សែង បារី នៅ ខេត្ត សៀមរាប
( សៀមរាប ) ៖ បច្ចុប្បន្ន ថ្នាំជក់ សម្លាប់ មនុស្ស ប្រមាណ ជាង ៧លាន នាក់ ទូទាំង ពិភពលោក ក្នុង មួយ ឆ្នាំ ដែល គិត ជា មធ្យម ប្រមាណ ជា ១៦. ៤៣៨ នាក់ ក្នុង មួយ ថ្ងៃ ក្នុង នោះ មាន អ្នក ស្រូប ផ្សែង បារី ពី គេ ចំនួន ៦សែន នាក់ ។ ខណៈ នៅ កម្ពុជា ក្នុង មួយ ឆ្នាំ ៗ ប្រជាពលរដ្ឋ ជាង ១ម៉ឺន នាក់ ស្លាប់ បណ្តាល មកពី ជំងឺ ដែល បង្ក ដោយ ការប្រើប្រាស់ ថ្នាំជក់ ។
មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង ទេសចរណ៍ រូប នេះ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « បរិស្ថាន គ្មាន ផ្សែង បារី Smoke-Free ជា បរិបទ មួយ ដែល ពិភពលោក ក៏ ដូចជា តំបន់ បាន និង យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការត្រួតពិនិត្យ ផលិតផល ថ្នាំជក់ ដែល អាច ប៉ះពាល់ ដល់ បរិស្ថាន និង ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ទូទាំង ពិភពលោក ។ បច្ចុប្បន្ន ថ្នាំជក់ សម្លាប់ មនុស្ស ប្រមាណ ជាង ៧លាន នាក់ ទូទាំង ពិភពលោក ក្នុង មួយ ឆ្នាំ ដែល គិត ជា មធ្យម ប្រមាណ ជា ១៦. ៤៣៨ នាក់ ក្នុង មួយ ថ្ងៃ ក្នុង នោះ មាន អ្នក ស្រូប ផ្សែង បារី ពី គេ ចំនួន ៦សែន នាក់ » ។
លោក បាន បន្ដ ថា អ្នកស្លាប់ ទាំងនោះ គឺ បណ្តាល មកពី ជំងឺ មហារីក សួត ដាច់ សរសៃ ឈាម ខួរក្បាល មហារីក មាត់ គាំង បេះដូង ក្រិន សរសៃ ឈាម មហារីក ក្រពះ ប្លោក នោម ។ល ។ ចំពោះ ស្ត្រី ដែល មាន គភ៌ ក៏ អាច ធ្វើឲ្យ ទារក កើត មក ខ្វះ ទម្ងន់ និង មាន រាងកាយ មិន គ្រប់ លក្ខណៈ ហើយ បើ គ្មាន វិធានការ ទប់ស្កាត់ ប្រកបដោយ ប្រសិទ្ធភាព ទេ នៅ ឆ្នាំ ២០៣០ ថ្នាំជក់ អាចនឹង សម្លាប់ មនុស្ស ៨លាន នាក់ ក្នុង មួយ ឆ្នាំ ហើយ ៨០ % នៃ អ្នកស្លាប់ គឺ ស្ថិត នៅ បណ្តា ប្រទេស កំពុង អភិវឌ្ឍន៍ ។
នៅក្នុង អង្គ សិក្ខាសាលា នោះ លោក ហោ សារុន តំណាង លោក ថោង ខុន រដ្ឋមន្ដ្រី ក្រសួង ទេសចរណ៍ បាន ឲ្យដឹង ថា ការរៀបចំ សិក្ខាសាលា នេះ ឡើង ក្នុង គោលបំណង សំខាន់ ៗ ចំនួន រួម មាន៖
* ទី១៖ ផ្សព្វផ្សាយ ដល់ អ្នកចូលរួម នូវ ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ ថ្នាំជក់ និង លិខិត បទដ្ឋាន គតិយុត្ត ក្រោម ច្បាប់ នេះ ដើម្បី ធានា នូវ ប្រសិទ្ធភាព ក្នុង ការអនុវត្ត
* ទី ២៖យល់ដឹង អំពី អត្ថន័យ ជា សកល នៃ ទីក្រុង គ្មាន ផ្សែង បារី និង ឧត្តមានុភាព ( ការអនុវត្ត ល្អ បំផុត ) នៅ បណ្តា ប្រទេស ក្នុង តំបន់
* ទី៣៖ ទទួលស្គាល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ អាជ្ញាធរ អប្សរា ក្នុង ការអនុវត្ត និង ជំរុញ រមណីយដ្ឋាន អង្គរ គ្មាន ផ្សែង បារី
* ទី៤៖ ការចូលរួម ចែករំលែក បទពិសោធន៍ នានា ដែល កើត មាន ឡើង ក្នុង មូលដ្ឋាន អាជីវកម្ម សេវាកម្ម ទេសចរណ៍ ដើម្បី ប្រែក្លាយ ទីក្រុង សៀមរាប ជា ទីក្រុង គ្មាន ផ្សែង បារី
និង ទី៥៖ ពិគ្រោះ ពិភាក្សា អំពី ការត្រៀមខ្លួន ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ លើក ទី៧ ស្តីពី ទីក្រុង គ្មាន ផ្សែង បារី ដែល នឹង ប្រព្រឹត្តទៅ នា ខែតុលា ឆ្នាំ ២០១៩ ខាងមុខ នៅ ខេត្ត សៀមរាប ។
( កំពង់ធំ )៖ នៅមុខ ផ្សារ កំពង់ធំ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ បាន ប្រារព្ធ កម្មវិធី បញ្ជ្រាប ការយល់ដឹង និង ការសម្អាត ក្រុង ដើម្បី អបអរសាទរ ទិវា ទីក្រុង ស្អាត លើក ទី៧ ក្រោម ប្រធានបទ « ទីក្រុង ស្អាត ទីក្រុង ផ្ដល់ ភាពកក់ក្តៅ » ។ នៅក្នុង កម្មវិធី នេះ ក៏ មាន ការចូលរួម ពី លោក ម៉ាក់ ប៊ុន ហុង អភិបាល ក្រុង ស្ទឹង សែន ប្រធាន មន្ទីរ អនុប្រធាន មន្ទីរ កងកម្លាំងប្រដាប់អាវុធ សិស្សានុសិស្ស និង ប្រជាពលរដ្ឋ ចូលរួម យ៉ាង ច្រើន នាក់ ផងដែរ ។
អភិបាល ក្រុង ស្ទឹង សែន បាន ថ្លែង ថា រដ្ឋបាល បាន រៀបចំ ទីក្រុង ឲ្យ មាន សោភ័ណភាព សម្រាប់ ឆ្នាំ ២០១៨ - ២០១៩ នឹង ឈាន ឲ្យ មាន លក្ខណៈ ល្អ ប្រសើរឡើង ដូចនេះ សូមឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ គ្រប់ អង្គភាព ស្ថាប័ន ធ្វើ យ៉ាងណា អនុវត្ត ទីក្រុង ស្អាត ទាំងអស់ គ្នា ដើម្បីឲ្យ ក្លាយទៅជា រំដួល បី ទង ។
ការសម្អាត ទីក្រុង គឺជា តួនាទី របស់ បុគ្គល ក្នុង ការចូលរួមចំណែក អភិវឌ្ឍ ភូមិ ឃុំ និង សង្គមជាតិ ឲ្យ មាន លក្ខណៈ ល្អ ប្រសើរ ចង់ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ យល់ ឲ្យ ច្បាស់ ពី បរិស្ថាន និង បង្រៀន ដល់ កូន ចៅ ជំនាន់ ក្រោយ ឲ្យ យល់ដឹង ពី បរិស្ថាន ។ ជា ចុងក្រោយ រដ្ឋបាល ខេត្ត កំពង់ធំ បាន បែងចែក ទៅតាម ប្រភេទ នៃ ការសំអាត នៅ ជុំវិញ ក្រុង ស្ទឹង សែន ដើម្បីឲ្យ ទទួលបាន នូវ សោភ័ណ្ឌភាព ទីក្រុង ផងដែរ ៕ សេវា Microsoft 365 នាំមក នូវ សុវត្ថិភាព ការងារ ផលិតភាព ការងារ និង ភាពបត់បែន នៃ ការងារ
អ្នកនាង Sook Hoon Cheah ប្រធាន គ្រប់គ្រង ទូទៅ ទីផ្សារ ថ្មី ៗ ប្រចាំ តំបន់ អាស៊ី អាគ្នេយ៍ បាន មានប្រសាសន៍ ថា « កម្ពុជា កំពុង អភិវឌ្ឍ ខ្លួន យ៉ាង ឆាប់រហ័ស ដើម្បី បំពេញ ឱ្យ គ្រប់ តាម សេចក្ដីត្រូវការ របស់ ប្រជាពលរដ្ឋ របស់ ខ្លួន ព្រមទាំង កំពុង ផ្លាស់ប្ដូរ ស្ថានភាព ទូទៅ នៃ វិស័យ ការងារ ក៏ ដូចជា តួនាទី របស់ ប្រទេសជាតិ នៅក្នុង តំបន់ អាស៊ាន ផងដែរ » ។
អ្នកនាង បាន បន្ថែម ថា « ទិន្នន័យ របស់ ធនាគារ ពិភពលោក អំពី ប្រទេស កម្ពុជា បាន បង្ហាញ យ៉ាង ច្បាស់ ថា ទាំង ផលិតផល ក្នុង ស្រុក សរុប អត្រា អាយុ វែង របស់ ប្រជាជន និង ចំនួន ប្រជាជន សរុប គឺ សុទ្ធតែ កំពុង កើនឡើង ទាំងអស់ ខណៈ ដែល ភាពក្រីក្រ កំពុង ថយចុះ ជា បន្តបន្ទាប់ ។ ហើយ ដោយ ហេតុ ថា ៦៥ % នៃ ប្រជាជន កម្ពុជា សរុប មាន អាយុ ក្រោម ៣០ ឆ្នាំ វា នាំឱ្យ កម្ពុជា សំបូរ ទៅ ដោយ ប្រជាពលរដ្ឋ ដែល មាន សក្ដានុពល ខ្ពស់ និង ដែល កំពុង ស្រែក ឃ្លាន ចង់ ក្រេប យក ចំណេះដឹង ថ្មី ៗ ។
អ្នកនាង បាន សង្កត់ធ្ងន់ អំពី ការ ដែល កម្ពុជា ចាំបាច់ ត្រូវ ងាក មក បំពេញ ការងារ តាម ប្រព័ន្ធ ឌីជីថល វិញ និង អំពី ថា តើ ការផ្លាស់ប្ដូរ នេះ នឹង ជះឥទ្ធិពល យ៉ាងណា ខ្លះ មក លើ កំណើន សេដ្ឋកិច្ច ជាតិ កម្ពុជា ដែល បាន រីកចម្រើន ជា បន្តបន្ទាប់ នេះ ។
