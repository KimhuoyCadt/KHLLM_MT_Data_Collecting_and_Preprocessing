( ភ្នំពេញ ) ៖ លោក ឌឹម សុវណ្ណា រុំ សមាជិក និង ជា អ្នកនាំពាក្យ គ.ជ. ប បាន ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង ថា នៅ ថ្ងៃ ដំបូង ត្រូវនឹង ថ្ងៃទី ០៧ ខែមីនា នៃ ការចុះបញ្ជី គណបក្ស នយោបាយ និង បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត ជ្រេីស រេីស ក្រុមប្រឹក្សា រាជធានី ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ អាណត្តិ ទី៣ ឆ្នាំ ២០១៩ មាន គណបក្ស ចំនួន ៦ បាន ចុះឈ្មោះ រួចរាល់ ហើយ ។
បើ តាម លោក ឌឹម សុវណ្ណា រុំ . គណបក្ស ទាំង៥ នោះ រួម មាន៖ គណបក្ស ប្រជាជន កម្ពុជា គណបក្ស យុវជន កម្ពុជា គណបក្ស ហ៊្វុនស៊ិនប៉ិច គណបក្ស ខ្មែរ រួបរួម ជាតិ គណបក្ស ឆន្ទៈ ខ្មែរ និង គណបក្ស ខ្មែរ សាធារណរដ្ឋ ។
ការថ្លែង ដូច្នេះ របស់ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ធ្វើឡើង នៅក្នុង ឱកាស ដែល សម្ដេច អញ្ជើញ សំណេះសំណាល សាកសួរ សុខទុក្ខ និង ផ្ដល់ អាហារ ដល់ កុមារ យុវនារី នៅ មជ្ឈមណ្ឌល បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ និង ស្ដារ នីតិសម្បទា យុវនារី អាហ្វេ ស៊ីប ទុំ ឌី ស្ថិត នៅ ភូមិ ២៤ សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ ។
សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត បាន ថ្លែង ថា៖ « បើសិនជា មាន ករណី រំលោភបំពាន ផ្លូវភេទ កើតឡើង នៅក្នុង គ្រួសារ មក លើ យើង ម្ដាយ ឬ កូន យើង ក្ដី ក្នុង នាម យើង ជា ស្ដ្រី ត្រូវតែ ក្រោកឈរ ឡើង ពង្រឹង គោលជំហរ និង សមត្ថភាព ហ៊ាន លាង ត្រដាង ការពិត ដើម្បី ការពារ ក្រុមគ្រួសារ យើង កុំ ខ្លាច អំណាច ប្ដី ចរិក ពាល ឲ្យ សោះ ។ ពិសេស យើង ត្រូវ ប្រកាន់ ជំហរ ខ្លួន ឯង ថា កុំ ពឹង លើ ប្ដី ទាំងស្រុង នោះ គឺ ត្រូវតែ ពង្រឹង សមត្ថភាព ខ្លួន មាន ការងារ ធ្វើ មាន ប្រាក់ខែ ទើប ជា ការ ល្អ » ។
ទន្ទឹមនឹង នេះ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ក៏ បាន ថ្លែង កោតសរសើរ ចំពោះ ករណី ស្រ្តី រងគ្រោះ ឈ្មោះ ស្រី ពៅ មាន អាយុ ៣៥ ឆ្នាំ មុខរបរ ជា អ្នកចម្រៀង ប្រចាំ ភោជនីយដ្ឋាន បឹង មាស ដែល ត្រូវបាន បុរស ម្នាក់ អួត ខ្លួន ឯង ជា មន្ត្រី យោធា ផ្កាយ៣ ទះ កំផ្លៀង នាង ពេល បបួល នាង ចេញ ក្រៅតែ នាង មិន ព្រម ទៅ ដែល នេះ បង្ហាញ ថា គាត់ មិន ស្រេកឃ្លាន លុយ របស់ មនុស្ស ពាល នោះ ឡើយ មិន ដូច អ្នក ខ្លះ ឃើញ លុយ ហ៊ាន លះបង់ គ្រប់ យ៉ាង ។
សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក៏ បាន ផ្ដាំផ្ញើ ដល់ ស្ដ្រី គ្រប់ រូប ថា អ្វី ក៏ដោយ សំខាន់ បំផុត នៅលើ ខ្លួន ឯង ព្រោះ កូនសោរ នៅលើ យើង បើ យើង មិន យល់ព្រម ជាមួយ ពួក ជន ពាល នោះ ទេ ក៏ មាន ករណី អ្វី កើតឡើង ។ ស្ដ្រី កម្ពុជា ទាំងអស់ ត្រូវ ពង្រឹង សមត្ថភាព ចំណេះ ជំនាញ និង រក្សា ខ្ជាប់ នូវ វប្បធម៌ ប្រពៃណី របស់ ខ្មែរ យើង ឱ្យ បាន ៕
គម្រោង វិនិយោគ បើក រោងចក្រ ថ្មី ៗ ចំនួន ៥គម្រោង ទៀត សរុប ទឹកប្រាក់ វិនិយោគ ជិត ៨០ លាន ដុល្លារ ត្រូវបាន រាជ រដ្ឋាភិបាល អនុម័ត
( ភ្នំពេញ ) ៖ គម្រោង វិនិយោគ បង្កើត រោងចក្រ ថ្មី ៗ ចំនួន ៥គម្រោង ទៀត ត្រូវបាន ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា (CDC) ដែល ជា សេនាធិការ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា អនុម័ត ឲ្យ បើក ដំណើរការវិនិយោគ នៅ កម្ពុជា សរុប ទឹកប្រាក់ ជិត ៨០ លាន ដុល្លារ អាមេរិក បង្កើត ការងារ ថ្មី រាប់ ពាន់ កន្លែង ផងដែរ ។
គេហទំព័រ Facebook ផ្លូវការ របស់ CDC បាន ចុះផ្សាយ នៅ ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ ថា តាម សំណើ សុំ វិនិយោគ របស់ ក្រុមហ៊ុន គណៈកម្មាធិការ វិនិយោគ កម្ពុជា នៃ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន សម្រេច ចេញ វិញ្ញាបនប័ត្រ ចុះបញ្ជី ជា ស្ថាពរ ជូន ដល់ ក្រុមហ៊ុន ដូច ខាងក្រោម៖
សម្តេច តេជោ ហ៊ុន សែន បាន ពន្យល់ យ៉ាង ដូច្នេះ ថា៖ « ការដំឡើង ឋានៈ តែងតាំង មុខ តំណែង ដោយ ផ្អែក លើ សមត្ថភាព ឥរិយាបទ ការងារ ភាព អំណត់ ព្យាយាម តាម ពាក្យស្លោក " កុំ យក លុយ ទៅ ដូរ ប៉ុស្តិ៍ កុំ យក ប៉ុស្តិ៍ ទៅ រក លុយ " នោះ គឺជា កត្តា កំណត់ សំខាន់ បំផុត ដើម្បី បង្កើត បាន នូវ តម្លាភាព សមធម៌ និង បរិយាកាស មួយ ដែល ទឹកចិត្ត ដល់ បុគ្គលិក មន្រ្តី ទាំងអស់ ឱ្យ ខិតខំ បំពេញ ការងារ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង បែប នេះ ក្នុង ឱកាស ដែល សម្តេច អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បិទ សន្និបាត បូកសរុប ការងារ ឆ្នាំ ២០១៨ និង ការដាក់ចេញ នូវ ការងារ ឆ្នាំ ថ្មី ឆ្នាំ ២០១៩ របស់ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៅ ព្រឹក ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ ។
ក្រៅពី ការរលឹក អំពី ការតែងតាំង មន្រ្តី សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន រំលឹក ដល់ មន្រ្តី ទូត ទាំងអស់ របស់ កម្ពុជា អំពី តួនាទី ដ៏ មាន សារសំខាន់ របស់ ពួកគាត់ ។
សម្តេច បាន ថ្លែង ថា៖ « នយោបាយការណ៍ បរទេស គឺជា យុទ្ធសាស្រ្ត ហើយ ការទូត គឺជា មធ្យោបាយ និង ជា វិធីសាស្រ្ត លើកស្ទួយ ផលប្រយោជន៍ ជាតិ ស្រប តាម យុទ្ធសាស្រ្ត នោះ ដូច្នេះ ការយកចិត្តទុកដាក់ លើ ធនធាន មនុស្ស អ្នកការទូត ដែល ជា អ្នក អនុវត្ត ផ្ទាល់ នូវ នយោបាយ ការបរទេស របស់ រាជ រដ្ឋាភិបាល គឺ មាន សារសំខាន់ ខ្លាំង ណាស់ »៕
ក្រសួង ការងារ ដាក់ចេញ ទិសដៅ ការងារ ២៤ ចំណុច ឱ្យ មន្ត្រី បន្ត ប្រឹងប្រែង អនុវត្ត នៅ ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ ក្នុង ពិធី បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៨ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០១៩ លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ បាន ដាក់ចេញ នូវ ទិសដៅ ការងារ ចំនួន ២៤ ចំណុច ដើម្បីឱ្យ មន្ត្រីរាជការ ក្រោម ឱវាទ បន្ត សហការ គ្នា ខិតខំ ប្រឹងប្រែង អនុវត្ត នៅ ឆ្នាំ ២០១៩ ។
លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង បាន ផ្ដល់ អនុសាសន៍ ថា ឆ្នាំ ២០១៩ នេះ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ ក្រសួង ការងារ ត្រូវ អនុវត្ត ការងារ សំខាន់ ៗ ចំនួន ២៤ ចំណុច រួម មាន៖
១៖ បន្ត ខិតខំ អនុវត្ត ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ នូវ អនុសាសន៍ ណែនាំ ទាំង ១០ ចំណុច របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដើម្បី គាំពារ និង សម្រួល ដល់ បន្ទុក ចំណាយ ក៏ ដូចជា ដោះស្រាយ បញ្ហា នានា របស់ កម្មករ និយោជិត ។
២៖ បន្ត សិក្សា ស្រាវជ្រាវ លទ្ធភាព ធ្វើ វិសោធនកម្ម ច្បាប់ និង រៀបចំ លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ នឹង សិទ្ធិ និង លក្ខខណ្ឌ ការងារ ស្រប តាម តម្រូវការសង្គម - សេដ្ឋកិច្ច ។
៣៖ ពង្រឹង គុណភាព និង ប្រសិទ្ធភាព អធិការ កិច្ចការងារ ដោយ ដាក់ ឱ្យ ប្រើប្រាស់ របាយការណ៍ អធិការ កិច្ចការងារ រួម លើ ប្រព័ន្ធ ទិន្នន័យ ស្វ័យប្រវត្តិកម្ម ដែល អាច ធ្វើ ការសំយោគ និង វាយតម្លៃ លក្ខខណ្ឌ ការងារ ដោយ ស្វ័យប្រវត្តិ ។
៤៖ កែសម្រួល វិធីសាស្ត្រ ចុះ ធ្វើ អធិការ កិច្ចការងារ ដោយ ផ្អែក លើ កម្រិត ហានិភ័យ របស់ សហគ្រាស គ្រឹះស្ថាន និង កំណត់ ការ ធ្វើអធិការ កិច្ចការងារ លើសហគ្រាស គ្រឹះស្ថាន នាំចេញ ចំនួន ១លើក / ឆ្នាំ ។
៥៖ ប្រកាស កំណត់ លក្ខខណ្ឌ ការងារ ស្នូល ៣១ ចំណុច និង លក្ខខណ្ឌ ការងារ ទូទៅ ៤១ ចំណុច ដែល សហគ្រាស គ្រឹះស្ថាន ត្រូវ អនុវត្ត ។
៦៖ បន្ត ពង្រឹង សមត្ថភាព មន្ត្រី អធិការ កិច្ចការងារ ដោយ បង្កើត ឱ្យ មាន គ្រូបង្គោល លើ វិស័យ ការងារ យ៉ាងតិច ចំនួន ៥០ នាក់ និង ធ្វើ វិក្រឹត្យ ការដល់ មន្ត្រី អធិការ កិច្ចការងារ យ៉ាងតិច ចំនួន ៤៥០ នាក់ ជាមួយនឹង ការប្រឡង បញ្ជាក់ សមត្ថភាព ក្រោយពេល វគ្គ វិក្រឹត្យ ការ ។
៧៖ ផ្សព្វផ្សាយ និង បញ្ជ្រាប ចំណេះដឹង អំពី ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ នឹង វិស័យ ការងារ ជាពិសេស អំពី សិទ្ធិ ការងារ ដល់ ប្រតិភូ បុគ្គលិក ប្រតិភូ សហជីព ថ្នាក់ដឹកនាំ សហជីព យ៉ាងតិច ចំនួន ១. ២០០ នាក់ និង ដល់ បុគ្គលិក រដ្ឋបាល នៃ សហគ្រាស គ្រឹះស្ថាន យ៉ាងតិច ចំនួន ៧៥០ នាក់ ។
៩៖ បន្ត ទប់ស្កាត់ ការប្រើប្រាស់ ទម្រង់ ធ្ងន់ធ្ងរ បំផុត នៃ កម្លាំង ពលកម្ម កុមារ និង ការងារ ដោយ បង្ខំ ។
១០៖ បន្ត ខិតខំ ដោះស្រាយ វិវាទ ការងារ ជូន ដល់ គ្រប់ ភាគី ពាក់ព័ន្ធ ឱ្យ បាន ទាន់ ពេលវេលា ប្រកបដោយ ប្រសិទ្ធភាព ដោយ សិក្សា ជាមួយ ក្រុមប្រឹក្សា អាជ្ញា កណ្តាល ដើម្បី បញ្ចូល ការដោះស្រាយ វិវាទ បុគ្គល មួយចំនួន ជូន ក្រុមប្រឹក្សា អាជ្ញា កណ្តាល ព្រមទាំង ខិតខំ ទប់ស្កាត់ ការធ្វើ កូដកម្ម បាតុកម្ម ខុស ច្បាប់ ដោយ ឈរ លើ គោលគារណ៍ ច្បាប់ និង នីតិរដ្ឋ ។
១១៖ ជំរុញ ប្រែក្លាយ សហគ្រាស គ្រឹះស្ថាន មួយ ជា សហគមន៍ សុខសាន្ត មួយ របស់ កម្មករ និយោជិត ដែល ពោរពេញ ដោយ សមត្ថភាព ផលិតភាព ឥរិយាបថ ការងារ និង មនសិការ វិជ្ជាជីវៈ ខ្ពស់ ។
១៤៖ រៀបចំ យន្តការ និង កម្មវិធី បណ្តុះបណ្តាល ជំនាញ ឡើងវិញ (Reskilling) និង យន្តការ ជាមួយ ដៃគូ ពាក់ព័ន្ធ ដើម្បី ផ្តល់ ឥណទាន ដល់ សិក្ខាកាម សិស្ស និស្សិត ដែល បញ្ចប់ វគ្គ បណ្តុះបណ្តាល ដើម្បី បង្កើត មុខរបរ ខ្លួន ឯង ។
១៥៖ កែសម្រួល លិខិត បទដ្ឋាន ដែល ផ្តល់ ភាពស្មើគ្នា រវាង កាតព្វកិច្ច ហ្វឹកហ្វឺន កូន ជាង និង កាតព្វកិច្ច ហ្វឹកហាត់ ការងារ - កម្មសិក្សា និង ពង្រឹង ការហ្វឹកហ្វឺន កូន ជាង និង កម្មសិក្សា និង បង្កើន ការផ្សព្វផ្សាយ អំពី វិស័យ អប់រំ បណ្ដុះបណ្ដាល បច្ចេកទេស និង វិជ្ជាជីវៈ ។
១៦៖ ពង្រឹង ការអនុវត្ត គោល នយោបាយ ជាតិ ស្តីពី មុខរបរ និង ការងារ និង ធ្វើ សមាហរណកម្ម កម្មវិធី ការងារ សមរម្យ សម្រាប់ ប្រទេស កម្ពុជា ឆ្នាំ ២០១៩ - ២០២៣ និង កម្មវិធី របស់ ដៃគូ អភិវឌ្ឍ ។
១៧៖ បន្ត លើកកម្ពស់ ការផ្តល់ សេវា ការងារ និង ព័ត៌មាន ទីផ្សារ ការងារ ប្រកបដោយ គុណភាព និង ប្រសិទ្ធភាព ដោយ ពង្រីក យន្តការ « វេទិកា ការងារ » ព្រមទាំង ការជំរុញ កិច្ចសហប្រតិបត្តិការ លើ ការប្រើប្រាស់ កម្លាំង ពលកម្ម ជាមួយ បណ្តា ប្រទេស ដៃ គូ ជាពិសេស បង្កើត សេវា គាំទ្រ ដល់ ពលករ ទេសន្ត ប្រវេសន៍ ខ្មែរ សំដៅ ធានា បាន នូវ ការគាំពារ ពលករ ទេសន្តរប្រវេសន៍ ខ្មែរ និង ក្រុមគ្រួសារ ។
១៩៖ បង្កើន ការអប់រំ ការផលិត ស្ព័ត អប់រំ និង ការផ្សព្វផ្សាយ អំពី សុវត្ថិភាព ចរាចរណ៍ ដើម្បី បង្ការ ទប់ស្កាត់ គ្រោះថ្នាក់ ការងារ នៅ កន្លែង ធ្វើការ និង ការដួល សន្លប់ ។
២០៖ បន្ត ការអនុវត្ត ផែនទី បង្ហាញ ផ្លូវ សម្រាប់ អនុវត្ត អនុសាសន៍ របស់ អង្គការ ILO ពាក់ព័ន្ធ នឹង សេរីភាព អង្គការ វិជ្ជាជីវៈ ដើម្បី ជំរុញ ការលើកកម្ពស់ ការអនុវត្ត សេរីភាព អង្គការ វិជ្ជាជីវៈ នៅ កម្ពុជា ។
២១៖ ពង្រឹង សមត្ថភាព មន្ត្រី និង អង្គភាព ក្នុង ការផ្តល់ សេវា សាធារណៈ នានា ប្រកបដោយ ភាពទន់ភ្លន់ ក្រមសីលធម៌ វិជ្ជាជីវៈ និង ទាន់ ពេលវេលា ជូន ប្រជាពលរដ្ឋ ជាពិសេស កម្មករ និយោជិត ស្រប តាម គោលការណ៍ វិមជ្ឈការ និង វិសហមជ្ឈការ ។
២២៖ កសាង ឱ្យ បាន នូវ ប្រព័ន្ធ រដ្ឋបាល និង ហិរញ្ញវត្ថុ ប្រកបដោយ តម្លាភាព គណនេយ្យភាព និង ការត្រួតពិនិត្យ វាយតម្លៃ មួយ ត្រឹមត្រូវ និង ទៀងទាត់ ដើម្បី ធ្វើជា មូលដ្ឋានគ្រឹះ ក្នុង ការអនុវត្ត អភិក្រមទាំង ៥ គឺ « ឆ្លុះ កញ្ចក់ ងូតទឹក ដុស ក្អែល ព្យាបាល និង វះកាត់ » និង បាវចនា កែទម្រង់ ផ្ទៃក្នុង របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ។
២៤៖ រៀបចំ យន្តការតាមដាន ត្រួតពិនិត្យ និង វាយតម្លៃ លើ ការអនុវត្ត ការងារ របស់ គ្រប់ អង្គភាព ក្រោម ឱវាទ ក្រសួង ដោយ បង្កើត ក្រុមការងារ តាមដាន ត្រួតពិនិត្យ និង វាយតម្លៃ ការអនុវត្ត ផែនការ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ វិស័យ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ឆ្នាំ ២០១៩ - ២០២៣៕ ទីបំផុត ក្រុមហ៊ុន ទូរគមនាគមន៍ យក្ស រុស្ស៊ី «MTS ព្រម បង់ប្រាក់ ៨៥០ លាន ដុល្លារ » ដើម្បី បិទ បញ្ចប់ សំណុំរឿង ក្នុង តុលាការ អាមេរិក
( ម៉ូស្គូ) ៖ ក្រុមហ៊ុន ទូរគមនាគមន៍ ឈាន មុខ គេ របស់ រុស្ស៊ី MTS នៅ ថ្ងៃព្រហស្បតិ៍ នេះ បាន ឱ្យដឹង ថា ខ្លួន យល់ព្រម បង់ប្រាក់ « ៨៥០ លាន ដុល្លារ អាមេរិក » ដើម្បី បិទ បញ្ចប់ សំណុំរឿង ពុករលួយ មួយ ដែល ក្រោម ការស៊ើបអង្កេត របស់ សហរដ្ឋ អាមេរិក ពាក់ព័ន្ធ នឹង ការបង់ប្រាក់ សំណូក ឱ្យ គ្រួសារ អតីត ប្រធានាធិបតី អ៊ូបេគីស្ថាន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន France 24 នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ ទី០៧ ខែមីនា ឆ្នាំ ២០១៩ ។
គួរ បញ្ជាក់ ថា បើ តាម អាជ្ញាធរ អាមេរិក ក្រុមហ៊ុន MTS បាន បង់ប្រាក់ សំណូក ឱ្យ មន្ត្រី អ៊ូបេគីស្ថាន ម្នាក់ ដែល មាន ទំនាក់ទំនង ជាមួយ លោក Karimov ក្នុង គោលបំណង អាច ប្រតិបត្តិការ មុខជំនួញ របស់ ខ្លួន នៅក្នុង ប្រទេស អ៊ូ បេគីស្ថាន ដែល មាន ប្រជាជន ច្រើន ជាង ៣២ លាន នាក់ ៕
សម្តេច តេជោ ហ៊ុន សែន៖ កម្ពុជា អរគុណ ប្រទេស ទាំងអស់ ដែល ជួយ ឧបត្ថម្ភ ដោយ ស្មោះ ប៉ុន្តែ កម្ពុជា មិន ប្តូរ អធិបតេយ្យភាព ជាមួយ ជំនួយ ដាច់ខាត
( ភ្នំពេញ ) ៖ ចំពោះ មុខ មន្រ្តី ទូត ជាច្រើន ក្នុង ពិធី បិទ សន្និបាត ប្រចាំ ឆ្នាំ របស់ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នា ព្រឹក ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា កម្ពុជា សូម ថ្លែងអំណរគុណ ដល់ ប្រទេស ទាំងអស់ ដែល បាន ជួយ ឧបត្ថម្ភ គាំទ្រ ដើម្បី ការស្តារ និង កសាង ជាតិ ឡើងវិញ កន្លងមក ប៉ុន្តែ ទោះជា យ៉ាង នេះ ក្តី ក៏ កម្ពុជា នឹង មិន ប្តូរ អធិបតេយ្យភាព របស់ ខ្លួន ជាមួយនឹង ជំនួយ ណា ជាដាច់ខាត ។
មុននឹង បង្ហាញ សារ នយោបាយ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន កោតសរសើរ ចំពោះ សមិទ្ធផល នានា ដែល ជា លទ្ធផល នៃ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ថ្នាក់ដឹកនាំ និង មន្ត្រី បុគ្គលិក ក្រសួង ការបរទេស នៅក្នុង ការតស៊ូ ដើម្បី ការពារ ផលប្រយោជន៍ គោល របស់ ប្រទេសជាតិ និង ប្រជាជន ទាំង នៅក្នុង ប្រទេស ទាំង លើ ឆាក អន្តរជាតិ ។ សម្តេច បាន វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល ដែល ក្រសួង សម្រេចបាន ក្នុង ការអនុវត្ត ការងារ ធំ ៗ ទាំង៥ ដែល ក្រសួង បាន ដាក់ចេញ កាលពី ឆ្នាំ ២០១៧ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា៖ « ពិត ណាស់ ការងារ ធំ ទី១ គឺ ការការពារ ផលប្រយោជន៍ ជាតិ ជាពិសេស ការពារ ឯករាជ្យ និង អធិបតេយ្យ បាន ក្លាយជា អាទិភាព ចម្បង ក្នុង ការងារ ការទូត របស់ យើង ក្នុង បរិបទ នៃ ការជ្រៀត ជ្រែក ចូល កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា ការដាក់ សម្ពាធ កៀប សង្កត់ យក ឆន្ទៈ ប្រទេស ធំ មក បង្ខំ ឲ្យ យើង ទទួលយក គឺជា ការគំរាម យ៉ាង ធ្ងន់ធ្ងរ ដល់ ឯករាជ្យ អធិបតេយ្យភាព ក៏ ដូចជា គំរាម ដល់ សន្តិភាព និង ស្ថិរភាព របស់ ប្រទេសជាតិ » ។
សម្រាប់ Huawei ការដាក់កំហិត ដែល បាន ចែង នៅក្នុង NDAA គឺ បាន រារាំង ក្រុមហ៊ុន ពី ការផ្គត់ផ្គង់ បច្ចេកវិទ្យា 5G ឈាន មុខ គេ ដល់ ប្រជាជន អាមេរិក ដែល ការដាក់កំហិត នេះ នឹង ពន្យារ ពេល ដល់ ការដាក់ ឲ្យ ដំណើរការបច្ចេកវិទ្យា 5G ហើយនិង រារាំង ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង ដើម្បី កែលម្អ ដំណើរការបច្ចេកវិទ្យា 5G នៅ សហរដ្ឋ អាមេរិក ទៀតផង ។
ការប៉ាន់ស្មាន ពី ប្រភព ជាច្រើន នៅក្នុង ឧស្សាហកម្ម នេះ បាន បង្ហាញ ថា ការអនុញ្ញាតឲ្យ Huawei ហក់ ចូល ក្នុង ការប្រកួតប្រជែង និង អាច កាត់បន្ថយ តម្លៃ ក្នុង ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ បច្ចេកវិទ្យា ទំនាក់ទំនង ឥត ខ្សែ ពី 15% ទៅ 40% ឯណោះ ។ នេះ អាច ជួយ អាមេរិក ខាងជើង សន្សំ ការចំណាយ បាន យ៉ាងហោចណាស់ ក៏ 20 ពាន់ លាន ដុល្លា ដែរ នៅក្នុង រយៈពេល បួន ឆ្នាំ ខាងមុខ ។
អភិបាល ខេត្ត សីហនុ ចុះ មើល អាង វារី វប្បកម្ម ចិញ្ចឹម បង្គារ ក្តាម នៅ តំបន់ ទំនាប ក្បែរ មាត់ នៃ ស្រុក ព្រៃនប់
( ព្រះសីហនុ) ៖ នៅ ថ្ងៃទី ៧ ខែមីនា ឆ្នាំ ២០១៩ អភិបាល ខេត្ត ព្រះសីហនុ លោក យន្ត មីន បាន ទៅ មើល ទីតាំង វារី វប្បកម្ម ( កន្លែង ចិញ្ចឹម បង្គា ក្ដាម ) របស់ ក្រុមហ៊ុន ហេង ហេង អភិវឌ្ឍន៍ ស្ថិត ក្នុង ឃុំ អូរ ឧកញ៉ា ហេង និង ឃុំ បឹង តា ព្រហ្ម ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
លោក យន្ត មីន បាន បង្ហាញ ជំហរ លើកទឹកចិត្ដ និង គាំទ្រ ចំពោះ វិស័យ ឯកជន ក្នុង ការបង្កើត កសិដ្ឋាន ចិញ្ចឹម បង្គារ ក្តាម តាម លក្ខណៈ បច្ចេកទេស កសិកម្ម ទំនើប ក្នុង មូលដ្ឋាន ខេត្ត ព្រះសីហនុ គ្រា ដែល តម្រូវការ នៅ ខេត្ត ព្រះសីហនុ កំពុង មាន ការកើនឡើង ស្រប ពេល ដែល ខេត្ត ព្រះសីហនុ កំពុង មាន ការអភិវឌ្ឍ នា ពេល បច្ចុប្បន្ន ។
ទន្ទឹម នេះ លោក យន្ត មីន បាន ផ្តល់ អនុសាសន៍ ដល់ កសិករ ក្នុង ស្រុក ពិសេស ប្រជាជន ដែល មាន ដី ស្រែ នៅ តំបន់ នេះ គួរ ចាប់អារម្មណ៍ អារម្មណ៍ ពី ការចិញ្ចឹម បង្គារ ក្តាម តាម បច្ចេកទេស កសិកម្ម នេះ ដើម្បី កែប្រែ ជីវភាព អោយ កាន់តែ ប្រសើរ ។
លោក នេន ចំរើន ប្រធាន មន្ទីរ កសិកម្ម ខេត្ត ព្រះសីហនុ បង្ហាញ មោទនភាព បន្ទាប់ពី បាន ទាក់ទង ក្រុមហ៊ុន ហេង ហេង មក ចិញ្ចឹម បង្គា ក្ដាម ក្នុង តំបន់ នេះ ។ លោក បញ្ជាក់ ថា ទីនេះ មាន អំណោយផល សម្រាប់ ការចិញ្ចឹម បង្គា ក្រាម ( មច្ឆា សមុទ្រ ) ។ លោក ចង់ ឃើញ កសិករ ដែល មាន ដី ស្រែ នៅ តំបន់ នេះ គួរងារ មក ចិញ្ចឹម បង្គារ ក្តាម សមុទ្រ វិញ ប្រសើរ ជាង គ្រា ដែល តម្រូវការ ទីផ្សារ កើនឡើង ខ្ពស់ ។
លោក ស៊ិន សត្ថា អ្នកគ្រប់គ្រប់ ក្រុមហ៊ុន ហេង ហេង អភិវឌ្ឍន៍ ឲ្យដឹង ថា កន្លងមក បើ ទោះជា មាន ការខាតបង់ ខ្លះ ក្តី តែ លោក នៅតែ មាន ជំហរ ច្បាស់លាស់ នឹង ខិតខំ គ្រប់ មធ្យោបាយ ដើម្បី ចិញ្ចឹម បង្គា ក្ដាម សំរាប់ ផ្គត់ផ្គង់ ទីផ្សារ ក្នុង ស្រុក ។ លោក សត្ថា បញ្ជាក់ ថា ការប្រមូល ផល លើក ទី មួយ នេះ ទទួលបាន ជាង ៤តោន បន្ទាប់ពី ទំលាក់ កូន បង្គា អស់ ៧លាន កូន ៕
ការលើកឡើង បែប នេះ របស់ លោក មេធាវី គី តិច បាន ធ្វើឡើង នៅ ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ នៅក្នុង ឱកាស ដែល លោក មេធាវី រួម ជាមួយ លោកស្រី អ៉ឹង កន្ថា ផាវី រដ្ឋមន្ត្រី ក្រសួង កិច្ចការ នារី និង លោក កែវ រ៉េមី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន ចុះ ជួប សំណេះសំណាល ជាមួយ នារី ជាប់ ឃុំ នៅ មណ្ឌល អប់រំ កែប្រែ ( ម២ ) រាជធានី ភ្នំពេញ ។
នៅក្នុង ឱកាស នោះ ដែរ ប្រធាន មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន បាន ថ្លែង ថា ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន នឹង ព្យាយាម ធ្វើ យ៉ាងណា ការពារ កូន ក្តី របស់ ខ្លួន ដែល ជា ស្ត្រី រងគ្រោះ ការរំលោភ លើ ការរំលោភបំពាន នានា ដែល ពុំ មាន លទ្ធភាព គ្រប់គ្រាន់ ដើម្បី ជួល មេធាវី ឯកជន មក ការពារ រឿងក្តី របស់ ខ្លួន ឱ្យ អស់ ពី សមត្ថភាព និង ផ្តល់ ការប្រឹក្សា ផ្នែក ច្បាប់ ដោយ មិន គិត ថ្លៃ សេវា មេធាវី នៅ ទូទាំ ប្រទេស កម្ពុជា ។
លោក មេធាវី គី តិច បាន បន្ថែម ថា សម្តេច តេជោ ហ៊ុន សែន មាន មោទនភាព និង ផ្តល់ ភាពជឿជាក់ ខ្លាំង ណាស់ ចំពោះ ក្រុម មេធាវី ដោយ សម្តេច បាន លើក ជាប្រសាសន៍ ច្រើន ដង និង គោលបំណង សំខាន់ សម្រាប់ ជួយ ដល់ បងប្អូន ស្រ្តី ដែល មាន ជីវភាព ក្រីក្រ ។
សូម បញ្ជាក់ ថា ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៨ និង លើក ទិសដៅ ការងារ សម្រាប់ ឆ្នាំ ២០១៩ របស់ « ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី ស្ត្រី » ដែល ធ្វើឡើង នៅ វិមាន សន្តិភាព នៅ ព្រឹក ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០១៩ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន បញ្ជាក់ អំពី បំណង របស់ សម្តេច ក្នុង ការបង្កើត « ក្រុម មេធាវី ការពារ ក្តី » ដែល ស្ថិត ក្រោម ការគ្រប់គ្រង ដោយ ផ្ទាល់ របស់ សម្តេច ដើម្បី ជួយ ដល់ ជនរងគ្រោះ ជា ស្ត្រី ក្រីក្រ ។
សម្តេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា៖ « ដើម្បី ជួយ ស្រ្តី រងគ្រោះ ទន់ខ្សោយ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នឹង ពិចារណា ក្នុង ការបង្កើត « ក្រុម មេធាវី ការពាក្តី » ដែល ស្ថិត នៅក្រោម ការគ្រប់គ្រង ផ្ទាល់ របស់ សម្តេច តេជោ ដើម្បី ជួយ ដល់ ជនរងគ្រោះ ដែល ជា ស្រ្តី ក្រីក្រ» ៕
( រតនគិរី ) ៖ ស្នងការ នគរបាល ខេត្ត រតនគិរី លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន នៅ រសៀល ថ្ងៃទី ៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន ចុះ សួរសុខទុក្ខ នាំ អំណោយ គ្រឿង បរិភោគ និង ថវិកា មួយ ចំនួន ជូន វរ ការពារ ព្រំដែន លេខ ៦២៣ និង លេខ ២០៣ ។
ចូលរួម ក្នុង ពិធី នេះ ដែរ មាន លោក . លោកស្រី ស្នងការរង . នាយ ការិយាល័យ . អធិការ ស្រុក - ក្រុង ចំណុះ ឲ្យ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ទាំងមូល ផងដែរ ។
ក្នុង ពិធី ខាង លើ នេះ លោក វរសេនីយ៍ ទោ បួន សេង សុពិសិដ្ឋ មេបញ្ជាការវរ ការពារ ព្រំដែន លេខ ៦២៣ បាន បង្ហាញ ជូន ពី ចំនួន កម្លាំង ឈរជើង តាម ប៉ុស្តិ៍ នានា តាម ខ្សែក្រវ៉ាត់ ព្រំដែន ជាមួយ វៀតណាម ដោយ បាន អនុវត្ត តាម បទបញ្ជា ថ្នាក់ លើ ។
លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន បាន ពាំនាំ នូវ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ដែល ជានិច្ចកាល លោក តែងតែ នឹករលឹក កងកម្លាំង ជានិច្ច ។
លោក ស្នងការបន្ត ថា ថ្ងៃ នេះ លោក បាន មក ទីនេះ គ្រា ដែល លោក ទើប កាន់ តំណែង ស្នងការ ខេត្ត រតនគិរី ថ្មី ដូច្នេះ ចុះ មក ជួប សំណាល ឲ្យ ស្គាល់ គ្នា ដើម្បី ផ្សារ ភ្ជាប់ មនោសញ្ចេតនា ដ៏ ជ្រាលជ្រៅ រវាង លោក និង ថ្នាក់ដឹកនាំ បាន នាំ គ្រឿង បរិភោគ មាន មី. ត្រីខ. អង្ករ និង ថវិកា ក្នុង ១វរៈ ទទួលបាន ២លាន រៀល ។
លោក ស្នងការបន្ថែម ថា ទោះ អំណោយ តិចតួច ក្តី តែ ទឹកចិត្ត រវាង ថ្នាក់ដឹកនាំ និង កម្លាំង នគរបាល ក្រោម វាទ ប្រៀប ដូច សាច់ ឈាម រួម សុខ . រួម ទុក្ខ ជាមួយគ្នា គ្រប់ កាលៈទេសៈ ៕ គណៈកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ ចុះ ពិនិត្យមើល សិប្បកម្ម ផលិត គ្រឿង ឧបភោគ បរិភោគ មួយ កន្លែង សង្កាត់ កាកាប២ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ ដឹកនាំ ដោយ នាយ ឧត្តមសេនីយ៍ មៀច សុផាន់ ណា រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន នៃ គណៈកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ បាន ចុះ ត្រួតពិនិត្យ ដោយ ផ្ទាល់ ជា លើក ទី២ នៅ ទីតាំង រោងចក្រ សិប្បកម្ម ផលិត គ្រឿង ឧបភោគ បរិភោគ មួយ កន្លែង ដែល ស្ថិត ក្រោម ស្លាក យីហោ មិន វៃ សៀន ធ្លាប់ បាន ចុះ ពិនិត្យ លើក ទី១ កន្លងមក ទាក់ទង និង គុណភាព ក្នុង ការផលិត ស្តង់ដា នៃ ការផលិត គ្រឿង ឧបភោគ បរិភោគ សរុប ជាង ៤០មុខ ។
ការ ចុះ ត្រួតពិនិត្យ ជា លើ ទី២នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ ដែល មាន ទីតាំង ស្ថិត នៅក្បែរ អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ ភ្នំពេញ ក្នុង សង្កាត់ កាកាប២ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
គួរ បញ្ជាក់ ផងដែរ ថា៖ នេះ ជា លើក ទី២ហើយ នៃ ការចុះ ត្រួតពិនិត្យ ទីតាំង រោងចក្រ សិប្បកម្ម ផលិត គ្រឿង ឧបភោគ បរិភោគ ខាងលើ នេះ ដោយ លើក ទី១ គឺ ដឹកនាំ ដោយ លោក វរសេនីយ ឯក កឹម វិសាល ប្រធាន ក្រុម បង្គាប់ ការ កម្លាំង ពិសេស នៃ គណៈកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ ។
ដោយ នៅក្នុង ការចុះ ត្រួតពិនិត្យ ជា លើក ទី២នេះ ផងដែរ ម្ចាស់ សិប្បកម្ម ខាងលើ បាន បង្ហាញ នូវ ទីតាំង ជាច្រើន ដែល រួម មាន បន្ទប់ ពិសោធន៍ បន្ទប់ រក្សា វត្ថុធាតុ ដើម បន្ទប់ ម៉ាស៊ីន ផលិត និង ទីតាំង ផលិត ជាច្រើន ដែល ប្រកប ទៅ ដោយ ផាសុខភា នៅក្នុង រោងចក្រ សិប្បកម្ម ផលិត គ្រឿង ឧបភោគ បរិភោគ ខាងលើ នេះ ផងដែរ ។
ម្ចាស់ សិប្បកម្ម បាន បន្ថែម ថាៈ ខាង យើងខ្ញុំ មាន ឯកសារ មាន ច្បាប់ អនុញាតិ ត្រឹមត្រូវ និង ផ្ដោត សំខាន់ បញ្ជាក់ ថា ផលិតផល យើងខ្ញុំ ជា ផលិតផល ដែល មាន គុណភាព ល្អ ពុំ មាន ប៉ះពាល់ ដល់ សុខភាព ឡើយ ។
សូម បញ្ជាក់ ថា ឧត្តមសេនី យ៏ ឯក ជា ស្រេង ជា អ្នក ចេះ ភាសា ចិន និង ជា អ្នករៀបចំ ឲ្យ ក្រុមហ៊ុន នេះ បាន មក និវិយោត្រឹមត្រូវ នៅ កម្ពុជា សូម ចូលរួម គាំទ្រ នូវ សិប្បកម្ម ក្នុង ស្រុក យើង ទាំងអស់ គ្នា ៕
ឥណ្ឌា៖ មាន ករណី ផ្ទុះ កើតឡើង នៅ ចំណត រថយន្តក្រុង ក្នុង តំបន់ កាស្មៀរ បណ្តាលឲ្យ មនុស្ស ១៨ នាក់ រងរបួស
( ស្រ៊ីណាហ្គា) ៖ យ៉ាងហោចណាស់ មនុស្ស ចំនួន ១៨ នាក់ បាន រងរបួស នៅក្នុង ការបំផ្ទុះ មួយ នា ចំណង រថយន្តក្រុង ក្នុង តំបន់ កាស្មៀរ នៅក្នុង ថ្ងៃព្រហស្បតិ៍ នេះ តែម្តង ខណៈ ដែល ស្ថានការណ៍ ជម្លោះ រវាង ប្រទេស ឥណ្ឌា និង ប៉ាគីស្ថាន ទើប បាន ធូរស្រាល បន្តិច ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នា រសៀល ថ្ងៃព្រហស្បតិ៍ ទី០៧ ខែមីនា ឆ្នាំ ២០១៩ ។
គម្រោង ៣ឆ្នាំ គឺ « ការពង្រឹង សមត្ថភាព រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ នៅ កម្ពុជា លើ វិស័យ រៀបចំ ក្រុង ប្រកបដោយ និរន្តរភាព ដើម្បី រៀបចំ ឡើងវិញ តំបន់ អនាធិបតេយ្យ និង ធានា នូវ លទ្ធភាព ទទួល បាន សេវាកម្ម សំខាន់ ៗ សម្រាប់ ជន ក្រីក្រ » ។
MoU ត្រូវបាន ចុះហត្ថលេខា រវាង លោក ព្យែរ ប៊យ៉ៃ អគ្គ លេខាធិការ សមាគម អន្តរជាតិ អភិបាល ក្រុង ប្រើប្រាស់ ភាសា បារាំង (AIMF) លោក ម៉ប់ សារិន ប្រធាន សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី - ខេត្ត និង លោក ស យ កុសល សម្ព័ន្ធភាព ជាតិ ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ។
គម្រោង នឹង ត្រូវ អនុវត្ត ក្នុង ភាពជាដៃគូ សហការ រវាង AIMF រដ្ឋបាល រាជធានី ភ្នំពេញ សាលាក្រុង ប៉ារីស សម្ព័ន្ធភាព ជាតិ ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី - ខេត្ត និង ប្រតិភូ សហភាព អឺរ៉ុប ប្រចាំ កម្ពុជា ។
( ភ្នំពេញ ) ៖ ក្នុង ឱកាស ដែល ប្រទេស កម្ពុជា ដ៏ ដូច ពិភពលោក ទាំងមូល ប្រារព្ធ ទិវា នារី អន្តរជាតិ ៨មីនា ខួប លើក ទី ១០៨ នោះ . ក្រសួង បរិស្ថាន បាន ផលិត នូវ វីដេអូ ថ្មី មួយ មាន រយៈពេល ជាង ១៣នាទី ដើម្បី ចូលរួម អបអរ ទិវា នេះ និង បង្ហាញ ឲ្យ ឃើញ ផងដែរ នូវ តួនាទី យ៉ាង សំខាន់ របស់ ស្ត្រី ក្នុង កិច្ចការពារ បរិស្ថាន ៕
សូម ទស្សនា វីដេអូ របស់ ក្រសួង បរិស្ថាន ដូច ខាងក្រោម៖ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩
២៖ សម្តេច តេជោ ហ៊ុន សែន៖ កម្ពុជា អរគុណ ប្រទេស ទាំងអស់ ដែល ជួយ ឧបត្ថម្ភ ដោយ ស្មោះ ប៉ុន្តែ កម្ពុជា មិន ប្តូរ អធិបតេយ្យភាព ជាមួយ ជំនួយ ដាច់ខាត ( ចុច អាន )
៥៖ លោក មេធាវី គី តិច៖ ការបង្កើត ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន សំដៅ ជួយ ការពារ សិទ្ធិ ជូន នារី រងគ្រោះ ស្ត្រី ជាប់ ឃុំឃាំង និង ស្ត្រី ក្រីក្រ នៅ កម្ពុជា ដោយ មិន គិត ថ្លៃ សេវា ( ចុច អាន )
៦៖ ក្រសួង រ៉ែ៖ គ្មាន ការចុះបញ្ជី កម្មសិទ្ធិ ទ្រព្យសម្បត្តិ រដ្ឋ លើ ដី ជាង ៥ហិចតា ក្បែរ ភ្នំ ដោះ ក្រមុំ ខេត្ត មណ្ឌលគិរី ដូច ការលើកឡើង នោះ ទេ ( ចុច អាន )
៧៖ ក្រសួង កសិកម្ម ដាក់ ចេញ វិធានការពង្រឹង ការធ្វើ អាជីវកម្ម នាំចូល ជ្រូក គោ ក្របី និង ការដឹក ឆ្លងកាត់ កម្ពុជា ( ចុច អាន )
៩៖ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ បិទ មិន ឱ្យ ប្រើប្រាស់ ប្រព័ន្ធ ទូរស័ព្ទ នៅ តាម ពន្ធនាគារ ទូទាំង ប្រទេស ( ចុច អាន )
១០៖ ថ្ងៃ នេះ ថ្ងៃទី ៥នៃ ដំណើរការធ្វើ ជំរឿន ទូទៅ ប្រជាជន កម្ពុជា សូម បងប្អូន ជន រួម ជាតិ ចូលរួម គាំទ្រ និង ផ្តល់ ការសហការ ឲ្យបាន គ្រប់ ៗ គ្នា ( ចុច អាន )
៣៖ អាជ្ញាធរ វេណេស៊ុយអេឡា ដោះលែង អ្នកកាសែត អាមេរិក ម្នាក់ ក្រោយ ឃុំ ខ្លួន មួយ រយៈពេល ខ្លី ( ចុច អាន )
៤៖ បេសកជន ពិសេស អាមេរិក ប្រចាំ វេណេស៊ុយអេឡា ត្រូវ អ្នក កំប្លែង រុស្ស៊ី បោក ឲ្យ ព្យាយាម បង្កក គណនី ក្លែងក្លាយ របស់ លោក ម៉ាឌូរ៉ូ នៅក្នុង ធនាគារ ស្វីស ( ចុច អាន )
៦៖ ប្រវត្តិ វិទូ អន្តរជាតិ៖ ជម្លោះ អ៊ីស្រាអែល - ប៉ាឡេស្ទីន គ្មាន ថ្ងៃ ចប់ ឡើយ បើ គ្រាន់តែ UN ចេញ សេចក្តីថ្លែងការណ៍ តែ អត់ ចេញ សកម្មភាព ជាក់ស្តែង ( ចុច អាន )
៨៖ ព្រឹទ្ធ សមាជិក អាមេរិក ទម្លាយ៖ « ខ្ញុំ ធ្លាប់ ត្រូវបាន មន្ត្រី ជាន់ ខ្ពស់ ម្នាក់ ចាប់រំលោភ កាល នៅ បម្រើ ការងារ ក្នុង ជួរ កងទ័ព អាកាស ( ចុច អាន )
១០៖ ប៉ាគីស្ថាន ឃុំ ខ្លួន ជន សកម្ម ប្រយុទ្ធ ៤៤ នាក់ ក្រោយ ការវាយប្រហារ ដ៏ ប្រល័យ នៅ តំបន់ កាស្មៀរ ( ចុច អាន )
សម្ដេច ក្រឡាហោម ស ខេង៖ ក្រសួង មហាផ្ទៃ ត្រូវ លុបបំបាត់ ឲ្យបាន ជាដាច់ខាត ការរើសអើង យេនឌ័រ (Video Inside) ( ភ្នំពេញ ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ នៅ ល្ងាច ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន លើកឡើង ថា ក្រសួង មហាផ្ទៃ ត្រូវតែ លុបបំបាត់ ឲ្យបាន ជាដាច់ខាត នូវ ប្រកាន់ ទស្សនៈ និង រើសអើង យេនឌ័រ ដែល នាំឲ្យ មាន ភាពលម្អៀង រវាង ស្ដ្រី និង បុរស ឬ ការវាយតម្លៃ ពី ប្រសិទ្ធភាព ការងារ និង ដើម្បី សម្រេចបាន យុទ្ធសាស្ដ្រ របស់ រាជ រដ្ឋាភិបាល ។
ការលើកឡើង របស់ សម្ដេច ក្រឡាហោម ស ខេង ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ជាមួយ ឧត្តម ភរិយា ក្នុង ពិធី អបអរសាទរ ទិវា អន្ដរជាតិ នារី ៨មីនា ក្រោម ប្រធានបទ « លើក កំពស់ សមភាព យេនឌ័រ និង ការគាំពារ សង្គម ដើម្បី អភិវឌ្ឍ ធនធាន មនុស្ស » ដែល រៀបចំឡើង ដោយ ក្រសួង មហាផ្ទៃ និង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ មន្ដ្រីរាជការ ជា នារី ជាច្រើន រូប ផងដែរ ។
សម្ដេច ប្រមុខ ដឹកនាំ ក្រសួង មហាផ្ទៃ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ក្រសួង មហាផ្ទៃ សូម បញ្ជាក់ ការប្ដេជ្ញាចិត្ត ជាថ្មី គឺ ត្រូវ លុបបំបាត់ ឲ្យបាន ដាច់ខាត នូវ ទស្សនៈ ឬ ក៏ ការរើសអើស យេនឌ័រ នៅក្នុង ក្រសួង ដែល នាំឲ្យ មាន ភាពលម្អៀង រវាង ស្ដ្រី និង បុរស ក្នុង ការវាយតម្លៃ អំពី ប្រសិទ្ធភាព ការងារ របស់ ស្ដ្រី ដែល នេះ ខ្ញុំ គិត ថា មិន មែន ជា ចំណុច ថ្មី នោះ ទេ គឺជា ចំណុច ដែល យើង បាន ចាប់ផ្ដើម តាំងពីដើម មក » ។
សម្ដេច ក្រឡាហោម ស ខេង បាន គូសបញ្ជាក់ ថា រហូតមកដល់ ពេលនេះ ស្ថាប័ន រដ្ឋ ទាំងអស់ មិន មែន ជាប់ជំពាក់ នូវ រឿង នេះ ទេ ( រើសអើង យេនឌ័រ ) ប៉ុន្ដែ ផ្ទុយទៅវិញ ដើម្បីឲ្យ ចេញ ជា លទ្ធផល ជាក់ស្ដែង អ្នក ពាក់ព័ន្ធ ទាំងអស់ ត្រូវតែ ខិតខំ ដើម្បី លើកកម្ពស់ គុណភាព ស្ដ្រី តាមរយៈ ការផ្ដល់ នូវ តួនាទី ភារកិច្ច តាមរយៈ ការខិតខំ ប្រឹងប្រែង របស់ ស្ដ្រី ខ្លួន ឯង ។
ទន្ទឹមនឹង ការជួយជ្រោមជ្រែង ពី បុរស នោះ ស្ដ្រី ខ្លួន ឯង ក៏ ត្រូវតែ ខិតខំ បំពេញ ការងារ របស់ ខ្លួន ផងដែរ ដើម្បី សម្រេច គោលដៅ បើ មិន ដូច្នេះ ទេ មិន អាច ទៅ រួច នោះ ឡើយ ។ នេះ ជា អ្វី ដែល សម្ដេច ក្រឡាហោម ស ខេង បាន គូសបញ្ជាក់ ។
បើ តាម លោកស្រី ជូ ប៊ុន អេង រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន ក្រុមការងារ យេនឌ័រ ក្រសួង មហាផ្ទៃ បាន លើកឡើង ថា ស្ថានភាព ក្របខណ្ឌ មន្ត្រីរាជការ ស៊ីវិល និង មន្ត្រី ពន្ធនាគារ មាន ចំនួន សរុប ១៣. ២៤១ រូប ស្ត្រី ៣.៣០០ រូប ។
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន ថ្លែង ថា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ គឺជា ឆ្នាំ ដែល ក្រសួង ការបរទេស បាន ធ្វើ ការតស៊ូ យ៉ាង ស្វិតស្វាញ នៅលើ សមរភូមិ ការ ទូត និង សាធារណមតិ ដើម្បី ការពារ និង លើកកម្ពស់ មុខមាត់ និង កិត្យានុភាព ជាតិ ។
ការលើកឡើង របស់ ប្រមុខ ការទូត កម្ពុជា បាន ធ្វើឡើង នៅក្នុង ពិធី បិទ សន្និបាត ប្រចាំ ឆ្នាំ របស់ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នា ព្រឹក ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ ។
លោក ប្រាក់ សុខុន បាន រំលេច អំពី ការងារ ធំ ៗ ចំនួន ៥ ចំណុច ដែល ក្រសួង ការបរទេស បាន ខិតខំ បំពេញ នៅ ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ។ លោក បាន បញ្ជាក់ តាម លំដាប់លំដោយ ថា៖
ការងារ ធំ ទី១៖ ការការពារ ផលប្រយោជន៍ ជាតិ ជាពិសេស ការការពារ ឯករាជ្យ និង អធិបតេយ្យភាព ឆ្នាំ ២០១៨ គឺជា ឆ្នាំ ដែល ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន ធ្វើ ការតស៊ូ យ៉ាង ស្វិតស្វាញ នៅលើ សមរភូមិ ការ ទូត និង សាធារណៈ មតិ ដើម្បី ការពារ និង លើកកម្ពស់ មុខមាត់ និង កិត្យានុភាព ជាតិ នៅក្នុង តំបន់ និង នៅលើ ឆាក អន្តរជាតិ ក៏ ដូចជា ការទប់ទល់ វាយ បក ប្រឆាំង ទៅនឹង ការជ្រៀត ជ្រែក ចូល កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា ។
* ក្រសួង បាន ចងក្រង និង ផ្សព្វផ្សាយ យ៉ាង ទូលំទូលាយ នូវ អត្ថបទ « ប្រាប់ ពី ការពិត » បកស្រាយ ពី សភាពការណ៍ នយោបាយ នៅ កម្ពុជា និង ចេញ សេចក្តីថ្លែងការណ៍ ជា បន្តបន្ទាប់ ឆ្លើយតប ចំពោះ ការបំផ្លើស មួល បង្កាច់ ខុសពី សភាពការណ៍ ពិត និង បញ្ជាក់ ពី ជំហរ ម៉ឺងម៉ាត់ ដាច់ខាត ក្នុង ការការពារ ឯករាជ្យ អធិបតេយ្យ ជាតិ កម្ពុជា ។
* ចាត់ បញ្ជូន បេសកកម្ម សុឆន្ទៈ ទៅ បកស្រាយ បំភ្លឺ ជូន ឥស្សរជន សំខាន់ ៗ នៃ គណៈកម្មការ អឺរ៉ុប និង ជួបពិភាក្សា ជាមួយ សមាជិក សភា អឺរ៉ុប មួយចំនួន ។
* ធ្វើ ការចរចា ជាមួយ ប្រទេស ជិតខាង នៅក្នុង ការដោះស្រាយ បញ្ហា ព្រំដែន ដែល នៅ សេសសល់ ដោយ សន្តិវិធី ដើម្បី ប្រែក្លាយ តំបន់ ព្រំដែន ឲ្យ ទៅជា តំបន់ សន្តិភាព មិត្តភាព កិច្ចសហប្រតិបត្តិការ និង ការអភិវឌ្ឍ ។
* ជួយ អន្តរាគមន៍ សង្គ្រោះ និង ធ្វើ មាតុភូមិ និវត្តន៍ ប្រជាពលរដ្ឋ ខ្មែរ ជាពិសេស ពលករ ពល ការីនី ខ្មែរ ដែល រងគ្រោះ ពី ការរំលោភបំពាន នៅ បរទេស បាន ចំនួន ៨៤៨៩ នាក់ ។
ក្នុង កម្រិត រដ្ឋមន្ត្រី ការបរទេស ខ្ញុំបាទ ផ្ទាល់ បាន បំពេញ ទស្សនកិច្ច ផ្លូវការ និង ការងារ ជា បន្តបន្ទាប់ នៅ មីយ៉ាន់ម៉ា ឡាវ ឥណ្ឌូនេស៊ី សិង្ហ បូរី ជប៉ុន ហុង គ្រី រូម៉ានី តួកគី វៀតណាម និង ប៊ែល ហ្សីក និង បាន ធ្វើជា សហ ប្រធាន ដឹកនាំ កិច្ចប្រជុំ គណៈកម្មការ ចម្រុះ កម្ពុជា - វៀតណាម . កម្ពុជា - ឡាវ . កម្ពុជា - ឥណ្ឌូណេស៊ី . កម្ពុជា - មីយ៉ាន់ម៉ា និង កិច្ចប្រជុំ គណៈកម្មាធិការ អន្តរ រដ្ឋាភិបាល កម្ពុជា - រុស្ស៊ី ។
ការងារ ធំ ទី៤៖ គឺ ការចូលរួម ឱ្យ កាន់តែ សកម្ម ថែម ទៀត ដល់ បុព្វហេតុ សន្តិភាព ស្ថិរភាព និង ការប្រយុទ្ធ នឹង ការប្រឈម នានា នៃ ពិភពលោក តួយ៉ាង ប្រយុទ្ធ ប្រឆាំង ភេរវកម្ម ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ការប្រែប្រួល អាកាសធាតុ ជំងឺ ឆ្លង ។ល ។
មេ សិទ្ធិ មនុស្ស កម្ពុជា៖ ស្រ្តី កម្ពុជា ទាំងអស់ កាន់តែ ទទួល សិទ្ធិ ការពារ បន្ថែម តាមរយៈ ការផ្តល់ សេវា មេធាវី ស័្ម គ្រចិត្ត របស់ សម្តេច តេជោ
( ភ្នំពេញ ) ៖ លោក កែវ រ៉េមី ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន លើកឡើង ថា ការបង្កើត ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ ការពារ ស្រ្តី ក្រីក្រ នឹង កាន់តែ បង្កើន តម្លៃ ស្រ្តី និង ការការពារ សិទ្ធិ យ៉ាង ពេញលេញ ដល់ ស្រ្តី កម្ពុជា ទាំងអស់ ។
ការថ្លែង ដូចនេះ របស់ លោក កែវ រ៉េមី បាន ធ្វើឡើង នៅ ចំពោះមុខ អ្នកសារព័ត៌មាន បន្ទាប់ពី បញ្ចប់ ពិធី សំណេះសំណាល ជាមួយ ជនជាប់ ឃុំ ជា ស្រ្តី រាប់ រយ នាក់ នៅ មណ្ឌល អប់រំ កែប្រែ ទី២ ( ម២) ខណៈ ខួប ទិវា សិទ្ធិ នារី លើក ទី១០៨ រៀងរាល់ ថ្ងៃទី ៨ ខែមីនា ។ ពិធី សំណេះសំណាល នេះ មាន ការចូលរួម ពី រដ្ឋមន្រ្តី ក្រសួង កិច្ចការ នារី លោកស្រី អ៉ឹង កន្ថា ផាវី និង លោក គី តិច ប្រធាន ក្រុម មេធាវី ស័្ម គ្រចិត្ត របស់ សម្តេច តេជោ សែន ផងដែរ ។
លោក កែវ រ៉ែ មី ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា មានប្រសាសន៍ ថា កម្ពុជា បាន បំពេញ កាតព្វកិច្ច គ្រប់គ្រាន់ ចំពោះ ការពារ សិទ្ធិ ជូន ប្រជាពលរដ្ឋ ជាពិសេស ស្រ្តី ។ ជាមួយគ្នា នេះ កាលពី ខែកុម្ភៈ កន្លង សម្តេច តេជោ បាន ប្រកាស បង្កើន ក្រុម មេធាវី ស័្ម គ្រចិត្ត ការពារ ស្រ្តី ក្រីក្រ ដែល នេះ គឺជា នយោបាយ មួយ ក្នុង ការបង្កើន ប្រសិទ្ធភាព និង ការពារ សិទ្ធិ ជូន ស្រ្តី កាន់តែ ទូលំទូលាយ ។
ជាមួយគ្នា នេះ ដែរ មេ សិទ្ធិ មនុស្ស កម្ពុជា រូប នេះ បញ្ជាក់ ថា ចំពោះ ស្រ្តី ដែល កំពុង ជាប់ ឃុំ នៅ មណ្ឌល អប់រំ កែប្រែ ទី២ គឺ នឹង កាន់តែ ងាយស្រួល ដល់ ដំណើរការ ផ្សេង ៗ របស់ ស្រ្តី ជាប់ ឃុំ ដែល នឹង គ្របដណ្តប់ ដល់ ពួកគេ គ្រប់ កាលៈទេសៈ ។
បន្ទាប់ ពិធី សំណេះសំណាល ប្រតិភូ នៃ ស្ថាប័ន ពាក់ព័ន្ធ បាន ពិនិត្យ ទៅ តាម បន្ទប់ ស្នាក់ នៅ និង ការបណ្តុះបណ្តាល ដល់ ជន ជាប់ ឃុំ ជា ស្រ្តី អនីតិជន ក្នុង ការធានា ការ អប់រំ កែប្រែ ខ្លួន ជាថ្មី ក្នុង សង្គម បន្ទាប់ពី ការអនុវត្ត ទោស នោះ ៕
ក្រសួង ទេសចរណ៍ កម្ពុជា ចូលរួម កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្ត្រី ទេសចរណ៍ វិថី សូត្រ លើក ទី៩ របស់ អង្គការ ទេសចរណ៍ ពិភពលោក នៅ ទីក្រុង ប៊ែឡាំង ប្រទេស អាឡឺម៉ង់
( អាឡឺម៉ង់ ) ៖ លោក ទិត ចន្ថា រដ្ឋលេខាធិការ ប្រចាំ ការ និង ជា តំណាង លោក បណ្ឌិត ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ បាន ចូលរួម កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្ត្រី ទេសចរណ៍ វិថី សូត្រ លើក ទី៩ របស់ អង្គការ ទេសចរណ៍ ពិភពលោក នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០១៩ ស្រប ជាមួយនឹង ព្រឹត្តិការណ៍ ពិព៍រណ៌ ទេសចរណ៍ អន្តរជាតិ ITB 2019 ដែល ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ០៦ ដល់ ១០ ខែមីនា ឆ្នាំ ២០១៩ នៅ ទីក្រុង ប៊ែឡាំង ប្រទេស អាឡឺម៉ង់ ។
លោក ទិត ចន្ថា ក៏ បាន ជម្រាប ជូន លោក អគ្គ លេខាធិការ ផងដែរ ថា រាជ រដ្ឋាភិបាល កម្ពុជា មាន បំណង អញ្ជើញ លោក អគ្គ លេខាធិការ ធ្វើ ទស្សនកិច្ច ទៅកាន់ ប្រទេស កម្ពុជា នា ពេល ខាងមុខ នេះ ។
សូម កត់សម្គាល់ ផងដែរ ថា ប្រតិភូ ក្រសួង ទេសចរណ៍ កម្ពុជា និង ក្រុមហ៊ុន ទីភ្នាក់ងារ ទេសចរណ៍ ក្នុង ស្រុក ចំនួន ១១ក្រុមហ៊ុន ក៏ បាន និង កំពុង ចូលរួម ផ្សព្វផ្សាយ និង ទាក់ទាញ ទេសចរ នៅក្នុង ព្រឹត្តិការណ៍ ពិព៍រណ៌ ទេសចរណ៍ អន្តរជាតិ ITB 2019 ចាប់ពី ថ្ងៃទី ៦ ដល់ ១០ ខែមីនា ឆ្នាំ ២០១៩ ។
ព្រឹត្តិការណ៍ ពិព៍រណ៌ ទេសចរណ៍ អន្តរជាតិ ITB 2019 ជា វេទិកា ផ្សព្វផ្សាយ ទេសចរណ៍ សាកល ដ៏ ធំ បំផុត របស់ អឺរ៉ុប ដែល មាន ការចូលរួម យ៉ាង សកម្ម ពី ស្ថាប័ន សាធារណៈ និង ផ្នែក ឯកជន ក្នុង ឧស្សាហកម្ម ទេសចរណ៍ រហូតដល់ ជាង ១០ម៉ឺន នាក់ ក្នុង នោះ អ្នកទិញ ដ៏ មាន សក្តានុពល ប្រមាណ ១០០០ ក្រុមហ៊ុន មកពី ជាង ១៨០ ប្រទេស ដែល តាម ការប៉ាន ស្មាន អាច បង្កើត ទំហំ ប្រាក់ ចំណូល ជាង ៧ពាន់ លាន ដុល្លារ អាមេរិក ក្នុង រយៈពេល ៥ ថ្ងៃ នៃ ព្រឹត្តិការណ៍ នេះ ៕
ប្រធាន សមាគម អប់រំ ព្រះពុទ្ធ សាសនា ពិភពលោក ទីក្រុង ហុងកុង បំពេញ ទស្សនកិច្ច រោង ម៉ាស៊ីន កិន ស្រូវ សុខ កែវ ខេត្ត តាកែវ
( តាកែវ )៖ លោកស្រី សុខ កែវ ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ក្រុមហ៊ុន សុខ កែវ បាន ទទួលស្វាគមន៍ ព្រះតេជគុណ ស៊ី ជីង ឈីង ប្រធាន សមាគម អប់រំ ព្រះពុទ្ធ សាសនា ពិភពលោក ទីក្រុង ហុងកុង និង គណៈប្រតិភូ ចិន ជប៉ុន និង កូរ៉េ ដើម្បី ទស្សនា រោង ម៉ាស៊ីន កិន ស្រូវ សុខ កែវ ដែល មាន ទីតាំង ស្ថិត ក្នុង ស្រុក ត្រាំ កក់ ខេត្ត តាកែវ ។
សូម ជម្រាប ថា មុន បំពេញ ទស្សនកិច្ច នៅ រោង ម៉ាស៊ីន កិន ស្រូវ ប្រធាន សមាគម អប់រំ ព្រះពុទ្ធ សាសនា ពិភពលោក ទីក្រុង ហុងកុង និង គណៈប្រតិភូ ចិន ជប៉ុន និង កូរ៉េ ក៏ ត្រូវបាន ទទួលស្វាគមន៍ ពីសំណាក់ លោក ច័ន្ទ សារុន អ្នកតំណាងរាស្រ្ត មណ្ឌល ខេត្ត តាកែវ ផ្លាស់ប្តូរ យោបល់ ក៏ ដូចជា បទពិសោធន៍ ជាមួយគ្នា ផងដែរ នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០១៩ ។
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៧ ខែមីនា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៤៨៤ គ្រឿង និង ផាក ពិន័យ ៣០៤ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន គ្រឿង ២.៥២៦ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៤៨៤ គ្រឿង ( ម៉ូតូ ៧២ %) អប់រំ១៨០ គ្រឿង និង ផាក ពិន័យ ៣០៤ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ៧ ខែមីនា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ១. ៤០៦ គ្រឿង . អប់រំ១០៨ គ្រឿង និង ផាក ពិន័យ ៣០៤ គ្រឿង ៕
ធនាគារ ជាតិ នៃ កម្ពុជា រៀបចំ ទិវា នារី អន្ដរជាតិ ៨មីនា ក្រោម ប្រធានបទ « ការលើកកម្ពស់ សមត្ថភាព យែនឌ័រ និង ការអភិវឌ្ឍ ធនធាន មនុស្ស »
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា បាន រៀបចំ ទិវា នារី អន្ដរជាតិ ៨មីនា ក្រោម ប្រធានបទ « ការលើកកម្ពស់ សមត្ថភាព យែនឌ័រ និង ការអភិវឌ្ឍ ធនធាន មនុស្ស » ក្រោម ការចូលរួម ពី លោក ជា ជាន់ តូ អគ្គ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា ព្រមទាំង មន្រ្ដី ធនាគារ ជាតិ ជាច្រើន រូប ទៀតផង ។
ថ្លែង ក្នុង កម្មវិធី អបអរសារទរ ខួប អនុស្សាវរីយ៍ លើក ទី ១០៨ នៃ ទិវា នារី អន្ដរជាតិ ៨មីនា នៅ ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០១៩ លោក ជា ចាន់តូ ឲ្យដឹង ថា « ស្រ្តី បម្រើ ការងារ ក្នុង ធនាគារ ជាតិ នៃ កម្ពុជា ភាគ ច្រើន ទទួលខុសត្រូវ លើ ការងារ និង គ្រប់គ្រង ការងារ ជំនាញ បច្ចេកទេស និង ការងារ ប្រតិបត្តិការ ជាដើម » ។
លោក អគ្គ ទេសាភិបាល បាន បង្ហាញ ឱ្យ ឃើញ អំពី សមត្ថភាព នៃ ស្រ្ដី លើ វិស័យ ធនាគារ ជាតិ និង ជឿជាក់ ចំពោះ ការបំពេញ តួនាទី ភារកិច្ច របស់ ស្រ្ដី គ្រប់ លំដាប់ថ្នាក់ នៃ ការគ្រប់គ្រង ធនាគារ ។
ទិវា នារី អន្តរជាតិ ៨មីនា ត្រូវបាន ប្រារព្ធ ឡើង នៅ ទូទាំង សកលលោក ដើម្បី រំឭក ពី ប្រវត្តិ នៃ ការតស៊ូ និង វីរភាព របស់ នារី ដែល បាន ខិតខំ តស៊ូ ទាមទារ នូវ សមធម៌ ការគោរព សិទ្ធិ សេរីភាព ស្មើគ្នា ចំពោះ មុខ ច្បាប់ និង ការទទួលស្គាល់ តម្លៃ ស្រ្តី ក្នុង ការអភិវឌ្ឍ គ្រួសារ និង ជាពិសេស ដើម្បី អបអរសាទរ សមិទ្ធផល ផ្នែក សេដ្ឋកិច្ច នយោបាយ និង វប្បធម៌ ដែល នារី បាន រួមចំណែក កសាង និង អភិវឌ្ឍ ជូន ប្រទេសជាតិ មាតុភូមិ ។
ស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា តែងតែ ប្រារព្ធ ពិធី នេះ ជារៀងរាល់ ឆ្នាំ ដើម្បី លើកកម្ពស់ និង ថ្លែងអំណរគុណ ចំពោះ ថ្នាក់ដឹកនាំ និង មន្រ្តី បុគ្គលិក ជា នារី នៅ ធនាគារ ជាតិ នៃ កម្ពុជា ដែល បាន រួមចំណែក កសាង និង អភិវឌ្ឍ ប្រព័ន្ធ ធនាគារ នៅ កម្ពុជា ឱ្យ មាន ការរីកចម្រើន ជា បន្តបន្ទាប់ ៕ ស្រី្ត កូន ខ្ចី ចាស់ជរា និង គ្មាន ទីពឹង ៤០ គ្រួសារ ក្នុង ខណ្ឌ ឬស្សីកែវ ទទួល អំណោយ កាកបាទ ក្រហម កម្ពុជា
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ជាស្រី្ត កូន ខ្ចី ចាស់ជរា និង គ្មាន ទីពឹង ពោល ជា ជន ងាយ រងគ្រោះ ចំនួន ៤០ គ្រួសារ មកពី តាម បណ្ដា ភូមិ ចំនួន ៤ ស្ថិត ក្នុង សង្កាត់ ច្រាំង ចំរេះ ទី២ ខណ្ឌ ឫស្សីកែវ នៅ ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន ទទួល អំណោយ គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា ក្នុង ការដោះស្រាយ ក្នុង ជីវភាព ពី ប្រតិភូ ប្រធាន អនុសាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ដែល ដឹកនាំ ដោយ លោក ស៊ូ សោគ ន្ធ ក្រោម អធិបតីភាព លោក ជា ពិសី អភិបាល ខណ្ឌ ។
លោក ជា ពិសី បាន ថ្លែង ថា សម្រាប់ ក្រុមការងារ អនុសាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ឫស្សីកែវ ដែល បាន នាំយក នូវ គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា មក ឧបត្ថុម្ភ ជូន នា ពេលនេះ គឺ តំណាង ឲ្យ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ហើយ សម្រាប់ ចែកជូន ចំពោះ តែ ប្រជាពលរដ្ឋ ក្រីក្រ ប៉ុណ្ណោះ ដូចជា ជន គ្មាន ទីពឹង ជន ចាស់ជរា អ្នក កើត ជំងឺ រ៉ាំរៃ ពោលគឺជា ជន ងាយ រងគ្រោះ ។
លោក អភិបាល ខណ្ឌ ឬស្សីកែវ បន្ត ថា ក្រៅពី អនុ សាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ជា តំណាង ជានិច្ច ជាកាល សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា តែងតែ ផ្ដាំផ្ញើ សាកសួរ សុខទុក ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ ទូទៅ ដោយ មិន ប្រកាន់ ពូជសាស ពណ៍ សម្បុរ ឫ និន្នាការ នយោបាយ ឡើយ តាមរយៈ អាជ្ញាធរ ខណ្ឌ រហូតមកដល់ សង្កាត់ និង ភូមិ ពីព្រោះ សុខ ទុក របស់ ប្រជាពលរដ្ឋ កម្ពុជា គឺជា សុខ ទុក្ខ របស់ លោក ទាំង ទ្វេ ៕
សូម ពលរដ្ឋ ត្រៀម ឯកសារ ! អភិបាល ខណ្ឌ ឫស្សីកែវ ប្រកាស តំបន់ វិនិឆ្ឆ័យ នៃ ការចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ ជូន ប្រជាពលរដ្ឋ ក្នុង សង្កាត់ ទួល សង្កែ ទី ២
( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ឬស្សីកែវ បាន ប្រកាស ឲ្យ ប្រជាពលរដ្ឋ ជា ម្ចាស់ ក្បាល ដី - ផ្ទះ រស់ នៅ តាម បណ្ដា ភូមិ នានា ក្នុង សង្កាត់ ទួល សង្កែ ទី២ ខណ្ឌ ឫស្សីកែវ ទាំងអស់ ត្រូវ ត្រៀម ឯកសារ ដើម្បី ផ្ដល់ ភាពងាយស្រួល សម្រាប់ មន្ត្រី ជំនាញ ចុះបញ្ជី ក្នុង ការផ្ដល់ ប័ណ្ណ កម្មសិទ្ធិ ជូន ដែល ជា ការគិតគូរ យ៉ាង យកចិត្តទុកដាក់ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ឯកសារ រដ្ឋបាល ដែល កំណត់ ឲ្យ ប្រជាពលរដ្ឋ ត្រៀមលក្ខណៈ នោះ រួម មាន សំបុត្រ បញ្ជាក់ កំណើត សៀវភៅ គ្រួសារ អត្តសញ្ញាណប័ណ្ណ ឬ ឯកសារ ពាក់ព័ន្ធ ដ៍ទៃ ទៀត ដូចជា ឯកសារ ទិញ - លក់ ជាដើម ។
ថ្លែង នា ឱកាស នោះ លោក ជា ពិសី បាន គូសបញ្ជាក់ ថា « សូម បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ កុំ ព្រួយបារម្មណ៍ ឲ្យ សោះ ក្នុង ការចូលរួម ផ្ដល់ ឯកសារ ពាក់ព័ន្ធ ទាំងឡាយ ជូន មន្ត្រី ជំនាញ សម្រាប់ ចុះបញ្ជី ផ្ដល់ ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី ជូន ដោយ ពុំ មាន បង់ ថវិកា ឡើយ » ។
គួរ បញ្ជាក់ ថា ការសម្រេចចិត្ត របស់ តុលាការ ធម្មនុញ្ញ ថៃ ខាងលើ នេះ ត្រូវបាន ធ្វើឡើង តប តាម ពាក្យបណ្តឹង ពី គណៈកម្មការ បោះឆ្នោត ជាតិ ថៃ ដែល បាន ស្នើ តុលាការ ឲ្យ រំលាយ បក្ស ថៃ រក្សា ជាតិ ចោល តែម្តង បន្ទាប់ពី ការសម្តែង ការ មិន ពេញចិត្ត ពី គណបក្ស គាំទ្រ របប យោធា និង ពី ព្រះមហាក្សត្រ ថៃ ព្រះបាទ មហា វ៉ាច្ឆរ៉ាឡុង កន ផ្ទាល់ តែម្តង ។ ក្រៅពី ការរំលាយ បក្ស ចោល រាល់ សមាជិក បក្ស នេះ ទាំងអស់ ចំនួន ១៣រូប ក៏ ត្រូវបាន រារាំង មិន ឲ្យ ធ្វើ នយោបាយ រយៈពេល ១០ឆ្នាំ ថែម ទៀត ផង ៕
រដ្ឋមន្ត្រី ក្រសួង រ៉ែ ជំរុញ ឱ្យ វិនិយោគិន និង អាជីវករ ក្នុង វិស័យ រ៉ែ និង ថាមពល គោរព ច្បាប់ ឱ្យ ខ្ជាប់ខ្ជួន
( កំពង់ស្ពឺ ) ៖ លោក ស៊ុយ សែម រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល បាន ថ្លែង ថា ក្រសួង រ៉ែ មិន ចង់ឱ្យ វិនិយោគិន និង អាជីក រ ដែល មក វិនិយោគ ជួប បញ្ហា ផ្លូវ ច្បាប់ ទេ តែ ក្រសួង ជំនាញ នេះ ចង់ឱ្យ វិនិយោគិន និង អាជីវករ ក្នុង វិស័យ រ៉ែ និង ថាមពល ទាំងអស់ គោរព ច្បាប់ ឱ្យ បាន ត្រឹមត្រូវ ។ ការថ្លែង បែប នេះ របស់ លោក រដ្ឋមន្រ្តី បាន ធ្វើឡើង ក្នុង ពិធី ជួប សំណេះសំណាល ជា មួួយ អាជីវករ រ៉ែ សំណង់ ទូទាំង ខេត្ត កំពង់ស្ពឺ ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ ប្រម៉ាណ ជាង ២០០ ក្រុមហ៊ុន ។
លោក ស៊ុយ សែម បាន សំណូមពរ ដល់ អាជីវករ រ៉ែ សំណង់ ទាំងអស់ ត្រូវ ពិនិត្យ លើ ប្រតិបត្តិការ របស់ ខ្លួន នូវ រាល់ សកម្មភាព មាន ដូចជា ការធ្វើដំណើរ ឬ ដឹកជញ្ជូន ឆ្លងកាត់ តំបន់ ការពារ ដែល ជា ដី កម្មសិទ្ធ ឯកជន ឬ កម្មសិទ្ធិ របស់ រដ្ឋ ត្រូវ មាន ការអនុញ្ញាត ពី ស្ថាប័ន មាន សមត្ថកិច្ច ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ មូលដ្ឋាន ឬ ម្ចាស់ កម្មសិទ្ធិ ឱ្យ បាន ត្រឹមត្រូវ ។
សូម បញ្ជាក់ ថា ក្នុង ពិធី សំណេះសំណាល នេះ ដែរ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន អាន របាយការណ៍ ស្វាគមន៍ និង ជម្រាប ជូន អង្គ ពិធី អំពី គោលបំណង សំខាន់ នៃ កិច្ច សំណេះសំណាល ដើម្បី ធ្វើ ការរំលឹក អំពី លក្ខខ័ណ មួយចំនួន របស់ ក្រសួង រ៉ែ និង ថាមពល ដើម្បី ពង្រឹង ការអនុវត្ត ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព និង ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ៕
ក្រសួង ការងារ ចេញ សេចក្ដីប្រកាស ពី លទ្ធផល សន្និបាត បូក ការងារ ឆ្នាំ ២០១៨ និង ទិសដៅ បន្ត ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ នា ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន សេចក្ដីប្រកាស ព័ត៌មាន បង្ហាញ លទ្ធផល នៃ សន្និបាត បូកសរុប ការងារ នៅ ឆ្នាំ ២០១៨ និង ទិសដៅ បន្ត នៅ ឆ្នាំ ២០១៩ ក្រោយ ប្រព្រឹត្តទៅ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៥ - ០៧ ខែមីនា ៕
