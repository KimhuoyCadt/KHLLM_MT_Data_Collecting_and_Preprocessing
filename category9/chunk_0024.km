( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃចន្ទ ១៥រោច ខែ បុស្ស ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស .២៥៦២ ត្រូវនឹង ថ្ងៃទី ៤ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស សម្តេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ប្រទាន ព្រះរាជ អំណោយ ជា ថវិកា ចំនួន ៥.០០០ ដុល្លារ ( ប្រាំ ពាន់ ដុល្លារ អាមេរិក ) ដល់ កាកបាទ ក្រហម កម្ពុជា ដេីម្បី រួមចំណែក ក្នុង សកម្មភាព មនុស្សធម៌ ។
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត Mohammad Najib ប្រធាន ទំនាក់ទនង កិច្ចការ បរទេស របស់ សមាគម សម្ព័ន្ធ បញ្ញវន្ត មុស្លិម ឥណ្ធូណេស៊ី និង សហការី អញ្ជើញ ជួប ពិភាក្សា ការងារ ជាមួយ លោក អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្រ្តី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា ប្រធាន សហភាព បញ្ញវន្ត មុស្លិ ម កម្ពុជា ក្នុង នេះ ក៏ មាន វត្តមាន របស់ សមាជិក សមាជិកា នៃ សហភាព បញ្ញវន្ត មុស្លិ ម កម្ពុជា ជាច្រើន រូប ផងដែរ ។
ជំនួប ពិភាក្សា នេះ បាន ផ្តោត សំខាន់ ទៅ លើ កិច្ចប្រជុំ លើក ទី២ ដើម្បី សម្រេច បន្ថែម ប្រទេស មួយចំនួន ទៀត ក្នុង អាស៊ី អាគ្នេយ៍ ចូល ជា សមាជិក និង សមាជិក សង្កេតការណ៍ របស់ សមាគម សម្ព័ន្ធ បញ្ញវន្ត មុស្លីម អាស៊ី អាគ្នេយ៍ ដែល កម្ពុជា ត្រូវ ធ្វើជា ម្ចាស់ ផ្ទះ ក្រោយពី សមាគម នេះ ត្រូវបាន ប្រកាស បង្កើត ជា រូបរាង ក្នុង កិច្ចប្រជុំ មួយ នៅ ទីក្រុង ឡាំប៉ុង ប្រទេស ឥណ្ឌូណេស៊ី ពី ថ្ងៃ៦ - ៨ ខែធ្នូ ២០១៨ ក្រោម អធិបតីភាព ប្រធានាធិបតី ឥណ្ឌូណេស៊ី លោក Joko Widodo ។
ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ ស្វាគមន៍ ក្នុង នាម ជា ម្ចាស់ ផ្ទះ សម្រាប់ កិច្ចប្រជុំ ខាងមុខ ដែល គ្រោង នឹង ធ្វើ ការរៀបចំ នា ចុង ខែមីនា ២០១៩ នេះ ហើយ លោក បាន ស្នើឲ្យ ភាគី ឥណ្ឌូណេស៊ី ជា ប្រទេស ផ្តួចផ្តើម បង្កើត សមាគម នេះ មុន គេ សូម ពន្លឿន ពង្រាង លក្ខន្តិក ដើម្បី ផ្តល់ ជូន ប្រទេស សមាជិក ជាពិសេស កម្ពុជា ដែល ត្រូវ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ ក៏ ត្រូវ ការ ពិនិត្យ ឲ្យបាន ហ្មត់ចត់ ដើម្បី ឯកភាព លើ សេចក្តីព្រាង មុននឹង រៀបចំ អញ្ជើញ ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ និង ភាគី ចាំបាច់ ចូលរួម ក្នុង កិច្ចប្រជុំ ៕
ក្រោយ មាន ការព្រមាន ពី លោក ត្រាំ ! តើ សហរដ្ឋ អាមេរិក នឹង លើក ទ័ព ចូល ឈ្លានពាន វេណេស៊ុយអេឡា ?
ម្យ៉ាង វិញ ទៀត បើ គេ និយាយ ត្រឡប់ ក្រោយ សហរដ្ឋ អាមេរិក ក៏ ធ្លាប់ បាន ឈ្លានពាន ប្រទេស មួយចំនួន នៅក្នុង តំបន់ អាមេរិក ឡាទីន ផងដែរ ក្នុង នោះ មាន ដូចជា សាធារណរដ្ឋ ដូមីនិក នៅ ឆ្នាំ ១៩៦៥. ហ្រ្គែន ណា ដា ឆ្នាំ ១៩៨៣ និង ប៉ាណាម៉ា នៅ ឆ្នាំ ១៩៨៩ ក្រោម ហេតុផល ប្រហាក់ប្រហែល គ្នា នោះ គឺ ការការពារ ពលរដ្ឋ អាមេរិក និង ស្ដារ លិទ្ធិ ប្រជាធិបតេយ្យ ។
គួរ បញ្ជាក់ ថា បច្ចុប្បន្ន វេណេស៊ុយអេឡា ក៏ ជួប វិបត្តិ មាន ប្រធានាធិបតី ដល់ ទី២ មួយ គឺ លោក ម៉ាឌូរ៉ូ មាន រុស្ស៊ី និង ចិន ជា ខ្នង បង្អែក ធំ រីឯ មេ បក្ស ប្រឆាំង លោក ហ្គៃ ដូ មាន សហរដ្ឋ អាមេរិក និង លោក ខាងលិច គំាទ្រ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី០៤ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
រដ្ឋមន្ត្រី កសិកម្ម ស្នើឲ្យ បារាំង បន្ត ជួយ ដល់ ការអភិវឌ្ឍ វិស័យ កសិកម្ម នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្ដ្រី កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នា រសៀល ថ្ងៃទី ០៤ ខែកុម្ភៈ ឆ្នាំ ២០១៩ បាន ទទួល ជួប លោកស្រី អេវ៉ា ង្វៀន ប៊ិញ ឯក អគ្គ រដ្ឋទូត បារាំង ប្រចាំ នៅ កម្ពុជា ដើម្បី ពិភាក្សា ការងារ អំពី ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ រួមទាំង ប្រធានបទ ផ្សេង ៗ ទៀត ។
ក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី វេង សា ខុន បាន សម្តែង អំណរ អរគុណ ជូន ចំពោះ រដ្ឋាភិបាល បារាំង ដែល កន្លងមក បាន ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ ការអភិវឌ្ឍ ប្រទេស កម្ពុជា ជា រួម និង ដោយឡែក ការអភិវឌ្ឍ វិស័យ កសិកម្ម ។
ជំនួយ ឧបត្ថម្ភ ទាំង ហិរញ្ញវត្ថុ និង បច្ចេកទេស របស់ រដ្ឋាភិបាល បារាំង បាន ចូលរួមចំណែក ធ្វើឲ្យ វិស័យ កសិកម្ម មាន ការរីកចម្រើន គួរឲ្យ មោទនភាព លោក រដ្ឋមន្រ្តី សង្ឃឹម ថា រដ្ឋាភិបាល បារាំង នឹង បន្ត ជួយ អភិវឌ្ឍ វិស័យ កសិកម្ម បន្ថែម ទៀត ជាពិសេស ដល់ វិស័យ កៅស៊ូ គ្រួសារ ឲ្យ កាន់តែ មាន ការរីកចម្រើន សមស្រប តាម និន្នាការ រីកចម្រើន ផ្នែក សេដ្ឋកិច្ច កំណើន ប្រជាជន និង ការប្រកួតប្រជែង ទីផ្សារ ។
លោកស្រី ឯក អគ្គ រដ្ឋទូត បាន លើកឡើង ពី ចំណាប់អារម្មណ៍ របស់ លោកស្រី ទាក់ទង នឹង ការរីកចម្រើន របស់ ប្រទេស កម្ពុជា ជាពិសេស ការរីកចម្រើន លើ វិស័យ កសិកម្ម ដែល បាន ចូលរួមចំណែក ជំរុញ កំណើន សេដ្ឋកិច្ច ជាតិ កែលម្អ កម្រិត ជីវភាព របស់ ប្រជាពលរដ្ឋ និង កាត់បន្ថយ ភាពក្រីក្រ ។
លោកស្រី បាន បន្ត ថា ជំនួប នា ពេលនេះ គឺជា ឱកាស នៃ ការផ្លាស់ប្តូរ ព័ត៌មាន បទពិសោធន៍ ល្អ ៗ និង ធ្វើ ការសិក្សា លើក ទិសដៅ បន្ត អនុវត្ត គម្រោង ដែល ពាក់ព័ន្ធ នឹង វិស័យ កសិកម្ម ។ ទោះជា យ៉ាងណា លោកស្រី ថា នឹង ខិតខំ ផ្តល់ កិច្ចសហការ បន្ថែម ទៀត ជាមួយ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ធ្វើ យ៉ាងណា អភិវឌ្ឍន៍ វិស័យ កសិកម្ម នៅ កម្ពុជា ឲ្យ មាន ការរីកចម្រើន សមស្រប តាម ចក្ខុវិស័យ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
មន្ត្រី យោធា និង នគរបាល ទាស់ សម្តី គ្នា រហូត ផ្ទុះ អាវុធ ៣គ្រាប់
( ភ្នំពេញ ) ៖ មន្ត្រី យោធា និង នគរបាល បាន ទាស់ សម្តី គ្នា រហូត ឈាន ទៅ ផ្ទុះ អាវុធ ចំនួន ៣គ្រាប់ បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល អស់ ប្រជាពល នៅ កន្លែង កើត ហេតុ នោះ ។ ហេតុការណ៍ នេះ បាន កើតឡើង នៅ រសៀល ថ្ងៃទី ០៤ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ នៅ តាម បណ្តោយ ផ្លូវ ១៣៩ សង្កាត់ អូរឫស្សី ទី៣ ខណ្ឌ ៧មករា រាជធានី ភ្នំពេញ ។
មិន ទាន់ មាន ប្រភព បញ្ជាក់ ពី មូលហេតុ ដែល នាំឲ្យ មន្ត្រី យោធា និង នគរបាល ទាស់ សម្តី គ្នា នៅឡើយ នោះ ទេ ។ អត្តសញ្ញាណ របស់ មន្ត្រី យោធា និង នគរបាល ដែល ឈ្លោះ ទាស់ទែង គ្នា នេះ ក៏ មិន ទាន់ មាន ការបញ្ជាក់ អត្តសញ្ញាណ ពី សមត្ថកិច្ច ផងដែរ ៕
រាជ រដ្ឋាភិបាល សម្រេច បែងចែក តំបន់ គ្រប់គ្រង ដែន ជម្រក សត្វ ព្រៃ ស្រែ ពក ក្នុង ខេត្ត មណ្ឌលគិរី ជា៤ តំបន់
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច បែងចែក តំបន់ គ្រប់គ្រង ដែន ជម្រក សត្វ ព្រៃ ស្រែ ពក ជា៤ តំបន់ គឺ តំបន់ ស្នូល តំបន់ អភិរក្ស តំបន់ ប្រើប្រាស់ ដោយ ចីរភាព និង តំបន់ សហគមន៍ សម្រាប់ បម្រើ ដល់ ការងារ គ្រប់គ្រង ថែរក្សា អភិរក្ស និង អភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្គម ប្រកបដោយ និរន្តរភាព ។ តំបន់ គ្រប់គ្រង ដែន ជម្រក សត្វ ព្រៃ ស្រែក ពក មាន ទីតាំង ភូមិសាស្ត្រ ក្នុង ខេត្ត មណ្ឌលគិរី ដែល មាន ផ្ទៃដី សរុប ជិត ៤សែន ហិកតា ។
លោក បន្ត ថា ក្រោយពី ការបែងចែក តំបន់ គ្រប់គ្រង នេះ ក្រសួង បរិស្ថាន ជឿជាក់ ថា នឹង ធ្វើឱ្យ ការការពារ និង អភិរក្ស ធនធាន ធម្មជាតិ នៅ តំបន់ នោះ កាន់តែ មាន ប្រសិទ្ធភាព ហើយ នឹង កាត់បន្ថយ បាន ច្រើន លើ បទល្មើស ធនធាន ធម្មជាតិ និង ការបរបាញ់ សត្វ ព្រៃ ខុស ច្បាប់ ពីសំណាក់ ក្រុម ជន ខិលខូច ។
១៖ តំបន់ ស្នូល មាន ចំនួន ២ទីតាំង មាន ផ្ទៃដី សរុប ១៨៧. ៦៣១ ហិកតា រួម មាន តំបន់ ស្នូល ទី១ មាន ភូមិសាស្ត្រ ស្ថិត នៅ ឃុំ អរបួន លើ ឃុំ ណង ឃី ឡឹក ឃុំ ស្រែ ហ៊ុយ ឃុំ ស្រែ សង្គម នៃ ស្រុក កោះ ញែក និង នៅ ភូមិសាស្ត្រ ឃុំ ក្រង់ តេ ឃុំ ពូជ្រៃ នៃ ស្រុក ពេជ្រា ដា និង តំបន់ ស្នូល ទី២ មាន ភូមិសាស្រ្ត ស្ថិត នៅ ឃុំ សុខសាន្ត និង ឃុំ ពូជ្រៃ និង គ្របដណ្តប់ ដោយ ព្រៃ ស្រោង ព្រៃ ពាក់ កណ្តាល ស្រោង ព្រៃ ល្បះ ដែល មាន និយាម កាក្នុង ឧបសម្ព័ន្ធ២ ។
៣៖ តំបន់ ប្រើប្រាស់ ដោយ ចីរភាព មាន ចំនួន ៨ទីតាំង មាន ផ្ទៃដី សរុប ៦៥. ៧១៧ ហិកតា រួម មាន តំបន់ ប្រើប្រាស់ ដោយ ចីរភាព ទី១ និង ទី២ មាន ភូមិសាស្ត្រ ស្ថិត នៅ ឃុំ អរបួន លើ និង ឃុំ ណង ឃី ឡឹក តំបន់ ប្រើប្រាស់ ដោយ ចីរភាព . ទី៣ មាន ភូមិសាស្ត្រ ស្ថិត នៅ ឃុំ ស្រែ ហ៊ុយ ឃុំ ស្រែ សង្គម និង ឃុំ សុខសាន្ត . តំបន់ ប្រើប្រាស់ ដោយ ចីរភាព ទី៤ ទី៥ និង ទី៦ មាន ភូមិសាស្ត្រ ស្ថិត នៅ ឃុំ ពូជ្រៃ និង តំបន់ ប្រើប្រាស់ ដោយ ចីរភាព ទី៧ និង ទី៨ មាន ភូមិសាស្ត្រ ស្ថិត នៅ ឃុំ ក្រង់ តិះ ដែល មាន និយាម កា ក្នុង ឧបសម្ព័ន្ធ២ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៤ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៣.៣៨០ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៤៩១ គ្រឿង ( ម៉ូតូ ៨២ %) អប់រំ១៩៥ គ្រឿង និង ផាក ពិន័យ ២៩៦ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ០៤ ខែកុម្ភៈ នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ២. ៧២១ គ្រឿង . អប់រំ ១៥៨ គ្រឿង និង ផាក ពិន័យ ២៦៣ គ្រឿង ។
ការប្រកាស ទទួលស្គាល់ ខាងលើ របស់ ប្រទេស អឺរ៉ុប ទាំង៤ ធ្វើឡើង បន្ទាប់ពី ប្រធានាធិបតី វេណេស៊ុយអេឡា លោក នីកូឡាស់ ម៉ាឌូរ៉ូ មិន ព្រម ធ្វើ តាម ឱសានវាទ កាលពី ថ្ងៃទី ២៦ ខែមករា របស់ អឺរ៉ុប ដែល បាន កំណត់ ពេល ០៨ ថ្ងៃ ឲ្យ លោក ម៉ាឌូរ៉ូ រៀបចំ ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី ឡើងវិញ សា ជា ថ្មី ។ មិន តែ ប៉ុណ្ណោះ ប្រទេស អឺរ៉ុប ទាំង ០៤ ក៏ បាន ជំរុញ ឲ្យ លោក Guaido រៀបចំ ការបោះឆ្នោត មួយ ដែល សេរី និង តម្លាភាព ឲ្យបាន ឆាប់ ៗ ផងដែរ ។
ក្រសួង ការបរទេស អំពាវនាវ ឱ្យ ប្រុងប្រយ័ត្ន ចំពោះ ការឆបោក លក់ វីសា តាម អ៉ីនធើណិត ខណៈ គេហទំព័រ ផ្លូវការ មាន តែ ១ ប៉ុណ្ណោះ
( ភ្នំពេញ ) ៖ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៅ ថ្ងៃទី ០៥ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ បាន អំពាវនាវ ឱ្យ សាធារណជន និង ភ្ញៀវ ទេសចរ បរទេស ទាំងអស់ មាន ការប្រុងប្រយ័ត្ន ចំពោះ ការឆបោក ពាក់ព័ន្ធ នឹង ការលក់ វីសារ ចូលមក កម្ពុជា តាម ប្រព័ន្ធ អ៉ីនធើណិត ។
លោក បាន បញ្ជាក់ បន្ថែម ថា ប្រទេស ជិតខាង យើង គេ រិះរក វិធី កាត់បន្ថយ តម្លៃ ទិដ្ឋាការ ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ ។ គេ មិន រំពឹង លើ ចំណូល បាន មកពី ទិដ្ឋាការ នេះ ទេ ។ ដូច្នេះ ក្រសួង មិន បាន ផ្តល់ សិទ្ធិ ឲ្យ ពួកគេហទំព័រ ក្លែងក្លាយ ទាំងនោះ ចាំ ត្រង យក ភ្ញៀវ កាត់ មុខ រាជ រដ្ឋាភិបាល ទេ ។ ការចេញ ទិដ្ឋាការ ជា សិទ្ធិ អំណាច ផ្តាច់ មុខ របស់ រដ្ឋ មួយ ហើយ មាន តែ ស្ថានទូត ក្រសួង ការបរទេស និង ក្រសួង មហាផ្ទៃ ប៉ុណ្ណោះ ដែល មាន សមត្ថកិច្ច ក្នុង ការងារ នេះ ៕
ខាងក្រោម នេះ ជា កំណត់ ទូត ដែល ក្រសួង ការបរទេស បាន ផ្សព្វផ្សាយ អំពី គេហទំព័រ ក្លែងបន្លំ ទាំង ១៧ កន្លងមក៖
យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៥ ខែកុម្ភៈ នេះ លទ្ធផល៖ បង្ក្រាប ៧ករណី ឃាត់ខ្លួន ១៦ នាក់
* លទ្ធផល បង្ក្រាប រួម មាន៖ ៧ករណី ឃាត់ខ្លួន ១៦ នាក់
បើកបរ សូម ប្រុងប្រយ័ត្ន ទាំងអស់ គ្នា ! គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ចិន ២ ថ្ងៃ ស្លាប់ មនុស្ស ២៣នាក់ និង របួស ធ្ងន់ ស្រាល ៥៦ នាក់
របាយការណ៍ បញ្ជាក់ ថា រយៈពេល ២ ថ្ងៃ មក នេះ មូលហេតុ ដែល កើត គ្រោះថ្នាក់ ចរាចរណ៍ ច្រើន ជាង គេ គឺ ដោយសារ បើកបរ ល្បឿន លឿន ស្រវឹង ប្រជែង មិន គោរព សិទ្ធិ មិន ប្រកាន់ ស្តាំ បត់ គ្រោះថ្នាក់ ជាដើម ។
ដោយសារ ចំនួន គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ច្រើន គួរឲ្យ បារម្ភ នៅ រយៈពេល ២ ថ្ងៃ នេះ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលដ្ឋ ដែល ធ្វើដំណើរ ទីជិត ទី ឆ្ងាយ សូម បើកបរ គោរព ច្បាប់ ចរាចណ៍ កុំ បើក ល្មើស ល្បឿន និង ស្រវឹង សូម កុំ បើកបរ ៕ TOP NEWS: សល់ ២៦ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ករណី ភ្នាល់ កំរិត ថ្នាក់ ជាតិ រវាង សម្តេច តេជោ ហ៊ុន សែន និង សម រង្ស៊ី នឹង ដល់ ពេល កំណត់ នៅ ថ្ងៃទី ០៣ ខែមីនា ខាងមុខ . អ្នកវិភាគ អះអាង ថា សម រង្ស៊ី គួរ ត្រៀម រៀបចំ ខ្លួន ចូល ស្រុក ដើម្បី ដេក គុក
( ស្វាយ វៀង ) ៖ គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក ត្រូវបាន មើលឃើញ ថា បាន សម្លាប់ មនុស្ស ជាច្រើន នាក់ ស្ទើរ ជារៀងរាល់ ថ្ងៃ ។ ក្នុង ឆ្នាំ ២០១៨ កន្លងមក មាន មនុស្ស ចំនួន ១. ៧៦១ នាក់ ស្លាប់ និង របួស ចំនួន ៤. ៧៧០ នាក់ ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា នេះ បើ តាម តួរ លេខ ពី ក្រសួង មហាផ្ទៃ ។ គ្រោះមហត្ត រាយ នេះ ពិតជា បាន ធ្វើឲ្យ មាន ការរាំងស្ទះ ក្នុង ដំណើរកិច្ច អភិវឌ្ឍន៍ ប្រទេសជាតិ ។ គ្រោះថ្នាក់ ចរាចរណ៍ បាន ធ្វើឲ្យ ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ ដល់ សេដ្ឋកិច្ច គ្រួសារ និង សង្គម ។
យោង តាម របាយការណ៍ នៃ ប្រព័ន្ធ ព័ត៌មាន ជនរងគ្រោះ និង គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក បាន ឲ្យដឹង ថា ក្នុង មួយ ឆ្នាំ ៗ យុវជន ដែល មាន អាយុ ពី ១៥ ទៅ ២៤ ឆ្នាំ មាន ចំណែក ច្រើន ជាង គេ តាម របាយការណ៍ ដដែល បាន ឲ្យដឹង ថា គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក ភាគ ច្រើន កើត មាន ឡើង ក្នុង កំឡុង ពេល បុណ្យ សំខាន់ ៗ ពិសេស បុណ្យ ចូល ឆ្នាំ ខ្មែរ និង បុណ្យ ចូល ឆ្នាំ ចិន - វៀតណាម ។ ការអប់រំ និង ផ្សព្វផ្សាយ ផ្តោត សំខាន់ លើ ការហានិភ័យ នៃ ល្បឿន បើកបរ ការប្រើប្រាស់ មួក សុវត្ថិភាព ការប្រើប្រាស់ កង់ ។
លោក គង់ សាមឿន នាយក វិទ្យាល័យ រមាសហែក បាន ឲ្យដឹង ថា ក្នុង នាម លោក នាយក សាលា លោក ពិតជា មាន សេចក្តីរិក រាយ ដែល ក្រសួង សាធារណា ការ និង ដឹកជញ្ជូន បាន យកចិត្តទុកដាក់ ចំពោះ សុខ ទុក្ខ របស់ សិស្សានុសិស្ស របស់ លោក ដែល បាន រៀបចំ ឲ្យ អ្នកជំនាញ ចុះ អប់រំ និង ផ្សព្វផ្សាយ ស្តីពី សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ដល់ សាលា បែប នេះ ព្រោះ បច្ចុប្បន្ន ក្រោម ផ្លូវ ត្រូវបាន កែលំអ លោក សង្គេត ឃើញ ថា អ្នកបើកបរ បាន បើក លឿន ខុស ពីមុន ដែល ស្ថានភាព ផ្លូវ មាន ការលំបាក ទាំង នេះ ជា មូលហេតុ ដែល នាំឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ ។
លោក ក៏ បាន លើកឡើង ផងដែរ ថា ផ្លូវ ធ្វើ មិន ទាន់ រួច ស្រួលបួល ផង ឃើញ តែ គំនូស ដែល នគរបាល គូន កន្លែង គ្រោះថ្នាក់ ចរាណ៍ ពេញ តែ ផ្លូវ ។ ក្នុង ឱកាស នេះ ដែរ លោក ក៏ បាន ប្រកាស ឲ្យ សិស្ស យកចិត្តទុកដាក់ ស្តាប់ អ្នកជំនាញ និង ជួយ អប់រំ ផ្សព្វផ្សាយ ដល់ អ្នកភូមិ ដែល មិន បាន ចូលរួម ធ្វើ យ៉ាងណា ដើម្បី សុវត្ថិភាព ចរាចរណ៍ ពេល ធ្វើដំណើរ ។
លោក ពា គីម វង ទីប្រឹក្សា បច្ចេកទេស និង អ្នកជំនាញ ផ្នែក សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក បាន ឲ្យដឹង ថា បច្ចុប្បន្ន គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក បាន សម្លាប់ មនុស្ស ជា មធ្យម ពី៥ ទៅ ៦នាក់ ក្នុង មួយ ថ្ងៃ ហើយ ក្នុង មួយ ឆ្នាំ មាន មនុស្ស ប្រមាណ ២. ០០០នាក់ បាន ស្លាប់ បាត់បង់ អាយុជីវិត ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ នៅលើ ដង ផ្លូវ នៃ ប្រទេស កម្ពុជា ។
លោក ពា គីម វង បាន ស្នើសុំ ឲ្យ អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ចូលរួម គោរព ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក និង មាន ការយោគយល់ គ្នា ទៅ វិញ ទៅ មក ពិសេស នៅ ពេល ដែល មាន ចរាចរណ៍ មមាញឹក នៅលើ ដង ផ្លូវ ពិសេស ក្នុង ឱកាស បុណ្យ សំខាន់ ៗ ៕
អភិបាល ខេត្ត កំពង់ចាម ណែនាំ មន្ត្រី ទូទាំង ខេត្ត ត្រូវ យល់ដឹង ឱ្យ បាន ទូលំទូលាយ នូវ កិច្ចការ អភិវឌ្ឍន៍ បែប ប្រជាធិបតេយ្យ ថ្នាក់ ក្រោម ជាតិ
( កំពង់ចាម ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត កំពង់ចាម បាន ណែនាំ ឱ្យ មន្ត្រី ពាក់ព័ន្ធ ធ្វើ ការស្វែងយល់ ឱ្យ បាន ទូលំទូលាយ នូវ កិច្ចការ អភិវឌ្ឍ មូលដ្ឋាន តាម បែប ប្រជាធិបតេយ្យ ថ្នាក់ ក្រោម ជាតិ ហើយ មន្រ្តី នៃ ផ្នែក នីមួយ ៗ ត្រូវ រៀបចំ ធ្វើ ផែនការអភិវឌ្ឍ តាម បែប ប្រជាធិបតេយ្យ ថ្នាក់ ក្រោម ជាតិ នេះ ឱ្យ បាន ទាន់ ពេលវេលា ទៅ តាម ការណែនាំ របស់ ក្រសួង មហាផ្ទៃ ដូច្នេះ អង្គភាព នីមួយ ៗ ត្រូវ រៀបចំ ប្រតិទិន ការងារ សកម្មភាព ឱ្យ បាន ច្បាស់លាស់ ។
ការណែនាំ របស់ អភិបាល ខេត្ត កំពង់ចាម បាន ធ្វើឡើង នៅ ថ្ងៃទី ០៥ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ នៅក្នុង ឱកាស លោក បាន អញ្ជើញ ជា អធិបតីភាព បើក កិច្ចប្រជុំ រវាង គ.ជ. អ. ប និង រដ្ឋបាល ខេត្ត កំពង់ចាម ស្ដី អំពី « ការពិនិត្យ ពិភាក្សា លើ សេចក្តីសម្រេច រួម នៃ ផែនការអភិវឌ្ឍន៍ » ដែល ប្រព្រឹត្ត នៅ សាល ប្រជុំ តូច នៅក្នុង សាលាខេត្ត កំពង់ចាម ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ មន្ត្រី ពាក់ព័ន្ធ យ៉ាង ច្រើន កុះករ ផងដែរ ។
សូម បញ្ជាក់ ថា ក្នុង អង្គប្រជុំ នេះ បាន ធ្វើ ការសម្រេច រួមគ្នា លើ ផែនការ៥៧ សកម្មភាព នៃ ផ្នែក កិច្ចការ អភិវឌ្ឍន៍ មូលដ្ឋាន បែប ប្រជាធិបតេយ្យ ថ្នាក់ ក្រោម ជាតិ សម្រាប់ ឆ្នាំ ២០១៩ ដែល សេចក្តីសម្រេច នោះ ត្រូវបាន ធ្វើឡើង បន្ទាប់ គឺ មាន ការធ្វើ បទបង្ហាញ ពីសំណាក់ លោក ប្រាក់ ទិត្យ ប្រធាន ទី ចាត់ការ ផែនការ និង វិនិយោគ និង ការចូលរួម យោបល់ របស់ សមាជិក សមាជិកា នៃ អង្គប្រជុំ ៕
នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ៖ វិមាន ឈ្នះ - ឈ្នះ នឹង ក្លាយទៅជា ពហុ មជ្ឈមណ្ឌល សម្រាប់ ផ្ទុក ឯកសារ ប្រវត្តិសាស្ត្រ កម្ពុជា ខណៈ មាន អ្នក ចូល ទស្សនា កើនឡើង ជាលំដាប់
ការលើកឡើង របស់ នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ ធ្វើឡើង នៅក្នុង សន្និសីទ សារព័ត៌មាន នៅ ថ្ងៃទី៥ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ នៅក្នុង សំណង់ វិមាន ឈ្នះ ឈ្នះ ស្ថិត នៅ សង្កាត់ ព្រែក តា សេក ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ។ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ បាន លើកឡើង ថា បច្ចុប្បន្ន មាន ប្រជាពលរដ្ឋ ខ្មែរ និង សិស្សានុសិស្ស មកពី សាលា និង សសកលវិទ្យាល័យ ផ្សេង ៗ មក ទស្សនា និង សិក្សា ស្រាវជ្រាវ ជារៀងរាល់ ថ្ងៃ ហើយ ថ្ងៃ ខ្លះ មាន រហូតដល់ ៧ ពាន់ នាក់ ឯណោះ ។
វិមាន ឈ្នះ - ឈ្នះ បាន បើក ការដ្ឋាន សាងសង់ កាលពី ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០១៦ បន្ទាប់ពី ការសាងសង់ អស់ រយៈពេល ជាង ពីរ ឆ្នាំ គឺ វិមាន មាន ឈ្នះ ឈ្នះ ត្រូវបាន ប្រារព្ធ ពិធី សម្ពោធ ជា ផ្លូវការ កាលពី ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ក្រោម អធិបតីភាព សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា រួមទាំង ការប្រារព្ធ ទិវា នយោបាយ ឈ្នះ - ឈ្នះ ( ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ - ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០១៨ ) ផងដែរ ។
បើ តាម ការអះអាង របស់ នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ ដដែល បាន ឱ្យដឹង ដែរ ថា ក្រុម គណៈកម្មការ សាងសង់ វិមាន ឈ្នះ ឈ្នះ នឹង បង្កើន នៅ សន្តិសុខ និង ក្រុម អនាម័យ បន្ថែម ទៀត ដើម្បី រក្សា សុវត្ថិភាព និង បរិស្ថាន នូវ ក្នុង បរិវេណ សំណង់ នេះ ឱ្យ កាន់តែ ល្អ ប្រសើ បន្ថែម ទៀត ខណៈ ប្រជាពលរដ្ឋ មក កាន់តែ ច្រើន ហើយ ក្រុម សន្តិសុខ និង ក្រុម អនាម័យ នៅ មាន កម្រិត នៅឡើយ នោះ ។
ទន្ទឹមនឹង នេះ នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ ក៏ បាន ធ្វើ ការអំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ជាថ្មី ទៀត ដែល មក ទស្សនា និង សិក្សា ស្រាវជ្រាវ នូវ សំណង់ ដ៏ ប្រវត្តិសាស្ត្រ នេះ សូម ជួយ ថែរក្សា នៅ បរិស្ថាន និង សណ្តាប់ធ្នាប់ រួមគ្នា ដើម្បីឱ្យ សោភ័ណភាព ក្នុង បរិវេណ កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ៕
