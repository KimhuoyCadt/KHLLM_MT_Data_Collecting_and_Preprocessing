( វ៉ាស៊ីនតោន ) ៖ អគ្គ មេបញ្ជាការ យោធា អាមេរិក ប្រចាំ នៅ តំបន់ អឺរ៉ុប បាន និយាយ ថា សហរដ្ឋ អាមេរិក ពុំ គួរ លក់ យន្តហោះ ចម្បាំង F-35 ឲ្យ ទៅ តួកគី ឡើយ ប្រសិនបើ ទីក្រុង អង់ការ៉ា ទិញ ប្រព័ន្ធ មីស៊ីល ការពារ អាកាស របស់ រុស្ស៊ី ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃពុធ ទី ០៦ ខែមីនា ឆ្នាំ ២០១៩ ។
ក្នុង ថ្ងៃ ដដែល ក្រសួង ការបរទេស អាមេរិក ក៏ បាន ឲ្យដឹង ផងដែរ ថា ទីក្រុង វ៉ាស៊ីនតោន បាន បញ្ជាក់ ប្រាប់ ទីក្រុង អង់ការ៉ា រួចហើយ ថា ការទិញ ប្រព័ន្ធ ការពារ ដែន អាកាស រុស្ស៊ី នឹង នាំ ទៅ រក ការវាយតម្លៃ ឡើងវិញ លើ ការចូលរួម របស់ តួកគី នៅក្នុង កម្មវិធី អភិវឌ្ឍន៍ យន្តហោះ ចម្បាំង F-35 ។
គួរ ជម្រាប ថា ទោះបីជា អាមេរិក បាន ព្រមាន ជាច្រើន ដង មិន ឲ្យ ទិញ ប្រព័ន្ធ មីស៊ីល រុស្ស៊ី S-400 ក៏ដោយ ក៏ តួកគី នៅតែ ព្យាយាម បញ្ជាក់ ថា ការទិញ ប្រព័ន្ធ មីស៊ីល នេះ គឺ មិន អាច ផ្លាស់ប្តូរ នោះ ទេ ហើយ ពួកវា នឹង ត្រូវ ប្រគល់ មកដល់ ដៃ តួកគី នា រដូវ ស្លឹកឈើ ជ្រុះ ឆ្នាំ ២០១៩នេះ ពោលគឺ នៅ ចន្លោះ ខែកញ្ញា និង ខែធ្នូ ខណៈ តួកគី មាន គម្រោង ទិញ យន្តហោះ ចម្បាំង F-35 ប្រមាណ ១០០ គ្រៀង ពី អាមេរិក ៕
ប្រជាពលរដ្ឋ ជាង ១ម៉ឺន គ្រួសារ ដែល រងគ្រោះ ក្នុង ឆ្នាំ ២០១៨ នៅ ខេត្ត ត្បូងឃ្មុំ ត្រូវបាន សាខា កាកបាទ ក្រហម កម្ពុជា ថ្នាក់ កណ្តាល និង ថ្នាក់ ខេត្ត ផ្តល់ ជូន អំណោយ មនុស្សធម៌ ភ្លាម ៗ
គ្រួសារ រងគ្រោះ បាន ការយកចិត្តទុកដាក់ ឧបត្ថម្ភ ជា ថវិកា សម្ភារ ព្រមទាំង គ្រឿង ឧបភោគ / បរិភោគ តាម គោលការណ៍ របស់ កាកបាទ ក្រហម កម្ពុជា ដោយ របស់របរ ចែកជូន ពលរដ្ឋ រងគ្រោះ ទទួលបាន ពី កាកបាទ ក្រហម កម្ពុជា ថ្នាក់ កណ្តាល ពី សាខា កាកបាទ ក្រហម ខេត្ត បណ្តា អនុសាខា ក្រុង / ស្រុក ក៏ ដូចជា ទទួល ដោយ ផ្ទាល់ ពី សប្បុរសជន នានា ផងដែរ ។
លោកស្រី បញ្ជាក់ ថា ក្នុង នោះ នា ពេល គ្រោះ ទឹក ជំនន់ នា កាលពី ខែសីហា និង កញ្ញា ឆ្នាំ ២០១៨ កន្លងទៅ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ក៏ បាន អញ្ជើញ ចុះ មក ចែក អំណោយ ដោយ ផ្ទាល់ ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ បាន ២លើ ក នៅ ស្រុក ត្បូងឃ្មុំ និង នៅ ស្រុក ក្រូចឆ្មារ ព្រមទាំង ថ្នាក់ដឹកនាំ កាកបាទ ក្រហម ថ្នាក់ កណ្តាល ផ្សេង ទៀត សរុប ៦.៥៧៤ គ្រួសារ ផងដែរ ។
លោកស្រី ឡេង សុខា បន្ត ឲ្យដឹង ថា សាខា កាកបាទ ក្រហម កម្ពុជា បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង កិច្ចការងារ សង្គម ជាពិសេស ការងារ ជួយសង្គ្រោះ និង សម្រាល ទុក្ខលំបាក របស់ ប្រជាពលរដ្ឋ ដូចជា ជន ចាស់ជរា គ្មាន ទីពឹង កុមារ កំព្រា អ្នក ផ្ទុក មេរោគ អេដស៍ គ្រោះមហន្តរាយ ទឹក ជំនន់ ខ្យល់ កន្ត្រាក់ និង ភ្លើង ឆេះ ផ្ទះ ជាដើម ។
លោកស្រី ឡេង សុខា ក៏ បាន ជំរុញ ឲ្យ គណៈកម្មាធិការ សាខា អនុសាខា ទាំងអស់ បន្ត យកចិត្តទុកដាក់ ពង្រឹង លើ វិស័យ ស្នូល ទាំង បួន របស់ កាកបាទ ក្រហម កម្ពុជា រួម មាន ទី ១៖ ការឆ្លើយតប គ្រោះមហន្តរាយ . ទី ២៖ ការងារ សុខភាព និង ការថែទាំ សុខភាព សហគមន៍ . ទី ៣៖ ការងារ លើកកម្ពស់ គោលការណ៍ គ្រឹះ និង តំលៃ មនុស្សធម៌ និង ទី៤៖ ការងារ អភិវឌ្ឍ ស្ថាប័ន និង ធនធាន មនុស្ស ដើម្បី សម្រេចបាន នូវ ការងារ ជា អាទិភាព របស់ ខ្លួន ក្នុង សកម្មភាព មនុស្សធម៌ ឲ្យ កាន់តែ ខ្លាំងក្លា ថែម ទៀត ៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន សូម ក្រាបបង្គំទូល ថ្វាយ នូវ សារលិខិត ថ្វាយ ព្រះពរ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ក្នុង ឱកាស ទិវា អន្តរជាតិ នារី ៨ មីនា
ខ្ញុំ ម្ចាស់ សូម ព្រះបរម រាជានុញ្ញាត ថ្វាយ នូវ ព្រះកតញ្ញុកតវេទិតាធម៌ យ៉ាង ធំធេង ចំពោះ ព្រះរាជ សារ របស់ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ដែល បាន ថ្វាយ ព្រះរាជ តម្រិះ គាំទ្រ ប្រធានបទ នៃ ទិវា អន្តរជាតិ នារី ៨ មីនា ឆ្នាំ ២០១៩ និង ការលើកទឹកចិត្ត ស្ត្រី គ្រប់ រូប ឱ្យ ចូលរួម អនុវត្ត គោល នយោបាយ ជាតិ គាំពារ សង្គម និង ខិតខំ ប្រឹងប្រែង រួមគ្នា ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី សម្រេច ឱ្យ បាន ទស្សនទាន អភិវឌ្ឍ កម្ពុជា ឱ្យ ក្លាយជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ ។
លើស ពី នេះ ទៀត ខ្លឹមសារ ព្រះរាជ សារ ដ៏ មាន សារៈសំខាន់ នេះ បាន ប្រោសប្រទាន កម្លាំងចិត្ត យ៉ាង ធំធេង ដល់ ខ្ញុំម្ចាស់ និង សហការី ឱ្យ កាន់តែ មាន ឆន្ទៈ មោះ មុត ខ្លាំងក្លា ថែម ទៀត ក្នុង ការបំពេញ ការងារ មនុស្សធម៌ តាម ព្រះរាជ គន្លង ព្រះវីរៈ គំរូ មនុស្សធម៌ ដ៏ ឆ្នើម នៃ ព្រះករុណា ព្រះបរម រតន កោដ្ឋ ក្រោម ម្លប់ ដ៏ ត្រជាក់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ។
សម្តេច ចៅហ្វា វាំង គង់ សំអុល ផ្ញើ លិខិត ជូន ពរ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក្នុង ឱកាស ទិវា អន្តរជាតិ នារី ៨មីនា
លើស ពី នេះ ទៅ ទៀត សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប្រធាន គឺជា មាតា មនុស្សធម៌ ជា ស្ត្រី កម្ពុជា ដ៏ ឆ្នើម ដែល ដង្ហែ តាម ព្រះរាជ គន្លង វីរៈ គំរូ មនុស្សធម៌ ដ៏ ឆ្នើម នៃ ព្រះករុណា ព្រះបរម រតន កោដ្ឋ សម្ដេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ និង ក្រោម ម្លប់ ដ៏ ត្រជាក់ នៃ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ។
គោរព ជូន នូវ ខ្លឹមសារ ទាំងស្រុង នៃ សារលិខិត ជូន ពរ របស់ សម្តេច ចៅហ្វា វាំង ជូន ចំពោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត៖ ការសិក្សា ថ្មី៖ ជំងឺ ទឹកនោម ផ្អែម នឹង រីករាលដាល ខ្លាំង នៅ ទ្វីប អាហ្វ្រិក នៅ ឆ្នាំ ២០៤៥ ជាមួយ អ្នក កើត ជំងឺ ៤១លាន នាក់
នៅ ទ្វីប អាហ្រ្វិក ជាពិសេស គឺ ប្រទេស កូឌីវ័រ ជំងឺ មិន ឆ្លង បាន និង កំពុង កើនឡើង គួរឱ្យ កត់សម្គាល់ ហើយ វា ក៏ ជា មូលហេតុ ដ៏ ចម្បង នៃ ការ ស្លាប់ របស់ ប្រជាជន អាហ្វ្រិក ផងដែរ ។ ជាក់ស្ដែង បើ តាម អង្គការ សុខភាព ពិភពលោក (WHO) កាលពី ឆ្នាំ ២០១៨ ការស្លាប់ របស់ ប្រជាជន អាហ្វ្រិក ៣៧ភាគរយ គឺ មាន ជាប់ពាក់ព័ន្ធ នឹង ជំងឺ មិន ឆ្លង ក្នុង នោះ មាន ដូចជា ជំងឺ ទឹកនោម ផ្អែម ជំងឺ មហារីក និង ជំងឺ ស្ទះ សសៃ ឈាម បេះដូង ជាដើម ។
លើស ពី នេះ ទៅ ទៀត អង្គការ អន្តរជាតិ មួយ នេះ ក៏ បាន ឱ្យដឹង ដែរ ថា កាលពី ឆ្នាំ ២០១៧ ជំងឺ ទឹកនោម ផ្អែម បាន ផ្ដាច់ យក ជីវិត ប្រជាជន អាហ្វ្រិក ៣០០.០០០ នាក់ ហើយ ប្រជាជន ៤១លាន នាក់ អាចនឹង កើត ជំងឺ នេះ នៅ ទូទាំង ទ្វី អាហ្រ្វិក ទាំងមូល នៅ ឆ្នាំ ២០៤៥ ។
គួរ បញ្ជាក់ ថា បើ តាម អង្គការ សុខភាព ពិភពលោក ទី្វប អាហ្រ្វិក នឹង ក្លាយជា តំបន់ រីកសាយ ជំងឺ ខ្លាំង ជាង គេ បំផុត នៅលើ ពិភពលោក ខណៈ ករណី នៃ ជំងឺ ផ្សេង ៗ ពី គ្នា បាន កើនឡើង រហូតដល់ ១៥៦ ភាគរយ ក្នុង រយៈពេល ៣០ ឆ្នាំ ចុងក្រោយ នេះ ។
សម្រាប់ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០១៩ នេះ លោក យូ ស៊ុន ឡុង រដ្ឋមន្ដ្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង លោក សួង ហេង រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ដឹកនាំ ក្រុមការងារ អន្តរ ស្ថាប័ន ចុះ ពិនិត្យ ទីតាំង និង ប្រជុំ ពិភាក្សា ដើម្បី រៀបចំ ពិធី បើក ការដ្ឋាន សាងសង់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ខេត្ត ព្រះសីហនុ ។
លោក គង់ វិមាន អ្នកនាំពាក្យ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ប្រាប់ អង្គភាព Fresh News ឲ្យដឹង ថា ទីតាំង ដែល នឹង ប្រារព្ធ ពិធី បើក ការដ្ឋាន សាងសង់ ផ្លូវ ល្បឿន លឿន ក្រោម អធិបតីភាព សម្ដេច តេជោ ហ៊ុន សែន នឹង រៀបចំ ធ្វើឡើង នៅ ត្រង់ ចន្លោះ គីឡូម៉ែត្រ ៣៩ - ៤០ ភូមិ ស្លា ឃុំ វ័រ សរ ស្រុក សំរោងទង ខេត្ត កំពង់ស្ពឺ ជាប់ ផ្លូវ ជាតិ លេខ ៤។
អ្នកនាំពាក្យ ក្រសួង សាធារណការ រូប នេះ បាន អះអាង ថា ផ្លូវ ល្បឿន លឿន ដំបូង គេ នៅ កម្ពុជា នេះ នឹង សាងសង់ ឡើង មាន ទទឹង ២៤.៥ម៉ែត្រ ហើយ រចនាសម្ព័ន្ធ គ្រឹះ ផ្លូវ មាន ស្រទាប់ គ្រឹះ លើ ពី ល្បាយ គ្រួស ថ្ម កម្រាស់ ១៦សង់ទីម៉ែត្រ និង ស្រទាប់ គ្រឹះ ក្រោម ពី ល្បាយ ថ្មី និង ស៊ីម៉ង់ត៍ កម្រាស់ ៣២សង់ទីម៉ែត្រ ។
សាងសង់ ស្ថានីយ ឈប់ សម្រាក តាម ផ្លូវ ៣កន្លែង . ចំណត រថយន្ដ ១កន្លែង និង កន្លែង ប្រតិបត្តិការ និង ថែទាំ ផ្លូវ ២កន្លែង ។ លើស ពី នេះ បំពាក់ គ្រឿង បរិក្ខា ផ្លូវថ្នល់ ដូចជា ផ្លាក សញ្ញា ចរាចរ គំនូស ចរាចរ បង្គោល នាំផ្លូវ និង បង្គោល គីឡូម៉ែត្រ ផងដែរ ។
សូម បញ្ជាក់ ថា គម្រោង សាងសង់ ផ្លូវ ល្បឿន ភ្នំពេញ - ខេត្ត ព្រះសីហនុ ខាងលើ នេះ ត្រូវបាន ចុះហត្ថលេខា រវាង លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន កម្ពុជា បាន ចុះហត្ថលេខា ជាមួយ លោក លាវ ឈីថា វ ប្រធាន ក្រុមហ៊ុន សំណង់ គមនាគមន៍ ចិន កាលពី ដើម ឆ្នាំ ២០១៨ ។ ពិធី ចុះហត្ថលេខា នោះ ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោក លី ខឺ ឈាង នាយក រដ្ឋមន្ត្រី ចិន ក្នុង ពេល ដែល លោក នាយក រដ្ឋមន្ត្រី ចិន បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ។
លោក ស៊ុន ចាន់ថុល បាន បង្ហាញ ក្តី រំពឹង ថា ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ព្រះសីហនុ នេះ នឹង ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការដឹកជញ្ជូន ទំនិញ តំបន់ ប៉ូល សេដ្ឋកិច្ច ដ៏ សំខាន់ ពីរ គឺ រាជធានី ភ្នំពេញ និង ខេត្ត ព្រះសីហនុ ។ ជាពិសេស ការដឹក ទំនិញ ពី បណ្តា រោងចក្រ នានា ទៅកាន់ កំពង់ផែ ស្វយ័ត ព្រះសីហនុ សម្រាប់ ការនាំចេញ ទៅកាន់ ប្រទេស ក៏ ដូចជា ការដឹក ទំនិញ ពី កំពង់ផែ ស្វយ័ត ព្រះសីហនុ ទៅ តំបន់ ទៅ តំបន់ ដទៃ ទៀត ។
លោក រដ្ឋមន្ត្រី ជឿ ថា ផ្លូវ ល្បឿន លឿន មួយ ខ្សែ នេះ នឹង រួមចំណែក កាន់តែ ខ្លាំង ក្នុង ការជំរុញ សេដ្ឋកិច្ច របស់ កម្ពុជា ៕ ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ និង ធនាគារ ពិភពលោក គ្រោង រៀបចំ កិច្ចពិគ្រោះយោបល់ ថ្នាក់ ជាតិ ជា លើក ដំបូង ស្តីពី « គោល នយោបាយ និង ទិសដៅ នៃ សេដ្ឋកិច្ច ឌីជីថល កម្ពុជា »
( ភ្នំពេញ ) ៖ ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ បាន សហការ ជាមួយ ធនាគារ ពិភពលោក ប្រចាំ នៅ កម្ពុជា គ្រោង នឹង រៀបចំ សិក្ខាសាលា ពិគ្រោះយោបល់ ថ្នាក់ ជាតិ ជា លើក ដំបូង ស្តីពី « គោល នយោបាយ និង ទិសដៅ នៃ សេដ្ឋកិច្ច ឌីជីថល កម្ពុជា » ដែល នឹង ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី ១២ - ១៣ ខែមីនា ឆ្នាំ ២០១៩ នៅ សណ្ឋាគារ ភ្នំពេញ ។
កិច្ចពិគ្រោះយោបល់ នេះ មាន ការចូលរួម បើក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ ហើយ នឹង បិទ បញ្ចប់ ក្រោម អធិបតីភាព របស់ លោក វង្សី វិស្សុត រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ . អនុប្រធាន ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ និង ជា ប្រធាន ក្រុមការងារ រៀបចំ សេចក្តីព្រាង ក្របខ័ណ្ឌ គោល នយោបាយ សេដ្ឋកិច្ច ឌីជីថល កម្ពុជា ។
សិក្ខាសាលា នឹង មាន ការធ្វើ បទបង្ហាញ ពី បទពិសោធន៍ ប្រទេស ក្នុង តំបន់ ក្នុង ការរៀបចំ ក្របខ័ណ្ឌ គោល នយោបាយ សេដ្ឋកិច្ច ឌីជីថល ក្នុង តំបន់ ដែល មាន ដូចជា ប្រទេស ថៃ . ម៉ាឡេស៊ី និង សឹង្ហបុរី ជាដើម និង មាន ការចូលរួម ផងដែរ ពី ស្ថាប័ន ពាក់ព័ន្ធ ក្នុង វិស័យ សាធារ -ណៈ . វិស័យ ធនាគារ និង ក្រុមហ៊ុន បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ . អង្គការ អន្តរជាតិ . វិទ្យាស្ថាន ស្រាវជ្រាវ . សាកលវិទ្យាល័យ . តំណាង ស្ថានទូត ដែល មាន អ្នកចូលរួម សរុប ប្រមាណ ៣០០ នាក់ ។
ក្រៅពី នេះ វេទិកា នេះ ក៏ ជា ការបង្ហាញ ដល់ វិនិយោគិន ជាតិ និង អន្តរជាតិ នូវ ការគិតគូរ យ៉ាង ហ្មត់ចត់ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការរៀបចំ ផែនការ សេដ្ឋកិច្ច កម្ពុជា និង ពង្រឹង បរិយាកាស ធុរកិច្ច ដោយ មាន ការចូល - រួម ពី គ្រប់ ដៃគូ ពាក់ព័ន្ធ ទាំងអស់ ៕
នាយ ឧត្តមសេនីយ៍ អ៉ី ឈាន បើក សិក្ខាសាលា ស្តីពី ការប្រើប្រាស់ ឧបករណ៍ ថាមពល ពន្លឺ ព្រះអាទិត្យ ក្នុង វិស័យ អភិវឌ្ឍន៍
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ អ៉ី ឈាន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បើក សិក្ខាសាលា ស្តីពី ការប្រើប្រាស់ ឧបករណ៍ ថាមពល ពន្លឺ ព្រះអាទិត្យ ( សូឡា ) ក្នុង វិស័យ អភិវឌ្ឍន៍ កងយោធពល ខេមរភូមិន្ទ នៅ នាយកដ្ឋាន អភិវឌ្ឍន៍ ក្រសួង ការពារ ជាតិ ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី សំណាក់ ឧត្តមសេនីយ៍ ឯក អ៊ុក កោសា នាយក នៃ នាយកដ្ឋាន អភិវឌ្ឍន៍ ក្រសួង ការពារ ជាតិ ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នាយកដ្ឋាន អភិវឌ្ឍន៍ ព្រមទាំង បណ្តាល អង្គភាព ចំណុះ ក្រសួង ការពារ ជាតិ និង តំណាង ក្រុមហ៊ុន ធ្វើ បទបង្ហាញ ស្តីពី អត្ថប្រយោជន៍ នៃ ឧបករណ៍ ប្រើប្រាស់ ថាមពល ពន្លឺ ព្រះអាទិត្យ ផងដែរ ។
លោក Kim Hyung Jun សម្រាប់ នៅ តាម បណ្តាល ខេត្ត នីមួយ ៗ ឬ តំបន់ នីមួយ ៗ ក្រុមហ៊ុន របស់ លោក អាចនឹង ផ្គត់ផ្គង់ ថាមពល សូឡា ១៧ ម៉េហ្គាវ៉ាត់ ដើម្បី ធ្វើ ការអភិវឌ្ឍន៍ ដូច្នេះ យោង តាម ការសិក្សា ស្រាវជ្រាវ របស់ ក្រុមហ៊ុន គឺ មាន តម្រូវ ខុសគ្នា នៅ តាម ស្ថានភាព និង ការប្រើប្រាស់ ជាក់ស្តែង របស់ អង្គភាព ប្រហែល២ ឬ ១មេហ្គាវ៉ាត់ តែ ប៉ុន ណ្ណោះ សម្រាប់ ឆ្នាំ ២០១៩នេះ ក្រុមហ៊ុន របស់ លោក នឹង ប្តេជ្ញាចិត្ត សហការ ជាមួយ ស្ថាប័ន របស់ កម្ពុជា ដើម្បី អភិវឌ្ឍន៍ គម្រោង១ ឬ ២ ក្នុង ចំណោម ទាំង ៥គម្រោង ខាងលើ នេះ ឱ្យ បាន ផងដែរ ។
ការចំអក របស់ លោក គង់ គាំ បាន កើតឡើង បន្ទាប់ពី លោក ស៊ីម សុវណ្ណ នី ហៅ ស៊ីម វ៉ាន់ នី ដែល ជា អតីត សមាជិក គណៈកម្មាធិការ នាយក របស់ អតីត គណបក្ស សង្រ្គោះ ជាតិ ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ចេញ ព្រះរាជ ក្រឹត្យ ផ្តល់ នីតិសម្បទា ឱ្យ ធ្វើ នយោបាយ ឡើងវិញ បន្ទាប់ពី លោក ដាក់ លិខិត ស្នើសុំ ទៅកាន់ ក្រសួង មហាផ្ទៃ ។
លោក ឲ្យដឹង ថា ការចាប់ផ្ដើម ឲ្យ មាន ជើងហោះហើរ ត្រង់ មក កម្ពុជា នេះ ជា ការរួមចំណែក ក្នុង ការលើកស្ទួយ វិស័យ សេដ្ឋកិច្ច រវាង ប្រទេស ទាំង២ ហើយក៏ ដូចជា ការនាំ ភ្ញៀវ ទេសចរ ពី បណ្ដា ប្រទេស ផ្សេង ៗ មក លេង នៅ កម្ពុជា និង ពី កម្ពុជា ទៅ ហ្វីលីពីន ផងដែរ ។
លោក បន្ថែម ថា « ខ្ញុំ ជឿជាក់ ថា ការបង្កើត ឲ្យ មាន ជើងហោះហើរ ត្រង់ រវាង ហ្វីលីន ពីន និង កម្ពុជា នឹង ទទួលបាន ជោគជ័យ ព្រោះ ក្រុមហ៊ុន បាន សហការ ជាមួយ ក្រុមហ៊ុន ផ្សេង ៗ ជាច្រើន ដើម្បី នាំ ភ្ញៀវ ពី បណ្ដា ប្រទេស ផ្សេង ៗ មក លេង នៅ ទីក្រុង ម៉ានីល និង ប្រទេស កម្ពុជា » ។
លោក បញ្ជាក់ ទៀត ថា គំរោង នេះ ជា កិច្ចសហការវាង អង្គភាព សុី ម៉ាក់ និង អង្គការ NPA ដែល អង្គភាព ទាំង ចុះហត្ថល ខា អនុវត្ត គំរោង ដ៍ ខ្លី ខាងមុខ ។
សូម រំលឹក ថា នៅ ឆ្នាំ ២០១៨ អង្គភាព ស៊ីម៉ាក់ បាន ទទួល ជំនួយ ថវិកា ចំនួន ១.៦លាន ដុល្លារ ពី រដ្ឋាភិបាល អាមេរិក ដើម្បី ធ្វើ ការបោសសម្អាត គ្រាប់បែក ចង្កោម រយៈពេល មួយ ឆ្នាំ ( គិត ចាប់ពី ថ្ងៃទី ០១ ខែមីនា ឆ្នាំ ២០១៨ ដល់ ថ្ងៃទី ២៨ ខែ កុម្ភៈ ឆ្នាំ ២០១៩ ដែល នេះ ជា ឆ្នាំ ទី១ នៃ រយៈពេល ២ឆ្នាំ ) លើ ផ្ទៃដី ២. ២០០ហិចតា នៅ ខេត្ត ភាគ ខាងកើត ប្រទេស កម្ពុជា ៕
ការត្រួតពិនិត្យ ការអនុវត្ត ថវិកា កម្មវិធី ប្រចាំ ឆ្នាំ ត្រូវបាន រៀបចំឡើង ក្នុង គោលបំណង សំខាន់ ៗ ៣គឺ៖
១៖ តាមដាន និង រាយការណ៍ អំពី វឌ្ឍនភាព ដែល អង្គភាព ក្រោម ឱវាទ ក្រសួង បាន សម្រេច ប្រចាំ ឆ្នាំ ដោយ ផ្ដោត សំខាន់ លើ ទិដ្ឋភាព ហិរញ្ញវត្ថុ និង ទិដ្ឋភាព សមិទ្ធកម្ម ។ ២៖ កំណត់ បញ្ហា ប្រឈម និង ស្នើ ដាក់ចេញ នូវ វិធានការដោះស្រាយ ដើម្បី ជំរុញ ការអនុវត្ត ការងារ សម្រាប់ ឆ្នាំ បន្តបន្ទាប់ ឲ្យ កាន់តែ រលូន និង សម្រេចបាន តាម គោលដៅ ។ ៣៖ បំពេញ តាម លក្ខខណ្ឌ តម្រូវ នៃ បទប្បញ្ញត្តិ គតិយុត្ត ជាធរមាន ពាក់ព័ន្ធ ថវិកា កម្មវិធី ។
ជា លទ្ធផល . ការត្រួតពិនិត្យ និង វាយតម្លៃ ការអនុវត្ត ថវិកា ប្រចាំ ឆ្នាំ ២០១៨៖
* ចំពោះ ទិដ្ឋភាព ហិរញ្ញវត្ថុ ផ្នែក ចំណូល សម្រាប់ គម្រោង កញ្ចប់ ថវិកា ឆ្នាំ ២០១៨ គឺ ឥណទាន ចំណូល កើនឡើង ចំនួន ១២.២% ធៀប ច្បាប់ ហិរញ្ញវត្ថុ ឆ្នាំ ២០១៧ ។ ការប្រមូល ចំណូល របស់ ក្រសួង ជា រួម ( មិន គិត ចំណូល ពន្ធដារ ថ្នាក់ ក្រោម ជាតិ ) សម្រេចបាន ១១០. ៤% ធៀប ច្បាប់ ក្នុង នោះ ថ្នាក់ កណ្ដាល សម្រេចបាន ១១០. ៤% ធៀប ច្បាប់ រីឯ ថ្នាក់ មូលដ្ឋាន សម្រេចបាន ៩៩. ៤% ធៀប ច្បាប់ ។
* ទិដ្ឋភាព ហិរញ្ញវត្ថុ ផ្នែក ចំណាយ វិញ គឺ ការអនុវត្ត ចំណាយ មាន ចំនួន ១០៤.៣% ( តួលេខ អាណត្តិ ទូទាត់ ) នៃ ច្បាប់ ដើម ឆ្នាំ ឬ ស្មើនឹង ៩៥. ៨% នៃ ឥណទាន ថ្មី ហើយ សម្រាប់ ការអនុវត្ត ចំណាយ នៅ តាម អង្គភាព ថវិកា ឃើញ ថា ការអនុវត្ត ប្រចាំ ឆ្នាំ ២០១៨ មាន ការវិវត្ត ល្អ មួយ កម្រិត បើ ធៀប នឹង ការអនុវត្ត ថវិកា នា បណ្តា ឆ្នាំ កន្លងមក ទាំង សម្រាប់ រដ្ឋបាល កណ្ដាល និង មន្ទីរ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ រាជធានី - ខេត្ត ។
ផ្អែក លើ លទ្ធផល ជា វិជ្ជមាន នៃ ការត្រួតពិនិត្យ និង វាយតម្លៃ ការអនុវត្ត ថវិកា ប្រចាំ ឆ្នាំ ២០១៨ នេះ . ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន និង កំពុង អនុវត្ត ក្នុង ការកសាង និង ស្ថាបនា ជា គំរូ ក្នុង ការអនុវត្ត ថវិកា កម្មវិធី ដើម្បី ជំរុញ ការអនុវត្ត ថវិកា កម្មវិធី ឲ្យ កាន់តែ រលូន ប្រកបដោយ ប្រសិទ្ធភាព ស័ក្តិសិទ្ធភាព និង អនុលោម តាម បទដ្ឋាន គតិយុត្ត ជាធរមាន ៕
សាធារណរដ្ឋ ឆេក នឹង វិនិយោគ វិស័យ សុខាភិបាល ផ្នែក ថែទាំ និង ព្យាបាល ជំងឺ មហារីក នៅ កម្ពុជា
ទន្ទឹម នឹង នោះ រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង បាន បញ្ជាក់ ថា « កម្ពុជា និង ឆែក នឹង ពិភាក្សា រួមគ្នា និង ពិនិត្យ ស្ថានភាព ដើម្បី ធ្វើ ការសហប្រតិបត្ដិការ មួយ ផ្នែក និង វិនិយោគ មួយ ផ្នែក លើ វិស័យ សុខាភិបាល ពិសេស ខាង សេវា ថែទាំ សុខភាព ការពារ និង ព្យាបាល ជំងឺ មហារីក ដោយ ខាង ភាគី ឆែក មាន បទពិសោធន៍ ស្រាប់ លើ ជំនាញ នេះ » ។
លោក ម៉ម ប៊ុន ហេង បាន លើកឡើង ថា ការវិនិយោគ សេវា ជំងឺ មហារីក នេះ គឺជា ផ្នែក មួយ ដែល កម្ពុជា កំពុងតែ មាន ការខ្វះខាត ស្រាប់ ដោយ មក ទល់នឹង ពេលនេះ មាន មន្ទីរពេទ្យ តែ ពីរ ប៉ុណ្ណោះ ដែល មាន សេវា ព្យាបាល ជំងឺ មហារីក នេះ គឺ មន្ទីរពេទ្យ មិត្ដភាព ខ្មែរ - សូវៀត និង មន្ទីរពេទ្យ កាល់ម៉ែត ។ ធុរ ជន ឆែក គ្រោង នឹង វិនិយោគ សេវា នេះ នៅ តាម មន្ទីរពេទ្យ រដ្ឋ របស់ កម្ពុជា ទៅ តាម ការពិនិត្យ និង ពិភាក្សា នៅពេល ខាងមុខ ។
លោក រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង បាន ថ្លែងអំណរគុណ ដល់ សាធារណរដ្ឋ ឆែក ដែល តែងតែ បន្ដ ជួយ លើកកម្ពស់ វិស័យ សុខាភិបាល កម្ពុជា ជាពិសេស បន្ដ ជួយ ឧបត្ថម្ភ និង វិនិយោគ លើ សេវា ព្យាបាល ជំងឺ មហារីក ។
សូម បញ្ជាក់ ថា ធារណរដ្ឋ ឆែក ក៏ បាន ធ្វើ ផែនការវិនិយោគ នៅ ប្រទេស ជាច្រើន ក្នុង តំបន់ អាស៊ាន ដូចជា នៅក្នុង ប្រទេស ឡាវ វៀតណាម និង ម៉ាឡេស៊ី ពី សេវា ជំងឺ មហារីក នេះ ៕ កង នាវា ប៉ាគីស្ថាន បណ្ដេញ នាវា មុជទឹក ឥណ្ឌា មួយ គ្រឿង ចេញ ពី ដែន ទឹក របស់ ខ្លួន
ថ្លែង ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ អ្នកនាំពាក្យ យោធា រូប នេះ ដដែល បាន គូសបញ្ជាក់ បន្ថែម ដូច្នេះ ថា៖ « ជ័យ ជំនះ ដ៏ អស្ចារ្យ នេះ គឺជា ភស្ដុតាង មួយ បញ្ជាក់ បាន ថា កង នាវា ប៉ាគីស្ថាន មាន ជំនាញ និង សមត្ថភាព ក្នុង ការការពារ ព្រំដែន ទឹក របស់ ខ្លួន ព្រមទាំង អាច ឆ្លើយតប ទៅនឹង រាល់ ការឈ្លានពាន ទាំងឡាយ » ។
គួរ បញ្ជាក់ ថា បើ តាម កង នាវា ប៉ាគីស្ថាន នេះ គឺជា លើក ទី២ហើយ ដែល នាវា មុជទឹក ឥណ្ឌា ត្រួវ បាន ស្ទាក់ ចាប់តាំងពី ឆ្នាំ ២០១៦មក ហើយ ម្យ៉ាង វិញ ទៀត ហេតុការណ៍ នេះ កើតឡើង នៅ ចំពេល ប្រជាជាតិ នុយក្លេអ៊ែរ ទាំង ២ កំពុង ស្គាល់ ភាពតានតឹង ផ្នែក យោធា កម្រិត ខ្ពស់ មួយ នា រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ៕
ក្រសួង ការងារ កេន យ៉ា ជ្រើសរើស កម្ពុជា ជា គោលដៅ ទស្សនកិច្ច ស្វែងយល់ ពី វិស័យ ការងារ
លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង បាន លើកឡើង ថា ការជ្រើសរើស កម្ពុជា ជា គោលដៅ ក្នុង ការទស្សនកិច្ច ស្វែងយល់ ពី វិស័យ ការងារ ជាពិសេស ពាក់ព័ន្ធ នឹង ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ (NEA) ជា ជម្រើស ដ៏ ល្អ ព្រោះ NEA ជា យន្តការ ដ៏ ជោគជ័យ និង សម្រេចបាន សមិទ្ធផល ជាច្រើន ។
លោក អនុ រដ្ឋមន្ត្រី ក្រសួង ការងារ កេន យ៉ា បាន បញ្ជាក់ ថា បានជា ក្រសួង ការងារ កេន យ៉ា ជ្រើសរើស កម្ពុជា ជា គោលដៅ ក្នុង ការទស្សនកិច្ច ស្វែងយល់ ពី វិស័យ ការងា គឺ ដោយសារ ស្ថានភាព កម្ពុជា និង កេន យ៉ា មាន លក្ខណៈ ប្រហាក់ប្រហែល គ្នា បើ ប្រៀបធៀប លើ បញ្ហា ប្រឈម កំណើន សេដ្ឋកិច្ច និង GDP សម្រាប់ មនុស្ស ម្នាក់ ក្នុង មួយ ឆ្នាំ ដូច្នេះ វា ទាមទារ ឱ្យ យើង មាន ការសិក្សា ស្វែងយល់ ពី គ្នា ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង បាន លើកឡើង ពី វឌ្ឍនភាព ជាច្រើន នៃ ក្រសួង ការងារ និង បញ្ជាក់ ថា កម្ពុជា ជា ប្រទេស តែ មួយ គត់ ដែល ហ៊ាន ផ្សាភ្ជាប់ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម ទៅនឹង លក្ខខណ្ឌ ការងារ ផ្តល់ សច្ចាប័ន លើ អនុសញ្ញា ស្នូល ទាំង៨ របស់ អង្គការ អន្តរជាតិ ខាង ការងារ (ILO) អនុវត្ត គម្រោង រោងចក្រ កាន់តែ ប្រសើរ នៅ កម្ពុជា ដើម្បី ត្រួតពិនិត្យ លក្ខខណ្ឌ ការងារ ការបន្ត ដំឡើង ប្រាក់ ឈ្នួល អប្បបរមា និង ការពង្រីក របប សន្តិសុខ សង្គម នៅ ទូទាំង ប្រទេស ។
តាមរយៈ ជំនួប នេះ ភាគី ទាំង ពីរ ជឿជាក់ ថា កិច្ចសហប្រតិបត្តិការ រវាង វិស័យ ការងារ នៃ ប្រទេស ទាំង ពីរ នឹង ត្រូវបាន ពង្រឹង បន្ថែម ហើយ នឹង មាន ការផ្លាស់ប្តូរ បទពិសោធន៍ និង ទស្សនៈ ល្អ ៗ ជាច្រើន ។ លោក រដ្ឋមន្រ្តី សង្ឃឹម ថា នៅលើក ក្រោយ នឹង មាន ទស្សនកិច្ច ពី ប្រតិភូ កេន យ៉ា បន្ថែម ទៀត មកកាន់ កម្ពុជា បន្ថែម ទៀត ។
១៖ សម្តេច តេជោ ហ៊ុន សែន ស្នើ ឱ្យ គ្រប់ ក្រសួង បង្កើន អត្រាតែងតាំង នារី ក្នុង មុខ តំណែង ផ្សេង ៗ ដើម្បីឱ្យ ស្ត្រី ចូលរួម សម្រេចចិត្ត លើ ការងារ របស់ អង្គភាព ( ចុច អាន )
២៖ សម្តេច តេជោ ហ៊ុន សែន អង្វរ សូមឲ្យ មាន ការយោគយល់ ខ្ពស់ ចំពោះ ស្ត្រី បម្រើ ការងារ តាម ផ្ទះ និង ទទូច ឲ្យ មាន ការយកចិត្តទុកដាក់ បន្ថែម ទៀត ( ចុច អាន )
៤៖ សម្តេច តេជោ ហ៊ុន សែន បង្គាប់ ឱ្យ ក្រសួង យុត្តិធម៌ និង ក្រសួង កិច្ចការ នារី ពិនិត្យ លើ ការលើកលែង ទោស ដល់ ស្រ្តី នៅក្នុង ពន្ធនាគារ ( ចុច អាន )
៥៖ សម្តេច តេជោ ហ៊ុន សែន ជំរុញ ឲ្យ អនុវត្តន៍ ការងារ អាទិភាព ចំនួន ៥ ដើម្បី លើកកម្ពស់ សមភាព យេនឌ័រ និង កិច្ច គាំពារ សង្គម ឱ្យ មាន ប្រសិទ្ធភាព និង តម្លាភាព ( ចុច អាន )
៩៖ រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង៖ ៥៧ % នៃ បុគ្គលិក មន្ដ្រីរាជការ ជា ស្ដ្រី ដែល កំពុង បំពេញ ការងារ នៅ ក្រសួង សុខាភិបាល ដែល ជា ការចូលរួមចំណែក មិន អាច ខ្វះ បាន ( ចុច អាន )
១០៖ សមាជិក សភា អាល្លឺម៉ង់ សន្យា ផ្តល់ ព័ត៌មាន ពិត ពី កម្ពុជា ទៅកាន់ ភាគី ពាក់ព័ន្ធ ( ចុច អាន )
១១៖ កម្ពុជា ត្រូវការវិស្វករ ជាង ៣ម៉ឺន នាក់ ចាប់ពី ឆ្នាំ ២០១៨ - ២០២០. គណៈ វិស្វករ កម្ពុជា អំពាវនាវ ឱ្យ វិស្វករ ជាតិ ចុះបញ្ជី ឱ្យ បាន គ្រប់ គ្នា ( ចុច អាន )
១៖ ទីបំផុត លោក គីម ជុង អ៊ុន ទៅដល់ ទីក្រុង ព្យុងយ៉ាង វិញ ដោយ សុវត្ថិភាព ក្រោយពី បាន បំពេញ ទស្សនកិច្ច រយៈពេល វែង នៅ វៀតណាម ( ចុច អាន )
២៖ ទីបំផុត ! មេដឹកនាំ បក្ស ប្រឆាំង វេណេស៊ុយអេឡា ត្រឡប់ ទៅដល់ ទីក្រុង ការ៉ាកាស់ វិញ តាម ពាក្យសន្យា ហើយ ( ចុច អាន )
៤៖ ប្រធានាធិបតី រុស្ស៊ី ផ្អាក ជា ផ្លូវការ នូវ ការអនុវត្ត សន្ធិសញ្ញា នុយក្លេអ៊ែរ INF ជាមួយ សហរដ្ឋ អាមេរិក ( ចុច អាន )
៥៖ រុស្ស៊ី ព្រមាន ធ្ងន់ ៗ ជា ថ្មី៖ យើង នឹង ដាក់ពង្រាយ មីស៊ីល ដែល អាច វាយប្រហារ ទ្វីប អឺរ៉ុប ទាំងមូល បើសិនជា អាមេរិក ហ៊ាន ដាក់ពង្រាយ មីស៊ីល នៅ តំបន់ នេះ ( ចុច អាន )
គយ និង ដៃគូ អភិវឌ្ឍន៍ បើក កិច្ចប្រជុំ ពិនិត្យ លើ យុទ្ធសាស្ត្រ កែទម្រង់ និង ធ្វើ ទំនើបកម្ម គយ ឆ្នាំ ២០១៩ - ២០២៣
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត គុណ ញឹម ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន បើក កិច្ចប្រជុំ ជាមួយនឹង ដៃគូ អភិវឌ្ឍន៍ ដែល ពាក់ព័ន្ធ ដើម្បី ពិនិត្យ ទៅ លើ យុទ្ធសាស្ត្រ កំណែទម្រង់ និង ទំនើបកម្ម គយ ឆ្នាំ ២០១៩ ដល់ ២០២៣ ។
ក្នុង កិច្ចប្រជុំ នោះ តំណាង អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន ជម្រាប ជូន ដៃគូ អភិវឌ្ឍន៍ នៅក្នុង អង្គប្រជុំ អំពី ការអនុវត្ត យុទ្ធសាស្ត្រ កំណែទម្រង់ និង ទំនើបកម្ម គយ ២០១៤ - ២០១៨ ដែល ជា រួម ត្រូវបាន វាយតម្លៃ ថា ទទួលបាន លទ្ធផល ល្អ ។
ក្នុង នោះ គោលដៅ យុទ្ធសាស្ត្រ ទី៣ ពាក់ព័ន្ធ នឹង ទំនើបកម្ម ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន ត្រូវបាន កំណត់ ជា អាទិភាព ចំបង និង ជា មូលដ្ឋានគ្រឹះ ក្នុង ការអនុវត្ត គោលដៅ យុទ្ធសាស្ត្រ ផ្សេង ទៀត ។
ក្រោយ បាន ស្តាប់ នូវ របាយការណ៍ របស់ មន្ត្រី អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ . តំណាង ដៃគូ អភិវឌ្ឍន៍ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធិផល នានា ដែល អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា សម្រេចបាន នា ពេល កន្លងមក និង ប្តេជ្ញាចិត្ត បន្ត ផ្តល់ ជំនួយ បច្ចេកទេស និង ការគាំទ្រ ការអនុវត្ត យុទ្ធសាស្ត្រ កំណែទម្រង់ និង ទំនើបកម្ម គយ ២០១៩ - ២០២៣ ឲ្យបាន សម្រេច ជោគជ័យ ជាបន្ត ទៀត ៕
អង្គការ យេនឌ័រ និង អភិវឌ្ឍន៍ ជំរុញ ឲ្យ មាន ការគោរព និង អនុវត្ត នូវ ក្រម ប្រតិបត្តិ ប្រព័ន្ធ ផ្សព្វផ្សាយ សម្រាប់ ការរាយការណ៍ ព័ត៌មាន អំពើហិង្សា លើ ស្ត្រី
( ភ្នំពេញ ) ៖ លោកស្រី រស់ សុភាព នាយិកា ប្រតិបត្តិការ អង្គការ យេនឌ័រ និង អភិវឌ្ឍន៍ ដើម្បី កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន ជំរុញ ឲ្យ មាន ការគោរព តាម និង អនុវត្ត នូវ ក្រម ប្រតិបត្តិ ប្រព័ន្ធ ផ្សព្វផ្សាយ សម្រាប់ ការរាយការណ៍ ព័ត៌មាន អំពើហិង្សា លើ ស្ត្រី ។
ការជំរុញ បែប នេះ របស់ លោកស្រី រស់ សុភាព បាន ធ្វើឡើង ក្នុង កម្មវិធី វេទិកា ព័ត៌មាន ស្ដីពី អំពើហិង្សា ផ្លូវភេទ ស្ដ្រី និង កុមារី ដែល រៀបចំ ធ្វើឡើង ដោយ ក្លឹប អ្នកកាសែត កម្ពុជា សហការ ជាមួយ អង្គការ យេនឌ័រ និង អភិវឌ្ឍន៍ ដើម្បី កម្ពុជា ។ កម្មវិធី នេះ រៀបចំ ធ្វើឡើង នៅ សណ្ឋាគារ សាន់ វេ រាជធានី ភ្នំពេញ នា រសៀល ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ នេះ ។
ក្នុង ឱកាស នោះ លោកស្រី រស់ សុភាព ក៏ បាន ស្នើឲ្យ បញ្ចប់ ការទំលាក់ កំហុស និង បន្ទោស ទៅ លើ ជនរងគ្រោះ នៃ អំពើហិង្សា ផ្លូវភេទ ជាពិសេស ជនរងគ្រោះ នៃ ការរំលោភ សេពសន្ថវៈ ដោយ លើកកម្ពស់ ការផ្សព្វផ្សាយ ព័ត៌មាន ដែល ប្រកបដោយ ក្រមសីលធម៌ បន្ត ពង្រឹង ការលើកកម្ពស់ ការយល់ដឹង ដល់ មន្ត្រី ដែល មាន តួនាទី និង ប្រជាពលរដ្ឋ ទូទៅ ។
នាយិកា ប្រតិបត្តិការ អង្គការ យេនឌ័រ និង អភិវឌ្ឍន៍ រូប នេះ បាន បញ្ជាក់ ថា បទល្មើស នៃ ការរំលោភ សេពសន្ថវៈ មិន មែន ជា កំហុស របស់ ជនរងគ្រោះ តែ ជា កំហុស របស់ ជន ប្រព្រឹត្ត តែ មួយ គត់ ។ លោក ថា ត្រូវ បន្ត ពង្រឹង ការអនុវត្តន៍ ច្បាប់ ព្រហ្មទណ្ឌ ឲ្យ មាន ប្រសិទ្ធិភាព ដែល ជា នា នូវ យុត្តិធម៌ ដល់ ជនរងគ្រោះ ។
លោកស្រី រស់ សុភាព បន្ដ ទៀត ថា នេះ គឺ បូករួម ទាំង ការលុបបំបាត់ និទណ្ឌភាព សម្រាប់ ជនល្មើស ដើម្បី ធានា ការ រក្សា សុខ សុវត្ថិភាព ដល់ ជនរងគ្រោះ និង ស្ត្រី ព្រមទាំង ក្មេងស្រី ដទៃ ទៀត និង មិន អនុវត្តន៍ ការសម្របសម្រួល ក្រៅ ប្រព័ន្ធ តុលា ដែល ជា កត្តា រាំងស្ទះ ដល់ ការអនុវត្ត ច្បាប់ ឲ្យបាន ពេញលេញ ។
ជាមួយគ្នា នោះ តំណាង អង្គការ ក្រៅ រដ្ឋាភិបាល និង សម្លេង ស្ដ្រី វ័យ ក្មេង បាន ស្នើ សូមឲ្យ ក្រសួង ព័ត៌មាន និង ក្រសួង កិច្ចការ នារី បង្កើត នូវ យន្តការតាមដាន និង វាយតម្លៃ ចំពោះ បណ្តាញ សារព័ត៌មាន ក្នុង ការអនុវត្ត ក្រម ប្រតិបត្តិ ប្រព័ន្ធ ផ្សព្វផ្សាយ សម្រាប់ ការរាយការណ៍ ព័ត៌មាន អំពើហិង្សា លើ ស្ត្រី ។
សូម ជម្រាប ថា តាមរយៈ របាយការណ៍ របស់ អង្គការ លីកាដូរ ក្នុង ឆ្នាំ ២០១៧ មាន ករណី អំពើហិង្សា ផ្លូវភេទ កើតឡើង ចំនួន ១៤៧ ករណី ក្នុង នោះ មាន ១២៥ ករណី ជា ករណី រំលោភ សេពសន្ថវៈ និង ៦ករណី ជា ករណី រំលោភ សម្លាប់ ដែល ជនរងគ្រោះ ទាំងអស់ ជា ស្ត្រី និង ក្មេងស្រី ។
របាយការណ៍ ដដែល បាន គូសបញ្ជាក់ ថា បើ គិត ត្រឹម ខែកញ្ញា ឆ្នាំ ២០១៨ មាន ករណី ហិង្សា លើ ក្មេងស្រី ប្រមាណ ១១០ ករណី ក្នុង នោះ មាន ករណី រំលោភ សេពសន្ថវៈ មាន ៩០ ករណី និង រំលោភ សម្លាប់ មាន ៨ករណី ៕
. តុលាការ ចេញ ដីកា ឃុំ ខ្លួនអ្នកបើក រថយន្ត បុក ជន បរទេស និង ខ្មែរ ស្លាប់ ៣នាក់ ដាក់ ពន្ធនាគារ PJ
សូម បញ្ជាក់ ថា គ្រោះថ្នាក់ ចរាចរណ៍ ដ៏ រន្ធត់ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ២៖៣០ នាទី យប់ រំលង អាធ្រាត្រ ចូល ថ្ងៃទី ២ ខែមីនា ឆ្នាំ ២០១៩ ត្រង់ ចំណុច វិថី ព្រះស៊ីសុវត្ថិ ប្រសព្វ ផ្លូវ លេខ ១៨៤ សង្កាត់ ជ័យ ជំនះ ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ។
លោក មេធាវី គី តិច ក៏ បាន លើកឡើង ថា ការបង្កើត មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន គឺ ដើម្បី ជួយ ដល់ អ្នកក្រ។ ដូច្នេះ អត់ មាន យក ឈ្មោះ ទៅ ទារ ប្រាក់ ពី អ្នក នោះ ទេ ហើយ ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន គឺ ស្មើភាព គ្នា អត់ មាន ខ្សែ អ្នកណា ម្នាក់ នោះ ឡើយ គឺ មាន តែ មេធាវី ដែល ស្ម័គ្រចិត្ត តែ ប៉ុណ្ណោះ ។
ប្រធាន មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន រូប នេះ ក៏ បាន លើកឡើង ថា សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហាញ មោទនភាព និង ផ្តល់ ភាពជឿជាក់ ខ្លាំង ណាស់ ចំពោះ ក្រុម មេធាវី របស់ សម្តេច ដោយ សម្តេច បាន លើក ជាប្រសាសន៍ ចំនួន ៣ដង រួចហើយ ហើយ ក្រុម មេធាវី នេះ គឺជា ភ្នែក ជា ច្រមុះ របស់ ប្រមុខ នៃ រាជ រដ្ឋាភិបាល ។ ប្រសិនបើ អស់ លោក អត់ ធ្វើ ការ អស់ លោក ធ្វើ អ្វី ផ្តេសផ្តាស វា នឹង ប្រាសចាក ទៅនឹង អ្វី ដែល ជា គោលដៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ចង់បាន នោះ ឡើយ ។
លោក មេធាវី គី តិច បាន ថ្លែង បាន បន្ថែម ទៀត ថា៖ « ខ្ញុំ ទទូច សុំ បងប្អូន យើង ទាំងអស់ កុំ យក តែ ឈ្មោះ បែរជា យក ឈ្មោះ ទៅ បង្វែរ ទៅ ប្រកប មុខរបរ របស់ ខ្លួន ដើម្បី រក ផលប្រយោជន៍ ដើម្បី យក ឥទ្ធិពល ទៅ ធ្វើ ការងារ ផ្សេង គឺ បាន ហាម នៅក្នុង បទបញ្ជា ផ្ទៃក្នុង អញ្ចឹង យើង ធ្វើ តែ ឈ្មោះ ក្រុម មេធាវី សម្តេច តេជោ សែន នេះ យើង ប្រើ តែ នៅក្នុង ក្របខ័ណ្ឌ ការពារ សិទ្ធិ របស់ ស្ត្រី ក្រីក្រ នៅក្នុង គម្រោង នេះ តែ ប៉ុណ្ណោះ » ។
កេន យ៉ា ស្វែងយល់ ពី បទពិសោធន៍ ក្នុង ការអភិវឌ្ឍ សេវា ការងារ នៅ កម្ពុជា
( ភ្នំពេញ )៖ គណៈប្រតិភូ អាជ្ញាធរ ជាតិ ការងារ នៃ សាធារណរដ្ឋ កេន យ៉ា បាន ធ្វើដំណើរ មក សិក្សា ស្វែងយល់ អំពី ការអនុវត្ត គោល នយោបាយ អភិវឌ្ឍន៍ វិស័យ ការងារ និង គោល នយោបាយ ពាក់ព័ន្ធ ដទៃ ទៀត របស់ កម្ពុជា ដើម្បី ពិចារណា យក ទៅ លៃល ក រៀបចំ ជា គោល នយោបាយ អនុវត្ត ក្នុង ប្រទេស ពួកគេ ដ្បិត អី ប្រទេស នេះ ទើប បង្កើត អាជ្ញាធរ ជាតិ ការងារ កាលពី ឆ្នាំ ២០១៦ ។
ពួកគេ នឹង ចូល សម្តែង ការគួរសម ជាមួយ លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង និង ចូលរួម កិច្ចប្រជុំ ពិភាក្សា ការងារ ជាមួយ NEA ព្រមទាំង ធ្វើ ទស្សនកិច្ច សិក្សា នៅ តាម មជ្ឈមណ្ឌល ការងារ នៃ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ នៅ រាជធានី ភ្នំពេញ និង ខេត្ត តាកែវ ដើម្បី សិក្សា អំពី ដំណើរការ នៃ ការផ្តល់ សេវា ការងារ ដល់ យុវជន និង អ្នក ស្វែងរក ការងារ ទូទៅ និង ទស្សនា វិទ្យាស្ថាន ពហុ បច្ចេកទេស កម្ពុជា (NPIC) ដើម្បី ស្វែងយល់ ពី ការបណ្តុះបណ្តាល ជំនាញ ដល់ សិស្ស - និស្សិត ។
គោលបំណង រួម គឺ ដើម្បី ស្វែងយល់ និង ដកស្រង់ បទពិសោធន៍ អំពី ដំណើរការផ្តល់ សេវា ការងារ ដល់ អ្នក ស្វែងរក ការងារ ការប្រមូល និង ផ្សព្វផ្សាយ ព័ត៌មាន ទីផ្សារ ការងារ ការបង្កើត និង អនុវត្ត គោល នយោបាយ កម្មវិធី ការងារ និង យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ វិស័យ ការងារ របស់ កម្ពុជា ។
ក្នុង ពេល ជួប ជាមួយ NEA លោក Ali ចាប់អារម្មណ៍ ទៅ លើ ចំណុច សំខាន់ ៗ ជាច្រើន ដូចជា ការរៀបចំ វេទិកា ការងារ ពិព័រណ៍ ការងារ និង ផលិតភាពជាតិ ប្រចាំ ឆ្នាំ ការជ្រើសរើស បុគ្គលិក នៅ តាម មូលដ្ឋាន ការ ប្រមូល និង គ្រប់គ្រង ទិន្នន័យ ស្ថិតិ ការងារ ជាពិសេស ការពង្រីក វិសាលភាព ផ្តល់ សេវា របស់ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ ទោះបី ទើបតែ បង្កើតឡើង ក្នុង ឆ្នាំ ២០០៩ក្តី ។
លោក បញ្ជាក់ ថា ចំណុច សំខាន់ ទាំងនេះ អាច ឱ្យ ក្រសួង ការងារ កេន យ៉ា ដកស្រង់ បទពិសោធន៍ និង ពិចារណា យក ទៅ រៀបចំ គោល នយោបាយ អនុវត្ត ក្នុង ប្រទេស របស់ លោក បាន ។
ជា ការពិត ណាស់ ដំណើរទស្សនកិច្ច របស់ គណៈប្រតិភូ ក្រសួង ការងារ កេន យ៉ា នេះ ឆ្លុះបញ្ចាំង អំពី កិច្ច ខិតខំ ប្រឹងប្រែង ថ្មី មួយ ទៀត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន កំពុង អនុវត្ត ក្នុង គោលដៅ ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ល្អ លើ គ្រប់ វិស័យ ជាមួយ បណ្តា ប្រទេស នានា ជុំវិញ ពិភពលោក សំដៅ ដកស្រង់ បទពិសោធន៍ ចែករំលែក ចំណេះដឹង និង បច្ចេកវិទ្យា ទៅ វិញ ទៅមក ។
កាលពី ឆ្នាំ ២០១៦ ប្រទេស នេះ ទើប បាន បង្កើត អាជ្ញាធរ ជាតិ ការងារ ហើយ ពុំ ទាន់ មាន ដំណើរការ ពេញលេញ នៅឡើយ និង កំពុង សិក្សា ស្វែងយល់ បន្ថែម ពី បណ្តា ប្រទេស នានា ដែល ក្នុង នោះ មាន កម្ពុជា ផងដែរ ៕ ប្រជាពលរដ្ឋ រាប់ ពាន់ គ្រួសារ នៅ មូលដ្ឋាន ខណ្ឌ ដង្កោ នឹង ទទួលបាន ផ្លូវ បេតុង មួយ ខ្សែ ទៀត សម្រាប់ ធ្វើដំណើរ
( ភ្នំពេញ ) ៖ លោក នុត ពុធ ដារ៉ា ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា អភិបាល ខណ្ឌ ដង្កោ នៅ ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០១៩ នេះ រួម និង មន្ត្រីរាជការ ខណ្ឌ សង្កាត់ ភូមិ បាន ចុះ សំណេះសំណាល សួរសុខទុក្ខ ប្រជាពលរដ្ឋ និង ពិនិត្យ គម្រោង ស្ថាបនា ផ្លូវ បេតុង ថ្មី ០១ ខ្សែ ប្រវែង ៣៦៦ ម៉ែត្រ ទទឹង ៥ម៉ែត្រ ស្ថិត ក្នុង ភូមិ ព្រៃ កី គ សង្កាត់ ពង ទឹក ។
លោក អភិបាល ខណ្ឌ បាន ផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល ជានិច្ចកាល សម្តេច ទាំង ពីរ តែង បាន គិតគូរ និង យកចិត្តទុកដាក់ ដល់ ការលំបាក នានា របស់ ប្រជាពលរដ្ឋ ព្រមទាំង បាន លើកឡើង អំពី ការអភិវឌ្ឍន៍ រីកចម្រើន ឥត ឈប់ឈរ របស់ ប្រទេសជាតិ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
អភិបាល បាន លើកឡើង ថា ផ្លូវ បេតុង ថ្មី ០១ ខ្សែ នេះ នឹង ជួយ សម្រួល ដល់ ការធ្វើដំណើរ របស់ បងប្អូន ប្រជាពលរដ្ឋ ការប្រកប មុខរបរ និង សោភណ្ឌភាព ក្នុង ការរស់នៅ ផងដែរ ។ បងប្អូន ប្រជាពលរដ្ឋ បាន ធ្វើ ការសាទរ និង ថ្លែងអំណរគុណ ចំពោះ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ ជាពិសេស អាជ្ញាធរ មូលដ្ឋាន ដែល បាន គិតគូរ និង យកចិត្តទុកដាក់ ដល់ ការលំបាក របស់ ពួកគាត់ និង បាន ធ្វើ ការអភិវឌ្ឍន៍ មូលដ្ឋាន បាន រីកចម្រើន ។
ជាមួយគ្នា នេះ បងប្អូន ប្រជាពលរដ្ឋ បាន ធ្វើ ការសាទរ និង ថ្លែងអំណរគុណ ចំពោះ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ ជាពិសេស អាជ្ញាធរ មូលដ្ឋាន ដែល បាន គិតគូរ និង យកចិត្តទុកដាក់ ដល់ ការលំបាក របស់ ពួកគាត់ និង បាន ធ្វើ ការអភិវឌ្ឍន៍ មូលដ្ឋាន បាន រីកចម្រើន ៕
អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា ជួប សំណេះសំណាល ជាមួយ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង សាខា កាកបាទ ក្រហម ខេត្ត
( ត្បូងឃ្មុំ ) ៖ លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា បាន ចុះ ជួប សំណេះសំណាល ជាមួយ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ ដើម្បី ជម្រាប ជូន ពី ការត្រៀម រៀបចំ សន្និបាត ប្រចាំ ឆ្នាំ របស់ សាខា កាកបាទ ក្រហម ខេត្ត ត្បូងឃ្មុំ ។
ជំនួប នេះ ធ្វើឡើង នា រសៀល ថ្ងៃទី ០៤ ខែមីនា ឆ្នាំ ២០១៩ នៅ សាលា ខេត្ត ត្បូងឃ្មុំ ដោយ ការអញ្ជើញ ចូលរួម ពី លោកស្រី ឡេង សុខា អនុប្រធាន សាខា កាកបាទ ក្រហម ខេត្ត និង លោក រស់ សាខ ន នាយក រង សាខា កាកបាទ ក្រហម ខេត្ត ព្រមទាំង ក្រុមការងារ អភិវឌ្ឍ ស្ថាប័ន របស់ កាកបាទ ក្រហម កម្ពុជា ថ្នាក់ កណ្តាល ផងដែរ ។
លោកស្រី ពុំ ចន្ទីនី បាន គូសបញ្ជាក់ ពី សកម្មភាព ការងារ តាម វិស័យ ស្នូល ទាំង៤ របស់ កាកបាទ ក្រហម កម្ពុជា និង សកម្មភាព អប្បបរមា របស់ សាខា កាកបាទ ក្រហម ខេត្ត ជូន លោក អភិបាល ខេត្ត អោយ បាន ជ្រាប ផងដែរ ។
លោក ជា ម ច័ន្ទ សោភ័ណ បាន គាំទ្រ នូវ ប្រសាសន៍ នានា ដែល លោកស្រី លើកឡើង ។ លើស ពី នេះ លោក បាន ថ្លែងអំណរគុណ ចំពោះ លោកស្រី ដែល ចំណាយ ពេលវេលា ដ៍ មាន តម្លៃ អញ្ជើញ មក នា ពេលនេះ ព្រមទាំង ជម្រាប នូវ សកម្មភាព ការងារ មនុស្សធម៍ ទាំងឡាយ របស់ កាកបាទ ក្រហម កម្ពុជា ក៏ ដូចជា បាន ថ្លែងអំណរគុណ និង កោតសរសើរ នូវ ទឹកចិត្ត មេត្តា សណ្តោស ប្រណៃ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន កាកបាទ ក្រហម កម្ពុជា មាន ចំពោះ ប្រជាពលរដ្ឋ គ្រប់ ៗ រូប ពិសេស ក្នុង ខេត្ត ត្បូងឃ្មុំ ។
ដោយឡែក នា ព្រឹក ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា បាន បន្ត ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណៈកម្មាធិការ កាកបាទ ក្រហម ខេត្ត នៅ ស្នាក់ការ កាកបាទ ក្រហម ខេត្ត ត្បូងឃ្មុំ ។
ក្នុង ឱកាស នោះ លោកស្រី ឡេង សុខា អនុប្រធាន សាខា កាកបាទ ក្រហម ខេត្ត ត្បូងឃ្មុំ បាន ជម្រាប ជូន ពី សកម្មភាព មនុស្សធម៍ ទាំងឡាយ ដែល កាកបាទ ក្រហម ខេត្ត ខិតខំ ផ្តល់ ជូន ប្រជាពលរដ្ឋ ដែល ត្រូវការ ស្រប តាម ទិស ស្លោក ទីណា មាន ទុក លំបាក ទីនោះ មាន កាកបាទ ក្រហម កម្ពុជា សម្រាប់ គ្រប់ គ្នា ដោយ មិន ប្រកាន់ ពូជសាសន៍ ពណ៍ សម្បុរ រឺ និន្នាការ នយោបាយ នោះ ឡើយ ។
លោកស្រី ពុំ ចន្ទីនី បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើរ និង សួរសុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន ចំពោះ សមាជិក សមាជិកា កាកបាទ ក្រហម ខេត្ត ត្បូងឃ្មុំ ទាំងអស់ ព្រមទាំង បាន ថ្លែងអំណរគុណ ក៏ ដូចជា ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ទឹកចិត្ត មនុស្សធម៌ របស់ បងប្អូន សមាជិក សមាជិកា កាកបាទ ក្រហម ខេត្ត ត្បូងឃ្មុំ គ្រប់ ជាន់ ថ្នាក់ ទាំងអស់ ផ្តល់ ជូន ពលរដ្ឋ ក្រីក្រ ពលរដ្ឋ រងគ្រោះ ទាំងអស់ ដែល ត្រូវការ កាកបាទ ក្រហម ជា ចាំបាច់ ។
លោកស្រី សង្ឃឹម ថា សមាជិក សមាជិការ កាកបាទ ក្រហម ខេត្ត នឹង បន្ត សាមគ្គី គ្នា ធ្វើឲ្យ វិស័យ មនុស្សធម៌ ក្នុង ខេត្ត ត្បូងឃ្មុំ កាន់តែ ផុស ផុល បន្ថែម ទៀត តាមរយៈ សាខា កាកបាទ ក្រហម ខេត្ត ៕ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៥ ខែមីនា នេះ លទ្ធផល៖ បង្ក្រាប ១៣ករណី ឃាត់ខ្លួន ២៩ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៥ ខែកុម្ភៈ ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
* លទ្ធផល បង្ក្រាប រួម មាន៖ ១៣ករណី ឃាត់ខ្លួន ២៩ នាក់
១៖ ករណី ជួញដូរ គ្រឿងញៀន ៧ករណី ឃាត់ខ្លួន ១៩ នាក់ ។ ២៖ ករណី ប្រើប្រាស់ គ្រឿងញៀន ៦ករណី ឃាត់ខ្លួន ១០នាក់ ៕ ពេជ្រ កម្រ មួយ គ្រាប់ តម្លៃ « ២៧ លាន ដុល្លារ អាមេរិក » ត្រូវ ចោរ លួច បាត់ មួយ ឆ្នាំ ហើយ ប៉ូលិស ស្រីលង្កា អាច រកឃើញ វិញ
( ស្រីលង្កា ) ៖ ប៉ូលិស នៃ ប្រទេស ស្រីលង្កា នា ថ្ងៃអង្គារ នេះ បាន តាម រកឃើញ ត្បូង ពេជ្រ ដ៏ កម្រ និង មាន តម្លៃ មួយ គ្រាប់ យក មកវិញ បន្ទាប់ពី វា ត្រូវបាន ក្រុម ចោរ លួច យក កាលពី ឆ្នាំ មុន ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ល្ងាច ថ្ងៃអង្គារ ទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ ។
គួរ ជម្រាប ថា បើ តាម អ្នកនាំពាក្យ ស្នងការ ប៉ូលិស ស្រីលង្កា ត្បូង ពេជ្រ ខាងលើ ត្រូវបាន លួច ពី ឈ្មួញ ត្បូង ម្នាក់ កាលពី ខែវិច្ឆិកា ឆ្នាំ មុន នៅពេល ចោរ មួយ ក្រុម រួម មាន ទាំង ជនសង្ស័យ ខាងលើ បាន ក្លែង ខ្លួន ជា ប៉ូលិស ហើយ សម្រុក ចូល ទៅក្នុង ផ្ទះ របស់ ឈ្មួញ ត្បូង រូប នោះ ក្រោម ការបង្គាប់បញ្ជា ពី មេ គ្រឿងញៀន ម្នាក់ ។ ខណៈ នេះ ការស៊ើបអង្កេត កំពុងតែ បន្ត ប្រព្រឹត្តទៅ ដើម្បី ឈានដល់ ការចាប់ខ្លួន ជនសង្ស័យ ដែល នៅសល់ ៕
លោកស្រី ម៉ៅ ម៉ាល័យ កែ គឹម យ៉ាន បញ្ចុះ បឋមសិលា អគារ សិក្សា ១ខ្នង មាន ៥ បន្ទប់ តម្លៃ ជាង ២៤០ លាន រៀល នៅ ស្រុក អូរ ជ្រៅ
ក្នុង ឱកាស នោះ ទាំង លោកស្រី ម៉ៅ ម៉ាល័យ កែ គឹម យ៉ាន បាន ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ។
លោកស្រី ម៉ៅ ម៉ាល័យ កែ គឹម យ៉ាន បាន បន្ថែម ថា សាលា ដែល ជា ថ្នាល បណ្តុះ វិជ្ជា បង្កើន ធនធាន មនុស្ស សម្រាប់ ជួយ កសាង ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន ត្រូវបាន រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ពង្រាយ ខិត ទៅ ជិត ផ្ទះ ផ្តល់ ភាពងាយស្រួល ដល់ កូន ចៅ ប្រជាពលរដ្ឋ យើង បាន សិក្សា រៀនសូត្រ ចេះដឹង មាន ការងារ ធ្វើ បង្កើន ចំណូល គ្រួសារ រស់នៅ ក្នុង ជីវភាព ធូរធា ។
ជាមួយគ្នា នេះ លោកស្រី ម៉ៅ ម៉ាល័យ កែ គឹម យ៉ាន បាន បន្ថែម ទៀត ថា ទន្ទឹមនឹង ការរីកចម្រើន និង ភាពសុខសាន្ត របស់ ប្រទេសជាតិ សូម មាតាបិតា ឆក់ ចាប់ យក ឱកាស មាស នេះ ដោយ បញ្ជូន កូន ចៅ ទៅ ទទួល ការសិក្សា ឲ្យបាន គ្រប់ ៗ គ្នា និង ជួយសហការអប់រំ កូន ចៅ ឲ្យបាន ល្អ ហើយ ធានា ថា កូន ចៅ បាន រីកចម្រើន ធំធាត់ ជា មូយ នឹង ចំណេះវិជ្ជា ដោយ មិន ជាប់ពាក់ព័ន្ធ នឹង បញ្ហា គ្រឿងញៀន / គ្រឿងស្រវឹង ។
ជា វប្បធម៌ ចែករំលែក លោកស្រី ម៉ៅ ម៉ាល័យ កែ គឹម យ៉ាន បាន នាំយក អំណោយ ចែកជូន៖១. ប្រជាពលរដ្ឋ ចូលរួម ទាំងអស់ ម្នាក់ ៗ ទទួលបាន សារ៉ុង មួយ . ២. លោកគ្រូ អ្នកគ្រូ ១៤ នាក់ ម្នាក់ ៗ ទទួលបាន សារ៉ុង មួយ ថវិកា ២ម៉ឺន រៀល . ៣. ពេទ្យ ចំនួន ៦នាក់ ម្នាក់ ៗ សារ៉ុង មួយ ថវិកា ២ម៉ឺន រៀល . ៤ ប៉ូលីស និង ប្រជាការពារ ២២ នាក់ ម្នាក់ ៗ សារ៉ុង មួយ សិស្សានុសិស្ស ២០០ នាក់ ម្នាក់ ៗ ទទួលបាន សាប៊ូ ដុស ខ្លួន មួយ ដុំ ផងដែរ ៕
សម្តេច តេជោ ហ៊ុន សែន លើកទឹកចិត្ត ឱ្យ កម្ពុជា - ឡាវ បន្ត ពិភាក្សា សម្រួល ការធ្វើ ពាណិជ្ជកម្ម របស់ ប្រជាជន ទាំង ពីរ នៅ តំបន់ ព្រំដែន
ពី នោះ ទៅ ទៀត លោក ក៏ បាន គោរព ជម្រាប ជូន សម្ដេច តេជោ ថា ការធ្វើ ទស្សនកិច្ច របស់ លោក មកកាន់ កម្ពុជា នៅ ពេល នេះ គឺ ឆ្លើយតប ទៅនឹង អ្វី ដែល បាន សម្រេច កន្លងមក ហើយ កម្ពុជា និង ឡាវ គឺ ត្រូវ ជួបគ្នា ក្នុង មួយ ឆ្នាំ ម្ដង ដើម្បី ពិភាក្សា និង ពិនិត្យមើល អ្វី ដែល បាន ធ្វើ កន្លងមក ហើយនិង ដាក់ ទិសដៅ សម្រាប់ ធ្វើ ការងារ រួមគ្នា ស្រប តាម អ្វី ដែល បាន សម្រេច ដោយ ថ្នាក់ដឹកនាំ ទាំង សងខាង ។
ពិព័រណ៍ លំនៅដ្ឋាន ប្រចាំ ឆ្នាំ ២០១៩ នេះ នឹង អនុញ្ញាតឲ្យ ចូល ទស្សនា ដោយ ឥត គិត ថ្លៃ និង មាន បញ្ចុះ តម្លៃ ពិសេស ៗ ទៀត ផងដែរ ៕
លោក ឡាំ គឹម ឡេង អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន សហគ្រាស ធុន តូច មធ្យម និង សិប្បកម្ម ក្រសួង ឧស្សាហកម្ម និង សិប្បកម្ម បាន ថ្លែង ក្នុង កិច្ចសម្ភាសន៍ កម្មវិធី ភ្ញៀវ ពិសេស ប្រចាំ សប្តាហ៍ របស់ ទូរទស្សន៍ Fresh News ថា តាម ផែនការ ដែល បាន គ្រោង ទុក អនុក្រឹត្យ ស្តីពី ការបង្កើត សហគ្រាស ធុន តូច និង មធ្យម កម្ពុជា នៅក្នុង ខែមីនា ឆ្នាំ ២០១៩ នេះ ហើយ ដំណើរការ នៃ ធនាគារ នេះ អាចនឹង ចាប់ផ្តើម នៅ ចុង ត្រីមាស ទី៣ ឬ ដើម ត្រីមាស ទី៤ នៃ ឆ្នាំ នេះ ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ បាន ថ្លែង ថា នារី គឺជា កម្លាំង ដ៏ មុតស្រួច និង ជា ធនធាន មនុស្ស ដ៏ មាន តម្លៃ ដោយ មិន អាច ខ្វះ បាន ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ ប្រកបដោយ ប្រសិទ្ធភាព បំផុត ខណៈ បច្ចុប្បន្ន ប្រទេស កម្ពុជា បាន កំពុង រីកលូតលាស់ គួរឲ្យ កត់សម្គាល់ ចំពោះ នារី ក្នុង ការដឹកនាំ នៅ តាម ស្ថាប័ន នីមួយ ៗ នោះ ។
សូម ជម្រាប ថា ទិវា អន្តរជាតិ នារី ៨មីនា នៅក្នុង ឆ្នាំ ២០១៩ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច លើក យក ប្រធានបទ « លើក កំពស់ សមភាព យេនឌ័រ និង ការគាំពារ សង្គម ដើម្បី អភិវឌ្ឍន៍ ធនធាន មនុស្ស » សម្រាប់ ដាក់ ចេញ ជា សកម្មភាព គន្លឹះ ក្នុង ការអនុវត្ត គោ នយោបាយ ជាតិ គាំពារ សង្គម ដែល ជា ផ្នែក មួយ នៃ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ៕
គុយបា បន្ថយ ការពឹងផ្អែក លើ ឥន្ធនៈ និង ក្រសោប យក ថាមពល ព្រះអាទិត្យ វិញ ដោយសារ ការចំណាយ ថោក
( ឡាហាវ៉ាន់ ) ៖ ប្រទេស គុយ បា កំពុង បន្ត ប្តេជ្ញា កាត់បន្ថយ ភាព ពឹងផ្អែក លើ ឥន្ធនៈ ហ្វូស៊ីល តាមរយៈ ការបំលែង ពន្លឺ ព្រះអាទិត្យ ឲ្យ ទៅជា ថាមពល ដើម្បី ប្រើប្រាស់ វិញ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ល្ងាច ថ្ងៃអង្គារ ទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ ។
គួរ ជម្រាប ថា ការកែប្រែ ការផលិត ថាមពល នៅក្នុង ប្រទេស គុយ បា ឲ្យ ទៅ រក ប្រភព ថាមពល ដែល អាច កើត ឡើងវិញ បាន គឺជា សសរ ស្តម្ភ មួយ នៃ កម្មវិធី កំណែទម្រង់ សេដ្ឋកិច្ច របស់ រដ្ឋាភិបាល គុយ បា ដែល មាន គោលដៅ កាត់បន្ថយ ការនាំចូល ឥន្ធនៈ ដែល មាន តម្លៃ ថ្លៃ ។ ប្រភព ធនធាន ថាមពល អាច កើត ឡើងវិញ បាន ដែល មាន ស្រាប់ របស់ គុយ បា បូករួម ជាមួយ មូលដ្ឋាន ដែល ទើប សាងសង់ ហើយ ថ្មី ៗ ត្រូវ គេ រំពឹង ថា នឹង អាច ផលិត ថាមពល បាន ជាង ១.១០០ មេហ្គាវ៉ាត់ ក្នុង ឆ្នាំ ២០១៩ នេះ ៕
គ.ជ. ប៖ បក្ស នយោបាយ ចុះបញ្ជី ត្រឹមត្រូវ ស្រប តាម ច្បាប់ នៅ ក្រសួង មហាផ្ទៃ មាន សិទ្ធិ ចុះបញ្ជី ឈរឈ្មោះ បោះឆ្នោត សម្រាប់ ជ្រើសរើស ក្រុមប្រឹក្សា អាណត្តិ ទី៣
( ភ្នំពេញ ) ៖ លោក មាន សទិ សមាជិក គ.ជ. ប បាន ថ្លែង ថា គ្រប់ គណបក្ស នយោបាយ ដែល បាន ចុះបញ្ជី យ៉ាង ត្រឹមត្រូវ ស្រប តាម ច្បាប់ ស្តីពី គណបក្ស នយោបាយ នៅ ក្រសួង មហាផ្ទៃ មាន សិទ្ធិ ចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត និង បញ្ជី បេក្ខជន ឈរឈ្មោះ សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា អាណត្តិ ទី៣ ឆ្នាំ ២០១៩ ។
ការលើកឡើង របស់ លោក មាន សទិ្ធ ធ្វើឡើង ក្នុង កិច្ចប្រជុំ ជាមួយ ភាគី ពាក់ព័ន្ធ ស្តីពី ការចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត និង បញ្ជី បេក្ខជន ឈរឈ្មោះ និង ការប្តឹង តវ៉ា និង ដោះស្រាយ ពាក្យ បណ្តឹង ទាក់ទង នឹង ការចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត និង បញ្ជី បេក្ខជន ឈរឈ្មោះ នៅ សាល សន្និសីទ គ .ជ. ប នា ព្រឹក ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០១៩ ។
ភាគី ពាក់ព័ន្ធ ដែល បាន ចូលរួម កិច្ចប្រជុំ នេះ រួម មាន៖ តំណាង ក្រុមប្រឹក្សា ធម្មនុញ្ញ ព្រឹទ្ធសភា រដ្ឋសភា ក្រសួង មហាផ្ទៃ ក្រសួង ព័ត៌មាន គណបក្ស នយោបាយ ចំនួន ៩ តំណាង ស្ថានទូត ជប៉ុន អង្គការ មិន មែន រដ្ឋាភិបាល ចំនួន ១៧ អង្គភាព សារព័ត៌មាន ចំនួន ៦ និង មន្ត្រី គ.ជ. ប សរុប ចំនួន ៨០ នាក់ ។
លោក មាន សទ្ធិ បាន បន្ថែម ថា គណបក្ស នយោបាយ ដែល មាន បំណង ចូលរួម ប្រកួតប្រជែង ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ត្រូវ ចាប់ផ្តើម ដាក់ពាក្យ សុំ ចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត នៅ គណៈកម្មការ រាធានី - ខេត្ត រៀបចំ ការបោះឆ្នោត ( គធ. ខប ) យ៉ាងតិច ៨០ ថ្ងៃ មុន កាលបរិច្ឆេទ នៃ ការបោះឆ្នោត មាន ន័យ ថា ការចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត និង បញ្ជី បេក្ខជន ឈរឈ្មោះ មាន រយៈពេល តែ ៥ ថ្ងៃ ប៉ុណ្ណោះ ចាប់ផ្តើម ពី ថ្ងៃទី ៧ ដល់ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០១៩ ។
ឆ្លើយតប ទៅនឹង សំណួរ អ្នកសារព័ត៌មាន ថា តើ មាន គណបក្ស នយោបាយ ចំនួន ប៉ុន្មាន នឹង ចូលរួម ប្រកួតប្រជែង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា លោក កែវ ផល្លា ទីប្រឹក្សា គ.ជ. ប និង ជា ប្រធាន នាយកដ្ឋាន សេវាកម្ម ច្បាប់ និង វិវាទកម្ម ពន្យល់ ថា គ.ជ. ប មិន អាច សន្និដ្ឋាន បាន ថា មាន គណប័ក្ស នយោបាយ ចំនួន ប៉ុន្មាន នឹង ដាក់ពាក្យ ចូលរួម ប្រកួតប្រជែង ទេ ប៉ុន្តែ មាន គណបក្ស នយោបាយ ចំនួន ៤ តែងតែ ទាក់ទង មក មន្ត្រី ជំនាញ ដើម្បី សួរ ព័ត៌មាន ។ គណបក្ស នយោបាយ ទាំង៤ នោះ រួម មាន ៖
* គណបក្ស ប្រជាជន កម្ពុជា * គណបក្ស ហ៊្វុនស៊ិនប៉ិច * គណបក្ស ខ្មែរ រួបរួម ជាតិ * គណបក្ស យុវជន កម្ពុជា ។
សូម ជម្រាប ជូន ថា កាលបរិច្ឆេទ នៃ ការចាប់ឆ្នោត កំណត់ លំដាប់ លេខរៀង គណបក្ស នយោបាយ នៅលើ សន្លឹក ឆ្នោត គ.ជ. ប មិន មែន ជា អ្នក កំណត់ ទេ គឺ អាស្រ័យ ទៅ លើ នីតិវិធី នៃ ការចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត និង បញ្ជី បេក្ខជន ឈរឈ្មោះ និង ការប្តឹង តវ៉ា និង ដោះស្រាយ ពាក្យ បណ្ដឹង ទាក់ទង នឹង ការចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត ចប់ ជា ផ្លូវការ ទៅ តាម គធ . ខប នីមួយ ៗ ៕
លោក ប៉ាន សូរស័ក្តិ៖ ក្រសួង ពាណិជ្ជកម្ម នឹង រៀបចំ គម្រោង មេ ដើម្បី ពង្រឹង សិ្ថរភាព ទីផ្សារ និង តម្លៃ កសិផល ជូន ប្រជាកសិករ
នៅក្នុង ពិធី សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ នៃ មន្ទីរ ពាណិជ្ជកម្ម និង សាខា កាំ កុងត្រូល ខេត្ត កណ្តាល នៅ ថ្ងៃអង្គារ ទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ លោក ប៉ាន សូរស័ក្តិ បាន គូសបញ្ជាក់ ថា ផ្នែក រឹង សំដៅ លើ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធឡសម្ងួត ដើម្បី រក្សាទុក កសិផល កុំ ឱ្យ ខូច ចំណែកឯ ផ្នែក ទន់ សំដៅ លើ ការទទួល ទិញ កសិផល ពី ប្រជាកសិករ ទៅ តាម តម្លៃ ទីផ្សារ ហើយ ថវិកា ជាតិ គឺជា ប្រភព ទុន សម្រាប់ អនុវត្ត គម្រោង មេ ។
( កាស្មៀរ ) ៖ អាជ្ញាធរ ឥណ្ឌា នៅ ថ្ងៃអង្គារ នេះ បាន ឱ្យដឹង ថា ជន សកម្ម ប្រយុទ្ធ សរុប ០២ នាក់ បាន ស្លាប់ នៅក្នុង ការបាញ់ប្រហារ តបត គ្នា ជាមួយ យោធា នៅឯ តំបន់ កាស្មៀរ ប៉ែក ខាង ទឹកដី ដែល គ្រប់គ្រង ដោយ ឥណ្ឌា ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃអង្គារ ទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ ។
ប៉ុន្តែ អត្តសញ្ញាណ ជន សកម្ម ប្រយុទ្ធ ទាំង ២នាក់ មិន ត្រូវបាន កំណត់ នៅឡើយ ខណៈ ភាពតានតឹង រវាង ឥណ្ឌា និង ប៉ាគីស្ថាន ត្រូវបាន គេ មើលឃើញ ថា នឹង ផ្ទុះឡើង ជាថ្មី ក្រោយ ទីក្រុង ញូដេលី អះអាង ថា បាន បាញ់ ទម្លាក់ យន្ដហោះ ដ្រូន ប៉ាគីស្ថាន មួយ គ្រឿង នៅក្នុង ដែន អាកាស របស់ ខ្លួន កាលពី យប់ ថ្ងៃចន្ទ ដដែល នោះ ។
គួរ បញ្ជាក់ ថា បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ នៅក្នុង តំបន់ ជន ស៊ីវិល ម្នាក់ បាន រងរបួស រីឯ ផ្ទះ អ្នកភូមិ មួយ ខ្នង ក៏ បាន បំផ្លាញ ទាំងស្រុង ផងដែរ នៅក្នុង ការវាយប្រយុទ្ធ គ្នា រវាង យោធា ឥណ្ឌា និង ជន សកម្ម ប្រយុទ្ធ ៕
មន្រ្ដី នគរបាល ២រូប និង បក្ខពួក ជិត ១០នាក់ ព្រួត គ្នា វាយ យុវជន ម្នាក់ ស្ទើរ ស្លាប់ នៅ ស្រុក អន្លង វែង
( ឧត្ដរ មានជ័យ )៖ មន្រ្ដី នគរបាល បំរើការងារ នៅ អង្គភាព វរ ការពារ ព្រំដែន គោក លេខ ៩០៥ ចំនួន ២រូប និង បក្ខពួក ជា ក្មេង ស្ទាវ ជិត១០ បាន ព្រួត គ្នា វាយ យុវជន ម្នាក់ ស្ទើរ ស្លាប់ ស្ទើរស់ រហូត រងរបួស ហើម ហើម មុខ ហើម ភ្នែក និង ឈាម ឡើង ពេញ គ្រប់ ភ្នែក ។
អំពើហិង្សា ខាងលើ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ៨៖៣០ នាទី យប់ ថ្ងៃទី ៣ ខែមីនា ឆ្នាំ ២០១៩ ស្ថិត នៅក្នុង រោង កម្មវិធី ឡើង គេហដ្ឋាន មួយ កន្លែង ស្ថិត នៅ ភូមិ អូតា ម៉ែង ឃុំ អន្លង់ វែង ស្រុក អន្លង់ វែង ខេត្ត ឧត្ដរ មានជ័យ ។ ជនរងគ្រោះ ឈ្មោះ ឃឹម ឃាង អាយុ ១៨ ឆ្នាំ រស់ នៅ ភូមិ រំចេក ឃុំ អន្លង់ វែង ស្រុក អន្លង់ វែង ខេត្ត ឧត្ដរ មានជ័យ ។
ប្រជាការពារ ភូមិ អូតា ម៉ែង ដែល នៅក្នុង ហេតុការ បាន ឲ្យដឹង ថា ជន បង្ករ ឈ្មោះ ទី១ ឈ្មោះ ង៉ោល សុភណ្ឌ័ ហៅ ចំរើន ទី២ ឈ្មោះ ឌៀ ជា មន្រ្ដី នគ បាល វរ ការពារ ព្រំដែន គោក លេខ ៩០៥ នៃ ស្នងការដ្ឋាន នគ បាល ខេត្ត ឧត្ដរ មានជ័យ និង ជន បង្ក ជា បក្ខពួក ម្នាក់ ទៀត ឈ្មោះ រ៉ាន់ និង បក្ខពួក ជិត ១០នាក់ ទៀត ដែល មិន បាន ស្គាល់ ឈ្មោះ ។
ប្រជាការពារ ភូមិ បាន បញ្ជាក់ បន្ដ ថា ក្រុម ជន ដៃ ដល់ ជា មន្រ្ដី នគរបាល សាហាវ ៗ ខ្លាំង ណាស់ ។ ពួកគាត់ ជា សន្តិសុខ ក្នុង ភូមិ ៤ ទៅ ៥នាក់ ចូល ឃាត់ ក៏ មិន ឈ្នះ ដែរ គាត់ សូម អំពាវនាវ ដល់ អ្នក ច្បាប់ ជួយ ចាត់ វិធានការ តាម ច្បាប់ ផង ។
ជនរងគ្រោះ បាន ឲ្យដឹង នា ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០១៩ នេះ ថា មុនពេល កើត ហេតុ រូប គាត់ បាន ហូបចុក ក្នុង កម្មវិធី ឡើង គេហដ្ឋាន នៅ ភូមិ ឃុំ ខាងលើ ពេល កំពុង ហូបចុក គាត់ បាន ក្រោក ដើរ ចេញ ពី តុ ដែល ខ្លួន អង្គុយ ទៅ រក ជល់ កែវ មិត្តភ័ក្រ ក៏ បាន ក្រពុប ទឹក កូ្រច អ្នកអង្គុយ ជិត ស្រក់ ទៅ លើ តុ មន្រ្ដី នគរបាល ង៉ោល សុភណ្ឌ័ ហៅ ចំរើន អង្គុយ ហើយ ខ្លួន ក៏ បាន លើក ដៃ សំពះ សុំទោស និង ជួយ រក តុ ថ្មី ប្ដូរ ឲ្យ រួចហើយ ដែរ ។
ស្រាប់តែ ពេល រូប គាត់ ចូល រាំ លេង បាន បន្តិច ស្រាប់តែ មន្ដ្រី នគរបាល រូប នេះ បាន លោត ទៅ ដាល់ គាត់ ចំភ្នែក តែម្ដង និង មាន បក្ខពួក ជិត ១០នាក់ ព្រួត គ្នា វាយ គាត់ បន្ថែម ទៀត ស្ទើ ស្លាប់ ស្ទើរស់ កុំ តែ បាន ប្រជាការពារ ភូមិ ជួយ ឃាត់ ខំ អី ប្រហែល អាចនឹង ស្លាប់ បាត់បង់ជីវិត ។
រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ត្រៀម ទីកន្លែង បើក ការដ្ឋាន សាងសង់ ផ្លូវ លឿន ពី ភ្នំពេញ - ខេត្ត ព្រះសីហនុ
( កំពង់ស្ពឺ ) ៖ នៅ ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០១៩ លោក វ៉ី សំណាង អភិបាល នៃ គណៈអភិបាល ខេត្ត កំពង់ស្ពឺ បាន អញ្ជើញ បើក កិច្ចប្រជុំ ជាមួយ ក្រុមការងារ មកពី អន្តរ ក្រសួង ស្ដីពី ការត្រៀម រៀបចំ ទីតាំង បើក ការដ្ឋាន សាងសង់ គម្រោង ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ខេត្ត ព្រះសីហនុ ដែល គ្រោង រៀបចំ ពិធី នា ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោក វ៉ាង វិន ធាន ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ កម្ពុជា ។
គួរ បញ្ជាក់ ផងដែរ ថា ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ខេត្ត ព្រះសីហនុ មាន ប្រវែង ជាង ១៩០ គីឡូម៉ែត្រ ដែល ចេញ ពី ម្តុំ ផ្លូវ រទេះភ្លើង នៃ តំបន់ ទំនប់ កប់ ស្រូវ ស្ថិត នៅ ខាងស្តាំ ដៃ ផ្លូវ ជាតិ លេខ ៤ និង សាងសង់ ស្រប គ្នា នឹង ផ្លូវ ជាតិ នេះ រហូត ជិត ដល់ ទី រួម ខេត្ត កំពង់ស្ពឺ ទើប ផ្លូវ នេះ ឆ្លងកាត់ ផ្លូវ ជាតិ លេខ ៤ ងាក មក ខាងឆ្វេង ដៃ វិញ ហើយ បន្ត រហូតដល់ ស្រុក ព្រៃនប់ ទើប ផ្លូវ នេះ ងាក មក ស្តាំ ដៃ រហូតដល់ មាត់ សមុទ្រ នៃ ក្រុង ព្រះសីហនុ ។
គម្រោង សាងសង់ ផ្លូវ ល្បឿន ភ្នំពេញ - ខេត្ត ព្រះសីហនុ ត្រូវបាន ចុះហត្ថលេខា រវាង លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន កម្ពុជា បាន ចុះហត្ថលេខា ជាមួយ លោក លាវ ឈីថា វ ប្រធាន ក្រុមហ៊ុន សំណង់ គមនាគមន៍ ចិន កាលពី ដើម ឆ្នាំ ២០១៨ ។ ពិធី ចុះហត្ថលេខា នោះ ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោក លី ខឺ ឈាង នាយក រដ្ឋមន្ត្រី ចិន ក្នុង ពេល ដែល លោក នាយក រដ្ឋមន្ត្រី ចិន បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ។
តុលាការ ចេញ ដីកា ឃុំ ខ្លួន មេ ការ ហាង កាត់ សក់ បង្កប់ សេវា ផ្លូវភេទ ២នាក់ ប្តី - ប្រពន្ធ
ជន ត្រូវ ចោទ ទី១ ឈ្មោះ លឹម ជីណា ម អាយុ ៣៧ ឆ្នាំ ជា ប្រពន្ធ និង ទី២ ឈ្មោះ មិត្ត ចិន្ថា ហៅ ច័ន្ទ អាយុ ៣៧ ឆ្នាំ ជា ប្តី ត្រូវបាន តុលាការ សម្រេច ឃុំ ខ្លួន ក្រោម បទ ចោទ « សញ្ចារកម្ម » យោង តាម មាត្រា ២៦ នៃ ច្បាប់ ស្តីពី ការបង្ក្រាប អំពើ ជួញដូរ មនុស្ស និង អំពើ ធ្វើ អាជីវកម្ម ផ្លូវភេទ ។
លោក សុខ ចិន្តា សោភា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន ជម្រាប ជូន អង្គ សិក្ខាសាលា អំពី កាលានុវត្តភាព និង បរិយាកាស វិនិយោគ នៅ កម្ពុជា ក៏ ដូចជា គោល នយោបាយ ថ្មី ៗ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ ដើម្បី លើកកម្ពស់ សមត្ថភាព ប្រកួតប្រជែង របស់ កម្ពុជា ក្រោម បាវចនា ចំនួន ២ និង អភិក្រម ចំនួន ៥ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ។
លោក ក៏ បាន ជម្រាប ជូន អង្គ សិក្ខាសាលា អំពី វិស័យ អាទិភាព ដែល រាជ រដ្ឋាភិបាល កម្ពុជា ចង់ ទាក់ទាញ ការវិនិយោគ ពី បរទេស ក្នុង ការធ្វើ ពិពិធកម្ម សេដ្ឋកិច្ច ដូចជា វិស័យ ផ្គុំ ដំឡើង សម្ភារៈ បរិក្ខារ វិស័យ កសិ- ឧស្សាហកម្ម និង ផលិត ចំណីអាហារ ៕
ទី១៖ ត្រូវ រួមគ្នា យកចិត្តទុកដាក់ តាមរយៈ ការផ្តល់ អាទិភាព បង្កើន ចំនួន ស្ត្រី ឱ្យ មាន តួនាទី ជា ថ្នាក់ដឹកនាំ នៅ គ្រប់ វិស័យ និង គ្រប់ កម្រិត ទៅ តាម សមត្ថភាព ដែល មាន ហើយ ត្រូវ ជួយ ដោះស្រាយ បញ្ហា ផ្សេង ៗ ដែល កើតមាន នៅក្នុង ឱកាស បំពេញ ការងារ តាម តួនាទី របស់ ពួកគាត់ ។
ទី២៖ ត្រូវ រួមគ្នា ពង្រឹង ការអនុវត្ត ច្បាប់ និង ត្រូវ ពនឿន ដំណើរការ កាត់ក្តី ឱ្យ បាន ទាន់ ពេលវេលា ដើម្បី ទប់ស្កាត់ អំពើហិង្សា ទាក់ទង នឹង យេនឌ័រ ហើយ ត្រូវ សហការ គ្នា បង្កើត ឱ្យ មាន មូលដ្ឋាន ស្ថិតិ រួម ជា ផ្លូវការ មួយ ដែល អាច តាមដាន និង វាយតម្លៃ អំពី ប្រសិទ្ធភាព នៃ ការផ្តល់ សេវា ជួយ ជនរងគ្រោះ ដោយ អំពើហិង្សា ទាក់ទង នឹង យេនឌ័រ ។
ទី៣៖ ក្រសួង អប់រំ យុវជន និង កីឡា ត្រូវ ធ្វើ ការណែនាំ ដល់ គ្រប់ គ្រឹះស្ថាន សិក្សា ទាំងអស់ ឱ្យ ពង្រឹង ការអនុវត្ត វិន័យ ទន្ទឹម នេះ ត្រូវ បន្ត ផ្តល់ ឱកាស់ ដល់ ក្មេងស្រី នៅ គ្រប់ កម្រិត ដើម្បី បាន សិក្សា មុខជំនាញ វិទ្យាសាស្រ្ត បច្ចេកវិទ្យា វិស្វកម្ម និង គណិតវិទ្យា (STEM) ដែល ជា យុគ ទំនើបកម្ម បច្ចេកវិទ្យា ។
ទី៤៖ ក្រសួង មហាផ្ទៃ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ និង ក្រសួង ព័ត៌មាន ត្រូវ គ្រប់គ្រង ការប្រើប្រាស់ ប្រព័ន្ធ អឺនធឺណិត នៅ ទូទាំង ប្រទេស ឱ្យ មាន ប្រសិទ្ធភាព ដើម្បី ទប់ស្កាត់ បញ្ហា ជាច្រើន ដែល ពាក់ព័ន្ធ នឹង អំពើហិង្សា ការកេងប្រវ័ញ្ច លើ ស្ត្រី និង ក្មេងស្រី តាម ប្រព័ន្ធ អឺនធឺណិត និង បញ្ហា ញ ផ្សព្វផ្សាយ ផ្សេង ៗ ដែល ធ្វើឱ្យ បាត ស្តាប់ធ្នាប់ សង្គម ។
ទី៥៖ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ក្រសួង ព័ត៌មាន និង បញ្ហា ញ ផ្សព្វផ្សាយ ទាំងអស់ ត្រូវ បន្ត ពង្រឹង និង លើកកម្ពស់ សីលធម៌ សង្គម តម្លៃ ស្ត្រី និង គ្រួសារ ខ្មែរ តាមរយៈ ការបង្កើត កម្មវិធី អប់រំ ល្អ ៗ ដើម្បី បង្ហាញ អំពី អត្តចរិត ស្ត្រី ខ្មែរ ជាពិសេការស្លៀកពាក់ ប្រកបដោយ ភាពថ្លៃថ្នូរ មាន លក្ខណៈ ជា ស្ត្រី ខ្មែរ ស័ក្តិសម ជា ប្រទេស ដែល មាន អរិយធម៌ រុងរឿង នៅ គ្រប់ ជំនាន់ ។
ក្នុង ពិធី អបអរសាទរ ទិវា នារី អន្តរជាតិ នៅ ព្រឹក មិញ នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន គូសបញ្ជាក់ ដែរ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន បង្កើត លិខិត បទដ្ឋាន គោល នយោបាយ និង ផែនការ សកម្មភាព ជាតិ ដើម្បី ឆ្លើយតប នឹង អំពើហិង្សា គ្រប់ រូបភាព លើ ស្ត្រី និង ក្មេង ស្រ្តី និង ការលើកកម្ពស់ គុណភាព នៃ ការផ្តល់ សេវា ជា ពហុ វិស័យ នៅ តាម បណ្ហា ខេត្ត នានា តាមរយៈ ក្រុមការងារ អន្តរ ស្ថាប័ន ដោយ មាន កិច្ចសហការ ជាមួយ អង្គការ មិន មែន រដ្ឋាភិបាល ដើម្បី ជួយ ជនរងគ្រោះ ឱ្យ បាន ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព ។
ការអំពាវនាវ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ត្រូវបាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ នេះ ក្នុង ឱកាស ដែល សម្តេច និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ខួប លើក ទី ១០៨ នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ ។
សម្តេច តេជោ ហ៊ុន សែន មានប្រសាសន៍ បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « អ្វី ដែល ជា ការអំពាវនាវ របស់ ខ្ញុំ សុំឲ្យ បណ្តា សហគ្រាស ក្រុមហ៊ុន ទាំងឡាយ ដែល មិន ទាន់ បាន ចុះបញ្ជី ត្រូវតែ ចុះបញ្ជី ដើម្បី ធានា ថា កម្មករ ត្រូវបាន ទទួល ផលប្រយោជន៍ ពី នយោបាយ គាំពារ សង្គម ដោយ ទទួលបាន នូវ ការ ពិនិត្យ និង ព្យាបាល ដោយ ឥត គិត ប្រាក់ ជាពិសេស គឺ សម្រាប់ កម្មការិនី ដែល ធ្វើការ នៅ ទីកន្លែង នោះ ដើម្បី ទទួលបាន នូវ អត្ថប្រយោជន៍ ពី គោល នយោបាយ គាំពារ សង្គម របស់ រាជ រដ្ឋាភិបាល សម្រាប់ ស្ត្រី មាន ផ្ទៃពោះ និង ឆ្លង ទន្លេ » ។
សម្តេច មានប្រសាសន៍ បន្ត ថា « ដូច្នេះ ផលប្រយោជន៍ ដល់ កម្មករ ទាំង បុរស និង កម្ម ការិនី ជា ស្ត្រី នឹង ត្រូវបាត់បង់ ក៏ប៉ុន្តែ ត្រូវតែ ពន្លឿន នូវ បញ្ហា ដែល សម្រាប់ កម្មការិនី របស់ យើង តើ យើង អាច ធ្វើ ទៅ រួមគ្នា បាន ទេ ស្រង់ ស្ថិតិ នៅ តាម រោងចក្រ សហគ្រាស មួយចំនួន ឬ ក៏ កន្លែង ធ្វើការ មួយចំនួន កសិដ្ឋាន មួយចំនួន ដោយ យើង អាច ផ្តល់ ប័ណ្ណ ជូន ពួកគាត់ ដើម្បី ធានា ការ រាប់ រក ជាមួយនឹង ផលប្រយោជន៍ របស់ ពួកគាត់ ឆ្លង ទន្លេ នូវ ការ ពិនិត្យ ព្យាបាល ដោយ មិន គិត ប្រាក់ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បន្ត ថា ត្រូវ យកចិត្តទុកដាក់ អនុវត្តន៍ ឲ្យបាន ហ្មត់ចត់ ទៅ លើ សេវា គាំពារ សង្គម ដើម្បីឲ្យ ស្រ្តី ទទួលបាន អត្ថប្រយោជន៍ របស់ រាជ រដ្ឋាភិបាល ដែល ត្រូវបាន ដាក់ចេញ ។ ក្រសួង ក៏ ត្រូវ បន្ត យកចិត្តទុកដាក់ ចំពោះ កម្ម ការិនី ដោយ ទទួលបាន ឈប់ សម្រាក រយៈពេល ៣ខែ ជាមួយ អត្រា ប្រាក់ ឈ្នួល ១២០ ភាគរយ និង ប្រាប់ ឧបត្ថម្ភ របស់ រាជ រដ្ឋាភិបាល ផងដែរ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន សម្រេច ឲ្យ មាន ការឧបត្ថម្ភ ដល់ កម្មការិនី ពេល សម្រាល កូន ចាប់តាំងពី ដើម ឆ្នាំ ២០១៨មក ។ ក្នុង នោះ កម្ម ការិនី សម្រាល កូន១ ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ៤០ ម៉ឺន រៀល កូន ភ្លោះ ពីរ ទទួលបាន ៨០ ម៉ឺន រៀល និង កូន ភ្លោះ បី ទទួលបាន ១លាន ២សែន រៀល ផងដែរ ៕
ការសម្រេច ខាងលើ របស់ លោក ដូណាល់ ត្រាំ ធ្វើឡើង ដោយ លោក សំអាង ថា រដ្ឋាភិបាល ទីក្រុង ញូដេលី បាន បរាជ័យ ក្នុង ការអនុញ្ញាតឱ្យ ផលិតផល អាមេរិក ចូលក្នុង ទីផ្សារ ឥណ្ឌា ដោយ ស្មើភាព ដូច ដែល អាមេរិក បាន ធ្វើ ។ ប៉ុន្តែ ឥណ្ឌា អះអាង ថា ការលុបចោល លក្ខនិ្តកៈ ពាណិជ្ជកម្ម ជាពិសេស នឹង មិន ធ្វើឱ្យ ប៉ះពាល់ ធ្ងន់ធ្ងរ ដល់ សេដ្ឋកិច្ច ជាតិ របស់ ខ្លួន នោះ ទេ ហើយ ម្យ៉ាង វិញ ទៀត ក្រៅតែ ពី ឥណ្ឌា សហរដ្ឋ អាមេរិក ក៏ បាន ប្រកាស បញ្ចប់ លក្ខន្តិកៈ ពិសេស ដូចគ្នា នេះ សម្រាប់ ប្រទេស តួកគី ផងដែរ ។
គួរ បញ្ជាក់ ថា ការលុបចោល លក្ខនិ្តកៈ ពាណិជ្ជកម្ម ពិសេស ចេញ ពី ប្រទេស ឥណ្ឌា និង តួកគី គឺជា ការចាត់ វិធានការ ចុងក្រោយ បំផុត នៃ រដ្ឋបាល លោក ដូណាល់ ត្រាំ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ការធ្វើ ឬ ការអនុវត្ត ពណិជ្ជកម្ម មិន ត្រឹមត្រូវ ខណៈ លោក ត្រាំ ផ្ទាល់ បាន សន្យា ថា នឹង កាត់បន្ថយ ឱន ភាព ពាណិជ្ជកម្ម រវាង សហរដ្ឋ អាមេរិក និង បណ្ដា ប្រទេស ដទៃ ៕
លោក ប៉ាន សូរស័ក្តិ ស្នើ មន្ត្រី ដាក់ គម្រោង AIMS ទៅក្នុង ផែនការ សកម្មភាព ដើម្បី បង្កើន ចំណូល ជូន ប្រជាជន និង តភ្ជាប់ ផលិតផល ជាមួយ ទីផ្សារ
( កណ្តាល ) ៖ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម លោក ប៉ាន សូរស័ក្តិ បាន ស្នើ មន្ត្រី នៅ តាម មន្ទីរ ពាណិជ្ជកម្ម ទាំងអស់ ចូលរួម អនុវត្ត គម្រោង ជំរុញ ទីផ្សារ សម្រាប់ កសិកម្ម ខ្នាត តូច (AIMS) ដែល គាំទ្រ ដោយ មូលនិធិ អន្តរជាតិ សម្រាប់ ការអភិវឌ្ឍ កសិកម្ម (IFAD) ដើម្បី បង្កើន ប្រាក់ ចំណូល ជូន ប្រជាកសិករ ដែល ជា អ្នកផលិត តាមរយៈ ការតភ្ជាប់ ជាមួយ ទីផ្សារ ដែល មាន ស្រាប់ និង ប្រឹងប្រែង អភិវឌ្ឍន៍ ទីផ្សារ ថ្មី បន្ថែម ទៀត ដើម្បី ជួយ ដល់ អ្នកផលិត ទាំងអស់ ធ្វើ ការលក់ ផលិតផល បាន កាន់តែ ច្រើន ។
លោក រដ្ឋមន្ត្រី បាន លើក សំណើ នេះ ឡើង កាលពី ព្រឹក ថ្ងៃអង្គារ ទី ០៤ ខែមីនា ឆ្នាំ ២០១៩ នៅក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ប្រកាស ចូលកាន់ មុខតំណែង ផ្លូវការ របស់ លោក អោម ប៊ុន ធឿន ប្រធាន មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត កណ្តាល ថ្មី ជំនួស លោក ឃឹម សុផល ( ចូលនិវត្តន៍ ) ដែល រៀបចំឡើង នៅ រដ្ឋបាល សាលា ខេត្ត កណ្តាល ក្រោម វត្តមាន ចូលរួម ពី ឯកឧត្តម ម៉ៅ ភិរុណ អភិបាល នៃ គណៈអភិបាល ខេត្ត រួម ជាមួយ អាជ្ញាធរដែនដី ថ្នាក់ដឹកនាំ និង មន្ត្រី នៃ មន្ទី ពាណិជ្ជកម្ម ប្រមាណ ជាង ២០០ នាក់ ។
លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន មានប្រសាសន៍ ថា « ការងារ នេះ មិន មែន ជា ការងារ បន្ថែម ទេ គឺ ត្រូវ បញ្រ្ជាប ចូល ទៅក្នុង ការងារ ស្នូល របស់ មន្ទីរ ទាំងអស់ ដើម្បី ជា បទពិសោធន៍ មួយ ថ្មី សម្រាប់ មន្ទីរ ពាណិជ្ជកម្ម របស់ យើង ក្នុង ការអនុវត្ត ផែនការ សកម្មភាព របស់ ខ្លួន » ។
ទន្ទឹម គ្នា នោះ ដែរ លោក រដ្ឋមន្ត្រី បាន លើកទឹកចិត្ត ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រី នៃ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត កណ្តាល ប្រឹងប្រែង អនុវត្ត ការងារ របស់ ខ្លួន ឱ្យ បាន ខ្ជាប់ខ្ជួន និង ម៉ត់ចត់ បំផុត ដើម្បី បង្កើន ផលិតភាព សម្រាប់ ផលិតផល នៅក្នុង ខេត្ត និង ធ្វើ ការតភ្ជាប់ ផលិតកម្ម ទាំងនោះ ទៅនឹង ទីផ្សារ សំដៅ ធានា បាន ស្ថិរភាព ចង្វាក់ ផលិតកម្ម និង ប្រាក់ ចំណូល ជូន ប្រជាពលរដ្ឋ ។
ប្រតិកម្ម របស់ តុលាការ កំពូល បាន ធ្វើឡើង បន្ទាប់ពី ប្រធាន គណបក្ស ខ្មែរ ក្រោម ដែល ត្រូវបាន គេ ប្រសិទ្ធិ នាម « ឯកឧត្តម ឫក កប់ ពពក » រូប នេះ កាលពី ថ្ងៃទី ០២ ខែមីនា ឆ្នាំ ២០១៩ កន្លងទៅ នេះ បាន សរសេរ ថា តុលាការ បាន ចេញ សេចក្តីសម្រេច ខុស បែបបទ គតិយុត្តិ ពាក់ព័ន្ធ បញ្ហា ដីធ្លី នៅ ភូមិ គគី ឃុំ បិត ត្រាំង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
ក្នុង សេចក្តីប្រកាស ព័ត៌មាន នេះ តុលាការ កំពូល បាន បញ្ជាក់ ដែរ ថា សាល ដីកា តុលាការ កំពូល រហូតមកដល់ ពេលនេះ នៅតែ មាន តម្លៃ គតិយុត្តិ ពីព្រោះ មិន ទាន់ មាន ស្ថាប័ន ឬ សមត្ថកិច្ច ណា បដិសេធ ឬ ទុក ជា មោឃៈ ឡើយ ។
ប្រតិកម្ម ទៅនឹង ការលើកឡើង របស់ លោក William Guang ដោយ ចោទប្រកាន់ ថា « យក ដី រដ្ឋ មក កាត់ក្តី ចែក ឯកជន » នោះ តុលាការ កំពូល ចាត់ទុក ការចោទប្រកាន់ នេះ ជា ការចោទប្រកាន់ ដោយ អសុទ្ធ ចិត្ត ព្រមទាំង ធ្វើ ការផ្សព្វផ្សាយ ជាសាធារណៈ ដោយ បំភាន់ ញុះញង់ ក្នុង គោលបំណង ធ្វើឲ្យ បាត់ ជំនឿ លើ សេចក្តីសម្រេច របស់ តុលាការ ។
តុលាការ កំពូល បាន អះអាង ថា ដី ដែល ជា កម្មវត្ថុ នៃ វិវាទ គឺជា ដ៏ បាន មកពី ការទិញ - លក់ ហើយ ក្រសួង មាន សមត្ថកិច្ច បាន ចេញ ប័ណ្ណ សម្គាល់ សិទ្ធិ កាន់កាប់ អចលន វត្ត ឲ្យ ទៀតផង មិន មែន ជា ដី រដ្ឋ ទេ ។ ដូច្នេះ តុលាការ គ្រាន់តែ អនុវត្ត តួនាទី របស់ ខ្លួន ដើម្បី ផ្តល់ យុត្តិធម៌ ឲ្យ តួ ភា នៅពេល មាន បណ្តឹង ស្រប តាម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ជាធរមាន តែ ប៉ុណ្ណោះ ។
តាមរយៈ សេចក្តីប្រកាស ព័ត៌មាន នេះ តុលាការ កំពូល ក៏ ប្រកាស ថា តុលាការ គ្រប់ ជាន់ ថ្នាក់ ដែល ជា ស្ថាប័ន តំណាង ឲ្យ អំណាច ទី៣ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ទទួលយក ការរិះគន់ ស្ថាបនា ទាំងអស់ ដែល មាន ហេតុផល ត្រឹមត្រូវ និង ហ៊ាន ទទួលខុសត្រូវ តាម ច្បាប់ នូវ រាល់ ចំណាត់ការ របស់ ខ្លួន ។ តែ ខ្លួន មិន ទទួលយក ដាច់ខាត នូវ ការវាយប្រហារ ទាំងឡាយ ណា ដែល ទុច្ចរិត គ្មាន មូលដ្ឋាន ធ្វើឲ្យ បាត់ ជំនឿ ដល់ តុលាការ និង រក្សា សិទ្ធិ ប្តឹង ឲ្យ ចោទប្រកាន់ តាម មាត្រា ៥២៣ នៃ ក្រម ព្រហ្មទណ្ឌ ។
រដ្ឋបាល ខេត្ត ព្រះសីហនុ បន្ថែម ថា « អ្វី ដែល ម្ចាស់ គណនី បណ្តាញ សង្គម ឈ្មោះ William Guang បាន លើកឡើង គឺ គ្រាន់តែ ដើម្បី លើកតម្លៃ ផ្ទាល់ខ្លួន ដោយ ប្រើ ចរិត អុច អាល ញុះញង់ បំបែកបំបាក់ ទាញយក ប្រជាប្រិយភាព ផលប្រយោជន៍ ដោយ ពន្យុះ មហាជន ឲ្យ មាន ការយល់ ច្រឡំ មក លើ រដ្ឋបាល ខេត្ត ។ ជាពិសេស ការដឹកនាំ របស់ ឯកឧត្តម យន្ត មីន អភិបាល នៃ គណៈអភិបាល ខេត្ត តែ ប៉ុណ្ណោះ »៕ ក្រសួង សាធារណការ ចុះ កិច្ចព្រមព្រៀង ជាមួយ ក្រុមហ៊ុន ទូទាត់ សាច់ប្រាក់ ទំនើប មួយ លើ ការផ្តល់ ដំណោះស្រាយ ទូទាត់ បង់ ប្រាក់
តាមរយៈ កិច្ចព្រមព្រៀង ភាពជាដៃគូ នេះ អតិថិជន អាច ធ្វើ ការទូទាត់ ថ្លៃ សេវា បាន យ៉ាង រហ័ស ទៅកាន់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ទាក់ទង នឹង ការចុះបញ្ជី យានយន្ត ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានយន្ត ចេញ បណ្ណ បើកបរ យានយន្ត និង អាជីវកម្ម ដឹក ជញ្ជូន ផ្លូវគោក បាន ភ្លាម ៗ ប្រកបដោយ សុវត្ថិភាព និង ភាពងាយស្រួល ។ សេវាកម្ម ទូទាត់ បង់ ប្រាក់ នេះ មាន ភាពរហ័ស ងាយស្រួល និង ចំណេញ ថវិកា ទៀតផង ។
ត្រឹម ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០១៩នេះ តារា ផេ មាន ភ្នាក់ងារ ច្រើន ជាង ៣.០០០ កន្លែង ទូទាំង ខេត្ត ក្រុង ក្នុង ប្រទេស កម្ពុជា រង់ចាំ បម្រើ សេវា ជូន អតិថិជន ដូចជា សេវា វេរ លុយ ក្នុង ប្រទេស ទូទាំង ២៥ ខេត្ត ក្រុង ទូទាត់ វិក្កយបត្រ នានា និង ថ្លៃ ទឹក ភ្លើង បញ្ចូល លុយ កាត ទូរស័ព្ទ សេវា ទូបង់ប្រាក់ កម្ចី ការណែនាំ កម្ចី និង សេវា ដទៃ ទៀត ជាច្រើន ។
ថ្លែង នៅក្នុង ឱកាស នេះ ដែរ លោក ពៅ ម៉ាលី បាន ថ្លែង ថា « ក្រុមហ៊ុន តារា ផេ បាន បង្ហាញ ពី ឆន្ទៈ ដ៏ មុះ មុត របស់ ខ្លួន ក្នុង ការជួយ ជំរុញ ប្រសិទ្ធភាព នៃ សេវា សាធារណៈ សម្រាប់ ប្រព័ន្ធ ដឹកជញ្ជូន របស់ ប្រទេស កម្ពុជា ។ យើង រីករាយ ណាស់ ដែល បាន ចាប់ដៃគូ ជាមួយ ក្រុមហ៊ុន តារា ផេ ដើម្បី លើកកម្ពស់ ជីវភាព ប្រជាជន កម្ពុជា តាមរយៈ កិច្ច ខិតខំ ប្រឹងប្រែង ដើម្បី ធ្វើឲ្យ សេវា សាធារណៈ សម្រាប់ ប្រព័ន្ធ ដឹកជញ្ជូន មាន តម្លៃ សមរម្យ និង កាន់តែ ខិត ទៅ ជិត ប្រជាពលរដ្ឋ គ្រប់ រូប ក្នុង ប្រទេស កម្ពុជា »៕
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៥ ខែមីនា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៧០៨ គ្រឿង និង ផាក ពិន័យ ៤៥០ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៤.៤០៧ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៧០៨ គ្រឿង ( ម៉ូតូ ៣៦ %) អប់រំ២៥៨ គ្រឿង និង ផាក ពិន័យ ៤៥០ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ០៥ ខែមីនា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ២. ៣១៦ គ្រឿង . អប់រំ១៧៦ គ្រឿង និង ផាក ពិន័យ ៣៦៤ គ្រឿង ។
មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន បើក កិច្ចប្រជុំ លើក ដំបូង របស់ ខ្លួន ដើម្បី ដាក់ គោលការណ៍ ការពារ ក្តី ជូន ស្ត្រី ក្រីក្រ ទូទាំង ប្រទេស (Video Inside) ( ភ្នំពេញ ) ៖ លោក មេធាវី គី តិច ប្រធាន មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន នៅ រសៀល ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ បើក កិច្ចប្រជុំ ជា លើក ដំបូង របស់ ខ្លួន ដើម្បី ដាក់ គោលការណ៍ មួយចំនួន ដើម្បី ការពារ ក្តី ជូន ស្រ្តី ក្រីក្រ ទូទាំង ប្រទេស ដែល ពុំ មាន លទ្ធភាព រក មេធាវី ការពារ ក្តី ។
ពិធី នេះ ប្រព្រឹត្ត ធ្វើឡើង នៅ ការិយាល័យ មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន ក្នុង ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ដោយ មាន ការអញ្ជើញ ចូលរួម ពី សំណណាក់ អនុប្រធាន និង សមាជិក របស់ ខ្លួន ចំនួន ៦៣ រូប ដែល ទទួលបន្ទុក បេសកកម្ម រៀង ៗ ខ្លួន ទូទាំង ២៥ រាជធានី - ខេត្ត ក្រុង ។
នៅក្នុង កិច្ចប្រជុំ លោក មេធាវី គី តិច បាន លើកឡើង ថា ការបង្កើត មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន គឺ ដើម្បី ជួយ ដល់ អ្នកក្រ។ ដូច្នេះ អត់ មាន យក ឈ្មោះ ទៅ ទារ ប្រាក់ ពី អ្នក នោះ ទេ ហើយ ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន គឺ ស្មើភាព គ្នា អត់ មាន ខ្សែ អ្នកណា ម្នាក់ នោះ ឡើយ គឺ មាន តែ មេធាវី ដែល ស្ម័គ្រចិត្ត តែ ប៉ុណ្ណោះ ។
លោក មេធាវី គី តិច ក៏ បាន លើកឡើង ទៀត ថា សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហាញ មោទនភាព និង ផ្តល់ ភាពជឿជាក់ ខ្លាំង ណាស់ ចំពោះ ក្រុម មេធាវី ដោយ សម្តេច បាន លើក ជាប្រសាសន៍ ចំនួន ៣ដង រួចហើយ ហើយ ក្រុម មេធាវី នេះ គឺជា ភ្នែក ជា ច្រមុះ របស់ ប្រមុខ នៃ រាជ រដ្ឋាភិបាល ។
សម្តេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា៖ « ដើម្បី ជួយ ស្រ្តី រងគ្រោះ ទន់ខ្សោយ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នឹង ពិចារណា ក្នុង ការបង្កើត « ក្រុម មេធាវី ការពាក្តី » ដែល ស្ថិត នៅក្រោម ការគ្រប់គ្រង ផ្ទាល់ របស់ សម្តេច តេជោ ដើម្បី ជួយ ដល់ ជនរងគ្រោះ ដែល ជា ស្រ្តី ក្រីក្រ»៕ សហគមន៍ កសិកម្ម « បន្លែ ចម្រុះ ជាយ ក្រុង ខេត្ត កំពង់ស្ពឺ » ឈ្នះ ជ័យលាភី ជា សហគមន៍ កសិកម្ម ឆ្នើម ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ ទីបំផុត វេទិកា ស្តីពី ការប្រកួតប្រជែង សហគមន៍ កសិកម្ម ឆ្នើម ឆ្នាំ ២០១៩ បាន រកឃើញ ម្ចាស់ ជ័យលាភី លេខ ១ហើយ គឺ បាន ទៅ លើ សហគមន៍ កសិកម្ម បន្លែ ចម្រុះ ជាយ ក្រុង ខេត្ត កំពង់ស្ពឺ ក្នុង ចំណោម សហគមន៍ កសិកម្ម ចំនួន ១២០ មកពី ២៥ រាជធានី ខេត្ត ។
ពិធី បិទ វេទិកា ស្តីពី ការប្រកួតប្រជែង សហគមន៍ កសិកម្ម ឆ្នើម ២០១៩ ត្រូវបាន រៀបចំឡើង ក្រោម អធិបតីភាព លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ អម ដោយ សមាជិក សមាជិកា ដែល ជា ថ្នាក់ដឹកនាំ ក្រសួង លោក លោកស្រី បងប្អូន ប្រជាកសិករ សមាជិក សហគមន៍ ប្រមាណ ៣០០ នាក់ ។
លោក បន្ត ថា នេះ ជា លើក ទី៤ ហើយ ដែល អគ្គ នាយកដ្ឋាន កសិកម្ម បាន រៀបចំ វេទិកា នេះ ឡើង ក្នុង គោលបំណង គឺ ដើម្បី ធ្វើ ការប្រកួតប្រជែង និង ជ្រើសរើស សហគមន៍ កសិកម្ម ឆ្នើម ប្រចាំ ឆ្នាំ ទូទាំង ប្រទេស រួច ផ្តល់ រង្វាន់ លើកទឹកចិត្ត ជូន ដល់ សហគមន៍ កសិកម្ម ដែល បាន ឈ្នះ ជ័យលាភី ។
លោក បាន បន្ត ទៀត ថា វេទិកា នេះ ពិតជា បាន បង្ហាញ ឲ្យ ឃើញ អំពី ការចូលរួមចំណែក ក្នុង ការអនុវត្ត យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៤ ស្រប តាម បរិបទ សមាហរណកម្ម សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន សាកល ភាវូបនីយកម្ម ការប្រកួតប្រជែង ទីផ្សារ ការប្រែប្រួល អាកាសធាតុ គោលដៅ អភិវឌ្ឍ វិស័យ កសិកម្ម ប្រកបដោយ ចីរភាព កំណើន សេដ្ឋកិច្ច សង្គម នៅ ជនបទ ការកាត់បន្ថយ ភាពក្រីក្រ និង ធានា បាន នូវ ប្រព័ន្ធ សន្តិសុខ ស្បៀង ។
លោក រដ្ឋមន្ត្រី បាន ផ្តល់ អនុសាសន៍ សំខាន់ ៗ មួយចំនួន ឲ្យ ថ្នាក់ដឹកនាំ អគ្គ នាយកដ្ឋាន កសិកម្ម មន្រ្តី ជំនាញ និង ជាពិសេស ដល់ សហគមន៍ កសិកម្ម ដើម្បី យក ទៅ គិត ត្រិះរិះ ពិចារណា ច្នៃប្រឌិត បង្កើត បាន នូវ យុទ្ធសាស្រ្ត ដឹកនាំ និង អនុវត្ត ថ្មី ៗ បន្ថែម ទៀត ដើម្បី អភិឌ្ឍន៍ សហគមន៍ កសិកម្ម ឲ្យ មាន ការរីកចម្រើន និង ទទួលបាន ជោគជ័យ បន្តបន្ទាប់ ដែល ខ្លឹមសារ នៃ ជា រួម ទាក់ទង ទៅ នឹង៖
សូម បញ្ជាក់ ថា គណៈប្រតិភូ ចុះ ត្រួតពិនិត្យ កិច្ច ដំណើរការប្រមូល ទិន្នន័យ ជំរឿន នេះ ធ្វើឡើង នាទី តាំងពីរ ផ្សេង ៗ គ្នា ទីតាំង ទី១ សង្កាត់ ទឹកល្អក់ ទី១ ខណ្ឌ ទួលគោក និង ទីតាំង ទី២ ស្ថិត នៅ ភូមិ ចំការ ឱឡឹក ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
លោកស្រី សិទ្ធិ ណារ៉ាស៊ី ប្រធាន មន្ទីរ កិច្ចការ នារី ខេត្ត បាន ជម្រាប ជូន របាយការណ៍ វឌ្ឍនភាព ការងារ កិច្ចការ នារី រយៈពេល មួយ ឆ្នាំ ដល់ សមាជិក សមាជិកា ក្នុង ឱកាស ខួប លើក ទី ១០៨ ទិវា នារី អន្តរជាតិ ៨មីនា ដោយ បាន បញ្ជាក់ ថា ស្ត្រី ពិតជា មិន អាច ខ្វះ បាន ក្នុង កិច្ចអភិវឌ្ឍន៍ ប្រទេស ព្រោះ ស្ត្រី ជា ឆ្អឹង ខ្នង សេដ្ឋកិច្ច មាន តួនាទី រួមចំណែក ដ៏ សំខាន់ ជាមួយ បុរស និង ជា ដៃគូ ក្នុង ការធ្វើឲ្យ ប្រសើរឡើង នូវ ស្ថានភាព និង ជីវភាព សង្គម ។
លោកស្រី បាន ឲ្យដឹង ទៀត ថា មន្ទីរ កិច្ចការ នារី បាន សហការ ជាមួយ គណៈកម្មការ សាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ដែល មាន លោកស្រី ហ៊ុន ចាន់ ធី ម៉ៅ ធ និន ជា ប្រធាន កិត្តិយស បាន ធ្វើ សកម្មភាព ផ្តោត សំខាន់ ការងារ មនុស្សធម៌ ជួយ ជន ចាស់ជរា ទុរគត ជន និង ពិធី បុណ្យ ផ្សេង ៗ ចំណាយ ថវិកា អស់ ជាង ១១១ លាន រៀល ក្នុង នោះ ថវិកា ផ្ទាល់ របស់ លោកស្រី អស់ ជាង ៦៤០ លាន រៀល ។
ថ្លែង ក្នុង អង្គ មិទ្ទិញ លោក ម៉ៅ ធ និន អភិបាល នៃ គណៈអភិបាល ខេត្ត ពោធិ៍សាត់ បាន ចាត់ទុក ទិវា អន្ត ជាតិ នារី ៨មីនា ខូប លើក ទី១០៨ ក្រោម ប្រធានបទ « លើកកម្ពស់ សមភាព យេនឌ័រ និង ការគាំពារ សង្គម ដើម្បី អភិវឌ្ឍ ធនធាន មនុស្ស » នៅក្នុង ខេត្ត របស់ យើង នា ពេលនេះ ពិតជា មាន សារៈសំខាន់ ណាស់ ក្នុង គោលបំណង បន្ត រំលេច ពី តម្លៃ សន្តិភាព និង ជម្រុញ គាំទ្រ ស្រ្តី ដើម្បី វឌ្ឍនៈ ភាព សង្គម ឆ្ពោះទៅ លើកកម្ពស់ សិទ្ធិ ស្ថានភាព ជីវភាព ឋានៈ តួនាទី និង សុខុមាលភាព អភិវឌ្ឍន៍ ធនធាន មនុស្ស ប្រកបដោយ គុណភាព និង សមត្ថភាព ។
លោក អភិបាល ខេត្ត បន្ត ថា ការបញ្ជ្រាប យេនឌ័រ ទៅក្នុង ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ២០១៦ - ២០២៥ របស់ រាជ រដ្ឋាភិបាល បាន នឹង កំពុង បន្ត រៀបចំ គម្រោង ស្បៀង បម្រុង និង សាច់ប្រាក់ បន្ថែម ដល់ ស្ត្រី មាន ផ្ទៃពោះ និង កុមារ ដែល ជា ផ្នែក នៃ ប្រព័ន្ធ ជំនួយ សង្គម និង កំពុង អនុវត្ត មូលនិធិ សមធម៌ សុខាភិបាល និង របប សន្តិសុខ សង្គម សម្រាប់ មន្ត្រីរាជការ និង អតីត យុទ្ធជន និង ជន ពិកា ។
លោក បាន ថ្លែង ឲ្យដឹង ទៀត ថា ថ្មី ៗ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន លើក ទិសដៅ ផែនការ សកម្មភាព ការងារ ឆ្នាំ ២០១៩ របស់ ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី ស្រ្តី បន្ត ផ្សព្វផ្សាយ អនុសញ្ញា ការលុបបំបាត់ រាល់ ទម្រង់ រើសអើង បញ្ជ្រាប យេនឌ័រ កាន់តែ ទូលំទូលាយ ស្វែងយល់ អំពី ឧបស័គ្គ ក្នុង ការបំពេញ ភារកិច្ច របស់ ស្ត្រី នៅ ថ្នាក់ ក្រោម ជាតិ អភិវឌ្ឍន៍ សមត្ថភាព ស្រី្ត ជា ថ្នាក់ដឹកនាំ ជាពិសេស ស្ត្រី វ័យ ក្មេង ។
ជាមួយគ្នា នោះ ក្នុង នាម រដ្ឋបាល ខេត្ត សូម សម្តែង នូវ ការកោតសរសើរ ដោយ ស្មោះ ដល់ បងប្អូន នារី ទូទាំង ខេត្ត ដែល បាន ចូលរួម និង មាន ការតស៊ូ អំណត់ ព្យាយាម កែប្រែ ឥរិយាបថ របស់ មនុស្ស ក្នុង សង្គម ទទួលបាន នូវ អត្ថប្រយោជន៍ ពី ធនធាន សេដ្ឋកិច្ច និង សិទ្ធិ ស្មើគ្នា ជាមួយ បុរស ។
ក្នុង ឱកាស នោះ លោក ម៉ៅ ធ និន និង លោកស្រី ហ៊ុន ចាន់ ធី ក៏ បាន ទទួលបាច់ ផ្កា និង វត្ថុអនុស្សាវរីយ៍ ពី ប្រធាន មន្ទីរ និង សមាជិកា កិត្តិយស សមាគម នារី ខេត្ត និង បាន ចែកជូន វត្ថុ កំដរ ដៃ ដល់ អ្នកចូលរួម ជាង ១ពាក់ នាក់ ក្នុង ម្នាក់ ទទួលបាន សារុង១ ដែល ជា អំណោយ ផ្ទាល់ខ្លួន របស់ លោក និង លោកស្រី ផងដែរ ៕ វេទិកា យុវជន តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ កម្ពុជា វៀតណាម និង ឡាវ លើក ទី៨ រៀបចំ ២ ថ្ងៃ នៅ ខេត្ត ក្រចេះ . រដ្ឋមន្រ្តី អប់រំ សង្ឃឹម ថា យុវជន ប្រទេស ទាំង៣ ទទួលបាន ការអប់រំ មួយ មាន កំរិត ខ្ពស់
( ក្រចេះ ) ៖ កិច្ចសហប្រតិបត្តិការ តំបន់ ត្រីកោណ កម្ពុជា - ឡាវ - វៀតណាម បាន រៀបចំ វេទិកា យុវជន តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ លើក ទី៨ ក្រោម អធិបតីភាព លោក បណ្ឌិត សភាចារ្យ ហង់ ជួនណារ៉ុន រដ្ឋមន្រ្តី ក្រសួង អប់រំ យុវជន និង កីឡា និង លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ ព្រមទាំង មាន ការចូលរួម ពី ប្រធាន អនុប្រធាន មន្ទីរ ជំវិញ ខេត្ត នៅ ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០១៩ នៅ ខេត្ត ក្រចេះ រយៈពេល ពីរ ថ្ងៃ ។
លោកស្រី ស្រូយ សុជាតិ អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន យុវជន និង ជា ប្រធាន ប្រតិភូ យុវជន កម្ពុជា បាន ឲ្យដឹង ថា វេទិកា យុវជន តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ លើក ទី៨ ដែល គណៈប្រតិភូ យុវជន ទាំង៣ ប្រទេស បាន មក ជួបជុំគ្នា នេះ ជា ព្រឹត្តិការណ៍ រៀបចំឡើង បន្ត វេន បន្ទាប់ពី វេទិកា យុវជន តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ លើក ទី៧ បាន រៀបចំឡើង នៅក្នុង ឆ្នាំ ២០១៧ នា ខេត្ត ប៊ិន ហ្វ៉ឺក ប្រទេស វៀតណាម ។
សេចក្តីថ្លែងការណ៍ រួម របស់ ប្រជាជន តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ ត្រូវបាន កំណត់ យក ជា ធាតុ ចូល ដ៏ មាន សារៈសំខាន់ សម្រាប់ រាយការណ៍ ក្នុង កិច្ចប្រជុំ គណៈកម្មាធិការ ជាតិ សម្រាប់ សម្របសម្រួល កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍ តំបន់ ត្រីកោណ កម្ពុជា - ឡាវ - វៀតណាម ដើម្បី ផ្ដល់ ឱ្យ ប្រមុខ រាជ រដ្ឋាភិបាល នៃ ប្រទេស ក្នុង តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ កម្ពុជា - ឡាវ - វៀតណាម ធ្វើ សេចក្តីសម្រេចបាន ត្រឹមត្រូវ និង រៀបចំ បាន នូវ គោល នយោបាយ និង កម្មវិធី ជាតិ អភិវឌ្ឍន៍ យុវជន ឆ្លើយតប ទៅនឹង តម្រូវការ របស់ យុវជន ។
នៅក្នុង កិច្ចប្រជុំ យុវជន តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ គឺ ពិភាក្សា លើ របៀប វរៈ៣ សំខាន់ ៗ រួម មាន៖
