( ភ្នំពេញ ) ៖ កម្លាំង ព្រហ្មទណ្ឌ នៃ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១៤ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ បាន បញ្ជូន ខ្លួន បុរស ម្នាក់ ទៅ សាលាដំបូង រាជធានី ភ្នំប ពេញ ពាក់ព័ន្ធ ករណី រំលោភ លើ ទំនុកចិត្ត និង ចេញ សែក គ្មាន សាច់ប្រាក់ ។
មន្រ្តី អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ប្រចាំ តុលាការ ថា ជនសង្ស័យ មាន ឈ្មោះ ខាត់ គន្ធី អាយុ ៣១ ឆ្នាំ រស់ នៅ ផ្ទះ លេខ ២៤០ ភូមិ ប៉ប្រក ខាងត្បូង សង្កាត់ កាកាប ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
ជនសង្ស័យ ត្រូវ កម្លាំង កងរាជអាវុធហត្ថ ឃាត់ខ្លួន កាលពី ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នៅក្នុង ភោជនីយដ្ឋាន មួយ កន្លែង ក្នុង សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
បច្ចុប្បន្ន ជនសង្ស័យ កំពុង ស្ថិត ក្រោម ការសាកសួរ របស់ តំណាង អយ្យការ ដើម្បី ពិនិត្យ និង សម្រេច តាម ផ្លូវ ច្បាប់ ៕ សម្តេច តេជោ ហ៊ុន សែន ជំរុញ ឲ្យ កម្ពុជា - ឥណ្ឌូនេស៊ី ពង្រីក ទំនាក់ទំនង លើ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម វិនិយោគ ទេសចរណ៍ និង វប្បធម៌ (Video Inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ជំរុញ ឲ្យ កម្ពុជា និង ឥណ្ឌូនេស៊ី ពង្រឹង ពង្រីក ទំនាក់ទំនង ជាមួយគ្នា កាន់តែ ស៊ីជម្រៅ និង គ្រប់ ជ្រុងជ្រោយ ទៅ លើ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម វិនិយោគ ទេសចរណ៍ និង វប្បធម៌ ។
ការជំរុញ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅក្នុង ជំនួប ពិភាក្សា ការងារ ជាមួយ លោកស្រី ពាន់ មហារ៉ានី រដ្ឋមន្រ្តី សម្របសម្រួល អភិវឌ្ឍន៍ មនុស្សជាតិ និង កិច្ចការ វប្បធម៌ របស់ ឥណ្ឌូនេសុី នា ព្រឹក ថ្ងៃទី ១៤ ខែកុម្ភៈ នេះ បាន អនុញ្ញាតឲ្យ លោកជំទាវ នៅ វិមាន សន្តិភាព ។
បើ តាម លោក លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ឲ្យដឹង ថា ក្នុង ជំនួប នោះ លោកស្រី ពាន់ មហារ៉ានី បាន គោរព ជម្រាប ជូន សម្តេច តេជោ ពី គោលបំណង របស់ លោកស្រី មកកាន់ កម្ពុជា ។ លោក ស្រ្តី បាន លើកឡើង ថា ដំណើរ មកកាន់ កម្ពុជា នៅ ពេល នេះ ដើម្បី ចូលរួម កម្មវិធី ខួប ៦០ ឆ្នាំ នៃ ទំនាក់ទំនង ការទូត រវាង កម្ពុជា និង ឥណ្ឌូនេស៊ី ដែល ទំនាក់ទំនង នេះ បាន បន្សល់ទុក ដល់ ជំនាន់ ក្រោយ ដោយ ព្រះបរម រតន កោដ្ឋ នរោត្តម សីហនុ ផង និង អតីត ប្រធានាធិបតី ស៊ូ កាណូ ។
លោកស្រី បាន អំណរគុណ ជ្រាលជ្រៅ ជា ទីបំផុត ចំពោះ ការចូលរួម យ៉ាង ច្រើន អធិកអធ័ម អំពី ថ្នាក់ដឹកនាំ កម្ពុជា នៅក្នុង កម្មវិធី នៃ ខួប នៃ ទំនាក់ទំនង ការទូត នេះ ។ លោកស្រី បាន ជម្រាប ជូន សម្ដេច តេជោ ផងដែរ ថា ពី ការជ្រើសរើសយក ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ដើម្បី អបអរសាទរ ខួប ៦០ ឆ្នាំ នៃ ទំនាក់ទំនង ប្រទេស ទាំង ពីរ ព្រោះតែ កាលពី ៦០ ឆ្នាំ មុន ថ្នៅងៃ នេះ ( ១៣ ខែកុម្ភៈ ឆ្នាំ ១៩៥៩ ) ប្រទេស ឥណ្ឌូនេស៊ី និង កម្ពុជា បាន ចុះហត្ថលេខា លើ កិច្ចសហប្រតិបត្តិការ រវាង គ្នា និង គ្នា ។
ជា ការឆ្លើយតប សម្ដេច តេជោ បាន ថ្លែងអំណរគុណ ចំពោះ លោកស្រី ដែល បាន មក ចូលរួម កម្មវិធី នេះ ហើយ នាំមក នូវ សិល្បករ សិល្បការ នី ចូលរួម កម្មវិធី ធ្វើឲ្យ កម្មវិធី ទំនាក់ទំនង ការទូត រវាង ប្រទេស ទាំង ពីរ ញ៉ាំង ឲ្យ មាន ភាពអធិកអធម និង ពោរពេញ ទៅ ដោយ ការចងចាំ ។ សម្ដេច តេជោ ក៏ បាន ប្រសាសន៍ ថា ថ្នាក់ដឹកនាំ ជំនាន់ មុន បាន បន្សល់ នូវ ទំនាក់ទំនង នេះ ដល់ អ្នកជំនាន់ ក្រោយ ហើយ ក្រោយ រយៈពេល ៦០ ឆ្នាំ នេះ ទំនាក់ទំនង កម្ពុជា - ឥណ្ឌូនេស៊ី បាន រីក ធំធាត់ ដុះ ដាល និង រឹងមាំ ជាលំដាប់ ។
លើស ពី នោះ ទៅ ទៀត ឥណ្ឌូនេស៊ី ក៏ បាន ដើរ តួយ៉ាង សំខាន់ កន្លងមក រយៈពេល ៦០ ឆ្នាំ នេះ ទាំង នៅក្នុង តំបន់ ទាំង នៅក្នុង ពិភពលោក ។ ដោយឡែក សម្រាប់ កម្ពុជា ឥណ្ឌូនេស៊ី បាន ដើរតួរ យ៉ាង សំខាន់ ក្នុង ការចូលរួមចំណែក ស្វែងរក សន្តិភាព ឲ្យ កម្ពុជា តាមរយៈ ការចូលរួម ធ្វើ សហ ប្រធាន នៃ កិច្ចចរចា ផង និង ក្នុង កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ផង ។
លើស ពី នោះ ទៅ ទៀត ឥណ្ឌូនេស៊ី ក៏ បាន រួមចំណែក ក្នុង ការបញ្ជូន ទ័ព មក ការពារ សន្តិភាព ក្នុង ការស្វែងរក សន្តិភាព នៅ កម្ពុជា ក៏ ដូចជា ពង្រីក នូវ កិច្ចសហប្រតិបត្តិការ រួមទាំង ការហ្វឹកហាត់ និង ការអភិវឌ្ឍ ធនធាន មនុស្ស ផងដែរ ។
សម្ដេច តេជោ បាន មានប្រសាសន៍ ថា កម្ពុជា និង ឥណ្ឌូនេស៊ី គប្បី ពង្រឹង និង ពង្រីក ទំនាក់ទំនង នេះ ឲ្យ កាន់តែ ស៊ីជម្រៅ និង គ្រប់ ជ្រុងជ្រោយ ថែម ទៀត តាមរយៈ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម វិនិយោគ ទេសចរណ៍ និង វប្បធម៌ រួមគ្នា តែម្ដង ។ ជាពិសេស ទៀត ការផ្លាស់ប្តូរ បទពិសោធន៍ ទំនាក់ទំនង ទស្សនកិច្ច គ្នា រវាង ប្រជាជន និង ថ្នាក់ដឹកនាំ នៃ ប្រទេស ទាំង ពីរ ៕
បើ តាម ការបកស្រាយ ពី ប្រជាពលរដ្ឋ ជា ម្ចាស់ ដី បាន ឲ្យដឹង ថា ពួកគាត់ យល់ព្រម លក់ ដី ទាំងនោះ ដោយ គ្មាន កែរ ប្រែ ទេ ប៉ុន្តែ ដោយសារតែ មាន ការយឺតយ៉ាវ ក្នុង ការប្រគល់ ប្រាក់ ពីសំណាក់ ឈ្មួញ ទិញ ដី ទើប ពួក គាត់ ជា ម្ចាស់ ដី នាំគ្នា តវ៉ា និង ហាមឃាត់ មិន ឲ្យ មាន ការឈូសឆាយ នៅលើ ដី ដែល មិន ទាន់ ទូទាត់ លុយ គ្រប់ ចំនួន នោះ ។
ម្យ៉ាង វិញទៀត ការទូទាត់ ថ្លៃ ដី រវាង ភាគី អ្នកទិញ និង អ្នកលក់ គឺ ធ្វើឡើង ជា លក្ខណៈ ឯកជន មិន មាន ការ ដឹង លឺ ឬ ទទួលស្គាល់ ពី អាជ្ញាធរ មូលដ្ឋាន ឡើយ ចំនែក ឯ ឈ្មួញ ដី ឈ្មោះ សូ សារឹម បាន លក់ ដី ដែល ទិញ ពី ប្រជាពលរដ្ឋ នោះ លក់ បន្ត ឲ្យ ជន ទី៣ ឈ្មោះ លី ជុន ហើយ បាន ដាក់ គ្រឿងចក្រ ដើម្បី ចូល ឈូសឆាយ ស្រាប់តែ ប្រជាពលរដ្ឋ នាំគ្នា រារាំង មិន អោយ ចូលទៅ វិញ ។
ដោយឡែក ចំពោះ ព័ត៌មាន ខាងលើ លោក ហ៊ុយ សេង បាន ទទូច ស្នើសុំ ដល់ អ្នកសារព័ត៌មាន ដែល បាន ចុះផ្សាយ នូវ ព័ត៌មាន ពាក់ ពន្ធ័ មួយចំនួន ខាងលើ សូម សិក្សា ស្រាវជ្រាវ អោយ បាន ច្បាស់លាស់ មុននឹង ចេញផ្សាយ ជៀសវាង ការភ័ន្តច្រលំ នាំឲ្យ ប៉ះពាល់ ដល់ សារធារណៈ ជន ក៏ ដូចជា ស្ថាប័ន របស់ ខ្លួន ផងដែរ ៕
លោក ឧត្តមសេនីយ៍ ឯក ឌី វិជ្ជា អញ្ជើញ ជា អធិបតី បិទ វគ្គ បំប៉ន និង ផ្តល់ បទពិសោធន៍ ជំនាញ ការងារ សន្តិសុខ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ឌី វិជ្ជា អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ប្រធាន នាយកដ្ឋាន កណ្តាល សន្តិសុខ តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ នៅ រសៀល ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បិទ វគ្គ បំប៉ន និង ផ្តល់ បទពិសោធន៍ ជំនាញ ការងារ សន្តិសុខ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រៃវែង ។
វគ្គ បំប៉ន និង ផ្តល់ បទពិសោធន៍ ជំនាញ ការងារ សន្តិសុខ បាន រៀបចំឡើង រយៈពេល ចំនួន ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១២ ដល់ ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រៃវែង ដោយ មាន សិក្ខាកាម ជា កងកម្លាំង នគរបាល ជាតិ នៃ ផែន សន្តិសុខ តាម បណ្តា អធិការដ្ឋាន ស្រុក - ក្រុង ទាំង ១៣ និង តាម ប៉ុសិ៍ ទាំង ១១៦ ទូទាំង ខេត្ត ព្រៃវែង ចំនួន ១៥០ នាក់ ស្រី ៤នាក់ ។
ការបំពាក់ បំប៉ន នេះ ស្រប ទៅតាម ផែនការ របស់ នាយកដ្ឋាន កណ្តាល សន្តិសុខ បាន ដាក់ចេញ នៅ ឆ្នាំ ២០១៩ ក្នុង ការរៀបចំ វគ្គ បំប៉ន ជំនាញ សន្តិសុខ នេះ ឲ្យបាន ២៥ រាជធានី - ខេត្ត ទូទាំង ប្រទេស កម្ពុជា ៕
ក្នុង ការប្រកាស សាល ដីការ នៅ ព្រឹក មិញ នេះ គឺ អវត្តមាន ជន ត្រូវ ចោទ ហូរ ចំរើន និង មេធាវី ប៉ុន្តែ សាលាឧទ្ធរណ៍ ទុក សិទ្ធិ ប្តឹង តវ៉ា តាម កំណត់ ច្បាប់ ។ ការប្រកាស សាល ដីការ នេះ ផងដែរ មាន លោក ឃុន លាង ម៉េង ជា ប្រធាន ក្រុមប្រឹក្សា និង ក្រឡាបញ្ជី លោកស្រី ប៉េស រីណា ហើយ ធ្វើឡើង បន្ទាប់ពី សាលាដំបូង រាជធានី ភ្នំពេញ បាន ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ១៨ ខែ លើ សំណុំរឿង គំរាម បាញ់ សម្លាប់ ប្រពន្ធ នៅក្នុង ភូមិ គ្រឹះ របស់ លោក ហូរ ចំរើន ស្ថិត ក្នុង ខណ្ឌ ដង្កោ កាលពី ពេល កន្លងទៅ ។
បើ តាម អ្នកនាំពាក្យ រូប នេះ សំណុំរឿង ទាំង ពីរ នេះ ធ្លាប់ បាន ជម្រះ ក្នុង ពេល តែ មួយ ប្រធាន ក្រុមប្រឹក្សា ជំនុំជម្រះ តែ មួយ ប៉ុន្ដែ លើក ប្រកាស ទៅ ថ្ងៃទី ១៤ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ ។
សូម រំលឹក ថា អតីត ឧកញ៉ា ហូរ ចំរើន ត្រូវបាន តុលាការ សម្រេច ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ចំនួន ១៨ ខែ ក្នុង បទ ចោទ ប្រើប្រាស់ អាវុធ បាញ់ បោះ គំរាម សម្លាប់ ប្រពន្ធ ប្រព្រឹត្ត នៅក្នុង ភូមិគ្រឹះ ដ៏ ស្តុកស្តម្ភ របស់ ខ្លួន ក្បែរ គុក ព្រៃស ។ ប្រភព ព័ត៌មាន បាន បង្ហើប ឲ្យដឹង ថា បន្ទាប់ពី ត្រូវ ចាប់ខ្លួន បញ្ជូន ទៅ ពន្ធនាគារ ព្រៃស ព្រោះ រឿង បាញ់ បោះ នោះ អតីត ឧកញ៉ា រូប នេះ នៅ មាន បណ្តឹង ឆបោក ប្រាក់ ចំនួន ៣ករណី ទៀត ក្នុង ទំហំ ទឹកប្រាក់ លាន ដុល្លារ ក្នុង នោះ ក៏ មាន ការជាប់ពាក់ព័ន្ធ ជនជាតិ ចិន ផងដែរ ។
ទីបំផុត សភា អាមេរិក អនុម័ត លើ ដំណោះស្រាយ « ដក អាមេរិក ចេញ ពី សង្គ្រាម យ៉េមែន » ប៉ុន្តែ វា ត្រូវការឆ្លង ព្រឹទ្ធសភា មួយ ទៀត ...
( វ៉ាស៊ីនតោន ) ៖ សភា អាមេរិក បាន អនុម័ត ហើយ លើ ដំណោះស្រាយ មួយ ដែល អំពាវនាវ ឱ្យ ដក កងទ័ព អាមេរិក ចេញ ពី ប្រទេស យ៉េមែន ក៏ ដូចជា បញ្ឈប់ រាល់ ការគំាទ្រ ទាំងឡាយ ដល់ ប្រតិបត្តិការ យោធា ដឹកនាំ ដោយ អារ៉ាប៊ី សាអូឌីត ក្នុង ប្រទេស ស្ថិត នៅ តំបន់ មជ្ឈិមបូព៌ា មួយ នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន Sputnik នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី១៤ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ។
សភា អាមេរិក ក្រោម ការគ្រប់គ្រង របស់ គណបក្ស ប្រជាធិបតេយ្យ បាន បោះឆ្នោត អនុម័ត នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ ( ម៉ោង នៅ អាមេរិក ) លើ ដំណោះស្រាយ ខាងលើ ជាមួយ សំឡេង គាំទ្រ ២៤៨ ទល់ នឹង ១៧៧ សំឡេង ។ ប៉ុន្តែ ដំណោះស្រាយ នេះ គឺ ត្រូវការការអនុម័ត ពី ព្រឹទ្ធសភា អាមេរិក ជាមុន សិន ខណៈ គណបក្ស សាធារណរដ្ឋ របស់ លោក ដូណាល់ ត្រាំ គឺជា អ្នកកាន់កាប់ សំឡេង ភាគ ច្រើន នៅក្នុង ព្រឹទ្ធសភា ។
គួរ បញ្ជាក់ ថា បើសិនជា ដំណោះស្រាយ នេះ ត្រូវបាន អនុម័ត មែន នោះ វា នឹង តម្រូវ ឱ្យ រដ្ឋបាល ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ដក កងទ័ព អាមេរិក ទាំងអស់ ចេញ ពី យ៉េមែន ក្នុង រយៈពេល ៣០ ថ្ងៃ ។ មិន តែ ប៉ុណ្ណោះ វា ក៏ នឹង បិទ បញ្ចប់ ផងដែរ ការផ្ដល់ ជំនួយ ឬ ការគាំទ្រ ផ្នែក យោធា របស់ អាមេរិក ដល់ ក្រុម ចំរុះ អារ៉ាប់ ដឹកនាំ ដោយ អារ៉ាប៊ី សាអូឌីត ដែល កំពុង ធ្វើ ប្រតិបត្តិការ យោធា នៅ យ៉េមែន ដើម្បី ប្រឆាំង នឹង ក្រុម ឧទ្ទាម ហ៊ូទី គាំទ្រ ដោយ អ៊ីរ៉ង់ ។
កាលពី ដើម សប្តាហ៍ នេះ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ក៏ បាន បញ្ជាក់ ផងដែរ ថា លោក មិន គាំទ្រ នោះ ឡើយ ចំពោះ ការដក ខ្លួន របស់ អាមេរិក ចេញ ពី សង្គ្រាម នៅ ប្រទេស យ៉េមែន ព្រោះ សហរដ្ឋ អាមេរិក គ្រាន់តែ ផ្តល់ សេវា ចាក់ សាំង យន្តហោះ ចម្បាំង ឲ្យ អារ៉ាប៊ី សាអូឌីត និង ជំនួយ ផ្នែក ព័ត៌មាន សម្ងាត់ មួយចំនួន ទៀត ប៉ុណ្ណោះ មិន មែន ចូលរួម ប្រយុទ្ធ ជាមួយ អារ៉ាប៊ី សាអូឌីត នោះ ឡើយ ៕
សូម បញ្ជាក់ ថា នា ពេល ថ្មី ៗ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន សរសេរ កំណាព្យ ចំនួន ៤ឃ្លា បង្កប់ ដោយ អត្ថន័យ យ៉ាង ជ្រាលជ្រៅ និង បង្ក ការងឿងឆ្ងល់ យ៉ាង ខ្លាំង ដល់ មិត្ត អ្នកអាន ផងដែរ ។
កំណាព្យ ៤ឃ្លា របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ដែល ជា អ្នក ចូលចិត្ត តែង និពន្ធ មួយ រូប ដែរ នោះ បាន បង្ក ការងឿងឆ្ងល់ ជាខ្លាំង ចំពោះ អត្ថន័យ ដ៏ ជ្រាលជ្រៅ បង្កប់ នៅក្នុង កំណាព្យ នេះ ។
មាន ពាក្យ មួយ ឃ្លា គេ តែងតែ លើកឡើង ថា គ្រប់ សកម្មភាព គ្រប់ ទង្វើ របស់ អ្នកនយោបាយ គ្មាន សកម្មភាព ណាមួយ ឬ ទង្វើ ណាមួយ ដែល មិន ភ្ជាប់ ជាមួយ បញ្ហា នយោបាយ នោះ ឡើយ ។ សម្រាប់ កំណាព្យ ខាងលើ របស់ សម្តេច តេជោ ហ៊ុន សែន ក៏ ត្រូវបាន គេ សន្និដ្ឋាន មាន អត្ថន័យ ផ្សារភ្ជាប់ ទៅ បញ្ហា នយោបាយ ផងដែរ ។
អ្នកតាមដាន បញ្ហា នយោបាយ បាន សន្និដ្ឋាន កំណាព្យ នេះ គឺ សម្តេច តេជោ ហ៊ុន សែន មាន ចេតនា យ៉ាង ពិតប្រាកដ ផ្ញើ ទណ្ឌិត រត់ ចោល ស្រុក សម រង្ស៉ី គ្រា ដែល ការភ្នាល់ រវាង សម្តេច និង ទណ្ឌិត រូប នេះ ជិត ដល់ ឱសានវាទ នា ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០១៩ នេះ ។
អ្នកតាមដាន បញ្ហា នយោបាយ បាន សាកល្បង បកស្រាយ ឃ្លា កំណាព្យ ខាងលើ នេះ យ៉ាង ដូច្នេះ ។
ឃ្លាទី១ « ទទា យំ ឆ្លង ត្រយ៉ង បង អើយ អត់ ឆ្លើយ » ។ សម្តេច តេជោ ចង់ បញ្ជាក់ ថា ទោះបី ទណ្ឌិត សម រង្ស៉ី ប្រឹងប្រែង ធ្វើ សកម្មភាព គ្រប់ បែបយ៉ាង ឲ្យ សម្តេច តបត និង ឆ្លើយតប តែ សម្តេច នៅតែ រក្សា ភាព ស្ងាត់ ស្ងៀម គ្មាន ការតបត អ្វី ទាំងអស់ ។
ឃ្លា ទី៣ « ចិត្ត អូន ចិត្ត ដាច់ ដោយសារ ចិត្ត បង ចិត្ត ខ្មៅ » ។ ឃ្លា នេះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា សម្តេច គ្មាន ការស្នើសុំ ការលើកលែង ទោស ដល់ ទណ្ឌិត សម រង្ស៉ី ទៀត នោះ ទេ ដោយ សម្តេច ចាត់ទុក ទណ្ឌិត រូប នេះ ជា មនុស្ស ចិត្ត ខ្មៅ ។ ចិត្ត ខ្មៅ ក៏ ព្រោះតែ សម្តេច ធ្លាប់ បាន សូម ព្រះរាជ ទាន លើកលែង ទោស ពីរ ដង រួច មកហើយ តែ ទណ្ឌិត នេះ មិន ត្រឹមតែ មិន ដឹង គុណ នោះ ទេ ថែមទាំង ប្រមាថ មើលងាយ យ៉ាង ធ្ងន់ធ្ងរ ថែម ទៀត ដល់ រូប សម្តេច និង ក្រុមគ្រួសារ ។
ឃ្លាទី៤ « ស្ពាន ក៏ បាក់ ទឹក ក៏ ជ្រៅ ធ្វើ ម្តេច បាន ទៅ តាម កិច្ចសន្យា » ។ ឃ្លា នេះ សម្តេច តេជោ ចង់ គូសបង្ហាញ ថា មាន ឧបសគ្គ ជាច្រើន នៅ ចំពោះមុខ ទណ្ឌិត សម រង្ស៉ី ធ្វើម្តេច នឹង អនុញ្ញាតឲ្យ ទណ្ឌិត រូប នេះ អាច វិលត្រឡប់ ចូល ស្រុក ដូច អ្វី ដែល ខ្លួន បាន សន្យា ជាមួយ អ្នកគាំទ្រ នោះ ។
លោក រដ្ឋមន្ត្រី ក៏ បាន សូមឲ្យ ប្រជាជន កម្ពុជា ចេះ សាមគ្គី គ្នា អត់ឱន ឲ្យ គ្នា យោគយល់ គ្នា និង បាន សុខ ត្រជាក់ ត្រជំក្រោម ឆត្រ រដ្ឋធម្មនុញ្ញ តែ មួយ ៕
ក្រសួង អប់រំ ដាក់ ចេញ វិធានការ ទប់ស្កាត់ សកម្មភាព មិន ប្រក្រតី ក្នុង ថ្ងៃ « ទិវា នៃ ក្តីស្រឡាញ់ » នៅ តាម គ្រឹះស្ថាន សិក្សា
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ចាត់ ឲ្យ តាម គ្រឹះស្ថាន សិក្សា ទាំង រដ្ឋ និង ឯកជន ឲ្យ ធ្វើ សកម្មភាព មួយចំនួន ដើម្បី ទប់ស្កាត់ សកម្មភាព មិន ប្រក្រតី ក្នុង ថ្ងៃ « ទិវា នៃ ក្តីស្រឡាញ់ » ១៤ កុម្ភៈ នេះ ។
ដើម្បី ទប់ស្កាត់ សកម្មភាព មិន ប្រក្រតី ក្នុង ថ្ងៃ ទិវា នៃ ក្តីស្រឡាញ់ នេះ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ឲ្យ គ្រឹះស្ថាន អប់រំ ធ្វើ សកម្មភាព មួយចំនួន មាន ដូច ជា៖
១៖ ផ្សព្វផ្សាយ ដល់ សិស្សានុសិស្ស តាម គ្រប់ មធ្យោបាយ ដូចជា តាមរយៈ ការប្រជុំ នៅពេល គោរព ទង់ជាតិ កុំ ឱ្យ មាន ការយល់ ខុស អំពី អត្ថន័យ នៃ ទិវា បុណ្យ នៃ ក្តីស្រឡាញ់ ។
២៖ ពង្រឹង ការអនុវត្ត បទបញ្ជា ផ្ទៃក្នុង របស់ គ្រឹះស្ថាន សិក្សា សាធារណៈ ឱ្យ បាន ម៉ឺងម៉ាត់ ជាពិសេស លើ ការគ្រប់គ្រង សីលធម៌ និង វិន័យ ដោយ តាមដាន អវត្តមាន របស់ សិស្សានុសិស្ស ជាប្រចាំ ។
៣៖ ជំរុញ ដំណើរការ របស់ ក្រុមប្រឹក្សា យុវជន ក្រុមប្រឹក្សា កុមារ ប្រចាំ សាលា ដោយ អនុវត្ត សកម្មភាព « មិត្ត អប់រំ មិត្ត » ។
៤៖ ធ្វើ ទំនាក់ទំនង ជិតស្និទ្ធ ជាមួយ មាតាបិតា អ្នកអាណាព្យាបាល សិស្ស សហគមន៍ ដើម្បី ផ្តល់ និង ទទួល ព័ត៌មាន នានា ពាក់ព័ន្ធ នឹង សកម្មភាព មិន ប្រក្រតី ដែល ប្រព្រឹត្ត ដោយ សិស្សានុសិស្ស ដើម្បី សហការ គ្នា អប់រំ ណែនាំ កែលម្ផ សិស្សានុសិស្ស បាន ទាន់ ពេលវេលា ៕
ទន្ទឹមនឹង ការណែនាំ ចាត់ វិធានការទប់ សកម្មភាព មិន ប្រក្រតី នេះ ទៅ ក្រសួង ក៏ បាន បញ្ជាក់ ដែរ ថា ទិវា នេះ ពុំ មែន ជា ពិធី បុណ្យ ប្រពៃណ៌ របស់ ជនជាតិ ខ្មែរ ទេ ហើយ នៅ អំឡុង ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ទិវា នៃ ក្តីស្រឡាញ់ កាន់តែ មាន ឥទ្ធិពល ធំ ឡើង ៗ ធ្វើឱ្យ យុវវ័យ ភ្លេច ការសិក្សា បាត់បង់ សេចក្តីថ្លៃថ្នូរ របស់ ខ្លួន និង ក្រុមគ្រួសារ ប្រាសចាក វប្បធម៌ និង ប្រពៃណ៌ ជាតិ ដ៏ ផូរផង់ របស់ ខ្មែរ ទៀតផង ។
