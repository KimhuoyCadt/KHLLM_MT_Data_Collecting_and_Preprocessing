( កំពង់ចាម ) ៖ លោក មួន វាសនា ទីប្រឹក្សា សម្ដេច ពញា ចក្រី ហេង សំរិន និង ជា ប្រធាន គណៈ គ្រប់គ្រង នៃ សកលវិទ្យាល័យ គ្រប់គ្រង និង សេដ្ឋកិច្ច UME បាន ថ្លែង ប្រាប់ និស្សិត ឲ្យ ចេះ រៀបចំ ផែនការ ក្នុង ការសិក្សា ដើម្បី ទទួលបាន ជោគជ័យ នា ថ្ងៃ អនាគត ។
លោក មួន វាសនា បាន លើកឡើង ដូច្នេះ ក្នុង ឱកាស ដឹកនាំ ក្រុម សាស្រ្តាចារ្យ នៃ ប្រទេស អូស្ត្រាលី មក ផ្ដល់ បទពិសោធន៍ ល្អ ៗ ដល់ ក្រុម និស្សិត ប្រមាណ ជាង ២០០ នាក់ នៅ ល្ងាច ថ្ងៃទី ០៩ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នៅ សាកលវិទ្យាល័យ គ្រប់គ្រង និង សេដ្ឋកិច្ច UME សាខា ខេត្ត កំពង់ចាម ។
លោក មួន វាសនា បាន ថ្លែង ថា ឆ្លង តាម ការសង្កេត របស់ លោក ឃើញ ថា ប្រជាពលរដ្ឋ ជាច្រើន ដែល ពួកគាត់ ប្រកប មុខរបរ ដោយ គ្មាន ផែនការជាក់លាក់ ពុំ សូវ ឃើញ ពួកគាត់ ទទួលបាន ជោគជ័យ នោះ ទេ ។ ដោយឡែក មាន ប្រជាពលរដ្ឋ មួយចំនួន ដែល ពួកគាត់ ប្រកប មុខរបរ កសិកម្ម ឬ ប្រកប មុខរបរ អាជីវកម្ម ផ្សេង ៗ ដោយ មាន ផែនការជាក់លាក់ ឃើញ ថា ពួក គាត់ តែងតែ ទទួលបាន ជោគជ័យ ជីវភាព គ្រួសារ របស់ ពួកគាត់ ធូរធា ។
ប្រធាន គណៈ គ្រប់គ្រង សាកលវិទ្យាល័យ គ្រប់គ្រង និង សេដ្ឋកិច្ច បាន បន្ថែម ថា ក្រុម និស្សិត គួរតែ មាន ការខិតខំ សិក្សា ស្រាវជ្រាវ ឲ្យបាន ច្រើន ដើម្បី បន្ថែម ចំណេះដឹង របស់ ខ្លួន ដែល ការសិក្សា ស្រាវជ្រាវ នោះ មាន រូបមន្ត ៥ដំណាក់កាល ដែល គួរ ធ្វើ ។
សូម កុំ បើកបរ ស្ថិត ក្រោម ស្ថានភាព គ្រឿងញៀន ! ស្លាប់ ៧នាក់ និង របួស ២៣នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៩ ខែកុម្ភៈ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៩ ខែកុម្ភៈ ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ . របួស ស្រាល ៧នាក់ និង របួស ធ្ងន់ ១៦ នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១៤លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ១៨ គ្រឿង . រថយន្ត តូច ៩គ្រឿង . យាន ផ្សេង ៗ ១ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន ល្មើស ល្បឿន . មិន គោរព សិទ្ធិ . មិន ប្រកាន់ ស្ដាំ . បត់ គ្រោះថ្នាក់ និង ប្រជែង ។
( ភ្នំពេញ ) ៖ ឱសថការី អាំង ហុក ស្រ៊ុន ប្រធាន ការិយាល័យ សុវត្ថិភាព ចំណីអាហារ នាយកដ្ឋាន ឱស ថ ចំណីអាហារ បរិក្ខារ ពេទ្យ និង គ្រឿង សំអាង នៃ ក្រសួង សុខាភិបាល បាន ថ្លែង ថា ឆ្នាំ ២០១៨ ករណី ពុល ចំណីអាហារ នៅ កម្ពុជា មាន ចំនួន ១៣ ដង អ្នកជំងឺ ២០៣ នាក់ មក សម្រាក ពេទ្យ ១៩៦ នាក់ និង ស្លាប់ ចំនួន ១២នាក់ ។
ក្នុង ឱកាស នោះ ឱសថការី បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ អនុវត្ត តាម គន្លឹះ ៥យ៉ាង ដើម្បី សុវត្ថិភាព ចំណីអាហារ រួម មាន៖ ១៖ រក្សា ភាពស្អាត ( លាង ដៃ នឹង សាប៊ូ មុនពេល រៀបចំ ធ្វើ ម្ហូប និង ក្រោយពេល បន្ទោបង់ . ចង្រ្កាន កន្លែង លាង ចាន ចាន ក្បាន ស្អាត និង ស្ងួត . ការពារ ផ្ទះបាយ និង អាហារ ពី សត្វ ដូចជា កណ្តុរ កន្លាត រុយ និង សត្វ ល្អិត ផ្សេង ៗ )
២៖ ទុកដាក់ ចំណីអាហារ ឆៅ និង ឆ្អិន ដាច់ដោយឡែក ពី គ្នា
៣៖ ចំអិន អាហារ ឲ្យបាន ឆ្អិន ល្អ
៤៖ ទុកដាក់ អាហារ នៅ សីតុណ្ហភាព មាន សុវត្ថិភាព ( ចូរ ទុក អាហារ ឆ្អិន ស្រាប់ នៅ សីតុណ្ហភាព ធម្មតា ក្នុង បន្ទប់ មិន លើស ពី ពីរ ម៉ោង . ដាក់ ចំណីអាហារ ដែល ងាយ ស្អុយ ឬ ខូច និង អាហារ ដែល ចម្អិន រួច ទៅក្នុង ទូរទឹកកក ឬ ធុង ទឹកកក ភ្លាម ក្នុង កំរិត សីតុណ្ហភាព តិច ជាង ប្រាំ អង្សារ សេ . ទុក អាហារ ឆ្អិន ឲ្យ នៅ ក្តៅ ជានិច្ច ក្នុង កំរិត សីតុណ្ហភាព លើស ពី ៦០ អង្សារ សេ . ចូរ កុំ ទុក អាហារ យូរ ពេក ទោះបី ដាក់ ក្នុង ទូរទឹកកក ក៏ដោយ )
ទន្ទឹម នឹង នោះ លោក បាន អំពាវនាវ ដល់ ភ្ញៀវ ជាតិ និង អន្តរជាតិ ត្រូវ ពិនិត្យមើល ស្លាកសញ្ញា A . B. C ឬ វិញ្ញាបនបត្រ អនាម័យ ពី ក្រសួង សុខាភិបាល ដែល បាន ប្រគល់ ជូន ដល់ ភោជនីយដ្ឋាន ដែល បាន ទទួល ការបណ្ដុះបណ្ដាល និង អនុវត្ដន៍ ទៅ តាម ការកំណត់ របស់ ពី ក្រសួង ដើម្បី ផ្ដល់ នូវ សុខ សុវត្ថិភាព ផ្នែក ចំណីអាហារ ជូន ប្រជាពលរដ្ឋ កម្ពុជា និង ដល់ ភ្ញៀវ អន្ដរជាតិ ៕
( ភ្នំពេញ ) ៖ ក្រសួង ការបរទេស និង សហប្រតិបត្ដិការ អន្ដរជាតិ នៅ ថ្ងៃទី ០៩ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នេះ បាន ចេញ សេចក្ដីថ្លែងការណ៍ ថ្កោលទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ទង្វើ របស់ ទណ្ឌិត សម រង្ស៊ី ដែល បាន អំពាវនាវ មិន ឲ្យ កងទ័ព ស្តាប់ បញ្ជា និង ឲ្យ មាន ការបះបោរ និង សេចក្តីថ្លែងការណ៍ ដ៏ ពិស ពុល របស់ ជន រូប នេះ ។
សេចក្ដីថ្លែងការណ៍ របស់ ក្រសួង ការបរទេស បាន ធ្វើឡើង បន្ទាប់ពី ប៉ុន្មាន សប្តាហ៍ ថ្មី ៗ នេះ បុគ្គល សម រង្ស៊ី ដែល ជា ទណ្ឌិត ជនជាតិ ខ្មែរ មាន សញ្ជាតិ បរទេស បាន ធ្វើ ការអំពាវនាវ ឥត ឈប់ឈរ ដល់ សហគមន៍ អន្តរជាតិ ឲ្យ ចោទ សួរ ពី ធម្មានុ រូបភាព របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង អំពាវនាវ ឲ្យ កងយោធពល ខេមរភូមិន្ទ និង ប្រជាជន ងើប បះបោរ ប្រឆាំង រាជ រដ្ឋាភិបាល ដែល បាន ជាប់ ឆ្នោត តាម លទ្ធិ ប្រជាធិបតេយ្យ ជាមួយនឹង សម្លេង ឆ្នោត យ៉ាង ច្រើន លើសលុប របស់ ម្ចាស់ ឆ្នោត ។
ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ទង្វើ របស់ ទណ្ឌិត សម រង្ស៊ី ដែល បាន អំពាវនាវ មិន ឲ្យ កងទ័ព ស្តាប់ បញ្ជា និង ឲ្យ មាន ការបះបោរ និង សេចក្តីថ្លែងការណ៍ ដ៏ ពិស ពុល របស់ ជន រូប នេះ ។
ក្នុង ការអះអាង ដែល គ្មាន មូលដ្ឋាន ថា ការបោះឆ្នោត ជា សកល កាលពី ខែកក្កដា ឆ្នាំ ២០១៨ មិន មាន ធម្មានុ រូបភាព បុគ្គល រូប នេះ បាន ប្រើប្រាស់ វោហាសាស្រ្ត នយោបាយ ដដែល ៗ ចំពោះ រាល់ ការបោះឆ្នោត ថ្នាក់ ជាតិ ចាប់តាំងពី ឆ្នាំ ១៩៩៨ មក ដែល បុគ្គល នេះ និង គណបក្ស ដែល គាត់ ដឹកនាំ បាន ទទួលបរាជ័យ រហូតមក ។
បើ តាម ក្រសួង ការបរទេស សេចក្តីថ្លែងការណ៍ របស់ បុគ្គល រូប នេះ មិន ត្រឹមតែ មើល ស្រាល យ៉ាង ធ្ងន់ធ្ងរ ដល់ គណបក្ស នយោបាយ ចំនួន ១៩ ទៀត ដែល បាន ចូលរួម បោះឆ្នោត ប៉ុណ្ណោះ ទេ តែ ថែមទាំង មើល ស្រាល ដល់ ឆន្ទៈ ម្ចាស់ ឆ្នោត ប្រមាណ ៨៣. ០២% ដែល បាន បោះឆ្នោត គាំទ្រ ដល់ គណបក្ស ប្រជាជន កម្ពុជា ដែល កំពុង កាន់អំណាច ដោយ សំលេង ភាគ ច្រើន លើសលុប ។
កំណើន សេដ្ឋកិច្ច ដ៏ ខ្លាំងក្លា ក្នុង អត្រា ៧. ៧% ក្នុង រយៈកាល ជាង ពីរ ទស្សវត្សរ៍ រួម ជាមួយនឹង ស្ថិរភាព នយោបាយ ការបែងចែក ផ្លែ ផ្កា នៃ វិបុលភាព ប្រកបដោយ សមធម៌ គឺជា មូលដ្ឋាន ពន្យល់ យ៉ាង ច្បាស់ នូវ ជម្រើស ដ៏ ឧត្តុង្គឧត្តម របស់ ប្រជាជន កម្ពុជា ដែល ប្រាថ្នា ចង់បាន មាគ៌ា ជា បន្ត ប្រកបដោយ សន្តិភាព និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម ។
ការអំពាវនាវ ទាំងនេះ គឺ គ្រាន់តែ ជា ការអុច អាល និង ញុះញង់ ដើម្បី តែ មហិច្ឆតា ចង់បាន អំណាច របស់ ទណ្ឌិត រូប នេះ តែ ប៉ុណ្ណោះ ។ រាជ រដ្ឋាភិបាល នឹង ប្រឆាំង ទប់ស្កាត់ តាម គ្រប់ មធ្យោបាយ ចំពោះ រាល់ ការប៉ុនប៉ង នានា និង ការធ្វើអន្តរាគមន៍ ពី ភាគី ទី៣ ក្នុង ការបង្ក អស្ថិរភាព និង បំផ្លិចបំផ្លាញ មាតុភូមិ ក៏ ដូចជា សុភមង្គល របស់ ប្រជាជន យើង ។ យើង នឹង ការពារ ប្រជាជាតិ យើង ប្រឆាំង ទល់ នឹង កល ល្បិច ទាំង នេះ ទោះ ក្នុង តម្លៃ ណា ក៏ដោយ ។
រាជ រដ្ឋាភិបាល ត្រូវបាន ជាប់ ឆ្នោត ដោយ ត្រឹមត្រូវ បង្កើតឡើង ដោយ ស្រប ច្បាប់ និង ត្រូវបាន ទទួលស្គាល់ ជា ផ្លូវការ ដោយ បណ្តា ប្រទេស ជាច្រើន រួមទាំង ប្រទេស នានា នៅក្នុង សហភាព អឺរ៉ុប និង ប្រទេស កាន់ លទ្ធិ ប្រជាធិបតេយ្យ សំខាន់ ៗ ផ្សេង ៗ ទៀត ។
( ភ្នំពេញ ) ៖ នា យប់ ថ្ងៃទី ០៩ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ ឲ្យ លុប ឈ្មោះ ឧត្តមសេនីយ៍ ត្រី គឹម រស្មី មេបញ្ជាការ អាវុធហត្ថ ខេត្ត រតនគិរី ចេញ ពី ក្របខ័ណ្ឌ នៃ កងយោធពល ខេមរភូមិន្ទ ។
ការលុប ឈ្មោះ ឧត្តមសេនីយ៍ ត្រី គឹម រស្មី មេបញ្ជាការ អាវុធហត្ថ ខេត្ត រតនគិរី ចេញ ពី ក្របខ័ណ្ឌ ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន លើកឡើង ថា នេះ គឺជា ការវះកាត់ ប្រកបដោយ ការឈឺចាប់ ហើយ នេះ ជា អភិក្រម ទី៥ « គឺជា ការវះកាត់ » ដែល សម្តេច តេជោ បាន ដាក់ចេញ សម្រាប់ ការកំណែទម្រង់ ស៊ីជម្រៅ នៅក្នុង សកម្មភាព របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី នេះ ។
សូម ជំរាប ថា កាលពី យប់ ថ្ងៃទី ០៥ ខែកុម្ភៈ ឆ្នាំ ២០១៩ លោក គឹម រស្មី មេបញ្ជាការ អាវុធហត្ថ ខេត្ត រតនគិរី នៅក្នុង ពិធី ខួបកំណើត បាន ប្រកាស នៅលើ វេទិកា ចែក ប្រាក់ ដល់ កូន ៗ ចំនួន ៥នាក់ ដោយ ម្នាក់ ៗ ទទួលបាន ១០ម៉ឺន ដុល្លារ សរុប ៥០ ម៉ឺន ដុល្លារ ។
ការចែក លុយ ដល់ កូន ៗ រហូតដល់ កន្លះ លាន ដុល្លារ នេះ បាន បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល ដល់ មហាជន ដោយ ងឿងឆ្ងល់ ថា ឋានៈ ត្រឹម ជា មេបញ្ជាការ អាវុធហត្ថ ខេត្ត មួយ មាន ទ្រព្យសម្បត្តិ ចែក កូន ៗ រហូតដល់ ៥០ ម៉ឺន ដុល្លារ ។ មិន ត្រឹមតែ ប៉ុណ្ណោះ លោក បាន អះអាង ជាសាធារណៈ ថា លោក ក៏ បាន បញ្ជូន កូន ទៅ រៀន ដល់ ប្រទេស សឹង្ហបុរី ផងដែរ ៕
យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៩ ខែកុម្ភៈ នេះ លទ្ធផល៖ បង្ក្រាប ២៣ករណី ឃាត់ខ្លួន ៤១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៩ ខែកុម្ភៈ ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
* លទ្ធផល បង្ក្រាប រួម មាន៖ ២៣ ករណី ឃាត់ខ្លួន ៤១ នាក់
លោក ទូច សំណាង ឲ្យដឹង ថា បច្ចុប្បន្ន ក្រុមហ៊ុន កំពុង រៀបចំ និតិវិធី ច្បាប់ ដើម្បី ស្នើសុំ ពី រដ្ឋាភិបាល លើ គំរោង អភិវឌ្ឍន៍ នេះ ។ ប៉ុន្ដែ សម្រាប់ ទុន វិនិយោគ លើ គម្រោង និង ការសាងសង លោក ពុំ ទាន់ បញ្ជាក់ ឲ្យដឹង នៅឡើយ ទេ ។
លោក បញ្ជាក់ ថា « គម្រោង នេះ ពិតជា មាន ពិត មែន ដែល ទំហំ ផ្ទៃដី នៃ ទីក្រុង ថ្មី នេះ មាន ជាង ១០០ ហិកតា ។ គម្រោង នេះ នឹង ត្រូវ រៀបចំ អភិវឌ្ឍន៍ ដូច ទីក្រុង កោះ ពេជ្រ នា ពេល បច្ចុប្បន្ន នេះ ដោយ មាន ការសាងសង់ ស្ពាន ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរកំសាន្ដ នៅ ទីនោះ ផងដែរ » ។
