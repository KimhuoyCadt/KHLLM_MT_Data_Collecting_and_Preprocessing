បង្ក្រាប ការជួញដូរ និង ប្រើប្រាស់ ថ្នាំ ញៀន នៅ ខណ្ឌ ឫស្សីកែវ ឃាត់ខ្លួន ៣នាក់ ដកហូត ថ្នាំ ញៀន ជាង ៣០ កញ្ចប់
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល ប៉ុស្ដិ៍ ស្វាយប៉ាក នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ឫស្សីកែវ ឃាត់ខ្លួន ជាក់ស្ដែង លើ ជនសង្ស័យ ចំនួន ៣នាក់ រកឃើញ ថ្នាំ ញៀន ជា កញ្ចប់ តូច ៗ ចំនួន ៣៤ កញ្ចប់ ក្នុង បទល្មើស ប្រើប្រាស់ និង ជួញដូរ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ។
បើ តាម ការបញ្ជាក់ ឲ្យបាន ដឹង ពី លោក វរសេនីយ៍ ទោ គល់ យី អធិការ នគរបាល ខណ្ឌ ការឃាត់ខ្លួន ជាក់ស្ដែង នេះ គឺ បាន អនុវត្ត ឡើង ស្ថិត នៅ ត្រង់ ចំណុច ក្រុម ទី៩ ភូមិ លូ សង្កាត់ ស្វាយប៉ាក ខណ្ឌ ឫស្សីកែវ នា វេលា ម៉ោង ០៩៖០០ នាទី យប់ នៅ ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០១៩ ។
អធិការ ខណ្ឌ រូប នេះ បាន ឲ្យ ដែរ ថា ក្រោយពី បង្ក្រាប ពួកគេ ទាំង ៣នាក់ និង វត្ថុតាង ថ្នាំ ញៀន បាន និង កំពុង ស្ថិត ក្រោម ការឃុំ ខ្លួន សាកសួរ បណ្ដោះអាសន្ន នៅ អធិការដ្ឋាន ខណ្ឌ ដើម្បី កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការ តាម និតិវិធី ៕ ថ្ងៃ នេះ ថ្ងៃទី ៧នៃ ដំណើរការធ្វើ ជំរឿន ទូទៅ ប្រជាជន កម្ពុជា សូម បងប្អូន ជន រួម ជាតិ ចូលរួម គាំទ្រ និង ផ្តល់ ការសហការ ឲ្យបាន គ្រប់ ៗ គ្នា ! (Video inside)
ដើម្បីឲ្យ ការធ្វើ ជំរឿន ទទួលបាន លទ្ធផល ប្រកបដោយ ជោគជ័យ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្ដេច តេជោ ហ៊ុន សែន បាន ចេញ សារ អំពាវនាវ ដល់ ជន រួម ជាតិ គាំទ្រ និង ចូលរួម ការធ្វើ ជំរឿន ទូទៅ ប្រជាជន កម្ពុជា ដែល នឹង ចាប់ផ្ដើម នៅ ថ្ងៃទី ០៣ រហូតដល់ ថ្ងៃទី ១៣ ខែមីនា ឆ្នាំ ២០១៩ ដោយ ត្រូវ ចូលរួម ផ្ដល់ ព័ត៌មាន តាម សំណួរ សម្ភាសន៍ ឲ្យបាន គ្រប់គ្រាន់ ត្រឹមត្រូវ និង ស្មោះត្រង់ ជូន មន្ដ្រី ធ្វើ ជំរឿន ប្រជាជន ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ទៀ សីហា បាន បញ្ជាក់ ថា នេះ ជា ឆ្នាំ លើក ទី៧ ហើយ ដែល លោក ផ្ទាល់ និង ក្រុមការងារ បាន ចុះ មក ជួប សំណេះសំណាល សួរសុខទុក្ខ រៀបចំ អាហារ និង ចែក អំណោយ ជូន ដល់ កុមារ គរ ថ្លង់ និង កុមារ ពិការ ភ្នែក ព្រមទាំង លោកគ្រូ អ្នកគ្រូ បុគ្គលិក នៅ សាលា នេះ ។
លោក បន្ថែម ថា សម្រាប់ ការរីកចម្រើន និង ការឧបត្ថម្ភ គាំទ្រ ដូចជា ការកសាង អគារ និង ការឧត្ថម្ភ ផ្សេង ៗ មួយចំនួន គឺ មាន ការការជួយជ្រោមជ្រែង ពី សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ និង ភរិយា ផងដែរ ។
របាយការណ៍ របស់ លោកស្រី នាយិការ បាន ឲ្យដឹង ថា សាលា កុមារ គរ ថ្លង់ និង ពិការ ភ្នែក ខេត្ត សៀមរាប បាន ប្រែក្លាយទៅជា វិទ្យាល័យ អប់រំ ពិសេស សៀមរាប កាលពី ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០១៧ ។ បច្ចុប្បន្ន មាន អគារ សរុប ចំនួន ១៣ខ្នង ដែល មាន សាល ពិពរណ៌ ផ្ទះ សម្រាប់ សិស្ស ថ្នាក់ នៅ បណ្ដាល័យ និង ម៉ាស្សា
( ព្រះសីហនុ)៖ គណៈប្រតិភូ ក្រុមហ៊ុន វិនិយោគ របស់ ចិន ដឹកនាំ ដោយ លោក ស៊ុន ជៀន ជុន ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ លោក យន្ដ មីន អភិបាល ខេត្ត ព្រះសីហនុ ដើម្បី សិក្សា អំពី គោល នយោបាយ វិនិយោគ របស់ ប្រទេស កម្ពុជា និង សក្តានុពល ការវិនិយោគ ជាពិសេស សុំ ការគាំទ្រ ការលើកទឹកចិត្ត សម្រាប់ គោលបំណង បណ្តាក់ទុន នៅលើ វិស័យ មួយចំនួន រួម មាន ឧស្សាហកម្ម ថាមពល ទេសចរណ៍ និង សេវាកម្ម ផងដែរ ។
ក្នុង ជំនួប នៅ រសៀល ថ្ងៃទី ០៨ ខែមីនា ឆ្នាំ ២០១៩ នេះ លោក ស៊ុន ជៀន ជុន បាន បង្ហាញ ថា ក្រុម គណៈប្រតិភូ ក្រុមហ៊ុន ទាំងអស់ នេះ សុទ្ធតែ ជា ក្រុមហ៊ុន ដែល មាន បទពិសោធន៍ នៅ ប្រទេស ចិន រួម មាន កែច្នៃ សំណល់ សំរាម ឲ្យ ក្លាយទៅជា ថាមពល អគ្គិសនី . ក្រុមហ៊ុន ផលិត សម្ភារ បរិក្ខា អគ្គិសនី ប្រើ ថាមពល ព្រះអាទិត្យ . ក្រុមហ៊ុន ផលិត ខ្សែកាប្លិ៍ . ក្រុមហ៊ុន អចលន ទ្រព្យ និង ក្រុមហ៊ុន ផលិត ទូក ទេសចរណ៍ ។
លោក ប្រធាន ប្រតិភូ បាន យល់ឃើញ ថា ខេត្ត ព្រះសីហនុ ពិតជា មាន សក្ដានុពល ល្អ ហើយ ពួកគេ បាន ប្រមើលឃើញ ថា នៅ ថ្ងៃ ខាងមុខ មិន យូរ ទេ ខេត្ត ព្រះសីហនុ នឹង ក្លាយទៅជា ក្រុង ដ៏ ទំនើប មួយ ។ បន្ទាប់ពី ជំនួប ជាមួយ អភិបាល ខេត្ត ព្រះសីហនុ ក្រុម គណៈប្រតិភូ គ្រោង ធ្វើ ទស្សនកិច្ច នៅ តាម តំបន់ សេដ្ឋកិច្ច ពិសេស តាម តំបន់ ឆ្នេរសមុទ្រ និង ទីកន្លែង ដែល កំពុង មាន ការសាងសង់ សំណង់ ធំ ៗ ដើម្បី ស្វែងយល់ ឲ្យ កាន់តែ ច្បាស់ អំពី សក្ដានុពល និង វិស័យ ដែល កំពុងតែ ពេញនិយម ។
លោក យន្ដ មីន បាន បញ្ជាក់ ថា ការរីកចម្រើន ដ៏ គួរ ជា ទី មោទនៈ នេះ ជា លទ្ធផល មួយ ដែល មិន អាច ប្រកែក បាន ក្រោម គោល នយោបាយ និង ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដែល បាន ធ្វើឲ្យ ប្រទេសជាតិ មាន សន្តិភាព ស្ថិរភាព សន្តិសុខ ល្អ និង មាន ឱកាស អភិវឌ្ឍន៍ ប្រទេស ។
តាមរយៈ ជំនួប នេះ ប្រតិភូសហគ្រាស ទាំងនេះ ស្នើសុំ ខេត្ត ព្រះសីហនុ ក៏ ដូចជា រាជ រដ្ឋាភិបាល កម្ពុជា ផ្ដល់ ការគាំទ្រ ចំពោះ ក្រុមហ៊ុន របស់ ពួកគេ ដែល កំពុងតែ មក ស្វែងយល់ អំពី សក្តានុពល នៅ ខេត្ត ព្រះសីហនុ សម្រាប់ ទំនាក់ទំនង ពាណិជ្ជកម្ម នៅ ខេត្ត ជាប់ មាត់ សមុទ្រ មួយ នេះ នៅ ថ្ងៃ ខាងមុខ ៕ ដំណឹង ល្អ ! អស់ បញ្ហា ក្នុង ការសុំ CO ទម្រង់ D សម្រាប់ កសិករ ក្នុង ខេត្ត ចំនួន ៤ នៃ តំបន់ ត្រីកោណ អភិវឌ្ឍន៍
( ក្រចេះ ) ៖ ដើម្បី សម្រួល ដល់ ការនាំចេញ កសិផល ទៅកាន់ ទីផ្សារ អន្តរជាតិ សម្រាប់ ខេត្ត ស្ថិត នៅ តាម ព្រំដែន ក្នុង តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ កម្ពុជា - ឡាវ - វៀតណាម ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ០៩ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន ធ្វើ ប្រតិភូកម្ម សេវា ចេញ វិញ្ញាបនបត្រ បញ្ជាក់ ប្រភព ដើម ទំនិញ (CO) ទម្រង់ ឌី (D) តាម ប្រពន្ធ័ ស្វ័យប្រវត្តិកម្ម ជូន ដល់ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ត្បូងឃ្មុំ ក្រចេះ ស្ទឹងត្រែង និង ខេត្ត មណ្ឌលគិរី ។
ពិធី ប្រកាស និង ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ សេវា CO ទម្រង់ D នេះ ត្រូវបាន រៀបចំឡើង នៅ សណ្ឋាគារ លីជិ ខេត្ត ក្រចេះ ក្រោម អធិបតីភាព លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម និង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ និង អាជ្ញាធរ នៃ ខេត្ត ទាំង បួន ខាងលើ មន្ត្រីរាជការ មកពី ស្ថាប័ន ពាក់ព័ន្ធ និង តំណាង វិស័យ ឯកជន ប្រមាណ ៣០០ នាក់ ។
នៅក្នុង ឱកាស នោះ លោក ប៉ាន សូរស័ក្តិ បាន រំលឹក ពី កិច្ចប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការអនុវត្ត ក្របខណ្ឌ យុទ្ធសាស្ត្រ កំណែទម្រង់ វិមជ្ឈការ និង វិសហមជ្ឈការ ដើម្បី លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ រវាង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ សំដៅ ធានា ឱ្យ មាន ការអភិវឌ្ឍ សង្គម សេដ្ឋកិច្ច ដ៏ ទូលំទូលាយ និង ប្រកបដោយ និរន្តរភាព អាច ឆ្លើយតប តម្រូវការ អទិភាព របស់ ប្រជាពលរដ្ឋ និង គោលការណ៍ អភិបាលកិច្ច ល្អ ដែល ជា ស្នូល នៃ យុទ្ធសាស្ត្រ ចតុកោណ ។
លោក រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា កន្លងមក ក្រសួង ពាណិជ្ជកម្ម បាន ធ្វើ ប្រតិភូកម្ម សេវា CO ទម្រង់ D នេះ ទៅដល់ មន្ទីរ ពាណិជ្ជកម្ម នៅក្នុង ខេត្ត ចំនួន ៥ ដូចជា ប៉ៃលិន បាត់ដំបង បន្ទាយមាន ជ័យ ឧត្តរមានជ័យ និង រតនគិរី រួមទាំង តំបន់ សេដ្ឋកិច្ច ពិសេស ចំនួន ២ នៅក្នុង ខេត្ត ស្វាយរៀង គឺ Manhattan តាយ សេង និង សាន ដុង - សាន់ សែល ដើម្បី សម្រួល ដល់ ការធ្វើ ពាណិជ្ជកម្ម ជាពិសេស ការនាំចេញ កសិផល របស់ ប្រជាកសិករ ខ្មែរ ។
