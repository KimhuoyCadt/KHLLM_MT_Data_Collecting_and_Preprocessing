បើខ្ញុំស្លាប់ តើអ្នក ណាមើលថែកូនប្រុសខ្ញុំ ?
( នេះជាការ ចម្អិនម្សៅ កុំដុតវាឡើយ ) ។
នៅពេល ត្រជាក់ ពួកគេ ត្រូវបាន លាប ពណ៌ ។
នៅពេល ខ្ញុំ ផ្សាយ សេចក្តីពិត ខ្ញុំ នឹង ផ្តល់ សេចក្តីពិត ដោយ មិន គិត ថ្លៃ ដើម្បី កុំ ឱ្យ ប្រើ សិទ្ធិ របស់ ខ្ញុំ ទាំងស្រុង នៅក្នុង ដំណឹង ល្អ ។
៥ ប៉ុន្តែបើយើង សង្ឃឹមលើអ្វីដែលយើងមើលមិនឃើញនោះ យើងរង់ចាំដោយ ចិត្តអត់ ធ្មត់ ។
បាន ឈានដល់ ដែន កំណត់ នៃ ការស៊ូទ្រាំ ។
កុំ សរសេរ សិលាចារឹក ក្នុង សៀវភៅ ។
តូច ជាង ត្រូវបាន គេ ហៅ ថា មីនី
នាងនឹងប្រសូតបានកូនប្រុសមួយ ហើយអ្នកត្រូវដាក់ឈ្មោះគាត់ថា យេស៊ូវ ព្រោះទ្រង់នឹង សង្គ្រោះរាស្ដ្រទ្រង់ពីអំពើ បាបរបស់គេ » ។
នាងនឹងសម្រាលបានកូនប្រុសមួយ ហើយត្រូវដាក់ឈ្មោះគាត់ថា យេស៊ូ ព្រោះគាត់នឹង សង្គ្រោះ រាស្ត្រគាត់ឲ្យរួចពី បាប » ។
ដូច្នេះ ចូរប្រយ័ត្នអ្នកដែលដើរការពារ ។
យើងបានឃើញមនុស្ស និងអង្គការដែលមានការ យកចិត្តទុកដាក់ ជាច្រើនបានទទួលតួនាទីរបស់ពួកគេក្នុងការ ការពារកុមារក្នុងតំបន់ ។
ពិភពលោក ទាំងមូល កំពុង ឈរ ជាមួយ អ្នក ។
ហេតុ អ្វី បានជា ព្រះមិន ជួយ ខ្ញុំ ?
បន្ទាប់ពី នោះ វា បង្ហាញ ពី ភាពអស្ចារ្យ របស់ វា ។
ព្រះបាន ត្រាស់ហៅ យើង ឱ្យ រស់ នៅ ដោយ សន្តិភាព ។
យន្តហោះ មួយ ទៀត ខ្ញុំ មិន អាច ប្រាប់ បាន ទេ ។
អ្នក ណាបដិសេធព្រះបន្ទូលរបស់ព្រះជាម្ចាស់ អ្នកនោះក៏បដិសេធព្រះ ខ្លួនឯងដែរ ព្រោះព្រះជាម្ចាស់ជាព្រះបន្ទូល ។
អរគុណ សម្រាប់ ពីរ ឆ្នាំ កន្លងមក
ម៉ូសេ និងអើរ៉ុនត្រូវបានគ្របសង្កត់ដោយ កងទ័ពរបស់ផារ៉ោន ។
១៣ ហើយសមុទ្របានប្រគល់មនុស្សស្លាប់ដែលនៅក្នុងនោះ ។ សេចក្ដីស្លាប់ និង ឋាន នរក បាន លះបង់ មនុស្ស ស្លាប់ ដែល មាន នៅក្នុង ពួកគេ ។ ហើយ ពួកគេ ត្រូវបាន គេ វិនិច្ឆ័យ ម្នាក់ ៗ តាម អំពើ របស់ ពួកគេ ។
គាត់បានសាទ រថា៖ « នេះជា សញ្ញាដ៏ធំមួយសម្រាប់យើង។
ជាងមួយឆ្នាំទៅហើយ តើអនុស្សាវរីយ៍នៅ ឯណា?
អ្នក ណាជឿលើខ្ញុំនឹងមានជីវិត ទោះជាអ្នកនោះស្លាប់ក៏ដោយ ។ ហើយអស់អ្នកដែលរស់ ហើយជឿលើខ្ញុំនឹងមិនស្លាប់ឡើយ » ។
មុខ របស់ នាង ហើយ អ្នកគ្រប់ ពេលវេលា ។
អ្នក អាច ធ្វើ វា បាន គ្រប់ ទីកន្លែង ក្នុង ជីវិត របស់ អ្នក ។
សហរដ្ឋ អាមេរិក តំណាង ឱ្យ លទ្ធិ ប្រជាធិបតេយ្យ នៅ ជុំវិញ ពិភពលោក ហើយ ឥឡូវនេះ វា មាន សារៈសំខាន់ ណាស់ ដែល គួរតែ មាន ការផ្ទេរ អំណាច ដោយ សន្តិវិធី និង របៀបរៀបរយ » ។
11 កុំបោះខ្ញុំចេញពីវត្តមានរបស់អ្នក ហើយកុំដកព្រះ‌វិញ្ញាណបរិសុទ្ធរបស់អ្នកចេញពីខ្ញុំឡើយ ។
ខ្ញុំសុំប្រាប់អ្នក រាល់គ្នាជាប្រាកដថា ទេវតារបស់ពួកគេឃើញមុខព្រះ បិតាខ្ញុំ ដែលគង់នៅស្ថាន សួគ៌គ្រប់ពេល ។
« យើងមិនអាចឡើងប្រឆាំងនឹងប្រជាជនបានទេ ព្រោះពួកគេខ្លាំងជាងយើង » ។
7 ទ្រង់យាងមកដោយពពក ហើយគ្រប់ភ្នែកនឹងឃើញទ្រង់ សូម្បីតែអ្នកដែល ទម្លុះទ្រង់ ហើយកុលសម្ព័ន្ធទាំងអស់នៅលើផែនដីនឹង កាន់ទុក្ខដោយព្រោះទ្រង់ ។
ឪពុក ម្តាយ ត្រូវ ចងចាំ រឿង នេះ
និយាយ ដោយ ស្ងប់ស្ងាត់ ទៅកាន់ ពួកគេ ហើយ ផ្តល់ឱ្យ ពួកគេ ថា នឹង ជួយ ពួកគេ ប្រសិនបើ ពួកគេ ត្រូវការ វា ។
យើងសម្រេច ចិត្តឲ្យកូនទៅជាមួយនាង ។
៦ មាន ពរ ហើយវិសុទ្ធ គឺអ្នកដែលមានចំណែកក្នុងការ រស់ឡើងវិញដំបូង ការ សោយទិវង្គតលើកទីពីរនេះគ្មានអំណាចអ្វីឡើយ ប៉ុន្តែពួកគេនឹងធ្វើជាបូជាចារ្យរបស់ព្រះ និងរបស់ព្រះ គ្រីស្ទ ហើយនឹងសោយរាជ្យជាមួយនឹងទ្រង់អស់មួយពាន់ឆ្នាំ » ។
មានចែងទុកក្នុងគម្ពីរព្យាការីថា ‹ ព្រះ នឹងបង្រៀនគេទាំងអស់គ្នា › ។
“ បារ៉ាក់ និង ខ្ញុំ ត្រូវបាន ចិញ្ចឹម បីបាច់ ដោយ គុណ តម្លៃ ដូច គ្នា៖ ដែល អ្នក ខំប្រឹងប្រែង ដើម្បី អ្វី ដែល អ្នក ចង់បាន ក្នុង ជីវិត ។
គោលបំណង គឺ ល្អ ; គាត់ ធ្វើអន្តរកម្ម ជាមួយ មនុស្ស ; មនុស្ស
យើង បាន ដាក់ សំណើ ដេញថ្លៃ ប៉ុន្តែ បន្ទាប់មក បាន ដក វា ចេញ បង្ហាញ ប្រភព មួយ ។
តើមានគំនិតអ្វីខ្លះទៀត ?
កំណត់ ផងដែរ នូវ កម្ពស់ ដែល អ្នក នឹង ឡើង លើ និង តាមដាន អាកាសធាតុ ។
ហើយ ខ្ញុំ ពិតជា រីករាយ ណាស់ ដែល បាន រកឃើញ អ្នក , ក្មេងស្រី
មនុស្សជាច្រើនបានជឿថាទ្រង់ជាព្រះ គ្រីស្ទ ជាព្រះអង្គ សង្គ្រោះ ដោយ សារទ្រង់ជ្រាបគ្រប់យ៉ាងអំពីពួកគេ ។
ហើយការ សន្លប់មិនមែនជាផ្នែកមួយនៃមនុស្ស ជាតិទាំងមូលទេ ?
ខ្ញុំ រីក រាយណាស់ដែលខ្ញុំមិនដែលបានបញ្ជូនគាត់ឬអ្នក នយោបាយ ណាម្នាក់មួយកាក់មួយសេន មកទេ ។
មាន រឿង មួយចំនួន ក្នុង ជីវិត ដែល អ្នក ដឹង ថា មិន ល្អ សម្រាប់ អ្នក ប៉ុន្តែ អ្នកធ្វើ យ៉ាងណា ក៏ ព្រោះតែ ភាពល្ងង់ខ្លៅ គឺជា សេចក្តីសុខ ។
អ្នក ណាដែលជឿលើខ្ញុំនឹងមានជីវិត ទោះបីគាត់ស្លាប់ក៏ដោយ ។ ហើយ អ្នកណា ដែល ជឿ លើ ខ្ញុំ នឹង មិន ស្លាប់ ឡើយ » ។
ពេលវេលា និង លះបង់ ខ្លួន ឯង ចំពោះ ការពិត ។
ប្រសិនបើគាត់នៅជុំវិញថ្ងៃនេះ ខ្ញុំគិតថាគាត់នឹងក្លាយជាម្ចាស់ជើងឯកពិភពលោក ។
ដូច្នេះ យើងប្រើវាដើម្បីបំបែកផ្ទៃខាងមុខពីផ្ទៃខាងក្រោយ ។
ក្នុងចំណោមពួកគេបានបាត់ បង់មនុស្សជាទី ស្រឡាញ់ ហើយពួកគេបានស្វែង រកការ ពិត និងការ សម្រាលទុក្ខ ។
២០ អ្នកអាចដើរតាមមាគ៌ារបស់មនុស្សល្អ ហើយ កាន់តាមមាគ៌ារបស់មនុស្សសុចរិត ។
អ្នកថតរូបដែលកំពុងថតនោះ គាត់ ជាអ្នក នោះ ។
« ប្រយ័ត្នចំពោះព្យាការីក្លែងក្លាយ » ។
មាន អារម្មណ៍ ថា គ្មាន អ្នកណា ស្រលាញ់ អ្នកទេ ?
វា នឹង មាន សេវាកម្ម មួយ អម ដោយ ពេលវេលា ដើម្បី ប្រមូលផ្តុំ ។
តើអ្នកចង់សម្រេចអ្វីក្នុងឆ្នាំនេះ ?
