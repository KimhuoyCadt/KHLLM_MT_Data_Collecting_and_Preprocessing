ខ ទី ៣៖ « ដោយពោលថា ‹ កុំធ្វើ បាបផែនដី ឬសមុទ្រ ឬដើមឈើឡើយ ដរាប ណាយើងបានបិទ ត្រាអ្នក បម្រើនៃព្រះ នៃយើងនៅលើថ្ងាស ›» ។
អឺ.. . តើសត្វ កណ្ដុរនឹងបង្ហាញខ្លួននៅកន្លែង ណាបន្ទាប់ ?
តាម បញ្ជានេះ ស្ត្រីនិងកុមារមិនត្រូវទេ ។
កាលគេបានឃើញព្រះអង្គហើយ ក៏យល់អំពីព្រះ‌បន្ទូល ដែលគេប្រាប់គេអំពីកូននេះ ។
ព្រះយេស៊ូមានព្រះបន្ទូល តបវិញ ថា៖ « កុំត្រេកអរនឹងការ នេះឡើយ ដែលវិញ្ញាណចូល មក រកអ្នក រាល់គ្នា តែសូមអរ សប្បាយដែលឈ្មោះរបស់អ្នកត្រូវបានសរសេរនៅស្ថាន បរម សុខ » ។
ដូច្នេះកំណត់ឲ្យយើងនូវការ ណាត់ជួបមួយដែលយើងទាំងពីរនឹងមិនខកខានក្នុងការ រក្សាទុកនៅកន្លែងកណ្តាល » ។
ជាមួយនឹង ភាពប្រាកដប្រជា នៃ ចំណេះដឹង របស់ អ្នក ។
ខ្ញុំ ចាប់ផ្តើម យំ ហើយ ស្រែក រក កូនប្រុស របស់ ខ្ញុំ ។
ហើយ ចុងក្រោយ យើង បាន អាន ថា ពួក នាយក បូជាចារ្យ ចង់ សម្លាប់ ឡាសារ ផងដែរ ។
អ្នកដែលឃើញខ្ញុំ រត់ គិតថាខ្ញុំ ជាអ្នកគាំទ្រយ៉ាងខ្លាំង ។
វា ជា ការពិត នៅ សហរដ្ឋ អាមេរិក
បន្ទាប់មកគាត់និយាយថា៖ « ជិតបី រយម៉ាយពីក្រុងមួយត្រូវភ្លើងឆេះ » ។
តើអ្នក ឃើញថាអ្វីដែល អស្ចារ្យ ?
21 ព្រះទ្រង់នឹងមិនស្វែង រកការ ទាំងនេះទេ ដ្បិតទ្រង់ជ្រាបនូវអាថ៌កំបាំងនៃ ចិត្ត ។
ហើយត្រេកអរក្នុងការ ឆ្លងផុតនៃ ចិត្ត ។
នរក គាត់ មាន កូនស្រី ម្នាក់ ដែល ខ្ញុំ មិន ធ្លាប់ ជួប ។
« មានបុរសពីរនាក់ឡើងទៅក្នុងព្រះវិហារដើម្បីអធិស្ឋាន » ។
រួចវាយយើងម្ដងទៀត ពេលគេយកយើងឡើងលើសំពៅ ។
អូរី អូ ប្រហែលជា ល្អ ។
ក្រៅពីនោះ អ្នកក៏ព្រមវាយកម្ទេចអាសនៈដែលគេបូជាដល់រូបព្រះ របស់គេ ។
ដូច្នេះ ជន ជាតិអ៊ីស្រាអែលបានធ្វើគ្រប់យ៉ាង ដូចព្រះ អម្ចាស់បានបង្គាប់មកលោកម៉ូសេ ។
ពេលហៅទៅគេហៅមកវិញភ្លាម ។
មុនពេល នាង រៀបការ ជាមួយ បុរស
មិន អី ទេ ខ្ញុំ មាន បណ្តុំ រហូតដល់ ចុងបញ្ចប់ នៃ ជំពូក ។
ខ្ញុំបានសម្រេច ចិត្តជួប និងនិយាយជាមួយនារីម៉ិកស៊ិក ។
ដែល បាន ដើរ តាម មាគ៌ា របស់ ឪពុក ខ្លួន
ឬ សរសេរ ឡើងវិញ នូវ គូ របស់ ពួកគេ តាំងពី ដើម រៀង មក ដូចជា អស់សង្ឃឹម ច្របូកច្របល់ និង មិន ច្បាស់លាស់ ក្នុង ទិសដៅ របស់ ពួកគេ ។
ពួកគេ ត្រូវការ ជំនួយ ពី អ្នក ដើម្បី រំដោះ ខ្លួន ចេញ ពី ភាពក្រីក្រ ។
ចូរ សរសើរ តម្កើង ព្រះអង្គ ចំពោះ ទង្វើ ដ៏ ឧត្តុង្គឧត្តម របស់ ព្រះអង្គ ចូរ សរសើរ តម្កើង ព្រះអង្គ តាម ចំនួន ដ៏ ច្រើន របស់ ព្រះអង្គ ។
ប្រជាជនក្នុងស្រុកមួយចំនួនធំបានក្លាយទៅជា សាសន៍យូដា ដ្បិតគេខ្លាច ជន ជាតិយូដា ។
បន្ត ទៅ តាម ផ្លូវ ហើយ កម្ចាត់ អ្នកយាម ពីរ នាក់ នៅក្នុង នោះ ( កុំ ភ្លេច ជញ្ជក់ ព្រលឹង របស់ ពួកគេ បន្ទាប់ពី កម្ចាត់ ពួកគេ ) ។
អ្នក ត្រូវតែ បង្ហាញ ពួកគេ ថា អ្នក កំពុង សម្លឹងមើល ពួកគេ យ៉ាងហោច ដើម្បីឱ្យ ពួកគេ មក រក ។
យើង ទាំងអស់ គ្នា ជា កូន ជាទីស្រឡាញ់ របស់ ព្រះ។
« ទ្រង់នឹង នាំខ្ញុំចេញទៅ ឯពន្លឺ
ហើយបុរសដែលកំពុង រត់វាប្រាកដជាគាត់ជាបុរសដែលមានឥទ្ធិពលបំផុត និងច្រណែនបំផុតក្នុងពិភពលោក !
« ខ្ញុំចង់ប្រាប់នាងថា បើនាងចង់បានកូនវិញ ខ្ញុំក៏នៅក្មេងដែរ » ។
នោះ នឹង ធ្វើឱ្យ អ្នក តែ ប៉ុណ្ណោះ
មាន ពរ ហើយ អ្នកបង្កើត សន្តិភាព ពួកគេ នឹង ត្រូវបាន គេ ហៅ ថា ជា កូន របស់ ព្រះ។
មាន ពរ ហើយ អ្នកបង្កើត សន្តិភាព ពួកគេ នឹង ត្រូវបាន គេ ហៅ ថា ជា កូន របស់ ព្រះ។
សូមឲ្យព្រះ នៃ អ័ ប្រាហាំ និងព្រះ នៃ ណា ហូរ ” ជាព្រះ នៃបិតារបស់ពួកគេ — “ វិនិច្ឆ័យរវាងយើងរាល់គ្នា ” ។
ទៅ កន្លែង បន្ទាប់ និង កន្លែង បន្ទាប់
តាមរយៈ អំណោយទាន របស់ ព្រះ វា ស្ថិត នៅក្នុង អំណាច របស់ យើង ក្នុង ការបង្កើត ទ្រង់ ។ អ្នកណា មិន ងងុយ គេង ។
ពួកគេមានឆន្ទៈក្នុងការ បំពេញការងារ ហើយខ្ញុំរីករាយនឹងការ បង្រៀនពួកគេ » ។
កុំ យក ព្រះវិញ្ញាណ បរិសុទ្ធ របស់ អ្នក ចេញ ពី ខ្ញុំ ។
សារ៉ា គឺជា ស្ត្រី តែ ម្នាក់ គត់ ដែល អាយុ ត្រូវបាន លើកឡើង ជាពិសេស ។
ដូច្នេះខ្ញុំដាក់ឈ្មោះទៅមុខ » ។
ព្រោះ គាត់ ជា ម្ចាស់ របស់ អ្នក / ហើយ ក្រាប ថ្វាយបង្គំ គាត់ ។
១៥ ហើយប្រសិនបើពួកគេបានគិតអំពីប្រទេសដែលពួកគេបានចេញពីស្រុកនោះ នោះពួកគេនឹងមានឱកាសត្រឡប់មកវិញ ។
19 ហើយប្រសិនបើពួកគេទាំងអស់គ្នាជាសមាជិកតែមួយ តើរូប កាយនៅ ឯណា ?
( ៩) នេះជាឧទាហរណ៍មួយសម្រាប់សម័យបច្ចុប្បន្ន ដែលបង្ហាញថា ទាន និង យញ្ញ បូជាដែលគេថ្វាយនោះ មិនអាចជម្រះសតិសម្បជញ្ញៈរបស់អ្នកថ្វាយបង្គំបានឡើយ ។
ហើយបើគ្មាននេះទេ វានឹងគ្មានសេចក្តី ល្អអ្វីឡើយ ទោះជាមនុស្ស ឬក្នុងសត្វ ដទៃក៏ដោយ ។
ដូច្នេះមាន តែអាស៊ី អាគ្នេយ៍ប៉ុណ្ណោះដែលមានក្នុងរឿងនេះ ។
តើអ្នកខ្វល់ខ្វាយអ្វីជាងក្នុងជីវិតរបស់អ្នក ?
គាត់បានដេកនៅក្នុងកន្លែង ប្រព្រឹត្តិកម្មទឹកក្នុងភូមិរបស់គាត់ជាងមួយឆ្នាំ មកហើយ ។
« ច្បាប់តម្រូវឲ្យមានការ ប្រមូលផ្តុំ ដូច្នេះយើងត្រូវប្រមូលផ្តុំ ។
ខ្ញុំ អធិស្ឋាន អំពាវនាវ ដល់ ព្រះនៃ សកលលោក ។
ពិភពលោកសេរីមិនមានសេរីភាពទៀតទេ ។
យើង ទាំងអស់ គ្នា មាន ការលះបង់ ។
ស្ដេចសព្វព្រះហឫទ័យនឹងចាត់ខ្ញុំ មក ។ ហើយខ្ញុំកំណត់ពេលឲ្យគាត់ » ។
លោកបានប្រកាស ថា៖ « ឱ អ៊ីស្រាអែលអើយ ចូរស្ដាប់ច្បាប់ និងសេចក្ដី វិនិច្ឆ័យដែលខ្ញុំនិយាយក្នុងត្រចៀកអ្នក រាល់គ្នានៅថ្ងៃនេះ ដើម្បីឲ្យអ្នក រាល់គ្នាបានរៀន ហើយ កាន់តាម ហើយធ្វើតាម ។
គេ មិន ធ្វើ ទេ គេ គ្រាន់តែ ខ្ជះខ្ជាយ ពេល វេលា ។
អ្នក អាច អនុញ្ញាតឱ្យ មនុស្ស កក់ ផ្ទះ របស់ អ្នក ក្នុង រយៈពេល ដែល បាន កំណត់ ទុក ជាមុន ។
ព្រះអម្ចាស់ទ្រង់យាងទៅមុខអ្នក ហើយនឹងគង់នៅជាមួយអ្នក ... ទ្រង់នឹងមិនចាកចេញពីអ្នក ឬបោះបង់អ្នកឡើយ ។
ហើយ គាត់ ហាក់ដូចជា ចុះ សម្រុង ជាមួយ ពូទីន ។
ទំនាក់ទំនង តាម អ៊ីនធឺណិត ដើម្បី ជីវិត ។
អាកប្បកិរិយា របស់ អ្នក គួរតែ ដូចគ្នា នឹង ព្រះយេស៊ូវ គ្រី ស្ទ៖
ហើយ ការពិត គឺ ពួកគេ ដឹង ច្រើន ។
« ប៉ុន្តែខាងក្នុងគឺយើងដូចគ្នា។
10 ទូលបង្គំខំស្វែង រកព្រះអង្គ សូមកុំឲ្យទូលបង្គំវង្វេងតាម បញ្ជារបស់ព្រះអង្គឡើយ ។
គាត់ចង់ធ្វើខ្លួនឲ្យស្អាតជា សាធារណៈ !
ទទួលខុសត្រូវ៖ អនុបណ្ឌិត ច្បាប់ ។
រោគកាចដែលបង្កកំណើតពួកវា !» ។
បើមិនដូច្នោះទេ អ្នកនឹងប្រឆាំងនឹងគ្រាប់ ធញ្ញជាតិ ដែលធ្វើឲ្យវា កាន់ តែពិបាកក្នុងការ ទ្រទ្រង់ ។
ដូច្នេះវាជាពាក្យពីរផ្សេងគ្នា » ។
អ្វី គ្រប់ យ៉ាង ដើម្បី ដើរ តាម ព្រះយេស៊ូវ ។
ដូច្នេះ ដំបូង យើង ត្រូវ ដោះសោ កម្មវិធី ចាប់ផ្ដើម ប្រព័ន្ធ ។
យក ពួកគេ តាម ស្មារតី ដែល ពួកគេ មាន បំណង ។
ការហូរ ឈាម គួរតែ ត្រូវបាន បញ្ឈប់ នៅ ពេល នេះ ។
នឹង ក្លាយជា ភាពសម្បូរបែប នៃ ស្រស់
គាត់បានឆ្លើយថា “ ខ្ញុំធ្វើស្នាមរន្ធរាល់ថ្ងៃ ។
វា នៅតែ ធ្វើឱ្យ ខ្ញុំ ឈឺចាប់ ដែល នាង មិន នៅ ទីនេះ ដើម្បី ទទួល របស់ ទាំងនោះ ។
២៦ ហើយ ស ត្រូវចុងក្រោយដែលត្រូវបំផ្លាញគឺសេចក្ដី ស្លាប់ ។
យ៉ាង ណាក៏ដោយ គាត់បាននិយាយថា៖ ' ប្រាប់គ្រួសារអ្នកឲ្យទៅលក់អ្វី ៗទាំងអស់ ។
ដើម្បី រក្សាទុក គ្រីស្តាល់ គាត់ បាន បង្កើត នាវា ដែល មាន ចំណុច រំពុះ ទាប បំផុត ។
ថែរក្សា អ្វី ដែល អស្ចារ្យ ។
« ព្រះជាម្ចាស់ដែលបានត្រាស់ហៅអ្នក រាល់គ្នាឲ្យរួម រស់ជាមួយនឹងព្រះរាជបុត្រារបស់ព្រះអង្គ គឺលោកយេស៊ូគ្រិស្ដជាអម្ចាស់នៃយើង ទ្រង់ ស្មោះត្រង់ » ។
42. បន្ទាប់មក ទូលបង្គំនឹងឆ្លើយ តបទៅអ្នកដែលតិះដៀលទូលបង្គំ ដ្បិតទូលបង្គំជឿលើព្រះបន្ទូលរបស់ព្រះអង្គ ។
រត់ ចោល ជួរ មុន របប កាដាហ្វី ។
ពួកគេចង់ដឹងពីអ្វីដែលពួកគេនឹងត្រូវបានទទួល ពីព្រះអម្ចាស់ ។
យើងនឹង បណ្ដេញពួកគេចេញពីមុខ កងទ័ពអ៊ីស្រាអែល ។
មិត្តភក្តិ របស់ ខ្ញុំ បាន ខ្ជះខ្ជាយ ។
១១ កាលខ្ញុំនៅក្មេង ខ្ញុំនិយាយដូចក្មេង ខ្ញុំគិតដូចក្មេង ខ្ញុំគិតដូចក្មេង ។
ពេលថ្ងៃលិច គេមិនស្គាល់ដីនោះទេ ប៉ុន្តែគេឃើញឈូងសមុទ្រមានឆ្នេរខ្សាច់ ទើបគេសម្រេច ចិត្តបើក កប៉ាល់ទៅចតចោល បើអាច ។
ប៉ុន្តែពួកគេ សង្ឃឹមថាយុទ្ធនាការទប់ស្កាត់មេរោគនឹងមាន ភាពប្រសើរឡើងគួរឲ្យ កត់សម្គាល់ក្នុងរយៈពេលបីខែ ។
តើនោះជាខ្សែកោងនៃផែនដី ឬ ជាកញ្ចក់ ?
ព្រះជាម្ចាស់ ទ្រង់ បាន នាំ វា ឡើង ។
« អ្វីដែលអ្នកចង់បានខ្ញុំនឹងឱ្យទៅអ្នក។
អ្នក ត្រួសត្រាយ នៃ ថ្ងៃ នេះ គឺ អ្នក និង ខ្ញុំ ។
បន្ទាប់ពី នោះ វ៉ានីឡា ។
យ៉ូសែបបានចាត់គេមក ហើយហៅយ៉ាកុបជាឪពុកមករកគាត់ និងសាច់ញាតិទាំងអស់ចិត សិបប្រាំព្រលឹង ។
« ដ្បិតអ្នកបានឲ្យគាត់មានអំណាចលើមនុស្សទាំង អស់ ដើម្បីឲ្យគាត់អាចផ្ដល់ជីវិតដ៏នៅអស់ កល្ប ជានិច្ចដល់អស់អ្នកដែលអ្នកបានផ្ដល់ឲ្យគាត់ » ។
សួស្តី ដូច ដែល ប្រិយមិត្ត ជាច្រើន បាន កត់សម្គាល់ រួចហើយ ។
ទោះ ជាយ៉ាងណា ជីវិតអាពាហ៍ពិពាហ៍នេះបាន បញ្ចប់ក្នុងឆ្នាំ ២០១១ ។
តើ អ្នកណា នឹង មើល ថែ អ្នក ពេល អ្នក លះបង់ ខ្លួន ឯង ដោយ ភាពក្លៀវក្លា បែប នេះ ហើយ យោង ទៅតាម អ្នក ខ្លះ ការ មិន ប្រុងប្រយ័ត្ន បែប នេះ ?
ដូច្នេះ គ្រិស្ត សាសនិកម្នាក់គឺ ជាអ្នកដែលបានកើតម្ដងទៀតដោយព្រះ ដែលមានចែងក្នុង យ៉ូហាន ៣:៣; យ៉ូហាន ៣:៧; និង ពេត្រុស 1:23 ហើយបានដាក់សេចក្តី ជំនឿ និងទុក ចិត្តលើព្រះយេស៊ូវ គ្រីស្ទ ។
១៧ អស់អ្នកដែលស្រឡាញ់ខ្ញុំ ខ្ញុំស្រឡាញ់ ហើយអ្នក ណាដែលស្វែង រកខ្ញុំនឹង រកឃើញ ។
8:13 ហើយគាត់បាននិយាយមកខ្ញុំ : " ប្រសិនបើអ្នកត្រឡប់មកវិញ , អ្នកនឹងឃើញសូម្បីតែការ ស្អប់ខ្ពើមខ្លាំងជាងនេះ, ដែលអ្នកទាំងនេះត្រូវបានប្រព្រឹត្ត។
ត្រូវ មាន សុជីវធម៌ ចំពោះ អ្នក ដែល ឆ្លងកាត់ ផ្លូវ របស់ អ្នក ។
ហើយ វា នឹង ត្រូវបាន បញ្ចូល ទៅក្នុង ឧបករណ៍ ផ្សេង ទៀត ។
ឥឡូវនេះ គាត់ រស់ នៅ ជាមួយ ប្រពន្ធ និង កូនស្រី របស់ គាត់ នៅ ទីក្រុង វ៉ាស៊ីនតោន ឌីស៊ី ។
នេះ ជាលើក ទីបីហើយដែលឯងជិតត្រូវគេសម្លាប់ !» ។
ព្រះ យេស៊ូវត្រូវបានជ្រើស រើសមុនការ បង្កើតពិភពលោក ប៉ុន្តែត្រូវបានបើកសម្ដែងនៅ គ្រាចុងក្រោយនេះ សម្រាប់ជាប្រយោជន៍ដល់អ្នក ។
៤ នៅក្នុងទ្រង់មានជីវិត ហើយជីវិតនោះ ជាពន្លឺនៃមនុស្ស ។
បាន ធ្លាក់ ចូល ទៅក្នុង ដៃ របស់ ប៊ីស្សព ។
ពេលចូលទៅក្នុងផ្ទះ សូមជម្រាបសួរ ។
ពួកគេបាននិយាយថា៖ « យើង សង្ស័យដោយ ស្មោះថាការ ដោះ សាររបស់គាត់ទោះបីជាគាត់បានបង្ហាញពួកគេគឺពិតជាស្មោះត្រង់ » ។
ទោះជា យ៉ាងណា ក៏ដោយ ប៊ុន របស់ អ្នក នឹង រីករាយ ជាមួយ វា ម្តង មួយ ៗ បន្ទាប់ពី ពេលវេលា ។
