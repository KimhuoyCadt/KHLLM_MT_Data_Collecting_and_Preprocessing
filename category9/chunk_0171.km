បន្ថែម ពីលើ នោះ កម្ពុជា មាន កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី ជាមួយ ចិន និង បណ្តា ប្រទេសជា ដៃគូ ជាច្រើន ទៀត ផងដែរ ។ ហេដ្ឋារចនាសម្ព័ន្ធ ពេញ ផ្ទៃ ប្រទេស ដែល បាន និង កំពុង អភិវឌ្ឍ រួម មាន ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ក្រុង ព្រះសីហនុ អាកាសយានដ្ឋាន ថ្មី ខេត្ត សៀមរាប ការត្រៀម បើក ដំណើរការ អាកាសយានដ្ឋាន ថ្មី ក្រុង ភ្នំពេញ ការសិក្សា ផ្លូវ រថភ្លើង ភ្នំពេញ - ក្រុង ព្រះសីហនុ ផ្លូវ រថភ្លើង ភ្នំពេញ - បោយ ប៉ែត និង គម្រោង ពង្រីក កំពង់ផែ ទឹក ជ្រៅ ជាដើម ។
បន្ទាប់ពី ជួប ជាមួយ លោក ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ហើយ នោះ ក្រុមហ៊ុន បាន សម្រេច រៀបចំ កិច្ចពិភាក្សា ផ្ទៃក្នុង មួយ ដើម្បី ជជែក និង សិក្សា លទ្ធភាព ក្នុង ការដាក់ ទុន វិនិយោគ នៅ កម្ពុជា ក្នុង ក្របខណ្ឌ ណា មួយ ។
បន្ថែម ពីលើ នេះ ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ក្នុង នាម ថ្នាក់ដឹកនាំ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា រួម និង ក្រុមការងារ បាន បង្ហាញ ការត្រៀមខ្លួន ជាស្រេច ដើម្បី ផ្ដល់ ការពិគ្រោះយោបល់ និង សម្របសម្រួល រាល់ នីតិវិធី វិនិយោគ នៅ កម្ពុជា ៕ សម្តេច រដ្ឋសភា ធិបតី ឃួន សុដារី ផ្ញើ សារលិខិត ជូន ពរ ឯកឧត្តម កិត្តិ សេដ្ឋា បណ្ឌិត ជា ម យៀប ក្នុង ឱកាស ខួប ចម្រើន ជន្មាយុ គម្រប់ ៧៧ ឈានចូល ៧៨ ឆ្នាំ
( ភ្នំពេញ ) ៖ សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា កម្ពុជា បាន ផ្ញើ សារលិខិត ជូន ពរ ឯកឧត្តម កិត្តិ សេដ្ឋា បណ្ឌិត ជា ម យៀប អនុប្រធាន ទី១ រដ្ឋសភា កម្ពុជា នៅក្នុង ឱកាស ខួប ចម្រើន ជន្មាយុ គម្រប់ ៧៧ ឈានចូល ៧៨ ឆ្នាំ នា ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
( កណ្តាល ) ៖ លោក ណុប រ័ត្ន និមល ជំនួយការ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ចុះ មូល ដា្នន ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្តាល បាន ថ្លែង ថា ក្រោម ម្លប់ ដ៏ ត្រជាក់ នៃ សន្តិភាព ទើប បាន ធ្វើ យើង មាន លទ្ធភាព ក្នុង កសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ឱ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ នៅ ទូទាំង ប្រទេស នៅ សព្វ ថ្ងៃ នេះ ។
ការថ្លែង បែប នេះ របស់ លោក ណុប រ័ត្ន និមល បាន ធ្វ់ឡើង ក្នុង ឱកាស លោក បាន អញ្ជើញ ជា តំណាង លោក កិត្ត បណ្ឌិត ហ៊ីង ប៊ុន ហៀង និង លោកស្រី ប៉ែន ចន្នី បាន ថ្លែង ដូចនេះ ក្នុង ខណៈ អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ រងគ្រោះ ជំនន់ ទឹក ភៀង មកពី ៤ភូម នៅក្នុង ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ និង ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្តាល នា ព្រឹក ថ្ងៃទី ២២ តុលា ២០២៣ ។
លោក ណុប រ័ត្ន និមល បាន បន្ត ថា ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ គណបក្ស ប្រជាជន និង រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នា អាណត្តិ ទី៧នេះ បាន ធ្វើឱ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ក្នុង នោះ ប្រជាពលរដ្ឋ រស់ នៅ យ៉ាង សុខសាន្ត ប្រកប មុខរបរ ចិញ្ចឹម ជីវិត ដោយ សេរី មាន ការសាមគ្គី គ្នា ជា ធ្លុង មួយ ឯកភាព ជាតិ ខ្មែរ ជួយ ខ្មែរ យ៉ាង សុខដុមរមនា ផ្ដល់ តែ ភាពញញឹម មាន សុភមង្គល គ្រប់ ក្រុមគ្រួសារ ក្រោម ម្លប់ សន្តិភាព សម្ដេច តេជោ សែន ។
លោក បាន រំលឹក ថា ទីណា មាន ការលំបាក ទីនោះ មាន វត្តមាន ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ជាក់ស្ដែង ក្នុង កំឡុង ពេល ការរាលដាល ជំងឺ កូវីដ១៩ ប្រមុខ រាជ រដ្ឋាភិបាល បាន ស្វែងរក ជំនួយ និង ទិញ ថ្នាំ វ៉ាក់សាំង ពី បណ្ដាល ប្រទេស ជា មិត្ត ដើម្បី យកមក ចាក់ ជូន ប្រជាពលរដ្ឋ ខ្មែរ ដោយ ឥត គិត ថ្លៃ និង បាន ចុះ ចែក ស្បៀងអាហារ ជូន ប្រជាពលរដ្ឋ នៅ តំបន់ បិត ខ្ទប់ រាប់ ពាន់ គ្រួសារ នៅ តំបន់ ទីក្រុង ភ្នំពេញ និង ខេត្ត កណ្ដាល ។
( បន្ទាយមានជ័យ )៖ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ខេត្ត បន្ទាយមានជ័យ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បង្ហាញ អំពី ចំណាត់ការ និង នីតិវិធី ដំណើរ ក្ដី តាម ផ្លូវ ច្បាប់ ចំពោះ ករណី គ្រោះថ្នាក់ ចរាចរណ៍ មួយ ដែល បាន កើតឡើង កាលពី ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០១៩ នៅ ខេត្ត បន្ទាយមានជ័យ បណ្ដាលឲ្យ មាន មនុស្ស ស្លាប់ និង របួស ហើយ ក្រុមគ្រួសារ របស់ ជនរងគ្រោះ បាន បង្ហោះ សារ តាម បណ្ដាញ សង្គម នាំឲ្យ មាន ការយល់ ច្រឡំ ពី សាធារណៈ មតិ ។
ក្រោយពី ទទួលបាន បណ្ដឹង ពី តំណាង អយ្យការ ចៅក្រម ស៊ើបសួរ បាន ចេញ ដីកា កោះហៅ ភាគី ពាក់ព័ន្ធ ក្នុង សំណុំរឿង ខាងលើ ដើម្បី ធ្វើ ការសាកសួរ យក ចម្លើយ ប៉ុន្តែ ជន ត្រូវ ចោទ ឈ្មោះ រិន សា ភេទ ប្រុស នៅតែ បន្ត គេចខ្លួន មិន ចូល បំភ្លឺ តាម ការកោះហៅ ឡើយ ទើប ចៅក្រម ស៊ើបសួរ ចេញ ដីកា បង្គាប់ ឲ្យ ចាប់ខ្លួន លើ ឈ្មោះ រិន សា ភេទ ប្រុស បន្ទាប់មក នៅ ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០២០ ចៅក្រម ស៊ើបសួរ បាន ចេញ ដីកា ដំណោះស្រាយ បញ្ចូន សំណុំរឿង ខាងលើ និង ជន ត្រូវ ចោទ ឈ្មោះ រិន សា ភេទ ប្រុស ទៅ ជំនុំជម្រះ តាម នីតិវិធី ។
ចំពោះ សំណុំរឿង ព្រហ្មទណ្ឌ ខាងលើ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ខេត្ត បន្ទាយមានជ័យ ចាត់ការបាន ត្រឹមត្រូវ និង ឆាប់រហ័ស តាម នីតិវិធី និង មិន បាន ដោះលែង ជនល្មើស ដូច ការលើកឡើង របស់ ក្រុមគ្រួសារ របស់ ជនរងគ្រោះ នោះ ទេ ហើយ តុលាការ នៅតែ បន្ដ ខិតខំ ស្វែងរក ពិរុទ្ធជន ខាងលើ មក ផ្ដន្ទាទោស តាម ផ្លូវ ច្បាប់ ៕ CEEC ជា ក្រុមហ៊ុន ថាមពល ចិន អាច ផលិត ថាមពល បាន ១. ៣៥លាន គីឡូវ៉ាត់
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ចេញ ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ ។ ស្ថានីយ ទាំង ៨រួម មាន៖
សូម អាន ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក ជំនន់ របស់ ក្រសួង ធនធាន ទឹក ពី ស្ថានភាព កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ដូច ខាងក្រោម៖ ខុទ្ទកាល័យ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ ជាមួយ លោកជំទាវ ជឹម ម៉ានី ចំពោះ មរណភាព របស់ ឯកឧត្ដម ប្រាក់ វណ្ណឌី
( ភ្នំពេញ ) ៖ ខុទ្ទកាល័យ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ជាមួយ លោកជំទាវ ជឹម ម៉ានី និង ក្រុមគ្រួសារ ទាំងអស់ ចំពោះ មរណភាព របស់ ឯកឧត្ដម ប្រាក់ វណ្ណឌី នាយក រង ខុទ្ទកាល័យ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ វេលា ម៉ោង ១០: ១០នាទី ដោយ រោគា ពាធ ក្នុង ជន្មាយុ ៦៤ ឆ្នាំ ។
សារ នេះ ត្រូវបាន ចែកចាយ ជា ខិតប័ណ្ណ ដែល មាន ឈ្មោះ និង និមិត្ត សញ្ញា របស់ កងកម្លាំង ការពារ ជាតិ នៅ ថ្ងៃសៅរ៍ ( ថ្ងៃទី ២១ តុលា ) ហើយ ត្រូវបាន ផ្ញើ ទៅកាន់ មនុស្ស តាម ទូរសព្ទ ចល័ត ទូទាំង តំបន់ ហ្គាហ្សា ស្ទ្រីប ដែល ជា តំបន់ តូច ចង្អៀត ដែល មាន ប្រវែង ត្រឹមតែ ៤៥ គីឡូម៉ែត្រ ប៉ុណ្ណោះ ។
សារ ព្រមាន បាន សរសេរ ថា « ការព្រមាន ជាបន្ទាន់ ដល់ អ្នក រស់ នៅក្នុង តំបន់ ហ្គាហ្សា ។ វត្តមាន របស់ អ្នក នៅ ភាគ ខាងជើង ធ្វើឱ្យ ជីវិត របស់ អ្នក ស្ថិត ក្នុង គ្រោះថ្នាក់ ។ អ្នកណា ដែល ជ្រើសរើស មិន ចាកចេញ ពី ភាគ ខាងជើង ហ្គាហ្សា ទៅ ភាគ ខាងត្បូង អាច ត្រូវបាន កំណត់ ថា ជា អ្នក សមគំនិត ជាមួយ អង្គការ ភេរវករ » ។
នេះ ជា ការលើកឡើង របស់ លោក បណ្ឌិត អ៊ាង សុផល្លែត ក្នុង កម្មវិធី ការទូត បៃតង សហភាព អឺរ៉ុប - អាស៊ាន ដែល រៀបចំឡើង នា ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ នៅ រាជធានី ភ្នំពេញ ។
លោក រដ្ឋមន្រ្តី បរិស្ថាន បាន បង្ហាញ ថា យុទ្ធនាការ « ថ្ងៃ នេះ ខ្ញុំ មិន ប្រើ ថង់ ប្លាស្ទិក ទេ » បាន បង្កើតឡើង ក្នុង គោលបំណង ដោះស្រាយ បញ្ហា សំណល់ ប្លាស្ទិក ជាមួយនឹង សារ ដ៏ សាមញ្ញ ប៉ុន្តែ មាន លក្ខណៈ ស៊ីជម្រៅ ដែល បាន លើកទឹកចិត្ត ពួកយើង ម្នាក់ ៗ ឲ្យ ពិចារណា ឡើងវិញ នូវ ជម្រើស និង ទម្លាប់ ការរស់នៅ ប្រចាំ ថ្ងៃ របស់ យើង ដោយ ការបោះជំហាន យ៉ាង សំខាន់ មួយ ឆ្ពោះ ទៅ ការកាត់បន្ថយ សំណល់ ប្លាស្ទិក ។
ជាមួយគ្នា នេះ ដែរ លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន បញ្ជាក់ បន្ថែម ថា ជោគជ័យ នៃ យុទ្ធនាការ នេះ មិន អាច កើតឡើង បាន ទេ ប្រសិនបើ គ្មាន ការគាំទ្រ និង ការចូលរួម ពី ភាគី ពាក់ព័ន្ធ នានា និង កិច្ច ខិតខំ ប្រឹងប្រែង រួមគ្នា របស់ យើង ម្នាក់ ៗ មិន ត្រឹមតែ អាច ទ្រទ្រង់ នូវ សន្ទុះ ចលនា របស់ យុទ្ធនាការ នេះ ប៉ុណ្ណោះ ទេ ថែមទាំង បាន ចូលរួម កែប្រែ ឥរិយាបថ របស់ មនុស្ស ទាំង ក្នុង ជំនាន់ នេះ និង នា ពេល អនាគត ផងដែរ ។
( ត្បូងឃ្មុំ ) ៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ អម ដំណើរ ដោយ រដ្ឋលេខាធិការ ប្រចាំ ការ រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ និង ក្រុមការងារ បច្ចេកទេស ក្រសួង នា ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ ចុះ ត្រួតពិនិត្យ វឌ្ឍនភាព ការងារ សាងសង់ ស្ពាន ចំនួន ៣កន្លែង នៅ ដំណាក់ ព្រីង កើត ឃុំ មហា លាភ ស្រុក កោះ សូទិន ខេត្ត ត្បូងឃ្មុំ របស់ គម្រោង គ្រប់គ្រង គ្រោះមហន្តរាយ នៅ កម្ពុជា និង អាស៊ី អាគ្នេយ៍ ជំហាន ទី២ ស្ថិត ក្រោម ជំនួយ ហិរញ្ញប្បទាន របស់ ធនាគារ ពិភពលោក ។
ក្នុង ឱកាស ចុះ ត្រួតពិនិត្យ នៅ ការដ្ឋាន ផ្ទាល់ លោក រដ្ឋមន្ត្រី បាន ណែនាំ ដល់ ទីប្រឹក្សា និង អ្នក អនុវត្ត គម្រោង ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ ដោយ អនុវត្ត តាម បទដ្ឋាន បច្ចេកទេស និង ជំរុញ ការងារ សាងសង់ ឱ្យ ទាន់ ផែនការគ្រោងទុក ។
បន្ទាប់មក លោក រដ្ឋមន្ត្រី និង ប្រតិភូ អម ដំណើរ បាន បន្ត ចុះ ពិនិត្យ វឌ្ឍនភាព ផ្លូវ ជួសជុល បន្ទាន់ លើ កំណាត់ ផ្លូវ ១ខ្សែ ប្រវែង ៨គីឡូម៉ែត្រ ស្ថិត នៅក្នុង ស្រុក ស៊ីធរ កណ្តាល ខេត្ត ព្រៃវែង ដែល ទទួលរង ការខូចខាត ធ្ងន់ធ្ងរ ដោយសារ ជំនន់ ទឹកភ្លៀង ។
គួរ បញ្ជាក់ ថា នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ២២ ខែតុលា នេះ យោធា អ៉ី ស្រាអែល បាន រាយការណ៍ ពី ការប៉ុនប៉ង វាយប្រហារ ដោយ ប្រើប្រាស់ មីស៊ីល ប្រឆាំង រថក្រោះ ឆ្ពោះ ទៅកាន់ តំបន់ Avivim របស់ អ៉ី ស្រាអែល ស្ថិត នៅ តាម បណ្ដោយ ព្រំដែន ជាមួយ លី បង់ ។ ប៉ុន្តែ ការវាយប្រហារ នេះ ត្រូវបាន ទប់ស្កាត់ ទាន់ ពេល វេលា ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម ជា ម ចន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន ផ្ញើ សារលិខិត ជូន ពរ ឯកឧត្តម កិត្តិ សេដ្ឋា បណ្ឌិត ជា ម យៀប អនុប្រធាន ទី១ រដ្ឋសភា កម្ពុជា នៅក្នុង ឱកាស ខួប ចម្រើន ជន្មាយុ គម្រប់ ៧៧ ឈានចូល ៧៨ ឆ្នាំ នា ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៨២ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៨២ នាក់ នោះ មាន ៦៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៨ករណី និង ជនសង្ស័យ ១៤នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ០៩ ករណី ។
ប្រជាពលរដ្ឋ ៧៧៩ នាក់ នៅ ស្រុក ស្វាយ ជ្រំ ទទួលបាន ការពិនិត្យ និង ព្យាបាល ជំងឺ ឥត គិត ថ្លៃ ពី ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី សហការ ជាមួយ ក្រុម គ្រូពេទ្យ មន្ទីរ សុខាភិបាល ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី និង ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត មន្ទីរ សុខាភិបាល នៃ រដ្ឋបាល ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន បន្ដ ចុះ ពិនិត្យ និង ព្យាបាល ជំងឺ ដោយ ឥត គិត ថ្លៃ ជូន ប្រជាពលរដ្ឋ នៅ ឃុំ បាសាក់ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង បាន ចំនួន ៧៧៩ នាក់ ក្នុង នោះ ស្ត្រី ៤៧៨ នាក់ ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក វេជ្ជបណ្ឌិត គុជ ស៊ី ថា ប្រធាន មន្ទីរ សុខាភិបាល ស្វាយរៀង និង ជា ប្រធាន ប្រតិបត្តិ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី សាខា ខេត្ត ស្វាយរៀង តំណាង លោក លេង ផាលី ប្រធាន ប្រតិបត្តិ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ថ្នាក់ កណ្តាល និង លោកស្រី ហ៑ុត ចាន់ បូរ៉ា អភិបាល រង ស្រុក ស្វាយ ជ្រំ លោក រៀម ស៊ីណា ប្រធាន ស្ដីទី ការិយាល័យ រដ្ឋបាល បុគ្គលិក មន្ទីរ សុខាភិបាល ខេត្ត ព្រមទាំង អាជ្ញាធរដែនដី ជាច្រើន នាក់ ផងដែរ ។
លោក រៀម សុី ណា ប្រធាន ស្ដីទី ការិយាល័យ រដ្ឋបាល បុគ្គលិក មន្ទីរ សុខាភិបាល ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង ថា ថ្ងៃ នេះ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី សាខា ខេត្ត ស្វាយរៀង មាន ចំនួន ៦៨ នាក់ ស្ត្រី ២៨ នាក់ បាន ចុះ ពិនិត្យ និង ព្យាបាល ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ នៅ ឃុំ បាសាក់ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង ដែល ជា ការគិតគូរ របស់ លោក ហ៊ុន ម៉ានី ប្រធាន ស .ស .យ . ក និង ជា ប្រធាន កិត្តិយស ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រ លោក ហ៊ុន ម៉ានី ។
លោក រៀម សុី ណា បាន បញ្ជាក់ ថា បើ មាន អ្នកជំងឺ ធ្ងន់ ដែល មិន អាច ព្យាបាល នៅ កន្លែង បាន ទេ ក្រុមការងារ យើង នឹង បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ ខេត្ត ដោយ ឥត គិត ថ្លៃ ផងដែរ ។
ក្នុង ឱកាស នោះ លោក វេជ្ជបណ្ឌិត គុជ សុី ថា ក៏ បាន ថ្លែង នូវ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក ពីសំណាក់ សម្ដេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ស្វាយរៀង និង លោក ប៉េង ពោធិ៍សា អភិបាល ខេត្ត ស្វាយរៀង ដែល ជានិច្ចកាល សម្ដេច ម៉ែន សំអន និង លោក អភិបាល ខេត្ត តែងតែ នឹករលឹក ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ នៅ ខេត្ត ស្វាយរៀង ហើយក៏ បាន ផ្ដាំផ្ញើ ឱ្យ ថែរក្សា សុខភាព ឱ្យ បាន ល្អ ព្រោះ សុខភាព គឺជា កត្តា ចម្បង មួយ សម្រាប់ ជីវភាព ការរស់នៅ ប្រចាំ ថ្ងៃ ។
លោក វេជ្ជបណ្ឌិត បាន បញ្ជាក់ ថា ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត ហ៊ុន ម៉ានី សាខា ខេត្ត ស្វាយរៀង តែងតែ ចុះ ព្យាបាល ជូន ប្រជាពលរដ្ឋ នៅ តាម បណ្ដា ស្រុក ក្រុង នានា នៃ ខេត្ត ស្វាយរៀង បានជា បន្តបន្ទាប់ ហើយ និង បន្ត ចុះ ព្យាបាល ឲ្យ បាន ញឹកញាប់ ជូន ប្រជាពលរដ្ឋ ឲ្យ បន្ថែម ទៀត ជាពិសេស ប្រជាពលរដ្ឋ ដែល នៅ ដាច់ស្រយាល ពី ទី រួម ខេត្ត ដែល ឆ្ងាយ ពី មន្ទីរពេទ្យ ។
ជាមួយគ្នា នេះ លោក អភិបាល ស្រុក ក្នុង នាម រដ្ឋបាល ស្រុក ទឹក ឈូទាំងមូល ក៏ បាន ចុះ ជួប សំណេះសំណាល ជាមួយ ក្រុម កីឡាករ ប្រណាំង ទូក (ង ) ដែល កំពុង ហ្វឹកហាត់ នៅ ទីតាំង សហគមន៍ ត្រពាំង សង្កែ ជារៀងរាល់ ថ្ងៃ ដែល ត្រៀម ចូលរួម ប្រកួត ក្នុង ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ ។
នៅក្នុង កិច្ចប្រជុំ សាមញ្ញ លើក ទី ៥៣ របស់ ក្រុមប្រឹក្សា ខេត្ត កំពត កាលពី ថ្ងៃទី ២០ ខែតុលា ឆ្នាំ ២០២៣ លោក បណ្ឌិត ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត បាន មានប្រសាសន៍ ថា បើ មិន មាន ការប្រែប្រួល ទេ នោះ រដ្ឋបាល ខេត្ត កំពត បាន សម្រេច ជ្រើសរើសយក ថ្ងៃទី ១០ - ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ដើម្បី ប្រារព្ធ ពិធី ប្រណាំង ទូក (ង ) ខ្នាត ប្រពៃណី ដែល ធ្វើឡើង នៅ តាម បណ្ដោយ ឆ្នេរ ព្រែក កំពង់បាយ នៅមុខ សាលា ខេត្ត កំពត ចាស់ តែម្តង ។
ចំពោះ ខេត្ត កំពត បាន ធ្វើ ការប្រណាំង ទូក ចំនួន ២លើក រួច មកហើយ នៅក្នុង ឆ្នាំ ២០២២ កន្លងទៅ ដោយ លើក ទី១ គឺ ប្រណាំង ទូក (ង ) ខ្នាត ប្រពៃណី និង លើក ទី២ ប្រណាំង ទូក នេសាទ ហើយ សម្រាប់ ឆ្នាំ នេះ ខេត្ត កំពត គឺ ធ្វើ ការប្រណាំង ទូក (ង ) ខា្នត ប្រពៃណី ដើម្បី អបអរសាទរ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក អក អំបុក សំពះ ព្រះខែ និង បណ្តែត ប្រទី ប ដែល មាន រយៈពេល ២ ថ្ងៃ ក្នុង ព្រឹត្តិការណ៍ នេះ ដែរ ក៏ មាន ការប្រគុំតន្ត្រី ការបាញ់ កាំជ្រួច និង ការតាំងពិពរណ៌ « ភូមិ មួយ ផលិតផល មួយ » ផងដែរ ៕
ផលវិបាក ផ្តើម ចេញ ពី ព្រឹត្តិការណ៍ ថ្ងៃទី ៧តុលា នាំ បាន ធ្វើឱ្យ គេ ឃើញ កើតមាន ភាព រកាំ រកូស នៅ តាម ព្រំដែន លី បង់ - អ៊ីស្រាអែល ដែល ជា កន្លែង ក្រុម ហេស បូឡា និង អ៊ីស្រាអែល តែង ប៉ះ ចាប់តាំងពី សង្រ្គាម បាន ចាប់ផ្តើម … ហើយ សភាពការណ៍ អាក្រក់ នោះ វា ក៏ កំពុងតែ រំកិល ទាញ តំបន់ ឱ្យ ឈាន ទៅ រក គ្រោះថ្នាក់ ដែល គេ នឹង មិន អាច ស្មាន ដល់ ។
គេ នៅ មិន ទាន់ ដឹង ថា តើ ក្រុម ហេស បូឡា នឹង ធ្វើ អន្តរាគមន៍ ក្នុង សង្គ្រាមហា ម៉ាស់ - អ៊ីស្រាអែល ក្នុង នាម ប៉ាឡេ ស្ទីន ឬ យ៉ាងណា នោះ ឡើយ ។ ម៉្យាង វិញ ទៀត ក្រុម ហេស បូឡា បាន បង្ហាញ ការឈឺឆ្អាល របស់ ខ្លួន ក្នុង ការជួយ គោលដៅ ចុងក្រោយ របស់ ក្រុមហា ម៉ាស ក្នុង ការបំផ្លាញ រដ្ឋ ជ្វីហ្វ របស់ អ៊ីស្រាអែល ។ ម្យ៉ាង វិញ ទៀត ក្រុម ហេស បូឡា ក៏ គ្មាន អ្វី ដែល ត្រូវបាត់បង់ ផងដែរ ។
លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន លើកឡើង ថា កម្មវិធី សប្តាហ៍ ការទូត បៃតង សហភាព អឺរ៉ុប - អាស៊ាន នេះ បាន ផ្តល់ ជា វេទិកា ដ៏ មាន អត្ថន័យ មួយ ដើម្បី បញ្ជាក់ ពី សារៈសំខាន់ នៃ កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ និង ការទូត ក្នុង ការដោះស្រាយ បញ្ហា បរិស្ថាន និង ចូលរួម គាំទ្រ ដល់ សកម្មភាព ដែល ធ្វើឱ្យ ពេល អនាគត គ្មាន សំណល់ ប្លាស្ទិក និង ការរស់នៅ ប្រកបដោយ និរន្តរភាព ជាពិសេស ក្នុង បុព្វហេតុ សុក្រឹតកម្ម បរិស្ថាន កិច្ច ។
លោក រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន លើកទឹកចិត្ត ឱ្យ អ្នក ទាំងអស់ គ្នា ចូលរួម គាំទ្រ ដល់ គំនិត ផ្តួចផ្តើម ទាំង នេះ និង បន្ត ជំរុញ ការចូលរួម ពី មូលដ្ឋាន ក្នុង ការកាត់បន្ថយ សំណល់ បាស្ទិក សំដៅ លើកកម្ពស់ ការអភិវឌ្ឍ ដោយ ចីរភាព និង ឆ្លើយតប ទៅនឹង ការប្រែប្រួល អាកាសធាតុ ។
លោក រដ្ឋមន្ត្រី មាន ជំនឿ ជឿជាក់ ថា តាមរយៈ កិច្ច ខិតខំ ប្រឹងប្រែង និង ការតាំងចិត្ត របស់ យើង ទាំងអស់ គ្នា យើង នឹង អាច ការពារ ទន្លេ មេគង្គ និង ធានា បាន ថា ទន្លេ មេគង្គ នៅតែ បន្ត ហូរ ដែល ជា និមិត្តរូប នៃ ក្តីសង្ឃឹម និង ជីវិត សម្រាប់ មនុស្សជាតិ ទាំង ពេល បច្ចុប្បន្ន និង ជំនាន់ ក្រោយ ។
ជាមួយគ្នា នេះ ដែរ នៅក្នុង កម្មវិធី សប្តាហ៍ ការទូត បៃតង សហភាព អឺរ៉ុប - អាស៊ាន ក៏ មាន ពិធី ដាំ ដើមឈើ នៅក្នុង សាលា បឋមសិក្សា ជ្រោយ ចង្វារ ផងដែរ ។
( ម៉ានីល) ៖ ហី្វលីពីន នៅ ថ្ងៃអាទិត្យ ទី ២២ ខែតុលា នេះ បាន ចោទប្រកាន់ ថា នាវា ឆ្មាំ សមុទ្រ ចិន មួយ គ្រឿង បាន បើក បំបុក ជាមួយ ទូក ដឹក ស្បៀង មួយ គ្រឿង របស់ ខ្លួន ដែល កំពុង ធ្វើដំណើរ នាំយក ស្បៀង ទៅ ផ្គត់ផ្គង់ ទាហាន ប្រចាំ ការ នៅលើ ខ្មោច នាវា ចម្បាំង មួយ នៅក្នុង តំបន់ ជម្លោះ សមុទ្រ ចិន ខាងត្បូង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP ។
( ចិន ) ៖ ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល អនុប្រធាន ទី១ នៃ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បន្ទាប់ពី បញ្ចប់ បេសកកម្ម អម ដំណើរ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ចូលរួម វេទិកា « ខ្សែក្រវាត់ និង ផ្លូវ » ហើយ នោះ មិន ទាន់ បាន ត្រឡប់មក កម្ពុជា វិញ នោះ ទេ ។ លោក ឧប នាយក រដ្ឋមន្ត្រី បន្ត ដំណើរ ចុះ តាម បណ្តា ក្រុមហ៊ុន ធំ ៗ របស់ ចិន ដើម្បី បញ្ចុះបញ្ចូល និង លើកទឹកចិត្ត ឱ្យ មក ពួកគេ មក វិនិយោគ នៅ កម្ពុជា ។
ម ជ្ឍ មណ្ឌល GICI ជា មជ្ឈមណ្ឌល ផ្តល់ កិច្ច គាំពារ ផ្នែក ធ្វើ ធុរកិច្ច ជាពិសេស ការធ្វើ ធុរកិច្ច ថ្មី ៗ ។ តាមរយៈ ការគាំទ្រ និង កិច្ច គាំពារ របស់ មជ្ឍ មណ្ឌល នេះ បាន ជួយ ឱ្យ ធុរកិច្ច ថ្មី ចំនួន ១២ ទទួល ជោគជ័យ រហូតដល់ មាន លទ្ធភាព អាច បោះ ភាគហ៊ុន លើ ទីផ្សារ ភាគហ៊ុន ថែម ទៀត ផង ។
ក្នុង ដំណើរទស្សនកិច្ច នៅ មជ្ឈមណ្ឌល នេះ ក្រុមហ៊ុន បាន ធ្វើ បទបង្ហាញ អំពី ការងារ មួយចំនួន ជូន គណៈប្រតិភូ កម្ពុជា ដើម្បី បាន ជ្រាប ។ ក្នុង នោះ លោក ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ជម្រាប ជូន ក្រុមហ៊ុន អំពី ការលើកទឹកចិត្ត ខ្ពស់ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា លើ កិច្ចការងារ ធុរកិច្ច ថ្មី នេះ តាមរយៈ ការបើក ឱកាស ឱ្យ មាន កិច្ចសហប្រតិបត្តិការ វិនិយោគ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បាន លើកទឹកចិត្ត ឱ្យ ក្រុមហ៊ុន សិក្សា លើ ការបណ្ដាក់ទុន វិនិយោគ នៅ កម្ពុជា ព្រមទាំងអញ្ជើញ ក្រុមហ៊ុន ចុះ មក ទស្សនកិច្ច នៅ កម្ពុជា ដោយ ផ្ទាល់ ដើម្បី ស្វែងយល់ ឱ្យ កាន់តែ ច្បាស់ រាល់ សក្ដានុពល របស់ កម្ពុជា ។
( ភ្នំពេញ ) ៖ ស្វាយ គឺជា ដំណាំ កសិឧស្សាហកម្ម មាន សក្តានុពល មួយ របស់ កម្ពុជា ដែល រាជ រដ្ឋា បាល បាន និង កំពុង ជំរុញ ការនាំចេញ ទៅកាន់ ទីផ្សារ អន្តរជាតិ ជាពិសេស ទៅកាន់ ប្រទេស ចិន និង កំពុង បង្កើន ចំណែក ទីផ្សារ និង ចាប់ យក ទីផ្សារ ថ្មី ៗ ។
កម្ពុជា បាន ចាប់ផ្តើម នាំចេញ ផ្លែ ស្វាយ ស្រស់ ទៅកាន់ ប្រទេស ចិន ជា លើក ដំបូង កាលពី ឆ្នាំ ២០២១ បន្ទាប់ពី ពិធីសារ ស្តីពី លក្ខខណ្ឌ តម្រូវការ ភូត គាម អនាម័យ សម្រាប់ នាំចេញ ស្វាយ ស្រស់ កម្ពុជា ទៅកាន់ ប្រទេស ចិន ត្រូវបាន ចុះហត្ថលេខា នៅ ខែមិថុនា ឆ្នាំ ២០២០ រវាង ក្រសួង កសិកម្ម និង អគ្គ រដ្ឋបាល គយ ចិន (GACC) ។
ការនាំចេញ ផ្លែ ស្វាយ ស្រស់ ទៅកាន់ ទីផ្សារ ប្រទេស ចិន គឺជា ឱកាស ដ៏ មាន តម្លៃ សម្រាប់ កសិករ ដាំដុះ ស្វាយ នៅ កម្ពុជា ។
ក្នុង ការពង្រីក ទីផ្សារ នាំចេញ ផ្លែ ស្វាយ ស្រស់ ទៅកាន់ ទីផ្សារ ប្រទេស ចិន បន្ថែម អគ្គ នាយកដ្ឋាន កសិកម្ម បាន ប្រាប់ ពី និតិវិធី ៤ ជំហាន ដែល វិនិយោគ លើ ការដាំដុះ និង នាំចេញ ស្វាយ ត្រូវ យល់ដឹង ជាពិសេស អ្នកនាំចេញ ថ្មី ៗ ។
* ជំហាន ទី១ - ការចុះបញ្ជី អ្នក ដាំដុះ ស្វាយ និង ទីតាំង វេចខ្ចប់ ជាមួយ អគ្គ នាយកដ្ឋា កសិកម្ម៖
* ជំហាន ទី២ - វិញ្ញាបនបត្រ និង ស្តង់ដា រ៖ ផ្លែ ស្វាយ ស្រស់ ដែល អាច នាំចេញ ទៅកាន់ ប្រទេស ចិន បាន លុះត្រាតែ មាន ការត្រួតពិនិត្យ គុណភាព និង ទទួលបាន វិញ្ញាបនបត្រ ភូត គាម អនាម័យ ពី នាយកដ្ឋាន ការពារ ដំណាំ អនាម័យ និង ភូត គាម អនាម័យ អគ្គ នាយកដ្ឋាន កសិកម្ម នៃ ក្រសួង កសិកម្ម ។
ជាមួយគ្នា នេះ ប្រទេស ចិន ក៏ ត្រូវការភ័ស្តុតាង ដើម្បី ផ្ទៀងផ្ទាត់ ថា គ្មាន ផលិតផល ណា ដែល មាន សមាសភាព ចង្រៃ ហើយ ពួកគេ នឹង ត្រូវការ ព័ត៌មាន ផ្សេង ទៀត អំពី ផលិតផល ដូចជា ការធ្វើ ប្រព្រឹត្តកម្ម ចំហាយ ទឹក ក្តៅ ឬ ការធ្វើ ប្រព្រឹត្តកម្ម ទឹក ក្តៅ មុនពេល នាំចេញ ។ អ្នកនាំចេញ ត្រូវតែ ផ្ដល់ ឯកសារ បន្ថែម ដើម្បី បញ្ជាក់ អំពី បញ្ហា នេះ តម្រូវ មាន ភាព ខុសគ្នា ពី ផលិតផល មួយ ទៅ ផលិតផល មួយ ផ្សេង ទៀត ។
ដើម្បី ទទួលបាន វិញ្ញាបនបត្រ ភូត គាម អនាម័យ ពី នាយកដ្ឋាន ការពារ ដំណាំ អនាម័យ និង ភូត គាម អនាម័យ ន អគ្គ នាយកដ្ឋាន កសិកម្ម នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ត្រូវ ចំណាយ ពេល ពី ១០ ម៉ោង ទៅ ១២០ ម៉ោង ទើប ទទួលបាន វិញ្ញាបនបត្រ ។
ចំណុច សំខាន់ មួយ ទៀត អ្នកនាំចេញ ត្រូវតែ មាន លិខិត បញ្ជាក់ ប្រភព ដើម ទំនិញ ដែល ជា ឯកសារ សំខាន់ ប្រើ ក្នុង ពាណិជ្ជកម្ម អន្តរជាតិ ដើម្បី បញ្ជាក់ ថា ទំនិញ ដែល ផលិត នៅក្នុង ប្រទេស កម្ពុជា ជា កន្លែង ត្រូវបាន នាំចេញ ។ សម្រាប់ លិខិត នេះ អ្នកនាំចេញ ទៅ ស្នើសុំ ពី ក្រសួង ពាណិជ្ជកម្ម ។ សម្រាប់ លិខិត បញ្ជាក់ ប្រភព ដើម ទំនិញ ដែល មាន សុពលភាព គឺ ត្រូវតែ ចុះហត្ថលេខា ដោយ អ្នកនាំចេញ និង ក្រសួង ពាណិជ្ជកម្ម ។
* ជំហាន ទី៤ - ការដឹកជញ្ជូន ផ្លែ ស្វាយ និង ការទូទាត់ ប្រាក់
ផលិតផល ដែល មាន គោលដៅ សម្រាប់ ទីផ្សារ នាំចេញ ទាមទារ ឱ្យ ប្រអប វេចខ្ចប់ ដែល មាន ភាពរឹង ។ ហើយ ផលិតផល ដែល ត្រូវបាន ដឹកជញ្ជូន តាម ផ្លូវ អាកាស តម្រូវ ឱ្យ មាន ការវេច ខ្ចប់ ទំហំ កញ្ចប់ និង អ៊ីសូឡង់ ពិសេស ។ សម្បក វេចខ្ចប់ ត្រូវតែ បង្ហាញ និង ផ្តល់ ព័ត៌មាន ដែល មាន ប្រយោជន៍ អំពី ផលិតផល ។ ជា ទី ទៅ ព័ត៌មាន ដែល ត្រូវ ផ្តល់ មាន ដូចជា ឈ្មោះ ផលិតផល យីហោ ទំហំ ចំណាត់ថ្នាក់ ពូជ ទម្ងន់ ចំនួន ឯកតា អ្នក ដាំដុះ អ្នក ដាំជញ្ជូន និង ប្រទេសជា អ្នកផលិត ។
បច្ចុប្បន្ន នេះ ផ្លូវ ដឹកជញ្ជូន ដោយ ផ្ទាល់ ពី ប្រទេស កម្ពុជា ទៅកាន់ ប្រទេស ចិន នៅ មាន កម្រិត ប្រទេស កម្ពុជា មិន មាន ព្រំដែន ជាប់ ជាមួយ ប្រទេស ចិន ទេ ហើយ ជា លទ្ធផល ប្រទេស កម្ពុជា ត្រូវ ពឹងផ្អែក លើ កំពង់ផែ ទីក្រុង ហូជីមិញ ដែល ជា មជ្ឈមណ្ឌល ដឹកជញ្ជូន ផ្លែ ឈើ របស់ ខ្លួន ទៅកាន់ ប្រទេស ចិន ។
ផ្លូវ សំខាន់ ៗ នៃ ការដឹកជញ្ជូន ផ្លូវការ ចំនួន ៤ សម្រាប់ ការដឹកជញ្ជូន ផ្លែ ស្វាយ ស្រស់ ទៅ ប្រទេស ចិន មាន ដូចជា ផ្លូវគោក ផ្លូវ សមុទ្រ ផ្លូវ ទន្លេ និង ផ្លូវ អាកាស ។ តម្លៃ សម្រាប់ ការដឹកជញ្ជូន តាមរយៈ ផ្លូវ ទាំង៤ នេះ មាន ភាពខុសគ្នា ច្រើន ។ ជម្រើស ដឹកជញ្ជូន និង ផ្លូវ ចំនួន បួន មាន ដូច ខាងក្រោម៖
សេវា ដឹកជញ្ជូន តាម សមុទ្រ៖ ពី ភ្នំពេញ - ព្រះសីហនុ - ក្រុង សៀងហៃ ។ បច្ចុប្បន្ន ផ្លូវ នេះ ត្រូវ ចំណាយ ពេល ១៤ ថ្ងៃ ហើយ តម្រូវ ឱ្យ ឈប់ នៅ កំពង់ផែ មួយ ផ្សេង ទៀត នៅ តាម ផ្លូវ ។
