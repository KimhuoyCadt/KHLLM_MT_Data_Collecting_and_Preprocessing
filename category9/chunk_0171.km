( ភ្នំពេញ ) ៖ លោក ឡាវ វ៉ាន់ រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោក Wang Peng លេខាទី១ នៃ ស្ថានទូត ចិន ប្រចាំ កម្ពុជា នា ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ជួប សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ នៃ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ចំនួន ០៨ រូប ដែល ត្រៀម ចេញ ទៅ សិក្ខាសាលា នៅ ប្រទេស ចិន ចំនួន ២ទីតាំង ផ្សេង គ្នា ដើម្បី ទទួលយក ចំណោះ ដឹង បន្ថែម មក ចូលរួម អនុវត្ត គោល នយោបាយ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល នៅ ទីស្តីការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
លើកឡើង នា ឱកាស នោះ លោក ឡាវ វ៉ាន់ បាន លើកទឹកចិត្ត ដល់ មន្ត្រីរាជការ ដែល នឹង ទៅ ចូលរួម សិក្ខាសាលា ឱ្យ ខិតខំ ប្រមូល យក ធាតុ ចូល និង បទពិសោធន៍ ល្អ ៗ ពី មិត្ត ចិន ដោយ ផ្តោត លើ ការអភិវឌ្ឍ បៃតង ស្រប តាម គោលដៅ អភិវឌ្ឍ ប្រកបដោយ ចីរភាព របស់ អង្គការ សហ ប្រជាជាតិ ឆ្នាំ ២០៣០ ហើយ កាលានុវត្ត ដែល មន្ត្រីរាជការ ទាំង ៤រូប ទទួលបាន ក្នុង សិក្ខាសាលា លើក នេះ គឺជា ទិសដៅ មួយ ដែល លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
លោក ស យីលីន ប្រធាន នាយកដ្ឋាន អង្កេត និង បូកសរុប នៃ អគ្គ នាយកដ្ឋាន ភស្តុភារកម្ម ក្នុង នាម គណៈប្រតិភូ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ដែល ទៅ ចូលរួម វគ្គ សិក្ខាសាលា នេះ បាន បង្ហាញ នូវ ការប្តេជ្ញាចិត្ត ខ្ពស់ ដើម្បី ស្រូបយក នូវ ពុទ្ធិ និង បទពិសោធន៍ ដែល ទទួលបាន ពី វគ្គ សិក្ខាសាលា នេះ យកមក ចែករំលែក បន្ត ហើយ ចូលរួមចំណែក ពង្រឹង និង ពង្រីក ថែមទាំង នូវ ចំណង ទាក់ទង ជា ប្រពៃណី រវាង ប្រជាជន និង ប្រជាជន នៃ ប្រទេស យើង ទាំង ពីរ កម្ពុជា និង ចិន ថែម ទៀត ផង ។
( ភ្នំពេញ ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ទាញ ការចាប់អារម្មណ៍ ថា ការប្រយុទ្ធ គ្នា រវាង អ៉ី ស្រាអែល និង ហាម៉ាស់ បាន បង្ហាញ ឱ្យ ឃើញ ពី តម្លៃ សុខ សន្តិភាព ដែល ត្រូវ គ្នា ថែរក្សា ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ រួមគ្នា ថែរក្សា ឱ្យ បាន នូវ សុខ សន្តិភាព ហើយ មិន ត្រូវ ឱ្យ ភ្លើង សង្គ្រាម ណាមួយ កើតមាន នៅ កម្ពុជា ជាដាច់ខាត ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូស រំលេច បែប នេះ តាមរយៈ សារ សំឡេង ពិសេស មួយ ផ្ញើ ជូន ប្រជាពលរដ្ឋ ខ្មែរ នា ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។ សារសំឡេង ពិសេស នេះ ជា ការបញ្ជាក់ ពី កិច្ច កិច្ចអន្តរាគមន៍ របស់ រាជ រដ្ឋាភិបាល ចំពោះ និស្សិត និង ពលរដ្ឋ ខ្មែរ កំពុង រស់ នៅ ប្រទេស អ៉ី ស្រាអែល ។
សូម បញ្ជាក់ ថា កាលពី យប់ ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ កន្លងទៅ នេះ ក្រុមហា ម៉ាស់ បាន លប បើក ការវាយប្រហារ ចូល ទឹកដី អ៉ី ស្រាអែល បណ្តាល កងកម្លាំង និង ជន ស៊ីវិល របស់ អ៉ី ស្រាអែល ជាច្រើន នាក់ បាន ស្លាប់ ។ ក្នុង នោះ មាន និស្សិត ខ្មែរ និង ប្រជាពលរដ្ឋ ប្រទេស ដទៃ កំពុង រស់ នៅ និង ធ្វើការ នៅ អ៉ី ស្រាអែល បាន ស្លាប់ ផងដែរ ។
ក្រៅពី នោះ ជនជាតិ អ៉ី ស្រាអែល និង ជន បរទេស ជាច្រើន នាក់ ត្រូវបាន ចាប់ ធ្វើជា ចំណាប់ខ្មាំង ផងដែរ ៕ អភិបាល ខេត្ត កំពង់ឆ្នាំង បញ្ជា ឱ្យ នគរបាល ខេត្ត ស្រាវជ្រាវ និង វែក មុខ រក អ្នក ពាក់ព័ន្ធ បទល្មើស នេសាទ ធំ ៗ យកមក ផ្ដន្ទាទោស តាម ច្បាប់
( កំពង់ឆ្នាំង ) ៖ បទល្មើស នេសាទ នៅតែ បន្ត កើតមាន នៅ តាម បណ្តា ភូមិសាស្ត្រ មួយចំនួន ក្នុង ខេត្ត កំពង់ឆ្នាំង ដែល ក្រុម ជន ខិលខូច នៅតែ បន្ត លួច ធ្វើ សកម្មភាព បើ ទោះបី មន្ត្រី ជំនាញ និង សមត្ថកិច្ច បាន និង កំពុង បន្ត ចុះ រុះរើ កាប់បំផ្លាញ ចោល ជា បន្តបន្ទាប់ ជារៀងរាល់ ថ្ងៃ យ៉ាងណា ក៏ដោយ ។
ជាក់ស្ដែង ចាប់ពី ថ្ងៃទី ៧ - ៩ ខែតុលា ឆ្នាំ ២០២៣ មន្ត្រី ជំនាញ រដ្ឋបាល ជលផល បាន សហការ ជាមួយ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ស្រុក និង ខេត្ត ចុះ រុះរើ កាប់បំផ្លាញ ចោល នូវ ឧបករណ៍ នេសាទ ល្មើស ច្បាប់ អស់ ជាច្រើន នៅក្នុង ភូមិសាស្ត្រ ស្រុក កំពង់លែង និង ស្រុក ជល់ គិរី ។
ជា លទ្ធផល កម្លាំង ចម្រុះ បាន រុះរើ និង កាប់បំផ្លាញ ចោល នូវ ឧបករណ៍ នេសាទ ល្មើស ច្បាប់ អស់ ជាច្រើន ដូចជា របាំង ស្បៃ មុង និង របាំង សាច់ អួន រាប់ ពាន់ ម៉ែត្រ និង លប លូ រួមទាំង បង្គោល របាំង ធ្នួស រាប់ រយ ដើម យកមក ដុត បំផ្លាញ ចោល ដោយ មិន ទុក ឱ្យ ប្រើប្រាស់ បាន ទៀត នោះ ឡើយ ។
ករណី នេះ លោក ស៊ុន សុវណ្ណា រិទ្ធិ អភិបាល ខេត្ត កំពង់ឆ្នាំង បាន បញ្ជាក់ ឱ្យដឹង ថា « សមត្ថកិច្ច ចម្រុះ យើង ពិតជា មាន ការហត់ នឿយ ចំពោះ ការចុះបង្ក្រាប បទល្មើស នេសាទ ស្ទើរ ជារៀងរាល់ ថ្ងៃ ។ យើង ត្រូវ ប្រើប្រាស់ កម្លាំ ង សរុប ច្រើន នាក់ និង ត្រូវ ចំណាយ ប្រេង ចុះបង្ក្រាប ម្ដង ៗ ច្រើន រយ លីត្រ ថែម ទៀត តែ បទល្មើស នេសាទ នៅតែ កើតមាន មិន ចេះ អស់ » ។
លោក បាន គូសបញ្ជាក់ ថា ក្នុង ឱកាស ដែល ប្រជាពលរដ្ឋ ធ្វើដំណើរ តាម ដងផ្លូវ កាន់តែ ម មារ ញឹក នោះ . គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ជា បញ្ហា គួ អោយ ព្រួយបារម្ភ ចំពោះ សោកនាដកម្ម នេះ ហើយ មូលហេតុ ចម្បង ដែល បង្កឱ្យ មាន គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ នោះ គឺ មកពី មនុស្ស ម្នាក់ ៗ ដែល មិន គោរព ច្បាប់ ចរាចរណ៍ ក្នុង នោះ មាន ដូច ជា៖ ការបើកបរ លើស ល្បឿន កំណត់ ការ មិន គោរព សិទ្ធិ អាទិភាព មិន គោរព សញ្ញា ចរាចរណ៍ មិន ពាក់ មួក សុវត្ថិភាព ត្រឹមត្រូវ ការវ៉ា ជែង ក្នុង ស្ថានភាព គ្រោះថ្នាក់ និង ការបើកបរ ក្នុង ពេល ស្រវឹង ជាដើម ។
លោក បាន បន្ត ថា ទន្ទឹមនឹង បញ្ហា គ្រោះថ្នាក់ ចរាចរណ៍ បញ្ហា ដែល បង្កឡើង ដោយ ការប្រែប្រួល អាកាសធាតុ ក៏ ជា រឿង ដែល យើង ត្រូវ យកចិត្តទុកដាក់ ក្នុង ការដោះស្រាយ ទាំងអស់ គ្នា ដែរ ។ ក៏ប៉ុន្តែ បញ្ហា ទាំងអស់ នេះ យើង អាច ចូលរួម ទប់ស្កាត់ កាត់បន្ថយ និង ត្រៀម បង្ការ បាន តាមរយៈ ការចូលរួម អនុវត្ត ច្បាប់ របស់ ពលរដ្ឋ ម្នាក់ ៗ ។ ហេតុ ដូចនេះ ភារកិច្ច របស់ យើង គឺ ចុះ អប់រំ ផ្សព្វផ្សាយ លើកទឹកចិត្ត ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ យើង ឱ្យ ចូលរួម អនុវត្ត ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ទាំងអស់ គ្នា ។
ក្រុមការងារ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ មេត្តា យោគយល់ ចំពោះ ការប្រកាន់ យក វិធានការ ច្បាប់ ដ៏ តឹងរឹង ចំពោះ បទល្មើស ចរាចរណ៍ ផ្លូវគោក ។ ដើម្បី ចៀសវាង ពី ការប្រឈម ចំពោះ ផ្លូវ ច្បាប់ សូម ប្រជាពលរដ្ឋ គោរព អនុវត្ត ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ឱ្យ បាន ខ្ជាប់ ខ្លួន ដើម្បី ការពារ អាយុជីវិត ខ្លួន ឯង ផ្ទាល់ ដើម្បី ភាពសុខដុមរម្យ នា ក្នុង ក្រុមគ្រួសារ ដើម្បី ការពារ ទ្រព្យសម្បត្តិ របស់ ប្រជាពលរដ្ឋ និង ដើម្បី រួមគ្នា លើកកម្ពស់ កិត្តិយស សេចក្តីថ្លៃថ្នូរ របស់ ប្រទេសជាតិ ។
សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង សង្ឃឹម ជឿជាក់ លើ អ្នកប្រើប្រាស់ ផ្លូវ គ្រប់ រូប នឹង ចូលរួម គោរព អនុវត្ត ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ក៏ ដូចជា អនុវត្ត តាម សេចក្តី អំពាវនាវ នេះ ដើម្បី នាំមក នូវ សុវត្ថិភាព និង សេចក្តីសុខ ក្នុង ឱកាសង ថ្ងៃ ឈប់សម្រាក ការងារ ខាងមុខ នេះ និង បន្ត ជារៀងរហូត ទៅ ។
( ព្រៃវែង ) ៖ ក្នុង ឱកាស ដែល ប្រជាពលរដ្ឋ ខ្មែរ ជា ពុទ្ធ បរិស័ទ នៅ ទូទាំង ប្រទេស ដែល គោរព ប្រតិបត្តិ ទំនៀមទំលាប់ ប្រកាន់ភ្ជាប់ ប្រពៃណី ព្រះពុទ្ធ សាសនា ហើយ តែងតែ ធ្វើ បុណ្យ ធ្វើ ទាន នៅ គ្រប់ រដូវកាល នៃ ពិធី បុណ្យ នីមួយ ៗ ជារៀងរាល់ ឆ្នាំ នោះ សម្រាប់ ឱកាស នៃ ពិធី បុណ្យ កាន់ បិណ្ឌ ភ្ជុំ បិណ្ឌ ឆ្នាំ ២០២៣ នេះ ។
ជាមួយគ្នា នោះ ដើម្បី ចូលរួមចំណែក និង លើកកម្ពស់ វិស័យ ព្រះពុទ្ធ សាសនា ក្នុង ទី អារាម វត្ត ជា ច លោក វង សូត បាន ប្រគេន ទយ្យ ទាន ទយ្យ វត្ថុ និង គ្រឿង ឧបភោគ បរិភោគ ដល់ ព្រះចៅ អធិការ វត្ត រួម មាន អង្ករ ៦បេ ទឹកក្រូច ២០ កេស ទឹក សុទ្ធ ១០កេស ទឹកដោះគោ ខាប់ ១កេស ធំ ស្ករ សរ១ បេ តែ ៥គីឡូក្រាម ត្រីខ ១កេស ធំ មី ម៉ាម៉ា១ កេស ធំ និង ប៊ី ចេង ១កេស ៕
លោក កែ គឹម យ៉ាន ចុះ ពិនិត្យ គម្រោង ស្តារ ប្រឡាយ រំដោះ ទឹក ជំនន់ និង សំណេះសំណាល ជាមួយ ពលរដ្ឋ នៅ ស្រុក មង្គលបុរី
( បន្ទាយមានជ័យ )៖ លោក កែ គឹម យ៉ាន អ្នកតំណាងរាស្រ្ត ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ មូលដ្ឋាន ខេត្ត បន្ទាយមានជ័យ នា ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ បាន ចុះ ពិនិត្យ គម្រោង កសាង ស្តារ ប្រឡាយ រំដោះ ទឹក ជំនន់ នៅ ស្រុក មង្គលបុរី និង បន្ត ជួប សំណេះសំណាល ប្រជាពលរដ្ឋ នៅ ឃុំ សឿ ស្រុក មង្គលបុរី ខេត្ត បន្ទាយមានជ័យ ។
លោក កែ គឹម យ៉ាន បាន ពាំនាំ ការសួរសុខទុក្ខ ក្តីនឹករលឹក អរគុណ កោតស សើរ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ជូន ចំពោះ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល បន្ត រក្សា បាន សុខ សន្តិភាព និង អភិវឌ្ឍន៍ មូលដ្ឋាន បាន រីកចម្រើន ។
លោក កែ គឹម យ៉ាន បាន បន្ត ថា រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា គិតគូរ ឧត្តម ប្រយោជន៍ ប្រជាពលរដ្ឋ ជា ធំ ដោយ មិន ទុក ប្រជាពលរដ្ឋ ណា ម្នាក់ ជួប ការលំបាក ហើយ មិន បាន ជួយ នោះ ទេ និង បាន អំពាវនាវ ប្រជាពលរដ្ឋ ទាំងអស់ សូម បន្ត ចូលរួម ថែរក្សា សន្តិភាព សុខភាព ហើយ ក្រុមការងារ ទាំងអស់ គ្រប់ ថ្នាក់ ត្រូវ ត្រៀមលក្ខណៈ ប្រុង ជើង ការជួយ រំដោះ ប្រជាពលរដ្ឋ ទៅ ទី ទួល សុវត្ថិភាព ក្នុង ករណី ទឹក ជំនន់ ៕ គ.ជ. ប៖ រយៈពេល ៩ ថ្ងៃ មាន ពលរដ្ឋ ជាង ១០ម៉ឺន នាក់ បាន ចុះឈ្មោះ បោះឆ្នោត ថ្មី (Video inside)
( ភ្នំពេញ ) ៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន ឱ្យដឹង ថា រយៈពេល ៩ ថ្ងៃ នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២៣ ត្រូវនឹង ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នៅ ទូទាំង ប្រទេស មាន ប្រជាពលរដ្ឋ ចំនួន ១០៦. ២៧០ នាក់ បាន ចុះឈ្មោះ បោះឆ្នោត ថ្មី ។
លទ្ធផល បណ្ដោះអាសន្ន ថ្ងៃទី ៩ នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២៣ ត្រូវនឹង ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នៅ ទូទាំង ប្រទេស មាន ដូច ខាងក្រោម៖
* ប្រជាពលរដ្ឋ ចុះឈ្មោះ បោះឆ្នោត ថ្មី មាន ចំនួន ១០៦. ២៧០ នាក់ * អ្នក ដែល នឹង ត្រូវ លុប ឈ្មោះ ចេញ ពី បញ្ជី បោះឆ្នោត មាន ចំនួន ៧៨. ៧៣៣ នាក់ * អ្នក ដែល បាន ស្នើសុំ កែតម្រូវ ទិន្នន័យ មាន ចំនួន ១០. ០៦៩ នាក់ * អ្នក ដែល បាន ផ្ទេរ ទីលំនៅ ចូលក្នុង ឃុំ សង្កាត់ ថ្មី មាន ចំនួន ២១. ៩២៨ នាក់ ។ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២៣ តាម ឃុំ សង្កាត់ ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី១ ដល់ ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០២៣ គិត ទាំង ថ្ងៃសៅរ៍ និង ថ្ងៃអាទិត្យ ។ ដូចនេះ សូម អញ្ជើ ញ៖
ជន ដៃ ដល់ សម្លាប់ ប្រពន្ធ កូន ខ្លួន នៅ ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្ដាល ត្រូវបាន តុលាការ ដាក់ ពន្ធនាគារ អស់ មួយ ជីវិត
នេះ បើ តាម លោក សូ សារិន អ្នកនាំពាក្យ សាលាដំបូង ខេត្ត កណ្ដាល និង លោក ខា ដែនណ អ្នកនាំពាក្យ អយ្យការ អម សាលាដំបូង ខេត្ត កណ្ដាល នៅ ថ្ងៃទី ១០ ខែត លា ឆ្នាំ ២០២៣ នេះ ។
ជនសង្ស័យ សម្លាប់ ប្រពន្ធ - កូន នេះ មាន ឈ្មោះ ម៉ៅ សំអាង ត្រូវបាន ចាប់ខ្លួន នៅ ចំណុច ផ្សារ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ដ បន្ទាយមានជ័យ កាលពី ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
ឈ្មោះ ម៉ៅ សំអាង បាន សម្លាប់ ប្រពន្ធ - កូន ខ្លួន ឯង ដោយ ប្រើ កាំបិត កាប់ ប្រហារ ហើយ កូនស្រី អាយុ ២ខួប បាន ដាច់ ក្បាល ចេញ ពី ខ្លួន យ៉ាង អាណោច អធម ។ ជនសង្ស័យ បាន ធ្វើ កម្មភាព សាហាវ យង់ឃ្នង បែប នេះ កាលពី ថ្ងៃទី ៦ ខែតុលា ឆ្នាំ ២០២៣ នៅ ចំណុច ភូមិ ពោធិស្មាត ឃុំ ជើង កើប ស្រុក កណ្ដាល ស្ទឹង ខេត្ដ កណ្ដាល ។
ជនសង្ស័យ សារភាព ថា បាន ខឹងសម្បា នឹង ប្រពន្ធ និង ចោទ ថា មាន សាហាយ និង មាន កូន ជាមួយ សាហាយ ទើប ឈានដល់ ការសម្លាប់ ចោល ទាំង ២នាក់ តែម្ដង បន្សល់ទុក កូនប្រុស ២នាក់ កំព្រា . ម្ដាយ និង ប្អូន ត្រូវ ស្លាប់ ចោល រីឯ ឪពុក ត្រូវ ជាប់ គុក អស់ មួយ ជីវិត ។ តើ វាសនា កុមារា ទាំង ២នាក់ នឹង ទៅជា យ៉ាងណា ? រឿង នេះ ប៉ះពាល់ សតិអារម្មណ៍ ខ្លាំងក្លា បំផុត ចំពោះ កុមារា ទាំង ២នាក់ នេះ ៕
ការថ្លែង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ប្រកាស ដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ នូវ « យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ » នា ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
សម្ដេច ធិបតី បាន បន្ត ថា ប្រជាពលរដ្ឋ ប្រាកដជា បារម្ភ អំពី ការហេតុផល ការបង់ វិភាគទាន ការជាប់ ពិន័យ និង កាតព្វកិច្ច និង អត្ថប្រយោជន៍ នៃ ការចូលក្នុង ប្រព័ន្ធ ជា មិន ខាន ហើយ ជុំវិញ បញ្ហា នេះ ដែរ គណៈកម្មការ អន្តរ ក្រសួង ដែល រៀបចំ យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ ក៏ បាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ចំពោះ បញ្ហា ទាំងនេះ ដើម្បី ជួយ ប្រជាពលរដ្ឋ ឱ្យ ចំ គោលដៅ និង ឱ្យ អស់ ពី លទ្ធភាព ដែល អាច ធ្វើ ទៅ បាន ។
សម្ដេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន ពន្យល់ ថា « គោល នយោបាយ នេះ ( យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ២០២៣ - ២០២៨ ) មិន មាន ចរិត បង្ខំឱ្យ បងប្អូន ក្រៅ ប្រព័ន្ធ ចូលរួម ចុះបញ្ជី ឡើយ តែ មាន គោលការណ៍ លើកទឹកចិត្ត ឱ្យ មាន ការចុះបញ្ជី តាមរយៈ ការបង្ហាញ ជាក់ស្ដែង នូវ អត្ថប្រយោជន៍ ដើម្បីឱ្យ បងប្អូន ចូលរួម ឱ្យ បាន ច្រើន នៅក្នុង នៅក្នុង ដំណាក់កាល អន្តរការ នេះ » ។
សម្ដេច ធិបតី បាន សង្កត់ធ្ងន់ ថា ការចុះបញ្ជី មក ក្នុង សេដ្ឋកិច្ច ក្នុង ប្រព័ន្ធ នេះ គឺ ដើម្បីឱ្យ រាជ រដ្ឋាភិបាល ទទួលបាន ទិន្នន័យ ច្បាស់លាស់ ងាយស្រួល ក្នុង ការដាក់ចេញ នូវ គោល នយោបាយ ជួយ គាំពារ ឱ្យ បាន ទាន់ ពេលវេលា និង ចំ គោលដៅ ពិសេស ក្នុង គ្រា លំបាក ព្រោះ ប្រជាពលរដ្ឋ កម្ពុជា បាន ជួប ការលំបាក ដូច នៅពេល កូវី ដ១៩ រួច មកហើយ ហើយ តទៅ មុខ ទៀត ក៏ អាច មាន អតិផរណា សេដ្ឋកិច្ច និង បញ្ហា ផ្សេង ៗ ដូច្នេះ រាជ រដ្ឋាភិបាល នឹង កាន់តែ ងាយស្រួល ក្នុង ការជួយគាំពារ ប្រជាពលរដ្ឋ ដែល ប្រកប អាជីវកម្ម នានា ។
គួរ ជម្រាប ថា យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ មាន គោលការណ៍ លើកទឹកចិត្ត និង អនុគ្រោះ ធំ ៗ ដល់ ទៅ ៩ចំណុច ចំពោះ ម្ចាស់ សហគ្រាស ធន់ តូន មធ្យម និង មីក្រូ ប្រសិនបើ ពួក គាត់ ស្ម័គ្រចិត្ត ចុះបញ្ជី ក្នុង សេដ្ឋកិច្ច ក្នុង ប្រព័ន្ធ ក្នុង នោះ រួម មាន៖
ទី១. ផ្ដល់ ការលើកលែងការផាកពិន័យ និង បំណុល ទាំងអស់ នៅក្នុង ឆ្នាំ ២០២៣ - ២០២៨ ចំពោះ សហគ្រាស ធន់ តូន មធ្យម និង មីក្រូ តាមរយៈ ការ មិន បាន បំពេញ អនុលោម ភាព កន្លងមក ។
ទី២. ផ្ដល់ ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ សម្រាប់ សហគ្រាស មីក្រូ ចំពោះ ការចុះបញ្ជី ដោយ ស្ម័គ្រចិត្ត នៅក្នុង ឆ្នាំ ២០២៣ - ២០២៨ តាមរយៈ លើកលែង កម្រៃ ចុះបញ្ជី ពន្ធដារ និង កម្រៃ ធ្វើ បច្ចុប្បន្នភាព ។
ទី៣. ផ្ដល់ ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ សម្រាប់ សហគ្រាស ធន់ តូច ចំពោះ ការចុះបញ្ជី ដោយ ស្ម័គ្រចិត្ត នៅក្នុង ឆ្នាំ ២០២៣ - ២០២៨ តាមរយៈ៖ ១- ការលើកលែង ពិន័យ ទោសទណ្ឌ និង បំណុល ពន្ធ ចំពោះ ការ មិន បាន បំពេញ អនុលោម ភាព កន្លងមក មុន ការចុះបញ្ជី ២ - លើកលែង កម្រៃ ចុះបញ្ជី ពន្ធដារ និង កម្រៃ ធ្វើ បច្ចុប្បន្នភាព នៅពេល ចុះបញ្ជី និង ៣ - ពន្ធ លើ ប្រាក់ ចំណូល ប្រាក់ រំដោះ ពន្ធ លើ ប្រាក់ ចំណូល និង ពន្ធ អប្បបរមា សម្រាប់ រយៈពេល ២ឆ្នាំ ក្រោយ ការចុះបញ្ជី ។
ទី៤. ផ្ដល់ ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ សម្រាប់ សហគ្រាស ធន់ មធ្យម ចំពោះ ការចុះបញ្ជី ដោយ ស្ម័គ្រចិត្ត ក្នុង ឆ្នាំ ២០២៤ - ២០២៥ តាមរយៈ៖ ១- ការលើកលែង ពិន័យ ទោសទណ្ឌ និង បំណុល ពន្ធ ចំពោះ ការ មិន បាន បំពេញ អនុលោម ភាព កន្លងមក មុន ការចុះបញ្ជី និង ២ - លើកលែង ពន្ធ លើ ប្រាក់ ចំណូល ប្រាក់ រំដោះ ពន្ធ លើ ប្រាក់ ចំណូល និង ពន្ធ អប្បបរមា សម្រាប់ រយៈពេល ២ឆ្នាំ ក្រោម ការចុះបញ្ជី ។
ទី៥. ផ្ដល់ ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ សម្រាប់ សហគ្រាស ធន់ តូច និង មធ្យម ចំពោះ ការចុះបញ្ជី ដោយ ស្ម័គ្រចិត្ត ក្នុង ឆ្នាំ ២០២៤ - ២០២៥ តាមរយៈ ការលើកលែង ការបង់ ពន្ធ ប៉ាតង់ សម្រាប់ រយៈពេល ២ឆ្នាំ បន្ទាប់ពី ទទួលបាន ការសម្រេច ចុះបញ្ជី ។
ទី៦. កាត់បន្ថយ ថ្លៃ សេវា សម្រាប់ ការផ្ដល់ សេចក្ដីជូនដំណឹង បើក សហគ្រាស និង ការបញ្ជិកា សៀវភៅ ប្រចាំ គ្រឹះស្ថាន និង សៀវភៅ បើក ប្រាក់ខែ សម្រាប់ សហគ្រាស ដែល មាន កម្មករ និយោជិត តិច ជាង ៨នាក់ ។
ទី៧. ពង្រឹង យន្តការ ស្វ័យ ត្រួតពិនិត្យ និង ពង្រឹង ការអនុវត្ត យន្ត ការ ក្រុម អធិការកិច្ច អន្តរ ក្រសួង នៅ ថ្នាក់ ជាតិ ដើម្បី ធានា កាចុះ ធ្វើ អធិការកិច្ច រួមគ្នា ក្នុង ពេល តែ មួយ និង មួយ លើក ក្នុង ពេល មួយ ឆ្នាំ ( មិន ចុះ ច្រើន លើកឡើយ ) ។
ទី៨. រៀបចំ ការត្រួតពិនិត្យ និង ការធ្វើ អធិការកិច្ច រួមគ្នា ក្នុង ពេល តែ មួយ និង តែ មួយ លើក ក្នុង ពេល មួយ ឆ្នាំ នៅ ថ្នាក់ ក្រោម ជាតិ សម្រាប់ គ្រប់ សហគ្រាស ដែល បាន ឬ មិន ទាន់ បាន ចុះបញ្ជី ឬ ស្នើសុំ អាជ្ញាបណ្ណ ឬ លិខិត អនុញ្ញាត ផ្សេង ៗ ។
ទី៩. រៀបចំ បង្កើត បទដ្ឋាន គតិយុត្ត ក្របខណ្ឌ យន្តការ ដែល ផ្ដល់ ស្ថានភាពស្រប ច្បាប់ ជា សហគ្រាស ធន់ តូច និង មីក្រូ ដោយ ភ្ជាប់ ជាមួយ អត្ថប្រយោជន៍ ផ្សេង ៗ ដូចជា ការលើកលែង ការបង់ ថ្លៃ សេវា រដ្ឋបាល នានា សម្រាប់ រយៈពេល ៥ឆ្នាំ ជាដើម ។
បើ តាម សម្ដេច ធិបតី នាយក រដ្ឋមន្ត្រី ការដាក់ចេញ « យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ » នេះ គឺ ដើម្បី រួមចំណែក ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ប្រកបដោយ ចីរភាព បរិយា បន្ន និង ភាពធន់ នឹង វិបត្តិ ។ នៅ ប្រទេស កម្ពុជា សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ បាន បង្កើត ការងារ ប្រមាណ ៧០ ភាគរយ នៃ ទំហំ ការងារ សរុប និង រួមចំណែក ៣២ ភាគរយ នៃ ផលិតផល សរុប ក្នុង ស្រុក ៕
ការណែនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតី ប្រកាស ដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ នៃ យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ នា ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
សម្តេច ធិបតី បាន បញ្ជាក់ ថា ក្នុង ការអនុវតត គោល នយោបាយ ជាតិ នេះ រាជ រដ្ឋាភិបាល នឹង ផ្តល់ អទិភាព ខ្ពស់ និង ប្រគល់ ភារកិច្ច ដល់ ក្រសួង ឧស្សាហកម្ម ដើរ តួនាទី ជា ស្ថាប័ន បង្គោល នៅក្នុង ការ ជំរុញ ការអនុវត្ត និង ការតាមដាន អនុវត្ត យុទ្ធសាស្រ្ត ជាតិ នេះ ប្រកបដោយ ប្រសិទ្ធភាព ដើម្បី ជា ប្រយោជន៍ ជាតិ និង ប្រជាជន ។
តាម ប្រសាសន៍ សម្តេច ធិបតី ដើម្បី ទទួលបាន នូវ ជោគជ័យ នៅក្នុង ការអនុវត្ត « យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ » រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ អទិភាព ជា យុទ្ធសាស្រ្ត ៥ចំណុច៖
១៖ ការកំណត់ ការកែសម្រួល និង ការរៀបចំ យន្តការបង្ក លក្ខណៈ ងាយស្រួល ដើម្បី ឈានចូលក្នុង ប្រព័ន្ធ ៖ រាជ រដ្ឋាភិបាល នឹង ពង្រាយ និង ពង្រឹង យន្តការគ្រប់គ្រង និង ភាពប្រទាក់ ក្រឡា គ្នា រវាង វិធានការ ត្រូវ អនុវត្ត ដោយ ក្រសួង ស្ថាន ប័ន ពាក់ព័ន្ធ ទាំងអស់ ដើម្ប ធានា សង្គត់ភាព និង ការអនុវត្ត និង ការកែសម្រួល និតិវិធី ឱ្យ បានជា អតិបរមា ។
២៖ ការកាត់បន្ថយ បន្ទុក លើ ការបំពេញ អនុលោម ភាព ៖ រាជ រដ្ឋាភិបាល នឹង កាត់បន្ថយ បន្ទុក លើ ការបំពេញ អនុលោម ភាព ឱ្យ បានជា អតិបរមា បញ្ចៀស នូវ ការបង្កើត បទដ្ឋាន គតិយុទ្ធ ជាច្រើន និង ធានា នូវ ភាព អាច ប៉ាន់ប្រមាណ បាន សម្រាប់ ការប្រកប មុខរបរ និង ទាំង ធ្វើ ការងារ ។
៣៖ ការផ្ដល់ ការគាំពារ និង ការគាំទ្រ ដល់ អ្នក ដែល បាន ឈានចូលក្នុង ប្រព័ន្ធ ៖ រាជ រដ្ឋាភិបាល នឹង ពង្រឹង ពង្រីក វិសាលភាព នៃ មូលធន មូលនិធិ សមធម៌ សុខាភិបាល ព្រមទាំង ផ្តល់ ការគាំទ្រ ផ្នែក សុវត្ថិភាព ការងារ សំដៅ ផ្តល់ នូវ ការគាំពារ សុខភាព ដល់ ក្រុម អទិភាព ដើម្បីឱ្យ មាន លទ្ធភាព និង អាច រស់ នៅក្នុង ប្រព័ន្ធ ក្នុង កម្រិត ជីវភាព មួយ សមរម្យ និង មិន ធ្លាក់ ចូល ទៅក្នុង ភាពក្រីក្រ ឬ ទទួលរង ហានិភ័យ ខាង ជីវភាព ។
៤៖ ការលើកកម្ពស់ សមត្ថភាព និង ការគាំទ្រ ដល់ អ្នក ដែល បាន ឈានចូលក្នុង ប្រព័ន្ធ ៖ រាជ រដ្ឋាភិបាល នឹង លើកកម្ពស់ គុណភាព និង ភាពងាយស្រួល នៅក្នុង ការទទួលបាន សេវា សាធារណៈ និង ការគាំទ្រ ផ្សេង ៗ ការពង្រឹង ការបណ្តុះបណ្តាល ជំនាញ ការបង្កើត លទ្ធភាព ស្វែងរក ទីផ្សារ ជាដើម ក្នុង គោលដៅ ជំរុញ ឱ្យ អ្នក ដែល បាន ឈានចូលក្នុង ប្រព័ន្ធ រីក ធំធាត់ និង អាច ចូលរួម ពេញលេញ ក្នុង សេដ្ឋកិច្ច ក្នុង ប្រព័ន្ធ ។
( ហ្សាការតា) ៖ នៅ ព្រឹក ថ្ងៃអង្គារ ទី១០ ខែតុលា ឆ្នាំ ២០២៣ នៅ លេខាធិការដ្ឋាន អាស៊ាន ប្រចាំ ទីក្រុង ហ្សាការតា សាធារណរដ្ឋ ឥណ្ឌូណេស៊ី លោក បណ្ឌិត កៅ គឹម ហួន អគ្គ លេខាធិការ អាស៊ាន បាន អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ ក្រុមការងារ ជាន់ ខ្ពស់ លើក ទី ១១ ស្តីពី ចក្ខុវិស័យ សហគមន៍ អាស៊ាន ក្រោយ ឆ្នាំ ២០២៥ ដែល មាន ការ ធ្វើជា សហ ប្រធាន ដោយ ប្រទេស ឥណ្ឌូណេស៊ី និង ម៉ាឡេស៊ី ។
កិច្ចប្រជុំ នេះ ត្រូវបាន រៀបចំឡើង ដើម្បី ពិភាក្សា ពី វិធី ឆ្ពោះទៅ មុខ ក្នុង ការបង្កើត ឯកសារភ្ជាប់ ជាមួយ សេចក្តីព្រាង ចក្ខុវិស័យ សហគមន៍ អាស៊ាន ឆ្នាំ ២០៤៥ ដែល ត្រូវបាន កត់សម្គាល់ ដោយ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទ៤៣ នៅ ទីក្រុង ហ្សាការតា កាលពី ខែកញ្ញា កន្លងទៅ ៕ នគរបាល ខណ្ឌ ទួក គោក ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ក្រោយ លួច ទ្រព្យសម្បត្តិ ជនរងគ្រោះ នៅ សង្កាត់ ទឹកល្អក់ ទី៣
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល យុត្តិធម៌ នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ទួលគោក នៅ ថ្ងៃទី១០ ខែ តុលា ឆ្នាំ ២០២៣ បាន ស្រាវជ្រាវ បង្ក្រាប ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ករណី លួច មាន ស្ថាន ទម្ងន់ ទោស ដោយសារ ការ គាស់ ទម្លុះ ទម្លាយ ( ប្រើ កន្រ្តៃ សម្រាប់ កាត់ ដែក កាត់ សោរ ផ្ទះ យក ប្រាក់ ដុល្លារ ប្រហែល ២០០០ ដុល្លារ . ចិញ្ចៀន មាស ១វង់ ទម្ងន់ ១ជី កន្លះ និង ខ្សែក មាស ០១វង់ មាន ទម្ងន់ ៣ជី ) ។
ករណី នេះ កើតឡើង នៅក្នុង មូលដ្ឋាន សង្កាត់ ទឹកល្អក់ ទី៣ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០២៣ វេលា ម៉ោង ប្រហែល ០១: ៣០នាទី រំលង អាធ្រាត្រ ។
ជនសង្ស័យ ត្រូវបាន សមត្ថកិច្ច ស្រាវជ្រាវ ឃាត់ខ្លួន នៅ ម្ដុំ ច្រក ធ្យូង ផ្លូវ លេខ ៣៣៦ ក្រុម ទី ២៨ ភូមិ ១០ សង្កាត់ បឹងសាឡាង ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ដែល បាន ប្រព្រឹត្ត បទល្មើស នៅ ចំណុច ផ្ទះ លេខ ៨៥A ផ្លូវ លេខ ២៤៧ ក្រុម ទី ភូមិ១ សង្កាត់ ទឹកល្អក់៣ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ។
ជនរងគ្រោះ មាន ឈ្មោះ ឃាង ធីតា ភេទ ស្រី អាយុ ២០ ឆ្នាំ មុខរបរ បុគ្គលិក ខារ៉ាអូខេ W ស្នាក់ នៅ ផ្ទះ លេខ ៨៥A ផ្លូវ ២៤៧ ក្រុម ទី១ ភូមិ១ សង្កាត់ ទឹកល្អក់៣ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ។
សម្ភារ បាត់បង់ រួម មាន៖ ប្រាក់ ប្រហែល ២០០០ ដុល្លារ . ចិញ្ចៀន មាស ១វង់ ទម្ងន់ ១ជី កន្លះ និង ខ្សែក មាស ១វង់ មាន ទម្ងន់ ៣ជី ។
បច្ចុប្បន្ន ជនសង្ស័យ ខាងលើ កំពុង ឃាត់ខ្លួន ជា បណ្ដោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ទួលគោក ដើម្បី សាកសួរ និង កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការ តាម ច្បាប់ ៕
អភិបាល ខេត្ត ត្បូងឃ្មុំ លើកទឹកចិត្ត ក្រុមការងារ យុវជន បណ្តាញ សង្គម ខេត្ត បន្ត ផ្សព្វផ្សាយ ឱ្យ បាន ផុសផុល រាល់ សមិទ្ធល ដែល រដ្ឋាភិបាល កម្ពុជា និង រដ្ឋបាល ខេត្ត បាន ធ្វើ កំពុង ធ្វើ និង បន្ត ធ្វើ
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល និង លើកទឹកចិត្ត ដល់ ក្រុមការងារ យុវជន បណ្តាញ សង្គម ខេត្ត ត្បូងឃ្មុំ ក្នុង ឱកាស ពិធី បុណ្យ កាន់ បិណ្ឌ - ភ្ជុំ បិណ្ឌ ប្រពៃណី ជាតិ ខ្មែរ ដែល ដឹកនាំ ដោយ លោក បណ្ឌិត សេង ជ័យ វុធ នាយក រដ្ឋបាល សាលា ខេត្ត ។
ក្នុង ឱកាស នោះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន សំណេះសំណាល សួរសុខទុក្ខ និង កោតសរសើរ ចំពោះ យុវជន យុវនារី ក្រុមការងារ បណ្តាញ សង្គម ទាំងអស់ ដែល បាន ចូលរួម ផ្សព្វផ្សាយ និង សូម បន្ត ផ្សព្វផ្សាយ ឱ្យ កាន់តែ ផុស ផុល បន្ថែម ទៀត នូវ រាល់ ព័ត៌មាន អភិវឌ្ឍន៍ នានា សកម្មភាព ថ្នាក់ដឹកនាំ និង សមិទ្ធផល ជាច្រើន សន្ធឹកសន្ធាប់ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា ពិសេស រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ សម្រេចបាន កសាង ចេញ ជា រូបរាង ឡើង ទាំង នា ពេល កន្លងមក ក៏ ដូចជា បន្ត កសាង នា ពេល បច្ចុប្បន្ន និង នៅ អនាគត យ៉ាង ច្រើន បន្ថែម ទៀត ។
ស្ថិត ក្នុង ឱកាស នោះ ដែរ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន លើកទឹកចិត្ត ដល់ ប្អូន ៗ យុវជន ទាំងអស់ ឱ្យ បន្ត ខិតខំ រៀនសូត្រ និង ចូលរួម វគ្គ បណ្តុះបណ្តាល ជំនាញ ខ្លី ៗ ដើម្បី អភិវឌ្ឍន៍ ខ្លួន ឯង ឱ្យ ក្លាយជាធ នាធាន មនុស្ស ដ៏ ល្អ សម្រាប់ ប្រទេសជាតិ ។
ជាពិសេស ប្អូន ៗ ក្រុមការងារ បណ្តាញ សង្គម ដែល ប្រលង ជាប់ ថ្នាក់ ទី១២ ទាំងអស់ លោក បណ្ឌិត បន្ត លើកទឹកចិត្ត នឹង ស្វែងរក អាហារូបករណ៍ ផ្តល់ ជូន បើ ស្វែងរក មិន បាន លោក បណ្ឌិត នឹង ចេញ ថវិកា ផ្ទាល់ខ្លួន រ៉ាង់ រង ឱ្យ ប្អូន ៗ បន្ត ការសិក្សា នៅ ថ្នាក់ បរិញ្ញាបត្រ ដើម្បី ជា អ្នក បន្ត វេន ជា កោសិកា ជាតិ ជា ទំពាំង ស្នង ឫស្សី ដ៏ ល្អ សម្រាប់ សង្គមជាតិ កម្ពុជា ជាពិសេស សម្រាប់ ខេត្ត ត្បូងឃ្មុំ តែម្តង ។
ជាមួយគ្នា នេះ ដែរ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន ផ្តល់ ជូន ថវិកា មួយ ចំនួន ដល់ ប្អូន ៗ យុវជន សម្រាប់ ធ្វើ បុណ្យ ជាមួយ ក្រុមគ្រួសារ ក្នុង ឱកាស ពី ធី បុណ្យ ភ្ជុំ បិណ្ឌ ប្រពៃណី ជាតិ ខ្មែរ យើង ផងដែរ ។
សូម បញ្ជាក់ ថា ក្រុមការងារ យុវជន បណ្តាញ សង្គម ខេត្ត ដែល ដឹកនាំ ដោយ លោក បណ្ឌិត សេង ជ័យ វុធ នាយក រដ្ឋបាល ខេត្ត តែងតែ ចូលរួម យ៉ាង សកម្ម ក្នុង ការផ្សព្វផ្សាយ យ៉ាង ផុសផុល រាល់ សកម្មភាព និង ការអភិវឌ្ឍ នានា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ដល់ មហាជន ទូទៅ ៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត សង្ឃឹម ថា ការប្រយុទ្ធ គ្នា រវាង អ៉ី ស្រាអែល និង ហាម៉ាស់ ឆាប់ បញ្ចប់ តាមរយៈ ការចរចា (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន បង្ហាញ ក្តីសង្ឃឹម ថា ការប្រយុទ្ធ គ្នា រវាង កងកម្លាំង របស់ អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស់ នឹង ឆាប់ បិទ បញ្ចប់ តាមរយៈ កិច្ចចរចា គ្នា ជាជាង ការប្រើប្រាស់ អាវុធ ។ សម្តេច ធិបតី ក៏ រំពឹង ផងដែរ ថា កងកម្លាំង ហាម៉ាស់ នឹង ដោះលែង ជន ស៊ីវិល និង ចំណាប់ខ្មាំង ទាំងអស់ ដោយ សុវត្ថិភាព ។
ក្តីសង្ឃឹម របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង តាមរយៈ សារ សំឡេង ពិសេស មួយ ផ្ញើ ជូន ប្រជាពលរដ្ឋ ខ្មែរ នា ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។ សារសំឡេង ពិសេស នេះ ជា ការបញ្ជាក់ ពី កិច្ច កិច្ចអន្តរាគមន៍ របស់ រាជ រដ្ឋាភិបាល ចំពោះ និស្សិត និង ពលរដ្ឋ ខ្មែរ កំពុង រស់ នៅ ប្រទេស អ៉ី ស្រាអែល ។
ក្រៅពី នោះ ជនជាតិ អ៉ី ស្រាអែល និង ជន បរទេស ជាច្រើន នាក់ ត្រូវបាន ចាប់ ធ្វើជា ចំណាប់ខ្មាំង ផងដែរ ៕ តំណាងរាស្ត្រ មណ្ឌល ភ្នំពេញ និង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល អញ្ជើញ កាន់ បិណ្ឌ ទី ១១ នៅ វត្ត សំរោង អណ្តែត
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអង្គារ ១១រោច ខែ ភទ្រប ទ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវ នឹង ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ តំណាងរាស្ត្រ មណ្ឌល ភ្នំពេញ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង និង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល លោក សាស្ត្រាចារ្យ ឈាង រ៉ា បាន អញ្ជើញ កាន់ បិណ្ឌ ទី ១១ នៅ វត្ដ សំរោង អណ្តែត រាជធានី ភ្នំពេញ ។ ក្នុង ពិធី បុណ្យ កាន់ បិណ្ឌ ប្រកបដោយ ក្តី សោមនស្ស រីករាយ នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី មន្ត្រី សុខាភិបាល ជាច្រើន រូប ផងដែរ ។
ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ គឺជា ពិធី បុណ្យ ដ៏ ធំ មួយ នៅក្នុង ចំណោម ពិធី បុណ្យ ផ្សេង ៗ នៅ កម្ពុជា ដែល ប្រជាជន ខ្មែរ នាំគ្នា ប្រារព្ធ ធ្វើឡើង មិន ដែល អាក់ខាន ឡើយ ជារៀងរាល់ ឆ្នាំ គឺ ចាប់ពី ថ្ងៃ១ រោច ខែ ភទ្របទ រហូតដល់ ថៃ្ង ទី ១៥រោច ដែល មាន រយៈ ពេល ១៥ ថៃ្ង ដោយ ហៅ ថា បុណ្យ កាន់ បិណ្ឌ១. បិណ្ឌ ២... និង នៅ ថៃ្ង បញ្ចប់ គឺជា ថៃ្ង « ភ្ជុំ បិណ្ឌ » ធំ តែម្តង ។ សម្រាប់ បុណ្យ កាន់ បិណ្ឌ ឆ្នាំ នេះ បាន ចាប់ផ្ដើម នៅ ថ្ងៃទី៣០ ខែកញ្ញា រហូតដល់ ថ្ងៃទី ១៣ ខែតុលា និង ថ្ងៃ ភ្ជុំ បិណ្ឌ នៅ ថ្ងៃទី ១៤ ខែតុលា ឆ្នាំ ២០២៣ ។
តំណាងរាស្ត្រ មណ្ឌល ភ្នំពេញ និង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល គឺជា អ្នក គោរព ប្រណិប័តន៍ យ៉ាង ខ្ជួន នូវ ពិធី បុណ្យ ទាំងឡាយ ដែល ជា ទំនៀមទម្លាប់ ប្រពៃណី របស់ ខ្មែរ ហើយក៏ ជា អ្នក ទ្រទ្រង់ ពិធី បុណ្យ ទាំងឡាយ របស់ ជាតិ ឱ្យ ខ្ពស់ ត្រដែត ឡើង ផងដែរ ។
ជា កិច្ច ចាប់ផ្តើម នៃ ពិធី នា ព្រឹក មិញ នេះ លោក អាចារ្យ បាន ដឹកនាំ ពិធី តាម បែប ពុទ្ធសាសនា របស់ ខ្មែរ ដោយ ការនមស្ការ ព្រះរតនត្រ័យ វេបបាយ បិត្ត បូរ សមាទាន សីល វេរ ចង្ហាន់ រាប់ បាត្រ ជាដើម ។
តំណាងរាស្ត្រ មណ្ឌល ភ្នំពេញ និង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ក៏ បាន ឧទ្ទិស កុសល ផល បុណ្យ ជូន ទៅដល់ ដួង វិញ្ញាណ ក្ខន្ធ បុព្វបុរស អ្នកស្នេហាជាតិ ក៏ ដូចជា ប្រជាពលរដ្ឋ ខ្មែរ ដែល បាន ពលី ជីវិត ក្នុង បុព្វហេតុ ជាតិ និង បាត់បង់ជីវិត ក្នុង ពេល ប្រទេសជាតិ ជួប វិបត្តិ នៃ ភ្លើង សង្គ្រាម ផងដែរ ។
ក្នុង ពិធី កាន់ បិណ្ឌ វេន ទី ១១ ប្រកបដោយ ទឹកចិត្ត ជ្រះថ្លា នា ព្រឹក មិញ នេះ តំណាងរាស្ត្រ មណ្ឌល ភ្នំពេញ និង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន ប្រគេន បច្ច័យ ដល់ ព្រះសង្ឃ សម្រាប់ កសាង សមិទ្ធផល នានា នៅក្នុង វត្ត សំរោង អណ្ដែត ផងដែរ ៕
របាយការណ៍ ដដែល នេះ បាន បង្ហាញ ថា វិស័យ បច្ចេកវិទ្យា ព័ត៌មាន និង ទូរគមនាគមន៍ គឺជា វិស័យ ដែល រីកចម្រើន លឿន បំផុត របស់ ប្រទេស នេះ ក្នុង រយៈពេល នោះ ទោះបីជា មាន ការកើនឡើង ការងាក ទៅ រក ឌីជីថល នីយកម្ម ដោយ ឧស្សាហកម្ម ផ្សេង ទៀត ក្ដី ។ របាយការណ៍ ដដែល នេះ បាន ប៉ាន់ប្រមាណ ថា ទំហំ សេដ្ឋកិច្ច ឌីជីថល របស់ ប្រទេស សិង្ហបុរី មាន ចំនួន ១០៦ ពាន់ លាន ដុល្លារ សិង្ហបុរី ( ៧៧. ៥ពាន់ លាន ដុល្លារ ) គិត ត្រឹម ឆ្នាំ ២០២២ ។
តម្រូវការ អ្នកជំនាញ ផ្នែក បច្ចេកវិទ្យា នៅក្នុង ប្រទេស សិង្ហបុរី បាន ផ្តល់ អត្ថប្រយោជន៍ ដល់ បុគ្គលិក ក្នុង ស្រុក ដែល កាន់កាប់ តួនាទី ខាង ផ្នែក បច្ចេកវិទ្យា ច្រើន ជាង ៧០ % ហើយ នៅតែ មាន ភាពរឹងមាំ សូម្បីតែ បន្ទាប់ពី ទទួលរង ការជម្រុះ បុគ្គលិក ជា បន្តបន្ទាប់ពីសំណាក់ ក្រុមហ៊ុន សកល ជាច្រើន កាលពី ឆ្នាំ មុន ក្ដី ។ ប្រាក់ខែ នៅក្នុង វិស័យ នេះ ដែល ផ្តល់ ការងារ ២សែន កន្លែង មាន កម្រិត ខ្ពស់ ជាង ប្រាក់ ឈ្នួល ជា មធ្យម របស់ ប្រទេស សិង្ហបុរី យ៉ាង ខ្លាំង ហើយ គម្លាត នេះ បាន កើនឡើង ចាប់តាំងពី ឆ្នាំ ២០១៧មក ។
បុគ្គល ឈ្មោះ Ri Song Jin ដែល KCNA បាន ពិពណ៍ នា ថា ជា អ្នកស្រាវជ្រាវ នៃ រដ្ឋបាល បច្ចេកវិទ្យា ផ្នែក អវកាស កូរ៉េ ខាងជើង ហៅ កាត់ NATA បាន ចោទប្រកាន់ សហរដ្ឋ អាមេរិក ថា មាន មហិច្ឆតា ចង់ បង្កើន អនុត្តរភាព យោធា ឱ្យ កាន់តែ ធំ ជាង មុន នៅក្នុង តំបន់ អាស៉ី តាមរយៈ ការពង្រីក វត្តមាន កងកម្លាំង អវកាស របស់ ខ្លួន ។ អ្នកស្រាវជ្រាវ កូរ៉េ ខាងជើង បាន គូស រំលេច អំពី ទស្សនកិច្ច ថ្មី ៗ នេះ របស់ មេបញ្ជាការ កងកម្លាំង អវកាស អាមេរិក ទៅកាន់ ទីក្រុង តូក្យូ និង ការដាក់ពង្រាយ សមាជិក កងកម្លាំង អវកាស អាមេរិក នៅ កូរ៉េ ខាងត្បូង ។
អ្នកស្រាវជ្រាវ ខាងលើ បាន បន្ថែម ទៀត ថា « ដោយសារតែ ឥឡូវនេះ សហរដ្ឋ អាមេរិក កំពុង មាន មហិច្ឆតា ខ្លាំង ក្នុង ការធ្វើ យោធូបនីយកម្ម ទី អវកាស ហើយ មាន ការវាយប្រហារ នុយក្លេអ៊ែរ ទុក មុន ជា គោលដៅ ចុងក្រោយ របស់ ខ្លួន តាមរយៈ ការដាក់ពង្រាយ កងកម្លាំង អវកាស នៅ ពាសពេញ ឧបទ្វីប កូរ៉េ និង តំបន់ ក្បែរខាង ការអភិវឌ្ឍ វិស័យ អវកាស របស់ កូរ៉េ ខាងជើង រួម មាន ផ្កាយ រណប ស៉ើបការណ៍ យោធា គឺជា ជម្រើស យុទ្ធសាស្រ្ត ដែល មិន អាច ខ្វះ បាន នោះ ទេ ដើម្បី ធានា ផលប្រយោជន៍ ផ្នែក សន្តិសុខ និង សិទ្ធិ រស់រាន មាន ជីវិត របស់ កូរ៉េ ខាងជើង » ។
( ក្រចេះ ) ៖ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត ក្រចេះ នៅ ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ប្រារព្ធ ពិធី ទិវា មនុស្ស ចាស់ កម្ពុជា និង មនុស្ស ចាស់ អន្តរជាតិ១ តុលា ឆ្នាំ ២០២៣ លើក ទី២៥ ក្រោម ប្រធានបទ « ការជួយ មនុស្ស វ័យ ចាស់ គឺ ជួយ យើង ទាំងអស់ គ្នា » ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោកស្រី ខាំ សុភាព អភិបាល រង ខេត្ត ក្រចះ និង មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ប្រធាន អនុប្រធាន មន្ទីរ ជុំវិញ ខេត្ត អភិបាល ស្រុក ក្រុង និង មនុស្ស ចាស់ ចំនួន ៣២៨ នាក់ ផងដែរ នៅ សាល មហោស្រប ខេត្ត ក្រចេះ ។
លោក ចាន់ សុគុណ ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន យុវនីតី សម្បទា ខេត្ត បាន បញ្ជាក់ ថា អនុគណៈកម្មាធិការ ដើម្បី មនុស្ស ចាស់ ខេត្ត ក្រចេះ បាន បង្កើត សមាគម មនុស្ស ចាស់ នៅ តាម បណ្តា ឃុំ - សង្កាត់ ក្នុង ខេត្ត ក្រចេះ បាន ចំនួន ៤២ ឃុំ និង ៥សង្កាត់ ។ ក្នុង នោះ បាន ដំណើរការ ចំនួន ១៦ឃុំ និង ១សង្កាត់ ។ នៅសល់ ២៦ ឃុំ និង ៤សង្កាត់ ទៀត មិន ទាន់ បាន ដំណើរការ នៅឡើយ ។
ប្រធាន មន្ទីរ បាន លើកឡើង ថា ពិធី នេះ ធ្វើឡើង ដើម្បី រំលឹក គុណ ដល់ មនុស្ស វ័យ ចាស់ និង លើកកម្ពស់ ការទទួលខុសត្រូវ ក្នុង ការចូលរួមចំណែក កសាង សង្គម គ្រួសារ និង សង្គមជាតិ ដែល មាន ការយកចិត្តទុកដាក់ ចំពោះ សុខុមាភាព មនុស្ស ចាស់ ។ ការប្រារព្ធ ទិវា នេះ មិន មែន មាន តែ ប្រទេស កម្ពុជា ទេ គឺ គ្រប់ ប្រទេស ក្នុង ពិភពលោក ដែល ជា សមាជិក អង្ក ការសហ ប្រជាជាតិ សុទ្ធតែ ប្រារព្ធ ធ្វើឡើង ដូចគ្នា ដោយ កំណត់ យក ថ្ងៃទី ១ ខែតុលា ជារៀងរាល់ ឆ្នាំ ។
លោកស្រី បាន បន្ត ថា មនុស្ស វ័យ ចាស់ ត្រូវ ទទួលបាន នូវ ការជួយ ឧបត្ថម្ភ គាំទ្រ ដោយ ក្រសួង ស្ថាប័ន ដែល មាន សមត្ថកិច្ច រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ កាកបាទ ក្រហម កម្ពុជា សប្បុរសជន នានា និង អង្គការ មិន មែន រដ្ឋាភិបាល ផងដែរ ។ សកម្មភាព ប្រកបដោយ សប្បុរស ធម៌ ទាំង នេះ បាន ឆ្លុះបញ្ចាំង ឱ្យ ឃើញ ពី វប្បធម៌ ជួយ ឧបត្ថម្ភ គាំទ្រ គ្នា និង ការរួបរួម គ្នា ជួយ ជ្រោមជ្រែង ដោះស្រាយ នូវ ទុក្ខលំបាក របស់ ជន រួម ជាតិ ជាពិសេស មនុស្ស ចាស់ ជរា ពិការ ក្រីក្រ គ្មាន ទីពឹង នៅក្នុង សង្គមជាតិ ។
( ក្រចេះ ) ៖ លោក ឡឹក សុធារ អនុ រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម និង លោក គង់ គឹម នី អភិបាល រង ខេត្ត និង ប្រធាន លេខាធិការដ្ឋាន នៃ គណៈកម្មាធិការ គ្របើ គ្រង គ្រោះមហន្តរាយ ខេត្ត ក្រចេះ នៅ ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ចែក ស្រូវ ពូជ ដែល ជា អំណោយ រដ្ឋាភិបាល ដល់ ប្រជាពលរដ្ឋ ចំនួន ៤០០ គ្រួសារ ដែល រង ការខូចខាត ដោយ ទឹក ជំនន់ ក្នុង ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ដើម្បី ដំណាំ ស្តារ ឡើងវិញ ។
លោក អភិបាល រង សូម ថ្លែងអំណរគុណ ដ៏ ខ្ពង់ខ្ពស់ ចំពោះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន ដាក់ចេញ នូវ គោល នយោបាយ និង ការចង្អុល ណែនាំ យ៉ាង ម៉ត់ចត់ ក្នុង ការយកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ពិសេស ការផ្តល់ គ្រាប់ ពូជ ស្រូវ ជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង និង ទឹក ជំនន់ ទន្លេ មេគង្គ នៅក្នុង ខេត្ត ក្រចេះ ។
មន្រ្តី ជំនាញ ក្រសួង កសិកម្ម បាន ណែនាំ ឱ្យ ប្រជាពលរដ្ឋ ដឹង ពី របៀប សាប ព្រោះ ដាំដុះ ដោយសារ ស្រូវ ពូជ នេះ មិន អាច ទុក យូរ បាន ទេ ត្រូវតែ ប្រញាប់ រូតរះ យក ទៅ ធ្វើ ការសាប ព្រោះ ឱ្យ បាន ទាន់ ពេល វេលា ។
មន្ត្រី ជំនាញ ក៏ បាន បង្ហាញ អំពី បច្ចេកទេស មួយចំនួន មុននឹង យក ទៅ សាប ព្រោះ គឺ ត្រូវ ត្រាំ ទឹក រយៈពេល ៣៦ ម៉ោង ហើយ យក ទៅ ដាក់ ហាល រយៈពេល ខ្លី ទើប យក ទៅ សាប ព្រោះ បាន ដែល ធ្វើឱ្យ គ្រាប់ ពូជ នោះ មាន កម្លាំង នៅក្នុង ការលូតលាស់ បាន ល្អ ។ ក្រៅពី នោះ ក៏ ត្រូវការ ភ្ជរាស់ ដី និង សម្អាត ដី ឱ្យ បាន ល្អ រៀប ស្មើ ដែល ជា សារៈសំខាន់ បំផុត សម្រាប់ ការគ្រប់គ្រង ទឹក និង ស្មៅ ជាដើម ៕
អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បំភ្លឺ ចំពោះ ការចោទប្រកាន់ ថា គម្រោង រេដ បូក ជួរ ភ្នំ ក្រវាញ ខាងត្បូង អនុវត្ត ដោយ គ្មាន ការយល់ព្រម ពី ជនជាតិ ដើម ភាគ តិច និង សហគមន៍ មូលដ្ឋាន
អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បាន បន្ត ថា ដំណើរការ នៃ ការធ្វើ ផែនការប្រើប្រាស់ ដីធ្លី ដោយ មាន ការចូលរួម ទាំងមូល ត្រូវបាន ធ្វើឡើង ដោយ មាន ការពិគ្រោះយោបល់ និង មាន ការយល់ព្រម យ៉ាង ពេញលេញ ពី ជនជាតិ ដើម ភាគ តិច និង ពី សហគមន៍ មូលដ្ឋាន ក្នុង ឃុំ ចំនួន ១៤ ។
ចាប់ពី ឆ្នាំ ២០១២ ដល់ ឆ្នាំ ២០១៦ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បាន ជួយ សម្រួល ដល់ ការវាស់វែង ក្បាល ដី ឯកជន ចំនួន ១២.២៤៨ កន្លែង ដែល អនុវត្ត តាម បទបញ្ជា លេខ ០១ប ប រួម ជាមួយនឹង ក្រសួង រៀបចំ ដែនដី ។
ក្រោយមក ទៀត គម្រោង សាងសង់ ទំនប់ វារី អគ្គិសនី នោះ ត្រូវបាន បោះបង់ និង បញ្ឈប់ នៅ ឆ្នាំ ២០១៥ ហើយ ដំណើរការចុះបញ្ជី ដី ថ្មី ត្រូវ ចាប់ផ្តើម ក្នុង ភូមិ ចំនួន ៦ នៅ ឆាយ អារ៉ែង នោះ ។
អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការប្រាស្រ័យទាក់ទង ជាមួយ អង្គការ មួយ ដែល កំពុង ធ្វើ ការចោទប្រកាន់ ទៅ លើ គម្រោង រេដ បូក ជួរ ភ្នំ ក្រវាញ ខាងត្បូង ដោយ ផ្តល់ នូវ ព័ត៌មាន យ៉ាង លម្អិត ឆ្លើយតប ទៅនឹង ការចោទ របស់ ពួកគាត់ ។
ផ្អែក លើ ការចោទប្រកាន់ ខាង លើ នេះ វេរ៉ា (Verra) ដែល ជា ស្ថាប័ន ប្រើប្រាស់ ស្តង់ដារ អន្តរជាតិ ដើម្បី ធ្វើ ការបញ្ជាក់ លើ គម្រោង រេដ បូក បាន បញ្ឈប់ ការចេញ វិញ្ញាបនបត្រ បញ្ជាក់ កាបូន (VERs) ជូន គម្រោង រេដ បូក ជួរ ភ្នំ ក្រវាញ ខាងត្បូង រហូត ទាល់តែ មាន ការរកឃើញ ទៅ លើ ការត្រួតពិនិត្យ គុណភាព ស្រប ទៅតាម លក្ខខណ្ឌ ដែល គេ ពេញចិត្ត ។ ការត្រួតពិនិត្យ គុណភាព ត្រូវបាន បញ្ចប់ នៅ ចុង ខែកក្កដា ឆ្នាំ ២០២៣ ហើយ បាន បន្សល់ នូវ សំណួរ បច្ចេកទេស មួយចំនួន ដែល ត្រូវ ឆ្លើយតប ។
អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ ជឿជាក់ ថា ការស្រាវជ្រាវ នឹង បង្ហាញ ថា គម្រោង រេដ បូក ជួរ ភ្នំ ក្រវាញ ខាងត្បូង គឺជា ការផ្ដួច ផ្ដើម គំនិត ផ្នែក អភិរក្ស ប្រកបដោយ ទំនួល ខុសត្រូវ និង ប្រសិទ្ធភាព ដោយ បាន ផ្តល់ អត្ថប្រយោជន៍ ដល់ បរិស្ថាន និង សហគមន៍ មូលដ្ឋាន ។ ក៏ បាន ស្នើសុំ ឱ្យ ការត្រួតពិនិត្យ មាន ភាព គ្រប់ ជ្រុងជ្រោយ ដោយ សូម រួមបញ្ចូល ទាំង ផល វិជ្ជមាន ដែល គម្រោង រេដ បូក ជួរ ភ្នំ ក្រវាញ ខាងត្បូង បាន ផ្តល់ ជូន សហគមន៍ និង ព្រៃឈើ ផងដែរ ។
បន្ថែម ពី នេះ អង្គការ ជឿជាក់ យ៉ាង មុតមាំ ថា ស្រប ពេល ដែល គម្រោង រេដ បូក ជួរ ភ្នំ ក្រវាញ ខាងត្បូង កំពុង អភិរក្ស ព្រៃឈើ និង លើកកម្ពស់ ជីវភាព សហគមន៍ ក្នុង តំបន់ គម្រោង នេះ ក៏ គាំទ្រ ឱ្យ មាន ការគោរព និង ការពារ សិទ្ធិ មនុស្ស ផងដែរ ។
សរុប សេចក្តី មក ប្រជាពលរដ្ឋ ចំនួន ៣. ៩៥៧ គ្រួសារ បាន ទទួល អត្ថប្រយោជន៍ ដោយ ផ្ទាល់ ពី គម្រោង រេដ បូក ជួរ ភ្នំ ក្រវាញ ខាងត្បូង រួម មាន៖ អណ្តូង ទឹក ចំនួន ៩៤ កន្លែង ប្រព័ន្ធ ចែកចាយ ទឹក ប្រវែង ៧.៨០០ ម៉ែត្រ សាលារៀន ស្ពាន អាហារូបករណ៍ និង ៥០៩ គ្រួសារ ទទួលបាន អត្ថប្រយោជន៍ ដោយ ផ្ទាល់ ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ ខ្លួន ។
ក្នុង សារ សំឡេង នោះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បង្ហាញ សមាន ទុក្ខ យ៉ាង ក្រៀមក្រំ ចំពោះ មរណភាព និស្សិត ខ្មែរ មួយ រូប ដែល បាន ស្លាប់ បាត់បង់ជីវិត ក្នុង ហេតុការណ៍ វាយប្រហារ របស់ កងកម្លាំង ហាម៉ាស់ លើ ទឹកដី អ៉ី ស្រាអែល និង ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ គ្រួសារ សព្វ ។
បើ ទោះបីជា យ៉ាងណា មន្ត្រី ពាក់ព័ន្ធ របស់ កម្ពុជា ព្យាយាម ធ្វើការ ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ដើម្បី ជួយសង្គ្រោះ និង ជម្លៀស អ្នក នៅ តំបន់ រង ហានិភ័យ នេះ ទៅកាន់ តំបន់ មាន សុវត្ថិភាព ឱ្យ បាន លឿន បំផុត តាម ដែល អាច ធ្វើ ទៅ បាន ។
សម្តេច ធិបតី បាន អះអាង ថា « រាជ រដ្ឋាភិបាល និង ស្ថាប័ន ពាក់ព័ន្ធ របស់ កម្ពុជា នឹង បន្ត តាមដាន យ៉ាង យកចិត្តទុកដាក់ រហូតដល់ ប្រជាពលរដ្ឋ ខ្មែរ យើង នៅក្នុង ទឹកដី អ៉ី ស្រាអែល គ្រប់ រូប បាន ដល់ ទី សុវត្ថិភាព គ្រប់ គ្នា » ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បន្ត អំពាវនាវ ដល់ និស្សិត និង ពលរដ្ឋ ខ្មែរ នៅ អ៉ី ស្រាអែល បន្ត យកចិត្តទុកដាក់ លើ សុវត្ថិភាព របស់ ខ្លួន និង គោរព ឱ្យ បាន ម៉ឺងម៉ាត់ រាល់ ការណែនាំ របស់ អាជ្ញាធរ អ៉ី ស្រាអែល និង សូម រក្សា ភាពស្ងៀមស្ងាត់ និង ជឿ លើ សមត្ថភាព របស់ អាជ្ញាធរ អ៉ី ស្រាអែល ដែល ជា ម្ចាស់ ផ្ទះ ក្នុង ការធានា សុវត្ថិភាព ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែងអំណរគុណ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី កម្ពុជា ឧប នាយក រដ្ឋមន្ត្រី ក្រសួង ការបរទេស សហប្រតិបត្តិការ អន្តរជាតិ រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា មន្ត្រី ស្ថាប័ន សន្តិសុខ ជាតិ ស្ថាន ឯក អគ្គ រដ្ឋទូត កម្ពុជា ប្រចាំ នៅ ប្រទេស តួកគី អេហ្ស៉ី ប និង មន្ត្រី កុងស៊ុល នៅ អ៉ី ស្រាអែល និង អ្នក ពាក់ព័ន្ធ ដែល បាន យកចិត្តទុកដាក់ ជួយ ដល់ ពលរដ្ឋ និស្សិត និង ពលរដ្ឋ ខ្មែរ នៅ អ៉ី ស្រាអែល ៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ប្រកាស ថា សុវត្ថិភាព និស្សិត និង ពលរដ្ឋ ខ្មែរ នៅ អ៉ី ស្រាអែល ជា កិច្ចការ អាទិភាព និង សំខាន់ បំផុត សម្រាប់ រាជ រដ្ឋាភិបាល ក្នុង ការយកចិត្ត ទុក ។
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ថា មិន មាន រកឃើញ អ្នក ឆ្លង កូវីដ១៩ នោះ ទេ ខណៈ ជា អ្នក ជាសះស្បើយ ក៏ គ្មាន ដែរ ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៨. ៩៤១ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៥. ៨៨៥ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ ឧប នាយក រដ្ឋមន្ដ្រី នេត សាវឿន ចេញ សេចក្ដីសម្រេច ចាត់តាំង ក្រុមការងារ ត្រួតពិនិត្យ ជំរុញ តាមដាន និង សហការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្ដ្រី នេត សាវឿន ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ចេញ សេចក្ដីសម្រេច ចាត់តាំង ក្រុមការងារ ត្រួតពិនិត្យ ជំរុញ តាមដាន និង សហការ ក្នុង ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ។
ខាងក្រោម នេះ ជា សេចក្ដីសម្រេច របស់ ឧប នាយក រដ្ឋមន្ដ្រី នេត សាវឿ ន៖ អាជ្ញាធរ ខេត្ត សៀមរាប បើក កិច្ចប្រជុំ គណៈកម្មការបច្ចេកទេស ដើម្បី រៀបចំ ពិធី បុណ្យ អ៊ុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ នៅ ខេត្ត សៀមរាប
( សៀមរាប ) ៖ អាជ្ញាធរ ខេត្ត សៀមរាប បាន បើក កិច្ចប្រជុំ គណៈកម្មការបច្ចេកទេស ដើម្បី រៀបចំ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ ដែល នឹង ប្រព្រឹត្តទៅ នៅ តាម បណ្តោយ ដង ស្ទឹង សៀមរាប រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៦ - ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ៩ ខែតុលា ឆ្នាំ ២០២៣ ក្រោម ការដឹកនាំ ប្រជុំ ដោយ លោក សន សេរី វុទ្ធី នាយក ទី ចាត់ការ ធនធាន មនុស្ស នៃ សាលា ខេត្ត សៀមរាប និង មាន ការចូលរួម ពី លោក លោកស្រី មកពី មន្ទីរ អង្គភាព និង សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត ដែល ជា សមាជិក គណៈកម្មការបច្ចេកទេស ចូលរួម ផងដែរ ។
លោក សន សេរី វុទ្ធី បាន លើកឡើង ថា ក្នុង ពិធី បុណ្យ អុំ ទូក នេះ ដែរ ក៏ មាន រៀបចំ នូវ កម្មវិធី កម្សាន្ត ផ្សេង ៗ ជូន ដល់ ប្រជាពលរដ្ឋ ទាំង ក្នុង និង ក្រៅ ខេត្ត ព្រមទាំង ភ្ញៀវ ទេសចរ បាន ទស្សនា កម្សាន្ត អំពី វប្បធម៌ ប្រពៃណី របស់ ប្រជាពលរដ្ឋ ខែ្មរ ។
លោក សន សេរី វុទ្ធី បាន បន្ត ថា ការរៀបចំ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក សំពះ ព្រះខែ នេះ គឺ ធ្វើឡើង ដើមី្ប រំលឹក និង គោរព ដល់ វីរភាព នៃ បុព្វបុរស ទាហាន ជើង ទឹក ជំនាន់ ដើម ដែល បាន ពលី ជិវិត ក្នុង ការធ្វើ សឹក សង្រ្គាម តាម ផ្លូវ ទឹក ក្នុង ការកម្ចាត់ ពួក សត្រូវ ឈ្លានពាន ហើយ ទទួលបាន ជ័យជម្នះ ជូន ជាតិ មាតុភូមិ ។
ការជួបជុំគ្នា នា ឱកាស នេះ ក៏ ដើមី្ប ធ្វើ ការពិភាក្សា គ្នា ក្នុង ជួរ គណៈកម្មការបច្ចេកទេស រៀបចំ ការប្រកួត អុំ ទូក ដើមី្ប ធ្វើ ការរៀបចំ ក្រុង ប្រវត្តិសាស្ត្រ សៀមរាប ឲ្យ មាន សោភ័ណភាព កាន់តែ មាន ភាពស្រស់ ត្រកាល ឡើង ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក សំពះ ព្រះខែ ឆ្នាំ ២០២៣ នេះ ក្នុង ការស្តារ ឡើងវិញ លើ វិស័យ ទេសចរណ៍ ដែល ខេត្ត សៀមរាប គឺជា ក្រុង គោលដៅ របស់ ភ្ញៀវ ទេសចរណ៍ លើ ពិភពលោក ដែល មាន ការទាក់ទាញ នូវ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ចូលមក ទស្សនា កម្សាន្ត ឲ្យ កាត់ តែ ច្រើន ។
លោក សន សេរី វុទ្ធី បាន លើក នូវ ចំណុច មួយចំនួន ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ដោយ ផ្តោត ទៅ លើ បញ្ហា បច្ចេកទេស ក្នុង ផ្គូរ ផ្គង ទូក ការចេញដំណើរ ពី ដើមទី ដល់ ចុង ទី និង ត្រូវ ត្រួតពិនិត្យ ឲ្យបាន ល្អិតល្អន់ ចំពោះ ក្រុម កីឡាករ និង កីឡាការិនី អំពី សុខភាព និង វិន័យ ក្នុង ការប្រកួត ព្រមទាំង រក្សា ឲ្យបាន ល្អ សណ្តាប់ធ្នាប់ ទូក មុន ចូល ការប្រកួត ផងដែរ ។
លោក ក៏ បាន ណែនាំ មួយចំនួន ដល់ សមាជិក គណៈកម្មការបច្ចេកទេស ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ លើ បច្ចេកទេស ដែល គណៈកម្មការ មាន បទពិសោធន៍ ពី បណ្តា ឆ្នាំ មុន ៗ ក្នុង គោលដៅ លើកស្ទួយ វប្បធម៌ ទំនៀមទម្លាប់ ប្រពៃណី ជាតិ ហើយក៏ ជា ការផ្សព្វផ្សាយ ដើម្បី ទាក់ទាញ អារម្មណ៍ ដល់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ចូលមក ទស្សនា កម្សាន្ត នូវ សម្បត្តិ វប្បធម៌ ដែល សម្បូរ ទៅ ដោយ ប្រាង្គ ប្រាសាទ រមណីយដ្ឋាន ធម្មជាតិ នៅលើ ទឹកដី ប្រវត្តិសាស្ត្រ ដែល ជា ទីក្រុង គោលដៅ ភ្ញៀវ ទេសចរ នៅលើ ពិភពលោក ផងដែរ ៕
រូបភាព វីដេអូ មួយ ដែល មិន ទាន់ ត្រូវបាន ផ្ទៀង ផ្ទាល់ នៅលើ បណ្ដាញ ទំនាក់ទំនង សង្គម បាន បង្ហាញ ពី រថយន្ដ មួយ គ្រឿង នៅក្នុង អគារ ស្ថាន កុងស៊ុល ចិន ហើយ ប៉ូលិស បាន តម្រង់ កាំភ្លើង ទៅ រក ទា្វរ នៃ កៅអី អ្នកបើកបរ ខណៈ មនុស្ស បាន រត់ ចេញ ពី កន្លែង កើត ហេតុ ។ អ្នកនាំពាក្យ ស្ថាន កុងស៊ុល ចិន បាន និយាយ ថា ជនសង្ស័យ បាន បើក រថយន្ដ បំបុក ទាំង កម្រោល ចូលក្នុង សាល រដ្ឋបាល នៃ ស្ថានកុងស៊ុល ដោយ បង្ក ការគំរាមកំហែង ធ្ងន់ធ្ងរ ដល់ អាយុជីវិត បុគ្គលិក និង មនុស្ស នៅ ទីតាំង កើត ហេតុ ព្រមទាំង បង្ក ការខូចខាត ធ្ងន់ធ្ងរ ។
ចំណែក ខាង មន្ត្រី ប៉ូលិស នៃ នាយក រដ្ឋាន ប៉ូលិស សាន់ហ្វា្រន់ស៊ីស្កូ ក៏ បាន បញ្ជាក់ ដែរ ថា ក្រុម មន្ត្រី ប៉ូលិស បាន ទៅដល់ កើត ហេតុ ភ្លាម ៗ ក្រោយ ទទួលបាន ព័ត៌មាន ថា មាន រថយន្ដ មួយ គ្រឿង បំបុក ចូល ការិយាល័យ ទិដ្ឋាការ នៃ ស្ថានកុងស៊ុល ចិន ។ ប៉ុន្តែ នៅពេល ប៉ូលិស ទៅដល់ និង ព្យាយាម ទំនាក់ទំនង ជាមួយ ជនសង្ស័យ ស្រាប់តែ ការផ្ទុះ កំា ភ្លើង កើតឡើង ។ ក្រុម គ្រូពេទ្យ បាន ព្យាយាម សង្រ្គោះ ជីវិត ជនសង្ស័យ ណាស់ ដែរ តែ មិន អាច សង្រ្គោះ បាន ដោយ រូប គេ ត្រូវបាន ប្រកាស ថា បាន ស្លាប់ ក្រោយ បញ្ជូន ទៅដល់ មន្ទីរពេទ្យ ។
គួរ បញ្ជាក់ ថា នាយក រដ្ឋាន ប៉ូលិស សាន់ហ្វា្រន់ស៊ីស្កូ មិន បាន បញ្ជាក់ ពី អត្តសញ្ញាណ ជនសង្ស័យ ខាងលើ នោះ ទេ ស្រប ពេល ការស៊ើបអង្កេត មួយ កំពុង ធ្វើឡើង ហើយ អ្នកនាំពាក្យ ស្ថាន កុងស៊ុល ចិន បាន ថ្កោលទោស យ៉ាង ខ្លាំង លើ ការវាយប្រហារ ដ៏ ហិង្សា នេះ និង ជំរុញ ឱ្យ មាន ការស៊ើបអង្កេត ស្វែងរក ការពិត នៅ ពីក្រោយ ហេតុការណ៍ នេះ ផងដែរ ៕
រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន ប្រកាស ដាក់ ចេញ យុទ្ធនាការដាំ ដើមឈើ យ៉ាងតិច ១លាន ដើម ជារៀងរាល់ ឆ្នាំ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ប្រកាស ដាក់ ចេញ យុទ្ធនាការដាំ ដើមឈើ យ៉ាងតិច ១លាន ដើម ជារៀងរាល់ ឆ្នាំ ចាប់ពី ពេលនេះ តទៅ ។
ជាមួយគ្នា នេះ ដែរ លោក រដ្ឋមន្ត្រី អ៊ាង សុផល្លែត បាន ថ្លែង ថា ដើម្បី ធានា និរន្តភាព បរិស្ថាន និង ជីវភាព សហគមន៍ ប្រជា សហគមន៍ ត្រូវ នាំគ្នា ដាំ ដើមឈើ ឱ្យ បាន ច្រើន ពីព្រោះ ដើមឈើ គឺជា ប្រភព ប្រាក់ ចំណូល តាមរយៈ ការទាញ ចំណូល ពី ការលក់ កាបូន ហើយ ចំណូល ពី ការលក់ បូន នឹង ជួយ ដល់ ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ និង ធ្វើឱ្យ ប្រជាពលរដ្ឋ មាន ចំណូល បន្ថែម លើស ពី ចំណូល តាមរយៈ ភ្ញៀវ ទេសចរ នា ពេល បច្ចុប្បន្ន នេះ ។
គួរ រម្លឹក ដែល ថា យុទ្ធសាស្រ្ត បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ដំណាក់កាល ទី១ នៃ មុំ ទី២ ទី៤ និង ទី៥ គឺ ធានា ចីរភាព នៃ ការអភិវឌ្ឍ សង្គម សេដ្ឋកិច្ច និង កសាង ភាពធន់ ទៅនឹង ការប្រែប្រួល អាកាសធាតុ ការអភិវឌ្ឍ ប្រកបដោយ ភាពធន់ ចីរភាព និង បរិយា បន្ន ដោយ ជំរុញ ការលើកកម្ពស់ ការទាក់ទាញ វិនិយោគ ក្នុង ឧស្សាហកម្ម ដែល មាន តម្លៃ បន្ថែម ខ្ពស់ និង ឧស្សាហកម្ម បៃតង ។ រដ្ឋាភិបាល មាន ផែនការរក្សា គំរប ព្រៃឈើ ឱ្យ បាន ៦០ ភាគរយ នៅ ឆ្នាំ ២០៣០ ។
លោក រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ចាត់ទុក ការងារ បរិស្ថាន គឺ មាន ភាព សំខាន់ ជា សកល ដូចនេះ ក្រសួង បាន ដាក់ចេញ យុទ្ធនាការ រួម មាន៖
ទី ១៖ ជំរុញ និង ចូលរួម ក្នុង យុទ្ធនាការ « ថ្ងៃ នេះ ខ្ញុំ មិន ប្រើ ថង់ ប្លាស្ទិក ទេ » ចាប់ពី ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២៣ និង រហូតដល់ ពេលនេះ មាន ការចូលរួម ពី សាលា គ្រប់ កម្រិត ទូទាំង ប្រទេស ប្រមាណ ជាង ១ម៉ឺន ១ពាន់ និង សិស្សានុសិស្ស ដែល ជា យុវជន ជំនាន់ ក្រោយ ជាង ១.៥លាន នាក់
