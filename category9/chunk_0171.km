( កំពង់ឆ្នាំង ) ៖ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង នៅ ព្រឹក ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន បើក យុទ្ធនាការផ្ដល់ ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដល់ កុមារី អាយុ ៩ ឆ្នាំ ជា ផ្លូវការ នៅ ទូទាំង ខេត្ត ។
យុទ្ធនាការ នេះ ចាប់ពី ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ តទៅ នេះ ក៏ ជា ថ្នាំ ថ្មី មួយ មុខ ទៀត បន្ថែម ពីលើ ថ្នាំ បង្ការ ជំងឺ ទាំង ១១ មុខ នា ពេល កន្លងមក ដែល រាជ រដ្ឋាភិបាល បាន យកមក ចាក់ ជូន កុមារ នូវ ទូទាំង ប្រទេស ដោយ ឥត គិត ថ្លៃ ។
ឆ្លៀត ក្នុង ឱកាស នេះ លោក វេជ្ជបណ្ឌិត ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល លោក បាន ខិតខំ ប្រឹងប្រែង គិតគូរ ពី សុខភាព សាធារណៈ និង បាន នាំមក នូវ វ៉ាក់សាំង ជាច្រើន ប្រភេទ ចាក់ ជូន ដល់ ទារក រហូតដល់ កុមារ អាយុ ៩ ឆ្នាំ នៅ ទូទាំង ប្រទេស ដោយ មិន គិត ថ្លៃ ផងដែរ ។
លោក ក៏ បាន បញ្ជាក់ ថា ចំពោះ វ៉ាក់សាំង ការពារ ជំងឺ មហារីក មាត់ ស្បូន នេះ បើ ចាក់ តាម មន្ទីរពេទ្យ ឯកជន នានា មាន តម្លៃ ប្រមាណ ចាប់ពី ៧០ ដុល្លារ ឡើង ទៅក្នុង មួយ ម្ជុល ។
ជួស មុខ ឱ្យ មាតាបិតា និង អាណាព្យាបាល របស់ កុមារ នៅ ទូទាំង ខេត្ត កំពង់ឆ្នាំង លោក សូម គោរព ថ្លែងអំណរគុណ ដល់ លោក អភិបាល ខេត្ត លោក រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ពិសេស សម្ដេច ធិបតី ដែល លោក តែងតែ គិតគូរ អំពី សុខ មាលភាព របស់ ប្រជាពលរដ្ឋ ដោយ នាំមក នូវ ថ្នាំ បង្ការ សុខភាព ដ៏ សំខាន់ នេះ ចាក់ ជូន ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ក៏ ដូចជា ប្រជាពលរដ្ឋ ក្នុង ខេត្ត កំពង់ឆ្នាំង នេះ ផងដែរ ។
លោក អភិបាល រង ខេត្ត បាន អំពាវនាវ ដល់ មាតា បិតា អាណាព្យាបាល កុមារ ទាំងអស់ សូម នាំ កូន មក ទទួល វ៉ាក់សាំង របស់ កម្មវិធី ជាតិ ផ្ដល់ ថ្នាំ បង្ការ ឱ្យ បាន គ្រប់ ៗ គ្នា នៅ តាម សាលារៀន មណ្ឌល សុខភាព ឬ តាមរយៈ បុគ្គលិក ផ្ដល់ ថ្នាំ បង្កា នៅ តាម ភូមិ ទៅ តាម ផែនការ និង តាម ការណាត់ របស់ បុគ្គលិក សុខាភិបាល ។
លោក បាន បញ្ជាក់ ថា អាណាព្យាបាល ទាំងអស់ ត្រូវ យល់ ថា វ៉ាក់សាំង បង្ការ ជំងឺ មហារីក មាត់ ស្បូន មួយ ដុស នេះ នឹង នាំមក នូវ សុភមង្គល ដល់ បុត្រធីតា របស់ លោក អ្នក ពេញ មួយ ជីវិត ។ យើង ចិញ្ចឹម ថែទាំ បុត្រធីតា តែងតែ រមែង ចង់ ឃើញ កូន មាន សុខភាព ល្អ សម្រស់ ស្អាត និង មាន សុភមង្គល តែ បើ នៅ ពេល ដែល បុត្រធីតា អ្នក កើត ជំងឺ មហារីក មាត់ ស្បូន ហើយ នោះ នឹង បាត់បង់ គ្រប់ យ៉ាង កុំ ថា ឡើយ សម្រស់ គឺ បាត់បង់ សុភមង្គល ទាំងស្រុង ។
ជាមួយគ្នា នោះ ដែរ លោក អភិបាល រង ខេត្ត ក៏ បាន លើកទឹកចិត្ត ដល់ មន្ត្រី បុគ្គលិក សុខាភិបាល និង អង្គការ ដៃគូ អភិវឌ្ឍន៍ ទាំងអស់ ត្រូវ រួមគ្នា ដើ ម្បី ការពារ សុខភាព កុមារ ទាំងអស់ នៅក្នុង ខេត្ត កំពង់ឆ្នាំង ។
ដោយឡែក មាតាបិតា និង អាណាព្យាបាល របស់ សិស្ស ដែល បាន នាំ បុត្រធីតា របស់ ខ្លួន មក ទទួល ការចាក់ វ៉ាក់សាំង បង្ការ រោគ មហារីក មាត់ ស្បូន នា ឱកាស នោះ ក៏ បាន អរគុណ ចំពោះ ក្រសួង សុខាភិបាល ដែល បាន សម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ និង ដ៏ មាន សារៈសំខាន់ ជា ប្រវត្តិសាស្ត្រ ដោយ បាន ផ្ដល់ នូវ ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដល់ កុមារី អាយុ ៩ ឆ្នាំ ដែល ជា យុទ្ធសាស្ត្រ ការពារ ដ៏ ចម្បង មួយ ដើម្បី ឆ្ពោះ ទៅរក ការលុបបំបាត់ នូវ ជំងឺ មហារីក មាត់ ស្បូន ឱ្យ បាន ទាំងស្រុង នា ពេល អនាគត ។
ពួកគាត់ ក៏ បាន ថ្លែងអំណរគុណ ដ៏ ជ្រាលជ្រៅ ជា ទីបំផុត ចំពោះ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ដែល លោក កំពុងតែ ទទួលបាន នូវ ស្នាដៃ និង ការគាំទ្រ យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ ពី ប្រជាពលរដ្ឋ ក្នុង ការដឹកនាំ បន្ត វេន ពី សម្ដេច តេជោ ហ៊ុន សែន ដែល ជា មគ្គុទេសក៍ ដ៏ ឆ្នើម របស់ កម្ពុជា ៕
( ភ្នំពេញ ) ៖ ក្នុង រយៈពេល ជាង ១ខែ ស្មើនឹង ៤៥ ថ្ងៃ រាប់ គិត ចាប់តាំងពី ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២៣ មកដល់ ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ក្រសួង សុខាភិបាល ក្រោម ការដឹកនាំ របស់ លោក សាស្ត្រាចារ្យ ឈាង រ៉ា បាន សម្រេច នូវ សមិទ្ធផល មួយចំនួន ។
តាមរយៈ កិច្ចសម្ភាស ជិត ៧នាទី របស់ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា បាន ថ្លែង ថា ការងារ ចំនួន ៤៥ ថ្ងៃ បន្ទាប់ពី ការចាប់ ដំណើរការ រាជ រដ្ឋាភិបាល អាណត្ដិ ថ្មី ក្រសួង សុខាភិបាល បាន ចាប់ផ្ដើម ធ្វើ ការងារ ជាមួយ សហភាតរៈ យ៉ាង សកម្ម ដើម្បី លើកស្ទួយ សុខភាព ប្រជាពលរដ្ឋ តាម អាទិភាព ទាំង៣ ក្នុង ចំណោម អាទិភាព ជាច្រើន ទៀត ហើយ សមិទ្ធផល ក៏ មាន ជា បន្ដ បន្ទាប់ ផងដែរ ។
សូម ជម្រាប ថា កិច្ចសម្ភាស របស់ លោក រដ្ឋមន្ដ្រី ឈាង រ៉ា បាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ប្រកាស ដាក់បញ្ចូល ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដែល ត្រូវ ផ្តល់ តែ ចំនួន មួយ ដូស ដល់ កុមារី ម្នាក់ ៗ ដែល មាន អាយុ ៩ឆ្នាំ ដោយ ឥត គិត ថ្លៃ ទៅក្នុង កម្មវិធី ជាតិ ផ្ដល់ ថ្នាំ បង្ការ ដើម្បី ការពារ ជំងឺ មហារីក មាត់ ស្បូន នៅ ព្រឹក ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ ។
ដើម្បី ទទួលបាន ព័ត៌មាន លម្អិត សូម លោក អ្នកទស្សនា នូវ កិច្ចសម្ភាស របស់ លោក រដ្ឋមន្ដ្រី ឈាង រ៉ា ដូចត ទៅ៖
( សៀមរាប ) ៖ លោក ឡុង កុសល អគ្គ នាយក រង និង ជា អ្នកនាំពាក្យ អាជ្ញាធរ ជាតិ អប្សរា បាន បញ្ជាក់ ថា ការថត រូបភាព និង វីដេអូ អនុស្សាវរីយ៍ ផ្ទាល់ខ្លួន ពុំ មាន ការតម្រូវឲ្យ សុំ ការអនុញ្ញាត ជាមុន នោះ ទេ ។ ចំពោះ ការថត នូវ សម្លៀកបំពាក់ ប្រពៃណី ការថត រូបភាព មុន អាពាហ៍ពិពាហ៍ ថត YouTube ការថត ផ្សាយ ផ្ទាល់ ជា លក្ខណៈ មគ្គុទ្ទេសក៍ ការថត ខ្សែភាពយន្ត ការថតចម្រៀង កាយវិការ និង ការថត រូប ក្នុង គោលបំណង អាជីវកម្ម ផ្សេង ៗ ចាំបាច់ ត្រូវ មាន ការអនុញ្ញាត ជាមុន ។
លោក ឡុង កុសល បាន បញ្ជាក់ ថា ភាពចាំបាច់ នៃ ការតម្រូវឲ្យ មាន ការអនុញ្ញាត ជាមុន ពីព្រោះ ត្រូវ ប្រតិបត្តិ នូវ គោលការណ៍ គតិយុត្ត ដែល មាន ជាធរមាន ផង និង ដើម្បីឲ្យ ផ្នែក ជំនាញ របស់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ក៏ ដូចជា អាជ្ញាធរ ជាតិ អប្សរា អាច ជួយ កែតម្រូវ ឬ ផ្តល់ យោបល់ កែលម្អ នូវ ខ្លឹមសារ ផ្សេង ៗ ដូចជា ប្រវត្តិសាស្រ្ត ទម្រង់ សិល្បៈ ឲ្យបាន ត្រឹមត្រូវ ព្រមទាំង ចៀសវាង នូវ មតិ រិះគន់ ពី សាធារណជន នៅពេល រូបភាព ឬ ខ្លឹមសារ រឿង ទាំងនោះ ចេញផ្សាយ ជាសាធារណៈ ។
ជាមួយគ្នា នេះ ដែរ អាជ្ញាធរ ជាតិ អប្សរា នឹង ធ្វើ ការកែសម្រួល អំពី យន្តការពាក់ព័ន្ធ នឹង ការកាត់បន្ថយ ពេលវេលា នៃ ការស្នើសុំ កាត់បន្ថយ ដំណើរការ នីតិវិធី ស្នើសុំ ដើម្បី ធ្វើ យ៉ាងណា ឲ្យ សាធារណជន មាន ការងាយស្រួល និង បង្កើន ប្រសិទ្ធភាព ការងារ បាន កាន់តែ ងាយស្រួល និង រលូន ជាង មុន ។ អាជ្ញាធរ ជាតិ អប្សរា ក៏ នឹង រៀបចំ ឲ្យ មាន Call Center និង បង្កើត ប្រព័ន្ធ ស្នើសុំ Online ដើម្បី សាធារណជន អាច ស្នើសុំ តាម ប្រព័ន្ធ បច្ចេកវិទ្យា បាន យ៉ាង ឆាប់រហ័ស និង ចំណេញ ពេលវេលា ៕
រដ្ឋមន្ត្រី ក្រសួង ការងារ គាំទ្រ ក្រុមហ៊ុន ចិន ធំ មួយ ស្វែងរក កម្លាំង ពលកម្ម ជាង ៦ ពាន់ នាក់ សម្រាប់ បំពេញ តម្រូវការវិនិយោគ ថ្មី
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ប្រកាស ផ្តល់ ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ក្នុង ការផ្តល់ ជំនួយ ស្វែងរក កម្លាំង ពលកម្ម ចំនួន ជាង ៦ ពាន់ នាក់ ដើម្បី បំពេញ កង្វះខាត ក្នុង ខ្សែ ចង្វាក់ ផលិតកម្ម នៃ ការពង្រីក ការវិនិយោគ រោងចក្រ កាត់ដេរ ទី២ របស់ ក្រុមហ៊ុន ចិន ធំ មួយ នៅក្នុង ខេត្ត កំពង់ស្ពឺ ដែល គ្រោង នឹង ដាក់ ឱ្យ ដំណើរការ ចង្វាក់ ផលិតកម្ម នៅពេល ខាងមុខ នេះ ។
នៅក្នុង ជំនួប ពិភាក្សា នោះ លោក រដ្ឋមន្ត្រី បាន សម្តែង អំណរ សាទរ ចំពោះ ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ របស់ ក្រុមហ៊ុន កាត់ដេរ ជេនេរ៉ល អេនធើ ប្រាយ ហ្កា មិន ( ខេមបូឌា ) ឯ . ក . ក្នុង ការពង្រីក ការវិនិយោគ រោងចក្រ កាត់ដេរ គម្រោង ទី២ របស់ ខ្លួន នៅក្នុង ខេត្ត កំពង់ស្ពឺ ដោយ បាន នាំយក បច្ចេកវិទ្យា ចុងក្រោយ ដើម្បី ជួយ ជំរុញ ខ្សែ ចង្វាក់ ផលិតកម្ម ។
លោក ហេង សួរ មានប្រសាសន៍ ថា តាមរយៈ បទពិសោធន៍ ច្រើន ឆ្នាំ នៃ ការដំណើរការ របស់ ក្រុមហ៊ុន និង ការប្រើប្រាស់ នូវ បច្ចេកវិទ្យា ទំនើប ឯកឧត្តម ជឿជាក់ ថា ការវិនិយោគ នេះ នឹង ឆ្លើយតប ទាំង ផ្នែក ការងារ បរិស្ថាន និង ស្តង់ដារ អន្តរជាតិ ព្រមទាំង នឹង ទទួលបាន ការគាំទ្រ ពីសំណាក់ ភាគី ពាក់ព័ន្ធ ។
លោក រដ្ឋមន្ត្រី បាន ជំរុញ ឱ្យ ក្រុមហ៊ុន សហការ ជាមួយ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ (NEA) នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បន្ថែម លើ មធ្យោបាយ របស់ ខ្លួន ដើម្បី ពិនិត្យមើល លើ ការស្វែងរក បុគ្គលិក ប្រមាណ ជាង ៦ ពាន់ នាក់ ដើម្បី ចូល បំពេញ ការងារ នៅក្នុង រោងចក្រ ហើយ ក្រសួង ក៏ រីករាយ ក្នុង ការជួយជ្រោមជ្រែង ក្នុង ការស្វែងរក កម្មករ និយោជិត នៅ តាម បណ្តា ខេត្ត នានា នៃ ប្រទេស កម្ពុជា ផងដែរ ។
ជា ការឆ្លើយតប លោក អគ្គ នាយក ក្រុមហ៊ុន បាន ថ្លែងអំណរគុណ ចំពោះ លោក រដ្ឋមន្ត្រី ហេង សួរ ដែល បាន គាំទ្រ និង ផ្តល់ ជំនួយ ក្នុង ការស្វែងរក កម្លាំង ពលកម្ម ដើម្បី ជំរុញ ផលិតកម្ម នៃ ការវិនិយោគ ថ្មី របស់ ក្រុមហ៊ុន ។ ជាមួយគ្នា នេះ ក្រុមហ៊ុន នឹង បន្ត ធ្វើ ការ យ៉ាង ជិតស្និត ជាមួយនឹង ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ ដើម្បី ស្វែងរក បុគ្គលិក មក បំពេញ ការងារ ឱ្យ បាន ឆាប់ រហ័ស សម្រាប់ ដំណើរការ នៃ រោងចក្រ ថ្មី ដែល ទើប សាងសង់ រួច ។
ឆ្លៀត ក្នុង ឱកាស នេះ ដែរ លោក វេជ្ជ. បាន បន្ត អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ សូម ចូលរួម កាត់បន្ថយ ការប្រើប្រាស់ ថង់ ប្លាស្ទិក ពីព្រោះ នៅពេល ចុះ ពិនិត្យ ស្ថានភាព ទឹក លិច ដោយ ជំនន់ ទឹកភ្លៀង តែងតែ ឃើញ ថង់ ប្លាស្ទិក គ្រប់ ទីកន្លែង ដែល ផ្តល់ ផល ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ និង បរិស្ថាន ជាក់ស្តែង ថ្មី ៗ កន្លងទៅ នេះ កាកបាទ ក្រហម កម្ពុជា ទើប បាន ចូលរួម ក្នុង យុទ្ធនាការ កាត់បន្ថយ ការប្រើប្រាស់ ថង់ ប្លាស្ទិក ក្រោម ប្រធានបទ « ថ្ងៃ នេះ ខ្ញុំ មិន ប្រើ ថង់ ប្លាស្ទិក ទេ » នៅ កំពង់ឆ្នាំង ។
បន្ទាប់ពី បញ្ចប់ កម្មវិធី ផ្តល់ អំណោយ នេះ ឯកឧត្តម វេជ្ជ. អ៊ុយ សំអាត និង សហការី បាន បន្ត នាំយក អំណោយ មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ ចំនួន ៤ខ្នង ផ្ទះ ដែល មិន អាច ធ្វើដំណើរ មក ទទួល អំណោយ បាន ។
សូម ជម្រាប ថា បន្ទាប់ពី សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន សម្រេច ផ្ដល់ អំណោយ មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ចំនួន ១. ៨៤៥ គ្រួសារ ក្នុង ឃុំ ចំនួន ១៦ នៃ ក្រុង ពោធិ៍សាត់ ស្រុក កណ្ដៀង វាល វែង និង ស្រុក ភ្នំ ក្រវាញ ខេត្ត ពោធិ៍សាត់ កាលពី ថ្ងៃទី ៣ ខែតុលា ឆ្នាំ ២០២៣ . នៅ ថ្ងៃទី ៤- ៥ ខែតុលា នេះ មន្ដ្រី ស្នាក់ការ កណ្ដាល និង សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ពោធិ៍សាត់ បាន ចុះ ទៅ ចែក អំណោយ មនុស្សធម៌ ដល់ ទីតាំង គ្រួសារ រងគ្រោះ ដោយ ផ្ទាល់ ៕
លោក កាន់ សុគន្ធ មេឃុំ ព្រៃ នប់ បាន ឲ្យដឹង ថា ក្នុង ដំណើរការ សាងសង់ ផ្លូវ បេតុង នានា ក៏ ដូចជា ផ្លូវ បេតុង មួយ ខ្សែ ៥៦៦ ម៉ែត្រ នៅក្នុង ភូមិ ព្រៃ នប់១ និង ព្រនប់២ ឃុំ ព្រៃ នប់ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ក្នុង នាម រូប លោក ផ្ទាល់ អ្នកជំនាញ ព្រមទាំង ក្រុមការងារ ពិត ណាស់ គឺ បាន យកចិត្តទុកដាក់ បំផុត លើ កិច្ចការ នេះ ដោយ បាន ចុះ ត្រួតពិនិត្យ សិក្សា ជាប្រចាំ ដើម្បី ផ្តោត សំខាន់ ទៅ លើ គុណភាព ជា ចម្បង តាំងពី ការចាប់ផ្តើម បើក គម្រោង សាងសង់ រហូតដល់ ពេល បញ្ចប់ ។
លោក បន្ត ទៀត ថា « ក្នុង នាម រូប លោក ផ្ទាល់ ជា អ្នកទទួល គម្រោង ទោះបីជា ខ្ញុំ មិន មែន ជា អ្នកជំនាញ ក្នុង កិច្ចការ នេះ ក្តី តែ ខ្ញុំ បាន ណែនាំ និង ដាក់ បញ្ជា មន្ត្រី ថ្នាក់ ក្រោម ព្រមទាំង ក្រុមការងារ ជំនាញ តាមដាន ត្រួតពិនិត្យ រហូតមក ហើយក៏ មិន ដូច អ្វី ដែល ពាក្យ ចរចាម រាម ថា ការសាងសង់ នេះ មិន ត្រូវ តាម ស្តង់ដារ បច្ចេកទេស កេងប្រវ័ញ្ច ខុសពី ការពិត មាន ការឃប់ ឃិត ជា ប្រព័ន្ធ អ្វី ដូច ទៅ តាម ការចាក់ផ្សាយ កន្លងមក នោះ ទេ » ។
ក្នុង ឱកាស នោះ ប្រជាពលរដ្ឋ ជាច្រើន គ្រួសារ រស់ នៅក្នុង ភូមិ ព្រៃ នប់១ និង ព្រនប់២ មាន ការសាទរ និង រីករាយ យ៉ាង ខ្លាំង នៅពេល ទទួលបាន ផ្លូវ បេតុង ថ្មី ពីរ ខ្សែរ នេះ ដែល មាន ប្រវែង ៥៦៦ ម៉ែត្រ ទទឹក ៥ម៉ែត្រ ដែល ពីមុន ជា ផ្លូវ ក្រាល ដី ស ហើយ ពិតជា ពិបាក ក្នុង ការធ្វើដំណើរ ធ្លាប់ ដើរ ធ្លាប់ ជិះ ម៉ូតូ កាត់ ភក់ ជ្រាំ ពិបាក ក្នុង ការធ្វើដំណើរ ពេល ទៅ ណា មក ណា មាន ការយឺតយ៉ាវ មិន ទាន់ ចិត្ត ម៉ូតូ ប្រលាក់ ឡាន ប្រលាក់ ជាពិសេស រដូវ វស្សា ឱ្យ តែ មេឃ ភ្លៀង គឺ យ៉ាប់ ក្នុង ការធ្វើដំណើរ ណាស់ ។
រដ្ឋមន្ត្រី ក្រសួងស ការងារ និង សហព័ន្ធ និយោជក និង សមាគម ពាណិជ្ជកម្ម កម្ពុជា ឯកភាព ពង្រឹង សមត្ថភាព ជំនាញ បច្ចេកទេស ដល់ បុគ្គលិក
( ភ្នំពេញ ) ៖ លោក ហេង សួរ រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ៤ ខែតុលា ឆ្នាំ ២០២៣ បាន ជួប ពិភាក្សា ការងារ ជាមួយ គណៈប្រតិភូ សហព័ន្ធ និយោជក និង សមាគម ពាណិជ្ជកម្ម កម្ពុជា ដែល ដឹកនាំ ដោយ លោក ឧកញ៉ា សុខ ពិសិដ្ឋ នៅ ទីស្តីការ ក្រសួង ការងារ បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
ជា បឋម ប្រតិភូ សហព័ន្ធ និយោជក និង សមាគម ពាណិជ្ជកម្ម កម្ពុជា បាន អបអរសាទរ ជូន លោក ហេង សួរ ដែល ត្រូវបាន តែងតាំង ជា រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក្នុង អាណត្តិ ទី៧ នេះ ។ ក្នុង ជំនួប ប្រកបដោយ ភាពស្និទ្ធស្នាល នោះ ភាគី ទាំង ពីរ បាន ឯកភាព ក្នុង ការពង្រឹង ការបណ្តុះបណ្តាល ជំនាញ បច្ចេកទេស ដល់ បុគ្គលិក ក្នុង រោងចក្រ សហគ្រាស ដើម្បី បង្កើន ផលិតភាព ការងារ និង លក្ខខណ្ឌ ការងារ កាន់តែ ល្អ ប្រសើរ ។
បន្ថែម ពី នេះ លោក រដ្ឋមន្ត្រី ជំរុញ បន្ថែម ទៀត ឱ្យ វិស័យ ឯកជន បន្ត ពង្រឹង ការអនុវត្ត កាតព្វកិច្ច បណ្តុះបណ្តាល កូន ជាង និង បុគ្គលិក ហាត់ការ ដើម្បី ផ្សារ ភា្ជប់ ទ្រឹស្តី ជាមួយនឹង ជំនាញ ផ្ទាល់ ក្នុង គោលបំណង ឆ្លើយតប ប្រកបដោយ ប្រសិទ្ធិភាព ខ្ពស់ សម្រាប់ តម្រូវការ ទីផ្សារ ដែល កំពុង មាន ភាពប្រកួតប្រជែង ។
ទន្ទឹមនឹង នេះ លោក រដ្ឋមន្ត្រី បាន ជំរុញ វិស័យ ឯកជន បន្ត អនុវត្ត ឱ្យ បាន ពេញលេញ លើ កាតព្វកិច្ច របប សន្តិសុខ សង្គម លើ ផ្នែក គ្រោះថ្នាក់ ការងារ និង ការថែទាំ សុខភាព និង ប្រាក់ សោធន ដែល ជា ការគិតគូរ ដល់ កម្មករ និយោជិត ។
ក្នុង ការជជែក ពិភាក្សា ត្រង់ ទៅ ត្រង់ មក ភាគី ទាំង ពីរ បាន ឯកភាព គ្នា ជំរុញ កិច្ចសហប្រតិបត្តិការ និង ការគាំទ្រ គ្នា ដើម្បី បរិយាកាស នៃ ការវិនិយោគ ដែល អំណោយផល ក៏ ដូចជា ទំនាក់ទំនង វិជ្ជាជីវៈ ក្នុង រោងចក្រ សហគ្រាស ឱ្យ កាន់តែ ប្រសើរឡើង មួយ កម្រិត ទៀត ។
មុននឹង បញ្ចប់ លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ ដល់ វិស័យ ឯកជន ដែល បាន គាំទ្រ ចំពោះ ការដំឡើង ប្រាក់ ឈ្នួល អប្បរមា ចំនួន ២០៤ ដុល្លារ សម្រាប់ ឆ្នាំ ២០២៤ ដល់ កម្មករ និយោជិត ក្នុង វិស័យ ផ្នែក វាយន ភណ្ឌ កាត់ដេរ ផលិត ស្បែកជើង និង ផលិតផលិតផល ធ្វើដំណើរ និង កាបូប ៕
ធនាគារ ហត្ថា ចេញ សេចក្តី បំភ្លឺ ព័ត៌មាន ច្រានចោល ការចោទប្រកាន់ ថា « មន្ត្រី ធនាគារ ហត្ថា បាន បង្ខំ ឲ្យ អតិថិជន ម្នាក់ លក់ ទ្រព្យសម្បត្តិ ដើម្បី យក លុយ ទៅ សង ធនាគារ » និង អះអាង គ្មាន ករណី បែប នេះ ទេ
សេចក្ដីបំភ្លឺ ព័ត៌មាន បាន ឲ្យដឹង ថា នា ពេល ថ្មី ៗ កន្លងមក នេះ ធនាគារ ហត្ថា បាន សង្កេតឃើញ ថា មាន បណ្តាញ ទំនាក់ទំនង សង្គម មួយ ចំនួន បាន ផ្សាយ ព័ត៌មាន ប្រាសចាក ពី ការពិត ក្នុង ន័យ ញុះញង់ ចោទប្រកាន់ និង បង្អូច កេរ្តិ៍ឈ្មោះ ធនាគារ ហត្ថា ដោយ បាន ចុះផ្សាយ ថា មន្ត្រី ធនាគារ ហត្ថា បាន បង្ខំ ឲ្យ អតិថិជន ម្នាក់ ដែល បច្ចុប្បន្ន កំពុង រស់ នៅក្នុង ភូមិ ពោធិ៍ អណ្តែត សង្កាត់ ព្រែក ស្តី ក្រុង សំពៅ ពូន ខេត្ត កណ្តាល លក់ ទ្រព្យសម្បត្តិ ដើម្បី យក លុយ ទៅ សង ធនាគារ ។
ករណី នេះ ធនាគារ ហត្ថា សូម ធ្វើ ការបំភ្លឺ និង បញ្ជាក់ ថា ពុំ មាន ករណី ដូច ការចោទប្រកាន់ និង បង្កាច់បង្អួច ខាងលើ នោះ ឡើយ ។ កន្លងមក មន្រ្តី ធនាគារ ហត្ថា តែងតែ ប្រកាន់ យ៉ាង ខ្ជាប់ខ្ជួន នូវ ដំណោះស្រាយ ប្រកបដោយ ភាពទន់ភ្លន់ មាន ក្រមសីលធម៌ វិជ្ជាជីវៈ ខ្ពស់ និង មាន ការយោគយល់ អធ្យាស្រ័យ យ៉ាង ច្រើន ជាមួយ អតិថិជន របស់ ខ្លួន ។
ធនាគារ ហត្ថា ប្រកាន់ខ្ជាប់ ជានិច្ច វិជ្ជាជីវៈ ក្នុង ការធ្វើ អាជីវកម្ម និង ជា គ្រឹះស្ថាន ដែល បម្រើ សេវា ហិរញ្ញវត្ថុ ប្រកបដោយ ភាពកក់ក្ដៅ តម្លាភាព និង សុក្រឹតភាព ដើម្បី ការរីកចម្រើន របស់ សាធារណជន ទូទៅ ។
ធនាគារ ហត្ថ បាន នឹង កំពុង អនុវត្ត យ៉ាង ពេល លេញ នូវ យន្តការ ច្បាប់ តាម ផ្លូវ តុលាការ ស្រប តាម ច្បាប់ និង បទប្បញ្ញត្តិ ជាធរមាន ក្នុង ករណី មាន ការលក់ ទ្រព្យសម្បត្តិ សង បំណុល ចំពោះ អតិថិជន ណា ដែល មាន លទ្ធភាព សង ត ពុំ មាន ឆន្ទៈ សង ។
អាស្រ័យ ដូច បាន ជម្រាប ជូន ខាងលើ សូម សាធារណជន ទាំងអស់ មេត្តា ជ្រាប ជា ព័ត៌មាន ។ ជាមួយគ្នា នេះ ធនាគារ ហត្ថា សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ អតិថិជន និង សាធារណជន ទាំងអស់ ដែល តែងតែ គាំទ្រ និង បន្ត ការ គាំទ្រ សេវាកម្ម របស់ ធនាគារ ហត្ថា កន្លងមក និង តទៅ អនាគត ៕ ខេត្ត ត្បូងឃ្មុំ ប្រកាស ដាក់បញ្ចូល ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ក្នុង កម្មវិធី ជាតិ ផ្ដល់ ថ្នាំ បង្ការ ដល់ កុមារី មាន អាយុ ៩ ឆ្នាំ ដោយ ឥត គិត ថ្លៃ
( ត្បូងឃ្មុំ ) ៖ មន្ទីរ សុខាភិបាល ខេត្ត ត្បូងឃ្មុំ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ បាន ប្រកាស ជា ផ្លូវការដាក់បញ្ចូល ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដល់ កុមារី ដែល មាន អាយុ ៩ ឆ្នាំ ដោយ ឥត គិត ថ្លៃ ទៅក្នុង កម្មវិធី ជាតិ ផ្ដល់ ថ្នាំ បង្ការ ដើម្បី ការពារ ជំងឺ មហារីក មាត់ ស្បូន ដើម្បី សង្គ្រោះ ជីវិត ពី សេចក្តីស្លាប់ ដែល បណ្តាល មកពី ជំងឺ មហារីក មាត់ ស្បូន ។
ពិធី នេះ ប្រព្រឹត្តិ ទៅ ក្រោម អធិបតីភាព លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី អភិបាល រង ខេត្ត ប្រធាន / អនុប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត នាយក / នាយក រដ្ឋបាល សាលា ខេត្ត អាជ្ញាធរ ក្រុង ប្រធាន មណ្ឌល សុខភាព ប្រតិបត្តិ ទាំង ៧ក្រុង / ស្រុក លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ដែល ធ្វើឡើង នៅ បរិវេណ សាលា បឋមសិក្សា រស្មី កុមារ សួង ស្ថិត នៅ ក្រុង សួង ខេត្ត ត្បូងឃ្មុំ ។
នា ឱកា សោះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន លើកឡើង ថា ជំងឺ មហារីក មាត់ ស្បូន គឺជា អាទិភាព សុខភាព សាធារណៈ ដែល ត្រូវ យកចិត្តទុកដាក់ នៅ ប្រទេស កម្ពុជា ។ យើង ទាំងអស់ គ្នា ត្រូវ ពន្លឿន កិច្ច ខិតខំ ប្រឹងប្រែង រួមគ្នា ដើម្បី លុបបំបាត់ ជំងឺ ដ៏ កាច សាហាវ នេះ តាមរយៈ ការបញ្ចូល វ៉ាក់សាំង ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ទៅក្នុង កម្មវិធី ជាតិ ផ្តល់ ថ្នាំ បង្ការ នៅ ប្រទេស កម្ពុជា ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា៖ « យើង នឹង ធានា ថា កុមារី អាយុ ៩ឆ្នាំ ទាំងអស់ នឹង ទទួលបាន ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន មួយ ដូស ដោយ ឥត គិត ថ្លៃ ចាប់ពី ថ្ងៃ នេះ តទៅ ហើយ កម្ពុជា ក៏ មាន គម្រោង នឹង ផ្តល់ ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដល់ កុមារី ដែល មាន អាយុ លើស ពី ៩ ឆ្នាំ តាមរយៈ ការធ្វើ យុទ្ធនាការ ក្នុង ឆ្នាំ ២០២៥ ផងដែរ » ។
ទន្ទឹម នឹង នោះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន អំពាវនាវ ដល់ អាណាព្យាបាល ចំពោះ កូន ៗ ដែល គ្រប់ អាយុ ចាក់ វ៉ាក់សាំង មហារីក មាត់ ស្បូន សូមអញ្ជើ នាំ មក ទទួល ការចាក់ វ៉ាក់សាំង ដោយ ឥត គិត ថ្លៃ នៅ តាម មន្ទីរពេទ្យ រដ្ឋ ឬ មណ្ឌល សុខភាព ដែល នៅជិត នៅ ផ្ទះ ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន បញ្ជាក់ ថា ក្រោម ម្លប់ សន្តិភាព រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ មាន ការរី ចម្រើន លើ ការស្ថាបនា ហេដ្ឋារចនាសម្ព័ន្ធ និង សមិទ្ធផល នានា ជាច្រើន មាន ដូចជា នៅក្នុង ក្រុង សួង បាន នឹង កំពុង ស្ថាបនា កសាង សួនច្បារ សាធារណៈ មួយ កន្លែង មាន ទីតាំង ជាប់ នឹង វត្ត វិហារ ទន្ទឹម . ការស្ថាបនា រូបសំណាក រង្វង់ មូល ហ្លួង ព្រះស្តេច ក ន ( ផ្លូវ ចូល មកកាន់ តំបន់ រដ្ឋបាល ខេត្ត ) និង ពង្រីក ផ្លូវ បេតុង នៅ បរិវេណ ក្បែរ នោះ អោយ ធំ ទូលាយ ជាដើម ។
យ៉ាងណា ក៏ដោយ ខាង មន្ត្រី ម្នាក់ មកពី ក្រសួង ការពារ ជាតិ តួកគី បាន អះអាង ថា យន្ដហោះ ដ្រូន ដែល ត្រូវបាន បាញ់ ទម្លាក់ នោះ មិន មែន ជា កម្មសិទ្ធិ របស់ កងកម្លាំងប្រដាប់អាវុធ តួកគី នោះ ទេ ហើយក៏ មិន បាន បញ្ជាក់ ថា កម្មសិទ្ធិ របស់ នរណា នោះ ដែរ ។ ប៉ុន្តែ បើ ជា ការពិត មែន នោះ វា នឹង ក្លាយជា លើក ដំបូង បំផុត ដែល សហរដ្ឋ អាមេរិក បាញ់ ទម្លាក់ យន្ដហោះ ដ្រូន របស់ ប្រទេស ជា សម្ព័ន្ធមិត្ត NATO ដូចជា តួកគី ។
( សៀមរាប ) ៖ ក្រសួង ទេសចរណ៍ បាន រៀបចំ កិច្ចពិភាក្សា ការងារ ជាមួយ ផ្នែក ឯកជន ក្នុង វិស័យ ទេសចរណ៍ ខេត្ត សៀមរាប ដើម្បី ប្រមូល ធាតុ ចូល អំពី បញ្ហា ប្រឈម និង សំណូមពរ របស់ ប្រតិបត្តិករ ទេសចរណ៍ ក៏ ដូចជា តម្រូវការ ជាក់ស្ដែង របស់ ទេសចរ ជាតិ និង អន្តរជាតិ ធ្វើ យ៉ាងណា រិះរក វិធីសាស្រ្ត និង ដំណោះស្រាយ រួមគ្នា ចំពោះ វិស័យ ទេសចរណ៍ ជាតិ ។
សកម្មភាព នេះ ក៏ ធ្វើឡើង ដើម្បី រួមគ្នា រៀបចំ ជា របាយការណ៍ លម្អិត ដាក់ ជូន ប្រមុខ រាជ រដ្ឋាភិបាល នា ឱកាស វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន ដែល នឹង ប្រព្រឹត្តទៅ នា ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ខាងមុខ ។
កិច្ចពិភាក្សា ការងារ នៅ ខេត្ត សៀមរាប នេះ ដែរ គឺ ធ្វើឡើង នា ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព លោក សុខ សូកេន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ ដោយ មាន ការចូលរួម ពី លោក អភិបាល រង ខេត្ត សៀមរាប ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ ក្រសួង ទេសចរណ៍ សមាគម ឧស្សាហកម្ម ទេសចរណ៍ និង ប្រតិបត្តិករ ទេសចរណ៍ ក្នុង ខេត្ត សៀមរាប សរុប ប្រមាណ ជាង ២៥០ រូប ។
លោក រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ យន្តការឆ្លើយតប រាល់ តម្រូវការ របស់ ប្រជាពលរដ្ឋ ជាពិសេស សម្រាប់ វិស័យ ទេសចរណ៍ កម្ពុជា ពិសេស គឺ បាន ដាក់ចេញ នូវ គោល នយោបាយ យុទ្ធសាស្រ្ត និង វិធានការអន្តរាគមន៍ សំខាន់ ៗ សំដៅ ស្ដារ កំណើន ទេសចរណ៍ កម្ពុជា ក្រោយ វិបត្តិ ជំងឺ កូវីដ - ១៩ ។
លោក រដ្ឋមន្ត្រី បាន គូសបញ្ជាក់ ពី សារៈសំខាន់ និង ភាពចាំបាច់ នៃ ភាពជាដៃគូ រដ្ឋ - ឯកជន - ប្រជាពលរដ្ឋ - ដៃគូ អភិវឌ្ឍន៍ (4Ps) ក្នុង ការរួបរួម គ្នា ពង្រឹង ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ នៅក្នុង បរិបទ នៃ ស្ថានភាពប្រឈម ផ្នែក សេដ្ឋកិច្ច ភូមិសាស្រ្ត នយោបាយ និង ការធ្វើដំណើរ ជា អន្តរជាតិ របស់ ទេសចរ ។
អង្គ ពិធី បាន ប្រមូល ធាតុ ចូល អំពី បញ្ហា ប្រឈម និង សំណូមពរ របស់ ប្រតិបត្តិករ ទេសចរណ៍ ក្នុង ខេត្ត សៀមរាប ក៏ ដូចជា តម្រូវការ ជាក់ស្ដែង របស់ ទេសចរ ជាតិ និង អន្តរជាតិ ដើម្បី រិះរក វិធីសាស្រ្ត និង ដំណោះស្រាយ រួមគ្នា និង ឈាន ទៅ រៀបចំ ជា របាយការណ៍ លម្អិត ដាក់ ជូន រាជ រដ្ឋាភិបាល នា ឱកាស វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ខាងមុខ ។
ទន្ទឹម នេះ តំណាង ស្ថាប័ន ពាក់ព័ន្ធ ក៏ បាន ចូលរួម មតិ យោបល់ ជា ធាតុ ចូល សំខាន់ ៗ គាំទ្រ ដល់ ការពង្រឹង ការអភិវឌ្ឍ ផលិតផល ទេសចរណ៍ ការផ្សព្វផ្សាយ ទេសចរណ៍ និង គុណភាព ទេសចរណ៍ ។
លោក រដ្ឋមន្រ្តី អង្គភាព ពាក់ព័ន្ធ សមាគម ឧស្សាហកម្ម ទេសចរណ៍ និង ប្រតិបត្តិករ ទេសចរណ៍ បាន ប្តេជ្ញាចិត្ត រួមគ្នា បង្កើន កិច្ចសហការបន្ថែម ដើម្បី ជំរុញ ភាព ប្រកួតប្រជែង និរន្តរភាព និង បរិយា បន្ន នៃ វិស័យ ទេសចរណ៍ ខេត្ត សៀមរាប ពិសេស ចូលរួម ផ្សព្វផ្សាយ រួមគ្នា ក្នុង នាម ខ្មែរ តែ មួយ សម្រាប់ វិស័យ ទេសចរណ៍ កម្ពុជា ៕
ស្រវឹង សូម កុំ បើកបរ ! ស្លាប់ ៦នាក់ និង របួស ១៤នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៥ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ ស្រាល ១៤នាក់ ។
អ្នកវិភាគ ចៅ ចាក់ ស្មុក៖ យុវជន នៃ ចលនា ខុស ច្បាប់ ក្រោម ការបង្គាប់បញ្ជា របស់ មេ បដិវត្តន៍ ពណ៌ ឈ្មោះ អាឡិច បាន និង កំពុង បន្ត បំពាន បំរាម តុលាការ ម្តង ហើយ ម្តង ទៀត ដើម្បី បម្រើ ផលប្រយោជន៍ បរទេស
លោក បាន ប្រាប់ ទូរទស្សន៍ អ៊ុយក្រែន ដូច្នេះ ថា « ពី គ្រប់ ក្រុមគ្រួសារ ពី គ្រប់ ផ្ទះ មាន សមាជិក វត្តមាន ក្នុង ពិធី នេះ ។ នេះ ជា សោកនាដកម្ម ដ៏ គួរឱ្យ ភ័យខ្លាច » ។ លោក បាន និយាយ ទៀត ថា ភ្លាម ៗ នេះ វា មិន ច្បាស់ ទេ ថា តើ កងកម្លាំង រុស្ស៊ី បាន ទម្លាក់ គ្រាប់បែក ឬ បាន បាញ់ មីស៊ីល នោះ ទេ ។
មេដឹកនាំ អឺរ៉ុប ជាច្រើន នាក់ មកពី សហភាព អឺរ៉ុប និង រដ្ឋ សមាជិក ណា តូ ក៏ ដូចជា ប្រទេស ជិតខាង របស់ ពួកគេ បាន ប្រមូលផ្តុំ គ្នា នៅ ទីក្រុង Granada នៃ ប្រទេស អេស្ប៉ាញ សម្រាប់ កិច្ចប្រជុំ កំពូល ទី បី នៃ សហគមន៍ នយោបាយ អឺរ៉ុប ។
( ភ្នំពេញ ) ៖ ក្រោយ សង្កេតឃើញ មាន ភ្នាក់ងារ លក់ ឆ្នោត របស់ ក្រុមហ៊ុន ល្បែង ផ្សង សំណាង និង ក្រុម ជន ខិលខូច មួយចំនួន បាន ធ្វើ សកម្មភាព លួចលាក់ បង្កប់ ការលេង ល្បែងស៊ីសង ឆ្នោត កន្ទុយ លេខ ល្បែង ខេនណូ ខុស ច្បាប់ អគ្គ លេខាធិការដ្ឋាន នៃ គណៈកម្មការគ្រប់គ្រង ល្បែង ពាណិជ្ជកម្ម កម្ពុជា ( អ. គ.ល .ក . ) នា ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន សេចក្តីណែនាំ ស្តីពី ការធ្វើ ប្រតិបត្តិការ ល្បែង ផ្សង សំណាង នៅ កម្ពុជា ៕
ខាងក្រោម នេះ ជា សេចក្តីណែនាំ របស់ គណៈកម្មការគ្រប់គ្រង ល្បែង ពាណិជ្ជកម្ម កម្ពុជា៖
( ភ្នំពេញ ) ៖ លើកឡើង នៅក្នុង ទិវា គ្រូបង្រៀន លើក ទី ២៦ នា ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ លោកស្រី ឃួន វិច្ឆិកា អ្នកនាំពាក្យ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ថ្លែង បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង អប់រំ យុវជន និង កីឡា នៅតែ បន្ត យកចិត្តទុកដាក់ ខ្ពស់ ទៅ លើ កត្តា ជីវភាព និង សុខភាព របស់ គ្រូបង្រៀន តាមរយៈ ការដំឡើង ប្រាក់ បៀវត្សរ៍ ជាមួយនឹង ការផ្តល់ ជា បេឡា ជាតិ របប សន្តិសុខ សង្គម ដល់ លោកគ្រូ អ្នកគ្រូ ក្នុង ការថែទាំ សុខភាព ឱ្យ បាន ល្អ ប្រសើរ ។
អ្នកនាំពាក្យ រូប នេះ ក៏ បាន បញ្ជាក់ ទៀត ថា ទិវា គ្រូបង្រៀន នេះ ក៏ ជា ទិវា មួយ ដើម្បី បង្ហាញ ពី ភាពកតញ្ញូ របស់ កូន ខ្មែរ គ្រប់ រូប ហើយ ការសម្ដែង អំពី ការយកចិត្តទុកដាក់ របស់ សិស្សានុសិស្ស អំពី ការដឹងគុណ គ្រូ នេះ ក៏ ជា គុណ តម្លៃ មួយ ជាជា ការគាំទ្រ ផ្នែក ផ្លូវចិត្ត មួយ ដល់ លោកគ្រូ អ្នកគ្រូ ដែល បាន បង្ហាត់ បង្រៀន ក្មេង ៗ តាំងពី មត្តេយ្យ សិក្សា រហូតដល់ រៀន ចប់ សកលវិទ្យាល័យ ហើយ ចេញមក ធ្វើការ ។
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ បាន អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ ពង្រឹង ការងារ ជំនាញ របស់ នាយកដ្ឋាន អង្គភាព ចំណុះ នាយកដ្ឋាន កណ្តាល នគរបាល យុត្តិធម៌ នៅ ទីស្តីការ ក្រសួង មហាផ្ទៃ ។
ក្នុង កិច្ចប្រជុំ នាយ ឧត្តមសេនីយ៍ ស ថេត បាន ថ្លែង ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ថ្នាក់ដឹកនាំ និង មន្រ្តី នៃ នាយកដ្ឋាន អង្គភាព ចំណុះ នាយកដ្ឋាន កណ្តាល នគរបាល យុត្តិធម៌ ដែល កន្លងមក បាន ខិតខំ បំពេញ ភារកិច្ច ក្នុង ការរក្សា សុវត្ថិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ បាន ល្អ ជូន ប្រជាពលរដ្ឋ ក៏ ដូចជា សង្គមជាតិ ទាំងមូល ហើយក៏ សូម ស្នើឲ្យ បន្ត ពង្រឹង កិច្ចការ នេះ ឲ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ។
ដើម្បី ប្រសិទ្ធភាព ការងារ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ បាន ផ្តល់ អនុសាសន៍ គន្លឹះ ដល់ ថ្នាក់ដឹកនាំ និង មន្រ្តី ទាំងអស់ នៃ នាយកដ្ឋាន អង្គភាព ចំណុះ នាយកដ្ឋាន កណ្តាល នគរបាល យុត្តិធម៌ រួម មាន៖
* ទី២៖ ត្រូវ លើកកម្ពស់ សមត្ថិភាព ជំនាញ ឲ្យ ស្រប ទៅតាម តួនាទី ភារកិច្ច របស់ អង្គភាព នីមួយ ៗ និង បន្ត គាំទ្រ ដល់ មន្ត្រី ជំនាញ នៅ តាម ស្នងការដ្ឋាន នគរបាល រាជធានី - ខេត្ត ។
* ទី៣៖ ពិនិត្យ ធ្វើ បច្ចុប្បន្នភាព មន្រ្តី រួមទាំង មធ្យោបាយ ឧបករណ៍ សម្ភារ បច្ចេកទេស សម្រាប់ បម្រើ ឲ្យ ការងារ ជំនាញ នៅ តាម អង្គភាព និង រៀបចំ ស្នើសុំ ការបំពាក់ ឲ្យ ស្រប តាម បច្ចេកវិទ្យា ទំនើប ។
* ទី៤៖ ត្រូវ បង្កើន កិច្ចសហការ ជាមួយ ភាគី ពាក់ព័ន្ធ ដើម្បី រួមគ្នា ក្នុង ការកាត់បន្ថយ បទល្មើស គ្រប់ ប្រភេទ សំដៅ ធានា រក្សា សុវត្ថិភាព សន្តិសុខ និង សណ្តាប់ធ្នាប់ សង្គម ។
នាយ ឧត្តមសេនីយ៍ ស ថេត បាន សង្កត់ធ្ងន់ ទៅ លើ ព្រឹត្តិការណ៍ សំខាន់ ៗ សម្រាប់ ខែវិច្ឆិកា ខាងមុខ នេះ រួម មាន៖ បុណ្យ ឯករាជ្យ ជាតិ បុណ្យ អុំ ទូក ដែល ត្រូវ ឲ្យ គ្រប់ នាយកដ្ឋាន អង្គភាព ទាំងអស់ បង្កើន នូវ វិធានការ នានា ដើម្បី រួមចំណែក ក្នុង ការរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ និង សុវត្ថិភាព ឲ្យ ព្រឹត្តិការណ៍ ទាំងអស់ នោះ ដំណើរការ ទៅ ដោយ រលូន និង ទទួលបាន ជោគជ័យ ៕ អាជ្ញាធរ ជាតិ អប្សរា ដាក់ ឱ្យ ប្រើប្រាស់ តេលេក្រាម និង លេខ ទូរស័ព្ទ សម្រាប់ ផ្តល់ សេវាកម្ម ផ្សេង ៗ ក្នុង រមណីយដ្ឋាន អង្គរ
យោធា អ៊ីស្រាអែល ក៏ បាន បញ្ជាក់ បន្ថែម ទៀត ថា សមាជិក របស់ ខ្លួន ប្រាំ នាក់ ក៏ បាន រងរបួស ក្នុង ហេតុការណ៍ ខាង លើ នេះ ផងដែរ ។
ចលនា អ៊ីស្លាម ប្រដាប់អាវុធ ហាម៉ាស បាន ប្រកាស ថា ជនជាតិ ប៉ាឡេ ស្ទីន ដែល ស្លាប់ ពីរ នាក់ ខាងលើ ដែល មាន អាយុ ២៣ និង ២៧ ឆ្នាំ គឺជា សមាជិក របស់ ខ្លួន ។
គួរ បញ្ជាក់ ថា តំបន់ West Bank ដែល ស្ថិត ក្នុង ចំណោម តំបន់ ដែល ប៉ាឡេស្ទីន ស្វែងរក ការបង្កើត រដ្ឋ របស់ ពួកគេ បាន មើលឃើញ ពី ការកើនឡើង នៃ អំពើហិង្សា ក្នុង ប៉ុន្មាន ខែ ថ្មី ៗ នេះ ចំពេល មាន ការជាប់គាំង អស់ រយៈពេល ជិត មួយ ទសវត្សរ៍ នៅក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង បង្កើត សន្តិភាព ដែល គាំទ្រ ដោយ សហរដ្ឋ អាមេរិក ៕
រូបភាព ពី AP អគ្គ លេខាធិការ អាស៊ាន និង រដ្ឋមន្ត្រី កសិកម្ម អាស៊ាន ចូលរួម ទស្សនា ទីតាំង បច្ចេកទេស នានា ដែល រៀបចំ ដោយ រដ្ឋាភិបាល ម៉ាឡេស៊ី
( ម៉ាឡេស៊ី ) ៖ លោក បណ្ឌិត កៅ គឹម ហួន អគ្គ លេខាធិការ អាស៊ាន រួម ជាមួយ បណ្ដា រដ្ឋមន្ត្រី កសិកម្ម និង រុក្ខា ប្រមាញ់ អាស៊ាន គណៈប្រតិភូ ព្រមទាំង ដៃគូ អភិវឌ្ឍន៍ មួយចំនួន នៅ ព្រឹក ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ទស្សនា ទីតាំង បច្ចេកទេស នានា នៅ ទីក្រុង គូឡាឡាំពួ ប្រទេស ម៉ាឡេស៊ី ដែល រៀបចំ ដោយ រដ្ឋាភិបាល ម៉ាឡេស៊ី ដើម្បី បង្ហាញ ពី កម្មវិធី ដែល លើកកម្ពស់ ការអភិរក្ស បរិស្ថាន តាមរយៈ ការប្រើប្រាស់ បច្ចេកទេស ។
នៅក្នុង ឱកាស អញ្ជើញ ទស្សនា ទីតាំង បច្ចេកទេស នានា នៅ ទីក្រុង គូឡាឡាំពួ ប្រទេស ម៉ាឡេស៊ី នា ព្រឹក នេះ លោក បណ្ឌិត កៅ គឹម ហួន អគ្គ លេខាធិការ អាស៊ាន ក៏ បាន ចូលរួម ក្នុង ការដាំ ដើមឈើ និង ព្រលែង ត្រី ផងដែរ ។
នា ឱកាស នោះ លោក ឯក អគ្គ រដ្ឋទូត ហុង គ្រី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហប្រតិបត្តិការ នា ពេល កន្លងមក និង កោតសរសើរ ដល់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ជាពិសេស ថ្នាក់ដឹកនាំ នៃ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដែល បាន ផ្តល់ នូវ កិច្ចសហការ យ៉ាង ល្អ និង ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ។
ភាគី ទាំង ពីរ បាន បង្ហាញ នូវ សុច្ឆន្ទៈ បន្ត ពង្រឹង កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ ធនធាន ទឹក ឱ្យ កាន់តែ រីកចម្រើន បន្ថែម ទៀត ។
គួរ បញ្ជាក់ ថា កាលពី ឆ្នាំ ២០២០ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ គ្នា ស្ដីពី កិច្ចសហប្រតិបត្តិការ គ្រប់គ្រង ធនធាន ទឹក ជាមួយ ក្រសួង មហាផ្ទៃ នៃ ប្រទេស ហុង គ្រី ដែល ផ្តោត ជា សំខាន់ លើ វិស័យ ធនធាន ទឹក ចំនួន ៣ គឺ៖ ទី១ - ការគ្រប់គ្រង ធនធាន ទឹក ចម្រុះ ទី២ - ការគ្រប់គ្រង ទឹក និង ទឹក កខ្វក់ ទី៣ - ការអប់រំ ស្រាវជ្រាវ និង អភិវឌ្ឍន៍ ទាក់ទង នឹង ទឹក ៕
សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ចាត់តាំង លោក មិត្ត ទី មាន នាយក រង ខុទ្ទកាល័យ រៀបចំ ពិធី សូត្រ មន្ត ចម្រើន ព្រះបរិត្ត កាន់ បិណ្ឌ វេន ទី៧ នៅ វត្ត វិមាន តេជះ ហៅ វត្ត ស្រះចក
( ភ្នំពេញ ) ៖ សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ចាត់ លោក មិត្ត ទី មាន នាយក រង ខុទ្ទកាល័យ សម្តេច រដ្ឋសភា ធិបតី ប្រធាន រដ្ឋសភា រៀបចំ ពិធី សូត្រ មន្តកាន់ បិណ្ឌ វេន ទី៧ នៅ វត្ត វិមាន តេជះ ហៅ វត្ត ស្រះចក ស្ថិត ក្នុង សង្កាត់ ស្រះចក ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ នា រសៀល ថ្ងៃព្រហស្បតិ៍ ទី៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
ពិធី នេះ បាន ប្រារព្ធ ធ្វើឡើង តាម គន្លង ព្រះពុទ្ធ សាសនា ដោយ លោក មិត្ត ទី មាន និង អ្នកចូលរួម ជាច្រើន រួម មាន ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា ខុទ្ទកាល័យ សម្តេច រដ្ឋសភា ធិបតី ជា ទីប្រឹក្សា ជំនួយការ ក្រុម លេខា ព្រមទាំង សាច់ញាតិ ជិត ឆ្ងាយ និង ប្រជាពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ជាច្រើន កុះករ បាន អញ្ជើញ ថ្វាយ នូវ គ្រឿង សក្ការៈបូជា ទៀន ធូប ផ្កា ភ្ញី ចំពោះ ព្រះរតនត្រ័យ និង បាន សមាទាន សីល ស្តាប់ ព្រះសង្ឃ សូត្រ មន្ត ចម្រើន ព្រះបរិត្ត និង ការសម្ដែង ព្រះធម៌ ទេសនា ។
លុះ ដល់ ព្រឹក ស្អែក ត្រូវ ថ្ងៃសុក្រ ទី៦ ខែតុលា ដែល ជា វេន កាន់ បិណ្ឌ ទី៧ ឯកឧត្តម មិត្ត ទី មាន និង ក្រុមការងារ នឹង អញ្ជើញ នាំយក ចង្ហាន់ ទេយ្យ ទាន និង គ្រឿង បរិក្ខារ រាប់ បាត្រ វេរ ប្រគេន ព្រះសង្ឃ ដើម្បី ឧទ្ទិស កុសល ជូន ដួង វិញ្ញាណក្ខន្ធ លោក អ្នក មាន គុណ បុព្វការី ជន ជីដូន ជីតា ដែល បាន ធ្វើ មរណកាល ទៅ ហើយ ។
ក្នុង ឱកាស នោះ ដែរ សម្តេច ព្រះឧត្តម ចរិយា បណ្ឌិត ឈឹង ប៊ុន ឈា ព្រះចៅ អធិការ វត្ត វិមាន តេជះ បាន ជូន ពរ សព្ទ សាធុការ ដល់ សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា និង ក្រុមគ្រួសារ ញាតិមិត្ត ព្រមទាំង មន្រ្តី រាជការ ក្រោម ឱវាទ សូម ជួបប្រទះ តែ នឹង ព្រះពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សម្តេច ព្រះឧត្តម ចរិយា បណ្ឌិត ឈឹង ប៊ុន ឈា តែងតែ យកចិត្តទុកដាក់ គិតគូរ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ពី សុខុមាលភាព របស់ ព្រះសង្ឃ និង តែងតែ លើកទឹកចិត្ត ចូលរួមចំណែក លើកស្ទួយ វិស័យ ព្រះពុទ្ធ សាសនា ឱ្យ មាន ការរីកចម្រើន ហើយ ជាពិសេស តែងតែ ជួយ សម្រាល ការលំបាក ដល់ ព្រះសង្ឃ ដែល គង់ នៅក្នុង វត្ត ។
សូម ជម្រាប ថា នៅក្នុង ឱកាស ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ រៀងរាល់ ឆ្នាំ សម្តេច មហា រដ្ឋសភាធិការបតី ឃួន សុដារី តែងតែ អញ្ជើញ ប្រារព្ធ ពិធី កាន់ បិណ្ឌ វេន ទី៧ នៅ វត្ត វិមាន តេជះ ដើម្បី ឧទ្ទិស កុសល ជូន ដួង វិញ្ញាណក្ខន្ធ លោក អ្នក មាន គុណ បុព្វការី ជន វីរៈ ជន ស្នេហាជាតិ ជីដូន ជីតា ដែល បាន ធ្វើ មរណកាល ទៅ ហើយ និង បាន បួងសួង សូម ឱ្យ ប្រជាពលរដ្ឋ និង ប្រទេសជាតិ ទទួលបាន នូវ សេចក្តីសុខ សេចក្តី ចម្រើន ជានិច្ច និរន្តន៍ ត ទៅ ។
( កំពង់ស្ពឺ ) ៖ ជំងឺ គ្រុន ឈាម នៅតែ មាន អត្រា ឆ្លង ខ្ពស់ សម្រាប់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត កំពង់ស្ពឺ ។ នេះ បើ យោង តាម របាយការណ៍ របស់ មន្ទីរ សុខាភិបាល ខេត្ត នៅ ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
លោកស្រី ឱសថការី បាន បញ្ជាក់ បន្ថែម ថា នៅ ឆ្នាំ ២០២៣ នេះ ជំងឺ គ្រុន ឈាម បាន កើតឡើង លើ កុមារ អាយុ ក្រោម ១៥ ឆ្នាំ ដែល ក្នុង នោះ ៦៥% កំពុង សិក្សា សាលា បឋមសិក្សា ។ ជាមួយនឹង ការឆ្លង រាលដាល នៃ ជំងឺ គ្រុម ឈាម នេះ មន្ទីរ សុខាភិបាល បាន បន្ត បើក យុទ្ធនាការ អប់រំ ផ្សព្វផ្សាយ ស្ដី អំពី ជំងឺ គ្រុន ឈាម និង វិធី បង្ការ នៅ តាម មូលដ្ឋាន ក្នុង ស្រុក ក្រុង នៃ ខេត្ត កំពង់ស្ពឺ ជាពិសេស នៅ តំបន់ ដែល មាន ការឆ្លង នូវ ជំងឺ គ្រុន ឈាម ។
ទន្ទឹម នេះ មន្ទីរ តែងតែ អនុវត្តន៍ គ្រប់ បណ្តា ស្រុក ក្រុង នៃ ខេត្ត កំពង់ស្ពឺ ហើយ បាន ផ្តោត លើ ចំណុច សំខាន់ ៗ ដូច ជា៖ ការផ្សព្វផ្សាយ អំពី ជំងឺ គ្រុន ឈាម វិធី បង្ការ ការពារ បំបាត់ ជម្រក មូស . ករណី សង្ស័យ ត្រូវ បញ្ជូន អ្នកជំងឺ ទៅកាន់ មូលដ្ឋាន សុខាភិបាល ដែល នៅជិត បំផុត . ការដាក់ ថ្នាំ អាល់ បេត សម្លាប់ ដង្កូវ ទឹក ក្នុង ពាង ទឹក អាងទឹក និង ការបាញ់ ថ្នាំ សម្លាប់ មូស ខ្លា នៅ សាលារៀន មណ្ឌល សុខភាព លំនៅដ្ឋាន ប្រជាជន ។
លោកស្រី ឱសថការី យឹម សុធារ៉ា ក៏ បាន បញ្ជាក់ បន្ថែម ថា ការផ្សព្វផ្សាយ ទៅដល់ ប្រជាពលរដ្ឋ គ្រប់ មូលដ្ឋាន និង ធ្វើឱ្យ ពលរដ្ឋ មាន ការយល់ដឹង ខ្ពស់ ពី វិធីសាស្ត្រ នៃ ការបង្ការ ចំពោះ សុខភាព និង ត្រូវ បង្កើន ការប្រុងប្រយ័ត្ន ចំពោះ បញ្ហា ជំងឺ គ្រុន ឈាម ដែល កំពុង មាន អាត្រា ខ្ពស់ ដែល កើត មក លើ មនុស្ស គ្រប់ វ័យ ដោយ ត្រូវ ចូលរួម ធ្វើ អនាម័យ ថែរក្សា បរិស្ថាន ដើម្បី កំចាត់ ជម្រក មូស ខ្លា ហើយ ត្រូវ សម្រាន្ត ក្នុង មុង ស្លៀកពាក់ ខោអាវ ជើង វែង ដៃ វែង ជាប្រចាំ ផងដែរ ៕
ខេត្ត ព្រះវិហារ បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ជូន កុមារី អាយុ ៩ឆ្នាំ . លោក សុខ សាន្ត តារ៉ា អំពាវនាវ អាណាព្យាបាល នាំ កូន មក ទទួល ថ្នាំ បង្ការ ឱ្យ បាន គ្រប់ ៗ គ្នា
( ព្រះវិហារ ) ៖ លោក សុខ សាន្ត តារ៉ា អភិបាល រង ខេត្ត ព្រះវិហារ បាន អំពាវនាវ មាតាបិតា អាណាព្យាបាល ដែល មាន កូនស្រី អាយុ ៩ឆ្នាំ ទាំងអស់ សូម នាំ កូន មក ទទួល ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ឱ្យ បាន គ្រប់ ៗ គ្នា នៅ តាម សាលារៀន មណ្ឌល សុខភាព ឬ តាមរយៈ បុគ្គលិក ផ្តល់ ថ្នាំ បង្ការ នៅ តាម ភូមិ ទៅ តាម ផែនការ និង ការណាត់ របស់ បុក្គលិក សុខាភិបាល ។
ការថ្លែង អំពាវនាវ របស់ អភិបាល រង ខេត្ត ព្រះវិហារ ក្នុង ឱកាស ដែល លោក តំណាង លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ អញ្ជើញ ចូលរួម ក្នុង ពិធី ប្រកាស ដាក់បញ្ចូល ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដល់ កុមារី អាយុ ៩ ឆ្នាំ នៅ ទូទាំង ខេត្ត ដោយ មាន ការចូលរួម ពី លោក វេជ្ជបណ្ឌិត គួង ឡូ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង មាតា បិតា អាណាព្យាបាល ជាច្រើន រូប នៅ ព្រឹក ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ ។
លោក សុខ សាន្ត តារ៉ា បាន អបអរសាទរ ជាមួយ មន្ត្រី បុគ្គលិក សុខាភិបាល បងប្អូន ប្រជាពលរដ្ឋ និង មាតាបិតា ទាំងអស់ ចំពោះ មោទនភាពជាតិ ដ៏ មហិមា ដែល កុមារី អាយុ ៩ ឆ្នាំ នៅ ទូទាំង ប្រទេស បាន ទទួល ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដោយ មិន គិត ថ្លៃ ថ្មី មួយ មុខ ទៀត បន្ថែម ពីលើ ថ្នាំ បង្ការ ជំងឺ ទាំង ១១មុខ នា ពេល កន្លងមក ។
លោក សុខ សាន្ត តារ៉ា បាន អំពាវនាវ មាតាបិតា អាណាព្យាបាល នៃ កុមារ ទាំងអស់ សូម នាំ កូន មក ទទួល វ៉ាក់សាំង របស់ កម្មវិធី ជាតិ ផ្តល់ ថ្នាំ បង្ការ ឱ្យ បាន គ្រប់ ៗ គ្នា នៅ តាម សាលារៀន ម ណ្ឌុល សុខភាព ឬ តាមរយៈ បុគ្គលិក ផ្តល់ ថ្នាំ បង្ការ នៅ តាម ភូមិ ទៅ តាម ផែនការ និង ការណាត់ របស់ បុគ្គលិក សុខាភិបាល ។
ដោយឡែក លោក វេជ្ជបណ្ឌិត គួង ឡូ បាន ថ្លែង ថា យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ មហារីក មាត់ ស្បូន នា ថ្ងៃ នេះ ជា ដំណាក់កាល ទី១ សម្រាប់ កុមារី អាយុ ពី ៩ទៅ១០ ឆ្នាំ ហើយ ដំណាក់កាល ទី២ នឹង ចាក់ ចាប់ពី អាយុ៩ ឆ្នាំ ដល់ ១២ឆ្នាំ ។
លោក ថា ការចាក់ វ៉ាក់ ការពារ ជំងឺ ដល់ កុមារ ចំនួន ១២មុខ ពិតជា មាន សារៈសំខាន់ ណាស់ ព្រោះ អាច ការពារ បាន ពី ជំងឺ ផ្សេង ៗ ប៉ុន្តែ បើ កុមារ នោះ មាន ជំងឺ មែន ក៏ មិន ធ្ងន់ធ្ងរ ដែរ ហើយក៏ មិន ប្រឈម នឹង ការស្លាប់ ដោយ ជំងឺ ដែល បាន ចាក់ វ៉ាក់សាំង រួច នោះ ទេ ពិសេស បាន ចូលរួម ក្នុង កាត់បន្ថយ ការចំណាយ នៅក្នុង គ្រួសារ ដែរ ៕
ចំណេះដឹង ទូទៅ៖ ការកកើត មហាសមុទ្រ នៅលើ ផែនដី
* តួនាទី មហាសមុទ្រ មហាសមុទ្រ មាន តួនាទី យ៉ាង ច្រើន នៅក្នុង ការតម្រូវ បរិស្ថាន របស់ ផែនដី ហើយក៏ ជា សមាសភាព ផ្សំ យ៉ាង សំខាន់ នៃ មណ្ឌល ទឹក ផងដែរ ។ រំហួត ទឹក សមុទ្រ ជា ប្រភព ច្រើន បំផុត នៃ កំណក អាកាស ហើយ សីតុណ្ហភាព មហាសមុទ្រ ក៏ កំណត់ នូវ ធាតុអាកាស និង ខ្យល់ បក់ នៅលើ ផែនដី យើង ដែរ ។ ជីវិត បាន កើតឡើង នៅក្នុង មហាសមុទ្រ ប្រហែលជា ៣លាន ឆ្នាំ មុន ការលេចឡើង នូវ ជីវិត និង រុក្ខជាតិ នៅលើ ដី ហើយ មហាសមុទ្រ ក៏ ជា ប្រភព ផ្ដល់ ស្ម័ន អុក ស៉ី សែន ច្រើន ដ៏ លើសលុប ផងដែរ ៕
វីដេអូ ដែល ចេញផ្សាយ ដោយ ក្រសួង ការពារ ជាតិ រុស្ស៉ី បង្ហាញ ឲ្យ ឃើញ នូវ ក្រុម ទាហាន ស៉ីរី លោត ចេញពី យន្តហោះ និង ឧទ្ធម្ភាគចក្រ រុស្ស៉ី ព្រម ជាមួយ ការអត្ថាធិប្បាយ ថា ជា ការចុះចត ដ៏ ធំ លើក ដំបូង របស់ កងទ័ព អារ៉ាប់ ពី យន្តហោះ ចម្បាំង IL-76 ដែល ធ្វើឡើង នៅ ពេល យប់ ។ ក្រសួង ការពារ ជាតិ រុស្ស៉ី បញ្ជាក់ ថា « ក្រុម ទាហាន រុស្ស៉ី ឈរជើង នៅ ស៊ីរី ជា អ្នក ទទួលបន្ទុក ចំពោះ សមយុទ្ធ ដ៏ ធំ នៃ អង្គភាព ទ័ព ពិសេស ស៉ីរី នា ពេលនេះ » ។
ព្រឹក ស្អែក ព្រះមហាក្សត្រ យាង ជា ព្រះរាជា ធិបតី ប្រារព្ធ ពិធី អបអរសាទរ ខួប៣០ ឆ្នាំ នៃ ការប្រកាស ឱ្យ ប្រើប្រាស់ រដ្ឋធម្មនុញ្ញ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃសុក្រ ៧រោច ខែ ភទ្រប ទ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ៦ ខែតុលា ឆ្នាំ ២០២៣ ស្អែក នេះ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ សព្វ ព្រះរាជ ឫទ័យ ស្តេច យាង ជា ព្រះរាជា ធិបតី ប្រារព្ធ ពិធី អបអរសាទរ ទិវា រំលឹក ខួប ៣០ ឆ្នាំ នៃ ការប្រកាស ឱ្យ ប្រើ រដ្ឋធម្មនុញ្ញ ។
ក្នុង ពិធី នោះ ក៏ នឹង មាន ការអញ្ជើញ ដង្ហែ ព្រះរាជ ដំណើរ ព្រះមហាក្សត្រ ខ្មែរ ពីសំណាក់ សម្តេច ថ្នាក់ដឹកនាំ កំពូល នៃ ស្ថាប័ន ជាតិ សម្តេច ជា ឥស្សរជន របស់ ជាតិ លោក កិត្តិនីតិកោសល បណ្ឌិត អ៉ឹម ឈុន លឹម ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ព្រមទាំង ថ្នាក់ដឹកនាំ រាជ រដ្ឋាភិបាល និង ស្ថាប័ន ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ។
ការថ្លែង ដូច្នេះ របស់ លោក រដ្ឋមន្ដ្រី ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ប្រកាស ដាក់បញ្ចូល ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដែល ត្រូវ ផ្តល់ តែ ចំនួន មួយ ដូស ដល់ កុមារី ម្នាក់ ៗ មាន អាយុ ៩ឆ្នាំ ដោយ ឥត គិត ថ្លៃ ទៅក្នុង កម្មវិធី ជាតិ ផ្ដល់ ថ្នាំ បង្ការ ដើម្បី ការពារ ជំងឺ មហារីក មាត់ ស្បូន ដែល ពិធី នេះ បាន ប្រព្រឹត្ដទៅ នៅ សាលា បឋមសិក្សា ភ្នំពេញ ថ្មី នៅ ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
លោក រដ្ឋមន្ដ្រី បាន ថ្លែង បន្ដ ថា អាណាព្យាបាល ទំាង អស់ ត្រូវ យល់ ថា វ៉ាក់សាំង បង្ការ ជំងឺ មហារីក មាត់ ស្បួន មួយ ដូស នេះ នឹង នាំមក នូវ សុភមង្គល ដល់ បុត្រធីតា របស់ លោក អ្នក ពេញ មួយ ជីវិត ។ យើង ថែទាំ ចិញ្ចឹម បុត្រធីតា តែងតែ រមែង ចង់ ឃើញ កូន មាន សុខភាព ល្អ សម្រស់ ស្អាត និង មាន សុភមង្គល តែ បើ នៅ ពេល ដែល បុត្រធីតា អ្នក កើត ជំងឺ មហារីក មាត់ ស្បួន ហើយ នោះ នឹង បាត់បង់ គ្រប់ យ៉ាង កុំ ថា ឡើយ សម្រស់ គឺ បាត់បង់ សុភម មង្គល ទាំងស្រុង ។
« នៅ កម្ពុជា យើង ចំនួន នៃ ជំងឺ មហារីក កើត ថ្មី មាន ប្រមាណ ១៨.០០០ ករណី ជា រួម ។ មាន ន័យ ថា ក្នុង មួយ ថ្ងៃ គ្រប់ ប្រភេទ នៃ ជំងឺ មហារីក ថ្មី មាន ៤៩.៣% ស្មើនឹង ៥០ ករណី ថ្មី ក្នុង មួយ ថ្ងៃ ដែល នេះ មិន រួមបញ្ចូល ទាំង ចំនួន ចាស់ នោះ ទេ » ។ ដូច្នេះ សូម ឱ្យ មាតាបិតា លោកគ្រូ អ្នកគ្រូ យកចិត្ដទុកដាក់ ក្នុង ការចូលរួម ជាមួយ សកម្មភាព នៃ ការទប់ស្កាត់ ជំងឺ មហារីក នេះ » ។ នេះ តាមក ការបញ្ជាក់ បន្ថែម របស់ លោក រដ្ឋមន្ដ្រី ។
ជំងឺ មហារីក មាត់ ស្បូន ជានិច្ចកាល ត្រូវបាន គេ ប្រសិទ្ធ នាម ថា ជា « ឃាតក លាក់ មុខ » ហើយក៏ ជា ជំងឺ មួយ ដែល អាច ការពារ បាន ទាំងស្រុង ផងដែរ ដោយសារ ថ្នាំ បង្ការ ។ វីរុស មហារីក ស្បូន វា បង្កឱ្យ កើត ជំងឺ មហារីក មាត់ ស្បូន ហើយ ជំងឺ នេះ ជា មូលហេតុ ចម្បង ទី៤ នៃ ការស្លាប់ របស់ ស្ត្រី ដោយ ជំងឺ មហារីក នៅ ទូទាំង ពិភពលោក ហើយ ភាគ ច្រើន កើត នៅក្នុង ប្រទេស ដែល មាន ប្រាក់ ចំណូល ទាប និង មធ្យម ។
ជាក់ស្ដែង នៅ ព្រឹក ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ប្រកាស ដាក់បញ្ចូល ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដែល ត្រូវ ផ្តល់ តែ ចំនួន មួយ ដូស ដល់ កុមារី ម្នាក់ ៗ មាន អាយុ ៩ឆ្នាំ ដោយ ឥត គិត ថ្លៃ ទៅក្នុង កម្មវិធី ជាតិ ផ្ដល់ ថ្នាំ បង្ការ ដើម្បី ការពារ ជំងឺ មហារីក មាត់ ស្បូន គឺ មាន ការចូលរួម ដោយ ផ្ទាល់ ពី មាតាបិតា ជា អាណាព្យាបាល របស់ សិស្ស ដែល បាន នាំ កូន មក ចាក់ ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ។
ចំណែកឯ អាណាព្យាបាល ដទៃ ទៀត ក៏ បាន សម្ដែង នូវ ការសប្បាយ ចិត្ដ យ៉ាង ខ្លាំង ផងដែរ ពេល ឃើញ កូនស្រី របស់ គាត់ បាន ទទួល វ៉ាក់សាំង បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដែល អាច ការពារ កូន របស់ គាត់ ចៀស ផុត ពី ជំងឺ នេះ ៕ កិច្ចសម្ភាស រដ្ឋមន្ដ្រី សុខាភិបាល ស្ដីពី ការដាក់បញ្ចូល ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ទៅក្នុង កម្មវិធី ជាតិ ផ្ដល់ ថ្នាំ បង្ការ ដល់ កុមារី មាន អាយុ ៩ឆ្នាំ ទូទាំង ប្រទេស (Video inside)
( ភ្នំពេញ ) ៖ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល នៅ ថ្ងៃ៥ ខែតុលា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ជា អធិបតីភាព ការប្រកាស ដាក់បញ្ចូល ថ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដែល ត្រូវ ផ្តល់ តែ ចំនួន មួយ ដូស ដល់ កុមារី ម្នាក់ ៗ ដែល មាន អាយុ ៩ ឆ្នាំ ដោយ ឥត គិត ថ្លៃ ទៅក្នុង កម្មវិធី ជាតិ ផ្ដល់ ថ្នាំ បង្ការ ដើម្បី ការពារ ជំងឺ មហារីក មាត់ ស្បូន ។ ពិធី នេះ បាន ប្រព្រឹត្ដទៅ នៅ សាលា បឋមសិក្សា ភ្នំពេញ ថ្មី ។
តាមរយៈ កិច្ចសម្ភាស . លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា បាន ថ្លែង ថា « ការចាក់ ថ្នាំ បង្ការ ការពារ ជំងឺ មហារីក មាត់ ស្បូន នេះ គឺជា ការចង់បាន របស់ ប្រជាពលរដ្ឋ កម្ពុជា យើង ជាពិសេស ក្រសួង សុខាភិបាល បាន រៀបចំ យូរ មកហើយ » ។
លោក បន្ត ថា « ដូច្នេះ នៅ ពេល នេះ ជា ឱកាស ជា ប្រវត្ដិសាស្ដ្រ មួយ ក្នុង នាម ខ្ញុំ ជា មន្ដ្រី សុខាភិបាល មាន ការរីករាយ យ៉ាង ខ្លាំង ។ ក្នុង នោះ ចំពោះ ប្រជាពលរដ្ឋ ក៏ មាន ការសប្បាយរីករាយ ដែល ទទួលបាន នូវ ការផ្ដល់ នូវ វ៉ាក់ សំាង ការពារ ជំងឺ មាត់ ស្បូន ដែល ចាប់ផ្ដើម ពី កុមារី អាយុ ៩ឆ្នាំ ។ ថ្នាក់ បង្ការ នេះ មាន អត្ថប្រយោជន៍ សម្រាប់ មួយ ជីវិត គឺ ចាក់ តែ មួយ លើក ( ១ដូស ) នៅ ពេល នេះ គឺ ការពារ នូវ ជំងឺ មហារីក មាត់ ស្បូន បាន រហូតដល់ទៅ ៩០ % ក្នុង មួយ ជីវិត » ។
ខណៈ ដែល ភាគ ច្រើន នៃ តម្រូវការ ចំណាយ នេះ នឹង ប្រើ សម្រាប់ ការពង្រីក ដំណើរការ ផលិត ថាមពល ពី ខ្យល់ នៅលើ ដី គោក ថាមពល ពន្លឺ ព្រះអាទិត្យ អ៉ីដ្រូសែន និង ថាមពល កំដៅ ក្នុង ផែនដី គឺជា សសរ ស្តម្ភ បន្ថែម នៃ យុទ្ធសាស្រ្ត ដែល អាច ជួយ ឲ្យ ទិន្នផល អគ្គិសនី របស់ អឺរ៉ុប កើត ចេញ ពី ថាមពល កកើត ឡើងវិញ ទាំងស្រុង នៅ ឆ្នាំ ២០៣០។ វា ត្រូវការ ចំណាយ ពេល រាប់ ឆ្នាំ ទៅ មុខ ដើម្បី បម្លែង ប្រព័ន្ធ ថាមពល ទាំងមូល ដែល បច្ចុប្បន្ន ដំណើរការ ដោយ ប្រេង ឬ ឧស្ម័ន ទៅជា ថាមពល កកើត ឡើងវិញ ។
( បាត់ដំបង ) ៖ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន សហការ ជាមួយ លេខាធិការដ្ឋាន គណៈកម្មាធិការ ត្រួតពិនិត្យ គ្រឿងញៀន ខេត្ត បាត់ដំបង រៀបចំ វគ្គ បណ្តុះបណ្តាល ស្តីពី « ការពង្រឹង សមត្ថភាព មន្ត្រី អនុវត្ត ច្បាប់ ជួរ មុខ » សម្រាប់ មន្ត្រី អនុវត្ត ច្បាប់ គ្រឿងញៀន មកពី ខេត្ត បាត់ដំបង . ខេត្ត បន្ទាយមានជ័យ . ខេត្ត ប៉ៃលិន . ខេត្ត ពោធិ៍សាត់ និង ខេត្ត កោះកុង ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង លោក សឿម ប៊ុន រិទ្ធិ អភិបាល រង ខេត្ត បាត់ដំបង ។ វគ្គ បណ្តុះបណ្តាល នេះ ដោយ មាន កិច្ចសហការ គាំទ្រ ពី ការិយាល័យ ក្រុមប្រឹក្សា ត្រួតពិនិត្យ គ្រឿងញៀន ថៃ ONCB តាមរយៈ គម្រោង LOA ឆ្នាំ ២០២៣ ។
នាយ ឧត្តមសេនីយ៍ បាន គូសបញ្ជាក់ ពី គោលបំណង នៃ វគ្គ បណ្តុះបណ្តាល រួម មាន៖
នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ ចង់ឱ្យ មាន សុខដុមនីយកម្ម សហគមន៍ លើ ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន នៅក្នុង សហគមន៍ ត្រូវ មាន កិច្ចសហការ គាំទ្រ ជួយ គ្នា ទៅ វិញ ទៅ មក លុបបំបាត់ ការរើសអើង និង មាក់ងាយ ជួយសង្គ្រោះ អ្នក ញៀន គ្រឿងញៀន រួមគ្នា បង្ក្រាប បទល្មើស គ្រឿងញៀន និង លុបបំបាត់ ភាព អសកម្ម នានា នៅក្នុង មូលដ្ឋាន ។ ដើម្បី ឈាន ទៅ រក វិធានការ ដោះស្រាយ ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ បាន លើកឡើង ពី ទិស ស្លោក « ៣កុំ ១រាយការណ៍ » ៖
- កុំ ទី១ កុំ ពាក់ព័ន្ធ មាន ន័យ ថា កុំ ជួញដូរ ចែកចាយ កុំ ធ្វើជា ខ្នង បង្អែក កុំ ឃុបឃិត និង កុំ ប្រើប្រាស់ គ្រឿងញៀន - កុំ ទី២ កុំ អន្តរាគមន៍ មាន ន័យ ថា កុំ រារាំង ការអនុវត្ត ច្បាប់ ចំពោះ ឧក្រិដ្ឋ ជន គ្រឿងញៀន ទោះបីជា ក្រុមគ្រួសារ សាច់ញាតិ ឬ មិត្តភ័ក្ត ក៏ដោយ - កុំ ទី៣ កុំ លើកលែង មាន ន័យ កុំ បន្ធូរបន្ថយ ការអនុវត្ត ច្បាប់ ចំពោះ ឧក្រិដ្ឋ ជន គ្រឿងញៀន - ១រាយការណ៍ វិញ គឺ ត្រូវ រាយការណ៍ ទៅ សមត្ថកិច្ច អំពី កន្លែង លាក់ ទុក គ្រឿងញៀន កន្លែង កែច្នៃ ផលិត គ្រឿងញៀន ។ល ។
នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ ក៏ បាន បន្ត ជំរុញ ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព បង្កើន សកម្មភាព ធ្វើ វេទិកា សាធារណៈ និង ខិតខំ ផ្សព្វផ្សាយ ឱ្យ ប្រជាពលរដ្ឋ យល់ដឹង កាន់តែ ច្បាស់ បន្ថែម ទៀត ជុំវិញ ពី ផល ប៉ះពាល់ នៃ ឥទ្ធិពល គ្រឿងញៀន ។ បន្ថែម ពី នេះ បន្ត ចូលរួម អប់រំ និង លើកទឹកចិត្ត អ្នក ញៀន គ្រឿងញៀន ឱ្យ បញ្ឈប់ ការប្រើប្រាស់ និង ជំរុញ ឱ្យ ពួកគេ ទៅ ព្យាបាល និង ស្ដារ នីតិសម្បទា ឱ្យ បាន ទាន់ ពេល វេលា ។
នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ ក៏ បាន សំណូមពរ ឱ្យ សិក្ខាកាម ទាំងអស់ បន្ត យក ចំណេះដឹង និង បទពិសោធន៍ ដែល ទទួល ពី វគ្គ បណ្តុះបណ្តាល ថ្ងៃ នេះ ទៅ ផ្សព្វផ្សាយ បន្ត ជូន សហការី និង ប្រែក្លាយទៅជា សកម្មភាព ជាក់ស្តែង សំដៅ បង្កេី ន និង ពង្រឹង ប្រសិទ្ធភាព ការងារ ស្រប តាម ទិសដៅ ការងារ របស់ ឧប នាយក រដ្ឋមន្ត្រី នេត សាវឿន ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង អនុសាសន៍ ដឹកនាំ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន ដាក់ចេញ នូវ អាទិភាព គន្លឹះ ទាំង ៥ចំណុច ៕
គួរ បញ្ជាក់ ថា បើ តាម ក្រសួង ដឹកជញ្ជូន ជើងហោះហើរ អន្តរជាតិ សរុប ចំនួន ៤២ ត្រូវបាន លុបចោល ប៉ុន្តែ សេវាកម្ម រថភ្លើង ល្បឿន លឿន ដែល តភ្ជាប់ ភាគ ខាងជើង និង ភាគ ខាងត្បូង តៃវ៉ាន់ មិន រង ផល ប៉ះពាល់ នោះ ទេ ៕ រូបភាព ពី AFP ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម បន្ត ជំរុញ ការផ្សព្វផ្សាយ ការអនុវត្ត កម្មវិធី គាំពារ សង្គម ចំនួន ៣ ដើម្បី ប្រាកដ ថា អ្នក ទទួល ផល ជាពិសេស ស្រ្តី មិន បាត់បង់ អត្ថប្រយោជន៍
ថ្លែង ក្នុង សិក្ខាសាលា ផ្សព្វផ្សាយ ស្តីពី ការអនុវត្ត កម្មវិធី គាំពារ សង្គម ទាំង បី នេះ លោក បណ្ឌិត ចន ណារិទ្ធ អនុ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម បាន លើកឡើង ថា កម្មវិធី គាំពារ សង្គម ទាំង ៣នេះ ត្រូវបាន រាជ រដ្ឋាភិបាល ប្រកាស ដាក់ ឱ្យ អនុវត្ត ជា បន្តបន្ទាប់ ដើម្បី ផ្តល់ អត្ថប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ ជាពិសេស ស្រ្តី ដែល ស្ថិត ក្នុង គ្រួសារ ក្រីក្រ ។
លោក បន្ត ថា ការបង្កើន ផ្សព្វផ្សាយ កម្មវិធី គាំពារ សង្គម ទាំង ៣នេះ គឺជា ផ្នែក មួយ ដ៏ សំខាន់ ក្នុង ការអភិវឌ្ឍ និង កសាង ប្រព័ន្ធ គាំពារ សង្គម អនុលោម តាម ការចង្គុល បង្ហាញ របស់ ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ២០១៦ - ២០២៥ និង យុទ្ធសាស្រ្ត បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ជា ការផ្សព្វផ្សាយ និង លើកកម្ពស់ ការយល់ដឹង ដល់ តំណាង ក្រសួង - ស្ថាប័ន ដៃគូ អភិវឌ្ឍន៍ ពាក់ព័ន្ធ គ្រឹះស្ថាន ឯកជន សាធារណជន ដែល ជា អ្នកទទួល ផល ។
លោក បាន ពន្យល់ ថា សម្រាប់ កម្មវិធី ផ្តល់ ប្រាក់ ឧបត្ថម្ភ របស់ រាជ រដ្ឋាភិបាល សម្រាប់ សមាជិក ប .ស.ស . ជា ស្រ្តី មាន ផ្ទៃពោះ និង កុមារ អាយុ ក្រោម ២ ឆ្នាំ និង កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន ស្រ្តី មាន ផ្ទៃពោះ និង កុមារ អាយុ ក្រោម ២ ឆ្នាំ មក ពី គ្រួសារ មាន បណ្ណ សមធម៌ ក្នុង អំឡុង ពេលនេះ ប្រសិនបើ គាត់ មាន កូន មិន ទាន់ គ្រប់ អាយុ២ ឆ្នាំ ក៏ អាច ស្នើសុំ អត្ថប្រយោជន៍ ឬ ប្រាក់ ឧបត្ថម្ភ ពី រដ្ឋ បាន ផងដែរ ។
លោក ពន្យល់ បន្ថែម ថា « មិន មែន មាន ន័យ ថា ទាល់តែ ម្តាយ មាន ផ្ទៃពោះ ទទួល ផល ពី កម្មវិធី រហូតដល់ ឆ្លង ទន្លេ ហើយ មាន កូន រហូតដល់ ២ឆ្នាំ បាន ទទួល នោះ ទេ ។ ប្រសិនបើ ថ្ងៃ នេះ មាន បងប្អូន មន្រ្តី រាជការ ជា ស្រ្តី ឬ កម្មករ និយោជិត ជា ស្រ្តី ដែល មិន បាន ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ពេល មាន ផ្ទៃពោះ ប៉ុន្តែ បើ ឥលូវនេះ កូន គាត់ មិន ទាន់ ផុត អាយុ២ ឆ្នាំ ក៏ គាត់ អាច ទៅ ចុះឈ្មោះ ដើម្បី ទទួល ផល បាន ផងដែរ ។ »
ដោយឡែក កម្មវិធី របប ថែទាំ សុខភាព សម្រាប់ បុគ្គល បម្រើការ ក្នុង សេវា កំសាន្ត នៃ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ លោក ជំរុញ ឱ្យ បុគ្គល បម្រើការ នៅក្នុង សេវាកម្ម កម្សាន្ត ទេសចរណ៍ ដែល មាន ជីវភាព ក្រីក្រ ទៅ ចុះឈ្មោះ សុំ បណ្ណ សមធម៌ ហើយ អ្នក មិន ទទួលបាន បណ្ណ សមធម៌ អាច ទៅ ចុះឈ្មោះ សុំ បណ្ណ ម .ស .ស . ដើម្បីឱ្យ ពួកគាត់ ទៅ ពិនិត្យ និង ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ រដ្ឋ ដោយ គិត ថ្លៃ ។
បើ តាម ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម បច្ចុប្បន្ន នេះ ប្រជាពលរដ្ឋ ដែល ស្ថិត ក្នុង ភាពក្រីក្រី ទទួលបាន បណ្ណ សមធម៌ សរុប មាន ជាង ៧០ ម៉ឺន ៥ពាន់ គ្រួសារ ។ ចំណែក កម្មករ និយោជិត បុគ្គលិក្រុមហ៊ុន ឯកជន និង មន្រ្តី រាជការ ដែល មាន បណ្ណ បសស កំពុង មាន សុពលភាព មាន ជិត ២លាន នាក់ ។ ប៉ុន្តែ មិន មែន ស្រ្តី នៅក្នុង ចំនួន ទាំងនេះ សុទ្ធតែ មាន ផ្ទៃពោះ និង មាន កូន តូច នោះ ទេ ។ ចំណែក ក្រុម គោលដៅ ស្ថិត ក្នុង វិស័យ សេវា កម្សាន្ត នៃ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ មាន ប្រមាណ ៣ម៉ឺន នាក់ ។
ឧប នាយក រដ្ឋមន្រ្តី ប្រចាំ ការ វង្សី វិស្សុត រដ្ឋមន្រ្តី ទទួលបន្ទុក ទីស្តីការ គណៈ រដ្ឋមន្រ្តី ដឹកនាំ កិច្ចប្រជុំ ក្រុមប្រឹក្សា សេដ្ឋកិច្ច សង្គមកិច្ច និង វប្បធម៌ នៃ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧
ឧប នាយក រដ្ឋមន្ត្រី ប្រចាំ ការ បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការចូលរួម របស់ ក .ស. វ. ក្នុង ការបំពេញ ភារកិច្ច ជា សេនាធិការ របស់ ទីស្ដីការ គណៈ រដ្ឋមន្រ្ដី លើ ការសិក្សា ស្រាវជ្រាវ និង ផ្ដល់ យោបល់ ជូន ទីស្តីការ គណៈ រដ្ឋមន្រ្ដី និង រាជ រដ្ឋាភិបាល ក្នុង គោលដៅ ពង្រឹង ប្រសិទ្ធភាព នៃ ការអនុវត្ត គោល យោបាយ ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្តិ ទាំងនោះ ឱ្យ មាន សង្គតិភាព និង ឆ្លើយតប នឹង សេដ្ឋកិច្ច សង្គមកិច្ច និង វប្បធម៌ នា ពេល កន្លងមក ។
ឧប នាយក រដ្ឋមន្រ្ដី ប្រចាំ ការ បាន គូសបញ្ជាក់ ឡើងវិញ ជូន អង្គប្រជុំ ថា មុខងារ និង ភារកិច្ច ចម្បង របស់ ក .ស. វ. រួម មាន ការងារ រៀបចំ របាយការណ៍ តាមដាន សិក្សា វិភាគ ស្ថានភាព សេដ្ឋកិច្ច សង្គម និង វប្បធម៌ និង ការផ្តល់ មតិ យោបល់ ជូន គណៈ រដ្ឋមន្ត្រី និង រាជ រដ្ឋាភិបាល លើ ទិដ្ឋភាព បច្ចេកទេស នៃ គោល នយោបាយ ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្តិ ផ្សេង ទៀត និង ការធ្វើ ការស្រាវជ្រាវ សម្រាប់ ផ្ដល់ ជា ធាតុ ចូលក្នុង ការរៀបចំ គោល នយោបាយ ឬ អនុវត្ត កិច្ចការ នានា (Applied Research) ។ល ។
ក្នុង បរិការណ៍ នៃ ការរីកចម្រើន របស់ កម្ពុជា ឈាន ឆ្ពោះទៅ សម្រេចបាន នូវ ឋានៈ ជា ប្រទេស ចំណូល មធ្យម កម្រិត ខ្ពស់ ឆ្នាំ ២០៣០ និង ប្រទេស ចំណូល ខ្ពស់ ២០៥០ . ឯកឧត្តម ឧប នាយក រដ្ឋមន្រ្ដី ប្រចាំ ការ បាន សង្កត់ធ្ងន់ លើ អាទិភាព ជា ចម្បង លើ ការបន្ដ ពង្រឹង សមត្ថភាព ស្ថាប័ន ទាំង កម្រិត ថ្នាក់ដឹកនាំ និង បច្ចេកទេស និង ក្នុង ការបំពេញ មុខងារ និង ភារកិច្ច នានា ដែល រាជ រដ្ឋាភិបាល ប្រគល់ ឱ្យ ប្រកបដោយ គុណភាព ដើម្បី ចូលរួមចំណែក ក្នុង ការអនុវត្ត យុទ្ធសាស្រ្ដ បញ្ចកោណ ដំណាក់កាល ទី១ ឱ្យ សម្រេចបាន សមិទ្ធផល ល្អ ប្រសើរ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ឯកឧត្តម ឧប នាយក រដ្ឋមន្រ្ដី ប្រចាំ ការ បាន ដាក់ចេញ នូវ ការណែនាំ តម្រង់ ទិសដៅ និង ផែនការ សម្រាប់ ការអនុវត្ដ ចំពោះ មុខ និង រយៈពេល មធ្យម សម្រាប់ ក .ស. វ. ដូចត ទៅ៖
១៖ ការរៀបចំ ផែនការ យុទ្ធសាស្ត្រ និង ផែនការអភិវឌ្ឍន៍ ស្ថាប័ន ក .ស. វ. ដើម្បី ពង្រឹង តួនាទី ជា « សេនាធិការ គោល នយោបាយ មួយ » របស់ រាជ រដ្ឋាភិបាល ក្នុង ការអនុវត្ត ការងារ ប្រកបដោយ បប្រសិទ្ធភាព . គុណភាព និង ទាន់ ពេល ។
៣៖ ការលើកកម្ពស់ ការបន្ដ តាមដាន ត្រួតពិនិត្យ និង ផ្តល់ យោបល់ កម្រិត បច្ចេកទេស លើ គោល នយោបាយ ច្បាប់ និង ឯកសារ បទដ្ឋាន គតិយុត្តិ ដោយ ត្រូវ មាន កិច្ចសហការ ជិតស្និទ រវាង ក្រសួង ស្ថាប័ន ជាពិសេស ជាមួយ ក្រុមប្រឹក្សា អ្នក ច្បាប់ និង អគ្គ នាយកដ្ឋាន បច្ចេកទេស ក្រោម ឱវាទ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ដើម្បី ពង្រឹង ប្រសិទ្ធភាព និង ថាមភាព ក្នុង ការបំពេញ ការងារ ។
កិច្ចប្រជុំ នេះ ដឹកនាំ ដោយ លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ.ប ។ បន្ទាប់ពី បាន ពិនិត្យ និង ពិភាក្សា យ៉ាង ល្អិតល្អន់ លើ ឯកសារ ម្តង មួយ ៗ រួច មក អង្គប្រជុំ គ.ជ. ប បាន កែសម្រួល និង សម្រេច ដូច ខាងក្រោម៖
ទី ២៖ ក្រោយពី បាន ស្តាប់ របាយការណ៍ របស់ លោក ទេព នី ថា អគ្គ លេខាធិការ គ.ជ. ប អំពី ការផ្តល់ យោបល់ របស់ ភាគី ពាក់ព័ន្ធ លើ សេចក្តីព្រាង បទបញ្ជា និង នីតិវិធី សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ រួច មក អង្គប្រជុំ គ.ជ. ប បាន ពិនិត្យ ម្តង មួយ ជំពូក ៗ និង បាន កែសម្រួល ពាក្យពេចន៍ មួយចំនួន ក្នុង សេចក្តីព្រាង បទបញ្ជា និង នីតិវិធី ។
អង្គប្រជុំ គ.ជ. ប បាន ឯកភាព លើ សេចក្តីព្រាង បទបញ្ជា និង នីតិវិធី ដែល មាន ចំនួន ១០ ជំពូក និង ឧបសម្ព័ន្ធ ។
សេចក្តីព្រាង បទបញ្ជា និង នីតិវិធី សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ត្រូវបាន គ.ជ. ប បញ្ជូន ទៅ ភាគី ពាក់ព័ន្ធ ចំនួន ៨០ ស្ថាប័ន ដើម្បី ផ្តល់ យោបល់ ។ ស្ថាប័ន ចំនួន ៣៦ បាន ផ្តល់ យោបល់ និង បញ្ជូន មក គ.ជ. ប វិញ ។
ទី ៣៖ កែសម្រួល និង ឯកភាព លើ ឯកសារ ពាក់ព័ន្ធ នឹង ភ្នាក់ងារ គណបក្ស នយោបាយ អ្នកសង្កេតការណ៍ ជាតិ អន្តរជាតិ អ្នកសង្កេតការណ៍ ជាតិ ចល័ត និង ភ្ញៀវ ពិសេស សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ មាន ដូច ខាងក្រោម៖
* សេចក្តីជូនដំណឹង ស្តីពី ការដាក់ និង ការទទួល ពាក្យ សុំ ចុះឈ្មោះ ភ្នាក់ងារ គណបក្ស នយោបាយ អ្នកសង្កេតការណ៍ ជាតិ និង អន្តរជាតិ * ពាក្យ សុំ ចុះឈ្មោះ ភ្នាក់ងារ គណបក្ស នយោបាយ ( ទម្រង់បែបបទ ១០០៧ )* ពាក្យ សុំ ចុះឈ្មោះ អ្នកសង្កេតការណ៍ ជាតិ * ពាក្យ សុំ ចុះឈ្មោះ អ្នកសង្កេតការណ៍ អន្តរជាតិ * គំរូបណ្ណ សម្គាល់ ភ្នាក់ងារ គណបក្ស នយោបាយ អ្នកសង្កេតការណ៍ ជាតិ អ្នកសង្កេត -ការណ៍ អន្តរជាតិ អ្នកសង្កេតការណ៍ ជាតិ ចល័ត និង ភ្ញៀវ ពិសេស ។
និង ទី ៤៖ ឯកភាព លើ ប្រតិទិន និង ផែនការ មេ សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ អាណត្តិ ទី៤ ឆ្នាំ ២០២៤ ។
លោក ហ្សេលេន ស្គី បាន បង្ហោះ សារ លើ បណ្តាញ សង្គម ដូច្នេះ ថា « កំពុង ស្ថិត នៅ ទីក្រុង Granada របស់ អេស៉្បាញ សម្រាប់ កិច្ចប្រជុំ កំពូល នៃ សហគមន៍ នយោបាយ អឺរ៉ុប ។ យើង នឹង ធ្វើការ នៅលើ ផ្លូវ រួមគ្នា ហើយ មាន ជំនួប ទ្វេ ភាគី សំខាន់ ៗ ។ កូនសោ គន្លឹះ សម្រាប់ យើង ជាពិសេស នៅ មុន រដូវ រងា មកដល់ គឺ ត្រូវ ពង្រឹង សមត្ថភាព ការពារ ដែន អាកាស ហើយ យើង មាន រួចរាល់ ផងដែរ នូវ មូលដ្ឋាន សម្រាប់ កិច្ចព្រមព្រៀង ថ្មី ៗ ជាមួយ បណ្តា ដៃគូ របស់ យើង ។ ពួកយើង កំពុងតែ ត្រៀម រៀបចំ បញ្ជាក់ ឱ្យ ច្បាស់ ក៏ ដូចជា អនុវត្ត ពួកវា » ។
សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន បញ្ជាក់ ថា ការត្រៀម រថយន្ដក្រុង ៤៥៥ គ្រឿង ដឹក ប្រជាពលរដ្ឋ ទៅ លេង ស្រុក កំណើត ដោយ មិន បង់ប្រាក់ ក្នុង ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ រយៈពេល ៥ ថ្ងៃ នេះ អនុវត្ត តាម ប្រសាសន៍ ដឹកនាំ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្តី្រ នៃ កម្ពុជា កាលពី ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២៣ ៕
សម្រាប់ លទ្ធផល បណ្ដោះអាសន្ន ថ្ងៃទី៥ នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២៣ ត្រូវនឹង ថ្ងៃទី ៤ ខែតុលា ឆ្នាំ ២០២៣ នៅ ទូទាំង ប្រទេស មាន ដូច ខាងក្រោម៖
លទ្ធផល សរុប រយៈពេល ៤ ថ្ងៃ នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោ ត៖
( បាត់ដំបង ) ៖ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនិតិសម្បទា ខេត្ត បាត់ដំបង បាន រៀបចំ « ទិវា មនុស្ស ចាស់ កម្ពុជា និង មនុស្ស ចាស់ អន្តរជាតិ ០១តុលា ឆ្នាំ ២០២៣ » ក្រោម ប្រធានបទ « ការជួយ មនុស្ស ចាស់ គឺ ជួយ យើង ទាំងអស់ គ្នា » ជា ទិវា មនុស្ស ចាស់ កម្ពុជា លើក ទី២៥ និង អន្តរជាតិ លើក ទី ៣៣ នា ព្រឹក ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ នៅ សាល ប្រជុំ មន្ទីរ ។
ពី ធី នេះ ក្រោម វត្តមាន លោក ផេង សិទ្ធី អភិបាល រង ខេត្ត តំណាង លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង . លោក ភួង សិទ្ធ ប្រធាន មន្ទីរ សង្គកិច្ច អតីត យុទ្ធជន និង យុវនិតិសម្បទា ខេត្ត បាត់ដំបង លោក ទុំ វីរ៉ា នាយក អង្គការ មនុស្ស ចាស់ កម្ពុជា មន្រ្តី រាជការ មន្ទីរ ពាក់ព័ន្ធ និង មនុស្ស ចាស់ ចូលរួម ប្រមាណ ១០០ នាក់ ។
លោក ទុំ វីរ៉ា បាន ថ្លែង ថា អង្គការ មនុស្ស ចាស់ កម្ពុជា តែងតែ បាន សហការ និង យកចិត្តទុកដាក់ ជាមួយ ប្រធាន មន្ទីរ សង្គកិច្ច អតីត យុទ្ធជន និង យុវនិតិសម្បទា ខេត្ត បាត់ដំបង រហូតមក ដោយ បាន បង្កើត សមាគម មនុស្ស ចាស់ នៅក្នុង ក្រុង ស្រុក មួយចំនួន ក្នុង ខេត្ត បាត់ដំបង ។
នៅ ខេត្ត បាត់ដំបង នេះ មាន មនុស្ស ចាស់ ច្រើន ជាង គេ ក្នុង ចំណាត់ថ្នាក់ ទី៥ នៃ រាជធានី ខេត្ត ទាំង ផ្សេង ៗ នៅ កម្ពុជា ។ លើស ពី នេះ អង្គការ បាន បាន សហការ ជាមួយ មន្ទីរ សង្គមកិច្ច កិច្ច បង្កើត សមាគម មនុស្ស ចាស់ នៅ ខេត្ត ចំនួន ៨ រាជធានី ខេត្ត មាន នៅ ខេត្ត ព្រៃវែង ស្វាយរៀង ត្បូងឃ្មុំ បន្ទាយមានជ័យ ព្រះវិហារ និង រាជធានី ភ្នំពេញ ដែល មាន សមាគម សរុប រួម ២៤០ សមាគម ផងដែរ ។
លោក ផេង សិទ្ធី បាន ថ្លែង ថា « ទិវា មនុស្ស ចាស់ កម្ពុជា និង មនុស្ស ចាស់ អន្តរជាតិ ០១ តុលា ២០២៣ » ដែល រៀបចំ ដោយ មន្ទីរ សង្គកិច្ច អតីត យុទ្ធជន និង យុវនិតិសម្បទា ខេត្ត បាត់ដំបង នា ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ក្នុង នាម រដ្ឋបាល ខេត្ត សូម គាំទ្រ និង សហការ ជួយ បង្ក លក្ខណៈ លើ ការងារ មនុស្ស ចាស់ ក្នុង ការរស់នៅ របស់ ពួកគាត់ ។
លោក បាន សម្តែង នូវ អំណរ សាទរ យ៉ាង ស្មោះស្ម័គ្រ ក៏ ដូចជា សូម សម្តែង នូវ ការដឹងគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ដល់ មនុស្ស វ័យ ចាស់ កម្ពុជា ទូទាំង ប្រទេស ក្នុង ការចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង បុព្វហេតុ ការពារ បូរណភាព ទឹកដី ការអភិវឌ្ឍន៍ សង្គម និង ជាពិសេស ជា ធនធាន ដ៏ កម្រ ដែល អាច និយាយ បាន ថា មនុស្ស ចាស់ គឺជា មរតក រស់ ដែល យើង គ្រប់ គ្នា អាច ពឹងផ្អែក និង ស្វែងរក ជំនួយ បាន ទាំង ផ្នែក បញ្ញា ស្មារតី ប្រវត្តិសាស្រ្ត និង បទពិសោធន៍ នៃ សង្គម នីមួយ ៗ ។
គួរ រំលឹក ផងដែរ ថា នៅក្នុង ប្រទេស កម្ពុជា យើង មាន វប្បធម៌ ប្រពៃណី ដ៏ ល្អ ដែល កូន ចៅ គ្រប់ រូប ត្រូវ ថែទាំ និង តបស្នងគុណ ដល់ ជន ដែល មាន បុព្វការៈ មាន ដូចជា លោក យាយ លោក តា មាតាបិតា របស់ ខ្លួន ដែល បាន បង្ហាញ ពី កាយវិការ ដ៏ ប្រពៃ សម្រាប់ ជា គម្រូ ដល់ មនុស្ស ជំនាន់ ក្រោយ ៗ ទៀត ។
ក្នុង ន័យ នេះ ដើម្បី សម្ដែង នូវ ការដឹង គុណ ចំពោះ គុណូបរការៈ ដ៏ ថ្លៃថ្លា របស់ មនុស្ស វ័យ ចាស់ ដែល បាន បន្សល់ទុក នូវ សមិទ្ធផល និង មរតក ជាច្រើន រាជ រដ្ឋាភិបាល កម្ពុជា បាន នឹង កំពុង យកចិត្តទុកដាក់ ក្នុង ការងារ លើកកម្ពស់ វិស័យ សុខុមាលភាព មនុស្ស វ័យ ចាស់ ដែល សំដៅ ធ្វើឲ្យ ប្រជាជន វ័យ ចាស់ ក្នុង ប្រទេស បាន រស់ នៅ ប្រកបដោយ សុខុមាលភាព ល្អ និង មាន គុណភាព ជីវិត ខ្ពស់ ។
ជាមួយគ្នា នេះ ដែរ រាជ រដ្ឋាភិបាល ក៏ បាន បង្កើត នូវ គោល នយោបាយ មួយចំនួន ដែល គាំទ្រ និង លើកកម្ពស់ មនុស្ស វ័យ ចាស់ ដូចជា គោល នយោបាយ ជាតិ ប្រជាជន ឆ្នាំ ២០១៦ - ២០៣០ ក្របខ័ណ្ឌ គោល នយោបាយ ជាតិ គាំពាសង្គម ឆ្នាំ ២០១៦ - ២០២៥ គោល នយោបាយ ថែទាំ សុខភាព និង យុទ្ធសាស្រ្ត សុខាភិបាល ជាតិ សម្រាប់ ថែទាំ សុខភាព មនុស្ស ចាស់ ឆ្នាំ ២០១៦ ។
ពិសេស ជាង នេះ ទៅ ទៀត ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនិតិសម្បទា បាន ដាក់ចេញ អោយ ប្រើប្រាស់ នូវ « គោល នយោបាយ ជាតិ ស្តីពី មនុស្ស វ័យ ចាស់ ឆ្នាំ ២០១៧ - ២០៣០ » ដែល បាន កែសម្រួល ពី គោល នយោបាយ ចាស់ ឆ្នាំ ២០០៣ ។ ដែល នេះ ជា សមិទ្ធិផល ដ៏ មាន តម្លៃ សម្រាប់ ប្រជាជន កម្ពុជា យើង ទាំងមូល ជាពិសេស គឺ មនុស្ស ចាស់ ។
ដើម្បី ធ្វើឲ្យ គោល នយោបាយ ទាំងអស់ នេះ កាន់តែ មាន តម្លៃ និង ប្រសើរ ថែម ទៀត គឺ ទាមទារ ឲ្យ មាន ការចូលរួម ទាំងអស់ គ្នា ពី គ្រប់ ក្រសួង មន្ទីរ - ស្ថាប័ន ពាក់ព័ន្ធ ទាំងអស់ ក្នុង ការអនុវត្ត គោល នយោបាយ ទាំងអស់ នេះ ឲ្យ ស្រប តាម គោលការណ៍ ណែនាំ របស់ រាជ រដ្ឋាភិបាល ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ របស់ មនុស្ស ចាស់ នៅ តាម មូលដ្ឋាន ។
នេះ ជា រឿង ដ៏ ចាំបាច់ បំផុត សម្រាប់ យើង ទាំងអស់ គ្នា ដែល ត្រូវ ចូលរួម អនុវត្ត បន្ថែម លើ នេះ ទៅ ទៀត រាជ រដ្ឋាភិបាល ក៏ បាន បង្កើត ឲ្យ មាន អនុគណៈកម្មាធិការ កម្ពុជា ដើម្បី មនុស្ស ចាស់ នៅ គ្រប់ រាជធានី - ខេត្ដ ដែល មាន អភិបាល ខេត្ត ជា ប្រធាន កិត្តិយស និង អភិបាល រង ខេត្ត ជា ប្រធាន ព្រមទាំង ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ជា អនុប្រធាន ចិន្ត្រៃ យ៌ ។
បើ ទោះបីជា យ៉ាង នេះ ក៏ដោយ បញ្ញា ប្រឈម របស់ មនុស្ស វ័យ ចាស់ នៅក្នុង ប្រទេស ជាពិសេស នៅក្នុង ខេត្ត បាត់ដំបង ក៏ នៅតែ ជា កង្វល់ ដែល យើង ទាំងអស់ គ្នា ត្រូវតែ យកចិត្តទុកដាក់ ខ្ពស់ បំផុត និង ចូលរួម រិះរក មធ្យោបាយ សមស្រប នានា ដើម្បី ដោះស្រាយ នូវ បញ្ហា ទាំងនោះ ប្រកបដោយ ប្រសិទ្ធិភាព និង ស័ក្កិសិទ្ធិភាព ។
( ភ្នំពេញ ) ៖ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ បើក វគ្គ បណ្ដុះបណ្ដាល ស្ដីពី « ការពង្រឹង ភាពអង់អាច និង ភាព ជា អ្នកដឹកនាំ ដល់ នគរបាល នារី » ដល់ ក្រុមការងារ យេនឌ័រ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ។ ពិធី នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោកស្រី ឧត្តមសេនីយ៍ ឯក រស់ ច័ន្ទ សោភា អគ្គ ស្នងការ រង នគរបាល ជាតិ តំណាង នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ។
ថ្លែង ក្នុង ឱកាស នោះ លោកស្រី ឧត្តមសេនីយ៍ ឯក រស់ ច័ន្ទ សោភា បាន លើកឡើង ថា ក្រុមការងារ យេនឌ័រ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ត្រូវ ពង្រឹង បន្ថែម ជំនាញ ទន់ លើ ផ្នែក ភាព ជា អ្នកដឹកនាំ ដល់ នគរបាល នារី ខណៈ ដែល ជា ឱកាស បាន ជួបគ្នា ផ្ទាល់ ត្រូវ ចាប់ យក ចំណេះដឹង និង បទពិសោធន៍ ថ្មី ៗ ទទួលបាន ពី ការចែករំលែក ក្នុង វគ្គ ដើម្បី អភិវឌ្ឍ សមត្ថភាព របស់ ខ្លួន ក្នុង ការបំពេញ ការងារ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ។
រដ្ឋមន្រ្តី បរិស្ថាន៖ ថវិកា មូលនិធិ បរិស្ថាន ត្រូវ បម្រើ ឱ្យ ការងារ អាទិភាព ក្រសួង ដោយ តម្លាភាព គណនេយ្យភាព ដើម្បី ឈានឈ្ពោះទៅ សម្រេចបាន ជោគជ័យ ស្រប តាម យុទ្ធសាស្រ្ត បញ្ចកោណ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ថ្លែង ថា ការប្រើប្រាស់ ថវិកា មូលនិធិ បរិស្ថាន ចាំបាច់ ត្រូវ បម្រើ ឱ្យ ការងារ អាទិភាព របស់ ក្រសួង និង មាន តម្លាភាព គណនេយ្យភាព ហើយ សមស្រប តាម យុទ្ធសាស្រ្ត បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ដំណាក់កាល ទី១ ។
ការថ្លែង បែប នេះ របស់ លោក រដ្ឋមន្រ្តី បរិស្ថាន បាន ធ្វើឡើង នៅក្នុង ជំនួប សំណេះសំណាល ជាមួយ មន្រ្តី រាជការ នៃ លេខាធិការដ្ឋាន នៃ គណៈកម្មាធិការ មូលនិធិ បរិស្ថាន និង សង្គម ជា លក្ខណៈ គ្រួសារ បរិស្ថាន នៅ ទីស្តីការ ក្រសួង នា ថ្ងៃទី ០៤ ខែតុលា ឆ្នាំ ២០២៣ ។
ជាមួយគ្នា នេះ លោក រដ្ឋមន្រ្តី បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ឧប នាយក រដ្ឋមន្រ្តី សាយ សំអាល់ បាន រៀបចំ ថវិកា មូលនិធិ បរិស្ថាន និង សង្គម ឡើង ដើម្បី បំពេញ និង បម្រើ ឱ្យ វិស័យ បរិស្ថាន ទៅ តាម អាទិភាព ដែល ក្រសួង បាន ដាក់ចេញ ហើយ ចំពោះ ករណី ដែល មិន ចំ ទិសដៅ អាទិភាព ត្រូវ សម្រួច ទិសដៅ ឱ្យ ចំ ឡើងវិញ ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ស្តីពី ការតែងតាំង សមាសភាព ក្រុមប្រឹក្សា នីតិកម្ម និង យុត្តិធម៌ នៃ ក្រសួង យុត្តិធម៌ ដែល មាន ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ ជា ប្រធាន
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ ខ្មែរ បាន ចេញ ព្រះរាជ ក្រឹត្យ ស្តីពី ការតែងតាំង សមាសភាព ក្រុមប្រឹក្សា នីតិកម្ម និង យុត្តិធម៌ នៃ ក្រសួង យុត្តិធម៌ ។ ក្នុង ព្រះរាជ ក្រឹត្យ បាន បញ្ជាក់ ថា ក្រុមប្រឹក្សា នីតិកម្ម និង យុត្តិធម៌ នៃ ក្រសួង យុត្តិធម៌ មាន ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ជា ប្រធាន ៕
មនុស្ស ២នាក់ ដែល បាន បាត់បង់ជីវិត ក្នុង ហេតុការណ៍ បាញ់ប្រហារ នោះ គឺជា ជន បរទេស មកពី ចិន និង មីយ៉ាន់ម៉ា ខណៈ ៥នាក់ ទៀត រងរបួស ក្នុង នោះ មាន ជន បរទេស និង ជនជាតិ ថៃ ផ្ទាល់ ។ ជនសង្ស័យ ជា ខ្មាន់ កាំភ្លើង ត្រូវបាន ចោទប្រកាន់ ជា ផ្លូវការ ពី បទ ឃាតកម្ម គិត ទុក ជាមុន បទ កាន់កាប់អាវុធ ខុស ច្បាប់ បទ យក អាវុធ ទៅ កន្លែង សាធារណៈ ដោយ ខុស ច្បាប់ និង បទ បាញ់ កាំភ្លើង នៅ ទី សាធារណៈ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម លឹម ជា វុត្ថា ស្ថាបនិក និង ជា អគ្គ នាយក ព័ត៌មាន Fresh News ព្រមទាំង ថ្នាក់ដឹកនាំ និង បុគ្គលិក ទាំងអស់ សូម ផ្ញើ សារ ជូនពរ និង សូម ចូលរួម អបអរសាទរ ជូន ចំពោះ ឯកឧត្តម ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក ដែល ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ ដំឡើង ឋានន្ដរស័ក្ដិ ថ្នាក់ « នាយ ឧត្តមសេនីយ៍ » ។
ការទទួលបាន ការដំឡើង ឋានន្តរសក្តិ នាយ ឧត្តមសេនីយ៍ នា ពេលនេះ គឺជា សក្ខីភាព ថ្មី មួយ ទៀត បង្ហាញ ឲ្យ ឃើញ នូវ ស្នា ដ៏ សកម្ម នៃ កិច្ច ខិតខំ ប្រឹងប្រែង យក អស់ កម្លាំង កាយ ចិត្ត បញ្ញា ស្មារតី និង ការលះបង់ មិន អាច ប្រកែក បាន របស់ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ តាមរយៈ ការចូលរួម ថែរក្សា សុខ សន្តិភាព និង ពូន ជ្រុំ នូវ លទ្ធិ ប្រជាធិបតេយ្យ និង នីតិរដ្ឋ ក្រោម ការដឹកនាំ ប្រកបដោយ ភាពឈ្លាសវៃ និង គតិបណ្ឌិត របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
នៅក្នុង ឱកាស ដ៏ វិសេសវិសាល នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម លើកហត្ថ បួងសួង វត្ថុ ស័ក្ដិសិទ្ធិ ទាំងឡាយ សូម ជួយ អភិបាល គ្រង រក្សា ប្រោះ ព្រំ ប្រសិទ្ធ ពរ បវរ មហា ប្រសើរ ជូន ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ និង លោកជំទាវ ព្រមទាំង គ្រួសារ ជា ទីស្រឡាញ់ សូម បាន ប្រកប នូវ ព្រះពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ ជានិច្ច និរន្តរ៍ ៕ អាជ្ញាធរ ខេត្ត កំពត អំពាវនាវ អាណាព្យាបាល មាតាបិតា នាំ កូន ទៅ ទទួល វ៉ាក់សាំង ការពារ ជំងឺ មហារីក មាត់ ស្បូន និង វ៉ាក់សាំង ការពារ ជំងឺ ផ្សេង ៗ ទៀត ឲ្យបាន គ្រប់ មុខ
( កំពត ) ៖ លោក អភិបាល រង ខេត្ត កំំពត ស៊ីវ ផេង បាន អំពាវនាវ អាណាព្យាបាល មាតាបិតា គ្រប់ រូប ត្រូវ នាំ កូន របស់ ខ្លួន ទៅ ទទួល វ៉ាក់សាំង ការពារ ជំងឺ មហារីក មាត់ ស្បូន និង វ៉ាក់សាំង ការពារ ជំងឺ ផ្សេង ៗ ទៀត ឲ្យបាន គ្រប់ មុខ ដែល ក្រសួង សុខាភិបាល ផ្តល់ ជូន សំដៅ លើកកម្ពស់ សុខភាព ទារក និង កុមារ ដើម្បី ចូលរួម កាត់បន្ថយ អត្រា ស្លាប់ ដោយសារ ជំងឺ ផ្សេង ៗ ដែល អាច បង្ការ បាន នៅក្នុង ពេល បច្ចុប្បន្ន និង ទៅ អនាគត ។
ការអំពាវនាវ បែប នេះ ខណៈ លោក អភិបាល រង ខេត្ត ស៊ីវ ផេង ចូលរួម ជា អធិបតី ក្នុង ពិធី ប្រកាស បញ្ជូល ឆ្នាំ បង្ការ ជំងឺ មហារីក មាត់ ស្បូន ដល់ កុមារី អាយុ ៩ ឆ្នាំ ដែល បាន រៀបចំ ប្រព្រឹត្ត ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២៣ នៅ សាលា បឋមសិក្សា កំពត ក្រុង ស្ថិត ក្នុង សង្កាត់ កំពង់កណ្តាល ក្រុង កំពត ។
ទន្ទឹម នេះ លោក ស៊ីវ ផេង បាន ឡើង ទៀត ថា រាជ រដ្ឋាភិបាល បាន ចាត់ទុក កម្មវិធី ជាតិ ផ្តល់ ថ្នាំ បង្ការ ជា ការវិនិយោគ លើ វិស័យ សុខភាព សាធារណៈ របស់ កុមារ ដ៏ មាន ប្រសិទ្ធភាព មួយ ព្រមទាំង បាន ចូលរួមចំណែក ដ៏ សំខាន់ ក្នុង ការកាត់បន្ថយ អត្រា ឈឺ ពិការភាព និង ស្លាប់ របស់ កុមារ នៅ ទូទាំង ប្រទេស ។
លោក ថា « រាជ រដ្ឋាភិបាល បាន ផ្តល់ ថវិកា ជាតិ សម្រាប់ ទិញ វ៉ាក់សាំង ជាប្រចាំ និង បដិភាគ ជាមួយ អង្គការ Gavi ក្នុង ការបញ្ជាទិញ វ៉ាក់សាំង ថ្មី ៗ ជា បន្តបន្ទាប់ ហើយ រហូតមកដល់ ថ្ងៃ នេះ យើង មាន វ៉ាក់សាំង រហូតដល់ ១២មុខ សម្រាប់ ផ្តល់ ជូន ទារក និង កុមារ ។ ចំពោះ អាណាព្យាបាល ដែល បាន នាំ កូន មក ទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ មហារីក មាត់ ស្បូន ពួកគាត់ ទាំងអស់ គ្នា បាន សម្តែង សេចក្តីសប្បាយ ចិត្ត ដែល រាជ រដ្ឋាភិបាល បាន ផ្តល់ វ៉ាក់សាំង នេះ ឲ្យ ឥត គិត ថ្លៃ » ។
លោក បាន អំពាវនាវ ដល់ ពលរដ្ឋ ទាំងអស់ ត្រូវ នាំ កូន របស់ ខ្លួន មក ទទួល ការចាក់ វ៉ាក់សាំង នេះ ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី ការពារ សុខភាព កូន របស់ ខ្លួន តទៅ ថ្ងៃ អនាគត ។
លោក ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ក៏ បាន អំពាវនាវ មាតាបិតា អាណាព្យាបាល កុមារ ទាំងអស់ សូម នាំ កូន មក ទទួល វ៉ាក់សាំង របស់ កម្មវិធី ជាតិ ផ្តល់ ថ្នាំ បង្ការ ឱ្យ បាន គ្រប់ គ្នា នៅ តាម សាលារៀន មណ្ឌល សុខភាព ឬ តាមរយៈ បុគ្គលិក ផ្តល់ ថ្នាំ បង្ការ នៅ តាម ភូមិ ទៅ តាម ផែនការ និង ការណាត់ របស់ បុគ្គលិក សុខាភិបាល កុំបី ខាន ឡើយ ៕
រាជ រដ្ឋាភិបាល ប្រគល់ ភារកិច្ច ជូន ទេសរដ្ឋមន្ត្រី ថោង ខុន ជា ប្រធាន គណៈកម្មាធិការ អភិវឌ្ឍន៍ ទេសចរណ៍ និង ប្រធាន គណៈកម្មការគ្រប់គ្រង និង អភិវឌ្ឍន៍ ទេសចរណ៍ សៀមរាប - អង្គ រ
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល បាន ប្រគល់ ភារកិច្ច ជូន លោក ថោង ខុន ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស ឱ្យ ធ្វើជា ប្រធាន គណៈកម្មាធិការ អភិវឌ្ឍន៍ ទេសចរណ៍ និង ប្រធាន គណៈកម្មការគ្រប់គ្រង និង អភិវឌ្ឍន៍ ទេសចរណ៍ សៀមរាប - អង្គរ ។
ការបញ្ជាក់ ឲ្យដឹង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី អបអរសាទរ ទិវា គ្រូបង្រៀន ៥ តុលា ក្រោម ប្រធានបទ « គ្រូបង្រៀន ជា សសរ ស្ដម្ភ នៃ កំណែទម្រង សាលារៀន ឆ្ពោះ ទៅរក ឧត្ដម ភាព » នា ព្រឹក ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ នៅ វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា ។
បន្ថែម ពី នោះ ទៀត សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឲ្យដឹង ថា ថវិកា ជាង ២០០ លាន ដុល្លារ នេះ រាជ រដ្ឋាភិបាល បាន យកមក បង្កើន ថវិកា ក្នុង ការគាំពារ សង្គម ហើយ ថវិកា នេះ វា អត់ មាន ប៉ះពាល់ ដល់ មន្ដ្រី នោះ ទេ គ្រាន់តែ គម្រោង សិក្សា មួយចំនួន មិន ទាន់ ចាំបាច់ ព្យួរ ចោល សិន ដើម្បី យក ថវិកា ជួយ ប្រជាពលរដ្ឋ ដាក់ ឲ្យ ចំ គោលដៅ នៃ ការកំណែទម្រង់ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ការឧបត្ថម្ភ គាំទ្រ ដល់ វិស័យ អប់រំ ដល់ អ្នកគ្រូ - លោកគ្រូ សម្ដេច សង្ឃឹម ថា បើសិនជា មាន ការប៉ះ ប៉ូវ ជូន ដល់ អ្នកគ្រូ - លោកគ្រូ ច្រើន ជាង មន្ដ្រី ធម្មតា សូម មន្ដ្រី ធម្មតា ស្ថាប័ន ផ្សេង កុំ ច្រណែន ជាមួយ អ្នកគ្រូ - លោកគ្រូ ព្រោះ ពួកគាត់ ជា អ្នកបង្រៀន កូន ចៅ យើង ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ដ ទៀត ថា ការរៀបចំ គោល នយោបាយ នេះ កាត់ ពី អ្វី ដែល មិន ចាំបាច់ គម្រោង ខ្លះ មិន ចាំបាច់ យកមក ដាក់ គម្រោង ឲ្យ ចំ គោលដៅ ។
ជាមួយគ្នា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ប្រាប់ ឲ្យ ពិនិត្យ មើល ឡើងវិញ នៅក្នុង កម្មវិធី មួយចំនួន របស់ ក្រសួង អប់រំ និង គ្រប់ ក្រសួង ទាំងអស់ ព្រោះថា កម្មវិធី ខ្លះ លែង ត្រូវ ស្ថានភាព ហើយ ដូច្នេះ កុំ ភ័យ ព្រួយ កាត់ វា ចោទ ដើម្បី យក លុយ ទាំងនោះ បង្វែរ ទៅ កន្លែងណា ដែល ជា អទិភាព ៕
ថ្លែង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រារព្ធ ទិវា គ្រូបង្រៀន លើក ទី ២៦ នា ព្រឹក ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា សម្តេច មិន លុប ចំពោះ ផែនការរើស មន្រ្តី ឆ្នាំ ២០២៣ នោះ ទេ ប៉ុន្តែ អាច មាន ការយឺតយ៉ាវ បន្តិច ដោយសារតែ រាជ រដ្ឋាភិបាល ដាក់ចេញ នូវ យន្តការ ថ្មី ។
សម្តេច បាន បន្ថែម ដូច្នេះ ថា៖ « ការឧបត្ថម្ភ មន្ត្រី លោកគ្រូ អ្នកគ្រូ យើង ត្រូវ លើកទឹកចិត្ត ម៉ោង នេះ មិន មែន ម៉ោង យើង ចាប់បង្ខំ ទេ យើង ត្រូវ ដាក់ ឱ្យ ចំ គោលដៅ ព្រោះ លោកគ្រូ អ្នកគ្រូ យើង ពឹង គាត់ ដើម្បី ជួយ បណ្តុះបណ្តាល ធនធាន មនុស្ស » ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ដូចនេះ ថា « ឆ្លៀត ឱកាស នេះ ខ្ញុំ សូម ប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ ស្តង់ដារ សាលារៀន គំរូ និង ពានរង្វាន់ សាលា គំរូ សម្តេច មហា បវរធិបតី សម្រាប់ សាលារៀន ដែល សម្រេចបាន ស្តង់ដារ សាលារៀន គំរូ ចាប់ពី ឆ្នាំ សិក្សា ២០២៣ - ២០២៤ នេះ តទៅ » ។
សម្រាប់ រយៈពេល ២ឆ្នាំ ខាងមុខ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ស្នើរ ដល់ គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ចូលរួម ជួយ អភិវឌ្ឍន៍ សាលារៀន ចាប់ពី ថ្នាក់ មត្តេយ្យ ដល់ មធ្យមសិក្សា តាម គ្រប់ រូបភាព និង គ្រប់ មធ្យោបាយ ទៅ តាម ស្តង់ដារ ទាំង ៥ រួម មាន៖
ទី ១៖ លទ្ធផល សិក្សា របស់ សិស្ស៖ ត្រូវ កំណត់ យក លទ្ធផល សិក្សា របស់ សិស្ស ជា គោល និង កំណត់ យក មុខវិជ្ជា ភាសា ខ្មែរ គណិតវិទ្យា និង វិទ្យាសាស្ត្រ ជាមុខវិជ្ជា អតិភាព ។
ទី២៖ ការបង្រៀន និង រៀន៖ ត្រូវ បង្កើត កម្មវិធី សិក្សា បន្ថែម ដូច ជា៖ ការបង្រៀន ភាសា បរទេស កុំព្យូទ័រ បំណិន ជីវិត មូលដ្ឋាន ហើយ ត្រូវ រៀបចំ កម្មវិធី ក្រោ ម៉ោង សិក្សា ដូចជា កម្មវិធី អភិវឌ្ឍន៍ យុវជន កម្មវិធី ស្ម័គ្រ សហគមន៍ និង បរិស្ថាន ពង្រឹង វិន័យ និង សីលធម៍ ចរិយា ធម៍ សុជីវធម៍ និង គុណធម៍ ឥរិយាបថ ល្អ របស់ ល្អ បុគ្គលិក អប់រំ និង សិស្សានុសិស្ស ។
ទី៣៖ ការចូលរួម របស់ សហគមន៍ និង មាតាបិតា៖ សូម អំពាវនាវ ដល់ មាតាបិតា អាណាព្យាបាល និង សហគមន៍ ជួយ ជំរុញ ការសិក្សា របស់ សិស្ស និង ទប់ស្កាត់ ការបាត់បង់ ការសិក្សា ហើយ ត្រូវ លើកទឹកចិត្ត កូន ឱ្យ ចូលរៀន ក្នុង សាលា ឱ្យ បាន គ្រប់ ៗ គ្នា ។
ទី៤៖ ដំណើរ ប្រតិបត្តិការ របស់ រដ្ឋបាល សាលារៀន៖ ត្រូវ ធ្វើ អធិការកិច្ច ផ្ទៃក្នុង និង ការប្រជុំ បច្ចេកទេស ហើយ គណៈ គ្រប់គ្រង និង គ្រូបង្រៀន ត្រូវបាន ទទួល ការហ្វឹកហាត់ សមត្ថភាព ជាប្រចាំ ។
ទី៥៖ គណនេយ្យភាព របស់ សាលា៖ គ្រូបង្រៀន ត្រូវ គោរព តាម ក្រមសីលធម៍ វិជ្ជាជីវៈ ត្រូវ បង្រៀន គ្រប់ ម៉ោង តាម កម្មវិធី សិក្សា ដែល បាន កំណត់ ហើយ អង្គភាព ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ត្រូវ ពិនិត្យ សាលារៀន ជួយ គាំទ្រ និង ផ្តល់ ការហ្វឹកហាត់ ប្រកបដោយ ប្រសិទ្ធភាព ដើម្បី គាំទ្រ ដល់ លោកគ្រូ អ្នកគ្រូ ។
បន្ថែម ពី នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក្នុង នាម រាជ រដ្ឋាភិបាល ក៏ បាន ស្នើរ ដល់ អាណាព្យាបាល ទាំងអស់ ចូលរួម ឱ្យ កាន់តែ សកម្ម ក្នុង ការអប់រំ កូន ចៅ ឱ្យ មាន ចរិយា សម្បត្តិ ល្អ ឱ្យ សក្តិសម ជា កុលបុត្រ ខ្មែរ ដែល មាន អរិយធម៍ ខ្ពង់ខ្ពស់ មាន គុណធម៍ សីលធម៍ និង សុជីវធម៍ ព្រមទាំង ដឹង គុណូបការៈ ចំពោះ លោកគ្រូ អ្នកគ្រូ ដែល បាន បង្ហាត់ បង្រៀន កូន ខ្មែរ ឱ្យ មាន ចំណោះ ដឹង ជំនាញ សមត្ថភាព និង ទេពកោសល្យ ផងដែរ ៕
កម្ពុជា - ថៃ គ្រោង ពង្រីក កិច្ចសហប្រតិបត្តិការ ចែករំលែក ព័ត៌មាន ឥណទាន អតិថិជន ដើម្បី លើកកម្ពស់ ការផ្តល់ ឥណទាន ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា និង ធនាគារ កណ្ដាល ថៃ គ្រោង ពង្រីក កិច្ចសហប្រតិបត្តិការ ចែករំលែក ព័ត៌មាន ឥណទាន អតិថិជន រវាង គ្នា ដើម្បី លើកកម្ពស់ ការផ្តល់ ឥណទាន ប្រកបដោយ ការទទួលខុសត្រូវ និង ប្រសិទ្ធភាព ខ្ពស់ ។
កិច្ចពិភាក្សា ក្នុង ជំនួប នេះ ផ្តោត សំខាន់ លើ កិច្ចការ លើកកម្ពស់ កិ ច្ចសហប្រតិបត្តិការ របស់ ប្រទេស ទាំង ពីរ នា ពេល កន្លងមក និង ការផ្លាស់ប្តូរ ទស្សន ពី គំនិត ផ្តួចផ្តើម ថ្មី ៗ ដើម្បី ពង្រីក កិច្ចសហប្រតិបត្តិការ ឱ្យ កាន់តែ រឹងមាំ ថែម ទៀត សំដៅ រួមចំណែក ដល់ ការរីកចម្រើន វិស័យ ធនាគារ និង សេដ្ឋកិច្ច របស់ ប្រទេស ទាំង ពីរ ។
លោកស្រី បណ្ឌិត ជា សិរី បាន ថ្លែង ឲ្យដឹង ថា ធនាគារ ជាតិ នៃ កម្ពុជា និង ធនាគារ កណ្តាល ថៃ បាន ពង្រឹង កិច្ចសហប្រតិបត្តិការ យ៉ាង ល្អ លើ ផ្នែក ជាច្រើន ដូចជា ការផ្លាស់ប្តូរ ទស្សនកិច្ច ចែករំលែក បទពិសោធន៍ លើ ការងារ ជំនាញ ការទទួល អាហារូបករណ៍ សម្រាប់ មន្ត្រី ធនាគារ ជាតិ នៃ កម្ពុជា ទៅ សិក្សា ថ្នាក់ ឧត្តម សិក្សា នៅ ប្រទេស ថៃ និង ជាពិសេស កិច្ចសហការ លើ ការតភ្ជាប់ ប្រព័ន្ធ ទូទាត់ ឆ្លង ដែន ។
លោកស្រី បណ្ឌិត បាន បញ្ជាក់ ថា ជាក់ស្តែង ប្រទេស ថៃ ជា ប្រទេស ដំបូង គេ ដែល ប្រទេស កម្ពុជា បាន តភ្ជាប់ ប្រព័ន្ធ ទូទាត់ សង ប្រាក់ និង ផ្ទេរ ប្រាក់ ឆ្លង ដែន ដែល កិច្ចសហការ នេះ បាន រួមចំណែក យ៉ាង សំខាន់ ដល់ ការគាំទ្រ ពាណិជ្ជកម្ម វិនិយោគ និង ទេសចរណ៍ ក្នុង ប្រទេស ទាំង ពីរ ព្រមទាំង លើកកម្ពស់ ការប្រើប្រាស់ រូបិយវត្ថុ ជាតិ ក្នុង ទីផ្សារ ស្រប តាម គោលដៅ របស់ សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន ។
លោកស្រី បណ្ឌិត បាន បន្ថែម ថា ធនាគារ កណ្តាល ទាំង ពីរ បាន និង កំពុង អភិវឌ្ឍ ប្រព័ន្ធ ផ្ទេរ ប្រាក់ សម្រាប់ ពលករ កម្ពុជា ដែល កំពុង ធ្វើការ នៅ ប្រទេស ថៃ ដើម្បីឱ្យ ការផ្ទេរ មកកាន់ ក្រុមគ្រួសារ នៅ កម្ពុជា ប្រកបដោយ សុវត្ថិភាព ឆាប់រហ័ស និង ចំណាយ ទាប ។
លោកស្រី ទេសាភិបាល ក៏ បាន លើកឡើង ពី គម្រោង ពង្រីក កិច្ចសហប្រតិបត្តិការ សម្រាប់ ការចែករំលែក ព័ត៌មាន ឥណទាន អតិថិជន រវាង ប្រទេស កម្ពុជា និង ថៃ ដើម្បី លើកកម្ពស់ ការផ្តល់ ឥណទាន ប្រកបដោយ ការទទួលខុសត្រូវ និង ប្រសិទ្ធភាព ខ្ពស់ ។ ស្រប ពេល វិស័យ ហិរញ្ញវត្ថុ ប្រទេស ទាំង ពីរ បន្ត អភិវឌ្ឍ យ៉ាង ឆាប់រហ័ស លោកស្រី ទេសាភិបាល មាន សុទិដ្ឋិនិយម ថា ធនាគារ កណ្តាល ប្រទេស ទាំង ពីរ នឹង បន្ត ពង្រីក កិច្ចសហប្រតិបត្តិការ កាន់តែ សម្បូរបែប ថែម ទៀត នា ពេល ខាងមុខ ។
លោក បាន បន្ដ ថា ការណ៍ នេះ មិន ត្រឹមតែ បាន ពង្រឹង ភាពរឹងមាំ នៃ ប្រព័ន្ធ ធនាគារ និង ហិរញ្ញវត្ថុ នៅ កម្ពុជា ប៉ុណ្ណោះ ទេ តែ ថែមទាំង រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការលើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ជាពិសេស ខាង ផ្នែក ហិរញ្ញវត្ថុ ។
