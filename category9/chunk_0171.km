( ភ្នំពេញ ) ៖ នា ថ្ងៃអាទិត្យ ទី ០៨ ខែតុលា ឆ្នាំ ២០២៣ លោក ហ៊ុន ម៉ានី រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សំណេះសំណាល សាកសួរ សុខទុក្ខ និវត្ត ជន នៃ មន្ទីរ សុខាភិបាល និង មន្ទីរ ផែនការ ដែល បាន រៀបចំឡើង នៅ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ស្ពឺ ។
ពិធី នេះ មាន ការចូលរួម ពី សមាជិក ព្រឹទ្ធសភា រដ្ឋសភា និង រាជ រដ្ឋាភិបាល ថ្នាក់ដឹកនាំ ក្រុមប្រឹក្សា គណៈ អភិបាល ខេត្ត មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត សប្បុរសជន ព្រមទាំង និវត្ត ជន ប្រមាណ ចំនួន ២៥០ នាក់ ។
នា ឱកាស នោះ លោក ហ៊ុន ម៉ានី បាន សម្តែង នូវ សេចក្តី សោមនស្ស រីករាយ ដែល បាន មក ចូលរួម ក្នុង កម្មវិធី ជួប សំណេះសំណាល និង សួរសុខទុក្ខ និវត្ត ជន ក្នុង វិស័យ សុខាភិបាល និង ផែនការ នា ពេលនេះ ។
ជាមួយគ្នា នេះ លោក បាន ផ្តាំផ្ញើរ ការសួរសុខទុក្ខសំណាក់ សម្តេច តេជោ ហ៊ុន សែន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ជូន ចំពោះ លោក អ៊ំ លោក ពូ អ្នក មីង ដែល បាន អញ្ជើញ ចូលរួម ពិធី ផងដែរ ។
លោក ហ៊ុន ម៉ានី បាន រំលឹក នូវ វីរភាព របស់ ថ្នាក់ដឹកនាំ ជំនាន់ មុន អតីត យុទ្ធជន ដែល បាន ធ្វើ ពលិកម្ម និង លះបង់ គ្រប់ បែបយ៉ាង ក្នុង បុព្វហេតុ រំដោះ ជាតិ មាតុភូមិ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង បាន នាំ កម្ពុជា ឆ្ពោះ ទៅកាន់ សុខ សន្តិភាព មាន ស្ថិរភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ដូច សព្វ ថ្ងៃ នេះ ។
លោក បាន គូសបញ្ជាក់ ថា ភាពជោគជ័យ នៃ ការដឹកនាំ ប្រទេស ពី បាត ដៃ ទទេ រ រហូតមកដល់ បច្ចុប្បន្ន គឺ កើត ចេញ ពី ឆន្ទៈ និង ការលះបង់ របស់ ថ្នាក់ដឹកនាំ ជំនាន់ មុន ។
ជាមួយគ្នា នេះ លោក បាន លើកឡើង ថា ក្នុង នាមជា អ្នកជំនាន់ ក្រោយ យើង ត្រូវ ចងចាំ ជានិច្ច នូវ គំរូវីរភាព ការលះបង់ ដែល មិន អាច កាត់ថ្លៃ បាន របស់ ថ្នាក់ដឹកនាំ ដែល បាន ខិតខំ ប្រឹងប្រែង បំពេញ ភារកិច្ច ជូន ជាតិ មាតុភូមិ ។
លោក ហ៊ុន ម៉ានី បាន ថ្លែងអំណរគុណ ជូន ចំពោះ និវត្ត ជន ទាំងអស់ ដែល បាន ផ្តល់ ឱកាស ឱ្យ ឯកឧត្តម និង ក្រុមការងារ បាន ជួប សំណេះសំណាល នា ឱកាស នេះ និង បាន ចូលរួម ថត រូប អនុស្សាវរីយ៍ ជាមួយគ្នា ក្រោម បរិយាកាស សប្បាយរី រាយ និង ស្និទស្នាល ជា ទីបំផុត ៕
ជាមួយគ្នា នេះ សម្តេច ធិបតី ក៏ បាន ចាត់តាំង ឲ្យ លោក មែ ស៊ី ថន តំណាង ខុទ្ទកាល័យ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី នាំយក សារ លិខិត រំលែក ទុក្ខ ពី សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី និង សារលិខិត ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ទៅ ប្រគល់ ជូន គ្រសារ សព ដោយ ផ្ទាល់ ដើម្បី ចូលរួម រំលែក ទុក្ខ ជាមួយ ក្រុមគ្រួសារ សព លោក ចាន់ ឧត្តម ផងដែរ ។
នៅក្នុង សារលិខិត របស់ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី និង សម្តេច តេជោ ហ៊ុន សែន គឺ បាន សម្តែង នូវ សេចក្តីក្តុកក្តួល រំជួល ចិត្ត ឥត ឧបមា ដោយ បាន ទទួល ដំណឹង ថា លោក ចាន់ ឧត្តម ដែល ត្រូវ ជា កូនប្រុស បង្កើត របស់ ពួកគាត់ និង ជា និស្សិត នៃ សាកលវិទ្យាល័យ ភូមិន្ទ កសិកម្ម អាយុ ២៤ ឆ្នាំ បាន ទទួលមរណភាព ដោយ ហេតុការណ៍ ប្រយុទ្ធ គ្នា រវាង កងទ័ព អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស់ នៅ ថ្ងៃសៅរ៍ ទី៧ ខែតុលា ឆ្នាំ ២០២៣ ខណៈ កំពុង ស្នាក់ នៅ និង បន្ត ការសិក្សា នៅ ប្រទេស អ៊ីស្រាអែល ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រម ប្រកាស ឱ្យ ប្រើប្រាស់ « ច្បាប់ ស្តីពី ការបង្កើត រដ្ឋលេខាធិការដ្ឋាន កិច្ចការ ព្រំដែន » (Video inside) ( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ចេញ ព្រះរាជ ក្រម មួយ ប្រកាស ឱ្យ ប្រើប្រាស់ « ច្បាប់ ស្តីពី ការបង្កើត រដ្ឋលេខាធិការដ្ឋាន កិច្ចការ ព្រំដែន » ។
ច្បាប់ ថ្មី នេះ មាន ចំនួន សរុប ៨មាត្រា ដោយ ក្នុង នោះ មាត្រា ២ បាន បញ្ជាក់ ថា រដ្ឋលេខាធិការដ្ឋាន កិច្ចការ ព្រំដែន មាន សមត្ថកិច្ច ដឹកនាំ និង គ្រប់គ្រង កិច្ចការ ព្រំដែន នៃ ព្រះរាជាណាចក្រ កម្ពុជា ទាំង ព្រំដែន គោក និង ព្រំដែន សមុទ្រ ។
ខាងក្រោម នេះ ជា ព្រះរាជ ក្រម របស់ ព្រះមហាក្ស ត្រ៖
អភិបាល ខេត្ត បាត់ដំបង ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ ជូន ដល់ ក្រុមគ្រួសារ រងគ្រោះ ដោយសារ ទឹក ជំនន់ ក្នុង ស្រុក ឯក ភ្នំ
( បាត់ដំបង ) ៖ លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង នា ព្រឹ ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ ជូន ដល់ ក្រុមគ្រួសារ រងគ្រោះ ដោយសារ ទឹក
ជំនន់ ចំនួន ៣០០ គ្រួសារ មកពី ភូមិ ចំនួន ៥ គឺ ភូមិ រហាល សួង ចំនួន ១០៦ គ្រួសារ ភូមិ ដូង មារ ចំនួន ៣៥ គ្រួសារ ភូមិ រាជ ដូន កែវ ចំនួន ៥២ គ្រួសារ ភូមិ អន្សង សកចំនួន ៦០ គ្រួសារ ភូមិ ព្រែក ត្រប់ ចំនួន ៤៧ គ្រួសារ នៃ ឃុំ ព្រែក នរិន្ទ ស្រុក ឯក ភ្នំ ខេត្ត បាត់ដំបង ។
ក្នុង ឱកាស នោះ ដែរ លោក សុខ លូ បាន ថ្លែង នូវ ការ សួរសុខទុក្ខ និង មាន ការសោកស្ដាយ ដល់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ និង ធ្វើឲ្យ មាន ការខូចខាត ផល ដំណាំ របស់ ខ្លួន ដោយសារ ជំនន់ ទឹកភ្លៀង នេះ ផងដែរ ។
( ត្បូងឃ្មុំ ) ៖ នា ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២៣ នេះ លោក ឧត្តមសេនីយ៍ ត្រី រ័ត្ន ចាន់ ណា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ត្បូងឃ្មុំ បាន ដឹកនាំ លោក មេបញ្ជាការ រង នាយ សេនាធិការ រង ប្រធាន មន្ទីរ អនុប្រធាន មន្ទីរ នាយ - នាយ រង ការិយាល័យ នៃ ទី បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត អញ្ជើញ ចុះ សួរសុខទុក្ខ នាំយក ថវិកា និង សម្ភារៈ ទៅ ចែក ផ្តល់ ជូន ដោយ ផ្ទាល់ ដៃ ដល់ យោធិន នៃ កងរាជអាវុធហត្ថ ខេត្ត ដែល មាន ជំងឺ កំពុង សម្រាក ព្យាបាល នៅ ផ្ទះ ចំនួន ០៤ រូប ក្នុង ឱកាស រដូវ បុណ្យ កាន់ បិណ្ឌ - ភ្ជុំ បិណ្ឌ នេះ ។
អភិបាល ខេត្ត ពោធិ៍សាត់ នាំយក ស្បៀង សង្គ្រោះ បន្ទាន់ ទៅ ចែកជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ជំនន់ ទឹកភ្លៀង ចំនួន ១. ០៩៣ គ្រួសារ ក្នុង ស្រុក កណ្តៀង
នា ឱកាស នោះ លោក ខូយ រីដា បាន ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល តែងតែ នឹក រឭក និង គិតគូរ យកចិត្តទុកដាក់ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេសៈ ជាពិសេស សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ។
លោក បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្ដេច បវរធិបតី ហ៊ុន ម៉ាណែត ដែល មាន លោក កែវ រតនៈ រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន ខេត្ត ពោធិ៍សាត់ ព្រមទាំង អាជ្ញាធរដែនដី គ្រប់ ជាន់ ថ្នាក់ ក្នុង កំឡុង ពេល ដែល បងប្អូន កំពុងតែ ជួប ការលំបាក នា ពេល កន្លងមក នេះ ថ្នាក់ដឹកនាំ ទាំងអស់ នៅតែ ត្រៀម ចាំ អន្តរាគមន៍ ជួយ ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ជានិច្ច ។
លោក អភិបាល ខេត្ត បាន ក្រើនរំឭក បន្ថែម ដល់ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម ថែរក្សា សុខភាព ឱ្យ បាន ល្អ តាមរយៈ ការហូប ស្អាត ផឹក ស្អាត រស់ នៅ ស្អាត និង ប្រកបដោយ អនាម័យ ខ្ពស់ ។ ម្យ៉ាងទៀត ត្រូវ ចូលរួម កាត់បន្ថយ ការប្រើប្រាស់ ថង់ ប្លាស្ទិក ឲ្យបាន ទាំងអស់ គ្នា ។
លោក ខូយ រីដា ក៏ បាន ជំរុញ ឲ្យ ថ្នាក់ដឹកនាំ មន្ទីរ ជំនាញ ត្រូវ ពន្លឿន ការជួសជុល ហេដ្ឋារចនាសម្ព័ន្ធ ដែល ទទួល ការរង ខូចខាត ដោយសារ ជំនន់ ទឹកភ្លៀង ព្រមទាំង ផ្តល់ ពូជ ស្រូវ សម្រាប់ ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ យើង មាន លទ្ធភាព បង្កបង្កើន ផល ស្រូវ ស្តារ ឡើងវិញ ផងដែរ ។
គួរ បញ្ជាក់ ថា អំណោយ ជា ស្បៀង សង្គ្រោះ បន្ទាន់ ដែល ត្រូវ ចែកជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ជំនន់ ទឹកភ្លៀង ទាំង១. ០៩៣ គ្រួសារ ដោយ ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម . មី១ កេស . ត្រីខ ១យួរ . ទឹកត្រី ១យួរ . ទឹក ស៊ីអ៊ីវ១យួរ និង ទឹក បរិសុទ្ធ ១កេស ៕
កម្ពុជា សម្ដែង ការសោកស្ដាយ ចំពោះ ការផ្ទុះឡើង ការប្រយុទ្ធ គ្នា នៅ ប្រទេស អ៉ី ស្រាអែល និង អំពាវនាវ ឱ្យ សហគមន៍ អន្តរជាតិ ស្វះស្វែងរក កិច្ចចរចា (Video inside) ( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រសួង ការបរ ទេ បាន សម្ដែង នូវ សេចក្តីសោកស្ដាយ ជា ពន់ពេក ចំពោះ ការផ្ទុះឡើង នូវ ការវាយប្រយុទ្ធ គ្នា នៅ ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ នៅ ប្រទេស អ៉ី ស្រាអែល ។
ក្នុង សេចក្តីថ្លែងការណ៍ នៅ ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២៣ នេះ ក្រសួង ការបរទេស កម្ពុជា បាន ទទូច ឱ្យ សហគមន៍ អន្តរជាតិ បង្កើន កិច្ច ខិតខំ ប្រឹងប្រែង ទ្វេ ដង ដើម្បី សម្របសម្រួល កិច្ចសន្ទនា និង កិច្ចចរចារ ប្រកបដោយ អត្ថន័យ ឆ្ពោះ ទៅរក សន្តិភាព ស្ថិតស្ថេរ និង ប្រកបដោយ យុត្តិធម៌ ។ ភាគី ទាំងអស់ ចាំបាច់ ត្រូវ ចូលរួម ក្នុង កិច្ចសន្ទនា ស្ថាបនា សំដៅ ដោះស្រាយ ឬ សគល់ នៃ ជម្លោះ និង ស្វែងរក ដំណោះស្រាយ ដែល គ្រប់ ភាគី ទាំងអស់ អាច ទទួលយក បាន ។
ក្នុង សេចក្តីថ្លែងការណ៍ នេះ ក្រសួង ការបរទេស បាន សង្កត់ធ្ងន់ លើ សារៈសំខាន់ នៃ ការផ្តោត អាទិភាព ចម្បង លើ ការស្វែងរក សន្តិភាព យុត្តិធម៌ និង សន្តិសុខ សម្រាប់ ប្រជាជន ទាំងអស់ នៅក្នុង តំបន់ ។ គ្រប់ ភាគី ពាក់ព័ន្ធ ចាំបាច់ ត្រូវ ចូលរួម ធ្វើការ ជាមួយគ្នា ដើម្បី ស្វែងរក ដំណោះស្រាយ សន្តិវិធី ដែល ធានា បាន នូវ សុខ មាលភាព និង សុវត្ថិភាព សម្រាប់ គ្រប់ គ្នា ។
ក្រសួង ការបរទេស បាន គូស រំលេច ដែរ ថា ការកើនឡើង នូវ អំពើហិង្សា ដ៏ គួរឱ្យ រន្ធត់ នេះ បាន បណ្តាលឱ្យ ប្រជាជន ស្លូតត្រង់ រាប់ រយ នាក់ បាត់បង់ជីវិត រួមទាំង និស្សិត កម្ពុជា មួយ រូប នៅក្នុង ប្រទេស អ៊ីស្រាអែល ។ ក្រសួង ការ បរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន ចូលរួម រំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ចំពោះ គ្រួសារ នៃ សព របស់ ភាគី ទាំង ពីរ ដែល បាន បាត់បង់ មនុស្ស ជា ទីស្រឡាញ់ ។
ដោយ ចាត់ទុក សុវត្ថិភាព របស់ ជន ស៊ីវិល ទាំងអស់ រួមទាំង ប្រជាពលរដ្ឋ កម្ពុជា ជា អាទិភាព ចម្បង កម្ពុជា អំពាវនាវ ឱ្យ គ្រប់ ភាគី ទាំងអស់ អនុវត្ត ការអត់ធ្មត់ ឱ្យ បាន ខ្ពស់ បំផុត និង ស្វែងរក មធ្យោបាយ នានា ដើម្បី កាត់បន្ថយ អំពើហិង្សា និង ឆ្ពោះ ទៅរក បទ ឈប់ បាញ់ ដោយ ផ្ដោត អាទិភាព លើ ការការពារ អាយុជីវិត ជន ស៊ីវិល និង ការគោរព ខ្ជាប់ខ្ជួន នូវ ច្បាប់ មនុស្សធម៌ អន្តរជាតិ ។ កម្ពុជា សូម ថ្កោល ទោស គ្រប់ ទម្រង់ នៃ អំពើហិង្សា និង សកម្មភាព ភេរវកម្ម ៕
នគរបាល ក្រុង ស្វាយរៀង ឃាត់ខ្លួន ជនសង្ស័យ ៤នាក់ ក្នុង ចំណោម ៥នាក់ ពាក់ព័ន្ធ កាប់ ប្រហារ យុវជន ម្នាក់ បណ្ដាលឲ្យ រងរបួស ធ្ងន់
( ស្វាយរៀង ) ៖ កម្លាំង នគរបាល ក្រុង ស្វាយរៀង បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៤នាក់ ក្នុង ចំណោម ៥នាក់ ពាក់ព័ន្ធ នឹង ករណី ហិង្សា កាប់ ប្រហារ យុវជន ម្នាក់ បណ្ដាលឲ្យ រងរបួស ធ្ងន់ ។
លោក វីរៈ សេនីយ៍ ឯក កែន រិទ្ធី បាន បញ្ជាក់ ថា ក្រោយពី ទទួលបាន ពាក្យបណ្តឹង នេះ ភ្លាម កម្លាំង ជំនាញ នៃ អធិការដ្ឋាន នគរបាល ក្រុង ស្វាយរៀង សហការ ជាមួយ កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល សង្កាត់ ស្វាយរៀង ចុះ ទៅ ស្រាវជ្រាវ ដល់ កន្លែង កើត ហេតុ និង ស្រាវជ្រាវ បន្ត រហូតដល់ ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ ទើប សមត្ថកិច្ច អាច កំណត់ មុខ សញ្ញា សង្ស័យ និង ឃាត់ខ្លួន ជនសង្ស័យ បាន ចំនួន ៤នាក់ បញ្ជូន ទៅ ការិយាល័យ ជំនាញ ខេត្ត ចាត់ការ តាម ច្បាប់ ។
លោក លោក វរសេនីយ៍ ឯក បាន បញ្ជាក់ ថា ក្រោម ការដឹកនាំ របស់ គណៈ បញ្ជាការ ឯកភាព ខេត្ត និង មាន ការបញ្ជា ផ្ទាល់ ពី លោក ស្នងការ នគរបាល ខេត្ត ស្វាយរៀង កម្លាំង អធិការដ្ឋាន នគរបាល ក្រុង ស្វាយរៀង តែងតែ ចុះ ប្រតិបត្តិការ បង្ក្រាប បទល្មើស ផ្សេង ៗ នៅ មូលដ្ឋាន បានជា បន្តបន្ទាប់ ដូចជា ករណី ក្មេង ទំនើង ដែល ដេញ កាប់ ប្រហារ គ្នា នេះ ផងដែរ ៕
ថ្នាក់ដឹកនាំ ខេត្ត កំពង់ចាម ព្រមទាំង មន្ត្រីរាជការ ក្រោម ឱវាទ កាន់ បិណ្ឌ វេន ទី៩ នៅ វត្ត ចំនួន ២ ក្នុង ស្រុក កំពង់សៀម និង ស្រុក ស្ទឹងត្រង់
( កំពង់ចាម ) ៖ នៅ ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២៣ ត្រូវ និង ថ្ងៃ បិណ្ឌ ៩នេះ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត និង លោកស្រី ញូង ចរិយា ប្រធាន កិត្តិយស សាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ខេត្ត កំពង់ចាម រួមទាំង សមាជិក សមាជិការ និង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ជាច្រើន រូប បាន ចូលរួម សូត្រ មន្តកាន់ បិណ្ឌ ទី៩ នៅ វត្ត ហាន់ ជ័យ ក្នុង ស្រុក កំពង់សៀម និង វត្ត អន្លង់ សំឡី នៅក្នុង ស្រុក ស្ទឹងត្រង់ ដើម្បី ឧទ្ទិស មគ្គផល កុសល បុណ្យ ដល់ អ្នកមាន គុណ ទាំងឡាយ ដែល បាន ចែក ឋាន ទៅ ហើយ នោះ ។
បើ តាម លោក តា អាចារ្យ បាន លើកឡើង ថា ការមក ចូលរួម កាន់ បិណ្ឌ នេះ គឺ ដើម្បី បង្អោន ចិត្ត គោរព ដល់ គុណ ព្រះពុទ្ធ ព្រះធម៌ ព្រះសង្ឃ ដើម្បី ឧទ្ទិស មគ្គផល កុសល បុណ្យ ដល់ ជីដូន ជីតា ឪពុក ម្តាយ បងប្អូន និង ញាតិ សន្តាន ទាំងឡាយ ដែល បាន ចែក ឋាន ទៅ ហើយ និង ដើម្បីឲ្យបាន សេចក្តីសុខ ចម្រើន សិរី សួស្តី ដែល កើត ពី ផល ទាន របស់ ខ្លួន ផង ។
ពិធី បុណ្យ នេះ ដែរ ក៏ ដើម្បីឲ្យ ពុទ្ធ បរិស័ទ បាន ជួបជុំគ្នា ទទួល នូវ ពាក្យ អប់រំ ទូន្មាន របស់ ព្រះពុទ្ធ ដើម្បីឲ្យ ស្គាល់ បាប បុណ្យ គុណ ទោស និង ខិតខំ សាង អំពើ ល្អ នៅក្នុង ដំណើរ ចិញ្ចឹម ជីវិត រស់ នៅ ប្រចាំ ថ្ងៃ ។
លោក អាចារ្យ ឲ្យដឹង ទៀត ថា ពិធីកាន់ បិណ្ឌ ភ្ជុំ បិណ្ឌ នេះ ជាពិធី មួយ សំខាន់ បំផុត នៅក្នុង ព្រះពុទ្ធ សាសនា តាំងពី បុរម បុរាណ មក ដើម្បី ផ្តល់ ឱកាស ឲ្យ កូន ចៅ ដែល នៅរស់ អាច ឧទ្ទិស មគ្គផល កុសល បុណ្យ ជូន ដល់ បុព្វការី ជន ដែល បាន ចែក ឋាន ទៅកាន់ លោក ខាងមុខ នឹង ដើម្បីឲ្យបាន សេចក្តីសុខ ចម្រើន សិរី សួស្តី ដែល កើត ពី ផល ទាន របស់ ខ្លួន ផង ពោលគឺ ជឿ លើកម្មផល បុណ្យ និង បាប ជាដើម ។
( កណ្ដាល ) ៖ ដោយ អនុវត្ត តាម ការចង្អុល ដឹកនាំ ពី លោក ឈឿន សុចិត្ត ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន សង្កាត់ ដើម មៀន ក្រុមការងារ ចុះ មូលដ្ឋាន ភូមិ ដើម គរ . លោក ឡាក់ ម៉េង ធី នៅ ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន នាំយក អំណោយ របស់ លោក ប្រធាន ក្រុមការងារ ចែកជូន ដល់ ប្រជាពលរដ្ឋ មាន ពិការ ភាពក្រីក្រ ម្នាក់ និង ស្ត្រី ទើប សម្រាល បុត្រ មួយ គ្រួសារ ។
ការចុះ ជួប សំណេះសំណាល នេះ ក៏ មាន ការចូលរួម ពីសំណាក់ ក្រុមការងារ ចុះ មូលដ្ឋាន ភូមិ ដើម គរ និង ក្រុមការងារ ភូមិ ផងដែរ ។
នា ឱកាស នោះ ដែរ លោក ឡាក់ ម៉េង ធី បាន ពាំនាំ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ លោក ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន សង្កាត់ ដើម មៀន ខណៈ ដែល ប្រធាន ក្រុមការងារ តែងតែ គិតគូរ យកចិត្តទុកដាក់ ដល់ ប្រជាពលរដ្ឋ នៅ សង្កាត់ គ្រប់ ៗ គ្នា ។
ក្នុង ពិធី បុណ្យ កាន់ បិណ្ឌ ប្រកបដោយ ក្តី សោមនស្ស រីករាយ នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ កូនប្រុស កូនស្រី ចៅ ប្រុស ចៅ ស្រី សាច់ញាតិ និង មន្ត្រីរាជការ ជាច្រើន រូប ផ្សេង ទៀត ផងដែរ ។
ជា កិច្ច ចាប់ផ្តើម លោក អាចារ្យ បាន ដឹកនាំ ពិធី តាម បែប ពុទ្ធសាសនា របស់ ខ្មែរ ដោយ ការន មស្ការ ព្រះរតនត្រ័យ វេបបាយ បិត្ត បូរ សមាទាន សីល វេរ ចង្ហាន់ រាប់ បាត្រ និង ពូន ភ្នំ ខ្សាច់ ជាដើម ។
នាយក រដ្ឋមន្រ្តី ថៃ លោក សេដ្ឋា ថា វីស៉ីន បាន បង្ហោះ សារ លើ បណ្តាញ សង្គម ឱ្យដឹង ថា រូប លោក ទទួលបាន របាយការណ៍ ពី ឯក អគ្គ រាជ ទូត ថៃ ប្រចាំ នៅ ទីក្រុង តែ ល អាវីវ នៃ ប្រទេស អ៉ី ស្រាអែល ថា ពលរដ្ឋ ថៃ ចំនួន ២នាក់ បាន ស្លាប់ ដោយសារ អំពើហិង្សា រវាង អ៉ី ស្រាអែល និង ក្រុម Hamas ដែល បាន ផ្ទុះឡើង ភ្លាម ៗ កាលពី ថ្ងៃសៅរ៍ ចុង សប្តាហ៍ នេះ ។ លោក សេដ្ឋា មិន បាន ចែករំលែក ខ្លឹមសារ លម្អិត អ្វី ទៀត ឡើយ ប៉ុន្តែ លោក បាន បន្ថែម ថា ខាង ក្រសួង ការបរទេស ថៃ កំពុង ធ្វើការ ដើម្បី ជម្លៀស ជនជាតិ ថៃ ចេញ ពី អ៉ី ស្រាអែល ។
សម្រាប់ អ្នក ដែល មាន បំណង ចង់ ប្រើប្រាស់ រថយន្ត អគ្គិសនី កុំ ភ្លេច តាមដាន នូវ ម៉ូដែល ថ្មី ដែល BYD នឹង នាំមក បង្ហាញ ខ្លួន ឆាប់ ៗ នេះ ក្នុង ប្រទេស កម្ពុជា ក្រោយ ដំណើរទស្សនកិច្ច នេះ បាន បញ្ចប់ ។ តើ រថយន្ត អគ្គិសនី ស៊េរី ថ្មី របស់ BYD នឹង នាំមក នូវ បច្ចេកវិទ្យា អ្វី ខ្លះ ? សូម តាមដាន ព័ត៌មាន របស់ Fresh News៕ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចូលរួម រំលែក ទុក្ខ ជាមួយ ក្រុមគ្រួសារ និស្សិត ចាន់ ឧត្តម ដែល ទទួលមរណភាព ក្នុង ហេតុការណ៍ វាយប្រហារ នៅ ប្រទេស អ៉ី ស្រាអែល
( ភ្នំពេញ ) ៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ ជាមួយ ក្រុមគ្រួសារ និស្សិត ឈ្មោះ ចាន់ ឧត្តម ជា និស្សិត ឆ្នាំ ទី៣ មហាវិទ្យាល័យ វេជ្ជសាស្រ្ត សត្វ នៃ សាកលវិទ្យាល័យ ភូមិន្ទ កសិកម្ម ដែល បាន ទទួលមរណភាព ក្នុង ពេល មាន ការវាយប្រហារ រវាង កងទ័ព អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស់ នៅក្នុង តំបន់ ហ្កាហ្សា ដែល បាន ផ្ទុះឡើង ចាប់ពី ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ ។
គួរ ជម្រាប ថា រាជ រដ្ឋាភិបាល បាន ចាត់ វិធានការទំនាក់ទំនងជា ប្រចាំ ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ដើម្បី ធានា ដល់ សុវត្ថិភាព របស់ ពលរដ្ឋ ខ្មែរ ជា លទ្ធផល ពេញ មួយ យប់ មិញ នេះ កម្ពុជា បាន ទំនាក់ទំនង ជាមួយ ពលរដ្ឋ ខ្មែរ ភាគ ច្រើន នៅក្នុង ប្រទេស អ៉ី ស្រាអែល និង កំណត់ ទីតាំង របស់ ពួកគាត់ ហើយ ក្នុង នោះ យើង ក៏ បាន ខិតខំ ជួយសង្គ្រោះ និស្សតិ៣រូប ក្នុង ចំណោម ៤រូប ( ដែល ក្នុង នោះ ម្នាក់ បាន ស្លាប់ ) ចេញ ពី តំបន់ ក្រហម មក ស្នាក់ នៅ ជាមួយ កុងស៊ុល កិត្តិយស របស់ កម្ពុជា ក្នុង ប្រទេស អ៉ី ស្រាអែល ៕
ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោក ឧកញ៉ា លឹម ហេង អញ្ជើញ កាន់ បិណ្ឌ វេន ទី៩ នៅ វត្ត ជយ ទឹក ជុំ ហៅ វត្ត អន្លង់ វែង ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ
( ឧត្តរមានជ័យ )៖ លោក កិត្តិសង្គហ បណ្ឌិត គន់ គីម ទេសរដ្ឋមន្ត្រី ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ខេត្ត ឧត្តរមានជ័យ និង លោក ឧកញ៉ា លឹម ហេង ព្រមទាំង មន្ត្រីរាជការ ប្រជាពុទ្ធ បរិស័ទ នា ព្រឹក ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ កាន់ បិណ្ឌ វេន ទី៩ នៅ វត្ត ជយ ទឹក ជុំ ហៅ វត្ត អន្លង់ វែង ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ ។
ក្នុង ពិធី កាន់ បិណ្ឌ វេន ទី៩ នេះ កិត្តិសង្គហ បណ្ឌិត បាន នាំយក នូវ ទេយ្យ វត្ថុ និង បច្ច័យ មួយចំនួន ដើម្បី ប្រគេន ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា ទុក កសាង សមិទ្ធផល នានា ក្នុង វត្ត វេរ ទេយ្យ វត្ថុ ដល់ ព្រះសង្ឃ ដើម្បី បង្សុកូល ដើម្បី ឧទ្ទិស ដល់ វិញ្ញាណក្ខន្ធ បងប្អូន ជីដូន ជីតា និង ញាតិកា ទាំង ៧ សន្តាន ដែល ចែក ឋាន ទៅបរលោក ។
ក្នុង ឱកាស នៃ ពិធី កាន់ បិណ្ឌ នេះ លោក កិត្តិសង្គហ បណ្ឌិត ក៏ បាន ឆ្លៀត សំណេះសំណាល ជាមួយ លោកយាយ លោក តា ដោយ នាំយក នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ និង ការនឹករលឹក របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ព្រមទាំង សម្តេច មហា បវរធិបតី នាយក រដ្ឋមន្ត្រី កម្ពុជា ចំពោះ ព្រះសង្ឃ និង លោកយាយ លោក តា នៅ ទូទាំង ស្រុក អន្លង់ វែង ។
កិត្តិសង្គហ បណ្ឌិត បាន ថ្លែង ទៅកាន់ លោកយាយ លោក តា ដែល បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី នោះ ថា ប្រសិនបើ គ្មាន ការ ដាក់ចេញ និង អនុវត្តន៍ ដោយ ជោគជ័យ នូវ នយោបាយ ឈ្នះ - ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន ទេ នោះ ច្បាស់ ណាស់ ថា ពលរដ្ឋ ស្រុក អន្លង់ វែង មិន អាច គោរព ប្រណិប័តន៍ ព្រះពុទ្ធ សាសនា និង ជំនឿ សាសនា ដទៃ ទៀត បាន ឡើយ ។
លោក កិត្តិសង្គហ បណ្ឌិត ក៏ បាន ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ ស្រុក អន្លង់ វែង ដែល តែងតែ ជឿ ទុកចិត្ត និង គាំទ្រ ចំពោះ ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។ ឯកឧត្តម កិត្តិសង្គហ បណ្ឌិត ក៏ បាន សុំ ឱ្យ ប្រជាពលរដ្ឋ ជឿ ទុកចិត្ត ចំពោះ ការដឹកនាំ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត គឺ សម្តេច នឹង ដឹកនាំ កម្ពុជា ពុះពារ ជម្នះ គ្រប់ ឧបសគ្គ ទាំងអស់ ដើម្បី ឆ្ពោះ ទៅរក វឌ្ឍនភាព និង ការអភិវឌ្ឍ ៕ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រម ប្រកាស ឱ្យ ប្រើ ច្បាប់ ស្ដីពី ការបង្កើត ក្រសួង អធិការកិច្ច
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រម ប្រកាស ឱ្យ ប្រើ ច្បាប់ ស្ដីពី ការបង្កើត « ក្រសួង អធិការកិច្ច » ។
ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០០៦៖ ក្រុមហា ម៉ាស់ (Hamas) ឈ្នះ បាន អាសនៈ ក្នុង សំឡេង ភាគ ច្រើន នៅក្នុង ការបោះឆ្នោត សភា ប៉ាឡេស្ទីន ។ អ៉ី ស្រាអែល និង សហរដ្ឋ អាមេរិក ក៏ បាន កាត់ផ្តាច់ ជំនួយ សម្រាប់ ប៉ាឡេស្ទីន ដោយសារតែ ក្រុម Hamas មិន ព្រម ប្រកាស បោះបង់ ចោល ការប្រើ អំពើហិង្សា និង ទទួលស្គាល់ អ៉ី ស្រាអែល ។
ខែមីនា ឆ្នាំ ២០១៨៖ ការធ្វើ បាតុកម្ម របស់ ប៉ាឡេស្ទីន បាន ចាប់ផ្តើម នៅ តាម របង ព្រំដែន តំបន់ Gaza ជាប់ អ៉ី ស្រាអែល ។ កងទ័ព អ៉ី ស្រាអែល បាន សម្រេច បើក បាញ់ប្រហារ ដើម្បី រារាំង ក្រុម បាតុករ ។ ជនជាតិ ប៉ាឡេ ស្ទីន ជាង ១៧០ នាក់ ត្រូវ គេ រាយការណ៍ ថា បាន បាត់បង់ជីវិត អំលុង ចលនា បាតុកម្ម ដែល មាន រយៈពេល ប៉ុន្មាន ខែ ហើយ វា ក៏ បាន បង្កឱ្យ មាន ការប្រយុទ្ធ គ្នា រវាង កងកម្លាំង អ៉ី ស្រាអែល និង Hamas ផងដែរ ។
ខែសីហា ឆ្នាំ ២០២២៖ មនុស្ស យ៉ាងតិច ៤៤ នាក់ ក្នុង នោះ មាន កុមារ ១៥ នាក់ បាន ស្លាប់ ក្នុង អំពើហិង្សា រយៈពេល ៣ ថ្ងៃ ដែល បាន ចាប់ផ្តើម នៅពេល ការវាយប្រហារ តាម ផ្លូវ អាកាស បាន ត្រូវ ចំមេ បញ្ជាការ ម្នាក់ នៃ ក្រុម Islamic Jihad ដែល ជា ក្រុម សកម្ម ប្រយុទ្ធ ប៉ាឡេ ស្ទីន មួយ ។ អ៉ី ស្រាអែល បាន និយាយ ថា ការវាយប្រហារ តាម ផ្លូវ អាកាស នោះ គឺជា ប្រតិបត្តិការ វាយ ស្កាត់ ទុក ជាមុន ប្រឆាំង នឹង ផែនការវាយប្រហារ របស់ ក្រុម សកម្ម ប្រយុទ្ធ ដែល គាំទ្រ ដោយ អ៉ីរ៉ង់ មួយ នេះ ។
ក្នុង ពិធី បុណ្យ កាន់ បិណ្ឌ ប្រកបដោយ ក្តី សោមនស្ស រីករាយ នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ កូនប្រុស កូនស្រី ចៅ ប្រុស ចៅ ស្រី សាច់ញាតិ និង មន្ត្រីរាជការ ជាច្រើន រូប ផ្សេង ទៀត ។
សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត គឺជា អ្នក គោរព ប្រណិប័តន៍ យ៉ាង ខ្ជួន នូវ ពិធី បុណ្យ ទាំងឡាយ ដែល ជា ទំនៀមទម្លាប់ ប្រពៃណី របស់ ខ្មែរ ហើយក៏ ជា អ្នក ទ្រទ្រង់ ពិធី បុណ្យ ទាំងឡាយ របស់ ជាតិ ឱ្យ ខ្ពស់ ត្រដែត ឡើង ផងដែរ ។
ជារៀងរាល់ ឆ្នាំ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន តែងតែ ដឹកនាំ កូន ចៅ សាច់ញាតិ និង មន្ត្រីរាជការ ខ្មែរ ប្រារព្ធ ពិធី បុណ្យ កាន់ បិណ្ឌ និង បុណ្យ ភ្ជុំ បិណ្ឌ នៅ តាម វត្ត អារាម នានា យ៉ាង ខ្ជាប់ខ្ជួន ។
ជា កិច្ច ចាប់ផ្តើម នៃ ពិធី នា ព្រឹក មិញ នេះ លោក អាចារ្យ បាន ដឹកនាំ ពិធី តាម បែប ពុទ្ធសាសនា របស់ ខ្មែរ ដោយ ការន មស្ការ ព្រះរតនត្រ័យ វេបបាយ បិត្ត បូរ សមាទាន សីល វេរ ចង្ហាន់ រាប់ បាត្រ និង ពូន ភ្នំ ខ្សាច់ ជាដើម ។
ក្រៅតែ ពី ឧទ្ទិស កុសល ផល បុណ្យ ជូន ទៅដល់ ដួង វិញ្ញាណក្ខន្ធ ដល់ មាតាបិតា ប្អូន ស្រី និង បុព្វការី ជន របស់ ខ្លួន ហើយ នោះ សម្ដេច តេជោ និង សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ក៏ បាន ឧទ្ទិស កុសល ផល បុណ្យ ជូន ទៅដល់ ដួង វិញ្ញាណក្ខន្ធ បុព្វបុរស អ្នកស្នេហាជាតិ ក៏ ដូចជា ប្រជាពលរដ្ឋ ខ្មែរ ដែល បាន ពលី ជីវិត ក្នុង បុព្វហេតុ ជាតិ និង បាត់បង់ជីវិត ក្នុង ពេល ប្រទេសជាតិ ជួប វិបត្តិ នៃ ភ្លើង សង្គ្រាម ផងដែរ ។
( ភ្នំពេញ ) ៖ អ្នកជំនួញ ក្នុង វិស័យ កសិកម្ម ល្បី ឈ្មោះ មួយ រូប គឺ អ្នក ឧកញ៉ា ហ៊ុន ឡាក់ បាន លើកទឹកចិត្ត ដល់ កសិករ ដែល ធ្លាប់ តែ ដាំ បន្លែ នៅ តាម ទី វាល ផ្លាស់ប្តូរ មក ដាំដុះ នៅក្នុង ផ្ទះ សំណាញ់ វិញ ដើម្បី ទទួលបាន ទិន្នផល ខ្ពស់ ប្រមូល ផល បាន ច្រើន ដង អាច ផ្គត់ផ្គង់ ទីផ្សារ បាន ច្រើន រដូវ ហើយ ពិសេស នោះ ថែមទាំង មាន តម្លៃ ថ្លៃ ជាង បន្លែ ដែល ដាំ នៅ តាម ទី វាល ទៀតផង ។
លោក សុខ សុថា ស្ថាបនិក និង ជា នាយក ប្រតិបត្តិ សមាគម សហព័ន្ធ កសិករ កម្ពុជា នៃ អ្នកផលិត កសិកម្ម និង ជា ក្រុមប្រឹក្សាភិបាល បណ្តាញ កសិអេកូឡូស៊ី ដែល បាន បណ្តុះបណ្តាល កសិករ ឱ្យ ដាំដុះ បន្លែ នៅក្នុង ផ្ទះ សំណាញ់ បាន ពន្យល់ ថា ការដាំ បន្លែ នៅក្នុង ផ្ទះ សំណាញ់ មាន អំណោយផល ជាង ការដាំដុះ បន្លែ នៅ តាម ទី វាល ព្រោះ ទទួលបាន ទិន្នផល ច្រើន ជាង និង កាត់បន្ថយ ផល រំខាន បាន ច្រើន ដូចជា សត្វ ល្អិត ឬ ការប្រែប្រួល អាកាសធាតុ ។
លោក បន្ត ថា ជាទូទៅ ការដាំ បន្លែ នៅក្នុង ផ្ទះ សំណាញ់ ប្រសិនបើ មាន ទឹក ផ្គត់ផ្គង់ គ្រប់គ្រាន់ គឺ អាច ដាំដុះ បាន ពេញ មួយ ឆ្នាំ ខុសពី ការដាំដុះ នៅ ទីវាល គឺ អាច ដាំ ល្អ បាន តែ នៅ រដូវ ប្រាំង ចាប់ពី ខែវិច្ឆិកា ដល់ ខែមេសា ប៉ុណ្ណោះ ហើយ បើ ចូល មកដល់ រដូវ វស្សា រៀង ពិបាក ដាំ ។ ចំណែក បច្ចេកទេស នៃ ការដាំដុះ វិញ មិន ទាមទារ ឱ្យ កសិករ ចេះ បច្ចេកទេស ច្រើន នោះ ទេ ។
ទោះបីជា យ៉ាង នេះ ក្តី លោក ថា អ្វី ដែល សំខាន់ គឺ ដើមទុន នៃ ដាំដុះ នៅក្នុង ផ្ទះ សំណាញ់ គឺ ត្រូវ ចំណាយ ទុន ទៅ លើ ការសាងសង់ ផ្ទះ សំណាញ់ ខ្ពស់ ។ ជាក់ស្តែង កន្លងមក កសិករ ដែល បាន ដាំដុះ នៅក្នុង ផ្ទះ សំណាញ់ ក្នុង ទំហំ ដី ៨ម៉ែត្រ គុណ នឹង ២៥ម៉ែត្រ ចំណាយ ថវិកា សម្រាប់ ធ្វើ ផ្ទះ សំណាញ់ ក្នុង រង្វង់ ប្រមាណ ៣ ពាន់ ដុល្លារ ។
លោក មានប្រសាសន៍ ថា « ខ្ញុំ លើកទឹកចិត្ត សម្រាប់ កសិករ ខ្នាត តូច ឱ្យ ដាំដុះ បន្លែ នៅក្នុង ផ្ទះ សំណាញ់ ព្រោះ គាត់ អាច ដាំដុះ បាន ពេញ មួយ ឆ្នាំ ។ ហើយ ម្យ៉ាង អាច កាត់បន្ថយ បាន ច្រើន ផង ដូចជា ការបំផ្លាញ ពី សត្វ ល្អិត ហើយ ការថែទាំ និង លក្ខណៈ បច្ចេកទេស វា ល្អ ជាង ការដាំ នៅ ទីវាល ។ តែ សម្រាប់ កសិករ ខ្នាត ធំ ខ្ញុំ គិត ថា អាចនឹង ចំណាយ ទុក ច្រើន ខ្លាំង » ។
លោក លើកឡើង បន្ត ថា កន្លងមក មាន ចាប់អារម្មណ៍ ច្រើន ពី កសិករ នៅក្នុង ការដាំ បន្លែ នៅក្នុង ផ្ទះ សំណាញ់ ប៉ុន្តែ ពួកគាត់ ហាក់ មាន ភាពស្ទាក់ស្ទើ ក្នុង ការវិនិយោគ ទៅ លើ ការដាំដុះ ក្នុង ផ្ទះ សំណាញ់ ដោយសារតែ ចំណាយ ទុន ច្រើន ។ យ៉ាង នេះ ក្តី ប្រសិនបើ អង្គការ ដៃគូរ ពាក់ព័ន្ធ និង រដ្ឋាភិបាល មាន ការគាំទ្រ ហិរញ្ញវត្ថុ ដល់ កសិករ នឹង ជំរុញ ឱ្យ មាន ការដាំដុះ បន្លែ ក្នុង ផ្ទះ សំណាញ់ បាន កាន់តែ ច្រើន ព្រោះ សម្រាប់ កសិករ ខ្នាត តូច អាច ថា ជា ការចំណាយ ទុន ខ្ពស់ សម្រាប់ គាត់ ។
ពាក់ព័ន្ធ នឹង ទីផ្សារ បន្លែ នៅ កម្ពុជា វិញ អ្នក ឧកញ៉ា ហ៊ុន ឡាក់ សង្កេតឃើញ ថា បច្ចុប្បន្ន នេះ កសិករ មួយចំនួន បាន ងាក មក ដាំដុះ បន្លែ ក្នុង ផ្ទះ សំណាញ់ ច្រើន គួរឱ្យ កត់សម្គាល់ ប៉ុន្តែ លោក លើកទឹកចិត្ត ឱ្យ កសិករ ដាំដុះ បន្ថែម ទៀត ដើម្បី មាន បន្លែ ច្រើន ក្នុង ផ្គត់ផ្គង់ ក្នុង ទីផ្សារ និង កាត់បន្ថយ ការនាំចូល បន្លែ ពី ប្រទេស ជិតខាង ។
លោក លើកឡើង បន្ត ថា បច្ចុប្បន្ន នេះ លំហូរ ចូល នៃ បន្លែ ពី ក្រៅ ប្រទេស នៅតែ មាន ចំនួន ច្រើន នៅឡើយ ហេតុ នេះ ទើប ភាគី ពាក់ព័ន្ធ ជំរុញ ការផលិត ដើម្បី កាត់បន្ថយ ការនាំចូល បន្លែ ពី ប្រទេស ជិតខាង និង ជួយ ដល់ កសិករ បង្កើន នូវ ផលិតភាព និង ប្រាក់ ចំណូល ។
ប៉ុន្តែ យ៉ាងណា លោក លើកឡើង ថា បញ្ហា ទីផ្សារ បន្លែ នៅ កម្ពុជា ហាក់ នៅ មាន ភាពចង្អៀត ដោយសារតែ មិន ទាន់ មាន ផ្សារបោះ ដុំ ដែល ជា ផ្សារ ធំ ស្រូបយក ផលិតផល កសិកម្ម ដែល កសិករ ផលិត បាន ។ ហេតុ ដូច្នេះហើយ ទាមទារ ឱ្យ ភាគី ពាក់ព័ន្ធ ជំរុញ បន្ថែម ដើម្បី ឆ្លើយតប ការផលិត ទីផ្សារ សម្រាប់ ស្រូបយក និង ការប្រកួតប្រជែង ។
សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល បាន ទទួល ដំណឹង ដ៏ ក្រៀមក្រំ បំផុត ចំពោះ មរណភាព របស់ និស្សិត ខ្មែរ ម្នាក់ ដែល បាន បាត់បង់ជីវិត ដោយសារ ហេតុការណ៍ ប្រយុទ្ធ គ្នា រវាង អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស់ ដែល បាន ផ្ទុះឡើង កាលពី ថ្ងៃទី ០៧ ខែតុលា ម្សិលមិញ នេះ ។
សម្តេច បាន បន្ថែម ថា រាជ រដ្ឋាភិបាល បាន ចាត់ វិធានការទំនាក់ទំនងជា ប្រចាំ ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ដើម្បី ធានា ដល់ សុវត្ថិភាព របស់ ពលរដ្ឋ ខ្មែរ ជា លទ្ធផល ពេញ មួយ យប់ មិញ នេះ យើង បាន ទំនាក់ទំនង ជាមួយ ពលរដ្ឋ ខ្មែរ ភាគ ច្រើន នៅក្នុង ប្រទេស អ៉ី ស្រាអែល និង កំណត់ ទីតាំង របស់ ពួកគាត់ ហើយ ក្នុង នោះ យើង ក៏ បាន ខិតខំ ជួយសង្គ្រោះ និស្សតិ៣រូប ក្នុង ចំណោម ៤រូប ( ដែល ក្នុង នោះ ម្នាក់ បាន ស្លាប់ ) ចេញ ពី តំបន់ ក្រហម មក ស្នាក់ នៅ ជាមួយ កុងស៊ុល កិត្តិយស របស់ កម្ពុជា ក្នុង ប្រទេស អ៉ី ស្រាអែល ។
សម្តេច ធិបតី អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ នៅ ប្រទេស អ៉ី ស្រាអែល ធ្វើ យ៉ាងណា រក្សា កន្លែង សុវត្ថិភាព របស់ ខ្លួន ហើយ ស្តាប់ តាម ការណែនាំ របស់ អាជ្ញាធរ អ៉ី ស្រាអែល ព្រោះ ស្ថានភាព នៅ ទីនោះ មិន ទាន់ ស្ងប់ នៅឡើយ ដែល អាច ប្រែប្រួល គ្រប់ ពេល ទាំងអស់ ។
សម្តេច ធិបតី ក៏ បាន សម្តែង នូវ ការសោកស្រាយ និង ចូលរួម រំលែក ទុក្ខ ចំពោះ គ្រួសារ និស្សិត ខ្មែរ ដែល បាន បាត់បង់ជីវិត នៅក្នុង ប្រទេស អ៉ី ស្រាអែល ផងដែរ ហើយ បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល នឹង ខិតខំ សម្របសម្រួល តាម លទ្ធភាព ដែល អាច ធ្វើ ទៅ បាន ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ដើម្បី នាំយក សព និស្សិត របស់ យើង មកកាន់ កម្ពុជា ដែល អាច ឱ្យ គ្រួសារ រៀបចំ តាម ប្រពៃណី ហើយ កិច្ចការ ចាត់ចែង ការវិលត្រឡប់ និង ធ្វើ បុណ្យ សព នេះ ជាបន្ទុក រាជ រដ្ឋាភិបាល ។
ជាថ្មី ម្តង ទៀត សម្តេច បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កំពុង យកចិត្តទុកដាក់ ជាប់ ជាប្រចាំ ចំពោះ សុវត្ថិភាព របស់ ប្រជាពលរដ្ឋ និង និស្សិត ខ្មែរ ដែល មាន វត្តមាន នៅ ប្រទេស អ៉ី ស្រាអែល ហើយ នឹង ខិតខំ សម្របសម្រួល ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ឱ្យ អស់ លទ្ធភាព ដើម្បី ធ្វើ យ៉ាងណា ធានា សុវត្ថិភាព ដល់ ពលរដ្ឋ ខ្មែរ ។ សម្តេច ក៏ បាន ជូន ពរ ដល់ ពលរដ្ឋ និង និស្សិត ខ្មែរ ដែល កំពុង មាន វត្តមាន នៅ អ៉ី ស្រាអែល ទាំងអស់ ទទួលបាន សុវត្ថិភាព គ្រប់ ៗ គ្នា ៕
ក្រសួង ការបរទេស និង ស្ថានទូត កម្ពុជា បង្ហាញ លេខ ទូរស័ព្ទ ដើម្បីឱ្យ ពលរដ្ឋ និង និស្សិត ខ្មែរ នៅ អ៉ី ស្រាអែល ទាក់ទង ក្នុង ករណី ត្រូវការ ជំនួយ
( ភ្នំពេញ ) ៖ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ និង ស្ថានទូត កម្ពុជា បាន និង កំពុង មាន ទំនាក់ទំនង ដោយ ផ្ទាល់ ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ដើម្បី ស្នើសុំ កិច្ចសហប្រតិបត្តិការ សំដៅ ធានា និង ផ្តល់ កិច្ចការពារ សុវត្ថិភាព ជូន និស្សិត និង ពលរដ្ឋ កម្ពុជា ។
ករណី ត្រូវការ ជំនួយ កិច្ចការ កុងស៊ុល សូម មេត្តា ទាក់ទ ង៖
( ភ្នំពេញ ) ៖ កម្លាំង ជំនាញ ផែន ប្រឆាំង គ្រឿងញៀន ស្រាវជ្រាវ តាម ចាប់ខ្លួន មេ ខ្លោង ជួញដូរ គ្រឿងញៀន រត់គេចខ្លួន ជាង ៥ ឆ្នាំ ( ២០១៧ - ២០២៣ ) មាន ដីកា ចាប់ខ្លួន ៧ករណី ព្រមទាំង រឹបអូស បាន គ្រឿងញៀន ជិត ៣គីឡូក្រាម និង ១៦. ៤០០ គ្រាប់ ព្រមទាំង គ្រាប់បែក ដៃ ២គ្រាប់ ។
ប្រតិបត្តិការ នេះ អនុវត្ត តាម បញ្ជា របស់ នាយ ឧត្ដមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ និង នាយ ឧត្ដមសេនីយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការ រង ទទួល ផែន ប្រឆាំង បទល្មើស គ្រឿងញៀន និង អនុវត្ត តាម បញ្ជាដឹកនាំ ផ្ទាល់ របស់ ឧត្ដមសេនីយ៍ ឯក ឃឹង សារ៉ាត់ នាយក មន្ទីរ ប្រឆាំង គ្រឿងញៀន ។
នៅ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០២៣ វេលា ម៉ោង ១៣៖៣០ នាទី សមត្ថកិច្ច បាន រកឃើញ និង ចាប់ខ្លួន ជនល្មើស ឈ្មោះ ឃុន សំអាត ហៅ ស្មី ភេទ ប្រុស អាយុ ៤៤ ឆ្នាំ ( មេខ្លោង ) និង បក្សពួក ២នាក់ ឈ្មោះ ងែន ដាលី ន ភេទ ស្រី អាយុ ៣៤ ឆ្នាំ ( មេខ្លោង ) និង ឈ្មោះ នាង សុវណ្ណរ៉ា ភេទ ប្រុស អាយុ ៤៤ ឆ្នាំ នៅ ចំណុច ផ្ទះ ជួល ស្ថិត នៅក្នុង ភូមិ គោ ចំបក់ សង្កាត់ ចោម ចៅ មួយ ខណ្ឌ ពោធិ៍សែនជ័យ និង បន្ត ទៅ ឆែកឆេរ បន្ទប់ ជួល នៅ ចំណុច ភូមិ ត្រពាំង ថ្លឹង៣ សង្កាត់ ចោម ចៅ មួយ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
បច្ចុប្បន្ន សមត្ថកិច្ច ជំនាញ នៃ មន្ទីរ ប្រឆាំង គ្រឿងញៀន រៀបចំ កសាង សំណុំរឿង បញ្ជូន ជនល្មើស និង ជនសង្ស័យ ព្រមទាំង វត្ថុតាង ទៅ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ និង ខេត្ត កំពង់ឆ្នាំង ដើម្បី ចាត់ការ បន្ត តាម ផ្លូវ ច្បាប់ ។
សូម ជម្រាប ថា ក្រោយពេល ចូលកាន់ តំណែង ជា អគ្គ ស្នងការ នគរបាល ជាតិ នាយ ឧត្ដមសេនីយ៍ ស ថេត បាន ដាក់បញ្ជា យ៉ាង ម៉ឺងម៉ាត់ ឱ្យ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បោសសម្អាត ឧក្រិន ជន គ្រឿងញៀន ឱ្យ អស់ ហើយ នាយក មន្ទីរ ប្រឆាំង គ្រឿងញៀន ដែល ដឹកនាំ ដោយ ឧត្ដមសេនីយ៍ ឯក ឃឹង សារ៉ាត់ បាន ប្តេជ្ញាចិត្ត ថា នឹង ចុះបង្ក្រាប គ្រឿងញៀន តាម បណ្ដា រាជធានី - ខេត្ដ ឲ្យ អស់ នូវ បញ្ហា គ្រឿងញៀន នេះ ។
កម្លាំង មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន បាន អនុវត្ត ការងារ យ៉ាង សកម្ម ចាប់ បាន មេ ខ្លោង ជួញដូរ គ្រឿងញៀន ជា បន្តបន្ទាប់ ។ ជាក់ស្តែង ក្នុង រយៈពេល ១ សប្តាហ៍ នេះ កម្លាំង ជំនាញ បាន បង្ក្រាប បាន ករណី ជួញដូរ គ្រឿងញៀន ធំ ៗ ៣ករណី ៕ កុំ ឱ្យ ថ្ងៃ សប្បាយ ក្លាយជា ទុក្ខ ដោយសារ ការបើកបរ របស់ អ្នក ! ស្លាប់ ៣នាក់ និង របួស ៤នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៧ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ៤នាក់ ។
លោក ថោ ជេដ្ឋា ចុះ ពិនិត្យ ស្ថានភាព ទឹក និង ជួប សហគមន៍ កសិករ ប្រើប្រាស់ ទឹក នៅ ខេត្ត កំពង់ស្ពឺ
- អាងទឹក អន្លុង ជ្រៃ ស្ថិត ក្នុង ឃុំ ប្រាំបី មុំ ស្រុក ថ្ពង ខេត្ត កំពង់ស្ពឺ ដែល មាន ប្រវែង ៦ ៥០០ ម៉ែត្រ អាច ស្តុក ទឹក បាន ប្រមាណ ៣៥លាន ម៉ែត្រ គូប ផ្ទៃដី ស្រោច ស្រព លាតសន្ធឹង ក្នុង ខេត្ត កំពង់ ឆ្នាំង ខេត្ត កំពង់ស្ពឺ ខេត្ត កណ្តាល និង មួយ ផ្នែក នៃ រាជធានី ភ្នំពេញ ។
- ទំនប់ ពាម ល្វា អូរ តោង ស្ថិត ក្នុង ឃុំ ត្រពាំង ជោ ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ។ ទំនប់ នេះ បាន ធ្វើ ការ ជួសជុល និង ស្តារ ឡើងវិញ ក្នុង ឆ្នាំ ២០១៩ ដោយ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ។
- ទំនប់ អាងទឹក តា សាល ស្ថិត ក្នុង ឃុំ តាសាល ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ។ ទំនប់ អាងទឹក តា សាល ដែល មាន ប្រភព ទឹក ពី ស្ទឹង តាសាល មាន ផ្ទៃ រង ទឹកភ្លៀង ៤៦៥ គីឡូម៉ែត្រ ការ៉េ អាច ស្តុក ទឹក បាន ១៤០ លាន ម៉ែត្រ គូប ត្រូវបាន អភិវឌ្ឍន៍ ដោយ ប្រើប្រាស់ ហិរញ្ញប្បទាន របស់ រដ្ឋាភិបាល នៃ សាធារណ រដ្ឋ ឥណ្ឌា ។ ការសាងសង់ ទំនប់ អាងទឹក តា សាល ដើម្បី កាត់បន្ថយ ជំនន់ ស្ទឹង ព្រែក ត្នោត ផង ព្រម ទាំង ផ្តល់ ទឹក សម្រាប់ ការស្រោចស្រព និង ការប្រើ ប្រាស់ ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ ផង ។
( ព្រៃវែង ) ៖ កម្លាំង ចម្រុះ គណៈកម្មការ សន្តិសុខ សណ្តាប់ធ្នាប់ ខេត្ត ព្រៃវែង សហការ ជាមួយ គណ:កម្មការ ផ្សារ នៅ ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ បាន បន្ត អនុវត្ត រៀបចំ សណ្តាប់ធ្នាប់ ជុំវិញ ផ្សារ ក្រុង ព្រៃវែង ឱ្យ មាន របៀបរៀបរយ ខណៈ បច្ចុប្បន្ន នៅតែ មាន បងប្អូន អាជីវករ មួយចំនួន បន្ត យក អីវ៉ាន់ ដាក់ លក់ដូរ នៅ លេី ដង ផ្លូវ ជុំវិញ ផ្សារ ជារៀងរាល់ ថ្ងៃ ដោយ គ្មាន របៀបរៀបរយ និង មិន អាច ធ្វេី ចរាចរណ៍ បាន ។
យោង តាម គណៈកម្មការ សន្តិសុខ សណ្តាប់ធ្នាប់ ខេត្ត ព្រៃវែង បាន ឱ្យដឹង ថា « នេះ មិន មែន ជា លេីក ទី មួយ ទេ ដែល អាជ្ញាធរ ខេត្ត និង ក្រុង បាន ចុះ រៀបចំ សណ្តាប់ធ្នាប់ ផ្សារ ក្រុង ព្រៃវែង តែ ជា លទ្ធផល ដូចជា វែកចក ក្នុង ទឹក អ៊ីចឹង » ។
ចំណែក ថ្ងៃទី ២.៖ គណៈកម្មការ នៅ បន្ត ចុះ រៀបចំ បន្ត ទៀត និង តម្រូវ ឱ្យ អាជីវករ រេី គ្រែ រេី ឆ័ត្រ ចេញ ពី ដង ផ្លូវ ឬ ទ្រូងផ្លូវ តែ ម្តង ព្រោះ វា ជា ផ្លូវ សាធារណ: ដោយ មិន អនុញ្ញាតឱ្យ ពួកគាត់ លក់ លេី ផ្លូវ បន្ត ទៀត ទេ ។ ហេីយ ក្នុង ករណី បងប្អូន អាជីវករតវ៉ា ឬ មិន សហការ ជាមួយ អាជ្ញាធរ ទេ គណៈកម្មការ និង អនុវត្ដ តាម នីតិវិនៃ ច្បាប់ ។
ជាមួយគ្នា នេះ យោង តាម សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល សាលា ខេត្ត ព្រៃវែង ជូន ទៅ អាជីវករ និង សាធារណជន ចុះ ថ្លៃ ទី៤ ខែតុលា ឆ្នាំ ២០២៣ បាន បញ្ជាក់ ថា គណៈកម្មការ សន្តិសុខ និង សណ្ដាប់ធ្នាប់ ខេត្ត ព្រៃវែង នឹង ចុះ រៀបចំ សណ្ដាប់ធ្នាប់ ផ្លូវ សាធារណ ជុំវិញ ផ្សា ក្រុង ព្រៃវែង ចាប់ ចុះ ពី ថ្ងៃ ជូនដំណឹង តទៅ ដោយ តម្រូវ ឱ្យ បងប្អូន រំកិល ចេញ ឬ រុះរើ ចេញ ពីលើ ផ្លូវ សាធារណៈ ព្រោះ វា បង្កឱ្យ ប៉ះពាល់ ជាច្រើន ដូច ជា៖
ទី១៖ ប៉ះពាល់ ដល់ សុខភាព របស់ ប្រជាពលរដ្ឋ ទី២៖ ប៉ះពាល់ ដល់ សន្ដិសុខ សណ្ដាប់ធ្នាប់ របៀបរៀបរយ សាធារណៈ ទី៣៖ ប៉ះពាល់ ដល់ ការធ្វើចរាចរណ៍ របស់ ប្រជាពលរដ្ឋ ទូទៅ ធ្វើដំណើ ទី ៤៖ បង្កឱ្យ ប៉ះពាល់ ដល់ ការបង្ការ ទប់ស្កាត់ និង ងាយស្រួល សង្រ្គោះ ពេល មាន បញ្ហា កើតឡើង ដោយ ជា យថាហេតុ ដូចជា អគ្គិភ័យ ឆាប់ ឆេះ ជាដើម ទី៥៖ ប៉ះពាល់ ដល់ សោភ័ណភាព ទី៦៖ ប៉ះពាល់ ដល់ បរិស្ថាន អនាម័យ ៕ អតីត ប្រធាន អ៊ុន តាក់ នៅ កម្ពុជា៖ ប្រជាជន កម្ពុជា មាន សមត្ថភាព ពេញលេញ ក្នុង ការបង្កើត រដ្ឋធម្មនុញ្ញ ដ៏ ល្អ បំផុត មួយ នៅក្នុង ពិភពលោក
សូម បញ្ជាក់ ថា នៅ ថ្ងៃទី ៦ ខែតុលា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ កម្ពុជា បាន រៀបចំ ពិធី អបអរសាទរ ខួប ៣០ ឆ្នាំ ថ្ងៃ កំណើត ជាថ្មី រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។ ពិធី នោះ ត្រូវបាន ប្រព្រឹត្តទៅ ក្រោម ព្រះរាជា ធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ព្រះមហាក្សត្រ ខ្មែរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ។
ពិធី នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ កំពូល នៃ ស្ថាប័ន ជាតិ រួម មាន សម្តេច សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា . ឥស្សរជន នយោបាយ ជាន់ ខ្ពស់ របស់ កម្ពុជា រួម មាន សម្តេច តេជោ ហ៊ុន សែន សម្តេច ពញា ចក្រី ហេង សំរិន សម្តេច ក្រឡាហោម ស ខេង សម្តេច ពិជ័យ សេនា ទៀ បាញ់ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៧ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៦០ នាក់ ។
* ករណី ដឹកជញ្ជូន រក្សាទុក ២១ ករណី ឃាត់ខ្លួន ៤៦ នាក់ * ករណី ប្រើប្រាស់ ៣ករណី ឃាត់ខ្លួន ៦នាក់ * ករណី ជួញដូរ ២ករណី ឃាត់ខ្លួន ៣នាក់ * ករណី បេីក បរ ក្រោម ឥទ្ធិពល ១ករណី ឃាត់ខ្លួន ៥នាក់
( កាប៊ុល) ៖ មន្រ្តី គ្រប់គ្រង គ្រោះមហន្តរាយ និយាយ ថា ចំនួន មនុស្ស ស្លាប់ ក្នុង គ្រោះ រញ្ជួយ ដី ជាច្រើន លើក នៅ ភាគ ខាងលិច ប្រទេស អាហ្វហ្កានីស្ថាន បាន កើនឡើង ដល់ ១៥នាក់ ហើយនិង ៤០ នាក់ រងរបួស ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃសៅរ៍ ទី៧ ខែតុលា ឆ្នាំ ២០២៣ ។
លោក ក្លេវើលី បាន លើកឡើង តាម បណ្តាញ សង្គម យ៉ាង ដូច្នេះ ថា « ចក្រភព អង់គ្លេស គាំទ្រ សិទ្ធិ របស់ អ៉ី ស្រាអែល ក្នុង ការការពារ ខ្លួន ជានិច្ច ហើយ ថ្កោលទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ការវាយប្រហារ ដ៏ រន្ធត់ របស់ ក្រុមហា ម៉ាស់ លើ ជន ស៉ី វិល អ៉ី ស្រាអែល » ។
អ៉ី ស្រាអែល ប្រកាស សង្រ្គាម ក្រោយ ការបាញ់ ស្រោច គ្រាប់ រ៉ុក្កែត ពី ក្រុមហា ម៉ាស់ ។ ប្រទេស ជាច្រើន រួម មាន បារាំង អាល្លឺម៉ង់ សហភាព អឺរ៉ុប រួមទាំង អ៊ុយក្រែន ក៏ បាន ថ្កោលទោស ការវាយប្រហារ របស់ ក្រុមហា ម៉ាស់ លើ អ៉ី ស្រាអែល ហើយ ថា គាំទ្រ ដល់ សិទ្ធិ ស្វ័យ ការពារ ខ្លួន របស់ អ៉ី ស្រាអែល ស្រប ពេល សហរដ្ឋ អាមេរិក អះអាង ថា ខ្លួន កំពុង តាមដាន ស្ថានការណ៍ យ៉ាង យកចិត្តទុកដាក់ ៕ រូបភាព ពី Reuter វិទ្យាស្ថាន តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន បើក សិក្ខាសាលា តម្រង់ ទិស ជំនាញ សិក្សា សម្រាប់ សិស្ស ថ្នាក់ ទី ១២
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ វិទ្យាស្ថាន តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន បាន ដាក់ចេញ យុទ្ធសាស្ត្រ ផ្សព្វផ្សាយ តាមរយៈ ការធ្វើ សិក្ខាសាលា នៅ តាម សាលារៀន នានា ដើម្បី ទាក់ទាញ សិស្ស ចូលរៀន ជំនាញ នានា នៅក្នុង វិទ្យាស្ថាន ។
កម្មវិធី នេះ មាន គោលបំណង ជួយ តម្រង់ ទិស សិស្សានុសិស្ស នៅ កម្រិត មធ្យមសិក្សា ថ្នាក់ ទី១២ ឱ្យ មាន គោលដៅ ច្បាស់លាស់ ក្នុង ការចាប់ យក ជំនាញ ស្រប តាម ទីផ្សារ និង បំណងប្រាថ្នា ពិតប្រាកដ របស់ ពួកគេ នៅ តាម គ្រឹះស្ថាន ឧត្តម សិក្សា នានា ក្រោយពី បញ្ចប់ ថ្នាក់ មធ្យមសិក្សា ។
