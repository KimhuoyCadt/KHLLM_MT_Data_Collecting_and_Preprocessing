( ភ្នំពេញ ) ៖ លោក យិត បុណ្ណា រដ្ឋលេខាធិការ តំណាង លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នា ព្រឹក ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ បើក វគ្គ បណ្ដុះបច្ចេកទេស ស្ដីពី វិធីសាស្ត្រ គណនា កម្រាល ផ្លូវ ដោយ មាន ការចូលរួម ពី អង្គភាព ថ្នាក់ កណ្ដាល របស់ ក្រសួង និង គ្រប់ កង វិស្វកម្ម ដែល អនុវត្ត ការងារ សាងសង់ ផ្លូវថ្នល់ ក្រោម អាណាប័ក ក្រសួង ព្រមទាំង មន្ត្រី បច្ចេកទេស ពាក់ព័ន្ធ ។
វគ្គ បណ្ដុះបណ្ដាល នេះ រៀបចំឡើង ក្នុង គោលបំណង ផ្តល់ឱ្យ អ្នកជំនាញ និង ផ្នែក ពាក់ព័ន្ធ ស្វែងយល់ បន្ថែម នូវ ស្តង់ដារ ឌីហ្សាញ ដែល ត្រូវបាន រៀបចំ កែសម្រួល និង ធ្វើ បច្ចុប្បន្នភាព ក្រោម ជំនួយ បច្ចេកទេស ពី រដ្ឋាភិបាល អូស្ត្រាលី លើ បទដ្ឋាន សិក្សា គម្រោង ផ្លូវថ្នល់ ឆ្នាំ ១៩៩៩ ដើម្បី ទទួលបាន ធាតុ ចូល សំខាន់ ៗ ក្នុង ការឌីហ្សាញ កម្រាល ផ្លូវ ឆ្លើយតប ទៅនឹង ស្ថានភាព ជាក់ស្តែង ។
វគ្គ បណ្ដុះបណ្ដាល នេះ នឹង ត្រូវ រៀបចំ ក្នុង ក្របខណ្ឌ ទូទាំង ប្រទេស នៅ តាម បណ្ដា មណ្ឌល បច្ចេកទេស និង បណ្ដុះបណ្ដាល ចំនួន ៤ទីតាំង ផ្សេង ទៀត ជូន ដល់ វិស្វករ និង មន្ត្រី បច្ចេកទេស នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ទាំង ២៥ រាជធានី - ខេត្ត រួម មាន៖ ខេត្ត សៀមរាប កំពង់ចាម កែប និង ក្រចេះ ដើម្បី បំពេញ ប្រសិទ្ធភាព ក្នុង សិក្សា ស្វែងយល់ ផ្សព្វផ្សាយ និង អនុវត្ត ៕ អាជ្ញាធរ ខេត្ត ក្វាង ស៊ី ប្រើ យុទ្ធសាស្ត្រ បង្ហាញ ការអភិវឌ្ឍន៍ របស់ ខ្លួន ទៅកាន់ អាស៊ី អាគ្នេយ៍ តាមរយៈ អ្នកសារព័ត៌មាន
( ក្វាង ស៊ី . ចិន ) ៖ ក្វាង ស៊ី ជា ខេត្ត ដែល មាន អរិយធម៌ ដ៏ ចំណាស់ មួយ របស់ ចិន ហើយក៏ ជា ខេត្ត នៃ ច្រក ដ៏ សំខាន់ មួយ របស់ ចិន ដែល មាន ព្រំដែន ជាប់ ជាមួយ ប្រទេស អាស៊ី អាគ្នេយ៍ តាម ព្រំដែន គោក និង ព្រំដែន សមុទ្រ ។ ជាពិសេស នៅក្នុង សម័យ បុរាណ ប្រជាពលរដ្ឋ ខេត្ត ក្វាង ស៊ី បាន ផ្លាស់ប្តូរ ទំនាក់ទំនង ច្រើន ជាមួយ ពលរដ្ឋ នៅ តំបន់ អាស៊ី អាគ្នេយ៍ ហើយក៏ បាន ផ្លាស់ប្តូរ វប្បធម៌ និង ទំនៀមទម្លាប់ នៃ ការរស់នៅ ជាច្រើន រវាង គ្នា ផងដែរ ។
ក្វាង ស៊ី ក៏ មាន ទំនាក់ទំនង ផ្នែក ពាណិជ្ជកម្ម វិនិយោគ និង ទេសចរណ៍ យ៉ាង រស់រវើក ជាមួយ បណ្តា ប្រទេស នៅ តំបន់ អាស៊ី អាគ្នេយ៍ ។ ការរាត ត្បាត ជំងឺ កូវីដ១៩ ដែល ចាប់ផ្តើម ឡើង នៅ ចុង ឆ្នាំ ២០១៩ បាន បង្កើត ជា រណាំង និង បន្ទុចបង្អាក់ សម្រាប់ សកម្មភាព ទាំងអស់ នេះ ។
បន្ទាប់ពី ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ ត្រូវបាន ប្រយុទ្ធ ប្រឆាំង ដោយ ជោគជ័យ នៅ ឆ្នាំ ២០២៣ នេះ អាជ្ញាធរ ខេត្ត ក្វាង ស៊ី បាន ដាក់ចេញ នូវ យុទ្ធសាស្ត្រ ផ្សព្វផ្សាយ ពី កិច្ចអភិវឌ្ឍន៍ និង ការរីកចម្រើន លើ វិស័យ ឧស្សាហកម្ម តំបន់ ទេសចរណ៍ ក្នុង ខេត្ត ទៅកាន់ ពិភពលោក ជាពិសេស ប្រទេស អាស៊ី អាគ្នេយ៍ ។
ដំណើរទស្សនកិច្ច របស់ អ្នកសារព័ត៌មាន ប្រទេស អាស៊ី អាគ្នេយ៍ នៅលើ ទឹកដី ខេត្ត ក្វាង ស៊ី បាន រៀបចំ បើក ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ នៅក្នុង ខេត្ត ក្វាង ស៊ី ផងដែរ ។
លោក លីវ ឃុន បន្ត ថា ខេត្ត ក្វាង ស៊ី តែងតែ ចងចាំ ជានិច្ច នូវ ភារកិច្ច ផ្ដល់ ដោយ លោក ប្រធានាធិបតី ស៊ី ជិន ពីង ទទួលខុសត្រូវ លើ បេសកកម្ម យ៉ាង ក្លាហាន ឈរ លើ មូលដ្ឋាន នៃ ទីតាំង អំណោយផល ដ៏ ល្អ ឯក ចូលរួម យ៉ាង សកម្ម នៅក្នុង ការ ស្ថាបនា នៃ គំនិត ផ្ដួច ផ្ដើម ខ្សែក្រវាត់ និង ផ្លូវ ប្រឹងប្រែង ធ្វើការ យ៉ាង ល្អ សម្រាប់ ពិព័រណ៍ ចិន - អាស៊ាន កិច្ចប្រជុំ កំពូល ធុរកិច្ច ចិន អាស៊ាន និង ការវិនិយោគ និង វេទិកា ធំ ៗ ផ្សេង ទៀត ។
លោក បាន បង្ហាញ ក្តី រំពឹង ថា តាមរយៈ កម្មវិធី នេះ មនុស្ស កាន់តែ ច្រើន បាន ស្គាល់ ក្វាង ស៊ី ។ លោក ក៏ បាន បង្ហាញ ការជឿជាក់ យ៉ាង មុតមាំ ថា ការផ្សព្វផ្សាយ របស់ អ្នកសារព័ត៌មាន អាស៊ាន នឹង ក្លាយជា ស្ពាន ផ្សារភ្ជាប់ ក្វាង ស៊ី ជាមួយ សហគមន៍ អន្តរជាតិ ។
ថ្លែង ក្នុង ពិធី ចុះ កិច្ចព្រមព្រៀង ចង សម្ព័ន្ធ ភាព រវាង គណបក្ស ប្រជាជន កម្ពុជា និង គណបក្ស នយោបាយ ចំនួន ២៧ ផ្សេង ទៀត នា ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ ឱ្យ កម្លាំង គណបក្ស នយោបាយ ដែល ចូលរួម ជាមួយ កម្លាំង ជាតិ នេះ ត្រូវតែ ការពារ សន្តិភាព និង ការអភិវឌ្ឍ របស់ ជាតិ ឱ្យ បាន ។
សម្តេច បាន បញ្ជាក់ ថា « ចលនា ៩វិច្ឆិកា វា ជា អំពើ ក្បត់ ជាតិ ដ៏ ធំ ដែល យើង មិន អាច អត់ ឱន ទេ តុលាការ នៅតែ បន្ត កាត់ទោស ក្រុម នេះ តើ ការបំផុស ឱ្យ មនុស្ស ឱ្យ កងកម្លាំងប្រដាប់អាវុធ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ហើយ ឈាន មក ចាប់ នាយក រដ្ឋមន្រ្តី តើ នេះ ជា សិទ្ធិ បញ្ចេញមតិ ឬ ជា ការប្រកាស សង្គ្រាម ? » ។
ត្រង់ ចំណុច នេះ សម្តេច តេជោ ចង់ ផ្ញើ សារ ទៅកាន់ បរទេស មួយចំនួន ដែល ខ្វះ ការយល់ដឹង អំពី សេរីភាព បញ្ចេញមតិ និង ចលនា នៃ ការផ្តួលរំលំ ក្រៅ ប្រព័ន្ធ ។ សម្តេច បន្ត ថា សព្វ ថ្ងៃ នេះ នៅ កម្ពុជា មាន សេសសល់ នូវ សកម្មភាព ចលនា បដិវត្តន៍ ពណ៌ ហើយ សម្តេច បាន ជូន សារ ទៅ ប្រទេស មួយចំនួន អង្គការ ក្រៅ រដ្ឋាភិបាល ខ្លះ ដែល កំពុង ជ្រក ក្រោម ម្លប់ ចលនា បដិវត្តន៍ ពណ៌ ឱ្យ ឆាប់ ដក ខ្លួន ដែល កម្ពុជា មិន អត់ ឱ្យ នោះ ឡើយ ព្រោះ សន្តិភាព ត្រូវបាន ស្វែងរក ដោយ លំបាក ។
សម្តេច បាន បន្ថែម ថា « ចលនា យើង ពេលនេះ ជា ចលនា មួយ ដ៏ ខ្លាំង ហើយ យើង មិន ផ្តល់ ឱកាស ឱ្យ នរណា មួយ ធ្វើ សកម្មភាព បំផ្លាញ សន្តិភាព នេះ ទេ គណបក្ស ប្រជាជន តែ ឯង មិន គ្រប់គ្រាន់ ទេ ស ម្ធ័នភាព របស់ យើង នេះ សំដៅ ការពារ នូវ សន្តិភាព ដែល យើង រក បាន ដោយ លំបាក ហើយ សន្តិភាព នោះ ហើយ ដែល ផ្តល់ ឱកាស សម្រាប់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម » ។
សម្តេច តេជោ ក៏ ជំរុញ ឱ្យ រួមគ្នា ទប់ស្កាត់ នយោបាយ ជ្រុលនិយម មិន ថា ឆ្វេង និយម ឬ ស្តាំ និយម ដែល សុទ្ធតែ បង្ក គ្រោះថ្នាក់ ដល់ ប្រទេសជាតិ និង ប្រជាជន ទាំងអស់ ។ ការទប់ស្កាត់ ចលនា ជ្រុលនិយម ដែល អាច ធ្វើ ទៅ បាន ទាមទារ ឱ្យ មាន ការអប់រំ ដល់ សមាជិក សមាជិកា របស់ ខ្លួន ដើម្បី កុំ ឱ្យ ដើរ តាម ទម្លាប់ នយោបាយ ជ្រុលនិយម ដែល បង្ក គ្រោះថ្នាក់ ដល់ ប្រទេសជាតិ និង ប្រជាជន ៕
គ.ជ. ប រៀបចំ វគ្គ បញ្ជ្រាប ការ ពី សារៈសំខាន់ នៃ ការបោះឆ្នោត ដល់ បក្ស នយោបាយ អង្គការ មិន មែន រដ្ឋាភិបាល នាយក - នាយក រង សាលា យុវជន និង អាជ្ញាធរ ពាក់ព័ន្ធ នៅ ស្រុក កែវសីម៉ា ខេត្ត មណ្ឌលគិរី
( មណ្ឌលគិរី )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នា ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ វគ្គ អប់រំ ផ្សព្វផ្សាយ និង បញ្ជា្រប ការយល់ដឹង ស្តីពី សារៈសំខាន់ នៃ ការបោះឆ្នោត ជូន ដល់ គណបក្ស នយោបាយ អង្គការ មិន មែន រដ្ឋាភិបាល នាយក - នាយក រង សាលា យុវជន និង អាជ្ញាធរ ពាក់ព័ន្ធ នៅ ស្រុក កែវសីម៉ា ខេត្ត មណ្ឌលគិរី ។
វគ្គ នេះ ដឹកនាំ ដោយ នាយកដ្ឋាន បណ្តុះបណ្តាល និង អប់រំ អ្នកបោះឆ្នោត នៃ អគ្គ នាយកដ្ឋាន អប់រំ ព័ត៌មាន និង ទំនាក់ទំនង សាធារណៈ នៃ អគ្គ លេខាធិការដ្ឋាន គ.ជ. ប សហការ ជាមួយ លេខាធិការដ្ឋាន រៀបចំ ការបោះឆ្នោត ខេត្ត មណ្ឌលគិរី ក្រោម អធិបតីភាព លោក ស៊ុំ ប៊ុន ហុង អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន អប់រំ ព័ត៌មាន និង ទំនាក់ទំនង សាធារណៈ ។
សម្តេច តេជោ ហ៊ុន សែន បាន អះអាង ថា ស្មារតី នៃ កិច្ចព្រមព្រៀង សម្ព័ន្ធ រវាង CPP និង គណបក្ស ទាំង ២៧ គឺ បើក ទូលាយ ឱ្យ គណបក្ស ផ្សេងទៀត ចូលរួម ក្នុង សម្ព័ន្ធភាព នេះ ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា នា ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ថ្លែង ថា ស្មារតី នៃ កិច្ចព្រមព្រៀង ចង សម្ព័ន្ធ ភាព រវាង គណបក្ស ប្រជាជន កម្ពុជា (CPP) ជាមួយ បណ្ដា គណបក្ស នយោបាយ នៅ កម្ពុជា ចំនួន ២៧ ផ្សេង ទៀត គឺ បើក ទូលាយ ឱ្យ គណបក្ស នយោបាយ ស្រប ច្បាប់ ផ្សេង ទៀត បាន ចូលរួម ក្នុង សម្ព័ន្ធភាព ។
សម្ដេច តេជោ ហ៊ុន សែន អះអាង បែប នេះ ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ចង សម្ព័ន្ធ ភាព រវាង គណបក្ស ប្រជាជន កម្ពុជា ជាមួយ បណ្ដា គណបក្ស នយោបាយ នៅ កម្ពុជា ចំនួន ២៧ ផ្សេង ទៀត ។ ពិធី នេះ ធ្វើឡើង នៅ វិមាន ៧មករា ទីស្នាក់ការ កណ្ដាល របស់ គណបក្ស ប្រជាជន កម្ពុជា នា ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
សម្តេច បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា កិច្ចព្រមព្រៀង នេះ នឹង បើក ទូលាយ សម្រាប់ គណបក្ស នយោបាយ ស្រប ច្បាប់ ផ្សេង ទៀត ដែល គាំទ្រ និង មាន បំណង ចង់ ចូលរួម សហប្រតិបត្តិការ ចង សម្ព័ន្ធភាព រវាង បណ្តា បក្ស នយោបាយ នៅ កម្ពុជា តាម ស្មារតី នៃ កិច្ចព្រមព្រៀង នេះ ។ ហើយ ការសម្រេច អនុញ្ញាតឱ្យ គណបក្ស ផ្សេងទៀត ចូលរួម ឬ មិន ចូល នឹង មិន សម្រេច ដោយ ដោយ គណបក្ស ប្រជាជន តែ ម្នាក់ នោះ ទេ គឺ ត្រូវ មាន ការ ស្រុះស្រួល គ្នា មួយ តាមរយៈ ការជ្រើសរើស យក ការសម្រេច បែប សំឡេង កុង សង់ ស៉ីស ឬ ៥០ បូក១ ឬ ២ភាគ ៣។
បន្ទាប់ពី ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង នេះ សម្តេច តេជោ បាន ណែនាំ ឱ្យ មាន ការរៀបចំ បទ នូវ បញ្ជា ផ្ទៃក្នុង មួយ ទៀតផង ។ គណបក្ស ប្រជាជន កម្ពុជា នឹង បញ្ជូន ប្រធាន គណៈ ចាត់តាំង របស់ គណបក្ស ធ្វើជា អ្នកតាក់តែង បទបញ្ជា ផ្ទៃក្នុង ហើយ សូម ឱ្យ គណបក្ស នានា រៀបចំ ចាត់ បញ្ជូន តំណាង របស់ ខ្លួន ចូលរួម ក្នុង ការរៀបចំ បទបញ្ជា ផ្ទៃក្នុង នេះ ផងដែរ ។
បទបញ្ជា ផ្ទៃក្នុង នេះ នឹង រួមបញ្ចូល ទាំង ការជួបប្រជុំ ទីតាំង ជួបជុំ និង រយៈពេល ជួបប្រជុំ ជាដើម ៕
ការបញ្ជាក់ បែប នេះ របស់ សម្ដេច តេជោ ប្រធាន ធ្វើឡើង ក្នុង ពិធី ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ចង សម្ពន្ធភាព រវាង គណបក្ស ប្រជាជន កម្ពុជា ជាមួយ បណ្ដា គណបក្ស នយោបាយ នៅ កម្ពុជា ចំនួន ២៧ ផ្សេង ទៀត នៅ វិមាន ៧មករា ទីស្នាក់ការ កណ្ដាល របស់ គណបក្ស ប្រជាជន កម្ពុជា នា ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ ។
នា ឱកាស នោះ សម្ដេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា គណបក្ស នយោបាយ ទាំងអស់ គឺជា ដៃគូ ស្មើភាព ស្មើ សិទ្ធិ ដូច ៗ គ្នា ហើយក៏ មិន មែន ចំណុះ គណបក្ស ប្រជាជន កម្ពុជា នោះ ដែរ ប៉ុន្តែ គណបក្ស នយោបាយ ទាំងអស់ សុទ្ធតែ ស្ម័គ្រចិត្ត ធ្វើ កិច្ចសហប្រតិបត្តិការ ជាមួយគ្នា ដើម្បី ផលប្រយោជន៍ រួម សម្រាប់ ជាតិ កម្ពុជា ទោះបី គណបក្ស ប្រជាជន កំពុង ដឹកនាំ ប្រទេស ក៏ដោយ ។
សម្ដេច តេជោ បាន ថ្លែ យ៉ាង ដូច្នេះ ថា « គណបក្ស ប្រជាជន ទោះបី ខ្លួន មាន សមត្ថភាព ធនធាន មនុស្ស ច្រើន ហិរញ្ញវត្ថុ របស់ ខ្លួន ក៏ មាន ច្រើន ក៏ប៉ុន្តែ គណបក្ស ប្រជាជន មិន បាន មើល ទៅ គណបក្ស ដទៃ ជា គណបក្ស មិន ស្មើ ភាព ជាដៃគូ របស់ ខ្លួន នោះ ទេ ទោះបី មាន ទម្រង់ បែប ណា មាន ធនធាន បែប ណា ក៏ដោយ » ។
គួរ ជម្រាប ថា ក្នុង កិច្ចព្រមព្រៀង ដែល ចុះហត្ថលេខា ជាមួយ បក្ស នយោបាយ ទាំង ២៨ នេះ គឺ មាន ចំណុច ដែល តម្រូវ ឱ្យ មាន ការ ការពារ របប រាជ និយម អាស្រ័យ រដ្ឋធម្មនុញ្ញ ដោយសារ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ មាន ក្រុម ប្រឆាំង បាន បំពាន និង ប្រមាថ លើ ព្រះមហាក្សត្រ រួមទាំង ការទាមទារ ឱ្យ ព្រះមហាក្សត្រ ដាក់ រាជ្យ ជាដើម ៕
សម្តេច តេជោ ហ៊ុន សែន ចាត់ទុក ការបកស្រាយ របស់ ក្រុម ប្រឆាំង និង ជន បរទេស មួយចំនួន បំពាន លើ ទិដ្ឋភាព ជាក់ស្តែង នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស . ពេលនេះ កម្ពុជា គោរព តែ រដ្ឋធម្មនុញ្ញ ប៉ុណ្ណោះ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ថ្លែង ចាត់ទុក ការបកស្រាយ របស់ ក្រុម ប្រឆាំង និង ជន បរទេស មួយចំនួន ពាក់ព័ន្ធ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ២៣ តុលា គឺជា ការបំពាន លើ ទិដ្ឋភាព ជាក់ស្តែង នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ។
សម្តេច បាន បញ្ជាក់ ថា មនុស្ស ដែល បកស្រាយ ខុស ពី សច្ចភាព នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស នេះ មិន ស្គាល់ ពី ប្រវត្តិ នៃ កិច្ចព្រមព្រៀង នេះ ផង បែរជា ចាត់ទុក ខ្លួន ឯង ជា អ្នកជំនាញ លើ ការបកស្រាយ ទៅ វិញ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា ពេលនេះ មិន មែន ជា ពេលវេលា នៃ ការអនុវត្ត កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស នោះ ទេ ពេលនេះ ជា ពេលវេលា ដែល ត្រូវ ប្រតិបត្តិ តាម រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ព្រោះ ធាតុ ចូល ទាំងអស់ ត្រូវបាន ប្រមូលផ្តុំ ទៅក្នុង រដ្ឋធម្មនុញ្ញ រួចស្រេច ទៅ ហើយ ។
សម្តេច បាន ផ្តាំ ទៅ ក្រុម ប្រឆាំង ថា ការចង់ យក កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស មក សង្កត់ លើ រដ្ឋធម្មនុញ្ញ គឺ មិន បាន នោះ ទេ ត្រូវ សិក្សា មើល កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ឱ្យ បាន ច្បាស់ ។
ការលើកឡើង របស់ សម្តេច តេជោ ហ៊ុន សែន ធ្វើឡើង ក្នុង ពិធី ចុះ កិច្ចព្រមព្រៀង ចង សម្ព័ន្ធភាព រវាង គណបក្ស ប្រជាជន កម្ពុជា និង គណបក្ស នយោបាយ ចំនួន ២៧ ផ្សេង ទៀត នា ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នៅ វិមាន ៧មករា ។
សម្តេច បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « អ្វី ដែល គួរឱ្យ ចង់ សើច ហើយ មិន មែន ជា ការចំអក នោះ ទេ ថ្ងៃទី ២២ - ២៣ តុលាកន្លងទៅ គឺ ខួប លើក ទី ៣២ នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ខ្ញុំ មិន យល់ នូវ អ្វី ដែល ជា ការបកស្រាយ របស់ មនុស្ស ខ្លះ អំពី កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស នោះ ឡើយ សូម្បីតែ ប្រវត្តិ នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ចេញ ពី ទីណា ក៏ គេ មិន ដឹង ផង ប៉ុន្តែ គេ បែរជា ធ្វើជា អ្នកជំនាញ ដ៏ អស្ចារ្យ ទៅ លើ ការបកស្រាយ នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារី» ។
សម្តេច បញ្ជាក់ ទៀត ថា « ខ្ញុំ មិន មើល ស្រាល អ្នកណា ទេ ក៏ប៉ុន្តែ អ្វី ដែល ខ្ញុំ ចង់បាន គឺ ការគោរព សច្ចភាព នៃ ប្រវត្តិសាស្ត្រ ដែល បាន ឆ្លងកាត់ ។ ជន បរទេស មួយចំនួន ក៏ ធ្វើ ការបកស្រាយ មិន បាន ត្រឹមត្រូវ ពេលនេះ ម៉ោង នេះ កម្ពុជា គោរព តែ រដ្ឋធម្មនុញ្ញ តែ ប៉ុណ្ណោះ ស្មារតី នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស គោរព ហើយ ប៉ុន្តែ វា បាន ចូល ទៅក្នុង រដ្ឋធម្មនុញ្ញ និង បណ្តា ច្បាប់ របស់ កម្ពុជា រួចស្រេច ទៅ ហើយ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គ្មាន នរណា ចង់ បំភ្លេច នូវ អ្វី ដែល ខ្លួន បាន ទេ នោះ ទេ សម្រាប់ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស សម្តេច និង ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះនរោត្តម សីហនុ ព្រះបរម រតន កោដ្ឋ គឺជា តួអង្គ ពីរ ដ៏ សំខាន់ ដែល នាំមក នូវ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ហើយ ពេល នោះ បើ គ្មាន ការសម្រេច របស់ សម្តេច ពី ទីក្រុង ភ្នំពេញ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស នឹង មិន អាច ចេញ រួច ដែរ ។
សូម រំលឹក ថា ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ មួយចំនួន នៃ ការចរចា របស់ សម្តេច ទម្រាំ ឈាន ដល់ មាន កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ២៣ តុលា ឆ្នាំ ១៩៩១ ដែល មាន ភាគី ហត្ថា លេខី ៤ភាគី គឺ សម្តេច តេជោ ហ៊ុន សែន តំណាង ឲ្យ រដ្ឋាភិបាល កម្ពុជា . ចលនា តស៊ូ ហ៊្វុន ស៉ិន ប៉ិច ដែល តំណាង ដោយ សម្តេច ព្រះ នរោត្តម សីហនុ និង សម្តេច ក្រុម ព្រះ នរោត្តម រណប្ញទ្ឋិ . រណសិរ្ស ជាតិ រំដោះ ប្រជាពលរដ្ឋ ខ្មែរ ដែល តំណាង ដោយ លោក តា សឺន សាន និង ក្រុម ចលនា កម្ពុជា ប្រជាធិបតេយ្យ ( ប៉ុល ពត ) តំណាង ដោយ លោក ខៀវ សំផន ។
កិច្ចព្រមព្រៀង ជា ប្រវត្តិសាស្ត្រ នេះ មាន គោលដៅ សំខាន់ ៗ បី យ៉ាង រួម មាន៖ ទី១៖ រៀបចំ ឲ្យ មាន សន្តិភាព ឡើងវិញ នៅ ប្រទេស កម្ពុជា តាមរយៈ ការអនុវត្តន៍ បទ ឈប់ បាញ់ និង ការរំសាយ អាវុធ ក្នុង ជួរ កងទ័ព នៃ ភាគី ជម្លោះ ខ្មែរ ទាំង៤ ទី ២៖ ចាក់ គ្រឹះ លទ្ធិ ប្រជាធិបតេយ្យ ក្នុង ប្រទេស កម្ពុជា តាមរយៈ ការរៀបចំ បោះឆ្នោត សភា ធម្មនុញ្ញ និង ទី ៣៖ ការពារ អធិបតេយ្យ ឯករាជ្យ បូរណភាព និង ភាព ពុំ អាច រំលោភបំពាន បាន ឡើយ នូវ ទឹកដី អព្យាក្រឹតភាព និង ឯកភាព ជាតិ របស់ ប្រទេស កម្ពុជា ។
កិច្ចព្រមព្រៀង នេះ បាន ក្លាយទៅជា ប្រធានបទ សម្រាប់ ក្រុម ប្រឆាំង វាយប្រហារ លើ រាជ រដ្ឋាភិបាល កម្ពុជា ដោយ ចោទ ថា មិន បាន គោរព តាម ស្មារតី នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ជាដើម ។ សម្ដេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក ថា អ្នក ទាំងនោះ កំពុង បញ្ចេញមតិ ទាំង មិន ត្រឹមត្រូវ ហើយក៏ មិន បាន ស្ថិត នៅក្នុង ហេតុការណ៍ ជាក់ស្ដែង ដូច សម្ដេច ឡើយ ៕
រដ្ឋមន្ដ្រី ពាណិជ្ជកម្ម ជួប ពិភាក្សា ការងារ ជាមួយ ប្រធាន វិទ្យាស្ថាន ស្រាវជ្រាវ សេដ្ឋកិច្ច អាស៊ាន និង អាស៊ី បូព៌ា . ឯក អគ្គ រដ្ឋទូត ឆេក . និង អ្នកគ្រប់គ្រង ក្រុមហ៊ុន VISA
( ភ្នំពេញ ) ៖ លោកស្រី ចម និម្មល រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន អនុញ្ញាត លោក សាស្រ្តាចារ្យ Tetsuya Watanabe ប្រធាន វិទ្យាស្ថាន ស្រាវជ្រាវ សេដ្ឋកិច្ច អាស៊ាន និង អាស៊ី បូព៌ា និង ប្រតិភូ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ អំពី ការពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ក្រសួង ពាណិជ្ជកម្ម និង វិទ្យាស្ថាន ស្រាវជ្រាវ សេដ្ឋកិច្ច អាស៊ាន និង អាស៊ី បូព៌ា (ERIA) ។
លោកស្រី ចម និម្មល បន្ដ ជួប ជាមួយ លោក Martin Vávra ឯក អគ្គ រដ្ឋទូត ឆេក ប្រចាំ កម្ពុជា ដើម្បី ពិភាក្សា ការងារ អាទិភាព រួមគ្នា ព្រមទាំង ស្វែងយល់ អំពី វឌ្ឍនភាព និង សក្ដានុពល នៃ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី លើ វិស័យ សំខាន់ ៗ ជាពិសេស ការបង្កើន ទំនាក់ទំនង ពាណិជ្ជកម្ម និង ជំរុញ កាលានុវត្តភាព វិស័យ វិនិយោគ រវាង ប្រទេស ទាំង ពីរ ។
ការថ្លែង របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ជាង ១.២ម៉ឺន នាក់ នៅ ខេត្ត កំពង់ចាម នា ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ ។
លោក បាន មានប្រសាសន៍ បន្ត ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា បាន ជួយ រំដោះ ប្រទេស ចេញ ពី របប ប្រល័យ ពូជសាសន ប៉ុល ពត ដែល បាន ជួយ ជីវីត ប្រជាជន រាប់ លាន នាក់ ។ ព្រមទាំង ការបញ្ចប់ សង្រ្គាម ផ្ទៃក្នុង នៅក្នុង ឆ្នាំ ១៩៩៨ តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ ។
ដោយឡែក ក្នុង ពេល ដែល ពិភពលោក និង កម្ពុជា រង ផល ប៉ះពាល់ ពី ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ រាជ រដ្ឋាភិបាល បាន យកចិត្តទុកដាក់ និង ខិតខំ ស្វែងរក វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ដើម្បី ជួយ អាយុជីវីត ប្រជាពលរដ្ឋ ផងដែរ ។
សម្តេច ធិបតី បាន គូសបញ្ជាក់ បន្ថែម ថា « ជីវិត ប្រជាពលរដ្ឋ គឺជា គោលដៅ ធំ ដែល យើង បាន ធ្វើ និង ខិតខំ ធ្វើ ក្នុង រយៈពេល ៤៤ ឆ្នាំ នេះ ចាប់តាំងពី ការរំដោះ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។ ការបញ្ចប់ សង្គ្រាម តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ ឆ្នាំ ១៩៩៨ ។ កូវីដ សង្គ្រោះ ជីវិត ប្រជាពលរដ្ឋ សុខចិត្ត បិទ ប្រទេស កន្លែង ខ្លះ ខិតខំ រក វ៉ាក់ ដាក់ ប្រទេស ដើម្បី ជួយ ជីវិត ប្រជាពលរដ្ឋ ។ អាយុជីវិត ប្រជាពលរដ្ឋ សំខាន់ ណាស់ ហើយ យើង បាន យកចិត្តទុកដាក់ » ។
ទន្ទឹម គ្នា នេះ ករណី សង្រ្គាម នៅ ប្រទេស អ៊ីស្រាអែល ដែល បាន ចាប់ផ្តើម តាំងពី ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ រាជ រដ្ឋាភិបាល យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង និង តាមដាន ជាប់ ជាប្រចាំ ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ ប្រជាពលរដ្ឋ កម្ពុជា ដែល កំពុង រៀន និង ធ្វើការ នៅ ប្រទេស អ៊ីស្រាអែល មាន សុវត្ថិភាព ដែល មកដល់ ពេលនេះ ពួកគេ មាន សុវត្ថិភាព និង បំពេញ ការងារ បានជា ធម្មតា ។
តែ យ៉ាងណា សម្តេច បញ្ជាក់ ថា បើ ទោះបីជា ស្ថានភាព នៅ អ៊ីស្រាអែល គ្រប់គ្រង បាន ច្រើន ក៏ដោយ ប៉ុន្តែ ស្ថានភាព នៅតែ មាន ភាព មិន ច្បាស់លាស់ ។
សម្តេច ធិបតី បាន គូសបញ្ជាក់ ផងដែរ ថា កម្ពុជា មិន ត្រឹមតែ ប្តេជ្ញាចិត្ត ក្នុង ការថែរក្សា សន្តិភាព ក្នុង ប្រទេស ខ្លួន ឯង នោះ ទេ ប៉ុន្តែ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង នាម ជា សមាជិក អង្គការ សហ ប្រជាជាតិ សមាជិក អាស៊ាន នឹង ចូលរួម ថែរក្សា សន្តិភាព ស្ថេរភាព នៅក្នុង តំបន់ កុំ ឱ្យ មាន ការប៉ះពាល់ ៕
លោក ឃួង ស្រេង ស្នើ អូស្ត្រាលី ពិនិត្យ លទ្ធភាព ដើម្បី វិនិយោគ លើ សេវា ដឹកជញ្ជូន សាធារណៈ នៅ រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន សំណូមពរ ឲ្យ អូស្ត្រាលី ពិនិត្យ លទ្ធភាព ដើម្បី វិនិយោគ លើ សេវា ដឹកជញ្ជូន សាធារណៈ នៅ រាជធានី ភ្នំពេញ ខណៈ ដែល កំណើន ប្រជាពលរដ្ឋ នៅ រាជធានី ភ្នំពេញ ចេះតែ កើនឡើង ប្រឈម ទៅ ហ្នឹង ការកកស្ទះ ចរាចរណ៍ ។
លោក ឃួង ស្រេង ក៏ បាន បញ្ជាក់ ផងដែរ ថា ក្រៅពី ប្រឈម នឹង បញ្ហា ចរាចរណ៍ រាជធាន ភ្នំពេញ ក៏ មា និង បញ្ហា ប្រឈម ទៅនឹង បញ្ហា ប្រព័ន្ធ លូ ប្រឡាយ ផងដែរ ដែល បញ្ហា នេះ សម្ដេច បវរធិបតី ហ៊ុន ម៉ាណែត យកចិត្តទុកដាក់ ណាស់ ដោយ ធ្វើ យ៉ាងណាអោយ រាជធានី ភ្នំពេញ លែង លិច លង់ ក្នុង រយៈពេល ៤ឆ្នាំ ទៀត ។
លោក បញ្ជាក់ ផងដែរ ថា ការមក សម្ដែង ការគួរសម នេះ លោក មាន បំណង ចង់ ស្ដាប់ ពី បញ្ហា ប្រឈម នានា របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ និង ការដោះស្រាយ ប្រឈម ទាំងនោះ ។
ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ចិន បាន រាយការណ៍ ថា ក្នុង សារលិខិត មួយ ផ្ញើរ ទៅកាន់ គណៈកម្មាធិការ ជាតិ ស្តីពី ទំនាក់ទំនង សហរដ្ឋ អាមេរិក - ចិន ដែល មាន ទីស្នាក់ការ នៅ ទីក្រុង ញូវយ៉ក ក្នុង ពិធី ជប់លៀង ប្រចាំ ឆ្នាំ លោក ស៉ី បាន គូសបញ្ជាក់ ថា « សហរដ្ឋ អាមេរិក និង ចិន អាច បង្កើត វិធី ត្រឹមត្រូវ ដើម្បី អាច ចុះ សម្រុង គ្នា បាន ឬ អត់ គឺ ពិតជា មាន សារៈសំខាន់ ចំពោះ ពិភពលោក » ។
ការអត្ថាធិប្បាយ ពី ស្ថិរភាព នៃ ទំនាក់ទំនង ទ្វេ ភាគី រវាង សហរដ្ឋ អាមេរិក និង ចិន ដែល លោក ស៉ី និយាយ ថា គួរតែ ស្ថិត លើ គោលការណ៍ នៃ ការគោរព គ្នា ប្រកបដោយ សន្តិភាព និង កិច្ចសហប្រតិបត្តិការ ឈ្នះ - ឈ្នះ នា ពេលនេះ បាន កើតឡើង មុនពេល មាន ដំណើរទស្សនកិច្ច ដ៏ សំខាន់ របស់ រដ្ឋមន្ត្រី ការបរទេស លោក Wang Yi ទៅកាន់ ទីក្រុង វ៉ាស៊ីនតោន នៅ ចុង សប្តាហ៍ នេះ ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៨. ៩៤១ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៥. ៨៨៥ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ យោធា អ៉ី ស្រាអែល វាយប្រហារ លើ ហេដ្ឋារចនាសម្ព័ន្ធ យោធា ក្នុង ទឹកដី ស៉ីរី
( ហ្ស៊េ រុយ សាឡិម) ៖ យោធា អ៉ី ស្រាអែល នៅ ថ្ងៃពុធ នេះ បាន និយាយ ថា ខ្លួន បាន វាយប្រហារ លើ ហេដ្ឋារចនាសម្ព័ន្ធ យោធា នៅក្នុង ប្រទេស ស៉ីរី ដែល ជា ការឆ្លើយតប ទៅនឹង ការបាញ់ ផ្លោង មក លើ អ៉ី ស្រាអែល ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃពុធ ទី២៥ ខែតុលា ឆ្នាំ ២០២៣ ។
កងកម្លាំង ការពារ ជាតិ អ៉ី ស្រាអែល (IDF) បាន លើកឡើង ក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា យន្តហោះ ចម្បាំង របស់ ខ្លួន បាន វាយប្រហារ ទៅ លើ ហេដ្ឋារចនាសម្ព័ន្ធ យោធា និង កាំភ្លើង ត្បាល់ ដែល ជា កម្មសិទ្ធិ របស់ កងទ័ព ស៉ីរី ដើម្បី ឆ្លើយតប ទៅនឹង ការបាញ់ ផ្លោង មកកាន់ អ៉ី ស្រាអែល កាលពី ថ្ងៃ ថ្ងៃអង្គារ ។
អ្នកនាំពាក្យ មួយ រូប របស់ យោធា អ៉ី ស្រាអែល បាន ប្រាប់ AFP ថា នេះ ជា ការវាយប្រហារ ចូល ទៅក្នុង ទឹកដី ស៉ីរី តែម្តង ។ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ស៉ីរី បាន ចោទ ប្រកាន់ អ៉ីស្រាអែល ថា បាន ធ្វើ ការវាយប្រហារ តាម អាកាស លើ អាកាសយានដ្ឋាន ធំ ៗ ចំនួន ២ របស់ ខ្លួន កាលពី ថ្ងៃអាទិត្យ ចុង សប្តាហ៍ កន្លង ។
ការលើកឡើង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ប្រមាណ ១២. ០៦០ នាក់ នៅ បណ្តា រោងចក្រ សហគ្រាស ចំនួន ១៤ ដែល មាន មូលដ្ឋាន នៅក្នុង ស្រុក ព្រៃឈរ និង ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម នា ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « គ្មាន ប្រទេស ណាមួយ សប្បាយរីករាយ នៅ ពេល ដែល ខ្លួន អសន្ដិសុខ ទេ គ្មាន ប្រទេស ណាមួយ សប្បាយ នៅ ពេល ដែល ប្រទេស របស់ ខ្លួន ធ្លាក់ នៅក្នុង ភ្លើង សង្គ្រាម នោះ ទេ កុំ ថា ប្រទេស អ្នក មាន ប្រទេស អ្នកក្រ» ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា សម្ដេច បាន ជួប ជាមួយនឹង ថ្នាក់ដឹកនាំ បណ្ដា ប្រទេស ជាច្រើន គឺ បាន អបអរសាទរ ចំពោះ ការរៀបចំ រដ្ឋាភិបាល និង ដំណើរការ ប្រទេស កម្ពុជា ដោយ មាន ស្ថេរភាព សន្ដិភាព ព្រោះថា នៅ គ្រប់ ប្រទេស ទាំងអស់ ស្គាល់ នូវ តម្លៃ នូវ ការអនុវត្ដ លទ្ធិ ប្រជាធិបតេយ្យ ផ្អែក លើ ច្បាប់ និង ធ្វើឲ្យ ប្រជាជន មាន សេចក្ដីសុខ ។
ទន្ទឹម គ្នា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា បើ ប្រទេស កម្ពុជា មិន ជ្រើសរើស យក ការបោះឆ្នោត ទេ កម្ពុជា នឹង មាន សង្គ្រាម បង្ក ជា អស្ថិរភាព ទៅ វិញ ប្រជាពលរដ្ឋ នឹង ជួប ការលំបាក គ្មាន ការវិនិយោគ និង រោងចក្រ ឡើយ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា មាន តែ ការបោះឆ្នោត តាម រដ្ឋធម្មនុញ្ញ ទេ ដែល ជា មធ្យោបាយ សន្តិវិធី ល្អ បំផុត ក្នុង ការជ្រើសរើស មេដឹកនាំ ប្រទេស មិន មែន ផ្លាស់ប្តូរ តាម ការអំពាវនាវ ឬ ផ្តួលរំលំ នោះ ឡើយ ។ សម្ដេច បន្ដ ថា ការបោះឆ្នោត របស់ ប្រជាពលរដ្ឋ យ៉ាង ច្រើន លើសលុប ជា ការទទួលស្គាល់ និង ធ្វើឲ្យ រដ្ឋាភិបាល បច្ចុប្បន្ន ជា រដ្ឋាភិបាល ស្រប ច្បាប់ យ៉ាង ពិតប្រាកដ ។ ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ឱកាស ចុះ កិច្ចព្រមព្រៀង ចង សម្ព័ន្ធ ជាមួយ គណបក្ស ២៧ ផ្សេង ទៀត
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ឱកាស ចុះ កិច្ចព្រមព្រៀង ចង សម្ព័ន្ធ ជាមួយ គណបក្ស ២៧ ផ្សេង ទៀត និង ឆ្លើយ សំណួរ ជាមួយ អ្នកសារព័ត៌មាន៖
* សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា សូម កោតសរសើរ ដល់ គណបក្ស ទាំង ២៨ ដែល រៀបចំ ឱ្យ មាន ការចុះ កិច្ចព្រមព្រៀង នៅ ថ្ងៃ នេះ ។
* សម្តេច តេជោ ថ្លែង ថា គណបក្ស ទាំងអស់ មិន ស្ថិត នៅ ការគ្រប់គ្រង គណបក្ស ណាមួយ ទេ គឺ ស្មើ សិទ្ធិ ស្មើភាព គ្នា មិន មែន ស្ថិត ក្រោម គណបក្ស ប្រជាជន កម្ពុជា បើ ទោះបីជាបក្ស ប្រជាជន កំពុង កាន់អំណាច ក្តី និង មាន ធនធាន ហិរញ្ញវត្ថុ ក្តី ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការអញ្ជើញ អនុប្រធានបក្ស ប្រជាជន ទាំង ៤រូប ចូលរួម នៅ ពេល នេះ ដែល មាន ចំនួន ច្រើន ជាង បក្ស ដទៃ គឺ ក្នុង នាម ជា ម្ចាស់ ផ្ទះ ជា ការទទួល ភ្ញៀវ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការចុះ កិច្ចព្រមព្រៀង នៅ ថ្ងៃ នេះ គណបក្ស ផ្សេង ទៀត អាចនឹង រង ការចោទប្រកាន់ ពី ក្រុម ប្រឆាំង ថា ជា អាយ៉ង របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អ្វី ដែល យើង ចុះ កិច្ចព្រមព្រៀង នេះ គឺ មាន ការគ្របដណ្តប់ ក្នុង រដ្ឋធម្មនុញ្ញ ។
* សម្តេច បាន ចោទ ជា សំណួរ ថា សម្តេច មិន យល់ មនុស្ស មួយចំនួន ដែល បាន បកស្រាយ មិន ត្រឹមត្រូវ លើ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ២៣ តុលា ដោយ សម្តេច បាន រំលឹក ពី ដំណើរការ នៃ ការចុះ កិច្ចព្រមព្រៀង ទៀត ទីក្រុង ប៉ារីស ។
* សម្តេច បាន ចាត់ទុក ការបកស្រាយ របស់ ក្រុម មួយ ចំនួន នោះ គឺ បំពាន លើ ភាព ជាក់ស្តែង នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បាន សម្តេច ចង់បាន ការគោរព នូវ សច្ចភាព នៅ អ្វី ដែល បាន ឆ្លងកាត់ ហើយ ពេលនេះ កម្ពុជា គោរព តែ រដ្ឋធម្មនុញ្ញ ប៉ុណ្ណោះ ។
* សម្តេច បាន ថ្លែង ថា សម្តេច និង សម្តេច នរោត្តម សីហនុ គឺជា តួអង្គ ២នាក់ ដែល សំខាន់ នាំឱ្យ មាន កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការយក កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស មក សង្កត់ លើ រដ្ឋធម្មនុញ្ញ កម្ពុជា គឺជា រឿង មិន ត្រឹមត្រូវ ទេ ។
* សម្តេច បាន ថ្លែង ថា ក្នុង កិច្ចព្រមព្រៀង ដែល ចុះហត្ថលេខា ជាមួយ បក្ស នយោបាយ ទាំង ២៨ មាន ចំណុច ដែល តម្រូវ ឱ្យ មាន ការពារ របប រាជ និយម អាស្រ័យ រដ្ឋធម្មនុញ្ញ ដោយសារ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ មាន ក្រុម ប្រឆាំង បាន បំពាន និង ប្រមាថ លើ ព្រះមហាក្សត្រ រួមទាំង ការទាមទារ ឱ្យ ព្រះមហាក្សត្រ ដាក់ រាជ ជាដើម ។
* សម្តេច តេជោ បាន ថ្លែង ថា ការពារ របប រាជានិយម បាន ទាមទារ ឱ្យ មាន ចលនា ជាតិ និយម មួយ ដែល ទាមទារ ឱ្យ គណបក្ស នយោបាយ ចូលរួម ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អ្វី ដែល យើង ទាមទារ នៅ ពេល នេះ គឺ កម្លាំង ជាតិ និង កម្លាំង បក្ស នយោបាយ ដែល ចូលរួម ក្នុង កិច្ចព្រមព្រៀង សម្ព័ន្ធភាព នេះ គឺ ត្រូវការពារ សន្តិភាព ឱ្យ ខាងតែ បាន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ចលនា ៩វិច្ឆិកា ដែល ជា ចលនា នៃ ការផ្តួលរំលំ រាជ រដ្ឋាភិបាល គឺ មិន ត្រូវ អត់ ឱន ទេ ហើយ តុលាការ កំពុង បន្ត ដំណើរការ លើ រឿងក្តី នេះ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នយោបាយ ជ្រុលនិយម គឺជា ការនាំឱ្យ កើត បដិវត្តន៍ ពណ៌ ដែល យើង ត្រូវ រួមគ្នា ទប់ស្កាត់ និង កម្ចាត់ ចោល ។
* សម្តេច បាន អំពាវនាវ ឱ្យ បណ្តា គណបក្សយោបាយ ទាំងអស់ ចូលរួម ទប់ស្កាត់ នូវ នយោបាយ ឬ ចលនា ជ្រុលនិយម នេះ ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ បណ្តា គណបក្ស ទាំងអស់ អប់រំ សមាជិក របស់ ខ្លួន ដើម្បី កម្ចាត់ នូវ ចលនា ជ្រុលនិយម ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ប៉ុន្មាន ថ្ងៃ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា ឬ គណបក្ស ប្រជាជន ពិតជា លំបាក ណាស់ ក្នុង ការគាំទ្រ លើ អ៉ី ស្រាអែល ឬ ក្រុមហា ម៉ាស របស់ ប៉ាឡេស្ទីន ដោយសារតែ មាន ចលនា ជ្រុលនិយម ។
* សម្តេច តេជោ ហ៊ុន សែន ណែនាំ ឱ្យ មាន ការរៀបចំ បទបញ្ជា ផ្ទៃក្នុង មួយ សម្រាប់ សម្ព័ន្ធភាព នៃ គណបក្ស នយោបាយ ទាំង ២៨ ដែល ចុះ ព្រមព្រៀង នេះ រួម មាន ទាំង ការជួបប្រជុំ ទីតាំង ជួបជុំ រយៈពេល ជួបប្រជុំ ជាដើម ។
* សម្តេច បាន ថ្លែង ថា ស្មារតី នៃ កិច្ចព្រមព្រៀង នេះ គឺ បើក ទូលាយ ឱ្យ គណបក្ស ផ្សេង ទៀត ចួល រួម ក្នុង សម្ព័ន្ធភាព ដែល ត្រូវ ទាមទារ ឱ្យ មាន ការ ស្រុះស្រួល គ្នា មួយ ដែល ទាមទារ ឱ្យ មាន បទបញ្ជា ផ្ទៃក្នុង មួយ ថា តើ ជ្រើសរើស យក ការសម្រេច បែប កុងសង់ ស៉ីស ឬ ៥០ បូក១ ?
ខាងក្រោម ជា ខ្លឹមសារ របស់ សម្តេច តេជោ ហ៊ុន សែន ឆ្លើយតប សំណួរ អ្នកសារព័ត៌មាន៖
* សម្តេច តេជោ ហ៊ុន សែន ការចង សម្ព័ន្ធ នេះ ជា ការឆ្លុះបញ្ចាំង អំពី សាមគ្គីភាព នៃ ការថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ របស់ កម្ពុជា
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា យើង ត្រូវការកម្លាំង មួយ ដើម្បី ការពារ ដ្ឋធម្មនុញ្ញ របប រាជានិយម អធិបតីភាព និង សន្តិភាព ទប់ស្កាត់ កម្លាំង ជ្រុលនិយម
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ជាង ពាក់កណ្តាល នៃ គណបក្ស នយោបាយ ដែល មាន នៅ កម្ពុជា ដែល បាន ចង សម្ព័ន្ធភាព ជាមួយគ្នា នា ពេលនេះ
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ទោះបីជា យើង ខុសគ្នា ត្រង់ ចំណុច នេះ ចំណុច នោះ ប៉ុន្តែ យើង ស្រប គ្នា នូវ ចំណុច ធំ សម្រាប់ ប្រទេស យើង បើសិន ដូចគ្នា ទាំងស្រុង វា មិន ចាំបាច់ មាន គណបក្ស ផ្សេង នោះ ទេ
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ការចង សម្ព័ន្ធ នេះ មិន មែន ជា បញ្ហា កញ្ឆក់ក ណ្តៀត ដូច សម្ព័ន្ធភាព របស់ គណបក្ស នយោបាយ ខ្លះ ដែល មាន គោលដៅ រយៈពេល ខ្លី នោះ ទេ
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា សម្ព័ន្ធ ភាព រវាង បក្ស នយោបាយ ២៨ គឺ មាន គោលដៅ យូរអង្វែង សម្រាប់ ប្រទេស របស់ យើង
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា អាណត្តិ មុន សម្តេច ផ្តួចផ្តើម បង្កើត ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ដោយ មាន សមាជិក មកពី គណបក្ស ចូលរួម ការបោះឆ្នោត ប៉ុន្តែ អាណត្តិ នេះ នាយក រដ្ឋមន្រ្តី ថ្មី មាន គំនិត មួយ ទៀត ដែល យក សមាសភាព គណបក្ស ដែល បាន ចុះបញ្ជី នៅ ក្រសួង មហាផ្ទៃ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា សមាសភាព ថ្មី ក្នុង ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ឱកាស សម្រាប់ បក្ស នយោបាយ ទាំងអស់ ផ្តល់ ធាតុ ចូល រាជ រដ្ឋាភិបាល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ការចុះហត្ថលេខា លើ សម្ព័ន្ធ ភាព ថ្ងៃ នេះ គឺ ស្ថិត នៅក្នុង គោលដៅ មួយចំនួន ដែល យើង បាន ដាក់ ចូល ទៅក្នុង កិច្ចព្រមព្រៀង នេះ ដែល នឹង ធ្វើ ការសហការ ជាមួយគ្នា ក្នុង គោលដៅ ទូលាយ ដូចជា ការពារ រដ្ឋធម្មនុញ្ញ របប រាជានិយម ឯករាជ្យ អធិបតេយ្យភាព សន្តិភាព ការអភិវឌ្ឍ និង ការកម្ចាត់ ចោល នយោបាយ ជ្រុលនិយម ដែល គ្រោះថ្នាក់ រយៈពេល វែង សម្រាប់ កម្ពុជា ហើយ មិន គួរឱ្យ កើត មាន ឡើង ចំពោះ កម្ពុជា ទៀត ទេ
* សម្តេច តេជោ ហ៊ុន សែន រំពឹង ថា កម្លាំង ២៨ គណបក្ស ដែល មាន សមាជិក រាប់ លាន នាក់ នឹង ក្លាយជា កម្លាំង ធំ មួយ ដើម្បី ទប់ស្កាត់ កម្លាំង នយោបាយ ជ្រុលនិយម ហើយ ក្រុម ជ្រុលនិយម ក៏ មិន អាច មក ពង្រីក កម្លាំង បាន ហើយ ផ្ទុយទៅវិញ នឹង រំលំ រលាយ ទៅ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា គណបក្ស នយោបាយ ទាំង ២៧ ដែល ចង សម្ព័ន្ធ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា មិន មែន ជា កូន ចៅ គណបក្ស ប្រជាជន កម្ពុជា ទេ ហើយក៏ មិន មាន ការប៉ះពាល់ ដល់ ដំណើរការ ប្រជាធិបតេយ្យ នោះ ទេ ផ្ទុយទៅវិញ វា នឹង ធ្វើឱ្យ ប្រព័ន្ធ ប្រជាធិបតេយ្យ នៅ កម្ពុជា កាន់តែ ល្អ ប្រសើរ ។
* សម្តេច តេជោ ហ៊ុន សែន ស្នើ ឱ្យ បក្ស នយោបាយ ដែល ចង សម្ព័ន្ធ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា រៀបចំ ទូកង ប្រគួត ប្រជែង គ្នា នៅក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ខាងមុខ នេះ ។
អាល្លឺម៉ង់ នឹង បន្ត គាំទ្រ កម្ពុជា លើ វិស័យ ការងារ សន្តិសុខ សង្គម និង ការបណ្តុះបណ្តាល បច្ចេកទេស
ក្នុង នោះ ភាគី អាល្លឺម៉ង់ បាន បញ្ជាក់ ពី ការបន្ត កិច្ចសហប្រតិបត្តិការ របស់ រដ្ឋាភិបាល អាល្លឺម៉ង់ ជាមួយ ក្រសួង ការងារ លើ វិស័យ ការងារ សន្តិសុខ សង្គម និង ការបណ្តុះបណ្តាល បច្ចេកទេស វិជ្ជាជីវៈ ដើម្បី ជំរុញ និង បង្កើន ប្រសិទ្ធភាព និង បរិយាកាស កាន់តែ ប្រសើរ នៅក្នុង វិស័យ ការងារ សន្តិសុខ សង្គម និង ការបណ្តុះបណ្តាល បច្ចេកទេស វិជ្ជាជីវៈ នៅ កម្ពុជា ។
ក្នុង កិច្ចពិភាក្សា ដ៏ ស្និទ្ធស្នាល នោះ លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ ចំពោះ រដ្ឋាភិបាល អាល្លឺម៉ង់ និង ទីភ្នាក់ងារ របស់ ខ្លួន ដែល បាន ក ជួយ ជ្រួមជ្រែង ក្នុង ចង្កោម សកម្មភាព របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
បន្ថែម ពី នេះ លោក រដ្ឋមន្ត្រី បាន បង្ហាញ ពី គោល នយោបាយ និង ចក្ខុវិស័យ របស់ ក្រសួង ក៏ ដូចជា រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង អាណត្តិ ទី ៧នេះ ដែល បាន យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ វិស័យ ការងារ សន្តិសុខ សង្គម និង ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ក្នុង គោលបំណង ធ្វើឱ្យ ប្រសើរឡើង នូវ បរិយាកាស ការងារ និង ទំនាក់ទំនង វិជ្ជាជីវៈ និង ការបំពាក់ ជំនាញ ស្តង់ដារ ដែល មាន ការទទួលស្គាល់ ពី ទីផ្សារ ដល់ ប្រជាពលរដ្ឋ កម្ពុជា ឱ្យ ក្លាយជា កម្លាំង ចលករ សេដ្ឋកិច្ច ដ៏ សកម្ម និង មាន ផលិតភាព ការងារ ខ្ពស់ ។
បន្ថែម ពី នេះ លោក រដ្ឋមន្ត្រី ក៏ បាន ជម្រាប ឯក អគ្គ រដ្ឋទូត អាល្លឺម៉ង់ ពី គម្រោង បណ្តុះបណ្តាល យុវជន មក ពី គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ចំនួន ១. ៥លាន នាក់ ដែល ជា កម្មវិធី ថ្នាក់ ជាតិ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច មហា បវរធិបតី ជា ប្រមុខ ដើម្បី អាច ជួយ ពលរដ្ឋ ដែល ស្ថិត ក្នុង ស្ថានភាព លំបាក នេះ អាច មាន ជំនាញ ជាក់លាក់ ហើយ ទទួលបាន ការងារ ធ្វើ សមរម្យ ដែល ទីផ្សារ ទទួលស្គាល់ ។
យ៉ាងណា ក៏ដោយ មុននឹង បញ្ចប់ លោក រដ្ឋមន្ត្រី បាន ស្នើ ឱ្យ អាល្លឺម៉ង់ បន្ត និង បង្កើន កិច្ចសហប្រតិបត្តិការ លើ ការវិស័យ ការងារ សន្តិសុខ សង្គម និង ការបណ្តុះបណ្តាល បច្ចេកទេស បន្ថែម ទៀត ដើម្បី កំណើន សេដ្ឋកិច្ច និង ការអភិវឌ្ឍ នៅ កម្ពុជា ៕
សហរដ្ឋ អាមេរិក បាន ណែនាំ អ៉ី ស្រាអែល ឲ្យ បញ្ឈប់ ផែនការធ្វើ សង្រ្គាម ជើង គោក ហើយ ព្យាយាម សម្រុះសម្រួល ឲ្យ មាន ការដោះលែង ចំណាប់ខ្មាំង ជាង ២០០ នាក់ ដែល ត្រូវ ចាប់ ឃុំ ខ្លួន នៅក្នុង តំបន់ ហ្គាហ្សា ។ នៅឯ អង្គការ សហ ប្រជាជាតិ សហរដ្ឋ អាមេរិក និង រុស្ស៉ី បាន ដាក់ ផែនការនាំយក ជំនួយ មនុស្សធម៌ សម្រាប់ ជន ស៉ី វិល ប៉ាឡេស្ទីន ដោយ ទីក្រុង វ៉ាស៊ីនតោន អំពាវនាវ ឲ្យ ផ្អាក ការប្រយុទ្ធ គ្នា ចំណែក រុស្ស៊ី ចង់បាន បទ ឈប់ បាញ់ មនុស្សធម៌ ។
វេទិកា នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក បណ្ឌិត សភាចារ្យ សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា និង មាន ការចូលរួម ពី លោក បណ្ឌិត គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា ជា ស្ថានិក វេទិកា ភ្នំពេញ រួមទាំង មាន វា គ្មិន ដែល ជា អ្នកជំនាញ និង អ្នកសិក្សា ស្រាវជ្រាវ ចូលរួម ប្រមាណ ជិត ១០០ នាក់ ផងដែរ ។
លោក បណ្ឌិត គិន ភា បាន ឱ្យដឹង ថា វេទិកា ភ្នំពេញ នេះ ក៏ នឹង ត្រួសត្រាយ ផ្លូវ ពហុ វិមាត្រ ដើម្បី បង្កើន ឥទ្ធិពល អន្តរជាតិ នៃ អ្នកចូលរួម តាមរយៈ ការកំណត់ របៀបវារៈ ដែល លើកកម្ពស់ ការប្រឌិត កំណែទម្រង់ ន វានុវត្តន៍ នៃ អភិបាលកិច្ច អន្តរជាតិ ការបង្កើត អត្តសញ្ញាណ បញ្ញត្តិកម្ម ការប្រឈមមុខ ដាក់ គ្នា ទៅ វិញ ទៅ មក ចំពោះ ទ្វេ គ្រោះ សន្តិសុខ ប្រពៃណី និង មិន មែន ប្រពៃណី នា ពេល អនាគត និង ការដោះស្រាយ ប្រកបដោយ ភាពស្វាហាប់ នូវ បញ្ហា លេចធ្លោ ជាច្រើន សម្រាប់ ការអភិវឌ្ឍ ក្នុង តំបន់ និង បញ្ហា ប្រឈម ជា សាកល ។
វេទិកា ភ្នំពេញ មាន គោលបំណង ដូចត ទៅ៖
វេទិកា ភ្នំពេញ ត្រូវបាន ប្រារព្ធ ឡើង ជារៀងរាល់ ឆ្នាំ ក្នុង ទម្រង់ និង កម្មវិធី ផ្សេង ៗ គ្នា រួមទាំង វេទិកា បណ្ឌិត សភា សន្និសីទ សិក្ខាសាលា និង កម្មវិធី បណ្តុះបណ្តាល ។ នៅ ឆ្នាំ នេះ វេទិកា ភ្នំពេញ លើក ទី២ នឹង រៀបចំឡើង នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ ក្រោម ប្រធានបទ « អប្បភាគី និយម៖ មជ្ឈភាព អាស៊ាន និង ការប្រកួតប្រជែង មហា អំណាច » ។
វេទិកា ភ្នំពេញ លើក ទី២ មាន គោលបំណង ដូច ខាងក្រោម៖
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រសួង លោក លី សុវណ្ណា រិទ្ធ អភិបាល រង នៃ គណៈអភិបាល ខេត្ត បន្ទាយមានជ័យ លោក លោកស្រី ប្រធាន អនុប្រធាន មន្ទីរ ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ខេត្ត ចំនួន ៧ រួម មាន ខេត្ត បន្ទាយមានជ័យ ខេត្ត ប៉ៃលិន ខេត្ត កំពង់ឆ្នាំង ខេត្ត ពោធិ៍សាត់ ខេត្ត បាត់ដំបង ខេត្ត សៀមរាប និង ខេត្ត ឧត្តរមានជ័យ ព្រមទាំង សាខា ប្រតិបត្តិករ ផ្តល់ សេវា ប្រៃសណីយ៍ និង ក្រុមហ៊ុន ផ្ដល់ សេវា អ៉ីនធឺណិត (ISP) សរុប ប្រមាណ ៧០ រូប ។
ថ្លែង ក្នុង ឱកាស នោះ លោក រដ្ឋលេខាធិការ ខាយ ឃុន ហេង បាន មានប្រសាសន៍ ថា សិក្ខាកាម ដែល បាន ចូលរួម នៅ ថ្ងៃ នេះ គឺជា សកម្មជន ជា ចលករ ចូលរួម បញ្ចប់ ជំងឺ អេដស៍ និង ទប់ស្កាត់ ការប្រើប្រាស់ ជួញដូរ និង ចរាចរណ៍ គ្រឿងញៀន ក្នុង ការត្រួតពិនិត្យ និង រិត បន្តឹង ការទទួល កញ្ចប់ បញ្ញើ ដែល ក្រុមហ៊ុន របស់ ខ្លួន កំពុងតែ បម្រើ សេវា លើ បញ្ញើ ប្រៃសណីយ៍ ព្រមទាំង បាន ស្នើ ដល់ លោក លោកស្រី ជា តំណាង ប្រតិបត្តិករ ប្រៃសណីយ៍ ត្រូវ យក ចំណេះដឹង នេះ ដើម្បី បន្ត គាំទ្រ សកម្មភាព ជួយ សង្គម តាម ការផ្សព្វផ្សាយ ចែករំលែក បន្ត ។
ស្រប ជាមួយគ្នា នេះ លោក រដ្ឋលេខាធិការ បាន ថ្លែងអំណរគុណ ដល់ វា គ្មិន ដែល បាន ចំណាយ ពេល ក្នុង ការចែករំលែក នូវ ចំណេះដឹង និង បទពិសោធន៍ ថ្មី ៗ ពាក់ ពន្ធ័ នឹង ជំងឺ អេដស៍ និង គ្រឿងញៀន ជូន សិក្ខាកាម ជា មន្ត្រីរាជការ មកពី មន្ទីរ ប. ទ. ខេត្ត សាខា ប្រតិបត្តិករ ផ្តល់ សេវា ប្រៃសណីយ៍ និង ក្រុមហ៊ុន ផ្ដល់ សេវា អ៉ិនធើណិត ដើម្បី សហការ និង អនុវត្ត ឱ្យ មាន ប្រសិទ្ធភាព ផងដែរ ៕
ព្រឹក ថ្ងៃ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ជាង ១.២ម៉ឺន នាក់ នៅ ខេត្ត កំពង់ចាម
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ប្រមាណ ១២ ០៦០ នាក់ នៅ បណ្តា រោងចក្រ សហគ្រាស ចំនួន ១៤ ដែល មាន មូលដ្ឋាន នៅក្នុង ស្រុក ព្រៃឈរ និង ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម ។
រោងចក្រ សហគ្រាស ទាំង ១៤នេះ ជា ប្រភេទ រោងចក្រ កាត់ដេរ សម្លៀកបំពាក់ ចំនួន ៧ រោងចក្រ ដេរ ស្បែកជើង ចំនួន ៥ រោងចក្រ បោះពុម្ព លើ សម្លៀកបំពាក់ ចំនួន ១ និង រោងចក្រ តម្បាញ ចំនួន ១ ។ នេះ គឺជា លើក ទី៦ ហើយ ដែល សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត តាម បណ្តា រោងចក្រ សហគ្រាស នានា ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្រោយពេល រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ ត្រូវបាន បង្កើតឡើង កាលពី ខែសីហា ឆ្នាំ ២០២៣ ។
ស្រវឹង សូម កុំ បើកបរ ! ស្លាប់ ៣នាក់ និង របួស ៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៤ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ៥នាក់ ។
ក្នុង សប្តាហ៍ នេះ អ្នកសារព័ត៌មាន មកពី ប្រទេស សមាជិក អាស៊ាន ចំនួន ៨ រួម មាន កម្ពុជា ថៃ ឡាវ ហ្វីលីពីន ម៉ាឡេស៊ី ឥណ្ឌូនេស៊ី វៀតណាម និង មីយ៉ាន់ម៉ា ត្រូវបាន រៀបចំ បំពេញ ទស្សនកិច្ច នៅ ខេត្ត ក្វាង ស៊ី ដើម្បី បង្ហាញ ពី ការអភិវឌ្ឍ ឧស្សាហកម្ម និង ទេសចរណ៍ របស់ ខេត្ត ។
សារ មន្ទីរ ស្គរ មិន ត្រឹមតែ ជាសារមន្ទីរ ប្រមូលផ្តុំ និង សិក្សា ពី វប្បធម៌ របស់ ជនជាតិ ភាគ តិច នោះ ទេ សារមន្ទីរ នេះ ក៏ ជា ទីតាំង តែ មួយ គត់ ដែល មាន នូវ ស្គរ ស្ពាន់ តំណាង នូវ អំណាច ច្រើន ជាង គេ ក្នុង ពិភពលោក ។
តាមរយៈ ការប្រារព្ធ ខួប ៥០ ឆ្នាំ នៃ តំបន់ ស្វយ័ត ជនជាតិ ជួង ខេត្ត ក្វាង ស៊ី កាលពី ឆ្នាំ ២០០៨ រដ្ឋាភិបាល ចិន បាន អនុញ្ញាតឱ្យ សង់ សារមន្ទីរ ជនជាតិ ភាគ តិច របស់ ចិន ដ៏ ធំ មួយចំ កណ្តាល ក្រុង ណាន នីង ក្វាង ស៊ី ដើម្បី បើក ឱ្យ ទេសចរ ជាតិ និង អន្ដរជាតិ ចូល ទស្សនា ដោយ ឥត គិត ថ្លៃ ព្រមទាំង បាន ស្វែងយល់ នូវ វប្បធម៌ អរិយធម៌ របស់ ជនជាតិ ភាគ តិច ពាក់ព័ន្ធ នឹង ការប្រើប្រាស់ ស្គរ តំណាង នា សម័យ នោះ ។
សារ មន្ទីរ ស្គរ យក្ស នេះ ស្ថិត នៅលើ មាត់ ទន្លេ យ៉ុង យ៉ាង ខាងត្បូង ភ្នំ ឈីង ស៊ូសង់ លើ ផ្ទៃដី ជាង ៨.៦៦៧ ម៉ែត្រ ការ៉េ និង មាន អគារ ៤ជាន់ ហើយ ត្រូវបាន បើក ដំណើរការ ជា ផ្លូវការ នៅ ឆ្នាំ ២០០៩ ។ គោលបំណង ចម្បង នៃ សារមន្ទីរ ស្គរ យក្ស មួយេ នះ គឺ ប្រមូលផ្តុំ សិក្សា អភិរក្ស និង ផ្សព្វផ្សាយ ពី វប្បធម៌ របស់ ជនជាតិ ភាគ តិច ចំនួន ១២អម្បូរ ដែល រស់ នៅ ប្រទេស ចិន ប៉ែក អាស៊ី ភាគ អាគ្នេយ៍ ។
នៅ សារមន្ទីរ នេះ បាន បង្ហាញ ស្គរ ស្ពាន់ ដ៏ ចំណាស់ ដែល ខ្លះ មាន អាយុកាល តាំងពី សតវត្សរ៍ ទី១ នៃ គ.ស ដល់ សតវត្សរ៍ ទី ៤ ទៅ ៧។ ស្គរ ត្រូវបាន ប្រជាពលរដ្ឋ ចិន ចាត់ទុក ជា តំណាង ដ៏ សំខាន់ របស់ មេ កន្ទ្រាញ និង មេដឹកនាំ ប្រើ ដើម្បី នាំ នូវ ភាពជោគជ័យ ។ ស្គរ ក្នុង សាល ពិព័រណ៍ មាន ក្បូរ ក្បាច់ រចនា ផ្សេង ៗ គ្នា និង មាន អត្ថន័យ ខុស ៗ ពី គ្នា ក្នុង នោះ ជនជាតិ ជួង ក៏ បាន ឆ្លាក់ រូប កង្កែប នៅលើ ស្គរ ដែល ជា និមិត្តរូប មួយ បង្ហាញ ថា សត្វ កង្កែប ជា សត្វ ស្លូត ល្អ និង នាំ សំណាង គឺ ទឹកភ្លៀង ដ៏ ត្រជាក់ ត្រជុំ ។
វិថី ទេសចរណ៍ នៅ កណ្តាល ក្រុង ណាន នីង នេះ ទទួលបាន ការចាប់អារម្មណ៍ ខ្ពស់ សម្រាប់ អ្នកទេសចរ ក្នុង ស្រុក ទៅ ដើរលេង កម្សាន្ត ។ តំបន់ ទេសចរណ៍ មួយ នេះ មាន ប្រវត្ត ជាប់ទាក់ទង ជាមួយ រជ្ជកាល នៃ ព្រះចៅ អធិរាជ របស់ ចិន ជាច្រើន រួម មាន រជ្ជកាល សុង រជ្ជកាល ឈីង និង រជ្ជកាល ហាន ផងដែរ ។
វិថី ទេសចរណ៍ មួយ នេះ ទទួលបាន ការចាប់អារម្មណ៍ មក លេង កម្សាន្ត មិន មែន តែ យុវវ័យ ប៉ុណ្ណោះ ទេ តែ មនុស្ស វ័យ ចំណាស់ ក៏ បាន មក លេង កម្សាន្ត នៅ តំបន់ នេះ ផងដែរ ៕
រដ្ឋមន្ដ្រី ឈាង រ៉ា៖ គិត ត្រឹម ខែកញ្ញា ឆ្នាំ ២០២៣ មូលដ្ឋាន សុខាភិបាល សាធារណៈ ចំនួន ១. ៣៦០ កន្លែង កំពុង បម្រើ សេវា សុខាភិបាល ជូន ពលរដ្ឋ នៅ ទូទាំង ប្រទេស
( ភ្នំពេញ ) ៖ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន ថ្លែង ថា មូលនិធិ សមធម៌ សុខាភិបាល សម្រាប់ គ្រួសារ ក្រីក្រ ចាប់ផ្តើម អនុវត្ត ដំបូង នៅ ឆ្នាំ ២០០០ ហើយ ត្រូវបាន ពង្រីក ជា បន្តបន្ទាប់ រហូតដល់ គ្រប់ មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ បង្អែក ទូទាំង ប្រទេស នៅ ឆ្នាំ ២០១៥ ហើយ បើ គិត ត្រឹម ខែកញ្ញា ឆ្នាំ ២០២៣ មូលដ្ឋាន សុខាភិបាល សាធារណៈ មាន ចំនួន ១. ៣៦០ កន្លែង ។
ការថ្លែង ដូច្នេះ របស់ លោក រដ្ឋមន្ដ្រី ក្នុង ឱកាស សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ « មន្ទីរពេទ្យ ជាតិ តេជោ សន្តិភាព » និង ប្រកាស ដាក់ ឱ្យ អនុវត្ត ជា ផ្លូវការ នូវ កម្មវិធី ទី១ នៃ គោល នយោបាយ ជា អាទិភាព ទាំង៦ គឺ « ការពង្រីក វិសាលភាព មូលនិធិ សមធម៌ ដល់ គ្រួសារ ងាយ រង ហានិភ័យ » ក្រោម អធិបតីភាព សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃអង្គារ ទី២៤ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
លោក សាស្ដ្រាចារ្យ រដ្ឋមន្ដ្រី បន្ដ ថា មូលដ្ឋាន សុខាភិបាល សាធារណៈ មាន ចំនួន ១. ៣៦០ កន្លែង ដែល កំពុង អនុវត្ត នៅ មណ្ឌល សុខភាព / មណ្ឌល សុខភាព មាន គ្រែ ១. ២៣៦ កន្លែង មន្ទីរពេទ្យ បង្អែក ក្រុង / ស្រុក / ខណ្ឌ ៩២ កន្លែង មន្ទីរពេទ្យ រាជធានី - ខេត្ត ២៥កន្លែង និង មន្ទីរពេទ្យ ជាតិ ៧កន្លែង ។
រវាង ឆ្នាំ ២០១៨ - ឆ្នាំ ២០២២ គ្រួសារ ក្រីក្រ ដែល គាំពារ ដោយ មូលនិធិ សមធម៌ សុខាភិបាល បាន មក ប្រើប្រាស់ សេវា ពិគ្រោះ ជំងឺ ក្រៅ សរុប ចំនួន ១៤.១៦៤ .១៣១ ករណី និង សម្រាក ពេទ្យ សរុប ចំនួន ៨១៤. ៦៦៥ ករណី ។ ដោយឡែក ពី ខែមករា ដល់ ខែកញ្ញា ឆ្នាំ ២០២៣ គ្រួសារ ក្រីក្រ គាំពារ ដោយ មូលនិធិ សមធម៌ សុខាភិបាល បាន មក ប្រើប្រាស់ សេវា ពិគ្រោះ ជំងឺ ក្រៅ សរុប ១.៧៦១ . ៣៣៧ ករណី និង នៅ មន្ទីរពេទ្យ សម្រាក ព្យាបាល សរុប ១៤៥. ៧០៨ ករណី ។ ការសម្រាល កូន មាន ចំនួន ១៥. ៦០៦ នាក់ នៅ មណ្ឌល សុខភាព និង ១៤.២៧២ នាក់ ទៀត នៅ មន្ទីរពេទ្យ ។
ក្នុង ឱកាស នោះ លោក សាន វិជ្ជា សារ៉ា វុធ បាន លើកឡើង ថា ការចុះអប់រំ ផ្សព្វផ្សាយ នេះ គឺ ដើម្បី បញ្ជ្រាប ចំណេះដឹង បន្ថែម អំពី គុណភាព សុវត្ថិភាព ម្ហូប អាហារ ដល់ អ្នកប្រើប្រាស់ ដើម្បី ជ្រើសរើស យក ចំណីអាហារ ណា ដែល ល្អ សម្រាប់ បរិភោគ ឱ្យ មាន លក្ខណៈ ស្តង់ដារ ហើយ ជា ចំណី អាហារ ច្បាស់លាស់ ប្រកបដោយ គុណភាព ។
ទន្ទឹម នោះ នា ពេល បច្ចុប្បន្ន នេះ ចំណីអាហារ កាន់តែ មាន កើនឡើង ហើយ ការបង្រ្កាប ពីសំណាក់ មន្រ្តី ជំនាញ នៅតែ បន្ត អនុវត្ត យ៉ាង សស្រាក់សស្រាំ សំដៅ បង្កើន ការ ការពារ ដល់ សុខភាព អ្នកប្រើប្រាស់ និង ជៀសវាង ការប្រើប្រាស់ ចំណីអាហារ ណា ដែល ហួស សុពលភាព និង គ្មាន កាលបរិច្ឆេត ច្បាស់លាស់ ដែល នាំឱ្យ ប៉ះពាល់ ដល់ សុខុមាលភាព សាធារណៈ ។
លោក សាន វិជ្ជា សារ៉ា វុធ គូសបញ្ជាក់ ថា តាម ផែនការ ដែល បាន គ្រោង ទុក មន្ត្រី សាខាក .ប. ប ខេត្ត បាន បន្ត ចុះ ធ្វើ ការអប់រំ ផ្សព្វផ្សាយ និង ធ្វើ បទបង្ហាញ ដោយ ផ្ទាល់ ជាមួយ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ស្តីពី សុវត្ថិភាព ម្ហូប អាហារ ចាប់តាំងពី មេត្តេយ្យ សិក្សា ដល់ ឧត្តម សិក្សា និង អ្នកលក់ដូរ ក្នុង សាលារៀន ទូទាំង ខេត្ត ត្បូងឃ្មុំ ទាំងមូល ដោយ យ៉ាងតិច ២ លើក ក្នុង ០១ខែ រៀងរាល់ ខែ ។
សូម ជម្រាប ជូន ថា ក្នុង សកម្មភាព នៅ វិទ្យាល័យ កណ្តោល ជ្រុំ នោះ មន្ត្រី ជំនាញ បាន ធ្វើ បទបង្ហាញ ដល់ សិស្សានុសិស្ស ពាក់ព័ន្ធ ផ្ទាំង រូបភាព លើ ផលិតផល ទំនិញ នានា ជាច្រើន មុខ និង ការជ្រើសរើស ទំនិញ ដែល មាន គុណភាពល្អ ដើម្បី យក ទៅ ប្រើប្រាស់ ជៀសវាង ការទិញ ទំនិញ ដែល គ្មាន គុណភាព ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ ដែល បង្ក ទុក្ខ ទោស ដល់ សុខភាព អ្នកប្រើប្រាស់ ៕
កាកបាទ ក្រហម កម្ពុជា ទទួល ទេយ្យទាន គ្រឿង ឧបភោគ - បរិភោគ សម្ភារៈ ប្រើប្រាស់ និង បច្ច័យ ពី ព្រះចៅ អធិការ វត្ត មណិរតនា រាម ( ទួល ទំពូង )
ក្នុង ឱកាស នោះ លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា និង សហការី មន្ត្រី អនុសាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ចំការមន ក្រុម កាកបាទ ក្រហម កម្ពុជា សង្កាត់ ទាំង ៦ នៃ ខណ្ឌ ចំការមន ព្រមទាំង ពុទ្ធ បរិស័ទ បាន អញ្ជើញ បូជា សក្ការៈ ថ្វាយ ចំពោះ ព្រះរតនត្រ័យ និង នមស្ការ សង្ខេប ទៅ តាម គន្លង ប្រពៃណី ព្រះពុទ្ធ សាសនា ។
បន្ទាប់ពី បាន ធ្វើ បទន មស្ការ សង្ខេប ចប់ សព្វគ្រប់ ហើយ ព្រះវិន័យ វង្សា ស៊ា ប៊ុន ណាត បាន មាន ថេរ ដិ កាស្វាគមន៍ ចម្រើន ពរ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន បាន អនុញ្ញាតឱ្យ ព្រះសង្ឃ និង ពុទ្ធ បរិស័ទ បាន ចូលរួមចំណែក ធ្វើ សង្គហ ទាន រួមគ្នា ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដែល ជា ស្ថាប័ន មនុស្សធម៌ ធំ ជាង គេ បំផុត នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ដើម្បី ជួយ សម្រាល ការលំបាក ដល់ ប្រជាពលរដ្ឋ ដែល ត្រូវការ ឱ្យ ជួយ ជា ចាំបាច់ ។
ជាមួយគ្នា នេះ លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែងអំណរ ព្រះគុណ និង អរគុណ ចំពោះ ទឹក ព្រះទ័យ និង ទឹកចិត្ត ជ្រះថ្លា របស់ ព្រះសង្ឃ គណៈកម្មការ វត្ត និង ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ទួល ទំពូង ទាំងអស់ ដែល បាន ចែករំលែក នូវ ទេយ្យ ទាន ទាំងអស់ នេះ មក ជូន កាកបាទ ក្រហម កម្ពុជា សម្រាប់ បន្ត ចែកជូន ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ និង ងាយ រងគ្រោះ បំផុត ។
តាមរយៈ អំណាច នៃ បុណ្យ ដែល បាន ធ្វើ នៅ ថ្ងៃ នេះ លោកស្រី បាន បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ វត្ថុ ស័ក្តិសិទ្ធ ទាំងអស់ ក្នុង លោក ប្រោស ព្រំ ផ្តល់ នូវ ពរ ជ័យ សិរី សួស្តី សូម ឱ្យ ព្រះរាជាណាចក្រ កម្ពុជា បន្ត ស្ថិត នៅក្នុង សុខ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ជានិច្ច និង សូម បួងសួង ដល់ ព្រះសង្ឃ គ្រប់ ព្រះអង្គ សូម មាន ព្រះសុខភាព ល្អ ព្រះជន្មាយុ យឺន យូរ ដើម្បី បន្ត ទ្រទ្រង់ វិស័យ ព្រះពុទ្ធ សាសនា ឱ្យ បាន គង់វង្ស រីកចម្រើន ត រៀង ទៅ ។
ជំនួប នេះ បាន ពិភាក្សា លើ លទ្ធភាព និង ឱកាស ក្នុង ការចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល របស់ ក្រុមហ៊ុន លើ ការអភិវឌ្ឍ វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ និង ដឹកជញ្ជូន ដើម្បី ជា ការឆ្លើយតប ទៅនឹង តម្រូវការ និង ស្រប តាម យុទ្ធសាស្រ្ត បញ្ចកោណ - ដំណាក់កាល ទី១ ៕
ខណៈ អ៉ី ស្រាអែល មាន ការស្ទាក់ស្ទើរ ប្រទេស កាតា ឯណោះ វិញ បាន និង កំពុង ដើរ តួនាទី ជា អ្នកសម្របសម្រួល និង បាន ចូលរួម ជាមួយ អេហ្ស៉ី ប ក្នុង ការចូលរួម ចំណែក នាំឱ្យ មាន ការដោះលែង ចំណាប់ខ្មាំង ៤នាក់ ខាងលើ ។
អភិបាល ខេត្ត កែប ណែនាំ ឱ្យ សិស្សានុសិស្ស ត្រូវ ព្យាយាម ខិតខំ បង្កើន នូវ សមត្ថភាព និង លទ្ធភាព ដើម្បីឲ្យ ដល់ គោលដៅ នៃ បំណងប្រាថ្នា របស់ ខ្លួន
( កែប )៖ លោក បណ្ឌិត សោម ពិសិដ្ឋ អភិបាល ខេត្ត កែប បាន ណែនាំ សិស្សានុសិស្ស ធ្វើ យ៉ាងណា ត្រូវ ខិតខំ បង្កើន នូវ សមត្ថភាព និង លទ្ធភាព បន្ត ទៀត ដើម្បីឲ្យ ដល់ គោលដៅ នៃ បំណងប្រាថ្នា របស់ ក្មួយ ៗ ហើយ ត្រូវ ខិតខំ ព្យាយាម យកចិត្តទុកដាក់ សិក្សា រៀនសូត្រ ដើម្បី ឈាន ទៅ ទទួលបាន និទ្ទេស ល្អ ក្នុង ការប្រឡង ចូល ថ្នាក់ អនុវិទ្យាល័យ ។
ការណែនាំ បែប នេះ របស់ លោក អភិបាល ខេត្ត បាន ធ្វើឡើង ពិធី ប្រកាស លទ្ធផល សិស្ស ពូកែ កម្រិត បឋមសិក្សា ពានរង្វាន់ អភិបាល ខេត្ត កែប នា ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នៅ សាល ប្រជុំ សាលា ខេត្ត កែប ។
លោក សោម ពិសិដ្ឋ បាន កោតសរសើរ និង ថ្លែងអំណរគុណ លោកគ្រូ អ្នកគ្រូ អាណាព្យាបាល ព្រមទាំង ក្មួយ ៗ សិស្សានុសិស្ស ដែល បាន ខិតខំ យកចិត្តទុកដាក់ ក្នុង ការសិក្សា រៀនសូត្រ រហូត ទទួលបាន លទ្ធផល នា ថ្ងៃ នេះ ជាពិសេស ក្មួយ ៗ ដែល បាន ប្រឡង ជាប់ ចំណាត់ថ្នាក់ និង ទទួលបាន ជ័យលាភី នេះ គឺជា កិត្តិយស ណាស់ សម្រាប់ ខ្លួន ឯង ក្រុមគ្រួសារ របស់ ក្មួយ ៗ ក៏ ដូចជា ខេត្ត កែប យើង ផងដែរ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ការបង្កើត កម្មវិធី នេះ ឡើង ក្នុង គោលបំណង បណ្តុះ ស្មារតី ផ្នត់គំនិត របស់ កុមារ ឲ្យ ស្រលាញ់ ការសិក្សា រៀនសូត្រ តាំងពី ថ្នាក់ បឋមសិក្សា នេះ ទៅ ដើម្បី ជា ត្រី វិស័យ សម្រាប់ ពួកគេ ទៅ ថ្ងៃ ខាងមុខ ហើយ ពានរង្វាន់ នេះ យើង បាន រៀបចំ ចំនួន ២លើក ហើយ រាប់ ទាំង ឆ្នាំ នេះ ផងដែរ ។
លោក ខេង យ័ន អភិបាល ក្រុង កែប បាន ឲ្យដឹង ថា ការប្រឡង ប្រជែង ដណ្តើម ជ័យលាភី សិស្ស ពូកែ កម្រិត បឋមសិក្សា ថ្នាក់ ទី៥ និង ទី៦ ត្រូវបាន រៀបចំឡើង តាម ការជូនដំណឹង របស់ រដ្ឋបាល ក្រុង កែប ក្នុង នោះ មាន ការចូលរួម ពី គ្រឹះស្ថាន បឋមសិក្សា សាធារណៈ ចំនួន ៩ ទូទាំង ក្រុង កែប ដែល បាន រៀបចំឡើង លើក ទី២ កាលពី ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០២៣ ដោយ មាន វិញ្ញាសារ ប្រលង ចំនួន ០៤ រួម មាន ភាសា ខ្មែរ គណិតវិទ្យា ភាសា អង់គ្លេស និង វប្បធម៌ ទូទៅ ។
បេក្ខជន ដែល បាន ចូលរួម ប្រលង សរុប ចំនួន ៦៦ នាក់ ស្រី ៤៨ នាក់ ក្នុង នោះ សិស្ស ថ្នាក់ ទី៥ សរុប ចំនួន ៣៣ នាក់ ស្រី ២៦ នាក់ និង សិស្ស ថ្នាក់ ទី៦ សរុប ចំនួន ៣៣ នាក់ ស្រី ២២ នាក់ ។ ចំពោះ សិស្សានុសិស្ស ដែល ទទួលបាន ជ័យលាភី ពី លេខ១ ដល់ លេខ ៥ ទទួលបាន ថវិកា និង សម្ភារ សិក្សា មួយចំនួន ធំ ពី លោក អភិបាល ខេត្ត ។
គួរ បញ្ជាក់ ថា ជ័យលាភី សិស្ស ពូកែ ថ្នាក់ បឋមសិក្សា មកពី ជុំវិញ ក្រុង កែប ក្នុង នោះ សិស្ស ចំនួន ១០នាក់ ទទួលបាន ពាន និង រង្វាន់ លើកទឹកចិត្ត ពី លោក បណ្ឌិត សោម ពិសិដ្ឋ អភិបាល ខេត្ត កែប ៕
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៨ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៣ នាក់ របួស ចំនួន ០៥ នាក់ ( របួស ធ្ងន់ ចំនួន ០៥ នាក់ ) ។ រយៈពេល ២៤ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ២៣៨ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១១៧ នាក់ របួស ៣១២ នាក់ ( របួស ធ្ងន់ ១៨៧ នាក់ )៕
