( រតនគិរី ) ៖ លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ចែក វិញ្ញាបនបត្រ សម្គាល់ អចលន វត្ថុ នៅ ភូមិ ថ្ម ដា សង្កាត់ បឹង កន្សែង ក្រុង បាល លុង ប្រមាណ ជាង ១ ពាន់ វិញ្ញាបនបត្រ ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ មេបញ្ជាការ កងកម្លាំង ទាំង៣ លោក - លោកស្រី ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព និង អាជ្ញាធរ ក្រុង បាន លុង ព្រមទាំង មន្ត្រីរាជការ ពាក់ព័ន្ធ ជាច្រើន រូប ផងដែរ ។
ជាមួយគ្នា នេះ រាជ រដ្ឋ ភិបាល ក៏ បាន ដាក់ចេញ នូវ វិធានការ ទប់ស្កាត់ ការចូលកាន់កាប់ ដី រដ្ឋ ដោយ ខុស ច្បាប់ និង បន្ត ពិនិត្យ ធ្វើ ប្រទាន កម្ម ជូន ប្រជាពលរដ្ឋ ដែល រស់ នៅ និង អាស្រ័យ ផល ជាក់ស្ដែង ព្រមទាំង ការជំរុញ ការ ដោះស្រាយ វិវាទ ដីធ្លី ក្រៅ ប្រព័ន្ធ តុលាការ ការដោះស្រាយ តាមរយៈ គណៈកម្មការ សុរិយោដី ថ្នាក់ ក្រុង ស្រុក ខេត្ត និង ថ្នាក់ ជាតិ ។
លោក បន្ត ថា កម្មវិធី នយោបាយ និង យុទ្ធសាស្ត្រ បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ក្រោម ការដឹកនាំ ដោយ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ការចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ ក៏ ត្រូវបាន កំណត់ ជា អាទិភាព ហើយ អាច ដំណើរការបាន ដោយ ជោគជ័យ អាស្រ័យ ដោយ មាន ការចូលរួម អនុវត្ត ពី អាជ្ញាធរ មូលដ្ឋាន បងប្អូន ប្រជាពលរដ្ឋ និង គ្រប់ ភាគី ដែល ពាក់ព័ន្ធ ។
សូម បញ្ជាក់ ថា វិញ្ញាបនបត្រ ដែល ធ្វើ ការចែកជូន ប្រជាពលរដ្ឋ ភូមិ ថ្ម ដា សង្កាត់ បឹង កន្សែង មាន ចំនួន ១.៣១០ វិញ្ញាបនបត្រ រួម មាន៖ ទី លំនៅឋាន ចំនួន ១. ២០៤ វិញ្ញាបនបត្រ ដី កសិកម្ម ចំនួន ៩៨ វិញ្ញាបនបត្រ ដី រដ្ឋ ចំនួន ០៦ វិញ្ញាបនបត្រ ដី គណបក្ស ចំនួន ០១ វិញ្ញាបនបត្រ ដី សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត រតនគិរី ចំនួន ០១ វិញ្ញាបនបត្រ ៕
ប្រកាស ចូលកាន់ តំណែង លោក ឧត្តម នាវីទោ ម៉ី ឌីណា ជា មេបញ្ជាការ មូលដ្ឋាន សមុទ្រ ជំនួស ឧត្តម នាវីឯក អ៊ុក សីហា
( ភ្នំពេញ ) ៖ នាយ ឧត្តម នាវី ទៀ វិញ អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងទឹក និង ជា អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ ជាតិ សន្តិសុខ លម្ហ សមុទ្រ តំណាង នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង លោក ឧត្តម នាវីទោ ម៉ី ឌីណា ជា មេបញ្ជាការ មូលដ្ឋាន សមុទ្រ ជំនួស លោក ឧត្តម នាវីឯក អ៊ុក សីហា ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ នេះ ជា កម្រិត នៃ ការវិនិយោគ លក្ខណៈ យុទ្ធសាស្រ្ដ និង ប្រវត្តិសាស្រ្ដ សម្រាប់ កម្ពុជា ហើយ ជា សមិទ្ធផល ដែល មាន សារៈសំខាន់ ក្នុង ការពង្រឹង បន្ថែម នៃ ហេដ្ឋារចនាសម្ព័ន្ធ ចាំបាច់ សម្រាប់ សេដ្ឋកិច្ច កម្ពុជា ពិសេស វិស័យ ទេសចរណ៍ កម្ពុជា ។
ការលើកឡើង របស់ លោក រដ្ឋមន្ត្រី ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ចូលរួម ទទួល ជើងហោះហើរ ពាណិជ្ជកម្ម លើក ដំបូង មកកាន់ អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ នា ថ្ងៃទី ១៦ ខែតុលា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រចាំ ការ វង្សី វិស្សុត រដ្ឋមន្ត្រី ទទួលបន្ទុក ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ។
ក្នុង ឱកាស នោះ ដែរ លោក វង្សី វិស្សុត បាន ណែនាំ ដល់ ក្រសួង ទេសចរណ៍ ប្រឹងប្រែង ឱ្យ ពេល លទ្ធភាព ប្រើប្រាស់ អាកាសយានដ្ឋាន អន្ដរជាតិ សៀមរាប អង្គរ ដែល ទើប ដំណើរការ នេះ ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ មក កម្ពុជា កាន់តែ ច្រើន ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ ប្រគេន ទេយ្យ ទាន ថ្វាយ ព្រះសង្ឃ គង់ នៅ វត្ត និង អាស្រម ដែល មាន ការខ្វះខាត នៅ ខេត្ត សៀមរាប
( សៀមរាប ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោកជំទាវ ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត បាន ចាត់ តំណាង នាំ ទេយ្យ ទាន ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ត ចំនួន ៩ និង អាស្រម ចំនួន ២ ដែល សុទ្ធ ជា វត្ត និង អាស្រម មាន ការខ្វះខាត អំឡុង ពេល ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ ជាពិសេស វត្ត ដែល បើក សាលា ពុទ្ធិក បឋមសិក្សា មួយចំនួន ក្នុង ខេត្ត សៀមរាប ។
លោកស្រី ទូច សារ៉ុម បាន លើកឡើង ថា បច្ចុប្បន្ន វិស័យ ព្រះពុទ្ធ សាសនា បាន កំពុងតែ ល្បីរន្ទឺ នៅក្នុង ពិភពលោក ហើយ បណ្តា ប្រទេស ជឿនលឿន និង ប្រទេស កំពុង អភិវឌ្ឍ ក៏ មាន ភាពជឿជាក់ ថា ព្រះពុទ្ឋ សាសនា ធ្វើឲ្យ ប្រទេស រីកម្រើន ជឿនលឿន ជាពិសេស នៅ កម្ពុជា តែម្តង ។ ភាពល្បីល្បាញ និង ភាពរីកចម្រើន របស់ ព្រះពុទ្ធ សាសនា អាច ប្រព្រឹត្តទៅ បាន គឺ អាស្រ័យ ដោយ ប្រទេសជាតិ មាន សុខ សន្តិភាព បើ គ្មាន សុខ សន្តិភាព ទេ ក៏ គ្មាន ឱកាស អភិវឌ្ឍ ប្រទេស បាន រីកចម្រើន ដូច សព្វ ថ្ងៃ នេះ ឡើយ ។
គួរ ជម្រាប ថា ទេយ្យ ទាន ខាងលើ នោះ រួម មាន៖ អង្ករ ចំនួន ១៤០ ការុង ស្មើនឹង ៣.៥០០ គីឡូក្រាម និង មី ១៧៥ កេស ពោល គឺ ប្រគេន ទៅ តាម ចំនួន ព្រះសង្ឃ ជាក់ស្តែង នៅ តាម វត្ត និង អាស្រម នីមួយ ៗ ។ វត្ត ចំនួន ៧ និង អាស្រម ចំនួន ២នេះ ដែរ សុទ្ធ ជា វត្តមាន ការខ្វះខាត អំឡុង ពេល ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ ជាពិសេស វត្ត ដែល បើក សាលា ពុទ្ធិក បឋមសិក្សា មួយចំនួន ក្នុង ខេត្ត សៀមរាប ៕ ក្រសួង ការងារ៖ វិស័យ ចំនួន ៣ នៅក្នុង រាជធានី - ខេត្ត មួយចំនួន កំពុង ត្រូវការកម្លាំង ពលកម្ម ជិត ៤ម៉ឺន កន្លែង
អ៉ី ស្រាអែល កំពុង រៀបចំ ការធ្វើ សង្រ្គាម ជើង គោក នៅ តំបន់ ហ្កាហ្សា ដែល គ្រប់គ្រង ដោយ ក្រុមហា ម៉ាស់ បន្ទាប់ពី ការវាយប្រហារ កាលពី ថ្ងៃទី ៧ ខែតុលា របស់ ក្រុមហា ម៉ាស ប៉ាឡេ ស្ទីន ហើយ បាន និង កំពុង បន្ត ទម្លាក់ គ្រាប់បែក ពី អាកាស ។
គួរ បញ្ជាក់ ថា នៅក្នុង សេចក្តីព្រាង ដំណោះស្រាយ របស់ រុស្ស៉ី ក៏ អំពាវនាវ ឲ្យ មាន ការដោះលែង ចំណាប់ខ្មាំង ការទទួលបាន ជំនួយ មនុស្សធម៌ និង ការជម្លៀស ជន ស៉ី វិល ដោយ សុវត្ថិភាព ហើយ ថ្កោលទោស អំពើហិង្សា លើ ជន ស៉ី វិល និង អំពើ ភេរវកម្ម តែ មិន មាន សរសេរ ឈ្មោះ ក្រុមហា ម៉ាស នោះ ទេ ។
សេចក្តីព្រាង ដំណោះស្រាយ របស់ រុស្ស៉ី ទទួលបាន ការគាំទ្រ ចំនួន ៥សំឡេង ៤សំឡេង ប្រឆាំង និង អនុប្បវាទ ចំនួន ៦។ ដំណោះស្រាយ មួយ ត្រូវការ សំឡេង គាំទ្រ យ៉ាងតិច ៩ ហើយ គ្មាន ការវេតូ ដោយ សមាជិក អចិន្ត្រៃយ៍ ទាំង ៥គឺ សហរដ្ឋ អាមេរិក រុស្ស៉ី ចិន បារាំង និង អង់គ្លេស ដើម្បី អនុម័ត ៕ រូបភាព ពី Reuters គ.ជ. ប ផ្សព្វផ្សាយ ការយល់ដឹង ពី សារៈសំខាន់ នៃ ការបោះឆ្នោត ជូន បក្ស នយោបាយ អង្គការ មិន មែន រដ្ឋាភិបាល នាយក នាយក រង សាលា យុវជន និង អាជ្ញាធរ ភាគី ពាក់ព័ន្ធ នៅ ខេត្ត កំពត
( កំពត) ៖ នាយកដ្ឋាន បណ្តុះបណ្តាល និង អប់រំ អ្នកបោះឆ្នោត នៃ អគ្គ នាយកដ្ឋាន អប់រំ ព័ត៌មាន និង ទំនាក់ទំនង សាធារណៈ នៃ អគ្គ លេខាធិការដ្ឋាន គ.ជ. ប សហការ ជាមួយ លេខាធិការដ្ឋាន រៀបចំ ការបោះឆ្នោត ខេត្ត កំពត នៅ ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ វគ្គ អប់រំ ផ្សព្វផ្សាយ និង បញ្ជ្រាប ការយល់ដឹង ស្តីពី សារៈសំខាន់ នៃ ការបោះឆ្នោត ជូន ដល់ គណបក្ស នយោបាយ អង្គការ មិន មែន រដ្ឋាភិបាល នាយក នាយក រង សាលា យុវជន និង អាជ្ញាធរ ភាគី ពាក់ព័ន្ធ ក្នុង ស្រុក ឈូក ខេត្ត កំពត ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ម៉ុក ដារ៉ា អគ្គ លេខាធិការ រង គ.ជ.ប ។
លោក ម៉ុក ដារ៉ា បាន ថ្លែង ថា ការរៀបចំ វគ្គ អប់រំ ផ្សព្វផ្សាយ និង បញ្ជ្រាប ការយល់ដឹង ស្តីពី សារៈសំខាន់ នៃ ការបោះឆ្នោត នេះ ឡើង ក្នុង គោលបំណង រួម មាន៖
លោក បាន បង្ហាញ អំពី សារៈសំខាន់ នៃ ការបោះឆ្នោត ជាច្រើន ទៅកាន់ ភាគី ពាក់ព័ន្ធ ជាពិសេស យុវជន ដែល ជា ទំពាំង ស្នង ឫស្សី ឱ្យ បាន យល់ដឹង កាន់តែ ច្បាស់ ពី លទ្ធិ ប្រជាធិបតេយ្យ តាមរយៈ ការបោះឆ្នោត ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត នៅ ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន បើក កិច្ចប្រជុំ ជាមួយ ភាគី ពាក់ព័ន្ធ ពី ការចុះឈ្មោះ បោះឆ្នោត ឃុំ សង្កាត់ នៅ រដ្ឋសភា ការបញ្ជាក់ តាម ឋានានុក្រម និង បញ្ជូន មក គ.ជ. ប សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៥ ។
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក មាន សទិ សមាជិក គ.ជ. ប ព្រមទាំង មាន ការអញ្ជើញ ចូលរួម ពី តំណាង ស្ថានទូត ប្រចាំ កម្ពុជា . តំណាង ក្រសួង ស្ថាប័ន . តំណាង គណបក្ស នយោបាយ និង សមាគម អង្គការ មិន មែន រដ្ឋាភិបាល . ប្រព័ន្ធ ផ្សព្វផ្សាយ ព័ត៌មាន ជាតិ និង អន្តរជាតិ ។
មន្ត្រី ជាន់ ខ្ពស់ គ.ជ. ប រូប នេះ បាន ថ្លែង ថា សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥នេះ មណ្ឌល បោះឆ្នោត ត្រូវបាន រៀបចំ និង បែងចែក ជា ៨ភូមិភាគ ដែល មាន អាសនៈ សរុប ចំនួន ៥៨ ( បន្ថែម សមាជិក ព្រឹទ្ធសភា ចំនួន ២រូប ដែល ត្រូវបាន ចាត់តាំង ដោយ ព្រះមហាក្សត្រ និង ២រូប ទៀត ត្រូវបាន រដ្ឋសភា ជ្រើសតាំង តាម មតិ ភាគ ច្រើន ) ។
ជាមួយគ្នា នេះ ដែរ លោក បាន បន្ត ថា បញ្ជី ឈ្មោះ អ្នកបោះឆ្នោត ត្រូវបាន រៀបចំ នៅ តាម រាជធានី - ខេត្ត នីមួយ ៗ រួម មាន ក្រុមប្រឹក្សា ឃុំ សង្កាត់ និង តំណាងរាស្ត្រ នៃ រាជធានី - ខេត្ត នីមួយ ៗ ហើយ គ.ជ. ប ត្រូវ ធ្វើ ការបូកសរុប លទ្ធផល នៃ ការបោះឆ្នោត នៅ តាម មណ្ឌល នីមួយ ៗ នៃ មណ្ឌល ទាំង៨ នៅ ទូទាំង ប្រទេស ។
លោក មាន សទិ បាន បន្ថែម ថា ការចុះឈ្មោះ អ្នកបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ត្រូវ អនុវត្ត តាម របៀប ស្រង់ ឈ្មោះ អ្នក មាន សិទ្ធិ បោះឆ្នោត បញ្ចូល ទៅក្នុង បញ្ជី ឈ្មោះ ដោយឡែក ពី គ្នា ទៅ តាម អង្គ បោះឆ្នោត នីមួយ ៗ និង បញ្ជូន តាម លំដាប់ ឋានានុក្រម មក គ.ជ. ប ឱ្យ បាន តាម កាលបរិច្ឆេទ កំណត់ ។
ទន្ទឹមនឹង នេះ ដែរ លោក បាន ឱ្យដឹង ថា អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា ត្រូវ រៀបចំ បញ្ជី ឈ្មោះ តំណាងរាស្ត្រ ក្នុង តំណែង រួច អគ្គ លេខាធិការ រដ្ឋសភា ចុះហត្ថលេខា និង បោះ ត្រា អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា ដែល មាន ការបញ្ជាក់ ឯកភាព ពី ប្រធាន រដ្ឋសភា រួច បញ្ជូន មក គ.ជ. ប ឱ្យ បាន តាម កាលបរិច្ឆេទ កំណត់ ។ បញ្ជី ឈ្មោះ នេះ ត្រូវ រៀបចំ ដោយឡែក ពី គ្នា ទៅតាម តំណាងរាស្ត្រ ក្នុង តំណែង នៃ មណ្ឌល រាជធានី ខេត្ត នីមួយ ៗ ។
ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ត្រូវ រៀបចំ បញ្ជី ឈ្មោះ សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ទាំងអស់ ក្នុង តំណែង រួច ប្រធាន ក្រុមប្រឹក្សា ឃុំ សង្កាត់ និង ជា មេឃុំ ចៅសង្កាត់ ចុះហត្ថលេខា រួច បោះត្រា រដ្ឋបាល ឃុំ សង្កាត់ ដែល មាន ការបញ្ជាក់ ឯកភាព ពី អភិបាល ក្រុង ស្រុក ខណ្ឌ និង អភិបាល នៃ គណៈអភិបាល រាជធានី - ខេត្ត ពាក់ព័ន្ធ រួច បញ្ជូន មក គ.ជ. ប ឱ្យ បាន តាម កាលបរិច្ឆេទ កំណត់ ។
ថ្លែង ប្រាប់ អ្នកសារព័ត៌មាន ក្នុង ពិធី ស្វាគមន៍ ទទួល ជើងហោះហើរ ពាណិជ្ជកម្ម ដំបូង មកកាន់ អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ (SAI) នា ថ្ងៃទី ១៦ ខែតុលា ឆ្នាំ ២០២៣ នេះ លោក បាន ឱ្យដឹង ដឹង ថា សមិទ្ធផល ថ្មី នេះ គឺជា កាតាលីករ មួយ សំខាន់ ណាស់ ក្នុង ការជំរុញ ឱ្យ ចក្ខុវិស័យ របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ក្លាយជា កាពិត ក្នុង ការប្រែក្លាយ ខេត្ត សៀបរាម ដែល ធ្លាប់ ជា តំបន់ មាន ជម្លោះ មក ជា តំបន់ អភិវឌ្ឍន៍ និង រុងរឿង នា ថ្ងៃ ខាងមុខ ។
លោក បន្ត ថា អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ គឺជា កម្លាំង ទាញ សេដ្ឋកិច្ច មួយ ធំ ណាស់ ដោយ មិន ត្រឹមតែ លើកស្ទួយ វិស័យ ទេសចរណ៍ ប៉ុណ្ណោះ ទេ តែ អាចនឹង ផ្តល់ អត្ថប្រយោជន៍ សម្រាប់ វិស័យ កសិកម្ម វិស័យ បច្ចេកវិទ្យា និង វិស័យ ផ្សេង ទៀត ជាពិសេស ក៏ អាច ជា កន្លែង ដឹកជញ្ជូន ទំនិញ តាម ផ្លូវ អាកាស ដ៏ សំខាន់ ផងដែរ ព្រោះ ទំនិញ ឧស្សាហកម្ម មួយ ចំនួន ក៏ បាន ដឹកជញ្ជូន តាម ផ្លូវ អាកាស ផងដែរ ។
លោក បន្ថែម ថា ការបើក ដំណើរការ អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ក៏ ស្រប ជាមួយ គោល នយោបាយ បើក ចំហរ ជើង មេឃ ដែល បាន ដាក់ចេញ ដោយ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា កាលពី ពេល កន្លងមក ដោយ មិន គ្រប់គ្រង ឬ ការកំហិត នៃ ការហោះហើរ សម្រាប់ អ្នកណា ឡើយ ពោលគឺ អ្នកណា ក៏ដោយ ដែល ចង់ ធ្វើដំណើរ មក កម្ពុជា គឺ ត្រូវ អនុញ្ញាត បាន ទាំងអស់ ។ ការបើកចំហរ នេះ ទាក់ទាញ យ៉ាង ខ្លាំង សម្រាប់ វិស័យ ទេសចរណ៍ និង ការដឹកជញ្ជូន ទំនិញ ពាណិជ្ជកម្ម ។
លោក បន្ត ថា « ទ្វារ ច្រើន ទ្វារ ធំ នាំចូល មក ក៏ ច្រើន ដែរ តែ កាលណា យើង ដាក់ ទ្វារ តូច ពេក វា អត់ ចូល ដោយសារ អី ដោយសារ ប្រទេស យើង នៅ ក្រីក្រ ជាង គេ មាន ភាពទាក់ទាញ តិច ជាង គេ បើ យើង រិត ត្បិត ក្នុង ការហោះហើរ វា មិន អាច ទាក់ទាញ បាន ទេ ដូច្នេះ មកដល់ ថ្ងៃ នេះ យើង ឃើញ ថា គោល នយោបាយ បើក ជើង មេឃ ចំហរ នេះ គឺជា យុទ្ធសាស្រ្ត មួយ ដ៏ ត្រឹមត្រូវ មួយ ។ យើង បន្ត ធ្វើ ថែម ទៀត ដើម្បី ទាក់ទាញ ទាំង ទេសចរណ៍ ទាំង វិនិយោគិន ទាំង ពាណិជ្ជកម្ម អន្តរជាតិ » ។
លោក លើកឡើង បន្ត ថា កន្លងមករាល់ រាល់ អ្នកដំណើរ អន្តរជាតិ ភ្ញៀវ ទេសចរ ដែល ធ្វើដំណើរ មក កម្ពុជា ភាគ ច្រើន បន្ត មកពី ប្រទេស ជិតខាង ដោយសារ ព្រលានយន្តហោះ ចាស់ មាន សមត្ថភាព អាច ទទួលបាន ការចុះចត យន្តហោះ ប្រភេទ តូច ៗ ប៉ុណ្ណោះ ប៉ុន្តែ ព្រលានយន្តហោះ ថ្មី នេះ មាន ទំហំ ធំ អាច ទទួល ការហោះហើរ ផ្ទាល់ មកពី តំបន់ ឆ្ងាយ ៗ ដែល នេះ គឺជា ការទាក់ទាញ មួយ ធំ សម្រាប់ ភ្ញៀវ ទេសចរ និង អ្នក វិនិយោគ ។
( ប៉េកាំង . ចិន ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន គាំទ្រ ឱ្យ ក្រុមហ៊ុន ចិន បន្ត សិក្សា លើ គម្រោង អភិវឌ្ឍន៍ ផ្លូវ រថភ្លើង ធុន ស្រាល នៅក្នុង រាជធានី ភ្នំពេញ ខេត្ត កណ្តាល និង ខេត្ត សៀមរាប ។
លោក ប្រធាន ក្រុមប្រឹក្សាភិបាល ក៏ បាន បញ្ជាក់ ដែរ ថា ក្រុមហ៊ុន ក៏ នឹង សិក្សា អំពី លទ្ធភាព ផ្សេង ៗ ក្នុង ការជួយ សម្រួល ចរាចរណ៍ នៅ កម្ពុជា ។
សម្តេច ធិបតី ក៏ បាន ផ្តល់ ជា អនុសាសន៍ ដល់ ក្រុមហ៊ុន ឱ្យ មាន ការគិតគូរ សព្វគ្រប់ ជ្រុងជ្រោយ ជា អាទិ៍ ការអភិវឌ្ឍ ផ្លូវ ដែក ធុន ស្រាល . ស្ពាន អាកាស និង ផ្លូវ ក្រោម ដី ជាដើម ។ល ៕
ក្នុង ជំនួប នេះ លោក សែ ភីង បាន ថែ្លង អបអរសាទរ សម្តេច ធិបតី ទទួលបាន ការគាំទ្រ ឱ្យដឹកនាំ រាជ រដ្ឋាភិបាល ក្នុង នីតិកាល ថ្មី ។ លោក សែ ភីង ក៏ បាន ជម្រាប សម្តេច ធិបតី អំពី ការរីកលូតលាស់ របស់ ក្រុមហ៊ុន CP Group ដែល មាន អាយុកាល ជាង ១០០ ឆ្នាំ ជាមួយនឹង បទពិសោធន៍ ដ៏ សម្បូរបែប ក្នុង វិស័យ ធុរកិច្ច ហើយ សព្វ ថ្ងៃ ក៏ មាន ការវិនិយោគ នៅក្នុង ប្រទេស កម្ពុជា លើកសិដ្ឋាន ចិញ្ចឹម សត្វ និង អចលន ទ្រព្យ ផងដែរ ។
លោក សែ ភីង ក៏ បាន ជម្រាប សម្តេច ធិបតី អំពី គោលបំណង របស់ ក្រុមហ៊ុន ក្នុង ការពង្រីក ការវិនិយោគ បន្ថែម ទៀត នៅ កម្ពុជា ជាពិសេស ក្នុង វិស័យ អចលន ទ្រព្យ សុខាភិបាល និង ផ្កាយ រណប ។
សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន បង្ហាញ ការការគាំទ្រ ចំពោះ គម្រោង វិនិយោគ នានា របស់ ក្រុមហ៊ុន នៅ កម្ពុជា ជាពិសេស នៅក្នុង វិស័យ កសិកម្ម ក៏ ដូចជា វិស័យ ផ្សេង ទៀត ដែល ក្រុមហ៊ុន CP Group មាន ចំណាប់អារម្មណ៍ ដែល មាន ជាអាទិ៍ វិស័យ អចលន ទ្រព្យ . សុខាភិបាល និង ផ្កាយ រណប ។
សម្តេច ធិបតី បាន ណែនាំ ឱ្យ ក្រុមហ៊ុន ទាក់ទង ពិភាក្សា ការងារ ជាមួយ ក្រសួង - ស្ថាប័ន ជំនាញ ពាក់ព័ន្ធ របស់ កម្ពុជា ៕
ជំនួប ធ្វើឡើង នៅ រដ្ឋធានី ប៉េកាំង ប្រទេស ចិន ទី ដែល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ចូលរួម វេទិកា « ខ្សែក្រវាត់ និង ផ្លូវ » លើក ទី៣ ។
( ភ្នំពេញ ) ៖ តំបន់ សេដ្ឋកិច្ច ពិសេស កម្ពុជា សំដៅ ដល់ មជ្ឈមណ្ឌល ពិសេស សម្រាប់ អភិវឌ្ឍន៍ វិស័យ សេដ្ឋកិច្ច ដែល ប្រមូលផ្ដុំ នូវ សកម្មភាព ឧស្សាហកម្ម និង សកម្មភាព ពាក់ព័ន្ធ ដទៃ ទៀត ហើយ អាច មាន តំបន់ ឧស្សាហកម្ម ទូទៅ ឬ / និង តំបន់ ផលិត កែច្នៃ នាំចេញ ។
ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ ចាប់ផ្តើម បើក វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ អាណត្តិ ទី៣ ឆ្នាំ ២០២៣ ដើម្បី ដោះស្រាយ បញ្ហា សំណូមពរ របស់ ប្រជាពលរដ្ឋ
( ភ្នំពេញ ) ៖ រាល់ សំណើ និង សំណូមពរ ដោយ ផ្ទាល់ មាត់ ពីសំណាក់ ប្រជាពលរដ្ឋ ជាង ១០សំណើ និង សំណូមពរ នៅក្នុង វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ អាណត្តិ ទី៣ ឆ្នាំ ២០២៣ នា ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នៅ សាកលវិទ្យាល័យ ប៊ែល ធី អន្តរជាតិ ផ្លូវ ៣៦០ សង្កាត់ បឹងកេងកង ទី៣ ត្រូវបាន អាជ្ញាធរ រាជធានី ភ្នំពេញ ដោះស្រាយ បញ្ចប់ ស្ទើរ ទាំងស្រុង ដែល រាល់ សំណើ ទាំងនោះ ភាគ ច្រើន លើសលប់ គឺ ពាក់ព័ន្ធ នឹង ការងារ របស់ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ។
វេទិកា នេះ ធ្វើឡើង ក្រោម វត្តមាន លោក ម៉ប់ សារិន ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ និង លោក ហួត ហៃ អភិបាល រង រាជធានី តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ។
លោក ហួត ហៃ បាន លើកឡើង ថា វេទិកា នេះ ប្រជាពលរដ្ឋ បាន ស្នើ និង សំណូមពរ ឡើង ដោយ ផ្ទាល់ មាត់ ចំនួន ១១នាក់ ស្មើ និង ១៤ បញ្ហា និង សំណើ ជា លាយលក្ខណ៍ អក្សរ ចំនួន ១៩ បញ្ហា ហើយ រាល់ សំណើ និង សំណូម ទាំងនោះ រួម មាន៖
លោក ម៉ប់ សារិន ក្នុង ឱកាស នោះ ក៏ បាន មានប្រសាសន៍ ដែរ ថា ការបង្កើត ឲ្យ មាន វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ នេះ គឺ ដើម្បីឲ្យ អាជ្ញាធរ រាជធានី ខណ្ឌ សង្កាត់ និង ប្រជាពលរដ្ឋ បាន ជួបគ្នា និង បាន ពិភាក្សា លើ បញ្ហា ផ្សេង ៗ ដែល ជា កង្វល់ របស់ ប្រជាពលរដ្ឋ ឲ្យ អាជ្ញាធរ បាន ដឹង លឺ ហើយ រួមគ្នា ដោះស្រាយ ដែល មាន ដូចជា បញ្ហា សន្តិសុខ សណ្តាប់ធ្នាប់ បញ្ហា បរិស្ថាន និង បញ្ហា អភិវឌ្ឍ ន៏ នៅ មូលដ្ឋាន ជាដើម ។
វេទិការផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ ញ ត្រូវបាន ធ្វើឡើង ក្នុង ១ ឆ្នាំ ម្តង ក្នុង ត្រីមាស ទី៤ ពោលគឺ នៅក្នុង ខែតុលា ខែវិច្ឆិកា និង ខែធ្នូ ដើម្បី ដោះស្រាយ រាល់ កង្វល់ សំណូមពរ និង សំណើរ របស់ ប្រជាពលរដ្ឋ ។
លោក ម៉ប់ សារិន បាន បន្ត ថា « អ្វី ដែល ជា សំណើ និង សំណូមពរ របស់ ប្រជាពលរដ្ឋ ក្នុង វេទិការផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ កាលពី ឆ្នាំ ២០២២ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ដោះស្រាយ ជូន ជា បណ្តើរ ៗ ហើយ ហើយ អ្វី ដែល នៅ សេសសល់ យើង ក៏ បាន ដាក់ចូល ក្នុង គម្រោង អភិវឌ្ឍន៍ ៣ឆ្នាំ រំកិល ខណ្ឌ អស់ ហើយ ដែរ »៕
អភិបាល ខណ្ឌ ច្បារអំពៅ ដាក់ គ្រឿងចក្រ និង ម៉ាស៊ីន បូម ទឹក ដើម្បី កាយ និង បូម ទឹក ចេញ ពី លំនៅដ្ឋាន របស់ បងប្អូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹកភ្លៀង ស្ថិត នៅ ភូមិ អូរ អណ្ដូង១ សង្កាត់ ព្រែក ប្រា
( ភ្នំពេញ ) ៖ លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ បាន ក្រើន រំលឹក ដល់ មន្ត្រី គ្រប់ ជាន់ ថ្នាក់ ត្រូវ ក្តាប់ គ្រប់ បញ្ហា ដែល បងប្អូន ជួប ការលំបាក និង ចុះ ជួយ ដំណោះស្រាយ គ្រប់ វិធី ដែល អាច ធ្វើ ទៅ បាន ដើម្បី ជួយ បងប្អូន ប្រជាពលរដ្ឋ ឲ្យបាន ទាន់ ពេល វេលា ។
ជាក់ស្តែង នៅ ព្រឹក ថ្ងៃទី ១៦ ខែតុលា ឆ្នាំ ២០២៣ លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យ ដាក់ គ្រឿងចក្រ និង ម៉ាស៊ីន បូម ទឹក ដើម្បី កាយ និង បូម ទឹក ចេញ ពី លំនៅដ្ឋាន របស់ បងប្អូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹកភ្លៀង ស្ថិត នៅ ភូមិ អូរ អណ្ដូង១ សង្កាត់ ព្រែក ប្រា ខណ្ឌ ច្បារអំពៅ ។
សូម បញ្ជាក់ ថា ក្រោយពី មាន ភ្លៀង ធ្លាក់ ខ្លាំង ដល់ កម្រិត លើ គោលដៅ ជាច្រើន កាលពី យប់ ថ្ងៃទី ១៦ ខែតុលា រួច មក ធ្វើឱ្យ ស្ថានភាព ទឹកភ្លៀង ជន់ លិច តំបន់ លំនៅដ្ឋាន របស់ បងប្អូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹកភ្លៀង ស្ថិត នៅ ភូមិ អូរ អណ្ដូង១ សង្កាត់ ព្រែក ប្រា ខណ្ឌ ច្បារអំពៅ ៕ តំណាង ក្រសួង ធម្មការ និង សាសនា នាំយក អំណោយ សម្ដេច បវរធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ ប្រគល់ ជូន វត្ត ចំនួន ៩ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ខេត្ត បន្ទាយមានជ័យ
( បន្ទាយមានជ័យ )៖ លោក ហង្ស ចាន់ ព្រីដា រដ្ឋលេខាធិការ តំណាង លោក ចាយ បូរិន រដ្ឋមន្ត្រី ក្រសួង ធម្មការ និង សាសនា នៅ ល្ងាច ថ្ងៃទី ១៦ ខែតុលា ឆ្នាំ ២០២៣ បាន នាំយក អំណោយ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោកជំទាវ ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត ប្រគល់ ជូន វត្ត ចំនួន ៩ នៅក្នុង ខេត្ត បន្ទាយមានជ័យ ដែល រងគ្រោះ ដោយសារ ជំនន់ ទឹកភ្លៀង ។
ពិធី នេះ បាន ធ្វើឡើង នៅក្នុង វត្ត វេឡុវ័ន្ត ឬ ស្សី ក្រោក ឃុំ ឬ ស្សី ក្រោក ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ ដោយ មាន ការចូលរួម ពី លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ អភិបាល រង ខេត្ត មន្ត្រី សង្ឃ លោក បៀវ ថា ន ប្រធាន ធម្មការ ខេត្ត អនុប្រធាន អាចារ្យ និង ពុទ្ធ បរិស័ទ ជាច្រើន នាក់ ។
ក្នុង ពិធី នោះ លោក អ៊ុំ រាត្រី បាន ថ្លែង អំណ គុណ ដល់ សម្ដេច បវរធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ ដែល បាន ចូលរួម សទ្ធា ជ្រះថ្លា និង ជួយ ស្រាយ រាល់ ការលំបាក ខ្វះខាត ទាំង វិស័យ ពុទ្ធ ចក្រ និង អាណាចក្រ និង គោរព ស្រឡាញ់ ជឿជាក់ លើ ព្រះពុទ្ធ សាសនា ព្រោះថា ព្រះពុទ្ធ សាសនា បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការអប់រំ និង ចូលរួមចំណែក អភិវឌ្ឍ សង្គមជាតិ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ជំរុញ ឲ្យ ប្រជាពលរដ្ឋ ប្រកាន់ភ្ជាប់ នូវ សីលធម៌ ចរិយា ធម៌ និង គុណធម៌ ល្អ ប្រសើរ ក្នុង ការរស់ នៅ ។
លោក ហង្ស ចាន់ ព្រីដា បាន ឱ្យដឹង ថា សម្តេច បវរធិបតី ហ៊ុន ម៉ាណែត តែងតែ គិតគូរ ពី សុខ ទុក្ខ ភាព លំបាក របស់ ប្រជាពលរដ្ឋ រងគ្រោះ យក ទឹក ជំនន់ និង គ្រោះ ធម្មជាតិ ផ្សេង ៗ មិន ដែល ដាច់ ឡើយ ។ ក្នុង នាម ក្រសួង ធម្មការ និង សាសនា ពិត ណាស់ ចង់ ឃើញ នៅ តាម បណ្តា វត្ត អារាម នានា ឭតែ សំឡេង ព្រះធម៌ មាន ភាពស្ងប់ស្ងាត់ ដែល ផ្តល់ ភាពត្រជាក់ ត្រជុំ សម្រាប់ ប្រជាពុទ្ធ បរិស័ទ ជ្រក ក្រោម ម្លប់ ព្រះធម៌ ស្រប តាម រដ្ឋធម្មនុញ្ញ ថា ព្រះពុទ្ធ សាសនា ជា សានា របស់ រដ្ឋ ។
បច្ចុប្បន្ន វិស័យ ព្រះពុទ្ធ សសាសនា កំពុង ល្បីល្បាញ និង ភាពរីកចម្រើន អាច ប្រព្រឹត្តទៅ បាន គឺ អាស្រ័យ ដោយ ប្រទេសជាតិ មាន សុខ សន្តិភាព បើ គ្មាន សុខ សន្តិភាព ទេ យើង ក៏ គ្មាន ឱកាស អភិវឌ្ឍ ប្រទេស បាន រីកចម្រើន ដូច សព្វ ថ្ងៃ នេះ ឡើយ ។ សម្ភារៈ អំណោយ ទាំងនេះ បាន បែងចែក និង ប្រគេន ដល់ វត្ត ចំនួន ៩វត្ត នេះ ជា វត្ត ដែល មាន ការខ្វះខាត អំឡុង ពេល ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ ដើម្បី ចូលរួម ចំណែក ទ្រទ្រង់ វិស័យ ព្រះពុទ្ធ សាសនា ឲ្យ កាន់តែ រីកចម្រើន ទ្វេ ឡើង ថែម ទៀត ផង ។
ក្រុមប្រឹក្សា ខេត្ត កំពង់ធំ និង រដ្ឋបាល ខេត្ត ទទួលបាន សំណូមពរ មួយចំនួន ពី វេទិកា ពិគ្រោះយោបល់ ជាមួយ ពលរដ្ឋ នៅ ស្រុក តាំង គោក
( កំពង់ធំ )៖ ក្រុមប្រឹក្សា ខេត្ត កំពង់ធំ និង រដ្ឋបាល ខេត្ត កំពង់ធំ ទទួលបាន សំណូមពរ មួយចំនួន ពី វេទិកា ពិគ្រោះយោបល់ ជាមួយ ប្រជាពលរដ្ឋ នៅ ស្រុក តាំង គោក ដូចជា សំណើ ជួសជុល ផ្លូវ សំណើ ចេញ ប្លង់ កម្មសិទ្ធិ ជា ប្រព័ន្ធ បង្ក្រាប បទល្មើស នេសាទ ល្បែងស៊ីសង សំណើ ជួយ ស្រោចស្រង់ ស្ថានភាព ដែល រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង សំណើ សុំ ពន្លឿន ការធ្វើ អត្តសញ្ញាណប័ណ្ណ និង សំបុត្រ កំណើត ជាដើម ។
សំណើ សំណូមពរ ទាំងនោះ ត្រូវបាន លើកឡើង វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ អាណត្តិ ទី៣ ឆ្នាំ ២០២៣ ដែល រៀបចំឡើង នៅ សាលា ស្រុក តាំង គោក នា ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ ក្រោម ការដឹកនាំ របស់ លោក ឈុន ឈន់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កំពង់ធំ លោក ញ៉ឹក បាន ខេង អភិបាល រង ខេត្ត កំពង់ធំ និង មាន ចូលរួម ពី សម ជិក ក្រុមប្រឹក្សា ខេត្ត មន្ត្រីរាជការ សាលា ខេត្ត មន្ត្រីរាជការ សាលា ស្រុក តាំង គោក កម្លាំងប្រដាប់អាវុធ និង តំណាង ប្រជាពលរដ្ឋ ជាង ៣០០ នាក់ ផងដែរ ។
តាមរយៈ វេទិកា ក្រុមប្រឹក្សា ខាងលើ ប្រជាពលរដ្ឋ បាន សំណូមពរ ទៅ លើ ការស្នើ ជួសជុល ផ្លូវ ស្នើសុំ ចេញ ប្លង់ កម្មសិទ្ធិ ជា ប្រព័ន្ធ បទល្មើស នេសាទ បង្ក្រាប ល្បែងស៊ីសង ដូចជា កន្ទុយ លេខ ឡូតូ គ្រឿងញៀន ការពន្លឿន ធ្វើ អត្តសញ្ញាណប័ណ្ណ បាត់ ឬ ខូច និង សំបុត្រ កំណើត ជាដើម ។
ចំពោះ មុខ គឺ ប្រជាពលរដ្ឋ បាន ស្នើ ក្រុមប្រឹក្សា ខេត្ត កំពង់ធំ និង រដ្ឋបាល ខេត្ត ជួយ ស្រោចស្រង់ ស្ថានភាព ដែល រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ដូចជា ការខូចខាត ផល ដំណាំ ស្រូវ ផល ដំណាំ ចម្ការ ហេដ្ឋារចនាសម្ពន្ធ នានា ។
លោក ឈុន ឈន់ បាន ឱ្យដឹង ថា ក្រុមប្រឹក្សា ខេត្ត នឹង ប្រមូល នូវ រាល់ មតិ យោបល់ បញ្ហា ប្រឈម និង សំណូមពរ ទាំងនោះ ទៅ ពិភាក្សា ស្រាយ បំភ្លឺ ឱ្យ បាន ច្បាស់លាស់ ប្រកបដោយ តម្លាភាព និង ឈាន ទៅរក ការដោះស្រាយ ជូន បាន ចំ គោលដៅ មាន ប្រសិទ្ធភាព និង ទាន់ ពេល វេលា ។
លោក ញ៉ឹក បាន ខេង បាន ជំរុញ ដល់ មន្ទីរ ជំនាញ និង អ្នក ពាក់ព័ន្ធ ត្រូវ ពិនិត្យ នឹង ដោះស្រាយ តាម យន្តការ ផ្សេង ៗ តាម តម្រូវការ ជាក់ស្តែង របស់ ប្រជាពលរដ្ឋ ។ ជាមួយគ្នា នេះ លោក នឹង តាមដាន លើ ការដោះស្រាយ បញ្ហា ទាំងនេះ យ៉ាង យកចិត្តទុកដាក់ បំផុត ។
សូម ជម្រាប ថា វេទិកា នេះ ក៏ ជា ឱកាស ផ្សព្វផ្សាយ អំពី តួនាទី ភារកិច្ច របស់ ក្រុមប្រឹក្សា និង គណៈ អភិបាល ខេត្ត ព្រមទាំង លទ្ធផល សំខាន់ ៗ ដែល រដ្ឋបាល ខេត្ត សម្រេចបាន ៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ ណែនាំ សវនដ្ឋាន ទាំងអស់ ថា រាល់ អនុសាសន៍ កែលម្អ ចំណុច ខ្វះខាត ជាក់ស្ដែង ដែល កើតមាន នៅ សវនដ្ឋាន ត្រូវ យកចិត្តទុកដាក់ តាមដាន
( ស្វាយរៀង ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ងួន ស្រេង អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន សវនកម្ម ផ្ទៃក្នុង ក្រសួង មហាផ្ទៃ បាន ថ្លែង ណែនាំ ដល់ សវនដ្ឋាន ទាំងអស់ ថា រាល់ អនុសាសន៍ កែលម្អ ចំណុច ខ្វះខាត ជាក់ស្ដែង ដែល កើតមាន នៅ សវនដ្ឋាន ត្រូវ យកចិត្តទុកដាក់ តាមដាន រាល់ អនុសាសន៍ ដែល បាន ដាក់ ជូន នៅពេល ចុះ ធ្វើ សវនកម្ម សវនដ្ឋាន ត្រូវ មាន របាយការណ៍ ឆ្លើយតប និង លទ្ធផល សម្រច បាន ក្នុង រយៈពេល ៦ខែ ឬ យ៉ាង យូរ បំផុត ១២ ខែ ជូន មក សវនកម្ម ផ្ទៃក្នុង ។
ការថ្លែង ណែនាំ បែប នេះ របស់ លោក អគ្គ នាយក សវនកម្ម ធ្វើឡើង នៅក្នុង ក្នុង ពិធី បិទ សវនកម្ម ផ្ទៃក្នុង នៅ រដ្ឋបាល ខេត្ត ស្វាយរៀង សម្រាប់ ឆ្នាំ ២០២២ និង បណ្តា ឆ្នាំ ពាក់ព័ន្ធ ។ ពិធី នេះ មាន ការចូលរួម ពី លោក សុខ រស់ អភិបាល រង ខេត្ត ស្វាយរៀង តំណាង លោក ប៉េង ពោធិ៍សា អភិបាល ខេត្ត និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក សុខ រស់ បាន ជំរុញ មន្រ្តី ជំនាញ ពាក់ព័ន្ធ នៅ រដ្ឋបាល ខេត្ត រដ្ឋបាល ស្រុក ឱ្យ យកចិត្តទុកដាក់ អនុវត្ត តាម អនុសាសន៍ ណែនាំ របស់ គណៈប្រតិភូសវនកម្ម ផ្ទៃក្នុង ក្រសួង មហាផ្ទៃ ឱ្យ មាន ប្រសិទ្ធភាព នៅ ឆ្នាំ បន្តបន្ទាប់ ខាងមុខ ទៀត ។
លោក ប៉ែន ប៊ុន ឈួន បាន គូសបញ្ជាក់ ថា យោង តាម លិខិត លោក ឡាយ លិក ពាក្យ សុំ ស្នើ កាន់កាប់ និង អះអាង របស់ លោក ឡាយ លិក ថា ជា ដី របស់ គាត់ មាន ទីតាំង នៅ កន្លែងណា ឲ្យ ពិតប្រាកដ នោះ ទេ ព្រោះ ទីតាំង ដី ក្នុង ពាក្យ ស្នើសុំ ខុសពី ដី ជាក់ស្តែង ហើយ មិន មាន ភស្តុតាង អ្វី សម្រាប់ សម្គាល់ ឫ នៅ អាស្រ័យ ផល កាន់កាប់ នោះ ទេ ។
លោក អះអាង ថា ម្ចាស់ ដី ពិតប្រាដក គឺ របស់ ឈ្មោះ ជិន សារុំ ព្រោះ លោក ជឹម សារុំ មាន ឯកសារ កាន់កាប់ ដីធ្លី ត្រឹមត្រូវ ពិតប្រាកដ មែន ដោយ លោក ជឹម សារុំ មាន សាក្សី ព្រំប្រទល់ ខាងជើង ទល់ ផ្លូវ ជិត ដី លោក យន្ត មីន អតីត មេបញ្ជាការប្រត្តិការ សឹក រង កោះ កុង ទទួលស្គាល់ ខាងត្បូង ជាប់ ដី សុខ ឈីវ ខាងលិច ជាប់ ផ្លូវ ចាស់ ១៨ ខាងកើត ទល់ ព្រែក មាន បង្គោល ថ្ម តាម ព្រំ ជាក់ស្តែង ដែល ឈ្មោះ សា មឿន ជា អ្នកចាំ ចំការ ឲ្យ ។
យោង តាម ការស្រាវជ្រាវ របស់ អាជ្ញាធរ លោក ឡាយ លិក គឺ មាន អ្នកញុះ ញុង នៅ ពីក្រោយ ខ្នង និង បាន ក្លែង បន្លំ ឯកសារ ខុស ច្បាប់ ដើម្បី ទាញយក ផលប្រយោជន៍ ណាមួយ គ្រា ដែល ដី ទំនាស់ ស្ថិត នៅ ភូមិ កោះ ប៉ោ ឃុំ ប៉ាក់ ខ្លង ស្រុក មណ្ឌល សីមា ។
( កណ្ដាល ) ៖ ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ បាន សង្កត់ធ្ងន់ អំពី ការលើកកម្ពស់ វិស័យ យុត្តិធម៌ នៅ កម្ពុជា និង ជំរុញ ឱ្យ ចៅក្រម ព្រះរាជអាជ្ញា ក្រឡាបញ្ជី អាជ្ញា សាលា ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ផ្តល់ សេវា យុត្តិធម៌ ឱ្យ ឆាប់រហ័ស និង ត្រឹមត្រូវ លើកកម្ពស់ យុត្តិធម៌ និង ការអនុវត្ត ច្បាប់ ដើម្បី ពង្រឹង និង លើកកម្ពស់ ប្រព័ន្ធ យុត្តិធម៌ ឱ្យ រឹតតែ ល្អ ប្រសើរឡើង ។
ការណែនាំ សង្កត់ធ្ងន់ នេះ ធ្វើឡើង ក្នុង ពិធី ប្រកាស ចូលកាន់ តំណែង លោក ជឺ សុខ ជា ប្រធាន តុលាការ ខេត្ត កណ្ដាល ជំនួស លោក ហុក វ៉ាន់ធី ណា ដែល ត្រូវ ផ្លាស់ ទៅជា ប្រធាន តុលាការ ខេត្ត សៀមរាប វិញ ក្រោយ កាន់ តំណែង នៅ ខត្ត កណ្ដាល ជាង ៩ឆ្នាំ កន្លងមក ។ ពិធី នេះ ធ្វើឡើង នា ល្ងាច ថ្ងៃទី ១៦ ខែតុលា ឆ្នាំ ២០២៣ ។
ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ បាន ស្នើ ឱ្យ ប្រធាន តុលាការ ថ្មី ទាំង ២រូប បង្កើន ការយកចិត្តទុកដាក់ លើកកម្ពស់ ពង្រឹង គុណភាពយុត្តិធម៌ ដោយ ផ្តល់ សេវា យុត្តិធម៌ ឱ្យ ឆាប់រហ័ស និង ត្រឹមត្រូវ លើកកម្ពស់ យុត្តិធម៌ និង ការអនុវត្ត ច្បាប់ និង ការត្រួតពិនិត្យ ដោះស្រាយ ភាព មិន ប្រក្រតី ពិសេស ដោះស្រាយ ការកកស្ទះ សំណុំរឿង ជា រឿង ចាំបាច់ ដែល ត្រូវ យកចិត្តទុកដាក់ ដើម្បី ពង្រឹង លើកកម្ពស់ ប្រព័ន្ធ យុត្តិធម៌ ឲ្យ រឹតតែ ល្អ ប្រសើរឡើង ។
* ទី១៖ ការបង្កើត យន្ត ការដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ *ទី ២៖ ការជំរុញ និង ការពន្លឿន សំណុំរឿងក្តី នៅ តាម តុលាការ *ទី ៣៖ ត្រួតពិនិត្យ ដោះស្រាយ ភាព មិន ប្រក្រតី នៅ តាម តុលាការ សំដៅ ជួយ ដោះស្រាយ រក យុត្តិធម៌ ជូន ប្រជាពលរដ្ឋ និង លើកកម្ពស់ តម្លាភាព សុច្ចរិត ភាព និង ភាពត្រឹមត្រូវ ក្នុង ការអនុវត្ត ច្បាប់ និង ចំណាត់ការ រឿងក្តី ដោយ តុលាការ ។
( ព្រះវិហារ ) ៖ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ នឹង រៀបចំ ធ្វើ ការពង្រីក ផ្លូវ សង្ខាង ជាមួយនឹង ការជីក ដី ដាក់ លូ អ៊ុយ លូមូល នៅ ចំណុច គីឡូម៉ែត្រ លេខ ៦៨ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៦២ ក្នុង ភូមិសាស្ត្រ ភូមិ ភ្នំ ដែក ឃុំ រម្មណីយ៍ ស្រុក រវៀង នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ ខាងមុខ នេះ សូម ប្រជាពលរដ្ឋ ដែល បាន សាងសង់ សំណង់ រំលោភ ដី ចំណី ផ្លូវ នៅ ចំណុច នេះ សូម រុះរើ ចេញ ជាបន្ទាន់ ។
លោក ឧត្តមសេនីយ៍ ឯក បាន បន្ដ ថា ក្នុង ចំណោម បទល្មើស ដែល កើតឡើង សមត្ថកិច្ច បង្រ្កាប បាន ២១ករណី ស្មើ ៦២ % ឃាត់ខ្លួន ៣៤ នាក់ ក្នុង នោះ បទល្មើស ឧក្រិដ្ឋ ២ករណី ស្មើ ១០០ % ឃាត់ខ្លួន ២នាក់ និង បទល្មើស មជ្ឈិម ១៩ ករណី ស្មើ ៥៩ % ឃាត់ខ្លួន ៣២ នាក់ ។
ជំនួប នេះ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ ក្នុង ឱកាស នៃ ការចូលរួម ក្នុង « វេទិកា ខ្សែក្រវាត់ និង ផ្លូវ លើក ទី៣ » នៅ រដ្ឋធានី ប៉េកាំង សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
រសៀល នេះ សាលាឧទ្ធរណ៍ នឹង បើក សវនាការ ករណី ប៉ុនប៉ង ឃាតកម្ម លើ ជនជាតិ ចិន . ជនរងគ្រោះ បន្ដ អំពាវនាវ ឲ្យ តុលាការ កុំ ឲ្យ មាន ការដោះលែង ជន ដៃ ដល់
( ភ្នំពេញ ) ៖ នៅ វេលា ម៉ោង ២រសៀល ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ សាលាឧទ្ធរណ៍ រាជធានី ភ្នំពេញ នឹង បើក សវនាការ ជំនុំជម្រះ សំណុំរឿង ជនជាតិ ចិន ដែល ត្រូវបាន ជន ដៃ ដល់ មួយ ក្រុម ប៉ុនប៉ង យ៉ាង ព្រៃផ្សៃ ចង់ បញ្ចប់ ជីវិត កាលពី អំឡុង ខែកក្កដា ឆ្នាំ ២០២៣ ។ ខណៈ ជនរងគ្រោះ នៅតែ បន្ដ អំពាវនាវ ដល់ ស្ថាប័ន តុលាការ កុំ ឲ្យ មាន ការដោះលែង ជន ដៃ ដល់ ឲ្យ នៅ ក្រៅ ឃុំ ។
គួរ ជម្រាប ថា កាលពី ពេល កន្លងទៅ ថ្មី ៗ នេះ ជនជាតិ ចិន តៃវ៉ាន់ ម្នាក់ ឈ្មោះ CHEN CHIEN PEN បាន ដាក់ លិខិត សុំ កិច្ចអន្ដរាគមន៍ ពី ឧប នាយក រដ្ឋមន្ដ្រី កើត រិទ្ធ រដ្ឋមន្ដ្រី ក្រសួង យុត្តិធម៌ និង ប្រធាន សាលាឧទ្ធរណ៍ ដើម្បី កុំ ឲ្យ សាលាឧទ្ធរណ៍ ដោះលែង ជន ដៃ ដល់ ជា ក្រុម ដែល បាន ប្រើប្រាស់ អំពើ ប៉ុនប៉ង ឃាតកម្ម យ៉ាង ព្រៃផ្សៃ មក លើ រូប គេ កាលពី អំឡុង ខែកក្កដា ឆ្នាំ ២០២៣ កន្លងទៅ ។
ការបើក សវនាការ នេះ បាន ធ្វើឡើង ក្រោយ ព្រះរាជអាជ្ញា អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន ប្តឹង ជំទាស់ ដោយសារ ចៅក្រម ដោះលែង ជន ដៃ ដល់ ឲ្យ នៅ ក្រៅ ឃុំ ។
ខាងក្រោម នេះ ជា លិខិត សុំ កិច្ចអន្ដរាគមន៍ របស់ ជនរង គ្រោះ៖
សេចក្តីព្រាង ច្បាប់ នេះ ដើរ តួនាទី និង រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការអភិវឌ្ឍ សង្គម និង សេដ្ឋកិច្ច ជាតិ តាមរយៈ ការបង្កើត ការងារ ដោយ ផ្ទាល់ និង ដោយ ប្រយោល ការគាំទ្រ និង ជំរុញ វិស័យ ទេសចរណ៍ ពាណិជ្ជកម្ម ការទាក់ទាញ និង ជំរុញ ដល់ ការវិនិយោគ ផ្ទាល់ ពី បរទេស និង ធុរកិច្ច ក្នុង ស្រុក ប្រកបដោយ ទំនុកចិត្ត និង មាន លក្ខណៈ សេដ្ឋកិច្ច ។
សេចក្តីព្រាង ច្បាប់ នេះ តាក់តែង ឡើង មាន ១១មាត្រា និង ត្រូវបាន រដ្ឋសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា អនុម័ត យល់ព្រម ជា លើក ដំបូង ចំនួន ១០១ សំឡេង នៃ ចំនួន សមាជិក រដ្ឋសភា ទាំងមូល កាលពី ថ្ងៃទី ៩ ខែតុលា ឆ្នាំ ២០២៣ នា សម័យ ប្រជុំ រដ្ឋសភា លើក ទី១ នីតិកាល ទី៧ ។
លោក ត្រាំ បាន គូសបញ្ជាក់ ដូច្នេះ ថា « ប្រសិនបើ អ្នក ចង់ លុបបំបាត់ រដ្ឋ អ៉ី ស្រាអែល អ្នក នឹង ត្រូវបាន ហាមឃាត់ ប្រសិនបើ អ្នកគាំទ្រ ហាម៉ាស ឬ មនោគមន៍វិជ្ជា របស់ ហាម៉ាស អ្នក នឹង ត្រូវបាន ហាមឃាត់ ហើយ ប្រសិនបើ អ្នក ជា កុម្មុយនិស្ដ ម៉ាក និយម ឬ ក៏ ហា្វស៊ីស អ្នក នឹង ត្រូវបាន ហាមឃាត់ » ។
ខាងក្រោម នេះ ជា របាយការណ៍ នៃ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ប្រទេស អាស៊ាន គិត ត្រឹម ព្រឹក ថ្ងៃ ១៦ ខែតុលា ឆ្នាំ ២០២៣៖
គួរ បញ្ជាក់ ថា លោក ពូទីន បាន ធ្វើ ទស្សនកិច្ច ទៅកាន់ ប្រទេស ចិន លើក ចុងក្រោយ បំផុត ដើម្បី ចូលរួម ព្រឹត្តិការណ៍ សម្ពោធ កីឡា អូឡាំពិក រដូវ រងា ទីក្រុង ប៉េកាំង កាលពី ខែកុម្ភៈ ឆ្នាំ ២០២២ ជា ពេល ដែល ចិន និង រុស្ស៉ី ប្រកាស ពី ភាពជាដៃគូ គ្មាន ព្រំដែន តែ ប៉ុន្មាន ថ្ងៃ ប៉ុណ្ណោះ មុននឹង លោក ប្រធានាធិបតី រុស្ស៉ី បញ្ជា ឱ្យ កងទ័ព របស់ លោក វាយ សម្រុក ចូល អ៊ុយក្រែន ក្រោម ប្រតិបត្តិការ យោធា ពិសេស ដែល លោក ខាងលិច និង ទីក្រុង កៀវ ចាត់ទុក ថា ជា សង្រ្គាម ឈ្លានពាន ។
ជំនួប ធ្វើឡើង នៅ រដ្ឋធានី ប៉េកាំង ប្រទេស ចិន ទី ដែល សម្តេច ធិបតី អញ្ជើញ ចូលរួម វេទិកា « ខ្សែក្រវាត់ និង ផ្លូវ » លើក ទី៣ ។
