( ព្រៃវែង ) ៖ លោក ឧកញ៉ា ណាង ណាន រួមទាំង ក្រុមគ្រួសារ ក្នុង ឱកាស នៃ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ប្រពៃណី ជាតិ ខ្មែរ នេះ បាន នាំ ថវិកា ប្រមាណ ១៥.០០០ ដុល្លារ ជួយ ដល់ ការកសាង សមិទ្ធផល នានា ក្នុង វត្ត « វេឡុវ័ន រង្សី បារមី តាង៉ែត » ។ ជាមួយគ្នា នេះ លោក ឧកញ៉ា ក៏ បាន អំពាវនាវ ដល់ សប្បុរសជន នានា ដើម្បី ជួយ ដល់ ការកសាង សមិទ្ធ នានា ក្នុង វត្ត នេះ បន្ថែម ទៀត ផងដែរ ។
លោក ឧកញ៉ា ក៏ សូម ជូន បុណ្យ ដល់ លោក តា លោកយាយ អ៊ុំ ពូ មីង ទាំងអស់ គ្នា ឲ្យ ជួប តែ សេក្តីសុខ និង សេចក្ដី ចំរើន រកស៊ី ទទួលទាន មាន បាន ទាំងអស់ គ្នា ។
ជាមួយគ្នា នេះ លោក ឧកញ៉ា ក៏ បាន អំពាវនាវ ដល់ សប្បុរសជន ទាំង ក្នុង និង ក្រៅ ប្រទេស សូម សប្បុរស ជន ជួយ កសាង វត្ត វេឡុវ័ន រង្សី បារមី តាង៉ែត ទាំងអស់ គ្នា ខណៈ ដែល វត្ត នេះ គឺ ស្ថិត ក្នុង ស្ថានភាពខ្វះខាត ខ្លាំង ហើយ ទើបតែ កសាង បាន ៦ឆ្នាំ ប៉ុណ្ណោះ ៕
សភា សម្ព័ន្ធ សហជីព និង សមាគម និយោជក តំណាង ឱ្យ កម្មករ ជាង ៧០ម៉ឺន នាក់ គាំទ្រ ការដំឡើង ប្រាក់ ឈ្នួល ២០៤ ដុល្លារ
( ភ្នំពេញ ) ៖ សភា សម្ព័ន្ធ សហជីព សហភាព សហជីព និង សហព័ន្ធ សហជីព រួមទាំង សមាគម និយោជក នៅ កម្ពុជា ដែល តំណាង ឱ្យ កម្មករ និយោជិត ជាង ៧០ម៉ឺ នាក់ នៅ ទូទាំង ប្រទេស បាន ប្រកាស គាំទ្រ និង ឯកភាព ទទួលយក ចំពោះ ការដំឡើង ប្រាក់ ឈ្នួល អប្បរមា ចំនួន ២០៤ ដុល្លារ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច សម្រាប់ កម្មករ នៅ ឆ្នាំ ២០២៤ ។
ក្រុម សហជីព ទាំងនោះ រួម មាន សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា សហភាព សិទ្ធិ កម្មករ កម្ពុជា និង សមាគម និយោជក ក្នុង វិស័យ កាត់ដេរ និង វាយន ភណ្ឌ និង ផលិតផល ធ្វើដំណើរ ជាដើម បាន សេចក្តីថ្លែងការណ៍ គាំទ្រ ព្រោងព្រាត ចំពោះ ការដំឡើង ប្រាក់ ឈ្នួល ជូន កម្មក ចំនួន ២០៤ ដុល្លារ ពីសំណាក់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជា ប្រមុខ ។
សម្រាប់ សហជីព ដែល ជា សមាជិក ក្រុមប្រឹក្សា ជាតិ ប្រាក់ ឈ្នួល ការដំឡើង ចំនួន ២០៤ ដុល្លារ នេះ ត្រូវបាន ធ្វើឡើង ប្រកបដោយ បច្ចេកទេស និង មាន លក្ខណៈ វិទ្យាសាស្រ្ត ដោយ ផ្អែក លើ លក្ខណៈ វិនិច្ឆ័យ បែប សង្គម និង សេដ្ឋកិច្ច ស្រប តាម ស្តង់ដា សកល ដែល អង្គការ អន្តរជាតិ ខាង ការងារ បាន កំណត់ ក្រោម ក្រសែភ្នែក តាមដាន យ៉ាង យកចិត្តទុកដាក់ ពីសំណាក់ សហជីព ដែល ជា គិតគូរ ប្រយោជន៍ ជូន កម្មករ និយោជិត ។
សម្រាប់ សមាគម និយោជក ការដំឡើង ប្រាក់ ឈ្នួល របស់ រាជ រដ្ឋាភិបាល បាន និង កំពុង ដាក់ ចេញ នេះ នឹង ចូលរួម លើកកម្ពស់ ជីវភាព និង បន្ត រក្សា និង បង្កើត ឱកាស ការងារ ជូន បងប្អូន កម្មករ និយោជិត ព្រមទាំង បន្ដ ជំរុញឱ្យ មាន បរិយាកាស វិនិយោគ និង ធុរកិច្ចកាន់តែ ប្រសើរឡើង ប្រកបដោយ ភាពទាក់ទាញ ។
លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី បាន ស្វាគមន៍ និង ថ្លែងអំណរគុណ ដល់ អង្គការ CHAI ដែល បាន សហការ គាំទ្រ ក្រសួង សុខាភិបាល ក្នុង កម្មវិធី ជាតិ ប្រយុទ្ធ នឹង ជំងឺ គ្រុនចាញ់ ជំងឺ អេដស៍ និង ជំងឺ រលាក ថ្លើម ការអភិវឌ្ឍន៍ ធនធាន មនុស្ស សបញ្ជាក់ ពី ការចូលរួមចំណែក លើកកម្ពស់ សុខុមាលភាព ប្រជាជន កម្ពុជា ។
ទន្ទឹម នឹង នោះ លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី បាន ជម្រាប ជូន នូវ អាទិភាព គន្លឹះ ទាំង ៣ របស់ ក្រសួង សុខាភិបាល រួម មាន៖
១៖ ការពង្រឹង មណ្ឌល សុខភាព លើ ហេដ្ឋារចនាសម្ព័ន្ធ . ការផ្គត់ផ្គង់ ឱសថ សម្ភារៈ បរិក្ខារ និង សមត្ថភាព បុគ្គលិក
២៖ ការពង្រឹង មន្ទីរពេទ្យ បង្អែក ស្រុក ប្រតិបត្តិ លើ ការសង្គ្រោះ បន្ទាន់ ICU ផ្នែក វះកាត់ មន្ទីពិសោធន៍ និង រូបភាព វេជ្ជសាស្ត្រ
៣៖ ការពង្រឹង សមត្ថភាព និង ភាព ជា អ្នកដឹកនាំ មន្ត្រី នៅ ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ផងដែរ ។
ជា ការឆ្លើយតប លោកស្រី នាយិកា បាន ជម្រាប ជូន លោក រដ្ឋមន្ត្រី ថា កន្លងមក អង្គការ បាន ចូលរួម គាំទ្រ ជំនួយ បច្ចេកទេស ផ្នែក មន្ទីរពិសោធន៍ និង ការផលិត អុកស៊ីសែន ក្នុង បរិបទ នៃ ការរាតត្បាត ជា សកល ជំងឺ កូវីដ - ១៩ កម្មវិធី ជាតិ ផ្តល់ ថ្នាំ បង្ការ និង ប្រព័ន្ធ សុខាភិបាល ឌីជីថល ស្រប តាម អាទិភាព របស់ ក្រសួង ។
លើស ពី នោះ អង្គការ CHAI នឹង យក អនុសាសន៍ គន្លឹះ របស់ លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី រៀបចំ ផែនការ សកម្មភាព ពង្រឹង កិច្ចសហប្រតិបត្តិការ ជាមួយ ក្រសួង សុខាភិបាល បន្ត ទៀត តាមរយៈ អាទិភាព សំខាន់ ៗ ខាងលើ របស់ ក្រសួង ដោយ សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ ក្រុមការងារ បច្ចេកទេស របស់ ក្រសួង សុខាភិបាល ។
ជាង នេះ ទៅ ទៀត លោកស្រី បាន សម្តែង សេចក្តីរីករាយ ណាស់ ដែល លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី បាន គាំទ្រ សកម្មភាព ការងារ របស់ អង្គការ CHAI ប្រកបដោយ លទ្ធផល គួរ ជា ទី គាប់ ចិត្ត នា ពេល កន្លងមក គឺ អាស្រ័យ ដោយសារ មាន កិច្ចសហប្រតិបត្តិការ ល្អ និង ជិតស្និទ្ធ ពី មជ្ឈមណ្ឌល ជាតិ កម្មវិធី ជាតិ នាយកដ្ឋាន ពាក់ព័ន្ធ និង មន្ទីរ សុខាភិបាល រាជធានី - ខេត្ត ។ លោកស្រី ក៏ បាន ស្នើសុំ អនុសាសន៍ ណែនាំ បន្ថែម សម្រាប់ ការងារ របស់ អង្គការ CHAI ។
សូម ជម្រាប ថា ក្នុង ជំនួប ពិភាក្សា ការងារ នេះ លោកស្រី នាយិកា ក បាន ថ្លែង អបអរសាទរ និង ជូនពរ លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី ក្នុង ឱកាស ដែល ទទួលបាន នូវ ការ ទុកចិត្ត ពី រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ តែងតាំង ជា រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ៕
