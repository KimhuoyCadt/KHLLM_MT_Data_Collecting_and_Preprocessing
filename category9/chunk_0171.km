( ភ្នំពេញ ) ៖ មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ បាន បង្ហាញ តារាង លេខ ទូរស័ព្ទ សម្រាប់ ហៅ រថយន្ដ សង្គ្រោះ បន្ទាន់ ២៤ ម៉ោង លើ ២៤ ម៉ោង របស់ មន្ទីរពេទ្យ បង្អែក សម្រាប់ ដឹក អ្នក រងរបួស និង សព ជនរងគ្រោះថ្នាក់ ចរាចរណ៍ នៅ តាម មូលដ្ឋាន ក្នុង រាជធានី ភ្នំពេញ ។
ខាងក្រោម នេះ ជា តារាង លេខ ទូរស័ព្ទ៖ មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ ដឹកនាំ អង្គការ ឯកទេស ជំងឺ គ្រុនចាញ់ ជួប ពលរដ្ឋ កំពុង ធ្វើ ចំការ នៅ ជាយ ព្រៃឡង់ ដើម្បី ណែនាំ ពី វិធានការ ការពារ ពី ជំងឺ គ្រុនចាញ់
( ព្រះវិហារ ) ៖ លោក វេជ្ជបណ្ឌិត គួង ឡូ ទីប្រឹក្សា ក្រសួង សុខាភិបាល និង ជា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ នា រសៀល ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ បាន ដឹកនាំ ក្រុមការងារ ដោយ មាន ការចូលរួម ពី អង្គការ ឯកទេស ជំងឺ គ្រុនចាញ់ (MC) ចុះ ជួប ជាមួយ ប្រជាពលរដ្ឋ ដែល កំពុង ប្រកបរបរ ធ្វើ ចំការ នៅ ភូមិ ឆែប ក្រសាំង ( តំបន់ វាល ត្រកួន ) ស្ថិត ក្នុង ភូមិសាស្ត្រ ស្រុក ឆែប ជាយ ព្រៃឡង់ នៃ ខេត្ត ព្រះវិហារ ។
លោក គួង ឡូ បាន ឲ្យដឹង ថា ការចុះ ជួប ជាមួយ ប្រជាពលរដ្ឋ ដែល កំពុង ប្រកប រប ធ្វើ ចំការ នៅ ជាយយ ព្រៃឡង់ នា ពេលនេះ គឺ មាន ការលំបាក ណាស់ ដោយសារ រដូវ រវស្សា ផ្លូវ ពិបាក ធ្វើដំណើរ កន្លែង ខ្លះ ជិះ រថយន្ត បាន កន្លែង ខ្លះ ទាល់តែ ជិះ គោយន្ត ហើយ ឆ្លង ទឹក អូរ ប្រឡាយ កាត់ ព្រៃ ទើប ធ្វើដំណើរ ទៅដល់ ។ ដោយឡែក ការទៅ ជួប ប្រជាពលរដ្ឋ គឺ ចង់ ដឹង ពី ការរស់នៅ របស់ ពួកគាត់ ពី បញ្ហា ប្រឈម នឹង ជំងឺ ផ្សេង ៗ ពិសេស ជំងឺ គ្រុនចាញ់ ដោយសារ ពួកគាត់ ទៅ ទាំង គ្រួសារ មាន ទាំង កូនក្មេង ទៀតផង ។
លោក ប្រធាន មន្ទីរ សុខាភិបាល បាន ថ្លែង អប់រំ ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង តំបន់ គ្រុនចាញ់ ត្រូវ ទទួលទាន ថ្នាំ ការពារ ជំងឺ គ្រុនចាញ់ ប្រភេទ Pyramax មួយ ថ្ងៃ ១ ដង រយៈពេល ៣ ថ្ងៃ ក្នុង ១ខែ គឺ ពួកគាត់ អាច ការពារ ពី ជំងឺ គ្រុនចាញ់ បាន រយៈពេល ២៨ ថ្ងៃ ។ បើ ពួកគាត់ ទទួលទាន ថ្នាំ រយៈពេល ៣ខែ គឺ អាច ការពារ បាន ពី ជំងឺ គ្រុនចាញ់ រហូត ៤ខែ ( មាន ន័យ ថា ទទួលទាន ៣ខែ សម្រាក ១ខែ ។ លោក ថា ឱសថ ប្រភេទ នេះ មិន មាន ផល រំខាន អ្វី ដល់ ពួកគាត់ ទេ គ្រាន់តែ ពួកគាត់ កុំ ពិសារ គ្រឿងស្រវឹង រយៈពេល ៣ ថ្ងៃ ។
លោក គួង ឡូ បាន អះអាង ថា មូលហេតុ ដែល ឲ្យ ពួកគាត់ ទទួលទាន ឱសថការពារ ជំងឺ គ្រុនចាញ់ នេះ ដោយសារ កន្លែង ប្រកប ការងារ កសិកម្ម របស់ ពួកគាត់ គឺ នៅក្នុង ព្រៃ ហើយ នៅ ទីនេះ មាន ភ្នាក់ងារ ចម្លង ជំងឺ គ្រុនចាញ់ ច្រើន ដូចនេះ ពួកគាត់ អាច ប្រឈម នឹង ការឆ្លង ជំងឺ គ្រុនចាញ់ ។
លោក ក៏ បាន ណែនាំ ដល់ ពួកគាត់ ប្រសិនបើ សង្ស័យ ថា មាន ជំងឺ គ្រុនចាញ់ ត្រូវតែ ទៅ ជួប ជាមួយ អ្នកស្ម័គ្រចិត្ត ព្យាបាល ជំងឺ គ្រុនចាញ់ ភូមិ ឬមួយ អ្នកស្ម័គ្រ ព្យាបាល ជំងឺ គ្រុនចាញ់ ចល័ត ដែល ពួកគាត់ នៅ កៀក ជាង មណ្ឌល សុខភាព ហើយ ការចុះ ជួបប្រជាពលរដ្ឋ នា ពេលនេះ គឺ បាន ពិនិត្យ ការជួស ឈាម រក មេរោគ គ្រុនចាញ់ និង ចែក មុង ដល់ ពួកគាត់ ផងដែរ ៕ ក្រុមប្រឹក្សា ខេត្ត សៀមរាប រៀបចំ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ អាណត្តិ ទី៣ នៅ ស្រុក អង្គរ ជុំ និង ស្រុក វ៉ារិន ដើម្បី ស្តាប់ នូវ មតិ យោបល់ របស់ ពលរដ្ឋ និង បញ្ហា ប្រឈម
( សៀមរាប ) ៖ នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ ក្រុមប្រឹក្សា ខេត្ត សៀមរាប រៀបចំ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ អាណត្តិ ទី៣ នៅ ស្រុក អង្គរ ជុំ និង ស្រុក វ៉ារិន ក្រោម វត្តមាន របស់ លោក អ៊ាន ឃុន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោកស្រី ម៉ននី រងី្ស អភិបាល រង ខេត្ត តំណាង លោក ប្រាក់ សោភ័ណ អភិបាល ខេត្ត សៀមរាប ។
ក្នុង នោះ មាន ការចូលរួម ពីសំណាក់ លោក លោកស្រី ជា សមាជិក សមាជិកា ក្រុមប្រឹក្សា ខេត្ត អស់ លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព និង ក្រុមប្រឹក្សា ស្រុក អាជ្ញាធរ ស្រុក កងកម្លាំង ទាំង បី មន្ត្រីរាជការ សហភាព សហព័ន្ធ យុវជន កម្ពុជា អង្គការ សង្គម ស៊ីវិល វិស័យ ឯកជន និង ប្រជាពលរដ្ឋ រួមទាំង សិស្សានុសិស្ស ទាំង ពីរ ស្រុក ផងដែរ ។
បន្ទាប់ពី ការបង្ហាញ ស្តីពី ទិដ្ឋភាព រួម នៃ ការអភិវឌ្ឍ នៅក្នុង ដែន សមត្ថកិច្ច រដ្ឋបាល ខេត្ត ឆ្នាំ ២០២០ - ២០២៤ នៃ ផែនការ៣ឆ្នាំ រំកិល និង តាម ការបញ្ជាក់ របស់ លោកស្រី ម៉ននី រងី្ស បាន លើកឡើង ពី សមិទ្ធផល នានា ដែល រដ្ឋបាល ខេត្ត អនុវត្ត បាន ក្នុង ឆ្នាំ ២០២៣ ព្រមទាំង សមិទ្ធផល របស់ រដ្ឋបាល ស្រុក អង្គរ ជុំ និង ស្រុក វ៉ារិន ។
សមាជិក សមាជិកា អង្គ វេទិកា ក៏ បាន លើកឡើង នូវ ទុក្ខ កង្វល់ បញ្ហា ប្រឈម និង សំណូមពរ មួយចំនួន ដោយ បាន លើកឡើង នូវ សំណួរ ផ្ទាល់ មាត់ ចំនួន ១៣ ដោយ ផ្តោត ទៅ លើ បញ្ហា ហេដ្ឋារចនាសម្ព័ន្ធ ( ផ្លូវ ថ្នល់ ស្ពាន លូ ) អគ្គិសនី បញ្ហា ពន្ធដា ប្រព័ន្ធ ធារាសាស្រ្ត បញ្ហា ការដាក់ របាំង ការពារ ផ្លូវ ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ រថយន្ត ពន្លត់ អគ្គីភ័យ ចេញ ចូល មិន រួច នៅពេល ទៅ ជួយ អន្តរាគមន៍ ពន្លត់ ភ្លើង នៅពេល មាន ហេតុការកើតឡើង ។
ចំពោះ ការលើកឡើង នោះ ត្រូវបាន សាមីមន្ទីរ អង្គភាព ជំនាញ មាន ការពាក់ព័ន្ធ បាន ធ្វើ ការបកស្រាយ បំភ្លឺ ជូន ដល់ អង្គ វេទិកា ទាំងមូល ឲ្យ អស់ កង្វល់ ដែល ប្រជាពលរដ្ឋ មាន ទុក្ខ កង្វល់ កន្លងមក ឲ្យបាន កាន់តែ យល់ ច្បាស់ ផងដែរ ។ អង្គ វេទិកា ក៏ ទទួលបាន សំណួរ សំណូមពរ ដែល សរសេរ ជា លាយ ល័ក្ខ អក្សរ មាន ១៣សំណួរ សំណូមពរ ផងដែរ ។
លោក បាន បន្ត ថា ក្រោយពី ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា រួច មក ក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី លើក ដំបូង ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ដាក់ចេញ នូវ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ ដោយ ផ្តោត លើ បាវចនា ទាំង ប្រាំ គឺ កំណើន សេដ្ឋកិច្ច បង្កើត ការងារ ធានា សមធម៌ បង្កើន ប្រសិទ្ធភាព និង រក្សា ចីរភាព ដែល ជា របៀបវារៈ គោល នយោបាយ សង្គម សេដ្ឋកិច្ច ។
ចំពោះ ការពិនិត្យ និង ដោះស្រាយ បញ្ហា សំណួរ - សំណូមពរ របស់ ប្រជាពលរដ្ឋ នឹង ជួយ ជំរុញ ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម សំដៅ លើកកម្ពស់ គុណភាព ជីវិត កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ នៅ តាម បណ្ដា មូលដ្ឋាន ភូមិ ឃុំ ស្រុក នៃ ខេត្ត សៀមរាប ទាំងមូល ៕
និយ័តករ មូលបត្រ កម្ពុជា និង ផ្សារ មូលបត្រ កម្ពុជា ព្រមព្រៀង គ្នា ផ្ដល់ លេខ អត្តសញ្ញាណ វិនិយោគ និង បើក គណនី ជួញដូរ មូលបត្រ តាម ប្រព័ន្ធ អនឡាញ កាន់តែ ងាយស្រួល ដល់ អ្នក វិនិយោគ
( ភ្នំពេញ ) ៖ និយ័តករ មូលបត្រ កម្ពុជា និង ផ្សារ មូលបត្រ កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ចុះ កិច្ចព្រមព្រៀង ស្ដីពី តំណ ភ្ជាប់ ប្រព័ន្ធ ផ្ដល់ លេខ អត្តសញ្ញាណ វិនិយោគ តាម អនឡាញ របស់ និយ័តករ មូលបត្រ កម្ពុជា និង ប្រព័ន្ធ បើក គណនី ជួញដូរ មូលបត្រ តាម អនឡាញ របស់ ផ្សារ មូលបត្រ កម្ពុជា ។
លោក បាន បញ្ជាក់ ថា « សមិទ្ធផល ថ្មី នេះ មិន ត្រឹមតែ ផ្ដល់ ភាពងាយស្រួល ដល់ សាធារណជន ក្នុង ប្រទេស នោះ ទេ អ្វី ដែល សំខាន់ គឺ អាច សម្រួល និង ទាក់ទាញ វិនិយោគិន មក បរទេស ចូល ទីផ្សារ កម្ពុជា បាន គ្រប់ ពេលវេលា នេះ ជា ចំណុច របត់ ដ៏ សំខាន់ មួយ ក្នុង វិស័យ មូលបត្រ » ។
លោក ស៊ូ សុជាតិ បាន បន្ថែម ថា ការតភ្ជាប់ ប្រព័ន្ធ នេះ ត្រូវបាន បង្កើត ដោយ រួមបញ្ចូល គ្នា នូវ ផ្ដល់ ប្រព័ន្ធ ស្គាល់ អតិថិជន សម្រាប់ ក្រុមហ៊ុន មូលបត្រ. ប្រព័ន្ធ ផ្ដល់ លេខ អត្តសញ្ញាណ វិនិយោគិន តាម អនឡាញ របស់ និយ័តករ មូលបត្រ កម្ពុជា និង ប្រព័ន្ធ បើក គណនី ជួញដូរ តាម អនឡាញ របស់ ផ្សារ មូលបត្រ ឱ្យ ស្ថិត នៅក្រោម ប្រព័ន្ធ តែ មួយ ។
លោក ហុង សុហួរ បាន ថ្លែង ថា កិច្ចព្រមព្រៀង លើ ការផ្ដល់ លេខ អត្តសញ្ញាណ វិនិយោគ តាម អនឡាញ និង បើក គណនី ជួញដូរ មូលបត្រ តាម អនឡាញ នឹង ជួយ ជំរុញ បន្ថែម ទៀត លើ ការវិនិយោគ ក្នុង ផ្សារ មូលបត្រ និង ស្វាគមន៍ រាល់ អ្នកវិនិយោគិន ទាំងអស់ ដែល មាន បំណង ចង់ ចូលរួម វិនិយោគ និង សម្រួល ភាពងាយស្រួល ក្នុង ការវិនិយោគ ដល់ សាធារណជន គ្រប់ ពេលវេលា គ្រប់ ទីកន្លែង មិន ថា វិនិយោគិន នៅ ក្រៅ ប្រទេស ឬ ក្នុង ប្រទេស ឡើយ ។
លោក បន្ដ ថា គិត ត្រឹម ចុង ឆ្នាំ ២០២២ ចំនួន អ្នកបើក គណមាន ជាង ៣ម៉ឺន គណនី ហើយ បើ តាម ការព្យាករណ៍ ដាច់ ឆ្នាំ ២០២៣ នឹង មាន អ្នកបើក គណនី ជាង ១ម៉ឺន គណនី បន្ថែម ទៀត ។ ដោយឡែក សម្រាប់ ឆ្នាំ ២០២៤ វិញ យើង រំពឹង ថា នឹង ទទួលបាន អ្នកបើក គណនី រហូតដល់ ៣- ៥ម៉ឺន គណនី ដោយសារតែ ការបើក គណនី នៅតែ បន្ដ កើនឡើង បូករួម ជាមួយនឹង ការដាក់ ដំណើរការ ការផ្ដល់ លេខ អត្តសញ្ញាណ វិនិយោគ និង បើក គណនី ជួញដូរ មូលបត្រ តាម អនឡាញ ដែល ផ្ដល់ ភាពងាយស្រួល និង ឆាប់រហ័ស ដូច្នេះ ការបើក គណនី ៣ - ៥ម៉ឺន គណនី នេះ មិន មែន ជា ការលំបាក នោះ ទេ ។
លោក បាន បន្ដ ថា ដោយឡែក ចំពោះ ទំហំ ជួញដូរ នៅ អំឡុង ២ខែ ចុងក្រោយ នេះ មាន ការថយចុះ បន្ដិច ស្ថិត ក្រោម ២០ម៉ឺន ដុល្លារ ជា មធ្យម ក្នុង មួយ ថ្ងៃ ខណៈ ប្រមាណ ជា ៧ខែ មុន ហក់ ដល់ ជិត ៣០ម៉ឺន ដុល្លារ ជា មធ្យម ក្នុង មួយ ថ្ងៃ ទោះបីជា មាន ទំនោរ ថយចុះ បន្ដិច ក្ដី តែ យើង រំពឹង ថា ខាងមុខ ទំហំ ជួញដូរ នឹង អាច ជំរុញ បន្ថែម តាមរយៈ ការចូលរួម ជាច្រើន ពី វិនិយោគិន ៕
ក្រសួង ការពារ ជាតិ ដឹកនាំ ប្រជុំ គណៈកម្មាការ ចំពោះ កិច្ច ពិភាក្សា ពង្រឹង វិធានការ ទប់ស្កាត់ ពលករ ឆ្លង ដែន ខុស ច្បាប់ និង បន្ត ចុះ ត្រួតពិនិត្យ ការអនុវត្ត ការងារ របស់ សមត្ថកិច្ច តាម ច្រក ទ្វារ ព្រំដែន ខេត្ត ព្រះវិហារ និង ខេត្ត ឧត្តរមានជ័យ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ គណៈកម្មាការ ចំពោះ កិច្ច ត្រួតពិនិត្យ និង ដោះស្រាយ បញ្ហា ដំណើរ ចេញ ចូល របស់ ពលករ ខ្មែរ តាម ព្រំដែន នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្រុមការងារ ទី២ បាន បើក កិច្ចប្រជុំ នៅ ទីស្តីការ ក្រសួង ការពារ ជាតិ ដើម្បី ពិភាក្សា ពង្រឹង វិធានការ របស់ រាជ រដ្ឋាភិបាល ទប់ស្កាត់ ពលករ ឆ្លង ដែន ខុស ច្បាប់ និង បន្ត ចុះ ត្រួតពិនិត្យ ការអនុវត្ត ការងារ របស់ សមត្ថកិច្ច ពាក់ព័ន្ធ តាម ច្រក ទ្វារ ព្រំដែន ខេត្ត ព្រះវិហារ និង ខេត្ត ឧត្តរមានជ័យ ។
កិច្ចប្រជុំ នេះ បាន ប្រព្រឹត្តិ ទៅ ក្រោម អធិបតីភាព លោក ឧត្តមសេនីយ៍ ឯក សៀក សុជាតិ រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ជា អនុប្រធាន គណៈកម្មាការ ចំពោះ កិច្ច ត្រួតពិនិត្យ និង ដោះស្រាយ បញ្ហា ដំណើរ ចេញ ចូល របស់ ពលករ ខ្មែរ តាម ព្រំដែន នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជា ប្រធាន ក្រុមការងារ ទី២ និង មាន ការចូលរួម ពី អនុប្រធាន និង សមាជិក ក្រុមការងារ ទី២ នៃ គណៈកម្មការ ចំពោះ កិច្ច ជាច្រើន រូប ទៀត ។
ថ្លែង បើក កិច្ចប្រជុំ ឧត្តមសេនីយ៍ ឯក សៀក សុជាតិ បាន បញ្ជាក់ ថា « គោលបំណង នៃ កិច្ចប្រជុំ គឺ ដើម្បី ពិភាក្សា ស្វែងរក ដំណោះស្រាយ ជួយ សម្រួល ដល់ ការឆ្លងកាត់ ព្រំដែន របស់ ប្រជាពលករ ធានា ឱ្យ បាន នូវ ភាពស្រប ច្បាប់ ប្រកបដោយ សុវត្ថិភាព និង ដាក់ ទិសដៅ បន្ត ចុះ ត្រួតពិនិត្យ តាម បណ្តា ច្រកទ្វារ ព្រំដែន ស្ថិត ក្នុង ខេត្ត ព្រះវិហារ និង ខេត្ត ឧត្តមានជ័យ តាម ការអនុវត្ត តាម អនុសាសន៍ របស់ សន្តិ បណ្ឌិត នេត សាវឿន ឧប នាយក រដ្ឋមន្ត្រី ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច » ។
ជាមួយគ្នា នេះ កិច្ចប្រជុំ ក៏ បាន ដាក់ចេញ នូវ ទិសដៅ ពង្រឹង កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេស ជិតខាង ដើម្បី ជួយ សម្របសម្រួល ដល់ ពលករ ក្នុង ការឆ្លង ដែន ប្រកបដោយ សុវត្ថិភាព និង ភាពស្រប ច្បាប់ ផងដែរ ៕ ក្រសួង ព្រះបរម រាជ វាំង បដិសេធ ព្រះរាជ សារ ក្លែងក្លាយ និមន្ដ ព្រះធម្មវ ន វា សី ចន្ទ មុនី ទៅ សម្ដែង ព្រះធម៌ ទេសនា ក្នុង ព្រះរាជ ពិធី បុណ្យ ក ឋិន ទាន របស់ ព្រះមហាក្សត្រ នៅ ខេត្ត កំពត
ខាងក្រោម នេះ ជា លិខិត របស់ ក្រសួង ព្រះបរម រាជ វាំង៖
ក្រសួង រៀបចំ ដែនដី ដាក់ ឲ្យ ដំណើរការ ប្រព័ន្ធ អេឡិចត្រូនិច ដែល អនុញ្ញាតឱ្យ ពលរដ្ឋ អាច មើល និង បញ្ជាក់ ពី ព័ត៌មាន នៃ បណ្ណ កម្មសិទ្ធិ
សេវា នេះ អាច ឱ្យ ប្រជាពលរដ្ឋ បញ្ជាក់ អំពី ភាព ពិត ប្រាកដ ត្រឹមត្រូវ នៃ ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី ដោយ គ្រាន់តែ វាយ បញ្ចូល នូវ លេខ សម្គាល់ នៅលើ សន្លឹក ប័ណ្ណ ៕
អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ដុត បំផ្លាញ ទំនិញ ខុស ច្បាប់ ជាង ៥០តោន ដែល បង្ក្រាប បាន នា ពេល កន្លងទៅ
( ភ្នំពេញ ) ៖ ទំនិញ ខុស ច្បាប់ ជាង ៥០តោន ដែល កម្លាំង នាយកដ្ឋាន នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ សហការ ជាមួយ កម្លាំង សមត្ថកិច្ច ពាក់ព័ន្ធ ដែល បាន ធ្វើ ការបង្ក្រាប ជា បន្តបន្ទាប់ កាលពី ពេល កន្លងមក ក្នុង ករណី ចំនួន ១០ ត្រូវ ធ្វើ ពិធី ដុត បំផ្លាញ ចោល នា ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ នៅ ទីលាន ចាក់ សំរាម ក្នុង សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។
ពិធី ដុត បំផ្លាញ ខាង លើ នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក ឧត្តមសេនីយ៍ ឯក មួង សុធា អគ្គ ស្នងការ រង នគរបាល ជាតិ តំណាង នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ និង ដោយ មាន ការចូលរួម ពី លោក ឧត្តមសេនីយ៍ ឯក ចាន់ វ៉ាន់ ធឿន ប្រធាន នាយកដ្ឋាន នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច មន្ត្រី កាំ កុងត្រូល ស្ថាប័ន្ថ តំណាង អយ្យការ មន្ត្រី អាជ្ញាធរ ពាក់ព័ន្ធ ក៏ ដូចជា ពលរដ្ឋ ជាច្រើន ទៀត ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក មួង សុធា បាន បញ្ជាក់ ថា ផលិតផល ដែល ដុត បំផ្លាញ ចោល នៅ ព្រឹក នេះ រួម មាន៖ ទំនិញ និង ផលិតផល ក្លែងក្លាយ . ផលិតផល នាំចូល គ្មាន ច្បាប់ អនុញ្ញាត . ផលិតផល គ្រឿង សំអាង លាយ សារធាតុ គីមី ខុស ច្បាប់ . ឱសថ ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ . ចំណីអាហារ និង សាច់ ខូច គុណភាព ព្រមទាំង សារធាតុ គីមី ខុស ច្បាប់ ជាដើម ។ ខណៈ កន្លងទៅ នគរបាល ធ្លាប់ បាន ធ្វើ ការដុត បំផ្លាញ ចោល ចំនួន ៣៧ លើក រួច មកហើយ ។
លោក ឧត្តមសេនីយ៍ ឯក អគ្គ ស្នងការ រង បាន បន្ត ថា ពិធី ដុត បំផ្លាញ ចោល នា ថ្ងៃ នេះ គឺជា សក្ខីភាព មួយ ដែល ស្តែង ពី ការខិតខំ ប្រឹងប្រែង របស់ មន្រ្តី ជំនាញ នៃ នាយកដ្ឋាន នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច សហការ ជាមួយ អង្គភាព ស្ថាប័ន ជំនាញ ពាក់ព័ន្ឋ អាជ្ញាធរ មូលដ្ឋាន រួម ជាមួយ វិស័យ ឯកជន ក្រោម ការចង្អុលបង្ហាញ ពី ថ្នាក់ដឹកនាំ ក្រសួង មហាផ្ទៃ និង អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ស្រប តាម ផែនការ យុទ្ធសាស្ត្រ របស់ នាយកដ្ឋាន នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច ។
អភិបាល ខេត្ត ស្ទឹងត្រែង អញ្ជើញ ចែក វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថ ចំនួន ៣៦៥ ក្បាល ដី ដល់ ប្រជាពលរដ្ឋ ភូមិ កាំង តេជោ ឃុំ ថា ឡាបរិវ៉ាត់
( ស្ទឹងត្រែង ) ៖ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ស្ទឹងត្រែង នៅ ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ចែក វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថុ ចំនួន ៣៦៥ ក្បាល ដី ជូន ដល់ ប្រជាពលរដ្ឋ ភូមិ កាំង តេជោ ឃុំ ថា ឡាបរិវ៉ាត់ ស្រុក ថា ឡាបរិវ៉ាត់ ។ ពិធី នេះ បាន ធ្វើឡើង មុខ អាគា ការិយាល័យ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង ភូមិបាល ស្រុក ថា ឡាបរិវ៉ាត់ ខេត្ត ស្ទឹងត្រែង ។
លោក គឹម ពិសិទ្ធ ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ត ស្ទឹងត្រែង បាន លើកឡើង ថ្ងៃ នេះ ថា ការទទួលបាន ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី គឺជា ឯកសារ រដ្ឋបាល បញ្ជាក់ ពី សិទ្ធិ ជា ម្ចាស់ លើ ក្បាល ដី នីមួយ ៗ ហើយ ប្រជាពលរដ្ឋ ដែល ទទួលបាន ប័ណ្ណ កម្មសិទ្ធិ គឺជា ម្ចាស់ ដី ពេញ លក្ខណៈ ដែល ត្រូវបាន ការពារ ដោយ ច្បាប់ ។
លោក ប្រធាន មន្ទីរ បន្ត ថា ការសម្រេចបាន នូវ លទ្ធផល ទាំងនេះ គឺ ដោយសារ មាន ការចូលរួម សហការ ពី អាជ្ញាធរ ស្រុក ឃុំ ភូមិ ពិសេស ការចូលរួម ពី បង ប្អូន ប្រជាពលរដ្ឋ ជា ម្ចាស់ ក្បាល ដី ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន សហការ ល្អ ជាមួយ អាជ្ញាធរ និង ក្រុមការងារ បច្ចេកទេស ចុះ វាស់វែង ធ្វើឲ្យ ការចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ ក្នុង ភូមិ កាំង តេជោ ឃុំ ថា ឡាបរិវ៉ាត់ ទទួល ជោគជ័យ ។
លោក ស្វាយ សំអ៊ាង យល់ឃើញ ថា តាមរយៈ ការចូលរួម ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ដែល ធ្វើឲ្យ សម្រេចបាន ជោគជ័យ លើ កិច្ចការ ចុះបញ្ជី ដីធ្លី ជូន ប្រជាពលរដ្ឋ នា ពេលនេះ ពិតជា បាន បង្ហាញ នូវ សមិទ្ធផល ថ្មី មួយ ទៀត ក្នុង ចំណោម សមិទ្ធផល ជាច្រើន ដែល បាន កសាងឡើង ក្នុង ឃុំ ថា ឡាបរិវ៉ាត់ យើង នេះ ស្ថិត ក្រោម មាគ៌ា សុខ សន្តិភាព ស្ថិរភាព នយោបាយ និង សណ្តាប់ ធ្នាប់ សង្គម ល្អ ប្រសើរ ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា ។
( កំពង់ធំ )៖ លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ លោក បណ្ឌិត ជា ចាន់តូ សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ និង លោកស្រី ខៀវ ស៉ីណា ដែល បាន ឧបត្ថម្ភ សម្ភារ និង ថវិកា ដល់ រដ្ឋបាល ខេត្ត កំពង់ធំ សម្រាប់ រៀបចំ ចាត់ចែង ក្នុង ពិធី បុណ្យ អុំ ទូក ថ្នាក់ ខេត្ត នៅ ថ្ងៃទី ២៨ - ២៩ ខែតុលា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
ពិធី ប្រគល់ និង ទទួល ធ្វើឡើង ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នៅ សាលា ខេត្ត កំពង់ធំ ។
លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន ឲ្យដឹង ថា គណនី ក្លែងក្លាយ មួយ នោះ បាន បង្ហោះ សារ មួយចំនួន ពាក់ព័ន្ធ ជាមួយ ប្រទេស ថៃ ក្នុង បំណង ទុច្ចរិត និង បំពុល សង្គម ។ លើស ពី នេះ ក៏ នាំឲ្យ មាន ការភ័ន្ដច្រឡំ ពីសំណាក់ សាធារណៈ ជន ផងដែរ ។
លោក ស្នងការបាន អះអាង ថា នៅ ពេល នេះ កម្លាំង សមត្ថកិច្ច ជំនាញ កំពុង ធ្វើ ការស្រាវជ្រាវ ស្វែង អត្តសញ្ញាណ អ្នក ដែល បង្កើត គណនី ក្លែងក្លាយ នេះ ដើម្បី យកមក ផ្ដន្ទាទោស តាម ច្បាប់ ។ លោក ក៏ បាន ច្រានចោល រាល់ ការបង្ហោះ ទាំងឡាយ នៅលើ គណនី មួយ នេះ ដោយ មិន ជាប់ពាក់ព័ន្ធ ជាមួយ រូប លោក នោះ ឡើយ ៕
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ បាន អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ ពិនិត្យ ត្រៀម រៀបចំ ការប្រណាំង ទូក «ង » ថ្នាក់ ខេត្ត ដើម្បី អបអរសាទរ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ឆ្នាំ ២០២៣ នៅ បរិវេណ ដង ស្ទឹង សិរី សោភ័ណ ខាងក្រោយ សាកលវិទ្យាល័យ ជាតិ មានជ័យ ។
រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ នឹង រៀបចំ ពិធី ប្រណាំង ទូក «ង » ថ្នាក់ ខេត្ត មាន ចំនួន ២៨ ទូក នៅ ដង ស្ទឹង សិរី សោភ័ណ ខាងក្រោយ សាកលវិទ្យាល័យ ជាតិ មាន ជ័យ ដែល នឹង ប្រព្រឹត្តទៅ នា ថ្ងៃទី ១១ - ១២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នា ពេល ខាងមុខ នេះ ៕
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៦ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៤៥ នាក់ ។
* ករណី ដឹកជញ្ជូន រក្សាទុក ៦ករណី ឃាត់ខ្លួន ៩នាក់ * ករណី ប្រេី ប្រាស់ ៩ករណី ឃាត់ខ្លួន ៣៤ នាក់ * ករណី ជួញដូរ ១ករណី ឃាត់ខ្លួន ២នាក់
អគ្គ ស្នងការ នគរបាល ជាតិ គាំទ្រ ទីភ្នាក់ងារ សន្តិសុខ សហព័ន្ធ រុស្ស៊ី ចំពោះ គម្រោង ជួយ បណ្តុះបណ្តាល នគរបាល កម្ពុជា លើ ជំនាញ ប្រឆាំង បច្ចេកវិទ្យា
( ភ្នំពេញ ) ៖ អគ្គ ស្នងការ នគរបាល ជាតិ បង្ហាញ ការគាំទ្រ ចំពោះ សំណើ របស់ ទីភ្នាក់ងារ សន្តិសុខ សហព័ន្ធ រុស្ស៊ី ក្នុង ការបញ្ជូន នគរបាល កម្ពុជា ទៅ សិក្សា ជំនាញ សំខាន់ ៗ ជាច្រើន ដើម្បី រួមគ្នា ទប់ស្កាត់ និង ប្រយុទ្ធ ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា នៅក្នុង ប្រទេស កម្ពុជា និង តំបន់ អាស៊ាន ។
កិច្ច ជំនួប នេះ ធ្វើឡើង រវាង អគ្គ ស្នងការ នគរបាល ជាតិ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ស ថេត និង ប្រធាន ការិយាល័យ តំណាង ប្រចាំ តំបន់ នៃ ទីភ្នាក់ងារ សន្តិសុខ សហព័ន្ធ រុស្ស៊ី លោក សីម សូវ យេវ គេង ញី នៅ ទីស្តី ក្រសួង មហាផ្ទៃ នា រសៀល ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ ។
ជា កិច្ច ចាប់ផ្តើម ប្រធាន ការិយាល័យ តំណាង ប្រចាំ តំបន់ នៃ ទីភ្នាក់ងារ សន្តិសុខ សហព័ន្ធ រុស្ស៊ី លោក សីម សូវ យេវ គេង ញី បាន អបអរសារទរ ចំពោះ នាយ ឧត្តមសេនីយ៍ ស ថេត ដែល ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា អគ្គ ស្នងការ នគរបាល ជាតិ ។
លោក សីម សូវ យេវ គេង ញី បាន លើកឡើង ថា ទីភ្នាក់ងារ សន្តិសុខ សហព័ន្ធ រុស្សី មាន បំណង បង្កើន កិច្ចសហប្រតិបត្តិកាន់តែ ល្អ ជាមួយ នគរបាល ជាតិ កម្ពុជា ជាពិសេស អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ហើយ ភាគី រុស្ស៊ី នឹង ស្វាគមន៍ ជានិច្ច ចំពោះ កិច្ចសហការ ជុំវិញ ការបង្កើន ចំណេះដឹង ជំនាញ ប្រយុទ្ធ ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា ដល់ នគរបាល កម្ពុជា ។
ជា ការឆ្លើយតប អគ្គ ស្នងការ នគរបាល ជាតិ នាយ ឧត្តមសេនីយ៍ ស ថេត បាន បង្ហាញ ការគាំទ្រ ចំពោះ សំណើ ចង់ ជួយ កម្ពុជា ក្នុង ការបណ្តុះបណ្តាល បច្ចេកទេស និង ជំនាញ ថ្មី ៗ ដល់ នគរបាល កម្ពុជា ជាពិសេស លើ ជំនាញ ប្រយុទ្ធ ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា Cyber Crime ។
អគ្គ ស្នងការ នគរបាល ជាតិ បាន បន្ថែម ទៀត ថា កន្លងទៅ កម្ពុជា ធ្លាប់ បាន បញ្ជូន នគរបាល ជាតិ ទៅ សិក្សា ជំនាញ ផ្សេង ៗ នៅ រុស្ស៊ី រួចហើយ ហើយ ចំពោះ ជំនាញ បទល្មើស បច្ចេកវិទ្យា នឹង បន្ត បញ្ជូន នគរបាល កម្ពុជា ទៅ ទទួល ការបណ្តុះបណ្តាល បន្ថែម ទៀត ។
សូម ជម្រាប ថា កម្ពុជា និង រុស្សី បាន បង្កើត ចំណង ទំនាក់ទំនង ការទូត ដំបូង នៅ ឆ្នាំ ១៩៥៦ ហើយ បាន ស្តារ ទំនាក់ទំនង ឡើងវិញ នៅ ឆ្នាំ ១៩៧៩ ហើយ ក្រសួង កិច្ចការ ផ្ទៃក្នុង នៃ សហព័ន្ធ រុស្ស៊ី បាន ក្លាយជា ដៃគូ ពិភាក្សា អាស៊ាន ណា ប៊ូល នៅ ឆ្នាំ ២០១៤ ៕
រដ្ឋមន្ត្រី ប៉េង ពោធិ៍នា និង ឧកញ៉ា សូ ងួន ដឹកនាំ កិច្ចប្រជុំ ក្រុមការងារ ផ្នែក ដឹកជញ្ជូន និង ហេដ្ឋារចនាសម្ព័ន្ធ ( ក្រុម ច)
( ភ្នំពេញ ) ៖ លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ឧកញ៉ា សូ ងួន សហ ប្រធាន ក្រុមការងារ ផ្នែក ដឹកជញ្ជូន និង ហេដ្ឋារចនាសម្ព័ន្ធ ផ្នែក ឯកជន នា ព្រឹក ថ្ងៃពុធ ទី២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ក្រុមការងារ ផ្នែក ដឹកជញ្ជូន និង ហេដ្ឋារចនាសម្ព័ន្ធ ( ក្រុម “ ច”) នៃ វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន ។
កិច្ចប្រជុំ នេះ បាន ប្រព្រឹត្តទៅ នៅ ទីស្តីការ ក្រសួង ដោយ មាន ការចូលរួម ពី គ្រប់ បណ្តា ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ នៃ ផ្នែក រាជ រដ្ឋាភិបាល និង ផ្នែក ឯកជន នៃ ក្រុមការងារ ផ្នែក ដឹកជញ្ជូន និង ហេដ្ឋារចនាសម្ព័ន្ធ ។
កិច្ចប្រជុំ នេះ មាន គោលបំណង ដោះស្រាយ បញ្ហា ប្រឈម នានា ដែល លើកឡើង ដោយ វិស័យ ឯកជន និង ត្រៀម ជា ធាតុ ចូល សម្រាប់ កិច្ចប្រជុំ វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន លើក ទី១៩ ដែល គ្រោង នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ខាងមុខ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ៕
លោក បណ្ឌិត សុខ ទូច៖ ពិភពលោក បាន ឈានចូល មកដល់ ប្រវត្តិសាស្ត្រ នៃ សង្គ្រាម ត្រជាក់ ទៀត ហើយ និង អាច ក្លាយទៅជា សង្គ្រាម លោក លើក ទី៣
( ភ្នំពេញ ) ៖ លើកឡើង ក្នុង ឱកាស បើក វេទិកា ភ្នំពេញ លើក ទី២ ស្តីពី « អប្បភាគី និយម មជ្ឈភាព អាស៊ាន និង ការប្រកួតប្រជែង មហា អំណាច » ដែល រៀបចំ ដោយ វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា លោក បណ្ឌិត សភាចារ្យ សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន បញ្ជាក់ ថា ចូលមកដល់ សត្សវត្សន៍ នេះ ពិភពលោក បាន ឈានចូល មកដល់ ប្រវត្តិសាស្ត្រ នៃ សង្គ្រាម ត្រជាក់ ទៀត ហើយ ហើយ វា ក៏ នឹង អាច ក្លាយទៅជា សង្គ្រាម លោក លើក ទី៣ នៅពេល ខាងមុខ ក៏ អាច កើត មាន ឡើង ផងដែរ ។
លោក បណ្ឌិត សភាចារ្យ សុខ ទូច បាន បញ្ជាក់ ដូចនេះ ថា « យើង ឈានចូល មកដល់ សត្សវត្សន៍ នេះ វា ឈានចូល មកដល់ ប្រវត្តិសាស្ត្រ នៃ សង្គ្រាម ប្រជាក់ ទៀត ហើយ ហើយ វា ក៏ នឹង អាច ក្លាយទៅជា សង្គ្រាម លោក លើក ទី៣ នៅពេល ខាងមុខ ក៏ អាច កើត មាន ឡើង ផងដែរ » ។
អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន ដាក់ចេញ នូវ គម្រោង ស្តីពី ការសហការ ផលិតភាពយន្ត និង កម្មវិធី ទូរទស្សន៍ ដើម្បី អបអរសាទរ ខួប ៦០ ឆ្នាំ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត រវាង ចិន និង បារាំង
លោក បន្ត ថា « ការបន្ត ជំរុញ សុវត្ថិភាព គុណភាព ផ្នែក ម្ហូប អាហារ គឺជា ការគិតគូរ ជា អាទិភាព របស់ រាជ រដ្ឋាភិបាល និង មាន ការចូលរួមចំណែក យ៉ាង សកម្ម ពីសំណាក់ ដៃគូ អភិវឌ្ឍ និង បណ្តា ភាគី ពាក់ព័ន្ធ ទាំងអស់ ជាក់ស្ដែង គម្រោង TASK PROGRAM នេះ ដែល ជា ការគាំទ្រ ផ្នែក បច្ចេកទេស ពី វិទ្យាស្ថាន ស្រាវជ្រាវ ម្ហូប អាហារ កូរ៉េ បាន បង្កើន ទំនុកចិត្ត ខ្ពស់ សម្រាប់ ទីផ្សារ កូរ៉េ ក៏ ដូច ទីផ្សារ ក្នុង តំបន់ និង សកលលោក ផងដែរ » ។
មុននឹង គម្រោង TASK Program បញ្ចប់ នៅ ចុង ឆ្នាំ ២០២៣ នេះ ភាគី កូរ៉េ បាន ផ្ដល់ ឱកាស ដល់ សហគ្រាស ទាំង ១២ មូលដ្ឋាន បាន ទៅ ធ្វើ ទស្សនៈកិច្ច សិក្សា និង ចូលរួម ការរៀបចំ ការតាំងពិពណ៍ ជា លក្ខណៈ អន្តរជាតិ ផ្នែក ឧស្សាហកម្ម ម្ហូប អាហារ ក៏ ដូចជា មាន ការបង្ហាញ ផលិតផល បច្ចេកទេស និង បច្ចេកវិទ្យា ថ្មី ៗ នៅ សាធារណៈ រដ្ឋ កូរ៉េ ផងដែរ ។
លោក មាន សុភា បាន លើកទឹកចិត្ត ដល់ សហគ្រាស ទាំង ១២ ដែល ត្រូវ ទៅ ធ្វើ ទស្សនៈកិច្ច សិក្សា នៅ ប្រទេស កូរ៉េ សូម យកចិត្ត ទុក ខ្ពស់ ក្នុង ការក្រេប ជញ្ជក់ ចំណេះដឹង ជួយ ផ្សព្វផ្សាយ ផលិតផល របស់ ប្រទេស កម្ពុជា សម្រាប់ ទីផ្សារ កូរ៉េ និង អន្តរជាតិ និង ខិតខំ រៀនសូត្រ យក ចំណេះដឹង និង បទពិសោធន៍ ថ្មី ៗ មក ពង្រីក និង ពង្រឹង សហគ្រាស របស់ ខ្លួន ឲ្យ ក្លាយជា សហគ្រាស គំរូ ដែល ពោរពេញ ដោយ ទំនុកចិត្ត សម្រាប់ អតិថិជន ស្រុក ក៏ ដូច សម្រាប់ ទីផ្សារ អន្តរជាតិ ផងដែរ ។
លោក បន្ថែម ថា បើ ទោះបីជា គម្រោង នេះ បាន បញ្ចប់ នៅ ចុង ឆ្នាំ នេះ ក៏ដោយ តែ តាមរយៈ គម្រោង បង្កើត មជ្ឈមណ្ឌល ស្រាវជ្រាវ ម្ហូប អាហារ កម្ពុជា ភាគី កូរ៉េ នឹង បន្ត ចូលរួមចំណែក លើកកម្ពស់ ឧស្សាហកម្ម ចំណីអាហារ នៅក្នុង ប្រទេស កម្ពុជា បន្ត ៥ឆ្នាំ ទៀត ។
លោក លើកឡើង ថា « យើង ទាំងអស់ គ្នា នឹង ព្យាយាម បង្កើត ជា ឱកាស ក៏ ដូចជា ជំរុញ ការងារ នៅក្នុង គម្រោង នេះ ដើម្បី ផ្តល់ ផលប្រយោជន៍ ដល់ ប្រជាជន កម្ពុជា ក៏ ដូចជា សហគ្រាស នានា ឱ្យ ត្រូវ តាម តម្រូវការ ជាក់ស្តែង »៕
ធនាគារ ជាតិ នៃ កម្ពុជា ជូនដំណឹង ពី ការប្រឡង ជ្រើសរើស និស្សិត ចូលរៀន ថ្នាក់ ប្រកាស នីយបត្រ ជាន់ ខ្ពស់ បច្ចេកទេស ធនាគារ ជំនាន់ ទី ៣៣ ចំនួន ១៥០ នាក់
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា បាន ចេញ ជូនដំណឹង ពី ការប្រឡង ជ្រើសរើស និស្សិត ចូលរៀន ថ្នាក់ ប្រកាស នីយបត្រ ជាន់ ខ្ពស់ បច្ចេកទេស ធនាគារ ជំនាន់ ទី ៣៣ សម្រាប់ ឆ្នាំ សិក្សា ២០២៤ - ២០២៦ នៅ មណ្ឌល សិក្សា បច្ចេកទេស ធនាគារ ។
គួរ បញ្ជាក់ ថា សង្គ្រាម រវាង អ៉ី ស្រាអែល ជាមួយ ក្រុមហា ម៉ាស ប៉ាឡេស្ទីន បាន បង្កើន ការភ័យខ្លាច កាន់តែ ខ្លាំង ឡើង នូវ ភាពចលាចល ក្នុង តំបន់ ជាពិសេស ការដុត បញ្ឆេះ ភាពតានតឹង ដែល មាន ស្រាប់ ជាមួយ ស៉ីរី និង ក្រុម ហេស បូឡា ដែល គាំទ្រ ដោយ អ៉ីរ៉ង់ នៅក្នុង ប្រទេស លីបង់ ៕ រូបភាព ពី Reuters
កិត្តិសង្គហ បណ្ឌិត គន់ គីម អញ្ជើញ ផ្ដល់ ព្រះធរណី បញ្ចុះ សព នាយ ឧត្តមសេនីយ៍ ប្រាក់ វណ្ណឌី នាយក រង ខុទ្ទកាល័យ សម្តេច មហា បវរធិបតី នាយក រដ្ឋមន្ដ្រី
( ក្រចេះ ) ៖ នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម ទេសរដ្ឋមន្រ្តី អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ និង ជា អនុប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា និង លោកស្រី គឹង ចាន់ ឌី នៅ ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ផ្ដល់ ព្រះធរណី បញ្ចុះ សព នាយ ឧត្តមសេនីយ៍ ប្រាក់ វណ្ណឌី នាយក រង ខុទ្ទកាល័យ សម្តេច មហា បវរធិបតី នាយក រដ្ឋមន្ដ្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ ក្នុង ជន្មាយុ ៦៤ ឆ្នាំ ដោយ រោគា ពាធ ។
ពិធី បញ្ចុះ សព នេះ ត្រូវបាន ប្រារព្ធ ធ្វើឡើង នៅ ភូមិ ភូមិ ថ្មី ឃុំ ខ្សាច់ អណ្តែត ស្ថិត ក្នុង ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។ ក្នុង ពិធី នោះ ដែរ មាន ការអញ្ជើញ ចូលរួម ពី លោក ហ៊ុន ម៉ានី រដ្ឋមន្ដ្រី ក្រសួង មុខងារ សាធារណៈ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន មកពី បណ្តា អង្គភាព ។
( ភ្នំពេញ ) ៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ក្រាបបង្គំទូល ថ្វាយ នូវ សារលិខិត ថ្លែងអំណរ ព្រះរាជ គុណ ថ្វាយ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ដែល ព្រះអង្គ សព្វ ព្រះរាជ ហឫទ័យ ប្រោស ព្រះរាជូបត្ថម្ភ នូវ ព្រះរាជ ទ្រព្យ ចំនួន ១ពាន់ ដុល្លារ ចំពោះ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ខែតុលា ឆ្នាំ ២០២៣ ។
គួរ បញ្ជាក់ ថា ទាំង លោក Qin និង Li ត្រូវបាន ក្រុម អ្នកជំនាញ ជឿជាក់ ថា គឺ ប្រធានាធិបតី ចិន លោក ស៉ី ជីន ពីង ជា អ្នក ជ្រើសរើស ដោយ ផ្ទាល់ សម្រាប់ តួនាទី ជា រដ្ឋមន្រ្តី ការបរទេស និង ជា រដ្ឋមន្រ្តី ការពារ ជាតិ ៕ រូបភាព ពី AFP ខណ្ឌ មានជ័យ រៀចំ សិក្ខាសាលា សមាហរណកម្មវិនិយោគ បី ឆ្នាំ រំកិល ឆ្នាំ ២០២៤ - ២០២៦
( ភ្នំពេញ ) ៖ ខណ្ឌ មានជ័យ នា ព្រឹក ថ្ងៃទី ២៣៥ ខែតុលា ឆ្នាំ ២០២៣ បាន រៀចំ សិក្ខាសាលា សមាហរណកម្មវិនិយោគ បី ឆ្នាំ រំកិល ឆ្នាំ ២០២៤ - ២០២៦ របស់ រដ្ឋបាល សង្កាត់ និង ខណ្ឌ ក្រោម វត្ដមាន លោក ហែម ដារិទ្ឋិ អភិបាល ខណ្ឌ មានជ័យ និង មាន ការចូលរួម ពី អភិបាល រង ខណ្ឌ និង លោក អែម សុខ លាង ប្រធាន ក្រុមប្រឹក្សា ខណ្ឌ ចៅសង្កាត់ និង មន្ដ្រី ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
នៅក្នុង ពិធី បើក សិក្ខាសាលា មួយ នេះ អភិបាល ខណ្ឌ មានជ័យ បាន លើកឡើង ថា នៅ ពេល នេះ មាន គម្រោង វិនិយោគ ជា អាទិភាព ដែល មាន ការសន្យា គាំទ្រ យ៉ាង ច្រើន ។ លោក ហែម ដារិទ្ឋិ អភិបាល ខណ្ឌ បាន បញ្ជាក់ ថា « សិក្ខាសាលា នេះ មាន គោលបំណង ផ្សព្វផ្សាយ គម្រោង វិនិយោគ អាទិភាព ៣ឆ្នាំ រំកិល ( ២០២៤ - ២០២៦ ) របស់ រដ្ឋបាល ខណ្ឌ និង ស្នើសុំ ការគាំទ្រ ពី មន្ទីរ អង្គភាព អង្គការ ដៃ គូ អភិវឌ្ឍន៍ នានា ផ្នែក ឯកជន និង សប្បុរសជន ដែល ចាប់អារម្មណ៍ លើ គម្រោង ណា ខ្លះ » ។
លោក អភិបាល ខណ្ឌ មានជ័យ បាន បន្ដ ទៀត ថា អ្នកតំណាង ឱ្យ ស្ថាប័ន សង្គម ស៊ីវិល និង ផ្នែក ឯកជន ព្រមទាំង សប្បុរសជន ទាំងអស់ មាន ការចាប់អារម្មណ៍ លើ គម្រោង ណាមួយ ទោះ តិច ឬ ច្រើន ក្ដី សូម បញ្ជាក់ ការឆ្លើយតប ដើម្បីឱ្យ ក្រុមការងារ របស់ លោក ធ្វើ ការបូកសរុប ចំនួន គម្រោង ដែល មាន ការសន្យា គាំទ្រ ។
លោក ហែម ដារិទ្ឋិ ក៏ បាន លើកឡើង ពី គម្រោង ដែល អនុវត្ដទៅ ទទួលបាន ជោគជ័យ នៅ ថ្នាក់ សង្កាត់ ដោយ មាន ទិន្នន័យ ពិតប្រាកដ លើ ចំនួន គម្រោង និង ថវិកា វិនិយោគ ប្រចាំ ឆ្នាំ នីមួយ ៗ ។
លោក ហែម ដារិទ្ឋិ ក្នុង នាម គណ: អភិបាល ខណ្ឌ បាន អំពាវនាវ ដល់ តំណាង មន្ទីរ អង្គភាព អង្គការ សប្បុរសជន និង ដៃគូ អភិវឌ្ឍន៍ ទាំងអស់ សូម បន្ត ជួយ គាំទ្រ ដល់ គម្រោង កម្មវិធី វិនិយោគ ៣ឆ្នាំ រំកិល របស់ ខណ្ឌ និង គម្រោង ផែនការ អាទិភាព របស់ សង្កាត់ ក្នុង ឆ្នាំ ២០២៤ ជា បន្ត ទៀត ដើម្បី ឆ្លើយតប បាន ទៅនឹង សេចក្តីតម្រូវការ របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ការចូលរួម អនុវត្តន៍ គោល នយោបាយ វិមជ្ឈការ វិសហមជ្ឈការ និង ការអភិវឌ្ឍន៍ តាម បែប ប្រជាធិបតេយ្យ នៅ ថ្នាក់ ក្រោម ជាតិ ឲ្យ កាន់តែ ប្រសើរឡើង ។
សូម បញ្ជាក់ ថា គម្រោង ជា អាទិភាព ឆ្នាំ ២០២៤ ដែល ត្រូវ ដាក់ ស្នើសុំ ការគាំទ្រ នៅក្នុង សិក្ខាសាលា សមាហរណកម្ម នា ពេលនេះ មាន ចំនួន ១០៧ គម្រោង ក្នុង នោះ៖
* ផ្នែក សេដ្ឋកិច្ច មាន ចំនួន ២៥ គម្រោង * ផ្នែក សង្គមកិច្ច មាន ចំនួន ៤៩ គម្រោង * ផ្នែក គ្រប់គ្រង ដីធ្លី ធនធាន ធម្មជាតិ បរិស្ថាន មាន ចំនួន ២១ គម្រោង * ផ្នែក សេវាកម្ម រដ្ឋបាល និង សន្តិសុខ មាន ចំនួន ១២ គម្រោង ៕
សាលាដំបូង ខេត្ត កណ្តាល ចេញ សាលក្រម ផ្តន្ទាទោស លើ ឈ្មោះ ហ៊ ឈាង លីម ជា មន្រ្តី នគរបាល ដាក់ ពន្ធនាការ រយៈពេល ១ ឆ្នាំ
រដ្ឋាភិបាល ថៃ មុន សម្រេចបាន កិច្ចព្រមព្រៀង ដើម្បី ទិញ នាវា មុជទឹក១ គ្រឿង ដំបូង ក្នុង ចំណោម ៣គ្រឿង កាលពី ឆ្នាំ ២០១៧ សម្រាប់ តម្លៃ ៣៧៣. ៥៥លាន ដុល្លារ ។ រីឯ ការបញ្ជាទិញ សម្រាប់ នាវា មុជទឹក២ គ្រឿង ទៀត សម្រាប់ តម្លៃ ៦២២. ៥៨ លាន ដុល្លារ ទទួលបាន ការអនុម័ត ជា បឋម ដោយ គណៈកម្មាធិការ នៃ សភា ថៃ កាលពី ឆ្នាំ ២០២០ ។
( បាត់ដំបង ) ៖ កាកបាទ ក្រហម កម្ពុជា ដែល មាន ហ្លួង ម៉ែ នរោត្តម មុនិនា ថ សីហនុ ជា ព្រះប្រធាន កិត្តិយស និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន នៅ ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន បន្ត ចុះ សួរសុខទុក្ខ និង ផ្តល់ អំណោយ មនុស្សធម៌ ជួយ សម្រាល ការលំបាក ផ្តល់ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង រហ័ស ចំនួន ៤៧២ គ្រួសារ រស់ នៅ ក្រុង ស្រុក ចំនួន ៤គឺ ក្រុង បាត់ដំបង ស្រុក ឯក ភ្នំ ស្រុក សង្កែ និង ស្រុក បាណន់ ខេត្ត បាត់ដំបង ។
ក្នុង ឱកាស ជួប សំណេះសំណាល និង ផ្តល់ អំណោយ មនុស្សធម៌ នា ពេលនេះ ក្រោម អធិបតីភាព លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា និង លោក សុខ លូ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង លោកស្រី ម៉េត រ៉ាវិចិត្រ សុខ លូ អនុប្រធាន កិត្តិយសាខា ព្រមទាំង សមាជិក សមាជិកា គណៈកម្មាធិការ សាខា ក្រុម ប្រតិបត្តិ សាខា អនុសាខា យុវជន កាកបាទ ក្រហម ដែល មាន ចំនួន ៤ទីតាំង គឺ រួម មាន៖
ជាមួយគ្នា នេះ ដែរ លោកស្រី ពុំ ចន្ទីនី បាន ពាំនាំ មក នូវ ព្រះរាជ បន្ទូល និង ប្រសាសន៍ ផ្តាំផ្ញើ សួរសុខទុក្ខ របស់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ហ្លួង ម៉ែ នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដោយ ក្តី នឹករលឹក និង មនោសញ្ចេតនា ជាប់ ជានិច្ច ជាមួយ ប្រជានុរាស្ត្រ កូន ចៅ និង ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ។
ទន្ទឹមនឹង នេះ លោកស្រី អគ្គ លេខាធិការ បាន ពាំនាំ ផ្តាំផ្ញើ នូវ សារ សុខភាព មួយចំនួន ជូន ដល់ បងប្អូន មាន ដូចជា ៖
លោកស្រី អគ្គ លេខាធិការ ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ថ្នាក់ដឹកនាំ សាខា កាកបាទ ក្រហម កម្ពុជា និង ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ ក្នុង ខេត្ត បាត់ដំបង ដែល បាន យកចិត្តិ ទុក្ខ ដាក់ និង បាន ចុះ ពិនិត្យ ស្ថានភាព ទឹក ទំនន់ និង ស្នើសុំ ជំនួយ ពី សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប្រធាន ដើម្បី ជួយ ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ បាន ទាន់ ពេលវេលា ផងដែរ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ លោកស្រី អគ្គ លេខាធិការ បាន ប្រគេន ថវិកា និង គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ជូន វត្ត ក្តាំងងារ វត្ត ស្លា កែត វត្តបួរ ខ្នា និង សូម ថ្លែងអំណរគុណ ចំពោះ ព្រះចៅ អធិការ វត្ត ដែល បាន ផ្តល់ ទីតាំង សម្រាប់ កាកបាទ ក្រហម កម្ពុជា ផ្តល់ អំណោយ មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង រហ័ស នា ពេលនេះ ។
បន្ទាប់ពី បញ្ចប់ កម្មវិធី ផ្តល់ អំណោយ នោ ក្នុង ក្រុង បាត់ដំបង លោកស្រី អគ្គ លេខាធិការ និង សហការី បាន បន្ត នាំយក អំណោយ មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ ចំនួន ១០ខ្នង ផ្ទះ ដែល មិន អាច ធ្វើដំណើរ មក ទទួល អំណោយ បាន ៕
ចាប់ ជនជាតិ វៀតណាម ២នាក់ កាប់ ព្រៃ លិច ទឹក នៅ ស្រុក បរិបូរណ៌ ខេត្ត កំពង់ឆ្នាំង . ប្រជាពលរដ្ឋ សំណូមពរ ដល់ អាជ្ញាធរ និង សមត្ថកិច្ច បង្កើន កិច្ចការពារ ព្រៃ លិច ទឹក
( កំពង់ឆ្នាំង ) ៖ ជនជាតិ វៀតណាម ២នាក់ និង កាណូត សម្រាប់ អូស ដើមឈើ ព្រៃ លិច ទឹក ចំនួន៣ គ្រឿង ត្រូវបាន សមត្ថកិច្ច ជំនាញ ចាប់ ឃាត់ បន្ទាប់ពី ក្រុម អ្នកសារព័ត៌មាន និង ប្រជាពលរដ្ឋ បាន ប្រទះឃើញ ពួកគេ កំពុងតែ លួច កាប់ ព្រៃ លិច ទឹក ក្នុង តំបន់ អភិរក្ស ចង អូស តាម កាណូត បម្រុង យក ទៅ ទម្លាក់ ក្នុង ទន្លេ ធ្វើជា សម្រាស់ ដាក់ ស្ទាក់ ចាប់ ត្រី ហើយក៏ បាន រាយការណ៍ ទៅ សមត្ថកិច្ច ជំនាញ ភ្លាម ៗ ។
ករណី បង្ក្រាប បទល្មើស ការកាប់បំផ្លាញ ព្រៃ លិច ទឹក ក្នុង តំបន់ អភិរក្ស យក ដាក់ ធ្វើជា សម្រាស់ សម្រាប់ ចាប់ ត្រី ខាងលើ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ២០៖០០ នាទី យប់ ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នៅ ចំណុច ព្រែក ថ្លាន់ ( ជា ព្រែក អភិរក្ស ពូជ ត្រី ) ស្ថិត ក្នុង ភូមិសាស្ត្រ ភូមិ ដំណាក់ រាជ្យ ឃុំ កំពង់ ព្រះគគី ស្រុក បរិបូរណ៌ ។
លោក តាត សីហាក់ នាយ ផ្នែក រដ្ឋបាល ជលផល កំពង់ឆ្នាំង នៅ ព្រឹក ថ្ងៃទី ២៥ ខែតុលា នេះ បាន ឲ្យដឹង ថា បន្ទាប់ពី ទទួលបាន សេចក្តីរាយការណ៍ ពី ក្រុម អ្នកសារព័ត៌មាន និង ប្រជាពលរដ្ឋ កម្លាំង ផ្នែក រដ្ឋបាល ជលផល របស់ លោក ក៏ បាន ចុះ ទៅដល់ កន្លែង កើត ហេតុ ភ្លាម ៗ ដែរ ហ្នឹង បាន ឃាត់ខ្លួន ជនល្មើស ជា ជនជាតិ វៀតណាម ដែល បាន ប្រព្រឹត្ត បទ ល្មើស ខាងលើ ចំនួន ២នាក់ និង ទូក សម្រាប់ អូស សណ្ដោង ដើមឈើ ព្រៃ លិច ទឹក ចំនួន ៣គ្រឿង ។ ជនល្មើស ទាំង២នា ក់ រួម មាន៖
វត្ថុតាង ដែល សមត្ថកិច្ច រឹបអូស បាន ក្នុង ពេល ប្រព្រឹត្ត បទ ល្មើស ខាងលើ នេះ រួម មាន៖ កាណូត ៣គ្រឿង ក្នុង នោះ ២ គ្រឿង ជា កាណូត ឈើ និង ១ គ្រឿង ជា ទូក បាឡា ស្មាច់ រួម និង ដើមឈើ ចំនួន ១៥ ដើម ធំ ៗ ដែល គេ កាប់ ក្នុង តំបន់ អភិរក្ស ចង អូស ជាមួយ កាណូត . ពី ដុង ទឹក ចំណុះ ៣០លីត្រ គ្មាន ទឹក ជាច្រើន ដែល សម្រាប់ ចង បណ្ដែត គល់ ឈើ ដើម្បី ងាយស្រួល ក្នុង ការអូស សណ្ដោង តាម ទឹក និង ខ្សែ ជាច្រើន ចង្វាយ សម្រាប់ ចង ដើមឈើ អូស ។
លោក តាត សីហាក់ នាយ ផ្នែក រដ្ឋបាល ជលផល កំពង់ឆ្នាំង បាន ឲ្យដឹង ទៀត ថា ជនល្មើស ទាំង២នាក់ ខាងលើ នេះ ត្រូវបាន ចោទ តាម មាត្រា លេខ ៩៨ ចំណុច ១ នៃ ច្បាប់ ស្ដីពី ជល ផល ដែល ត្រូវ ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ពី ៣ឆ្នាំ ទៅ ៥ ឆ្នាំ និង វត្ថុតាង ត្រូវ រឹបអូស ជា សម្បត្តិ រដ្ឋ ចំពោះ សំណុំរឿ ង និង ជនសង្ស័យ ទាំង២នាក់ នឹង ត្រូវ បញ្ជូន ទៅ តុលាការ នៅ ថ្ងៃ នេះ ផងដែរ ។
ប្រជាពលរដ្ឋ បាន ឲ្យដឹង ថា ខែ នេះ គឺជា រដូវ ដែល អ្នកនេសាទ មួយ ចំនួន គេ ត្រូវការ នេសាទ ដោយ ដាក់ សម្រាស់ តាម ដងទន្លេ ដើម្បីឱ្យ ត្រី ចូល ទុក រយៈពេល ៣ ឬ ៤ខែ ក្រោយមក គេ នឹង យក អួន មក ហ៊ុំព័ទ្ធ ចាប់ យក ត្រី តែម្ដង ។ ចំពោះ ស ម្រាស់ វិញ គឺ ភាគ ច្រើន គេ កាប់ ព្រៃ លិច ទឹក យកមក ដាក់ បណ្ដុំ ធ្វើជា សម្រាស់ ។
( ប៉េកាំង ) ៖ នៅ ថ្ងៃពុធ នេះ ក្រសួង ការពារ ជាតិ ចិន បាន រិះគន់ ចំពោះ របាយការណ៍ ប្រចាំ ឆ្នាំ របស់ មន្ទីរ បញ្ចកោណ ដែល ជា ក្រសួង ការពារ ជាតិ របស់ សហរដ្ឋ អាមេរិក ដោយ និយាយ ថា វា មាន ចេតនា បង្កឱ្យ មាន ការយល់ ខុស មក លើ គោល នយោបាយ ផ្នែក សន្តិសុខ និង យុទ្ធសាស្រ្ត ផ្នែក យោធា របស់ ប្រទេស ចិន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ថ្ងៃពុធ ទី២៥ ខែតុលា ឆ្នាំ ២០២៣ ។
( កំពង់ធំ )៖ នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នៅ ទីបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បាន រៀបចំ កម្មវិធី សំណេះសំណាល និង ត្រួតពិនិត្យ វឌ្ឍនភាព ការអនុវត្ត ការងារ យេនឌ័រ ជាមួយ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ក្រោម អធិបតីភាព លោកស្រី នាយ ឧត្តមសេនីយ៍ ម៉ីមន ដារី អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ ។
ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បាន ឡើង ធ្វើ របាយការណ៍ ស្វាគមន៍ យ៉ាង កក់ក្តៅ ជា ទីបំផុត ចំពោះ ប្រតិភូ ថ្នាក់ដឹកនាំ អគ្គ បញ្ជាការដ្ឋាន បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក និង បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ទី៤ ដែល មាន វត្តមាន នា ឱកាស នេះ ។
ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន គូសបញ្ជាក់ អំពី លទ្ធផល ធំ ៗ មួយចំនួន ដែល អង្គភាព សម្រេចបាន ក្នុង ភារកិច្ចការងារ យេនឌ័រ នៅ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ នា ពេល កន្លងទៅ ។
លោកស្រី ម៉ីមន ដារី បាន ផ្សព្វផ្សាយ សភាពការណ៍ ថ្មី ៗ អន្តរជាតិ និង ការអភិវឌ្ឍន៍ រីកចម្រើន របស់ ព្រះរាជាណាចក្រ កម្ពុជា និង ការកំណែទម្រង់ របស់ កងយោធពល ខេមរភូមិន្ទ ប្រកបដោយ ប្រសិទ្ធភាព ។
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន បង្ហាញ ការសម្រេចចិត្ត យ៉ាង ដាច់អហង្ការ ចំពោះ វិធានការ ផាកពិន័យ លើ អ្នក ល្មើស ច្បាប់ ចរាចរណ៍ ទាំងឡាយ ណា នៅក្នុង ខេត្ត ព្រះសីហនុ ដោយ ត្រូវ អនុវត្ត ចាប់ពី ថ្ងៃទី ១ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ទៅ ។
លោក ថា « អ្នក ល្មើស ច្បាប់ ចរាចរណ៍ ទាំងអស់ ត្រូវ អនុវត្ត តាម ច្បាប់ គ្មាន ការចាប់ ហើយ អប់រំ ណែនាំ នៅនឹង កន្លែង ទៀត នោះ ទេ វិធានការអប់រំ គឺ ទុក ជូន មន្ទីរព័ត៌មាន មន្ទីរ អប់រំ និង មន្ទី ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ដើម្បី ធ្វើ ការផ្សព្វផ្សាយ និង ណែនាំ ជូន សាធារណជន ទាំងអស់ » ។
លោក គួច ចំរើន បាន លើកឡើង បែប នេះ កាលពី ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ ក្នុង កម្ម ពិធី កិច្ចប្រជុំ គណបញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត នៅ សាល ប្រជុំ សាលា ខេត្ត ព្រះសីហនុ ដោយ មាន ការចូលរួម ពី លោក អភិបាល រង ខេត្ត អភិបាល ក្រុង ស្រុក ប្រធាន មន្ទីរ អង្គភាព ពាក់ព័ន្ធ ក្នុង ខេត្ត ព្រះសីហនុ ។
ការដាក់ វិធានការ ផាកពិន័យ គ្មាន ការលើកលែង លើ អ្នក ល្មើស ច្បាប់ ចរាចរណ៍ នេះ ក្នុង គោលបំណង កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ដែល តួរ លេខ នៃ កំណើន គ្រោះថ្នាក់ នេះ នៅតែ បន្ត កើតមាន ច្រើន គួរ កត់សំគាល់ និង ព្រួយបារម្មណ៍ ។
អភិបាល ខេត្ត បាន គូសបញ្ជាក់ ថា ចំពោះ ការផ្សព្វផ្សាយ នេះ គឺ មន្ទីរ ពាក់ព័ន្ធ ត្រូវ ធ្វើ ការផ្សព្វផ្សាយ អប់រំ តាម ទី សាធារណ សាលារៀន ឧត្តម សិក្សា រោងចក្រ សហគ្រាស ប៉ុន្តែ ពេល ចុះ ប្រតិបត្ត ការគឺ គ្មាន ការអប់រំ ឬ លើកលែង ទៀត ទេ ត្រូវតែ អនុវត្ត តាម ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ជាដាច់ខាត ៕ ពលរដ្ឋ ១៨០ គ្រួសារ នៅ ឃុំ ថ្ម ស ខេត្ត កោះកុង ប្រឈម កង្វះ ទឹក ស្អាត ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ខណៈ អ្នក វិនិយោគ ២នាក់ មាន បញ្ហា ជាមួយគ្នា
