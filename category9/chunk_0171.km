( ភ្នំពេញ ) ៖ រហូតមកទល់ ពេលនេះ និស្សិត និង ពលរដ្ឋ ខ្មែរ ទាំងអស់ នៅក្នុង ប្រទេស អ៉ី ស្រាអែល មាន សុវត្តិភាព ទាំងអស់ គ្នា ក្រោម ការសម្របសម្រួល ដោយ យកចិត្តទុកដាក់ ពី រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ក្រសួង កសិកម្ម ព្រមទាំង សមត្ថកិច្ច ពាក់ព័ន្ធ ជាច្រើន ទៀត ។ នេះ បើ តាម ការ ឱ្យដឹង របស់ លោក ប៉ែន បូណា អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ។
លោក ប៉ែន បូណា បាន ប្រាប់ ឲ្យដឹង នៅ ល្ងាច ថ្ងៃចន្ទ នេះ ថា សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន តាមដាន ជាប្រចាំ អំពី សុខ ទុក្ខ របស់ បងប្អូន ខ្មែរ នៅ ទីនោះ មិន ថា ពេល យប់ ឬ ពេល ថ្ងៃ ឡើយ ។
អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ទៀត ថា សម្តេច ធិបតី បាន យកចិត្តទុកដាក់ គ្រប់ បែបយ៉ាង ជាពិសេស លើ សុវត្ថិភាព ដោយ សម្តេច បាន ណែនាំ ឱ្យ សេនាធិការ ទាំងអស់ ប្រើប្រាស់ គ្រប់ លទ្ធភាព ដើម្បី សម្របសម្រួល ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ធ្វើ យ៉ាងណា ឱ្យ ពលរដ្ឋ ខ្មែរ ទាំងអស់ បាន ចៀស ចេញ ពី តំបន់ គ្រោះថ្នាក់ ហើយ ស្ថិត នៅក្នុង តំបន់ សុវត្ថិភាព ដោយ ចាត់ទុក ថា នេះ ជា កិច្ចការ អាទិភាព ខ្ពស់ បំផុត ។
លើស ពី នេះ សម្តេច នាយក រដ្ឋមន្ត្រី ក៏ យកចិត្តទុកដាក់ លើ ជីភាព ប្រចាំ ថ្ងៃ របស់ ពួកគេ ផងដែរ ដើម្បី ប្រាកដ ថា ទាំងអស់ គ្នា មាន ចំណី អាហារ និង ទឹក ព្រមទាំង សម្ភារៈ ចាំបាច់ មួយ ចំនួន ទៀត ដែល បម្រើ ឱ្យ ជីវភាព ប្រចាំ ថ្ងៃ ។
សូម បញ្ជាក់ ជូន ថា មាន ពលរដ្ឋ ខ្មែរ និង និស្សិត ដែល កំពុង ធ្វើ ការ និង សិក្សា នៅ ប្រទេស អ៉ី ស្រាអែល សរុប ប្រមាណ ជា ៤៥០ នាក់ ក្នុង នោះ មាន និស្សិត ម្នាក់ ឈ្មោះ ចាន់ ឧត្តម បាន ទទួលមរណៈភាព កាលពី ថ្ងៃទី ៧តុលា ដោយ ទទួល រងគ្រោះ ពី ការប្រយុទ្ធ គ្នា ដោយ អាវុធ រវាង កងទ័ព អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស់ ។ ក្រៅពី នោះ អ្នក ផ្សេង ទៀត សុទ្ធតែ មាន សុវត្ថិភាព ទាំងអស់ ។
រាជ រដ្ឋាភិបាល សូម អំពាវនាវ ដោយ ទទូច សូម ឱ្យ ពលរដ្ឋ ខ្មែរ ទាំងអស់ នៅក្នុង ប្រទេស អ៉ី ស្រាអែល គោរព ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម ការណែនាំ របស់ អាជ្ញាធរ ម្ចាស់ ប្រទេស ដើម្បី ធានា សុវត្ថិភាព និង សូម ឱ្យ ពួកគេ មាន លំនឹង ក្នុង ចិត្ត ចំពោះ ការយកចិត្តទុកដាក់ ជាប្រចាំ ពី រាជ រដ្ឋាភិបាល ដោយ សហការ យ៉ាង ល្អ ជាមួយ រដ្ឋាភិបាល អ៉ី ស្រាអែល ៕ គម្រោង វិនិយោគ ថ្មី ៗ ចំនួន ៣ទៀត សរុប ទុន វិនិយោគ ជិត ១៣លាន ដុល្លារ ត្រូវបាន អនុម័ត ឲ្យ ដំណើរការ
( ភ្នំពេញ ) ៖ លោក ហេង សួរ រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ០៩ ខែតុលា នេះ បាន ជួប សំណេះសំណាល ជាមួយនឹង លោក PEDRO ZWAHLEN អគ្គ រដ្ឋទូត ស្វីស ប្រចាំ នៅ កម្ពុជា ថៃ ឡាវ នៅ ទីស្តីការ ក្រសួង ។ ក្នុង ជំនួប នោះ លោក រដ្ឋមន្ត្រី ក្រសួង ការងារ បាន ថ្លែងអំណរគុណ ដល់ អគ្គ រដ្ឋទូត ស្វីស ដែល បាន អបអសាទរ ចំពោះ ការតែងតាំង លោក ជា រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ សម្រាប់ អាណត្តិ ទី៧ ។
ក្រៅពី វិស័យ បណ្តុះបណ្តាល វិជ្ជាជីវៈ លោក រដ្ឋមន្ត្រី ក៏ បាន ថ្លែងអំណរគុណ បន្ថែម ទៀត ចំពោះ រដ្ឋាភិបាល ស្វីស ដែល បាន ជួយ គាំទ្រ និង ការបណ្តុះបណ្តាល សមត្ថភាព យុវជន កម្ពុជា ចំពោះ គម្រោង ការទទួលបាន ការងារ សមរម្យ ដែល បាន អនុវត្ត តាំងពី ឆ្នាំ ២០១៧ តាមរយៈ ទីភ្នាក់ងារ ជាតិ និង មុខរបរ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
ក្នុង កិច្ចសន្ទនា ប្រកបដោយ ភាពស្និទ្ធស្នាល នោះ លោក អគ្គ រដ្ឋទូត បាន សន្យា ជាមួយ លោក រដ្ឋមន្ត្រី បន្ត គាំទ្រ ការបណ្តុះបណ្តាល ជំនាញ បច្ចេកទេស ដើម្បី កសាង សមត្ថភាព សិក្ខាកាម កម្ពុជា ឱ្យ រីកចម្រើន បន្ថែម ទៀត ។
ក្រៅពី នេះ ភាគី ទាំង ពីរ បាន ជជែក ពិភាក្សា និង ផ្លាស់ប្តូរ បទពិសោធន៍ ទៅ វិញ ទៅ មក លើ ការបណ្តុះបណ្តាល បច្ចេកទេស វិជ្ជាជីវៈ ដែល មាន ភាពចាំបាច់ ក្នុង ដំណើរការ សង្វាក់ ផលិតកម្ម សេដ្ឋកិច្ច ក្នុង ក្របខណ្ឌ ប្រទេស កម្ពុជា និង ស្វីស ៕
អ្នកគាំទ្រ អ៊ីស្រាអែល និង ប៉ាឡេ ស្ទីន ធ្វើ បាតុកម្ម ប្រជែង គ្នា នៅ ទូទាំង សហរដ្ឋ អាមេរិក ខណៈ សង្គ្រាម នៅ តំបន់ ហ្គាហ្សា នៅ បន្ត កើតមាន
( ញូវយ៉ក ) ៖ អ្នកគាំទ្រ អ៊ីស្រាអែល និង អ្នកគាំទ្រ បុព្វហេតុ ប៉ាឡេ ស្ទីន បាន ចេញ ធ្វើ បាតុកម្ម ប្រជែង គ្នា នៅក្នុង ទីក្រុង ជាច្រើន របស់ សហរដ្ឋ អាមេរិក កាលពី ថ្ងៃអាទិត្យ ជុំវិញ ជម្លោះ ដែល បាន សម្លាប់ មនុស្ស រាប់ រយ នាក់ និង រាប់ ពាន់ នាក់ ផ្សេង ទៀត រងរបួស នៅ មជ្ឈិមបូព៌ា ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃទី ០៩ ខែតុលា ឆ្នាំ ២០២៣ ។
គោលការណ៍ អនុគ្រោះ ទាំង ៩ ចំណុច ចំពោះ សហគ្រាស ធុន តូច និង មធ្យម ដែល សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ដាក់ចេញ រួម មាន៖
ទី២៖ ផ្ដល់ ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ សម្រាប់ សហគ្រាស មីក្រូ ចំពោះ ការចុះបញ្ជី ដោយ ស្ម័គ្រចិត្ត នៅក្នុង ឆ្នាំ ២០២៣ - ២០២៨ ដោយ លើកលែង កម្រៃ សេវា ចុះបញ្ជី ពន្ធដារ និង កម្រៃ សេវា ធ្វើ បច្ចុប្បន្នភាព
ទី៣៖ ផ្តល់ ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ សម្រាប់ សហគ្រាស ធុន តូច ចំពោះ ការចុះបញ្ជី ដោយ ស្ម័គ្រចិត្ត នៅក្នុង ឆ្នាំ ២០២៣ - ២០២៨ តាមរយៈ ( ១ ) ការលើកលែង ពិន័យ ទោសទណ្ឌ និង បំណុល ពន្ធ ចំពោះ ការ មិន បំពេញ អនុលោម ភាព កន្លងមក មុន ការចុះបញ្ជី ( ២) លើកលែង កម្រៃ សេវា ចុះបញ្ជី ពន្ធដារ នឹង កម្រៃ សេវា ធ្វើ បច្ចុប្បន្នភាព នៅពេល ចុះបញ្ជី ( ៣) លើកលែង ពន្ធ លើ ប្រាក់ បំណុល និង ប្រាក់ រំដោះ ពន្ធ លើ ប្រាក់ ចំណូល និង ពន្ធ អប្បបរមា សម្រាប់ ២ឆ្នាំ ក្រោយ ការចុះបញ្ជី ។
ទី៤៖ ផ្តល់ ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ សម្រាប់ សហគ្រាស ធុន និង មធ្យម ចំពោះ ការចុះបញ្ជី ដោយ ស្ម័គ្រចិត្ត ក្នុង ឆ្នាំ ២០២៤ - ២០២៥ តាមរយៈ ( ១) លើកលែង ពិន័យ ទោសទណ្ឌ នឹង បំណុល ពន្ធ ចំពោះ ការ មិន ពេញ អនុលោម ភាព កន្លងមក មុន ការចុះបញ្ជី ( ២) លើកលែង ពន្ធ លើ ប្រាក់ ចំណូល ប្រាក់ រំដោះ ពន្ធ លើ ប្រាក់ ចំណូល ពន្ធ អប្បបរមា សម្រាប់ រយៈពេល ២ ឆ្នាំ ក្រោយ ការចុះបញ្ជី ។
ទី៥៖ ផ្ដល់ ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ សម្រាប់ សហគ្រាស ធុន តូច និង មធ្យម ចំពោះ ការចុះបញ្ជី ដោយ ស្ម័គ្រចិត្ត ក្នុង ឆ្នាំ ២០២៤ - ២០២៥ តាមរយៈ ការលើកលែង ការបង់ ពន្ធ ប៉ាតង់ សម្រាប់ រយៈពេល ២ ឆ្នាំ បន្ទាប់ពី ទទួលបាន ការសម្រេច ចុះបញ្ជី
ទី៦៖ កាត់បន្ថយ ថ្លៃ សេវា សម្រាប់ ការផ្ដល់ សេចក្ដីប្រកាស ជូនដំណឹង បើក សហគ្រាស និង ការចុះបញ្ជិកា សៀវភៅ បញ្ជី ប្រចាំ គ្រឹះស្ថាន និង សៀវភៅ បើក ប្រាក់ខែ សម្រាប់ សហគ្រាស ដែល មាន ចំនួន កម្មករ និយោជិត តិច ជាង ៨នាក់
ទី ៧៖ ពង្រឹង យន្តការ ស្វ័យ ត្រួតពិនិត្យ និង ពង្រឹង ការអនុវត្ត យន្ត ការ ក្រុម អធិការកិច្ច អន្តរ ក្រសួង នៅ ថ្នាក់ ជាតិ ដើម្បី ធានា ការ ចុះ ធ្វើ អធិការ រួមគ្នា ក្នុង ពេល តែ មួយ និង មួយ លើក ក្នុង មួយ ឆ្នាំ
ទី៨៖ រៀបចំ ការត្រួតពិនិត្យ និង ការធ្វើ ការរួមគ្នា ក្នុង ពេល តែ មួយ នឹង តែ មួយ លើក ក្នុង មួយ ឆ្នាំ នៅ ថ្នាក់ ក្រោម ជាតិ សម្រាប់ គ្រប់ សហគ្រាស ដែល បាន ឬ មិន ទាន់ បាន ចុះបញ្ជី ឬ ស្នើ ប័ណ្ណ ឬ លិខិត អនុញ្ញាត ផ្សេង ៗ
ទី៩៖ រៀបចំ បង្កើត បទដ្ឋាន គតិយុត្ត ក្របខណ្ឌ យន្តការ ដែល មាន សកម្មភាព ស្រប ច្បាប់ ជា សហគ្រាស ធុន មីក្រូ និង តូច ដោយ ភ្ជាប់ ជាមួយនឹង អត្ថប្រយោជន៍ ផ្សេង ៗ ដូចជា ការលើកលែង ការបង់ ថ្លៃ សេវា រដ្ឋបាល នានា សម្រាប់ រយៈពេល ៥ឆ្នាំ ជាដើម ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ទៀត ថា ចំពោះ សហគ្រាស ធុន តូច និង មធ្យម ដែល ស្ម័គ្រចិត្ត ចុះឈ្មោះ អាជីវកម្ម គឺ មិន ទទួលបាន ការបង្ខិតបង្ខំ នោះ ទេ តែ គឺ ទទួលបាន ការលើកទឹកចិត្ត ខ្ពស់ ហើយ រាល់ ពេល ការចូលរួម ដោយ ស្ម័គ្រចិត្ត នោះ នឹង ទទួលបាន ការលើកលែង ពន្ធ និង ការលើកលែង ការអនុគ្រោះ នូវ ពិន័យ ផ្សេង ៗ ដែល ពាក់ព័ន្ធ នឹង ការធ្វើអនុលោម ភាព កន្លងមក និង ពន្ធ លើកទឹកចិត្ត ផ្សេង ៗ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ថា ចំពោះ សហគ្រាស ធុន តូច និង មធ្យម ដែល ស្ម័គ្រចិត្ត ចុះឈ្មោះ អាជីវកម្ម ក្រៅពី ការលើកលែងការផាកពិន័យ បំណុល និង ការលើកទឹកចិត្ត ខាង ពន្ធដារ ក៏ នឹង ទទួលបាន លទ្ធភាព ក្នុង ការបណ្តុះបណ្តាល នានា ពាក់ព័ន្ធ នឹង ការអភិវឌ្ឍ ការគ្រប់គ្រង សហគ្រាស ការបណ្តុះបណ្តាល ដល់ បុគ្គលិក និង កម្មករ នៅក្នុង សហគ្រាស ដើម្បី លើកកម្ពស់ សមត្ថភាព ផលិតផល និង សហគ្រាស កាន់តែ រឹងមាំ ដែល នេះ ជា អ្វី ដែល រាជ រដ្ឋាភិបាល ចង់ ផ្តល់ឱ្យ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ដែរ ថា ការចុះបញ្ជី ដោយ ស្ម័គ្រចិត្ត នេះ នឹង ទទួលបាន នូវ ហិរញ្ញប្បទាន ជាមួយនឹង អត្រា ការប្រាក់ សមរម្យ ពី ធនាគារ រដ្ឋ ផងដែរ ក្នុង នោះ ចំពោះ វិស័យ អទិភាព មួយចំនួន ដែល កន្លងមក រដ្ឋ មាន ធនាគារ SMB Bank និង ធនាគារ សហគ្រាស ធុន តូច និង មធ្យម ដែល រាជ រដ្ឋាភិបាល បាន ទម្លាក់ ថវិកា ដើម្បី ជួយ ផ្តល់ ឥណទាន និង ហិរញ្ញា ប្បទាន មួយចំនួន ដែល មាន អត្រា ការប្រាក់ សមរម្យ ដល់ វិស័យ អទិភាព ចំនួន ផងដែរ ។
សម្តេច ធិបតី បាន បញ្ជាក់ ដែរ ថា សម្រាប់ អ្នក ដែល ប្រកបរបរ ខ្លួន ឯង រួម មាន៖ ដូចជា ម្ចាស់ ម៉ូតូ កង់៣ អ្នកលក់ដូរ តាម ផ្លូវ និង ធ្វើ អាជីវកម្ម តូចតាច តាម ផ្លូវ សម្រាប់ ការចុះបញ្ជី គឺ ពិតជា ល្អ ដែល ធ្វើឱ្យ រដ្ឋ បាន ដឹង នេះ និង ដឹង ពី ជីវភាព ក្រីក្រ និង ដឹង ភាពងាយ រងគ្រោះ ហើយ រដ្ឋ នឹង ផ្តល់ ជូន នូវ ការថែទាំ សុខភាព ដោយ ឥត គិត ថ្លៃ តាមរយៈ មូលនិធិ សមធម៍ សុខាភិបាល . ទទួលបាន ការបណ្តុះបណ្តាល ជំនាញ ដោយ ឥត គិត ថ្លៃ និង ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែ រួមទាំង ការជួយ ផ្សេង ៗ ទៀត ផងដែរ ៕
ទីភ្នាក់ងារ សារព័ត៌មាន AFP ដោយ ផ្អែក លើ ប្រភព ដែល ខ្លួន ទទួលបាន ពី អ្នកនាំពាក្យ ម្នាក់ មកពី ក្រុម ប្រដាប់អាវុធ ជនជាតិ ដើម ភាគ តិច កាជីន (Kachin) ដែល គ្រប់គ្រង តំបន់ រង ការវាយប្រហារ ខាងលើ បាន ឱ្យដឹង ទៀត ថា ការវាយប្រហារ នេះ កើត មាន ឡើង នៅ ម៉ោង ប្រហែល ១១៖៣០ នាទី កាលពី យប់ ថ្ងៃចន្ទ សប្ដាហ៍ នេះ ។
សារ រំលែក ទុក្ខ ជាសាធារណៈ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ប្រកាស ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ នៃ យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « តាង នាម ឲ្យ រាជ រដ្ឋាភិបាល និង ក្នុង នាម ខ្លួនខ្ញុំ ផ្ទាល់ ខ្ញុំ សូម ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ជាមួយ គ្រួសារ សព និស្សិត ខ្មែរ យេីង ម្នាក ឈ្មោះ ចាន់ ឧត្តម ដែល បាន បាត់បង់ជីវិត នៅក្នុង ហេតុការណ៍ ប្រយុទ្ធ គ្នា រវាង កងទ័ព អ៉ី ស្រាអែល និង ក័ង ទ័ព ហាម៉ាស់ ដែល បាន ចាប់ ផ្ដេីម កាលពី ថ្ងៃទី ០៧ ខែតុលា កន្លងមក នេះ » ។
ក្រៅពី ការចូលរួម រំលែក ទុក្ខ ចំពោះ អ្នក ដែល បាត់បង់ជីវិត សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ប្រកាស ប្រាប់ ប្រជាពលរដ្ឋ នៅក្នុង ប្រទេស កម្ពុជា ថា សុខ សុវត្ថិភាព របស់ និស្សិត និង ប្រជាពលរដ្ឋ ខ្មែរ ដែល កំពុង រស់ នៅ និង សិក្សា នៅ ប្រទេស អ៉ី ស្រាអែល គឺជា កិច្ចការ អាទិភាព ដ៏ ធំ បំផុត សម្រាប់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច នាយក រដ្ឋមន្ដ្រី . រហូតមកទល់ ពេលនេះ និស្សិត និង ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ នៅក្នុង ប្រទេស អ៉ី ស្រាអែល មាន សុវត្ថិភាព ទាំងអស់ គ្នា ក្រោម ការសម្របសម្រួល ដោយ យកចិត្តទុកដាក់ ពី រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ក្រសួង កសិកម្ម ព្រមទាំង សមត្ថកិច្ច ពាក់ព័ន្ធ ជាច្រើន ទៀត ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន អះអាង ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ខិតខំ ធ្វើការ ជាប់ ជាប្រចាំ ទាំង យប់ ទាំង ថ្ងៃ ដើម្បី ធានា និង សហការ ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ ប្រជាពលរដ្ឋ និង និស្សិត ខ្មែរ ដែល កំពុង រស់ នៅ និង សិក្សា នៅ ទីនោះ ទទួលបាន ការ ការពារ និង មាន សុវត្ថិភាព ខ្ពស់ ។
សូម រំលឹក ថា និស្សិត ម្នាក់ ឈ្មោះ ចាន់ ឧត្តម បាន ទទួលមរណភាព កាលពី ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ ដោយ ទទួល រងគ្រោះ ពី ការប្រយុទ្ធ គ្នា ដោយ អាវុធ រវាង កងទ័ព អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស់ ។ ក្រៅពី នោះ អ្នក ផ្សេង ទៀត សុទ្ធតែ មាន សុវត្ថិភាព ទាំងអស់ ៕
ទេសរដ្ឋមន្រ្តី ព្រុំ សុខា ចុះ ទៅ ពិនិត្យមើល ដំណើរការ សាងសង់ អគារ សិក្សា មួយ ខ្នង ដែល បាន ផ្តល់ ជូន សាលា បឋមសិក្សា ភូមិ ល្អ
( ចិត្រ បុរី - ក្រចេះ ) ៖ លោក ទេសរដ្ឋមន្រ្តី ព្រុំ សុខា រួម ជាមួយ លោ វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ និង ក្រុមការងារ ខេត្ត ក្រចេះ នៅ ពេល ថ្មី ៗ នេះ បាន ចុះ ទៅ ពិនិត្យមើល វឌ្ឍនភាព នៃ ដំណើរការ សាងសង់ អគារ សិក្សា មួយ ខ្នង មាន ៥បន្ទប់ នៅក្នុង សាលា បឋមសិក្សា ភូមិ ល្អ ស្ថិត នៅ ភូមិ ល្អ ឃុំ ច ង្រ្កង់ ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ។
នៅពេល ចុះ ត្រួតពិនិត្យ ក្រុមការងារ បាន សង្កេតឃើញ ថា អគារ សិក្សា ដែល កំពុង ដំណើរការ សាងសង់ សម្រេចបានជា លទ្ធផល ប្រមាណ ៣០ ភាគរយ ហើយ មកដល់ ពេលនេះ ។
ក្នុង ឱកាស នោះ លោក ទេសរដ្ឋមន្រ្តី បាន ថ្លែង គូសបញ្ជាក់ ថា នៅក្នុង អំឡុង ពេល នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត កាលពី ខែកក្ត ដា ឆ្នាំ ២០២៣ នេះ រូប លោក ទេសរដ្ឋមន្រ្តី និង ក្រុមការងារ ខេត្ត ក្រចេះ ដែល ធ្លាប់ បាន សន្យា ជាមួយ ប្រជាពលរដ្ឋ នៅ តំបន់ ក្រីក្រ មួយ នេះ បាន រួមគ្នា ផ្តួចផ្តើម រៀបចំ ពិធី បុណ្យ ផ្កា រស្មី សាមគ្គី មួយ ដែល កៀង គរ ប្រមូល បច្ច័យ ដោយ សទ្ធា ជ្រះថ្លា បាន ចំនួន ប្រាំបី ម៉ឺន ប្រាំ ពាន់ ដុល្លារ អាមេរិក គ្រប់គ្រាន់ សម្រាប់ ការកសាង អគារ សាលា មួយ ខ្នង ទំហំ ១០ម៉ែត្រ x ៤០ម៉ែត្រ មាន ៥បន្ទប់ ។
ការរួមចំណែក ជួយ កសាង អគារ សិក្សា នេះ ឡើង គឺ សំដៅ បំពេញ ភាពខ្វះខាត អគារ សិក្សា សម្រាប់ សិស្សានុសិស្ស នៅ តំបន់ ដាច់ស្រយាល មួយ នេះ ក្រោយពេល លោក ព្រុំ សុខា ដែល ជា រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណ: និង ក្រុមការងារ បាន មកដល់ ទីនេះ នៅ ចុង ឆ្នាំ ២០២០ ហើយ ពេល នោះ ភូមិ ល្អ នេះ ក៏ នៅ មិន ទាន់ បាន រៀបចំ បង្កើត ជា ភូមិ ផ្លូវការ សម្រាប់ ការគ្រប់គ្រង រដ្ឋបាល នៅឡើយ ដែរ ។
ពាក់ព័ន្ធ និង សាងសង់ អគារ សិក្សា នេះ លោក ទេសរដ្ឋមន្រ្តី បាន ជម្រុញ ដល់ ក្រុម ជាង ដែល កំពុងតែ ធ្វើ ការសាងសង់ អគារ សិក្សា នេះ ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ក្នុង ការសាងសង់ ដោយ ការទទួលខុសត្រូវ ខ្ពស់ ទាំង បទដ្ឋាន បច្ចេកទេស ទាំង គុណភាព ល្អ និង រឹងមាំ តាម កម្រិត ស្តង់ដារ បច្ចេកទេស ឲ្យបាន ត្រឹមត្រូវ មុន និង ឈានដល់ ការសម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ថ្ងៃ ខាងមុខ ។
សូម ជម្រាប ថា អគារ សិក្សា មួយ ខ្នង នៅ ភូមិ ល្អ នេះ បាន រៀបចំ ពិធី បញ្ចុះ បឋមសិលា សាងសង់ ពី ខែកក្ត ដា ដោយ ប្រើ រយៈពេល កសាង ៦ខែ ដែល គ្រោង នឹង បញ្ចប់ ការសាងសង់ នៅ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ខាងមុខ ហើយ ការសាងសង់ គឺ អនុលោម តាម ស្តង់ដា វិទ្យាល័យ ព្រះស៊ីសុវត្ថិ រាជធានី ភ្នំពេញ ដែល ត្រូវ ចំណាយ ទឹកប្រាក់ សម្រាប់ ការសាងសង់ សរុប ចំនួន ប្រាំបី ម៉ឺន ប្រាំ ពាន់ ដុល្លារ អាមេរិក ។
ក្នុង ដំណើរ ចុះ ពិនិត្យ ការសាងសង់ អគា សិក្សា នៅ សាលា បឋមសិក្សា ភូមិ ល្អ នេះ លោក ទេសរដ្ឋមន្រ្តី ព្រុំ សុខា ក៏ បាន នាំយក ទេយ្យ ទាន និង បច្ច័យ ប្រគេន ដល់ ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា នៅ វត្ត សិរី មង្គល ហៅ វត្ត ល្អ ក្នុង ពិធី កាន់ បិណ្ឌ ជាមួយ បងប្អូន ពុទ្ធ បរិស័ទ ជិត ឆ្ងាយ ដែល បាន អញ្ជើញ មក ក្នុង ពិធី បុណ្យ នៅ ពេល នោះ ដែរ ។
រហូតមកទល់ ពេលនេះ និស្សិត និង ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ នៅក្នុង ប្រទេស អ៉ី ស្រាអែល មាន សុវត្ថិភាព ទាំងអស់ គ្នា ក្រោម ការសម្របសម្រួល ដោយ យកចិត្តទុកដាក់ ពី រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ក្រសួង កសិកម្ម ព្រមទាំង សមត្ថកិច្ច ពាក់ព័ន្ធ ជាច្រើន ទៀត ។
ការប្រកាស បែប នេះ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតី ប្រកាស ដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ នៃ យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ ។ កម្មវិធី នេះ រៀបចំ ធ្វើឡើង នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ប្រកាស យ៉ាង ដូច្នេះ ថា៖ « សុវត្ថិភាព របស់ ប្រជាពលរដ្ឋ យើង នៅ ប្រទេស អ៉ី ស្រាអែល ជាពិសេស និស្សិត របស់ យើង គឺជា អាទិភាព ធំ បំផុត របស់ រាជ រដ្ឋាភិបាល » ។
ចំពោះ ករណី នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន អះអាង ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ខិតខំ ធ្វើការ ជាប់ ជាប្រចាំ ទាំង យប់ ទាំង ថ្ងៃ ដើម្បី ធានា និង សហការ ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ ប្រជាពលរដ្ឋ និង និស្សិត ខ្មែរ ដែល កំពុង រស់ នៅ និង សិក្សា នៅ ទីនោះ ទទួលបាន ការ ការពារ និង មាន សុវត្ថិភាព ខ្ពស់ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា ចាប់តាំងពី ផ្ទុះ ការវាយប្រហារ រវាង កងទ័ព អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស សម្តេច បាន ដាក់ គោលការណ៍ ឱ្យ ស្ថាប័ន ពាក់ព័ន្ធ របស់ កម្ពុជា ធ្វើ យ៉ាង កំណត់ ឱ្យ បាន ចំនួន ប្រជាពលរដ្ឋ និង និស្សិត កម្ពុជា ដែល កំពុង រស់ នៅ និង សិក្សា នៅ ទីនោះ ដើម្បី ប្រមូល ឱ្យ បាន ច្បាស់ នូវ ព័ត៌មាន របស់ ពួកគាត់ ក្នុង ការផ្តល់ ភាពងាយស្រួល អន្តរាគមន៍ ជួយសង្គ្រោះ ឱ្យ បាន ទាន់ ពេល វេលា ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ថា គិត មក ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ មន្ត្រី ពាក់ព័ន្ធ របស់ កម្ពុជា បាន ក្តាប់ នូវ ព័ត៌មាន ទីតាំង ស្នាក់ នៅ សាលារៀន ព្រមទាំង ចំនួន ជាក់លាក់ គឺ មាន ចំនួន ៤៥៤ នាក់ ក្នុង នោះ បាន ជម្លៀស ចេញ ៣២៣ នាក់ ទៅកាន់ កន្លែង មាន សុវត្ថិភាព និង មាន ចំនួន ១៣១ នាក់ ទៀត កំពុង នៅក្នុង តំបន់ មាន ហានិភ័យ នៅឡើយ ។ ប៉ុន្តែ ករណី នេះ មន្ត្រី កម្ពុជា បាន នឹង បន្ត សហការ ជាមួយ អាជ្ញាធរ អ៉ី ស្រាអែល ដើម្បី ធ្វើ យ៉ាងណា ជម្លៀស ពួកគាត់ មកកាន់ កន្លែង មាន សុវត្ថិភាព ។
សូម បញ្ជាក់ ជូន ថា មាន ប្រជាពលរដ្ឋ ខ្មែរ និង និស្សិត ដែល កំពុង ធ្វើ ការ និង សិក្សា នៅ ប្រទេស អ៉ី ស្រាអែល សរុប ប្រមាណ ជា ៤៥០ នាក់ ក្នុង នោះ មាន និស្សិត ម្នាក់ ឈ្មោះ ចាន់ ឧត្តម បាន ទទួលមរណភាព កាលពី ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ ដោយ ទទួល រងគ្រោះ ពី ការប្រយុទ្ធ គ្នា ដោយ អាវុធ រវាង កងទ័ព អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស់ ។ ក្រៅពី នោះ អ្នក ផ្សេង ទៀត សុទ្ធតែ មាន សុវត្ថិភាព ទាំងអស់ ។
រាជ រដ្ឋាភិបាល កម្ពុជា សូម អំពាវនាវ ដោយ ទទូច សូម ឱ្យ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ នៅក្នុង ប្រទេស អ៉ី ស្រាអែល គោរព ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម ការណែនាំ របស់ អាជ្ញាធរ ម្ចាស់ ប្រទេស ដើម្បី ធានា សុវត្ថិភាព និង សូម ឱ្យ ពួកគេ មាន លំនឹង ក្នុង ចិត្ត ចំពោះ ការយកចិត្តទុកដាក់ ជាប្រចាំ ពី រាជ រដ្ឋាភិបាល ដោយ សហការ យ៉ាង ល្អ ជាមួយ រដ្ឋាភិបាល អ៉ី ស្រាអែល ៕
មាន ចំណាប់អារម្មណ៍ ចុះឈ្មោះ ចូលរៀន សូម ទំនាក់ទំនង៖
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ ប្រកាស ដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ នៃ យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអង្គារ ១១រោច ខែ ភទ្រប ទ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវ នឹង ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋ មន្ត្រី កម្ពុជា បាន អញ្ជើញ ជា អធិបតី ប្រកាស ដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ នៃ យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ ។ កម្មវិធី នេះ រៀបចំ ធ្វើឡើង នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
« សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ » មាន ន័យ ថា ប្រព័ន្ធ នៃ ការធ្វើ ពាណិជ្ជកម្ម ឬ ការដោះដូរ ទំនិញ និង សេវា ដែល ច្បាប់ មិន តម្រូវ ឱ្យ ចុះបញ្ចី ។ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ផ្តល់ នូវ ការបង្កើត មុខរបរ ការងារ ធ្វើ និង ប្រាក់ ចំណូល ប៉ុន្តែ អាច បង្កឱ្យ មាន ផលវិបាក ក្នុង ការគ្រប់គ្រង បរិស្ថាន សុវត្ថិភាព ចំណី អាហារ ការប្រមូល ពន្ធ ជាដើម ។
នៅក្នុង ឱកាស នោះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង សុន្ទរកថា រយៈពេល ប្រមាណ ៤០ នាទី . ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ៖
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ចូលរួម មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ គ្រួសារ និស្សិត ខ្មែរ ដែល បាន ស្លាប់ បាត់បង់ជីវិត ក្នុង ការប្រយុទ្ធ គ្នា រវាង អ៉ី ស្រាអែល និង ហាម៉ាស់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ប្រកាស ថា សុវត្ថិភាព និស្សិត និង ប្រជាពលរដ្ឋ នៅ អ៉ី ស្រាអែល គឺជា កិច្ចការ អាទិភាព និង សំខាន់ បំផុត សម្រាប់ រាជ រដ្ឋាភិបាល ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ទាំង សេដ្ឋកិច្ច ក្នុង និង ក្រៅ ប្រព័ន្ធ សុទ្ធតែ ជា ប្រជាពលរដ្ឋ ខ្មែរ ដែល ទាមទារ ឱ្យ រាជ រដ្ឋាភិបាល យកចិត្តទុកដាក់ ខ្ពស់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា និស្សិត និង ពលរដ្ឋ នៅ អ៉ី ស្រាអែល មាន ចំនួន ៤៥៤ នាក់ ក្នុង នោះ ជម្លៀស ទៅ កន្លែង សុវត្ថិភាព ៣២៣ នាក់ និង ជាង ១០០ នាក់ ទៀត មិន ទាន់ បញ្ជូន ទៅ តំបន់ សុវត្ថិភាព នៅឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ នឹង ផ្តោត ជា សំខាន់ ទៅ លើ ជីវភាព របស់ ប្រជាពលរដ្ឋ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា « យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ » ជា យុទ្ធសាស្ត្រ ព្រួញ មួយ បាញ់ បាន សត្វ បី ។ សត្វ ទាំង បី នោះ គឺ៖ កាត់បន្ថយ ភាពក្រីក្រ និង វិសមភាព សង្គម . ពង្រឹង ភាពធន់ នៃ សេដ្ឋកិច្ច និង កំណើន សេដ្ឋកិច្ច ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ទ្រឹស្តី យុទ្ធសាស្ត្រ ល្អ ហើយ តែ ការធ្វើឱ្យ ចេញ ជា លទ្ធផល ជាក់ស្តែង ទើប ជា រឿង សំខាន់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា « យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ » មិន មាន ចរិត បង្ខំឱ្យ ប្រជាពលរដ្ឋ ចូលរួម ចុះបញ្ជី នោះ ឡើយ តែ លើកទឹកចិត្ត ឱ្យ ចូលរួម ដើម្បី រាជ រដ្ឋាភិបាល អាច គ្រប់គ្រង ទិន្នន័យ បាន ច្បាស់លាស់ ហើយ អាច ដាក់ កិច្ចអន្តរាគមន៍ នានា បាន រហ័ស និង មាន ប្រសិទ្ធភាព ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការចុះបញ្ជី អាជីវកម្ម របស់ សហគ្រាស ធុន តូច និង មធ្យម គឺ យុទ្ធសាស្ត្រ ឈ្នះ - ឈ្នះ ពោល ឈ្នះ ទាំង រដ្ឋ ឈ្នះ ទាំង ម្ចាស់ សហគ្រាស ហើយ ជាតិ ក៏ ឈ្នះ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ប្រឹងប្រែង អនុវត្តន៍ ឱ្យ ជោគជ័យ នូវ « យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ឆ្នាំ ២០២៣ - ២០២៨ » ។
អតីត មន្ត្រី ជាន់ ខ្ពស់ បក្ស ប្រឆាំង ២រូប ត្រូវ ប្រកាស បញ្ចូល ជា សមាជិក គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ
សមាជិក គណបក្ស រាជធានី ភ្នំពេញ ទាំង ២រូប រួម មាន៖
ទី១៖ លោកស្រី វន រុន្នី អតីត ប្រធាន ចលនា ស្ត្រី ថ្នាក់ ជាតិ និង ជា សមាជិក គណៈកម្មាធិការ នាយក បក្ស ភ្លើង ទៀន
និង ទី២៖ លោក គឹម សុភា អតីត សមាជិក គណៈកម្មាធិការ នាយក និង ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ភ្លើង ទៀន រាជធានី ភ្នំពេញ
សូម ជម្រាប ថា លោកស្រី វង រុន្នី និង លោក គឹម សុភា បាន ប្រកាស លា លែង គណបក្ស ភ្លើង ទៀន ហើយ បាន ស្នើសុំ ចូលរួម ជីវភាព ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ៕
អភិបាល រង ខេត្ត ព្រៃវែង ២រូប ត្រូវបាន ប្រកាស ចូលកាន់ មុខតំណែង
អភិបាល រង ខេត្ត ថ្មី ចំនួន ២ រូប នេះ មាន៖ លោក ពេជ្រ សុត្ថា រ័ត្ន ឋានៈ ឧត្តម មន្ត្រី ថ្នាក់ លេខ ៤ និង លោក ស្រី ឡុង គន្ធា ឋានន្តរស័ក្កិ គ្រូបង្រៀន កម្រិត ឧត្តម ដើម ខ្សែ ថ្នាក់ លេខ ៤ នៃ ក្របខណ្ឌ គ្រូបង្រៀន កម្រិត ឧត្តម ក្រសួង អប់រំ យុវជន និង កីឡា ។
លោក អភិបាល ខេត្ត ផ្តាំផ្ញើ ដល់ អភិបាល រង ខេត្ត ដែល ប្រកាស់ តែងតាំង ថ្មី នេះ ត្រូវ បំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន ឲ្យបាន ល្អ និង ខិតខំ បំពេញ ការងារ តាម មុខងារ វិជ្ជាជីវៈ របស់ ខ្លួន ឲ្យ អស់ ពី លទ្ធភាព ធ្វើ យ៉ាងណា ដើម្បី បម្រើ ផលប្រយោជន៍ ជូន បងប្អូន ប្រជាពលរដ្ឋ ។
លោក ប្រាក់ សំអឿន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការខិតខំ ប្រឹងប្រែង របស់ រដ្ឋបាល ខេត្ត ព្រៃវែង ក្នុង ការជំរុញ ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ថែរក្សា សន្តិសុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ដែល សមិទ្ធផល នេះ បាន ចូលរួម ថែរក្សា សុខ សន្តិភាព បន្ត បង្កើន កំណើន សេដ្ឋកិច្ច ជាតិ បង្ក លក្ខណៈ សម្បត្តិ លើកស្ទួយ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ។
លោក បាន បន្ត ថា ការប្រកាស ចូលកាន់ មុខតំណែង អភិបាល រង ខេត្ត ទាំង ២ រូប នា ពេលនេះ គឺ សង្ឃឹម ថា នឹង អនុវត្តន៍ បំពេញ ភារកិច្ច សិក្សា ស្រាវជ្រាវ ឈ្វេងយល់ បន្ត ចូលរួម គ្រប់គ្រង អភិវឌ្ឍន៍ ខេត្ត ព្រៃវែង បង្កើត បាន នូវ សមិទ្ធផល ថ្មី ៗ បន្ថែម ទៀត ។
រដ្ឋបាល ខេត្ត សៀមរាប បើក កិច្ចប្រជុំ សាមញ្ញ លើក ទី ៥៣ របស់ ក្រុមប្រឹក្សា ខេត្ត អាណត្តិ ទី៣ ឆ្នាំ ២០២៣
( សៀមរាប ) ៖ នៅ ថ្ងៃទី ០៩ ខែតុលា ឆ្នាំ ២០២៣ នេះ លោក អ៊ាន ឃុន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ប្រាក់ សោភ័ណ អភិបាល ខេត្ត សៀមរាប បាន ដឹកនាំ បើក កិច្ចប្រជុំ សាមញ្ញ លើក ទី ៥៣ របស់ ក្រុមប្រឹក្សា ខេត្ត អាណត្តិ ទី៣ ឆ្នាំ ២០២៣ និង បាន លើក យក របៀបវារៈ ចំនួន ៥ ដើម្បី ធ្វើ ការពិនិត្យ ពិភាក្សា និង អនុម័ត ។
កិច្ចប្រជុំ ត្រូវបាន ធ្វើឡើង ដោយ មាន ការចូលរួម ពីសំណាក់ លោក លោកស្រី ជា សមាជិក សមាជិកា នៃ ក្រុមប្រឹក្សា ខេត្ត លោក លោកស្រី ជា នាយក នាយក រង រដ្ឋបាល ខេត្ត នាយក នាយក រង ទី ចាត់ការ ចំណុះ សាលា ខេត្ត តំណាង អាជ្ញាធរ ជាតិ អប្សរា មេបញ្ជាការ មេបញ្ជាការ រង កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ អភិបាល អភិបាល រង ក្រុង - ស្រុក ប្រធាន - អនុប្រធាន មន្ទីរ - អង្គភាព នានា ក្នុង ខេត្ត ជាច្រើន រូប ទៀត ។
កិច្ចប្រជុំ នា ពេលនេះ បាន លើក យក របៀបវារៈ ចំនួន ៥ ដើម្បី ធ្វើ ការពិនិត្យ ពិភាក្សា និង អនុម័ត ក្នុង នោះ រួម មាន៖
ថ្លែង ក្នុង ឱកាស នោះ ដែរ លោក អ៊ាន ឃុន បាន លើកឡើង ថា ក្នុង រយៈពេល ៩ខែ នៃ ឆ្នាំ ២០២៣ នេះ រដ្ឋបាល ខេត្ត បាន ខិតខំ យកចិត្តទុកដាក់ ក្នុង ការបំពេញ ភារកិច្ច លើ គ្រប់ វិស័យ បាន យ៉ាង ល្អ ប្រសើរ ពិសេស ការបម្រើ សេវា សាធារណៈ ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ និង ការងារ អភិវឌ្ឍ មូលដ្ឋាន បាន យ៉ាង ល្អ ទោះបី មាន បញ្ហា ខ្លះ ៗ តែ អាជ្ញាធរ យើង ពុះពារ ដោះស្រាយ បាន មួយចំនួន ធំ ។
ជាមួយ នេះ ដែរ លោក ប្រាក់ សោភ័ណ ក៏ បាន ស្នើ ដល់ អាជ្ញាធរ ជាតិ អប្សរា ត្រូវ ផ្សព្វផ្សាយ ឲ្យបាន ទូលំទូលា ជុំវិញ ការស្នើសុំ ថត រូប នៅក្នុង តំបន់ អប្សរា ពីសំណាក់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ផងដែរ ៕ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ចេញ អនុក្រឹត្យ ស្ដីពី ការកែសម្រួល មាត្រា មួយចំនួន ស្ដីពី ឯកសណ្ឋាន ស្លាកសញ្ញា និង ទង់ ជ័យ នៃ កងកងយោធពល ខេមរភូមិន្ទ
( ភ្នំពេញ ) ៖ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ចេញ អនុក្រឹត្យ ស្ដីពី ការកែសម្រួល មាត្រា ៣២ និង មាត្រា ៤០ នៃ អនុក្រឹត្យ លេខ ១២ អន ក្រ. បក ឆ្នាំ ២០១៧ និង មាត្រា ១៣ ថ្មី នៃ អនុក្រឹត្យ លេខ ២២១ អន ក្រ. បក ឆ្នាំ ២០១៩ ស្ដីពី ឯកសណ្ឋាន ស្លាកសញ្ញា និង ទង់ ជ័យ នៃ កងកងយោធពល ខេមរភូមិន្ទ ។
ចាប់ពី នៅ ថ្ងៃទី ១០ ដល់ ថ្ងៃទី ១២ ខែតុលា៖ * បណ្តា ខេត្ត នៅ ភាគ ពាយ័ព្យ ជាប់ នឹង ប្រទេស ថៃ អាច មាន ភ្លៀង ធ្លាក់ នៅក្នុង កម្រិត ពី មធ្យម ទៅ បង្គួរ លាយឡំ ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់ ជាមួយនឹង ទំហំ ទឹកភ្លៀង ធ្លាក់ គ្របដណ្តប់ លើ ផ្ទៃដី ពី ៧០ - ៨០% ។
* ចំណែក រាជធានី ភ្នំពេញ និង បណ្តា ខេត្ត ដទៃ ទៀត អាច មាន ភ្លៀង ធ្លាក់ នៅក្នុង កម្រិត ពី ខ្សោយ ទៅ មធ្យម និង មាន ផ្នែក ខ្លះ មាន ភ្លៀង បង្គួរ លាយឡំ ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់ ជាមួយនឹង ទំហំ ទឹកភ្លៀង ធ្លាក់ គ្របដណ្តប់ លើ ផ្ទៃដី ពី ៤០ - ៦០% ៕ ឥណ្ឌូណេស៊ី រំពឹង នឹង ចុះហត្ថលេខា កម្ចី ផ្លូវ ដែក ៥៦០ លាន ដុល្លារ ពី ប្រទេស ចិន នៅ សប្តាហ៍ ក្រោយ
( ហ្សាការតា ) ៖ មន្ត្រី ឥណ្ឌូណេស៊ី បាន និយាយ កាលពី ថ្ងៃចន្ទ ឥណ្ឌូណេស៊ី រំពឹង ថា នឹង ចុះហត្ថលេខា លើ ប្រាក់ កម្ចី ដែល ពន្យា ពេល ជា យូរ មកហើយ ចំនួន ៥៦០ លាន ដុល្លារ អាមេរិក ជាមួយ ប្រទេស ចិន ក្នុង វេទិកា ខ្សែក្រវ៉ាត់ និង ផ្លូវ (BRF) នៅ ទីក្រុង ប៉េកាំង សប្តាហ៍ ក្រោយ នេះ ដែល ទឹកប្រាក់ នេះ នឹង គ្របដណ្តប់ លើ ការចំណាយ ដែល កើនឡើង សម្រាប់ គម្រោង ផ្លូវ រថភ្លើង ល្បឿន លឿន ទី មួយ របស់ ប្រទេស នេះ ។
ប្រាក់ កម្ចី ថ្មី នេះ គឺ បន្ថែម លើ ប្រាក់ កម្ចី ដែល ផ្តល់ ជូន នៅ ឆ្នាំ ២០១៧ ចំនួន ៤. ៥៥ ពាន់ លាន ដុល្លារ ដែល ធនាគារ អភិវឌ្ឍន៍ ចិន បាន អនុម័ត សម្រាប់ ក្រុមហ៊ុន ភាពជាដៃគូ នេះ ។ ប្រាក់ កម្ចី នោះ មាន អាយុកាល ៤០ ឆ្នាំ ដោយ មាន រយៈពេល អនុគ្រោះ ១០ ឆ្នាំ និង អត្រា ការប្រាក់ ២ភាគរយ ក្នុង មួយ ឆ្នាំ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ៕
ថ្ងៃ នេះ បិណ្ឌ ១១ ! សូម ឈ្វេងយល់ ប្រវត្តិ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ និង កាន់ បិណ្ឌ ដែល ជា ទំនៀមទម្លាប់ ប្រជាជន ខ្មែរ
សូម កុំ ប្រើ ទូរស័ព្ទ ពេល កំពុង បើកបរ ! ស្លាប់ ៣នាក់ និង របួស ១៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៩ ខែតុលា ម្សិលមិញ
