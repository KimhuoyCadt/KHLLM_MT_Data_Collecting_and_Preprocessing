( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៣៧នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៣៧នាក់ នោះ មាន ១៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៤ករណី និង ជនសង្ស័យ ១៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ១១ករណី ។
អ្នក ឧកញ៉ា គិត ម៉េង ដឹកនាំ គណៈប្រតិភូសភា ពាណិជ្ជកម្ម កម្ពុជា អម ដំណើរ សម្តេច បវរធិបតី ហ៊ុន ម៉ាណែត ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន - ក្រុមប្រឹក្សា កិច្ចសហប្រតិបត្តិការ ឈូង សមុទ្រ នៅ អារ៉ាប៊ី សាអូឌីត
ក្នុង កំឡុង ពេល នៃ ដំណើរទស្សនកិច្ច នេះ អ្នក ឧកញ៉ា គិត ម៉េង និង គណៈប្រតិភូសភា ពាណិជ្ជកម្ម កម្ពុជា នឹង ចូលរួម កិច្ចប្រជុំ ធុរកិច្ច និង វិនិយោគ ផ្សេង ៗ ទៀត ដើម្បី ពង្រឹង និង ពង្រីក ទំនាក់ទំនង ក៏ ដូចជា តភ្ជាប់ ធុរកិច្ច រវាង កម្ពុជា និង អារ៉ាប៊ី សាអូឌីត ៕ សេដ្ឋកិច្ច ចិន កើនឡើង ជិត ៥ភាគរយ នៅ ត្រីមាស ទី៣ ឆ្នាំ នេះ
( ប៉េកាំង ) ៖ សេដ្ឋកិច្ច ចិន កើនឡើង ក្នុង កម្រិត លឿន ជាង ការរំពឹងទុក នៅ ត្រីមាស ទី៣ ឆ្នាំ នេះ ខណៈ ការប្រើប្រាស់ និង សកម្មភាព ឧស្សាហកម្ម នៅក្នុង ខែកញ្ញា ក៏ កើនឡើង ផងដែរ ដោយ បង្ហាញ ថា វិធានការ គោល នយោបាយ ថ្មី ៗ កំពុង ជួយ ជំរុញ ការស្ទុះ ងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ។
ការចុះខ្សោយ យ៉ាង ឆាប់រហ័ស នៃ កំណើន សេដ្ឋកិច្ច របស់ ប្រទេស មហា អំណាច សេដ្ឋកិច្ច ធំ ទី ពីរ នេះ ចាប់តាំងពី ត្រីមាស ទី២ បាន ជំរុញ ឱ្យ អាជ្ញាធរ បង្កើន វិធានការ គាំទ្រ សេដ្ឋកិច្ច របស់ ពួកគេ ដោយ ទិន្នន័យ នៅ ថ្ងៃពុធ សប្តាហ៍ នេះ បាន បង្ហាញ ថា វិធានការជំរុញ ទាំងនេះ កំពុង ចាប់ផ្តើម បង្ហាញ ឥទ្ធិពល ទោះបីជា វិបត្តិ អចលន ទ្រព្យ និង បញ្ហា ផ្សេង ទៀត នៅតែ បន្ត បង្កើត ហានិភ័យ ចំពោះ ចក្ខុវិស័យ សេដ្ឋកិច្ច ក៏ដោយ ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ដោយ ដកស្រង់ ទិន្នន័យ ដែល ចេញផ្សាយ ដោយ ការិយាល័យ ស្ថិតិ ជាតិ ចិន កាលពី ថ្ងៃពុធ ថា ផលិតផល ក្នុង ស្រុក សរុប (GDP) របស់ ចិន បាន កើនឡើង ៤.៩ភាគរយ នៅ ត្រីមាស ទី៣ ធៀប នឹង រយៈពេល ដូចគ្នា កាលពី ឆ្នាំ មុន ខណៈ ដែល ការរំពឹងទុក របស់ អ្នកវិភាគ នៅក្នុង ការស្ទង់ មតិ របស់ ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ថា មាន កំណើន តែ ៤.៤ភាគរយ ប៉ុណ្ណោះ ។ ទោះជា យ៉ាងណា កំណើន សេដ្ឋកិច្ច នៅ ត្រីមាស ទី៣ នេះ មាន កម្រិត ទាប ជាង អត្រា ៦.៣ភាគរយ ដែល សម្រេចបាន នៅ ត្រីមាស ទី ពីរ ។
បើ ធៀប នឹង ត្រី មាស និង ត្រី មាស ក្នុង ឆ្នាំ ដូចគ្នា វិញ កំណើន សេដ្ឋកិច្ច នៅ ត្រីមាស ទី៣នេះ បាន កើនឡើង ១.៣ភាគរយ ពោលគឺ កើនឡើង ពី ០.៥ភាគរយ នៅក្នុង ត្រីមាស ទី ពីរ និង ខ្ពស់ ជាង ការព្យាករ ដែល ថា មាន កំណើន ១ភាគរយ ។
EDC ជូនដំណឹង ពី ការរអាក់រអួល ចរន្ត ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ២២ ខែតុលា ដើម្បី រុះរើ គន្លង ខ្សែ បណ្តាញ ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០២៣ ដល់ ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២៣ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
( វ៉ាស៊ីនតោន ) ៖ កាលពី ថ្ងៃទី ៧ ខែតុលា ក្រុមហា ម៉ាស ប៉ាឡេ ស្ទីន គ្រប់គ្រង តំបន់ ហ្កាហ្សា (Gaza) បាន បើក ការវាយប្រហារ ទ្រង់ទ្រាយ ធំ ដ៏ ភ្ញាក់ផ្អើល មួយ លើ តំបន់ ភាគ ខាងត្បូង នៃ ប្រទេស អ៉ី ស្រាអែល ដែល ជា ការវាយប្រហារ ដ៏ ប្រល័យ មួយ ក្នុង ប្រវត្តិសាស្ត្រ អ៉ី ស្រាអែល ។ ភ្លាម ៗ នោះ ដែរ អ៉ី ស្រាអែល បាន ប្រកាស សង្រ្គាម លើ ក្រុមហា ម៉ាស ជាមួយ ការទម្លាក់ គ្រាប់បែក សងសឹក យ៉ាង សាហាវ អស្ចារ្យ លើ តំបន់ ហ្កាហ្សា ជា ទី ដែល ប្រជាជន ប៉ាឡេស្ទីន ច្រើន ជាង ២លាន នាក់ រស់ នៅ ។
ខណៈ អំពើហិង្សា កាន់តែ កើនឡើង អង្គការ អន្តរជាតិ ខាង កិច្ចការ មនុស្សធម៌ ជាច្រើន បាន អំពាវនាវ ឱ្យ មាន ការផ្ដល់ ជំនួយ មនុស្សធម៌ ជាបន្ទាន់ ចូល ទៅកាន់ តំបន់ ហ្កាហ្សា និង បង្កើត ច្រក របៀង មនុស្សធម៌ មួយ សម្រាប់ ជនភៀសខ្លួន ។
កាលពី ថ្ងៃទី ១២ ខែតុលា រដ្ឋមន្ត្រី ថាមពល អ៉ី ស្រាអែល បាន បញ្ជាក់ ថា អគ្គិសនី ប្រេងឥន្ធនៈ និង ទឹក នឹង មិន ត្រូវបាន ផ្គត់ផ្គង់ ឡើងវិញ នោះ ទេ រហូត ទាល់តែ ចំណាប់ខ្មាំង ជាង ១៩៩ នាក់ ត្រូវបាន ក្រុមហា ម៉ាស ដោះលែង ។
ឥណ្ឌូនេស៊ី និង ម៉ាឡេស៊ី ចូលរួមការថ្កោលទោស ជា សកល ចំពោះ ការវាយប្រហារ លើ មន្ទីរពេទ្យ ហ្គាហ្សា (Video inside) ( ហ្សាការតា ) ៖ ប្រទេស ឥណ្ឌូនេស៊ី និង ម៉ាឡេស៊ី នៅ ថ្ងៃពុធ នេះ បាន ចូលរួមការថ្កោលទោស ជា សាកល ចំពោះ ការវាយប្រហារ តាម អាកាស កាលពី យប់ មិញ របស់ អ៊ីស្រាអែល ទៅ លើ មន្ទីរពេទ្យ មួយ នៅ តំបន់ ហ្គាហ្សា ស្ទ្រីប ដែល បាន សម្លាប់ ជន ស៊ីវិល ប៉ាឡេស្ទីន រាប់ រយ នាក់ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០២៣ ។
គួរ បញ្ជាក់ ថា យ៉ាងហោចណាស់ មនុស្ស ៥០០ នាក់ ត្រូវបាន សម្លាប់ កាលពី ថ្ងៃអង្គារ នៅក្នុង ការវាយប្រហារ តាម អាកាស របស់ អ៊ីស្រាអែល ទៅ លើ មន្ទីរពេទ្យ Ahli Arab នៅ កណ្តាល ហ្គាហ្សា ជាមួយនឹង រូបភាព ដែល ត្រូវបាន ចែករំលែក នៅលើ ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម បង្ហាញ ពី ការខូចខាត យ៉ាង ធ្ងន់ធ្ងរ ដោយ ភ្លើង បាន ឆាបឆេះ អគារ និង សាកសព រាយប៉ាយ ពាសពេញ ។
ការវាយប្រហារ នេះ ដែល បាន កើតឡើង ចំ ពេល ដែល អ៊ីស្រាអែល កំពុង បន្ត វាយលុក លើ ជន ស៊ីវិល នៅ តំបន់ ហ្គាហ្សា ដែល បាន ទាក់ទាញ ការថ្កោលទោស ជា អន្តរជាតិ យ៉ាង ឆាប់រហ័ស ទាំង ពី អារ៉ាប៊ី សាអូឌីត ហ្ស៊កដានី និង អារ៉ាប់ រួម ផងដែរ ។
ក្រសួង ការបរទេស ឥណ្ឌូណេស៊ី បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា « ឥណ្ឌូនេស៊ី ថ្កោល ទោស យ៉ាង ខ្លាំង ចំពោះ ការវាយប្រហារ របស់ អ៊ីស្រាអែល លើ មន្ទីរពេទ្យ Al-Ahly Al-Arabi ក្នុង តំបន់ ហ្គាហ្សា ដែល បាន សម្លាប់ ជន ស៊ីវិល រាប់ រយ នាក់ ។ ការវាយប្រហារ នេះ គឺជា ការរំលោភ យ៉ាង ច្បាស់ លើ ច្បាប់ មនុស្សធម៌ អន្តរជាតិ ។ ហើយ ក្រុមប្រឹក្សា សន្តិសុខ អន្តរជាតិ ត្រូវ ចាត់ វិធានការ ជាក់ស្តែង ភ្លាម ៗ ដើម្បី បញ្ចប់ ការវាយប្រហារ និង អំពើហិង្សា នៅ ហ្គាហ្សា » ។
ក្រសួង បាន និយាយ ទៀត ថា « ភាពអយុត្តិធម៌ ប្រឆាំង នឹង ប្រជាជន ប៉ាឡេស្ទីន បាន អូសបន្លាយ យូរ ពេក ហើយ » ហើយ វា ជា ពេលវេលា សម្រាប់ ពិភពលោក ដើម្បី « ផ្តល់ អាទិភាព ដល់ សន្តិភាព សម្រាប់ ប៉ាឡេស្ទីន » ។
នាយក រដ្ឋមន្ត្រី ម៉ាឡេស៊ី លោក អាន់វ៉ា អ៊ីប្រាហ៊ីម ក៏ បាន អំពាវនាវ ឱ្យ បញ្ចប់ ការវាយប្រហារ នេះ ផងដែរ ។ លោក បន្ត ថា លោក នឹង ពិភាក្សា អំពី ស្ថានភាព នៅ តំបន់ ហ្គាហ្សា ក្នុង កំឡុង ដំណើរទស្សនកិច្ច របស់ លោក ទៅកាន់ ទីក្រុង Riyadh សម្រាប់ កិច្ចប្រជុំ កំពូល រួម លើក ដំបូង រវាង សមាគម ប្រជាជាតិ អាស៊ី អាគ្នេយ៍ និង ក្រុមប្រឹក្សា សហប្រតិបត្តិការ ឈូង សមុទ្រ នៅ ថ្ងៃសុក្រ សប្តាហ៍ នេះ ៕
នេះ បើ យោង តាម របាយការណ៍ ផ្លូវការ ពី ក្រសួង សុខាភិបាល ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃ នេះ ៕ ប្រកាស ទទួលស្គាល់ ប្រធាន អនុប្រធាន គណៈ កិត្តិយស សាខា និង ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រៃវែង អាណត្តិ ទី៥
( ព្រៃវែង ) ៖ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រៃវែង នៅ ព្រឹក ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ធ្វើ ពិធី ប្រកាស ទទួលស្គាល់ ប្រធាន អនុប្រធាន គណៈ កិត្តិយស សាខា និង ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រៃវែង អាណត្តិ ទី៥ ក្រោម អធិបតីភាព លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា តំណាង ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ។
ដោយឡែក សេចក្តីសម្រេច មួយ ទៀត គឺ បាន ទទួលស្គាល់ សមាសភាព គណៈកម្មាធិការ នៃ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រៃវែង អាណត្តិ ទី៥ ដែល ក្នុង ជួរ គណៈកម្មាធិការ ថ្មី នេះ មាន លោក សួន សុម៉ាលីន ជា ប្រធាន លោក សុខ ផេង អនុប្រធាន អចិន្ត្រៃយ៍ និង ថ្នាក់ដឹកនាំ មួយចំនួន ទៀត ជា អនុប្រធាន និង សមាជិក ជាដើម ។
លោក Biden បាន និយាយ ថា ក្រុមហា ម៉ាស គឺ អាក្រក់ ជាង ISIS ក្នុង ការសម្លាប់ ជន ស៊ីវិល អ៊ីស្រាអែល នៅក្នុង ការវាយប្រហារ ដ៏ គួរឱ្យ ភ្ញាក់ផ្អើល មួយ កាលពី ថ្ងៃទី ០៧ ខែតុលា ដែល បង្កឱ្យ មាន អំពើហិង្សា ចុងក្រោយ បំផុត រវាង អ៊ីស្រាអែល និង ប៉ាឡេ ស្ទីន ។
