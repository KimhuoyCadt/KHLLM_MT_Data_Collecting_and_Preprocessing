( ញូវ ដែលី ) ៖ រដ្ឋាភិបាល ឥណ្ឌា បាន ឱ្យដឹង នៅ ថ្ងៃអង្គារ នេះ ថា ប្រទេស ឥណ្ឌា កំពុងតែ កំណត់ គោលដៅ បញ្ជូន អវកាសយានិក ទៅ ឋាន ព្រះចន្ទ ឱ្យ បាន នៅ ត្រឹម ២០៤០ ស្រប ពេល ដែល នាយក រដ្ឋមន្រ្តី ឥណ្ឌា លោក ណារិន ដ្រា ម៉ូឌី បាន ចេញ ការណែនាំ ទៅកាន់ នាយកដ្ឋាន អវកាស ដែល រួម មាន ទាំង ផែនការសាងសង់ ស្ថានីយ អវកាស ផ្ទាល់ នៅ ឆ្នាំ ២០៣៥ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ថ្ងៃអង្គារ ទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ ។
លោក បន្ត ថា ចំពោះ សេវា ដឹកជញ្ជូន ក្រៅ ប្រព័ន្ធ វិញ ត្រូវបាន អនុវត្ដ ធម្មតា ដូច អាកាសយាន្ដដ្ឋាន អន្ដរជាតិ ផ្សេង ៗ ដទៃ ទៀត ដោយ មិន មាន ការប្រែប្រួល នោះ ឡើយ ហើយក៏ មិន មាន ការហាមឃាត់ មិន ឲ្យ អ្នកដឹកជញ្ជូន ចូលទៅ ដឹក អ្នកដំណើរ នៅក្នុង អាកាសយាន្ដដ្ឋាន សៀមរាប - អង្គរ ផងដែរ ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ លោក ស៊ិន ចាន់ សិរី វុត្ថា បាន ឲ្យដឹង ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ បាន សម្រេច ផ្ទេរ សិទ្ធិ ឲ្យ ក្រុមហ៊ុន មួយ ជា អ្នកធ្វើ ប្រតិបត្ដិការ សេវាកម្ម ដឹក ជញ្ជូន នៅក្នុង អាកាសយាន្ដដ្ឋាន ដែល មាន តម្លៃ៖ រថយន្ត ធុន តូច ៣៥ ដុល្លារ មួយ ជើង និង ឡានក្រុង តូច ៤០ ដុល្លារ មួយ ជើង ឬ ៨ដុល្លារ ក្នុង ម្នាក់ ។
លោក បន្ដ ថា ការបង្កើត សេវាកម្ម នេះ គឺ ដោយសារតែ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ជា អាកាសយានដ្ឋាន ថ្មី ហើយ មាន ចម្ងាយ ប្រហែល ៥០ គីឡូម៉ែត្រ ពី ទី រួម ខេត្ដ សៀមរាប ហើយក៏ មិន ទាន់ មាន សេវា ដឹកជញ្ជូន សាធារណៈ ទៅដល់ ទីនោះ ទើប អាកាសយាន្ដដ្ឋាន សម្រេច ឲ្យ មាន ប្រតិបត្តិការ សេវាកម្ម តាក់ស៊ី ។
លោក បន្ត ថា បើ ពិនិត្យ តម្លៃ ដឹកជញ្ជូន តម្លៃ រថយន្តក្រុង ៨ដុល្លារ ក្នុង ម្នាក់ សម្រាប់ រយៈ ចម្ងាយ ជិត ៥០ គីឡូម៉ែត្រ ធៀប នឹង ការ សេវា ដឹកជញ្ជូន ផ្សេង ទៀត គិត ជា គីឡូម៉ែត្រ គឺ សេវា ដឹកជញ្ជូន ទាំង ពីរ នេះ មិន មាន អ្វី ខុសគ្នា ទេ ។
ចំពោះ តម្លៃ សេវា ដឹកជញ្ជូន វិញ អាស្រ័យ ទៅ លើ អ្នកធ្វើដំណើរ បើសិនជា អ្នកធ្វើដំណើរ គិត ថា ថ្លៃ អាច មាន ការជ្រើសរើស រក សេវា ដឹកជញ្ជូន ផ្សេង ៗ ទៀត ដែល មិន ស្ថិត នៅក្នុង សមាគម អ្នកដឹកជញ្ជូន ក្នុង អាកាសយាន្ដដ្ឋាន ក៏ បាន ផងដែរ ។
លោក បាន ឲ្យដឹង ទៀត ថា ចំពោះ អ្នកដឹកជញ្ជូន ផ្សេង ៗ ទៀត ដែល នៅ ក្រៅ ប្រព័ន្ធ ដែល ចង់ ចូលក្នុង ប្រព័ន្ធ របស់ ក្រុមហ៊ុន អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ មិន មាន ការហាមឃាត់ នោះ ទេ ដោយ ត្រូវ មក ចុះបញ្ជី ជាមួយ សមាគម ដឹកជញ្ជូន ព្រោះថា ការធ្វើ បែប នេះ ដើម្បី រក្សា នូវ សណ្ឋាប់ធ្នាប់ និង សុវត្ថិភាព ជូន ដល់ អ្នកធ្វើដំណើរ នៅក្នុង អាកាសយានដ្ឋាន ។
ដោយឡែក សម្រាប់ ការខុស អក្សរ ឬ ពាក្យ ដែល ដាក់ នៅ ព្រលានយន្តហោះ អន្តរជាតិ សៀមរាប អង្គរ ត្រូវបាន លោក ស៊ិន ចាន់ សិរី វុត្ថា អះអាង ថា ជា កំហុស បច្ចេកទេស របស់ ក្រុមហ៊ុន សាងសង់ ហើយ ត្រូវបាន កែសម្រួល រួចរាល់ ផងដែរ ។
លោក បន្ត ថា រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល នឹង បន្ត ធ្វើ ការត្រួតពិនិត្យ លើ ការប្រើប្រាស់ ភាសា ខ្មែរ នៅក្នុង អាកាសយានដ្ឋាន ឱ្យ បាន ប្រសើរ ជាង នេះ ៕
បូករួម ទាំង ភាពយន្ត ឯកសារ នេះ កម្មវិធី ទូរទស្សន៍ ឆ្នើម មួយ ចំនួន ពាក់ព័ន្ធ ខួប១០ ឆ្នាំ នៃ “ ខ្សែក្រវាត់ និង ផ្លូវ ” នឹង ផ្សព្វផ្សាយ ជា បន្តបន្ទាប់ ក្នុង ប្រទេស និង តំបន់ ចំនួន ជាង មួយ រយ លើ ពិភពលោក ជាពិសេស នឹង ចាក់ផ្សាយ នៅ ស្ថាប័ន ផ្សព្វផ្សាយ ចំនួន ១៤៦ មកពី ប្រទេស និង តំបន់ ចំនួន ៦៤ ដែល ជា សមាជិក សហគមន៍ ទូរទស្សន៍ ផ្លូវ សូត្រ ។
អត្ថបទ និង រូបភាព ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ភ្ជុំ បិណ្ឌ ៣ ថ្ងៃ កម្ពុជា ទទួលបាន ភ្ញៀវ ទេសចរ ជិត ២លាន នាក់ . ខេត្ត ត្បូងឃ្មុំ ឈរ លើ កំពូល តារាង មាន ភ្ញៀវ ទៅ លេង ច្រើន ជាង គេ
( ភ្នំពេញ ) ៖ នា ឱកាស ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ រយៈពេល ៣ ថ្ងៃ ក្នុង ឆ្នាំ ២០២៣ នេះ នៅ ទូទាំង ប្រទេស កម្ពុជា មាន ភ្ញៀវ ទេសចរ ដើរលេង កម្សាន្ត សរុប ជិត ២លាន នាក់ ។ នេះ បើ តាម ក្រសួង ទេសចរណ៍ ដែល ទើបតែ ចេញផ្សាយ នៅ ថ្ងៃទី ១៧ ខែតុលា ខណៈ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ បាន បញ្ចប់ តាំងពី ថ្ងៃទី ១៥ នោះ ។
ស្ថិតិ ទេសចរ ផ្ទៃក្នុង សរុប ជិត ២លាន នាក់ នេះ គឺ រដ្ឋបាល រាជធានី - ខេត្ត បាន រាប់បញ្ចូល ទាំង ភ្ញៀវ ទេសចរ និង ប្រជាពលរដ្ឋ ដែល បាន ធ្វើដំណើរកម្សាន្ត នៅ តាម រមណីយដ្ឋាន និង គោលដៅ ទេសចរណ៍ ទូទាំង ប្រទេស ព្រម ជាមួយ ប្រជាពលរដ្ឋ ដែល លេង កម្សាន្ត នៅ តាម ភូមិ ស្រុក និង តាម ទីតាំង រៀបចំ កម្មវិធី នានា ។
សភាពការណ៍ សន្តិសុខ សណ្តាប់ ធា្នប់ សុវត្ថិភាព ការគ្រប់គ្រង ចរន្ត ភ្ញៀវ និង ការគ្រប់គ្រង គុណភាព និង តម្លៃ សេវា ទេសចរណ៍ នានា មាន ភាពល្អ ប្រសើរ កម្លាំង សមត្ថកិច្ច ទាំង នៅ ថ្នាក់ ជាតិ និង គណៈ បញ្ជាការ ឯកភាព រាជធានី - ខេត្ត បាន អនុវត្ត ការងារ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ៕
( ប៉េកាំង ) ៖ លទ្ធផល នៃ ការស្ទង់ ប្រជាមតិ ដោយ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈម ចិន និង សកលវិទ្យាល័យ ប្រជាជន ប្រទេស ចិន ចំពោះ ពិភល លោក ទាំងមូល បាន បង្ហាញ ថា អ្នក ផ្តល់ បទសម្ភាសន៍ មកពី ប្រទេស ដែល ចូលរួម កសាង “ ខ្សែក្រវាត់ និង ផ្លូវ ” ចំនួន ៩៣. ៨% បាន កោតសរសើរ ខ្ពស់ ចំពោះ សមិទ្ធផល នៃ “ ខ្សែក្រវាត់ និង ផ្លូវ ” ។
ការស្ទង់ ប្រជាមតិ ទូទាំង ពិភពលោក នេះ មាន អ្នក ផ្តល់ បទសម្ភាសន៍ ចំនួន ៣៨៥៧ នាក់ មកពី ប្រទេស ចំនួន ៣៥ ក្នុង នោះ រួម មាន ប្រទេស ចូលរួម កសាង “ ខ្សែក្រវាត់ និង ផ្លូវ ” ដែល ស្ថិត ក្នុង កម្រិត អភិវឌ្ឍន៍ ខុសគ្នា ដូចជា ស៊ែប៊ី ហុង គ្រី អាហ្រ្វិក ខាងត្បូង អាហ្សង់ទីន អារ៉ាប៊ី សាអូឌីត នីហ្សេរីយ៉ា និង ប្រេស៊ីល ជាដើម ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៧៨ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៥.០២៤ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៤.២៥៨ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៧៦៦ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក អត់ បណ្ណ បើកបរ និង ល្មើស ភ្លើង - ផ្លាក សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ អត់ បណ្ណ បើកបរ ល្មើស ភ្លើង - ផ្លាក សញ្ញា គ្មាន ភ្លើង បំភ្លឺ ល្មើស ល្បឿន ឆៀក និង ដឹក សំពីង សំពោង ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៨ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៤ នាក់ របួស ចំនួន ០៨ នាក់ ( របួស ធ្ងន់ ចំនួន ០៤ នាក់ ) ។ រយៈពេល ១៧ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ១៧៥លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៩១ នាក់ របួស ២៤៦ នាក់ ( របួស ធ្ងន់ ១៤២ នាក់ )៕
កម្ពុជា ត្រូវបាន ទទួលស្គាល់ ជា ប្រទេស គំរូ ដែល ទទួលបាន ជោគជ័យ ក្នុង សកម្មភាព បោសសម្អាត មីន និង សង្គ្រោះ ជនរងគ្រោះ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម
កម្ពុជា ត្រូវបាន ទទួលស្គាល់ ជា ប្រទេស គំរូ ដែល ទទួលបាន ជោគជ័យ ជា ទីកត់សម្គាល់ ក្នុង សកម្មភាព បោសសម្អាត មីន និង សង្គ្រោះ ជនរងគ្រោះ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម ដែល កម្ពុជា មាន សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការចែករំលែក បទពិសោធន៍ របស់ ខ្លួន ទៅកាន់ ពិភាព លោក ។ កម្ពុជា មាន មោទនភាព ក្នុង ការចូលរួម ជាត ធាតុ ចូល សម្រាប់ ផែនការ សកម្មភាព អនុសញ្ញា និង ប្តេជ្ញា អនុវត្ត ឱ្យ បាន គ្រប់ ជ្រុងជ្រោយ នូវ សកម្មភាព ដែល កំណត់ ដោយ អនុសញ្ញា ។
លោក ទេសរដ្ឋមន្រ្តី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន បាន លើកឡើង ថា ក្នុង នាម ជា ប្រធាន អនុសញ្ញា ក្នុង ឆ្នាំ ២០២៤ កម្ពុជា បាន ប្តេជ្ញាចិត្ត បន្ត សម្រេច ឱ្យ បាន នូវ គោលដៅ រួម របស់ អនុសញ្ញា អូតា វ៉ា ជាពិសេស គឺ ការកៀរគរ ប្រទេស មិន មែន ជា ភាគី អនុសញ្ញា ឱ្យ ចូលរួម គាំទ្រ និង ចូល ជា រដ្ឋ ភាគី នៃ អនុសញ្ញា ដើម្បី រួមគ្នា សម្រេច ឱ្យ បាន នូវ ពិភពលោក មួយ ដែល គ្មាន មីន និង មិន មាន ការរងគ្រោះ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម ។
មន្ត្រី ជាន់ ខ្ពស់ គ.ជ. ប៖ ថ្ងៃ អនាគត ប្រសិនបើ អាជ្ញាធរដែនដី គ្រប់គ្រង ការចល័ត របស់ ពលរដ្ឋ បាន ប្រហែលជា មិន មាន ការចុះឈ្មោះ បោះឆ្នោត ទេ គឺ រៀបចំ ជាបញ្ជី បោះឆ្នោត ដំបូង រួច បិទ ផ្សាយ ជាសាធារណៈ តែម្តង
( ភ្នំពេញ ) ៖ លោក មាន សទិ សមាជិក គ.ជ. ប បាន លើកឡើង ថា នៅ ថ្ងៃ អនាគត ប្រសិនបើ អាជ្ញាធរដែនដី គ្រប់គ្រង ការចល័ត របស់ ប្រជាពលរដ្ឋ បាន នោះ ប្រហែលជា មិន មាន ការចុះឈ្មោះ បោះឆ្នោត ទេ គឺ រៀបចំ ជាបញ្ជី បោះឆ្នោត ដំបូង រួច បិទ ផ្សាយ ជាសាធារណៈ តែម្តង ។
នេះ បើ យោង តាម ការដកស្រង់ សម្តី របស់ លោក មាន សទិ តាមរយៈ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ កិច្ចប្រជុំ ដើម្បី ផ្សព្វផ្សាយ អំពី ការចុះឈ្មោះ អ្នកបោះឆ្នោត និង ការកែតម្រូវ បញ្ជី ឈ្មោះ បោះឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៣ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
លោក មាន សទិ បាន បន្ត ថា ប្រទេស កម្ពុជា កំពុង អនុវត្ត ទៅ លើ ការបោះឆ្នោត អសកល ចំនួន ពីរ ចំពោះ បញ្ជី បោះឆ្នោត នេះ គឺ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា និង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ ។ នៅលើ សកលលោក ការរៀបចំ បញ្ជី បោះឆ្នោត ដូចនេះ ចំណេញ ថវិកា ច្រើន ។
លោក មាន សទិ ក៏ បាន លើកឡើង អំពី ការរៀបចំ បញ្ជី ឈ្មោះ អ្នក បោះឆ្នោត នៅ បណ្តា ប្រទេស ផ្សេង ៗ ក្នុង ការបោះឆ្នោត ជា សកល ថា អត់ មាន ការចុះឈ្មោះ បោះឆ្នោត ទេ គឺ អាជ្ញាធរដែនដី ជា អ្នករៀបចំ បញ្ជី បោះឆ្នោត ដំបូង រួច យក ទៅ បិទ ផ្សាយ ដើម្បី ប្តឹង ទៅ តុលាការ ឬ ប្តឹង ទៅ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ៕ គ.ជ. ប ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី កិច្ចប្រជុំ ការ ចុះឈ្មោះ អ្នកបោះឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី កិច្ចប្រជុំ ដើម្បី ផ្សព្វផ្សាយ អំពី ការចុះឈ្មោះ អ្នកបោះឆ្នោត និង ការកែតម្រូវ បញ្ជី ឈ្មោះ បោះឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៣ ។
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព របស់ លោក មាន សទិ សមាជិក គ.ជ. ប និង ជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។
លោក បាន បន្ត ថា ការដោះស្រាយ ពាក្យ បណ្តឹង ត្រូវ អនុវត្ត ចាប់ពី ថ្នាក់ គណៈកម្មការ រាជធានី ខេត្ត រៀបចំ ការបោះឆ្នោត ( គធ. ខប ) ថ្នាក់ គ.ជ. ប ហើយ ត្រូវ បញ្ចប់ នៅ ក្រុមប្រឹក្សា ធម្មនុញ្ញ ។ លោក បាន ថ្លែង ថា សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ នេះ មណ្ឌល បោះឆ្នោត ត្រូវបាន រៀបចំ និង បែងចែក ជា ៨ភូមិភាគ ដែល មាន អាសនៈ សរុប ចំនួន ៥៨ ( បន្ថែម សមាជិក ព្រឹទ្ធសភា ចំនួន ២រូប ដែល ត្រូវបាន ចាត់តាំង ដោយ ព្រះមហាក្សត្រ និង ២រូប ទៀត ត្រូវបាន រដ្ឋសភា ជ្រើសតាំង តាម មតិ ភាគ ច្រើន ) ។
ចំពោះ បញ្ជី ឈ្មោះ អ្នកបោះឆ្នោត លោក មាន សទិ បាន បន្ត ថា ត្រូវបាន រៀបចំ នៅ តាម រាជធានី ខេត្ត នីមួយ ៗ រួម មាន ក្រុមប្រឹក្សា ឃុំ សង្កាត់ និង តំណាងរាស្ត្រ នៃ រាជធានី ខេត្ត នីមួយ ៗ ហើយ គ.ជ. ប ត្រូវ ធ្វើ ការបូកសរុប លទ្ធផល នៃ ការបោះឆ្នោត នៅ តាម មណ្ឌល នីមួយ ៗ នៃ មណ្ឌល ទាំង៨ នៅ ទូទាំង ប្រទេស ។
លោក បាន បន្ថែម ថា ការចុះឈ្មោះ អ្នកបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ត្រូវ អនុវត្ត តាម របៀប ស្រ ង់ ឈ្មោះ អ្នក មាន សិទ្ធិ បោះឆ្នោត បញ្ចូល ទៅក្នុង បញ្ជី ឈ្មោះ ដោយឡែក ពី គ្នា ទៅតាម អង្គ បោះឆ្នោត នីមួយ ៗ និង បញ្ជូន តាម លំដាប់ ឋានានុក្រម មក គ.ជ. ប ឱ្យ បាន តាម កាលបរិច្ឆេទ កំណត់ ។
លោក មាន សទិ បាន បន្ថែម ថា អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា ត្រូវ រៀបចំ បញ្ជី ឈ្មោះ តំណាងរាស្ត្រ ក្នុង តំណែ ង រួច អគ្គ លេខាធិការ រដ្ឋសភា ចុះហត្ថលេខា និង បោះ ត្រា អគ្គ លេខា - ធិការដ្ឋាន រដ្ឋសភា ដែល មាន ការបញ្ជាក់ ឯកភាព ពី ប្រធាន រដ្ឋសភា រួច បញ្ជូន មក គ.ជ. ប ឱ្យ បាន តាម កាលបរិច្ឆេទ កំណត់ ។ បញ្ជី ឈ្មោះ នេះ ត្រូវ រៀបចំ ដោយឡែក ពី គ្នា ទៅតាម តំណាងរាស្ត្រ ក្នុង តំណែង នៃ មណ្ឌល រាជធានី ខេត្ត នីមួយ ៗ ៕
( ភ្នំពេញ ) ៖ ក្រសួង បរិស្ថាន បាន យកចិត្តទុកដាក់ ជា អាទិភាព លើ ចីរភាព បរិស្ថាន ដោយ មាន ចែង នៅក្នុង យុទ្ធសាស្រ្ត បញ្ចកោណ ដំណាក់កាល ទី១ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ជា លក្ខខណ្ឌ ចម្បង មាន ចែង ក្នុង បាវចនា « កំណើន ការងារ សមធម៌ ប្រសិទ្ធភាព និង ចីរភាព » ។
ក្រសួង បរិស្ថាន បាន ដាក់ចេញ វិធានការចម្បង ចំនួន ៤ ដើម្បី គ្រប់គ្រង ធនធាន ធម្មជាតិ និង អភិរក្ស ជីវៈ ចម្រុះ ឱ្យ មាន ប្រសិទ្ធភាព និង ដើម្បី ការអភិវឌ្ឍ ដោយ ចីរភាព រួម មាន៖
* ទី១៖ ក្រសួង បរិស្ថាន ជំរុញ ការអនុវត្ត ច្បាប់ ១០០ % និង បញ្ចប់ នូវ វប្បធម៌ អប់រំ ណែនាំ និង ចុះ កិច្ចសន្យា ហើយ ដោះលែង ចំពោះ អ្នកប្រព្រឹត្ត បទល្មើស ធនធាន ធម្មជាតិ ។
* ទី២៖ ក្រសួង បរិស្ថាន សហការ ជាមួយ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល រាជធានី - ខេត្ត ជាពិសេស ជាមួយ អាជ្ញាធរដែនដី ឱ្យ បាន ស្អិត រមួត ដើម្បី ទប់ស្កាត់ បទល្មើស ធនធាន ធម្មជាតិ នៅ តាម តំបន់ ការពារ ធម្មជាតិ ។
* ទី៣៖ សហការ ជាមួយ អង្គភាព ប្រឆាំង នឹង អំពើពុករលួយ និង បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ធ្វើ ការ បង្រ្កាប និង ទប់ស្កាត់ បទល្មើស ធនធាន ធម្មជាតិ បន្ថែម លើ កិច្ចសហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ដែល បាន អនុវត្ត កន្លងមក ។
* ៤៖ ការដាំ ដើមឈើ ឱ្យ ច្រើន ជាង ការកាប់ ដើម្បី រក្សា នូវ កំណើន ជាពិសេស ការជំរុញ ការដាំ ស្តា ព្រៃឈើ ជា ទិសដៅ អាទិភាព បង្កើន គម្រប ព្រៃឈើ ឱ្យ បាន ៦០ % នៅ ឆ្នាំ ២០៥០ ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង លើកកម្ពស់ ជីវភាព ប្រជាពលរដ្ឋ នៅ តាម សហគមន៍ ការអភិរក្ស ជីវ ចម្រុះ ដោយ ចីរភាព ។
តាមរយៈ នេះ ក្រសួង បរិស្ថាន បាន ដាក់ចេញ យុទ្ធនាការ ថ្ងៃទី១០ តុលា នឹង ធ្វើ ការផ្តល់ និង ដាំ ដើមឈើ យ៉ាងតិច ១លាន ដើម ក្នុង មួយ ឆ្នាំ ចាប់ពី ឆ្នាំ ២០២៤ ។
លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ថ្លែង ស្វាគមន៍ និង ជំរុញ ឱ្យ គ្រប់ អង្គការ ដៃគូ ក្នុង និង ក្រៅ ស្រុក ទាំងអស់ រួមចំណែក ការងារ អាទិភាព របស់ ក្រសួង ក្នុង នោះ រាប់បញ្ចូល ទាំង ការដាំ ឬ ស្សី ដាំ ដើម ត្នោត ឈាន ទៅ សម្រេច ទិសដៅ រួម ជួយ ពង្រីក វិសាលភាព គម្រប ព្រៃឈើ និង ជាពិសេស លើកទឹកចិត្ត ដល់ ប្រជាពលរដ្ឋ ដែល ចង់ ចូលរួមចំណែក ក្នុង ការពារ និង អភិរក្ស ព្រៃឈើ បង្កើន ជីវភាព ប្រជាជន និង បាន រួមចំណែក ដ៏ សំខាន់ ក្នុង ការដោះស្រាយ បញ្ហា សកល លើ ការប្រែប្រួល អាកាសធាតុ ៕
សន្និសីទ អាស៊ាន ណា ប៉ូល លើក ទី ៤១ នេះ ធ្វើឡើង ក្រោម ប្រធានបទ « ពង្រឹង ភាពជាដៃគូ ដើម្បី លើកកម្ពស់ សន្តិភាព ស្ថិរភាព និង សន្តិសុខ » ។
ជំហរ នេះ បាន បញ្ជាក់ ដោយ លោក ឆាយ ឈី (Cai Qi) សមាជិក គណៈកម្មាធិការ អចិន្ត្រៃយ៍ នៃ ការិយាល័យ នយោបាយ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ដ ចិន និង ជា ប្រធាន ការិយាល័យ កិច្ចការ ទូទៅ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ដ ចិន នា ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ ក្នុង ឱកាស ជួប ជាមួយ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ក្នុង ឱកាស ចូលរួម ក្នុង « វេទិកា ខ្សែក្រវាត់ និង ផ្លូវ លើក ទី៣ » នៅ រដ្ឋធានី ប៉េកាំង ។
ជាមួយគ្នា នេះ សម្តេច ធិបតី ក៏ បាន គូសបញ្ជាក់ ផងដែរ អំពី សារៈសំខាន់ នៃ « កិច្ចសហប្រតិបត្តិការ ត្បូង ពេជ្រ » រវាង ប្រទេស ទាំង ពីរ ដែល ផ្តោត លើ វិស័យ អាទិភាព ចំនួន ៦ រួម មាន៖ នយោបាយ . គុណភាព និង សមត្ថភាព ផលិតកម្ម . កសិកម្ម . ថាមពល . សន្តិសុខ និង ការផ្លាស់ប្តូរ រវាង ប្រជាជន និង ប្រជាជន ។
ក្រៅពី នេះ ថ្នាក់ដឹកនាំ ទាំង ពីរ ក៏ បាន ពិភាក្សា ផងដែរ អំពី ទំនាក់ទំនង រវាង គណបក្ស និង គណបក្ស សំដៅ បន្ត ពង្រឹង កិច្ចសហប្រតិបត្តិការ បន្ថែម ទៀត តាមរយៈ ការផ្លាស់ប្តូរ ទស្សនកិច្ច ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ និង ការផ្លាស់ប្តូរ រវាង យុវជន និង យុវជន ដែល ជា ផ្នែក មួយ ដ៏ សំខាន់ សម្រាប់ ពង្រឹង ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ឱ្យ បាន រឹងមាំ និង យូរអង្វែង ៕
