( កំពង់ធំ )៖ លោក ងួន រាសី អភិបាល រង ខេត្ត កំពង់ធំ បាន ជំរុញ ដល់ សហគ្រាស ធុន តូច ផលិត ទឹក សៀង ទឹកត្រី និង ទឹក ស៊ីអ៊ីវ របស់ លោក លឹម សម្បត្តិ ដែល ជា ផលិតផល ក្នុង ស្រុក ស្នាដៃ កូន ខ្មែរ ត្រូវ គិត ពី គុណភាព និង សុខភាព ជា ចម្បង ព្រមទាំង មាន ទស្សនៈ វិស័យ លើកស្ទួយ ផលិតផល ក្នុង ស្រុក និង ធ្វើឲ្យ មាន ការចូលរួម សហការ ពី គ្រប់ ដៃគូ ដើម្បី ផលិត និង កែច្នៃ វត្ថុធាតុ ដើម ក្នុង ស្រុក ឲ្យ ទៅជា ផលិតផល សម្រេច ។
លោក ណែនាំ ទៀត ថា គ្រប់ ផលិតផល របស់ សហគ្រាស ជា ផលិតផល ដែល ត្រូវបាន ទទួលស្គាល់ ពី វិទ្យាស្ថាន ស្តង់ដារ ដោយ អនុលោម ទៅតាម ពាក្យស្លោក របស់ សហគ្រាស គឺ គុណភាព និង សុខភាព ជា ចម្បង ពោលគឺ ក្រុមហ៊ុន មិន គិត តែ ទៅ លើ ផល ចំណេញ តែ មួយ មុខ ទេ គឺ ផ្តោត សំខាន់ ទៅ លើ ការចូលរួមចំណែក លើកស្ទួយ សេដ្ឋកិច្ច សហគមន៍ និង សុខភាព របស់ អ្នកប្រើប្រាស់ ។
លោក ងួន រាសី បាន ឱ្យដឹង ថា ស្ថានីយ ផលិត ផ្គត់ផ្គង់ ទឹក ស្អាត របស់ លោកស្រី ជា ស្រី មុំ ដែល ជា គម្រោង អភិវឌ្ឍន៍ ផ្គត់ផ្គង់ ទឹក ស្អាត ក្នុង ស្រុក នេះ នឹង រួមចំណែក លើកស្ទួយ វិស័យ ទឹក ស្អាត នៅ កម្ពុជា ដែល អាច ធានា បាន នូវ និរន្តរភាព នៃ ការប្រើប្រាស់ សេវា ទឹក ស្អាត ធានា ផ្ដល់ សេវា ទឹក ស្អាត ប្រកបដោយ គុណភាព មិន មាន ក្លិន ល្អក់កករ ឬ មាន ជាតិ ពុល និង ធានា សុវត្ថិភាព ជូន ដល់ ប្រជាពលរដ្ឋ ។
អភិបាល រង ខេត្ត កំពង់ធំ បាន បន្ថែម ថា សហគ្រាស ផលិត ទឹកកក ដើម និង ទឹកកក អនាម័យ របស់ លោក រស់ ចិន្តា ត្រូវ មាន គោលបំណង សំខាន់ គឺ ចង់ ផ្សព្វផ្សាយ ដល់ ម្ចាស់ សហគ្រាស សិប្បកម្ម ផលិត ទឹកកក ទឹកកក អនាម័យ ទាំងអស់ ឱ្យ យកចិត្តទុកដាក់ ដោយ ត្រូវ ធានា ថា ផលិតផល ទាំងនោះ គឺ ផលិត ឡើង តាម ស្តង់ដារ មាន គុណភាព អនាម័យ ធានា សុវត្ថិភាព ដល់ អ្នកប្រើប្រាស់ ។
អភិបាល រង ខេត្ត កំពង់ធំ បាន បាន បញ្ជាក់ ថា ចំពោះ ការធ្វើ អនាម័យ របស់ សហគ្រាស ធុន តូច សិប្បកម្ម ផលិត ទឹកកក ដើម និង អនាម័យ គឺ ត្រូវ គោរព តាម គោលការណ៍ អនាម័យ ចំនួន ៣ ចំណុច រួម មាន៖
ទី ១៖ ផ្តោត លើ អនាម័យ ទីតាំង ផលិតកម្ម វត្ថុធាតុ ដើម និង ខ្សែ ច្រវាក់ ផលិតកម្ម ត្រូវតែ ស្អាត និង មាន អនាម័យ ត្រូវ មាន ភ្លើង បំភ្លឺ សមស្រប មាន បណ្ដាញ លូបង្ហូរ ទឹក ឬ កាកសំណល់ ចោល ត្រូវ មាន បន្ទប់ទឹក ធំ ទូលាយ មាន កន្លែង សម្រាប់ លាង ដៃ ជើង មុននឹង ចូល ធ្វើ ការ ត្រូវ មាន ឧបករណ៍ សម្រាប់ ចាប់ ឬ ការពារ សត្វ ល្អិត មាន សីតុណ្ហភាព សមស្រប
ទី២៖ ការធ្វើ អនាម័យ បុគ្គលិក ឬ កម្មករ ត្រូវ មាន ការបណ្ដុះបណ្ដាល ផ្នែក អនាម័យ ខ្លួនប្រាណ ដល់ បុគ្គលិក កម្មករ កម្មករ ត្រូវ មាន សម្លៀកបំពាក់ និង ស្បែកជើង ស្អាត ក្នុង ពេល បំពេញ ការងារ ទី៣៖ គឺ ការធ្វើ អនាម័យ សម្ភារ វេច ខ្ចប់ ផលិតផល សម្រេច សំបក វេចខ្ចប់ ត្រូវ ធ្វើឡើង ឱ្យ បាន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស និង ចៀសវាង ការចម្លង មេរោគ និង ភាពកខ្វក់ ។
ជា ចុងក្រោយ លោក ងួន រាសី បាន ទទូច ឲ្យ ប្រជាពលរដ្ឋ គ្រប់ រូប ជួយ គាំទ្រ ផលិតផល ខ្មែរ គ្មាន សារធាតុ ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខភាព ស្រប តាម អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន ដោយ យោង ទៅតាម អនុក្រឹត្យ លេខ ១២៤ អន ក្រ. បក ទាក់ទង នឹង ការលើកកម្ពស់ ការអភិវឌ្ឍន៍ សហគ្រាស ធុន តូច និង មធ្យម ដើម្បី បង្កើត ការងារ និង បង្កើន សមត្ថភាព ផលិតកម្ម ក្នុង ស្រុក ក្នុង គោលបំណង ចូលរួម លើកកម្ពស់ សុខុមាលភាព សាធារណៈ និង ចូលរួម លើកកម្ពស់ ផលិតផល ក្នុង ស្រុក និង សេដ្ឋកិច្ច ជាតិ ។
រដ្ឋបាល ខេត្ត សៀមរាប បើក កិច្ចប្រជុំ គណៈកម្មការរៀបចំ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក នៅ ខេត្ត សៀមរាប ឆ្នាំ ២០២៣
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប នៅ ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន បើក កិច្ចប្រជុំ គណៈកម្មការរៀបចំ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ដើម្បីឲ្យ មាន ភាពរលូន និង ដំណើរ ទៅ បាន ល្អ ប្រកបដោយ សុខ សុវត្ថិភាព មាន សណ្តាប់ធ្នាប់ របៀបរៀបរយ សាធារណៈ និង បរិស្ថាន ល្អ សម្រាប់ ទាំងអស់ គ្នា ។
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង ក្រោម ការដឹកនាំ របស់ លោក ប្រាក់ សោភ័ណ អភិបាល ខេត្ត សៀមរាប និង មាន ការចូលរួម ពីសំណាក់ លោក លោកស្រី ជា ប្រធាន អនុគណៈកម្មការ អស់ លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព ស្ថាប័ន អាជ្ញាធរ ក្រុង ស្រុក និង មេបញ្ជាការ បញ្ជាការ រង ស្នងការ នគរបាល សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង វិស័យ ឯកជន ផងដែរ ។
លោក ប្រាក់ សោភ័ណ ក៏ បាន ណែនាំ មួយចំនួន ដល់ អនុគណៈកម្មការ ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព អាជ្ញាធរ ក្រុង ស្រុក ដែល មាន ទូក ចូលរួម ប្រកួត ក្នុង ពិធី បុណ្យ អុំ ទូក ឲ្យ ពិនិត្យ ផ្គូផ្គង វាយតម្លៃ ឲ្យបាន ច្បាស់លាស់ និង យុត្តិធម៌ ទៅ លើ កម្លាំង ចំណុះ ទូក ក៏ ដូចជា កម្លាំង ត្រៀម ចៀសវាង កើត ចេញ ជា បាតុភាព មិន ល្អ ព្រោះថា រដ្ឋបាល ខេត្ត សៀមរាប ក៏ បាន ត្រៀម កញ្ចប់ ថវិកា សម្រាប់ ជ័យលាភី តាម លំដាប់លំដោយ ផងដែរ ។
ជំនួប សម្តែង ការគួរសម នេះ ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នាទី ស្តីការ ក្រសួង ។
ជាមួយគ្នា នេះ លោក រដ្ឋមន្រ្តី បាន ថ្លែងអំណរគុណ និង ស្វាគមន៍ ចំពោះ ក្រុម អ្នក វិនិយោគ EURO-CHAM ដែល យកចិត្តទុកដាក់ ក្នុង វិស័យ បរិស្ថាន និង បើក ឱកាស ឱ្យ ធុរ ជន បាន សួរ សំណួរ ផ្សេង ៗ ទាក់ទង នឹង ការងារ អាទិភាព របស់ ក្រសួង ។
ក្រុម ធុរ ជន EURO-CHAM ចាប់អារម្មណ៍ ជាខ្លាំង និង បាន សួរ សំណួរ ដេញដោល ជាច្រើន ទាក់ទង នឹង វិធីសាស្រ្ត ក្នុង ការគ្រប់គ្រង សំណល់ រឹង នៅ ទីលាន ការកែច្នៃ សំណល់ រឹង ឡើងវិញ និង យុទ្ធសាស្រ្ត ដែល ធ្វើឱ្យ ការងារ សម្រេចបាន ដូចជា យុទ្ធនាការ កាត់បន្ថយ ការប្រើប្រាស់ ថង់ ប្លាស្ទិក ដែល មាន សិស្សានុសិស្ស ចូលរួម ប្រមាណ ជិត ២លាន នាក់ និង យុទ្ធនាការដាំ ដើមឈើ ១លាន ដើម ជារៀងរាល់ ឆ្នាំ ដើម្បី ឆ្ពោះ ទៅការពង្រីក គម្រប ព្រៃ ឱ្យ បាន ជាង ៦០ % នៅ ឆ្នាំ ២០៥០ ។
លើស ពី នេះ លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន គូសបន្ថែម ថា ការរួមចំណែក ពី អ្នក វិនិយោគ អាល្លី ម៉ង់ ក្រុម ធុរកិច្ច EURO-CHAM គឺជា កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ ប្រសើរ ក្នុង ភាពជាដៃគូ អភិវឌ្ឍ ដើម្បី ដោះស្រាយ បញ្ហា រួម របស់ ពិភពលោក ដូចជា ការកាត់បន្ថយ ការបញ្ចេញ ឧស្ម័ន កាបូនិក ដែល កើត ចេញ ពី ចំហេះ ថាមពល ហ្វូស៊ីល នាំឱ្យ មាន ការប្រែប្រួល អាកាសធាតុ ដែល កំពុង គំរាមគំហែង ដល់ ពិភពលោក ។
សូម ជម្រាប ជូន ថា ជំនួប ក្រុម ធុរកិច្ច EURO-CHAM គឺ បាន បង្ករ ឱកាស ងាយស្រួល ដល់ ក្រុម អ្នក វិនិយោគ អាល្លីម៉ង់ វិស័យ ឯកជន ក្នុង ការរួមចំណែក ជាមួយ វិស័យ បរិស្ថាន កម្ពុជា តាមរយៈ កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍន៍ អាល្លឺម៉ង់ GIZ ៕ បណ្ឌិត កៅ គឹម ហួន ដឹកនាំ គណៈប្រតិភូ លេខាធិការដ្ឋាន អាស៊ាន អញ្ជើញ បំពេញ ទស្សនកិច្ចការងារ នៅ ប្រទេស ជប៉ុន
ភាគី ទាំង ពីរ បាន ផ្លាស់ប្តូរ ទស្សនស្តីពី ទំនាក់ទំនង អាស៊ាន - ជប៉ុន និង បាន ឯកភាព ធ្វើ ការជិតស្និទ្ធ រួមគ្នា ដើម្បី លើកកម្ពស់ ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ អាស៊ាន - ជប៉ុន ស្រប ពេល ឆ្នាំ នេះ ជា ខួប ទី ៥០ នៃ ទំនាក់ទំនង អាស៊ាន - ជប៉ុន ។
លោក បណ្ឌិត កៅ គឹម ហួន បាន បញ្ជាក់ ជូន លោកជំទាវ រដ្ឋមន្ត្រី ការបរទេស ជប៉ុន អំពី ការបន្ត គាំទ្រ របស់ លេខាធិការដ្ឋាន អាស៊ាន ក្នុង ការត្រៀម រៀបចំ កិច្ចប្រជុំ កំពូល រំលឹក ខួប អនុស្សាវរីយ៍ អាស៊ាន - ជប៉ុន ដែល នឹង ប្រព្រឹត្តទៅ នៅ ខែធ្នូ ខាងមុខ នៅ ទីក្រុង តូក្យូ ។
ភាគី ទាំង ពីរ បាន ផ្លាស់ប្តូរ យោបល់ រិះរក វិធី ដើម្បី បង្កើន ពាណិជ្ជកម្ម ការវិនិយោគ ទេសចរណ៍ និង ការផ្លាស់ប្តូរ រវាង ប្រជាជន និង ប្រជាជន រវាង អាស៊ាន និង ជប៉ុន ។
លោក បណ្ឌិត កៅ គឹម ហួន បាន កោតសរសើរ តួនាទី របស់ មជ្ឈមណ្ឌល នេះ ក្នុង រយៈពេល កន្លងមក ក្នុង ការផ្តួចផ្តើម សកម្មភាព និង កម្មវិធី នានា ដើម្បី លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ រវាង អាស៊ាន និង ជប៉ុន ។
ក្នុង ដំណើរ បំពេញ ទស្សនកិច្ច នៅ ជប៉ុន នេះ នៅ រសៀល ថ្ងៃ ដដែល លោក បណ្ឌិត កៅ គឹម ហួន បាន ជួប ជាមួយ អ្នកជំនាញ ផ្នែក សិក្សា ធិការ មកពី សាកលវិទ្យាល័យ ឈាន មុខ និង ស្ថាប័ន ស្រាវជ្រាវ នានា ក្នុង ប្រទេស ជប៉ុន ។ នៅក្នុង ឱកាស នោះ ក៏ មាន ការពិភាក្សា និង ផ្លាស់ប្តូរ ទស្សនៈ លើ បញ្ហា គន្លឹះ នានា រួមទាំង បញ្ហា ក្នុង តំបន់ និង សកលលោក ។
នៅក្នុង ឱកាស នោះ អគ្គ លេខាធិការ អាស៊ាន បាន គូសបញ្ជាក់ អំពី សារៈសំខាន់ នៃ ទំនាក់ទំនង អាស៊ាន - ជប៉ុន និង ការប្តេជ្ញាចិត្ត ក្នុង ការពង្រឹង ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ឱ្យ មាន អត្ថន័យ និង មាន ប្រយោជន៍ ទៅ វិញ ទៅមក ។
គណបក្ស ប្រឆាំង ដែល គាំទ្រ សហភាព អឺរ៉ុប បាន ឈ្នះ សំឡេង ភាគ ច្រើន នៅក្នុង ការបោះឆ្នោត កាលពី ដើម ខែ នេះ ដែល ជា ការផ្លាស់ប្តូរ ដ៏ សំខាន់ មួយ សម្រាប់ ប្រទេស ប៉ូឡូញ បន្ទាប់ពី មាន ការខ្វែងគំនិត គ្នា អស់ រយៈពេល ៨ ឆ្នាំ ជាមួយ ទីក្រុង ព្រុច សែល លើ បញ្ហា ជាច្រើន រាប់ ចាប់ពី ឯករាជ្យភាព របស់ តុលាការ រហូតដល់ សិទ្ធិ ស្ត្រី ការស្រឡាញ់ ភេទ ដូចគ្នា និង អ្នក កែ ភេទ ជាដើម ។
មេដឹកនាំ នៃ ក្រុម ទាំង បី មាន បំណង បង្កើត រដ្ឋាភិបាល បន្ទាប់ បាន ជំរុញ ឱ្យ លោក ប្រធានាធិបតី Duda កុំ ពន្យារ ពេល ធ្វើ ការសម្រេចចិត្ត លើ ការតែងតាំង នាយក រដ្ឋមន្ត្រី ថ្មី ។ ទោះជា យ៉ាងណា ជំនួយការ របស់ លោក បាន និយាយ ថា លោក នឹង មិន ប្រញាប់ប្រញាល់ ក្នុង ការធ្វើ ការជ្រើសរើស ឡើយ ៕ រូបភាព ពី Reuters អាកាសយានដ្ឋាន អន្ដរជាតិ សៀមរាប អង្គរ កំពុង ផ្ដល់ ការងារ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ សរុប ចំនួន ៣៦៥ នាក់
( ភ្នំពេញ ) ៖ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ បាន ផ្ដល់ ឱកាស ការងារ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ សរុប ចំនួន ៣៦៤ នាក់ គិត ត្រឹម ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០២៣ ។ នេះ បើ តាម ការបញ្ជាក់ ឲ្យដឹង ពី លោក ស៉ីន ចាន់ សិរី វុត្ថា អនុ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ អាកាសចរ ស៊ីវិល ។
អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ សាងសង់ លើ ផ្ទៃដី ៧០០ ហិកតា មាន ទីតាំង ស្ថិត នៅ ភូមិ ក្រៀល ពង ឃុំ ពពេល និង ភូមិ ប្រវ៉ាល ឃុំ តា យ៉ែក ស្រុក សូទ្រនិគម ខេត្ត សៀមរាប ចម្ងាយ ពី ប្រាសាទ អង្គរវត្ត ៤០ គីទ្បូម៉ែត្រ និង ៥១ គីទ្បូម៉ែត្រ ពី ក្រុង សៀមរាប ។
ក្រៅតែ ពី ផ្ទៃដី សម្រាប់ សាងសង់ អាកាសយានដ្ឋាន ថ្មី នេះ ក៏ មាន ការបម្រុងទុក នៅ ដី ចំនួន ១០០០ ហិកតា ផ្សេង ទៀត នៅ ជាប់ តំបន់ នោះ ដើម្បី សាងសង់ ជា តំបន់ សេដ្ឋកិច្ច ឬ តំបន់ ឧស្សាហកម្ម រណប ឱ្យ អាកាសយានដ្ឋាន អន្តរជាតិ ថ្មី នេះ ផងដែរ ៕
ព្រះសង្ឃ អាចារ្យ គណៈកម្មាធិកា វត្ត ព្រះពុទ្ធ សំរិទ្ធ គិរី ថ្ម ដា នាំយក ទេយ្យ ទាន ទទួល ពី ញាតិ ញោម នា បុណ្យ ភ្ជុំ បិណ្ឌ ប្រគល់ជូន រដ្ឋបាល ឃុំ សំរុង ស្រុក ព្រៃនប់ ទុក ចែកជូន ជន ចាស់ជរា គ្មាន ទីពឹង
( ព្រះសីហនុ) ៖ ព្រះសាសន សោភ័ណ ហឿម សុវណ្ណារ៉ា ព្រះចៅ អធិការ វត្ត ព្រះពុទ្ធ សំរិទ្ធ គិរី ថ្ម ដា នា ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន ដឹកនាំ ព្រះសង្ឃ អាចារ្យ គណៈកម្មការ វត្ត ព្រះពុទ្ធ សំរឹទ្ធ គិរី ថ្ម ដា ( ហៅ វត្ត ថ្ម ដាក្រោម ) នាំយក អំណោយ និង ទេយ្យ ទាន មួយចំនួន ដែល ទទួលបាន ពី ញាតិ ញោម នា ឪកាស បុណ្យ ភ្ជុំ បិណ្ឌ ចុះ ប្រគល់ជូន រដ្ឋបាល ឃុំ សំរុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ដើម្បី ទុក ជួយ ប្រជាពលរដ្ឋ ដែល ងាយ រងគ្រោះ ដូចជា ជន ចាស់ជរា ជន ពិការ និង ជន គ្មាន ទីពឹង ។
សូម បញ្ជាក់ ដែរ ថា អំណោយ ដែល ប្រគល់ នា ពេលនេះ រួម មាន៖ អង្ករ ចំនួន ១០បាវ=១ ០០០ គីឡូ មី ម៉ាម៉ាចំនួន ៤០ កេស មី ខ្លាឃ្មុំ ចំនួន ១០កេស ទឹកត្រី ទឹក សុី អុីវ ចំនួន ១៦យួរ ទឹក ផ្លែឈើ ចំនួន ១០កេស ខ្លាញ់ ចំនួន ៥កា ដុង = ២៥លីត្រ ស្កសរ ចំនួន ២៦ គីឡូ ប៊ី ចេង ចំនួន ១០កញ្ចប់ ថវិកា ចំនួន ៨០០.០០០ រៀល ៕ អគ្គ នាយកដ្ឋាន ពន្ធដារ ណែនាំ ដល់ ម្ចាស សហគ្រាស និង រោងចក្រ ផលិត ភេសជ្ជៈ គ្មាន ជាតិ សុរា ក្នុង ស្រុក ពី វិធី គណនា ប្រាក់ អាករ
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន ចេញ សេចក្ដីណែនាំ ថ្មី មួយ ដល់ ម្ចាស សហគ្រាស និង រោងចក្រ ផលិត ភេសជ្ជៈ គ្មាន ជាតិ សុរា ក្នុង ស្រុក ទាំងអស់ ពី វិធី គណនា ប្រាក់ អាករ ចំពោះ ការផ្គត់ផ្គង់ ផលិតផល ។
ជាមួយគ្នា នេះ អគ្គ នាយកដ្ឋាន ពន្ធដារសង្ឃឹម យ៉ាង មុតមាំ ថា ម្ចាស់ រោងចក្រ សហគ្រាស ផលិត ភេសជ្ជៈ គ្មាន ជាតិ សុរា ក្នុង ស្រុក ទាំងអស់ នឹង ចូលរួម អនុវត្តន៍ ទាំងអស់ គ្នា ៕
សូម អាន សេចក្ដីជូនដំណឹង របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ទាំងអស់៖ ព្រឹក ស្អែក សម្ដេច តេជោ ហ៊ុន សែន នឹង អញ្ជើញ ចុះ កិច្ចព្រមព្រៀង ចង សម្ព័ន្ធ ភាព រវាង គណបក្ស ប្រជាជន កម្ពុជា និង គណបក្ស នយោបាយ ចំនួន ២៧ ផ្សេង ទៀត
( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ ស្អែក នេះ នឹង អញ្ជើញ ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ចង សម្ព័ន្ធ ភាព រវាង គណបក្ស ប្រជាជន កម្ពុជា ជាមួយ បណ្ដា គណបក្ស នយោបាយ នៅ កម្ពុជា ចំនួន ២៧ ផ្សេង ទៀត ។ ពិធី នេះ ធ្វើឡើង នៅ វិមាន ៧មករា ទីស្នាក់ការ កណ្ដាល របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
គណបក្ស នយោបាយ ទាំងនោះ បាន គូសបញ្ជាក់ ថា គណបក្ស ប្រជាជន កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឆ្លាតវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន ដឹកនាំ ប្រទេស កម្ពុជា ឆ្ពោះទៅ រក សុខ សន្តិភាព រក្សា បាន ស្ថិរភាព និង ការអភិវឌ្ឍ ប្រទេស រីកចម្រើន ឥត ឈប់ឈរ ៕ ក្រុមហ៊ុន តៃវ៉ាន់ ធំ ៗ អាច ចាកចេញ ពី ប្រទេស ចិន ប្រសិនបើ រង សម្ពាធ ដោយ អយុត្តិធម៌ . នេះ បើ តាម មេដឹកនាំ រង នៃ កោះ តៃវ៉ាន់
( តៃ ប៉ិ) ៖ មេដឹកនាំ រង របស់ កោះ តៃវ៉ាន់ នៅ ថ្ងៃអង្គារ នេះ បាន ព្រមាន ថា ក្រុមហ៊ុន តៃវ៉ាន់ ធំ ៗ ដែល មាន មូលដ្ឋាន ក្នុង ប្រទេស ចិន អាចនឹង ត្រូវ បង្ខំ ចិត្ត ផ្លាស់ប្តូរ ទីតាំង ប្រសិនបើ ពួកគេ មាន អារម្មណ៍ ថា « រង សម្ពាធ ដោយ អយុត្តិធម៌ » ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃអង្គារ ទី២៤ ខែតុលា ឆ្នាំ ២០២៣ ។
ក្រសួង អប់រំ យុវជន និង កីឡា បាន បញ្ជាក់ ទៀត ថា គណៈ គ្រប់គ្រង គ្រឹះស្ថាន សិក្សា ត្រូវ ណែនាំ ជា ប្រចាំ អំពី វិន័យ និង បទបញ្ជា ផ្ទៃក្នុង របស់ សាលារៀន ដល់ សិស្សានុសិស្ស ពាក់ព័ន្ធ នឹង ការប្រើប្រាស់ ទូរសព្ទ ដៃ និង ឧបករណ៍ អេឡិចត្រូនិក ឱ្យ ស្រប នឹង គោលបំណង នៃ ការអប់រំ ។ ក្រុមប្រឹក្សា កុមារ និង ក្រុមប្រឹក្សា យុវជន ត្រូវ ចូលរួម ណែនាំ សមាជិក ឱ្យ ផ្តោត លើ ការសិក្សា រៀនសូត ជាជាង ការចំណាយ ពេល លើ ការលេង ហ្គេម និង ការប្រើប្រាស់ បណ្តាញ ទំនាក់ទំនង សង្គម ដែល មិន ពាក់ព័ន្ធ នឹង សកម្មភាព សិក្សា
គណៈ គ្រប់គ្រង គ្រឹះស្ថាន សិក្សា ត្រូវ ជំរុញ និង លើកទឹកចិត្ត ឱ្យ សិស្ស មាន ទម្លាប់ ធ្វើ ស្វ័យ សិក្សា អាន និង ស្រាវជ្រាវ ក្នុង បណ្ណាល័យ ។ បង្កើត និង អនុវត្ត ការអប់រំ ក្រៅ ម៉ោង សិក្សា ដូចជា ក្លិប សិក្សា តាម កម្រិត ថ្នាក់ និង តាម មុខវិជ្ជា ៕ និយ័តករបរ ធន បាលកិច្ច ទទួលស្គាល់ ក្រុមហ៊ុន អេស៊ា រៀល អ៊ីស្ទេត ( ខេមបូឌា ) ខូអិលធីឌី ជា ក្រុមហ៊ុន វាយតម្លៃ ក្នុង វិស័យ បរធន បាលកិច្ច
បរធន បាល បរធន បាល ទាយក ឬ អ្នក ផ្ដល់ វិភាគទាន បរធន បាលកិច្ច បុគ្គល ផ្ដល់ សេវា ពាក់ព័ន្ធ ក្នុង វិស័យ បរធន បាលកិច្ច និង សាធារណជន ទាំងអស់ ដែល មាន បំណង ប្រើប្រាស់ សេវា វាយតម្លៃ ក្នុង វិស័យ បរធន បាលកិច្ច អាច ទំនាក់ទំនង ទៅកាន់ ក្រុមហ៊ុន អេស៊ា រៀល អ៊ីស្ទេត ( ខេមបូឌា ) ខូអិលធីឌី៕ ក្រសួង អធិការកិច្ច បើក វគ្គ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ អធិការកិច្ច បឋម ជំនាន់ ទី៥ វគ្គ ៧+ ៨
( ភ្នំពេញ ) ៖ ក្រសួង អធិការកិច្ច បាន បើក វគ្គ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ អធិការកិច្ច បឋម ជំនាន់ ទី៥ វគ្គ ៧+ ៨ ដល់ សិក្ខាកាម ជា មន្រ្តី រាជការ បម្រើ ការងារ ពាក់ព័ន្ធ នឹង វិស័យ អធិការកិច្ច មក ពី ក្រសួង ស្ថាប័ន ចំនួន ១២ រួមទាំង សាលា រាជធានី និង ខណ្ឌ ទាំង ១៤ ចំណុះ រដ្ឋបាល សាលា រាជធានី ភ្នំពេញ ។
ពិធី បើក វគ្គ បណ្ដុះបណ្ដាល នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក ហួត ហាក់ រដ្ឋមន្រ្តី ក្រសួង អធិការកិច្ច នា ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នៅ សាល ប្រជុំ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន នាទី ស្តីការ ក្រសួង អធិការកិច្ច ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សហការី នៃ កាកបាទ ក្រហម កម្ពុជា សូម ឧទ្ទិស បួងសួង សុំ ដួង វិញ្ញាណក្ខន្ធ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ប្រាក់ វណ្ណឌី បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ »៕ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន និង សមាគម កីឡា វាយ កូន បាល់ បារាំង ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ ស្តីពី កិច្ចសហប្រតិបត្តិការ
( ប៉េកាំង ) ៖ កាលពី ថ្ងៃទី ២៣ ខែតុលា តាម ម៉ោង ក្នុង តំបន់ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន និង សមាគម កីឡា វាយ កូន បាល់ បារាំង បាន ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ ស្តីពី កិច្ចសហប្រតិបត្តិការ នៅ ទីក្រុង ប៉ារីស ដោយ ឈានដល់ ការឯកភាព គ្នា លើ កិច្ចសហប្រតិបត្តិការ ក្នុង ការរួមគ្នា ផ្សព្វផ្សាយ ពី ការប្រកួត កីឡា វាយ កូន បាល់ ពង្រឹង កិច្ចសហប្រតិបត្តិការ ឱ្យ ស៊ីជម្រៅ ក្នុង ការផ្សព្វផ្សាយ ព្រឹត្តិការណ៍ និង ការស្វែងរក ការអភិវឌ្ឍ នៃ វិស័យ កីឡា វាយ កូន បាល់ ជាដើម ។
វិទ្យុ មិត្តភាព កម្ពុជា ចិន រដ្ឋបាល ខេត្ត រតនគិរី រៀបចំ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា ខេត្ត ប្រចាំ ឆ្នាំ ២០២៣ នៅ ស្រុក វ៉ើន សៃ
( រតនគិរី ) ៖ រដ្ឋបាល ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា ខេត្ត ប្រចាំ ឆ្នាំ ២០២៣ នៅ ស្រុក វ៉ើន សៃ ។
ពិធី នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក កុយ ជៀច វើន សៃ សមាជិក ក្រុមប្រឹក្សា ខេត្ត . លោក វ៉ាន់ សោភា អភិបាល រង ខេត្ត និង មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា ខេត្ត ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព មួយចំនួន កងកម្លាំង ទាំង បី អាជ្ញាធរ មូលដ្ឋាន ប្រជាពលរដ្ឋ ជាច្រើន រយ នាក់ ។
ក្នុង អង្គ វេទិកា ខាង លើ នេះ សមាជិក សមាជិកា ក៏ បាន លើកឡើង នូវ ទុក្ខ កង្វល់ បញ្ហា ប្រឈម និង សំណូមពរ មួយចំនួន ។ ក្នុង នោះ ដែរ បាន លើកឡើង នូវ សំណួរ ផ្ទាល់ មាត់ ជាច្រើន ដោយ ផ្អែក ទៅ លើ បញ្ហា ហេដ្ឋារចនាសម្ព័ន្ធ ( ផ្លូវថ្នល់ ) កសិកម្ម អគ្គិសនី អប់រំ ប្រព័ន្ធ ធារាសាស្ត្រ ពាណិជ្ជកម្ម ( រក ទីផ្សារ លក់ កសិផល ) គ្មាន ការងារ ធ្វើជាដើម ។
ក្នុង នោះ ត្រូវបាន សាមីមន្ទីរ អង្គភាព ជំនាញ មាន ការពាក់ព័ន្ធ បាន ធ្វើ ការបកស្រាយ បំភ្លឺ ជូន ដល់ អង្គ វេទិកា ទាំងមូល ឲ្យ អស់ កង្វល់ ដែល ប្រជាពលរដ្ឋ មាន ទុក្ខ កង្វល់ កន្លងមក ឲ្យបាន កាន់តែ ជ្រួល ជ្រាប ផងដែរ ។ អង្គ វេទិកា ដ៏ ទទួលបាន សំណួរ ក៏ ដូច សំណូមពរ ដែល សរសេរ ជា លាយ ល័ក្ខ អក្សរ ជាច្រើន សំណួរ និង សំណូមពរ ផ្សេង ៗ ជាច្រើន ។
លោក កុយ ជៀច វើន សៃ បាន គូសបញ្ជាក់ ថា អង្គ វេទិកា នេះ គឺ ដើម្បីឲ្យ ក្រុមប្រឹក្សា ខេត្ត ធ្វើការរាល់ នូវ មតិ យោបល់ បញ្ហា ប្រឈម និង សំណូមពរ នានា មក ធ្វើ ការពិភាក្សា ស្រាយ បំភ្លឺ ឲ្យបាន ច្បាស់លាស់ ប្រកបដោយ តម្លាភាព និង ឈាន ទៅរក ការដោះស្រាយ ជូន ចំ គោលដៅ មាន ប្រសិទ្ធភាព និង ទាន់ ពេលវេលា ក្នុង ករណី ដោះស្រាយ បាន ភ្លាម ៗ គឺ ដោះស្រាយ ជូន ភ្លាម . តែ ករណី មិន អាច ដោះស្រាយ បាន ភ្លាម ៗ នឹង លើក ពេល ក្រោយ បន្ត ទៀត ដោយ មិន ទុក បញ្ហា ឬ គេចវេស ពី បញ្ហា ដែល បាន លើកឡើង ក្នុង អង្គ វេទិកា នេះ ឡើយ ។
លោក កុយ វៀច វើន សៃ បាន បន្ថែម ថា វេទិកា ពិគ្រោះយោបល់ ថ្ងៃ នេះ ពិតជា មាន សារៈសំខាន់ ក្នុង ការជួយ ជំរុញ ដល់ ការអនុវត្ត មុខងារ គ្រប់ ស្ថាប័ន មាន ការពាក់ព័ន្ធ និង អាជ្ញាធរ មូលដ្ឋាន ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព បន្ថែម ទៀត ស្រប តាម ច្បាប់ លិខិត បទដ្ឋាន គតិយុត្ត នៅ ថ្នាក់ មូលដ្ឋាន ។ ការពិនិត្យ និង ដោះស្រាយ បញ្ហា សំណួរ - សំណូមពរ របស់ ប្រជាពលរដ្ឋ និង ជួយ ជំរុញ ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម សំដៅ លើកកម្ពស់ គុណភាព ជីវិត កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ទាំងមូល ផងដែរ ៕
រដ្ឋបាល ខេត្ត សៀមរាប រៀបចំ សិក្ខាសាលា កសាង សមត្ថភាព ស្តីពី ការចងក្រង ម៉េតា ទិន្នន័យ និង ការប្រើប្រាស់ កម្មវិធី ថ្នាល ទិន្នន័យ សម្រាប់ រាយការណ៍ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព
លោក សុខ ថុល ក៏ បាន ណែនាំ ដល់ សិក្ខាកាម ទាំងអស់ ដែល បាន ចូលរួម សិក្ខាសាលា នេះ នឹង ទទួលបាន នូវ ចំណេះដឹង ថ្មី បន្ថែម ទៀត អំពី ការចងក្រង ទិន្នន័យ សម្រាប់ សូចនាករ នៃ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ផងដែរ ។
បច្ចុប្បន្ន សម្រាប់ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព កម្ពុជា (CSDG) គឺ មាន ចំនួន ១៨ គោលដៅ ( ដោយ បន្ថែម គោលដៅ មួយ របស់ កម្ពុជា ស្តីពី ការបញ្ចប់ ផល ប៉ះពាល់ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម ព្រមទាំង ជំរុញ ការសង្គ្រោះ ជនរងគ្រោះ ) មាន ចំនួន ៨៨ ចំណុច ដៅ និង ១៤៨ សូចនាករ សម្រាប់ គាំទ្រ ការសម្រេច គោលដៅ ទាំង ១៨ នេះ ។
លោក លី ចាន់ សុភក្តី បាន បង្ហាញ ក្តីសង្ឃឹម យ៉ាង មុតមាំ ថា សិក្ខាកាម នឹង មាន ការខិតខំ ធ្វើ ការរួមគ្នា ជា ប្រព័ន្ធ និង រៀនសូត្រ បទពិសោធន៍ រវាង អ្នកចូលរួម ពី បណ្ដ មន្ទីរ - សា្ថប័ន ពាក់ព័ន្ធ ថែមទាំង បាន យល់ដឹង កាន់តែ ទូលំទូលាយ អំពី ចរិក លក្ខណៈ របស់ សូចនាករ ភាព សំខាន់ របស់ ម៉េតា ទិន្នន័យ និង ស្វែងយល់ ពី ប្រព័ន្ធ កម្មវិធី ថ្នាល ទិន្នន័យ សម្រាប់ រាយការណ៍ សូចនាករ អភិវឌ្ឍន៍ ជាតិ (CAMSTAT) និង ប្រព័ន្ធ កម្មវិធី ថ្នាល ទិន្នន័យ សម្រាប់ ផ្សព្វផ្សាយ សូចនាករ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព (Open SDG) ៕
អភិបាល ខេត្ត កំពត ជួប សំណេះសំណាល ជាមួយ គ្រូបង្រៀន ក្របខ័ណ្ឌ ថ្មី និង ណែនាំឲ្យ ធ្វើជា គំរូ ដល់ សិស្សានុសិស្ស
( កំពត ) ៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត បាន ណែនាំ ដល់ គ្រូបង្រៀន គ្រប់ រូបភាព ទាំងអស់ ត្រូវតែ ធ្វើជា គម្រូ ល្អ សម្រាប់ បង្កើត ឲ្យបាន នូវ ធនធាន មនុស្ស ដែល មាន សក្តានុពល ។ ការលើកឡើង របស់ លោក អភិបាល ខេត្ត ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ គ្រូបង្រៀន ក្របខ័ណ្ឌ ថ្មី ដែល ត្រូវ ចេញ បម្រើ ការងារ សម្រាប់ ឆ្នាំ ២០២៣ នា ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នៅ មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត កំពត ។
លោក អភិបាល ខេត្ត បាន លើកឡើង ថា ប្រទេស កម្ពុជា ក្រោយពី ទទួលបាន នូវ សុខ សន្តិភាព ពេញលេញ ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រទេសជាតិ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ពិសេស វិស័យ អប់រំ ដែល វិស័យ នេះ ត្រូវបាន រាជ រដ្ឋាភិបាល គិតគូរ មុន គេ និង ជា វិស័យ អាទិភាព មួយ ក្រោយ មាន ការបំផ្លេច បំផ្លាញ ក្នុង របប ៣ ឆ្នាំ ៨ខែ ២០ ថ្ងៃ ហើយ អ្វី ដែល មិន អាច ខ្វះ បាន នោះ គឺ គ្រូបង្រៀន ដែល ជា អ្នក ផ្តល់ ប្រភព ចំណេះដឹង ។
អាជីវករ ដឹក កសិផល ចូល វៀតណាម តាម ច្រក អូរយ៉ាដាវ រអ៊ូ រឿង ភាគី វៀតណាម បង្ក ភាពស្មុគស្មាញ និង អំពាវនាវ ថ្នាក់ដឹកនាំ ជួយ សម្របសម្រួល
( រតនគិរី ) ៖ ទោះបី មាន កិច្ចព្រមព្រៀង រវាង ប្រទេស ជិតខាង ក្នុង ការដឹក កសិផល ទៅ លក់ តាម ច្រក ទ្វារ អន្តរជាតិ នានា ដោយ មាន ការយោគយល់ គ្នា យ៉ាងណា ក៏ដោយ ប៉ុន្តែ សម្រាប់ ច្រកទ្វារ អន្តរជាតិ អូរ យ៉ាដាវ ខេត្ត រតនគិរី ភាគី ខាង វៀតណាម តម្រូវឲ្យ កសិផល ទាំងនោះ មាន (CO) ដោយ មាន លិខិត បញ្ជាក់ ថា ក សិផល ទាំងនោះ ដាំដុះ ក្នុង ខេត្ត ណា ខ្លះ មាន ប្រភេទ អ្វី ខ្លះ ក្នុង ប្រទេស កម្ពុជា ។
ជាក់ស្តែង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នេះ សកម្មភាព នៅ ច្រកទ្វារ អន្តរជាតិ អូរ យ៉ាដាវ មាន ភាពស្ងប់ស្ងាត់ ( កសិផល ដឹក ចូលទៅ វៀតណាម ) មាន តែ សកម្មភាព រថយន្ត ធំ ៗ ដឹក ទំនិញ ចេញ ពី វៀតណាម មក ខ្មែរ តែ ប៉ុណ្ណោះ ។
អ្នករកស៊ី ដឹក កសិផល ទៅ វៀតណាម ឆ្លងកាត់ ច្រកទ្វារ អន្តរជាតិ អូរ យ៉ាដាវ ដឹក បង្វែរ ទៅ លក់ ច្រកទ្វារ អន្តរជាតិ ផ្សេង ៗ ព្រោះ មិន ដឹង ទៅ រត់ ការធ្វើ បែបបទ (CO) នៅ ឯណា ទេ ដោយ ហេតុ ថា ពួកគេ គ្មាន ក្រុមហ៊ុន ដោយ គ្រាន់តែ អ្នករកស៊ី តូចតាច ធម្មតា ដើរ ទិញ តាម ចំការ តាម បណ្តា ខេត្ត លក់ បន្ត យក ចំណេញ ក្បាល កាក់ ។
ពួកគាត់ លើកឡើង ស្រដៀង គ្នា ថា ខាង ខ្មែរ ដឹក កសិផល តិចតួច តាម រដូវ ទៅ លក់ នៅ វៀតណាម តាម ច្រក ទ្វារ អន្តរជាតិ អូរ យ៉ាដាវ . ភាគី វៀតណាម រឹតបន្តឹង ខ្លាំង ណាស់ តែ សម្រាប់ ភាគី វៀតណាម វិញ រថយន្ត ដឹក ទំនិញ ទាំង ខ្សែ ចូល ដី ខ្មែរ ដោយ គ្មាន ឧបសគ្គ អី ទេ ហើយ បើ រថយន្ត តាក់ស៊ី វៀតណាម ដើរ ប្រមូល ភ្ញៀវ តាម ក្រុមហ៊ុន ដល់ ខេត្ត ក្រចេះ ខេត្ត ស្ទឹងត្រែង ខេត្ត រតនគិរី ដល់ គោលដៅ តែម្តង ដោយ គ្មាន ខ្វល់ ពី រឿង ប្រជាពលរដ្ឋ ខ្មែរ ប្រកបរបរ ដឹក ភ្ញៀវ ដាច់ ជើង ទេ ។
លោក ថា ក្នុង រយៈពេល ថ្មី ៗ វៀតណាម តម្រូវឲ្យ អ្នក ដឹក កសិផល មាន (CO) ទើប ឲ្យ ចូល នោះ រូប លោក តំណាង ឲ្យ រដ្ឋបាល ខេត្ត និង សមត្ថកិច្ច ប្រចាំ ការច្រកទ្វារ អន្តរជាតិ អូរ យ៉ាដាវ ខិតខំ ជួយ សម្របសម្រួល ឲ្យ កសិផល អត់ (CO) ទាំងអស់ ដឹក ចូលទៅ លក់ វៀតណាម ដោយ រលូន ហើយ ៕ នាយ សេនាធិការ រង យោធ ភូមិភាគ ទី៥ ផ្សព្វផ្សាយ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ និតី កាល ទី៧ នៅ ទីបញ្ជាការ វរសេនា តូច ថ្មើរជើង លេខ ៥៣៣
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ ដោយ បាន ការអនុញ្ញាត ពី លោក មេបញ្ជាការ រង កងទ័ព ជើងគោក មេបញ្ជាការ យោធ ភូមិភាគ ទី៥ បាន ចាត់តាំង លោក ឧត្តមសេនីយ៍ ត្រី លឹម សុវណ្ណ នាយ សេនាធិការ រង យោធ ភូមិភាគ ទី៥ ផ្សព្វផ្សាយ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា ឆ្នាំ ២០២៣ នៅ ទីបញ្ជាការ វរសេនា តូច ថ្មើរជើង លេខ ៥៣៣ ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន វរសេនា តូច ថ្មើរជើង លេខ ៥៣៣ កងពល តូច ថ្មើរជើង លេខ ៥៣ ។
ក្នុង ឱកាស នេះ លោក ឧត្តមសេនីយ៍ ត្រី នាយ សេនាធិការ រង យោធ ភូមិភាគ ទី៥ បាន ធ្វើ បទ ឧទ្ទេសនាម ស្តីពី សភាពការណ៍ អន្តរជាតិ សភាពការណ៍ ក្នុង តំបន់ និង សភាពការណ៍ ក្នុង ប្រទេស ដែល បាន កើតឡើង នា ពេល ថ្មី ៗ នេះ ព្រមទាំង វាយ បក សង្រ្គាម ចិត្តសាស្រ្ត និង បញ្ជាក់ បន្ថែម ពី តួនាទី ភារកិច្ច របស់ កងយោធពល ខេមរភូមិន្ទ ជូន នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ផងដែរ ។
ក្រោយពី បញ្ចប់ បទ បង្ហាញ លោក មេបញ្ជាការ ព្រមទាំង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន វរសេនា តូច ថ្មើរជើង លេខ ៥៣៣ សូម ប្រកាស ប្តេជ្ញា ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ការពារ សន្តិភាព ការពារ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល កើត ចេញពី ការបោះឆ្នោត និតី កាល ទី៧ និង សូម គាំទ្រ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ដើម្បី ដឹកនាំ មាតុភូមិ កម្ពុជា ឲ្យបាន រីកចម្រើន រុងរឿង លើ គ្រប់ វិស័យ តទៅ អនាគត ៕
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ចេញ សេចក្តីសម្រេច ទទួលស្គាល់ ជា ផ្លូវការ សមាសភាព ក្រុមការងារ ទាំង ១៤ ផ្នែក ឯកជន នៃ វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន
ប្រសិនបើ មិន មាន ការប្រែប្រួល ទេ លោក វ៉ាង យី ដែល ជា មន្ត្រី ទូត កំពូល របស់ ចិន នឹង មាន វត្តមាន ក្នុង រដ្ឋធានី របស់ សហរដ្ឋ អាមេរិក ចាប់ពី ថ្ងៃព្រហស្បតិ៍ ដល់ ថ្ងៃសៅរ៍ គិត ក្នុង រយៈពេល ជិត ៥ ឆ្នាំ ចំពោះ មុខ ភាពតានតឹង ផ្នែក ពាណិជ្ជកម្ម វិបត្តិ អ៊ុយក្រែន បញ្ហា តៃវ៉ាន់ ជម្លោះ ក្នុង តំបន់ មជ្ឈិមបូព៌ា និង ការកើនឡើង នូវ ភាពតានតឹង នៅឯ សមុទ្រ ចិន ខាងត្បូង ។
មន្រ្តី ជាន់ ខ្ពស់ មួយ របស់ សហរដ្ឋ អាមេរិក បាន និយាយ ថា ផែនការ នៃ ដំណើរទស្សនកិច្ច នេះ គឺជា ផ្នែក មួយ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ មហា អំណាច ទាំង ពីរ ដើម្បី គ្រប់គ្រង ការប្រកួតប្រជែង ប្រកបដោយ ការទទួលខុសត្រូវ ។ នៅ ត្រូវបាន សាកសួរ ថា តើ ដំណើរទស្សនកិច្ច របស់ លោក វ៉ាង នឹង ត្រួសត្រាយ ឲ្យ មាន ទស្សនកិច្ច ផ្លូវការ របស់ លោក ស៉ី ជិន ពីង ដែរ ឬ ទេ ? មន្ត្រី អាមេរិក មួយ រូប ទៀត បាន ឆ្លើយ ដោយ មិន បញ្ជាក់ លម្អិត ថា លោក បៃ ដិន ធ្លាប់ និយាយ ជាច្រើន ដង ថា នឹង បាន ជួប លោក ស៉ី នា ពេល ខាងមុខ ។
គួរ បញ្ជាក់ ថា ចិន និង សហរដ្ឋ អាមេរិក ក្នុង ប៉ុន្មាន ខែ ថ្មី ៗ នេះ បាន បង្ហាញ ពី ចំណាប់អារម្មណ៍ ក្នុង ការចៀសវាង ជម្លោះ ។ ប៉ុន្តែ ប្រឈមមុខ នឹង ការផ្ទុះឡើង នៃ អំពើហិង្សា នៅ តំបន់ មជ្ឈិមបូព៌ា ចិន និង សហរដ្ឋ អាមេរិក ហាក់ កំពុង ស្វែងរក ផលប្រយោជន៍ ផ្នែក ការទូត ប្រឆាំង គ្នា ទៅ វិញ ទៅមក ៕ រូបភាព ពី AFP វេទិកា ធុរកិច្ច សំបុក ត្រចៀកកាំ រៀបចំ ជា លើក ដំបូង នៅ កម្ពុជា ប្រមូលផ្តុំ ពាណិជ្ជករ មកពី បណ្តា ប្រទេស នាំចូល សំបុក ត្រចៀក
( ភ្នំពេញ ) ៖ វេទិកា ធុរកិច្ច សំបុក ត្រចៀកកាំ កម្ពុជា បាន រៀបចំឡើង ជា លើក ដំបូង នៅ កម្ពុជា រយៈពេល ២ ចាប់ពី ថ្ងៃទី ២៤ ដល់ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ ដោយ មាន ការចូលរួម ពី ពាណិជ្ជករ មកពី បណ្តា ប្រទេស ដែល នាំចូល សំបុក ត្រចៀកកាំ ដើម្បី កែច្នៃ មាន ដូចជា ឥណ្ឌូនេស៊ី ម៉ាឡេស៊ី វៀតណាម ថៃ ភូមា ចិន ( ហុងកុង ម៉ាកា កោះ តៃវ៉ាន់ ) និង សិង្ហបុរី ជាដើម ដើម្បី សិក្សា ពី គុណភាព សំបុក ត្រចៀកកាំ កម្ពុជា ខណៈ កម្ពុជា និង ចិន បាន និង កំពុង ចរចា បើក ទីផ្សារ នាំចេញ សំបុក ត្រចៀកកាំ ទៅ ប្រទេស ចិន នា ពេល ខាងមុខ ។
លោក សំហេង បូរ៉ា រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម បាន ថ្លែង ថា « វេទិកា ធុរកិច្ច សំបុក ត្រចៀកកាំ កម្ពុជា » បាន ឆ្លុះបញ្ចាំង ពី ការប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ និង មាន សារៈសំខាន់ សម្រាប់ ការស្វែងយល់ កាន់តែ ច្រើន អំពី វិស័យ ត្រចៀកកាំ កម្ពុជា ជាពិសេស បាន ផ្ដល់ ឱកាស ជូន អាជីវករ និង ពាណិជ្ជករ ជាតិ និង អន្តរជាតិ ក្នុង ការពង្រឹង និង ពង្រីក ការធ្វើ ពាណិជ្ជកម្ម លើ វិស័យ ត្រចៀកកាំ ។
លោក បន្ត ថា « វេទិកា នេះ នឹង ជួយ ជំរុញ និង បង្កើត ឱកាស ក្នុង ការអភិវឌ្ឍ វិស័យ ត្រចៀកកាំ កម្ពុជា ក្នុង ក្របខណ្ឌ ជាតិ និង ពាណិជ្ជកម្ម ជាមួយ អន្តរជាតិ ដែល នឹង ចូលរួមចំណែក ក្នុង ការបង្កើន កម្រិត ចំណូល របស់ ប្រជាជន កម្ពុជា ជំរុញ កំណើន សេដ្ឋកិច្ច និង ការអភិវឌ្ឍ របស់ កម្ពុជា » ។
លោក បន្ត ថា វិស័យ ត្រចៀកកាំ បាន ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ការអភិវឌ្ឍ ដល់ សេដ្ឋកិច្ច គ្រួសារ សហគមន៍ និង សេដ្ឋកិច្ច ជាតិ ។
លោក បាន ជំរុញ និង លើកទឹកចិត្ត ដល់ សហគម អ្នកផលិត និង នាំចេញ សំបុក ត្រចៀកកាំ កម្ពុជា និង ភាគី ពាក់ព័ន្ធ ក្នុង វិស័យ ត្រចៀកកាំ កម្ពុជា ត្រូវ បន្ត ពង្រឹង គុណភាព ផលិតផល សំបុក ត្រចៀកកាំ បង្កើន បរិមាណ ផលិត ដើម្បី ធានា បាន នូវ ស្ថិរភាព នៃ ការផ្គត់ផ្គង់ និង ការបំពេញ បាន តាម លក្ខខណ្ឌ និង នីតិវិធី តម្រូវ នានា សម្រាប់ ការនាំចេញ ទៅ ទីផ្សារ អន្តរជាតិ ។
ក្នុង វេទិកា ធុរកិច្ច ត្រចៀកកាំ កម្ពុជា នេះ ក៏ មាន ការតាំង បង្ហាញ សំបុក ត្រចៀកកាំ និង ផលិតផល ពាក់ព័ន្ធ ការដាក់ ដេញថ្លៃ សំបុក ត្រចៀកកាំ និង ជំនួប អាជីវកម្ម រវាង ផលិតផល ខ្មែរ និង បរទេស ។
លោកស្រី ចុង ជា ទីប្រឹក្សា ផ្នែក សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម នៃ ស្ថានទូ ចិន ប្រចាំ កម្ពុជា បាន ថ្លែង ថា បច្ចុប្បន្ន នាយកដ្ឋាន ពាក់ព័ន្ធ នៃ ប្រទេស ចិន និង កម្ពុជា កំពុង ចរចា យ៉ាង សកម្ម លើ កិច្ចព្រមព្រៀង នាំចេញ សំបុក ត្រចៀកកាំ កម្ពុជា ទៅកាន់ ប្រទេស ចិន ។
លោកស្រី បន្ត ថា « យើង ទន្ទឹងរង់ចាំ ការនាំចូល សំបុក ត្រចៀកកាំ ដែល មាន គុណភាព ខ្ពស់ របស់ កម្ពុជា ទៅកាន់ ទីផ្សារ ប្រទេស ចិន » ។
លោកស្រី គូសបញ្ជាក់ ថា ចិន នៅតែ ជា ដៃគូ ពាណិជ្ជកម្ម ធំ បំផុត របស់ កម្ពុជា ខណៈ ផលិតផល កសិកម្ម ដែល មាន គុណភាព ខ្ពស់ របស់ កម្ពុជា ត្រូវបាន នាំចេញ ទៅកាន់ ប្រទេស ចិន ជា បន្តបន្ទាប់ ដូចជា អង្ករ ចេក មៀន ដូង និង កសិផល ផ្សេង ទៀត ព្រមទាំង ផលិតផល កសិកម្ម ជាច្រើន ត្រូវបាន នាំចេញ ទៅ ប្រទេស ចិន ដោយ ជោគជ័យ ។
នា ពេល បច្ចុប្បន្ន កម្ពុជា មាន ផ្ទះ ត្រចៀកកាំ ប្រមាណ ជាង ៥ពាន់ ផ្ទះ ដោយ មាន កំណើន ក្នុង រង្វង់ ១៥% ជារៀងរាល់ ឆ្នាំ ។ កំណើន សំណង់ ផ្ទះ ត្រចៀកកាំ នេះ បាន ធ្វើឱ្យ មាន កំណើន បរិមាណ ផលិតផល សំបុក ត្រចៀកកាំ ជារៀងរាល់ ឆ្នាំ ដោយ ជា មធ្យម មាន ប្រមាណ ១០០ តោន ក្នុង មួយ ឆ្នាំ សម្រាប់ ផ្គត់ផ្គង់ នៅលើ ទីផ្សារ ៕
មន្ដ្រី ជាន់ ខ្ពស់ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ជំរុញ មន្រ្តី អនុវត្ត ច្បាប់ ជួរ មុខ សហការ គ្នា ត្រួតពិនិត្យ ផ្ទៀងផ្ទាត់ រាល់ ឯកសារ ពាក់ព័ន្ធ ការនាំចូល សារធាតុ គីមី ផ្សំ
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ឡាយ គឹម លី អគ្គ លេខាធិការ រង នៃ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ជំរុញ មន្ដ្រី អនុវត្ត ច្បាប់ ជួរ មុខ ទាំងអស់ ត្រូវ រួម សហការ គ្នា ត្រួតពិនិត្យ ផ្ទៀងផ្ទាត់ រាល់ ឯកសារ ពាក់ព័ន្ធ នឹង ការនាំចូល សារធាតុ ផ្សំ គ្រប់ ប្រភេទ ។
ការលើកឡើង របស់ លោក ឧត្តមសេនីយ៍ ឯក ឡាយ គឹម លី ធ្វើឡើង ក្នុង ពិធី បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី ការពង្រឹង ប្រសិទ្ធភាព ការត្រួតពិនិត្យ សារធាតុ គីមី ផ្សំ គ្រឿងញៀន សម្រាប់ មន្រ្តី អនុវត្ត ច្បាប់ ពាក់ព័ន្ធ នា ព្រឹក ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០២៣ នេះ ។ វគ្គ បណ្ដុះបណ្ដាល នេះ មាន ការចូលរួម សិក្ខាកាម ជា មន្ត្រី អនុវត្ត ច្បាប់ បម្រើ ការងារ នៅ តាម បណ្តា ខេត្ត ជាប់ ព្រំដែន ខេត្ត គោលដៅ មាន ក្រុមហ៊ុន រោងចក្រ ប្រើប្រាស់ សារា តុ គីមី ផ្សំ ច្រើន អង្គភាព គយ និង រដ្ឋាករ កម្ពុជា បណ្តា ច្រកទ្វារ ព្រំដែន កំពង់ផែ ស្វយ័ត ។
