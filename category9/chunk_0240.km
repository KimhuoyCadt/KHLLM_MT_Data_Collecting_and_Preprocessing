( ភ្នំពេញ ) ៖ វិធានការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ រយៈពេល ៣សប្តាហ៍ ត្រូវបាន បិទ បញ្ចប់ ត្រឹម ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ ។ លោក កើត ឆែ អភិបាល រង រាជធានី ភ្នំពេញ បាន ចាត់ទុក វិធានការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ ជា វិធានការ ល្អ វិធានការ ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីដ១៩ ។
ក្រោយពេល មាន ការរីករាលដាល ខ្លាំង ជំងឺ កូវីដ១៩ ក្នុង រាជធានី ភ្នំពេញ បាន ជំរុញ ឱ្យ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច បិទ រាជធានី ភ្នំពេញ រយៈពេល ៣សប្តាហ៍ គិត ចាប់ពី ថ្ងៃទី ១៥ ខែមេសា ដល់ ថ្ងៃទី ០៥ ខែឧសភា ។ វិធានការ នេះ អ្នកជំនាញ សុខភាព មើលឃើញ ថា ជា វិធានការ យុទ្ធសាស្ត្រ មួយ ក្នុង ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
ជាមួយគ្នា នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ បាន សហការ ជាមួយ ក្រសួង សុខាភិបាល ក្នុង ការចាត់ វិធានការ សុខាភិបាល បន្ថែម ទៀត រួម មាន ការយក អ្នកជំងឺ កូវីដ១៩ ទៅ ព្យាបាល . កំណត់ អ្នក ពាក់ព័ន្ធ ដើម្បី យក សំណាក និង ធ្វើចត្តាឡី ស័ក . ការសាងសង់ និង រៀបចំ មណ្ឌល ចត្តាឡី ស័ក ថ្មី និង ការរៀបចំ កន្លែង ព្យាបាល ជំងឺ កូវីដ១៩ បន្ថែម ។ល ។
បើ ទោះបី រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ចាត់ វិធានការ បែប នេះ ក្តី តែ ស្ថានភាព នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ មិន មាន ការថមថយ ឡើយ ។ ព្រោះតែ ការអនុវត្ត វិធាន ទាំងនេះ មិន មាន ប្រសិទ្ធភាព ក្នុង ការទប់ស្កាត់ ការចម្លង ជំងឺ កូវីដ១៩ នេះ ហើយ ទើប នាំឱ្យ រាជ រដ្ឋាភិបាល ឈានដល់ ការដាក់ចេញ វិធានការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ ។
លោក កើត ឆែ បាន អះអាង ថា ការបិទ ខ្ទប់ នេះ មាន គោលបំណង ការពារ អាយុជីវិត របស់ ប្រជាពលរដ្ឋ . កាត់ផ្តាច់ការចម្លង ពី មនុស្ស ម្នាក់ ទៅ មនុស្ស ម្នាក់ . កាត់ផ្តាច់ការចម្លង ពី តំបន់ មួយ ទៅ តំបន់ មួយ និង ទប់ស្កាត់ ការរីកសាយភាយ ទៅ តាម បណ្តា ខេត្ត ។
អភិបាល រង រាជធានី រូប នេះ បាន លើកឡើង ថា វិធានការបិទ ខ្ទប់ នេះ អត្រា ឆ្លង មិន ថមថយ ទេ ក៏ប៉ុន្តែ រដ្ឋា បាល រាជធានី ភ្នំពេញ អាច កំណត់ ទីតាំង ដែល ឆ្លង បាន ។ លោក បាន បញ្ជាក់ ថា ដំបូង ឡើយ ជំងឺ បាចសាយ ពេញ រាជធានី ភ្នំពេញ មិន អាច ដឹង នៅ កន្លែងណា ប៉ុន្តែ ក្រោយ បិទ ខ្ទប់ មក គេ អាច ដឹង ថា កន្លែង ឆ្លង ខ្លាំង នៅ កន្លែងណា កន្លែង ឆ្លង មធ្យម នៅ កន្លែងណា និង កន្លែង ឆ្លង ស្រាល នៅ កន្លែងណា ?
លោក បាន បញ្ជាក់ យ៉ាង ដូច្នេះ « វិធានការ របស់ រាជ រដ្ឋាភិបាល គឺជា វិធានការ ដែល ទាន់ ពេលវេលា បំផុត សម្រាប់ ទប់ស្កាត់ ការរីក បាច សាច ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស កម្ពុជា យើង នេះ » ។
បន្ទាប់ពី កំណត់ បាន នូវ តំបន់ ប្រឈម ការរីករាលដាល ជំងឺ កូវីដ១៩ ហើយ នោះ រាជ រដ្ឋាភិបាល បាន សម្រេច ដក វិធានការបិទ ខ្ទប់ ហើយ សម្រាប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ចាប់ពី ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ តទៅ ។ បើ ទោះបីជា ដក វិធានការបិទ ខ្ទប់ តែ រដ្ឋបាល រាជធានី ភ្នំពេញ បន្ត ដាក់ ចេញ វិធានការ រដ្ឋបាល រយៈពេល មួយ សប្តាហ៍ បន្ថែម ទៀត ដើម្បី គ្រប់គ្រង ស្ថានភាព ជំងឺ កូវីដ១៩ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ នៅតែ បន្ត បែងចែក ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ជា៣ តំបន់ ដដែល តែ វីសាលភាព តំបន់ ពណ៌ លឿង កាន់តែ ទូលាយ ខណៈ តំបន់ ពណ៌ ក្រហម និង ពណ៌ លឿង ទុំ បាន បង្រួម កាន់តែ តូច ។
បើ ទោះបីជា តំបន់ ពណ៌ លឿង មាន វីសាលភាព ធំ ក្តី តែ រាជធានី ភ្នំពេញ មិន ទាន់ រួចផុត ពី ហានិភ័យ នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ នៅឡើយ នោះ ទេ ។ ក្នុង ន័យ នេះ លោក កើត ឆែ បន្ត អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ យកចិត្តទុកដាក់ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធាន សុខាភិបាល ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ និង ឈាន ទៅ កាត់ផ្តាច់ការចម្លង ។
យោង តាម សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត សៀមរាប ដែល បណ្ដាញ សារព័ត៌មាន Fresh News ទទួលបាន ករណី បិទ ខ្ទប់ ខាងលើ នេះ ដើម្បី បង្ការ ការរាលដាល ជំងឺ កូវីដ១៩ នៅ មូលដ្ឋាន ខណៈ ដែល កាលពី ម្សិលមិញ មាន ប្រជាពលរដ្ឋ នៅ តំបន់ ខាងលើ តេស្ដ ឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ ។ រដ្ឋបាល ខេត្ត បញ្ជាក់ ថា ការបិទ នេះ នឹង ចាប់ផ្តើម ពី ថ្ងៃ នេះ តទៅ រហូត ទាល់តែ មាន សេចក្ដីជូនដំណឹង ថ្មី ឡើងវិញ ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត ក៏ អំពាវនាវ ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ រស់ នៅក្នុង ខេត្ត សៀមរាប ត្រូវ បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចូលរួម អនុវត្ត វិធានការ ការពារ ៣ការពារ ៣កុំ និង ត្រូវ អនុវត្ត កាតព្វកិច្ច ពាក់ ម៉ាស និង កាតព្វកិច្ច រក្សា គម្លាត សុវត្ថិភាព ជាពិសេស ត្រូវ អនុវត្ត វិធានការ រដ្ឋបាល និង វិធានការចត្តាឡី ស័ក ។ បុគ្គល ទាំងឡាយ ណា ដែល ប្រព្រឹត្ត ល្មើស នឹង វិធានការ នេះ នឹង ប្រឈម ការពិន័យ អន្តការណ៍ ឬ ផ្តន្ទាទោស តាម ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ជាធរមាន ៕
៤ខែ ឆ្នាំ នេះ សមត្ថកិច្ច បង្ក្រាប បទល្មើស គ្រឿងញៀន បាន ២. ៣៨៧ករណី ឃាត់ខ្លួន មនុស្ស ៥. ៣២៣ នាក់ និង រឹបអូស ថ្នាំ ញៀន ជាង ៦០០ គីឡូក្រាម
( ភ្នំពេញ ) ៖ ក្នុង ឱកាស ទទួលបាន ការការវ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ . កម្មករ សាងសង់ ក្រសួង ការពារ ជាតិ កម្មករ សាងសង់ ពហុកីឡដ្ឋាន មរតក តេជោ ព្រមទាំង សន្តិសុខ និង អ្នកស្ម័គ្រចិត្ត ទាំងអស់ បាន សម្តែង នូវ ក្តីរំភើបចិត្ត និង ថ្លែងអំណរគុណ ដល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន គិតគូរ ពី សុខភាព របស់ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ។
ការថ្លែងអំណរគុណ នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ ចុះ ត្រួតពិនិត្យ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ដល់ កីឡាករ កីឡាការិនី ត្រៀម ចេញ ទៅ ប្រកួត ស៊ីហ្គេម ក្រុម វិស្វករ បុគ្គលិក កម្មករ កសាង ក្រសួង ការពារ ជាតិ និង កម្មករ ក សាង ពហុកីឡដ្ឋាន មរតក តេជោ ប្រមាណ ១.៥០០ នាក់ នៅ ពហុកីឡដ្ឋាន មត រក តេជោ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ ។
ប្រជាពលរដ្ឋ ដែល ទទួលបាន វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ដែល រៀបចំ ចាក់ ដោយ ក្រសួង ការពារ ជាតិ បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ដឹកនាំ ដោយ សម្តេច តជោ ហ៊ុន សែន គឺ បាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ គ្រប់ ស្រទាប់ វណ្ណៈ ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ ជាពិសេស នា ដំណាក់កាល រាត តត្បាត ជំងឺ កូវីដ១៩ ជា សកល ដែល សម្តេច បាន ខិតខំ រក វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ នេះ មក ចាក់ ជូន ប្រជាពលរដ្ឋ មន្ត្រីរាជការ ព្រមទាំង អ្នក ដែល អាច ប្រឈម នឹង ជំងឺ នេះ ជាដើម ។
បើ តាម កញ្ញា ជា ឡៃ វណ្ណ បម្រើ ការងារ នៅ ក្រសួង ការពារ ជាតិ បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News យ៉ាង ដូច្នេះ ថា៖ កញ្ញា មាន អារម្មណ៍ រំភើប ណាស់ ក្រោយ បាន ទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ នា ពេលនេះ និង សូម អរគុណ ដល់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ដែល បាន គិតគូរ យ៉ាង យកចិត្ត ទុក បំផុត ដោយ ផ្តល់ វ៉ាក់សាំង មក ចាក់ ជូន ប្រជាជន គ្រប់ ស្រទាប់ វណ្ណៈ ដើម្បី សុខ មាលភាព របស់ ប្រជាជន គ្រប់ ៗ គ្នា ។
កញ្ញា ជា ឡៃ វណ្ណ បាន បន្ត ថា សូម កុំ ចាញ់បោក ឃោសនា របស់ បុគ្គល មួយចំនួន តូច ឱ្យ សោះ ក្រោយ កញ្ញា បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ រួច រាល់ គឺ មិន មាន បញ្ហា អ្វី នោះ ទេ តែ ផ្ទុយទៅវិញ វ៉ាក់សាំង នេះ បាន ការពារ ពី ជំងឺ កូវីដ១៩ ខណៈ ប្រជាជន នៅ តាម បណ្តា ប្រទេស ជាច្រើន ក៏ បាន ចាក់ វ៉ាក់សាំ ផលិត ពី ប្រទេស ចិន ផងដែរ ។
លោក កើត សែ អាយុ ៦៦ ឆ្នាំ ជា សន្តិសុខ បម្រើការ នៅ ក្រុមហ៊ុន រីនណៃ បាន លើកឡើង ថា « ពេល បាន មក ចាក់ វ៉ាក់សាំង រួចហើយ ដូច មាន អារម្មណ៍ ធូរ ចិត្ត លែង សូវ ភ័យ ព្រួយ អី ពេល ចាក់ វ៉ាក់សាំង ហើយ មិន មាន ធ្វើ ទុក អ្វី នោះ ទេ លោក សូម ថ្លែងអំណរគុណ ចំពោះ រាជ រដ្ឋាភិបាល ដែល បាន យក វ៉ាក់សាំង ចាក់ ជូន ប្រជាជន ដើម្បី ការពារ ជំងឺ កូវីដ១៩ » ។
លោកស្រី គុជ ហ៊ី ជា កម្មករ សំណង បម្រើការ នៅ ម្តុំ វិមាន ឈ្នះ ឈ្នះ បាន បង្ហាញ អារម្មណ៍ សប្បាយរីករាយ « នៅពេល ទទួលបាន ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ នា ពេលនេះ ។ ក្រោយ ចាក់ ហើយ គឺ មាន អារម្មណ៍ ធម្មតា មិន មាន អ្វី ប្រែប្រួល នោះ ទេ តែ ផ្ទុយទៅវិញ គឺ សប្បាយ ចិត្ត ឥត ឧបមាទៅ វិញ » ។
ដោយឡែក បើ គិត ត្រឹម យប់ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១. ៥៦៥. ២៩២ នាក់ ៕
សេចក្តីថ្លែងការណ៍ រួម ដោយ ក្រុម អង្គការ ក្រៅ រដ្ឋាភិបាល ទាំង ជាង ២០០ នៅ ទូទាំង ពិភពលោក ខាងលើ នេះ ក៏ បាន រំលឹក ផងដែរ អំពី លទ្ធផល ក្រោយ ការធ្វើ បាតុកម្ម ប្រឆាំង រដ្ឋាភិបាល និង ការបង្ក្រាប ដោយ ហិង្សា ពីសំណាក់ កងកម្លាំង សន្តិសុខ នៅ មីយ៉ាន់ម៉ា ដោយ គិត ចាប់តាំងពី ថ្ងៃទី ០១ ខែកុម្ភៈ រហូតដល់ ដើម ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន សម្លាប់ មនុស្ស យ៉ាងហោចណាស់ ៧៦៩ នាក់ ( ៥១ នាក់ ជា កុមារ ) និង មនុស្ស រាប់ ពាន់ នាក់ ទៀត បាន របួស ព្រមទាំង ត្រូវបាន ចាប់ ឃុំ ខ្លួន ។
ក្រុម អង្គការ ក្រៅ រដ្ឋាភិបាល ខាងលើ នេះ បាន គូសបញ្ជាក់ ទៀត ថា « មិន គួរ មាន រដ្ឋាភិបាល ប្រទេស ណាមួយ លក់ គ្រាប់ កាំភ្លើង សូម្បីតែ មួយ គ្រាប់ ទៅដល់ យោធា ( មីយ៉ាន់ម៉ា ) នៅក្នុង កាលៈទេសៈ បែប នេះ ឡើយ ។ ការហាមឃាត់ លក់ សព្វាវុធ ជា សកល មួយ ទៅដល់ ប្រទេស មីយ៉ាន់ម៉ា គឺជា ជំហាន ដ៏ ចាំបាច់ ដែល ក្រុមប្រឹក្សា សន្តិសុខ UN គួរតែ ធ្វើ ដើម្បី ឆ្លើយតប ទៅនឹង អំពើហិង្សា ដែល បាន និង កំពុង បង្កឡើង ដោយ យោធា ( មីយ៉ាន់ម៉ា )» ៕
បើ តាម ក្រុម អ្នកជំនាញ ការកើនឡើង នៃ ករណី ឆ្លង នៅ ជុំវិញ ពិភពលោក ជាពិសេស នៅ ឥណ្ឌា គឺ បណ្ដាល មកពី កត្តា គួបផ្សំ ដូចជា ការធ្វេសប្រហែស ក៏ ដូចជា ចំណាត់ការ ទន់ខ្សោយ របស់ រដ្ឋាភិបាល និង វីរុស បំប្លែង ខ្លួន ថ្មី តែម្ដង ដែល ត្រូវបាន គេ ជឿជាក់ ជា មូលហេតុ ចម្បង មួយ នៅ ពីក្រោយ ការកើនឡើង ករណី ឆ្លង និង ស្លាប់ រហូតដល់ បង្ក មាន ឱ្យ មាន ការចោទសួរ កាន់តែ ច្រើន ថា តើ វ៉ាក់សាំង COVID-19 អាច បង្ការ ឬ មាន ប្រសិទ្ធភាព ប្រឆាំង វីរុស បំប្លែង ខ្លួន ថ្មី ដែរ ឬ ទេ ?
* តើ វីរុស បំប្លែង ខ្លួន ថ្មី ណា ខ្លះ កំពុង បង្ក ការព្រួយបារម្ភ ?
វត្តមាន វីរុស បំប្លែង ខ្លួន ថ្មី បាន និង កំពុង បង្កឱ្យ មាន ការព្រួយបារម្ភ ខ្លាចក្រែង ថា វា អាច ប្រឆាំង ឬ កាត់បន្ថយ ប្រសិទ្ធភាព នៃ វ៉ាក់សាំង ហើយ អាចនឹង ចម្លង ជំងឺ សា ជា ថ្មី ដល់ អ្នក ដែល ធ្លាប់ ឆ្លង រួចហើយ ស្រប ពេល ក្រុមហ៊ុន ផលិត វ៉ាក់សាំង មួយចំនួន អះអាង ថា វ៉ាក់សាំង របស់ ពួកគេ មាន ប្រសិទ្ធភាព បង្ការ វីរុស បំប្លែង ខ្លួន ថ្មី ។
ថៃ បញ្ជាក់ ម្តង ទៀត ថា ជន បរទេស សរុប ៣លាន នាក់ ដែល រស់ នៅក្នុង ប្រទេស ខ្លួន នឹង អាច ទទួលបាន ការចាក់ វ៉ាក់សាំង បង្ការ កូវីដ - ១៩
កន្លងមក រដ្ឋាភិបាល ថៃ បាន ប្រកាស ជា ដដែល ៗ ថា ជន បរទេស នៅក្នុង ប្រទេស ថៃ នឹង ទទួលបាន ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ COVID-19 ។ តែ ទោះជា យ៉ាងណា ក្តី ព្រួយបារម្ភ នៅតែ កើតមាន ក្នុង ចំណោម ជន បរទេស ទាំងនោះ ជាពិសេស នៅ ប៉ុន្មាន សប្តាហ៍ ចុងក្រោយ នេះ ជុំវិញ បញ្ហា ដូចជា ខ្វះ ការផ្តល់ ព័ត៌មាន លម្អិត ការចុះឈ្មោះ និង ការភាន់ច្រឡំ ពាក់ព័ន្ធ ប្រភព នៃ ការផ្តល់ វ៉ាក់សាំង ជាដើម ។
គួរ បញ្ជាក់ ថា ថៃ មិន ទាន់ បាន ចាប់ផ្តើម យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ក្នុង ទ្រង់ទ្រាយ ធំ នៅឡើយ ទេ ដោយ ការចាក់ កន្លងមក ភាគ ច្រើន ធ្វើឡើង សម្រាប់ តែ បុគ្គលិក ផ្តល់ សេវា ជួរ មុខ ប៉ុណ្ណោះ ។ គិត ត្រឹម ថ្ងៃព្រហស្បតិ៍ នេះ ថៃ ចាក់ វ៉ាក់សាំង បាន ១.៦លាន ដូស ។ ដោយឡែក ស្ថានការណ៍ ឆ្លង រាលដាល នៃ ជំងឹ COVID-19 នៅក្នុង ប្រទេស ថៃ វិញ គឺ បន្ត រកឃើញ ខ្ទង់ ក្បែរ ៗ ២.០០០ នាក់ តាំងតែពី ពាក់កណ្តាល ខែមេសា មក ៕ ខ្យល់ កន្ត្រាក់ វាយ បំផ្លាញ ផ្ទះ ពលរដ្ឋ ១៧២ ខ្នង នៅ ស្រុក ព្រះនេត្រ ព្រះ និង ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ
( បន្ទាយមានជ័យ )៖ បាត់ ភូត ធម្មជាតិ ភ្លៀង លាយឡំ ជាមួយ ខ្យល់ កន្ត្រាក់ បាន បំផ្លាញ ផ្ទះ របស់ ប្រជាពលរដ្ឋ ចំនួន ១៧២ ខ្នង ឱ្យ រងគ្រោះ បែកបាក់ និង រលំ ស្ទើរ រាប ដល់ ដី នៅក្នុង ស្រុក ព្រះនេត្រ ព្រះ និង ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ នា ល្ងាច ថ្ងៃ៥ ខែឧសភា ឆ្នាំ ២០២១ ម្សិលមិញ ។
ចំណែក ស្រុក ព្រះនេត្រ ព្រះ មាន ផ្ទះ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ មាន ចំនួន ៩៨ ខ្នង ក្នុង ៥ភូមិ រួម មាន ភូមិ ត្របែក ៣០ ខ្នង រ បើក ស័ង្កសី ៤៧២ សន្លឹក . ភូមិ កណ្តាល អស់ ផ្ទះ ប្រជាពលរដ្ឋ ២០ ខ្នង រ បើក ស័ង្កសី អស់ ២២៩ សន្លឹក . ភូមិ គោក ធំ អស់ ផ្ទះ ប្រជាពលរដ្ឋ ៣៥ ខ្នង រ បើក ស័ង្កសី ៥៦៥ សន្លឹក . ភូមិ សូត្រ មន្ត អស់ ផ្ទះ ប្រជាពលរដ្ឋ រ បើក ស័ង្កសី ១៦ សន្លឹក និង ភូមិ បុស្បូវ ផ្ទះ ប្រជាពលរដ្ឋ ៧ខ្នង រ បើក ស័ង្កសី ២១១ សន្លឹក នា ល្ងាច ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២១ ។
មន្ត្រី មូលដ្ឋាន និង នគរបាល បាន ស្រុក ព្រះនេត្រ ព្រះ បាន បន្ត ថា ក្រោយពី កើត ហេតុ ហើយ លោក ឃូពៅ អភិបាល ស្រុក ព្រះនេត្រ ព្រះ និង លោក គាត ហ៊ុល អភិបាល ក្រុង ប៉ោយប៉ែត និង ក្រុមការងារ បាន ចុះ ទៅដល់ ផ្ទះ ប្រជាពក រដ្ឋ ដែល រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ ពិនិត្យ និង រៀបចំ សារ ឡើងវិញ ដើម្បី សម្រួល ឱ្យ ជា ពលរដ្ឋ រស់ នៅ បណ្តោះអាសន្ន សិន ត្រៀម ជួសជុល ឱ្យ នៅពេល ខាងមុខ នេះ ផងដែរ ៕
បាតុភូត ធម្មជាតិ ! ភ្លៀង ផ្គរ រន្ទះ លាយឡំ ខ្យល់ កន្ត្រាក់ បំផ្លាញ ផ្ទះ ពលរដ្ឋ ជាង ២០០ ខ្នង នៅ ស្រុក ស្នួល ខេត្ត ក្រចេះ
( ក្រចេះ ) ៖ យ៉ាងហោចណាស់ មាន ផ្ទះ ប្រជាពលរដ្ឋ ជាង ២០០ ខ្នង នៅ ឃុំ ក្រញូង សែន ជ័យ នៅ ស្រុក ស្នួល ខេត្ត ក្រចេះ បាន រង ការខូចខាត យ៉ាង ធ្ងន់ធ្ងរ ដោយសារ ខ្យល់ កន្រាក់ កាល យប់ ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២១ ។
លោក សាម ណាល់ អភិបាល ស្រុក ស្នួល បាន ឱ្យដឹង ថា « នៅក្នុង ឧប្បត្តិហេតុ ភ្លៀង ផ្គរ រន្ទះ ខ្យល់ កន្ត្រាក់ ខាងលើ នេះ បាន បំផ្លាញ ផ្ទះសម្បែង របស់ បងប្អូន ប្រជាពលរដ្ឋ ជាង ២០០ ខ្នង តែ ពុំ មាន ប្រជាពលរដ្ឋ ណា ម្នាក់ រងគ្រោះថ្នាក់ ដល់ អាយុជីវិត ឡើយ » ។
លោក អភិបាល ស្រុក ស្នួល បាន បញ្ជាក់ ថា តួរ លេខ នៃ ការខូចខាត ខ្នង ផ្ទះ ដោយសារ ខ្យល់ កន្ត្រាក់ នៅ ភូមិ ឃុំ ក្រញូង សែន ជ័យ កាលពី យប់ មិញ នេះ មាន ជាង ២០០ ខ្នង ផ្ទះ ក្នុង នោះ មាន ការរង ការខូចខាត ទាំងស្រុង និង របើក ដំបូល ខ្នង ផ្ទះ ។
លោក បាន បញ្ជាក់ បន្ថែម ថា នៅក្នុង បាតុភូត គ្រោះ ធម្មជាតិ នោះ ដែរ នៅក្នុង ឃុំ ២ ធ្នូ ក៏ មាន ករណី រន្ទះ បាញ់ ស្ត្រី ម្នាក់ ផងដែរ ប៉ុន្តែ មិន ប៉ះពាល់ ដល់ អាយុជីវិត ឡើយ ដោយ ត្រូវបាន ជួយសង្គ្រោះ យកមក សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក ស្នួល ទាន់ ពេល វេលា ។
អាជ្ញាធរ ស្រុក និង ស្ថាបន ពាក់ព័ន្ធ កំពុង ចុះ ដល់ មូលដ្ឋាន ដើម្បី សិក្សា វាយតម្លៃ អំពី ផល ប៉ះពាល់ នៃ ចំនួន ខ្នង ផ្ទះ របស់ បងប្អូន ដោយ ផ្ទាល់ តែ ម្តង ដើម្បី រាយការណ៍ ជួន ថ្នាក់ដឹកនាំ ខេត្ត ។
លោក អភិបាល ស្រុក បាន បន្ថែម ទៀត ថា នៅ ព្រឹក ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ លោក គង់ គឹម នី អភិបាល រង ខេត្ត ក៏ បាន ចុះ ទៅ ឃុំ ក្រញូង សែន ជ័យ ដើម្បី សួរសុខទុក ដល់ ប្រជាពលរដ្ឋ នៅ ទីនោះ ផ្ទាល់ និង ចុះ ពិនិត្យ ជាក់ស្ដែង នូវ ស្ថានភាព គ្រោះ ធម្មជាតិ នេះ ផងដែរ ។
ក្រសួង ធនធាន ទឹក និង ឧតុម និយម នៅ ព្រឹក ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២១ បាន ចេញ សេចក្តីជូនដំណឹង ពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា ចាប់ពី ថ្ងៃទី ០៥ ដល់ ១១ ខែឧសភា ឆ្នាំ ២០២១ ។ ក្រសួង បាន បញ្ជាក់ ថា ក្នុង រយៈពេល នេះ នៅ កម្ពុជា អាចនឹង មាន ភ្លៀង ធ្លាក់ រាយប៉ាយ ក្នុង កម្រិត ពី តិច ទៅ ច្រើន ទៅ តាម តំបន់ ។
ជាមួយគ្នា នេះ ក្រសួង ធនធាន ទឹក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម បន្ត ប្រុងប្រយ័ត្ន ចំពោះ បាតុភូត ផ្គរ ន្ទះ និង ខ្យល់ កន្ត្រាក់ ដែល អាច កើតមាន ជាពិសេស បណ្តា ខេត្ត តំបន់ វាល ទំនាប កណ្តាល ៕
អ្នកនាំពាក្យ ក្រសួង សេដ្ឋកិច្ច៖ រាជ រដ្ឋាភិបាល សន្សំ សំចៃ ថវិកា បាន ជាង ៩០ លាន ដុល្លារ ពី ការកែសម្រួល ចំណាយ ថ្នាក់ ជាតិ ឆ្នាំ ២០២១ សម្រាប់ ដោះស្រាយ បញ្ហា វិបត្តិ កូវីដ
( ភ្នំពេញ ) ៖ លោក មាស សុខ សេន សាន អ្នកនាំពាក្យ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន គូសបញ្ជាក់ ឲ្យដឹង ថា រាជ រដ្ឋាភិបាល កម្ពុជា អាច សន្សំ សំចៃ ថវិកា បាន ជាង ៩០ លាន ដុល្លារ ពី ការកែសម្រួល ចំណាយ ថវិកា ថ្នាក់ ជាតិ ឆ្នាំ ២០២១ ដើម្បី ទុក ដោះស្រាយ បញ្ហា វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ ។
លោក បាន អះអាង ថា ការធ្វើ វិចារណកម្ម និង ការពង្រឹង ប្រសិទ្ធភាព ចំណាយ ថវិកា ថ្នាក់ ជាតិ ឆ្នាំ ២០២១ នេះ មិន ប៉ះពាល់ ដល់ ថវិកា ថ្នាក់ ក្រោម ជាតិ នោះ ឡើយ ។
បន្ថែម ពី នោះ ទៀត លោក ក៏ បាន ឲ្យដឹង ដែរ ថា ចំពោះ កញ្ចប់ ថវិកា ជាង ៨០០ លាន ដុល្លារ ដែល រាជ រដ្ឋាភិបាល ផ្ដល់ សម្រាប់ ជួយ ដោះស្រាយ បញ្ហា វិបត្តិ ជំងឺ កូវីដ១៩ គឺ នៅតែ បន្ដ បែងចែក ថវិកា ជូន ទៅ គណៈកម្មាធិការ តាម ក្រសួង ស្ថាប័ន រៀង ៗ ខ្លួន ដដែល ។
អ្នកនាំពាក្យ ក្រសួង សេដ្ឋកិច្ច បាន គូសបញ្ជាក់ ទៀត ថា បើសិនជា ទឹកប្រាក់ ៨០០ លាន ដុល្លារ ដែល សម្រាប់ ជួយ ដោះស្រាយ បញ្ហា វិបត្តិ ជំងឺ កូវីដ១៩ មិន គ្រប់គ្រាន់ ទេ នោះ រាជ រដ្ឋាភិបាល នឹង បន្ដ ត្រៀម បម្រុង ថវិកា បន្ថែម ទៀត ។
គូសបញ្ជាក់ ថា នៅ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចេញ សារាចរ ណែនាំ ស្ដីពី ការការធ្វើ វិចារណកម្ម ( ចំណាយ ឲ្យ សមហេតុសមផល ) និង ការពង្រឹង ប្រសិទ្ធភាព ចំណាយ ថវិកា ថ្នាក់ ជាតិ ឆ្នាំ ២០២១ ។
អភិបាល ខេត្ត កណ្ដាល បញ្ជា ឲ្យ បន្ត បិទ ខ្ទប់ តំបន់ អគារ វប្បធម៌ រយ: ពេល ៧ ថ្ងៃ ទៀត ក្រោយ មាន អ្នក ឆ្លង កូវីដ ជា បន្តបន្ទាប់
គួរ រម្លឹក ផងដែរ ថា អភិបាល ខេត្ត កណ្ដាល កាលពី ថ្ងៃទី ២ ខែឧសភា កន្លងទៅ បាន នាំយក អំណោយ មក ចែកជូន ពលរដ្ឋ ១៧២ គ្រួសារ ក្នុង តំបន់ បិទ ខ្ទប់ នេះ ព្រមទាំង ណែនាំឲ្យ មាន ការអត់ធ្មត់ និង ចូលរួម ធ្វើចត្តាឡី ស័ក ឱ្យ បាន ត្រឹមត្រូវ ដើម្បី កាត់ផ្ដាច់ នូវ ខ្សែ ចម្លង មេរោគ កូវីដ១៩ ក្នុង តំបន់ អគារ វប្បធម៌ នេះ ក្នុង គោលបំណង ឱ្យ តំបន់ នេះ វិល ទៅរក ភាព ប្រក្រតី ធម្មតា ឡើងវិញ ។
យោង តាម របាយការណ៍ អ្នក ដែល ជាប់ពាក់ព័ន្ធ នឹង ព្រឹត្តិការណ៍ « សហគមន៍ ២០កុម្ភៈ » ទូទាំង ខេត្ត កណ្ដាល គិត ត្រឹម ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២១ មាន អ្នក ជាប់ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ប្រយោល ចំនួន ៣៧.១៦៦ នាក់ រួម មាន៖
រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ បន្ដ ផ្អាក អាជីវកម្ម ទីតាំង ៣ បន្ថែម ទៀត នៅ ស្រុក ឧដុង្គ និង ក្រុង ច្បារមន ក្រោយ ពាក់ព័ន្ធ អ្នក កើត ជំងឺ កូវីដ
( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន សម្រេច ផ្អាក បណ្ដោះអាសន្ន ទីតាំង ចំនួន ៣កន្លែង បន្ថែម ទៀត នៅ ស្រុក ឧដុង្គ និង ក្រុង ច្បារមន ក្រោយ រកឃើញ ពាក់ព័ន្ធ ជាមួយ អ្នក កើត ជំងឺ កូវីដ១៩ ។
ទីតាំង ទាំង ៣កន្លែង ដែល ត្រូវ ផ្អាក បណ្ដោះអាសន្ន នេះ រួម មាន៖
ពលរដ្ឋ និង និសិ្សត នៅ តាម បន្ទប់ ជួល ក្នុង សង្កាត់ ផ្សារ ដើម ថ្កូវ ១៥២ គ្រួសារ ទទួល ស្បៀង អំណោយ សម្តេច តេជោ ដែល ការផ្តល់ ជូន នេះ ធ្វើឡើង សម្រាប់ ពលរដ្ឋ គ្រប់ រូប ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ ឡើយ
ក្នុង ឱកាស នេះ លោក ថេង សុថុល បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ នូវ ការចូលរួម សហការ ជាមួយ អាជ្ញាធរ ក្នុង គ្រា លំបាក នេះ ដើម្បី ធ្វើ យ៉ាងណា រួមគ្នា កាត់ផ្តាច់ ជំងឺ កូវីដ១៩ ឲ្យបាន លឿន ដោយ គោរព នូវ វិធានការ ៣កុំ និង ៣កាពារ រក្សា អនាម័យ លាង ដៃ ឲ្យ ញឹកញាប់ រក្សា គម្លាត ចៀសវាង ការប្រមូលផ្តុំ នានា ។ លោក ថេង សុថុល ក៏ បាន ស្នើ ដល់ ប្រជាពលរដ្ឋ រក្សា ការអត់ធ្មត់ និង មេត្តា យោគយល់ ចំពោះ វិធានការ បង្ការ ទប់ស្កាត់ ការឆ្លង រាលដាល ជម្ងឺ កូវិដ១៩ នេះ ។
លោក ថេង សុថុល បាន លើកឡើង ទៀត ថា ទោះបីជា ការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ត្រូវបាន បិទ បញ្ចប់ ក៏ ពិត មែន ប៉ុន្តែ សម្រាប់ តំបន់ ដែល ប្រឈម ខ្លាំង និង តំបន់ ក្រហម អាជ្ញាធរ នៅតែ បន្ត បិទ ខ្ទប់ ដដែល ហើយ ការសម្រេច បញ្ចប់ ការបិទ ខ្ទប់ នេះ មិន មែន មាន ន័យ ថា ជំងឺ កូវ វីដ - ១៩ លែង មាន ហើយ បងប្អូន ភ្លេច ខ្លួន មិន គិត ពី ការឆ្លង ជំងឺ កូវីដ១៩ នោះ ឡើយ ។
ទន្ទឹម នេះ លោក ថេង សុថុល បាន សង្កត់ធ្ងន់ ថា សូម កុំ បំពាន កុំ ប្រមាថ និង កុំ ធ្វេសប្រហែស សូម្បីតែ ១វិនាទី ណា ឲ្យ សោះ ព្រោះ បច្ចុប្បន្ន នេះ វីរ៉ីស កូវីដ - ១៩ បាន និង កំពុង ចរាចរណ៍ ស្ទើរ គ្រប់ ទីកន្លែង ។ ដូច្នេះ ការប្រកាន់ខ្ជាប់ នូវ វិធានការ សុខាភិបាល និង គោរព វិធានការ រដ្ឋបាល តាម ការដាក់ចុះ របស់ អាជ្ញាធរ មាន សមត្ថកិច្ច គឺជា ការចាំបាច់ បំផុត ដើម្បី ប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការឆ្លង ជំងឺ កូវីដ - ១៩ ដែល គោលដៅ ចម្បង គឺ ការពារ អាយុជីវិត ប្រជាពលរដ្ឋ ។
ដោយ មើលឃើញ តំបន់ នេះ មាន ផ្ទះ ច្រើន ជាប់ ៗ គ្នា ហើយ ផ្លូវ មាន លក្ខណៈ តូច ចង្អៀត ហើយ ក្នុង ពេលនេះ ជា រដូវ ក្ដៅ ផង នោះ លោក ថេង សុថុល ក៏ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ មេត្តា ប្រុងប្រយ័ត្ន ចំពោះ គ្រោះ អគ្គិភ័យ ដែល អាច កើតឡើង បណ្ដាល មកពី ភ្លើង ចង្ក្រាន ធូប ទៀន ជាពិសេស បញ្ហា អគ្គីសនី ដោយ ធ្វើ យ៉ាងណា ពិនិត្យ ឲ្យបាន ម៉ត់ចត់ កុំ មាន ការធ្វែស ប្រហេស ឲ្យ សោះ ។
រាជ រដ្ឋាភិបាល សម្រេច ដាក់ ឱ្យ ប្រើប្រាស់ « ផែនការ យុទ្ធសាស្រ្ត យុទ្ធនាការ ជាតិ ចាក់ វ៉ាក់សាំង បង្ការ កូវី ដ១៩ សំដៅ បង្កើត ឱ្យ បាន ភាពស៊ាំ សង្គម - សេដ្ឋកិច្ច នៅ កម្ពុជា ក្នុង ឆ្នាំ ២០២១ » ( មាន ចំនួន ២២ ទំព័រ ) ( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល បាន សម្រេច ដាក់ ឱ្យ ប្រើប្រាស់ នូវ « ផែនការ យុទ្ធសាស្រ្ត យុទ្ធនាការ ជាតិ ចាក់ វ៉ាក់សាំង បង្ការ កូវីដ - ១៩ សំដៅ បង្កើត ឱ្យ បាន ភាពស៊ាំ សង្គម - សេដ្ឋកិច្ច នៅ កម្ពុជា ក្នុង ឆ្នាំ ២០២១ » ។
អគ្គ លេខាធិការ UN ប្រកាស គាំទ្រ ការចែករំលែក បច្ចេកវិទ្យា វិធីសាស្រ្ត និង អាជ្ញាប័ណ្ណ ផលិត វ៉ាក់សាំង កូវីដ - ១៩ ដើម្បី បង្កើន ការផ្គត់ផ្គង់ នៅ ទូទាំង ពិភពលោក
ទន្ទឹម គ្នា នេះ ដែរ អង្គការ ពាណិជ្ជកម្ម ពិភពលោក (WTO) កំពុង បន្ត ការពិភាក្សា អំពី សំណើ ស្តីពី ការលើកលែង សិទ្ធិ ប៉ាតង់ ចំពោះ វ៉ាក់សាំង ដែល ផ្តើម ស្នើ ឡើង ដោយ ប្រទេស អាហ្រ្វិក ខាងត្បូង និង ឥណ្ឌា ។ ការសម្រេចចិត្ត នីមួយ ៗ របស់ WTO គឺ អាស្រ័យ ទៅ លើ ភាពជា ឯកច្ឆន្ទ ហេតុ ដូច្នេះហើយ គ្រប់ សមាជិក ទាំង ១៦៤ ត្រូវតែ ព្រមព្រៀង គ្នា ដោយ មិន អាច មាន សំឡេង ជំទាស់ ឡើយ សូម្បីតែ មួយ ។
មេបញ្ជាការ កងពល តូច ថ្មើរជើង លេខ ៥១ នាំយក អំណោយ ស័ង្កសី របស់ លោក ហ៊ុន ម៉ាណែត ជួយ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់
( បន្តាយ មានជ័យ )៖ លោក ឧត្តមសេនីយ៍ ត្រី សឹង្ហ ទុំ មេបញ្ជាការ កងពល តូច ថ្មើរជើង លេខ ៥១ បាន ចាត់ កម្លាំង ជិត ២០០ នាក់ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ជំុ សេដ្ឋា មេបញ្ជាការ រង នាយ សេនាធិការ ចុះ ជួយ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ ក្នុង ខេត្ត បន្ទាយមានជ័យ ដោយ សហការ ជាមួយ កម្លាំង កងរាជអាវុធហត្ថ ស្នងការ នគរបាល អាជ្ញាធរ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ ផងដែរ ។
កាលពី យប់ ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២១ មាន ភ្លៀង លាយឡំ ខ្យល់ កន្ត្រាក់ បណ្តាលឱ្យ ខូចខាត ផ្ទះ ប្រជាពលរដ្ឋ ក្នុង ក្រុង ប៉ោយប៉ែត ស្រុក អូរ ជ្រៅ និង ស្រុក ព្រះនេត្រ ព្រះអស់ មួយចំនួន ។ យោង តាម ព័ត៌មាន បឋម គ្រោះ ខ្យល់ កន្ត្រាក់ នេះ បណ្តាលឱ្យ ខូចខាត ប្រមាណ ចំនួន ២១៦ ខ្នង និង សម្ភារ មួយចំនួន មិន បណ្តាលឲ្យ ប្រជាពលរដ្ឋ រងរបួស ឬ ស្លាប់ នោះ ទេ ក្រៅពី ផ្ទះ ប្រជាពលរដ្ឋ ក៏ បណ្តាលឱ្យ ខូចខាត ជម្រក ស្នាក់ នៅ បណ្តោះអាសន្ន កងកម្លាំង ចម្រុះ កំពុង ឈរជើង បិទ ខ្ទប់ ក្រុង ប៉ោយប៉ែត ជាច្រើន កន្លែង ផងដែរ ។
ដោយ មាន ការយកចិត្តទុកដាក់ ពីសំណាក់ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក បាន ផ្តល់ អំណោយ ស័ង្កសី ចំនួន ១.០០០ សន្លឹក សម្រាប់ កងកម្លាំង កងពល តូច ថ្មើរជើង លេខ ៥១ ចុះ ជួយ ជួសជុល ផ្ទះ ជូន ប្រជាពលរដ្ឋ ឡើងវិញ ភ្លាម ៗ រួម ជាមួយ អំណោយ របស់ លោក អ៊ុ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ ស័ង្កសី និង ថវិកា មួយ ចំនួន ផងដែរ ។
ស្ថិត ក្នុង ស្ថានភាព ដ៏ លំបាក កំពុង ប្រឈម នឹង ជំងឺ ឆ្លង កូវីដ១៩ ក្នុង ក្រុង ប៉ោយប៉ែត និង តាម បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ ទាំង ប្រជាពលរដ្ឋ កងកម្លាំង និង អាជ្ញាធរ មូលដ្ឋាន បាន ខិតខំ ទប់ស្កាត់ ការឆ្លង រីករាលដាល នេះ លោក មេបញ្ជាការ កងពល បាន គូសបញ្ជាក់ ថា អនុវត្តន៍ តាម បទបញ្ជា ថ្នាក់ដឹកនាំ តាម ឋានានុក្រម កងកម្លាំង បាន ចេញ ប្រតិបត្តិការ ទប់ស្កាត់ ជំងឺ ឆ្លង កូវីដ១៩ និង កម្លាំង មួយចំនួន បាន ត្រៀម ខ្លួន ជាស្រេច ជួយ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ មហន្តរាយ ធម្មជាតិ ផ្សេង ៗ តាម សំណូមពរ គណៈ បញ្ជាការ ឯកភាព ខេត្ត ។
សូម បញ្ជាក់ ថា ខេត្ត បន្ទាយមានជ័យ គឺជា ខេត្ត មួយ ដែល តែងតែ រងគ្រោះ ដោយ ខ្យល់ កន្រ្តាក់ បណ្តាលឲ្យ ខូចខាត ផ្ទះ ប្រជាពលរដ្ឋ សម្ភារ រងរបួស និង ស្លាប់ ជារៀងរាល់ ឆ្នាំ ។
ក្នុង ឱកាស នោះ ដែរ អាជ្ញាធរ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ បាន គោរព ថ្លែងអំណរគុណ ជូន ចំពោះ លោក ហ៊ុន ម៉ាណែត និង ភរិយា ដែល តែងតែ យកចិត្តទុកដាក់ ចំពោះ ប្រជាពលរដ្ឋ ជួប ការលំបាក គ្រប់ ទីកន្លែង ៕
( ភ្នំពេញ ) ៖ ឯកឧត្តម ជុំ ប៊ុន រ៉ុង ទីប្រឹក្សា រាជ រដ្ឋាភិបាល និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
ឯកឧត្តម ជុំ ប៊ុន រ៉ុង កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក ឯកឧត្តម ជុំ ប៊ុន រ៉ុង ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ អំឡុង ពេល ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ នេះ ការទិញ ទំនិញ អនឡាញ និង ការទូទាត់ តាមរយៈ ប្រព័ន្ធ ឌីជីថល គឺជា មធ្យោបាយ ពេញនិយម និង មាន សុវត្ថិភាព បំផុត ។
អភិបាល ខេត្ត ព្រៃវែង បាន បន្ថែម ទៀត ថា សម្រាប់ អ្នក ដែល គ្រាន់តែ ធ្វើដំណើរ ឆ្លងកាត់ ខេត្ត ព្រៃវែង មិន តម្រូវឲ្យ បំពេញ លក្ខខណ្ឌ នេះ ឡើយ ពោល អាច ធ្វើដំណើរ ឆ្លងកាត់ ដូច ធម្មតា ។
ការដាក់ចេញ នូវ វិធានការ បែប នេះ របស់ លោក ជា សុមេធី អភិបាល ខេត្ត ព្រៃវែង ធ្វើឡើង ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ពិសេស តាមរយៈ អ្នក ដែល ធ្វើដំណើរ មកពី បណ្ដា រាជធានី - ខេត្ត ផ្សេង ៗ គ្រា ដែល កម្ពុជា កំពុង ប្រឈម ជាមួយនឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា ក្រោយពី បើក ចរាចរណ៍ ឡើងវិញ នៅ រាជធានី ភ្នំពេញ និង នៅ តាម បណ្ដា ខេត្ត នេះ មាន សេចក្ដីរាយការណ៍ ជាច្រើន បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ជាច្រើន នាក់ បាន នាំគ្នា សម្រុក ចាកចេញ ពី រាជធានី ភ្នំពេញ ដូច្នេះ បើ តាម បណ្ដា ខេត្ត នីមួយ ៗ ត្រូវតែ មាន ទំនួល ខុសត្រូវ ខ្ពស់ លើ ការងារ គ្រប់គ្រង អ្នក ចេញ ចូល ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ៕ ឯកឧត្តម ឃួង ស្រេង ថ្លែងអំណរគុណ ឯកឧត្តម សារិន វណ្ណា និង លោកជំទាវ ដែល បាន ឧបត្ថម្ភ ថវិកា ២៩២. ៥៦៤.០០០ រៀល ដល់ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ ឯកឧត្តម សារិន វណ្ណ ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សូរិយោដី រាជធានី ភ្នំពេញ និង ថ្នាក់ដឹកនាំ ព្រមទាំង មន្ត្រីរាជការ ក្រោម ឱវាទ មន្ទីរ បាន ជួយ ឧបត្ថម្ភ ថវិកា ចំនួន ២៩២.៥៦៤.០០០ រៀល ។
( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការសម្រេច ការផ្អាក អាជីវកម្ម ៣ទីតាំង ដែល ពាក់ព័ន្ធ អ្នកវិជ្ជមាន កូវីដ១៩ កាលពី ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ កន្លងទៅ ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ ។
ទីតាំង ទាំង ៣កន្លែង ដែល រដ្ឋបាល ខេត្ត ព្រះវិហារ ចេញ សេចក្តីសម្រេច ផ្អាក ធ្វើ អាជីវកម្ម រួម មាន៖
* បន្ទប់ ពិគ្រោះ និង ព្យាបាល ជំងឺ ហែម ភិរឹទ្ធ ស្ថិត នៅ ភូមិ រវៀង ត្បូង ឃុំ រុងរឿង ស្រុក រវៀង * បន្ទប់ ពិគ្រោះ និង ព្យាបាល ជំងឺ មុំ រឹទ្ធី ស្ថិត ក្នុង ភូមិឡ អិដ្ឋ សង្កាត់ កំពង់ប្រណាក ក្រុង ព្រះវិហារ * ផ្ទះសំណាក់ គីម សិរី ភា ស្ថិត ក្នុង ភូមិង ណ្តូង ពោធិ សង្កាត់ កំពង់ប្រណាក ក្រុង ព្រះវិហារ ។
វិធានការ របស់ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ធ្វើឡើង ដោយ យោង សេចក្តីណែនាំ ចុះ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២១ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ស្តីពី ការពង្រឹង ការអនុវត្ត វិធានការ ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង ការពង្រឹង ការអនុវត្ត វិធានការ នៅក្នុង ភូមិសាស្ត្រ ដែល ត្រូវបាន បិទ ខ្ទប់ នៅ តាម បណ្តា រាជធានី ខេត្ត ។
ក្នុង គោលបំណង ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ បន្ថែម ទៀត រដ្ឋបាល ខេត្ត សូម ធ្វើ ការណែនាំ ដល់ អ្នកដំណើរ ទាំងអស់ ដែល ចូលមក ក្នុង ភូមិសាស្ត្រ ខេត្ត ព្រះសីហនុ តាម គ្រប់ មធ្យោបាយ ( តាម ផ្លូវគោក ផ្លូវ ទឹក ផ្លូវ ដែក និង ផ្លូវ អាកាស ) ត្រូវ អនុវត្ត តាម លក្ខខណ្ឌ ណា មួយ ដែល បាន កំណត់ ដូច ខាងក្រោម៖
១៖ ត្រូវ មាន លិខិត បញ្ជាក់ សុខភាព ក្នុង ថ្ងៃ តែ មួយ ពី មន្ទីរពេទ្យ រដ្ឋ ឬ មន្ទីរពេទ្យ ឯកជន ដែល បាន ទទួល សិទ្ធិ ពិនិត្យ ថែទាំ និង ព្យាបាល អ្នកជំងឺ កូវីដ - ១៩ ឬ
២៖ ត្រូវ មាន ប័ណ្ណ ឬ លិខិត បញ្ជាក់ ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ចំនួន ២លើ ក ចប់ រួចរាល់ ឬ
៣៖ ត្រូវ មាន លិខិត អនុញ្ញាត ពី អាជ្ញាធរ មូលដ្ឋាន ដែល សាមីខ្លួន ត្រូវ ទៅ ស្នាក់ នៅ ( សម្រាប់ ពលរដ្ឋ ខ្មែរ ) ដើម្បី ងាយស្រួល ត្រួតពិនិត្យ អំពី ការដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ
៤៖ ចំពោះ ការធ្វើដំណើរ ដោយ មូលហេតុ ចាំបាច់ និង បន្ទាន់ ផ្សេង ទៀត ត្រូវ មាន ការអនុញ្ញាត ជា មុន ពី អាជ្ញាធរ មាន សមត្ថកិច្ច ៕ អភិបាល ខេត្ត កំពង់ធំ បិទ ការចេញ - ចូល ឃុំ ចំនួន ៤ នៅ ស្រុក ស្ទោង ក្រោយ ផ្ទុះ ជំងឺ កូវីដ១៩
រដ្ឋបាល ខេត្ត កំពង់ធំ បាន បញ្ជាក់ ថា ការផ្អាក ជា បណ្ដោះអាសន្ន នូវ ការធ្វើចរាចរណ៍ នេះ នៅ ចន្លោះ ម៉ោង ៨យប់ ដល់ ម៉ោង ៣ភ្លឺ ចាប់ពី ថ្ងៃទី ០៦ ខែឧសភា ដល់ ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០២១ ប៉ុន្ដែ លើកលែង ករណី មួយចំនួន ប៉ុណ្ណោះ ។
« សម្រាប់ ការចាក់ វ៉ាក់សាំង នៅក្នុង យុទ្ធនាការ នៅ តំបន់ គឺ ដំណើរការបាន ល្អ ណាស់ សូម កោតសរសើរ ជា ទីបំផុត ចំពោះ មន្ត្រីរាជការ គ្រប់ ទីកន្លែង ទាំងអស់ ដែល បាន សហការ បាន យ៉ាង ល្អ ប្រសើរ ដំណើរការចាក់ វ៉ាក់សាំង បាន ដោយ រលូន មកដល់ ពេលនេះ នោះ គឺជា សេចក្តីសង្ឃឹម ដែល យើង ចាក់ ជា បន្តបន្ទាប់ តាម អនុសាសន៍ ណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា គឺ យើង ត្រូវតែ បំពេញ ឱ្យ ពេញលេញ ឱ្យ បាន នៅ ថ្ងៃ ខាងមុខ នេះ » ។ នេះ បើ តាម ការបញ្ជាក់ បន្ថេម របស់ សម្តេច ពិជ័យ សេនា ។
ជាមួយគ្នា នេះ ដែរ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន បន្ត ថា នៅ ថ្ងៃទី ០៧ ខែឧសភា ឆ្នាំ ២០២១ ស្អែក នេះ ក្រុមការងារ ចាក់ វ៉ាក សាំង ការពារ ជំងឺ កូវីដ១៩ ក្រុម គ្រូពេទ្យ របស់ កងពល តូច អន្តរាគមន៍ លេខ ១ នឹង រៀបចំ ទីតាំង សម្រាប់ ត្រៀម ការចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ នៅ តំបន់ ក្រហម ក្នុង សង្កាត់ ទួល សង្កែទី១ ខណ្ឌ ឫស្សីកែវ តាម អនុសាសន៍ ណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន គូសបញ្ជាក់ ថា ក្រុមការងារ ទទួលបន្ទុក ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ រស់ នៅក្នុង តំបន់ ក្រហម ក្រសួង ការពារ ជាតិ បាន រៀបចំ ទម្រង់បែបបទ បញ្ជូន ឱ្យ អាជ្ញាធរ មូលដ្ឋាន ខណ្ឌ ឫស្សីកែវ ដើម្បីឱ្យ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន បំពេញ ជាដើម ។ ដោយឡែក សម្រាប់ ប្រជាពលរដ្ឋ ណា ដែល មិន អាច បំពេញ បែបបទ សុំ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ដោយ ខ្លួន ឯង មិន បាន ( មិន ចេះ អក្សរ ) គឺ មាន មន្ត្រី រង់ចាំ ជួយ បំពេញ ឱ្យ ផងដែរ ។
រដ្ឋមន្ត្រី ការពារ ជាតិ ក៏ បាន កត់សម្គាល់ ឃើញ ពី ការប្រឹងប្រែង របស់ ក្រុមការងារ ចាក់ វ៉ាក់សាំង ទាំងអស់ ដែល បាន យកចិត្តទុកដាក់ និង បំពេញ ការងារ យ៉ាង សស្រាក់សស្រាំ ដើម្បី ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន តាម ផែនការ ទោះបីជា តំបន់ ចាក់ វ៉ាក់សាំង នេះ ជា តំបន់ រីករាលដាល ជំងឺ កូវីដ១៩ក្តី ។
ជាមួយនឹង ការមក ទទួល វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បន្ត អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម បន្ត រក្សា គម្លាត សុវត្ថិភាព សង្គម អនាម័យ ត្រូវ អនុវត្ត តាម វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល និង អនុវត្ត តាម វិធានការ ៣ការពារ និង ៣កុំ ឱ្យ បាន ខ្ជាប់ខ្ជួន ជាដើម ។
ការណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង បន្ទាប់ពី អភិបាល ខេត្ត មួយចំនួន បាន សម្រេច អនុវត្តន៍ វិធានការតម្រូវ ឱ្យ ប្រជាពលរដ្ឋ ធ្វើចត្តាឡី ស័ក នៅពេល ចូល ទៅកាន់ ខេត្ត របស់ ខ្លួន ។
ក្នុង សារ សំឡេង ពិសេស និង បន្ទាន់ មួយ នៅ រសៀល ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការសម្រេច អនុវត្ត វិធានការ បែប នេះ មិន ខុសពី ការបិទ ប្រទេស នោះ ទេ ។
សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ដូច្នេះ « យើង ត្រូវ បន្ត គ្រប់គ្រង និង ធ្វើចត្តាឡី ស័ក ចំពោះ តែ អ្នក ដែល សង្ស័យ មាន ហានិភ័យ អាច មាន ជំងឺ កូវីដ១៩ ទៅ យក សំណាក ហើយ ឱ្យ ធ្វើចត្តាឡី ស័ក ប៉ុន្តែ មិន មែន ធ្វើ គ្រប់ មនុស្ស ដែល ឆ្លង ខេត្ត នោះ ទេ ។ បើ ធ្វើ ដូច្នេះ ប្រជាពលរដ្ឋ ហាក់ដូចជា នៅក្នុង ទ្រុង ដដែល ។ អ៊ីចឹង សូម ឱ្យ ឯកឧត្តម លោកជំទាវ អភិបាល ខេត្ត ណា ដែល បាន ចេញ សេចក្តីសម្រេច ហួស ទៅ ហើយ ត្រូវ កែប្រែ នូវ សេចក្តីសម្រេច នោះ វិញ ជាបន្ទាន់ ដើម្បី សម្រួល ឱ្យ មាន ការចរាចរណ៍ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន ណែនាំ ឱ្យ អភិបាល ខេត្ត ដែល បាន ដាក់ចេញ សេចក្តីសម្រេច បែប នេះ ត្រូវ ប្រញាប់ កែសម្រួល ឡើងវិញ ដើម្បី កុំ ឱ្យ ប៉ះពាល់ ដល់ ការធ្វើចរាចរណ៍ និង ការធ្វើ អាជីវកម្ម របស់ ប្រជាពលរដ្ឋ ។
សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល បាន គូសបញ្ជាក់ ថា សម្តេច មិន បាន ឱ្យ ទម្លាក់ ចោល វិធានការ ប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល ជំងឺ កូវីដ១៩ នោះ ទេ គ្រាន់តែ ត្រូវ អនុវត្ត វិធានការទន់ភ្លន់ មួយចំនួន ដូច រាជធានី ភ្នំពេញ ដោយ កំណត់ តំបន់ ត្រូវ បិទ ខ្ទប់ ក្នុង ករណី តំបន់ នោះ មាន ការរីករាលដាល ខ្លាំង ៕
រដ្ឋមន្រ្តី លឹម គាន ហោ ចាត់ ឲ្យ ក្រុមការងារ នាំ សម្ភារ បរិក្ខា ពេទ្យ ដល់ មន្ទីរពេទ្យ បង្អែក ស្រុក ពញា ឮ ខេត្ត កណ្តាល
សូម ជម្រាប ជូន ថា ចាប់តាំងពី មាន ការផ្ទុះឡើង នូវ ជំងឺ កូវីត១៩ នៅ កម្ពុជា ទីតាំង វិទ្យាល័យ ទេព ប្រណម និង អាគារ វប្បធម៌ ស៊ុយ សុផាន ស្ថិត ក្នុង ស្រុក ពញា ឮ ត្រូវបាន ប្រែក្លាយទៅជា មណ្ឌល ចត្តាឡី ស័ក សម្រាប់ ទទួល បងប្អូន ប្រជាពលរដ្ឋ ដែល ធ្វើដំណើរ មកពី បណ្តា ខេត្ត ផ្សេង ៗ និង បងប្អូន ប្រជាពលរដ្ឋ ក្នុង ស្រុក ពញា ឮ បាន ជាង ៤០០ នាក់ និង ការធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ ប្រមាណ ៣ពាន់ នាក់ ផ្សេង ទៀត ។
ដោយសារ ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ពី ការឆ្លង រាតត្បាត នៃ ជំងឺ កូវីដ១៩ ដែល បង្កឡើង ដោយ ព្រឹត្តិការណ៍ « សហគមន៍ ២០កុម្ភៈ » បាន តម្រូវឲ្យ រដ្ឋបាល ស្រុក ពញា ឮ ប្រែក្លាយ ទីតាំង សាលា បឋមសិក្សា អដ្ឋិ ឬ ស្ស ស្ថិត ក្នុង ឃុំ ផ្សារ ដែក ជា កន្លែង សម្រាប់ ព្យាបាល អ្នក ជម្ងឺ កូវីដ១៩ កម្រិត ស្រាល ដែល មាន សម្ថភាព អាច ទទួល អ្នកជំងឺ បាន ប្រមាណ ១០០ នាក់ ( បច្ចុប្បន្ន អ្នក ជម្ងឺ កម្រិត ស្រាល ៤នាក់ កំពុង សម្រាក ព្យាបាល ) ។
ក្នុង នោះ រដ្ឋមន្រ្តី បាន ឧបត្ថម្ភ ជា បន្តបន្ទាប់ និង នា ពេលនេះ នូវ សម្ភារ បរិក្ខា ពេទ្យ ជាច្រើន នៅ តាម ទីតាំង មណ្ឌល ចត្តាឡី ស័ក ការធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ ការចុះ យក សំណាក នៅ តាម ភូមិ - ឃុំ ដែល មាន ការពាក់ព័ន្ធ និង ទីកន្លែង សម្រាប់ ព្យាបាល ជម្ងឺ កូវីដ១៩ ដែល ទើប បង្កើតឡើង ថ្មី ៗ នេះ ផងដែរ ។
វិធានការបិទ ខ្ទប់ ត្រូវបាន រាជ រដ្ឋាភិបាល កម្ពុជា យកមក ប្រើប្រាស់ ដើម្បី គ្រប់គ្រង ការឆ្លង រីកដាល រាល ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ។ វិធានការបិទ ខ្ទប់ នេះ បាន ដាក់ចេញ ជំហ៊ាន ដំបូង ក្នុង រយៈពេល ២សប្ដាហ៍ ក្រោយមក បាន បន្ដ មួយ សប្ដាហ៍ ទៀត ប៉ុន្ដែ មាន ការបែងចែក ជា៣ តំបន់ ក្នុង នោះ មាន « តំបន់ ក្រហម ». « តំបន់ លឿង ទុំ » និង « តំបន់ លឿង » ។
ក្រោយមក នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២១ រាជ រដ្ឋាភិបាល បាន បញ្ចប់ វិធានការបិទ ខ្ទប់ ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ចាប់ពី ម៉ោង សូន្យ ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ ដោយ ប្រគល់ ភារកិច្ច ជូន អភិបាល រាជធានី ភ្នំពេញ និង អភិបាល ខេត្ត កណ្ដាល អាច ដាក់ ចេញ វិធានការ ផ្សេង ៗ ចាំបាច់ ដើម្បី ទប់ស្កាត់ ការឆ្លង ជំងឺ កូវីដ នេះ ។
ការកំណត់ ភូមិសាស្ដ្រ តំបន់ ត្រូវ ឈរ លើ គោលការណ៍ ចំនួន ៣ រួម មាន៖ ទី ១៖ ចំនួន អ្នកវិជ្ជមាន និង ចំនួន អ្នក យក សំណាក នៅក្នុង ភូមិ សង្កាត់ ទាំងអស់ ក្នុង ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ . ទី ២៖ កំណត់ កត្តា ភូមិសាស្ដ្រ ស្ថានភាព ប្រជាពលរដ្ឋ រស់ នៅ និង ទី៣៖ ការយល់ដឹង និង ឥរិយាបថ នៃ ការចូល របស់ ប្រជាពលរដ្ឋ ។ នេះ បើ តាម អ្វី ដែល លោក មាន ចាន់ យ៉ាដា បាន គូសបញ្ជាក់ ។
លោក បាន ពន្យល់ ថា វិធានការ រដ្ឋបាល ដែល អនុវត្ត នៅ តំបន់ ក្រហម គឺ ដើម្បី កំណត់ គោលដៅ បិទ ខ្ទប់ មិន ឲ្យ ប្រជាពលរដ្ឋ ចេញ ពី ផ្ទះ ឬ ធ្វើដំណើរ ចេញ នោះ ឡើយ លើកលែង ករណី មួយចំនួន ប៉ុណ្ណោះ ។ ទន្ទឹមនឹង ការបិទ ខ្ទប់ នេះ អាជ្ញាធរ ក៏ បាន ប្រើប្រាស់ កម្លាំង ល្បាត ដើម្បី ណែនាំ ប្រជាពលរដ្ឋ កុំ ឲ្យ ចេញ ក្រៅ ផ្ទះ បើ ទោះបី លំបាក ប៉ុន្ដែ ក្រោយមក សង្កេតឃើញ ថា ប្រជាពលរដ្ឋ ច្រើន បាន ចូលរួម ។
ព្រម ពេល ជាមួយ ការបិទ ខ្ទប់ នេះ ក្រសួង សុខាភិបាល ដោយ មាន ការចូលរួម ពី ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត សម្ដេច តេជោ TYDA បាន បើក យុទ្ធនាការ យក សំណាក លើ មុខ សញ្ញា ដែល ពាក់ព័ន្ធ ផ្ទាល់ ជាមួយ អ្នកវិជ្ជមាន . អ្នក ដែល មាន រោគសញ្ញា និង ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ វិជ្ជមាន ជំងឺ កូវីដ ច្រើន ។
ដោយឡែក សម្រាប់ វិធានការគាំពារ សង្គម វិញ គឺ រាជ រដ្ឋាភិបាល តាមរយៈ សាលា រាជធានី ភ្នំពេញ បាន សម្រុក នាំយក ស្បៀងអាហារ ទៅ ចែកជូន ប្រជាពលរដ្ឋ ពិសេស អ្នក ដែល មាន ជីវភាព ខ្វះខាត រស់ នៅ តំបន់ ក្រហម តែម្ដង ព្រោះ ពួកគាត់ មិន អាច ចេញ ក្រៅ ផ្ទះ បាន នោះ ទេ ។ បើ ទោះបី តំបន់ ខ្លះ យឺតយ៉ាវ ប៉ុន្ដែ ប្រជាពលរដ្ឋ ជាច្រើន បាន ទទួល នូវ ស្បៀងអាហារ ទាំងអស់ នេះ ។
លោក ក៏ បាន បញ្ជាក់ អំពី មូលហេតុ ដែល តែង ត្រូវបាន គេ លើកឡើង ថា ហេតុ អ្វី បានជា បិទ ខ្ទប់ ហើយ នៅតែ មាន អ្នក ឆ្លង ច្រើន ផងដែរ ថា ចំនួន អ្នក ដែល ឆ្លង រាល់ ថ្ងៃ នេះ គឺ សុទ្ធតែ ចេញ ពី តំបន់ ក្រហម ហើយក៏ ជា ចំនួន ដែល អាជ្ញាធរ អាច គ្រប់គ្រង បាន មិន ឲ្យ មាន ការឆ្លង រីករាលដាល ទៅកាន់ តំបន់ ផ្សេង នោះ ទេ ។
( បន្ទាយមានជ័យ )៖ លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ លោក ឧកញ៉ា ឡាយ ប៊ុន ប៉ា និង លោកជំទាវ ឡាយ ឈុន នី ប្រធាន ក្រុមប្រឹក្សាភិបាល បុរី ដឺ ផាក ស៊ីធី ប៉ោយប៉ែត ដែល បាន ឧបត្ថម្ភ ថវិកា ចំនួន ២ម៉ឺន ដុល្លារ សម្រាប់ ជួយ ដោះស្រាយ ជីវភាព ដល់ ប្រជាពលរដ្ឋ នៅ តំបន់ បិទ ខ្ទប់ ក្រុង ប៉ោយប៉ែត ។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត ក៏ សូម ថ្លែងអំណរគុណ ដល់ លោក ឧកញ៉ា អ៊ឹង អ៊ុយ និង លោកជំទាវ ប្រធាន ក្រុមហ៊ុន ឆាយ ឆាយ អិន វេស មែន ដែល បាន ឧបត្ថម្ភ ថវិកា ចំនួន ១ម៉ឺន ដុល្លារ សម្រាប់ ជួយ ដោះស្រាយ ជីវភាព ដល់ ប្រជាពលរដ្ឋ នៅ តំបន់ បិទ ខ្ទប់ ក្រុង ប៉ោយប៉ែត នៅក្នុង ការប្រយុទ្ធ ប្រឆាំង ជាមួយ ជំងឺ កូវីដ ។
លោក អភិបាល ខេត្ត បាន ចាត់ទុក អំណោយ ជា ថវិកា របស់ លោក ឧកញ៉ា ទាំង២ ពិតជា មាន សារៈសំខាន់ ស្រប ពេល ដែល ខេត្ដ កំពុង ប្រឈមមុខ នឹង ជំងឺ កូវីដ - ១៩ ។ បើ តាម លោក អភិបាល ខេត្ត សម្រាប់ ថវិកា ទាំង៣ ម៉ឹន ដុល្លារ ជា ការចូលរួម ឧបត្ថម្ភ របស់ លោក ឧកញ៉ា ទាំង ២នេះ រដ្ឋបាល ខេត្ត បាន នាំយក ទៅ ចាត់ចែង និង ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ បាន ជាង ១១០០ គ្រួសារ ហើយ នៅ ក្រុង ប៉ោយប៉ែត ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត ក៏ បាន ប្រសិទ្ធ ពរ ជ័យ ដល់ លោក ទាំង២ សូម ទទួលបាន នូវ ពុទ្ធ ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ លោកស្រី ម៉ែន សំអន អំពាវនាវ ដល់ ពលរដ្ឋ រស់ នៅ និង ធ្វើការ នៅ តំបន់ ណា ត្រូវ រក្សា នៅ តំបន់ នោះ ដដែល សូម កុំ ផ្លាស់ទី ប្រសិនបើ មិន ចាំបាច់
( ស្វាយរៀង ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ក្នុង នាម គណៈ កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ បាន អំពាវនាវ ដល់ ពលរដ្ឋ ទាំងអស់ ដែល មាន កូន ចៅ រស់ នៅ និង ធ្វើការ នៅក្នុង តំបន់ ណា សូម រក្សា នៅ តំបន់ នោះ ដដែល កុំ មាន ការផ្លាស់ទី ប្រសិនបើ មិន ចាំបាច់ ដើម្បី ចូលរួមចំណែក ក្នុង ការទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ជាមួយ រាជ រដ្ឋាភិបាល ។
ការអំពាវនាវ របស់ លោកស្រី បណ្ឌិត ម៉ែន សំអន បែប នេះ ខណៈ ដែល លោកស្រី បាន នាំយក អំណោយ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា តាមរយៈ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ស្វាយរៀង ចែកជូន ដល់ ប្រជាពលរដ្ឋ ចំនួន ៣៩ គ្រួសារ ដែល រងគ្រោះ ដោយសារ ខ្យល់ កន្ត្រាក់ បណ្តាលឲ្យ ខូចខាត ផ្ទះ សំបែង និង ទ្រព្យសម្បត្តិ នា រសៀល ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២១ ស្ថិត ក្នុង ឃុំ ត្នោត និង ឃុំ ថ្មី ស្រុក កំពង់រោទិ៍ ខេត្ត ស្វាយរៀង ។
លោកស្រី ក៏ បាន នាំមក នូវ ប្រសាសន៍ ផ្ដាំផ្ញើ សួរសុខទុក្ខ និង សេចក្ដី នឹករលឹក ពីសំណាក់ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដោយ ក្តី នឹករលឹក ដែល ជានិច្ចកាល សម្ដេច តែងតែ យកចិត្តទុកដាក់ គិត គូរ ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ រូប មិន ប្រកាន់ វណ្ណៈ ពណ៌ សម្បុរ ជំនឿ សាសនា ឬ និន្នាការ នយោបាយ ណាមួយ ឡើយ ។
លោកស្រី បាន ផ្តាំផ្ញើ បន្ថែម ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ សូម មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ បំផុត ក្នុង ការថែរក្សា សុខភាព ជាពិសេស សូម ក្រើន រម្លឹក ដល់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន កុំ ឲ្យ ធ្វេសប្រហេស ពី ជំងឺ កូវីដ - ១៩ នេះ ឲ្យ សោះ ត្រូវ អនុវត្តន៍ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការណ៍ របស់ រាជ រដ្ឋាភិបាល ៣ការពារ ៣កុំ ផងដែរ ព្រោះ បច្ចុប្បន្ន នេះ ករណី ឆ្លង នៅ កម្ពុជា មិន ទាន់ មាន ការថមថយ នៅឡើយ នោះ ទេ ។
លោកស្រី ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន គ្រប់ ពេលវេលា តាមរយៈ ការតាមដាន សេចក្តីជូនដំណឹង ស្តីពី ស្ថានភាព អាកាសធាតុ របស់ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម និង វិធានការត្រៀម បង្ការ ផ្សេង ៗ ទៀត ដើម្បី បញ្ចៀស នូវ ការ គ្រោះថ្នាក់ កើតឡើង ជា យថាហេតុ ។
ក្នុង ឱកាស នោះ ក៏ មាន សប្បុរសជន បាន ចូលរួមចំណែក ជា មូលនិធិ អបអរសាទរ ក្នុង ឱកាស នៃ ខួប លើក ទី ១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ ដើម្បី ទ្រទ្រង់ ដល់ សកម្មភាព ការងារ មនុស្សធម៌ ជាមួយ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ស្វាយរៀង ដើម្បី យក ទៅ ជួយ ដល់ ប្រជាពលរដ្ឋ ដែល ប្រឈម ងាយ រងគ្រោះ នឹង មាន ទុក្ខលំបាក ផ្សេង ៗ រួម មាន៖
ជាមួយគ្នា នេះ លោកស្រី ម៉ែន សំអន ក៏ បាន ចូល បុណ្យ សព ដល់ គ្រួសារ ដែល មាន សមាជិក បាន ទទួលមរណភាព ដោយសា ឆក់ ខ្សែភ្លើង កាលពី ម្សិលមិញ ផងដែរ ៕
អភិបាល រាជធានី ភ្នំពេញ ណែនាំ អាជ្ញាធរ ខណ្ឌ និង សមត្ថកិច្ច ដែល កំពុង ឈរជើង នៅ តំបន់ ក្រហម ពង្រឹង ការងារ ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត ដើម្បី ផ្តាច់ ឬ សគល់ កូវីដ១៩ ឱ្យ បាន ឆាប់
( ភ្នំពេញ ) ៖ អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង បាន ណែនាំ ឲ្យ អាជ្ញាធរ ខណ្ឌ និង កម្លាំង មាន សមត្ថកិច្ច កំពុង ឈរជើង នៅ តាម គោលដៅ បិទ ខ្ទប់ ក្នុង តំបន់ ក្រហម ត្រូវ ពង្រឹង ការងារ ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត ពិសេស មិន អនុញ្ញាត ឱ្យ ចេញ - ចូល ទៅក្នុង តំបន់ ក្រហម ជាដាច់ខាត ។
ការជំរុញ បែប នេះ របស់ លោក ឃួង ស្រេង បាន ធ្វើឡើង ខណៈ ដែរ លោក អញ្ជើញ ចុះ ពិនិត្យ ស្ថានភាព ជាក់ស្ដែង នៅ តាម តំបន់ ក្រហម មួយ ចំនួន នៅក្នុង ខណ្ឌ មានជ័យ ខណ្ឌ ពោធិ៍សែនជ័យ និង ខណ្ឌ ប្ញស្សីកែវ នៅ វេលា ថ្ងៃត្រង់ ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ ។
សេចក្តីសម្រេច របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា ខណ្ឌ ទាំង៨ ដែល មាន តែ តំបន់ លឿង ទុំ និង តំបន់ លឿង រួម មាន៖
ក្រៅពី ការណែនាំឲ្យ ពង្រឹង នៅ តាម គោលដៅ ទាំង ប៉ុន្មាន ខាងលើ នេះ លោក ឃួង ស្រេង ក៏ បាន ឧបត្ថម្ភ នូវ ថវិកា មួយ ចំនួន ជូន ដល់ អាជ្ញាធរ និង កងកម្លាំង ដែល បាន និង កំពុង ឈរជើង នៅ គោលដៅ បិទ ខ្ទប់ ទាំងនោះ គឺ ដើម្បី ជា ការ លើកទឹកចិត្ត ឱ្យ អាជ្ញាធរ និង កងកម្លាំង មាន ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ក្នុង ការបិទ ខ្ទប់ តំបន់ ក្រហម ទាំង នេះ ឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ចៀសវាង បាន នូវ ការរីករាលដាល ជំងឺ កូវីដ១៩ ទៅ តំបន់ ផ្សេង ទៀត ។
បន្ថែម ពីលើ នេះ ទៀត លោក ឃួង ស្រេង ក៏ បាន ឧបត្ថម្ភ ថវិកា មួយ ចំនួន ទៀត ជូន ទៅ លោក សាន្ត សំអាត មន្ត្រី នគរបាល ប៉ុស្តិ៍ ចោម ចៅ ទី២ ខណ្ឌ ពោធិ៍សែនជ័យ ដែល រង របួស ក្បាល ដោយ ខ្យល់ព្យុះ កាលពី យប់ មិញ នៅពេល កំពុង បំពេញ ការងារ ។
លោក ឃួង ស្រេង បាន បន្ត ទៀត ថា ក្នុង នាម អាជ្ញាធរ ក៏ ដូចជា កម្លាំង មាន សមត្ថកិច្ច ត្រូវ ណែនាំ ពន្យល់ ប្រជាពលរដ្ឋ ឲ្យបាន យល់ ពី ហេតុផល នៃ ការបិទ ខ្ទប់ នេះ ដែល សកម្មភាព បែប នេះ របស់ អាជ្ញាធរ ក៏ ដូចជា កងកម្លាំងប្រដាប់អាវុធ មាន គោលបំណង តែ មួយ គត់ នោះ គឺ រក្សា ជីវិត បងប្អូន ទាំងអស់ គ្នា កុំ ឲ្យ ឆ្លង ជំងឺ កូវីដ១៩ មិន មាន ចេតនា ណាមួយ ធ្វើបាប បងប្អូន ទេ ។
ក្រៅពី ការណែនាំ និង ជំរុញ ឲ្យ រឹតបន្តឹង នៅ តាម គោលដៅ សំខាន់ ៗ នៃ ច្រក ចេញ ចូល តំបន់ ក្រហម នេះ ហើយ លោក ឃួង ស្រេង បាន ណែនាំ និង បញ្ជា ឱ្យ អាជ្ញាធរ ខណ្ឌ ទាំងអស់ ធ្វើ សកម្មភាព បាញ់ ថ្នាំ សម្លាប់ មេរោគ នៅ តាម តំបន់ ក្រហម ទាំង នេះ ផងដែរ ពិសេស នៅ តំបន់ ផ្ទះ ជួល របស់ កម្មករ កម្ម ការិនី រោងចក្រ ស្នាក់ នៅ និង នៅ តាម បណ្តា រោងចក្រ ដែល មាន បញ្ហា ប្រឈម ខ្លាំង នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
ដោយឡែក ចំពោះ ការផ្ដល់ អំណោយ ជូន ប្រជាពលរដ្ឋ អាជ្ញាធរ ខណ្ឌ សង្កាត់ ត្រូវតែ បន្ត ចែកជូន ទៅដល់ បងប្អូន ប្រជាពលរដ្ឋ ពិសេស បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត នៅ តាម តំបន់ ក្រហម នេះ ឯង ៕
រដ្ឋបាល ខេត្ត បាត់ដំបង សម្រេច បិទ ទីតាំង ឱសថស្ថាន មួយ នៅ ឃុំ ពេជ្រ ចិន្តា ស្រុក ភ្នំព្រឹក ក្រោយ ពាក់ព័ន្ធ អ្នកជំងឺ កូវីដ១៩ ដែល មកពី ខេត្ត កណ្ដាល
( បាត់ដំបង ) ៖ លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង បាន ចេញ សេចក្ដីសម្រេច បិទ ទីតាំង ជា បណ្ដោះអាសន្ន ឱសថ ពេជ្រ ចិន្ដា ស្ថិត ក្នុង ភូមិ ភ្នំ តូច ឃុំ ពេជ្រ ចិន្ដា ស្រុក ភ្នំព្រឹក ក្រោយ ពាក់ព័ន្ធ អ្នក កើត ជំងឺ កូវីដ១៩ ដែល ធ្វើដំណើរ មកពី ខេត្ត កណ្ដាល ។
ក្នុង សេចក្ដីសម្រេច ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ថា ការបិទ ជា បណ្ដោះអាសន្ន នូវ ឱសថ ពេជ្រ ចិន្ដា នេះ ធ្វើឡើង ដើម្បី ទប់ស្កាត់ ការរាលដាល នៃ ជំងឺ កូវីដ១៩ ក្រោយពី បាន រកឃើញ ឈ្មោះ ភ៉ិន មេត្តា អាយុ ៣២ ឆ្នាំ រស់ នៅ ភូមិ ព្រែក ថ្មី ឃុំ ព្រែក អញ្ចាញ ស្រុក មុខ កំពូល ខេត្ត កណ្ដាល មាន ជំងឺ កូវីដ១៩ នៅ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ និង បាន ចូល ទីតាំង ឱសថស្ថាន នេះ នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២១ ។
កម្លាំង នគរបាល បង្រ្កាប ការជួញដូរ គ្រឿងញៀន និង ដកហូត ថ្នាំ ជាង ៣គីឡូក្រាម នៅ ស្រុក កំរៀង ខេត្ត បាត់ដំបង
ប្រតិបត្តិការ បង្រ្កាប ករណី ជួញដូរ គ្រឿង១ ករណី នេះ ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ២នាក់ រួម មាន៖
វត្ថុតាង ដកហូត បាន រួម មាន៖
បច្ចុប្បន្ន សមត្ថកិច្ច នគរបាល ជំនាញ បាន ធ្វើ ការស្រាវជ្រាវ និង រៀបចំ បញ្ជូន ទៅ សាលាដំបូង ខេត្ត បាត់ដំបង ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ រួចហើយ ៕ រដ្ឋបាល ក្រុង ដូន កែវ ជូនដំណឹង ពី ការរកឃើញ មន្ដ្រី នគរបាល ម្នាក់ ឆ្លង ជំងឺ កូវីដ១៩
រដ្ឋបាល ក្រុង ដូន កែវ បាន បញ្ជាក់ ថា មន្ដ្រី នគរបាល ដែល រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ នេះ ឈ្មោះ យិន សេរី ។ មន្ដ្រី នគរបាល រូប នេះ បាន យក សំណាក រួច នៅ រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ បាន ធ្វើដំណើរ មក ស្រុក កំណើត ខ្លួន លុះ មកដល់ ផ្ទះ បាន ប្រាប់ ក្រុមគ្រួសារ មិន ឲ្យ មក ជិត ខ្លួន រួច បាន ទៅ ធ្វើចត្តាឡី ស័ក នៅ មណ្ឌល សាលា បឋមសិក្សា ត្រាំ តែម្ដង ។
ក្រោយមក នៅ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ រូប គាត់ ក៏ បាន ទទួល ព័ត៌មាន ពី ភ្នំពេញ ថា វិជ្ជមាន ជំងឺ កូវីដ១៩ ។ បន្ទាប់ពី ដឹង លទ្ធផល វិជ្ជមាន រដ្ឋបាល ក្រុង ដូន កែវ សហការ ជាមួយ ក្រុម គ្រូពេទ្យ បាន ដឹក រូប គាត់ មក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ។ ប៉ុន្ដែ ករណី នេះ គាត់ មិន មាន អ្នក ប៉ះពាល់ ផ្ទាល់ និង ដោយ ប្រយោល នោះ ទេ ៕
ខាង ចិន បាន ចេញ សេចក្តីថ្លែងការណ៍ បកស្រាយ ពី ការសម្រេចចិត្ត ខាងលើ ថា ថ្មី ៗ នេះ រដ្ឋាភិបាល អូស្រ្តាលី បាន ដាក់ចេញ វិធានការ មួយចំនួន ដែល បង្ក ការប៉ះពាល់ ដល់ ការធ្វើ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ជាធម្មតា រវាង ចិន ហើយនិង អូស្រ្តាលី ដែល កើត ចេញ មក ពី ផ្នត់គំនិត បែប សម័យ សង្រ្គាម ត្រជាក់ និង ការរើសអើង មនោគមន៍វិជ្ជា ។
ខាង អូស្រ្តាលី ពុំ ទាន់ ឃើញ មាន ការឆ្លើយតប យ៉ាងណា នោះ ទេ ចំពោះ ការសម្រេចចិត្ត របស់ ចិន ។ កិច្ចប្រជុំ ចុងក្រោយ បំផុត ដែល ស្ថិត ក្រោម យន្តការកិច្ចសន្ទនា សេដ្ឋកិច្ច ចិន - អូស្រ្តាលី ដែល មាន គោលដៅ ធ្វើជា គោលការណ៍ ស្នូល សម្រាប់ កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច រវាង ប្រទេស ទាំង ពីរ ត្រូវបាន ធ្វើឡើង នៅ ទីក្រុង ប៉េកាំង កាលពី ឆ្នាំ ២០១៧ ។
ក្រសួង តម្រូវ បេក្ខជន ប្រឡង ចូល បម្រើ ការងារ ក្របខ័ណ្ឌ ត្រូវ ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ រួច រាល់ . បើ មិន អាច ចាក់ វ៉ាក់សាំង ត្រូវ មាន លិខិត បញ្ជាក់ ពី មន្ទីរ សុខាភិបាល
( ភ្នំពេញ ) ៖ ក្រសួង មុខងារ សាធារណៈ នៅ ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ថា បេក្ខជន ដែល ចង់ ប្រឡង ចូល បម្រើ ការងារ ក្នុង ក្របខ័ណ្ឌ ក្រសួង ស្ថាប័ន ចំនួន ០៦ សម្រាប់ ឆ្នាំ ២០២១ ត្រូវ ធានា ថា បាន ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ទាំង ០២ លើក រួចរាល់ ហើយ ។
ក្រសួង ស្ថាប័ន ទាំង ០៦ នោះ រួមាន ក្រសួង មុខងារ សាធារណៈ . ក្រសួង ទំនាក់ទំនង រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច . ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ . ក្រសួង ពាណិជ្ជកម្ម . ក្រសួង ធនធាន ទឹក និង ឧតុនិយម និង រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល ។
* ១៖ បេក្ខជន ដែល បាន ដាក់ពាក្យ សុំ សិទ្ធិ ប្រឡង ចូល បម្រើ ការងារ ក្នុង ក្របខ័ណ្ឌ ក្រសួង ស្ថាប័ន ទាំង ០៦ ខាងលើ ត្រូវ ធានា ឲ្យបាន ក្នុង ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ទាំង ២លើក រួចហើយ ។
* ២៖ នៅ ថ្ងៃ ប្រឡង បេក្ខជន ទាំងអស់ ត្រូវ ភ្ចាប់ មក ជាមួយ នូវ កាត សម្គាល់ ដែល សាម៉ី បាន ទទួល វ៉ាក់សាំង ។
* ៣៖ ក្នុង ករណី ដែល បេក្ខជន មិន អាច ទទួល ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ បាន ត្រូវ មាន លិខិត បញ្ចាក់ ជា ផ្លូវការ ពី មន្ទីរ សុខាភិបាល រាជធានី ខេត្ត ។
* ៤៖ ក្នុង ករណី បេក្ខជន ណា ដែល មិន មាន ប័ណ្ណ ទទួល វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ឬ លិខិត បញ្ជាក់ របស់ មន្ទីរ សុខាភិបាល រាជធានី ខេត្ត គណៈកម្មការរៀបចំ ការប្រឡង មិន អនុញ្ញាតឲ្យ បេក្ខជន នោះ ចូលរួម ប្រឡង ឡើង ។
* ៥៖ គណៈកម្មការរៀបចំ ការប្រឡង នឹង ធ្វើ ការបិទ ផ្សាយ បញ្ជី ឈ្មោះ បេក្ខជន ដើម្បី ទុក សិទ្ធិ ឲ្យ តវ៉ា ក្នុង ករណី ដែល មិន មាន ឈ្មោះ ប្រឡង នៅ ពេល ដែល សហគមន៍ ព្រឹត្ត ការណ៏ ២០កុម្ភៈ ត្រូវបាន បិទ បញ្ចប់ ។
* ៦៖ ចំពោះ សេចក្តីសម្រេច ស្តីពី ការអនុញ្ញាតឲ្យ បេក្ខជន ចូលរួម ប្រឡង កាលបរិច្ឆេទ ប្រឡង និង មណ្ឌល ប្រឡង គណៈកម្មការរៀបចំ ការប្រឡង នឹង ជូន ដំណឹង ពេល ក្រោយ ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ ក្រសួង មុខងារ សាធារណៈ ៖ រដ្ឋមន្ត្រី ជា វ៉ាន់ ដេត ផ្តល់ អំណោយ ជូន កម្មករ - កម្ម ការិនី ៣.០០០ នាក់ កំពុង ចត្តាឡី ស័ក នៅក្នុង ស្រុក បាទី ខេត្ត តាកែវ
( តាកែវ )៖ លោក ភួន ឈីម អភិបាល ស្រុក បាទី ព្រមទាំង សហការី នា ព្រឹក ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២១ បាន នាំយក អំណោយ របស់ លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ផ្តល់ ជូន កម្មករ - កម្ម ការិនី ចំនួន ៣.០០០ នាក់ ដែល កំពុង ស្ថិត ក្នុង មណ្ឌល ចត្តាឡី ស័ក នៅ តាម បណ្តា ឃុំ នានា នៃ ស្រុក បាទី ខេត្ត តាកែវ ។
ក្នុង ឱកាស នោះ លោក អភិបាល ស្រុក បាទី ក៏ បាន នាំយក ថវិកា របស់ លោក ជា វ៉ាន់ ដេត ចំនួន ៣៤ លាន រៀល ដើម្បី ឧបត្ថម្ភ បែងចែក ទៅ តាម មណ្ឌល ចត្តាឡី ស័ក ឃុំ នីមួយ ៗ . ការិយាល័យ សុខាភិបាល ស្រុក ប្រតិបត្តិ និង មន្ទីរពេទ្យ បង្អែក ស្រុក ដើម្បី ប្រើប្រាស់ ក្នុង តម្រូវ ការចាំបាច់ ផ្សេង ៗ ផងដែរ ។
ក្រុមការងារ ក៏ បាន ផ្ដាំផ្ញើ ការ សួរសុខទុក្ខ ពី លោក ជា វ៉ាន់ ដេត ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ និង បាន ណែនាំ ឱ្យ អនុវត្ត ការធ្វើចត្តាឡី ស័ក តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន ត្រឹមត្រូវ ដោយ អនុវត្ត វិធានការ ៣ការពារ ៣កុំ រក្សា អនាម័យ និង សុខភាព ឱ្យ បាន កាន់តែ ល្អ ផងដែរ ៕ ចំណេះដឹង ទូទៅ៖ ឈ្វេងយល់ ខ្លះ ៗ ពី ប្រទេស ឥណ្ឌា ខណៈ ប្រទេស មួយ នេះ កំពុង ទទួល ការវាយប្រហារ ពី មេរោគ ដ៏ កាច សាហាវ
តើ ប្រទេស នេះ មាន ចំណុច សំខាន់ អ្វី ខ្លះ ដែល គេ ត្រូវ ឈ្វេងយល់ ? ចង់ ជ្រាប ច្បាស់ សូម អាន អត្ថបទ ចំណេះដឹង ទូទៅ ខាងក្រោម នេះ៖
* ទីតាំង ភូមិសាស្ត្រ យោង តាម ប្រភព ពី Statista បាន ឲ្យដឹង ថា ប្រទេស ឥណ្ឌា មាន ផ្ទៃដី ៣.២៨៧ .៥៩០ គីឡូម៉ែត្រ ក្រឡា ធំ ជាង គេ ទី៧ លើ ពិភពលោក ។ ប្រទេស នេះ មាន ទីតាំង ស្ថិត នៅ ភូមិភាគ អាស៉ី ខាងត្បូង ខាងលិច ជាប់ នឹង សមុទ្រ អារ៉ាប់ ខាងកើត ជាប់ នឹង ឈូង សមុទ្រ បេង ហ្គាល់ និង ខាងត្បូង ជាប់ មហាសមុទ្រ ឥណ្ឌា ហើយ មាន ព្រំប្រទល់ ខាងជើង ព្រំប្រទល់ ខាង ឦសាន ព្រំប្រទល់ ខាង ពាយព្យ និង ព្រំប្រទល់ ខាងកើត ជាប់ នឹង ប្រទេស ប៉ាគីស្ថាន ណេប៉ាល់ ប៊ូតាន ចិន និង បង់ ក្លាដេស ។
ភាសា ហិណ្ឌូ អង់គ្លេស និង មាន ភាសា ផ្សេង ទៀត ត្រូវបាន គេ ឃើញ ប្រើប្រាស់ នៅ ឥណ្ឌា ។ ភាសា ហិណ្ឌូ ត្រូវបាន និយាយ ដោយ ប្រជាជន ច្រើន ជាង គេ ( ប្រហែល៣០ % នៃ ប្រជាជន សរុប ) គឺជា ភាសា ផ្លូវការ សម្រាប់ សហព័ន្ធ ។ ភាសា អង់គ្លេស ត្រូវបាន គេ និយម ប្រើ ក្នុង ការងារ ធ្វើ ជំនួញ និង រដ្ឋបាល ជា ភាសា ផ្លូវការ សម្រាប់ ជំនួយ ។ រដ្ឋធម្មនុញ្ញ ក៏ បាន ទទួលស្គាល់ ផងដែរ ថា ២១ ភាសា ផ្សេង ទៀត មាន ការប្រើប្រាស់ យ៉ាង ច្រើន ឬ តំណាង ភាព ពី សម័យ បុរាណ ។ ឥណ្ឌា មាន ភាសា រហូតដល់ ១៦៥២ ភាសា គឺ ច្រើន ជាង គេ លើ ពិភពលោក ។
រដ្ឋធម្មនុញ្ញ ឥណ្ឌា បាន ប្រកាស ដាក់ ឲ្យ ប្រើ ចាប់តាំងពី ថ្ងៃទី ២៦ ខែសីហា ឆ្នាំ ១៩៥០មក ម៉្លេះ ។ យោង តាម រដ្ឋធម្មនុញ្ញ ឥណ្ឌា ក្នុង បុព្វក ថា បាន ចែង ថា ឥណ្ឌា គឺជា សាធារណរដ្ឋ ដែល មាន អធិបតេយ្យភាព សង្គម និយម មិន អាស្រ័យ ជំនឿ សាសនា និង ប្រជាធិបតេយ្យ ។ ឥណ្ឌា មាន រដ្ឋាភិបាល សហព័ន្ធ មួយ និង សភា ពីរ ដែល ចែក អំណាច បី ផ្សេង គ្នា គឺ៖ អង្គ នីតិប្បញ្ញត្តិ អង្គ នីតិប្រតិបត្តិ និង តុលាការ ។
* អង្គ នីតិប្រតិបត្តិ អង្គ នីតិប្រតិបត្តិ រួម មាន ប្រធានាធិបតី អនុប្រធានាធិបតី និង គណៈ រដ្ឋមន្ត្រី ដែល ដឹកនាំ ដោយ នាយក រដ្ឋមន្ត្រី ។ រដ្ឋមន្ត្រី គ្រប់ រូប នៃ គណៈ រដ្ឋមន្ត្រី ត្រូវតែ ជា សមាជិក នៃ សភា ណាមួយ ក្នុង ចំណោម សភា ទាំង ពីរ ។ ក្នុង ប្រព័ន្ធ សភា ឥណ្ឌា អង្គ នីតិប្រតិបត្តិ អាស្រ័យ ទៅនឹង អង្គ នីតិបញ្ញត្តិ ។ ដូច្នេះ នាយក រដ្ឋមន្ត្រី និង គណៈ រដ្ឋមន្ត្រី របស់ គាត់ ត្រូវ ទទួលខុសត្រូវ ចំពោះ សភា ជាន់ ទាប ។
* តុលាការ ឥណ្ឌា មាន តុលាការ បី ថ្នាក់ រួមគ្នា គឺ មាន តុលាការ កំពូល ដឹកនាំ ដោយ ប្រធាន ចៅក្រម ម្នាក់ និង ចៅក្រម ២៥ រូប ផ្សេង ទៀត ដែល តែងតាំង ដោយ ប្រធានាធិបតី ដែល ត្រូវ បំពេញ តួនាទី រហូតដល់ អាយុ ៦៥ ឆ្នាំ ឬ ក៏ អាច ដកហូត តួនាទី ប្រសិនបើ រកឃើញ ភស្តុតាង ថា បាន ប្រព្រឹត្ត នូវ អំពើ មិន សមរម្យ ឬ ខុសពី ក្រមសីលធម៌ និង តុលាការ ថ្នាក់ ខ្ពស់ ( ស្មើនឹង សាលាឧទ្ធរណ៍ នៅ ខ្មែរ ) ចំនួន ២១ ព្រមទាំង តុលាការ ថ្នាក់ ទាប ( ស្មើនឹង សាលាដំបូង នៅ ខ្មែរ ) ជាច្រើន ទៀត ។
តុលាការ កំពូល មាន សមត្ថកិច្ច លើ ករណី ដែល ពាក់ព័ន្ធ នឹង សិទ្ធិ មូលដ្ឋាន និង លើ ជម្លោះ រវាង រដ្ឋ និង អំណាច កណ្ដាល ព្រមទាំង បណ្ដឹង ឧទ្ធរណ៍ ពី តុលាការ ថ្នាក់ ខ្ពស់ ។ តុលាការ ត្រូវតែ ឯករាជ្យ ហើយ មាន អំណាច ប្រកាស ដាក់ ឲ្យ ប្រើ ច្បាប់ និង អាច ច្រានចោល ផងដែរ នូវ ច្បាប់ របស់ សហព័ន្ធ ឬ ច្បាប់ រដ្ឋ ទាំងឡាយ ណា ដែល ផ្ទុយ ពី រដ្ឋធម្មនុញ្ញ ។ តួនាទី ជា អ្នក ត្រួតពិនិត្យ ច្បាប់ ចុងក្រោយ នៃ រដ្ឋធម្មនុញ្ញ គឺជា មុខងារ មួយ យ៉ាង សំខាន់ របស់ តុលាការ កំពូល ។
៤៖ ទំនាក់ទំនង អន្តរជាតិ ចាប់តាំងពី ទទួល ឯករាជ្យ នៅ ឆ្នាំ ១៩៤៧មក ឥណ្ឌា បាន ថែរក្សា ចំណង មិត្តភាព ជាមួយ ប្រជាជាតិ ជាច្រើន ។ នៅ ទសវត្ស ឆ្នាំ ១៩៥០ ឥណ្ឌា បាន ចាប់ យក តួនាទី ជា អ្នកដឹកនាំ ការគាំទ្រ ដល់ ការទាមទារ ឯករាជ្យ នៃ បណ្ដា អាណានិគម អឺរ៉ុប នៅ ទ្វីប អាស៉ី និង អាហ្វ្រិក ។
ក្រោយពី សង្គ្រាម រវាង ចិន - ឥណ្ឌា និង ឥណ្ឌា - ប៉ាគីស្ថាន នៅ ឆ្នាំ ១៩៦៥ មក ទំនាក់ទំនង យ៉ាង ជិតស្និទ្ធ រវាង ឥណ្ឌា និង សហភាព សូវៀត បាន ធ្វើឲ្យ ឥណ្ឌា បាត់បង់ នូវ ទំនាក់ទំនង ជាមួយ សហរដ្ឋ អាមេរិក ហើយ បាន បន្ត សភាព បែប នេះ រហូតដល់ ការបញ្ចប់ នូវ សង្គ្រាម ត្រជាក់ ។ ឥណ្ឌា បាន ធ្វើ សង្គ្រាម ៤ដង ជាមួយ ប៉ាគីស្ថាន ដែល បញ្ហា ចម្បង គឺ ជម្លោះ ដណ្ដើម ដែនដីកា ស្មៀរ ។ ឥណ្ឌា បាន ឈ្នះ សង្គ្រាម ជាមួយ ប៉ាគីស្ថាន នៅ ឆ្នាំ ១៩៧១ ដោយ ឥណ្ឌា បាន ជួយ គាំទ្រ ដល់ ចលនា រំដោះ ជាតិ បង់ក្លាដេស ( អតីត ប្រទេស ប៉ាគីស្ថាន ខាងកើត ) ។
ឥណ្ឌា គឺជា សមាជិក និង ជា អ្នក ទ្រទ្រង់ ដ៏ យូរ លង់ នៃ អង្គការ សហ ប្រជាជាតិ (UN) នៅក្នុង ប្រតិបត្តិការ ថែរក្សា សន្តិភាព ចំនួន ៣៥ ទូទាំង ទ្វីប ទាំង ៤។ គំនិត ដែល ផ្ដួច ផ្ដើម ដោយ មេដឹកនាំ ឥណ្ឌា បាន បង្កើត ឲ្យ មាន ឡើងវិញ នូវ ទំនាក់ទំនង រវាង សហរដ្ឋ អាមេរិក និង ប៉ាគីស្ថាន ។ នៅក្នុង វិស័យ សេដ្ឋកិច្ច វិញ ឥណ្ឌា បាន បង្កើត ឲ្យ មាន ទំនាក់ទំនង យ៉ាង ជិតស្និទ្ធ ជាមួយ បណ្ដា ប្រទេស កំពុង អភិវឌ្ឍន៍ នានា នៅ អាមេរិក ខាងត្បូង អាស៉ី និង អាហ្វ្រិក ៕
៥៖ ចំណុច គួរ កត់សម្គាល់ យោង តាម សៀវភៅ របស់ ក្រសួង អប់រំ ស្តីពី ប្រទេស ឥណ្ឌា ក្នុង មជ្ឈិម សម័យ បោះពុម្ភ នៅ ឆ្នាំ ២០២០ បាន ឲ្យដឹង ថា ផ្នែក វិទ្យាសាស្ត្រ វិញ ប្រទេស នេះ ក៏ បាន កសាង សមិទ្ធិ ធំ ៗ និង មាន របកគំហើយ ជាច្រើន ជាពិសេស ផ្នែក តារាវិទ្យា គណិតវិទ្យា គីមី និង រូបវិទ្យា ។
ប្រទេស ឥណ្ឌា បាន ក្លាយជា មហាអំណាច នុយក្លេអ៊ែរ នៅ ឆ្នាំ ១៩៧៤ មក ម្ល៉េះ បន្ទាប់ពី សាកល្បង ជា លើក ដំបូង ដោយ ពុំ មាន ប្រកាស ជាសាធារណៈ ទេ រហូតដល់ ១៩៩៨ ទើប សាកល្បង អាវុធ នុយក្លេអ៊ែរ ម្តង ទៀត និង ប្រកាស ជា សធារណៈ នូវ អំណាច សក្តានុពល របស់ នុយក្លេអ៊ែរ ខ្លួន តែម្តង ។
យោង តាម ប្រភព ពី Investopedia បាន ឲ្យដឹង ថា គិត ត្រឹម ឆ្នាំ ២០២០ ប្រទេស ឥណ្ឌា ក៏ បាន ក្លាយជា មហាអំណាច សេដ្ឋកិច្ច ជាប់ ចំណាត់ថ្នាក់ ទី៥ ក្នុង ចំណោម បណ្តា ប្រទេស អ្នក មាន លើ ពិភពលោក ។ វិស័យ សុខាភិបាល វិញ មាន ការរីកចម្រើន គួរឲ្យ សរសើរ ផងដែរ ប៉ុន្តែ គួរឲ្យ ស្តាយ ថា អំឡុង ពេល មាន វិបត្តិ កូវីដ១៩ នេះ ឥណ្ឌា មិន អាច ការពារ ប្រជាជន ខ្លួន បាន សូម្បីតែ អុក ស៉ី ហ្សែន ក៏ មិន មាន គ្រប់គ្រាន់ ទៀត ធ្វើឲ្យ មាន អ្នកស្លាប់ ជា បន្តបន្ទាប់ ។
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា ហេង លី និង លោកជំទាវ ភី សាង ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
លោក ឧកញ៉ា ហេង លី និង លោកជំទាវ ភី សាង កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក លោក ឧកញ៉ា ហេង លី និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម នាយ ឧត្តម នាវី ទៀ វិញ ឧបត្ថម្ភ ថវិកា ២០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
ឯកឧត្តម នាយ ឧត្តម នាវី ទៀ វិញ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក ឯកឧត្តម នាយ ឧត្តម នាវី ទៀ វិញ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អភិបាល ខេត្ត កណ្ដាល ថ្លែងអំណរគុណ លោក ឧកញ៉ា ឈុន អូន អគ្គ នាយក ក្រុមហ៊ុន កម្ពុជា តេលា ដែល បាន ឧបត្ថម្ភ ស្បៀងអាហារ និង គ្រឿង ឧបភោគ បរិភោគ ដល់ រដ្ឋបាល ខេត្ត សម្រាប់ ចែកជូន ពលរដ្ឋ
( ភ្នំពេញ ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ ជូន លោក ឧកញ៉ា ឈុន អូន អគ្គ នាយក ក្រុមហ៊ុន កម្ពុជា តេលា ដែល បាន ឧបត្ថម្ភ ស្បៀងអាហារ និង គ្រឿង ឧបភោគ បរិភោគ ជូន ដល់ រដ្ឋបាល ខេត្ដ កណ្ដាល ដើម្បី ជួយ ឧបត្ថម្ភ ជីវភាព ជូន ប្រជាពលរដ្ឋ ដែល ទទួលរងគ្រោះ ឬ រង ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ពី មេរោគ កូវីដ១៩ ។
អភិបាល ខេត្ត កណ្ដាល បាន បញ្ជាក់ ថា កាយវិការ និង ទឹកចិត្ត ដ៏ សប្បុរស នេះ បាន ឆ្លុះបញ្ចាំង ពី គុណធម៌ និង វប្បធម៌ ចែករំលែក គឺ ការចេះ ជួយ គ្នា ក្នុង គ្រា លំបាក កាយវិការ ដ៏ ប្រពៃ នេះ ត្រូវបាន ប្រជាពលរដ្ឋ ចង់ចាំ ទុក ក្នុង ដួងចិត្ត សាមគ្គីភាព ជាតិ ខ្មែរ ។
ប្រតិបត្តិការ បង្ក្រាប នេះ បាន ធ្វើឡើង កាលពី ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២១ កន្លងទៅ ក្រោម ការដឹកនាំ និង សម្របសម្រួល ពី លោក សាយ ណូរ៉ា ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។ ទីតាំង ស្តុក ខោ ទឹកនោម ក្លែងក្លាយ នេះ ស្ថិត នៅ ផ្ទះល្វែង ភូមិ ព្រែក តាឡុង សង្កាត់ ចាក់អង្រែ ក្រោម ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។
ជាមួយនឹង ការរឹបអូស ផលិតផល ក្លែងក្លាយ នេះ សមត្ថកិច្ច ក៏ បាន ឈាន ទៅដល់ ការតាម សាកសួរ និង ឃាត់ខ្លួន ឈ្មោះ ឆ ឡៃ ហ៊ុយ ដែល ជា ម្ចាស់ ផលិតផល ក្លែង បន្លំ ម៉ាក ដែល មាន ទីតាំង ស្តុក ឥវ៉ាន់ ខាងលើ និង មាន អសយដ្ឋាន បច្ចុប្បន្ន ស្នាក់ នៅ ផ្ទះ លេខ ៤១E0 ផ្លូវ ១៩៨ សង្កាត់ បឹង ព្រលិត ខណ្ឌ ៧មករា ផងដែរ ប៉ុន្តែ ពុំ បាន ជួប សាមីខ្លួន ផ្ទាល់ នៅ ពេល នោះ ទេ ។
លុះ ដល់ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ ឈ្មោះ ឆ ឡៃ ហ៊ុយ បាន ចូលខ្លួន ជួប សមត្ថកិច្ច ហើយ បាន ឆ្លើយ សារភាព ថា ខ្លួន បាន ផ្សំ គំនិត ទិញ ទំនិញ នេះ ពី ឈ្មោះ ទិត្យ ពី រ៉េវ ភេទ ប្រុស ដែល មាន អស័យដ្ឋាន នៅ ភូមិ វាល ឃុំ សាន់គរ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ដែល ជា ជន ទាក់ទង យក ខោ ទឹកនោម នេះ ពី ប្រទេស ចិន ។ បច្ចុប្បន្ន ជន ចែកចាយ ផលិតផល ក្លែងក្លាយ ទាំង ពីរ និង វត្ថុតាង ដែល បាន ចាប់ យក ខាងលើ កំពុង ស្ថិត នៅក្នុង ដៃ របស់ គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ ។
រហូតមកដល់ ថ្ងៃទី ០៦ ខែឧសភា ជនសង្ស័យ ក្លែង បន្លំ ផលិតផល នាំឱ្យ ប៉ះពាល់ ដល់ សុខភាព ក្មេង ទាំង ពីរ នាក់ នេះ មិន ទាន់ មាន ចំណាត់ការ ផ្លូវ ច្បាប់ ណាមួយ នៅឡើយ ទេ ។
ជាមួយនឹង ការបង្ក្រាប ផលិតផល ក្លែងក្លាយ នេះ ក្រុមហ៊ុន វិន ស៊ុន ( ខេមបូឌា ) ខូ អិលធីឌី ដែល ជា ម្ចាស់ ម៉ាក Unidry ស្រប ច្បាប់ នោះ បាន ស្នើ ឱ្យ សមត្ថកិច្ច កម្ពុជា ចាត់ការ ទៅតាម ច្បាប់ ចំពោះ ករណី ក្លែងបន្លំ ផលិតផល របស់ ខ្លួន ។ ដោយ ការក្លែងបន្លំ ផលិតផល នេះ ធ្វើឱ្យ ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ ដល់ កេរ្តិ៍ឈ្មោះ ក្រុមហ៊ុន ក៏ដូចជា ផលិតផល និង ជាពិសេស វា អាច បង្ករ ជា ហានិភ័យ គ្រោះថ្នាក់ ដល់ អ្នកប្រើប្រាស់ ថែម ទៀត ផង ។
ក្រុមហ៊ុន វិន ស៊ុន ដែល ជា ម្ចាស់ កម្មសិទ្ធិ បញ្ញា ផលិតផល ខោ ទឹកនោម ម៉ាក «Unidry» សូម អំពាវនាវ ដល់ អតិថិជន ទាំងអស់ សូម មេត្តា ពិនិត្យ ឱ្យ បាន ច្បាស់លាស់ មុននឹង ជា វផលិត ដើម្បី ចៀស ផុត ពី ការជាវ ប៉ះ ផលិតផល ក្លែងក្លាយ ដែល អាច បង្ក ផល ប៉ះពាល់ ដល់ សុខភាព កូន របស់ លោក អ្នក ។ សូម ពិនិត្យភាពខុសគ្នា រវាង ផលិតផល ពិត និង ផលិតផល ក្លែងក្លាយ តាមរយៈ រូប បង្ហាញ នៅ ខាងក្រោម ។
ក្រុមហ៊ុន បាន សូម អរគុណ ដល់ អតិថិជន ទាំងអស់ ដែល តែងតែ គាំទ្រ និង សូម បន្ត ការគាំទ្រ តទៅទៀត ដោយ ក្រុមហ៊ុន សូម សន្យា ថា នឹង ខិតខំ ឱ្យ អស់ ពី កម្លាំង កាយ ចិត្ត ដើម្បី ត្រួតពិនិត្យ បន្ត ការ ការពារ ដល់ អ្នកប្រើប្រាស់ របស់ យើង ដោយ ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ចំពោះ ជន ណា ដែល ក្លែងបន្លំ ផលិតផល ទាំង ពេលនេះ និង ពេល អនាគត ផងដែរ ៕
ឯកឧត្តម ឃួង ស្រេង ថ្លែងអំណរគុណ អ្នក ឧកញ៉ា លាង ឃុន និង លោកជំទាវ ដែល បាន ឧបត្ថម្ភ ថវិកា ៥៣ ម៉ឺន ដុល្លារ ដល់ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ អ្នក ឧកញ៉ា លាង ឃុន អនុប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ និង លោកជំទាវ បាន ជួយ ឧបត្ថម្ភ ថវិកា ចំនួន ៥៣០.០០០ ដុល្លារ អាមេរិក ។
សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ នឹង យកចិត្តទុកដាក់ ប្រើប្រាស់ អំណោយដ៍ សប្បុរស នេះ ដើម្បី បម្រើ សកម្មភាព មនុស្សធម៌ ជួយ ដល់ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ដោយ គ្រោះ មហន្តរាយ ផ្សេង ។
សូម ជូនពរ បវរ សួស្តី មហា ប្រសើរ និង ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ខាងក្រោម នេះ ជា លិខិត ថ្លែងអំណរគុណ របស់ អភិបាល រាជធានី ភ្នំពេញ៖ លោក គឹម សន្តិភាព នាំយក អំណោយ សប្បុរសជន ក្នុង និង ក្រៅ ប្រទេស ប្រគល់ ជូន អភិបាល រាជធានី ភ្នំពេញ និង សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ (TYDA)
អភិបាល ខណ្ឌ ឫស្សីកែវ ថ្លែងអំណរគុណ ឧកញ៉ា លីអៀវ ដែល ចែក គ្រឿង ឧបភោគ បរិភោគ ដល់ ពលរដ្ឋ តំបន់ លឿង ទុំ ៥០០ គ្រួសារ នៅ ភូមិ ផ្សារ តូច សង្កាត់ ទួល សង្កែ ១
ពិធី ប្រគល់ និង ទទួល អំណោយ បាន ប្រព្រឹត្តទៅ ក្រោម វត្តមាន លោក ជា ពិសី អភិបាល ខណ្ឌ ឫស្សីកែវ នា បរិវេណ សាលា បឋមសិក្សា ពញា ក្រែក ។ ប្រជាពលរដ្ឋ ទាំង ៥០០ គ្រួសារ ដែល ទទួលបាន ការឧបត្ថម្ភ គ្រឿង ឧបភោគ បរិភោគ នោះ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ២០ គីឡូក្រាម . ទឹកត្រី ១យួរ . ទឹក ស៉ី អ៉ីវ ១យួរ . ត្រីខ ៥កំប៉ុង . សាច់ក្រក ១គីឡូក្រាម . និង ត្រសក់ ១ថង់ ។
ក្នុង ឱកាស នោះ លោក ជា ពិសី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ ក្រុមហ៊ុន ហុង ថុង អិច ប្រេស ដែល បាន ជួយ ឧបត្ថម្ភ នូវ អំណោយ ជូន ប្រជាពលរដ្ឋ ក្នុង តំបន់ ក្រហម នៅ មូលដ្ឋាន នេះ សម្រាប់ ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
ជំនួស មុខ ដល់ ប្រជាពលរដ្ឋ ដែល ទទួល អំណោយ អភិបាល ខណ្ឌ ឫស្សីកែវ ថែមទាំង បាន កោតសរសើរ ដោយ ស្មោះ ចំពោះ ទឹកចិត្ត ដ៏ សប្បុរសធម៌ និង មនសិការ ស្នេហាជាតិ របស់ ឧកញ៉ា លី អៀវ និង គ្រួសារ ដែល ជួយ សម្រាល បន្ទុក របស់ រាជ រដ្ឋាភិបាល គ្រប់ កាលៈទេសៈ បាន យ៉ាង ទាន់ ពេល វេលា ។
ឧកញ៉ា លី អៀវ បាន ថ្លែង ថា អំឡុង ពេល កម្ពុជា កំពុង ជួបប្រទះ បញ្ហា រីករាលដាល កូវីដ១៩ នេះ ជា កាលៈទេសៈ មួយ ដែល គ្រប់ ភាគី ទាំងអស់ ត្រូវតែ សហការ ជាមួយ រាជ រដ្ឋាភិបាល ដែល សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ក្នុង ការទប់ទល់ ស្ថាន ការ ដ៏ តានតឹង មួយ នេះ ឲ្យបាន ប្រសើរ ឡើងវិញ ។ ជាក់ស្តែង ការឧបត្ថម្ភ អំណោយ ដល់ ប្រជាពលរដ្ឋ ពេលនេះ គឺជា ការបង្ហាញ ពី ទឹកចិត្ត ស្រឡាញ់ ជាតិ និង មាតុភូមិ ក៏ ដូចជា ចង់ឲ្យ ប្រទេសជាតិ ទាំងមូល រីកចម្រើន ទៅ មុខ ជានិច្ច ។
ឧកញ៉ា លី អៀវ ក៏ បាន កោតសរសើរ ចំពោះ ការលះបង់ ពេលវេលា ផ្ទាល់ខ្លួន ដ៏ មាន តម្លៃ របស់ កងកម្លាំង មន្ត្រីរាជការ ស៉ី វិល និង ការលះបង់ របស់ ប្រជាពលរដ្ឋ ដទៃ ទៀត ដែល តែងតែ ជួយ គាំទ្រ សកម្មភាព ប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ ជាមួយ រាជ រដ្ឋាភិបាល ជាពិសេស សម្រាប់ ជួយ ប្រទេសជាតិ ទាំងមូល ៕
បទ អត្ថាធិប្បាយ៖ ជំងឺ កូវីដ១៩ បាន រីករាលដាល យ៉ាង ធ្ងន់ធ្ងរ ជាថ្មី ម្តង ទៀត ត្រូវ បើក « ច្រក រហ័ស » ឱ្យ វ៉ាក់សាំង កូវីដ១៩ របស់ ចិន ជាបន្ទាន់
( ប៉េកាំង ) ៖ ក្នុង សភាពការណ៍ ដែល ឥណ្ឌា មិន អាច បង្ការ និង គ្រប់គ្រង ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ និង នៅ ទូទាំង ពិភពលោក បាន ផ្ទុះ ជំងឺ កូវីដ១៩ ជាថ្មី ម្តង ទៀត អង្គការ សុខភាព ពិភពលោក ប៉ាន់ប្រមាណ ថា នឹង ប្រកាស លទ្ធផល វាយតម្លៃ ចំពោះ ការប្រើប្រាស់ ជាបន្ទាន់ នៃ វ៉ាក់សាំង ជំងឺ កូវីដ១៩ ពីរ ប្រភេទ របស់ ចិន គឺ វ៉ាក់សាំង ជំងឺ កូវីដ១៩ នៃ ក្រុមហ៊ុន SINOPHARM និង វ៉ាក់សាំង ជំងឺ កូវីដ១៩ នៃ ក្រុមហ៊ុន Sinovac ក្នុង សប្តាហ៍ នេះ ដំណឹង នេះ ធ្វើឱ្យ ពិភពលោក រំភើបចិត្ត ណាស់ ។
កាលពី ថ្ងៃទី ២៩ ខែមេសា ក្រុម អ្នកជំនាញ ផ្តល់ យោបល់ ជា យុទ្ធសាស្ត្រ លើ វិស័យ ស៊ាំ នឹង រោគ ដែល នឹង ផ្តល់ សេចក្តីស្នើ ដល់ អង្គការ សុខភាព ពិភពលោក បាន ប្រកាស របាយការណ៍ វាយតម្លៃ ចំពោះ វ៉ាក់សាំង ជំងឺ កូវីដ១៩ ពីរ ប្រភេទ នេះ ដែល បាន ធ្វើ សន្និដ្ឋាន ដោយ គ្រប់ ជ្រុងជ្រោយ ពី សុវត្ថិភាព និង ប្រសិទ្ធភាព នៃ ការចាក់ វ៉ាក់សាំង ជំងឺ កូវីដ១៩ ទាំង ពីរ នេះ លើ មនុស្ស ពេញ វ័យ ។
តាម របាយការណ៍ វាយតម្លៃ ដែល ក្រុម ជំនាញ នេះ បាន ប្រកាស នោះ ឱ្យដឹង ថា និយាយ ចំពោះ មនុស្ស ពេញ វ័យ ដែល មាន អាយុ ពី ១៨ដល់ ៥៩ ឆ្នាំ ដែល បាន ចាក់ វ៉ាក់សាំង ពីរ ដូស នៃ ក្រុមហ៊ុន SINOPHARM ក្រុម ជំនាញ មាន ជំនឿចិត្ត កម្រិត ខ្ពស់ ចំពោះ ប្រសិទ្ធភាព នៃ ការបង្ការ ជំងឺ កូវីដ១៩ ហើយ មាន ជំនឿចិត្ត កម្រិត មធ្យម ចំពោះ ហានិភ័យ ទាប ដែល កើត ប្រតិកម្ម អវិជ្ជមាន ដ៏ ធ្ងន់ធ្ងរ បន្ទាប់ពី ចាក់ វ៉ាក់សាំង នេះ ។
បច្ចុប្បន្ន នេះ ការផ្គត់ផ្គង់ វ៉ាក់សាំង ជំងឺ កូវីដ១៩ នៅ ទូទាំង ពិភពលោក បាន ធ្លាក់ ចូល ក្នុង ភាពគាំង ដំណើរ ។ តាម ការប៉ាន់ប្រមាណ កាលពី មុន “ ផែនការអនុវត្ត វ៉ាក់សាំង ជំងឺ កូវីដ១៩ ” ដែល ដឹកនាំ ដោយ អង្គការ សុខភាព ពិភពលោក នឹង ប្រគល់ វ៉ាក់សាំង ចំនួន ២ពាន់ លាន ដូស ដល់ ទូទាំង ពិភពលោក ក្នុង ឆ្នាំ នេះ ប៉ុន្តែ បច្ចុប្បន្ន នេះ ត្រឹមតែ ដឹកជញ្ជូន ប្រហែល ៥០លាន ដូស ប៉ុណ្ណោះ ។ ជាង នេះ ទៅ ទៀត ដោយសារ ឥណ្ឌា បាន ផ្ទុះ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ជាថ្មី ម្តង ទៀត ដូច្នេះ ឥណ្ឌា បាន បញ្ឈប់ នាំចេញ វ៉ាក់សាំង ហើយ ។
អ្នកជំនាញ ខាង មេរោគ មួយ រូប នៃ ក្រុម អ្នកជំនាញ ផ្តល់ យោបល់ ជា យុទ្ធសាស្ត្រ លើ វិស័យ ស៊ាំ នឹង រោគ នៅ បាន អំពាវនាវ ថា ពិភពលោក ត្រូវការវ៉ាក់សាំង របស់ ចិន ជាបន្ទាន់ ។
សូម ជម្រាប ថា គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ១៧. ៦២១ នាក់ ក្នុង នោះ អ្នក ជាសះស្បើយ ៦៨៤៣ នាក់ និង ស្លាប់ សរុប ចំនួ១១៤ នាក់ ៕ CSX: ទំហំ ការជួញដូរ លើ ទីផ្សារ មូលបត្រ កើនឡើង គួរឲ្យ កត់សម្គាល់ ក្នុង អំឡុង ពេល នៃ ការបិទ ខ្ទប់
យោង តាម សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ ថា ទោះ ស្ថិត ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ដែល បណ្តាលឱ្យ មាន ការបិទ ខ្ទប់ តំបន់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ក្តី តែ ក្រុមហ៊ុន ផ្សារ មូលបត្រ កម្ពុជា នៅ បន្ត ប្រតិបត្តិការ យ៉ាង រលូន និង គ្មាន បញ្ហា មិន ត្រឹមតែ ប៉ុណ្ណោះ សកម្មភាព ជួញដូរ កើនឡើង គួរឱ្យ កត់សម្គាល់ ។
លោក បន្ថែម ថា នេះ បង្ហាញ យ៉ាង ច្បាស់ ពី ចំណុច ពិសេស នៃ ការវិនិយោគ ក្នុង ទីផ្សារ ភាគហ៊ុន សម្រាប់ ប្រជាជន ទូទៅ ដែល ពួកគាត់ អាច ក្លាយជា ម្ចាស់ ហ៊ុន នៃ ក្រុមហ៊ុន ល្អ ៗ ជាច្រើន ដោយ មិន បាច់ ចំណាយ ពេល ខ្លួន ឯង ដើម្បី បង្កើត អាជីវកម្ម ។
( ភ្នំពេញ ) ៖ អង្ករ ចំនួន ៥០តោន រួម និង ថវិកា ចំនួន ៥ម៉ឺន ដុល្លារ អាមេរិក ត្រូវបាន លោក លី យ៉ែន អគ្គ នាយក ក្រុមហ៊ុន ជីង ហ្គាគង់ ហ្គូ តាមរយៈ បញ្ជាការដ្ឋាន អង្គរក្ស សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នាំយក ទៅ ប្រគល់ ជូន នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ នា ព្រឹក ថ្ងៃទី ៦ ឧសភា ឆ្នាំ ២០២១ នេះ នៅ អគ្គ បញ្ជាការដ្ឋាន ។
នៅក្នុង ឱកាស ទទួល អំណោយ នោះ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន ថ្លែងអំណរគុណ ចំពោះ លោក លី យ៉ែន អគ្គ នាយក ក្រុមហ៊ុន ជីង ហ្គាគង់ ហ្គូ ដែល បាន ផ្ដល់ អង្ករ និង ថវិកា នា ពេលនេះ សម្រាប់ ជា ប្រយោជន៍ ផ្តល់ ជូន ប្រជាពលរដ្ឋ ដែល កំពុង ធ្វើចត្តាឡី ស័ក និង ត្រូវការ ជំនួយ ។
ជាមួយ នេះ តាមរយៈ ឧត្តមសេនីយ៍ ឯក ណុប រ័ត្ន និមល មេបញ្ជាការ រង បញ្ជាការដ្ឋាន អង្គរក្ស នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ នាយ ឧត្តមសេនីយ៍ ហ៉ីង ប៊ុន ហៀង អគ្គ មេបញ្ជាការ រង និង ជា មេបញ្ជាការបញ្ជាការដ្ឋាន អង្គរក្ស សម្ដេច តេជោ ដែល បាន ខិតខំ ស្វែងរក ជំនួយ ពី សប្បុរសជន នានា ដើម្បី ជួយ គាំទ្រ ដល់ រាជ រដ្ឋាភិបាល ដែល កំពុង ប្រឈម ជំងឺ រាតត្បាត កូវីដ - ១៩៕ អភិបាល ខណ្ឌ ឫស្សីកែវ បន្ត យក ស្បៀងអាហារ ចែក ពលរដ្ឋ ៥០០ គ្រួសារ ទៀត ដើម្បី ដោះស្រាយ ជីវភាព ក្នុង « តំបន់ លឿង ទុំ »
សកម្មភាព សមធម៌ នេះ លោក ជា ពិសី បាន ឆ្លៀត ឱកាស អំពាវនាវ ឱ្យ អាជ្ញាធរ និង មន្ត្រី ពាក់ព័ន្ធ ទាំងអស់ បន្ត ស្រាវជ្រាវ រិះរក គ្រប់ មធ្យោបាយ ដោយ មិន ឱ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ និង អត់ ស្បៀងអាហារ ឫ អត់ បាយ ដោយ មិន បាន ដឹង ពី មូលហេតុ នោះ ទេ ក្រោយពី រាជ រដ្ឋាភិបាល សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា សម្រេច បិទ ខ្ទប់ និង កំណត់ ជា « តំបន់ ក្រហម » « តំបន់ លឿង » និង « តំបន់ លឿង ទុំ » ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
បន្ថែម ពី នេះ លោក ជា ពិសី បាន អំពាវនាវ ប្រជាពលរដ្ឋ ឱ្យ ធ្វើ អនាម័យ ឲ្យបាន ខ្ជាប់ខ្ជួន ជានិច្ច ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ឆ្លង ជំងឺ កូវីដ១៩ តាមរយៈ ការអនុវត្ត វិធានការ « ៣ការពារ និង ៣កុំ » របស់ ក្រសួង សុខាភិបាល ដែល ជា សារ ដឹកនាំ ផ្ដាំផ្ញើ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
តាមរយៈ បណ្តាញ សង្គម ហ្វេសបុក សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ប្រាប់ ជន រួម ជាតិ យ៉ាង ដូច្នេះ ថា៖ « ថ្ងៃ នេះ ខ្ញុំ បញ្ចប់ ការធ្វើចត្តា ឡីស ក័ រយះពេល ១៤ ថ្ងៃ បន្ទាប់ពី គ្រូពេទ្យ យក សំណាក ទៅ ពិនិត្យ និង បញ្ជាក់ ថា ខ្ញុំ ពុំ មាន កូវីដ១៩ នោះ ទេ » ។
សម្តេច បាន បន្ត ថា « មុន ទៅ ឥណ្ឌូនេសុី និង ក្រោយ ត្រឡប់ មកវិញ ខ្ញុំ ត្រូវ ធ្វើតេស្ត រហូត ៤ដង និង ត្រូវ រស់ នៅ ម្នាក់ឯង រយៈពេល ១៤ ថ្ងៃ ដែល នេះ ជា វិធានការ សុខាភិបាល ដែល គ្រប់ គ្នា ត្រូវតែ គោរព » ។
រដ្ឋមន្ដ្រី វេង សាខុន បន្ដ នាំយក អង្ករ១០តោន . មី ១៥០ កេស ត្រីខ ១៥០ កេស និង ថវិកា ១០លាន រៀល ប្រគល់ ជូន អភិបាល ស្រុក តំបែរ ខេត្ត ត្បូងឃ្មុំ
ទទួលបាន អំណោយ នេះ លោក សុខ សារិទ្ធ អភិបាល ស្រុក បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ លោក ប្រធាន ក្រុមការងារ លោកស្រី លោក អនុប្រធាន ក្រុមការងារ និង សមាជិក សមាជិកា ចុះ មូលដ្ឋាន ស្រុក តំបែរ ទាំងអស់ ចំពោះ កាយវិការ ដ៏ ប្រពៃ គិតគូ យកចិត្តទុកដាក់ ដោះស្រាយ បញ្ហា ជីវភាព ជូន បងប្អូន ប្រជាពលរដ្ឋ បាន ទាន់ ពេលវេលា ស្រម ពេល ដែល ស្ថានភាព នៃ ការរីករាលដាល នៃ ជំងឺ ឆ្លង កូវីដ - ១៩ បាន និង កំពុង បន្ត ។
លោក ថា នឹង នាំយក អំណោយ នេះ ទៅ ចែកជូន បងប្អូន ប្រជាពលរដ្ឋ ដែល កំពុង ធ្វើចត្តាឡី ស័ក ទាំង ៨កន្លែង នៅ ទូទាំង ស្រុក សរុប ចំនួន ១០៧ ក្នុង នោះ មាន ស្រ្តី ៤៣ នាក់ ឲ្យបាន ទាន់ ពេល ។
ក្នុង ឱកាស នេះ ផងដែរ លោក បាន ស្នើសុំ ឲ្យ លោក អភិបាល នៃ គណអភិបាល ស្រុក សមត្ថកិច្ច ពាក់ព័ន្ធ គ្រប់ ជាន់ ថ្នាក់ មន្ទីរពេទ្យ បង្អែក លោកគ្រូ អ្នកគ្រូពេទ្យ ត្រូវ បន្ត យកចិត្តទុកដាក់ មើល ថែរក្សា ការពារ សុខភាព ជូន បងប្អូន ប្រជាពលរដ្ឋ និង ជាពិសេស អនុវត្ត ឲ្យ ខាងតែ បាន នូវ វិធានការ របស់ រាជ រដ្ឋាភិបាល និង ក្រសួង សុខាភិបាល ហើយ ត្រូវ អនុវត្ត វិធានការ ៣ការពារ និង ៣កុំ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល់ ជំងឺ ដ៏ កាច សាហាវ នេះ ។
យល់ ពី ស្ថានភាព ដ៏ លំបាក នា ពេលនេះ លោក ប្រធាន ក្រុមការងារ បាន ជួយ ឧបត្តម្ភ ថវិកា ដល់ លោក អភិបាល ស្រុក ២លាន រៀល បន្ថែម ទៀត មន្ទីរពេទ្យ បង្អែក ស្រុក ៣លាន រៀល គណកម្មការបក្ស ស្រុក ២លាន រៀល សម្រាប់ យក ទៅ ប្រើប្រាស់ តាម ការចាំបាច់ ដើម្បី ជួយ សម្រាល នូវ បញ្ហា ជីវភាព របស់ បងប្អូន ដែល កំពុង ធ្វើចត្តាឡី ស័ក នៅ មណ្ឌល ទាំង ៨៕
ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ប្រកាស បើក ដំណើរការ ឡើងវិញ មណ្ឌល ផ្តល់ សេវា សាធារណៈ ទាំងអស់
( ភ្នំពេញ ) ៖ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នៅ ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស បើក ដំណើរការ ឡើងវិញ ហើយ សម្រាប់ មណ្ឌល ផ្តល់ សេវា សាធារណៈ ទាំងអស់ របស់ ក្រសួង ។
ប្រជាពលរដ្ឋ ទាំងអស់ ដែល នៅ តាម តំបន់ ដែល រាជ រដ្ឋាភិបាល បើក ឱ្យ ធ្វើចរ រាចរណ៍ ឡើងវិញ អាច ទៅ ទទួលយក ការផ្តល់ សេវា សាធារណៈ របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ហើយ ដែល មាន ដូច ជា៖ មណ្ឌល ផ្តល់ សេវា សាធារណៈ នៅ ទីស្តីការ ក្រសួង . មណ្ឌល ផ្តល់ សេវា សាធារណៈ ផ្សារ ទំនើប ជីប ម៉ុង ណូរ៉ូមល . មណ្ឌល ផ្តល់ បណ្ណ បើកបរ ទីតាំង ផ្សារ ទំនើប អ៊ីអន១ និង អ៊ីអន២ និង អាច ទៅ ទទួល សេវា មណ្ឌល ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានយន្ត គ្រប់ ទីតាំង ។
ជាមួយគ្នា នោះ ក្រសួង សាធារណការ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ គោរព គោលការណ៍ ៣កុំ ៣ការពារ របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង សុខាភិបាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ៕
រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ សម្រេច បិទ ខ្ទប់ ភូមិ ចំនួន ២ នៅ ឃុំ សេដា ស្រុក តំបែរ ក្រោយ មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩
ក្នុង សេចក្ដីសម្រេច នេះ បាន កំណត់ ថា ទីតាំង ភូមិ ទាំង២ ខាងលើ នេះ ត្រូវ បិទ ខ្ទប់ បណ្ដោះអាសន្ន រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៥ ខែឧសភា ដល់ ថ្ងៃទី ១៨ ខែឧសភា ឆ្នាំ ២០២១ ។
ខាងក្រោម នេះ ជា សេចក្ដីសម្រេច របស់ រដ្ឋបាល ខេត្ត ត្បូង ឃ្មុំ៖ ក្រសួង សុខាភិបាល ប្រាប់ ឲ្យ ក្រុមហ៊ុន ចង់ ចុះបញ្ជិ កា ឧបករណ៍ តេស្តរហ័ស រក ជំងឺ កូវីដ១៩ (Rapid Test) ត្រូវ គោរព តាម បច្ចេកទេស និង ច្បាប់ គ្រប់គ្រង ឱសថ
ប្រតិករ ទាំង ពីរ នេះ មាន ការអនុញ្ញាតឲ្យ ប្រើប្រាស់ ពី គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ បន្ទាប់ពី បាន ឆ្លងកាត់ ការសាកល្បង និង វាយតំលៃ របស់ មន្ទីរពិសោធន៍ នៃ វិទ្យាស្ថាន សុខភាព សាធារណៈ និង វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា ហើយ ក្រសួង សុខាភិបាល បាន កំពុង ប្រើប្រាស់ ក្នុង ពេល បច្ចុប្បន្ន ៕ BREAKING: រដ្ឋបាល ខេត្ត កំពង់ចាម រកឃើញ ករណី វិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ៣នាក់ នៅ ស្រុក ចំការលើ និង ស្រុក កោះ សូទិន
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការរកឃើញ ករណី វិជ្ជមាន កូវីដ១៩ លើ ប្រជាពលរដ្ឋ ៣នាក់ ដែល រស់ នៅ ស្រុក ចំការលើ និង ស្រុក កោះ សូទិន ។
រដ្ឋបាល ខេត្ត កំពង់ចាម បាន បញ្ជាក់ ថា នៅ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ នេះ រដ្ឋបាល ខេត្ត កំពង់ចាម បាន ទទួល លទ្ធផល បញ្ជាក់ ពី វិទ្យាស្ថាន សុខភាព សាធារណៈ ពី ករណី វិជ្ជមាន កូវីដ - ១៩ លើ ប្រជាពលរដ្ឋ ចំនួន ៣នាក់ រួម មាន៖
រដ្ឋបាល ខេត្ត កំពង់ចាម បាន ចាត់ ឱ្យ មន្ទីរ សុខាភិបាល នៃ រដ្ឋបាល ខេត្ត បាន បញ្ជូន អ្នកជំងឺ មក សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ខេត្ត កំពង់ចាម និង បន្ត ស្រាវជ្រាវ រក អ្នក ដែល ប៉ះពាល់ ដោយ ផ្ទាល់ និង ដោយ ប្រយោល នឹង ករណី នេះ បន្ថែម ទៀត ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត កំពង់ចាម កំពុង បន្ត ស្វែងរក ទីតាំង និង អ្នក ប៉ះពាល់ ជាមួយ អ្នកជំងឺ បន្ថែម ទៀត និង សូម អំពាវនាវ ដល់ អ្នក ពាក់ព័ន្ធ សូម ទៅ ពិនិត្យ សុខភាព និង យក សំណាក នៅ មន្ទីរពេទ្យ បង្អែក ដែល នៅជិត ផ្ទះ ឬ ត្រូវ រាយការណ៍ ជូន អាជ្ញាធរ មូលដ្ឋាន ជាបន្ទាន់ តាមរយៈ លេខ ទូរស័ព្ទ៖ ០៧០ ៨២៨ ៧៨៨ និង ០១២ ៧៣៦ ៧៥៥ ៕
សមាគម ធនាគារ និង សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង ទៅនឹង ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ សមាគម ធនាគារ នៅ កម្ពុជា និង សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា បាន ប្រគល់ ស្បៀងអាហារ និង សម្ភារៈ ការពារ ជំងឺ កូវីដ - ១៩ ជូន រដ្ឋបាល រាជធានី ភ្នំពេញ ដើម្បី ជួយ ឧបត្ថម្ភ ដល់ ពលរដ្ឋ ក្រីក្រ និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ជាពិសេស ក្នុង អំឡុង ពេល បិទ ខ្ទប់ នៅក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ទីក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល ។
ពិធី ប្រគល់ និង ទទួល នេះ បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ នេះ នៅ សាលា រាជធានី ភ្នំពេញ ក្រោម វត្តមាន លោក ឃួង ស្រេង អភិបាល នៃ គណៈអភិបាល រាជធានី ភ្នំពេញ ។
