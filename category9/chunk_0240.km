សារ សំឡេង នេះ គឺ ផ្ដោត លើ ការណែនាំ ឱ្យ រោងចក្រ សហគ្រាស ក្នុង វិស័យ កាត់ដេរ ទាំងឡាយ ត្រូវ ពិនិត្យ លើ លទ្ធភាព មុន ឱ្យ បាន ត្រឹមត្រូវ ក្នុង ការកំណត់ ឈ្មោះ និង ចំនួន កម្មករ និយោជិត ៥០% ដើម្បី ប្រើប្រាស់ នៅពេល បើក ដំណើរការ ផលិតកម្ម ក្នុង រោងចក្រ សហគ្រាស របស់ ខ្លួន ។ រីឯ ការអនុវត្ត នៅក្នុង ពេល បើក ដំណើរការ រោងចក្រ ឡើងវិញ យ៉ាងណា នោះ គឺ ត្រូវ យោង តាម សេចក្ដីថ្លែងការណ៍ របស់ គណៈកម្មការ ប្រឹក្សា ការងារ ។
សូម ជម្រាប ថា នា ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២១ ក្រសួង ការងារ បាន ចេញ សេចក្ដីថ្លែងការណ៍ របស់ គណៈកម្មការ ប្រឹក្សា ការងារ ដែល បាន បញ្ជាក់ ពី ខ្លឹមសារ ៣ ចំណុច ធំ ៗ ក្នុង នោះ រួម មាន៖
១៖ វិធានការ រដ្ឋបាល នៅពេល មាន ករណី វិជ្ជមាន កូវីដ១៩ នៅ តាម រោងចក្រ សហគ្រាស ។
២៖ កិច្ចព្រមព្រៀង អំពី ការបើក ដំណើរការ សកម្មភាព អាជីវកម្ម ឡើងវិញ របស់ រោងចក្រ សហគ្រាស ក្រោយ បញ្ចប់ ការបិទ ខ្ទប់ ដោយ វិធានការ រដ្ឋបាល ដែល បាន កំណត់ នូវ វិធានការលម្អិត ១២ ចំណុច បន្ថែម ទៀត ។
៣៖ ការចាក់ វ៉ាក់សាំង ជូន កម្មករ និយោជិត ។
ខាងក្រោម នេះ ជា សារ សំឡេង របស់ លោក ហេង សួរ ព្រមទាំង សេចក្ដីថ្លែងការណ៍ របស់ គណៈកម្មការ ប្រឹក្សា ការងា រ៖
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១. ៥៦៥. ២៩២ នាក់ ។
លោក គឹម សន្តិភាព បាន គូសបញ្ជាក់ ថា « ពីព្រោះ អី យើង ឃើញ ថា ភូមិសាស្ត្រ ភ្នំពេញ ក៏ ដូចជា ទីក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល គឺ ជំងឺ កូវីដ១៩ បាន រាលដាល ធ្ងន់ធ្ងរ ដែល ឈាន ទៅដល់ ការអនុវត្ត វិធានការបិទ ខ្ទប់ នេះ ដើម្បី ចៀសវាង នូវ លំហូរ ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង រាជធានី ភ្នំពេញ ក៏ ដូចជា ទីក្រុង តាខ្មៅ ចេញ ទៅ តាម បណ្តា ខេត្ត នានា ដែល នាំ នូវ ហានិភ័យ ទៅដល់ ខេត្ត ដែល ពុំ ទាន់ មាន ស្ថានភាពចម្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង ស្ថានភាព ធ្ងន់ធ្ងរ » ។
លោក គឹម សន្តិភាព បាន បញ្ជាក់ បន្ថែម ថា ដូច្នេះ ប្រសិនបើ មិន មាន វិធានការបិទ ខ្ទប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ទីក្រុង តាខ្មៅ ទាន់ ពេលវេលា ទេ គឺ ចរន្ត មនុស្ស ជាពិសេស ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ កន្លងមក នេះ នឹង ធ្វើឱ្យ មាន គ្រោះមហន្តរាយ ដោយសារ ជំងឺ កូវីដ១៩ សម្រាប់ កម្ពុជា ដូច្នេះ ចំណុច នេះ គឺជា កត្តា មួយ ដែល បាន ផ្តល់ ផល ក្នុង ការអនុវត្ត វិធានការបិទ ខ្ទប់ របស់ រាជ រដ្ឋាភិបាល កន្លងមក នេះ ។
សូម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច ជ្រើស យក វិធានការបន្ដ បិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ហើយ ការកំណត់ បិទ ខ្ទប់ នេះ ត្រឹម ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ នេះ ។ បើ គិត ដល់ ថ្ងៃទី ០៥ ខែឧសភា ការបិទ ខ្ទប់ នេះ មាន រយៈពេល ៣សប្ដាហ៍ ៕
លោក កើត ឆែ អភិបាល រង រាជធានី ភ្នំពេញ តាមរយៈ សន្និសីទ សារព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល តែងតែ ទិញ ទំនិញ តាម អនឡាញ និង ប្រើ សេវា ដឹកជញ្ជូន ទាំងអស់ ត្រូវតែ បង្កើន នូវ ការប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ បំផុត ដើម្បី បង្ការ ការឆ្លង ជំងឺ កូវីដ១៩ ។
អភិបាល រង រាជធានី ភ្នំពេញ រូប នេះ បាន អះអាង យ៉ាង ដូច្នេះ ថា « សូម បងប្អូន ដែល ទិញ អាហារ អនឡាញ ប្រុងប្រយ័ត្ន ពេល ទូរទាត់ លុយ និង ការយក អាហារ ដោយ អនុវត្ត តាម វិធាន សុខាភិបាល ដើម្បី កុំ ឲ្យ ឆ្លង កូវីដ ព្រោះ អ្នក អនឡាញ ក៏ ឆ្លង ដែរ » ។
លោក កើត ឆែ បាន គូសបញ្ជាក់ ទៀត ថា ប្រជាពលរដ្ឋ ដែល និយម ប្រើប្រាស់ សេវាកម្ម នេះ ត្រូវ បង្កើន នូវ ការគិតគូរ ឲ្យ ខ្លាំង បន្ថែម ទៀត ចំពោះ ទំនិញ ណា ដែល មាន ហានិភ័យ ព្រោះ ក្នុង ករណី អ្នកលក់ មាន ផ្ទុក ជំងឺ កូវីដ ហានិភ័យ នៃ ការឆ្លង មាន កម្រិត ខ្ពស់ ។ ប៉ុន្ដែ ក្នុង ករណី ទំនិញ ដែល អាច កម្ដៅ បាន ឬ លាង សម្អាត បាន ល្អ អាច មិន មាន ហានិភ័យ នៃ ការឆ្លង ។
ក្នុង សន្និសីទ សារព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ នេះ អភិបាល រង រាជធានី ភ្នំពេញ រូប នេះ បាន គូសបញ្ជាក់ ថា ក្រៅពី មន្ដ្រី ដែល ចុះ ចែក អំណោយ នៅ តំបន់ ក្រហម បាន ឆ្លង ហើយ នោះ ក៏ មាន មន្ដ្រី មួយចំនួន ទៀត ដែល យាម ឬ ប្រចាំ ការ នៅ តាម មណ្ឌល ព្យាបាល ជំងឺ កូវីដ ក៏ បាន ឆ្លង ដូចគ្នា ផងដែរ ។
ទន្ទឹមនឹង អ្វី ដែល ជា ការរក ឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ នោះ លោក កើត ឆែ បាន ឲ្យដឹង ទៀត ថា មន្ដ្រី មួយចំនួន ទៀត ក៏ កំពុង ជាប់ ចត្តាឡី ស័ក ផងដែរ ក្រោយ ចុះ ទៅ បំពេញ ការងារ នៅ តំបន់ គ្រោះថ្នាក់ ។ លោក បាន បន្ដ ថា តំបន់ ខ្លះ ពេល កំពុង ចុះ ចែកចាយ ស្រាប់តែ រថយន្ដ សាមុយ របស់ មន្ទីរពេទ្យ ចុះ មក អ្នក ដែល មាន វិជ្ជមាន ជំងឺ កូវីដ១៩ ក្នុង ចំណោម អ្នក ដែល កំពុង រង់ចាំ ទទួល អំណោយ ថែម ទៀត ផង ។
លោក កើត ឆែ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « និយាយ រួម យើង មាន ឆ្លង មន្ដ្រី អាវុធហត្ថ មន្ដ្រី នគរបាល និង មន្ដ្រី មួយចំនួន ត្រូវ ធ្វើចត្តាឡី ស័ក អញ្ចឹង តាម ធម្មតា អ្នក ប៉ះពាល់ ជាមួយ អ្នក កើត ជំងឺ កូវីដ ត្រូវតែ ធ្វើចត្តាឡី ស័ក ហើយ ពេល ខ្លះ កំពុង ចែក អំណោយ ស្រាប់តែ ឡានពេទ្យ មក យក អ្នកជំងឺ កូវីដ១៩ ក្នុង ចំណោម អ្នកទទួល អំណោយ » ។
ប៉ុន្ដែ ចំពោះ ចំនួន ជាក់លាក់ ប៉ុន្មាន នាក់ នោះ អភិបាល រង រាជធានី ភ្នំពេញ កើត ឆែ មិន ទាន់ អាច បញ្ជាក់ ឲ្យដឹង បាន នៅឡើយ ទេ គ្រាន់តែ បញ្ជាក់ ជា រួម តែ ប៉ុណ្ណោះ ៕
គ.ជ. ប ជូនដំណឹង ពី ការដាក់ និង ការទទួល ពាក្យ សុំ ចុះឈ្មោះ ភ្នាក់ងារ គណបក្ស នយោបាយ អ្នកសង្កេតការណ៍ ជាតិ និង អន្តរជាតិ សម្រាប់ ការបោះឆ្នោត លើក ទី ១ ដើម្បី ជ្រើសរើស ក្រុមប្រឹក្សា ក្រុង បូក គោ ឆ្នាំ ២០២១
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ហៅ កាត់ គ.ជ. ប បាន ចេញ សេចក្ដីជូនដំណឹង ស្តីពី ការដាក់ និង ការទទួល ពាក្យ សុំ ចុះឈ្មោះ ភ្នាក់ងារ គណបក្ស នយោបាយ អ្នកសង្កេតការណ៍ ជាតិ និង អន្តរជាតិ សម្រាប់ ការបោះឆ្នោត លើក ទី ១ ដើម្បី ជ្រើសរើស ក្រុមប្រឹក្សា ក្រុង បូក គោ នៃ ខេត្ត កំពត ឆ្នាំ ២០២១ ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ៕
ខាងក្រោម ជា ទិន្នន័យ ប្រទេស ចំនួន ២០ ដែល មាន អ្នក ឆ្លង ជំងឺ COVID-19 ច្រើន ជាង គេ៖ ប្រជាពលរដ្ឋ នៅ « តំបន់ ក្រហម » ខណ្ឌ ឬស្សីកែវ ថ្លែងអំណរគុណ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ក្រោយ ទទួល ស្បៀងអាហារ ជា បន្តបន្ទាប់ ដើម្បី ដោះ ជីវភាព ប្រចាំ ថ្ងៃ
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ រស់ នៅ ផ្សារ សុភមង្គល ក្បែរ ផ្សារ ធំ ទួល សង្កែ ហៅ ផ្សារ សាំ ហាន់ « តំបន់ ក្រហម » ក្នុង ក្រុម ទី៤ ភូមិ បាក់ទូក សង្កាត់ ទួល សង្កែទី១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ បាន ថ្លែងអំណរគុណ ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល បាន ចាត់ ឲ្យ អាជ្ញាធរ បាន យក អំណោយ ទៅ ចែកជូន ពួកគាត់ ទាន់ ពេលវេលា ដើម្បី ដោះស្រាយ ជីវភាព ក្នុង ដំណាក់ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
ការថ្លែងអំណរគុណ នេះ បន្ទាប់ពី ពួកគាត់ ស្ថិត នៅក្នុង តំបន់ បិទ ខ្ទប់ « តំបន់ ក្រហម » ទទួលបាន ការយកចិត្តទុកដាក់ ឧបត្ថម្ភ ជា ស្បៀងអាហារ ជា បន្តបន្ទាប់ ដើម្បី ដោះស្រាយ ជីវភាព ប្រចាំ ថ្ងៃ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន តាម រយះ រដ្ឋបាល រាជធានី ភ្នំពេញ រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ និង រដ្ឋបាល សង្កាត់ ទួល សង្កែទី១ ព្រមទាំង អាជ្ញាធរ ភូមិ ផងដែរ កាលពី ល្ងាច ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២១ ។
ជាមួយ ការចែក ស្បៀងអាហារ ជូន ប្រជាពលរដ្ឋ នេះ លោក ជា ពិសី បាន គូសបញ្ជាក់ ថា មិន មាន ការតម្លើង ថ្លៃ ទឹក - ភ្លើង ដូច ការលើកឡើង តាម បណ្ដាញ ទំនាក់ទំនង សង្គម ហ្វេសប៊ុក សូម បង - ប្អូន ប្រជាពលរដ្ឋ មេត្តា កុំ មាន ការយល់ ច្រឡំ ។
លោក ជា ពិសី បាន គូសបញ្ជាក់ ទៀត ថា អាជ្ញាធរ បាន ខិតខំ ប្រឹងប្រែង ទាំង ដុត ដៃ ដុត ជើង នាំយក ស្បៀងអាហារ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត និង ស្បៀងអាហារ របស់ សប្បុរសជន នានា មក ចែកជូន ជា បន្តបន្ទាប់ ជូន បង - ប្អូន ប្រជាពលរដ្ឋ ដែល ជួប ការខ្វះខាត ដើម្បី ជួយ សម្រួល ដល់ ជីវភាព ប្រចាំ ថ្ងៃ ក្រោយពី រាជ រដ្ឋាភិបាល សម្រេច បិទ ខ្ទប់ និង កំណត់ ជា « តំបន់ ក្រហម » « តំបន់ លឿង » និង « តំបន់ លឿង ទុំ » ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
លោក កើត ឆែ អភិបាល រង រាជធានី ភ្នំពេញ បាន អះអាង ថា សម្រាប់ អ្នក រស់ នៅក្នុង រាជធានី ភ្នំពេញ អាច ធ្វើដំណើរ ចេញ ទៅ តាម បណ្ដា ខេត្ត ផ្សេង ៗ បាន ប៉ុន្ដែ ត្រូវតែ គោរព តាម វិធាន របស់ ខេត្ត នីមួយ ៗ ដែល ខ្លួន ចង់ ទៅ ពិសេស ការតម្រូវឲ្យ យក សំណាក ឬ ការធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ជា កំហិត ជាដើម ។
ដោយឡែក សម្រាប់ អ្នក ដែល រស់ នៅ តាម បណ្ដា ខេត្ត ដែល មិន មាន ហានិភ័យ ពោល មិន មាន ការឆ្លង រីករាលដាល ខ្លាំង នោះ ក៏ អាច ធ្វើដំណើរ ចូលមក រាជធានី ភ្នំពេញ បាន ដូចគ្នា ផងដែរ ប៉ុន្ដែ ត្រូវតែ គោរព តាម វិធានការ នានា របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ពិសេស ត្រូវ កំណត់ ច្បាស់ បុគ្គល នោះ មិន មែន ជា អ្នក មកពី តំបន់ ហានិភ័យ ។
សូម ជម្រាប ថា តាមរយៈ សេចក្ដីណែនាំ ថ្ងៃទី ០៤ ខែឧសភា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ត្រង់ ចំណុច ទី៥ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ដាក់ បទបញ្ជា ឲ្យ គណៈ អភិបាល រាជធានី - ខេត្ត ត្រូវ ពង្រឹង ការត្រួតពិនិត្យ ការចេញ - ចូល ភូមិសាស្ដ្រ ដែល ស្ថិត ក្រោម សមត្ថកិច្ច របស់ ខ្លួន ។
សម្រាប់ អ្នក ដែល ធ្វើដំណើរ ចេញពី តំបន់ ដែល មាន ការផ្ទុះ ឆ្លង រីករាលដាល ធ្ងន់ធ្ងរ នៃ ជំងឺ កូវីដ១៩ ជា អាទិ៍ ការយក សំណាក របស់ អ្នកដំណើរ ដើម្បី វិភាគរហ័ស រក មេរោគ កូវីដ១៩ . ការពង្រឹង វិធានការ សុខាភិបាល នានា ដូចជា ការពាក់ ម៉ាស និង ការររក្សា គម្លាត សុវត្ថិភាព និង ការពង្រឹង វិធានការចត្តាឡី ស័ក ជាដើម ។
យ៉ាងណាមិញ រហូតមកដល់ ពេលនេះ តាម បណ្ដា ខេត្ត ផ្សេង ៗ ជាច្រើន បាន ប្រកាស ដាក់ចេញ នូវ វិធានការរៀង ៗ ខ្លួន ជា បន្ដ បន្ទាប់ ដូចជា ការតម្រូវឲ្យ អ្នក ដែល ធ្វើដំណើរ មកពី រាជធានី - ខេត្ត ផ្សេង ហើយ មាន បំណង ចូលមក ធ្វើ ការ ឬ មក លេង សាច់ញាតិ នៅក្នុង ខេត្ដ របស់ ខ្លួន គឺ តម្រូវឲ្យ យក សំណាក ពិនិត្យ រក ជំងឺ កូវីដ១៩ និង ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ជាកំហិត ៕
កូវីដ - ១៩. សង្គ្រាម និង ការប្រែប្រួល អាកាសធាតុ បង្កឲ្យ វិបត្តិ ស្បៀងអាហារ កាន់តែ កើនឡើង
