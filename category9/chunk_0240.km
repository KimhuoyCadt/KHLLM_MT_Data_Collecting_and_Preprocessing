( ភ្នំពេញ )៖ គណៈ បញ្ជាការ ឯកភាព រាជធានី ភ្នំពេញ បាន ដាក់ចេញ វិធានការ យ៉ាង ម៉ឺងម៉ាត់ មួយ លើ ការកំណត់ ការចេញ ចូល និង ការគ្រប់គ្រង ការអនុវត្ត នៅ តំបន់ ពណ៌ លឿង លឿង ទុំ និង តំបន់ ក្រហម នៅក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ឱ្យ បាន ល្អ ប្រសើរ ក្នុង ការទប់ស្កាត់ នូវ ការរីករាលដាល ជំងឺ កូវីដ១៩ ទៅ តាម សេចក្តីសម្រេច លេខ ៥៤ សសរ ចុះ ថ្ងៃទី ២៦ មេសា ២០២១ របស់ រាជ រដ្ឋាភិបាល ។
ការដាក់ចេញ វិធានការ យ៉ាង ម៉ឺងម៉ាត់ ខាងលើ នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២១ នៅក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រាជធានី ភ្នំពេញ តាមរយៈ Video Conference ក្រោម វត្តមាន លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ និង ជា អនុប្រធាន គណៈកម្មការ ប្រតិបត្តិ នៃ គ. ប. ខ និង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ព្រមទាំង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ កងកម្លាំង អាជ្ញាធរ ខណ្ឌ ទាំង ១៤ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ក្នុង ព្រឹត្តិកាល សហគមន៍ ២០កុម្ភៈ នេះ ។
ក្នុង កិច្ចប្រជុំ នោះ លោក ឃួង ស្រេង បាន ថ្លែង ថា ការបង្កើត ឱ្យ មាន កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រាជធានី ភ្នំពេញ ដើម្បី កំណត់ ឱ្យ បាន ច្បាស់លាស់ ពី តំបន់ ក្រហម តំបន់ លឿង ទុំ និង តំបន់ លឿង ងាយស្រួល គ្រប់គ្រង និង អនុវត្ត ការងារ ទៅ តាម សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល ឱ្យ បាន ម៉ឺងម៉ាត់ ពិសេស ផ្សព្វផ្សាយ ឲ្យ ប្រជាពលរដ្ឋ ចូលរួម ជាមួយ អាជ្ញាធរ របស់ យើង ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជម្ងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ នេះ ឱ្យ បាន ល្អ បន្ថែម ទៀត ។
ប៉ុន្តែ ទោះបីជា យ៉ាងណា ក្ដី លោក ឃួង ស្រេង បាន ណែនាំ ឱ្យ កងកម្លាំង មាន សមត្ថកិច្ច និង អាជ្ញាធរ ទាំងអស់ អនុវត្ត ការងារ ខាងលើ នេះ កុំ ឱ្យ លើស និង កុំ ឱ្យ ខ្វះ ដើម្បី អនុវត្ត សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល នេះ ទទួលបាន ជោគជ័យ ។
ទី១៖ ស្វែងយល់ ឲ្យបាន ច្បាស់លាស់ បន្ថែម ពី តំបន់ បិទ ខ្ទប់ ដើម្បី យក ទៅ អនុវត្ត ឲ្យ ចំ គោលដៅ មិន លើស មិន ខ្វះ និង ទទួលបាន ជោគជ័យ ទី២៖ ការផ្សាយ ផ្សាយ ប្រជាពលរដ្ឋ ឱ្យ បាន យល់ ពី អ្វី ដែល ពួកគាត់ ត្រូវ អនុវត្ត អ្វី ដែល ពួកគាត់ គួរ ធ្វើ និង មិន គួរ ធ្វើ លើ តំបន់ ៣ ពណ៌ ដែល បាន កំណត់ ដើម្បី ទប់ស្កាត់ នូវ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ។
លោក កើតរិទ្ធ ក្នុង ឱកាស នោះ ក៏ បាន សម្តែង ការកោតសរសើរ ចំពោះ កងកម្លាំង និង អាជ្ញាធរ រាជធានី ភ្នំពេញ ក្នុង រយៈពេល ១៤ ថ្ងៃ នៃ ការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ នេះ ឃើញ ថា កម្លាំង និង អាជ្ញាធរ បាន ប្រឹងប្រែង ខ្លាំង ណាស់ ទាំង កម្លាំង កាយ កម្លាំងចិត្ត ដែល បាន ធ្វើឱ្យ ការងារ នេះ ដំណើរការ ទៅ ដោយ រលូន និង ជោគជ័យ និង មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ បាន យ៉ាង ល្អ ប្រសើរ ផងដែរ ៕
ក្រុមហ៊ុន ហាវ ភិន ( ខេមបូឌា ) ខូអិលធីឌី កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក ភុំ ភិរម្យ និង លោកស្រី ឡេង ម៉េង កាំង ឧបត្ថម្ភ ថវិកា ១០លាន រៀល អង្ករ ៨តោន ទឹក សុទ្ធ ១០០ កេស ម៉ាស ១០កេស និង អាល់កុល១០ ប៊ី ដុង ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ លោក ភុំ ភិរម្យ និង លោកស្រី ឡេង ម៉េង កាំង ឧបត្ថម្ភ ថវិកា ១០លាន រៀល អង្ករ ៨តោន ទឹក សុទ្ធ ១០០ កេស ម៉ាស ១០កេស និង អាល់កុល១០ ប៊ី ដុង ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
លោក ភុំ ភិរម្យ និង លោកស្រី ឡេង ម៉េង កាំង កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក លោក ភុំ ភិរម្យ និង លោកស្រី ឡេង ម៉េង កាំង ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
រដ្ឋបាល ខេត្ត សៀមរាប បើក ការចេញ - ចូល ឡើងវិញ ទីតាំង ផ្ទះ ចំនួន ២០ ក្នុង ក្រុង សៀមរាប ដែល ធ្លាប់ ពាក់ព័ន្ធ នឹង អ្នកជំងឺ កូវីដ
យ៉ាងណា ក៏ដោយ រដ្ឋបាល ខេត្ត នៅ បន្ត អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ និង សាធារណជន មេត្តា យកចិត្តទុកដាក់ អនុវត្ត នូវ វិធានការ របស់ ក្រសួង សុខាភិបាល និង អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា គឺ ៣ ការពារ ( ត្រូវ ពាក់ ម៉ាស់ ត្រូវ លាង ដៃ ជាមួយ សាប៊ូ ឬ ជែល និង ត្រូវ រក្សា គម្លាត សង្គម ) ៣កុំ ( កុំ ចូល ទៅ កន្លែង បិទ ជិត គ្មាន ខ្យល់ ចេញ - ចូល កុំ ទៅ កន្លែង មាន មនុស្ស ច្រើន កុះករ និង កុំ ប៉ះពាល់ គ្នា ) ។
គួរ បញ្ជាក់ ថា ខេត្ត សៀមរាប បាន រកឃើញ អ្នកវិជ្ជមាន កូវីដ១៩ ចំនួន ២០ នាក់ ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ។ គិត ត្រឹម ថ្ងៃទី ២៨ ខែមេសា នេះ មាន អ្នកសះស្បើយ ១២នាក់ និង ៨នាក់ ទៀត កំពុង បន្ត ព្យាបាល ក្នុង មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប ៕ គណៈ សង្ឃ នាយក ជូនដំណឹង ដល់ គណៈ មេ គណទាំង ២៥ រាជធានី - ខេត្ត ចូលរួម អនុវត្ត តាម វិធាន សុខាភិបាល ឱ្យ បាន ខ្ជាប់ខ្ជួន ដើម្បី ការពារ ជំងឺ កូវីដ
( ភ្នំពេញ ) ៖ ក្នុង អំឡុង ពេល ជំងឺ កូវីដ - ១៩ កំពុង បន្ត រាតត្បាត នៅក្នុង ព្រឹត្តិការណ៍ « សហគមន៍ ២០ កុម្ភ » គណៈ សង្ឃ នាយក នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ប្រគេន ដំណឹង ដល់ ព្រះមេ គណទាំង ២៥ រាជធានី - ខេត្ត ព្រមទាំង ព្រះសង្ឃ ទូទាំង ប្រទេស សូម និមន្ត អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន ឱ្យ បាន ម៉ឺងម៉ាត់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការ « ៣កុំ និង ៣ការពារ » ដើម្បី ទប់ស្កាត់ ការឆ្លង ជំងឺ កូវីដ - ១៩ ។
ការប្រគេន ដំណឹង របស់ គណៈ សង្ឃ នាយក ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ ក្នុង ទី វត្តអារាម ទូទាំង ប្រទេស គឺ ធ្វើឡើង បន្ទាប់ពី មាន ព្រះសង្ឃ មួយ អង្គ ព្រះនាម ប៊ូ ផាត គង់ នៅ វត្ត ស្ទឹង ហាវ ខេត្ត ព្រះសីហនុ ត្រូវបាន គ្រូពេទ្យ ធ្វើតេស្ត រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ - ១៩ និង កំពុង គង់ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត កែប ។
តាមរយៈ លិខិត ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួល នៅ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២១ នេះ គណៈ សង្ឃ នាយក នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន បញ្ជាក់ ថា ដើម្បី ចូលរួមចំណែក ជាមួយ ការខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា សូម ឱ្យ ព្រះមេ គណ ព្រះគ្រូ អនុគណ ព្រះចៅ អធិការ គ្រប់ វត្ត និង ពុទ្ធ បរិស័ទ គ្រប់ មជ្ឈដ្ឋាន ទូទាំង ប្រទេស ចំនួន អនុវត្ត តាម វិធី ៣ ចំណុច រួម មាន៖
ទី១៖ ព្រះមេ គណរាជធានី - ខេត្ត ត្រូវ ធ្វើ ការណែនាំ បន្ថែម ដល់ ព្រះអនុគណ ព្រះចៅ អធិការ គ្រប់ វត្ត ឱ្យ អះនុវត្ត គោលការណ៍ គម្លាត សង្គម ឱ្យ បាន ខ្ជាប់ខ្ជួន ស្រប តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង សេចក្តីណែនាំ នានា របស់ ក្រសួង ធម្មការ និង សាសនា ព្រមទាំង គណៈ សង្ឃ នាយក នៃ ព្រះរាជាណាចក្រ កម្ពុជា នា ពេល កន្លងមក ។
ទី២៖ បន្ត បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ និង ចូលរួម ថែរក្សា សុខភាព ទាំងអស់ គ្នា តាមរយៈ ការពារ ម៉ាស ការពារ រៀបចំ ឱ្យ មាន កន្លែង ពិនិត្យ សុខភាព មុនពេល ចូល ទី វត្តអារាម ព្រះវិហារ ឬ សាលា ឆាន់ ត្រូវ មាន ឧបករណ៍ វាស់ កម្តៅ សាប៊ូ ជែល ឬ ទឹក អាល់កុល សម្រាប់ លាងសំអាត ដៃ ជាប្រចាំ និង ដាច់ខាត ត្រូវ ពាក់ ម៉ាស ឬ ប្រើ ក្រដាស ខ្ទប់ មាត់ នៅពេល ក្អក ឬ កណ្តាស់ និង ត្រូវ រក្សា គម្លាត សុវត្ថិភាព ពី ម្នាក់ ទៅ ម្នាក់ ទៀត ដូចជា គង់ អង្គុយ ឈរ ឈរ រង់ចាំ ឬ ឈរ ជជែកគ្នា ឱ្យ នីឲៅ គម្លាត ពី គ្នា យ៉ាងតិច ១.៥ម៉ែត្រ ឡើង ទៅ ។
ដោយឡែក បើ មាន ការនិមន្ត ចូលរួម បុណ្យ សព ត្រូវ ឱ្យ មាន ការបញ្ជាក់ ពី ក្រុមគ្រួសារ សព ឬ សំបុត្រ ពេទ្យ ជៀសវាង បុណ្យ សព អ្នកជំងឺ កូវីដ - ១៩ លើកលែងតែ មន្ត្រី ជំនាញ សុខាភិបាល បាន អនុវត្ត ភារកិច្ច របស់ ខ្លួន ចប់ សព្វគ្រប់ ហើយ អនុញ្ញាតឱ្យ ក្រុមគ្រួសារ សព ធ្វើ បុណ្យ តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា ។
និង ទី៣៖ ក្នុង ករណី មាន រោគសញ្ញា ដូច ជា៖ ឡើហកម្តៅ ផ្តាសាយ ក្អក ហៀរ សំបោរ ឈឺ បំពង់ ករ ថប់ ដង្ហើម ឬ រោគសញ្ញា សង្ស័យ ផ្សេង ៗ និង ត្រូវ និមន្ត ទៅ មន្ទីរពេទ្យ រដ្ឋ ដែល នៅជិត បំផុត ដើម្បី ទទួលបាន ការពិនិត្យ វីរុស កូវីដ - ១៩ និង ធ្វើ ការព្យាបាល ជាបន្ទាន់ ៕
រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន ជូនដំណឹង ពី ការបន្ដ សុពលភាព លិខិត អនុញ្ញាត ធ្វើដំណើរ ក្នុង ពេល បិទ ខ្ទប់ ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ រយៈពេល ៧ ថ្ងៃ ទៀត (Video inside) ( ភ្នំពេញ ) ៖ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ពី ការបន្ដ សុពលភាព លិខិត អនុញ្ញាតិ ធ្វើដំណើរ ក្នុង អំឡុង ពេល អនុវត្ត វិធានការបិទ ខ្ទប់ ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្ដាល សម្រាប់ រយៈពេល ៧ ថ្ងៃ បន្ដ ទៀត ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន៖ រកឃើញ ជាតិ ចិន ២នាក់ បម្រើការ នៅ រោងចក្រ ផលិត កាបូប «PV» នៅក្នុង ខេត្ត តាកែវ វិជ្ជមាន ជំងឺ កូវីដ១៩
ប្រធាន មន្ទីរ សុខាភិបាល រូប នេះ បាន បន្ត ថា បច្ចុប្បន្ន អ្នកជំងឺ ជនជាតិ ចិន ទាំង ២នាក់ ត្រូវ ដាក់ ឱ្យ ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក បាទី ។ ដោយឡែក រោងចក្រ ដែល ពួកគេ បម្រើ ការ ត្រូវបាន ថៅកែ រោងចក្រ សម្រេច បិទ ជា បណ្ដោះអាសន្ន ដោយ ខ្លួន ឯង ជា ហេតុ ធ្វើឲ្យ អាជ្ញាធរ មាន ការលំបាក ដើម្បី ស្វែងរក កម្មករ មក ធ្វើតេស្ត និង ធ្វើចត្តាឡី ស័ក ៕ រដ្ឋបាល ខេត្ត រតនគិរី ពង្រឹង ការអនុវត្ត វិធានការធ្វើដំណើរ ឆ្លងកាត់ ភូមិសាស្ដ្រ ខេត្ត ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ . អ្នកចូល ខេត្ត នេះ ត្រូវ ធ្វើតេស្ដរហ័ស ជាមុន
