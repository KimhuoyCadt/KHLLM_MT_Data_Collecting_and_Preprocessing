ខេត្ត ត្បូងឃ្មុំ រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ៤នាក់ ថ្មី បន្ថែម ទៀត
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្តាល និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រមទាំង ក្រុមការងារ នា រសៀល ថ្ងៃទី ២៣ ខែឧសភា ឆ្នាំ ២០២១ បាន អញ្ជើញ ជួប សំណោះ សំណាល សាកសួរ សុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ របស់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្តាល មក ចែកជូន គ្រួសារ សព ចំនួន ១២នាក់ ដែល បាន ពុល ស្រាស បណ្តាលឲ្យ ស្លាប់ ជា បន្តបន្ទាប់ ចាប់ពី ថ្ងៃទី ១០ ដល់ ថ្ងៃទី ១៩ ខែឧសភា កន្លងទៅ ថ្មី ៗ នេះ នៅក្នុង ឃុំ សារិការកែវ ស្រុក ល្វា ឯម ។
នា ឱកាស នោះ លោក អភិបាល ខេត្ត បាន ថ្លែង នូវ ការសោកស្តាយ និង បាន ចូលរួម រំលែក មរណទុក្ខ ដល់ គ្រួសារ សព្វ ចំពោះ ការបាត់បង់ សមាជិក ជា ទីស្រឡាញ់ និង សូម ឧទ្ទិស នូវ មហា កុសល ដល់ វិញ្ញាណ ខន្ធ សព បាន ដល់ សុគតិភព ។
ជាពិសេស លោក បាន លើកទឹកចិត្ត និង ផ្តាំផ្ញើ ដល់ គ្រួសារ សព ត្រូវ រឹងមាំ ខិតខំ តធ្វើ ការងារ និង រក ទទួលទាន ដើម្បី លើកស្ទួយ ជីវភាព គ្រួសារ គ្រប់គ្រង កូន ចៅ ឱ្យ បាន ល្អ ឱ្យ កូន ៗ បាន ចូល រៀន គ្រប់ ៗ គ្នា និង ត្រូវ បន្ត រក្សា អនាម័យ តាម វិធាន សុខាភិបាល ដើម្បី ជៀស ផុត ពី ជំងឺ កូវីដ១៩ ។
សូម បញ្ជាក់ ថា អំណោយ ដែល ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាន ចែកជូន ដល់ គ្រួសារ សព ក្នុង មួយ គ្រួសារ ទទួលបាន៖ អង្ករ ៥០ គីឡូក្រាម ត្រីខ ១យួរ ទឹកត្រី ១យួរ ទឹកស៊ី អ៉ីវ ១យួរ ប្រេង ឆា ១ដប មី ១កេស ទឹក សុទ្ធ ១កេស ទឹកក្រូច ១កេស ជែល លាង ដៃ ១ដប ម៉ាស១០បន្ទះ និង ថវិកា ៥០០.០០០ រៀល ៕ អាជ្ញាធរ ខេត្ត ស្វាយរៀង អំពាវនាវ ពលរដ្ឋ ដែល ពាក់ព័ន្ធ ជាមួយ អ្នកជំងឺ កូវីដ១៩ ជិះ រថយន្ដ ឈ្នួល ឈ្មោះ ឯក ភក្តី ប្រញាប់ ធ្វើតេស្ត រក មេរោគ កូវីដ ឱ្យ បាន ឆាប់ រហ័ស
សម្រាប់ អ្នក ដែល គ្មាន រោគសញ្ញា សូម ដាក់ ខ្លួន ដាច់ដោយឡែក និង តាមដាន សុខភាព របស់ ខ្លួន រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃ ដែល អ្នក បាន ប៉ះពាល់ ឬ ទៅ ទីកន្លែង នោះ ៕ រដ្ឋបាល ខេត្ត តាកែវ បង្ហាញ អត្តសញ្ញាណ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ៥៣ នាក់ ថែម ទៀត
រដ្ឋបាល ខេត្ត ព្រះសីហនុ បង្ហាញ អត្តសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ ចំនួន ១៣នាក់ ដែល ទើប រកឃើញ ឆ្លង ថ្មី
ធនាគារ ជាតិ នៃ កម្ពុជា បាន លើកឡើង ថា « ការប្រើប្រាស់ សេវា ធនាគារ ឌីជីថល អាច ជួយ កាត់បន្ថយ ការចម្លង ជំងឺ កូវីដ១៩ តាមរយៈ ការកាត់បន្ថយ តម្រូវការ នៃ ការប្រើប្រាស់ ក្រដាស ប្រាក់ ដោយ ផ្ទាល់ រវាង បុគ្គល ម្នាក់ ទៅ បុគ្គល ម្នាក់ ទៀត » ។
លោកស្រី បន្ថែម ថា អង្គការ សុខភាព ពិភពលោក ជំរុញ ឱ្យ មាន ការប្រុងប្រយ័ត្ន នៅពេល កាន់ ក្រដាស ប្រាក់ និង បាន ណែនាំ ដល់ ប្រជាពលរដ្ឋ គ្រប់ រូប ត្រូវ លាង ដៃ ឱ្យ បាន ស្អាត បន្ទាប់ពី កាន់ ក្រដាស ប្រាក់ ជាពិសេស នៅពេល ប៉ះពាល់ ឬ ញ៉ាំ អាហារ ។
លោកស្រី ជា សិរី បន្ថែម ថា « បើ ទោះជា ធនាគារ ជាតិ នៃ កម្ពុជា ពិនិត្យ ឃើញ ថា ពលរដ្ឋ ភាគ ច្រើន និយម ធ្វើ ប្រតិបត្តិការ ទូទាត់ ដោយ ប្រើប្រាស់ ក្រដាស ប្រាក់ ក្តី ក៏ ធនាគារ ជាតិ នៅតែ ជំរុញ ពាណិជ្ជករ និង អតិថិជន ឱ្យ ងាក មក ប្រើប្រាស់ ការទូទាត់ ជា អេឡិចត្រូនិក ដោយសារ ការ អនុវត្ត នេះ នឹង អាច ពង្រឹង ចំណេះដឹង នៃ ការប្រើប្រាស់ ការទូទាត់ ឌីជីថល និង ទាក់ទាញ ប្រជាពលរដ្ឋ ឱ្យ ប្រើប្រាស់ ការទូទាត់ នេះ បាន កាន់តែ ទូលំទូលាយ តាមរយៈ កម្មវិធី ទូទាត់ ទាំងនោះ » ។
លោកស្រី បាន បញ្ជាក់ ថា កាលពី ឆ្នាំ ២០២០ ធនាគារ ជាតិ នៃ កម្ពុជា បាន ដាក់ ដំណើរការ ប្រព័ន្ធ ទូទាត់ សង ប្រាក់ រួម មួយ ដែល អនុញ្ញាតឱ្យ អតិថិជន ធ្វើ ប្រតិបត្តិការ បាន ច្រើន មុខងារ ដូចជា កាបូប អេឡិចត្រូនិក (E-Wallet) ការទូទាត់ ចល័ត និង កម្មវិធី ធនាគារ អនឡាញ ដែល មុខងារ ទាំងអស់ នេះ ស្ថិត ក្នុង កម្មវិធី តែ មួយ ។
ប្រព័ន្ធ បាគង (Bakong) របស់ ធនាគារ ជាតិ នៃ កម្ពុជា បាន តភ្ជាប់ ជាមួយ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ និង គ្រឹះស្ថាន ផ្តល់ សេវា ទូទាត់ សង ប្រាក់ នៅ កម្ពុជា ជាច្រើន ដែល អនុញ្ញាតឱ្យ អ្នកប្រើប្រាស់ មាន លទ្ធភាព ក្នុង ការធ្វើ ប្រតិបត្តិការ ទូទាត់ ជា ឌីជីថល បាន ទូលំទូលាយ និង មាន ប្រសិទ្ធភាព ។
លោក បញ្ជាក់ ថា ជាមួយនឹង កិច្ចការងារ លើកកម្ពស់ បរិយា បន្ន ហិរញ្ញវត្ថុ នៅ កម្ពុជា ធនាគារ ជាតិ នៃ កម្ពុជា ស្ថិត នៅ កម្រិត ឈានមុខ (forefront) នៃ ការលើកកម្ពស់ សេវា ទូទាត់ ឌីជីថល ។ យោង តាម ប្រភព ពី ធនាគារ ជាតិ នៃ កម្ពុជា បច្ចុប្បន្ន មាន ប្រជាជន កម្ពុជា ច្រើន ជាង ៥៩ % បាន ធ្វើ ប្រតិបត្តិការ ទូទាត់ របស់ ខ្លួន តាម ប្រព័ន្ធ អនឡាញ ។
គួរ បញ្ជាក់ ថា បើ តាម សមាគម ជំនួយ សម្រាប់ អ្នកទោស នយោបាយ នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា មនុស្ស យ៉ាងហោច ៨១៥ នាក់ ហើយ ត្រូវបាន សម្លាប់ ដោយ កងកម្លាំង សន្តិសុខ មីយ៉ាន់ម៉ា ចាប់តាំងពី មាន រដ្ឋប្រហារ កាលពី ថ្ងៃទី ០១ ខែកុម្ភៈ មក ។ ប៉ុន្តែ អគ្គ មេបញ្ជាការ យោធា លោក មីន អោង ហ្លេង បាន បញ្ជាក់ ថា អ្នកស្លាប់ សរុប មាន ចំនួន តែ ៣០០ នាក់ ប៉ុណ្ណោះ ក្នុង នោះ មាន កងកម្លាំង ប៉ូលិស ៤៧ នាក់ ៕
អាជ្ញាធរ ខេត្ត កោះកុង រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ៣៧ នាក់ នៅ ស្រុក ស្រែ អំបិល ជា កម្មករ បម្រើ ការងារ នៅ រោងចក្រ ផលិត ចំណី សត្វ ក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ
( កោះកុង ) ៖ លោក វេជ្ជបណ្ឌិត ទៅ ម៉ឺង ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត កោះកុង បាន បញ្ជាក់ ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ប្រចាំ ខេត្ត កោះកុង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២១នេះ រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៣ ដល់ ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២១ ក្នុង ស្រុក ស្រែ អំបិល ត្រូវបាន រកឃើញ ករណី វិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ៣៧ នាក់ គឺ គេ ជា កម្មករ បម្រើ ការងារ នៅ រោងចក្រ ផលិត ចំណី សត្វ ក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
លោក វេជ្ជបណ្ឌិត បាន បន្ថែម ថា ដោយសារ មាន ករណី រកឃើញ វិជ្ជមាន កូវីដ១៩ ពី មន្ទីរពិសោធន៍ ក្រសួង មាន អត្រា ខ្ពស់ ក្នុង ស្រុក ស្រែ អំបិល អាជ្ញាធរ ខេត្ត បាន ប្រជុំ ពិភាក្សា រក ដំណោះស្រាយ ដើម្បី កុំ ឱ្យ មាន រីករាលដាល បន្ត រហូត អាជ្ញាធរ ខេត្ត បាន សម្រេច បិត ខ្ទប់ ភូមិ ចំនួន ៥ មិន ឱ្យ បងប្អូន ធ្វើដំណើរ ឆ្លងកាត់ ចេញ ចូល ឡើយ ។
លោក វេជ្ជបណ្ឌិត បាន គូសបញ្ជាក់ ថា៖ « ប្រពលរដ្ឋ ដែល ឆ្លង ជំងឺ កូវីដ១៩ នេះ គឺ ពួក ជា កម្មករ បម្រើការ ក្នុង រោងចក្រ ចំណី សត្វ ១ ដែល មាន ទីតាំង ស្ថិត នៅ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ដែល ពួល គាត់ បាន ទៅ បម្រើ ការងារ នៅ ទីនោះ រាល់ ថ្ងៃ ដោយ មាន រយន្ត ដឹង ទៅ ព្រឹក ល្ងាច » ។
អាជ្ញាធរ អំពាវនាវ ពលរដ្ឋ ដែល ពាក់ព័ន្ធ ជាមួយ អ្នកជំងឺ កូវីដ ម្នាក់ ធ្លាប់ ទៅ អាហារដ្ឋាន « ហាយ វ៉េ៥៥៥ » ខេត្ត ស្វាយរៀង បើ មាន ការសង្ស័យ សូម ទៅ ធ្វើតេស្ត រក កូវីដ ឱ្យ បាន ឆាប់ រហ័ស
( ស្វាយរៀង ) ៖ ក្រុម ស្រាវជ្រាវ អ្នកជំងឺ កូវីដ១៩ ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២១ នេះ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល ពាក់ព័ន្ធ ជាមួយ អ្នកជំងឺ កូវីដ១៩ ឈ្មោះ កែវ សុខុន ភេទ ប្រុស អាយុ ៣៨ ឆ្នាំ ភូមិ កណ្ដាល ឃុំ ខ្សែត្រ ស្រុក កំពង់រោទិ៍ ទីតាំង អាហារដ្ឋាន « ហាយវ៉េ ៥៥៥ » ស្ថិត នៅ ភូមិ បាក់ រនាស់ សង្កាត់ សង្ឃ័ រ ក្រុង ស្វាយរៀង ។
ប្រសិនបើ មាន រោគសញ្ញា ដូច ជា៖ គ្រុន ក្ដៅ . ក្អក . កណ្ដាស់ . ឈឺ បំពង់ ក ឬ ដកដង្ហើម ខ្លី ៗ ឬ សង្ស័យ សូម មេត្តា ប្រញាប់ ទៅ ធ្វេី តេស្ត រក មេរោគ កូវីដ១៩ ដែល មាន ទីតាំង នៅជិត ផ្ទះ ឬ ផ្ដល់ ព័ត៌មាន ទៅ អាជ្ញាធរ មូលដ្ឋាន ឬ ទៅ យក វត្ថុ វិភាគ សំណាក នៅ ប៉ុស្ដិ៍ យក សំណាក ដែរ មាន ទីតាំង នៅជិត ផ្ទះ ឬ ទំនាក់ទំនង មក ក្រុមការងារ ស្រាវជ្រាវ និង តាមដាន បុគ្គល សង្ស័យ ថា មាន ផ្ទុក ជំងឺ កូវីដ១៩ ខេត្ត៖ ០៤៤ ៧១២ ៥២២ ឬ ០៩៧ ៥០៣ ៤៥ ៦៧ ដើម្បី មាន វិធានការណ៍ បន្ត ។
សម្រាប់ អ្នក ដែល គ្មាន រោគសញ្ញា សូម ដាក់ ខ្លួន ដាច់ដោយឡែក និង តាមដាន សុខភាព របស់ ខ្លួន រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃ ដែល អ្នក បាន ប៉ះពាល់ ឬ ទៅ ទីកន្លែង នោះ ៕ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ រួមគ្នា ដើម្បី ការងារ មនុស្សធម៌ ដោយ នាំ ថវិកា ៩លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា សាខា ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ ព្រម ជាមួយ ក្រុមការងារ នៅ ព្រឹក ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២១ បាន នាំ នូវ ថវិកា សប្បុរសធម៌ ចំនួន ៩.០០០.០០០ រៀល ប្រគល់ ជូន លោក វ៉ី សំណាង អភិបាល ខេត្ត និង ជា ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម ខេត្ត កំពង់ស្ពឺ ។
លោក វ៉ី សំណាង ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ស្ពឺ បាន ថ្លែង ថា នេះ កាយវិការ ដ៏ ល្អ នៃ កម្លាំង បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ លើ ការងារ មនុស្ស ពិតជា ទឹកចិត្ត ដ៏ ប្រពៃ ប្រកបដោយ ម នោសញ្ចេតនា ជ្រាលជ្រៅ ចំពោះ ជនរងគ្រោះ ជន គ្មាន ទីពឹង ជន ជួប ការលំបាក និង ស្ត្រី មេម៉ាយ ក្មេង កំព្រា ។ល ។ ជាង នេះ ទៀត កម្លាំង កងរាជអាវុធហត្ថ បាន ចូលរួមចំណែក ការពារ សន្តិសុខ និង សុវត្តិភាព យ៉ាង សំខាន់ ជូន ចំពោះ ប្រជាជន និង ប្រទេសជាតិ យ៉ាង សកម្ម ។
លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន បាន លើកឡើង ថា បន្ទាប់ ភារកិច្ច បង្ការ បង្ក្រាប សង្គ្រោះ កម្លាំង បាន បន្ត ចូលរួមចំណែក បន្ថែម លើ កិច្ចការ មនុស្សធម៌ ដែល ជា កត្តា ចាំបាច់ បន្ទាប់ពី ការងារ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ដែល សកលលោក កំពុង ប្រយុទ្ធ ប្រឆាំង ទាំងអស់ គ្នា ។
ប្រជាពលរដ្ឋ មូលដ្ឋាន សុំឲ្យ មន្រ្តី ជំនាញ ចុះ ពិនិត្យ ការដ្ឋាន ខ្សាច់ មួយ កន្លែង នៅក្នុង ស្រុក ឱរ៉ាល់ សង្ស័យ មិន មាន ច្បាប់ ទម្លាប់ ត្រឹមត្រូវ
( កំពង់ស្ពឺ ) ៖ ការដ្ឋាន បក ខ្សាច់ មួយ កន្លែង មាន ឈ្មោះ ថា លក្ខិណា ស្ថិត នៅក្នុង ភូមិ ពាម រស់ ឃុំ រស្មី សាមគ្គី ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ត្រូវបាន ប្រជាពលរដ្ឋ លួច រាយការណ៍ ថា បាន បើក ដំណើរ រាប់ ឆ្នាំ សង្ស័យ មិន មាន ច្បាប់ ទម្លាប់ ត្រឹមត្រូវ និង អាជ្ញា បណ្ណ នោះ ឡើយ និង សូមឲ្យ មន្រ្តី ជំនាញ ព្រមទាំង អាជ្ញាធរ ពាក់ព័ន្ធ ចុះ ពិនិត្យ ជាក់ស្តែង ផង ។
តែ ទោះជា យ៉ាងណា ថ្លែង ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ប្រចាំ ខេត្ត កំពង់ស្ពឺ តាម ទូរសព្ទ័ នៅ ព្រឹក ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២១ ម្ចាស់ ការដ្ឋាន បក ខ្សាច់ លក្ខិណា បាន បញ្ជាក់ ថា ទីតាំង ការដ្ឋាន របស់ លោក ជា ទីតាំង អាជីវកម្ម ចាស់ មាន អាជ្ញាបណ្ណ ត្រឹមត្រូវ តែ បាន ផុត សុពលភាព ទៅ ហើយ ។
លោក ថា ប៉ុន្តែ ក្រោយ បញ្ចប់ សុពលភាព ក្រុមហ៊ុន របស់ លោក បាន និង កំពុង រត់ ច្បាប់ ដើម្បី សុំ អាជ្ញាបណ្ណ ថ្មី នៅលើ ទីតាំង មួយ កន្លែង ផ្សេង ទៀត ដោយ ទិញ ដី ម្ខាង ស្ទឹង ពី បុគ្គល ម្នាក់ ស្ថិត ក្បែរ ទីតាំង ចាស់ ។ ខណៈ កំពុង រង់ចាំ អាជ្ញា បណ្ណ ក្រុមហ៊ុន ក៏ ឆ្លៀត ឱកាស ដំណើរការ បណ្តើរ ៗ ទំរាំ អាជ្ញា បណ្ណ ធ្លាក់ មកដល់ តែ មន្ទីរ ជំនាញ រ៉ែ និង ថាមពល ខេត្ត ក៏ មិន ឱ្យ រួច ខ្លួន ដែរ គឺ ពួកគេ នឹង វាស់វែង ឡើងវិញ ពេល ឯកសារ មកដល់ ។
លោក មុត ឡុង ប្រធាន សមាគម ខ្សាច់ ប្រចាំ នៅ តំបន់ នោះ ក៏ បាន បញ្ជាក់ ថា លោក មិន ច្បាស់ ពី បញ្ហា ច្បាប់ ទម្លាប់ របស់ ក្រុមហ៊ុន ទេ ដោយ សមាគម មាន តួនាទី ក្នុង ការពិនិត្យមើល តែ ផល ប៉ះពាល់ ផ្សេង ៗ ជាមួយ ពលរដ្ឋ ឬ ការខូចខាត ផ្លូវ ក្នុង ការដឹកជញ្ជូន ប៉ុណ្ណោះ ប៉ុន្តែ លោក គិត ថា ធម្មតា បើ ក្រុមហ៊ុន គ្មាន ច្បាប់ ប្រហែលជា មិន អាច ដំណើរការ បាន ទេ ប្រាកដជា មន្ត្រី នៃ មន្ទីរ ជំនាញ ចុះ ដកហូត ជា មិន ខាន ។
សេចក្ដីជូនដំណឹង របស់ ក្រសួង ការងារ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃ នេះ បាន ឲ្យដឹង ថា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ កម្មករ និយោជិត ដែល ត្រូវ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដូស ទី២នោះ ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស ត្រូវ អនុញ្ញាតឲ្យ កម្មករ និយោជិត ឈប់ សម្រាក ចំនួន ១ ថ្ងៃ ដោយ មាន ប្រាក់ ឈ្នួល ដើម្បី ទៅ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដូស ទី២ តាម ទីតាំង ដែល ធ្លាប់ ចាក់ដូសទី១ និង តាម ថ្ងៃ កំណត់ ក្នុង ប័ណ្ណ ចាក់ វ៉ាក់សាំង ។
ក្រសួង សង្កត់ធ្ងន់ ថា « ការរារាំង បុគ្គល ណា ម្នាក់ មិន ឲ្យ ទៅ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ គឺ ល្មើស នឹង ច្បាប់ ស្តីពី វិធានការ ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ និង ជំងឺ ឆ្លងកាច សាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត . ច្បាប់ ស្តីពី ការងារ . និង លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ នឹង កាតព្វកិច្ច ក្នុង ការទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ » ។
ក្រសួង ការងារ បន្ថែម ថា ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស ត្រូវ ជួយ ជំរុញ និង អនុញ្ញាត ឲ្យ កម្មករ និយោជិត ទៅ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដូស ទី២ តាម ទីតាំង ដែល ធ្លាប់ ចាក់ដូសទី១ និង តាម ថ្ងៃ កំណត់ ដែល មាន សរសេរ ក្នុង ប័ណ្ណ ចាក់ វ៉ាក់សាំង ។ បើ មិន ដូច្នេះ ម្ចាស់ ឬ រោងចក្រ សហគ្រាស នឹង ត្រូវ ទទួល ពិន័យ ជា ប្រាក់ និង ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ តាម ច្បាប់ ជាធរមាន ។
ជាមួយគ្នា នេះ ក្រសួង ការងារ ក៏ សូម កម្មករ និយោជិត ទាំងអស់ ដែល បាន ទៅ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ រួច មេត្តា ថែរក្សា ប័ណ្ណ ចាក់ វ៉ាក់សាំង ឲ្យបាន ល្អ ដើម្បី ប្រើប្រាស់ ជា ផលប្រយោជន៍ នៅពេល ខាងមុខ ៕ នាយ ឧត្តមសេនីយ៍ សៅ សុខា បញ្ជា ឲ្យ កម្លាំង តាម ចាប់ បុគ្គល អាវុធហត្ថ ខេត្ត កំពង់ធំ ម្នាក់ ក្រោយ ចាក់ អតីត ភរិយា បណ្ដាលឲ្យ របួស ធ្ងន់
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស នៅ រសៀល ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ថា កម្លាំង អាវុធហត្ថ ជំនាញ កំពុង ស្រាវជ្រាវ តាម ចាប់ខ្លួន បុគ្គល អាវុធហត្ថ ខេត្ត កំពង់ធំ ម្នាក់ ដែល ចាក់ អតីត ភរិយា បណ្ដាលឲ្យ រងរបួស ធ្ងន់ ។
សូម ជម្រាប ថា មន្ត្រី កងរាជអាវុធហត្ថ ម្នាក់ នៅ ស្រុក សណ្តាន់ បាន យក កាំបិត ចាក់ អតីត ភរិយា ជាច្រើន កាំបិត បណ្តាលឱ្យ រងរបួស ធ្ងន់ ហើយ ស្រ្តី រងគ្រោះ ត្រូវបាន សាច់ញាតិ បញ្ជូន មក ព្យាបាល នៅ មន្ទីរពេទ្យ ឯកជន ។ ករណី អំពើហិង្សា នេះ បាន កើតឡើង នៅ ភូមិ ត្បូង ទឹក ឃុំ មាន រិទ្ធ ស្រុក សណ្តាន់ ខេត្ត កំពង់ធំ នា ថ្ងៃទី ២៣ ខែឧសភា ឆ្នាំ ២០២១ ។
ស្ត្រី រងគ្រោះ ឈ្មោះ កួច មួយ ហៀក អាយុ៣០ ឆ្នាំ រស់ នៅ ភូមិ ឃុំ កើត ហេតុ បាន បញ្ជាក់ ថា ជន បង្ក ជា អតីត ប្តី មាន ឈ្មោះ ស្រ៊ុន ពេជ្រ រស្មី អាយុ ៣៦ ឆ្នាំ មុខរបរ ជា មន្ត្រី កងរាជអាវុធហត្ថ ខេត្ត កំពង់ធំ ប្រចាំ ការ នៅ ស្រុក សណ្តាន់ ។
បច្ចុប្បន្ន ស្ត្រី រងគ្រោះ ត្រូវបាន បញ្ជូន មក ព្យាបាល នៅ មន្ទីរពេទ្យ ឯកជន ស្រុក សណ្តាន់ ដោយ រងរបួស ធ្ងន់ ចំដៃ ឆ្វេង ពីរ កាំបិត ខាងស្តាំ ពីរ កាំបិត និង កញ្ចឹងក មួយ កាំបិត ផងដែរ ។ ដោយឡែក ជន បង្កបន្ទាប់ពី ធ្វើ សកម្មភាព វាយប្រហារ មក លើ អតីត ប្រពន្ធ រួច បាន រត់ គិត ខ្លួន បាត់ ស្រមោល ។
ជាមួយគ្នា នេះ លោក វរសេនីយ៍ ត្រី ផុន សុផល ប្រធាន ការិយាល័យ ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ធំ បាន បញ្ជាក់ នា ថ្ងៃទី ២៤ ខែឧសភា នេះ ថា ពិតជា មាន ករណី ហិង្សា នេះ កើតឡើង ក្នុង មូលដ្ឋាន ស្រុក សណ្តាន់ ប្រាកដ មែន ពេលនេះ ជន បង្កហេតុ កំពុង រត់គេចខ្លួន មិន ទាន់ ចាប់ បាន នៅឡើយ ហើយ កម្លាំង កំពុងតែ ធ្វើការ យ៉ាង យកចិត្ត ទុក ដើម្បី ចាប់ ជន បង្ក យកមក ចំណាត់ការ តាម ផ្លូវ ច្បាប់ ដើម្បី រក យុត្តិធម៌ ជូន ជនរងគ្រោះ ។
គួរ បញ្ជាក់ ថា ជន បង្ក ស្រ៊ុន ពេជ្យ រស្មី រូប នេះ តែងតែ ប្រើ អំពើហិង្សា ជាញឹកញាប់ លើ ស្រ្តី រងគ្រោះ រហូត មាន ការលែងលះ ៕
រដ្ឋបាល ខេត្ត កំពង់ចាម រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នក កើត កូវីដ ៥៥នាក់
ពេល បើក ដំណើរការផ្សារ រដ្ឋ ឡើងវិញ នេះ និង ដើម្បី ចៀស បាន ការឆ្លង កូវីដ១៩ . លោកស្រី កែវ សុខ ពិសី អភិបាល រង រាជធានី ភ្នំពេញ តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ចុះ ត្រួតពិនិត្យ ស្ថានភាព ក្នុង ផ្សា ទួល ទំពូង នៅ ខណ្ឌ ចំការមន និង បាន ជំរុញ ឱ្យ គណ:កម្មការគ្រប់គ្រង ផ្សារ ទួល ទំពូង អនុវត្ត តាម ការណែនាំ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ជាពិសេស ពាក់ព័ន្ធ វិធានការ របស់ ក្រសួង សុខាភិបាល « ៣ការពារ និង ៣កុំ » ។
លោកស្រី បាន ណែនាំ ឱ្យ មាន ការផ្សព្វផ្សាយ តាម រយ : សារ សម្លេង អប់រំ និង វាស់ កំដៅ នៅ តាម ច្រក ចេញ ចូល ផ្សារ និង ត្រូវ រក្សា គម្លាត ពី គ្នា ជា ចាំបាច់ ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ។
ប្រធាន គណៈកម្មការគ្រប់គ្រង ផ្សារ ទួល ទំពូង លោក ចំរើន សុខ លីម បាន ឱ្យដឹង ថា ផ្សារ ទួល ទំពូង ចាប់ផ្តើម លក់ នៅ ព្រឹក នេះ គឺ បាន គោរព តាម វិធាន សុខាភិបាល និង ការណែនាំ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ។ លោក ថា « ច្រក ចូល ផ្សារ ចំនួន ៥ ត្រូវបាន បើក ទ្វារ សំរាប់ អាជីវករ ឲ្យបាន លក់ដូរ និង ទំនិញ ឧបភោគ បរិភោគ ដោយ នៅ តាម ច្រក ចេញ ចូល យើង បាន ចាត់ចែង ឲ្យ មាន កម្លាំង សន្តិសុខ ជួយ សម្រួល ដោយ ការបាញ់ កម្តៅ លាង អាល់កុល និង ធ្វើ ការ ស្កេន QR កូដ ផងដែរ មុននឹង អនុញ្ញាតឱ្យ អាជីវករ ចូល ទិញ លក់ នៅក្នុង ផ្សារ » ។
លោក ប្រធាន ផ្សារ ទួល ទំពូង បាន បន្ថែ ថា « ក្រៅពី អនុវត្ត វិធាន សុខាភិបាល នៅ តាម ច្រក ក៏ មាន ដាក់ មេក្រូ បំពង សំលេង ពី សារ អប់រំ និង មាន ការដើរ ផ្សព្វផ្សាយ តាម មេក្រូ ដល់ អ្នកលក់ និង អ្នកទិញ ផងដែរ ដោយ ត្រូវ ដាច់ខាត អនុវត្ត វិធាន « ៣កាពារ និង ៣កុំ » សំដៅ ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ » ។
លោក ចំរើន សុខ លីម បាន ឱ្យដឹង ទៀត ថា ក្នុង ផ្សារ ទួល ទំពូង មាន តូប ចំនួន ១៣៧៤ តូប ហើយ សំរាប់ ថ្ងៃ បើក លក់ ជាថ្មី មាន អាជី រករ មក លក់ដូរ ប្រមាណ ៥០ ភាគរយ លោក បាន បញ្ជាក់ ផងដែរ ថា ក្រុម អាជីវក ដែល លក់ដូរ នៅក្នុង្សា រ ក៏ បាន ចាក់ វ៉ាក់សាំង បាន ប្រមាណ ១១០០ នាក់ ហើយ ដែរ ។
ដោយឡែក សម្រាប់ ផ្សារ បឹងកេងកង វិញ លោក ឯក និមល ប្រធាន គណៈកម្មការគ្រប់គ្រង ផ្សារ ក៏ បាន បញ្ជាក់ ឱ្យដឹង ដែរ ថា នៅ ផ្សារ បឹងកេងកង បាន ដំណើរការ ហើយ នៅ ព្រឹក ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២១ តែ លក់ តែ គ្រឿង ហូបចុក តែ ប៉ុណ្ណោះ ដោយ អាជីវករ មក លក់ដូរ ចំនួន ៧៦ តូប ។
ជាមួយគ្នា នោះ លោក គួច ចំណាន ប្រធាន គណៈកម្មការគ្រប់គ្រង ផ្សារ ច្បារអំពៅ បាន បញ្ជាក់ ថា ផ្សារ ច្បារអំពៅ មាន បងប្អូន អាជីវករ មក លក់ ប្រមាណ ២០ ភាគរយ ប៉ុណ្ណោះ ដោយ លក់ដូរ ជា គ្រឿង ហូបចុក ។
ដោយឡែក លោកស្រី ប៉ុន ដានី ប្រធាន គណៈ គ្រប់គ្រង ផ្សា ធំ ថ្មី បាន ឱ្យដឹង ថា នៅ ថ្ងៃ បើក ដំណើរការលក់ដូរ នៅ ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២១ ចាប់ពី ម៉ោង ៥៖៣០ នាទី ព្រឹក គិត រហូតដល់ ម៉ោង ១១៖៣០ នាទី ផ្សារ ធំ ថ្មី បាន ចាប់ បើក ថ្ងៃ ដំបូង ផ្នែក គ្រឿង ឧបភោគ បរិភោគ មាន តូប និង គ្រែ ចល័ត សរុប ៦២៥ មក លក់ បាន ១២៥ តូប និង គ្រែ ចល័ត ។
គួរ បញ្ជាក់ ថា លោកស្រី ស៊ូ ជី ស្ថិត ក្នុង ចំណោម មនុស្ស ជាង ៤.០០០ នាក់ ដែល ត្រូវបាន ឃាត់ខ្លួន ចាប់តាំងពី រដ្ឋប្រហារ បាន ផ្ទុះឡើង ហើយ លោកស្រី ប្រឈម ការចោទប្រកាន់ ពី បទល្មើស ជាច្រើន រួម មាន ចាប់ពី ការកាន់ ឧបករណ៍ ទាក់ទង ខុស ច្បាប់ រហូតដល់ ការបំពាន ច្បាប់ ការពារ កិច្ចការ សម្ងាត់ រដ្ឋ ។ យោធា មីយ៉ាន់ម៉ា បាន ទម្លាក់ រដ្ឋាភិបាល លោកស្រី ហើយ ឡើង កាន់អំណាច ក្រោម ការចោទប្រកាន់ ថា មាន ការបន្លំ ក្នុង ការបោះឆ្នោត ដែល គណបក្ស លោកស្រី ទទួល ជ័យជម្នះ កាលពី ខែវិច្ឆិកា ឆ្នាំ មុន ៕
មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ អញ្ជើញ ចុះ ត្រួតពិនិត្យ ក្រុម គ្រូពេទ្យ របស់ អាវុធហត្ថ ខេត្ត ដែល ចូលរួម យក សំណាក ប្រជាពលរដ្ឋ
ក្នុង ឱកាស នោះ ដែរ លោក ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន បាន ប្រគល់ ប្រាក់ ឧបត្ថម្ភ ជូន ដល់ ក្រុម គ្រូពេទ្យ ទាំង ៣ អង្គភាព ចំនួន ៣១ នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ចំនួន ១០.០០០០ រៀល ផងដែរ ៕
មន្ត្រី កងរាជអាវុធហត្ថ ខេត្ត កំពង់ធំ ម្នាក់ ចាក់ អតីត ភរិយា បណ្តាលឲ្យ រងរបួស ធ្ងន់ . កម្លាំង សមត្ថកិច្ច កំពុង តាម ចាប់ខ្លួន
