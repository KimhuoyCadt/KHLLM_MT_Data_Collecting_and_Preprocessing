( កំពង់ឆ្នាំង ) ៖ បុរស ម្នាក់ ត្រូវបាន រកឃើញ មាន វិជ្ជមាន កូវីដ១៩ កាលពី ថ្ងៃទី ៣ ខែឧសភា ឆ្នាំ ២០២១ បន្ទាប់ពី រូប គាត់ មាន អាការៈ មិន ស្រួល ខ្លួន ខ្លាំង ក៏ បាន ជិះ ម៉ូតូ ឌុប ប្រពន្ធ មកកាន់ មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង ដើម្បី សុំ ពិនិត្យ សំណាក ហើយ ត្រូវបាន គ្រូពេទ្យ រកឃើញ បុរស ជា ប្ដី វិជ្ជមាន កូវីដ រីឯ ស្ត្រី ជា ប្រពន្ធ អវិជ្ជមាន តាម ការធ្វើតេស្ត បន្ទាន់ ។
លោក វេជ្ជបណ្ឌិត គង់ ចន័្ទ ធា ប្រធាន ការិយាល័យ បង្ការ និង គ្រប់គ្រង ជំងឺ នៃ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង បាន បញ្ជាក់ ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ ព្រឹក ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២១ នេះ ថា អ្នកជំងឺ មាន ឈ្មោះ ឃ ន ពិសិដ្ឋ អាយុ ២៩ ឆ្នាំ មាន ទីលំនៅ ក្នុង ភូមិ ភ្នំ តូច ឃុំ ពង្រ ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង រកឃើញ វិជ្ជមាន កូវីដ១៩ នៅ ថ្ងៃទី ៣ ខែឧសភា ឆ្នាំ ២០២១ ។
កាលពី ថ្ងៃទី ២ ខែឧសភា អ្នកជំងឺ រូប នេះ បាន ជិះ ម៉ូតូ ឌុប ប្រពន្ធ ចូលមក ក្នុង មណ្ឌល ចត្តាឡី ស័ក សាលា គំរូ ក្រុង កំពង់ឆ្នាំង ដោយ បង្ខំ ឲ្យ ក្រុម គ្រូពេទ្យ ពិនិត្យ សំណាក គាត់ និង ប្រពន្ធ ភ្លាម ៗ ដោយសារតែ គាត់ មាន អាការៈ មិន ស្រួល ខ្លួន ខ្លាំង តែ ដោយ យប់ ហើយ គ្រូពេទ្យ ក៏ បាន រៀបចំ កន្លែង ឲ្យ សម្រាក នៅក្នុង បណ្ដូល ច័ តាឡី ស័ក លុះ ព្រឹកឡើង ក្រុម គ្រូពេទ្យ បាន ពិនិត្យ សំណាក អ្នក ទាំង ពីរ នាក់ ប្ដី ប្រពន្ធ ដោយ រកឃើញ ប្ដី វិជ្ជមាន កូវីដ១៩ រីឯ ប្រពន្ធ អវិជ្ជមាន ( ពិនិត្យ លើក ទី១) ។
លោក វេជ្ជបណ្ឌិត បាន បន្ត ឲ្យដឹង ទៀត ថា ថ្ងៃ នេះ ក្រុម គ្រូពេទ្យ នឹង ចុះ ទៅ ឃុំ ពង្រ ដើម្បី ពិនិត្យ សំណាក ជូន ប្រជាពលរដ្ឋ ដែល បាន ជាប់ពាក់ព័ន្ធ ជាមួយនឹង បុរស ខាងលើ ។ ឆ្លៀត ឱកាស នេះ លោក វេជ្ជបណ្ឌិត បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ នៅ ភូមិ ភ្នំ តូច ឃុំ ពង្រ ស្រុក រលាប្អៀរ ដែល បងប្អូន ដឹង ថា ខ្លួន ឯង បានជាប់ពាក់ព័ន្ធ ជាមួយនឹង បុរស ខាងលើ នេះ សូមអញ្ជើញ មក ពិនិត្យ សំណាក ជា បន្ទាន់ ចៀសសវាង ការឆ្លង រីករាលដាល ដល់ ក្រុមគ្រួសារ និង សហគមន៍ ។
លោក អធិការ បាន បន្ត ឲ្យដឹង ទៀត ថា រយៈពេល ៤ ថ្ងៃ មុន ពេល រកឃើញ ឈ្មោះ ឃុន ពិសិដ្ឋ ជា ប្ដី វិជ្ជមាន កូវីដ១៩ គាត់ បាន ហៅ គ្រូពេទ្យ ឯកជន តាម ភូមិ មក ចាក់ ថ្នាំ នៅ ផ្ទះ ជាច្រើន ដង ហើយ កូន របស់ លោកគ្រូពេទ្យ ក៏ ជា កម្មការិនី រោង ចក្រ នៅក្នុង ក្រុង កំពង់ឆ្នាំង ផងដែរ ។
តែ ទោះជា យ៉ាងណា ក៏ដោយ ថ្ងៃ នេះ ក្រុម គ្រូពេទ្យ នៃ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង បាន ចុះ ទៅ ពិនិត្យ សំណាក ប្រជាពលរដ្ឋ ដែល មាន ការពាក់ព័ន្ធ ជាមួយនឹង ឈ្មោះ ឃ ន ពិសិដ្ឋ ដូច្នេះ សូម បងប្អូន អញ្ជើញ រួសរាន់ មក ពិនិត្យ សំណាក នៅ មណ្ឌល សុខភាព ពង្រ នៅ ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២១ នេះ កុំបី ខាន ៕
ខេត្ត ត្បូងឃ្មុំ រកឃើញ មនុស្ស ៣នាក់ បន្ថែម ទៀត ឆ្លង ជំងឺ កូវីដ១៩ នៅ ស្រុក អូរ រាំង ឪ និង ស្រុក ក្រូចឆ្មារ
មនុស្ស ទាំង៣នាក់ ដែល ទើប រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ នោះ រួម មាន៖
កាលពី ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២១ រដ្ឋាភិបាល ចិន តាមរយៈ រដ្ឋបាល គយ ចិន បាន អនុម័ត ទទួលស្គាល់ ជា ផ្លូវការ នូវ បញ្ជី ឈ្មោះ ចម្ការស្វាយ ចំនួន ៣៧ និង រោងចក្រ វេចខ្ចប់ ចំនួន ០៥ ដែល បាន ចុះបញ្ជី សម្រាប់ នាំចេញ ផ្លែ ស្វាយ ស្រស់ កម្ពុជា ទៅកាន់ ប្រទេស ចិន ។
តាមរយៈ សមត្ថភាព រោងចក្រ វេចខ្ចប់ ទាំង ៥នេះ លោក រដ្ឋមន្ត្រី វេង សាខុន អះអាង ថា កម្ពុជា អាច នាំចេញ ផ្លែ ស្វាយ ស្រស់ បាន ប្រមាណ ១០ម៉ឺន តោន ប៉ុណ្ណោះ ក្នុង ១ ឆ្នាំ ទៅកាន់ ទីផ្សារ ចិន ។ ប៉ុន្តែ លោក រដ្ឋមន្ត្រី បាន ដាក់ ក្តី រំពឹង ថា ក្រុមហ៊ុន ធំ ៗ ជាច្រើន ទៀត នឹង រៀបចំ ដំឡើង រោងចក្រ វេចខ្ចប់ ស្វាយ ហើយ អាច ទទួលបាន ការទទួលស្គាល់ រដ្ឋបាល គយ ចិន ដែល អាចនឹង ធ្វើឲ្យ ចំនួន រោងចក្រ មាន កើនឡើង បរិមាណ នៃ ការនាំចេញ ក៏ កើនឡើង បន្ថែម ទៀត ផងដែរ ។
ផ្លែ ស្វាយ ស្រស់ កម្ពុជា គឺជា ផ្លែ ឈើ ស្រស់ ទី២ បន្ទាប់ពី ផ្លែ ចេក ស្រស់ ដែល អាច នាំចេញ ទៅ ប្រទេស ចិន ដោយ ផ្ទាល់ ។ នេះ គឺជា សមិទ្ធិផល ផ្លែ ផ្កា ថ្មី មួយ ទៀត ដែល ប្រសូត្រ ចេញ ពី កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ ប្រសើរ រវាង កម្ពុជា និង ចិន ៕
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ អំពាវនាវ ឱ្យ ពលរដ្ឋ នៅ តំបន់ ក្រហម មក ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ តាម កាល កំណត់ និង ចៀសវាង នូវ ភាពកកកុញ
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២១ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល រស់ នៅក្នុង តំបន់ ក្រហម នៃ ខណ្ឌ ចំនួន ៤ រួម មាន ៖ ខណ្ឌ ដង្កោ ខណ្ឌ មានជ័យ ខណ្ឌ ពោធិ៍សែនជ័យ និង ខណ្ឌ កំបូល មក ទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ទៅ តាម កាល កំណត់ របស់ អាជ្ញាធរ ដើម្បី ចៀសវាង នូវ ភាពកកកុញ និង អនុវត្ត ឱ្យ បាន ម៉ឺងម៉ាត់ បំផុត នូវ វិធានការ « ៣ការពារ ៣កុំ » ។
ការអំពាវនាវ បែប នេះ របស់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ធ្វើឡើង ចំ ថ្ងៃទី ៤ នៃ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ របស់ ក្រសួង ការពារ ជាតិ ដើម្បី ចាក់ វ់ាក់ សាំង ជូន ប្រជាពលរដ្ឋ កម្មករ កម្ម ការិនី ដែល មាន ចំនួន ជិត ៥០ម៉ឺន នាក់ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៨១ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០៣ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៨១ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ០៤ ខែឧសភា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៨១ នាក់ នោះ មាន ៣៥ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១២ករណី និង ជនសង្ស័យ ៤៦ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៣ករណី ។
បើកបរ កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ម្នាក់ និង របួស ៤នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៣ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៣លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ម្នាក់ និង របួស ធ្ងន់ ស្រាល ៤នាក់ ។
នៅក្រោម វិធានការរឹតត្បិត នា ពេល បច្ចុប្បន្ន នេះ មាន តែ ប្រជាជន មកពី ប្រទេស ចំនួន ប្រាំពីរ ប៉ុណ្ណោះ ដោយ ក្នុង នោះ រួម មាន ប្រទេស អូស្រ្តាលី និង សិង្ហបុរី អាច ចូល សហភាព អឺរ៉ុប បាន នៅ វិស្សមកាល ដោយ មិន គិត ពី ថា តើ ពួកគេ បាន ចាក់ វ៉ាក់សាំង រួច ឬ អត់ ទេ ប៉ុន្តែ ត្រូវ ឆ្លងកាត់ ការធ្វើតេស្ត ឬ ការដាក់ ឱ្យ នៅ ដាច់ដោយឡែក ។
សំណើ ថ្មី ដែល ត្រូវបាន បង្ហាញ ដោយ គណៈកម្មការ អឺរ៉ុប នៅ ថ្ងៃចន្ទ នេះ នឹង អនុញ្ញាតឱ្យ ពលរដ្ឋ បរទេស ដែល បាន ចាក់ វ៉ាក់សាំង ពេញលេញ និង ប្រជាពលរដ្ឋ ដែល មកពី ប្រទេស ដែល មាន ស្ថានភាព ល្អ អាច ចូល ប្លុក នេះ បាន ។
មន្ត្រី សហភាព អ៊ឺរ៉ុប ម្នាក់ បាន និយាយ ថា « យើង ចង់ ធ្វើ រឿង នេះ មុនពេល ការធ្វើដំណើរកម្សាន្ត នា រដូវ ក្តៅ ដ៏ ធំ ខាងមុខ បាន ចាប់ផ្តើម » ។
គួរ បញ្ជាក់ ថា រដ្ឋ ជា សមាជិក សហភាព អឺរ៉ុប ទាំង ២៧ គ្រោង នឹង ចាប់ផ្តើម ពិភាក្សា លើ សំណើរ នេះ នៅ ថ្ងៃអង្គារ សប្តាហ៍ នេះ តែម្តង ដោយ សង្ឃឹម ថា វា នឹង ត្រូវបាន អនុម័ត នៅ ខែ នេះ ៕
រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ថ្មី ម្នាក់ ទៀត នៅ សៀមរាប
មកទល់ ពេលនេះ ខេត្ត សៀមរាប មាន អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន ៤៧ នាក់ បាន ព្យាបាល ជាសះស្បើយ ចំនួន ១៦ នាក់ ស្លាប់ ១នាក់ និង ៣០ នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប ។
( កោះកុង ) ៖ កម្លាំង សមត្ថកិច្ច ប្រចាំ ការ នៅ ប៉ុស្ដិ៍ អូរ ជ្រៅ ខេត្ត កោះកុង បាន ប្រើ តេស្ដរហ័ស លើ បុរស ម្នាក់ ដែល ជា អ្នកធ្វើដំណើរ តាម ដងផ្លូវ ស្រាប់តែ រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ នៅ ល្ងាច ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ នេះ ។
អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ នេះ ឈ្មោះ លីន ប៉ូលីន ភេទ ប្រុស អាយុ ៣៨ ឆ្នាំ រស់ នៅ បន្ទប់ ជួល រោងចក្រ ដំបូល ខៀវ ក្បែរ ផ្សារ កាណាឌីយ៉ា ស្ថិត ក្នុង ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។ បច្ចុប្បន្ន កំពុង ដាក់ សម្រាក ឲ្យ ព្យាបាល នៅ បន្ទប់ ដាច់ដោយឡែក នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក ស្រែ អំបិល និង បាន យក សំណាក បញ្ជូន ទៅ បាស្ទ័រ ដើម្បី បញ្ជាក់ ។
សមត្ថកិច្ច បាន បញ្ជាក់ ជំហ៊ាន ដំបូង ថា បុរស ខាងលើ មាន មុខរបរ ជា អ្នកបើក រថយន្ដ តាក់ ស៉ី និង ដឹក ឥវ៉ាន់ ពី ផ្សារ ថ្មី ទៅ កោះ កុង ហើយ ទើបតែ ដឹក ថ្ងៃ នេះ ប៉ុណ្ណោះ ស្រាប់តែ តេស្ដ រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ តែម្ដង ៕
អាជ្ញាធរ ខេត្ត បាត់ដំបង រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ថ្មី ម្នាក់ ទៀត និង ប្រកាស ឲ្យ អ្នក ពាក់ព័ន្ធ មក ធ្វើតេស្ត រក កូវីដ១៩
( បាត់ដំបង ) ៖ រដ្ឋបាល ខេត្ត បាត់ដំបង នៅ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការ រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ថ្មី ម្នាក់ ទៀត និង ប្រកាស ឲ្យ អ្នក ពាក់ព័ន្ធ មក ធ្វើតេស្ត រក កូវីដ១៩ ។
អ្នកជំងឺ កូវីដ១៩ ដែល ទើប រកឃើញ ថ្មី នេះ ឈ្មោះ ឃឹម សាវី ភេទ ស្រី អាស័យដ្ឋាន ភូមិ ថ្មី ឃុំ ម៉ាឡៃ ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ មក ពី ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ មក សំរាក ព្យាបាល ជំងឺ នៅ មន្ទីរ សំរាក ព្យាបាល សំពៅ លូន ( សេវា ២៤ ម៉ោង ) ហើយ ត្រូវបាន សង្ស័យ ថា ឆ្លង ជំងឺ កូវីដ - ១៩ ទើប យក សំណាក មក ពិនិត្យ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង ។
ក្នុង អំឡុង ពេល ពិនិត្យ សំណាក ក្រុមគ្រួសារ ក៏ បាន ដឹក ចេញ ពី មន្ទីរ សំរាក ព្យាបាល សំពៅ លូន ( សេវា ២៤ ម៉ោង ) យក ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក សំពៅលូន បាន រយៈពេល ១យប់ ទើប ចេញ លទ្ធផល ថា មាន វិជ្ជមាន ជំងឺ កូវីដ - ១៩ ។ បច្ចុប្បន្ន អ្នកជំងឺ ដែល ឆ្លង វីរុស វីដ - ១៩ នេះ បាន បញ្ជូន មក សំរាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង រួចហើយ ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន សម្រេច បិទ បញ្ចប់ ការបិទ ខ្ទប់ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល ហើយ ដោយ ចាប់ អនុវត្ត ពី ថ្ងៃទី ០៦ ខែឧសភា ប៉ុន្តែ តំបន់ ប្រឈម ខ្លាំង មួយចំនួន អាច នៅ បន្ត បិទ ខ្ទប់ ។
ការសម្រេច បិទ បញ្ចប់ ការបិទ ខ្ទប់ (Lockdown) នេះ បាន អនុញ្ញាតឱ្យ ពលរដ្ឋ ទូទៅ អាច ចេញ ចូល - ឆ្លងកាត់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ បាន ប៉ុន្តែ ទោះជា យ៉ាង នេះ ក្តី រាជ រដ្ឋាភិបាល អនុញ្ញាត បន្ត ឱ្យ អនុវត្ត វិធានការដដែល ចំពោះ តំបន់ ទាំង៣ ជាពិសេស តំបន់ លឿង ទុំ និង តំបន់ ក្រហម ។
សេចក្ដីសម្រេច របស់ រាជ រដ្ឋាភិបាល បាន សម្រេច យ៉ាង ដូច្នេះ ថា៖
* ប្រការ១៖ បញ្ចប់ ការបិទ ខ្ទប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល ដែល ត្រូវបាន សម្រេច ដោយ សេចក្តីសម្រេច លេខ ៤៩ សសរ ចុះ ថ្ងៃទី ១៤ ខែមេសា ឆ្នាំ ២០២១ និង សេចក្តីសម្រេច លេខ ៥៤ សសរ ចុះ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២១ របស់ រាជ រដ្ឋាភិបាល ចាប់ពី ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២១ ត ទៅ ។
* ប្រការ ៣៖ បទប្បញ្ញត្តិ ទាំងឡាយ ណា ដែល ផ្ទុយ នឹង សេចក្តីសម្រេច នេះ ត្រូវ ទុក ជា និរាករណ៍ ។
* ប្រការ ៤៖ រដ្ឋមន្ត្រី ទទួលបន្ទុក ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល រដ្ឋមន្ត្រី គ្រប់ ក្រសួង ប្រធាន គ្រប់ ស្ថាប័ន ពាក់ព័ន្ធ អភិបាល នៃ គណៈអភិបាល រាជធានី ភ្នំពេញ និង អភិបាល នៃ គណៈអភិបាល ខេត្ត កណ្តាល ត្រូវ ទទួលបន្ទុក អនុវត្ត សេចក្តីសម្រេច នេះ តាម ភារកិច្ច រៀង ៗ ខ្លួន ចាប់ពី ថ្ងៃ ចុះហត្ថលេខាត ទៅ ៕
( សៀមរាប ) ៖ អាជ្ញាធរ ខេត្ត សៀមរាប បង្ហាញ ពី ការព្រួយបារម្ភ របស់ ខ្លួន ចំពោះ វិបត្តិ នៃ ការឆ្លង រាលដាល ជម្ងឺ កូវីដ - ១៩ក្នុង សហគមន៍ ពិសេស នា រយៈពេល ចុងក្រោយ នេះ ចំនួន នៃ ការរកឃើញ ករណី ថ្មី ៗ ដែល នាំចូល ពី ខេត្ត ដទៃ កើនឡើង ជា បន្តបន្ទាប់ ។ ដើម្បី ទប់ស្កាត់ បញ្ហា នេះ រដ្ឋបាល ខេត្ត បាន បង្កើត ឲ្យ មាន ក្រុមការងារ តាមដាន - ត្រួតពិនិត្យ និង តាមដាន ការ វិលត្រឡប់ មកវិញ របស់ ប្រជាពលរដ្ឋ ក្នុង សង្កាត់ ទាំង ១២ នៃ ភូមិសាស្រ្ត ក្រុង សៀមរាប ។
លោក នាក់ ណេរ៉ុន អភិបាល រង ខេត្ត សៀមរាប បាន បញ្ជាក់ ថា រយៈពេល ប៉ុន្មាន ថ្ងៃ ចុងក្រោយ នេះ ជំងឺ កូវីដ - ១៩ បាន ចម្លង ចូល មកពី ខេត្ត ខាងក្រៅ ចូលមក ក្នុង ខេត្ត សៀមរាប មាន ចំនួន កើនឡើង យ៉ាង ឆាប់រហ័ស ដែល ក្នុង នោះ ប្រមាណ ជា ៤០ % នាំចូល មកពី ខេត្ត ព្រះសីហនុ ដែល ក្នុង នោះ ជា ការកត់សម្គាល់ ផងដែរ គឺជា ការវិលត្រប់ ចូល ស្រុក វិញ នៃ ប្រជាពលរដ្ឋ ខេត្ត សៀមរាប ដែល កន្លងមក បាន ចេញ ទៅ ប្រកប មុខរបរ ឬ ទៅ ធ្វើ ការងារ នៅ ខេត្ត ផ្សេង ៗ ។
មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត ត្រូវ អនុវត្ត ការតាមដាន ត្រួតពិនិត្យ និង សហការ ជាមួយ រដ្ឋបាល ក្រុង - ស្រុក ពិសេស អាជ្ញាធរ មូលដ្ឋាន ភូមិ - សង្កាត់ ក្នុង ភូមិសាស្ត្រ ក្រុង សៀមរាប និង កម្លាំង សមត្ថកិច្ច ពាក់ព័ន្ធ ចាត់ វិធានការ អនុវត្ត តាម វិធាន សុខាភិបាល ចំពោះ ប្រជាពលរដ្ឋ ដែល វិលត្រឡប់ មក ក្នុង ភូមិសាស្ត្រ ក្រុង សៀមរាប ឲ្យ មាន ប្រសិទ្ធភាព និង ទទួលខុសត្រូវ ខ្ពស់ ។
ទោះបីជា យ៉ាងណា ក៏ដោយ ជា គោលការណ៍ នៃ កិច្ចប្រជុំ នោះ អ្នកដំណើរ ចូលក្នុង ក្រុង សៀមរាប ត្រូវតែ ទទួលយក កាតព្វកិច្ច ធ្វើចត្តាឡី ស័ក ១៤ ថ្ងៃ ក៏ប៉ុន្តែ និង អាច មាន ករណី ខ្លះ ស្ថិត ក្នុង ការពិចារណា ត្រួតពិនិត្យ ដោយ ផ្អែក លើ ភាពសំខាន់ និង ចាំបាច់ នៃ បេសកកម្ម អ្នកដំណើរ ដោយ ភ្ជាប់ ជាមួយ នូវ លិខិត បញ្ជាក់ សុខភាព និង មាន ការធានា ខុស ត្រូវ ដោយ ស្ថាប័ន សាម៉ី ច្បាស់លាស់ ពិតប្រាកដ មាន សុវត្ថិភាព មិន បង្ករឲ្យ មាន ការចម្លង ជំងឺ កូវីដ - ១៩ ។
គួរ បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី ៣ ខែឧសភា ខេត្ត សៀមរាប មាន អ្នកជំងឺ កូវីដ - ១៩ ចំនួន ៤៧ នាក់ បាន ព្យាបាល ជាសះស្បើយ ចំនួន ១៦ នាក់ ស្លាប់ ១នាក់ ( ដោយសារ ជំងឺ តម្រងនោម ធ្ងន់ធ្ងរ ) និង ៣០ នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប ៕ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ចុះ ពិនិត្យ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ជូន ប្រជាពលរដ្ឋ នៅ តំបន់ ក្រហម ក្នុង ភូមិសាស្ត្រ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ រួម ដំណើរ ដោយ នាយ ឧត្តមសេនីយ៍ ម៉ក់ សារុន អគ្គ មេបញ្ជាការ រង នៅ ព្រឹក ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន ចុះ ពិនិត្យ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ជូន ដល់ ប្រជាពលរដ្ឋ នៅ តំបន់ ក្រហម ស្ថិត ក្នុង ភូមិសាស្ត្រ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ រួម មាន សង្កាត់ ចោម ចៅ ទី១ សង្កាត់ ចោម ចៅ ទី២ និង សង្កាត់ កាកាប ទី១ ។
នេះ ជា ថ្ងៃទី ៤ហើយ នៃ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង តាម បទបញ្ជា ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ផែនការចាក់ វ៉ាក់សាំង ឲ្យបាន ១០០ ភាគរយ សម្រាប់ ប្រជាពលរដ្ឋ រស់ ក្នុង នៅ រាជធានី ភ្នំពេញ ។ ដោយឡែក នៅ តំបន់ ក្រហម កងទ័ព ទទួល ភារកិច្ច រ៉ាប់រង ចាក់ ជូន ប្រជាពលរដ្ឋ នៅ ៤ខណ្ឌ គឺ ខណ្ឌ ពោធិ៍សែនជ័យ ខណ្ឌ មានជ័យ ខណ្ឌ កំបូល និង ខណ្ឌ ដង្កោ ។
តាម របាយការណ៍ របស់ អនុគណ:កម្មការ ក្នុង រយៈពេល ៣ ថ្ងៃ កន្លងមក នេះ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ នៅ តំបន់ ក្រហម ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ក្រុម ពេទ្យ កងទ័ព ចាក់ វ៉ាក់សាំង ជូន បងប្អូន ប្រជាពលរដ្ឋ បាន ចំនួន ជាង មួយ សែន នាក់ ហើយ តាម ផែនការ ក្រសួង ការពារ ជាតិ នឹង ត្រូវ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នៅ តំបន់ ក្រហម ប្រមាណ ៥២ ម៉ឺន នាក់ និង សម្រេច ឲ្យបាន រួចរាល់ នៅ បំណាច់ ខែឧសភា ឆ្នាំ ២០២១ នេះ ។
ក្នុង ឱកាស ចុះ ពិនិត្យ ការចាក់ វ៉ាក់សាំង នោះ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន ជួប សំណេះសំណាល និង អប់រំ ណែនាំ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មក ទទួល ការចាក់ វ៉ាក់សាំង ទាំងអស់ សុខចិត្ត ស៊ូទ្រាំ រង់ចាំ ការលំបាក ប្រសើរ ជាង មិន បាន ចាក់ វ៉ាក់សាំង ការពារ ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ក៏ បាន ក្រើន រំលឹក ដល់ ក្រុម ប្រតិបត្តិការ តាម បណ្ដា គោលដៅ ទាំងអស់ រួមទាំង ប្រជាពលរដ្ឋ ផង ត្រូវ យកចិត្តទុកដាក់ រៀបចំ សណ្ដាប់ធ្នាប់ ឲ្យបាន ល្អ ពិសេស ការអនុវត្ត វិធានការ សុខាភិបាល ដោយ រក្សា គម្លាត សុវត្ថិភាព បុគ្គល និង តម្រូវឲ្យ ពាក់ ម៉ាស់ ឲ្យបាន គ្រប់ គ្នា ដើម្បី ជៀសវាង ហានិភ័យ ដែល អាច កើត មាន ឡើង ។
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ បាន សំដែង មនោសញ្ចេតនា សប្បាយរីករាយ ជា អនេក ចំពោះ ការទទួលបាន ចាក់ វ៉ាក់សាំង នា ពេលនេះ ដែល ជា របាំង ជួយ ការពារ ខ្លួន ពី ការឆ្លង ជំងឺ កូវីដ - ១៩ ក្រោម កិច្ចខិតខំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី និង បាន ប្តេជ្ញា បន្ត ចូលរួម អនុវត្ត យ៉ាង ខ្ជាប់ខ្ជួន នូវ វិធានការ ៣កុំ និង ៣ការពារ ដើម្បី យកឈ្នះ ជំងឺ កូវីដ - ១៩ ដែល មិន ទាន់ មាន ថ្នាំ ព្យាបាល នៅឡើយ នេះ ៕
សម្រាប់ អ្នក ជាសះស្បើយ ទាំង ៣៦១ នាក់ វិញ រួម មាន នៅ រាជធានី ភ្នំពេញ ៣៥០ នាក់ . ខេត្ត ព្រៃវែង ២នាក់ . ខេត្ត សៀមរាប ១នាក់ និង ខេត្ត បន្ទាយមានជ័យ ៨នាក់ ដោយ ទទួ លទ្ធផល ធ្វើតេស្ត អវិជ្ជមាន ២លើក ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ប៉ុន្តែ ត្រូវ បន្ត ធ្វើចត្តាឡី ស័ក ១៤ ថ្ងៃ ដើម្បី តាមដាន សុខភាព ។
( ភ្នំពេញ ) ៖ អស់ ពី ល្បិច មួយ ចូល ដល់ ល្បិច មួយ ប៉ុន្តែ សុទ្ធសឹងតែ ជា ល្បិច រាក់ កំផែ ល និង នៅលើ គោក ។ អ្នកនយោបាយ តុកាហ្វេ ធ្លាប់ បាន បង្ហាញ ជូន ក្នុង អត្ថបទ មុន រួច ហើយ អំពី ឧបាយកល ទុច្ចរិត របស់ ក្រុម នយោបាយ ឧទ្ទាម ក្រៅ ច្បាប់ ដែល កំពុង ធ្វើ នយោបាយ ចង់ឲ្យ ខ្មែរ ស្លាប់ ដោយសារ កូវីដ - ១៩ តាំងពី ជំងឺ នេះ ចាប់ផ្តើម ផ្ទុះ ដំបូង មក ម្ល៉េះ ប៉ុន្តែ នយោបាយ នេះ តែងតែ ទទួលបរាជ័យ ទាំងស្រុង និង ជារៀងរហូតមក ។
ឥឡូវនេះ ខ្ញុំ ចង់ បង្ហាញ ជ្រុង មួយ ទៀត នៃ ឧបាយកល ទុច្ចរិត របស់ ក្រុម អ្នក នយោបាយ មោហ៍ បាំង នេះ ដែល សារជាតិ របស់ វា នៅតែ ដដែល ដោយ គ្រាន់តែ ប្តូរ រូបភាព បន្តិចបន្តួច ប៉ុណ្ណោះ ពោលគឺ « បើ ធ្វើ អ្វី មិន កើត យ៉ាងហោចណាស់ ក៏ អាច តាម ស៊ីពែ រដ្ឋាភិបាល លោក ហ៊ុន សែន បាន ខ្លះ ដែរ តាមរយៈ « នយោបាយ មាន់ រងាវ មុន ថ្ងៃ រះ » ។
ប៉ុន្តែ រហូតមកទល់ ពេលនេះ រដ្ឋាភិបាល របស់ លោក ហ៊ុន សែន បាន និង កំពុង ខិតខំ ធ្វើ សកម្មភាព គ្រប់ បែបយ៉ាង ដើម្បី កាត់បន្ថយ ករណី ស្លាប់ ដោយសារ រោគ រាតត្បាត ដ៏ កាច សាហាវ នេះ ឲ្យ នៅក្នុង កម្រឹត តិចតួច បំផុត តាម ដែល អាច ធ្វើ បាន ។
លទ្ធផល ដែល ទទួល បាន នៅ ពេល នេះ គឺ កើត ចេញ ពី វិធានការ ដ៏ ម៉ត់ចត់ និង មុត ស្រួច របស់ រដ្ឋាភិបាល នេះ ឯង ។ ក្រឡេក មើល បណ្តា ប្រទេស មួយចំនួន រាប់ ទាំង បណ្តា ប្រទេស ដែល ក្រុម ឧទ្ទាម នយោបាយ កំពុង ជ្រកកោន ផង មាន មនុស្ស ស្លាប់ រាប់ សែន នាក់ និង រាប់ មឺន សែន ករណី ឆ្លង ក្នុង មួយ ថ្ងៃ ៗ ដោយសារតែ វិធានការ មិន ដិតដល់ របស់ អាជ្ញាធរ និង ការបំពាន វិធានការ ពីសំណាក់ ប្រជាពលរដ្ឋ ។
ល្បិច ទាំងអស់ នេះ ត្រូវបាន ពួកគេ រៀនសូត្រ ពី ចៅហ្វាយ បរទេស ហើយ ត្រូវបាន ប្រើប្រាស់ ដដែល ៗ អស់ រយៈពេល ជាច្រើន ទសវត្សរ៍ មក ហើយ ក្នុង គោលដៅ តែ ម្យ៉ាង គត់ គឺ បើ ពលរដ្ឋ ខ្មែរ ស្លាប់ ច្រើន និង រង ទុក្ខវេទនា ខ្លាំង កាលណា គឺ ពួកគេ រំពឹង ថា នឹង ទទួលបាន ផលចំណេញ នយោបាយ នៅ ពេល នោះ ដែរ ។
ដោយ៖ អ្នកនយោបាយ តុកាហ្វ
ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជន កម្ពុជា ក្រៅ ប្រទេស ឧបត្ថម្ភ ថវិកា ជិត ៨ម៉ឺន ដុល្លារ ជូន ដល់ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យវជន សម្តេច តេជោ
សូម បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី ៣ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ខណ: ដែល ចំនួន អ្នក កើត ជំងឺ កូវីដ - ១៩ កាន់តែ មាន ចំនួន កើនឡើង មាន សប្បុរស ជន ជាច្រើន បាន ចូលរួម ឧបត្ថម្ភ ជា ថវិកា ភេសជ្ជ : អាហារ និង សម្ភារៈ ជូន ដល់ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ (TYDA) ដែល ចូលរួម ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី ជា ការលើកទឹកចិត្ត ចំពោះ កិច្ចខិតខំ ប្រឹងប្រែង ចូលរួម ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ កន្លងមក ៕
មន្ត្រី ក្រសួង ពាណិជ្ជកម្ម ជាង ៦ ពាន់ នាក់ ចាក់ វ៉ាក់សាំង ដូស ទី២ រួច រាល់ . លោក ប៉ាន សូរស័ក្តិ បង្ហាញ វីរភាព សម្តេច តេជោ ក្នុង ការរក វ៉ាក់សាំង ចាក់ ជូន ប្រជាពលរដ្ឋ
( ភ្នំពេញ ) ៖ មន្ត្រី ក្រសួង ពាណិជ្ជកម្ម ចំនួន ៦.៤៦២ នាក់ បាន ចាក់ វ៉ាក់សាំង ដូស ទី២ រួចរាល់ ហើយ ។ ដំណើរការចាក់ វ៉ាក់សាំង ដូស ទី២ ជូន មន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន បិទ បញ្ចប់ នៅ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ជាមួយ ភាពល្អ ប្រសើរ បំផុត ។
ពិធី ប្រកាស បិទ បញ្ចប់ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ប៉ាន សូរស័ក្ដិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម អម ដោយ ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ ក្រសួង ពាណិជ្ជកម្ម ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិការ នៃ អនុគណកម្មការ ចំពោះ កិច្ច ព្រមទាំង ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត នៃ សម្ព័ន្ធ គ្រូពេទ្យ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស. គ.ស.ស .យ .ក ) ជាច្រើន រូប ទៀត ។
យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ នេះ សម្រាប់ ក្រសួង ពាណិជ្ជកម្ម បាន ធ្វើឡើង សម្រាប់ ដូសទី១ ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ៣ ដល់ ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២១ និង ដូស ទី២ ចាប់ពី ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០២១ ដល់ ថ្ងៃទី ៣ ខែឧសភា ឆ្នាំ ២០២១ ។
សម្រាប់ ការចាក់ដូស ទី២នេះ នៅ ទីតាំង ក្រសួង ពាណិជ្ជកម្ម នេះ មិន ត្រឹមតែ មន្ត្រីរាជការ នោះ ទេ ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ក៏ បាន ទៅ ចាក់ នៅ ទីតាំង ក្រសួង ផងដែរ ។
ក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ ដល់ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន ដែល បាន ប្រឹងប្រែង អស់ កម្លាំង កាយ ចិត្ត ស្វះស្វែងរក វ៉ាក់សាំង ជា បន្តបន្ទាប់មក ចាក់ ជូន មន្ត្រីរាជការ ក៏ ដូចជា ប្រជាពលរដ្ឋ ទូទៅ ។ លោក ប៉ាន សូរស័ក្តិ បាន លើកឡើង ថា កម្ពុជា ជា ប្រទេស ចំណាត់ថ្នាក់ លេខ ២នៅ អាស៊ាន ដែល បាន ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ បាន ច្រើន ។
លោក បន្ត ថា លទ្ធផល នៃ ការចាក់ វ៉ាក់សាំង ដែល សម្រេចបាន នេះ គឺជា លទ្ធផល កើត ចេញពី ការគិតគូរ យ៉ាង់ ម៉ត់ចត់ ក៏ ដូចជា នយោបាយ ការទូត ដ៏ ច្បាស់លាស់ របស់ សម្តេច តេជោ ហ៊ុន សែន ។ លោក រដ្ឋមន្ត្រី បាន លើកឡើង ថា បើក គ្មាន ការគិតគូរ ច្បាស់ និង គ្មាន ការខិតខំ របស់ សម្តេច តេជោ ច្បាស់ នឹង គ្មាន វត្តមាន ចាក់ ជូន ប្រជាពលរដ្ឋ នោះ ឡើយ ព្រោះ មនុស្ស លើ ពិភពលោក កំពុង ដណ្តើម វ៉ាក់សាំង គ្នា ។
ខេត្ត បាត់ដំបង រកឃើញ មនុស្ស ៥នាក់ បន្ថែម ទៀត ឆ្លង ជំងឺ កូវីដ១៩ នៅ ស្រុក សង្កែ
មនុស្ស ទាំង ៥នាក់ ដែល ទើប រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ នោះ រួម មាន៖
រដ្ឋបាល ខេត្ត បាត់ដំបង បាន បញ្ជាក់ ថា ពួកគាត់ ជា ពលករ ដែល វិលត្រឡប់ មកពី ប្រទេស ថៃ កាលពី ថ្ងៃទី ០១ ខែឧសភា ឆ្នាំ ២០២១ កន្លងទៅ ។ បច្ចុប្បន្ន ក្រុម គ្រូពេទ្យ បាន និង កំពុង ស្វែងរក អ្នក ដែល ប៉ះពាល់ ជាមួយ អ្នកជំងឹ នៅ តាម មណ្ឌល ចត្តាឡី ស័ក មួយចំនួន ទៀត ដែល បាន ពាក់ព័ន្ធ ជាមួយ បុគ្គល ខាងលើ ។
គួរ ជម្រាប ថា ចាប់តាំងពី មាន ការផ្ទុះ ជំងឺ កូវីដ១៩ ខេត្ត បាត់ដំបង មាន អ្នកជំងឺ កូវីដ១៩ ចំនួន ៣៥ នាក់ បាន ជាសះស្បើយ ចំនួន ២៨ នាក់ និង កំពុង សម្រាក ព្យាបាល ចំនួន ៧នាក់ ៕ ក្រុម ប្រទេស G7 ចង់ បង្កើត សម្ព័ន្ធភាព ថ្មី មួយ ដើម្បី ប្រកួតប្រជែង ជាមួយ ចិន និង រុស្ស៊ី
( ឡុងដ៍ ) ៖ ក្រុម ប្រទេស G7 មាន បំណង បង្កើត សម្ព័ន្ធភាព ថ្មី មួយ ដើម្បី ប្រកួតប្រជែង ជាមួយ ចិន និង រុស្ស៊ី ដោយ មិន ចង់ គ្រប់គ្រង ឬ រារាំង ការអភិវឌ្ឍ របស់ ចិន ខណៈ បន្ត រក្សា ទំនាក់ទំនង ប្រកបដោយ ស្ថិរភាព ជាមួយ រុស្ស៊ី ។ នេះ បើ តាម សម្តី រដ្ឋមន្ត្រី ការបរទេស អាមេរិក ដកស្រង់ និង ចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ព្រឹក ថ្ងៃអង្គារ ទី ០៤ ខែឧសភា ឆ្នាំ ២០២១ ។
គួរ បញ្ជាក់ ថា កិច្ចប្រជុំ កំពូល G7 ដែល កំពុង ប្រព្រឹត្តទៅ ក្នុង ទីក្រុង ឡុងដ៍ ចក្រភព អង់គ្លេស នឹង ពិភាក្សា ដោយ ផ្ដោត ជា សំខាន់ លើ ចិន រុស្ស៊ី រួមទាំង វិបត្តិ COVID-19 និង បញ្ហា បម្រែបម្រួល អាកាសធាតុ ជាដើម ។ ម្យ៉ាង វិញ ទៀត កិច្ចប្រជុំ ក្នុង សប្ដាហ៍ នេះ គឺជា ជំនួប ទល់ មុខ ជា លើក ដំបូង បំផុត ចាប់តាំងពី ឆ្នាំ ២០១៩ ៕
( ភ្នំពេញ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម ប្រកាស អំពី ករណី រកឃើញ កូវីដ១៩ ចំនួន ០៣ នាក់ ក្នុង នោះ ២នាក់ នៅ ស្រុក ចំការលើ និង ០១ នាក់ នៅ ស្រុក ព្រៃឈរ នេះ បើ យោង តាម សេចក្តីប្រកាស ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២១ នេះ ។
ការសម្រេចចិត្ត ខាងលើ កើត មាន ឡើង ក្រោយ មាន ការរិះគន់ ជាច្រើន ថា លោក បៃ ដិន នៅតែ បន្ត រក្សា គោល នយោបាយ អន្តោប្រវេសន៍ មួយចំនួន ដែល សល់ ពី អតីត រដ្ឋបាល លោក ប្រធានាធិបតី ដូណាល់ ត្រាំ ។ នៅ ជំនាន់ លោក ត្រាំ សហរដ្ឋ អាមេរិក យល់ព្រម ទទួល ជន អន្តោប្រវេសន៍ តែ ១៥.០០០ នាក់ ប៉ុណ្ណោះ ។
លោក បៃ ដិន បាន គូសបញ្ជាក់ បន្ថែម នៅក្នុង សេចក្ដីថ្លែងការណ៍ ដូច្នេះ ថា៖ « នេះ ជា ការលុបចោល ជា ប្រវត្តិសាស្ត្រ នៃ ការទទួលយក ជន អន្តោប្រវេសន៍ ក្នុង ចំនួន ដ៏ ទាប ដែល បន្សល់ទុក ដោយ រដ្ឋបាល មុន ត្រឹម ១៥.០០០ នាក់ ដែល មិន បាន ឆ្លុះបញ្ចំាង ពី តម្លៃ របស់ សហរដ្ឋ អាមេរិក ក្នុង នាម ជា ប្រជាជាតិ មួយ ដែល ស្វាគមន៍ និង គាំទ្រ ជន អន្តោប្រវេសន៍ ឡើយ » ។
ប្រជាពលរដ្ឋ ដែល បាន អញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង ក្រៅតែ ពី បាន អរគុណ ក្រុមការងារ ដោយ ផ្ទាល់ មាត់ ហើយ នោះ ពួកគេ បាន បង្កប់ ពាក្យពេចន៍ អរគុណ រាជ រដ្ឋាភិបាល និង ក្រុមការងារ ចាក់ វ៉ាក់សាំង នៅក្នុង បណ្ណ ព័ត៌មាន ចាក់ វ៉ាក់សាំង ផងដែរ ។
អ្នកស្រី ឯម រ៉ន អាយុ ៤១ ឆ្នាំ ជា អាជីវករ រស់ នៅ សង្កាត់ កន្ទោក ខណ្ឌ កំបូល ក្នុង បណ្ណ ព័ត៌មាន ចាក់ វ៉ាក់សាំង បាន រំលេច ពាក្យពេចន៍ អរគុណ ជ្រាលជ្រៅ ដល់ រាជ រដ្ឋាភិបាល និង ក្រុមការងារ ចាក់ វ៉ាក់សាំង ។
អ្នកស្រី បាន សរសេរ រៀបរាប់ យ៉ាង ដូច្នេះ « ក្នុង នាម ខ្ញុំ ជា ប្រជាពលរដ្ឋ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ រដ្ឋាភិបាល ដែល បាន ចាក់ វ៉ាក់សាំង ជូន ដល់ ប្រជាពលរដ្ឋ ឱ្យ បាន ចៀស ផុត ពី ជំងឺ កូវីដ១៩ ។ សូម អរគុណ !» ។
សេចក្តីថ្លែងការណ៍ បាន សរសេរ ថា « បន្ទាប់ពី បាន គិតគូរ យ៉ាង ហ្មត់ចត់ លើ ទំនាក់ទំនង របស់ យើង យើង បាន សម្រេចចិត្ត បញ្ចប់ អាពាហ៍ពិពាហ៍ របស់ ពួកយើង » ។
ជាមួយគ្នា នេះ ក្រសួង ធនធាន ទឹក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម បន្ត ប្រុងប្រយ័ត្ន ចំពោះ បាតុភូត ផ្គរ ន្ទះ និង ខ្យល់ កន្ត្រាក់ ដែល អាច កើតមាន ជាពិសេស បណ្តា ខេត្ត តំបន់ វាល ទំនាប កណ្តាល ៕ ទូទាំង ប្រទេ ស៖ សរុប ការចាក់ វ៉ាក់សាំង កូវីដ១៩ បាន ចំនួន ១. ៤៦៥. ៩៨៥ នាក់ ( គិត ត្រឹម ថ្ងៃទី ០៣ ខែឧសភា )
( ភ្នំពេញ ) ៖ គិត ត្រឹម ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១. ៤៦៥. ៩៨៥ នាក់ នាក់ ។
អភិបាល ខេត្ដ ព្រះសីហនុ ផ្អាក ដំណើរការ បណ្ដោះអាសន្ន រោងចក្រ ចំនួន ២ នៅ តំបន់ សេដ្ឋកិច្ច ពិសេស ក្រុង ព្រះសីហនុ ក្រោយ មាន កម្មករ ឆ្លង ជំងឺ កូវីដ
( ព្រះសីហនុ) ៖ អភិបាល ខេត្ត ព្រះសីហនុ លោក គួច ចំរើន នៅ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន ជូន ដំណឹង ពី ការផ្អាក ជា បណ្ដោះអាសន្ន ដំណើរការ អាជីវកម្ម រោងចក្រ ចំនួន ២ នៅក្នុង តំបន់ សេដ្ឋកិច្ច ពិសេស ក្រុង ព្រះសីហនុ ស្ថិត នៅ ភូមិ ពូធឿង ឃុំ បិត ត្រាំង ស្រុក ព្រៃនប់ ។
ក្នុង អំឡុង ពេល ៤ ថ្ងៃ នេះ ការផ្អាក អាជីវកម្ម នេះ រដ្ឋបាល ខេត្ត ព្រះសីហនុ តម្រូវឲ្យ នាយក រោងចក្រ សហការ ជាមួយ ក្រុមការងារ នៃ មន្ទីរ ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ខេត្ត ដើម្បី ស្វែក រក អ្នក ដែល មាន ការពាក់ព័ន្ធ ជាមួយ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ដើម្បី ផ្ដល់ វត្ថុ សំណាក ។
ចំពោះ បុគ្គលិក កម្មករ និយោជិត ទាំងអស់ របស់ រោងចក្រ ត្រូវ ផ្អាក ការចេញ - ចូល រោងចក្រ ហើយ នៅ ក្រោយពេល ផ្ដល់ វត្ថុសំណាក់ រួចរាល់ ត្រូវ សម្រាក នៅ ផ្ទះ រង់ចាំ រហូតដល់ ការធ្វើ វិភាគ វត្ថុ សំណាក របស់ កម្មករ នៅ រោងចក្រ ដែល មាន ការពាក់ព័ន្ធ គ្រប់ ៗ គ្នា និង មាន លទ្ធផល ផ្លូវការ ទើប អាច បន្ដ ការងារ ជាថ្មី តាម ការជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ៕
គួរ បញ្ជាក់ ថា ពាក្យ ស្នើសុំ ប្រើប្រាស់ បន្ទាន់ របស់ វ៉ាក់សាំង Sinopharm នៅក្នុង ប្រទេស ហ្វីលីពីន នៅតែ ស្ថិត ក្នុង ស្ថានភាព រង់ចាំ នៅឡើយ ប៉ុន្តែ និយតករ ស្បៀងអាហារ និង ឱសថ របស់ ប្រទេស នេះ បាន យល់ព្រម ឲ្យ ប្រើប្រាស់ វ៉ាល់ សាំង នេះ ចំនួន ១០.០០០ ដូស សម្រាប់ ព័ត៌មាន លម្អិត អំពី សុវត្ថិភាព របស់ វា ។
រហូតមកទល់ ពេលនេះ ហ្វីលីពីន បាន កត់ត្រា ករណី ឆ្លង COVID-19 សរុប ចំនួន ១. ០៦លាន ករណី ក្នុង នោះ ស្លាប់ ១៧. ៥២៥ នាក់ ដោយ ឈរ ចំណាត់ថ្នាក់ លេខ ពីរ នៅក្នុង ចំណោម ប្រទេស សមាជិក អាស៊ាន តាម ពីក្រោយ ប្រទេស ឥណ្ឌូនេស៊ី ៕ អាជ្ញាធរ ខេត្ត បន្ទាយមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ១៥៣ នាក់
( បន្ទាយមានជ័យ ) ៖ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បង្ហាញ អត្តសញ្ញាណ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ១៥៣ នាក់ ។
ជាមួយគ្នា នេះ អាជ្ញាធរ ក៏ បាន អំពាវនាវ ដល់ អ្នក ដែល ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ប្រយោល ជាមួយ អ្នកជំងឺ ខាងលើ សូម មក ធ្វើតេស្ត និង ធ្វើចត្តាឡី ស័ក ឲ្យបាន ត្រឹមត្រូវ បើ មាន បញ្ហា សុខភាព សូម រាយការណ៍ ឲ្យ អាជ្ញាធរ ឲ្យបាន ទាន់ ពេលវេលា ៕
សូម អាន សេចក្តីប្រកាស ព័ត៌មាន ទាំង ស្រុង៖ សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១
១៖ ក្រសួង សុខាភិបាល បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី រហូតដល់ ៨៤១ នាក់ ខណៈ អ្នកជំងឺ ចំនួន ៦១ នាក់ ជាសះស្បើយ
៣៖ ក្រសួង សុខាភិបាល ប្រកាស ពី ការស្លាប់ របស់ មនុស្ស ចំនួន ៤នាក់ បន្ថែម ទៀត ដោយសារ ជំងឺ កូវីដ១៩
៥៖ លោក ឃួង ស្រេង៖ ក្រោយ បញ្ចប់ ការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ . តំបន់ ប្រឈម និង តំបន់ ក្រហម នៅ រក្សា ការបិទ ខ្ទប់ ដដែល ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ តែ បង្រួម មក តូច ជាង មុន
៦៖ ប្រទេស ថៃ រាយការណ៍ ពី អ្នកជំងឺ កូវីដ - ១៩ ចំនួន ៣១ នាក់ ស្លាប់ នៅក្នុង របាយការណ៍ ថ្ងៃចន្ទ នេះ
៧៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ស្នើឲ្យ បញ្ឈប់ ជាបន្ទាន់ នូវ ការ ផ្សាយ ព័ត៌មាន វាយប្រហារ លើ រាជ រដ្ឋាភិបាល ពេល កំពុង ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
៨៖ ឥណ្ឌូណេស៊ី រកឃើញ វីរុស កូវីដ - ១៩ បំប្លែង ខ្លួន ថ្មី មាន ប្រភព ដើម នៅ ឥណ្ឌា ២ករណី ក្នុង រដ្ឋធានីហ្សាការតា
៩៖ នាយ ឧត្តមសេនីយ៍ ឈុំ សុជាត៖ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នៅ តំបន់ ក្រហម កំពុង ដំណើរការ យ៉ាង រលូន
១១៖ ចាក់ វ៉ាក់សាំង នៅ តំបន់ ក្រហម៖ ពីរ ថ្ងៃ ចាក់ បាន ជិត ៦ម៉ឺន នាក់ . បន្ថែម ទីតាំង ចាក់ ដល់ ៦០ កន្លែង
១២៖ បក្ស កាន់អំណាច របស់ លោក ម៉ូឌី ចាញ់ ការបោះឆ្នោត ក្នុង រដ្ឋ ដ៏ សំខាន់ មួយ ខណៈ កូវីដ - ១៩ បន្ត ផ្ដាច់ ជីវិត ប្រជាជន ឥណ្ឌា
១៣៖ លោក ជិន ម៉ាលីន ឆ្លើយតប ៣ ចំណុច ទៅនឹង ការរិះគន់ គន់ ដោយ គ្មាន មូលដ្ឋាន ចំពោះ ការអនុវត្ត វិធានការបិទ ខ្ទប់ តំបន់ ក្រហម របស់ អាជ្ញាធរ
១៥៖ រដ្ឋមន្ត្រី ថោង ខុន៖ មួយ សប្ដាហ៍ ក្រោយ ការបើក រមណីយដ្ឋាន មិន ទាន់ មាន ភ្ញៀវ ចេញ ទស្សនា ច្រើន ទេ ខណៈ ម្ចាស់ រមណីយដ្ឋាន និង គោលដៅ ទេសចរណ៍ មួយចំនួន ក៏ នៅ មិន ទាន់ បើក ឡើងវិញ ដែរ
១៦៖ អ្នកវិភាគ ចៅ ចាក់ ស្មុក៖ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ផលិត ដោយ ប្រទេស ណា មិន សំខាន់ សំខាន់ ខ្លាចតែ គ្មាន វ៉ាក់សាំង ចាក់ ជូន ប្រជាពលរដ្ឋ ដើម្បី ការពារ អាយុជីវិត
១៧៖ បទ វិភាគ អន្តរជា តិ៖ អ្វី ដែល ហៅ ថា « ការគាំពារ សិទ្ធិ មនុស្ស » គ្រាន់តែ ជា មុខមាត់ លាក់ ពុត របស់ អ្នកលេង កល ល្បិច លោក ខាងលិច ប៉ុណ្ណោះ
៥៖ ចំណេះដឹង ទូទៅ៖ សត្វ ១០ប្រភេទ ដែល មាន ល្បឿន លឿន បំផុត ក្នុង លោក
៦៖ « រួមគ្នា ការពារ កម្ពុជា ឈ្នះ កូវីដ - ១៩ » បកស្រាយ រួមគ្នា ដោយ ពេជ្រ សោភា និង ឆន សុវណ្ណា រាជ បង្កប់ អត្ថន័យ អំពាវនាវ ឲ្យ បងប្អូន ខ្មែរ ចូលរួម អនុវត្ត តាម គោលការណ៍ ៣ការពារ និង ៣ កុំ
អាជ្ញាធរ សម្រេច បញ្ចប់ ការបិទ ខ្ទប់ ភូមិ ស្នោ ឃុំ ស្នោ ស្រុក ព្រៃ កប្បាស ខេត្ត តាកែវ
( តាកែវ )៖ លោក អ៊ូច ភា អភិបាល ខេត្ត តាកែវ នៅ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តី បញ្ចប់ ការបិទ ខ្ទប់ ភូមិ ស្នោ ឃុំ ស្នោ ស្រុក ព្រៃ កប្បាស ខេត្ត តាកែវ បន្ទាប់ បាន បិទ ខ្ទប់ ជាច្រើន ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៤ ខែមេសា ឆ្នាំ ២០២១មក ។
ជាមួយ ការបញ្ចប់ ការបិទ ខ្ទប់ នេះ លោក អភិបាល ខេត្ត បាន ណែនាំឲ្យ អជ្ញាធរ មូលដ្ឋាន ធ្វើ ការអប់រំ ផ្សព្វផ្សាយ ឲ្យ ប្រជាពលរដ្ឋ ក្នុង ភូមិ នេះ អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ នូវ វិធានការ « ៣កុំ ៣ការពារ » និង សេចក្តីណែនាំ របស់ ក្រសួង សុខាភិបាល ៕
