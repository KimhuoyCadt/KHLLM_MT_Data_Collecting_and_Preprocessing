( ភ្នំពេញ ) ៖ នៅ យប់ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ចេញ សេចក្តីប្រកាស ពិសេស មួយ ដែល បាន លើកឡើង ថា ការចែក អំណោយ ជូន ប្រជាពលរដ្ឋ រស់ នៅ តំបន់ បិទ ខ្ទប់ ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ គឺ គ្មាន ភាព រើសអើង មិន ខ្លាច នឿយហត់ ទាំង ថ្ងៃ ទាំង យប់ ហាល ថ្ងៃ ហាល ភ្លៀង និង មិន ប្រកាន់ និន្នាការ នយោបាយ ។ នេះ បើ យោង តាម សេចក្តីប្រកាស ផ្លូវការ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន យប់ ថ្ងៃសុក្រ នេះ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ចេញមក ច្រានចោល ចំពោះ ការលើកឡើង ដោយ គំនិត អគតិ ដែល មាន ចេតនា បង្ក ចលាចល បំពុល សង្គម និង រារាំង ដល់ ដំណើរការបែងចែក អំណោយ សង្គ្រោះ ជូន ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ បិទ ខ្ទប់ ក្នុង ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ ។
ទន្ទឹម នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ សូម ការយោគយល់ និង អធ្យាស្រ័យ ខ្ពស់ បំផុត ដល់ ម្ចាស់ អំណោយ ដែល មិន អាច ចែកជូន ដល់ ដៃ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ផ្ទាល់ ដោយ ឈរ លើ មូលហេតុ ខ្លាច មាន ការឆ្លង ជំងឺ កូវីដ - ១៩ ដល់ អ្នកចូលរួម ហើយ រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង បន្ត ធ្វើ ការបែងចែក អំណោយ ឱ្យ បាន ចំ គោលដៅ ជូន ប្រជាពលរដ្ឋ ដែល មាន តម្រូវការ ស្បៀងអាហារ បន្ទាន់ ចំពោះ មុខ បន្ត ទៀត ។
ឆ្លៀត ក្នុង ឱកាស នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ សូម ជម្រាប ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ បន្ថែម ទៀត ថា ចាប់ពី ថ្ងៃទី ០១ ខែឧសភា ឆ្នាំ ២០២១ នេះ រាជ រដ្ឋាភិបាល នឹង បើក យុទ្ធនាការ ជាតិ ចាក់ វ៉ាក់សាំង ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ដល់ គ្រប់ ពលរដ្ឋ ទាំងអស់ ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង ទៅ តាម គោលការណ៍ ស្ម័គ្រចិត្ត ។
ដូច្នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ទៅ ទទួលយក វ៉ាក់សាំង ប្រឆាំង កូវីដ - ១៩ តាម ទីតាំង ដែល បាន កំណត់ និង គោរព ឱ្យ បាន នូវ ការ រក្សា គម្លាត សុវត្ថិភាព សង្គម រក្សា បាន នូវ សណ្តាប់ធ្នាប់ ល្អ កុំ ប្រជ្រៀត គ្នា និង គោរព តាម ការណែនាំ របស់ ក្រុម គ្រូពេទ្យ ជំនាញ ៕
សមិទ្ធផល ថ្មី ដែល ជា អតីត សួនច្បារ ១៤មករា បាន និង កំពុង តុបតែង បង្ហើយ កិច្ច ត្រៀម រៀបចំ បង្ហាញ រាង ដើម្បី លើកកម្ពស់ សោភ័ណភាព ក្រុង ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ សមិទ្ធផល ថ្មី « សួន ពោធិ៍សាត់ » ដែល ជា អតីត សួនច្បារ ១៤មករា ព្រមទាំង ហេដ្ឋារចនាសម្ព័ន្ធ បំពេញ បន្ថែម មួយ ចំនួន ទៀត មាន ទីតាំង ជាប់ ស្ពាន ថ្ម ឆ្លង ស្ទឹង ពោធិ៍សាត់ ប្រសព្វ ផ្លូវ លេខ ១០១ និង ផ្លូវ ជាតិ លេខ ៥ ស្ថិត ក្នុង ភូមិ ពាល ញែក១ សង្កាត់ ផ្ទះ ព្រៃ ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ បាន នឹង កំពុង តុបតែង បង្ហើយ កិច្ច ត្រៀម រៀបចំ បង្ហាញ រាង ដើម្បី លើកកម្ពស់ សោភ័ណភាព ក្រុង ពោធិ៍សាត់ ។
ការលើកឡើង បែប នេះ របស់ មន្ត្រី ជាន់ ខ្ពស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន ធ្វើឡើង នៅ ក្រោយពី អង្គការ សង្គម ស៊ីវិល ចំនួន ៣ រួម មាន សមាគម ការពារ សិទ្ធិ មនុស្ស អាដហុក . មជ្ឈមណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា និង មជ្ឈមណ្ឌល សាមគ្គីភាព បាន ចេញ របាយការណ៍ ឆ្នាំ ទី៥ របស់ ខ្លួន អះអាង ថា ពួក ខ្លួន បាន រកឃើញ ថា រដ្ឋាភិបាល បាន ប្រើប្រាស់ ច្បាប់ ដើម្បី កាត់បន្ថយ លំហ សិទ្ធិ និង រឹតត្បិត ការអនុវត្ត សេរីភាព ជា មូល ដ្ឋាន របស់ ប្រជាពលរដ្ឋ ។
ឆ្លេីយតប នឹង ការចោទប្រកាន់ នេះ លោក ជិន ម៉ាលី ន បាន លើកឡើង ៣ ចំណុច អំពី របាយការណ៍ ស្តីពី សេរីភាព ជា មូលដ្ឋាន របស់ CCHR រួម មាន៖
ទី១៖ « ការចេញ របាយការណ៍ នេះ គឺជា រឿង ដដែល ៗ គ្មាន អ្វី ថ្មី នោះ ទេ ដែល ក្រុម និង បក្សពួកគេ តែងតែ ចម្លង និង ចែកចាយ ត គ្នា ពី មួយ ទៅ មួយ ដោយ គ្មាន មូលដ្ឋាន ហើយ ទោះបីជា ចេញ១០ ឆ្នាំ ទៅ មុខ ទៀត ក៏ នៅតែ ដដែល ដែរ ។ វា ជា ការ ឥត ប្រយោជន៍ និង ខ្ជះខ្ជាយ លុយ ដែល ម្ចាស់ ជំនួយ ផ្តល់ លុយ យ៉ាង ច្រើន ជួល អ្នកជំនាញ ការសរសេរ របាយការណ៍ បែប នេះ តែ ទោះជា យ៉ាងណា ក៏ដោយ វា ជា អ្វី ដែល ម្ចាស់ ជំនួយ ចង់ បាន ទៅ តាម របៀបវារៈ នយោបាយ របស់ គេ ហើយ អ្នកធ្វើ របាយការណ៍ ក៏ ធ្វើ ដើម្បី ផ្គាប់ ចិត្ត ម្ចាស់ ជំនួយ ផងដែរ ។
ក៏ប៉ុន្តែ ការ ដែល ពួកគេ នៅតែ បន្ត ចេញ របាយការណ៍ ដដែល ៗ គ្មាន មូលដ្ឋាន បែប នេះ វា នឹង ធ្វើឱ្យ សាធារណមតិ កាន់តែ មាន មន្ទិល សង្ស័យ ថែម ទៀត អំពី វិជ្ជាជីវៈ ឯករាជ្យភាព និង អព្យាក្រឹត្យភាព នយោបាយ របស់ ក្រុម អង្គការ សង្គម ស៊ីវីល ទាំងអស់ នេះ ទៅ វិញ ទេ ។
ទី ២៖ របាយការណ៍ នេះ មើល តែ មួយ ជ្រុង នៃ ការអនុវត្ត វិធានការ ច្បាប់ របស់ សមត្ថកិច្ច ទៅ លើ បុគ្គល និង សកម្មជន នយោបាយ ដែល ប្រព្រឹត្ត ល្មើស ច្បាប់ តែ ប៉ុណ្ណោះ ពោលគឺ ឱ្យ តែ សមត្ថកិច្ច អនុវត្ត ច្បាប់ ទៅ លើ បុគ្គល និង ក្រុម គោលដៅ ទាំងអស់ នេះ ពួកគេ ចាត់ទុក ថា អា ហ្នឹង គឺជា ការរឹតត្បិត សិទ្ធិ សេរីភាព ជា មូលដ្ឋាន របស់ ពលរដ្ឋ ។
សូម ជម្រាប ថា អភិបាល ខេត្ត កណ្ដាល លោក គង់ សោភ័ណ្ឌ នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ ក៏ បាន សម្រេច បិទ ផ្សារ បែក ចាន ស្ថិត ក្នុង ស្រុក អង្គស្នួល ជា បណ្ដោះអាសន្ន ផងដែរ ក្រោយ ផ្ទុះ ជំងឺ កូវីដ១៩ ចេញ ពី កម្មករ រោងចក្រ ។
ខាងក្រោម នេះ ជា សេចក្ដីសម្រេច របស់ រដ្ឋបាល ខេត្ត កណ្ដា ល៖ សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១
១៖ ក្រសួង សុខាភិបាល បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី រហូតដល់ ចំនួន ៧៦១ នាក់ ខណៈ អ្នកជំងឺ ចំនួន ១៦៦ នាក់ ជាសះស្បើយ
៣៖ ក្រសួង សុខាភិបាល ប្រកាស ពី ការស្លាប់ របស់ បុរស ជនជាតិ ចិន ម្នាក់ ដោយសារ ជំងឺ កូវីដ១៩
៥៖ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ អបអរសាទរ ខួប ២២ ឆ្នាំ កម្ពុជា ចូល ជា សជិក អាស៊ាន . ការក្លាយជា សមាជិក អាស៊ាន ជា ជោគជ័យ ការទូត របស់ កម្ពុជា
៧៖ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ អបអរសាទរ ព្រះរាជ ពិធី បុណ្យ ច្រត់ ព្រះនង្គ័ល
៩៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ គ្រោង ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ ជូន ពលរដ្ឋ នៅ តំបន់ ក្រហម ឱ្យ បាន រួចរាល់ ទាំងស្រុង ក្នុង ខែឧសភា
១១៖ អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល៖ ការចាក់ វ៉ាក់សាំង ដល់ មន្រ្តី រាជការ មាន សន្ទុះ ខ្លាំង
១៣៖ ២៩ ថ្ងៃ នៃ យុទ្ធនាការ ចាក់ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ចាក់ បាន ជិត ៥៩ ម៉ឺន នាក់
១៥៖ អ្នកវិភាគ៖ តើ អ្នកណា ធ្វើ អ្វី ខ្លះ ក្នុង ពេល កម្ពុជា ស្ថិត ក្នុង សមរភូមិ ដ៏ គ្រោះថ្នាក់ ក្នុង ការប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល ធ្ងន់ធ្ងរ នៃ ជំងឺ កូវីដ១៩ ?
៣៖ Huawei ឈានជើង ចូលកាន់តែ ជ្រៅ ក្នុង ទីផ្សារ រថយន្ត អគ្គិសនី តាមរយៈ ការទិញ ក្រុមហ៊ុន ក្នុង ស្រុក មួយ យកមក គ្រប់គ្រង ផ្ដាច់ មុខ
៤៖ អ្នក សិល្បៈ សម្តែង ក្តី ក្តុកក្តួល ពេល ដឹង ថា តារាចម្រៀង ស៉ិន ឧត្តម ផល្លា កើត ជំងឺ មហារីក ខួរក្បាល ធ្ងន់ធ្ងរ !
នាយ ឧត្តមសេនីយ៍ អ៉ី ឈាន ប្រាប់ មន្ត្រី មូលដ្ឋាន ក្នុង ខេត្ត ប៉ៃលិន ត្រូវ ចុះ មើល ពលរដ្ឋ ដែល ខ្វះខាត ស្បៀង ដើម្បី ឧបត្ថម្ភ ពួកគាត់
( ប៉ៃលិន ) ៖ ដោយ មាន ការព្រួយបារម្ភ ពី បញ្ហា ឆ្លង ជំងឺ កូវីដ១៩ ចូលក្នុង សហគមន៍ ខេត្ត ប៉ៃលិន នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នាយ ឧត្តមសេនីយ៍ អ៉ី ឈាន រដ្ឋលេខាធិការ ក្រសួង កាពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ប៉ៃលិន បាន ដឹកនាំ ក្រុមការងារ ចុះ សំណេះសំណាល សួរសុខទុក្ខ ដល់ ប្រជាពលរដ្ឋ និង អាជីវករ ដែល លក់ដូរ នៅ តាម បរិវេណ ផ្សារ សាមគ្គី ហៅ ប៉ាហ៉ី ក្នុង ប៉ៃលិន ។
ក្នុង ការចុះ សួរសុខទុក្ខ ដល់ ប្រជាពលរដ្ឋ នេះ ដែរ លោក អ៊ី ឈាន បាន ណែនាំ ដល់ ប្រជាពលរដ្ឋ នៅ ជុំវិញ ផ្សារ ជាពិសេស អាជីវករ ដែល លក់ដូរ នៅ តាម តូប ក្នុង ផ្សារ ទាំងអស់ ត្រូវ ចូលរួម ពាក់ ម៉ាស ជាប់ ជាប្រចាំ រក្សា គម្លាត លាង ដៃ នឹង ទឹក អាល់កុល ឬ ជែល ព្រោះ ទីផ្សារ មាន មនុស្ស ច្រើន ។
លោក ថា « យើង ត្រូវតែ ចូលរួម ការពារ ទាំងអស់ គ្នា ដោយ អនុវត្ត តាម វិធានការ ( ៣ការពារ ៣កុំ ) របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ នូវ វិធានការ អនាម័យ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ដើម្បី ការពារ និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជម្ងឺ កូវីដ - ១៩ ដែល កំពុងតែ ឆ្លង រីករាលដាល នៅ តាម បណ្តា ខេត្ត នានា និង រាជធានី ភ្នំពេញ ជាដើម » ។
ជាមួយគ្នា នោះ ដែរ ក្នុង នាម ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ប៉ៃលិន ក៏ មាន សំណូមពរ ដល់ ក្រុមការងារ ថ្នាក់ មូលដ្ឋាន ពិសេស មន្រ្តី នៅ តាម ភូមិ ទាំងអស់ ក្នុង ខេត្ត ត្រូវ ចុះ មើល ប្រជាពលរដ្ឋ បើ មាន ការខ្វះខាត ស្បៀងអាហារ សូម រាយការណ៍ ជាបន្ទាន់ ព្រោះ គោលការណ៍ របស់ រាជ រដ្ឋាភិបាល មិន ឲ្យ ពលរដ្ឋ ណា ម្នាក់ ដាច់ ស្បៀង ដោយ មិន បាន ដឹង នោះ ឡើយ ។
ម្យ៉ាង វិញ ទៀត បើ មាន អ្នក ចំណូល ថ្មី មកពី ខេត្ត ផ្សេង ៗ ដែល កំពុង ប្រឈម នឹង ការកើត ជំងឺ កូវីដ១៩ នេះ ត្រូវ រាយការណ៍ ជូន អាជ្ញាធរ មូលដ្ឋាន ភ្លាម ដើម្បី សួរនាំ និង ចាត់ចែង យក គាត់ ទៅ ធ្វើចត្តាឡី ស័ក ព្រោះ បើ គាត់ មកពី តំបន់ មាន ហានី ភ័យ ហើយ ធ្វើ ដូចនេះ ដើម្បី ការពារ កុំ ឱ្យ មេរោគ កូវីដ១៩ ចូលក្នុង សហគមន៍ ។
លោក ក៏ បាន កោតសរសើរ ដល់ អាជ្ញាធរ ខេត្ត ប៉ៃលិន ដែល បាន យកចិត្តទុកដាក់ ចូលរួម ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ នេះ មិន ឱ្យ មាន ការឆ្លង ចូលក្នុង ខេត្ត ប៉ៃលិន ដោយ ដាក់ កម្លាំង ការ ពារ យាម ល្បាត នៅ តាម ចំណុច គោលដៅ បាន ល្អ ថែមទាំង ត្រួតពិនិត្យ តាម មូលដ្ឋាន បាន យ៉ាង ល្អ ប្រសើរ ៕ ហើយ ធ្វើ ដូចនេះ ដើម្បី ការពារ កុំ ឱ្យ មេរោគ កូវីដ១៩ ចូលក្នុង សហគមន៍ ។
លោក ក៏ បាន កោតសរសើរ ដល់ អាជ្ញាធរ ខេត្ត ប៉ៃលិន ដែល បាន យកចិត្តទុកដាក់ ចូលរួម ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ នេះ មិន ឱ្យ មាន ការឆ្លង ចូលក្នុង ខេត្ត ប៉ៃលិន ដោយ ដាក់ កម្លាំង ការ ពារ យាម ល្បាត នៅ តាម ចំណុច គោលដៅ បាន ល្អ ថែមទាំង ត្រួតពិនិត្យ តាម មូលដ្ឋាន បាន យ៉ាង ល្អ ប្រសើរ ៕ អ្នកវិភាគ ចៅ ចាក់ ស្មុក៖ ក្រុម ជន ក្បត់ ជាតិ សម រង្ស៉ី កំពុង កេង ចំណេញ នយោបាយ អំឡុង ពេល ជាតិ និង ប្រជាជន កម្ពុជា ស្ថិត ក្នុង សង្គ្រាម ប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ ក្រុម ជន ក្បត់ ជាតិ ដឹកនាំ ដោយ ទណ្ឌិត សម រង្ស៉ី អេង ឆៃ អ៊ាង មូរ សុខ ហួរ និង ហូ វ៉ាន់ ព្រមទាំង បរិវារ ពិតជា គ្មាន គុណធម៌ មនុស្សធម៌ និង គ្មាន ចិត្ត ថ្លើម ជា ជនជាតិ ខ្មែរ ឡើយ ! ពេល ជាតិ និង ប្រជាជន កម្ពុជា មាន ទុក្ខ និង កំពុង ស្ថិត នៅក្នុង សង្គ្រាម ប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ពួកគេ បាន រៀបចំ ផែនការ ទុច្ច រឹត បំផ្លាញ កម្ពុជា ដោយ អនុវត្ត ផែនការញុះញង់ ពលរដ្ឋ មិន ឱ្យ គោរព បទបញ្ជា រាជ រដ្ឋាភិបាល និង បំពាន បំរាម បិទ ខ្ទប់ បង្កើត ចលាចល សង្គម ។
ពួកគេ ធ្វើ អ្វី ៗ ទាំងអស់ ដើម្បី សងសឹក រដ្ឋាភិបាល និង បំផ្លាញ កម្ពុជា ក្នុង កាលៈទេសៈ ដ៏ លំបាក នេះ ។ ទង្វើ ក្បត់ ជាតិ របស់ ពួកគេ ពិតជា មាន ទំហំ ធំ និង មិន អាច ឱ្យ ពលរដ្ឋ ខ្មែរ អត់ឱន ឱ្យ បាន ឡើយ ។ ក្រុម ជន ជ្រុលនិយម ទាំង នេះ ពិតជា សត្រូវ របស់ ប្រជាជន កម្ពុជា ហើយ ស័ក្តិសម បំផុត ក្នុង ការចារ ឈ្មោះ ជន ក្បត់ ជាតិ ទាំងនេះ សម្រាប់ មនុស្ស រាប់ ជំនាន់ ទៅ មុខ ទៀត បាន ចងចាំ នូវ សែ ស្រឡាយ ពូជ ក្បត់ ជាតិ និង ទង្វើ ក្បត់ ជាតិ ក្បត់ ប្រជាជន របស់ ពួកគេ ។
គេ ដឹង ច្បាស់ ណាស់ ថា អ្នក ដែល ចូលរួម នោះ គឺជា សកម្មជន នយោបាយ របស់ ពួកគេ មួយ ក្តាប់ តូច ប៉ុណ្ណោះ ប៉ុន្តែ បាន យក ឈ្មោះ ប្រជាជន ខ្មែរ ទៅ ប្រើប្រាស់ ដើម្បី ចំណេញ នយោបាយ ពួកគេ ។
ប្រភព បាន បន្ត ទៀត ថា ប្រសិនបើ ដល់ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ នៅតែ មាន ការបិទ ខ្ទប់ ដដែល នោះ ផែនការនិង ត្រូវ អនុវត្ត បន្ត ហើយ ការអនុវត្ត ត្រូវ ចាំ បញ្ជា ពី ថ្នាក់ លើ ដែល សំដៅ ដល់ ទណ្ឌិត សម រង្ស៊ី នៅ យប់ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ ដោយ ក្នុង នោះ ទណ្ឌិត ហូរ វ៉ាន់ បាន បញ្ជា ឱ្យ រៀបចំ កម្លាំង ហើយ កម្លាំង ទាំងអស់ ត្រូវ ត្រៀម រៀបចំ ធ្វើ កិច្ចការងារ ទាំងអស់ នេះ គ្រប់ ខណ្ឌ ព្រមទាំង ឱ្យ តាមដាន សារ នយោបាយ របស់ ទណ្ឌិត សម រង្ស៊ី តាមរយៈ ហ្វេសប៊ុក និង ទូរទស្សន៍ ព្រះអាទិត្យ អនឡាញ ជាដើម ដើម្បី អនុវត្ត ផែនការ ។
ចេញ ពី ផែនការ ទុច្ចរិត នេះ ពួកគេ បាន ញុះញង់ ពលរដ្ឋ ប្រមាណ ជិត ៥០ នាក់ នៅក្នុង សង្កាត់ ស្ទឹង មានជ័យ កាលពី ល្ងាច ថ្ងៃទី ២៩ ខែមេសា ឱ្យ ចេញមក តវ៉ា តាម ការញុះញង់ របស់ ទណ្ឌិត សម រង្ស៊ី និង ប្រើប្រាស់ សារ បដាត វ៉ា ដូច អ្វី ដែល ទណ្ឌិត ហូរ វ៉ាន់ បាន ណែនាំ ដូចជា « ភូមិ ខ្ញុំ ដាច់ បាយ ហើយ » ។
តាម ការស្រាវជ្រាវ របស់ អាជ្ញាធរ អ្នក ដែល បាន ចូលរួម តវ៉ា ទាំងនោះ គឺ មាន មួយចំនួន បាន ដឹង និង មួយចំនួន មិន បាន ដឹង អំពី ផែនការ របស់ ក្រុម ជ្រុលនិយម ក្បត់ ជាតិ ទេ ដោយ ជឿ តាម ការញុះញង់ របស់ សកម្មជន ខ្មោច បក្ស ប្រឆាំង មួយចំនួន តូច ។ អ្នក ខ្លះ ទទួលបាន អំណោយ ពី អាជ្ញាធរ នៅ ពេលព្រឹក ថ្ងៃ ប៉ុន្តែ បាន ចូលរួម តវ៉ា នៅ ពេល យប់ ទាមទារ ស្បៀង ថែម ទៀត ( សូម មើល រូបថត ) ។
ទង្វើ ក្បត់ ជាតិ ដែល ក្រុម ប្រឆាំង ជ្រុលនិយម បាន ប្រព្រឹត្ត ប្រឆាំង នឹង ជាតិ និង ប្រជាជន កម្ពុជា ពិតជា មាន ទម្ងន់ ដ៏ ធ្ងន់ បំផុត ។ ការធ្វើ នយោបាយ របស់ ពួកគេ ផ្តោត លើ ការបំផ្លាញ ជាតិ ជា ធំ និង ហ៊ាន ប្រមាថ ជីវិត ប្រជាពលរដ្ឋ និង យក អាយុ ប្រជាពលរដ្ឋ មក ធ្វើជា ឈ្នាន់ ដើម្បី អំណាច របស់ ពួកគេ ដោយ គ្មាន ភាពអៀនខ្មាស ឡើយ ។
ដោយ៖ ចៅ ចាក់ ស្មុក រាជធានី ភ្នំពេញ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ បារាំង រកឃើញ ករណី ឆ្លង វីរុស បំប្លែង ខ្លួន ថ្មី ប្រភព មកពី ប្រទេស ឥណ្ឌា ចំនួន ០៣ ករណី ដំបូង
( ប៉ារីស )៖ រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល បារាំង លោក Olivier បាន និយាយ នៅ ថ្ងៃសុក្រ នេះ ថា ប្រទេស បារាំង បាន រកឃើញ ករណី ឆ្លង វីរុស បំប្លែង ខ្លួន ថ្មី ដែល មាន ប្រភព មកពី ប្រទេស ឥណ្ឌា ចំនួន ៣ករណី ដំបូង ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃសុក្រ ទី៣០ ខែមេសា ឆ្នាំ ២០២១ ។
លោក រដ្ឋមន្ត្រី បារាំង បាន និយាយ ថា ករណី ឆ្លង នេះ ត្រូវបាន គេ រកឃើញ ក្នុង ចំណោម អ្នកដំណើរ ដែល បាន មកពី ប្រទេស ឥណ្ឌា និង អ្នក ដែល គ្មាន ទំនាក់ទំនង សោះ ជាមួយ ពួកគេ ។
ទោះជា យ៉ាងណា លោក បាន សង្កត់ធ្ងន់ ថា « ករណី ទាំង បី ដំបូង នេះ មិន មាន អ្វី គួរឱ្យ ភ្ញាក់ផ្អើល ទេ ។ វា ត្រូវការ ការអន្តរាគមន៍ ជាបន្ទាន់ ពី សេវា សុខភាព ហើយ នោះ ជា អ្វី ដែល យើង កំពុង ធ្វើ » ។
គួរ បញ្ជាក់ ថា ប្រទេស បារាំង បាន ចាត់ វិធានការបិទ ខ្ទប់ ប្រទេស ជា លើក ទី បី ចាប់តាំងពី ចុង ខែមីនា មក បន្ទាប់ពី ទទួលរង នូវ ការ កើនឡើង នៃ ចំនួន អ្នកស្លាប់ និង ករណី ឆ្លង ដោយសារតែ ការរីករាលដាល នៃ វីរុស ឆ្លង បំប្លែង ខ្លួន ថ្មី ។
កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ មនុស្ស ចំនួន ២៦. ៥៣៨ នាក់ ត្រូវបាន ធ្វើតេស្ត រក ឃើះវិជ្ជមាន ចំពោះ កូវីដ - ១៩ នៅក្នុង ប្រទេស បារាំង ដែល នាំមក នូវ ការឆ្លង សរុប នៅ ទូទាំង ប្រទេស កើន ដល់ ជាង ៥. ៥៩លាន នាក់ ៕ ស្ថានទូត អាមេរិក ប្រចាំ រុស្ស៊ី ប្រកាស កាត់បន្ថយ សេវាកម្ម កុងស៊ុល របស់ ខ្លួន មក នៅ តិច បំផុត ខណៈ ទំនាក់ទំនង ការទូត រវាង ប្រទេស ទាំង ពីរ កាន់តែ តានតឹង ឡើង
( ម៉ូស្គូ) ៖ ស្ថានទូត អាមេរិក ប្រចាំ ប្រទេស រុស្ស៊ី នៅ ថ្ងៃសុក្រ ទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស កាត់បន្ថយ នូវ សេវាកម្ម កុងស៊ុល របស់ ខ្លួន ឲ្យ នៅ តិច បំផុត ដោយ លើកឡើង ថា មាន ការឹតបន្តឹង ពីសំណាក់ ទីក្រុង ម៉ូស្គូ ចំពោះ កម្លាំង ការងារ បេសកកម្ម របស់ ខ្លួន ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន ចិន ស៉ីន ហួរ ។
ស្ថានទូត បាន គូសបញ្ជាក់ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា ស្ថានទូត អាមេរិក ប្រចាំ ប្រទេស រុស្ស៉ី នឹង កាត់បន្ថយ ការផ្តល់ សេវាកម្ម កុងស៊ុល ផ្សេង ៗ ដោយ ទុក នៅ ត្រឹមតែ ការផ្តល់ សេវាកម្ម លក្ខណៈ បន្ទាន់ ៗ សម្រាប់ ពលរដ្ឋ អាមេរិក ផ្ទាល់ និង ការផ្តល់ ទិដ្ឋាការ អន្តោប្រវេសន៍ ក្នុង ចំនួន កំណត់ តិចតួច បំផុត សម្រាប់ ករណី បន្ទាន់ ចាប់ពី ថ្ងៃទី ១២ ខែឧសភា ខាងមុខ នេះ តទៅ ។ រីឯ ដំណើរការទិដ្ឋាការ មិន មែន អន្តោប្រវេសន៍ សម្រាប់ ការធ្វើដំណើរ មិន មែន ការទូត នឹង ត្រូវ បញ្ឈប់ ។
គួរ បញ្ជាក់ ថា ក្រសួង ការបរទេស រុស្ស៊ី បាន បង្ហាញ ពី វិធានការសងសឹក មួយ កាលពី ថ្ងៃទី ១៦ ខែមេសា កន្លងទៅ នេះ ប្រឆាំង នឹង ការដាក់ទណ្ឌកម្ម របស់ សហរដ្ឋ អាមេរិក នា ពេល ថ្មី ៗ នេះ រួមទាំង ការហាមឃាត់ ទាំងស្រុង លើ បេសកកម្ម ការ ទូត អាមេរិក ពី ការជួល ពលរដ្ឋ នៃ ប្រទេស រុស្ស៊ី ឬ ប្រទេស ទី បី ទៅកាន់ ប៉ុស្តិ៍ រដ្ឋបាល ឬ បច្ចេកទេស ៕
អគ្គ នាយក ក្រុមហ៊ុន វីរៈ ប៊ុន ថាន់ ចែក អំណោយ ដល់ ពលរដ្ឋ ៤០០ គ្រួសារ នៅ សង្កាត់ ទួល សង្កែ១ ខណ្ឌ ឫស្សីកែវ
( ភ្នំពេញ ) ៖ លោក ឧកញ្ញា សួរ វីរៈ អគ្គ នាយក ក្រុមហ៊ុន វីរៈ ប៊ុន ថាន់ បាន ចែកជូន នូវ អំណោយ ដល់ ប្រជាពលរដ្ឋ ៤០០ គ្រួសារ នៅ សង្កាត់ ទួល សង្កែ១ ខណ្ឌ ឫស្សីកែវ ដើម្បី ជួយ សម្រាល បន្ទុក ខ្លះ ក្នុង ពេល បិទ ខ្ទប់ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ ។
អំណោយ ទាំងនោះ រួម មាន៖ សាច់ ជ្រូក ១គីឡូក្រាម អង្ករ ១ប៉ាវ ២០ គីឡូក្រាម សាច់ គោ កន្លះ គីឡូ សាច់ក្រក កន្លះ គីឡូ មី ១០កញ្ចប់ និង បន្លែ ផ្សេង ៗ ទៀត ៕
( តាកែវ )៖ រដ្ឋបាល ខេត្ត តាកែវ បាន សម្រេច ផ្អាក សកម្មភាព ជា បណ្តោះអាសន្ន នៅក្នុង ផ្សារ ត្រាំ ខ្នារ ក្នុង ឃុំ សូរ ភី ស្រុក បាទី ខេត្ត តាកែវ បន្ទាប់ពី តំបន់ នេះ មាន មាន អ្នក បាន ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល ជាមួយ អ្នក កើត ជំងឺ កូវីដ១៩ ។
ក្នុង សេចក្តីសម្រេច នេះ រដ្ឋបាល ខេត្ត បាន ណែនាំ ដល់ អាជ្ញាធរ អនុវត្ត វិធានការ នានា ឱ្យ បាន ម៉ឺងម៉ាត់ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ ។
ខាងក្រោម តារាង បញ្ជី បូកសរុប ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ របស់ ក្រសួង ការពារ ជា តិ៖ អគ្គិសនី កម្ពុជា ជូនដំណឹង ពី ជម្រើស ក្នុង ការបង់ ថ្លៃ អគ្គិសនី ក្នុង អំឡុង ពេល បិទ ខ្ទប់ នៅ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ជម្រើស ក្នុង ការទូទាត់ វិក្កយបត្រ អគ្គិសនី ក្នុង អំឡុង ពេល អនុវត្ត វិធានការបិទ ខ្ទប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ។
អគ្គិសនី កម្ពុជា បាន ឲ្យដឹង ថា ក្នុង អំឡុង ពេល អនុវត្ត វិធានការបិទ ខ្ទប់ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល តាម ការណែនាំ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ អគ្គិសនី កម្ពុជា នៅតែ ដំណើរការបម្រើ សេវា ជូន បងប្អូន ប្រជាពលរដ្ឋ ជាធម្មតា ។
ដើម្បី រក្សា ស្ថិរភាព នៃ ការផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី បន្ត ទៀត និង ដើម្បីឱ្យ អគ្គិសនី កម្ពុជា អាច មាន លទ្ធភាព ទូទាត់ បន្ត ទៅ អ្នកផលិត អគ្គិសនី ទាំង ក្នុង ប្រទេស និង ពី ប្រទេស ជិតខាង អគ្គិសនី កម្ពុជា សូម អំពាវនាវ ដល់ អតិថិជន របស់ អគ្គិសនី កម្ពុជា មេត្តា ព្យាយាម ជួយ ទូទាត់ ថ្លៃ ប្រើប្រាស់ ថាមពល អគ្គិសនី តាមរយៈ កម្មវិធី នៃ ប្រព័ន្ធ ទូទាត់ របស់ បណ្តា ដៃគូ ដែល ជា ធនាគារ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ផ្សេង ៗ ឬ អញ្ជើញ ទៅ ទូទាត់ ផ្ទាល់ នៅ ទីតាំង ដែល ជិត បំផុត តាម ដែល លោក អ្នក អាច ធ្វើ បាន ។
( ប៉ៃលិន) ៖ នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ រដ្ឋបាល ខេត្ត ប៉ៃលិន ដឹកនាំ ដោយ លោកស្រី បាន ស្រី មុំ អភិបាល ខេត្ត បាន ដឹកនាំ ក្រុមការងារ មន្ទីរ សុខាភិបាល ខេត្ត ធ្វើការ បាញ់ ថ្នាំ កម្ចាត់ មេរោគ កូវីដ - ១៩ នៅក្នុង បរិវេណ ផ្សារ សាមគ្គី ហៅ ប៉ាហ៉ី ក៏ ដូចជា ទូទាំង ខេត្ត ដើម្បី កុំ ឱ្យ មេរោគ ដ៏ កាច សាហាវ មួយ នេះ ឆ្លង ចូល ទៅក្នុង សហគមន៍ ។
ក្នុង ឱកាស នោះ លោកស្រី បាន លើកឡើង ថា « មេរោគ នៃ ជំងឺ កូវីដ - ១៩ គឺជា សត្រូវ ដ៏ កាច សាហាវ របស់ យើង រាល់គ្នា ដែល មើល មិន ឃើញ ហើយ មាន គ្រោះថ្នាក់ ដូច្នេះ បើសិនជា យើង ធ្វេសប្រហែស តែ បន្តិច អាចនឹង បង្កឱ្យ កើតមាន ហានី ភ័យ ឆ្លង រាលដាល ពី អ្នក កើត ជំងឺ នេះ មក ខ្លួន ឯង ឆ្លង ទៅ ក្រុមគ្រួសារ រួច ចូលក្នុង សហគមន៍ នាំឱ្យ មាន ការលំបាក ផងដែរ » ។
លោកស្រី អភិបាល ខេត្ត ក៏ បាន ក្រើន រំលឹក ដល់ អាជីវករ នៅក្នុង ផ្សារ ឱ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ត្រូវ ពាក់ ម៉ាស លាង ដៃ នឹង ទឹក អាល់កុល ឬ ជែល រក្សា គម្លាត សុវត្ថិភាព ឱ្យ បាន ១.៥ ទៅ២ម៉ែត្រ និង ត្រូវ អនុវត្ត តាម វិធាន របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ( ៣ការ ពារ ៣កុំ ) ព្រមទាំង ធ្វើ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
ម្យ៉ាង វិញ ទៀត សមត្ថកិច្ច និង អាជ្ញាធរ មូលដ្ឋាន ព្រមទាំង ប្រធាន ផ្សារ ត្រូវ បន្ត រឹត បណ្តឹង ដោយ ណែនាំ ដល់ ប្រជាពលរដ្ឋ ដែល ចូល ទិញ ម្ហូប អាហារ ក្នុង ផ្សារ ឱ្យ ពាក់ ម៉ាស ជាប់ ជានិច្ច ។ បើ មិន ធ្វើ តាម ទេ គឺ មិន អនុញ្ញាតឱ្យ ចូល ផ្សារ ទិញ ម្ហូប បាន ឡើយ ៕ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ ក្រហម និង តំបន់ លឿង ទុំ ជួយ រាយការណ៍ និង ផ្តល់ ព័ត៌មាន សម្រាប់ អ្នក នៅតែ បំពាន វិធានការបិទ ខ្ទប់
( ភ្នំពេញ ) ៖ ក្នុង រយ: ពេល នៃ ការអនុវត្ត វិធានការបិទ ខ្ទប់ ចាប់តាំងពី ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ មក គេ សង្កេតឃើញ ថា មាន ប្រជាពលរដ្ឋ ជាច្រើន បាន ចូលរួម សហការ និង អនុវត្ត តាម វិធានការ នេះ ។
ដោយ ស្ថានភាព ឆ្លង រាលដាល មិន ទាន់ មាន ការថមថយ រាជ រដ្ឋាភិបាល បាន សម្រេច បន្ត ការបិទ ខ្ទប់ ៧ ថ្ងៃ ទៀត រហូតដល់ ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២១ ហើយ សាលា រាជធានី ភ្នំពេញ ក៏ បាន ចេញ សេចក្តីសម្រេច អំពី ការបែងចែក ជា ៣ តំបន់ ផ្សេង គ្នា រួម មាន៖ « តំបន់ ក្រហម តំបន់ លឿង ទុំ និង តំបន់ លឿង » ។
ទោះជា យ៉ាងណា ក៏ នៅ មាន ប្រជាពលរដ្ឋ មួយចំនួន តូច រស់ នៅ តំបន់ ក្រហម និង តំបន់ លឿង ទុំ នៅ មិន ចូលរួម សហការ និង មិន គោរព តាម ការណែនាំ របស់ សាលា រាជធានី ភ្នំពេញ ស្រប ពេល ដែល ពលរដ្ឋ ភាគ ច្រើន បាន ចូលរួម សហការ និង គោរព បាន យ៉ាង ល្អ តាម ការណែនាំ ដើម្បី បង្ការ និង ទប់ស្កាត់ ការឆ្លង រាលដាល វីរុស កូវីដ១៩ ។
លោក សាន សុខ សីហា ជំនួយការ និង ជា អ្នកនាំពាក្យ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ ក្រហម និង តំបន់ លឿង ទុំ ជួយ រាយការណ៍ និង ផ្តល់ ព័ត៌មាន មក ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ចំពោះ ប្រជាពលរដ្ឋ មួយចំនួន តូច ដែល នៅតែ ល្មើ នឹង វិធានការ នេះ ដើម្បី ចាត់ការ តាម វិធានការ ច្បាប់ ។
សូម បញ្ជាក់ ថា ទាំង តំបន់ ក្រហម តំបន់ លឿង ទុំ និង តំបន់ លឿង សមត្ថកិច្ច ចម្រុះ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ តែងតែ ចេញ ល្បាត ជាប្រចាំ ២៤ ម៉/ ២៤ម៉ ទាំង តាម ផ្លូវ ធំ និង ផ្លូវ តូច ៕ វៀតណាម រកឃើញ អ្នក ឆ្លង កូវីដ - ១៩ ក្នុង សហគមន៍ ចំនួន ៣នាក់ ទៀត ក្នុង របាយការណ៍ ថ្ងៃសុក្រ នេះ
អាជ្ញាធរ វៀតណាម កំពុងតែ តាមដាន រក អ្នក ពាក់ព័ន្ធ ទៅនឹង ករណី ឆ្លង ទាំង ០៣ នាក់ ចុងក្រោយ លើ ខណៈ អគារ ស្នាក់ នៅក្នុង សង្កាត់ មួយ នៃ ទីក្រុង ហាណូយ ដែល មាន មនុស្ស ២១ នាក់ នៅក្នុង នោះ ត្រូវបាន បិទ ខ្ទប់ ជា បណ្តោះអាសន្ន ដើម្បី យក សំណាក អ្នក សង្ស័យ ទៅ ពិនិត្យ រក COVID-19 និង ដាក់ ឲ្យ ធ្វើចត្តាឡី ស័ក ។
អភិបាល ខណ្ឌ បឹងកេងកង បន្ត ចុះ ចែក អំណោយ ជា គ្រឿង បរិភោគ ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ រដ្ឋបាល ខណ្ឌ បឹងកេងកង បាន បន្ត រៀបចំ កញ្ចប់ បន្លែ មាន សាច់ ជ្រូក ឆៃ ប៉ូវ និង បន្លែ ស្រស់ ៗ ដឹក តាម រថយន្ត ចុះ ចែកជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ តាម ដងផ្លូវ ២៨៨ សង្កាត់ បឹងកេងកង ទី២ និង ផ្លូវ ៣៥០ សង្កាត់ បឹងកេងកង ទី៣ ខណ្ឌ បឹងកេងកង និង អ្នកដំណើរ ផងដែរ ។
សកម្មភាព របស់ លោក ធឹម សំអាន អភិបាល ខណ្ឌ បឹងកេងកង ចុះ ចែក អំណោយ តាម រថយន្ត ជូន ប្រជាជន នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោកស្រី គឹម សុវណ្ណា តំណាងរាស្រ្ត មណ្ឌល ភ្នំពេញ និង លោកស្រី សុិន រតនា អភិបាល រង ខណ្ឌ បឹងកេងកង លោកស្រី ស៊ុយ សែន សករាជ ប្រធាន អនុសាខា សមាគម នារី ខណ្ឌ បឹងកេងកង ព្រមទាំង គណៈ អភិបាល ខណ្ឌ និង មន្ត្រី ក្រោម ឱវាទ ជាច្រើន រូប ទៀត ដើម្បី ជួយ សម្រាល រាល់ ការខ្វះខាត ដល់ បងប្អូន ប្រជាពលរដ្ឋ បាន មួយ រយៈ នា អំឡុង ពេល បិទ ខ្ទប់ រាជធានី នេះ ។
ខណៈ ជិះ រថយន្ត ដឹក កញ្ចប់ បន្លែ ឆៃ ប៉ូវ នោះ លោក ធឹម សំអាន បាន ណែនាំ ទៅ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មក ទទួល នូវ អំណោយ សប្បុរសធម៌ ត្រូវ ពាក់ ម៉ាស ការពារ និង រក្សា គម្លាត ហើយ ត្រូវ ទឹក បាញ់ អាល់កុល លាង សម្អាត ដៃ ពេល ទទួល កញ្ចប់ អំណោយ រួច សូម ចូល ផ្ទះ វិញ រៀង ៗ ខ្លួន ផងដែរ ។
ជាមួយគ្នា នេះ លោក ធឹម សំអាន បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម អត់ធ្មត់ ទាំងអស់ គ្នា យើង ស៊ូ លំបាក រយៈពេល ខ្លី នេះ គឺ រដ្ឋបាល ខណ្ឌ បឹងកេងកង និង ក្រុមការងារ នៅ ជាមួយ បងប្អូន រួម សុខ ទុក្ខ ជាមួយ បងប្អូន ដូច ពេលនេះ បងប្អូន ទទួលបាន បន្លែ ឆៃប៉ូ ម្នាក់ ១កញ្ចប់ ដើម្បី ទុក ដោះស្រាយ ជីវភាព ប្រចាំ ថ្ងៃ នា អំឡុង ពេល បិទ ខ្ទុប រាជធានី ដើម្បី កាត់ផ្តាច់ កូវីដ១៩ នេះ ។
បងប្អូន ប្រជាជន ដែល ទទួលបាន អំណោយ នេះ គឺ ពួកគាត់ បាន សម្ដែង នូវ កាយវិការ ដឹងគុណ និង ទឹកចិត្ត សប្បាយរីករាយ រក អ្វី មក ប្រៀប មិន បាន ឡើយ នៅពេល រដ្ឋបាល ខណ្ឌ បឹងកេងកង ដឹក អំណោយ មក អោយ ដល់ មុខ ផ្ទះ ដូចនេះ ទោះបី អំណោយ ទាំងនោះ មិន សម នឹង ចិត្ត គាត់ ក្ដី តែ មាន សារៈសំខាន់ ណាស់ ក្នុង ការជួយ គ្នីគ្នា ពេល ជួប គ្រា លំបាក នា អំឡុង ពេល សម័យ កូវីដ១៩ ពីសំណាក់ រដ្ឋបាល ខណ្ឌ បឹងកេងកង នៃ រាជធានី ភ្នំពេញ ៕
២ ថ្ងៃ នេះ អាជ្ញាធរ សហការ ជាមួយ កងទ័ព បន្ត ដឹកជញ្ជូន ស្បៀងអាហារ ជូន ប្រជាពលរដ្ឋ បាន ចំនួន ៣៧. ២០០ គ្រួសារ នៅ តំបន់ បិទ ខ្ទប់
មន្ត្រី រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៨ និង ២៩ ខែមេសា ២ ថ្ងៃ ជាប់ គ្នា នេះ អាជ្ញាធរ ខណ្ឌ នីមួយ ៗ បាន បន្ត សហការ ជាមួយ កងទ័ព ជើងគោក បន្ត ដឹកជញ្ជូន ស្បៀងអាហារ ទៅ ជូន ទៅ បងប្អូន ប្រជាពលរដ្ឋ បាន ចំនួន ៣៧២០០ គ្រួសារ ក្នុង នោះ បាន ដឹកជញ្ជូន ទៅ ចែក ជូន ប្រជាពលរដ្ឋ ក្រីក្រ រួម មាន៖
ការសន្និដ្ឋាន របស់ ក្រុម គ្រូពេទ្យ ស្ដ្រី ជនជាតិ ខ្មែរ អាយុ ៥៥ ឆ្នាំ ខាងលើ បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ វិបត្តិ ផ្លូវ ដង្ហើម ស្រួច ស្រាវ ធ្ងន់ធ្ងរ និង រលាក សួត ទាំង សងខាង ដោយសារ វីរុស កូវីដ១៩ ។ ក្រសួង សុខាភិបាល សូម ចូលរួមចំណែក សោកស្ដាយ ជា ពន់ពេក និង សូម ចូលរួម មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជា ទីបំផុត ជាមួយ ក្រុមគ្រួសារ សព ។
សូម ជម្រាប ថា គិត ត្រឹម ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ ចំនួន អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា កើតឡើង រហូដល់ ៩៣ នាក់ ៕ ជើងហោះហើរ អន្តរជាតិ ដឹក អ្នកដំណើរ ចេញ - ចូល ប្រទេស ឥណ្ឌា នឹង ត្រូវ បន្ត ផ្អាក ដល់ ថ្ងៃទី ៣១ ខែឧសភា
អគ្គ លេខាធិការដ្ឋាន អាកាសចរណ៍ ស៉ី វិល នៃ ប្រទេស ឥណ្ឌា បាន ចេញ សេចក្តីប្រកាស នៅ ថ្ងៃសុក្រ នេះ ថា ការផ្អាក សេវាកម្ម ជើងហោះហើរ អន្តរជាតិ សម្រាប់ ដឹក អ្នកដំណើរ ចេញ - ចូល ឥណ្ឌា ពាក់ព័ន្ធ នឹង បញ្ហា COVID-19 នោះ គឺ នឹង ត្រូវ បន្ត មាន សុពលភាព រហូតដល់ ម៉ោង ២៣៖ ៥៩ នាទី យប់ ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០២១ ។ ប៉ុន្តែ អាច មាន ករណី លើកលែង ចំពោះ ជើងហោះហើរ អន្តរជាតិ សម្រាប់ ដឹកជញ្ជូន ទំនិញ សុទ្ធសាធ និង ជើងហោះហើរ អន្តរជាតិ ណា ដែល ត្រូវបាន អនុញ្ញាត ជាពិសេស ដោយ អាជ្ញាធរ ពាក់ព័ន្ធ ។
គួរ បញ្ជាក់ ថា ជើងហោះហើរ អន្តរជាតិ ដឹក អ្នកដំណើរ ត្រូវបាន ផ្អាក ចាប់តាំងតែពី ឥណ្ឌា បាន បិទ ខ្ទប់ ប្រទេស ទាំងស្រុង កាលពី ចុង ខែមីនា ឆ្នាំ ២០២០ ដើម្បី ទប់ទល់ ការឆ្លង រាលដាល នៃ COVID-19 នា ពេល នោះ ។ សម្រាប់ ជើងហោះហើរ សម្រាប់ ដឹក អ្នកដំណើរ ក្នុង ស្រុក គឺ បាន បន្ត ដំណើរការ ឡើងវិញ នៅ ឥណ្ឌា កាលពី ថ្ងៃទី ២៥ ខែឧសភា ឆ្នាំ មុន ក្រោយ ផ្អាក ជិត ពីរ ខែ ។
ចាប់តាំងពី ខែឧសភា ឆ្នាំ ២០២០ ឥណ្ឌា បាន ធ្វើ ប្រតិបត្តិការ ជើងហោះហើរ អន្តរជាតិ ពិសេស ជា បន្តបន្ទាប់ ហើយ ចាប់ពី ខែកក្កដា ឆ្នាំ ដដែល ឥណ្ឌា ក៏ បាន ធ្វើ ប្រតិបត្តិការ ជើងហោះហើរ អន្តរជាតិ លក្ខណៈ ទ្វេ ភាគី ជាមួយ បណ្តា ប្រទេស ដែល មាន ការព្រមព្រៀង គ្នា ផងដែរ ។ ប៉ុន្តែ ក្រោយពី មាន ការផ្ទុះ COVID-19 ខ្លាំង ឡើងវិញ នៅ អំឡុង ខែមេសា ឆ្នាំ ២០២១ នេះ ប្រទេស មួយចំនួន បាន សម្រេច ផ្អាក ជើងហោះហើរ រវាង ឥណ្ឌា វិញ ៕
ឈើ ជ្រុង ៦៨ កំណាត់ ត្រូវបាន រុករកឃើញ លាក់ នៅក្នុង ព្រៃ ដោយ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក ឱរ៉ាល់
( កំពង់ស្ពឺ ) ៖ នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នំ ២០២១ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ទោ សោម ពុទ្ធ តារា មេបញ្ជាការ បាន ចេញ ប្រតិបត្តិការ រុករក តាម តំបន់ ព្រៃ ក៏ បាន ប្រទះឃើញ ឈើ ជ្រុង ប្រភទ ចម្រុះ មាន ឈើ ច ម្រេញ ត្រ សេក និង សុក្រំ ចំនួន ៦៨ កំណាត់ មិន ទាន់ វាស់វែង ( គ្មាន ម្ចាស់ ) លាក់ ទុក នៅ ចំនុច ប៉ុយ រ៉ុយ ក្នុង ព្រៃ ដីឡតិ៍ ភូមិ សំរោង ឃុំ ត្រពាំង ជោ ស្រុក ឱរ៉ាល់ ។
លោក សោម ពុទ្ធ តារា បាន ឲ្យដឹង ថា ករណី បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ នេះ នៅ មិន ទាន់ វាស់វែង ទេ ដោយ រង់ចាំ ជំនាញ មក ទទួល ហើយ កម្លាំង កំពុង នៅ ការពារ បាន ប្រគល់ ឱ្យ ទៅ មន្ត្រី ជំនាញ បរិស្ថាន ការិយាល័យ ដែន ជម្រក សត្វ ព្រៃ ភ្នំ ឱរ៉ាល់ ដើម្បី រក្សាទុក និង ចាត់ការ បន្ត តាម នីតិវិធី ៕
រកឃើញ ពលករ ម្នាក់ ផ្ទុក ជំងឺ កូវីដ១៩ និង អ្នក ពាក់ព័ន្ធ ១៤ នាក់ ទៀត ត្រូវបាន យក សំណាក ទៅ ពិនិត្យ ខណៈពេល វិលត្រឡប់ មកពី ប្រទេស ថៃ តាម ច្រក ទ្វារ អន្តរជាតិ អូរ ស្មាច់ ខេត្ត ឧត្តរមានជ័យ
( ឧត្តរមានជ័យ )៖ ពលករ ម្នាក់ ក្នុង ចំណោម ពលករ ១៥នាក់ ដែល វិលត្រឡប់ មកពី ប្រទេស ថៃ កាលពី ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២១ តាម ច្រក ទ្វារ អន្តរជាតិ អូរ ស្មាច់ សង្កាត់ អូរ ស្មាច់ ក្រុង សំរោង ខេត្ត ឧត្តរមានជ័យ ត្រូវបាន គេ ពិនិត្យ ឃើញ មាន ផ្ទុក ជំងឺ កូវីដ១៩ ។ ដោយឡែក ចំពោះ អ្នក ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ដោយ ប្រយោល ចំនួន ១៤នាក់ ទៀត ត្រូវបាន នាំយក ទៅ ធ្វើចត្តាឡី ស័ក ហើយ ក្រុម គ្រូពេទ្យ យក សំណាក ទៅ ពិនិត្យ នៅឯ ខេត្ត សៀមរាប ។
លោក វេជ្ជបណ្ឌិត ឃ្លោក ហួត ទីប្រឹក្សា ក្រសួង សុខាភិបាល និង ជា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ឧត្តរមានជ័យ បាន ថ្លែង ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ប្រចាំ ខេត្ត ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ ថា ពិតជា បាន រកឃើញ ពលករ ម្នាក់ ជា ស្ត្រី ដែល វិលត្រឡប់ មកពី ប្រទេស ថៃ តាម ច្រក អន្តរជាតិ អូរ ស្មាច់ កាលពី ថ្ងៃ ម្សិលមិញ មាន ផ្ទុក ជំងឺ កូវីដ១៩ ពិតប្រាកដ មែន ។
លោក ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត បាន ថ្លែង បញ្ជាក់ ថា ជាធម្មតា ចំពោះ ពលករ ដែល វិលត្រឡប់ មកពី ប្រទេស ថៃ តាម ច្រក ទ្វារ អន្តរជាតិ អូរ ស្មាច់ បើ នៅ តាម បណ្តាល ខេត្ត ផ្សេង ៗ គឺ យើង អត់ យក សំណាក នោះ ទេ គឺ យើង បញ្ជូន គាត់ ទៅកាន់ ខេត្ត ដែល គាត់ រស់ នៅ តែ ម្តង ដោយ ធ្វើ ការពិនិត្យ វាស់ កំដៅ បាញ់ អាល់កុល ជាមុន ផងដែរ មុន អនុញ្ញាតឲ្យ ឡើង រថយន្ត ។ ប៉ុន្តែ បើ ពិនិត្យ ឃើញ ថា ពលករ នោះ មាន រោគសញ្ញា ណាមួយ ដោយ អាការៈ មិន ស្រួល នោះ គឺ យើង មិន អនុញ្ញាតឲ្យ គាត់ ឡើង រថយន្ត ទៅ ទេ ។
ដោយឡែក ចំពោះ ពលករ ដែល រកឃើញ មាន ផ្ទុក ជំងឺ កូវីដ១៩ គឺ មាន ឈ្មោះ ស្រិល សុខ ខែន ភេទ ស្រី អាយុ ២៩ ឆ្នាំ រស់ នៅ ស្រុក ចុង កាល់ ខេត្ត ឧត្តរមានជ័យ ។
ក្នុង ករណី នេះ លោក ប្រធាន មន្ទីរ សុខាភិបាល ក៏ បាន ថ្លែង ណែនាំ បន្ថែម ដល់ មន្ត្រី ដែល ប្រចាំ ការ នៅ ច្រក ព្រំដែន អន្តរជាតិ អូរ ស្មាច់ ត្រូវ បន្ត ការប្រុងប្រយ័ត្ន ខ្ពស់ ត្រួតពិនិត្យ ឲ្យបាន ច្បាស់លាស់ ចំពោះ ពលករ ទាំងអស់ បើ មាន ការសង្ស័យ ត្រូវ រាយការណ៍ ជាបន្ទាន់ ដើម្បី កុំ ឲ្យ មាន ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ តទៅទៀត ៕
រដ្ឋមន្ដ្រី កសិកម្ម៖ ៤ខែ ដើម ឆ្នាំ នេះ កម្ពុជា នាំចេញ ផលិតផល កសិកម្ម ជិត ៤លាន តោន បាន ចំណូល ជាង ២ពាន់ លាន ដុល្លារ
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្ដ្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ អំពី លទ្ធផល នៃ ការនាំចេញ ផលិតផល កសិកម្ម ក្នុង រយៈពេល ៤ខែ ដើម ឆ្នាំ ២០២១ ។
របាយការណ៍ បាន បន្ថែម ទៀត ថា តម្លៃ សរុប រួម នៃ ការនាំចេញ ផលិតផល កសិកម្ម សរុប ចំនួន ២ ០៩១ ១៦៦ ០១៦. ៤២ ដុល្លារ ដែល ក្នុង នោះ រួម មាន៖
ខាងក្រោម នេះ ជា របាយការណ៍ លទ្ធផល នៃ ការនាំចេញ ផលិតផល កសិកម្ម ៤ខែ ដើម ឆ្នាំ ២០២១ ដែល ផ្សព្វផ្សាយ លើ Facebook ផ្លូវការ របស់ លោក រដ្ឋមន្ត្រី វេង សាខុន៖ រដ្ឋបាល ខេត្ត ព្រះសីហនុ សម្រេច យក ទីតាំង ទីក្រុង រស្មី មង្គល ជា កន្លែង ព្យាបាល អ្នក កើត កូវីដ និង សម្រាប់ ធ្វើចត្តាឡី ស័ក អ្នក ជាសះស្បើយ
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន សម្រេច យក ទីតាំង ទីក្រុង រស្មី មង្គល ស្ថិត ក្នុង ភូមិ ចំណោត រាម ឃុំ បិត ត្រាំង ស្រុក ព្រៃនប់ ជា កន្លែង ព្យាបាល អ្នក កើត ជំងឺ កូវីដ១៩ និង ជា កន្លែង ធ្វើចត្ដាឡី ស័ក ចំពោះ បុគ្គល ដែល ព្យាបាល ជាសះស្បើយ ទទួលបាន លទ្ធផល តេស្ដ អវិជ្ជមាន កូវីដ១៩ ចំនួន ២លើក ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ផ្តល់ អនុសាសន៍ សំខាន់ ៗ ៥ចំណុច ដល់ ក្រុមការងារ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ ជូន ពលរដ្ឋ នៅ តំបន់ ក្រហម
( ភ្នំពេញ ) ៖ ដើម្បី សម្រេច ផែនការអនុវត្ត យុទ្ធនាការ ជាតិ ចាក់ វ៉ាក់សាំង របស់ រាជ រដ្ឋាភិបាល ឱ្យ ទទួលបាន ជោគជ័យ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន ផ្តល់ អនុសាសន៍ សំខាន់ ៗ ចំនួន ៥ ចំណុច ដល់ ក្រុមការងារ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ កម្មករ កម្ម ការិនី នៅ តំបន់ ក្រហម ស្ថិត នៅក្នុង ខណ្ឌ ទាំង៤ រួម មាន៖ ខណ្ឌ ពោធិ៍សែនជ័យ . ខណ្ឌ មានជ័យ . ខណ្ឌ កំបូល និង ខណ្ឌ ដង្កោ ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ។
ការផ្តល់ អនុសាសន៍ ទាំង ៥ចំណុច នេះ របស់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ នៅក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតីភាព បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ដល់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង តំបន់ ក្រហម ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ទីក្រុង តាខ្មៅ នៃ ខេត្ត កណ្ដាល ដែល រៀបចំឡើង នៅក្នុង ទីតាំង មូលដ្ឋាន កងទ័ព នៃ កងពល តូច លេខ ៧០ ស្ថិត ក្នុង ភូមិ ព្រៃ ព្រីង ខាងត្បូង សង្កាត់ ចោម ចៅ រាជធានី ភ្នំពេញ ។
អនុសាសន៍ ទាំង ៥ចំណុច របស់ សម្តេច រដ្ឋមន្ត្រី ការពារ ជាតិ រួម មាន៖
ទី៣៖ អនុគណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង វីដ - ១៩ រាជធានី ភ្នំពេញ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ត្រូវ ចាត់ មន្ត្រី សហការ ជាមួយ អនុគណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្រសួង ការពារ ជាតិ តាមដាន ការងារ ទាំង មុនពេល ដំណើ ការ ពេល ដំណើរការ និង ក្រោយពេល ដំណើរការ « យុទ្ធនាការ ជាតិ ចាក់ វ៉ាក់សាំង » ដើម្បី ជំរុញ ការចាក់ វ៉ាក់សាំង នេះ ឱ្យ បាន លឿន តាម ដែល អាច ធ្វើ ទៅ បាន ។
ទី ៤៖ រដ្ឋបាល រាជធានី ភ្នំពេញ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ ធ្វើ ការផ្សព្វផ្សាយ អំពាវនាវ ជូន ប្រជាពលរដ្ឋ ក្នុង ខណ្ឌ ទាំង៤ ឱ្យ បាន ជ្រួតជ្រាប ពី នីតិវិធី ឯកសារ ពាក់ព័ន្ធ ពេលវេលា និង ទីតាំង ចាក់ វ៉ាក់សាំង ដើម្បី ចូលរួម អនុវត្ត « យុទ្ធនាការ ជាតិ ចាក់ វ៉ាក់សាំង » របស់ រាជ រដ្ឋាភិបាល ឱ្យ សម្រេចបាន ជោគជ័យ ។
និង ទី៥៖ ក្រុម គ្រូពេទ្យ ក្រុម បច្ចេកទេស និង សមត្ថកិច្ច ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ចូលរួម អនុវត្ត និង ប្រកាន់ ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធានការ សុខាភិបាល និង តាម អនុសាសន៍ ណែនាំ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី « ៣ការពារ និង ៣កុំ » ។ ត្រូវ អនុវត្ត ដោយ ហ្មត់ចត់ នូវ វិធានការ សុខាភិបាល តាម វិជ្ជាជីវៈ របស់ គ្រូពេទ្យ ធានា ដំណើរការចាក់ វ៉ាក់សាំង ប្រកបដោយ ប្រសិទ្ធភាព ជៀសវាង នូវ ការចម្លង ជំងឺ កូវីដ១៩ នៅ តាម ទីតាំង កំពុង ដំណើរការ ៕
ការសន្និដ្ឋាន របស់ ក្រុម គ្រូពេទ្យ បុរស ជនជាតិ ចិន អាយុ ៤១ ឆ្នាំ ខាងលើ នេះ បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ វិបត្តិ ផ្លូវ ដង្ហើម ស្រួច ស្រាវ ធ្ងន់ធ្ងរ និង រលាក សួត ទាំង សងខាង ដោយសារ វីរុស កូវីដ១៩ លើ អ្នក មាន ជំងឺ ទឹកនោម ផ្អែម ប្រចាំ កាយ ។ ក្រសួង សុខាភិបាល សូម ចូលរួមចំណែក សោកស្ដាយ ជា ពន់ពេក និង សូម ចូលរួម មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជា ទីបំផុត ជាមួយ ក្រុមគ្រួសារ សព ។
សូម ជម្រាប ថា គិត ត្រឹម ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ ចំនួន អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា កើតឡើង រហូដល់ ៩៣ នាក់ ៕
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គឺ ភាគ ច្រើន អត់ មួក ល្មើស សញ្ញា និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត ល្មើស ល្បឿន ល្មើស សញ្ញា អត់ ប័ណ្ណ បើកបរ អត់ ខ្សែក្រវ៉ាត់ លើស ចំណុះ និង អាជីវកម្ម ជាដើម ។
លោក ស៊ី ជីន ភីង ប្រធាន រដ្ឋ ចិន លើកទឹកចិត្ត ឱ្យ យុវជន ខិតខំ តស៊ូ ឥត ស្រាកស្រាន្ត
( ប៉េកាំង ) ៖ លោក ស៊ី ជីន ភីង អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនិស្ត ចិន ធ្លាប់ បាន ថ្លែង ជាច្រើន ដង ថា ប្រសិនបើ ជំនាន់ យុវជន មាន ឧត្តម គតិ មាន សមត្ថភាព និង មាន ទំនួល ទទួលខុសត្រូវ នោះ ប្រទេសជាតិ នឹង មាន អនាគត ជនជាតិ មាន ក្តីសង្ឃឹម ។ តាំងពី សមាជ បក្ស កម្មុយនិស្ត ចិន លើក ទី ១៨មក លោក ស៊ី ជីន ភីង បាន លើកទឹកចិត្ត ឱ្យ យុវជន ផ្សារភ្ជាប់ ឧត្តម គតិ និង ការខិតខំ ប្រឹងប្រែង របស់ ខ្លួន ជាមួយ កិច្ចការ ប្រទេសជាតិ និង ជនជាតិ ដើម្បី ធ្វើឱ្យ យុវភាពរីក ស្គុស ស្គាយ ដូច ផ្កា ។
បទ វិភាគ អន្តរជា តិ៖ ហេតុ អ្វី អារ៉ាប៊ី សាអូឌីត ស្រាប់តែ ចង់ ជា នា គ្នា វិញ ជាមួយ អ៉ីរ៉ង់ ?
« បច្ចុប្បន្ន យើង កំពុង ធ្វើការ ជាមួយ ដៃគូ របស់ យើង នៅក្នុង តំបន់ និង ពិភពលោក ដើម្បី ស្វែងរក ដំណោះស្រាយ សម្រាប់ បញ្ហា ទាំងនេះ ... អ៉ីរ៉ង់ គឺជា អ្នកជិតខាង ដូច្នេះ អ្វី ដែល យើង ចង់បាន នោះ គឺ មាន ទំនាក់ទំនង ល្អ ជាមួយ អ៉ីរ៉ង់ » ។ នេះ ជា ការលើកឡើង របស់ ព្រះអង្គម្ចាស់ ប៊ិន សាល់ម៉ាន ហើយ ឆ្លើយតប ទៅនឹង ការលើកឡើង នេះ អ៉ីរ៉ង់ ក៏ បាន បង្ហាញ ការស្វាគមន៍ និង ថែមទាំង សង្ឃឹម ផងដែរ ថា ប្រទេស ទាំង២ អាចនឹង ធ្វើ ការរួមគ្នា ដើម្បី ធានា សន្តិភាព នៅក្នុង តំបន់ ។
អភិបាល ខេត្ត កំពង់ធំ ចុះ ត្រួតពិនិត្យ សកម្មភាព កងកម្លាំង នៅ តំបន់ បិទ ខ្ទប់ ក្នុង ភូមិសាស្ត្រ ស្រុក ស្ទោង និង ពិនិត្យមើល ទីតាំង ដែល ត្រៀម សម្រាប់ ទុកដាក់ អ្នកសង្ស័យ ឆ្លង ជំងឺ កូវីដ១៩
លោក សុខ លូ បាន ក្រើនរំឭក ដល់ កងកម្លាំង ចម្រុះ ទាំងអស់ ក្នុង អំឡុង ពេល បិទ ខ្ទប់ ប្រជាពលរដ្ឋ គ្រប់ រូប ត្រូវបាន ហាមឃាត់ ការធ្វើដំណើរ ចេញ ពី លំនៅឋាន លើកលែងតែ ក្នុង ករណី ចាំបាច់ ហើយ ការបិទ ខ្ទប់ ភូមិ ក្នុង ទី រួម ស្រុក ស្ទោង នៅ ពេល នេះ គឺជា វិធានការ មួយ ក្នុង កាត់ផ្តាច់ នូវ ការឆ្លង មេរោគ កូវីដ១៩ នៅក្នុង មូលដ្ឋាន នីមួយ ៗ ដែល កើត ចេញ ពី ព្រឹត្តិការណ៍ ២០កុម្ភៈ ។
លោក សុខ លូ បាន បាន ដាស់តឿន ដល់ កងកម្លាំង ទាំងអស់ ត្រូវ សាមគ្គី ឱ្យ បាន ល្អ ជាមួយ កម្លាំង សមត្ថកិច្ច គ្រប់ ស្ថាប័ន អាជ្ញាធរដែនដី ហើយ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ វិធានការ « ៣ការពារ និង ៣កុំ » របស់ សម្តេច តេជោ ហ៊ុន សែន និង វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
ដើម្បី ជា ការលើកទឹកចិត្ត ដល់ កងកម្លាំង ដែល បំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន . លោក អភិបាល ខេត្ត បាន នាំយក នូវ គ្រឿង ឧបភោគ បរិភោគ និង សម្ភារ ប្រើប្រាស់ ការពារ កូវី ដ១៩ មួយចំនួន ផងដែរ ។
លោក ណែត សារី អភិបាល ស្រុក ស្ទោង បាន ថ្លែងអំណរគុណ ដល់ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន ផ្ដល់ សម្ភារ ដល់ រដ្ឋបាល ស្រុក ដើម្បី យកមក ប្រើប្រាស់ បម្រើ ប្រជាពលរដ្ឋ ដែល ប្រជាជន មាន ទុក្ខលំបាក ។ លោក បាន បញ្ជាក់ ថា ស្រុក ស្ទោង ចាប់ពី ថ្ងៃទី ២៨ មកដល់ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន រកឃើញ ឆ្លង ចំនួន ១៥នាក់ ( ស្រី ៣នាក់ ) ក្នុង ចំណោម ប្រជាពលរដ្ឋ យក សំណាក មក ធ្វើតេស្ត សរុប ៤៦០ នាក់ ក្នុង នោះ អាជ្ញាធរ បាន ត្រៀម មណ្ឌល សម្រាប់ ធ្វើចត្តាឡី ស័ក មាន ពីរ កន្លែង ផងដែរ ៕
( កំពង់ស្ពឺ ) ៖ នៅ រសៀល ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២១ កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក សំរោងទង បាន បញ្ជូន មនុស្ស ៨នាក់ ដែល ត្រូវបាន ឃាត់ខ្លួន ពេល កំពុង ប្រមូលផ្តុំ លេង ល្បែង ទៅ ធ្វើតេស្ត រក កូវីដ១៩ មុន បញ្ជូន ទៅ តុលាការ ដើម្បី ចាត់ការ តាម ច្បាប់ ។
ករណី នេះ ត្រូវបាន នគរបាល ស្រុក សំរោងងទង បង្ក្រា នៅក្នុង ចំការស្វាយ ខាងលិច ភូមិ សន្តិភាព ឃុំ តាំង ក្រូច ស្រុក សំរោងទង ខេត្ត កំពង់ស្ពឺ ដែល ម្ចាស់ ចំការឈ្មោះ ចឹក ទ្រី អាយុ ៥៥ ឆ្នាំ រស់ នៅ ភ្នំពេញ សព្វ ថ្ងៃ ជួល ឲ្យ ឈ្មោះ នៅ ណា ឃីន អាយុ ២៥ ឆ្នាំ រស់ នៅ ភូមិ សន្តិភាព ឃុំ តាំង ក្រូច ស្រុក សំរោងទង ។
មនុស្ស ដែល ត្រូវ បញ្ជូន ទៅ យក សំណាក ពិនិត្យ រក មេរោគ កូវីដ១៩ រួម មាន៖
សមត្ថកិច្ច បាន បង្ក្រាប និង ដកហូត វត្ថុតាង រួម មាន៖
ចំពោះ លទ្ធផល យក សំណាក លើក ទី១ ក្រុមការងារ មន្ទីរពេទ្យ ខេត្ត កំពង់ស្ពឺ បាន មក ធ្វើតេស្ត យក សំណាក អ្នក ៨នាក់ ហើយ ទទួលបាន លទ្ធផល អវិជ្ជមាន ។ ចំពោះ ករណី នេះ ជំនាញ កំពុង ធ្វើ ការសាកសួរ និង កសាង សំណុំ រឿង ចាត់ការ តាម នីតិវិធី ៕
ទេសរដ្ឋមន្ដ្រី អូស្មាន ហាស្សាន់ ប្រគល់ អំណោយ ជូន ពលរដ្ឋ ខ្មែរ ឥស្លាម ៤២៥ គ្រួសារ នៅ ស្រុក ព្រៃនប់
( ព្រះសីហនុ) ៖ លោក អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស បាន ចាត់ លោក កៅ អ៉ីម រ៉ន អនុ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន និង ជា អនុប្រធាន ក្រុមការងារ ចុះ ជួយ តំបន់ ខ្មែរ ឥស្លាម ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន យក អំណោយ គ្រឿង ឧបភោគ បរិភោគ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ខ្វះខាត ជាក់ស្តែង ១៧ភូមិ នៅក្នុង ខេត្ត ព្រះសីហនុ ចំនួន ៤២៥ គ្រួសារ ។
ក្នុង ឱកាស នោះ លោក កៅ អ៉ីម រ៉ន បាន ចែកជូន អ្នក ខ្វះខាត ៣០០ គ្រួសា ដែល បាន ប្រគល់ជូន ជា និម្មិត្តរូប ៥០ គ្រួសារ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ២០ គីឡូក្រាម ស្ករ ស២គីឡូក្រាម . ទឹកដោះគោ ខាប់ ៥កំប៉ុង និង ប្រេង ឆា២លីត្រ ជា អំណោយ ពី អង្គការ ពិភព ឥស្លាម RABITA ។
ចំណែក ចំនួន ១២៥ គ្រូសារ ថែម ទៀត ទទួល អំណោយ របស់ ប្រធាន ក្រុមការងារ ចុះ ជួយ ខេត្ត ព្រះសីហនុ តាមរយៈ លោក សេន ណាស៊ី ប្រធាន ក្រុមការងារ ចុះ ជួយ តំបន់ ខ្មែរ ឥស្លាម ខេត្ត ព្រះសីហនុ និង គណៈ អ៊ីម៉ាំ ខេត្ត ព្រះសីហនុ ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន មី ១កេស . អង្ករ ១០គីឡូក្រាម . ត្រីខ ១យួរ . ប្រេង ឆា១ ដប និង ទឹកត្រី ១ដប ។
គូរ បញ្ជាក់ ថា នា ឆ្នាំ ២០២១ នេះ អង្គការ សម្ព័ន្ធ ពិភព ឥស្លាម បាន ផ្តល់ កញ្ចប់ អាហារ ស្រាយ បួស ដល់ សាសនិក ឥស្លាម កម្ពុជា សរុប ចំនួន ២. ១៣០កញ្ចប់ ដែល បាន និង កំពុង ធ្វើ ការចែកជូន ដល់ សាសនិក ឥស្លាម ជា បន្តបន្ទាប់ តាម បណ្តា ខេត្ត ដែល តម្រូវ ការចាំបាច់ ជាក់ស្តែង ៕
ការនាំយក អាហារ បំប៉ន បែឡា សុល (Bellasol) នេះ គឺ បាន បង្ហាញ ពី ទឹកចិត្ត ចូលរួម កាត់បន្ថយ ការលំបាក របស់ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ ដែល បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការចុះ យក សំណាក និង ដឹក អ្នកជំងឺ កូវីដ១៩ ទៅកាន់ មន្ទីរពេទ្យ ។
( ត្បូងឃ្មុំ ) ៖ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ នៅ ល្ងាច ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បង្ហាញ អំពី ការរកឃើញ មនុស្ស ៥នាក់ បន្ថែម ទៀត កើត ជំងឺ កូវីដ១៩ រស់ នៅ ភូមិ ដី ដុះ ឃុំ ប៉ើស២ ស្រុក ក្រូចឆ្មារ ខេត្ត ត្បូងឃ្មុំ ។ នេះ បើ តាម សេចក្ដីប្រកាស ព័ត៌មាន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល ប៉ះពាល់ ផ្ទាល់ សូម រួសរាន់ ទៅ ជួប ក្រុម គ្រូពេទ្យ និង ធ្វើចត្តាឡី ស័ក ដើម្បី យក សំណាក ទៅ ពិនិត្យ និង អ្នក ប៉ះពាល់ ដោយ ប្រយោល ជាមួយ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ សូម ធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ រៀង ៗ ខ្លួន ដោយ មិន ត្រូវ ពាក់ព័ន្ធ និង ប៉ះពាល់ ជាមួយ អ្នកដទៃ ជាដាច់ខាត ៕
( ភ្នំពេញ ) ៖ លោកស្រី ឱ វណ្ណឌីន ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ បាន ណែនាំ ដល់ ក្រុមការងារ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ទាំងអស់ សូម គោរព ឱ្យ បាន តាម ស្តង់ដារ ប្រតិបត្តិ និង បច្ចេកទេស នៃ ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ និង អនុវត្ត ការពារ ការចម្លង វីរុស កូវីដ១៩ ឱ្យ បាន ហ្មត់ចត់ ដើម្បី ធានា បាន នូវ សុវត្ថិភាព ផ្ទាល់ខ្លួន ក៏ ដូចជា អ្នក ដែល បាន មក ចាក់ វ៉ាក់សាំង ។
លោកស្រី ឱ វណ្ណឌីន បាន ណែនាំ យ៉ាង ដូច្នេះ ថា៖ « នាងខ្ញុំ សូម ធ្វើ ការណែនាំ ដល់ ក្រុមការងារ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ទាំងអស់ សូម គោរព ឱ្យ បាន តាម ស្តង់ដារ ប្រតិបត្តិ និង បច្ចេកទេស នៃ ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ និង អនុវត្ត ការពារ ការចម្លង វីរុស កូវីដ១៩ ឱ្យ បាន ហ្មត់ចត់ មែនទែន ដើម្បី ធានា បាន នូវ សុវត្ថិភាព ផ្ទាល់ខ្លួន ក៏ ដូចជា អ្នក ដែល បាន មក ចាក់ វ៉ាក់សាំង ផងដែរ » ។
( ប៉េកាំង ) ៖ បន្ទាប់ពី សមាជ បក្ស កុម្មុយនិស្ត ចិន លើក ទី ១៨មក លោក ស៊ី ជីន ភីង ប្រធាន រដ្ឋ ចិន បាន ទៅ ទស្សនា កន្លែង ប្រវត្តិសាស្ត្រ នៃ មហា ដំណើរ ជាច្រើន លើក និង បាន រំលឹក ពី រឿងរ៉ាវ នៃ មហា ដំណើរ ជាច្រើន សា ។ ក្នុង ដួងចិត្ត របស់ មេដឹកនាំ ប្រទេស ចិន រូប នេះ ស្មារតី មហា ដំណើរ ស្តីពី « ឧត្តម គតិ បដិវត្តន៍ ខ្ពស់ ជាង មេឃ » បាន បញ្ជ្រាប យ៉ាង ស៊ីជម្រៅ ក្នុង សរសៃ ឈាម របស់ ប្រជាជាតិ ចិន ។
ក្នុង ដំណើរតស៊ូ ដ៏ វែងឆ្ងាយ ដែល ពោរពេញ ដោយ ក្តីលំបាក ខ្លាំង លើសលុប តើ អ្វី ទៅ បាន លើកទឹកចិត្ត ដល់ កងទ័ព ក្រហម ឱ្យ ឈាន ទៅ មុខ ជាប់ រហូត ? លោក ស៊ី ជីន ភីង បាន ផ្តល់ ចំណាប់អារម្មណ៍ ថា៖ « ភាពជោគជ័យ នៃ មហា ដំណើរ គឺ ដោយសារ កងទ័ព ក្រហម បាន ប្រកាន់ខ្ជាប់ នូវ ស្មារតី វីរ ជន និង ស្មារតី បដិវត្តន៍ ពោលគឺ មិន ខ្លាច សត្រូវ ណា ទាំងអស់ ហើយ ហ៊ាន ពុះពារ ក្តី លំបាក ទាំងអស់ » ។
លោក ស៊ី បាន បន្ត ទៀត ថា៖ « គឺ ការហ៊ាន ពលី អ្វី ៗ ទាំងអស់ ដើម្បី សង្គ្រោះ ប្រទេសជាតិ សង្គ្រោះ ប្រជាជន មិន ខ្លាច ការលំបាក គ្រប់ បែបយ៉ាង ។ គឺ ការប្រកាន់ខ្ជាប់ ភាពឯករាជ្យ ម្ចាស់ ការ ធ្វើ ការ ដោយ គោរព ការពិត និង ភាព ជាក់ស្តែង ។ គឺ ការគាំពារ ស្ថានការណ៍ ទូទៅ គោរព វិន័យ និង សាមគ្គី គ្នា យ៉ាង ស្អិត ល្មួត ។ គឺ ការពឹងផ្អែក លើ ប្រជាជន ស្លាប់ រស់ ជាមួយ ប្រជាជន រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន ខិតខំ តស៊ូ ដើម្បី ប្រជាជន » ។
លោក ប្រធាន រដ្ឋ ចិន បាន គូសបញ្ជាក់ ជា ចុងក្រោយ យ៉ាង ដូច្នេះ៖ « មិន ថា ទទួលបាន សមិទ្ធផល ច្រើន ប៉ុណ្ណា ហើយ ក្តី ក៏ បក្ស កុម្មុយនិស្ត ចិន នឹង បន្ត ផ្សព្វផ្សាយ ស្មារតី មហា ដំណើរ ដើម្បី ឈាន ទៅ មុខ រហូត ដោយ ទឹកចិត្ត អង់អាច ក្លាហាន »៕
លោក ស៊ី បាន បន្ត ទៀត ថា៖ « គឺ ការហ៊ាន ពលី អ្វី ៗ ទាំងអស់ ដើម្បី សង្គ្រោះ ប្រទេសជាតិ សង្គ្រោះ ប្រជាជន មិន ខ្លាច ការលំបាក គ្រប់ បែបយ៉ាង ។ គឺ ការប្រកាន់ខ្ជាប់ ភាពឯករាជ្យ ម្ចាស់ ការ ធ្វើ ការ ដោយ គោរព ការពិត និង ភាព ជាក់ស្តែង ។ គឺ ការគាំពារ ស្ថានការណ៍ ទូទៅ គោរព វិន័យ និង សាមគ្គី គ្នា យ៉ាង ស្អិត ល្មួត ។ គឺ ការពឹងផ្អែក លើ ប្រជាជន ស្លាប់ រស់ ជាមួយ ប្រជាជន រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន ខិតខំ តស៊ូ ដើម្បី ប្រជាជន » ។
លោក ស៊ី ជីន ភីង លើកទឹកចិត្ត ពលករ គ្រប់ រូប ថា ត្រូវ ឧស្សាហ៍ ព្យាយាម ក្នុង ការបង្កើត ថ្មី និង ខិតខំ តស៊ូ ដោយ ក្លាហាន
( ប៉េកាំង ) ៖ លក្ខណៈ សម្បត្តិ គុណភាព របស់ ពលករ មាន អត្ថន័យ សំខាន់ ដល់ ការអភិវឌ្ឍ របស់ ប្រទេសជាតិ និង ប្រជាជាតិ មួយ ។ ពេល ជួប សំណេះសំណាល ជាមួយ ពលករ គំរូ និង តំណាង យុវជន និង ចុះ ត្រួតពិនិត្យ ការងារ លោក ស៊ី ជីន ភីង ប្រធាន រដ្ឋ ចិន បាន គូសបញ្ជាក់ ពី សារៈសំខាន់ នៃ ការលើកកម្ពស់ លក្ខណសម្បត្តិ របស់ ពលករ ។
ពេល ថ្មី ៗ នេះ លោក ស៊ី ជីន ភីង ក៏ បាន ចេញ អនុសាសន៍ គន្លឹះ ចំពោះ ការអប់រំ វិជ្ជាជីវៈ ដោយ គូសបញ្ជាក់ ថា ត្រូវ បណ្តុះបណ្តាល ធនធាន មនុស្ស កាន់តែ ច្រើន ដែល មាន បច្ចេកទេស ខ្ពស់ ដើម្បី ផ្តល់ ការទ្រទ្រង់ សម្រាប់ សម្រេច សុបិន ប្រទេស ចិន ដែល ស្តារ ភាព រុងរឿង ដ៏ មហិមា នៃ ប្រជាជាតិ ចិន ឡើងវិញ ។ ក្នុង ឱកាស ទិវា ពលកម្ម អន្តរជាតិ ជិត ចូល មកដល់ យើង មក រំលឹក ឡើងវិញ នូវ អនុសាសន៍ របស់ លោក ស៊ី ជីន ភីង ថ្លែង ចំពោះ ពលករ ។
សេដ្ឋកិច្ច របស់ ប្រទេស ចិន ត្រូវ ពឹងផ្អែក សេដ្ឋកិច្ច ពិត ដែល មាន តម្រូវការខាង ធនធាន មនុស្ស មាន ជំនាញ ឯកទេស យ៉ាង ច្រើន សន្ធឹក ។ ដូច្នេះ ការអប់រំ វីជ្ជាជីវៈ គឺ មាន អនាគត ល្អ សង្ឃឹម ថា អ្នក ទាំងអស់ គ្នា បន្ត វេន នូវ ប្រពៃណី ល្អ ផូរផង់ និង ដើរ ស្រប តាម តម្រូវការ នៃ យុគសម័យ ៕
( ប៉េកាំង ) ៖ ក្នុង មហា ដំណើរ ថ្មី ដើម្បី សម្រេច គោលដៅ មួយ រយ ឆ្នាំ ទី២ យើង ត្រូវ មាន ជំនឿ លើ ជ័យជម្នះ ដាច់ខាត ដើម្បី យកឈ្នះ នូវ ហានិភ័យ និង បញ្ហា ប្រឈម ផ្សេង ទាំង ក្នុង ស្រុក និង ក្រៅ ប្រទេស ដើម្បី ឆ្ពោះទៅ ដំណើរ ថ្មី នៃ ការសម្រេច គោលដៅ ស្តារ ភាព រុងរឿង ដ៏ អស្ចារ្យ របស់ ប្រជាជាតិ ចិន ឡើងវិញ ។
ត្រូវ អភិវឌ្ឍ ជនបទ ចិន ដោយ គ្រប់ ជ្រុងជ្រោយ បច្ចុប្បន្ន នេះ ជនជាតិ ចំនួន ៥៦ នៅ ទូទាំង ប្រទេស ចិន សុទ្ធតែ បាន ចេញ ផុត ពី ភាពក្រីក្រ ហើយ ប៉ុន្តែ យើង មិន អាច បញ្ឈប់ ជំហាន នោះ ទេ យើង ត្រូវ បន្ត ដើរ ទៅ មុខ ទៀត ។ យើង ត្រូវ បន្ត ធ្វើ ការតស៊ូ ពី ចំណុច ចាប់ផ្តើម ថ្មី ដើម្បី ជំរុញ ភាពរុងរឿង រួម របស់ ប្រជាជន ទាំងអស់ ក្នុង ន័យ ទទួលបាន វឌ្ឍនភាព ជាក់ស្តែង ដែល គួរឱ្យ កត់សម្គាល់ បន្ថែម ទៀត ។
យើង ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ទស្សនៈ ត្រឹមត្រូវ នៃ អេកូឡូស៊ី និង ការអភិវឌ្ឍ និង ចាត់ទុក ការការពារ អេកូឡូស៊ី ភ្នំ និង ទឹក ជា ការងារ ដ៏ សំខាន់ ធ្វើឱ្យ ស៊ីជម្រៅ នូវ ការ ជំរុញ ការស្តារ អេកូឡូស៊ី និង គ្រប់គ្រង ការបំពុល បរិស្ថាន ជំរុញ ការកែលម្អ បរិស្ថាន អេកូឡូស៊ី ជា បន្តបន្ទាប់ និង ធ្វើឱ្យ ប្រសើរឡើង នូវ ប្រព័ន្ធ អេកូឡូស៊ី ជា បន្តបន្ទាប់ ក៏ ដូចជា លើកកម្ពស់ មុខងារ ទាំងមូល ជា បន្តបន្ទាប់ ។
ក្រុង Guilin ភូមិភាគ ស្វយ័ត ក្វាំង ស៊ី ជា ទីក្រុង ទេសចរណ៍ ដ៏ ល្បីល្បាញ ត្រូវ ចាត់ទុក ការអភិរក្ស អេកូឡូស៊ី នៃ ភ្នំ និង ទឹក គឺជា ការងារ ដ៏ សំខាន់ ។ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ការតម្កល់ ទុក មនុស្ស ជា ស្នូល ខិតខំ ប្រឹងប្រែង ក្នុង ការបង្កើត បរិយាកាស ល្អ ប្រសើរ ដែល មាន ផលប្រយោជន៍ ដល់ ការធ្វើ អាជីវកម្ម រស់ នៅ និង ដើរកម្សាន្ត ដើម្បី កសាង ទៅជា ទីក្រុង ទេសចរណ៍ លំដាប់ ពិភពលោក ។
ឧស្សហកម្ម ផលិតកម្ម ប្រកបដោយ គុណភាព ខ្ពស់ គឺជា ការងារ សំខាន់ នៃ ការអភិវឌ្ឍ ប្រកបដោយ គុណភាព ខ្ពស់ លើ វិស័យ សេដ្ឋកិច្ច របស់ ប្រទេស ចិន ត្រូវ បន្ត ខិតខំ ប្រឹងប្រែង ជំរុញ ការធ្វើឱ្យ ប្រសើរឡើង នូវ ឧស្សាហកម្ម ប្រកាន់ខ្ជាប់ នូវ ការច្នៃប្រឌិត ថ្មី ដោយ ម្ចាស់ ការ យ៉ាង មុតមាំ មិន ងាក រេ ធ្វើឱ្យ ការអភិវឌ្ឍ និង ការច្នៃប្រឌិត ថ្មី ស្ថិត នៅក្នុង ដៃ របស់ ខ្លួន យើង ។
ការអភិវឌ្ឍ ឧស្សាហកម្ម លក្ខណៈ ពិសេស គឺជា មធ្យោបាយ ដ៏ មាន ប្រសិទ្ធភាព សម្រាប់ អាជ្ញាធរ មូលដ្ឋាន អភិវឌ្ឍ សេដ្ឋកិច្ច ពិត ។ ត្រូវ រួមបញ្ចូល គ្នា នូវ ល័ក្ខខ័ណ្ឌ និង ឧត្តមភាព ផ្ទាល់ខ្លួន ដើម្បី ជំរុញ ការអភិវឌ្ឍ ប្រកបដោយ គុណភាព ខ្ពស់ ត្រូវ ក្តាប់ ជាប់ នូវ គុណភាព និង សុវត្ថិភាព ក៏ ដូចជា ជួយ សហគ្រាស ឯកជន ដោះស្រាយ ការលំបាក ជាក់ស្តែង និង លើកទឹកចិត្ត សហគ្រាស ឯកជន ឱ្យ ធ្វើ ការអភិវឌ្ឍ ។
ការរួម សាមគ្គី គ្នា និង ការអភិវឌ្ឍ រួម របស់ ប្រជាជាតិ ចិន គឺជា ជីវិត កម្លាំង ចលករ និង ក្តីសង្ឃឹម របស់ ប្រជាជាតិ ចិន នៅលើ ដំណើរ ថ្មី នៃ ការកសាង ប្រទេស សង្គម និយម ទំនើប ជនជាតិ ណាមួយ ក៏ មិន អាច ខ្វះ បាន ដែរ ។ យើង ត្រូវ រួមគ្នា កសាង អនាគត ដ៏ ល្អ ប្រសើរ របស់ ប្រជាជាតិ ចិន និង រួមគ្នា ចែករំលែក សមិទ្ធផល នៃ ការស្តារ ភាព រុងរឿង ដ៏ អស្ចារ្យ របស់ ប្រជាជាតិ ចិន ឡើងវិញ ៕ ពលរដ្ឋ ក្រីក្រ ៥៧ គ្រួសារ នៅ ខណ្ឌ សែនសុខ ទទួលបាន អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត តាមរយៈ លោក អភិបាល ខណ្ឌ
ពិធី ចែក អំណោយ នេះ បាន ធ្វើឡើង ចំនួន ២ ថ្ងៃ ផ្សេង គ្នា គឺ នា ថ្ងៃទី ២៩ ខែមេសា ម្សិលមិញ ត្រូវបាន ចែក អំណោយ ជូន ដល់ ប្រជាពលរដ្ឋ ទាំង ៣៧ គ្រួសារ ។
និង ថ្ងៃទី ២ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី៣០ ខែម សា ឆ្នាំ ២០២១ នេះ ត្រូវ ប្រគល់ ជូន កម្មករ សំណង់ និង ប្រជាពលរដ្ឋ ដែល ជួ បញ្ហា ជីវភាព ខ្វះខាត ក្នុង វិធានការបិទ ខ្ទប់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ចំនួន ២០ គ្រួសារ ។
ក្នុង ពិធី ចែក អំណោយ នេះ លោក អភិបាល ខណ្ឌ សែនសុខ បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើ ការសួរសុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដោយ បាន បញ្ជាក់ ថា ការជួយ នេះ គឺ ពុំ មាន រើសអើង និន្នាការ នយោបាយ នោះ ឡើយ ។
ជាមួយគ្នា នេះ ដែរ លោក អភិបាល ខណ្ឌ ក៏ បាន ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ ថែរក្សា សុខភាព និង រក្សា ការពារ ពី ជំងឺ កូវីដ - ១៩ ត្រូវ អនុវត្តន៍ ជាប្រចាំ នូវ វិធានការ របស់ ក្រួង សុខាភិបាល និង វិធានការ របស់ រាជ រដ្ឋាភិបាល ដែល បាន ដាក់ចេញ កន្លងមក « ៣កាពារ និង ៣កុំ » ឱ្យ បាន គ្រប់ ៗ គ្នា ជាពិសេស ទីណា មាន ទុក្ខ ទីនោះ មាន សម្តេច តេជោ និង គណបក្ស ប្រជាជន កម្ពុជា ចាំ ជួយ ជានិច្ច ។
ក្នុង នាម អាជ្ញាធរ ភូមិ វិមាន ទ្រង់ ក៏ ដូចជា ប្រជាពលរដ្ឋ រស់ នៅក្នុង ខណ្ឌ សែនសុខ សូម គោរព ថ្លែង អំអរគុណ សម្តេច ទាំង ទ្វេរ ថ្នាក់ដឹកនាំ និង ងសប្បុរសជន នានា ដែល តែងតែ យកចិត្តទុកដាក់ រាល់ បញ្ហា រសុខទុក្ខ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ក៏ ដូចជា មូលដ្ឋាន ដទៃ ទៀត ដែល កំពុង ជួប បញ្ហា រខ្វះខាត នា ដំណាក់កាល វិធានការបិទ ខ្ទប់ ដើម្បី កាត់ផ្តាច់ការរីករាលដាល់ នៃ ជំងឺ ឆ្លង កូវីដ - ១៩៕ អភិបាល ខេត្ត កំពង់ស្ពឺ សម្រេច បិទ ខ្ទប់ ភូមិ មួយ នៅ ឃុំ ព្នាយ ស្រុក សំរោងទង ក្រោយ មាន អ្នក ឆ្លង ជំងឺ កូវីដ
( កំពង់ស្ពឺ ) ៖ អភិបាល ខេត្ត កំពង់ស្ពឺ លោក វ៉ី សំណាង នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន សម្រេច បិទ ខ្ទប់ ជា បណ្ដោះអាសន្ន ភូមិ ត្នោត ជ្រុំ ឃុំ ព្នាយ ស្រុក សំរោងទង ខេត្ត កំពង់ស្ពឺ ដែល ជា តំបន់ មាន ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
ក្នុង សេចក្ដីសម្រេច ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា ភូមិ មួយ នេះ ត្រូវ បិទ រយៈពេល ២សប្ដាហ៍ គិត ចាប់ពី ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ ដល់ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២១ ដើម្បី ទប់ស្កាត់ មិន ឲ្យ ឆ្លង រាលដាល ទៅក្នុង សហគមន៍ និង តំបន់ ផ្សេង ទៀត ។
ប្រើ គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គមជាតិ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែមេសា៖ បង្ក្រាប ១៩ករណី ឃាត់ខ្លួន ៣២ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៩ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៦ករណី និង ជួញដូរ ១៣ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣២ នាក់ ។
ខេត្ត ពោធិ៍សាត់ បន្ត ដាក់ វិធានការ រដ្ឋបាល ដើម្បី ទប់ស្កាត់ កូវីដ ១សប្តាហ៍ ទៀត រហូតដល់ ថ្ងៃទី ៥ ខែឧសភា
ពលរដ្ឋ ក្រីក្រ រស់ នៅ តំបន់ ដាច់ស្រយាល ក្នុង ខេត្ត ព្រះវិហារ ១៥គ្រួសារ ទទួលបាន អំណោយ មនុស្សធម៌ ពី កាកបាទ ក្រហម កម្ពុជា
( ព្រះវិហារ ) ៖ អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា រួម មាន គ្រឿង ឧបភោគ បរិភោគ និង សម្ភារ មួយចំនួន ទៀត ត្រូវបាន នាំយក ទៅ ចែកជូន ប្រជាពលរដ្ឋ ក្រីក្រ រស់ នៅ តំបន់ ដាច់ស្រយាល នៅ ចំណុច ស្រែ ក្រសាំ ក្នុង ភូមិ អន្ទិល ឃុំ យាង ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២១ នេះ ។
ពិធី ចែក អំណោយ នេះ ស្ថិត ក្រោម វត្តមាន លោក អ៊ុង វទ្ធី អភិបាល រង ខេត្ត ព្រះវិហារ និង ជា អនុប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត តំណាង លោក ទេសរដ្ឋមន្ត្រី មាស សុភា ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត លោក ប្រាក់ សុវណ្ណ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ដោយ មាន ការចូលរួម ពី ក្រុមការងារ ជាច្រើន រូប ទៀត ។
នៅក្នុង ឱកាស នោះ លោក អ៊ុង វុទ្ធី បាន ថ្លែង ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សួរសុខទុក្ខ ពី សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ជានិច្ច ជាកាល សម្តេច តែងតែ យកចិត្តទុកដាក់ គិតគូរ ជានិច្ច ពី សុខ ទុក្ខ និង ការរស់នៅ របស់ ប្រជាពលរដ្ឋ គ្រប់ ទីកន្លែង ពោលគឺ ទីណា មាន ការលំបាក ទីនោះ មាន កាកបាទ ក្រហម កម្ពុជា ។
យ៉ាងណាមិញ ថ្ងៃ នេះ ប្រជាពលរដ្ឋ ចំនួន ១៥ គ្រួសារ ដែល មាន ជីវភាព ខ្វះខាត រស់ នៅ តបន់ ដាច់ស្រយាល ក៏ ទទួលបាន អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា ដែរ ។ លោក បាន បន្ត ថា អំណោយ នេះ ទោះ មិន បាន បំពេញ នូវ សេចក្តីត្រូវការ របស់ បងប្អូន ក៏ ពិត មែន ប៉ុន្តែ វា ជួយ សម្រាល ការលំបាក ការខ្វះខាត របស់ បងប្អូន បាន មួយ គ្រា ៗ ផងដែរ ។
លោក អ៊ុង វុទ្ធី ក៏ បាន ណែនាំ ឱ្យ ប្រជាពលរដ្ឋ ត្រូវ ចេះ ថែរក្សា សុខភាព ថែរក្សា អនាម័យ ឱ្យ បាន ល្អ ក្នុង ការរស់នៅ ដើម្បី ការពារ ពី ជំងឺ ផ្សេង ៗ ។ ពិសេស ត្រូវ បន្ត ចូលរួម អនុវត្ត ឱ្យ បាន ទៀងទាត់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង អនុសាសន៍ ណែនាំ របស់ រាជ រដ្ឋាភិបាល នូវ វិធានការ « ៣កុំ និង ៣ការពារ » ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាល នៃ ជំងឺ កូវីដ ១៩ ។
សម្តេច ក្រឡាហោម ស ខេង វាយតម្លៃ ខ្ពស់ ចំពោះ ក្រុមការងារ គណបក្ស ខេត្ត បាត់ដំបង ដែល រួម កម្លាំង សាមគ្គី បំពេញ ភារកិច្ច បម្រើ ជាតិ និង ប្រជាជន ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ និង បញ្ហា ប្រឈម ផ្សេង ៗ ទៀត
ការវាយតម្លៃ បែប នេះ របស់ សម្តេច ក្រឡាហោម ស ខេង បាន ធ្វើឡើង ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ ក្នុង ឱកាស សម្តេច បាន អញ្ជើញ ជា អធិបតី ពិធី ប្រកាស ក្រុមការងារ កិត្តិយស សម្រាប់ ពិគ្រោះ និង ផ្ដល់ យោបល់ ជូន ក្រុមការងារ អភិវឌ្ឍ យុវជន ខេត្ត បាត់ដំបង . ប្រធាន កិត្តិយស នៃ ក្រុមការងារ អភិវឌ្ឍ យុវជន ខេត្ត ព្រៃវែង និង សមាសភាព ក្រុមការងារ អភិវឌ្ឍ យុវជន ខេត្ត បាត់ដំបង តាម ប្រព័ន្ធ វីដេអូ Zoom ។ នេះ បើ យោង តាម ទំព័រ Facebook ផ្លូវការ របស់ សម្តេច ក្រឡាហោម ស ខេង ។
ពិធី ប្រគល់ និង ទទួល ស្បៀងអាហារ ខាងលើ នេះ បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នៅ សាលា រាជធានី ភ្នំពេញ ក្រោម វត្តមាន លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ជាមួយ លោក វេង សាខុន និង លោក ឧត្តមសេនីយ៍ ឯក កែវ ស៊ីម និង លោក ឧត្តមសេនីយ៍ ឯក សួន សុខ រ៉ា តំណាង ឲ្យ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង ។
អំណោយ ដែល ប្រគល់ ជូន ដោយ លោក វេង សាខុន មក រដ្ឋបាល រាជធានី ភ្នំពេញ នេះ មាន អង្ករ ចំនួន ៧៨តោន ដែល អង្ករ ទាំង នេះ បាន មក ពី ការជួយ ឧបត្ថម្ភ ពី រាជ រដ្ឋាភិបាល នៃ ប្រទេស ជប៉ុន ប្រគល់ មក ឲ្យ កម្ពុជា ។
ចំណែក លោក ឧត្តមសេនីយ៍ ឯក កែវ ស៊ីម តំណាង ឲ្យ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង បាន នាំយក អំណោយ មក ប្រគល់ ជូន សាលា រាជធានី ភ្នំពេញ រួម មាន អង្ករ ៧៥តោន ត្រីខ ៣០០ កេស ទឹកស៊ីអ៊ីវ ៣០០០យួរ ទឹកត្រី ៣០០០ យូ និង មី ៦០០០ កេស តូច ដើម្បី យក ទៅ ចែកជូន ប្រជាពលរដ្ឋ ដែល ទទួលរងគ្រោះ ឬ ប៉ះពាល់ ធ្ងន់ធ្ងរ ពី ជំងឺ រាតត្បាត កូវីដ - ១៩ នៅក្នុង តំបន់ ក្រហម ។
កាយវិការ ដ៏ ល្អ ប្រពៃ ប្រកបដោយ មនុស្សធម៌ និង គុណធម៌ ខាងលើ នេះ ពិតជា បាន រួមចំណែក យ៉ាង សំខាន់ ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ និង រាជ រដ្ឋាភិបាល ស្រប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការចាត់ វិធានការ ទប់ស្កាត់ ការរីករាលដាល នៃ មេរោគ កូវីដ១៩ នៅ រាជធានី ភ្នំពេញ ក៏ ដូចជា នៅ ទូទាំង ប្រទេស កម្ពុជា ឲ្យបាន ទាន់ ពេលវេលា ៕ គ្រឿងញៀន ជាង ១១គីឡូក្រាម ត្រូវ កម្លាំង នគរបាល ខេត្ត ស្វាយរៀង បង្ក្រាប បាន ខណៈ ជនសង្ស័យ រត់ ចូល ទឹកដី វៀតណាម ក្រោម ការតាម ចាប់ខ្លួន
( ស្វាយរៀង ) ៖ សមត្ថកិច្ច នគរបាល ខេត្ត ស្វាយរៀង បាន បង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀន ដោយ រឹបអូស បាន ជាង ១១គីឡូក្រាម ខណៈ ដែល ជនសង្ស័យ ដឹងខ្លួន ក៏ រត់ គេច ចូលក្នុង ទឹកដី វៀតណាម ក្រោម ការតាម ស្រាវជ្រាវ ចាប់ខ្លួន មក ផ្តន្ទាទោស តាម ផ្លូវ ច្បាប់ ។
សមត្ថកិច្ច នគរបាល ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ ថា ថ្នាំ ញៀន ជាង ១១គីឡូក្រាម ត្រូវបាន សមត្ថកិច្ច បង្ក្រាប បាន នៅ ចំណុច ចន្លោះ បង្គោល លេខ ១៦៩ - ១៧០ ស្ថិត ក្នុង ភូមិ តា ប៉ិប សង្កាត់ បាវិត ក្រុង បាវិត ក្នុង បទល្មើស ជួញដូរ គ្រឿងញៀន ឆ្លង ដែន ចំណែកឯ សង្ស័យ ដឹងខ្លួន បាន រត់គេចខ្លួន ចូល ទៅក្នុង ទឹកដី ប្រទេស វៀតណាម ។
សមត្ថកិច្ច បាន បន្ត ថា ជា លទ្ធផល សមត្ថកិច្ច បាន រឹបអូស វត្ថុតាង រួម មាន៖
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការបន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី រហូតដល់ ៧៦១ នាក់ ថែម ទៀត ខណៈ អ្នកជំងឺ ចំនួន ១៦៦ នាក់ បាន ជាសះស្បើយ និង អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ។
សម្រាប់ អ្នក ជាសះស្បើយ ទាំង ១៦៦ នាក់ វិញ ក្នុង នោះ មាន ម្នាក់ ជា អ្នកដំណើរ មកពី ក្រៅ ប្រទេស និង ចំនួន ១៦៥ នាក់ ជា អ្នក ឆ្លង ក្នុង សហគមន៍ នៃ ព្រឹត្តិការណ៍ ២០កុម្ភៈ ដោយ ទទួ លទ្ធផល ធ្វើតេស្ត អវិជ្ជមាន ២លើក ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ប៉ុន្តែ ត្រូវ បន្ត ធ្វើចត្តាឡី ស័ក ១៤ ថ្ងៃ ដើម្បី តាមដាន សុខភាព ។
អាជ្ញាធរ និង មន្ត្រី ជំនាញ ចុះ បិទ ហាង គោ ដុត មួយ កន្លែង នៅ ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ក្រោយ ពាក់ព័ន្ធ ជាមួយ អ្នក កើត ជំងឺ កូវីដ
( ក្រចេះ ) ៖ អាជ្ញាធរ សហការ ជាមួយ មន្រ្តី សុខាភិបាល ដឹកនាំ ដោយ លោក ធីម ស៊ាង ឡេង អភិបាល រង ស្រុក ឆ្លូង នៅ រសៀល ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចុះ បិទ ហាង គោ ដុត មួយ កន្លែង ឈ្មោះ ប៉ោ លាង គោ ដុត ត បណ្ដោះអាសន្ន ដែល មាន ទីតាំង នៅ ភូមិ ជ្រោយ ថ្ម ក្រោម ឃុំ ឆ្លូង ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ដោយ អ្នក មក ហូប គោ ដុត នៅ ហាង នេះ ត្រូវ ធ្វើតេសរកឃើញ វិជ្ជមាន កូវីដ១៩ ។
លោក ធីម ស៊ាង ឡេង បាន បញ្ជាក់ ឲ្យដឹង ថា ការចុះ បិទ ហាង នេះ បណ្ដោះអាសន្ន ដោយ មូលហេតុ នៅ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ មាន ឈ្មោះ តាំង វេង ម៉េង ភេទ ប្រុស អាយុ ៥១ ឆ្នាំ មាន ទីលំ ភូមិ ប៉ើស២ ឃុំ ប៉ើស ស្រុក ក្រូចឆ្មា ខេត្ត ត្បូងឃ្មុំ បាន មក ហូបចុក នៅ ហាង ប៉ោលាង គោ ដុត នេះ ហើយ នៅ ថ្ងៃទី៣០ ខែមេសា នេះ បុរស រូប នោះ ត្រូវ ធ្វើតេស ឃើញ វិជ្ជមាន កូវីដ១៩ នៅ ខេត្ត ត្បូងឃ្មុំ ។
ករណី នេះ ជំនាញ សុខាភិបាល បាន ដាក់ ខ្សែ ហ៊ុព័ទ្ធ មិន ឲ្យ មនុស្ស ចេញ ចូល ដាក់ កម្លាំង យាម ច្បាស់លាស់ ហើយ បាន នាំ អ្នក ពាក់ព័ន្ធ ចំនួន ៤នាក់ ស្រី ២នាក់ មក យក សំណាក ធ្វើ ការពិនិត្យ នៅ មន្ទីរពេទ្យ បង្អែក ឆ្លូង ។ បច្ចុប្បន្ន អ្នក ទាំង ៤នាក់ កំពុង ធ្វើចត្ដាឡី ស័ក នៅ មន្ទីរពេទ្យ បង្អែក ឆ្លូង ដោយ អនុវត្ដ តាម វិធានការ របស់ ក្រសួង សុខាភិបាល ៕BREAKING: រដ្ឋបាល ខេត្ត ព្រះសីហនុ បង្ហាញ អត្តសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ ចំនួន ៨៣ នាក់ ដែល ទើប រកឃើញ ឆ្លង ថ្មី
គួរ ជម្រាប ពាក់ព័ន្ធ ជាមួយ ស្ថានភាព បែប នេះ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ក៏ បាន សម្រេច ផ្អាក ការលក់ដូរ បណ្ដោះអាសន្ន នៅ ផ្សារ លើ ក្រុង ព្រះសីហនុ ជា បណ្ដោះអាសន្ន ផងដែរ ហើយ តម្រូវឲ្យ អាជីវករ និង អ្នក ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ទៅ ធ្វើចត្តាឡី ស័ក ៕ អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល៖ ការចាក់ វ៉ាក់សាំង ដល់ មន្រ្តី រាជការ មាន សន្ទុះ ខ្លាំង
( ភ្នំពេញ ) ៖ លោកស្រី ឱ វណ្ណឌីន ប្រធាន គណៈកម្មាការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ បាន ថ្លែង ថា ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន ដល់ មន្រ្តី រាជការ និង កងកម្លាំងប្រដាប់អាវុធ មាន សន្ទុះ ខ្លាំង ក្រោយពី មាន អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ការលើកឡើង បែប នេះ របស់ អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល បាន ធ្វើ ទ្បើង ក្នុង ឱកាស បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដល់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង តំបន់ ក្រហម ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ទីក្រុង តាខ្មៅ នៃ ខេត្ត កណ្ដាល ក្រោម អធិបតីភាព សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ ។
កន្លងមក សម្តេច តេជោ បាន ក្រើន រំលឹក និង ព្រមាន ដល់ កងកម្លាំងប្រដាប់អាវុធ និង មន្រ្តី រាជការ ដែល គេចវេស មិន ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ថា អាចនឹង ត្រូវបាត់បង់ ការងារ ដោយ មិន អាច ឱ្យ ចូល ទៅកាន់ ក្រសួង ស្ថាប័ន ដែល ខ្លួន បំពេញ ការងារ នោះ ឡើយ ។
បើ តាម លោកស្រី ឱ វណ្ណឌីន . ដោយ គិត ត្រឹម ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល បាន ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ចំនួន ១. ០៣៤. ៨៩០ ក្នុង នោះ មាន ស្រ្តី ចំនួន ៤៥៦. ០៩៨ នាក់ ។ ដោយ ទ្បែក រយៈពេល ដូចគ្នា នេះ ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ឮ សរុប ចំនួន ២៩៤. ៥៤៣ នាក់ ដែល ធ្វើឱ្យ ចំនួន សរុប អ្នកចាត់ វ៉ាក់សាំង នៅ ទូទាំង ប្រទេស កម្ពុជា មាន ១. ៣២៩. ៤៣៣ នាក់ ៕ រោងចក្រ មីជាតិ ជូនដំណឹង ពី ការចាក់ វ៉ាក់សាំង ដូស ទី២ ក្នុង ខណ្ឌ ព្រែក ព្នៅ សម្រាប់ មណ្ឌល « រោងចក្រ មីជាតិ »
( ភ្នំពេញ ) ៖ ដើម្បី ពន្លឿន ការចាក់ វ៉ាក់សាំង ដូស ទី២ រោងចក្រ មីជាតិ និង ទឹក ពិសាវីតាល់ សូម ជូនដំណឹង ដល់ បងប្អូន កម្មករ និយោជិក និង ថា្នក់ដឹកនាំ អង្គការ វិជ្ជាជីវៈ ដែល បាន ទទួល ការចាក់ វ៉ាក់សាំង ដូស លើក ទី១ ដោយ ក្រុម ពេទ្យ របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ស្ថិត ក្នុង ខណ្ឌ ព្រែក ព្នៅ ឲ្យបាន ជ្រាប ថា បងប្អូន អាច មក ចាក់ វ៉ាក់សាំង ដូស ទី២ នៅ មណ្ឌល « រោងចក្រ មីជាតិ » តាម កាលវិភាគ ដូច ខាងក្រោម៖
ដូច្នេះ សូម បងប្អូន កម្មករ និយោជិក និង ថា្នក់ដឹកនាំ អង្គការ វិជ្ជាជីវៈ ចូលរួម ផ្សព្វផ្សាយ បន្ត និង រួសរាន់ ក្នុង ការ ទទួល ចាក់ វ៉ាក់សាំង ដូស ទី២។ ទីតាំង មណ្ឌល « រោងចក្រ មីជាតិ » ស្ថិត នៅ លើ មហាវិថី ឈ្នះ ឈ្នះ ( ផ្លូវ កប់ ស្រូវ ) ភូមិ ភ្លូ ផ្អែម សង្កាត់ គោក រកា ខណ្ឌ ព្រែក ព្នៅ រាជធានី ភ្នំពេញ ៕
រដ្ឋបាល ខេត្ត សៀមរាប បើក ផ្សារ ពីរ និង សង្កាត់ ចំនួន ៣ ឱ្យ ធ្វើដំណើរ ចេញ - ចូល ឡើងវិញ ក្រោយ ការឆ្លង ជំងឺ កូវីដ១៩ ត្រូវបាន កាត់ផ្តាច់
( សៀមរាប ) ៖ នៅ រសៀល ថ្ងៃទី៣០ ខែមេសា នេះ រដ្ឋបាល ខេត្ត បាន សម្រេច បើក ឱ្យ មាន ការចេញ - ចូល ឡើងវិញ នូវ ផ្សារ ចំនួន ២ មាន ផ្សារ ក្រោម ផ្សារ វត្ត អធ្វា រួម និង សង្កាត់ ៣ មាន សង្កាត់ សាលា កំរើក សង្កាត់ ស្វាយ ដង្គំ និង សង្កាត់ សៀមរាប ខណៈ ដែល ស្ថានភាព នៃ ការឆ្លង ក្នុង សហគមន៍ ត្រូវបាន អាជ្ញាធរ គ្រប់គ្រង បាន ។
ផ្សារ ខាងលើ ត្រូវបាន រដ្ឋបាល ខេត្ត សៀមរាប សម្រេច បិទ ខ្ទប់ បណ្ដោះអាសន្ន កាលពី ថ្ងៃទី ១៥ ខែមេសា ខណៈ សង្កាត់ ទាំង៣ បាន បិទ ខ្ទប់ នៅ ថ្ងៃទី ១៧ ខែមេសា ខណៈ ដែល មាន អាជីវករ ប្រមាណ ១០នាក់ រកឃើញ វិជ្ជមាន កូវីដ១៩ ។
យ៉ាងណា ក្រោម ការតាមដាន យ៉ាង យកចិត្តទុកដាក់ របស់ ក្រុមការងារ ជំនាញ និង វិធាន ចត្តាឡី ស័ក បាន ធ្វើឲ្យ ករណី នេះ បាន វិល ទៅរក ភាព ប្រក្រតី និង ស្ថិត ក្រោម ការគ្រប់គ្រង ហើយ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត សម្រេច បើក ការចេញ - ចូល ឬ ដំណើរការ ឡើងវិញ ក្នុង ភូមិសាស្រ្ត សង្កាត់ ស្វាយ ដង្គំ សង្កាត់ សាលា កំរើក និង សង្កាត់ សៀមរាប រួមទាំង ផ្សារ ក្រោម និង ផ្សារ វត្ត អធ្វា ស្ថិត ក្នុង ភូមិសាស្រ្ត ក្រុង សៀមរាប ចាប់ពី ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ ត ទៅ ។
នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន អញ្ជើញ ប្រកាស បើក យុទ្ធនាការ ជាតិ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ទ្រង់ទ្រាយ ធំ ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ ។ តាម ឆន្ទៈ ប្តេជ្ញាចិត្ត ដ៏ មុតមាំ របស់ សម្តេច តេជោ ហ៊ុន សែន តាម គោលការណ៍ យើង យក វ៉ាក់សាំង មក ស្រោច តែម្តង នៅក្នុង តំបន់ ក្រហម ដែល កំពុង ឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ នឹង ចាប់ផ្តើម ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២១ ជូន ដល់ ប្រជាពលរដ្ឋ កម្មករ កម្ម ការិនី ជាង ៤៥ម៉ឺន នាក់ ស្ថិត នៅក្នុង តំបន់ ក្រហម ។
សូម ជម្រាប ថា អនុគណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ក្រសួង ការពារ ជាតិ មាន នាយ ឧត្តមសេនីយ៍ នាង ផាត រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង ការពារ ជាតិ ជា ប្រធាន អនុគណៈកម្មការ ដែល ជានិច្ចកាល បាន ខិតខំ ប្រឹង ដំណើរការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ជូន ដល់ នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន ព្រមទាំង គ្រួសារ កងទ័ព ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ផងដែរ ។
សូម បញ្ជាក់ រហូតមក ថ្ងៃទី ២៩ ខែមេសា ម្សិលមិញ ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ លើក ទី១ ជូន កងកម្លាំង បាន ចំនួន សរុប ២៩៤. ៥៤៣ នាក់ ខណៈ ចាក់ លើក ទី២ បាន ចំនួន ២៤៥. ៥៦១ នាក់ ៕
នៅ ឆ្នាំ ២០២២ ប្រជាជន មីយ៉ាន់ម៉ា ខ្ទង់ ២៥លាន នាក់ នឹង ប្រឈម ហានិភ័យ នៃ ការធ្លាក់ ទៅក្នុង ភាពក្រីក្រ
លោកស្រី វីគ ណារ៉ា ចា បាន បន្ត ថា ការអភិវឌ្ឍ នានា ដែល សម្រេចបាន អំឡុង រយៈពេល រាប់ ឆ្នាំ នៃ ការធ្វើ អន្តរកាល ទៅ រក ប្រជាធិបតេយ្យ បើ ទោះបីជា មិន ល្អ ឥត ខ្ចោះ ក៏ដោយ កំពុង ត្រូវបាន លុបចោល ទៅ វិញ ក្នុង រយៈពេល ត្រឹម ប៉ុន្មាន ខែ ប៉ុណ្ណោះ ។ បើ តាម លោកស្រី នាយិកា UNDP វឌ្ឍនភាព របស់ មីយ៉ាន់ម៉ា អាចនឹង ថយ ទៅដល់ ដូច កាលពី ឆ្នាំ ២០០៥ នៅ ពេល ដែល ប្រទេស អាស៉ី អាគ្នេយ៍ នេះ ស្ថិត ក្រោម របប យោធា ហើយ ចំនួន ប្រជាជន ខ្ទង់ ពាក់កណ្តាល ស្ថិត ក្នុង ភាពក្រីក្រ ។
គួរ បញ្ជាក់ ថា មីយ៉ាន់ម៉ា បាន ធ្លាក់ ទៅក្នុង ភាពវឹកវរ ចាប់តាំងតែពី យោធា បាន ឡើងគ្រប់គ្រង ប្រទេស ក្រោយ ផ្តួលរំលំ រដ្ឋាភិបាល ស៉ី វិល របស់ លោកស្រី អោង សាន ស៊ូ ជី ហើយ ធ្វើ សកម្មភាព បង្រ្កាប ដោយ បង្ហូរ ឈាម លើ ក្រុម បាតុករ ។ បើ តាម ការអះអាង របស់ ក្រុម សកម្មជន ដែល ឃ្លាំង មើល ស្ថានការណ៍ នៅ មីយ៉ាន់ម៉ា មនុស្ស សរុប ជាង ៧៥០ នាក់ បាន បាត់បង់ជីវិត ក្រោម ការបង្រ្កាប របស់ កងកម្លាំង សន្តិសុខ ៕
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ បាន ឱ្យដឹង ថា ចំពោះ ប្រតិបត្តិការ នេះ មាន កង ឯកភាព ចូលរួម ចំនួន ១៣ក្នុង នោះ រួម មាន៖ កងពល តូច លេខ ៧០. បញ្ជាការដ្ឋាន ទ័ព ពិសេស កងទ័ព ជើងគោក . យោធព ភូមិភាគ ពិសេស . បញ្ជាការដ្ឋាន កងទ័ព អាកាស . ការិយាល័យ សុខាភិបាល កងទ័ព អាកាស . ទី ចាត់ការ សុខាភិបាល . បញ្ជាការដ្ឋាន វិស្វកម្ម . បញ្ជាការដ្ឋាន កាំភ្លើង ធំ . បញ្ជាការដ្ឋាន បញ្ជូន សារ . និង សាលា. កងទ័ព ជើងទឹក . កងទ័ព អាកាស . កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រភេទ និង នាយកដ្ឋាន សុខាភិបាល ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន បញ្ជាក់ ឱ្យ បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ទ្រង់ទ្រាយ ធំ ជូន ប្រជាពលរដ្ឋ រស់ នៅ តំបន់ ក្រហម ដោយ នឹង ចាប់ បើក យុទ្ធនាការ ពី ថ្ងៃទី១ ដល់ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២១ ។ យុទ្ធនាការ នេះ ត្រូវបាន ប្រគល់ ជូន ក្រសួង ការពារ ជាតិ ជា អ្នករៀបចំ ៕
នៅលើ ពិភពលោក មាន តែ ប្រាំពីរ ប្រទេស ប៉ុណ្ណោះ ដែល មាន និង បាន ដាក់ពង្រាយ មីស៉ីល ICBM នេះ ក្នុង នោះ មាន ដូចជា សហរដ្ឋ អាមេរិក សហព័ន្ធ រុស្ស៉ី សាធារណរដ្ឋ ប្រជាមានិត ចិន ចក្រភព អង់គ្លេស សាធារណរដ្ឋ បារាំង សាធារណរដ្ឋ ឥណ្ឌា និង កូរ៉េ ខាងជើង ។ គេ អាច បាញ់ មីស៉ីល ICBM តាម មធ្យោបាយ មួយចំនួន ដូចជា បាញ់ ចេញ ពី បំពង់ ក្រោម ដី ចេញ ពី នាវា មុជទឹក ចេញ ពី រថយន្ត ធុន ធ្ងន់ និង ចេញ ពី ជើង ទម្រចល័ត លើ ផ្លូវ ដែក ផងដែរ ។
ទី ១៖ សហរដ្ឋ អាមេរិក
ទី ២៖ សហព័ន្ធ រុស្ស៉ី
ទី៤៖ កូរ៉េ ខាងជើង
ទី៥៖ សាធារណរដ្ឋ ឥណ្ឌា
ទី ៦៖ ចក្រភព អង់គ្លេស
ទី៧៖ សាធារណរដ្ឋ បារាំង
សូម ជម្រាប ថា នា ពេល កន្លងមក ប្រទេស អ៉ី ស្រាអែល ក៏ ធ្លាប់ ធ្វើតេស្ត មីស៉ីល ICBM នេះ ផងដែរ ប៉ុន្តែ គេ មិន ច្បាស់ ថា បាន ដាក់ពង្រាយ ដូច ប្រទេស ទាំង ប្រាំពីរ នេះ ឬក៏ អត់ នោះ ទេ ៕ អភិបាល ខេត្ត កំពង់ចាម សម្រេច បិទ ខ្ទប់ ឃុំ ចំនួន ៣ នៅ ស្រុក កង មាស ក្រោយ ផ្ទុះ ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ បឹង សាឡាង ជា សង្កាត់ មួយ របស់ ខណ្ឌ ទួលគោក ហើយ សង្កាត់ នេះ ត្រូវបាន អាជ្ញាធរ រាជធានី ភ្នំពេញ កំណត់ ថា ជា តំបន់ ក្រហម ដោយ កើត ជំងឺ កូវីដ១៩ ជា បន្តបន្ទាប់ ។ ដើម្បី ជួយ សម្រួល ដល់ ការលំបាក ពលរដ្ឋ នៅ តំបន់ នេះ សប្បុរសជន នៅ សហរដ្ឋ អាមេរិក បាន ផ្តល់ អំណោយ ជូន ជាច្រើន រយ គ្រួសារ ដែល មាន ទាំង ស្បៀងអាហារ និង ថវិកា ផងដែរ ក្នុង ការដោះស្រាយ ជីវភាព របស់ ពួកគាត់ ខណៈ តំបន់ នេះ ត្រូវបាន បិទ ខ្ទប់ ទាំងស្រុង ។
ការផ្តល់ អំណោយ ជូន នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ នៅលើ ផ្លូវ លេខ ៣៣៦ ក្នុង សង្កាត់ បឹងសាឡាង ខណ្ឌ ទួលគោក ក្រោម វត្តមាន លោក ឯក ឃុន ដឿន អភិបាល ខណ្ឌ ទួលគោក និង លោក យន្ត សួន តំណាង ម្ចាស់ អំណោយ នៅ សហរដ្ឋ អាមេរិក និង លោកស្រី អ៊ូ សៀថុង ។
លោក ឯក ឃុន ដឿន ក្នុង ឱកាស នោះ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ឧបាសក ឆាយ អ៊ីវ ស៊ាង និង ឧបាសិកា ហុង គឹម សែ តាមរយៈ លោក យន្ត សួន តំណាង ម្ចាស់ អំណោយ នៅ សហរដ្ឋ អាមេរិក ដែល បាន ជួយ ឧបត្ថម្ភ ជា ស្បៀងអាហារ និង ថវិកា ទាំងនេះ ដើម្បី ដោះស្រាយ ការលំបាក ផ្នែក ជីវភាព ប្រជាពលរដ្ឋ នៅ តំបន់ ក្រហម នៃ សង្កាត់ បឹងសាឡាង នេះ ។
តាមរយៈ កាយវិការ ដ៏ ល្អ ប្រពៃ ប្រកបដោយ មនុស្សធម៌ និង គុណធម៌ ខាងលើ ពិតជា បាន រួមចំណែក យ៉ាង សំខាន់ ជាមួយ អាជ្ញាធរ និង រាជ រដ្ឋាភិបាល ស្រប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ក្នុង ការចាត់ វិធានការ ទប់ស្កាត់ ការរីករាលដាល នៃ មេរោគ កូវីដ១៩ នៅ រាជធានី ភ្នំពេញ ។
ស្ថិត នៅ ចំពោះ ការអំពាវនាវ ពី អង្គការ អន្តរជាតិ និង អ្នកជំនាញ ក្នុង ស្រុក ជាច្រើន ឲ្យ រដ្ឋាភិបាល ឥណ្ឌា បិទ ប្រទេស ទាំងមូល ជា បណ្តោះអាសន្ន សិន ដើម្បី ទប់ស្កាត់ រលក ថ្មី នៃ ការឆ្លង រាតត្បាត COVID-19 រដ្ឋាភិបាល ទីក្រុង ញូដេលី ហាក់ មិន អាច ធ្វើ តាម បាន នោះ ឡើយ ។ យ៉ាងណា ក៏ដោយ មាន តែ រដ្ឋធានី ញូ ដេលី មួយ ប៉ុណ្ណោះ ដែល ត្រូវបាន បិទ ទ្វារ ហើយ វា នឹង ត្រូវ អូសបន្លាយ រហូតដល់ ថ្ងៃទី ០៣ ខែឧសភា ។
គួរ បញ្ជាក់ ថា យន្ដហោះ យោធា ដំបូង គេ របស់ សហរដ្ឋ អាមេរិក បាន ដឹកជញ្ជូន ជំនួយ បន្ទាន់ ក្នុង នោះ រួម មាន ទាំង អុកស៊ីសែន . ម៉ាស N95 និង ឧបករណ៍ ធ្វើតេស្ដ រហ័ស ជាដើម ទៅដល់ ប្រទេស ឥណ្ឌា ហើយ នៅ ថ្ងៃសុក្រ នេះ ហើយ ជំនួយ ទាំងនេះ ដែល គិត ជា ទឹកប្រាក់ សរុប ច្រើន ជាង ១០០ លាន ដុល្លារ នឹង បន្ត មកដល់ ឥណ្ឌា ជា បន្តបន្ទាប់ ទៀត ។ ឥណ្ឌា ក៏ កំពុង ជំរុញ ការផលិត អុកស៊ីសែន ក្នុង ស្រុក ផងដែរ ដែល អាចនឹង បង្កើន ចំនួន ផ្គត់ផ្គង់ រហូតដល់ ២៥% បន្ថែម ទៀត នៅ ត្រឹម ពាក់កណ្តាល ខែឧសភា ខាងមុខ ៕
អាជ្ញាធរ ខេត្ត កំពង់ចាម បន្ដ បិទ ខ្ទប់ ភូមិ២ បន្ថែម ទៀត នៅ ឃុំ ព្រែក ពោធិ៍ ស្រុក ស្រីសន្ធ រ ក្រោយ រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ
ក្រសួង ព័ត៌មាន ចេញ សេចក្តីណែនាំ ស្តីពី ការធ្វើដំណើរ របស់ អ្នកសារព័ត៌មាន ក្នុង អំឡុង ពេល បិទ ខ្ទប់ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ
( ភ្នំពេញ ) ៖ ក្រសួង ព័ត៌មាន នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីណែនាំ ស្តីពី ការធ្វើដំណើរ របស់ អ្នកសារព័ត៌មាន ក្នុង អំឡុង ពេល បិទ ខ្ទប់ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ។
សេចក្តីណែនាំ នេះ បាន ធ្វើឡើង បន្ទាប់ពី ក្រសួង ព័ត៌មាន បាន សង្កេតឃើញ ថា មាន អ្នកសារព័ត៌មាន មួយចំនួន តូច នៅ មិន ទាន់ យល់ ច្បាស់ និង អនុវត្ត បាន ត្រឹមត្រូវ តាម វិធានការ ដែល បាន កំណត់ នៅក្នុង តំបន់ ទាំង បី ខាងលើ ដើម្បី ចូលរួម ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ នៅក្នុង សហគមន៍ នៅឡើយ ។
ឆ្លើយតប នឹង ករណី នេះ ក្រសួង ព័ត៌មាន បាន ធ្វើ ការណែនាំ ដូច ខាងក្រោម៖
១៖ តំបន់ ក្រហម៖ ត្រូវបាន ហាមឃាត់ មិន ឱ្យ ធ្វើដំណើរ ចេញ ពី លំនៅឋាន ឬ ទីសំណាក់ បច្ចុប្បន្ន របស់ ខ្លួន ឡើយ រួមទាំង អ្នកសារព័ត៌មាន ផងដែរ ។ លើកលែងតែ អង្គភាព សារព័ត៌មាន នោះ ជា ក្រុមការងារ របស់ អង្គភាព អនុវត្ត វិធានការបិទ ខ្ទប់ របស់ ក្រសួង ព័ត៌មាន និង អង្គភាព ដែល មាន លិខិត បញ្ជាក់ ពី ក្រសួង ព័ត៌មាន ទើប អាច ធ្វើដំណើរ ក្នុង តំបន់ ក្រហម បាន ។
៣៖ តំបន់ លឿង៖ ការធ្វើចរាចរណ៍ គ្រប់ ប្រភេទ ត្រូវបាន អនុញ្ញាត ប៉ុន្តែ ត្រូវ គោរព តាម វិធានការ សុវត្ថិភាព ផ្នែក សុខាភិបាល ឱ្យ បាន ម៉ឺងម៉ាត់ ។ ការធ្វើដំណើរ ត្រូវ គោរព អនុវត្ត តាម បម្រាម គោចរ ដោយ ផ្អាក ជា បណ្តោះអាសន្ន នូវ រាល់ ការធ្វើចរាចរណ៍ និង រាល់ សកម្មភាព ការងារ នៅ ចន្លោះ ម៉ោង ២០ ( ម្ភៃ ) ដល់ ម៉ោង ៥ ( ប្រាំ ) លើកលែងតែ ករណី ចាំបាច់ ដោយ មាន ការអនុញ្ញាត ពី អាជ្ញាធរ មាន សមត្ថកិច្ច ៕
រដ្ឋបាល ខេត្ត កំពង់ចាម បន្ដ បិទ ខ្ទប់ ភូមិ ចំនួន ២ នៅ ឃុំ ព្រែក កុយ ស្រុក កង មាស ក្រោយ ផ្ទុះ ជំងឺ កូវីដ
( កំពត ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ស្នងការ នគរបាល ខេត្ត កំពត បាន ដឹកនាំ សហការី នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បន្ដ សកម្មភាព ចែក ម៉ាស់ ជា លើក ទី២ ជូន ដល់ ប្រជាពលរដ្ឋ ដែល ជា អ្នក រត់ ម៉ូតូ កង់ បី ក្នុង ភូមិសាស្ដ្រ ទី រួម ខេត្ត កំពត ដើម្បី ការពារ ខ្លួន ពី ជំងឺ ឆ្លង កូវីដ១៩ ។
ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ក៏ បាន ផ្សព្វផ្សាយ អំពី សេចក្ដីសម្រេច ថ្មី ៗ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា សេចក្ដីសម្រេច របស់ រដ្ឋបាល ខេត្ត កំពត ផងដែរ ដែល បាន ដាក់ចេញ ជា បន្ដ បន្ទាប់ ធ្វើ យ៉ាង សម្ដៅ ទប់ស្កាត់ នូវ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ។
លោក ឧត្តមសេនីយ៍ ទោស្នងការ ក៏ បាន ណែនាំឲ្យ ប្រជាពលរដ្ឋ ពិសេស អ្នកប្រកបរបរ រត់ ម៉ូតូ កង់បី ម៉ូតូ ឌុប ដែល ត្រូវ ជួប ភ្ញៀវ ច្រើន មកពី តំបន់ ផ្សេង ៗ គ្នា ត្រូវតែ ផ្ដោត ការយកចិត្តទុកដាក់ ក្នុង ការការពារ ខ្លួន តាមរយៈ ការពាក់ ម៉ាស់ ឧស្សាហ៍ លាង ដៃ ជាមួយ សាប៊ូ ឬ ជែល ឬ អាល់កុល ជាដើម ដើម្បី ការពារ ខ្លួន ពី ជំងឺ ឆ្លង ដ៏ កាច សាហាវ មួយ នេះ ៕
ក្រសួង ការពារ ជាតិ បង្ហាញ ផែនការលម្អិត នៃ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដល់ ប្រជាពលរដ្ឋ នៅ រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ ក្រសួង ការពារ ជាតិ កម្ពុជា បាន បង្ហាញ គម្រោង ផែនការលម្អិត នៃ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន ដល់ ប្រជាពលរដ្ឋ នៅ រាជធានី ភ្នំពេញ ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ឱ្យ បាន ទាន់ ពេល វេលា ។
សូម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ចាប់ផ្តើម បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ ក្រហម ក្នុង រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ។ យុទ្ធនាការ នេះ ត្រូវបាន បើក នៅ ថ្ងៃទី៣០ ខែមេសា នេះ ហើយ នឹង ចាប់ផ្តើម ចាក់ ជូន ពលរដ្ឋ ចាប់ពី ថ្ងៃទី ០១ ខែឧសភា ត ទៅ ៕
ខាងក្រោម នេះ ជា ផែនការចាក់ វ៉ាក់សាំង ដែល បង្ហាញ ដោយ ក្រសួងា ការពារ ជា តិ៖បទ អត្ថាធិប្បាយ៖ លោក ចូ បៃ ដិន ប្រធានាធិបតី អាមេរិក បន្ត អនុវត្ត គោល នយោបាយ ចំពោះ ប្រទេស ចិន របស់ រដ្ឋាភិបាល អាណត្តិ មុន ក្នុង អំឡុង ពេល លោក ឡើង កាន់ មុខតំណែង ១០០ ថ្ងៃ
( ប៉េកាំង ) ៖ ថ្ងៃទី ២៨ ខែមេសា លោក ចូ បៃ ដិន ប្រធានាធិបតី អាមេរិក បាន ថ្លែង សុន្ទរកថា ក្នុង សភា អាមេរិក ដោយ បាន បង្ហាញ អាកប្បកិរិយា ដ៏ រឹង ចចេស ជាច្រើន ចំពោះ ប្រទេស ចិន ក្នុង នោះ បូករួម ទាំង ការ មួល បង្កាច់ ប្រទេស ចិន អនុវត្ត អ្វី ដែល ហៅ ថា « គោល នយោបាយ ពាណិជ្ជកម្ម អយុត្តិធម៌ » ហើយ បាន អះអាង ថា « សហរដ្ឋ អាមេរិក នឹង បង្កើន វត្តមាន យោធា ដ៏ ខ្លាំងក្លា ក្នុង តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក » ព្រមទាំង « ប្រកាន់ខ្ជាប់ កាតព្វកិច្ច ដើម្បី គាំពារ សិទ្ធិ មនុស្ស និង សេរីភាព » ជាដើម ។
លោកស្រី ឱ វណ្ណឌីន បាន បញ្ជាក់ ឲ្យដឹង តាម សេចក្តីជូនដំណឹង ថា យោង តាម ពេលវេលា កំណត់ អ្នក ដែល បាន ចាក់ វ៉ាក់សាំង AstraZeneca ដូស ទី១ ទាំងអស់ នឹង ត្រូវ ដល់ ពេល ចាក់ ដូស ទី២ ជា បន្តបន្ទាប់ នៅ ដើម ខែឧសភា ឆ្នាំ ២០២១ ។ ដូចនេះ គណៈកម្មការ ចំពេញ កិច្ច ចាក់ វ៉ាក់សាំង នឹង បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវី សែល ដូស ទី២ ចាប់ពី ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃទី ១៨ ខែមិថុនា ឆ្នាំ ២០២១ ។
ការចាក់ វ៉ាក់សាំង កូវី សែល ដូស ទី២ ក្នុង រាជធានី ភ្នំពេញ៖
- ទីតាំង ចាក់ វ៉ាក់សាំង កូវ សៃល ដូស ទី២ ជូន ថ្នាក់ដឹកនាំ ជាន់ ខ្ព ស់៖
ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា ព្រឹទ្ធសភា រដ្ឋសភា ព្រមទាំង ក្រុមគ្រួសារ ដែល បាន ចាក់ វ៉ាក់សាំង AstraZeneca ដូស ទី១ រួចហើយ សូម ទំនាក់ទំនង ទៅ អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា និង អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា ដើម្បី ទទួលបាន ព័ត៌មាន នៃ ចាក់ វ៉ាក់សាំង AstraZeneca ដូស ទី២ ដោយ គណៈកម្មការ ចំពេញ កិច្ច ចាក់ វ៉ាក់សាំង បាន រៀបចំ ចាត់ចែង ជាមួយ អគ្គ លេខាធិការដ្ឋាន ទាំង ពីរ នេះ រួចហើយ ។
ប្រជាពលរដ្ឋ ដែល បាន ចាក់ វ៉ាក់សាំង AstraZeneca ដូស ទី១ រួច នៅ ខេត្ត កណ្តាល និង ខេត្ត ព្រះសីហនុ សូមអញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង កូវី សែល ដូស ទី២ តាម ការណែនាំ និង ចាត់ចែង របស់ អនុគណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ក្នុង ក្របខណ្ឌ ខេត្ត កណ្តាល និង ខេត្ត ព្រះសីហនុ រួម ជាមួយ មន្ទីរ សុខាភិបាល ខេត្ត កណ្តាល និង ខេត្ត ព្រះសីហនុ ដោយ រដ្ឋបាល ខេត្ត ត្រូវ រៀបចំ ចាត់ចែង តាម ពេលវេលា កំណត់ ក្នុង « ឧបសម្ព័ន្ធ ២» ។
អាជ្ញាធរ មូលដ្ឋាន ត្រូវ សហការ រៀបចំ ចាត់ចែង សណ្តាប់ធ្នាប់ នៅ គ្រប់ ទីតាំង ចាក់ វ៉ាក់សាំង ទាំងអស់ ដើម្បី ធានា ឱ្យ បាន នូវ វិធានការ សុខាភិបាល ចាំបាច់ នានា ដូចជា ការរក្សា គម្លាត សុវត្ថិភាព បុគ្គល ចាប់ពី ១.៥ម៉ែត្រ ឡើង មាន ពាក់ ម៉ាស់ ការលាង សម្អាត ដៃ ជាមួយ អាល់កុល ។
( បរទេស ) ៖ ក្រុម ជនជាតិ ភាគ តិច ការ៉ែន (Karen) រាប់ ពាន់ នាក់ កំពុង ត្រៀមខ្លួន ឆ្លង ដែន ចូល ទៅកាន់ ប្រទេស ថៃ ប្រសិនបើ មាន ការប្រយុទ្ធ គ្នា ដូច ដែល បាន រំពឹងទុក កើនឡើង កាន់តែ ខ្លាំង រវាង កងទ័ព មីយ៉ាន់ម៉ា និង ក្រុម ពួក ឧទ្ទាម ការ៉ែន ដែល បាន ប្រកាស គាំទ្រ ក្រុម ប្រឆាំង របប យោធា ក្រោយ រដ្ឋប្រហារ ថ្ងៃទី ០១ ខែកុម្ភៈ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន AP នៅ ព្រឹក ថ្ងៃសុក្រ ទី៣០ ខែមេសា ឆ្នាំ ២០២១ ។
ក្រុម ឧទ្ទាម ការ៉ែន និង កងទ័ព មីយ៉ាន់ម៉ា បាន ប៉ះទង្គិច គ្នា នៅជិត ព្រំដែន ថៃ ក្នុង រយៈពេល ប៉ុន្មាន សប្តាហ៍ នេះ ចាប់តាំងពី មេដឹកនាំ របប យោធា លោក ឧត្តមសេនីយ៍ មីន អោង ហ្លេង បាន ធ្វើ រដ្ឋប្រហារ ទម្លាក់ លោកស្រី អោង សាន ស៊ូ ជី ចេញ ពី តំណែង ដែល បាន និង កំពុង បង្កឱ្យ អ្នកភូមិ រស់ នៅ តាម ព្រំដែន ទាំង ខាង មីយ៉ាន់ម៉ា និង ថៃ ភៀសខ្លួន ចេញ ពី ទីលំនៅ ។
គួរ បញ្ជាក់ ថា បើ តាម បណ្តាញ គាំទ្រ សន្តិភាព ជនជាតិ ភាគ តិច ការ៉ែន អ្នកភូមិ រាប់ ពាន់ នាក់ កំពុង ជ្រកកោន នៅ ផ្នែក ម្ខាង នៃ ទន្លេ Salween ដែល ស្ថិត ក្នុង ទឹកដី មីយ៉ាន់ម៉ា ហើយ ពួកគេ នឹង ភៀសខ្លួន ចូល ទៅកាន់ ប្រទេស ថៃ ប្រសិនបើ មាន ការប្រយុទ្ធ គ្នា កើនឡើង កាន់តែ ខ្លាំង ៕
ខេត្ត តាកែវ រកឃើញ អ្នក កើត កូវីដ ១៤នាក់ ទៀត ជា កម្មករ កាត់ដេរ និង គ្រួសារ
បច្ចុប្បន្ន អាជ្ញាធរ និង ក្រុម គ្រូពេទ្យ កំពុង ចុះ ស្រាវជ្រាវ រក អ្នក ពាក់ព័ន្ធ ជាមួយ បុគ្គល ទាំង ០៩ នាក់ ខាងលើ បន្ថែម ទៀត ។
បច្ចុប្បន្ន បុគ្គល ទាំង ០៥ នាក់ ខាងលើ ក្នុង នោះ ឈ្មោះ កង សុខ ហួ និង ឈ្មោះ កង ស្រី មុំ ត្រូវបាន គ្រូពេទ្យ បញ្ជូន ទៅ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក បាទី និង ឈ្មោះ សំ ស្រី ម បាន បញ្ជូន មក សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ឈ្មោះ ង៉ែត ណាង បាន បញ្ជូន ទៅ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក កោះ អណ្តែត រីឯ ឈ្មោះ វ៉ាន់ ប្រុស បាន បញ្ជូន ទៅ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក គិរី វង់ ។
បច្ចុប្បន្ន អាជ្ញាធរ និង ក្រុម គ្រូពេទ្យ កំពុង ចុះ ស្រាវជ្រាវ រក អ្នក ពាក់ព័ន្ធ ជាមួយ បុគ្គល ទាំង ០៥ នាក់ ខាងលើ បន្ថែម ទៀត ៕
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា សុពលភាព នៃ ការកំណត់ ភូមិ ខាងលើ ជា « តំបន់ លឿង ទុំ » និង « តំបន់ ក្រហម » ត្រូវបាន អនុវត្ត រយៈពេល ៦ ថ្ងៃ គិត ចាប់ពី ម៉ោង សូន្យ នា ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ ៕
ខាងក្រោម នេះ ជា ផែនទី ដែល បង្ហាញ ដោយ រដ្ឋបាល រាជធានី ភ្នំពេញ៖ អភិបាល ខេត្ត កំពង់ចាម បន្ដ បិទ ខ្ទប់ ភូមិ និង ឃុំ មួយចំនួន បន្ថែម ទៀត នៅ ស្រុក កង មាស ដើម្បី ទប់ស្កាត់ ឆ្លង រីករាលដាល ជំងឺ កូវីដ
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា និង ជា ប្រធាន គណៈកម្មការ ខេត្ត ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ នៅ រសៀល ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២១ បាន ដឹកនាំ ក្រុមការងារ ខេត្ត អាជ្ញាធរ មូលដ្ឋាន និង មន្ត្រី ពាក់ព័ន្ធ អញ្ជើញ ចុះ ពិនិត្យមើល ទីតាំង ផ្ទុះឡើង នៃ ជំងឺ កូវីដ - ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ស្ថិត នៅក្នុង ស្រុក កង មាស និង ត្រួតពិនិត្យមើល ទីតាំង សម្រាប់ ធ្វើជា មណ្ឌល ចត្តាឡី ស័ក ក្នុង ក្របខណ្ឌ ស្រុក កង មាស ជាច្រើន កន្លែង ។
ក្នុង ឱកាស នោះ ឯកឧត្តម អភិបាល ខេត្ត បាន ណែនាំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ស្រុក និង សមត្ថកិច្ច ពាក់ព័ន្ធ ដូច ខាងក្រោម៖
* ទី១៖ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ស្រុក អាជ្ញាធរ មូល ឃុំ និង អ្នក ពាក់ព័ន្ធ ត្រូវ បន្ត គ្រប់គ្រង អ្នក ប៉ះពាល់ នឹង ករណី នេះ ដោយ អ្នក ដែល បាន ប៉ះពាល់ ដោយ ផ្ទាល់ ត្រូវ ដាក់ ឲ្យ ធ្វើចត្តាឡី ស័ក នៅ មណ្ឌល ចត្តាឡី ស័ក ស្រុក និង អ្នក ប៉ះពាល់ ដោយ ប្រយោល ត្រូវ ដាក់ ឲ្យ ធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ រៀង ៗ ខ្លួន ។
* ទី ២៖ បន្ត ពង្រឹង និង គ្រប់គ្រង ភូមិសាស្ត្រ ដែល រដ្ឋបាល ខេត្ត សម្រេច បិទ ខ្ទប់ សំដៅ ធ្វើ យ៉ាងណា ទប់ស្កាត់ ការចេញ - ចូល សម្រាប់ ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ ដោយ មិន អនុញ្ញាតឲ្យ មាន ការចេញ - ចូល ឬ បើក របរ អាជីរកម្ម គ្រប់ ប្រភេទ នៅក្នុង ភូមិ ដែល ត្រូវ បិទ ខ្ទប់ ។
* ទី៣៖ រៀបចំ ខ្សែ សុវត្ថិភាព ព័ទ្ធ ភូមិ ដែល បិទ ខ្ទប់ រួម នឹង ដាក់ បំរាម ចេញ - ចូល សម្រាប់ ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ ដោយ មិន អនុញ្ញាតឲ្យ មាន ការចេញ - ចូល និង បន្ត ផ្សព្វផ្សាយ សារ អប់រំ ឲ្យបាន ជាប់ ជាប្រចាំ ដល់ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ពិសេស នៅ ភូមិសាស្ត្រ ត បិទ ខ្ទប់ ភូមិ ដើម្បី ជា ការក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ ក្នុង ការចូលរួម អនុវត្ត វិធានការ ការពារ និង ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ។
* ទី ៤៖ រដ្ឋបាល ស្រុក ត្រូវ បន្ត រៀបចំ និង ពង្រីក បន្ថែម មណ្ឌល ចត្តាឡី ស័ក របស់ រដ្ឋបាល ស្រុក បន្ថែម ពី អ្វី ដែល បាន រៀបចំ កន្លងមក ដើម្បី ត្រៀមលក្ខណៈ ក្នុង ករណី ផ្ទុះ រីករាល នៃ ជំងឺ កូវីដ - ១៩ ក្នុង មូលដ្ឋាន ។
ជាមួយគ្នា នោះ រដ្ឋបាល ខេត្ត បាន ដាក់ចេញ វិធានការបន្ទាន់ សម្រេច បិទ ខ្ទប់ រយៈពេល ១៤ ថ្ងៃ នៅ ទីតាំង ភូមិ ឃុំ មួយចំនួន ដែល ពាក់ព័ន្ធ ករណី វិជ្ជមាន ជំងឺ កូវីដ១៩ ខាងលើ ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ទៅ សហគមន៍ ផ្សេង ទៀត ៕ ប្រទេស ថៃ កំពុង ខ្វះខាត គ្រែ ពេទ្យ ដោយសារ ចំនួន អ្នកជំងឺ កូវីដ - ១៩ កើនឡើង យ៉ាង គំហុក
ទិន្នន័យ ពី ក្រសួង សុខាភិបាល ថៃ បាន បង្ហាញ ពី ការកើនឡើង បន្តិច ម្តង ៗ ចំពោះ អ្នកជំងឺ ដែល ត្រូវការ ប្រើប្រាស់ បំពង់ ជំនួយ ផ្លូវ ដង្ហើម និង អ្នកជំងឺ រលាក សួត ឬ រលាក ជាលិកា សួត ដែល អាច បណ្តាលឱ្យ មាន ជំងឺ ផ្លូវ ដង្ហើម ធ្ងន់ធ្ងរ រហូតដល់ បាត់បង់ជីវិត ។ ចំនួន អ្នកជំងឺ បែប នេះ បាន កើន លើស ពី ១.០០០ នាក់ ហើយ គិត ត្រឹម ថ្ងៃព្រហស្បតិ៍ ម្សិលមិញ នេះ ។
គួរ បញ្ជាក់ ថា បើ តាម នាយកដ្ឋាន សេវាកម្ម វេជ្ជសាស្ត្រ មាន គ្រែ ពេទ្យ ចំនួន ៤៤. ៥៦០ គ្រែ នៅ ទូទាំង ប្រទេស ថៃ ។ គិត ត្រឹម ថ្ងៃទី ២៧ ខែមេសា គ្រែ ពេទ្យ ចំនួន ២២.៨៦៥ គឺ នៅ ទំនេរ ។ ប៉ុន្តែ ជាង ពាក់កណ្តាល នៃ ចំនួន ទាំងនេះ ស្ថិត នៅក្នុង មន្ទីរពេទ្យ តាម សាល - កីឡដ្ឋាន និង មន្ទីរពេទ្យ តាម សណ្ឋាគារ ខណៈ មួយចំនួន ធំ ស្ថិត នៅក្នុង មន្ទីរពេទ្យ ធម្មតា ប៉ុន្តែ ត្រូវបាន ដាក់ អ្នកជំងឺ ពេញ ហើយ ៕
( បន្ទាយមានជ័យ ) ៖ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីជូនដំណឹង បង្ហាញ អត្តសញ្ញាណ អ្នក ឆ្លង កូវីដ១៩ សរុប ទាំង ចំនួន ២៤៤ នាក់ ដែល បាន រកឃើញ ចាប់ពី ថ្ងៃទី ២៥ ដល់ ២៨ ខែមេសា ឆ្នាំ ២០២១ ។
រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ បន្ត ថា បន្ថែម លើ នោះ អ្នក ពាក់ព័ន្ធ ដទៃ ទៀត ត្រូវ តាមដាន សុខភាព ផ្ទាល់ខ្លួន ជាប្រចាំ ត្រូវ ពិនិត្យ កម្តៅ យ៉ាងតិច ២ដង ក្នុង មួយ ថ្ងៃ ត្រូវ សម្រាក នៅ ផ្ទះ បន្ទប់ ដាច់ តែ ឯង និង ត្រូវ ថែរក្សា អនាម័យ ខ្លួន ជានិច្ច ជាមួយគ្នា នោះ បងប្អូន ប្រជាពលរដ្ឋ និង សាធារណៈ ជន ទាំងអស់ ត្រូវ អនុវត្ត នូវ កាតព្វកិច្ច ពាក់ ម៉ាស់ និង កាតព្វកិច្ច រក្សា គម្លាត សុវត្ថិភាព ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត ។
ក្នុង ករណី មាន ការប្រែប្រួល សុខភាព ខុស ប្រក្រតី ដូចជា ឡើង កម្ដៅ លើក ពី ៣៧ អង្សា សេ ក្អក កណ្តាស់ ហៀរ សំបោរ ឈឺ បំពង់ ក មាន កំហាក ថប់ ដង្ហើម ... ។ល ។ ត្រូវ ប្រញ៉ាប់ ទំនាក់ទំនង ទៅ ក្រុម ឆ្លើយតប បន្ទាន់ នៃ មន្ទីរ សុខាភិបាល នៃ រដ្ឋបាល ខេត្ត ឬ មន្ទីរពេទ្យ ខេត្ត ក្រុង ស្រុក ឬ មណ្ឌល សុខភាព ឃុំ សង្កាត់ តាមរយៈ ទូរស័ព្ទ លេខ ០១២ ៧២៤០៤២ / ០១២ ៩៤៨៧៧៩ ៕
កំណាព្យ « នាគរាជ មាន គុណ » ដើម្បី ផ្តល់ កម្លាំងចិត្ត សម្តេច តេជោ
( ភ្នំពេញ ) ៖ កំណាព្យ « នាគរាជ មាន គុណ » ជា កំណាព្យ ផ្ដល់ កម្លាំងចិត្ត ផ្ញើ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ផ្តល់ កម្លាំងចិត្ត ដល់ សម្ដេច ដែល និពន្ធ ដោយ លោក គឹម រស្មី ។
រដ្ឋបាល ខេត្ត សៀមរាប អនុញ្ញាតឱ្យ មន្ទីរពិសោធន៍ វេជ្ជសាស្រ្ត ប្រាសាទ កែវ និង ទីតាំង ១២ ទៀត ដំណើរការចេញ - ចូល ឡើងវិញ
ក្រោម ការតាមដាន យ៉ាង យកចិត្តទុកដាក់ របស់ ក្រុមការងារ ជំនាញ និង វិធាន ចត្តាឡី ស័ក បាន ធ្វើឲ្យ ករណី នេះ បាន វិល ទៅរក ភាព ប្រក្រតី និង ស្ថិត ក្រោម ការគ្រប់គ្រង ដូចនេះ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត សម្រេច បើក ការចេញ - ចូល ឬ ដំណើរការ ឡើងវិញ នូវ ទីតាំង ដែល បាន បញ្ជាក់ ខាងលើ ។
រដ្ឋបាល ខេត្ត ព្រះវិហារ ណែនាំឲ្យ ពង្រឹង ការអនុវត្ត វិធានការ ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩
( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី ២៩ ខែមេសា នេះ បាន ចេញ សេចក្តីណែនាំ ស្តីពី ការពង្រឹង ការអនុវត្ត វិធានការ ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ និង ការពង្រឹង ការអនុវត្ត វិធានការ ដែល ត្រូវបាន ហាមឃាត់ ក្នុង ភូមិសាស្ត្រ ខេត្ត ព្រះវិហារ ។ នេះ បើ តាម សេចក្តីណែនាំ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ៕
សូម អាន ខ្លឹមសារ ទាំងស្រុង របស់ រដ្ឋបាល ខេត្ត ព្រះវិហារ ដូច ខាងក្រោម នេះ៖ អាជ្ញាធរ ខេត្ត កំពង់ចាម សម្រេច បិទ ខ្ទប់ ឃុំ ប្រាំ យាម នៅ ស្រុក ស្រីសន្ធ រ ក្រោយ ផ្ទុះ ជំងឺ កូវីដ១៩
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន សម្រេច បិទ ខ្ទប់ ឃុំ ប្រាំ យាម នៅ ស្រុក ស្រីសន្ធ រ ក្រោយ មាន ប្រជាពលរដ្ឋ កើត ជំងឺ កូវីដ១៩ ជា បន្ដ បន្ទាប់ ។ នេះ បើ តាម សេចក្ដីសម្រេច ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ។ អភិបាល ខណ្ឌ ចំការមន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ចូលរួម អនុវត្ត វិធាន សុខាភិបាល ដើម្បី ចៀស ឆ្លង ជំងឺ កូវីដ១៩ និង ឱ្យ ប្រុងប្រយ័ត្ន ចំពោះ គ្រោះ អគ្គិភ័យ
( ភ្នំពេញ ) ៖ ទន្ទឹមនឹង ការអំពាវនាវ ឱ្យ ពលរដ្ឋ ទាំងអស់ ចូលរួម ក្នុង ការអនុវត្ត វិធាន សុខាភិបាល . គោរព វិធានការបិទ ខ្ទប់ មួយ រយៈពេល ខ្លី ដើម្បី ឈានដល់ ការបញ្ចប់ នូវ ព្រឹត្តិការណ៍ ២០កុម្ភៈ ក្នុង ប្រទេស របស់ យើង បាន ឆាប់ ហើយ នោះ លោក ថេង សុថុល អភិបាល ខណ្ឌ ចំការមន ក៏ បាន ប្រាប់ ដល់ បងប្អូន ឱ្យ ប្រុងប្រយ័ត្ន ចំពោះ គ្រោះ អគ្គិភ័យ ផងដែរ ។
លោក អភិបាល ខណ្ឌ ក៏ បាន ជំរុញ ឱ្យ បងប្អូន ទាំងអស់ ចូលរួម អនុវត្តន៍ វិធានការ ៣កុំ និង ៣ការពារ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង គោរព វិធានការបិទ ខ្ទប់ មួយ រយៈពេល ខ្លី ដើម្បី ឈានដល់ ការបញ្ចប់ ព្រឹត្តិការណ៍ ២០កុម្ភៈ និង ឆាប់ បាន ត្រឡប់ ទៅ រក ជីវភាព រស់ នៅ ជួបជុំ គ្រួសារ ជាធម្មតា ដូច មុន វិញ ។
ដោយ មើលឃើញ តំបន់ នេះ មាន ផ្ទះ ច្រើន ជាប់ ៗ គ្នា ហើយ ផ្លូវ មាន លក្ខណៈ តូច ចង្អៀត ហើយ ក្នុង ពេល នេះ ជា រដូវ ក្ដៅ ផង នោះ លោក ថេង សុថុល បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ មេត្តា ប្រុងប្រយ័ត្ន ចំពោះ គ្រោះ អគ្គិភ័យ ដែល អាច កើតឡើង បណ្ដាល មកពី ភ្លើង ចង្ក្រាន ធូប ទៀន ជាពិសេស បញ្ហា អគ្គីសនី ដោយ ធ្វើ យ៉ាងណា ពិនិត្យ ឱ្យ បាន ម៉ត់ចត់ កុំ មាន ការធ្វែស ប្រហេស ឱ្យ សោះ ។
បើ តាម លោក នាយក រដ្ឋបាល ខណ្ឌ បាន បញ្ជាក់ ថា អំណោយ ដែល ចែកជូន នៅ ពេល នេះ ក្នុង ០១ គ្រួសារ ទទួលបាន៖ អង្ករ ១បាវ ទំងន់ ២៥ គីឡូក្រាម - មី ១កេស និង ត្រី ខ ១យួរ ៕ អភិបាល ខេត្ត កំពង់ចាម បន្ដ បិទ ខ្ទប់ ភូមិ២ បន្ថែម ទៀត នៅ ឃុំ សំបូរ ស្រុក បាធាយ ក្រោយ រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ
អភិបាល ខេត្ត កំពង់ចាម បន្ដ បិទ ខ្ទប់ ភូមិ មួយ នៅ ឃុំ មានជ័យ ស្រុក ស្រីសន្ធ រ ក្រោយ រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ មនុស្ស ចំនួន ៦នាក់ បន្ថែម ទៀត ដែល កើត ជំងឺ កូវីដ១៩ រស់ នៅ ស្រុក កង មាស . ស្រុក ស្រីសន្ធ រ និង ស្រុក ចំការលើ ។
រដ្ឋបាល ខេត្ត សៀមរាប សម្រេច បិទ ផ្សារក ន្រ្តក បណ្ដោះអាសន្ន
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប នៅ ថ្ងៃទី៣០ ខែមេសា នេះ បាន សម្រេច បិទ ការចេញ ចូល ជា បណ្ដោះអាសន្ន នូវ ផ្សារក ន្រ្តក ដែល ស្ថិត នៅ សង្កាត់ ស្វាយ ដង្គំ ក្រុង សៀមរាប ។ ការបិទ នេះ ដោយសារ មាន អ្នកជំងឺ ម្នាក់ ក្នុង ចំណោម ១៥នាក់ ដែល រកឃើញ វិជ្ជមាន កាលពី យប់ ថ្ងៃទី ២៩ មាន ប្រវត្តិ ចេញ ចូល ផ្សារ នេះ ។
អ្នកជំងឺ ម្នាក់ ដែល មាន ប្រវត្តិ ចូល ក ន្រ្តក ឈ្មោះ រិទ្ធ គន្ធី ភេទ ប្រុស អាយុ ១៩ ឆ្នាំ រស់ នៅ ភូមិ វិហារ ចិន សង្កាត់ ស្វាយ ដង្គំ នៅ ចន្លោះ ថ្ងៃទី ២៥ ដល់ ថ្ងៃទី ២៧ ខែមេសា កន្លងទៅ ។ ហេតុ ដូច្នេះ ដើម្បី បង្ការ ករណី ឆ្លង ជា យថាហេតុ រដ្ឋបាល ខេត្ត សម្រេច បិទ ខ្ទប់ ផ្សារ នេះ ជា បណ្ដោះអាសន្ន រង់ចាំ ការស្រាវជ្រាវ បន្ត ទៀត ។
នេះ ជា ផ្សារ ទី៤ ដែល រដ្ឋបាល ខេត្ត សៀមរាប សម្រេច បិទ ខ្ទប់ បណ្ដោះអាសន្ន ដើម្បី បង្ការ ករណី ឆ្លង ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ ។ ផ្សារ ដែល ធ្លាប់ បិទ កន្លងមក មាន ផ្សារ ភូមិភាគ៤ ដែល បច្ចុប្បន្ន បើក ដំណើរការធម្មតា វិញ តែ នៅ មាន ផ្សារ២ ទៀត កំពុង បន្ត បិទ ខ្ទប់ រួម មាន ផ្សារ ក្រោម និង ផ្សារ វត្ត អធ្វារ ៕ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម ចុះ ពិនិត្យ ឃ្លាំង ស្តុក ស្បៀង បម្រុង របស់ រាជ រដ្ឋាភិបាល សម្រាប់ ផ្គត់ផ្គង់ ប្រជាពលរដ្ឋ
( ភ្នំពេញ ) ៖ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន អញ្ជើញ ចុះ ពិនិត្យ ឃ្លាំង របស់ ក្រុមហ៊ុន ហ្គ្រីន ត្រេដ ដែល ជា ទីតាំង ស្តុក ស្បៀង បម្រុង របស់ រាជ រដ្ឋាភិបាល សម្រាប់ ផ្គត់ផ្គង់ ជូន ប្រជាពលរដ្ឋ ជាពិសេស ក្នុង តំបន់ បិទ ខ្ទប់ ( តំបន់ ក្រហម ) ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្ដាល ដើម្បី ធានា ដល់ ការផ្គត់ផ្គង់ ស្បៀង និជួយ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
ក្នុង ឱកាស ចុះ ពិនិត្យ ឃ្លាំង នី ថ្ងៃទី ២៩ ខែមេសា លោក រដ្ឋមន្ត្រី បាន កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែ សហការ គ្នា ល្អ របស់ មន្រ្តី ក្រុមហ៊ុន ហ្គ្រីន ត្រេដ និង មន្រ្ដី អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ ( ក .ប. ប. ) ដែល បាន លះបង់ ទាំង កម្លាំង កាយ ចិត្ត បំពេញ តួនាទី និង ភារកិច្ច របស់ ខ្លួន បាន យ៉ាង ល្អ ក្នុង ការផ្គត់ផ្គង់ ស្បៀង ជូន ប្រជាពលរដ្ឋ ដោយ ធានា បាន ទាំង គុណភាព និង បរិមាណ នៃ ការផ្គត់ផ្គង់ ។
ជាមួយគ្នា នេះ លោក រដ្ឋមន្ត្រី បាន លើកទឹកចិត្ត ដល់ មន្រ្តី របស់ ក្រុមហ៊ុន ហ្គ្រីន ត្រេដ និង អគ្គ នាយកដ្ឋាន ក . ប. ប. ឱ្យ បន្ត ប្រឹងប្រែង បំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន និង បន្ត អនុវត្ត នូវ ជំនាញ បច្ចេកទេស ដែល ខ្លួន មាន ក្នុង ការថែរក្សា ស្តុក ស្បៀង និង ត្រួតពិនិត្យ គុណភាព ទំនិញ ដើម្បី ធានា បាន នូវ ស្ដង់ដា អនាម័យ គុណភាព និង សុខុមាលភាព ជូន ប្រជាពលរដ្ឋ ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ទៀត ថា គ្រប់ ផលិតផល ស្បៀង របស់ ក្រសួង ពាណិជ្ជកម្ម ដែល បាន ផ្គត់ផ្គង់ ជូន ប្រជាពលរដ្ឋ កន្លងមក សុទ្ធតែ ត្រូវបាន តាមដាន ត្រួតពិនិត្យ គុណភាព យ៉ាង យកចិត្តទុកដាក់ ដោយ អគ្គ នាយកដ្ឋាន ក . ប. ប . ដែល ជា ស្ថាប័ន ជំនាញ ព្រមទាំង ការតាមដាន សន្ទស្សន៍ ថ្លៃ ទំនិញ ជាប្រចាំ ផងដែរ ។
លោក ប៉ែន សុវិជាតិ បាន ឲ្យដឹង ទៀត ថា យោង តាម ទំហំ ភូមិសាស្រ្ត តំបន់ ក្រហម និង លឿង ទុំ ដែល ទើបនឹង បាន ប្រគល់ ភារៈកិច្ច ដោយ សេចក្តីសំរេច លេខ ៥៥ ក្រសួង ពាណិជ្ជកម្ម បាន ជំរុញ បង្កើន ទីតាំង លក់ ថែម ទៀត សំរាប់ តំបន់ ក្រហម និង បង្កើន ចំនួន រថយន្ត ចល័ត សម្រាប់ ប្រតិបត្តិការ ទាំង ក្នុង តំបន់ ក្រហម និង លឿង ទុំ ។
ទន្ទឹមនឹង នេះ ការចូលរួម របស់ វិស័យ ឯកជន ដោយ ផ្សារភ្ជាប់ ជាមួយ បេសកកម្ម របស់ ក្រសួង ត្រូវបាន បង្កើន ឡើង ថែម ទៀត ដោយ មាន ទាំង ការចូលរួម របស់ ផ្សារ ទំនើប ធំ ៗ និង ប្រតិបត្តិករ ឯកជន ដែល មាន លក្ខណៈ សម្បត្តិ គ្រប់គ្រាន់ ផ្សេង ទៀត ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក ប៉ែន សុវិជាតិ ។
លោក បន្ដ ថា ទោះជា យ៉ាងណា ក្តី នៅក្នុង បរិបទ នៃ ការវិវឌ្ឍន៍ ថ្មី ៗ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ ក្រសួង ត្រូវ អនុវត្ត បេសកកម្ម របស់ ខ្លួន ប្រកបដោយ ការប្រុងប្រយ័ត្ន និង អនុវត្ត ខ្ជាប់ខ្ជួន វិធាន សុខាភិបាល ក៏ ដូចជា ការអនុវត្ត ឲ្យ មាន ប្រសិទ្ធិភាព នូវ ខ្លឹមសារ នានា សេចក្តីសំរេច របស់ រាជ រដ្ឋាភិបាល ៕ អាជ្ញាធរ ពន្លឿន ការជួសជុល មន្ទីពេទ្យ មេគង្គ នៅ ខេត្ត កំពង់ចាម ក្រោយ រកឃើញ អ្នកវិជ្ជមាន កូវីដ - ១៩ កើនឡើង
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន គណៈកម្មការ ខេត្ត ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩ លោក អ៊ុន ចាន់ ដា នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ រួម ជាមួយ មន្ត្រី ពាក់ព័ន្ធ បាន ចុះ ពិនិត្យ និង ពន្លឿន ដំណើរការ ជួសជុល មន្ទីពេទ្យ មេគង្គ កំពង់ចាម ក្រោយ រកឃើញ អ្នកវិជ្ជមាន កូវីដ - ១៩ ចំនួន ៣៩ នាក់ ថ្មី បន្ថែម ទៀត ។
មន្ត្រី រដ្ឋបាល សាលា ខេត្ត កំពង់ចាម បាន ឲ្យដឹង ថា ដោយសារ រដ្ឋបាល ខេត្ត រកឃើញ អ្នកវិជ្ជមាន កូវីដ - ១៩ មាន ការកើនឡើង ហេតុ ដូច្នេះហើយ ទើប អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន គណៈកម្មការ ខេត្ត ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩ និង អ្នក ពាក់ព័ន្ធ បាន ចុះ ពិនិត្យ ដើម្បី ពន្លឿន ការជួសជុល មន្ទីពេទ្យ មេគង្គ កំពង់ចាម នេះ ឲ្យ បាន ឆាប់ រួចរាល់ ដើម្បី ត្រៀម ដាក់ ព្យាបាល អ្នកជំងឺ កូវីដ - ១៩ នៅក្នុង ខេត្ត កំពង់ចាម ផង និង មកពី ខេត្ត ត្បូងឃ្មុំ ផងដែរ ។
មន្ត្រី ដដែល បន្ត ថា មន្ទីពេទ្យ មេគង្គ កំពង់ចាម មកដល់ ពេលនេះ ជួសជុល បាន ៩៥ % ហើយ នឹង អាច បញ្ចប់ នៅ ត្រឹម ថ្ងៃទី ១០ ខែឧសភា ឆ្នាំ ២០២១ ខាងមុខ នេះ ។ មន្ត្រី រដ្ឋបាល សាលា ខេត្ត បាន បញ្ជាក់ ថា មន្ទីរពេទ្យ នេះ ជួសជុល សម្រាប់ ព្យាបាល អ្នកជំងឺ កូវីដ - ១៩ មាន ៧០ បន្ទប់ និង អាច ដាក់ ព្យាបាល អ្នកជំងឺ បាន រហូតដល់ទៅ ប្រមាណ ២០០ នាក់ ។
សូម រំលឹក ថា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន សម្រេច ឲ្យ រដ្ឋបាល ខេត្ត កំពង់ចាម យក សណ្ឋាគារ មេគង្គ ធ្វើជា មន្ទីរពេទ្យ សម្រាប់ ព្យាបាល អ្នក កើត ជំងឺ កូវីដ - ១៩ នៅ ខេត្ត កំពង់ចាម និង មកពី ខេត្ត ត្បូងឃ្មុំ ៕ រដ្ឋបាល រាជធានី ភ្នំពេញ អំពាវនាវ ពលរដ្ឋ មាន រោគសញ្ញា សង្ស័យ នៅ តំបន់ ក្រហម ត្រូវ ទៅ យក សំណាក ជា បន្ទាន់
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បន្ដ អំពាវនាវ ជាថ្មី ម្ដង ទៀត ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ ក្រហម ប្រសិនបើ ចេញ រោគសញ្ញា សង្ស័យ ពាក់ព័ន្ធ ជំងឺ កូវីដ១៩ ត្រូវ ទៅ យក សំណាក ជា បន្ទាន់ ។
ប៉ុន្មាន ថ្ងៃ ចុងក្រោយ នេះ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត ធីតា សហការ ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន សម្រុក យក សំណាក របស់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ ក្រហម ពិសេស អ្នក ដែល មាន រោគសញ្ញា សង្ស័យ ដូច ជា៖
ដូច្នេះ ក្នុង ករណី មាន ការសង្ស័យ សូម ប្រជាពលរដ្ឋ រួសរាន់ ទៅ យក សំណាក ជា បន្ទាន់ នៅ ទីតាំង ដែល រៀបចំ ដោយ រដ្ឋបាល រាជធានី ភ្នំពេញ ៕
គួរ បញ្ជាក់ ថា យន្ដហោះ យោធា ដំបូង គេ របស់ សហរដ្ឋ អាមេរិក បាន ដឹកជញ្ជូន ជំនួយ បន្ទាន់ ក្នុង នោះ រួម មាន ទាំង អុកស៊ីសែន . ម៉ាស N95 និង ឧបករណ៍ ធ្វើតេស្ដ រហ័ស ជាដើម ទៅដល់ ប្រទេស ឥណ្ឌា ហើយ នៅ ថ្ងៃសុក្រ នេះ ហើយ ជំនួយ ទាំងនេះ ដែល គិត ជា ទឹកប្រាក់ សរុប ច្រើន ជាង ១០០ លាន ដុល្លារ នឹង បន្ត មកដល់ ឥណ្ឌា ជា បន្តបន្ទាប់ ទៀត ៕
លោក ឈាង វុន ទទួលបាន គ្រឿង ឥស្សរិយយស ពី ប្រទេស ជប៉ុន ក្រោយ បាន រួមចំណែក ធ្វើឲ្យ ប្រសើរឡើង នៃ ទំនាក់ទំនង កម្ពុជា - ជប៉ុន
លោក MIKAMI Masahiro ក៏ បាន បង្ហាញ ក្តីសង្ឃឹម ថា នឹង បន្ត បេសកកម្ម ដ៏ ឧត្តុង្គឧត្តម រួមគ្នា ជាមួយ លោក ឈាង វុន បន្ត ទៀត ប្រកបដោយ ភាពជិតស្និទ្ធ ជា ទីបំផុត ដើម្បី ពង្រឹង និង ពង្រីក នូវ កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ រវាង ប្រទេស ទំាង ពីរ ទំាង ខាង ស្ថាប័ន នីតិប្បញ្ញត្តិ និង នីតិប្រតិបត្តិ ក៏ ដូចជា ចំណង មិត្តភាព ជា ប្រពៃណី រវាង ជប៉ុន និង កម្ពុជា បន្ថែម ទៀត ៕
ប្រទេស ប្រេស៊ីល ដែល មាន ប្រជាជន សរុប ២១៣ លាន នាក់ ពេលនេះ មិន ត្រឹមតែ កំពុង ព្យាយាម ទប់ស្កាត់ ការឆ្លង រាតត្បាត COVID-19 ក្នុង ករណី ធ្ងន់ធ្ងរ និង បញ្ជាទិញ វ៉ាក់សាំង បង្ការ ជំងឺ នេះ ឲ្យបាន ច្រើន បំផុត ប៉ុណ្ណោះ ទេ តែ រដ្ឋាភិបាល របស់ លោក ប្រធានាធិបតី ហ្សែរ បូល សូណារ៉ូ ក៏ កំពុង ប្រឈមមុខ នឹង ការស៊ើបអង្កេត ព្រឹទ្ធសភា ផងដែរ អំពី ការគ្រប់ វិបត្តិ COVID-19 ដែល គ្មាន ប្រសិទ្ធភាព ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ដល់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង តំបន់ ក្រហម ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ទីក្រុង តាខ្មៅ នៃ ខេត្ត កណ្ដាល ។
ពិធី នេះ រៀបចំឡើង នៅក្នុង ទីតាំង មូលដ្ឋាន កងទ័ព នៃ កងពល តូច លេខ ៧០ ស្ថិត ក្នុង ភូមិ ព្រៃ ព្រីង ខាងត្បូង សង្កាត់ ចោម ចៅ រាជធានី ភ្នំពេញ ។
ដើម្បីឱ្យ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ទ្រង់ទ្រាយ ធំ ដល់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង តំបន់ ក្រហម នា ពេល ខាងមុខ ទទួលបាន ជោគជ័យ តាម ការគ្រោងទុក នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ នៅ ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ស្នើសុំ ការសហការ ពី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ចំនួន ៣ចំណុច សំខាន ៗ រួម មាន៖
ទី១៖ សូម ក្រុមប្រឹក្សា សង្កាត់ អាជ្ញាធរ ខណ្ឌ នីមួយ ៗ ជ ផ្តល់ តួលេខ ជាក់លាក់ អំពី ចំនួន ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម ភូមិ តាម សង្កាត់ ក្នុង មូលដ្ឋាន របស់ ខ្លួន នីមួយ ៗ ដើម្បី ធ្វើ ផែនការចាក់ វ៉ាក់សាំង ។
ទី២៖ សូម ឱ្យ អាជ្ញាធរ ខណ្ឌ នីមួយ ៗ អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ មក ទទួល ការចាក់ វ៉ាក់សាំង តាម ទីតាំង ដែល បាន កំណត់ ។
ទី៣៖ សូម កិច្ចសហការ ជាមួយ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ព្រោះ នៅក្នុង តំបន់ ក្រហម មាន កម្មករ និយោជិត ចំនួន ៤៥ ម៉ឺន នាក់ ដើម្បីឱ្យ ក្រសួង សហការ ជាមួយ កងយោធពល ខេមរភូមិន្ទ រៀបចំ ទីតាំង តួលេខ និង កន្លែង ចាក់ ព្រមទាំង អំពាវនាវ ឱ្យ បងប្អូន កម្មករ ក្នុង ខណ្ឌ ទាំង៤ មក ទទួល វ៉ាក់សាំង តាម ទីតាំង បាន កំណត់ ។
សូម បញ្ជាក់ ថា យោង តាម បទបញ្ជា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ទ្រង់ទ្រាយ ធំ ជូន ប្រជាពលរដ្ឋ រស់ នៅ តំបន់ ក្រហម នឹង ចាប់ បើក យុទ្ធនាការ ពី ថ្ងៃទី១ ដល់ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២១ រៀបចំ ដោយ ក្រសួង ការពារ ជាតិ ៕
សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល បញ្ជាក់ ថា ចាប់តាំងពី បាន ក្លាយជា សមាជិក អាស៊ាន មក កម្ពុជា បាន ធ្វើការ យ៉ាង ជិតស្និទ្ធ ជាមួយ សមាជិក ដទៃ ទៀត ក្នុង ការកសាង សហគមន៍ អាស៊ាន មួយ ដែល ផ្តោត លើ ប្រជាជន និង យក ប្រជាជនជា ស្នូល ក្នុង ស្មារតី នៃ ភាពម្ចាស់ការ និង ការទទួលខុសត្រូវ រួម ។
សម្តេច បន្ត ថា បន្ទាប់ពី ការស្វះស្វែង តាម នយោបាយ ការទូត យ៉ាង ស្វិតស្វាញ និង ទន់ភ្លន់ កម្ពុជា ត្រូវបាន អាស៊ាន សម្រេច ឱ្យ ចូល ជា សមាជិក ទី១០ ក្នុង កិច្ចប្រជុំ កំពូល របស់ ខ្លួន នៅ ទីក្រុង ហាណូយ ប្រទេស វៀតណាម នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ១៩៩៩ ។
សម្តេច នាយក រដ្ឋមន្ត្រី បន្ថែម ថា « អាស៊ាន បាន ក្លាយជា ស្នូល មួយ នៃ នយោបាយ ការបរទេស របស់ កម្ពុជា ដែល អាច ឆ្លុះបញ្ចាំង បាន តាមរយៈ ការផ្សារ ភ្ជាប់ ការអភិវឌ្ឍ ផ្នែក នយោបាយ សង្គម សេដ្ឋកិច្ច របស់ កម្ពុជា ទៅនឹង សមាហរណកម្ម តំបន់ និង កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ។ ការក្លាយទៅជា សមាជិក អាស៊ាន នេះ គឺជា ជោគជ័យ នៃ ការទូត មួយ របស់ ប្រទេស កម្ពុជា ក្នុង កាពង្រីក អនុភាព និង បង្កើន តួនាទី របស់ ខ្លួន កាន់តែ សកម្ម នៅក្នុង តំបន់ ផងដែរ » ។
សូម បញ្ជាក់ ថា សមាគម ប្រជាជាតិ អាស៊ី អាគ្នេយ៍ ហៅ កាត់ ថា អាស៊ាន គឺជា អង្គការ ថ្នាក់ តំបន់ មួយ រួម មាន ប្រទេស នៅ អាស៊ី អាគ្នេយ៍ ទាំង ដប់ ជា សមាជិក រួម មាន ថៃ ម៉ាឡេស៊ី សិង្ហបុរី ហ្វីលីពីន ឥណ្ឌូនេស៊ី ព្រុយណេ វៀតណាម មីយ៉ាន់ម៉ា ឡាវ និង កម្ពុជា ។ កម្ពុជា បាន ចូល ជា សមាជិក នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ១៩៩៩ ក្នុង ពេល កិច្ចប្រជុំ នៅក្នុង ប្រទេស វៀតណាម ។
ឈ្វេងយល់ ពី ប្រវត្តិ នៃ ព្រះរាជ ពិធី ច្រត់ ព្រះនង្គ័ល
( ភ្នំពេញ ) ៖ រយៈពេល ២ឆ្នាំ មកហើយ ចាប់ពី ឆ្នាំ ២០២០ ដល់ ឆ្នាំ ២០២១ នេះ ដោយសារតែ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ បាន ធ្វើឲ្យ ព្រះរាជាណាចក្រ កម្ពុជា សម្រេច ផ្អាក ការប្រារព្ធ ព្រះរាជ ពិធី ច្រត់ ព្រះនង្គ័ល ។ នៅ ឆ្នាំ នេះ ព្រះរាជ ពិធី ច្រត់ ព្រះនង្គ័ល ត្រូវ ប្រារព្ធ ឡើង នៅ ថ្ងៃទី៣០ ខែមេសា នេះ ។
ព្រះរាជ ពិធី ច្រត់ ព្រះនង្គ័ល តែងតែ ប្រារព្ធ ធ្វើឡើង ជារៀងរាល់ ឆ្នាំ នៅក្នុង ខែពិសាខ នៅឯ វាល ព្រះមេរុ ស្ថិត នៅ ខាងជើង ព្រះបរម រាជ វាំង នៃ រាជធានី ភ្នំពេញ សព្វ ថ្ងៃ តែ ឆ្នាំ ខ្លះ ព្រះរាជ ពិធី នេះ ក៏ ធ្វើ នៅ តាម បណ្តា ខេត្ត ដែរ ជា ព្រះរាជ ពិធី មួយ មាន ប្រវត្តិ ដ៏ យូរ លង់ ណាស់ មកហើយ ។
