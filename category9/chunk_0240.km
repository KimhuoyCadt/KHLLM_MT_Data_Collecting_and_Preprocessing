( ប៉េកាំង ) ៖ ក្តីសង្ឃឹម នៃ ប្រទេសជាតិ ផ្អែក លើ យុវជន អនាគត នៃ ប្រជាជាតិ ផ្អែក លើ យុវជន ។ លោក ស៊ី ជីន ភីង អគ្គ លេខាធិការ នៃ មជ្ឈិម បក្ស កុម្មុយនិស្ត ចិ ន ធ្លាប់ លើកទឹកចិត្ត ជាច្រើន លើក ឱ្យ យុវជន ធ្វើ ការច្នៃប្រឌិត ថ្មី ។ នៅ ថ្ងៃទី ០៤ ខែឧសភា ខាងមុខ ជា ទិវា យុវជន ប្រទេស ចិន ។ ទិវា មួយ នេះ បង្កើតឡើង ជាពិសេស ដើម្បី យុវជន ហើយ រដ្ឋាភិបាល ចិន ក៏ មាន ការផ្តល់ រង្វាន់ ដ៏ ពិសេស មួយ ដល់ យុវជន ដែល ខិតខំ តស៊ូ យ៉ាង ក្លាហាន ដើម្បី បុព្វហេតុ មាតុ ប្រទេស និង ជន រួម ជាតិ ផងដែរ ។
* រឿងរ៉ាវ របស់ យុវជន ចិន ដែល តស៊ូ នៅ ជួរ មុខ នៃ ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ឆ្លង នា ដើម ឆ្នាំ ២០២០ ដែល ជា គ្រា ពិបាក បំផុត នៃ ការប្រយុទ្ធ ប្រឆាំង នឹង ការរាលដាល នៃ ជំងឺ កូវីដ19 យុវជន ចិន ជា កម្លាំង សំខាន់ បំផុត ដែល ទទួលបន្ទុក ប្រយុទ្ធ នឹង ជំងឺ ឆ្លង ។
« ត្រៀមខ្លួន ជានិច្ច អាច ទៅ ជួរ មុខ ភ្លាម ៗ » « មុខជំនាញ ខ្ញុំ អាច ប្រើ បាន ខ្ញុំ ស្ម័គ្រចិត្ត ទៅ ជួយ ការងារ នៅ ជួរ មុខ » .. . ពេល ដឹង ថា ទីក្រុង វូហាន ត្រូវការ បុគ្គលិក វេជ្ជសាស្ត្រ ជាបន្ទាន់ ដើម្បី ទប់ទល់ សភាពការណ៍ រាតត្បាត យ៉ាង ខ្លាំង នៃ ជំងឺ កូវីដ19 ដ៏ កាច សាហាវ គ្រប់ សាខា មន្ទីរពេទ្យ នៃ សកលវិទ្យាល័យ ប៉េកាំង បាន ឆ្លើយតប យ៉ាង សកម្ម ដោយ បាន ចាត់ បញ្ជូន បុគ្គលិក វេជ្ជសាស្ត្រ ចំនួន ៤២៨ នាក់ ទៅកាន់ ខេត្ត ហ៊ូប៉ី ក្នុង នោះ យុវជន មាន អាយុ ក្រោម ៣៥ ឆ្នាំ មាន ចំនួន ២៨២ នាក់ ។
ក្នុង នោះ អ្នក ខ្លះ ទើប បាន កូន អ្នក ខ្លះ បាន ពន្យារ ពេល រៀបអាពាហ៍ពិពាហ៍ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន ឆ្នាំ ២០២០ គ្រូពេទ្យ វ័យ ក្មេង ទាំងនេះ បាន ទៅ ជួយសង្គ្រោះ ជីវិត នៅ ជួរ មុខ នៃ ការបង្កា ជំងឺ ឆ្លង ដោយ អង់អាច ក្លាហាន ដើម្បី ធ្វើជា មហា កំពែង សម្រាប់ ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ឆ្លង ។
សមាជិក ក្មេង បំផុត ក្នុង ក្រុម វេជ្ជសាស្ត្រ នោះ កើត នៅ ឆ្នាំ ១៩៩៧ ។ គាត់ បាន តស៊ូ រហូត ក្នុង បន្ទប់ សង្គ្រោះ បន្ទាន់ ICU និង បាន ឆ្លង ថ្ងៃ ខួបកំណើត របស់ ខ្លួន នៅ ជួរ មុខ នៃ ការប្រយុទ្ធ នឹង ជំងឺ ឆ្លង ។ ការងារ វេជ្ជសាស្ត្រ មួយចំណែក គឺ ការព្យាបាល មួយ ចំណែក ទៀត គឺ ថែទាំ និង ជួយ លើកទឹកចិត្ត អ្នកជំងឺ ។ អ្នកជំងឺ ធ្ងន់ធ្ងរ ដែល ធ្វើចត្តាឡី ស័ក ញាតិ សន្តាន មិន ត្រូវបាន អនុញ្ញាតឱ្យ ទៅ ថែទាំ នោះ ទេ ការហូបចុក ការបត់ ជើង ធំ និង តូច ការថែទាំ សុខភាព ត្រូវ ពឹងផ្អែក លើ បុគ្គលិក វេជ្ជសាស្ត្រ ទាំងអស់ ។
ក្រៅពី ពិនិត្យ អាការៈ របស់ អ្នកជំងឺ ឈឺ ធ្ងន់ធ្ងរ បំផុត ក្រុម វេជ្ជសាស្ត្រ ក៏ បាន បន្ថែម ការងារ ថែទាំ បោះ សម្អាត និង ជញ្ជូន ម្ហូប អាហារ ។ នេះ ជា ការគោរព និង យកចិត្តទុកដាក់ ចេញ ពី ដួងចិត្ត របស់ ក្រុម វេជ្ជសាស្ត្រ ។ សមាជិក បក្ស កុម្មុយនិស្ត ចិន វ័យ ក្មេង ក្នុង ក្រុម វេជ្ជសាស្ត្រ នោះ បាន និយាយ ថា៖ “ ដំណើរ ដ៏ ពិសេស នេះ ជា ទ្រព្យសម្បត្តិ ដ៏ មាន តម្លៃ នៃ ជីវិត ខ្ញុំ ក៏ នឹង លើកទឹកចិត្ត ខ្ញុំ កុំ ឱ្យ ខ្លាច ការលំបាក និង បញ្ហា ត្រូវ ទទួលខុសត្រូវ ដោយ ក្លាហាន !”
* រឿងរ៉ាវ របស់ យុវជន ចិន ដែល អនុវត្ត និង ជំរុញ ផ្ទាល់ នូវ ការ លុបបំបាត់ ភាពក្រីក្រ
អ្នកភូមិ មិន ជឿ នាង ទេ វ៉ាង មឹង មឹង ក៏ បាន ធ្វើ ការពន្យល់ និង ផ្សព្វផ្សាយ តាម ផ្ទះ នីមួយ ៗ . ដើម ស្ត្រ ប៊ឺរី ងាប់ ក៏ ដក ចេញ ដាំ ថ្មី បន្ថែម . មិន ចេះ បច្ចេកទេស ដាំ គ្មាន ថវិកា អញ្ជើញ អ្នកជំនាញ មក បង្ហាត់ បង្រៀន វ៉ាង មឹង មឹង បាន ទៅ រៀនសូត្រ ដោយ ផ្ទាល់ ។ល ។ ក្រោម ការនាំមុខ របស់ វ៉ាង មឹង មឹង អ្នកភូមិ កាន់តែ ច្រើន ឡើង បាន ផ្លាស់ប្តូរ គំនិត ហើយ ភូមិ ស៊ី ខុង បាន បង្កើត ចំការស្ត្រ ប៊ឺរី ចំការបន្លែ ផ្លែ ឈើ ចំការទំពាំងបាយជូរ ជាបន្ទាប់ ។
ក្រៅពី នេះ វ៉ាង មឹង មឹង មិន ដែល ភ្លេច ភារកិច្ច របស់ កម្មាភិបាល បក្ស អំពី ការជំរុញ ឱ្យ ប្រជាជន ចេញ ផុត ពី ភាពក្រីក្រ និង ទទួលបាន ជីវភាព ធូរធាប ង្គួរ នោះ ទេ នាង បាន បើក វគ្គ បណ្តុះបណ្តាល ដោយ ឥត គិត ថ្លៃ បាន ជួយ កសាង មណ្ឌល ព័ត៌មាន ឱកាស ការងារ ជាដើម ដើម្បី នាំគ្នា ប្រជាជន ចេញ ផុត ពី ភាពក្រីក្រ តាមរយៈ ការអភិវឌ្ឍ ឧស្សហកម្ម ។
បច្ចុប្បន្ន នេះ ភូមិ ស៊ី ខុង បាន ក្លាយជា ភូមិ គំរូ នៃ ការធ្វើ ឧស្សាហកម្ម ។ វ៉ាង មឹង មឹង កំពុង គិត ពិចារណា ពី ការបង្កើន ប្រាក់ ចំណូល របស់ អ្នកភូមិ ។ អ្នកភូមិ វ័យ ក្មេង កាន់តែ ច្រើន ចង់ ត្រឡប់ មក ធ្វើការ នៅ ស្រុក កំណើត ។ កញ្ញា បាន យល់ឃើញ ថា៖ ការអភិវឌ្ឍ ជនបទ ត្រូវការកម្លាំង យុវជន ត្រូវ ផ្តល់ ឱកាស ការងារ ដល់ ពួកគេ ដើម្បី រួមគ្នា សម្រេច សុបិន អភិវឌ្ឍន៍ ជនបទ ។
លោក ស៊ី ជីន ភីង បាន ផ្តល់ អនុសាសន៍ ដល់ យុវជន ចិន ថា៖ ទទួលបាន ជីវភាព ល្អ ត្រូវ ដឹង គុណ សង គុណ ហូប ទឹក នឹក ដល់ ប្រភព ដើម ។ គោលដៅ ជីវិត របស់ យុវជន ខុស ៗ គ្នា ជម្រើស មុខរបរ ក៏ ខុសគ្នា ក៏ប៉ុន្តែ បើ អាច គិតគូរ ពី តម្រូវការ នៃ មាតុ ប្រទេស រួម ជោគវាសនា ជាមួយ ប្រជាជន នោះ ក៏ អាច ទទួលបាន តម្លៃ ជីវិត យ៉ាង ប្រាកដប្រជា ។
ក្រសួង មុខងារ សាធារណៈ សហការ ជាមួយ ធនាគារ ពិភពលោក ធ្វើ សិក្ខាសាលា តាម ប្រព័ន្ធ អនឡាញ ស្តីពី ផែនការការបន្ត និរន្តរភាព ការងារ
សិក្ខាសាលា នេះ ដែល ស្ថិត ក្រោម អធិបតីភាព លោក ព្រុំ សុខា រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ បាន ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ ដោយ មាន ការចូលរួម ពីសំណាក់ លោកស្រី អស់ លោក ជា ថ្នាក់ដឹកនាំ ក្រសួង មុខងារ សាធារណៈ ប្រធាន មន្ទីរ មុខងារ សាធារណៈ រាជធានី ខេត្ត និង លោកស្រី អស់ លោក ជា វាគ្មិន ជាតិ និង អន្តរជាតិ ដែល ជា ក្រុមការងារ នៃ ធនាគារ ពិភពលោក ព្រមទាំង ដៃគូ អភិវឌ្ឍន៍ សរុប ចំនួន ១២៧ នាក់ ។
មាន មតិ ទៅកាន់ សិក្ខាសាលា លោក រដ្ឋមន្រ្តី ព្រុំ សុខា បាន ថ្លែង កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហការ រវាង ក្រុមការងារ ក្រសួង ដឹកនាំ ដោយ លោកស្រី ឈី វិជ្ជរ៉ា អនុ រដ្ឋលេខាធិការ ក្រសួង មុខងារ សាធារណៈ ជាមួយនឹង ក្រុមការងារ ធនាគារ ពិភពលោក ក្នុង ការត្រៀម រៀបចំ ឲ្យ សិក្ខាសាលា នេះ បាន ដំណើរការ ល្អ ប្រសើរ ទោះបីជា យើង កំពុង ប្រឈម នឹង ការលំបាក នានា ក្នុង កាលៈទេសៈ នៃ ការរាលដាល ជំងឺ កូវីដ១៩ ក៏ដោយ ។
ជាមួយគ្នា នេះ នៅ ចុងបញ្ចប់ លោក រដ្ឋមន្រ្តី បាន ផ្តាំផ្ញើ ដល់ អង្គ សិក្ខាសាលា នូវ ខ្លឹមសារ សំខាន់ ៣ ចំណុច រួម មាន៖
* ទី ១៖ សិក្ខាកាម ទាំងអស់ ត្រូវ ចូលរួម ផ្តល់ ធាតុ ចូល បន្ថែម ទៀត ដើម្បី ធ្វើឲ្យ ផែនការ បន្ត និរន្តរភាព ការងារ -BCP មាន លក្ខណៈ គ្រប់ ជ្រុងជ្រោយ ដែល អាច យក ទៅ អនុវត្ត បាន
* ទី២៖ ក្រុមការងារ BCP ត្រូវ ខិតខំ សិក្សា ស្រាវជ្រាវ ដើម្បី ពង្រឹង សមត្ថភាព របស់ ខ្លួន ឲ្យ ក្លាយទៅជា អ្នកជំនាញ ឬ ជា ជន បង្គោល ក្នុង ការធ្វើ ផែនការ បន្ត និរន្តរភាព ការងារ ដើម្បី ជួយ ក្រសួង ស្ថាប័ន ដទៃ ទៀត ក្នុង ការរៀបចំ BCP ផងដែរ
សាកលវិទ្យាល័យ សៅស៍ អ៉ីសថ៍ អេយ សៀ ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឧបាសក ខៀវ សាន ត្រូវ ជា ឪពុក របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ
ខាងក្រោម នេះ ជា សារ រំលែក មរណទុក្ខ របស់ សាកលវិទ្យាល័យ សៅស៍ អ៉ីសថ៍ អេយ សៀ គោរព ជូន ចំពោះ នាយក ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត ខៀវ សុភ័គ៖ ទេយ្យ ទាន ស្បៀងអាហារ ជា អំណោយ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវបាន ប្រគេន ព្រះសង្ឃ ក្នុង រាជធានី ភ្នំពេញ ១៥០ វត្ត រួចរាល់ ហើយ
( ភ្នំពេញ ) ៖ ទេយ្យ ទាន ស្បៀងអាហារ ដែល ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ត្រូវបាន យក ទៅ ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ត ក្នុង រាជធានី ភ្នំពេញ ទាំង ១៥០ វត្ត រួចរាល់ ហើយ ត្រឹម រសៀល ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។
ដោយ មើលឃើញ ពី ការខ្វះខាត របស់ ព្រះសង្ឃ គង់ នៅ តាម វត្ត នានា ក្នុង កំលុង ពេល ការអនុវត្ត វិធានការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ នោះ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន ចាត់ចែង ទេយ្យ ជា ស្បៀងអាហារ យក ទៅ ប្រគេន តាម វត្ត ក្នុង រាជធានី ភ្នំពេញ ប្រមាណ ១៥០ វត្ត ។
ក្នុង ពិធី ប្រគល់ ទេយ្យ ទាន នេះ តំណាង សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី និង សម្ដេច កិតិ្ត ព្រឹទ្ធបណ្ឌិត បាន នាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពី សម្ដេច តេជោ និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ចំពោះ ព្រះសង្ឃ គ្រប់ ព្រះអង្គ ដែល កំពុង ទទួលរង ផល ប៉ះពាល់ នូវ ការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ ដោយសារ ជំងឺ កូវីដ១៩ នា ពេលនេះ ។
តំណាង សម្តេច ទាំង ទ្វេ ក៏ បាន ទូល ប្រគេន ព្រះសង្ឃ គ្រប់ ព្រះអង្គ ថា ក្នុង ដំណាក់កាល ប្រទេស កម្ពុជា កំពុង ឆ្លង រីករាល ដាល នៃ ជំងឺ កូវីដ១៩ ចូលក្នុង សហគមន៍ គឺ តម្រូវឲ្យ រាជ រដ្ឋាភិបាល មាន ការបិទ ខ្ទប់ ទីក្រុង ភ្នំពេញ និង ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវី១៩ ។
ជាពិសេស កំលុង ពេល បិទ ខ្ទប់ នេះ ព្រះសង្ឃ មិន អាច និមន្ត បិណ្្ឌ បាត្រចង្ហាន់ បាន និង ប្រជាពុទ្ធ បរិស័ទ ក៏ មិន អាច យក ចង្ហាន់ មក ប្រគេន ព្រះសង្ឃ បាន ដែរ ទើប សម្ដេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត លោក បាន គិតគូរ អំពី ការលំបាក របស់ ព្រះសង្ឃ គ្រប់ ព្រះអង្គ តាម ទី អារាម នានា ទូទាំង រាជធានី ភ្នំពេញ ។
លើស ពី នេះ តំណាង ក៏ បាន ទូល ប្រគេន ព្រះសង្ឃ ដើម្បី នាំ នូវ សារ ចូលរួម ប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ - ១៩ ដោយ ត្រូវ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធាន សុខាភិបាល របស់ រាជ រដ្ឋាភិបាល ។ ជាពិសេស រួម អនុវត្ត វិធានការ « ៣ការពារ និង ៣កុំ » ដេីម្បី ការពារ ការចម្លង រីករាល ដើរលេង ជំងឺ កូវីដ១៩ នេះ ។
ដើម្បី យល់ដឹង កាន់តែ ច្បាស់ សូម ទស្សនា វីដេអូ ដែល ពន្យល់ ដោយ អង្គភាព ប្រតិកម្ម រហ័ស ដូចត ទៅ៖
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សៅ សុខា និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៤០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង លោកជំទាវ បុត្រា បុត្រី ព្រមទាំង ចៅ ឧបត្ថម្ភ ថវិកា ៤០ លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សៅ សុខា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សៅ សុខា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គណៈ ឱសថការីកម្ព ជា ឧបត្ថម្ភ ថវិកា ១៧លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ )៖ គណៈ ឱសថការីកម្ព ជា ឧបត្ថម្ភ ថវិកា ១៧លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
គណៈ ឱសថការីកម្ព ជា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឧបាសិកា ម៉ា ម៉ាលី ស ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
ឧបាសិកា ម៉ា ម៉ាលី ស កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ព្រះចៅ អធិការ វត្ត បក្សី ចាំ ក្រុង នៅ ខេត្ត ពោធិ៍សាត់ ត្រូវ ជន ដៃ ដល់ កាប់ មួយ កាំបិត ខ្វែវ ឱ្យ រងរបួស ធ្ងន់
( ពោធិ៍សាត់ )៖ ព្រះចៅ អធិការ វត្ត បក្សី ចាំ ក្រុង ត្រូវបាន ជន ដៃ ដល់ កាប់ មួយ កាំបិត ខ្វែវ ចំក្រោម មាត់ និង ដើម ដៃ ខាងស្តាំ បណ្ដាលឱ្យ របួស ធ្ងន់ ដោយសារ រឿង គំនុំ បញ្ជូន ទៅ សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក ភ្នំ ក្រវាញ ។
ហេតុការណ៍ ខាង លើ នេះ បាន កើតឡើង នា វេលា ម៉ោង ០៨៖៣០ នាទី យប់ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២១ នៅ ចំណុច វត្ត បក្សី ចាំ ក្រុង ស្ថិត ក្នុង ភូមិ អូរ បាក់ ត្រា ឃុំ ព្រងិល ស្រុក ភ្នំ ក្រវាញ ខេត្ត ពោធិ៍សាត់ ។
លុះ វេលា ម៉ោង ០៨៖៣០ នាទី ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ កម្លាំង មូលដ្ឋាន អាវុធហត្ថ ស្រុក សហការ ជាមួយ កម្លាំង នគរបាល ស្រុក បាន ចុះ ប្រតិបត្តិការ ស្រាវជ្រាវ និង ឈានដល់ ការឃាត់ខ្លួន ជនសង្ស័យ ឈ្មោះ ឆេង ឆាយ ទីលំនៅ ភូមិ ឃុំ ខាងលើ និង វត្ថុតាង កាំបិត ខ្វែវ ចំនួន ១ដើម ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង ត្រូវបាន ឃាត់ខ្លួន នៅ អធិការដ្ឋាន នគរបាល ស្រុក ភ្នំ ក្រវាញ ដើម្បី បំពេញ នីតិវិធី បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ពោធិ៍សាត់ ៕
លោក កិត្តិសង្គហ បណ្ឌិត ទេព ង ន ប្រគល់ អំណោយ ជូន រដ្ឋបាល ស្រុក អង្គស្នួល ខេត្ត កណ្តាល សម្រាប់ ចែកជូន ប្រជាពលរដ្ឋ ខ្វះខាត
( កណ្តាល ) ៖ លោក កិត្តិសង្គហ បណ្ឌិត ទេព ង ន អនុប្រធាន ទី២ព្រឹទ្ធសភា និង ជា ប្រធាន ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី៣ នៅ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ប្រគល់ ម៉ាស ចំនួន ១០.០០០ ម៉ាស អាកុល ចំនួន ៦០០លីត្រ មីជាតិ ចំនួន ២០០ កេស និង ទឹក សុទ្ធ ចំនួន ២០០ កេស ជូន រដ្ឋបាល ស្រុក អង្គស្នួល ខេត្ត កណ្តាល សម្រាប់ ទុក ចែកជូន ដល់ ប្រជាពលរដ្ឋ ជួប ការលំបាក និង ខ្វះខាត ក្នុង មូលដ្ឋាន ក្នុង ពេល ដែល រាជ រដ្ឋាភិបាល ដាក់ ចេញ វិធានការរឹតបន្តឹង ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
លោក កិតិ្ត សង្គហ បណ្ឌិត ទេព ង ន បាន បន្ថែម ថា សូម អាជ្ញាធរ ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ អំពី សុខ ទុក្ខ របស់ បងប្អូន ក្នុង មូលដ្ឋាន ពិសេស លើ កត្តា សុខភាព និង ជីវភាព មិន ត្រូវ ទុក ឱ្យ បងប្អូន ឈឺ ស្លាប់ ដោយ មិន បាន បញ្ជូន ទៅ ព្យាបាល ឬ អត់ឃ្លាន ស្លាប់ ដោយ អត់ ស្បៀងអាហារ ឡើយ ត្រូវ ធ្វើ ការរាយការណ៍ ដល់ ថ្នាក់ លើ ជាបន្ទាន់ ដើម្បី រួមគ្នា ដោះស្រាយ ក្នុង ដំណាក់កាល នេះ មាន តែ កិច្ចសហការ និង ការចូលរួម រវាង ប្រជាពលរដ្ឋ និង អាជ្ញាធរ មូលដ្ឋាន ទេ ទើប អាច ចូលរួម បិទ បញ្ចប់ ព្រឹត្តិការណ៍ « សហគមន៍ ២០ កុម្ភៈ » ។
វ៉ាក់សាំង AstraZeneca មិន ទាន់ ត្រូវបាន អនុញ្ញាត សម្រាប់ ការប្រើប្រាស់ នៅក្នុង សហរដ្ឋ អាមេរិក ឡើយ ប៉ុន្តែ រដ្ឋបាល លោក ចូ បៃ ដិន ត្រូវបាន គេ រាយការណ៍ កាលពី ដើម ខែមេសា នេះ ថា បាន ស្ដុក ទុក វ៉ាក់សាំង អង់គ្លេស មួយ នេះ ច្រើន ជាង ២០លាន ដូស នៃ វ៉ាក់សាំង សរុប ចន្លោះ ពី ៨០ ដល់ ៩០ លាន ដូស ដែល កំពុង ស្ថិត នៅក្នុង ដំណាក់កាល ផលិត តាម ការបញ្ជាទិញ របស់ អាមេរិក ។
មាន សំណួរ ជាច្រើន នៅតែ បន្ត ចោទ សួរ ថា តើ ហេតុ អ្វី បានជា សហរដ្ឋ អាមេរិក ស្ដុក ទុក វ៉ាក់សាំង មិន ប្រើប្រាស់ និង លើស ពី តម្រូវការ ? លោក បៃ ដិន ដែល ធ្លាប់ សន្យា ថា នឹង ស្ដារ ភាព ជា មេដឹកនាំ ប្រកបដោយ សីលធម៌ របស់ អាមេរិក ឡើងវិញ បាន បង្ហើប កាលពី សប្ដាហ៍ មុន ថា អាមេរិក អាចនឹង ចែករំលែក វ៉ាក់សាំង ជាមួយ ពិភពលោក តែ លោក នៅតែ ស្ទាក់ស្ទើរ ដ្បិត ត្រូវ បំពេញ តម្រូវការ នៅក្នុង ស្រុក ជាមុន សិន ដោយ ដើរ តាម គោល នយោបាយ តម្កល់ ផលប្រយោជន៍ អាមេរិក ជាមុន របស់ លោក ដូណាល់ ត្រាំ ។
* ចែករំលែក វ៉ាក់សាំង
លោក បៃ ដិន ធ្លាប់ បាន សង្កត់ធ្ងន់ នៅក្នុង កិច្ចប្រជុំ សន្តិសុខ ចតុភាគី ឬ ហៅ ក្វាដ (Quad) ថា វ៉ាក់សាំង នឹង ត្រូវ ចែករំលែក ទៅកាន់ តំបន់ អាស៊ី អាគ្នេយ៍ ឬ តំបន់ ឥណ្ឌូ - ប៉ាស៊ីហ្វិក និង នៅ ជុំវិញ ពិភពលោក ដើម្បី ប្រជែង ជាមួយ វ៉ាក់សាំង ការទូត របស់ ចិន ។
ការសម្រេចចិត្ត ចែករំលែក វ៉ាក់សាំង ជាមួយ បណ្ដា ប្រទេស ដទៃ របស់ រដ្ឋបាល លោក ប្រធានាធិបតី ចូ បៃ ដិន កើត មាន ឡើង នៅ ចំពេល សហរដ្ឋ អាមេរិក កំពុង ទទួលរង សម្ពាធ និង ការអំពាវនាវ ជាច្រើន ឱ្យ បញ្ចេញ វ៉ាក់សាំង ជួយ ដល់ បណ្ដា ប្រទេស ដទៃ ជាពិសេស គឺ ឥណ្ឌា ដែល កំពុង ប្រឈមមុខ នឹង ការឆ្លង និង ស្លាប់ ដោយសារ COVID-19 យ៉ាង គំហុក រហូតដល់ ធ្វើឱ្យ អ្នកជំនាញ ខ្លះ ព្រួយបារម្ភ ខ្លាចក្រែង ថា ប្រព័ន្ធ សុខាភិបាល ឥណ្ឌា អាចនឹង ដួលរលំ បើករណី ឆ្លង នៅតែ បន្ត កើនឡើង ។
កាលពី សប្តាហ៍ មុន ប្រទេស អូស្រ្តាលី ធ្លាប់ បាន ប្រកាស ថា ខ្លួន នឹង កាត់បន្ថយ ចំនួន ពលរដ្ឋ អូស្រ្តាលី ដែល អាច វិលត្រឡប់ ពី ប្រទេស ឥណ្ឌា និង បណ្តា ប្រទេស ដែល ស្ថិត ក្នុង តំបន់ ក្រហម ផ្សេង ទៀត ដើម្បី ទប់ស្កាត់ នឹង ហានិភ័យ នៃ ការឆ្លង រីករាលដាល ជំងឺ COVID-19 ខ្លាំង ឡើងវិញ នៅក្នុង ប្រទេស ។
ប្រទេស អូស្រ្តាលី បាន បិទ ព្រំដែន របស់ ខ្លួន ចំពោះ អ្នក ដែល មិន ទាន់ មាន សញ្ជាតិ និង អ្នក រស់ នៅ ជា អចិន្ត្រៃយ៍ កាលពី ខែមីនា ឆ្នាំ ២០២០ ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ COVID-19 មក ក្នុង ប្រទេស ។ អ្នកធ្វើដំណើរ ដែល វិលត្រឡប់ មកវិញ ទាំងអស់ ត្រូវ ឆ្លងកាត់ ការ ធ្វើចត្តាឡី ស័ក រយៈពេល ២សប្តាហ៍ ដោយ ចំណាយ ថវិកា ផ្ទាល់ខ្លួន ។
ពលរដ្ឋ មាន ជីវភាព ខ្វះខាត ៣៦៩ គ្រួសារ រស់ នៅ សង្កាត់ ទន្លេបាសាក់ និង ទួល ទំពូង ទី២ ទទួលបាន អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត តាមរយៈ រដ្ឋបាល ខណ្ឌ ចំការមន
ព្រះរាជអាជ្ញា រង ខេត្ត ព្រះវិហារ នាំ អំណោយ សប្បុរសជន ចែកជូន កុមារ កំព្រា រស់ នៅក្នុង មជ្ឈមណ្ឌលកុមារ កំព្រា ខេត្ត
( ព្រះវិហារ ) ៖ អំណោយ របស់ សប្បុរស ជន រួម មាន ថវិកា និង សម្ភារ ជាច្រើន មុខ ទៀត ត្រូវបាន លោក វុធ សាវី ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត ព្រះវិហារ និង ក្រុមការងារ នាំយក ទៅ ចែកជូន ដល់ ប្អូន ៗ កុមារ កំព្រា និង អ្នកមើលថែ ដែល កំពុង រស់ នៅក្នុង មជ្ឈមណ្ឌល កមារ កំព្រា ស្ថិត ក្នុង ក្រុង ព្រះវិហារ ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ នេះ ។
លោក វុធ សាវី បាន ថ្លែង ថា ដោយ មើលឃើញ ពី ភាពខ្វះខាត របស់ ប្អូន ៗ កុមារ កំព្រា និង អ្នកមើលថែ ដែល កំពុង រស់ នៅក្នុង មជ្ឈមណ្ឌលកុមារ កំព្រា នេះ រូប លោក មាន ចិត្ត អាណិតអាសូរ ជា ពន់ពេក ហើយក៏ មាន គំនិត ថា នឹង ស្វះស្វែង រក ជំនួយ មក ជួយ សម្រាល ការខ្វះខាត នៅក្នុង មជ្ឈមណ្ឌលកុមារ កំព្រា នេះ ឱ្យ បាន ។
លោក ព្រះរាជអាជ្ញា រង វុធ សាវី បាន បញ្ជាក់ ថា បន្ទាប់ពី លោក បាន បង្ហោះ ចូលក្នុង បណ្តាញ សង្គម បាន ប៉ុន្មាន ថ្ងៃ មាន មិត្តភ័ក្រ និង សប្បុរសជាច្រើន បាន ចូលរួម ជា សម្ភារៈ និង ថវិកា ជាមួយ លោក ទើប ថ្ងៃ នេះ រូប លោក មាន លទ្ធភាព នាំយក អំណោយ ទាំងនេះ មក ចែកជូន ដល់ ប្អូន ៗ ក មារ កំព្រា ។
ជាមួយគ្នា នេះ លោក ក៏ បាន ថ្លែងអំណរគុណ ដល់ ម្ចាស់ អំណោយ រួម មាន៖ លោក សេង ម៉េង ស្រ៊ុន ព្រះរាជអាជ្ញា រង ខេត្ត ព្រះវិហារ លោក ចក សម្បត្តិ ព្រះរាជអាជ្ញា រង ខេត្ត ព្រះវិហារ លោកស្រី មេធាវី សាយ ស្រី ចាន់ ប្រធាន ក្រុម មេធាវី (HNS) លោកស្រី ខូយ សម្បត្តិ និង ស្វាមុី លោកស្រី ឆេង មករា និង ស្វាមុី ម្ចាស់ ភោជនីយដ្ឋាន ភ្នំ ត្បែង លោក ចេង គឹម អូយ លោក លំ សេរី គុត និង សប្បរស ជន ជាច្រើន រូប ទៀត ។
សូម បញ្ជាក់ ថា កុមារ កំព្រា ដែល ទទួលបាន អំណោយ នៅ ពេល នេះ មាន ចំនួន សរុប ៦៥ នាក់ និង អ្នកមើល ថែ ចំនួន ៨នាក់ ។ អំណោយ ដែល យកមក ចែកជូន នៅ ពេល នេះ រួម មាន៖ អង្ករ ត្រីខ មី ទឹក សុី អុីវ ស្ករ ស អំបិល សៀវភៅ ប៊ិច ទឹក សុទ្ធ ម៉ាស និង ថវិកា មួយ ចំនួន ទៀត ៕ សមាគម រោងចក្រ កាត់ដេរ សង្ខេប ខ្លឹមសារ នៃ សេចក្ដីសម្រេច បិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ រួមទាំង ការបែងចែក តំបន់ ក្រហម លឿង ទុំ និង លឿង
( ភ្នំពេញ ) ៖ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា ហៅ កាត់ ថា GMAC បាន រៀបចំ នូវ ខ្លឹមសារ សង្ខេប មួយ របស់ សេចក្ដីសម្រេច ស្ដីពី ការបិទ ខ្ទប់ ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល រហូតដល់ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២១ ។
ខ្លឹមសារ សង្ខេប ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ នេះ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា ក៏ បាន បង្ហាញ អំពី ការអនុញ្ញាត និង មិន អនុញ្ញាត នៅ តំបន់ ក្រហម តំបន់ លឿង ទុំ និង តំបន់ លឿង ផងដែរ ដើម្បី ផ្ដល់ ភាពងាយស្រួល ប្រជាពលរដ្ឋ ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ សង្ខេប ដែល រៀបចំ ដោយ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា៖ សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ប្រយ័ត្ន ចាញ់បោក ជន ខិលខូច ដែល ទូរស័ព្ទ ប្រាប់ ឲ្យ បង់ប្រាក់ តាម ប្រព័ន្ធ ផ្ទេរ ប្រាក់ នានា ដើម្បី បាន ការបញ្ចុះ អត្រា ការប្រាក់
( ភ្នំពេញ ) ៖ សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា នៅ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ប្រយ័ត្ន ចាញ់បោក ជន ខិលខូច មួយចំនួន ដែល ទូរស័ព្ទ ទៅកាន់ អតិថិជន របស់ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ដោយ តម្រូវឲ្យ អតិថិជន ធ្វើ ការបង់ប្រាក់ តាម ប្រព័ន្ធ ផ្ទេរ ប្រាក់ នានា ដើម្បី ទទួលបាន ការបញ្ចុះ អត្រា ការប្រាក់ ឬ ការផ្អាក បង់ សង មួយ រយៈពេល ។
សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៧ ខែមេសា នេះ បាន បញ្ជាក់ ថា ក្នុង រយៈពេល ថ្មី ៗ នេះ មាន ជន ខិលខូច មួយចំនួន បាន ទូរស័ព្ទ ទៅកាន់ អតិថិជន របស់ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ដោយ តម្រូវឲ្យ អតិថិជន ធ្វើ ការបង់ប្រាក់ តាម ប្រព័ន្ធ ផ្ទេរ ប្រាក់ នានា ដើម្បី ទទួលបាន ការបញ្ចុះ អត្រា ការប្រាក់ ការផ្អាក បង់ សង មួយ រយៈពេល ការរៀបចំ ឥណទាន ឡើងវិញ ឬ ការផ្តល់ ជូន ផ្សេង ៗ ទៀត ។
សេចក្ដីជូនដំណឹង របស់ សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា បាន ឲ្យដឹង ទៀត ថា ដើម្បី ចៀសវាង ការចាញ់បោក ជន ខិលខូច ទាំងនោះ សមាគម សូម លើកទឹកចិត្ត ដល់ អតិថិជន និង សាធារណជន ធ្វើ ការបង់ប្រាក់ តាមរយៈ លេខ ទូរស័ព្ទ របស់ មន្ត្រី ឥណទាន ដែល មាន ភ្ជាប់ ជូន លើ តារាង បង់ប្រាក់ ឬ តាមរយៈ ការិយាល័យ គ្រឹះស្ថាន ដែល នៅជិត លោក អ្នក បំផុត ។
លោក Katsunobu Kato រដ្ឋមន្រ្តី ខុទ្ទកាល័យ ជប៉ុន បាន ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន ថា ការសម្រេចចិត្ត មិន ទាន់ ត្រូវបាន ធ្វើឡើង នៅឡើយ ទេ ស្តីពី វ៉ាក់សាំង របស់ ក្រុមហ៊ុន ណា ដែល នឹង ត្រូវ ប្រើ នៅ មជ្ឈមណ្ឌល នោះ ហើយ មនុស្ស ប៉ុន្មាន នាក់ នឹង ទទួលបាន ការចាក់ វ៉ាក់សាំង ក្នុង មួយ ថ្ងៃ ៗ ។
ក្រសួង សេដ្ឋកិច្ច ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការបិទ បញ្ចប់ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ នៅ ទីស្ដីការ ក្រសួង
សេចក្ដីជូនដំណឹង បាន ឲ្យដឹង ថា ក្រសួង សេដ្ឋកិច្ច បាន បញ្ចប់ រួចរាល់ ជា ស្ថាព រ នូវ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ចំនួន ២លើ ក ដែល ត្រូវបាន រៀបចំឡើង នៅ ទីស្តីការ ក្រសួង ។
* លើក ទី១ ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ០១ - ១០ ខែមេសា ឆ្នាំ ២០២១ សម្រាប់ មន្ត្រី បុគ្គលិក នៃ គ្រប់ អង្គភាព ថ្នាក់ កណ្តាល ក្រោម ឱវាទ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ * លើក ទី២ ចាប់ពី ថ្ងៃទី ២០ - ២៧ ខែមេសា ឆ្នាំ ២០២១ សម្រាប់ មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ស្រប តាម ការរៀបចំ របស់ គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ក្នុង ក្របខណ្ឌ ទូទាំង ប្រទេស ( គ. វ.ក - ១៩) ។
អាស្រ័យ ហេតុ នេះ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីង - ១៩ នៅ ទីស្តីការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ត្រូវបាន បិទ បញ្ចប់ ជាស្ថាពរ ចាប់ពី ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ វេលា ម៉ោង ១២៖០០ នាទីនេះ តទៅ ៕
បទ វិភាគ អន្តរជា តិ៖ តើ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ នៅ ឥណ្ឌា អាច ធ្វើឱ្យ សតិសម្បជញ្ញៈ របស់ « អ្នកកាន់ វ៉ាក់សាំង ជាតិនិយម » ភ្ញាក់ រលឹក ដែរ ឬ ទេ ?
ខណៈពេល សោកនាដកម្ម ដែល ការបូជា សព អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ តាម ដង វិថី ឥណ្ឌា កាន់តែ ច្រើន ឡើង ៗ តើ សតិសម្បជញ្ញៈ របស់ “ អ្នកកាន់ វ៉ាក់សាំង ជាតិនិយម ” ទាំងនោះ អាច ត្រូវ ភ្ញាក់ រលឹក បាន ទេ ? ដោយសារ បាន រង សម្ពាធ អន្តរជាតិ កាន់តែ ខ្លាំង ឡើង ៗ ទីបំផុត រដ្ឋាភិបាល អាមេរិក បាន ប្រកាស សេចក្តីថ្លែងការណ៍ កាលពី ថ្ងៃទី ២៥ ខែមេសា តាម ម៉ោង ក្នុង តំបន់ ថា នឹង ផ្តល់ ធនធាន វេជ្ជសាស្ត្រ ក្នុង នោះ បូករួម ទាំង វត្ថុធាតុ ដើម សម្រាប់ ផលិត វ៉ាក់សាំង ដល់ ប្រទេស ឥណ្ឌា ។
ពិត មែន តែ ឥណ្ឌា ជា តំបន់ ផលិត វ៉ាក់សាំង ដ៏ សំខាន់ បំផុត មួយ លើ ទូទាំង ពិភពលោក ក៏ដោយ ក៏ប៉ុន្តែ បច្ចុប្បន្ន នេះ មាន ប្រជាជន ត្រឹមតែ ៨.៦ភាគរយ យ៉ាងហោចណាស់ បាន ចាក់ វ៉ាក់សាំង មួយ ដូស ។ អ្វី ដែល កាន់តែ អាក្រក់ ទៅ គឺ សភាព ជំងឺ កូវីដ១៩ នៅ ឥណ្ឌា មាន ភាព កាន់តែ ធ្ងន់ធ្ងរ កំពុង រារាំង ដំណើរការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ជា សកល ។
