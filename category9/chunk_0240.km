( កំពង់ឆ្នាំង ) ៖ អាជ្ញាធរ និង មន្ត្រី បុគ្គលិក សុខាភិបាល ស្រុក ទឹក ផុស ខេត្ត កំពង់ឆ្នាំង រកឃើញ វិជ្ជមាន កូវីដ១៩ ទៅ លើ ស្ត្រី ម្នាក់ ទៀត នា ព្រឹក ថ្ងៃទី ២១ ខែឧសភា ឆ្នាំ ២០២១ ដែល ជា កម្មការិនី រោងចក្រ ហីរ៉ាយហ្សិន អៅដរ ខេមបូឌា មាន ទីតាំង ស្ថិត នៅ ភូមិ ផ្សារ ត្រា ច ឃុំ លង្វែក ។
លោក វរសេនីយ៍ ឯក ខែ ម វិបុល អធិការ នគរបាល ស្រុក ទឹក ផុស បាន ផ្ដល់ របាយការណ៍ មក អង្គភាព ព័ត៌មាន Fresh News ពាក់ព័ន្ធ នឹង ករណី រកឃើញ ស្ត្រី ម្នាក់ វិជ្ជមាន កូវីដ១៩ ថា នៅ ព្រឹក ថ្ងៃទី ២១ ខែឧសភា នៅ មណ្ឌល ចិត្តាឡី ស័ក កម្រិត ២ស្រុក ទឹក ផុសកម្ម ការិនី ធ្វើការ នៅ រោងចក្រ ហីរ៉ាយហ្សិន អគារ ៦ក្រុម ទី១៣ ម្នាក់ ឈ្មោះ តុ ប ឡាយ អាយុ ៣៤ ឆ្នាំ រស់ នៅក្នុង ភូមិ ត្រពាំង ព្រីង ឃុំ អភិវឌ្ឍន៍ ស្រុក ទឹក ផុស ខេត្ត កំពង់ឆ្នាំង ត្រូវបាន ក្រុម គ្រូពេទ្យ ពិនិត្យ សំណាក តាម ឧបករណ៍ តេស្តរហ័ស រកឃើញ វិជ្ជមាន កូវីដ - ១៩ ។
នៅ ថ្ងៃ នេះ ផងដែរ អ្នកជំងឺ ត្រូវបាន រថយន្ត របស់ មន្ទីរពេទ្យ ដឹក យក ទៅ មណ្ឌល ព្យាបាល នៅ ស្រុក កំពង់ត្រឡាច ចំណែក អ្នក ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ត្រូវបាន ពិនិត្យ សំណាក ដែល លទ្ធផល លើក ទី១អវិជ្ជមាន ទាំងអស់ គ្នា ។
ក្នុង ឱកាស នេះ ដែរ សមត្ថកិច្ច និង អាជ្ញាធរ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល រស់ នៅក្នុង មូលដ្ឋាន សូម មេត្តា ប្រុងប្រយ័ត្ន និង អនុវត្ត នូវ វិធាន របស់ ក្រសួង សុខាភិបាល និង វិធាន របស់ រាជ រដ្ឋាភិបាល គឺ « ៣កុំ និង ៣ ការពារ » ។ ប្រសិនបើ បងប្អូន មាន អាការៈ មិន ស្រួល ខ្លួន ដូចជា ក្អក ក្តៅ ខ្លួន ឈឺ បំពង់ ក ។ល ។ ត្រូវ ប្រញាប់ មកពី គ្រោះ ជាមួយ គ្រូពេទ្យ នៅ តាម មណ្ឌល សុខភាព របស់ បងប្អូន ជាបន្ទាន់ ៕
អភិបាល ខេត្ត ព្រះសីហនុ ផ្អាក ទីតាំង ៤ជា បណ្តោះអាសន្ន និង ដាក់ ជា មណ្ឌល ចត្តាឡី ស័ក បន្ទាប់ពី ពាក់ព័ន្ធ ជាមួយ អ្នក កើត កូវីដ
( ព្រះសីហនុ) ៖ អភិបាល ខេត្ត ព្រះសីហនុ លោក គួច ចំរើន នៅ ថ្ងៃទី ២១ ខែឧសភា នេះ បាន សេចក្តីជូនដំណឹង ស្តីពី ការបិទ ផ្អាក ទីតាំង ចំនួន ០៤ កន្លែង ជា បណ្តោះអាសន្ន និង ដាក់ ជា មណ្ឌល ចត្តាឡី ស័ក បន្ទាប់ពី បាន រកឃើញ មាន ពាក់ព័ន្ធ ជាមួយ អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ។
សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា ទីតាំង ទាំង ៤ នោះ រួម មាន៖ ការដ្ឋាន សាងសង់ អគារ វឌ្ឍនៈ អាជីវកម្ម រោងចក្រ ស៉ីស ម៉េដ ខេមបូឌា ហ៊ែល ឃែរ ប្រូដាក់ អាគារ ជួល អាសយដ្ឋាន ផ្លូវ សេរីភាព និង អាហារដ្ឋាន សម្រន់ ស៉ីញ ជា អ័ន ៕
រដ្ឋមន្ដ្រី កសិកម្ម៖ ផ្លែ ស្វាយ ស្រស់ របស់ កម្ពុជា បាន ទៅដល់ ប្រទេស ចិន ហើយ ខណៈ ពិធី សម្ពោធ ជា ផ្លូវការទទួល ផ្លែ ស្វាយ កម្ពុជា នឹង ធ្វើ នៅ ទីក្រុង ប៉េកាំង នា ថ្ងៃទី ២៥ ខែឧសភា
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ២១ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ឲ្យដឹង ថា ការនាំចេញ ផ្លែ ស្វាយ ស្រស់ របស់ កម្ពុជា បាន ដឹក ដល់ ប្រទេស ចិន ហើយ នៅ ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២១ ។
លោក បន្ត ថា ការសម្ពោធ ជា ផ្លូវការ ទទួល ផ្លែ ស្វាយ ស្រស់ របស់ កម្ពុជា នៅ ទីក្រុង ប៉េកាំង នឹង ធ្វើឡើង នៅ ថ្ងៃទី ២៥ ខែឧសភា ឆ្នាំ ២០២១ ខាងមុខ នេះ ក្រោម អធិបតីភាព ពី មន្រ្តី តំណាង ក្រសួង កសិកម្ម និង កិច្ចការ ជនបទ និង ក្រសួង ពាណិជ្ជកម្ម ចិន រួម នឹង អគ្គ រដ្ឋបាល គយ ចិន ជាមួយនឹង តំណាង ស្ថាន អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ទីក្រុង ប៉េកាំង ។
សូម ជម្រាប ថា ក្រសួង កសិកម្ម បាន សហការ ជាមួយ ស្ថានទូត ចិន ប្រចាំ នៅ កម្ពុជា រៀបចំ ពិធី សម្ពោធ ជា ផ្លូវការ ក្នុង ការនាំ ផ្លែ ស្វាយ ស្រស់ ចេញ ពី កម្ពុជា នៅ ថ្ងៃទី ៧ ខែឧសភា ឆ្នាំ ២០២១ កន្លងទៅ ដោយ ត្រូវ ប្រើប្រាស់ រយៈពេល នៃ ការដឹកជញ្ជូន ចំនួន ១៣ ថ្ងៃ ទើប ទៅដល់ គោលដៅ ។
ផ្លែ ស្វាយ ស្រស់ កម្ពុជា គឺជា ផ្លែ ឈើ ស្រស់ ទី២ បន្ទាប់ពី ផ្លែ ចេក ស្រស់ ដែល អាច នាំចេញ ទៅ ប្រទេស ចិន ដោយ ផ្ទាល់ ។ នេះ គឺជា សមិទ្ធិផល ផ្លែ ផ្កា ថ្មី មួយ ទៀត ដែល ប្រសូត្រ ចេញ ពី កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ ប្រសើរ រវាង កម្ពុជា និង ចិន ។
កម្ពុជា មាន ផ្ទៃដី ដាំដុះ ស្វាយ ចំនួន ១៣ម៉ឺន ហិកតា ផ្ទៃដី ប្រមូល ផល ស្វាយ ជាង ៩ម៉ឺន ហិកតា ក្នុង បរិមាណ ទិន្នផល ជាង ១៥តោន ក្នុង ១ហិកតា ស្មើនឹង ទិន្នផល សរុប ជិត ១. ៤លាន តោន ក្នុង មួយ រដូវ ៕ មន្រ្តី ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ សហព័ន្ធ រុស្សី ឧបត្ថម្ភ ថវិកា ១.៣២០ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ មន្រ្តី ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ សហព័ន្ធ រុស្សី ឧបត្ថម្ភ ថវិកា ១.៣២០ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
មន្រ្តី ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ សហព័ន្ធ រុស្សី កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។
រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច ដាក់ ឲ្យ ប្រើប្រាស់ ផែនការ សកម្មភាព នៃ ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត សៀមរាប ឆ្នាំ ២០២១ - ២០៣៥
រដ្ឋបាល ខេត្ត ស្វាយរៀង បាន បញ្ជាក់ ថា មាន បុរស ឈ្មោះ ពេញ ជឿន អាយុ ៤៨ ឆ្នាំ មាន ទីលំនៅ ភូមិ អង្កាញ់ ឃុំ ប្រធាតុ ស្រុក កំពង់ត្របែកបាន ទៅ ពិនិត្យ ព្យាបាល នៅ បន្ទប់ ថែទាំ ជំងឺ ទូទៅ « ចន្ទ រះ » គិលានុបដ្ឋាក បឋម « ស្រី សុវណ្ណា » ស្ថិត នៅក្នុង ភូមិ ធ្លក ឃុំ ក្រោល គោ ស្រុក ស្វាយ ជ្រំ ។
អភិបាល ខេត្ត បន្ទាយមានជ័យ នាំ អំណោយ ចែកជូន កម្លាំង ប្រជាការពារ ចំនួន ២២០ នាក់ និង យុវជន ១៥នាក់ នៅ ក្រុង ប៉ោយប៉ែត
