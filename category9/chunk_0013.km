( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ២៩ ខែកុម្ភៈ ឆ្នាំ ២០២០ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន១ គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៩ ខែកុម្ភៈ ឆ្នាំ ២០២០ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន ២គ្រឿង ក្នុង នោះ រួម មាន៖ រ៉ឺម៉ក់ កង់ បី ១ គ្រឿង ។
យោធា ម្នាក់ ជិះ រថយន្ត ម៉ែក សឺដេស ខឹង គេ បុក រថយន្ដ ខ្លួន រួច បើក រត់ ដក កាំភ្លើង បាញ់ បំបែក កង់ ត្រូវ នគរបាល ចាប់ វាយ ខ្នោះ
ហេតុការណ៍ នេះ បង្ក ការភ្ញាក់ផ្អើល នៅ ម៉ោង ០៨៖០០ នាទី យប់ ថ្ងៃទី ២៩ ខែកុម្ភៈ ឆ្នាំ ២០២០ នៅក្នុង បរិវេន កោះ ពេជ្រ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន ។
បុរស អ្នកបើកបរ រថយន្ត ម៉ែក សឺដេស ឈ្មោះ ឡុង ឡង ឌី អាយុ ៣៥ ឆ្នាំ មុខរបរ យោធា ស្នាក់ នៅ ភូមិ ម័ល សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ បាន ដក កាំភ្លើង ម៉ាក ឡុក បាញ់ កង់ រថយន្ត កូរ៉ូឡា ។ នគរបាល ឃាត់ខ្លួន និង បញ្ជូល ទៅ កម្លាំង កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ដោយ ជា យោធា ។
នគរបាល ផ្នែក វាស់វែង បាន ឲ្យដឹង ថា ករណី គ្រោះថ្នាក់ ចរាចរណ៍ រវាង រថយន្ត ម៉ាក កូរ៉ូឡា បើកបរ បុរស ម្នាក់ ស្រវឹង ជោគ បើក ស្រប ទិស គ្នា ជាមួយនិង រថយន្ត ម៉ែក សឺដេស បើកបរ ដោយ បុរស ម្នាក់ បុក គូថ រថយន្ត សឺដេស បណ្ដាល ខូចខាត ផ្នែក ខាងក្រោយ ឆ្វេង ហើយ មិន ដឹង មូលហេតុ អ្វី បានជា បុរស បើកបរ រថយន្ត សឺដេស ដក កាំភ្លើង ខ្លី បាញ់ បំបែក កង់ តែ ភ្លាម ៗ ។
នគរបាល ផ្នែក វាស់វែង បន្ដ ទៀត ថា កម្លាំង នគរបាល បាន ឃាត់ បុរស យោធា ដក អាវុធ បាញ់ ចំណែក រថយន្ត ទាំង២ គ្រឿង ធ្វើ ការវាស់វែង យក រក្សាទុក នៅ អធិការដ្ឋាន ខណ្ឌ ចំការមន ប្រគល់ឲ្យ ខាង កម្លាំង កងរាជអាវុធ ក្រុង ភ្នំពេញ ដើម្បី ចាត់ការ តាម ផ្លូវ ច្បាប់ រឿង ផ្ទុះ អាវុធ តាម ផ្លូវ សាធារណៈ ៕
ដើម្បី ទទួលបាន សុខភាព ល្អ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ផ្តល់ ដំបូន្មាន បន្ថែម ដល់ ប្រជាពលរដ្ធ ចូលរួម ហាត់ កីឡា និង ទទួលទាន ទឹក ឱ្យ បាន ច្រេីន ។
ក្រសួង សុខាភិបាល ច្រានចោល ការប្រឌិត ព័ត៌មាន របស់ ក្រុម ប្រឆាំង ដែល ថា កម្ពុជា មាន ជំងឺ កូរ៉ូណា ថ្មី ច្រើន ប៉ុន្តែ រដ្ឋាភិបាល បិទ ព័ត៌មាន
( ភ្នំពេញ ) ៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល កម្ពុជា នៅ យប់ ថ្ងៃទី ២៩ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ បាន ប្រកាស ច្រើន ចោល នូវ ការផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត របស់ ក្រុម ប្រឆាំង រដ្ឋាភិបាល ពាក់ព័ន្ធ ទៅនឹង ជំងឺ កូរ៉ូណា ថ្មី ឬ Covid-19 ។
ពាក់ព័ន្ធ នឹង ការប្រឌិត ព័ត៌មាន របស់ សមាជិក ក្រុម ប្រឆាំង រដ្ឋាភិបាល នេះ អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល ក៏ បាន អំពាវនាវ ដល់ សមត្ថកិច្ច ឲ្យ ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ផងដែរ ។
បេី តាម ការបញ្ជាក់ របស់ ក្រសួង សុខាភិបាល គឺ រហូតមកទល់ ពេលនេះ កម្ពុជា មិន ទាន់ មាន វត្តមាន នៅ ជំងឺ កូរ៉ូណា ថ្មី ទៀត ឡើយ ក្រៅតែ ពី បាន រកឃើញ នៅលើ ខ្លួន ជនជាតិ ចិន ម្នាក់ ដែល បាន ចេញ ពី ក្រុង វូហាន ប្រទេស ចិន ហើយ ចូលមក កម្ពុជា កាលពី ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០២០ ប៉ុន្តែ ទោះជា យ៉ាង នេះ ក្តី ជនជាតិ ចិន រូប នោះ ត្រូវបាន ព្យាបាល ជាសះស្បើយ ហើយ ត្រឡប់ ទៅកាន់ ប្រទេស ចិន វិញ ផងដែរ ៕ លោក នេត្រ ភក្ត្រា៖ ការគ្រប់គ្រង សំរាម តំបន់ ឧទ្យាន ជាតិ អង្គរ ធ្វើ បាន ល្អ ដូច្នេះ តំបន់ អង្គរ ត្រូវតែ មាន បរិស្ថាន ល្អ
( សៀមរាប ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការគ្រប់គ្រង សំណល់ សំរាម នៅក្នុង ខេត្ត សៀមរាប ជាពិសេស នៅ តំបន់ ឧទ្យាន ជាតិ អង្គរ រួមទាំង តំបន់ ប្រាង្គ ប្រាសាទ ផ្សេង ៗ គឺ ធ្វើ ការរៀបចំ បាន យ៉ាង ល្អ ដូច្នេះ រមណីយដ្ឋាន ឧទ្យាន ជាតិ អង្គរ ត្រូវតែ មាន បរិស្ថាន ល្អ និង ពុំ មាន ការបំពុល ដោយ ប្លាស្ទិក ស្រប តាម ពាក្យស្លោក « ទីក្រុង ស្អាត រមណីយដ្ឋាន ស្អាត សេវា ល្អ » ។
ការវាយតម្លៃ បែប នេះ របស់ លោក នេត្រ ភក្ត្រា បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ២៩ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ នៅក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ចែក ដប ទឹក ដល់ សិស្សានុសិស្ស នៅ វិទ្យាល័យ បន្ទាយស្រី ដើម្បី កាត់បន្ថយ ការប្រើប្រាស់ ដប ទឹក ប្លាស្ទិក ស្ថិត នៅក្នុង ស្រុក បន្ទាយស្រី ។
លោក នេត្រ ភក្ត្រា បាន បន្ត ថា ចំណុច នេះ ជា ការលើកទឹកចិត្ត និង សូម គាំទ្រ សកម្មភាព ទាំងអស់ នេះ ជាពិសេស សូម ឱ្យ អាជ្ញាធរ បង្កើន ការយកចិត្តទុកដាក់ លើ ការរក្សា សំណល់ សំរាម ហើយ អី ឡូវនេះ ក្រសួង បរិស្ថាន សហការ ជាមួយ ក្រសួង អប់រំ យុវជន និង កីឡា ព្រមទាំង អង្គការ ជឿជាក់ លើ សិស្ស ជនបទ កម្ពុជា នៅ ខេត្ត សៀមរាប បាន ចុះ មក ផ្សព្វផ្សាយ ពី ផល ប៉ះពាល់ ដោយសារ សំណល់ ប្លាស្ទិក ដល់ ប្រជា សហគមន៍ ចូលរួម សហការ ជាមួយ អាជ្ញាធរ ដើម្បី គ្រប់គ្រង សំណល់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ ។
លោក នេត្រ ភក្ត្រា បាន បញ្ជាក់ ថា ការបដិសេធ ការប្រើប្រាស់ ប្លាស្ទិក ដូចជា ថង់ យួរ ដៃ ដប ទឹក បរិសុទ្ធ ជាដើម នេះ វា ជួយ មាន បរិស្ថាន ស្អាត គ្មាន ការបំពុល ដោយ សំរាម ប្លាស្ទិក ខណៈ សំណល់ ផ្នែក នេះ ត្រូវបាន គេ ចាត់ទុក ថា ជា ការបំពុល ដល់ បរិស្ថាន ដោយសារតែ វា ត្រូវការ ពេលវេលា ជាច្រើន រយ ឆ្នាំ ដើម្បី ធ្វើ ការបំបែក ធាតុ ឬ រលួយ នៅលើ ផែនដី ។
បើ តាម លោក នេត្រ ភក្ត្រា បាន លើកទឹកចិត្ត ដល់ ប្រជា សហគមន៍ ថា ដើម្បី កាត់បន្ថយ ការប្រើប្រាស់ ប្លាស្ទិក តែម្តង ហើយ បោះចោល គឺ ប្រជាពលរដ្ឋ ចាំបាច់ ត្រូវ កែប្រែ ទម្លាប់ ដោយ រួមគ្នា កាត់បន្ថយ ប្លាស្ទិក ព្រោះ សំណល់ ប្លាស្ទិក គឺជា បញ្ហា គំរាមកំហែង ចម្បង ចំពោះ ប្រព័ន្ធ អេកូឡូស៊ី និង ការអភិវឌ្ឍ មនុស្ស ទូទាំង ពិភពលោក និង នៅក្នុង ប្រទេស កម្ពុជា ។
