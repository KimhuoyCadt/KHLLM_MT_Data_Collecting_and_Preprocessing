( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣០ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១២ករណី និង ករណី ជួញដូរ ១៨ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៦១ នាក់ ។
CDC បាន ញ្ជាក់ ឲ្យដឹង ថា តាម សំណើ សុំ វិនិយោគ របស់ ក្រុមហ៊ុន គណៈកម្មាធិការ វិនិយោគ កម្ពុជា នៃ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន សម្រេច ចេញ វិញ្ញាបនប័ត្រ ចុះបញ្ជី ជា ស្ថាពរ ជូន ដល់ ក្រុមហ៊ុន ដូច ខាងក្រោម៖
សូម ជម្រាប ថា កាលពី ថ្ងៃទី ១២ ខែកុម្ភៈ ឆ្នាំ ២០២០ គណៈកម្មការ អឺរ៉ុប (EU) បាន ចេញ សេចក្តីសម្រេច កាត់ ផ្នែក ខ្លះ នៃ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ EBA ។ តាម ការវាយតម្លៃ របស់ ផ្នែក ឯកជន ការកាត់ ផ្នែក ខ្លះ នៃ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ នេះ មាន ទឹកប្រាក់ ប្រមាណ ១០០ លាន ដុល្លារ អាមេរិក លើក ផលិតផល ៤០ មុខ របស់ កម្ពុជា ។ សេចក្តីសម្រេច នេះ នឹង ចូល ជាធរមាន នៅ រយៈពេល ៦ខែ ទៀត ពោលគឺ ក្នុង ខែសីហា ឆ្នាំ ២០២០ នេះ ប្រសិនបើ សភា របស់ អឺរ៉ុប អនុម័ត យល់ព្រម តាម ការសម្រេច របស់ គណៈកម្មការ អឺរ៉ុប នោះ ។
ពាក់ព័ន្ធ ការព្យួរ ផ្នែក ខ្លះ នៃ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ EBA ពី EU នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី ប្រាប់ ដល់ កម្មករ កម្ម ការិនី សូម កុំ ព្យាបារម្ភ ឲ្យ សោះ រាជ រដ្ឋាភិបាល កម្ពុជា មាន សមត្ថិភាព ដើម្បី នឹង ទទួលខុសត្រូវ ៕
ថ្ងៃ នេះ គ្រឿងចក្រ បាន បញ្ជូន ទៅដល់ ទីតាំង ស្ពាន ស្ទឹង ស្តៅ ក្នុង ស្រុក សង្គម ថ្មី ខេត្ត ព្រះវិហារ និង កំពុង សម្អាត បរិវេណ ជុំវិញ ដើម្បី សាងសង់ ស្ពាន ថ្មី
លោក សំ លាង ទ្រី បាន គូសបញ្ជាក់ ថា « ជា ជំហ៊ាន ដំបូង មុននឹង ធ្វើ ការស្ថាបនា សាងសង់ ស្ពាន ស្ទឹង ស្តៅ នេះ ឡើងវិញ ក្រុមការងារ កំពុងតែ ម មារ ញឹក ក្នុង ការបោសសម្អាត បរិវេណ នៅ ជុំវិញ ឲ្យ បាន ស្អាត ល្អ សិន ដូចជា សម្អាត ទីតាំង ស្ពាន ចាស់ ដែល បាន ឆេះ និង សម្អាត គុម្ព ឫស្សី និង ដើមឈើ ងាប់ ផ្សេង ៗ ទៀត ចៀសវាង មាន ការឆេះ ព្រៃ រាល មក ម្តង ទៀត » ។
ដោយឡែក កាលពី ពេល ថ្មី ៗ នេះ លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រះវិហារ បាន ដឹកនាំ ក្រុមការងារ និង មន្ត្រី ជំនាញ ចុះ មក ពិនិត្យ ដោយ ផ្ទាល់ ដល់ ទីតាំង ស្ពាន ស្ទឹង ស្តៅ ដែល រង ការឆេះ ដោយ ភ្លើង ព្រៃ នេះ ។ មិន បង្អង់ យូរ លោក អភិបាល ខេត្ត បាន ណែនាំ ភ្លាម ៗ ដែរ ឲ្យ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ត្រូវ ស្ថាបនា សាងសង់ ស្ពាន ដែក បាឡេ ថ្មី ជំនួស ស្ពាន ឈើ ដែល ទ្រុឌទ្រោម និង រង ការឆេះ នេះ ដើម្បី ជួយ សម្រួល ដល់ ការធ្វើដំណើរ និង ដឹក កសិផល ផ្សេង ៗ របស់ ប្រជាពលរដ្ឋ បាន ស្រួល ។
លោក នេត្រ ភក្រ្តា បាន ថ្លែង ថា ក្រោយពី មាន ការពិភាក្សា ពិគ្រោះយោបល់ ជាមួយ សប្បុរស ជន មួយចំនួន ដែល មាន សមាន ចិត្ត ក្នុង ការចូលរួម កសាង ស្ពាន ក្នុង តំបន់ អភិរក្ស នេះ ក្រសួង បរិស្ថាន នឹង សម្របសម្រួល ក្នុង ការសាងសង់ ស្ពាន ទាំងនេះ ឡើងវិញ ដែល នឹង ធ្វើ ពី បេតុង ដើម្បី ចៀសវាង ភ្លើង ឆេះ ជាថ្មី ម្តង ទៀត ។
យោង តាម របាយការណ៍ ពី ក្រសួង បរិស្ថាន នៅក្នុង រយៈពេល ២ ឆ្នាំ ចុងក្រោយ នេះ ស្ពាន ចំនួន ៤ ត្រូវបាន ភ្លើង ឆេះ បំផ្លាញ ដែល ស្ពាន នីមួយ ៗ មាន ប្រវែង ប្រមាណ ៥០ ម៉ែត្រ ឬ វែង ជាង នេះ ក្នុង នោះ ស្ពាន ឈើ ចំនួន ២ ត្រូវបាន លួច ដុត នៅក្នុង ខែកុម្ភៈ ឆ្នាំ ២០២០ ៕
( ពោធិ៍សាត់ )៖ ចោរ មួយ ក្រុម មាន គ្នា ៤នាក់ ក្នុង នោះ មាន ស្ត្រី ម្នាក់ បាន បន្លំ ធ្វើជា រក ទិញ ទឹក សុទ្ធ ហើយ មាន អ្នកចូលមក លួច លុយ កន្លែង ដូរ លុយ និង ផ្ទេរ លុយ ទ្រូម៉ាន់ នីមួយ កន្លែង យីហោ អ៊ុន កញ្ញា តាម បណ្តោយ ផ្លូវ ក្រាល កៅស៊ូ ស្ថិត ក្នុង ភូមិ បាក់ រទះ សង្កាត់ ព្រៃ ញី ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ កាលពី វេលា ម៉ោង ៩ ៖ ២៤ នាទី ព្រឹក ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ ។
ជនសង្ស័យ ដែល មាន វ័យ ជាង ២០ ឆ្នាំ មាន គ្នា ម្នាក់ ទៀត ឈប់ នៅមុខ ហាង ម៉ាស្សា ជាប់ នោះ ដើម្បី សម្រួល ពេល មាន បញ្ហា ។ នៅពេល ផ្អើល ឆោឡោ ទាំង អ្នកទិញ ទឹក សុទ្ធ និង ជនសង្ស័យ បាន ដាក់ មេ ប្រូច ដូចគ្នា មួយ ទៅ ជើង និង មួយ ទៀត ទៅ ត្បូង ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ សាខា កាំ កុងត្រូល ខេត្ត ព្រះសីហនុ ដោយ បាន សហការ ជាមួយ មន្ទី ពាណិជ្ជកម្ម ខេត្ត និង អាជ្ញាធរដែនដី បាន បន្ត ចុះ ផ្សព្វផ្សាយ អំពី គុណភាព សុវត្ថិភាព ម្ហូប អាហារ នៅ ផ្សារ កង កេង ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
នៅក្នុង សកម្មភាព ចុះ ត្រួតពិនិត្យ មន្ត្រី ជំនាញ បាន ដក យក គំរូ ម្ហូប អាហារ មួយចំនួន មក ធ្វើតេស្ត បឋម រួម មាន៖ បង្គារ ស្រស់ មឹក ស្រស់ និង ស្ពៃ ជ្រក់ ស្លឹក គ្រៃ ហាន់ រួច ដើម្បី រក សារធាតុ គីមី ហាមឃាត់ ដែល អាច ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ ។
ជា លទ្ធផល មន្ត្រី ជំនាញ ពុំ បាន រកឃើញ មាន វត្តមាន សារធាតុ គីមី ហាមឃាត់ នៅលើ ម្ហូប អាហារ ខាងលើ និង ពុំ មាន ការដាក់ តាំង ផលិផល ម្ហូប អាហារ វេច ខ្ចប់ ស្រាប់ ដែល ខូច គុណភាព ឬ ហួស កាលបរិច្ឆេទ នោះ ទេ ។
បន្ទាប់មក មន្ត្រី ជំនាញ បាន ធ្វើ ការណែនាំ ដល់ អាជីវករ ដទៃ ឲ្យ យល់ដឹង និង អនុវត្ត ទៅតាម ច្បាប់ ស្តីពី ការគ្រប់គ្រង គុណភាព សុវត្ថិភាព លើ ផលិតផល ទំនិញ និង សេវា ចៀសវាង បង្ក ផល ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ និង អាច ប្រឈម ចំពោះ មុខ ច្បាប់ ថែម ទៀត ៕
អភិបាល ខេត្ត ត្បូង ឃ្មុំ៖ ដោយសារ សន្តិភាព ទើប សង្កាត់ វិហារ លួង មាន ការអភិវឌ្ឍន៍ និង ប្តេជ្ញា អភិវឌ្ឍ ក្រុង សួង ឲ្យ ក្លាយជា ទីក្រុង ស្អាត ចំណាត់ថ្នាក់ លេខ ១
( ត្បូងឃ្មុំ ) ៖ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន លើកឡើង ថា ដោយសារ សន្តិភាព ដែល សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច ពញា ចក្រី ហេង សំរិន រួមទាំង ឥស្សរជន ទាំងអស់ ខិតខំ យកមក បាន និង ថែរក្សា ការពារ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ទើប សង្កាត់ វិហារ លួង ក៏ ដូចជា សង្កាត់ និង ឃុំ ទាំង ៦៣ ទៀត ក្នុង ខេត្ត ត្បូងឃ្មុំ មាន ការអភិវឌ្ឍន៍ រីកចម្រើន ធ្វើឲ្យ កម្រិត ជីវភាព ពលរដ្ឋ ធូរធារ ។
លោក ជា ម ច័ន្ទ សោភ័ណ បាន ថ្លែង ប្រាប់ ប្រជាពលរដ្ឋ មេឃុំ ចៅសង្កាត់ មន្ត្រីរាជការ ទូទាំង ក្រុង សួង បែប នេះ ក្នុង ឱកាស លោក និង លោក ស៊ាក ឡេង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត អញ្ជើញ ជា អធិបតី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ អគារ រដ្ឋបាល សង្កាត់ វិហារ លួង និង សមិទ្ធផល នានា ក្នុង សាលា សង្កាត់ វិហារ លួង ក្រុង សួង ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ ។
អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន បន្ត ថា សង្កាត់ វិហារ លួង និង សង្កាត់ សួង ក្នុង ក្រុង សួង បាន នឹង កំពុង កសាង ហេដ្ឋារចនាសម្ព័ន្ធ នានា កែលម្អ សោភ័ណ្ឌភាព ក្រុង ដោយ ស្ថាបនា ផ្លូវ ពី ផ្លូវ ដី មក ក្រាល គ្រួស ក្រហម ដោយ បន្ត ចាក់ បេតុង និង អ៊ុត កៅស៊ូ ធ្វើ និង ជួសជុល ប្រព័ន្ធ លូ ដាំ បង្គោល បំពាក់ អំពូលភ្លើង បំភ្លឺ ផ្លូវ និង លម្អ សោភ័ណ្ឌភាព នា ពេល រាត្រី ធ្វើ សួនច្បារ ផ្កា ចម្រុះ ពណ៌ ពិសេស ថែរក្សា អនាម័យ បរិស្ថាន ឲ្យបាន ស្អាត ល្អ ។
លោក ជា ម ច័ន្ទ សោភ័ណ បញ្ជាក់ ថា ចំនុច ទាំងអស់ ខាងលើ នេះ ហើយ ដែល ត្រូវ បន្ត កសាង និង កែលម្អ ដោយ ប្តេជ្ញា ជំរុញ ការអភិវឌ្ឍ ក្រុង សួង ឲ្យ ក្លាយ ជា ទីក្រុង ស្អាត ចំណាត់ថ្នាក់ លេខ ១ តែ ថា បើ ចង់ សម្រេច ទៅ បាន នោះ គឺ ត្រូវ មាន ការចូលរួម ពី គ្រប់ ភាគី ទាំង មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ ដែល រស់ នៅ ទីនេះ រួមគ្នា ចាត់ទុក គ្រប់ កន្លែង ទាំងអស់ នៅ ទីក្រុង សួង ឲ្យ ដូចជា នៅ កន្លែង ធ្វើការ និង ផ្ទះ របស់ ខ្លួន ដូចគ្នា ។
ជាមួយគ្នា នេះ លោក ជា ម ច័ន្ទ សោភ័ណ បាន ក្រើន រំលឹក ដល់ លោក អភិបាល ក្រុង ចៅសង្កាត់ រួមទាំង មន្ត្រី ទូទាំង ក្រុង សួង ត្រូវ បន្ត បំរើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឲ្យបាន លឿន រហ័ស ប្រកបដោយ តម្លាភាព និង មាន ប្រសិទ្ធភាព ខ្ពស់ ក្នុង នាម ជា អាណាព្យាបាល ដែល ប្រជាពលរដ្ឋ បាន ផ្តល់ ទំនុកចិត្ត លើ ៕ កម្ពុជា - វៀតណាម សន្យា ពង្រឹង កិច្ចសហប្រតិបត្តិការ បង្រ្កាប គ្រឿងញៀន តាម បន្ទាត់ ព្រំដែន ឲ្យ មាន ប្រសិទ្ធភាព បន្ថែម ទៀត
( ភ្នំពេញ ) ៖ នៅក្នុង កិច្ច ជំនួប ទ្វេ ភាគី រវាង សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី និង រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ និង ឧត្តមសេនីយ៍ ឯក បម្រុង ឡេ គ្វី វឿង អនុ រដ្ឋមន្រ្តី ក្រសួង នគរបាល នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម នា រសៀល ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ នៅ ទីស្តីការ ក្រសួង មហាផ្ទៃ បាន សន្យា ថា នឹង ពង្រឹង កិច្ចសហប្រតិបត្តិ ទ្វេ ភាគី ឲ្យបាន ខ្លាំងក្លា បន្ថែម ទៀត ក្នុង ការទប់ស្កាត់ និង បង្រ្កាប បទល្មើស គ្រឿងញៀន នៅ តាម បន្ទាត់ ព្រំដែន នៃ ប្រទេស ទាំង ពីរ ។
ភាគី ទាំង ពីរ បាន បញ្ជាក់ ថា បញ្ហា គ្រឿងញៀន នៅ តាម ខ្សែ បន្ទាត់ ព្រំដែន រវាង ប្រទេស កម្ពុជា និង ប្រទេស វៀតណាម នៅតែ មាន ការព្រួយបារម្ភ យ៉ាង ខ្លាំង ដូច្នេះ ដើម្បីឲ្យ ការបង្រ្កាប នូវ បទល្មើស នេះ មាន ប្រសិទ្ធភាព បន្ថែម ទៀត នោះ ត្រូវ ធ្វើ ការទំនាក់ទំនង គ្នា ឲ្យ បាន ញឹកញាប់ និង ឲ្យបាន លឿន បំផុត ដើម្បី កុំ ឲ្យ ប៉ះពាល់ ដល់ ការរស់នៅ រវាង ប្រជាជន នៃ ប្រទេស ទាំង ពីរ នៅ តាម ខ្សែ បន្ទាត់ ព្រំដែន នោះ ។
សម្តេច ក្រឡាហោម ស ខេង បាន លើកឡើង ថា នា ពេល កន្លងទៅ កងកម្លាំង នគរបាល នៃ ប្រទេស ទាំង ពីរ បាន ធ្វើ ការ បង្រ្កាប រឹបអូស និង ឃាត់ខ្លួន ជនសង្ស័យ ករណី គ្រឿងញៀន បាន យ៉ាង ច្រើន ផងដែរ ខណៈ ដែល ពួកគេ កំពុង ធ្វើ សកម្មភាព នោះ ។
យ៉ាងណា ក្តី សម្តេច ក្រឡាហោម ស ខេង បាន បញ្ជាក់ ទៀត ថា រហូតមកដល់ ពេលនេះ បើ ទោះបី បញ្ហា សកល នៃ គ្រឿងញៀន មិន ទាន់ ធ្លាក់ចុះ ក្តី ក៏ កម្ពុជា នៅតែ ប្តេជ្ញា ខ្ពស់ ចំពោះ ការទប់ស្កាត់ និង បង្រ្កាប នូវ គ្រឿងញៀន នេះ ជាដរាប ។
ក្រៅពី ពង្រឹង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី លើ ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ភាគី ទាំង ពីរ កម្ពុជា - វៀតណាម ក៏ សន្យា ថា នឹង ខិតខំ ធ្វើ យ៉ាងណា រួមគ្នា ទប់ស្កាត់ និង បង្រ្កាប រាល់ បទល្មើស ផ្សេង ៗ ទៀត ផងដែរ ៕ សម្តេច ក្រឡាហោម ស ខេង អំពាវនាវ ប្រជាពលរដ្ឋ ត្រូវ ថែរក្សា សន្តិភាព ឲ្យបាន គង់វង្ស យូរអង្វែង និង អរគុណ សន្តិភាព
( ព្រៃវែង ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ បាន ថ្លែង អំពាវនាវ ទៅកាន់ ប្រជាពលរដ្ឋ នៅ ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង ត្រូវ ចូលរួម អរគុណ សន្តិភាព ព្រោះ សន្តិភាព ជា ឱកាស មាស ឱកាស ពេជ្រ ក្នុង អភិវឌ្ឍន៍ ប្រទេស ឲ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ មាន ផ្លូវ សាលារៀន មន្ទីរពេទ្យ វត្ត អារាម ទឹក អគ្គីសនី និង ហេដ្ឋារចនាសម្ព័ន្ធ ជាច្រើន នៅក្នុង ប្រទេស កម្ពុជា ដូច្នេះ ត្រូវ ចូលរួម ថែរក្សា សន្តិភាព ឲ្យ ស្ថិតស្ថេរ គង់វង្ស យូអង្វែង ។
សម្តេច ក្រឡាហោម ស ខេង ថ្លែង បែប នេះ នៅ គ្រា ដែល សម្តេច អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការអគារ សិក្សា ទី ចាត់ការ អគារ រដ្ឋបាល ឃុំ និង សមិទ្ធផល នានា នៅក្នុង ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ ដែល មាន ការចូលរួម លោក ស៊ូឌីម៉ាន់ ហា សែង ឯក អគ្គ រដ្ឋទូត ឥណ្ឌូនេស៊ី ប្រចាំ នៅ ប្រទេស កម្ពុជា លោក លោកស្រី អភិបាល ក្រុង ស្រុក ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស លោកយាយ តា ចូលរួម ចំនួន ៣. ៦០៦ នាក់ ។
សម្តេច ក្រឡាមហោម ស ខេង បាន កត់សម្គាល់ ទៀត ថា ការដាក់ សម្ពោធ ឲ្យ ប្រើប្រាស់ នៅ អគារ សិក្សា នៅ ថ្ងៃ នេះ គឺជា សមិទ្ធផល មួយ ដ៏ ធំធេង សម្រាប់ ទុកឲ្យ ក្មួយ ៗ សិស្សានុសិស្ស ដើម្បី សិក្សា រៀនសូត្រ ទទួលបាន នូវ ចំណេះដឹង ដើម្បី ជួយ អភិវឌ្ឍន៍ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន ទៅ មុខ ជាលំដាប់ ក្រោម ការដឹកនាំ រាជ រដ្ឋាភិបាល កម្ពុជា ។
សម្តេច ក្រឡាម ហោម ក៏ បាន ផ្ដាំផ្ញើ ដល់ ក្មួយ ៗ សិស្សានុសិស្ស ទាំងអស់ ត្រូវ ខិតខំ សិក្សា រៀនសូត្រ ពេល ដែល ទទួលបាន អាគារ សិក្សា ថ្មី នេះ ហើយ នឹង ត្រូវ ចេះ ថែទាំ អគារ សិក្សា នេះ ឲ្យបាន គង់វង្ស យូរអង្វែង ដោយ ត្រូវ ចាត់ទុក ថា អាគារ សិក្សា ទាំង នេះ គឺជា របស់ ពួកយើង ទាំងអស់ គ្នា ។
សូម បញ្ជាក់ ផងដែរ ថា សមិទ្ធផល ដែល ត្រូវ ដាក់ សម្ពោធ នា ពេលនេះ មាន អគារ សិក្សា សាងសង់ ថ្មី ចំនួន ០៧ ខ្នង ស្មើនឹង ៣៩ បន្ទប់ និង ទី ចាត់ការ . ជួសជុល អគារ សិក្សា ចំនួន ០៨ ខ្នង ស្មើនឹង ៣៥ បន្ទប់ នឹង ជួសជុល អគារ អន្តេ វាសិកដ្ឋាន ០២ ខ្នង ស្មើនឹង ៣០ បន្ទប់ . អគារ លក់ដូរ នំ ចំណី ០២ ខ្នង និង សាងសង់ អគារ រដ្ឋបាល ឃុំ ចំនួន ០២ ខ្នង សរុប ថវិកា សាងសង់ ១. ០៣៦.៧៥១ ដុល្លារ ។ សមិទ្ធផល ខាងលើ ទាំងអស់ នេះ គឺ ស្ថិត នៅក្នុង ឃុំ ជា ច ឃុំ ក្រញូង ឃុំ ក្រ បៅ ឃុំ ស្មោង ខាងត្បូង ឃុំត្របែក ឃុំ សៀង ឃ្វាង និង ឃុំ ស្មោង ខាងជើង ។
ក្រោយ ផ្ទុះ ជំងឺ គ្រុន ផ្តាសាយ បក្សី នៅ វៀតណាម . អភិបាល ខេត្ត ស្វាយរៀង ប្រាប់ មន្ត្រី ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ បង្ការ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ គ្រុន ផ្ដាសាយ បក្សី
( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ខែកុម្ភៈ និង លើក ទិសដៅ បន្ដ របស់ រដ្ឋបាល ខេត្ត បាន ថ្លែង ប្រាប់ មន្ត្រី ដែល ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ បង្ការ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ គ្រុន ផ្តាសាយ បក្សី ដូចជា ការរឹតបន្តឹង នៅ តាម ច្រក ទ្វា នានា ជាមួយ ប្រទេស ជិតខាង ឲ្យ ខាងតែ បាន ។
ជាមួយគ្នា នេះ លោក ម៉ែន វិបុល ក៏ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ចំពោះ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង កងកម្លាំងប្រដាប់អាវុធ ក្នុង ខេត្ត ស្វាយរៀង ទាំងអស់ ដែល កន្លងមក បាន សហការ អនុវត្ត តួនាទី ភារកិច្ច របស់ ខ្លួន រួមចំណែក ធ្វើឲ្យ ខេត្ត រក្សា បាន នូវ ស្ថិរភាព នយោបាយ សន្ដិសុខ សុវត្ថិភាព សណ្ដាប់ធ្នាប់ សាធារណៈ ការផ្ដល់ សេវា សាធារណៈ និង ការដោះស្រាយ បញ្ហា ប្រឈម ផ្ដល់ ជា ប្រយោជន៍ ឆ្លើយតប ទៅនឹង សេចក្ដី ត្រូវការ របស់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ។
ទន្ទឹម នេះ លោក អភិបាល ខេត្ត បាន ផ្ដាំផ្ញើ ដល់ មន្ទីរ អង្គភាព រដ្ឋបាល ក្រុង ស្រុក កងកម្លាំងប្រដាប់អាវុធ និង អ្នក ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ត្រូវ បន្ត យកចិត្តទុកដាក់ ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ជាពិសេស យកចិត្តទុកដាក់ ទៅ លើ កត្តា ភូមិ - ឃុំ មាន សុវត្ថិភាព ឲ្យបាន ល្អ ប្រសើរ និង ត្រូវ ផ្សព្វផ្សាយ ដល់ ប្រជាពលរដ្ឋ ក្នុង ការថែរក្សា ទឹក ទុក ប្រើប្រាស់ ខណៈពេល ដែល បញ្ហា អាកាសធាតុ កំពុង កើនឡើង កម្តៅ ។
លោក បន្ត ថា ត្រូវ បន្ត ពង្រឹង ការអនុវត្ត ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ឲ្យបាន តឹងរឹង បំផុត ហើយ រដ្ឋបាល ក្រុង - ស្រុក និង អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ត្រៀមលក្ខណៈ ក្នុង ការសហការរៀបចំ ពិធី សង្ក្រាន្ត ស្វាយរៀង ដែល នឹង ចូល មកដល់ នៅ ខែមេសា ឆ្នាំ ២០២០ ខាងមុខ នេះ ព្រមទាំង មន្ទីរ អង្គភាព នានា ក្នុង ខេត្ត ត្រូវ ត្រៀមលក្ខណៈ រៀបចំ ទិវា សិទ្ធិ នារី អន្តរជាតិ ៨ មីនា ៕ អាជ្ញាធរ ជាតិ អប្សរា ត្រៀម រៀបចំ សង្ក្រាន្ត សៀមរាប ក្រោម ប្រធានបទ « អង្គ រ៖ អតីតកាល បច្ចុប្បន្ន និង អនាគត »
ទាក់ទង នឹង ប្រធានបទ « អង្គ រ៖ អតីតកាល បច្ចុប្បន្ន និង អនាគត » អាជ្ញាធរ ជាតិ អប្សរា នឹង ធ្វើ ពិព័រណ៍ បង្ហាញ ពី ការកំណាយ បុរាណវិទ្យា សមិទ្ធផល អាជ្ញាធរ ជាតិ អប្សរា និង ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ដែល នឹង ផ្តល់ ចំណេះដឹង ដល់ សាធារណជន បាន ស្គាល់ ពី បច្ចេកទេស នៃ ការប្រើប្រាស់ និង កែច្នៃ ថ្ម តាម បែប បុរាណ និង ទំនើប ការព្យាបាល ថ្ម ការសាងសង់ ប្រាសាទ ខ្មែរ ផែនទី តំបន់ អង្គរ និង ការស្រាវជ្រាវ បុរាណវិទ្យា ជាដើម ។
ការរៀបចំ សៀមរាប សង្ក្រាន្ត ក៏ មាន បញ្ចូល វប្បធម៌ ប្រពៃណី របស់ អ្នកស្រុក អង្គរ ការលេង ល្បែង ប្រជាប្រិយ ខ្មែរ ដើម្បី កម្សាន្ត សប្បាយ នៅក្នុង ពិធី ថែម ទៀត ពិសេស នឹង បង្ហាញ ពី ការដាប់ ឆ្លាក់ ចម្លាក់ សិប្បកម្ម ដែល សាធារណជន ក៏ អាច ចូលរួម ជាមួយ អ្នកជំនាញ និង ទិញ យក ទៅ ប្រើប្រាស់ បាន ដើម្បី លើ កម្ពស់ តម្លៃ សិល្ប ខ្មែរ និង ជីវភាព ប្រជាជន ផងដែរ ៕
បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ស្រុក របស់ អេស៉្បាញ មាន ភ្ញៀវ ប្រហែល១.០០០ នាក់ កំពុង ស្នាក់ នៅក្នុង សណ្ឋាគារ នោះ ។ ក្រសួង សុខាភិបាល ប្រទេស អេស៉្បាញ បាន ឲ្យដឹង ថា ពួកគេ នឹង ធ្វើតេស្ត រក មេរោគ COVID-19 ទៅ លើ ភ្ញៀវ ទេសចរ ព្រមទាំង បុគ្គលិក ដែល ស្ថិត ក្នុង សណ្ឋាគារ បន្ទាប់ពី ជនជាតិ អ៉ីតាលី ម្នាក់ ដែល ធ្លាប់ ស្នាក់ នៅ ទីនោះ ត្រូវ គេ ពិនិត្យ រកឃើញ ថា បាន ឆ្លង ជំងឺ នេះ ។
ជាមួយគ្នា នេះ វិទ្យាស្ថាន ប៉ាស្ទ័រ បាន អះអាង ថា លទ្ធផល នៃ ការធ្វើតេស្ត ជា បន្តបន្ទាប់ លើ មនុស្ស ដែល សង្ស័យ នៅក្នុង ប្រទេស កម្ពុជា បង្ហាញ ថា មិន មាន នរណា ម្នាក់ មាន មេរោគ COVID-19 ក្រៅពី ជនជាតិ ចិន ម្នាក់ ត្រូវបាន ព្យាបាល ជា នោះ ឡើយ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ វិទ្យាស្ថាន ប៉ាស្ទ័ រ៖
អភិបាល ខេត្ត ស្ទឹងត្រែង ជំរុញ ឲ្យ មន្រ្តី រាជការ ស៊ីវិល កងកម្លាំង នគរបាល ជាតិ និង រដ្ឋបាល គ្រប់ ថ្នាក់ នៅក្រោម ជាតិ
( ស្ទឹងត្រែង ) ៖ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ បាន រៀបចំ កិច្ចប្រជុំ សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០១៩ និង លើក ទិសដៅ ការងារ បន្ត ឆ្នាំ ២០២០ ក្រោម វត្តមាន លោក ម៉ុម សារឿន អភិបាល ខេត្ត និង លោក ឈាង់ ឡាក់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ។
លោក ម៉ុម សារឿន បាន ជំរុញ ដល់ មន្រ្តី រាជការ ស៊ីវិល កងកម្លាំង នគរបាល ជាតិ និង រដ្ឋបាល គ្រប់ ថ្នាក់ នៅក្រោម ជាតិ ត្រូវ បន្ត រួមគ្នា សម្រេច ឲ្យបាន នូវ ទិសដៅ ជា យុទ្ធសាស្ត្រ សំខាន់ ៗ ទាំង៤ នៅ ឆ្នាំ ២០២០ ដើម្បី សម្រេចបាន យុទ្ធសាស្រ្ត ចតុកោណ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ឆ្លាតវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ដាក់ចេញ និង ឲ្យ អនុវត្តន៍ ពិសេស កម្មវិធី កំណែទំរង់ របស់ រាជ រដ្ឋាភិបាល ។
ក្នុង នោះ ទិសដៅ ជា យុទ្ធសាស្ត្រ សំខាន់ ៗ ទាំង៤ សម្រេច ឲ្យបាន នៅ ឆ្នាំ ២០២០ មាន ដូច ជា៖
ខេត្ត ក្រចេះ ប្រារព្ធ ទិវា ជាតិ បង្ការ និង ពន្លត់ អគ្គិភ័យ លើក ទី៥
( ក្រចេះ ) ៖ រដ្ឋបាល ខេត្ត ក្រចេះ នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ បាន ប្រារព្វ ទិវា ជាតិ បង្ការ និង ពន្លត់ អគ្គិភ័យ លើក ទី៥ ឆ្នាំ ២០២០ ក្រោម វត្តមាន ចូលរួម ពី លោក ខ័ណ្ឌ ចំណាន អភិបាល រង ខេត្ត ក្រចេះ ។
លោក ក៏ បាន កោតសរសើរ ដល់ កងកម្លាំង នគរបាល ពន្លត់ អគ្គិភ័យ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ក្រចេះ និង កងរាជអាវុធហត្ថ ខេត្ត រួម និង អង្គភាព មួយចំនួន រួមទាំង វិស័យ ឯកជន ដែល បាន សហការ គ្នា ល្អ ក្នុង ការខិតខំ យកចិត្តទុកដាក់ ចូលរួម ជួយ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ គ្រោះ អគ្គិភ័យ បាន ទាន់ ពេលវេលា ៕
សាលា រាជធានី ភ្នំពេញ ត្រៀម ដេញថ្លៃ លើ ការផ្ដល់ សេវា ប្រមូល និង ដឹកជញ្ជូន សំរាម ចាប់ពី ថ្ងៃស្អែក នេះ ដល់ ថ្ងៃទី ២៨ ខែកុម្ភៈ
តាម លិខិត របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា រដ្ឋបាល រាជធានី ភ្នំពេញ កំពុង រៀបចំ ឯកសារ និង នីតិវិធី ដេញថ្លៃ ជ្រើសរើស ក្រុមហ៊ុន ផ្ដល់ សេវា ប្រមូល និង ដឹកជញ្ជូន សំរាម សំណល់ វឹង នៅ រាជធានី ភ្នំពេញ ប្រកបដោយ តម្លាភាព និង ប្រសិទ្ធភាព តាម លក្ខណៈ ស្ដង់ដា អន្ដរជាតិ ស្រប តាម ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ដ ជាធរមាន របស់ កម្ពុជា ។
ក្នុង ដំណើរការ លទ្ធកម្ម នេះ នឹង ត្រូវ ធ្វើឡើង ជា ០២ ដំណាក់កាល ផ្សេងគ្នា ក្នុង នោះ ក្រុមហ៊ុន ដែល ទទួលបាន ការជ្រើសរើស ក្នុង ដំណាក់កាល ទី១ និង មាន សិទ្ធិ ចូលរួម ដេញថ្លៃ បន្ដ ក្នុង ដំណាក់កាល ទី២ ( ដំណាក់កាល លទ្ធកម្ម ) ។ រាជធានី ភ្នំពេញ ត្រូវបាន ចែកចេញ ជា ០៤ តំបន់ សម្រាប់ ឲ្យ ក្រុមហ៊ុន ធ្វើ ការជ្រើសរើស ក្នុង ការផ្ដល់ សេវា ប្រមូល និង ដឹកជញ្ជូន សំរាម សំណង់ រឹង ទៅ តាម តំបន់ នីមួយ ៗ ។
សូម បញ្ជាក់ ថា មុន បើក កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី កាលពី ពេល ថ្មី ៗ កន្លងទៅ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ប្រកាស ក្រោយ ដក សិទ្ធិ ប្រមូល សំរាម ពី ក្រុមហ៊ុន ស៉ិន ទ្រី ហើយ នៅពេល រដ្ឋ គ្រប់គ្រង មាន ស្ថិរភាព នោះ រដ្ឋ នឹង ធ្វើ ការជ្រើសរើស ក្រុមហ៊ុន ផ្សេង គ្នា ចំនួន ៤ ដើម្បី ប្រមូល សំរាម ក្នុង រាជធានី ភ្នំពេញ ដោយ ចែកចេញ ជា៤ តំបន់ ។ ចំណែក ថ្លៃ សំរាម ក៏ ត្រូវ ដក ចេញពី វិក្កយបត្រ អគ្គិសនី ផងដែរ ។
យោង ទៅតាម ការិយាល័យ គ្រប់គ្រង ថវិកា ជាតិ អាមេរិក បាន ឲ្យដឹង ថា ទឹកប្រាក់ ចំនួន ១ពាន់ លាន ដុល្លារ នឹង ត្រូវ ប្រើប្រាស់ សម្រាប់ ការផលិត វ៉ាក់សាំង ប្រឆាំង នឹង មេរោគ COVID-19 ខណៈ ថវិកា ដែល នៅសល់ នឹង ត្រូវ ចំណាយ លើ ការគាំទ្រ ដល់ សកម្មភាព និង ការឆ្លើយតប នានា ក៏ ដូចជា ការផ្គត់ផ្គង់ ផ្នែក សំភារៈ បរិក្ខា ពេទ្យ ជាដើម ។
ក្រុម ជំនាញ សុខភាព សាធារណៈ របស់ សហរដ្ឋ អាមេរិក គឺជា អ្នក ដែល បាន ជំរុញ ឲ្យ សេតវិមាន ស្នើសុំ ថវិកា ជំនួយ បន្ទាន់ បែប នេះ ខណៈ បច្ចុប្បន្ន នៅ អាមេរិក បាន រកឃើញ អ្នក ឆ្លង COVID-19 ជាង ៥០ ករណី ។ ទោះជា យ៉ាងណា ការស្នើសុំ កញ្ចប់ ថវិកា ខាងលើ ពីសំណាក់ សេតវិមាន ទៅកាន់ សភា អាមេរិក នេះ គឺ មាន ចំនួន តិច ជាង ឆ្ងាយ ណាស់ បើ ប្រៀបធៀប នឹង ចំនួន ដែល បាន ស្នើសុំ កាលពី ឆ្នាំ ២០១៤ ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ការរាត ត្បាត ជំងឺ អេបូឡា ដែល កាល ណោះ មាន រហូតដល់ ៦.២ ពាន់ លាន ដុល្លា អាមេរិក ឯណោះ ៕
លោក Mubarak គឺជា អតីត មេដឹកនាំ ដ៏ ល្បីល្បាញ មួយ រូប ប្រចាំ ពិភព អារ៉ាប់ ដែល បាន កាន់អំណាច នៅ អេហ្ស៊ីប រយៈពេល ដល់ ទៅ ៣២ ឆ្នាំ ហើយ លោក ត្រូវបាន ទម្លាក់ ចេញ ពី តំណែង កាលពី ឆ្នាំ ២០១១ នៅក្នុង ចលនា រំជើបរំជួល ដ៏ ធំ មួយ នា គ្រា នោះ ។ ក្រោយ ការទម្លាក់ ចេញ ពី តំណែង លោក ត្រូវបាន រដ្ឋាភិបាល ថ្មី ចាប់ខ្លួន និង យក ទៅ កាត់ទោស ពី បទបញ្ជា ឲ្យ កងកម្លាំង បង្ក្រាប និង សម្លាប់ ក្រុម បាតុករ ដែល ប្រឆាំង លោក ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន បញ្ជាក់ បែប នេះ ក្នុង សន្និសីទ ព័ត៌មាន បង្ហាញ វិធានការ ដោះស្រាយ បញ្ហា ប្រឈម លើ វិស័យ ទេសចរណ៍ និង ឧស្សាហកម្ម ដោយសារ ជំងឺ ផ្លូវ ដង្ហើម បណ្តាល មកពី មេរោគ «COVID19» នៅ ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ។
ក្នុង សន្និសីទ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន លើក យក វិស័យ ពីរ ដែល កំពុង ប្រើ ប្រព័ន្ធ បច្ចេកវិទ្យា មក បង្ហាញ ។ វិស័យ ទាំង ពីរ កំពុង ប្រើ ប្រព័ន្ធ បច្ចេកវិទ្យា ដើម្បី រួមចំណែក បង្កើន ថវិកា ជាតិ ដែល សម្តេច តេជោ បាន លើក មក បង្ហាញ នេះ រួម មាន ការប្រមូល ពន្ធ និង ការទិញ ផ្លាកលេខ រថយន្ត ។
ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន គូសបញ្ជាក់ ថា ការប្រមូល ពន្ធ នា ពេល បច្ចុប្បន្ន បាន ប្រើ ប្រព័ន្ធ បច្ចេកវិទ្យា ក្នុង ការប្រមូល ពន្ធ ។ តាមរយៈ ប្រព័ន្ធ បច្ចេកវិទ្យា ធ្វើឱ្យ ការប្រមូល ពន្ធ មាន សុក្រឹត្យភាព តម្លាភាព និង មិន បាត់ ចំណូល ពន្ធ ទៀត នោះ ឡើយ ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន គូសបញ្ជាក់ ថា កម្ពុជា រក ចំណូល ពី ពន្ធ គយ និង ពន្ធដារ ក្នុង មួយ ខែ ប្រមាណ ២៥០ លាន ដុល្លារ អាមេរិក ហើយ ខែ ខ្លះ ឡើង ដល់ ទៅ ៣០០ លាន ដុល្លារ អាមេរិក ។ នៅ ឆ្នាំ ២០១៩ កន្លងទៅ កម្ពុជា ទទួលបាន ចំណូល ពី ការប្រមូល ពន្ធ ប្រមាណ ជា ៦ពាន់ លាន ដុល្លារ អាមេរិក ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន លើក សរសើរ ពី ការប្រើប្រាស់ ប្រព័ន្ធ បច្ចេកវិទ្យា ក្នុង ការចុះបញ្ជី រថយន្ត និង ទិញ ផ្លាកលេខ រថយន្ត របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ផងដែរ ។ សម្តេច តេជោ បាន គូសបញ្ជាក់ ថា ការធ្វើ ទំនើបកម្ម លើ ការផ្តល់ សេវា ចុះបញ្ជី រថយន្ត និង ទិញ ផ្លាកលេខ រថយន្ត នេះ បាន សម្រួល ដល់ ម្ចាស់ រថយន្ត ហើយ បាន ជួយ បង្កើន ចំណូល ជាតិ ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បន្ទាប់ពី បាន ចូលមក គ្រប់គ្រង ក្រសួង សាធារណការ និង ដឹកជញ្ជូន កាលពី ឆ្នាំ ២០១៦ បាន ដាក់ចេញ នូវ កំណែទម្រង់ លើ ការផ្តល់ សេវា របស់ ក្រសួង ជាច្រើន ។ លោក រដ្ឋមន្ត្រី បាន ព្យាយាម ធ្វើ ទំនើបកម្ម សេវា ដោយ ច្របាច់ បញ្ចូល ជាមួយ ប្រព័ន្ធ បច្ចេកវិទ្យា ។
ការចុះបញ្ជី រថយន្ត និង ធ្វើ ផ្លាក លេខ យានយន្ត ជា បញ្ហា ដ៏ ស្មុគស្មាញ មួយ នៅក្នុង ក្រសួង ។ បន្ទាប់ពី ប្រព័ន្ធ ស្វ័យប្រវត្តកម្ម នៃ ការចុះបញ្ជី រថយន្ត យន្ត ត្រូវបាន ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ឆ្នាំ ២០១៧ បញ្ហា ស្មុគស្មាញ ជាច្រើន ត្រូវបាន លុបបំបាត់ ។ ប្រព័ន្ធ ស្វ័យប្រវត្តកម្ម នេះ មិន ត្រឹមតែ លុបបំបាត់ បញ្ហា ស្មុគស្មាញ លើ ការចុះបញ្ជី និង ធ្វើ ផ្លាក លេខ រថយន្ត ប៉ុណ្ណោះ ទេ តែ ក៏ បាន ជួយ បង្កើន ចំណូល ពី ការលក់ ផ្លាកលេខ ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ឱ្យដឹង ថា ក្រោយពី ដាក់ ឱ្យ ដំណើរការ ប្រព័ន្ធ ស្វ័យប្រវត្តិកម្ម នេះ ក្រសួង ទទួលបាន លទ្ធផល ល្អ ប្រសើរ និង រក ថវិកា ពី ការលក់ លេខ ពិសេស ជាង ៣២ លាន ដុល្លារ អាមេរិក គិត ត្រឹម ឆ្នាំ ២០១៩ ។
បន្ថែម ពីលើ នេះ ក្រសួង ក៏ បាន ដាក់ ឱ្យ ដំណើរការ ប្រព័ន្ធ ស្វ័យប្រវត្តិកម្ម លក់ លេខ ពិសេស ផ្ទាល់ខ្លួន បន្ថែម ទៀត នៅ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២០ ។ ការដាក់ លក់ លេខ ពិសេស ផ្ទាល់ខ្លួន នេះ គឺជា ការផ្តល់ លទ្ធភាព បន្ថែម ឱ្យ ប្រជាពលរដ្ឋ ស្វែងរក លេខ សម្គាល់ យានជំនិះ តាម ការចង់បាន របស់ ខ្លួន ហើយ អាច កាន់កាប់ ពេញ មួយ ជីវិត និង បន្ត ទៅដល់ កូន ចៅ ផងដែរ ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ចាប់ពី ថ្ងៃ ដាក់ លក់ ជា ផ្លូវការ រហូតដល់ ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២០ ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន នេះ លក់ បាន ៤៣៤ ផ្លាក ហើយ ទទួលបាន ថវិកា ជា ចំណូល សម្រាប់ ជាតិ ជិត ២លាន ដុល្លារ អាមេរិក ។
( កណ្ដាល ) ៖ ផ្លូវ លំ មួយ ខ្សែ ដែល តភ្ជាប់ ពី ផ្លូវ លេខ ១១៣ ទៅ ផ្លូវ លេខ ១១៤ ស្ថិត នៅ ភូមិ ព្រែក សំរោង សង្កាត់ - ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ត្រូវបាន អ្នក មាន ផ្ទះ រស់ នៅ ជាប់ ក្បាល ផ្លូវ លំ នេះ បិទ ធ្វើរការ រំលោភបំពាន យក ដើម្បី ធ្វើជា កម្មសិទ្ធិ ធ្វើអោយ ប្រជាពលរដ្ឋ ដែល ប្រើប្រាស់ ផ្លូវលំ នេះ ប្ដឹង ស្នើសុំ ទៅ សម្ដេច តេជោ ហ៊ុន សែន ជួយ អន្តរាគមន៍ បាន បើក ផ្លូវ លំ នេះ អោយ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ជាសាធារណៈ ឡើងវិញ ។
តំណាង ប្រជាពលរដ្ឋ ដែល ប្ដឹង ទាមទារ សុំ បើក ផ្លូវ លំ នេះ ឡើងវិញ បាន រៀបរាប់ ថា ផ្លូវ លំ នេះ គឺ មាន តាំងពី សង្គម ចាស់ មក ម្ល៉េះ តែ មកដល់ ឆ្នាំ ២០០៥ ស្រាប់តែ មាន ប្រជាជន មួយ គ្រួសារ ដែល មាន ផ្ទះ នៅ ជាប់ ផ្លូវលំ នេះ បាន រំលោភបំពាន យក ជា បន្តបន្ទាប់ រហូតដល់ រត់ ការសុំ ធ្វើ បណ្ណ កម្មសិទ្ធិ ដាក់ ឈ្មោះ កូន របស់ ខ្លួន ទៀតផង ។
ចំណែក មន្ត្រី អាជ្ញាធរ ភូមិ សង្កាត់ ក្រុង តាខ្មៅ និង ខេត្ត កណ្ដាល ទោះជា ពួកគាត់ ប្ដឹង សុំ អន្តរាគមន៍ ជួយ ទប់ស្កាត់ និង ទាមទារ អោយ បើក ផ្លូវ លំ នេះ ជា ផ្លូវ សាធារណៈ ឡើងវិញ យ៉ាងណា ក៏ គ្មាន ប្រសិទ្ធភាព ដែរ ។
ខាងក្រោម នេះ ជា ពាក្យបណ្ដឹង របស់ ប្រជាពលរដ្ឋ ដែល ស្នើសុំ អន្តរាគមន៍ ពី សម្ដេច តេជោ ហ៊ុន សែន ដើម្បី បាន បើក ផ្លូវ លំ នេះ ឡើងវិញ៖
ប្រកាស ចូលកាន់ តំណែង ព្រះរាជអាជ្ញា ថ្មី ខេត្ត កំពង់ធំ . លោក ស៊ិន វិរៈ ជំនួស លោក អ៊ិត សុធា ដែល ផ្លាស់ ទៅកាន់ ជា ព្រះរាជអាជា្ញ ខេត្ត កំពង់ឆ្នាំង
( កំពង់ធំ )៖ រសៀល ថ្ងៃ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ លោក អង្គ វង្ស វឌ្ឍានា រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៌ បាន អញ្ជើញ ជា អធិបតី ប្រកាស ចូលកាន់ តំណែង ព្រះរាជអាជ្ញា ថ្មី នៃ អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ធំ ដោយ លោក ស៊ិន វិរៈ ជំនួស លោក អ៊ិត សុធា ដែល ផ្លាស់ ទៅកាន់ ជា ព្រះរាជអាជា្ញ នៃ អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ លោក ឈុន ឈន់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ប្រតិភូ អម ដំណើរ កងកម្លាំង មន្ត្រីរាជា ការប្រមាណ ជា ៣០០ នាក់ ផងដែរ ។
សូម បញ្ជាក់ ថា លោក ស៊ិន វិរៈ ធ្លាប់ កាន់ តួនាទី ជា ព្រះរាជអាជ្ញា រង អម សាលាដំបូង រាជធានី ភ្នំពេញ រយៈពេល ប៉ុន្មាន ឆ្នាំ មកហើយ មុន ផ្លាស់ ទៅជា ព្រះរាជអាជ្ញា ខេត្ត កំពង់ធំ នៅ ពេល នេះ ៕
ទោះជា យ៉ាង នេះ ក្តី នៅ ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២០ លោកស្រី ឧប នាយក រដ្ឋមន្រ្តី ម៉ាឡេស៊ី ដដែល បាន ចេញមក ប្រកាស ជាថ្មី ថា ស្រ្តី ជនជាតិ អាមេរិក វ័យ ៨៣ ឆ្នាំ នោះ មិន មាន មេរោគ កូរ៉ូណា ទៀត ទេ បន្ទាប់ពី ព្យាបាល អស់ រយៈពេល ខ្លី ។
សម្តេច តេជោ បាន សម្តែង ការសោកស្តាយ ចំពោះ ឥរិយាបទ របស់ ម៉ាឡេស៊ី គឺ លោកស្រី ឧប នាយក រដ្ឋមន្រ្តី ម៉ាឡេស៊ី ដែល ជា ប្រពន្ធ របស់ លោក អាន វ៉ា អ៉ីប្រាហ៉ីម ដែល បាន ចេញមក ប្រកាស ថា ស្រ្តី ម្នាក់ ជនជាតិ អាមេរិក អាយុ ៨៣ ឆ្នាំ មាន ឆ្លង វីរុស កូរ៉ូណា ថ្មី បង្កឱ្យ មាន ការភាន់ច្រឡំ និង ភ្ញាក់ផ្អើល ដល់ ពិភពលោក ។ សម្តេច បាន ចាត់ទុក ថា ការប្រកាស ដោយ មិន ច្បាស់លាស់ នេះ បាន ដាក់បន្ទុក ឱ្យ កម្ពុជា ខាតបង់ កិត្តិយស និង សេចក្តីថ្លៃថ្នូរ របស់ ជាតិ ដែល ពលរដ្ឋ កម្ពុជា មិន ចាត់ទុក ថា រឿង នេះ ស្រាល ទេ នោះ ទេ ។
សម្តេច ក៏ បាន បញ្ជាក់ ទៀត ថា ដោយសារ ការប្រកាស បែប នេះ របស់ ម៉ាឡេស៊ី បាន ធ្វើឱ្យ ប្រទេស មួយចំនួន មិន ទទួលយក អ្នកដំណើរ តាម នាវា Westerdam ដែល ចេញ ពី កម្ពុជា ឡើយ ហើយ ដោយសារតែ ការប្រកាស របស់ ម៉ាឡេស៊ី ទើប ធ្វើឱ្យ មាន អ្នក នៅលើ នាវា ត្រូវយឺតយ៉ាវ ក្នុង ការត្រឡប់ ទៅ ផ្ទះ វិញ ។
លោក សរសេរ ថា៖ « ទំនាក់ទំនង អន្តរជាតិ គឺជា សិល្បៈ តម្រូវឲ្យ មេដឹកនាំ មាន ទេពកោសល ខ្ពស់ ដ្បិត ដើម្បី មុខមាត់ ជាតិ ដើម្បី ប្រយោជន៍ ជាតិ ដើម្បី កុំ ឲ្យ មិត្ត អន់ចិត្ត និង ដើម្បី កុំ ឲ្យ សត្រូវបាន ដៃ មេដឹកនាំ ត្រូវ ចេះ សម្រេចចិត្ត រហ័ស ចំកាលៈទេសៈ ត្រូវ ចេះ បត់បែន ត្រូវ ចេះ ហារ មាត់ បន្ទរ សំឡេង ខ្លាំង ៗ ឬ ហ៊ាន ចេញមុខ សុំទោស ទាន់ ពេលវេលា » ។
មន្ត្រី សាខា កាកបាទ ចំនួន ០៧ ខេត្ត ពង្រឹង ចំណេះដឹង តម្រង់ ទិស ស្ដីពី នីតិវិធី រដ្ឋបាល - ហិរញ្ញកិច្ច ផែនការ ពិនិត្យ តាមដាន វាយតម្លៃ និង របាយការណ៍
សិក្ខាសាលា នេះ នឹង ប្រព្រឹត្តទៅ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៥ ដល់ ថ្ងៃទី ២៧ ខែកុម្ភ : ឆ្នាំ ២០២០ ក្រោម ការជួយ ទ្រទ្រង់ ថវិកា ពី កាកបាទ ក្រហម ហ្វាំងឡង់ និង ថវិកា បដិភាគ របស់ សាខា កាកបាទ ក្រហម ខេត្ត ត្បូងឃ្មុំ ប្រមាណ ២០% ។ សិក្ខាសាលា នេះ ធ្វើឡើង ក្នុង គោលបំណង ពង្រឹង សមត្ថភាព សាខា និង បណ្តា អនុសាខា លើ នីតិវិធី រដ្ឋបាល ហិរញ្ញកិច្ច ការងារ ផែនការ ការពិនិត្យ តាមដាន ការវាយតម្លៃ និង របាយការណ៍ ក៍ ដូចជា ការពង្រឹង ប្រព័ន្ធ តាមដាន រាយការណ៍ អំពី គ្រោះមហន្តរាយ នានា ដែល កើត មាន ឡើង នៅក្នុង សហគមន៍ មូលដ្ឋាន ។
ជា ចុងក្រោយ លោក ហាក់ សុខ មករា ក៍ បាន ណែនាំ ផ្តាំផ្ញើ ឲ្យ សិក្ខាកាម ទាំងអស់ ខិតខំ យកចិត្តទុកដាក់ ក្រេប យក ចំណេះដឹង ពី សិក្ខាសាលា នេះ យក ទៅ អនុវត្ត នៅ បណ្តា ក្រុង ស្រុក និង ខេត្ត រៀង ៗ ខ្លួន ឲ្យបាន ល្អ ប្រសើរ ផងដែរ ៕
ការកើនឡើង នៃ ករណី ឆ្លង ថ្មី ជំងឺ COVID-19 នៅ ក្រៅ ប្រទេស ចិន កំពុង បង្ក ការភ័យខ្លាច នៅក្នុង ចំណោម ក្រុម អ្នក វិនិយោគ ដែល បារម្ភ ខ្លាចក្រែង ការរីករាលដាល កាន់តែ ខ្លាំង នៃ ជំងឺ នេះ អាចនឹង ធ្វើឱ្យ ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច សកលលោក ។
គណៈកម្មការ ទី៨ រដ្ឋសភា ជួបប្រជុំ ពិភាក្សា ការងារ ជាមួយ រដ្ឋបាល ខេត្ត សៀមរាប និង មន្ទីរ អង្គភាព ស្ថាប័ន ពាក់ព័ន្ធ ជុំវិញ ខេត្ត
( សៀមរាប ) ៖ លោកស្រី ឡោក ខេង ប្រធាន គណៈកម្មការ សុខាភិបាល សង្គមកិច្ច អតីត យុទ្ធជន យុវនីតិសម្បទា ការងារ បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង កិច្ចការ នារី នៃ រដ្ឋសភា និង អនុប្រធាន លេខាធិការ សមាជិក សមាជិកា គណៈកម្មការ ទី៨ នៃ រដ្ឋសភា បាន ជួបប្រជុំ ពិភាក្សា ការងារ ជាមួយ លោក ទៀ សីហា អភិបាល ខេត្ត សៀមរាប . លោក អ៊ាន ឃុន ប្រធាន ស្តីទីក្រុមប្រឹក្សា ខេត្ត និង គណៈ អភិបាល ខេត្ត ប្រធាន មន្ទីរ ជំនាញ ពាក់ព័ន្ធ វិស័យ ទទួលបន្ទុក របស់ គណៈកម្មការ ទី៨ នៃ រដ្ឋសភា ។
កិច្ចប្រជុំ បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ២០២០ នា សាលា ខេត្ត សៀមរាប មាន គោលបំណង ដើមី្ប សិក្សា ស្វែងយល់ ពី វឌ្ឍនភាព និង បញ្ហា ប្រឈម នានា ក្នុង ការបំពេញ ភារកិច្ច របស់ រដ្ឋបាល ខេត្ត នា ពេល កន្លងមក ដែល ពាក់ព័ន្ធ នឹង វិស័យ ទទួលបន្ទុក របស់ គណ:កម្ម ការ ទី៨ នៃ រដ្ឋសភា សំខាន់ គឺ យន្តការ ក្នុង ការប្រើប្រាស់ ប័ណ្ណ បេឡា ជាតិ របប សន្តិសុខ សង្គម ( ប.ស. ស ) និង ប័ណ្ណ សមធម៌ របស់ កម្មករ និង កម្ម ការិនី ប្រជាពលរដ្ឋ ក្រីក្រ និង មន្រ្តី រាជការ អតីត យុទ្ធជន ។
លោកស្រី ឡោក ខេង បាន ធ្វើ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ លើ ការផ្តល់ សេវា សុខាភិបាល នៅ មណ្ឌល សុខភាព គោក ចក និង មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប ជូន ដល់ ប្រជាពលរដ្ឋ បាន ល្អ ។ ក្នុង នោះ ដែរ លោកស្រី និង ប្រតិភូ បាន ធ្វើ ការវាយតម្លៃ ខ្ពស់ ទៅ លើ របាយការណ៍ របស់ រដ្ឋបាល ខេត្ត បាន លើកឡើង អំពី លទ្ធផល របស់ សាម៉ី មន្ទីរ ពាក់ព័ន្ធ ទាំង៤ របស់ ខេត្ត សៀមរាប ។
លោកស្រី ក៏ បាន ផ្តោត សំខាន់ ក្នុង វិស័យ សុខាភិបាល សំខាន់ បញ្ហា សុខភាព គឺ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ បំផុត ចំពោះ ជំងឺ មិន ឆ្លង ដែល ជា បញ្ហា ចំបង នោះ ( ថ្នាំជក់ និង គ្រោះថ្នាក់ ចរាចរណ៍ ) ដែល ធ្វើឱ្យ សង្គមជាតិ ទាំងមូល មាន ការព្រួយបារម្ភ យ៉ាង ខ្លាំង នា ពេល បច្ចុប្បន្ន នេះ ។ ក្នុង នោះ ប្រតិភូ ក៏ បាន មាន ចំណាប់អារម្មណ៍ ផងដែរ ចំពោះ សំណង់ អគារ នៃ មន្ទីរពេទ្យ បង្អែក ខេត្ត ដែល មាន អគារ ចាស់ ៗ ទាប ៗ មាន សភាព ទ្រុឌទ្រោម ដែ ធ្វើឱ្យ បាត់ នូវ សោភណ្ឌភាព ក្នុង មន្ទីរពេទ្យ ។
លោកស្រី ក៏ បាន លើកឡើង ចំពោះ គ្រប់ បណ្តា ឃុំ សង្កាត់ តើ បាន បង្កើត ឱ្យ មាន សមាគមន៍ មនុស្ស ចាស់ ហើយ ឬ នៅ ? ពីព្រោះថា មនុស្ស ចាស់ ៗ នេះ ហើយ ដែល ជា រៀបច្បង នៃ ធនធាន មនុស្ស ដែល យើង ត្រូវ យកចិត្តទុកដាក់ ចំពោះ ពួកគាត់ ទោះបី គាត់ គ្មាន កម្លាំង ក៏ ពិត មែន តែ គំនិត បញ្ញា របស់ គាត់ គឺ ផ្តល់ ជា ប្រឹក្សា ដល់ យើង ជំនាន់ ក្រោយ ផងដែរ ។
( ត្បូងឃ្មុំ ) ៖ ជ្រក់ ម មាញ មាន សារធាតុ គីមី ហាមឃាត់ អាស៊ីត សាលី សាលិក ចំនួន ០៣ គីឡូក្រាម និង ភេសជ្ជៈ ទឹក ផ្លែ ឈើ ចំនួន ១២ដប ហួស កាលបរិច្ឆទ ប្រើប្រាស់ ត្រូវបាន មន្ត្រី កាំ កុងត្រូល ខេត្ត ត្បូងឃ្មុំ ពិនិត្យ រកឃើញ និង ដកហូត ភ្លាម ៗ ពី អាជីវករ លក់ដូរ ក្នុង ផ្សារ មេមត់ ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ។ ដោយឡែក ចំពោះ គំរូ ផលិតផល ត្រី ប្រឡាក់ និង ត្រី ងៀត ពុំ ឃើញ មាន វត្តមាន សារធាតុ គីមី ហាម ឃាត់ ទេ ។
សកម្មភាព រកឃើញ ខាង លើ នេះ ធ្វើឡើង នា ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ បន្ទាប់ពី លោក មាស មោរ៉ា ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ត្បូងឃ្មុំ ដឹក មន្ត្រី កាំ កុងត្រូល សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត បន្ត ចុះ ត្រួតពិនិត្យ គុណភាព សុវត្ថិភាព ម្ហូប អាហារ នៅ ផ្សារ មេមត់ ដើម្បី ត្រួតពិនិត្យ ស្លាកសញ្ញា រួមទាំង កាលបរិច្ឆេទ ផុត កំណត់ ប្រើប្រាស់ លើ ផលិតផល គ្រឿង ឧបភោគ បរិភោគ និង ធ្វើតេស្ត លើ គំរូ ផលិតផល មួយចំនួន ។
លោក មាស មោរ៉ា ថ្លែង បញ្ជាក់ ថា សកម្មភាព បន្ត ចុះ ត្រួតពិនិត្យ ស្លាកសញ្ញា រួមទាំង កាលបរិច្ឆេទ ផុត កំណត់ ប្រើប្រាស់ និង សីតុណ្ហភាព តាម លក្ខខណ្ឌ តម្រូវ លើ ផលិតផល ប្រហិត ក្លាស្សេ នាំចូល និង ត្រួតពិនិត្យ គុណភាព គ្រឿង ឧបភោគ បរិភោគ ផ្សេង ទៀត ព្រមទាំង ធ្វើតេស្ត លើ គំរូ ផលិតផល ជ្រក់ មួយចំនួន ដូចជា ជ្រក់ មមាញ ជ្រក់ ស្ពៃ ជ្រក់ ត្រសក់ ជាដើម ។
ក្រៅពី នោះ មន្ត្រី កាំ កុងត្រូល បាន បិទ ស្លាក ដែល មាន ខ្លឹមសារ អប់រំ ដើម្បី យល់ដឹង អំពី ការជ្រើសរើស ម្ហូប អាហារ ប្រកបដោយ គុណភាព និង សុវត្ថិភាព ព្រមទាំង ពន្យល់ ណែនាំ ដល់ អាជីវករ ឱ្យ មាន ការយកចិត្តទុកដាក់ និង ប្រុងប្រយ័ត្ន ក្នុង ការដាក់ តាំង លក់ ទំនិញ ដោយ ជៀសវាង រាល់ ទំនិញ គ្មាន ស្លាកសញ្ញា ត្រឹមត្រូវ គ្មាន ប្រភព ច្បាស់លាស់ ពិសេស ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ ដែល ខុសពី បទបញ្ញត្តិ នៃ ច្បាប់ ៕
ឃាតកម្ម ! បុរស ម្នាក់ ត្រូវ ឃាតក ចង ជើង និង ចាក់ សម្លាប់ នៅក្នុង ខណ្ឌ កំបូល
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ចំនួន ៤នាក់ បាន នាំគ្នា ទៅដក ក្រអៅ ឈូក និង បាច ត្រី នៅក្នុង ស្រែ ដាំ ឈូក មួយ កន្លែង ស្រាប់តែ ប្រទះឃើញ សព បុរស មិន ស្គាល់ អត្តសញ្ញាណ ម្នាក់ នៅក្នុង ទឹក ឈូក នោះ ដែល ត្រូវ ឃាតក ចង ជើង ទាំង២ជាប់ គ្នា រួច ចាក់ ទម្លុះ បំពង់ ក សម្លាប់ ចោល ។
បន្ទាប់មក ពួកគាត់ បាន នាំគ្នា រត់ ទៅ ប្រាប់ ដល់ អ្នកភូមិ ជាមួយគ្នា បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល ព្រមទាំង បាន រាយការណ៍ ជូន សមត្ថកិច្ច ឲ្យ ចុះ ទៅកាន់ ទីតាំង កើត ហេតុ នោះ ភ្លាម ៗ ដែរ ។
ហេតុការណ៍ ភ្ញាក់ផ្អើល នោះ បាន កើតឡើង កាលពី វេលា ម៉ោង ៩៖៣០ នាទី ព្រឹក ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នៅក្នុង ទឹក ទឹក ស្រែ ដាំ ឈូក ក្នុង ភូមិ ទួល តាឡាត់ សង្កាត់ កំបូល ខណ្ឌ កំបូល រាជធានី ភ្នំពេញ ។
