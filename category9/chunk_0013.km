( ភ្នំពេញ ) ៖ ជាមួយនឹង ពេលវេលា ដ៏ លំបាក ដែល កំពុង ជះឥទ្ធិពល ដល់ ប្រទេស កម្ពុជា និង តំបន់ អាស៊ី ដទៃ ទៀត ដែល អាច ធ្វើឱ្យ សេដ្ឋកិច្ច ជាតិ ធ្លាក់ចុះ បន្តិច នោះ ក្រុមហ៊ុន រថយន្ត MG បាន ជំរុញ ទំនុកចិត្ត ដល់ គ្រួសារ កម្ពុជា ក្នុង គោលបំណង ការផ្តល់ ជូន ភាព ដ៏ ទាក់ទាញ នៅក្នុង សាមគ្គីភាព របស់ ប្រជាពលរដ្ឋ កម្ពុជា តាមរយៈ ការបើក យុទ្ធនាការ ការទិញ ទំនិញ ប្រកបដោយ សុវត្ថិភាព ។
ក្រុមហ៊ុន MG ដឹង ថា ការទិញ រថយន្ត នៅលើ ទីផ្សារ ដោយ គ្មាន ការធានា ត្រឹមត្រូវ អាច នាំឱ្យ មាន បញ្ហា ធំ សម្រាប់ ម្ចាស់ រថយន្ត ទាំងអស់ ។ នោះ ហើយ ជា មូលហេតុ ដែល ក្រុមហ៊ុន MG ចង់ ផ្តល់ ជូន អតិថិជន ទាំងអស់ ជាមួយនឹង ការបន្ថែម ការធានា ថ្មី រួមទាំង តម្លៃ លក់ ដ៏ ពិសេស របស់ រថយន្ត MG RX8 ផងដែរ ។ ការដក EBA ធ្វើឱ្យ ប្រទេស កម្ពុជា ស្ថិត ក្នុង ស្ថានភាពតានតឹង ប៉ុន្តែ វា មិន ទាន់ ដាច់ស្រេច នោះ ទេ ។
ក្រុមហ៊ុន MG នឹង ត្រៀមខ្លួន ដើម្បី ពិភាក្សា ជាមួយ អតិថិជន របស់ ខ្លួន នៅ ពេល ដែល បាន យល់ ពី ការព្រួយបារម្ភ របស់ ពួកគេ សម្រាប់ រយៈពេល ១២ ខែ បន្ទាប់ នេះ ហើយ ពួកគេ នឹង មាន អារម្មណ៍ ថា វិស័យ ឯកជន បាន ជួយ ដល់ សេដ្ឋកិច្ច ក្នុង ការងើប ឡើងវិញ តាមរយៈ ការខិតខំ ប្រឹងប្រែង សម្របសម្រួល នៃ តម្លៃ ទំនិញ ។
( កំពង់ឆ្នាំង ) ៖ មុខរបរ ឡើង ត្នោត តាំងពី បុរាណ រហូតដល់ បច្ចុប្បន្ន នៅតែ ជា មុខរបរ មួយ យ៉ាង សំខាន់ របស់ ប្រជាកសិករ ខ្មែរ យើង នៅ តាម ស្រុក ស្រែ ចម្ការ ។ មុខរបរ នេះ ផងដែរ គឺ បាន បន្សល់ទុក តាំងពី សម័យ ដូន តាម កបើ ទោះជា បច្ចុប្បន្ន នៅ តាម ទីផ្សារ សម្បូរ ទៅ ដោយ ស្ករ ស ឬ ស្ករ អំពៅ យ៉ាងណា ក៏ដោយ ។
ជាក់ស្តែង តម្រូវការស្ក ត្នោត ធម្មជាតិ របស់ ខ្មែរ យើង នៅតែ ជា តម្រូវ ការចាំបាច់ ដោយ មិន អាច ខ្វះ បាន ដែល ធ្លាប់ ហូប ស្ករ ត្នោត ក្នុង ការចម្អិន អាហារ និង យក ទៅ ធ្វើ បង្អែម ផ្សេង ៗ ផងដែរ ។
មុខរបរ ឡើង ត្នោត កាលពី ដើម ឡើយ ប្រជាកសិករ រស់ នៅ តាម ទី ជនបទ បាន ប្រកប មុខរបរ នេះ ស្ទើ គ្រប់ ទីកន្លែង ដែល ជាធម្មតា គឺ គេ ចាប់ផ្ដើម ចង ត្នោត និង កៀប ផ្កា ក្នុង អំឡុង ពេល ពី ខែ ១១ និង ខែ ១២ទៅ គឺ ក្នុង អំឡុង ពេល រដូវ ច្រូត កាត់ ស្រូវ វស្សា ។ រហូតដល់ ខែ៥ ដែល ជា ខែ ធ្លាក់ ភ្លៀង ដើម ឆ្នាំ ទើប គេ ចោល ត្នោត ហើយ មក រៀបចំន ង្គ័ល និង រនាស់ ដើម្បី ចាប់ផ្តើម ធ្វើ ស្រែ វស្សា វិញ ដូច្នេះ ប្រជាកសិករ នៅ តាម ស្រុក ស្រែ ចម្ការ ដែល មាន មុខរបរ ធ្វើ ស្រែ ចម្ការ និង ឡើង ត្នោត មិន ដែល មាន ពេល ទំនេរ ឡើយ ។
លោក អ៊ុក មាន បាន បន្ត ថា ទោះជា យ៉ាងណា ក៏ដោយ ក៏ មុខរបរ ឡើង ត្នោត ជួប ការលំបាក ខ្លះ ៗ បន្តិច មែន តែ គាត់ ពេញចិត្ត ក្នុង ការចាប់ យក មុខរបរ នេះ ព្រោះថា ការប្រកប មុខរបរ នេះ គឺជា មុខរបរ សុច្ចរិត ។ នេះ ក៏ ជា មុខរបរ មួយ ដែល គាត់ ចេះ ធ្វើ ពី ឪពុក របស់ គាត់ មក ដែរ ហើយ គាត់ នឹង មិន បោះបង់ ចោល នោះ ទេ ដោយសារតែ មូលហេតុ ២យ៉ាង ។
ហេតុផល ទាំង ពីរ នោះ រួម មាន៖ ទី ១៖ គាត់ បាន ប្រាក់ ប្រចាំ ថ្ងៃ សម្រាប់ ជួយ ទ្រទ្រង់ ជីវភាព គ្រួសារ គាត់ ឱ្យ មាន ជីវភាព សមរម្យ និង ទី ២៖ គាត់ បាន នៅ ជួបជុំ ក្រុមគ្រួសា ប្រពន្ធ កូន រាល់ ថ្ងៃ ព្រោះ គាត់ មិន ចង់ ចំណាកស្រុក ទៅ ធ្វើការ នៅ ស្រុក គេ ឆ្ងាយ ៗ បែក ពី ក្រុមគ្រួសារ ប្រពន្ធ កូន នោះ ឡើយ ៕ មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង មហា ផ្ទៃ៖ ចំណេះដឹង អំពី កម្មសិទ្ធិ បញ្ញា បាន ចូលរួម កំណើន សេដ្ឋកិច្ច ជាតិ
( ភ្នំពេញ ) ៖ កំណើន សេដ្ឋកិច្ច ដែល រួមចំណែក ដោយ ចំណេះដឹង អំពី កម្មសិទ្ធិ បញ្ញា គឺជា ការពិចារណា ដ៏ សំខាន់ ក្នុង ការសម្រេចចិត្ត ផ្នែក ពាណិជ្ជកម្ម បាន ក្លាយជា ប្រធានបទ ក្នុង សិក្ខាសាលា « ការអនុវត្ត កម្មសិទ្ធិ បញ្ញា ពាក់ព័ន្ធ វិស័យ ចំណីអាហារ និង ឱសថ » ។
សិក្ខាសាលា នេះ ត្រូវបាន រៀបចំ ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ ដែល រៀបចំ ធ្វើឡើង ដោយ « សមាគម កម្មសិទ្ធិ បញ្ញា កម្ពុជា » និង មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ មៀច សុផាន់ ណា រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន គណៈកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ . លោកស្រី គឹម សេដ្ឋានី រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា . លោក យូ ប៊ុន ឡេង ប្រធាន សាលាឧទ្ធរណ៍ ព្រមទាំង អង្គភាព ពាក់ព័ន្ធ យ៉ាង ច្រើន ផងដែរ ។
នាយ ឧត្តមសេនីយ៍ មៀច សុផាន់ ណា បាន ថ្លែង ថា ការរៀបចំ ឱ្យ មាន សិក្ខាសាលា នេះ ឡើង គឺ បាន បង្ហាញ ពី យន្តការ មួយ ដ៏ មាន ប្រសិទ្ធភាព ព្រោះ ក្នុង សិក្ខាសាលា នេះ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ តួអង្គ ពាក់ព័ន្ធ ទាំងអស់ នឹង ចូលរួមចំណែក ការពារ នូវ កម្មសិទ្ធិ បញ្ញា ក៏ ដូចជា បង្ក្រាប ទប់ស្កាត់ រាល់ បទល្មើស បំពារបំពាន បញ្ញា ពីសំណាក់ ក្រុម អ្នករកស៊ី មិន មាន ភាពស្មោះត្រង់ ដែល លួយ ចបន្លំ ម៉ាក ជាដើម ។
លោកស្រី សេង វួច ហ៊ុន បាន បន្ត ថា ពេល ដែល កម្មសិទ្ធិ បញ្ញា ត្រូវបាន ការពារ ដោយ ច្បាប់ ការប្រកួតប្រជែង និង ការបង្កើត គំនិត ថ្មី ៗ គាត់ មាន សកម្ម ភាព នៅក្នុង សង្គម ។ ជាក់ស្ដែង ការរីក ដុះ ដាល នៃ កម្មសិទ្ធិ បញ្ញា របស់ អាជីវកម្ម ខ្នាត តូច និង ខាង មធ្យម គឺជា ផ្នែក មួយ ដែល ធ្វើឱ្យ ប្រទេស កម្ពុជា ថែរក្សា បាន នូវ កំណើន សេដ្ឋកិច្ច ក្នុង រង្វង់ ៧ភាគរយ ក្នុង រយៈ ពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ ។ ជាពិសេស ធ្វើឱ្យ ការប្រកបរបរ ទទួលទាន មាន ការប្រកួតប្រជែង កាន់ តែ ខ្លាំង តែ ទាមទារ ឱ្យ មាន កិច្ចការពារ ដោយ ច្បាប់ ។
លោកស្រី មេធាវី បាន បញ្ជាក់ ថា កម្មសិទ្ធិ បញ្ញា កំពុង ត្រូវបាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ពីសំណាក់ រាជ រដ្ឋាភិបាល និង មាន ការគាំទ្រ ពី ស្ថាប័ន ពាក់ព័ន្ធ ។ ការយល់ឃើញ ថា វិស័យ ចំណីអាហារ និង ឱសថ ជា ផ្នែក មួយ ដ៏ សំខាន់ ដែល ជា ឥទ្ធិពល ដល់ សង្គម ខ្មែរ បច្ចុប្បន្ន ហើយ ការធ្វើ អាជីវកម្ម លើ វិស័យ នេះ កំពុង មាន ការពាក់ព័ន្ធ យ៉ាង ខ្លាំង និង កម្មសិទ្ធិ បញ្ញា ។
( រតនគិរី ) ៖ មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត រតនគិរី បាន សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម និង ក្រុមការងារ មន្ត្រី មន្ទីរពិសោធន៍ នៃ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ បាន នាំយក រថយន្ត មន្ទីរពិសោធន៍ ចល័ត ចំណីអាហារ មក ត្រួតពិនិត្យ ទំនិញ នៅ ផ្សារ បាន លុង ក្នុង ខេត្ត រតនគិរី រកឃើញ ស្លឹក ខ្ទឹម មាន សំណល់ ជាតិ ថ្នាំ កសិកម្ម ។
មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត រតនគិរី បាន ឲ្យដឹង ថា នៅក្នុង ប្រតិបត្តិការ ចុះ ត្រួតពិនិត្យ ទំនិញ នៅ ផ្សារ បាន លុង នេះ ក្រុមការងារ បាន ធ្វើតេស្ត លើ មុខ ទំនិញ ម្ហូប អាហារ និង គ្រឿង សមុទ្រ សរុប ចំនួន ៤៤ គំរូ មក ធ្វើ ការពិនិត្យ រក សារធាតុ គីមី ហាមឃាត់ ហើយ ជា លទ្ធផល គឺ មន្ត្រី យើង បាន រកឃើញ នូវ ស្លឹក ខ្ទឹម មួយ មុខមាន ចំនួន ០.3kg ដែល មាន ផ្ទុក នូវ សារធាតុ គីមី ហាមឃាត់ គឺ សំណល់ ថ្នាំ កសិកម្ម ហើយ ក្រុមការងារ បាន ដកហូត យកមក ទុក កំទេចចោល ។
មន្រ្តី កាំ កុងត្រូល ក៏ បាន អំពាវនាវ ដល់ អាជីវករ អ្នកលក់ដូរ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន និង យកចិត្តទុកដាក់ ឱ្យ បាន ហ្មត់ចត់ មុននឹង ធ្វើចរាចរ ចែកចាយ លក់ដូរ និង ទិញ ទំនិញ ម្ហូប អាហារ ទទួលទាន ដោយ សុវត្ថិភាព មិន ប៉ះពាល់ សុខភាព អ្នកប្រើប្រាស់ ៕ ឯក អគ្គ រដ្ឋទូត និង តំណាង ទូត ជាច្រើន ប្រទេស បាន ចុះ ទៅ ត្រួតពិនិត្យ ផ្ទាល់ ជនជាតិ របស់ ខ្លួន នៅ ទីតាំង ដែល នាវា Westerdam ចត នៅ កំពង់ផែ ក្រុង ព្រះសីហនុ
សូម បញ្ជាក់ ថា ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន បាន អនុញ្ញាតឲ្យ នាវា ទេសចរណ៍ ខ្នាត យក្ស ដែល មាន ម្ចាស់ ជា ជនជាតិ ហូឡង់ កាត់ អាមេរិក និង មាន មូលដ្ឋាន នៅ សហរដ្ឋ អាមេរិក ចូល សំចត នៅ កំពង់ផែ ខេត្ត ព្រះសីហនុ របស់ កម្ពុជា ក្រោយពី ប្រទេស និង កោះសរុប ចំនួន ៦ បដិសេធ មិន ឲ្យ នាវា ដ៏ ធំ មួយ នេះ ចូល ចត ដោយសារ ភ័យខ្លាច អ្នកដំណើរ មាន ផ្ទុក វីរុស កូរ៉ូណា ថ្មី ។
( ប៉េកាំង ) ៖ រដ្ឋាភិបាល ទីក្រុង ប៉េកាំង នា ថ្ងៃព្រហស្បតិ៍ នេះ បាន ប្រកាស អំពី ផ្លាស់ប្តូរ ប្រធាន ការិយាល័យ ទទួលបន្ទុក កិច្ចការ ហុងកុង - ម៉ាកាវ បន្ទាប់ពី មាន ផ្ទុះ បាតុកម្ម អស់ រយៈពេល ជាច្រើន ខែ នៅក្នុង ទីក្រុង ហុងកុង ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ ។
ស្នងការ ខេត្ត កណ្តាល ណែនាំ និង អប់រំ មន្រ្ដី ក្រោម ឱវាទ ឲ្យ សាមគ្គីភាព និង រួបរួម គ្នា ដើម្បី ទប់ស្កាត់ បញ្ហា ផ្សេង ៗ
( កណ្ដាល ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី ឈឿន សុចិត្ត ស្នងការ នគរបាល ខេត្ត កណ្ដាល បាន ប្រាប់ ស្នងការ រង ទាំងអស់ ត្រូវ ទទួលខុសត្រូវ លើ តួនាទី ភារកិច្ច តាម ផែន នីមួយ ៗ ជាពិសេស ទទួលខុសត្រូវ ចំណុច ខ្ពស់ តាម ផែន របស់ ខ្លួន ហើយ ណែនាំ អប់រំ មន្រ្ដី របស់ ខ្លួន ឲ្យ មាន ការសាមគ្គីភាព និង រួបរួម គ្នា ដើម្បី ទប់ស្កាត់ បង្ការ បញ្ហា ផ្សេង ៗ ដែល កើត មាន ឡើង ជា យថាហេតុ ដោយ មាន ការឯកភាព ពី លោក លោកស្រី ស្នងការរទទួល ផែន ។
លោក ស្នងការ បាន ថ្លែង យ៉ាង ដូច្នេះ នៅក្នុង កិច្ចប្រជុំ គណៈ ស្នងការស្ដីពី ការផ្សព្វផ្សាយ ផែនការ សកម្មភាព ការងារ របស់ ស្នងការដ្ឋាន នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ ដែល មាន វត្តមាន ចូលរួម ពី មន្ត្រី នគរបាល ពាក់ព័ន្ធ ទាំងអស់ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ បាន លើកឡើង ទៀត ប្រសិនបើ លោក - លោកស្រី ស្នងការរង មាន ផែនការ ឬ មាន គម្រោង ការងារ ស មកម្មភាព របស់ ខ្លួន គឺ ត្រូវ ធ្វើ សំណើ ជូន ខាង ផែន ភស្ដុភារ ដើម្បីឲ្យ ផែន ភស្ដុភារ លើក យក គម្រោង សកម្មភាព ការងារ ទាំងអស់ នោះ សុំ ថវិកា សាមគ្គី របស់ ក្រសួង មហាផ្ទៃ យកមក ដើម្បី ចាត់ចែង អនុវត្ដ ការងារ ។
លោក ឧត្ដមសេនីយ៍ ត្រី ឈឿន សុចិត្ដ បាន ជំរុញ ឲ្យ លោក លោកស្រី ស្នងការរង ចុះ ប្រជុំ ផ្សព្វផ្សាយ ផែនការ សកម្មភាព ការងារ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ដ កណ្ដាល តាម បណ្ដា អធិការដ្ឋាន នគរបាល ក្រុង ស្រុក ដែល ខ្លួន ទទួលខុសត្រូវ ចាប់ពី ថ្ងៃ នេះ តែម្ដង ដោយ មាន ចូលរួម ចាប់ពី ថ្នាក់ ប៉ុស្ដិ៍ នគរបាល រដ្ឋបាល ផងដែរ ដើម្បី ដឹង ពី បញ្ហា ប្រឈម ឬ បញ្ហា ផ្សេង ៗ របស់ ប៉ុស្ដិ៍ រដ្ឋបាល ដើម្បី រក វិធី ដោះស្រាយ ឲ្យបាន ល្អ ប្រសើរ ៕ ធ្វើ កាំ ជ្រួច ខុស បច្ចេកទេស បណ្តាលឲ្យ ផ្ទុះ ស្លាប់ នៅ ស្រុក បាទី ខេត្ត តាកែវ
ហេតុការណ៍ ផ្ទុះ កាំ ជ្រួច បាន កើតឡើង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ នៅក្នុង ភូមិ ហនុ មាន ឃុំ ក្រាំង ធ្នង់ ស្រុក បាទី ខេត្ត តាកែវ ។
( ស្វាយរៀង ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំន ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ រួមគ្នា ថែរក្សា សុខ សន្តិភាព ការអភិវឌ្ឍ និង រួមគ្នា ថែរក្សា នូវ សមិទ្ធិផល នានា របស់ រាជ រដ្ឋាភិបាល ដែល បាន ផ្តល់ ជូន ឱ្យ បាន គង់វង្ស សម្រាប់ ទុក ដល់ កូន ចៅ ជំនាន់ ក្រោយ ៗ ទៀត ។
ថ្លែង នៅក្នុង ឱកាស អញ្ជើញ ជា អធីបតី ក្នុង ពិធី សម្ពោធ អគារ សិក្សា ១ខ្នង ៤បន្ទប់ និង សមិទ្ធិផល នានា នៅ សាលា បឋមសិក្សា ហ៊ុន សែន សំយ៉ោង ស្ថិត ក្នុង ភូមិ សំយ៉ោង ស្រុក កំពង់រោទិ៍ ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ លោកស្រី ថែមទាំង ជំរុញ ដល់ មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ បម្រើ សេវា សាធារណៈ ឱ្យ បាន ល្អ ប្រសើរ ជូន ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ផងដែរ ។
លោកស្រី បាន ថ្លែង បន្ត ថា ការចូលរួម អភិវឌ្ឍ លើ វិស័យ អប់រំ នៅ កម្ពុជា ពិតជា មាន សារៈសំខាន់ ណាស់ ដែល ពេលនេះ បាន នឹង កំពុង កែទម្រង់ ជាច្រើន ក្នុង គោលបំណង ឱ្យ កុមារ គ្រប់ ៗ រូប បាន ចូលរៀន ធានា ការ អប់រំ ប្រកបដោយ គុណភាព បរិយាប័ន្ន សមធម៌ និង បង្កើត កាលានុវត្តភាព សិក្សា ពេញ មួយ ជីវិត ស្រប ពេល ដែល រាជ រដ្ឋាភិបាល ចាត់ទុក្ខ ជា វិស័យ អប់រំ ជា វិស័យ អាទិភាព ដោយ បាន ធ្វើ កំណែទម្រង់ ស៊ីជម្រៅ លើ វិស័យ អប់រំ និង បាន ធ្វើ យ៉ាងណា ដើម្បី បង្កើន ចំណេះដឹង នៅ មូលដ្ឋាន និង បង្ខិត ជនបទ ឲ្យ កៀក នឹង ទីក្រុង ។
កីឡដ្ឋាន Etihad ត្រូវបាន សាងសង់ ឡើង នៅ ឆ្នាំ ២០០២ ដើម្បី ទទួល រៀបចំ ប្រកួត អូឡាំពិក នៅ ឆ្នាំ នោះ ហើយ កីឡដ្ឋាន នេះ អាច ផ្ទុក អ្នកចូលរួម ទស្សនា ផ្ទាល់ រហូតដល់ ៥៥.០៩៧ នាក់ ដោយឡែក នៅពេល បច្ចុប្បន្ន កីឡដ្ឋាន មួយ នេះ ក៏ ត្រូវបាន ប្រើប្រាស់ សម្រាប់ ប្រកួត ជើងឯក កីឡា ប្រដាល់ ពិភពលោក និង ប្រកួត លីក បាល់ ឱប ចក្រភព អង់គ្លេស ផងដែរ ។
កីឡដ្ឋាន នេះ ក៏ បើក ទទួលស្វាគមន៍ ភ្ញៀវ ចូល ទស្សនា ជាប្រចាំ ផងដែរ គឺ ចាប់ពី ថ្ងៃច័ន្ទ ដល់ ថ្ងៃអាទិត្យ ពី ម៉ោង ១០៖៣០ នាទី ព្រឹក តទៅ ដោយ គ្រាន់តែ បង់ ថ្លៃ សំបុត្រ ចូល ទស្សនា តម្លៃ ប្រហែល ២៣ ដុល្លារ ក្នុង ម្នាក់ សម្រាប់ មនុស្ស ពេញ វ័យ ។
ដូច្នេះ ក្នុង នាម ស្រាបៀរ កម្ពុជា ជា ដៃគូ ល្អ ឥត ខ្ចោះ មួយ របស់ ក្លឹប ទើប ស្រាបៀរ កម្ពុជា លើក យក ក្លោងទ្វារ របស់ ក្លឹប អោយ អ្នកគាំទ្រ បាន ស្គាល់ ៕ ទាហាន ស័ក្តិ ៥ ម្នាក់ ដាក់ពាក្យ ប្តឹង គូ ដណ្តឹង ក្រោយ លួច ទៅ រៀបការ ជាមួយ ប្រុស ថ្មី នៅ ថ្ងៃទី ១៤ កុម្ភៈ
( កំពង់ស្ពឺ ) ៖ រឿងរ៉ាវ ដែល មិន គួរ កើតឡើង មួយ បែរជា អាច កើតឡើង ទៅ រួចហើយ នៅក្នុង ភូមិ ព្រៃ តា ទ្រូ ឃុំ ភ្នំ តូច ស្រុក ឧដុង្គ ខេត្ត កំពង់ស្ពឺ ដោយ បុរស ជា យោធា ស័ក្តិ៥ ម្នាក់ មាន ឈ្មោះ ហង្ស ពេជ្រ បាន សម្រេចចិត្ត ដាក់ពាក្យ ប្តឹង គូ ដណ្តឹង របស់ ខ្លួន ដែល បាន ភ្ជាប់ពាក្យ ត្រឹមត្រូវ តាម ច្បាប់ មាន ចាស់ទុំ ជា សាក្សី ឱ្យ សង លុយ ថ្លៃ ចូល ស្តី ដណ្តឹង ខណៈ ដែល ខាង ស្រី ដែល ត្រូវ ជា គូ ដណ្តឹង នោះ ទៅ លួច រៀបការ ជាមួយ ប្រុស ថ្មី ។
លោក ហង្ស ពេជ្រ ដែល នៅក្នុង ដៃ បាន កាន់ រូបថតភ្ជាប់ពាក្យ ជាមួយ គូ ដណ្តឹង បាន អះអាង ឱ្យ ភ្នាក់ងារ សារព័ត៌មាន Fresh News ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ ថា អំឡុង ខែវិច្ឆិកា ឆ្នាំ ២០១៩ លោក និង គូ ដណ្តឹង បាន រៀបចំ ផ្សំ ផ្គុំ ដោយ មាន ចាស់ទុំ ចូល ស្តី ដណ្តឹង ( ភ្ជាប់ពាក្យ ) នៅ ផ្ទះ ខាង ស្រី ធ្វើឡើង ត្រឹមត្រូវ ទៅ តាម គន្លង ប្រពៃណី ខ្មែរ និង បាន ចំណាយ លុយកាក់ ជាច្រើន សម្រាប់ ជូន ភ្ញៀវ ហូបចុក ក្នុង ភូមិ ។
លោក ឃាន ទូច ជា មេធាវី តំណាង ដោយ អាណត្តិ របស់ លោក ហង្ស ពេជ្រ បាន លើកឡើង ពាក់ព័ន្ធ នឹង ផ្លូវ ច្បាប់ ថា ជាធម្មតា ការសុំ ច្បាប់ រៀបការ អាជ្ញាធរ ទុក រយៈពេល ១៥ ថ្ងៃ ដើម្បីឲ្យ ភាគី ពាក់ព័ន្ធ ដឹង ហើយ រឿង នេះ លោក មេធាវី ក៏ បាន ដាក់ពាក្យ មុន ដើម្បី ឃាត់ ពិធី អាពាហ៍ពិពាហ៍ នេះ ។
លោក មេធាវី បាន បញ្ជាក់ ថា សិទ្ធិ របស់ កូនក្តី លោក នៅ មាន តួនាទី ជា គូ ដណ្តឹង ស្មើគ្នា ទៅនឹង ប្តី ប្រពន្ធ ដែល ដឹង ឮ ដោយ ចាស់ទុំ ពេញ ភូមិ មិន មែន ភ្ជាប់ពាក្យ នឹង គ្នា ហើយ ស្មើនឹង សង្សារ ដូច ខាង ស្រី លើកឡើង នោះ ទេ ។ លោក មេធាវី បាន ស្នើសុំ ឲ្យ អាជ្ញាធរ ទាំង ភូមិ ដល់ ខេត្ត ត្រូវតែ ហាមឃាត់ ពិធី រៀបការ របស់ ភាគី ខាង ស្រី ឲ្យបាន ដាច់ខាត ទៅ តាម បណ្តឹង តាម ផ្លូវ ច្បាប់ របស់ ភាគី ខាង ប្រុស ។
សូម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន អនុញ្ញាតឲ្យ នាវា ទេសចរណ៍ ខ្នាត យក្ស ដែល មាន ម្ចាស់ ជា ជនជាតិ ហូឡង់ កាត់ អាមេរិក និង មាន មូលដ្ឋាន នៅ សហរដ្ឋ អាមេរិក ចូល សំចត នៅ កំពង់ផែ ខេត្ត ព្រះសីហនុ របស់ កម្ពុជា ក្រោយពី ប្រទេស និង កោះសរុប ចំនួន ៦ បដិសេធ មិន ឲ្យ នាវា ដ៏ ធំ មួយ នេះ ចូល ចត ដោយសារ ភ័យខ្លាច អ្នកដំណើរ មាន ផ្ទុក វីរុស កូរ៉ូណា ថ្មី ។
ចំនួន ជន អន្តោប្រវេសន៍ ឆ្លងកាត់ ព្រំដែន អាមេរិក - មិចស៊ីកូ ធ្លាក់ចុះ រហូតដល់ ៧៤. ៥% ដោយសារតែ លោក ដូណាល់ ត្រាំ
( មិចស៊ីកូ) ៖ រដ្ឋមន្ត្រី ការបរទេស មិចស៊ីកូលោក ម៉ាសេឡូ អេប្រាដ (Marcelo Ebrard) បាន ប្រាប់ ឱ្យដឹង នៅ ថ្ងៃពុធ សប្តាហ៍ នេះ ថា ចំនួន ជន អន្តោប្រវេសន៍ ដែល ឆ្លងកាត់ ព្រំដែន អាមេរិក - មិចស៊ី កូក្នុង រយៈពេល ០៩ ខែ កន្លងមក នេះ បាន ធ្លាក់ចុះ រហូតដល់ ៧៤. ៥% បន្ទាប់ពី មាន កិច្ចព្រមព្រៀង ទ្វេ ភាគី ដើម្បី ទប់ស្កាត់ លំហូរ ជន អន្តោប្រវេសន៍ រវាង ប្រទេស ទាំង ពីរ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ ។
កាលពី ខែមករា ដើម ឆ្នាំ ២០២០ ចំនួន ជន អន្តោប្រវេសន៍ ដែល ឆ្លងកាត់ ព្រំដែន ប្រទេស ទាំង ពីរ មាន ត្រឹមតែ ៣៦. ៦៧៩ នាក់ ប៉ុណ្ណោះ ដែល នេះ ជា តួលេខ ដែល បាន ធ្លាក់ចុះ ទាប បំផុត បើ ប្រៀបធៀប នឹង ចំនួន ជន អន្តោប្រវេសន៍ កាលពី ខែឧសភា ឆ្នាំ ២០១៩ កន្លងទៅ ដែល មាន ចំនួន រហូតដល់ ១៤៤. ១១៦ នាក់ ត្រូវបាន កត់ត្រា ដោយ អាជ្ញាធរ មិចស៊ីកូ ។
គួរ ជម្រាប ថា កាលពី ខែឧសភា ឆ្នាំ ២០១៩ កន្លងទៅ ដោយសារតែ ចំនួន ជន អន្តោប្រវេសន៍ ដែល បាន ឆ្លង ព្រំដែន បាន ឈាន ទៅដល់ ចំនួន ខ្ពស់ បំផុត ពុំ ធ្លាប់ មាន ពីមុន មក នោះ ប្រធានាធិបតី សហរដ្ឋ អាមេរិក លោក ដូណាល់ ត្រាំ បាន ស្នើ ឱ្យ ឲ្យ រដ្ឋាភិបាល មិចស៊ីកូ ចាត់ វិធានការគ្រប់គ្រង ឲ្យបាន តឹងរ៉ឹង បំផុត ដើម្បី ធានា និង ពង្រឹង សន្តិសុខ នៅ តាម ព្រំដែន របស់ ខ្លួន ជាពិសេស ជាមួយ បណ្តា ប្រទេស អាមេរិក កណ្តាល ។
ជុំវិញ បញ្ហា នេះ ដែរ រដ្ឋមន្ត្រី ការបរទេស មិចស៊ីកូ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « គោលដៅ នៃ វិធានការ ទាំង នេះ គឺ ដើម្បី កាត់បន្ថយ ហានិភ័យ ខ្ពស់ ដែល អាចនឹង ប្រឈម ចំពោះ អ្នក ដែល ចង់ ចំណាកស្រុក » ។ លោក ក៏ បាន បន្ថែម ទៀត ថា ដើម្បី ធានា សន្តិសុខ ជូន ប្រជាជន រដ្ឋាភិបាល មិចស៊ីកូ បាន ដឹកនាំ កម្មវិធី ពហុ ជាតិ ដើម្បី ជំរុញ ការវិនិយោគ នៅ តំបន់ អាមេរិក កណ្តាល និង បាន បង្កើត គណៈកម្មាធិការ ពិសេស មួយ ដើម្បី ជួយ ជន ចំណាកស្រុក ឱ្យ មាន ការងារ ធ្វើ បណ្តោះអាសន្ន ។
សូម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន អនុញ្ញាតឲ្យ នាវា ទេសចរណ៍ ខ្នាត យក្ស ដែល មាន ម្ចាស់ ជា ជនជាតិ ហូឡង់ កាត់ អាមេរិក និង មាន មូលដ្ឋាន នៅ សហរដ្ឋ អាមេរិក ដែល ផ្ទុក មនុស្ស ជាង ២២០០ នាក់ ចូល សំចត នៅ កំពង់ផែ ខេត្ត ព្រះសីហនុ របស់ កម្ពុជា ក្រោយពី ប្រទេស និង កោះសរុប ចំនួន ៦ បដិសេធ មិន ឲ្យ នាវា ដ៏ ធំ មួយ នេះ ចូល ចត ដោយសារ ភ័យខ្លាច អ្នកដំណើរ មាន ផ្ទុក វីរុស កូរ៉ូណា ថ្មី ។
ទូត អូស្រា្តលី ថ្មី ប្រចាំ កម្ពុជា កោតសរសើរ ពី កំណើន សេដ្ឋកិច្ច ខ្ពស់ និង ការផ្លាស់ប្តូរ មុខមាត់ យ៉ាង លឿន បំផុត របស់ កម្ពុជា លើ ឆាក អន្តរជាតិ
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ ថ្ងៃទី ១២ ខែកុម្ភៈ ឆ្នាំ ២០២០ បាន ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ លោក Pablo Chiho Kang ឯក អគ្គ រដ្ឋទូត ថ្មី នៃ ប្រទេស អូស្រា្តលី ប្រចាំ កម្ពុជា ដើម្បី ពិភាក្សា អំពី ការបន្ត ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ។
អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី បាន គូស រំលេច ពី គុណ បំណាច់ ដ៏ ឧត្តុង្គឧត្តម របស់ រដ្ឋាភិបាល និង ប្រជាជន អូស្រ្តាលី ចំពោះ រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា ចាប់តាំងពី ការជួយ ដល់ ដំណើរការ ក សាង សន្តិភាព រហូតដល់ ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ហើយ ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ត្រូវបាន លើកកម្ពស់ ឥត ឈប់ឈរ ដែល បាន នាំមក នូវ សមិទ្ធផល ប្រកបដោយ ផ្លែផ្កា ជាច្រើន អនេក ។
លោក ក៏ បាន បញ្ជាក់ បន្ថែម ថា ឈរ លើ ហេតុផល ពិត នៃ ការអភិវឌ្ឍ ទាំងនេះ . អូស្រ្តាលី នឹង បន្ត ជួយ គាំទ្រ ក៏ ដូចជា បង្ហាញ ការពិត ពី កិច្ចអភិវឌ្ឍន៍ នៅ កម្ពុជា បន្ត ទៀត ដើម្បី ជំរុញ ឱ្យ អ្នកវិនិយោគិន អូស្រ្តាលី មក បណ្តាក់ទុន វិនិយោគ បន្ថែម ឱ្យ បាន កាន់តែ ច្រើន នៅ កម្ពុជា ។
ភាគី ទាំង ពីរ ក៏ បាន ពិភាក្សា អំពី ការព្យាករណ៍ នៃ ស្ថានភាព ម៉ាក្រូ សេដ្ឋកិច្ច កម្ពុជា ចំពោះ ផល ប៉ះពាល់ អវិជ្ជមាន នៃ ការព្យួរ EBA ជា យថាហេតុ ដោយ សហភាព អឺរ៉ុប ជាមួយនឹង សេណារីយ៉ូ សម្រាប់ ជា ដំណោះស្រាយ របស់ កម្ពុជា និង ឥទ្ធិពល នៃ រាតត្បាត នៃ ជំងឺ កូរ៉ូណា ថ្មី មក លើ សេដ្ឋកិច្ច កម្ពុជា ជាដើម ។
កងទ័ព លីប៊ី ខាងកើត ដែល ត្រូវបាន គេ ជឿជាក់ ថា មាន រុស្ស៊ី ជា ខ្នង បង្អែក នោះ បាន អះអាង ថា ខ្លួន តែង ប្រកាន់ខ្ជាប់ នូវ កិច្ចព្រមព្រៀង ផ្អាក ការបាញ់ បោះ ដាក់ គ្នា ប៉ុន្តែ ពួកគេ នៅតែ មាន សិទ្ធិ ក្នុង ការត្រៀមខ្លួន នៅពេល កិច្ចព្រមព្រៀង ត្រូវបាន បំពាន ដូច ដែល ជម្លោះ រវាង កងទ័ព លីប៊ី ខាងកើត និង ក្រុម ភេរវករ តែងតែ កើត មាន ឡើង នោះ ដែរ ។
គួរ បញ្ជាក់ តាម មន្ត្រី លីប៊ី ខាងកើត បាន ពន្យល់ ថា បញ្ហា ស្នូល នៃ ប្រទេស លីប៊ី ទាំងមូល គឺ មិន មែន សេដ្ឋកិច្ច ឬ ក៏ នយោបាយ នោះ ឡើយ ប៉ុន្តែ គឺ បញ្ហា សន្តិសុខ ជា រួម ដែល បង្កឡើង ដោយ ក្រុម សកម្ម ប្រយុទ្ធ និង ពួក ភេរវករ ដែល ពួកគេ កំពុង គ្រប់គ្រង តំបន់ សំខាន់ ៗ មួយចំនួន ក្នុង ប្រទេស អាហ្វ្រិក ខាងជើង មួយ នេះ ។ ដូច្នេះ កងទ័ព លីប៊ី ខាងកើត ( ទីក្រុង ប៊ែង ហ្គាស៊ី ) ប្តេជ្ញា គ្រប់គ្រង អាវុធ ឲ្យបាន ទាំងអស់ នៅ ទូទាំង ប្រទេស ៕
នាវា ទេសចរណ៍ ខ្នាត យក្ស របស់ អាមេរិក Westerdam នៅ ទីបំផុត បន្ទាប់ពី រក ទី សំចត មិន បាន អស់ រយៈពេល ១២ ថ្ងៃ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ បាន ចូល សំចត នៅ កំពង់ផែ ក្រុង ព្រះសីហនុ ដោយ សុវត្ថិភាព ហើយ បន្ទាប់ពី ទទួលបាន ការអនុញ្ញាត ពី ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន ។
សម្តេច តេជោ ហ៊ុន សែន មេដឹកនាំ ដំបូង គេ ដែល បាន ធ្វើដំណើរ ទៅកាន់ ប្រទេស ចិន ក្រោយ ផ្ទុះ ជំងឺ ផ្លូវ ដង្ហើម បង្ក ដោយ មេរោគ «COVID19» បាន ថ្លែង ប្រាប់ លោក លឹម ជា វុត្ថា នាយក ប្រតិបត្តិ អង្គភាព ព័ត៌មាន Fresh News ឲ្យដឹង ថា ការអនុញ្ញត ឱ្យ នាវា នេះ ចូល គឺ បង្ហាញ ពី ការលុបបំបាត់ នូវ ជំងឺ ភ័យខ្លាច ដែល កំពុង កើតមាន នៅលើ ពិភពលោក ។ សម្តេច តេជោ បន្ថែម ថា កម្ពុជា គ្មាន ឡើយ ការរើសអើង ពូជសាសន៍ ត្រូវតែ ចូលរួម សង្រ្គោះ ក្នុង កិច្ចការ មនុស្សធម៌ ខណៈ អ្នកទេសចរ លើ នាវា កំពុង ជួប គ្រោះអាសន្ន ។
ក្រុមហ៊ុន នាវា ទេសចរណ៍ បាន ឱ្យដឹង តាមរយៈ គេហទំព័រ របស់ ខ្លួន ថា បន្ទាប់ពី សំចត រយៈពេល មួយ ទៅ ពីរ ថ្ងៃនៅ ខេត្ត ព្រះសីហនុ ក្រុមហ៊ុន បាន សម្រេច ជួល យន្តហោះ សម្រាប់ ដឹកជញ្ជូន អ្នកដំណើរ ពី ព្រលានយន្តហោះ កង កេង ក្នុង ខេត្ត ព្រះសីហនុ ទៅកាន់ អាកាសយានយន្ត អន្តរជាតិ ភ្នំពេញ និង ហោះហើរ បន្ត ទៅកាន់ ស្រុក កំណើត របស់ ពួកគេ ។
អាជ្ញាធរ របស់ កម្ពុជា បាន អះអាង ផងដែរ ថា នៅពេល នាវា នេះ ចូល ចត នឹង មាន ការពិនិត្យ សុខភាព របស់ អ្នកទេសចរ នៅលើ នាវា ទាំងអស់ នោះ ហើយ បើ មាន ករណី សង្ស័យ មាន ជំងឺ ណាមួយ នឹង ត្រូវ យក ទៅតាម ដាន និង ពិនិត្យ កំហាក ភ្លាម ៗ តែម្តង ដោយ ដឹក តាម យន្តហោះ ទៅ ពិនិត្យ នៅ វិទ្យាស្ថាន ប៉ាស្ទ័រ ។ តែ ទោះបីជា យ៉ាងណា អ្នក គ្រប់គ្រង លើ នាវា នេះ បាន បញ្ជាក់ និង អះអាង ថា មនុស្ស ទាំងអស់ នៅលើ នាវា មិន មាន ផ្ទុក មេរោគ កូរ៉ូណា នោះ ឡើយ ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ជាង ១យប់ ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ ដែល មាន ទីតាំង ស្ថិត នៅ តាម បណ្ដោយ ផ្លូវ កម្ពុជា ក្រោម កែង ផ្លូវ ព្រះមុនីវង្ស ចំណុច ស្ដុប សេរីភាព ស្ថិត ក្នុង សង្កាត់ មនោរម្យ ខណ្ឌ ៧មករា រាជធានី ភ្នំពេញ ។
ក្រោយពេល កើត ហេតុ សមត្ថកិច្ច មូលដ្ឋាន បាន ចុះ មកដល់ ទីតាំង កន្លែង កើត ហេតុ រួច ធ្វើ ការទាក់ទង ទៅ សមត្ថកិច្ច ជំនាញ ដើម្បី ចុះ មក ធ្វើ ការវាស់វែង និង យក រថយន្ដ ទាំង ពីរ ទៅ ការិយាល័យ ចរាចរណ៍ ដើម្បី ដោះស្រាយ តាម ផ្លូវ ច្បាប់ នៅ ពេល ក្រោយ ៕
( ភ្នំពេញ ) ៖ នារី ម្នាក់ បាន ស្លាប់ បន្ទាប់ពី បើក រថយន្ដ ទៅ បុក របាំង ថ្ម ចែក ទ្រូងផ្លូវ បណ្ដាលឲ្យ ក្រឡាប់ នៅ គល់ ស្ពាន អាកាស ស្ទឹងមានជ័យ ដែល ហេតុការណ៍ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ២៖២០ យប់ ចូល ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២០ ដែល មាទីតាំង ស្ថិត នៅ តាម បណ្ដោយ ផ្លូវ មហាវិថី ព្រះមុន្នីរ៉េត ចំណុច គល់ ស្ពាន អាកាស ស្ទឹងមានជ័យ ក្នុង សង្កាត់ ស្ទឹងមានជ័យ ទី២ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។
