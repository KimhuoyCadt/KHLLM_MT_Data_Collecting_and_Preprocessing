( ព្រះសីហនុ) ៖ លោក សាយ សំអាល់ រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ព្រះសីហនុ បាន ជំរុញ ឱ្យ បង្កើត ព្រឹត្តិការណ៍ សង្រ្កាន្ត សមុទ្រ រៀបចំ កម្មវិធី កំសាន្ត សប្បាយ ផ្សេង ៗ នៅ ខេត្ត ព្រះសីហនុ ក្នុង ឱកាស រដូវ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ខាងមុខ នេះ ដើម្បីឱ្យ ប្រជាជន បាន ចូលរួម សប្បាយរីករាយ សាទ រ ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ និង ជា ព្រឹត្តិការណ៍ ទាក់ទាញ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ មក លេង ខេត្ត ព្រះសីហនុ ឱ្យ បាន ច្រើន ផងដែរ ។
លោក ប្រធាន ក្រុមការងារ បាន មានប្រសាសន៍ ថា « សន្និបាត នេះ គឺជា ឱកាស វិសេសវិសាល អនុញ្ញាតឱ្យ យើង រួមគ្នា ធ្វើ ការពិនិត្យ វាយតម្លៃ ពី សមិទ្ធផល នានា ដែល រដ្ឋបាល ខេត្ត និង ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ព្រះសីហនុ សម្រេចបាន ក្នុង ឆ្នាំ ២០១៩ កន្លងមក និង បញ្ហា ប្រឈម ដែល សេសសល់ ក៏ ដូចជា កាលានុវត្តភាព នានា ដើម្បី ដាក់ចេញ នូវ ទិសដៅ ការងារ សម្រាប់ ការអនុវត្ត បន្ត នៅ ឆ្នាំ ២០២០ ដែល ជា ឆ្នាំ ទី២ នៃ ការអនុវត្ត យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល » ។
បន្ទាប់មក លោក ប្រធាន ក្រុមការងារ បាន ធ្វើ ការណែនាំ នូវ កិច្ចការ សំខាន់ ៗ ដែល ត្រូវ ខិតខំ រួមគ្នា សម្រេច ឲ្យបាន មាន៖ ១៖ ការថែរក្សា សន្តិភាព និង ស្ថិរភាព នយោបាយ ២៖ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម ៣៖ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម និង ទេសចរណ៍ ៤៖ ការអភិវឌ្ឍ ទីក្រុង ៥៖ កំណែទម្រង់ វិមជ្ឈការ និង វិសហមជ្ឈការ ៦. ការផ្តល់ សេវា សាធារណៈ និង ការដោះស្រាយ បណ្តា ប្រឈម នៅ មូលដ្ឋាន ៧៖ ការពង្រឹង របៀបរបប ការងារ ។
ជាមួយគ្នា នេះ លោក សាយ សំអាល់ បាន សម្តែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល ដែល រដ្ឋបាល ខេត្ត និង ក្រុមការងារ សម្រេចបាន និង សង្ឃឹម យ៉ាង មុតមាំ ថា ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំង មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ និង ក្រុមការងារ បន្ត ពង្រីក ការប្តេជ្ញាចិត្ត រួមគ្នា បន្ថែម ទៀត ក្នុង ការអនុវត្ត ឲ្យបាន សម្រេច នូវ ទិសដៅ ការងារ ឆ្នាំ ២០២០ ដើម្បី បម្រើ ផលប្រយោជន៍ ជាតិ និង ប្រជាជន កម្ពុជា ។
គួរ បញ្ជាក់ ដែរ ថា នៅក្នុង ពិបិទ សន្និបាត របស់ រដ្ឋបាល ខេត្ត ព្រះសីហនុ លោក សាយ សំអាល់ បាន ចែកជូន លិខិត សរសើរ ជូន ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំង មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ និង ក្រុមការងារ ដែល អនុវត្ត ឲ្យបាន សម្រេច នូវ ទិសដៅ ការងារ បម្រើ ផលប្រយោជន៍ ជាតិ និង ប្រជាជន កម្ពុជា ៕ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អំពាវនាវ នាយ ដល់ ទាហាន តំបន់ ព្រំដែន ទិសទី១ ប្រាសាទ ព្រះវិហារ រួមគ្នា ថែរក្សា សុខ សន្តិភាព
( ព្រះវិហារ ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ បាន អំពាវនាវ ដល់ នាយ ទាហាន តំបន់ ព្រំដែន ទិសទី១ ប្រាសាទ ព្រះវិហារ រួមគ្នា ថែរក្សា សុខ សន្តិភាព ដែល កម្ពុជា ទទួលបាន ពេញលេញ ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។ ។
លោក នាយ ឧត្តមសេនីយ៍ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ស្មារតី នៃ កិច្ច ខិតខំ ប្រឹងប្រែង បំពេញ ការងារ បម្រើ ជាតិ ប្រកបដោយ ភាពអង់អាច ក្លាហាន និង មាន កិច្ចសហការ គ្នា ល្អ រវាង ថ្នាក់ដឹកនាំ គ្រប់ អង្គភាព កងកម្លាំងប្រដាប់អាវុធ ដែល ឈរ ជើង ការពារ អធិបតេយ្យ បូរណភាព ទឹកដី ក្នុង ភូមិសាស្ត្រ តំបន់ ព្រំដែន ទិសទី១ ប្រាសាទ ព្រះវិហារ របស់ យោធ ភូមិភាគ ទី៤ ។
ដោយ មាន ការ អម ដំណើរ ដោយ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង មេបញ្ជាការ កងទ័ព ជើងគោក . លោក ស៊ួស យ៉ារ៉ា អ្នកតំណាងរាស្ត្រ មណ្ឌល ព្រះវិហារ ព្រមទាំង ថ្នាក់ដឹកនាំ កងយោធពល ខេមរភូមិន្ទ យ៉ាង ច្រើន ផងដែរ ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ក៏ បាន សម្ដែង នូវ ការដឹង គុណ ចំពោះ គំរូវីរភាព ដ៏ អង់អាច ក្លាហាន របស់ វីរ យុទ្ធជន យុទ្ធ នារី នៃ កងយោធពល ខេមរភូមិន្ទ ដែល ក្នុង អតីតកាល កន្លងមក បាន លះបង់ សាច់ ស្រស់ ឈាម ស្រស់ កាយសម្បទា និង អាយុជីវិត ដើម្បី បម្រើ ឱ្យ បុព្វហេតុ ការពារ ជាតិ មាតុភូមិ កម្ពុជា និង ភាពសុខសាន្ត ជូន ប្រជាពលរដ្ឋ កម្ពុជា ។
( ភ្នំពេញ ) ៖ ដោយ មាន ការអនុញ្ញាត ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ ទៅ បំពេញ ទស្សនកិច្ចការងារ នៅ រដ្ឋធានី វៀង ច័ន្ទ នៃ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៤ ដល់ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ ។ នេះ បើ តាម ការប្រកាស របស់ ក្រសួង មហាផ្ទៃ ។
ក្នុង ដំណើរទស្សនកិច្ចការងារ នេះ សម្ដេច ក្រឡាហោម ស ខេង នឹង អញ្ជើញ ធ្វើជា សហ ប្រធាន ដឹកនាំ កិច្ចប្រជុំ ពិនិត្យ វាយតម្លៃ លទ្ធផល នៃ ការអនុវត្ត កំណត់ហេតុ កិច្ចសហប្រតិបត្តិការ ឆ្នាំ ២០១៩ និង ចុះហត្ថលេខា លើ កំណត់ហេតុ នៃ កិច្ចសហប្រតិបត្តិការ ឆ្នាំ ២០២០ រវាង ក្រសួង មហាផ្ទៃ របស់ កម្ពុជា និង ក្រសួង សន្តិសុខ សាធារណៈ នៃ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ ។
កិច្ចប្រជុំ នេះ គឺជា ការអនុវត្ត យន្ត ការសហប្រតិបត្តិការ ទ្វេ ភាគី ប្រចាំ ឆ្នាំ ក្នុង គោលដៅ បន្ត លើកកម្ពស់ ការពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍ រវាង បណ្ដា ខេត្ត ជាប់ ព្រំដែន ព្រមទាំង កិច្ចសហប្រតិបត្តិការ ក្នុង ការថែរក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព សង្គម នៃ ប្រទេស ទាំង ពីរ ។
ក្នុង ដំណើរទស្សនកិច្ច នេះ ដែរ សម្ដេច ក្រឡាហោម ស ខេង ក៏ នឹង អញ្ជើញ ចូល ជួប សម្តែង ការគួរសម ជាមួយ លោក ថង លន់ ស៊ី សូលីត នាយក រដ្ឋមន្ត្រី ឡាវ ផងដែរ ៕
យោង តាម វិទ្យាស្ថាន គ្រប់គ្រង់ និង ទប់ស្កាត់ ជំងឺ ឆ្លង អាល្លឺម៉ង់ ហៅ កាត់ ថា RKI បាន ឲ្យដឹង ថា « ពេលនេះ អាល្លឺម៉ង់ កំពុងតែ ប្រឈមមុខ ជាមួយ វីរុស ដែល បាន រីករាលដាល ទៅ កាន់ ផ្នែក ជាច្រើន នៅលើ សកលលោក រួចទៅហើយ ដោយ វា ប្រហែលជា មិន ងាយ រលាយ បាត់ ទៅវិញ នោះ ទេ ។ ប្រទេស អាល្លឺម៉ង់ នឹង ខិតខំ ឲ្យ អស់ ពី សមត្ថភាព តែម្តង ដើម្បី កាត់បន្ថយ អត្រា ឆ្លង រាលដាល ឲ្យបាន យ៉ាងហោចណាស់ ក្នុង អំឡុង ប៉ុន្មាន សប្តាហ៍ ឬ ខែ ខាងមុខ ... » ។
គួរ បញ្ជាក់ ថា អាជ្ញាធរ អាល្លឺម៉ង់ បាន ចាត់ វិធានការ ត្រួតពិនិត្យ សុខភាព ទៅ លើ អ្នកដំណើរ ដែល ចូលមកកាន់ ប្រទេស នេះ ជាពិសេស អ្នកដំណើរ ពី ប្រទេស ដែល កំពុង មាន ការឆ្លង COVID-19 ខ្លាំងក្លា ជាង គេ ។ មិន ខុសពី ប្រទេស មួយចំនួន នោះ ឡើយ បុគ្គលិក ក្រុមហ៊ុន មន្ត្រី រដ្ឋាភិបាល ឬ ក៏ ថ្នាក់ រៀន មួយចំនួន ត្រូវបាន ណែនាំឲ្យ ប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ដើម្បី បំពេញ ការងារ និង សិក្សា រៀនសូត្រ ពី ផ្ទះ ជា បណ្តោះអាសន្ន ដើម្បី បង្ការ ការឆ្លង មេរោគ នេះ ៕
រដ្ឋមន្ដ្រី ហង់ ជួន ណារ៉ុន៖ ក្រសួង អប់រំ បាន និង កំពុង យកចិត្ដទុកដាក់ លើកកម្ពស់ សមភាព យេនឌ័រ ឲ្យ ទួលបាន ប្រយោជន៍ ដូចគ្នា ទាំង បុរស និង ស្ត្រី
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្ដ្រី ក្រសួង អប់រំ យុវជន និង កីឡា បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា ក្រសួង អប់រំ យុវជន និង កីឡា បាន និង កំពុង យកចិត្ដទុកដាក់ លើកកម្ពស់ សមភាព យេនឌ័រ ក្នុង ចំណោម មន្ដ្រីរាជការ គ្រប់ រូប ។
ការលើកឡើង បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន អញ្ជើញ ចូលរួម ជា អធិបតីភាព ក្នុង ពិធី អបអរសាទរ ខួប លើក ទី ១០៩ ទិវា អន្ដរជាតិ នារី ៨ មីនា ក្រោម ប្រធានបទ « មាន សន្ដិភាព មាន ការលើកកម្ពស់ សមភាព យេនឌ័រ » រៀបចំ ធ្វើ នៅ វិទ្យាស្ថាន ជាតិ អប់រំ នា ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ ។
ថ្លែង ក្នុង ពិធី នោះ រដ្ឋមន្ដ្រី ហង់ ជួន ណារ៉ុន បាន ថ្លែង ថា « ខ្ញុំ សូម ជម្រាប ជូន ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា ក្រសួង អប់រំ យុវជន និង កីឡា បាន និង កំពុង យកចិត្ដទុកដាក់ លើកកម្ពស់ សមភាព យេនឌ័រ ក្នុង ចំណោម មន្ដ្រីរាជការ គ្រប់ រូប ឲ្យបាន ទទួល នូវ អត្ថប្រយោជន៍ ដូច ៗ គ្នា ទាំង បុរស និង ស្រី » ។
លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន បាន ឲ្យដឹង ទៀត ថា មន្ដ្រីរាជការ គ្រប់ រូប ទទួលបាន ការពិនិត្យ សុខភាព ការព្យាបាល ជំងឺ តាម មន្ទីរពេទ្យ រដ្ឋ ទាំងអស់ និង មន្ដ្រី ឯកជន ហើយ បាន ចុះ កិច្ចសន្យា ជាមួយ បេឡា ជាតិ របប សន្ដិសុខ សង្គម ដោយ មិន បង់ប្រាក់ ផងដែរ ។
ជាមួយគ្នា នេះ រដ្ឋមន្ដ្រី ក្រសួង អប់រំ បាន បញ្ជាក់ ថា ក្រសួង ក៏ បាន កែលម្អ ការងារ ជា បន្ដ បន្ទាប់ ដើម្បីឲ្យ មន្ដ្រីរាជការ អាច បំពេញ ការងារ អស់ ពី លទ្ធភាព ជាមួយ គុណភាព អាស៊ាន ដែល ក្នុង នោះ រួម មាន៖
* ការបង្កើត បទដ្ឋាន កាន់តែ ល្អ សំដៅ ដល់ ការដាក់ចេញ នូវ ប្រព័ន្ធ គ្រប់គ្រង ប្រសិទ្ធិភាព ការងារ * ការរៀបចំ នៃ ព័ត៌មាន មុខតំណែង ច្បាស់លាស់ * ការជ្រើសរើស មន្ដ្រី ដែល សម នឹង ការងារ អនុក្រម * ការជ្រើសរើស ប្រកបដោយ យុត្ដិធម៌ និង តម្លាភាព * ការផ្ដល់ យោបល់ ការងារ និង ការបណ្ដុះបណ្ដាល ប្រកបដោយ ប្រសិទ្ធិភាព * ការបង្ហាត់ បង្រៀន ការងារ * ការផ្ដល់ ឱកាស អភិវឌ្ឍន៍ អាជីព និង ការតម្លើង ឋានៈ ដល់ មន្ដ្រី * ការផ្ដល់ ប្រាក់ លាភ ការបន្ថែម និង ការលើកទឹកចិត្ដ ដល់ មន្ដ្រី ឱកាស នៃ ការទំនាក់ទំនង រវាង បុគ្គល និង ការងារ
លើស ពី នោះ ទៀត លោក រដ្ឋមន្ដ្រី កត់សម្គាល់ ថា នា ពេល បច្ចុប្បន្ន នេះ ចំនួន ស្ដ្រី ដែល បម្រើ ការងារ នៅក្នុង វិស័យ អប់រំ មាន ចំនួន ៤៦ ភាគរយ ។ នា ពេល បច្ចុប្បន្ន នេះ សង្កេតឃើញ ថា ចំនួន គរុសិស្ស និង និស្សិត ជា ស្ដ្រី មាន ចំនួន កើនឡើង ហើយ មាន ចំនួន ច្រើន ជាង គរុសិស្ស និង គរុនិស្សិត ដែល ជា បុរស ។
សូម បញ្ជាក់ ថា ឆ្លើយតប ទៅនឹង ប្រធានបទ នៃ ការអបអរសាទរ ខួប ទី១០៩ ទិវា អន្ដរជាតិ នារី ៨មីនា « មាន សន្ដិភាព មាន ការលើកកម្ពស់ សមធម៌ យេនឌ័រ » ក្រសួង អប់រំ បាន កំណត់ ទិសដៅ ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ០៩ ខែមីនា ឆ្នាំ ២០២០ ។
ជាមួយគ្នា នេះ ក្រសួង បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម ប្រុងប្រយ័ត្ន ចំពោះ បាតុភូត ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់ ដែល អាច កើត មាន ឡើង នៅ បណ្តា ខេត្ត ភាគ ពាយ័ព្យ មាន ដូចជា ខេត្ត ឧត្តរមានជ័យ បន្ទាយមានជ័យ សៀមរាប បាត់ដំបង និង បៃលិន ចាប់ពី ថ្ងៃទី ៤ - ៦ ខែមីនា ៕ ត្រូវ ខ្លាច គ្រោះថ្នាក់ ចរាចរណ៍ ជាង ខ្លាច ប៉ូលិស ចរាចរណ៍ ! ស្លាប់ ២នាក់ និង របួស ១១នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៣ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ . របួស ស្រាល ២នាក់ និង របួស ធ្ងន់ ៩នាក់ ក្នុង នោះ មិន ពាក់ មួក ៩នាក់ ។
ការថ្លែង របស់ សម្តេច តេជោ ហ៊ុន សែន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ៣មីនា លើក ទី ២២ ដែល ប្រារព្ធ ធ្វើឡើង ក្រោម ប្រធានបទ « យុវជន ដើម្បី វប្បធម៌ » នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ជំរុញ ឲ្យ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ រួម ជាមួយ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ និង ឤជ្ញាធរដែនដី គ្រប់ ជាន់ ថ្នាក់ ត្រូវ បន្ត យក ចិត្តទុកដាក់ ថែរក្សា ការពារ និង បង្ក្រាប រាល់ បទល្មើស ឱ្យ បាន ទាន់ ពេលវេលា និង ប្រកបដោយ ប្រសិទ្ធភាព នៅ តាម ទីតាំង តំបន់ ប្រាសាទ រមណីយដ្ឋាន ប្រវត្តិ សា្រស្ត វត្ត ឤ រាម សំណង់ ប្រវត្តិសាស្ត្រ និង សំណង់ ដែល មាន ឤយុកាល រាប់ រយ ឆ្នាំ នៅ តាម មូលដ្ឋាន នៅ ទូទាំង ប្រទេស ។
សម្តេច ក៏ បាន ណែនាំឲ្យ ក្រសួង វប្បធម៌ ត្រូវ បន្ត រួមគ្នា ធ្វើ បញ្ជី សារពើ ភណ្ឌ គ្រប់ ទីតាំង នៃ បេតិកភណ្ឌ រូបី ទាំងនោះ ឱ្យ បាន សព្វគ្រប់ ដើម្បី ចៀសវាង ការ រំលោភបំពាន ហើយ ត្រូវ បន្ត ទាមទារ យក មកវិញ នូវ បដិមា នានា របស់ ជាតិ ដែល បាន បាត់បង់ កន្លងមក ក្នុង អំឡុង សម័យ សង្គ្រាម ។
ជាង នេះ ទៀត នោះ សម្តេច តេជោ ហ៊ុន សែន បាន ជំរុញ ឲ្យ ក្រសួង វប្បធម៌ ត្រូវ រួមគ្នា បន្ត ការងារ អភិរក្ស បេតិកភណ្ឌ វប្បធម៌ អរូបី ទាំងឡាយ របស់ ជាតិ ដែល បាន បាត់បង់ និង ត្រូវ យកចិត្តទុកដាក់ ស្វែងរក មរតក មនុស្ស រស់ បន្ថែម ទៀត ដែល ជា ឃ្លាំង ចំណេះដឹង ក្នុង ការ បន្ត វេន ទៅ យុវជន ជំនាន់ ក្រោយ ៕
បើ តាម ក្រសួង ការពារ ជាតិ តួកគី យន្ដហោះ ចម្បាំង ខាងលើ ដែល ត្រួវ បាន បាញ់ ទម្លាក់ គឺជា យន្ដហោះ ចម្បាំង ធុន L-39 ហើយ នេះ គឺជា យន្ដហោះ ចម្បាំង ទី៣ របស់ ស៊ីរី ដែល ត្រូវបាន តួកគី បាញ់ ទម្លាក់ ចាប់តាំងពី ថ្ងៃអាទិត្យ សប្ដាហ៍ មុន មក ។ លើស ពី នេះ ទៅ ទៀត ទីភ្នាក់ងារ ព័ត៌មាន រដ្ឋ ស៊ីរី SANA ក៏ បាន ទទួលស្គាល់ ដែរ ថា យន្ដហោះ ចម្បាំង របស់ ខ្លួន ពិតជា ត្រូវបាន បាញ់ ទម្លាក់ នៅក្នុង ខេត្ត Idlib ដោយ មីស៊ីល បាញ់ ចេញ ពី យន្ដហោះ ចម្បាំង តួកគី ។
សម្តេច បាន មានប្រសាសន៍ ថា៖ ដើម្បីឱ្យ វប្បធម៌ ជាតិ ដែល ជា ដួង ព្រលឹង និង ជា អត្តសញ្ញាណ ជាតិ និង ជា ឧបករណ៍ សម្រាប់ កិច្ចសន្ទនា ការផ្សះផ្សារ សង្គម និង ជា ស្ពាន នៃ ការតភ្ជាប់ រវាង ប្រជាជាតិ មួយ ទៅ ប្រជាជាតិ មួយ ទៀត កាន់តែ មាន ការរីកចម្រើន និង មាន ភាពល្បីល្បាញ នៅ បណ្តា ឆ្នាំ ក្រោយ ៗ ទៀត ក្នុង នាម រាជ រដ្ឋាភិបាល ខ្ញុំ សូម ផ្តល់ មតិ ណែនាំ មួយចំនួន ដូច ខាងក្រោម៖
ក្នុង ឱកាស អញ្ជើញ ប្រាព្ធ ទិវា វប្បធម៌ ជាតិ ៣មីនា ក្រោម ប្រធានបទ « យុវជន ដើម្បី វប្បធម៌ ជាតិ » នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ នា ល្ងាច ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន ក្រើន រំលឹក ទៀត ថា ទាំង សិល្បករ សិល្បការិនី សិស្ស និស្សិត ក៏ ត្រូវ ដើរ តួនាទី ជា អ្នក អប់រំ បង្កើត ភាព អនាម័យ ការពារ ខ្លួន ពី ការឆ្លង ជំងឺ នេះ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ ក៏ ចង់ឲ្យ សិល្បករ សិល្បការិនី របស់ យើង ទាំងអស់ ដែល នៅ ទីនេះ ទាំង និស្សិត សិស្ស ដែល ចូលរួម នៅក្នុង ពិធី នា ថ្ងៃ នេះ ក្លាយទៅជា សកម្មជន ដើម្បី អប់រំ ពលរដ្ឋ របស់ យើង ក្រុមគ្រួសារ របស់ យើង ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង មេរោគ Covid-19 ឬ ហៅ ថា កូរ៉ូណា ថ្មី ។ ធ្វើ យ៉ាងណា យើង ខិតខំ ការពារ ជំងឺ នេះ ដែល មកដល់ ម៉ោង នេះ ពុំ ទាន់ មាន វត្តមាន ជំងឺ នេះ នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ទេ » ។
ជាមួយគ្នា នេះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ ស្នើឲ្យ សិល្បករ សិល្បការិនី ទាំងអស់ ត្រូវ ចូលរួម ប្រយុទ្ធ ប្រឆាំង ព័ត៌មាន ក្លែងក្លាយ ដែល បំផុស ឲ្យ មាន ការភ័យខ្លាច ហើយ សម្ដេច សង្ឃឹម ថា សិល្បករ សិល្បការិនី របស់ យើង គ្រប់ ទម្រង់ នឹង ក្លាយទៅជា សកម្មជន នៃ ការប្រយុទ្ធ ប្រឆាំង នៃ ព័ត៌មាន ក្លែងក្លាយ ទាក់ទង ទៅ នឹង ជំងឺ ដ៏ កាច សាហាវ នេះ ។
គួរ ជម្រាប ថា យោង តាម សេចក្ដីប្រកាស ព័ត៌មាន របស់ ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា រហូតមកដល់ ពេលនេះ ពុំ ទាន់ មាន ប្រជាជន កម្ពុជា ណា ម្នាក់ ត្រូវបាន រកឃើញ មាន ជំងឺ កូវីដ១៩ នោះ ទេ ។ ក្រសួង បាន ឲ្យដឹង ទៀត ថា វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បាន ធ្វើតេស្ត សំណាក បុគ្គល ដែល សង្ស័យ សរុប ចំនួន ១៣៥ នាក់ គិត មក ត្រឹម ថ្ងៃទី ០២ ខែមីនា ឆ្នាំ ២០២០ នេះ តែ មិន ទាន់ រកឃើញ អ្នកណា ម្នាក់ នៅក្នុង ប្រទេស កម្ពុជា មាន វីរុស កូវីដ១៩ នោះ ឡើយ ។
កន្លងទៅ មាន ជនជាតិ ចិន ម្នាក់ ដែល បាន ធ្វើដំណើរ មកពី ទីក្រុង វូហាន ប្រទេស ចិន ហើយ បាន រកឃើញ ផ្ទុក វីរុស កូវីដ១៩ នៅ ខេត្ត ព្រះសីហនុ ប៉ុន្ដែ ដោយ មាន ការយកចិត្តទុកដាក់ ព្យាបាល ពី ក្រុម គ្រូពេទ្យ ជំនាញ ជនជាតិ ចិន នោះ ត្រូវបាន ព្យាបាល ជាសះស្បើយ និង បាន ត្រឡប់ ទៅ ប្រទេស ដើម វិញ កាលពី ថ្ងៃទី ២៧ ខែមករា ឆ្នាំ ២០២០ ៕
ជុំវិញ រឿង នេះ ដែរ អាជ្ញាធរ ប៉ូលិស កំពុងតែ ស៊ើបអង្កេត និង ស្វែងរក ជនសង្ស័យ ហើយក៏ បាន ស្នើរ ឲ្យ សាក្សី នៅ កន្លែង កើត ហេតុ ចេញមក ជួយ ធ្វើ សាក្សី ផងដែរ ៕
ការលើកឡើង យ៉ាង ដូច្នេះ របស់ លោក គង់ វិបុល បាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ក្នុង សិក្ខាសាលា ស្តីពី កាតព្វកិច្ច ពន្ធ លើ ប្រាក់ ចំណូល ប្រចាំ ឆ្នាំ និង ប្រព័ន្ធ គ្រប់គ្រង ការប្រកាស ប្រព័ន្ធ អនឡាញ (E-Filing) ព្រមទាំង វិក្កយបត្រ តម្រង់ ថ្មី នៅ ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ ។
លោក អគ្គ នាយក បាន បន្ត ថា នៅក្នុង ឆ្នាំ ២០២០ នេះ កំណើន សេដ្ឋកិច្ច ពិភពលោក នឹង ថយចុះ ក្នុង នោះ រួមទាំង កម្ពុជា ផងដែរ ហើយ ការប៉ះពាល់ ទៅ ដោយ មេរោគ Covid-19 នេះ គឺ មិន មែន ប៉ះពាល់ តែ ចិន និង ប្រទេស មួយចំនួន ទេ គឺ ពិភពលោក មាន ការថយចុះ សេដ្ឋកិច្ច ជាពិសេស នៅក្នុង វិស័យ ទេសចរណ៍ ។
លោក បញ្ជាក់ ថា ខណៈ ដែល ស្ថានភាព Covid-19 បាន ធ្វើឲ្យ កំណើន សេដ្ឋកិច្ច ពិភពលោក មាន ការប្រែប្រួល អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន កំពុង យកចិត្តទុកដាក់ និង ធ្វើ ការផ្សព្វផ្សាយ តាមរយៈ នៃ កម្មវិធី ផ្សេង ៗ ជាច្រើន ដើម្បី ពង្រីក និង ពង្រឹង បន្ថែម អំពី កាតព្វកិច្ច របស់ អ្នក ជាប់ ពន្ធ គ្រប់ ប្រភេទ ដើម្បី ជំរុញ ឲ្យ គោរព តាម ច្បាប់ ជាធរមាន រួម ជាមួយ ការពង្រឹង នូវ អនុលោម ភាព និង ការពង្រឹង អំពី អភិបាលកិច្ច របស់ ក្រុមហ៊ុន ផងដែរ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣៦ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១៥ ករណី . ជួញដូរ ២១ ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ៣៦ នាក់ ។
ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា បាន បញ្ជាក់ ថា បើ តាម របាយការណ៍ នៅ ឆ្នាំ ២០១៩ និង ២០២០ នេះ កត់សម្គាល់ ឃើញ ថា សំណង់ អគារ មាន ភាពរស់រវើក ដោយសារ ការចូលរួមចំណែក កែលម្អ ទ្រទ្រង់ និង អនុវត្ត គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន កោតស សរសើរ ចំពោះ រដ្ឋបាល ខេត្ត ដែល ខិតខំ កែលម្អ លើកកម្ពស់ សោភ័ណភាព ទីប្រជុំជន ទី រួម ខេត្ត ដែល បាន ដាក់ ភ្លើង បំភ្លឺ ផ្លូវ នា ពេល រាត្រី ធ្វើ សួនច្បារ បង្កើត កម្មវិធី សប្បាយ ៗ សម្រាប់ ប្រជាពលរដ្ឋ មក ជួបជុំ លេង កំសាន្ត ក្រោម ម្លប់ សន្តិភាព ព្រមទាំង ជំរុញ ឲ្យ បន្ត លើ ការងារ នេះ បន្ថែម ទៀត ។
លោក បន្ថែម ថា ទន្ទឹមនឹង ការពង្រឹង គុណភាព វិស័យ នានា ពាក់ព័ន្ធ ដល់ វិស័យ ទេសចរណ៍ ការបង្កើត ផលិតផល ទេសចរណ៍ ថ្មី ៗ បន្ថែម ទៀត ក្នុង មូលដ្ឋាន ការអភិវឌ្ឍ ទេសចរណ៍ នៅនឹង កន្លែង ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ នៅក្នុង និង ក្រៅ ប្រទេស សំដៅ បង្កើន ការងារ បង្កើន ប្រាក់ ចំណូល និង កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាជន ។
លោក ឧប នាយក រដ្ឋមន្រ្តី ជា សុផារ៉ា ក៏ បាន ថ្លែង រ៉ាប់រង គាំទ្រ សាងសង់ ទាំងស្រុង មន្ទីរពេទ្យ បង្អែក ស្រុក ក្រូចឆ្មារ ព្រម ជាមួយនឹង អគារ ថ្មី និង មាន ភាព ទំនើបកម្ម ។
នា ឱកាស នោះ ដែរ លោក ឧប នាយក រដ្ឋមន្ត្រី បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ ទូទាំង ខេត្ត ដែល មាន សាមគ្គីភាព ផ្ទៃក្នុង បាន ល្អ រួម សហការ យ៉ាង ជិតស្និទ្ធ និង ខិតខំ បំពេញ ការងារ យ៉ាង សស្រាក់សស្រាំ រយ : ពេល ពេញ មួយ ឆ្នាំ កន្លងទៅ នេះ ក៏ ដូចជា ស្នើ ឱ្យ បន្ត អនុវត្តន៍ លើ ការងារ ឲ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត នា ឆ្នាំ ថ្មី នេះ និង ឆ្នាំ បន្ត បន្ទាប់ រហូត ទៅ ។
ជាមួយនឹង ការរីកចម្រើន លើ ពហុ វិស័យ ការងារ បន្ត កសាង ស្ថាបនា អភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ ក្នុង តំបន់ ក្រុង នៃ ទី រួម ខេត្ត គឺជា កិច្ចការ ជា អាទិភាព ដែល ត្រូវ គិតគូរ យកចិត្តទុកដាក់ ជា ចម្បង តាម គម្រោង ផែនការតម្រូវការ និង សំណូមពរ ជាក់ស្តែង ផងដែរ ៕ ទេសរដ្ឋមន្ដ្រី គន់ គីម ដាក់ចេញ ទិសដៅ យុទ្ធសាស្ត្រ ការងារ ចំនួន ៨ ចំណុច ដល់ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ សម្រាប់ អនុវត្ត បន្ដ
( ឧត្ដរ មានជ័យ )៖ ក្នុង កម្មវិធី បិទ អង្គ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៩ និង ទិសដៅ ឆ្នាំ ២០២០ ដែល ប្រព្រឹត្តិ ទៅ នា រសៀល ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ ទេសរដ្ឋមន្ដ្រី គន់ គីម ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ខេត្ត ឧត្តរមានជ័យ បាន ដាក់ចេញ ទិសដៅ ការងារ ចំនួន ប្រាំ៣ ចំណុច សម្រាប់ ខេត្ត យក ទៅ អនុវត្ត បន្ដ ។
អនុសាសន៍ ទាំង ៨ចំណុច នោះ រួម មាន ទី ១៖ ការពង្រឹង សន្តិភាព និង ស្ថិរភាព នយោបាយ . ទី ២៖ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម . ទី ៣៖ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម និង ទេសចរណ៍ . ទី ៤៖ ការអភិវឌ្ឍ ទីក្រុង . ទី ៥៖ កំណែទម្រង់ វិមជ្ឈការ និង វិសហមជ្ឈការ . ទី ៦៖ ការផ្តល់ សេវា សាធារណៈ និង ការដោះស្រាយ បញ្ហា ប្រឈម នៅ មូលដ្ឋាន . ទី ៧៖ ការគ្រប់គ្រង និង ការអភិវឌ្ឍ តំបន់ ព្រំដែន និង ទី៨៖ ការពង្រឹង របៀបរបប ការងារ ។
ក្រោយពី ស្តាប់ របាយការណ៍ បូកសរុប សន្និបាត របស់ លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត រួច មក ទេសរដ្ឋមន្ដ្រី គន់ គីម ក៏ បាន នាំ កោតសរសើរ ខ្ពស់ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា . សម្តេច ក្រឡាហោម ស ខេង និង ក្នុង នាម លោក ផ្ទាល់ ចំពោះ រដ្ឋបាល ខេត្ត ដែល សម្រេចបាន សមិទ្ធផល ល្អ នា ឆ្នាំ កន្លងមក រួម ទាំង ការងារ អតីត យុទ្ធជន ផងដែរ ។
លើស ពី នេះ ត្រូវ អនុវត្ត តាម កំណែទម្រង់ របស់ រាជ រដ្ឋាភិបាល អំពី ការផ្ទេរ អំណាច និង ធនធាន មក ថ្នាក់ ក្រោម ជាតិ ដូច្នេះ ក្រុង ស្រុក - ខណ្ឌ ឃុំ - សង្កាត់ ត្រូវ រៀបចំ ទំនើបកម្ម ផែនការអនុវត្ត ការងារ ផ្តល់ សេវា សាធារណៈ និង ដោះស្រាយ ការ ប្រឈម របស់ ប្រជាពលរដ្ឋ មូលដ្ឋាន ឲ្យបាន ទាន់ ពេល វេលា ។
ក្នុង ការងារ គ្រោះមហន្តរាយ ទេសរដ្ឋមន្ដ្រី គន់ គីម បាន សង្កត់ធ្ងន់ ថា គណៈកម្មធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ថ្នាក់ ក្រោម ជាតិ និង ថ្នាក់ មូលដ្ឋាន ត្រូវ ណែនាំ ប្រជាពលរដ្ឋ ឲ្យ ចេះ សន្សំ ទឹក ទុក សម្រាប់ រដូវ ប្រាំង ខាងមុខ ព្រមទាំង យកចិត្តទុកដាក់ ត្រៀម រៀបចំ និង ពង្រឹង ភាពធន់ ជាមុន សម្រាប់ នា រដូវ ទឹក ជំនន់ ខាងមុខ នេះ ។
នៅក្នុង សន្និបាត នេះ រដ្ឋបាល ឃុំ សង្កាត់ និង ប៉ុស្តិ៍ រដ្ឋបាល ជាច្រើន ត្រូវបាន ទេសរដ្ឋមន្ត្រី គន់ គីម ប្រគល់ ប័ណ្ណ សរសើរ ជូន ផងដែរ ៕ អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ ដឹកនាំ ប្រតិភូ ចុះ សួរសុខទុក្ខ កងកម្លាំង នៅ អង្គភាព យោធ ភូមិភាគ ពិសេស
( ភ្នំពេញ ) ៖ ដើម្បី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ នា ពេល ខាងមុខ នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ បាន ដឹកនាំ ប្រតិភូ អគ្គ បញ្ជាការដ្ឋាន ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ទៅ ឧបត្ថម្ភ ដល់ កងទ័ព នៅ យោធ ភូមិភាគ ពិសេស ។
ពិធី សំណេះសំណាល បាន ធ្វើឡើង នៅ មូលដ្ឋាន ឈរជើង ស្ថិត ក្នុង សង្កាត់ រលួស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ៤ ខែមីនា ឆ្នាំ ២០២០ នេះ ដោយ មាន ការ អម ដំណើរ ពី ថ្នាក់ដឹកនាំ ជា អគ្គ មេបញ្ជាការ រង និង នាយក ស្ថាប័ន មួយចំនួន ទៀត ផងដែរ ។
នៅក្នុង មតិ សំណេះសំណាល នា ឱកាស នោះ នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន បាន ថ្លែង កាផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រិទ្ធ បណ្ឌិត ជូន ដល់ ថ្នាក់ដឹកនាំ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន យោធ ភូមិភាគ ពិសេស ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ដែល នឹង ឈន មកដល់ ក្នុង ថ្ងៃ ខាងមុខ ។
នាយ ឧត្ដមសេនីយ៍ អគ្គ មេបញ្ជាការ បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ គំរូវីរៈ ភាព របស់ កងកម្លាំង ទាំងអស់ ដែល បាន ខិតខំ បំពេញ កាតព្វកិច្ច បំរើ ជាតិ មាតុភូមិ ប្រកបដោយ ទំនួល ខុសត្រូវ ខ្ពស់ ចំពោះ ការការពារ បូរណភាព ទឹក ។
នាយ ឧត្ដមសេនីយ៍ បាន លើកឡើង ពី ស្ថានការណ៍ ជាតិ អន្តរជាតិ ដែល កំពុង កើតឡើង ក្នុង ពេល បច្ចុប្បន្ន ក្នុង នោះ សម្រាប់ កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ជម្នះ ពុះពារ គ្រប់ ឧបសគ្គ ដើម្បី រក្សា ស្ថេរភាព និង ការរីកចម្រើន របស់ សង្គមជាតិ ។
នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន បាន គូសបញ្ជាក់ ថា បច្ចុប្បន្ន បើ ទោះបីជា កម្ពុជា មិន មាន ករណី ជំងឺ រលាក សួត បង្ក ដោយ វីរុស កូរ៉ូណា ប្រភេទ ថ្មី នេះ ក៏ដោយ ក៏ នាយ ទាហាន ពល ទាហាន គ្រប់ រូប ត្រូវ មាន ការប្រុងប្រយ័ត្ន ផ្ទាល់ខ្លួន ដើម្បី ការពារ សុខភាព ពី ការឆ្លង ជំងឺ នេះ តារយៈ ការអនាម័យ លាង ដៃ ឱ្យ បាន ញឹកញាប់ ជាមួយ សាប៊ូ ព្រមទាំង ប្រកាន់ខ្ជាប់ នូវ ការអនុវត្ត អនាម័យ ចំណីអាហារ ដែល មាន សុវត្ថិភាពល្អ ។
នាយ ឧត្ដមសេនីយ៍ អគ្គ មេបញ្ជាការ បាន ផ្តាំផ្ញើ ដល់ មេបញ្ជាការ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ គ្រប់គ្រង កម្លាំង សម្ភារ គ្រឿង បំពាក់ ឲ្យបាន ល្អ ក្នុង នោះ ត្រូវ យកចិត្តទុកដាក់ ដល់ ការបើក វគ្គ ផ្សព្វផ្សាយ អប់រំ រៀនសូត្រ ជាប្រចាំ ដើម្បីឲ្យ យោធិន គ្រប់ រូប យល់ ច្បាស់ អំពី ច្បាប់ សារាចរ កម្មវិធី នយោបាយ របស់ រាជ រដ្ឋាភិបាល ជាពិសេស តួនាទី ភារកិច្ច ក្រិត្យ វិន័យ របស់ កងយោធពល ខេមរភូមិន្ទ និង កាត់បន្ថយ ជា អប្បរមា នូវ បាតុភាព ខុសឆ្គង នានា ។
ទន្ទឹម នោះ ដែរ នាយ ឧត្ដមសេនីយ៍ ក៏ បាន ក្រើន រម្លឹក ដល់ ថ្នាក់ដឹកនាំ នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន ត្រូវ ពង្រឹង ការសាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ឲ្យបាន ល្អ និង ត្រៀម គ្រប់ មធ្យោបាយ ក្នុង ការ ចូលរួម ជួយសង្គ្រោះ ពី គ្រោះមហន្តរាយ នានា ដែល មាន ឡើង ជា យថាហេតុ ក្នុង នោះ មាន គ្រោះ រាំងស្ងួត ជាដើម ៕
( ភ្នំពេញ ) ៖ លោក គង់ សោភ័ណ្ឌ ឋានន្តរស័ក្ដិ ឧត្តម មន្ត្រី ថ្នាក់ លេខ ៥ កាលពី ថ្ងៃទី ១៧ ខែកុម្ភៈ ឆ្នាំ ២០២០ ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា អភិបាល នៃ គណៈអភិបាល ខេត្ត កណ្ដាល តាម សំណើរ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
នៅ ព្រឹក ថ្ងៃទី ៤ ខែមីនា ឆ្នាំ ២០២០ នេះ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី និង ជា រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ បាន អញ្ជើញ ប្រកាស ឲ្យ ចូលកាន់ តំណែង ជា អភិបាល ខេត្ត កណ្តាល ថ្មី ជំនួស លោក ម៉ៅ ភិរុណ ដែល ត្រូវបាន តែងតាំង ជា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត វិញ ។
អ្នក ស្គាល់ លោក គង់ សោភ័ណ្ឌ បាន ឲ្យដឹង ថា លោក ជា មន្រ្តី ម្នាក់ ដែល មាន សមត្ថភាព និង ទទួលបាន ការកោតសរសើរ លើ ការបំពេញ ភារកិច្ច របស់ ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ និង ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ផងដែរ ។
ប្រជាពលរដ្ឋ សង្ឃឹម យ៉ាង ជឿជាក់ ថា ក្រោយ ប្រកាស ឲ្យ ចូលកាន់ តំណែង ជា អភិបាល ខេត្ត កណ្តាល នឹង នឹង ខិតខំ ប្រឹងប្រែង ឲ្យ អស់ កម្លាំង កាយ ចិត្ត ជួយ ដោះស្រាយ បញ្ហា គ្រប់ បែបយ៉ាង ជូន ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ឲ្យ មាន ប្រសិទ្ធភាព ។
* ទី ១៖ ជីវប្រវត្តិ សង្ខេប របស់ លោក គង់ សោភ័ណ្ឌ
* ទី២ ៖ ជីវប្រវត្តិ នៃ ការរស់នៅ មុន និង ក្រោយ សម័យ ប៉ុល ពត និង កម្រិត វប្បធម៌ របស់ លោក គង់ សោភ័ណ្ឌ
* ទី៣៖ បទពិសោធន៍ ការងារ ក្រោយ បញ្ចប់ ការសិក្សា របស់ លោក គង់ សោភ័ណ្ឌ
* ទី៤៖ ស្នាដៃ និង ការសរសើរ ជូន រង្វាន់
សូម ជម្រាប ជូន ថា អភិបាល ខេត្ត កណ្ដាល មាន ចំនួន ១៣រូប ហើយ ដែល គ្រប់គ្រង ខេត្ត កណ្ដាល ចាប់តាំងពី ឆ្នាំ ១៩៧៩មក ហើយ ចុងក្រោយ ទី ១៣ នេះ គឺ លោក គង់ សោភ័ណ្ឌ ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា អភិបាល នៃ គណៈអភិបាល ខេត្ត កណ្ដាល កាល ថ្ងៃទី ១៧ ខែកុម្ភៈ ឆ្នាំ ២០២០ ៕ អ្នកដឹកនាំ កំពូល ផ្នែក ថែទាំ សុខភាព អន្តរជាតិ បាន មកដល់ ប្រទេស កម្ពុជា ហើយ
មាន កំណើត និង សញ្ជាតិ សិង្ហបុរី លោក បណ្ឌិត ថេយ គ្រីស្តូហ្វ័រ ពោរពេញ ដោយ បទពិសោធន៍ ជាង ២០ ឆ្នាំ នៅក្នុង វិស័យ សុខាភិបាល និង ជា បុគ្គល ដ៏ សំខាន់ ម្នាក់ ក្នុង អំឡុង ពេល វិបត្តិ វីរុស សា (SARS) នៅ ឆ្នាំ ២០០៣ នៅឯ មន្ទីរពេទ្យ តាន់ តុក សេង ដ៏ ល្បីល្បាញ មួយ នៅ ប្រទេស សឹង្ហបុរី ។
តាមរយៈ មន្ទីរពេទ្យ ដឹ ប្រេស្ទី ហ្ស៍ ដែល មាន ទស្សនៈ វិស័យ និង ឆន្ទៈ ខ្ពស់ ក្នុង ការជួយ ថែទាំ សុខ មាលភាព ប្រជាពលរដ្ឋ កម្ពុជា លោក គ្រីស្តូហ្វ័រ ក៏ សម្រេច ចូលមក ដឹកនាំ ជា នាយក ប្រតិបត្តិ របស់ មន្ទីរពេទ្យ មួយ នេះ ជាមួយ អ្នកជំនាញ ជាច្រើន ទៀត មកពី សិង្ហបុរី បារាំង អាមេរិក និង កាណាដា ។
លោក បណ្ឌិត គ្រីស្តូហ្វ័រ បាន មានប្រសាសន៍ ថា “ ជាមួយនឹង បទពិសោធន៍ ក្នុង វិស័យ សុខាភិបាល និង អាជីវកម្ម ជាច្រើន ឆ្នាំ របស់ ខ្ញុំ ខ្ញុំ មាន ភាពជឿជាក់ យ៉ាង មុតមាំ ថា ខ្ញុំ អាច ចូលរួមចំណែក មិន ត្រឹមតែ ជាមួយ មន្ទីរពេទ្យ ដឹ ប្រេស្ទីហ្ស៍ ប៉ុណ្ណោះ ទេ ថែមទាំង សម្រាប់ ប្រទេស កម្ពុជា នៅក្នុង វិស័យ ផ្សេង ៗ ទៀត ។ សូម យើង ទាំងអស់ គ្នា ចូលរួម ធ្វើ នូវ អ្វី ៗ ដែល ល្អ ដើម្បីឲ្យ ប្រទេស កម្ពុជា កាន់តែ ប្រសើរឡើង ” ។
លោក បណ្ឌិត គ្រីស្តូហ្វ័រ បាន បន្ថែម ថា « សេវាកម្ម និង ស្តង់ដារ ដែល យើង នាំមក កម្ពុជា សុទ្ទ តែ លំដាប់ អន្តរជាតិ និង តាម វិធីសាស្រ្ត ថែទាំ សុខភាព របស់ សិង្ហបុរី ដោយ វេជ្ជបណ្ឌិត គិលានុបដ្ឋាយិកា និង អ្នកជំនាញ ដ៏ ល្អ បំផុត ជាមួយនឹង ឧបករណ៍ ទំនើប ចុងក្រោយ » ។
មន្ទីរពេទ្យ ដឹ ប្រេស្ទី ហ្ស៍ ត្រូវបាន បង្កើតឡើង នៅ ឆ្នាំ ២០១៩ ជាមួយនឹង ចក្ខុវិស័យ ឲ្យ ក្លាយទៅជា ដៃគូ ឈាន មុខ គេ ក្នុង ការថែទាំ សុខភាព ប្រចាំ ជីវិត របស់ លោក អ្នក ។
( ប្រេស៊ីឡា) ៖ មនុស្ស យ៉ាងតិច ២១ នាក់ បាន បាត់បង់ជីវិត និង ៣២ នាក់ កំពុង បាត់ខ្លួន ក្រោយ មាន ភ្លៀង ធ្លាក់ ខ្លាំង ហើយ បង្ក ទៅជា ទឹក ជំនន់ និង បំណាក់ ដី នៅ ភាគ អាគ្នេយ៍ ប្រទេស ប្រេស៊ីល ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ព្រឹក ថ្ងៃពុធ ទី ០៤ ខែមីនា ឆ្នាំ ២០២០ ។
( ប៉េកាំង )៖ គណៈកម្មការ សុខាភិបាល ចិន នៅ ថ្ងៃពុធ នេះ បាន ឱ្យដឹង ថា អ្នកជំងឺ COVID-19 សរុប ២. ៦៥២នាក់ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ នៅ រយៈពេល ពេញ មួយ ថ្ងៃអង្គារ ម្សិលមិញ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃពុធ ទី ០៤ ខែមីនា ឆ្នាំ ២០២០ ។
បើ តាម គណៈកម្មាការ សុខាភិបាល ចិន អ្នកជំងឺ សរុប ចំនួន ៤៩. ៨៥៦ នាក់ ហើយ បាន ចាកចេញ ពី មន្ទីរពេទ្យ នៅ ទូទាំំង ប្រទេស ចិន ជាពិសេស ខេត្ត ហ៊ូប៉ី ។ បន្ថែម ពីលើ នេះ នៅក្នុង របាយការណ៍ ប្រចាំ ថ្ងៃ ដែល ចេញ នៅ ព្រឹក ថ្ងៃពុធ នេះ គណៈកម្មការ ក៏ បាន ឱ្យដឹង ដែរ ថា ចំនួន ឆ្លង បាន កើន ដល់ ៨០. ២៧០ នាក់ និង ស្លាប់ ២. ៩៨១នាក់ ។
យោង តាម របាយការណ៍ ប្រចាំ ព្រឹក ថ្ងៃពុធ នេះ របស់ គណៈកម្មការ ជាតិ សុខាភិបាល ចិន ពេញ មួយ ថ្ងៃអង្គារ ម្សិលមិញ នេះ មនុស្ស ចំនួន ១១៩ នាក់ បន្ថែម ទៀត ត្រូវបាន ធ្វើតេស្ត ឃើញ ថា មាន ផ្ទុក មេរោគ COVID-19 ហើយ ស្រប ពេល ជាមួយគ្នា អ្នកជំងឺ ៣៨ នាក់ បាន បាត់បង់ជីវិត ។
ផ្ទះ ថ្ម ថ្មី ២ខ្នង ព្រះរាជ អំណោយ ដ៏ ឧត្តុង្គឧត្តម របស់ សម្តេច ម៉ែ បាន ប្រគល់ ជូន ប្រជារាស្ត្រ ២គ្រួសារ នៅ ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ ប្រជានុរាស្ត្រ ២គ្រួសារ រស់ នៅ ស្រុក ថ្ពង ខេត្ត កំពង់ស្ពឺ រំភេីប រីករាយ ឥត ឧបមារ ពេល ដែល ខ្ទម ចាស់ របស់ គាត់ បាន ប្រែក្លាយជា ផ្ទះ ថ្ម ថ្មី ដែល ជា ព្រះរាជ អំណោយ ដ៏ ឧត្តុង្គឧត្តម របស់ សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ព្រះប្រធាន កិត្តិយស កាកបាទ ក្រហម កម្ពុជា តាមរយៈ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ។
ពិធី សម្ពោធ ប្រគល់ ផ្ទះ នេះ បាន ប្រព្រឹត្តទៅ នៅ ថ្ងៃអង្គារ ១០កេីត ខែ ផល្គុន ឆ្នាំ កុរ ឯកស័ក ព .ស.២៥៦៣ ត្រូវនឹង ថ្ងៃទី ៣ ខែមីនា ឆ្នាំ ២០២០ ក្រោម វត្តមាន លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា និង សហការី រួម ជាមួយ ថ្នាក់ដឹកនាំ - មន្ត្រី យុវជន នៃ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ស្ពឺ ព្រមទាំង លោកយាយ លោក តា ចំនួន ៥០ នាក់ ។
ជាមួយគ្នា នេះ លោក តា លោកយាយ ដែល អញ្ជើញ ក្នុង ឱកាស នោះ បាន ចូលរួម សម្តែង នូវ អំណរ សាទរ ជាមួយ ម្ចាស់ ផ្ទះ ថ្មី ទាំង២ ដែល សុទ្ធតែ ជា អ្នក លំបាក បំផុត ជាង គេ ព្រមទាំង បាន បួងសួង ថ្វាយ ព្រះពរ ចំពោះ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ និង បួងសួង ជូនពរ ដល់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី. សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន សូម មាន សុខភាព ល្អ រឹងមាំ ជន្មាយុ យឺន យូរ ដើម្បី ជា ម្លប់ ដល់ ប្រជានុរាស្ត្រ គ្រប់ រូប ។
សម្តេច ស ខេង អញ្ជើញ ប្រកាស តែងតាំង អភិបាល និង អភិបាល រង ខេត្ត កណ្តាល . លោក គង់ សោភ័ណ្ឌ ជា អភិបាល ខេត្ត រីឯ លោក នុត ពុធ ដារ៉ា ត្រូវ ផ្ទេរ មក ជា អភិបាល រង ខេត្ត
( ភ្នំពេញ ) ៖ នៅ វេលា ម៉ោង ៨ព្រឹក ថ្ងៃទី ៤ ខែមីនា ឆ្នាំ ២០២០ ខាងមុខ នេះ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី និង ជា រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ បាន អញ្ជើញ ប្រកាស ឲ្យ ចូលកាន់ តំណែង អភិបាល ខេត្ត និង អភិបាល រង ខេត្ត កណ្តាល ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ១៧ ខែកុម្ភ ឆ្នាំ ២០២០ លោក គង់ សោភ័ណ្ឌ អភិបាល រង ខេត្ត កណ្តាល ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង ជា អភិបាល ខេត្ត កណ្តាល ជំនួស លោក ម៉ៅ ភិរុណ ។ ដោយឡែក កាលពី ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២០ លោក នុត ពុធ ដារ៉ា អភិបាល រង ខេត្ត ក្រចេះ ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រេច ផ្លាស់ប្តូរ មក ជា អភិបាល រង កណ្តាល វិញ ជំនួស កន្លែង លោក គង់ សោភ័ណ្ឌ ។
សម្រាប់ ប្រវត្តិ ចូល បម្រើ ការងារ របស់ លោក គង់ សោភ័ណ្ឌ មាន ដូច ខាងក្រោម៖
អ្នក ស្គាល់ លោក គង់ សោភ័ណ្ឌ ដែល បច្ចុប្បន្ន មាន ឋានន្តរស័ក្តិ ជា ឧត្តម ថ្នាក់ លេខ ៥ បាន ឲ្យដឹង ថា លោក ជា មន្រ្តី ម្នាក់ ដែល មាន សមត្ថភាព និង ទទួលបាន ការកោតសរសើរ លើ ការបំពេញ ភារកិច្ច របស់ ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ និង ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ផងដែរ ។
សម្រាប់ ប្រវត្តិ ចូល បម្រើ ការងារ របស់ លោក នុត ពុធ ដារ៉ា មាន ដូច ខាងក្រោម៖
* នៅ ឆ្នាំ ២០០៥ លោក ត្រូវបាន ផ្ទេរ មក បំរើ ការងារ ជា អភិបាល រង ខណ្ឌ ឬស្សីកែវ
* នៅ ឆ្នាំ ២០១២ លោក ត្រូវបាន តែងតាំង ឲ្យ កាន់ តំណែង ចំនួន ពីរ អណត្តិ ជា អភិបាល ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។
ក្រោយ ចប់ អាណត្តិ អភិបាល ខណ្ឌ កាលពី ថ្ងៃទី ៩ ខែធ្នូ ឆ្នាំ ២០១៩ លោក ត្រូវបាន តែងតាំង ជា អភិបាល រង នៃ គណៈអភិបាល ខេត្ត ក្រចេះ ហើយ បច្ចុប្បន្ន ត្រូវបាន ផ្ទេរ ភារកិច្ច ជា អភិបាល រង នៃ គណៈអភិបាល ខេត្ត កណ្តាល ហើយ បច្ចុប្បន្ន លោក ក៏ ជា ជំនួយការ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ផងដែរ ។
លោក ប្រធានាធិបតី បាន ណែនាំ សមាជិក គណៈ រដ្ឋមន្រ្តី របស់ ខ្លួន ឲ្យ ចាត់ វិធានការ ដើម្បី ធានា បាន នូវ មូលដ្ឋាន ទំនិញ និង ឱសថ ។ ព្រម ជាមួយ នោះ រដ្ឋាភិបាល ក៏ កំពុង ណែនាំ ដល់ ផ្សារ ទំនើប និង អ្នកលក់ រាយ ឲ្យ ចាប់ផ្តើម លក់ ទំនិញ មាន ចំនួន កំណត់ ដើម្បី ការពារ ប្រជាជន ពី ការទិញ ស្តុក ទុក ។
( ភ្នំពេញ ) ៖ ក្រសួង មុខងារ សាធារណៈ បាន ចេញ សេចក្តីជូនដំណឹង ស្ដីពី ការប្រឡង ប្រជែង ជ្រើសរើស និសិ្សត និង មន្ដ្រីរាជការ ស៊ីវិល ឱ្យ ចូល បម្រើ ការងារ ក្នុង ក្របខណ្ឌ ក្រសួង មុខងារ សាធារណៈ ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ក្រសួង ពាណិជ្ជកម្ម ក្រសួង ធនធាន ទឹក និង ឧតុនិយម និង រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល សម្រាប់ ផែនការ ក្របខណ្ឌ ឆ្នាំ ២០២០ ។
១៖ ក្របខណ្ឌ ក្រសួង មុខងារ សាធារណៈ ចំនួន ០៨កន្លែង ២៖ ក្របខណ្ឌ ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច ចំនួន ០៥កន្លែង ៣៖ ក្របខណ្ឌ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ចំនួន ១៣៣ កន្លែង ៤៖ ក្របខណ្ឌ ក្រសួង ពាណិជ្ជកម្ម ចំនួន ៣៦កន្លែង ៥៖ ក្របខណ្ឌ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ចំនួន ២៨កន្លែង ៦៖ ក្របខណ្ឌ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល ចំនួន ១២កន្លែង
ព័ត៌មាន លម្អិត សូម អាន សេចក្តីជូនដំណឹង ទាំង ស្រុង៖ ក្រសួង ពាណិជ្ជកម្ម ថៃ ពន្យារ ពេល រៀបចំ ពិព័រណ៍ គ្រឿង បន្លាស់ រថយន្ដ នៅ ទីក្រុង បាងកក ដោយសារ ការរីករាលដាល់ នៃ ជំងឺ COVID-19
មេ សិទ្ធិ មនុស្ស កម្ពុជា វាយតម្លៃ ខ្ពស់ ចំពោះ អ្នក ច្បាប់ និង មេធាវី របស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ដែល បំពេញ ភារកិច្ច ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ជូន ដល់ ពលរដ្ឋ ក្រីក្រ
( ភ្នំពេញ ) ៖ លោក កែវ រ៉េមី រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល របស់ អ្នក ច្បាប់ និង ក្រុម មេធាវី របស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ដែល បាន ខិតខំ បំពេញ ភារកិច្ច របស់ ខ្លួន ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ និង រហ័ស ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ដែល គ្មាន លទ្ធភាព ពឹងពាក់ មេធាវី ឯកជន ដោយ មិន យក កម្រៃ ដែល ជា ផ្នែក មួយ បាន ចូលរួមចំណែក បម្រើ ដល់ សង្គមជាតិ យ៉ាង ច្រើន ។
ការវាយតម្លៃ ខ្ពស់ បែប នេះ របស់ លោក កែវ រ៉េមី បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ៣ ខែមីនា ឆ្នាំ ២០២០ នេះ នៅក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង កិច្ចប្រជុំ បូកសរុប ការងារ និង វាយតម្លៃ ប្រសិទ្ធភាព ការងារ របស់ អ្នក ច្បាប់ និង ក្រុម មេធាវី របស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ អនុប្រធាន សមាជិក ក្រុម អ្នកច្បាប់ និង មេធាវី របស់ គណៈកម្មាធិការ យ៉ាង ច្រើន ផងដែរ ។
ក្នុង ឱកាស នោះ ដែរ លោក កែវ រ៉េមី បាន ថ្លែង ថា ក្រុម អ្នកច្បាប់ និង មេធាវី របស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន ផ្តល់ នូវ ជំនួយ ផ្នែក ច្បាប់ ចំនួន ០២ យ៉ាង សំខាន់ ដែល ក្រុម អ្នកច្បាប់ និង មេធាវី បាន សម្រេច នា ពេល កន្លងមក រួម មាន ទី១៖ ការផ្តល់ ប្រឹក្សា ផ្នែក ច្បាប់ តាម ទូរស័ព្ទ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ សេវា និង ទី២៖ ការប្រឹក្សា ផ្នែក ច្បាប់ និង ការការពារ ក្តី នៅ តុលាការ ដែល ពាក់ព័ន្ធ នឹង ការរំលោភបំពាន សិទ្ធិ មនុស្ស ជាដើម ។
( ភ្នំពេញ ) ៖ ពិត ណាស់ រាជ រដ្ឋាភិបាល តែង បាន គាំទ្រ និង បាន ផ្តល់ ឤទិភាព ខ្ពស់ ចំពោះ វិស័យ វប្បធម៌ ដោយ ចាត់ទុក ថា វប្បធម៌ គឺជា ព្រលឹង ជាតិ និង ជា អត្តសញ្ញាណ ជាតិ ។
ដូច ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ក្នុង ពិធី អបអរសាទរ ទិវា វប្បធម៌ ជាតិ ៣មីនា លើក ទី ២២ ឆ្នាំ ២០២០ រាជ រដ្ឋាភិបាល បាន យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ ការរក្សា តម្លៃ នៃ វប្បធម៌ ដោយ បាន ដាក់ចេញ នៅ ចំណាត់ការ ជា បន្តបន្ទាប់ មិន អនុញ្ញាតឲ្យ រាល់ សកម្មភាព ទាំងឡាយ ណា ដែល នាំអោយ វប្បធម៌ ជាតិ អាប់ ឱន អាច ប្រព្រឹត្តទៅ បាន ក្នុង សង្គម ឡើយ ។
ចំណាត់ការ ដែល បាន ដាក់ចេញ នេះ គឺជា ការដាស់តឿន ចំពោះ អ្នក ទាំងឡាយ ណា ដែល កំពុង លង់ ក្នុង ទង្វើ មិន សមរម្យ របស់ ខ្លួន ដើម្បី តែ ប្រយោជន៍ ខ្លួន អោយ មាន ការភ្ញាក់ រលឹក ថា សកម្មភាព របស់ ពួកគេ បាន ប្រាសចាក សីលធម៌ នៃ ការរស់នៅ ក្នុង សង្គម ខ្មែរ ហើយ អាច ឈាន ទៅដល់ ការនាំឲ្យបាត់ អត្តសញ្ញាណ ជាតិ របស់ ខ្លួន ផងដែរ ។
លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន លើកឡើង ថា ក្នុង នាម ជា ប្រជាជាតិ ខ្មែរ យើង អាច ចូលរួម អភិរក្ស វប្បធម៌ ក្នុង ទម្រង់ ផ្សេង ៗ គ្នា តាម លទ្ធភាព ដែល យើង មាន ។ យើង ទាំងអស់ គ្នា ជា អ្នក បន្ត វេន ក្នុង ការថែរក្សា និង លើកតម្កើន វប្បធម៌ របស់ យើង ដូចនេះ សូម យុវជន ទាំងអស់ ស្វែងយល់ ឲ្យ ច្បាស់ នូវ អ្វី ដែល ជា ទង្វេី របស់ ខ្លួន ហើយ អ្វី ដែល ជា វប្បធម៌ បរទេស ដើម្បី ជៀសវាង ការភ្លេច ឬ បាត់បង់ អ្វី ដែល ជា មរតក ខ្លួន ឯង ។
លោក ហ៊ុន ម៉ានី បាន បន្ដ ថា ទន្ទឹមនឹង នេះ ការចេះ ថ្លឹងថ្លែង ពិចារណា ចំពោះ សកម្មភាព ឬ កាយវិការ របស់ ខ្លួន ជា លក្ខណៈ បុគ្គល គឺជា ការចូលរួមចំណែក ក្នុង រក្សា តម្លៃ នៃ វប្បធម៌ ព្រោះ ភាព អន់ថយ នៃ សីលធម៌ និង គុណធម៌ សង្គម ដែល ស្តែង ចេញ ពី ទង្វេី បុគ្គល នឹង ប៉ះពាល់ និរន្តភាព នៃ វប្បធម៌ ៕
អនុសាសន៍ ណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ដាក់ ឲ្យ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ និង ភាគី ពាក់ព័ន្ធ ទាំងអស់ បន្ត ផ្តល់ អនុសាសន៍ សំខាន់ ៗ ៩ ចំណុច ឲ្យ ក្រសួង វប្បធម៌ បន្ត ការងារ អភិរក្ស និង អភិវឌ្ឍ វប្បធម៌ ជាតិ រូបី និង អរូបី ប្រកបដោយ តម្លាភាព រួម មាន៖
ទី២៖ ត្រូវ រួមគ្នា បន្ត ការងារ អភិរក្ស បេតិកភណ្ឌ វប្បធម៌ អរូបី ទាំងឡាយ របស់ ជាតិ ដែល បាន បាត់បង់ និង ត្រូវ យកចិត្តទុកដាក់ ស្វែងរក មរតក មនុស្ស រស់ បន្ថែម ទៀត ដែល ជា ឃ្លាំង ចំណេះដឹង ក្នុង ការ បន្ត វេន ទៅ យុវជន ជំនាន់ ក្រោយ ។
ទី៣៖ ត្រូវ បន្ត កិច្ចសហការ ជាមួយ ក្រសួង ទេសចរណ៍ ធ្វើ ការផ្សព្វផ្សាយ នូវ សក្តានុពល ទេសចរណ៍ វប្បធម៌ ជាតិ ឱ្យ បាន កាន់តែ ទូលំទូលាយ ក្នុង គ្រប់ រូបភាព សម្រាប់ ទេសចរ ជាតិ និង អន្តរជាតិ ដើម្បី លើកតម្លៃ វប្បធម៌ ជាតិ រួមចំណែក ជំរុញ កំណើន សេដ្ឋកិច្ច ជាតិ និង កាត់បន្ថយ ភាពក្រីក្រ ។
ទី ៤៖ សម្តេច សូម គាំទ្រ ចំពោះ កិច្ចសហការ របស់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ និង ក្រសួង ព័ត៌មាន ដែល បាន ធ្វើឱ្យ វិស័យ ភាពយន្ត ភាគ ខ្មែរ បាន និង កំពុង មាន ភាពរីកចម្រើន គួរឱ្យ កត់សម្គាល់ តាមរយៈ ការកំណត់ ម៉ោង មាស សម្រាប់ ធ្វើ ការចាក់ផ្សាយ ភាពយន្ត ភាគ ខ្មែរ នា ពេល កន្លងមក ។ ជាមួយគ្នា នេះ ឤជ្ញាធរដែនដី គ្រប់ ជាន់ ថ្នាក់ ត្រូវ សហការ ជួយ សម្រួល ផ្តល់ ទីតាំង ក្នុង ដែនដី របស់ ខ្លួន ដើម្បី សម្រួល ដំណើរការ នៃ ការថត និង ផលិត ខ្សែភាពយន្ត គ្រប់ ប្រភេទ ។
ទី៥៖ ត្រូវ បន្ត កិច្ចសហការ ជាមួយ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បំផុស សកម្មភាព គ្រប់ ស្ថានទូត និង ស្ថាន កុងស៊ុល កម្ពុជា ប្រចាំ នៅ បរទេស រៀបចំ ព្រឹត្តិការណ៍ វប្បធម៌ ខ្មែរ ឱ្យ បាន ទៀងទាត់ ជារៀងរាល់ ឆ្នាំ ដើម្បី ផ្សព្វផ្សាយ វប្បធម៌ ជាតិ ជាមួយនឹង ការពង្រឹង នយោបាយ វប្បធម៌ ការទូត ហើយ ត្រូវ បំផុស ឱ្យ សហគមន៍ ខ្មែរ នៅ បរទេស ចូលរួម រៀបចំ កម្មវិធី ទិវា វប្បធម៌ ជាតិ ឱ្យ បាន អធិកអធម និង ទូលំទូលាយ ។
ទី៦៖ ត្រូវ រួមគ្នា សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ ឤជ្ញាធរដែនដី តាម មូលដ្ឋាន នានា ថែរក្សា ការពារ នូវ ប្រពៃណី ទំនៀមទម្លាប់ និង ទីតាំង គោរព បូជា របស់ បងប្អូន ជនជាតិ ដើម ភាគ តិច ដែល ជា ផ្នែក មួយ នៃ វប្បធម៌ ដ៏ យូរ លង់ របស់ ប្រជាជាតិ យើង ប្រកបដោយ ប្រសិទ្ធភាព ។
ទី៧៖ ត្រូវ បន្ត សហការ ជាមួយ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ជាពិសេស ជាមួយ នាយកដ្ឋាន ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា នៃ ក្រសួង មហាផ្ទៃ ដើម្បី ទប់ស្កាត់ ការបំពាន ច្បាប់ ស្តីពី សិទ្ធិ អ្នកនិពន្ធ និង សិទ្ធិ ប្រហាក់ប្រហែល តាមរយៈ ការយក ស្នាដៃ វប្បធម៌ ចាស់ ៗ យកមក ក្លែងបន្លំ ជាមួយនឹង ការបញ្ចូល រូបភាព មិន សមរម្យ នានា ដោយ ពុំ មាន ច្បាប់ អនុញ្ញាត ។
ទី ៩៖ សម្តេច សូម ថ្លែង នូវ ការកោតសរសើរ ចំពោះ ការចូលរួម របស់ សប្បុរស ជន មួយចំនួន ដូចជា លោកស្រី ឧប នាយក រដ្ឋមន្ត្រី ម៉ែន សំអន លោកស្រី ម៉ៅ ម៉ាល័យ កែ គឹម យ៉ាន លោកស្រី សៀង ចាន់ ហេង និង លោកស្រី ស៊ុយ ស៊ីផាន រួមទាំង សប្បុរស ជន ជាច្រើន ទៀត ដែល បាន បរិច្ចាគ ធនធាន ថវិកា ផ្ទាល់ខ្លួន រួមចំណែក ជាមួយ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ដើម្បី អភិរក្ស ប្រាសាទ និង ព្រះវិហារ បុរាណ មួយចំនួន នា ពេល កន្លងមក ។
ការសម្រេច បិទ នេះ បាន ធ្វើឡើង បន្ទាប់ពី មាន បទបញ្ជា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដោយសារតែ បុរស ជនជាតិ ម៉ាឡេស៊ី សញ្ជាតិ សិង្ហបុរី រូប នោះ បាន យក របាំ ព្រះរាជ ទ្រព្យ របស់ កម្ពុជា ទៅ សម្តែង ដោយ ភ្ជាប់ ជាមួយ អាគមន៍ អោម អាម ខុសពី វប្បធម៌ ខ្មែរ ។
ក្នុង ពិធី ប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ក្រោម ប្រធានបទ « យុវជន ដើម្បី វប្បធម៌ ជាតិ » នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ នា រសៀល ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ សម្តេច តេជោ បាន ប្រកាស ថា សម្តេច មិន អាច ទទួលយក បាន ទេ នូវ ការសម្តែង របាំ ព្រះរាជ ទ្រព្យ នៅ ប្រទេស សិង្ហបុរី បែប នោះ ទេ ។
ជាមួយនឹង ការចាត់ទុក ថា ការសម្តែង បែប នេះ ជា ការវាយប្រហារ ដល់ របប រាជានិយម ព្រះមហាក្សត្រ និង រាជ វង្សានុវង្ស សម្តេច តេជោ ក៏ បាន បញ្ជា ឱ្យ ហាមឃាត់ លោក Cheah Fah Loong ជនជាតិ ម៉ាឡេស៊ី សញ្ជាតិ សង្ហបុរី ដែល រៀបចំ របាំ ព្រះរាជ ទ្រព្យ ដោយ ខុសឆ្គ នេះ មិន ចូលមក ប្រទេស កម្ពុជា ផងដែរ ប៉ុន្តែ បើសិនជា ជន នេះ សុំទោស ចំពោះ ទោស កំហុស ខ្លួន រាជ រដ្ឋាភិបាល នឹង ពិចារណា ក្នុង ការអនុញ្ញាតឱ្យ ចូលមក កម្ពុជា វិញ ។
កាបញ្ចេញ ប្រតិកម្ម ខ្លាំង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើឡើង នៅក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតី ប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ៣មីនា លើក ទី ២២ ក្រោម ប្រធានបទ « យុវជន ដើម្បី វប្បធម៌ ជាតិ » នៅ រសៀល ថ្ងៃទី ៣ ខែមីនា ឆ្នាំ ២០២០ នេះ ។
ជាមួយនឹង ប្រតិកម្ម យ៉ាង ខ្លាំង ៗ ចំពោះ ជនជាតិ ម៉ាឡេស៊ី ដែល ប្រមាថ ចំពោះ របាំ ព្រះរាជ ទ្រព្យ របស់ ជាតិ ខ្មែរ នេះ ដែរ សម្តេច តេជោ ហ៊ុន សែន ក៏ បញ្ជាក់ ថា ប្រសិនបើ ជនជាតិ ម៉ាឡេស៊ី ដែល ទើប ទទួលបាន សញ្ជាតិ សិង្ហបុរី រូប នេះ ធ្វើ ការសុំទោស ចំពោះ ព្រះរាជ វង្សានុវង្ស និង រាជ រដ្ឋាភិបាល ក្នុង នាម រាជ រដ្ឋាភិបាល សម្តេច អាចនឹង បើក ឱកាស ដល់ បុគ្គល រូប នេះ ចូលមក ប្រទេស កម្ពុជា វិញ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ចោទសួរ ថា ជនជាតិ ម៉ាឡេស៊ី រូប នេះ គ្រាន់តែ ជា គ្រូ ហុង ស៊ុយ ហេតុ អ្វី ទៅ បានជា ត្រូវ យក សិល្បៈ បុរាណ ខ្មែរ យក ទៅ ធ្វើ ពិធី បួងសួង ហើយ គ្រូ ហុង ស៊ុយ នេះ នៅ ពីមុខ សិល្បៈ ជាតិ របស់ ខ្មែរ ទៅ វិញ ហើយ ការសម្តែង របាំ ព្រះរាជ ទ្រព្យ នៅ ប្រទេស សិង្ហបុរី នា ថ្មី ៗ នេះ គឺ ខុស នឹង របាំ ប្រពៃណី ខ្មែរ ។
តែ យ៉ាងណា នោះ សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក ថា នេះ មិន មែន ជម្លោះ រវាង កម្ពុជា និង សិង្ហបុរី នោះ ទេ តែ ជា ជម្លោះ ជាមួយ ជនជាតិ ម៉ាឡេស៊ី សញ្ជាតិ សិង្ហបុរី ម្នាក់ នេះ ដែល ប្រមាថ ចំពោះ កម្ពុជា ហើយ បាន រួម គំនិត ជាមួយ បុគ្គល ខ្មែរ មួយចំនួន រាប់ ទាំង បុគ្គល ម្នាក់ ជា ជំនួយការរដ្ឋមន្រ្តី ប្រតិភូ នាយក រដ្ឋមន្រ្តី ដែល សម្តេច ចេញ អនុក្រឹត្យ ដក ចេញ ពី តំណែង ផងដែរ ។
នាយក រដ្ឋមន្រ្តី សម្តេច តេជោ ក៏ ដាក់ បទបញ្ជា ដល់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ឱ្យ ពង្រឹង វិន័យ ដល់ អ្នក សិល្បៈ ការគោរព វិស័យ សិល្បៈ ជាតិ ខ្មែរ ឱ្យ បាន ហ្មត់ចត់ ហើយ សម្តេច គាំទ្រ ឱ្យ យក សិល្បៈ កម្ពុជា ទៅ សម្តែង នៅ ក្រៅ ប្រទេស ប៉ុន្តែ មិន មែន យក ទៅ ធ្វើឱ្យ អាប់ឱន នោះ ទេ ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០
៥៖ រដ្ឋសភា ទទួលយក សេចក្តីព្រាង ច្បាប់ ដែល ប្តូរ ឈ្មោះ ក្រសួង ឧស្សាហកម្ម និង សេចក្តីព្រាង ច្បាប់ ៥ផ្សេង ទៀត មក ពិនិត្យ សិក្សា ( ចុច អាន )
៤៖ ក្រសួង សុខាភិបាល បន្ត ច្រានចោល ការបង្ហោះ ប្រឌិត ព័ត៌មាន របស់ ក្រុម ប្រឆាំង រាជ រដ្ឋាភិបាល អំពី ជំងឺ កូរ៉ូណា ថ្មី ( ចុច អាន )
១០៖ នាយក រដ្ឋមន្ត្រី ម៉ាឡេស៊ី ថ្មី « ច្រានចោល ការចោទប្រកាន់ លោក ថា ជា ជនក្បត់ » ព្រោះ លោក ចង់ សង្គ្រោះ ប្រទេស ពី ភាពវឹកវរ ប៉ុណ្ណោះ ( ចុច អាន )
១៤៖ កងទ័ព កូរ៉េ ខាងត្បូង មួយចំនួន រងរបួស ធ្ងន់ ក្នុង ករណី ផ្ទុះ គ្រាប់បែក លើ នាវា ចម្បាំង អំឡុង ការធ្វើ សមយុទ្ធ យោធា ( ចុច អាន )
សម្តេច តេជោ ហ៊ុន សែន បញ្ចេញ ប្រតិកម្ម ធ្ងន់ ៗ ចំពោះ ការសម្តែង របាំ ព្រះរាជ ទ្រព្យ នៅ ប្រទេស សិង្ហបុរី ដែល ខុស នឹង វប្បធម៌ ប្រពៃណី ខ្មែរ និង ប្រមាថ ដល់ រាជ វង្ស (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន បញ្ចេញ ប្រតិកម្ម ធ្ងន់ ៗ ចំពោះ ការយក របាំ ព្រះរាជ ទ្រព្យ របស់ ខ្មែរ ទៅ សម្តែង នៅ ប្រទេស សិង្ហបុរី ដែល ធ្វើឱ្យ ខុស នឹង វប្បធម៌ ប្រពៃណី ខ្មែរ ហើយ ជា ការប្រមាថ ដល់ វប្បធម៌ ខ្មែរ រាជ វង្សានុវង្ស និង អង្គ ព្រះមហាក្សត្រ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ថា ក្នុង តួនាទី ជា នាយក រដ្ឋមន្រ្តី សម្តេច មិន អាច ទទួលយក បាន ទេ នូវ ការសម្តែង របាំ ព្រះរាជ ទ្រព្យ នៅ ប្រទេស សិង្ហបុរី បែប នោះ ដោយ មាន អប្សរារាំ នៅ ក្រោយ ជនជាតិ ម៉ាឡេស៊ី សញ្ជាតិ សិង្ហបុរី ដែល ជា គ្រូអាគមន៍ អោម អាម ។ សម្តេច បញ្ជាក់ ដូច្នេះ ថា៖ « អ្វី ដែល ធ្ងន់ធ្ងរ ជាង នេះ មនុស្ស ម្នាក់ នេះ ជា ជនជាតិ ម៉ាឡេស៊ី ហើយ ទើបនឹង ចូល សញ្ជាតិ សាំង ហ្គាព័រ បាន បន្តុះបង្អាប់ វាយប្រហារ ព្រះបរម រាជ វាំង យ៉ាង ធ្ងន់ធ្ងរ » ។
ប្រតិកម្ម នេះ បាន ធ្វើឡើង ក្នុង ពិធី ប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ក្រោម ប្រធានបទ « យុវជន ដើម្បី វប្បធម៌ ជាតិ » នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ នា រសៀល ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ បន្ទាប់ពី សម្តេច ទទួលបាន វីដេអូ មួយ ដែល បង្ហោះ លើ បណ្តាញ សង្គម Facebook ពាក់ព័ន្ធ នឹង ការសម្តែង របាំ ព្រះរាជ ទ្រព្យ ដែល រៀបចំឡើង ដោយ ជនជាតិ ម៉ាឡេស៊ី សញ្ជាតិ សិង្ហបុរី សហការ ជាមួយ ពលរដ្ឋ ខ្មែរ មួយចំនួន ។
សម្តេច បញ្ជាក់ ថា៖ « ប្រសិនបើ ធ្វើ ការបួងសួង ឱ្យ ព្រះរាជាណាចក្រ កម្ពុជា ក៏ ខ្លួន ឯង ត្រូវ រក ទីតាំង ឱ្យ បាន សមរម្យ ហើយ មិន អាច ឱ្យ អ្នក របាំ ខ្មែរ មក អង្គុយ និង រាំ ពីក្រោយ បុគ្គល ដែល ជា គ្រូ អោម អាម នោះ ទេ » ។
យ៉ាងណា ក៏ដោយ សម្រាប់ បញ្ហា នេះ សម្តេច បាន បញ្ជាក់ ថា នេះ មិន មែន ជា ជម្លោះ រវាង រាជ រដ្ឋាភិបាល កម្ពុជា និង រដ្ឋាភិបាល សិង្ហបុរី នោះ ទេ គឺ ផ្តោត សំខាន់ តែ លើ ជនជាតិ ម៉ាឡេស៊ី សញ្ជាតិ សិង្ហបុរី ម្នាក់ នេះ ដោយ មាន ការរួមគំនិត ជាមួយ បុគ្គល ខ្មែរ មួយចំនួន ប៉ុណ្ណោះ ។
ក្នុង ឋានៈ ជា អ្នកការពារ រាជវង្ស ព្រះមហាក្សត្រ និង វប្បធម៌ សម្តេច បាន ណែនាំ ឱ្យ ក្រសួង វប្បធម៌ ណែនាំ ពង្រឹង វិស័យ សិល្បៈ ខ្មែរ បន្ថែម ទៀត ។ សម្តេច គាំទ្រ ឱ្យ សិល្បៈ ខ្មែរ ទៅ សម្តែង នៅ ក្រៅ ប្រទេស ប៉ុន្តែ មិន មែន ទៅ ធ្វើឱ្យ សិល្បៈ ខ្មែរ អាប់ឱន កិត្តិយស ក្នុង កម្រិត ណាមួយ បាន ទេ ៕
ការអំពាវនាវ ជាថ្មី នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្ដេច តេជោ ហ៊ុន សែន អញ្ជើញ ជា អធិបតី ប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ៣មីនា លើក ទី ២២ ក្រោម ប្រធានបទ « យុវជន ដើម្បី វប្បធម៌ » ដែល រៀបចំ ធ្វើឡើង នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ រាជធានី ភ្នំពេញ នា ល្ងាច ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ភាពស៊ិចស៊ី នានា ក៏ គួរគប្បី ត្រូវបាន កាត់បន្ថយ សង្ឃឹម ថា កូនក្មេង ទាំងឡាយ ដែល ជា សិល្បករ - សិល្បការិនី ជាពិសេស សិល្បការិនី សូម អង្វរក រ សូម កុំ ឲ្យ មាន ភាព ស៊ិចស៊ី ហួសហេតុ » ។ លើស ពី នោះ ទៀត សម្តេច តេជោ ហ៊ុន សែន បាន ស្នើ ដល់ អ្នក សិទ្ធិ មនុស្ស និយម ឲ្យ បែងចែក ឲ្យបាន ច្បាស់ រវាង សិទ្ធិ និង តម្លៃ សីលធម៌ និង វប្បធម៌ របស់ ខ្មែរ ។
នៅក្នុង កិច្ចប្រជុំ ក្រុមប្រឹក្សា ជាតិ ដើម្បី ស្ត្រី កាលពី ពេល ថ្មី ៗ កន្លងទៅ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជា ទៅ ក្រសួង ប្រៃសនីយ និង ទូរគមនាគមន៍ ឲ្យ បិទ រាល់ គណនី Facebook ផ្សាយ លក់ ផលិតផល ដែល បញ្ចេញ អស់ កេរ្តិ៍ ខ្មាស ទាំងនេះ ចំណែក អ្នក មិន បញ្ចេញ កេរ្តិ៍ ខ្មាស់ មិន អី នោះ ទេ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា ការ Live បែប នេះ នាំឲ្យ មាន ការបំពាន ផ្លូវ ភេទ ស្រី ក្នុង សង្គម នា ពេល បច្ចុប្បន្ន ហើយ អាច នាំឲ្យ កើតមាន ករណី ចាប់រំលោភ ផងដែរ ។ បន្ទាប់ពី បំរាម នេះ ស្ដ្រី ឈ្មោះ ថៃ ស្រី នាង ដែល ជា អ្នកលក់ សម្លៀកបំពាក់ ក្នុង របស់ នារី ៗ ហើយ តែងតែ ស្លៀក ស៊ិចស៊ី ខ្លាំង ពេល live លក់ សម្លៀកបំពាក់ ម្ដង ៗ ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន បញ្ជូន ទៅកាន់ តុលាការ និង ឃុំ ខ្លួន ផងដែរ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃអង្គារ ទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
២៖ កងកម្លាំង យោធា កូរ៉េ ខាងត្បូង ចំនួន ០៦ នាក់ បាន ទទួលរង របួស នៅក្នុង ការហេតុការណ៍ ផ្ទុះ គ្រាប់បែក ដោយ មិន ដឹង មូលហេតុ មួយ នៅលើ នាវា ប្រយុទ្ធ ល្បឿន លឿន អំឡុង ការធ្វើ សមយុទ្ធ យោធា នៅ តំបន់ ឆ្នេរ ភាគ ខាងត្បូង ប្រទេស ។
៥៖ មន្ត្រី រដ្ឋាភិបាល បារាំង បាន ឲ្យដឹង ថា សាលារៀន យ៉ាងហោចណាស់ ១២០ កន្លែង នៅ តាម តំបន់ ដែល កំពុង មាន អ្នក ឆ្លង មេរោគ COVID-19 ត្រូវបាន សម្រេច ឲ្យ បិទ ទ្វារ ជា បណ្តោះអាសន្ន ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល បន្ថែម ទៀត ។
៦៖ យោង តាម របាយការណ៍ ចុងក្រោយ បំផុត ដែល ចេញផ្សាយ ដោយ ក្រសួង សុខាភិបាល អ៉ីរ៉ង់ កាលពី យប់ ថ្ងៃចន្ទ តួលេខ អ្នក ដែល បាន ឆ្លង ជំងឺ COVID-19 នៅក្នុង ប្រទេស អ៉ីរ៉ង់ បាន កើន ដល់ ជាង ១.៥០០ ករណី ក្នុង នោះ ៦៦ នាក់ ស្លាប់ ៕ រដ្ឋមន្ត្រី ថោង ខុន ដឹកនាំ ក្រុមការងារ ពិសេស ឧទ្ទេសនាម ផ្សព្វផ្សាយ វិធានការ របស់ រាជ រដ្ឋាភិបាល និង ក្រសួង ទេសចរណ៍ ក្នុង សន្និបាត បូកសរុប ការងារ របស់ រដ្ឋបាល ខេត្ត សៀមរាប
( សៀមរាប ) ៖ លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ នា ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ ក្រុមការងារ ពិសេស មួយ ក្រុម របស់ ក្រសួង ទេសចរណ៍ ចូលរួម ឧទ្ទេសនាម ផ្សព្វផ្សាយ ពី វិធានការ របស់ រាជ រដ្ឋាភិបាល និង របស់ ក្រសួង ទេសចរណ៍ ផ្ទាល់ ជុំវិញ ការលើកកម្ពស់ វិស័យ ទេសចរណ៍ ជាតិ ក្នុង ដំណាក់កាល កើតមាន វិបត្តិ ជំងឺ Covid-19 ជូន ដល់ អ្នក ពាក់ព័ន្ធ ដែល មាន វត្តមាន ក្នុង សន្និបាត បូកសរុប ការងារ របស់ រដ្ឋបាល ខេត្ត សៀមរាប នៅ សណ្ឋាគារ សុខា អង្គរ ។
លោក រដ្ឋមន្ត្រី ថោង ខុន បាន លើកឡើង ថា មកដល់ ពេលនេះ កម្ពុជា មិន ទាន់ មាន ករណី ឆ្លង ជំងឺ Covid-19 នៅឡើយ ទេ ក្រៅពី កើតឡើង លើ ជនជាតិ ចិន តែ ម្នាក់ គត់ ខណៈ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង សុខាភិបាល បាន និង កំពុង បន្ត យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ សុខ មាលភាព និង សុវត្ថិភាព របស់ ប្រជាពលរដ្ឋ ។
លោក រដ្ឋមន្ត្រី បាន លើក បង្ហាញ ពី វិធានការ ទាំង ៧ ចំណុច របស់ រាជ រដ្ឋាភិបាល និង វិធានការ សំខាន់ ៗ ដែល ក្រសួង ទេសចរណ៍ បាន ដាក់ចេញ សម្រាប់ អនុវត្ត នៅ ខេត្ត សៀមរាប ក្នុង នោះ ក្រសួង ទេសចរណ៍ បាន បង្កើត ក្រុមការងារ ពិសេស មួយ ក្រុម ដើម្បី ចុះ អនុវត្ត វិធានការ ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល និង វិធានការ របស់ ក្រសួង ទេសចរណ៍ ផ្ទាល់ ។
លោក រដ្ឋមន្ត្រី ក៏ បាន ផ្សព្វផ្សាយ ថា ខេត្ត សៀមរាប ក្រៅ តំបន់ អង្គរ ទាំងមូល ក៏ មាន រមណីយដ្ឋាន ទេសចរណ៍ តំបន់ អេកូ ទេសចរណ៍ មិន តិច ដែរ ដូចជា នៅ តំបន់ អេកូ ទេសចរណ៍ ចុង ឃ្នាស សហគមន៍ អេកូ ទេសចរណ៍ ជ្រាវ សហគមន៍ អេកូ ទេសចរណ៍ កំពង់ភ្លុក តំបន់ ទេសចរណ៍ នៅ ភ្នំ គូលែន សហគមន៍ ទេសចរណ៍ បន្ទាយស្រី រមណីយដ្ឋាន ទេសចរណ៍ របស់ ផ្នែក ឯកជន ជាច្រើន ។
ពិសេស លើស នេះ ខេត្ត សៀមរាប ក៏ នឹង ត្រៀម រៀបចំ ព្រឹត្តិការណ៍ ទេសចរណ៍ វប្បធម៌ សិល្បៈ កីឡា ម្ហូប អាហារ ពិធី បុណ្យ សាសនា ការប្រគំ តន្ត្រី ព្រឹត្តិការណ៍ សៀមរាប សង្ក្រាន្ត បាតុភូត ព្រះអាទិត្យ រះ ចំកំពូល ប្រាង្គ កណ្ដាល នៃ ប្រាសាទ អង្គរវត្ត ដំណើរទស្សនកិច្ច និង កិច្ចប្រជុំ ថ្នាក់ ជាតិ ថ្នាក់ តំបន់ និង ថ្នាក់ អន្តរជាតិ ជាច្រើន ទៀត សម្រាប់ ឆ្នាំ ២០២០ នេះ និង ឆ្នាំ បន្តបន្ទាប់ ទៅ មុខ ទៀត ។
ជាមួយគ្នា នោះ លោក រដ្ឋមន្ត្រី ថោង ខុន បាន អំពាវនាវ ដល់ ប្រតិបត្តិករ ទេសចរណ៍ និង មគ្គុទ្ទេសក៍ ទេសចរណ៍ ទាំងឡាយ នៅ ខេត្ត សៀមរាប គប្បី ចូលរួម ក្នុង វគ្គ បណ្ដុះបណ្ដាល ជាមួយ បុគ្គលិក និយោជិត របស់ សណ្ឋាគារ ផ្ទះសំណាក់ ខាងលើ ឱ្យ បាន ច្រើន កុះករ ព្រោះ ជា នេះ ជា ឱកាស ទទួលបាន អត្ថប្រយោជន៍ សម្រាប់ ពួកគេ ផ្ទាល់ ។
ព្រះមហាក្សត្រី ចេញ ព្រះរាជ សារ ចូលរួម អបអរសាទរ ខួប លើក ទី ១០៩ នៃ ទិវា អន្តរជាតិ នារី ៨មីនា ឆ្នាំ ២០២០
( ភ្នំពេញ ) ៖ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ នរោត្តម មុនិនា ថ សីហនុ បាន ចេញ ព្រះរាជ សារ សម្តែង ចូលរួម អបអរសាទរ ដល់ ខួប លើក ទី ១០៩ នៃ ទិវា អន្តរជាតិ នារី ៨មីនា ឆ្នាំ ២០២០ ដែល ធ្វើឡើង ក្រោម ប្រធានបទ « មាន សន្តិភាព មាន ការលើកកម្ពស់ សមភាព យេនឌ័រ » ។
ការអំពាវនាវ របស់ ស សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច អញ្ជើញ ប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ៣មីនា ក្រោម ប្រធានបទ « យុវជន ដើម្បី វប្បធម៌ ជាតិ » នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ នា រសៀល ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ ។
ដោយ និយាយ ដល់ ការស្នើ កុំ ឱ្យ សិល្បការិនី ស្លៀកពាក់ ស៊ិចស៊ី ពេក នៅពេល បង្ហាញ មុខ តាម កញ្ចក់ ទូរទស្សន៍ សម្តេច តេជោ ហ៊ុន សែន ក៏ ចាប់ផ្តើម ស្នើសុំ កុំ ឱ្យ មាន ការជេរ គ្នា តាម បណ្តាញ សង្គម ដោយសារតែ ធ្វើឱ្យ ប៉ះពាល់ ដល់ តម្លៃ សិល្បៈ ខ្មែរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក ថា រឿង ជេរ បញ្ចោរ គ្នា របស់ សិល្បករ សិល្បការិនី នេះ ជា រឿង អកុសល បំផុត ដោយសារតែ អ្នក សិល្បៈ ទាំងអស់ មាន តួនាទី ផ្សព្វផ្សាយ អប់រំ តាមរយៈ ការសម្តែង របស់ ខ្លួន ប៉ុន្តែ ផ្ទុយទៅវិញ បែរជា មាន ការជេរ បញ្ចោរ តាម បណ្តាញ សង្គម នានា ទៅ វិញ ។
សម្តេច យល់ឃើញ ថា បើ មាន រឿង គួរ អ្វី មួយ គួរតែ ពិភាក្សា គ្នា ឬ និយាយ តាម តាម ទូរស័ព្ទ ដើម្បី រក ដំណោះស្រាយ ហើយ ចៀសវាង ការជេរ បញ្ចោគ្នា ៕ ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស អញ្ជើញ ប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ៣មីនា លើក ទី ២២
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃអង្គារ ១០កើត ខែ ផល្គុន ឆ្នាំ កុរ ឯកស័ក ព .ស២៥៦៣ ត្រូវនឹង ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អញ្ជើញ ជា អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ ប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ៣មីនា លើក ទី ២២ ដែល ប្រារព្ធ ធ្វើឡើង ក្រោម ប្រធានបទ « យុវជន ដើម្បី វប្បធម៌ » ។
ភ្ជាប់ នឹង ការប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ៣មីនា ដែល ធ្វើឡើង នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ នៅ រសៀល ថ្ងៃ នេះ ក៏ បាន រៀបចំ ពិធី បិទ មហោស្រព សិល្បៈ យុវជន ទូទាំង ប្រទេស លើក ទី៦ និង ការពិសា អាហារ សាមគ្គី ជាមួយ សិល្បករ សិល្បការិនី ផងដែរ ។
ខាងក្រោម ជា ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង នៅក្នុង ឱកាស ប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ៣មី នា៖
* សម្តេច តេជោ ហ៊ុន សែន សូម ឱ្យ ទិវា នេះ ស្ថិត នៅ ជា អមតៈ ក្នុង ដួងចិត្ត ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ ៗ រូប ជាមួយនឹង មនសិការ ស្នេហាជាតិ និង ស្មារតី ស្រឡាញ់ សិល្បៈ វប្បធម៌ ជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន សូម ឱ្យ មាន សាមគ្គី ផ្ទៃក្នុង ល្អ និង កិច្ចសហការ ជួយគ្នា ទៅ វិញ ទៅ មក ក្នុង ចំណោម យុវជន កម្ពុជា ដែល ជា អ្នក បន្ត វេន ជាមួយនឹង ស្មារតី ទទួល ខុស ត្រូវ ខ្ពស់ ថែរក្សា ការពារ សម្បត្តិ វប្បធម៌ ជាតិ កម្ពុជា ឱ្យ បាន ស្ថិតស្ថេរ គង់វង្ស ជារៀងរហូត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ គណៈកម្មការ អន្តរ ក្រសួង ក៏ ដូចជា ក្រុមការងារ ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង និង រួម សហការ គ្នា យ៉ាង សកម្ម រៀបចំ ព្រឹត្តិការណ៍ វប្បធម៌ ជាតិ ជារៀងរាល់ ឆ្នាំ រួម ជាមួយនឹង គំនិត ច្នៃប្រឌិត ថ្មី ៗ រំលេច នូវ ស្នាដៃ បុព្វបុរស ខ្មែរ ដែល បាន បន្សល់ នូវ ស្នាដៃ វប្បធម៌ ដ៏ សម្បូរបែប ដែល ជា មរតក មាន តម្លៃ មិន ឤច កាត់ថ្លៃ បាន សម្រាប់ កូន ចៅ ជំនាន់ ក្រោយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បាវចនា « អរគុណ សន្តិភាព » និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ជាមួយនឹង កំណើន សេដ្ឋកិច្ច ខ្ពស់ ជាប់ ៗ គ្នា ក្នុង រយៈពេល ២ទសវត្សរ៍ ចុងក្រោយ នេះ ធ្វើឱ្យ វិស័យ វប្បធម៌ មាន ការអភិវឌ្ឍ រីក ចម្រើន យ៉ាង ឆាប់រហ័ស គួរ ជា ទី មោទនៈ ។
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ថា ការប្រារព្ធ ទិវា វប្បធម៌ ជាតិ ជារៀងរាល់ ឆ្នាំ ក្នុង រយៈពេល ជាង ២០ ឆ្នាំ កន្លងមក នេះ បាន ឆ្លុះបញ្ចាំង អំពី ឤរ្យ ធម៌ ដ៏ រុងរឿង នៃ មហា នគរ ខ្មែរ នា សម័យ អង្គរ ។
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ថា ការអបអរ និង ការរំលឹក គុណូបការៈ បុព្វបុរស ខ្មែរ ក្នុង ទិវា វប្បធម៌ ជាតិ គឺជា យន្តការ ជំរុញ ឱ្យ មាន ការផ្ទេរ ចំណេះ ដឹង និង ជំនាញ បច្ចេកទេស ផ្នែក សិល្បៈ វប្បធម៌ បណ្តុះ ភាពក្លាហាន មនសិការ ស្រឡាញ់ សិល្បៈ វប្បធម៌ ជាតិ ដល់ ជន រួម ជាតិ គ្រប់ ៗ រូប ។
* សម្តេច តេជោ ហ៊ុន សែន ផ្តល់ អនុសាសន៍ ណែនាំ ចំនួន ៩ដល់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ និង ភាគី ពាក់ព័ន្ធ អនុវត្តន៍ ដើម្បី បន្ត ការងារ អភិរក្ស និង អភិវឌ្ឍ វប្បធម៌ ជាតិ រូបី និង អរូបី ប្រកបដោយ តម្លាភាព ។ អនុសាសន៍ ណែនាំ ទាំង ៩នោះ រួម មាន៖
ទី ៤៖ ខ្ញុំ សូម គាំទ្រ ចំពោះ កិច្ចសហការ របស់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ និង ក្រសួង ព័ត៌មាន ដែល បាន ធ្វើឱ្យ វិស័យ ភាពយន្ត ភាគ ខ្មែរ បាន និង កំពុង មាន ភាពរីកចម្រើន គួរឱ្យ កត់ សម្គាល់ តាមរយៈ ការកំណត់ ម៉ោង មាស សម្រាប់ ធ្វើ ការចាក់ផ្សាយ ភាព - យន្ត ភាគ ខ្មែរ នា ពេល កន្លងមក ។ ជាមួយគ្នា នេះ ឤជ្ញាធរដែនដី គ្រប់ ជាន់ ថ្នាក់ ត្រូវ សហការ ជួយ សម្រួល ផ្តល់ ទីតាំង ក្នុង ដែនដី របស់ ខ្លួន ដើម្បី សម្រួល ដំណើរការ នៃ ការថត និង ផលិត ខ្សែភាព - យន្ត គ្រប់ ប្រភេទ ។
ទី៥៖ ត្រូវ បន្ត កិច្ចសហការ ជាមួយ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បំផុស សកម្មភាព គ្រប់ ស្ថានទូត និង ស្ថានកុងស៊ុល កម្ពុជា ប្រចាំ នៅ បរទេស រៀបចំ ព្រឹត្តិការណ៍ វប្បធម៌ ខ្មែរ ឱ្យ បាន ទៀងទាត់ ជារៀងរាល់ ឆ្នាំ ដើម្បី ផ្សព្វផ្សាយ វប្បធម៌ ជាតិ ជាមួយនឹង ការពង្រឹង នយោបាយ វប្បធម៌ ការទូតូ ហើយ ត្រូវ បំផុស ឱ្យ សហគមន៍ ខ្មែរ នៅ បរទេស ចូលរួម រៀបចំ កម្មវិធី ទិវា វប្បធម៌ ជាតិ ឱ្យ បាន អធិកអធម និង ទូលំទូលាយ ។
ទី៦៖ ត្រូវ រួមគ្នា សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ ឤជ្ញាធរដែនដី តាម មូលដ្ឋាន នានា ថែរក្សា ការពារ នូវ ប្រពៃណី ទំនៀមទម្លាប់ និង ទីតាំង គោរព បូជា របស់ បងប្អូន ជនជាតិ ដើម ភាគ តិច ដែល ជា ផ្នែក មួយ នៃ វប្បធម៌ ដ៏ យូរ លង់ របស់ ប្រជាជាតិ យើង ប្រកបដោយ ប្រសិទ្ធ - ភាព ។
ទី ៩៖ ខ្ញុំ សូម ថ្លែង នូវ ការកោតសរសើរ ចំពោះ ការចូលរួម របស់ សប្បុរស ជន មួយចំនួន ដូចជា លោកជំទាវ ឧប នាយក រដ្ឋមន្ត្រី ម៉ែន សំអន លោកជំទាវ ម៉ៅ ម៉ាល័យ កែ គីម យ៉ាន លោកជំទាវ សៀង ចាន់ ហេង និង លោកជំទាវ ស៊ុយ ស៊ីផាន រួមទាំង សប្បុរសជន ជាច្រើន ទៀត ដែល បាន បរិច្ចាគ ធនធាន ថវិកា ផ្ទាល់ខ្លួន រួមចំណែក ជាមួយ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ដើម្បី អភិរក្ស ប្រាសាទ និង ព្រះវិហារ បុរាណ មួយចំនួន នា ពេល កន្លងមក ។
* សម្តេច តេជោ ហ៊ុន សែន ស្នើ ដល់ សិល្បករ - សិល្បការិនី និង អ្នកនិពន្ធ ស្នាដៃ នានា ត្រូវ បញ្ឈប់ ជាបន្ទាន់ នូវ គ្រប់ ទម្រង់ នៃ ការរំលោភបំពាន យ៉ាង ធ្ងន់ធ្ងរ លើ ច្បាប់ ស្តីពី សិទ្ធិ អ្នកនិពន្ធ និង សិទ្ធិ ប្រហាក់ប្រហែល តាមរយៈ ការយក ស្នាដៃ ចម្រៀង ស្នាដៃ ភាពយន្ត ស្នាដៃ រូបភាព ស្នាដៃ អក្សរសាស្ត្រ ស្នាដៃ អក្សរ សិល្បិ៍ និង ស្នាដៃ វប្បធម៌ ដទៃ ៗ ទៀត ទាំង ស្នាដៃ ដែល មាន មរតកសាសន៍ និង គ្មាន មរតកសាសន៍ មក ផលិត ឡើងវិញ ដោយ ពុំ បាន សុំ ការអនុញ្ញាត ពី ម្ចាស់ សិទ្ធិ ឬ ពី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការសម្តែង របាំ ព្រះរាជ ទ្រព្យ នៅ ប្រទេស សិង្ហបុរី នា ថ្មី ៗ នេះ គឺ ខុស នឹង របាំ ប្រពៃណី ខ្មែរ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច មិន អាច ទទួលយក បាន ទេ ចំពោះ ការធ្វើឱ្យ អាប់ឱន ចំពោះ មរតក ដូនតា ខ្មែរ ជាពិសេស របាំ ព្រះរាជ ទ្រព្យ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា របាំ ព្រះរាជ ទ្រព្យ របស់ ខ្មែរ មិន អាច រាំ នៅ ខាងក្រោយមនុស្ស នោះ ទេ
* សម្តេច តេជោ ហ៊ុន សែន បញ្ជា ដល់ ក្រសួង មហាផ្ទៃ និង អគ្គ នាយក រដ្ឋាន អន្តោប្រវេសន៍ ហាម ជនជាតិ សិង្ហបុរី ម្នាក់ ប្រមាថ ចំពោះ របាំ ព្រះរាជ ទ្រព្យ កម្ពុជា កុំ ឱ្យ ចូល ប្រទេស កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នេះ មិន មែន ជម្លោះ រវាង កម្ពុជា និង សិង្ហបុរី នោះ ទេ ។ តែ ជា ជម្លោះ ជាមួយ ជនជាតិ សិង្ហបុរី ម្នាក់ ដែល ប្រមាថ ចំពោះ កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន ដាក់ បទបញ្ជា ដល់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ឱ្យ ពង្រឹង វិន័យ ដល់ អ្នក សិល្បៈ ។
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ថា ជនជាតិ សិង្ហបុរី រូប នេះ អាច ចូលមក កម្ពុជា បាន បើក គេ សុំទោស ចំពោះ កំហុសឆ្គង នេះ ។
* សម្តេច តេជោ ហ៊ុន សែន ស្នើ ដល់ អ្នក សិល្បៈ ទាំងអស់ រក្សា តម្លៃ សិល្បៈ វប្បធម៌ របស់ ខ្មែរ ។
* សម្តេច តេជោ ហ៊ុន សែន ស្នើ ឱ្យ នាំគ្នា ប្រារព្ធ ទិវា វប្បធម៌ រាល់ ថ្ងៃ សុំ កុំ ធ្វើ តែ ថ្ងៃ ៣មីនា ។
* សម្តេច តេជោ ហ៊ុន សែន សង្ឃឹម ថា អ្នកនិពន្ធ និង ដឹកនាំរឿង នឹង ប្រឹងប្រែង និពន្ធ រឿង ដោយ មិន ចម្លង តាម គេ ។
* សម្តេច តេជោ ហ៊ុន សែន ស្នើ ដល់ ក្រុមហ៊ុន នានា គាំទ្រ ដល់ ភាពយន្ត ខ្មែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បន្ត ស្នើ ដល់ សិល្បៈ ការិនី កុំ ឱ្យ ស្លៀកពាក់ ស៊ិចស៊ី ខ្លាំង ។ សម្តេច តេជោ ហ៊ុន សែន ស្នើ ដល់ អ្នក សិទ្ធិ មនុស្ស និយម ឱ្យ បែងចែក ឱ្យ បាន ច្បាស់ រវាង សិទ្ធិ និង តម្លៃ សីលធម៌ និង វប្បធម៌ របស់ ខ្មែរ ។
ឯក អគ្គ រាជ ទូត ម៉ាឡេស៊ី ប្ដេជ្ញា សហការ ជាមួយ កម្ពុជា ក្នុង វិស័យ សកម្មភាព មីន
លោក ឯក អគ្គ រាជ ទូត ម៉ាឡេស៊ី បាន សម្តែង នូវ សោមនស្ស រីករាយ ចំពោះ ចំណង ទំនាក់ទំនង រវាង ប្រទេស កម្ពុជា និង ម៉ាឡេស៊ី និង បាន សម្តែង នូវ ការកោតសរសើរ និង អបអរសាទរ ចំពោះ ភាពរីកចម្រើន ដ៏ ខ្លាំងក្លា របស់ កម្ពុជា ។
ជាមួយគ្នា នេះ លោក ឯក អគ្គ រាជ ទូត ក៏ បាន សម្តែង នូវ ការអបអរសាទរ ចំពោះ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ដែល ទទួលបាន នូវ ជោគជ័យ នៅក្នុង វិស័យ សកម្មភាព មីន ដោយ បាន ធ្វើ ការបោសសម្អាត មីន មនុស្សធម៌ ដើម្បី ផ្តល់ ដី សុវត្ថិភាព ដល់ ប្រជាពលរដ្ឋ និង ការកាត់បន្ថយ គ្រោះថ្នាក់ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម ។
ព្រម ជាមួយគ្នា នេះ ដែរ លោក ឯក អគ្គ រាជ ទូត បាន បង្ហាញ ពី ការប្តេជ្ញាចិត្ត សហការ ជាមួយ កម្ពុជា នៅក្នុង វិស័យ សកម្មភាព មីន ហើយ លោក ឯក អគ្គ រាជ ទូត នឹង ខិតខំ កៀរ គរ ធនធាន ពី រាជ រដ្ឋាភិបាល និង សង្គម ស៊ីវិល ម៉ាឡេស៊ី ដើម្បី ចូលរួមចំណែក ក្នុង កិច្ចសង្គ្រោះ ជន ពិការ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម ។
តាង នាម រាជ រដ្ឋាភិបាល កម្ពុជា លោក ទេសរដ្ឋមន្រ្តី បាន សម្តែង នូវ សេចក្តី សោមនស្ស រីករាយ និង អំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការប្តេជ្ញាចិត្ត របស់ ម៉ាឡេស៊ី ក្នុង ការសហការ ជាមួយ កម្ពុជា ក្នុង វិស័យ សកម្មភាព មីន ។ អាជ្ញាធរ មីន នឹង បន្ត កិច្ចសហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ ស្ថានទូត ម៉ាឡេស៊ី ប្រចាំ នៅ កម្ពុជា ៕
បើ តាម តួលេខ បច្ចុប្បន្ន ប្រទេស អូស្ត្រាលី មាន អ្នក ផ្ទុក COVID-19 ដែល ត្រូវបាន រកឃើញ ចំនួន ៣៨ករណី ។ ទោះបីជា បែប នេះ ក្តី បណ្ឌិត Chant បាន លើកឡើង ថា តួលេខ នេះ គឺ បង្ហាញ អំពី ការឆ្លង រាលដាល កាន់តែ ខ្លាំង នៅក្នុង ពិភពលោក ប៉ុណ្ណោះ មិន មែន នៅក្នុង ប្រទេស អូស្ត្រាលី នោះ ទេ ព្រោះ ករណី ដែល ត្រូវបាន រកឃើញ ស្ទើរតែ ទាំងអស់ សុទ្ធតែ ជា អ្នក ដែល បាន ធ្វើដំណើរ មកពី ប្រទេស ផ្សេង ៗ ចូលមក ក្នុង ទឹកដី អូស្ត្រាលី ។
មន្ត្រី សុខាភិបាល ជាន់ ខ្ពស់ អូស្ត្រាលី ខាងលើ នេះ បាន បញ្ជាក់ បន្ថែម យ៉ាង ដូច្នេះ ថា « ការរកឃើញ មេរោគ ផ្ទុក ក្នុង ខ្លួន មនុស្ស ដែល ធ្វើដំណើរ មកពី ប្រទេស នានា មាន ការកើនឡើង គឺ វា បង្ហាញ អំពី ភាពធ្ងន់ធ្ងរ នៅក្នុង ប្រទេស ទាំងនោះ ទៅ វិញ ទេ ។ យើង មាន លទ្ធភាព នៅក្នុង ការពិនិត្យ ឃើញ មេរោគ ទាំងនោះ (COVID-19) ហើយ យក អ្នក ផ្ទុក ទាំងអស់ ទៅ ដាក់ នៅ កន្លែង ផ្សេង ដាច់ ពី គេ ដើម្បី ពិនិត្យ និង ព្យាបាល ព្រមទាំង បង្ការ កុំ ឲ្យ ឆ្លង ទៅ អ្នកដទៃ ទៀត » ។
រាជ រដ្ឋាភិបាល ដាក់ចេញ គោលដៅ សំខាន់ ៗ ចំនួន ៣ ធ្វើ ទំនើបកម្ម ឧស្សាហកម្ម កម្ពុជា ពី ឧស្សហកម្ម អតិពលកម្ម ឈាន ទៅ ឧស្សាហកម្ម ផ្អែក លើ ជំនាញ ត្រឹម
( ភ្នំពេញ )៖ គណៈកម្មាធិការ គោល នយោបាយ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដែល ជា សេនាធិការ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន កំណត់ នូវ ចក្ខុវិស័យ ដើម្បី ជំរុញ និង ធ្វើ ទំនើបកម្ម ឧស្សាហកម្ម កម្ពុជា ពី ឧស្សហកម្ម អតិពលកម្ម ឈាន ទៅ ឧស្សាហកម្ម ផ្អែក លើ ជំនាញ ត្រឹម ឆ្នាំ ២០២៥ ដោយ ដាក់ចេញ នូវ គោលដៅ ចម្បង ៣ ។
គោលដៅ ចម្បង ៣មាន ជា អាទិ៍៖
* គោលដៅ ទី ៣៖ ពង្រឹង យន្តការគ្រប់គ្រង និង អភិវឌ្ឍន៍ សហគ្រាស ធុន តូច និង មធ្យម តាមរយៈ ការជំរុញ ការចុះបញ្ជី ជា ផ្លូវការ ឱ្យ បាន ពី ៨០ % ទៅ ៩០ % នៅ ឆ្នាំ ២០២៥ ដែល ក្នុង នោះ ៥០% ទៅ ៧០ % មាន អភិបាលកិច្ច សាជីវកម្ម ល្អ ដោយ មាន បញ្ជី កាគណនេយ្យ និង តារាង តុល្យការត្រឹមត្រូវ ។
« គោល នយោបាយ អភិវឌ្ឍន៍ វិស័យ ឧស្សាហកម្ម ឆ្នាំ ២០១៥ - ២០២៥ » ដែល ត្រូវបាន ដាក់ចេញ និង កំពុង អនុវត្ត ដោយ រាជ រដ្ឋាភិបាល កម្ពុជា ជា យុទ្ធសាស្ត្រ កំណើន សេដ្ឋកិច្ច ថ្មី មួយ របស់ កម្ពុជា ផ្តោត សំខាន់ លើ ការកែទម្រង់ រចនាសម្ព័ន្ធ សេដ្ឋកិច្ច តាមរយៈ ការធ្វើ ពិពិធកម្ម សេដ្ឋកិច្ច . ការពង្រឹង ភាពប្រកួតប្រជែង និង ការលើកកម្ពស់ ផលិតភាព និង ជំនាញ របស់ កម្លាំង ពលកម្ម កម្ពុជា ។
ការអនុវត្ត គោល នយោបាយ អភិវឌ្ឍន៍ វិស័យ ឧស្សាហកម្ម ក្នុង ឆ្នាំ ២០១៧ និង ២០១៨ មាន វឌ្ឍនភាព គួរឱ្យ កត់សម្គាល់ ដោយ ផ្អែក លើ លទ្ធផល សម្រេចបាន នៃ គោលដៅ ទាំង៣ ខាងលើ ព្រមទាំង វិធានការ ៤ ដែល រួម មាន៖
បន្ថែម លើ នេះ ដើម្បី ពង្រឹង ប្រសិទ្ធភាព ការងារ និង ជា ការគិតគូរ ប្រកបដោយ បុរេសកម្ម ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា សហការ ជាមួយ ដៃគូ អភិវឌ្ឍន៍ និង ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ នឹង រៀបចំ ទស្សនា ទាន ក្របខណ្ឌ តាមដាន និង វាយតម្លៃ ពាក់កណ្តាល អាណត្តិ ដែល គ្រោង ធ្វើឡើង ក្នុង ឆមាស ទី១ ឆ្នាំ ២០២១ ។
ក្របខណ្ឌ នេះ នឹង ផ្តល់ ការតម្រង់ ទិស សម្រាប់ ការរៀបចំ របាយការណ៍ វឌ្ឍនភាព ពាក់កណ្តាល អាណត្តិ មួយ ដែល អាច ឆ្លុះបញ្ចាំង ពី គម្លាត លទ្ធផល សម្រេចបាន និង ការរំពឹងទុក និង ជាពិសេស ផ្តល់ នូវ មេរៀន និង បទពិសោធន៍ ល្អ ៗ សម្រាប់ ជា ធាតុ ចូលក្នុង ការកែតម្រូវ វិធីសាស្រ្ត និង វិធានការជាក់លាក់ មួយចំនួន ដើម្បី សម្រេចបាន នូវ លទ្ធផល កាន់តែ ប្រសើរ ក្នុង រយៈពេល ពាក់កណ្តាល អាណត្តិ ចុងក្រោយ ។
( ភ្នំពេញ ) ៖ មាន ហេតុការណ៍ ភ្ញាក់ផ្អើល នៅពេល មន្រ្តី នគរបាល ផ្នែក បច្ចេកទេស វិទ្យាសាស្ត្រ ក្រសួង មហាផ្ទៃ ម្នាក់ ត្រូវ កូនស្រី ខល ប្រាប់ ថា មាន ជម្លោះ វាយតប់ គ្នា ជាមួយ សិស្សសាលា ដូចគ្នា ក៏ ស្រាប់តែ ធ្វើដំណើរ ទៅដល់ សាលា និង បាន ប្រើ ហិង្សា លើ សិស្ស ស្រី ២នាក់ នៅ សាលា ជម្ពូវ័ន បណ្ដាលឱ្យ រងរបួស ហើយ វាយ ទាំង ក្រុមកាយ រិទ្ធិ ដែល ចូលទៅ ឃាត់ ថែម ទៀត ។
ក្រោយពេល បង្ក រឿង មន្រ្តី នគរបាល រូប នេះ រួម ជាមួយ កូនស្រី ច្បង របស់ ខ្លួន ម្នាក់ ទៀត ដែល ទៅ វាយ លើ សិស្ស រងគ្រោះ ទាំង ២នាក់ ក៏ ត្រូវបាន នគរបាល ប៉ុស្តិ៍ ចោម ចៅ ឃាត់ខ្លួន ចាត់ការ តាម ច្បាប់ ផងដែរ ។ ហេតុការណ៍ នោះ បាន កើតឡើង កាលពី វេលា ម៉ោង ៨៖៥០ នាទី ព្រឹក ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ នៅក្នុង វិទ្យាល័យ ហ៊ុន សែន ជម្ពូវ័ន ក្នុង សង្កាត់ ចោម ចៅ ទី៣ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
ចំណែក សិស្ស ស្រី រងគ្រោះ ទី២ ឈ្មោះ ផ. ប ក៏ បាន រៀបរាប់ ថា បុរស ជា មន្រ្តី នគរបាល នោះ វាយ ច្រឡំ ដោយ ស្មាន ថា នាង គឺជា បក្ខពួក របស់ ឈ្មោះ ស . ច តាមពិត នាង មិន ធ្លាប់ ដែល មាន ទំនាស់ ឬ ស្គាល់ កូនស្រី របស់ គាត់ ឡើយ ។ មុនពេល កើត ហេតុ នាង និង មិត្តភក្តិ ២នាក់ កំពុង យក សម្ភារ ស្រោច ដំណាំ ទៅ ទុក នៅ កន្លែង ដាក់ សម្ភារ ស្រាប់តែ មន្ត្រី នគរបាល រូប នោះ និង កូនស្រី ដើរ ទៅដល់ ហើយ អត់ បាន សួរនាំ អ្វី ទេ ក៏ បាន ស្ទុះ មក ទាំង បំពាន បណ្ដាលឱ្យ រងរបួស បែប នេះ តែម្ដង ។
ក្រោយពេល នគរបាល ប៉ុស្តិ៍ ចោម ចៅ ទី៣ ឃាត់ខ្លួន មន្រ្តី នគរបាល រូប នេះ បាន បដិសេធ ថា គាត់ មិន បាន វាយ សិស្ស ស្រី ទាំង ២នាក់ ខាងលើ នោះ ទេ ហើយក៏ មិន បាន ដឹង ថា នរណា ជា អ្នកវាយ ឡើយ តែ នៅ ពេល កំពុង រញ៉េរញ៉ៃ កើតឡើង គាត់ បាន ចូលទៅ ឃាត់ ញែក ចេញ ប៉ុណ្ណោះ ។
ម្យ៉ាងទៀត គាត់ ក៏ មិន ធ្លាប់ បាន ស្គាល់ ក្មេងស្រី រងគ្រោះ នោះ ទេ ហើយក៏ មិន បាន ប៉ះ ឬ វាយ ឡើយ ។ ទោះបី បែប ណា ពេលនេះ នគរបាល បាន សម្រេច ឃាត់ខ្លួន បុរស នោះ រួម នឹង កូនស្រី ម្នាក់ ទៀត ឈ្មោះ ភ. ប ហើយ ចំណែក កូនស្រី ឈ្មោះ ភ. ផ មិន ត្រូវបាន ឃាត់ ឡើយ ហើយ ករណី នេះ ក៏ មាន សិស្សិជាច្រើន បាន ឃើញ មន្រ្តី នគរបាល រួម និង កូនស្រី របស់ គាត់ ខាងលើ បាន វាយ ទៅ លើ សិស្ស ស្រី ទាំង ២នាក់ រហូត រងរបួស ផងដែរ ៕
រដ្ឋបាល ខេត្ត បាត់ដំបង បើក កិច្ចប្រជុំ ពិភាក្សា ត្រួតពិនិត្យ ការតាំងពិព័រណ៍ សមិទ្ធិផល និង ផ្សព្វផ្សាយ ពី ការងារ រៀបចំ ផ្ទះ ស្នាក់ ទីក្រុង ក្នុង ពិធី បុណ្យ ទន្លេ ខួប លើក ទី៦
( បាត់ដំបង ) ៖ នា រសៀល ថ្ងៃទី ៣ ខែមីនា ឆ្នាំ ២០២០ នៅ សាលា ខេត្ត បាត់ដំបង មាន បើក កិច្ចប្រជុំ ពិភាក្សា ត្រួតពិនិត្យ ការតាំងពិព័រណ៍ សមិទ្ធិផល និង ផ្សព្វផ្សាយ ពី ការងារ រៀបចំ ផ្ទះ ស្នាក់ ទីក្រុង សម្រាប់ ត្រៀម អបអរសាទរ ក្នុង ពិធី បុណ្យ ទន្លេ ខួប លើក ទី៦ ឆ្នាំ ២០២០ ។
ដឹកនាំ កិច្ចប្រជុំ នេះ ក្រោម វត្តមាន លោក សឿម ប៊ុន រិទ្ធិ អភិបាល រង ខេត្ត បាត់ដំបង និង មាន ការចូលរួម ពី មន្ទីរ អង្គភាព រដ្ឋ នានា ទាំង អស់ ជុំវិញ ខេត្ត អភិបាល ក្រុង ស្រុក ទាំង ១៤ ចូលរួម ផងដែរ ។
លោក សឿម ប៊ុន រិទ្ធ ក៏ បាន ជម្រាប ផងដែរ អំពី កាលបរិច្ឆេទ ព្រឹត្តិការណ៍ នីមួយ ៗ ដូចជា តាំងពិព័រណ៍ វិថី ម្ហូប អាហារ ដឹក ដោយ មន្ទីរ ទេសចរណ៍ ខេត្ត ពិធី ដាំ កូន ឈើ នៅ សួន សម្តេច ក្រឡាហោម ស ខេង . សិក្ខាសាលា ស្តីអំពី បុណ្យ ទន្លេ សន្តិភាព បុណ្យ ទន្លេ វិបុលភាព . ការរៀបចំ ស្តង់ បែងចែក ទៅតាម ទីតាំង ដែល បាន គ្រោង ទុក នៅ កន្លែង នីមួយ ៗ របស់ ខ្លួន ទទួលខុសត្រូវ និង ការរៀបចំ ការងារ ផ្សេង ៗ ទៀត ផងដែរ ។
ហេតុការណ៍ ខាង លើ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ១៖០០ នាទី រសៀល ថ្ងៃអង្គារ នេះ ( ម៉ោង នៅ ទីក្រុង សេអ៊ូល ) នៅលើ នាវា ប្រយុទ្ធ ល្បឿន លឿន មួយ គ្រឿង ដែល មាន ទម្ងន់ សរុប ១៣០តោន និង មាន ផ្ទុក យោធា សរុប ៣០ នាក់ ។ បើ តាម ប្រភព ពី យោធា កូរ៉េ ខាងត្បូង កងកម្លាំង យោធា ០២ នាក់ ក្នុង ចំណោម អ្នក រងរបួស ទាំង ០៦ នាក់ នោះ មាន សភាព ធ្ងន់ធ្ងរ ខ្លាំង ។
គួរ បញ្ជាក់ ថា ក្រោយ ហេតុការណ៍ ខាង លើ នេះ កើតឡើង កងទ័ព ជើងទឹក កូរ៉េ ខាងត្បូង បាន ប្រកាស ការផ្អាក សមយុទ្ធ ទាំងមូល ជា បណ្តោះអាសន្ន ដើម្បី ធ្វើ ការស៊ើបអង្កេត រក មូលហេតុ ពិតប្រាកដ ដែល នាំឲ្យ គ្រាប់បែក ខាងលើ នេះ ផ្ទុះ ។ បើ តាម ប្រភព ដដែល គ្រាប់បែក ទំនងជា បាន ផ្ទុះ អំឡុង ការហ្វឹកហាត់ ពី របៀប គប់ គ្រាប់បែក ៕
ក្រសួង យុត្តិធម៌ បើក កិច្ចពិគ្រោះយោបល់ លើ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការចាត់ចែង បណ្តោះអាសន្ន នូវ វត្ថុ ចាប់ យក និង សេចក្តីព្រាង ច្បាប់ ស្តីពី វិសោធនកម្ម ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ គ្រឿងញៀន
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ ក្រសួង យុត្តិធម៌ បាន រៀបចំ កិច្ចប្រជុំ ពិនិត្យ និង ពិគ្រោះយោបល់ លើ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការចាត់ចែង បណ្តោះអាសន្ន នូវ វត្ថុ ចាប់ យក និង សេចក្តីព្រាង ច្បាប់ ស្តីពី វិសោធនកម្ម ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ គ្រឿងញៀន ក្រោម អធិបតី លោក រដ្ឋមន្រ្តី អង្គ វង្ស វឌ្ឍា នា ។
កិច្ចប្រជុំ ពិនិត្យ នេះ ត្រូវបាន ប្រព្រឹត្តទៅ ក្រោម កិច្ច សម្របសម្រួល ដោយ លោក កើត រិទ្ធ រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង យុត្តិធម៌ ដោយ មាន ការចូលរួម ពី តំណាង ក្រសួង មហាផ្ទៃ និង អគ្គ លេខាធិការ នៃ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ព្រមទាំង ក្រុមការងារ ក្រសួង យុត្តិធម៌ ប្រធាន តុលាការ និង ព្រះរាជអាជ្ញា អម សាលាឧទ្ធរណ៍ និង សាលាដំបូង រាជធានី - ខេត្ត ចំនួន ៨០ រូប ៕
លោក ស៊ី ជិន ពីង អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនិស្ត និង ជា ប្រធាន គណៈកម្មាធិការ យោធា មជ្ឈិម ចិន ផងដែរ នោះ បាន ធ្វើការកត់សម្គាល់ ដូច ខាងលើ ក្នុង ឱកាស ដំណើរទស្សនកិច្ច របស់ លោក ទៅកាន់ បណ្ឌិត សភា វិទ្យាសាស្ត្រ - វេជ្ជសាស្ត្រ យោធា និង សាលា វេជ្ជសាស្ត្រ នៅ សកលវិទ្យាល័យ ស៊ីង ហួ ក្នុង ទីក្រុង ប៉េកាំង កាលពី ថ្ងៃចន្ទ ម្សិលមិញ ។
នៅក្នុង កំឡុង ពេល ដំណើរ ស្សនកិច្ច នេះ លោក ស៊ី ជិន ពីង បាន សិក្សា ស្វែងយល់ អំពី វឌ្ឈនភាព នៃ ការស្រាវជ្រាវ និង ការអនុវត្តន៍ ការចាក់ វ៉ាក់សាំង ព្រមទាំង ឧបករណ៍ ធ្វើតេស្ត រហ័ស ផងដែរ ។ ក្នុង នាម គណៈកម្មាធិការ កណ្តាល របស់ បក្ស កុម្មុយនិស្ត ចិន លោក ស៊ី ជិន ពីង បាន សម្តែង ការដឹង គុណ និង ស្វាគមន៍ យ៉ាង ស្មោះស្ម័គ្រ ចំពោះ បុគ្គលិក ផ្នែក វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា ជួរ មុខ ទាំងអស់ របស់ ចិន ។
ទន្ទឹម គ្នា នោះ ដែរ លោក ប្រធានាធិបតី ស៊ី ជីន ពីង បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា គឺជា អាវុធ ដ៏ មាន ឥទ្ធិពល បំផុត នៅក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ។ មនុស្សជាតិ មិន អាច យកឈ្នះ លើ គ្រោះមហន្តរាយ ឬ ជំងឺ រាតត្បាត បាន ឡើយ បើ គ្មាន ការអភិវឌ្ឍ ផ្នែក វិទ្យាសាស្ត្រ និង ការច្នៃប្រឌិត បច្ចេកវិទ្យា ទេ នោះ » ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ ដើម្បី ទប់ស្កាត់ លុបបំបាត់ និង បង្ក្រាប ការកាប់ ដុត ឈូសឆាយ និង ហ៊ុមព័ទ្ធ ដី ព្រៃឈើ ដើម្បី វាទ យក ដី ធ្វើជា កម្មសិទ្ធិ បាន រៀបចំ កិច្ចប្រជុំ លើក ទី២ ក្រោម ការចូលរួម ពី លោក វេង សាខុន ប្រធាន គណៈកម្មាធិការ ជាតិ ដើម្បី ទប់ស្កាត់ លុបបំបាត់ និង បង្ក្រាប ការកាប់ ដុត ឈូសឆាយ និង ហ៊ុមព័ទ្ធ ដី ព្រៃឈើ ។
កិច្ចប្រជុំ នេះ រៀបចំឡើង ក្នុង គោលបំណង ធ្វើ ការត្រួតពិនិត្យ តាមដាន និង វាយតម្លៃ លើ លទ្ធផល សម្រេចបាន ពី ការអនុវត្ត ច្បាប់ អនុក្រឹត្យ និង សារាចរ ណែនាំ របស់ រាជ រដ្ឋាភិបាល និង ប្រមូល យក នូវ រាល់ មតិ បទពិសោធន៍ ពី គ្រប់ សមាជិក គណៈកម្មាធិការ អាជ្ញាធរ មូលដ្ឋាន ដើម្បី រៀបចំ ជា យុទ្ធសាស្រ្ត ដោះស្រាយ ជា ប្រព័ន្ធ នូវ រាល់ បញ្ហា ដែល កំពុងតែ កើតមាន ទាក់ទង ការកាប់ ដុត ឈូសឆាយ និង ហ៊ុមព័ទ្ធ ដី ព្រៃឈើ របស់ រដ្ឋ វាទ យក ដី ធ្វើជា កម្មសិទ្ធិ ។
លោក បាន បន្ដ ថា ក្នុង នាម ប្រធាន គណ:កម្មាធិការ ជាតិ ទទួលយក នូវ រាល់ មតិ យោបល់ និង សំណូមពរ ពី គ្រប់ សមាជិក គណៈកម្មាធិការ ដែល ជា ធាតុ ចូល យ៉ាង សំខាន់ សម្រាប់ ជា គ្រឹះ ក្នុង ការកសាង សេចក្តីព្រាង សារាចរ ណែនាំ ស្តីពី វិធានការ ទប់ស្កាត់ ការកាប់ ដុត ឈូសឆាយ និង ហ៊ុមព័ទ្ធ ដី ព្រៃឈើ របស់ រដ្ឋ វាទ យក ដី ធ្វើជា កម្មសិទ្ធិ ជាដើម ។
ឯក អគ្គ រដ្ឋទូត សហរដ្ឋ អាមេរិក បាន លើកឡើង ថា ការ ដែល លោក ទៅ ជួប សួរ សុខទុក្ខ ប្រជាពលរដ្ឋ ខ្មែរ នៅ ពេល នេះ ដើម្បី ចង់ ស្ដាប់ នូវ មតិ យោបល់ និង អ្វី ដែល ជា កង្វក់ របស់ ពលរដ្ឋ ដែល សុទ្ធតែ ជា ពាណិជ្ជករ កំពុង ធ្វើ អាជីវកម្ម លើ ទឹកដី នៃ សហរដ្ឋ អាមេរិក ។
លោក បញ្ជាក់ ថា សព្វ ថ្ងៃ នេះ នៅក្នុង ប្រទេស កម្ពុជា មាន មនុស្ស កាន់តែ ច្រើន ឡើង ៗ ដែល ធ្វើ កិច្ចការ ដូច ដែល អ្នក កំពុង ធ្វើ ទីនេះ ដែរ ពោល គឺ មាន សហគ្រាស ធុន តូច និង មធ្យម កាន់តែ ច្រើន ឡើង ។
ក្នុង ឱកាស នោះ លោក ឯក អគ្គ រដ្ឋទូត សង្ឃឹម ថា នឹង បាន ស្ដាប់ឮ មតិ យោបល់ និង ការយល់ឃើញ របស់ ប្រជាពលរដ្ឋ ក្នុង អំឡុង ពេលវេលា អាហារ ថ្ងៃត្រង់នេះ ដែល លោក ពិតជា មាន ក្ដីរីករាយ ណាស់ ដែល បាន ជួប អ្នក ទាំងអស់ នោះ ៕ ពលរដ្ឋ ជាច្រើន នាក់ មក តវ៉ា នៅ ស្រុក លំផាត់ អន្តរាគមន៍ ឲ្យ ដោះលែង មនុស្ស ២នាក់ ក្រោយ ចាប់ខ្លួន សង្ស័យ កាប់ រាន ដី ព្រៃ ក្នុង ដែន ជម្រក បរិស្ថាន
( រតនគិរី ) ៖ នៅ រសៀល ថ្ងៃទី ៣ ខែមីនា ឆ្នាំ ២០២០ នេះ ប្រជាពលរដ្ឋ ជាច្រើន នាក់ មកពី ឃុំ កាឡែង និង ឃុំ សេដា ស្រុក លំផាត់ បាន លើក គ្នា មក អន្តរាគមន៍ ឲ្យ ដោះលែង មនុស្ស ២នាក់ ក្នុង ពន្ធនាគារ ខេត្ត ( ភ្នំ ស្វាយ ) បន្ទាប់ពី មាន ការចាប់ខ្លួន សង្ស័យ កាប់ រាន ដី ព្រៃ ក្នុង ដែន ជំរក បរិស្ថាន ។
លោក ថា កាលពី ថ្ងៃទី ២៨ ខែកុម្ភៈ កន្លងមក លោក លន់ សុភាព អភិបាល រង ខេត្ត រតនគិរី បាន សន្យា ជាមួយ ពួកគាត់ ថា ដោះលែង ជនសង្ស័យ ទាំង ២នាក់ នេះ ឲ្យ មាន សេរីភាព វិញ នៅ ថ្ងៃចន្ទ ដើម សប្តាហ៍ នេះ ប៉ុន្តែ រហូតមកដល់ អង្គារ៍ នេះ ពួកគេ ទាំង ២នាក់ នៅតែ ឃុំ ខ្លួន ក្នុង ពន្ធនាគារ ខេត្ត ( ភ្នំ ស្វាយ ) ដដែល ដូច្នេះ ពួកគាត់ នាំគ្នា ឈរ មុខ សាលា ខេត្ត រតនគិរី តវ៉ា ឲ្យ មាន ការដោះលែង ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ២៨ ខែកុម្ភៈ ប្រជាពលរដ្ឋ មកពី ស្រុក លំផាត់ ចំនួន ៧០ នាក់ លើក គ្នា មក មន្ទីរ បរិស្ថាន ក្នុង បំណង ឲ្យ អាជ្ញាធរ ខេត្ត ជួយ ធ្វើអន្តរាគមន៍ ដោះលែង អ្នកភូមិ ២នាក់ ដែល កម្លាំង ឧទ្យាន នុរក្ស ចាប់ ដាក់ ពន្ធនាគារ ពី បទ កាប់ រាន ដី ព្រៃ ដែន ជម្រក សត្វ ព្រៃ លំ ផាត់ ដោយ ខុស ច្បាប់ ។
ទាក់ទិន ទៅនឹង ករណី ប្រជាពលរដ្ឋ ជាច្រើន នាក់ លើក គ្នា មក អន្តរាគមន៍ នៅមុខ សាលា ខេត្ត ឲ្យ ដោះលែង ជនសង្ស័យ ទាំង ២នាក់ ខាងលើ នេះ ដែរ លោក នូ ថេ អភិបាល ស្រុក លំផាត់ បាន ប្រាប់ ភ្នាក់ងារ Fresh News នៅ រសៀល ថ្ងៃ នេះ ថា រហូតមកដល់ ពេលនេះ លោក ថង សាវុន អភិបាល ខេត្ត រតនគិរី កំពុង មមាញឹក សម្របសម្រួល ជាមួយ តំណាង អយ្យការ អម សាលាដំបូង ខេត្ត រតនគិរី និង ដើម បណ្តឹង ( មន្ទីរ បរិស្ថាន ) ដើម្បីឲ្យ ពួកគេ ទាំង ២មាន សេរី វិញ ។
តំណាង ចែកចាយ និង អតិថិជន របស់ ក្រុមហ៊ុន ទ្រី លាង អ៊ែរ ខន់ បាន សម្តែង អារម្មណ៍ សប្បាយរីករាយ ដែល ក្រុមហ៊ុន បាន រៀបចំ កម្មវិធី នេះ ឡើង ដើម្បី ជា ការលើកទឹកចិត្ត ដល់ អតិថិជន បង្កើន ភាពស្និទស្នាល ជាពិសេស បង្ហាញ នូវ ផលិតផល ម៉ាស៉ីន ត្រជាក់ ថ្មី ៗ សម្រាប់ បំពេញ សេចក្តីត្រូវការ របស់ អតិថិជន ជា អ្នកប្រើប្រាស់ ។
លោក ឃួង ស្រេង ស្នើ មន្រ្តី សុខាភិបាល ថ្នាក់ដឹកនាំ គ្រឹះស្ថាន អប់រំ អាជ្ញាធរដែនដី និង ភាគី ពាក់ព័ន្ធ ជួយ ផ្សព្វផ្សាយ ព័ត៌មាន ពិត ពាក់ព័ន្ធ COVID-19 និង រួមគ្នា ឆ្លើយតប ភ្លាម ៗ នៅពេល មាន ព័ត៌មាន បំពុល
( ភ្នំពេញ ) ៖ មាន ក្រុម មនុស្ស មួយ ក្តាប់ តូច បាន និង កំពុង យក ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម ទៅ បំភ្លៃ ការពិត ទៅ លើ ករណី វីរុស កូវីដ - ១៩ ក្នុង ចេតនា បង្ករ វិច្ឆេទ កម្ម បំផ្លាញ សេចក្តីសុខ ក្នុង ការរស់នៅ របស់ ប្រជាជន កម្ពុជា ខណៈ ដែល នៅ ទូទាំង ប្រទេស កម្ពុជា មកដល់ ពេលនេះ ពុំ ទាន់ មាន ប្រជាជន ណា ម្នាក់ បាន កើត ឬ ឆ្លង វីរុស នេះ នៅឡើយ ។
ការធ្វើ វិច្ឆេទ កម្ម ដោយ ចេតនា ក្នុង ផលប្រយោជន៍ នយោបាយ ឬ បំផ្លាញ សេចក្តីសុខ ប្រជាជន ទូទាំង ប្រទេស នេះ ត្រូវបាន លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បញ្ចេញ ប្រតិកម្ម តប វិញ ដោយ ស្នើ ឱ្យ មន្រ្តី មន្ទីរ សុខាភិបាល ថ្នាក់ដឹកនាំ តាម សាលារៀន គ្រឹះស្ថាន អប់រំ អាជ្ញាធរដែនដី និង ភាគី ពាក់ព័ន្ធ ត្រូវ ផ្សព្វផ្សាយ នូវ ព័ត៌មាន ពិត ឆ្លើយតប ឱ្យ ទាន់ សភាពការណ៍ ថា នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន គ្រប់គ្រង មិន មាន អ្នកណា ម្នាក់ កើត ឬ ឆ្លង វីរុស ប្រភេទ នេះ នៅឡើយ ទេ សូម កុំ ឱ្យ មាន ការភ័យខ្លាច ដោយ គ្មាន ការពិចារណា ។
ការស្នើ របស់ លោក ឃួង ស្រេង បាន ធ្វើឡើង កាលពី ល្ងាច ថ្ងៃទី ២ ខែមីនា ឆ្នាំ ២០២០ ក្នុង ពិធី បិទ ការប្រកួត កីឡា សិស្ស មធ្យមសិក្សា ជ្រើសរើស ជើងឯក រាជធានី ភ្នំពេញ ប្រចាំ ឆ្នាំ សិក្សា ២០១៩ - ២០២០ នៅ វិទ្យាល័យ ជា ស៉ីម បឹងកេងកង ។ លោក បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន គ្មាន ហេតុផល អ្វី ដែល ត្រូវ លាក់បាំង ការពិត នៃ កូវីដ១៩ នេះ ទេ ខណៈ ដែល ពិភពលោក កំពុង មាន ការព្រួយបារម្មណ៍ យ៉ាង ខ្លាំង នោះ ។
លោក អភិបាល រាជធានី បាន បញ្ជាក់ ទៀត ថា រាជ រដ្ឋាភិបាល តាមរយៈ ក្រសួង សុខភិបាល ក៏ បាន ដាក់ចេញ វិធានការ ការពារ និង ទប់ស្កាត់ នានា ដូចជា ត្រូវ លាង ដៃ នឹង សាប៊ូ ឬ អាល់កុល ឱ្យ បាន ញឹកញាប់ មុន ពិសារ ចំណីអាហារ ឬ ប៉ះពាល់ មាត់ ច្រមុះ ។ ម៉្យាង បើ មាន ជំងឺ គ្រុន ផ្តាសាយ ត្រូវ ពាក់ ម៉ាស ការពារ កុំ ឱ្យ ឆ្លង ទៅ អ្នកដទៃ ដែល នៅ ជិត ខ្លួន ។
លោក អភិបាល ក៏ បាន ជំរុញ ឱ្យ តាម សាលារៀន នានា នៅក្នុង រាជធានី បន្ត យកចិត្តទុកដាក់ លើ ការលើកកកម្ពស់ បរិស្ថាន ក្នុង សាលា សុវត្ថិភាព ចំណីអាហារ និង បង្កើត ទីតាំង លាង ដៃ ឱ្យ បាន គ្រប់គ្រាន់ មាន សាប៊ូ ឬ អាល់កុល លាង ដៃ បំផុស ឱ្យ សិស្សានុសិស្ស មាន ការប្រុងប្រយ័ត្ន កុំ បរិភោគ ចំណីអាហារ ណា មិន មាន អនាម័យ កុំ ផឹក ភេសជ្ជៈ ណា ដែល មាន ជាតិ ផ្អែម ខ្លាំង ពេក ជាពិសេស ត្រូវ ផ្សព្វផ្សាយ នូវ សេចក្តីជូនដំណឹង របស់ ក្រសួង សុខាភិបាល ឱ្យ សិស្សានុសិស្ស និង អាណាព្យាបាល បាន ជ្រាប ដើម្បី ចូលរួម ការពារ ទាំងអស់ គ្នា ។
ពាក់ព័ន្ធ នឹង ពិធី នេះ លោក ឃួង ស្រេង លើកឡើង ថា ចក្ខុវិស័យ នៃ ការកសាង សង្គម កម្ពុជា មួយ ដែល មាន សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ និង សណ្តាប់ធ្នាប់ សង្គម មាន ការអភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព និង សមធម៌ ទាមទារ ឱ្យ ប្រជាពលរដ្ឋ មាន ចំណេះដឹង ខ្ពស់ វប្បធម៌ ជ្រៅជ្រះ ជីរភាព សមរម្យ និង មាន ការរស់នៅ សុខដុមរមនា ទាំង ក្នុង សង្គមជាតិ និង សង្គម គ្រួសារ ប្រកបដោយ និរន្តរភាព ។
លោក ឃួង ស្រេង ក៏ បាន អំពាវនាវ ឱ្យ សិស្សានុសិស្ស ជា កីឡាករ កីឡាការិនី បន្ត យកចិត្តទុកដាក់ ហ្វឹកហាត់ ឱ្យ បាន កាន់តែ ល្អ ថែម ទៀត ទាំង ចំណេះដឹង ប្រាជ្ញា ស្មារតី កិច្ចសហការ និង សុខភាព ជា ចម្បង ដើម្បី បន្ត យក ជ័យជម្នះ ជូន សាលា និង ប្រទេសជាតិ ទាំងមូល នា ពេល អនាគត ៕
ម៉ារ៉ុក និង បារាំង អញ្ជើញ កម្ពុជា ចូលរួម សន្និសីទ ស្តីពី ការថែរក្សា សន្តិភាព ក្នុង តំបន់ និយាយ ភាសា បារាំង នៅ ខែមេសា
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល ម៉ារ៉ុក និង រដ្ឋាភិបាល បារាំង បាន សរសេរ លិខិត រួមគ្នា មួយ ដើម្បី អញ្ជើញ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ទៅ ចូលរួម សន្និសីទ ស្តីពី ការថែរក្សា សន្តិភាព ក្នុង តំបន់ ដែល និយាយ ភាសា បារាំង ដែល នឹង ត្រូវ ប្រព្រឹត្តទៅ នៅក្នុង ខែមេសា ឆ្នាំ ២០២០ ខាងមុខ នេះ ។
លោក ណី សំអុល អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន អឺរ៉ុប អាមេរិក និង អាហ្វ្រិក - មជ្ឈឹម បូព៌ា បាន បញ្ជាក់ ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន យ៉ាង ដូច្នេះ ថា៖ « គោលបំណង ចម្បង នៅក្នុង ជំនួប នេះ គឺ ឯក អគ្គ រាជ ទូត គាត់ មក ដើម្បី ប្រគល់ សារលិខិត អញ្ជើញ របស់ រដ្ឋមន្ត្រី ការបរទេស ម៉ារ៉ុក ដែល ចុះហត្ថលេខា រួមគ្នា ជាមួយ រដ្ឋមន្ត្រី ការបរទេស បារាំង សូមអញ្ជើញ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន ទៅ ចូលរួម សន្និសីទ ការថែរក្សា សន្តិភាព ក្នុង តំបន់ ដែល និយាយ ភាសា បារាំង » ។
លោក ណី សំអុល បាន បន្ត ថា « អញ្ចឹង ហើយ គឺជា វេទិកា មួយ ដែល ម៉ារ៉ុក ក៏ ដូចជា បារាំង គឺ គេ ចង់ មែនទែន គឺ ចង់ឲ្យ ឧប នាយក រដ្ឋមន្ត្រី ចូលរួម ដើម្បី ចែករំលែក បទពិសោធន៍ អ្វី ដែល កម្ពុជា បាន ធ្វើ ចូលរួម ថែរក្សា សន្តិភាព នៅក្នុង តំបន់ ដែល និយាយ ភាសា បារាំង ក៏ ដូចជា នៅលើ ពិភពលោក ទាំងមូល ។ ឧប នាយក រដ្ឋមន្ត្រី ក៏ នឹង ជួប ជាមួយនឹង រដ្ឋមន្ត្រី ការបរទេស ម៉ារ៉ុក ដែរ ដើម្បី ជជែក ពិភាក្សា លើ បញ្ហា ទ្វេ ភាគី ពី បញ្ហា តំបន់ ក៏ ដូចជា បញ្ហា អន្តរជាតិ ផ្សេង ៗ » ។
នៅពេល ជំនួប នោះ លោក ឯក អគ្គ រាជ ទូត ក៏ បាន ឆ្លៀត ប្រាប់ ថា ម៉ារ៉ុក មាន ការកោតសរសើរ ចំពោះ គោល នយោបាយ របស់ កម្ពុជា ដែល ធ្វើឲ្យ មាន សុខដុម រមណីយកម្ម រវាង សាសនា ពីព្រោះ ម៉ារ៉ុក គឺជា ប្រទេស កាន់ សាសនា ឥស្លាម ៩០ ភាគរយ ។ លោក ថ្លែង ថា នៅ កម្ពុជា មាន សុខដុម រមណីយកម្ម ខ្លាំង ហើយ លើកឡើង ថា ម៉ូឌែល ដែល កម្ពុជា ធ្លាប់ ធ្វើ នោះ គួរតែ ត្រូវបាន យក ទៅ ធ្វើ បទបង្ហាញ នៅក្នុង សន្និសីទ ផងដែរ ។
ដោយឡែក ឧប នាយក រដ្ឋមន្ត្រី ប្រាប់ សុខុន បាន ឆ្លើយ ទៅវិញ ដោយ ថ្លែងអំណរគុណ ចំពោះ លិខិត អញ្ជើញ របស់ ម៉ារ៉ុក និង បារាំង ។ លោក បន្ត ថា លោក រីករាយ ដើម្បី ចូលរួម ក្នុង កម្មវិធី នោះ ក៏ប៉ុន្តែ ត្រូវ រង់ចាំ ការសម្រេច ចុងក្រោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា សិន ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន លើកឡើង ដែរ ថា កម្លាំង ថែរក្សា សន្តិភាព របស់ កម្ពុជា ចាប់តាំងពី ឆ្នាំ ២០០៦មក រហូតមកដល់ បច្ចុប្បន្ន នេះ បាន បញ្ជូន ទៅ ប្រហែល ៦៥០០ នាក់ ទៅ ៩ ប្រទេស ។ ក្នុង នោះ កម្ពុជា បាន បញ្ជូន កម្លាំង ស្ត្រី មាន ចំនួន ច្រើន គួរឲ្យ កត់សម្គាល់ បើ ប្រៀបធៀប ក្នុង បណ្តា ប្រទេស អាស៊ាន ។
ប្រមុខ ការទូត បាន លើកឡើង ថា ក្នុង បណ្តា ប្រទេស អាស៊ាន កម្ពុជា ជា ប្រទេស ដែល បញ្ជូន ទ័ព ទៅ ថែរក្សា សន្តិភាព នោះ ច្រើន ជាង គេ ដែល គិត ជា ចំណាត់ថ្នាក់ គឺជាប់ លេខ ៣ ហើយ បើ គិត ជា ស្រ្តី គឺជាប់ លេខ ២។ លោក បន្ថែម ថា ក្នុង ករណី ដែល លោក ត្រូវបាន អនុញ្ញាតឲ្យ ទៅ ចូលរួម សន្និសីទ នោះ លោក នឹង ជួប ជាមួយ រដ្ឋមន្ត្រី ការបរទេស ម៉ារ៉ុក ហើយ នឹង ពិភាក្សា ពី បញ្ហា ផ្សេង ៗ និង ទំនាក់ទំនង ទ្វេ ភាគី ដើម្បី ជំរុញ ដល់ កិច្ចសហប្រតិបត្តិការ ផ្សេង ៗ ក៏ ដូចជា ជំរុញ វិស័យ ពាណិជ្ជកម្ម សេរី ទេសចរណ៍ វប្បធម៌ និង អប់រំ ជាដើម ។
ប៉ុន្តែ ក្នុង ករណី ដែល ចាំបាច់ ត្រូវ ធ្វើដំណើរ ចេញ ពី ក្រៅ ប្រទេស បុគ្គលិក រដ្ឋាភិបាល ត្រូវ អនុវត្ត តាម ឲ្យបាន ខ្ជាប់ខ្ជួន ចំពោះ វិធានការ ទប់ស្កាត់ និង គ្រប់គ្រង ការរាតត្បាត នៃ ជំងឺ ដែល ដាក់ចេញ ដោយ ប្រទេស ជា ម្ចាស់ ផ្ទះ ហើយ នៅពេល ត្រឡប់ មកវិញ ត្រូវ គោរព តាម ចំណាត់ការ ដែល ដាក់ចេញ ដោយ អាជ្ញាធរ សុខាភិបាល ឡាវ ។ មួយ វិញទៀត អាជ្ញាធរ ឡាវ បាន ទទូច ឲ្យ សាធារណជន ប្រុងប្រយ័ត្ន ចំពោះ ព័ត៌មាន ក្លែងក្លាយ អំពី ជំងឺ COVID-19 ហើយ ជឿ តែ ទៅ លើ ប្រភព ផ្លូវការ និង គួរឲ្យ ទុកចិត្ត ប៉ុណ្ណោះ ។
គួរ ជម្រាប ថា មកទល់ ពេលនេះ ពុំ មាន ករណី ឆ្លង COVID-19 ត្រូវបាន រាយការណ៍ នៅក្នុង ប្រទេស ឡាវ នោះ ឡើយ ខណៈ ប្រទេស ដែល នៅ ជុំវិញ ដូចជា ថៃ កម្ពុជា និង វៀតណាម សុទ្ធតែ មាន ករណី អ្នក ឆ្លង ជំងឺ នេះ ក៏ប៉ុន្តែ ករណី ឆ្លង នៅ កម្ពុជា ១ករណី និង ១៦ករណី នៅ វៀតណាម ត្រូវបាន ព្យាបាល ជាសះស្បើយ អស់ ហើយ ។ ដោយឡែក នៅ ថៃ ដែល មាន ៤៣ ករណី ក្នុង នោះ ៣១ នាក់ បាន ជាសះស្បើយ ១១នាក់ កំពុង បន្ត សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ និង ម្នាក់ ស្លាប់ ៕
តើ មាន ព្រឹត្តិការណ៍ ទេសចរណ៍ អ្វី ខ្លះ នៅ ខេត្ត សៀមរាប ដែល ភ្ញៀវ ទេសចរ អាច រីករាយ ទស្សនា កម្សាន្ត បាន ក្នុង ឆ្នាំ ២០២០ នេះ ?
( សៀមរាប ) ៖ ដើម្បី ជំរុញ កំណើន ទេសចរ ទៅកាន់ ខេត្ត សៀមរាប និង ដើម្បី ជំរុញ ឱ្យ មាន ការស្នាក់ នៅក្នុង ខេត្ត នេះ ឱ្យ កាន់តែ ច្រើន ឡើងវិញ រាជ រដ្ឋាភិបាល កម្ពុជា បាន កំណត់ ឱ្យ មាន ការ រៀបចំ កិច្ចប្រជុំ ថ្នាក់ ជាតិ តំបន់ និង អន្តរជាតិ ព្រមទាំង ព្រឹត្តិការណ៍ ទេសចរណ៍ ទស្សនកិច្ច វប្បធម៌ សិល្បៈ សាសនា កីឡា ម្ហូប អាហារ ជាច្រើន ទៀត នៅ សៀមរាប - អង្គរ ចាប់ពី ដើម ឆ្នាំ រហូតដល់ ចុង ឆ្នាំ ២០២០ និង នៅ ឆ្នាំ បន្តបន្ទាប់ ខាងមុខ ទៀត ។
ព្រឹត្តិការណ៍ ទាំងនោះ ត្រូវបាន បង្ហាញ ឡើង ក្នុង កិច្ចប្រជុំ ផ្សព្វផ្សាយ វិធានការ របស់ រាជ រដ្ឋាភិបាល និង របស់ ក្រសួង ទេសចរណ៍ ដើម្បី លើកកម្ពស់ វិស័យ ទេសចរណ៍ ជាតិ ក្នុង ដំណាក់កាល កើតមាន វិបត្តិ ជំងឺ Covid-19 ដល់ បុគ្គលិក និយោជិត ប្រតិបត្តិករ ទេសចរណ៍ និង មគ្គុទ្ទេសក៍ ទេសចរណ៍ នៅ ខេត្ត សៀមរាប នា ថ្ងៃទី ០២ ខែមីនា ឆ្នាំ ២០២០ នៅ សណ្ឋាគារ រី ជេន ស៊ី អង្គរ ក្រោម អធិបតីភាព លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ ។
កិច្ចប្រជុំ និង ព្រឹត្តិការណ៍ ទាំងនោះ រួម មាន៖
* កម្មវិធី បណ្ដុះបណ្ដាល មន្ត្រី ជាន់ ខ្ពស់ អាស៊ី ប៉ាស៊ីហ្វិក របស់ អង្គការ ទេសចរណ៍ ពិភពលោក (UNTWO) ដែល នឹង ត្រូវ រៀបចំឡើង ចាប់ពី ថ្ងៃទី ២៩ ខែមេសា ដល់ ថ្ងៃទី ២ ខែឧសភា ដោយ ក្រសួង ទេសចរណ៍ ។
* ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ និង ការរៀបចំ ព្រឹត្តិការណ៍ « សៀមរាប សង្ក្រាន្ត » ដែល នឹង មកដល់ ហើយ នឹង ត្រូវ រៀបចំឡើង ចាប់ពី ថ្ងៃទី ១៣ - ១៦ ខែមេសា ដោយ រដ្ឋបាល ខេត្ត សៀមរាប សហការ ជាមួយ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ អាជ្ញាធរ ជាតិ អប្សរា និង ក្រសួង ទេសចរណ៍ ។
* កិច្ចប្រជុំ ថ្នាក់ តំបន់ លើ យន្តការ អាស៊ាន ស្ដីពី ការវាយតម្លៃ លើ ការសិក្សា ពី មុន ដែល នឹង ត្រូវ រៀបចំឡើង ចាប់ពី ថ្ងៃទី ១៨ - ១៩ ខែឧសភា ដោយ ក្រសួង ទេសចរណ៍ ។
* កិច្ចប្រជុំ ថ្នាក់ តំបន់ លើ ការធ្វើ បច្ចុប្បន្នកម្ម ស្ដង់ដា សហគមន៍ ទេសចរណ៍ អាស៊ាន ដែល នឹង ត្រូវ រៀបចំឡើង ចាប់ពី ថ្ងៃទី ២៣ - ២៤ ខែមិថុនា ដោយ ក្រសួង ទេសចរណ៍ ។
* សន្និសីទ អន្តរជាតិ លើក ទី២ ស្ដីពី ទេសចរណ៍ ម្ហូប អាហារ ដែល នឹង ត្រូវ រៀបចំឡើង ចាប់ពី ថ្ងៃទី ១៤ - ១៧ ខែកក្កដា ដោយ ក្រសួង ទេសចរណ៍ ។
* ព្រឹត្តិការណ៍ « ព្រះអាទិត្យ រះ ចំកំពូល ប្រាង្គ កណ្ដាល នៃ ប្រាសាទ អង្គរវត្ត » លើក ទី២ ដែល នឹង ត្រូវ កើតមាន នៅ ចន្លោះ ថ្ងៃទី ២០ - ២៣ ខែកញ្ញា ដោយ ក្រសួង ទេសចរណ៍ សហការ ជាមួយ អាជ្ញាធរ ជាតិ អប្សរា និង រដ្ឋបាល ខេត្ត សៀមរាប ។
* ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង អក អំបុក សំពះ ព្រះខែ ដែល នឹង ត្រូវ រៀបចំឡើង នា កំលុង ចុង ខែវិច្ឆិកា ដោយ រដ្ឋបាល ខេត្ត សៀមរាប ។
បើ ទោះបី កម្ពុជា រក មិន ទាន់ ឃើញ អ្នក ផ្ទុក វីរុស នេះ ថ្មី ក្រៅពី ជនជាតិ ចិន ម្នាក់ ដែល ត្រូវបាន ព្យាបាល ជាសះស្បើយ នោះ លោកស្រី លី អៃ ឡែន បាន លើកឡើង ទៀត ថា អង្គការ WHO បន្ដ សហការ ជាមួយ ក្រសួង សុខាភិបាល កម្ពុជា និង ដៃគូរ ពាក់ព័ន្ធ បន្ដ តាមដាន យ៉ាង យកចិត្តទុកដាក់ បំផុត ពោល មិន បណ្ដែតបណ្ដោយ នោះ ទេ ។ ប្រសិនបើ មាន ករណី ថ្មី កើតឡើង ក៏ ក្រសួង ផ្សព្វផ្សាយ ជូន ប្រជាពលរដ្ឋ ផងដែរ មិន លាក់បាំង នោះ ទេ ។
លោកស្រី ប្រធាន អង្គការ WHO នៅ កម្ពុជា ក៏ បាន អះអាង ដែរ ថា WHO និង ក្រសួង សុខាភិបាល កម្ពុជា បាន ត្រៀមលក្ខណៈ រួចរាល់ហើយ ដើម្បី ទប់ស្កាត់ ការឆ្លង ជំងឺ នេះ នៅពេល ខាងមុខ ពិសេស ការឆ្លង នៅ តាម សហគមន៍ តែម្ដង ។ ប៉ុន្ដែ លោកស្រី សង្កត់ធ្ងន់ ថា អង្គការ សុខភាព ពិភពលោក កំពុងតែ ធ្វើ ការបន្ដ ជាមួយ ក្រសួង សុខាភិបាល កម្ពុជា ក៏ ដូចជា ដៃគូរ អភិវឌ្ឍន៍ ផ្សេង ទៀត ដើម្បី ពិនិត្យ មើល ឡើងវិញ នៅលើ និយមន័យ ករណី វីរុស មួយ នេះ ។
ក្នុង សន្និសីទ ព័ត៌មាន ម្សិលមិញ នេះ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ថា គិត ត្រឹម ថ្ងៃទី ០២ ខែមីនា ឆ្នាំ ២០២០ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បាន ធ្វើតេស្ត សំណាក លើ មនុស្ស ទាំង ខ្មែរ និង បរទេស ចំនួន ១៣៥ នាក់ តែ មិន មាន មេរោគ COVID19 នោះ ទេ ។
កាកបាទ ក្រហម កម្ពុជា ផ្អាក ការប្រារព្ធ មិ ទ្ទីង ថ្នាក់ ជាតិ អបអរ ខួប ទី១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភា ២០២០
ទោះបីជា មិន មាន ការរៀបចំ ពិធី ដើម្បី អបអរ ខួប លើក ទី ១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម អឌ្ឍ ចន្ទ ក្រហម ដូច ធ្លាប់ បាន ធ្វើជា រៀងរាល់ ឆ្នាំ ក្តី ក៏ កាកបាទ ក្រហម កម្ពុជា នៅតែ បន្ត កៀរគរ មូលនិធិ និង ស្វាម គមន៍ ការ ចូលរួម ជា វិភាគទាន ពីសំណាក់ សម្តេច ឯកឧត្តម អ្នក ឧកញ៉ា លោក ឧកញ៉ា លោកជំទាវ លោក លោកស្រី ជា សប្បុរសជន ទាំង ក្នុង វិស័យ រដ្ឋ និង វិស័យ ឯកជន ដូច ធ្លាប់ បាន ធ្វើ កាលពី ឆ្នាំ កន្លងទៅ ទាំង នៅ ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ ទាំងស្រុង នៃ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ការផ្អាក ការប្រារព្ធ មិ ទ្ទីង ថ្នាក់ ជាតិ ដើម្បី អបអរ ខួប ទី១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២០៖ ការស្តារ អូរ សំខាន់ ៗ ទាំង៥ នៅក្នុង ក្រុង ព្រះសីហនុ រួចរាល់ ជិត ៥៦% . រសៀល នេះ ប្រតិភូ ព្រឹទ្ធសភា បន្ត ចុះ ពិនិត្យ បន្ថែម ទៀត
( ព្រះសីហនុ) ៖ នៅ រសៀល ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ ប្រតិភូ ព្រឹទ្ធសភា ដឹកនាំ ដោយ លោក គង់ សារាជ ប្រធាន គណៈកម្មការ ទី៩ ព្រឹទ្ធសភា បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យមើល វឌ្ឍនភាព នៃ ការស្តារ អូរ សំខាន់ ៗ ទាំង៥ នៅក្នុង ក្រុង ព្រះសីហនុ ជាមួយនឹង ការជំរុញ និង កោតសរសើរ ពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ក្នុង ការស្តារ អូរ ប្រឡាយ នៅក្នុង ខេត្ត ព្រះសីហនុ នេះ ។
សូម ជម្រាប ថា គិត ត្រឹម ខែមីនា ឆ្នាំ ២០២០ នេះ ការស្តារ អូរ សំខាន់ ៗ ទាំង៥ នៅក្នុង ក្រុង ព្រះសីហនុ ដែល មាន ប្រវែង ២៩.៧៩១ ម៉ែត្រ បាន ស្ដារ រួចរាល់ ប្រវែង ១៦.៦៧០ ម៉ែត្រ ស្មើនឹង ៥៥.៩៦ % ហើយ ចំណែកឯ ប្រវែង ដែល នៅ សេសសល់ ក្រសួង និង សហការ ជាមួយ អាជ្ញាធរដែនដី ដើម្បី ពន្លឿន ការការងារ ស្ដារ ឱ្យ បាន ចប់ សព្វគ្រប់ នៅមុន រដូវ ភ្លៀង ធ្លាក់ មកដល់ ។
ការពន្លឿន ការស្ដារ អូរ សំខាន់ ៗ មួយចំនួន នៅក្នុង ក្រុង ព្រះសីហនុ នេះ សំដៅ ការពារ និង ទប់ស្កាត់ កុំ ឱ្យ មាន ការជន់ លិច លង់ ដោយសារ ទឹកភ្លៀង នៅ រដូវ វស្សា ដែល នឹង ចូល មកដល់ នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ក៏ ដូចជា រៀបចំ ប្រព័ន្ធ ប្រឡាយ ទឹក នៅ ទីក្រុង មួយ នេះ ឱ្យ មាន ភាពទាក់ទាញ និង អានាម័យ ល្អ តាម ផែនការ ។
លោក អ៊ុក សាវុធ និង គ្រួសារ នាំយក ថវិកា ២ម៉ឺន ដុល្លារ ដែល ជា បច្ច័យ បាន ពិធី បុណ្យ សព ម្តាយ ប្រគល់ ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា
( ភ្នំពេញ ) ៖ ថវិកា ចំនួន ២ម៉ឺន ដុល្លារ ដែល ជា បច្ច័យ បាន មកពី ពិធី បុណ្យ គំរប់ ខួប ៧ ថ្ងៃ និង ១០០ ថ្ងៃ ឧទ្ទិស កុសល ជូន ដល់ លោកយាយ ឧបាសិកា ប៊ួយ ទង ត្រូវ ជា ម្តាយ របស់ លោក អ៊ុក សាវុធ អគ្គ ព្រះរាជអាជ្ញា អម សាលា ឧទ្ទរណ៍ ដែល បាន ធ្វើ មរណកាល ទៅកាន់ លោក ខាងមុខ កាលពី ថ្ងៃពុធ ទី ២៩ ខែមករា ឆ្នាំ ២០២០ កន្លងមក នេះ ត្រូវបាន លោក អ៊ុក សាវុធ និង លោកស្រី ទ្រី អេង ប្រគល់ ជូន ដល់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា នៅ រសៀល ថ្ងៃអង្គារ ទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ ។
ថវិកា នេះ ត្រូវបាន ធ្វើ ការប្រគល់ ជូន ទៅ លោក បណ្ឌិត ចន ណារិទ្ធ ប្រធាន លេខាធិការដ្ឋាន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា និង ដោយ មាន វត្តមាន លោក សាស្រ្តាចារ្យ គី សន់ ទី ប្រធាន មន្ទីរពេទ្យ គន្ធ បុប្ផា ផងដែរ ។
លោក អ៊ុក សាវុធ បាន បញ្ជាក់ ថា ការផ្តល់ បច្ច័យ ជូន ដល់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា នា ពេលនេះ គឺ ធ្វើឡើង តាម បណ្តាំ របស់ លោកយាយ ឧបាសិកា ប៊ួយ ទង ដើម្បី ជា ការរួមចំណែក ទ្រទ្រង់ ដល់ ដំណើរការ មន្ទីរពេទ្យ គន្ធ បុប្ផា ដែល ត្រូវការ ចំណាយ ថវិកា សម្រាប់ ជួយសង្គ្រោះ ពិនិត្យ និង ព្យាបាល ជំងឺ ដល់ កុមារ កម្ពុជា ។
លោក សាស្រ្តាចារ្យ វេជ្ជបណ្ឌិត គី សន់ ទី ប្រធាន មន្ទីរពេទ្យ គន្ធ បុប្ផា បាន ឱ្យដឹង ថា ក្នុង មួយ ថ្ងៃ មន្ទីរពេទ្យ គន្ធ បុប្ផា ទាំង ពីរ ទីតាំង ទាំង នៅ រាជធានី ភ្នំពេញ និង ខេត្ត សៀមរាប មាន កុមារ កម្ពុជា ជា មធ្យម ប្រមាណ ជាង ៣០០០ នាក់ មក ពិគ្រោះ ជំងឺ ក្រៅ ក្នុង ចំនោម នោះ មាន ១៥% ត្រូវ ដាក់ ឱ្យ សម្រាក នៅ មន្ទីរពេទ្យ ដោយសារ ជា ជំងឺ ធ្ងន់ មាន ប្រមាណ ៥០០ នាក់ ហើយ មន្ទីរ ត្រូវ ចំណាយ ថវិកា ប្រមាណ ៤២ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ សម្រាប់ ទ្រទ្រង់ ដំណើរការ មន្ទីរពេទ្យ នេះ ។
លោក បណ្ឌិត ចន ណារិទ្ធ បាន ថ្លែង នូវ អំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ លោក អ៊ុក សាវុធ និង ក្រុមគ្រួសារ សម្រាប់ ទឹកចិត្ត ដ៏ សប្បុរស នេះ ។
គួរ បញ្ជាក់ ថា មន្ទីរពេទ្យ គន្ធ បុប្ផា បាន បង្កើត ចាប់តាំងពី ឆ្នាំ ១៩៩២ ផ្តល់ នូវ សេវា ពិនិត្យ ព្យាបាល ជូន ទារក កុមារ ស្ត្រី កម្ពុជា ដោយ ឥត គិត ថ្លៃ ៕
ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី កុមារ ប្រជុំ ពិនិត្យ ផ្ដល់ យោបល់ លើ ការសិក្សា ស្រាវជ្រាវ ការកេងប្រវ័ញ្ច ផ្លូវភេទ លើ កុមារ តាម ប្រព័ន្ធ អ៉ិនធ័រណេត
( ភ្នំពេញ ) ៖ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី កុមារ ( ក .ជ .ក ) បាន សហការ ជាមួយ អង្គការ APLE បាន រៀបចំ កិច្ចប្រជុំ ក្រុមការងារ បច្ចេកទេស អន្តរ ក្រសួង ដើម្បី ពិនិត្យ ផ្តល់ យោបល់ លើ ការ សិក្សា ស្រាវជ្រាវ ការកេងប្រវ័ញ្ច ផ្លូវភេទ លើ កុមារ តាម ប្រព័ន្ធ អ៉ិនធ័រណេត នៅ កម្ពុជា ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង រយៈពេល ពីរ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៣ ដល់ ថ្ងៃទី ០៤ ខែមីនា ឆ្នាំ ២០២០ ក្រោម អធិបតីភាព លោកស្រី ញ៉េ ប សុភាព អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ កម្ព ជា ដើម្បី កុមារ ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្នុង គោលបំណង ពិនិត្យ និង ផ្តល់ យោបល់ លើ កម្រង សំណួរ ការអង្កេត ស្តីពី ការទប់ស្កាត់ គ្រោះថ្នាក់ ពី ការកេងប្រវ័ញ្ច ផ្លូវភេទ លើ កុមារ តាម ប្រព័ន្ធ អនឡាញ នៅ កម្ពុជា ។ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក លោកស្រី ដែល ជា ក្រុម កាងារ បច្ចេកទេស មកពី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ . មន្ត្រី អគ្គ លេខាធិការដ្ឋាន ក . ជ. ក និង អង្គការ ដៃគូ ពាក់ព័ន្ធ នានា ៕
ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន ដឹកនាំ កិច្ចប្រជុំ ថ្នាក់ដឹកនាំ ក្រសួង ដើម្បី ពិនិត្យ និង ពិភាក្សា លើ ឯកសារ សំខាន់ ៗ ចំនួន ២
( ភ្នំពេញ ) ៖ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ( ក .ស. ហ. វ. ) នា ព្រឹក ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ថ្នាក់ដឹកនាំ ក្រសួង ដើម្បី ពិនិត្យ និង ពិភាក្សា លើ ឯកសារ ចំនួន ២ គឺ ១៖ សេចក្តីព្រាង « អនុក្រឹត្យ ស្តីពី ការគ្រប់គ្រង ការវិនិយោគ សាធារណៈ » និង ២៖ សេចក្តីព្រាង « ផែនការ សកម្មភាព លម្អិត សម្រាប់ អនុវត្ត យុទ្ធសាស្ត្រ ស្តីពី ការកែទម្រង់ ប្រព័ន្ធ គ្រប់គ្រង ការវិនិយោគ សាធារណៈ ២០១៩ - ២០២៥ » ។
សេចក្តីព្រាង ឯកសារ ដ៏ មាន សារៈសំខាន់ ទាំង ពីរ ខាងលើ ត្រូវបាន រៀបចំឡើង ដោយ ក្រុមការងារ បច្ចេកទេស នៃ ក .ស. ហ. វ . តាម ការចង្អុល របស់ យុទ្ធសាស្ត្រ ស្តីពី ការកែទម្រង់ ប្រព័ន្ធ គ្រប់គ្រង ការវិនិយោគ សាធារណៈ ២០១៩ - ២០២៥ ដែល រាជ រដ្ឋាភិបាល បាន អនុម័ត កាលពី ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០១៩ និង ប្រកាស ដាក់ ឲ្យ អនុវត្ត នា សម័យ ប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្រ្តី កាលពី ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០១៩ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
សេចក្តីព្រាង ឯកសារ ទាំង ពីរ នេះ ត្រូវបាន ដាក់ ឆ្លង កិច្ចពិភាក្សា កម្រិត បច្ចេកទេស ផ្ទៃក្នុង ក .ស. ហ. វ . ជាច្រើន លើក ច្រើន សារ និង សិក្ខាសាលា ពិគ្រោះយោបល់ កម្រិត បច្ចេកទេស ជាមួយ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ និង ដៃគូ អភិវឌ្ឍន៍ នានា ព្រមទាំង អគ្គ នាយកដ្ឋាន / អង្គភាព ពាក់ព័ន្ធ ក្រោម ឱវាទ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ រួចរាល់ ហើយ មុននឹង យក មក ពិនិត្យ ពិភាក្សា និង សម្រេច នា ថ្ងៃ នេះ ។
ជា រួម . « អនុក្រឹត្យ ស្តីពី ការគ្រប់គ្រង ការវិនិយោគ សាធារណៈ » មាន គោលដៅ កំណត់ គោលការណ៍ ជា សារវន្ត និង ប្រព័ន្ធ នៃ ការគ្រប់គ្រង ការវិនិយោគ សាធារណៈ ជា អាទិ៍ រួម មាន៖
ដោយឡែក « ផែនការ សកម្មភាព លម្អិត សម្រាប់ អនុវត្ត យុទ្ធសាស្ត្រ ស្តីពី ការកែទម្រង់ ប្រព័ន្ធ គ្រប់គ្រង ការវិនិយោគ សាធារណៈ ២០១៩ - ២០២៥ » គឺជា ឧបករណ៍ ជំនួយ ក្នុង ការត្រួតពិនិត្យ . តាមដាន . និង វាយតម្លៃ លើ វឌ្ឍនភាព នៃ ការអនុវត្ត យុទ្ធសាស្រ្ត ស្តីពី ការកែទម្រង់ ប្រព័ន្ធ គ្រប់គ្រង ការវិនិយោគ សាធារណៈ ២០១៩ - ២០២៥ ប្រចាំ ត្រីមាស និង ប្រចាំ ឆ្នាំ ដែល កំណត់ ច្បាស់លាស់ អំពី៖ សូចនាករ សមិទ្ធកម្ម គន្លឹះ . ក្របខ័ណ្ឌ ពេលវេលា អនុវត្ត . និង អង្គភាព ទទួលខុសត្រូវ ។
( ភ្នំពេញ ) ៖ នៅ ចន្លោះ ទីក្រុង រណប កាំ កូ និង ខណ្ឌ ទួលគោក បាន នឹង កំពុង ក្លាយជា តំបន់ មួយ ដែល មាន ការអភិវឌ្ឍ ខ្លាំង នៅក្នុង ទីក្រុង ភ្នំពេញ ពោលគឺ វត្តមាន នៃ គម្រោង ខុនដូ លំនៅឋាន និង សំណង់ អគារ ជាច្រើន ដែល កំពុង រីក ដុះដាល ដូច ផ្សិត នៅ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ។
