( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន ថ្លែង ក្រើន រំលឹក ដល់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ ចៀស ឲ្យ ឆ្ងាយ ពាក្យ « កុំ » ចំនួន ៤យ៉ាង គឺ កុំ ពាក់ព័ន្ធ កុំ ធ្វើជា បង្អែក កុំ បន្ធូ បន្ថយ និង កុំ អន្តរាគមន៍ ។
លោក ម៉ែន វិបុល ថ្លែង បែប នេះ នៅក្នុង ពិធី បើក សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០១៩ និង លើក ទិសដៅ ការងារ សម្រាប់ អនុវត្ត ឆ្នាំ ២០២០ របស់ រដ្ឋបាល ខេត្ត និង ក្រុមការងារ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២០ ដែល មាន ការចូលរួម ពី មន្ត្រី ដែល ពាក់ព័ន្ធ សរុប ប្រមាណ ៤០០ នាក់ ។
លោក អភិបាល ខេត្ត ក៏ បាន ថ្លែង នូវ ការ ផ្ដាំផ្ញើ ដល់ អង្គ សន្និបាត នូវ ចំណុច សំខាន់ ៗ មួយចំនួន ដូច ជា៖
សូម បញ្ជាក់ ថា នៅក្នុង សន្និបាត នេះ ក៏ មាន បទ អន្តរាគមន៍ របស់ មន្ទីរ - អង្គភាព មួយចំនួន បាន លើកឡើង អំពី បញ្ហា ប្រឈម និង វឌ្ឍនៈ ភាព ការងារ របស់ ខ្លួន ផងដែរ ៕
អគ្គ នាយក អាជ្ញាធរ ជាតិ អប្សរា ចុះ ពិនិត្យ កិច្ចការ អភិរក្ស និង អភិវឌ្ឍន៍ ក្នុង - ក្រៅ បរិវេណ ប្រាសាទ អង្គរវត្ត
( សៀមរាប ) ៖ លោក ហង់ ពៅ អគ្គ នាយក អាជ្ញាធរ ជាតិ អប្សរា អម ដំណើរ ដោយ អគ្គ នាយក រង ប្រធាន នាយកដ្ឋាន និង សហការី ជំនាញ នា ព្រឹក ថ្ងៃទី ១២ ខែមិនា ឆ្នាំ ២០២០ បាន ចុះ ពិនិត្យ កិច្ចការ អភិរក្ស និង ការអភិវឌ្ឍ នៅក្នុង និង ក្រៅ បរិវេណ ប្រាសាទ អង្គរវត្ត ។
ដំណើរ ចុះ ពិនិត្យ នេះ លោក ហង់ ពៅ និង ក្រុម អ្នកជំនាញ បាន អញ្ជើញ ទៅការដ្ឋាន កំណាយ ស្រះ ខាងជើង ដើម្បី តាមដាន ការវិវឌ្ឍ នៃ ការកាយ កំណក ដី ការរៀបចំ ហេដ្ឋារចនាសម្ពន្ធ ស្រះ និង ផ្តល់ អនុសាសន៍ កែលម្អ ចំណុច ខ្វះខាត ផងដែរ ។ បន្ទាប់ពី នោះ ក៏ បាន ចុះ ពិនិត្យមើល ប្រព័ន្ធ បង្ហូរ ទឹក និង សម្ភារ ( ទុយោ ) សម្រាប់ ដាក់ពង្រាយ តាម ប្រឡាយ តូច ៗ ដើម្បី ស្រោចស្រព ស្មៅ ក្នុង បរិវេណ អង្គរវត្ត ។
លោក ក៏ បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យ កិច្ចការ អភិវឌ្ឍន៍ នៅ ខាងលិច នៃ ប្រាសាទ អង្គរវត្ត ទាក់ទង នឹង ការរៀបចំ សណ្តាប់ធ្នាប់ ជាប់ ប៉ុស្តិ៍ នគរបាល ការពារ បេតិកភណ្ឌ មជ្ឈមណ្ឌល បដិសណ្ឋារកិច្ច ការកាត់ ក្រី មែក ឈើ ការរៀបចំ សួន ស្មៅ ដើមឈើ និង ពិនិត្យ ការដាក់ លូ នៅក្នុង ប្រព័ន្ធ រំដោះ ទឹកភ្លៀង ថែម ទៀត ។
លោក ហង់ ពៅ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ អ្នកជំនាញ គ្រប់ ការដ្ឋាន ដែល បាន បំពេញ ការងារ បាន ល្អ ប្រសើរ និង សម្រេច ផល គួរ មោទនភាព ក្នុង ការរៀបចំ បរិស្ថាន សណ្តាប់ធ្នាប់ និង ផ្នែក បុរាណវិទ្យា ដើម្បី លើកតម្លៃ នៃ រមណីយដ្ឋាន អង្គរ ៕ ក្រសួង ព័ត៌មាន សម្រេច បង្កើត គណៈកម្មការ តាមដាន ការផ្សព្វផ្សាយ ព័ត៌មាន ក្លែងក្លាយ
( ភ្នំពេញ ) ៖ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បាន ចេញ សេចក្តីសម្រេច បង្កើត គណៈកម្មការ តាមដាន ការផ្សព្វផ្សាយ ព័ត៌មាន ក្លែងក្លាយ ។
បើ យោង តាម សេចក្តីសម្រេច ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន ឲ្យដឹង ថា គណៈកម្មការ នេះ ត្រូវបាន បង្កើតឡើង ដើម្បី តាមដាន ការផ្សាយ ព័ត៌មាន ក្លែងក្លាយ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ និង បណ្តាញ ទំនាក់ទំនង សង្គម ក្នុង ប្រទេស កម្ពុជា ។
គណៈកម្មការ តាមដាន ការផ្សព្វផ្សាយ ព័ត៌មាន ក្លែងក្លាយ មាន ប្រធាន អនុប្រធាន និង សមាជិក ចំនួន ២៣រូប ៕
ព័ត៌មាន លម្អិត សូម អាន សេចក្តីសម្រេច ខាងក្រោម៖
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ចុះ ពិនិត្យ ការងារ ប្រុងប្រៀប សមយុទ្ធនាគ មាស ឆ្នាំ ២០២០ និង ក្រុង ពាលី សុំ សេចក្តីសុខ មុន បើក សមយុទ្ធ
( កំពត) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា ប្រធាន គណៈកម្មការ ដឹកនាំ សមយុទ្ធនាគ មាស ឆ្នាំ ២០២០ រវាង កងទ័ព កម្ពុជា - ចិន បាន ចុះ ពិនិត្យ ការងារ ប្រុងប្រៀប សមយុទ្ធនាគ មាស ឆ្នាំ ២០២០ និង ក្រុង ពាលី សុំ សេចក្តីសុខ នៅ ទីលាន សាលា ហ្វឹកហ្វឺន ជុំ គីរី តេជោ សែន ស្ថិត ក្នុង ភូមិ អូរ ឃុំ ត្រពាំង រាំង ស្រុក ជុំ គិរី ខេត្ត កំពត នៅ ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២០ នេះ ។
ក្រុមហ៊ុន បណ្តាញ សង្គម ដែល មាន មូលដ្ឋាន ក្នុង ទីក្រុង សាន់ហ្រ្វាន់ស៊ីស្កូ នៃ រដ្ឋ កាលីហ្វរញ៉ា មួយ នេះ មាន ការិយាល័យ តំណាង សរុប ចំនួន ៣៥កន្លែង នៅ ជុំវិញ ពិភពលោក ដោយ ក្នុង នោះ ការិយាល័យ ប្រចាំ នៅ ទីក្រុង ហុងកុង ព្រមទាំង នៅ ប្រទេស ជប៉ុន និង កូរ៉េ ខាងត្បូង គឺ បាន តម្រូវឲ្យ បុគ្គលិក ធ្វើការងារ ពី ផ្ទះ ទៅ រួចស្រេច ហើយ នា ពេល កន្លងមក ក្រោម ចំណាត់ការ របស់ អាជ្ញាធរ នៃ ទីក្រុង និង ប្រទេស ទាំងនោះ ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ COVID-19 ។
ជូនដំណឹង ! សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខណ្ឌ ឫស្សីកែវ និង រៀបចំ សង្ក្រាន្ដ ឆ្នាំ ថ្មី នៅ វត្ត ទួល អស់ លោក
( ភ្នំពេញ ) ៖ ដើម្បី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ នា ពេល ខាងមុខ ចាប់ ថ្ងៃទី ១៣ រហូតដល់ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខណ្ឌ ឫស្សីកែវ និង រៀបចំ សង្ក្រាន្ដ ឆ្នាំ ថ្មី នៅ បរិវេណ វត្ត ទួល សន្តិវ័ន ហៅ វត្ត ទួល អស់ លោក ស្ថិត ក្នុង ភូមិ ក្រោល គោ សង្កាត់ គីឡូម៉ែត្រ លេខ ៦ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។
ព្រឹត្តការណ៍ សង្ក្រាន្ដ ដែល រៀបចំឡើង ដោយ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខណ្ឌ ឫស្សីកែវ នេះ ក៏ មាន ការរាំ លេង កំសាន្ដ និង លេង ល្បែង ប្រជាប្រិយ តាម ទំនៀមទំលាប់ ប្រពៃណី ជាតិ ខ្មែរ ព្រមទាំង មាន ពិធី ស្រង់ ព្រះ នៅ ថ្ងៃទី ១៦ វេលា ម៉ោង ១៤៖០០ នាទី រសៀល ត្រូវ និង ថ្ងៃ ចូល ឆ្នាំ ថ្ងៃទី៤ ផងដែរ ។
