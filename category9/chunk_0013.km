លោក វ៉ា រស្មី រ័ត្ន បាន បញ្ជាក់ បន្ត ថា៖ « ដោយសារ យើង ឃើញ ថា តម្រូវការ ទីផ្សារ យើង មាន ច្រើន អញ្ចឹង ថេសា នឹង ប្រឹង អស់ លទ្ធភាព នៅក្នុង ការផ្តល់ ជូន នូវ សេវាកម្ម ដ៏ ល្អ ជូន អតិថិជន ជាពិសេស បន្ថែម លើ នោះ ថេ សាយើង នឹង ជួយ សម្រួល ដល់ អតិថិជន ដោយ យើង មាន ក្រុម ជំនាញ ក្នុង ការប្រឹក្សា យោបល់ ចំពោះ អតិថិជន ណា ដែល គាត់ មាន តម្រូវការ ខាង គ្រឿងអលង្ការ ។ យើង មាន ជា ភ្នាក់ងារ ជំនាញ ដើម្បី ផ្តល់ ជា ដំបូន្មាន ក៏ ដូចជា ផ្តល់ ប្រឹក្សា ជូន អតិថិជន នូវ រាល់ ម៉ោង ធ្វើការ » ។
សេចក្តីព្រាង ច្បាប់ នេះ ត្រូវបាន គណៈកម្មការ ជំនាញ រដ្ឋសភា បើក កិច្ចប្រជុំ ជាមួយ តំណាង រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ លោក ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ រសៀល ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ នៅ វិមាន រដ្ឋសភា ដើម្បី ពិនិត្យ ចុងក្រោយ មុននឹង ដាក់ ចូល រដ្ឋ សភា អនុម័ត
លោក បណ្ឌិត បាន លើកឡើង ថា សមាជិក អាស៊ាន ទាំងអស់ បាន ឯកភាព ចាប់ផ្តើម អនុវត្ត ជា ផ្លូវការ AWSC ក្នុង តំបន់ អាស៊ាន ចាប់ ខែមីនា ឆ្នាំ ២០២០ បន្ទាប់ពី ការផ្តល់ សច្ចាប័ន លើ ពិធីសារ នេះ ត្រូវបាន បំពេញ រួចរាល់ ដោយ សមាជិក អាស៊ាន ទាំងអស់ ។
ជាមួយគ្នា នោះ ដែរ លោក បាន លើកឡើង ថា សេចក្តីព្រាង ច្បាប់ នេះ មិន មាន ការពិបាក នោះ ទេ ព្រោះ ជា ការផ្ត លើ សច្ចាប័ន តែ ប៉ុណ្ណោះ ។ សេចក្តីព្រាង ច្បាប់ នេះ ត្រូវបាន គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា បាន បើក កិច្ចប្រជុំ ដោយ បាន សម្រេច បញ្ជូន មក គណៈ ជំនាញ ដោយ គ្មាន ការកែប្រែ ខ្លឹមសារ ដែល រាជ រដ្ឋាភិបាល តាក់តែង នោះ ទេ ។ លោក បន្ថែម ថា សេចក្តីព្រៀង ច្បាប់ នេះ ត្រូវបាន ធ្វើ វិសោនកម្ម មាន ២មាត្រា ប៉ុណ្ណោះ ។
ចំណែក លោកស្រី នឹន សា ផុន តំណាង គណៈកម្មការ សាធារណការ ដឹកជញ្ជូន ទូរគមនាគមន៍ ប្រៃសណីយ៍ ឧស្សាហកម្ម រ៉ែ ថាមពល ពាណិជ្ជកម្ម រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ នៃ រដ្ឋសភា បាន លើកឡើង ថា សេចក្តីព្រាង ច្បាប់ នេះ ពិតជា មាន សារសំខាន់ សម្រាប់ កម្ពុជា ដូចជា បាន អនុញ្ញាត សហគ្រាស ធុន តូច និង ធម្យម ក្នុង ការនាំ ផលិតផល ទៅកាន់ ទីផ្សារ អាស៊ាន និង សារៈ អត្ថប្រយោជន៍ ជាច្រើន ទៀត ។
ជាមួយគ្នា នោះ លោក បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ តំណាង រដ្ឋាភិបាល បាន លើកឡើង ថា លោក នឹង ត្រៀមខ្លួន ក្នុង ការចូលរួម សម័យ ប្រជុំ សភា នៅពេល ខាងមុខ នេះ ដើម្បី បំភ្លឺ រាល់ច ង្ងល់ នានា ទាក់ទង នឹង ច្បាប់ នេះ ៕
ស្នងការ ខេត្ត កណ្ដាល លើកទឹកចិត្ត នគរបាល ស្ត្រី ក្នុង ខួប លើក ទី ១០៩ ទិវា អន្តរជាតិ នារី ៨ មីនា
( កណ្ដាល ) ៖ ស្នងការ នគរបាល ខេត្ត កណ្តាល លោក ឧត្តមសេនីយ៍ ត្រី ឈឿន សុចិត្ត នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នះ បាន ជំរុញ និង លើកទឹកចិត្ត ដល់ នគរបាល ជា ស្ត្រី ភេទ ឲ្យ មាន កម្លាំងចិត្ត ក្នុង ការធ្វើ ការងារ និង រៀបចំ តំឡើង ឋានន្តរសក្ដិ ទៅ តាម សមត្ថភាព ផងដែរ ។
ការជំរុញ និង លើកទឹកចិត្ត បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ឧត្តមសេនីយ៍ ត្រី ឈឿន សុចិត្ត អញ្ជើញ ជួប សំណេះសំណាល និង សាកសួរ សុខទុក្ខ មន្ត្រី នគរបាល ស្ត្រី ចំនួន ៩១ រូប ដើម្បី អបអរ ខួប លើក ទី ១០៩ ទិវា អន្តរជាតិ នារី ៨ មីនា ក្រោម ប្រធានបទ « មាន សន្តិភាព មាន ការលើកកម្ពស់ សមាសភាព យេនឌ័រ » ។
ក្នុង ជួប សំណេះសំណាល និង សាកសួរ សុខទុក្ខ នា ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន ការចូលរួម ពី លោក - លោកស្រី ស្នងការរង . លោក នាយ ការិយាល័យ ជំនាញ និង មន្ត្រី នគរបាល ស្ត្រី ចំនួន ៩១ រូប ផងដែរ ។
បន្ទាប់ពី ស្តាប់ លោកស្រី ឧត្តមសេនីយ៍ ត្រី ឈឹម វណ្ណ នី ស្នងការ រង ទទួល ការងារ យេនឌ័រ អាន របាយការណ៍ ស្វាគមន៍ និង ព្រះរាជ សារ របស់ សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនី នាថ សីហនុ រួច មក លោក ស្នងការ បាន ពាំនាំ ការសួរសុខទុក្ខ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ បាន ស្នើ ដល់ លោក - លោកស្រី ស្នងការ រង និង លោក នាយ ការិយាល័យ បុគ្គលិក ធ្វើ ការពិនិត្យមើល សមត្ថភាព មន្ត្រី នគរបាល ស្ត្រី និង លើកទឹកចិត្ត ពួកគាត់ ដោយ រៀបចំ តំឡើង ឋានន្ត ស័ក្តិ និង តួនាទី តាម លទ្ធភាព ដែល អាច ធ្វើ បាន ។
លោក ឧត្តមសេនីយ៍ ត្រី ឈឿន សុចិត្ត បាន ចែកជូន ក្រណាត់ សំពត់ អំបោះ ខ្មែរ ជា វត្ថុអនុស្សាវរីយ៍ និង ថវិកា ១០ម៉ឺន រៀល ដល់ មន្ត្រី នគរបាល ស្ត្រី ម្នាក់ ៗ ផងដែរ ៕ លោកស្រី មាន សំអាន ស្នើ ដល់ បងប្អូន នារី ខិតខំ ប្រឹងប្រែង ផ្សព្វផ្សាយ ពី លក្ខន្តិកៈ និង ស្វែងរក មូលនី ធី សម្រាប់ ទ្រទ្រង់ សកម្មភាព មនុស្សធម៌
ថ្នាក់ដឹកនាំ ទាំង២ បាន លើកឡើង ទៀត ថា ក្រោម ម្លប់ សន្តិភាព ស្ថេរភាព នយោបាយ និង កំណើន សេដ្ឋកិច្ច ដ៏ ខ្ពស់ និង មាន ស្ថិរភាព ធ្វើឱ្យ ភាព ក្រីក្រ នៅ កម្ពុជា ត្រូវបាន កាត់បន្ថយ មក ត្រឹម ១០% នា ពេល បច្ចុប្បន្ន រីឯ អត្រា គ្មាន ការងារ ធ្វើ មាន ប្រមាណ ០.៣% ។ ហើយ កម្ពុជា បាន ផ្លាស់ប្តូរ មុខមាត់ ពី ប្រទេស ក្រីក្រ ទៅជា ប្រទេស មាន ចំណូល មធ្យម កំរិត ទាប និង បោះជំហាន ឆ្ពោះទៅ សម្រេច នូវ ចក្ខុវិស័យ របស់ ខ្លួន ទៅជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ជា ប្រទេស មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
តាមរយៈ នេះ យើង ទាំងអស់ គ្នា សូម អរគុណ សម្តេច តេជោ ដែល បាន ដឹកនាំ កម្ពុជា ឱ្យ មាន សន្តិភាព និង បាន ធ្វើឱ្យ ប្រទេសជាតិ រីកចម្រើន រុងរឿង ព្រមទាំង ប្តេជ្ញា រួមគ្នា ថែរក្សា សន្តិភាព ធានា បាន សមភាព យេនឌ័រ ប្រកបដោយ បរិយាប័ន្ន ។ ទន្ទឹម នឹង នោះ ថ្នាក់ដឹកនាំ ទាំង២ បាន សំណូមពរ ដល់ បងប្អូន នារី ចេះ ការពារ ខ្លួន ការធ្វើ អនាម័យ ជាប្រចាំ ដែល នេះ គឺជា ជម្រើស មួយ ដ៏ ល្អ បំផុត សម្រាប់ ការពារ ខ្លួន បាន ពី ជំងឺ គ្រប់ ប្រភេទ រួមទាំង ជំងឺ COVID-19 ។
នៅក្នុង ឱកាស នោះ បងប្អូន នារី ទាំង ថ្នាក់ កិត្តិយស និង អនុសាខា គ្រប់ ផ្នែក គ្រប់ ថ្នាក់ បាន ចូលរួម បង់ ថវិកា ប្រចាំ ឆ្នាំ សម្រាប់ ទ្រទ្រង់ សកម្មភាព ជួយ ទៅដល់ ជន ងាយ រងគ្រោះ ដោយ ប្រការ ផ្សេង ៗ បាន ទាន់ ពេលវេលា និង ចំ គោលដៅ ផងដែរ ៕ គម្រប លូ ខូចខាត មួយចំនួន នៅ ផ្លូវ ៥៩៨ ត្រូវបាន ដាក់ ថ្មី ឡើងវិញ ដោយ ក្រុម មន្ត្រី អភិបាល ខណ្ឌ ឫស្សីកែវ
( ភ្នំពេញ ) ៖ គម្រប លូ មួយចំនួន ដែល រង ការខូចខាត មួយ អន្លើ ស្ថិត នៅ តាម បណ្ដោយ ផ្លូវ លេខ ៥៩៨ ក្នុង ខណ្ឌ ឫស្សីកែវ គិត ត្រឹម ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២០ នេះ ឃើញ ថា ចាប់ផ្ដើម មាន គម្រប ត្រឹមត្រូវ ល្អ ប្រសើរ ឡើងវិញ ហើយ បន្ទាប់ពី លោក ជា ពិសី អភិបាល ខណ្ឌ និង ជា សមាជិក ក្រុម លេខា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដឹកនាំ ក្រុមការងារ ចុះ រៀបចំ ដាក់ ដើម្បី ការពារ កកស្ទះ ដោយសារ សំរាម ធ្លាក់ ចូល និង ការពារ រាល់ គ្រោះថ្នាក់ កើត ជា ឧបទ្ទវហេតុ ផ្សេង ៗ ក៏ ដូចជា ការរក្សា សោភ័ណ្ឌភាព ទីក្រុង ។
រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ ជូនដំណឹង ពី ការផ្អាក ផ្គត់ផ្គង់ ទឹក ស្អាត រយៈពេល ខ្លី នៅក្នុង តំបន់ មួយចំនួន ក្នុង ខណ្ឌ សែនសុខ នៅ យប់ ថ្ងៃទី ១១ ខែមីនា
( ភ្នំពេញ ) ៖ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការផ្អាក ផ្គត់ផ្គង់ ទឹក ស្អាត មួយ រយៈពេល ខ្លី នៅក្នុង សង្កាត់ ឃ្មួញ ខណ្ឌ សែនសុខ ក្នុង រាជធានី ភ្នំពេញ នៅ យប់ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២០ ដោយសារតែ អ្នកជំនាញ កាត់ ភ្ជាប់ បំពង់ ចែកចាយ ទឹក ថ្មី ។
សម្រាប់ ការផ្អាក ផ្គត់ផ្គង់ ទឹក នេះ មាន រយៈពេល ប្រមាណ ៤ ម៉ោង ចាប់ពី ម៉ោង ២០៖០០ នាទី ដល់ ម៉ោង ២៤៖០០ នាទី យប់ និង អាច ធ្វើឲ្យ គុណភាព ទឹក មាន ភាពល្អក់កករ ក្នុង រយៈពេល ខ្លី ក្រោយពេល កាត់ ភ្ជាប់ បំពង់ ទឹក ថ្មី រួច ៕ ក្រុមហ៊ុន ធំ២ សហការ គ្នា ពង្រីក សេវា សាងសង់ ក្នុង ស្រុក ឱ្យ បាន កាន់តែ ច្រើន ជាមួយ គុណភាព កំរិត ស្តង់ដារ អន្តរជាតិ
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន សែន សេរី គ្រុប និង ក្រុមហ៊ុន ចិន ខេអ៊ិច គ្រុប (KX Group) នៅ ព្រឹក ថ្ងៃទី ០៦ មីនា ឆ្នាំ ២០២០ នេះ បាន ចុះ អនុស្សរណៈ យោគយល់ គ្នា ដើម្បី ផ្តល់ ងាយស្រួល ដល់ ក្រុមហ៊ុន ទាំង ពីរ ក្នុង ការធ្វើ ទំនាក់ទំនង និង ស្វែងយល់ ឱ្យ កាន់តែ ច្បាស់ អំពី គុណភាព ការងារ កំរិត ស្តង់ដារ អន្តរជាតិ លើ គម្រោង សាងសង់ ជាច្រើន នៅក្នុង ប្រទេស កម្ពុជា ជាមួយនឹង ការពង្រីក សេវា សាងសង់ ក្នុង ស្រុក ឱ្យ បាន កាន់តែ ច្រើន ។
លោក កៅ ជុន (Gao Jun) ប្រធាន ក្រុមហ៊ុន ខេអ៊ិច គ្រុប បាន បញ្ជាក់ ថា ក្រុមហ៊ុន ខេអ៊ិច បាន បើក ឱ្យ ដំណើរ ក្នុង កំឡុង ឆ្នាំ ១៩៨០មក ម៉្លេះ ដោយ ទទួល ម៉ៅការ គម្រោង សាងសង់ ជាច្រើន ដូច ជា៖ អគារ ពាណិជ្ជកម្ម ចម្រុះ សណ្ឋាគារ រមណីយដ្ឋាន គម្រោង សាងសង់ ផ្សារ ទំនើប និង សំណង់ អគារ ស្នាក់ នៅ រួម ខ្ពស់ ៗ ជាច្រើន ផ្សេង ទៀត ផងដែរ ។
សូម បញ្ជាក់ ថា យោង តាម របាយការណ៍ របស់ ក្រសួង ដែនដី នគរ រូបនីយកម្ម និង សំណង់ បាន ឱ្យដឹង ថា គិត ត្រឹម ឆ្នាំ ២០១៩ កន្លងទៅ តម្លៃ ទំហំ ទុន វិនិយោគ វិស័យ សំណង់ ទូទាំង ប្រទេស មាន តម្លៃ សរុប ប្រមាណ ជាង ៩.៣ ពាន់ លាន ដុល្លារ អាមេរិក ដោយ បាន កើនឡើង ជាង ៧៨ % ប្រៀបធៀប នឹង រយៈពេល ដូចគ្នា ឆ្នាំ ២០១៨ ៕
បច្ចុប្បន្ន នេះ ចំនួន អ្នកស្លាប់ ដោយសារ ជំងឺ COVID-19 នៅ សហរដ្ឋ អាមេរិក គឺ ១៤ នាក់ ហើយ អ្នក ឆ្លង មាន យ៉ាង ជាង ២០០ នាក់ ។ ព្រឹទ្ធសភា អាមេរិក ទើបតែ បាន អនុម័ត កញ្ចប់ ថវិកា ទំហំ ៨.៣ ពាន់ លាន ដុល្លារ ដើម្បី ប្រយុទ្ធ ការរាតត្បាត នៃ ជំងឺ នេះ បន្ទាប់ពី សភា តំណាងរាស្រ្ត អាមេរិក ក៏ បាន គាំទ្រ វា យ៉ាង ពេញ ទំហឹង ។ ឥឡូវ កញ្ចប់ ថវិកា នោះ ត្រូវ បញ្ជូន ឲ្យ ទៅ លោក ត្រាំ ដើម្បី ចុះហត្ថលេខា ។
ទេសរដ្ឋមន្ដ្រី គន់ គីម ណែនាំ មន្ដ្រី ត្រូវ ត្រៀមខ្លួន ជាស្រេច ដើម្បី ឆ្លើយតប ទាន់ ពេល មាន គ្រោះមហន្ដរាយ
( កំពង់ឆ្នាំង ) ៖ ទេសរដ្ឋមន្ដ្រី គន់ គីម អនុប្រធាន ទី១ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្ដរាយ បាន ណែនាំឲ្យ ត្រៀមខ្លួន ជាមុន ដើម្បី ឆ្លើយតប ទាន់ ពេលវេលា ពេល មាន គ្រោះមហន្ដរាយ ។ លោក បញ្ជាក់ ថា ការត្រៀម រៀបចំ ជាស្រេច មុនពេល មាន គ្រោះមហន្តរាយ គឺជា កត្តា យុទ្ធសាស្ត្រ កំណត់ ជាមុន នូវ ជោគជ័យ ក្នុង ការឆ្លើយតប សង្គ្រោះ បន្ទាន់ និង ស្តារ ឡើងវិញ ។
ការលើកឡើង របស់ ទេសរដ្ឋមន្ដ្រី គន់ គីម ក្នុង ឱកាស អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ បូកសរុប ការងារ គ្រប់គ្រង គ្រោះមហន្តរាយ និង ការងារ សមាគម អតីត យុទ្ធជន កម្ពុជា ឆ្នាំ ២០១៩ និង ទិសដៅ ការងារ ឆ្នាំ ២០២០ នៅ ខេត្ត កំពង់ឆ្នាំង ។
តាម របាយការណ៍ របស់ លោក ឈួ ច័ន្ទ ឌឿន អភិបាល ខេត្ត កំពង់ឆ្នាំង បាន ឲ្យដឹង ថា ផល ប៉ះ ដោយ គ្រោះ មហន្តរាយ នៅ ទូទាំង ខេត្ត ក្នុង ឆ្នាំ កន្ល មក មាន ដូចជា គ្រោះ រាំងស្ងួត . ខ្យល់ កន្រ្តាក់ . រន្ទះ បាញ់ . ជំនន់ ទឹកភ្លៀង និង គ្រោះ អគ្គីភ័យ ជាដើម ។
ក្នុង ឱកាស នោះ ទេសរដ្ឋមន្រ្តី គន់ គីម បាន នាំ នូវ ការផ្តាំផ្ញើរ សាកសួរ សុខទុក្ខ និង ផ្ញើរ ក្តី នឹករលឹក ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ។ លោក បន្ថែម ថា ការគិតគូរ ពី សុខ ទុក្ខ និង ការលើកកម្ពស់ កម្រិត ជីវភាព របស់ អតីត យុទ្ធជន ទាំងអស់ ឲ្យ មាន ភាពល្អ ប្រសើរ គឺជា ការចង់បាន របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ជាពិសេស ការតម្លើង ប្រាក់ បៀវត្ស ជូន អតីត យុទ្ធជន ជារៀងរាល់ ឆ្នាំ ដូច មន្រ្តី រាជការ ដែរ ។
លោក បាន សំណូមពរ ទៅដល់ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន មេត្តា ជួយ សហការ គ្នា ជាមួយ សមាគម អតីត យុទ្ធជន ដើម្បី ចុះ សួរសុខទុក្ខ ជាមួយ បងប្អូន នៅ តាម សហគមន៍ នៅក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ។ ទេសរដ្ឋមន្រ្តី គន់ គីម បាន កោតស សើរ និង វាយតម្លៃ ខ្ពស់ ដល់ អាជ្ញាធរ ថ្នាក់ ក្រោម ជាតិ និង ថ្នាក់ មូលដ្ឋាន សហគមន៍ និង កងកម្លាំងប្រដាប់អាវុធ ដោយ កន្លងមក តែងតែ សហការ គ្នា បាន ល្អ និង ធ្វើ ការឆ្លើយតប ទាន់ ពេលវេលា ពេល មាន គ្រោះមហន្តរាយ កើតឡើង ។
លោក បាន ណែនាំ ទៀត ថា ក្រុមការងារ គ្រោះមហន្តរាយ ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ត្រូវ បន្ត តាមដាន ជាប្រចាំ នូវ ស្ថានភាព បាតុភូ ធម្មជាតិ ផ្សេង ៗ ដែល អាច បង្ក ជា គ្រោះមហន្តរាយ . បន្ត ការផ្សព្វផ្សាយ ព័ត៌មាន ឲ្យបាន ទាន់ ហេតុការ ណ៏ ទាក់ទង នឹង គ្រោះមហន្តរាយ ទៅដល់ ថ្នាក់ មូលដ្ឋាន ឲ្យ កាន់តែ ទូលំទូលាយ និង បង្កើន កិច្ចសហប្រតិបត្តិការ ជាមួយ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ក្រុង ស្រុក និង អង្គការ ដៃគូ អភិវឌ្ឍន៍ នានា ក្នុង ការត្រៀម បង្ការ ឆ្លើយតប និង ស្ដា ឡើងវិញ ពេល មាន គ្រោះមហន្តរាយ កើតឡើង ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ គៀត ច័ន្ទ ថា រិទ្ធិ អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន នគរបាល អន្តោប្រវេសន៍ បាន ណែនាំ ទៅ មន្រ្តី នគរបាល អន្តោប្រវេសន៍ ទាំងអស់ ត្រូវ បន្ត ប្រពៃណី ធ្វើ ការងារ ប្រកបដោយ ស្មារតី សាមគ្គីភាព ឯកភាព គ្នា មាន ការទទួលខុសត្រូវ មាន វិន័យ សេចក្ដីថ្លៃថ្នូរ ចេះ គោរព និង ឲ្យ តម្លៃ គ្នា ទៅ វិញ ទៅ មក ដើម្បី សម្រេច ឲ្យបាន នូវ គោលដៅ រួម របស់ អគ្គ នាយកដ្ឋាន នគរបាល អន្តោប្រវេសន៍ ក្នុង បម្រើ សេវា ធារណៈ ជូន ប្រជាពលរដ្ឋ និង ភ្ញៀវ អន្តរជាតិ ។
ថ្លែង នៅក្នុង ពិធី សំណេះសំណាល អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ខួប លើក ទី ១០៩ ជាមួយ មន្រ្តី នគរបាល នារី នៃ អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ នាយ ឧត្តមសេនីយ៍ គៀត ច័ន្ទ ថា រិទ្ធ បាន ក្រើន រំលឹក ដល់ មន្រ្តី នគរបាល បុរស ទាំងអស់ ត្រូវ លុបបំបាត់ ឲ្យបាន ជាដាច់ខាត នូវ ការរើសអើង សមភាព យេនឌ័រ នៅក្នុង សង្គម ។
នាយ ឧត្តមសេនីយ៍ អគ្គ នាយក បាន អះអាង ថា នារី គឺជា កម្លាំង ដ៏ មុតស្រួច និង ជា ធនធាន មនុស្ស ដ៏ មាន តម្លៃ ដែល មិន អាច ខ្វះ បាន ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ ខណៈ ដែល ប្រទេស កម្ពុជា បាន នឹង កំពុង យកចិត្តទុកដាក់ លើកស្ទួយ តួនាទី របស់ នារី ក្នុង ជួរ ដឹកនាំ តាម ស្ថាប័ន នីមួយ ៗ ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ គៀត ច័ន្ទ ថា រិទ្ធ ក៏ បាន ជំរុញ ឲ្យ មន្រ្តី នគរបាល អន្តោប្រវេសន៍ នារី ទាំងអស់ ត្រូវ បង្កើន សមត្ថភាព និង ចំណេះ របស់ ខ្លួន បន្ថែម ទៀត ដើម្បី បម្រើ សេវា សាធារណៈ ជូន ភ្ញៀវ ជាតិ និង អន្តរជាតិ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ បន្ថែម ទៀត ។
សូម បញ្ជាក់ ថា ទិវា អន្តរជាតិ នារី ៨មីនា នៅក្នុង ឆ្នាំ ២០២០ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច លើក យក ប្រធានបទ មួយ គឺ « មាន សន្តិភាព មាន ការលើកកម្ពស់ សមភាព យេនឌ័រ » សម្រាប់ ដាក់ ចេញ ជា សកម្មភាព គន្លឹះ ក្នុង ការអនុវត្ត គោ នយោបាយ ជាតិ គាំពារ សង្គម ដែល ជា ផ្នែក មួយ នៃ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ៕
ឆ្លើយតប នឹង របាយការណ៍ ខាង លើ នេះ ក្រុម អ្នកវិទ្យាសាស្ត្រ នៅ សាកលវិទ្យាល័យ ហាវើ ដ (Harvard) ដ៏ ល្បីល្បាញ របស់ សហរដ្ឋ អាមេរិក ក៏ បាន ព្រមាន ផងដែរ ថា សហរដ្ឋ អាមេរិក អាចនឹង រងគ្រោះ កាន់តែ ធ្ងន់ធ្ងរ ដោយសារតែ ការរាតត្បាត របស់ មេរោគ COVID-19 ព្រោះតែ ការត្រួតពិនិត្យ លើ អ្នកដំណើរ នានា ចូលមកកាន់ ប្រទេស មហា អំណាច មួយ នេះ នៅ មាន ការខ្វះចន្លោះ ច្រើន ។
អាជ្ញាធរ សុខាភិបាល ក្នុង តំបន់ បាន រាយការណ៍ ឲ្យដឹង ថា មាន ករណី ឆ្លង ថ្មី ៗ ចំនួន ២០ករណី បន្ថែម ទៀត ត្រូវ បាន បញ្ជាក់ នៅ រដ្ឋ វ៉ាស៊ី តោន ស្ទេត បាន ធ្វើឲ្យ ចំនួន សរុប នៃ អ្នក ឆ្លង COVID-19 នៅក្នុង រដ្ឋ មួយ នេះ មាន ចំនួន ៥១ ករណី ដោយ ក្នុង នោះ ស្លាប់ ១១នាក់ ។ ចំណែកឯ ករណី ស្លាប់់ មួយ ទៀត ត្រូវបាន កត់ត្រា នៅក្នុង រដ្ឋ កាលីហ្វ័រញ៉ា ។ ដូច្នេះ វា បាន ធ្វើឲ្យ តួលេខ សរុប នៃ អ្នកស្លាប់ ដោយសារ មេរោគ ដ៏ កាច សាហាវ នេះ ហក់ ឡើង ដល់ ១២នាក់ ហើយ ។
គួរ ជម្រាប ថា នៅ ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ ( ពេលវេលា នៅ អាមេរិក ) ក្រុម សមាជិកសភា នៃ គណបក្ស សាធារណរដ្ឋ និង ប្រជាធិបតេយ្យ បាន ឈានដល់ កិច្ចព្រមព្រៀង ក្នុង ការផ្តល់ មូលនិធិ ចំនួន ៨.៣ ពាន់ លាន ដុល្លារ អាមេរិក ដើម្បី ឆ្លើយតប ទៅនឹង ជំងឺ រាតត្បាត សកល មួយ នេះ ។ នៅ ទូទាំង ប្រទេស អាមេរិក មាន ការឆ្លង មេរោគ COVID-19 ជាង ១៨៣ ករណី បាន ឆ្លង វីរុស នេះ ក្នុង បណ្តា រដ្ឋ ចំនួន ១៦ ហើយ រដ្ឋ ដែល មាន សភាព ធ្ងន់ធ្ងរ ជាង គេ គឺ ដ្ឋ វ៉ាស៊ីនតោន ស្ទេត ស្ថិត នៅ ភាគ ខាងលិច នោះ តែម្តង ៕
កម្ពុជា - ឡាវ ឯកភាពយកចិត្តទុកដាក់ រួមគ្នា បន្ត អនុវត្ត កិច្ចការ សំខាន់ ៗ ៣ ចំណុច ពាក់ព័ន្ធ នឹង ការងារ សន្តិសុខ
( ភ្នំពេញ ) ៖ ក្រសួង មហាផ្ទៃ កម្ពុជា និង ក្រសួង សន្តិសុខ សាធារណៈ របស់ ឡាវ បាន ឯកភាព គ្នា យកចិត្តទុកដាក់ បន្ត អនុវត្ត កិច្ចការ សំខាន់ ៗ ៣ ចំណុច ពាក់ព័ន្ធ នឹង ការងារ សន្តិសុខ ។ នេះ បើ តាម សេចក្តីប្រកាស របស់ ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ ស្តីពី លទ្ធផល នៃ ការបំពេញ ទស្សនកិច្ចការងា របស់ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បា នៅ ប្រទេស ឡាវ រយៈពេល ៣ ថ្ងៃ ។
សេចក្តីប្រកាស បាន បញ្ជាក់ ថា នៅក្នុង ដំណើរទស្សនកិច្ចការងារ នោះ សម្តេច ក្រឡាហោម ស ខេង បាន ប្រជុំ ជាមួយ លោក វិល័យ ឡា ខាំ ហ្វង រដ្ឋមន្រ្តី ក្រសួង សន្តិសុខ សាធារណៈ របស់ ឡាវ ដោយ ភាគី ទាំង ពីរ បាន ចុះហត្ថលេខា លើ កំណត់ហេតុ ស្ដីពី កិច្ចសហប្រតិបត្តិការ សម្រាប់ ឆ្នាំ ២០២០ និង បាន ឯកភាព គ្នា យកចិត្តទុកដាក់ បន្ត អនុវត្ត កិច្ចការ សំខាន់ ៗ មួយចំនួន រួម មាន៖
* បន្ត ជំរុញ ឲ្យ អាជ្ញាធរ ជាប់ ព្រំដែន នៃ ប្រទេស ទាំង ពីរ ឱ្យ សហការបង្ក លក្ខណៈ ងាយស្រួល ដល់ ការចេញ - ចូល ឆ្លងកាត់ ព្រំដែន របស់ ប្រជាពលរដ្ឋ និង ការផ្លាស់ប្ដូរ ពាណិជ្ជកម្ម ទៅ វិញ ទៅ មក ដើម្បី បម្រើ ដល់ សេចក្តីត្រូវការ នៃ ការអភិវឌ្ឍ និង ការរីកចម្រើន នៃ ជីវភាព របស់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម តំបន់ ព្រំដែន ព្រមទាំង សហការ ដោះស្រាយ បញ្ហា ឬ បាតុភាព ផ្សេង ៗ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ទាន់ ពេលវេលា ដើម្បី បន្ត សន្តិវិធី និង មាន ការយោគយល់ គ្នា ខ្ពស់ ។
* បន្ត សហការចាត់ វិធានការ ម៉ឺងម៉ាត់ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស គ្រឿងញៀន ឆ្លងកាត់ ព្រំដែន នៃ ប្រទេស ទាំង ពីរ ព្រមទាំង សហការផ្លាស់ប្ដូរ ព័ត៌មាន និង បទពិសោធន៍ ទៅ វិញ ទៅមក ពាក់ព័ន្ធ នឹង បទល្មើស គ្រឿងញៀន ជាពិសេស ជំរុញ បង្កើត ភូមិ ឃុំ និង សាលារៀន គ្មាន គ្រឿងញៀន នៅ តាម តំបន់ ព្រំដែន ។
* បន្ត ជំរុញ ចាត់ វិធានការ តឹងរ៉ឹង ដើម្បី ទប់ស្កាត់ និង បង្ក្រាប ការលួច ឆ្លង ដែន ខុស ច្បាប់ ព្រមទាំង បន្ត កិច្ចសហប្រតិបត្តិការ គ្រប់គ្រង តាម ខ្សែ បន្ទាត់ ព្រំដែន និង សហការ ដោះស្រាយ បញ្ហា ផ្សេង ៗ ដោយ សន្តិវិធី ឈរ លើ គោលការណ៍ គោរព ឯករាជ្យ និង អធិបតេយ្យ គ្នា ទៅ វិញ ទៅមក ។
ក្នុង ឱកាស ជំនួប របស់ ភាគី ទាំង ពីរ សម្ដេច ក្រឡាហោម ស ខេង បាន អញ្ជើញ រដ្ឋមន្ត្រី ក្រសួង សន្តិសុខ សាធារណៈ ឡាវ ដឹកនាំ គណៈប្រតិភូ មក បំពេញ ទស្សនកិច្ច នៅ ប្រទេស កម្ពុជា តាម ពេលវេលា សមស្រប ដើម្បី ចូលរួម កិច្ចប្រជុំ វាយតម្លៃ លទ្ធផល នៃ ការអនុវត្ត កំណត់ហេតុ នៃ កិច្ចសហប្រតិបត្តិការ ឆ្នាំ ២០២០ និង ចុះហត្ថលេខា លើ កំណត់ហេតុ នៃ កិច្ចសហប្រតិបត្តិការ ឆ្នាំ ២០២១ របស់ ក្រសួង ទាំង ពីរ ផងដែរ ៕
នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន ដឹកនាំ ប្រតិភូ សួរសុខទុក្ខ និង ត្រួតពិនិត្យ ការងារ កងកម្លាំង វិស្វកម្ម នៅ មូលដ្ឋាន ផ្អាវ
( កំពង់ចាម ) ៖ នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ នៅ ព្រឹក ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២០ បាន ដឹកនាំ ប្រតិភូ ចុះ សួរសុខទុក្ខ និង ត្រួតពិនិត្យ ការងារ កង កម្លាំង វិស្វកម្ម ដែល មាន មូលដ្ឋាន នៅ ឃុំ ផ្អាវ ស្រុក បាធាយ ខេត្ត កំពង់ចាម ។
មាន មតិ សំណេះសំណាល នា ឱកាស នោះ នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន បាន ពាំនាំ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជា ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត និង សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ ជូន ចំពោះ ថ្នាក់ដឹកនាំ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ កងកម្លាំង វិស្វកម្ម ដែល បាន ខិតខំ អស់ ពី កម្លាំង កាយ ចិត្ត និង ស្មារតី ទទួលខុសត្រូវ ចំពោះ ការបំពេញ បេសកកម្ម ជា ប្រវត្តិសាស្ត្រ បំរើ ជាតិ នា ពេល កន្លងមក នេះ ។
នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន បាន រម្លឹក ពី ការលះបង់ អាយុជីវិត របស់ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ចេញ ទៅ តស៊ូ រំដោះ ជាតិ ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ព្រមទាំង បាន គូសបញ្ជាក់ អំពី ចក្ខុវិស័យ របស់ រាជ រដ្ឋាភិបាល ដែល បាន ដឹកនាំ នាវា កម្ពុជា ឆ្ពោះ ទៅរក ត្រើយ សន្តិភាព និង វឌ្ឍនភាព ។
សម្តេច តេជោ ហ៊ុន សែន៖ ឆ្នាំ ២០២០ កម្ពុជា ទទួលបាន វឌ្ឍនភាព ក្នុង ការកាត់បន្ថយ គម្លាត យេនឌ័រ គួរ ជា ទី មោទនៈ (Video inside) ( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន លើកឡើង ថា កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្នុង ការលើកកម្ពស់ សមភាព យេនឌ័រ និង បង្កើន ភាព អង់ឤច ដល់ ស្ត្រី ត្រូវបាន វាយតម្លៃ ខ្ពស់ តាមរយៈ ការចាត់ ចំណាត់ថ្នាក់ របស់ វេទិកា សេដ្ឋកិច្ច ពិភពលោក ក្នុង ឆ្នាំ ២០២០ ដែល កម្ពុជា ទទួលបាន វឌ្ឍនភាព ក្នុង ការកាត់បន្ថយ គម្លាត យេនឌ័រ គួរ ជា ទីមោទៈ ។
ការលើកឡើង បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្ដេច តេជោ ហ៊ុន សែន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ខួប លើក ទី១០៩ ដែល រៀបចំ ធ្វើឡើង នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្នុង ការលើកកម្ពស់ សមភាព យេនឌ័រ និង បង្កើន ភាព អង់ឤច ដល់ ស្ត្រី ត្រូវបាន វាយតម្លៃ ខ្ពស់ តាមរយៈ ការចាត់ ចំណាត់ថ្នាក់ របស់ វេទិកា សេដ្ឋកិច្ច ពិភពលោក ក្នុង ឆ្នាំ ២០២០ ដែល កម្ពុជា ទទួលបាន វឌ្ឍនភាព ក្នុង ការកាត់បន្ថយ គម្លាត យេនឌ័រ គួរ ជា ទីមោទៈ ដោយ ថយចុះ ពី ចំណាត់ថ្នាក់ លេខ ១១២ នៅ ឆ្នាំ ២០១៦ មក ចំណាត់ថ្នាក់ លេខ ៨៩ នៅ ឆ្នាំ ២០២០ ក្នុង ចំណោម ប្រទេស ចំនួន ១៥៣ » ។
សម្ដេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា កម្ពុជា ត្រូវបាន ទទួលស្គាល់ ថា ជា ប្រទេស ដែល មាន ស្ត្រី ចូលរួម យ៉ាង សកម្ម ក្នុង វិស័យ សេដ្ឋកិច្ច និង ការលើកកម្ពស់ សុខភាព ស្ត្រី ហើយ អត្រា ស្ត្រី ចូលរួម ក្នុង កម្លាំង ពលកម្ម ខ្ពស់ ជាង គេ រហូតដល់ ៧៩ % ម្ចាស់ ឤ ជីវកម្ម ៦៥ % ជា ស្ត្រី ទោះបី ឤ ជីវកម្ម ភាគ ច្រើន ក្នុង ចំណោម ឤ ជីវកម្ម ទាំងនោះ ជា សហគ្រាស ខ្នាត មីក្រូ និង ខ្នាត តូច ក៏ដោយ ។
បន្ថែម ពី នោះ ទៀត សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន គូសបញ្ជាក់ ថា ក្នុង វិស័យ អប់រំ កម្ពុជា មាន សមភាព យេនឌ័រ ក្នុង កម្រិត បឋមសិក្សា និង មធ្យមសិក្សា បឋម ភូមិ ហើយ គម្លាត យេនឌ័រ នៅ កម្រិត មធ្យមសិក្សា ទុតិយភូមិ និង ឧត្តម សិក្សា ក៏ ត្រូវបាន កាត់បន្ថយ ជា បណ្តើរ ៗ ។ នៅ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ចំនួន សិស្ស ស្រី នៅ កម្រិត មធ្យមសិក្សា ទុតិយភូមិ មាន ការកើនឡើង ទាំង បរិមាណ និង គុណភាព ។ លទ្ធផល នៃ សិស្ស ស្រី ដែល ទទួល បាន និទ្ទេស A ក្នុង ការប្រឡង មធ្យមសិក្សា ទុតិយភូមិ មាន ចំនួន ក្នុង រង្វង់ ៥០% ។
សម្ដេច តេជោ បាន ថ្លែង ទៀត ថា ស្ត្រី និង ក្មេងស្រី មាន លទ្ធភាព កាន់តែ ច្រើន ក្នុង ការទទួលបាន ការសិក្សា អប់រំ ទាំង ក្នុង និង ក្រៅ ប្រព័ន្ធ ក្នុង នោះ ពួកគេ ក៏ ត្រូវបាន លើកទឹកចិត្ដ និង គាំទ្រ ដេម្បី ចាប់ យក ចំណេះដឹង ជំនាញ និង បច្ចេកវិទ្យា ថ្មី ៗ ជាពិសេស ការអប់រំ ផែ្នក វិទ្យាសាស្ដ្រ បច្ចេកទេស វិស្វកម្ម សិល្បៈ ច្នៃប្រឌិត និង គណិតវិទ្យា ស្រប តាម ភាពវិវត្តន៍ រីកចម្រើន នៃ បច្ចេកវិទ្យា និង ទីផ្សារ ការងារ ផងដែរ ។
ដើម្បី ឆ្លើយតប ចំពោះ អំពើហិង្សា គ្រប់ រូបភាព ទៅ លើ ស្ត្រី និង ក្មេង ស្ត្រី រាជ រដ្ឋាភិបាល បាន បង្កើត យន្តការ ច្បាប់ គោល នយោបាយ ផែនការ សកម្មភាព ជាតិ ការផ្តល់ សេវា ជា ពហុ វិស័យ និង វិធានការ ជាច្រើន ទៀត ដោយ មាន ការចូលរួម ពី ស្ថាប័ន ពាក់ព័ន្ធ ជាច្រើន រួមទាំង អង្គការ សង្គម ស៊ីវិល ដើម្បី ជួយ ជនរងគ្រោះ ដោយ អំពើហិង្សា ទាក់ទង នឹង យេនឌ័រ ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ សម្ដេច តេជោ ហ៊ុន សែន ។
ទន្ទឹម នេះ រាជ រដ្ឋាភិបាល បាន បង្កើន ថវិកា ជូន ដល់ ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី ស្ត្រី ចំនួន ៥០០ លាន រៀល ក្នុង មួយ ឆ្នាំ សម្រាប់ ជួយ ដល់ ស្ដ្រី និង ក្មេងស្រី រងគ្រោះ ក្នុង ការ ស្វែងរក សេវា យុត្តិធម៌ តាមរយៈ ការបង្កើត ក្រុម មេធាវី សម្តេច តេជោ សែន ប្រចាំ នៅ គ្រប់ រាជធានី - ខេត្ត ទាំង២៥ សម្រាប់ ជួយ ស្វែងរក សេវា យុត្តិធម៌ ជូន ដល់ ជន ក្រីក្រ ស្ត្រី និង ក្មេងស្រី ដែល រងគ្រោះ ដោយ អំពើហិង្សា បាន ទាន់ ពេលវេលា និង ប្រកបដោយ ប្រសិទ្ធភាព ៕
ការបន្ត អំពាវនាវ បែប នេះ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២០ នេះ នៅក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ខួប លើក ទី ១០៩ នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ ។
សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ យ៉ាង ដូច្នេះ ថា៖ « ខ្ញុំ នៅតែ បន្ត អំញ វនាវ ដល់ បងប្អូន ជន រួម ជាតិ នៅ ទូទាំង ប្រទេស ទាក់ទង នឹង បញ្ហា វីរុស កូវីដ ១៩ ទោះបី ប្រទេស កម្ពុជា យើង ពុំ ទាន់ កើត មាន ឡើង នូវ បញ្ហា នានា ដែល ទាក់ទង នឹង វីរុស នេះ ក៏ដោយ ក៏ប៉ុន្តែ សូម បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ ចេះ ការញ រ ខ្លួន ដើម្បី ទទួលបាន សុខភាពល្អ ប្រសើរ ជាជាង ការភ័យខ្លាច » ។
ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ឱ្យដឹង ថា ជម្រើស នៃ ការភ័យខ្លាច មិន មែន ជា ជម្រើស ល្អ នោះ ទេ តែ ជម្រើស ក្លាហាន ក្នុង ការចេះ ការញ រ ខ្លួន ការធ្វើ អនាមយ័ជាប្រចាំ គឺជា ម្រើស ដែល ល្អ បំផុត ហើយ ការពារ ខ្លួន បាន ពី ជំងឺ គ្រប់ ប្រភេទ ។ ដូច្នេះ សូម រួមគ្នា កុំ ទុក អ្នកណា ម្នាក់ ឱ្យ នៅឯ កោ ដោយ ពុំ បាន ទទួល ភោគផល ពី កិច្ចអភិវឌ្ឍ ។
គួរ ជម្រាប ថា នៅក្នុង ពិធី បិទ សន្និបាត បូកសរុប ការងារ ឆ្នាំ ចាស់ ឆ្នាំ ២០១៩ និង លើក ទិសដៅ ការងារ ឆ្នាំ ថ្មី ឆ្នាំ ២០២០ របស់ ក្រសួង សុខាភិបាល នា ថ្ងៃទី ០៤ ខែមីនា ឆ្នាំ ២០២០ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស អំពី ការងារ អាទិភាព បំផុត របស់ កម្ពុជា ពេលនេះ គឺ ការប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល នៃ ជំងឺ កូរ៉ូណា ថ្មី ដោយ ក្នុង នោះ រាប់បញ្ចូល ទាំង ការត្រៀមខ្លួន ទប់ទល់ បើសិនជា ជំងឺ នេះ ឆ្លង មកដល់ ប្រទេស កម្ពុជា ជាថ្មី ម្តង ទៀត ផងដែរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា « ខ្ញុំ សូម ប្រកាស នៅ ទីនេះ ថា កិច្ចការ របស់ យើង នៅពេល កន្លងទៅ ចាប់ផ្តើម ពី ផ្ទុះ កូរ៉ូណា ថ្មី នេះ រហូតដល់ ពេលនេះ និង រហូតដល់ ពេល បញ្ចប់ នៃ ជំងឺ កូវីត១៩ នេះ ការងារ អាទិភាព ខ្ពស់ បំផុត របស់ កម្ពុជា គឺ ប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល នៃ ជំងឺ កូវីត នេះ ជា ការណ៍ ដែល យើង ត្រូវ ធ្វើ ទាំងអស់ គ្នា » ។
ដើម្បី ជំរុញ ការប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល នៃ ជំងឺ កូវីត នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច កាត់បន្ថយ ការចំណាយ ប្រមាណ ៥០ ភាគរយ របស់ ក្រសួង ស្ថាប័ន នានា លើកលែងតែ ក្រសួង ការបរទេស ក្រសួង ពាណិជ្ជកម្ម និង ទីស្តីការ គណៈ រដ្ឋមន្រ្តី ដែល ត្រូវ កាត់បន្ថយ ត្រឹម ២៥ ភាគរយ ប៉ុណ្ណោះ ។ ប៉ុន្តែ ទោះជា យ៉ាង នេះ ក្តី សម្តេច បាន ប្រកាស ថា ប្រាក់ បៀវត្ស មន្រ្តី រាជការ ទាំងអស់ មិន ត្រូវបាន កាត់ ឡើយ ដោយ ការកាត់ នេះ មាន ដូចជា ចំណាយ សម្រាប់ ការចេញ ទៅ ក្រៅ ប្រទេស និង គម្រោង មួយចំនួន ទៀត ។
សម្តេច ថ្លែង ថា ក្រសួង សុខាភិបាល គឺជា អ្នកនាំមុខ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូរ៉ូណា ថ្មី នេះ ចំណែក នាយក រដ្ឋមន្រ្តី គ្រាន់តែ ជា ការសម្រេច លើ នយោបាយ ប៉ុណ្ណោះ ។ លទ្ធភាព ទី១ នេះ គឺ រាជ រដ្ឋាភិបាល នឹង ខិតខំ អប់រំ ប្រជាពលរដ្ឋ ឱ្យ មាន អនាម័យ ហើយ មិន ត្រូវ ភ័យខ្លាច ឬ មាន ការរើសអើង ឡើយ ។ ចំណែក លទ្ធភាព ទី២ គឺ បើសិនជា ប្រជាពលរដ្ឋ ឆ្លង កូវីត ទោះជា នៅ ខេត្ត ណាមួយ ក៏ ត្រូវ ត្រៀម បម្រុង ដើម្បី ជួយ ដល់ ពួកគេ ផងដែរ ។
ប្រទេស កម្ពុជា បាន រកឃើញ ជំងឺ នេះ ១ករណី គត់ គឺ នៅលើ ខ្លួន ជនជាតិ ចិន ម្នាក់ ដែល មកពី ក្រុង វូហាន ប្រទេស ចិន ចូលមក ប្រទេស កម្ពុជា កាលពី ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០២០ ប៉ុន្តែ ជនជាតិ ចិន រូប នោះ ត្រូវបាន ព្យាបាល ឱ្យ ជាសះស្បើយ ហើយ ចាកចេញ ពី កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ ផងដែរ ៕ ក្រសួង មហាផ្ទៃ បង្ហាញ លទ្ធផល នៃ ដំណើរទស្សនកិច្ច របស់ សម្ដេច ក្រឡាហោម ស ខេង រយៈពេល ៣ ថ្ងៃ នៅ ប្រទេស ឡាវ
( ភ្នំពេញ ) ៖ ក្រសួង មហាផ្ទៃ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន មួយ បង្ហាញ អំពី លទ្ធផល នៃ ដំណើរទស្សនកិច្ច របស់ គណៈប្រតិភូ ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ ដឹកនាំ ដោយ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៤ ដល់ ទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នៅ រដ្ឋធានី វៀង ច័ន្ទ នៃ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ ។
សម្តេច ក្រឡាហោម ស ខេង បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ ចាកចេញ ពី កម្ពុជា កាលពី ថ្ងៃទី ០៤ ខែមីនា ដើម្បី ទៅ បំពេញ ទស្សនកិច្ចការងារ នៅ រដ្ឋធានី វៀង ច័ន្ទ ។ ទស្សនកិច្ច នេះ ធ្វើឡើង តប តាម ការអញ្ជើញ របស់ រដ្ឋមន្រ្តី ក្រសួង សន្តិសុខ សាធារណៈ របស់ ឡាវ ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង មហា ផ្ទៃ៖
ប្រកាស ទទួលស្គាល់ លោក សុក រ៉ាដូ ជា ប្រធាន សភា ពាណិជ្ជកម្ម ខេត្ត ស្វាយរៀង អាណត្តិ ទី១ លើក ទី២
( ស្វាយរៀង ) ៖ នៅ ព្រឹក ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២០ នេះ លោក វ៉េង សុធី រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម និង លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន អញ្ជើញ ប្រកាស ទទួលស្គាល់ លោក សុក រ៉ាដូ ជា ប្រធាន សភា ពាណិជ្ជកម្ម ខេត្ត ស្វាយរៀង សម្រាប់ អាណត្តិ ទី១ លើក ទី២ ដែល មាន សមាជិក ចំនួន ១៤រូប ។
ក្នុង ឱកាស នោះ លោក ម៉ែន វិបុល បាន លើកឡើង ពី វឌ្ឍនភាព នានា នៃ ការរីកចម្រើន លើ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម នៅក្នុង ខេត្ត ដោយ ផ្អែក តាម កម្មវិធី នយោបាយ និង យុទ្ធសាស្ត្រ ចតុកោណ ដែល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា គឺ បាន អនុវត្ដ គោល នយោបាយ ឈ្នះ - ឈ្នះ បន្ដ ទៅ មុខ គ្រប់ វិស័យ ក្នុង នោះ វិស័យ ពាណិជ្ជកម្ម គឺជា វិស័យ អាទិភាព ដែល រាជ រដ្ឋាភិបាល បាន ផ្ដោត ការយកចិត្ដទុកដាក់ ជា សំខាន់ ផងដែរ ។
ទន្ទឹម នេះ សភា ពាណិជ្ជកម្ម ខេត្ត ស្វាយរៀង បង្កើតឡើង តាំងពី ឆ្នាំ ២០០៤ មក ម្ល៉េះ ស្រប តាម អនុក្រឹត របស់ រាជ រដ្ឋាភិបាល ប៉ុន្តែ តាមរយៈ របាយការណ៍ លោក ប្រធាន មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ទើបតែ រៀបចំ នូវ រចនាសម្ព័ន្ធ គ្រប់គ្រង ត្រឹមត្រូវ ច្បាស់លាស់ នៅ ឆ្នាំ ២០១៦ រហូតមក ដល់ ឆ្នាំ ២០១៩ ដំណើរការបាន រយៈពេល ៣ ឆ្នាំ ដែល ជា ការកំណត់ អាណតិ្ត ជ្រើសរើស សមាជិក ថ្មី ចំនួន ពាក់កណ្តាល នៃ លើក ទី២នេះ ។
លោក បាន បន្ត ថា ក្នុង នាម អាជ្ញាធរ ខេត្ត សូម ធ្វើ ការកោតស សើរ ចំពោះ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ដែល បាន ខិតខំ សហការ រៀបចំ បង្កើត សភា ពាណិជ្ជកម្ម ខេត្ត ស្វាយរៀង និង ក៏ សូម ថ្លែង នូវ ការអគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ក្រសួង ពាណិជ្ជកម្ម ដែល បាន ជួយ សម្របសម្រួល និង គាំទ្រ ចាប់ពី ដំណើរការ បោះឆ្នោត ជ្រើសរើស និង រៀបចំ រចនាសម្ព័ន្ធ ដឹកនាំ របស់ សភា ពាណិជ្ជកម្ម នៅលើក ទី១ និង នៅលើក ទី២នេះ ៕
អាជ្ញាធរ ចុះ កាត់ គ្រោង ឆ្អឹង ដែក រំលោភ ផ្លូវ សាធារណៈ នៅ ខណ្ឌ ចំការមន
( ភ្នំពេញ ) ៖ បន្ទាប់ពី រដ្ឋបាល ខណ្ឌ ចំការមន ចេញ សេចក្តីជូនដំណឹង ជាច្រើន លើក ឲ្យ ម្ចាស់ ផ្ទះសំណាក់ រុះរើ គ្រោង ដែក ដែល សង់ លើ ចិញ្ចើមផ្លូវ ទាំងស្រុង នោះ ប៉ុន្តែ នៅតែ មិន ព្រម រុះរើ ពេលនេះ គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ចាប់ផ្តើម អនុវត្ត ដោយ ម៉ឺងម៉ាត់ បំផុត មិន បន្ធូ ដៃ ឡើយ ព្រោះ វា ជា ប្រយោជន៍ រួម ក្នុង គោលដៅ រៀបចំ សណ្តាប់ធ្នាប់ សាធារណៈ ឲ្យ មាន របៀបរៀបរយ តាម ដងផ្លូវ សម្រាប់ ថ្មើរជើង និង លើក កំពស់ សោភ័ណ្ឌភាព ក្នុង មូលដ្ឋាន ខណ្ឌ ចំការមន ។
នៅ ព្រឹក ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២០ គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដឹកនាំ ដោយ លោក អាំង សិរី ពិសិដ្ឋ អភិបាល រង តំណាង លោក អភិបាល ខណ្ឌ បាន ចាត់ វិធានការ រដ្ឋបាល ចុះ កាត់ គ្រោង ឆ្អឹង ដែក រំលោភ យក ផ្លូវ សាធារណៈ ផ្លូវ លេខ ១០៣ នេះ ត្រូវ រុះរើ ចេញ និង កាត់ តម្រឹម ដោយ គ្មាន ការយោគយល់ តទៅទៀត ។
ចំណាត់ការ រដ្ឋបាល តឹងរ៉ឹង នេះ ធ្វើឡើង បន្ទាប់ រដ្ឋបាល ខណ្ឌ ចេញ សេចក្តីជូនដំណឹង ជាច្រើន លើក ដោយ ទុករយៈ ៧ ថ្ងៃ ឲ្យ ម្ចាស់ ទីតាំង រុះរើ ដោយ ខ្លួន ឯង តែ មិន ព្រម រុះរើ ។ មកដល់ ពេលនេះ មាន រយៈពេល លើស ឱសាន្ត វាទ ៧ ថ្ងៃ ហើយ ដោយឡែក ម្ចាស់ ទីតាំង ដែល សាងសង់ រំលោភ យក ដី ចំណី ផ្លូវ មិន អនុវត្ត តាម សេចក្តីជូនដំណឹង ឡើយ ទើប ធ្វើឲ្យ គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ចាត់ វិធានការ រដ្ឋបាល ចុះ កាត់ចោល តែម្តង ដើម្បី អនុវត្ត តាម ខ្លឹមសារ នៃ សេចក្តីជូនដំណឹង អោយ មាន ប្រសិទ្ធភាព ។
លោក អាំង សិរី ពិសិដ្ឋ បាន បញ្ជាក់ ថា កាល នៅ ព្រឹក ថ្ងៃទី ៦ ខែមីនា នេះ ថា គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ បាន ចាត់ វិធានការ រដ្ឋបាល ចុះ កាត់ រោង ដែក ដែល សង់ រំលោភ មក លើ ដី ចំណី ផ្លូវ វិធានការ រដ្ឋបាល នេះ ធ្វើឡើង បន្ទាប់ពី ម្ចាស់ ទីតាំង មិន អនុវត្ត តាម សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ខណ្ឌ បាន ជូន ដំណឹង ចំនួន ២លើក ថែមទាំង មាន កំណត់ហេតុ ផ្តិត មេដៃ ទទួលស្គាល់ ពី ម្ចាស់ ទីតាំង ទៀតផង ទើប គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ចាត់ វិធានការ រដ្ឋបាល តែម្តង ។
លោក អាំង សិរី ពិសិដ្ឋ បាន ប្រាប់ ដូច្នេះ ថា វិធានការ រដ្ឋបាល នេះ ធ្វើឡើង បន្ទាប់ពី រដ្ឋបាល ខណ្ឌ បាន ជូន ដំណឹង ៣លើក មក ហើយ ម្ចាស់ ទីតាំង មិន ព្រម អនុវត្ត ទើប គណៈ បញ្ជាការ ឯកភាព ចុះ វា កាត់ រុះរើ រោង ដែក នេះ តែម្តង ដោយ មិន យោគយល់ ឡើយ ។
សូម បញ្ជាក់ ថា កន្លងមក លោក ថេង សុថុល អភិបាល ខណ្ឌ ចំការមន បាន បញ្ជាក់ យ៉ាង ម៉ឺងម៉ាត់ ថា គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ មិន ដកថយ ទេ ទោះជា ជួប នូវ បញ្ហា ប្រឈម ក៏ ត្រូវ ចាត់ វិធានការ រដ្ឋបាល ដែរ មិន មាន ការយោគយល់ ទេ ព្រោះ រដ្ឋបាល ខណ្ឌ បាន ជូន ដំណឹង រួចហើយ ដែរ ។
ជាមួយគ្នា នេះ ដែរ លោក អភិបាល រង ខណ្ឌ បាន ណែនាំឲ្យ លោក ចៅសង្កាត់ និង មន្ត្រី ជំនាញ ត្រូវ យកចិត្តទុកដាក់ លើ ការងារ សណ្តាប់ធ្នាប់ បន្ថែម ទៀត ៕
បើ តាម តួលេខ សម្រាប់ តែ រយៈពេល ពេញ មួយ ថ្ងៃព្រស ហ្បតិ៍ ម្សិលមិញ អាជ្ញាធរ សុខាភិបាល ចិន បាន ឲ្យដឹង ដែរ ថា ករណី ឆ្លង ថ្មី ៗ នៅ ទូទាំង ចិន ដី គោក មាន ចំនួន ១៤៣ នាក់ ខណៈ ៣០ នាក់ បាន ត្រូវ រាយការណ៍ ថា ស្លាប់ នៅក្នុង ថ្ងៃ ដដែល នោះ ដែរ ។ នៅ ថ្ងៃ ជាមួយគ្នា អ្នកជំងឺ ដែល ត្រូវបាន គេ អនុញ្ញាត ឲ្យ ចាកចេញ ពី មន្ទីរពេទ្យ បន្ទាប់ពី ពួកគេ បាន ជាសះស្បើយ ជា ស្ថាពរ ពី ជំងឺ នេះ មាន ចំនួន រហូតដល់ ១. ៦៨១ នាក់ ផងដែរ ។
សមាសភាព ការិល័យ ប្រតិបត្តិ សភា ពាណិជ្ជកម្ម កម្ពុជា អាណត្តិ ទី៤ មាន ចំនួន ៤០ រូប ក្នុង នោះ មាន អ្នក ឧកញ៉ា គិត ម៉េង ជា ប្រធាន សភា ពាណិជ្ជកម្ម និង អនុប្រធាន ៣៧រូប ព្រមទាំង ហិរញ្ញឹក១ រូប និង លេខាធិការ ១រូប ។
សមាជិក ជ្រើសតាំង សភា ពាណិជ្ជកម្ម រាជធានី ភ្នំពេញ អាណត្តិ ទី៤ លើក ទី១ មាន ចំនួន ៤០ រូប ផងដែរ ដែល បែងចែក តាម ប្រភេទ អាជីវកម្ម ហើយ អ្នក ឧកញ៉ា គិត ម៉េង គឺជា ប្រធាន សភា ពាណិជ្ជកម្ម រាជធានី ភ្នំពេញ អាណត្តិ ទី៤ លើក ទី១ នេះ ៕
ព័ត៌មាន លម្អិត សូម អាន អនុក្រឹត្យ របស់ សម្តេច តេជោ ហ៊ុន សែន ទាំង ស្រុង៖
( ឧត្តរមានជ័យ )៖ ប្រជាពលរដ្ឋ ចំនួន ១៨ គ្រួសារ រស់ នៅ ភូមិ លំទង ចាស់ ឃុំ លំទង ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ ដែល មាន បញ្ហា ទំនាស់ ដីធ្លី ជាមួយ លោក នួន ធា ជា មន្ត្រី យោធា បំរើការ នៅ អង្គភាព យោធ ភូមិភាគ ទី៤ រហូតមកដល់ ថ្ងៃ នេះ រយៈពេល ជាង ១ឆ្នាំ ហើយ មិន ទាន់ មាន ដំណោះ សមស្រប ណាមួយ ពីសំណាក់ អាជ្ញាធរ ស្រុក អាជ្ញាធរ ខេត្ត ចំពោះ ពួកគាត់ នៅឡើយ ទេ បើ ទោះបីជា ពាក្យ បណ្តឹង របស់ ពួកគាត់ បាន ដាក់ចូល ជា យូរ មកហើយ ក្តី ។
នៅក្នុង ពាក្ស បណ្តឹង បាន បញ្ជាក់ ថា ក្រោយ សមាហរណកម្ម ឆ្នាំ ១៩៩៨ ពួកគាត់ បាន កាប់ ឆ្កា ដី សម្រាប់ បង្កបង្កើន ផល ។ លុះ ឆ្នាំ ២០១២ ក្រុម និស្សិត ស្ម័គ្រចិត្ត របស់ សម្តេច តេជោ បាន ធ្វើ ការវាស់វែង កំណត់ ក្បាល ដី ជូន ពួកគាត់ លុះ ដល់ ឆ្នាំ ២០១៤ ទើប ទទួលបាន វិញ្ញាបនបត្រ សម្គាល់ អចលន វត្ថុ ដើម្បី បាន កាន់កាប់ ប្រើប្រាស់ ដោយ ស្រប ច្បាប់ ។
លុះ ចុង ឆ្នាំ ២០១៤ លោក នួន ធា បាន ចេញមក ធ្វើ ការហាមឃាត់ មិន ឲ្យ ធ្វើ ស្រែ ចំការ ដោយ អះអាង ថា ជា ដី របស់ គាត់ ហើយ នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២០ លោក បាន ឲ្យ សមត្ថកិច្ច មក ចាប់ ត្រាក់ទរ័ របស់ ពួកគាត់ ទៀតផង ដែល ករណី នេះ ពួកគាត់ សំណូមពរ ឲ្យ ថ្នាក់ដឹកនាំ ខេត្ត ជួយ ដោះស្រាយ ជូន ពួកគាត់ ផង ។
( កណ្ដាល ) ៖ ស្នងការ រង នគរបាល ខេត្ត កណ្ដាល លោក ស្រេង សុខា នា ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន ចេញមក ច្រានចោល ការចោទប្រកាន់ ទាំងឡាយ ដែល ថា លោក បាន យក ឈ្មោះ ថ្នាក់ ដឹកនាំ ខេត្ត ទៅ គំរាម ឬ កៀប សង្កត់ មន្រ្តី មូលដ្ឋាន ដើម្បី ទិញ ដី នៅ ក្រុង តាខ្មៅ ។
ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ប្រចាំ ខេត្ត កណ្តាល លោក ឧត្តមសេនីយ៍ ត្រី ស្រេង សុខា ថា លោក មិន បាន យក ឈ្មោះ អភិបាល ខេត្ត កណ្ដាល ទៅ គំរាម ចៅសង្កាត់ រកា ខ្ពស់ នោះ ទេ ព្រោះ ដី ដែល លោក ទិញ ទាំងនោះ គឺ ទិញ ពី ប្រជាពលរដ្ឋ តាំង អំឡុង ពី ឆ្នាំ ២០០៦ - ២០០៧ ហើយ ដី បាន ចុះបញ្ជី មាន ប្លង់ កម្មសិទ្ធិ ត្រឹមត្រូវបាន ជាង ពាក់កណ្ដាល ហើយ ដី ដែល នៅសល់ លោក គ្រាន់តែ ស្នើសុំ ចុះបញ្ជី បំពេញ បន្ថែម ទៅ មន្ទីរ ដែនដី ខេត្ត កណ្ដាល តែ ប៉ុណ្ណោះ ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ខួប លើក ទី ១០៩ នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ ។
ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ត្រូវបាន ពិភពលោក ប្រារព្វ ធ្វើឡើង ជារៀងរាល់ ឆ្នាំ ដើម្បី រំលឹក នូវ ការតស៊ូ និង គំរូវីរភាព របស់ នារី ៗ ក្នុង ការទាមទារ សិទ្ធិ សេរី និង គេច ផុត ពី ទង្វើ ជិះ ជាន់ នានា ។ សម្រាប់ នៅ កម្ពុជា មិន ថា តែ សិទ្ធិ នារី ឬ បុរស នោះ ឡើយ គឺ ត្រូវបាន បាត់បង់ អស់ ក្នុង របប កម្ពុជា ប្រជាធិបតេយ្យ របស់ បន ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
ខាងក្រោម ជា ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ក្នុង ឱកាស អញ្ជើញ ចូលរួម អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨មី នា៖
* សម្តេច តេជោ ហ៊ុន សែន មាន សេចក្តីរីករាយ ដោយ បាន ចូលរួម មីទ្ទីង អបអរសាទរ ខួប ទី១០៩ ទិវា អន្តរជាតិ ៨ មីនា ឆ្នាំ ២០២០ ក្រោម ប្រធាន « មាន សន្តិភាព មាន ការលើកកម្ពស់ សមភាព យេនឌ័រ » ដែល រាជ រដ្ឋាភិបាល និង សម្រេច ជ្រើសរើស ក្នុង គោលបំណង បង្ហាញ អំពី តម្លៃ សុខ សន្តិភាព ដែល រកបាន ដោយ លំបាក ជាមួយនឹង បាវចនា « អរគុណ សន្តិភាព » ។
* សម្តេច តេជោ ហ៊ុន សែន សូម កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ក្រសួង កិច្ចការ នារី ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី ស្រ្តី ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ វិស័យ ឯកជន សង្គម ស៊ីវិល និង ដៃគូ អភិវឌ្ឍ ជាតិ អន្តរជាតិ ដែល បាន រួមចំណែក គាំទ្រ ការលើកកម្ពស់ ស្ថានភាព ជីវភាព សិទ្ធិ ឋានៈ តួនាទី សុខុមាលភាព ស្រ្តី និង កុមារ ជាពិសេស ការផ្តល់ សេវា បាន ទាន់ ពេលវេលា ជួយ ជនរងគ្រោះ ដោយ អំពី ហឹង្សា ប្រកបដោយ ប្រសិទ្ធិភាព សមធម៌ និង បរិយា បន្ទ ។
* សម្តេច តេជោ មានប្រសាសន៍ ថា ប្រធានបទ « មាន សន្តិភាព មាន ការលើកកម្ពស់ យេនឌ័រ » ពិតជា មាន អត្ថន័យ និង សារៈសំខាន់ ស្រប តាម គោលការណ៍ រាជ រដ្ឋាភិបាល ដែល បាន និង កំពុង ផ្តោត ការយកចិត្តទុកដាក់ ខ្ពស់ ទៅ លើ ការលើកកម្ពស់ និង ការបង្កើន ភាព អង់អាច ដល់ ស្រ្តី និង ក្មេង ៥០ % នៃ ចំនួន ប្រជាជន សរុប ដើម្បីឱ្យ ពួកគេ ក្លាយ សក្តានុពល ក្នុង ការរួមចំណែក និង សេដ្ឋកិច្ច ។
* សម្តេច តេជោ បាន លើកឡើង ថា ទិវា អន្តរជាតិ ៨មីនា នៅ ថ្ងៃ នេះ គឺជា ការបង្ហាញ អំពី គុណសម្បត្តិ គ្រប់ លក្ខណៈ របស់ ស្រ្តី ដែល ជា មាតា ពិភពលោក ជាមួយនឹង បាវចនា « ជួយ ស្រ្តី គឺ ជួយ ខ្លួន ឯង និង « សិទ្ធិ ស្រ្តី គឺជា សិទ្ធិ មនុស្ស » ។
* កម្ពុជា ត្រូវបាន ទទួលស្គាល់ ថា ជា ប្រទេស មាន ស្ត្រី ចូលរួម យ៉ាង សកម្ម ក្នុង វិស័យ សុខភាព ហើយ អត្រា ស្រ្តី ចូលរួម រហូតដល់ ៧៩ % ម្ចាស់ អាជីវកម្ម ៦៥ % ជា ទោះបី អាជីវកម្ម ភាគ ច្រើន ក្នុង ចំណោម ខ្នាត មីក្រូ និង ខ្នាត តូច ។
* នៅក្នុង វិស័យ អប់រំ នៅ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ចំនួន សិស្ស ស្រី នៅ កម្រិត មធ្យមសិក្សា ទុតិយភូមិ មាន ការលើកឡើង ទាំង បរិមាណ និង គុណភាព ។ លទ្ធផល នៃ សិស្ស បាន និទ្ទេស A ក្នុង ការប្រឡង មធ្យមសិក្សា ទុតិ យាភូមិ មាន ចំនួន ក្នុង រង្វង់ ៥០% ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល បង្កើន ថវិកា ជូន ដល់ ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ចំនួន ៥០០ លាន រៀល ក្នុង មួយ ឆ្នាំ សម្រាប់ ជួយ ដល់ ស្ត្រី និង ក្មេងស្រី រងគ្រោះ ក្នុង ការស្វែងរក សេវា យុត្តិធម៌ តាមរយៈ ការបង្កើត ក្រុម មេធាវី សម្តេច តេជោ សែន ប្រចាំ នៅ គ្រប់ រាជធានី ខេត្ត ទាំង ២៥ សម្រាប់ ជួយ ស្វែងរក សេវា យុត្តិធម៌ ជូន ដល់ ជន ក្រីក្រ ស្រ្តី និង ក្មេងស្រី ដែល រងគ្រោះ ដោយ អំពើហឹង្សា បាន ទាន់ ពេលវេលា និង ប្រកបដោយ ប្រសិទ្ធិភាព ។
១៖ គ្រប់ ថ្នាក់ដឹកនាំ ក្រសួង - ស្ថាប័ន ត្រូវ បន្ត បង្កើន ឲ្យ មាន ចំនួន ស្ត្រី ក្នុង តួនាទី ជា ថ្នាក់ដឹកនាំ នៅ គ្រប់ កម្រិត ។
២៖ ត្រូវ រួមគ្នា ទប់ស្កាត់ និង អន្តរាគមន៍ ឱ្យ បាន ទាន់ វេលា នូវ គ្រប់ ទិដ្ឋភាព នៃ អំពើហិង្សា ដែល ទាក់ទង នឹង បញ្ហា យេនឌ័រ ជាពិសេស ការប្រើប្រាស់ ប្រព័ន្ធ អិន ធើណិត ពាក់ព័ន្ធ នឹង ការជួញដូរ ផ្លូវភេទ ។ ត្រូវ ពង្រីក ការបង្កើត ក្រុមការងារ ពហុ វិស័យ ឆ្លើយតប នឹង អំពើហិង្សា ទាក់ទង នឹង យេនឌ័រ ឱ្យ បាន នៅ គ្រប់ រាជធានី - ខេត្ត ទាំងអស់ និង ត្រូវ សហការ គ្នា ប្រើប្រាស់ ទិន្នន័យ លើ កិច្ចអន្តរាគមន៍ និង ក្មេង ក្នុង គោលបំណង បង្កើន ប្រសិទ្ធភាព នៃ កិច្ចអន្តរាគមន៍ របស់ ស្ថាប័ន និមួយ ៗ ។
៣៖ ក្រសួង អប់រំ និង កីឡា ត្រូវ ណែនាំ ដល់ គ្រប់ គ្រឹះស្ថាន សិក្សា ទាំងអស់ ឲ្យ ពង្រឹង ការអនុវត្ត វិន័យ និង មាន ទំនាក់ទំនង ជាមួយ ឪពុក ម្តាយ និង អ្នកអាណាព្យាបាល សិស្ស ឲ្យបាន ជាប្រចាំ ។ ឪពុក ម្តាយ និង អ្នកអាណាព្យាបាល គ្រប់ រូប គូរ យកចិត្តទុកដាក់ អប់រំ កូន ចៅ ប្រុស ស្រី ខិតខំ រៀនសូត្រ មាន សីលធម៌ ប្រកាន់ វប្បធម៌ អហិង្សា ក្នុង គ្រួសារ និង ក្នុង សង្គម ។
៤៖ ត្រូវ បន្ត វិនិយោគ លើ ការសិក្សា របស់ ក្មេងស្រី នៅ គ្រប់ កម្រិត ជាពិសេស ក្នុង មុខជំនាញ វិទ្យាសាស្រ្ត បច្ចេកវិទ្យា វិស្វកម្ម សិល្បៈ ច្នៃប្រឌិត និង គណិតវិទ្យា (STEAM) ដើម្បី ដើរ ឱ្យ ទាន់ ចរន្ត នៃ ការរីកចម្រើន ផ្នែក វិទ្យាសាស្រ្ត បច្ចេកវិទ្យា និង ន វានុវត្តន៍ នេះ ។
៥៖ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ក្រសួង ព័ត៌មាន និង បណ្តាញ ផ្សព្វផ្សាយ ទាំងអស់ ទាំង រដ្ឋ និង ឯកជន ត្រូវ បន្ត ពង្រឹង និង លើកកម្ពស់ សីលធម៌ សង្គម តម្លៃ ស្រ្តី និង គ្រួសារ ខ្មែរ ព្រមទាំង បង្កើន កម្មវិធី អប់រំ ល្អ ៗ ដែល ឆ្លុះបញ្ចាំង ពី តម្លៃ ស្រ្តី ប្រពៃណី និង វប្បធម៌ ខ្មែរ ឱ្យ បាន កាន់តែ ទូលំទូលាយ ថែម ទៀត និង ត្រូវ ពិចារណា អំពី ផល ប៉ះពាល់ និង សេចក្តីថ្លៃថ្នូរ និង ក្មេងស្រី ។
៦៖ ត្រូវ រួមគ្នា បង្ការ ទប់ស្កាត់ ការចម្លង មេរោគ អេដស៍ ថ្មី និង សុំ កុំ ឲ្យ មាន ការរើសអើង ជាពិសេស ចំពោះ ស្រ្តី ផ្សព្វផ្សាយ ស្រាបៀរ រួមទាំង អ្នកស្រឡាញ់ ភេទ ដូចគ្នា ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង អគ្គ មេបញ្ជាការ រង និង ជា មេបញ្ជាការ បញ្ជាការដ្ឋាន អង្គរក្ស នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ ដឹកនាំ កិច្ចប្រជុំ ផែនការ ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព សម្រាប់ កិច្ចប្រជុំ កំពូល អាស៉ី - អឺរ៉ុប លើក ទី ១៣ ក្នុង ឆ្នាំ ២០២០ ដែល កម្ពុជា ត្រូវ ធ្វើជា ម្ចាស់ ផ្ទះ ។
កិច្ចប្រជុំ ផែនការ ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព នេះ ត្រូវបាន ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង មហាផ្ទៃ ដែល មាន ការចូលរួម ពី ប្រធាន អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ ។
កិច្ចប្រជុំ អាស៊ី - អឺរ៉ុប (ASEM) គឺជា កិច្ចពិភាក្សា នៃ ដំណើរការ ផ្លូវការ មួយ និង កិច្ចសហប្រតិបត្តិការ រវាង សមាជិក សហភាព អឺរ៉ុប ទាំង៣០ ប្រទេស និង អាស៊ី ចំនួន ២១ ប្រទេស ព្រមទាំង លេខាធិការ អាស៊ាន ផងដែរ ។
នៅក្នុង ពាក្យ តវ៉ា របស់ កូរ៉េ ខាងត្បូង បាន លើកឡើង ថា សេចក្តីសម្រេច របស់ ជប៉ុន ក្នុង ការដាក់ អ្នកដំណើរ កូរ៉េ ខាងត្បូង ឲ្យ ស្ថិត នៅក្នុង ការតាមដាន រយៈពេល ១៤ ថ្ងៃ នោះ « គឺជា ទង្វើ ដែល គ្មាន ហេតុផល មិន អាច ទទួលយក បាន និង គួរឲ្យ សោកស្តាយ ជា ទីបំផុត » ។ បច្ចុប្បន្ន ទីក្រុង ដេគូ និង ខេត្ត គ្យុង សាង ខាងជើង របស់ ប្រទេស កូរ៉េ ខាងត្បូង ជា កន្លែង ផ្ទុះ ការឆ្លង មេរោគ COVID-19 ធ្ងន់ធ្ងរ បំផុត ។
គួរ បញ្ជាក់ ថា នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក អាបេ ស៊ីន ហ្សូ កាលពី ថ្ងៃព្រហស្បតិ៍ ម្សិលមិញ នេះ បាន សម្រេច ថា អ្នកដំណើរ នានា មកពី កូរ៉េ ខាងត្បូង នឹង ត្រូវ ដាក់ ឲ្យ ស្ថិត នៅក្នុង ការត្រួតពិនិត្យ សុខភាព រយៈពេល ០២ សប្តាហ៍ ឬ ១៤ ថ្ងៃ ខណៈ ប្រជាជន ពី តំបន់ កំពុង រង ការវាយប្រហារ ខ្លាំងក្លា ដោយសារ មេរោគ COVID-19 នឹង មិន ត្រូវបាន អនុញ្ញាតឲ្យ ចូលមក ក្នុង ប្រទេស ជប៉ុន ឡើយ គិត ចាប់ពី ថ្ងៃសៅរ៍ ទី ០៧ ខែមីនា ឆ្នាំ ២០២០ រហូតដល់ មាន ការសម្រេចចិត្ត ជាថ្មី ៕
បើ តាម តួលេខ ដែល បញ្ចេញ កាលពី ថ្ងៃព្រហស្បតិ៍ នោះ នៅក្នុង ថ្ងៃពុធ សប្តាហ៍ នេះ មាន អ្នក ឆ្លង មេរោគ COVID-19 ថ្មី ៗ ចំនួន តែ ១៣៩ នាក់ ប៉ុណ្ណោះ នៅ ទូទាំង ប្រទស ចិន ហើយ នៅ ប៉ុន្មាន ថ្ងៃ មុន គឺ នៅ ថ្ងៃចន្ទ និង អង្គារ ដើម សប្តាហ៍ នេះ អត្រា ឆ្លង ថ្មី ៗ បាន បង្ហាញ សញ្ញា ធ្លាក់ចុះ ខ្លាំង រួចទៅហើយ ។ ការធ្លាក់ចុះ នេះ គឺ បង្ហាញ អំពី ប្រសិទ្ធភាព នៃ ការទប់ស្កាត់ ការរីករាលដាល នៅក្នុង ទីក្រុង វូហាន ផ្ទាល់ ដែល ជា ចំណុច ស្នូល នៃ ការចម្លង ជំងឺ នេះ ទៅកាន់ បណ្តា ខេត្ត ទីក្រុង និង តំបន់ នានា ទូទាំង ចិន ដី គោក ។
គួរ បញ្ជាក់ ថា ទីក្រុង វូហាន ត្រូវបាន បិទ ទ្វារ ក្រោយ ការផ្ទុះ COVID-19 កាលពី ចុង ខែធ្នូ ឆ្នាំ ២០១៩ ហើយ ការធ្វើដំណើរ នានា ត្រូវបាន រឹតត្បិត ខណៈ មន្ទីរពេទ្យ ធំ ៗ ត្រូវបាន កសាងឡើង និង ពេទ្យ យោធា រាប់ ពាន់ នាក់ ត្រូវបាន ដាក់ពង្រាយ ទៅ ខេត្ត ហ៊ូប៉ី ទាំងមូល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជា បន្តបន្ទាប់ ។ ប្រទេស ចិន ក៏ បាន សហការ ដោយ បើក ចំហ ផងដែរ ជាមួយ ក្រុម ជំនាញ វេជ្ជសាស្ត្រ អន្តរជាតិ ដូចជា អង្គការ សុខភាព ពិភពលោក WHO ជាដើម ៕
ធ្វើ បែប នេះ ដើម្បី គេច ចេញ ពី ការរអ៊ូរទាំ របស់ ប្រជាពលរដ្ឋ រឿង ក្រុមហ៊ុន ទូរស័ព្ទ កាត់ លុយ របស់ ពួកគាត់ ដោយ មិន ដឹងខ្លួន ឬ កាត់ លុយ ដោយ ស្វ័យប្រវត្តិ ដោយសារតែ ការភ្ជាប់ សេវា ផ្សេង ៗ ។
ថ្លែង ក្នុង សន្និសីទ សារព័ត៌មាន ស្តីពី ការធ្វើ និយ័តកម្ម វិស័យ ទូរគមនាគមន៍ នៅ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២០ លោក ជា ច័ន្ទ តារ៉ា សមាជិក និយ័តករ ទូរគមនាគមន៍ កម្ពុជា បាន ឲ្យដឹង ថា លេខ 1200 នេះ គឺ ស្ថិត ក្នុង ដំណាក់កាល ដែល និយ័តករ ស្នើសុំ ឲ្យ ប្រតិបត្តិករ ពិចារណា ដើម្បីឲ្យ អតិថិជន ប្រើ លេខ 1200 ផ្ដាច់ មក ជា គម្រោង ធម្មតា វិញ ។
លោក ជា ច័ន្ទ តារ៉ា បាន បញ្ជាក់ ថា « រាល់ សេវាកម្ម គឺ នឹង ផ្ដាច់ ដែល យើង អាច នឹង ទិញ ឡើងវិញ ។ តែ លេខ កូដ ទាំងអស់ នេះ គឺ ស្ថិត ក្នុង លក្ខខណ្ឌ ក្នុង ការពិភាក្សា បច្ចេកទេស ជាមួយ ប្រតិបត្តិករ បន្ត ទៀត ។ អីចឹង ចំពោះ សំណួរ សួរ ថា នឹង ចាប់ផ្ដើម នៅ ពេលណា និយ័តករ ទូរគមនាគមន៍ នឹង ជូន ដំណឹង បន្ទាប់ ទៀត » ។
និយ័តករ ទូរគមនាគមន៍ កម្ពុជា បាន បញ្ជាក់ ទៀត ថា ការ ប្រើ លេខ កូដ ខ្លី នេះ ដំណោះស្រាយ ដ៏ ល្អ ដើម្បី បញ្ចប់ នូវ បញ្ហា កាត់ លុយ ឬ ការភ្ជាប់ សេវា ផ្សេង ៗ មិន ដឹងខ្លួន កន្លងមក ដែល អ្នកប្រើប្រាស់ ធ្លាប់ បាន ជួបប្រទះ ៕ គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ត្រឡប់មក ផ្ទះ វិញ ដោយ សុវត្ថិភាព ! ស្លាប់ ៥នាក់ និង របួស ១៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៥ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ . របួស ស្រាល ៥នាក់ និង របួស ធ្ងន់ ១០នាក់ ក្នុង នោះ មិន ពាក់ មួក ១៣នាក់ ។
មុន កើត ហេតុ គេ បាន ឃើញ នារី វ័យ ក្មេង ដែល បើក រថយន្ត សេរី ទំនើប ខាងលើ តាម បណ្តោយ ផ្លូវ ព្រះនរោត្តម លុះ មកដល់ មុខ ចំនុច ក្រសួង សារធារណការ ក៏ បាន បុក រះ រថយន្ត ជាច្រើន គ្រឿង រង ការខូចខាត តែ មិន មាន អ្នក រងរបួស នោះ ទេ ។
បន្ទាប់ពី កើត ហេតុ ភាគី ខាង រថយន្ត ម៉ាក Mercedess ព្យាយាម ដោះស្រាយ នៅ កន្លែង កើត ហេតុ ប៉ុន្តែ ដោះស្រាយ មិន បាន ត្រូវបាន កម្លាំង នគរបាល ចរាចរណ៍ ចុះ មក វាស់វែង ដើម្បី បញ្ជូន រថយន្ត ពាក់ព័ន្ធ ទៅកាន់ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ៕
( ភ្នំពេញ ) ៖ ខាងក្រោម គឺជា សំណុំ រូបភាព មួយចំនួន ដែល បង្ហាញ ពី ព្រឹត្តិការណ៍ នយោបាយ អន្តរជាតិ និង ស្ថានការណ៍ ជុំវិញ ពិភពលោក រួម ជាមួយ រឿង ហេតុ គួរឲ្យ ចាប់អារម្មណ៍ ព្រមទាំង ទិដ្ឋភាព នៅ តំបន់ ផ្សេង ៗ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃព្រហស្បតិ៍ ទី០៥ ខែមីនា ឆ្នាំ ២០២០ នេះ៖
សម្ដេច តេជោ ហ៊ុន សែន ដាក់ ចេញ វិធានការ៧ ចំណុច ឆ្លើយតប បញ្ហា ប្រឈម ដែល ស្ថាប័ន ដៃគូ អភិវឌ្ឍ សង្គម ស៉ី វិល វិស័យ ឯកជន រួមគ្នា យកចិត្ដទុកដាក់ (Video inside) ( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ដាក់ចេញ វិធានការ ចំនួន ៧ ចំណុច ដើម្បី ឆ្លើយតប បញ្ហា ប្រឈម នា ពេល បច្ចុប្បន្ន ដែល ស្នើឲ្យ ស្ថាប័ន ដៃគូ អភិវឌ្ឍន៍ សង្គម ស៉ី វិល វិស័យ ឯកជន ព្រមទាំង ប្រជាពលរដ្ឋ គ្រប់ រូប ត្រូវ រួមគ្នា ផ្ដោត ការយកចិត្តទុកដាក់ ទាំងអស់ គ្នា ។
វិធានការ ទាំង ៧ ចំណុច ដែល សម្ដេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ខួប លើក ទី ១០៩ នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ នា ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ រួម មាន៖
* ទី១៖ គ្រប់ ថ្នាក់ដឹកនាំ នាំ ក្រសួង ស្ថាប័ន ត្រូវ បន្ដ បង្កើន ឲ្យ មាន ចំនួន ស្ដ្រី ក្នុង តួនាទី ជា ថ្នាក់ដឹកនាំ នៅ គ្រប់ កម្រិត
* ទី៣៖ ក្រសួង អប់រំ យុវជន និង កីឡា ត្រូវ ណែនាំ ដល់ គ្រប់ គ្រឹះស្ថាន សិក្សា ទាំងអស់ ឲ្យ ពង្រឹង ការអនុវត្ត វិន័យ និង មាន ទំនាក់ទំនង ជាមួយ ឪពុក ម្តាយ និង អ្នកឤណា ព្យាបាល សិស្ស ឲ្យបាន ជាប្រចាំ ។ ឪពុក ម្តាយ អ្នកឤណា ព្យាបាល គ្រប់ រូប គួរ យកចិត្តទុកដាក់ អប់រំ កូន ចៅ ប្រុស ស្រី ខិតខំ រៀនសូត្រ មាន សីលធម៌ ប្រកាន់ វប្បធម៌ អហិង្សា ក្នុង គ្រួសារ និង ក្នុង សង្គម ។
* ទី ៤៖ ត្រូវ បន្ត វិនិយោគ លើ ការសិក្សា របស់ ក្មេងស្រី នៅ គ្រប់ កម្រិត សិក្សា ជាពិសេស ក្នុង មុខជំនាញ វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា វិស្វកម្ម សិល្បៈ ច្នៃប្រឌិត និង គណិតវិទ្យា ដើម្បី ដើរ ឲ្យ ទាន់ ចរន្ត នៃ ការរីកចម្រើន ផ្នែក វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ នេះ ។
* ទី៥៖ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ក្រសួង ព័ត៌មាន និង បណ្តាញ ផ្សព្វផ្សាយ ទាំងអស់ ទាំង រដ្ឋ និង ឯកជន ត្រូវ បន្ត ពង្រឹង និង លើកកម្ពស់ សីលធម៌ សង្គម តម្លៃ ស្ត្រី និង គ្រួសារ ខ្មែរ ព្រមទាំង បង្កើន កម្មវិធី អប់រំ ល្អ ៗ ដែល ឆ្លុះបញ្ចាំង ពី តម្លៃ ស្ត្រី ប្រពៃណី និង វប្បធម៌ ខ្មែរ ឲ្យបាន កាន់តែ ទូលំទូលាយ ថែម ទៀត និង ត្រូវ ពិចារណា អំពី ផល ប៉ះពាល់ និង សេចក្តីថ្លៃថ្នូរ របស់ មនុស្ស ពិសេស តម្លៃ ស្ត្រី និង ក្មេងស្រី ។
* ទី ៦៖ ត្រូវ រួមគ្នា បង្ការ ទប់ស្កាត់ ការចម្លង មេរោគ អេដស៍ ថ្មី និង សុំ កុំ ឲ្យ មាន ការរើសអើង ជាពិសេស ចំពោះ ស្ត្រី ផ្សព្វផ្សាយ ស្រាបៀរ រួមទាំង អ្នកស្រឡាញ់ ភេទ ដូចគ្នា ។
( ភ្នំពេញ ) ៖ លោក ធឹម សំអាន អភិបាល ខណ្ឌ បឹងកេងកង បាន ថ្លែង អរគុណ មន្ត្រី រដ្ឋបាល ខណ្ឌ សង្កាត់ បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ និង ស្ត្រី ជា កងកម្លាំង ដែល បាន រួមគ្នា ថែរក្សា ការពារ សន្តិភាព ដើម្បី អភិវឌ្ឍន៍ ជាតិ ធានា បាន សមភាព យេនឌ័រ ប្រកបដោយ បរិយាប័ន្ន ។ ទោះបី គាត់ មក បម្រើ ប្រជាពលរដ្ឋ នៅ ខណ្ឌ បឹងកេងកង មាន ពេល ខ្លី ក៏ដោយ ក៏ មន្ត្រី ទាំង ខិតខំ ធ្វើ ការងារ យ៉ាង រលូន ។
ការថ្លែង អំអរគុណ បែប នេះ របស់ លោក ធឹម សំអាន បាន ធ្វើឡើង នៅក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ នារី នៃ រដ្ឋបាល ខណ្ឌ និង សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ក្នុង ពិធី អបអរសាទរ ខួប លើក ទី ១០៩ ទិវា អន្តរជាតិ នារី ៨ មីនា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « មាន សន្តិភាព មាន ការលើកកម្ពស់ សមភាព យេនឌ័រ » នៅ សាលា ខណ្ឌ បឹងកេងកង នា ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ ដែល មាន ការចូលរួម ពី ស្ត្រី ជា សមាជិក ចំនួន ១៤០ នាក់ ផងដែរ ។
លោក អភិបាល បន្ត ថា បាន បន្ត ថា « សុខ សន្តិភាព និង ស្ថេរភាព នយោបាយ គឺជា មូលដ្ឋានគ្រឹះ ដ៏ ចាំបាច់ សម្រាប់ រដ្ឋាភិបាល ប្រទេស មួយ មាន លទ្ធភាព ផ្តោត ការយកចិត្តទុកដាក់ លើ កិច្ចអភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្គម និង សុខ មាលភាព របស់ ប្រជាជន ។ បើ បាត់បង់ សន្តិភាព នោះ អ្វី ៗ គ្រប់ យ៉ាង រួមទាំង សមភាព យែនឌ័រ នឹង ត្រូវបាត់បង់ ។ ដូច្នេះ សន្តិភាព គឺជា ធាតុ ផ្សំ ដ៏ សំខាន់ សម្រាប់ ធានា ចីរភាព នៃ កិច្ចអភិវឌ្ឍន៍ » ។
លោក បាន បន្ត ទៀត ថា ជាក់ស្តែង បន្ទាប់ពី ទទួលបាន សុខ សន្តិភាព ពេញលេញ នៅ ទូទាំង ប្រទេស អាស្រ័យ ដោយ នយោបាយ ឈ្នះ ឈ្នះ ដែល ផ្តូច ផ្តើម ដោយ សម្តេច តេជោ ហ៊ុន សែន ប្រទេស កម្ពុជា មាន ការរីកចំរើន ជាលំដាប់ ដោយ បោះជំហាន យ៉ាង ជឿជាក់ លើ មាគ៌ា នៃ ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ឆ្ពោះ ទៅរក អនាគត មួយ ដ៏ ភ្លឺស្វាង ។
នៅក្នុង ឱកាស នោះ លោកស្រី ស៊ុយ សែន សករាជ ប្រធាន អនុសាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ បាន អាន ព្រះរាជ សារ សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនី នា ថ សីហនុ ព្រះវរាជ មាតា ជាតិ ខ្មែរ ក្នុង សេរីភាព សេចក្តីថ្លៃថ្នូរ និង សុភមង្គល ក្រោម ប្រធានបទ « មាន សន្តិភាព មាន ការលើកកម្ពស់ សមភាព យេនឌ័រ » ជូន ដល់ អង្គ ពិធី ។
ក្នុង ឱកាស នោះ លោក ធឹម សំអាន បាន ជូន ផ្កា និង ១វត្ថុអនុស្សាវរីយ៍ ជូន ដល់ បងប្អូន ជា នារី ដែល បាន ចូលរួម ខួប លើក ទី ១០៩ ទិវា អន្តរជាតិ នារី ០៨ មីនា ឆ្នាំ ២០២០ នេះ ក្នុង ក្តី សប្បាយរីករាយ ៕ អគ្គ នាយក មន្ទីរពេទ្យ កាល់ម៉ែត ស្នើ មន្រ្តី រាជការ បុគ្គលិក ប្រកាន់ខ្ជាប់ ក្រមសីលធម៌ វិជ្ជាជីវៈ ជា គ្រូពេទ្យ និង ជា អ្នកថែទាំ ជំងឺ បាន ល្អ ប្រសើរ
( ភ្នំពេញ ) ៖ សាស្រ្តាចារ្យ ឈាង រ៉ា អគ្គ នាយក មន្ទីរពេទ្យ កាល់ម៉ែត បាន ស្នើ មន្រ្តី រាជការ បុគ្គលិក និង កម្ម ការិនី ជា នារី ប្រកាន់ខ្ជាប់ នូវ ក្រមសីលធម៌ វិជ្ជាជីវៈ ជា គ្រូពេទ្យ និង ជា អ្នកថែទាំ ជំងឺ បាន ល្អ ប្រសើរ សកម្មភាព ដ៏ ប្រពៃ របស់ បងប្អូន នារី ធ្វើឱ្យ មន្ទីរពេទ្យ មាន ការរីកចម្រើន ជាលំដាប់ ឥត ឈប់ឈរ ។
ការថ្លែង របស់ សាស្រ្តាចារ្យ ឈាង រ៉ា បែប នេះ ក្នុង ឱកាស អបអរសាទរ ប្រារព្ធ ខួប លើក ទី ១០៩ នៃ ទិវា អន្តរជាតិ នារី ៨មីនា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « មាន សន្ដិភាព មាន ការលើកកម្ពស់ សមភាព យេនឌ័រ » ដែល គណៈកម្មការ នារី រួម សហការ ជាមួយ សហជីព មន្ទីរពេទ្យ បាន ប្រារព្ធ ធ្វើ ពិធី នេះ ឡើង នៅ មន្ទីរពេទ្យ កាល់ម៉ែត ស្រប ពេល ដែល ក្នុង ពិភពលោក ក៏ បាន ប្រារព្ធ ធ្វើ ដូចគ្នា នា ព្រឹក ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២០ នេះ ។
លោក ឈាង រ៉ា សូម កោតសរសើរ ដោយ ស្មោះ ចំពោះ មន្ត្រីរាជការ បុគ្គលិក កម្មករ - កម្ម ការិនី ក្នុង ការបន្ត រួម សាមគ្គី ជា ធ្លុង មួយ ដោយ ប្រកាន់ យក ក្រម សីលធម៌ វិជ្ជាជីវៈ ខ្ពស់ សហការ គ្នា អនុវត្ត ការងារ ឱ្យ កាន់តែ ប្រសើរ ថែម ទៀត ក្នុង ឆន្ទៈ បន្ត ខិតខំ ពង្រឹង បង្កើន សមត្ថភាព ចំណេះដឹង ជំនាញ ឯកទេស ជានិច្ច ដើម្បី ឈានឡើង ទៅ រក ភាពរីកចម្រើន នា ពេល អនាគត ឱ្យ កាន់តែ មាន តម្លៃ ឧត្តុង្គឧត្តម ជាលំដាប់ ។
បើ តាម លោកស្រី អ៊ឹម សិទ្ធិ ការ្យ បាន ឲ្យដឹង ថា ៨មីនា គឺជា ព្រឹត្តិការណ៍ សកលលោក ដែល មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ បាន ប្រកាស ជា ថ្ងៃ ស្តីពី សិទ្ធិ ស្រ្តី និង សន្តិភាព ពិភពលោក នា ឆ្នាំ ១៩៧៧ ។ ជារៀងរាល់ ឆ្នាំ ប្រទេស កម្ពុជា បាន រៀបចំ កម្មវិធី ទិវា នារី អន្តរជាតិ ៨មីនា ដើម្បី រំលឹក ពី ការតស៊ូ ទាមទារ សិទ្ធិ សេរីភាព និង ឆ្លុះបញ្ចាំង អំពី វឌ្ឍនៈ ភាព សមិទ្ធិផល បញ្ហា ប្រឈម ការប្តេជ្ញាចិត្ត និង វិធានការ ជា វិជ្ជមាន ធានា ក្នុង ការលើកកម្ពស់ សមភាព យេនឌ័រ និង បង្កើន ភាពអង់អាច ដល់ ស្រ្តី និង ក្មេងស្រី ៕
( វ៉ាស៊ីនតោន ) ៖ ទីភ្នាក់ងារ អវកាស អាមេរិក NASA ទីបំផុត បាន ប្រកាស ពី ឈ្មោះ ផ្លូវការ ដែល ត្រូវបាន ជ្រើសរើស ដើម្បី ដាក់ ឲ្យ យាន រ៉ូបូត ជំនាន់ ចុងក្រោយ របស់ ខ្លួន ហើយ ដែល វា នឹង ត្រូវ បញ្ជូន ទៅ សិក្សា ស្រាវជ្រាវ នៅ ភព អង្គារ នៅក្នុង ឆ្នាំ ២០២០ នេះ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃសុក្រ ទី ០៦ ខែមីនា ឆ្នាំ ២០២០ ។
ការប្រកួត សប្តាហ៍ ទី៥ មាន ៩ប្រកួត នៃ ពាន់ រង្វាន់ ស្វាយរៀង ខាប់ លើក ទី៥ រដូវកាល ឆ្នាំ ២០២០
( ស្វាយរៀង ) ៖ ការប្រកួត ពានរង្វាន់ ស្វាយរៀង ខាប់ រដូវកាល នេះ មាន ការចូលរួម ចំនួន ៥១ ក្រុម មាន ចំនួន ១០៧ ប្រកួត ចាប់ផ្តើម ដំណើរការ រយៈពេល ៤ខែ ចាប់ពី ខែមករា រហូតដល់ ខែឧសភា ឆ្នាំ ២០២០ ដោយ មាន ក្រុម កីឡា មកពី បណ្តា ស្រុក - ក្រុង ទាំង ០៨ ទូទាំង ខេត្ត ស្វាយរៀង ។
ក្នុង នោះ មាន កីឡាករ និង មន្ត្រី ចូលរួម សរុប ប្រមាណ ១.៥០០ នាក់ ។ ការប្រកួត នឹង ធ្វើឡើង នៅ ទីលាន ចំនួន ០២ គឺ ទីលាន វិទ្យាល័យ ស្វាយរៀង សម្រាប់ វគ្គ ជំរុះ ក្នុង ពូល និង ទីលាន កីឡដ្ឋាន ខេត្ត ស្វា រៀង នឹង ធ្វើ ការប្រកួត វគ្គ សំខាន់ ៗ ។
លក្ខខណ្ឌ ចូលរួម ក្រុម កីឡា ទាំងអស់ ត្រូវ មាន កីឡាករ សញ្ជាតិ ខ្មែរ មាន ពី អាយុ ចាប់ពី ១៦ ឆ្នាំ ឡើង ទៅ មួយ ក្រុម មាន សមាជិក ច្រើន បំផុត ចំនួន ២៣នាក់ និង យ៉ាងតិច បំផុត ១៧នាក់ ហើយ ក្នុង មួយ ក្រុម អាច នាំយក កីឡាករ ក្រៅ ខេត្ត ចំនួន ៣នាក់ និង ២០ នាក់ ទៀត ជា អ្នក រស់ នៅក្នុង ខេត្ត ស្វាយរៀង ឬ មាន ទីកន្លែង កំណើត នៅក្នុង ខេត្ត ស្វាយរៀង ។
គួរំលឹង ផងដែរ ថា ពាន់ រង្វាន់ ស្វាយរៀង ខាប់ ត្រូវបាន បង្កើតឡើង បាន ៥ រដូវកាល ចាប ពី ឆ្នាំ ២០១៥ រហូតដល់ បច្ចុប្បន្ន ដោយ មាន ការ ផ្តួចផ្តើម ពីសំណាក់ លោក ឌី វិជ្ជា អនុប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត ស្វាយរៀង ។
ការរៀបចំ ពានរង្វាន់ ស្វាយរៀង ខាប់ នេះ ឡើង ក្នុង គោលបំណង បង្កើត អោយ មាន សកម្មភាព កីឡា ដើម្បី ជា ប្រយោជន៍ ដល់ យុវជន មហាជន ក៏ ដូចជា ប្រជាពលរដ្ឋ ក្នុង ខេត្ត មាន ឱកាស ចូលរួម លេង កីឡា ដើម្បី សុខភាព មិត្តភាព និង សាមគ្គីភាព ជា សឆ្ងាយ ពី ការប្រើប្រាស់ គ្រឿងញៀន និង អំពើ អបាយ មុខ ផ្សេង ៗ ៕
ក្រសួង ទេសចរណ៍ ប្រារព្ធ ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨មីនា នៅ រមណីយដ្ឋាន ទេសចរណ៍ វប្បធម៌ និង ប្រវត្តិសាស្ត្រ ភ្នំ ដា ខេត្ត តាកែវ
( តាកែវ )៖ ក្រសួង ទេសចរណ៍ ប្រារព្ធ ពិធី អបអរសាទរ ខួប លើក ទី ១០៩ ទិវា អន្តរជាតិ នារី ៨មីនា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « មាន សន្តិភាព មាន ការលើកកម្ពស់ សមភាព យេនឌ័រ » កម្មវិធី នេះ ប្រារព្ធ ឡើង នៅ បុរាណ ដ្ឋាន វប្បធម៌ និង ប្រវត្តិសាស្ត្រ ភ្នំ ដា ស្ថិត ក្នុង ស្រុក អង្គរ បុរី ខេត្ត តាកែវ ធ្វើ នៅ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២០ ។
ពិធី នេះ ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព លោកស្រី ញ៉ឹក ស៊ីម ថោង ខុន ប្រធាន កិត្តិយស សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ក្រសួង ទេសចរណ៍ និង លោកស្រី ហ៊ុន ដានី រដ្ឋលេខាធិការ និង ជា ប្រធាន សមាគម នារី ក្រសួង ទេសចរណ៍ ព្រមទាំង មាន ការចូលរួម ពី មន្ត្រី នារី របស់ ក្រសួង ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ អាជ្ញាធរ កងកម្លាំង តា ជី យាយ ជី សរុប ជាង ៣០០ នាក់ ។
ថ្លែង ក្នុង ពិធី សំណេះសំណាល លោកស្រី ហ៊ុន ដានី បាន លើកឡើង ថា មូលហេតុ ដែល ក្រសួង បាន ជ្រើសរើស ទី រមណីយដ្ឋាន នេះ ដើម្បី ប្រារព្ធ ពិធី៖
ទី១៖ គឺ ដើម្បី « អរគុណ ដល់ សន្តិភាព » និង រំលេច ពី តម្លៃ នៃ សន្តិភាព ដែល បាន ប្រែក្លាយ ប្រទេស កម្ពុជា ពី គំនរ ផេះ ផង់ បែកបាក់ ជាតិ ជា ប្រទេស ដែល មាន សន្តិភាព សេរីភាព ប្រជាធិបតេយ្យ នីតិរដ្ឋ និង កំពុង អភិវឌ្ឍន៍ ដ៏ ខ្លាំងក្លា លើ គ្រប់ វិស័យ ព្រមទាំង ចូលរួម ដោយ សេរីភាព និង ស្មើ សិទិ្ធ ជាមួយ បណ្តា ប្រទេស នានា ទាំង ក្នុង តំបន់ និង សកលលោក ជាពិសេស សមភាព យេនឌ័រ ត្រូវបាន លើកកម្ពស់ ជា បន្តបន្ទាប់ ប្រកបដោយ លទ្ធផល វិជ្ជមាន គួរឲ្យ កត់សម្គាល់ ។
ទី៣៖ ដើម្បី ផ្សព្វផ្សាយ និង ជំរុញ ទេសចរណ៍ ក្នុង ស្រុក ឲ្យ សកម្ម ផុល ផុស ឡើង ជា ការរួមចំណែក លើកកម្ពស់ ជីវភាព ប្រជាពលរដ្ឋ ស្រប តាម ឆន្ទៈ និង អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល ចង់ឲ្យ ប្រជាពលរដ្ឋ ខ្មែរ បង្វែរ ទិសដៅ ដើរលេង កម្សាន្ត ក្នុង ប្រទេស ជាជាង ការចេញ ទៅ ទេសចរណ៍ នៅ ក្រៅ ប្រទេស ។
ទី ៤៖ ចូលរួម បង្កើត ឱកាស ការងារ និង រក ប្រាក់ ចំណូល ដល់ ប្រជាពលរដ្ឋ មូលដ្ឋាន ។
ទី ៥៖ បង្កើន ការរិត ចំណង សាមគ្គីភាព មិត្តភាព និង ភាតរភាព រវាង មន្ត្រី នារី គ្រប់ លំដាប់ថ្នាក់ ទាំង ថ្នាក់ ក្រសួង រាជធានី - ខេត្ត ឲ្យ កាន់តែ ជិតស្និទ្ធ សំដៅ ចេះ ជួយ គ្នា និង ចែករំលែក បទពិសោធន៍ គ្នា ទៅ វិញ ទៅមក ។
លោកស្រី បាន បន្ថែម ទៀត ថា បើ ទោះបី ថ្ងៃ នេះ យើង រំលឹក ដល់ សិទ្ធិ របស់ នារី តែ យើង ក៏ ស្វាគមន៍ ផងដែរ ការចូលរួម របស់ បុរស ។ សមភាព យេនឌ័រ គឺជា កត្តា ចម្បង ក្នុង ការធានា នូវ ចីរភាព នៃ សន្តិភាព និង កិច្ចអភិវឌ្ឍន៍ ។
លោក ស្ដ្រី បញ្ជាក់ ថា ស្រី ជា តួអង្គ រួមចំណែក ដ៏ សំខាន់ និង ចាំបាច់ ក្នុង ការធានា បាន នូវ ប្រសិទ្ធភាព បរិយាប័ន្ន និង និរន្តភាព យូរអង្វែង នៃ សន្តិភាព ។ សមភាព យេនឌ័រ និង ការបង្កើន ភាពអង់អាច ដល់ ស្ត្រី និង ក្មេងស្រី គឺជា របៀបវារៈ ដែល ត្រូវបាន រាជ រដ្ឋាភិបាល កម្ពុជា ផ្តោត ការយកចិត្តទុកដាក់ និង គាំទ្រ យ៉ាង ខ្លាំងក្លា ដើម្បី ជំរុញ ឲ្យ ពួកគេ ក្លាយជា កម្លាំង ចលករ ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង កិច្ចអភិវឌ្ឍន៍ និង ក្លាយជា ឆ្អឹង ខ្នង ដ៏ រឹងមាំ នៃ សេដ្ឋកិច្ច និង សង្គមជាតិ ។
យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ ដើម្បី កំណើន ការងារ សមធម៌ និង ប្រសិទ្ធភាព ផែនការ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ ជាតិ ឆ្នាំ ២០១៩ - ២០៣០ និង គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព របស់ កម្ពុជា បាន ដាក់ចេញ នូវ ការងារ លើកកម្ពស់ សមភាព យេនឌ័រ និង ការពង្រឹង ភាពអង់អាច ដល់ ស្រ្តី និង ក្មេង ស្រ្តី ជា ការងារ អាទិភាព មួយ ៕ បញ្ជូន ជនសង្ស័យ ២នាក់ ទៅ តុលាការ ខេត្ត កំពង់ធំ ករណី ជួញដូរ គ្រឿងញៀន
ជនសង្ស័យ ទាំង២នាក់ ខាងលើ រួម មាន ទី១៖ ឈ្មោះ ម៉ឹល គុំភ័ណ្ឌ ភេទ ប្រុស អាយុ ៣៣ ឆ្នាំ មុខរបរ កម្មករ សំណង់ រស់ នៅ ភូមិ ដូង ឃុំ បល្ល័ង្គ ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ និង ទី២៖ ឈ្មោះ ង៉ែត វិសាល ភេទ ប្រុស អាយុ ២១ ឆ្នាំ មុខរបរ កសិករ រស់ នៅ ភូមិ ឃ្លៃ ឃុំ កំពង់ថ្ម ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ។
វត្ថុតាង ដែល សមត្ថកិច្ច ដកហូត បាន ម្ស៉ ក្រាម ពណ៌ ស ថ្លា សង្ស័យ ជា សារធាតុ ញៀន ខុស ច្បាប់ ចំនួន ១៥កញ្ចប់ មាន ទម្ងន់ ១៩. ៥ក្រាម និង ទូរស័ព្ទដៃ ចំនួន ០៣ គ្រឿង ៕ ទិវា អន្តរជាតិ នារី ៨មីនា ! ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ប្រកាស សូម គាំទ្រ និង លើកទឹកចិត្ត ដល់ ក្រុមការងារ យេនឌ័រ កងទ័ព ជើងគោក សូម បន្ត យកចិត្តទុកដាក់ ចូលរួម ក្នុង ការលើកកម្ពស់ ស្ត្រី
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក បាន អញ្ជើញ ពិធី សំណេះសំណាល ខួប អនុស្សាវរីយ៍ លើក ទី ១០៩ នៃ ទិវា អន្តរជាតិ នារី ៨ - មីនា ឆ្នាំ ២០២០ នៅ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក នៅ ទី៥ ខែមីនា ឆ្នាំ ២០២០ ។
ពិសេស ផងដែរ នៅក្នុង ដំណាក់កាល សន្តិភាព ដូច បច្ចុប្បន្ន សមត្ថភាព និង តម្លៃ ស្ត្រី កម្ពុជា ក៏ កាន់តែ ត្រូវបាន ទទួលស្គាល់ ជា លក្ខណៈ អន្តរជាតិ ដោយ កម្ពុជា ទទួល ចំណាត់ថ្នាក់ លេខ ១ នៅក្នុង តំបន់ អាស៊ាន ដែល បាន បញ្ជូន កងទ័ព ស្ត្រី ទៅ បំពេញ បេសកកម្ម ក្រៅ ប្រទេស ច្រើន ជាង គេ ក្នុង ក្របខ័ណ្ឌ នៃ កងកម្លាំង រក្សា សន្តិភាព អង្គការ សហ ប្រជាជាតិ ។
ការអភិវឌ្ឍ ប្រទេស នីមួយ ៗ ត្រូវតែ គិតគូរ ពី សក្កានុពល របស់ ស្ត្រី ដែល មាន ចំនួន ច្រើន ប្រហាក់ប្រហែល នឹង បុរស ។ កត្តា នេះ ឤច រួមចំណែក ជួយ ពន្លឿន ការអភិវឌ្ឍ ជាតិ ដូច ដែល សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី តែង បាន លើកឡើង ថា « ជួយ ស្ត្រី គឺ ជួយ ខ្លួន ឯង » ។ ភាព ទន់ភ្លន់ និង ស្នាមញញឹម របស់ ស្ត្រី ជា ថ្នាក់ដឹកនាំ ជា ម្តាយ និង ជា ភរិយា គឺ អាច ឱ្យ សង្គម គ្រួសារ និង សង្គមជាតិ ទាំងមូល មាន សុខ សន្តិភាព សុភមង្គល និង ភាពរីកចម្រើន រុងរឿង ។
លោក មេបញ្ជាការ បាន ប្រកាស សូម គាំទ្រ និង លើកទឹកចិត្ត ដល់ ក្រុមការងារ យេនឌ័រ កងទ័ព ជើងគោក ក៏ ដូចជា បណ្តា ស្ថាប័ន - កង ឯកភាព ទូទាំង កងទ័ព ជើងគោក សូម បន្ត យកចិត្តទុកដាក់ ចូលរួម ក្នុង ការលើកកម្ពស់ ស្ត្រី . ពិនិត្យ លទ្ធភាព ផ្តល់ ឱកាស ដល់ យោធិន នារី . ជំរុញ លើកទឹកចិត្ត យោធិន នារី ឱ្យ ទទួលបាន តួនាទី និង សិទ្ធិ ក្នុង ការសម្រេច កិច្ចការ មួយចំនួន ៕
ឧប នាយក រដ្ឋមន្រ្តី យឹម ឆៃលី ជំរុញ អាជ្ញាធរ ខេត្ត កំពង់ចាម ខិតខំ រក្សា សុខ សន្តិភាព សណ្ដាប់ធ្នាប់ សាធារណៈ និង សុវត្ថិភាព សង្គម ក្នុង ឆ្នាំ ២០២០
( កំពង់ចាម ) ៖ លោក ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី បាន ជំរុញ ដល់ អាជ្ញាធរ ខេត្ត កំពង់ចាម ឲ្យ ខិតខំ បន្ថែម ទៀត ក្នុង ការងារ ថែរក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម ឲ្យ កាន់តែ ល្អ ប្រសើរ ។
ឧប នាយក រដ្ឋមន្ត្រី បាន លើកឡើង ដូច្នេះ នៅ រសៀល ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២០ នា ឱកាស អញ្ជើញ ក្នុង ពិធី បិទ សន្និបាត វាយតម្លៃ អំពី លទ្ធផល ការងារ រដ្ឋបាល ខេត្ត កំពង់ចាម សម្រេចបាន ក្នុង ឆ្នាំ ២០១៩ និង លើក ទិសដៅ ការងារ សម្រាប់ ឆ្នាំ ២០២០ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី បាន ថ្លែង ថា អំពី សន្តិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម អាជ្ញាធរ និង កងកម្លាំង មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ត្រូវ បន្ត ថែរក្សា ពង្រឹង សន្តិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម ឲ្យបាន ល្អ ប្រសើរ ដោយ ត្រូវ យកចិត្តទុកដាក់ លើ វិធានការសំខាន់ សំខាន់ ដូច ខាងក្រោម៖
ឧប នាយក រដ្ឋមន្ត្រី បាន ថ្លែង បន្ត ថា ឆ្នាំ ២០១៩ កន្លងទៅ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ មាន ការកើនឡើង ធ្វើឲ្យ មនុស្ស ស្លាប់ និង រងរបួស មាន ការកើនឡើង យ៉ាង គំហុក ប៉ះពាល់ ដល់ អាយុជីវិត ទ្រព្យសម្ប ត្តិសាធារណៈ និង ទ្រព្យសម្បត្តិ ប្រជាជន ជាច្រើន ។
សិស្ស ស្រី ដែល ទូរស័ព្ទហៅ ឪពុក មក ជួយ រឿង ហិង្សា ជាមួយ សិស្ស ដូចគ្នា នៅ សាលា ជម្ពូវ័ន ចេញមក សុំទោស លោក នាយក សាលា និង គ្រូ ៗ ចំពោះ កំហុស អចេតនា របស់ ខ្លួន
( ភ្នំពេញ ) ៖ ក្មេងស្រី ឈ្មោះ ផា នុត ជា សិស្ស ស្រី ដែល កើតមាន អំពើហិង្សា ជាមួយ សិស្ស ដូចគ្នា នៅ សាលា ជម្ព វ័ន កាលពី ថ្ងៃទី ៣ ខែមីនា ឆ្នាំ ២០២០ កន្លងទៅ បាន លើក ដៃ សំពះ សូម អភ័យទោស ពីសំណាក់ លោក នាយក សាលា ជម្ព វ័ន និង លោកគ្រូ អ្នកគ្រូ ទាំងអស់ កំហុស អចេតនា របស់ ខ្លួន ចំពោះ រឿងរ៉ាវ ទាំងអស់ ដែល បាន កើត មាន ឡើង រហូតដល់ មាន ការឃាត់ខ្លួន ឪពុក និង បង ស្រី ថែម ទៀត ។
សិស្ស ស្រី រូប នេះ បាន បញ្ជាក់ ថា រូប គេ ពិតជា សោកស្តាយ យ៉ាង ខ្លាំង នូវ អ្វី ដែល បាន កើតឡើង ចំពោះ សាលារៀន ចំពោះ លោកគ្រូ អ្នកគ្រូ ដែល ផ្ទុយទៅនឹង អ្វី ដែល លោក ទាំងអស់ តែងតែ ទូន្មាន ប្រៀន ប្រដៅ សិស្សានុសិស្ស ទាំងអស់ នូវ ដំបូន្មាន ល្អ ៗ ឲ្យ ចេះ ស្រឡាញ់ រាប់អាន គ្នា សាមគ្គី គ្នា ចេះ ជួយ ទុក្ខ ធុរៈ គ្នា នោះ ។
សិស្ស ស្រី ផា នុត ដែល ឪពុក និង បង ស្រី កំពុង ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ព្រោះតែ ករណី របស់ ខ្លួន បាន សន្យា ថា នឹង មិន ធ្វើ មាន ករណី បែប នេះ កើតឡើង ជាថ្មី ចំពោះ សាលា ឡើយ និង សូមឲ្យ នាយក សាលា និង លោកគ្រូ អ្នកគ្រូ ទាំងអស់ មេត្តា លើកលែង កំហុស របស់ ឪពុក នាង ដោយ អចេតនា នេះ ផង ។
ក្មេងស្រី ផានុត ដែល ជា កូនស្រី ពៅ និង ជា អ្នក មាន ជម្លោះ ជាមួយ ក្រុម សិស្ស ដទៃ ទៀត បាន លើក ម្រាម ដៃ ដប់ សុំ អង្វរ ដល់ តុលាការ និង ថ្នាក់ដឹកនាំ ក្រសួង យុត្តិធម៌ សុំ មេត្តា ជួយ ដោះលែង ឪពុក វិញ ដោយ បាន អះអាង ថា ឪពុក ខ្លួន មិន បាន វាយ ទេ គ្រាន់តែ ចូល ចាប់ និង ឃាត់ ក្រុម ក្មេង ៗ ទាំងនោះ តែ ប៉ុណ្ណោះ ។
រដ្ឋមន្ដ្រី ហង់ ជួន ណារ៉ុន រំពឹង ថា នឹង មាន យុវជន ចន្លោះ ពី ៤- ៥ម៉ឺន នាក់ ចូលរួម ទិវា ជាតិ អំណាន លើក ទី ០៥
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្ដ្រី ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន បញ្ជាក់ ថា ទិវា ជាតិ អំណាន លើក ទី០៥ ក្រោម ប្រធានបទ « ការអាន បណ្ដុះបញ្ញា ការស្រាវជ្រាវ និង ន វានុវត្ដន៍ » នៅក្នុង ឆ្នាំ ២០២០ នេះ នឹង មាន យុវជន ចូលរួម ចន្លោះ ពី ៤- ៥ម៉ឺន នាក់ ។
ការបញ្ជាក់ បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក រដ្ឋមន្ដ្រី ហង់ ជួន ណារ៉ុន អញ្ជើញ ចូលរួម អបអរសាទរ ទិវា ជាតិ អំណាន លើក ទី០៥ ក្រោម ប្រធានបទ « ការអាន បណ្ដុះបញ្ញា ការស្រាវជ្រាវ និង ន វានុវត្ដន៍ » និង សម្ពោធ ការតាំងពិព័រណ៍ សៀវភៅ នៅ វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា នា ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ ។
រដ្ឋមន្ដ្រី ហង់ ជួន ណារ៉ុន បាន បញ្ជាក់ ថា « យើង សង្ឃឹម ថា មាន យុវជន ចន្លោះ ពី ៤- ៥ម៉ឺន នាក់ នឹង ចូលរួម ក្នុង ពិព័រណ៍ សៀវភៅ និង ទិវា ជាតិ អំណាន លើក ទី០៥ ក្រោម ប្រធានបទ « ការអាន បណ្ដុះបញ្ញា ការស្រាវជ្រាវ និង ន វានុវត្ដន៍ » នៅក្នុង ឆ្នាំ ២០២០ នេះ » ។
លើស ពី នោះ ទៀត លោក រដ្ឋមន្ដ្រី ហង់ ជួន ណារ៉ុន បាន ឲ្យដឹង ថា គោលបំណង នៃ ការប្រារព្ធ ទិវា ជាតិ អំណា ន៖
ទី ១៖ បណ្ដុះ ទម្លាប់ អាន ជំរុញ វប្បធម៌ អាន លើកម្ពស់ សមត្ថភាព អាន និង ការតែ និពន្ធ សំដៅ រួមចំណែក ការពារ និង ពង្រឹង វប្បធម៌ អរិយធម៌ ខ្មែរ ដល់ សិស្ស និស្សិត មន្ដ្រីរាជការ ប្រជាជន គ្រប់ រូប ក្នុង ប្រទេស កម្ពុជា ព្រមទាំង លើកកម្ពស់ រក្សា គុណ តម្លៃ កេដំណែល របស់ មនុស្សជាតិ ។
ទី២៖ សម្រេច គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ដែល ធានា គុណភាព អប់រំ ប្រកបដោយ សមធម៌ បរិយាប័ន្ន និង លើកកម្ពស់ ការសិក្សា ពេញ មួយ ជីវិត សម្រាប់ ទាំងអស់ គ្នា ។
សូម ជម្រាប ថា សកម្ម នានា ក្នុង ការប្រារព្ធ ទិវា ជាតិ អំណាន លើក ទី០៥ ក្រោម ប្រធានបទ « ការអាន បណ្ដុះបញ្ញា ការស្រាវជ្រាវ និង ន វានុវត្ដន៍ » នៅក្នុង ឆ្នាំ ២០២០ នេះ រួម មាន ៖
បើ តាម អាជ្ញាធរ សុខាភិបាល អ៉ីតាលី ពេញ មួយ ថ្ងៃព្រហស្បតិ៍ ម្សិលមិញ ករណី ឆ្លង ថ្មី ៗ សរុប ៧៦៩ ករណី ទៀត ក៏ ត្រូវបាន កត់ត្រា ផងដែរ ដោយ ធ្វើឱ្យ អ្នក ឆ្លង នៅ ទូទាំង ប្រទេស កើន ដល់ ៣. ៨៥៨ ករណី ។ ជា វិធានការ ទប់ស្កាត់ រដ្ឋាភិបាល អ៉ីតាលី បាន សម្រេចចិត្ត បិទ សាលារៀន និង សាកលវិទ្យាល័យ ទាំងអស់ នៅ ទូទាំង ប្រទេស រហូតដល់ ថ្ងៃទី ១៥ ខែមីនា ដែល នេះ មាន ន័យ ថា សិស្ស - និស្សិត ៨. ៥លាន នាក់ ត្រូវ នៅ ស្ថិត នៅក្នុង ផ្ទះ និង មិន អាច ទៅ សាលារៀន របស់ ពួកគេ ។
បន្ទាប់ពី ទទួលបាន ពី ព័ត៌មាន ករណី ខាងលើ នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន បញ្ជា ឲ្យ លោក ម៉ូវ ម៉ានិត អភិបាល ខណ្ឌ សែនសុខ និង មន្រ្តី សុខាភិបាល ព្រមទាំង អាជ្ញាធរ មូល បាន ចុះ ទៅ ពិនិត្យមើល ជាក់ស្តែង នៅក្នុង ផ្ទះ របស់ ជនជាតិ ចិន ៣នាក់ ។
បន្ទាប់ពី ក្រុម ប្រតិបត្តិការ នៅ ធ្វើ ការសាកសួរ រួច ផ្នែក ជំនាញ សន្និដ្ឋាន ថា គឺ ពុំ មាន ទាក់ទង នឹង វិរុស កូវិដ១៩ ( កូរ៉ូណា ទេ ) និង ក្រុម ប្រតិបត្តិការ បាន ផ្ដល់ អនុសាសន៍ ដល់ ជនជាតិ ចិន ទាំង៣នាក់ ខាងលើ ឲ្យ ចេះ អនាម័យ ពាក់ ម៉ាស ការពារ ពេល ជួប មិត្តភក្តិ ដែល ជា ជនជាតិ ចិន ដូចគ្នា ដែល មកពី ប្រទេស ចិន ពាក់ព័ន្ធ តំបន់ មាន ជំងឺ និង ឲ្យ ចាប់អារម្មណ៍ ពី អាការៈ នៃ ជំងឺ មាន សភាព ដូចជា ក្អក ហៀរ សំបោរ មាន កំដៅ ក្នុង ខ្លួន ៣៨អង្សា ពិបាក ដកដង្ហើម ។ល ។
ជនជាតិ ចិន ចំនួន ៣នាក់ ខាងលើ បាន និយាយ ថា ថៅកែ ពួកគេ បាន ហៅទូរស័ព្ទហៅ គ្រូពេទ្យ ឯកជន នៅ ម្ដុំ រតន ផ្លាហ្សា ( សង្កាត់ ទឹក ថ្លា ) មក ពិនិត្យ មុន ចូល ធ្វើ ការងារ រត់ តុ នៅ ភោជនីយដ្ឋាន តែ ប៉ុណ្ណោះ ។
លោក ម៉េត មាស ភក្តី បាន បញ្ជាក់ ថា ពាក់ព័ន្ធ នឹង ករណី ខាងលើ នេះ ខាង មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ នឹង បន្ត តាមដាន លើ ជនជាតិ ចំនួន ៣នាក់ ខាងលើ ទៀត ។ ជាង នោះ ទៅ ទៀត ពាក់ព័ន្ធ នឹង ស្ថានភាព សុខភាព ប្រជាពលរដ្ឋ នៅ រាជធានី ភ្នំពេញ ជាពិសេស ពាក់ព័ន្ធ ជំងឹ Covid-19 គឺ លោក អភិបាល រាជធានី ភ្នំពេញ បាន តាមដាន យ៉ាង យកចិត្ត ដាក់ បំផុត និង ត្រៀម ចាត់ វិធានការ ជានិច្ច លើ បញ្ហា នេះ ។
ការសម្រេច ឲ្យ បើ ប្រាក់ បៀវត្ស សរុប តែ មួយ លើក នេះ ដើម្បី សម្រួល ដល់ មន្ត្រីរាជការ ដែល ត្រូវការ ប្រើប្រាស់ ថវិកា សម្រាប់ ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ៕ ក្រសួង ពាណិជ្ជកម្ម ថៃ លើក ពេល រៀបចំ ពិព័រណ៍ គ្រឿង បន្លាស់ រថយន្ដ ទៅ ធ្វើ នៅ ខែកញ្ញា ដោយសារ វីរុស COVID-19
ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចូលរួម អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨មីនា លើក ទី ១០៩
( ភ្នំពេញ ) ៖ នៅ សុក្រ ១៣ កើត ខែ ផល្គុន សំរឹទ្ធិ ស័ក ព .ស២៥៦៣ ត្រូវនឹង ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា អញ្ជើញ ជា អធិបតី ក្នុង ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ខួប លើក ទី ១០៩ នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ ។
សិទ្ធិ សេរីភាព របស់ ប្រជាពលរដ្ឋ ខ្មែរ ព្រមទាំង ស្ត្រី ផង បាន កើតមាន ជាថ្មី ក្រោយ របប ដ៏ យង់ឃ្នង របស់ ប៉ុល ពត ត្រូវបាន វាយ ផ្តួលរំលំនៅ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។ ចាប់តាំងពី ថ្ងៃ រំដោះ រហូតដល់ ពេល បច្ចុប្បន្ន រាជ រដ្ឋាភិបាល កម្ពុជា តែង បាន យកចិត្តទុកដាក់ ជានិច្ច ក្នុង ការលើកកម្ពស់ ស្រ្តី រហូត បង្កើត បានជា ពាក្យស្លោក ថា « ស្រ្តី ជា ឆ្អឹង ខ្នង សេដ្ឋកិច្ច ជាតិ » ។
* ខាងក្រោម នេះ គឺជា ប្រវត្តិ នាំឲ្យ មាន ការប្រារព្ធ ទិវា អន្តរជាតិ នារី ៨ មីនា៖
ចលនា ដ៏ ស្វិតស្វាញ នេះ បាន ជះ ឥទ្ធិពល យ៉ាង ខ្លាំង ទៅ លើ នារី ពលករ នៅ ប្រទេស អាឡឺម៉ង់ ដែល ជា ប្រទេស ឧស្សាហកម្ម ធំ មួយ នា សម័យ នោះ ។ នៅ ប្រទេស អាឡឺម៉ង់ ក្នុង ពេល នោះ បាន លេចឡើង នូវ យុវនារី ៣រូប ដ៏ ល្បីល្បាញ គឺ អ្នកស្រី ក្លារ៉ា ស្ជេគ គិន ជនជាតិ អាឡឺម៉ង់ និង រ៉ូស្កា លុម ស្ព័របួរ ជនជាតិ ប៉ូឡូញ ដែល បាន ចូលរួមគ្នា យ៉ាង ជិតស្និទ្ធ ជាមួយ អ្នកស្រី គ្រូប ស្កាយ៉ា ( ភរិយា លោក ឡេនីន ) បំផុស ចលនា បង្ខិត បានជា គណៈ លេខា អន្តរជាតិ ដើម្បី ដឹកនាំ ចលនា នារី ។
ឆ្នាំ ១៩១០ សន្និបាត អន្តរជាតិ នារី ដែល មាន ប្រទេស ១៧ ចូលរួម បាន ធ្វើឡើង នៅ ទីក្រុង កូប៉ែន ហាក រដ្ឋធានី នៃ ប្រទេស ដាណឺម៉ាក បាន សម្រេច យក ថ្ងៃ ៨ មីនា “ ទិវា នារី អន្តរជាតិ ” ថ្ងៃ មហាសាមគ្គី តស៊ូ របស់ នារី ពលករ ទូទាំង សាកលលោក ដើម្បី សិទ្ធិ សេរីភាព ប្រជាធិបតេយ្យ ដោយ ភ្ជាប់ ជាមួយនឹង ពាក្យស្លោក ថា « មួយ ថ្ងៃ ធ្វើ ការ ប្រាំបី ម៉ោង ». « ធ្វើ ការស្មើគ្នា បៀវត្ស ស្មើគ្នា ». « ការពារ សុខភាព មាតា និង ទារក » ។
ចាប់តាំងពី ថ្ងៃ នោះ មក ថ្ងៃ ៨ មីនា បាន ក្លាយទៅជា ថ្ងៃ បុណ្យ អន្តរជាតិ នារី ដែល រំឮ ក អំពី ការតស៊ូ របស់ នារី ពលករ ទូទាំង សកលលោក ដែល ប្រឹងប្រែង ដើម្បី រំដោះ នារី ដោយ ទាមទារ ឱ្យ អនុវត្ត សិទ្ធិ ស្មើភាព រវាង បុរស និង នារី ។
គឺ ដោយសារតែ មាន កិច្ចប្រឹងប្រែង ដោយ អំណត់ និង ពុះពារ នឹង ការលំបាក គ្រប់ បែបយ៉ាង ពី ១០០ ឆ្នាំ មុន នេះ ហើយ ទើប បច្ចុប្បន្ន នេះ នារី ក្នុង ពិភពលោក មាន ឱកាស ទទួលបាន នូវ សិទ្ធិ ស្មើភាព ក្នុង ការបន្តុះបង្អាប់ ខ្លះ ៗ ក៏ដោយ ។ លទ្ធផល ដ៏ ត្រចះត្រចង់ នេះ បាន កាត់បន្ថយ អស់ ជាច្រើន នូវ អំពើហិង្សា និង ការរើសអើង ចំពោះ នារី ភេទ ដែល គេ តែង ចាត់ទុក ជា ភេទ ទន់ខ្សោយ នោះ ។
នៅ ឆ្នាំ ១៩៨០ សន្និសីទ ពិភពលោក លើក ទី២ របស់ នារី បាន ធ្វើឡើង នៅ ទីក្រុង កូប៉េន ហាក ប្រទេស ដាណឺម៉ាក ដើម្បី ពិនិត្យមើល ការរីកចម្រើន និង ការអនុវត្ត ផែនការ សកម្មភាព ដែល កំណត់ ក្នុង សន្និសីទ លើក ទី១ និង គ្រោង ទុក នូវ ខ្សែ លើក យកមក ពិភាក្សា គឺ ការអប់រំ ការងារ និង សុខភាព ។
ឆ្នាំ ១៩៨៥ ចុងបញ្ចប់ នៃ ទស្សវត្ស នារី គេ បាន រៀបចំ សន្និសីទ លើក ទី៣ម្ដង ទៀត នៅ ទីក្រុង ណៃ រ៉ូប៊ី ប្រទេស កេនយ៉ា ដើម្បី ពិនិត្យ និង វាយតម្លៃ លើ លទ្ធផល សម្រេច របស់ ទស្សវត្ស នារី ព្រមទាំង ធ្វើ ការ អនុម័ត លើ យុទ្ធ វិធី ចម្រើន ទៅ មុខ សម្រាប់ ភាពលូតលាស់ របស់ នារី ក្នុង ឆ្នាំ ២០០០ ។
ទាំង នេះ គឺជា យុទ្ធសាស្ត្រ និង របៀប ដោះស្រាយ របស់ នារី ដែល តែងតែ អនុវត្ត តាម បែប សន្តិវិធី តាម ការបញ្ចេញមតិ តែ ប៉ុណ្ណោះ ។ ឯ លទ្ធផល ដែល នារី ទទួលបាន គឺ ការផ្ដល់ នូវ សិទ្ធិ ស្មើភាព ឱ្យ បាន គ្រប់គ្រាន់ និង តម្លៃ ជា មនុស្ស ពោលគឺ ពុំ មាន ទាមទារ អ្វី ឱ្យ លើស ពី នេះ ឡើយ ។
បើ យើង ប្រៀបធៀប ប្រវត្តិ ទិវា អន្តរជាតិ នារី ៨ មីនា ទៅនឹង កំណើត នៃ អង្គការ សហ ប្រជាជាតិ ឃើញ ថា ប្រវត្តិ ទិវា អន្តរជាតិ ៨ មិនា មាន កំណើត មុន អង្គការ សហ ប្រជាជាតិ ទៅ ទៀត ហើយក៏ មាន កំណើត មុន សិទ្ធិ មនុស្ស ទៀតផង ។
តែ ទោះជា យ៉ាង នេះ ក៏ដោយ សព្វ ថ្ងៃ នៅ កម្ពុជា ពិត មែន តែ មាន ច្បាប់ ជាតិ ច្បាប់ អន្តរជាតិ ដូចជា សេចក្ដីប្រកាស ជា សកល របស់ អង្គការ សហ ប្រជាជាតិ ស្ដីពី សិទ្ធិ មនុស្ស អនុសញ្ញា ស្ដីពី ការលុបបំបាត់ រាល់ ទម្រង់ នៃ ការរើសអើង ប្រឆាំង នឹង នារី ភេទ និង រដ្ឋធម្មនុញ្ញ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា ត្រង់ ជំពូក ៣ ដែល ស្ដីពី សិទ្ធិ នោះ ហើយក៏ ដោយ ក៏ វិសមភាព រវាង បុរស និង ស្ដ្រី ការរើសអើង ប្រឆាំង នឹង នារី ភេទ ការរំលោភ សិទ្ធិ ស្ត្រី ហិង្សា ក្នុង គ្រួសារ នៅតែ កើតមាន ជា បញ្ហា ។
ហេតុ ដូច្នេះហើយ បានជា រាជ រដ្ឋាភិបាល យើង និង អង្គការ ក្រៅ រដ្ឋាភិបាល មួយចំនួន ធំ ខំប្រឹង ខ្នះ ខ្នែង យក បញ្ហា ទាំងអស់ នេះ មក ផ្សព្វផ្សាយ ដល់ មនុស្ស គ្រប់ រូប ទាំង បុរស ទាំង ស្ត្រី ដើម្បី ជួយ ស្ដ្រី ឱ្យ មាន ភាពយុត្តិធម៌ ក្នុង ការទទួល សិទ្ធិ និង ប្រើ សិទ្ធិ និង ដើម្បី ជួយ កាត់បន្ថយ ទប់ស្កាត់ លុបបំបាត់ ចោល នូវ បញ្ហា ទាំងឡាយ ខាងលើ ដែល មាន ចំពោះ ស្ត្រី ភេទ ៕ កូនស្រី ទី២ របស់ លោក ហ៊ុន ម៉ាណែត ទទួលបាន ចំណាត់ថ្នាក់ លេខ ១ នៃ កម្មវិធី ប្រកួតប្រជែង គណិតវិទ្យា ប្រចាំ តំបន់ អាស៊ី និង លំដាប់ថ្នាក់ ពិភពលោក
លទ្ធផល សម្រាប់ ការប្រកួតប្រជែង នៅ តំបន់ អាស៊ី ទទួលបាន ពិន្ទុ ១៤. ០៩៧ ហើយ នៅ កំពូល តារាង លើ ពិភពលោក ជាមួយ ពិន្ទុ ១៤.០៩៧ ខណៈ លេខ ២ និង លេខ ៣ បាន ទៅ លើ ប្រទេស ចិន ។
ហេតុ អ្វី បានជា ខ្ញុំ ហ៊ាន និយាយ យ៉ាង ដូច្នេះ ? សូម ពិនិត្យមើល ចំណាត់ការ របស់ សម្តេច តេជោ ហ៊ុន សែន ដូចត ទៅ៖
ទី១៖ គឺ ការអំពាវនាវ ម្តង ហើយ ម្តង ទៀត កុំ ឲ្យ ពលរដ្ឋ ភ័យខ្លាច ព្រោះ ការភ័យខ្លាច វា បង្ក គ្រោះថ្នាក់ ជាង វីរុស Covid-19 ទៅ ទៀត ។ សម្តេច តេជោ ហ៊ុន សែន យល់ ច្បាស់ ថា ពលរដ្ឋ ខ្មែរ អាច បាត់បង់ ម្ចាស់ ការ និង ធ្វើឲ្យ មាន ភាពច្របូកច្របល់ ក្នុង សង្គម ប្រសិនបើ មិន ទប់ស្កាត់ ការភ័យខ្លាច ទេ នោះ ពីព្រោះ ម្យ៉ាង ការព្រួយបារម្ភ ពី វីរុស ឆ្លង កំពុង គ្របដណ្តប់ លើ សតិអារម្មណ៍ ពលរដ្ឋ ខ្មែរ ជាច្រើន និង ម្យ៉ាងទៀត គឺ ការបំផុស ព័ត៌មាន ក្លែងក្លាយ បំពុល សង្គម ពីសំណាក់ ជន អគតិ មួយចំនួន ក៏ បាន ធ្វើឡើង គួរឲ្យ កត់សម្គាល់ ។
ទី២៖ ការបង្ហាញ សកម្មភាព ជាក់ស្តែង ជា គំរូ ដល់ មហាជន ដូចជា ការស្នើសុំ ទៅ សួរសុខទុក្ខ និស្សិត ខ្មែរ នៅ វូហាន . ដំណើរទស្សនកិច្ច ផ្ទាល់ ទៅកាន់ ទីក្រុង ប៉េកាំង ដោយ មិន ពាក់ ម៉ាស់ ក្នុង ពេល ដែល វីរុស កំពុង ផ្ទុះ ខ្លាំង និង ការអនុញ្ញាតឲ្យ នាវា យក្ស Westerdam ចូល ចត ហើយ នាយក រដ្ឋមន្ត្រី ខ្លួន ឯង ចេញ ទៅ ទទួលស្វាគមន៍ អ្នកទេសចរ ដោយ ផ្ទាល់ ខណៈ ដែល ពិភពលោក កំពុង ភ័យខ្លាច និង រើសអើង អ្នក ទាំងនោះ ។
ទី៣៖ គឺ ការឆ្លៀត យក ឱកាស នេះ ដើម្បី ផ្សព្វផ្សាយ និង បញ្ជ្រាប ពី របៀប រស់ នៅ ប្រកបដោយ អនាម័យ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ពីព្រោះ សម្តេច តេជោ ហ៊ុន សែន យល់ ច្បាស់ ណាស់ ថា អនាម័យ គឺជា គោលការណ៍ គ្រឹះ ក្នុង ការបង្ការ ទប់ស្កាត់ ជំងឺ ឆ្លង គ្រប់ ប្រភេទ មិន ត្រឹមតែ Covid-19 ទេ ហើយ ចំណុច ខ្សោយ របស់ ពលរដ្ឋ ខ្មែរ គឺ ការរស់នៅ ដោយ មិន សូវ ខ្វល់ ពី អនាម័យ ។
អ្វី ដែល គួរឲ្យ កត់សម្គាល់ ម្យ៉ាងទៀត គឺ ពលរដ្ឋ ខ្មែរ គ្រប់ ទិសទី បាន អនុវត្ត វិធីសាស្ត្រ អនាម័យ ជាប្រចាំ ដូច ជា៖ ការលាង ដៃ ញឹកញាប់ . ការពាក់ ម៉ាស់ នៅ ពេល ដែល ពួកគេ ទៅកាន់ ទីណា ដែល មាន មនុស្សម្នា ច្រើន ឬ នៅពេល មាន ជំងឺ ផ្តាសាយ ជាដើម ។ នេះ គឺជា ឥរិយាបថ ថ្មី និង ជា ឥរិយាបថ ដ៏ វិជ្ជមាន របស់ ពលរដ្ឋ ខ្មែរ ដែល អាច ការពារ បាន នូវ ការចម្លង វីរុស Covid-19 រហូតមកទល់ ពេលនេះ ។
ពេល យើង ពិនិត្យមើល បញ្ហា ទាំងនេះ ដោយ យកចិត្តទុកដាក់ ទើប យើង អាច យល់ បាន ពី ភាពឈ្លាសវៃ របស់ មេដឹកនាំ និង យល់ ពី របៀប ដឹកនាំ និង គ្រប់គ្រង ប្រទេស ។ ជាទូទៅ នៅពេល មាន អាសន្ន ណាមួយ កើតឡើង មេដឹកនាំ តែង ផ្ញើ សារ និង ធ្វើ សកម្មភាព ជា គំរូ ដើម្បី រក្សា លំនឹង ចិត្ត ប្រជាពលរដ្ឋ និង លំនឹង សេដ្ឋកិច្ច ជាតិ ។
កាលពី ដំបូង ឡើយ មាន អ្នក ខ្លះ ដែល មិន យល់ កាលៈទេសៈ ជាពិសេស ក្រុម ប្រឆាំង ជ្រុលនិយម បាន នាំគ្នា រិះគន់ សម្តេច តេជោ ហ៊ុន សែន ថា បាន ផ្ញើ សារ ឬ បង្ហាញ សកម្មភាព ហាក់ដូចជា ផ្ទុយ ពី និន្នាការ នៃ ការភ័យខ្លាច របស់ ពិភពលោក ឬ អ្នក ខ្លះ និយាយ ថា ជា ការដើរ បញ្ច្រាស គេ ។ ប៉ុន្តែ ពួកគេ ភ្លេច គិត ថា « ត្រី ដែល ហែល បណ្តោយ ទឹក គឺ មាន តែ ត្រី ងាប់ ឬ ត្រី ដែល អស់ ថាមពល ទៅ មុខ លែង រួច ប៉ុណ្ណោះ ចំណែកឯ ត្រី ដែល ហែល បញ្ច្រាស ទឹក គឺជា ត្រី ដែល វៃ ឆ្លាត និង ពោរពេញ ដោយ ថាមពល » ។
សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២០
១៖ រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល៖ បុរស ជនជាតិ ជប៉ុន មាន ផ្ទុក មេរោគ Covid-19 . ក្រុម មន្រ្តី សុខាភិបាល និង អាជ្ញាធរ ខេត្ត សៀមរាប កំពុង ធ្វើការ លើ ករណី នេះ ដោយ តម្លាភាព បំផុត ដើម្បី ជៀសវាង ការភ័យខ្លាច ពីសំណាក់ ប្រជាពលរដ្ឋ ( ចុច អាន )
៤៖ ក្រសួង សុខាភិបាល អំពាវនាវ អ្នក ធ្លាប់ មាន ទំនាក់ទំនង ជាមួយ ជនជាតិ ជប៉ុន ឆ្លង កូវីដ១៩ សូម ប្រញាប់ មក ពិនិត្យ សុខភាព . ទាក់ទង លេខ ទូរស័ព្ទ ១១៥ ( ចុច អាន )
៦៖ ក្រសួង សេដ្ឋកិច្ច៖ កញ្ចប់ វិធានការ កែទម្រង់ មុត ស្រួច ដើម្បី លើកកម្ពស់ បរិយាកាស វិនិយោគ និង ធុរកិច្ច នៅ កម្ពុជា នឹង ត្រូវ ប្រកាស នៅ ថ្ងៃទី ០១ ខែមេសា ( ចុច អាន )
៧៖ អគ្គ នាយក គយ៖ ការបញ្ជូន វត្ថុធាតុ ដើម ពី ចិន សម្រាប់ រោងចក្រ កាត់ដេរ ងើប ឡើងវិញ បន្តិច ហើយ ជា សញ្ញា ល្អ សម្រាប់ វិស័យ រោងចក្រ កាត់ដេរ របស់ កម្ពុជា ( ចុច អាន )
៨៖ លោក គុណ ញឹម៖ ចំណូល គយ ធ្លាក់ចុះ បន្ដិចបន្ដួច នៅ ខែកុម្ភៈ ដោយសារ កូវី ដ១៩ និង បញ្ហា មួយចំនួន ( ចុច អាន )
១៥៖ កូរ៉េ ខាងជើង រិះគន់ ធ្ងន់ ៗ លើ ខ្សែភាពយន្ត កូរ៉េ ខាងត្បូង ដែល បង្ហាញ ទិដ្ឋភាព កូរ៉េ ខាងជើង ក្នុង ផ្លូវ អាក្រក់ ( ចុច អាន )
១៩៖ ផ្ទុះ ការវាយតប់ គ្នា រវាង សមាជិក សភា ក្នុង កិច្ចប្រជុំ សភា តួកគី ( ចុច អាន )
ក្រសួង បរិស្ថាន ប្រគល់ បណ្ណ សរសើរ មេត្រីភាព បរិស្ថាន ជូន ដល់ ធនាគារ ជី ប ម៉ុង
( ភ្នំពេញ ) ៖ ធនាគារ ជី ប ម៉ុង នៅ ល្ងាច ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២០ បាន ទទួល បណ្ណ សរសើរ ប្រតិបត្តិ មេត្រីភាព បរិស្ថាន ពី ប្រសួង បរិស្ថាន ។
ការប្រគល់ បណ្ណ សរសើរ នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព របស់ លោក នេត្រ ភក្រ្តា រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន និង លោក ជួប ប៉ារីស៍ អគ្គ លេខាធិការ រង នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ អភិវឌ្ឍន៍ ដោយ ចីរភាព ។
ធនាគារ ជី ប ម៉ុង គឺជា ធនាគារ ពាណិជ្ជ ទី មួយ ដែល បាន ប្រតិបត្តិ មេត្រីភាព បរិស្ថាន ល្អ ប្រសើរ តាមរយៈ ការកាត់បន្ថយ ការប្រើប្រាស់ ក្រដាស ការបង្កើត ប្រព័ន្ធ ឌីជីថល សម្រួល ប្រតិបត្តិការ សេវាកម្ម ធនាគារ ជូន អតិថិជន ការរៀបចំ ការិយាល័យ ប្រកបដោយ ផាសុកភាព និង មាន អនាម័យ ខ្ពស់ សម្រាប់ បុគ្គលិក ព្រម ទំាង ការចូលរួម អនុវត្ត គោលការណ៍ ហិរញ្ញវត្ថុ ប្រកបដោយ ចីរភាព ។
លោក ឧកញ៉ា លាង ម៉េង ប្រធាន ក្រុមប្រឹក្សាភិបាល ធនាគារ ជី ប ម៉ុង បាន ថ្លែង ថា ការទទួលបាន បណ្ណ សរសើរ មេត្រីភាព បរិស្ថាន នេះ ពិតជា ធ្វើឲ្យ លោក និង សហការី ធនាគារ ជី ប ម៉ុង ទាំងអស់ មាន សេចក្តីរំភើប និង សប្បាយរីករាយ ដែល ធនាគារ នេះ ទទួលបាន ការកោតសរសើរ ពី ក្រសួង បរិស្ថាន ហើយ សមិទ្ធផល មួយ នេះ បាន ពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ថ្នាក់ដឹកនាំ និង សហការី ទាំង អស់ គ្នា ។
លោក ឧកញ៉ា បាន បន្ត ទៀត ថា ធនាគារ ជី ប ម៉ុង បាន ប្រើប្រាស់ បច្ចេកវិទ្យា ចុងក្រោយ បែប ឌីជីថល តាម ឧស្សាហកម្ម ៤.០ ដែល ធ្វើការ តាម ប្រព័ន្ធ អេឡិចត្រូនិច សន្សំ សម្ចៃ ការប្រើប្រាស់ ក្រដាស ដែល ចូលរួម ការពារ បរិស្ថាន កាត់បន្ថយ ការកាប់ ព្រៃឈើ និង កាត់បន្ថយ ការ រំ ភាយ ឧស្ម័ន កាបូន ឌី អុកស៊ីត (CO2) ។
ជាមួយគ្នា នេះ ក្នុង នាម រដ្ឋមន្ត្រី សាយ សំអាល់ . លោក នេត ភក្ត្រា បាន ថ្លែង នូវ ការកោតសរសើរ ចំពោះ ក្រុមហ៊ុន ជី ប ម៉ុង និង ថ្លែងអំណរ គុុណ ចំពោះ ធនាគារ ជី ប ម៉ុង ដែល គោរព បាន ខ្ជាប់ខ្ជួន និង ប្រតិបត្តិ មេត្រី បរិស្ថាន បាន ល្អ ប្រសើរ រហូត ទទួលបាន បណ្ណ សរសើរ នេះ ៕
ក្រសួង សុខាភិបាល អាហ្រ្វិក ខាងត្បូង បាន ប្រកាស ថា លទ្ធផល ធ្វើតេស្ត លើ ករណី សង្ស័យ មួយ នៃ អ្នក ឆ្លង ជំងឺ COVID-19 ដោយ វិទ្យាស្ថាន ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ ឆ្លង នៅក្នុង ប្រទេស របស់ ខ្លួន បាន ចេញមកវិជ្ជមាន ។ អ្នកជំងឺ ម្នាក់ នោះ គឺជា បុរស អាយុ ៣៨ ឆ្នាំ និង ជា ជនជាតិ អាហ្រ្វិក ខាងត្បូង ផ្ទាល់ ដែល ទើបតែ ត្រឡប់ ពី អ៉ីតាលី មកដល់ ប្រទេស ខ្លួន វិញ កាលពី ថ្ងៃទី ០១ ខែមីនា ។
ប្រាសាទ ពណ្ណ រាយ នៅលើ ភ្នំ ធ្វើ បុណ្យ ស្រុក កំពង់លែង ខេត្ត កំពង់ឆ្នាំង ហាក់ មិន សូវ មាន ភ្ញៀវ ទៅ ទស្សនា កំសាន្ត
អ្វី ដែល កំពុង ព្រួយបារម្មណ៍ បន្ថែម ទៀត នោះ គឺ នៅ តាម ជ្រុង នៃ កាំ ជណ្តើរ ឡើង លើ កំពូល ភ្នំ គេ ឃើញ មាន ស្នាម បាក់បែក ខ្លះ ៗ ដែល កន្លងមក មាន ជន ខិល ខូច បាន លួច ឡើង កាប់ ដើមឈើ លើ ភ្នំ រួច អូស ទម្លាក់ តាម កាំ ជណ្តើរ ទើប បណ្តាល អោយ បាក់បែក ដូច្នេះ ។
លោក សំ ចាន់ ថន អភិបាល ស្រុក កំពង់លែង បាន សុំ អំពាវនាវ ផងដែរ ដល់ អាជ្ញាធរ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ សូម មេត្តា ជួយ ថែរក្សា ព្រៃឈើ នៅលើ ប្រាសាទ អោយ បាន គង់វង្ស ល្អ ដើម្បី ជា ប្រយោជ ន៍ សំរាប់ ភ្ញៀវ ទេសចរណ៍ មក លេង កំសាន្គ និង គ្រាន់ បាន ជា ម្លប់ សម្រាប់ ជ្រកកោន និង ត្រូវ ចូលរួម ទប់ ស្កាត់ បង្ក្រាប អោយ បាន នូវ ជន ខិលខូច ដែល លួច កាប់ ដើមឈើ នៅលើ ភ្នំ ធ្វើ បុណ្យ នេះ យកមក បម្រើ ផលប្រយោជន៍ រ ផ្ទាល់ខ្លួន ។
លោក សុខ ធួក ប្រធាន មន្ទីរ វប្បធម៌ និង វិចិត្រ សិល្បៈ ខេត្ត កំពង់ឆ្នាំង បាន បញ្ជាក់ ឲ្យដឹង នៅ រសៀល ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២០ នេះ ថា ប្រាសាទ ពណ្ណ រាយ នេះ គឺ បាន កសាងឡើង ដោយ បុព្វបុរស ខ្មែរ ក្នុង សតវត្យ ទី៩ គឺ សម័យ អង្គរ ដែល មាន អាយុ កាល ជាង ១ ពាន់ ឆ្នាំ មកហើយ ។
ប្រាសាទ នេះ ខ្លះ ហៅ ប្រសាទ ព្រះពណ្ណ រាយ ឬ ព្រះវិស្នុ ប្រាសាទ នេះ ផងដែរ បាន សាង ពី ដី ឥដ្ឋ ដែល មាន រចនាបទ តួរ ប៉ម៣ រាង បួន ជ្រុង ស្មើ រីឯ ស៊ំ ទ្វារ គឺ ធ្វើ អំពី ថ្ម ភក់ ដោយឡែក តួរ ប៉ម ទាំង ៣នោះ ដោយ រត់ ជួរ ពី ជើង ទៅ ត្បូង និង បែរ មុខ ទៅ ទិស ខាងលិច ប្រាសាទ ពណ្ណ រាយ នេះ ផងដែរ ត្រូវបាន គេ កសាងឡើង ដើម្បី ឧទ្ទិស ទៅដល់ ព្រហ្មញ្ញ សាសនា នៅក្នុង តួរ ប្រាសាទ នេះ ពីមុន មក គេ រកឃើញ មាន ទេវ រូប ភេទ ប្រុស មួយ ព្រះអង្គ ប៉ុន្តែ ទេវរូប នោះ បច្ចុប្បន្ន មិន ដឹង ថា គេ យក តម្កល់ ទុក នៅ ទីណា នោះ ទេ ។
លោក បាន ឲ្យដឹង ទៀត ដែរ ថា បច្ចុប្បន្ន ប្រាសាទ នេះ ត្រូវបាន មើល ការថែទាំ យ៉ាង យកចិត្តទុកដាក់ ផងដែរ ដោយសារតែ ប្រាសាទ នេះ មាន សភាព ទ្រុឌទ្រម ដូច្នេះ ត្រូវតែ មើល ការគាំពារ ដើម្បី កុំ ឲ្យ ប្រាសាទ បាក់ រលំ តែ ប៉ុណ្ណោះ ហើយ ការជួសជុល នោះ យើង មិន ទាន់ បាន ធ្វើ ការជួសជុល នៅឡើយ ទេ ព្រោះ ត្រូវ ចំណាយ ថវិកា ជាច្រើន ផងដែរ ៕ អាជ្ញាធរ ជាតិ អប្សរា ប្រកាស ឱ្យ ភ្ញៀវ ជាតិ - អន្តរជាតិ ចូល ទស្សនា សារមន្ទីរ ចំនួន បី ដោយ ឥត គិត ថ្លៃ ពេញ មួយ ឆ្នាំ
( សៀមរាប ) ៖ ដើម្បី ចូលរួម អបអរសាទរ ខួប ២៥ ឆ្នាំ នៃ ការបង្កើត អាជ្ញាធរ ជាតិ អប្សរា អាជ្ញាធរ ជាតិ អប្សរា នឹង បើក សារ មន្ទីរ ចំនួន បី គឺ សារ មន្ទីរ ព្រះនរោត្តម សីហនុ - អង្គរ សារមន្ទីរ វាយន ភណ្ឌ ប្រពៃណី អាស៊ី សារមន្ទីរឡ តានី ដោយ ឥត គិត ថ្លៃ ឱ្យ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ចូល ទស្សនា ដោយ ឥត គិត ថ្លៃ ចាប់ពី ថ្ងៃទី ៩ ខែមីនា ដល់ បំណាច់ ឆ្នាំ ២០២០ ។
ចំពោះ សមុច្ច័យ សំខាន់ ៗ ដែល បាន តាំង បង្ហាញ នៅក្នុង សារ មន្ទីរ នីមួយ ៗ លោក ឡុង កុសល បញ្ជាក់ ថា នៅ សារមន្ទីរ វាយន ភណ្ឌ ប្រពៃណី អាស៊ី គឺ បាន សហការ ជាមួយ ឥណ្ឌា តាំង បង្ហាញ នូវ ផលិតផល ប្រពៃណី មាន សម្លៀកបំពាក់ ធ្វើ ពី សូត្រ នៅ តាម បណ្តា ប្រទេស ទាំង៦ នៅ ជុំវិញ ដង ទន្ល មេគង្គ ដូចជា ថៃ ឡាវ ភូមា កម្ពុជា វៀតណាម និង ឥណ្ឌា ។
សារ មន្ទីរ នេះ បាន ផ្តល់ នូវ ព័ត៌មាន ដ៏ សំខាន់ ពី ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ ខ្មែរ បុរាណ តាមរយៈ ការប្រើប្រាស់ ភាជន៍ ការរស់នៅ ប្រចាំ ថ្ងៃ របស់ បុព្វបុរស និង ដឹង ថា ពួក គាត់ បាន ផ្តល់ តម្លៃ អ្វី ខ្លះ ក្នុង ទិដ្ឋិភាព សង្គម នា ពេល នោះ ។
ទាំង នេះ ជា ការណ៍ សំខាន់ ណាស់ ដើម្បីឱ្យ សាធារណជន បាន សិក្សា ស្រាវជ្រាវ បណ្តុះ ស្មារតី ស្រឡាញ់ និង ចូលរួម ថែរក្សា សម្បត្តិ វប្បធម៌ ជាតិ ទាំងអស់ គ្នា ។
ក្នុង នាម ជា អ្នកនាំពាក្យ លោក ឡុង កុសល ក៏ បាន អំពាវនាវ ដល់ សាធារណជន សិស្ស និស្សិត ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ពិសេស បណ្តា គ្រឹះស្ថាន សិក្សា អប់រំ នានា សូមអញ្ជើញ ដឹកនាំ សិស្សានុសិស្ស មក ចូលរួម ទស្សនា ឱ្យ បាន ច្រើន កុះករ ហើយ ការមក ទស្សនា ស្វែងយល់ ផ្ទាល់ ជា ផ្នែក មួយ នៃ ការអប់រំ ដ៏ សំខាន់ ដែល សិស្សានុសិស្ស អាចនឹង ទទួលបាន ចំណេះដឹង ថ្មី ដែល មិន ធ្លាប់ ដឹង កន្លងមក ៕
អង្គភាព ប្រឆាំង អំពើពុករលួយ (ACU) បាន ឃាត់ខ្លួន លោក នួន ប៉ុក កាលពី ថ្ងៃទី ០១ ខែមីនា ឆ្នាំ ២០២០ ដោយ ជាប់សង្ស័យ ក្នុង រឿង ពាក់ព័ន្ធ នឹង អំពើពុករលួយ ក្នុង ពេល លោក កាន់ តំណែង ។
លោក នួន ប៉ុក បាន ឡើង កាន់ តំណែង ជា ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ត ព្រះសីហនុ កាលពី ថ្ងៃទី ២៣ ខែមីនា ឆ្នាំ ២០១៦ ។ លោក ត្រូវបាន ផ្ទេរ ចេញ ពី តំណែង នេះ កាលពី ថ្ងៃទី ០១ ខែមីនា ឆ្នាំ ២០១៨ ដោយ កាន់ តំណែង បាន ២ឆ្នាំ ៕
ឧកញ៉ា លី ហួរ ផ្ញើ សារលិខិត អបអរសាទរ និង គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ចំពោះ ការលើកលែង ពន្ធ ប្រថាប់ ត្រា សម្រាប់ អ្នកទិញ ផ្ទះ តម្លៃ ក្រោម ៧ម៉ឺន ដុល្លារ និង សម្រេច បញ្ចុះ ថ្លៃ ផ្ទះ ៥%
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា លី ហួរ ប្រធាន សមាគមន៍ អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន ផ្ញើ លិខិត អបអរសាទរ និង គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ចំពោះ ការសម្រេច លើកលែង ពន្ធ ប្រថាប់ ត្រា សម្រាប់ អ្នកទិញ ផ្ទះ តម្លៃ ក្រោម ៧ម៉ឺន ដុល្លារ ។
លោក ឧកញ៉ា លី ហួរ ចាត់ទុក ការសម្រេច របស់ សម្តេច តេជោ ហ៊ុន សែន គឺជា សក្ខីភាព ដ៏ ពិសេស របស់ សម្តេច ជា ថ្នាក់ដឹកនាំ គំរូ ដែល មាន ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ តែងតែ ព្រួយបារម្ភ យកចិត្តទុកដាក់ គាំទ្រ និង ជួយ ដល់ ជីវភាព ប្រជាពលរដ្ឋ និង វិនិយោគិន កម្ពុជា ។
