( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត បាន ជំរុញ ដល់ មន្ទីរ អង្គភាព និង អាជ្ញាធរ ពាក់ព័ន្ធ ត្រូវ ផ្សព្វផ្សាយ អប់រំ ដល់ ប្រជាពលរដ្ឋ ជុំវិញ បញ្ហា ទុកដាក់ សំរាម និង សម្អាត អនាម័យ បរិស្ថាន ឲ្យ ក្រុង កំពត មាន សោភ័ណភាព និង អនាម័យ ល្អ ដើម្បី ទាក់ទាញ ឱ្យ ភ្ញៀវ ទេសចរ ជាតិ អន្តរជាតិ មក កម្សាន្ត លេង កាន់តែ ច្រើន ឡើង ថែម ទៀត ។
ការជំរុញ បែប នេះ ធ្វើឡើង ខណ: លោក អភិបាល ខេត្ត ដឹកនាំ ក្នុង កិច្ចប្រជុំ ស្ដីពី ការ បន្ត ពង្រឹង និង ជំរុញ ការអនុវត្ត បញ្ហា ការគ្រប់គ្រង ទុកដាក់ សំរាម និង ការសំអាត អនាម័យ បរិស្ថាន ក្រុង កំពត នា ព្រឹក ថ្ងៃទី ៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នៅ សាល ប្រជុំ សាលា ខេត្ត កំពត ដោយ ចូលរួម ពី អ្នក ពាក់ព័ន្ធ ជាច្រើន រូប ។
លោក ជា វ តាយ បាន បញ្ជាក់ បន្ត ទៀត ថា បញ្ហា ការប្រមូល ទុកដាក់ សំរាម ក៏ ដូច បញ្ហា សំអាត អនាម័យ បរិស្ថាន ក្រុង គឺជា បញ្ហា មួយ ដែល អាជ្ញាធរ គ្រប់ ថ្នាក់ ក្នុង មូលដ្ឋាន និង មន្ទីរ ជំនាញ ពាក់ព័ន្ធ ត្រូវតែ មាន ការប្ដេជ្ញាចិត្ត រួម សហការ គ្នា ជាប្រចាំ ក្នុង ការពង្រឹង និង ជំរុញ ការអនុវត្ត អោយ បាន ព្រម គ្នា ដើម្បី ធ្វើឲ្យ ទីក្រុង ប្រកបដោយ ភាពស្រស់បំព្រង និង ធានា បាន នូវ សុខ មាលភាព សាធារណៈ បាន ល្អ ប្រសើរ ជូន ប្រជាពលរដ្ឋ ។
លោក អភិបាល ខេត្ត ក៏ បាន បន្ត ទៀត ថា រយៈពេល កន្លងទៅ បញ្ហា សំរាម នៅក្នុង ក្រុង កំពត ក៏ ដូចជា ឃុំ មួយចំនួន នៃ ស្រុក ទឹក ឈូ ដែល ជាប់ ក្រុង កំពត តាម ការសង្កេតឃើញ ថា មាន ការយកចិត្តទុកដាក់ បាន ល្អ ប្រសើរ ពីសំណាក់ អាជ្ញាធរ មូលដ្ឋាន ក៏ ដូចជា ប្រជាពរដ្ឋ ក៏ប៉ុន្តែ ទោះបី យ៉ាង នេះ ក្ដី បញ្ហា ការគ្រប់គ្រង និង ការប្រមូល សំរាម នៅក្នុង ក្រុង កំពត មាន ការយឺតយ៉ាវ និង មាន ការចោល សម្រាម តាម ដង ផ្លូវ ជាយ ក្រុង កំពត ធ្វើឲ្យ អាជ្ញាធរ មាន ការពិបាក ក្នុង ការគ្រប់គ្រង បញ្ហា សំរាម នេះ ។
បើ តាម ការសង្កេតឃើញ នៅ ប៉ុន្មាន ខែ ចុងក្រោយ នេះ ពិសេស ចាប់ពី ថ្ងៃ បុណ្យ សមុទ្រ ចុង ឆ្នាំ ២០១៩មក បញ្ហា ប្រមូល ទុកដាក់ សំរាម នៅ មាន កម្រិត ហាក់បីដូចជា ធ្លាក់ចុះ នៅ មិន ទាន់ បាន ឆ្លើយតប មាន ប្រសិទ្ធភាព នៅឡើយ ទៅ តាម ភាពជាក់ស្ដែង នៃ បញ្ហា សំរាម និង បញ្ហា សំអាត អនាម័យ បរិស្ថាន តាម ដងផ្លូវ សួន សាធារណៈ នៃ ក្រុង កំពត និង តាម ដងផ្លូវ មួយចំនួន នៅ ជុំវិញ ក្រុង កំពត ដែល តម្រូវ ទាមទារ ឱ្យ យើង រួម សហការ គ្នា បន្ត ពង្រឹង យកចិត្តទុកដាក់ ឲ្យបាន កាន់តែ ខ្លាំងក្លា ល្អ ប្រសើរ ថែម ទៀត ។
អបអរ ទិវា នារី អន្តរជាតិ ៨មីនា ក្រុមការងារ ស្រុក បាភ្នំ ចុះ ជួប សំណេះសំណាល ជាមួយ លោកយាយ និង លោកតា ចាស់ ៗ នៅ មូលដ្ឋាន
ហេតុ នេះ យើង ទាំងអស់ គ្នា ត្រូវ បន្ត រួម សាមគ្គី ការពារ សុខ សន្តិភាព ឱ្យ បាន រឹងមាំ ដោយ ចាប់ផ្តើម ពី ការចូលរួមចំណែក រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ក្នុង មូលដ្ឋាន ចូលរួម រក្សា អនាម័យ តាម គ្រួសារ ដើម្បី បង្ការ ទប់ស្កាត់ ជំងឺ ដង្កាត់ ផ្សេង ៗ លើកស្ទួយ សុខភាព សាធារណៈ ក្នុង សហគមន៍ សំដៅ ជំរុញ ការអភិវឌ្ឍ មូលដ្ឋាន ភូមិ ឃុំ ឱ្យ មាន ចីរភាព ជារៀងដរាប ។
ដោយឡែក ចំពោះ ការវិវដ្ត នៃ ស្ថានការណ៍ ចុងក្រោយ ដែល បណ្តាល មកពី ផល ប៉ះពាល់ ពី ខាងក្រៅ ប្រទេស ពាក់ព័ន្ធ នឹង បញ្ហា Covid-19 និង ការព្យួរ មួយ ផ្នែក នៃ ភាពអនុគ្រោះ ពន្ធ EBA លោក ប្រធាន ក្រុមការងារ ស្រុក បាភ្នំ បាន ធ្វើ ការគូសបញ្ជាក់ ច្បាស់ ពី ជំហរ ទទួលខុសត្រូវ និង ការចាត់ វិធានការចាំបាច់ ប្រកប ដោយ ប្រសិទ្ធភាព របស់ រាជ រដ្ឋាភិបាល ក្នុង ការជំនះ ដោះស្រាយ បញ្ហា ប្រឈម ទាំងអស់ នោះ ឱ្យ ខាងតែ បាន ។
បញ្ហា សំខាន់ នៅ ពេល នេះ គឺ យើង ទាំងអស់ គ្នា ត្រូវ មាន ជំនឿ ជឿជាក់ លើ កំលាំង ខ្លួន ឯង លើ សមត្ថភាព និង បទពិសោធន៍ ដែល យើង ធ្លាប់ ឆ្លងកាត់ កន្លងមក ដែល ច្បាស់ ណាស់ កំលាំង សាមគ្គី ប្រជាជាតិ ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា និង រាជ រដ្ឋាភិបាល កម្ពុជា គឺ ពិតជា អាច ធានា ធ្វើឱ្យ ដំណើរ ជាតិ កម្ពុជា របស់ យើង នៅតែ បន្ត ជំហាន ទៅ មុខ ទៀត យ៉ាង ស្វាហាប់ ក្រោម ម្លប់ សុខ សន្តិភាព នៅលើ ផ្លូវ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស និង នីតិរដ្ឋ ជាក់ ជា មិន ខាន ។
ក្នុង ឱកាស នោះ ក្រុមការងារ ក៏ បាន ជូន អំណោយ ដល់ អ្នកចូលរួម ម្នាក់ ៗ នូវ ខោអាវ ០១ សម្រាប់ និង ប្រាក់ ចំនួន ៥ម៉ឺន រៀល ផងដែរ ៕ សម្ដេច ពញា ចក្រី ហេង សំរិន ថ្វាយ សារ លិខិត ជូន សម្ដេច ម៉ែ ក្នុង ឱកាស អបអរសាទរ ខួប លើក ទី ១០៩ ទិវា អន្ដរជាតិ នារី ០៨មីនា
( ភ្នំពេញ ) ៖ សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន ថ្វាយ សារ លិខិត ជូន សម្ដេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ក្នុង សេរីភាព សេចក្ដីថ្លៃថ្នូរ និង សុភមង្គល ក្នុង ឱកាស អបអរសាទរ ខួប លើក ទី ១០៩ ទិវា អន្ដរជាតិ នារី ០៨មីនា ឆ្នាំ ២០២០ ។
ឆ្លៀត ក្នុង ឱកាស ដ៏ មហាវិសេសវិសាល នេះ ទូលព្រះបង្គំ យើងខ្ញុំ ទាំងអស់ គ្នា សូម សម្ដែង នូវ កតញ្ញតាធម៌ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ គុណូបការៈ ក្នុង ព្រះរាជ សកម្មភាព ដ៏ ឧត្តុង្គឧត្តម ថ្លៃថ្លា និង ទឹក ព្រះទ័យ ប្រកបដោយ ព្រះព្រហ្មវិហារ ធម៌ ដែល ទ្រង់ តែងតែ លះបង់ ព្រះកាយ ពល និង ព្រះបញ្ញា ញាណ ព្រមទាំង ព្រះរាជ ទ្រព្យ ផ្ទាល់ របស់ ទ្រង់ ដើម្បី លើកកម្ពស់ តម្លៃ ស្ដ្រី ក្នុង សង្គមជាតិ ពិសេស ក្នុង វិស័យ មនុស្សធម៌ សង្គមកិច្ច សុខុមាលភាព និង សេចក្ដីសុខ ក្សេមក្សាន្ដ ជូន ប្រជារាស្ដ្រ ខ្មែរ ទូទាំង ប្រទេស ។
នាយកដ្ឋាន ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ឆ្លង ក៏ បាន បញ្ជាក់ ផងដែរ ថា ជុំវិញ ស្ថានភាព សុខភាព របស់ មនុស្ស ៤៤ នាក់ នៅក្នុង ខេត្ត សៀមរាប ដែល បាន ប៉ះពាល់ ដោយ ផ្ទាល់ ៤នាក់ និង ៤០ នាក់ ដោយ ប្រយោល ជាមួយ ជនជាតិ ជប៉ុន ផ្ទុក ជំងឺ កូវីត១៩ ។ បើ តាម នាយកដ្ឋាន ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ឆ្លង បាន ឱ្យដឹង ថា មកដល់ ល្ងាច ថ្ងៃ នេះ មនុស្ស ទាំង ៤៤ នាក់ មាន សុខភាព ល្អ ធម្មតា មិន ទាន់ មាន លេចចេញ រោគសញ្ញា អ្វី នៅឡើយ នោះ ទេ ។
បើ ទោះបីជា យ៉ាង មនុស្ស ទាំង ៤៤ នាក់ បន្ត ដាក់ ឱ្យ នៅ ដាច់ដោយឡែក ពី គេ ចំនួន ១៤នាក់ ដើម្បី តាមដាន សុខភាព ។ មន្ត្រី ជំនាញ របស់ ក្រសួង សុខាភិបាល អាជ្ញាធរដែនដី មន្ត្រី អង្គការ សុខភាព ពិភពលោក (WHO) មជ្ឈមណ្ឌល ប្រយុទ្ធ នឹង ជំងឺ ឆ្លង សហរដ្ឋ អាមេរិក និង វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា កំពុង រួម ធ្វើ ការតាមដាន យ៉ាង ដិតដល់ លើ សុខភាព មនុស្ស ទាំង ៤៤ នាក់ នោះ ៕ រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង៖ ក្រសួង សុខាភិបាល មាន បុគ្គលិក ជា ស្ដ្រី ជិត ៦០% កំពុង បំពេញ ការងារ យ៉ាង សកម្ម ដើម្បី ជួយ ជំរុញ ដល់ វិស័យ សុខាភិបាល
( ភ្នំពេញ ) ៖ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ថ្លែង ថា ស្ដ្រី បាន ដើរ តួនាទី យ៉ាង សំខាន់ ណាស់ ដែល មិន អាច ខ្វះ បាន ឡើយ ក្នុង សង្គម ជាក់ស្ដែង នៅ ក្រសួង សុខាភិបាល មាន បុគ្គលិក ជា ស្ដ្រី សរុប ជិត ៦០ % ដែល បាន នឹង កំពុង បំពេញ ការងារ យ៉ាង សកម្ម ដើម្បី ជួយ ជំរុញ ដល់ វិស័យ សុខាភិបាល មួយ នេះ កាន់តែ មាន ភាពល្អ ប្រសើរ ។
ការថ្លែង ដូច្នេះ របស់ រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង ក្នុង ឱកាស ប្រារព្ធ ពិធី ខួប អនុស្សាវរីយ៍ លើក ទី ១០៩ ទិវា អន្ដរជាតិ នារី ៨មីនា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « មាន សន្ដិភាព មាន ការលើកកម្ពស់ សមភាព យេនឌ័រ » នៅ ទីស្ដីការ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ នេះ ។
រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង បាន ថ្លែង ថា ទិវា អន្ដរជាតិ នារី ៨មីនា ជា ទិវា មួយ ដែល ក្រសួង សុខាភិបាល តែងតែ ប្រារព្ធ ធ្វើឡើង ជារៀងរាល់ ឆ្នាំ ដើម្បី រំលឹក ពី ការតស៊ូ របស់ នារី ដែល ជា ពលករ ទូទាំង សកលក លោក ក្នុង ការទាមទារ សិទ្ធិ សេរីភាព ប្រជាធិបតេយ្យ និង ការអនុវត្ដ សិទ្ធិ ស្មើគ្នា រវាង បុរស និង ស្ដ្រី ។ ម្យ៉ាងទៀត ដើម្បី បញ្ជាក់ ពី ការចូលរួម របស់ ស្ដ្រី ដែល ជា ធនធាន ដ៏ សំខាន់ មិន អាច ខ្វះ បាន នៅក្នុង សង្គម ក្នុង ការចូលរួមចំណែក ឈាន ទៅ អភិវឌ្ឍ ប្រទេសជាតិ ។
ជាពិសេស ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ និង គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី កម្ពុជា បាន នឹង កំពុង យកចិត្ដទុកដាក់ ខ្លាំង ក្នុង ការងារ បញ្ជ្រាប យេនឌ័រ លើ គ្រប់ វិស័យ ទូទាំង កម្ពុជា ។ ជាង នេះ ទៅ ទៀត សម្ដេច តេជោ ក៏ បាន ដាក់ចេញ នូវ គោល នយោបាយ ចំពោះ ស្រ្ដី មាន ផ្ទៃពោះ ជា មន្ដ្រីរាជការ ស៊ីវិល នគរបាល និង យោធា ត្រូវ ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ពី រាជ រដ្ឋាភិបាល ផងដែរ ។ លើស ពី នោះ ក៏ នឹង មាន ប្រាក់ ឧបត្ថម្ភ សម្រាប់ ស្ដ្រី ក្រីក្រ ចាប់តាំងពី ពេល ពរ ពោះ រហូតដល់ ពេល ក្រោយ សម្រាល ផងដែរ ។
ទន្ទឹម នឹង នោះ រដ្ឋមន្រ្ដី សុខាភិបាល បាន ជំរុញ លើកទឹកចិត្ដ និង ស្នើ ដល់ ស្ដ្រី ៗ ត្រូវ ចេះ សាមគ្គី គ្នា ជួយ គ្នា ទៅ វិញ ទៅ មក នៅក្នុង ការបំពេញ ការងារ កាន់តែ ល្អ ប្រសើរ ដើម្បី បង្កើន នូវ ភាព សុខុដុមរមនា បន្ថែម ទៀត នៅក្នុង ស្ថាប័ន ការងារ ៕
បើ តាម អាជ្ញាធរ សុខាភិបាល អ៉ីតាលី ពេញ មួយ ថ្ងៃសុក្រ ម្សិលមិញ ករណី ឆ្លង COVID-19 នៅ ទូទាំង ប្រទេស កើន ដល់ ៤.៦៣៦ ករណី បន្ទាប់ពី ករណី ថ្មី ៗ ៧៧៨ ទៀត ត្រូវបាន រកឃើញ ។ ជា វិធានការ ទប់ស្កាត់ រដ្ឋាភិបាល អ៉ីតាលី បាន សម្រេចចិត្ត បិទ សាលារៀន និង សាកលវិទ្យាល័យ ទាំងអស់ នៅ ទូទាំង ប្រទេស រហូតដល់ ថ្ងៃទី ១៥ ខែមីនា ដែល នេះ មាន ន័យ ថា សិស្ស - និស្សិត ៨. ៥លាន នាក់ ត្រូវ នៅ ស្ថិត នៅក្នុង ផ្ទះ និង មិន អាច ទៅ សាលារៀន របស់ ពួកគេ ។
បន្ថែម ពីលើ នេះ ការប្រកួត បាល់ទាត់ និង ព្រឹត្តិការណ័ កីឡា ដទៃ ទៀត នឹង ត្រូវ ប្រព្រឹត្ត ដោយ គ្មាន អ្នកគាំទ្រ ក្នុង រយៈពេល មួយ ខែ ហើយ ភូមិ ចំនួន ១១ មាន ប្រជាជន ៥០.០០០ នាក់ ត្រូវ ស្ថិត នៅក្រោម ការដាក់ ឱ្យ ដាច់ដោយឡែក ពី គេ សម្រាប់ សប្ដាហ៍ ទី២។ រដ្ឋាភិបាល អ៉ីតាលី កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ បាន បញ្ចេញ កញ្ចប់ ថវិកា ៨. ៤ពាន់ លាន ដុល្លារ ផងដែរ ដើម្បី ស្ដារ ខូចខាត ដែល បង្កឡើង ដោយ COVID-19 ។
គួរ បញ្ជាក់ ថា នៅ ថ្ងៃសុក្រ ម្សិលមិញ នេះ គឺជា ថ្ងៃ ដែល មាន មនុស្ស ស្លាប់ ច្រើន បំផុត ដោយសារតែ COVID-19 នៅ អ៉ីតាលី ។ ដោយឡែក ក្នុង ចំណោម ការឆ្លង ទាំង ៤.៦៣៦ ករណី នោះ មាន អ្នកជំងឺ ៥២៣ នាក់ ហើយ បាន ជាសះស្បើយ ៕ កម្មករ រោងចក្រ តម្បាញ ស្យុង យិន បិទ ផ្លូវ មិន ឲ្យ រថយន្ដ ដឹក ទំនិញ ចេញ ចូល ប៉ះពាល់ ដល់ រោងចក្រ ផ្សេង ទៀត នៅក្បែរ នោះ . កម្មករ ស្នើ អភិបាល ខេត្ត កណ្ដាល ពន្លឿន ការ ដោះស្រាយ
( កណ្ដាល ) ៖ កម្មករ កម្ម ការិនី រោងចក្រ តម្បាញ ស្យុង យិន ( ខេមបូឌា ) ប៊ី ថិក ស្ថាយ៍ មួយ ក្រុម ៣៩ នាក់ បាន នាំគ្នា ឃាត់ ឡាន មិន ឲ្យ ដឹក ទំនិញ ចេញ ពី រោងចក្រ ក្នុង គោលបំណង ទាមទារ ថៅកែ រោងចក្រ បើក ប្រាក់ខែ មករា ឆ្នាំ ២០២០ និង ទាមទារ ឲ្យ កម្មករ មួយចំនួន បាន ចូល ធ្វើ ការវិញ ក្រោយពី បាន បញ្ឈប់ ជា បន្តបន្ទាប់ ។ ការឃាត់ ឡាន ដឹក ទំនិញ ខាងលើ បាន ធ្វើឲ្យ កម្មករ កម្ម ការិនី ក្រុមហ៊ុន មួយ ទៀត ដែល មាន អគារ នៅ ខាងក្នុង ប្តឹង សុំឲ្យ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល ជួយ ពន្លឿន ការ ដោះស្រាយ ។
លោក សំរ៉ុង បូរី លេខាធិការ សហជីព ប្រជាធិបតេយ្យ កាត់ដេរ កម្ពុជា ( ស៊ី ខៅ ឌូ) ប្រចាំ ក្រុមហ៊ុន ស្យុង យិន ( ខេមបូឌា ) ប៊ី ថិក ស្ថាយ៍ បាន ឲ្យដឹង នៅ ល្ងាច ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២០ ថា ក្រុម កម្មករ មួយចំនួន មិន បាន ធ្វើ កូដកម្ម នោះ ទេ ប៉ុន្តែ បាន ឃាត់ ឡាន រោងចក្រ មិន ឲ្យ ដឹក ទំនិញ ចេញ ក្នុង គោលបំណង សំខាន់២ គឺ ទី៖ សុំ ថៅកែ រោងចក្រ បើក ប្រាក់ខែ មករា ឆ្នាំ ២០២០ និង ទី ២៖ ទាមទារ អនុញ្ញាតឲ្យ កម្មករ មួយចំនួន បាន ចូល ធ្វើ ការវិញ ក្រោយពី បាន បញ្ឈប់ ជា បន្តបន្ទាប់ ។
លោក សំរ៉ុង បូរី បន្ត ថា ក្រុម កម្មករ បាន ទាមទារ តាំងពី ពាក់កណ្តាល ខែកុម្ភៈ មក ម្ល៉េះ ហើយក៏ មាន តំណាង មន្ត្រី ក្រសួង ការងារ និង មន្ត្រី មន្ទីរ ការងារ ខេត្ត ចុះ មក ដោះស្រាយ ជាច្រើន លើក តែ ពុំ មាន ដំណោះស្រាយ នៅឡើយ ។ លោក បញ្ជាក់ ថា បើ ពុំ មាន ដំណោះស្រាយ ក្រុម របស់ លោក នឹង នៅតែ ឃាត់ ឡាន ដឹក ទំនិញ ក្រុមហ៊ុន មិន ឲ្យ ចេញ រហូត មាន ដំណោះស្រាយ ។
ពាក្យបណ្ដឹង ដដែល បាន បន្ត ថា ក្រុម កម្មករ ដែល បម្រើ ការងារ នៅ ក្រុមហ៊ុន ញូ ជេនើរេ សិន ថេស្ថាយ ឌីឡុប ម៉ិន ឯ . ក បាន ចូល បម្រើ ការងារ ចាប់ពី ថ្ងៃទី ០១ ខែកុម្ភៈ ឆ្នាំ ២០២០ មាន ទីតាំង អគារ ខាងក្រោយ ក្រុមហ៊ុន ស្យុង យិន ( ខេមបូឌា ) ប៊ី ថិក ស្ថាយ៍ ហើយ ក្រុមហ៊ុន បាន ផលិត ពី ក្រុមហ៊ុន ដែល ជា ផលិតផល សម្រេច រួចហើយ បញ្ជូន ឲ្យ ទៅ ក្រុមហ៊ុន ផ្គត់ផ្គង់ ។
ប៉ុន្តែ ត្រូវបាន ក្រុម សហជីព ប្រជាធិបតេយ្យ កាត់ដេរ កម្ពុជា ( ស៊ី ខៅ ឌូ) ប្រចាំ ក្រុមហ៊ុន ស្យុង យិន ( ខេមបូឌា ) ប៊ី ថិក ស្ថាយ៍ មាន កម្មករ សរុប ៣៩ នាក់ បិទ ច្រក មិន ឲ្យ រថយន្ត ដឹក ទំនិញ ចេញ ចូល បាន ឡើយ ហើយ ការបិទ ផ្លូវ នេះ នៅតែ បន្ត គឺ អាច ធ្វើឲ្យ កម្មករ ជាច្រើន នាក់ ផ្សេង ទៀត បាត់បង់ ការងារ និង បាត់បង់ ប្រាក់ ចំណូល ដើម្បី ចិញ្ចឹម ជីវិត ។
ជាមួយគ្នា នេះ លោក ស្ដើង ម៉ានិត ចៅសង្កាត់ គីឡូម៉ែត្រ លេខ ៦ ខណ្ឌ ឫស្សីកែវ ក៏ បាន ច្រាល ចោល ទាំងស្រុង ចំពោះ គណនី ខាងលើ ដែល បាន ចូលទៅ សរសេរ សារ ក្នុង Facebook របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ចេតនា មិន ល្អ ប៉ះពាល់ ដល់ សន្ដិសុខ សណ្ដាប់ធ្នាប់ ជាតិ ។ លោក បាន បន្ថែម ថា លោក មិន មាន អ្វី ពាក់ព័ន្ធ ជាមួយ ម្ចាស់ គណនី នោះ ឡើយ ហើយ លោក ក៏ មិន ទទួលខុសត្រូវ នូវ អ្វី ដែល គណនី បាន បង្ហោះ នោះ ដែរ ។
លោក ស្ដើង ម៉ានិត បាន សំណូមពរ យ៉ាង ទទូច ដល់ ស្ថាប័ន សមត្ថកិច្ច ពាក់ព័ន្ធ ពិសេស ក្រសួង មហាផ្ទៃ មេត្តា ជួយ ស្រាវជ្រាវ វែក មុខ រក ជន ខិលខូច បង្កើត គណនី Facebook ក្លែងក្លាយ ឈ្មោះ « មានិត ស្ដើង » មួយ នេះ ដែល បាន យក រូប និង ឈ្មោះ របស់ លោក ទៅ ប្រើប្រាស់ ផ្ទុយ ពី ការពិត ផ្សេង ៗ ទៀត ឬ ក្នុង ចេតនា ប្រឆាំង ទាំងស្រុង លើ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១៧លេីក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៨នាក់ របួស ស្រាល ៦នាក់ និង របួស ធ្ងន់ ១៥នាក់ ក្នុង នោះ មិន ពាក់ មួក ២២ នាក់ ។
