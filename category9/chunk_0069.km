( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ក្រុម ក្មេង ទំនើង ប្រើ ដាវ កែច្នៃ ត្រូវបាន ចោទប្រកាន់ ពី បទ ធ្វើឱ្យ ខូចខាត ដោយ ចេតនា មាន ស្ថាន ទម្ងន់ ទោស ។
ក្រុម ក្មេង ទំនើង ខាងលើ បាន កាប់បំផ្លាញ ទៅ លើ ម៉ូតូ របស់ ជនរងគ្រោះ បណ្តាលឱ្យ ខូចខាត ចំនួន ២គ្រឿង រួច ក្រុម ក្មេង ទំនើង ខាងលើ ក៏ បាន នាំគ្នា ជិះ ម៉ូតូ គេចខ្លួន អស់ ។ រហូតមកដល់ ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២៤ កម្លាំង សមត្ថកិច្ច ស្រាវជ្រាវ និង ឃាត់ខ្លួន បាន ជនសង្ស័យ ចំនួន ៦នាក់ ។
ក្រោយពី បាន ទទួល និង ពិនិត្យ លើ សំណុំរឿង នេះ តំណាង អយ្យការសម្រេច ចោទប្រកាន់ លើ ជនសង្ស័យ ទាំង ៦នាក់ ខាងលើ និង បក្ខពួក ពី បទ ធ្វើឱ្យ ខូចខាត ដោយ ចេតនា មាន ស្ថាន ទម្ងន់ ទោស ៕ អភិបាល រង ខេត្ត កំពង់ធំ អំពាវនាវ ដល់ សិស្សានុសិស្ស ដែល ចង់ មាន ជំនាញ មួយ ច្បាស់លាស់ ពិតប្រាកដ ត្រូវ មក សិក្សា រៀនសូត្រ នៅ វិទ្យាស្ថាន បច្ចេកទេស ខេត្ត
( កំពង់ធំ )៖ លោក ញ៉ឹក បាន ខេង អភិបាល រង ខេត្ត កំពង់ធំ បាន អំពាវនាវ ដល់ សិស្សានុសិស្ស ដែល មាន ចង់ ជំនាញ មួយ ច្បាស់លាស់ ពិតប្រាកដ ត្រូវ មក សិក្សា រៀនសូត្រ នៅ វិទ្យាស្ថាន បច្ចេកទេស ខេត្ត កំពង់ធំ ស្ថិត នៅ ភូមិ ព្រៃ បន្លិច សង្កាត់ អាចារ្យលាក់ ក្រុង ស្ទឹង សែន ដើម្បី មាន ឱកាស ចាប់ យក ជំនាញ មួយ ច្បាស់លាស់ មាន សមត្ថភាព ពិត ប្រាកដ ។
លោក ញ៉ឹក បាន ខេង ថ្លែង ក្នុង ពិធី អបអរសាទរ ទិវា ជាតិ អប់រំ បណ្ដុះបណ្ដាល បច្ចេកទេស និង វិជ្ជាជីវៈ លើក ទី៧ ឆ្នាំ ២០២៤ ក្រោម ប្រធានបទ «TVET រៀន ឲ្យ ចប់ ឲ្យ ចេះ ឲ្យ មានន ការងារ » ដោយ មាន ការចូលរួម ពី អាជ្ញាធរ ក្រុង ស្រុក ប្រធាន - អនុប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត សហគ្រាស អង្គការ ដៃគូ រួមទាំង សិស្សានុសិស្ស ជាច្រើន ដែល រៀបចំ ធ្វើឡើង នៅ វិទ្យាស្ថាន ពហុ បច្ចេកទេស ខេត្ត កំពង់ធំ នា ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២៤ ។
លោក ឯក ហៀង នាយក វិទ្យាស្ថាន ពហុ បច្ចេកទេស ខេត្ត កំពង់ធំ បាន លើកឡើង ថា ទិវា ជាតិ អប់រំ បណ្ដុះបណ្ដាល បច្ចេកទេស និង វិជ្ជាជីវៈ លើក ទី៧ នៅ ខេត្ត កំពង់ធំ នេះ គឺ មាន គោលដៅ ក្នុង ការផ្សព្វផ្សាយ ដល់ ជំនាញ វិជ្ជាជីវៈ ទៅដល់ ប្រជាពលរដ្ឋ ក៏ ដូចជា សិស្សានុសិស្ស ដើម្បី កាត់បន្ថយ ភាពក្រីក្រ នៅ តាម មូលដ្ឋាន ។
លោក បន្ត ថា វិទ្យាស្ថា ពហុ បច្ចេកទេស ខេត្ត កំពង់ធំ ជា គ្រឹះ ស្ថរ លើ បណ្ដុះបណ្ដាល បច្ចក ទេស និង វិជ្ជាជីវៈ មួយ ក្នុង ចំណោម គ្រឹះស្ថាន (TVET) របស់ ខេត្ត ទាំង ពេល ដែល ស្ថិត នៅក្រោម ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ វិទ្យាស្ថាន ត្រូវបាន បង្កើតឡើង នៅ ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០០១ តាម យុទ្ធសាស្រ្ត កាត់បន្ថយ ភាពក្រីក្រ របស់ រាជ រដ្ឋាភិបាល ។
លោក បញ្ជាក់ ថា សារៈសំខាន់ នៃ ការអប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ ដែល គាត់ ជា ភាសារ អង់គ្លេស (TVET) ៖
ក្នុង ឱកាស នោះ លោក មុត ចិន្តា បាន លើកឡើង ថា បច្ចុប្បន្ន វិទ្យាស្ថាន មាន អគារ សរុប ចំនួន ៥អគារ អគារ រដ្ឋបាល ១ អគារ សិក្សា ២អគារ អគារ រោង ជាង ១អគារ អគារ អន្ត វាសិកដ្ឋាន ១អគារ និង រោង ជាង ជួសជុល រថយន្ត ២រោង ជាង ។ វិទ្យាស្ថាន មាន នាយក ១រូប នាយក រង ៤រូប ការិយាល័យ ចំនួន ៥ ដេប៉ាតឺ ម៉ង់ ចំនួន ០៦ មាន បុគ្គលិក សរុប ចំនួន ៦៥ នាក់ ស្រី ០៩ នាក់ គ្រូបច្ចេកទេស ជាប់ កិច្ច សិន្យា ០៦ រូប ស្រី ០២ រូប និង បុគ្គលិក អនាម័យ សន្តិសុខ ០៩ រូប ស្រី ០៧ រូប សរុប ៨០ នាក់ ស្រី ១៧នាក់ ។
លោក បាន គូសបញ្ជាក់ ថា វិទ្យាស្ថាន មាន កិច្ចសហការ និង ការចុះអនុសារណៈ យោគយល់ ជាមួយ ស្ថាប័ន បណ្តុះបណ្តាល និង សហគ្រាស ក្រុមហ៊ុន ក្នុង ប្រទេស និង ក្រៅ ប្រទេស ក្នុង នោះ ក្នុង ប្រទេស វិទ្យាស្ថាន ក្រោម ឱវាទ របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ មាន រោងចក្រ សហគ្រាស ក្រុមហ៊ុន សរុប ចំនួន ៣០ ។ ដោយឡែក នៅ ក្រៅ ប្រទេស មាន វិទ្យាស្ថាន បច្ចេកទេស និង សាកលវិទ្យាល័យ នៅ ប្រទេស វៀតណាម ចំនួន ២។ វិទ្យាស្ថាន បច្ចេកទេស នៅ ប្រទេស ចិន ចំនួន ៣ ។
ជាមួយគ្នា នេះ លោក មុត ចិន្តា ក៏ បាន អំពាវនាវ ដល់ ម្ចាស់ អាជីវកម្ម រោងចក្រ សហគ្រាស ក្រុមហ៊ុន និង រូប វន្ត បុគ្គល ដែល មាន ជំនាញ ហើយ មិន ទាន់ មាន សញ្ញាបត្រ សូម ចុះឈ្មោះ ចូលរួម ធ្វើតេស្ត វាយតម្លៃ សមត្ថភាព ដើម្បី ទទួលបាន សញ្ញាបត្រ ។
រួមគ្នា លើកកម្ពស់ និង ការពារ បរិស្ថាន ! កូន ដើម ផ្កា ក្ងោក បាន ចាប់ផ្តើម ដាំ តាម ដងផ្លូវ ជាតិ លេខ ៥ ក្នុង ឃុំ ស្នាម ព្រះ ស្រុក បាកាន ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២៤ ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ មូលដ្ឋាន ឃុំ ស្នាម ព្រះ ស្រុក បាកាន ខេត្ត ពោធិ៍សាត់ បាន យក ដើម ក្ងោក ដាំ តាម សងខាង ផ្លូវ ជាតិ លេខ ៥ ក្នុង ភូមិសាស្ត្រ ឃុំ ដោយ មាន ការចូល ពី អាជ្ញាធរ ស្រុក នគរបាល ប្រជាការពារ ប្រជាពលរដ្ឋ លោកគ្រូ អ្នកគ្រូ និង សិស្សនុសិស្ស មកពី សាលា បឋមសិក្សា អណ្តូង ក្រសាំង សរុប ប្រមាណ ១៥០ នាក់ ។
លោក កែវ រតនៈ រដ្ឋមន្រ្តី ក្រសួង រ៉ែ និង ថាមពល និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ខេត្ត ពោធិ៍សាត់ បាន ផ្តួចផ្តើម ឲ្យ មាន ការដាំ ដើមឈើ តាម ដងផ្លូវ ជាតិ ក្នុង ភូមិសាស្ត្រ ខេត្ត ពោធិ៍សាត់ ដែល មាន ប្រវែង ជិត ១០០ គីឡូម៉ែត្រ ចាប់ពី ព្រំប្រទល់ ខេត្ត កំពង់ឆ្នាំង រហូតដល់ ព្រំប្រទល់ ខេត្ត បាត់ដំបង និង ដាំ តាម ផ្លូវ ជាតិ សំខាន់ ៗ ផ្សេង ទៀត ក្នុង ខេត្ត ។
ក្នុង ឱកាស នោះ លោក បណ្ឌិត ទី នរិន្ទ ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក បាកាន បាន ណែនាំ ឱ្យ ក្រុមការងារ ចុះ ជួយ តាម ឃុំ ដែល នៅជាប់ ផ្លូវ ជាតិ លេខ ៥ ត្រូវ ដាំ ដើមឈើ និង មើល ថែរក្សា ឲ្យ លូតលាស់ បាន ល្អ ។
ក្នុង ឱកាស ដឹកនាំ យុវជន ប្រជាពលរដ្ឋ និង ក្រុមការងារ ដាំ ដើមឈើ នេះ លោក អ៉ឹង អៀង អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក បាកាន និង លោក យ ស មុនីរ៉ាត់ ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ឃុំ ស្នាម ព្រះ បាន លើកឡើង ថា ការដាំ ដើមឈើ ក្នុង ថ្ងៃ នេះ ស្រប ពេល ជាមួយគ្នា នៃ ថ្ងៃ ប្រារព្វ ខួប ៦២ ឆ្នាំ ដែល តុលាការ យុត្តិធម៌ អន្តរជាតិ សម្រេច ឲ្យ កម្ពុជា ជា ម្ចាស់ កម្មសិទ្ធិ លើ ប្រាសាទ ព្រះវិហារ ( ១៥ មិថុនា ១៩៦២ - ១៥ មិថុនា ២០២៤ ) ។
លោក ថា ជាង នេះ ទៀត ការដាំ កូន ឈើ នេះ គឺ ដើម្បី ផ្សារ ភ្ជាប់ ការរស់នៅ ជាមួយ បរិស្ថាន និង ដើម្បី សោភ័ណ្ឌភាព ភូមិ ឃុំ ស្រុក យើង ជាពិសេស គឺ ដើម្បីឲ្យ ប្អូន កុមារា កុមារី យុវជន យល់ ច្បាស់ អំពី សារៈសំខាន់ នៃ ដើមឈើ ។ ជាមួយគ្នា នោះ លោក បាន បំផុស ឲ្យ ប្រជាពលរដ្ឋ សិស្សានុសិស្ស ត្រូវ ធ្វើ ការដាំ ដើមឈើ តាម ផ្ទះ រៀង ៗ ខ្លួន ឲ្យបាន គ្រប់ ផ្ទះ ៕
តាម CENTCOM ប្រព័ន្ធ រ៉ាដា ទាំងនោះ បាន អនុញ្ញាតឱ្យ ក្រុម ហ៊ូទី ដឹកនាំ ការវាយប្រហារ លើកប៉ាល់ ដឹក ទំនិញ និង បំផ្លាញ ការធ្វើ ពាណិជ្ជកម្ម តាម សមុទ្រ ។
គួរ បញ្ជាក់ ថា ក្រុម ឧទ្ទាម ហ៊ូទី ដែល បច្ចុប្បន្ន កំពុង គ្រប់គ្រង ទឹកដី មួយ ផ្នែក ធំ ក្នុង ប្រទេស យេម៉ែន បាន ដឹកនាំ ការវាយប្រហារ លើកប៉ាល់ ដឹក ទំនិញ ក្នុង តំបន់ សមុទ្រ ក្រហម និង ឈូង សមុទ្រ Aden ចាប់តាំងពី ខែវិច្ឆិកា ឆ្នាំ មុន មក ម្ល៉េះ ។ ក្រុម ហ៊ូទី បាន អះអាង ថា ការវាយប្រហារ របស់ ខ្លួន គឺ ដើម្បី បង្ហាញ សាមគ្គីភាព ជាមួយ ប្រជាជន ប៉ាឡេស្ទីន ក្នុង តំបន់ ហ្កាហ្សា ជា ទី ដែល អ៉ី ស្រាអែល កំពុង ធ្វើ សង្រ្គាម ប្រឆំាង ក្រុមហា ម៉ាស ៕
អភិបាល ខេត្ត កែប អំពាវនាវ ពលរដ្ឋ ចូលរួម ដាំ ដើមឈើ ឱ្យ មាន ភាព បៃតង សំដៅ ជួយ កាត់បន្តយ ការប្រែប្រួល អាកាសធាតុ និង ការឡើង កម្ដៅ ផែនដី
( កែប )៖ លោក បណ្ឌិត អភិបាល ខេត្ត សោម ពិសិដ្ឋ បាន អំពាវនាវ បងប្អូន ប្រជាពលរដ្ឋ ក្មួយ ៗ សិស្ស និស្សិត យុវជន ទាំងអស់ ចូលរួម ដាំ ដើមឈើ ទាំងអស់ គ្នា ដើម្បី រួមចំណែក ជួយ ដល់ កម្ពុជា មាន ភាព បៃតង ជួយ កាត់បន្តយ ការប្រែប្រួល អាកាសធាតុ និង ការឡើង កម្ដៅ ផែនដី ។
ការអំពាវនាវ បែប នេះ របស់ លោក បណ្ឌិត សោម ពិសិដ្ឋ បាន ធ្វើឡើង នៅក្នុង ឱកាស អញ្ជើញ ចូលរួម ជា អធិបតីភាព ក្នុង ពិធី ប្រារព្ធ ទិវា បរិស្ថាន ជាតិ និង បរិស្ថាន ពិភពលោក ៥មិថុនា ឆ្នាំ ២០២៤ ក្រោម ប្រធានបទ « ការកែប្រែ គុណភាព ដី រហោស្ថានកម្ម និង ភាពធន់ និង គ្រោះ រាំងស្ងួត » ។ ដែល បាន ប្រារព្ធ ធ្វើឡើង នា ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ នៅ ដែល ឧទ្យាន ខេត្ត កែប ។
នា ឱកាស នោះ លោក អភិបាល ខេត្ត កែប បាន បន្ត ថា ការប្រារព្ធ ទិវា បរិស្ថាន ជាតិ និង បរិស្ថាន ពិភពលោក នេះ ឡើង ក្នុង គោលបំណង បង្កើន ការយល់ដឹង ដល់ សាធារណជន អំពី បញ្ហា បរិស្ថាន សកល ដោយ ជំរុញ ការលើកទឹក ចិត្ត ដល់ ប្រជាពលរដ្ឋ និង សហគមន៍ ឱ្យ ក្លាយទៅជា ភ្នាក់ងារ សកម្ម ប្រកបដោយ ចិរភាព និង ការអភិវឌ្ឍ មេត្រីភាព បរិស្ថាន ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ខេត្ត កែប ត្រូវបាន ទទួលស្គាល់ ជា ខេត្ត ពោរពេញ ដោយ សក្ដានុពល និង ត្រូវបាន វាយតម្លៃ ជា ខេត្ត និរន្តរភាព បរិស្ថាន អាស៊ាន និង ជា ទីក្រុង ឈាន មុខ អាស៊ាន និង ជា គោលដៅ អភិវឌ្ឍន៍ ដោយ ចីរភាព ។ ផ្អែក លើស ក្ដានុពល និង ភាពសម្បូរបែប នៃ ធនធាន ធម្មជាតិ វប្បធម៌ និង ប្រវត្តិសាស្រ្ត ដែល មាន ក្នង តំបន់ ស្រាប់ លោក អភិបាល ខេត្ត បាន លើក បញ្ជាក់ ថា សម្រាប់ ខេត្ត កែប បាន កំណត់ ប៉ូល អភិវឌ្ឍន៍ ចំនួន ៤ រួម មាន៖
( កំពង់ចាម ) ៖ ចរន្ត ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី កំពុង ពុះកញ្ជ្រោល យ៉ាង ខ្លាំង ព្រោះតែ អស់សង្ឃឹម នឹង ជោគវាសនា បក្ស ប្រឆាំង ដែល ចេះតែ បែកបាក់ គ្នា និង គ្មាន គោល នយោបាយ ច្បាស់លាស់ លើ សកម្មភាព នយោបាយ ។
ដោយ អស់សង្ឃឹម ថា នឹង ការបន្ត ជីវិត នយោបាយ ជាមួយ គណបក្ស ប្រឆាំង ថ្នាក់ដឹកនាំ គណបក្ស ប្រឆាំង ទាំង ១១រូប សម្រេច ផ្តាច់ សម្ព័ន្ធ មេត្រីភាព ជាមួយ បក្ស ដែល ខ្លួន ស្ម័គ្រ ស្មោះ ហើយ សុំ ការអនុគ្រោះ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បាន ឱកាស រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា បន្ត សកម្មភាព នយោបាយ ទៅ មុខ បន្ត ទៀត ។
សូម ទស្សនា វីដេអូ បង្ហាញ ពី កោះ ដែល ធំ ៗ ជាង គេ ទាំង១០ នៅលើ ពិភពលោក៖
ការបញ្ចេញ សារ ពិសេស នេះ ធ្វើឡើង ក្នុង ឱកាស លោក ហង់ ជួនណារ៉ុន អញ្ជើញ បើក ជា ផ្លូវការ នូវ ទិវា ជាតិ អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ លើក ទី៧ នា ព្រឹក ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២៤ ក្រោម ប្រធានបទ «TVET រៀន ឱ្យ ចប់ ឱ្យ ចេះ ឱ្យ មាន ការងារ »» ដែល រៀបចំឡើង រយៈពេល ២ ថ្ងៃ នៅ សាល សន្និបាត និង ពិព័រណ៍ កោះ ពេជ្រ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ថ្លែង យ៉ាង ដូច្នេះ ថា « នៅ ពេល ដែល សេដ្ឋកិច្ច កម្ពុជា កាន់តែ ធ្វើ ពិពិធកម្ម ឆ្ពោះ ទៅរក ការប្រើប្រាស់ បច្ចេកវិទ្យា កាន់តែ ខ្ពស់ ដូច្នេះ វិស័យ បណ្ដុះបណ្ដាល បច្ចេកទេស និង វិជ្ជាជីវៈ នឹង ទាមទារ អ្នកជំនាញ កាន់តែ ខ្ពស់ ផងដែរ » ។
លោក រដ្ឋមន្ត្រី បាន បន្ត ថា ការប្រារព្ធ ទិវា ជាតិ លើក ទី៧នេះ ក៏ នឹង ជួយ ជំរុញ ឱ្យ កម្មវិធី បណ្ដុះបណ្តាល ជំនាញ វិជា្ជ ជីវៈ និង បច្ចេកទេស ជូន ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ ១. ៥លាន នាក់ ឱ្យ ទទួលបាន ការចុះឈ្មោះ ចូលរៀន ពីសំណាក់ យុវជន សិស្ស និស្សិត បុគ្គល នៃ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ និង កម្មករ និយោជិត ដើម្បី ទទួលបាន ជំនាញ មួយ ពិតប្រាកដ ដែល អាច យក ទៅ បង្កើត មុខរបរ ផ្ទាល់ខ្លួន ឬ ចូល បម្រើ ការងារ នៅ តាម សហគ្រាស គ្រឹះស្ថាន នានា ។
នៅ ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ថ្នាក់ដឹកនាំ គណបក្ស ភ្លើង ទៀន នៅក្នុង ឃុំ រំចេក ស្រុក ព្រះស្តេច ចំនួន ៣រូប ទៀត ហើយ បាន ប្រកាស ដើរ ចេញពី គណបក្ស ដែល ខ្លួន បាន បម្រើ ជាច្រើន ឆ្នាំ មកហើយ ។ ថ្នាក់ដឹកនាំ គណបក្ស ភ្លើង ទៀន នៅ ឃុំ រំចេក ទាំង៣រូប នេះ បាន ធ្វើ សកម្មភាព នយោបាយ ជាមួយ គណបក្ស ប្រឆាំង យូរ ឆ្នាំ មកហើយ ព្រោះតែ មាន ការជឿជាក់ ថា បក្ស ប្រឆាំង អាច ចូលរួម ដោះស្រាយ បញ្ហា របស់ ជាតិ និង ប្រជាជន ។
បន្ទាប់ពី ធ្វើដំណើរ យូរ ឆ្នាំ ជាមួយ បក្ស ប្រឆាំង ហាក់ មិន ទទួលបាន លទ្ធផល ដូច ការរំពឹងទុក របស់ ខ្លួន នោះ ឡើយ ។ ផ្ទុយទៅវិញ បក្ស ប្រឆាំង ចេះតែ បែកបាក់ សាមគ្គី គ្នា គ្មាន ជំហរ នយោបាយ ច្បាស់លាស់ និង បាន រួមចំណែក អ្វី ក្នុង ដោះស្រាយ បញ្ហា ជាតិ ប្រជាជន ឬ ចូលរួម ក្នុង កិច្ច កសាង ជាតិ នោះ ឡើយ ។
ដោយ អស់សង្ឃឹម ថា នឹង ការបន្ត ជីវិត នយោបាយ ជាមួយ គណបក្ស ប្រឆាំង ថ្នាក់ដឹកនាំ គណបក្ស ភ្លើង ទៀន ក្នុង ឃុំ រំចេក ទាំង៣ រូប សម្រេច ផ្តាច់ សម្ព័ន្ធ មេត្រីភាព ជាមួយ បក្ស ដែល ខ្លួន ស្ម័គ្រ ស្មោះ ហើយ សុំ ការអនុគ្រោះ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បាន ឱកាស រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា បន្ត សកម្មភាព នយោបាយ ទៅ មុខ បន្ត ទៀត ។
ពួកគេ ក៏ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕ ចរន្ត ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង កំពុង ពុះកញ្ជ្រោល ! អនុប្រធាន ក្រុមការងារ គណបក្ស ភ្លើង ទៀន ខេត្ត កែប ប្រកាស ដើរ ចេញពី បក្ស និង សុំ រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា (Video inside)
( កែប )៖ ចរន្ត ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី កំពុង ពុះកញ្ជ្រោល យ៉ាង ខ្លាំង ព្រោះតែ អស់សង្ឃឹម នឹង ជោគវាសនា បក្ស ប្រឆាំង ដែល ចេះតែ បែកបាក់ គ្នា និង គ្មាន គោល នយោបាយ ច្បាស់លាស់ លើ សកម្មភាព នយោបាយ ។
លោក គឹម គង់ អនុប្រធាន ក្រុមការងារ គណបក្ស ភ្លើង ទៀន ក្នុង ខេត្ត កែប ជា បុគ្គល ដែល បាន ធ្វើ សកម្មភាព នយោបាយ ជាមួយ គណបក្ស ប្រឆាំង យូរ ឆ្នាំ មកហើយ ព្រោះតែ មាន ការជឿជាក់ ថា បក្ស ប្រឆាំង អាច ចូលរួម ដោះស្រាយ បញ្ហា របស់ ជាតិ និង ប្រជាជន ។
ដោយ អស់សង្ឃឹម ថា នឹង ការបន្ត ជីវិត និយោបាយ ជាមួយ គណបក្ស ប្រឆាំង លោក គឹម គង់ សម្រេច ផ្តាច់ សម្ព័ន្ធ មេត្រីភាព ជាមួយ បក្ស ដែល ខ្លួន ស្ម័គ្រ ស្មោះ ហើយ សុំ ការអនុគ្រោះ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បាន ឱកាស រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា បន្ត សកម្មភាព នយោបាយ ទៅ មុខ បន្ត ទៀត ។
លោក គឹម គង់ បាន គូសបញ្ជាក់ ថា នៅ ពេល នេះ លោក បាន មើលឃើញ ច្បាស់ ដោយ ឥត សង្ស័យ គណបក្ស ប្រជាជន កម្ពុជា គឺជា បក្ស នយោបាយ តែ មួយ គត់ ដែល មាន គុណ បំណាច់ ដ៏ ធំធេង សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ។ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន ជា មេដឹកនាំ ដ៏ ខ្លាំង ពូកែ ដែល បាន ប្រឹងប្រែង រំដោះ អាយុជីវិត ជាតិ និង ប្រជាជន ពី របប ប្រល័យ ពូជសាសន៍ នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។ ប្រឹងប្រែង បញ្ចប់ សង្គ្រាម បង្រួបបង្រួម ជាតិ និង កសាង ជាតិ ឱ្យ រីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។
លោក គឹម គង់ បន្ត ថា គណបក្ស ប្រជាជន កម្ពុជា ជា គណបក្ស មាន គោល នយោបាយ ច្បាស់លាស់ ក្នុង ការដឹកនាំ ជាតិ និង កសាង ជាតិ ឆ្ពោះ ទៅរក ភាពរុងរឿង ។ ជាពិសេស បក្ស ប្រជាជន កម្ពុជា ជា បង្អែក និង ជា ទី ទុកចិត្ត របស់ ប្រជាពលរដ្ឋ ក្នុង ការធានា រក្សា បាន សុខ សន្តិភាព និង ស្ថេរភាព សង្គម ដែល ជា លក្ខខណ្ឌ ដ៏ ចាំបាច់ សម្រាប់ ធានា នូវ ការ រស់នៅ ប្រកបដោយ ភាពរីករាយ របស់ ប្រជាពលរដ្ឋ ។
អតីត អ្នកស្មោះស្ម័គ្រ បក្ស ប្រឆាំង រូប នេះ បាន ប្រកាស បម្រើ ការពារ ស្ម័គ្រ ស្មោះ ជាមួយ បក្ស ប្រជាជន ដោយ មិន ឆោត ល្ងង់ ជឿ តាម ការអូសទាញ របស់ ក្រុម ប្រឆាំង ជាពិសេស មិន ចាញ់បោក ការអូសទាញ របស់ ក្រុម ប្រឆាំង ក៏ ដូចជា បុគ្គល សម រង្ស៉ី ទៀត នោះ ឡើយ ។
លោក គឹម គង់ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕ អាសូរ ណាស់ ! កុមារី ២នាក់ បាន ឆេះ ស្លាប់ ក្នុង ភ្លើង ចំបើង នៅ ស្រុក កំពង់រោទិ៍ ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ កុមារី ចំនួន ២នាក់ ត្រូវ ជា បងប្អូន ជីដូនមួយ នឹង គ្នា កំពុងតែ លេង នៅក្រោម ជង្រុក ស្រូវ ខណៈ ដែល ជីដូន បង្កាត់ ភ្លើង ដុត សំរាម ក្បែរ ក៏ រាលដាល ឆេះ ដល់ ជង្រុក ស្រូវ រោង ដាក់ ចំបើង បណ្តាលឱ្យ ឆេះ ស្លាប់ បង្កឱ្យ មាន ការភ្ញាក់ផ្អើល ដល់ អ្នកភូមិ នាំគ្នា មក ជួយ បាញ់ ទឹក ពន្លត់ និង មាន ការ អនាគមន៍ ពី សមត្ថកិច្ច យក ឡាន ទឹក មក បាញ់ ពន្លត់ ដែរ តែ ជា អកុសល ក្មេងស្រី ទាំង ២នាក់ បាន ស្លាប់ បាត់បង់ជីវិត ទៅ ហើយ ។
ករណី នេះ បាន កើតឡើង កាល វេលា ម៉ោង ៦និង ០០ នាទី ល្ងាច ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ ស្ថិត ក្នុង ភូមិ ឬ ស្សី ដោច ឃុំ រាជ មន្ទីរ ស្រុក កំពង់រោទិ៍ ។
សមត្ថកិច្ច មូលដ្ឋាន បាន ឱ្យដឹង ថា មាន ករណី ភ្លើង ឆេះ ជង្រុក ស្រូវ និង រោង ចំបើង បណ្ដាលឱ្យ កុមារី ស្លាប់ ២នាក់ គឺ ឈ្មោះ វីន បរមី អាយុ ២ឆ្នាំ . ទី ២៖ ឈ្មោះ ផល រិន ចេន ណា ភេទ ស្រី អាយុ ២ ឆ្នាំ នៅ ភូមិ ឬ ស្សី ដោច ឃុំ រាជ មន្ទីរ ស្រុក កំពង់រោទិ៍ ដែល មាន ឪពុក ឈ្មោះ ផ្លោក ពៅ ណារិន ពេទ្យ មណ្ឌល កំពង់រោទិ៍ ។
សមត្ថកិច្ច បាន បន្ត ថា នៅ មុនពេល កើត ហេតុ ក្មេង រងគ្រោះ ទាំង ២នាក់ បងប្អូន ជីដូនមួយ បាន នាំគ្នា មក អង្គុយ លេង ក្រោម ជង្រុក ស្រូវ ខណៈ នោះ ជីដូន បាន បង្កាត់ ភ្លើង ដុត ស្លាប មាន់ និង សំរាម ដែល នៅក្បែរ នោះ ហើយ ជីដូន ក៏ អង្គុយ ចាក់ រូប ដោយ ភ្លេច គិត ថា ចៅ នៅក្រោម ជង្រុក ស្រូវ ស្រាប់តែ រាលដាល ឆេះ ដល់ ជង្រុក ស្រូវ និង រោង ចំបើង ឆេះ យ៉ាង សន្ធោ សន្ធៅ បណ្ដាលឱ្យ ក្មេង ទាំង ពីរ នាក់ ឆេះ ស្លាប់ តែម្ដង ។
បច្ចុប្បន្ន ក្មេង ទាំង ២នាក់ ត្រូវបាន ក្រុមគ្រួសារ ធ្វើ បុណ្យ តាម ប្រពៃណី ក្តី សោក សង្រេង បំផុត ៕ រដ្ឋមន្ដ្រី ហួត ហាក់ ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ បំពេញ ទស្សនកិច្ច នៅ ទីស្នាក់ការចែកចាយ ហ្គាស របស់ ក្រុមហ៊ុន PV Gas
រដ្ឋមន្ដ្រី ហួត ហាក់ ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ បំពេញ ទស្សនកិច្ច នៅ ទីស្នាក់ការចែកចាយ ហ្គាស របស់ ក្រុមហ៊ុន PV Gas
( ត្បូងឃ្មុំ ) ៖ ក្រុមប្រឹក្សា ខេត្ត ត្បូងឃ្មុំ បើក កិច្ចប្រជុំ សាមញ្ញ លើក ទី១ អាណត្តិ ទី៤ ក្រោម អធិបតីភាព លោក ឡុង ធាម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ ។
លោក អភិបាល ខេត្ត បាន បន្ថែម ថា មួយ វិញទៀត នោះ ដោយ ការអនុវត្ត គោលការណ៍ ណែនាំ និង ការចង្អុលបង្ហាញ ដោយ ផ្ទាល់ ពី ក្រសួង មហាផ្ទៃ ក្រុមប្រឹក្សា ខេត្ត បាន ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ជូន ប្រជាពលរដ្ឋ ចុះ ទប់ស្កាត់ បង្ក្រាប បទល្មើស គ្រប់ ប្រភេទ ជាពិសេស ជំរុញ បណ្តា មន្ទីរ / អង្គភាព ជម នាញ ជុំវិញ ខេត្ត ឱ្យ អនុវត្ត ការងារ ទៅ តាម ជំនាញ នីមួយ ៗ និង ទទួលបាន លទ្ធផល គួរ ជា ទី មោទនៈ ។
ស្ថិត ក្នុង ឱកាស នោះ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាន ផ្តាំផ្ញើ ដល់ ក្រុមប្រឹក្សា ខេត្ត ទាំងអស់ ដែល បាន ជាប់ ឆ្នោត ជា ក្រុមប្រឹក្សា ខេត្ត នា អណត្តិ ថ្មី នេះ ត្រូវ យកចិត្តទុកដាក់ ខិតខំ ប្រឹងប្រែង បំពេញ កិច្ចការងារ ជូន ប្រជាពលរដ្ឋ ជាពិសេស ក្រោយពី ការប្រកាស់ សមាសភាព ក្រុមប្រឹក្សា ខេត្ត បាន ចប់ សព្វគ្រប់ រួចរាល់ សូម ក្រុមប្រឹក្សា ខេត្ត ទាំងអស់ ធ្វើ ការបើក កិច្ចប្រជុំ សាមញ្ញ និង វិសាមញ្ញ ដើម្បី លើក ទិសដៅ អភិវឌ្ឍន៍ បន្ត ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២៤ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៩. ២៤៧ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៦. ១៥២ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ លទ្ធផល នៃ ការចូលរួម របស់ គណៈប្រតិភូ កម្ពុជា ក្នុង កម្មវិធី វេទិកា ថ្នាក់ដឹកនាំ សកល អបអរសាទរ ខួប លើក ទី ៦០ សន្និសីទ សហ ប្រជាជាតិ ស្តីពី ពាណិជ្ជកម្ម និង ការអភិវឌ្ឍ (UNCTAD) នៅ ទីក្រុង ហ្សឺណែវ
នៅ ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ បណ្ឌិត សភាចារ្យ សុក ស៊ី ផាន់ ណា បាន ធ្វើ បទ អន្តរាគមន៍ ពិសេស ក្រោម ប្រធានបទ « ការត្រៀម រៀបចំ សម្រាប់ សេដ្ឋកិច្ច នា ពេល អនាគត - តម្រូវការបន្ទាន់ នៃ ការសម្រេចចិត្ត និង ការធ្វើ សកម្មភាព » ដោយ បាន សង្កត់ធ្ងន់ ទៅ លើ តួនាទី ដ៏ សំខាន់ នៃ ពហុ ភាគី និយម ក្នុង ការដោះស្រាយ បញ្ហា ប្រឈម ជា សកល និង ការឆក់ យក កាលានុវត្តភាព ថ្មី ៗ តាមរយៈ ការធ្វើ ពិពិធកម្ម សេដ្ឋកិច្ច និង បរិវត្ដកម្ម រចនាសម្ព័ន្ធ ។
ក្នុង ការរៀបចំ សម្រាប់ សេដ្ឋកិច្ច នា ពេល អនាគត នេះ បណ្ឌិត សភាចារ្យ សុក ស៊ី ផាន់ ណា បាន អំពាវនាវ ឱ្យ មាន ការធ្វើ ពិពិធកម្ម នៅក្នុង វិស័យ ដែល ទាមទារ ឱ្យ មាន កំណែទម្រង់ គោល នយោបាយ របស់ រដ្ឋាភិបាល ដើម្បី ទាក់ទាញ ការវិនិយោគ ផ្ទាល់ ពី បរទេស (FDI) ការបង្កើន ផលិតភាព តាមរយៈ ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ ដ៏ រឹងមាំ ថាមពល កកើត ឡើងវិញ ការផ្លាស់ប្តូរ បច្ចេកវិទ្យា សេដ្ឋកិច្ច ឌីជីថល និង បញ្ញា សិប្បនិម្មិត (AI) ។
ដោយ កត់សម្គាល់ នូវ ហានិភ័យ ដែល បង្កឡើង ដោយ បម្រែបម្រួល អាកាសធាតុ និង វិបត្តិ បរិស្ថាន ផ្សេង ទៀត បណ្ឌិត សភាចារ្យ បាន អំពាវនាវ ឱ្យ មាន គោល នយោបាយ ពាណិជ្ជកម្ម ប្រកបដោយ ន វានុវត្តន៍ ភាព ដែល រួម បន្ស៊ី គ្នា រវាង ភាព បៃតង និង កំណើន ។ ការរៀបចំ សម្រាប់ សេដ្ឋកិច្ច នា ពេល អនាគត តម្រូវ ឱ្យ មាន សកម្មភាព ជាក់លាក់ យុទ្ធសាស្រ្ត ប្រកបដោយ ន វានុវត្តន៍ និង ការប្តេជ្ញាចិត្ត ឥត ងាក រេ សម្រាប់ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព និង បរិយាប័ន្ន ។
តាមរយៈ ការជម្រុញ សមត្ថភាព នៃ ការផលិត ការទទួលយក បរិវត្តកម្ម រចនាសម្ព័ន្ធ និង ការលើកកម្ពស់ ការធ្វើ ពិពិធកម្ម សេដ្ឋកិច្ច បណ្ឌិត សភាចារ្យ ជឿជាក់ ថា យើង នឹង អាច បង្កើត អនាគត មួយ ដែល ប្រជាជាតិ ទាំងអស់ អាច ធ្វើ ការរីកចម្រើន បាន ។
កិច្ចប្រជុំ ពិភាក្សា ទាំងនេះ បាន ផ្ដោត ទៅ លើ ស្ថានភាព នយោបាយ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម របស់ កម្ពុជា ក៏ ដូចជា កាលានុវត្តភាព នៃ ការវិនិយោគ និង សហប្រតិបត្តិការ ពាណិជ្ជកម្ម ផ្សេង ទៀត នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ៕
រោងចក្រ ចំនួន ៣ នៅ ខេត្ត ស្វាយរៀង និង បាត់ដំបង កំពុង បំពាក់ ប្រព័ន្ធ ស្វ័យ ត្រួតពិនិត្យ ការបញ្ចេញ សំណល់ រាវ ដើម្បី បម្រើ ដល់ កិច្ច គាំពារ បរិស្ថាន
( ភ្នំពេញ ) ៖ រោងចក្រ សហគ្រាស ចំនួន ៣យ៉ាងតិច នៅ ខេត្ត ស្វាយរៀង និង ខេត្ត បាត់ដំបង បាន និង កំពុង បំពាក់ ប្រព័ន្ធ ស្វ័យ ត្រួតពិនិត្យ លើ ការបញ្ចេញ សំណល់ រាវ ដើម្បី ឆ្លើយតប ជាពិសេស នឹង ភាពស្អាត របស់ កម្ពុជា ។
បន្ទាបន្ទាប់មក ក្រុមការងារ បាន ជួប ពិភាក្សា ការងារ បច្ចេកទេស លើ ឧបករណ៍ ស្វ័យ ត្រួតពិនិត្យ ជាមួយ រោងចក្រ TOP SPORTS ។ ដោយឡែក នៅ ថ្ងៃសៅរ៍ ទី ១៥ ខែមិថុនា ឆ្នាំ ២០២៤ ក្រុមការងារ នឹង ចុះ ទៅ ខេត្ត បាត់ដំបង ដើម្បី បំពាក់ ឧបករណ៍ ស្វ័យ ត្រួតពិនិត្យ នៅ តាម រោងចក្រ មួយចំនួន បន្ថែម ទៀត ។
ដើម្បី គ្រប់គ្រង គុណភាព ទឹក បាន ល្អ ប្រសើរ និង ឆ្លើយតប នឹង ការអនុវត្តភាព ស្អាត យុទ្ធសាស្ត្រ ដ៏ សំខាន់ មួយ ក្នុង ចំណោម យុទ្ធសាស្ត្រ ទាំង បី នៃ យុទ្ធសាស្ត្រ ចក្រា វិស័យ បរិស្ថាន គឺ ភាព ស្អាត ភាព បៃតង និង ចីរភាព ។ ភាព ស្អាត ផ្តោត អាទិភាព ចំនួន ៣ គឺ ភាពស្អាត លើ ដី ភាព ស្អាត ផ្ទៃ ទឹក និង ភាពស្អាត លើ អាកាស ។
សូម បញ្ជាក់ ថា ឧបករណ៍ ស្វ័យ ត្រួតពិនិត្យ នេះ ជា ប្រព័ន្ធ ឌីជីថល តាមដាន គុណភាព បរិស្ថាន ពី ទីតាំង ប្រភព បំពុល តាម រោងចក្រ សហគ្រាស ដែល ផ្តល់ ប្រយោជន៍ ជាច្រើន ដល់ កិច្ច គាំពារ បរិស្ថាន ដូច ជា៖
គួរ បញ្ជាក់ ថា កិច្ចប្រជុំ កំពូល ស្ដីពី សន្តិភាព នៅ អ៊ុយក្រែន ក្នុង ប្រទេស ស្វីស នឹង ផ្តោត លើ ចំណុច ចំនួន ៣ ក្នុង ចំណោម ១០ចំណុច នៃ ផែនការ សន្តិភាព របស់ អ៊ុយក្រែន ក្នុង នោះ រួម មាន សន្តិសុខ នុយក្លេអ៊ែរ សន្តិសុខ ស្បៀងអាហារ និង ការដោះលែង ឈ្លើយ សឹក ព្រមទាំង កុមារ អ៊ុយក្រែន ដែល ត្រូវបាន ចាប់ ពង្រត់ ទៅ រុស្ស៉ី ៕
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល ចុះ ពង្រឹង គុណភាព សេវា មន្ទីរពេទ្យ បង្អែក ស្រុក ចំនួន ៨ របស់ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ចាម ជា លើក ទី២
( កំពង់ចាម )៖ ដោយ ទទួលបាន ការណែនាំ ពី សាស្ត្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល . បណ្ឌិត កែរ រដ្ឋា រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង លោក ឱសថការី បាន បុត្តា អនុ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន អញ្ជើញ ចុះ ពង្រឹង គុណភាព សេវា មន្ទីរពេទ្យ បង្អែក ស្រុក ចំនួន ៨ របស់ មន្ទីរ សុខាភិបាល នៃ រដ្ឋបាល ខេត្ត កំពង់ចាម ជា លើក ទី២ ចាប់ពី ថ្ងៃទី ០៥ ដល់ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ ។
មន្ទីរពេទ្យ បង្អែក ស្រុក ទាំង៨ រួម មាន មន្ទីរពេទ្យ បង្អែក បាធាយ មន្ទីរពេទ្យ បង្អែក ជើង ព្រៃ មន្ទីរពេទ្យ បង្អែក ស្រីសន្ធរ មន្ទីរពេទ្យ បង្អែក កោះ សូទិន មន្ទីរពេទ្យ បង្អែក កង មាស មន្ទីរពេទ្យ បង្អែក ព្រៃឈរ មន្ទីរពេទ្យ បង្អែក ស្ទឹងត្រង់ និង មន្ទីរពេទ្យ បង្អែក ចំការលើ ។
អម ដំណើរ ក្រុមការងារ មាន លោក អនុប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត លោក ប្រធាន អនុប្រធាន ការិយាល័យ សុខាភិបាល ស្រុក ប្រតិបត្តិ នីមួយ ៗ និង លោកស្រី អភិបាល រង ស្រុក រដ្ឋបាល នីមួយ ៗ ។
លោក ចាន់ ដានិត ប្រធាន ស្តីទី គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស ភ្លើង ទៀន ក្នុង ខេត្ត ព្រះសីហនុ និង ជា បេក្ខភាព ក្រុមប្រឹក្សា ខេត្ត ព្រះសីហនុ របស់ គណបក្ស ឆន្ទៈ ខ្មែរ ជា បុគ្គល ដែល បាន ធ្វើ សកម្មភាព នយោបាយ ជាមួយ គណបក្ស ប្រឆាំង យូរ ឆ្នាំ មកហើយ ព្រោះតែ មាន ការជឿជាក់ ថា បក្ស ប្រឆាំង អាច ចូលរួម ដោះស្រាយ បញ្ហា របស់ ជាតិ និង ប្រជាជន ។
ដោយ អស់សង្ឃឹម ថា នឹង ការបន្ត ជីវិត និយោបាយ ជាមួយ គណបក្ស ប្រឆាំង លោក ចាន់ ដានិត សម្រេច ផ្តាច់ សម្ព័ន្ធ មេត្រីភាព ជាមួយ បក្ស ដែល ខ្លួន ស្ម័គ្រ ស្មោះ ហើយ សុំ ការអនុគ្រោះ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បាន ឱកាស រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា បន្ត សកម្មភាព នយោបាយ ទៅ មុខ បន្ត ទៀត ។
លោក ចាន់ ដានិត បាន គូសបញ្ជាក់ ថា នៅ ពេល នេះ លោក បាន មើលឃើញ ច្បាស់ ដោយ ឥត សង្ស័យ គណបក្ស ប្រជាជន កម្ពុជា គឺជា បក្ស នយោបាយ តែ មួយ គត់ ដែល មាន គុណ បំណាច់ ដ៏ ធំធេង សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ។ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន ជា មេដឹកនាំ ដ៏ ខ្លាំង ពូកែ ដែល បាន ប្រឹងប្រែង រំដោះ អាយុជីវិត ជាតិ និង ប្រជាជន ពី របប ប្រល័យ ពូជសាសន៍ នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។ ប្រឹងប្រែង បញ្ចប់ សង្គ្រាម បង្រួបបង្រួម ជាតិ និង កសាង ជាតិ ឱ្យ រីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។
លោក ចាន់ ដានិត បន្ត ថា គណបក្ស ប្រជាជន កម្ពុជា ជា គណបក្ស មាន គោល នយោបាយ ច្បាស់លាស់ ក្នុង ការដឹកនាំ ជាតិ និង កសាង ជាតិ ឆ្ពោះ ទៅរក ភាពរុងរឿង ។ ជាពិសេស បក្ស ប្រជាជន កម្ពុជា ជា បង្អែក និង ជា ទី ទុកចិត្ត របស់ ប្រជាពលរដ្ឋ ក្នុង ការធានា រក្សា បាន សុខ សន្តិភាព និង ស្ថេរភាព សង្គម ដែល ជា លក្ខខណ្ឌ ដ៏ ចាំបាច់ សម្រាប់ ធានា នូវ ការ រស់នៅ ប្រកបដោយ ភាពរីករាយ របស់ ប្រជាពលរដ្ឋ ។
លោក ចាន់ ដានិត បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕
បើកបរ កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ១០នាក់ និង របួស ១២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៤ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ១០នាក់ និង របួស ធ្ងន់ ស្រាល ១២នាក់ ។
ប្រធានាធិបតី រុស្ស៊ី លោក វ្លាឌីមៀរ បាន លេច មុខ សា ជា ថ្មី ក្នុង ការធ្វើ សមយុទ្ធ អាវុធ នុយក្លេអ៊ែ័រ តាក់ទិក ក្នុង តំបន់ មួយ ជាប់ នឹង ព្រំដែន អ៊ុយក្រែន ដែល ជា សមយុទ្ធ លើក ទី២ហើយ នៃ ការ បង្ហាញ ភាពប្រុងប្រៀប ត្រៀមលក្ខណៈ ប្រយុទ្ធ របស់ ខ្លួន ជាមួយ សត្រូវ ដោយ ការប្រើប្រាស់ អាវុធ ប្រល័យ លោក នេះ ។
ប្រធានាធិបតី អ៊ុយក្រែន លោក ហ្សេឡិន ស្គី បាន សរសេរ ក្នុង បណ្តាញ សង្គម ថា ឯកសារ នៃ កិច្ច ព្រមព្រៀង នោះ មិន ដែល ធ្លាប់ មាន ពីមុន មក ឡើយ ដែល វា គួរតែ សម្រាប់ មេដឹកនាំ ដទៃ ទៀត ដែល គាំទ្រ ដល់ ប្រទេស អ៊ុយក្រែន ។
អ៊ុយក្រែន នឹង ទទួលបាន លុយ បង្កក ពី ធនធាន ក្រុម សេដ្ឋី រុស្ស៊ី ដើម្បី ប្រឆាំង នឹង រដ្ឋាភិបាល ក្រុង ម៉ូស្គូ វិញ កិច្ចប្រជុំ កំពូល G7 កាលពី ថ្ងៃព្រហស្បតិ៍ បាន យល់ព្រម លើ សំណើ របស់ សហរដ្ឋ អាមេរិក គាំទ្រ លើ ប្រាក់ កម្ចី ៥០ ពាន់ លាន ដុល្លារ សម្រាប់ អ៊ុយក្រែន ដែល ជា លុយ បាន មកពី ការបង្កក ទ្រព្យ សម្បត្តិ របស់ រុស្ស៊ី ។
ទ្រព្យសម្បត្តិ បង្កក ដែល នឹង ផ្តល់ ដល់ ឱ្យ អ៊ុយក្រែន នេះ នៅ មិន ទាន់ ផ្តល់ ភ្លាម នា ពេលនេះ ទេ ប៉ុន្តែ អាច រហូតដល់ ចុង ឆ្នាំ ២០២៤ ប៉ុន្តែ ទោះជា យ៉ាងណា ក៏ដោយ ការយល់ព្រម ឱ្យ ទ្រព្យ របស់ រុស្ស៊ី ដើម្បី វាយ រុស្ស៊ី វិញ នោះ គឺជា ដំណោះស្រាយ សម្រាប់ រយៈពេល វែង ដើម្បី គាំទ្រ ដល់ កិច្ចខិត ខំប្រឹងប្រែង អ៊ុយក្រែន សម្រាប់ ធ្វើ សង្រ្គាម ផង និង សម្រាប់ ការទប់ទល់ ដំណើរ សេដ្ឋកិច្ច ជាតិ របស់ រដ្ឋាភិបាល ក្រុង គៀវ ថែម ទៀត ។
ពិត ណាស់ គ្មាន នរណា ម្នាក់ ជឿ ថា រុស្ស៊ី នឹង អាច ប្រើប្រាស់ អាវុធ នុយក្លេអ៊ែ័រ នោះ ឡើយ ប៉ុន្តែ ខណៈ សង្គ្រាម កាន់តែ វិវត្តន៍ ទៅ មុខ . អាវុធ ទំនើប ថ្មី នានា ដែល មិន ធ្លាប់ បាន ប្រើប្រាស់ ត្រូវបាន បញ្ចេញមក ជា បន្តបន្ទាប់ ។ នា ពេលនេះ រុស្ស៊ី បាន បញ្ចេញ អាវុធ នុយក្លេអ៊ែ័រ តាក់ ទិក របស់ ខ្លួន ជាមួយនឹង ការសមយុទ្ធ ចុងក្រោយ នេះ ចំនួន ២ដង រួច មកហើយ ថែម ទៀត ។ តើ គេ អាច គិត ថា រុស្ស៊ី នឹង មិន ប្រើ អាវុធ នុយ ក្លេអ៊ែ័រ តាក់ ទិក នេះ ទេ ឬ យ៉ាងណា ? ៕
ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខេត្ត ស្ទឹងត្រែង អាណត្តិ ទី៤ ចំនួន ១៧រូប
( ស្ទឹងត្រែង ) ៖ ក្រុមប្រឹក្សា ខេតញ តស្ទឹងត្រែង អាណត្តិ ទី៤ ចំនួន ១៧រូប ត្រូវបាន ប្រកាស ចូលកាន់ តំណែង នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្រោម អធិបតីភាព លោក ប៊ុន ឈឿន
រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ស្ទឹងត្រែង ។
លោក ឈាង ឡាក់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត អាណត្តិ ទី៤ បាន ឡើង ប្តេជ្ញាចិត្ត មាន ចំនួន ៧ចំនុច ហើយ សង្ឃឹម ប្រកបដោយ ភាពជឿជាក់ ថា តាមរយៈ បទពិសោធន៍ ជា ក្រុមប្រឹក្សា ខេត្ត អាណ្តិ ទី៣ កន្លងមក សម្រាប់ អាណត្តិ ទី៤ នេះ នឹង ទទួលបាន ភាពរឹងមាំ និង ការទទួលបាន នូវ គោលការណ៍ ដឹកនាំ ថ្មី ៗ បន្ថែម ទៀត ស្រប តាម ការវិវត្តន៍ នៃ សភាព ការតំបន់ សកលលោក ព្រមទាំង ការរីកចម្រើន ជាក់ស្តែង នៃ សេដ្ឋកិច្ច សង្គម និង ក្របខ័ណ្ឌ ការងារ របស់ ប្រទេសជាតិ ។
លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ស្ទឹងត្រែង បាន លើកឡើង ថា ក្រុមប្រឹក្សា នៃ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ គឺជា ផ្នែក មួយ នៃ អំណាច នីតិប្រតិបត្តិ និង មាន ស្វ័យភាព ក្នុង ក្របខ័ណ្ឌ ដែល កំណត់ ដោយ ច្បាប់ លិខិត បទដ្ឋាន គតិយុត្ត ជាធរមាន ក្នុង ការគ្រប់គ្រង ចាត់ចែង កិច្ចការ មូលដ្ឋាន របស់ ខ្លួន ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ ប្រជាពលរដ្ឋ ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ។
លោក អភិបាល ខេត្ត បាន ឲ្យដឹង ថា កិច្ចការ ជា អាទិភាព បន្ដ សម្រាប់ ក្រុមប្រឹក្សា អាណត្តិ ទី៤ គឺ ការរៀបចំ ផែនការអភិវឌ្ឍន៍ រយៈពេល ៥ ឆ្នាំ និង កម្មវិធី វិនិយោគ ៣ឆ្នាំ រំកិល . ការចូលរួម អនុវត្ត កម្មវិធី កំណែទម្រង់ នានា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា . ការចូលរួម អនុវត្ត កម្មវិធី កំណែទម្រង់ នានា របស់ រាជ រដ្ឋាភិបាល ដែល បាន ដាក់ចេញ នូវ យុទ្ធសាស្ដ្រ បញ្ចកោណ ដំណាក់កាល ទី១ ។
ជាមួយគ្នា នេះ លោក ផៃ ប៊ុន ឈឿន បាន ថ្លែង ថា សមិទ្ធផល សម្រេចបាន នា ពេល កន្លងមក ពិតជា បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការពង្រឹង សន្តិភាព ស្ថិរភាព នយោបាយ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម ហើយ បាន បង្ហាញ ឲ្យ ឃើញ ថា ក្រុមប្រឹក្សា អាណត្តិ ទី៣ គណៈ អភិបាល ខេត្ត ស្ទឹងត្រែង មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ កងកម្លាំង មាន សមត្ថកិច្ច និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ស្ទឹងត្រែង បាន រួម សាមគ្គី សហការ គ្នា ខិតខំ ប្រឹងប្រែង យ៉ាង សកម្ម ក្នុង ការកសាង និង អភិវឌ្ឍន៍ ខេត្ត ឲ្ហ មាន ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ។
( ឧត្តរមានជ័យ )៖ លោក ឃិន ញ៉ាណ អភិបាល រង ខេត្ត ឧត្តរមានជ័យ បាន ជំរុញ ឲ្យ រួមគ្នា អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ក៏ ដូចជា យុទ្ធនាការ សំខាន់ ៗ របស់ រាជ រដ្ឋាភិបាល ក្រសួង មហាផ្ទៃ និង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ សំដៅ កាត់បន្ថយ បទល្មើស គ្រប់ ប្រភេទ ។
ការថ្លែង របស់ ឃិន ញ៉ាណ ក្នុង ឱកាស អញ្ជើញ ជា តំណាង លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ ចូលរួម ក្នុង ពិធី បិទ វគ្គ បណ្តុះបណ្តាល ស្តីពី តួនាទី ភារកិច្ច និង សិទ្ធ របស់ ប្រជាការពារ ដែល រៀបចំ ធ្វើឡើង នៅ សាល ប្រជុំ សាលា ខេត្ត នា ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ដោយ មាន ការចូលរួម ពី មន្ត្រីរាជការ កម្លាំងប្រដាប់អាវុធ អាជ្ញាធរ មូលដ្ឋាន និង អង្គភាព ពាក់ព័ន្ធ ជាច្រើន ទៀត ។
ក្នុង នាម ក្រុមប្រឹក្សា ខេត្ត គណៈ អភិបាល ខេត្ត ឧត្តរមានជ័យ លោក ឃិន ញ៉ាណ បាន ថ្លែង ដោយ ក្តី សោមនស្ស រីករាយ ដោយ បាន ចូលរួម ជាមួយ លោក លោកស្រី ក្នុង ពិធី បិទ វគ្គ បណ្តុះបណ្តាល ស្តីពី តួនាទី ភារកិច្ច និង សិទ្ធ របស់ ប្រជាការពារ ហើយក៏ សូម ចូលរួម អបអរសាទរ ចំពោះ សិក្ខាកាម ទាំងអស់ ដែល បាន បញ្ចប់ វគ្គ បណ្តុះបណ្តាលដ៍ មាន សារៈសំខាន់ នា ពេលនេះ ដោយ ជោគជ័យ ។
លោក បាន បញ្ជាក់ ទៀត ថា ដោយ មាន ការយកចិត្តទុកដាក់ ពី លោក អភិសន្តិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ក៏ ដូចជា ស្នងការដ្ឋាន នគរបាល ខេត្ត ឧត្តរមានជ័យ បាន រៀបចំ វគ្គ បណ្តុះបណ្តាល ដ៏ មាន សារៈសំខាន់ មួយ នេះ ឡើង ជូន ដល់ សិក្ខាកាម មកពី រដ្ឋបាល ក្រុង ស្រុក អធិការដ្ឋាន នគរបាល ក្រុង ស្រុក រដ្ឋបាល ឃុំ សង្កាត់ និង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ឃុំ សង្កាត់ ។
លោក ឃិន ញ៉ាណ ក៏ បាន ថ្លែង ណែនាំ នូវ ចំណុច សំខាន់ ៗ ចំនួន ៣ សម្រាប់ ជា មូលដ្ឋានគ្រឹះ យក ទៅ អនុវត្ត រួម មាន៖
* រួម សាមគ្គី គ្នា ដើម្បី ការពារ « សន្តិភាព » ទោះបីជា ត្រូវ លះបង់ ដោយ តម្លៃ ណាក៍ ដោយ ព្រោះថា យើង បាន ឆ្លងកាត់ ការលំបាក និង ពុះ ពាឧបសគ្គ ច្រើន ណាស់ ទំរាំ តែ ទទួលបាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម ដូច សព្វ ថ្ងៃ
* លើកកម្ពស់ ស្មារតី ទទួលខុសត្រូវ ក្នុង ការធានា គ្រប់គ្រង សភាពការណ៍ ដោយ ផ្តោត លើ៖ការរក្សា សណ្តាប់ធ្នាប់ សាធារណៈ បង្ការ ទប់ស្កាត់ និង ដោះស្រាយ ទំនាស់ នានា នៅ មូលដ្ឋាន ដោយ មិន ទុកឲ្យ រីករាលដាល និង រ៉ាំរ៉ៃ
* ពង្រឹង ខឿន សន្តិសុខ ជាតិ ឯករាជ្យ អធិបតេយ្យភាព ជាតិ បូរណភាព ទឹកដី ទប់ស្កាត់ និង បញ្ជៀស ឲ្យបាន នូវ អំពើ ភាវរកម្ម វិច្ឆេទ កម្ម និង បង្ការ ទប់ស្កាត់ បង្រ្កាប ឲ្យបាន ទាន់ ពេលវេលា នូវ ឧក្រិដ្ឋកម្ម ឆ្លង ដែន គ្រប់ ប្រភេទ ៕ រដ្ឋបាល ខេត្ត ព្រះវិហារ រៀបចំ ពិធី បរិច្ចាក ឈាម ដោយ ស្ម័គ្រចិត្ត ក្រោម ប្រធានបទ « ផ្តល់ ឈាម ផ្តល់ ជីវិត » លើក ទី៣ ក្នុង ឆ្នាំ ២០២៤ នៅ ស្រុក ជ័យ សែន
( ព្រះវិហារ ) ៖ លោក សុខ សាន្ត តារ៉ា អភិបាល រង ខេត្ត ព្រះវិហារ តំណាង លោក គីម រិទ្ធី អភិបាល ខេត្ត នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន ដឹកនាំ មន្ត្រីរាជការ កម្លាំងប្រដាប់អាវុធ អាជ្ញាធរ ស្រុក ជ័យ សែន យុវជន សហភាព សហពន្ធ័កម្ពុជា ស .ស .យ . ក យុវជន កាយ រិទ្ធ យុវជន កាកបាទ ក្រហម ចូលរួម ក្នុង ពិធី បរិច្ចាក ឈាម ដោយ ស្ម័គ្រចិត្ត ក្រោម ប្រធានបទ « ផ្តល់ ឈាម ផ្តល់ ជីវិត » ដែល រៀបចំ ធ្វើឡើង នៅក្នុង បរ វេណ សាលា ស្រុក ជ័យ សែន ។
ក្នុង នាម លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ លោក សុខ សាន្ត តារ៉ា បាន ថ្លែង ដោយ ក្តី សោមនស្ស រីករាយ យ៉ាង ក្រៃលែង ដោយ បាន ចូលរួម ក្នុង ពិធី បរិច្ចាក ឈាម ដោយ ស្ម័គ្រចិត្ត ដើម្បី សង្គ្រោះ អាយុជីវិត ក្រោម ប្រធានបទ « ផ្តល់ ឈាម ផ្តល់ ជីវិត » នៅ ស្រុក ជ័យ សែន នា ឱកាស នេះ ។ លោក ថា ការរៀបចំ បរិច្ចាក ឈាម នេះ គឺជា លើក ទី៣ហើយ ក្នុង ឆ្នាំ ២០២៤ ដោយ លើក ទី១ បាន រៀបចំ ធ្វើឡើង នៅ សាលា ខេត្ត និង លើក ទី២ បាន រៀបចំ ធ្វើឡើង នៅ ស្រុក គូលែន ។
លោក សុខ សាន្ត តារ៉ា ថ្លែង បញ្ជាក់ ទៀត ថា បច្ចុប្បន្ន នេះ ពិនិត្យ ឃើញ ថា មន្ទីរពេទ្យ បង្អែក ១៦មករា ខេត្ត ព្រះវិហារ ពិតជា មាន តម្រូវការ ឈាម ដើម្បី សង្គ្រោះ អាយុជីវិត ជា ចាំបាច់ ដោយ គិត ជា មធ្យម យើង ត្រូវការ ឈាម ប្រចាំ ថ្ងៃ ប្រមាណ ៣ផ្លោក ក្នុង ១ ថ្ងៃ ដើម្បី ជួយ សង្រ្គោះ ជីវិត អ្នកជំងឺ ក្នុង មន្ទីរពេទ្យ ហើយ ការបរិច្ចាក ឈាម ក៏ នៅ មាន កម្រិត ពោលគឺ នៅ ពុំ ទាន់ ឆ្លើយតប ទៅនឹង តម្រូវការ ជាក់ស្តែង និង ស្តង់ដារ របស់ អង្គការ សុខភាព ពិភពលោក នៅឡើយ ។
លោក ថា លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ និង ជា អនុប្រធាន សហព័ន្ធ ភាព សហយុវជន កម្ពុជា ( ស.ស .យ .ក ) បាន ដាក់ចេញ នូវ ផែន ការបរិច្ចាក ឈាម ដើម្បី សង្គ្រោះ អាយុជីវិត ក្រោម ប្រធានបទ « ផ្តល់ ឈាម ផ្តល់ ជីវិត » នៅ មន្ទីរពេទ្យ បង្អែក និង តាម ស្ថាប័ន មន្ទីរ អង្គភាព រដ្ឋបាល ក្រុង ស្រុក ទាំង៨ យ៉ាងហោចណាស់ ១ ខែម្តង ពោលគឺ ក្នុង ១ឆ្នាំ យ៉ាងតិច ១២ដង ។
លោក ពូទីន បាន និយាយ នៅ ថ្ងៃសុក្រ មុន នេះ ថា រុស្ស៊ី នឹង បញ្ចប់ សង្រ្គាម នៅ អ៊ុយក្រែន លុះត្រាតែ ទីក្រុង គៀវ យល់ព្រម បោះបង់ ចោល មហិច្ឆតា ចូលរួម NATO របស់ ខ្លួន ប្រគល់ ទឹកដី ទាំង បួន ខេត្ត ដែល ទីក្រុង ម៉ូស្គូ ទាមទារ និង អនុវត្ត យោធា នីយកម្ម ។
លោក ខូយ រីដា ណែនាំ ដល់ ក្រុមប្រឹក្សា ថ្មី ស្រុក ភ្នំ ក្រវាញ ត្រូវ មាន សាមគ្គីភាព ផ្ទៃក្នុង និង សហការ ល្អ ជាមួយ គណៈ អភិបាល ក្នុង ការអភិវឌ្ឍ ស្រុក ក៏ ដូចជា បម្រើ ពលរដ្ឋ
( ពោធិ៍សាត់ )៖ លោក ខូយ រីដា អភិបាល នៃ គណៈអភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន ណែនាំ ដល់ ក្រុមប្រឹក្សា ស្រុក ភ្នំ ក្រវាញ ទាំង ១៧រូប ដែល ត្រូវ ចូលកាន់ តំណែង ថ្មី ត្រូវ មាន សាមគ្គីភាព ផ្ទៃក្នុង និង សហការ ល្អ ជាមួយ គណៈ អភិបាល ស្រុក ក្នុង កិច្ចការងារ អភិវឌ្ឍ ស្រុក ក៏ ដូចជា បម្រើ ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ប្រសើរ និង ទាន់ ពេល វេលា ។
ធនាគារ ABA បាន ចាត់ទុក ការបង្ហោះ សារ នៅលើ បណ្ដាញ សង្គម ដោយ ប្រឌិត ព័ត៌ នេះ ជាសារ ទុច្ចរិត ជា ព័ត៌មាន ក្លែងក្លាយ បំភ្លៃ ការពិត និង ជា ការបរិហារ កេរ្តិ៍ ទាំងស្រុង ដែល រៀបចំឡើង ដើម្បី ញុះញង់ និង បំភាន់ សាធារណជន ។
ជាមួយគ្នា នេះ ធនាគារ នេះ សូម ស្នើ យ៉ាង ទទូច ឲ្យ សាធារណជន គ្រប់ រូប មេត្តា ចៀសវាង នូវ សកម្មភាព ពាក់ព័ន្ធ នឹង ព័ត៌មាន ក្លែងក្លាយ ទាំងនេះ ។
តាមរយៈ សេចក្ដីបំភ្លឺ នេះ ABA សង្កត់ធ្ងន់ ថា « ក្រោយពី ទទួលបាន ដំណឹង ភ្លាម ធនាគារ យើងខ្ញុំ បាន សហការ ជាមួយ អាជ្ញាធរ ពាក់ព័ន្ធ និង ភ្នាក់ងារ អនុវត្ត ច្បាប់ ដើម្បី ចាត់ វិធានការ ផ្លូវ ច្បាប់ ជាបន្ទាន់ ចំពោះ បុគ្គល ដែល បាន ប្រឌិត ចែកចាយ ព័ត៌មាន ក្លែងក្លាយ នេះ ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ កេរ្ដិ៍ ឈ្មោះ ធនាគារ ABA» ។
ABA បញ្ជាក់ ទៀត ថា យើងខ្ញុំ សូម ជម្រាប ថា ធនាគារ ABA នៅតែ ជា ធនាគារ ពាណិជ្ជ ឈាន មុខ របស់ កម្ពុជា ដែល មាន ស្ថានភាព ហិរញ្ញវត្ថុ រឹងមាំ សមិទ្ធផល កំណើន ដ៏ ល្អ ប្រសើរ និង មាន ភាគ ទុនិក រឹងមាំ ជា ទី ទុកចិត្ត បំផុត ។ សូម បញ្ជាក់ ផងដែរ ថា ប្រតិបត្តិការ របស់ ធនាគារ យើងខ្ញុំ កំពុង ដំណើរការ ជាធម្មតា និង រលូន ហើយ យើងខ្ញុំ នៅតែ ប្ដេជ្ញា យ៉ាង មោះមុត បំផុត ក្នុង ការបម្រើ រាល់ តម្រូវការ សេវា ធនាគារ ជូន ដល់ អតិថិជន គ្រប់ រូប » ។
សូម ជម្រាប ថា ធនាគារ ABA បាន បង្កើតឡើង ក្នុង ឆ្នាំ ១៩៩៦ ដែល មាន រយៈពេល ២៨ ឆ្នាំ ក្នុង វិស័យ ធនាគារ នៅ កម្ពុជា ដោយ បាន ពង្រឹង ខ្លួន យ៉ាង រឹងមាំ ក្នុង ទីផ្សារ ដើម្បី បម្រើ សេវា ជូន ដល់ បណ្ដា អតិថិជន ជាច្រើន ដូចជា សហគ្រាស ធុន តូច និង មធ្យម . អាជីវកម្ម ខ្នាត តូច និង រូប វន្ត បុគ្គល ។
ធនាគារ នេះ ជា បុត្រ សម្ពន្ធ របស់ ធនាគារ ជាតិ កាណាដា ដែល មាន ទ្រព្យ សកម្ម ជាង ៣១៤.៤ ប៊ីលាន ដុល្លារ អាមេរិក គិត ត្រឹម ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២៣ និង មាន បណ្តាញ ធនាគារ ដ៏ ធំ នៅ ទូទាំង ពិភពលោក ៕ ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ចុះ ទស្សនកិច្ច ក្រុមហ៊ុន Memmert ដែល ជា ក្រុមហ៊ុន ឈាន មុខ មួយ ក្នុង ការអភិវឌ្ឍន៍ និង ផលិត ឧបករណ៍ មន្ទីរពិសោធន៍ នៅ អាល្លឺម៉ង់
ក្រោយ ជំនួប ពិភាក្សា ការងារ គណៈប្រតិភូ កម្ពុជា បាន ចុះ ពិនិត្យ រោងចក្រ និង ទស្សនា សាល ផលិតកម្ម របស់ ក្រុមហ៊ុន ដោយ នៅក្នុង នោះ លោក ឧប នាយក រដ្ឋមន្ត្រី បាន បង្ហាញ ចំណាប់អារម្មណ៍ ខ្ពស់ ចំពោះ បច្ចេកវិទ្យា ដែល ក្រុមហ៊ុន ប្រើប្រាស់ ក្នុង ប្រតិបត្តិការ របស់ ខ្លួន ដែល ពុំ បង្ក ផល ប៉ះពាល់ ដល់ បរិស្ថាន ឡើយ ។
ទ្រព្យ មិន មែន ជា សាច់ប្រាក់ នៃ ទ្រព្យ ចំនួន ៩៤៤.៥ លាន ដុល្លារ សិង្ហបុរី នឹង ត្រូវ ដាក់ លក់ នៅក្នុង ការដេញថ្លៃ ហើយ រួម ជាមួយនឹង ទ្រព្យ ជា សាច់ប្រាក់ នឹង ត្រូវ បង្វិល ចូល មូលនិធិ របស់ រដ្ឋ ។
ទោះជា យ៉ាងណា ទ្រព្យ ជាង ២ពាន់ លាន ដុល្លារ សិង្ហបុរី នៅតែ ត្រូវបាន បង្កក ឬ រឹបអូស ប៉ុន្តែ មិន ទាន់ ត្រូវបាន ប្រគល់ ឱ្យ រដ្ឋ នៅឡើយ ។ ឆ្លើយតប នឹង ករណី នេះ នគរបាល សិង្ហបុរី បាន និយាយ ថា ទ្រព្យ ទាំង នេះ ជា របស់ ជន បរទេស ចំនួន ១៧នាក់ ផ្សេង ទៀត ដែល កំពុង ស្ថិត ក្រោម ការស៊ើបអង្កេត ទាក់ទង នឹង ករណី នេះ ។
បើ យោង តាម សេចក្តីរាយការណ៍ ដដែល នេះ មន្ត្រី នគរបាល បាន ឱ្យដឹង ថា ពួកគេ នឹង រក្សាទុក ទ្រព្យ ដែល រឹបអូស បាន នេះ រហូតដល់ មាន ការដោះស្រាយ ដោយ តុលាការ នៅពេល បិទ សំណុំរឿង ។
អ្នកស្រី បាន កត់សម្គាល់ ថា ប្រសិនបើ គ្មាន នរណា ម្នាក់ ត្រូវបាន ចោទប្រកាន់ ពី បទឧក្រិដ្ឋ ពាក់ព័ន្ធ នឹង ទ្រព្យ ទាំងនេះ ទេ នឹង មាន ការអនុវត្តមាត្រា ៣៧៩ នៃ ច្បាប់ នេះ ។
ប្រភព ដែល ស្នើសុំ មិន បញ្ចេញ អត្តសញ្ញាណ ដោយ ការពិភាក្សា ករណី នេះ គឺជា រឿង ឯកជន បាន និយាយ ថា បុគ្គលិក ធនាគារ ឯកជន នៅ តាម ស្ថាប័ន មួយចំនួន ក៏ កំពុង ទទួលបាន ការបណ្តុះបណ្តាល បន្ថែម ផងដែរ ដើម្បី ជួយ ពួកគេ ឱ្យ រកឃើញ ល្បិច ដែល ឧក្រិដ្ឋ ជន ប្រើ ដើម្បី បិទបាំង សាវតា និង ប្រភព មូលនិធិ របស់ ពួកគេ ។
វិធានការ ទាំង នេះ ដែល ធ្វើឡើង ដោយ ស្ម័គ្រចិត្ត បង្ហាញ ពី របៀប ដែល ស្ថាប័ន ផ្តល់ ប្រាក់ កម្ចី កំពុង ព្យាយាម បិទ ចន្លោះប្រហោង ដែល អាច ឱ្យ ក្រុម ឧក្រិដ្ឋ ជន មកពី ប្រទេស ចិន អាច លាង លុយ បាន ជាង ៣ពាន់ លាន ដុល្លារ ពី ល្បែង អនឡាញ តាមរយៈ ស្ថាប័ន ហិរញ្ញវត្ថុ យ៉ាងហោចណាស់ ១៦ នៅក្នុង ប្រទេស សិង្ហបុរី ។
រឿង អាស្រូវ នេះ បាន ធ្វើឱ្យ ខូច មុខមាត់ របស់ ប្រទេស សិង្ហបុរី និង បង្ហាញ ភាព ទន់ខ្សោយ អំពី របៀប ដែល ធនាគារ ក្នុង ស្រុក និង បរទេស និង ក្រុមហ៊ុន ឈ្មួញ ជើង សារ ត្រួតពិនិត្យ អតិថិជន របស់ ពួកគេ ។
( ត្បូងឃ្មុំ ) ៖ លោក វ៉ាន់ វីរៈ ប្រធាន ស្តីទី មន្ទីរព័ត៌មាន ខេត្ត ត្បូងឃ្មុំ បាន ប្តេជ្ញា បន្ត សាមគ្គីភាព ផ្ទៃក្នុង ជា ធ្លុង មួយ បន្ត កិច្ចការងារ ពី អតីត ប្រធាន មន្ទីរព័ត៌មាន ដែល បាន ទទួលមរណៈភាព កាលពី ពេល កន្លងទៅ ថ្មី ៗ នេះ ។
ជាពិសេស បន្ត ប្រមូល ក្តាប់ ព័ត៌មាន ត្រៀម វាយ បក រាល់ ព័ត៌មាន ក្លែងក្លាយ ពិសេស ព័ត៌មាន បំផ្លើស បំភ្លៃ ពីសំណាក់ ក្រុម ប្រឆាំង ដើម្បី បង្ក្រាប បន្សាប និង វាយ បក ឲ្យបាន ទាន់ ពេលវេលា កុំ ឲ្យ មហាជន មាន ការភាន់ច្រលំ ។
លោក វ៉ាន់ វីរៈ ប្រធាន ស្តីទី មន្ទីរព័ត៌មាន ខេត្ត ត្បូងឃ្មុំ ថ្លែង លើកឡើង បែប នេះ ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆមាស១ និង លើក ទិសដៅ ខែកក្កដា ឆ្នាំ ២០២៤ របស់ មន្ទីរព័ត៌មាន ខេត្ត ត្បូងឃ្មុំ ក្រោម អធិបតីភាព លោក ងឿន ច័ន្ទ លីន ប៉ូឡែន អនុ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន ទទួលបន្ទុក ខេត្ត ត្បូងឃ្មុំ នា ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ នៅ សាល ប្រជុំ មន្ទីរ ។
ជាមួយគ្នា នោះ លោក វ៉ាន់ វីរៈ បាន លើកឡើង នូវ បញ្ហា ប្រឈម មួយ ចំនួន ចំពោះ មុខ ពាក់ព័ន្ធ នឹង ការខ្វះខាត ធនធាន មនុស្ស ( មន្ត្រី ក្របខណ្ឌ ) និង សម្ភារៈ បរិក្ខារ បច្ចេកទេស មួយចំនួន ផងដែរ ។
លោក ប្រធាន មន្ទីរ ស្តី ទី ប្តេជ្ញា បន្ត បង្កើន ការផលិត និង ផ្សព្វផ្សាយ ព័ត៌មាន សកម្មភាព ថ្នាក់ដឹកនាំ ខេត្ត និង ថ្នាក់ ជាតិ ពិសេស កន្លែង កំសាន្ត រមណីយដ្ឋាន និង ការអភិវឌ្ឍន៍ នានា របស់ ខេត្ត ត្បូងឃ្មុំ ពិសេស ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី ហ៊ុន ម៉ាណែត ឲ្យ កាន់ ផុស ផុល បន្ថែម ទៀត ជូន ដល់ ស្រទាប់ មហាជន ស្រប តាម ទិស ស្លោក រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន នេត្រ ភក្ត្រា « ថ្មី ពិត លឿន និង ទូលំទូលាយ ប្រកបដោយ ជំនឿ ទុកចិត្ត និង វិជ្ជាជីវៈ ដើម្បី ផ្សារ ភ្ជាប់ គ្រប់ មជ្ឈដ្ឋាន » ។
ជាមួយគ្នា នេះ លោក ងឿន ច័ន្ទ លីន ប៉ូឡែន អនុ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ មន្ទីរព័ត៌មាន ខេត្ត ត្បូងឃ្មុំ ដែល កន្លងមក បាន បំពេញ កិច្ចការងារ យ៉ាង សកម្ម ជាពិសេស ការផ្សព្វផ្សាយ ការប្រយុទ្ធ ប្រឆាំង និង គ្រឿងញៀន ដែល មន្ទីរព័ត៌មាន ខេត្ត បាន ផលិត ជា វីដេអូ សម្ភាសន៍ ប្រជាពលរដ្ឋ ទាក់ទង និង បញ្ហា គ្រឿងញៀន ហើយ ទទួលបាន ការសាទរ យ៉ាង ខ្លាំង ពី ថ្នាក់ដឹកនាំ ខេត្ត ព្រមទាំង ក្រសួង ព័ត៌មាន ផងដែរ ។
លោក ក៏ បាន ធ្វើ ការសំណូមពរ ឲ្យ មាន កិច្ច ខិតខំ ប្រឹងប្រែង បន្ថែម ទៀត ជាពិសេស ធ្វើ ការផ្សព្វផ្សាយ នៅ ព័ត៌មាន ដែល ប្រឆាំង ជាមួយ ព័ត៌មាន ក្លែងក្លាយ ដែល កន្លងមក មាន ប្រព័ន្ធ ផ្សព្វផ្សាយ មួយចំនួន បាន ផ្សព្វផ្សាយ នៅ ព័ត៌មាន មិន ពិត ធ្វើឲ្យ ប៉ះពាល់ ដល់ កិត្តិយស ខេត្ត និង ក្រសួង ស្ថាប័ន ៕ ប្រធានាធិបតី រុស្ស៉ី ពូទីន ដាក់ ចេញ ល លក្ខខណ្ឌ របស់ រុស្ស៉ី សម្រាប់ បញ្ចប់ សង្គ្រាម អ៊ុយក្រែន
( ម៉ូស្គូ) ៖ ប្រធានាធិបតី រុស្ស៊ី លោក វ្ល៉ាឌីមៀ ពូទីន នៅ ថ្ងៃសុក្រ នេះ បាន ដាក់ចេញ នូវ លក្ខខណ្ឌ របស់ រុស្ស៊ី ជា លើក ដំបូង សម្រាប់ បញ្ចប់ សង្គ្រាម នៅ អ៊ុយក្រែន និង ចាប់ផ្តើម ការចរចា សន្តិភាព ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ ។
លោក ពូទីន បាន សង្កត់ ថា គាត់ កំពុង ផ្តល់ ជូន នូវ ការ បញ្ចប់ សង្គ្រាម ប៉ុន្តែ មិន មែន គ្រាន់តែ ផ្អាក សង្គ្រាម ទេ ។
គួរ បញ្ជាក់ ថា គណបក្ស ANC បាន បាត់បង់ សំឡេង គាំទ្រ ភាគ ច្រើន ជា លើក ដំបូង ក្នុង ការបោះឆ្នោត សកល កាលពី ថ្ងៃទី ២៩ ខែឧសភា កន្លងទៅ នេះ ហើយ បាន ចំណាយ ពេល ជាង ២សប្ដាហ៍ ដើម្បី ពិភាក្សា ជាមួយ គណបក្ស ដទៃ ក្នុង ការបង្កើត រដ្ឋាភិបាល ៕ លោក នេត្រ ភក្ត្រា ស្នើ អាជ្ញាធរ និង ពលរដ្ឋ ចូលរួម ការពារ និង អភិរក្ស ធនធាន ធម្មជាតិ នៅក្នុង ខេត្ត ក្រចេះ ឱ្យ បាន គង់វង្ស ពិសេស អភិរក្ស សត្វ កម្រ ៗ ដើម្បី បង្កើត ការងារ ជូន សហគមន៍ ទាញ ផល ចំណូល ពី ទេសចរណ៍ ធម្មជាតិ
( ក្រចេះ ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ក្រចេះ បាន ស្នើ ដល់ អាជ្ញាធរ មាន សមត្ថកិច្ច ទាំងអស់ និង បងប្អូន ប្រជាពលរដ្ឋ ចូលរួម ការពារ និង អភិរក្ស ធនធាន ធម្មជាតិ នៅក្នុង ខេត្ត ក្រចេះ ឱ្យ បាន គង់វង្ស និង ជាពិសេស អភិរក្ស សត្វ កម្រ ៗ ដែល មាន នៅក្នុង ខេត្ត ដូចជា សត្វ ផ្សោត សត្វ ត្មាត សត្វ ក្តាន់ និង សត្វ រុក្ខជាតិ ផ្សេង ៗ ទៀត ដែល មាន ដើម្បី បង្កើត ការងារ ជូន ដល់ សហគមន៍ ទាញ ផល ចំណូល ពី ទេសចរណ៍ ធម្មជាតិ ។
ការស្នើ បែប នេះ របស់ លោក នេត្រ ភក្ត្រា បាន ធ្វើឡើង ក្នុង ពេល ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ រលួស និង ឃុំ ស្រែ ជិះ ស្រុក អូរ គ្រៀង សែន ជ័យ ខេត្ត ក្រចេះ កាលពី ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ កន្លងទៅ នេះ ។
ប្រធាន ក្រុមការងារ បាន ថ្លែង ថា នៅក្នុង ភូមិសាស្ត្រ ស្រុក អូរ គ្រៀង សែន ជ័យ ដែល ជា ស្រុក ទើបនឹង បង្កើត ថ្មី របស់ ខេត្ត ក្រចេះ សម្បូណ៌ ដោយ ធនធាន ធម្មជាតិ ជាពិសេស ដែន ជម្រក សត្វ ព្រៃ សំបូរ ជា ទីតាំង សម្បូណ៌ ដោយ ធនធាន ធម្មជាតិ សត្វ ព្រៃ ជាពិសេស ជា កន្លែង ជម្រក សត្វ ត្មាត ដែល ជា សត្វ កម្រ នៅក្នុង ប្រទេស កម្ពុជា ។
( ភ្នំពេញ ) ៖ សន្និសីទ ស្ដីពី សន្តិភាព អ៊ុយក្រែន បាន ធ្វើឡើង នៅ ប្រទេស ស្វីស នៅ ចុង សប្តាហ៍ នេះ ដោយ មិន មាន វត្តមាន របស់ ប្រទេស រុស្ស៊ី ដែល ជា ភាគី ពាក់ព័ន្ធ នោះ ទេ ខណៈ ប្រទេស កម្ពុជា និង ប្រទេស ជិត ពាក់កណ្តាល ទៀត ក៏ មិន បាន ចូលរួម នោះ ដែរ ។
បើ តាម សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា កម្ពុជា ដែល បាន ប្រកាស កាលពី ថ្ងៃទី ៧ ខែមិថុនា កន្លងទៅ គឺ ការ ដែល កម្ពុជា មិន ចូលរួម សន្និសីទ នេះ ក៏ ព្រោះតែ កម្ពុជា មើល ដឹង ថា សន្និសីទ ស្តីពី សន្តិភាព អ៊ុយក្រែន នេះ នឹង មិន ទទួលបាន ជោគជ័យ ឡើយ ។
ដូច្នេះ ថា តើ សន្និសីទ នេះ អាច ដោះស្រាយ បញ្ហា របស់ អុយ ក្រែន បាន កម្រិត ណា ឬ អាច ស្វែងរក សន្តិភាព ដល់ អ៊ុយក្រែន បាន ឬ ទេ ?
ដើម្បី បកស្រាយ លើ ប្រធានបទ នេះ Fresh Talk បាន រៀបចំ កិច្ចពិភាក្សា មួយ លើ ប្រធានបទ៖ « សន្និសីទ ស្តីពី សន្តិភាព អ៊ុយក្រែន និង ការ មិន ចូលរួម របស់ កម្ពុជា » ដោយ មាន វាគ្មិន ចំនួន ២ រូប ចូលរួម ក្នុង នោះ មាន៖ - លោក បណ្ឌិត យង់ ពៅ អ្នកវិភាគ ភូមិសាស្ត្រ នយោបាយ - លោក ម៉ារ យ៉ារិទ្ធិ អ្នកតាមដាន ព្រឹត្តិការណ៍ នយោបាយ អន្តរជាតិ
តាមរយៈ សារលិខិត នេះ សម្តេច ធិបតី មាន សេចក្តី សោមនស្ស រីករាយ យ៉ាង ក្រៃលែង ដែល បាន ចូលរួម អបអរសាទរ ជាមួយ សាស្ត្រាចារ្យ លោកគ្រូ អ្នកគ្រូ សិក្ខាកាម សិស្ស និស្សិត មាតាបិតា អាណាព្យាបាល កម្មករ និយោជិត និយោជក ដៃគូ អភិវឌ្ឍ និង បងប្អូន ជន រួម ជាតិ ទាំងអស់ ក្នុង ឱកាស ដ៏ មហោឡារិក នៃ ការប្រារព្ធ ទិវា ជាតិ អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ លើក ទី៧ ដែល រៀបចំឡើង នៅ ថ្ងៃទី ១៥ ខែ មិថុនា ឆ្នាំ ២០២៤ ក្រោម ប្រធានបទ «TVET រៀន ឱ្យ ចប់ ឱ្យ ចេះ ឱ្យ មាន ការងារ » ។
ខាងក្រោម នេះ ជា សារលិខិត របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត៖
ចិន ដែល បាន ទាមទារ សិទ្ធិ គ្រប់គ្រង ស្ទើរតែ ទាំងស្រុង លើ តំបន់ សមុទ្រ ចិន ខាងត្បូង ក្នុង នោះ រួមទាំង ផែ្នក ដែល កំពុង ប្រទាញប្រទង់ គ្នា ជាមួយ ហ្វីលីពីន ព្រុយណេ ម៉ាឡេស៊ី តៃវ៉ាន់ និង វៀតណាម បាន ចេញ វិធានការ ថ្មី មួយ អនុវត្ត តាម ច្បាប់ មួយ កាលពី ឆ្នាំ ២០២១ ដែល អនុញ្ញាតឱ្យ ឆ្មាំ សមុទ្រ របស់ ខ្លួន ប្រើប្រាស់ កងកម្លាំងប្រដាប់អាវុធ ប្រឆាំង នឹង ទូក ឬ នាវា បរទេស ដែល បំពាន ចូលក្នុង ដែន ទឹក ដែល ប៉េកាំង អះអាង ថា ជា កម្មសិទ្ធិ របស់ ខ្លួន ។
យ៉ាងណា នេះ ក្ដី ថ្លែង ទៅកាន់ អ្នកសារព័ត៌មាន កាលពី ថ្ងៃសុក្រ ទី ១៤ ខែមិថុនា ប្រមុខ កងកម្លាំងប្រដាប់អាវុធ ហ្វីលីពីន លោក Romeo Brawner បាន គូសបញ្ជាក់ ដូច្នេះ ថា « ជា សារ របស់ យើង ផ្ញើ ទៅកាន់ អ្នកនេសាទ របស់ យើង នោះ គឺ ពួកគេ មិន ត្រូវ ភ័យខ្លាច នោះ ទេ ហើយ ត្រូវ បន្ត ធ្វើ ការ នេសាទ ជាធម្មតា នៅក្នុង តំបន់ សេដ្ឋកិច្ច ផ្ដាច់ មុខ របស់ យើង ។ ពីព្រោះ យើង មាន សិទ្ធិ ក្នុង ការទាញយក ប្រយោជន៍ ពី ធនធាន នៅក្នុង តំបន់ ដូច្នេះ អ្នកនេសាទ របស់ យើង គ្មាន ហេតុផល អ្វី ត្រូវ ភ័យខ្លាច ឡើយ » ។
គួរ បញ្ជាក់ ថា បើ តាម វិធានការ ថ្មី របស់ ចិន ដែល ត្រូវ ចូល ជាធរមាន នៅ ថ្ងៃទី ១៥ ខែមិថុនា នេះ ឆ្មាំ សមុទ្រ ចិន មាន សិទ្ធិ ឃុំ ខ្លួន អ្នក ដែល បំពាន ចូល ដោយ គ្មាន ការអនុញ្ញាត រយៈពេល ៦០ ថ្ងៃ ដោយ ពុំ ចាំបាច់ ឆ្លងកាត់ សវនាការ កាត់ទោស ៕
នៅក្នុង សន្និសីទ សារព័ត៌មាន មួយ កាលពី ខែធ្នូ ឆ្នាំ ២០២៣ លោក ពូទីន ក៏ ធ្លាប់ បាន ឱ្យដឹង ដែរ ថា កងទ័ព រុស្ស៉ី ៦១៧ ០០០ នាក់ កំពុង ប្រយុទ្ធ ក្នុង សង្រ្គាម នៅ អ៊ុយក្រែន ដែល លោក ខាងលិច និង ទីក្រុង កៀវ ចាត់ទុក ថា ជា ការឈ្លានពាន ខុស ច្បាប់ ។ ជាថ្មី ម្ដង ទៀត ក្នុង ជំនួប មួយ ផ្សាយ បន្ត ផ្ទាល់ តាម កញ្ចក់ ទូរទស្សន៍ កាលពី ថ្ងៃសុក្រ លោក ពូទីន បាន គូសបញ្ជាក់ ដូច្នេះ ថា « នៅក្នុង តំបន់ នៃ ប្រតិបត្តិការ យោធា ពិសេស របស់ យើង គឺ មាន កងទ័ព ជិត ៧០០ ០០០ នាក់ » ។
គួរ បញ្ជាក់ ថា រុស្ស៉ី កម្រ នឹង និយាយ ពី ចំនួន កងទ័ព ស្លាប់ និង របួស នៅក្នុង សង្រ្គាម អ៊ុយក្រែន ណាស់ ដោយ កាលពី ខែកញ្ញា ឆ្នាំ ២០២២ មូស្គូ ឱ្យដឹង ថា កងទ័ព របស់ ខ្លួន ៥៩៣៧ នាក់ បាន ស្លាប់ នៅលើ សមរភូមិ ។ ប៉ុន្តែ អ្នកវិភាគ លោក ខាងលិច ជឿ ថា ទាហាន រុស្ស៉ី ស្លាប់ និង រងរបួស មាន ដល់ រាប់ សែន នាក់ ឯណោះ ។ ចំណែក ខាង អ៊ុយក្រែន វិញ លោក ប្រធានាធិបតី ហ្សេលេន ស្គី បាន ឱ្យដឹង កាលពី ខែកុម្ភៈ ឆ្នាំ ២០២៤ ថា កងទ័ព អ៊ុយក្រែន ៣១០០០ បាន ស្លាប់ នៅក្នុង សង្គ្រាម អូសបន្លាយ ពេល ជាង ២ឆ្នាំ មក នេះ ៕
ក្រសួង បញ្ជាក់ ថា សម្ពាធ ទាប គ្របដណ្ដប់ មក លើ ឈូង សមុទ្រ ថៃ ព្រះរាជាណាចក្រ កម្ពុជា ភាគ កណ្តាល នៃ អាង ទន្លេ មេគង្គ និង សមុទ្រ ចិន ខាងត្បូង ។ ស្ថានភាព បែប នេះ នឹង ធ្វើ ឱ្យ៖ ចាប់ពី ថ្ងៃទី ១៥ ដល់ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០២៤ អាកាសធាតុ នៅ កម្ពុជា មាន លក្ខណៈ ដូច ខាងក្រោម៖ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ ដាក់ ឲ្យ នាយ នគរបាល ជាតិ ចំនួន ១៩ រូប ចូលនិវត្តន៍
ខាងក្រោម ជា ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្ស ត្រ៖
( សៀមរាប ) ៖ នៅ រសៀល ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ អង្គភាព ប្រឆាំង អំពើពុករលួយ បាន ចុះ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ជាមួយ ក្រុមហ៊ុន អង្គរ អ៊ិនធើណេសិន ណល អ៊ែរ ផត ស៊ិន វេសម៉ិន ( ខេមបូឌា ) ដើម្បី ចូលរួម អនុវត្ត នូវ គោល នយោបាយ កំណែទម្រង់ ស៊ីជម្រៅ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ពិសេស លើ ការប្រយុទ្ធ ប្រឆាំង អំពើពុករលួយ ទាំង ក្នុង វិស័យ សាធារណៈ និង ឯកជន សំដៅ ធានា នូវ ប្រសិទ្ធភាព តម្លាភាព គណនេយ្យភាព ក្នុង ការប្រកប ធុរកិច្ច និង ការផ្តល់ សេវា សាធារណៈ ឲ្យបាន ល្អ ប្រសើរ ក្នុង គោលដៅ លើកស្ទួយ បរិយាកាស វិនិយោគ អំណោយផល ដល់ ការប្រកួតប្រជែង ដោយ ស្មើភាព និង ការរីកចម្រើន ប្រកបដោយ ចីរភាព នៅ កម្ពុជា ។
ពិធី ចុះ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា នេះ ចុះហត្ថលេខា ដោយ កិត្តិនីតិកោសល បណ្ឌិត ទេសរដ្ឋមន្ត្រី ឱម យិន ទៀង ប្រធាន អង្គភាព ប្រឆាំង អំពើពុករលួយ និង លោក LU WEI ប្រធាន ក្រុមហ៊ុន អង្គរ អិនធើណេសិន ណល អ៊ែរ ផត ស៊ិន វេសម៉ិន ( ខេមបូឌា ) ព្រមទាំង មាន ការចូលរួម ពី គណៈប្រតិភូ គណៈ អធិការកិច្ច វិន័យ បក្ស កុម្មុយនិស្ត ចិន និង គណៈ ត្រួតពិនិត្យ កិច្ចការ រដ្ឋ ចិន ខេត្ត យូណាន និង មន្ទីរ អង្គភាព ស្ថាប័ន ជុំវិញ ខេត្ត សៀមរាប ចូលរួម ផងដែរ ។
ទេសរដ្ឋមន្ត្រី ឱម យិន ទៀង បាន បន្ត ថា ការចុះហត្ថលេខា លើ អនុស្សរណៈ MOU នា ថ្ងៃ នេះ ជា អនុស្សរណៈ នៃ ការយោគយល់ គ្នា MOU ទី១០៦ របស់ អង្គភាព ប្រឆាំង អំពើពុករលួយ ជាមួយ វិស័យ ឯកជន ដែល មាន គោលបំណង រួមគ្នា ទប់ស្កាត់ អំពើពុករលួយ និង មាន វិសាលភាព គ្របដណ្តប់ លើ ក្រុមហ៊ុន ជាង ១០០០ ដែល ជា សមាជិក មកពី សភា ពាណិជ្ជកម្ម គ្រឹះស្ថាន ឯកជន គ្រឹះស្ថាន សាធារណៈ ជាតិ និង បរទេស ។
ទីប្រឹក្សា យុវជន និង យុវជន កាកបាទ ក្រហម កម្ពុជា ១៥០ នាក់ ទទួលបាន វគ្គ បណ្ដុះបណ្ដាល មូលដ្ឋាន ពី នាយក ប្រតិបត្តិ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ លោក ជិន ប៊ុន ធឿន អភិបាល ខណ្ឌ ឬស្សីកែវ និង ជា នាយក ប្រតិបត្តិ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា កាកបាទ ក្រហម កម្ពុជា មាន វគ្គ បណ្តុះបណ្តាល មូលដ្ឋាន សំខាន់ ៗ ៥ចំណុច រួម មាន៖ ១ - ប្រវត្តិ ចលនា បដិរូប គោលការណ៍ គ្រឹះ ទាំង៧ និង កាកបាទ ក្រហម កម្ពុជា ២ - គ្រោះមហន្តរាយ និង ការគ្រប់គ្រង គ្រោះមហន្តរាយ ៣- សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ៤ - តួនាទី និង ភារកិច្ច ទីប្រឹក្សា និង យុវជន កាកបាទ ក្រហម កម្ពុជា ៥ - វិជ្ជា សង្គ្រោះ បឋម ។
ការបញ្ជាក់ របស់ លោក ជិន ប៊ុន ធឿន ធ្វើឡើង ក្នុង ឱកាស លោក អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បើក និង បិទ វគ្គ បណ្តុះបណ្តាល មូលដ្ឋាន របស់ កាកបាទ ក្រហម កម្ពុជា ដែល បាន ដំណើរការ អស់ រយៈពេល ១ ថ្ងៃ ជូន ដល់ ទីប្រឹក្សា យុវជន និង យុវជន កាកបាទ ក្រហម កម្ពុជា ចំនួន ១៥០ នាក់ ( ស្រី ៨៩ នាក់ ) នៅ វិទ្យាល័យ ប្ញស្សីកែវ រាជធានី ភ្នំពេញ នា ល្ងាច ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ ។
លោក ជិន ប៊ុន ធឿន នា ឱកាស បើក វគ្គ បណ្ដុះបណ្ដាល នេះ បាន ពាំនាំ នូវ ប្រសាសន៍ របស់ លោក ឃួង ស្រេង ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ ជាពិសេស ប្រសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ ដល់ លោកគ្រូ អ្នកគ្រូ ទីប្រឹក្សា ក្មួយ ៗ យុវជន និង សិស្សានុសិស្ស ទាំងអស់ ព្រមទាំង សូម កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល នៃ ការបញ្ចប់ វគ្គ នា ថ្ងៃ នេះ ។
លោក ជិន ប៊ុន ធឿន បាន បន្ត ថា ការបើក វគ្គ បណ្តុះបណ្តាល មូលដ្ឋាន នេះ គឺ ដើម្បី ផ្តល់ ចំណេះដឹង ជា មូលដ្ឋាន ក្នុង ការក្លាយ ខ្លួន ជា យុវជន កាកបាទ ក្រហម ពេញ លក្ខណៈ ជាពិសេស បណ្តុះ គំនិត ទឹកចិត្ត និង សេចក្តីស្រលាញ់ ចំពោះ ការងារ មនុស្សធម៌ ដល់ ក្មួយ ៗ យុវជន ទាំងអស់ ដែល ជា ទំពាំង ស្នង ប្ញស្សី និង ជា អ្នក បន្ត វេន សម្រាប់ ប្រទេសជាតិ ទៅ ថ្ងៃ អនាគត ។
លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី បាន សម្តែង ការស្វាគមន៍ យ៉ាង កក់ក្តៅ និង បាន កោតសរសើរ ដល់ អង្គការ ស្នាមញញឹម កម្ពុជា (Smile Cambodia) ចំពោះ ការលះបង់ ទាំង កំលាំង កាយ កំលាំងចិត្ត ពិសេស ធនធាន ថវិកា ក្នុង ការចូលរួម ផ្តល់ សេវា វះកាត់ ជូន ដល់ អ្នកជំងឺ ដែល មាន បញ្ហា មាត់ ឆែប ក្រអូម មាត់ ឆែប និង ពិការភាព មុខមាត់ ផ្សេង ៗ និង ទម្រង់ មុខ ខុស ធម្មតា ។
លើស ពី នេះ លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី បាន សម្តែង ការពេញចិត្ត អំពី ពី អត្ថប្រយោជន៍ នៃ ការផ្តល់ លទ្ធភាព ទទួលបាន ការថែទាំ វះកាត់ ប្រកបដោយ សុវត្ថិភាព និង ប្រសិទ្ធភាព សម្រាប់ ប្រជាពលរដ្ឋ កម្ពុជា ដែល មាន មាត់ ឆែប ក្រអូម មាត់ និង ពិការភាព មុខមាត់ ផ្សេង ៗ និង បាន សម្តែង ការគាំទ្រ អស់ ពី ចិត្ត ចំពោះ បេសកកម្ម របស់ អង្គការ ស្នាមញញឹម កម្ពុជា (Smile Cambodia) ។
( បន្ទាយមានជ័យ )៖ ជើង ក្រោម របស់ បក្ស ប្រឆាំង នៅ តាម មូលដ្ឋាន កំពុង មាន ចរន្ត ដើរ ចេញ ពី បក្ស របស់ ខ្លួន ប្រៀប ដូច ទឹក ជំនន់ នា រដូវ វស្សា ព្រោះតែ ក្តី ខកចិត្ត ខក បំណង បាត់បង់ ជំនឿ ចំពោះ ការដឹកនាំ របស់ ថ្នាក់ដឹកនាំ បក្ស ការបែកបាក់ ខ្ចាត់ខ្ចាយ ក្នុង ចំណោម មេ ដឹកនាំ បក្ស ប្រឆាំង ។ ជាពិសេស ការប្រឆាំង គម្រោង ព្រែក ជីក ហ្វូណន តេជោ ពីសំណាក់ ទណ្ឌិត សម រង្ស៉ី ។
នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ថ្នាក់ដឹកនាំ និង សមាជិក គណៈកម្មាធិការ ប្រតិបត្តិ បក្ស ភ្លើង ទៀន ឃុំ បត់ ត្រង់ ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ ចំនួន ៧រូប ទៀត បាន សម្រេចចិត្ត ដើរ ចេញពី បក្ស ដែល ខ្លួន បាន ស្ម័គ្រ ស្មោះ យូរ ឆ្នាំ មកហើយ ។
