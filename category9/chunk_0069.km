( កំពង់ចាម ) ៖ លោក បណ្ឌិត ម៉ា ឈឿន តំណាងរាស្ត្រ មណ្ឌល កំពង់ចាម និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ ជួយ មូលដ្ឋាន បាន ថ្លែង ថា គណបក្ស ប្រជាជន គឺ កើត ចេញ ពី ទឹកចិត្ត ស្នេហាជាតិ ពិតប្រាកដ ដើម្បី រំដោះ ជាតិ មាតុភូមិ និង ឈរ នៅ ខាង ប្រជាជន រួម សុខ ទុក្ខ ជាមួយគ្នា ។
ការថ្លែង ដូច្នេះ របស់ លោក បណ្ឌិត ម៉ា ឈឿន ក្នុង ឱកាស ដឹកនាំ ការប្រារព្ធ មិទ្ទិញ អបអរសាទរ ខួប ៧៣ ឆ្នាំ ថ្ងៃ កំណើត គណបក្ស ប្រជាជន កម្ពុជា ( ២៨ មិថុនា ១៩៥១ - ២៨ មិថុនា ២០២៤ ) នៅ ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម នា ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ដោយ មាន ការអញ្ជើញ ពី លោកស្រី បណ្ឌិត អ៊ុក ម៉ាលី អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ ជួយ ស្រុក ជើង ព្រៃ ។
ក្នុង ឱកាស នោះ លោក បណ្ឌិត ម៉ា ឈឿន បាន លើកឡើង ពី ប្រវត្តិ នៃ ការបង្កើត គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃ ២៨ មិថុនា ១៩៥១ ដែល ប្រសូត្រ ចេញ ពី ចលនា តស៊ូ របស់ ប្រជាជន កម្ពុជា ដើម្បី ទាមទារ ឯករាជ្យ កម្ពុជា ពី អាណានិគម បារាំង ។ លោក បណ្ឌិត បន្ដ ថា « គណបក្ស ប្រជាជន កើត ចេញ ពី ទឹកចិត្ត ស្នេហាជាតិ ពិតប្រាកដ ដើម្បី រំដោះ ជាតិ មាតុភូមិ ហើយ មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល ជា បង្អែក ដ៏ សំខាន់ សម្រាប់ ការកសាង និង អភិវឌ្ឍន៍ ជាតិ តាំងពី អតីតកាល មកដល់ បច្ចុប្បន្ន និង ទៅ ថ្ងៃ អនាគត » ។
តំណាងរាស្ដ្រ ម៉ា ឈឿន បាន បន្ត ថា គណបក្ស ប្រជាជន កម្ពុជា មាន ឈ្មោះ ដើម ហៅ ថា បក្ស បដិវត្ត កម្ពុជា ។ ចាប់ពី ថ្ងៃបដិសន្ធិ មក គណបក្ស បាន ឆ្លងកាត់ ឧបសគ្គ ការតស៊ូ ដើម្បី ជាតិ ច្រើន រាប់ មិន អស់ ក្រោម ឧត្តម គតិ ដើម្បី ប្រទេសជាតិ និង ប្រជាជន កម្ពុជា ផ្សារភ្ជាប់ ជាមួយ សុខ ទុក្ខ របស់ ប្រជាជន គ្រប់ កាលៈទេសៈ រហូត ទាមទារ ឯករាជ្យ បាន ពេញលេញ នៅ ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ១៩៥៣ ក្រោម ព្រះរាជ បូជនីយកិច្ច របស់ សម្ដេច ព្រះនរោត្តម សីហនុ ព្រះបរម រតន កោដ្ឋ ។
លោក បណ្ឌិត បាន បញ្ជាក់ ថា « ថ្ងៃ រំដោះ ៧មករា គឺជា ថ្ងៃ កំណើត ទី២ របស់ ប្រជាជន កម្ពុជា ជា ថ្ងៃ ដែល បង្កើត ឱ្យ មាន អ្វី ៗ នៅ ថ្ងៃ នេះ ។ ទាំង នេះ គឺជា សច្ចធម៌ ប្រវត្តិសាស្ត្រ ដែល ប្រជាជន កម្ពុជា ពិសេស យុវវ័យ ត្រូវតែ បន្ត ចងចាំ ឱ្យ បាន ជាប់ ជានិច្ច » ។
លោក បណ្ឌិត បាន បន្ត ទៀត ថា ទោះបី មាន កិច្ចព្រមព្រៀង សន្តិភាព ទីក្រុង ប៉ារីស ២៣ តុលា ១៩៩៣ ក៏ ពិត មែន តែ កម្ពុជា មិន ទាន់ ការឯកភាព នៅឡើយ ទេ ព្រោះ កងកម្លាំង ខ្មែរ ក្រហម មិន ចូលរួម ជាមួយ រដ្ឋាភិបាល នៅឡើយ ទេ ។ ដូច្នេះ ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន មគ្គុទ្ទេសក៍ ឆ្នើម បាន ដាក់ចេញ ការអនុវត្ត នយោបាយ ឈ្នះ ឈ្នះ នៅ ឆ្នាំ ១៩៩៨ ទើប ឈាន ទៅរក ការបង្រួបបង្រួម ជាតិ តែ មួយ ឡើងវិញ ។
តំណាងរាស្ដ្រ ម៉ា ឈឿន បាន បន្ថែម ថា គណបក្ស ប្រជាជន កម្ពុជា មាន គោល នយោបាយ ច្បាស់លាស់ មាន កម្មវិធី អប់រំ ពី សតិអារម្មណ៍ មាន ការចាត់តាំង ត្រឹមត្រូវ ចាប់ពីលើ ដល់ ក្រោម ជា គណបក្ស ដែល រឹងមាំ ទាំង នយោបាយ សតិអារម្មណ៍ និង អង្គការ ចាត់តាំង ។
ជាមួយគ្នា នោះ លោក បណ្ឌិត ម៉ា ឈឿន ក៏ បាន រៀបចំ ពី ប្រវត្តិ ក្រុមការងារ គណបក្ស ចុះ ជួយ ស្រុក ជើង ព្រៃ និង ស្រុក បាធាយ ក្នុង នោះ លោក ផ្ទាល់ បាន ចូលរួម បំពេញ ការងារ នៅ ស្រុក បាធាយ បាន ២អាណត្តិ និង នៅ ស្រុក ជើង ព្រៃ បាន ៥អាណត្តិ មកហើយ ។ លោក បណ្ឌិត ក៏ បាន ណែនាំ ដល់ ក្រុមការងារ គណបក្ស សូម បន្ត ធ្វើ សកម្មភាព ដែល ផ្សារភ្ជាប់ ជាមួយ ប្រជាជន បម្រើ ប្រជាជន និង ចូលរួម ថែរក្សា សន្តិភាព ឱ្យ ខាងតែ បាន ដើម្បី បន្ត ការអភិវឌ្ឍ ប្រទេសជាតិ អភិវឌ្ឍ មូលដ្ឋាន ឱ្យ រីកចម្រើន តទៅ មុខ ។
សូម ជម្រាប ថា ក្នុង ឱកាស ប្រារព្ធ មិទ្ទិញ អបអរសាទរ ខួប ៧៣ ឆ្នាំ ថ្ងៃ កំណើត គណបក្ស ប្រជាជន កម្ពុជា ( ២៨ មិថុនា ១៩៥១ - ២៨ មិថុនា ២០២៤ ) នៅ ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម នា ថ្ងៃ នេះ លោក បណ្ឌិត ម៉ា ឈឿន និង លោកស្រី បណ្ឌិត អ៊ុក ម៉ាលី បាន ឧបត្ថម្ភ ថវិកា ដល់ សមាជិក សមាជិកា សរុប ប្រមាណ ចំនួន ១៣លាន ៨៦៤ ពាន់ រៀល ៕
ការវាយប្រហារ ដែល បាន កើតឡើង កាលពី សប្តាហ៍ មុន បាន បង្ក ផល ប៉ះពាល់ ដល់ ទីភ្នាក់ងារ រដ្ឋាភិបាល ជាង ២៣០ រួមទាំង ក្រសួង និង សេវា សាធារណៈ សំខាន់ ៗ មួយចំនួន ដូចជា អន្តោប្រវេសន៍ និង ប្រតិបត្តិការ នៅ អាកាសយានដ្ឋាន ធំ ៗ ជាដើម ។ រដ្ឋាភិបាល បាន បដិសេធ មិន ព្រម បង់ប្រាក់ លោះ ចំនួន ៨លាន ដុល្លារ ដែល ជា ថ្លៃ ស្ដារ ទិន្នន័យ ឡើងវិញ ។
ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ ដែល ចំណាយ ពេល តាក់តែង ៨ ឆ្នាំ ត្រូវបាន ប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ
( ភ្នំពេញ ) ៖ ក្រសួង បរិស្ថាន នៅ រសៀល ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន ប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ បន្ទាប់ពី ចំណាយ ពេល តាក់តែង ចំនួន ៨ឆ្នាំ ។ ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ មាន ១២គន្ថី និង ៨៦៥ មាត្រា ។
ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ ត្រូវបាន គាំទ្រ គំនិត និង ផ្តួចផ្តើម ឱ្យ រៀបចំ ពី ដំបូង ដោយ សម្តេច វិបុល បញ្ញា សុខ អាន ។ ដំណើរការ នៃ រៀបចំ តាក់តែង ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ នេះ គឺ បាន ចំណាយ ពេល យ៉ាង យូរ តាំងពី ឆ្នាំ ២០១៥មក គិត មកទល់ ពេលនេះ មាន រយៈពេល ជិត ៨ ឆ្នាំ ដោយ បាន ប្រជុំ ជាច្រើន លើក ច្រើន សា ជាមួយ បណ្តា ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ។
ពិធី ប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន . លោក បណ្ឌិត ម៉ុង ឫទ្ធី ប្រធាន គណៈកម្មការ ទី៣ នៃ ព្រឹទ្ធសភា និង វត្តមាន រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ និង ថ្នាក់ដឹកនាំ ក្រសួង បរិស្ថាន ជាច្រើន នាក់ ទៀត នាទី ស្ដីការ ក្រសួង បរិស្ថាន ។
គួរឱ្យដឹង ថា ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ ត្រូវបាន សម័យ ប្រជុំ លើក ទី៩ នីតិកាល ទី៦ បាន ធ្វើ ការពិភាក្សា និង អនុម័ត កាលពី ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ សម្ដេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ដោយ មាន វត្តមាន សមាជិក សមាជិកា រដ្ឋសភា ពេល ចាប់ផ្តើម សម័យ ប្រជុំ ចំនួន ១០០ រូប ។
ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ នេះ បំពេញ បន្ថែម និង មាន ភាពស៊ីសង្វាក់ ប្រទាក់ ក្រឡា គ្នា ជាមួយនឹង ច្បាប់ ពាក់ព័ន្ធ នានា ដូចជា ក្រម ព្រហ្មទណ្ឌ ក្រម រដ្ឋប្បវេណី ច្បាប់ ស្តីពី ព្រៃឈើ ច្បាប់ ស្តីពី ជល ផល ច្បាប់ ស្តីពី ការគ្រប់គ្រង និង ការធ្វើ អាជីវកម្ម ធនធាន រ៉ែ ច្បាប់ ភូមិបាល ច្បាប់ ស្ដីពី ទេសចរណ៍ ច្បាប់ ស្តីពី ការគ្រប់គ្រង ធនធាន ទឹក ។ល ។ ក្នុង គោលដៅ បន្ត ជំរុញ ដំណើរការអភិវឌ្ឍន៍ ប្រទេសជាតិ និង ការពង្រឹង នីតិរដ្ឋ ទៅកាន់ ដំណាក់កាល ថ្មី នៅលើ មាគ៌ា ចីរភាព ។
ក្នុង ន័យ នេះ ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ ត្រូវបាន តាក់តែង ឡើង ដោយ ផ្អែក លើ គោលការណ៍ សំខាន់ ៣ រួម មាន ទី១) ៖ លិខិត បទដ្ឋាន គតិយុត្ត ក្នុង វិស័យ បរិស្ថាន និង ធនធាន ធម្មជាតិ ត្រូវបាន ធ្វើ សមាហរណកម្ម . ទី ២៖ លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ នឹង វិស័យ បរិស្ថាន និង ធនធាន ធម្មជាតិ ត្រូវបាន ធ្វើ សុខដុមនីយកម្ម និង ទី៣៖ លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ នានា ត្រូវបាន ធ្វើ ទំនើបកម្ម ឱ្យ ឆ្លើយតប នឹង និន្នាការ វិវត្តន៍ នៃ សង្គម ។
ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ ត្រូវបាន ពិនិត្យ ពិភាក្សា និង កែសម្រួល ជា បន្តបន្ទាប់ យ៉ាង ល្អិតល្អន់ និង ស៊ីជម្រៅ ដោយ ឈរ លើ មូលដ្ឋាន ធាតុ ចូល សំខាន់ ៗ ដែល ទទួលបាន តាមរយៈ ការពិគ្រោះយោបល់ កម្រិត ជំនាញ បច្ចេកទេស និង កម្រិត នយោបាយ ជាមួយ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដៃគូ អភិវឌ្ឍ វិស័យ ឯកជន និង សហគមន៍ មូលដ្ឋាន ។
ដោយ យល់ឃើញ ពី ភាពចាំបាច់ និង អត្ថប្រយោជន៍ នៃ ការផ្សព្វផ្សាយ ក្រម បរិស្ថាន និង ធនធាន ធម្មជាតិ រាជ រដ្ឋាភិបាល ដែល មាន ក្រសួង បរិស្ថាន ជា តំណាង បាន រៀបចំ ធ្វើ ការបោះពុម្ព ក្រម នេះ ដើម្បី ចែកជូន ដល់ មន្ត្រី នៃ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ អ្នក វិជ្ជាជីវៈ ច្បាប់ តុលាការ មន្ត្រី អនុវត្ត ច្បាប់ និង ស្ថាប័ន ពាក់ព័ន្ធ ផ្សេង ទៀត ឱ្យ បាន ទូលំទូលាយ ។
( ភ្នំពេញ ) ៖ ប្រតិបត្តិការ រក្សា សន្តិភាព ត្រូវបាន បង្កើតឡើង ដោយ អង្គការ សហ ប្រជាជាតិ (UN) សម្រាប់ ជា មធ្យោបាយ មួយ ដើម្បី ជួយ ប្រទេស នានា ដែល ហែក ហួរ ដោយសារ ជម្លោះ អាច បង្កើត លក្ខខណ្ឌ ឆ្ពោះ ទៅរក សន្តិភាព យូរអង្វែង បាន ។
ចាប់តាំងពី ពេល នោះ មក មនុស្ស ជាង ១លាន នាក់ មាន ទាំង បុរស និង ស្រ្តី មកពី ជិត ១៣០ ប្រទេស បាន ចូលរួម ក្នុង បេសកកម្ម រក្សា សន្តិភាព ក្រោម ទង់ របស់ UN នៅ ជុំវិញ ពិភពលោក ខណៈ ច្រើន ជាង ៤.០០០ នាក់ បាន បាត់បង់ជីវិត ។ បច្ចុប្បន្ន បេសកកម្ម អន្តរជាតិ ទាំងនេះ ភាគ ច្រើន ស្ថិត នៅ ទ្វីប អាហ្រ្វិក ។ សមាសភាព នៃ កងកម្លាំង រក្សា សន្តិភាព អាច រួម មាន កងទ័ព ប៉ូលិស ហើយនិង បុគ្គលិក ស៉ី វិល ។
នៅ ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន គណបក្ស ភ្លើង ទៀន ក្នុង ឃុំ ផុង ស្រុក បសេដ្ឋ ខេត្ត កំពង់ស្ពឺ ចំនួន ៧រូប បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព នយោបាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
ពួកគេ ក៏ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕ សមត្ថកិច្ច កម្ពុជា បន្ត ទទួលបាន សំណើរ តាម Hotline ០៦ ករណី ទៀត ដែល ស្នើ ឱ្យ ជួយសង្គ្រោះ ជនជាតិ បរទេស ០៩ នាក់
បើ តាម អ្នកនាំពាក្យ បច្ចុប្បន្នភាព ស្រាវជ្រាវ តាម បញ្ជី តាមដាន គិត ត្រឹម ថ្ងៃទី ២៧ ខែមិថុនា ឆ្នាំ ២០២៤ រួម មាន៖
១៖ ទទួលបាន ណ្តឹង សរុប ១.៤៦៤ សំណើរ មាន មនុស្ស ៣. ៦០៥ នាក់ ២៖ បាន ស្រាវជ្រាវ ស៊ើបអង្កេត បឋម ១.៤៦៤ សំណើ និង បិទ សំណុំរឿង ៤៦៩ សំណើ ( រកឃើញ មនុស្ស ២. ១៣៨នាក់ . ឃាត់ខ្លួន ជនសង្ស័យ ១៤៧ នាក់ . បិទ ក្រុមហ៊ុន ៥ទីតាំង . និង ផ្អាក អាជីវកម្ម ក៏ ដូចជា ស្រាវជ្រាវ ក្រុមហ៊ុន ៤ទីតាំង ) ៣៖ កំពុង បន្ត បើក ប្រតិបត្តិការ ស្រាវជ្រាវ និង ស៊ើបអង្កេត ១៥៩ ករណី ។
នៅ ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន គណបក្ស ភ្លើង ទៀន ក្នុង ឃុំ ក្រសាំង ស្រុក ចុង កាល់ ខេត្ត ឧត្តរមានជ័យ ចំនួន ៨រូប បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព នយោបាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
