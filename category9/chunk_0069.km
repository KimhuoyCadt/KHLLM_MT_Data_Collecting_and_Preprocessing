* ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ជាពិសេស អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ធ្វើ ការផ្សព្វផ្សាយ ពី សារ អប់រំ ពី បញ្ហា គ្រឿងញៀន នៅ គ្រប់ វេទិកា សិល្បៈ នានា
* សហការ ជាមួយ ក្រសួង ព័ត៌មាន ជួយ ផលិត មាតិ ការ អប់រំ ចម្រៀង រឿង ខ្លី នានា ដើម្បី ដាស់តឿន ក្រើន រំលឹក យុវជន យុវនារី ឲ្យ ជៀស ឆ្ងាយ ពី គ្រឿងញៀន
* ប្រកាស គាំទ្រ ពេញ ទំហឹង ចំពោះ បទបញ្ជារ ០១ប ប គោលការណ៍ « សម្អាត ចក ចេញ ពី បឹង »របស់ សម្ដេច ធិបតី នាយក រដ្ឋមន្ត្រី ដើម្បី សហគមន៍ យើង ស្អាតស្អំ គ្មាន គ្រឿងញៀន ៕ ឧស្សាហកម្ម ថាមពល ថ្មី របស់ ប្រទេស ចិន កំពុង នាំមុខ គេ លើ ពិភពលោក
របាយការណ៍ ពិសេស នេះ បាន ឱ្យដឹង ថា៖ « ប្រទេស ចិន បាន នាំចេញ រថយន្ត អគ្គិសនី ជាង ១. ៧៧លាន គ្រឿង ដែល ជា កំណើន គួរឱ្យ កត់សម្គាល់ ៦៧ ភាគរយ ធៀប នឹង ឆ្នាំ ២០២២ ។ បន្ថែម ពីលើ នេះ ប្រទេស ចិន កាន់កាប់ ចំណែក ទីផ្សារ អាគុយ សាកល ជាង ៦០ ភាគរយ ដោយ ក្រុមហ៊ុន ចំនួន ប្រាំមួយ ក្នុង ចំណោម ក្រុមហ៊ុន អាគុយ កំពូល ទាំង១០ នៅ ទូទាំង ពិភពលោក បាន គឺជា ក្រុមហ៊ុន របស់ ប្រទេស ចិន » ។
យោង តាម របាយការណ៍ របស់ ទីភ្នាក់ងារ ថាមពល អន្តរជាតិ (IEA) ក្នុង ឆ្នាំ ២០២៣ សមត្ថភាព ផលិត ថាមពល កកើត ឡើងវិញ ជា សកល បាន កើនឡើង ៥១០ លាន គីឡូវ៉ាត់ ដោយ ក្នុង នោះ ប្រទេស ចិន មាន ចំនួន ជាង ពាក់កណ្តាល នៃ កំណើន នេះ ។ ការចូលរួមចំណែក ដ៏ ច្រើន ពី ប្រទេស ចិន នេះ បាន ធ្វើឱ្យ ថាមពល ស្អាត មាន កំណើន យ៉ាង ខ្លាំង និង ជួយ ឱ្យ ថាមពល នេះ មាន តម្លៃ សមរម្យ នៅ ទូទាំង ពិភពលោក ។
របាយការណ៍ ពិសេស ដដែល នេះ បាន បន្ថែម ថា ផលិតផល ថាមពល ខ្យល់ និង ថាមពល ពន្លឺ ព្រះអាទិត្យ របស់ ចិន ត្រូវបាន នាំចេញ ទៅកាន់ ប្រទេស និង តំបន់ ជាង ២០០ ដោយ សម្រួល ដល់ ការទទួលបាន ប្រភព ថាមពល ដែល អាច ទុកចិត្ត បាន និង ប្រកបដោយ និរន្តរភាព ៕ សហភាព សហជីព ការងារ សន្តិភាព ចេញ វីដេអូ បដិសេធ និង ច្រានចោល របាយការណ៍ សង់ត្រាល់
( ភ្នំពេញ ) ៖ លោក នួន នី អនុប្រធាន និង ជា តំណាង សហភាព សហជីព ការងារ សន្តិភាព បាន ចេញ វីដេអូរ បដិសេធ និង ច្រានចោល ទាំងស្រុង ចំពោះ លើកឡើង ជា របាយការណ៍ របស់ មជ្ឈមណ្ឌល សម្ព័ន្ធភាព ការងារ និង សិទ្ធិ មនុស្ស ហៅ កាត់ ថា សង់ត្រាល់ ដែល បាន ផ្ដល់ បទសម្ភាស ឲ្យ វិទ្យុ អាស៊ី សេរី និង វិទ្យុ បារាំង ចេញផ្សាយ កាលពី ថ្ងៃទី ៤ ខែមិថុនា ឆ្នាំ ២០២៤ ។
លោក ថា របាយការណ៍ នោះ គឺ មិន ពិត មិន ឯករាជ្យ មាន ចរិត នយោបាយ លម្អៀង និង មិន យុត្តិធម៌ ពិសេស មិន មាន ការចូលរួម ត្រួតពិនិត្យ និង វាយតម្លៃ ពី ភាគី ពាក់ព័ន្ធ ( អង្គការ វិជ្ជាជីវៈ ទាំងអស់ នៅ កម្ពុជា ) ។
ម្យ៉ាង វិញ ទៀត អាច ធ្វើឲ្យ ប្រទេស កម្ពុជា រង ផល ប៉ះពាល់ ដល់ ភាពប្រកួតប្រជែង ទីផ្សារ នាំចេញ លើ ឆាក អន្តរជាតិ ជាមួយនឹង ប្រទេស ជិតខាង និង ធ្វើឲ្យ កម្មករ និយោជិត បាត់បង់ ការងារ ដោយសារតែ អ្នក បញ្ជាទិញ មើលឃើញ របាយការណ៍ មិន ពិត ដែល ចេញ ដោយ សង់ត្រាល់ ហើយ អ្នក វិនិយោគទុន ដែល មាន ស្រាប់ និង កំពុងតែ ផលិត ផ្គត់ផ្គង់ អ្នក បញ្ជាទិញ មាន ការភ័យខ្លាច យ៉ាង ខ្លាំង ចំពោះ ការនាំចេញ ។
លោក នួន នី ក្នុង នាម សហភាព សហជីព ការងារ សន្តិភាព បាន សង្កេតឃើញ ថា សង់ត្រាល់ បាន ដើរ តួនាទី រំលោភ លើ កិច្ចការ អង្គការ វិជ្ជាជីវៈ ដូចជា ចង ក្រង កម្មករ បង្កើត សហជីព តាម រោងចក្រ ចុះ ដោះស្រាយ បញ្ហា នៅក្នុង រោងចក្រ និង ដឹកនាំ កូដកម្ម ទៀតផង ។ អនុប្រធាន សហភាព សហជីព ការងារ សន្តិភាព ថា សង់ត្រាល់ ទទួល លុយ ពី អ្នកបញ្ជាទិញ បើក ឲ្យ កម្មករ មិន បាន បង្ហាញ ចំនួន ដល់ កម្មករ នោះ ទេ ហើយក៏ មិន បាន ធ្វើ របាយការណ៍ បង្ហាញ ជាសាធារណៈ នោះ ដែរ ។
អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ចំណាត់ការអនុវត្ត ច្បាប់ ទាក់ទង នឹង សំណុំរឿង ឃាតកម្ម ដែល ប្រព្រឹត្ត ដោយ ជនល្មើស ឈ្មោះ ស្រី ស៊ីណា
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ គូសបញ្ជាក់ ជូន សាធារណជន នូវ ចំណុច សំខាន់ ៗ ពាក់ព័ន្ធ នឹង ករណី បាញ់ប្រហារ ដ៏ សាហាវ ប្រព្រឹត្ត ដោយ ជនល្មើស ឈ្មោះ ស្រី ស៊ីណា និង ចំណាត់ការ ក្នុង ការអនុវត្ត ច្បាប់ ចំពោះ ករណី នេះ ដូច ខាងក្រោម៖
ទី១ - ក្រសួង យុត្តិធម៌ បាន តាមដាន ដោយ យកចិត្ត ដាក់ បំផុត លើ ការអនុវត្ត ច្បាប់ ចំពោះ ករណី ខាងលើ នេះ ដើម្បី ធានា ថា ច្បាប់ ត្រូវបាន អនុវត្ត ដោយ “ ត្រឹមត្រូវ ” និង ដោយ “ ម៉ឺងម៉ាត់ ” នៅក្នុង ករណី នេះ ពិសេស ធានា ថា ជនល្មើស ដាច់ខាត ត្រូវតែ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ជាធរមាន ដោយ ម៉ឺងម៉ាត់ និង ដោយ គ្មាន ការបន្ធូរបន្ថយ ណាមួយ ឡើយ . អ្នក មិន ពាក់ព័ន្ធ ត្រូវ ទទួលបាន នូវ យុត្តិធម៌ តាម ច្បាប់ ហើយ ជនរងគ្រោះ ដាច់ខាត ត្រូវតែ ទទួលបាន យុត្តិធម៌ ដោយ ត្រឹមត្រូវ តាម ច្បាប់ ។
ទី៥ - ករណី បាញ់ប្រហារ ខាងលើ គឺ ពិតជា រឿង ដ៏ រន្ធត់ និង អាណោច អាធ័ម ក្រៃលែង ទាំង សម្រាប់ ជនរងគ្រោះ និង ក្រុមគ្រួសារ ព្រមទាំង សង្គមជាតិ យើង ហើយ យើង ពុំ មាន ជម្រើស អ្វី ក្រៅពី ការអនុវត្ត តាម ច្បាប់ ឱ្យ បាន “ ត្រឹមត្រូវ ” និង “ ម៉ឺងម៉ាត់ ” ដោយ ផ្អែក តាម អង្គហេតុ . ភស្តុតាង និង អង្គ ច្បាប់ នៅក្នុង សំណុំរឿង ដើម្បី ធានា ថា ជនរងគ្រោះ ទទួលបាន យុត្តិធម៌ តាម ផ្លូវ ច្បាប់ ហើយ ជនល្មើស ដាច់ខាត ត្រូវតែ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ដោយ ម៉ឺងម៉ាត់ និង ដោយ គ្មាន បន្ធូរបន្ថយ ណាមួយ ឡើយ ។
អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ ក៏ បាន ចូលរួម សម្តែង នូវ ការសោកស្តាយ និង ការរំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ ក្រុមគ្រួសារ របស់ ជនរងគ្រោះ ព្រមទាំង បាន អះអាង ថា នឹង បន្ត តាមដាន ដោយ យកចិត្តទុកដាក់ លើ ករណី សំណុំរឿង ខាងលើ នេះ ដើម្បី ធានា ថា ច្បាប់ នឹង ត្រូវ អនុវត្ត ដោយ “ ត្រឹមត្រូវ ” និង “ ម៉ឺងម៉ាត់ ” ចំពោះ ជនល្មើស សំដៅ ធានា រក យុត្តិធម៌ ជូន ជនរងគ្រោះ នៅក្នុង សំណុំរឿង ទាំង ពីរ ខាងលើ ។ តុលាការ រាជធានី ភ្នំពេញ សម្រេច ឃុំ ខ្លួន អតីត ឧកញ៉ា ស្រី ស៊ីណា ជា បណ្ដោះអាសន្ន នៅ ពន្ធនាគារ ព្រៃស
( ភ្នំពេញ ) ៖ ចៅក្រម ស៊ើបសួរ សាលាដំបូង រាជធានី ភ្នំពេញ បាន សម្រេច ឃុំ ខ្លួន ជន ត្រូវ ចោទ ដែល ជា អតីត ឧកញ៉ា ស្រី ស៊ីណា បណ្ដោះអាសន្ន នៅ មណ្ឌល អប់រំ កែប្រែ ទី១ ( ពន្ធនាគារ ព្រៃស) ។ នេះ បើ យោង តាម សេចក្ដីប្រកាស ព័ត៌មាន របស់ អយ្យការ និង សាលាដំបូង រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៣ ខែមិថុនា ។
សេចក្ដីប្រកាស ព័ត៌មាន ដដែល បាន បន្ត ថា ដោយ ពិនិត្យ ឃើញ ព្យ សនកម្ម ទៅ លើ ជនរងគ្រោះ ដែល ស្លាប់ ២នាក់ និង របួស ២នាក់ ទៀត តំណាង អយ្យការ បាន ចោទប្រកាន់ ករណី នេះ ជា២ សំណុំរឿ ង៖
* សំណុំរឿង ទី១ ( ជនរងគ្រោះ ដែល បាន ស្លាប់ ២នាក់ ) បាន ចោទប្រកាស់ ឈ្មោះ ស្រី ស៊ីណា ពី បទ ឃាតកម្ម និង ប្រើប្រាស់ អាវុធ ដោយ គ្មាន ការអនុញ្ញាត ដែល ទណ្ឌកម្ម ក្នុង សំណុំរឿង នេះ ជន ត្រូវ ចោទប្រឈម នឹង ការផ្តន្ទាទោស រហូតដល់ ១៥ ឆ្នាំ ។
* សំណុំរឿង ទី២ ( ជនរងគ្រោះ ដែល របួស ២នាក់ ) បាន ចោទប្រកាន់ លើ ជន ត្រូវ ចោទ ពី បទ ប៉ុនប៉ង ឃាតកម្ម និង ប្រើប្រាស់ អាវុធ ដោយ គ្មាន ការអនុញ្ញាត ដែល ទណ្ឌកម្ម ក្នុង សំណុំរឿង នេះ ជន ត្រូវ ចោទប្រឈម នឹង ការផ្តន្ទាទោស រហូតដល់ ១៥ ឆ្នាំ ។
ក្រោយ ទទួលបាន សំណុំរឿង ទាំង២ ខាង លើ នេះ ហើយ ចៅក្រម ស៊ើបសួរ បាន សម្រេច ឃុំ ខ្លួន ជន ត្រូវ ចោទ ស្រី ស៊ីណា ជា បណ្ដោះអាសន្ន តាម នីតិវិធី ច្បាប់ ជាធរមាន ។ ចៅក្រម ស៊ើបសួរ នឹង ស្រាវជ្រាវ ឱ្យ បាន ស៊ីជម្រៅ បន្ថែម ទៀត លើ សំណុះ រឿង ទាំង ពីរ នេះ ក្នុង ករណី រកឃើញ នូវ ភស្តុតាង ថ្មី បន្ថែម ដែល អាច នាំឱ្យ មាន ការប្រែប្រួល ទៅ លើ អង្គហេតុ និង បទ ចោទប្រកាន់ ចៅក្រម ស៊ើបសួរ មាន សិទ្ធិ អំណាច ក្នុង ការកែប្រែ បទ ចោទប្រកាន់ ជាដរាប ។
( បាត់ដំបង ) ៖ ចរន្ត ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី កំពុង ពុះកញ្ជ្រោល យ៉ាង ខ្លាំង ព្រោះតែ អស់សង្ឃឹម នឹង ជោគវាសនា បក្ស ប្រឆាំង ដែល ចេះតែ បែកបាក់ គ្នា និង គ្មាន គោល នយោបាយ ច្បាស់លាស់ លើ សកម្មភាព នយោបាយ ។ ជាពិសេស ការធ្វើន យោ បាយ ខ្វះ ការពិចារណា តែង ប្រឆាំង នឹង ប្រយោជន៍ ជាតិ ។
នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន បក្ស ភ្លើង ទៀន ឃុំ ត្រែង ស្រុក រតន មណ្ឌល ខេត្ត បាត់ដំបង ចំនួន ៩រូប ទៀត បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព ន យោ បាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
( កំពង់ស្ពឺ ) ៖ ចរន្ត ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី កំពុង ពុះកញ្ជ្រោល យ៉ាង ខ្លាំង ព្រោះតែ អស់សង្ឃឹម នឹង ជោគវាសនា បក្ស ប្រឆាំង ដែល ចេះតែ បែកបាក់ គ្នា និង គ្មាន គោល នយោបាយ ច្បាស់លាស់ លើ សកម្មភាព នយោបាយ ។ ជាពិសេស ការធ្វើន យោ បាយ ខ្វះ ការពិចារណា តែង ប្រឆាំង នឹង ប្រយោជន៍ ជាតិ ។
នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន បក្ស ភ្លើង ទៀន ក្បាល ម៉ាស៊ីន បក្ស ប្រឆាំង មកពី បក្ស ភ្លើង ទៀន ឆន្ទៈ ខ្មែរ និង កម្លាំង ជាតិ ក្នុង ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ ចំនួន ៣រូប ទៀត បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព ន យោ បាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
ក្បាល ម៉ាស៊ីន បក្ស ប្រឆាំង នៅ មូលដ្ឋាន ទាំង៣រូប នេះ បាន សម្តែង ការសោកស្តាយ ជាខ្លាំង ចំពោះ កំហុសឆ្គង ចំពោះ ជាតិ មាតុភូមិ នា ពេល កន្លងទៅ ព្រោះតែ លង់ ជឿ ចំពោះ ការអូសទាញ របស់ ជន ក្បត់ ជាតិ សម រង្ស៉ី ក៏ ដូចជា ក្រុម ប្រឆាំង ជ្រុលនិយម ។ ចាប់ពី ពេលនេះ តទៅ ពួកគេ ឈប់ លង់ ជឿ តាម ការញុះញង់ និង អូសទាញ របស់ ទណ្ឌិត ក្បត់ ជាតិ សម រង្ស៉ី និង បក្ខពួក ទៀត ។
( តាកែវ )៖ ចរន្ត ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី កំពុង ពុះកញ្ជ្រោល យ៉ាង ខ្លាំង ព្រោះតែ អស់សង្ឃឹម នឹង ជោគវាសនា បក្ស ប្រឆាំង ដែល ចេះតែ បែកបាក់ គ្នា និង គ្មាន គោល នយោបាយ ច្បាស់លាស់ លើ សកម្មភាព នយោបាយ ។ ជាពិសេស ការធ្វើន យោ បាយ ខ្វះ ការពិចារណា តែង ប្រឆាំង នឹង ប្រយោជន៍ ជាតិ ។
នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន បក្ស ភ្លើង ទៀន ឃុំ ត្រពាំង ធំ ខាងត្បូង ស្រុក ត្រាំ កក់ ខេត្ត តាកែវ ចំនួន ៦រូប ទៀត បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព ន យោ បាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
( ប៉ៃលិន ) ៖ ចរន្ត ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី កំពុង ពុះ កញ្ជ្រោល យ៉ាង ខ្លាំង ព្រោះតែ អស់សង្ឃឹម នឹង ជោគវាសនា បក្ស ប្រឆាំង ដែល ចេះតែ បែក បាក់ គ្នា និង គ្មាន គោល នយោបាយ ច្បាស់លាស់ លើ សកម្មភាព នយោបាយ ។ ជាពិសេស ការ ធ្វើន យោ បាយ ខ្វះ ការពិចារណា តែង ប្រឆាំង នឹង ប្រយោជន៍ ជាតិ ។
នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន គណបក្ស ឆន្ទៈ ខ្មែរ នៅក្នុង ខេត្ត ប៉ៃលិន ដែល ជា បេក្ខភាព ក្រុមប្រឹក្សា ក្រុង និង ខេត្ត ពីរ រូប ទៀត បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព ន យោ បាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
លោក ទិត សីហា និង លោក មាស សៅ ជា ថ្នាក់ដឹកនាំ គណបក្ស ប្រឆាំង នៅក្នុង ខេត្ត ប៉ៃលិន ត្រូវបាន គណបក្ស ឆន្ទៈ ខ្មែរ ចាត់ ឱ្យ ឈរឈ្មោះ ជា បេក្ខជន ក្រុមប្រឹក្សា ក្រុង និខេត្ត ប៉ៃលិន ។
លោក ទិត សីហា និង លោក មាស សៅ បាន សម្តែង ការសោកស្តាយ ជាខ្លាំង ចំពោះ កំហុសឆ្គង ចំពោះ ជាតិ មាតុភូមិ នា ពេល កន្លងទៅ ព្រោះតែ លង់ ជឿ ចំពោះ ការអូសទាញ របស់ ជន ក្បត់ ជាតិ សម រង្ស៉ី ក៏ ដូចជា ក្រុម ប្រឆាំង ជ្រុលនិយម ។ ចាប់ពី ពេលនេះ តទៅ លោក ទាំង ពីរ ឈប់ លង់ ជឿ តាម ការញុះញង់ និង អូសទាញ របស់ ទណ្ឌិត ក្បត់ ជាតិ សម រង្ស៉ី និង បក្ខពួក ទៀត ។
ទន្ទឹមនឹង ការប្រកាស ផ្តាច់ ខ្លួន ចេញ ពី ក្រុម ទណ្ឌិត ក្បត់ ប្រយោជន៍ ជាតិ ហើយ នោះ លោក ទិត សីហា និង លោក មាស សៅ ក៏ បាន សុំ ការ អនុគ្រោះ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណ បក្ស ប្រជាជន កម្ពុជា ដើម្បី បាន ឱកាស រួម រស់ ជា មួយ គណបក្ស ប្រជាជន កម្ពុជា បន្ត សកម្ម ភាព នយោបាយ ទៅ មុខ បន្ត ទៀត ។
ពេលនេះ លោក ទិត សីហា និង លោក មាស សៅ បាន មើលឃើញ ច្បាស់ ដោយ ឥត សង្ស័យ ថា គណ បក្ស ប្រជាជន កម្ពុជា គឺជា បក្ស នយោបាយ តែ មួយ គត់ ដែល មាន គុណ បំណាច់ ដ៏ ធំធេង សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ។ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន ជា មេដឹកនាំ ដ៏ ខ្លាំង ពូកែ ដែល បាន ប្រឹងប្រែង រំដោះ អាយុជីវិត ជាតិ និង ប្រជាជន ពី របប ប្រល័យ ពូជ សាសន៍ នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។ បន្ថែម ពីលើ នោះ សម្តេច តេជោ បាន ប្រឹងប្រែង បញ្ចប់ សង្គ្រាម បង្រួបបង្រួម ជាតិ និង កសាង ជាតិ ឱ្យ រីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។
លោក ទិត សីហា និង លោក មាស សៅ ក៏ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕ លោក បណ្ឌិត យង់ ពៅ៖ អ្នក ព័ត៌មាន ត្រូវតែ ផ្សាយ ការពិត ប៉ុន្តែ ក៏ មិន គួរ ផ្សាយ ទេ ប្រសិនបើ ព័ត៌មាន នោះ ប៉ះពាល់ ដល់ កិត្តិយស ជាតិ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត យង់ ពៅ អគ្គ លេខាធិការ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន លើកឡើង ថា អ្នក ព័ត៌មាន ត្រូវតែ ផ្សាយ នូវ ព័ត៌មាន ពិត ប៉ុន្តែ ទោះជា យ៉ាង នេះ ក្តី សម្រាប់ ព័ត៌មាន ទាំងឡាយ ដែល ប៉ះពាល់ ដល់ កិត្តិយស ជាតិ មិន គួរ ផ្សាយ នោះ ទេ ។
ការអត្ថាធិប្បាយ របស់ លោក Andrei Kartapolov ដែល ជា ប្រធាន គណៈកម្មាធិការ ការពារ ជាតិ នៃ សភា ជាន់ ទាប រុស្ស៉ី ត្រូវបាន ចុះផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន រុស្ស៉ី RIA និង កើត មាន ឡើង បន្ទាប់ពី ប្រធានាធិបតី រុស្ស៉ី លោក វ្ល៉ាឌីមៀ ពូទីន កាលពី ពេល ថ្មី ៗ នេះ បាន ព្រមាន ថា មូស្គូ អាចនឹង ធ្វើ ការកែប្រែ គោល នយោបាយ នុយក្លេអ៊ែរ របស់ ខ្លួន ជាមួយ ការដាក់ ចេញ លក្ខខណ្ឌ ដែល តម្រូវ ឱ្យ ប្រើ អាវុធ នុយក្លេអ៊ែរ ។
គួរ បញ្ជាក់ ថា នៅក្រោម គោល នយោបាយ នុយក្លេអ៊ែរ ឆ្នាំ ២០២០ របស់ រុស្ស៉ី បាន កំណត់ ថា ប្រធានាធិបតី អាច ពិចារណា ប្រើប្រាស់ អាវុធ នុយក្លេអ៊ែរ នៅក្នុង ករណី ដែល អាយុជីវិត ជាតិ ស្ថិត នៅក្រោម ការគំរាមកំហែង ។ លោក ពូទីន ក៏ ធ្លាប់ បាន ព្រមាន ដែរ ថា រុស្ស៉ី អាចនឹង ធ្វើតេស្ដ អាវុធ នុយក្លេអ៊ែរ ក្នុង ករណី ចាំបាច់ បើ ទោះជា លោក បញ្ជាក់ ជាច្រើន ដង ថា ក្នុង ពេល បច្ចុប្បន្ន លោក ផ្ទាល់ មើល មិន ឃើញ ពី ភាពចាំបាច់ ត្រូវ ធ្វើ បែប នេះ ក៏ដោយ ៕
( ក្រចេះ ) ៖ ប្រជាពលរដ្ឋ ចំនួន ២១៨ គ្រួសារ នៅ ភូមិ អូត្រូន ឃុំ ក្បាលដំរី ស្រុក អូរ គ្រៀង សែន ជ័យ ខេត្ត ក្រចេះ បាន ច្រានចោល ទាំងស្រុង ចំពោះ ការចុះផ្សាយ ព័ត៌មាន របស់ វិទ្យុ អាស៊ី សេរី ដែល ចោទប្រកាន់ ថា ក្រុមហ៊ុន ចំនួន ២ ដែល ធ្វើ អាជីវកម្ម រ៉ែ មាស នៅ ភូមិសាស្ត្រ នេះ បាន គំរាមកំហែង យក ដី និង បណ្ដេញ ប្រជាពលរដ្ឋ ចេញ ពី ទីតាំង ដែល ពួកគាត់ កំពុង រស់ នៅ ។
លោកគ្រូ អ្នកគ្រូ និង ប្រជាពលរដ្ឋ ទាំងនោះ ក៏ បាន ស្នើសុំ ឲ្យ បណ្ដាញ ព័ត៌មាន ដែល បាន ចុះ ផ្សព្វផ្សាយ ព័ត៌មាន ទាំងនេះ សូម ចុះ មក សិក្សា និង ស្រាវជ្រាវ ឲ្យបាន ច្បាស់លាស់ មុននឹង ចុះផ្សាយ ពីព្រោះ ផ្សព្វផ្សាយ រឿង មិន ពិត វា ធ្វើឲ្យ ប៉ះពាល់ ដល់ ការអភិវឌ្ឍ ក្នុង មូលដ្ឋាន និង ធ្វើឲ្យ មហាជន មាន ការយល់ ច្រឡំ ។
លោក សុខ គិរី រ័ត្ន មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង រ៉ែ និង ថាមពល បាន ឲ្យដឹង ដែរ ថា ការងារ អី ក៏ដោយ មុននឹង ឱ្យ ធ្វើ អ្វី មួយ គឺ ក្រសួង វិភាគ ល្អិតល្អន់ ណាស់ ថ្លឹងថ្លែង សក្តានុពល សេដ្ឋកិច្ច កន្លែង ណាមួយ ល្អ និង កន្លែង ណាមួយចំណេញ ជាង បាន ក្រសួង ឱ្យ ធ្វើ ហើយ ក្រសួង ធ្វើ អី ក៏ តែងតែ មាន ការប៉ះពាល់ ប៉ុន្តែ បើ ប៉ះពាល់ ខ្លាំង ក្រសួង កាត់បន្ថយ ឲ្យ មក នៅ តិច ហើយ កន្លែង ដែល ប៉ះពាល់ តិច ក្រសួង កាត់បន្ថយ ឱ្យ អស់ តែម្ដង កុំ ឱ្យ ប៉ះពាល់ ។
ហើយ ចំពោះ ការលើកឡើង ព័ត៌មាន ថា មាន ការបង្ហូរ ទឹក កាកសំណល់ ស្អុយ នោះ វា ដូចជា មិន ត្រឹមត្រូវ ទេ ពីព្រោះថា ក្រុមហ៊ុន អត់ មាន ទឹក អី បង្ហូរ ចេញ ទេ កាកសំណល់ ដែល បញ្ចេញមក នោះ គឺជា កាកសំណល់ ដែល គោក រឹង ដែល គាប ចេញ ពី ក្រុមហ៊ុន ហើយ កាកសំណល់ នោះ ត្រូវបាន ធ្វើ របាំង ជុំវិញ ហើយ អត់ មាន ទឹក អី ដែល ត្រូវ បង្ហូរ ចេញ នោះ ទេ ។ ក្រុមហ៊ុន ពិតជា មាន កាភ្ញាក់ផ្អើល ដែរ និង សោកស្ដាយ ណាស់ ចំពោះ ការចុះផ្សាយ នេះ ដោយសារ ក្រុមហ៊ុន មិន បាន ទៅ ធ្វើ រឿង ដូច្នេះ ៕
នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន បក្ស ភ្លើង ទៀន ក្នុង ឃុំ ក្រាំង ដី វ៉ាយ ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ ចំនួន ៨រូប ទៀត បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព នយោបាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
ពួកគេ ក៏ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន លើកទឹកចិត្ត ស្ត្រី កម្ពុជា ឱ្យ ចូលរួម ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ជាតិ សម ដូច ពាក្យ ថា ស្ត្រី ជា ឆ្អឹង ខ្នង ដ៏ រឹងមាំ នៃ សេដ្ឋកិច្ច និង សង្គមជាតិ
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ និង ជា ប្រធាន សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ បាន អញ្ជើញ ប្រកាស ទទួលស្គាល់ ការកែសម្រួល និង បំពេញ បន្ថែម សមាសភាព គណៈកម្មការ សាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ នៃ ក្រសួង មុខងារ សាធារណៈ ។
ពិធី នេះ ប្រព្រឹត្តទៅ នា ព្រឹក ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ ដោយ មាន ការចូលរួម ពី លោក ហ៊ុន ម៉ានី ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ រដ្ឋលេខា ប្រចាំ ការ ក្រសួង មុខងារ សាធារណៈ រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ និង លោកស្រី ជា ឧត្តម ភរិយា របស់ ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ ក្រសួង ដែល ត្រូវ ទទួល ប្រកាស ថ្មី ព្រមទាំង លោក លោកស្រី ជាច្រើន រូប ។
សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន រំលឹក ដល់ សាវតា របស់ សមាគម ដោយ បាន រំលេច នូវ ប្រវត្តិ នៃ ការកកើត សមាគម រួមទាំង ដំណើរ វិវត្ត របស់ សមាគម តាំងពី ដំណាក់កាល ចូលរួម ពលី រំដោះ ជាតិ មាតុភូមិ និង ការចូលរួម ក្នុង សកម្មភាព សង្គម មនុស្សធម៌ ជា បន្តបន្ទាប់ ក្នុង សម័យ សន្តិភាព ។
សម្តេច កិត្តិសង្គហ បណ្ឌិត ក៏ បាន លើកឡើង នូវ គំរូវីរភាព របស់ ថ្នាក់ដឹកនាំ ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត ប្រាជ្ញា ស្មារតី ស្វែងរក បាន នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ។
