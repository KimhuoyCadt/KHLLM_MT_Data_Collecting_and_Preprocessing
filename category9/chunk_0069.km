( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន បើក សិក្ខាសាលា ផ្សព្វផ្សាយ ច្បាប់ ស្ដីពី អត្រានុកូលដ្ឋាន ស្ថិតិ អត្រានុកូលដ្ឋាន និង អត្តសញ្ញាណកម្ម ដើម្បី ធានា ការអនុវត្ត ច្បាប់ ប្រកបដោយ តម្លាភាព និង មាន ប្រសិទ្ធភាព ខ្ពស់ ។
លោក អភិបាល ខេត្ត បាន គូសបញ្ជាក់ ថា ការងារ អត្តសញ្ញាណកម្ម គឺជា ការងារ ដ៏ មាន សារសំខាន់ និង ជា កិច្ចការ អាទិភាព មួយ ក្នុង ការចូលរួមចំណែក អភិវឌ្ឍ ប្រទេសជាតិ លើ គ្រប់ វិស័យ ។ ការរៀបចំ បាន នូវ ប្រព័ន្ធ គ្រប់គ្រង អត្តសញ្ញាណកម្ម ជាតិ ដែល មាន ការឆ្លើយតប និង អាច ជឿ ទុកចិត្ត បាន គឺជា បុរេលក្ខខណ្ឌ ដ៏ ចាំបាច់ មួយ មិន អាច ខ្វះ បាន សម្រាប់ ការការពារ បុគ្គល គ្រប់ រូប ឱ្យ ទទួលបាន នូវ សិទ្ធិ ប្រជាពលរដ្ឋ សង្គម និង សិទ្ធិ នយោបាយ ព្រមទាំង សេវា ទាំងឡាយ ដែល បុគ្គល ទាំងនោះ ត្រូវ ទទួលបាន ។
( ភ្នំពេញ ) ៖ ស្ថាប័ន ត្រួតពិនិត្យ គ្រឿងញៀន កម្ពុជា ដឹកនាំ ដោយ ឧត្តមសេនីយ៍ ឯក នាក់ យុទ្ធា អគ្គ លេខាធិការ រង នៃ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន នៅ ថ្ងៃទី ២៤ ខែមិថុនា ឆ្នាំ ២០២៤ បាន ចាកចេញ ពី ប្រទេស កម្ពុជា ដើម្បី ទៅ ចូលរួម កិច្ចប្រជុំ មន្រ្តី នគរបាល ជាន់ ខ្ពស់ ប្រឆាំង គ្រឿងញៀន ក្រោម វត្តមាន ចូលរួម ពី បណ្តា ប្រទេស នៃ មហា អនុ តំបន់ ទន្លេ មេគង្គ កម្ពុជា ចិន ថៃ ឡាវ ភូមា វៀតណាម នៅ ខេត្ត បកែវ ប្រទេស ឡាវ ដែល ជា ខេត្ត មួយ នៅ ជាប់ តំបន់ ត្រីកោណ មាស ( ឡាវ ថៃ ភូមា ) ។
ឧត្តមសេនីយ៍ ឯក នាក់ យុទ្ធា បាន ឱ្យដឹង ថា៖ « ក្រោយ ទទួលបាន ការអនុញ្ញាត ពី ថ្នាក់ដឹកនាំ ពិសេស លោក សន្តិ បណ្ឌិត នេត សាវឿន ឧប នាយក រដ្ឋមន្ត្រី ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ពួកយើង ទាំង១០ រូប មកពី អន្តរ ស្ថាប័ន នឹង បំពេញ បេសកកម្ម នៅលើកទឹកដី នៃ ប្រទេស ឡាវ និង ប្រទេស ថៃ រយ : ពេល ០៤ ថ្ងៃ ហើយ ប្រទេស ទាំង៦ និង ផ្តល់ ការចែករំលែក បទពិសោធន៍ លើ ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន » ។
តាម ការគ្រោង មន្រ្តី ទាំងអស់ នឹង មកដល់ កម្ពុជា វិញ នៅ ថ្ងៃទី ២៧ ខែមិថុនា ឆ្នាំ ២០២៤ ៕
ឧប នាយក រដ្ឋមន្រ្តី ស៊ុន ចាន់ថុល ចុះ ពិនិត្យ ទីតាំង ដាក់ ផ្លាក ឈ្មោះ ផ្លូវ មហាវិថី ស៊ី ជីន ពីង នៅលើ ខ្សែ ផ្លូវ ក្រវាត់ ក្រុង ទី៣
( ភ្នំពេញ ) ៖ លោក ស៊ុន ចាន់ថុល ឧប នាយក រដ្ឋមន្រ្តី និង ជា អនុប្រធាន ទី១ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា អម ដំណើរ ដោយ លោក ប៉េង ពោធិ៍នា រដ្ឋមន្រ្តី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នា ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ បាន ដឹកនាំ ប្រតិភូ ចុះ ពិនិត្យ ទីតាំង ដាក់ ផ្លាក ឈ្មោះ ផ្លូវ មហាវិថី ស៊ី ជីន ពីង នៅលើ ខ្សែ ផ្លូវ ក្រវាត់ ក្រុង ទី៣ ដើម ត្រៀម ដាក់ សម្ពោធ នៅ ថ្ងៃ ខាងមុខ ។
( ពោធិ៍សាត់ )៖ កិច្ចការពារ អភិរក្ស ធនធាន ធម្មជាតិ និង ការពារ សត្វ ព្រៃ គឺ កាតព្វកិច្ច របស់ ប្រជាពលរដ្ឋ កម្ពុជា គ្រប់ ៗ រូប បើ ទោះបីជា មាន ក្រសួង ស្ថាប័ន មួយចំនួន ជា សេនាធិការ ឱ្យ រាជ រដ្ឋាភិបាល ដើម្បី អនុវត្តន៍ ភារកិច្ច នេះ ក៏ដោយ ជាក់ស្តែង ក្រសួង បរិស្ថាន ជា ស្ថាប័ន មួយ ទទួលខុសត្រូវ ដោយ ផ្ទាល់ លើ កិច្ចការងារ នេះ បាន នឹង កំពុង ចុះ ធ្វើ យុទ្ធនាការ ផ្សព្វផ្សាយ គ្រប់ រូបភាព ពី សារៈសំខាន់ មិន អាច ថ្លៃ បាន ពី ព្រៃឈើ និង សត្វ ព្រៃ ។
ជុំវិញ ផែនការ សកម្មភាព បណ្តុះ ស្មារតី ដល់ ប្រជាពលរដ្ឋ ឱ្យ ស្រឡាញ់ ធនធាន ធម្មជាតិ និង សត្វ ព្រៃ ក្រសួង បរិស្ថាន បាន កំណត់ បេសកកម្ម សំខាន់ ៗ គឺ ដឹកនាំ និង គ្រប់គ្រង កិច្ច គាំពារ បរិស្ថាន ការអភិរក្ស ជីវ ចម្រុះ ការប្រើប្រាស់ ធនធាន ធម្មជាតិ ឱ្យ បាន សមស្រប និង មាន និរន្តរភាព និង ការរស់នៅ ដោយ ចីរភាព សម្រាប់ ជា ឧត្តម ប្រយោជន៍ យូរអង្វែង របស់ ប្រជាជន កម្ពុជា គ្រប់ រូប និង គ្រប់ ជំនាន់ នៅ កម្ពុជា ។
ជាមួយនឹង កិច្ច ខិតខំ ប្រឹងប្រែង ចូលរួម ការពារ និង អភិរក្ស សត្វ ព្រៃ . លោក ពូ ជុំ អូន មាន ស្រុក កំណើត នៅ រាជធានី ភ្នំពេញ បាន លើកឡើង ថា បច្ចុប្បន្ន នេះ ប្រជាពលរដ្ឋ ខ្មែរ កាន់តែ ច្រើន ឡើង បាន យល់ដឹង និង ការស្រឡាញ់ ព្រៃ ព្រមទាំង សត្វ ព្រៃ ជាពិសេស ស្រទាប់ យុវវយ កាន់ ច្រើន ឡើង បាន នាំគ្នា ធ្វើ ទេសចរណ៍ តាម តំបន់ ភ្នំ និង ព្រៃឈើ ។
លោក ជុំ អូន បាន បង្ហាញ ការយល់ឃើញ ថា៖ « អ៊ឹ ចឹង វា គួរតែ ជា ពេលវេលា ដែល យើង ជួួយ ថែរក្សា ព្រៃឈើ ទាំងអស់ គ្នា តាមពិត ខ្ញុំ យល់ ថា យើង រួមគ្នា បញ្ឈប់ កុំ នាំគ្នា ហូប សាច់ ព្រៃ គួរតែ មាន ការ ទប់ស្កាត់ ឱ្យ បាន ទាន់ ពេល វេលា ។ ខ្ញុំ គិត ថា យើង គួរ មាន ការបណ្តុះ គំនិត ឱ្យ មាន ការស្រឡាញ់ ធម្មជាតិ ចាប់ផ្តើម ពី យុវវ័យ និង អប់រំ កូន ចៅ យើង ឱ្យ ជួយ ថែរក្សា សត្វ ព្រៃ និង ព្រៃឈើ យើង ឱ្យ មាន គង់វង្ស » ។
លោក ជុំ អូន បាន គូសបញ្ជាក់ ថា ទាល់តែ យើង ជួយ គ្នា ទើប ធនធាន ធម្មជាតិ និង សត្វ ព្រៃ អាច នៅ គង់វង្ស បើ យើង មិន ជួយ គ្នា ទេ យើង ពិបាក ការពារ ណាស់ ពីព្រោះ មនុស្ស តែ ១នាក់ ឬ ១ក្រុម មិន អាច ការពារ ធនធាន ធម្មជាតិ និង សត្វ ព្រៃ បាន នោះ ទេ ។
សម្រាប់ លោកស្រី នួន មុនី ចិន្តា ប្រធាន នាយកដ្ឋាន អភិវឌ្ឍន៍ ជនជាតិ ដើម ភាគ តិច នៃ ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន បង្ហាញ ការគាំទ្រ យ៉ាង ខ្លាំង ចំពោះ ម្ចាស់ ភោជនីយដ្ឋាន ទាំងអស់ ដែល មិន តយក សាច់ សត្វ ព្រៃ សម្រាប់ ធ្វើជា មុខ ម្ហូប ជូន ភ្ញៀវ ពិសា ។
លោកស្រី នួន មុនី ចិន្តា បាន បន្ថែម ថា៖ « ជាធម្មតា ពេល ខ្ញុំ ចុះ បេសកកម្ម នៅ តាម ខេត្ត នាងខ្ញុំ តែងតែ លើកទឹកចិត្ត ដល់ បងប្អូន ជនជាតិ ភាគ តិច កុំ ឱ្យ បរិភោគ សាច់ សត្វ ព្រៃ សត្វ ព្រៃ ជា សត្វ ដែល កម្រ ប្រសិនបើ ផុត ពូជ កូន ចៅ ជំនាន់ ក្រោយ របសើ យើង លែង បាន ឃើញ និង ស្គាល់ បើ យើង ទាំងអស់ គ្នា មិន បរិភោគ ក៏ ភោជនីយដ្ឋាន មិន លក់ បន្ត ទៀត ដែរ » ។
លោកស្រី មុនី ចិន្តា បាន បន្ត ថា សម្រាប់ វត្តមាន វត្ត សត្វ ព្រៃ នឹង បាន រួមចំណែក យ៉ាង ខ្លាំង ទាក់ទាញ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ឱ្យ មក ទស្សនា នៅ តាម តំបន់ ដែល មាន វត្តមាន សត្វ ព្រៃ និង ធនធាន ធម្មជាតិ ជាដើម ។
យុវសិស្ស មកពី វិទ្យាល័យ ពោធិ៍សាត់ បាន គាំទ្រ ចំរាល់ សកម្មភាព ការពារ ធនធាន ធម្មជាតិ និង រួមគ្នា អភិរក្ស សត្វ ព្រៃ កម្រ ៗ ដែល មាន វត្តមាន នៅក្នុង ប្រទេស កម្ពុជា ដើម្បី ក្លាយជា ចំណែក មួយ សម្រាប់ ទាក់ទាញ ភ្ញៀវ ទេសចរ ។ ជាពិសេស រួមគ្នា បញ្ឈប់ ការចូល ព្រៃ កាប់ ឈើ និង បរបាញ់ សត្វ ព្រៃ ដោយ ខុស ច្បាប់ ជាដើម ៕
តំណាង កម្មករ ជាង ៤ម៉ឺន នាក់ ដាក់ ញត្តិ ស្នើសុំ ម្ចាស់ ជំនួយ ឱ្យ ពិចារណា ឡើងវិញ ចំពោះ ការគាំទ្រ ដល់ អង្គការ សង់ត្រាល់
( ភ្នំពេញ ) ៖ សហភាព សហជីព កម្ពុជា ពន្លឺ កម្មករ ដែល តំណាង ឱ្យ កម្មករ និយោជិត ៤ម៉ឺន នាក់ បាន ដាក់ ញត្តិ នៅ ស្ថានទូត អាមេរិក នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមិថុនា នេះ ដើម្បី ស្នើសុំ នាយក អង្គការ USAID ប្រចាំ កម្ពុជា គិតគូរ ឡើងវិញ ពី ការឧបត្ថម្ភ កញ្ចប់ ថវិកា សម្រាប់ មជ្ឈមណ្ឌល សម្ព័ន្ធភាព ការងារ និង សិទ្ធិ មនុស្ស ហៅ កាត់ « សង់ត្រាល់ » ។
អ្នកស្រី សៀ គន្ធា អគ្គ លេខាធិការ សហភាព សហជីព កម្ពុជា ពន្លឺ កម្មករ និង ជា ប្រធាន សហព័ន្ធ សហជីព ការងារ ស្ត្រី កម្ពុជា បាន ឱ្យដឹង ថា ការដាក់ ញត្តិ នេះ គោលបំណង សំខាន់ បំផុត គឺ ដើម្បី ឱ្យ ម្ចាស់ ជំនួយ USAID គិតគូរ ឡើងវិញ អំពី កញ្ចប់ ថវិការ ឧបត្ថម្ភ ដល់ អង្គការ សង់ត្រាល់ និង ណែណែនាំឲ្យ អង្គការ នេះ ធ្វើ សកម្មភាព ប្រកបដោយ តម្លាភាព និង ស្រប តាម លក្ខខន្តិក : របស់ ខ្លួន ជាពិសេស ឲ្យ ស្រប តាម ច្បាប់ របស់ កម្ពុជា ។
អ្នកស្រី លើកឡើង ថា របាយការណ៍ សង់ត្រាល់ ដែល បាន ចេញផ្សាយ ថ្ងៃទី ៤ ខែមិថុនា ឆ្នាំ ២០២៤ មិន បាន ឆ្លុះបញ្ចាំង ពី ស្ថានភាព ពិត របស់ កម្មករ និយោជិត នៅ កម្ពុជា នោះ ទេ ដោយ របាយការណ៍ នោះ បាន លើកឡើង ពី ការរឹតត្បិត បំភិតបំភ័យ គំរាមកំហែង បៀតបៀន បិទ សិទ្ធិ សេរីភាព កាងារ កម្មករ និយោជិត នៅ កម្ពុជា ដោយ សម្ភាសន៍ រោងចក្រ តែ ១៤ ក្នុង ចំណោម រោងចក្រ ដែល មាន រហូតដល់ ៧០៣ រោងចក្រ របស់ កម្មវិធី រោងចក្រ កាន់តែ ប្រសើរ នៅ កម្ពុជា នៃ អង្គការ ពលកម្ម អន្ដរជាតិ (ILO-BFC) ។
អ្នកស្រី បញ្ជាក់ ថា ខ្លឹមសារ នៃ របាយការណ៍ សង់ត្រាល់ គ្មាន មូលដ្ឋាន ច្បាស់លាស់ ធ្វើឲ្យ ប៉ះពាល់ កិត្តិយស ជាតិ ប៉ះពាល់ ដល់ ស្ថិរភាព ការងារ និង ផល ប្រយោជន៍ រួម របស់ កម្មករ និយោជិត នៅ កម្ពុជា ទាំងមូល ។ ជាពិសេស របាយការណ៍ នេះ មាន ចរិតន យោ បាយ និង ញុះ ញុង លាប ពណ៌ ឲ្យ មាន ការរើសអើង សហជីព និង បំបែកបំបាក់ សាមគ្គីភាព រវាង សហជីព នៅ កម្ពុជា ។
ក្រៅពី នេះ អង្គការ សង់ត្រាល់ ជា អង្គការ បាន ចុះបញ្ជិកា នៅ ក្រសួង មហាផ្ទៃ ប៉ុន្តែ បែរ ជា ទៅ លួច ផ្ដល់ ថវិកា ដើម្បី ចង ក្រង បង្កើត សហជីព នៅ តាម រោងចក្រ សហគ្រាស មួយចំនួន ដែល ផ្ទុយ ពី លក្ខ ខន្តិកៈ របស់ ខ្លួន ថែម ទៀត ផង ។ សកម្មភាព របស់ អង្គការ សង់ត្រាល់ ដែល បាន ធ្វើ និង កំពុង បន្ត ធ្វើ គឺ មិន បាន អនុលោម តាម លក្ខខន្តិកៈ ច្បាប់ ស្ដីពី សហជីព ច្បាប់ ស្ដីពី អង្គការ សមាគម និង ច្បាប់ ស្តីពី ការងារ កម្ពុជា ឡើយ ។
អ្នកស្រី ថ្លែង ថា៖ « សង់ត្រាល់ គឺជា អង្គការ មួយ ដែល ចេញ របាយការណ៍ មាន លក្ខណៈ នយោបាយ អុជ អាល បំផុស បំផុល បំបែកបំបាក់ សាមគ្គី របស់ សហជីព និង សហជីព និង ធ្វើ ការបំភាន់ ការយល់ឃើញ រវាង គ្នា និង គ្នា ប៉ះពាល់ ដល់ ស្ថេរភាព សហជីព នៅក្នុង ប្រទេស កម្ពុជា ប៉ះពាល់ ដល់ ការងារ និង ផលប្រយោជន៍ កម្មករ និយោជិត កម្ពុជា ទាំងមូល ។ »
តំណាង កម្មករ និយោជិត អ្នកស្រី អគ្គ លេខាធិការ សហភាព សហជីព កម្ពុជា ពន្លឺ កម្មករ បាន បង្ហាញ ការព្រួយបារម្មណ៍ យ៉ាង ខ្លាំង ពី ផល ប៉ះពាល់ ដល់ ស្ថិរភាព ការងារ និង ផលប្រយោជន៍ របស់ កម្មករ និយោជិត និង ស្នើសុំ យ៉ាង ទទូច ដល់ នាយក អង្គការ USAID ធ្វើ ការពិចារណា ឡើងវិញ ចំពោះ ការឧបត្ថម្ភ កញ្ចប់ ថវិកា សម្រាប់ ធ្វើ សកម្មភាព ដល់ អង្គការ សង់ត្រាល់ និង សូមឲ្យ អង្គការ សង់ត្រាល់ ធ្វើ សកម្មភាព ប្រកបដោយ តម្លាភាព និង ស្រប តាម តាម លក្ខខន្តិក : របស់ ខ្លួន ៕
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) ចេញផ្សាយ ឯកសារ វីដេអូ ស្ដីពី សកម្មភាព រៀបចំ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ។
សមាគម ក្រុមការងារ ១០០ រាត្រី ចូលរួម ដាំ កូន ឈើ ព្រៃ លិច ទឹក ក្នុង យុទ្ធនាការ របស់ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ នឹង នេសាទ ក្នុង ខេត្ត កំពង់ឆ្នាំង
( កំពង់ឆ្នាំង ) ៖ សមាគម ក្រុមការងារ ១០០រាត្រី នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន ដឹកនាំ អង្គការ សមាគម ដៃគូរ ចូលរួម ដាំ កូន ឈើ ក្នុង យុទ្ធនាការ របស់ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ នឹង នេសាទ ដែល ស្ថិត នៅក្នុង ស្រុក បរិបូរណ៍ ខេត្ត កំពង់ឆ្នាំង ។ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក ស៊ុន សុវណ្ណា រិទ្ធិ អភិបាល ខេត្ត កំពង់ឆ្នាំង ។
នា ឱកាស នោះ ដែរ លោក ស៊ុន សុវណ្ណា រិទ្ធិ ក៏ បាន បញ្ជាក់ អំពី ទិសដៅ មួយចំនួន ដូច ខាងក្រោម៖ * ជុំ រុញ អភិរក្ស តំបន់ អេកូឡូស៊ី ថែរក្សា ព្រៃ លិច ទឹក នឹង មច្ឆា ជាតិ នៅ ជុំវិញ បឹង ទន្លេ សាប * អនុវត្ត នូវ យុទ្ធ ការ « បរិស្ថាន ស្អាត នឹង ទេសចរណ៍ » នៅ ជុំវិញ បឹង ទន្លេ សាប ឱ្យ ស្រប ទៅតាម គោល នយោបាយ របស់ ក្រសួង បរិស្ថាន ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ នឹង នេសាទ នឹង ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ៕
( ភ្នំពេញ ) ៖ លោក កើត រិទ្ធ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ នឹង ធ្វើ សន្និសីទ សារព័ត៌មាន ពាក់ព័ន្ធ « ករណី ឃាតកម្ម ប្រព្រឹត្ត ដោយ ជនល្មើស ឈ្មោះ ស្រី ស៊ីណា » នៅ ថ្ងៃទី ២៦ ខែមិថុនា ខាងមុខ នេះ ។ នេះ សេចក្តីជូនដំណឹង របស់ ក្រសួង យុត្តិធម៌ ។
សេចក្តីជូនដំណឹង បាន បញ្ជាក់ ថា ក្រសួង យុត្តិធម៌ នឹង រៀបចំ សន្និសីទ សារព័ត៌មាន ពាក់ព័ន្ធ « ករណី ឃាតកម្ម ប្រព្រឹត្ត ដោយ ជនល្មើស ឈ្មោះ ស្រី ស៊ីណា » នៅ ថ្ងៃពុធ ទី ២៦ ខែមិថុនា ឆ្នាំ ២០២៤ វេលា ម៉ោង ១៥៖០០ នាទី រសៀល នៅ ទីស្តីការ ក្រសួង យុត្តិធម៌ ៕
( ព្រះសីហនុ) ៖ ចរន្ត ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី កំពុង ពុះ កញ្ជ្រោល យ៉ាង ខ្លាំង ព្រោះតែ អស់សង្ឃឹម នឹង ជោគវាសនា បក្ស ប្រឆាំង ដែល ចេះតែ បែក បាក់ គ្នា និង គ្មាន គោល នយោបាយ ច្បាស់លាស់ លើ សកម្មភាព នយោបាយ ។ ជាពិសេស ការ ធ្វើន យោ បាយ ខ្វះ ការពិចារណា តែង ប្រឆាំង នឹង ប្រយោជន៍ ជាតិ ។
នៅ ថ្ងៃទី ២៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ លោក ចាន់ ហេង ប្រធាន គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស ភ្លេីង ទៀន ក្នុង ឃុំ កំពេញ ស្រុក ស្ទឹង ហាវ ខេត្ត ព្រះសីហនុ បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព ន យោ បាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
លោក ចាន់ ហេង បាន សម្តែង ការសោកស្តាយ ជាខ្លាំង ចំពោះ កំហុសឆ្គង ចំពោះ ជាតិ មាតុភូមិ នា ពេល កន្លងទៅ ព្រោះតែ លង់ ជឿ ចំពោះ ការអូសទាញ របស់ ជន ក្បត់ ជាតិ សម រង្ស៉ី ក៏ ដូចជា ក្រុម ប្រឆាំង ជ្រុលនិយម ។ ចាប់ពី ពេលនេះ តទៅ លោក ឈប់ លង់ ជឿ តាម ការញុះញង់ និង អូសទាញ របស់ ទណ្ឌិត ក្បត់ ជាតិ សម រង្ស៉ី និង បក្ខពួក ទៀត ។
ទន្ទឹមនឹង ការប្រកាស ផ្តាច់ ខ្លួន ចេញ ពី ក្រុម ទណ្ឌិត ក្បត់ ប្រយោជន៍ ជាតិ ហើយ នោះ លោក ចាន់ ហេង ក៏ បាន សុំ ការ អនុគ្រោះ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណ បក្ស ប្រជាជន កម្ពុជា ដើម្បី បាន ឱកាស រួម រស់ ជា មួយ គណបក្ស ប្រជាជន កម្ពុជា បន្ត សកម្ម ភាព នយោបាយ ទៅ មុខ បន្ត ទៀត ។
ពេលនេះ លោក ចាន់ ហេង បាន មើលឃើញ ច្បាស់ ដោយ ឥត សង្ស័យ ថា គណ បក្ស ប្រជាជន កម្ពុជា គឺជា បក្ស នយោបាយ តែ មួយ គត់ ដែល មាន គុណ បំណាច់ ដ៏ ធំធេង សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ។ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន ជា មេដឹកនាំ ដ៏ ខ្លាំង ពូកែ ដែល បាន ប្រឹងប្រែង រំដោះ អាយុជីវិត ជាតិ និង ប្រជាជន ពី របប ប្រល័យ ពូជ សាសន៍ នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។ បន្ថែម ពីលើ នោះ សម្តេច តេជោ បាន ប្រឹងប្រែង បញ្ចប់ សង្គ្រាម បង្រួបបង្រួម ជាតិ និង កសាង ជាតិ ឱ្យ រីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។
អតីត អ្នកស្មោះស្ម័គ្រ បក្ស ប្រឆាំង ខាងលើ នេះ បាន ប្រកាស បម្រើ ការពារ ស្ម័គ្រស្មោះ ជា មួយ បក្ស ប្រជាជន ដោយ មិន ឆោត ល្ងង់ ជឿ តាម ការអូសទាញ របស់ ក្រុម ប្រឆាំង ជាពិសេស មិន ចាញ់ បោក ការ អូសទាញ របស់ ក្រុម ប្រឆាំង ក៏ ដូចជា បុគ្គល សម រង្ស៉ី ទៀត នោះ ឡើយ ។
លោក ចាន់ ហេង ក៏ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕ សាលាដំបូង ខេត្ត សៀមរាប ចោទប្រកាន់ លើ ជនជាតិ វៀតណាម ម្នាក់ និង ជនជាតិ ខ្មែរ ៥នាក់ ពី បទ កាន់កាប់ និង ប្រើប្រាស់ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ខុស ច្បាប់ និង ធ្វើ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ឱ្យ ជន ដែល មិន មាន សញ្ជាតិ ខ្មែរ
( សៀមរាប ) ៖ សាលាដំបូង ខេត្ត សៀមរាប បាន ធ្វើ ការចោទប្រកាន់ លើ ជនជាតិ វៀតណាម ម្នាក់ និង ជនជាតិ ខ្មែរ ៥នាក់ ពី បទ កាន់កាប់ និង ប្រើប្រាស់ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ដោយ ខុស ច្បាប់ ធ្វើ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ឱ្យ ជន ដែល មិន មាន សញ្ជាតិ ខ្មែរ ប្រើប្រាស់ ឯកសារ សាធារណៈ ក្លែង និង ក្លែងបន្លំ ឯកសារ សាធារណៈ ។
អ្នកនាំពាក្យ អយ្យការ អម សាលាដំបូង ខេត្ត សៀមរាប មាន កិត្តិយស សូម ជម្រាប ជូន សាធារណជន ឱ្យ បាន ជ្រាប ថា នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ អយ្យការ អម សាលាដំបូង ខេត្ត សៀមរាប បាន ចាត់ការលើ សំណុំរឿង ព្រហ្មទណ្ឌ លេខ ៨៨០ ចុះ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ ទាក់ទង នឹង ជនជាតិ វៀតណាម ម្នាក់ និង ជនជាតិ ខ្មែរ ៥នាក់ មាន គ្នា សរុប ចំនួន ៦នាក់ សមត្ថកិច្ច បាន ឃាត់ខ្លួន ចំនួន ៤នាក់ និង បក្ខពួក ២នាក់ បាន គេចខ្លួន ។
ក្រោយពី បាន សួរចម្លើយ ជនសង្ស័យ និង ពិនិត្យ ភស្តុតាង នានា ក្នុង សំណុំរឿង តំណាង អយ្យការ បាន សម្រេច ធ្វើ ការចោទប្រកាន់ លើ ជនសង្ស័ យ៖
* ទី១៖ ជនជាតិ វៀតណាម ម្នាក់ ពី បទ កាន់កាប់ និង ប្រើប្រាស់ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ដោយ ខុស ច្បាប់ និង ប្រើប្រាស់ ឯកសារ សាធារណៈ ក្លែង ប្រព្រឹត្ត នៅ ចំណុច សង្កាត់ សំបូរ ក្រុង សៀមរាប ខេត្ត សៀមរាប កាលពី អំឡុង ខែតុលា ឆ្នាំ ២០២៣ និង ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ បទល្មើស ព្រហ្មទណ្ឌ ដែល មាន ចែង ឱ្យ ផ្តន្ទាទោស តាម បញ្ញត្តិ មាត្រា ៣០ នៃ ច្បាប់ ស្តីពី សញ្ជាតិ និង មាត្រា ៦៣០ នៃ ក្រម ព្រហ្មទណ្ឌ ។
( ពោធិ៍សាត់ ) ៖ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ២៤ ខែមិថុនា ឆ្នាំ ២០២៤ បាន ចេញ សេចក្តី បំភ្លឺ ព័ត៌មាន ទាក់ទង នឹង ការចុះផ្សាយ តាម បណ្តាញ ព័ត៌មាន សង្គម ដែល លើកឡើង ថា មាន ការបែកធ្លាយ រឿង ប្រធាន ឧទ្យាន ជាតិ ភ្នំ ក្រវាញ ខេត្ត ពោធិ៍សាត់ និង ឈ្មួញ ឈើ តាហយ បំផ្លាញ ព្រៃឈើ ដ៏ ធំធេង ។
សេចក្តី បំភ្លឺ ព័ត៌មាន នោះ បន្ត ថា ពាក់ព័ន្ធ ករណី នេះ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ មាន កិត្តិយស សូម ជម្រាប ជូន ដល់ សាធារណជន និង បណ្តាញ ផ្សព្វផ្សាយ ព័ត៌មាន ទាំងអស់ ឲ្យបាន ជ្រាប ថា៖
* ទី២៖ តាម ការស្រាវជ្រាវ ស៊ើបអង្កេត របស់ ស្ថាប័ន ជំនាញ លោក រី ភារម្យ ប្រធាន ការិយាល័យ ឧទ្យាន ជាតិ និង ជា នាយក ឧទ្យាន ជាតិ ជួរ ភ្នំ ក្រវាញ ពុំ មាន ឈ្មោះ ជាប់ពាក់ព័ន្ធ ដូច ការចុះផ្សាយ នោះ ឡើយ ។
* ទី៣៖ មកទល់ ពេលនេះ លោក គង់ ពុទ្ធីរ៉ា ប្រធាន មន្ទីរ បរិស្ថាន ខេត្ត បាន និង កំពុង បំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន យ៉ាង សកម្ម ពុំ មាន ការដក តួនាទី ភារកិច្ច ពី ប្រធាន មន្ទីរ ដើម្បី ដាក់ លោក រី ភារម្យ ជា បេក្ខភាព ជំនួស ដូច ការចោទប្រកាន របស់ គណនី ហ្វេសបុក ផេក ផែនដី ថ្មី PDT-news ចុះផ្សាយ ឡើយ ។
* ទី៤៖ តាំងពី ការចូលកាន់ តំណែង ជា អភិបាល ខេត្ត លោក ខូយ រីដា បាន ចាត់ទុក ការបម្រើ ប្រជាពលរដ្ឋ និង ការបង្ការ ទប់ស្កាត់ បង្ក្រាប បទល្មើស ជា កិច្ចការ អាទិភាព បំផុត និង បាន ចាត់ វិធានការ ផ្លូវ ច្បាប់ ចំពោះ ជនល្មើស ជា បន្តបន្ទាប់ ។
ផ្អែក លើ មូលដ្ឋាន ខាងលើ នេះ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ សូម ធ្វើ ការបដិសេធ ចំពោះ ការចុះផ្សាយ របស់ គណនី ហ្វេសបុក ផេក ផែនដី ថ្មី PDT-news ដែល ជា ការចុះផ្សាយ មាន លក្ខណៈ ញុះញង់ បំបែកបំបាក់ ផ្ទៃក្នុង អង្គភាព ផ្សាយ បំភ្លើស ពី ការពិត មូល បង្កាច់ និង ធ្វើ ការវាយតម្លៃ ថ្នាក់ដឹកនាំ ដោយ គ្មាន មូលដ្ឋាន ត្រឹមត្រូវ ដើម្បី កេង យក ចំណេញ ប្រយោជន៍ អ្វី មួយ ក្នុង វិជ្ជាជីវៈ របស់ ខ្លួន ប្រាស់ ចាក ពី ក្រមសីលធម៌ ជា អ្នកសារព័ត៌មាន ។
រដ្ឋបាល ខេត្ត សូម ស្នើ ឱ្យ គណនី ហ្វេសបុក ផេក ផែនដី ថ្មី PDT-news ធ្វើ ការកែតម្រូវ អំពី ការចុះផ្សាយ បំភ្លើស ការពិត របស់ ខ្លួន ឡើងវិញ ជាបន្ទាន់ ៕ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ ចេញ សេចក្តី បំភ្លឺ ព័ត៌មាន ទាក់ទង នឹង អាជីវកម្ម បូម ខ្សាច់ ក្រោយ សាលារៀន បឋមសិក្សា ដូន អី សង្កាត់ ចំរើន ផល ក្រុង ពោធិ៍សាត់ ដែល បង្ក ខូច ផ្លូវ យ៉ាង ខ្លាំង
( ពោធិ៍សាត់ ) ៖ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ២៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន ចេញ សេចក្តី បំភ្លឺ ព័ត៌មាន ទាក់ទង នឹង ការចុះ ផ្សព្វផ្សាយ តាម បណ្តាញ ព័ត៌មាន សង្គម ដែល បាន ធ្វើ ការឡាយ ផ្ទាល់ ដែល មាន ខ្លឹមសារ ថា៖ អាជីវកម្ម បូម ខ្សាច់ ក្រោយ សាលារៀន បឋមសិក្សា ដូន អី សង្កាត់ ចំរើន ផល ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ឡាន ដឹក បង្ក ខូច ផ្លូវ យ៉ាង ខ្លាំង ។
សេចក្តី បំភ្លឺ ព័ត៌មាន នោះ បន្ត ថា ពាក់ព័ន្ធ ករណី នេះ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ មាន កិត្តិយស សូម ជម្រាប ជូន ដល់ សាធារណជន និង បណ្តាញ ផ្សព្វផ្សាយ ព័ត៌មាន ទាំងអស់ ឲ្យបាន ជ្រាប ថា ការឡាយ វីដេអូ របស់ គណនី ហ្វេសបុក ផេក ឈ្មោះ PKN-hotnews គឺជា ការផ្សព្វផ្សាយ បំភ្លើស ខុសពី ការពិត ជាក់ស្តែង គ្មាន មូលដ្ឋាន ច្បាស់លាស់ និង ជា អ្នកសារព័ត៌មាន គ្មាន វិជ្ជាជីវៈ ដែល រដ្ឋបាល ខេត្ត សូម បញ្ជាក់ ដូចត ទៅ៖
* ទី២៖ ទីតាំង អាជីវកម្ម នេះ ជា ទីតាំង មាន អាជ្ញាបណ្ណ ត្រឹមត្រូវ និង មាន ការត្រួតពិនិត្យ ផ្ទៀងផ្ទាត់ ទីតាំង យ៉ាង ហ្មត់ចត់ ពី ជំនាញ មាន សមត្ថកិច្ច មុននឹង ដាក់ ឱ្យ ដំណើរការ ប្រតិបត្តិការ ធនធាន រ៉ែ ។
ផ្អែក លើ មូលដ្ឋាន ខាងលើ នេះ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ សូម ធ្វើ ការបដិសេធ ចំពោះ ការផ្សាយ ដែល មាន ចរិត មូល បង្កាច់ បង្អួច កិត្តិយស សេចក្តីថ្លៃថ្នូ មន្ត្រីរាជការ សាធារណៈ របស់ ខេត្ត ពោធិ៍សាត់ ពិសេស លោក អភិបាល ខេត្ត ដែល កំពុង មមារ ញឹក ក្នុង ការដឹកនាំ បង្ក្រាប បទល្មើស គ្រប់ ប្រភេទ ក្នុង ខេត្ត ផង និង ខិតខំ ដោះស្រាយ សំណើ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ផង ៕
មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ថ្លែងអំណរគុណ ថ្នាក់ដឹកនាំ និង មន្រ្តី នៃ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ចំពោះ ការចូលរួម ផ្សព្វផ្សាយ និង បរិច្ចាគ ដើម្បី គាំទ្រ យុទ្ធនាការ « ១ ម៉ឺន រៀល ១ម៉ឺន នាក់ » ឆ្នាំ ២០២៤
( កំពង់ស្ពឺ ) ៖ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា សូម ថ្លែងអំណរគុណ ថ្នាក់ដឹកនាំ . មន្រ្តី និង បុគ្គលិក នៃ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ចំពោះ ការចូលរួម ផ្សព្វផ្សាយ និង បរិច្ចាគ ដើម្បី គាំទ្រ យុទ្ធនាការ « ១ ម៉ឺន រៀល ១ម៉ឺន នាក់ » ឆ្នាំ ២០២៤ របស់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដែល ផ្ដួច ផ្ដើម ឡើង ដោយ លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត ប្រធាន កិត្តិយស នៃ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដើម្បី រួមគ្នា នាំ ភាពញញឹម ដល់ ទារក និង កុមារ ដែល ជា អនាគត ដ៏ ភ្លឺស្វាង របស់ កម្ពុជា ។
មូលនិធិ គន្ធ បុប្ផា កម្ពុជា សូម បន្ត អំពាវនាវ និង លើកទឹកចិត្ត សប្បុរសជន ដែល មាន បំណង ចូលរួម នាំ ភាពញញឹម ដល់ ទារក និង កុមារ ដែល ជា អនាគត ដ៏ ភ្លឺស្វាង របស់ កម្ពុជា . សូម ជួយ ផ្សព្វផ្សាយ បន្ត អំពី យុទ្ធនាការ នេះ តាម បណ្ដាញ សង្គម រៀង ៗ ខ្លួន និង ចូលរួម បរិច្ចាគ តាមរយៈ ការស្កែន QR Code ឬ លេខ គណនី ធនាគារ ដូច មាន ក្នុង រូប ខាងក្រោម ៕ ខេត្ត ចំនួន ១៥ រង ការបំផ្លិចបំផ្លាញ ដំណាំ ពី ដង្កូវ ហ្វូង ថ្មី ក្នុង រង្វង់ ១ទៅ ២% នៃ ដំណាំ កំពុង ដាំដុះ
ជាមួយគ្នា នេះ អ្នកនាំពាក្យ ក្រសួង កសិកម្ម បាន បញ្ជាក់ ថា « តាម ការវាយតម្លៃ ក្នុង ពេល បច្ចុប្បន្ន ស្ថានភាព នេះ ស្ថិត នៅក្នុង ដំណាក់កាល គ្រប់គ្រង បាន នៅឡើយ ទេ ដោយ ហេតុ ថា យើង បាន ប្រតិកម្ម បាន លឿន និង បងប្អូន ប្រជាកសិករ មាន ការចូលរួម បាន យ៉ាង សកម្ម និង ទូលំទូលាយ បន្ថែម ពី នេះ អ្នកជំនាញ រំពឹងទុក ថា នៅ ពេល ដែល មាន ភ្លៀង ធ្លាក់ មក ដង្កូវ ហ្វូង ទាំងនេះ នឹង ស្លាប់ ទៅ វិញ ហើយ បញ្ហា រីករាលដាល នឹង ត្រូវ បញ្ចប់ » ។
ទោះជា យ៉ាងណា ក៏ដោយ អ្នកនាំពាក្យ ក្រសួង កសិកម្ម បាន ទទូច សុំ ប្រជាកសិករ គ្រប់ ខេត្ត ទាំងអស់ បន្ត បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ តាមដាន ត្រួតពិនិត្យមើល ដំណាំ ស្រែ ចម្ការ របស់ ខ្លួន ជាប្រចាំ និង ឱ្យ បាន ទៀងទាត់ និង ចាត់ វិធានការ ឱ្យ បាន ទាន់ ពេលវេលា ជៀសវាង នូវ ការខាតបង់ ធ្ងន់ធ្ងរ មក លើ ផល ដំណាំ របស់ ខ្លួន ៕ ពលរដ្ឋ ដែល បរិច្ចាគ ហូល ពិតាន ជូន សារ មន្ទីរ នៅ សៀមរាប មាន បំណង ចូលរួម ផ្សព្វផ្សាយ ពី តួនាទី ហូល ពិតាន នៅក្នុង សង្គម ខ្មែរ
( សៀមរាប ) ៖ ប្រជាពលរដ្ឋ ដែល បរិច្ចាគ ហូល ពិតាន ជូន ទៅ សារមន្ទីរ វាយន ភណ្ឌ ប្រពៃណី អាស៊ី ខេត្ត សៀមរាប គឺ មាន បំណង ចូលរួម ផ្សព្វផ្សាយ ពី តួនាទី ហូល ពិតាន នៅក្នុង សង្គម ខ្មែរ ទៅកាន់ សារធារណជន ព្រមទាំង បណ្ដុះ ផ្នត់គំនិត ស្រឡាញ់ និង ជួយ ថែរក្សា ឱ្យ បាន យូរអង្វែង តទៅ មុខ ទៀត ។
គួរ បញ្ជាក់ ថា សារមន្ទីរ វាយន ភណ្ឌ ប្រពៃណី អាស៊ី ដែល គ្រប់គ្រង ដោយ អាជ្ញាធរ ជាតិ អប្សរា បាន ទទួល អំណោយ ហូល ពិតាន ចំនួន ៣ផ្ទាំង ពី ពលរដ្ឋ ដែល ជា អ្នកតម្បាញ សូត្រ នៅ ស្រុក ព្រៃ កប្បាស ខេត្ត តាកែវ កាលពី ពាក់កណ្តាល ខែមិថុនា ឆ្នាំ ២០២៤ ។ ហូល ពិតាន នេះ មាន ក្បាច់ គោម សាច់រឿង ព្រះវេស្សន្តរជាតក ដែល ស្នាដៃ ពោរពេញ ដោយ សិល្បៈ និង ជំនាញ យ៉ាង ប៉ិនប្រសប់ ។
យាយ លឹម មាជ អាយុ ៩១ ឆ្នាំ ជា អ្នកភូមិ ត្រពាំង ស្តុក ឃុំ តាំង យ៉ាប ស្រុក ព្រៃ កប្បាស បាន ឱ្យដឹង ថា គាត់ ចេះ ជំនាញ ត្បាញ ហូល តាំងពី អាយុ ២០ ឆ្នាំ ហើយក៏ អាច ត្បាញ ហូល ពិតាន ផង ។ ថ្វីដ្បិត តែ សព្វ ថ្ងៃ គាត់ មាន វ័យ ជរា មិន អាច ត្បាញ បាន ក៏ប៉ុន្តែ គាត់ បរិច្ចាគ ហូល ពិតាន ចំនួន ១ផ្ទាំង ដែល ជា ស្នាដៃ ចុងក្រោយ សម្រាប់ ជា ទាន មកដល់ សារមន្ទីរ វាយន ភណ្ឌ ប្រពៃណី អាស៊ី ដើម្បី អភិរក្ស និង តាំង បង្ហាញ ដល់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ
លោកយាយ លឹម មាជ បង្ហាញ ទឹកចិត្ត ត្រេកអរ ជាខ្លាំង ក្នុង ការធ្វើ អំណោយ ហូល ពិតាន ដល់ សារ មន្ទីរ ដោយ លោកយាយា ចង់ឱ្យ កូន ខ្មែរ ជំនាន់ ក្រោយ បាន ស្គាល់ និង ជួយ ថែរក្សា កុំ ឱ្យ បាត់បង់ ។
អ្នកស្រី គង់ សុភ័ក្រ មន្រ្តី អភិរក្ស វាយន ភណ្ឌ នៃ សារមន្ទីរ វាយន ភណ្ឌ ប្រពៃណី អាស៊ី បាន ឱ្យដឹង ថា ថ្មី ៗ នេះ សារមន្ទីរ ទទួលបាន សមុច្ច័យ ចំនួន ៤៤ ពី ប្រជាពលរដ្ឋ ២៧ គ្រួសារ រស់នៅ ខេត្ត តាកែវ ។ ក្នុង ចំណោម នោះ មាន ហូល ពិតាន ចំនួន ៣ ហើយ ហូល ពិតាន នេះ មាន តួនាទី សំខាន់ ដូចជា រូប ព្រះបត់ ដែរ ដែល ពួកគាត់ ត្បាញ សម្រាប់ តាំង នៅ ទី សក្ការៈ ឬ វត្ត អារាម និង មាន អ្នក ជាវ ដើម្បី ប្រគេន ព្រះសង្ឃ ជាដើម ។
អ្នកស្រី សុភ័ក្រ បាន បន្ត ថា ស្នាដៃ សិល្បៈ ត្បាញ ហូល ពិតាន របស់ អ្នក ខេត្ត តាកែវ គឺ មាន ជាច្រើន ជំនាន់ មក ហើយ ដែល ផ្ទេរ ជំនាញ នេះ បន្ត គ្នា រហូតមកដល់ សព្វ ថ្ងៃ ។ អ្នកស្រី គង់ សុភ័ក្រ បាន ពន្យល់ ថា បច្ចុប្បន្ន នេះ កូន ខ្មែរ ជំនាន់ ក្រោយ មិន សូវ ស្គាល់ ហូល ពិតាន នេះ ទេ គឺ ស្គាល់ តែ ហូល ដែល គេ ត្បាញ សម្រាប់ កាត់ ជា សម្លៀកបំពាក់ តែ ប៉ុណ្ណោះ ។
នៅ ថ្ងៃទី ២៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ លោក ប៉ិល ទុំ ប្រធាន គណបក្ស ខ្មែរ ស្រឡាញ់ ជាតិ នៅក្នុង ខេត្ត តាកែវ បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព នយោបាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
លោក ប៉ិល ទុំ បាន សម្តែង ការសោកស្តាយ ជាខ្លាំង ចំពោះ កំហុសឆ្គង ចំពោះ ជាតិ មាតុភូមិ នា ពេល កន្លងទៅ ព្រោះតែ លង់ ជឿ ចំពោះ ការអូសទាញ របស់ ជន ក្បត់ ជាតិ សម រង្ស៉ី ក៏ ដូចជា ក្រុម ប្រឆាំង ជ្រុលនិយម ។ ចាប់ពី ពេលនេះ តទៅ លោក ឈប់ លង់ ជឿ តាម ការញុះញង់ និង អូសទាញ របស់ ទណ្ឌិត ក្បត់ ជាតិ សម រង្ស៉ី និង បក្ខពួក ទៀត ។
ទន្ទឹមនឹង ការប្រកាស ផ្តាច់ ខ្លួន ចេញ ពី ក្រុម ទណ្ឌិត ក្បត់ ប្រយោជន៍ ជាតិ ហើយ នោះ លោក ប៉ិល ទុំ ក៏ បាន សុំ ការអនុគ្រោះ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បាន ឱកាស រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា បន្ត សកម្មភាព នយោបាយ ទៅ មុខ បន្ត ទៀត ។
ពេលនេះ លោក ប៉ិល ទុំ បាន មើលឃើញ ច្បាស់ ដោយ ឥត សង្ស័យ ថា គណបក្ស ប្រជាជន កម្ពុជា គឺជា បក្ស នយោបាយ តែ មួយ គត់ ដែល មាន គុណ បំណាច់ ដ៏ ធំធេង សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ។ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន ជា មេដឹកនាំ ដ៏ ខ្លាំង ពូកែ ដែល បាន ប្រឹងប្រែង រំដោះ អាយុជីវិត ជាតិ និង ប្រជាជន ពី របប ប្រល័យ ពូជសាសន៍ នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។ បន្ថែម ពីលើ នោះ សម្តេច តេជោ បាន ប្រឹងប្រែង បញ្ចប់ សង្គ្រាម បង្រួបបង្រួម ជាតិ និង កសាង ជាតិ ឱ្យ រីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។
លោក ប៉ិល ទុំ ក៏ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕
ក្នុង បរិយាកាស ដ៏ វិសេសវិសាល នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន សម្ដែង នូវ ក្តី សោមនស្ស រីករាយ យ៉ាង ខ្លាំង ដោយ បាន ចូលរួម ជា អធិបតីភាព ជូន ថ្នាក់ដឹកនាំ មន្ត្រី បុគ្គលិក និង អ្នកស្ម័គ្រចិត្ដ កាកបាទ ក្រហម កម្ពុជា ទីស្នាក់ការ កណ្តាល និង សាខា រាជធានី - ខេត្ត ។
គ្រឿង ឥស្សរិយយស ដែល បំពាក់ ជូន មន្ត្រី បុគ្គលិក នា ពេលនេះ មាន ដូច ជា៖
* គ្រឿង ឥស្សរិយយស ជា តូប កា ចំនួន ២៤ គ្រឿង * គ្រឿង ឥស្សរិយយស ព្រះរាជាណាចក្រ កម្ពុជា ថ្នាក់ មហាសេរី វឌ្ឍន៍ ចំនួន ១គ្រឿង * គ្រឿង ឥស្សរិយយ ស មុនីសារាភ័ណ្ឌ ថ្នាក់ មហាសេនា សេរី វឌ្ឍន៍ ចំនួន ៨ គ្រឿង * គ្រឿង ឥស្សរិយយ ស មុនីសារាភ័ណ្ឌ ថ្នាក់ មហាសេនា ចំនួន ៣៨ គ្រឿង
ព្រះរាជ ក្រឹត្យ ផ្តល់ គោរមងារ នេះ យោង តាម ការក្រាបបង្គំទូល ថ្វាយ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ៕
( កណ្ដាល ) ៖ និស្សិត ខ្មែរ មូស្លីម ចំនួន ៨រូប ដែល បាន និង កំពុង ស្នាក់ នៅ សិក្សា រៀនសូត្រ នៅ សាលា តះ ហ្វីស អាន វើ ស្ថិត នៅ ភូមិ ចាម លើ ឃុំ ព្រែក ថ្មី ស្រុក កោះ ធំ ទទួលបាន ការសណ្ដោស ប្រណី ជួយ ជ្រោមជ្រែង ពីសំណាក់ លោក ចៅ តុល អនុប្រធាន ទី២ អចិន្ត្រៃយ៍ ចុះ ជួយ ស្រុក កោះ ធំ ដោយ ជួយ ផ្ដល់ អាហារ រូបករណ៍ ទៅ បន្ត ការសិក្សា ថ្នាក់ អនុបណ្ឌិត ផ្នែក សាសនា ឥស្លាម នៅ ប្រទេស ឥណ្ឌូណេស៊ី ។
ស្ថិត នៅក្នុង ជំនួប សំណេះសំណាល នា ចុង សប្ដាហ៍ នេះ លោក ចៅ តុល បាន ផ្ដាំផ្ញើរ ដល់ និស្សិត ទាំង៨ រូប ត្រូវ ខិតខំ តាំងចិត្ត សិក្សា រៀនសូត្រ ឱ្យ ពូកែ ដើម្បី ក្រេប យក ចំណេះដឹង ផ្នែក សាសនា ឥស្លាម មក អប់រំ កូន ចៅ អ្នកភូមិ ឱ្យ បាន ទូលំទូលាយ ដើម្បី ក្លាយ ជា អ្នក កាន់ សាសនា ដ៏ ល្អ ម្នាក់ ក្នុង សង្គម និង ជា អ្នកបន្ត ការអប់រំ ដល់ អ្នកភូមិ កូន ចៅ ជំនាន់ ក្រោយ ឱ្យ ក្លាយជា មនុស្ស ល្អ ជា ធនធាន ល្អ សម្រាប់ ជួយ កសាង ជាតិ មាតុភូមិ ឱ្យ រីកចម្រើន ទៅ មុខ ។
