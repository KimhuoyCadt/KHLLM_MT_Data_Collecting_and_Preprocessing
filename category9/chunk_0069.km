( ត្រាត ) ៖ ក្រោយពេល ចូល ដល់ កំពង់ផែ ពហុ បំណង ខេត្ត ត្រាត ហើយ នា ថ្ងៃទី ៥ ខែមិថុនា ប្រតិភូ កម្ពុជា ថៃ វៀតណាម ដែល ត្រៀមខ្លួន ចូលរួម ពិព័រណ៍ ធុរកិច្ច ខេត្ត ត្រាត ឆ្នាំ ២០២៤ នោះ បាន ចូលទៅ ទស្សនកិច្ច នៅ អតីត ជំរុំ ជនភៀសខ្លួន ខ្មែរ នៅ ស្រុក ខ្លង យ៉ៃ ខេត្ត ត្រាត ដែល បច្ចុប្បន្ន ហៅ ថា « សាលា រាជការុណ្យ » ។
សាលា រាជការុណ្យ ដើម ឡើយ ជា ជំរុំ ជនភៀសខ្លួន កម្ពុជា ដែល បាន ភៀសខ្លួន ចេញ ពី ការកាប់ សម្លាប់ ក្នុង របប កម្ពុជា ប្រជាធិបតេយ្យ ។ ជំរុំ នេះ ត្រូវបាន បង្កើតឡើង តាំងពី ឆ្នាំ ១៩៧៨ ក្រោម ព្រះរាជ មេត្តា របស់ សម្ដេច ព្រះមហាក្សត្រី ថៃ ជា ព្រះប្រធាន កាកបាទ ក្រហម ថៃ កាល ណោះ ដែល ទ្រង់ មាន ការអាណិតអាសូរ ចំពោះ ប្រជាពលរដ្ឋ ខ្មែរ ដែល រងគ្រោះ ដោយសារ សង្គ្រាម និង ការកាប់ សម្រាប់ របស់ ពួក ខ្មែរ ក្រហម ។
រហូត ឆ្នាំ ១៩៨៦ ជំរុំ ជនភៀសខ្លួន នេះ ក៏ ត្រូវបាន រំសាយ វិញ ដោយ ប្រជាពលរដ្ឋ ខ្លះ ក៏ ត្រូវបាន ផ្ទេរ ទៅ ជំរុំ ដទៃ ទៀត ដែល មាន នៅលើ ទឹកដី ថៃ ក្រោម ទទួលខុសត្រូវ របស់ អង្គការ សហ ប្រជាជាតិ មួយចំនួន ក៏ ចេញ ទៅ ប្រទេស ទី៣ ហើយ ខ្លះ ទៀត ក៏ បាន ធ្វើ មាតុភូមិ និវត្តន៍ ។ តាំងពី ពេល នោះ មក ជំរុំ នេះ ត្រូវបាន បិទ ប៉ុន្តែ សព្វ ថ្ងៃ ក៏ បាន ក្លាយជា សារមន្ទីរ មួយ នា ស្រុក ខ្លង យ៉ៃ ខេត្ត ត្រាត « សាលា រាជការុណ្យ » និង ជា គោលដៅ ទេសចរណ៍ មួយ ក្នុង ខេត្ត ផងដែរ ។
គួរ ជម្រាប ថា ក្រោយពី ទស្សនកិច្ច នៅ សាលា រាជការុណ្យ នេះ រួចហើយ ប្រតិភូ ចម្រុះ ៣ប្រទេស នេះ ក៏ បាន បន្ត ទៅ ទស្សនា នៅ វិហារ ព្រះម៉ែ ថាប់ ធីម លំនាំ បែប ចិន ដែល ស្ថិត នៅ ទី រួម ស្រុក ខ្លង យ៉ៃ ខេត្ត ត្រាត ដែល ជា គោលដៅ ទេសចរណ៍ បែប សាសនា មួយ នៅក្នុង ខេត្ត ។
( ភ្នំពេញ ) ៖ ព្រះសិរី កោសល សុំ សុខា ព្រះប្រធាន ពុទ្ធិក សមាគម កម្ពុជ រដ្ឋ នៅ ព្រឹក ថ្ងៃពុធ ១៤ រោច ខែពិសាខ ឆ្នាំ រោង ឆស័ក ពុទ្ធ សករាជ ២៥៦៨ ត្រូវនឹង ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២៤ បាន និមន្ត ចុះ អប់រំ សីលធម៌ ដល់ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស វិទ្យាល័យ ហ៊ុន សែន ប៊ុន រ៉ានី អរុណ វរតី ចំនួន ១៥៧៧ នាក់ លោកគ្រូ អ្នកគ្រូ ៧៩ នាក់ ស្ថិត នៅ សង្កាត់ ត្រពាំង ក្រសាំង ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
កម្មវិធី អប់រំ សីលធម៌ នេះ ក្រោម ប្រធានបទ « គុណ មាតាបិតា . ល្អ ៥ ប្រការ គឺ ជា កូន ល្អ ជា ពលរដ្ឋ ជា សិស្ស ល្អ ជា មិត្ត ល្អ ជា ពុទ្ធ បរិស័ទ ល្អ និង គ្រឿងញៀន បំផ្លាញ នូវ ស្មារតី » ។ កម្មវិធី នេះ មាន ការនិមន្ត និង អញ្ជើញ ចូលរួម ពីសំណាក់ សមាជិក សមាជិកា និង យុវពុទ្ធិក សមាគម កម្ពុជ រដ្ឋ មន្រ្តី សង្ឃ ខណ្ឌ កំបូល ព្រះថេរានុ ថេរ និង មន្រ្តី នៃ សាលា ខណ្ឌ កំបូល និង ពោធិ៍ សែនជ័យ ។
កម្មវិធី នេះ ធ្វើឡើង ដើម្បី បញ្រ្ជាប អំពី សីលធម៌ គុណធម៌ និង អំពី គុណ មាតាបិតា ដើម្បី បានជា ការដល់ ដឹង អំពី តម្លៃ នៃ គុណធម៌ ក្នុង សង្គម ពិសេស ព្រះអង្គ ប្រធាន បាន ពន្យល់ និង បង្ហាញ អំពី ទោស នៃ ការសេព គ្រឿងស្រវឹង និង គ្រឿងញៀន ផ្សេង ៗ ដែល ជា ហេតុ នាំឲ្យ សង្គម បាត់បង់ នូវ ធនធាន ល្អ ៗ ដែល ត្រូវ បន្ត វេន ៕ គណៈកម្មការ អន្តរ ក្រសួង ចុះ ពិនិត្យ វាយតម្លៃ ប្រគល់ ទទួល ការងារ ស្ថាបនា ផ្លូវ ក្រាល កៅស៊ូរ១ ខ្សែ ក្នុង ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ នៅ ព្រឹក ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ គណៈកម្មការ អន្ដរ ក្រសួង រួម មាន តំណាង ក្រសួង អភិវឌ្ឍន៍ ជនបទ តំណាង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ តំណាង នាយកដ្ឋាន វិស្វកម្ម នៃ ក្រសួង ការពារ ជាតិ និង ដោយ មាន ការចូលរួម ពី មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត ពោធិ៍សាត់ បាន ធ្វើ ការ ចុះ ត្រួតពិនិត្យ វាយតម្លៃ ប្រគល់ - ទទួលបញ្ចប់ ជាស្ថាពរ
រយៈពេល ធានា សុពលភាព ការងារ ស្ថាបនា ផ្លូវ ក្រាល កៅស៊ូ DBST ចំនួន ០១ ខ្សែ ប្រវែង ៧០៥០ ម៉ែត្រ ក្នុង ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ ។
( បាត់ដំបង ) ៖ លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត បាត់ដំបង បាន ជំរុញ ឲ្យ អាជ្ញាធរ ក្រុង ស្រុក ទាំង ១៤ ត្រូវ ទប់ស្កាត់ ឲ្យបាន គ្រប់ បទល្មើស ដែល កើតឡើង ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន និង ដោះស្រាយ បញ្ហា ផ្សេង ៗ ដោយ អនុវត្ត ទៅ តាម ជាក់ស្តែង និង តាម ផ្លូវ ច្បាប់ និង បន្ត ធ្វើជា ប្រចាំ ឲ្យ ខាងតែ បាន ។
លោក បាន ថ្លែង បែប នេះ នៅ រសៀល ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២៤ ក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព របស់ រដ្ឋបាល ខេត្ត បាត់ដំបង ប្រចាំ ខែឧសភា ឆ្នាំ ២០២៤ នៅ សាល ប្រជុំ អគារ E សាលា ខេត្ត បាត់ដំបង ។ កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ពី លោក អភិបាល រង ខេត្ត តំណាង សាលាដំបូង ខេត្ត លោក នាយក រដ្ឋបាល សាលា ខេត្ត លោក លោកស្រី អភិបាល ក្រុង ស្រុក ទាំង ១៤ កងកម្លាំង ទាំង បី លោក លោកស្រី ជា ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព ព្រមទាំង អ្នក ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ចូលរួម ផងដែរ ។
លោក សុខ លូ បាន ថ្លែង ណែនាំ ដល់ រដ្ឋបាល ក្រុង ស្រុក អាជ្ញាធរ មន្ទីរ អង្គភាព កងកម្លាំងប្រដាប់អាវុធ ទាំងអស់ ត្រូវ ខិតខំ បន្ត និរន្ដរភាព ការងារ នេះ ឲ្យ កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ដោយ មិន ត្រូវ បន្ធូ ដៃ ឡើយ ពោលគឺ ត្រូវ ខិតខំ ធ្វើ យ៉ាងណា ឲ្យបាន ម៉ត់ចត់ នូវ លទ្ធផល ការងារ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ ជាង មុន ។
លោក ក៏ បាន ជំរុញ ឲ្យ អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ បន្ត ធ្វើ ថែម ទៀត គឺ ពង្រឹង និង បង្រ្កាប រាល់ បទល្មើស ដូចជា បទល្មើស ព្រៃ លិច ទឹក បទល្មើស នេសាទ បទល្មើស រំលោភ ទន្ទ្រាន យក ដី រដ្ឋ ក្នុង តំបន់ ហាមឃាត់ ដើម្បី ធ្វើ ស្រែ និង ឈានដល់ ទាមទារ យក ដី រដ្ឋ ធ្វើជា កម្មសិទ្ធ ត្រូវ បង្រ្កាប ឲ្យ ទាន់ ពេលវេលា ទំនាស់ ដីធ្លី នៅ តាម គ្រប់ ទីកន្លែង និង ជាពិសេស ស្រុក ជុំវិញ បឹង ទន្លេ សាប ។
លោក បាន បន្ត ថា រាល់ គ្រប់ បទល្មើស ទាំងអស់ មាន ដូចជា ដី ព្រៃ លិច ទឹក ក្នុង តំបន់ ៣ ឆ្វៀល ទន្រ្ទាន យក ដី ដោយ ខុស ច្បាប់ ដែល អាជ្ញាធរ សមត្ថកិច្ច ចាប់ខ្លួន បាន ហើយ រឿង ខ្លះ យើង មិន ត្រូវ ធ្វើ ការអប់រំ ដោះលែង នោះ ឡើយ គឺ ត្រូវ ចាត់ បញ្ជូន ខ្លួន ជនល្មើស ទៅ សាលាដំបូង ខេត្ត ដោយ អនុវត្ត តាម នីតិវិធី ច្បាប់ ។
លោក បាន បន្ត ទៀត ថា ពិសេស បទល្មើស គ្រឿងញៀន ក្មេង ទំនើង អំពើ លួច យ៉ាង សកម្ម បទល្មើស ផ្សេង ទៀត តែងតែ កើត មាន ឡើង ដោយសារ កត្តា ជា មូលដ្ឋាន នោះ គឺ មកពី កត្តា គ្រឿងញៀន អ្នក ញៀន ថ្នាំ ជាប្រចាំ បាន បង្ក អុក ឡុក នៅ ពេល យប់ តាម ដងផ្លូវ និង នៅ តាម ផ្ទះ ប្រជាពលរដ្ឋ គ្រប់ ទីកន្លែង កន្លងមក ។
លោក អភិបាល ខេត្ត បាន ជម្រុញ បន្ថែម ថា យើង ទាំងអស់ គ្នា ត្រូវ ដឹង និង ចុះ សួរសុខទុក្ខ ពលរដ្ឋ ជាប្រចាំ ថែមទាំង ខិតខំ បម្រើ សេវា ជូន ប្រជាពលរដ្ឋ លើ គ្រប់ វិស័យ និង ឲ្យបាន ទាន់ ពេលវេលា ជូន ពួកគាត់ រស់ នៅ បាន សុខសប្បាយ ប្រចាំ ថ្ងៃ នៅ តាម មូលដ្ឋាន នានា ក្នុង ក្រុង ស្រុក នៃ ខេត្ត បាត់ដំបង យើង ឲ្យបាន ល្អ កាន់តែ ប្រសើរ ជាង មុន ។
ជា ចុងក្រោយ លោក សុខ លូ បាន រំលឹក ថា យើង នឹង ធ្វើ យុទ្ធនាការដាំ ដើមឈើ នា ពេល ខាងមុខ នេះ គឺ យើង ចាប់ផ្តើម មុន គេ នៅក្នុង ក្រុង បាត់ដំបង ហើយ យើង កំណត់ ស្តង់ដារ យក ដើមឈើ កម្ពស់ ២ម៉ែត្រ ដោយ ក្រោម ទិស ស្លោក ថា « ១គ្រួសារ ត្រូវ ដាំ ឈើ បាន ១ ដើម » តាម គម្រោង ក្នុង ក្រុង ត្រូវ ដាំ ជាង ៣ម៉ឺន ដើម រួច ប្រគល់ឲ្យ ម្ចាស់ ផ្ទះ ប្រជាពលរដ្ឋ នៅមុខ ផ្ទះ នោះ ទទួលខុសត្រូវ ថែរក្សា ។ សម្រាប់ ស្រុក នានា ក៏ ត្រូវ ដាំ ដើមឈើ តាម ទីប្រជុំជន ឲ្យបាន គ្រប់ ស្រុក ដើម្បី សោភ័ណភាព បរិស្ថាន ទេសចរណ៍ ទីក្រុង ស្អាត យើង ផងដែរ ៕
វឌ្ឍនភាព និង សកម្មភាព ផ្តល់ សេវា ផ្នែក វះកាត់ ជា លើក ដំបូង របស់ មន្ទីរពេទ្យ បង្អែក រមាសហែក ថ្មី
( ស្វាយរៀង ) ៖ លោក វេជ្ជបណ្ឌិត គុជ ស៊ី ថា ប្រធាន មន្ទីរ សុខាភិបាល នៃ រដ្ឋបាល ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង នៅ ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២៤ ថា ក្រោម ការដឹកនាំ របស់ លោក ដែល ជា ប្រធាន មន្ទីរ បាន បង្កើត ក្រុមការងារ សម្របសម្រួល ការងារ វះកាត់ របស់ មន្ទីរពេទ្យ បង្អែក រមាសហែក និង បាន ផ្ដល់ សេវា វះកាត់ ជា លើក ដំបូង របស់ ខ្លួន បាន ២ករណី ប្រកបដោយ ជោគជ័យ សុវត្ថិភាព និង ទំនុកចិត្ត ខ្ពស់ ជូន ប្រជាពលរដ្ឋ ដោយ ករណី ទី១ វះ ពោះវៀន ខ្នែង ករណី ២ វះ ពោះវៀន ធ្លាក់ ចូល ពង ស្វាស ។
លោក វេជ្ជបណ្ឌិត គុជ ស៊ី ថា បាន ឲ្យដឹង ទៀត ថា អគារ មន្ទីរពេទ្យ បង្អែក រមាសហែក ថ្មី ត្រូវបាន កកើតឡើង ក្រោម ការឧបត្ថម្ភ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស អនុប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ខេត្ត ស្វាយរៀង និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន ស្រុក រមាសហែក ។
លោក វេជ្ជបណ្ឌិត បាន បន្ត ថា អគារ មន្ទីរពេទ្យ បង្អែក ថ្មី នេះ មាន ទីតាំង នៅ ភូមិ តា ត្រាវ ឃុំ កំពង់ត្រា ច ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង ដែល ត្រូវបាន បើក ការដ្ឋាន សាងសង់ នៅ ថ្ងៃទី ៧ ខែធ្នូ ឆ្នាំ ២០២១ និង បាន បញ្ចប់ ការសាងសង់ ជា ស្ថាពរ នៅ ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២៣ ហើយ ត្រូវបាន ដាក់ ឱ្យ ដំណើរការប្រើប្រាស់ នៅ ថ្ងៃទី១ ខែកញ្ញា ឆ្នាំ ២០២៣ ។
ជាមួយគ្នា នេះ មន្ទីរពេទ្យ បង្អែក ថ្មី នេះ មាន លទ្ធភាព ផ្តល់ សេវា គ្របដណ្តប់ លើ ១៦ ឃុំ ( ២០៤ ភូមិ ) ដែល មាន មាន ប្រជាជន សរុប ១៥៤៤៥៣ នាក់ ស្រី ៧៦៧៦២ នាក់ ។
ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង អគ្គ លេខាធិការដ្ឋាន គ.ស. ច . គ. អប់រំ ផ្សព្វផ្សាយ ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ជូន ដល់ សមាជិក សមាជិកា ជា ក្រុមប្រឹក្សា ក្រុង / សង្កាត់ និង មន្ត្រី រដ្ឋបាល ក្រុង ក្នុង ខេត្ត ពោធិ៍សាត់
គោលបំណង នៃ ការរៀបចំ យុទ្ធនាការ អប់រំ ផ្សព្វផ្សាយ ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក នា ពេលនេះ គឺ ដើម្បី ពញ្ញាក់ ស្មារតី ដល់ អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ជាពិសេស អ្នកប្រើប្រាស់ ទោចក្រយានយន្ត ឱ្យ យកចិត្តទុកដាក់ និង ចូលរួម គោរព ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក សំដៅ ចូលរួម ទប់ស្កាត់ និង កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក ឱ្យ នៅ កម្រិត ទាប ។
ថ្នាក់ដឹកនាំ ទាំង២ ក៏ បាន ជំរុញ ដល់ សមាជិក សមាជិកា ដែល ចូលរួម ក្នុង យុទ្ធនាការ នេះ ត្រូវ បន្ត ផ្សព្វផ្សាយ ឱ្យ បាន ផុល ផុស ទៅដល់ អ្នក ពាក់ព័ន្ធ ពិសេស ប្រជាពលរដ្ឋ ក៏ ដូចជា សិស្សានុសិស្ស ត្រូវ ពាក់ មួក សុវត្ថិភាព ឱ្យ បាន គ្រប់ ពេល រាល់ ពេល បើកបរ មិន ថា ធ្វើដំណើរ ទៅ ទី ជិត ឬ ទី ឆ្ងាយ ឡើយ ។ ថ្នាក់ដឹកនាំ ទាំង២ ក៏ បាន ណែនាំ ឱ្យ នគរបាល ចរាចរណ៍ ផ្លូវគោក ខេត្ត ត្រូវ បន្ត រឹតបន្តឹង ការអនុវត្ត ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ឱ្យ បាន ជាប់ ជាប្រចាំ ដើម្បី ការពារ អាយុជីវិត អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ។
នៅក្នុង យុទ្ធនាការ នេះ ក៏ មាន បទ បង្ហាញ អំពី សិទ្ធិ អាទិភាព នៃ ការប្រើប្រាស់ ផ្លូវ នៅ គ្រប់ ផ្លូវ ប្រសព្វ ព្រមទាំង ចែកជូន នូវ ឯកសារ មួយចំនួន ដូច ជា៖ សៀវភៅ ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក សៀវភៅ ដែល ទាក់ទង នឹង អ្នកបើកបរ ទោចក្រយានយន្ត ត្រូវ យល់ដឹង ខិត្តប័ណ្ណ ជំនួយ ស្មារតី ស្តីពី សុវត្ថិភាព ចរាចរណ៍ ស្ទីក ឃ័រ ចំណាំងផ្លាត ព្រមទាំង ចែកជូន មួក សុវត្ថិភាព ម្នាក់ ១ ផងដែរ ៕
សាលាដំបូង ខេត្ត ប៉ៃលិន ឃុំ ខ្លួន បណ្តោះអាសន្ន ក្មេង ទំនើង ១៥នាក់ ករណី ហិង្សា ដោយ ចេតនា ( មាន ស្ថាន ទម្ងន់ ទោស ) ទៅ វិញ ទៅ មក ធ្វើឲ្យ ខូចខាត ដោយ ចេតនា និង ប្រើប្រាស់ គ្រឿងញៀន
( ភ្នំពេញ ) ៖ សាលាដំបូង ខេត្ត ប៉ៃលិន បាន ឃុំ ខ្លួន បណ្តោះអាសន្ន ក្មេង ទំនើង ចំនួន ១៥នាក់ ពាក់ព័ន្ធ នឹង ករណី ហិង្សា ដោយ ចេតនា ( មាន ស្ថាន ទម្ងន់ ទោស ) ទៅ វិញ ទៅ មក ធ្វើឲ្យ ខូចខាត ដោយ ចេតនា និង ប្រើប្រាស់ គ្រឿងញៀន ។
ក្មេងប្រុស ១៣នាក់ ដែល មិន ចូល សាលារៀន ហើយ ទៅ ប្រមូលផ្តុំ គ្នា លេង បុក ប៊ី យែរ និង ជក់ បារី ក្នុង ប៉ោយប៉ែត ត្រូវបាន សមត្ថកិច្ច ចុះ ទៅ ប្រមូល រួច ឲ្យ ធ្វើ កិច្ចសន្យា អប់រំ
( បន្ទាយមានជ័យ )៖ កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ប៉ោយប៉ែត ដឹកនាំ ដោយ លោក អនុ សេនីយ៍ ឯក មឿត ផាន់ ណា នាយ ប៉ុស្ដី៍ ស្ដី ទី រដ្ឋបាល សង្កាត់ ប៉ោយ ប៉ែត និង មន្ត្រី រដ្ឋបាល សង្កាត់ ប៉ោយប៉ែត ដឹកនាំ ដោយ លោក ភោគ លន ចៅសង្កាត់ ប៉ោយប៉ែត នៅ រសៀល ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២៤ បាន ចុះបង្ក្រាប ណែនាំ ដល់ សិស្សសាលា មិន ចូល សាលា ដែល នៅ តាម កន្លែង កម្សាន្ត នានា ដូចជា តាប៊ី យ៉ា និង ហាង កាហ្វេ នៅក្នុង ភូមិសាស្ត្រ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
ការចុះបង្ក្រាប នេះ ធ្វើឡើង បន្ទាប់ពី មាន វីដេអូ មួយ ត្រូវបាន ចែកចាយ លើ បណ្តាញ សង្គម បង្ហាញ ពី ក្មេងប្រុស មួយ ក្រុម មិន ចូល សាលារៀន បែរជា ទៅ អង្គុយ លេង និង ជក់ បារី នៅ ហាង កាហ្វេ ។
សមត្ថកិច្ច បាន នាំ ក្មេងប្រុស ១៣នាក់ មក ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ប៉ោយប៉ែត ធ្វើ ការអប់រំ ណែនាំ និង ធ្វើ កិច្ចសន្យា រួច ឱ្យ ទៅ ផ្ទះ វិញ ៕ គម្រោង ស្តារ និង លើកកម្រិត គុណភាព ផ្លូវ ជាតិ លេខ ៣៣ ( កំពត - ច្រកលក ) សម្រេចបាន ជាង ៨០ ភាគរយ ហើយ គ្រោង បញ្ចប់ ការសាងសង់ ត្រឹម បំណាច់ ឆ្នាំ ២០២៤
បេសកកម្ម នា ឱកាស នេះ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី ពិនិត្យមើល ស្ថានភាព សាងសង់ និង ការងារ បច្ចេកទេស ធានា ឱ្យ បាន ថា គម្រោង ផ្លូវ ជាតិ លេខ ៣៣ អនុវត្ត ទៅ តាម លក្ខណៈ បទដ្ឋាន ត្រឹមត្រូវ ប្រកបដោយ គុណភាព និង អាច ប្រើប្រាស់ បាន យូរអង្វែង ។
នា ឱកាស នោះ លោក ប៉ាល់ ចន្ទ តារា បាន ធ្វើ ការណែនាំ ដល់ ក្រុមហ៊ុន សាងសង់ ត្រូវ បន្ត យកចិត្តទុកដាក់ ឱ្យ បាន ខ្ពស់ បំផុត ក្នុង ការអនុវត្ត ការងារ ឱ្យ បាន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ និង ការដឹកជញ្ជូន របស់ បងប្អូន ប្រជាពលរដ្ឋ លើស ពី នេះ ទៅ ទៀត ក្រុមហ៊ុន ត្រូវ គិតគូរ ឱ្យ បាន ហ្មត់ចត់ ពី សុវត្ថិភាព នៅ តាម ការដ្ឋាន ព្រមទាំង ដាក់ ផ្លាក សញ្ញា ចរាចរណ៍ ឱ្យ បាន ត្រឹមត្រូវ តាម ស្តង់ដារ សុវត្ថិភាព ។
( សៀមរាប ) ៖ កំឡុង សប្តាហ៍ ទី៤ នៃ ខែឧសភា ឆ្នាំ ២០២៤ នេះ ( ចាប់ពី ថ្ងៃទី ២៧ - ៣១ ខែឧសភា ) ក្រុមការងារ បច្ចេកទេស នៃ នាយកដ្ឋាន គ្រប់គ្រង ដីធ្លី បេតិកភណ្ឌ ក្រុង និង សហគមន៍ បាន បន្ត ចុះ ពិនិត្យ ទីតាំង ស្នើសុំ សាងសង់ លំនៅដ្ឋាន ប្រជាពលរដ្ឋ និង សំណង់ សាធារណៈ ផ្សេង ៗ សរុប ចំនួន ១៩ ករណី ។
ក្នុង រយៈពេល មួយ សប្តាហ៍ នេះ នាយកដ្ឋាន បាន អនុញ្ញាត ចំនួន ៨ករណី ជូន ដល់ ប្រជាពលរដ្ឋ ដែល ជា អ្នកស្រុក ចាស់ ដែល ទីតាំង ស្នើសុំ ពួកគាត់ មាន សំណង់ នៅក្នុង ទិន្នន័យ រូបភាព ពីលើ អាកាស ឆ្នាំ ២០០៤ ( បាន ចុះ ពិនិត្យ កន្លងមក ) ។
ទីតាំង ដែល បាន អនុញ្ញាត នោះ រួម មាន៖
សូម បញ្ជាក់ ថា ចំពោះ ប្រជាពលរដ្ឋ ដែល ទទួលបាន ការអនុញ្ញាត ខាងលើ ក្រុមការងារ បច្ចេកទេស បាន ជួយ រៀបចំ គំនូស ប្លង់ ដែល មាន ស្ថាបត្យកម្ម បែប ប្រពៃណី ជូន ផងដែរ ហើយ រាល់ ការដាក់ពាក្យ ស្នើសុំ ច្បាប់ ចុះ ពិនិត្យ គូរ ប្លង់ និង អនុញ្ញាត គឺ ពុំ តម្រូវ ឱ្យ ប្រជាពលរដ្ឋ បង់ប្រាក់ នោះ ឡើយ ។
អាជ្ញាធរ ជាតិ អប្សរា បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ដែល ទទួលបាន ការអនុញ្ញាត បាន សាងសង់ ឱ្យ ស្រប តាម លក្ខណៈ បច្ចេកទេស និង ប្លង់ ស្ថាបត្យកម្ម ដែល ភ្ជាប់ ជាមួយ លិខិត អនុញ្ញាត ផងដែរ ៕
ប្រទេស ចិន ក្នុង យុគសម័យ ថ្មី កំពុង អភិវឌ្ឍ បៃតង ប្រកបដោយ គុណភាព ខ្ពស់ ដើម្បី សម្រេចបាន បំណង ដូចគ្នា ដែល « មេឃ កាន់តែ ខៀវ ភ្នំ កាន់តែ បៃតង ទឹក កាន់តែ ថ្លា បរិស្ថាន កាន់តែ ស្រស់ស្អាត »៕ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ពាក្យ គន្លឹះ របស់ ចិន៖ ការអភិវឌ្ឍន បៃតង
សម្តេច បាន បញ្ជាក់ ថា វិស័យ កសិកម្ម ជាពិសេស ការផលិត ស្រូវ កម្ពុជា មាន បទពិសោធន៍ ក្នុង ការផលិត ស្រូវ ដោយ ប្រើ រយៈពេល ខ្លី ប្រើ ទឹក តិច ដែល អាច ជួយ ដល់ គុយ បា ជម្នះ ការលំបាក ក្នុង ពេល ដែល ប្រទេស គុយ បា កំពុងតែ ទទួលរង នូវ ការហ៊ុមព័ទ្ធ ។ គុយ បា អាច យក បច្ចេកទេស ផលិត ស្រូវ កម្ពុជា ដើម្បី យក ទៅ អនុវត្ត ជាក់ស្ដែង នៅ ប្រទេស គុយ បា ពីព្រោះថា សព្វ ថ្ងៃ នេះ គុយ បា កំពុង មាន បញ្ហា ខ្វះខាត ស្បៀង ដែល ជា បញ្ហា សំខាន់ ត្រូវ យកចិត្តទុកដាក់ ដោះស្រាយ ។
ពាក់ព័ន្ធ វិស័យ វេជ្ជសាស្រ្ត វិញ សម្ដេច តេជោ បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល គុយ បា ដែល បាន ផ្ដល់ ការគាំទ្រ និង ជួយ ដល់ កម្ពុជា ក្នុង ពេល ដ៏ លំបាក ជាពិសេស គឺ នៅ ពេល ដែល កម្ពុជា ទើបតែ រួចផុត ពី របប ប៉ុល ពត ។ កម្ពុជា បាន បញ្ជូន និស្សិត ជាច្រើន ទៅ សិក្សា នៅ ប្រទេស គុយ បា ដោយ គុយ បា មាន បច្ចេកវិទ្យា វេជ្ជសាស្ត្រ សិក្សា និង ផលិត វ៉ាក់សាំង ដូចនេះ សម្ដេច តេជោ បាន ផ្ដល់ អនុសាសន៍ ឱ្យ លោកស្រី ឯក អគ្គ រដ្ឋទូត បន្ត ធ្វើការ ជាមួយ ក្រសួង សុខាភិបាល កម្ពុជា ។
ក្នុង ជំនួប នោះ លោកស្រី ឯក អគ្គ រដ្ឋទូត បាន ថ្លែង នូវ ការអបអរសាទរ ជូន ចំពោះ សម្ដេច តេជោ ដែល ត្រូវបាន តែងតាំង ជា ប្រធាន ព្រឹទ្ធសភា ហើយក៏ បាន ពាំនាំ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ ប្រធានាធិបតី ប្រធាន សភា និង នាយក រដ្ឋមន្ត្រី គុយ បា ជូន ចំពោះ សម្ដេច តេជោ ផងដែរ ។
លោកស្រី ឯក អគ្គ រដ្ឋទូត បាន ថ្លែង ពី ការស្ញប់ស្ញែង និង កោតសរសើរ ចំពោះ កម្ពុជា ដែល ទទទួលបាន ជោគជ័យ នៅក្នុង បញ្ហា សន្តិសុខ ស្បៀង និង មាន ការអភិវឌ្ឍ កម្រិត ខ្ពស់ ហើយ ប្រទេស គុយ បា ក៏ ចង់ រៀនសូត្រ ពី កម្ពុជា ផងដែរ ។
លោកស្រី បាន ចាត់ទុក ថា សារៈសំខាន់ នៃ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ គឺ គម្រោង ផលិត ស្រូវ ដែល បាន ចាប់ផ្តើម ដោយ គណៈប្រតិភូ កម្ពុជា បាន ធ្វើដំណើរ ទៅ ទីក្រុង ហាឡាវ៉ា នៃ ប្រទេស គុយ បា ហើយ អនុ រដ្ឋមន្ត្រី កសិកម្ម របស់ គុយ បា ក៏ បាន មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ដើម្បី ជំរុញ វិស័យ ផលិត ស្រូវ នៅក្នុង ប្រទេស គុយ បា ផងដែរ ។
ទាក់ទង នឹង វិស័យ សុខាភិបាល លោកស្រី បាន បញ្ជាក់ ថា គុយ បា មាន បច្ចេកវិទ្យា ផ្នែក សុខាភិបាល និង មាន គោលបំណង ចែករំលែក ដល់ កម្ពុជា ។ ប្រទេស យើង ទាំង ពីរ គួរតែ មាន អនុស្សរណៈ យោគយល់ គ្នា នៅលើ វិស័យ សុខាភិបាល និង វិស័យ ផ្សេង ទៀត ដូចជា វប្បធម៌ ជាដើម ។ លោកស្រី ក៏ មាន បំណង នឹង ធ្វើការ ជាមួយនឹង រដ្ឋមន្ត្រី ពាក់ព័ន្ធ នានា របស់ កម្ពុជា ដើម្បី សិក្សា ពី អ្វី ដែល អាច ធ្វើ បាន បន្ថែម ទៀត ដែល ជា សក្ដានុពល របស់ ប្រទេស ទាំង ពីរ ។
លោកស្រី ឯក អគ្គ រដ្ឋទូត ក៏ បាន រៀបរាប់ ផងដែរ ពី ការលំបាក របស់ គុយ បា នា ពេល បច្ចុប្បន្ន ដោយ មាន ការហ៊ុមព័ទ្ធ ទាំង ផ្នែក សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដែល ធ្វើឱ្យ បាន មាន ការលំបាក ក្នុង ការនាំចូល ស្បៀង ។ លោកស្រី បាន ថ្លែងអំណរគុណ ចំពោះ កម្ពុជា ដែល តែងតែ បោះឆ្នោត គាំទ្រ ឱ្យ មាន ការដក ទណ្ឌកម្ម ចេញ ពី ប្រទេស គុយ បា នៅ សន្និបាត អង្គការ សហ ប្រជាជាតិ ជារៀងរាល់ ឆ្នាំ ។
ជា ការឆ្លើយតប សម្ដេច តេជោ ប្រធាន ព្រឹទ្ធសភា បាន ថ្លែងអំណរគុណ ចំពោះ លោកស្រី ឯក អគ្គ រដ្ឋទូត ដែល បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ និង ការជូនពរ ពី ប្រធានាធិបតី ប្រធាន សភា និង នាយក រដ្ឋមន្ត្រី គុយ បា ជូន ចំពោះ សម្ដេច តេជោ ។
សម្ដេច តេជោ បាន រំលឹក អនុស្សាវរីយ៍ ក្នុង ដំណើរទស្សនកិច្ច នៅ សាធារណរដ្ឋ គុយ បា ពិសេស ទស្សនកិច្ច ឆ្នាំ ១៩៩៩ ឆ្នាំ ២០០០ និង ឆ្នាំ ២០២២ កន្លងមក នេះ ដែល សម្ដេច តេជោ បាន ធ្វើ ការចរចា និង ពិភាក្សា យ៉ាង ល្អិតល្អន់ ស្តីពី ការជំរុញ ទំនាក់ទំនង ទ្វេ ភាគី និង សភាពការណ៍ ផ្លាស់ប្ដូរ នៅលើ សកលលោក ជាមួយ ថ្នាក់ដឹកនាំ កំពូល របស់ សាធារណរដ្ឋ គុយ បា ។
ទាក់ទង នឹង ទំនាក់ទំនង ទ្វេ ភាគី សម្ដេច តេជោ បាន រំឭក ថា យើង មាន កិច្ចព្រមព្រៀង និង អនុស្សរណៈ ជាច្រើន សម្រាប់ កិច្ចសហការ របស់ យើង ។ យើង ត្រូវ ជំរុញ អនុវត្ត រាល់ កិច្ចព្រមព្រៀង និង អនុស្សរណៈ ដែល មាន ស្រាប់ និង ស្វែងរក អ្វី ដែល អាច ធ្វើ បាន បន្ថែម ទៀត ដោយសារ ប្រទេស យើង ទាំង ពីរ មាន សក្តានុពល យ៉ាង ច្រើន ។
លោកស្រី ឯក អគ្គ រដ្ឋទូត បាន សម្ដែង នូវ សេចក្តីរីករាយ ដែល បាន ស្ដាប់ នូវ អនុស្សាវរីយ៍ របស់ សម្ដេច តេជោ នៅក្នុង សាធារណរដ្ឋ គុយ បា កន្លងមក ដែល ពេល នោះ សម្ដេច តេជោ បាន ពិភាក្សា ជាមួយ អគ្គ បញ្ជាការគុយ បា ជុំវិញ ការការពារ ប្រទេស របស់ សាធារណរដ្ឋ គុយ បា ដែល បាន ខិតខំ តស៊ូ ដើម្បី សង្គម សមភាព និង យុត្តិធម៌ ហើយ លោកស្រី ក៏ បាន ចាត់ទុក ថា មិត្តភាព រវាង កម្ពុជា និង គុយបា គឺ ស្ថិត លើ ការកសាង ជាតិ និង សន្តិសុខ ដោយ ប្រទេស ទាំង ពីរ ក៏ ជា សមាជិក មិន ចូល បក្ស សម្ព័ន្ធ ដូចគ្នា ។
លោកស្រី ឯក អគ្គ រដ្ឋទូត បាន គោរព ជូនពរ សម្ដេច តេជោ ប្រធាន ព្រឹទ្ធសភា សូម ទទួលបាន សុខភាព ល្អ និង អាយុ វែង ដើម្បី ស្ថិរភាព សន្តិសុខ និង សន្តិភាព យូរអង្វែង របស់ កម្ពុជា និង បាន អរគុណ សម្ដេច តេជោ ដែល បាន ចាត់ទុក សាធារណរដ្ឋ គុយ បា គឺជា បងប្អូន ។
សម្ដេច តេជោ ប្រធាន ព្រឹទ្ធសភា បាន ស្នើ ឱ្យ លោកស្រី ឯក អគ្គ រដ្ឋទូត សាធារណរដ្ឋ គុយ បា ធ្វើ ការពាំនាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ និង ពរ ជ័យ ជូន ចំពោះ ប្រធានាធិបតី នាយក រដ្ឋមន្រ្តី និង ប្រធាន សភា សាធារណរដ្ឋ គុយ បា ផងដែរ ៕
នាយ ឧត្តមសេនីយ៍ ស ថេត ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ ឧបាសក ហេង ស៉ី វ៉ារ៉ូ បង ប្រុស បង្កើត ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ តាង នាម កងកម្លាំង នគរបាល ជាតិ ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ចំពោះ មរណភាព របស់ ឧបាសក ហេង ស៊ីវ៉ារ៉ូ ដែល ត្រូវ ជា បង ប្រុស បង្កើត កាលពី ថ្ងៃអង្គារ ១៣រោច ខែពិសាខ ឆ្នាំ រោង ឆស័ក ព .ស .២៥៦៨ ត្រូវនឹង ថ្ងៃទី ០៤ ខែមិថុនា ឆ្នាំ ២០២៤ ក្នុង ជន្មាយុ ៧២ ឆ្នាំ ដោយសារ ឧបទ្ទវហេតុ ។
ស្ថិត ក្នុង ពេលវេលា ដ៏ សែន ក្រៀមក្រំ សោក សង្រេង នេះ ក្នុង នាម កងកម្លាំង នគរបាល ជាតិ នាយ ឧត្តមសេនីយ៍ ស ថេត សូម ចូលរួម សម្ដែង នូវ សមាន ទុក្ខ ដោយ ក្តី សោកស្តាយ អាឡោះអាល័យ និង សូម បួងសួង ឧទ្ទិស ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ ជួយ យិត យោង ដួង វិញ្ញាណក្ខន្ធ របស់ ឧបាសក ហេង ស៊ីវ៉ារ៉ូ សូម ឆាប់ បាន យោន យក កំណើត ចាប់បដិសន្ធិ ក្នុង សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
រដ្ឋបាល ខេត្ត កំពង់ចាម និង សាជីវកម្ម ចែករំលែក ជីវិត សកល នៃ សាធារណរដ្ឋ កូរ៉េ ចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ គ្នា ស្ដីពី អំណោយ មនុស្សធម៌ ជូន ដល់ រដ្ឋបាល ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម និង សាជីវកម្ម ចែករំលែក ជីវិត សកល នៃ សាធារណរដ្ឋ កូរ៉េ បាន ចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ គ្នា ស្ដីពី អំណោយ មនុស្សធម៌ ជូន ដល់ រដ្ឋបាល ខេត្ត កំពង់ចាម ដើម្បី លើកកម្ពស់ គុណភាព នៃ ការរស់ នៅ សម្រាប់ ប្រជាជន កម្ពុជា លើ វិស័យ សុខភាព ការអប់រំ និង សុខុមាលភាព ។
ពិធី ចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ គ្នា (MOU) ស្ដីពី អំណោយ មនុស្សធម៌ ជូន រដ្ឋបាល ខេត្ត កំពង់ចាម ធ្វើឡើង នៅ ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២៤ នៅ វិមាន ព្រឹទ្ធសភា រាជធានី ភ្នំពេញ ក្រោម អធិបតីភាព លោក ម៉ម ប៊ុន នាង ប្រធាន គណៈកម្មការ ទី១០ ។
មន្ត្រី រដ្ឋបាល ខេត្ត កំពង់ចាម បាន ឲ្យដឹង ថា ក្នុង ការពិចារណា លើក តិកាសញ្ញា និង កិច្ចព្រមព្រៀង ទៅ វិញ ទៅ មក នៅ ទីនេះ និង សម្រាប់ ការពិចារណា ដ៏ ល្អ និង មាន តម្លៃ ផ្សេង ទៀត ភាគី ទាំង ពីរ បាន យល់ព្រម ដូចត ទៅ៖
ប្រការ១ - គោលបំណ ង៖ កិច្ចព្រមព្រៀង នេះ រៀបចំឡើង ដើម្បី លើកកម្ពស់ និង សម្រេចបាន គុណភាព នៃ ការរស់ នៅ សម្រាប់ ប្រជាជន កម្ពុជា លើ វិស័យ សុខភាព ការអប់រំ និង សុខុមាលភាព តាមរយៈ ការបរិច្ចាក សម្ភារ ជំនួយ ផ្នែក វេជ្ជសាស្ដ្រ នៃ ជនជាតិ កូរ៉េ មាន ដូចជា ថ្នាំ ពេទ្យ សម្ភារៈ បរិក្ខា និង សម្ភារៈ ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ដែល ផ្ដល់ ដោយ ភាគី “ ខ” ។
ប្រការ២ - លក្ខខណ្ឌ និង ការបញ្ចប់៖ ចំនួន ទឹកប្រាក់ កំណត់ នៃ កិច្ចព្រមព្រៀង នេះ គឺ ៥.០០០.០០០ ដុល្លារ អនុវត្ត រយៈពេល ៥០ ខែ ( ខែមិថុនា ឆ្នាំ ២០២៤ - ខែមេសា ឆ្នាំ ២០២៩) ។ ការងារ គម្រោង មួយចំនួន ត្រូវ ធ្វើ ការសិក្សា ដោយ ផ្អែក លើ កិច្ចព្រមព្រៀង នៃ ភាគី ទាំង ពីរ ។
ប្រការ៣ - សម្ភារ បរិច្ចាគ ដោយ ភាគី “ ខ” សម្ភារ ដែល អាច រៀបចំ ជា ប្រព័ន្ធ សុខភាព និង លើកកម្ពស់ គុណភាព នៃ ការរស់នៅ របស់ ប្រជាជន កម្ពុជា ជាពិសេស ក្នុង វិស័យ សុខភាព ការអប់រំ និង សុខុមាលភាព ។ល ។
ប្រការ៤ - លក្ខខណ្ឌ ទូទៅ៖ គ្រោង ការលម្អិត នៃ គម្រោង នីមួយ ៗ ត្រូវបាន បន្ថែម នៅក្នុង កិច្ចព្រមព្រៀង នេះ បន្ទាប់ពី អនុស្សរណៈ នេះ ត្រូវបាន ពិនិត្យ យ៉ាង ម៉ត់ចត់ និង ទទួលស្គាល់ ដោយ ភាគី ទាំង ពីរ ។ ចំនួន នៃ គម្រោង អាច ធ្វើ ការសម្រេចចិត្ត ដោយ មាន ការយល់ព្រម ពី ភាគី ទាំង សងខាង ។
ក្នុង ករណី មាន ការយល់ ច្រឡំ ណាមួយ កើតឡើង ឬ ក៏ ខ្វះ ការបញ្ជាក់ លើ កិច្ចព្រមព្រៀង នេះ ត្រូវ ប្រើ កិច្ចព្រមព្រៀង ជា ភាសា អង់គ្លេស ។ កិច្ចព្រមព្រៀង ជា ភាសា អង់គ្លេស ត្រូវ ផ្ដល់ មូលដ្ឋាន ចុងក្រោយ សម្រាប់ ការបកស្រាយ និង អនុវត្ត លក្ខខណ្ឌ នៃ កិច្ចព្រមព្រៀង ។
ប្រការ៥ - ការគ្រប់គ្រង៖ ការគ្រប់គ្រង និង ការទំនាក់ទំនង នៃ គម្រោង នានា ត្រូវ ទំនាក់ទំនង តាមរយៈ អ្នកសម្របសម្រួល លោក មីន ប៊ុង ចាង R&S Steel( កម្ពុជា ) ដែល បាន រៀបរៀង ដោយ ភាគី ទាំង ពីរ ។ ភាគី ទាំង ពីរ ត្រូវ បន្ដ ទំនាក់ទំនង និង រួម សហការ ដើម្បី ផ្សព្វផ្សាយ លទ្ធផល ល្អ បំផុត នៃ គម្រោង ។
ប្រការ៦ - ការចុះហត្ថលេខា ដូចជា ភ័ស្ដុតាង ភាគី ទាំង ពីរ បាន ព្រមព្រៀង ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ស្ដីពី កិច្ចព្រមព្រៀង បរិច្ចាក នៅ ថ្ងៃទី ៨ ខែមិថុនា ឆ្នាំ ២០២៤ ។
