( ព្រៃវែង ) ៖ លោក ឃួន ពាត សមាជិក គណៈកម្មាធិការ ប្រតិបត្តិ និង ជា បេក្ខជន សមាជិក ព្រឹទ្ធសភា មកពី គណបក្ស កម្លាំង ជាតិ ខេត្ត ព្រៃវែង បាន ប្រកាស ផ្ដាច់ ខ្លួន ចេញ ពី គណបក្ស ប្រឆាំង មួយ នេះ ហើយ គោរព ស្នើសុំ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា វិញ ។
( ព្រៃវែង ) ៖ សមាជិក នៃ រចនាសម្ព័ន្ធ គណបក្ស ភ្លើង ទៀន ឃុំ ស្ពឺខ ស្រុក បាភ្នំ ខេត្ត ព្រៃវែង ចំនួន ៨នាក់ បាន ប្រកាស ផ្ដាច់ ខ្លួន ចេញ ពី គណបក្ស ប្រឆាំង មួយ នេះ ហើយ គោរព ស្នើសុំ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី មាន ឱកាស ចូលរួម ជីវភាព នយោបាយ ជាមួយ បក្ស កាន់អំណាច វិញ ។
ជាមួយគ្នា នេះ ពួកគាត់ បាន ប្រកាស ថ្កោល ទោស ទណ្ឌិត សម រង្ស៉ី ដែល មាន គំនិត ទុច្ចរិត ប្រឆាំង គម្រោង ព្រែក ជីក ហ្វូណន - តេជោ ដែល ជា ការបំផ្លាញ ផលប្រយោជន៍ ជាតិ ៕
ឆេះ ផ្ទះ ប្រជាពលរដ្ឋ មួយ កន្លែង នៅ ខណ្ឌ កំបូល ដោយសារ ឆ្លង ចរន្ដ អគ្គីសនី
( ភ្នំពេញ ) ៖ អគ្គិភ័យ បាន ឆាបឆេះ ផ្ទះ មួយ កន្លែង យ៉ាង សន្ធោ សន្ធៅ នៅ វេលា ទាប ភ្លឺ ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ ស្ថិត នៅ ចំណុច បុរី សុខ ចំរើន ផ្ទះ លេខ ១៧C ផ្លូវ បេតុង ភូមិ ទួល តាឡាត់ សង្កាត់ កំបូល ខណ្ឌ កំបូល រាជធានី ភ្នំពេញ ។
លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន នាយ ការិយាល័យ នគរបាល បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ នៃ ស្នងការ នគរបាល រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា ដោយ មាន ការអនុវត្ត តាម បទបញ្ជា របស់ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ បាន ណែនាំ ដល់ កម្លាំង ជំនាញ ការិយាល័យ នគរបាល បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ ត្រូវ ធ្វើការ យកចិត្តទុកដាក់ ខ្ពស់ នៅក្នុង ប្រតិបត្តិការ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ឲ្យបាន ទាន់ ពេល វេលា ។
ដោយ ទទួលបាន បទបញ្ជា លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន នាយ ការិយាល័យ នគរបាល បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ដឹកនាំ បញ្ជា ផ្ទាល់ ដល់ កងកម្លាំង ពន្លត់ អគ្គិភ័យ ដែល ប្រចាំ ការ នៅ គ្រប់ បណ្តាល គោលដៅ ទាំងអស់ ឲ្យ ចេញ ជួយ អន្តរាគមន៍ បាញ់ ទឹក ពន្លត់ ឲ្យ ទាន់ ពេលវេលា កុំ ឲ្យ មាន ការឆាបឆេះ បន្ត ដល់ ផ្ទះ ប្រជាពលរដ្ឋ ដែល នៅក្បែរ នោះ ។
នៅក្នុង ប្រតិបត្តិការ ខាងលើ នេះ កម្លាំង សមត្ថកិច្ច ជំនាញ បាន ប្រើប្រាស់ រថយន្ត ពន្លត់ អគ្គិភ័យ ចំនួន ១៣ គ្រឿង ក្នុង នោះ រួម មាន រថយន្ត ពន្លត់ អគ្គិភ័យ របស់ ការិយាល័យ រាជធានី ភ្នំពេញ ចំនួន ៧ គ្រឿង ប្រើប្រាស់ ទឹក អស់ ៣ឡាន ស្មើរ នឹង ១៨ម៉ែត្រ គូប និង រថយន្ត ជំនួយ មក ពី អង្គភាព ៩១១ ចំនួន២ គ្រឿង ប្រើប្រាស់ ទឹក អស់ ២ឡាន ស្មើរ នឹង ០៨ ម៉ែត្រ គូប . រថយន្ត របស់ កងពល តូច លេខ ៧០ ចំនួន៣ គ្រឿង ប្រើប្រាស់ ទឹក អស់ ៣ឡាន ស្មើរ នឹង ១២ម៉ែត្រ គូប និង រថយន្ត សាលា ខណ្ឌ កំបូល ចំនួន១ គ្រឿង ពុំ បាន ប្រើប្រាស់ ទឹក ។
យុទ្ធនាការ អប់រំ ផ្សព្វផ្សាយ ស្ដីពី ការលើកកម្ពស់ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក និង បរិយាប័ន្ន នៅ កម្ពុជា បន្ដ ធ្វើ នៅ វិទ្យាល័យ ព្រះមុនីវង្ស ក្រុង បាត់ដំបង
ពិធី នេះ បាន ធ្វើឡើង ក្នុង គោលដៅ ចូល រួម លើកកម្ពស់ សុវត្ថិភាព ចរាចរណ៍ ដើម្បី ធ្វើ ការ កាត់បន្ថយ អត្រា គ្រោះថ្នាក់ ចរាចរណ៍ នៅ តាម ដងផ្លូវ នានា ខណៈ បញ្ហា នេះ បាន និង កំពុង ក្លាយទៅជា ប្រធានបទ មួយ យ៉ាង សំខាន់ សម្រាប់ ប្រទេស កម្ពុជា ដែល ត្រូវ ទាមទារ ឲ្យ មាន ការចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ឱ្យ បាន គ្រប់ គ្នា ។
យុទ្ធនាការ ដែរ នេះ មាន គោលបំណង ដើម្បី ពញ្ញាក់ ស្មារតី ដល់ អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ជាពិសេស សិស្សានុសិស្ស ឲ្យ មាន ការប្រុងប្រយ័ត្ន នៅពេល ធ្វើដំណើរ តាម ដងផ្លូវ និង ត្រូវ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ឱ្យ បាន ខ្ជាប់ខ្ជួន ដើម្បី ជៀសវាង ឱ្យ បាន នូវ គ្រោះថ្នាក់ ចរាចរណ៍ ដែល អាច កើត មាន ឡើង ជា យថាហេតុ ។
លោក យ៉ាន ឧត្តម នាយក រង សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង បាន ថ្លែង ផ្តាំផ្ញើ សួរសុខទុក្ខ ពី លោក សុខ លូ ប្រធាន គណៈកម្មាធិការ សាខា ជាពិសេស សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដោយ ក្តី នឹករលឹក ។ ជាមួយគ្នា នេះ លោក នាយក រង សាខា បាន ថ្លែង ថា « កាកបាទ ក្រហម កម្ពុជា ធ្វើ សកម្មភាព មនុស្សធម៌ ស្រប តាម គោលការណ៍ គ្រឹះ របស់ ចលនា អន្តរជាតិ កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ហើយ កាកបាទ ក្រហម កម្ពុជា គឺជា ជំនួយការអាជ្ញាធរ សារណៈ ក្នុង វិស័យ មនុស្សធម៌ » ។
ក្នុង ឱកាស នោះ ក្រុមការងារ ក៏ បាន ណែនាំឲ្យ សិស្សានុសិស្ស ទាំងអស់ ចៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន សូម កុំ ជឿ តាម ការអូសទាញ ពី មិត្តភ័ក្ត ឬ នរណា ម្នាក់ ឡើយ សូម កុំ ចង់ ដឹង ចង់ សាក ឲ្យ សោះ ព្រោះថា គ្រឿងញៀន វា ធ្វើឲ្យ យើង បាត់បង់ នូវ សមត្ថភាព ក្នុង ការពិចារណា ថា អ្វី ខុស អ្វី ត្រូវ និង មិន អាច គ្រប់គ្រង ខ្លួន ឯង បាន ដែល ឈាន ទៅដល់ ការប្រព្រឹត្ត នូវ អំពើ អប្បាយ មុខ ផ្សេង ៗ ធ្វើឱ្យ ប៉ះពាល់ ដល់ អនាគត ខ្លួន ឯង គ្រួសារ និង សង្គមជាតិ ទាំងមូល ផងដែរ ។
សូម បញ្ជាក់ ថា នៅក្នុង ឱកាស នោះ ក្រុមការងារ បាន រៀបចំ ជា សំណួរ ចម្លើយ ដល់ សិស្សានុសិស្ស ហើយ អ្នកឆ្លើយ សំណួរ ត្រូវ នឹង ទទួលបាន មួក សុវត្ថិភាព១ ព្រមទាំង បាន ចែកជូន ឯកសារ ពាក់ព័ន្ធ សុវត្ថិភាព ចរាចរណ៍ ជាច្រើន ទៀត ផងដែរ ៕
( សៀមរាប ) ៖ ក្រោម ការជួយ ឧបត្ថម្ភ គាំទ្រ ពី អង្គការ ភ្លែន អន្តរជាតិ សាលា បឋមសិក្សា ប្រាសាទ គោល នៅ ស្រុក អង្គរ ជុំ ដែល ជា សាលា គំរូ មួយ នៅក្នុង ខេត្ត សៀមរាប បាន បង្កើត ជា សួន សិក្សា ដើម្បី ជួយ ដល់ សិស្ស ក្រៅពី ការរៀន ទ្រឹស្តី ក្នុង ថ្នាក់ អាច ចុះ អនុវត្តន៍ ផ្ទាល់ នៅក្នុង សួន សិក្សា តែម្តង ហើយ អ្វី ដែល ពិសេស នោះ គឺ ទទួលបាន បន្លែ ធម្មជាតិ ដើម្បីឱ្យ សិស្ស ចូល ផ្ទះបាយ រៀន ធ្វើ ម្ហូប និង ទទួលទាន អាហារ ប្រចាំ ថ្ងៃ ។
នៅក្នុង បេសកកម្ម របស់ ក្រុម អ្នកសារព័ត៌មាន ដែល បាន ចុះ ទៅដល់ សាលា បឋមសិក្សា ប្រាសាទ គោល នា ថ្ងៃទី ១២ ខែមិថុនា ឆ្នាំ ២០២៤ លោកគ្រូ ឌឿន ឌឿប គ្រូបង្រៀន នៅ សាលា បឋមសិក្សា ប្រាសាទ គោល បាន ឱ្យដឹង ថា ការរៀបចំ សួន បន្ថែ នេះ ធ្វើឡើង ដើម្បី ផ្សារ ភ្ជាប់ ទ្រឹស្តី ជាមួយនឹង ការអនុវត្ត ផ្ទាល់ ដើម្បីឱ្យ សិស្ស ងាយ យល់ ក្នុង ការរៀនសូត្រ តាមរយៈ ការចូល អនុវត្តន៍ ជាក់ស្តែង ក្នុង សួន សិក្សា នេះ ។
លោកគ្រូ ឌឿន ឌឿប បាន បន្ថែម ថា សួន សិក្សា នេះ មាន រៀបចំ ជា ផ្ទៃ ក្រឡា ផ្សេង ៗ ដើម្បីឱ្យ សិស្ស អាច យក ម៉ែត្រ វាស់ តាម ជាក់ស្តែង បាន ហើយ ក្នុង រង្វង់ ផ្ទៃ ក្រឡា នេះ គឺ ធ្វើ ការដាំ ដំណាំ ហើយ សម្រាប់ ដំណាំ ដែល បាន មក ពី ក្នុង សួន នេះ គឺ បាន យក ដាក់ នៅក្នុង ផ្ទះ បាយ សាលា ដើម្បីឱ្យ កូនសិស្ស មាន បំនិន ចេះ រៀន ចម្អិន ម្ហូប អាហារ ទាំង កូនសិស្ស ស្រី និង កូនសិស្ស ប្រុស ដែល មាន គ្រូ ដឹកនាំ បង្រៀន ផ្ទាល់ ។
លោកគ្រូ ឌឿន ឌឿប បាន បន្ថែម ថា សួន នេះ ដែរ មិន ត្រឹមតែ ជួយ កូនសិស្ស ឱ្យ បាន អនុវត្ត មេរៀន នោះ ទេ ថែមទាំង ជួយ ឱ្យ ពួកគេ មាន បំបិន ចេះ ដាំ បន្លែ ធម្មជាតិ ដោយ មិន ប្រើប្រាស់ សាធាតុ គីមី និង អាច យក ទៅ អនុវត្ត ដាំ នៅ ផ្ទះ ខ្លួន ឯង ផងដែរ ៕
ខាងក្រោម នេះ ជា វីដេអូ ទាំងស្រុង លោកគ្រូ ឌឿន ឌឿ ប៖
ភរិយា លោក ស្តើង សុខុម រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បរិច្ចាគ ៣លាន រៀល ដើម្បី ចូលរួម គាំទ្រ យុទ្ធនាការ « ១ ម៉ឺន រៀល ១ម៉ឺន នាក់ » ឆ្នាំ ២០២៤ របស់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា
( ភ្នំពេញ ) ៖ លោកស្រី ស ឃុន ដារ៉ា ភរិយា លោក ស្តើង សុខុម រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន បរិច្ចាគ ៣លាន រៀល ដើម្បី ចូលរួម គាំទ្រ យុទ្ធនាការ « ១ ម៉ឺន រៀល ១ម៉ឺន នាក់ » ឆ្នាំ ២០២៤ របស់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដែល ផ្ដួច ផ្ដើម ឡើង ដោយ លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ប្រធាន កិត្តិយស នៃ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ។
សូម រីករាយ ទស្សនា និង ស្ដាប់ ចម្រៀង អបអរសាទរ ខួប លើក ទី ៤៧ នៃ ទិវា ចងចាំ ដំណើរ ឆ្ពោះទៅ កា ផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ព ត៖
រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន៖ កូន ឈើ ជាង ១.៣លាន ដើម ត្រូវបាន បណ្តុះ សម្រាប់ ចែកជូន ពលរដ្ឋ ដាំ ដើម្បី បង្កើន ភាព បៃតង សំដៅ បង្កើន គម្រប ព្រៃឈើ ឱ្យ ៦០ ភាគរយ នៅ ឆ្នាំ ២០៥០
( ភ្នំពេញ ) ៖ បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ឱ្យដឹង ថា មកដល់ ពេលនេះ កូន ឈើ ដែល បាន បណ្តុះ នៅ ថ្នាល បណ្តុះ កូន ឈើ មាន ជាង ១លាន ៣សែន ដើម ហើយ បន្ទាប់ពី ការអនុវត្ត ផែនការបណ្ដុះ ដើមឈើ តាំងពី ខែតុលា ឆ្នាំ ២០២៣ សម្រាប់ ចែកជូន ប្រជាពលរដ្ឋ និង សិស្សានុ សិស្ស យក ទៅ ដាំ នៅ តាម ទី សាធារណៈ និង សហគមន៍ ដើម្បី បង្កើន ភាព បៃតង ក៏ ដូចជា សំដៅ បង្កើន គម្រប ព្រៃឈើ កម្ពុជា ឱ្យ បាន ចំនួន ៦០ ភាគរយ នៅ ឆ្នាំ ២០៥០ ។
ការ ឱ្យដឹង បែប នេះ របស់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន បាន ធ្វើឡើង ក្នុង កិច្ច ផ្ដល់ បទសម្ភាសន៍ ជាមួយ អ្នកសារព័ត៌មាន ក្រោយ ពិធី ចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ គ្នា ស្តីពី « ប្រព័ន្ធ ស្រោចស្រព ប្រើប្រាស់ ថាមពល ពន្លឺ ព្រះអាទិត្យ សម្រាប់ ថ្នាល បណ្ដុះ កូន ឈើ ថ្នាក់ តំបន់ ដំបូង បំផុត នៅ កម្ពុជា » រវាង ក្រសួង បរិស្ថាន និង ក្រុមហ៊ុន ភេសជ្ជៈ កូកាកូឡា កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ នាទី ស្ដីការ ក្រសួង បរិស្ថាន ។
ជាមួយនឹង ការបណ្តុះ កូន ឈើ បាន ជាង ១លាន ៣លាន ៣សែន ដើម នេះ ត្រូវបាន លោក រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន គូសបញ្ជាក់ ថា យុទ្ធនាការដាំ ដើមឈើ មួយ លាន ដើម ក្នុង មួយ ឆ្នាំ ក៏ មិន ទាន់ អាច គ្រប់គ្រាន់ ក្នុង ការបង្កើត គំរប ព្រៃឈើ ឡើងវិញ ឱ្យ បាន ៦០ % នៅ ឆ្នាំ ២០៥០ ខាងមុន នៅក្នុង ប្រទេស កម្ពុជា នោះ ទេ ប៉ុន្តែ សូម ចូលរួម ដាំ ដើមឈើ ឱ្យ បាន ច្រើន ។
លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន ឱ្យដឹង យ៉ាង ដូច្នេះ ថា៖ « យុទ្ធនាការដាំ ដើមឈើ យ៉ាងតិច ១លាន ដើម ក្នុង មួយ ឆ្នាំ ដើម្បី បាន កូន ឈើ ទៅ ដាំដុះ ក្រសួង បរិស្ថាន បាន ឱ្យ មន្ទី បរិស្ថា ទាំង ២៥ រាជធានី ខេត្ត ចូលរួម បណ្តុះ រហូតមកដល់ ពេលនេះ បាន ជាង ១លាន ៣សែន ( ចាប់ផ្តើម ពី ខែតុលា ឆ្នាំ ២០២៣ ) ដើម ហើយ » ។
លោក រដ្ឋមន្ត្រី បាន បន្ត ថា ជាក់ស្តែង ការចុះហត្ថលេខា នេះ គឺ ដើម្បី ទទួលយក ក្នុង ភាពជាដៃគូ លើ ការជួយ បំពាក់ ប្រព័ន្ធ ស្រោចស្រព ប្រើប្រាស់ ថាមពល ពន្លឺ ព្រះអាទិត្យ របស់ វិស័យ ឯកជន មួយ នេះ សម្រាប់ ថ្នាល បណ្ដុះ កូន ឈើ ថ្នាក់ តំបន់ នៅ ខេត្ត ត្បូងឃ្មុំ ក្នុង ទំហំ ផ្ទៃដី ៣ហិកតា ដែល អាច បណ្ដុះ កូន ឈើ បាន ១លាន ដើម ក្នុង មួយ ឆ្នាំ ។ ប្រព័ន្ធ ស្រោចស្រព ដើរ ដោយ ថាមពល ព្រះអាទិត្យ នេះ អាច ធានា អាយុកាល បាន រហូតដល់ ២៥ ឆ្នាំ ។
ពាក់ព័ន្ធ នឹង ការដាំ ដើមឈើ នេះ ដែរ លោក រដ្ឋមន្ត្រី ក៏ បាន គូសបញ្ជាក់ ថា៖ « ដាំ ដើមឈើ មួយ ឆ្នាំ ១លាន ដើម នេះ មិន ទាន់ គ្រប់គ្រាន់ ទេ ក្នុង ការពង្រីក គំរប ព្រៃឈើ នៅ កម្ពុជា យើង ឱ្យ បាន ឈានដល់ ជាង ៦០% នៅ ឆ្នាំ ២០៥០ ដូច ដែល បាន ដាក់ចុះ ក្នុង យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល » ។
លោក បណ្ឌិត បាន បញ្ជាក់ ថា កូន ឈើ ជាង ១លាន ៣សែន ដើម នេះ បាន នឹង កំពុង នៅក្នុង ស្ថានីយ បណ្តុះ កូន ឈើ ថ្នាក់ តំបន់ ចំនួន ៥ កន្លែង នៅក្នុង ខេត្ត កំពង់ស្ពឺ កោះ កុង សៀមរាប មណ្ឌលគិរី និង ត្បូងឃ្មុំ ដើម្បី ទុក ចែកជូន ប្រជាពលរដ្ឋ យក ទៅ ដាំ តាម គេហដ្ឋាន សាលារៀន វត្ត អារាម និង តាម សហគមន៍ តំបន់ ការពារ ធម្មជាតិ ។
អភិបាល ស្រុក ស្ទោង ណែនាំ ពលរដ្ឋ ត្រូវ ប្រើប្រាស់ ប័ណ្ណ សមធម៌ តាម គោលការណ៍ ដើម្បី ជា គុណ ប្រយោជន៍ និង មិន ត្រូវ យក ទៅ ដាក់ បញ្ចាំ ជាដាច់ខាត
( កំពង់ធំ )៖ ក្នុង ពិធី ផ្ដល់ ប័ណ្ណ សមធម៌ ជូន ប្រជាពលរដ្ឋ ក្រីក្រ និង ងាយ រង ហានិភ័យ នៅ ឃុំ ព្រះដំរី ស្រុក ស្ទោង ខេត្ត កំពង់ធំ កាលពី ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ លោក សាយ គឹម ឡម អភិបាល ស្រុក ស្ទោង បាន ណែនាំ ដល់ ពលរដ្ឋ ត្រូវ ប្រើប្រាស់ ប័ណ្ណ សមធម៌ តាម គោលការណ៍ ដើម្បី ជា គុណ ប្រយោជន៍ និង មិន ត្រូវ យក ទៅ ដាក់ បញ្ចាំ ជាដាច់ខាត ។
លោក បាន ណែនាំ ដល់ លោក មេឃុំ ព្រះដំរី ត្រូវ ខិតខំ ពង្រឹង គុណភាព ប្រសិទ្ធភាព ការងារ ក្នុង ការផ្ដល់ សេវា ជូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ជាពិសេស ត្រូវ ផ្ដល់ ប័ណ្ណ សមធម៌ ជូន ពលរដ្ឋ ក្នុង មូលដ្ឋាន ប្រកបដោយ បបច្ចុប្បន្នភាព និង តម្លាភាព បំផុត ដើម្បី ឆ្លើយតប ទៅនឹង គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ និង បាន ផ្ដល់ សាច់ប្រាក់ ជូន ដល់ ដៃ ពលរដ្ឋ ក្រីក្រ ពិតប្រាកដ ។
លើស ពី នេះ រដ្ឋបាល ឃុំ ព្រះដំរី ត្រូវ ធ្វើ ការសិក្សា និង គ្រប់គ្រង ប្រព័ន្ធ ធារាសាស្ត្រ ព្រមទាំង ប្រព័ន្ធ ស្រោចស្រព អោយ បាន ពេញលេញ ក្នុង ដៃ ដើម្បី ងាយស្រួល ក្នុង ការស្តារ និង កសាង ថ្មី ៗ ថែម ទៀត និង ការបែងចែក ទឹក ឲ្យបាន គ្រប់គ្រាន់ ដល់ ស្រែ ស្រូវ កសិករ ជាពិសេស ត្រូវ ចេះ គ្រប់គ្រង និង ប្រើប្រាស់ ទឹក ឲ្យបាន ត្រឹមត្រូវ ។
លោក សាយ គឹម ឡម បាន ណែនាំ ដល់ អធិការ នគរបាល ស្រុក ព្រមទាំង នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល និង រដ្ឋបាល ឃុំ ត្រូវ សហការ គ្នា និង ពន្លឿន ការផ្ដល់ សៀវភៅ ឬ ឯកសារ អត្រានុកូលដ្ឋាន អត្តសញ្ញាណប័ណ្ណ សៀវភៅ គ្រួសារ ដើម្បី ពលរដ្ឋ ប្រើប្រាស់ បាន តាម តម្រូវការ ជាពិសេស ដើម្បី ធ្វើ ប័ណ្ណ សមធម៌ ឲ្យបាន ទាន់ ពេល វេលា ។
លោក អភិបាល ស្រុក ស្ទោង ក៏ បាន ណែនាំ ដល់ ប្រជាពលរដ្ឋ ដែល ទទួលបាន ប័ណ្ណ ក្រីក្រ និង ប័ណ្ណ សមធម៌ ទាំងអស់ ត្រូវ ប្រើប្រាស់ បាន នេះ ឲ្យបាន ត្រឹមត្រូវ ជា គុណ ប្រយោជន៍ តាម គោលការណ៍ ជាពិសេស កុំ យក ប័ណ្ណ នេះ ទៅ ប្រើប្រាស់ ខ្ពស់ គោលការណ៍ និង ដាក់ បញ្ចាំ ឲ្យ សោះ ។
គួរ បញ្ជាក់ ថា ប័ណ្ណ សមធម៌ ដែល ត្រូវបាន ចែកជូន ប្រជាពលរដ្ឋ ក្រីក្រ និង ងាយ រង ហានិភ័យ នៅ ឃុំ ព្រះដំរី ស្រុក ស្ទោង នោះ មាន សរុប ចំនួន ១៧៣ ក្នុង នោះ ក្រ១ ចំនួន ២១ ក្រ២ចំនួន ៩០ និង ហានិភ័យ ចំនួន ៦២ប័ណ្ណ ៕
អភិបាល ខេត្ត បាត់ដំបង ណែនាំ ក្រុមប្រឹក្សា ស្រុក បវេល ដែល ចូលកាន់ តំណែង ថ្មី ត្រូវ ខិតខំ បម្រើ ពលរដ្ឋ ឆ្លើយតប តាម តម្រូវការ
( បាត់ដំបង ) ៖ លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង នា ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ បាន អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ស្រុក បវេល អាណត្តិ ទី៤ និង បាន ណែនាំ ក្រុមប្រឹក្សា ស្រុក បវេល ដែល ចូលកាន់ តំណែង ថ្មី ត្រូវ ខិតខំ បម្រើ ប្រជាពលរដ្ឋ ឆ្លើយតប តាម តម្រូវការ ។
ពិធី នេះ បាន ធ្វើឡើង នៅ សាលា ស្រុក បរ វេល ដោយ មាន ចូលរួម សមាជិក សមាជិកា ក្រុមប្រឹក្សា ខេត្ត ប្រធាន មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត គណ: អភិបាល ស្រុក បវេល កងកម្លាំង បី សមាសភាព ក្រុមប្រឹក្សា ស្រុក អាណត្តិ ថ្មី មន្រ្តី រាជការ ចំណុះ ស្រុក បវេល ក្រុមប្រឹក្សា ឃុំ នៃ ស្រុក បវេល ទាំងអស់ ។
លោក សុខ លូ បាន លើកឡើង ថា ពិធី ប្រកាស ចូលកាន់ តំណែង របស់ ក្រុមប្រឹក្សា ស្រុក បវេល អាណត្តិ ទី៤ គឺ យោង តាម អនុលោម តាម មាត្រា ៦២ នៃ ច្បាប់ ស្ដីពី ការគ្រប់គ្រង រដ្ឋបាល រាជធានី ខត្ត ក្រុង ស្រុក ខណ្ឌ ដែល បាន កំណត់ ។
ទន្ទឹម នឹង នោះ លោក បាន អបអរសាទរ និង កោតសរសើរ ដល់ សមាជិក សមាជិកា ក្រុមប្រឹក្សា ស្រុក បវេល ដែល ត្រូវបាន តំណាង ប្រជាពលរដ្ឋ គឺ សមាជិក ក្រុមប្រឹក្សា ឃុំ ផ្ដល់ សេចក្ដីទុកចិត្ត បោះឆ្នោត ជ្រើសរើស ជា សមាជិក ក្រុមប្រឹក្សា ស្រុក បវេល អាណណត្តិ ទី៤ ដើម្បី បន្ត ដឹកនាំ ស្រុក បវេល សំដៅ ចូលរួម ថែរក្សា សុខ សន្ដិភាព ស្ថិរភាព និង បន្ត អភិវឌ្ឍ ឱ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ បន្ថែម ទៀត ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ លោក ធឹម សំអាន អភិបាល ខណ្ឌ ព្រែក ព្នៅ បាន ជួប សំណេះសំណាល សួរសុខទុក្ខ និង ចែក សម្លៀកបំពាក់ ជូន កម្លាំង សណ្ដាប់ធ្នាប់ ខណ្ឌ ព្រែក ព្នៅ ចំនួន ៥០ នាក់ ។
នា ឱកាស នោះ លោក អភិបាល ខណ្ឌ បាន ជំរុញ ឲ្យ កងកម្លាំង សណ្តាប់ធ្នាប់ ទាំងអស់ ត្រូវ ចូលរួម ពង្រឹង ការងារ សន្តិសុខ និង សណ្តាប់ធ្នាប់ សាធារណៈ នៅក្នុង មូលដ្ឋាន អោយ បាន ប្រសើរឡើង ថែម ទៀត ដើម្បី បម្រើ ឲ្យ ប្រយោជន៍ សង្គម និង ប្រជាពលរដ្ឋ ។ លោក អភិបាល ខណ្ឌ ក៏ បាន កោតស សើរ ដល់ កងកម្លាំង សណ្តាប់ធ្នាប់ ខណ្ឌ ដែល បាន ខិតខំ បំពេញ ការងារ កន្លងមក ។
( ភ្នំពេញ ) ៖ លោក កើត ឆែ អភិបាល រង រាជធានី ភ្នំពេញ បាន ណែនាំ ក្រុមហ៊ុន ដែល ដេញថ្លៃ ដែល ដេញថ្លៃ គម្រោង មូលនិធិ អភិវឌ្ឍន៍ សង្កាត់ ឆ្នាំ ២០២៤ ត្រូវ អនុវត្ត ឲ្យបាន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស និង មិន ត្រូវ ធ្វើឲ្យ ប្រជាពលរដ្ឋ ក្តៅ ក្រហាយ ដោយសារតែ ទង្វើ របស់ ខ្លួន ដោយ ខ្វះ ការទទួលខុសត្រូវ ដូច ជា៖ កាយ ដី ជីក ដី ដាក់ លូ មិន ព្រម លប់ វិញ បិទ មុខ ផ្ទះ ប្រជាពលរដ្ឋ ឬ កន្លែង លក់ដូរ របស់ គាត់ បង្ក ទៅជា ការលំបាក ដល់ ប្រជាពលរដ្ឋ ។
ការណែនាំ នេះ ធ្វើឡើង ក្នុង ពិធី ដេញថ្លៃ គម្រោង មូលនិធិ អភិវឌ្ឍន៍ សង្កាត់ ឆ្នាំ ២០២៤ នៅ មូលដ្ឋាន ខណ្ឌ សែនសុខ នា ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ ។
នា ឱកាស នោះ លោក កើត ឆែ ក្នុង នាម តំណាង លោក អភិបាល ឃួង ស្រេង ក៏ បាន ណែនាំ ដល់ ក្រុមហ៊ុន ដែល ដេញថ្លៃ ដែល ដេញថ្លៃ គម្រោង មូលនិធិ អភិវឌ្ឍន៍ សង្កាត់ ឆ្នាំ ២០២៤ ត្រូវ អនុវត្ត ឲ្យបាន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស និង មិន ត្រូវ ធ្វើឲ្យ ប្រជាពលរដ្ឋ ក្តៅក្រហាយ ដោយសារតែ ទង្វើ របស់ ខ្លួន ដោយ ខ្វះ ការទទួលខុសត្រូវ ដូច ជា៖ កាយ ដី ជីក ដី ដាក់ លូ មិន ព្រម លប់ វិញ បិទ មុខ ផ្ទះ ប្រជាពលរដ្ឋ ឬ កន្លែង លក់ដូរ របស់ គាត់ បង្ក ទៅជា ការលំបាក ដល់ ប្រជាពលរដ្ឋ ។
លោក បាន ណែនាំ បន្ត ថា ការ មិន ដាក់ ស្លាកសញ្ញា សម្គាល់ ការដ្ឋាន ឲ្យបាន ត្រឹមត្រូវ ក៏ បង្ក បញ្ហា ដែរ ព្រោះតែ ប៉ះពាល់ ដល់ អ្នកធ្វើដំណើរ និង ម្ចាស់ ផ្ទះ ផ្ទុយទៅវិញ បើ ក្រុមហ៊ុន ណា អនុវត្ត មិន បាន ត្រឹមត្រូវ នឹង ត្រូវ ដាក់ ក្នុង បញ្ជីខ្មៅ (Black list) ដក សិទ្ធ លែង ឱ្យ ដេញថ្លៃ ក្នុង មូលដ្ឋាន ។
អភិបាល រង រាជធានី ភ្នំពេញ បាន លើកឡើង ថា បទពិសោធន៍ កន្លងមក មាន ក្រុមហ៊ុន ទទួល ការបាន ចូលរួម ក្នុង កិច្ច លទ្ធកម្ម នេះ ជាច្រើន ក្នុង នោះ មាន ក្រុមហ៊ុន មួយចំនួន តូច ហ៊ាន ដេញថ្លៃ ទាប ខ្លាំង ជាង តម្លៃ ប៉ាន់ស្មាន ក៏ប៉ុន្តែ ដល់ ពេល អនុវត្ត គម្រោង គឺ មាន ការយឺត ពេល គ្មាន សោភ័ណភាព គ្មាន សុវត្ថិភាព គ្មាន គុណភាព និង មិន អាច ទទួលយក បាន ពោល ក្រុមហ៊ុន នោះ ចូលមក បំផ្លាញ គម្រោង របស់ សង្កាត់ តែម្តង ។
លោក ម៉ូវ ម៉ានិត អភិបាល ខណ្ឌ សែនសុខ បាន ឲ្យដឹង ថា ការដាក់ ដេញថ្លៃ ជាសាធារណៈ នៃ គម្រោង មូលនិធិ អភិវឌ្ឍន៍ សង្កាត់ ទាំង៦ របស់ ខណ្ឌ សែនសុខ ឆ្នាំ ២០២៤ នេះ មាន ១៧គម្រោង ក្នុង នោះ មាន ក្រុមហ៊ុន ចូលរួម ដេញថ្លៃ ចំនួន ១០ ស្រប តាម នីតិវិធី នៃ ការដេញថ្លៃ ។
លោក អភិបាល ខណ្ឌ ថ្លែង ទៀត ថា ចំពោះ សាលា ខណ្ឌ សែនសុខ សាលា សង្កាត់ និង គណៈ គ្រប់គ្រង គម្រោង សង្កាត់ ត្រូវ ជូនដំណឹង ដល់ បណ្តា អង្គភាព ពាក់ពន្ធ័ ពី ផល ប៉ះពាល់ ផ្សេង ៗ ក្នុង ការអនុវត្ត គម្រោង ដើម្បី ចូលរួម សហការ និង ត្រូវ តាមដាន ត្រូត ពិនិត្យ ការអនុវត្ត គម្រោង របស់ អ្នកទទួល ការជាប្រចាំ ដើម្បីឲ្យ សង្កាត់ សម្រេចបាន លទ្ធផល ល្អ ប្រសើរ ត្រឹមត្រូវ តាម បទដ្ឋាន បច្ចេកទេស និង និតិវិធី ណែនាំ បាន កំណត់ ៕
( កណ្ដាល ) ៖ សមាជិក សមាជិកា និង ជា បេក្ខជន ឈរឈ្មោះ ក្រុមប្រឹក្សា គណបក្ស ភ្លើង ទៀន ឃុំ កោះ ខែល ស្រុក ស្អាង ខេត្ត កណ្ដាល ចំនួន ៥នាក់ បាន ប្រកាស ផ្តាច់ ខ្លួន ពី ពួក ក្រុម ជ្រុលនិយម និង បាន ស្នើសុំ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ចូលរួម ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
ថ្នាក់ដឹកនាំ គណ:កម្មាធិការ ប្រត្តិបត្តិ នៅ មូលដ្ឋាន ឃុំ កោះ ខែល ស្រុក ស្អាង នៃ គណបក្ស ភ្លើង ទៀន ដែល ប្រកាស់ ផ្តាច់ ខ្លួន ចេញ ពី គណបក្ស ប្រឆាំង ចំនួន ៥នាក់ រួម មាន៖
* ទី១៖ លោកស្រី ឈិន ថូ សមាជិក ប្រតិបត្តិ និង ជា បេក្ខជន ឈរឈ្មោះ ក្រុមប្រឹក្សា ឃុំ * ទី២៖ លោក ញូង ភុំ សមាជិក ប្រតិបត្តិ និង ជា បេក្ខជន ឈរឈ្មោះ ក្រុមប្រឹក្សា ឃុំ * ទី៣៖ លោក កង វ៉ាន់ សមាជិក ប្រតិបត្តិ និង ជា បេក្ខជន ឈរឈ្មោះ ក្រុមប្រឹក្សា ឃុំ * ទី៤៖ លោក ខន ឌី សមាជិក និង ជា បេក្ខជន ក្រុមប្រឹក្សា ឃុំ * ទី៥៖ លោក គ្រឿន ងិត សមាជិក ប្រតិបត្តិ និង ជា បេក្ខជន ក្រុមប្រឹក្សា ឃុំ ៕ តើ កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព នៅ អ៊ុយក្រែន ក្នុង ប្រទេស ស្វីស ផ្តល់ ប្រយោជន៍ ដល់ សន្តិភាព ដែរ ឬ ទេ ?
( កៀវ )៖ ពិភពលោក កំពុង ចោល ក្រសែភ្នែក ទៅកាន់ ការរៀបចំ កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព នៅ អ៊ុយ ក្រែន ដែល គ្រោង នឹង ធ្វើ នៅ ថ្ងៃទី ១៥ និង ១៦មិថុនា ចុង សប្តាហ៍ នេះ ក្នុង ប្រទេស ស្វីស ។ កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព អ៊ុយក្រែន ខាងមុខ នេះ បាន បដិសេធ ការអញ្ជើញ រុស្ស៊ី ដែល ជា ភាគី សំខាន់ បំផុត នៃ ទំនាស់ ដែល បាន និង កំពុង កើតឡើង នេះ ។ ដូច្នេះ តើ កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព ខាងមុខ នេះ នឹង មាន ប្រយោជន៍ អ្វី ខ្លះ ?
ប៉ុន្តែ កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព អ៊ុយក្រែន នា ពេល ខាងមុខ នេះ បាន បដិសេធ ការអញ្ជើញ រុស្ស៊ី ដែល ជា ភាគី សំខាន់ បំផុត នៃ ទំនាស់ ដ៏ ស្រួច ស្រាល ដែល បាន និង កំពុង កើតឡើង នេះ ។ ដូច្នេះ តើ កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព ខាងមុខ នេះ នឹង មាន ប្រយោជន៍ សម្រាប់ អ្វី ទៅ វិញ ? លោក ហ្សេឡិន ស្គី បាន ធ្វើដំណើរ ទៅ បណ្តា ប្រទេស ក្នុង ទ្វីប អឺរ៉ុប . ទៅ ប្រទេស នៅ អាស៊ី អាគ្នេយ៍ ក៏ ដូចជា ប្រទេស នៅក្នុង តំបន់ មជ្ឈិមបូព៌ា ជាដើម ។
*** តើ មាន ប្រទេស ប៉ុន្មាន ដែល នឹង មក ចូលរួម ក្នុង កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព អ៊ុយក្រែន ក្នុង ប្រទេស ស្វីស
ខណៈ ដែល ប្រទេស មួយចំនួន បាន បដិសេធ មិន ចូលរួម ក្នុង កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព អ៊ុយក្រែន នោះ . លោក ហ្សេឡិន ស្គី បាន ចោទ ដាក់ ទៅ លើ ប្រទេស ចិន និង រុស្ស៊ី ថា បាន ព្យាយាម ប្រើប្រាស់ វិធីសាស្ត្រ ការទូត ក្នុង ការរារាំង ប្រទេស មួយចំនួន ដែល មិន ចូលរួម ដើម្បី ចង់ បំផ្លាញ ដំណើរការ នៃ កិច្ចប្រជុំ កំពូល នេះ ថែម ទៀត ។ បុគ្គលិក សន្តិសុខ ចំនួន ប្រមាណ ៤ពាន់ នាក់ នឹង ត្រូវ ដាក់ពង្រាយ ការពារ សន្តិសុខ ក្នុង ព្រឹត្តិការណ៍ ជំនួប កំពូល នៅក្នុង ប្រទេ ស្វីស នោះ ។
*** តើ នរណា នឹង ទទួលបាន ផលប្រយោជន៍ នៃ កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព នៅ អ៊ុយក្រែន ខណៈ អវត្តមាន រុស្ស៊ី
ក្នុង ពេល ប្រទេស រុស្ស៊ី នឹង គ្មាន វត្តមាន នៅក្នុង កិច្ចប្រជុំ កំពូល នោះ កិច្ចពិភាក្សា រក សន្តិភាព នោះ ត្រូវ គេ និយាយ ថា នឹង មិន អាច រក សន្តិភាព បាន ឡើយ ប៉ុន្តែ កិច្ចប្រជុំ ត្រូវ គេ រំពឹង ថា នឹង មាន ប្រយោជន៍ ដល់ ចំណុច ធំ ៗ យ៉ាងហោច ចំនួន ២ដល់ អ៊ុយក្រែន ។
កិច្ចប្រជុំ នា ពេល ខាងមុខ នេះ នឹង អាច ផ្តោត លើ ចំណុច ៣ក្នុង ចំណោម ១០ ចំណុច នៃ ការដាក់ចេញ សន្តិភាព របស់ អ៊ុយក្រែន ក្នុង នោះ គឺ សន្តិសុខ នុយក្លេអ៊ែ័រ . សន្តិសុខ ស្បៀង និង ការដោះលែង អ្នកទោស សង្គ្រាម និង ដោះលែង កុមារ អ៊ុយក្រែន ដែល ត្រូវបាន គេ ចាប់ ពង្រត់ ។
កិច្ចប្រជុំ កំពូល ស្តីពី សន្តិភាព អ៊ុយក្រែន ខាងមុខ នេះ គឺជា កិច្ចប្រជុំ មួយ ដែល ដាស់ ស្មារតី ដល់ ការយកចិត្តទុកដាក់ របស់ ពិភពលោក ងាក មក រក ប្រទេស អ៊ុយក្រែន វិញ ក្រោយ រយៈពេល ៨ខែ កន្លងមក ដែល ការយកចិត្តទុកដាក់ របស់ ពិភពលោក ងាក ទៅ ខ្លាំង ក្នុង សង្គ្រាម ក្នុង តំបន់ ហ្គាហ្សារវាង អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស់ ប៉ាឡេ ស្ទីន ។
ក្នុង ជំនួប នោះ លោក ហេង សួរ បាន រំលឹក ពី ការជួយ បណ្តុះបណ្តាល និង ការពង្រឹង សមត្ថភាព ដល់ សហព័ន្ធ និយោជក កម្ពុជា កាលពី ពេល កន្លងទៅ ដែល បាន រួមចំណែក ធ្វើឱ្យ និយោជក កម្ពុជា កាន់តែ មាន សមត្ថភាព ខ្ពស់ មួយ កម្រិត បន្ថែម ទៀត ។
ជាមួយគ្នា នេះ លោក រដ្ឋមន្ត្រី ហេង សួរ ក៏ បាន គូសបញ្ជាក់ ពី មហិច្ចតា របស់ កម្ពុជា ដែល ចង់បាន នូវ ការវិនិយោគ លើ ឧស្សាហកម្ម ដែល មាន តម្លៃ បន្ថែម ដូចជា គ្រឿងយន្ត គ្រឿង ម៉ាស៊ីន និង គ្រឿង បង្គុំ ជាដើម ខណៈ ដែល កម្ពុជា បាន ដាក់ចេញ នូវ គោល នយោបាយ នៃ ការបណ្តុះបណ្តាល ជំនាញ បច្ចេកទេស និង វិជ្ជាជីវៈ ។
លោក រដ្ឋមន្ត្រី ក៏ បាន អះអាង ដែរ ថា ទន្ទឹមនឹង តម្រូវការ កំណើន សេដ្ឋកិច្ច និង ការអភិវឌ្ឍ កម្ពុជា ក៏ បាន និង កំពុង បង្កើត ការងារ សមរម្យ សម្រាប់ ប្រជាពលរដ្ឋ ផងដែរ ។ ដែល សបញ្ជាក់ ឱ្យ ឃើញ ពី ការប្តេជ្ញាចិត្ត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការគោរព លក្ខខណ្ឌ ស្តង់ដារ ការងារ តាមរយៈ ការទទួលស្គាល់ នៃ អនុសញ្ញា របស់ អង្គការ អន្តរជាតិ ខាង ការងារ ជាដើម ។
ទន្ទឹមនឹង នេះ លោក រដ្ឋមន្ត្រី ហេង សួរ ក៏ បាន ថ្លែងអំណរគុណ ការិយាល័យ សកម្មភាព វិនិយោគ របស់ ILO ចំពោះ ការចូលរួម គាំទ្រ លើ ការអនុវត្ត ឱ្យ ជោគជ័យ លើ សម្រាប់ ភាពសុខសាន្ត ក្នុង ទំនាក់ទំនង វិជ្ជាជីវៈ នៅ កម្ពុជា ៕
មជ្ឈមណ្ឌល ឯកសារ កោះ ថ្ម ចែក រទេះ រុញ និង កាស ជំនួយ ត្រចៀក ជូន ជន មាន ពិការភាព រស់ នៅ ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត ក្រចេះ
( ត្បូងឃ្មុំ ) ៖ លោក ឡុង ដានី នាយក មជ្ឈមណ្ឌល ឯកសារ កោះ ថ្ម និង ក្រុមការងារ សហការ ជាមួយ អាជ្ញាធរ ភូមិ បាន រៀបចំ កម្មវិធី ចែក រទេះ រុញ និង កាស ជំនួយ ត្រចៀក ជូន អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ដែល មាន ពិការភាព ចំនួន ៤នាក់ រស់ នៅ ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត ក្រចេះ ចាប់ពី ថ្ងៃទី ១២ - ១៣ ខែមិថុនា ឆ្នាំ ២០២៤ ។
ជា ពលរដ្ឋ ម្នាក់ ដែល រស់រាន ពីរ បប ខ្មែរ ក្រហម លោក យិន សាន ឆ្នាំ នេះ មាន វ័យ ៨៧ ឆ្នាំ ហើយ បច្ចុប្បន្ន រស់ នៅ ភូមិ សាទុំ ឃុំ ជាំ ក្រវៀន ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ។ លោក បាន ឱ្យដឹង ថា រទេះ រុញ នេះ ពិតជា មាន សារសំខាន់ បំផុត សម្រាប់ លោក និង ក្រុមគ្រួសារ ។ លោក ពិការ ជើង តាំងពី សម័យ សង្រ្គាម ហើយ ធ្វើឲ្យ ប៉ះ ដល់ ជីវភាព គ្រួសារ ព្រោះ លោក មិន អាច ចេញ ទៅ ធ្វើការងារ ដូចជា មនុស្ស ទូទៅ បាន ណាមួយ គ្មាន អ្នកណា ជួល ធ្វើ ការងារ ឡើយ ។ លោក ពិការ ជើង ខាងឆ្វេង និង ងងឹត ភ្នែក ទាំង សងខាង រយៈពេល ៥ឆ្នាំ មកហើយ ។
លោក យិន សាន បាន បន្ត ថា ពេល លោក ទទួលបាន រទេះ រុញ លោក អាច ធ្វើដំណើរ ទៅ លេង ញាតិមិត្ត បងប្អូន នៅក្នុង ភូមិ ពីព្រោះ មួយ រយៈពេល កន្លងមក លោក មិន ដែល បាន ទៅ ណា មក ណា ទេ ។ ចំពោះ សុខភាព លោក រាល់ ថ្ងៃ មិន ប្រសើរ ទេ លោក មាន ជំងឺ ជាប្រចាំ ព្រោះ រាងកាយ ទ្រុឌទ្រោម និង អាយុ ច្រើន ។ ដោយសារតែ សង្គ្រាម និង សម័យ ខ្មែរ ក្រហម ធ្វើឲ្យ លោក ពិបាក ហើយ រាល់ ថ្ងៃ លោក គិត ច្រើន ណាស់ ។
លោក ពិតជា ត្រេកអរ ដែល មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា ផ្តល់ រទេះ រុញ ដល់ លោក ជា ជនពិការ និង ងងឹត ភ្នែក ទាំង សងខាង ។ លោក គ្មាន អ្វី ក្រៅពី អរគុណ ទៅដល់ ក្រុមការងារ និង មជ្ឈមណ្ឌល ឯកសារ កោះ ថ្ម នៃ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា ដែល យក រទេះ រុញមក ជូន លោក ដោយ ផ្ទាល់ នេះ ។
លោក ឯ ម ប៉ាន់ អាយុ ៨៤ ឆ្នាំ រស់ នៅ ភូមិ សាទុំ ឃុំ ជាំ ក្រវៀន ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ បាន បង្ហាញ ការសប្បាយ ចិត្ត ជាខ្លាំង និង ពេញចិត្ត ចំពោះ កាស ជំនួយ ត្រចៀក ព្រោះ លោក ចាប់ផ្តើម ស្តាប់ មិន ឮ អស់ រយៈពេល ៦ឆ្នាំ មកហើយ ប៉ុន្តែ រយៈពេល ២ឆ្នាំ ដំបូង អាច ស្តាប់ បាន ទាល់ និយាយ ខ្លាំង ៗ ។
លោក ឯ ម ប៉ាន់ បាន ថ្លែងអំណរគុណ ចំពោះ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា និង ក្រុមការងារ ទាំងអស់ បាន ផ្តល់ កាស ជំនួយ ចៀក ដល់ រូបលោក ។ អរគុណ សម្រាប់ ការយកចិត្តទុកដាក់ ដល់ ជន ពិការ និង មនុស្សចាស់ ជរា ។
លោក ម៉ៅ ជិន អាយុ ៩០ ឆ្នាំ រស់ នៅ ភូមិ ឃ្សឹម ឃុំ ឃ្សឹម ស្រុក ស្នួល ខេត្ត ក្រចេះ បាន ឱ្យដឹង ថា លោក ចាប់ផ្ដើម ថ្លង់ និង ញ័រ សរសៃ នៅ ឆ្នាំ ២០២០ បើ គិត ទៅ មាន រយៈពេល ៥ឆ្នាំ ហើយ ។ លោក ពិតជា ពិបាក រស់ នៅ ណាស់ ព្រោះ ពេល កូន ចៅ និយាយ លោក ស្ដាប់ មិន ឮ ពិបាក ក្នុង ចិត្ត ដេក ចាំ តែ ថ្ងៃ ស្លាប់ ។ ថ្ងៃ នេះ លោក ពិតជា មានអារម្មណ៍ សប្បាយរីករាយ ជាខ្លាំង ដែល ក្រុមការងារ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា បាន ផ្ដល់ កាស ជំនួយ ត្រចៀក ដល់ រូបលោក ។
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន ចេញ វីដេអូ ប្រមាណ ជិត ៩នាទី ពន្យល់ អំពី ការលើកទឹកចិត្ដ ផ្នែក ពន្ធដារ សម្រាប់ គម្រោង វិនិយោគ ខេត្ដ ព្រះសីហនុ ។
គម្រោង ទាំង៣ សម្រាប់ ខេត្ត ព្រះសីហនុ ដែល ទទួលបាន ការលើកទឹកចិត្ត ពន្ធដារ រួម មាន៖ * គម្រោង ទី ១៖ គម្រោង វិនិយោគ ពាក់ព័ន្ធ អគារ ជាប់គាំង ពោលគឺ គម្រោង នានា ដែល បាន សាងសង់ ហើយ បាន ផ្អាក ពន្យារ ឬ បញ្ឈប់ ការសាងសង់ ក្នុង ខេត្ត ព្រះសីហនុ ចាប់ពី ឆ្នាំ ២០១៦ * គម្រោង ទី ២៖ គម្រោង វិនិយោគ ដែល អាច ចាប់ផ្តើម អនុវត្ត បាន ភ្លាម ៗ នៅក្នុង ឆ្នាំ ២០២៤ * គម្រោង ទី ៣៖ គឺ ការពង្រីក គម្រោង ដែល មាន ស្រាប់ ៕
លោក Pistorus ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន យ៉ាង ដូច្នេះ ថា « អ្នក ដែល ស័ក្តិសម និង មាន ចំណូលចិត្ត បំផុត នឹង ត្រូវ ជ្រើសរើស ឱ្យ ចូល បម្រើ យោធា » ។ រដ្ឋមន្ត្រី ការពារ ជាតិ រូប នេះ ប្តេជ្ញា ប្រែក្លាយ អាល្លឺម៉ង់ ទៅ ប្រទេស ដែល មាន ការត្រៀមលក្ខណៈ រួច ជាស្រេច សម្រាប់ សង្គ្រាម ដោយ ព្រមាន ថា សង្គ្រាម រវាង សម្ព័ន្ធមិត្ត លោក ខាងលិច របស់ អង្គការ ណា តូ និង រុស្ស៊ី អាច កើតឡើង ក្នុង រយៈពេល ពី ៥ទៅ ៨ឆ្នាំ ខាងមុខ ។
( កំពង់ធំ )៖ សមាជិក ៣នាក់ នៃ រចនាសម្ព័ន្ធ អតីត គណបក្ស សង្គ្រោះ ជាតិ នៅ ភូមិ បឹង ឃុំ គោល ស្រុក ប្រាសាទ សំបូរ ខេត្ត កំពង់ធំ បាន ប្រកាស ផ្ដាច់ ខ្លួន ចេញ ពី គណបក្ស ប្រឆាំង មួយ នេះ ហើយ គោរព ស្នើសុំ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី មាន ឱកាស ចូលរួម ជីវភាព នយោបាយ ជាមួយ បក្ស កាន់អំណាច វិញ ។
ការប្រកាស ផ្ដាច់ ខ្លួន នៅ ពេល នេះ ក្រោយ ពួកគាត់ យល់ឃើញ ថា ទណ្ឌិត សម រង្ស៉ី ជា អ្នកនយោបាយ ដែល តែង ធ្វើ នយោបាយ ទុច្ចរិត ដដែល ៗ ទប់ស្កាត់ អ្នក វិនិយោគ មិន ឲ្យ មក បណ្ដាក់ទុន រក ស៉ី នៅ កម្ពុជា ហើយ ថ្មី ៗ នេះ ថែមទាំង ប្រឆាំង គម្រោង ព្រែក ជីក ហ្វូណន - តេជោ ដែល មាន ផលប្រយោជន៍ ដ៏ មហាសាល ដល់ ប្រទេសជាតិ ថែម ទៀត ។ ពួកគាត់ សូម ប្រកាស ថ្កោល ទោស ទណ្ឌិត សម រង្ស៉ី យ៉ាង ដាច់អហង្កា បំផុត ៕
សម្ពោធ ឆ្លង សមិទ្ធផល នានា ក្នុង វត្ត សុភី រាម ( ហៅ វត្ត បន្ទាយ ត្រោក ) ស្ថិត ក្នុង ឃុំ ស្រែ ស្តុក ស្រុក កណ្តៀង ខេត្ត ពោធិ៍សាត់ ដែល មាន តម្លៃ ជិត ៥០ ម៉ឺន ដុល្លារ
