( អេស្ប៉ាញ ) ៖ ក្នុង ដំណើរទស្សនកិច្ច គោះ ទ្វារ សេដ្ឋកិច្ច នៅ ថ្ងៃអង្គារ ទី ១១ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល អនុប្រធាន ទី១ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា អម ដំណើរ ដោយ គណៈប្រតិភូ កម្ពុជា រួម មាន ពី ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ សមាគម ឧកញ៉ា កម្ពុជា និង សភា ពាណិជ្ជកម្ម កម្ពុជា បាន អញ្ជើញ ចុះ ទស្សនកិច្ច មជ្ឈមណ្ឌល កណ្ដាល របស់ ក្រុមហ៊ុន Acciona Energía ដែល ជា ក្រុមហ៊ុន ដ៏ ធំ មួយ មាន ប្រតិបត្តិការ លើ បច្ចេកវិទ្យា ការផលិត ថាមពល កកើត ឡើងវិញ អស់ រយៈពេល ជាង ៣០ ឆ្នាំ មកហើយ ។
ក្នុង បទបង្ហាញ ជូន គណៈប្រតិភូ កម្ពុជា ក្រុមហ៊ុន Acciona Energía បាន ជម្រាប ជូន អំពី បេសកកម្ម ការងារ និង ប្រតិបត្តិការ វិនិយោគ របស់ ខ្លួន ក្នុង វិស័យ ថាមពល កកើត ឡើងវិញ ពិសេស ឯកទេស ក្នុង ការអភិវឌ្ឍន៍ និង ការគ្រប់គ្រង ដំណោះស្រាយ ថាមពល ប្រកបដោយ និរន្តរភាព ។ ក្រុមហ៊ុន ផលិត ថាមពល ដ៏ ធំ មួយ នេះ មាន បុគ្គលិក ជាង ៥៨.០០០ នាក់ មកពី ៤០ ប្រទេស ផ្សេង ៗ គ្នា បម្រើ ការងារ ។
អាវុធហត្ថ ខេត្ត ស្វាយរៀង ឃាត់ខ្លួន ជនសង្ស័យ ៤នាក់ និង ថ្នាំ ញៀន ២១ កញ្ចប់
( ស្វាយរៀង ) ៖ សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន កងរាជអាវុធហត្ថ ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២៤ បាន បញ្ជូន ជនសង្ស័យ ចំនួន ០៤ នាក់ ទៅ តុលាការ ដើម្បី ផ្ដន្ទាទោស តាម ច្បាប់ ពាក់ព័ន្ធ ករណី រក្សាទុក ឬ ជួញដូរ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ។
ជនសង្ស័យ ទាំង ៤នាក់ ដែល សមត្ថកិច្ច ឃាត់ខ្លួន បាន រួម មាន៖
ទី១. ឈ្មោះ យ៉ន ភារះ ភេទ ប្រុស អាយុ ១៥ ឆ្នាំ ជនជាតិ ខ្មែរ មាន ទីលំនៅ បច្ចុប្បន្ន ស្នាក់ នៅ ភូមិ ស្វាយ យា ឃុំ ស្វាយ យា ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង ។
*២. ឈ្មោះ ស៊ុន សំណាង ភេទ ប្រុស អាយុ ២៣ ឆ្នាំ មាន ទីលំនៅ បច្ចុប្បន្ន ស្នាក់ នៅ ភូមិ ចន្ត្រី ឃុំ ចន្ត្រី ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង ។
*៣. ឈ្មោះ ស៊ិន ស៊ីណែត ភេទ ប្រុស អាយុ ២៣ ឆ្នាំ មាន ទីលំនៅ បច្ចុប្បន្ន ស្នាក់ នៅ ភូមិ ចន្ត្រី ឃុំ ចន្ត្រី ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង ។
អត្ថបទ របស់ លោក ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ឆ្លើយតប ទៅនឹង ការផ្សាយ របស់ ទីភ្នាក់ងារ សារព័ត៌មាន បារាំង AFP ។ កាលពី ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២៤ កន្លងទៅ នេះ សារព័ត៌មាន AFP បាន ផ្សាយ អត្ថបទ មួយ ពាក់ព័ន្ធ នឹង ព្រែក ជីក ហ្វូណន តេជោ ដោយ ដាក់ ចំណងជើង ថា « កម្ពុជា នឹង ចាប់ផ្តើម ការដ្ឋាន គម្រោង ព្រែក ជីក ដែល មាន ភាពចម្រូងចម្រាស នៅ ខែសីហា » ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បន្ត អត្ថាធិប្បាយ នៅក្នុង អត្ថបទ ទៀត ថា គម្រោង ព្រែក ជីក ហ្វូណន តេជោ គឺជា គំនិត ផ្តួចផ្តើម ប្រកបដោយ មហិច្ឆិតា ក្នុង គោលបំណង លើក កំពស់ សមត្ថភាព ដឹកជញ្ជូន និង ឯករាជ្យភាព សេដ្ឋកិច្ច របស់ កម្ពុជា ។ គម្រោង នេះ ត្រូវបាន រចនា ឡើង សម្រាប់ បម្រើ ឱ្យ ការប្រើប្រាស់ របស់ ប្រជាជន ទូទៅ និង គ្មាន គោលបំណង ឬ ផែនការ សម្រាប់ ការប្រើប្រាស់ របស់ នាវា យោធា នោះ ទេ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បាន គូស រំលេច ថា យោង តាម មាត្រា ទី៥៣ នៃ រដ្ឋធម្មនុញ្ញ ព្រះរាជាណាចក្រ កម្ពុជា ការតាំង មូលដ្ឋាន យោធា បរទេស នៅក្នុង ទឹកដី របស់ ប្រទេស កម្ពុជា ត្រូវបាន ហាមឃាត់ ជាដាច់ខាត ដែល នេះ អាច ធានា បាន ថា ព្រែក ជីក នឹង មិន ត្រូវបាន ប្រើប្រាស់ សម្រាប់ បម្រើ ដល់ គោលបំណង យោធា នោះ ទេ ។
សម្រាប់ ការវាយតម្លៃ ហេតុ ប៉ះពាល់ បរិស្ថាន យ៉ាង លម្អិត ដោយ មាន ការចូលរួម ពី អ្នកជំនាញ អន្តរជាតិ ចំនួន ៤៨ នាក់ ធានា បាន ថា គម្រោង ព្រែក ជីក នេះ នឹង មិន មាន ផល ប៉ះពាល់ ទៅ លើ ទន្លេ មេគង្គ ឡើយ ។
ម៉ូដែល ធារាសាស្រ្ត បាន ព្យាករណ៍ ថា ការប៉ះពាល់ ទៅ លើ រំហូរ ទឹក ទន្លេ មេគង្គ មាន ត្រឹមតែ ០.០៦ ភាគរយ ប៉ុណ្ណោះ នៅក្នុង រដូវ ប្រាំង និង មិន មាន ផល ប៉ះពាល់ សោះឡើយ នៅក្នុង រដូវ វស្សា ។
គម្រោង នេះ នឹង បង្កើត ឱ្យ មាន ជម្រក សត្វ ថ្មី ៗ ហើយ ការពារ ការជ្រៀត ចូល នូវ ទឹក ប្រៃ ដែល ផ្តល់ នូវ ការ ការពារ ដល់ ជីវ ចម្រុះ នៅ ដី សណ្ត ទន្លេ មេគង្គ ។
ជាមួយនឹង ការតភ្ជាប់ ដោយ ផ្ទាល់ តាម រយៈ ផ្លូវ ទឹក រវាង ទីក្រុង ភ្នំពេញ និង សមុទ្រ ខេត្ត កែប ព្រែក ជីក នេះ នឹង លើកកម្ពស់ ប្រសិទ្ធិភាព ពាណិជ្ជកម្ម របស់ កម្ពុជា បង្កើត ការងារ ជំរុញ ការអភិវឌ្ឍ រោងចក្រ ឧស្សាហកម្ម ជំរុញ ទេសចរណ៍ ធ្វើឱ្យ ប្រសើរឡើង នូវ ប្រព័ន្ធ ធារាសាស្រ្ត និង ទាក់ទាញ ការវិនិយោគ ដោយ ផ្ទាល់ ពី បរទេស ។ ផលប្រយោជន៍ ទាំង នេះ នឹង ធ្វើឱ្យ ទិដ្ឋភាព សេដ្ឋកិច្ច កម្ពុជា មាន ការផ្លាស់ប្តូរ ប្រែក្លាយ ខ្លួន ជា មជ្ឈមណ្ឌល ភស្ដុភារកម្ម ដ៏ សំខាន់ នៅក្នុង តំបន់ ៕
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣៤ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៨៤ នាក់ ។
ចិន គឺជា ដៃគូ ពាណិជ្ជកម្ម ធំ ជាង គេ របស់ វៀតណាម ប៉ុន្តែ ប្រទេស ជិតខាង ដែល ដឹកនាំ ដោយ បក្ស កុម្មុយនិស្ត ទាំង ពីរ នេះ បានជាប់គាំង ក្នុង វិវាទ ដែន សមុទ្រ អស់ រយៈពេល ជាច្រើន ឆ្នាំ នៅ សមុទ្រ ចិន ខាងត្បូង ។
សេចក្តីថ្លែងការណ៍ បាន ឱ្យដឹង ថា លោក Tô Lâm បាន ថ្លែង ក្នុង ជំនួប មួយ នៅ ទីក្រុង ហាណូយ ថា ប្រទេស ទាំង ពីរ ត្រូវ គោរព ផលប្រយោជន៍ ស្រប ច្បាប់ របស់ គ្នា ទៅ វិញ ទៅមក និង ស្វែងរក ដំណោះស្រាយ ដែល ពេញចិត្ត ស្រប តាម ច្បាប់ អន្តរជាតិ ។
កាលពី ថ្ងៃព្រហស្បតិ៍ ក្រសួង ការបរទេស វៀតណាម បាន និយាយ ថា ខ្លួន មាន ការព្រួយបារម្ភ យ៉ាង ខ្លាំង ចំពោះ វត្តមាន នៃ នាវា ស្ទង់ មតិ របស់ ចិន នៅក្នុង តំបន់ សេដ្ឋកិច្ច ផ្តាច់ មុខ របស់ វៀតណាម ។
ក្នុង ជំនួប នៅ ថ្ងៃអង្គារ នេះ លោក Tô Lâm បាន ថ្លែង ថា ការអភិវឌ្ឍ មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ជាមួយ ចិន គឺជា ជម្រើស យុទ្ធសាស្ត្រ របស់ វៀតណាម និង ជា អាទិភាព ក្នុង គោល នយោបាយ ការបរទេស របស់ ខ្លួន ។
គួរ ជម្រាប ថា ក្នុង អំឡុង ពេល ដំណើរទស្សនកិច្ច ទៅកាន់ ទីក្រុង ហាណូយ របស់ ប្រធានាធិបតី ចិន ស៊ី ជីន ភីង កាលពី ខែធ្នូ កន្លងទៅ វៀតណាម និង ចិន បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង សហប្រតិបត្តិការ រាប់ សិប ក្នុង នោះ រួមទាំង លើ ផ្លូវ ដែក ផងដែរ ។ លោក Tô Lâm បាន បញ្ជាក់ ជាថ្មី នូវ តម្រូវការ ក្នុង ការជំរុញ ការតភ្ជាប់ ផ្លូវ ដែក រវាង ប្រទេស ទាំង ពីរ នៅក្នុង កិច្ចប្រជុំ នោះ ហើយ បាន ស្នើ ឱ្យ ចិន បើក ទីផ្សារ បន្ថែម ទៀត សម្រាប់ ផលិតផល កសិកម្ម របស់ វៀតណាម ៕
ក្នុង ជំនួប នោះ លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ទៅកាន់ លោកស្រី Maria Helena ANDRÉ អំពី តួនាទី យ៉ាង សំខាន់ របស់ ការិយាល័យ សកម្មភាព កម្មករ និយោជិត របស់ ILO ក្នុង ការពង្រឹង សមត្ថភាព ភាព ជា តំណាង នៃ កម្មករ និយោជិត ។ បន្ថែម ពី នេះ លោក រដ្ឋមន្ត្រី ក៏ បាន បញ្ជាក់ ពី ភាពចាំបាច់ នៃ តួនាទី របស់ ការិយាល័យ សកម្មភាព កម្មករ និយោជិត ក្នុង ការពង្រឹង ជំនាញ បច្ចេកទេស ដល់ កម្មករ និយោជិត នៅ កម្ពុជា ដើម្បី ទាក់ទាញ បន្ថែម ទៀត នូវ ឧស្សាហកម្ម ដែល ពឹងផ្អែក លើ ជំនាញ ដែល ជា គោលបំណង ដ៏ ពិសិដ្ឋ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ជាមួយគ្នា នេះ លោកស្រី ប្រធាន ការិយាល័យ បាន ថ្លែងអំណរគុណ ចំពោះ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល តែងតែ ប្តេជ្ញា និង ខិតខំ ប្រឹងប្រែង ធ្វើការ ជាមួយ ការិយាល័យ លោកស្រី ផ្ទាល់ ក៏ ដូចជា អង្គការ អន្តរជាតិ ខាង ការងារ ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ បរិយាកាស នៅក្នុង រោងចក្រ កាន់តែ ប្រសើរ និង សុខដុម ។
ជាមួយគ្នា នេះ ថ្នាក់ដឹកនាំ ទាំង ពីរ បាន ឯកភាព គ្នា បន្ត ពង្រឹង កិច្ចសហប្រតិបត្តិការ និង គាំទ្រ គ្នា ទៅ វិញ ទៅ មក ដើម្បី បន្ត ជំរុញ និង បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការវិនិយោគ ដែល ជា បំណងប្រាថ្នា របស់ គ្រប់ ភាគី ៕
នៅ ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ថ្នាក់ដឹកនាំ គណបក្ស ឆន្ទៈ ខ្មែរ និង ភ្លើង ទៀន នៅក្នុង ខេត្ត កំពង់ចាម ចំនួន ៦នាក់ ទៀត បាន សម្រេចចិត្ត ដើរ ចេញពី បក្ស ដែល ខ្លួន បាន ស្ម័គ្រ ស្មោះ យូរ ឆ្នាំ មកហើយ ។
ថ្នាក់ដឹកនាំ បក្ស ប្រឆាំង ទាំង៦រូប នោះ រួម មាន៖
មូលហេតុ នៃ ការសម្រេចចិត្ត ដើរ ចេញពី បក្ស នេះ ត្រូវបាន ពួកគេ អះអាង ថា បណ្តាល មកពី ការបាត់បង់ ជំនឿចិត្ត ទៅ លើ ជោគវាសនា បក្ស ប្រឆាំង ដែល ខ្វះ សាមគ្គីភាព និង ការបែកបាក់ នៅក្នុង ចំណោម មេដឹកនាំ បក្ស ប្រឆាំង ហើយ ទៅ បង្កើត បក្ស ថ្មី ៗ ជាច្រើន ។
ថ្នាក់ដឹកនាំ បក្ស ប្រឆាំង ទាំង៦នាក់ នេះ បាន គូសបញ្ជាក់ ថា ពួកគេ បាន ប្រឹងប្រែង តស៊ូ ជួយ បក្ស អស់ ជាច្រើន ឆ្នាំ មកហើយ ដោយ រំពឹង ថា បក្ស នឹង មាន ការចម្រើន ។ តែ មិន ដូច ក្តី រំពឹង របស់ ពួកគេ បក្ស ប្រឆាំង បាន ចុះខ្សោយ ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ហើយ ថ្នាក់ដឹកនាំ បក្ស បែកបាក់ គ្នា រត់ ចេញ ទៅ បង្កើត បក្ស ថ្មី រៀង ៗ ខ្លួន ។ ជាពិសេស ពួកគេ មាន ការខឹងសម្បា យ៉ាង ខ្លាំង នឹង ទណ្ឌិត សម រង្ស៉ី ប្រឆាំង គម្រោង ព្រែក ជីក ហ្វូណន តេជោ ដែល ជា គម្រោង ដ៏ មាន ប្រយោជន៍ សម្រាប់ ជាតិ ។
ថ្នាក់ដឹកនាំ បក្ស ប្រឆាំង ទាំង៦នាក់ នេះ បាន ប្រកាស បម្រើ ការពារ ស្ម័គ្រ ស្មោះ ជាមួយ បក្ស ប្រជាជន ដោយ មិន ឆោត ល្ងង់ ជឿ តាម ការអូសទាញ របស់ ក្រុម ប្រឆាំង ជាពិសេស មិន ចាញ់បោក ការអូសទាញ របស់ បុគ្គល សម រង្ស៉ី ទៀត នោះ ឡើយ ៕ លោក សុឹង សុខុម សមាជិក គណៈកម្មាធិការ នាយក និង ជា បេក្ខភាព ឈរឈ្មោះ តំណាងរាស្ត្រ លេខ 3 គណបក្ស ឆន្ទៈ ខ្មែរ ខេត្ត កំពង់ចាម
លោក ស៊ាង បូរ៉ា បេក្ខភាព ឈរឈ្មោះ តំណាងរាស្ត្រ គណបក្ស ឆន្ទៈ ខ្មែរ លេខ 6 ខេត្ត កំពង់ចាម
លោកស្រី យឹម គឹម យាន ប្រធាន ចលនា ស្ត្រី មកពី គណបក្ស ឆន្ទ : ខ្មែរ ខេត្ត កំពង់ចាម
លោក ឈួន សុម៉ានី ប្រធាន គណៈកម្មាធិការ បក្ស ខេត្ត កំពង់ចាម មកពី គណបក្ស ឆន្ទៈ ខ្មែរ
( ភ្នំពេញ ) ៖ លោក គី តិច ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា ប្រធាន មេធាវី រាជ រដ្ឋាភិបាល នៅ រសៀល ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន បន្ដ ជួប ជាមួយ ជនរងគ្រោះ ចំនួន ៣១៩ នាក់ ក្នុង សំណុំរឿង ក្រុមហ៊ុន របស់ អតីត ឧកញ៉ា ឡេង ចាន់ ណា ដែល ជា ក្រុម ជា ទី៤។ ជំនួប នេះ ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ។
លោក បាន បញ្ជាក់ ថា ការជួប ជាមួយ ប្រជាពលរដ្ឋ លើក ទី៤ ជាង ៣០០ នាក់ នៅ ពេល នេះ ក្រោយ ក្រុម មេធាវី រាជ រដ្ឋាភិបាល បាន ជួប ជាមួយ ជនរងគ្រោះ លើក រួច មកហើយ ។ លោក ថា តាម ព័ត៌មាន ដែល លោក ទទួលបាន មាន ប្រជាពលរដ្ឋ ជាង៣.០០០ នាក់ ដែល អះអាង ថា ជនរងគ្រោះ ក្នុង ករណី នេះ ។
សូម រំលឹក ថា កាលពី ថ្ងៃទី ២៩ ខែឧសភា . ថ្ងៃទី ០២ និង ថ្ងៃទី ០៥ ខែមិថុនា កន្លងទៅ នេះ លោក មេធាវី គី តិច ក៏ បាន ជួប ជាមួយ ជនរងគ្រោះ ចំនួន ៣លើក រួច មកហើយ សរុប ប្រមាណ ជាង ១.០០០ នាក់ ។ ការជួប នេះ នឹង ធ្វើឡើង ជា បន្ដ បន្ទាប់ រហូត ទាល់តែ គ្រប់ ចំនួន នៃ ជនរងគ្រោះ ដើម្បី ទទួលយក ព័ត៌មាន ផ្សេង ៗ និង បញ្ចប់ រាល់ ចម្ងល់ ទាំងអស់ របស់ ជនរងគ្រោះ ។
ក្រុមប្រឹក្សា ខេត្ត ពោធិ៍សាត់ អាណត្តិ ថ្មី ថ្វាយ គ្រឿង រន្តាប់ បូជា ជូន លោក ឧកញ៉ា ឃ្លាំង មឿង និង ជំទាវ ខាន់ ខៀវ ដើម្បី សុំ សេចក្តីសុខ សេចក្តី ចម្រើន ជូន ពលរដ្ឋ ក្នុង ថ្ងៃ ប្រកាស ចូលកាន់ តំណែង
ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ បូជនីយដ្ឋាន លោក ឧកញ៉ា ដែល មាន ចម្ងាយ ប្រមាណ ៥គីឡូម៉ែត្រ ពី ទី រួម ខេត្ត ក្បែង នឹង ផ្លូវ ជាតិ លេខ ៥៥ ស្ថិត ក្នុង ភូមិ កំពែង ស្វាយ ឃុំ ស្នាម ព្រះ ស្រុក បាកាន ខេត្ត ពោធិ៍សាត់ ដោយ បាន ការចូលរួម ពី លោក លឹម សុខ តូ អភិបាល រង ខេត្ត តំណាង លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ លោក លោកស្រី ជា ក្រុមប្រឹក្សា ខេត្ត មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត និង មន្ត្រី អ្នកមុខអ្នក ការជាច្រើន ទៀត ។
សូម ជម្រាប ជូន ថា ក្រុមប្រឹក្សា ខេត្ត ពោធិ៍សាត់ ចំនួន ២១ រូប ក្នុង អាណត្តិ ទី៤ ឆ្នាំ ២០២៤ នេះ ត្រូវបាន ប្រកាស ចូលកាន់ មុខតំណែង នា ព្រឹក ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្រោម វត្តមាន លោក កែវ រតនៈ រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ពោធិ៍សាត់ នៅ សាល ប្រជុំ ក្រុមប្រឹក្សា ខេត្ត ៕
អភិសន្តិ បណ្ឌិត ស សុខា និង លោកជំទាវ អញ្ជើញ ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ កម្ពុជា ដល់ ប្រទេស អូស្ត្រាលី ហើយ
ដំណើរទស្សនកិច្ចការងារ របស់ គណៈប្រតិភូ ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ កម្ពុជា រយៈពេល ១សប្តាហ៍ ចាប់ពី ថ្ងៃទី ១០ ដល់ ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០២៤ មាន គោលបំណង ដើម្បី ពិភាក្សា និង ពិនិត្យ លទ្ធភាព ក្នុង ការពង្រឹង នូវ កិច្ចសហប្រតិបត្តិការ ព្រមទាំង ផ្លាស់ប្តូរ បទពិសោធ ទៅ វិញ ទៅ មក លើ ការងារ អន្តោប្រវេសន៍ សន្តិសុខ សាយប័រ និង ការងារ ប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស ៕ តោះ ! មក យល់ដឹង បន្ថែម ពី របៀប ដែល សត្វ ផ្សោត រស់ នៅ និង ការពពោះ កូន ផ្សោត (Video inside)
ដូច្នេះហើយ វា ធ្វើឱ្យ ការសិក្សា ស្រាវជ្រាវ និង ការការពារ ពួកគេ មាន ផល ពិបាក ព្រោះ វា មិន ងាយស្រួល ក្នុង ការយល់ដឹង ពី និន្នាការ ចំនួន នៅលើ មាត្រដ្ឋាន ត្រឹមតែ ប៉ុន្មាន ឆ្នាំ នោះ ឡើយ ។ ដោយឡែក នៅ ពេល ដែល យើង មាន ការប្រមូល ទិន្នន័យ ដែល មាន រយៈពេល ជាច្រើន ទសវត្សរ៍ គឺ វា មាន ភាពងាយស្រួល ហើយ អាច បង្ហាញ អំពី និន្នាការ ចំនួន សត្វ ថា តើ វា មាន ការកើនឡើង ឬ ក៏ ថយចុះ ។
វា តែងតែ ផ្ដល់ នូវ កម្លាំងចិត្ដ នៅ ពេល ដែល បាន ប្រទះឃើញ វត្ដមាន របស់ កូន ផ្សោត ប៉ុន្ដែ វា ក៏ មិន មាន អ្វី ប្រសើរ ជាង នេះ នៅ ពេល ដែល យើង កំពុង ធ្វើការ ជាមួយនឹង ការអភិរក្ស ប្រភេទ សត្វ ដែល ជិត ផុត ពូជ នេះ ផងដែរ !!!
ជាទូទៅ សត្វ គឺ អាច បង្កាត់ ពូជ បាន លុះត្រាតែ មាន បរិស្ថាន សមស្រប ដែល អាច ផ្ដល់ ឱ្យ កូន របស់ វា អាច រស់ នៅ បាន ហើយ មេផ្សោត គឺ មាន ការលះបង់ យ៉ាង ខ្លាំង តាំងពី ពេល ចាប់កំណើត កូន របស់ វា រហូតដល់ បង្កើត កូន ការទទួលយក សារធាតុ ចិញ្ចឹម ដើម្បី ផ្ដល់ ដល់ រាងកាយ របស់ វា ឱ្យ បាន ត្រឹមត្រូវ នៅពេល ពពោះ បន្ទាប់មក ថែរក្សារ កូន ចាប់តាំងពី ពេល កើត ដោយ បំបៅ ដោះ ការការពារ កូន និង បង្រៀន កូន រហូត កូន របស់ វា ក្លាយជា ឯករាជ្យ ។
សត្វ ផ្សោត នឹង មិន ចង់ បន្ថែម នូវ បន្ទុក បន្ថែម ដើម្បី រក ចំណី ចិញ្ចឹម នោះ ទេ ប្រសិនបើ ពួកវា មាន ការលំបាក ក្នុង ការរក ចំណី ដើម្បី រស់ ទៅ ហើយ ។ ដូច្នេះហើយ វត្តមាន និង អវត្តមាន របស់ កូន ផ្សោត គឺជា ការបង្ហាញ ដំបូង ទៅ លើ សុខភាព នៃ ចំនួន របស់ វា ហើយ តាមរយៈ ការពង្រីក សុខភាព ប្រព័ន្ធ អេកូឡូស៊ី គឺ វា អាច ជួយ ដល់ ការកើនឡើង នូវ ចំនួន នៃ មំសាសី ដូចជា ផ្សោត ជាដើម ។
សូម ទស្សនា វីឌីអូ របស់ សត្វ ផ្សោត ដូច ខាងក្រោម៖
ឈ្មួញ កំពុង ធ្វើ អាជីវកម្ម ដឹក លៀស តាម រថយន្ត ធន់ ធំ ក្នុង រដូវ បិទ នេសាទ មួយ ថ្ងៃ ៗ រាប់ តោន នៅ ខេត្ត កំពង់ឆ្នាំង . ប្រជាពលរដ្ឋ ស្នើសុំ ឱ្យ មន្ត្រី ជំនាញ ចាត់ វិធានការ តាម ច្បាប់ ជល ផល
( កំពង់ឆ្នាំង ) ៖ បើ ទោះជា រដូវ នេះ ជា រដូវ បិទ នេសាទ ក៏ដោយ ចុះ តែ បច្ចុប្បន្ន គេ នៅតែ សង្កេតឃើញ ឈ្មួញ រកស៊ី ដឹក លៀស ខុស ច្បាប់ មួយចំនួន នៅតែ បន្ត ដឹក លៀស តាម ទូក យកមក ឡើង រថយន្ត នៅក្នុង ភូមិសាស្ត្រ ខេត្ត កំពង់ឆ្នាំង ជា បន្តបន្ទាប់ ស្ទើរ រាល់ យប់ រាប់ តោន ខណៈ មន្ត្រី ជំនាញ អះអាង ថា ការប្រព្រឹត្ត បទល្មើស ខុស ច្បាប់ ណាមួយ មិន មាន មន្ត្រី ឬ អាជ្ញាធរ ណា អនុញ្ញាតឱ្យ ធ្វើ ដូច្នោះ ឡើយ ។ ចំពោះ ករណី ការដឹកជញ្ជូន លៀស ខាង លើ នេះ លោក បាន ចាត់ ឲ្យ មន្ត្រី រដ្ឋបាល ជលផល ឃ្លាំមើល និង ចាត់ការ ហើយ ។
ករណី ដែល ឈ្មួញ នៅតែ បន្ត ដឹក លៀស យកមក ឡើង រថយន្ត នៅក្នុង ភូមិសាស្ត្រ ខេត្ត កំពង់ឆ្នាំង ជា បន្តបន្ទាប់ ស្ទើរ រាល់ យប់ ទាំង ក្នុង រដូវ បិទ នេសាទ ដូច ខាងលើ នេះ ត្រូវបាន ប្រជាពលរដ្ឋ រិះគន់ ថា ហេតុដូចម្ដេច ក៏ ឈ្មួញ ទាំងនេះ ហ៊ាន ប្រព្រឹត្ត ទង្វើ ផ្ទុយទៅនឹង ច្បាប់ ស្ដីពី ជល ផល ពិសេស គឺ ការធ្វើ សកម្មភាព ដឹក លៀស មាន លក្ខណៈ ទ្រង់ទ្រាយ ធំ ដោយ ដឹក តាម រថយន្ត ធន់ ធំ មាន ចំណុះ រាប់ តោន ដោយ គេ បាន ធ្វើ សកម្មភាព នៅក្នុង រដូវ បិទ នេសាទ ទៀតផង តើ គេ អាច ធ្វើ បាន ដោយ របៀប ណា ? ។
ករណី នេះ ពួកគាត់ បាន រាយការណ៍ ទៀត ថា ភូមិសាស្ត្រ ដែល ត្រូវបាន ក្រុម ឈ្មួញ ដឹក លៀស យកមក ឡើង រថយន្ត ខាងលើ នេះ រួម មាន៖
* ទី ១៖ ស្ថិត នៅ ចំណុច ព្រែក ក្រពើ ពុល ក្នុង ឃុំ ស្វាយជ្រុំ ស្រុក រលាប្អៀរ* ទី ២៖ ឡើង នៅ ចំណុច ចុង កោះ ក្នុង ភូមិ ទី៧ សង្កាត់ ខ្សាម ក្រុង កំពង់ឆ្នាំង ។
ប្រជាពលរដ្ឋ សំណូមពរ ដល់ មន្ត្រី ជំនាញ អាជ្ញាធរ មូលដ្ឋាន សមត្ថកិច្ច ពាក់ព័ន្ធ សូម អនុវត្ត ច្បាប់ ឲ្យបាន ម៉ឺងម៉ាត់ និង ឱ្យ បាន ស្មើភាព គ្នា ជាពិសេស គឺ អនុវត្ត ឲ្យបាន ត្រឹមត្រូវ ទៅតាម ច្បាប់ ស្ដីពី ជល ផល ដែល មាន ស្រាប់ ដើម្បី ការពារ និង អភិរក្ស ធនធាន ធម្មជាតិ ក្នុង បឹង ទន្លេ សាប ។
ទន្ទឹមនឹង នេះ ពួកគាត់ ក៏ សូម សំណូមពរ ដល់ បងប្អូន ជា អ្នក មាន មុខរបរ នេសាទ ធ្វើ យ៉ាងណា អនុវត្ត ឱ្យ បាន តាម ការណែនាំ របស់ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅក្នុង រដូវ បិទ នេសាទ នេះ គឺ កុំ ប្រើ ឧបករណ៍ នេសាទ ណា ដែល ច្បាប់ ហាមឃាត់ ពិសេស គឺ ឧបករណ៍ ស្បៃ មុង ដែល ឧបករណ៍ ប្រភេទ នេះ វា បាន បំផ្លាញ ពូជ មច្ឆា ជាតិ ទាំង កូន ទាំង មេ ។
ចំពោះ ការដឹកជញ្ជូន លៀស ធ្វើ អាជីវកម្ម ខាងលើ នេះ លោក បញ្ជាក់ ថា ប្រសិនបើ លៀស នោះ មាន ទំហំ តូច ល្អិត មាន ទំហំ ក្រោម ក្រឡា២ ហ៊ុន កន្លះ លោក មិន អនុញ្ញាតឱ្យ ដឹក ចេញ បាន ទេ គឺ ត្រូវ យក លៀស នោះ ចាក់ ចូល ទៅក្នុង ទន្លេ វិញ ។
( ប៉េកាំង ) ៖ ថ្ងៃទី ៧ ខែមិថុនា តាម ម៉ោង ក្នុង តំបន់ មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ លើក ទី ៧៨ បាន ពិភាក្សា និង អនុម័ត ជា ឯកច្ឆន្ទ លើ សេចក្តីសម្រេចចិត្ត ស្តីពី ការបង្កើត ទិវា សន្ទនា អរិយធម៌ អន្តរជាតិ ដែល លើកឡើង ដោយ ប្រទេស ចិន ។
ចំណេះដឹង ទូទៅ៖ ជំនឿ បញ្ចុះ សព ឱ្យ អង្គុយ ចោង ហោង
ប្រភព៖ សៀវភៅ ជំនឿ សាសនា ដើម របស់ ខ្មែរ ម្ចាស់ ស្រុក របស់ រាជ បណ្ឌិត្យ សភា កម្ពុជា បទ អត្ថាធិប្បាយ៖ ចំណង មិត្តភាព កម្ពុជា - ចិន កាន់តែ រឹងមាំ ធ្វើឱ្យ វិនិយោគទុន ចិន កាន់តែ ច្រើន មក កម្ពុជា
( ភ្នំពេញ ) ៖ អ្នកជំនាញ ផ្នែក សេដ្ឋកិច្ច និង អ្នកតាមដាន ផ្នែក សង្គម នៅ កម្ពុជា បាន មើលឃើញ ថា ផ្តើម ចេញពី មិត្ត ដែក ថែប ធ្វើឱ្យ អ្នក វិនិយោគទុន ចិន កាន់តែ ច្រើន បាន បណ្តាក់ទុន រកស៊ី នៅ កម្ពុជា ខណៈ ដែល ក្នុង ខែឧសភា ឆ្នាំ ២០២៤ ថ្មី ៗ នេះ ការវិនិយោគ មកពី ប្រទេស ចិន ស្ថិត នៅ លំដាប់ លេខរៀង ទី១ ដោយ បាន រួមចំណែក ជិត ៥០% នៃ ទុន វិនិយោគ សរុប ។
លោក កែវ ពិសិដ្ឋ អ្នកតាមដាន ផ្នែក សង្គម និង បេក្ខជន បណ្ឌិត វិទ្យាសាស្ត្រ នយោបាយ មានប្រសាសន៍ លើកឡើង ថា ទំនាក់ទំនង កម្ពុជា - ចិន បាន ឈានដល់ កម្រិត កំពូល លើ គ្រប់ វិស័យ ដូចជា វិស័យ នយោបាយ ការទូត សេដ្ឋកិច្ច ពាណិជ្ជកម្ម ជាដើម ។ លោក បាន បញ្ជាក់ ថា មូលហេតុ ដែល ជំរុញ ឱ្យ ចិន វិនិយោគ ច្រើន នៅ ប្រទេស កម្ពុជា បែប នេះ មាន កត្តា ច្រើន យ៉ាង៖
ទី១៖ កម្ពុជា និង ចិន គឺជា មិត្ត ដែក ថែប និង តែងតែ ប្តេជ្ញាចិត្ត លើកកម្ពស់ ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ។ ចំណង មិត្តភាព នៃ ប្រទេស ទាំង ពីរ ត្រូវបាន គេ ចាត់ទុក ថា ជា គំរូ ដ៏ ប្រសើរ បំផុត ក្នុង យុគសម័យ ថ្មី នេះ ។
ទី២៖ នៅ តំបន់ អាស៊ី អាគ្នេយ៍ ប្រទេស នានា សុទ្ធតែ ចង់បាន ការវិនិយោគ ពី ប្រទេស ចិន ដែល ជា នាគ ទើប ងើប ពី ដំណេក និង មាន ប្រជាជន រាប់ ពាន់ លាន នាក់ ។ ប៉ុន្តែ ដោយសារ ទីតាំង ភូមិសាស្រ្ត ដ៏ មាន អត្ថប្រយោជន៍ និង ការពង្រីក សេដ្ឋកិច្ច ធ្វើឱ្យ កម្ពុជា អាច ទាក់ទាញ ចំណាប់អារម្មណ៍ យ៉ាង ខ្លាំង ពី ប្រទេស ចិន ដែល បាន ជះ ឥទ្ធិពល ដល់ ការធ្វើ សមាហរណកម្ម របស់ កម្ពុជា ទៅក្នុង ខ្សែ ច្រវាក់ ផ្គត់ផ្គង់ ពិភពលោក ។
ក្នុង កិច្ចសម្ភាសន៍ ជាមួយ អ្នកសាព័ត៌មានវិទ្យុ មិត្តភាព កម្ពុជា ចិន កាលពី ពេល ថ្មី ៗ នេះ ឯកឧត្តម បណ្ឌិត គី សេរី វឌ្ឍន៍ អ្នកវិភាគ សេដ្ឋកិច្ច និង ជា ប្រធាន វិទ្យាស្ថាន សិក្សា ចិន នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន លើកឡើង ថា ចិន និង កម្ពុជា ជា ដៃគូ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម ដែល គួរឱ្យ រៀនសូត្រ តាម ដោយ ភាគី ទាំង ពីរ បាន បន្ត បង្កើន កម្លាំង ពង្រីក ឥទ្ធិពល ជាលំដាប់ ប្រែ ជា មិត្ត ដែក ថែប និង ពន្លាត កិច្ចសហប្រតិបត្តិការ ត្បូង ពេជ្រ ឆកោណ សម្រាប់ ផ្តល់ ប្រយោជន៍ កាន់តែ ច្រើន ដល់ ប្រជាជន នៃ ប្រទេស ទាំង ពីរ ។
ឯកឧត្តម បណ្ឌិត បញ្ជាក់ ថា៖ « បើ យើង និយាយ ពី ទំនាក់ទំនង របស់ ប្រទេស ទាំង ពីរ វិញ គឺ កម្ពុជា បាន ក្លាយជា ដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ ក្លាយជា មិត្ត ដែក ថែប ហើយ បច្ចុប្បន្ន ក្លាយជា មិត្ត ឆកោណ ត្បូង ពេជ្រ មួយ ទៀត ដោយ បាន សហការ គ្នា លើ វិស័យ ចំនួន ៦ ។ អ៊ីចឹង កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច នៃ ប្រទេស ទាំង ពីរ ទី មួយ លើ វិស័យ វិនិយោគ របស់ ចិន ចូលមក កម្ពុជា បាន បង្កើត ការងារ ផលិតកម្ម ក្នុង ប្រទេស វិស័យ ទេសចរណ៍ សុទ្ធតែ បាន ជួយ ជំរុញ កំណើន សេដ្ឋកិច្ច កម្ពុជា » ។
វិទ្យុ មិត្តភាព កម្ពុជា ចិន បុរស មូស្លីម ម្នាក់ នៅ ក្រុង សំពៅ ពូន ខេត្ត កណ្ដាល ត្រូវ គេ ប្រទះឃើញ ស្លាប់ ដោយ មាន ស្នាម របួស ឆេះ ខ្លោច លើ ខ្លួន . សមត្ថកិច្ច កំពុង ស្រាវជ្រាវ បន្ត ទៀត
ហេតុការណ៍ នេះ បាន កើតឡើង កាលពី ថ្ងៃទី ០៨ ខែមិថុនា ឆ្នាំ ២០២៤ ចំណុច ដីចំការ ( មិន បាន ដាំដុះ អ្វី ) ជាប់ មាត់ ព្រែក ជ្រែ ដែល មាន ម្ចាស់ ដី ឈ្មោះ ប្រុក ស៊ា ស្ថិត នៅ ភូមិ ចាស់ សង្កាត់ ព្រែក ស្តី ក្រុង សំពៅ ពូន ខេត្ត កណ្តាល ។
លោក វរសេនីយ៍ ឯក ឈុន ជឺ ឈួន អធិការ នគរបាល ក្រុង សំពៅ ពូន បាន ថ្លែង នៅ ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២៤ ថា ក្រោយ ទទួលបាន ព័ត៌មាន ពី ករណី ប្រទះឃើញ សព សមត្ថកិច្ច និង ពេទ្យ ជំនាញ បាន ចុះ ទៅ ពិនិត្យ . ក្រោយ កោសល្យវិច័យ ឃើញ ថា សាកសព មាន ស្នាម ឆេះ ខ្លោច ហើយ ជា ករណី ឆក់ ខ្សែភ្លើង ដែល គេ រាយ សម្លាប់ ឆក់ កណ្ដុរ ។ ភ្លាម ៗ នោះ សព មិន ទាន់ ស្គាល់ អត្តសញ្ញាណ ហើយក៏ ពិគ្រោះ គ្នា កប់ សាកសព បណ្ដោះអាសន្ន សិន ហើយ ស្រាវជ្រាវ រក គ្រួសារ មក ទទួលយក សព ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ។
លោក អធិការ បន្ត ថា ករណី នេះ កំពុង ស្ថិត ក្នុង ការស្រាវជ្រាវ ព្រោះ ទីតាំង រាយ លួស ឆក់ នៅ កន្លែង ផ្សេង តែ សាកសព បែ ជា នៅ កន្លែង ផ្សេង ទៅ វិញ ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង វប្បធ ម៌៖ ក្មេង ទំនើង និង សិស្សសាលា ដែល ប្រមូលផ្ដុំ គ្នា មិន ចូល សាលា អាជ្ញាធរ មាន សមត្ថកិច្ច ត្រូវ ចាត់ចែង ដោយ យកមក អប់រំ ណែនាំ និង ធ្វើ កិច្ចសន្យា
( កំពង់ឆ្នាំង ) ៖ លោក បណ្ឌិត ហ៉ឺ វីរ : រដ្ឋលេខាធិការ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក កំពង់ត្រឡាច បាន ថ្លែង ថា បញ្ហា ក្មេង ទំនើង និង សិស្សសាលា ដែល ប្រមូលផ្ដុំ គ្នា មិន ចូល សាលា អាជ្ញាធរ មាន សមត្ថកិច្ច ត្រូវ ចាត់ចែង ដោយ យកមក អប់រំ ណែនាំ និង ធ្វើ កិច្ចសន្យា ។
ក្នុង ពិធី នោះ លោក បណ្ឌិត បាន លើកឡើង នូវ បញ្ហា មួយចំនួន រួម មាន៖
* បញ្ហា ស្ទះ ចរាចរណ៍ និង គ្រោះថ្នាក់ ចរាចរណ៍ លោក បណ្ឌិត បាន សំណូមពរ ទៅ មន្ទីរ សាធារណៈ ការ ខេត្ត ដាក់ នូវ ភ្លើង សញ្ញា ចរាចរណ៍ ចំនួន ៣ ទីតាំង រួម មាន៖ ចំណុច ផ្សារ ត្រា ច ស្ថិត នៅ ភូមិ ផ្សារ ត្រា ច ឃុំ លង្វែក ចំណុច ផ្សារ សាលា លេខ ប្រាំ ស្ថិត នៅ ភូមិ សាលា លេខ ប្រាំ ឃុំ អូរឫស្សី និង ចំណុច ផ្សារ ថ្នល់ ទទឹង ស្ថិត នៅ ភូមិ ស្វាយ ក្រោម ឃុំ តា ជេស ។
* បញ្ហា សណ្ដាប់ធ្នាប់ នៅ ទី សាធារណៈ អាជ្ញាធរ ឃុំ ត្រូវ ពន្យល់ ណែនាំ ដល់ ប្រជាពលរដ្ឋ មិន ត្រូវ យក ចំណី ផ្លូវ មក ធ្វើ អាជីវកម្ម ឬ ចត រថយន្ត ដែល ជា ហេតុ បង្ករ ឱ្យ មាន ការកកស្ទះ ។
* បញ្ហា ក្មេង ទំនើង និង សិស្សសាលា ដែល ប្រមូលផ្ដុំ គ្នា មិន ចូល សាលា លោកគ្រូ អ្នកគ្រូ អាណាព្យាបាល និង អាជ្ញាធរ មាន សមត្ថកិច្ច ត្រូវ ចាត់ចែង រឿង នេះ ដោយ យកមក អប់រំ ណែនាំ និង ធ្វើ កិច្ចសន្យា ។
* បញ្ហា អនាម័យ តាម ទី សារធារណៈ ឯកឧត្តម បណ្ឌិត បាន លើកទឹកចិត្ត ឱ្យ មាន ការធ្វើ ចលនា ជា ប្រចាំ នៅ តាម មូលដ្ឋាន របស់ ខ្លួន ។
* បញ្ហា ការបន្ត លក់ នំ កញ្ចប់ និង ទឹក កំប៉ុង នៅ តាម បរិវេណ របស់ សាលារៀន ដែល ជា កត្តា ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខភាព សិស្សនា ពេល អនាគត លោកគ្រូ អ្នកគ្រូ និង អាជ្ញាធរ មាន សមត្ថកិច្ច ត្រូវ ចាត់ វិធានការ ទប់ស្កាត់ ៕
សមត្ថកិច្ច ចាប់ខ្លួន មុខ សញ្ញា ជួញដូរ គ្រឿងញៀន ៥នាក់ នៅ ស្រុក ពញា ឮ ខេត្ត កណ្តាល
( កណ្តាល ) ៖ នគរបាល ស្រុក ពញ្ញា ឮ ខេត្ត កណ្តាល បាន ឃាត់ខ្លួន ក្រុម ក្មេង ទំនើង ដែល កំពុង ជួញដូរ ថ្នាំ ញៀន បាន ៥នាក់ ក្នុង នោះ មាន ម្នាក់ មិន ដឹង មកពី ណា បាន មករារាំង ការងារ សមត្ថកិច្ច ក៏ ត្រូវ សមត្ថកិច្ច ចាប់ ឃាត់ខ្លួន ជាមួយគ្នា តែម្ដង ហើយ សមត្ថកិច្ច កំពុង បន្ត តាម ចាប់ខ្លួន បក្ខពួក ចំនួន ៣នាក់ ផ្សេង ទៀត ដែល រត់គេចខ្លួន អំឡុង ពេល ប្រតិបត្តិការ ។
បើ តាម លោក វរសេនីយ៍ ឯក ដួង តេង អធិការ នគរបាល ស្រុក ពញា ឮ បាន ឱ្យដឹង ថា ជនសង្ស័យ ០៥ នាក់ នេះ ជា មុខសញ្ញា ចាស់ ករណី ប្រើប្រាស់ នូវ សារធាតុ ញៀន ប្រើ ដាវ ជា ប្រភេទ អាវុធ ខុស ច្បាប់ ហើយ ត្រូវបាន ចាប់ខ្លួន កាលពី ថ្ងៃទី ០៩ ខែមិថុនា ឆ្នាំ ២០២៤ នៅ ចំណុច ភូមិ ទន្សា ស្វិត ឃុំ ឈ្វាំង ស្រុក ពញា ឮ ខេត្ត កណ្តាល ។
លោក អធិការ នគរបាល ស្រុក ពញា ឮ បាន បន្ត ថា ជនសង្ស័យ ចំនួន ០៨ នាក់ ក្នុង នោះ ឃាត់ខ្លួន បាន ០៥ នាក់ និង រត់គេចខ្លួន ចំនួន ០៣ នាក់ មាន ឈ្មោះ ដូច ខាងក្រោម៖
នៅ ចំពោះមុខ សមត្ថកិច្ច ជនសង្ស័យ ឈ្មោះ វី វិន បាន សារភាព ថា ក្រុម ខ្លួន ពិតជា បាន ប្រើប្រាស់ ថ្នាំ ញៀន មាន គ្នា ០៧ នាក់ ដូច មាន ឈ្មោះ ខាងលើ នៅក្នុង រោង បាយ ផ្ទះ របស់ ខ្លួន ប្រាកដ មែន ហើយ ថ្នាំញៀន ដែល ប្រើប្រាស់ នេះ គឺ ឈ្មោះ រី ម ជា អ្នក យកមក លក់ ឱ្យ ចំនួន ៤០.០០០ រៀល ដោយ ចូល លុយ គ្នា ទិញ រីឯ ថ្នាំ ដែល នៅសល់ ០១ កញ្ចប់ តូច ត្រូវបាន ឈ្មោះ ណុច ចាក់ បំផ្លាញ ចោល មុន សមត្ថកិច្ច ឆែកឆេរ ។
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង ០៥ នាក់ បាន ឃាត់ខ្លួន នៅ អធិការដ្ឋាន នគរបាល ស្រុក ពញា ឮ ដើម្បី បន្ត អនុវត្ត តាម នីតិវិធី ៕
ក្នុង ជំនួប នា ឱកាស នោះ លោក ផាម មិញ ជិញ បាន សម្តែង ការអបអរសាទរ ចំពោះ លោក រដ្ឋមន្ត្រី ហួត ហាក់ ដែល បាន អញ្ជើញ មក បំបេញ ទស្សនកិច្ច នៅ វៀតណាម លើក ដំបូង ក្នុង តួនាទី ជា រដ្ឋមន្ត្រី ក្រសួង អធិការកិច្ច កម្ពុជា ហើយ លោក បាន ជូន ពរ គណៈប្រតិភូ ក្រសួង អធិការកិច្ច កម្ពុជា បំពេញ ទស្សនកិច្ច ទទួលបាន ជោគជ័យ នៅ វៀតណាម ដើម្បី រួមចំណែក ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស យើង ទាំង ពីរ ឱ្យ កាន់ មាន ប្រសិទ្ធភាព និង បន្ត អភិវឌ្ឍ ចំណង មិត្តភាព ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ រីកចម្រើន បន្ថែម ទៀត ។
ជាមួយគ្នា នេះ លោក នាយក រដ្ឋមន្រ្តី ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន អតីត ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច ដែល សម្តេច បាន ចូលរួមចំណែក យ៉ាង ច្រើន ក្នុង ការពង្រឹង ទំនាក់ទំនង ប្រទេស ទាំង ពីរ ( កម្ពុជា - វៀតណាម ) ដែល ត្រូវតែ ថែរក្សា ពូន ជ្រុំ កសាង ឱ្យ បាន រឹងមាំ បន្ថែម ទៀត ក្នុង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អធិការកិច្ច ប្រទេស ទាំង ពីរ ។
ក្នុង នាម យុវជន បន្ត វេន លោក រដ្ឋមន្ត្រី បាន សម្តែង នូវ ការដឹង គុណ និង គុណូបការៈ ដែល ថ្នាក់ដឹកនាំ បាន បន្សល់ទុក នូវ ស្នាដៃ និង សមិទ្ធផល ជាច្រើន ដែល ជា មូលដ្ឋានគ្រឹះ ដ៏ សំខាន់ សម្រាប់ ការអភិវឌ្ឍ នៅពេល បច្ចុប្បន្ន និង ប្តេជ្ញា បន្ត ថែរក្សា ពូន ជ្រុំ សមិទ្ធផល ទាំងនេះ រួម ជាមួយ ការបង្កើន សមិទ្ធផល ថ្មី ៗ បន្ថែម ទៀត សម្រាប់ ជា ឧត្តម ប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ព្រមទាំង ចូលរួម លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ឱ្យ កាន់តែ ខ្លាំងក្លា បន្ថែម ទៀត ។
តាមរយៈ កាយវិការ ដ៏ ថ្លៃថ្លា នេះ លោក រដ្ឋមន្រ្តី មាន ជំនឿ យ៉ាង មុតមាំ ថា ជំនួប នា ថ្ងៃ នេះ នឹង ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការបន្តពូន ជ្រុំ ទំនាក់ទំនង និង មិត្តភាព ជា ប្រពៃណី ភាពជា អ្នកជិតខាង ល្អ កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ ស្ថេរភាព យូរអង្វែង រវាង ប្រទេស ទាំង ពីរ កាន់តែ ប្រសើរឡើង បន្ថែម ទៀត ៕ នគរបាល ស្រុក ស្វាយ ជ្រំ បន្ត ឃាត់ខ្លួន ក្មេង ទំនើង ២នាក់ បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ក្រោយ វាយ គ្នា នៅ វិទ្យាល័យ ហ៊ុន សែន ស្វាយ ជ្រំ
( ស្វាយរៀង ) ៖ សកម្មភាព ចុះបង្ក្រាប ក្មេង ទំនើង ដែល បង្ក អុក ឡុក នៅ មូលដ្ឋាន របស់ កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក ស្វាយ ជ្រំ បាន ធ្វើឡើង ជា បន្តបន្ទាប់ និង ទទួលបាន ការសាទរ ពី ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ។ ជាក់ស្តែង កម្លាំង នគរបាល បាន បន្ត ស្រាវជ្រាវ និង ឃាត់ខ្លួន ក្មេង ទំនើង ២នាក់ បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ក្រោយ ធ្វើ សកម្មភាព វាយ គ្នា នៅ វិទ្យាល័យ ហ៊ុន សែន ស្វាយ ជ្រំ ។
លោក វរសេនីយ៍ ឯក សោម សុភ័ណ្ឌ អធិការ នគរបាល ស្រុក ស្វាយ ជ្រំ បាន ឱ្យដឹង ថា សមត្ថកិច្ច ជំនាញ បាន ចុះបង្ក្រាប ក្មេង ទំនើង ចំនួន ២នាក់ នេះ ដោយ កាលពី ថ្ងៃទី ៧ ខែមិថុនា ឆ្នាំ ២០២៤ កម្លាំង ជំនាញ បាន ធ្វើ ការ ស្រាវជ្រាវ និង ឃាត់ខ្លួន ក្មេង ទំនើង ២នាក់ ដែល បាន បង្ក សកម្មភាព វាយ គ្នា ទៅ វិញ ទៅមក ក្នុង ទីធ្លា រ វិទ្យាល័យ ហ៊ុន សែន ស្វាយ ជ្រំ ស្ថិត ក្នុង ភូមិ ស្វាយ ក្ងោ ឃុំ ស្វាយ ជ្រំ ស្រុក ស្វាយ ជ្រំ ។
ករណី បង្ក្រាប ក្មេង ទំនើង នេះ បាន ធ្វើឡើង ដោយ មាន ដឹកនាំ ដោយ លោក វរសេនីយ៍ ទោ គឹម សុខ ខា នាយ ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល សហការ ជាមួយ កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក ស្វាយ ជ្រំ និង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ស្វាយ ជ្រំ ។
លោក បាន បញ្ជាក់ ថា បច្ចុប្បន្ន ជនសង្ស័យ ទាំង ២នាក់ ត្រូវបាន បញ្ជូន មក ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល ខេត្ត កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ចាត់ការ តាម នីតិវិធី ច្បាប់ និង បាន ចេញ ដីកា ឃុំ ខ្លួន ក្នុង ពន្ធនាគារ រួចហើយ ផងដែរ ៕ គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស ភ្លើង ទៀន ឃុំ គិរី វ័ន្ត ស្រុក ភ្នំ ស្រួច ចំនួន ៩នាក់ ប្រកាស ដើរ ចេញពី បក្ស និង សុំ រួមរស់ ជាមួយ បក្ស ប្រជាជន កម្ពុជា (Video inside)
( កំពង់ស្ពឺ ) ៖ ជើង ក្រោម របស់ បក្ស ប្រឆាំង នៅ តាម មូលដ្ឋាន កំពុង មាន ចរន្ត ដើរ ចេញ ពី បក្ស របស់ ខ្លួន ប្រៀប ដូច ទឹក ជំនន់ នា រដូវ វស្សា ព្រោះតែ ក្តី ខកចិត្ត ខក បំណង បាត់បង់ ជំនឿ ចំពោះ ការដឹកនាំ របស់ ថ្នាក់ដឹកនាំ បក្ស ការបែកបាក់ ខ្ចាត់ខ្ចាយ ក្នុង ចំណោម មេដឹកនាំ បក្ស ប្រឆាំង ។ ជាពិសេស ការប្រឆាំង គម្រោង ព្រែក ជីក ហ្វូណន តេជោ ពីសំណាក់ ទណ្ឌិត សម រង្ស៉ី ។
នៅ ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស ភ្លើង ទៀន ឃុំ គិរី វ័ន្ត ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ ចំនួន ៩នាក់ ទៀត បាន សម្រេចចិត្ត ដើរ ចេញពី បក្ស ដែល ខ្លួន បាន ស្ម័គ្រ ស្មោះ យូរ ឆ្នាំ មកហើយ ។ មូលហេតុ នៃ ការសម្រេចចិត្ត ដើរ ចេញពី បក្ស នេះ ត្រូវបាន ពួកគេ អះអាង ថា បណ្តាល មកពី ការបាត់បង់ ជំនឿចិត្ត ទៅ លើ ជោគវាសនា បក្ស ប្រឆាំង ដែល ខ្វះ សាមគ្គីភាព និង ការបែកបាក់ នៅក្នុង ចំណោម មេដឹកនាំ បក្ស ប្រឆាំង ហើយ ទៅ បង្កើត បក្ស ថ្មី ៗ ជាច្រើន ។
ពេលនេះ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស ភ្លើង ទៀន នៅ ឃុំ គិរី វ័ន្ត បាន មើលឃើញ ច្បាស់ ដោយ ឥត សង្ស័យ ថា បក្ស ប្រជាជន កម្ពុជា គឺជា បក្ស នយោបាយ តែ មួយ គត់ ដែល មាន គោល នយោបាយ ច្បាស់លាស់ ក្នុង ការដឹកនាំ ជាតិ ក សាង ជាតិ ឱ្យ រីកចម្រើន ។ ជាពិសេស បក្ស ប្រជាជន កម្ពុជា ជា បង្អែក និង ជា ទី ទុកចិត្ត របស់ ប្រជាពលរដ្ឋ ក្នុង ការធានា រក្សា បាន នូវ សុខ សន្តិភាព និង ស្ថេរភាព សង្គម ដែល ជា លក្ខខណ្ឌ ដ៏ ចាំបាច់ សម្រាប់ ធានា នូវ ការ រស់នៅ ប្រកបដោយ ភាពរីករាយ របស់ ប្រជាពលរដ្ឋ ។
ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស ភ្លើង ទៀន នៅ ឃុំ គីរី វ័ន្ត បាន ប្រកាស បម្រើ ការពារ ស្ម័គ្រ ស្មោះ ជាមួយ បក្ស ប្រជាជន ដោយ មិន ឆោត ល្ងង់ ជឿ តាម ការអូសទាញ របស់ ក្រុម ប្រឆាំង ជាពិសេស មិន ចាញ់បោក ការអូសទាញ របស់ បុគ្គល សម រង្ស៉ី ទៀត នោះ ឡើយ ៕
នគរបាល ខេត្ត ស្វាយរៀង បង្ហាញ មុខ ជនជាតិ វៀតណាម ២នាក់ ពាក់ព័ន្ធ ការជួញដូរ គ្រឿងញៀន នៅ ក្រុង បាវិត
( ស្វាយរៀង ) ៖ សមត្ថកិច្ច ជំនាញ ខេត្ត ស្វាយរៀង បាន បង្ហាញ មុខ ជនសង្ស័យ ចំនួន ២នាក់ ជា ជនជាតិ វៀតណាម និង ថ្នាំ ញៀន មួយចំនួន ធំ ដែល សមត្ថកិច្ច បើក ប្រតិបត្តិការ បង្ក្រាប ករណី ជួញដូរ រក្សាទុក និង ប្រើប្រាស់ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន នៅ ក្រុង បាវិត ខេត្ត ស្វាយរៀង កាលពី ថ្ងៃទី ៨ ខែមិថុនា ឆ្នាំ ២០២៤ ។
សមត្ថកិច្ច បាន បញ្ជាក់ ថា លទ្ធផល ឃាត់ខ្លួន ជនសង្ស័យ ០២ នាក់ ( ជនជាតិ វៀតណាម ) រួម មាន៖
* ទី១៖ ឈ្មោះ ង្វៀង មិន ហា ភេទ ប្រុស អាយុ ៣៥ ឆ្នាំ ជនជាតិ វៀតណាម មុខរបរ មិន ពិតប្រាកដ ស្នាក់ នៅ បណ្តោះអាសន្ន បន្ទប់ ជួល ភូមិ បាវិត កណ្តាល សង្កាត់ បាវិត ក្រុង បាវិត ខេត្ត ស្វាយរៀង ។
* ទី២៖ ឈ្មោះ ង្វៀង ធី ធីម ភេទ ស្រី អាយុ ៣២ ឆ្នាំ ជនជាតិ វៀតណាម មុខរបរ មិន ពិតប្រាកដ បច្ចុប្បន្ន ស្នាក់ នៅ បណ្តោះអាសន្ន បន្ទប់ ជួល ភូមិ បាវិត កណ្តាល សង្កាត់ បាវិត ក្រុង បាវិត ។
សមត្ថកិច្ច បាន បន្ត ថា ក្នុង ប្រតិបត្តិការ នេះ បាន ចាប់ យក វត្ថុតាង និង សម្ភារៈ រួម មាន៖ ក្រាម សថ្លា ជា ថ្នាំ ញៀន ប្រភេទ មេតំហ្វេតាមីន ទម្ងន់ ៦០.០០ ក្រាម ថ្នាំ ញៀន ប្រភេទ កេតាមីន ទម្ងន់ ១. ៣៨ក្រាម ថ្នាំ ញៀន ប្រភេទ អុិច ស្តាសុី ទម្ងន់ ៣៣៣. ៣៤ក្រាម ថ្នាំ ញៀន គ្រាប់ ចំនួន ៥៣៧ គ្រាប់ ជញ្ជីង ថ្លឹង ថ្នាំ ញៀន១ គ្រឿង ទូរសព្ទ័ ដៃ៣ គ្រឿង ម៉ូតូ ១គ្រឿង អត្តសញ្ញាណ បណ្ណ វៀតណាម ១សន្លឹក ព្រមទាំង ឧបករណ៍ សម្ភារ វេច ខ្ចប់ និង ប្រើប្រាស់ គ្រឿងញៀន មួយចំនួន ទៀត ។
បច្ចុប្បន្ន ជនសង្ស័យ រួម ជាមួយ វត្ថុតាង ត្រូវបាន កម្លាំង ជំនាញ ផែនការងារ ប្រឆាំង គ្រឿងញៀន បញ្ជូន ទៅកាន់ សាលាដំបូង ខេត្ត ដើម្បី ចាត់ការ បន្ត តាម ច្បាប់ ៕ ឧត្តមសេនីយ៍ ត្រី អេង ហ៊ី អញ្ជើញ ធ្វើ បទ ឧទ្ទេសនាម ស្តីពី ដំណើរ ឆ្ពោះ ទៅ ការផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ដល់ មន្រ្តី អាវុធហត្ថ ២០០ នាក់
ក្នុង នោះ ផងដែរ ប្រតិភូ ក៏ បាន អញ្ជើញ គោរព វិញ្ញា ក្ខន្ធ និង ចងចាំ នូវ ឧបការគុណ យុទ្ធជន កងកម្លាំងប្រដាប់អាវុធ សាមគ្គី សង្គ្រោះ ជាតិ កម្ពុជា និង បុព្វបុរស ដែល ពលី មរណៈ ដើម្បី រំដោះ ប្រទេសជាតិ សង្គ្រោះ អាយុជីវិត ប្រជាជន កម្ពុជា ឱ្យ រួចផុត ពី ការធ្វើ ទារុណកម្ម ការកាប់ សម្លាប់ យ៉ាង សាហាវ យង់ឃ្នង ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
( កណ្តាល )៖ គណៈ គ្រប់គ្រង សាលា សហការ ជាមួយ ក្រុមប្រឹក្សា ឃុំ ត្រើយ ស្លា កម្លាំង សមត្ថកិច្ច នៃ អធិការដ្ឋាន ស្រុក ស្អាង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ត្រើយ ស្លា លោកគ្រូ អ្នកគ្រូ ប្រជាការពារ បាន ចុះ ប្រមូល សិស្សសាលា ចំ នួន ១៧នាក់ ដែល គេច ម៉ោង មិន ចូល រៀន យក ទៅ កោសក់ អប់រំ និង ធ្វើ កិច្ចសន្យា ។ ការចុះ ប្រមូល សិស្ស គេច សាលា ទាំង ១៧នាក់ នេះ បាន ធ្វើឡើង កាល ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២៤ ។
លោក វរសេនីយ៍ ឯក រស់ ចាន់ ថា អធិការ នគរបាល ស្រុក ស្អាង បាន ឱ្យដឹង ថា សិស្ស ដែល បាន គេច ម៉ោង រៀន ទាំង ១៧នាក់ នេះ គឺជា សិស្ស រៀន នៅក្នុង វិទ្យាល័យ សម្តេច ហ៊ុន សែន ត្រើយ ស្លា ដែល ស្ថិត ក្នុង ឃុំ ត្រើយ ស្លា ស្រុក ស្អាង ខេត្ត កណ្តាល សុទ្ធតែ ប្រុស ៗ ទាំងអស់ ។
ជាមួយគ្នា នេះ ដែរ សមត្ថកិច្ច ក៏ បាន អញ្ជើញ ឪពុក ម្តាយ និង អាណាព្យាបាល ឱ្យ មក ទទួលយក កូន ៗ ឱ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ ក្រោយ សមត្ថកិច្ច បាន កោសក់ សិស្ស ទាំង ១៧នាក់ ធ្វើអណាម័យ លត់ ជង្គង់ ក្រាប សំពះ គោរព សុំទោស ឪពុក ម្តាយ និង ធ្វើ កិច្ចសន្យា ថា ឈប់ គេច ពី សាលា ទៀត ហើយ និង សាង ខ្លួន ជា កូន ល្អ សិស្ស ល្អ ចាប់ ពេលនេះ តទៅ ៕
អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន៖ ការចូលរួម ការពារ ធនធាន ធម្មជាតិ ការទុកដាក់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ កាត់បន្ថយ ការប្រើប្រាស់ ជី គីមី និង ប្លាស្ទិក បាន ជំរុញ ឱ្យ ដី ស្អាត ទឹក ស្អាត និង ខ្យល់ ស្អាត
( ប៉ៃលិន ) ៖ លោក ខ្វៃ អាទិត្យា អនុ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន លើកឡើង ថា ចូលរួម ការពារ ធនធាន ធម្មជាតិ ការទុកដាក់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ និង កាត់បន្ថយ ការប្រើប្រាស់ ជី គីមី និង ប្លាស្ទិក ជំរុញ ឱ្យ ដី ស្អាត ទឹក ស្អាត និង ខ្យល់ ស្អាត មាន ការអភិវឌ្ឍ ដោយ ចីរភាព ធានា បាន សន្តិសុខ ស្បៀង ការកាត់បន្ថយ ភាពក្រីក្រ ការកាត់បន្ថយ និង ការបន្ស៊ាំ ទៅនឹង ការប្រែប្រួល អាកាសធាតុ និង ការជំរុញ កំណើន ប្រកបដោយ បរិយាប័ន្ន ។
ជា ការលើកឡើង របស់ លោក ខ្វៃ អាទិត្យា បាន ធ្វើឡើង នៅក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ទិវា បរិស្ថាន ជាតិ និង បរិស្ថាន ពិភពលោក ៥ មិថុនា ក្រោម ប្រធានបទ៖ « ការកែប្រែ គុណភាព ដី ដី រហោស្ថាន និង ធន់ នឹង គ្រោះ រាំងស្ងួត » នា ថ្ងៃអង្គារ ទី ១១ ខែមិថុនា ឆ្នាំ ២០២៤ នៅ ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន ។
ក្នុង ឱកាស នេះ លោក ខ្វៃ អាទិត្យា បាន ជំរុញ ការដាំ ឈើ ឱ្យ បាន ច្រើន ដើម្បី ទប់ស្កាត់ ការហូរច្រោះ គុណភាព ដី ស្រទាប់ ខាងលើ ការកាត់បន្ថយ ការប្រែប្រួល អាកាសធាតុ ការរក្សា ជីវ ចម្រុះ ការដាំ ដំណាំ ឆ្លះ ការកាត់បន្ថយ ការប្រើ ថ្នាំ និង ជី កសិកម្ម ការគ្រប់គ្រង និង ប្រើប្រាស់ ទឹក ឱ្យ បាន ត្រឹមត្រូវ ពង្រឹង ការគ្រប់គ្រង ធនធាន ធម្មជាតិ បញ្ឈប់ ការឈួស ឆាយ ដី ព្រៃ ប្រើប្រាស់ ដី ដែល មិន ធ្វើ ការដាំដុះ ឈើ ឬ ដំណាំ ឡើងវិញ និង ការទុក ដី កសិកម្ម ទំនេរ ចោល ។ល ។
លោក ខ្វៃ អាទិត្យា បាន លើកទឹកចិត្ត ជាថ្មី ទៀត ដល់ មន្រ្តី បរិស្ថាន សហការ ជាមួយ រដ្ឋបាល រាជធានី ខេត្ត មន្ទីរ អង្គភាព ពាក់ព័ន្ធ ជាពិសេស ជាមួយ អាជ្ញារ ក្រុង ស្រុក ភូមិ ឃុំ សង្កាត់ រួមទាំង ប្រជាជន ទូទៅ ដើម្បី ធ្វើឱ្យ កម្ពុជា ដែល ជា ផ្ទះ របស់ យើង ទាំងអស់ គ្នា ស្អាត មាន អនាម័យ និង សេចក្តីថ្លៃថ្នូរ ល្បី លើ ឆាក អន្តរជាតិ ។
លោក ឌិត ទីណា អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខេត្ត បន្ទាយមានជ័យ អាណត្តិ ទី៤
( បន្ទាយមានជ័យ )៖ លោក ឌិត ទីណា រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត បន្ទាយមានជ័យ នៅ ព្រឹក ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២៤ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខេត្ត បន្ទាយមានជ័យ អាណត្តិ ទី៤ នៅ សាល ប្រជុំ រដ្ឋបាល សាលា ខេត្ត បន្ទាយមានជ័យ ។
ថ្លែង ទៅកាន់ អង្គ ពិធី លោក ឌិត ទីណា បាន សម្ដែង សេចក្តី សោមនស្ស រីករាយ និង អបអរសាទរ ដល់ ក្រុមប្រឹក្សា ចំនួន ២៥ រូប ដែល ត្រូវ ប្រកាស ចូលកាន់ តំណែង ។ ជាមួយគ្នា នេះ លោក ឌិត ទីណា បាន គូសបញ្ជាក់ អំពី គោលដៅ រួមគ្នា ក្នុង ការផ្តល់ សេវា សាធារណៈ ធានា សន្តិសុខ សុវត្ថិភាព លើកកម្ពស់ ជីវភាព ប្រជាពលរដ្ឋ និង កាត់បន្ថយ ភាពក្រីក្រ ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ ។
បើ តាម លោក ឌិត ទីណា ដើម្បី សម្រេច ការងារ បាន ស្ថាប័ន និង អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ សហការ ល្អ ធ្វើការ ជាមួយគ្នា ប្រកបដោយ ទទួលខុសត្រូវ ខ្ពស់ និង មាន ភាពម្ចាស់ការ ។
លោក ឌិត ទីណា បាន ផ្ដល់ អនុសាសន៍ ដល់ ក្រុមប្រឹក្សា ត្រូវ ធ្វើការ ជាមួយ អភិបាល ខេត្ត ថ្មី ឲ្យបាន ជិតស្និទ្ធ ទាន់ ពេល ត្រូវ មាន របប ប្រជុំ តាម ការកំណត់ និង ត្រូវ បំពេញ កាតព្វកិច្ច ស្រប តាម នីតិវិធី ច្បាប់ ជាធរមាន ។
លើស ពី នេះ ទៀត លោក ឌិត ទីណា បាន បញ្ជាក់ បន្ថែម ថា ក្រុមប្រឹក្សា ខេត្ត ត្រូវ ប្រជុំ រៀបចំ ផែនការអភិវឌ្ឍ ខេត្ត ដាក់ ចេញ កម្មវិធី កំណែទម្រង់ នានា ស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ពិនិត្យ ការផ្តល់ សេវា សាធារណៈ ជូន ដល់ ប្រជាពលរដ្ឋ ឲ្យ កាន់តែ ខិត ជិត និង កាន់តែ ប្រសើរ ព្រមទាំង ធានា គ្រប់គ្រង សន្តិសុខ សុវត្ថិភាព មូលដ្ឋាន និង ចុះ មូលដ្ឋាន ផ្ទាល់ ដើម្បី ដឹង ពី សុខ ទុក្ខ និង ដោះស្រាយ បញ្ហា ជូន ពលរដ្ឋ ឲ្យបាន ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព ៕
