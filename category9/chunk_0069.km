( ភ្នំពេញ ) ៖ នា ព្រឹក ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នៅ បរិវេណ ទីស្នាក់ការ គណបក្ស សង្កាត់ ព្រែក កំពឹស មាន ការរៀបចំ ពិធី ប្រកាស សមាសភាព ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ មូលដ្ឋាន សង្កាត់ ព្រែក កំពឹស ខណ្ឌ ដង្កោ ក្រោម អធិបតីភាព លោក រ័ត្ន ស្រ៊ាង អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ មូលដ្ឋាន ខណ្ឌ ដង្កោ និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ សង្កាត់ ព្រែក កំពឹស ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក អ៊ុយ សុន អនុប្រធាន ក្រុមការងារ លោក ជុំ ឈាង ប្រធាន គណៈកម្មាធិការ គណបក្ស សង្កាត់ ព្រែក កំពឹស ព្រមទាំងអស់ លោក ក្រុមការងារ អម ដំណើរ លោក លោកស្រី ក្នុង ជួរ គណៈកម្មាធិការ គណបក្ស សង្កាត់ គណៈ សាខា បក្ស និង អនុសាខា បក្ស ព្រមទាំង យុវជន សង្កាត់ សរុប ទាំងអស់ ចំនួន ៣៩៨ នាក់ ។
លោក រ័ត្ន ស្រ៊ាង បាន ឲ្យដឹង ថា ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៦ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី និង បន្ត មក រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ដែល មាន សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ និង សុវត្ថិភាព សង្គម ត្រូវបាន ថែរក្សា យ៉ាង រឹងមាំ ដែល បង្ក លក្ខណៈ ឲ្យ ជីវភាព សង្គម លើ គ្រប់ វិស័យ មាន ដំណើរការ ប្រកបដោយ ភាពវិជ្ជមាន ។
លោក ក៏ បាន រំលេច បន្ថែម អំពី គោល នយោបាយ របស់ គណបក្ស ដែល ប្រកាន់ យក ការការពារ និង លើកស្ទួយ ផលប្រយោជន៍ របស់ ប្រជាជនជា ធំ និង តែងតែ រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន គ្រប់ កាលៈទេសៈ ដូច្នេះ ដើម្បី សន្តិភាព ស្ថិរភាព សុវត្ថិភាព ប្រទេសជាតិ និង ប្រជាជន យើង ត្រូវ ជឿជាក់ លើ គណបក្ស ប្រជាជន ទាំងអស់ គ្នា ។
ដូច ទម្លាប់ កន្លងមក លោក រ័ត្ន ស្រ៊ាង បាន នាំយក នូវ អាហារ សម្រន់ និង ទឹក សុទ្ធ ចែកជូន សមាជិក ចូលរួម ទាំងអស់ បរិភោគ រួមគ្នា ប្រកបដោយ មនោសញ្ចេតនា យ៉ាង ស្និទ្ធស្នាល បំផុត ។ លោក ក៏ បាន ឧបត្ថម្ភ ថវិកា ជូន ដល់ ក្រុមការងារ យុវជន និង កម្លាំង ការពារ សណ្តាប់ធ្នាប់ ដែល បាន ចូលរួម ក្នុង កម្មវិធី នា ឱកាស នោះ គ្រប់ ៗ គ្នា ផងដែរ ៕ នគរបាល ខេត្ត សៀមរាប ឃាត់ខ្លួន ស្ដ្រី ម្នាក់ មក សួរ នាំ ក្រោយ បង្ហោះ វីដេអូ ភ្ជាប់ ជាមួយ សំឡេង ផ្ទុះ អាវុធ នាំឲ្យ មាន ការយល់ ច្រឡំ និង ប៉ះពាល់ ដល់ សន្ដិសុខ
( សៀមរាប ) ៖ ស្ដ្រី ម្ចាស់ គណនី TikTok មួយ ត្រូវបាន ស្នងការដ្ឋាន នគរបាល ខេត្ត សៀមរាប ឃាត់ខ្លួន មក ធ្វើ ការសួរនាំ បន្ទាប់ពី បង្ហោះ វីដេអូ ភ្ជាប់ ជាមួយ សំឡេង ផ្សេង ដែល លឺ សូរ ដូច សំឡេង ផ្ទុះ អាវុធ នាំឲ្យ មាន ការយល់ ច្រឡំ និង ប៉ះពាល់ ដល់ សន្ដិសុខ ជាតិ ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News លោក ឧត្តមសេនីយ៍ ទោ ហួត សុធី ស្នងការ នគរបាល ខេត្ត សៀមរាប បាន ឲ្យដឹង ថា ក្រោយ ឃើញ វីដេអូ នោះ ត្រូវបាន គេ ចែកចាយ និង អនុវត្ត តាម បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ លោក បាន បញ្ជា កម្លាំង ការិយាល័យ ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា ខេត្ត សហការ ជាមួយ កម្លាំង នាយកដ្ឋាន ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា ស្រាវជ្រាវ បន្ទាន់ លើ ករណី នេះ ។
លុះ ដល់ ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២៤ ស្រាប់តែ ខ្លួន បាន ឃេីញ គណនី TikTok របស់ ខ្លួន បាន ធ្វេី ការលោត រំលឹក វីដេអូ ចាស់ ដែល បាន បង្ហោះ ខាង លេី ម្តង ទៀត ពេល នោះ ខ្លួន ក៏ បាន បង្ហោះ លេង សារជាថ្មី ដែល មាន អ្នកចូល មេីល ច្រើន ដោយ ខ្លួន ពុំ បាន គិត ដល់ នាំឲ្យ មាន ការប៉ះពាល់ ដល់ សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម នោះ ទេ ។
ក្រោយ បញ្ចប់ ការសួរនាំ សមត្ថកិច្ច នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត សៀមរាប បាន ធ្វេី កិច្ចសន្យា អប់រំ ណែនាំ និង ថត វីដេអូ សុំទោស ជាសាធារណៈ ៕
ផ្ទះ មនុស្សធម៌ ទី ៩១ និង ទី៩២ ជា អំណោយ របស់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត សៀមរាប ប្រគល់ ជូន គ្រួសារ ក្រីក្រ នៅ ស្រុក សូទ្រនិគម
ក្នុង ឱកាស នេះ លោកស្រី ទុយ ជិ ប្រាក់ សោភ័ណ បាន ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពី សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ក៏ ដូចជា លោក ប្រាក់ សោភ័ណ ប្រធាន គណៈកម្មាធិការ សាខា ដែល តែងតែ យកចិត្តទុកដាក់ គិត គូរ ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ រូប មិន ប្រកាន់ វណ្ណៈ ពណ៌ សម្បុរ ជំនឿ សាសនា ឬ និន្នាការ នយោបាយ ណាមួយ ឡើយ ដូច ដែល លើកឡើង ថា « កាកបាទ ក្រហម កម្ពុជា មាន គ្រប់ ទីកន្លែង សម្រាប់ គ្រប់ ៗ គ្នា - មិន ទុក នរណា ម្នាក់ ចោល ឡើយ » ។
លោកស្រី បាន បន្ត ថា ដោយ ក្តីស្រឡាញ់ និង ការអាណិតអាសូរ ក្រុមគ្រួសារ នេះ លោក តា លោកយាយ អ៊ុំ ពូមីង នឹង បន្ត ជួយ ជ្រោមជ្រែង ផ្តល់ នូវ កម្លាំងចិត្ត និង ចូលរួម ត្រេកអរ ចំពោះ ផ្ទះ មនុស្សធម៌ នេះ ដែល ផ្ទះ នេះ នឹង ក្លាយជា ជំរក ដ៏ កក់ក្តៅ សម្រាប់ គ្រួសារ ទាំង ពីរ ចាប់ពី ពេលនេះ តទៅ ។
លោកស្រី ក៏ បាន ក្រើន រម្លឹក ដល់ លោកយាយ លោក តា អ៊ុំ ពូមីង សូម ប្រុងប្រយ័ត្ន ចំពោះ ខ្យល់ ផ្ករ រន្ទះ សូម រក ទី ជំរក សុវត្ថិភាព ជាពិសេស សុខភាព ជា រឿង សំខាន់ សូម យកចិត្តទុកដាក់ ចំពោះ សុខភាព ផ្ទាល់ខ្លួន និង កូន ចៅ តូច ៗ ដែល ពួកគាត់ ងាយ កើត ជំងឺ ផ្សេង ៗ នៅក្នុង រដូវ វស្សា នេះ និង សូម ទៅ មន្ទីរពេទ្យ ឬ មណ្ឌល សុខភាព ដែល នៅជិត បំផុត បើ ឃើញ ថា អាការៈ សុខភាព មិន ប្រក្រតី ។
នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន បក្ស ភ្លើង ទៀន ក្បាល ម៉ាស៊ីន បក្ស ភ្លើង ទៀន ឃុំ យ៉ា ទុង ស្រុក អូរយ៉ាដាវ ខេត្ត រតនគិរី ចំនួន ៤រូប ទៀត បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព ន យោ បាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
គ្រប់ បណ្តាល ប្រទេស ទាំងអស់ លើ សកលលោក ជំងឺ មហារីក ជា ឃាតករ លាក់មុខ យោង តាម ការប៉ាន់ប្រមាណ របស់ អង្គការ សុខភាព ពិភពលោក ជំងឺ មហារីក នៅ កម្ពុជា មាន និន្នាការកើនឡើង គួរឱ្យ កត់សម្គាល់ ដូច្នេះ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី កម្ពុជា ក៏ ដូចជា ក្រសួង សុខាភិបាល ក្រោម ការដឹកនាំ របស់ លោក សាស្រ្តាចារ្យ ឈាង រ៉ា កំពុង យកចិត្តទុកដាក់ ជាខ្លាំង លើ បញ្ហា នេះ និង ដាក់ចេញ នូវ យុទ្ធសាស្រ្ត អាទិភាព ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កាច សាហាវ នេះ ។
ជំងឺ មហារីក សុដន់ នេះ អាច ព្យាបាល ឱ្យ ជាសះស្បើយ បើ ត្រូវបាន រកឃើញ នៅ ដំណាក់កាល ដំបូង ប៉ុន្តែ ការយឺតយ៉ាវ ក្នុង ការធ្វើ រោគវិនិច្ឆ័យ អាច ដោយសារ ភាពអៀនខ្មាស់ អ្នកជំងឺ ភាគ ច្រើន មក ជួប ពិគ្រោះ ជាមួយ វេជ្ជបណ្ឌិត វេជ្ជបណ្ឌិត ឯកទេស ក្នុង សភាព យឺត ពេល ដែល ស្ថិត ក្នុង ដំណាក់កាល ធ្ងន់ធ្ងរ ត្រូវ ចំណាយ ថវិកា ច្រើន ហើយក៏ មាន ជម្រើស ត្រឹម ការព្យាបាល បន្ធូរបន្ថយ តែ ប៉ុណ្ណោះ ។
នេះ បើ តាម ការបញ្ជាក់ របស់ លោក សាស្ដ្រាចារ្យ ហ៊ុន ចំរើន អគ្គ នាយក រង មន្ទីរពេទ្យ កាល់ម៉ែត បាន ថ្លែង ក្នុង ឱកាស អញ្ជើញ បើក សិក្ខាសាលា របស់ គម្រោង SENOVIE ស្តីពី « ជំងឺ មហារីក សុដន់ » នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ ដែល គម្រោង នេះ ត្រូវបាន បង្កើតឡើង ដោយ មន្ទីរពេទ្យ កាល់ម៉ែត និង វិទ្យាស្ថាន ស្រាវជ្រាវ ដើម្បី ការអភិវឌ្ឍ របស់ ប្រទេស បារាំង ក្រោម ជំនួយ ពី ស្ថានទូត បារាំង នៅ កម្ពុជា ។
លោក សាស្រ្តាចារ្យ ហ៊ុន ចំរើន បាន ថ្លែង បន្ថែម ថា « ខ្ញុំ សូម ផ្តាំផ្ញើ ពាក្យ ខ្លះ ទៅ អ្នក ទាំងអស់ គ្នា ថា ការយល់ដឹង គឺជា ថាមពលរស់ រស់ នៅ ថ្ងៃ នេះ សង្ឃឹម ថ្ងៃស្អែក ក្តីសង្ឃឹម គឺ ខ្លាំង ជាង ការភ័យខ្លាច ភាពក្លាហាន និង ក្ដីសង្ឃឹម គឺ គាំទ្រ ដល់ ទឹកចិត្ត នៃ ការចូលរួម ប្រយុទ្ធ ជាមួយ ជំងឺ ដ៏ កាច សាហាវ នេះ ដើម្បី ស្វែងរក ការព្យាបាល ប្រកបដោយ ប្រសិទ្ធភាព ហើយ បងប្អូន នារី គ្រប់ រូប សុទ្ធតែ អាច តាមដាន សុខភាព សុដន់ ដោយ ខ្លួន ឯង ឱ្យ បាន ទៀងទាត់ យ៉ាងហោចណាស់ ១ ខែម្តង » ។
ទន្ទឹម នឹង នោះ លោក សាស្ដ្រាចារ្យ ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ ភាគី បារាំង និង ភាគី ពាក់ព័ន្ធ ដ៏ទៃ ទៀត ដែល ចូលរួម និង គាំទ្រ គម្រោង SENOVIE នេះ ដំណើរការរលូន ប្រកបដោយ លទ្ធផល ថ្លៃ ផ្កា ។ លោក សាស្រ្តាចារ្យ សង្ឃឹម ជឿជាក់ យ៉ាង មុតមាំ ថា កិច្ចសហប្រតិបត្តិការ នេះ នឹង មាន ភាព ស្ថិតស្ថេរ យូរអង្វែង ដើម្បី ជា ជំហាន បន្ទាប់ ក្នុង ការធ្វើ គម្រោង ផ្សេង ៗ ដែល ជា ប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ កម្ពុជា របស់ យើង ៕
អយ្យការ និង សាលាដំបូង រាជធានី ភ្នំពេញ ចេញ ប្រកាស ព័ត៌មាន ស្ដីពី ការចោទប្រកាន់ និង ចំណាត់ការ នីតិវិធី លើ សំណុំរឿង ពាក់ព័ន្ធ នឹង អំពើ ឃាតកម្ម ប្រព្រឹត្ត ដោយ ឈ្មោះ ស្រី ស៊ីណា
( ភ្នំពេញ ) ៖ ក្រោយ ពិនិត្យ ភស្ដុតាង របាយការណ៍ សន្និដ្ឋាន របស់ សមត្ថកិច្ច និង បាន សាកសួរ គ្រប់ បុគ្គល ពាក់ព័ន្ធ រួច មក នា ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ អយ្យការ អម សាលាដំបូង និង សាលាដំបូង រាជធានី ភ្នំពេញ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន ស្ដីពី ការចោទប្រកាន់ និង ចំណាត់ការ នីតិវិធី លើ សំណុំរឿង ពាក់ព័ន្ធ នឹង អំពើ ឃាតកម្ម ប្រព្រឹត្ត ដោយ ឈ្មោះ ស្រី ស៊ីណា ។
៣០ ថ្ងៃ មក នេះ អយ្យការ និង សាលាដំបូង រាជធានី ខេត្ត ចាត់ការ លើ សំណុំរឿង ពាក់ព័ន្ធ នឹង ក្មេង ទំនើង ២០១ ករណី . ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៨២៨ នាក់
( ភ្នំពេញ ) ៖ រយៈពេល ៣០ ថ្ងៃ ពី ថ្ងៃទី ២៣ ខែឧសភា ដល់ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត បាន ទទួល ចាត់ការ លើ សំណុំរឿង ពាក់ព័ន្ធ នឹង ករណី ក្មេង ទំនើង ចំនួន ២០១ ករណី ដែល មាន ជនសង្ស័យ ចំនួន ១២១៦ នាក់ ហើយ តុលាការ បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៨២៨ នាក់ ។ នេះ បើ តាម លោក ជិន ម៉ាលីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ ។
( ភ្នំពេញ ) ៖ ដៃគូ អភិវឌ្ឍន៍ នានា កំពុង បន្ត អនុវត្តន៍ គម្រោង ជា ច្រើន ក្នុង នោះ មាន ធនាគារ ពិភពលោក ជាដើម ដែល បាន ជួយ កាត់បន្ថយ ភាពក្រីក្រ និង ដោះស្រាយ បញ្ហា នានា ដើម្បី លើក កម្ពស់ ពាណិជ្ជកម្ម នៅ ប្រទេស កម្ពុជា ។
បច្ចុប្បន្ន ធនាគារ ពិភពលោក ដែល ជា ដៃគូ អភិវឌ្ឍន៍ ធំ បំផុត លំដាប់ លេខ ៣ នៅ កម្ពុជា បាន ផ្ដល់ ប្រាក់ កម្ចីសម្បទាន ចំនួន ១៣០០ លាន ដុល្លារ គិត ត្រឹម ឆ្នាំ ២០២៣ ៕
លោក អាន ស៊ី ថា វ អ្នកស្រាវជ្រាវ ព័ត៌មាន សេដ្ឋកិច្ច ពន្យល់ រឿង នេះ ដូចត ទៅ៖
ហិរញ្ញវត្ថុ បៃតង នៅ កម្ពុជា កំពុងតែ រីកចម្រើន ! ក្រុមហ៊ុន ក្នុង ស្រុក ៣ ត្រូវបាន ជ្រើសរើស ក្នុង កម្មវិធី « ការជំរុញ ការបោះផ្សាយ សញ្ញា បណ្ណ និរន្តរភាព នៅ កម្ពុជា វគ្គ ទី២»
( ភ្នំពេញ ) ៖ កម្មវិធី « ការជំរុញ ការបោះផ្សាយ សញ្ញា បណ្ណ និរន្តរភាព នៅ កម្ពុជា (CSBA)» ក្នុង ឆ្នាំ ២០២៤ បាន ជ្រើសរើស ក្រុមហ៊ុន បោះផ្សាយ សញ្ញា បណ្ណ ក្នុង វិស័យ ឯកជន ចំនួន ៣ ដើម្បី ផ្តល់ ការគាំទ្រ លើ ការរៀបចំ ខ្លួន ដើម្បី បោះផ្សាយ សញ្ញា បណ្ណ បៃតង សញ្ញា បណ្ណ សង្គម និង សញ្ញា បណ្ណ ចីរភាព ។ ការបោះផ្សាយ សញ្ញា បណ្ណ ទាំង នេះ នឹង គាំទ្រ ដល់ គម្រោង ដែល ផ្តល់ អត្ថប្រយោជន៍ ដល់ បរិស្ថាន និង សង្គម នៅ ប្រទេស កម្ពុជា ។
ក្រុមហ៊ុន បោះផ្សាយ សញ្ញា បណ្ណ នៅក្នុង ទីផ្សារ កំពុង រីកចម្រើន តែងតែ ប្រឈម នឹង ឧបសគ្គ មួយចំនួន ជាពិសេស ការបោះផ្សាយ សញ្ញា បណ្ណ តាម គម្រោង (Thematic) ( សញ្ញា បណ្ណ បៃតង សង្គម និង ចីរភាព ) ក្រុមហ៊ុន ប្រឈម នឹង ឧបសគ្គ ជាច្រើន បន្ថែម ទៀត ដូចជា ការយល់ដឹង និង សមត្ថភាព របស់ ក្រុមហ៊ុន បោះផ្សាយ នៅ មាន កម្រិត និង ការចំណាយ លើ ការបោះផ្សាយ នៅ មាន តម្លៃ ខ្ពស់ ។
កម្មវិធី នេះ មាន គោលបំណង កាត់បន្ថយ បញ្ហា ប្រឈម ទាំង នេះ ដោយ ការផ្តល់ នូវ ជំនួយ បច្ចេកទេស . ការគាំទ្រ ផ្នែក ហិរញ្ញវត្ថុ ( តាមរយៈ ហិរញ្ញប្បទាន រួម លើ ការត្រួតពិនិត្យ របស់ ភាគី ទី ពីរ ) និង ការពង្រឹង កិច្ច គាំទ្រ លើ ការវិនិយោគ ដល់ ក្រុមហ៊ុន បោះផ្សាយ ដែល ត្រូវបាន ជ្រើសរើស ។
កម្មវិធី នេះ ត្រូវបាន ដាក់ ឲ្យ ដំណើរការ កាលពី ខែកុម្ភៈ ឆ្នាំ ២០២៣ ក្នុង គោលបំណង ជំរុញ ការអភិវឌ្ឍ ទីផ្សារ សញ្ញា បណ្ណ បៃតង និង និរន្តរភាព នៅ ប្រទេស កម្ពុជា និង គោល នយោបាយ . ឧបករណ៍ និង យន្តការពាក់ព័ន្ធ នានា ដើម្បី ជួយ សម្រួល ដល់ ការផ្តល់ ហិរញ្ញប្បទាន ដល់ គំនិត ផ្តួចផ្តើម ការបន្ស៊ាំ និង ការកាត់បន្ថយ ការប្រែប្រួល អាកាសធាតុ ៕ គណៈកម្មាធិការ គណបក្ស ភ្លើង ទៀន នៅ ស្រុក បន្ទាយមាស ខេត្ត កំពត ចេញញ្ញត្តិ គាំទ្រ គម្រោង ព្រែក ជីក ហ្វូណន តេជោ
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស ភ្លើង ទៀន ស្រុក បន្ទាយមាស បាន ចេញញ្ញត្តិ ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ គម្រោង ព្រែក ជីក ហ្វូណន តេជោ ក្រោម គំនិត ផ្តួចផ្តើម របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន ព្រឹទ្ធសភា និង សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន បន្ត ស្នាដៃ អនុវត្ត គម្រោង ព្រែក ជីក ប្រវត្តិសាស្ត្រ នេះ ។
គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស ភ្លើង ទៀន ស្រុក បន្ទាយមាស បាន បញ្ជាក់ ថា ព្រែក ជីក ហ្វូណន តេជោ នឹង ផ្ដល់ ជា អត្ថប្រយោជន៍ និង ជា ទ្រព្យ ដ៏ មហាសាល ជូន ដល់ ប្រទេស កម្ពុជា លើ គ្រប់ វិស័យ ៕
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៩. ២៧៤ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៦. ១៩៦ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៧៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ២២ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៧៩ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៧៩ នាក់ នោះ មាន ៧០ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស គ្រឿងញៀន ២៨ ករណី និង ជនសង្ស័យ ០៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស ព្រហ្មទណ្ឌ ០៨ ករណី ។
រួមគ្នា លើកកម្ពស់ និង ការពារ បរិស្ថាន ! កូន ឈើ ប្រណិត ២ម៉ឺន ដើម ត្រូវ ប្រគល់ជូន រដ្ឋបាល ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ សម្រាប់ ដាំ បន្ត នៅ ជើង ភ្នំ ១០០៥
( ពោធិ៍សាត់ ) ៖ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន បរិច្ចាគ កូន ឈើ ប្រណិត ចំនួន ២០.០០០ ដើម ជូន ដល់ រដ្ឋបាល ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ ដើម្បី គាំទ្រ លើ « យុទ្ធនាការដាំ ដើមឈើ ១លាន ដើម » ។
ក្នុង ចំណោម ប្រភេទ ទាំងនោះ មាន កូន ឈើ ចំនួន ៧ ប្រភេទ ត្រូវបាន ចាត់ ថ្នាក់ ជា ប្រភេទ រង ការគំរាមកំហែង យោង តាម សហភាព អន្តរជាតិ ដើម្បី ការអភិរក្ស ធម្មជាតិ (IUCN) ។ កូន ឈើ ទាំងអស់ នេះ មាន អាយុ ចន្លោះប្រហែល១ ទៅ ១ឆ្នាំ កន្លះ មាន សុខភាព ល្អ និង មាន ភាពធន់ ខ្លាំង ដែល ត្រៀម ក្នុង ការដាំ នៅ ឆ្នាំ នេះ ។
អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ មាន បំណង ការពារ និង អភិរក្ស ព្រៃ រង ទឹកភ្លៀង តំបន់ ជួរ ភ្នំ ក្រវាញ ក៏ ដូចជា ការដាំ ដើមឈើ ដែល បាន បាត់បង់ ឡើងវិញ ផងដែរ ។ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ និង ក្រសួង បរិស្ថាន បាន ធ្វើ ការរួមគ្នា អស់ រយៈពេល ជាង ២ទសវត្ស មក ហើយ ទៅ លើ កិច្ចការពារ ព្រៃ រង ទឹកភ្លៀង របស់ កម្ពុជា ហើយ យុទ្ធនាការ នេះ នឹង ជួយ ពង្រឹង បន្ថែម ទៅ លើ គោលបំណង នោះ ។
លោក ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ ការគាំទ្រ របស់ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន ក្នុង កិច្ចការ ស្តារ គម្រប ព្រៃឈើ របស់ កម្ពុជា ឡើងវិញ និង រដ្ឋបាល ស្រុក វាលវែង លើ ការផ្តល់ តម្លៃ និង ទទួលស្គាល់ នូវ ការបរិច្ចាគ កូន ឈើ ទាំង នេះ ។
បន្ថែម ពី លោក Willis បាន បញ្ជាក់ ថា អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ ជឿជាក់ ថា ការផ្តួចផ្តើម គំនិត ការដាំ ស្តារ ព្រៃឈើ ឡើងវិញ នឹង ជះឥទ្ធិពល ជា វិជ្ជមាន លើ បរិស្ថាន ក៏ ដូចជា ចូលរួមចំណែក ក្នុង ការលើកតម្កើង កេរ្តិ៍ឈ្មោះ រាជ រដ្ឋាភិបាល លើ ឆាក អន្តរជាតិ ផងដែរ ។
លោក ម៉ុម បូផាន់ អភិបាល រង ស្រុក វាលវែង បាន បង្ហាញ ពី ការប្តេជ្ញាចិត្ត ដាំ កូន ឈើ ឡើងវិញ នៅ ទីតាំង ដែល រង ការកាប់ ទន្ទ្រាន ដើម្បី បង្កើន គម្រប់ ព្រៃឈើ ព្រមទាំង ស្នើ ដល់ មន្ត្រី ពាក់ព័ន្ធ បង្កើន សកម្មភាព បន្ថែម ទៀត ដើម្បី ធ្វើ យ៉ាង ទប់ស្កាត់ ការលួច កាប់ ទន្ទ្រាន ព្រៃឈើ ពីសំណាក់ ក្រុម ជន ខិលខូច មួយចំនួន តូត ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
លោក បន្ត ថា « ខ្ញុំ សូម ថ្លែង អំណរគុណ យ៉ាង ជ្រាលជ្រៅ នៅ ការជួយ ឧបត្ថម កូន ឈើ ដើម្បី ដាំ នៅ ស្រុក វាលវែង ក្នុង គោលបំណង អោយ ក្លាយជា ធម្មជាតិ បៃតង ឡើងវិញ » ៕
យល់ដឹង ពី ជំនួញ៖ រដ្ឋបាល ខេត្ដ ព្រះសីហនុ បញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត ក្នុង ការបម្រើ សេវា សាធារណៈ ឱ្យ បាន ល្អ ជូន ពលរដ្ឋ និង អ្នកជំនួញ ដែល បោះ ទុន រកស៊ី (Video inside) ( ភ្នំពេញ ) ៖ លោក ឡុង ឌីម៉ង់ អភិបាល រង និង ជា អ្នកនាំពាក្យ រដ្ឋបាល ខេត្ដ ព្រះសីហនុ បាន បញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត របស់ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ក្នុង ការឆ្លើយតប ក្ដីកង្វល់ នានា របស់ អ្នករកស៊ី ទាក់ទិន នឹង ការរៀបចំ ឯកសារ ។
លោក ឡុង ឌីម៉ង់ បាន ថ្លែង ថា អភិបាល ខេត្ត ព្រះសីហនុ បាន យកចិត្តទុកដាក់ ខ្លាំង ណាស់ លើ សេវា សាធារណៈ ពិសេស ការផ្ដល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ប្រកបដោយ ប្រសិទ្ធភាព ដោយ អាច រក ចំណូល ចូល រដ្ឋ បាន ច្រើន ជាង មុន និង អាច កាត់បន្ថយ ភាពស្មុគស្មាញ ថែម ទៀត ។
លោក បាន បន្ដ ថា សម្រាប់ ខេត្ត ព្រះសីហនុ មិន ចង់ ឃើញ និង មិន ឲ្យ ប្រជាពលរដ្ឋ កាន់ ឯកសារ ពី មួយ កន្លែង ទៅ មួយ កន្លែង ត្រឡប់ ទៅ ត្រឡប់មក នោះ ទេ ដូច្នេះ អ្វី ដែល យើង យល់ ពី ការលំបាក ទាំងនោះ ដូច្នេះ យើង ជំរុញឱ្យ ភាពងាយស្រួល ជូន ប្រជាពលរដ្ឋ ។
លោក បន្ត ថា កត្តា មួយ ទៀត សម្រាប់ អ្នក វិនិយោគ ក្នុង ស្រុក និង ក្រៅ ស្រុក ទាំងអស់ តាមរយៈ ច្បាប់ វិនិយោគ ថ្មី គឺ បាន ធ្វើ ការផ្ដល់ជូន វិមជ្ឈការ ពិសេស ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ក្រសួង សេដ្ឋកិច្ច ក្រសួង មហាផ្ទៃ ជាដើម កំពុង លើកទឹកចិត្ត ក្នុង ការជំរុញ ឲ្យ ការអនុវត្តន៍ យន្ដ ការ អនុគណៈកម្មការ វិនិយោគ រាជធានី ខេត្ត ដើរ តួនាទី ជំនួស ថ្នាក់ ជាតិ មាន ន័យ ថា អនុគណៈកម្មការ វិនិយោគ អាច សម្រេច ឬ ចុះបញ្ជី បាន លើ ការវិនិយោគ តម្លៃ ក្រោម ៥លាន ដុល្លារ ។
លោក បាន បញ្ជាក់ ថា ទាំង នេះ ជា ចំណុច មួយចំនួន ដើម្បី កាត់បន្ថយ ភាពស្មុគស្មាញ ដល់ អ្នក វិនិយោគ ទាំង ក្នុង ស្រុក និង ក្រៅ ស្រុក យន្ដ ការ នេះ ក៏ ដើរ តួនាទី ជា ច្រក ចេញ ចូល តែ មួយ បម្រើ ដល់ អ្នក វិនិយោគ ៕
គួរ បញ្ជាក់ ថា អ៊ុយក្រែន តែងតែ អះអាង ជារឿយ ៗ ពី ការវាយប្រហារ ដោយ ប្រើ ដ្រូន ក្នុង ទឹកដី រុស្ស៉ី ក្នុង គោលបំណង បំផ្លាញ កិច្ចប្រឹងប្រែង សង្រ្គាម របស់ មូស្គូ និង ជា ការឆ្លើយតប ទៅ នឹង ការវាយប្រហារ ឥត ឈប់ឈរ របស់ រុស្ស៉ី លើ ហេដ្ឋារចនាសម្ព័ន្ធ ថាមពល របស់ អ៊ុយក្រែន ៕
អនាគត របស់ អ្នក នឹង បាត់បង់ ប្រសិនបើ អ្នក ជួប គ្រោះថ្នាក់ ចរាចរណ៍ ! ស្លាប់ ៣នាក់ និង របួស ៧នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២២ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ៧នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ឧបត្ថម្ភ ថវិកា ៣ពាន់ ដុល្លារ ជួយ ព្យាបាល ជនរងគ្រោះ ក្នុង ហេតុការណ៍ បាញ់ប្រហារ យ៉ាង ព្រៃផ្សៃ ដោយ អតីត ឧកញ៉ា ស្រី ស៊ីណា (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ឧបត្ថម្ភ ថវិកា ចំនួន ៣ពាន់ ដុល្លារ ជូន ដល់ គ្រួសារ លោក សុខុម ចរណៈ ដែល រង ការបាញ់ប្រហារ យ៉ាង ព្រៃផ្សៃ បំផុត ពី សំណាក់ អតីត ឧកញ៉ា ស្រី ស៊ីណា ។
សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជា មេដឹកនាំ មិន ដែល មើល រំលង ការលំបាក ប្រជាពលរដ្ឋ នោះ ឡើយ ។ រាល់ ពេល ដែល សម្តេច ទាំង ទ្វេ ទទួលបាន ព័ត៌មាន នៃ ការលំបាក របស់ ប្រជាពលរដ្ឋ សម្តេច តែងតែ ជួយ ដោះស្រាយ ជានិច្ច ។
បន្ទាប់ពី ទទួលបាន ព័ត៌មាន នៃ ការរងរបួស របស់ ប្អូន ប្រុស សុខុម ចរណៈ ក្នុង ហេតុការណ៍ បាញ់ប្រហារ ដល់ ក្នុង ផ្ទះ កាលពី ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០២៤ កន្លងទៅ នោះ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត មាន ក្តី អាណិតអាសូរ ជាខ្លាំង ហើយក៏ បាន ឧបត្ថម្ភ ថវិកា សម្រាប់ ការព្យាបាល របួស របស់ គេ ។
ថវិកា ដែល ជា ការឧបត្ថម្ភ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវបាន ជំនួយការយក ទៅ ប្រគល់ ជូន លោក សុខុម ចរណៈ ដល់ កន្លែង សម្រាក ព្យាបាល របួស ។
គ្រួសារ លោក សុខុម ចរណៈ បាន សម្តែង ក្តី គោរព ដឹងគុណ យ៉ាង ជ្រាលជ្រៅ ជូន សម្តេច តេជោ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត និង សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ចំពោះ ទឹកចិត្ត សណ្តោស ប្រណី ហើយ តែងតែ យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ ប្រជាពលរដ្ឋ រាល់ ពេល ជួប ការលំបាក ។
សូម បញ្ជាក់ ថា ក្នុង ហេតុការណ៍ បាញ់ប្រហារ ដ៏ ព្រៃផ្សៃ ខាងលើ នេះ ភ្លាម ៗ ក្រោយ កើត ហេតុ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ចាត់ ឱ្យ លោក ទេសរដ្ឋមន្ត្រី គី តិច ក្នុង ឋានៈ ជា ប្រធាន ក្រុម មេធាវី ស្ម័គ្រចិត្ត របស់ សម្តេច បាន ទៅ ចូលរួម បុណ្យ សព ជនរងគ្រោះ ឡុង លី សុង និង ឃីន កញ្ចនា ដែល ជា គូ ដណ្តឹង ។ បន្ថែម ពីលើ នោះ សម្តេច តេជោ បាន ចាត់ ឱ្យ លោក គី តិច ធ្វើជា មេធាវី ការពារ ស្វែងរក យុត្តិធម៌ ជូន ជនរងគ្រោះ ផងដែរ ។
( កណ្ដាល ) ៖ ចរន្ត ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី កំពុង ពុះកញ្ជ្រោល យ៉ាង ខ្លាំង ព្រោះតែ អស់សង្ឃឹម នឹង ជោគវាសនា បក្ស ប្រឆាំង ដែល ចេះតែ បែកបាក់ គ្នា និង គ្មាន គោល នយោបាយ ច្បាស់លាស់ លើ សកម្មភាព នយោបាយ ។ ជាពិសេស ការធ្វើ នយោបាយ ខ្វះ ការពិចារណា តែង ប្រឆាំង នឹង ប្រយោជន៍ ជាតិ ។
ពិធី ប្រកាស បាន ធ្វើឡើង នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ស្ថិត នៅ ស្នាក់ការ គណបក្ស ខេត្ត កណ្ដាល ក្រោម អធិបតីភាព លោក គង់ សោភ័ណ្ឌ ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត និង លោក នូ សាខ ន អនុប្រធាន គណបក្ស ខេត្ត ។
លោក គង់ សោភ័ណ្ឌ បាន ថ្លែង ថា ជា ទឹកចិត្ត មេត្តា របស់ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា តែងតែ រីករាយ ស្វាគមន៍ អ្នក ដែល បាន ដឹងខ្លួន ភ្ញាក់ រលឹក មក រួមរស់ ជាមួយ គណបក្ស ដែល ត្រឹមត្រូវ និង ពេញ ដោយ សមត្ថភាព ពោលគឺ គណបក្ស ប្រជាជន កម្ពុជា នៅតែ ស្រលាញ់ និង ព្រម ទទួល ជា បន្តបន្ទាប់ ទៀត ឲ្យ តែ មាន បំណង ចង់ រួមរស់ ជាមួយគ្នា ពិតមែន ហើយ រួមគ្នា ដឹកនាំ ក សាង ប្រទេសជាតិ យើង នេះ ឲ្យ រុងរឿង រក្សា ឲ្យបាន ដាច់ខាត នូវ សុខ សន្តិភាព មាន ការរីកចម្រើន លូតលាស់ ទៅ មុខ ជាលំដាប់ ជាដើម ។
សូម ជម្រាប ថា ក្បាល ម៉ាស៊ីន បក្ស ប្រឆាំង នៅ មូលដ្ឋាន ទាំង ១៣២ រូប នេះ បាន សម្តែង ការសោកស្តាយ ជាខ្លាំង ចំពោះ កំហុសឆ្គង ចំពោះ ជាតិ មាតុភូមិ នា ពេល កន្លងទៅ ព្រោះតែ លង់ ជឿ ចំពោះ ការអូសទាញ របស់ ជន ក្បត់ ជាតិ សម រង្ស៉ី ក៏ ដូចជា ក្រុម ប្រឆាំង ជ្រុលនិយម ។ ចាប់ពី ពេលនេះ តទៅ ពួកគេ ឈប់ លង់ ជឿ តាម ការញុះញង់ និង អូសទាញ របស់ ទណ្ឌិត ក្បត់ ជាតិ សម រង្ស៉ី និង បក្ខពួក ទៀត ។
ពួកគេ បាន មើលឃើញ ច្បាស់ ដោយ ឥត សង្ស័យ ថា គណបក្ស ប្រជាជន កម្ពុជា គឺជា បក្ស នយោបាយ តែ មួយ គត់ ដែល មាន គុណ បំណាច់ ដ៏ ធំធេង សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ។ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន ជា មេដឹកនាំ ដ៏ ខ្លាំង ពូកែ ដែល បាន ប្រឹងប្រែង រំដោះ អាយុជីវិត ជាតិ និង ប្រជាជន ពី របប ប្រល័យ ពូជសាសន៍ នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។ បន្ថែម ពីលើ នោះ សម្តេច តេជោ បាន ប្រឹងប្រែង បញ្ចប់ សង្គ្រាម បង្រួបបង្រួម ជាតិ និង កសាង ជាតិ ឱ្យ រីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។
ពួកគេ ក៏ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឲ្ហ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឲ្យ រុងរឿង ៕
មេឃុំ កោះ ចេក ស្រុក ពាម ជរ ច្រានចោល ការចោទប្រកាន់ ថា លោក យក សាលា ឃុំ ធ្វើជា កម្មសិទ្ធិ ផ្ទាល់ខ្លួន
( ព្រៃវែង ) ៖ លោក មុិល គារី មេឃុំ កោះ ចេក ស្រុក ពាម ជរ ខេត្ត ព្រៃវែង បាន ធ្វើ ការប្រតិកម្ម និង ច្រានចោល ចំពោះ ព័ត៌មាន ដែល បាន ចោទប្រកាន់ រូបលោក យ៉ាង ធ្ងន់ធ្ងរ ថា យក សាលា ឃុំ ធ្វើជា កម្មសិទ្ធិ ផ្ទាល់ខ្លួន ហើយ អាង អំណាច មិន ធ្វើ ឯកសារ ឲ្យ ប្រជាពលរដ្ឋ ។
លោក បាន បន្ត ថា ការធ្វើ បទសម្ភាស របស់ បុគ្គល ជេត ប៊ុណ្ណា នេះ គឺ ខុសពី ការពិត ទាំងស្រុង ក្នុង នាម លោក ជា មេឃុំ មិន ដែល ធ្វើឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ រង់ចាំ យូរ ក្នុង ទទួល សេវា នោះ ទេ គឺ តែងតែ ផ្ដល់ សេវា ជូន ប្រជាពលរដ្ឋ គ្រប់ ស្រទាប់ វណ្ណៈ មិន ប្រកាន់ នូវ និន្នាការ នយោបាយ នោះ ឡើយ ។
យោង តាម លិខិត បំភ្លឺ របស់ លោក ម៉ិល គារី មេឃុំ កោះ ចេក ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ មាន ខ្លឹមសារ ថា « ខ្ញុំបាទ ឈ្មោះ ម៉ិល គារី មេឃុំ កោះ ចេក សូម ធ្វើ ការស្រាយ បំភ្លឺ ចំពោះ ការចោទប្រកាន់ របស់ ឈ្មោះ ជេត ប៊ុណ្ណា និង ប្រពន្ធ ងួន សុភា ព្រមទាំង មនុស្ស រស់ នៅ ក្រៅ ឃុំ កោះ ចេក ប្រហែល៣០ នាក់ ផ្សេង ទៀត បាន ហៅ សារព័ត៌មាន មក សម្ភាសន៍ ផ្សាយ បង្កាច់បង្ខូច ខុសពី ការពិត ទាំងស្រុង » ។
ក្នុង ការចុះអនុវត្ត នេះ រដ្ឋបាល ឃុំ បាន ចូលរួម តាម ការអញ្ជើញ របស់ លោក ព្រះរាជអាជ្ញា រង ថេង រ៉ា ឆាត ដោយឡែក កម្លាំង សមត្ថកិច្ច ដែល អញ្ជើញ ចូលរួម ទាំងអស់ គឺ ស្ថិត ក្រោម ការដឹកនាំ របស់ ព្រះរាជអាជ្ញា រង ។ ឡាន ដែល ត្រៀម ចាក់ ដី នោះ ក៏ ស្ថិត នៅក្រោម ការដឹកនាំ របស់ ព្រះរាជ្ញា រង ដូចគ្នា ។ ចំពោះ ដី ដែល គ្រោង ចាក់ នោះ គឺជា ដី បម្រុង ធ្វើ ស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ឃុំ កោះ ចេក ដែល តុលាកា បាន សម្រេច ឲ្យ មក រដ្ឋបាល ឃុំ កោះ ចេក ។
ចំពោះ មនុស្ស ប្រុស ម្នាក់ ដែល មិន ស្គាល់ ឈ្មោះ និង មាន ទីលំនៅ រស់ នៅ ឃុំ ផ្សេង ដែល បាន ចោទប្រកាន់ ថា លោក មេឃុំ យក សាលា ឃុំ ធ្វើជា កម្មសិទ្ធ ផ្ទាល់ខ្លួន ហើយ អាង អំណាច មិន ធ្វើ ឯកសារ ឲ្យ ក្រុមគ្រួសារ ដែល មាន ទំនាស់ ខាងលើ គឺ ផ្ទុយ ពី ការពិត ទាំងស្រុង ។
ប្រកាស តែងតាំង លោក ជា វ៉ាន់ ដេត ជា ប្រធាន កិត្តិយស នៃ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត តាកែវ អាណត្តិ ទី៥ និង អបអរសាទរ ទិវា ៨ឧសភា ២០២៤
( តាកែវ )៖ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ជា ព្រះប្រធាន កិត្ដិយ ស និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត តាកែវ បាន រៀបចំ ពិធី ប្រកាស តែងតាំង ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត តាកែវ អាណត្តិ ទី៥ និង ការប្រារព្ធ ពិធី អបអរសាទរ ខួប ទី១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា តំណាង ដ៏ ខ្ពង់ខ្ពស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា និង លោក បណ្ឌិត ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី គណៈកិត្តិយស គណៈកម្មាធិការ ស្ថាប័ន ពាក់ព័ន្ធ ជុំវិញ ខេត្ត និង ក្រុម ប្រតិបត្តិ អ្នកស្ម័គ្រចិត្ត និង យុវជន នៃ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត តាកែវ សរុប ប្រមាណ ជាង ៥០០ នាក់ ។
ថ្លែង ក្នុង ពិធី នេះ លោកស្រី ពុំ ចន្ទីនី បាន ពាំនាំ នូវ សេចក្តីនឹករលឹក និង ការផ្តាំ សួរសុខទុក្ខ ពីសំណាក់ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន អង្គ ពិធី ទាំងមូល និង កោតសរសើរ វាយតម្លៃ ខ្ពស់ ចំពោះ ស្មារតី និង ការទទួលខុសត្រូវ ក្រោម ការដឹកនាំ របស់ គណៈ កិត្តិយស សាខា និង គណៈកម្មាធិការ សាខា កន្លងមក សម្រេចបាន នូវ ជោគជ័យ គួរ ជា ទី មោទនៈ ។
លោកស្រី បាន បញ្ជាក់ ថា « កាកបាទ ក្រហម កម្ពុជា ក្នុង នាម ជា សមាគម ជាតិ មួយ ដែល មាន ឋានៈ ស្រប ច្បាប់ ជា ជំនួយការ ឱ្យ អាជ្ញាធរ សាធារណៈ បាន និង កំពុង អនុវត្ត ដោយ យកចិត្តទុកដាក់ ជា ទីបំផុត ចំពោះ គោល នយោបាយ អាទិភាព ចំនួន ៦ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ ជាពិសេស អាទិភាព ទី១ ការពង្រីក សេវា ថែទាំ សុខភាព ឆ្ពោះ ទៅរក ការគ្របដណ្តប់ សុខភាព ជា សាកល នៅ កម្ពុជា លើ ការងារ អប់រំ សុខ ភាព ល្អ និង ការងារ កសាង ភាពធន់ នឹង អាកាសធាតុ ។
ជា កិច្ច បន្ត លោកស្រី បាន អាន សេចក្តីសម្រេច របស់ កាកបាទ ក្រហម កម្ពុជា បាន សម្រេច តែងតាំង លោក បណ្ឌិត ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ជា ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត តាកែវ អាណត្តិ ទី៥ ដើម្បី បំពេញ ភារកិច្ច បន្ត ពី ឯកឧត្តម កិត្តិនីតិកោសល បណ្ឌិត ប៊ិន ឈិន ដែល ត្រូវបាន ផ្លាស់ប្តូរ ទៅ បំពេញ ភារកិច្ច ថ្មី ។
បន្ទាប់ពី ទទួលបាន សេចក្តីសម្រេច ពី គណៈអធិបតី រួច មក លោក បណ្ឌិត ជា វ៉ាន់ ដេត បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល បាន ផ្តល់ នូវ ទំនុកចិត្ត និង ឱកាស សម្រាប់ លោក បណ្ឌិត បាន បំពេញ បេសកកម្ម មនុស្សធម៌ ជូន ប្រជាជន និង សង្គមជាតិ ជាពិសេស ក្នុង ខេត្ត តាកែវ ។
ជា ចុងបញ្ជប់ នេះ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត តាកែវ បាន បន្ត រៀបចំ ពិធី ទទួល ថវិកា ពី សប្បុរសជន តាម សទ្ធា ជ្រះថ្លា និង ការស្ម័គ្រចិត្ត ក្នុង ឱកាស ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤ ដែល ទទួលបាន ថវិកា គិត ជា តួលេខ ផ្លូវការ បណ្តោះសន្ន ប្រមាណ ១៧ម៉ឺន ដុល្លារ អាមេរិក ៕
កីឡា និង ពលកម្ម មិន ត្រូវការ គ្រឿងញៀន ទេ ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២២ ខែមិថុនា៖ បង្ក្រាប ៣០ករណី ឃាត់ខ្លួន ៧៥ នាក់
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣០ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៧៥ នាក់ ។
( ភ្នំពេញ ) ៖ លោក សាស្រ្តាចារ្យ ឈាង រ៉ា រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល បាន ផ្តល់ នូវ អនុសាសន៍ ជា គន្លឹះ សំខាន់ ៗ ដើម្បី ពង្រឹង នូវ ស្មារតី ការងារ ជា ក្រុម ក្រមសីលធម៌ ជូន ដល់ ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ តាម ការិយាល័យ នៃ នាយកដ្ឋាន ការពារ សុខភាព និង វិធានការ នៃ កំណែទម្រង់ ការលើ ការគ្រប់គ្រង ការងារ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព និង ស័ក្ត សិទ្ធិភាព ។
ការផ្ដល់ អនុសាសន៍ ខាងលើ នេះ បាន ធ្វើឡើង ក្នុង ជំនួប សំណេះសំណាល ពិនិត្យ វឌ្ឍនភាព ការងារ ជូន ដល់ ថ្នាក់ដឹកនាំ នៃ នាយកដ្ឋាន ការពារ សុខភាព ដើម្បី ពង្រឹង ការអនុវត្ត ការងារ ប្រកបដោយ ប្រសិទ្ធភាព សំដៅ បង្កើន ន វានុវត្តន៍ និង វឌ្ឍនភាព បន្ថែម ទៀត នា ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០២៤ នៅ ទីស្ដីការ ក្រសួង ។
ក្នុង ឱកាស នោះ លោក សាស្ដ្រាចារ្យ រដ្ឋមន្ដ្រី បាន សង្កត់ធ្ងន់ ទៅ លើ ផ្នែក ជំងឺ មិន ឆ្លង ត្រូវតែ ពង្រឹង និង ពង្រីក សមត្ថភាព មន្ត្រី សុខាភិបាល ដោយ សហការ ជាមួយ ដៃគូ អភិវឌ្ឍ ទាំងអស់ លើ កិច្ចអន្តរាគមន៍ ពាក់ព័ន្ធ ទាំង ក្នុង ស្ថាប័ន និង ស្ថាប័ន ពាក់ព័ន្ធ ទាំងអស់ ក្នុង ការលើកកម្ពស់ ចំណេះដឹង ផ្តល់ សេវា សុខភាព ដល់ ប្រជាពលរដ្ឋ ដើម្បី ចូលរួមចំណែក ក្នុង ការធ្វើ កំណែទម្រង់ វិស័យ សុខាភិបាល ស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល និតិកាល ទី៧ នៃ រដ្ឋសភា ។
ក្នុង ឱកាស នោះ ដែរ លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី ក៏ បាន ស្នើ ឱ្យ ថ្នាក់ដឹកនាំ ក៏ ដូចជា មន្រ្តី នៃ នាយកដ្ឋាន ក្នុង ការពារ សុខភាព មាន ការប្តេជ្ញាចិត្ត ដើម្បី អនុវត្ត តាម ប្រសាសន៍ ណែនាំ របស់ លោក សាស្ត្រាចារ្យ រដ្ឋមន្រ្តី ក្នុង ការអនុវត្ត ការងារ សម្រេច ទទួលបាន ជោគជ័យ និង ប្រសិទ្ធភាព ការងារ ខ្ពស់ ៕ ក្រសួង សុខាភិបាល ធ្វើតេស្តរហ័ស រក សារធាតុ ញៀន លើ ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ និង មន្រ្តី ជាប់ កិច្ចសន្យា
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល បាន រៀបចំ ការត្រួតពិនិត្យ ស្វែងរក សារធាតុ ញៀន ក្នុង ទឹក មូត្រ ដល់ មន្រ្តី រាជការ និង មន្រ្តី ជាប់ កិច្ចសន្យា ដែល បម្រើ ការងារ នៅ ទីស្តីការ ក្រសួង សុខាភិបាល ដែល មាន អញ្ជើញ ចូលរួម ធ្វើតេស្ដ ពី លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល ។ ការធ្វើតេស្ដ រក សារធាតុ ញៀន នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០២៤ នាទី ស្ដីការ ក្រសួង ។
លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី បាន លើកឡើង ថា មន្រ្តី រាជការ និង មន្រ្តី ជាប់ កិច្ចសន្យា ទាំងអស់ នៃ ក្រសួង សុខាភិបាល ត្រូវ មាន កាតព្វកិច្ច ធ្វើតេស្ត រក សារធាតុ ញៀន ទាំងអស់ គ្នា ស្រប តាម បទបញ្ជា លេខ ០១ បប ចុះ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៤ របស់ រាជដ្ឋាភិបាល កម្ពុជា ស្តីពី ការដាក់ចេញ វិធានការ ម៉ឺងម៉ាត់ ក្នុង ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ នៅ តាម ក្រសួង ស្ថាប័ន និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ។
លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី ក៏ បាន គូស រំលេច ថា ការរៀបចំ ធ្វើតេស្ត រហ័ស ស្វែងរក សារធាតុ ញៀន ក្នុង ទឹក មូត្រ ( ទឹកនោម ) ដើម្បី ចូលរួមចំណែក ធានា ប្រសិទ្ធភាព នៃ ការអនុវត្ត យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ដែល ជា អាទិភាព នយោបាយ ដ៏ សំខាន់ របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ការលើកកម្ពស់ ជំនឿ ទុកចិត្ត ប្រសិទ្ធភាព ការងារ និង អភិបាលកិច្ច ល្អ នៅក្នុង ស្ថាប័ន រដ្ឋ ទាំង ថ្នាក់ ជាតិ ទាំង ថ្នាក់ ក្រោម ជាតិ ។
នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន គណបក្ស ភ្លើង ទៀន ក្នុង សង្កាត់ កំពង់ ក្របៅ ក្រុង ស្ទឹង សែន ខេត្ត កំពង់ធំ ចំនួន ៣រូប ទៀត បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព នយោបាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
លោក ប៊ុន អ៊ុយ ទីប្រឹក្សា រាជ រដ្ឋាភិបាល ឋានៈ ស្មើ ទេសរដ្ឋមន្ត្រី ទទួលមរណភាព ក្នុង ជន្មាយុ ៨១ ឆ្នាំ . ពិធី បុណ្យ សព ធ្វើឡើង នៅ វត្ត ញាណ រង្សី
( ភ្នំពេញ ) ៖ លោក ប៊ុន អ៊ុយ សមាជិក គណៈកម្មាធិការ កណ្ដាល និង ជា ទីប្រឹក្សា រាជ រដ្ឋាភិបាល មាន ឋានៈ ស្មើ ទេសរដ្ឋមន្ត្រី បាន ទទួលមរណភាព នា រសៀល ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ ក្នុង ជន្មាយុ ៨១ ឆ្នាំ ដោយ រោគា ពាធ ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង របស់ ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី ។
ពិធី បុណ្យ សព លោក ប៊ុន អ៊ុយ ធ្វើឡើង រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៣ - ២៤ ខែមិថុនា ឆ្នាំ ២០២៤ ពិធី បុណ្យ សព ធ្វើ នៅ វត្ត ញាណ រង្សី ភូមិ ទួល សំពៅ សង្កាត់ ទួល សង្កែ១ ខណ្ឌ ឫស្សីកែវ ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី៖
ជន ពិការ កំបុត ដៃ ទាំង ពីរ មកពី តាម បណ្ដា រាជធានី - ខេត្ដ ចំនួន ២១ ទទួលបាន ថវិកា ឧបត្ថម្ភ ក្នុង ម្នាក់ ១លាន រៀល ពី មូលនិធិ អ្នក ឧកញ៉ា បណ្ឌិត ជា រតនា និង អ្នក ឧកញ៉ា លី ហៀក រតនា
ថ្លែង ក្នុង ពិធី ជួបជុំជន ពិការ កំបុត ដៃ ទាំង ពីរ ទូទាំង ប្រទេស ឆ្នាំ ២០២៤ អ្នក ឧកញ៉ា បណ្ឌិត ជា រតនា បាន ឱ្យដឹង ថា កិច្ចការងារ ដែល មូលនិធិ បាន នឹង កំពុង ធ្វើ នេះ គឺ មាន សារៈសំខាន់ ជា ទីបំផុត ដែល យើង មិន គួរ មើល រំលង ព្រោះ សកម្មភាព មនុស្សធម៌ ក៏ ជា ចលករ មួយ ដែល អាច ឱ្យ សង្គម មួយ រីកចម្រើន បាន ផងដែរ ។
បើ យើង មើល ក្នុង រយៈពេល ខ្លី ការជួយ នេះ មិន អស្ចារ្យ នោះ ទេ តែ បើ សម្លឹងមើល ឱ្យ បាន វែងឆ្ងាយ ការជួយ របស់ យើង ជា សប្បុរសជន ទាំងអស់ នេះ គាត់ បាន ចូលរួមចំណែក យ៉ាង សកម្ម នៅក្នុង សង្គមជាតិ យើង ក្នុង នោះ ការបន្ដ ពូជ គឺ គាត់ អាច មាន កូន ប្រទេស យើង ក៏ មាន កំណើន ប្រជាពលរដ្ឋ ហើយ កូន គាត់ អាចនឹង ទទួលខុសត្រូវ ពេល គាត់ ចាស់ជរា ទៅ ដែល បាន កាត់បន្ថយ បន្ទុក របស់ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃ អនាគត ។ នេះ ក៏ ជា ការរួមចំណែក ជួយ កសាង ធនធាន មនុស្ស របស់ កម្ពុជា យើង ផងដែរ នៅ ថ្ងៃ អនាគត ។
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ រសៀល ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន ប្រារព្ធ ទិវា អន្ដរជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ២៦ មិថុនា ២០២៤ ក្រោម ប្រធានបទ « រួមគ្នា វិនិយោគ លើ ការបង្ការ ទប់ស្កាត់ និង លើកកម្ពស់ ការអប់រំ ដើម្បី សហគមន៍ គ្មាន គ្រឿងញៀន » ក្រោម អធិបតីភាព លោក សន្ដិ បណ្ឌិត នេត សាវឿន ឧប នាយក រដ្ឋមន្ដ្រី និង ជា ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន តំណាង សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
ដើម្បីឲ្យ ខ្លឹមសារ នៃ ទិវា អន្តរជាតិ នា ឱកាស នេះ កាន់តែ មាន អត្ថន័យ ជ្រាលជ្រៅ បន្ថែម ទៀត ក្នុង នាម សម្តេច មហា បវរធិបតី នាយក រដ្ឋមន្ដ្រី ឧប នាយក រដ្ឋមន្ដ្រី នេត សាវឿន បាន ផ្ដល់ អនុសាសន៍ និង ចែករំលែក នូវ ទស្សនា ទាន មួយចំនួន ដូច ខាងក្រោម៖
* ទី១៖ សំណូមពរ ដជន រួម ជាតិ ទាំងអស់ គ្រប់ ស្រទាប់ វ័យ គ្រប់ មជ្ឈដ្ឋាន និង គ្រប់ វិស័យ សូម បន្ត អនុវត្ត ស្មារតី ជាតិ របស់ យើង គឺ ចាត់ទុក បញ្ហា គ្រឿងញៀន ជា បញ្ហា រួម ដែល ត្រូវ ចូលរួម ដោះស្រាយ និង លុបបំបាត់ ទាំងអស់ គ្នា ។ ក្នុង ន័យ នេះ ចាប់ផ្តើម ពី ថ្នាក់ដឹកនាំ ក្រសួង ស្ថាប័ន ទាំងអស់ ក្រុមហ៊ុន ឯកជន រោងចក្រ សហគ្រាស រហូតដល់ សមាជិក គ្រួសារ ត្រូវ ធ្វើ ការអប់រំ ក្រើន រំលឹក ពី ផល ប៉ះពាល់ វិនាសកម្ម នៃ គ្រឿងញៀន និង ត្រូវ មាន ជំហរ ដាច់ខាត មិន ថា ក្នុង កាលៈទេសៈ ណា ក៏ដោយ គឺ មិន ពាក់ព័ន្ធ នឹង គ្រឿងញៀន ឡើយ ។
* ទី៣៖ សូម លើកទឹកចិត្ត ឲ្យ មាន ការបញ្ជ្រាប ប្រធានបទ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ទៅ រាល់ ព្រឹត្តិការណ៍ នានា ទាំង ក្នុង ព្រឹត្តិការណ៍ អប់រំ . កីឡា . សាសនា . វប្បធម៌ . សិល្បៈ ។ល ។
លើស ពី នេះ ទៀត កម្មវិធី ទូរស័ព្ទ ដៃ NoDrug ត្រូវបាន ប្រើប្រាស់ ជា មធ្យោបាយ រាយការណ៍ សម្ងាត់ និង មាន ប្រសិទ្ធភាព បំផុត អំពី ករណី ចែកចាយ និង ប្រើប្រាស់ គ្រឿងញៀន ក្នុង សហគមន៍ ដែល ជា ស្ពាន ដ៏ សំខាន់ ក្នុង ការតភ្ជាប់ ទំនាក់ទំនង រវាង ពលរដ្ឋ ក្នុង សហគមន៍ ជាមួយ សមត្ថកិច្ច ។
* ទី៦៖ សូម ធ្វើ ការក្រើន រំលឹក សារជាថ្មី ជូន ចំពោះ គណៈ បញ្ជាការ ឯកភាព រាជធានី ខេត្ត ទាំងអស់ ត្រូវ បន្ត អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព លុបបំបាត់ ការចែកចាយ និង ប្រើប្រាស់ គ្រឿងញៀន ក្នុង សហគមន៍ ជាពិសេស តាម ក្លឹប កម្សាន្ត និង ទីតាំង សប្បាយដ្ឋាន នានា និង សូម យកចិត្តទុកដាក់ ពង្រឹង សណ្តាប់ធ្នាប់ របៀបរៀបរយ បរិវេណ ជុំវិញ សាលារៀន បំបាត់ ករណី ក្មេង ទំនើង និង សិស្ស គេច សាលា ដែល អាច ជា គោលដៅ ឈានដល់ ការប្រើប្រាស់ គ្រឿងញៀន ។
* ទី៧៖ សូម លើកទឹកចិត្ត ដល់ មាតាបិតា អាណាព្យាបាល ដែល មាន សមាជិក គ្រួសារ ជា អ្នក ញៀន គ្រឿងញៀន ត្រូវ ក្លាហាន ហ៊ាន បញ្ចូន ពួកគាត់ មក ទទួល ការបន្សាប ព្យាបាល និង ស្តារ នីតិសម្បទា ទាំង នៅ មជ្ឈមណ្ឌល ជាតិ និង ឯកជន ដែល នេះ គឺជា វិធី តែ មួយ គត់ ដើម្បីឲ្យ ពួកគាត់ អាច សមាហរណកម្ម ចូល សង្គម វិញ បាន និង ចាប់ផ្តើម អនាគត សារជាថ្មី ជា ក្តីសង្ឃឹម ឡើងវិញ របស់ ប្រទេសជាតិ ៕
រថយន្ដ យីឌុប មួយ គ្រឿង ដឹក កម្ទេច លៀស ខុស ច្បាប់ ត្រូវ សមត្ថកិច្ច ចាប់ ផាក ពិន័យ លុះ ស្អែក ឡើង បន្ដ ដឹក ទៀត ដោយ មិន ញញើត ច្បាប់ នៅ ស្រុក រលាប្អៀរ
( កំពង់ឆ្នាំង ) ៖ រថយន្ត យីឌុប ធុន ធំ មួយ គ្រឿង ពាក់ ផ្លាកលេខ កំពង់ឆ្នាំង 3A-0591 ដឹក កម្ទេច លៀស ខុស ច្បាប់ ចំនួន ១៧០ ស្មើ ប្រមាណ ១០តោន ហើយ ត្រូវបាន កម្លាំង នគរបាល ស្រុក រលាប្អៀរ ស្ទាក់ ចាប់ ឃាត់ នៅ ចំណុច ភូមិ ថ្នល់ តា សែង ឃុំ ភ្នំ ក្រាំង ដី មាស ស្រុក រលាប្អៀរ កាលពី យប់ ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២៤ និង បាន ប្រគល់ ជូន ទៅ មន្ត្រី រដ្ឋបាល ជលផល យក ធ្វើការ ផាកពិន័យ អន្តរការ នៅ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២៤ ។
លុះ នៅ យប់ ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០២៤ រថយន្ត ដដែល នេះ បាន ធ្វើ សកម្មភាព ដឹក កម្ទេច លៀស ចម្រុះ ខុស ច្បាប់ ចេញ ពី ចំណុច ដដែល ទៀត ហើយក៏ ត្រូវបាន កម្លាំង សមត្ថកិច្ច នគរបាល ស្រុក រលាប្អៀរ ធ្វើ ការល្បាត តាម ផ្លូវ ក៏ បាន ប្រទះឃើញ រថយន្ត ខាងលើ នេះ ដឹក កម្ទេច លៀស ជាប់ ផុង ទៅ មុខ លែង រួច ។
ជុំវិញ ករណី ខាងលើ នេះ លោក លី ឡា នាយ ខណ្ឌ រដ្ឋបាល ជលផល កំពង់ឆ្នាំង បាន ឲ្យដឹង ថា រថយន្ត ខាងលើ នេះ លោក ពិតជា បាន ធ្វើការ ផាកពិន័យ អន្តរកាល ពី ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២៤ កន្លងទៅ ថ្មី ៗ នេះ ពិតប្រាកដ មែន ឥឡូវ ស្រាប់តែ រថយន្ត ដដែល នេះ បាន ធ្វើ សកម្មភាព ដោយ មិន រៀង ចាល ។ លោក ថា បើ តាម ផ្លូវ ច្បាប់ លោក នឹង ធ្វើការ ផាកពិន័យ អន្តរ ការ ទ្វេ ដង ។
ដោយឡែក លោក ងិន ហ៊ុន ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត កំពង់ឆ្នាំង បាន ប្រាប់ យ៉ាង ខ្លី ថា ករណី នេះ លោក នឹង ធ្វើការ ផាកពិន័យ អន្តរ ការ ទ្វេ ដង ។ ករណី នៅតែ មិន រៀង ចាល បើ ចាប់ បាន លើក ទី៣ លោក នឹង កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ តែម្ដង ។
( ប៉េកាំង ) ៖ នៅ ពេល ដែល សង្រ្គាម ឬ ជម្លោះ ផ្ទុះឡើង នៅលើ ពិភពលោក អង្គការ អន្តរជាតិ ជាច្រើន តែងតែ បញ្ជូន អ្នកជំនាញ ទៅកាន់ កន្លែង គ្រោះថ្នាក់ ទាំងនោះ ដើម្បី ជួយសង្គ្រោះ ជនរងគ្រោះ ដោយសារ សង្រ្គាម ។ ក្នុង ចំណោម នោះ មាន អង្គការ មួយ ជា តំណាង គឺ គណៈកម្មាធិការ អន្តរជាតិ នៃ កាកបាទ ក្រហម ។
វិទ្យុ មិត្តភាព កម្ពុជា ចិន នីតិរដ្ឋ តាម បែបផែន ចិន ប្រកាន់ខ្ជាប់ នូវ អភិបាលកិច្ច ជាតិ តាម លំអាន ច្បាប់ និង គ្រប់គ្រង ប្រជាជន ដោយ គុណធម៌
ប្រជាជន ចិន បាន រស់ នៅ ក្រោម ដំបូល នីតិរដ្ឋ ដែល ឆ្លុះបញ្ចាំង នូវ តថភាព ប្រព័ន្ធ ច្បាប់ របស់ ប្រទេស ចិន ដែល ផ្តល់ សិទ្ធិ សេរីភាព យ៉ាង ពេញលេញ ដល់ ប្រជាជន ចិន ស្រប ទៅតាម ក្របខណ្ឌ នៃ គុណធម៌ និង សីលធម៌ របស់ ជនជាតិ ចិន ហើយ បាន ជំរុញ ឱ្យ ក្រម គុណធម៌ និង សីលធម៌ ចិន ផ្តល់ មកវិញ នូវ គ្រឿង បំពាក់ បំប៉ន ឬ អាហារូបត្ថម្ភ បន្ថែម ទៀត ដល់ ការអភិវឌ្ឍ គោលការណ៍ ច្បាប់ ក្នុង ប្រទេស ចិន ។
ដោយ បណ្ឌិត ជា មុនី ឫទ្ធិ សមាជិក គណៈប្រតិបត្តិ សមាគម មិត្តភាព កម្ពុជា - ចិន
* របាយ រស់ នៅ៖ នៅ ប្រទេស កម្ពុជា ពង្រូល មាន ដោយ កន្លែង ក្នុង ទី ជម្រក សមស្រប ។ វា មាន ផងដែរ នៅ ភាគ ខាងកើត ប្រទេស ភូមា ភាគ កណ្តាល ប្រទេស ថៃ ភាគ ខាងត្បូង ប្រទេស ឡាវ វៀតណាម ស៊ូឡាវេស៊ីម៉ាឡេស៊ី កោះ ស៊ូម៉ាត្រា កោះ ជ្វា និង កោះ ប័រណេអូ ។
* ស្ថានភាពអភិរក្ស៖ ពង្រូល ជា ប្រភេទ សត្វ មាន ដោយ បង្គួរ និង បាន ចុះ ក្នុង បញ្ជី IUCN (NT) ជា ប្រភេទ ជិត ទទួលរង ការគំរាមកំហែង លើ ពិភពលោក ។ ប្រភេទ នេះ បាន និង កំពុង ទទួល នូវ ការទាក់ ចាប់ យ៉ាង ខ្លាំង ពីសំណាក់ មនុស្ស ដើម្បី ធ្វើ អាជីវកម្ម និង នាំចេញ ទៅ ក្រៅ ប្រទេស ៕បទ អត្ថាធិប្បាយ៖ គំនិត ផ្តួចផ្តើម អរិយធម៌ សកល របស់ ចិន មាន តម្លៃ ចំពោះ អ្នកសិក្សា កម្ពុជា និង ជា មូលដ្ឋានគ្រឹះ នៃ សន្តិភាព
( ភ្នំពេញ ) ៖ ក្រុម បញ្ញវន្ត និង អ្នកស្រាវជ្រាវ នៅ ប្រទេស កម្ពុជា បាន ចាត់ទុក ថា សៀវភៅ ផ្តួចផ្តើម អរិយធម៌ សកល របស់ លោក ស៊ី ជីង ភីង ប្រធាន រដ្ឋ ចិន គឺ មាន តម្លៃ ខ្ពស់ ណាស់ ក្នុង ការជំរុញ ឱ្យ មាន សុខ សន្តិភាព និង សុខដុមនីយកម្ម ទាំង ផ្នែក សាសនា វប្បធម៌ ជំនឿ សម្រាប់ ប្រជាជន គ្រប់ ជាតិ សាសន៍ ។
ការបង្ហាញ បែប នេះ បន្ទាប់ពី សៀវភៅ ជា ខេមរភាសា ស្តីពី យល់ដឹង កាន់តែ ស៊ីជម្រៅ គំនិត ផ្តួចផ្តើម អរិយធម៌ សកល ត្រូវបាន ផ្សព្វផ្សាយ ជាសាធារណៈ រសៀល ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០២៤ក្រោម ការគាំទ្រ ពី ស្ថានទូត ចិន ប្រចាំ កម្ពុជា មជ្ឈមណ្ឌល កម្ពុជា សម្រាប់ ការស្រាវជ្រាវ ផ្លូវ សូត្រ សមុទ្រ សតវត្ស ទី ២១ និង សមាគម អ្នកស្រាវជ្រាវ វឌ្ឍនភាព កម្ពុជា - ចិន ។
បើ តាម ការបញ្ជាក់ ពី លោក លោក បណ្ឌិត ជា មុនី ឫទ្ធិ ប្រធាន សមាគម អ្នកស្រាវជ្រាវ វឌ្ឍនភាព កម្ពុជា - ចិន និង ជា អ្នក ចងក្រង នូវ សៀវភៅ ជា ខេមរ ភាសា នេះ បញ្ជាក់ ថា សៀវភៅ នេះ នឹង អាច បង្កើន បរិមាណ កាន់តែ ច្រើន របស់ អ្នកអាន និង អ្នកសិក្សា ស្រាវជ្រាវ ក្នុង ប្រទេស កម្ពុជា ។
លោក បញ្ជាក់ ដូច្នេះ ថា៖ « ចំណុច សំខាន់ នៃ អរិយធម៌ សកល នេះ គឺ ផ្តោត លើ ចំណុច សំខាន់ ចំនួន ៤៖ ទី១ និយាយ ពី ការគោរព ឱ្យ តម្លៃ គ្នា ទៅ លើ អរិយធម៌ ចម្រុះ ទី២ គឺ ការយល់ដឹង កាន់តែ ស៊ីជម្រៅ ពហុ និយម នៃ អរិយធម៌ ទី៣ គឺ ការរៀនសូត្រ សិក្សា ពី គ្នា ទៅ វិញ ទៅ មក រវាង អ្នក មាន អរិយធម៌ ផ្សេង ៗ គ្នា និង ទី៤គឺ ការរួមគ្នា ធ្វើឱ្យ ប្រសើរឡើង នូវ សុខដុមនីយកម្ម រវាង មនុស្ស និង មនុស្ស តាមរយៈ ការធ្វើឱ្យ មាន ការយល់ គ្នា ដើម្បី ឈាន ទៅដល់ ការកសាង សហគមន៍ ជោគវាសនា រួម » ។
កញ្ញា អៀង សុជាតា ជា និស្សិត ផ្នែក ទំនាក់ទំនង អន្តរជាតិ នៃ សកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ បាន ឱ្យ តម្លៃ យ៉ាង ខ្លាំង ចំពោះ ភៅ សៀវភៅ ជា ខេមរភាសា ស្តីពី យល់ដឹង កាន់តែ ស៊ីជម្រៅ គំនិត ផ្តួចផ្តើម អរិយធម៌ សកល របស់ ចិន ព្រោះ វា បាន បង្កប់ នូវ អត្ថន័យ អប់រំ ពី វប្បធម៌ សកល មួយ យ៉ាង សំខាន់ ក្នុង ជំរុញ ឱ្យ មាន ភាពចុះ សម្រុង គ្នា រវាង មនុស្សជាតិ ។
កញ្ញា បញ្ជាក់ ថា៖ « ខ្ញុំ គិត ថា សៀវភៅ ជា ខេមរភាសា ស្តីពី យល់ដឹង កាន់តែ ស៊ីជម្រៅ គំនិត ផ្តួចផ្តើម អរិយធម៌ សកល នេះ ពិតជា មាន សារសំខាន់ មែនទែន ព្រោះ ធ្វើឱ្យ យើង បាន យល់ដឹង ពី អរិយធម៌ សកល សម្រាប់ មនុស្សជាតិ ទាំងអស់ » ។
សូម បញ្ជាក់ ថា លោក ស៊ី ជីន ពីង ប្រធាន រដ្ឋ ចិន បាន ដាក់ចេញ នូវ « គំនិត ផ្តួចផ្តើម អរិយធម៌ សកល » កាលពី ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៣ ដើម្បី ដោះស្រាយ បញ្ហា រួម របស់ មនុស្សជាតិ និង លើកកម្ពស់ សន្តិភាព ពិភពលោក ផ្អែក លើ គោលការណ៍ ស្នូល ចំនួន ៤ គឺ ១ - ការគោរព ភាព ចម្រុះ នៃ អរិយធម៌ ពិភពលោក ២ - ការផ្សព្វផ្សាយ គុណ តម្លៃ រួម នៃ មនុស្សជាតិ ៣ - ការយកចិត្តទុកដាក់ លើ ការបន្ត វេន និង ន វានុវត្តន៍ លើ អរិយធម៌ និង ៤ - ការពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ ការផ្លាស់ប្ដូរ ប្រជាជន និង ប្រជាជន ៕
លោក ជា វ៉ាន់ ដេត ប្រគល់ សម្ភារ បច្ចេកទេស ជូន ដល់ មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ខេត្ត តាកែវ
( តាកែវ )៖ លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ និង ជា ប្រធាន ក្រុមការងារ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត តាកែវ នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រគល់ សម្ភារ បច្ចេកទេស ជូន ដល់ មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ខេត្ត តាកែវ ។
ក្នុង ពិធី ប្រគល់ នោះ រួម មាន៖ ម៉ាស៊ីន វាស់វែង ចំនួន ២០ សម្រាប់ កុំព្យូទ័រ យួរ ដៃ ចំនួន ១០គ្រឿង ដើម្បី សម្រួល និង បង្កេីន ល្បឿន ក្នុង ការចុះ វាស់វែង ដីធ្លី ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ឆាប់ រហ័ស ៕ ក្រសួង អប់រំ សម្រេច ប្ដូរ ឈ្មោះ សាលា បឋមសិក្សា វត្ត បូព៌ មក ជា សាលា បឋមសិក្សា វត្ត រាជ បូណ៌ នៅ ខេត្ត សៀមរាប
ខាងក្រោម នេះ ជា ប្រកាស របស់ ក្រសួង អប់ រំ៖
នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បេក្ខភាព ក្រុមប្រឹក្សា ឃុំ បក្ស ភ្លៀង ទៀន នៅក្នុង ឃុំ អូរ ឬស្សី កណ្តាល និង ឃុំ កោះ សំពាយ ស្រុក សៀម បូក ខេត្ត ស្ទឹងត្រែង ចំនួន ៣រូប ទៀត បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព នយោបាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
ពួកគេ ក៏ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕ ភ្លៀង ធ្លាក់ ២ ថ្ងៃ១ យប់ លិច ផ្លូវ មិន អាច ធ្វើចរាច បាន និង លិច ចូល ផ្ទះ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន មួយចំនួន ក្នុង ក្រុង ខេមរភូមិន្ទ
( កោះកុង) ៖ ដោយសារ អាកាសធាតុ និង សីតុណ្ហភាព មាន សម្ពាធ ទាប បណ្តាលឲ្យ មាន ភ្លៀង ធ្លាក់ យ៉ាង ខ្លាំង ក្នុង រយៈពេល ២ ថ្ងៃ១ យប់ បណ្តាលឲ្យ ផ្លូវ មួយចំនួន ពិបាក ធ្វើចរាចរ និង លំនៅដ្ឋាន ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ក្រុង ខេមរភូមិន្ទ មាន ការលិច ចូល ក្នុង ផ្ទះ តែ មិន បណ្តាលឲ្យ បាត់បង់ ទ្រព្យសម្បត្តិ និង អាយុជីវិត ដល់ មនុស្ស សត្វ ឡើយ ។
ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន បាន និយាយ ថា ឆ្នាំ នេះ ខុសប្លែក ពី រាល់ ឆ្នាំ ដោយ ទឹកភ្លៀង ធ្លាក់ ខ្លាំង ទាំង យប់ ទាំង ថ្ងៃ បណ្តាលឲ្យ ទឹកភ្លៀង លិច ហូរ ចូល ដល់ ក្នុង ផ្ទះ ពួកគាត់ និង លិច ផ្លូវ បណ្តាលឲ្យ ពិបាក ក្នុង ការធ្វើចរាចរ ចេញ ចូល តែ មិន បណ្តាល ខូចខាត ទ្រព្យសម្បត្តិ ឡើយ ប៉ុន្តែ កូនសិស្ស មិន អាច ទៅ សាលារៀន បាន ហើយ អី្វ ដែល សំខាន់ អាព្យាបាល ត្រូវ ថែរក្សា កូន តូច ៗ មិន ឲ្យ ចុះ លេង ទឹក ទេ ខ្លាច មាន ហានិភ័យ ខ្ពស់ ។
រយៈពេល ២ ថ្ងៃ នេះ គេ មិន ទាន់ ឃើញ អាជ្ញា ក្នុង មូលដ្ឋាន ចុះ ដើម្បី រក ដំណោះស្រាយ នៅពេល រាំង នា រដូវ ប្រាំង ឡើយ ៕
ត្រឹម រយៈពេល ៣ ថ្ងៃ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត ចាត់ការ លើ សំណុំរឿង គ្រឿងញៀន ៥៨ ករណី ដែល មាន ជនសង្ស័យ ១៤៣ នាក់
( ភ្នំពេញ ) ៖ លោក ជិន ម៉ាលីន អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ បាន ឱ្យដឹង ថា ក្នុង រយះពេល៣ ថ្ងៃ ពី ថ្ងៃទី ១៩ ដល់ ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០២៤ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត បាន ទទួល ចាត់ការ លើ សំណុំរឿង ពាក់ព័ន្ធ នឹង គ្រឿងញៀន ចំនួន ៥៨ ករណី ដែល មាន ជនសង្ស័យ ចំនួន ១៤៣ នាក់ ហើយ តុលាការ បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ១២៨ នាក់ ។
( ភ្នំពេញ ) ៖ រាជ បណ្ឌិត្យ សភា កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន រៀបចំ បាឋ កថា ស្តីពី « ការវិវត្ត នៃ វិស័យ ច្បាប់ នៅ ប្រទេស កម្ពុជា ក្នុង សម័យ ទំនើប៖ ទិដ្ឋភាព ប្រវត្តិសាស្ត្រ » ។
កម្មវិធី នេះ ធ្វើឡើង នៅ សាល ទន្លេ សាប អគារ ខេមរវិទូ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ដោយ មាន ការអញ្ជើញ ចូលរួម ដោយ លោក បណ្ឌិត សភាចារ្យ សុក ស៊ី ផាន់ ណា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស ប្រធាន គណៈកម្មាធិការ ផ្តល់ យោបល់ គោល នយោបាយ ពាណិជ្ជកម្ម និង ជា អនុប្រធាន ទី១ នៃ គណៈកម្មាធិការ កំណែទម្រង់ ច្បាប់ ជា វាគ្មិន កិត្តិយស និង មាន លោក បណ្ឌិត យង់ ពៅ អគ្គ លេខាធិការ រាជ បណ្ឌិត្យ សភា កម្ពុជា ជា អ្នកសម្របសម្រួល ព្រមទាំង មាន ការចូលរួម សិស្ស - និស្សិត ជាច្រើន នាក់ ផងដែរ ៕
អភិបាល ខេត្ត ព្រះសីហនុ៖ កាយ រឹទ្ធិ កម្ពុជា ការសច្ចា ប្រណិធាន គឺ ការថែរក្សា ខ្លួនប្រាណ ឲ្យ មាន កាយសម្បទា និង ត្រូវ ហាត់ប្រាណ យក កាយសម្បទា រឹងមាំ មិន ត្រូវ ប៉ះពាល់ គ្រឿងញៀន និង ចេះ អធ្យាស្រ័យ ខ្ពស់
( ព្រះសីហនុ) ៖ ក្នុង នាម កាយ រឹទ្ធី កម្ពុជា ការសច្ចា ប្រណិធាន គឺ ការថែរក្សា ខ្លួនប្រាណ ឱ្យ មាន កាយសម្បទា ទន្ទឹម នោះ ត្រូវ ហាត់ប្រាណ ឱ្យ មាន កាយសម្បទា រឹងមាំ មិន ត្រូវ ប៉ះពាល់ គ្រឿងញៀន ព្រោះ គ្រឿងញៀន មិន មាន ផលប្រយោជន៍ នោះ ទេ វា បង្ក ប៉ះពាល់ សេដ្ឋកិច្ច គ្រួសារ សង្គម ពិសេស ប៉ះពាល់ សុខភាព ក្លាយជា ជន ហឹង្សា ដែល សង្គម ស្អប់ខ្ពើម ។ សូម ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ និង ចេះ អធ្យាស័យ ក្នុង ការបើកបរ ។
អភិបាល ខេត្ត ព្រះសីហនុ បាន បន្ថែម ថា ចិត្ត គំនិត ភ្ញាក់ រលឹក បន្ត ការខិតខំ សិក្សា រៀនសូត្រ ស្រាវជ្រាវ នូវ ចំណេះដឹង ថ្មី ៗ ជំនាញ ប្រយោជន៍ ដល់ ការសិក្សា ឈាន ទៅរក ភាពជោគជ័យ ទៅ អនាគត ត្រូវ មាន សិលធម៌ ធ្វើ ការ កូន ល្អ សិស្ស ល្អ ពលរដ្ឋ ល្អ ព្រមទាំង ចូលរួម ផ្សព្វផ្សាយ ពី គុណ តំលៃ នៃ ប្រទេសជាតិ ។
លោក បន្ត ថា ចំពោះ ក្មួយ ៗ ដែល ត្រូវ ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ដែល ក្រសួង អប់រំ បាន ធ្វើ កំណែទម្រង់ អ្នក ចេះ គឺជាប់ ហើយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន យកចិត្តទុកដាក់ ក្នុង ការ ឱ្យ លោកគ្រូ អ្នកគ្រូ ជួយ បំប៉ន សម្រាប់ សិស្ស ថ្នាក់ ទី១២ ដូច្នេះ ក្មួយ ត្រូវ ខិតខំ សិក្សា រៀនសូត្រ ស្វែងយល់ ដោយ ខ្លួន ដើម្បីឱ្យ ការប្រឡង ឆ្នាំ នេះ ជាប់ បាន កាន់តែ ច្រើន និង ទទួលបាន និទ្ទេស A ច្រើន ជាង ឆ្នាំ កន្លងមក ។
( កំពង់ស្ពឺ ) ៖ ដោយ បាន ការចង្អុលបង្ហាញ ពី លោក ឧត្តមសេនី យ៏ ត្រី ម៉េង ស្រ៊ុន មេបញ្ចាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ និង មាន ការសម្របសម្រួល នីតិវិធី ពី លោក ទិន សុចិត្រា ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត នៅ ព្រឹក ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ កម្លាំង អាវុធហត្ថ បាន ឃាត់ខ្លួន និង បញ្ជូន ជនសង្ស័យ ចំនួន ៨នាក់ ទៅ តុលាការ ។
ជនសង្ស័យ រួម មាន៖
* ទី១៖ ឈ្មោះ ទឹម ភារិទ្ធ អាយុ ៣៩ ឆ្នាំ មុខរបរ រោងចក្រ ទីលំនៅ បច្ចុប្បន្ន ភូមិ ទួលបារាយណ៍ សង្កាត់ ក្រាំង ចេក ក្រុង ឧដុង្គ ម៉ែ ជ័យ ខេត្ត កំពង់ស្ពឺ* ទី២៖ ឈ្មោះ ឡេង ថេង អាយុ ២៧ ឆ្នាំ មុខរបរ កម្មករ រោងចក្រ ទីលំនៅ បច្ចុប្បន្ន ភូមិ កណ្តាល ឃុំ ត្រពាំងល្វា ស្រុក ឧដុង្គ ខេត្ត កំពង់ស្ពឺ* ទី៣៖ ឈ្មោះ សំ ណាង អាយុ ៣១ ឆ្នាំ មុខរបរ កម្មករ រោងចក្រ ទីលំនៅ បច្ចុប្បន្ន ភូមិ ឆ្វេច ឃុំ ត្រពាំងល្វា ស្រុក ឧដុង្គ ខេត្ត កំពង់ស្ពឺ ។
ដកហូត វត្ថុតាង រួម មាន៖
បន្ទាប់ពី ស្តាប់ ចម្លើយ និង តាម ការចង្អុលបង្ហាញ ពី ជនសង្ស័យ ឈ្មោះ ឡេង ថេង អាយុ ២៧ ឆ្នាំ មុខរបរ កម្មករ រោងចក្រ កម្លាំង ជំនាញ បាន បន្ត ទៅ ទីតាំង ចំណុច ផ្ទះ របស់ ឈ្មោះ ព្រំ វត្ថា ភេទ ប្រុស អាយុ ៣៨ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ស្ថិត នៅ ភូមិ អូរ ក្រាំង អំបិល ឃុំត្រពាំងគង ស្រុក សំរោងទង ខេត្ត កំពង់ស្ពឺ បន្ត ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ០៥ នាក់ ករណី ប្រើប្រាស់ និង រក្សាទុក ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង បញ្ជូន ទៅ សាលាដំបូង ខេត្ត កំពង់ស្ពឺ ដើម្បី បន្ត នីតិវិធី ៕ ឧប នាយក រដ្ឋមន្ត្រី ហង់ ជួន ណារ៉ុន៖ ការពង្រឹង គុណភាព អប់រំ ការកែលម្អរការបង្រៀន និង ការរៀន ដើម្បី ឆ្លើយតប នឹង យុទ្ធសាស្ត្រ ថ្មី របស់ រាជ រដ្ឋាភិបាល
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្ត្រី ហង់ ជួនណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា បាន ថ្លែង ថា ការពង្រឹង គុណភាព អប់រំ ការកែលម្អរការបង្រៀន និង ការរៀន ដើម្បី ឆ្លើយតប នឹង យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋានីតិកាល ថ្មី ដោយ សំដៅ ធ្វើ យ៉ាងណា ពង្រឹង ធន់ ធាន មនុស្ស ឱ្យ មាន ទាំង ចំណេះដឹង បំនិន ជំនាញ និង ឱ្យ មាន ឥរិយាបថ ល្អ នៅក្នុង សង្គម ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ហង់ ជួនណារ៉ុន បាន លើកឡើង យ៉ាង ដូចនេះ នា ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ នា ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិព័រណ៍ ស្នាដៃ សិស្ស ប្រចាំ ឆ្នាំ ២០២៤ និង បិទ វគ្គ ថ្នាក់ អក្សរ ផ្ចង់ ចិន នៅ បរិវេណ វិទ្យាល័យ ព្រះយុគន្ធ រ និង ដោយ មាន ការចូលរួម លោក សម្យ កំសាន្ត នាយក រង វិទ្យាល័យ ព្រះស៊ីសុវត្តិ និង មាន លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ជាច្រើន នាក់ ផងដែរ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ហង់ ជួនណារ៉ុន បាន ថ្លែង ថា នៅក្នុង សតវត្ស ទី ២១ នេះ គឺ មាន ការប្រើប្រាស់ បច្ចេកវិទ្យា ហើយ ការអប់រំ ក៏ ត្រូវតែ ឆ្លើត តប ទៅនឹង ការប្រើប្រាស់ ច្ចេកវិទ្យា ផងដែរ យ៉ាងណាមិញ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ដាក់ចេញ នូវ យុទ្ធសាស្ត្រ បច្ចុកោណ ដំណាក់កាល ទី១ ដែល ក្នុង នោះ គឺ ការលើកកម្ពស់ ការបណ្តុះបណ្តាល ធនធាន មនុស្ស ក៏ ដូចជា ការលើកកម្ពស់ វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា ឌីជីថល នេះ ជា អតិភាព មួយ យ៉ាង ធំ ។
ដើម្បីឱ្យ ស្រប ជាមួយនឹង យុទ្ធសាស្ត្រ បច្ចុកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល លោក ឧប នាយក រដ្ឋមន្ត្រី ហង់ ជួនណារ៉ុន បាន ថ្លែង ថា « ការពង្រឹង គុណភាព អប់រំ ក៏ ដូចជា ការកែលម្អរការបង្រៀន និង ការរៀន គឺ ដើម្បី ឆ្លើយតប នឹង យុទ្ធសាស្ត្រ គឺ យើង ធ្វើ មិច ឱ្យ ការពង្រឹង ធន់ ធាន មនុស្ស ឱ្យ មាន ទាំង ចំណេះដឹង បំនិន និង ជំនាញ មាន ទាំង បំនិន សតវត្ស ទី ២១ និង ឱ្យ មាន ឥរិយាបថ ល្អ » ។
បន្ថែម ពី នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី ហង់ ជួនណារ៉ុន បាន បញ្ជាក់ ដែរ ថា ការបង្កើត សាលារៀប ជំនាន់ ថ្មី នេះ ពិតជា នាំមក នូវ ការអប់រំ ប្រកបដោយ គុណភាព ខណៈ ដែល សិស្ស មិន ត្រឹមតែ បាន រៀន ក្នុង ថ្នាក់រៀន ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ក្រៅពី នេះ បាន បន្ត ខិតខំ ស្រាវជ្រាវ បន្ថែម ដើម្បី បាន ក្លាយជា អ្នកសិក្សា មួយ ប្រកបដោយ ឯកទេស និង ត្រៀមខ្លួន ដើម្បី ចាប់ យក ការអប់រំ កម្រិត ឧត្តម សិក្សា ផងដែរ ៕
នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ អ្នកស្រី លៀង ស្រី មុំ បេក្ខជន ក្រុមប្រឹក្សា ឃុំ បក្ស ភ្លើង ទៀន ក្នុង ឃុំ ទួល ទទឺង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព នយោបាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
អ្នកស្រី លៀង ស្រី មុំ បាន សម្តែង ការសោកស្តាយ ជាខ្លាំង ចំពោះ កំហុសឆ្គង ចំពោះ ជាតិ មាតុភូមិ នា ពេល កន្លងទៅ ព្រោះតែ លង់ ជឿ ចំពោះ ការអូសទាញ របស់ ជន ក្បត់ ជាតិ សម រង្ស៉ី ក៏ ដូចជា ក្រុម ប្រឆាំង ជ្រុលនិយម ។ ចាប់ពី ពេលនេះ តទៅ អ្នកស្រី ឈប់ លង់ ជឿ តាម ការញុះញង់ និង អូសទាញ របស់ ទណ្ឌិត ក្បត់ ជាតិ សម រង្ស៉ី និង បក្ខពួក ទៀត ។
ទន្ទឹមនឹង ការប្រកាស ផ្តាច់ ខ្លួន ចេញ ពី ក្រុម ទណ្ឌិត ក្បត់ ប្រយោជន៍ ជាតិ ហើយ នោះ អ្នកស្រី លៀង ស្រី មុំ ក៏ បាន សុំ ការអនុគ្រោះ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បាន ឱកាស រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា បន្ត សកម្មភាព នយោបាយ ទៅ មុខ បន្ត ទៀត ។
ពេលនេះ អ្នកស្រី លៀង ស្រី មុំ បាន មើលឃើញ ច្បាស់ ដោយ ឥត សង្ស័យ ថា គណបក្ស ប្រជាជន កម្ពុជា គឺជា បក្ស នយោបាយ តែ មួយ គត់ ដែល មាន គុណ បំណាច់ ដ៏ ធំធេង សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ។ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន ជា មេដឹកនាំ ដ៏ ខ្លាំង ពូកែ ដែល បាន ប្រឹងប្រែង រំដោះ អាយុជីវិត ជាតិ និង ប្រជាជន ពី របប ប្រល័យ ពូជសាសន៍ នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។ បន្ថែម ពីលើ នោះ សម្តេច តេជោ បាន ប្រឹងប្រែង បញ្ចប់ សង្គ្រាម បង្រួបបង្រួម ជាតិ និង កសាង ជាតិ ឱ្យ រីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។
( ប៉េកាំង ) ៖ មហោស្រព ភាពយន្ត អន្តរជាតិ សៀង ហៃ លើក ទី ២៦ ដែល ផ្តួចផ្តើម រៀបចំ ដោយ រដ្ឋបាល ជាតិ ភាពយន្ត ចិន និង សហការរៀបចំ ដោយ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន និង រដ្ឋបាល ប្រជាជន ក្រុង សៀងហៃ បាន ប្រារព្ធ ធ្វើ នៅ ថ្ងៃទី ១៤ ខែមិថុនា ដែល មាន រយៈពេល ១០ ថ្ងៃ ។
មហោស្រព ភាពយន្ត អន្តរជាតិ សៀង ហៃ ឆ្នាំ នេះ ធ្វើ ក្រោម ប្រធានបទ " ទីក្រុង នៃ ភាពយន្ត " ដែល មាន វណ្ណកម្មភាពយន្ត ចំនួន ជាង ៣៧00 រឿង នៃ ប្រទេស និង តំបន់ ចំនួន ១០៥ បាន ចុះឈ្មោះ ចូលរួម ការប្រកួតប្រជែង នេះ ។ បន្ទាប់ពី ការជ្រើសរើស មាន វណ្ណកម្មភាព យន្ត ចំនួន ៥០ រឿង នៃ ប្រទេស និង តំបន់ ចំនួន ២៩ ចូលរួម ប្រកួត យក ជ័យលាភី ក្នុង នោះ មាន ភាពយន្ត ចំនួន ៣៨ រឿង បាន ចាក់បញ្ចាំង ជា លើក ដំបូង លើ ពិភពលោក ។
២៖រលក នៃ ការច្នៃប្រឌិត ថ្មី បាន ប្រមូលផ្ដុំ នៅ ទីនេះ ។ ចូល ដល់ សតវត្ស ថ្មី ខ្សែ សង្វាក់ ឧស្សាហកម្ម ភាពយន្ត របស់ ទីក្រុង សៀងហៃ បាន ឆ្លងកាត់ ការផ្លាស់ប្តូរ និង ការអភិវឌ្ឍ បង្កើត បានជា ខ្សែ សង្វាក់ អេកូឡូស៊ី ឧស្សាហកម្ម ពេញលេញ ដែល រួមបញ្ចូល ការផលិត ការចែកចាយ ការបញ្ចាំង និង ការអភិវឌ្ឍ ជាដើម នេះ មិន ត្រឹមតែ ឆ្លុះបញ្ចាំង ពី កម្លាំង រឹងមាំ និង កម្លាំង រស់រវើក នៃ ឧស្សាហកម្ម ភាពយន្ត របស់ ទីក្រុង សៀងហៃ ប៉ុណ្ណោះ ទេ ក៏ ថែមទាំង បង្ហាញ ពី ទិសដៅ អភិវឌ្ឍ នា ពេល អនាគត នៃ ឧស្សាហកម្ម ភាពយន្ត របស់ ប្រទេស ចិន ផងដែរ ។
៥៖ ភាពរាក់ទាក់ របស់ ទស្សនិកជន គឺជា កម្លាំង ចលករ ខ្លាំង ដែល មិន អាច ខ្វះ បាន នៃ ទីក្រុង សៀងហៃ ដែល ជា ទីក្រុង ភាពយន្ត ។ ទីក្រុង សៀងហៃ មាន បរិយាកាស ភាពយន្ត យ៉ាង ជ្រាលជ្រៅ ទីផ្សារ អ្នកប្រើប្រាស់ សកម្ម និង ទស្សនិកជន គាំទ្រ ភាពយន្ត ដែល មាន ចំណេះដឹង ផ្នែក វប្បធម៌ ខ្ពស់ និង ស្តង់ដារ សោភ័ណភាព ។
ដូច្នេះហើយ ទីក្រុង សៀងហៃ មិន មែន គ្រាន់តែ ជា ទីក្រុង ប៉ុណ្ណោះ ទេ វា ក៏ ជា ភាពយន្ត ដែល មាន ជីវិត មួយ ដែល គ្រប់ ទីកន្លែង ក៏ ពោរពេញ ដោយ សាច់រឿង ហើយ គ្រប់ ពេល ក៏ ដើរតួ ជា រឿង ផ្សេង ៗ គ្នា ។ នៅ ទីនេះ មនុស្ស គ្រប់ រូប អាច រកឃើញ នូវ ពិភព នៃ ពន្លឺ និង ស្រមោល របស់ ខ្លួន ឯង ហើយ រាល់ ក្ដី សុបិន អាចនឹង ក្លាយជា ការពិត ។ នេះ គឺ ទីក្រុង សៀងហៃ ហើយ នេះ ជា ភាពទាក់ទាញ នៃ " ទីក្រុង ភាពយន្ត " ៕
( ត្បូងឃ្មុំ ) ៖ លោក ងឿន ច័ន្ទ លីន ប៉ូឡ៉ែន អនុ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន ទទួលបន្ទុក ខេត្ត ត្បូងឃ្មុំ រួម ដំណើរ ដោយ លោក វ៉ាន់ វីរៈ ប្រធាន ស្តីទី មន្ទីរព័ត៌មាន ខេត្ត ត្បូងឃ្មុំ និង ក្រុមការងារ កាលពី កន្លងទៅ ថ្មី ៗ នេះ បាន ចុះសិក្សា និង ផ្តិត យក រូបភាព នៅ រមណីយដ្ឋាន « ទឹក ធ្លាក់ ហោង » ដើម្បី ផ្សព្វផ្សាយ ដល់ អ្នកទេសចរណ៍ ឲ្យបាន ស្គាល់ និង មក លេង កំសាន្ត នៅ ទីនេះ ។
ជាមួយនឹង ធម្មជាតិ យ៉ាង ស្រស់ ត្រកាល លោក ងឿន ច័ន្ទ លីន ប៉ូឡ៉ែន ក៏ បាន ជំរុញ ឲ្យ មន្ទីរព័ត៌មាន ខេត្ត បង្កើន ការផលិត ផ្សព្វផ្សាយ ទីនេះ ក៏ ដូចជា សំណូមពរ ដល់ អាជ្ញាធរ ខេត្ត អភិវឌ្ឍន៍ ទឹក ធ្លាក់ ធម្មជាតិ នេះ ឲ្យ កាន់តែ មាន សោភ័ណ ស្រស់ស្អាត ទាក់ទាញ បន្ថែម ទៀត ។
ជាមួយគ្នា នោះ លោក វ៉ាន់ វីរៈ ប្រធាន ស្តីទី មន្ទីរព័ត៌មាន ខេត្ត ត្បូងឃ្មុំ បញ្ជាក់ ថា ក្រុមការងារ មន្ទីរ កន្លងមក តែងតែ ចុះ ផ្តិត យក រូបភាព និង វីដេអូ ផ្សព្វផ្សាយ ជា បន្តបន្ទាប់ ហើយ នៅតែ បន្ត ផ្សព្វផ្សាយ ឲ្យបាន កាន់តែ ច្រើន និង ទូលំទូលាយ បន្ថែម ទៀត ផងដែរ ព្រោះ ទីនេះ ជា តំបន់ មាន សក្តានុពល បែប ធម្មជាតិ របស់ ខេត្ត ដែល មាន ។
លោក វ៉ាន់ វីរៈ បន្ថែម ថា ជាពិសេស ស្រប តាម ការចង្អុលបង្ហាញ ពីសំណាក់ លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន តែងតែ ណែនាំឲ្យ មន្ទីរព័ត៌មាន តាម បណ្តា ខេត្ត ផ្សព្វផ្សាយ បង្ហាញ ពី សក្តានុពល ដែល មាន និង សមិទ្ធិផល បាន អភិវឌ្ឍន៍ កំពុង អភិវឌ្ឍន៍ និង បន្ត អភិវឌ្ឍន៍ ក្នុង ខេត្ត របស់ ខ្លួន ឲ្យបាន ច្រើន និង ទូលំទូលាយ ដល់ ស្រទាប់ មហាជន ។
សូម ជម្រាប ថា « ទឹក ធ្លាក់ ហោង » ជា រមណីយដ្ឋាន ទឹក ធ្លាក់ ធម្មជាតិ ប្រវត្តិសាស្រ្ត ដ៏ មាន សក្តានុពល មួយ ក្នុង ខេត្ត ត្បូងឃ្មុំ ។ ជាមួយនឹង ទឹក ធ្លាក់ កម្ពស់ ប្រមាណ ៨ម៉ែត្រ អម ដោយ ទេសភាព ធម្មជាតិ ដ៏ ត្រកាល អាជ្ញាធរ ខេត្ត ក៏ បាន ដាក់ គោលដៅ អភិវឌ្ឍន៍ តំបន់ នេះ ទៅជា ទី ទេសចរណ៍ គំរូ សម្រាប់ ខេត្ត នា ពេល ខាងមុខ ។
រមណីយដ្ឋាន ធម្មជាតិ « ទឹក ធ្លាក់ ហោង » មាន ទីតាំង ស្ថិត ក្នុង ឃុំ កំពាន់ ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ចម្ងាយ ប្រមាណ ៣៨ គីឡូម៉ែត្រ ពី ទី រួម ខេត្ត ។
ក្រៅពី មាន រូង ភ្នំ ថ្ម រាប់ សិប ម៉ែត្រ ដែល បង្កើត បានជា ល្បាក់ ទឹក ធ្លាក់ ជាច្រើន ថ្នាក់ រមណីយដ្ឋាន « ទឹក ធ្លាក់ ហោង » ហ៊ុមព័ទ្ធ ទៅ ដោយ ទេសភាព ព្រៃឈើ យ៉ាង ស្រស់បំព្រង និង ខ្យល់អាកាស បរិសុទ្ធ គួរ ជា ទី មនោរម្យ សម្រាប់ ភ្ញៀវ ទេសចរណ៍ ដើរលេង កំសាន្ត បែប ធម្មជាតិ អម ជាមួយ ទឹក ធ្លាក់ ៕ អ្នកជំនាញ មើលឃើញ ការគំរាមកំហែង លើ សន្តិសុខ សាយប័រ កើនឡើង គួរឱ្យ បារម្ភ ដែល ទាមទារ ឱ្យ មាន វិធានការ ទប់ស្កាត់ ជា ចាំបាច់
លោកស្រី បាន បន្ត ទៀត ថា « អំឡុង ពេល ប៉ុន្មាន ឆ្នាំ មក នេះ ការគំរាមកំហែង មក លើ សន្តិសុខ សាយប័រ មាន ការកើនឡើង គួរឱ្យ ព្រួយបារម្ភ ហើយ បង្កឱ្យ មាន ផល ប៉ះពាល់ និង ការរំខាន ដល់ សន្តិសុខ សាយប័រ ក្នុង នោះ មិន ត្រឹមតែ បញ្ហា របស់ ក្រុមហ៊ុន ឯកជន ធនាគារ និង ក្រសួង - ស្ថាប័ន រដ្ឋ ប៉ុណ្ណោះ ទេ សូម្បីតែ ព័ត៌មាន សម្ងាត់ ឬ ព័ត៌មាន ឯកជន ក៏ ស្ថិត ក្នុង ស្ថានភាព គ្រោះថ្នាក់ ដែរ ដែល ទាមទារ ឱ្យ មាន វិធានការ បង្ការ និង ទប់ស្កាត់ ជា ចាំបាច់ ព្រមទាំង ត្រូវ មាន ការរក្សាទុក និង ការពារ យ៉ាង យកចិត្តទុកដាក់ » ។
