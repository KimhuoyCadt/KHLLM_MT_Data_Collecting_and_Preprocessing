ការពាក់ ស្រោម ក្នុង ទឹក មិន ត្រឹមតែ ពិបាក ពាក់ ទេ វា ថែមទាំង អាច ងាយ របូត និង បាត់បង់ ជាតិ រំអិល ទៀត ។
មេជីវិត ឈ្មោល អាច រស់ នៅក្នុង ទឹក យ៉ាង យូរ ពីរ បី នាទី ប៉ុណ្ណោះ ហើយ វា ក៏ មិន អាច ហែល បាន ឆ្ងាយ ដែរ ដូច្នេះ អត្រា ធ្វើឱ្យ ស្ត្រី មាន ផ្ទៃពោះ ក៏ ស្ទើរតែ មិន មាន ដែរ ។
មិន មាន ជម្រើស ច្រើន ឡើយ ព្រោះ អ្នក មិន អាច ឱ្យ រាងកាយ ប៉ះពាល់ ឆ្នេរ ខ្សាច់ ។
ច្បាស់ ណាស់ វា ជា រឿង មិន ស្រប ច្បាប់ ឡើយ ហើយ កម្រិត នៃ ការដាស់ ទោស ក៏ អាស្រ័យ លើ ច្បាប់ ប្រទេស ខុស ៗ គ្នា ចាប់តាំងពី ការផាកពិន័យ ការអប់រំ ណែនាំ រហូតដល់ បញ្ជូន ចូល ពន្ធនាគារ ។
បារី អគ្គិសនី និង បារី ថ្នាំជក់ គ្រោះថ្នាក់ ដល់ សុខភាព បេះដូង ដូចគ្នា
ក្រុម អ្នកវិទ្យាសាស្ត្រ រកឃើញ ថា ការស្រូបយក ជាតិ ផ្សែង ថ្នាំជក់នីកូទីន អគ្គិសនី ប៉ះពាល់ ដល់ សរសៃ ឈាម បេះដូង សំខាន់ ដែល ជា ហានិភ័យ នៃ ជំងឺ បេះដូង ។
ពួកគេ រកឃើញ ថា អាហារ ផ្សែង ទាំង ពីរ ប្រភេទ ជះ ឥទ្ធិពល អាក្រក់ ដល់ សរសៃ ឈាម សំខាន់ ធ្ងន់ធ្ងរ ដែល ជាដើម ចម បង្ក បញ្ហា ដល់ បេះដូង និង ជំងឺ លើស ឈាម ផងដែរ ។
ក្រុម អ្នកវិទ្យាសាស្ត្រ ក្រិក សង្កត់ធ្ងន់ ថា ពួកគេ ត្រូវ ការ ស្រាវជ្រាវ បន្ថែម ទៅ លើ គ្រោះថ្នាក់ រយៈពេល យូរអង្វែង ។
ប៉ុន្តែ ពួកគេ ថា ការតាមដាន លើ បុរស និង ស្ត្រី សុខភាព ល្អ ២៤ នាក់ អាយុ មធ្យម ខ្ទង់ ៣០ បាន បង្ហាញ ថា បារី អគ្គិសនី ប៉ះពាល់ ធ្ងន់ធ្ងរ ជាង ការគិត ទៅ ទៀត ។
ក្តីកង្វល់ របស់ ពួកគេ ត្រូវបាន សាទ រ ដោយ មូលនិធិ សុខភាព អង់គ្លេស ដែល បាន ឱ្យដឹង ថា ឧបករណ៍ អគ្គិសនី នេះ មិន គួរ ជា វត្ថុ លេងសើច នោះ ទេ ។
អង្គការ សុខភាព ពិភពលោក ព្រមាន ថា បារី អគ្គិសនី អាច ជះ ក្លិន ផ្សែង ពុល ដល់ អ្នក ស្រូប ផងដែរ ។
ប៉ុន្តែ ពួកគេ ត្រូវការពេល ស្រាវជ្រាវ បន្ថែម ទៀត ។
ការប្រើប្រាស់ ថេប្ល៊ិ ត កុមារ អូទី សឹម អាច លេង ហ្គេម ដែល វាស់ស្ទង់ ពី ចលនា និង កាយវិការ ពួកគេ ដែល ផ្តោត សំខាន់ លើកម្លាំង សង្កត់ និង កាយវិការ ខុស ប្រក្រតី ។
អូទី សឹម ជាពិការភាព ប្រព័ន្ធ ប្រសាទ ហើយ វា ប៉ះពាល់ ដល់ កុមារ ម្នាក់ ក្នុង ចំណោម ១៦០ នាក់ ទូទាំង ពិភពលោក ។
ប្រាថ្នា រាង ស្រលូន ស្បែក មុខ ស្អាត និង បេះដូង ល្អ បង្កើន ការរួមភេទ ស្រប ចំណង់
ចង់បាន រូបរាង ស្អាត ស្រលូន ស្បែក ស្អាត សុខភាព បេះដូង ល្អ និង បន្ធូរ ភាពតានតឹង មែន ទេ ?
មិន ចាំបាច់ តម អាហារ ឬ ភេសជ្ជៈ សម្រក ទម្ងន់ អ្វី ឡើយ គ្រាន់តែ ផ្តោត លើ សិច ។
នេះ ជា ដំបូន្មាន ស្តីពី សុខភាព ផ្លូវចិត្ត និង លំហាត់ប្រាណ ផ្លូវកាយ របស់ ក្រុម អ្នកជំនាញ មកពី សាកលវិទ្យាល័យ ឃើរ ទីន ។
សាស្ត្រាចារ្យ ម៉ាត ធីលលី បង្រៀន ផ្នែក សុខភាព ផ្លូវភេទ នៅ សាកលវិទ្យាល័យ ឃើរ ទីន បាន ពន្យល់ ប្រាប់ ថា ៖
សិច ជំនួយ ដល់ ស្បែក អារម្មណ៍ នៃ សេចក្តីស្រឡាញ់ និង ផ្អែមល្ហែម នាំឱ្យ បញ្ចេញ នូវ អ័រម៉ូន ពីរ ប្រភេទ គឺ អេនដូរ ហ្វីនស៍ ជា អ្នក បញ្ជូន សញ្ញា និង សេរ៉ូតូ នីន ។
អ័រម៉ូន ទាំង ពីរ នេះ ជួយ ដល់ ស្បែក អ្នក ។
អេន ឌូរ ហ្វីនស៍ បង្កើត កោសិកា ស្បែក ថ្មី ៗ និង សរសៃ ទឹក ប្រូតេអ៊ីន ធម្មជាតិ បន្តឹង ស្បែក មុខ និង បំបាត់ ជំងឺ មុន ជួយ ទប់ស្កាត់ បញ្ហា សក់ ឆាប់ ស្កូវ ជំងឺ វង្វេងវង្វាន់ និង ជំងឺ រលាក ស្បែក រ៉ាំរ៉ៃ ។
ការបញ្ចេញ ញើស លើ ផ្ទៃ មុខ ពេល ប្រតិបត្តិការ ក្តៅ គគុក វា ជា វិធី ដ៏ ល្អ ដើម្បី សម្អាត បាក់តេរី មក ផ្តុំ គ្នា នៅលើ ស្បែក មុខ ។
សិចជា លំហាត់ប្រាណ សកម្ម សាស្ត្រាចារ្យ ខេវីនណេត តូជា នាយក ផ្នែក ស្រាវជ្រាវ នៅ សាលា វិទ្យាសាស្ត្រ លំហាត់ប្រាណ និង ធម្មជាតិ វិទ្យា ថា ៖
មនុស្ស គ្រប់ រូប គួរ ហាត់ប្រាណ ពី កន្លះ ទៅ មួយ ម៉ោង ក្នុង មួយ ថ្ងៃ ពីព្រោះ បច្ចុប្បន្ន យើង មាន ការងារ ត្រូវ អង្គុយ ច្រើន ។
ប៉ុន្តែ បើសិច ក៏ ជា លំហាត់ប្រាណ នោះ វា ពិតជា អស្ចារ្យ ណាស់ ។
នេះ បើ យោង តាម ការសិក្សា កាលពី ឆ្នាំ ២០១៣ ដោយ សាកលវិទ្យាល័យ ឃ្វេ បេក ។
ការរួមភេទ យូរ ជាង នេះ ដែល អាច ជា ការប្រើប្រាស់ ក្បាច់ រួមរ័ក ប្លែក ៗ កាន់តែ មាន ប្រសិទ្ធភាព ថែម ទៀត ។
សកម្មភាព រាងកាយ ទាំង ព្រម នេះ នឹង ជួយ ដល់ ចលនា ចង្វាក់ បេះដូង តាម ធម្មជាតិ ។
វា ស្មើនឹង ការជិះ កង់ ២៣នាទី ហក់ លោត ២០នាទី ឬ ហែលទឹក ១៥នាទី ។
សមាគម បេះដូង អាមេរិក AHA ឱ្យដឹង ថា ចំពោះ សុខភាព បេះដូង ទូទៅ យើង ត្រូវការបញ្ចេញ សកម្មភាព ហាត់ប្រាណ អារ៉ូប៊ិក យ៉ាងតិច ៣០នាទី នៅ រយៈពេល ៥ ថ្ងៃ យ៉ាងតិច ក្នុង មួយ សប្តាហ៍ ។
ក្រៅពី នេះ យើង គួរតែ បញ្ចេញ សកម្មភាព ពង្រឹង សាច់ សុំ ទាំង ក្លៀវក្លា និង ល្មម ៗ ពីរ ដង ក្នុង មួយ សប្តាហ៍ ផងដែរ ។
សិច ជួយ រម្ងាប់ អារម្មណ៍ អ័រម៉ូន សេរ៉ូតូ នីន ដែល បាន បញ្ចេញ ពេល សម្រេច កាម ផ្តល់ នូវ សេចក្តីស្រណុក ស្រួល រម្ងាប់ អារម្មណ៍ ស្ត្រ សនេិង ក្រេវក្រោធ ។
ចំពោះ ការបញ្ចេញ អ័រម៉ូន នេះ សាស្ត្រាចារ្យ ធី លលី និយាយ ថា សម្ព័ន្ធ ផ្លូវភេទ កើត ពី ចំណង់ ព្រម គ្នា គឺជា ឱសថ ប្រឆាំង ជំងឺ ធ្លាក់ទឹកចិត្ត ធម្មជាតិ ។
ប៉ុន្តែ លោក ព្រមាន ថា សិច ត្រូវតែ កើត ចេញ ពី ចំណង់ ព្រម គ្នា និង វិជ្ជមាន ដើម្បី បង្កើន សុខភាព ផ្លូវកាយ និង ផ្លូវចិត្ត ។
កាលៈទេសៈ ផ្សេង នឹង បង្កើត ឱ្យ មាន លទ្ធផល អវិជ្ជមាន ។
ពេល ឈានដល់ ចំណុច កំពូល រាងកាយ បុរស ផលិត អ័រម៉ូន ម្យ៉ាង ឈ្មោះ ប្រូឡាក ទីន ដែល ធ្វើឱ្យ ងងុយ គេង ។
បុរស ផលិត អ័រម៉ូន នេះ ច្រើន ជាង ស្ត្រី ។
គូស្នេហ៍ ទូទៅ តែង កុហក ពី លទ្ធភាព នៃ ទង្វើ ក្បត់ ផិត គ្នា
ច្បាស់ ណាស់ ថា មនុស្ស រមែង ជឿ ថា ទំនាក់ទំនង ស្នេហា របស់ ខ្លួន ក៏ ល្អ ប្រសើរ ជាង អ្នកដទៃ ដែរ ។
ជាទូទៅ យើង គិត ថា ដៃគូ ស្នេហា របស់ យើង មាន អត្រា ក្បត់ ផិត តិចតួច បំផុត ។
នេះ យោង តាម ការស្រាវជ្រាវ ថ្មី ៗ នេះ ដែល ដកស្រង់ ចេញ ពី ព្រឹត្តិបត្រវិទ្យាសាស្ត្រ នៃ ទំនាក់ទំនង ស្នេហា មកពី សាកលវិទ្យាល័យ ខាល ហ្គារី និង មន្ទីរពេទ្យ កុមារ ម៉ាក ម៉ាស្ទ័រ ។
សម្រាប់ ការសិក្សា នេះ ក្រុម អ្នកស្រាវជ្រាវ បាន ជ្រើសរើស និស្សិត សាកលវិទ្យាល័យ ២០០ នាក់ ដែល កំពុងតែ មាន ស្នេហា ចំពោះ ដៃគូ ភេទ ផ្ទុយ យ៉ាងតិច រយៈពេល ៣ខែ ។
ក្រុម អ្នកចូលរួម បាន រាយការណ៍ ថា ពួកគេ ជឿ ថា ចំពោះ គូស្នេហ៍ អ្នកដទៃ យ៉ាងតិច អត្រា ៤២ ភាគរយ ដែល ពួកគេ មាន ឱកាស ក្បត់ ផិត គ្នា ។
ប៉ុន្តែ ពេល សំដៅ លើ ដៃគូ ស្នេហា ខ្លួន ឯង វិញ ក្រុម អ្នកចូលរួម បាន ប៉ាន់ប្រមាណ ថា មាន ចំនួន តែ ៥ភាគរយ ដែល ដៃគូ បាន ក្បត់ ចិត្ត នឹង ខ្លួន និង ប្រមាណ ៨ភាគរយ ដែល ដៃគូ អាច ក្បត់ ផិត នា ពេល ខាងមុខ ។
ដ្បិត គូស្នេហ៍ ទាំង នេះ កំពុងតែ ស្រឡាញ់ គ្នា និង មិន ទាន់ បាន រៀបការ យ៉ាងណា ក៏ដោយ ក៏ ពួកគេ នៅតែ ជឿជាក់ លើ គ្នា ទោះ ខ្លះ ខំ បន្លប់ ចិត្ត ខ្លួន ឯង ឱ្យ ទំនាក់ទំនង មាន ស្ថិរភាព ។
អ្វី ដែល សំខាន់ បំផុត សម្រាប់ ការស្រាវជ្រាវ នេះ គឺ ថា ថ្វីដ្បិត តែ មនុស្ស ស្ទើរតែ គ្រប់ រូប ដែល បាន ចូលរួម ក្នុង ការស្រាវជ្រាវ នេះ បាន និយាយ ថា វា ពិតជា សំខាន់ ដែល ដៃគូ របស់ ខ្លួន មិន ត្រូវ ក្បត់ ចិត្ត ខ្លួនអ្នក ខ្លះ និយាយ ថា ពួកគេ ជជែក អំពី ភាព មិន ស្មោះត្រង់ ជាមួយ ដៃគូ ដែរ ។
គូស្នេហ៍ លើស ពាក់កណ្តាល ហ៊ាន ជជែក អំពី បញ្ហា នៃ អំពើ ផិត ក្បត់ ។
ប៉ុន្តែ មនុស្ស តិចតួច បំផុត ដែល បាន លើកឡើង ថា ពួកគេ អាច ឈាន ទៅដល់ កិច្ចព្រមព្រៀង ជាមួយនឹង ដៃគូ អំពី បញ្ហា នេះ ៕
តើ បុរស ប្រភេទ ណា មាន សមត្ថភាព ឱ្យ ដៃគូ ឈានដល់ ចំណុច កំពូល ?
ការសិក្សា ចុងក្រោយពី សាកលវិទ្យាល័យ អាល់ បានីតាមដាន ពី បុរស លើ សមត្ថភាព ផ្តល់ ក្តីសុខ ផ្លូវភេទ ដល់ ស្ត្រី ។
វា អាច ជា ការរៀប ឫក និង ទេពកោសល្យ របស់ បុរស ដែល ប្រលោម ឱ្យ ដៃគូ ទទួលបាន នូវ សេចក្តីស្រណុក ស្រួល ។
ការសិក្សា នេះ ជា ការស៊ើបអង្កេត ស៊ីជម្រៅ ការសម្រេច កាម របស់ ស្ត្រី មាន តួនាទី ជា ការលើកស្ទួយ ទំនាក់ទំនង ស្នេហា កាន់តែ ផ្អែមល្ហែម ។
ការតាមដាន លើ និស្សិត ស្រី ចំពោះ ទំនាក់ទំនង ស្នេហា ពួកគេ និង រកឃើញ ថា លទ្ធភាព សម្រេច កាម ញឹកញយ របស់ និស្សិត ស្រី ទាំង នេះ ពាក់ព័ន្ធ នឹង ចំណូល គ្រួសារ ដៃគូ ជំនឿចិត្ត របស់ ដៃគូ និង ភាពទាក់ទាញ របស់ ដៃគូ ។
លទ្ធផល បង្ហាញ ថា នារី ដែល បាន ជួប ដៃគូ ពូកែ កំប្លុក កំប្លែង និង មាាំ មួន នាង កាន់តែ ងាយ នឹង បាន ឡើង ឋានសួគ៌ ឆាប់ ហើយ ក្រោយពី សម្រេច កាម អ្នកកាន់តែ រំជើបរំជួល ចំពោះ សិច នៅ វគ្គ បន្តបន្ទាប់ ទៀត ។
ការសិក្សា រកឃើញ ថា ស្ត្រី អាចនឹង ឆាប់ សម្រេច កាម បើ ដៃគូ មាន រូបរាង សង្ហា និង មាំ មួន ដោយ យល់ ថា បើ នារី ណា ម្នាក់ អាច ឈានដល់ ចំណុច កំពូល ជាមួយ បុរស ណា នាង ទំនង ជាងប់ ស្រឡាញ់ បុរស នោះ ។
អ្នកនិពន្ធ សរសេរ ថា ៖
ទឹកក្រូច កូកាកូឡា មួយ កំប៉ុង ផ្ទុក សារធាតុ ស្ករ ជិត ១០ស្លាបព្រា កាហ្វេ ខណៈ នំ សូកូឡា មួយ ដុំ ផ្ទុក ជាតិ ស្ករ ក្រោម កម្រិត ៦ស្លាបព្រា បន្តិច ។
សម្រាប់ កុមារ ជាច្រើន ទទួលទាន ភេសជ្ជៈ ជាតិ ស្ករ និង នំ ផ្អែម គឺជា ការបន្ថែម ជាតិ ស្ករ ដ៏ ច្រើន ទៅក្នុង របប អាហារ ប្រចាំ ថ្ងៃ របស់ ពួកគេ ។
ប៉ុន្តែ យោង តាម របាយការណ៍ ថ្មី មួយ របស់ សាកលវិទ្យាល័យ វេជ្ជសាស្ត្រ អេម៉ូរី ក្នុង ក្រុង អាត្លង់តា សហរដ្ឋ អាមេរិក បាន ឱ្យដឹង ថា ការទទួលទាន ចំណី ចំណុក នំ នែក និង បង្អែម ចម្អាប ដែល ផ្ទុក ជាតិ ស្ករ លើស ពី ៦ស្លាបព្រា កាហ្វេ សុទ្ធតែ អាច បង្ក ហានិភ័យ ចំពោះ សុខភាព កុមារ ។
ការសិក្សា ក៏ បាន ព្រមាន ថា កុមារ អាយុ ក្រោម ពីរ ឆ្នាំ មិន គួរ បន្ថែម ជាតិ ស្ករ ដែល មិន ចាំបាច់ ទៅក្នុង របប អាហារ ប្រចាំ ថ្ងៃ របស់ ពួកគេ ឡើយ ។
សារធាតុ ស្ករ មួយ ស្លាបព្រា កាហ្វេ ស្មើនឹង បរិមាណ ៤ក្រាម ។
ដូច្នេះ ៦ស្លាបព្រា ស្មើនឹង ២៤ ក្រាម នៃ ស្ករ និង បង្កើត កាឡូរី រហូតដល់ ១០០ ។
ស្រដៀង នឹង លទ្ធផល ស្រាវជ្រាវ នេះ ដែរ វិទ្យាស្ថាន ជាតិ សុខភាព ថ្មី ៗ នេះ បាន ធ្វើ ការណែនាំ ដល់ កុមារ អាយុ ពី ៤ទៅ ៨ ឆ្នាំ មិន គួរ ទទួលទាន ជាតិ ស្ករ លើស ពី ៣ស្លាបព្រា កាហ្វេ ១២ក្រាម នោះ ទេ ។
ញ៉ាំ ផ្លែ ឈើ ក្រោយ ហាត់ប្រាណ អាច នាំឱ្យ ធាត់
តែ អ្នកជំនាញ បាន ព្រមាន ថា ការទទួលទាន ផ្លែ ឈើ ច្រើន ពេក ឬ ខុស ពេល ខុស វេលា អាច បង្កឱ្យ ធាត់ ឡើង ទម្ងន់ ទៅ វិញ ។
អ្នកជំនាញ លំហាត់ប្រាណ និង សុខភាព លោក លោក ខាល លូម ម៉េលី បាន ឱ្យដឹង ថា មាន ការភាន់ច្រឡំ ទូទៅ ដែល ថា ការទទួលទាន ផ្លែ ឈើ ក្រោយ ហាត់ប្រាណ ពិតជា ល្អ សម្រាប់ សុខភាព ខណៈ វា នឹង បំពេញ សមាសធាតុ គ្លីកូហ្សេន សាច់ដុំ ឡើងវិញ ។
ប៉ុន្តែ លោក បាន ព្រមាន ថា ផ្លែ ឈើ អាច បំពេញ គ្លីកូហ្សេន ថ្លើម ប៉ុណ្ណោះ មិន មែន សាច់ដុំ ឡើយ ។
គ្លីកូហ្សេន គឺជា ប្រភព ធនធាន ជំនួយ ដល់ សាច់ដុំ ហើយ វា នឹង ត្រូវបាន ប្រើ អំឡុង ពេល ធ្វើ លំហាត់ប្រាណ ដែល សម្បូរ នៅលើ បាយ និង ដំឡូងបារាំង ។
លោក បាន បកស្រាយ ថា ៖
ប៉ុន្តែ កាន់តែ សំខាន់ ថែម ទៀត នោះ ជាតិ ស្ករ ក្នុង ផ្លែ ឈើ ត្រូវបាន ប្រើ ដោយសារ ពាង្គកាយ ជា ប្រភព ថាមពល និង មិន ត្រូវបាន បំប្លែង ហើយ បែរជា ត្រូវ ស្តុក ជា ខ្លាញ់ រាងកាយ វិញ ។
កំណត់ ត្រា លិង្គ ធំ តូច យោនី រឹងមាំ និង សិច ដៃគូ ច្រើន បំផុត ក្នុង ពិភពលោក
ចំណង់ រួមភេទ គឺជា ធម្មជាតិ មនុស្ស ហើយ សិច ក៏ ជា ផ្នែក មួយ នៃ ជីវិត ប្រចាំ ថ្ងៃ របស់ មនុស្ស ពេញ វ័យ ។
អ្នក អាច យល់ ថា ល្បែង លើ គ្រែ នេះ គឺជា រឿង ធម្មតា ប៉ុន្តែ ខាងក្រោម នេះ គឺជា រឿងរ៉ាវ ដ៏ គួរឱ្យ ភ្ញាក់ផ្អើល ឬ អាច ថា ជា កំណត់ត្រា សិច ដ៏ ប្លែក បំផុត ក្នុង លោក ។
ក្នុង ឆ្នាំ ២០០៤ តារា កុន សិច នាង លីហ្សា ស្ប៉ាកស៍ អាយុ ៣៨ ឆ្នាំ បាន បង្កើត កំណត់ ត្រា ពិភពលោក ថ្មី ចំពោះ ការរួមភេទ ជាមួយ បុរស ៩១៩ នាក់ ក្នុង រយៈពេល មួយ ថ្ងៃ ១២ ម៉ោង អំឡុង ពេលព្រឹត្តិការណ៍ ជើងឯក ហ្គេង ប៊េង ពិភពលោក ប្រចាំ ឆ្នាំ ក្នុង ប្រទេស ប៉ូឡូញ ។
នោះ មាន ន័យ ថា នាង ត្រូវ ចំណាយ ពេល ៤៥ វិនាទី រួមភេទ ជាមួយ បុរស ម្នាក់ ។
លោក ម៉ាសាន ណូប៊ូ សាតូ មកពី ជប៉ុន បាន គ្រង ឯតទគ្គកម្ម ពិភពលោក សម្រាប់ ការសម្រេច កាម ខ្លួន ឯង យូរ បំផុត ។
សិច ញឹកញាប់ បំផុត ចង្រិត ពូជ អូស្ត្រាលី អាច ជា ប្រភេទ សត្វ អាក្រក់ គួរឱ្យ ខ្ពើមរអើម តែ បើ និយាយ ពី ការជាន់ ញី វិញ អ្នក ជីវវិទ្យា រកឃើញ ថា ពួក វា អាច សម្រេច កាមត ម្រេក រហូត ជាង ៥០ ដង ក្នុង រយៈពេល ពី ៣ទៅ ៤ ម៉ោង ។
លិង្គ ដ៏ វែង បំផុត ដែល គួរឱ្យ ស្ញើច បាន គ្រង តំណែង ឯតទគ្គកម្ម ពិភពលោក នូវ ប្រវែង ៣៤សង់ទីម៉ែត្រ និង ទំហំ ១៦សង់ទីម៉ែត្រ ដែល ត្រូវបាន វាស់ កាលពី ដើម សតវត្សរ៍ ទី២០ ដោយ វេជ្ជបណ្ឌិត រ៉ូប៊ឺត អែល ឌី ខេន សុន ។
ថ្មី ៗ នេះ បុរស ម៉ិកស៊ិក រ៉ូបេតូ អេស ឃ្វី វែល ខា ប្រេរ៉ា បាន អះអាង ថា ខ្លួន មាន លិង្គ ប្រវែង ដល់ ទៅ ៤៨សង់ទីម៉ែត្រ និង ទំហំ ក្បាល លិង្គ ២៥, ៤សង់ទីម៉ែត្រ បើ ទោះជា ពុំ មាន ការវាស់វែង ផ្ទៀងផ្ទាត់ ជា ភ័ស្តុតាង ក្តី ។
លិង្គ តូច បំផុត ក្នុង លោក បាន ជាប់ កំណត់ ត្រា ពិភពលោក ត្រឹម ប្រវែង ១សង់ទីម៉ែត្រ ។
ស្ថានភាព លិង្គ កន្តុញ នេះ គេ ហៅ ថា មីក្រូ លិង្គ ដែល តួ លិង្គ ភាគ ច្រើន ត្រូវបាន លិប ចូលក្នុង រាងកាយ ។
តួ លិង្គ ដែល លិប ចូល រាងកាយ បាត់ មកពី ការវិវឌ្ឍ មិន គ្រប់គ្រាន់ ពី កំណើត ដែល ក្បាល លិង្គ ជាប់ នឹង ថ្ងាស ។
ដូច្នេះ តួ លិង្គ មិន បាន ពន្លូត ខ្លួន វែង ឡើយ ។
បាញ់ ទឹក កាម ឆ្ងាយ ជាង គេ លោក ហោសត៍ ស្កាល់ត៍ ជនជាតិ អាមេរិក គ្រង កំណត់ ត្រា ពិភពលោក ដោយ អាច បាញ់ ទឹក កាម ក្នុង ចម្ងាយ ៦ម៉ែត្រ ។
រីឯ ការបញ្ចេញ ទឹក សម្រេច កាម សម្រាប់ នារី ឆ្ងាយ បំផុត គឺ ៣ម៉ែត្រ ។
ថើប យូរ បំផុត ជនជាតិ ថៃ ជា សន្តិសុខ មន្ទីរពេទ្យ លោក អេក កាឆៃ ទីរ៉ា ណារ៉ាត់ អាយុ ៤៤ ឆ្នាំ និង ភរិយា ឈ្មោះ ឡាក់ សាណា អាយុ ៣៣ ឆ្នាំ បាន ថើប ជញ្ជក់ មាត់ គ្នា រយៈពេល ៥៨ ម៉ោង ៣៥ នាទី និង ៥៨ វិនាទី ។
យោង តាម ការសិក្សា ថ្មី មួយ បង្ហាញ ថា ជម្រើស នៃ ការឈរ ទោះ រយៈពេល ខ្លី អាច កាត់បន្ថយ ហានិភ័យ នៃ គ្រោះថ្នាក់ ជំងឺ បេះដូង ឬ ការអភិវឌ្ឍ ទៅជា ជំងឺ ទឹកនោម ផ្អែម យ៉ាង សម្បើម ។
ទន្ទឹមនឹង នេះ ការដើរ យឺត ៗ ឬ ជិះ កង់ តិច ៗ រយៈពេល ១០នាទី ក៏ អាច ជួយ គ្រប់គ្រង កម្រិត ជាតិ ស្ករ ផងដែរ ។
ដោយ មនុស្ស ភាគ ច្រើន កំពុង ចាប់ យក ជម្រើស ដើរ ទៅ ធ្វើ ការ ការសម្រេចចិត្ត ដ៏ តូចតាច បែប នេះ អាច ទទួល លទ្ធផល ដ៏ ធំ ចំពោះ សុខភាព សាធារណៈ ខណៈ ជំងឺ ទឹកនោម ផ្អែម នៅ ទូទាំង ពិភពលោក កំពុង ហក់ ឡើង ខ្លាំង ។
ហ្គេនន៍ ហ្គែសស័រ ជា អ្នកនិពន្ធ ជាន់ ខ្ពស់ នៃ សាលា អាហារ បំប៉ន និង លើកស្ទួយ សុខភាព នៅ សាកលវិទ្យាល័យ រដ្ឋ អារី ហ្ស៊ូ ណា ក្នុង ក្រុង ផូនិក និយាយ ថា ៖
មើល ទូរទស្សន៍ ច្រើន ម៉ោង ក្នុង មួយ ថ្ងៃ ធ្វើឱ្យ បុរស បាត់បង់ មេជីវិត មួយ ភាគ បី
ក្រុម អ្នកជំនាញ មកពី សាកលវិទ្យាល័យ កូប៉ិន ហាក បាន សិក្សា បុរស វ័យ ក្មេង ដែល មាន សុខភាព មាំទាំ ចំនួន ១២០០ នាក់ ដើម្បី ពិនិត្យមើល ថា តើ ការស្នេហ៍ សិទ្ធិ នឹង ទូរទស្សន៍ អាច បង្ក ផល ប៉ះពាល់ ដល់ មេជីវិត ឬ យ៉ាងណា ?
លទ្ធផល ដែល ចុះផ្សាយ ក្នុង ព្រឹត្តិបត្រ សិក្សា ពី រោគ រាតត្បាត អាមេរិក បាន បង្ហាញ ថា អ្នកងប់ ងុល ទៅនឹង ទូរទស្សន៍ មាន ចំនួន មេជីវិត ជា មធ្យម ៣៧លាន ក្នុង បរិមាណ ទឹក កាម ១មិល្លលីី ត្របើ ធៀប នឹង បុរស ដែល មិន សូវ អង្គុយ មុខ ទូរទស្សន៍ មាន មេជីវិត ៥២ លាន ក្នុង បរិមាណ ទឹក កាម ១មិល្លលីី ត្រ ដូចគ្នា ។
ពួកគេ ក៏ បាន បន្ទាប កម្រិត អ័រម៉ូន តេស្តូស្ទើ រ៉ុន បុរស ដែល រាងកាយ ត្រូវការ ដើម្បី ផលិត មេជីវិត ។
ប៉ុន្តែ ក្រុម អ្នកវិទ្យាសាស្ត្រ រកឃើញ ថា ការចំណាយ ពេល អង្គុយ មុខ កុំព្យូទ័រ ហាក់ មិន រង ឥទ្ធិពល អវិជ្ជមាន ដូច ទូរទស្សន៍ ទេ ។
នេះ អាច បណ្តាល មកពី អ្នក ដែល មើល ទូរទស្សន៍ ច្រើន ទំនងជា មិន សូវ ហាត់ប្រាណ ឬ ទទួលទាន អាហារ សុខភាព ជា ទម្លាប់ ដ៏ សំខាន់ សម្រាប់ ការថែរក្សា គុណភាព មេជីវិត ។
លទ្ធផល នេះ ឆ្លុះបញ្ចាំង ពី ការសិក្សា របស់ អាមេរិក ក្នុង ឆ្នាំ ២០១៣ ដែល បាន រកឃើញ ថា លំហាត់ប្រាណ ១៥ ម៉ោង ក្នុង មួយ សប្តាហ៍ អាច បង្កើន គុណភាព មេជីវិត ។
វីដេអូ សិច លើ អនឡាញ ជាដើម ចម ធំ មួយ ធ្វើឱ្យ បុរស អសមត្ថភាព ផ្លូវភេទ
មើល រូបភាព និង ភាពយន្ត អាសអាភាស នាំឱ្យ បុរស ពើប នឹង បញ្ហា ខ្សោយ អារម្មណ៍ និង ពិបាក នឹង បង្កើន ឱកាស ស្រើប ស្រាល នៅពេល ឡើង លើ គ្រែ ជាមួយ ដៃគូ ។
អ្នកជំនាញ ចិត្ត វិទ្យា ផ្នែក ផ្លូវភេទ ជឿ ថា ទូរស័ព្ទ ទំនើប និង ថេប្ល៊ិត ដែល ងាយស្រួល ស្វែងរក មាតិកា អាសអាភាស គ្រប់ ទីកន្លែង គ្រប់ ពេលវេលា គឺជា ដើម ចម ចម្បង នៃ បញ្ហា ។
