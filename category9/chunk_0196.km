អ្នក ជា មនុស្ស មាន ជំនឿចិត្ត និង គួជា ទី រាប់អាន របស់ អ្នកផង ទាំងពួង ។
អ្នក មិន ខ្លាច នឹង ការចេញមុខ ទទួលខុសត្រូវ ។
អ្នកដឹង ថា បើ អ្នកកាន់ កិច្ចការ អ្វី មួយ វា នឹង មាន ការរីកចម្រើន ។
ក្បាច់ ឆ្កែ អ្នក ពេញចិត្ត ឱ្យ ដៃគូ មាន អារម្មណ៍ រំជើបរំជួល និង គិត ថា គាត់ ជា អ្នកគ្រប់គ្រង លើ រូប អ្នក ។
ក្នុង បន្ទប់ ដំណេក មិន ខុសពី ការរស់នៅ ក្នុង សង្គម ឡើយ អ្នក ប្រាកដជា រីករាយ ក្នុង នាម ជា អ្នក មាន ឥទ្ធិពល ។
អ្នក ចូលចិត្ត ឱ្យ អ្នកដទៃ បម្រើ តាម ចំណង់ របស់ អ្នក ខណៈ រូប អ្នក ព្យាយាម គ្រប់គ្រង ស្ថានការណ៍ ។
អ្នក ចង់ឱ្យ មនុស្ស គ្រប់ រូប រីករាយ ដរាបណា អ្នក ឈានដល់ ឋានសួគ៌ មុន សិន ។
អ្នក ចូលចិត្ត គិត ងាយ ឱ្យ ស្រណុក ស្រួល ។
អ្នក ចូលចិត្ត ភាពស្និទ្ធស្នាល ថ្នាក់ថ្នម និង ទន់ភ្លន់ ។
អ្នក ជា មនុស្ស ប្រភេទ សុភាព រាបសា មិន គំរោះ គំរើយ ។
នៅពេល ជួប រឿងរ៉ាវ ផ្ទាល់ខ្លួនអ្នក ព្យាយាម ដោះស្រាយ ដោយ ងាយ ៗ និង មិន អន្ទះសា ។
អ្នក ចូលចិត្ត អ្វី ដែល ខ្លួន ចង់ ធ្វើ និង បណ្តោយ ទៅ តាម ស្ថានការណ៍ ជាក់ស្តែង ។
អ្នក ម៉ឺងម៉ាត់ ព្រមទាំង មាន អំណួត មិន ចុះ ញ៉ម និង មាន ជំនឿចិត្ត លើ ខ្លួន ឯង ។
អ្នក ពេញចិត្ត នឹង ការបំពេញភាពរីករាយ ពី អ្នកដទៃ ហើយ អ្នកដទៃ ក៏ នឹង ធ្វើឱ្យ អ្នក ពេញចិត្ត ពេញ ថ្លើម វិញ ដែរ ។
អ្នក ជា បុគ្គល រួសរាយ និង ក្លៀវក្លាហ៊ាន ប្រឈម នឹង បញ្ហា ចំពោះ មុខ ។
អ្នក តែងតែ គិត បាន ជ្រៅជ្រះ និង សម្លឹង វែងឆ្ងាយ ។
ក្បាច់ កន្ត្រៃ អ្នក ពិតជា មនុស្ស ក្លាហាន និង មិន ខ្លាច ក្នុង ការឈរ តតាំង ឡើយ ។
បើ មាន ការប្រកួត ដណ្តើម រង្វាន់ អ្នក ជា បេក្ខជន ដំបូង ក្នុង កម្មវិធី ។
អ្នក ចូលចិត្ត នូវ ការច្នៃប្រឌិត បង្កើត ថ្មី និង ជា ដៃគូ អភិវឌ្ឍ ដ៏ ប៉ិនប្រសប់ ។
អ្នក ជា មនុស្ស ដែល ពេញចិត្ត នឹង ទស្សនីយភាព ខាងក្រោយ របស់ ដៃគូ ។
អ្នក ក៏ មាន ការប៉ិនប្រសប់ និង ចេះ បត់បែន ដែល ធ្វើឱ្យ ដៃគូ ពេញចិត្ត ពេញ ថ្លើម យ៉ាង ខ្លាំង ។
អ្នក មាន ជំនឿចិត្ត ខ្លាំង ។
អ្នក ជា មនុស្ស ស្គាល់ ពី ខ្លួន ឯង ច្បាស់ ហើយ គ្មាន អ្វី ជា ឧបសគ្គ សម្រាប់ អ្នក ឡើយ ។
អ្នក ជា មនុស្ស សាមញ្ញ ស្មោះត្រង់ និង មាន គេ ចូលចិត្ត អ្នក ច្រើន ។
អ្នក មិន ខ្លាច នឹង ការជម្នះ រាល់ ឧបសគ្គ និង ភាពផ្អែមល្ហែម ឡើយ ។
ជាក់ស្តែង នោះ ហើយ ជា អ្វី ដែល អ្នក ត្រូវការ ។
អ្នក ដឹង ពី ចំណង់ របស់ ខ្លួន និង ព្យាយាម ធ្វើ វា ឱ្យ បាន សម្រេច ដោយ ប្រើ វិធី ត្រជាក់ ។
អ្នក ចូលចិត្ត សាកល្បង អ្វី ដែល ថ្មី និង អារម្មណ៍ រំជើបរំជួល ហោះហើរ ។
អ្នក ព្យាយាម ចាប់ យក បទពិសោធ ថ្មី ៗ និង ជា ទីប្រឹក្សា ដែល មិត្តភក្តិ ចូលចិត្ត មក សុំ ការណែនាំ ។
ចំពោះ ក្បាច់ ភាគី នារី ប្រើ ឧបករណ៍ សិប្បនិម្មិតប្រហារ ភាគី បុរស ពីក្រោយ នេះ អ្នក ចូលចិត្ត គ្រប់គ្រង ស្ថានការណ៍ ទាំងអស់ ។
ចង់បាន កូន ២នាក់ អាយុព ពោះ ល្អ បំផុត គឺ ២៧ ឆ្នាំ
អ្នកស្រាវជ្រាវ ហូឡង់ បាន បង្កើត តារាង ទស្សន៍ទាយ ការបង្កកំណើត ដោយ ផ្អែក ទៅ លើ អាយុកាល របស់ ស្ត្រី ។
ក្រុម អ្នកវិទ្យាសាស្ត្រ មកពី សាកលវិទ្យាល័យ រ៉ូធឺរ ដាម បាន យក ទិន្នន័យ ស្ត្រី ដែល អាច មាន កូន ដោយ ធម្មជាតិ ចំនួន ៥៨០០០ នាក់ មកវិភាគ ។
បណ្ឌិត ឌីក ហា បេម៉ា មកពី សាកលវិទ្យាល័យ អេរ៉ាម៉ូស នៅ ក្រុង រ៉ូធឺរ ដាម ឱ្យដឹង ថា ៖
ខ្ញុំ សង្ឃឹម ថា គំរូ នេះ នឹង អាច ជា ផ្នែក មួយ ក្នុង ការសម្រេចចិត្ត ។
អ្នកវិទ្យាសាស្ត្រ រកឃើញ វិធី ទស្សន៍ទាយ អាយុ សង្ខារ របស់ មនុស្ស ម្នាក់ ៗ
ក្រុម អ្នកស្រាវជ្រាវ បាន ឱ្យដឹង ថា ការផ្តោត លើ កត្តា រាងកាយ ដែល វិវត្ត ទៅ តាម អាយុកាល ពិតជា មាន សារៈសំខាន់ ជាង ការវិវត្ត នៃ អាយុ ពិត តាម រង្វិល ឆ្នាំ ផែនដី ទៅ ទៀត ។
តេស្ត នេះ មាន ប្រយោជន៍ សក្តានុពល ជាច្រើន ទៀត ដូចជា ការទស្សន៍ទាយ ពី លទ្ធភាព កើត ជំងឺ វង្វេងវង្វាន់ ជំងឺ វិកលចរិត និង ការធ្វើតេស្ត សរីរាង្គ សម្រាប់ ផ្សាំ ផងដែរ ៕
បុរស គ្រប់ រូប រមែង ប្រាថ្នា លិង្គ ធំ ហើយ វែង ។
ពី ឱសថ ពង្រីក ដល់ ការវះកាត់ ឬ សូម្បីតែ ការប្រើ ម៉ាស៊ីន ទាញ បុរស ៗ សុខចិត្ត ធ្វើ អ្វី គ្រប់ យ៉ាង ឱ្យ តែ ខ្លួន បាន ធំ បើ ទោះបីជា ដឹង ថា ភាគី នារី មិន ចាប់អារម្មណ៍ អំពី ទំហំ ជាង សកម្មភាព ជាក់ស្តែង យ៉ាងណា ក៏ដោយ ។
យ៉ាងណាមិញ ខាងក្រោម នេះ គឺជា ការណែនាំ មួយចំនួន ពាក់ព័ន្ធ នឹង វិធី ពង្រីក ទំហំ លិង្គ ដោយ មិន ប្រើ មធ្យោបាយ សាច់ កម្ម ខាងលើ ។
កែប្រែ កាយវិការ ឬ បំពេញ កិច្ចការ ឱ្យ កាន់តែ ប្រសើរ អារម្មណ៍ ធុញ ថប់ ពី ការងារ និង បញ្ហា ផ្សេង ៗ អាច បង្កឱ្យ ប្រដាប់ ភេទ ត្បៀត កៀប ដូចជា អណ្តើក រួញ ក ។
ស្ត្រេស ពិតជា ធ្វើឱ្យ ស្ទះ លំហូរ ឈាម ទៅកាន់ បរិវេណ ក្រលៀន ចន្លោះ ភ្លៅ ដែល នាំឱ្យ ប្រដាប់ ភេទ ថមថយ អានុភាព និង រួម តូច ព្រមទាំង ប៉ះពាល់ ដល់ ចំណង់ ទៀត ។
កាយវិការ មិន សមរម្យ ពី ការអង្គុយ ធ្វើការ យូរ ពេក អាច ធ្វើឱ្យ សាច់ដុំ តឹង ត្រង់ ក្រលៀន ដែល មាន តួនាទី ព ន្លូត សាច់ដុំ និង ពង្រួញ ដង កាំបិត របស់ អ្នក ។
ការប្រើ កាយវិការ ម៉ាស្សា ជា រង្វង់ ដោយ យក ដៃ អង្អែល ថ្នម ៗ លើ បរិវេណ ប្រដាប់ ភេទ បន្ត ទៅ ភ្លៅ ផ្នែក ខាងក្នុង ឆ្អឹង ផាល ខាងមុខ និង គូទ ជាដើម ។
ប្រដាប់ ភេទ របស់ អ្នក ត្រូវការធ្វើ លំហាត់ប្រាណ ដើម្បី រក្សា សុខុមាលភាពល្អ ។
ការបំបះ ឱ្យ ឡើង រឹង ជាប្រចាំ រក្សា អានុភាព និង រឹងមាំ ល្អ ។
ប៉ុន្តែ បុរស ខ្លះ ពិបាក រក្សា លំនឹង សសរ ស្តម្ភ ឱ្យ ឈរ រឹង បាន យូរ ណាស់ ដោយសារតែ បញ្ហា របួស ឬ កើត ជំងឺ ទឹកនោម ផ្អែម ។
ប្រដាប់ ភេទ របស់ ពួកគេ នឹង រួញ ខ្លី ពី ១ ទៅ២សង់ទីម៉ែត្រ ។
ឧបករណ៍ នានា ដូចជា ប្រដាប់ បូម អាច ជួយ ស្រោចស្រង់ បាន ខ្លះ ។
ដើម្បី សម្រក ខ្លាញ់ ក្បាលពោះ ចូរ ទទួលទាន សាច់ និង ឈីស តិច ដោយសារ អាហារ ទាំង នេះ ធ្វើឱ្យ សរសៃ ឈាម រួម តូច ដោយ ជំនួស វិញ នូវ បន្លែ និង ផ្លែ ឈើ ពីព្រោះ វា ផ្ទុក សារធាតុ ប្រឆាំង អុកស៊ីត ដែល រក្សា លំហូរ ឈាម ល្អ ។
លំហាត់ប្រាណ នឹង អាច ជួយ បង្កើត ប្រសិទ្ធភាព ប្រហាក់ប្រហែល គ្នា ។
កាត់ តម្រឹម រោម វែង ៗ រោម មមីស កាន់តែ ខ្លី ប្រដាប់ ភេទ កាន់តែ អាច លូត វែង ។
ប៉ុន្តែ បើ កោរ ឱ្យ រលីង ឆិញ អាច បង្ក ហានិភ័យ វិញ ដោយសារតែ ត្រងោល តិល ហាក់ដូចជា ទើប ពេញ វ័យ ។
ត្រឹម ការតម្រឹម ឱ្យ ខ្លី គឺជា វិធី ល្អ បំផុត ។
ការសិក្សា មួយ កំណត់ លើ ប្រវែង និង ទំហំ លិង្គ មធ្យម ១៤, ២២និង ១២, ២០សង់ទីម៉ែត្រ ក៏ បាន រកឃើញ ថា បុរស ជា មធ្យម ឯកភាព ថា ប្រដាប់ ភេទ អាច រីក ធំ ក្រោយពី ដៃគូ ប្រើ មាត់ ជួយ ជាង ការប្រើ ក្បាច់ ធម្មជាតិ ។
សិច នៅក្រោម តំណក់ ទឹក ផ្កា ឈូក ឧណ្ហ ៗ កម្តៅ ទឹក ឧណ្ហ ៗ បង្កើន លំហូរ ឈាម និង ពង្រីក ទំហំ លិង្គ បាន បណ្តោះអាសន្ន ។
វា ក៏ អាច ជួយ សម្រួល ដុំ បាល់ ទាំង ពីរ គ្រាប់ ធ្លាក់ បង្រួម ខ្លួន ផងដែរ ។
ពង ស្វាស រួញ ចូល នៅពេល វា ប៉ះ កម្តៅ និង ពង្រួញ កាន់តែ តូច ពេល វា ត្រូវ ធាតុ ត្រជាក់ ។
សិច ក្រោម តំណក់ ទឹក ផ្កា ឈូក គឺជា យុទ្ធសាស្ត្រ ដ៏ ល្អ មួយ បើ អ្នក ចង់ បង្ហាញ អានុភាព ឱ្យ ដៃគូ បាន ឃើញ ។
ស្រោម អនាម័យ ទាំងនោះ ត្រូវបាន ច្រក ក្នុង ប្រអប់ ៥ ទំហំ ខុស ៗ គ្នា ចាប់ពី តូច បំផុត ជា ផ្លែ ត្រសក់ ផ្អរ រហូតដល់ ផ្លែ ត្រសក់ ស្រូវ ទំហំ ៥សង់ទីម៉ែត្រ ។
រូបភាព តាម អនឡាញ លោក ផាន បាន ពន្យល់ ថា ៖
បុរស អាច ជ្រើស យក ទំហំ ត្រសក់ ផ្អរ ការ៉ុត ចេក មើម ឆៃ ថាវ ឬ ត្រសក់ ស្រូវ អាស្រ័យ ទំហំ ប្រដាប់ ភេទ របស់ ខ្លួន ។
តើ ពេលណា ស្ត្រី គួរ ឬ ក៏ មិន គួរ សម្រាល កូន ដោយ ការវះកាត់
អង្គការ សុខភាព ពិភពលោក បាន បញ្ជាក់ ថា ការសម្រាល កូន ដោយ វះកាត់ ជា វិធីសាស្ត្រ សង្គ្រោះ ទាំង ម្តាយ និង ទារក ក្នុង ករណី ការសម្រាល មិន អាច ធ្វើ បាន តាម ទ្វារមាស ប៉ុណ្ណោះ ។
ហេតុផល ត្រួស ៗ ថា កំណើន ការ សម្រាល កូន ដោយ វះកាត់ គឺ ដោយសារ មន្ទីរពេទ្យ អាច ទទួល កម្រៃ ខ្ពស់ ងាយស្រួល រៀបចំ ម៉ោង ធ្វើការវះកាត់ កាត់បន្ថយ វេន យាម ខណៈ ដែល ស្ត្រី មាន ផ្ទៃពោះ មួយចំនួន មិន ចង់ ប្រឈម នឹង អាការ ឈឺ ពោះ ឆ្លង ទន្លេ ឬ បារម្ភ ខ្លាច ទ្វារមាស រីក ធំ ជាដើម ។
ការសម្រាល កូន ដោយ វះកាត់ តើ ការសម្រាល ដោយ វះកាត់ ជា អ្វី ?
ការសម្រាល កូន ដោយ វះកាត់ គឺជា ការយក ទារក ចេញ ពី ផ្ទៃ មាតា តាមរយៈ ការវះកាត់ ពោះ និង ស្បូន ។
ក្នុង កាលៈទេសៈ ខ្លះ ការសម្រាល កូន បែប នេះ ត្រូវបាន ធ្វើឡើង ដោយ គ្រោង ទុក ជាមុន និង ករណី ខ្លះ ទៀត គ្រូពេទ្យ សម្ភព ធ្វើ ការវះកាត់ យក ទារក ចេញ ពី ផ្ទៃ មាតា ដោយសារតែ បញ្ហា ប្រឈម ដែល មិន អាច ដឹង ទុក ជាមុន ។
ករណី ទាំង ពីរ នេះ ធ្វើឱ្យ ស្ត្រី ប្រឈម នឹង បញ្ហា បែក ស្បួន បើ នាង ព្យាយាម ប្រឹង សម្រាល តាម ទ្វារមាស បែប ធម្មជាតិ ។
កូន ភ្លោះ អាច ត្រូវបាន សម្រាល តាម បែប ធម្មជាតិ ប៉ុន្តែ ភាគ ច្រើន កំណើត ទារក លើស ពី មួយ ទាមទារ ការវះកាត់ បន្ថយ ហានិភ័យ ។
ករណី នេះ អាច កើតឡើង ដោយសារ ម្តាយ មាន ជំងឺ ទឹកនោម ផ្អែម ឬ ម្តាយ ដែល ធ្លាប់ ពពោះ ទារក ធំ ពេក នៅក្នុង ផ្ទៃ ដែល ធ្វើឱ្យ គាត់ ពិបាក សម្រាល លើក មុន ៗ ។
ពេល ព្យាយាម ចាក់ ថ្នាំ ឱ្យ ស្នូន កន្ត្រាក់ តែ វា មិន ដំណើរការ ។
អ្នក គេង មិន គ្រប់គ្រាន់ ប្រឈម នឹង ជំងឺ ផ្តាសាយ ខ្ពស់ ជាង ធម្មតា ដល់ ទៅ ៤ដង
លទ្ធផល ផ្សាយ ក្នុង ទស្សនាវដ្តី ដំណេក គឺ ផ្អែក លើ ការសិក្សា ពី ក្រុម អ្នកស្ម័គ្រចិត្ត ១៦៤ នាក់ ដោយ សុខចិត្ត ចម្លង ជំងឺ ផ្តាសាយ និង ឱ្យ ក្រុម ស្រាវជ្រាវ តាមដាន អំពី ដំណេក ។
វេជ្ជបណ្ឌិត អារិក ប្រាធ័រ ជំនួយការសាស្ត្រាចារ្យ ផ្នែក ជំងឺ ចិត្តសាស្ត្រ នៃ សាកលវិទ្យាល័យ កាលីហ្វ័រនីញ៉ា នៃ រដ្ឋ សាន ហ្វ្រានស៊ីស្កូ និង ជា អ្នកដឹកនាំ ការសិក្សា ថា ៖
សំខាន់ ដំណេក ស្កប់ស្កល់ នៅតែ មាន ប្រសិទ្ធភាព ចំពោះ សុខភាព ។
ការសិក្សា ជាច្រើន បាន ភ្ជាប់ កង្វះ ដំណេក ទៅនឹង ជំងឺ រ៉ាំរ៉ៃ ការស្លាប់ មុន អាយុ ងាយ ឆ្លង រោគ គ្រោះថ្នាក់ រថយន្ត ជំងឺ ពាក់ព័ន្ធ នឹង ការងារ និង ឱសថ គ្មាន ប្រសិទ្ធភាព ៕
ក្រុម អ្នកស្រាវជ្រាវ បាន សិក្សា លើ ឪពុក ម្តាយ និយាយ ភាសា អង់គ្លេស និង អេស្ប៉ាញ ១១៧៣ នាក់ ដែល មាន កូន រៀន ថ្នាក់ មត្តេយ្យ រហូត ដើម្បី តាមដាន អំពី ផល ប៉ះពាល់ នៃ កិច្ចការ សាលា ធ្វើ នៅ ផ្ទះ ។
ទី ងងឹត ស័ក្តិសម បំផុត សម្រាប់ ស្ត្រី រួម មេត្រី ប្រាថ្នា ចង់បាន កូន
ក្រុម អ្នកស្រាវជ្រាវ បាន ណែនាំ ថា ស្ត្រី ដែល ចង់បាន កូន គួរតែ គិតគូរ ដល់ វិធីសាស្ត្រ សាមញ្ញ ៗ នា ពេល រាត្រី រួម មាន ការបន្ថយ ពន្លឺ ភ្លើង ឱ្យ ងងឹត បន្តិច នៅ ពេល យប់ និង ការទទួលទាន អាហារ ឱ្យ ទៀងទាត់ ពេល វេលា ។
គូស្នេហ៍ ១គូ ក្នុង ចំណោម ៧គូ ត្រូវបាន គេ រកឃើញ ថា ប្រឈម នឹង បញ្ហា ពិបាក មាន កូន ។
ទន្ទឹម នឹង នោះ អ្នកវិទ្យាសាស្ត្រ ក៏ បារម្ភ ពី ឥទ្ធិពល នៃ បរិស្ថាន ពន្លឺ ជុំវិញ ខ្លួន ដែល អាច ធ្វើឱ្យ ប៉ះពាល់ ដល់ កត្តា ជីវៈ របស់ មនុស្ស ។
ពន្លឺ ដែល ធ្វើឱ្យ កត្តា ជីវៈ របស់ មនុស្ស មិន ប្រក្រតី អាច ធ្វើឱ្យ មាន បញ្ហា ដល់ ប្រព័ន្ធ បន្ត ពូជ ។
បណ្ឌិត ជេណេល្បក់ នៃ សាកលវិទ្យាល័យ កាលីហ្វ័រនីញ៉ា បាន ថ្លែង ថា បរិស្ថាន ពិតជា ប៉ះពាល់ ដល់ កត្តា បន្ត ពូជ របស់ ស្ត្រី នាយុគសម័យ ទំនើប មែន ៕
ការស្រាវជ្រាវ មួយ ទៀត ហើយ ដែល ថា ញ៉ាំ ម្ទេស សម្រក ទម្ងន់
អ្នកជំនាញ បាន ពន្យល់ ថា ក្រពះ មនុស្ស រីក មាឌ ពេល ដែល យើង ឆ្អែត ហើយ វា នឹង ភ្ញោច ប្រព័ន្អ ប្រសាទ ឱ្យ ផ្តល់ សញ្ញា ប្រាប់ អ្នក ញ៉ាំ ថា វា ទទួលបាន អាហារ គ្រប់គ្រាន់ ហើយ ។
ផ្ទុយទៅវិញ អាហារ មាន ជាតិ ខ្លាញ់ បាន ធ្វើឱ្យ ប៉ះពាល់ ដល់ ប្រព័ន្ធ ប្រសាទ ទទួល ព័ត៌មាន ដែល ធ្វើឱ្យ អ្នក ញ៉ាំ ប្រឹង ញាត់ អាហា រហូតដល់ ហល់ ក៏ មិន ដឹង ថា ឆ្អែត ។
វា ត្រូវបាន គេ រកឃើញ ថា អាច ពញ្ញាក់ សាច់ដុំ ក្រពះ ដើម្បី បញ្ចេញ សញ្ញា ថា ឆ្អែត ធ្វើឱ្យ អ្នក ញ៉ាំ លែង បន្ត ទទួលទាន ទៀត ។
ការញ៉ាំ មិន លើស ចំណុះ ក៏ អាច រក្សា ទម្ងន់ ផងដែរ ៕
ក្បាច់ រួម មេត្រី នីមួយ ៗ ជា យុទ្ធសាស្ត្រ ទប់ទល់ នឹង ស្ត្រស ប្រភេទ ខុស ៗ គ្នា
ការងារ ប្រចាំ ថ្ងៃ ធ្វើឱ្យ អ្នកស្ត្រ ស មែន ទេ ?
ចូរ រម្ងាប់ ភាពតានតឹង ជាមួយនឹង ថាមពល លើ គ្រែ ។
នៅពេល អ្នក មានអារម្មណ៍ ធុញ ថប់ តប់ប្រមល់ ពេល ខ្លះ ការសម្រេច កាម គឺជា វិធី ដ៏ ល្អ បំផុត មួយ ។
ប៉ុន្តែ មិន មែន មាន ន័យ ថា គ្រប់ សកម្មភាព សិច ទាំងអស់ សុទ្ធតែ មាន ប្រសិទ្ធភាព ទាំង ផ្លូវកាយ និង ផ្លូវចិត្ត នោះ ទេ ។
ក្បាច់ ប្លែក ៗ គួបផ្សំ កម្រិត ចង្វាក់ បេះដូង និង លំហាត់ប្រាណ ពិតជា អាច រម្ងាប់ ភាពតានតឹង និង ផ្តល់ នូវ ការ សម្រាក ស្រួល ខ្លួន ដោយ មិន សំដៅ លើ ការខិតខំ បំពេញ ការងារ និង អាជីព អារម្មណ៍ ស្ត្រស នឹង រូបរាងកាយ ឬ បញ្ហា ទំនាក់ទំនង នោះ ទេ ។
ស្ត្រេស ការងារ ប្រចាំ ថ្ងៃ នៅពេល មាន សម្ពាធ ការងារ ខ្លាំង អ្នក ត្រូវ ខិតខំ ធ្វើ ការងារ ច្រើន ម៉ោង ផង និង ឆ្លៀត ពេល មក ដោះស្រាយ បញ្ហា ផ្សេង ៗ ជាមួយ ក្រុមការងារ ថ្នាក់ដឹកនាំ ឬ អតិថិជន ផងដែល ធ្វើឱ្យ អ្នកអស់ ថាមពលរលីង ។
ចម្លើយ គឺ ចាប់ផ្តើម ពី ការប្រើ កម្លាំង សេសសល់ មក ប្រតិបត្តិការ លើ គ្រែ ។
អ្នកជំនាញ សិចសាស្ត្រ វ៉ាន់ ណេស្សា ម៉ារីន បាន ថ្លែង ថា នេះ ជា វេលា ដ៏ នឿយហត់ អ្នក គួរ ប្រើ ក្បាច់ ឆ្កែ ទើប ប្រសើរ ។
ពិត ណាស់ អ្នក ត្រូវ ប្រាកដ ថា ភាគី នារី ទទួលបាន ផាសុកភាព ហើយ បើ នាង ស្រណុក ស្រួល ហើយ បន្ថែម អានុភាព រហូតដល់ ទី ជម្រៅ ។
ស្ត្រ សនេិង រាងកាយ ខ្លួន ឯង ចូរ ចងចាំ ថា អ្នក ប្រហែលជា គិត ច្រើន ចំពោះ រូបរាង របស់ ខ្លួន ។
តាមពិត នារី ភាគ ច្រើន មិន សុទ្ធតែ ចូលចិត្ត បុរស សាច់ដុំ ៦កង់ នោះ ទេ ។
នាង ត្រូវការ ភាព ស្រណុក ស្រួល ជាមួយ អ្នក ជាង ។
បើ អ្នក បារម្ភ ខ្លាចក្រែង ចំពោះ ក្បាលពោះ សង្កត់ធ្ងន់ លើ នាង សូម ឱ្យ នាង ជា អ្នកចាត់ការ ពីលើ ពីព្រោះ នាង អាច គ្រប់គ្រង ស្ថានការណ៍ និង អាច មើល មុខ របស់ អ្នក ច្បាស់ ។
ក្បាច់ ឆ្កែ ក៏ ស័ក្តិសម ផងដែរ ។
ស្ត្រ សនេិង បន្ទុក ការងារ ច្រើន រដូវកាល រៀប មង្គលការសម្បូរ កិច្ចការ ជំនួញ ក៏ ទាមទារ ការកម្សាន្ត ចុង សប្តាហ៍ និង វិស្សមកាល ជាដើម ។
អ្នកស្រី ម៉ារីន បាន និយាយ ថា ៖
ដូច្នេះ អ្នក មិន នឹក គិត ច្រើន អំពី កិច្ចការ ដ៏ ស្ត្រ សនេោះ ទៀត ។
ស្ត្រ សនេិង ទំនាក់ទំនង ស្នេហា ស្នេហា អាច ផ្លាស់ប្តូរ មិន ទៀងទាត់ ប៉ុន្តែ អ្វី ដែល សំខាន់ គឺ ថា អ្នក ចំណាយ ពេល ផ្សារទំនាក់ទំនង គ្នា ឱ្យ ស្អិត ល្មួត ។
ក្រោយពី ខិតខំ ប្រឹង ដាក់ មនោសញ្ចេតនា ផ្អែមល្ហែម បបោស អង្អែល វា អាច ជួយ អ្នកបង្កើន អារម្មណ៍ ឱ្យ ចង់ នែបនិត្យ កាយាគ្នា ទៅ វិញ ទៅមក ។
ចំពោះ ស្ត្រស បេែប នេះ អ្នកស្រី ណែនាំ ឱ្យ ប្រើ ក្បាច់ កេរ ម៉ែ ចែក ឱ្យ ព្រោះ អ្នក អាច ក្រសោប គ្នា ឱ្យ ជាប់ ស្ទាប អង្អែល រាងកាយ គ្នា និង ប្រើ ក្រសែភ្នែក ប្រកបដោយ មនោសញ្ចេតនា ពុះកញ្ជ្រោល យ៉ាង ខ្លាំង ៕
ចង់ ញ៉ាំ តែ កុំ ឱ្យ ខ្មៅ ធ្មេញ សាកល្បង បន្ថែម ទឹកដោះគោ ចូល ពែង បន្តិច
វេជ្ជបណ្ឌិត អាវ៉ា ឆូវ មកពី សាកលវិទ្យាល័យ អាល់ប៊ឺតា ផ្នែក ទន្ត ពេទ្យ បាន និយាយ ថា ៖
វេជ្ជបណ្ឌិត រូប នេះ ពន្យល់ ថា ទឹកតែ ផ្ទុក សារធាតុ គីមី បង្កើត រសជាតិ ល្វីង ។
សារធាតុ នេះ មាន ពណ៌ ងងឹត និង អាច តោង ជាប់ ធ្មេញ ធ្វើឱ្យ ស្រអាប់ ។
អ្នកស្រី ឆូវ បាន រកឃើញ ថា សារធាតុ ប្រូតេអ៊ីន កាសេអ៊ីន ក្នុង ទឹកដោះគោ លាយ បញ្ចូល ជាមួយ សារធាតុ ល្វីង ជាមួយ តែ អាច ទប់ទល់ បញ្ហា ស្នឹម ។
ការស្រាវជ្រាវ ត្រូវបាន ចុះផ្សាយ ក្នុង ទស្សនាវដ្តី អនាម័យ ទន្តសាស្ត្រ អន្តរជាតិ ។
ព័ត៌មាន នេះ បាន ចេញផ្សាយ ក្រោយពេល ការសិក្សា ជាច្រើន បាន រកឃើញ ថា ទឹកតែ ជួយ កាត់បន្ថយ អត្រា មរណៈ ពី ធាតុ បង្ក ផ្សេង ៗ ដែល ទាក់ទង នឹង បេះដូង រហូតដល់ ១ភាគ ៤បើ ធៀប នឹង អ្នក អត់ ផឹក ទឹកតែ ។
អត្ថប្រយោជន៍ នៃ ការទទួលទាន ទឹកតែ មាន វិសាលភាព ធំទូលាយ ដោយសារតែ រសជាតិ ដ៏ ឈ្ងុយ ឆ្ងាញ់ របស់ វា និង គ្រឿងផ្សំ ប្រឆាំង នឹង ជំងឺ ដែល ត្រូវបាន គិត ថា ជា សារធាតុ ល្អ ចំពោះ បេះដូង ៕
មុន លើ ចំណែក នៃ បរិវេណ ផ្ទៃ មុខ ឆ្លុះបញ្ចាំង អំពី ជំងឺ ផ្សេង ៗ
អ្នកឯកទេស ខាង វេជ្ជសាស្ត្រ ជាច្រើន មាន ជំនឿ ថា ទីតាំង មុន លើ ស្បែក មុខ អាច សម្គាល់ បញ្ហា ផ្សេង ៗ ចំពោះ សុខភាព ខាងក្នុង របស់ អ្នក ។
អ្នកជំនាញ សុខភាព និង សុវត្ថិភាព ដែល មាន មូលដ្ឋាន នៅ ទីក្រុង ឡុងដ៍ ចន ត្សាហ្គារី ស ជឿ ថា មុន អាច ជា លទ្ធផល បង្ក ពី កត្តា ជាច្រើន ដូចជា ស្ត្រេស ខ្វះ ជីវជាតិ ខ្វះ ជាតិ ទឹក និង អាល្លែកហ្ស៊ី ។
ប៉ុន្តែ ដើម ចម ដំបូង វា បង្កឡើង ពី សកម្មភាព អ័រម៉ូន ។
លោក ចន ដែល ជា អ្នកឯកទេស ខាង វេជ្ជសាស្ត្រ ចិន បាន ពន្យល់ ថា ៖
លោក ចន ត្សាហ្គារី ស បាន ទទូច ថា ស្បែក ធម្មជាតិ មិន មែន ជា បញ្ហា ចោទ នោះ ទេ ប៉ុន្តែ វា មាន ដើម ចម ពី អតុល្យភាព នៃ រាងកាយ មកពី ខាងក្នុង ។
មុន លើ ថ្ងាស អ្នក កើត មុន ត្រង់ បរិវេណ ថ្ងាស សូម ប្រុងប្រយ័ត្ន ចំពោះ របប អាហារ ។
ការទទួលទាន ម្ហូប កែច្នៃ តិច និង កាត់បន្ថយ អាហារ ខ្លាញ់ អាច ជួយ កែ កុន បាន ខណៈ បញ្ហា ទាំងនេះ ជះ ឥទ្ធិពល អវិជ្ជមាន លើ ប្រព័ន្ធ រំលាយ អាហារ ។
អ្នក គួរតែ ទទួលទាន ទឹក ឱ្យ បាន ច្រើន និង ដេក ចន្លោះ ពី ៧ទៅ ៩ ម៉ោង រៀងរាល់ រាត្រី ដើម្បី ផ្តល់ ពេលវេលា គ្រប់គ្រាន់ ក្នុង ការជួយសម្រួល តុល្យភាព នៃ ការរំលាយ អាហារ ។
មុន លើ ថ្ពាល់ នៅពេល សម្គាល់ ឃើញ ថា មុន បាន កើត ត្រង់ បរិវេណ ថ្ពាល់ របស់ អ្នកស្ត្រេស គឺជា ដើម ចម បន្ទាប់មក គឺ បញ្ហា នៃ ការរស់នៅ មិន សម ទំនង ។
ការជក់ បារី ឬ បញ្ហា អាល្លែកហ្ស៊ី អាច ជា កត្តា ធំ បំផុត មួយ ។
ចូរ រក្សា រាងកាយ នូវ សារធាតុ អាល់ កាលីន ច្រើន តាមរយៈ ការទទួលទាន បន្លែ បៃតង ព្រមទាំង កាត់បន្ថយ អាហារ សាច់ និង អាហារ ផលិត ពី ទឹកដោះគោ ដែល ជួយ ប្រយុទ្ធ ប្រឆាំង នឹង បញ្ហា នេះ ។
មុន លើ មាត់ និង ចង្កា បរិវេណ ផ្សេង ៗ ទៀត ដែល មនុស្ស គ្រប់ រូប រមែង ជួបប្រទះ គឺ មុន និង អុច កន្ទួល នៅលើ បរិវេណ មាត់ និង ចង្កា ។
វា បាន កើតឡើង ច្រើន លើសលប់ ត្រង់ ចំណុច នេះ ដោយសារតែ បម្រែបម្រួល អ័រម៉ូន និង ស្ត្រេស ។
អ្នក ត្រូវ ឱ្យ រាងកាយ មាន មុខងារ ត្រឹមត្រូវ ដោយ មិន ចាំបាច់ ប្រើ ឱសថ ព្យាបាល និង តែងតែ ចងចាំ ថា ការទទួលទាន ដំណេក ការ សម្រាក ការបន្ថែម ជាតិ ទឹក និង ទទួលទាន អាហារ គ្រប់គ្រាន់ អាច ជួយ ថែទាំ ស្បែក នូវ ថាមពល និង សុខភាពល្អ ។
កង្វះ ជាតិ ទឹក អាច នាំឱ្យ អតុល្យភាព ក្រលៀន និង បង្ក ការរាតត្បាត នៃ ជំងឺ មុន លើ បរិវេណ ចង្កា ថែម ទៀត ផង ។
មុន លើ ច្រមុះ ច្រមុះ គឺជា បរិវេណ មួយ ផ្សេង ទៀត ដែល អាច បង្ក ជា ជំងឺ មុន នៅ ពេល ដែល រាងកាយ ខ្វះ ជីវជាតិ ចំណីអាហារ និង ជំងឺ ចាក់ ច្រាស បញ្ហា ក្រពះ មិន រំលាយ បាន ល្អ ។
វា គឺជា អ័រម៉ូន សារជាតិ ពុល កើន ហួស កម្រិត អាហារ ប្រើប្រាស់ ផលិតផល កែច្នៃ និង សារធាតុ អេឡិចត្រុង វ៉ាឡង់ស៍ គ្មាន គូ ដែល បង្កឱ្យ រលាក និង កើត មុន ។
យ៉ាងណាមិញ នៅ មាន របប អាហារ ជំនួយ ដែល អាច ប៉ះ ប៉ូវ ដល់ គុណភាព ស្បែក ជាទូទៅ ដូចជា ត្រសក់ ឪ ឡឹក ការ៉ុត ស្ពៃ ក្តោប ស្លឹក មន សាលា ដឡេត ទូស ដំបូង បារាំង ឈើ រី ល្ហុង ផ្លែ ប៉ែស ទន្លាប់ និង អង៌្ករ ពណ ត្នោត ។
ចូរ បញ្ចៀស ជាតិ ស្ករ ដ៏ ច្រើន លើសលប់ ផលិតផល ពី ទឹកដោះគោ សូកូឡា កាហ្វេអ៊ីន ភេសជ្ជៈ សម្បូរ សារ ជាតិ ហ្គាស គ្រាប់ ធញ្ញជាតិ សត្វ សណ្ឋាន ខ្យង ខ្ចៅ ឬ លៀស ព្រមទាំង ជាតិ ខ្លាញ់ ចៀន បំពង និង ម្ហូប កែច្នៃ ជាដើម ៕
ដំណេក ចំហៀង ជួយ ខួរក្បាល លាង សម្អាត សារធាតុ ពុល មាន ប្រសិទ្ធភាព
អ្នក ដែល គេង ចំហៀង ទំនងជា អាច សម្អាត សារធាតុ គីមី ស្ថិត នៅ រប៉ាត់រប៉ាយ បាន ច្រើន ពី ខួរក្បាល របស់ ពួកគេ ខណៈ សម្រាក ។
ក្រុម អ្នកស្រាវជ្រាវ បាន និយាយ ថា ពួកគេ បាន ស្នើ ឱ្យ អ្នកចូលរួម និង សត្វ ជាច្រើន ដេក ចំហៀង ។
នេះ អាច ជា វិធី សាកល្បង មាន អត្ថប្រយោជន៍ ក្នុង ការគេង និង ការពារ ខួរក្បាល ដែល មាន ការញាំញី ពី ជំងឺ រ៉ាំរ៉ៃ ផ្សេង ៗ ។
ចំពោះ ដំណេក ចំហៀង នេះ ត្រូវបាន សន្មត ថា ខណៈពេល យើង ដេក ខួរក្បាល របស់ យើង ពិបាក ធ្វើការកម្ចាត់ សារធាតុ ពុល ដែល បាន ផលិត ក្នុង អំឡុង ពេល នៃ ម៉ោង បំពេញ ការងារ ។
បើ មិន យកចិត្តទុកដាក់ នោះ ទេ សារធាតុ គីមី ទាំង នេះ អាច ជា គ្រោះ អាក្រក់ និង បង្ក ជា ជំងឺ សរសៃ ប្រសាទ និង ជំងឺ ប្រព័ន្ធ ប្រសាទ ផ្សេង ៗ ទៀត ។
ជាក់ស្តែង ក្រុម អ្នកស្រាវជ្រាវ បាន ធ្វើ ការសន្និដ្ឋាន ថា ដំណើរការលាង សម្អាត ត្រូវការ ពេលវេលា និង ប្រកបដោយ ភាពហ្មត់ចត់ ។
វា នឹង កម្រិត នូវ ការគិត ពិចារណា របស់ យើង បើ វា ត្រូវបាន ធ្វើ នៅពេល យើង ភ្ញាក់ ពី ដំណេក ។
ដូច្នេះ យើង ចាំបាច់ ត្រូវតែ ដេក ។
វេជ្ជបណ្ឌិត ម៉ៃ គេនណេឌ័រ ហ្គាដដែល ដឹកនាំ ការសិក្សា និយាយ ថា ៖
ភ័ស្តុតាង ជាច្រើន បង្ហាញ ថា អាហារ បំពង បង្ក ហានិភ័យ ជំងឺ បេះដូង ខ្ពស់
ក្រុម អ្នកស្រាវជ្រាវ រកឃើញ ថា អ្នក ដែល ចូលចិត្ត ទទួលទាន អាហារ របស់ អ្នកភូមិភាគ ខាងត្បូង រួម មាន ម្ហូប អាហារ បំពង ស៊ុត សាច់ កែច្នៃ ដូចជា សាច់ ជ្រូក បី ជាន់ សាច់ ភ្លៅ ជ្រូក និង ភេសជ្ជៈ មាន ជាតិ ស្ករ នោះ ពួកគេ ប្រឈម នឹង ការកើត ជំងឺ គាំង បេះដូង ឬ ជំងឺ ពាក់ព័ន្ធ នឹង បេះដូង ដែល អាច បាត់បង់ជីវិត ក្នុង ពេល ៦ឆ្នាំ ទៅ មុខ ទៀត ។
ចេមស៍ ស៊ីកានី ប្រធាន ក្រុម ស្រាវជ្រាវ ឯកទេស រោគ រាតត្បាត នៃ សាកលវិទ្យាល័យ អាឡាបាម៉ា ផ្នែក ថ្នាំ បង្ការ នៅឯ ទីក្រុង ប៊ឺរ មីង ហេម ឱ្យដឹង ថា ៖
ចេមស៍ ស៊ីកានី បាន បន្ថែម ថា ៖
ក្រុម អ្នកវិទ្យាសាស្ត្រ រកឃើញ ថា ម្ហូប ហឹរ ជួយ បន្ទាប អត្រា មរណៈ ពី ជំងឺ មហារីក ជំងឺ បេះដូង និង បញ្ហា ផ្លូវ ដង្ហើម ។
ការសិក្សា លើ មនុស្ស វ័យ កណ្តាល ៥០ម៉ឺន នាក់ រកឃើញ ថា អ្នក ដែល ទទួលទាន ម្ហូប ហឹរ រៀងរាល់ មួយ ថ្ងៃ ឬ ពីរ ថ្ងៃ ម្តង មាន អត្រា ស្លាប់ ទាប ជាង អ្នក មិន ទទួលទាន ហឹរ ទៀងទាត់ ។
ក្រុម អ្នកវិទ្យាសាស្ត្រ មាន មន្ទិល ថា សារធាតុ គីមី ខាបសៃ ស៊ីន ក្នុង គ្រាប់ ម្ទេស ប្រឆាំង ការឡើង ទម្ងន់ ប្រឆាំង អុកស៊ីតកម្ម ប្រឆាំង ការរលាក និង ទប់ទល់ នឹង ជំងឺ មហារីក ផងដែរ ។
ការស្រាវជ្រាវ ដែល ចុះផ្សាយ ក្នុង ទស្សនាវដ្តី វេជ្ជសាស្ត្រ អង់គ្លេស បាន យក ការសិក្សា លើ ជនជាតិ ចិន ៤៨៧ ពាន់ នាក់ អាយុ ចន្លោះ ពី ៣០ ទៅ ៧៩ ឆ្នាំ ជា មូលដ្ឋាន ។
សិច៧ បែប ខុស ៗ គ្នា ដែល គូស្នេហ៍ គួរ សាកល្បង កុំ ខាន
ហេតុ អ្វី ត្រូវកំហិត នូវ វិសាលភាព របស់ ខ្លួន នៅពេល មាន វិធី បង្កើត ភាពត្រេកត្រអាល យ៉ាង ច្រើន សន្ធឹក ?
ការបង្កើត ទម្លាប់ សិច ថ្មី ៗ នាំឱ្យ អាថ៌កំបាំង និង ការផ្សងព្រេង ដល់ ជីវិត ស្នេហ៍ របស់ អ្នក ជា គុណភាព ពីរ បែប ដែល រក្សា ទំនាក់ទំនង សិច កាន់តែ ស្រស់ស្រាយ ។
ចូរ ចាប់ផ្តើម អនុវត្ត ស្ទីល សិច ទាំង ៧យ៉ាង ដូច ខាងក្រោម ៖
ជាមួយនឹង សិច ដ៏ ពុះកញ្ជ្រោល វា មិន ផ្តោត គោលដៅ ថា ត្រូវតែ ដល់ ចំណុច កំពូល ទេ ដែល រូប អ្នក សំខាន់ គឺ ដំណើរ ប្រតិបត្តិការ តាម ផ្លូវ ទៅ ឋានសួគ៌ ។
អត្ថប្រយោជន៍ ចំពោះ ផ្លូវ អារម្មណ៍ អាច កើតមាន រយៈពេល យូរ ផងដែរ ។
សិច ប្រភេទ នេះ បង្កើត ជំនឿចិត្ត និង សុវត្ថិភាព ។
ក្រៅពី បញ្ចេញ អារម្មណ៍ អស់ ពី ទ្រូង ប្រតិបត្តិការ ផ្លេកបន្ទោរ អាច ជា ការបំពេញ ចិត្ត ដៃគូ ពីព្រោះ វា បាន បង្ហាញ ពី ជម្រៅ ស្នេហ៍ របស់ អ្នក ចំពោះ គាត់ ។
នៅពេល គាត់ មានអារម្មណ៍ ធុញ ថប់ ការលេង ប្រឡែង ច្រងាប់ ច្រងិល យ៉ាង តក់ ក្រហល់ ពិតជា អាច ជួយ កាត់បន្ថយ ភាពតានតឹង បាន ។
អ្នកជំនាញ សិចសាស្ត្រ ក្រុង ឡូស អេនជឺ លេស លោក ដូណាល់ អេត កេស បាន លើកឡើង ថា អ្វី ដែល អ្នក ត្រូវការ សម្រាប់ សិច ឆក់ ក ណ្តៀត ប្រកបដោយ ជោគជ័យ គឺ ទឹក រំអិល ។
ប៉ុន្តែ ការប្រើ យុទ្ធសាស្ត្រ បែប នេះ អាច រឹតតែ រំជើបរំជួល ដោយ ក្រុម អ្នកជំនាញ និយាយ ថា ការគយគន់ នារី កំពុងតែ បង្ហាញ កាយវិការ ជួយ ខ្លួន ឯង ផ្ទាល់ នឹង ភ្នែក សឹងតែ ស្ថិត លើ កំពូល តារាង ដែល ធ្វើឱ្យ បុរស ស្រើប ស្រាល បំផុត ។
វា គឺជា ឱកាស ល្អ ក្នុង ការបង្ហាត់ បង្ហាញ ដៃគូ នូវ ចំណូលចិត្ត របស់ អ្នក ។
ការសម្ញែង ឱ្យ ដៃគូ បាន ឃើញ នូវ កាយវិការ ដែល អ្នក ពេញចិត្ត គឺជា យុទ្ធសាស្ត្រ សម្ងាត់ និង ស្រើប ស្រាល បំផុត មួយ ដែល អ្នក អាច ធ្វើ បាន ។
ការធ្វើឱ្យ មាន អារម្មណ៍ ស្រឡាញ់ និង ស្និទ្ធស្នាល ចំពោះ គ្នា គឺជា វិធីសាស្ត្រ ដ៏ មាន ថាមពល បំផុត ក្នុង ការនាំយក មនោសញ្ចេតនា ឱ្យ គ្នា ទៅ វិញ ទៅមក ។
កាន់តែ រម៊ិច រមួល និង ក្តុង ក្តាំង កាន់តែ ប្រសើរ ។
អ្នក ចង់ឱ្យ គាត់ ជា អ្នក ចាត់ចែង ស្ថានការណ៍ គ្រប់ យ៉ាង ពីព្រោះ គាត់ មាន ជំនាញ ចម្លង អ្នក ទៅដល់ ត្រើយ ។
ប៉ុន្តែ ការ ដណ្តើម នេះ ត្រូវ ធ្វើឡើង ត្រូវ តាម កាលៈទេសៈ ដោយ មិន បង្ខំ ឡើយ ។
គួរ ចាំ រហូតដល់ អ្នក ពិតជា មាន កាមត ម្រេក ពេញ ទំហឹង ចាំ ប្តូរ តួ ធ្វើ ស្តេច ស្រី គ្រប់គ្រង លើ សមរភូមិ ហើយ អ្នក ចាត់ទុក ដៃគូ ឱ្យ ដូច នឹង ឧបករណ៍ សិច អ៊ីចឹង ៕
វា មាន ន័យ ថា តែ បៃតង អាច ត្រូវបាន ប្រើ ដើម្បី ជំនួយ ដល់ ការព្យាបាល ការធាត់ ឡើង គីឡូ និង ជំងឺ ទឹកនោម ផ្អែម ។
ដូច្នេះ វា មាន អត្ថប្រយោជន៍ សម្រាប់ គ្រប់គ្រង ទម្ងន់ រាងកាយ និង ព្យាបាល ជំងឺ ទឹកនោម ផ្អែម ។
តែ បៃតង មាន ផ្ទុក សារធាតុ ផ្សេង ៗ ជាច្រើន ដែល អាច ទប់ទល់ នឹង ជាតិ ម្សៅ មិន ឱ្យ ស្រូប ចូល ជា សារធាតុ គីមី ឈ្មោះ ថា ប៉ូលី ផេណុល ។
ប៉ុន្តែ ភេសជ្ជៈ នេះ មាន ផ្ទុក ប៉ូលី ភេណុល ក្នុង បរិមាណ ផ្សេង ៗ ។
ការស្រាវជ្រាវ ដទៃ ទៀត បាន រកឃើញ ថា ការទទួលទាន តែ បៃតង ជាបរ ចាំ អាច កាត់បន្ថយ ជាតិ កូឡេស្តេរ៉ូល ។
មើល ត្រី ហែល ក្នុង អាង ជួយ បន្ទាប សម្ពាធ ឈាម និង ចង្វាក់ បេះដូង
ការស្រាវជ្រាវ មួយ បង្ហាញ ថា សួន ត្រី មិន ត្រឹមតែ ជា កន្លែង ជំរុញ ទឹកចិត្ត ឱ្យ ស្ងប់ សុខ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ថែមទាំង ជួយ បន្ទាប សម្ពាធ ឈាម និង ចង្វាក់ បេះដូង ផងដែរ ។
ក្រុម អ្នកវិទ្យាសាស្ត្រ បាន រកឃើញ ថា ត្រី ក្នុង អាង កាន់តែ ច្រើន ប្រសិទ្ធភាព កាន់តែ មាន ខ្លាំង ។
ក្រុម អ្នកជំនាញ មកពី សួន ត្រី សមុទ្រ ជាតិ សាកលវិទ្យាល័យ ភ្លី ម៉ោត និង សាកលវិទ្យាល័យ អេច សេធ័រ បាន សន្និដ្ឋាន លើ ប្រព្រឹត្តិកម្ម ទាំង ផ្លូវកាយ និង ផ្លូវចិត្ត របស់ ក្រុម ស្ម័គ្រចិត្ត ចំពោះ អាង ត្រី ដែល ផ្ទុក ត្រី ជាច្រើន ប្រភេទ ។
ពួកគេ បាន និយាយ ថា អាង ត្រី តែងតែ ត្រូវបាន គេ ឃើញ ដាក់តាំង ក្នុង បន្ទប់ រង់ចាំ របស់ វេជ្ជបណ្ឌិត និង ទន្តពេទ្យ ដោយសារតែ ទីនោះ តម្រូវ ឱ្យ អ្នកជំងឺ មាន អារម្មណ៍ ស្ងប់ ។
វេជ្ជបណ្ឌិត សាប៊ីន ផាល ជា ជំនួយការសាស្ត្រាចារ្យ នៅ សាកលវិទ្យាល័យ ភ្លី ម៉ោត ផ្នែក ចិត្តវិទ្យា បាន ឱ្យដឹង ថា ៖
សម្រាប់ លើក ដំបូង ការសិក្សា នេះ បាន បង្ហាញ ភ័ស្តុតាង យ៉ាង រឹងមាំ ថា ការផ្ចង់ អារម្មណ៍ ជាមួយនឹង សត្វ ក្នុង ទឹក សមល្មម ពិតជា អាច មាន ឥទ្ធិពល វិជ្ជមាន លើ សុខុមាលភាព មនុស្ស ៕
ប្រជាជន ភូមា បេតី ស្លាម្លូ ទោះ ដឹង ថា វា ប៉ះពាល់ សុខភាព
ដូច្នេះ គូន ចា ជួយ បំបាត់ ភាពងងុយ ។
ចំពោះ សុខភាព គុន ចា អាច ធ្វើឱ្យ ញៀន ស្នឹម ជាប់ ធ្មេញ និង ប្រឈម ហានិភ័យ ខ្ពស់ នៃ ជំងឺ មហារីក មាត់ ។
កញ្ចប់ ស្លា នេះ ផ្សំ ពី ថ្នាំជក់ បន្តិច ស្លឹក ម្លូ ចំណិត ស្លាទុំ និង កំបោរ ជា អាហារ ទំពាកំដរ មាត់ របស់ ប្រជាជន មីយ៉ាន់ម៉ា តាំងពី យូរយារ មក ម្ល៉េះ ។
ពួកគេ ជឿ ថា ការទទួលទាន ស្លាម្លូ អាច ធ្វើឱ្យ ពួកគេ បង្កើន ឬ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ មាន កម្លាំង និង ខ្យល់ ដង្ហើម ល្អ ។
កន្លែង លក់ ស្លាម្លូ និង អ្នក ដើរ ទូល លក់ ជាច្រើន នៅ តាម ទីប្រជុំជន នានា ដែល ក្នុង មួយ កញ្ចប់ តម្លៃ ២០ សេន ដុល្លារ ។
ជនជាតិ មីយ៉ាន់ម៉ា ភាគ ច្រើន មាន ទម្លាប់ ទទួលទាន ស្លាម្លូ ទៅ ហើយ ។
ចំណែក របរ លក់ ស្លាម្លូ ក៏ អាច ជួយ រក ប្រាក់ ចំណូល នៃ ជីវភាព មួយ ផ្នែក ដែរ ។
រៀងរាល់ ម៉ោង ៣ទៀប ភ្លឺ មី យូមី យីន ទុន តែង ប្រញាប់ យក ស្លាម្លូ ទៅ លក់ នៅ តាម ស្ថានីយ រថភ្លើង ។
តែ ក្រុម វេជ្ជបណ្ឌិត ក៏ ធ្លាប់ បាន ចេញ សេចក្តី ព្រមាន កម្រិត ថ្នាក់ ជាតិ ដែរ ថា ការទទួលទាន ស្លាម្លូ នឹង បង្ក គ្រោះថ្នាក់ ដល់ សុខភាព ។
លោក បន្ត ថា អ្នកទទួលទាន ស្លាម្លូ មិន ប្រើ ថ្នាំជក់ មាន អត្រា ២៥០ ភាគរយ ដែល ប្រឈម ហានិភ័យ ខ្ពស់ ជាង អ្នកអត់ ទទួលទាន ស្លាម្លូ នេះ ។
