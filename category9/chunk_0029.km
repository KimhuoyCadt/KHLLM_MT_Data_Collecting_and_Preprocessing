( កំពង់ស្ពឺ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ព្រឹក ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស លទ្ធផល នៃ ការប្រលង មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ឬ ហៅ ថា បាក់ឌុប សម័យ ប្រឡង៖ ២០ សីហា ២០១៨ ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល កំពង់ស្ពឺ ។
សូម ចុច ទីនេះ ដើម្បី មើល បញ្ជី ឈ្មោះ លទ្ធផល នៃ ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៨ មណ្ឌល កំពង់ស្ពឺ
លទ្ធផល នៃ ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៨ ត្រូវ ប្រកាស ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល កំពង់ធំ
( កំពង់ធំ )៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ព្រឹក ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស លទ្ធផល នៃ ការប្រលង មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ឬ ហៅ ថា បាក់ឌុប សម័យ ប្រឡង៖ ២០ សីហា ២០១៨ ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល កំពង់ធំ ។
សូម ចុច ទីនេះ ដើម្បី មើល បញ្ជី ឈ្មោះ លទ្ធផល នៃ ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៨ មណ្ឌល កំពង់ធំ
លទ្ធផល នៃ ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៨ ត្រូវ ប្រកាស ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល កំពត
( កំពត ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ព្រឹក ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស លទ្ធផល នៃ ការប្រលង មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ឬ ហៅ ថា បាក់ឌុប សម័យ ប្រឡង៖ ២០ សីហា ២០១៨ ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល កំពត ។
សូម ចុច ទីនេះ ដើម្បី មើល បញ្ជី ឈ្មោះ លទ្ធផល នៃ ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៨ មណ្ឌល កំពត
លទ្ធផល នៃ ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៨ ត្រូវ ប្រកាស ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល ព្រៃវែង
( ព្រៃវែង ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ព្រឹក ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស លទ្ធផល នៃ ការប្រលង មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ឬ ហៅ ថា បាក់ឌុប សម័យ ប្រឡង៖ ២០ សីហា ២០១៨ ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល ព្រៃវែង ។
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ សាលាដំបូង រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ចេញ លិខិត ប្រកាស ជូន សាធារណជន ថា ទោះបីជា លោក កឹម សុខា ត្រូវបាន ចៅក្រម ស៊ើបសួរ ដោះលែង ឱ្យ នៅ ក្រៅ ឃុំ ជា បណ្តោះអាសន្ន ដោយសារ សុខភាព របស់ គាត់ ក៏ ពិត មែន ប៉ុន្តែ លោក កឹម សុខា មិន អាច រត់គេចខ្លួន ពី នីតិវិធី តុលាការ បាន ឡើយ ហើយ ចំណាត់ការ របស់ ចៅក្រម ស៊ើបសួរ កំពុង អនុវត្ត នីតិវិធី របស់ ខ្លួន បន្ត ។
អ្នកនាំពាក្យ រូប នេះ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ បាន សម្រេច បង្គាប់ឱ្យ ដោះលែង លោក កឹម សុខា ឱ្យ នៅ ក្រៅ ឃុំ ហើយ បាន សម្រេច ជំនួស មកវិញ នូវ វិធានការ នៃ ការដាក់ ឱ្យ ស្ថិត នៅក្រោម ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ ដោយ ភ្ជាប់ នូវ កាតព្វកិច្ច តាម ផ្លូវ ច្បាប់ មួយចំនួន ។ ការសម្រេច នេះ ដោយ ផ្អែក ទៅ លើ ហេតុផល សុខភាព និង មាន ការធានា ខាង ផ្នែក នីតិវិធី ច្បាស់លាស់ ថា ជន ត្រូវ ចោទ កឹម សុខា នឹង មិន អាច រត់គេចខ្លួន ពី នីតិវិធី តុលាការ ឡើយ » ។
អ្នកនាំពាក្យ សាលាដំបូង រាជធានី ភ្នំពេញ បាន បញ្ជាក់ បន្ថែម ទៀត ថា « ជន ត្រូវ ចោទ ឈ្មោះ កឹម សុខា ត្រូវបាន ចោទប្រកាន់ ពី បទ សន្ទិដ្ឋិភាព ជាមួយ បរទេស តាម បញ្ញត្តិ មាត្រា ៤៤៣ នៃ ក្រម ព្រហ្មទណឌ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។ សំណុំរឿង នេះ កំពុង ស្ថិត នៅក្នុង ចំណាត់ការ របស់ ចៅក្រម ស៊ើបសួរ ដែល កំពុង អនុវត្ត នីតិវិធី របស់ ខ្លួន បន្ត ដោយ យកចិត្តទុកដាក់ បំផុត ស្រប តាម ច្បាប់ ជាធរមាន »៕ លទ្ធផល នៃ ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៨ ត្រូវ ប្រកាស ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល កោះ កុង
( កោះកុង ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ព្រឹក ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស លទ្ធផល នៃ ការប្រលង មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ឬ ហៅ ថា បាក់ឌុប សម័យ ប្រឡង៖ ២០ សីហា ២០១៨ ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល កោះកុង ។
ខាងក្រោម នេះ ជា តារាង លទ្ធផល សិស្ស ប្រលង ជាប់ បាក់ឌុប ប្រចាំ មណ្ឌល ខេត្ត កោះកុង៖
ម្ចាស់ ភោជនីយដ្ឋាន វីហ្វ្រេន ផ្តល់ កាដូ ជាង ៣ពាន់ ដុល្លារ ដល់ អតិថិជន អបអរសាទរ ខួប គម្រប់ ១២ ឆ្នាំ
( ភ្នំពេញ ) ៖ បើ គិត រហូតមកដល់ ពេលនេះ ភោជនីយដ្ឋាន វីហ្វ្រេន បាន បើក ដំណើរការ រយៈពេល ១២ឆ្នាំ ហើយ និង មាន ការពង្រីក សាខា បន្តបន្ទាប់ ផងដែរ ។ ជា ការចូលរួម អបអរ និង ផ្តល់ កាដូ ពិសេស ខ្លះ ៗ ដល់ អតិថិជន ម្ចាស់ ភោជនីយដ្ឋាន បាន ឲ្យដឹង ថា ភោជនីយដ្ឋាន បាន រៀបចំ កាដូ ពិសេស គិត ជា ទឹកប្រាក់ ជាង ៣ពាន់ ដុល្លារ ដល់ អតិថិជន ។
បើ តាម លោក ចេង វណ្ណា បាន ប្រាប់ អ្នកសារព័ត៌មាន ឲ្យដឹង ថា នេះ ជា ឆ្នាំ ទី១២ ហើយ ដែល បើក ដំណើរការ ភោជនីយដ្ឋា ន មួយ នេះ ដោយសារតែ មាន ការគាំទ្រ ពី បងប្អូន ប្រជាពលរដ្ឋ ទើប ធ្វើឲ្យ ភោជនីយដ្ឋាន ពង្រីក សាខា បន្តបន្ទាប់ មកដល់ ពេលនេះ ។ ហើយ បើ និយាយ ពី កម្មវិធី ខួប គម្រប់ ១២ ឆ្នាំ នេះ គឺ មាន វត្តមាន តារា ប្រុស ស្រី ជាង ១០០ នាក់ បាន ចូលរួម និង មាន វត្តមាន ភ្ញៀវ ជាច្រើន ទៀត ។
លោក ចេង វណ្ណា បាន ប្រាប់ ឲ្យដឹង ទៀត ថា ដើម្បី ជា ការអបអរសាទរ ខួប គម្រប់ ១២ ឆ្នាំ និង ជា ឱកាស ផ្តល់ កាដូតបស្នង ដល់ អតិថិជន នោះ លោក បាន រៀបចំ ការចាប់ រង្វាន់ ដល់ អតិថិជន នូវ កាដូ ជាច្រើន សរុប ជា ទឹកប្រាក់ ជាង ៣ពាន់ ដុល្លារ ។ ហើយ នៅ ពេល ដែល លោក ទំនេរ ពី ការរៀបចំ កម្មវិធី នេះ ហើយ លោក និង អ្នក សិល្បៈ មាន គម្រោង បន្ត ធ្វើ សកម្មភាព សប្បុរសធម៌ ថែម ទៀត ព្រោះថា អ្វី ដែល លោក ធ្វើ នេះ គឺជា អ្វី ដែល លោក តែងតែ ធ្វើ រាល់ ឆ្នាំ តែម្តង ៕
បើកបរ មិន ត្រូវ ល្មើស ល្បឿន កំណត់ ជាដាច់ខាត ! ស្លាប់ ៥នាក់ និង រងរបួស ១២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៩ ខែកញ្ញា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ . របួស ស្រាល ៣នាក់ និង របួស ធ្ងន់ ៩នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៨ លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៩គ្រឿង និង រថយន្ដ ធុន ធំ ២គ្រឿង និង រថយន្ដ ធុន តូច៤ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . មិន ប្រកាន់ ស្ដាំ . មិន គោរព សិទ្ធិ និង កត្តា យានយន្ត ។
សូម បញ្ជាក់ ថា រយៈពេល ០៩ ថ្ងៃ មាន ការណី គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ចំនួន ៦៥ លើក បណ្ដាលឲ្យ មនុស្ស សា្លប់ ចំនួន ៣០ នាក់ . របួស ធ្ងន់ ៧៦ នាក់ និង របួស ស្រាល ចំនួន ៣១ នាក់ ៕
នៅ ព្រឹក ថ្ងៃ នេះ សម្ដេច តេជោ ហ៊ុន សែន ដឹកនាំ គណៈប្រតិភូ ចេញ ក្រៅ ប្រទេស លើក ដំបូង ក្រោយ បង្កើត រាជ រដ្ឋាភិបាល ដើម្បី ចូលរួម ពិព័រណ៍ ចិន - អាស៊ាន លើក ទី ១៥ នៅ ទីក្រុង ណាន នីង ប្រទេស ចិន
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ម៉ោង ៨ព្រឹក ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ ចាកចេញ ក្រៅ ប្រទេស ជា លើក ដំបូង ក្រោយ រាជ រដ្ឋាភិបាល ថ្មី បង្កើត បាន តែ ៤ ថ្ងៃ ប៉ុណ្ណោះ ដើម្បី ទៅ ចូលរួម ពិធី តាំង ពិព័រណ៍ ចិន - អាស៊ាន លើក ទី ១៥ នៅ ទីក្រុង ណានីង តំបន់ ស្វយ័ត ក្វាង ស៊ី ប្រទេស ចិន ។
បើ តាម ក្រសួង ការបរទេស កម្ពុជា បាន ឲ្យដឹង ថា ពិព័រណ៍ ចិន - អាស៊ាន លើក ទី ១៥ នឹង ត្រូវ ប្រារព្ធ ឡើង ក្រោម មូល បទ « រួមគ្នា កសាង វិថី សូត្រ សមុទ្រ សតវត្ស ទី ២១ និង ន វានុវត្ត សហគមន៍ ចិន - អាស៊ាន » ដើម្បី ជំរុញ កិច្ចសហប្រតិបត្តិការ របស់ វិស័យ ឯកជន នៅក្នុង ផ្នែក ពាណិជ្ជកម្ម ធុរកិច្ច វិនិយោគ និង ទេសចរណ៍ ឱ្យ កាន់តែ ប្រសើរឡើង ។
ក្នុង នាម ជា ប្រធាន កិត្តិយស នៃ ការបើក ពិព័រណ៍ នេះ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី នឹង ថ្លែង សុន្ទរកថា គន្លឹះ នៅ ពិធី បើក ពិព័រណ៍ ចិន - អាស៊ាន លើក ទី ១៥ ក្នុង គោលបំណង លើកស្ទួយ ពាណិជ្ជកម្ម និង វិនិយោគ រវាង អាស៊ាន និង ចិន រួមទាំង ទាក់ទាញ វិនិយោគិន និង ភ្ញៀវ ទេសចរ ចិន ដែល មាន សក្តានុពល មកកាន់ តំបន់ អាស៊ាន ។
សម្តេច តេជោ ហ៊ុន សែន និង លោក ហាន់ ចឹង ឧប នាយក រដ្ឋមន្រ្តី ចិន នឹង អញ្ជើញ ជា អធិបតី ក្នុង ពិធី កាត់ ខ្សែបូ ដើម្បី សម្ពោធ ព្រះពន្លា ជាតិ កម្ពុជា រួមទាំងអញ្ជើញ ទស្សនា សាល ពិព័រណ៍ ពាណិជ្ជកម្ម កម្ពុជា ផងដែរ ។
បើ តាម ក្រសួង ការបរទេស កម្ពុជា ក្នុង អំឡុង ពេល ស្នាក់ នៅ ប្រទេស ចិន សម្តេច តេជោ នាយក រដ្ឋមន្រ្ដី នឹង ជួបពិភាក្សា ដាច់ដោយឡែក ពី គ្នា ជាមួយ ឥស្សរជន ចិន និង ទទួល ការជួប សម្តែង ការគួរសម ពី ថ្នាក់ដឹកនាំ ខេត្ត ក្វាង ស៊ី និង ថ្នាក់ដឹកនាំ ផ្នែក ធុរកិច្ច សំខាន់ ៗ និង នាយក ប្រតិបត្តិ នៃ ក្រុមហ៊ុន នានា របស់ ចិន ព្រមទាំង ផ្តល់ បទសម្ភាស ដល់ សារព័ត៌មាន ចិន ផងដែរ ។
ជា ការកត់សម្គាល់ ពិព័រណ៍ ចិន - អាស៊ាន ត្រូវបាន ប្រារព្ធ ឡើង ជារៀងរាល់ ឆ្នាំ ក្នុង គោលបំណង ដើម្បី ពង្រឹង និង ពង្រីក បន្ថែម ទៀត នូវ កាលានុវត្តភាព ធុរកិច្ច និង ពាណិជ្ជកម្ម ឱ្យ កាន់តែ ស៊ីជម្រៅ ដើម្បី សម្រេច ឱ្យ បាន នូវ គោលដៅ វិនិយោគទុន នូវ ទំហំ ទឹកប្រាក់ ១ទ្រី លាន ដុល្លារ អាមេរិក ពី ប្រទេស ចិន មកកាន់ តំបន់ អាស៊ាន និង ១៥០ ពាន់ លាន ដុល្លារ អាមេរិក ពី តំបន់ អាស៊ាន ទៅកាន់ ប្រទេស ចិន នៅ ត្រឹម ឆ្នាំ ២០២០ ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ធ្លាប់ បាន គូសបញ្ជាក់ ដែរ ថា ពិពរណ៍ ចិន - អាស៊ាន នេះ មិន ត្រឹមតែ ផ្តល់ ឱកាស ដល់ ប្រមុខរដ្ឋ ប្រមុខ រដ្ឋាភិបាល ថ្នាក់ដឹកនាំ សហគ្រិន របស់ ចិន និង ប្រទេស ជា សមាជិក ទាំងអស់ របស់ អាស៊ាន ការពិភាក្សា ផ្លាស់ប្តូរ គំនិត គ្នា ដើម្បី ពង្រឹង និង ពង្រីក វិស័យ ពាណិជ្ជកម្ម និង វិនិយោគ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ក៏ ជា វេទិការ មួយ ចូលរួមចំណែក ក្នុង ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ពហុ ភាគី និង បង្កើន កាលានុវត្ត ភាព ពាណិជ្ជកម្ម រវាង ប្រទេស ចូលរួម ពិពរណ៍ លើ គ្រប់ វិស័យ ផងដែរ ។
សូម បញ្ជាក់ ដែរ ថា បន្ទាប់ពី បញ្ចប់ ដំណើរ ចូលរួម ពិព័រណ៍ នៅក្នុង ប្រទេស ចិន ហើយ នោះ សម្តេច តេជោ ហ៊ុន សែន នឹង ដឹកនាំ គណៈប្រតិភូហោះ ឆ្ពោះ ទៅកាន់ ទីក្រុង ហាណូយ ប្រទេស វៀតណាម តែ ម្តង ដើម្បី ចូលរួម វេទិកា សេដ្ឋកិច្ច ពិភពលោក មួយ ថ្ងៃ ទៀត មុននឹង ហោះ ត្រឡប់ មកកាន់ ប្រទេស កម្ពុជា វិញ ។
ដំណើរ ចេញ ទៅ ក្រៅ ប្រទេស របស់ សម្តេច តេជោ ហ៊ុន សែន នៅ ថ្ងៃ នេះ គឺជា ដំណើរ លើក ដំបូង សម្រាប់ សម្តេច និង គណៈប្រតិភូ ក្រោយពេល រាជ រដ្ឋាភិបាល ថ្មី ត្រូវបាន បង្កើតឡើង តែ មិន មែន ថ្មី សម្រាប់ សម្តេច នៅក្នុង ឆ្នាំ ២០១៨ នេះ ឡើយ ។ និយាយ ជា រួម មក នៅក្នុង ឆ្នាំ ២០១៨ នេះ សម្តេច តេជោ បាន ដឹកនាំ គណៈប្រតិភូ ចេញ ទៅ ចូលរួម កិច្ចប្រជុំ សំខាន់ ៗ នៅ ក្រៅ ប្រទេស ចំនួន ៥លើក រួច មកហើយ ៕
ដោយឡែក នៅ មន្ទីរពេទ្យ គន្ធ បុប្ផា ក៏ មាន រៀបចំ ពិធី គោរព វិញ្ញា ណ្ខ័ន គាត់ នៅ បណ្ណាល័យ ក្នុង បរិវេណ មន្ទីរពេទ្យ គន្ធ បុប្ផា ផងដែរ នៅ ថ្ងៃ ដដែល នេះ ។
( ភ្នំពេញ ) ៖ ក្រោយ ថ្ងៃ បោះឆ្នោត សកល ក្នុង ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ កម្ពុជា ទទួលបាន ជោគជ័យ ថ្មី មួយ ទៀត គឺ ប្រជាពលរដ្ឋ ខ្មែរ ទូទាំង នគរ បាន ផ្តល់ សេចក្តីទុកចិត្ត ផ្ញើ ជោគវាសនា របស់ ខ្លួន លើ គណបក្ស ប្រជាជន កម្ពុជា ដោយ បោះឆ្នោត ជូន ភ្លូក ទឹក ភ្លូក ដី ។ បើ ទោះបីជា មាន មតិ ជំទាស់ ខ្លះ ក៏ដោយ ក៏ វា ជា រឿង ធម្មតា ប្រៀប ដូចជា ព្រះពុទ្ធ បាន ត្រាស់ដឹង ខ្លាំង ពូកែ យ៉ាងណា ក៏ នៅ មាន មាតាម ផ្ចាញ់ នោះ ដែរ ។
ពិធី ជប់លៀង ដែល លោក រ័ត្ន ស្រ៊ាង រៀបចំឡើង នៅ ថ្ងៃ នេះ គឺជា ជ្រុង មួយ នៃ ការអបអរសាទរ បន្ទាប់ពី ឯកឧត្តម បាន បង្ក លក្ខណៈ រៀបចំ ពិធី ជប់លៀង ជាមួយ ប្រជាពលរដ្ឋ ផ្ទាល់ គ្រប់ ភូមិ កន្លង រួច មក ផងដែរ ។ ភាពស្និតស្នាល និង ភាពសប្បាយរីករាយ របស់ ប្រជាពលរដ្ឋ និង ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា បាន បង្ហាញ ឲ្យ ឃើញ ពី ការរួបរួម គ្នា ក្នុង នាម ជា ខ្មែរ តែ មួយ ក្នុង ការថែរក្សា សន្តិភាព និង ជួយ គ្នា អភិវឌ្ឍន៍ ជាតិ ឲ្យ សម្បូរសប្បាយ រុងរឿង តទៅ មុខ ទៀត ជា និរន្តរ៍ ៕
បើ តាម ប្រភព ពី ក្រុម គ្រូបង្រៀន បាន ឲ្យដឹង ថា ការធ្លាក់ចុះ នៃ កម្រិត សិស្ស ទទួលបាន និទ្ទេស A នេះ ដោយសារ កែ វិញ្ញាសា មាន ការរឹតត្បិត ជាង ឆ្នាំ កន្លងទៅ ។ ជាមួយ ការបង្ហាញ លទ្ធផល នេះ ក្រសួង អប់រំ យុវជន និង កីឡា ក៏ បាន បង្ហាញ សិស្ស ៤រូប ដែល ទទួលបាន ពិន្ទុ ខ្ពស់ ជាង គេ ផងដែរ ។ ក្នុង ចំណោម សិស្ស ខ្លាំង ទាំង៤រូប នេះ មាន សិស្ស ជា នារី ៣នាក់ ។
លោក សុខ ពុទ្ធិ វុធ ប្រាប់ សមាជិក បក្ស ថ្មី ថា រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា នឹង ខិតខំ បម្រើ ប្រជាពលរដ្ឋ ទ្វេ ដង ដើម្បី តបស្នង នូវ ការគាំទ្រ របស់ បងប្អូន
( តាកែវ )៖ លោក សុខ ពុទ្ធិ វុធ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា . អនុប្រធាន ទី១ ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក ទ្រាំង និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ចង្កោម ៨ឃុំ បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ជាពិសេស ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នឹង ខិតខំ បម្រើ ប្រជាពលរដ្ឋ ទ្វេ ដង ដើម្បី តបស្នង នូវ ការគាំទ្រ របស់ បងប្អូន ។
លោក បន្ត ថា តាមរយៈ ការបន្ត ធ្វើ កំណែរ ទម្រង់ ស៊ីជម្រៅ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៦ នឹង ខិតខំ ធ្វើ ការអភិវឌ្ឍ ប្រទេស ឱ្យ កាន់តែ រីកចម្រើន ជឿនលឿន បន្ថែម ទៀត ព្រមទាំង ជំរុញ បង្កើន នូវ ប្រសិទ្ធភាព សេវា សាធារណៈ ក៏ ដូចជា ទាក់ទាញ ចំណាប់អារម្មណ៍ របស់ វិនិយោគិន មក ធ្វើ ការ វិនិយោគ នៅ កម្ពុជា កាន់តែ ច្រើន ដែល នឹង បង្កើត ការងារ បន្ថែម ទៀត ជូន ប្រជាពលរដ្ឋ លើកកម្ពស់ ជីវភាព រស់ បង្កើន ប្រាក់ ចំណូល និង កាត់បន្ថយ ភាពក្រីក្រ ជូន បងប្អូន ។
ដោយឡែក ក្នុង នាម លោក ជា អនុប្រធាន ទី១ ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក ទ្រាំង លោក នឹង បន្ត ខិតខំ ចូលរួមចំណែក អភិវឌ្ឍន៍ ស្រុក ទ្រាំង ឱ្យ កាន់តែ រីកចម្រើន បន្ថែម ទៀត ដែរ ។
ថ្លែង បែប នេះ នៅក្នុង ឱកាស ដែល លោក សុខ ពុទ្ធិ វុធ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សំណេះសំណាល និង ប្រកាស បញ្ចូល សមាជិក ថ្មី គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ឃុំ រនាម ចំនួន ៧២៨ នាក់ នា ព្រឹក ថ្ងៃអាទិត្យ ១៤រោច ខែ ស្រា ពណ៍ ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស .២៥៦២ ត្រូវនឹង ថ្ងៃទី ៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នៅ ស្នាក់ការ គណបក្ស ឃុំ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក សុខ សប្បាយ ណា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ឃុំ រនាម និង លោក ឈួន ផាន់ នី ប្រធាន គណៈកម្មាធិការ គណបក្ស ស្រុក ផងដែរ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
សារ ចូលរួម អបអរសាទរ របស់ សាកលវិទ្យាធិការ AUPP ទៅកាន់ សិស្សានុសិស្ស ដែល បាន ប្រឡង ជាប់ មធ្យមសិក្សា ទុតិយភូមិ
ដូច្នេះ សិស្ស ដែល ប្រឡង ជាប់ បាក់ឌុប ទាំងអស់ អាច អញ្ជើញ មកកាន់ សាកលវិទ្យាល័យ AUPP ដេីម្បី ទទួលបាន ព័ត៌មាន បន្ថែម អំពី ការផ្តល់ អាហារូបករណ៍ និង ការចុះឈ្មោះ ចូលរៀន នៅ AUPP ។
ហាម នេសាទ នៅ រដូវ ត្រី ពង ! មន្រ្តី រដ្ឋបាល ជល កណ្តាល បន្ត បង្ក្រាប បទល្មើស នេសាទ និង ចុះ កាត់ របាំង ស្បៃ មុង ខុស ច្បាប់ យក ទៅ ដុត កម្ទេចចោល នៅ ស្រុក លើក ដែក
( កណ្តាល ) ៖ លោក វិត ធារិទ្ធិ នាយ ខណ្ឌ ជល ផល ខេត្ត កណ្តាល នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ កម្លាំង ចម្រុះ ចុះ កាត់ របាំង ស្បៃ មុង រាប់ គីឡូម៉ែត្រ ដែល ក្រុម អ្នកនេសាទ ខិល ខូច ល ប លួច ដាក់ នៅ តាម ខ្សែ បន្ទាត់ ព្រំដែន វៀតណាម - កម្ពុជា លាតសន្ធឹង លើ ផ្ទៃ ទឹក ពី ត្រើយ ម្ខាង ទៅដល់ ត្រើយ ម្ខាង នៅ រដូវ បិទ នេសាទ ជា ខែ ត្រី ពង កូន មេ ពូជ ទាំងនេះ ធ្លាក់ ចូល ទៅក្នុង ស្បៃ មុង របស់ អ្នកនេសាទ ខុស ច្បាប់ ទាំងនោះ ។
លោក វិត ធារិទ្ធិ បាន ថ្លែង ថា ដោយ មាន ការណែនាំ ពីសំណាក់ លោក បណ្ឌិត ម៉ៅ ភិរុណ អភិបាល ខេត្ត កណ្តាល . លោក បាន ដឹកនាំ កម្លាំង សហការ ជាមួយ អាជ្ញាធរ ស្រុក លើក ដែក និង កងកម្លាំងប្រដាប់អាវុធ និង មាន ការចូលរួម ពី សហគមន៍ សណ្តា ចុះ ទៅ បង្ក្រាប់ របាំង ស្បៃ មុង ខុស ច្បាប់ ដាក់ នៅក្នុង បឹង តូច និង បឹង ធំ ។
ជា លទ្ធផល កម្លាំង បាន វះកាត់ ស្បៃ មុង មាត់ លូ រាប់ រយ មាត់ លូ និង សារ របាំង ស្បៃ មុង រាប់ រយ ម៉ែត្រ រួមទាំង ដក បង្គោល រាប់ ពាន់ បង្គោល យក ទៅ ដុត កម្ទេចចោល និង បាន ចាក់ លែង កូន ត្រី រាប់ រយ គីឡូក្រាម ផងដែរ ហើយ សកម្មភាព នេះ ចង់ បញ្ជាក់ ប្រាប់ បងប្អូន អ្នកនេសាទ ខុស ច្បាប់ ត្រូវ ងាក មក រក នេសាទ ស្រប ច្បាប់ វិញ បើ មិន ដូច្នេះ ទេ ពេល កម្លាំង ចុះ មក សារ ដុត ចោល ដូច ពេលនេះ អីចឹង ព្រោះ ការនេសាទ ដោយ ប្រើ ស្បៃ មុង បង្កឱ្យ ប៉ះពាល់ ធនធាន ធម្មជាតិ ធ្ងន់ធ្ងរ បំផុត ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ព្រលឹម ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៨ ស្អែក នេះ នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ ចាកចេញ ក្រៅ ប្រទេស ជា លើក ដំបូង ក្រោយ រាជ រដ្ឋាភិបាល ថ្មី បង្កើត បាន តែ ៤ ថ្ងៃ ប៉ុណ្ណោះ ដើម្បី ទៅ ចូលរួម ពិធី តាំង ពិព័រណ៍ ចិន - អាស៊ាន លើក ទី ១៥ នៅ ទីក្រុង ណានីង តំបន់ ស្វយ័ត ក្វាង ស៊ី ប្រទេស ចិន ។
ដំណើរ ចេញ ទៅ ក្រៅ ប្រទេស របស់ សម្តេច តេជោ ហ៊ុន សែន នៅ ថ្ងៃស្អែក នេះ គឺជា ដំណើរ លើក ដំបូង សម្រាប់ សម្តេច និង គណៈប្រតិភូ ក្រោយពេល រាជ រដ្ឋាភិបាល ថ្មី ត្រូវបាន បង្កើតឡើង តែ មិន មែន ថ្មី សម្រាប់ សម្តេច នៅក្នុង ឆ្នាំ ២០១៨ នេះ ឡើយ ។ និយាយ ជា រួម មក នៅក្នុង ឆ្នាំ ២០១៨ នេះ សម្តេច តេជោ បាន ដឹកនាំ គណៈប្រតិភូ ចេញ ទៅ ចូលរួម កិច្ចប្រជុំ សំខាន់ ៗ នៅ ក្រៅ ប្រទេស ចំនួន ៥លើក រួច មកហើយ ៕
អបអរសាទរ ! លទ្ធផល បាក់ឌុប ឆ្នាំ នេះ បេក្ខជន ដែល ទទួលបាន ពិន្ទុ ១០០ ពេញ គឺ មកពី វិទ្យាល័យ ប៊ែល ធីសាខា ទី៧ ប៉េង គីម ហេង . សិស្ស ប៊ែល ធី រក្សា ខ្សែក្រវ៉ាត់ ៣ឆ្នាំ ជាប់ គ្នា ដែល បាន ពិន្ទុ ១០០ ពេញ
( ភ្នំពេញ ) ៖ សម្រាប់ លទ្ធផល នៃ ការប្រលង មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ឬ ហៅ ថា បាក់ឌុប សម័យ ប្រឡង៖ ២០ សីហា ២០១៨ មាន បេក្ខជន តែ ម្នាក់ ប៉ុណ្ណោះ ដែល ទទួលបាន ពិន្ទុ ១០០ ពេញ ( និទ្ទេស A) ក្នុង ចំណោម បេក្ខជន បេក្ខ នារី ដែល ទទួលបាន និទ្ទេស A សរុប ២៩០ នាក់ គឺ បេក្ខជន ប៉េង គីម ហេង មកពី វិទ្យាល័យ ប៊ែល ធីសាខា ទី៧ ក្នុង រាជធានី ភ្នំពេញ ។
ការ ដណ្តើម បាន និទ្ទេស A ដែល មាន លំដាប់ ពិន្ទុ ១០០ ពេញ របស់ បេក្ខជន ប៉េង គីម ហេង ខាងលើ នេះ បាន ធ្វើឲ្យ វិទ្យាល័យ ប៊ែល ធី នៅតែ អាច រក្សា ខ្សែក្រវ៉ាត់ រយៈពេល ៣ឆ្នាំ ជាប់ ៗ គ្នា គិត ចាប់តាំងពី ឆ្នាំ ២០១៦មក ។
នៅ ព្រឹក ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ លោក បណ្ឌិត លី ឆេង អគ្គ នាយក សាលា ប៊ែល ធី បាន ជួប សំណេះសំណាល ជាមួយ បេក្ខជន ប៉េង គីម ហេង ដោយ ចូលរួម កោតសរសើរ ចំពោះ លទ្ធផល ដ៏ ត្រចះត្រចង់ រួម ជាមួយ សិស្ស ប៊ែល ធី ផ្សេង ៗ ទៀត ដែល ទទួលបាន និទ្ទេស ល្អ ប្រសើរ នេះ ។
បើ តាម លោក បណ្ឌិត លី ឆេង សម្រាប់ ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៨ នេះ សិស្ស វិទ្យាល័យ ប៊ែល ធី របស់ លោក ទទួលបាន និទ្ទេស A ចំនួន ៣២ នាក់ ក្នុង ចំណោម សិស្ស ដែល ទទួលបាន និទ្ទេស A នៅ ទូទាំង ប្រទេស មាន ចំនួន ២៩០ នាក់ ។
យោង តាម ជីវប្រវត្តិ របស់ បេក្ខជន ប៉េង គីម ហេង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ពី ថ្នាក់ដឹកនាំ សាលា ប៊ែល ធី បាន បង្ហាញ ថា យុវជន ដែល មាន ចំណេះដឹង ដ៏ ខ្លាំង រូប នេះ កើត នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០០០ នៅ សង្កាត់ ផ្សារ ដេប៉ូ២ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ តែ បច្ចុប្បន្ន រស់ នៅ ផ្ទះ លេខ ២៤៣ ផ្លូវ លេខ ១៥០z សង្កាត់ ទឹកល្អក់២ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ថា សិស្ស ប៊ែល ធី បាន រក្សា ជើងឯក លេខ ១ ជាប់ ៗ គ្នា រយៈពេល ៣ឆ្នាំ ចុងក្រោយ នេះ ក្នុង ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ទូទាំង ប្រទេស ដែល ទទួលបាន និទ្ទេស A មាន លំដាប់ ពិន្ទុ ១០០ ពេញ ។ ការទទួលបាន លទ្ធផល បែប នេះ ជា មាន មោនភាព ខ្លាំង ណាស់ សម្រាប់ គ្រួសារ ប៉េង គីម ហេង ជាពិសេស នោះ ជា មុខមាត់ រីក ធំធាត់ កាន់តែ ខ្លាំង របស់ សាលា ប៊ែល ធី ទៅកាន់ មហាជន ទូទៅ និង អាណាព្យាបាល សិស្ស គ្រប់ រូប ដែល ចង់ បញ្ជូន កូន ៗ របស់ ខ្លួន ទៅ សិក្សា សាលា ដ៏ មាន គុណភាព មួយ នេះ ។
ដោយ៖ សាស្ត្រាចារ្យ វិទ្យាសាស្ត្រ សង្គម នៃ សាកលវិទ្យាល័យ កំពង់ចាម
គតិបណ្ឌិត ១០ថ្មី ទៀត ពី ទស្សនវិទូ និង មេដឹកនាំ លើ ពិភពលោក
២៖ បើ មិន បាន ធ្វើ អ្វី សោះ សូម កុំ ធ្វើឱ្យ ប្រជាជន ស្រក់ ទឹកភ្នែក ដោយសារ ទង្វើ ខុសឆ្គង របស់ មន្ត្រី យើង ( សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ) ។
៤៖ អ្នកដឹកនាំ ល្អ ត្រូវតែ ជា មនុស្ស ដែល ធ្លាប់ នៅក្រោម ការដឹកនាំ របស់ គេ សិន ( អារីស្តូ ទស្សនវិទូ បុរាណ ក្រិច ) ។
៧៖ គ្មាន អ្នកដឹកនាំ ណា ម្នាក់ ឬ សូម្បីតែ ព្រះ ក៏ មិន អាច ធ្វើ ត្រូវចិត្ត មនុស្ស គ្រប់ គ្នា នោះ ទេ ( ទស្សនវិជ្ជា ខ្មែរ ) ។
៩៖ អ្នកដឹកនាំ ល្អ មិន លើក ខ្លួន ឯង ឱ្យ ខ្ពស់ ហួស ពី តួនាទី របស់ ខ្លួន ឡើយ ( ហ្វ្រង់ គ្លីន រ៉ូស្វែល ប្រធានាធិបតី អាមេរិក ) ។
១០៖ ជោគជ័យ ដ៏ ធំ បំផុត គឺជា ការយកឈ្នះ ខ្លួន ឯង បរាជ័យ ធំ បំផុត គឺជា ការចាញ់ ខ្លួន ឯង ( ប្លាតុង ទស្សនវិទូ ក្រិច )៕
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ រសៀល ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស លទ្ធផល នៃ ការប្រលង មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ឬ ហៅ ថា បាក់ឌុប សម័យ ប្រឡង៖ ២០ សីហា ២០១៨ ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល រាជធានី ភ្នំពេញ ។
គួរឱ្យ អាសូរ ណាស់ ! ប្រទះឃើញ ទារក ម្នាក់ ត្រូវ ម្ដាយ យក ទៅ ផ្លុង ចោល ក្នុង ចម្ការ មួយ កន្លែង នៅ ខណ្ឌ ពោធិ៍សែនជ័យ ត្រូវ អ្នកជិតខាង យកចិត្តទុកដាក់
ហេតុការណ៍ ភ្ញាក់ផ្អើល នោះ បាន កើតឡើង កាល វេលា ម៉ោង ៣៖៥០ នាទី រសៀល ថ្ងៃទី ០៨ ខែកញ្ញា ឆ្នាំ ២០១៨ ម្សិលមិញ ស្ថិត នៅក្នុង ភូមិ ក្រាំង ដូនទៃ សង្កាត់ ចោម ចៅ២ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
យុវជន រូប នោះ បាន បន្ត ទៀត ថា ពេល នោះ បង្កឲ្យ មាន ការងឿងឆ្ងល់ យ៉ាង ខ្លាំង ព្រោះ អ្នកភូមិ មិន មាន នរណា ម្នាក់ សម្រាល កូន ឡើយ បន្ទាប់មក បុរស ចំណាស់ ម្នាក់ ដែល ជ អ្នកភូមិ ជាមួយគ្នា បាន ប្រើ ឲ្យ ខ្ញុំ ទៅ រកមើល ស្រាប់តែ ឃើញ ទារក នោះ កំពុង ដេក យំ ដោយ មាន ស្រមោច ជាច្រើន ក្បាល កំពុង ខាំ ។ មិន តែ ប៉ុណ្ណោះ នៅ មិន ទាន់ ចង និង កាត់ ផ្ចិត នៅឡើយ ហើយ បន្ទាប់ពី ឃើញ គួរឲ្យ អាណិត បែប នេះ រូប គាត់ ក៏ បាន លើក ទារក បី យកមក ផ្ទះ និង លាង សម្អាត រួច ទើប បញ្ជូន ទៅ មន្ទីរពេទ្យ បង្អែក ពោធិ៍ ចិន តុង ដើម្បី សង្គ្រោះ ។
ក្នុង បរិបទ នេះ ការស្វែងរក សាលា ដែល មាន គុណភាព ហើយ ដែល ធ្វើឱ្យ កូន របស់ ខ្លួន ទទួលបាន ចំណេះដឹង ពិតប្រាកដ គឺជា ក្តីបារម្ភ មួយ របស់ មាតាបិតា ។
ដើម្បី ជួយ សម្រួល ដល់ ការស្វែងរក សាលារៀន ដែល មាន គុណភាព មាតាបិតា អាច ពិនិត្យមើល សាលារៀន ខូលីង វូដ ភ្នំពេញ (CSPP) ក្នុង ជម្រើស របស់ ខ្លួន ព្រោះ សាលា នេះ ជា គ្រឹះស្ថាន សិក្សា ឯកជន ថ្មី មួយ ដែល បាន ចម្រាញ់ រក គ្រូបង្រៀន ល្បី ៗ និង ឆ្នើម ៗ គ្រប់ កម្រិត និង គណៈ គ្រប់ មាន មូលដ្ឋាន ចេញ ពី វិស័យ អប់រំ ដើម្បី ផ្តល់ ការអប់រំ ពិតប្រាកដ ដល់ សិស្ស ទាំងអស់ ។
ពេទ្យ ជោរៃ ភ្នំពេញ កំពុង គិតគូរ លើ បញ្ហា តម្លៃ ដែល ផ្តោត សំខាន់ ទៅ លើ អ្នកជំងឺ ដែល មាន ជីវភាព ក្រីក្រ និង មធ្យម
( ភ្នំពេញ ) ៖ លោក វេជ្ជបណ្ឌិត ត្រាន ថាន់ ទុង អគ្គ នាយក មន្ទីរពេទ្យ ជោរៃ ភ្នំពេញ បាន បញ្ជាក់ ថា ថ្នាក់ដឹកនាំ នៃ មន្ទីរពេទ្យ ជោរៃ ភ្នំពេញ រួម នឹង ក្រុម គ្រូពេទ្យ ជំនាញ ក្នុង និង ក្រៅ ប្រទេស កំពុង ពង្រឹង និង គិតគូរ បន្ថែម ទៀត ទៅ លើ បញ្ហា តម្លៃ សម្រាប់ អ្នកជំងឺ ដែល មាន ជីវភាព ក្រីក្រ និង មធ្យម ជាង នេះ ទៅ ទៀត គឺ ពង្រឹង សមត្ថភាព ព្យាបាល និង សេវាកម្ម ឲ្យ កាន់តែ ល្អ ជាង នេះ ។
លោក ថ្លែង បញ្ជាក់ បែប នេះ នៅក្នុង កម្មវិធី កិច្ចប្រជុំ វាយតម្លៃ ការងារ ៥ឆ្នាំ ស្ដីពី « ការគាំទ្រ បច្ចេកទេស សុខាភិបាល របស់ មន្ទីពេទ្យ ជោរៃ វៀតណាម ដល់ មន្ទីរពេទ្យ ជោរៃ ភ្នំពេញ » នា ថ្ងៃទី ០៨ ខែកញ្ញា ឆ្នាំ ២០១៨ ដោយ មាន ការចូលរួម ពី លោក ទ្រឹង មិង ទ្រឹង អនុប្រធាន មន្ទីរពេទ្យ ជោរ៉ៃ ហូជីមិញ និង ជា ប្រធាន សមាគម ជំងឺ ត្រចៀក ច្រមុះ និង បំពង់ ក នៃ សាកលវិទ្យាល័យ វេជ្ជសាស្ត្រ និង ឱសថសាស្ត្រ ក្រុង ហូជីមិញ លោក វេជ្ជបណ្ឌិត ត្រាន ថាន់ ទុង អគ្គ នាយក មន្ទីរពេទ្យ ជោរៃ ភ្នំពេញ រួម នឹង ថ្នាក់ដឹកនាំ ជាច្រើន នាក់ ទៀត ។
លោក វេជ្ជបណ្ឌិត ត្រាន ថាន់ ទុង លើកឡើង ថា « មន្ទីរ ជោរៃ ភ្នំពេញ នា ពេល សព្វ ថ្ងៃ កំពុង គិតគូ យ៉ាង ខ្លាំង និង ពង្រឹង បន្ថែម ទៀត ទៅ លើ សេវា និង ជាពិសេស តម្លៃ សមរម្យ ជាមួយនឹង ប្រជាជន ដែល មាន ជីវភាព ក្រីក្រ និង មធ្យម » ។
លោក វេជ្ជបណ្ឌិត ជំនាញ រូប នោះ បាន បន្ថែម ថា ក្រៅពី ការគិតគូ ទៅ លើ បញ្ហា តម្លៃ សម្រាប់ អ្នកជំងឺ ដែល មក ពិនិត្យ និង សម្រាក ព្យាបាល នៅ មន្ទីរ ជោរៃ ភ្នំពេញ ពួកគាត់ នឹង ពង្រឹង បន្ថែម ទៀត ទៅ លើ សមត្ថភាព របស់ ក្រុម គ្រូពេទ្យ រួម និង វេជ្ជបណ្ឌិត ទៅ លើ ការព្យាបាល របស់ អ្នកជំងឺ ហើយ ការពង្រឹង សមត្ថភាព នេះ គឺ ធ្វើ ការចែករំលែក បទពិសោធន៍ គ្នា ទៅ វិញ ទៅ មក ជាមួយនឹង មន្ទីរពេទ្យ ជោរៃ ហូជីមិញ ដោយ ផ្តោត សំខាន់ លើ វគ្គ បំប៉ន នានា ។
ជាមួយគ្នា នេះ ដែរ លោក វេជ្ជបណ្ឌិត ត្រាន ថាន់ ទុង បាន ឲ្យដឹង ទៀត ថា រយៈពេល ជាង ៥ឆ្នាំ កន្លងមក នេះ ចំនួន អ្នកជំងឺ ដែល បាន មក ទទួល សេវា ព្យាបាល ពី មន្ទីរពេទ្យ ទាំង មក ពិនិត្យ ធម្មតា និង មក សម្រាក វះកាត់ មួយ ឆ្នាំ ៗ មាន ការកើនឡើង គួរឲ្យ កត់សម្គាល់ ។ ជាក់ស្តែង ក្នុង មួយ ថ្ងៃ អ្នកជំងឺ បាន មក ទទួល សេវា តិច បំផុត ពី ៣០០ នាក់ ទៅ ៤០០ នាក់ ក្នុង មួយ ថ្ងៃ ៗ ចំណែកឯ អ្នកជំងឺ សម្រាក ព្យាបាល នៅក្នុង មន្ទីរពេទ្យ តែ ម្តង ដែល មាន ដូចជា ការវះកាត់ និង ជំងឺ ធ្ងន់ធ្ងរ នោះ តិច បំផុត ពី ៨០ ទៅ ១០០ នាក់ ។
សូម ជម្រាប ជូន ថា មន្ទីរពេទ្យ ពេទ្យ ជោរៃ ភ្នំពេញ ត្រូវបាន មហាជន ជាច្រើន ទទួលស្គាល់ ថា តែងតែ បង្កើតឡើង នូវ កម្ម វីធី សប្បុរសធម៌ នានា ដោយ ពិនិត្យ និង ព្យាបាន ជូន ប្រជាពលរដ្ឋ គ្រប់ វណ្ណៈ ដោយ មិន គិត ថ្លៃ ដែល ប្រព្រឹត្តទៅ រៀងរាល់ ៣ដង ក្នុង មួយ ខែ សម្រាប់ អ្នកជំងឺ ៥០ នាក់ ដំបូង ដែល នេះ បង្ហាញ ពី ការយកចិត្តទុកដាក់ និង លើកកម្ពស់ មួយ លើ វិស័យ សុខាភិបាល នៅ កម្ពុជា ៕ ក្រសួង អប់រំ សម្រេច ឱ្យ បេក្ខជន ១៧នាក់ ធ្លាក់ ដោយ ស្វ័យប្រវត្តិ ដែល ប្រព្រឹត្ត ខុសឆ្គង និង បទបញ្ញាត្តិ ក្នុង ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៨ នេះ
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា ដោយ មាន ការចូលរួម ពី អង្គភាព ប្រឆាំង អំពើពុករលួយ បាន សម្រេច ដាក់ វិន័យ ឱ្យ បេក្ខជន ចំនួន ១៧នាក់ ធ្លាក់ ជា ស្វ័យប្រវត្តិ ដោយសារ ប្រព្រឹត្ត ខុសឆ្គង ផ្ទុយ នឹង បទបញ្ញាត្តិ និង ក្រម វិន័យ សម្រាប់ ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ « បាក់ឌុប » សម័យ ប្រឡង ២០ សីហា ២០១៨ ។
ចំពោះ បេក្ខជន ដែល បាន ប្រព្រឹត្ត ខុសឆ្គង ខាងលើ បាន កើតឡើង នៅ តាម បណ្ឌល សំណេរ មួយចំនួន ដូច ជា៖ ខេត្ត ស្ទឹងត្រែង ១នាក់ . ខេត្ត ក្រចេះ ១នាក់ . ខេត្ត ស្វាយរៀង ១នាក់ . ខេត្ត សៀមរាប ១នាក់ . ខេត្ត កណ្តាល ១នាក់ . ខេត្ត រតនគិរី ១នាក់ . ខេត្ត ព្រះសីហនុ ១នាក់ . ខេត្ត កំពង់ចាម ១នាក់ . ខេត្ត បន្ទាយមានជ័យ ១នាក់ និង រាជធានី ភ្នំពេញ ចំនួន ៧នាក់ ផងដែរ ៕
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន ខ្លឹមសារ ទាំងស្រុង នៃ សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង អប់រំ ដូច ខាងក្រោម៖
ក្រសួង បាន បញ្ជាក់ ដែរ ថា បេក្ខជន ចំនូន ១៧នាក់ ត្រូវបាន កំណត់ ឲ្យ ធ្លាក់ ជា ស្វ័យប្រវត្តិ ដោយ បាន ប្រព្រឹត្ត ខុសឆ្គង ផ្ទុយ នឹង បទបញ្ញត្តិ និង កម្រិត វិន័យ ។
សូម បញ្ជាក់ ថា ការប្រឡង សម្រាប់ ឆ្នាំ សិក្សា ២០១៨ នេះ មាន បេក្ខជន បាន ចុះឈ្មោះ ប្រឡង សរុប ចំនួន ១១៥. ២៦៨ នាក់ ស្រី ៥៨. ១៥៨ នាក់ ។ លទ្ធផល ប្រលង សម្រាប់ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល នឹង ប្រកាស នៅ រសៀល ថ្ងៃ នេះ រីឯ បណ្តា ខេត្ត នានា នឹង ប្រកាស នៅ ថ្ងៃស្អែក ៕
ព័ត៌មាន លម្អិត៖ នំ កញ្ចប់ ១៦៨ កញ្ចប់ និង ចាហួយ ៥១កេស ដែល ក្លែងក្លាយ បង្ក្រាប នៅ ខេត្ត កណ្តាល ត្រូវ បញ្ជូន ទៅ ពិនិត្យ រក សារធាតុ គីមី . បើ រកឃើញ ម្ចាស់ ទំនិញ អាច ប្រឈម ទោសទណ្ឌ
លោក ឯក ស៊ុន រស្មី បាន សំណូមពរ ដល់ កម្លាំង សមត្ថកិច្ច ទាំងអស់ ត្រូវ ត្រួតពិនិត្យ មុខ ទំនិញ ទាំងអស់ ហើយ បើ ទំនិញ ណា មាន ការពាក់ព័ន្ធ ត្រូវ រឹបអូស រួច យក ទៅ បំផ្លាញ ចោល ជាបន្ទាន់ មិន អនុញ្ញាតឲ្យ យក ទៅកាន់ ទីផ្សារ ឡើយ តែ បើសិនជា ទំនិញ ណាមាន គុណភាព ត្រឹមត្រូវ ត្រូវ ប្រគល់ ទៅឲ្យ ម្ចាស់ វិញ យក ទៅ លក់ ដើម្បី កុំ ឲ្យ ប៉ះពាល់ ដល់ របរ ពួកគាត់ ព្រោះ បើ យើង ធ្វេសប្រហែស គេ អាច ប្តឹង យើង បាន ធ្វើឲ្យ ខូចខាត ទំនិញ គេ ។
លោក បាន បន្ត ទៀត ថា បើ តាម ការពិនិត្យ កន្លែង ស្តុក ទំនិញ គាត់ នៅ ជ្រៃ ធំ គឺ មាន ម៉ាស៊ីន អូស ទំនិញ ឡើង ច្រាំង និង ម៉ាស៊ីន ទម្លាក់ ទំនិញ រថយន្ត ដឹកជញ្ជូន រាប់ គ្រឿង ដូច្នេះ មិន មែន ជា អ្នករកស៊ី តូចតាច ដូច ពាក្យ គេ ថា នោះ ទេ ។ នំ ទាំង៣ រថយន្ត នេះ អាច ចែកចាយ បាន ១ ចំហៀង ខេត្ត កណ្តាល ។
អ្នកស្រី ស្រ៊ន ចន្ធី អាយុ ៤៤ ឆ្នាំ មាន ទីលំនៅ ភូមិ ខ្ព ប ឃុំ សំពោពូន ស្រុក កោះ ធំ បាន និយាយ ថា អ្នកស្រី ជា អាជីវករ មិន បាន ដឹង ថា នំ ទាំងនេះ មាន ផល ប៉ះពាល់ ដល់ សុខភាព អ្នក បរិភោគ ធ្ងន់ធ្ងរ បែប នេះ ទេ ប្រសិនបើ អ្នកស្រី ដឹង ទោះបី ចំណេញ ច្រើន យ៉ាងណា ក៏ មិន ទទួល ដែរ ។
អ្នកស្រី បាន បន្ត ថា « ទំនិញ ទាំងនេះ អ្នក យក ទៅ ចែកចាយ តាម ទីផ្សារ នានា ក្នុង ប្រទេស កម្ពុជា ដូច ជា៖ ឧត្តរមានជ័យ បន្ទាយមានជ័យ កណ្តាល និង ខេត្ត ផ្សេង ទៀត ទៅ តាម គេ កាម្មង់ ការនាំចូល មកកាន់ ប្រទេស កម្ពុជា ពី ប្រទេស វៀតណាម មក នោះ គឺ មិន មែន នាំចូល ត្រឹមត្រូវ តាម ផ្លូវ ច្បាប់ នោះ ទេ គឺ មាន ជនជាតិ ខ្មែរ ដឹក តាម ទូក ឬ កាណូត តាម ផ្លូវ ទឹក លួច មក រើ នៅ ចំណុច ខាងលើ លើក ដាក់ រថយន្ត តែម្តង » ។
លោក លាត លី ផ្នែក លក់ នៅ ក្រុមហ៊ុន ជីព ម៉ុង បាន ពន្យល់ ដល់ អ្នកយកព័ត៌មាន និង ផ្តាំ ដល់ បងប្អូន ជា មេផ្ទះ ដែល ទៅ ទិញ ទំនិញ ទាំង ពី ទីផ្សារ ដើម្បី ទុក សម្រាប់ វេចខ្ចប់ ឲ្យ កូន តូច ៗ ទៅ សាលារៀន ឬ បរិភោគ នៅ ផ្ទះ នំ ពិតប្រាកដ មាន ត្រា ហាណា ម៉ិ សម្រាប់ សម្គាល់ តែ នំ ក្លែងក្លាយ វិញ គឺ អត មាន ត្រា ហាណា ម៉ិ ទេ ។ ចំពោះ ការបរិភោគ នំ ក្លែងក្លាយ ធ្វើឲ្យ ប៉ះពាល់ ដល់ សុខភាព កុមារ ទៅជា រលាក ក រលាក ពោះវៀន ជាដើម ។
មន្ត្រី ដដែល បាន បន្ត ថា ទំនិញ ដែល ខាង ជំនាញ លោក យក ទៅ ចូល ឡាបូ ប្រសិនជាពិនិត្យ ទៅ មិន ឃើញ មាន សារធាតុ គីមី នោះ និង ប្រគល់ ទៅ ម្ចាស់ វិញ តែ បើ ពិនិត្យ ទៅ ឃើញ ថា មាន សារធាតុ គីមី ខ្ពស់ ត្រូវ រឹបអូស យក ទៅ កំទេចចោល ទាំងស្រុង ចំណែក ម្ចាស់ ត្រូវ ចាត់ការ ទៅ តាម ផ្លូវ ច្បាប់ ៕ ស្នងការ នគរបាល ខេត្ត កំពង់ធំ បង្ហាញ មុខ សញ្ញា ជួញដូរ សារធាតុ ញៀន យ៉ាង សកម្ម ចំនួន ៦នាក់ មុន បញ្ជូន ទៅកាន់ តុលាការ
( កំពង់ធំ )៖ លោក ឧត្តមសេនីយ៍ ទោ អ៊ុក កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ធំ បាន បង្ហាញ មុខ សញ្ញា ក្រុម ជួញដូរ គ្រឿងញៀន យ៉ាង សកម្ម នៅ តាម មូលដ្ឋាន ដែល កម្លាំង ជំនាញ នៃ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន សហការ ជាមួយ បណ្តា អធិការដ្ឋាន នគរបាល ក្រុង - ស្រុក បង្រ្កាប បាន ថ្មី ៗ នេះ ជាសាធារណៈ ។
លោក ស្នងការ ខេត្ត បាន បន្ត ថា សម្រាប់ ជនសង្ស័យ ទាំងនេះ ជា មុខសញ្ញា ចាស់ ដែល ធ្លាប់ ធ្វើ សកម្មភាព ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពង់ធំ ជាពិសេស ក្នុង ភូមិសាស្ត្រ ក្រុង ស្ទឹង សែន ដែល ធ្លាប់ ជាប់ ពន្ធនាគារ ហើយ ខ្លះ ចេញមកវិញ មិន កែប្រែ ប្រើប្រាស់ និង ជួញដូរ ថ្នាំ ញៀន បន្ត ទៀត ។
ជាក់ស្តែង នៅ ថ្ងៃទី ៧ ខែកញ្ញា ឆ្នាំ ២០១៨ ដោយ មាន ការសម្របសម្រួល នីតិវិធី ពី លោក អ៊ិត សុធា ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ធំ កម្លាំង របស់ លោក បាន ចុះ ទៅ បង្រ្កាប ជាក់ស្តែង តែម្តង ។
លោក ឧត្តមសេនីយ៍ ទោ អ៊ុក កុសល ក៏ បាន សំណូមពរ បន្ថែម ដល់ ស្រទាប់ យុវជន ត្រូវ ជៀស ឱ្យ ឆ្ងាយ ពី គ្រឿងញៀន ព្រោះ បើ មនុស្ស យើង ត្រូវបាន គ្រឿងញៀន គ្រប់គ្រង បាន ហើយ ធ្វើឱ្យ មនុស្ស បាត់បង់ សតិសម្បជញ្ញៈ លែង ស្គាល់ ខុស ត្រូវ អំពី ល្អ អំពើ អាក្រក់ សាច់ញាតិ ឪពុក ម្តាយ បងប្អូន មនុស្ស ជា ទីស្រឡាញ់ ជាដើម ៕
តុលាការ ចេញ ដីកា ឃុំ ខ្លួន អ្នកបើក រថយន្ត តាក់ស៊ី ម្នាក់ ករណី វាយ ប្លន់ ជនជាតិ ជប៉ុន យក ប្រាក់ ជាង ១ម៉ឺន ដុល្លារ នៅ ខណ្ឌ ចំការមន
( ភ្នំពេញ ) ៖ លោក អ៊ី ថា វរៈ ចៅក្រម មស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ កាលពី រសៀល ថ្ងៃទី ៨ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន សម្រេច ចេញ ដីការបង្គាប់ឱ្យ ឃុំ ខ្លួនអ្នកបើក រថយន្ត តាក់ស៊ី ម្នាក់ ឈ្មោះ ប៊ុន ម៉ៅ ដាក់ គុក ព្រៃ ស រឿង វាយ ប្លន់ ភ្ញៀវ ជនជាតិ ជប៉ុន យក លុយ អស់ រាប់ ម៉ឺន ដុល្លារ ហើយ ៦ ថ្ងៃ ក្រោយ ត្រូវ កម្លាំង នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ និង នគរបាល ខណ្ឌ ចំការមន ចាប់ វាយ ខ្នោះ ព្រមទាំង ដកហូត លុយ បាន ១ម៉ឺន ដុល្លារ វិញ ផងដែរ ។
ការសម្រេច របស់ លោក ចៅក្រម បាន ធ្វើឡើង បន្ទាប់ ពី តំណាង អយ្យការ បាន ចោទប្រកាន់ លើ ជនសង្ស័យ ពី បទ « លួច មាន ស្ថាន ទម្ងន់ ទោស » តាម មាត្រា ៣៥៣ និង ៣៥៧ នៃ ក្រម ព្រហ្មទណ្ឌ ។
សូម បញ្ជាក់ ថា ក្រោម បទបញ្ជា ពី នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង អគ្គ ស្នងការ រង នគរបាល ជាតិ ទទួល ផែន ព្រហ្មទណ្ឌ ជាពិសេស មាន ការដឹកនាំ ផ្ទាល់ ពី ឧត្តមសេនីយ៍ ឯក ង៉េង ជូ ប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ . ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ បាន សហការ ជាមួយ អធិការដ្ឋាន នគរបាល ខណ្ឌ ចំការមន ចុះ ធ្វើ ការស្រាវជ្រាវ និង តាម បង្ក្រាប ចោរប្លន់ ម្នាក់ ដែល បាន ប្រើ រថយន្ត ទៅ វាយ ប្លន់ យក លុយ ជាង ១ម៉ឺន ដុល្លារ អាមេរិក ពី ជនជាតិ ជប៉ុន ម្នាក់ ។
លោក វរសេនីយ៍ ឯក ជីវ វិបុល នាយ ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ បាន ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នៅ រសៀល ថ្ងៃទី ៧ ខែកញ្ញា ឆ្នាំ ២០១៨ ថា ការបង្ក្រាប នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ៦ ខែកញ្ញា ឆ្នាំ ២០១៨ ដោយ បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ឈ្មោះ ប៊ុន ម៉ៅ មក ធ្វើ ការសាកសួរ នៅ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ។
ជាមួយគ្នា នេះ កម្លាំង នគរបាល បាន ដកហូត វត្ថុតាង រថយន្ត មួយ គ្រឿង ម៉ាក កាម៉ារី បាឡែន ពណ៌ មាស សេរី ២០០២ ពាក់ ស្លាកលេខ ភ្នំពេញ 1I-7731 ។ ក្រៅពី នោះ សមត្ថកិច្ច ក៏ បាន ដកហូត បាន ទូរស័ព្ទដៃ ចំនួន ២គ្រឿង និង ប្រាក់ ចំនួន ៩៨០០ ដុល្លារ អាមេរិក ។
បើ តាម ជនរងគ្រោះ ពេល ទៅដល់ ផ្ទះ ខ្លួន បាន ឲ្យ ប្រាក់ ៥ដុល្លារ អាមេរិក ។ ភ្លាម ៗ នោះ អ្នកតាក់ស៊ី ដែល ជា ជនសង្ស័យ ឃើញ ខ្លួន មាន លុយ ច្រើន ក៏ ប្រតាយ ប្រតប់ ទាញយក កាបូប លុយ ពី ខ្លួន ហើយក៏ លូក យក ប្រាក់ អស់ ចំនួន ២ម៉ឺន ដុល្លារ អាមេរិក រួច ឡើងជិះ រថយន្ត គេចខ្លួន បាត់ ។
ផ្អែក តាម ចម្លើយ របស់ ជនសង្ស័យ ខ្លួន បាន សារភាព ថា ពិតជា បាន ធ្វើ សកម្មភាព ខាងលើ មែន ដោយ បាន ប្លន់ យក ប្រាក់ ចំនួន ១ម៉ឺន ដុល្លារ អាមេរិក ។ ក្រោយ ធ្វើ សកម្មភាព ខ្លួន បាន បើក រថយន្ត គេចខ្លួន ទៅ ផ្ទះ ហើយ យក ប្រាក់ ទៅ លាក់ ទុក រហូតដល់ ថ្ងៃទី ៦ ខែកញ្ញា ឆ្នាំ ២០១៨ ក៏ ត្រូវ សមត្ថកិច្ច ចាប់ខ្លួន បាន តែម្តង ៕
កូរ៉េ ខាងជើង ធ្វើ ព្យុហយាត្រា យោធា អបអរ ខួបកំណើត ក្រោម ក្រសែភ្នែក របស់ សហរដ្ឋ អាមេរិក
( សេអ៊ូល ) ៖ នៅ ទីបំផុត ដូច ការរំពឹងទុក កូរ៉េ ខាងជើង បាន ធ្វើ ព្យុហយាត្រា យោធា មួយ នៅ ព្រឹក ថ្ងៃអាទិត្យ នេះ ដើម្បី អបអរសាទរ ដល់ ពិធី រំលឹក ខួប លើក ទី៧០ នៃ ថ្ងៃ បង្កើត សាធារណរដ្ឋ ប្រជាមានិត កូរ៉េ ខាងជើង ស្រប ពេល កូរ៉េ ខាងត្បូង និង សហរដ្ឋ អាមេរិក កំពុង តាម ដាន យ៉ាង យកចិត្តទុកដាក់ ។ នេះ បើ តាម ប្រភព ពី មន្ត្រី ស៊ើបការណ៍ សំងាត់ កូរ៉េ ខាងត្បូង ដកស្រង់ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន យ៉ុន ហាប់ នៅ ថ្ងៃអាទិត្យ ទី០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
មន្ត្រី ខាងលើ ដដែល នៅក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ បាន ប្រាប់ យ៉ុន ហាប់ ដូច្នេះ ថា៖ « កូរ៉េ ខាងជើង បាន ធ្វើ ព្យុហយាត្រ យោធា នៅ ព្រឹក ថ្ងៃអាទិត្យ នេះ ហើយ បាន បញ្ចប់ វា ដោយ ជោគជ័យ » ។ ប៉ុន្តែ មន្ត្រី រូប នេះ មិន បាន បញ្ជាក់ ទេ ថា លោក គីម ជុង អ៊ុន មាន វត្ត មាន នៅក្នុង ព្រឹត្តិការណ៍ នេះ យ៉ាងណា នោះ ទេ ហើយ គេ ក៏ ពុំ ទាន់ ដឹង ច្បាស់ ថា តើ កូរ៉េ ខាងជើង បាន បង្ហាញ មីស៊ីល ឆ្លង ទ្វីប នៅក្នុង ពិធី ព្យុហយាត្រា នៅឡើយ ដែរ ។
គួរ បញ្ជាក់ ថា ថ្ងៃអាទិត្យ ទី០៩ ខែកញ្ញា នេះ គឺជា ថ្ងៃ ប្រារព្ធ ខួប លើក ទី៧០ នៃ ថ្ងៃ បង្កើត សាធារណរដ្ឋ ប្រជាមានិត កូរ៉េ ខាងជើង នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ១៩៤៨ ដែល ជា ថ្ងៃ ប្រវត្តិសាស្ត្រ នៃ ការបែងចែក កូរ៉េ ជា ពីរ ៕ អ្នកនាំពាក្យ CPP ចាត់ទុក ការរិះគន់ លើ ការបង្កើត ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ថា ជា អ្នក ចាំ តែ ថា ប៉ុណ្ណោះ
( ភ្នំពេញ ) ៖ លោក សុខ ឥសាន អ្នកនាំពាក្យ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ចាត់ទុក ការរិះគន់ លើ ការបង្កើត ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ដែល អនុញ្ញាតឱ្យ គណបក្ស នយោបាយ គ្មាន អាសនៈ នៅក្នុង រដ្ឋសភា ចូលរួម បម្រើ ជាតិ នោះ ថា ជា អ្នក ចាំ តែ ថា ចាំ តែ រិះគន់ ប៉ុណ្ណោះ ដែល ទោះបីជា រាជ រដ្ឋាភិបាល ធ្វើ អ្វី ក៏ ពួកគេ ចាំ តែ ប្រឆាំង ដែរ ។
ការលើកឡើង របស់ អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច បាន ធ្វើឡើង បន្ទាប់ពី មាន អ្នកវិភាគ និង ក្រុម អ្នក ប្រឆាំង មួយចំនួន បាន រិះគន់ លើ ការបង្កើត ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ នៅក្នុង អាណត្តិ ថ្មី នេះ ថា ជា រឿង ធ្វើឱ្យ ខាតបង់ ថវិកា រដ្ឋ ។
សូម បញ្ជាក់ ថា នៅក្នុង អាណត្តិ ថ្មី នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច បង្កើត ស្ថាប័ន ថ្មី មួយ នោះ គឺ « ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ » ដើម្បី លើកស្ទួយ របប នយោបាយ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ក៏ ដូចជា ផ្តល់ ឱកាស ឱ្យ គណបក្ស នយោបាយ ដែល ចូលរួម ក្នុង ការបោះឆ្នោត ហើយ មិន ទទួលបាន អាសនៈ នោះ ចូលរួម បម្រើ ជាតិ និង ប្រជាពលរដ្ឋ ។
សមាសភាព នៃ « ឧត្តមប្រឹក្សា ពិគ្រោះ និង ផ្ដល់ យោបល់ » ត្រូវបាន ជ្រើស ចេញ ពី គណបក្ស នយោបាយ ចំនួន ១៦ ដែល បាន ចូលរួម ប្រកួតប្រជែង ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ឆ្នាំ ២០១៨ នេះ ចំនួន ២រូប ដែល ប្រធាន គណបក្ស ហៅ ថា ជា « ប្រធាន ប្រតិភូ » និង អនុប្រធាន ឬ អគ្គ លេខាធិការ នៃ គណបក្ស ហៅ ថា « អនុប្រធាន ប្រតិភូ » ។
« ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្ដល់ យោបល់ » គឺជា យន្ដ ការ ថ្មី មួយ ទៀត ដើម្បី ចូលរួម ឆ្លើយតប នឹង ផ្ដល់ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ទាំងមូល ដែល វា មិន មែន ជា ផ្ដល់ ប្រយោជន៍ របស់ រាជ រដ្ឋាភិបាល នោះ ឡើយ ហើយ ប្រធាន គណបក្ស នយោបាយ ទាំងអស់ ដែល ចូលរួម កិច្ចពិគ្រោះយោបល់ នោះ ក៏ បាន ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ គំនិត ផ្ដួច ផ្តើម នេះ ផងដែរ ៕
( តេហេរ៉ង់ ) ៖ ប្រធានាធិបតី អ៊ីរ៉ង់ លោក ហាសាន់ រូហានី បាន និយាយ ថា សហរដ្ឋ អាមេរិក នៅតែ បន្ត ផ្ញើ សារ មកកាន់ អ៊ីរ៉ង់ ជារៀងរាល់ ថ្ងៃ ដើម្បី ស្នើសុំ ចាប់ផ្ដើម កិច្ចចរចា ខណៈ ប្រទេស ទាំង ពីរ កំពុង មាន ភាពតានតឹង នឹង គ្នា កាន់តែ ខ្លាំង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃអាទិត្យ ទី០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ ដាក់ មន្ត្រី ១០៥ នាក់ នៅ ២៥ ក្រសួង / ស្ថាប័ន ឱ្យ ចូល និវត្តន៍
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ មួយ ទៀត ត្រាស់បង្គាប់ ដាក់ មន្ត្រីរាជការ ចំនួន ១០៥ នាក់ នៅក្នុង ក្រសួង / ស្ថាប័ន ចំនួន ២៥ ឱ្យ ចូល និវត្តន៍ ក្នុង ឋានន្តរស័ក្តិ ឧត្តម មន្ត្រី ៕
ដើម្បី ជ្រាប ច្បាស់ សូម អាន ខ្លឹមសារ ទាំងស្រុង នៃ ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្សត្រ ដូច ខាងក្រោម៖
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ពី ស្ថានភាព កម្ពស់ ទឹក ជំនន់ នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ប្រចាំ ថ្ងៃទី ០៩ ខែកញ្ញា នេះ
លទ្ធផល នៃ ការប្រឡង បាក់ឌុប ចាប់ផ្តើម បោះពុម្ព ហើយ ខណៈ មណ្ឌល ភ្នំពេញ និង ខេត្ត កណ្តាល នឹង ប្រកាស នៅ ថ្ងៃ នេះ សម្រាប់ បណ្តា ខេត្ត ផ្សេង ៗ ទៀត នឹង ប្រកាស នៅ ថ្ងៃស្អែក
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ក្រសួង អប់រំ យុវជន និង កីឡា ចាប់ផ្តើម បោះពុម្ព លទ្ធផល នៃ ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ( បាក់ឌុប ) សម័យ ប្រឡង៖ ២០ សីហា ខណៈ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្ដាល នឹង ប្រកាស លទ្ធផល នៅ ថ្ងៃ នេះ ដោយឡែក សម្រាប់ បណ្តា ខេត្ត ផ្សេង ៗ ទៀត នឹង ត្រូវ ប្រកាស នៅ ថ្ងៃទី ១០ ខែកញ្ញា ស្អែក នេះ ។
លទ្ធផល នៃ ការបោះពុម្ព នេះ ប្រព្រឹត្ត ឡើង ក្រោម ការត្រួតពិនិត្យ ដោយ ផ្ទាល់ របស់ លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា និង មាន ការចូលរួម សង្កេតការណ៍ ពីសំណាក់ មន្ត្រី អង្គភាព ប្រឆាំង អំពើពុករលួយ ផងដែរ ។
ដំបូង ឡើយ ក្រសួង អប់រំ គ្រោង នឹង ប្រកាស លទ្ធផល ការប្រឡង សញ្ញាបត្រ បាក់ ឌុប នេះ នៅ ថ្ងៃទី ១១ និង ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ ប៉ុន្តែ ពេលនេះ ត្រូវបាន កែសម្រួល មុនពេល កំណត់ មួយ ថ្ងៃ ។
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ៨ ខែកញ្ញា ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៤គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ៤ ខែកញ្ញា ឆ្នាំ ២០១៨ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន ៤គ្រឿង ក្នុង នោះ រួម មាន៖ ម៉ូតូ ចំនួន ៤គ្រឿង ។
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ការយោគយល់ ! ស្លាប់ ម្នាក់ និង រងរបួស ៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៨ ខែកញ្ញា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៨ ខែកញ្ញា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៦លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ១ នាក់ . របួស ស្រាល ១នាក់ និង របួស ធ្ងន់ ៥នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៦លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៧គ្រឿង និង រថយន្ដ ធុន ធំ១ គ្រឿង និង រថយន្ដ ធុន តូច១ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . មិន ប្រកាន់ ស្ដាំ . ប្រជែង និង បត់ គ្រោះថ្នាក់ ។
សូម បញ្ជាក់ ថា រយៈពេល ០៨ ថ្ងៃ មាន ការណី គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ចំនួន ៥៧ លើក បណ្ដាលឲ្យ មនុស្ស សា្លប់ ចំនួន ២៥ នាក់ . របួស ធ្ងន់ ៦៧ នាក់ និង របួស ស្រាល ចំនួន ២៨ នាក់ ៕
ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ទីប្រឹក្សា សម្តេច ហេង សំរិន ប្រធាន រដ្ឋសភា ចំនួន ២១ រូប
ទីណា មាន ទុក្ខ មាន មុខ ក្រុមការងារ បក្ស ប្រជាជន ! ក្រុមការងារ ស្រុក កំចាយ មារ ចុះអន្តរាគមន៍ ជីក ប្រឡាយ នាំ ទឹក ៣ខ្សែ និង បូម ទឹក សង្គ្រោះ ស្រូវ ៥៥៤ ហិកតា
( ព្រែ វែង ) ៖ មិន ខុសពី ពាក្យ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា នាយក រដ្ឋមន្ត្រី តែងតែ លើក ថា « ទីណា មាន ទុក្ខ តែង មាន មុខ គណបក្ស ប្រជាជន កម្ពុជា » នោះ នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង ដឹកនាំ ដោយ លោក ស្តើង សុខុម ជា ប្រធាន ក្រុម បាន ចុះ ជួយ អន្តរាគមន៍ ជី ប្រឡាយ នាំ ទឹក ៣ខ្សែ និង បូម ទឹក សង្គ្រោះ ស្រូវ ប្រជាពលរដ្ឋ ៥៥៤ ហិកតា ដែល កំពុង ជួប គ្រោះ រាំងស្ងួត ។
របាយការណ៍ របស់ មេឃុំ ស្មោង ត្បូង បាន ឲ្យដឹង ថា ស្ថានភាព គ្រោះ រាំងស្ងួង បាន ចាប់ផ្តើម ក្នុង អំឡុង ពេល ឃោសនា បោះឆ្នោត ហើយ ស្រុក កំចាយ មារ នេះ មិន ដែល ជួប គ្រោះ រាំងស្ងួត ទេ ទើបតែ ឆ្នាំ នេះ ស្រាប់តែ មាន គ្រោះ រាំងស្ងួត កើត មាន ឡើង ហើយ អូសបន្លាយ ពេល យូរ ជាង ឆ្នាំ ណា ៗ ទាំងអស់ ។
បន្ទាប់ពី បាន ស្តាប់ របាយការណ៍ របស់ មេឃុំ ហើយ លោក ស្តើង សុខុម បាន ដឹកនាំ ក្រុមការងារ សិក្សា ជា បន្ទាន់ ដោយ បាន ស្វែងរក ប្រភព ទឹក ដែល អាច ទាញយក ទឹក មក ជួយ ស្រូវ ទាំងអស់ ដែល កំពុង រងគ្រោះ រាំងស្ងួត និង មធ្យោបាយ ក្នុង ការទាញយក ទឹក មក ដាក់ ក្នុង ស្រែ ផងដែរ ។
ដោយសារតែ ភូមិសាស្រ្ត ក្នុង ឃុំ ស្មោង ត្បូង មិន មាន ប្រឡាយ ដែល នាំ ទឹក ពី ប្រឡាយ មេ ឆ្លងកាត់ ទើប បង្កឲ្យ ប្រជាកសិករ ខ្វះ ប្រភព ទឹក សម្រាប់ ស្រោចស្រព ស្រែ របស់ នោះ លោក ស្តើង សុខុម បាន ជំរុញ ឲ្យ មន្រ្តី ស្រុក និង ឃុំ ជួល អេស្កាវា ទ័រ ជីក ប្រឡាយ បង្ហូរ ទឹក ចំនួន ៣ខ្សែ ដែល មាន មាត់ លើ ២ម៉ែត្រ ជម្រៅ ១ម៉ែត្រ និង បាត ក្រោម ១ម៉ែត្រ ប្រវែង ៤.៤០០ម៉ែត្រ ដើម្បី ទាញ ទឹក មកដល់ ស្រែ ជួប គ្រោះ រាំងស្ងួត ដោយ ចំណាយ អស់ ថវិកា ជាង ១៣លាន រៀល ដែល ជា ថវិកា ផ្ទាល់ របស់ លោក និង ក្រុមការងារ ។
ការជួយ នាំ ទឹក មក សង្គ្រោះ ស្រូវ របស់ ប្រជាកសិករ នេះ បាន នាំមក នូវ ភាពសប្បាយរីករាយ ជាខ្លាំង ចំពោះ ប្រជាកសិករ ជាច្រើន គ្រួសារ នៅក្នុង ស្រុក កំចាយ មារ នោះ ។ ពួកគេ បាន ថ្លែងអំណរគុណ និង បាន លើក សរសើរ ដល់ ក្រុមការងារ ផងដែរ ចំពោះ កិច្ច ខ្នះ ខ្នែង ដោះស្រាយ នូវ ទុក្ខ កង្វល់ របស់ ពួកគេ ។
លោក ស្តើង សុខុម នៅ ថ្ងៃ ដដែល នេះ ក៏ បាន ចុះ ពិនិត្យមើល ប្រឡាយ ដែល កំពុង ជីក បង្ហូរ ទឹក ទៅកាន់ ស្រែ របស់ ប្រជាកសិករ ហើយ បាន ជំរុញ ឲ្យ ការជីក ប្រឡាយ នេះ ត្រូវ ធ្វើឲ្យ បាន លឿន បំផុត តាម ដែល អាច ធ្វើ ទៅ បាន ។
លោក ប្រធាន ក្រុមការងារ ក៏ បាន ជួបប្រជុំ ជាបន្ទាន់ ជាមួយ មន្រ្តី ស្រុក កំចាយ មារ និង មន្រ្តី ឃុំ ដើម្បី ពិនិត្យមើល ស្ថានភាព គ្រោះ រាំងស្ងួត ដែល កំពុង កើតមាន នៅក្នុង ស្រុក កំចាយ មារ ។ នៅក្នុង ការជួប សំណេះសំណាល នោះ លោក ប្រធាន បាន ស្តាប់ របាយការណ៍ របស់ ឃុំ នីមួយ ៗ ដែល ជួប គ្រោះ រាំង ស្ងូត ហើយ បាន ផ្តល់ មធ្យោបាយ ជា ការសង្រ្គោះ បន្ទាន់ ដល់ ឃុំ មួយចំនួន និង មួយចំនួន ទៀត លោក បាន ស្នើឲ្យ ស្រុក ខិតខំ ធ្វើ ទំនាក់ទំនង ទៅ ខេត្ត ដើម្បី សុំ អន្តរាគមន៍ ម៉ាស៊ីន បូម ទឹក ជួយ សង្រ្គោះ ស្រូវ របស់ ប្រជាពលរដ្ឋ ។
លោក ស្តើង សុខុម បាន សម្តែង នូវ ការសោកស្តាយ ចំពោះ ស្រូវ ប្រជាពលរដ្ឋ ដែល ជួប គ្រោះ រាំងស្ងួត និង បាន សន្យា ប្រឹងប្រែង ដោះស្រាយ បញ្ហា នេះ ឲ្យបាន ទាន់ ពេល វេលា ។
នៅ រសៀល ថ្ងៃ ដដែល នោះ លោក ប្រធាន ក្រុមការងារ ក៏ បាន បន្ត ដំណើរ ទៅកាន់ ឃុំ ស៊ាង ឃ្វាង ដែល ជា ឃុំ មួយ ទទួលរងគ្រោះ រាំងស្ងួត ផងដែរ ។ នៅ ទីនេះ មាន ស្រូវ ចំនួន ៨៦៧ ហិកតា កំពុង រង ផល ប៉ះពាល់ ដែល ត្រូវការ ការ ជួយ អន្តរាគមន៍ នាំ ទឹក មក ជួយ សង្រ្គោះ ជាបន្ទាន់ ។
នៅ ទីនោះ លោក សូ ខន ឬ ទ្ធី គុណ ដែល ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ឃុំ ស៊ាង ឃ្វាង បាន ឲ្យដឹង ថា នៅ ទីនេះ លោក បាន អន្តរាគមន៍ ស្តារ ប្រឡាយ នាំ ទឹក ប្រវែង ២.០០០ម៉ែត្រ ពី ប្រឡាយ មេ មកកាន់ ស្រែ របស់ កសិករ និង បាន ដាក់ លូ តាម ផ្លូវ ៤ កន្លែង ដើម្បី បើក មុខ ទឹក ៕
( ភ្នំពេញ ) ៖ កសាង សមត្ថភាព វិជ្ជាជីវៈ និង សហគ្រិន ភាព នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស ដែល មាន វ័យ ចំណាស់ បទពិសោធន៍ បណ្តុះបណ្តាល ជាង ២០ ឆ្នាំ ល្បី ឈាន មុខ គេ លើ គុណភាព ការងារ និង មុខរបរ ដល់ សិស្ស និស្សិត ។ ពិសេស និស្សិត ចេះ ភាសារ អង់គ្លេស កុំព្យូទ័រ និង ជំនាញ ឯកទេស ក្នុង ពេល តែ១ សាកលវិទ្យាល័យ មាន អគារ សិក្សា ផ្ទាល់ខ្លួន ធំ ទូលាយ កណ្តាល រាជធានី ភ្នំពេញ សម្ភារ រូបវន្ត ទំនើប សាស្រ្តាចារ្យ មាន សមត្ថភាព វិជ្ជាជីវៈ ខ្ពស់ មាន ដៃគូ ផ្តល់ ការងារ ជាង ២០០ ក្រុមហ៊ុន និង ដៃគូ អន្តរជាតិ ជាង ១០០ សាកលវិទ្យាល័យ ។
សិក្សា នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស ដើម្បី ទទួលបាន នូវ ឧត្តមភាព សមត្ថភាព ជំនាញ និង ឱកាស ការងារ ខ្ពស់ ជារៀងរាល់ ឆ្នាំ អត្រា និស្សិត ទើប បញ្ចប់ ការសិក្សា មាន ការងារ ជាង ៩០% ។ លើស ពី នោះ សាកលវិទ្យាល័យ ក៏ មាន ការផ្ដល់ជូន អាហារ រូបករណ៍ ច្រើន កន្លែង ផងដែរ ។
លោក រត្ន័ សណ្ដាប់ បន្ដ ថា បើ ដូច្នេះ ចំពោះ កិច្ចប្រជុំ គណៈ រដ្ឋមន្រ្ដី ជា លើក ដំបូង ដូច យើង ឃើញ នេះ គឺ ក្នុង ន័យ ប្រកាស ប្រាប់ ដល់ មហាជន ខ្មែរ ដែល ជា ម្ចាស់ ឆ្នោត ថា « រាជ រដ្ឋាភិបាល អាណត្ដិ ទី៦ បាន ចាប់ផ្ដើម ធ្វើ ការងារ របស់ ខ្លួន ដោយ រាប់ ជា ថ្ងៃទី១ ចាប់ពី កិច្ចប្រជុំ » នេះ តទៅ ៕
ទេសរដ្ឋមន្ដ្រី អូស្មាន ហាស្សាន់ ទទួល បណ្ឌិត កិត្តិយ គ្រប់គ្រង ធុរកិច្ច ពី សាកលវិទ្យាល័យ ហ្វាតូនី ប្រទេស ថៃ
( ប៉ាតានី - ថៃ )៖ លោក អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្រ្តី ទទួលបន្ទុក បេសកកម្ម ពិសេស នៅ ព្រឹក ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ទទួល សញ្ញាបត្រ បណ្ឌិត កិត្តិយស គ្រប់គ្រង ធុរកិច្ច ពី សាកលវិទ្យាល័យ ហ្វាតានី នៅ ភាគ ខាងត្បូង ថៃ ជា សាកលវិទ្យាល័យ អន្តរជាតិ ធំ ជាង គេ ក្នុង តំបន់ ភាគ ខាងត្បូង ប្រទេស នេះ ។
ពិធី ខាងលើ ធ្វើឡើង ស្រប ជាមួយនឹង ពិធី ប្រគល់ សញ្ញាបត្រ លើក ទី ១៥ របស់ សាកលវិទ្យាល័យ ដែល សរុប មាន ចំនួន ៩៧១ រូប ដែល ក្នុង នោះ ឥស្សរជន បណ្ឌិត កិត្តិយស ប្រចាំ ឆ្នាំ របស់ សាកលវិទ្យាល័យ ១រូប គឺ លោក ទេសរដ្ឋមន្រ្តី អូស្មាន ហាស្សាន់ និង ១០រូប សញ្ញាបត្រ អនុបណ្ឌិត ព្រមទាំង ៩៦០ រូប បរិញ្ញាបត្រ និង បរិញ្ញាបត្រ រង ក្នុង នោះ និស្សិត ខ្មែរ ២២ នាក់ ដែល ទទួល បរិញ្ញាបត្រ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សុខសប្បាយ ជា ទេ បងប្អូន ជន រួម ជាតិ ? អរគុណ បងប្អូន និង កូនក្មួយ ទាំងអស់ គ្នា ដែល បាន ចូលរួម ថែរក្សា សន្តិភាព សម្រាប់ ប្រទេសជាតិ យើង ទាំងមូល និង អរគុណ ចំពោះ ការជូនពរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បញ្ជាក់ យ៉ាង ដូច្នេះ « ថ្ងៃស្អែក នេះ ខ្ញុំ នឹង ទៅ ចូលរួម ពិព័រណ៍ ចិន - អាស៊ាន លើក ទី ១៥ នៅ ទីក្រុង ណានីន ប្រទេស ចិន ដែល កម្ពុជា យើង ត្រូវបាន ផ្តល់ កិត្តិយស ជា ប្រទេស កិត្តិយស នៅក្នុង ពិធី ដ៏ អធិកអធម នេះ ផងដែរ ។ នៅ ថ្ងៃទី ១២ ខ្ញុំ នឹង ចេញដំណើរ ពី ប្រទេស ចិន បន្ត ទៅ ចូលរួម វេទិកា សេដ្ឋកិច្ច ពិភពលោក នៅ ទីក្រុង ហាណូយ ប្រទេស វៀតណាម » ។
ជាមួយគ្នា នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ជូនពរ បងប្អូន ជន រួម ជាតិ និង កូនក្មួយ សប្បាយរីករាយ នៅក្នុង ថ្ងៃ សម្រាក ចុង សប្តាហ៍ គ្រប់ ៗ គ្នា ៕
( កណ្តាល ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ រសៀល ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស លទ្ធផល នៃ ការប្រលង មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ឬ ហៅ ថា បាក់ឌុប សម័យ ប្រឡង៖ ២០ សីហា ២០១៨ ជា ផ្លូវការ ហើយ សម្រាប់ មណ្ឌល ខេត្ត កណ្តាល ។
ខាងក្រោម នេះ ជា តារាង លទ្ធផល សិស្ស ប្រលង ជាប់ បាក់ឌុប ប្រចាំ មណ្ឌល ខេត្ត កណ្តា ល៖
ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត៖ ការពារ ជាតិ មិន មែន ជា ភារកិច្ច របស់ មនុស្ស ជំនាន់ ណាមួយ នោះ ទេ តែ ជា ភារកិច្ច របស់ យើង ទាំងអស់ គ្នា គ្រប់ ជំនាន់
( កណ្តាល ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក បាន លើកឡើង ថា ការពារ ជាតិ មិន មែន ជា ភារកិច្ច របស់ មនុស្ស ជំនាន់ ណាមួយ នោះ ទេ ប៉ុន្តែ គឺជា ភារកិច្ច របស់ យើង ទាំងអស់ គ្នា គ្រប់ ជំនាន់ ។ ដូច្នេះ ភារកិច្ច ពី មួយ ជំនាន់ ទៅ មួយ ជំនាន់ យើង ត្រូវ រួមគ្នា វា ដូចជា យើង ជិះ ទូក គឺ ត្រូវ ទៅ មុខ ជានិច្ច ហើយ លឿន ជាង មុន ។
មេទ័ព ជើងគោក កម្ពុជា ដែល ទើប ឡើង កាន់ តំណែង ថ្មី ៗ នេះ បាន បញ្ជាក់ បន្ថែម ទៀត ថា ទ័ព បច្ចុប្បន្ន ត្រូវ ខិតខំ យក គំរូ វីរភាព កងទ័ព ជំនាន់ មុន រក្សាទុក នូវ អ្វី ដែល ល្អ ៗ អ្វី ដែល យើង មិន ទាន់ បាន ត្រូវ ខិតខំ ធ្វើ កំណែទម្រង់ តាម បទដ្ឋាន គតិយុត្តិ រួមគ្នា គិត រួមគ្នា ធ្វើ រួមគ្នា អនុវត្ត រួមគ្នា ទទួលខុសត្រូវ ចំពោះ ជាតិ របស់ យើង ទាំង ពេល បច្ចុប្បន្ន និង ទៅ ថ្ងៃ អនាគត ។
CDC បាន ចុះផ្សាយ ថា តាម សំណើ សុំ វិនិយោគ របស់ ក្រុមហ៊ុន គណៈកម្មាធិការ តំបន់ សេដ្ឋកិច្ច ពិសេស កម្ពុជា នៃ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន សម្រេច ចេញ វិញ្ញាបនប័ត្រ ចុះបញ្ជី ជា ស្ថាពរ ជូន ដល់ ក្រុមហ៊ុន ដូច ខាងក្រោម៖
តាម ក្រសួង អប់រំ បាន ឲ្យដឹង ថា៖
គម្រោង ដីឡូតិ៍ ថ្មី របស់ អ័រគីដេវីឡា ដឹប៊ូ តា និច ស៊ីធី ក្បែរ ដង ទន្លេ សាប
( ភ្នំពេញ ) ៖ ក្នុង ពេល បច្ចុប្បន្ន នេះ កំណើន នៃ ការទិញ លក់ ដីឡូតិ៍ កំពុង មាន សន្ទស្សន៍ ខ្លាំងក្លា នៅក្នុង ទីផ្សារ ជាពិសេស នៅ តាម តំបន់ ទីក្រុង សំខាន់ ៗ ដែល មាន កំណើន វិនិយោគ ច្រើន តួយ៉ា ង៖ តំបន់ ពាណិជ្ជកម្ម តំបន់ ឧស្សាហកម្ម និង តំបន់ ដែល ត្រូវបាន កំណត់ ដោយ រដ្ឋ ថា ជា ទីតាំង អភិវឌ្ឍន៍ នៅពេល អនាគត ។ ជាក់ស្តែង គម្រោង ដីឡូតិ៍ គឺ ពិតជា បាន ផ្តល់ ផលប្រយោជន៍ ច្រើន ដល់ ពលរដ្ឋ ដោយ ហេតុ ថា ដី គឺជា ទ្រព្យ ដ៏ ចាំបាច់ មួយ សម្រាប់ គ្រួសារ នីមួយ ៗ ហើយ ពួកគាត់ អាច សាងសង់ លំនៅដ្ឋាន បាន យ៉ាង សមរម្យ ។
ជាមួយ គោលការណ៍ បង់ប្រាក់ងាយ សម្រាប់ អតិថិជន ដែល ទិញ ដីឡូតិ៍ សម្រាប់ សាងសង់ លំនៅឋាន ចាប់ពី ថ្ងៃ នេះ លោក អ្នក អាច ធ្វើ ការបង់ រំលស់ ដោយ គ្មាន ការប្រាក់ និង មិន ចាំបាច់ មាន ប្រាក់ សម្រាប់ កក់ ឡើយ ។
មេ យោធា ខេត្ត កំពង់ឆ្នាំង នាំ ថវិកា បេឡាម រណៈ សង្គ្រោះ របស់ សម្ដេច តេជោ ហ៊ុន សែន ចំនួន ៤លាន រៀល ប្រគល់ ជូន គ្រួសារ សព អតីត យុទ្ធជន
ក្នុង ពិធី នេះ ដែរ លោក ឧត្តមសេនីយ៍ ទោ ធន ធឿន ក៏ បាន នាំយក នូវ សារ រំលែក ទុក្ខ និង ដែង នូវ ការសោកស្តាយ យ៉ាង ពន់ពេក ដែល បាត់បង់ នូវ សមាជិក អតីត យុទ្ធជន ដែល ធ្លាប់ តស៊ូ រំដោះ ប្រជាជន និង រំដោះ ទឹកដី នា ពេល កន្លងមក ។ ជាមួយគ្នា នេះ ដែរ លោក ក៏ បាន ពន្យល់ ពី គោលរបប របស់ សមាគម និង ផលប្រយោជន៍ មួយចំនួន ដែល គ្រួសារ សព ត្រូវ ទទួលបាន ក្រោយពី សមាជិក អតីត យុទ្ធជន បាន ទទួលមរណៈ កាល ទៅ ។
ទទ្ទឹម នឹង នេះ ក្រុមគ្រួសារ នៃ សព ក៏ បាន ថ្លែង នូវ អំណរ អរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ សម្តេច តេជោ ដែល តែងតែ យកចិត្តទុកដាក់ គិតគូរ ពី សុខ ទុក្ខ របស់ បងប្អូន អតីត យុទ្ធជន គ្រប់ ទីកន្លែង និង គ្រប់ ពេលវេលា សូម សម្តេច តេជោ ទទួលបាន នូវ ជោគជ័យ គ្រប់ ភារកិច្ច ទាំងអស់ និង បន្ត ដឹកនាំ ប្រទេសជាតិ កាន់តែ រីកចម្រើន បន្ត ទៀត ៕
លោកស្រី ម៉ែន សំអន៖ នៅ អាណត្តិ ថ្មី នេះ យើង ត្រូវ រួមគ្នា អភិវឌ្ឍ ប្រទេស ឱ្យ កាន់តែ រីកចម្រើន លើ គ្រប់ វិស័យ និង ទាក់ទាញ អ្នក វិនិយោគ បង្កើត ជា រោងចក្រ និង សហគ្រាស ជាច្រើន ទៀត
( ស្វាយរៀង ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន សមាជិកា គណៈ អចិន្រ្តៃយ៍ នៃ គណៈកម្មការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា អ្នកតំណាងរាស្រ្ត មណ្ឌល ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ ក្រុមការងារ ចុះ ជួប សំណេះសំណាល និង ថ្លែងអំណរគុណ ដល់ ក្រុម យុវជន គណបក្ស ប្រជាជន កម្ពុជា នៅ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង ដែល មាន យុវជន ចូលរួម ៨៥០ នាក់ ។
ថ្លែង ក្នុង ឱកាស នោះ លោកស្រី ក៏ បាន ពាំនាំ នូវ ការសាកសួរ សុខទុក ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន ដល់ អង្គ ពិធី ហើយក៏ បាន កោតស សើរ និង ថ្លែងអំណរគុណ ដល់ ក្មួយ ៗ ជា ក្រុម យុវជន សកម្មជន បក្ស ដែល បាន ចុះ ឃោសនា រក សម្លេង ឆ្នោត និង នាំគ្នា ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ឈ្នះ ភ្លូក ទឹភ្លូក ដី ក្នុង នោះ គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន អាសនៈ ដ៏ ច្រើន លើសលប់ ក្នុង អាណត្តិ ទី៦ នេះ រហូត ១២៥ អាសនៈ ។
លោកស្រី បាន បញ្ជាក់ ថា ជ័យ ជំនះ ទាំងនេះ កើត ចេញ អំពី ទី១៖ ការចូលរួម របស់ បងប្អូន ទាំងអស់ គ្នា . ទី ២៖ គណបក្ស ប្រជាជន កម្ពុជា មាន គោល នយោបាយ ច្បាស់លាស់ ១១ ចំណុច ដែល បាន បម្រើ ឲ្យ ផលប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ តាមរយៈ អភិក្រម មនុស្ស ផ្លូវ ទឹក ភ្លើង ជាដើម ។ល ។ ទី ៣៖ អំពើ ល្អ និង ប្រជាប្រិយភាព របស់ ថ្នាក់ដឹកនាំ គណបក្ស គ្រប់ ជាន់ ថ្នាក់ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន ទាំង ក្នុង ឆាក ជាតិ និង ឆាក អន្តរជាតិ ។
លោកស្រី បាន បន្ត ទៀត ថា អាណត្តិ ទី៦នេះ យើង ត្រូវ រួមគ្នា អភិវឌ្ឍ ប្រទេស ឱ្យ កាន់តែ រីកចម្រើន លើ គ្រប់ វិស័យ ជា បន្តបន្ទាប់ ទៀត ព្រមទាំង ទាក់ទាញ អ្នក វិនិយោគ បង្កើត ជា រោងចក្រ សហគ្រាស ជាច្រើន ទៀត ឱ្យ មក រកស៊ី នៅ ខេត្ត ខេត្ត ស្វាយរៀង ដើម្បីឱ្យ ប្រជាពលរដ្ឋ មាន ការងារ ធ្វើ កាត់បន្ថយ ភាពក្រីក្រ បង្កើន ជីវភាព បាន មួយ កំរិត បន្ថែម ទៀត ។
លោកស្រី បាន បញ្ជាក់ ថា យុវជន ពិតជា មាន តួនាទី សំខាន់ ណាស់ ក្នុង ការកំណត់ ជោគវាសនា ប្រទេសជាតិ ដូច្នេះ ក្មួយ ៗ យុវជន ទាំងអស់ ត្រូវ ខិតខំ រៀនសូត្រ និង រួមគ្នា ថែរក្សា សុខ សន្តិភាព ឱ្យ ស្ថិតស្ថេរ ជា និរន្ត ដើម្បី ប្រទេសជាតិ យើង មាន ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ទៀត ។
( សេអ៊ូល ) ៖ កូរ៉េ ខាងជើង បាន ធ្វើ ព្យុហយាត្រា យោធា មួយ នៅ ព្រឹក ថ្ងៃអាទិត្យ នេះ ដើម្បី អបអរសាទរ ដល់ ពិធី រំលឹក ខួប លើក ទី៧០ នៃ ថ្ងៃ បង្កើត សាធារណរដ្ឋ ប្រជាមានិត កូរ៉េ ខាងជើង ដោយ មិន បាន បង្ហាញ មីស៊ីល ឆ្លង ទ្វីប ICBM ឡើយ ក្រោម ការឃ្លាំមើល យ៉ាង យកចិត្ត ទុកដាក់ ពីសំណាក់ កូរ៉េ ខាងត្បូង និង សហរដ្ឋ អាមេរិក ។ នេះ បើ តាម ប្រភព ពី មន្ត្រី ស៊ើបការណ៍ សំងាត់ កូរ៉េ ខាងត្បូង ដកស្រង់ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន យ៉ុន ហាប់ នៅ ថ្ងៃអាទិត្យ ទី០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
មន្ត្រី ខាងលើ ដដែល នៅក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ បាន ប្រាប់ យ៉ុន ហាប់ ដូច្នេះ ថា៖ « កូរ៉េ ខាងជើង បាន ធ្វើ ព្យុហយាត្រ យោធា នៅ ព្រឹក ថ្ងៃអាទិត្យ នេះ ហើយ បាន បញ្ចប់ វា ដោយ ជោគជ័យ » ។ មន្ត្រី រូប នេះ បញ្ជាក់ ទៀត ទីក្រុង ព្យុងយ៉ាង មិន បាន បង្ហាញ មីស៊ីល ICBM ដូច រាល់ ដង ឡើយ ប៉ុន្តែ មិន បាន បញ្ជាក់ ទេ ថា លោក គីម ជុង អ៊ុន មាន វត្តមាន ទស្សនា ព្យុហយាត្រា យោធា នេះ ដែល ចាប់ផ្ដើម នៅ ម៉ោង ១០ព្រឹក មិញ នេះ ឬ យ៉ាងណា នោះ ទេ ។
គួរ បញ្ជាក់ ថា ថ្ងៃអាទិត្យ ទី០៩ ខែកញ្ញា នេះ គឺជា ថ្ងៃ ប្រារព្ធ ខួប លើក ទី៧០ នៃ ថ្ងៃ បង្កើត សាធារណរដ្ឋ ប្រជាមានិត កូរ៉េ ខាងជើង នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ១៩៤៨ ដែល ជា ថ្ងៃ ប្រវត្តិសាស្ត្រ នៃ ការបែងចែក កូរ៉េ ជា ពីរ ៕ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ខួប អនុស្សាវរីយ៍ គម្រប់ ឆ្នាំ ទី១០ ថ្ងៃ បង្កើត បញ្ជាការដ្ឋាន អង្គរក្ស និង ដាក់ ឱ្យ ប្រើប្រាស់ អគារ ទី បញ្ជាការ៣ខ្នង
( កណ្តាល ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក នៅ ព្រឹក ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ខួប អនុស្សាវរីយ៍ គម្រប់ ឆ្នាំ ទី១០ ថ្ងៃ បង្កើត បញ្ជាការដ្ឋាន អង្គរក្ស ស្ថិត នៅ ទួល ក្រសាំង ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ។
ពិធី នេះ បាន ប្រារព្វ ធ្វើ នៅ ទីបញ្ជាការដ្ឋាន អង្គរក្ស ដែល មាន ការចូលរួម ពី បណ្តា អង្គ ទូត សេនានុព័ន្ធ អនុព័ន្ធ យោធា នៃ ប្រទេស ជា មិត្ត ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ នៃ ក្រសួង ការពា ជាតិ នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន និង ភ្ញៀវ ជាតិ - អន្តរជាតិ ចូលរួម ជាង ២ពាន់ នាក់ ដោយ មាន ការតាំង បង្ហាញ យោធ បរិក្ខា ផ្សេង ៗ ផងដែរ ។
ក្នុង ពិធី នេះ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត នឹង អញ្ជើញ កាត់ ខ្សែបូរណ៍ សម្ពោធ អគារ ទី បញ្ជាការ ចំនួន ០៣ ខ្នង ផងដែរ ៕
យល់ដឹង ផ្នែក ច្បាប់៖ ទ្រព្យ រួម និង ទ្រព្យ ដោយឡែក របស់ ប្តី ប្រពន្ធ
ដូច្នេះ កម្មវីធី យល់ដឹង ផ្នែក ច្បាប់ របស់ អង្គភាព ព័ត៌មាន Fresh News សហការ ជាមួយ ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ សូម លើក យក ប្រធានបទ ស្តីពី “ ទ្រព្យ រួម និង ទ្រព្យ ដោយឡែក របស់ ប្តី ប្រពន្ធ ” មក ធ្វើ ការចែករំលែក ដល់ បងប្អូន ប្រជាពលរដ្ឋ សិស្ស និសិ្សត ដូចតទៅ៖ តើ ទ្រព្យសម្បត្តិ ណា ខ្លះ ត្រូវ ចាត់ទុក ជា ទ្រព្យសម្បត្តិ រួម ហើយ ទ្រព្យសម្បត្តិ ណា ខ្លះ ត្រូវ ចាត់ទុក ជា ទ្រព្យ ដោយឡែក ?
១៖ ទ្រព្យសម្បត្តិ ដោយឡែក ទ្រព្យសម្បត្តិ ដោយឡែក គឺជា ទ្រព្យសម្បត្តិ ដែល ស្ថិត នៅក្រោម កម្មសិទ្ធិ របស់ សហព័ទ្ធ ( ប្តី ឬ ប្រពន្ធ )ណា ម្នាក់ ដូច ខាងក្រោម៖
ក . ទ្រព្យសម្បត្តិ ដែល ប្តី ឬ ប្រពន្ធ មាន នៅ មុនពេល រៀបអាពាហ៍ពិពាហ៍ មាន ន័យ ថា ភាគី ប្តី ឬ ប្រពន្ធ មាន ទ្រព្យ នោះ នៅ មុនពេល រៀបអាពាហ៍ពិពាហ៍ ទោះបី ក្រោយ រៀប អាពាហ៍ពិពាហ៍ ក៏ដោយ ក៏ គេ ចាត់ទុក ថា ទ្រព្យ នោះ ជា ទ្រព្យ ដោយឡែក របស់ ប្តី ឬ ប្រពន្ធ នោះ ដដែល ។
ឧទាហរណ៍៖ ប្តី មាន ផ្ទះ មួយ ល្វែង មុនពេល រៀបអាពាហ៍ពិពាហ៍ ទោះ ក្រោយ រៀបអាពាហ៍ពិពាហ៍ ក៏ ផ្ទះ នោះ នៅតែ ជា ទ្រព្យ របស់ ប្តី ដដែល គឺ មិន អាច រាប់ ជា ទ្រព្យ រួម នោះ ទេ ។
ខ. ទ្រព្យសម្បត្តិ ដែល ប្តី ឬ ប្រពន្ធ ទទួលបាន ដោយ ប្រទាន កម្ម សន្ត តិកម្ម ឬ អច្ច័យ ទាន នៅក្នុង អំឡុង ពេល អាពាហ៍ពិពាហ៍ ។ ក្នុង ករណី ប្រសិនបើ ម្ចាស់ អំណោយ ទ្រព្យ អោយ ទៅ ប្តី ឬ ប្រពន្ធ នោះ មាន ន័យ ថា អំណោយ នោះ នឹង ក្លាយទៅជា ទ្រព្យ ដោយឡែក របស់ ប្តី ឬ ប្រពន្ធ នោះ ។ លើកលែងតែ ម្ចាស់ អំណោយ បាន បញ្ជាក់ ថា ឱ្យ ទាំង ប្តី និង ប្រពន្ធ ទើប ទ្រព្យ នោះ ក្លាយទៅជា ទ្រព្យ រួម របស់ ប្តី និប្រពន្ធ ។
គ. ទ្រព្យសម្បត្តិ ជា តម្លៃ តប ទាក់ទង នឹង ការចាត់ចែង ទ្រព្យ ដោយឡែក គេ ចាត់ទុក ថា ជា ទ្រព្យ ដោយឡែក ។
២៖ ទ្រព្យសម្បត្តិ រួម ទ្រព្យសម្បត្តិ រួម គឺជា ទ្រព្យសម្បតិ្ត ទាំងឡាយ ណា ដែល ប្តី ប្រពន្ធ ទាំង សងខាង ឬ តែ ម្ខាង ទទួលបាន នៅក្នុង អំឡុង ពេល អាពាហ៍ពិពាហ៍ ក្នុង លក្ខណៈ ជា ប្រាក់ បៀវត្សរ៍ ឬ ប្រាក់ ឈ្នួល ឬ ប្រាក់ កម្រៃ ឬ ប្រយោជន៍ នានា ផ្សេង ពី ចំនុច ទាំង ៣ ខាងលើ ។
ឧទាហរណ៍៖ ប្តី ធ្វើការ ជា មន្ត្រីរាជការ និង ទទួលបាន ប្រាក់ បៀវត្ស១ លាន រៀល ក្នុង មួយ ខែ ក្នុង អំឡុង ពេល អាពាហ៍ពិពាហ៍ ។ ហេតុ ដូច្នេះហើយ ប្រាក់ បៀវត្ស របស់ ប្តី ត្រូវ ចាត់ទុក ជា ទ្រព្យសម្បត្តិ រួម របស់ ប្តី និង ប្រពន្ធ ។ ក្នុង ករណី ប្រាក់ ចំណូល ដែល ប្តី រក បាន តែ ម្ខាង ហើយ ប្រពន្ធ ត្រឹមតែ ជា ស្រ្តី មេ ផ្ទះ ធ្វើ តែ ការងារ គេហកិច្ច ( ការងារ ក្នុង ផ្ទះ ) តើ ប្រាក់ ចំណូល ដែល ប្តី រក បាន តែ ម្ខាង ត្រូវ ចាត់ទុក ថា វា ជា ទ្រព្យ រួម ឬ ទ្រព្យ ដោយឡែក ?
ដូច នឹង ឧទាហរណ៍ ខាងលើ ដែល ប្តី ធ្វើការ ជា មន្ត្រីរាជការ និង ទទួលបាន ប្រាក់ បៀវត្ស ១លាន រៀល ក្នុង មួយ ខែ ក្នុង អំឡុង ពេល អាពាហ៍ពិពាហ៍ ។ ហេតុ ដូច្នេះហើយ ប្រាក់ បៀវត្ស របស់ ប្តី ត្រូវ ចាត់ទុក ជា ទ្រព្យសម្បត្តិ រួម របស់ ប្តី និង ប្រពន្ធ ។ ស្រប ពេល គ្នា នោះ ដែរ ប្តី ក៏ មាន ផ្ទះ មួយ ល្វែង ដែល ជា ទ្រព្យ ដោយឡែក របស់ ខ្លួន ហើយ ប្តី បាន ដាក់ ផ្ទះ នោះ ជួល ដើម្បី បាន ថ្លៃ ឈ្នួល ប្រចាំ ខែ ។ ដូច្នេះ ថ្លៃ ឈ្នួល ប្រចាំ ខែ ដែល បាន មក ពី ការជួល ផ្ទះ នោះ គេ ចាត់ទុក ថា ជា ទ្រព្យ រួម របស់ ប្តី និង ប្រពន្ធ ។
រៀបរៀង ដោយ៖ លោក មេធាវី សេង ឈុន លី អនុប្រធាន ក្រុម មេធាវី និង កញ្ញា សាំង សុភាព សមាជិក ក្រុមការងារ រៀបចំ និង ផ្សព្វផ្សាយ អត្ថបទ ច្បាប់ នៃ ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ
៤៖ សម្តេច នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន៖ ការរក្សា រដ្ឋមន្ត្រី ចាស់ ហើយ ដាក់ ក្មេង ចូល ធ្វើការ ជាមួយ គឺជា រឿង ចាំបាច់ បំផុត ( ចុច អាន )
៥៖ ទីបំផុត ក្បាល ម៉ាស៊ីន រដ្ឋសភា និង ក្បាល ម៉ាស៊ីន រាជ រដ្ឋាភិបាល ត្រូវបាន រដ្ឋសភា អនុម័ត ( ចុច អាន )
៦៖ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង សមាសភាព គណៈ រដ្ឋមន្រ្តី ថ្មី ក្រោយ ទទួលបាន ការបោះឆ្នោត ផ្តល់ សេចក្តីទុកចិត្ត ពី រដ្ឋសភា ( ចុច អាន )
៧៖ មេទ័ព កំពូល ៗ របស់ កម្ពុជា ៣រូប ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង ជា ផ្លូវការ ( ចុច អាន )
៨៖ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង និង ផ្តល់ ឋានៈ ជូន សមាសភាព ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ចំនួន ៣០ រូប ( ចុច អាន )
ប្រធានាធិបតី ចិន៖ ទំនាក់ទំនង រវាង ចិន និង កូរ៉េ ខាងជើង គ្មាន នរណា អាច បំបែកបំបាក់ បាន ឡើយ
( ប៉េកាំង ) ៖ ប្រធានាធិបតី ចិន លោក ស៊ី ជិន ពីង បាន ផ្ញើ សារ អបអរសាទរ ដល់ មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន នៅ ថ្ងៃអាទិត្យ នេះ នា ឱកាស ប្រារព្ធ ខួប លើក ទី៧០ នៃ ថ្ងៃ បង្កើត សាធារណរដ្ឋ ប្រជាមានិត កូរ៉េ ខាងជើង ជាមួយ ការអះអាង យ៉ាង មុតមាំ ចំពោះ ទំនាក់ទំនង ចាក់ ទឹក មិន លិច និង មិន អាច បំបែក បាន រវាង មហា មិត្ត ទាំង ពីរ ។ នេះ បើ តាម KCNA ដកស្រង់ ដោយ ទីភ្នាក់ងារ សារ ព័ត៌មាន យ៉ុន ហាប់ នៅ ថ្ងៃអាទិត្យ ទី០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
សារព័ត៌មាន រដ្ឋ កូរ៉េ ខាងជើង KCNA ផ្អែក លើ លិខិត របស់ លោក ស៊ី បាន គូសបញ្ជាក់ ដូច្នេះ ថា៖ « គណបក្ស និង រដ្ឋាភិបាល ចិន បាន និង កំពុង ផ្ដល់ អទិភាព យ៉ាង ខ្ពស់ ដល់ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង ចិន និង កូរ៉េ ខាងជើង ... ហើយ នេះ គឺជា គោលនយោ បាយ មិន ងាក រេ របស់ ទីក្រុង ប៉េកាំង ក្នុង ការបន្ត ពង្រឹង និង អភិវឌ្ឍ ទំនាក់ទំនង ទ្វេ ភាគី រវាង ប្រទេស ទាំង ពីរ ដែល គ្មាន ថ្ងៃ បែកបាក់ គ្នា ឡើយ » ។
គួរ ជម្រាប ថា ហេតុការណ៍ រញ្ជួយ ដី ខាងលើ បាន កើត មាន ឡើង ខណៈ ដែល តំបន់ ភាគ ខាងលិច ប្រទេស ជប៉ុន ទើបតែ ទទួល រងគ្រោះ ពី ការវាយលុក ដោយ ព្យុះ ទីហ្វុង ដ៏ អាក្រក់ ដែល បាន ផ្តាច់ ជីវិត មនុស្ស ១១នាក់ ៕ អ្នកជំងឺ ខូច តំរង់ នោម មាន ក្តីសង្ឃឹម ហើយ ! មន្ទីរពេទ្យ គ្លីនៀហ្គល (Gleneagles) នៅ ប្រទេស ម៉ាឡេស៊ី ព្យាបាល យ៉ាង មាន ប្រសិទ្ធិភាព ខ្ពស់ សម្រាប់ មនុស្ស គ្រប់ វ័យ
ខួប លើក ទី៧០ នៃ ថ្ងៃ បង្កើត ប្រទេស កូរ៉េ ខាងជើង ចាប់ផ្ដើម ហើយ នៅក្នុង ទីក្រុង ព្យុងយ៉ាង
( សេអ៊ូល ) ៖ មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន នៅ ថ្ងៃអាទិត្យ នេះ បាន បំពេញ ដំណើរទស្សនកិច្ច ទៅកាន់ វិមាន ព្រះអាទិត្យ Kumsusan ក្នុង ទីក្រុង ព្យុងយ៉ាង ខណៈ ប្រជាជន កូរ៉េ ខាងជើង កំពុង ប្រារព្ធ ខួប លើក ទី៧០ នៃ ថ្ងៃ បង្កើត សាធារណរដ្ឋ ប្រជាមានិត
កូរ៉េ ខាងជើង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន យ៉ុន ហាប់ នៅ ថ្ងៃអាទិត្យ ទី០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
( ភ្នំពេញ ) ៖ ខណៈ ឥទ្ធិពល សម្ពាធ ទាប កំពុង កើតមាន នៅលើ អាង ទន្លេ មេគង្គ នោះ ខេត្ត ចំនួន ៨ របស់ កម្ពុជា នឹង មាន ភ្លៀង ធ្លាក់ ជាប់ ៗ គ្នា ចាប់ពី ថ្ងៃទី ១១ - ១៥ ខែកញ្ញា ឆ្នាំ ២០១៨ និង អាច បង្ក ជា ជំនន់ ទឹកភ្លៀង ទៀតផង ។ នេះ បើ ការព្យាករណ៍ អាកាសធាតុ របស់ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ។
ការព្យាករណ៍ បាន បញ្ជាក់ ទៀត ថា ខេត្ត របស់ កម្ពុជា ទាំង ៩ ដែល នឹង មាន ភ្ញៀង ធ្លា ជាប់ ៗ គ្នា នោះ រួម មាន៖ ខេត្ត ឧត្តរមានជ័យ ព្រះវិហារ កំពង់ធំ សៀមរាប បន្ទាយមានជ័យ បាត់ដំបង ពោធិ៍សាត់ និង ខេត្ត កំពង់ឆ្នាំង ។ ហេតុ ដូច្នេះហើយ សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ដើម្បី ជៀសវាង គ្រោះថ្នាក់ នានា ដែល កើត ចេញ ពី គ្រោះ ធម្មជាតិ នេះ ៕
បញ្ចប់ តំណែង មន្រ្តី ថ្នាក់ រដ្ឋលេខាធិការ មួយ រូប . តែងតាំង រដ្ឋលេខាធិការ ២នាក់ នៅ ក្រសួង ធម្មការ និង អនុ រដ្ឋលេខាធិការ ម្នាក់ នៅ ក្រសួង កិច្ចការ នារី
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះនរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ត្រាស់បង្គាប់បញ្ចប់ តំណែង លោក សុះ មុសិន ពី រដ្ឋលេខាធិការ ក្រសួង ធម្មការ និង សាសនា ព្រមទាំង តម្លើង ឋានៈ និង តែងតាំង ឥស្សរជន ០៣ រូប ។
