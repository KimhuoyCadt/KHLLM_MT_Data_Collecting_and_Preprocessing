ក្រុមហ៊ុន ឡាក់ ឃីន បាន ទាក់ទាញ អតិថិជន ជាច្រើន រួចទៅហើយ ក្នុង ប្រទេស ចិន ដោយសារ ប្រព័ន្ធ ទូទាត់ ប្រាក់ ដោយ មិន ប្រើ ក្រដាស ប្រាក់ របស់ ពួកគេ ។
( ហ្សាការតា ) ៖ ទីភ្នាក់ងារ ឧតុនិយម និង ភូមិសាស្ត្រ ឥណ្ឌូណេស៊ី នៅ ថ្ងៃព្រហស្បតិ៍ នេះ បាន ឱ្យដឹង ថា គ្រោះ រញ្ជួយ ដី ថ្មី មួយ ទៀត កម្រិត ៦.២រ៉ិច ទ័រ បាន វាយប្រហារ លើ កោះ លុម បុក ដោយ បង្កឱ្យ អគារ មួយចំនួន រដួលរលំ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃព្រហស្បតិ៍ ទី០៨ ខែសីហា ឆ្នាំ ២០១៨ ។
ប៉ុន្តែ ភ្លាម ៗ មិន ទាន់ មាន ការបញ្ជាក់ ពី ជនរងគ្រោះ នៅឡើយ ទេ ខណៈ គ្រោះ រញ្ជួយ ដី នេះ កើតឡើង តែ ប៉ុន្មាន ថ្ងៃ ប៉ុណ្ណោះ ក្រោយ គ្រោះ រញ្ជួយ ដី ដ៏ ប្រល័យ មួយ កម្រិត ៦. ៩រ៉ិច ទ័រ វាយប្រហារ លើ កោះ ទេសចរណ៍ ដ៏ ល្បី មួយ នេះ កាលពី ថ្ងៃអាទិត្យ កន្លងទៅ ដែល បាន ផ្ដាច់ ជីវិត មនុស្ស កើន ដល់ ៣៤៧ នាក់ និង ១. ៤៧៧ នាក់ រងរបួស ហើយ ១៦៥. ០០៣ នាក់ ត្រូវបាន ជម្លៀស ខ្លួន ចេញ ពី ទីលំនៅ របស់ ពួកគេ ៕
លោក ប៉ែន កុសល្យ បាន លើកឡើង ថា ការប្រកាស តែងតាំង ចូលកាន់ មុខតំណែង នេះ វា ជា បែបបទ នីតិវិធី បាន កំណត់ ក្នុង ច្បាប់ ហើយ ត្រូវបាន យកមក អនុវត្ត ក្នុង ប្រព័ន្ធ រដ្ឋបាល សំដៅ ធ្វើ យ៉ាងណា ឲ្យ ការគ្រប់គ្រង ដឹកនាំ រដ្ឋបាល កាន់តែ មាន ប្រសិទ្ធភាព ក្នុង ការឆ្លើយតប នឹង តម្រូវការ នៅ មូលដ្ឋាន ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ សភា យុវពាណិជ្ជករ អន្តរជាតិ (JCI) កម្ពុជា សាខា ចតុមុខ បាន បញ្ជាក់ ថា សម្រាប់ យុទ្ធនាការ « តោះ យើង នាំគ្នា ដាំ ដើមឈើ ២០១៨ » នេះ ដែរ នឹង ប្រារព្ធ ធ្វើ នៅ ថ្ងៃទី ១៧ ដល់ ១៩ ខែសីហា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ក្នុង តំបន់ កែវ សីមា ខេត្ត មណ្ឌលគិរី ។
តាមរយៈ គម្រោង នេះ អ្នកចូលរួម អាច ទទួលបាន បទពិសោធន៍ ក្នុង ការបោះជំរុំ នៅក្នុង ព្រៃ យ៉ាង ពិតប្រាកដ ព្រមទាំង បង្កើន ការយល់ដឹង ពី ការថែរទាំ ដើមឈើ បរិស្ថាន ធម្មជាតិ និង ជីវភាព រស់ នៅ របស់ ប្រជាជន ក្នុង តំបន់ នោះ ផងដែរ ។ មិន ត្រឹមតែ ប៉ុណ្ណោះ អ្នកចូលរួម ក៏ អាច ជួយ ពិនិត្យមើល ក៏ ដូចជា ថែរក្សា ដើមឈើ ដែល បាន ដាំ រួច ដោយ គម្រោង « តោះ យើង នាំគ្នា ដាំ ដើមឈើ ២០១៧ » និង បន្ដ ការដាំ ដើមឈើ បន្ថែម ទៀត ឲ្យបាន ប្រមាណ ៥០.០០០ ដើម ក្នុង ឆ្នាំ ២០២០ នៅក្នុង សហគមន៍ មូលដ្ឋាន ។
សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នឹង អញ្ជើញ ចែក អំណោយ ជូន ពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ជាង ៣ពាន់ គ្រួសារ នៅ ស្រុក ក្រូចឆ្មារ នៅ ថ្ងៃទី ១១ សីហា
( ត្បូងឃ្មុំ ) ៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០១៨ ខាងមុខ នេះ នឹង អញ្ជើញ ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ជាង ៣ពាន់ គ្រួសារ នៅ ឃុំ ចំនួន ២ ក្នុង ស្រុក ក្រូចឆ្មារ ។ ពិធី នេះ នឹង ត្រូវ ធ្វើឡើង នៅ ទួល ចំការគរ ស្ថិត ក្នុង ភូមិ ទី៥ ឃុំ កំពង់ទ្រាស ស្រុក ក្រូចឆ្មារ ខេត្ត ត្បូងឃ្មុំ ។
ជាក់ស្ដែង នៅ ព្រឹក ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០១៨ នេះ អភិបាល ខេត្ត ត្បូងឃ្មុំ លោក លី ឡេង . អភិបាល រង ខេត្ត លោក ហាក់ សុខ មករា និង លោក ឧត្តមសេនីយ៍ ទោ បែន រ័ត្ន ស្នងការ នគរបាល ខេត្ត ត្បូងឃ្មុំ ចុះ រៀបចំ និង ពិនិត្យ ទីតាំង ប្រារព្ធ ពិធី ដែល ស្ថិត នៅ ភូមិ ឃុំ ខាងលើ ដើម្បី ត្រៀម ទទួល សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល នឹង អញ្ជើញ ចែក អំណោយ និង សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ។
ថ្លែង ប្រាប់ អង្គភាព Fresh News លោក ឧត្តមសេនីយ៍ ទោ បែន រ័ត្ន បាន ឲ្យដឹង ថា សម្រាប់ ឃុំ កំពង់ទ្រាស ស្រុក ក្រូចឆ្មារ ដែល កំពុង រងគ្រោះ ដោយ ទឹក ជំនន់ នេះ មាន ប្រជាពលរដ្ឋ ជាង ២. ៦០០គ្រួសារ ប៉ុន្ដែ ប្រជាពលរដ្ឋ ជាង ៥០០ គ្រួសារ ត្រូវបាន ជម្លៀស មកកាន់ ទី ទួល មាន សុវត្ថិភាព ដែល មាន ទំហំ ដី ប្រមាណ ១ហិចតា ប៉ុណ្ណោះ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ បាន បន្ថែម ថា បច្ចុប្បន្ន នេះ ទួល សុវត្ថិភាព ក៏ កំពុងតែ ប្រឈម នឹង ការលិចលង់ ផងដែរ ប្រសិនបើ ទឹក នៅតែ បន្ដ កើនឡើង ២តឹក ឬ ២. ៥តឹក ទៀត សម្រាប់ ឃុំ កំពង់ទ្រាស ទាំងមូល គ្មាន ទី ទួល សុវត្ថិភាព នោះ ទេ ។ ដោយឡែក មាន ប្រជាពលរដ្ឋ ខ្លះ កំពុងតែ ស្នាក់ នៅ សាលារៀន ឬ វិហារ ឥស្លាម ដែល មិន ទាន់ ទឹក ជន់ លិច ។
សម្រាប់ បញ្ហា ប្រឈម នេះ ត្រូវបាន លោក ឧត្តមសេនីយ៍ បែន រ័ត្ន បញ្ជាក់ ថា នៅ ថ្ងៃទី ១០ ខែសីហា ឆ្នាំ ២០១៨ ស្អែក នេះ លោក នឹង ចាត់ កម្លាំង នគរបាល ចំនួន ១៥០ នាក់ ទៅកាន់ ឃុំ កំពង់ទ្រាស ដើម្បី ទៅ បម្រើ ប្រជាពលរដ្ឋ ដែល កំពុង នៅ ទី ទួល សុវត្ថិភាព និង ជាពិសេស ជួយ ដឹកជញ្ជូន ស្បៀង របស់ កាកបាទ ក្រហម កម្ពុជា ដែល មាន អង្ករ ប្រមាណ ៩០តោន និង សម្ភារៈ ផ្សេង ៗ ទៀត ប្រមាណ ១០០ តោន សម្រាប់ ឧបត្ថម្ភ ជូន ពួកគាត់ ៕
( គែរ )៖ តុលាការ ឧក្រិដ្ឋកម្ម នៃ ប្រទេស អេហ្ស៊ីប បាន សម្រេច ផ្តន្ទាទោស ប្រហារជីវិត មនុស្ស ៤៥ នាក់ ជុំវិញ ការសម្លាប់ បុគ្គល ០៣ រូប នៅក្នុង ការផ្ទុះ អំពើហិង្សា ដោយ អាវុធ នៅ ខេត្ត អាហ្សង់ឌ្រា (Alexandria) ភាគ ខាងជើង ប្រទេស កាលពី ០៦ ឆ្នាំ មុន ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី០៩ ខែសីហា ឆ្នាំ ២០១៨ ។
មនុស្ស ០៤ នាក់ ក្នុង នោះ អ្នក ត្រូវ ប្រហារជីវិត ខាងលើ កំពុង ស្ថិត ក្រោម ការឃុំឃាំង ខណៈ ៤១ នាក់ ផ្សេង ទៀត ត្រូវបាន កាត់ទោស ដោយ កំបាំងមុខ ។ សំណុំរឿង នេះ គឺ បាន កើត មាន ឡើង តាំងតែពី ឆ្នាំ ២០១២ មក ម្ល៉េះ នៅ ពេល ដែល អំពើហិង្សា ដ៏ ធំ មួយ បាន ផ្ទុះឡើង រវាង ក្រុមគ្រួសារ ពី បក្ស ដែល មាន ប្រើប្រាស់ កាំបិត កាំភ្លើង និង ដប ភ្លើង រហូត បណ្តាលឲ្យ មនុស្ស ០៣ នាក់ បាត់បង់ជីវិត ។
យោង តាម ការការបំភ្លឺ ពី ជនរងគ្រោះ និង សាក្សី ចំពោះ ករណី នេះ នគរបាល ក្រុង សៀមរាប សូម បដិសេធ ថា ករណី នេះ មិន មែន ជា ករណី ប្លន់ ដូច ការលើកឡើង របស់ ជនរងគ្រោះ នោះ ឡើយ និង សូម អះអាង ថា ករណី នេះ ជា ករណី ហិង្សា ដែល ផ្តើម ចេញ ពី គ្រោះថ្នាក់ ចរាចរ តែ ប៉ុណ្ណោះ ។ ចំណែក ជនសង្ស័យ ដែល ប្រើ អំពើហិង្សា មក លើ ជនរងគ្រោះ នគរបាល ក្រុង កំពុង ធ្វើ ការស្រាវជ្រាវ កំណត់ អត្តសញ្ញាណ ដើម្បី នាំយក មក ផ្តន្ទាទោស តាម ផ្លូវ ច្បាប់ ៕
ទន្ទឹម នឹង នោះ ឌី ជេ ណាណា ពិធីការ នីល្បី ឈ្មោះ ពូកែ វោហា មិន ចេះ រីងស្ងួត បាន បង្ហាញ អារម្មណ៍ រំភើប សប្បាយរីករាយ ដោយ ក្រុមហ៊ុន ISI STEEL បាន ឧបត្ថម្ភ សាលារៀន ថ្មី មួយ ខ្នង ជំនួស ឲ្យ សាលារៀន ចាស់ ដែល មាន សភាព ទ្រុត ទ្រោម ដំបូល ក៏ រហែក ពេល ភ្លៀង ម្តង ៗ ពិបាក ខ្លាំង ក្នុង ការបន្ត ការរៀនសូត្រ របស់ សិស្សានុសិស្ស នៅ តំបន់ ដាច់ស្រយាល ដោយ មាន អ្នក ខ្លះ ផ្ទះ មាន ចំងាយ ដល់ ទៅ ៧ឬ៨ គីឡូម៉ែត្រ ពី សាលារៀន ថែម ទៀត ផង ។
កាល កន្លងមក សិស្សានុសិស្ស បាន លើកឡើង ពី ផលវិបាក របស់ ខ្លួន ថា « នៅពេល ខ្ញុំ អង្គុយ រៀន មាន មេឃ ភ្លៀង ខ្លាំង ពួកយើង ទទឹក ជោក រក កន្លែង អង្គុយ គ្មាន . មេឃ ក្តៅ ក៏ យើង ពិបាក រៀន . ខ្យល់ ខ្លាំង គឺ យើង មិន ហ៊ាន នៅក្នុង សាលា ទេ ព្រោះ ខ្លាច សាលា រលំ ។ ខ្ញុំ ចង់ ក្លាយជា គ្រូបង្រៀន ហើយ ខ្ញុំ សង្ឃឹម ថា ខ្ញុំ អាច មាន សាលារៀន មួយ សមរម្យ អាច អង្គុយ រៀន បាន ដោយ មិន មាន ការភ័យខ្លាច ទោះ មេឃ ក្តៅ មាន ភ្លៀង ឬ ខ្យល់ ខ្លាំង ។ ខ្ញុំ ពិតជា ត្រូវការ ចំណេះដឹង ខ្លាំង ណាស់ ដើម្បី ជា ទុន សម្រាប់ ជួយ គ្រួសារ ខ្ញុំ » ។
ជុំវិញ បញ្ហា វិវាទ នៃ ប្រទេស ទាំង ពីរ អ្នកវិភាគ ខាងលើ គឺ លោក ស្កុត ប៊ែនណេត (Scott Bennett) បាន លើកឡើង ថា ការ ដែល លោក ត្រាំ បាន ចោទប្រកាន់ អ៊ីរ៉ង់ អំពី ទង្វើ ទុច្ចរិត និង លួច ផ្តល់ ហិរញ្ញប្បទាន ឲ្យ ក្រុម ភេរវករ នោះ គឺ មកពី ការញុះញង់ បញ្ចុះបញ្ចូល ពី សម្ព័ន្ធមិត្ត នៅ មជ្ឈិមបូព៌ា ដូចជា អារ៉ាប៊ី សាអូឌីត និង អ៊ីស្រាអែល ក៏ ដូចជា ពី មន្រ្តី នៅ ទីក្រុង វ៉ាស៊ីនតោន ផ្ទាល់ ដែល តែង ស្រេកឃ្លាន ចង់បាន សង្រ្គាម ។
លោក Bennett បាន បន្ត ថា ពួកគេ ទាំងនោះ តែងតែ បាន ព្យាយាម លាប ពណ៌ អ៊ីរ៉ង់ ថា ជា ប្រភព នៃ អស្ថិរភាព និង ចង់ គ្រប់គ្រង កាន់កាប់ តំបន់ មជ្ឈិមបូព៌ា ទាំងមូល ខណៈ ការពិត វា ទំនងជា អ៊ីស្រាអែល និង អារ៉ាប៊ី សាអូឌីត ទៅ វិញ ទេ ដែល មាន មហិច្ឆតា នេះ ។
ដោយឡែក ដោយសារ ទើបតែ ឡើង កាន់អំណាច ថ្មី ថ្មោង លោក ដូណាល់ ត្រាំ ត្រូវ គេ ខ្សឹប ដាក់ ត្រចៀក ថា អ៊ីរ៉ង់ ជា អ្នកបង្ក អស្ថិរភាព និង ថា អ៊ីរ៉ង់ ជា អ្នក នៅ ពីក្រោយ ក្រុម ភេរវករ ISIS ហើយ លួច ផ្តល់ ហិរញ្ញប្បទាន គាំទ្រ សង្រ្គាម នៅ ស៊ីរី និង តំបន់ ផ្សេង ៗ ទៀត ។ បើ តាម អ្នកវិភាគ រូប នេះ ដដែល ធាតុ ពិតជាក់ស្តែង អ៊ីរ៉ង់ បាន និង កំពុងតែ ប្រឆាំង នឹង ISIS អាល់កៃដា និង ក្រុម ភេរវករ ដែល កំពុង រីកសាយភាព នៅក្នុង អឺរ៉ុប ទៅ វិញ នោះ ទេ ។
ជាថ្មី ម្តង ទៀត សម្តេច នាយក រដ្ឋមន្ត្រី ក៏ មិន ភ្លេច ថ្លែងអំណរគុណ ដល់ បងប្អូន ជូន រួម ជាតិ ដែល បាន ចូលរួម ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ របស់ កម្ពុជា ព្រោះថា សម្តេច តែ ម្នាក់ឯង មិន អាច ធ្វើ បាន ទេ ប្រសិនបើ គ្មាន ការចូលរួម ពី បងប្អូន ជន រួម ជាតិ ។
អរគុណ បងប្អូន ជន រួម ជាតិ ដែល បាន ចូលរួម ថែរក្សា ការពា សិន្តិភាព និង ការអភិវឌ្ឍ ខ្ញុំ ម្នាក់ឯង ក៏ មិន អាច ធ្វើ បាន ដែរ ប្រសិនបើ គ្មាន ការចូលរួម ពី បងប្អូន និង កូនក្មួយ ទាំងអស់ គ្នា ។ ជាថ្មី ម្តង ទៀត ខ្ញុំ សូម អរគុណ បងប្អូន កូនក្មួយ ទូទាំង ប្រទេស ដែល បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន លេខ ២០ ដើម្បី ខ្ញុំ មាន ឱកាស បន្ត អភិវឌ្ឍន៍ ប្រទេសជាតិ យើង អោយ កាន់តែ រីកចម្រើន »៕
