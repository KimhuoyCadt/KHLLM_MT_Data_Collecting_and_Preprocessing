លោក ម៉ាក្រុង បាន ធ្វើការកត់សម្គាល់ បែប នេះ នៅក្នុង សុន្ទរក ថា មាន រយៈពេល ជាង ៩០ នាទី នៅឯ សន្និសីទ អគ្គ រដ្ឋទូត ប្រចាំ ក្នុង ទីក្រុង ប៉ារីស នៅក្នុង សប្ដាហ៍ នេះ ។ ថ្លែង នា ឱកាស នោះ លោក ម៉ាក្រុង បាន លើកឡើង ថា « អឺរ៉ុប ទាំងមូល លែង អាច ពឹងផ្អែក ទាំងស្រុង លើ សហរដ្ឋ អាមេរិក ទៀត ហើយ ដើម្បី ការពារ សន្តិសុខ ជាតិ របស់ ខ្លួន .. . ហើយ ចាប់ពី ឥឡូវនេះ តទៅ វា ពិតជា ចាំបាច់ ដែល អឺរ៉ុប ត្រូវតែ ធានា និង ពឹងផ្អែក លើ ខ្លួន ឯង » ។
អភិបាល ខេត្ត កំពង់ធំ បញ្ចប់ កិច្ចសន្យា ខ្ចី ដី ក្រុមហ៊ុន ត្រឹង សាន ដើម្បី វិនិយោគ ចំណត រថយន្ត និង ស្តង់ លក់ ទំនិញ នៅ ស្រុក សន្ទុក
( កំពង់ធំ )៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ នា ព្រឹក ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ចុះបញ្ចប់ កិច្ចសន្យា ខ្ចី ដី ក្រុមហ៊ុន ត្រឹង សាន ដែល សព្វ ថ្ងៃ នេះ នៅក្នុង ស្រុក សន្ទុក មិន ទាន់ មាន ទី តំាង ចំណត ចត រថយន្ត នៅឡើយ ទេ ហើយ រថយន្ត ចត នៅ តាម ដងផ្លូវ ធ្វើឲ្យ ស្ទះ ចរាចរណ៍ មាន គ្រោះថ្នាក់ ចរាចរណ៍ កើនឡើង ជាញឹកញាប់ ហើយ បងប្អូន អាជីវកម្ម លក់ដូរ មិន មាន របៀបរៀបរយ ផងដែរ ។
លោក បាន បន្ត ទៀត ថា សូម ក្រុមការងារ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ខិតខំ ធ្វើ ការងារ នេះ ឲ្យ បាន ឆាប់ រហ័ស និង ប្រកបដោយ ប្រសិទ្ធភាព ដើម្បី សាងសង់ ចំណត រថយន្ត និង ស្តង់ លក់ ទំនិញ ជូន បងប្អូន អាជីវករ មាន ភាពងាយស្រួល កាត់បន្ថយ ការស្ទះ ចរាចរណ៍ និង ចរចរណ៍ ក្នុង ផ្សារ មិន មាន ការកកស្ទះ ទាំង អ្នកលក់ និង អ្នកទិញ ផងដែរ ។
ជាមួយគ្នា នោះ ដែរ លោក អភិបាល ខេត្ត បាន ជំរុញ ឲ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច បន្ត យកចិត្តទុកដាក់ ចំពោះ សន្តិសុខ សណ្តាប់ធ្នាប់ ទប់ស្កាត់ គ្រឿងញៀន និង ឧក្រិដ្ឋកម្ម ផ្សេង ៗ កែលម្អរភាព អសកម្ម ខិតខំ កសាង អំពើ ល្អ ផ្តល់ សេវា សាធារណៈ ឲ្យ មាន ប្រសិទ្ធភាព ល្អ ( សេវា តម្រូវ ការចាំបាច់ និង សេវា សំណូមពរ នានា ) ជាពិសេស ត្រូវ រួមគ្នា ដោះស្រាយ ទំនាស់ ដីធ្លី ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ឆាប់ រហ័ស និង ទាន់ ពេលវេលា ៕
ធនាគារ ជាតិ នៃ កម្ពុជា នឹង រៀបចំ កិច្ចប្រជុំ ក្រុមការងារ ស្ថិតិ ពាណិជ្ជកម្ម អន្ដរជាតិ ផ្នែក សេវាកម្ម លើក ទី៥ រយៈពេល ៣ ថ្ងៃ ក្នុង ក្រុង សៀមរាប
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា នឹង រៀបចំ កិច្ចប្រជុំ ក្រុមការងារ ស្ថិតិ ពាណិជ្ជកម្ម អន្ដរជាតិ ផ្នែក សេវាកម្ម លើ ទី៥ និង សិក្ខាសាលា ថ្នាក់ តំបន់ ស្តីពី ស្ថិតិ ពាណិជ្ជកម្ម អន្តរជាតិ ផ្នែក សេវាកម្ម រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៨ - ៣១ ខែសីហា ឆ្នាំ ២០១៨ ខាងមុខ ។
កិច្ចប្រជុំ ក្រុមការងារ ស្ថិតិ ពាណិជ្ជកម្ម អន្ដរជាតិ ផ្នែក សេវាកម្ម លើ ទី៥នេះ រៀបចំឡើង ក្រោម ការសហការ ពី លេខាធិការដ្ឋាន អាស៊ាន និង ធនាគារ ជាតិ នៃ កម្ពុជា និង មាន ការចូលរួម ពីសំណាក់ សមាជិក ក្រុមការងារ នៃ បណ្ដា ប្រទេស អាស៊ាន ទាំង១០ និង រៀបចំឡើង ក្នុង ទឹកដី អង្គរ ក្រុង សៀមរាប ។
សូម បញ្ជាក់ ថា ក្រុមការងារ ស្ថិតិ ពាណិជ្ជកម្ម អន្ដរជាតិ ផ្នែក សេវាកម្ម នេះ ត្រូវបាន បង្កើតឡើង ដើម្បី លើកកម្ពស់ ការអភិវឌ្ឍ និង បន្ស៊ី គ្នា នៃ ស្ថិតិ ពាណិជ្ជកម្ម អន្តរជាតិ ផ្នែក សេវាកម្ម ក្នុង គោលដៅ គាំទ្រ ការរៀបចំ គោល នយោបាយ អាស៊ាន ដោយ ផ្អែក លើ ភ័ស្តុតាង ក្នុង ការគ្រប់គ្រង លំហូរ នៃ សេវាកម្ម ក្នុង សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន រវាង សេដ្ឋកិច្ច តំបន់ អាស៊ាន និង ពិភពលោក ៕
( ចិន ) ៖ រដ្ឋាភិបាល ចិន នឹង ពិនិត្យមើល លើ បញ្ហា មួយចំនួន អំពី គ្រឹះស្ថាន សិក្សា ក្រៅ ម៉ោង សាលា រដ្ឋ នៅ ទូទាំង ប្រទេស ចិន នៅ ត្រឹម ដំណាច់ ឆ្នាំ នេះ ដើម្បី កាត់បន្ថយ សម្ពាធ ដ៏ ច្រើន ដែល គ្រឹះស្ថាន សិក្សា ទាំងនោះ បាន ដាក់ ទៅ លើ សិស្ស ។ នេះ បើ យោង តាម ក្រសួង អប់រំ ចិន កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ មុន ។
គ្រឹះស្ថាន អប់រំ ក្រៅពី សាលា រដ្ឋ ចំនួន ៣៨២.០០០ នាក់ គ្រឹះស្ថាន ទូទាំង ប្រទេស ចិន ត្រូវបាន ត្រួតពិនិត្យ បើ គិត ត្រឹម ថ្ងៃទី ២០ ខែសីហា នេះ ។ ក្នុង ចំណោម នោះ មាន ៤៥.០០០ សាលា ត្រូវបាន រកឃើញ ថា មាន បញ្ហា ផ្នែក មើលថែ សិស្សានុសិស្ស ដែល ត្រូវបាន កែតម្រូវ ឡើងវិញ ។ នេះ បើ យោង តាម លោក លូ យូកាង ប្រធាន មន្ទីរ អប់រំ កម្រិត បឋម នៅ ក្រសួង អប់រំ ចិន ។
លោក លូ និយាយ ថា ក្រសួង អប់រំ ចិន នឹង ដោះស្រាយ ចំនុច ទាំងឡាយ ណា ដែល ដាក់ សម្ពាធ បន្ថែម ទៅ លើ សិស្ស ជាច្រើន នាក់ រួម មាន ដូចជា ការបង្រៀន មេរៀន ទាំងឡាយ ណា ដែល ហួស ពី កម្រិត សមត្ថភាព ធម្មតា នៃ អាយុ សិស្ស ក៏ ដូចជា ការខ្វល់ខ្វាយ ខ្លាំង ពេក ទៅ លើ ការបង្រៀន ដែល ដើម្បី តែ ប្រលង ឱ្យ ជាប់ ។
វិធានការ នេះ ត្រូវបាន ដាក់ចេញ ក្រោយពី ការិយាល័យ រដ្ឋបាល នៃ រដ្ឋាភិបាល កណ្តាល ចិន បាន ដាក់ចេញ គោលការណ៍ ណែនាំ កាលពី ថ្ងៃពុធ សប្តាហ៍ មុន ដែល មាន បំណង ចង់ ពង្រឹង ការត្រួតពិនិត្យ លើ គ្រឹះស្ថាន ទាំងឡាយ ណា ដែល ផ្តល់ សេវា អប់រំ ក្រៅ ម៉ោង ឬ ក្រៅពី បរិវេណ សាលារៀន ។
មន្ត្រី ក្រសួង អប់រំ ចិន បាន សង្កត់ បន្ថែម ថា អាជ្ញាធរ អប់រំ នៅ តាម មូលដ្ឋាន ត្រូវតែ គោរព តាម គោលការណ៍ ណែនាំ នេះ ព្រមទាំង បង្កើន ស្តង់ដារ នៃ ការរៀបចំ គ្រឹះស្ថាន អប់រំ ក្រៅ ម៉ោង សាលា រដ្ឋ នៅ ក្នុង តំបន់ របស់ ខ្លួន ឱ្យ បាន ឆាប់ តាម ដែល អាច ធ្វើ ទៅ បាន និង ត្រូវ រៀបចំ ផែនការ និង កាលវិភាគ ឱ្យ បាន ច្បាស់លាស់ តាម ការចាំបាច់ ដើម្បី ដោះស្រាយ បញ្ហា ដែល កើតមាន កាលពី មុន ។
លោក លូ យូកាង ប្រធាន មន្ទីរ អប់រំ កម្រិត បឋម នៅ ក្រសួង អប់រំ ចិន និយាយ ថា « ចំពោះ លក្ខណៈ វិនិច្ឆ័យ ដែល កំណត់ ថា តើ ការបង្រៀន ក្រៅ ម៉ោង សាលា រដ្ឋ ណាមួយ ដើរ ហួរ ពី កម្មវិធី សិក្សា នោះ ពួកយើង នឹង ប្រមូល អ្នកជំនាញ ដែល ពាក់ព័ន្ធ ដើម្បី ត្រួតពិនិត្យ និង វិភាគ ទៅ លើ កាលវិភាគ បង្រៀន ក៏ ដូចជា មាតិកា នៃ វគ្គ សិក្សា ទាំងនោះ ។ ដូច្នេះ យើង ត្រូវតែ អនុវត្ត វិធានការ ដែល មាន ប្រសិទ្ធភាព ដើម្បី ចង្អុលបង្ហាញ ផ្លូវ ដល់ គ្រឹះស្ថាន អប់រំ ទាំងនេះ » ។
ក្រសួង អប់រំ ចិន ក៏ បាន ឱ្យដឹង ដែរ ថា ខ្លួន នឹង ផ្តល់ យោបល់ ដល់ អាជ្ញាធរ មូលដ្ឋាន អំពី ការផ្តល់ សេវា ក្រៅ ម៉ោង សិក្សា ដែល ជំនួស ឱ្យ ការបង្រៀន ថែម ម៉ោង ឬ រៀន គួរ សម្រាប់ សិស្ស ថ្នាក់ បឋម និង មធ្យម ។ ក្រសួង ក៏ នឹង ធ្វើ កំណែទម្រង់ ផ្នែក បង្រៀន ឱ្យ កាន់តែ ស៊ីជម្រៅ ផងដែរ ដើម្បី លើកស្ទួយ ឱ្យ ការបង្រៀន នៅ តាម ថ្នាក់រៀន កាន់តែ មាន ប្រសិទ្ធភាព និង គុណភាព ៕ ( សារព័ត៌មាន CCTV របស់ ចិន )
រដ្ឋបាល ខេត្ត ប៉ៃលិន រៀបចំ សិក្ខាសាលា ស្តីពី « វប្បធម៌ បង់ ពន្ធ និង បទប្បញ្ញត្តិ ស្តីពី ពន្ធដារ ជូន ដល់ ម្ចាស់ សហគ្រាស ក្រុមហ៊ុន និង អាជីវករ ទូទាំង ខេត្ត ប៉ៃលិន »
( ប៉ៃលិន ) ៖ រដ្ឋបាល ខេត្ត ប៉ៃលិន បាន រៀបចំ សិក្ខាសាលា ផ្សព្វផ្សាយ ស្តីពី « វប្បធម៌ បង់ ពន្ធ និង បទប្បញ្ញត្តិ ស្តីពី ពន្ធដារ » ជូន ដល់ ម្ចាស់ សហគ្រាស ក្រុមហ៊ុន និង អាជីវករ ទូទាំង ខេត្ត ប៉ៃលិន ក្នុង គោលដៅ បង្កើន ចំណូល ថវិកា ជាតិ និង ផ្តោត ការយកចិត្តទុកដាក់ ខ្ពស់ លើ ការពង្រឹង ការអនុវត្ត ច្បាប់ និង បទប្បញ្ញត្តិ ទាំងឡាយ ដែល ចូល ជាធរមាន ឱ្យ ស្រប តាម គោល នយោបាយ កែទម្រង់ ស៊ីជម្រៅ ដ៏ មុត ស្រួច របស់ រាជ រដ្ឋាភិបាល ។
ពិធី នេះ ប្រព្រឹត្ត ឡើង ក្រោម វត្តមាន លោក អឿ សំរិទិ្ធ តំណាង របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ . លោក ឡី ចាន់ ឆាយ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ចេង ញ៉ាន់ អភិបាល រង ខេត្ត ប៉ៃលិន រួម ជាមួយ លោក លោកស្រី អភិបាល រង ក្រុង / ស្រុក ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត លោក មេឃុំ / ចៅសង្កាត់ ម្ចាស់ សហគ្រាស ក្រុមហ៊ុន និង អាជីវករ ជាច្រើន នាក់ នៅ សាលា ខេត្ត ប៉ៃលិន នា ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ ម្សិលមិញ ។
នៅក្នុង ឱកាស នោះ លោក ក៏ បាន សំនូម ដល់ អង្គភាព ជាប់ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ចងចាំ ពី អភិក្រមទាំង ៥ របស់ សម្តេច តេ ជោ សែន គឺ ងូតទឹក ដុស ក្អែល ឆ្លុះ កញ្ចក់ ព្យាបាល និង វះកាត់ សំដៅ ធ្វើ យ៉ាងណា ផ្តល់ សេវា ជូន អ្នក ជាប់ ពន្ធ ឱ្យ បាន ល្អ ងាយស្រួល ក្នុង ការបង់ ពន្ធ ជូន រដ្ឋ ឱ្យ មាន ប្រសិទ្ធិភាព ខ្ពស់ ព្រមទាំង ត្រូវ ចេះ សាមគ្គី សហការ ឯកភាព និង ខិតខំ បំពេញ ការងារ ឱ្យ បាន ត្រឹមត្រូវ ទៅ តាម តួនាទី ភារៈកិច្ច របស់ ខ្លួន អោយ ទទួលបាន ជោគជ័យ ។
សូម បញ្ជាក់ ថា បើ តាម ការធ្វើ បទបង្ហាញ របស់ ភ្នាក់ងារ ពន្ធដារ គឺ តាម សហគ្រាស ក្រុមហ៊ុន អាជីវករ និង ប្រជាពលរដ្ឋ និង មន្ត្រីរាជការ ទាំងអស់ ត្រូវតែ មាន កាតព្វកិច្ច បង ពន្ធ ជូន រដ្ឋ គ្រប់ ៗ គ្នា ហើយ ត្រូវ ប្រកាស ស្នើរ សុំ ការចុះបញ្ជី រ ដោយ ផ្ទាល់ នៅ ស្នាក់ការសាខា ពន្ធដារ ក្នុង ខេត្ត របស់ ខ្លួន ដើម្បី បង់ ពន្ធ ។
( ហាណូយ ) ៖ របាយការណ៍ ថ្មី មួយ បាន ឱ្យដឹង ថា បុរស ជនជាតិ វៀតណាម ទាំងឡាយ តែង និយម ផឹក ស្រា ដែល មាន ជាតិ អាល់កុល ទាំង ០៥ កម្រិត ក្នុង មួយ ថ្ងៃ ៗ តែ ម្តង ហើយ ដែល ចំនួន នេះ គឺ ស្ថិត ក្នុង កម្រិត ខ្ពស់ បំផុត ប្រចាំ តំបន់ អាស៊ី ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃអង្គារ ទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ ។
ភាពខុសប្លែក គ្នា នោះ ត្រូវបាន លោក អ៉ិន ចាន់ នី ប្រធាន នាយក ប្រតិបត្តិ ធនាគារ អេស៊ីលីដា ពន្យល់ ថា នៅ ក្រោយ ការបោះឆ្នោត អាណត្តិ មុន ( អាណត្តិ ទី៥) ប្រជាពលរដ្ឋ សម្រុក ដក លុយ ចេញ ពី ធនាគារ តែ សម្រាប់ ការបោះឆ្នោត អាណត្តិ នេះ វិញ ប្រជាពលរដ្ឋ មិន ត្រឹមតែ មិន បាន ដក ប្រាក់ របស់ ខ្លួន ទេ ថែមទាំង នាំគ្នា ទៅ ដាក់ ប្រាក់ កាន់តែ ច្រើ ឡើង ។
គេ នៅ ចាំ បាន ថា ក្រោយ ការបោះឆ្នោត នៅ អាណត្តិ ទី៥ ស្ថានភាព នយោបាយ និង សង្គម នៅ កម្ពុជា មាន ភាពវឹកវរ យ៉ាង ខ្លាំង ដោយសារ គណបក្ស ប្រឆាំង មិន ព្រម ទទួលយក លទ្ធផល នៃ ការបោះឆ្នោត បង្កឲ្យ មាន បាតុកម្ម កូដកម្ម ពាសពេញ រាជធានី ភ្នំពេញ ដែល នាំ ប្រជាពលរដ្ឋ ព្រួយបារម្ភ ខ្លាំង ពី សុវត្ថិភាព ប្រាក់ របស់ ពួកគាត់ ។
លោក អ៉ិន ចាន់ នី បញ្ជាក់ ថា ភាព នឹង ធឹង និង ស្ថេរភាព នយោបាយ ដ៏ រឹងមាំ និង ល្អប្រសើរ នេះ នឹង ជួយ ទាក់ទាញ ការវិនិយោគ ពី បណ្ដា ប្រទេស ផ្សេង ទៀត ចូលមក វិនិយោគ ។
ចំពោះ បរិយាកាស វិនិយោគ នៅ កម្ពុជា ក្រោយ ការបោះឆ្នោត វិញ លោក អ៉ិន ចាន់ នី ក៏ បាន បញ្ជាក់ ថា គ្មាន អ្វី ប្រែប្រួល នោះ ទេ ។ លោក ថា មុននឹង វិនិយោគិន ម្នាក់ សម្រេចចិត្ត មក វិនិយោគ ក្នុង ប្រទេស ណាមួយ គេ ត្រូវ មើល ទៅ លើ កត្តា ធំ ៗ ចំនួន ៣យ៉ាង រួម មាន៖ ១៖ កត្តា ស្ថេរភាព នយោបាយ . ២៖ កត្តា ស្ថេរភាព សេដ្ឋកិច្ច . ៣៖ កត្តា ស្ថេរភាព សង្គមកិច្ច ។
លោក បាន បញ្ជាក់ ទៀត ថា សម្រាប់ ប្រទេស កម្ពុជា ច្បាប់ វិនិយោគ ល្អ ជាង គេ ហើយ ក្នុង តំបន់ អាស៊ាន នេះ មាន ន័យ ថា វិនិយោគិន បរទេស អាច កាន់កាប់ ភាគហ៊ុន ក្នុង អាជីវកម្ម នេះ បាន ១០០ ភាគរយ លើកលែងតែ បញ្ហា ដី ប៉ុណ្ណោះ តែ ចំពោះ អាជីវកម្ម មិន ចាំបាច់ តម្រូវឲ្យ មាន អ្នកចូល ហ៊ុន ទេ តែ អាច កាន់កាប់ ដោយ ខ្លួន ឯង បាន ។ ពួកគេ អាច យក ប្រាក់ ចំណេញ ទៅ ប្រទេស គេ វិញ ដោយ មិន ស្មុកស្មាញ ឡើយ គ្មាន ច្បាប់ ណាមួយ ហាមឃាត់ នោះ ឡើយ ៕
លោក សួស យ៉ារ៉ា ដឹកនាំ ក្រុមការងារ យក អំណោយ ប្រគល់ ជូន ប្រជាពលរដ្ឋ ៦០០ គ្រួសារ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ស្រុក បុរី ជលសារ ខេត្ត តាកែវ
( តាកែវ )៖ លោក សួស យ៉ារ៉ា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក បុរី ជលសារ និង លោក អ៊ូច ភា អភិបាល ខេត្ត តាកែវ និង ក្រុមការងារ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ចុះ ជួយ អន្តរាគមន៍ ផ្តល់ ជំនួយ ឧបត្ថម្ភ ដល់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ស្រុក បុរី ជលសារ ខេត្ត តាកែវ ចំនួន ៦០០ គ្រួសារ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក អ៊ូច ភា អភិបាល ខេត្ត តាកែវ បាន បញ្ជាក់ ថា ឆ្នាំ នេះ កម្ពស់ ទឹក បាន ឡើង ខ្ពស់ ជាង ឆ្នាំ មុន១ម៉ែត្រ នៅក្នុង ពេល ដូចគ្នា ដែល បណ្តាលឲ្យ មាន ការលិចលង់ ផ្ទះសម្បែង និង ដំណាំ ដាំដុះ នានា របស់ ប្រជាពលរដ្ឋ ដែល លោក បាន ជំរុញ អាជ្ញាធរ ស្រុក ឃុំ ចុះ ជួយ ពលរដ្ ជា ប្រចំា និង ត្រៀមលក្ខណៈ អន្តរាគមន៍ ប្រសិន មាន ករណី បន្ទាប់ ៗ ប៉ុន្ដែ ប្រជាពលរដ្ឋ ក៏ ត្រូវតែ បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ពិសេស ត្រូវ មើលថែ កូន ចៅ តូច ៗ កុំ ឲ្យ ចុះ លេង ទឹក ផ្តេសផ្តាស ដែល នាំឲ្យ មាន គ្រោះថ្នាក់ ជា យថាហេតុ ។
បន្ថែម ពី នេះ លោក សួស យ៉ារ៉ា បាន លើកឡើង ថា ការផ្តល់ អំណោយ សង្គ្រោះ បន្ទាន់ នេះ ដែល មាន ស្បៀង អាហារ បម្រុង ថ្នាំ ពេទ្យ សម្ភារ ប្រើប្រាស់ ប្រចំា ថ្ងៃ នេះ បាន ធ្វើឡើង តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន លើកឡើង ថា នៅ ក្រោយ ការបោះឆ្នោត ទោះបី រដ្ឋសភា រាជ រដ្ឋាភិបាល ថ្មី មិន ទាន់ កើតឡើង ជា ផ្លូវការ ក្តី តែ មន្រ្តី ថ្នាក់ដឹកនាំ ស្ថាប័ន ក្រសួង ទំាង អស់ ត្រូវ ចុះ មូលដ្ឋាន បម្រើ ប្រជាពលរដ្ឋ ដោះស្រាយ បញ្ហា ជួន ប្រជាពលរដ្ឋ ដោយ មិន គិត ពី និន្នាការ នយោបាយ នោះ ឡើយ ។
លោក សួស យ៉ារ៉ា បាន សង្កត់ធ្ងន់ ថា សម្តេច តេជោ ហ៊ុន សែន តែងតែ យកចិត្តទុកដាក់ ដល់ ការលំបាក របស់ ប្រជាពលរដ្ឋ ប្រទេស ពេលវេលា គ្រប់ កាលៈទេសៈ ជាក់ស្ដែង នៅក្នុង អាណត្តិ ទី៦ នេះ នៅ ស្រុក បុរី ជលសារ នឹង ទទួលបាន ផ្លូវ បេតុង រហូតដល់ ព្រំប្រទល់ ប្រទេស វៀតណាម ជា ផ្លូវ ដែល ជា ចំណង ដៃ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ជូន ដល់ ប្រជាពលរដ្ឋ ផងដែរ ។
សូម បញ្ជាក់ ថា បើ តាម អាជ្ញាធរ មូលដ្ឋាន កម្ពស់ ទឹក ដែល បាន ឡើង យ៉ាង គំហុក ប៉ុន្មាន ថ្ងៃ នេះ បាន ធ្វើឲ្យ ប៉ះពាល់ ស្រូវ ប្រាំង ដី ដំណាំ ផ្ទះសម្បែង ប្រជាពលរដ្ឋ ចំនួន ៦២០ គ្រួសារ នៅក្នុង ស្រុក បុរី ជលសារ ។ ក្នុង នោះ ពលរដ្ឋ ៩គ្រួសារ បាន ជម្លៀស ទៅកាន់ កន្លែង មាន សុវត្ថិភាព ហើយ ពលរដ្ឋ ទំាង ៦២០ គ្រួសារ បាន មក ទទួល អំណោយ សង្គ្រោះ បន្ទាន់ និង ការសាកសួរ សុខទុក្ខ ពីសំណាក់ ថ្នាក់ដឹកនាំ អាជ្ញាធរ ជា បន្តបន្ទាប់ ៕
( ប៉ៃលិន ) ៖ លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ បាន ប្រគល់ រថយន្ត សង្គ្រោះ ១គ្រឿង ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ដល់ មន្ទីរ សុខាភិបាល ខេត្ត ដើម្បី បម្រើ ដល់ វិស័យ សុខាភិបាល ។
ក្នុង ឱកាស នោះ លោក ផាន់ ចាន់ ធុល បាន លើកឡើង ថា ដោយសារ រថយន្ត សង្គ្រោះ នៅ ខេត្ត ប៉ៃលិន មិន ទាន់ គ្រប់គ្រាន់ តាម តម្រូវការ . សម្តេច ក្រឡាហោម ស ខេង បាន ផ្តល់ រថយន្ត សង្គ្រោះ ១គ្រឿង ដល់ មន្ទីរ សុខាភិបាល ខេត្ត ដើម្បី បម្រើ ដល់ វិស័យ សុខាភិបាល ។ លោក បន្ត ថា រថយន្ត សង្គ្រោះ នេះ មាន សារៈសំខាន់ ណាស់ សម្រាប់ ជួយ ប្រជាពលរដ្ឋ ដែល មាន ជំងឺ ផ្សេង ៗ ដឹក ទៅកាន់ មន្ទីរពេទ្យ បាន ទាន់ ពេលវេលា និង ក្នុង គ្រា មាន អាសន្ន ផងដែរ ។
បើ តាម ការបញ្ជាក់ របស់ លោកគ្រូពេទ្យ អាង នាង ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ប៉ៃលិន បាន ឱ្យដឹង ថា បច្ចុប្បន្ន នៅ ខេត្ត ប៉ៃលិន មាន រថយន្ត សង្គ្រោះ របស់ រដ្ឋ ចំនួន ០៤ គ្រឿង ក្នុង នោះ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ចំនួន ០៣ គ្រឿង និង មណ្ឌល សុខភាព ភ្នំ ព្រាល ០១ គ្រឿង សរុប ទាំង អំណោយ របស់ សម្តេច ក្រឡាហោម មាន ចំនួន ០៥ គ្រឿង ៕
អ្នកនាំពាក្យ៖ ការទាមទារ ឱ្យ បក្ស សង្រ្គោះ ជាតិ រស់ ឡើងវិញ របស់ ទណ្ឌិត សម រង្ស៊ី គឺជា ការស្រមើលស្រមៃ ដ៏ ឆ្គួតលីលា (video inside) ( ភ្នំពេញ ) ៖ អ្នកនាំ គណបក្ស ប្រជាជន កម្ពុជា លោក សុខ ឥសាន នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន លើកឡើង ថា ការទាមទារ ឱ្យ បក្ស សង្រ្គោះ ជាតិ រស់ ឡើងវិញ និង ការទាមទារ លក្ខខណ្ឌ មួយ ចំនួន ទៀត របស់ ទណ្ឌិត សម រង្ស៊ី មេ ចលនា សង្គ្រោះ ជាតិ គឺជា ការស្រមើលស្រមៃ មួយ ដ៏ ឆ្គួតលីលា ដោយសារតែ ការរំលាយ គណបក្ស នេះ គឺ អនុវត្ត ទៅតាម ច្បាប់ របស់ កម្ពុជា ។
អ្នកនាំពាក្យ រូប នេះ បាន បន្ថែម ទៀត ថា៖ « នៅពេល ឃើញ ការលើកលែង ទោស ដល់ ជន ជាប់ចោទ និង ទណ្ឌិត មួយចំនួន ដោយ ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្សត្រ កម្ពុជា តាម សំណើរ ទូល ថ្វាយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បែរជា ទណ្ឌិត សម រង្សី ដែល មាន ទោស ជាប់ ខ្លួន បាន ដាក់ លក្ខខណ្ឌ មក លើ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ទៅ វិញ » ។
លោក សុខ ឥសាន បាន បញ្ជាក់ ថា ដូច្នេះ ការលើកឡើង របស់ ទណ្ឌិត សម រង្សី វា គ្រាន់តែ ជា ការស្រមើស្រមៃ ដេក យល់សប្តិ ដែល មិន អាច ក្លាយជា ការពិត ឡើយ និង ជាដាច់ខាត ៕
ប្រតិភូ ខេត្ត កំពង់ស្ពឺ ចូលរួម សន្និសីទ អន្តរជាតិ លើក ទី ៣២« ភាពជា អ្នកដឹកនាំ » និង បាន គៀង គរ អ្នក វិនិយោគ មក អភិវឌ្ឍន៍ នៅ ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ដឹកនាំ ប្រតិភូ ចូលរួម សន្និសីទ អន្តរជាតិ លើក ទី ៣២« ភាពជា អ្នកដឹកនាំ » នា ឱកាស នោះ ដែរ លោក បាន ជួប សម្ដែង ការគួរសម ជាមួយ លោក ឡុង ឌីម៉ង់ ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ នៅ សាធារណរដ្ឋ កូរ៉េ ហើយ ក្នុង ជំនួប នោះ ថ្នាក់ដឹកនាំ ទាំង ពីរ បាន ពិភាក្សា គ្នា ជំរុញ ឲ្យ អ្នក វិនិយោគទុន កូរ៉េ មក វិនិយោគ នៅ ខេត្ត កំពង់ស្ពឺ ផងដែរ ។
បើ តាម សម្តី របស់ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ឲ្យដឹង នៅ រសៀល ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ តាម ប្រព័ន្ធ Telegram ពី សាធារណរដ្ឋ កូរ៉េ បាន ឲ្យដឹង ថា លោក បាន ជួប ពិភាក្សា គ្នា ដោយ ផ្ទាល់ ដើម្បី រិះរក ជំរុញ និង អូសទាញ អ្នក វិនិយោគទុន កូរ៉េ មក ធ្វើ ការ វិនិយោគ នៅ ខេត្ត កំពង់ស្ពឺ ឲ្យ កាន់តែ ច្រើន ថែម ទៀត ជាពិសេស ពាក់ព័ន្ធ នឹង វិស័យ បច្ចេកវិទ្យា និង ការនាំចេញ ដំណាំ ស្វាយ និង សាច់ មាន់ មក កូរ៉េ ។ល ។
( ស្វាយរៀង ) ៖ លោក រស់ ផារិទ្ធ អភិបាល រង ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ណែនាំ ដល់ មន្ត្រីរាជការ ត្រូវតែ បំរើ សេវា ជូន ប្រជាពលរដ្ឋ ដោយ ស្មោះត្រង់ មាន តម្លាភាព និង គណនេយ្យភាព ។
កាថ្លែង បែប នេះ ខណៈ ដែល លោក បាន ដឹកនាំ កិច្ចប្រជុំជម្រុញ ដល់ ការផ្តល់ សេវា របស់ មន្ត្រី នៅ ច្រក ចេញ ចូល តែ មួយ ខេត្ត ជូន ដល់ ពលរដ្ឋ ឱ្យ បាន ល្អ ប្រសើរ នៅ សាល ប្រជុំ សាលា ខេត្ត ស្វាយរៀង ពិធី នេះ ដែល ក៏ មាន មន្ត្រី ពាក់ព័ន្ធ ចូលរួម ជាច្រើន រូប ផងដែរ ។
លោក អភិបាល រង ខេត្ត រូប នេះ ក៏ បាន ធ្វើ ការជម្រុញ ដល់ ប្រធាន អនុប្រធាន និង មន្ត្រី ជួរ មុខ មន្ត្រី ជួរ ក្រោយ នៃ អង្គភាព ច្រក ចេញ ចូល តែ មួយ ខេត្ត ត្រូវ ខិតខំ យកចិត្តទុកដាក់ បំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន ឲ្យបាន ល្អ ប្រសើរ ស្រប តាម ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ជាពិសេស ត្រូវ មាន ការសហការ និង សាមគ្គីភាព គ្នា រវាង គ្រប់ អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ ដើម្បី អង្គភាព ដំណើរការ ទៅ បាន ដោយ រលូន ធានា ឲ្យ ការផ្ដល់ សេវា ជូន ប្រជាពលរដ្ឋ បាន ត្រឹមត្រូវ និង ឆាប់រហ័ស មិន បង្ក ការកកស្ទះ ក្នុង ការផ្ដល់ សេវា ។
( កំពង់ចាម ) ៖ លោក ហ៊ុន ណេង សមាជិក គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា អ្នកតំណាងរាស្ត្រ មណ្ឌល កំពង់ចាម និង ជា ប្រធាន កិត្តិយស កាកបាទ ក្រហម សាខា ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ អញ្ជើញ សំណេះសំណាល និង ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ទន្លេ មេគង្គ ចំនួន ២. ៣៤០គ្រួសារ នៅ ឃុំ ខ្ពប តា ងួន ស្រុក ស្ទឹងត្រង់ ។
ប្រជាពលរដ្ឋ រងគ្រោះ បាន ថ្លែងអំណរគុណ ដល់ កាកបាទ ក្រហម កម្ពុជា តាមរយៈ លោក ហ៊ុន ណេង ជាពិសេស សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា តែងតែ គិតគូរ សុខទុក្ខ និង ចែករំលែក នូវ ក្ដី ស្រលាញ់ មួយ នេះ ជូន ដល់ ប្រជាពលរដ្ឋ គ្រប់ ៗ រូប ដោយ មិន ប្រកាន់ រើស អើង វណ្ណៈ ជាតិ សាសន៍ ពណ៍ សម្បុរ ឬ និន្នាការ នយោបាយ អ្វី ឡើយ ៕
វិទ្យាស្ថាន ជាតិ សង្គមកិច្ច បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី « កិច្ច គាំពារ សង្គម » ចូលរួម រួម អនុវត្ត ក្របខ័ណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម
( ភ្នំពេញ ) ៖ ដើម្បី ចូលរួម អនុវត្ត ក្របខ័ណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ឆ្នាំ ២០១៦ - ២០២៥ វិទ្យាស្ថាន ជាតិ សង្គមកិច្ច នឹង បើក វគ្គ បណ្តុះបណ្តាល មួយ ស្តីពី « កិច្ច គាំពារ សង្គម » ចាប់ពី ថ្ងៃទី ២៤ ដល់ ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
វិទ្យាស្ថាន ជាតិ សង្គមកិច្ច បាន រៀបចំ កម្មវិធី បណ្តុះបណ្តាល នេះ ឡើង ក្នុង គោលបំណង ដើម្បី កសាង សមត្ថភាព របស់ តួអង្គ ពាក់ព័ន្ធ ជាពិសេស ប្បញ្ញាត្តិករ និង ប្រតិបត្តិករ ដែល ទទួលបន្ទុក អនុវត្ត គោល នយោបាយ ដែល មាន គោលបំណង កាត់បន្ថយ ភាពក្រីក្រ ប្រយុទ្ធ ប្រឆាំង ហានិភ័យ នានា លើកកម្ពស់ សុខ មាលភាព សង្គម និង កំណើន សេដ្ឋកិច្ច ។
វគ្គ បណ្តុះបណ្តាល ស្តីពី « កិច្ច គាំពារ សង្គម » នេះ នឹង សិក្សា លើ ប្រធានបទ សំខាន់ ៗ មួយចំនួន រួម មាន៖
១៖ ទ្រឹស្តី និង ទស្សនទាន នៃ កិច្ច គាំពារ សង្គម ជំនួស សង្គម និង ការធានារ៉ាប់រង សង្គម
២៖ គោលការណ៍ និង អត្ថប្រយោជន៍ នានា នៃ កិច្ច គាំពារ សង្គម
៣៖ ហានិភ័យ សង្គម និង ប្រព័ន្ធ សុវត្ថិភាព សង្គម
៤៖ ការផ្តល់ ហិរញ្ញា វត្ថុ សម្រាប់ គាំពារ សង្គម
៥៖ ការធានារ៉ាប់រង សុខភាព និកម្មភាព សោធន ទុព្វលភាព និង គ្រោះថ្នាក់ ការងារ
៦៖ បញ្ហា អន្តរ វិស័យ នានា ក្នុង កិច្ច គាំពារ សង្គម និង ករណី សិក្សា អំពី កិច្ច គាំពារ សង្គមជាតិ និង អន្តរជាតិ ៕ អភិបាល ក្រុង ខេមរភូមិន្ទ ខេត្ត កោះកុង ចេញមុខ បកស្រាយ រឿង បញ្ហា សំរាម ក្រោយ មាន ការរិះគន់ ពីសំណាក់ មហាជន
( កោះកុង ) ៖ លោក ឈេង សុវណ្ណ ដា អភិបាល ក្រុង ខេមរភូមិន្ទ បាន ចេញមក បកស្រាយ នូវ បញ្ហា សំរាម ដែល ស្អុយ រលួយ ក្នុង ក្រុង ខេមរភូមិន្ទ ។ ការបកស្រាយ នេះ បាន ធ្វើឡើង ក្រោយ មាន ការរិះគន់ ពី សំណាក់ មហាជន ដោយ លោក បាន ទទួលស្គាល់ ការរិះគន់ នេះ តែ អ្វី ដែល សំខាន់ គឺ មកពី ក្រុមហ៊ុន ចាស់ មិន គោរព កិច្ចសន្យា ក្នុង ប្រមូល ឱ្យ ទាន់ ពេលវេលា ហើយ ម៉្យាងទៀត រយៈពេល ប៉ុន្មាន ខែ នេះ មាន ភ្លៀវ ធ្លាក់ រាល់ ថ្ងៃ ដែល ធ្វើឱ្យ ក្រុមហ៊ុន ចាស់ មិន អាច ដំណើរការ បាន ។
វា នឹង ក្លាយជា ដំណើរទស្សនកិច្ច ផ្លូវការ លើក ដំបូង របស់ លោកស្រី ទៅកាន់ ទ្វីប អាហ្វ្រិក ចាប់តាំងពី លោកស្រី បាន ក្លាយជា មេដឹកនាំ អង់គ្លេស នៅក្នុង ឆ្នាំ ២០១៦ ។
លោកស្រី May ដែល មាន ការ អម ដំណើរ ដោយ រដ្ឋមន្ត្រី ជាច្រើន រូប និង អ្នកតំណាង អាជីវកម្ម ចំនួន ២៩ រូប មកពី ផ្នែក ផ្សេង ៗ ក្នុង វិស័យ ឧស្សាហកម្ម នឹង ធ្វើដំណើរ ទៅកាន់ ប្រទេស អាហ្វ្រិក ខាងត្បូង . នីហ្សេរីយ៉ា និង កេន យ៉ា ក្នុង ដំណើរទស្សនកិច្ច ផ្លូវការ រយៈពេល ០៣ ថ្ងៃ ។
លោកស្រី May បាន ឲ្យដឹង នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា « ខណៈ យើង រៀបចំ ចាកចេញ ពី សហភាព អឺរ៉ុប ឥឡូវ គឺជា ពេលវេលា សម្រាប់ ចក្រភព អង់គ្លេស ក្នុង ការពង្រីក និង ពង្រឹង ទំនាក់ទំនង ក្នុង ភាពជាដៃគូ ជា សកល របស់ ខ្លួន » ។
គួរ ជម្រាប ថា សារព័ត៌មាន ខាងលើ មិន បាន ចេញផ្សាយ ឲ្យបាន ច្បាស់លាស់ នូវ ថ្ងៃ នៃ ការធ្វើដំណើរទស្សនកិច្ច របស់ លោកស្រី នាយក រដ្ឋមន្ត្រី នោះ ទេ គ្រាន់តែ ប្រាប់ ឲ្យដឹង ថា នៅក្នុង សប្តាហ៍ នេះ តែម្តង ៕
ម៉ូតូ បុក ម៉ូតូ លាន់ ស្នូរ ដូច រន្ទះ ស្លាប់ ម្នាក់ និង របួស ធ្ងន់ - ស្រាល ២នាក់ នៅ ក្រុង បាវិត ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ បុរស ម្នាក់ បាន ស្លាប់ ភ្លាម ៗ នៅ កន្លែង កើត ហេតុ ដោយឡែក ស្ត្រី ម្នាក់ និង បុរស ម្នាក់ ផ្សេង ទៀត បាន រងរបួស ធ្ងន់ - ស្រាល នៅក្នុង ករណី គ្រោះថ្នាក់ ចរាចរណ៍ រវាង ម៉ូតូ បុក ជាមួយនឹង ម៉ូតូ ។
ហេតុការណ៍ ខាង លើ នេះ បាន កើតឡើង នៅ ល្ងាច ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ នៅលើ ផ្លូវ ជាតិ លេខ១ ត្រង់ ចំនុច គីឡូម៉ែត្រ លេខ ១៥៧ - ១៥៨ ស្ថិត ក្នុង ភូមិ ត្រពាំង ផ្លុង សង្កាត់ បាទី ក្រុង បាវិត ខេត្ត ស្វាយរៀង ។
សព ជនរងគ្រោះ ត្រូវបាន សមត្ថកិច្ច ធ្វើ កំណត់ហេតុ ប្រគល់ជូ ន ក្រុមគ្រួសារ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ខ្មែរ និង ជនរងគ្រោះ ត្រូវបាន ក្រុមគ្រួសារ យក ទៅ ព្យាបាល នៅពេទ្យ ពន្លឺ បូព៌ា បាវិត ។ រីឯ វត្ថុតាង ទាំង០២ គ្រឿង សមត្ថកិច្ច បាន យក ទៅ រក្សាទុក នៅ អធិការដ្ឋាន នគរបាល ក្រុង បាវិត ដើម្បី បំពេញ សំណុំរឿង តាម និតិវិធី ច្បាប់ ៕ អតីត យុទ្ធជន ម្នាក់ នៅ ខេត្ត កំពង់ធំ បាន កសាង ជីវភាព ធូរធា បន្ទាប់ពី ទទួលបាន អំណោយ ផ្ទះ ពី សម្តេច តេជោ ហ៊ុន សែន
ក្រោយ ទទួលបាន ផ្ទះ ថ្មី ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្ដេច តេជោ ហ៊ុន សែន រយៈពេល ជិត មួយ ឆ្នាំ កន្លងមក នៅលើ ផ្ទៃដី ទំហំ ២. ១៥០ម៉ែត្រ ការ៉េ ដែល បាន ទិញ ពី ប្រជាពលរដ្ឋ ក្រោយ ទទួលបាន ប្រាក់ គោល នយោបាយ ចេញ ពី ជួរ កងទ័ព លោក យ៉េត ហុន និង ភរិយា បាន ខិតខំ ដាំ បន្លែ បង្ការ ផ្សេង ៗ ដោះស្រាយ ជីវភាព ប្រចាំ ថ្ងៃ របស់ គ្រួសារ បាន ល្អ ប្រសើរ រួម ជាមួយ ប្រាក់ បៀវត្សរ៍ ប្រចាំ ខែ ដែល រាជ រដ្ឋាភិបាល ផ្តល់ ជូន គាត់ ក្នុង មួយ ខែ ៗ ចំនួន ១.៧៩០.០០០ រៀល ផងដែរ ។
ដើម្បី ជា ការលើកទឹកចិត្ត ដល់ អតីត ថ្នាក់ដឹកនាំ អង្គភាព ដែល ស្ទើរតែ មួយ ជីវិត ស្ថិត នៅក្នុង ជីវភាព ជា កងទ័ព ជាក់ស្តែង នៅ ល្ងាច ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត បាន ដឹកនាំ សហការី ទៅ ជួប សំណេះសំណាល សាកសួរ សុខទុក្ខ និង បាន ផ្តល់ ជូន គាត់ ផងដែរ នូវ អង្ករ ចំនួន ៥០ គីឡូក្រាម មី យើង ចំនួន ២កេស ទឹកត្រី ទឹក ស៊ីអ៊ីវ ចំនួន ២យួរ ត្រីខ កំប៉ុង ០១យួរ និង ថវិកា ចំនួន ១០០.០០០ រៀល ។
ក្នុង ឱកាស នោះ ដែរ លោក យ៉េត ហុន និង ក្រុមគ្រួសារ មាន ក្តីរំភើប យ៉ាង ក្រៃលែង ដែល ជានិច្ចកាល សម្តេច តែងតែ គិតគូរ ដល់ បងប្អូន អតីត យុទ្ធជន ជាពិសេស គឺ រូប គាត់ ផ្ទាល់ និង សូម គោរព ថ្លែង អំណរគុណ ចំពោះ គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា គ្រប់ ជាន់ ថ្នាក់ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន ៕ កម្លាំង នគរបាល ចុះបង្ក្រាប ទីតាំង ស្តុក បារី ក្លែងក្លាយជាង ៥តោន នៅ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល
( កណ្តាល ) ៖ កម្លាំង នគរបាល នាយកដ្ឋាន ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច ក្រសួង មហាផ្ទៃ សហការ ជាមួយ នគរបាល ប្រឆាំង សេដ្ឋកិច្ច នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កណ្តាល និង កម្លាំង នគរបាល មូលដ្ឋាន ក្រោម ការសម្របសម្របសម្រួល ពី លោក ឯក ស៊ុន រស្មី ព្រះអាជ្ញា រង អម សាលាដំបូង ខេត្ត កណ្តាល នៅ ល្ងាច ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ បាន ចុះបង្ក្រាប ទីតាំង ស្តុក បារី ក្លែងក្លាយជាង ៥តោន ស្ថិត នៅ ភូមិ កំពង់សំណាញ់ សង្កាត់ កំពង់សំណាញ់ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ។
លោក ឧត្តមសេនីយ៍ ទោ ឡុង ស្រេង អនុប្រធាន នាយកដ្ឋាន នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច បាន ឲ្យដឹង ថា ប្រតិបត្តិការ ខាងលើ នេះ បាន ធ្វើឡើង ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ឯក ចាន់ វ៉ាន់ ធឿន ប្រធាន នាយកដ្ឋាន ។
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ និង លោកស្រី ឯម ប៉ុណ្ណា តំណាងរាស្ត្រ មណ្ឌល ពោធិ៍សាត់ នា ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ បាន ដឹកនាំ មន្ត្រី ពាក់ព័ន្ធ ជួប សំណេះសំណាល និង ជួយ ដោះស្រាយ ស្រាយ ទុក្ខ កង្វល់ ប្រជាពលរដ្ឋ ព្រមទាំង បាន ផ្តល់ ស្បៀង ជូន ដល់ ពលរដ្ឋ ខ្វះ លទ្ធភាព និង ជន ដែល គ្មាន មុខរបរ ពិតប្រាកដ បាន ជាង ៣០០ នាក់ នៅ សាលា ខេត្ត ពោធិ៍សាត់ ។
លោក បាន បន្ត ថា យើង បាន ជួបជុំគ្នា មើលឃើញ ពី សមិទ្ធផល ធំ ៗ ទូទាំង ខេត្ត ក៏ដូច ទូទាំង ប្រទេស នា ពេលនេះ គឺ ដោយសារ សង្គមជាតិ យើង មាន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ក្នុង ឱកាស នោះ បើ ផ្អែក តាម ចំនួន ប្រជាពលរដ្ឋ ដែល រដ្ឋ អំណាច មូលដ្ឋាន បាន បញ្ជូន ឈ្មោះ មក នោះ មាន ចំនួន ជាង ៣០០ នាក់ ដោយ ម្នាក់ ៗ ទទួលបាន អង្ករ ១០គីឡូក្រាម ដែល សកម្មភាព នេះ រូប លោក តែងតែ អនុវត្តន៍ ជាប្រចាំ ចាប់តាំងពី មក ដឹកនាំយន្តការ នៅក្នុង ខេត្ត ៕ ក្រុមហ៊ុន ហ្វឺស ខេមបូឌា និង Net Guardians រៀបចំ សិក្ខាសាលា ដើម្បី ប្រយុទ្ធ ប្រឆាំង ការលួច បន្លំ តាមរយៈ ប្រព័ន្ធ ឌីជីថល នៅ កម្ពុជា
ដោយឡែក Net Guardians គឺជា ក្រុមហ៊ុន ដែល ទទួលបាន ពានរង្វាន់ ផ្នែក បចេ្ចកវិទ្យា ហិរញ្ញវត្ថុ ប្រទេស ស្វីស ហើយ មាន អតិថិជន កំពុងតែ កើនឡើង ជាង ២០ ប្រទេស ។ ក្រុមហ៊ុន នេះ ត្រូវបាន បង្កើតឡើង នៅ ឆ្នាំ ២០០៧ ហើយ បាន ដោះស្រាយ ជូន ធនាគារ លើ ពិភពលោក ពី លំដាប់ថ្នាក់ ទី១ ដល់ ទី៣ លើ ការប្រយុទ្ធ ប្រឆាំង ឧក្រិដ្ឋកម្ម ផ្នែក ហិរញ្ញវត្ថុ ។
( ភ្នំពេញ ) ៖ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ជំរុញ ដល់ ក្រសួង ពាក់ព័ន្ធ ទាំងអស់ ចូលរួម ឆ្លើយតប នឹង ភាពប្រឈម ថ្មី ៗ ដែល កើតឡើង ដោយសារ ជំងឺ មិន ឆ្លង ដើម្បី ឆ្លើយតប ទៅនឹង ផែនការ សកម្មភាព ពហុ វិស័យ ជាតិ ស្ដីពី « ការការពារ និង ប្រយុទ្ធ នឹង ជំងឺ មិន ឆ្លង ២០១៨ - ២០២៧ » ដោយ ក្នុង នោះ ជំងឺ មិន ឆ្លង ចំនួន ៤ ជា មូលហេតុ នៃ ការស្លាប់ ជាង ពាក់កណ្តាល ក្នុង ចំណោម ការស្លាប់ ទាំងអស់ នៅ កម្ពុជា ។
ការថ្លែង យ៉ាង ដូច្នេះ របស់ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង ក្នុង ឱកាស ប្រកាស ដាក់ ឲ្យ ប្រើប្រាស់ ផែនការ សកម្មភាព ពហុ វិស័យ ជាតិ ស្ដីពី « ការការពារ និង ប្រយុទ្ធ នឹង ជំងឺ មិន ឆ្លង ២០១៨ - ២០២៧ » នៅ សណ្ឋាគារ កាបូឌីយ៉ាណា នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ ។
លោក បន្ដ ថា « ក្នុង ចំណោម ជំងឺ មិន ឆ្លង មាន ជំងឺ ចំនួន ៤ ដែល ជា មូលហេតុ នៃ ការស្លាប់ ជាង ពាក់កណ្តាល ក្នុង ចំណោម ការស្លាប់ ទាំងអស់ នៅ កម្ពុជា គឺ ជំងឺ បេះដូង សរសៃ ឈាម ជំងឺ មហារីក ជំងឺ ទឹកនោម ផ្អែម និង ដង្ហើម រ៉ាំរ៉ៃ ។ ជំងឺ មិន ឆ្លង ទាំង បួន នេះ ហើយ ដែល ត្រូវបាន គេ ព្យាករណ៍ ថា នឹង កើនឡើង ថែម ទៀត ដោយសារតែ ផលវិបាក ដែល បណ្តាល មកពី ឥរិយាបថ របៀបរបប រស់ នៅ និង បរិស្ថាន ដែល កំពុងតែ មាន ការប្រួល ប្រែ » ។
ក្នុង ឱកាស នោះ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល ក៏ បាន ថ្លែង កោតសរសើរ នូវ ការចូលរួមចំណែក យ៉ាង សកម្ម របស់ ដៃគូ ពាក់ព័ន្ធ និង មន្ដ្រី សុខាភិបាល ទាំងអស់ មិន ត្រឹមតែ មក លើ សុខុមាលភាព ប្រជាជន ប៉ុណ្ណោះ ទេ ប៉ុន្ដែ ថែមទាំង មក លើ ផលិតភាព ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម និង ប្រទេសជាតិ ទាំងមូល ៕
ក្រោយ ការបោះឆ្នោត អភិបាល ខណ្ឌ ដង្កោ បន្ដ ចុះ មូលដ្ឋាន ជាប់ ជាប្រចាំ ដើម្បី សួរសុខទុក្ខ និង ស្វែងយល់ ពី តម្រូវការ របស់ ប្រជាពលរដ្ឋ នៅ សង្កាត់ ក្រាំង ពង្រ
( ភ្នំពេញ ) ៖ លោក នុត ពុធ ដារ៉ា ជំនួយការ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង ជា អភិបាល ខណ្ឌ ដង្កោ នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ រួម ជាមួយ អភិបាល រង មន្ត្រីរាជការ ខណ្ឌ សង្កាត់ បាន បន្ត ចុះ ថ្លែងអំណរគុណ ប្រជាពលរដ្ឋ ក្នុង សង្កាត់ ក្រាំង ពង្រ ដែល បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការបោះឆ្នោត កន្លងមក ព្រមទាំង សំណេះសំណាល សួរសុខទុក្ខ និង ស្វែងយល់ ពី តម្រូវការ សំណើ សំណូមពរ នានា របស់ ប្រជាពលរដ្ឋ មក ដោះស្រាយ ឲ្យបាន ទាន់ ពេល វេលា ។
ថ្លែង ក្នុង ឱកាស នោះ លោក អភិបាល ខណ្ឌ ក៏ បាន ផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ប្រជាពលរដ្ឋ ពី សំណាក សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល ជានិច្ចកាល សម្តេច ទាំង ទ្វេរ តែង បាន គិតគូរ ពី ការលំបាក បញ្ហា កង្វល់ និង តម្រូវការ នានា របស់ បងប្អូន នៅ មូលដ្ឋាន ។
បន្ថែម ពី នេះ លោក នុត ពុធ ដារ៉ា បាន ធ្វើការ ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន ផ្តល់ ទំនុកចិត្ត និង បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ កន្លងទៅ ដើម្បី សម្តេច តេជោ ហ៊ុន សែន បន្ត ធ្វើជា នាយក រដ្ឋមន្ត្រី និង បន្ត ដឹកនាំ ប្រទេសជាតិ រីកចម្រើន បន្ត ទៀត ។
បើ តាម លោក អភិបាល ខណ្ឌ ពលរដ្ឋ បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន ឲ្យបាន ទទួល ជោគជ័យ គួរ ជា ទី មោទនៈ នេះ បាន បង្ហាញ យ៉ាង ច្បាស់ ថា បងប្អូន ត្រូវការ សម្តេច តេជោ ហ៊ុន សែន ធ្វើជា នាយក រដ្ឋមន្ត្រី ត្រូវការ សន្តិភាព និង ការអភិវឌ្ឍ បន្ត ទៀត ។
( កំពត) ៖ នៅ សាលា ខេត្ត កំពត លោក ទេសរដ្ឋមន្ត្រី ឆាយ ថន រដ្ឋមន្ត្រី ក្រសួង ផែនការ និង លោក ជា វ តាយ អភិបាល ខេត្ត កំពត នៅ ព្រឹក ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ចូលរួម បើក អង្គ សិក្ខាសាលា ស្ដីពី ការជំរុញ ការអនុវត្ត គោល នយោបាយ ជាតិ ប្រជាជន ២០១៦ - ២០៣០ ក្នុង ក្របខ័ណ្ឌ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព កម្ពុជា « ប្រជាជន វ័យ ចាស់ នៅ កម្ពុជា » ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី គោល នយោបាយ នេះ ជា ការរួមចំណែក កាត់បន្ថយ ភាពក្រីក្រ និង ធ្វើឲ្យ ប្រសើរឡើង នូវ គុណភាព ជីវិត របស់ ប្រជាជន ។ លោក មាន ជំនឿ ថា សមាជិក អង្គ សិក្ខាសាលា នេះ ពិតជា ទទួលបាន ទុន បន្ថែម សម្រាប់ ការជម្រុញ ការអនុវត្ត គោល នយោបាយ ជាតិ ប្រជាជន ២០១៦ - ២០៣០ ក្នុង ក្របខ័ណ្ឌ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព កម្ពុជា ។
សូម បញ្ជាក់ ថា អង្គ សិក្ខាសាលា នេះ មាន រយៈ ២ ថ្ងៃ ដែល មាន មន្ត្រី ចូលរួម ពី ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត កំពត និង មន្ត្រី នៃ មន្ទីរ ផែនការ ដែល មកពី ខេត្ត ព្រះសីហនុ កោះ កុង កែប កំពង់ស្ពឺ កណ្ដាល និង ខេត្ត កំពត សរុប ចំនួន ១៥០ នាក់ ៕
ឯកសណ្ឋាន ប្រជាការពារ ២៥ សម្រាប់ និង វិទ្យុ ទាក់ទង ដៃ៨ គ្រឿង ត្រូវបាន បំពាក់ ជូន ប្រជាការពារ ចំនួន ០៣ ភូមិ ក្នុង ឃុំ បន្ទាយ ស្ទោង ស្រុក ស្ទោង ខេត្ត កំពង់ធំ
( កំពង់ធំ )៖ ដោយ មាន ការយកចិត្តទុកដាក់ ពី សន្តិសុខ សុវត្ថិភាព របស់ បងប្អូន ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន និង អនុវត្ត តាម គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព របស់ រាជ រដ្ឋាភិបាល លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន ក្នុង នាម គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត កំពង់ធំ មេបញ្ជាការ រង យោធភូមិភាគ ទី៤ មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បាន ឧបត្ថម្ភ ឯកសណ្ឋាន ជូន ប្រជាការពារ ចំនួន ២៥ សម្រាប់ និង វិទ្យុ ទាក់ទង ដៃ ចំនួន ០៨ គ្រឿង ដល់ ប្រជាការពារ ភូមិ ចំនួន ០៣ ភូមិ ក្នុង ស្រុក ស្ទោង ខេត្ត កំពង់ធំ ។
ក្នុង ឱកាស នោះ ដែរ ក្រោយពី បំពាក់ ឯកសណ្ឋាន និង ប្រគល់ វិទ្យុ ទាក់ទង ដៃ ជូន ដល់ ប្រជាការពារ រួច មក លោក បាន ធ្វើ ការផ្សព្វផ្សាយ នូវ ខ្លឹមសារ គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព ទាំង ៩ ចំណុច អំពី ភារកិច្ច និង តួនាទី ដល់ ប្រជាការពារ ដែល ត្រូវ អនុវត្ត ជៀសវាង ខុសពី គោលការណ៍ ដែល បាន ដាក់ចេញ ហើយ លោក ក៏ បាន ថ្លែងអំណរគុណ ដល់ បងប្អូន ប្រជាពលរដ្ជ ដែល បាន នាំគ្នា អញ្ជើញ ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ដែល ប្រព្រឹត្តទៅ កាលពី ថ្ងៃទី ២៧ ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងមក ។
លោក ក៏ បាន ផ្តាំផ្ញើ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ចូលរួម ថែរក្សា ទ្រព្យសម្បត្តិ ផ្ទាល់ខ្លួន ទ្រព្យសម្បត្តិ សាធារណៈ ដើម្បី ចូលរួមចំណែក ក្នុង ការអនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព របស់ រាជ រដ្ឋាភិបាល ផងដែរ ។
( ភ្នំពេញ ) ៖ នគ បាល ព្រហ្មទណ្ឌ កំរិត ស្រាល នៃ ស្នងការដ្ឋាន នគ បាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន បញ្ជូន មុខ សញ្ញា ក្រុម ចោរ ឆក់ កាបូប តាម ដងផ្លូវ សាធារណៈ ចំនួន ៣នាក់ ក្នុង នោះ ម្នាក់ មាន ដីកា បង្គាប់ ឱ្យ ចាប់ខ្លួន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម នីតិវិធី ។
លោក វរសេនី ឯក ប៊ុន សត្យា បញ្ជាក់ ឱ្យដឹង ថា ជនសង្ស័យ ទាំង ០៣ នាក់ ត្រូវបាន ការិយាល័យ ធ្វើ ការស្រាវជ្រាវ ឃាត់ខ្លួន បាន កាលពី ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០១៨ វេលា ម៉ោង ១៧៖៣០ នាទី ល្ងាច នៅ ចំណុច ផ្ទះសំណាក់ លេខ ៦៩ ផ្លូវ ឧកញ៉ា ម៉ុង រិទ្ធី ភូមិ ទំនប់១ សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
លោក បន្ត ថា ក្រោយពី ឃាត់ខ្លួន បាន យកមក ធ្វើ ការសាកសួរ ជនសង្ស័យ បាន សារភាព ថា កន្លងមក ពួក ខ្លួន ធ្លាប់ ធ្វើ សកម្មភាព ឆក់ យក កាបូប បាន ចំនួន តែ ២លើក ដោយ ក្នុង នោះ បាន សម្រេច មួយ លើ កាលពី ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០១៨ វេលា ម៉ោង ១៦៖៤៥ នាទី ដោយ ឆក់ កាបូប យួរ ដៃ ពណ៌ ប្រផេះ ពី ជនជាតិ ចិន នៅ ចំណុច មុខ ផ្ទះ លេខ ៧ផ្លូវ សុធារស ភូមិ ទី៣ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ។
ភ្លាម ៗ បែប នេះ ពុំ ទាន់ មាន សេចក្តីរាយការណ៍ អំពី ការបំផ្លិចបំផ្លាញ ឬ មនុស្ស រងគ្រោះ ដោយសារ គ្រោះ រញ្ជួយ ដី ខាងលើ នៅឡើយ ទេ ។ ហេតុការណ៍ រញ្ជួយ ផែនដី ថ្មី នេះ មាន ជម្រៅ ១០គីឡូម៉ែត្រ នៅក្រោម បាត សមុទ្រ ហើយ វា ពុំ បាន បង្កឲ្យ មាន ការគំរាមកំហែង ពីរ លក យក្ស ស៊ូណាមិ នោះ ទេ ។
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ មកពី ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ ប្រមាណ ៣០០ នាក់ នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ធ្វើដំណើរទស្សនកិច្ច សិក្សា នៅ សាលា ក្តី ខ្មែរ ក្រហម និង នៅ ទីតាំង ឧក្រិដ្ឋកម្ម នៃ អតីត គុក ទួល ស្លែង និង បឹង ជើងឯក រាជធានី ភ្នំពេញ ។
ថ្លែង នៅក្នុង ដំណើរទស្សនកិច្ច សិក្សា ខាងលើ នេះ លោក នេត្រ ភក្ត្រា ប្រធាន ផ្នែក កិច្ចការ សាធារណៈ និង ជា អ្នកនាំពាក្យ សាលា ក្តី ខ្មែរ ក្រហម បាន ថ្លែង ថា ភាគ ច្រើន នៃ ពលរដ្ឋ ដែល បាន ចូលរួម ទស្សនកិច្ច សិក្សា នេះ គឺជា ជនរងគ្រោះ នៃ របប ខ្មែរ ក្រហម ។
លោក នេត្រ ភក្ត្រា បាន បន្ដ ទៀត ថា ការចូលរួម របស់ ជនរងគ្រោះ ទាំង ក្នុង ដំណើរការ នីតិវិធី ច្បាប់ ចំពោះ មុខ សាលា ក្តី ខ្មែរ ក្រហម និង ទស្សនកិច្ច សិក្សា ពិតជា មាន សារៈសំខាន់ ព្រោះថា ជនរងគ្រោះ គឺជា ភស្តុតាង រស់ មួយ នៃ អំពើ ឧក្រិដ្ឋកម្ម ដែល បាន កើតឡើង នៅក្នុង អំឡុង នៃ របប ខ្មែរ ក្រហម ចន្លោះ ពី ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ១៩៧៥ ដល់ ថ្ងៃទី ៦ ខែមករា ឆ្នាំ ១៩៧៩ ។
ប្រធាន ផ្នែក កិច្ចការ សាធារណៈ រូប នេះ បាន ថ្លែង ថា រឿងរ៉ាវ ឈឺ ចុកចាប់ ការរងទុក្ខ ខ្លោចផ្សារ របស់ ជនរងគ្រោះ គឺជា ធាតុ ផ្សំ នៃ ប្រវត្តិសាស្ត្រ របប កម្ពុជា ប្រជាធិបតេយ្យ ទាំងមូល ។ សក្ខីកម្ម នៃ ជនរងគ្រោះ ភស្តុតាង នៃ អំពើ ឧក្រិដ្ឋកម្ម ដែល បាន កើត មាន ឡើង បាន ចូលរួម ក្នុង ការស្វែងរក ការពិត និង យុត្តិធម៌ ជូន ដល់ ជនរងគ្រោះ ដែល បាន ស្លាប់ បាត់បង់ជីវិត និង អ្នក ដែល កំពុង រស់រាន មាន ជីវិត ។
លោក នេត្រ ភក្ត្រា បាន បន្ត ថា នួន ជា បច្ចុប្បន្ន មាន អាយុ ៩២ ឆ្នាំ និង ខៀវ សំផន មាន អាយុ ៨៧ ឆ្នាំ កំពុង រង់ចាំ ការប្រកាស សាលក្រម ក្នុង សំណុំរឿង ០០២ / ០២ បន្ត ទៀត ដែល គេ រំពឹង ថា នឹង អាច ធ្វើឡើង នៅ ចុង ឆ្នាំ ២០១៨ នេះ ៕ មន្ទីរ បរិស្ថាន ខេត្ត កំពត បំភ្លឺ ចំពោះ ព័ត៌មាន ថា ពលរដ្ឋ នៅ តំបន់ សហគមន៍ ឧទ្យាន ជាតិ បូក គោ មិន ចង់ឲ្យ អាជ្ញាធរ ដោះដូរ ដី និង សុំ ការពន្លឿន ការចេញ ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី
( កំពត ) ៖ មន្ទីរ បរិស្ថាន ខេត្ត កំពត នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ចេញ សេចក្ដីបំភ្លឺ ចំពោះ ព័ត៌មាន ថា ពលរដ្ឋ តំបន់ សហគមន៍ ឧទ្យាន ជាតិ ព្រះមុនីវង្ស បូក គោ មិន ចង់ឲ្យ អាជ្ញាធរ ដោះដូរ ដី ផ្ទុយ ពី អនុក្រឹត្យ សម្ដេច តេជោ ហ៊ុន សែន ដែល កំណត់ នោះ ទេ និង សុំ ការពន្លឿន ការចេញ ប័ណ្ណ កម្មសិទិ្ធ ដីធ្លី ។
លិខិត បំភ្លឺ ដែល អង្គភាព Fresh News ទទួលបាន មន្ទីរ បរិស្ថាន បាន បញ្ជាក់ ថា ការលើកឡើង របស់ តំណាង ប្រជាពលរដ្ឋ ១៣គ្រួសារ គឺជា ការប្រឌិត ក្លែងបន្លំ មតិ សាធារណៈ ជន ទូទៅ និង បំភ្លៃ អត្ថន័យ ខ្លឹមសារ អនុក្រឹត្យ លេខ ១៦៧ អន ក្រ. បក ចុះ ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០១៧ ធ្វើឲ្យ ប៉ះពាល់ កិច្ច ខិតខំ ប្រឹងប្រែង ដោះស្រាយ បញ្ចប់ ទំនាស់ ដីធ្លី ជូន ប្រជាពលរដ្ឋ និង ប៉ះពាល់ ដល់ កិត្តិយស ។
( ភ្នំពេញ ) ៖ ដូច ការគ្រោងទុក នៅ ព្រឹក ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ លោក ប្លង់ សំណាង ជា ប្រធាន ក្រុមប្រឹក្សា ជំនុំជម្រះ . លោក នួន រតនា និង លោកស្រី គឹម ដានី ជា ចៅក្រម ប្រឹក្សា និង មាន លោកស្រី យិន សុគន្ធារី ជា តំណាង មហា អយ្យការ បាន បើក សវនាការប្រកាស សាល ដីកា ចំនួន ២សំណុំរឿង ដែល មាន ជនជាប់ចោទ ជា មន្ត្រី អតីត យោធា ម្នាក់ និង ជា អតីត មន្ត្រី ក្រុមប្រឹក្សា ឃុំ នៅ ខេត្ត កំពត ម្នាក់ ។
សាល ដីកា ដែល ប្រកាស នៅ ព្រឹក នេះ បាន សម្រេច ផ្តន្ទាទោស ជន ជាប់ចោទ ទី១ ឈ្មោះ ស៊ុន សៀង ភេទ ប្រុស អាយុ ៤៨ ឆ្នាំ មុខរបរ ជា មន្ត្រី យោធា និង ទី២ឈ្មោះ ហេង សាន ភេទ ប្រុស អាយុ ៤៥ ឆ្នាំ ជា អតីត សមាជិក ក្រុមប្រឹក្សា ឃុំ ត្រពាំង ភ្លាំង ស្រុក ឈូក ខេត្ត កំពត ដូច ខាងក្រោម៖
* សំណុំរឿង ទី ១៖ សម្រេច ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ កំណត់ រយៈពេល ៦ខែ ដោយ អនុវត្ត ទោស ក្នុង ពន្ធនាគារ ទាំងអស់ ពី បទ ឆ បោក និង តម្រូវឲ្យ ជនជាប់ចោទ រួមគ្នា សង សំណង ទៅ ដើម បណ្តឹង ចំនួន ៥ម៉ឺន ដុល្លារ និង សង ជំងឺ ចិត្ត ចំនួន ៥០០០ ដុល្លារ ប្រព្រឹត្ត កាលពី អំឡុង ឆ្នាំ ២០១៣ នៅ រាជធានី ភ្នំពេញ យោង តាម មាត្រា ៣៧៧ និង មាត្រា ៣៧៨ នៃ ក្រម ព្រហ្មទណ្ឌ ។
មេធាវី តំណាង ជនរងគ្រោះ បាន ឲ្យដឹង ថា កូនក្តី របស់ ខ្លួន ពិតជា សប្បាយ ចិត្ត នៅ ពេល ដែល តុលាការ សាលាឧទ្ធរណ៍ សម្រេច ផ្តន្ទាទោស ក្រុម ជន ជាប់ចោទ ដាក់ ពន្ធនាគារ បន្ថែម បែប នេះ ។
ទោះជា យ៉ាងណា ពួកគាត់ យល់ ថា ការបន្ថែម ទោស ក្នុង ពន្ធនាគារ នេះ ហាក់ មិន ទាន់ សម នឹង អំពើ ដែល ក្រុម ជន ជាប់ ចោទ បាន ប្រព្រឹត្ត នោះ ទេ គួរតែ តុលាការ ដាក់ ឲ្យបាន យូរ ជាង នេះ ដើម្បី កុំ ឲ្យ បុគ្គល មួយចំនួន យក គំរូ តាម ជនជាប់ចោ ទាំង ២នាក់ នេះ ។
នៅក្នុង លិខិត នោះ លោក សឺហ្គៃ បាន បន្ថែម ថា « សាធារណរដ្ឋ បេឡារុស ពិតជា អារម្មណ៍ ក្នុង ការពង្រីក កិច្ចសហប្រតិបត្តិការ បេឡា រុស - កម្ពុជា ឲ្យ កាន់តែ ទូលំទូលាយ ថែម ទៀត ជាពិសេស នោះ គឺ ក្នុង វិស័យ ពាណិជ្ជកម្ម សេដ្ឋកិច្ច និង មនុស្សធម៌ របស់ ប្រទេស កម្ពុជា » ។
គួរ ជម្រាប ថា នៅ លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត កាលពី ថ្ងៃទី ២៩ ខែកក្កដា កន្លងទៅ គ.ជ. ប បាន ប្រកាស ថា គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន សំឡេង គាំទ្រ ៤. ៨៨៩. ១១៣ ក្នុង ចំណោម សន្លឹក ឆ្នោត ផ្លូវការ ចំនួន ៦. ៣៦២. ២៤១ សន្លឹក ដែល នាំឲ្យ គណបក្ស ប្រជាជន កម្ពុជា ឈ្នះ អាសនៈ ទាំង ១២៥ នៅក្នុង រដ្ឋសភា ជាតិ ៕
ការប្រយុទ្ធ បង្ហូរ ឈាម គ្នា ក្នុង ទីក្រុង ទ្រី ប៉ូលី នៃ ប្រទេស លីប៊ី ត្រូវបាន បញ្ចប់ ក្រោម បទ ឈប់ បាញ់ !
គួរ ជម្រាប ថា នៅ ក្រោយ ការបះបោរ កាលពី ឆ្នាំ ២០១១ ដែល បាន ផ្តួលរំលំ រដ្ឋាភិបាល អាយុកាល ៤២ ឆ្នាំ របស់ អតីត មេដឹកនាំ លោក មួម៉ារ ហ្គាដាហ្វី (Muammar Gaddafi) លីប៊ី បាន បន្ត រងគ្រោះ ដោយសារ អំពើហិង្សា និង ភាពវឹកវរ ព្រមទាំង ការបែកបាក់ ផ្នែក នយោបាយ យ៉ាង ខ្លាំងក្លា បំផុត ៕ លោកស្រី ខៀវ ស៊ីណា ជំរុញ ទឹកចិត្ត មន្រ្ដី បក្ស ឲ្យ រួម ដៃ គ្នា បម្រើ ពលរដ្ឋ ឲ្យ អស់ ពី ចិត្ត ដើម្បី តបស្នង ចំពោះ ពួកគាត់ ដែល ផ្ដល់ ទំនុកចិត្ត មក លើ គណបក្ស ប្រជាជន កម្ពុជា
( កំពង់ធំ )៖ លោកស្រី ខៀវ ស៊ីណា ជា ចាន់តូ អនុប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ធំ បាន សំណូមពរ ឲ្យ មន្ត្រី គណបក្ស ប្រជាជន ក្នុង ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ទាំងអស់ បន្ត ប្រពៃណី សាមគ្គីភាព ដើម្បី គាំពារ ថែរក្សា ការពារ ប្រជាពលរដ្ឋ ឲ្យបាន ទ្វេ ដង ឲ្យ សម ទៅនឹង ការផ្ដល់ ជំនឿ ទុកចិត្ត របស់ ពួកគាត់ មក លើ ការដឹកនាំ របស់ គណបក្ស ប្រជាជន ។
ការស្នើ បែប នេះ របស់ លោកស្រី ខៀវ ស៊ីណា ជា ចាន់តូ ធ្វើឡើង នៅ ឱកាស ដែល លោកស្រី អញ្ជើញ ចូលរួម សំណេះសំណាល ជាមួយ បណ្ដា គណៈកម្មាធិការ បក្ស ភូមិ ទូទាំង ស្រុក សន្ទុក នា ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ ។
លោកស្រី ខៀវ ស៊ីណា ជា ចាន់តូ បាន ឲ្យដឹង ថា « ប្រជាជនជា កម្លាំង ដ៏ រឹងមាំ និង មិន អាច ខ្វះ បាន ឡើយ នៅក្នុង ការរក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍ ប្រទេសជាតិ ។ គ្រប់ កិច្ចការ តូច ធំ ទាំងឡាយ ប្រសិនបើ គ្មាន ការចូលរួម គាំទ្រ ពីសំណាក់ ប្រជាជន នោះ ទេ ច្បាស់ជា មិន អាច សម្រេចបាន ជោគជ័យ ឡើយ » ។
លោកស្រី បន្ដ ថា ជាក់ស្ដែង ដូចជា ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ អាណ្ណត្តិ ទី៦ ដែល បាន ប្រព្រឹត្តិ ឡើង នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងទៅជា សក្ខីភាព ស្រាប់ ។ ហេតុ ដូច្នេះ យើង ម្នាក់ ៗ ត្រូវ រួម សាមគ្គី គ្នា បម្រើ ប្រជាជន ឲ្យ អស់ ពី កម្លាំង កាយ ចិត្ត និង គ្រប់ កាលៈទេសៈ ដើម្បី ភាព សុខ ដមរម្យ នា ក្នុង សង្គម គ្រួសារ ខ្មែរ ទាំងមូល ព្រមទាំង អនាគត ប្រទេសជាតិ និង កូន ចៅ គ្រប់ ៗ ជំនាន់ ឲ្យ ជួប តែ សុខ សន្តិភាព និង សម្បូរ រុងរឿង ជារៀងរហូត ។
នា ឱកាស នោះ ដែរ លោកស្រី ខៀវ ស៊ីណា ជា ចាន់តូ ក៏ បាន ផ្ដល់ នូវ ការលើកទឹកចិត្ត ដល់ មន្ត្រី បក្ស តាម ភូមិ រួម នឹង អាហារ សាមគ្គី មួយ ពេល ដល់ អ្នកចូលរួម ផងដែរ ៕
លោក គុណ ញឹម ជួប មន្ត្រី ជំនាញ ក្នុង តំបន់ អាហ្រ្វិក ដកស្រង់ ពិសោធន៍ ត្រួតពិនិត្យ កុងតឺន័រ ទប់ស្កាត់ ទំនិញ ខុស ច្បាប់
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត គុណ ញឹម ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន ជួបប្រជុំ ជាមួយ មន្ត្រី ជំនាញ មកពី បណ្តា ប្រទេស នានា ក្នុង តំបន់ អាហ្វ្រិក ដើម្បី ផ្លាស់ប្តូរ និង ដកស្រង់ បទពិសោធន៍ ពី គ្នា ទៅ វិញ ទៅមក ក្នុង ការត្រួតពិនិត្យ កុងតឺន័រ ដើម្បី ទប់ស្កាត់ ទំនិញ ខុស ច្បាប់ មាន ដូចជា គ្រឿងញៀន ជាដើម ។
នេះ ជា ជំនួប ប្រជុំ លើក ទី មួយ របស់ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ជាមួយ មន្រ្តី អនុវត្ត ច្បាប់ ពី បណ្តា ប្រទេស ក្នុង ទ្វីប អាហ្រ្វិក ក្នុង ក្របខណ្ឌកម្មវិធី ត្រួតពិនិត្យ កុងតឺន័រ ។ កិច្ចប្រជុំ នេះ មាន គោលបំណង ផ្លាស់ប្តូរ បទពិសោធន៍ ការងារ ចែករំលែក ព័ត៌មាន សម្ងាត់ ជាមួយ មន្រ្តី អនុវត្ត ច្បាប់ ពាក់ព័ន្ធ ក្នុង គោលដៅ ពង្រឹង បន្ថែម ទៀត នូវ កិច្ចសហប្រតិបត្តិការ ថ្នាក់ តំបន់ និង អន្តរជាតិ ។
កម្មវិធី ត្រួតពិនិត្យ កុងតឺន័រ គឺជា គម្រោង រៀបចំ រួមគ្នា ដោយ ការិយាល័យ ផ្នែក គ្រឿងញៀន និង ឧក្រិដ្ឋកម្ម នៃ អង្គការ សហ ប្រជាជាតិ (UNODC) និង អង្គការ គយ ពិភពលោក (WCO) ហើយ មាន គោលបំណង ទប់ស្កាត់ និង បង្រ្កាប ការជួញដូរ គ្រឿងញៀន សត្វ ព្រៃ និង បទឧក្រិដ្ឋ ឆ្លង ដែន ផ្សេង ទៀត ។ បច្ចុប្បន្ន មាន ប្រទេស ជិត ៥០ កំពុង ចូលរួម អនុវត្ត កម្មវិធី នេះ ។
សម្រាប់ ថ្ងៃ មុខ និង ដើម្បី បង្កើន ប្រសិទ្ធភាព ការងារ ក្នុង បរិបទ នេះ លោក គុណ ញឹម ក៏ បាន គាំទ្រ និង ស្នើឲ្យ មន្ត្រី អនុវត្ត ច្បាប់ នៃ ប្រទេស ចូលរួម ក្នុង កម្មវិធី នេះ ធ្វើ ទំនាក់ទំនង និង សហការ គ្នា ឱ្យ បាន កាន់តែ ជិតស្និទ្ធ ថែម ទៀត ក្រោម កម្មវិធី ត្រួតពិនិត្យ កុងតឺន័រ នេះ ដោយ ប្រើប្រាស់ យន្តការពាក់ព័ន្ធ ផ្សេង ទៀត របស់ អង្គការ សហ ប្រជាជាតិ និង អង្គការ គយ ពិភពលោក ។
ឆ្លៀត ក្នុង ឱកាស នេះ លោក Javier Montano ក៏ បាន ថ្លែងអំណរគុណ លោក បណ្ឌិត គុណ ញឹម ដែល បាន គាំទ្រ និង ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ គណៈប្រតិភូ ដើម្បី មក ទស្សនកិច្ច សិក្សា និង ចែករំលែក បទពិសោធន៍ នៅ សាខា គយ និង រដ្ឋាករ អាកាសយានដ្ឋាន អន្តរជាតិ ( ការិយាល័យ អាកាសយនដ្ឋាន អន្តរជាតិ ភ្នំពេញ និង អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប ) និង សាខា គយ និង រដ្ឋាករ កំពង់ផែ អន្តរជាតិ ក្រុង ព្រះសីហនុ ។
អ្នក វិនិយោគ ទាំងនេះ បាន នឹង កំពុង រកស៊ី លើ វិស័យ អចលន ទ្រព្យ ហិរញ្ញវត្ថុ ការដឹកជញ្ជូន ដែក ថែប ឧស្សាហកម្ម បច្ចេកវិទ្យា ទំនើប វេជ្ជសាស្ត្រ ថាមពល គ្រឿង អេឡិចត្រូនិច ប្រើប្រាស់ ក្នុង ផ្ទះ ទេសចរណ៍ សណ្ឋាគារ ជាដើម ។ល ។
បើ តាម លោក ស៊្រី ថាម រុង្គ នៅ ចំពោះមុខ អ្នក វិនិយោគ ចិន នេះ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង នូវ ជោគជ័យ ជា ប្រវត្តិសាស្ត្រ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ព្រឹត្តិការណ៍ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ កាលពី ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន ការគាំទ្រ ច្រើន លើសលុប រហូតដល់ គ្រប់ អាសនៈ នៅក្នុង រដ្ឋសភា ទាំងអស់ តែម្តង ។
សម្តេច តេជោ បាន គូសបញ្ជាក់ ទៅ អ្នក វិនិយោគ របស់ ចិន ថា ជោគជ័យ នេះ បាន មក ដោយសារតែ ការធ្វើ កំណែទម្រង់ ជាច្រើន របស់ រាជ រដ្ឋាភិបាល ដូចជា បញ្ហា ដីធ្លី ការផ្តល់ សេវា សាធារណៈ សេវា សង្គម ជាពិសេស ការខិតខំ ដោះស្រាយ លើ ជីវភាព និង បញ្ហា ផ្សេង ៗ របស់ ប្រជាពលរដ្ឋ ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ។
នៅក្នុង ជំនួប រយៈពេល ប្រមាណ ជា២ ម៉ោង មាន បញ្ហា ជាច្រើន ត្រូវបាន លើកឡើង រវាង សម្តេច តេជោ ហ៊ុន សែន និង អ្នក វិនិយោគ របស់ ចិន ដោយ ផ្តោត ជា សំខាន់ ទៅ លើ ការវិនិយោគ នៅក្នុង ប្រទេស ។ នេះ បើ តាម ការបញ្ជាក់ របស់ លោក ស្រ៊ី ថាម រុង្គ ។
លោក ស្រ៊ី ថាម រុង្គ បាន អះអាង ថា បើ ទោះបី បញ្ហា វិនិយោគ ជាច្រើន ត្រូវបាន លើកឡើង យ៉ាងណា ក្តី តែ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រាប់ ទៅកាន់ អ្នក វិនិយោគ ចិន ថា វិស័យ អាទិភាព ដែល រាជ រដ្ឋាភិបាល នៅតែ បន្ត យកចិត្តទុកដាក់ នោះ គឺ មនុស្ស ផ្លូវ ភ្លើង និង ទឹក ដែល វិស័យ ទាំងនេះ ទោះបី អភិវឌ្ឍន៍ ២០ - ៣០ ឆ្នាំ ទៅ មុខ ទៀត ក៏ មិន ត្រូវ អាច គ្រប់គ្រាន់ សម្រាប់ កម្ពុជា នោះ ឡើយ ។ ក្នុង ន័យ នេះ សម្តេច តេជោ ស្វាគមន៍ ការវិនិយោគ ទៅ លើ វិស័យ ទាំងអស់ នេះ ។
ពាក់ព័ន្ធ ការវិនិយោគ នេះ ដែរ សម្តេច តេជោ ហ៊ុន សែន បាន អះអាង ប្រាប់ អ្នក វិនិយោគ ចិន ថា កម្ពុជា ស្វាគមន៍ គ្រប់ អ្នក វិនិយោគ បរទេស ទាំងអស់ មិន ថា ជា អ្នក វិនិយោគ តូច ឬ ធំ នោះ ទេ ពោល ក្រុមហ៊ុន ណា មក មុន ទទួលបាន ឱកាស វិនិយោគ មុន គេ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំ ដល់ អ្នក វិនិយោគ របស់ ចិន សម្លឹងមើល ការវិនិយោគ លើ វិស័យ ទេសចរណ៍ នៅ កម្ពុជា ផងដែរ ដ្បិត វិស័យ ទេសចរណ៍ នៅ កម្ពុជា កំពុង មាន ភាពល្អ ប្រសើរ ជាពិសេស បច្ចុប្បន្ន ទទួលបាន អ្នកទេសចរ ចិន កាន់តែ ច្រើន បន្ទាប់ពី ប្រទេស ទាំង ពីរ មាន ការហោះហើរ ត្រង់ ជាមួយគ្នា កាន់តែ ច្រើន ។
បន្ទាប់ពី បាន ស្តាប់ នូវ ចក្ខុវិស័យ មួយចំនួន លើ ការអភិវឌ្ឍ ប្រទេស ចិន ក៏ ដូច គោលការណ៍ ផ្សេង ពាក់ព័ន្ធ លើ ការវិនិយោគ នៅក្នុង ប្រទេស កម្ពុជា ហើយ នោះ គណៈប្រតិភូ អ្នក វិនិយោគ ចិន បាន បង្ហាញ ការចាប់អារម្មណ៍ យ៉ាង ខ្លាំង ។ ជាពិសេស ចាប់អារម្មណ៍ ចំពោះ ការរីកចម្រើន របស់ កម្ពុជា ។
នៅ ចំពោះមុខ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រុម អ្នក វិនិយោគ របស់ ប្រទេស ចិន បាន គូសបញ្ជាក់ ថា ពួកគេ មាន ទំនុកចិត្ត ខ្ពស់ ចំពោះ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ជាពិសេស ការធ្វើឲ្យ មាន ស្ថេរភាព នយោបាយ និង ការៀបចំ ឲ្យ ច្បាប់ វិនិយោគ ល្អ ៗ ដែល ជា ការផ្តល់ ទំនុកចិត្ត សម្រាប់ ការវិនិយោគ ។ ជាពិសេស ការធ្វើឲ្យ ចំណង មិត្តភាព កម្ពុជា និង ចិន កាន់តែ ល្អ ប្រសើរ ។
គណៈប្រតិភូ បាន ថ្លែង ថា ពួកគេ ចង់ ឃើញ សម្តេច តេជោ ហ៊ុន សែន ដឹកនាំ កម្ពុជា បាន យូរ ទៅ មុខ ទៀត ដើម្បី ធ្វើឲ្យ កម្ពុជា មាន ការអភិវឌ្ឍ រីកចម្រើន កាន់តែ ខ្លាំង និង ពូន ជ្រុំ ចំណង មិត្តភាព កម្ពុជា - ចិន ឲ្យ កាន់តែ ប្រសើរ ។
សូម បញ្ជាក់ ថា បច្ចុប្បន្ន ចិន បាន ឈរ នៅ ដាប់ លេខរៀង ទី១ ដែល បាន បោះ ទុន វិនិយោគ នៅក្នុង ប្រទេស កម្ពុជា យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ លើ វិស័យ អាចលន ទ្រព្យ វារី អគ្គិសនី ហេដ្ឋារចនាសម្ព័ន្ធ និង រោងចក្រ សហគ្រាស ជាដើម ។ យោង តាម របាយការណ៍ របស់ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន អះអាង ថា ទំហំ វិនិយោគ របស់ ចិន នៅ កម្ពុជា មាន ជិត ២ពាន់ លាន ដុល្លារ អាមេរិក ។
កាលពី សប្ដាហ៍ មុន លោក ដូណាល់ ត្រាំ បាន បញ្ជា ឱ្យ លោក ប៉ុម បេអូ លុបចោល ដំណើរទស្សនកិច្ច ទៅកាន់ ប្រទេស កូរ៉េ ខាងជើង ដោយ អះអាង ថា ទីក្រុង ព្យុងយ៉ាង មិន បាន បំពេញ គ្រប់គ្រាន់ នូវ ដែល ខ្លួន បាន សន្យា នៅក្នុង ជំនួប កំពូល រវាង លោក និង លោក គីម ជុង អ៊ុន នៅ ប្រទេស សិង្ហបុរី កាលពី ខែមិថុនា កន្លងទៅ នោះ ឡើយ ។
ក៏ប៉ុន្តែ ការលើកឡើង របស់ លោក ត្រាំ ខាងលើ នេះ គឺ ផ្ទុយ ទាំងស្រុង នឹង អ្វី ដែល លោក ធ្លាប់ បាន អះអាង ថា កូរ៉េ ខាងជើង កំពុង ដើរ លើ ផ្លូវ ត្រូវ ក្នុង ការរំសាយ អាវុធ នុយ ក្លអ៊ែរ ហើយ មិន តែ ប៉ុណ្ណោះ លោក ក៏ ធ្លាប់ ទំាង អួត អាង ទៀត ថា ប្រើ ពេល តែ បី ខែ ប៉ុណ្ណោះ អាច ដោះស្រាយ ជាមួយ កូរ៉េ ខាងជើង ផ្ទុយ ពី ប្រធានាធិបតី អាមេរិក មុន ៗ ដែល ចំណាយ ពេល ដោះស្រាយ ជាមួយ ទីក្រុង ព្យុងយ៉ាង ជាង ៣០ ឆ្នាំ តែ មិន បាន លទ្ធផល អ្វី ទាល់តែសោះ ។
យ៉ាងណា ក៏ដោយ ការសម្រេចចិត្ត លុបចោល ដំណើរទស្សនកិច្ច របស់ លោក ប៉ុម ប៉េអូ ត្រូវបាន កូរ៉េ ខាងជើង រិះគន់ យ៉ាង ខ្លាំង ជាមួយនិង ការចោទប្រកាន់ ថា សហរដ្ឋ អាមេរិក បាន ក្បត់ ទីក្រុង ព្យុងយ៉ាង ដោយ លួចលាក់ ធ្វើ សមយុទ្ធ យោធា ផ្លូវ អាកាស ជាមួយ ជប៉ុន ខណៈ កូរ៉េ ខាងត្បូង បាន ត្រឹម បង្ហាញ ការសោកស្ដាយ ។
លោកស្រី Hong បាន លើក ឧទាហរណ៍ ទៀត ថា រឿង បែប នេះ ក៏ ធ្លាប់ បាន កើតឡើង នៅ អំឡុង សម័យ ដែល សហរដ្ឋ អាមេរិក ស្ថិត នៅក្រោម ការដឹកនាំ របស់ អតីត ប្រធានាធិបតី អាមេរិក លោក ចច ដាប់ ប៊ែល យូ ប៊ូស ។ លោក ប៊ូស នៅ ពេល នោះ ហាក់ដូចជា បាន បង្កើត ទំនាក់ទំនង ជិតស្និទ្ធ ជាមួយ កូរ៉េ ខាងជើង ដូច លោក ត្រាំ នា ពេល បច្ចុប្បន្ន នេះ ដែរ ។
ព្រះចៅ អធិការ វត្ត ពោធិដ្ឋាន ក្នុង ខេត្ត ព្រៃវែង និង គណៈកម្មការ វត្ត អំពាវនាវ ឲ្យ ថ្នាក់ដឹកនាំ ជួយ ផ្តល់ យុត្តិធម៌ ក្រោយ ព្រះរាអាជ្ញា សាលាឧទ្ធរណ៍ ម្នាក់ និង ក្រុមគ្រួសា ជេរ ប្រមាថ និង ព្រមាន ចាប់ ដាក់ គុក
( ព្រៃវែង ) ៖ ក្រោយពី ទទួលរង នូវ ការជេរប្រមាថ បម្រុង ដោះ ស្បង់ ជីវរ ព្រះអង្គ រហូតដល់ ព្រមាន ចាប់ ដាក់ គុក ពីសំណាក់ ក្រុមគ្រួសារ លោក ប៉ែន សារ៉ាត់ ដែល ខាង ព្រះសង្ឃ មាន ដីកា ថា មាន តួនាទី ជា ព្រះរាជអាជ្ញា សាលាឧទ្ធរណ៍ ផង នោះ បាន ធ្វើឲ្យ ព្រះតេជគុណ ឈាង ផល្លី ព្រះចៅ អធិការ វត្ត ពោធិដ្ឋាន និង គណៈកម្មការ វត្ត ស្ថិត នៅ ភូមិ ថ្លា វ ឃុំ អង្គរ ទ្រេត ស្រុក ស្វាយអន្ទរ ខេត្ត ព្រៃវែង បាន ប្តឹង ទៅ ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ព្រៃវែង និង ប្រធាន តុលាការ ខេត្ត ដើម្បី រក យុត្តិធម៌ ។
សេចក្តីជូនដំណឹង របស់ ព្រះចៅ អធិការ វត្ត ពោធិដ្ឋាន និង លោក អាចារ្យ គណៈកម្មការ និង ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត បាន ដាក់ ជូន ម្ចាស់ ចេតីយ៍ ពីរ ដង ហើយ រយៈពេល ពីរ ឆ្នាំ ដើម្បី សូម ធ្វើ ការរុះរើ ចេតីយ៍ ចាស់ ដែល មាន សភាព ទ្រុឌទ្រោម និង ប្តូរ ទីតាំង រក កន្លែង ថ្មី ដើម្បី យក ទីតាំង ចាស់ នេះ សង់ ឧបដ្ឋាន សាលា ប៉ុន្តែ ត្រូវបាន ម្ចាស់ ចេតីយ៍ មក ជេរ ប្រមាថ និង ប្តឹង រក ចាប់ ដាក់ គុក ក្រោយពី គណៈកម្មការ វត្ត សម្រេច វាយ កម្ទេច ។
ក្រោយពី វាយ កម្ទេច កាលពី ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០១៦ កន្លងមក ក្រុមគ្រួសារ ម្ចាស់ ចេតីយ៍ បាន ប្តឹង ចៅអធិការ វត្ត ពោធិដ្ឋាន នៅ ថ្ងៃទី ១០ ខែឧសភា ឆ្នាំ ២០១៧ ប្រឆាំង នឹង ចៅអធិការ វត្ត ព្រះនាម ឈាង ផល្លី ព្រមទាំង គណៈកម្មការ វត្ត ពី បទ ធ្វើឲ្យ ខូចខាត ដោយ ចេតនា នូវ បូជនីយដ្ឋាន សាសនា ប្រមាថ ទី បញ្ចុះ សព ស្ថិត នៅ ចំណុច វត្ត ពោធិដ្ឋាន ភូមិ ថ្លា វ ឃុំ អង្គរ ទ្រេត ស្រុក ស្វាយអន្ទរ ខេត្ត ព្រៃវែង ។
ព្រះតេជគុណ ឈាង ផល្លី ក៏ ត្រូវ ម្ចាស់ ចេតីយ៍ លោក ប៉ែន សារ៉ាត់ អ្នកស្រី ប៉ែន ដារ៉ា លោក ប៉ែន សារ៉ាន់ លោក ប៉ែន រី មយ៉ា លោក សួន ស្រេង នាំគ្នា ប្រើ អំណាច ជា ព្រះរាជអាជ្ញា ជា មន្រ្តី រាជការ មក ជេរ ប្រមាថ គំរាមគំហែង បំរុង ចាប់ ព្រះអង្គ ដាក់ ក្រចក ជើង សេះ និង ដៀល ថា ព្រះសង្ឃ មេភូមិ ពុទ្ធ បរិស័ទ ថា ពួក អាពត ខ្មែរ ក្រហម សព្វ បែប យ៉ាង ។ ព្រះចៅ អធិការ វត្ត និង គណៈកម្មការ វត្ត សូម អំពាវនាវ ឲ្យ ថ្នាក់ដឹកនាំ ជូយ រក យុត្តិធម៌ ជូន ពុទ្ធ បរិស័ទ ទាំងអស់ គ្នា ផង ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន លោក ដូណាល់ ត្រាំ បាន បញ្ជាក់ យ៉ាង ខ្លី ដូច្នេះ ថា « បើ ទោះបីជា មាន ការខ្វែងគំនិត គ្នា ទាំង បញ្ហា គោល នយោបាយ និង នយោបាយ ក៏ដោយ ក៏ ខ្ញុំ នៅតែ គោរព ដដែល ចំពោះ ការបម្រើ ការងារ ជូន ប្រទេស ជាតិ របស់ សមាជិក ព្រឹទ្ធសភា លោក John McCain... ដូច្នេះ ខ្ញុំ បញ្ជា ឱ្យ បង្ហូត ទង់ជាតិ ត្រឹម ពាក់កណ្ដាល រហូតដល់ ប្រារព្ធ ពិធី បញ្ចុះ សព របស់ លោក នៅ ថ្ងៃអាទិត្យ សប្ដាហ៍ នេះ » ។
មន្ត្រី នគរបាល សេដ្ឋកិច្ច បាន ថ្លែង ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នា ព្រឹក ថ្ងៃទី ២៨ ខែសីហា នេះ ឱ្យដឹង ថា ទីតាំង ខុស ច្បាប់ មួយ នេះ មិន ត្រឹមតែ ស្តុក គ្រឿង សម្អាង ក្លែងក្លាយ ប៉ុណ្ណោះ ទេ ថែមទាំង ជា ទីតាំង ផលិត កែច្នៃ វេចខ្ចប់ និង ចែកចាយ គ្រឿង សម្អាង ក្លែងក្លាយ ក្នុង កន្លែង តែ មួយ ផងដែរ ។
មន្ត្រី ដដែល បាន បន្ត ថា ក្រោម ការសម្របសម្រួល នីតិវិធី ពី លោក ស្រី ម៉ាក នី ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ប្រតិបត្តិការ មួយ នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ ដោយ ឃាត់ខ្លួន ម្ចាស់ ទីតាំង ម្នាក់ ឈ្មោះ អ៊ុច សម្បត្តិ អាយុ ៣៣ ឆ្នាំ ។
កម្លាំង សមត្ថកិច្ច ចម្រុះ ក៏ បាន រកឃើញ និង ដកហូត ភស្តុតាង មួយចំនួន រួម មាន៖ ឡេ ក្រែម សាប៊ូ និង វត្ថុធាតុ ដើម ជាច្រើន ទៀត សរុប ចំនួន ១៧មុខ បើ គិត ជា ទម្ងន់ ប្រមាណ ៤.៥តោន ( ៤តោន កន្លះ ) និង ម៉ាស៊ីន លាយ ម៉ាស៊ីន ច្រក ម៉ាស៊ីន អ៊ុត ម៉ាស៊ីន កាត់ និង បាញ់ ខ្យល់ ។
ក្រោយពី ត្រួតពិនិត្យ និង តាម ការសម្រេច របស់ លោក ព្រះរាជអាជ្ញា រង កម្លាំង សមត្ថកិច្ច បាន ដកហូត និង រក្សាទុក នូវ ភស្តុតាង ដែល រកឃើញ ព្រមទាំង រៀបចំ បិទ ទីតាំង ខុស ច្បាប់ ខាងលើ តែម្ដង ចំណែកឯ ជនសង្ស័យ ជា ម្ចាស់ ទីតាំង ឈ្មោះ អ៊ុច សម្បត្តិ ត្រូវបាន នាំ ទៅ សាកសួរ បំភ្លឺ នៅ នាយកដ្ឋាន នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច មុន បន្ត នីតិវិធី នៅ សាលាដំបូង រាជធានី ភ្នំពេញ ៕
សូម ជម្រាប ថា ប្រតិបត្តិការ បង្ក្រាប ទីតាំង ផលិត កែច្នៃ វេចខ្ចប់ ស្តុក និង ចែកចាយ គ្រឿង សម្អាង ខុស ច្បាប់ មួយ នេះ ត្រូវបាន ធ្វើឡើង បន្ទាប់ពី ប្រតិបត្តិការ បង្ក្រាប ទីតាំង ផលិត និង វេចខ្ចប់ ប៊ី ចេង ក្លែងក្លាយ នៅ ខណ្ឌ ឫស្សីកែវ ដូចគ្នា ដែល ដកហូត បាន ប៊ី ចេង ក្លែងក្លាយ យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ ៕
ស្ថាន តំណាង កម្ពុជា នៅ ប្រទេស ចិន ម៉ាឡេស៊ី ឥណ្ឌូនេស៊ី និង ស្ថាន អគ្គកុងស៊ុល កម្ពុជា ប្រចាំ ទីក្រុង សៀងហៃ អន្តរាគមន៍ ជួយ ពលរដ្ឋ ខ្មែរ ចំនួន ២៦ នាក់ ឱ្យ បាន ត្រឡប់មក មាតុភូមិ វិញ
( ភ្នំពេញ ) ៖ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្ដរជាតិ នៅ ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន មួយ ដោយ បញ្ជាក់ ឱ្យដឹង ថា ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ប្រទេស ចិន ម៉ាឡេស៊ី ឥណ្ឌូនេស៊ី និង ស្ថាន អគ្គកុងស៊ុល កម្ពុជា ប្រចាំ ទីក្រុង សៀងហៃ ប្រទេស ចិន បាន បន្ដ អន្ដរាគមន៍ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ខ្មែរ ចំនួន ២៦ នាក់ ឱ្យ បាន ត្រឡប់មក មាតុភូមិ វិញ ។
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបរទេស បាន បញ្ជាក់ ថា៖
១៖ ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ប្រទេស ចិន បាន សហការ ជាមួយ អាជ្ញាធរ មាន សមត្ថកិច្ច របស់ ចិន ធ្វើ អន្តរាគមន៍ ជួយ សង្រ្គោះ និង រៀបចំ មាតុភូមិ និវត្តន៍ របស់ ស្រ្តី ខ្មែរ ចំនួន ៧នាក់ ដែល ត្រូវបាន មេ ខ្យល់ បោក បញ្ឆោត នាំ ទៅ រៀបការ ដោយ ខុស ច្បាប់ ជាមួយ បុរស ជនជាតិ ចិន នៅក្នុង ប្រទេស ចិន ហើយ ពួកគេ បាន មកដល់ កម្ពុជា វិញ នៅ ថ្ងៃទី ០៩ និង ទី២៣ ខែសីហា ឆ្នាំ ២០១៨ ។
២៖ ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ប្រទេស ម៉ាឡេស៊ី បាន សហការ ជាមួយ អាជ្ញាធរ មាន សមត្ថកិច្ច របស់ ម៉ាឡេស៊ី រៀបចំ មាតុភូមិ និវត្តន៍ របស់ ពលករ - ពល ការិនី ខ្មែរ ចំនួន ៧នាក់ ( ស្រី ១នាក់ ) មកពី ខេត្ត ក្រចេះ ខេត្ត កណ្តាល ខេត្ត កំពង់ចាម ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត បាត់ដំបង ដែល បាន ទៅ ធ្វើការ ដោយ ខុស ច្បាប់ នៅ ប្រទេស ម៉ាឡេស៊ី ហើយ មាន បំណង ត្រឡប់មក កម្ពុជា វិញ ។ ពលករ - ពល ការិនី ទាំង ៧នាក់ បាន មកដល់ កម្ពុជា វិញ ចន្លោះ ពី ថ្ងៃទី ០៤ ដល់ ទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ ។
៣៖ ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ប្រទេស ឥណ្ឌូនេស៊ី បាន ជួយ សម្របសម្រួល រៀបចំ មាតុភូមិ និវត្តន៍ របស់ ពលករ នេសាទ ខ្មែរ ចំនួន ២នាក់ មាន អាយុ ២៨ ឆ្នាំ និង ៣៦ ឆ្នាំ មកពី ខេត្ត កំពង់ធំ ដែល ត្រូវបាន អាជ្ញាធរ ឥណ្ឌូនេស៊ី ឃាត់ខ្លួន ក្រោយពី ទូក នេសាទ ដែល ពួកគេ ធ្វើ ការ បាន ចូលក្នុង ដែន ទឹក ឥណ្ឌូនេស៊ី ។ ពលករ ទាំង ២នាក់ នោះ បាន ត្រឡប់ មកដល់ កម្ពុជា វិញ នៅ ល្ងាច ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ ។
ការលើកឡើង របស់ អ្នកនាំពាក្យ រូប នេះ បន្ទាប់ពី មាន មតិ មួយចំនួន បាន លើកឡើង ថា នៅ កម្ពុជា ដល់ រដូវ ដោះលែង បន្ទាប់ពី មាន ការដោះលែង អ្នកទោស មួយចំនួន ដូចជា អតីត សកម្មជន បក្ស សង្គ្រោះ ជាតិ អ្នកនយោបាយ អ្នកសារព័ត មាន សកម្មជន ដីធ្លី នា ថ្មី ៗ នេះ ។
អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ការចាប់ ជនល្មើស និង ការដោះលែង ទណ្ឌិត គ្មាន រដូវកាល នោះ ទេ » ។ លោក សុខ ឥសាន្ត បាន បញ្ជាក់ ឲ្យដឹង ថា « អ្វី ទៅជា រដូវ ចាប់ និង រដូវ ដោះលែង ។ តាម ការពិត ជាក់ស្តែង នៅ កម្ពុជា ក៏ ដូចជា នៅ តាម បណ្តា ប្រទេស លេី ពិភពលោក ការចាប់ ចង និង ការដោះលែង ជន ល្មេីស ច្បាប់ គ្មាន រដូវ ទេ ឲ្យ តែ ពេលណា ប្រព្រឹត្ត ល្មើស ច្បាប់ ខុស ច្បាប់ នោះ ជន ល្មេីស ច្បាប់ នឹង ត្រូវ ចាប់ខ្លួន ជា មិន ខាន » ។
លោក បាន បន្ត ថា ចំណែក ការដោះលែង ជនជាប់ចោទ និង ទណ្ឌិត ក៏ ដូច្នេះ ដែរ គ្មាន រដូវកាល ទេ វា អាស្រ័យ លេី សាច់រឿង របស់ សាមីជន និង ករណី នីមួយ ៗ ។ ដូច្នេះ ការ ដែល និយាយ ថា មាន រដូវ ចាប់ និង រដូវ ដោះលែង នោះ ហាក់ដូចជា មាន ចេតនា ចោទ ថា ជា ផែនការចាប់ ចង និង ដោះលែង ដោយ មិន ផ្អែក លេី បញ្ហា បទល្មេី ស និង នីតិវិធី របស់ ស្ថាប័ន តុលាការ ទាល់តែសោះ ។ ហេតុ នេះ មុននឹង និយាយ ស្តី សូម ស្នេី អ្នក ដែល មាន សិទ្ធិ និយាយ មេត្តា ពិចារណា ផង កុំ ចេះតែ ពឺត ទាំង មិន ដឹង ខ្យល់ នោះ ។
សូម បញ្ជាក់ ថា នា ថ្មី ៗ នេះ ព្រះមហាក្សត្រ តាម សំណើ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ដោះលែង សមាជិក បក្ស ប្រឆាំង ១៤រូប ខាងលើ ។ ក្រៅពី នោះ អ្នកនយោបាយ អ្នកវិភាគ នយោបាយ សកម្មជន ដីធ្លី រួមទាំង អតីត អ្នកសារព័ត៌មាន មួយចំនួន ទៀត ដែល ត្រូវ ចាប់ខ្លួន ក្នុង ពេល ប្រព្រឹត្ត បទល្មើស កាលពី អំឡុង ឆ្នាំ ២០១៦ និង ២០១៧ កន្លងទៅ នេះ ក៏ ត្រូវបាន ដោះលែង ឱ្យ មាន សេរីភាព ផងដែរ ។
អ្នកនយោបាយ និង អ្នកវិភាគ រួមទាំង អ្នកលេង បណ្តាញ សង្គម Facebook មួយចំនួន បាន សម្តែង ការសាទរ ចំពោះ ការដោះលែង ជន ទាំងនោះ ហើយ ចាត់ទុក ថា ការដោះលែង ឱ្យ មាន សេរីភាព នេះ ជា ការធ្វើឱ្យ បរិយាកាស នយោបាយ នៅក្នុង ប្រទេស កម្ពុជា មាន ភាពប្រសើរឡើង មួយ កម្រិត ទៀត ៕
គួរ ជម្រាប ថា ប្រព័ន្ធ មីស៊ីល S-400 ដែល ក្នុង មួយ ឈុត មាន តម្លៃ ប្រមាណ ៤០០ លាន ដុល្លារ នេះ ក៏ ត្រូវបាន រុស្ស៊ី ដាក់ពង្រាយ ដើម្បី ការពារ មូលដ្ឋាន ទ័ព អាកាស របស់ ខ្លួន នៅក្នុង ប្រទេស ស៊ីរី ផងដែរ ៕
ការលើកឡើង បែប នេះ របស់ ក្រសួង ការពារ ជាតិ ជប៉ុន ធ្វើឡើង នៅក្នុង សៀវភៅ ស ប្រចាំ ឆ្នាំ មួយ ចេញផ្សាយ នៅ ថ្ងៃអង្គារ នេះ ខណៈ សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងជើង កំពុង តឹង សសៃក ដាក់ គ្នា ក្រោយ លោក ដូណាល់ ត្រាំ បញ្ជា ឱ្យ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក លោក ម៉ៃក៍ ប៉ុម ប៉េ លុបចោល ដំណើរទស្សនកិច្ច ទៅកាន់ ទីក្រុង ព្យុងយ៉ាង ដែល ដំបូង ឡើយ គ្រោង នឹង ប្រព្រឹត្តទៅ នៅក្នុង សប្ដាហ៍ នេះ ។
នៅក្នុង សៀវភៅ ស ដដែល ក្រសួង ការពារ ជាតិ ជប៉ុន បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « សកម្មភាព យោធា របស់ កូរ៉េ ខាងជើង នៅតែ ជា ការ គំរាមកំហែង ដ៏ ធំ ដល់ សន្តិសុខ ជាតិ ជប៉ុន .. . ហើយ យើង ត្រូវតែ ចាំបាច់ រក្សា ការ យកចិត្តទុកដាក់ ខ្ពស់ បំផុត ក្នុង ការឃ្លាំមើល សកម្មភាព របស់ កូរ៉េ ខាងជើង ក្នុង ការរំសាយ អាវុធ នុយក្លេអ៊ែរ និង មីស៊ីល របស់ ពួកគេ » ។
គួរ ជម្រាប ថា ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ធ្លាប់ បាន លើកឡើង ជាសាធារណ ថា កូរ៉េ ខាងជើង លែង ក្លាយជា ការ គំរាមកំហែង នុយក្លេអ៊ែរ ទៀត ហើយ បន្ទាប់ពី លោក បាន ជួប ជាមួយ លោក គីម ជុង អ៊ុន នៅក្នុង ប្រទេស សិង្ហបុរី កាលពី ខែមិថុនា កន្លងទៅ ៕
ម្យ៉ាង វិញ ទៀត ការលុបចោល នេះ ទៀតសោត ធ្វើឡើង តែ ប៉ុន្មាន ម៉ោង ប៉ុណ្ណោះ ក្រោយ អង្គការ សហ ប្រជាជាតិ បាន ចោទប្រកាន់ ថា ប្រមុខ យោធា មីយ៉ាន់ម៉ា រូប នេះ និង មន្ត្រី យោធា មួយចំនួន ទៀត គឺជា អ្នកទទួលខុសត្រូវ លើ ការកាប់ សម្លាប់ ជនជាតិ រ៉ូហ៊ីងយ៉ា និង គួរតែ ត្រូវបាន ចោទប្រកាន់ ពី បទ ប្រល័យ ពូជសាសន៍ និង បទឧក្រិដ្ឋកម្ម ប្រឆាំង នឹង មនុស្សជាតិ ៕
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ពី ស្ថានភាព កម្ពស់ ទឹក ជំនន់ នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ប្រចាំ ថ្ងៃទី ២៨ ខែសីហា នេះ
( ហ្សាកាតា - ប៉ាឡាំ បាំង ) ៖ ជូនពរ អត្តពលិក កម្ពុជា ដណ្ដើម បាន មេដាយ ជូន ជាតិ បន្ថែម ! អត្តពលិក កម្ពុជា ៣ប្រភេទ កីឡា នឹង បន្ដ ការប្រកួត ក្នុង ព្រឹត្តិការណ៍ កីឡា អាស៊ី Asian Games លើក ទី១៨ នៅ ប្រទេស ឥណ្ឌូនេស៊ី ថ្ងៃ នេះ រួម មាន កីឡា ទូក ក្ដោង អត្តពលកកម្ម ហើយ ពិសេស គឺ កីឡា សូហ្វ តេន្នីស ដែល ត្រូវ ចាប់ផ្ដើម ការប្រកួត ថ្ងៃ ដំបូង របស់ ខ្លួន ស្រប ពេល កីឡា នេះ ត្រូវបាន ថ្នាក់ដឹកនាំ ដាក់ ការរំពឹង ខ្ពស់ ក្នុង ការ ដណ្ដើម មេដាយ មាស បន្ថែម ។
អតីត សមាជិក បក្ស ប្រឆាំង ទាំង ១៤ រូប ដែល ត្រូវបាន លើកលែង ទោស នេះ រួម មាន៖
អ្នក ទាំង ១១នាក់ ខាងលើ នេះ ត្រូវបាន តុលាការ សម្រេច ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ក្នុង ម្នាក់ ៗ កំណត់ រយៈពេល ០៧ ឆ្នាំ ពី បទ ចូលរួម ធ្វើ កុបកម្ម ។
គួរ កត់សម្គាល់ ផងដែរ ថា អ្នក ទាំង ១៤រូប ខាងលើ បាន សម្រច ដក បណ្តឹង សាទុក្ខ និង បណ្តឹង បណ្តឹង ឧទ្ធរណ៍ នា ព្រឹក ម៉ិញ នេះ ដែល នាំឲ្យ សាលក្រម និង សាល ដីកា របស់ តុលាការ បាន ចូល ជា ស្ថាពរ ដែល ជា ផ្នែក មួយ នៃ ការខិតខំ ប្រឹងប្រែង ដើម្បី បញ្ចប់ សំណុំរឿង នេះ តាម នីតិវិធី ច្បាប់ និង ឈាន ទៅ ស្នើសុំ លើកលែង ទោស ។
គួរ បញ្ជាក់ ថា សេដ្ឋកិច្ច អ៉ីរ៉ង់ បាន ជួប បញ្ហា ចាប់តាំងពី លោក ដូណាល់ ត្រាំ ចេញ បញ្ជា ឱ្យ ដក សហរដ្ឋ អាមេរិក ចេញ ពី កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ អ៉ី រ៉ង់ ឆ្នាំ ២០១៥ ដើម្បី ដាក់ទណ្ឌកម្ម សេដ្ឋកិច្ច លើ អ៉ី រ៉ង់ សា ជា ថ្មី ។ រីឯ អ្នកជំនាញ ខ្លះ យល់ ថា ទីក្រុង វ៉ាស៊ីនតោន ចង់ ប្រើ ទណ្ឌកម្ម នេះ ដាក់ សម្ពាធ លើ របប ដឹកនាំ ទីក្រុង តេហេរ៉ង់ ឱ្យ ដក កងទ័ព ចេញ ពី ស៊ីរី និង ចង់ឱ្យ សេដ្ឋកិច្ច អ៉ី រ៉ង់ ចលាចល រហូតដល់ បង្ខំឱ្យ ប្រជាជន អ៉ី រ៉ង់ ងើបឡើង ប្រឆាំង នឹង រដ្ឋាភិបាល អ៉ីរ៉ង់ សព្វ ថ្ងៃ ៕
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ឱ្យ លើកលែង ទោស ដល់ លោក មាជ សុវណ្ណារ៉ា និង សមាជិក អតីត គណបក្ស ប្រឆាំង ចំនួន ១៣នាក់ ផ្សេង ទៀត ឱ្យ មាន សេរីភាព ឡើងវិញ ហើយ ក្រោយពី មាន សំណើ ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។ នេះ បើ យោង តាម ព្រះរាជ ក្រឹត្យ ដែល អង្គភាព ព័ត៌មាន ទើប ទទួលបាន មុន នេះ បន្តិច នា ព្រលប់ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ នេះ ។
តាម ប្រភព ព័ត៌មាន ច្បាស់ ការ ពី សាលាដំបូង រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា ការដោះលែង អ្នក ទាំង ១៤ នេះ នឹង ត្រូវ ធ្វើឡើង នៅ ថ្ងៃស្អែក ទី ២៨ ខែសីហា ឆ្នាំ ២០១៨ ។
* អ្នក ជាប់ ទោស ទាំង ១៤ នាក់ នេះ បាន ធ្វើ លិខិត គោរព ស្នើសុំ លើកលែង ទោស ទៅ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០១៨ ។ នៅក្នុង លិខិត គោរព ជូន សម្តេច តេជោ ហ៊ុន សេន បាន សរសេរ នៅក្នុង កម្មវត្ថុ ថា « សំណើ សុំ សម្តេច តេជោ ហ៊ុន សែន មេត្តា ជួយ អន្តរាគមន៍ ស្នើ លើកលែង ទោស ឲ្យ យើងខ្ញុំ ទាំងអស់ គ្នា បាន រួច ផុត ទោស និង មាន សេរីភាព » ។
ការសម្រេច ដោះលែង ទណ្ឌិត ១៤នាក់ ដែល ជា សមាជិក បក្ស ប្រឆាំង នេះ ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ប្រកាស បើក ការលើកលែង ទោស ទ្រង់ទ្រាយ ធំ ដល់ ទណ្ឌិត នៅក្នុង ប្រទេស កម្ពុជា នៅ អំឡុង បុណ្យ ភ្ជុំ បិណ្ឌ ឬ បុណ្យ អុំ ទូក ខាង ខាងមុខ នេះ ។
អតីត តំណាងរាស្ដ្រ គណបក្ស សង្គ្រោះ ជាតិ លោក អ៊ុំ សំអាន ត្រូវបាន ដោះលែង ចេញ ពី ពន្ធ គារ មុន គេ គឺ នៅ វេលា ម៉ោង ៤រសៀល ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៨ បន្ទាប់ពី ព្រះមហាក្សត្រ នៃ កម្ពុជា តាម សំណើ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង បន្ទាប់ពី ទទួលបាន លិខិត គោរព ស្នើសុំ លើកលែង ទោស ពី លោក អ៊ុំ សំអាន ។
អ្នកនយោបាយ និង អ្នកវិភាគ រួមទាំង អ្នកលេង បណ្តាញ សង្គម Facebook មួយចំនួន បាន សម្តែង ការសាទរ ចំពោះ ការដោះលែង ជន ទាំងនោះ ហើយ ចាត់ទុក ថា ការដោះលែង ឱ្យ មាន សេរីភាព នេះ ជា ការធ្វើឱ្យ បរិយាកាស នយោបាយ នៅក្នុង ប្រទេស កម្ពុជា មាន ភាពប្រសើរឡើង មួយ កម្រិត ទៀត ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨
១៖ ការពិត នៅ ពីក្រោយ នៃ ការដោះលែង មន្ដ្រី អតីត គណបក្ស សង្គ្រោះ ជាតិ ត្រូវ លាតត្រដាង ទាំងស្រុង មិន មែន មកពី គំនាប ឬ ទណ្ឌកម្ម អន្ដរជាតិ នោះ ឡើយ ( ចុច អាន )
៥៖ ប្រមុខ ការទូត កម្ពុជា នឹង ទៅ បំពេញ ទស្សនកិច្ច នៅ ប្រទេស សិង្ហបុរី រយៈពេល ៣ ថ្ងៃ ក្នុង គោលបំណង ពង្រឹង ចំណង មិត្តភាព និង សហប្រតិបត្តិការ ( ចុច អាន )
៩៖ ប៊ី ចេង ក្លែងក្លាយ ដ៏ ច្រើន សន្ធឹកសន្ធាប់ ត្រូវ កម្លាំង សមត្ថកិច្ច ចម្រុះ ដកហូត ពី ក្នុង ទីតាំង ១កន្លែង នៅ ខណ្ឌ ឫស្សីកែវ ( ចុច អាន )
១៣៖ អ្នកជំនាញ អារ្យធម៌ ខ្មែរ៖ តើ ការបង្កើត ឧត្ដមប្រឹក្សា ផ្ដល់ និង ពិគ្រោះយោបល់ ក្នុង របប ប្រជាធិបតេយ្យ មាន តម្លៃ យ៉ាងណា ? ( ចុច អាន )
១៖ នៅ ទីបំផុត សហរដ្ឋ អាមេរិក ប្រកាស ដាក់ទណ្ឌកម្ម លើ រុស្ស៊ី ជា ផ្លូវការ ហើយ ពាក់ព័ន្ធ ការចោទប្រកាន់ រឿង បំពុល មន្ត្រី ចារកម្ម .. . ( ចុច អាន )
៣៖ អ្នកវិភាគ ដ៏ ល្បាញ ល្បី៖ មរណភាព របស់ ចន ម៉ាក់ ខេន ស្មើ ការស្លាប់ នៃ និមិត្តរូប បដិវត្តន៍ ពណ៌ ( ចុច អាន )
៥៖ គំរោង ល្អ ៗ រវាង កូរ៉េ ទាំង ពីរ នឹង រង ផល ប៉ះពាល់ ដោយសារ ដំណើរទស្សនកិច្ច រដ្ឋមន្ត្រី ការបរទេស អាមេរិក នៅ ព្យុងយ៉ាង ត្រូវ លុបចោល ! ( ចុច អាន )
៦៖ កូរ៉េ ខាងជើង៖ អាមេរិក កំពុង លួច ចាក់ កូរ៉េ ខាងជើង ពីក្រោយ ខ្នង តាមរយៈ សមយុទ្ធ ទ័ព អាកាស នៅ ជប៉ុន ( ចុច អាន )
៨៖ ខ្មាន់ កាំភ្លើង ម្នាក់ បាញ់ សម្លាប់ មនុស្ស ពីរ នាក់ នៅឯ រដ្ឋ ផ្ល័រីដា សហរដ្ឋ អាមេរិក ( ចុច អាន )
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៧ ខែសីហា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ១៥៧ គ្រឿង និង ផាក ពិន័យ ១៤៤ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ២.០១២ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៤៥៧ គ្រឿង ( ម៉ូតូ ៧៥ ភាគរយ ) អប់រំ១៤៤ គ្រឿង និង ផាក ពិន័យ ៣១៣ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៧ ខែសីហា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ១. ៣៦៧ គ្រឿង . អប់រំ ៨៤ គ្រឿង និង ផាក ពិន័យ ចំនួន ២៥៦ គ្រឿង ។
ជាមួយគ្នា នេះ ក៏ សូម ឱ្យ មាន ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត ឬ ពេទ្យ ស្រុក ខេត្ត ចុះ មក ប្រចាំ ការ ឬ មក ជួយ ពិនិត្យ ព្យាបាល ជម្ងឺ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ញឹកញាប់ ផង ក្នុង ស្ថានភាព ទឹក លិច មូលដ្ឋាន ទាំងស្រុង បែប នេះ ដូចនេះ អាច ប្រឈម ខ្ពស់ នឹង ជម្ងឺ ដង្កាត់ ផ្សេង ៗ រួមទាំង សត្វ ពាហនៈ ផងដែរ ៕ អភិបាល ខេត្ត កំពត ឲ្យ លុបចោល អាជ្ញាប័ណ្ណ កកាយ ភ្នំ ណា ដែល មាន ភាព មិន ប្រក្រតី និង ផ្អាក ចេញ អាជ្ញាប័ណ្ណ ទាំង អស់ មួយ រយៈ សិន
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ពិភាក្សា និង ផ្តល់ យោបល់ លើ ការកំណត់ គម្រោង បង្កើត តំបន់ ការពារ ធម្មជាតិ ថ្មី ចំនួន ៤ ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពត ។
លោក បាន បន្ត ថា ក្នុង គោលបំណង ជួយ រក្សា លំនឹង បរិស្ថាន និង លើកកម្ពស់ ជីវភាព របស់ ប្រជា សហគមន៍ មូលដ្ឋាន តាមរយៈ ការបង្កើត សេវាកម្ម ទេសចរណ៍ ធម្មជាតិ វប្បធម៌ ជំនឿ និង មាន តម្លៃ មហាសាល ផ្សេង ៗ ទៀត ជា មូលហេតុ ត្រូវ រក្សា ការពារ និង អភិរក្ស ធនធាន ធម្មជាតិ ដែល ជា ការចាំបាច់ សម្រាប់ ប្រយោជន៍ នា ពេល បច្ចុប្បន្ន និង អនាគត ។
ក្នុង កិច្ចប្រជុំ នោះ លោក អភិបាល ខេត្ត ជា វ តាយ ក៏ បាន ណែនាំ ត្រួតពិនិត្យ ឡើងវិញ រាល់ អាជ្ញាប័ណ្ណ ដែល ចេញ ដោយ រដ្ឋបាល ខេត្ត កំពត ហើយ ចាប់តាំងពីរ រូបលោក ចូលមកកាន់ តំណែង ជា អភិបាល ខេត្ត កំពត មក មិន ដែល បាន ចេញ អាជ្ញាប័ណ្ណ ណាមួយ ឲ្យ បុគ្គល ណា ម្នាក់ កកាយ ភ្នំ នោះ ទេ ហើយ លោក នឹង ផ្អាក អាជ្ញាប័ណ្ណ ឬ លុបចោល ទាំងស្រុង ប្រសិនបើ ក្រោយ ការត្រួតពិនិត្យ ឃើញ មាន ភាព មិន ប្រក្រតី ។
ពាក់ព័ន្ធ នឹង ការចេញ អាជ្ញាប័ណ្ណ របស់ រដ្ឋបាល ខេត្ត លោក កំពុង មាន វិធានការ ផ្អាក មួយ រយៈ រាល់ អាជ្ញាប័ណ្ណ ទាំងអស់ ដើម្បី សិក្សា ត្រួតពិនិត្យ ឬ លុបចោល ទាំងស្រុង ដើម្បី រក្សា ការពារ កុំ ឲ្យ មាន បញ្ហា កើតឡើង នៅពេល ការអនុវត្ត អាជ្ញាប័ណ្ណ ទាំងនោះ ៕
( ភ្នំពេញ ) ៖ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០១៨ ត្រូវ ចាប់ផ្តើម ពី ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០១៨ រហូតដល់ ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ ។ នេះ បើ យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ គជប ដែល ទើប ចេញផ្សាយ នៅ ថ្ងៃទី ២៧ ខែសីហា នេះ ។
លោក ម៉ុក ដារ៉ា អគ្គ លេខាធិការ រង គ.ជ. ប បាន បញ្ជាក់ ថា ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០១៨ នេះ មាន គោលដៅ ធានា ឲ្យ បញ្ជី បោះឆ្នោត មាន ភាព ពេញលេញ ភាពត្រឹមត្រូវ និង មាន បច្ចុប្បន្នភាព ប្រកបដោយ សុវត្ថិភាព តាមរយ៖
២៖ ការកែតម្រូវ ឈ្មោះ ឬ ទិន្នន័យ អ្នកបោះឆ្នោត តាម សំណើ សុំ របស់ សាម៉ីខ្លួន ដោយ មាន ឯកសារ សំអាង ត្រឹមត្រូវ ។
បើ តាម អគ្គ លេខាធិការ រង រូប នេះ បន្ទាប់ពី ទទួលបាន ទិន្នន័យ អំពី ការចុះឈ្មោះ បោះឆ្នោត គ.ជ. ប នឹង រៀបចំ ជាបញ្ជី បោះឆ្នោត ដំបូង ដើម្បីឲ្យ ប្តឹង តវ៉ា ឬ ប្តឹង ជំទាស់ ហើយ ពេល បញ្ចប់ ការដោះស្រាយ បណ្តឹង គ.ជ. ប នឹង ផ្តល់ សុពលភាព ជា បញ្ជី បោះឆ្នោត ផ្លូវការ ឆ្នាំ ២០១៨ ៕
រដ្ឋសភា ចេញ សេចក្ដីជូនដំណឹង ពី ការយាង របស់ ព្រះមហាក្សត្រ ជា ព្រះរាជ អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ បើក សម័យ ប្រជុំ រដ្ឋសភា នីតិកាល ទី៦ លើក ដំបូង នៅ ថ្ងៃទី ០៥ ខែកញ្ញា
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា នឹង យាង ជា ព្រះរាជ អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ ក្នុង សម័យ ប្រជុំ ដំបូង រដ្ឋសភា នីតិកាល ទី៦ ដែល នឹង ប្រព្រឹត្តទៅ វេលា ម៉ោង ០៨ ព្រឹក ថ្ងៃទី ០៥ ខែកញ្ញា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង របស់ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា ដែល ចេញ នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ ។
អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា បាន បញ្ជាក់ ថា បន្ទាប់ពី ពិធី បើក សម័យ ប្រជុំ ដំបូង សម័យ ប្រជុំ រដ្ឋសភា លើក ទី១ នីតិកាល ទី៦ នឹង ផ្ដើម ការងារ ក្រោម អធិបតីភាព សម្ដេច ពញា ចក្រី ហេង សំរិន ព្រឹទ្ធ សមាជិក រដ្ឋសភា ដើម្បី សម្រេច អំពី សុពលភាព នៃ អាណត្តិ របស់ សមាជិក នីមួយ ៗ និង ការអនុម័ត បទបញ្ជា ផ្ទៃក្នុង នៃ រដ្ឋសភា នីតិកាល ទី៦ ។
ដោយឡែក នៅ ថ្ងៃទី ០៦ ខែកញ្ញា រដ្ឋសភា នឹង ធ្វើ ការបោះឆ្នោត ដើម្បី ជ្រើសតាំង ប្រធាន អនុប្រធាន រដ្ឋសភា ប្រធាន អនុប្រធាន គណៈកម្មាការ ជំនាញ ទាំងអស់ នៃ រដ្ឋសភា និង ផ្ដល់ សេចក្ដីទុកចិត្ត ចំពោះ រាជ រដ្ឋាភិបាល ៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល អំពាវនាវ អាជ្ញាធរ និង គ្រូពេទ្យ សហការ ជាមួយ កម្មវិធី ជាតិ អាហារូបត្ថម្ភ ដើម្បី បង្កើន ចំនួន មន្ទីរពេទ្យ ស្រឡាញ់ ទារក ឱ្យ បាន នៅ ទូទាំង ខេត្ត
( ប៉ៃលិន ) ៖ លោកស្រី សាស្ត្រាចារ្យ តាន់ វួច ឆេង រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន លើកឡើង ថា ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង គ្រូពេទ្យ នៃ មន្ទីរ សុខាភិបាល ខេត្ត ត្រូវ យកចិត្តទុកដាក់ សហការ ជាមួយ កម្មវិធី ជាតិ អាហារូបត្ថម្ភ និង ដៃគូរ អភិវឌ្ឍន៍ ឱ្យ បាន ល្អ ដើម្បី បង្កើន ចំនួន មន្ទីរពេទ្យ ស្រឡាញ់ ទារក ឱ្យ បាន នៅ ទូទាំង ខេត្ត ខណៈ មកដល់ ពេលនេះ ខេត្ត ប៉ៃលិន គឺ មាន ចំនួន តែ ១កន្លែង ប៉ុណ្ណោះ ។
លោកស្រី សាស្ត្រាចារ្យ តាន់ វួច ឆេង បាន ថ្លែង បែប នេះ នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ រួម ជាមួយ លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន បាន អញ្ជើញ ក្នុង ប្រកាស ទទួលស្គាល់ ជា មន្ទីរពេទ្យ ខេត្ត ជា មន្ទីរពេទ្យ ស្រឡាញ់ ទារក ព្រមទាំង មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ អស់ លោក លោកស្រី ប្រធាន មន្ទីរ ជំនាញ ជុំវិញ ខេត្ត អាជ្ញាធរ មូលដ្ឋាន គ្រូពេទ្យ តំណាង អង្គការ ជា ដៃគូ និង ប្រជាពលរដ្ឋ ជា ម្តាយ យ៉ាង ច្រើន កុះករ ។
លោកស្រី រដ្ឋលេខាធិការ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង គ្រូពេទ្យ នៃ មន្ទីរ សុខាភិបាល ខេត្ត ត្រូវ យកចិត្តទុកដាក់ សហការ ជាមួយ កម្មវិធី ជាតិ អាហារូបត្ថម្ភ និង ដៃគូរ អភិវឌ្ឍន៍ ឱ្យ បាន ល្អ ដើម្បី បង្កើន ចំនួន មន្ទីរពេទ្យ ស្រឡាញ់ ទារក ឱ្យ បាន នៅ ទូទាំង ខេត្ត ខណៈ មកដល់ ពេលនេះ ខេត្ត ប៉ៃលិន គឺ មាន ចំនួន តែ ១កន្លែង ប៉ុណ្ណោះ » ។
ទន្ទឹម ការអនុវត្តន៍ មន្ទីរពេទ្យ ស្រឡាញ់ ទារក មន្ទីរ សុខាភិបាល ខេត្ត បាន ពង្រីក ការអនុវត្តន៍ សហគមន៍ ស្រឡាញ់ ទារក ផងដែរ ដោយ បាន បណ្តុះបណ្តាល ដល់ មេភូមិ និង ក្រុម ទ្រទ្រង់ សុខភាព ភូមិ ចំនួន ៤១ ភូមិ ដើម្បីឱ្យ ពួកគាត់ ជួយ ដល់ ម្តាយ ៗ ដែល ចាកចេញ ពី មន្ទីរពេទ្យ ក៏ ដូចជា ម្តាយ ៗ និង អ្នកថែទាំ ក្នុង សហគមន ទទួលបាន ការអប់រំ ចេះ វិធីសាស្ត្រ ល្អ ៗ ក្នុង ការអនុវត្ត កិច្ចការ ចិញ្ចឹម កូន ឱ្យ មាន សុខភាពល្អ ។
សូម បញ្ជាក់ ថា នៅ ឆមាស ទី១ ឆ្នាំ ២០១៨ នេះ នៅ ទូទាំង ខេត្ត ប៉ៃលិន មាន អ្នកជំងឺ ព្យាបាល នៅ តាម មន្ទីរពេទ្យ និង មណ្ឌល សុខភាព ចំនួន ២៧៨៨ នាក់ ស្លាប់ ចំនួន ០៦ នាក់ ស្មើនឹង ០. ២២% ស្ត្រី ដែល សំរាល កូន មាន ចំនួន ៧៨១ នាក់ និង មក ពិនិត្យ ផ្ទៃពោះ ចំនួន ៥. ៥៤៩ នាក់ ៕
ក្រុមការងារ បច្ចេកទេស កំពុង ធ្វើ ការផ្លាស់ប្តូរ បង្គោល ថ្មី នៅ ទីតាំង ខាងលើ និង ពុំ មាន ការដាច់ចរន្ត អគ្គិសនី ទេ ៕ បង្ក្រាប បទល្មើស នេសាទ ទ្រង់ទ្រាយ ធំ នៅ ស្រុក ស្រីសន្ធ រ ស្រុក ស្ទឹងត្រង់ ស្រុក កង មាស ខេត្ត កំពង់ចាម ដកហូត វត្ថុតាង មួយចំនួន ធំ និង លែង កូន ត្រី ជាង ៥០០ គីឡូក្រាម ចូល បឹង
( កំពង់ចាម ) ៖ កម្លាំង សមត្ថកិច្ច ចម្រុះ ខេត្ត កំពង់ចាម រួម មាន កម្លាំង នគរបាល ខេត្ត . ខណ្ឌ រដ្ឋបាល ជលផល សហគមន៍ នេសាទ និង អាជ្ញាធរ មូលដ្ឋាន នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន បើក ប្រតិបត្តិការ ទ្រង់ទ្រាយ ធំ ដោយ ចុះបង្ក្រាប បទល្មើស នេសាទ ខុស ច្បាប់ នៅ ស្រុក ស្រីសន្ធ រ ស្រុក ស្ទឹងត្រង់ និង ស្រុក កង មាស ដោយ រឹបអូស បាន វត្ថុតាង បាន មួយចំនួន ធំ និង ចាក់ លែង កូន ត្រី ជាង ៥០០ គីឡូក្រាម ចូល បឹង វិញ ។
សម្រាប់ ប្រតិបត្តិការ ទី៣៖ លោក បាន បញ្ជា អធិការ នគរបាល ស្រុក កង មាស សហការ ជាមួយ ខណ្ឌ រដ្ឋបាល ជលផល បាន ចុះបង្រ្កាប បទល្មើស នេសាទ ខុស ច្បាប់ នៅក្នុង ភូមិសាស្ត្រ ឃុំ ស្តៅ ស្រុក កង មាស ជា លទ្ធផល ដកហូត បាន លូស្បៃ មុង ចំនួន ៨៣ មាត់ . របាំង ព្រួល ប្រវែង ៤. ១៥០ម៉ែត្រ និង ចាក់ លែង កូន ត្រី ចម្រុះ ចូល បឹង ធម្មជាតិ ចំនួន ២០៧ គីឡូក្រាម ។ ចំពោះ សម្ភារ វត្ថុតាង ទាំងអស់ បាន ដុត បំផ្លាញ ចោល នៅនឹង កន្លែង ដោយ មាន ការឯកភាព ពី លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ចាម ៕
ឥណ្ឌា ធ្វើតេស្ត យន្តហោះ ប្រើ ជីវៈ ឥន្ធនៈ ជា លើក ដំបូង !
( ញូ ដេលី ) ៖ យន្ដហោះ ប្រើប្រាស់ ថាមពល ជីវៈ ឥន្ធនៈ ដំបូង គេ របស់ ប្រទេស ឥណ្ឌា បាន ធ្វើតេស្ដ ហោះហើរ សាកល្បង ជា ផ្លូវការ ហើយ នៅ ថ្ងៃចន្ទ នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃចន្ទ ទី២៧ ខែសីហា ឆ្នាំ ២០១៨ ។
ចំណែកឯ ថាម ជីវៈ ឥន្ធនៈ សម្រាប់ ការហោះហើរ សាកល្បង របស់ យន្ដហោះ Q400 ត្រូវ អភិវឌ្ឍ ឡើង ដោយ វិទ្យាស្ថាន រដ្ឋ ឥន្ធនៈ និង កាកសំណល់ កសិកម្ម មាន មូលដ្ឋាន នៅក្នុង ទីក្រុង Dehradun ។ បន្ថែម ពីលើ នេះ បើសិនជា ការធ្វើតេស្ដ នេះ ទទួល ជោគជ័យ ឥណ្ឌា នឹង ចូលរួម ក្នុង ក្រុម នៃ ប្រជាជាតិ ជាច្រើន ក្នុង នោះ រួម មាន ទាំង សហរដ្ឋ អាមេរិក និង អូស្ត្រាលី ផងដែរ ក្នុង នាម ជា ប្រទេស មាន ការប្រើប្រាស់ ជីវៈ ឥន្ធនៈ ក្នុង វិស័យ អាកាសចរណ៍ ។
រដ្ឋមន្ដ្រី ក្រសួង កសិកម្ម បើក កិច្ចប្រជុំ បន្ទាន់ មួយ ដើម្បី ដោះស្រាយ បញ្ហា ជូន បងប្អូន ប្រជាកសិករ ដែល រងគ្រោះ ធម្មជាតិ ឲ្យ ទាន់ ពេលវេលា
( ភ្នំពេញ ) ៖ ទទួលបាន បទបញ្ជា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី កាលពី ថ្ងៃទី ២៣ ខែសីហា កន្លងទៅ . នា ព្រឹក ទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ នេះ លោក វេង សាខុន រដ្ឋមន្ដ្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ដឹកនាំ កិច្ចប្រជុំ ផ្ទៃក្នុង ក្រសួង បន្ទាន់ មួយ ដើម្បី ដោះស្រាយ បញ្ហា ជូន បងប្អូន ប្រជាកសិករ ឲ្យបាន ទាន់ ពេលវេលា នៅ ទីស្តីការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ។
កិច្ចប្រជុំ ផ្ទៃ របស់ ក្រសួង កសិកម្ម ខាងលើ នេះ រៀបចំ ធ្វើឡើង ក្នុង គោលបំណង សំខាន់ ៗ ចំនួន ៤រួម មាន៖
ទី១៖ បូកសរុប ផល ប៉ះពាល់ លើ ដំណាំ រួមផ្សំ ដំណាំ កសិឧស្សាហកម្ម ពិសេស ដំណាំ ស្រូវ និង សត្វ ពាហនៈ ដែល ត្រូវបាន ទទួលរង ការខូចខាត ដោយ គ្រោះ ធម្មជាតិ ( ទឹក ជំនន់ និង រាំងស្ងួត ) នៅ តាម បណ្តា ខេត្ត ដែល ទទួលរងគ្រោះ ។
ទី២៖ រៀបចំ ផែនការ សកម្មភាព ចុះ អន្តរាគមន៍ ជាបន្ទាន់ តាម ការចាំបាច់ ដើម្បី ធ្វើ ការស្តារ ឡើងវិញ នៃ ការខូចខាត ។
ទី៣៖ សិក្សា ពី តម្រូវការ ចំបាច់ របស់ ប្រជាកសិករ និង លទ្ធភាព នៃ ការផ្គត់ផ្គង់ របស់ ក្រសួង ដូចជា ស្រូវ ពូជ គ្រាប់ ពូជ ដំណាំ គ្រប់ ប្រភេទ និង ថ្នាំ ការពារ ជំងឺ ឆ្លង សត្វ ។
ទី៤៖ ការដាក់ចេញ នូវ វិធានការ មួយចំនួន ដែល ត្រូវ ធ្វើ ដោយ កាត់បន្ថយ ឲ្យបាន ជា អតិបរមា ក្នុង ការអង្គុយ បក់ ផ្សែង ។
ជាមួយគ្នា នោះ ក្រសួង ក៏ បាន ធ្វើ ការបូកសរុប របាយការណ៍ ជាបន្ទាន់ ដាក់ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី ដើម្បី ពិនិត្យ រួច ស្នើសុំ វិធានការ ដោះស្រាយ បញ្ហា ជូន បងប្អូន ប្រជាកសិករ ឲ្យបាន ទាន់ ពេលវេលា ឲ្យ ទទួលបាន ប្រសិទ្ធភាព និង ប្រសិទ្ធផល ។
( ប៉ាគីស្ថាន ) ៖ អ្នកស្រាវជ្រាវ ផ្នែក កសិកម្ម ជនជាតិ ចិន និង ប៉ាគីស្ថាន បាន ទទួល ជោគជ័យ យ៉ាង ធំធេង លើ ការបង្កាត់ ពូជ ស្រូវ សាលី ដែល មាន គុណភាព ខ្ពស់ ជាច្រើន ពូជ តាមរយៈ ការប្រើប្រាស់ ពូជ ស្រូវ សាលី កូន កាត់ ពីរ ជួរ របស់ ចិន នៅ ប្រទេស ប៉ាគីស្ថាន ចាប់តាំងពី ឆ្នាំ ២០១៦មក ។
កាលពី ខែវិច្ឆិកា ២០១៦ ដើម្បីឱ្យ ប៉ាគីស្ថាន អាច បំពេញ ឱ្យ គ្រប់ តម្រូវការ ដ៏ ធំ នៃ ស្រូវ សាលី ជា ពូជ ដំណាំ ដែល សំខាន់ បំផុត នៅ ប្រទេស នេះ អ្នកស្រាវជ្រាវ វិទ្យាសាស្ត្រ ទាំងនេះ បាន ចាប់ផ្តើម សាកល្បង ដាំ ស្រូវ សាលី កូន កាត់ របស់ ចិន ហើយក៏ បាន រកឃើញ ធាតុ ពិត នៃ ធម្មជាតិ របស់ គ្រាប់ ស្រូវ សាលី នៅ មន្ទីរពិសោធន៍ មួយ នៅ សាកលវិទ្យាល័យ ផេសាវ៉ា (Peshawar) ។
លោក ម៉ូហាមេ ដ អារីហ្វ កសិករ កសិដ្ឋាន សាកល្បង របស់ សាកលវិទ្យាល័យ ផេសាវ៉ា និយាយ ថា « នេះ គឺជា ចំការ របស់ ខ្ញុំ ដែល ខ្ញុំ ដាំ ស្រូវ សាលី កូន កាត់ ដែល ទទួលបាន ពី មជ្ឈមណ្ឌល ស្រាវជ្រាវ វិស្វកម្ម ប៉េកាំង នៅ ប្រទេស ចិន ។ យើង បាន ធ្វើតេស្ត ស្រូវ សាលី កូន កាត់ នេះ នៅលើ ដី ចំការ នេះ ។ នៅ ខាងក្រោយ ខ្ញុំ នេះ គឺជា ចំការ ដែល យើង ដាំ ស្រូវ ជា ជួរ ៗ ។ ភាគ ច្រើន នៃ ដំណាំ ទាំង នេះ គឺ បាន ផល ខ្ពស់ ល្អ ណាស់ » ។
បើ ទោះជា បាន ទទួល ជោគជ័យ យ៉ាង លឿន ក៏ដោយ ក៏ អ្នកស្រាវជ្រាវ ទាំងនេះ នៅតែ ព្យាយាម រិះរក វិធី ថ្មី ៗ ដើម្បី ធ្វើឱ្យ ស្រូវ សាលី ទាំងនេះ បន្សាំ ខ្លួន បាន កាន់តែ ល្អ ទៅនឹង បរិស្ថាន នៅ ទីនេះ ព្រមទាំង ការពារ សត្វ ល្អិត និង ជំងឺ ផងដែរ ។
លោក អ៊ីក បាល់ មូន័រ នាយក វិទ្យា សា្ថន ជីវបច្ចេកវិទ្យា និង វិស្វកម្ម ហ្ស៊ែន សាកលវិទ្យាល័យ ផេសាវ៉ា និយាយ ថា « អញ្ជឹង ស្រូវ សាលី កូន កាត់ មាន សមត្ថភាព ទប់ទល់ នឹង បញ្ហា អស់ ទាំងនេះ និង អាច បង្កើន ទិន្នផល ស្រូវ សាលី ជាង ទ្វេ ដង ឯណោះ ព្រមទាំង អាច ធានា បាន ដល់ សន្តិសុខ ស្បៀង ទាំង សម្រាប់ ប្រទេស យើង ផង និង សម្រាប់ ពិភពលោក ទាំងមូល ផង » ។
ប៉ាគីស្ថាន បាន ទទួល កំណើន ផលិតកម្ម ស្រូវ សាលី និង បច្ចេកវិទ្យា សម្រាប់ កសិកម្ម ក្រោយពី បាន ប្រើ ពូជ ស្រូវ សាលី កូន កាត់ ជាច្រើន ពូជ របស់ ប្រទេស ចិន ។ ពូជ ស្រូវ សាលី កូន កាត់ ទាំងនេះ ក៏ បាន អភិវឌ្ឍ កាន់តែ ល្អ ជាង មុន ដែរ បើ និយាយ អំពី ភាពសុំាំ និង ភាព មាន ប្រៀប របស់ វា បើ ធៀប នឹង ពូជ ស្រូវ សាលី ផ្សេង ទៀត ។
( ព្រះសីហនុ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ នាយ ស្តីទី សេនាធិការ ចម្រុះ មេបញ្ជាការ ស្តី ទីកងទ័ព ជើងគោក បាន លើកឡើង ថា ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន គឺជា មេដឹកនាំ មួយ រូប ដែល បាន យកចិត្តទុកដាក់ ចំពោះ សុខ ទុក្ខ កងទ័ព លើកស្ទួយ ជីវភាព និង លើកតម្កើង កិត្តិយស ចំពោះ កងទ័ព និង អតីត យុទ្ធជន ចំពោះ គុណ បំណាច់ នៃ ការលះបង់ របស់ កងទ័ព គ្រប់ ជំនាន់ ។
ក្នុង ពិធី បិទ វគ្គ ហ្វឹកហ្វឺន បំប៉ន យុទ្ធ វិធី ថ្មើរជើង ឆ្នាំ ២០១៨ ប្រកាស តែងតាំង មុខងារ និង បំពាក់ ឋានន្តរស័ក្តិ ជូន នាយ ទាហាន តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះសីហនុ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ការកម្ពស់ ជីវភាព នេះ គឺ តាមរយៈ ការដំឡើង ប្រាក់ បៀវត្ស និង ការឧបត្ថម្ភ ផ្សេង ៗ ជាច្រើន ទៀត ហើយ ប្រមុខ រាជ រដ្ឋាភិបាល លើកទឹកចិត្ត និង បង្ក លក្ខណៈ ឲ្យ មហាជន គាំទ្រ និង ផ្ដល់ តម្លៃ កងទ័ព តាមរយៈ ការឧបត្ថម្ភ គាំទ្រ ដល់ កងទ័ព និង អតីត យុទ្ធជន ។
លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ក៏ បាន នាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដូចជា ពីសំណាក់ ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ អគ្គ បញ្ជាការ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៅក្នុង តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះសីហនុ ។
បើ តាម លោក ហ៊ុន ម៉ាណែត ការងារ ស្នូល របស់ កងយោធពល ខេមរភូមិន្ទ គឺ ត្រៀមលក្ខណៈ ការពារ ជាតិ របស់ យើង ។ ហេតុ ដូច្នេះ សូមឲ្យ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ ស្មោះត្រង់ ដាច់ខាត ចំពោះ ជាតិ សាសនា ព្រះមហាក្សត្រ ប្ដេជ្ញា ការពារ រដ្ឋធម្មនុញ្ញ ព្រះមហាក្សត្រ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល ចេញពី ការបោះឆ្នោត ។
( ភ្នំពេញ )៖ គណៈកម្មការរៀបចំ ការបោះឆ្នោត រាជធានី ភ្នំពេញ សហការ ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បើក សន្និបាត បូកសរុប លទ្ធផល ការងារ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ឆ្នាំ ២០១៨ ដើម្បី ស្វែងរក ចំណុច ខ្លាំង ចំណុច ខ្សោយ និង បញ្ហា ប្រឈម ផ្សេង ទៀត ជា ទុន យកមក អនុវត្ត នៅ អាណត្តិ ក្រោយ ៗ ទៀត ។
ពិធី នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៧ ខែសីហា ដោយ មាន ការចូលរួម ពី លោក ម៉ប់ សារិន ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ . លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ . លោក មាន ចាន់ យ៉ាដា អភិបាល រង រាជធានី ភ្នំពេញ និង មន្ត្រី តំណាង គណបក្ស ទាំង១៩ ដែល មាន សមាជិក សមាជិកា ចូលរួម ជាង ៤០០ នាក់ ។
លោក លុន ឆេង កៃ ប្រធាន គណៈកម្មការរៀបចំ ការបោះឆ្នោត រាជធានី ភ្នំពេញ ក្នុង ឱកាស នោះ បាន ថ្លែង ពី មោទនភាព ចំពោះ លទ្ធផល ល្អ ប្រសើរ នៃ ដំណើរការឃោសនា ពេល បោះឆ្នោត និង រាប់ សន្លឹក ឆ្នោត និង ថ្លែងអំណរគុណ ដល់ រដ្ឋបាល រាជធានី ភ្នំពេញ ដែល បាន ផ្តល់ កិច្ចសហការ យ៉ាង ល្អ ប្រសើរ ពិសេស លើ បញ្ហា សន្តិសុខ សណ្តាប់ធ្នាប់ សំរាប់ ការបោះឆ្នោត កន្លងមក នេះ ។
ថ្លែង បិទ សន្និបាត ក្នុង ព្រឹក ថ្ងៃ ដដែល នេះ លោក ឃួង ស្រេង បាន គូសបញ្ជាក់ ថា ដំណើរការ រៀបចំ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ឆ្នាំ ២០១៨ បាន ប្រព្រឹត្តទៅ យ៉ាង ល្អ ប្រសើរ បើ ប្រៀបធៀប ទៅនឹង ការបោះឆ្នោត មុន ៗ ។
លោក អភិបាល បាន ថ្លែងអំណរគុណ ដល់ គណបក្ស នយោបាយ ទាំង១៩ ក្នុង ចំណោម គណបក្ស ទាំង២០ ដែល បាន ចូលរួម ប្រកួតប្រជែង ក្នុង រាជធានី ភ្នំពេញ ទាំង ការឃោសនា បោះឆ្នោត និង រាប់ សន្លឹក ឆ្នោត ហើយ ដែល មិន បាន បង្ក ការលំបាក ដល់ អាជ្ញាធរ និង បាន បង្ហាញ ពី ភាពចាស់ទុំ របស់ គណបក្ស នយោបាយ ទាំងអស់ ក្នុង ការគោរព ច្បាប់ និង ការអនុវត្ត នូវ លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស នៅ កម្ពុជា ។
នា ឱកាស នោះ ដែរ លោក ឃួង ស្រេង បាន ប្រគល់ បណ្ណ័ស សើរ និង លិខិត សរសើរ ជាច្រើន សន្លឹក ជូន តំណាង កម្លាំង មាន សមត្ថកិច្ច ទាំង ២ភេទ មន្ត្រី រដ្ឋបាល រាជធានី អាជ្ញាធរ ខណ្ឌ ទាំង ១២ និង មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី ភ្នំពេញ ដែល បាន ជួយ សំរួល និង សហការ ក្នុង ការរៀបចំ ការបោះឆ្នោត ឲ្យ ដំណើរការ ទៅ ទទួលបាន លទ្ធផល ល្អ ប្រសើរ និង សំរាប់ ធ្វើជា បទពិសោធន៍ សំរាប់ ការរៀបចំ ការបោះឆ្នោត នា ពេល ខាងមុខ ទៀត ៕
ឧកញ៉ា ពុង ឃាវ សែ៖ ប្រទេស ចិន គឺជា ដៃគូ ពាណិជ្ជកម្ម ដ៏ សំខាន់ និង ជា ប្រភព វិនិយោគ ធំ ជាង គេ របស់ កម្ពុជា !
( ភ្នំពេញ ) ៖ ឧកញ៉ា ពុង ឃាវ សែ ប្រធាន សមាគម សម្ព័ន្ធ ខ្មែរ - ចិន នៅ កម្ពុជា បាន លើកឡើង ថា ប្រទេស ចិន គឺជា ដៃគូ ពាណិជ្ជកម្ម ដ៏ សំខាន់ និង ជា ប្រភព វិនិយោគ ធំ ជាង គេ របស់ កម្ពុជា ។ តាមរយៈ ការអនុវត្ដ យុទ្ធសាស្ដ្រ ខ្សែក្រវាត់ មួយ ផ្លូវ មួយ អ្នក វិនិយោគ ចិន កាន់តែ ច្រើន បាន មក បណ្ដាក់ទុន នៅ កម្ពុជា នាំមក នូវ ឱកាស អភិវឌ្ឍ សម្រាប់ ប្រទេស កម្ពុជា ។
ការលើកឡើង បែប នេះ ក្នុង ឱកាស ដែល ឧកញ៉ា ពុង ឃាវ សែ អញ្ជើញ ចូលរួម ក្នុង ពិធី ជប់លៀង ស្វាគមន៍ គណៈប្រតិភូ សហព័ន្ធ ពាណិជ្ជករ ចិន ទា ជីវ សកលលោក (TXCS) ដែល រៀបចំ ធ្វើឡើង ក្រោម អធិបតីភាព លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច នៅក្នុង អាគារ City Hall កោះ ពេជ្រ នា ថ្ងៃទី ២៦ ខែសីហា ឆ្នាំ ២០១៨ ។
ឧកញ៉ា ពុង ឃាវ សែ បាន លើកឡើង ផងដែរ ថា ពាណិជ្ជករ ចិន ទា ជីវ គឺជា ក្រុម ពាណិជ្ជកម្ម ចិន ដ៏ មាន ឥទ្ធិពល លើ ឆាក អន្ដរជាតិ ។ ដោយសារ បរិយាកាស ភូមិសាស្ដ្រ ពិសេស ចិន ទា ជីវ ធ្វើ ជំនួញ ពាណិជ្ជកម្ម មាន ប្រវិត្ដិ យូរ លង់ ណាស់ មកហើយ បុគ្គលិក លក្ខណៈ ចិន ទា ជីវ ដែល ចូលចិត្ត ធ្វើ ជំនួញ នៅ ក្រៅ មក នាំឲ្យ ពួកគាត់ រស់ នៅ ពាសពេញ គ្រប់ តំបន់ នៅ សកលលោក ។
ប្រធាន សមាគម សម្ព័ន្ធ ខ្មែរ - ចិន រូប នេះ បាន បញ្ជាក់ ថា « ការខិតខំ ប្រឹងប្រែង របស់ ក្រុម ពាណិជ្ជករ ចិន ទា ជីវ មិន ត្រឹមតែ អភិវឌ្ឍន៍ មុខរបរ ខ្លួន ប៉ុណ្ណោះ ទេ ថែមទាំង រួមចំណែក អភិវឌ្ឍន៍ សេដ្ឋកិច្ច ប្រទេស ដែល កំពុង រស់ នៅ » ។
ឧកញ៉ា ពុង ឃាវ សែ បាន បន្ថែម ទៀត ថា កម្ពុជា គឺជា ប្រទេស ដែល កំណើន សេដ្ឋកិច្ច មាន ស្ថេរភាព នៅ តំបន់ អាស៊ី អាគ្នេយ៍ និង ជា សមាជិក ស្ថាបនិក នៃ ធនាគារ វិនិយោគ ហេដ្ឋារចនាសម្ព័ន្ធ អាស៊ី ក៏ ជា ប្រទេស ដ៏ សំខាន់ មួយ តាម បណ្ដោយ យុទ្ធសាស្ដ្រ ខ្សែក្រវាត់ មួយ ផ្លូវ មួយ ដូចនេះ មាន តម្រូវការ ខ្លាំង ចំពោះ ទុន វិនិយោគ ពី ក្រៅ ប្រទេស ។
ឧកញ៉ា បន្ដ ថា បច្ចុប្បន្ន កម្ពុជា មាន ស្ថេរភាព សេដ្ឋកិច្ច រីកចម្រើន ហើយ ត្រូវ ចាត់ទុក ជា ប្រទេស មាន នយោបាយ វិនិយោគ បើក ទូលាយ ជាង គេ នៅក្នុង ចំណោម ប្រទេស អាស៊ាន ។ ជាពិសេស រាជ រដ្ឋាភិបាល អាណ្ណ ត្ដិ ថ្មី ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន គេ មាន ទំនុកចិត្ត កាន់តែ ខ្លាំង ចំពោះ សេដ្ឋកិច្ច បន្ដ រីកចម្រើន របស់ ប្រទេស កម្ពុជា ។
ថ្មី ៗ នេះ ពាណិជ្ជករ ចិន ទា ជីវភាព កាន់តែ ច្រើន បាន មក កម្ពុជា ហើយក៏ មាន បង្កើត ជា សមាគម ពាណិជ្ជកម្ម ផង ។ លើក នេះ គណៈប្រតិភូ សហព័ន្ធ ពាណិជ្ជកម្ម ចិន ទា ជីវ សកលលោក មាន សមភាព៤២ នាក់ សុទ្ធសឹងតែ ជា ពាណិជ្ជករ ឆ្នើម លើ វិស័យ អចលទ្រព្យ ហិរញ្ញវត្ថុ កសិកម្ម ឧស្យាហកម្ម បច្ចេកវិទ្យា ទំនើប វេជ្ជសាស្ដ្រ ជីវបច្ចេកវិទ្យា - ល - ។
« ខ្ញុំ ជឿជាក់ ថា តាមរយៈ កម្មវិធី សន្និសីទ សេដ្ឋកិច្ច ឆ្នាំ នេះ ក្រុម ពាណិជ្ជករ ចិន ទា ជីវកាន់តែ យល់ ពី សក្ដានុពល កម្ពុជា នឹង ឈានដល់ ធ្វើ ការសម្រេចចិត្ត វិនិយោគ នៅ កម្ពុជា » ។ នេះ ជា ការគូសបញ្ជាក់ របស់ ឧកញ៉ា ពុង ឃាវ សែ៕ វប្បធម៌ ជួយ សង្គ្រោះ ក្នុង គ្រា ក្រ ! ស្ដ្រី ក្រីក្រ ឈឺ ពោះ សម្រាល កូន គ្មាន មធ្យោបាយ ធ្វើដំណើរ ទៅ ពេទ្យ ត្រូវបាន អាវុធហត្ថ ខេត្ត ស្ទឹងត្រែង ជួយសង្គ្រោះ យ៉ាង យកចិត្ត ទុដាក់
( ស្ទឹងត្រែង ) ៖ ស្ដ្រី ដែល មាន ជីវភាព ក្រីក្រ ម្នាក់ រស់ នៅ ភូមិ ឆ្វាំង ឃុំ សំអាង ស្រុក ថា ឡាបរិវ៉ាត់ ខេត្ត ស្ទឹងត្រែង ឈឺ ពោះ សម្រាល កូន ប៉ុន្ដែ គ្មាន មធ្យោបាយ ដើម្បី ធ្វើដំណើរ ទៅ មន្ទីរពេទ្យ ឡើយ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ នេះ ។
ដោយ ឃើញ ស្ថានភាព បែប នេះ និង ទទួលបាន ព័ត៌មាន ភ្លាម ៗ លោក ឧត្តមសេនីយ៍ ត្រី អៀង វ៉ាន់ ឌី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ស្ទឹងត្រែង ចាត់ កម្លាំង ក្រោម ឱវាទ យក រថយន្ដ ដើម្បី ធ្វើ ការដឹកជញ្ជូន ស្ដ្រី ខាងលើ ទៅកាន់ មន្ទីរពេទ្យ ដើម្បី សម្រាល កូន ។
ទង្វើ មនុស្សធម៌ នេះ ត្រូវបាន លោក ឧត្តមសេនីយ៍ ត្រី មេបញ្ជាការ គូសបញ្ជាក់ ថា ក្រោម ការណែនាំ និង បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការស្ដី ទី នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ដោយ មិន មើល រំលង ប្រជាពលរដ្ឋ ណា ម្នាក់ នោះ ទេ ហើយក៏ មិន បណ្ដោយ ឲ្យ ពលរដ្ឋ ណា ជួប ការលំបាក ដែរ គឺ ត្រូវតែ យកចិត្តទុកដាក់ ទាំងអស់ ។
បន្ទាប់ពី បញ្ជូន ទៅដល់ មន្ទីរពេទ្យ និង សម្រាល កូន បាន ដោយ សុវត្ថិភាព ហើយ នោះ លោក ឧត្តមសេនីយ៍ ត្រី អៀង វ៉ាន់ឌី ក៏ បាន ឧបត្ថម្ភ នូវ អំណោយ មួយចំនួន រួម មាន អង្ករ ២០ គីឡូក្រាម . ទឹក សុទ្ធ ០២ យួរ . ទឹកត្រី ០១ យួរ . ទឹក ស៊ីអ៊ីវ០១ យួរ និង ប្រាក់ ចំនួន ២០ ម៉ឺន រៀល ផងដែរ ។
គួរ រំលឹក ថា ទង្វើ មនុស្សធម៌ នេះ មិន មែន ទើបតែ លើក ទី១ ឡើយ ដែល កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ស្ទឹងត្រែង ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ត្រី អៀង វ៉ាន់ ឌី បាន ធ្វើ ចំពោះ ប្រជាពលរដ្ឋ ពោល កន្លងមក កម្លាំង អាវុធហត្ថ តែងតែ យកចិត្តទុកដាក់ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ គ្រប់ ពេល មិន ថា ទឹក ជំនន់ ឬ ពលរដ្ឋ ណា ជួប ការខ្វះខាត ជាដើម ៕ ក្រុម អ្នកវិទ្យាសាស្ត្រ អង់គ្លេស ត្រៀម បញ្ជាក់ មូលហេតុ នៃ អាយុកាល ដ៏ វែង អន្លាយ នៃ ជំនាន់ ដាយណូស័រ !
ក្រុម អ្នកស្រាវជ្រាវ នៅ សាកលវិទ្យាល័យ Kent បាន ឲ្យដឹង ការខិតខំ របស់ ពួកគេ បាន គាស់កកាយ រកឃើញ ពី អាថ៌កំបាំង នៃ ហ្សែន (Gene) ដែល នៅ ពីក្រោយ មូលហេតុ ថា តើ ហេតុ អ្វី បានជា សត្វ ដាយណូស័រ មាន រូបរាង និង ទំហំ ខុស ៗ គ្នា ច្រើន បែប នេះ ។ ភាពខុសគ្នា យ៉ាង សម្បូរ បែប នេះ បាន ជួយ ឲ្យ ប្រភេទ សត្វ យក្ស ទាំងនេះ វិវត្តន៍ ខ្លួន យ៉ាង ឆាប់រហ័ស ដើម្បី សម្រប ការ ការប្រែប្រួល នៃ បរិស្ថាន ជុំវិញ ហើយ ជួយ ពួកវា ឲ្យ គ្រប គ្រង់ លើ ផែនដី បាន អស់ រយៈពេល ប្រមាណ ១៨០ លាន ឆ្នាំ ។
យ៉ាងណា ក៏ដោយ ក្រុម អ្នកវិទ្យាសាស្ត្រ នៅ មិន ទាន់ បញ្ចេញ របាយការណ៍ និង លទ្ធផល សិក្សា ជា ផ្លូវការ នៅឡើយ ទេ ដោយ វា កំពុង ស្ថិត នៅក្នុង ការចងក្រង នៅឡើយ ប៉ុន្តែ អ្វី ដែល គេ ប្រាកដ ច្បាស់ នោះ គឺ វា នឹង បង្ហាញ អំពី មូលហេតុ នៃ ការបន្តពូជពង្ស របស់ ដាយណូស័រ ដែល មាន ច្រើន ប្រភេទ និង រយៈពេល រាប់ រយ លាន ឆ្នាំ ដែល ខុសពី មនុស្សលោក យើង ទើបតែ មាន វត្តមាន លើ ផែនដី ជាង ១លាន ឆ្នាំ មក នេះ ប៉ុណ្ណោះ ។
គួរ ជម្រាប ថា ទោះបីជា ហ្សែន របស់ ពួកវា មាន ភាពអស្ចារ្យ ខ្លាំង ក៏ដោយ បញ្ហា ប្រឈម ចុងក្រោយ ដែល ដាយណូស័រ ពុំ អាច យកឈ្នះ បាន នោះ គឺ ការធ្លាក់ ស្រោច មក លើ ផែនដី នៃ កម្ទេច អាចម៍ផ្កាយ ដ៏ ច្រើន សន្ធឹកសន្ធាប់ កាលពី ៦៦លាន ឆ្នាំ មុន ដែល បាន ធ្វើឲ្យ អម្បូរ សត្វ យក្ស ទាំងអស់ នេះ បាត់ ចេញ ពី ផែនដី លើកលែងតែ ពពួក មាន ស្លាប ចេះ ហោះ ដែល បាន វិវត្តន៍ មក ក្លាយជា សត្វ បក្សី ៕
លើស ពី នោះ ក្នុង ឱកាស ប្រគុំតន្ដ្រី « វស្សា នាំ សំណាង របស់ ភេសជ្ជៈ ប៉ូវ កម្លាំង ហ្សូរ៉ាស់ » នឹង ធ្វើ ការចាប់ឆ្នោត លើក ទី១ ដែល បាន ផ្តល់ នូវ អ្វី ដែល អស្ចារ្យ មិន ធ្លាប់ មាន គឺ ការចែក រង្វាន់ ម៉ូតូ Zomer X ទូរស័ព្ទ ធុង ទឹកកក កង្ហា និង ភេសជ្ជៈ ហ្សូរ៉ាស់ រាប់ រយ កេស ដោយ បន្ថែម ពីលើ រង្វាន់ ក្រោម ក្រវិល កំប៉ុង ដែល កំពុង មាន ស្រាប់ ។ រាល់ ការជា វភេសជ្ជៈ ហ្សូរ៉ាស់ លោក អ្នក នឹង មាន ឱកាស ឈ្នះ រង្វាន់ ទ្វេ ដង ។
កម្លាំង សមត្ថកិច្ច ខេត្ត ព្រះសីហនុ ឃាត់ ជនជាតិ ចិន ៣នាក់ ដោយ ដកហូត បាន ថ្នាំ ញៀន និង វត្ថុតាង មួយចំនួន ធំ
( ព្រះសីហនុ) ៖ នា ព្រឹក ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០១៧ នេះ បាន បញ្ជាក់ ថា កម្លាំង សមត្ថកិច្ច ចម្រុះ ខេត្ត ព្រះសីហនុ បាន សហការ គ្នា ចុះ ពង្រឹង សន្តិសុខ សណ្ដាប់ធ្នាប់ តាម មូលដ្ឋាន ជាប់ ជាប្រចាំ ហើយ ក្នុង ពេល ប្រតិបត្តិការ នោះ កម្លាំង សមត្ថកិច្ច បាន ឃាត់ ជនសង្ស័យ ជនជាតិ ចិន ៣នាក់ ( ២ករណី ផ្សេង គ្នា ) ដោយ ដកហូត បាន ថ្នាំ ញៀន និង វត្ថុតាង មួយចំនួន ។
សមត្ថកិច្ច បាន ឱ្យដឹង ថា ករណី ទី១ ធ្វើឡើង នា ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ កម្លាំង ការិយាល័យ នគរបាល ប្រឆាំង គ្រឿងញៀន បាន ឃាត់ខ្លួន ជនជាតិ ចិន ចំនួន ២នាក់ នៅពេល កម្លាំង ចម្រុះ ចុះ ត្រួតពិនិត្យ ឆែកឆេរ អាវុធ ជាតិ ផ្ទុះ នៅ ចំណុច មុខ មន្ទីរពេទ្យ បង្អែក ខេត្ត ស្ថិត ក្នុង សង្កាត់ ៤ ក្រុង - ខេត្ត ព្រះសីហនុ ដោយ ឃើញ មាន ម្សៅ ក្រាម ពណ៌ ស ថ្លា សង្ស័យ សារធាតុ ញៀន នៅក្នុង រថយន្ត ។
ដោយ មាន ការសង្ស័យ ក៏ បាន ឃាត់ខ្លួន នាំ ទៅ ឆែកឆេរ រថយន្ត របស់ គាត់ រកឃើញ និង ដកហូត វត្ថុតាង រួម មាន៖
ករណី ទាំង ពីរ ខាងលើ នេះ កម្លាំង ជំនាញ កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ព្រះសីហនុ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕ អ្នក ជិះ បញ្ច្រាស រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត មាន . ក្នុង យប់ មិញ សមត្ថកិច្ច ឃាត់ បាន យានយន្ត ចំនួន ៨ គ្រឿង ថែម ទៀត
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៨ គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន ៨ គ្រឿង ក្នុង នោះ រួម មាន៖ ម៉ូតូ ចំនួន ៨ គ្រឿង ។
សូម ជម្រាប ថា កាលពី សប្ដាហ៍ មុន ក្រសួង ការពារ ជាតិ រុស្ស៊ី ក៏ បាន ចោទប្រកាន់ សហរដ្ឋ អាមេរិក អង់គ្លេស និង បារាំង ផងដែរ ថា កំពុង ត្រៀមខ្លួន វាយប្រហារ សា ជា ថ្មី លើ រដ្ឋាភិបាល ស៊ីរី ដោយ ប្រើ លេស ថា ទីក្រុង ដាម៉ាស់ ប្រើប្រាស់ អាវុធ គីមី ៕
សូម កុំ បើកបរ ស្ថិត ក្រោម ឥទ្ធិពល គ្រឿងស្រវឹង ! ស្លាប់ ៥នាក់ និង របួស ៩នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៧ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ . របួស ស្រាល ៣នាក់ និង របួស ធ្ងន់ ៣នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៧លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៧គ្រឿង . រថយន្ដ ធុន តូច ៧គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . មិន ប្រកាន់ ស្ដាំ . ប្រជែង . និង កត្តា យាន ។
មន្រ្តី ជាន់ ខ្ពស់ តុលាការ បាន បញ្ជាក់ ថា ការ ដែល មិន ទាន់ ដោះលែង អ្នក ទាំង ១៤ នាក់ នៅ វេលា ម៉ោង ៩៖៣០ នាទី យប់ នោះ គឺ ដោយសារ ហេតុផល សន្តិសុខ . មាន មនុស្ស យ៉ាង ច្រើន នៅ ខាងមុខ ពន្ធនាគារ ដូច្នេះ ការដោះលែង ត្រូវ ពន្យា ពេល ដល់ ពេលនេះ ( ម៉ោង ប្រមាណ ១២យប់ ) ហើយ អ្នក ទាំងអស់ គ្នា នឹង ត្រូវ កម្លាំង នគរបាល រាជធានី ភ្នំពេញ ដឹកជញ្ជូន ទៅកាន់ គេហដ្ឋាន តែ ម្តង ដោយសារ ការពារ សុវត្ថិភាព ។
របាយការណ៍ ខាងលើ ដែល ធ្វើឡើង ដោយ ក្រុម អ្នក ស៊ើបអង្កេត UN តាមរយៈ ការសាកសួរ សាក្សី រាប់ ពាន់ នាក់ ក៏ បាន ថ្កោលទោស យ៉ាង ខ្លាំង ផងដែរ ចំពោះ ហិង្សា ប្រឆាំង នឹង ជនជាតិ រ៉ូហ៊ីងយ៉ា ។ ម្យ៉ាង វិញ ទៀត នៅក្នុង របាយការណ៍ នេះ គេ ឃើញ មាន ឈ្មោះ ឧត្ដម សេនីយ៍ យោធា មីយ៉ាន់ម៉ា កំពូល ៗ ចំនួន ០៦ រូប ក្នុង នោះ រួម មាន ទាំង ប្រមុខ កងទ័ព លោក Ming Aung Hlaing សុទ្ធតែ ត្រូវបាន ចោទប្រកាន់ ថា ជា អ្នកទទួលខុសត្រូវ និង គួរតែ ត្រូវបាន ស៊ើបអង្កេត ពី បទ ប្រល័យ ពូជសាសន៍ លើ ជនជាតិ ដើម ភាគ តិច រ៉ូហ៊ីងយ៉ា ។
សូម ជម្រាប ថា របាយការណ៍ ខាងលើ ដដែល បាន ចាត់ទុក ថា រដ្ឋាភិបាល ស៊ីវិល របស់ លោកស្រី អោង សាន ស៊ូជី បាន បរាជ័យ ក្នុង ការ ការពារ ជន ស៊ីវិល និង បណ្ដោយ ឱ្យ មាន ការស្អប់ខ្ពើម ចំពោះ ជនជាតិ រ៉ូហ៊ីងយ៉ា ។ អំពើហិង្សា លើ ជនជាតិ រ៉ូហ៊ីងយ៉ា បាន ផ្ទុះឡើង កាលពី ខែសីហា ឆ្នាំ ២០១៧ បន្ទាប់ពី រដ្ឋាភិបាល ចោទ ថា ក្រុម សកម្ម ប្រយុទ្ធ រ៉ូហ៊ីងយ៉ា វាយប្រហារ លើ កងកម្លាំង សន្តិសុខ រដ្ឋាភិបាល ដែល ត្រូវបាន គេ រាយការណ៍ ថា បាន សម្លាប់ រំលោភបំពាន ផ្លូវភេទ និង បណ្ដេញ ជនជាតិ រ៉ូហ៊ីងយ៉ា ជាង ៧០០.០០០ នាក់ ទៅកាន់ ព្រំដែន បង់ក្លាដែស ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី២៧ ខែសីហា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
២៖ រដ្ឋមន្រ្តី ការបរទេស អាល្លឺម៉ង់ លោក ហៃ កូ ម៉ា អាស (Heiko Maas) បាន លើកឡើង ថា អឺរ៉ុប គួរឲ្យ គិតគូរ វាយតម្លៃ ឡើងវិញ ទៅ លើ ភាពជាដៃគូ ជាមួយ សហរដ្ឋ អាមេរិក និង បាន ទទូច ឲ្យ អឺរ៉ុប រួម គ្នា បញ្ចេញ ប្រតិកម្ម ចំពោះ គោល នយោបាយ ទាក់ទិន ការដាក់ ទណ្ឌកម្ម របស់ ទីក្រុង វ៉ាស៊ីនតោន ទៅ លើ ប្រទេស រុស្ស៊ី ចិន តួកគី ក៏ ដូចជា ដៃគូ សេដ្ឋកិច្ច សំខាន់ ៗ ឯទៀត ៗ ៕
៣៖ ទីបំផុត អ្នកវិទ្យាសាស្រ្ត អង់គ្លេស មួយ ក្រុម បាន ប្រកាស ថា ពួកគេ បាន រកឃើញ ហើយ ថា តើ DNA របស់ ដាយណូស័រ មាន លក្ខណៈ ពេញលេញ បែប ណា នោះ ៕
