( ភ្នំពេញ ) ៖ នាយក រដ្ឋមន្ត្រី វៀតណាម លោក ង្វៀន សួន ហ្វុក បាន បង្ហាញ នូវ ក្តី សោមនស្ស រីករាយ និង អបអរសាទរ ផងដែរ ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល ទទួលបាន ការគាំទ្រ បន្ត ដឹកនាំ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ក្នុង លិខិត អបអរសាទរ ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ លោក នាយក រដ្ឋមន្ត្រី វៀតណាម បាន គូស រំលេច ថា ជោគជ័យ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន គឺជា សក្ខីភាព ឆ្លុះបញ្ចាំង អំពី ទំនុកចិត្ត ដ៏ មហិមា របស់ ប្រទេសជាតិ និង ប្រជាជន កម្ពុជា ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា និយាយ ជា រួម និង ចំពោះ សម្តេច តេជោ ហ៊ុន សែន និយាយ ដោយឡែក ។
លោក ង្វៀន សួន ហ្វុក បាន បង្ហាញ ការជឿជាក់ ថា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ នឹង បន្ត រក្សា បាន នូវ សុខ សន្តិភាព ឯករាជ្យភាព អព្យាក្រឹត្យ ស្ថិរភាព និង វិបុលភាព ជាមួយនឹង ជីវភាព រស់ នៅ របស់ ប្រជាជន កាន់តែ ប្រសើរ ហើយ តួនាទី និង កិត្យានុភាព របស់ កម្ពុជា នឹង ត្រូវ បាន បន្ត ពង្រឹង ទាំង ក្នុង តំបន់ និង នៅលើ ពិភពលោក ។
លោក នាយក រដ្ឋមន្ត្រី វៀតណាម ក៏ មាន ជំនឿចិត្ត ផងដែរ ថា ក្នុង តួនាទី ជា នាយក រដ្ឋមន្ត្រី សម្តេច តេជោ ហ៊ុន សែន នឹង បន្ត រួម ចំណែក ធំ ធេង ពង្រឹង និង ធ្វើឲ្យ កាន់តែ ស៊ីជម្រៅ ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា - វៀតណាម ។
( ភ្នំពេញ ) ៖ នាយក រដ្ឋមន្ត្រី ឡាវ លោកង ថង លូន ស៊ី ស៊ូលីត បាន សម្តែង អំណរ សាទរ យ៉ាង ក្រៃលែង ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ដែល បន្ត ទទួលបាន បាន ការគាំទ្រ ធ្វើជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង អាណត្តិ ថ្មី ។
ក្នុង លិខិត អបអរសាទរ ផ្ញើ ជូន សម្តេច តេជោ ហ៊ុន សែន ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ លោក នាយក រដ្ឋមន្ត្រី ឡាវ បាន បង្ហាញ ការជឿជាក់ ថា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នឹង ធ្វើឲ្យ ទំនាក់ទំនង មិត្តភាព ក៏ ដូចជា កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អរ រវាង កម្ពុជា - ឡាវ នឹង ត្រូវ បន្ត ពង្រឹង បន្ថែម ទៀត ។
លោក នាយក រដ្ឋមន្ត្រី ឡាវ បាន ថ្លែង ថា រូប លោក ទន្ទឹងរង់ចាំ ធ្វើការ យ៉ាង ជិតស្និទ្ធ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ផលប្រយោជន៍ របស់ ប្រជាជាតិ នៃ ប្រទេស ភូមិ ផង ជាមួយគ្នា នេះ និង ដើម្បី ថាមភាព នៃ គ្រួសារ អាស៊ាន ក៏ ដូចជា ដើម្បី សន្តិភាព មិត្តភាព និង សហប្រតិបត្តិការ ក្នុង តំបន់ និង សកលលោក ៕ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល៖ ការចង់ឱ្យ ក្រុមប្រឹក្សា អឺរ៉ុប អនុម័ត លើ សំណើ សុំ ទៅ UN ឱ្យ ដក អាសនៈ ពី កម្ពុជា គឺជា មតិ ដ៏ គួរឲ្យ ស្អប់ខ្ពើម និង អាម៉ាស
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា លោក ផៃ ស៊ីផាន បាន លើកឡើង នៅ ល្ងាច ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ថា សំណើ សុំ បញ្ចូល របៀបវារៈ និង ស្នេី សភា សហគមន៍ អឺរ៉ុប ឱ្យ អនុម័ត លើ សំណើ សុំ ឱ្យ អង្គការ សហ ប្រជាជាតិ ដក អាសនៈ របស់ កម្ពុជា គឺជា សំណើ មួយ ក្នុង ភាពអាម៉ាស និង មិន ស៊ីវីល័យ គួរឲ្យ ស្អប់ខ្ពើម បំផុត ។
ការលើកឡើង របស់ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើឡើង ស្រប ពេល ដែល សភា នៃ សហភាព អឺរ៉ុប គ្រោង កោះ ប្រជុំ នៅ ថ្ងៃទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៨ ។ កិច្ចប្រជុំ នោះ ក៏ នឹង ពិភាក្សា អំពី បញ្ហា សិទ្ធិ មនុស្ស ប្រជាធិបតេយ្យ និង ច្បាប់ ផងដែរ ។ សមាជិក សភា អឺរ៉ុប មួយចំនួន ក៏ប៉ុនប៉ង លើក យក របៀបវារៈ ស្នើ ឱ្យ សភា អឺរ៉ុប អនុម័ត សំណើ មួយ ទៅ អង្គការ សហ ប្រជាជាតិ ឱ្យ ដក អាសនៈ របស់ កម្ពុជា ផងដែរ ។
លោក ផៃ ស៊ីផាន បាន លើកឡើង ទៀត ថា សេចក្ដីស្នើ នេះ បាន ឆ្លុះបញ្ចាំង នូវ អត្តចរិត ចក្រពត្តិ និង អាណានិគម ប្រឆាំង នឹង ឆន្ទៈ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ដែល មាន ចំនួន ជាង ៧០ ភាគរយ ចេញ ពី សន្លឹក ឆ្នោត សរុប នៅក្នុង ប្រអប់ ឆ្នោត ដែល មាន ជាង ៨០ ភាគរយ ចេញ ទៅ បោះឆ្នោត គាំទ្រ ជូន និង ទុកចិត្ត សម្តេច តេជោ ។
លោក បាន បន្ត ថា តាមពិត គឺ មិន ត្រឹមតែ ប្រឆាំង នឹង រាជ រដ្ឋាភិបាល នោះ ទេ គឺ ប្រឆាំង នឹង ប្រជាជាតិ ខ្មែរ តែម្តង ត្បិត ការស្រង់ មតិ ថ្មី នេះ ធ្វេី ដោយ វិទ្យុ មាន និន្នាការ ប្រឆាំង RFA បាន ផ្សព្វផ្សាយ និង ទទួលស្គាល ថា មាន ប្រជាពលរដ្ធ ចំនួន ៨៦ ភាក រយ ទទួលស្គាល់ រាជ រដ្ធាភិបាល អាណត្តិ ទី៦នេះ ។ និន្នាការចក្រពត្ដិ និង អាណានិគម បែប នេះ វា ហួស សម័យកាល ហើយ ។
លោក ផៃ ស៊ីផាន បាន បញ្ជាក់ ទៀត ថា កម្ពុជា ជា រដ្ឋ ឯករាជ្យ អធិបតេយ្យភាព និង ជា សមាជិក ពេញលេញ នៅក្នុង អង្គការ អន្ដរ រដ្ឋាភិបាល ដែល មាន ឈ្មោះ អង្គការ សហ ប្រជាជាតិ នេះ ។ រាជ រដ្ឋាភិបាល សម្ដេច តេជោ នាយក រដ្ឋមន្រ្ដី កើតឡើង ដោយ ឆន្ទៈ ប្រជាពលរដ្ឋ តាម របប ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស និង មិន មែន តាមរយៈ ចុង កាណុង នោះ ទេ ។
លោក បាន បន្ថែម ថា នៅក្នង ន័យ នេះ យ៉ាងហោចណាស់ ប្រជាជាតិ ជា មិត្ត មួយចំនួន នៅក្នុង ក្រុមប្រឹក្សា សន្ដិសុខ អង្គការ សហ ប្រជាជាតិ ក៏ ដូចជា សមាជិក ពេញ អង្គ អង្គការ សហ ប្រជាជាតិ ក៏ បាន ផ្ញើ សំបុត្រ អបអរសាទរ ជូន សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្ដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាមួយនឹង ការគោរព ទទួលស្គាល់ នូវ ជម្រើស របស់ ប្រជាពលរដ្ឋ កម្ពុជា ដែល ជា សិទ្ធិ ផ្ដាច់ មុខ ក្នុង ការទទួលខុសត្រូវ លើ ជោគវាសនា របស់ ខ្លួន ដោយ ខ្លួន ឯង ដូច ដែល បាន ចែង និង ធានា ដោយ ធម្មនុញ្ញ អង្គការ សហ ប្រជាជាតិ ៕
លោក ឌូតឺ តេ អះអាង ថា អតីត មន្ត្រី យោធា មួយចំនួន កំពុង រៀបចំ ផែនការសម្លាប់ រូបលោក
( ម៉ានីល) ៖ ប្រធានាធិបតី ហ្វីលីពីន លោក រ៉ូឌ្រីហ្គោ ឌូតឺ តេ បាន អះអាង ថា លោក មាន ភស្ដុតាង គ្រប់គ្រាន់ បង្ហាញ ថា អ្នកនយោបាយ ប្រឆំាង មួយ ក្រុម រួមទាំង ក្រុម ឧទ្ទាម ម៉ៅ និយម និង អតីត មន្ត្រី យោធា ហ្វីលីពីន មួយចំនួន កំពុង រៀបចំ ផែនការទម្លាក់ រូប លោក ពី អំណាច ឬ ក៏ សម្លាប់ លោក ចោល តែម្ដង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន Sputnik នៅ ថ្ងៃពុធ ទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
ថ្លែង នៅក្នុង សុន្ទរកថា តាម កញ្ចក់ ទូរទស្សន៍ នៅ ថ្ងៃអង្គារ សប្ដាហ៍ នេះ លោក ឌូតឺ តេ បាន លើកឡើង ដូច្នេះ ថា៖ « អ្នក ខ្លះ បាន និយាយ ថា បច្ចុប្បន្ន ពួកគេ កំពុង រៀបចំ ផែនការ ... ហើយ បើសិនជា ពួកគេ មិន អាច សម្រេច ផែនការ របស់ ពួកគេ តាមរយៈ ការវាយប្រហារ បំផ្ទុះ គ្រាប់ បែក ទេ នោះ ពួកគេ នឹង រៀបចំ គំរោង សម្លាប់ ខ្ញុំ » ។
គួរ បញ្ជាក់ ថា ប្រធានាធិបតី ហ្វីលីពីន វ័យ ៧៣ ឆ្នាំ រូប នេះ មិន បាន បញ្ជាក់ ថា តើ មាន បរទេស ចូលរួម ក្នុង ផែនការសម្លាប់ រូបលោក នោះ ទេ ដោយ គ្រាន់តែ ឱ្យដឹង ថា លោក នឹង បង្ហាញ ភស្ដុតាង ក្នុង ពេល ឆាប់ ៗ នេះ ។ តែ ទោះជា យ៉ាងណា លោក ឌូតឺ តេ ធ្លាប់ បាន ចោទប្រកាន់ CIA អាមេរិក ជារឿយ ៗ ថា អាចនឹង សម្លាប់ រូបលោក ៕
គណៈប្រតិភូ ជាន់ ខ្ពស់ កម្ពុជា អញ្ជើញ ទស្សនា ស្តង់ លក់ ផលិតផល ខ្មែរ និង សេវាកម្ម នៅក្នុង ពន្លា ជាតិ កម្ពុជា
( ណាន នីង . ក្វាង ស៊ី) ៖ នៅ ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ គណៈប្រតិភូ កម្ពុជា ដឹកនាំ ដោយ ឧប នាយក រដ្ឋមន្ត្រី ហោ ណាំ ហុង និង មាន ការចូល រូម ពី លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម និង លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ បាន អញ្ជើញ ទស្សនា ស្តង់ លក់ ផលិតផល ខ្មែរ និង សេវាកម្ម ស្ថិត នៅក្នុង ពន្លា ជាតិ កម្ពុជា ដើម្បី សំណេះសំណាល ជាមួយ អាជីវករ និង ពាណិជ្ជករ ដែល បាន ចូលរួម ព្រឹត្តិការណ៍ ពិព័រណ៍ ចិន - អាស៊ាន លើក ទី ១៥ ។
ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ត្រី ហោ ណាំ ហុង បាន ជម្រាប ជូន បងប្អូន អាជីវករ និង ពាណិជ្ជករ ទាំងអស់ អំពី កិច្ចប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្នុង ស្វែងរក ទីផ្សារ ជូន វិស័យ ឯកជន ហើយ ការចូលរួម ពិព័រណ៍ របស់ កម្ពុជា នៅក្នុង ឆ្នាំ នេះ គឺ ដើម្បី ផ្សព្វផ្សាយ អំពី ផលិតផល សក្តានុពល របស់ កម្ពុជា រួម ជាមួយ តំបន់ ទេសចរណ៍ និង វប្បធម៌ ដ៏ ល្អ ផូផង់ របស់ កម្ពុជា ទៅកាន់ ពិភពលោក សំដៅ ពង្រីក ទីផ្សារ ទាក់ទាញ វិនិយោគិន និង ភ្ញៀវ ទេសចរ បរទេស ឲ្យ ចូលមក ធ្វើ ធុរកិច្ច និង ទស្សនា កម្ពុជា កាន់តែ ច្រើន ។
បន្ទាប់មក គណៈប្រតិភូ កម្ពុជា ក៏ បាន អញ្ជើញ ពិនិត្យមើល ទំនិញ ប្រើប្រាស់ និង គ្រឿង បរិភោគ ដែល ផលិត ដោយ សហគ្រាស ធុន តូច និង ធុន ធម្យម នៅ កម្ពុជា រួម ជាមួយ សេវាកម្ម ផ្សេង ៗ រាប់ ចាប់តាំងពី វិស័យ ហិរញ្ញវត្ថុ ដល់ វិស័យ អចលន ទ្រព្យ រួមទាំង តំបន់ សេដ្ឋកិច្ច ពិសេស ផងដែរ ដែល ភាគ ច្រើន គឺជា កិច្ចសហការ រវាង ក្រុមហ៊ុន កម្ពុជា និង ក្រុមហ៊ុន វិនិយោគ ចិន ។
( កំពង់ធំ )៖ លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ នៅ ល្ងាច ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន បន្ត ដឹកនាំ ក្រុមការងារ សមាគម អតីត យុទ្ធជន ខេត្ត កំពង់ធំ ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ និង នាំយក អំណោយ មួយចំនួន របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រគល់ ជូន អតីត យុទ្ធជន ពិការ ដោយសារ សង្គ្រាម ម្នាក់ ដែល រស់ នៅ ភូមិ ស្វាយ កល្ប ឃុំ ក កោះ ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ។
អតីត យុទ្ធជន ពិការ ខាងលើ មាន ឈ្មោះ ស្រម៉ៃ ថា អាយុ ៥២ ឆ្នាំ បាន ចូល បម្រើ ការងារ ក្នុង ជួរ កងទ័ព តាំងពី ឆ្នាំ ១៩៨២ នៅ អតីត អង្គភាព កងពល ២៨៦ ហើយ បាន ធ្លាក់ខ្លួន ពិការ នៅ ឆ្នាំ ១៩៨៥ នៅក្នុង សមរភូមិ ម៉ាឡៃ ទឹកដី ប៉ៃលិន ។ ជា អកុសល ភរិយា របស់ អតីត យុទ្ធជន រូប នេះ ក៏ ជា ជនពិការ ដែរ ហើយ កំពុង មាន ជំងឺ ត្រូវ ទទួលខុសត្រូវ រាប់ រង ចិញ្ចឹម កូន ចៅ ចំនួន ៤នាក់ ថែម ទៀត ។
ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន និង ក្រុមការងារ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ បាន ពាំនាំ នូវ អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា តាមរយៈ លោក ឧត្ដមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ លេខាធិការ រង សមាគម អតីត យុទ្ធជន កម្ពុជា ផ្ដល់ជូន គាត់ នូវ អង្ករ ចំនួន ៥០ គីឡូក្រាម មី យើង ២កេះ ទឹកត្រី ទឹក ស៊ីអ៊ីវ ២យួរ និង ថវិកា ចំនួន ១០០.០០០ រៀល ។
សូម បញ្ជាក់ ថា នៅក្នុង ខែមីនា ឆ្នាំ ២០១៧ កន្លងមក គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ ក៏ បាន សាងសង់ ផ្ទះ មួយ ខ្នង ទំហំ ៤ម៉ែត្រ x៦ម៉ែត្រ ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា សម្រាប់ ផ្ដល់ជូន គាត់ និង ក្រុមគ្រួសារ ស្នាក់ នៅ រួចហើយ ៕
រដ្ឋមន្ត្រី ការបរទេស ជប៉ុន សាទ រ សម្តេច តេជោ ហ៊ុន សែន ទទួលបាន ជ័យជម្នះ បន្ត ដឹកនាំ រាជ រដ្ឋាភិបាល
( ហាណូយ . វៀតណាម ) ៖ លោក តារ៉ូ កូណូ រដ្ឋមន្រ្តី ការបរទេស ជប៉ុន បាន សម្តែង ការអបអរសាទរ ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល ទទួលបាន ជោគជ័យ លើ ការបោះឆ្នោត នា ពេល កន្លងទៅ ឈាន ទៅ ដឹកនាំ រាជ រដ្ឋាភិបាល បន្ត ទៅ ទៀត ។
ការអបអរសាទរ នេះ បាន ធ្វើឡើង ក្នុង ពេល លោក តារ៉ូ កូណូ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ មួយចំនួន ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ទីក្រុង ហាណូយ ប្រទេស វៀតណាម នៅ រសៀល ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ។
នៅ ចំពោះមុខ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី លោក តារ៉ូ កូណូ បាន លើកឡើង ថា លោក ចាប់អារម្មណ៍ យ៉ាង ខ្លាំង ពី សភាពការណ៍ ក្នុង ប្រទេស កម្ពុជា ក្រោយពី ដំណើ ការបោះឆ្នោត និង ការរៀបចំ ក្បាល ម៉ាស៊ីន ដឹកនាំ រដ្ឋសភា រាជ រដ្ឋាភិបាល ថ្មី របស់ ប្រទេស កម្ពុជា ។
សម្តេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ រៀបរាប់ ពី ការរៀបចំ ក្បាល ម៉ាស៊ីន ដឹកនាំ រដ្ឋសភា និង រាជ រដ្ឋាភិបាល ថ្មី ។
សម្តេច តេជោ បាន គូសបញ្ជាក់ ថា មកដល់ ពេលនេះ ស្ថានភាព ក្នុង ប្រទេស កម្ពុជា មាន ភាពល្អ ប្រសើរ ជាង ពេល ណា ៗ ទាំងអស់ ពោលគឺ ស្ថេរភាព នយោបាយ ស្ថេរភាព ម៉ាក្រូ សេដ្ឋកិច្ច មិន តែ ប៉ុណ្ណោះ ក្រោម គំនិត ផ្តួចផ្តើម ដោយ ផ្ទាល់ ពី សម្តេច កម្ពុជា បាន បង្កើតឡើង នូវ វេទិកា ពិភាក្សា ដែល មាន ការចូលរួម ពី គណបក្ស នយោបាយ ក្នុង ការបោះឆ្នោត សកល ឆ្នាំ ២០១៨ ដើម្បី ឈាន ទៅ បង្កើត ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ដើម្បី លើក បញ្ហា មួយចំនួន ដែល ទាក់ទិន ទៅនឹង ដំណើរការ របស់ រាជ រដ្ឋាភិបាល ។
ក្នុង ជំនួប ពិភាក្សា ការងារ នោះ ដែរ សម្តេច តេជោ និង លោក រដ្ឋមន្រ្តី ការបរទេស ជប៉ុន បាន ពិភាក្សា គ្នា យ៉ាង យកចិត្តទុកដាក់ ទៅ និង របៀបវារៈ នៃ កិច្ចប្រជុំ កំពូល មេគង្គ ជប៉ុន ដែល គ្រោង ធ្វើឡើង នៅ ខែតុលា នៅ ទីក្រុង តូក្យូ ប្រទេស ជប៉ុន ។
សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី តាមរយៈ លោក រដ្ឋមន្រ្តី ការបរទេស ជប៉ុន បាន ថ្លែងអំណរគុណ ជូន ចំពោះ លោក ស៊ិន ហ្សូ អាបេ ដែល បាន គោរព អញ្ជើញ សម្តេច បំពេញ ទស្សនកិច្ច និង អញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល មេគង្គ - ជប៉ុន នៅពេល ខាងមុខ ពិសេស អញ្ជើញ ទៅ ចូលរួម ទស្សនកិច្ច នៅ ទីក្រុង យូកូហាម៉ា ដែល ជា មូលដ្ឋាន នៃ ការបោះឆ្នោត របស់ ឯកឧត្តម រដ្ឋមន្រ្តី ការបរទេស ជប៉ុន ៕ ក្រសួង ការបរទេស ប្រកាស ឲ្យ បេក្ខជន - បេក្ខ នារី ដែល ប្រឡង ជាប់ មន្រ្ដី ក្របខណ្ឌ ថ្មី មក បង្ហាញ ខ្លួន
( ភ្នំពេញ ) ៖ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្ដរជាតិ នៅ រសៀល ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ដល់ បេក្ខជន - បេក្ខ នារី ដែល បាន ប្រឡង ជាប់ មន្រ្ដី ខណ្ឌ ថ្មី សម្រាប់ ឆ្នាំ ២០១៨ សូម មក បង្ហាញ ខ្លួន នៅ នាយកដ្ឋាន បុគ្គលិក នៃ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្ដរជាតិ ដើម្បី បំពេញ បែបបទ ចូល បម្រើ ការងារ ចាប់ពី ថ្ងៃ នេះ រហូតដល់ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
ករណី មិន បាន មក បង្ហាញ ខ្លួន ត្រូវ ចាត់ទុក ថា បេក្ខជន - នារី ទាំងនោះ បោះបង់ ចោល លទ្ធផលប្រឡង់ ដោយ ស្វ័យប្រវត្តិ និង គ្មាន លក្ខខណ្ឌ ៕
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្ដីជូនដំណឹង របស់ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្ដរជាតិ ខាងក្រោម៖
ក្រសួង បរិស្ថាន និង ក្រសួង ទេសចរណ៍ សហការ ជាមួយ អង្គការ ពាក់ព័ន្ធ ប្រារព្ធ ទិវា សំអាត ពិភពលោក នៅ ថ្ងៃទី ១៥ ខែកញ្ញា
ការជួបជុំ ប្រារព្ធ ទិវា នេះ នឹង ធ្វើឡើង នៅ ទីស្តីការ ក្រសួង បរិស្ថាន រាជធានី ភ្នំពេញ វេលា ម៉ោង ៦៖៣០ នាទី ព្រឹក រហូតដល់ ម៉ោង ១១៖៣០ នាទី ព្រឹក ។ កម្មវិធី នេះ ធ្វើឡើង ដើម្បី ជំរុញ និង បំផុស ឱ្យ មាន ការចូលរួម ពី សាធារណជន និង ភាគី ពាក់ព័ន្ធ ដែល ជា ចលនា សកល ដោយ ផ្សារភ្ជាប់ មនុស្ស និង ស្ថាប័ន ក្នុង គោលដៅ ធ្វើឱ្យ ពិភពលោក ស្អាត គ្មាន សំរាម ។
ការអនុវត្ត កម្មវិធី នេះ ជា ការឆ្លើយតប នឹង បញ្ហា ប្រឈម មួយ ចំនួន របស់ ប្រជាជន គ្រប់ វិស័យ ដែល តម្រូវ ឱ្យ មាន ការលើកទឹកចិត្ត ចូលរួម សកម្មភាព សំអាត បរិស្ថាន គ្រប់ កន្លែង និង គ្រប់ ពេលវេលា ដើម្បីឱ្យ ក្លាយជា ចលនា សង្គម មួយ ពោរពេញ ទៅ ដោយ ភាពស្អាត ទាំងស្រុង នៅក្នុង ប្រទេស កម្ពុជា និង លើ ពិភពលោក ។
ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត បេ្តជ្ញាចិត្ត ហ៊ាន បូជា ជីវិត មិន ស្តាយ ស្រណោះ ដើម្បី បុព្វហេតុ ការពារ ប្រជាជន និង ជាតិ មាតុភូមិ
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ដែល ទើបនឹង ចូលកាន់ តំណែង ជា មេបញ្ជាការ កងទ័ព ជើងគោក បាន ថ្លែង បេ្តជ្ញាចិត្ត ថា លោក ហ៊ាន បូជា ជីវិត មិន ស្តាយ ស្រណោះ ដើម្បី បុព្វហេតុ ការពារ ប្រជាជន និង ជាតិ មាតុភូមិ ដ៏ បវ របស់ ជាតិ កម្ពុជា ។
ឧត្តមសេនីយ៍ បាន ថ្លែង បែប នេះ ក្នុង ពិធី សំណេះសំណាល និង ផ្ទេរ ភារកិច្ច មេបញ្ជាការ កងទ័ព ជើងគោក នៅ ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ក្រោម អធិបតីភាព ទេសរដ្ឋមន្រ្តី មាស សុភា ។
ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត បាន អបអរសាទរ ចំពោះ នាយ ឧត្តមសេនីយ៍ មាស សុភា ក្នុង ឱកាស ដែល ត្រូវបាន ព្រះមហាក្សត្រ ប្រោសប្រទាន តែងតាំង មុខងារ ជា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស ។
ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត បាន បន្ត ដោយ សម្តែង ការដឹងគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោក ទេសរដ្ឋមន្ត្រី មាស សុភា ដែល ស្ទើរតែ មួយ ជីវិត របស់ លោក បាន ចូលរួមចំណែក ដោយ ផ្ទាល់ ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាជាតិ កម្ពុជា ចាប់តាំងពី លោក មាស សុភា មាន អាយុ ប្រមាណ ១៥ ឆ្នាំ ក្នុង ឋានៈ ជា យុទ្ធជន នៃ កងទ័ព រណសិរ្ស ចលនា តស៊ូ រំដោះ ជាតិ កម្ពុជា ក្នុង ឆ្នាំ ១៩៧០ ខណៈ មាតុភូមិ កម្ពុជា បាន ធ្លាក់ ចូល ក្នុង ភ្លើង សង្គ្រាម ។
មេបញ្ជាការ កងទ័ព ជើងគោក ថ្មី រូប នេះ បាន ចាត់ទុក ថា ក្នុង ជីវិត កងទ័ព ដ៏ អង់អាច ក្លាហាន ប្រកបដោយ ការលះបង់ ខ្ពស់ និង តស៊ូ គ្រប់ ដំណាក់កាល របស់ លោក ទេសរដ្ឋមន្ត្រី មាស សុភា រួម ជាមួយ ឥស្សរជន ជាច្រើន រូប ទៀត ពិតជា បាន ផ្តល់ នូវ ជីវិត ឱកាស និង ក្តីសង្ឃឹម សម្រាប់ កងទ័ព ទាំងអស់ គ្នា ក្នុង ពេល បច្ចុប្បន្ន និង កូន ចៅ ខ្មែរ ជំនាន់ ក្រោយ ៗ ទៀត ។
ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត ក៏ បាន សម្តែង មោទនភាព បំផុត ដោយ ព្រះមហាក្សត្រ បាន ប្រោសប្រទាន តែងតាំង មុខងារ ជា មេបញ្ជាការ កងទ័ព ជើងគោក ដល់ រូបលោក ។ លោក ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ ការផ្តល់ ទំនុកចិត្ត ពី ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច ពិជ័យ សេនា ទៀ បាញ់ និង ថ្នាក់ដឹកនាំ នៃ កងយោធពល ខេមរភូមិន្ទ ដែល បាន ផ្តល់ ការគាំទ្រ និង កិច្ចសហប្រតិបត្តិការ នា ពេល កន្លងមក ក្នុង អំឡុង ពេល លោក ទទួលបាន ភារកិច្ច ថ្មី នេះ ។
លោក បាន ថ្លែង បញ្ជាក់ យ៉ាង ដូច្នេះ ថា ឈរ លើ ស្មារតី ស្នេហាជាតិ និង ដើម្បី ជា ការតបស្នង ជូន ចំពោះ ព្រះរាជ តម្រិះ និង ការប្រោសប្រទាន នូវ កិត្តិយស ដ៏ ឧត្តុង្គឧត្តម ពី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ការផ្តល់ ទំនុកចិត្ត ដ៏ ខ្ពង់ខ្ពស់ បំផុត ពី សំណក់ ប្រមុខ រាជ រដ្ឋាភិបាល លោក សូម ធ្វើ ការបេជ្ញាចិត្ត ដូចត ទៅ៖
១៖ សោ្មះ ត្រង់ ដាច់ខាត ចំពោះ ជាតិ សាសនា ព្រះមហាក្សត្រ អស់ មួយ ជីវិត ។
២៖ គោរព និង អនុវត្ត តាម ជានិច្ច នូវ រដ្ឋធម្មនុញ្ញ កម្ពុជា ។
៣៖ ដើរ តាម មាគ៌ា ដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ជាពិសេស គោរព និង អនុវត្ត តាម គោល នយោបាយ ជាតិ និង កម្មវិធី គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៦ ។
៤៖ គោរព និង អនុវត្ត តាម គោលការណ៍ និង លក្ខន្តិកៈ កងយោធពល ខេមរភូមិន្ទ ឲ្យបាន ខ្ជាប់ ខ្ជូន បំផុត ។
៥៖ ខិតខំ ប្រឹងប្រែង អនុវត្ត ឲ្យបាន ចំពោះ តួនាទី និង ភារកិច្ច របស់ ខ្លួន និង ហ៊ាន បូជា ជីវិត មិន ស្តាយ ស្រណោះ ដើម្បី បុព្វហេតុ ការពារ ប្រជាជន និង ជាតិ មាតុភូមិ ដ៏ បវរ នៃ យើង ។
សូម បញ្ជាក់ ថា កាលពី ម្សិលមិញ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន ចេញ សេចក្តីសម្រេច ថ្មី មួយ ដោយ កែសម្រួល ផ្ទេរ ក្របខ័ណ្ឌ អង្គភាព កងពល ធំ អន្តរាគមន៍ និង កងពល តូច អន្តរាគមន៍ ចំនួន ៥ ពី អគ្គ បញ្ជាការដ្ឋាន មក ចំណុះ ផ្ទាល់ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក ។
កងពល ធំ - តូច ទាំង៥ ដែល សម្រេច ផ្ទេរ ឲ្យ មក ស្ថិត ក្រោម ការគ្រប់គ្រង ផ្ទាល់ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក មាន៖
១៖ កងពល ធំ អន្តរាគមន៍ លេខ ២២៖ កងពល ធំ អន្តរាគមន៍ លេខ ៣៣៖ កងពល តូច អន្តរាគមន៍ លេខ ១៤៖ កងពល តូច ទ័ព ពិសេស ឆ័ត្រ យោង ៩១១៥៖ កងពល តូច លេខ ៧០ ។
បើ តាម មន្រ្តី យោធា ជាន់ ខ្ពស់ ក្រសួង ការពារ ជាតិ ក៏ បាន ឲ្យដឹង ផងដែរ កងពល ដឹកជញ្ជូន លេខ ៩០ មួយ ទៀត ក៏ ត្រូវបាន ដាក់ ឲ្យ ស្ថិត នៅក្រោម ការគ្រប់គ្រង របស់ កងទ័ព ជើងគោក ផងដែរ ប៉ុន្តែ មិន ទាន់ ចេញ ប្រកាស ជា ផ្លូវការ ៕ តាមពិត អង្គការ NASA បញ្ជូន យាន ហោះ ទៅ ជិត ព្រះអាទិត្យ បំផុត គឺ ដើម្បី ទម្លាយ អាថ៌កំបាំង ធំ ៗ ...
តាមពិត ទៅ គ្រប់ គ្នា បាន ដឹង អំពី ភាគ គ្រោះថ្នាក់ នៃ ភាគ ល្អិត និង ថាមពល ហ្វូន ថុន ជះ ចេញ ពី តារា និមួយ ៗ ដូចជា ភព អង្គារ ដែល បាន រងគ្រោះ រាប់ ពាន់ លាន ឆ្នាំ មកហើយ រហូត ក្លាយជា ភព ស្លាប់ ប៉ុន្តែ ដោយសារតែ ផែនដី មាន ដែន ម៉ាញេ ទិច ដ៏ ខ្លាំងក្លា និង បរិយាកាស ដ៏ ក្រាស នោះ ទើប ថាមពល អាក្រក់ ៗ ទាំងអស់ នេះ មិន អាច យាយី ជីវិត នានា នៅលើ ភព បៃតង របស់ យើង បាន ។
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ស្នើឲ្យ ធនាគារ អភិវឌ្ឍ អាស៊ី ពិនិត្យ លទ្ធភាព ក្នុង ការផ្តល់ ជំនួយ លើ ការងារ បច្ចេកទេស ការអភិវឌ្ឍ ធនធាន មនុស្ស ការគ្រប់គ្រង និង ការប្រើប្រាស់ ទឹក ឲ្យ មាន ប្រសិទ្ធភាព ការចងក្រង និង អនុវត្ត ច្បាប់ ពាក់ព័ន្ធ វិស័យ កសិកម្ម ស្រប តាម និន្នាការ រីកចម្រើន នៃ សេដ្ឋកិច្ច ជាតិ និង កំណើន ប្រជាជន ។
ថ្លែង ក្នុង ឱកាស នោះ លោក Mahbub Ahmed បាន កោតសរសើរ ចំពោះ ការវិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ពិសេស វិស័យ សេដ្ឋកិច្ច ដែល រាជ រដ្ឋាភិបាល សម្រេចបាន នា ឆ្នាំ កន្លងមក ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
យោង លើ ទិដ្ឋភាព ជាក់ស្តែង លោក បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការរីកចម្រើន នេះ ដែល បាន រួមចំណែក លើកកម្ពស់ ជីវភាព ជំរុញ កំណើន សេដ្ឋកិច្ច និង កាត់បន្ថយ ភាពក្រីក្រ បាន យ៉ាង ល្អ ប្រសើរ ។ ទាក់ទង និង វិស័យ កសិកម្ម លោក បាន ចាប់អារម្មណ៍ និង កោតសរសើរ ចំពោះ ការរីកចម្រើន ដែល ជា ចលករ មួយ ជួយ ជំរុញ កំណើន សេដ្ឋកិច្ច ជាតិ ។
នា ឱកាស នោះ លោក រដ្ឋមន្រ្តី ក្នុង នាម ឲ្យ រាជ រដ្ឋាភិបាល និង ក្នុង នាម ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ ធនាគារ អភិវឌ្ឍ អាស៊ី ដែល កន្លងមក បាន ជួយ គាំទ្រ យ៉ាង ពេញ ទំហឹង ក្នុង ដំណើរការអភិវឌ្ឍ ប្រទេស កម្ពុជា ពិសេស បាន ជួយ ឧបត្ថម្ភ ទាំង បច្ចេកទេស និង ថវិកា ដើម្បី អនុវត្ត គម្រោង នានា ដែល ពាក់ព័ន្ធ វិស័យ កសិកម្ម តាំងពី ឆ្នាំ ១៩៩២ ដែល មាន ទឹកប្រាក់ សរុប ចំនួន ជាង ៤៥០ លាន ដុល្លារ ។
លោក វេង សា ខុន បាន បញ្ជាក់ ថា ស្តែង ចេញពី លទ្ធផល គម្រោង ទាំងនោះ ធ្វើឲ្យ សេដ្ឋកិច្ច ប្រទេស កម្ពុជា មាន ការរីកចម្រើន ជា បន្តបន្ទាប់ រួមទាំង វិស័យ កសិកម្ម ផងដែរ ។ តាមរយៈ លោក Mahbub Ahmed លោក រដ្ឋមន្រ្តី សង្ឃឹម និង ជឿជាក់ ថា ធនាគារ អភិវឌ្ឍ អាស៊ី នឹង បន្ត ជួយ គាំទ្រ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការអភិវឌ្ឍ ប្រទេស ឲ្យ មាន ការរីកចម្រើន បន្ថែម ទៀត ទាំង ក្នុង ពេល បច្ចុប្បន្ន ក៏ ដូចជា ពេល អនាគត ។
ដោយឡែក ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន និង កំពុង ជំរុញ ការអភិវឌ្ឍ ធនធាន មនុស្ស ការធ្វើ ពិពិធកម្ម កសិកម្ម និង យន្តូបនីយកម្ម កសិកម្ម ដើម្បី ជួយ ជំរុញ វិស័យ កែច្នៃ ឲ្យ មាន ការរីកចម្រើន ទាំង ក្នុង ពេល បច្ចុប្បន្ន ក៏ ដូចជា ពេល អនាគត ។
ជាមួយគ្នា នោះ រដ្ឋមន្ដ្រី ក្រសួង កសិកម្ម បាន ស្នើឲ្យ ធនាគារ អភិវឌ្ឍ អាស៊ី ពិនិត្យ លទ្ធភាព ក្នុង ការផ្តល់ ជំនួយ លើ ការងារ បច្ចេកទេស ការអភិវឌ្ឍ ធនធាន មនុស្ស ការគ្រប់គ្រង និង ការប្រើប្រាស់ ទឹក ឲ្យ មាន ប្រសិទ្ធភាព ការចងក្រង និង អនុវត្ត ច្បាប់ ពាក់ព័ន្ធ វិស័យ កសិកម្ម ស្រប តាម និន្នាការ រីកចម្រើន នៃ សេដ្ឋកិច្ច ជាតិ និង កំណើន ប្រជាជន ។
( កំពង់ធំ )៖ ពិតជា រឿង មួយ ដ៏ គួរឱ្យ សោកស្តាយ ជា ទីបំផុត សម្រាប់ មាតាបិតា ដែល បាន ស្រលាញ់ កូន ខ្លាំង ពេក បាន បណ្តោយ ឱ្យ កូន មាន អាយុ មិន ទាន់ បាន ១០ឆ្នាំ ផង នោះ បើកបរ ម៉ូតូ តាម ដងផ្លូវ ដោយ ហេតុតែ ខ្លួន នៅ ក្មេង មិន ទាន់ យល់ ច្បាស់ ពី របៀប ក្នុង ការធ្វើដំណើរ តាម ដងផ្លូវ នោះ បាន បើក ម៉ូតូ បត់ ឆ្លង ផ្លូវ ដោយ មិន បាន ប្រុងប្រយ័ត្ន ត្រូវបាន រថយន្ត បុក ពេញ ទំហឹង បណ្តាលឱ្យ ស្លាប់ ភ្លាម ៗ នៅនឹង កន្លែង កើត ហេតុ យ៉ាង អាណោច អាធ័ម គួរឱ្យ សោកស្តាយ ជា ទីបំផុត ។
