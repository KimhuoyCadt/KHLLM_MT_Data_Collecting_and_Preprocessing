( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន គណៈកម្មការ សាងសង់ វិមាន ឈ្នះ - ឈ្នះ អម ដំណើរ ដោយ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ដឹកនាំ ក្រុមការងារ ជំនាញ ចុះ ត្រួតពិនិត្យ ការសាងសង់ វិមាន ឈ្នះ - ឈ្នះ ។
សូម រំឭក ថា វិមាន ឈ្នះ ឈ្នះ នេះ បាន ចាប់ផ្តើម សាងសង់ ឡើង កាលពី ខែកុម្ភៈ ឆ្នាំ ២០១៦ លើ ទំហំ ដី ៨ហិចតា ស្ថិត នៅ ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ។ ថវិកា ដែល យកមក សាងសង់ គឺជា ថវិកា បដិភាគ របស់ រាជ រដ្ឋាភិបាល ។ យ៉ាងណា ក៏ដោយ គេ មិន បាន បញ្ជាក់ ថា ការចំណាយ នូវ ការសាងសង់ អស់ ថវិកា ប៉ុន្មាន នោះ ឡើយ ។
ថ្លែង ប្រាប់ អ្នកសារព័ត៌មាន កាលពី កន្លងទៅ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន លើកឡើង ថា ការសាងសង់ វិមាន ឈ្នះ ឈ្នះ នេះ គឺ ដើម្បី រំឭក ដល់ គុណូបការៈ របស់ បុព្វបុរស ខ្មែរ គ្រប់ សម័យ កាល ដែល បាន លះបង់ ជីវិត ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ ។ ម្យ៉ាងទៀត វិមាន នេះ ក៏ ជា និម្មិត រូប នៃ សុខ សន្តិភាព ដែល កម្ពុជា ទទួលបាន ក្រោយពី បញ្ចប់ សង្គ្រាម ស៊ីវិល ដ៏ រ៉ាំរ៉ៃ ជាច្រើន ទសវត្សរ៍ កន្លងមក ។ ជាង នេះ ទៀត វិមាន នេះ នឹង ក្លាយជា កេរមរតក សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ ផងដែរ ។
( ភ្នំពេញ ) ៖ សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា តំណាង កម្មករ ជាង ៥០ម៉ឺន នាក់ នៅ ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ចេញ សេចក្តីថ្លែងការណ៍ គាំទ្រ ពេញ ទំហឹង នូវ លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ជាតិ ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី ០៦ ប្រកាស ដោយ គ.ជ. ប នៅ យប់ ថ្ងៃទី ១៥ ខែសីហា ដែល បង្ហាញ ថា គណបក្ស ប្រជាជន កម្ពុជា បាន ឈ្នះ ឆ្នោត គ្រប់គ្រង ទាំង ១២៥ អាសនៈ ក្នុង រដ្ឋសភា ។
លទ្ធផល បោះឆ្នោត នេះ បាន បង្ហាញ យ៉ាង ច្បាស់ ថា ប្រជាពលរដ្ឋ ខ្មែរ បាន ផ្តល់ នូវ សេចក្តីទុកចិត្ត យ៉ាង ខ្ពស់ បំផុត ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន ដឹកនាំ ប្រទេស តាំងពី ឆ្នាំ ១៩៧៩ មក ឆ្លងកាត់ ព្យុះភ្លៀង រាប់ មិន អស់ ក្នុង ការសង្គ្រោះ ជីវិត ជាតិ និង ប្រជាជន នាំយក នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ។ អំពើ ល្អ របស់ គ ណបក្ស ប្រជាជន កម្ពុជា និង ការលះបង់ សព្វ បែប យ៉ាង របស់ ថ្នាក់ដឹកនាំ បក្ស នេះ ដើម្បី ជាតិ និង ប្រជាជន ត្រូវ បាន តបស្នង មកវិញ តាមរយៈ ការផ្តល់ ទំនុកចិត្ត ពី រាស្ត្រ ជា ម្ចាស់ ឆ្នោត ។
វា គឺជា សារ យ៉ាង ច្បាស់លាស់ បំផុត ប្រាប់ ដល់ សាធារណៈ មតិ ជាតិ និង អន្តរជាតិ ឲ្យបាន ដឹង ថា នេះ គឺជា ការបោះឆ្នោត ដ៏ ល្អ បំផុត មួយ នៅ កម្ពុជា ហើយ សូម្បីតែ អ្នកសង្កេតការណ៍ ជាតិ និង អន្តរជាតិ ដែល បាន ចូលរួម សង្កេតការណ៍ ការបោះឆ្នោត នេះ និង ប្រជាពលរដ្ឋ ខ្មែរ ខ្លួន ឯង ក៏ សុទ្ធតែ បាន វាយតម្លៃ ថា ការបោះឆ្នោត ដ៏ ត្រឹមត្រូវ តាម នីតិវិធី ច្បាប់ មួយ ។
អត្រា នៃ ការចូលរួម បោះឆ្នោត របស់ ប្រជាពលរដ្ឋ ដ៏ ខ្ពស់ នៅ ពេល នេះ គឺ ពិត ណាស់ បាន បង្ហាញ ពី ឆន្ទៈ ពិតប្រាកដ របស់ ពលរដ្ឋ ខ្មែរ ប្រឆាំង នឹង ការជ្រៀត ជ្រែក របស់ ក្រុម ជន បរទេស មក ក្នុង កិច្ចការ ផ្ទៃក្នុង កម្ពុជា និង រំលោភបំពាន លើ ឯករាជភាព និង អធិបតេយ្យភាព ជាតិ ខ្មែរ ឡើយ និង ជាសារ ប្រាប់ ទៅ ក្រុម អ្នកនយោបាយ រត់ ចោល ស្រុក ថា ពលរដ្ឋ ខ្មែរ មិន ស្តាប់ ការញុះញង់ របស់ ខ្លួន ជាន់ ឈ្លី សិទ្ធិ អំណាច របស់ ខ្លួន ដោយ មិន ទៅ បោះឆ្នោត នោះ ទេ ។
ដោយ៖ ចៅ ចាក់ ស្មុក រាជធានី ភ្នំពេញ ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ អ្នក ជិះ បញ្ច្រាស រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត មាន . ក្នុង យប់ មិញ សមត្ថកិច្ច ឃាត់ បាន យានយន្ត ចំនួន ៧ គ្រឿង ថែម ទៀត
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៧គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន ៧គ្រឿង ក្នុង នោះ រួម មាន៖ ម៉ូតូ ចំនួន ៧គ្រឿង ។
បច្ចុប្បន្ន យានយន្ត ទាំងនោះ បាន ញ្ជូន ទៅ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ កា អប់រំ ណែនាំ បន្ត តាម នីតិវិធី ៕ កាកបាទ ក្រហម កម្ពុជា បន្ដ ចុះ ចែក អំណោយ ជូន ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ចំនួន ១. ៣៧៥ គ្រួសារ ទៀត នៅ ខេត្ដ ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ នា ព្រឹក ថ្ងៃពុធ ៤រោច ខែ ស្រា ពណ៍ ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព ស. ២៥៦២ ត្រូវនឹង ថ្ងៃទី ១៥ ខែ សីហា ឆ្នាំ ២០១៨ នេះ លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ នៃ កាកបាទ ក្រហម កម្ពុជា រួម ដំណើរ ដោយ លោក លី ឡេង ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ត្បូងឃ្មុំ បាន បន្ត ចុះ សួរសុខទុក្ខ និង ផ្តល់ អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា ជូន ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ចំនួន ១. ៣៧៥ គ្រួសារ នៅក្នុង ភូមិ ចំនួន ៦ ឃុំ ព្រែក អាជី ស្រុក ក្រូចឆ្មា ខេត្ត ត្បូងឃ្មុំ ។
ប្រជាពលរដ្ឋ រងគ្រោះ ទាំងអស់ មាន សេចក្ដីត្រេកអរ ជាខ្លាំង និង សូម ថ្លែងអំណរគុណ ដល់ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន តែងតែ គិតគូរ ពី បញ្ហា ទុក្ខលំបាក ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ ៗ រូប ហើយក៏ សូម ជូនពរ ដល់ សម្ដេច ជួប តែ សេចក្ដីសុខ និង ទទួលបាន នូវ ពុទ្ធ ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ក្នុង អាណត្តិ ចាស់ រដ្ឋសភា ដែល មាន តំណាងរាស្ត្រ មកពី គណបក្ស ប្រជាជន កម្ពុជា និង អតីត គណបក្ស សង្គ្រោះ ជាតិ ដែរ នោះ គេ សង្កេតឃើញ ថា មាន រដ្ឋមន្ត្រី ជាច្រើន រូប ត្រូវបាន គណៈកម្មការ នៃ រដ្ឋសភា បាន គាស់ ហៅ ទៅ សួរនាំ ជាញឹកញាប់ លើ ការងារ អសកម្ម ក្នុង ការបម្រើ ជាតិ និង ប្រជាជន ។
ក្នុង សន្និសីទ ព័ត៌មាន ស្តីពី លទ្ធផល នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦នា ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ នេះ អ្នកនាំពាក្យ គណបក្ស ប្រជាជន កម្ពុជា បាន អះអាង ថា តំណាងរាស្ត្រ មកពី គណបក្ស ប្រជាជន កម្ពុជា នៅតែ បន្ត បំពេញ កាតព្វកិច្ចពិនិត្យមើល សកម្មភាព របស់ រាជ រដ្ឋាភិបាល ហើយ នឹង កោះហៅ រដ្ឋមន្ត្រី មក សួរ នាំ ទៅ ការងារ ដែល មាន ភាពអសកម្ម ។
លោក សុខ ឥសាន បន្ថែម ថា « សូម កុំ មាន ការព្រួយបារម្ភ ទោះបី បក្ស តែ មួយ ក៏ដោយ ក៏ យើង នឹង បំពេញ តួនាតី នេះ ឲ្យបាន ប្រកបដោយ ប្រសិទ្ធភាព ហើយ សម្តេច តេជោ ហ៊ុន សែន ដែល ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី គណបក្ស ប្រជាជន កម្ពុជា លោក បាន លើក ហើយ គឹកាន់តែ បង្កើន ការយក ការទទួលខុសត្រូវ ទ្វេ ដង ថែម ទៀត ដើម្បី ធ្វើ យ៉ាងណា បង្កើន ប្រសិទ្ធភាប ការងារ របស់ បណ្តា ស្ថាប័ន រួម មាន ស្ថាប័ន នីតិបញ្ញត្តិ ស្ថាប័ន នីតិប្រតិបត្តិ គឺ រាជ រដ្ឋាភិបាល ហ្នឹង ហើយ នឹង តុលាការ » ។
លោក ឈឹម ផល វរុណ បាន ថ្លែង បញ្ជាក់ ដែរ ថា « តំណាងរាស្ត្រ មកពី គណបក្ស កាន់អំណាច ក៏ គាត់ ឈរ លើ គោល នយោបាយ គណបក្ស ដែរ ហើយក៏ គាត់ ឈរ លើ គោល នយោបាយ នៃ ប្រសិទ្ធភាព នៃ ការអនុវត្តន៍ កម្មវិធី នយោបាយ របស់ រាជ រដ្ឋាភិបាល ។ ដូច្នេះ គាត់ ក៏ មាន សតិសម្បជញ្ញៈ បំពេញ កាតព្វកិច្ច កោះអញ្ជើញ រដ្ឋមន្រ្តី បើសិន មាន បញ្ហា អសកម្ម ច្រើន ដើម្បី បំភ្លឺ ទៅ លើ បរិបថ ហ្នឹង ពីព្រោះ មិន មែន បុគ្គល ដែល មិន ធ្វើ ខុស ទេ បើ មិន មាន ការដាស់តឿន និង បំភ្លឺ ជាសាធារណៈ នៅក្នុង វេទិកា សភា » ។
យោង តាម លិខិត របស់ សាលា ក្រុង ច្បារមន បាន ចេញ ឲ្យ ម្ចាស់ កន្លែង ផ្ញើ ម៉ូតូ ថា ត្រូវ បញ្ឈប់ ការរៀប ម៉ូតូ ផ្ញើ យក លុយ នៅលើ ផ្លូវ សាធារណៈ និង ការយក ថ្លៃ ផ្ញើ ម៉ូតូ លើស ពី ការកំណត់ ក្នុង សៀវភៅ បន្ទុក ។
ក្នុង នោះ រដ្ឋបាល ក្រុង ច្បារមន សូម ជម្រាប ជូន ម្ចាស់ ទីតាំង ចំនួន ៤កន្លែ ង៖
* ទី១៖ លោក ណុប សានីន ម្ចាស់ ទីតាំង ផ្ញើ ម៉ូតូ នៅ ខាងជើង ផ្សារ កំពង់ស្ពឺ* ទី២៖ ឈ្មោះ សៅ វ័ន្ត ម្ចាស់ ទីតាំង ផ្ញើ ម៉ូតូ នៅ ខាងជើង ផ្សារ កំពង់ស្ពឺ* ទី៣៖ ឈ្មោះ ថូ ធា ម្ចាស់ ទីតាំង ផ្ញើ ម៉ូតូ នៅ ខាងជើង ផ្សារ កំពង់ស្ពឺ* ទី៤៖ ឈ្មោះ ជន ស្រី និច ម្ចាស់ ទីតាំង ផ្ញើ ម៉ូតូ នៅ ខាងជើង ផ្សារ កំពង់ស្ពឺ ។
សាលាក្រុង ច្បារមន បាន ពិនិត្យ ឃើញ ថា កន្លងមក ទីតាំង ផ្ញើ ម៉ូតូ របស់ លោក បាន ដាក់ រៀប ម៉ូតូ យក លុយ នៅលើ ផ្លូវ សាធារណៈ ធ្វើឲ្យ ប៉ះពាល់ ដល់ ការធ្វើចរាចរណ៍ បង្កឲ្យ មាន ការកកស្ទះ បាត់បង់ សណ្តាប់ធ្នាប់ និង សោភ័ណភាព ក្រុង ព្រមទាំង បាន យក កម្រៃ លើស ពី ការកំណត់ ក្នុង សៀវភៅ បន្ទុក ជា ហេតុ ធ្វើឲ្យ មាន ការរិះគន់ ជា បន្តបន្ទាប់ពីសំណាក់ សាធារណជន ។
ហេតុ ដូចនេះ រដ្ឋបាល ក្រុង ច្បារមន សូម ម្ចាស់ ទីតាំង បញ្ឈប់ ការរៀប ម៉ូតូ ផ្ញើ យក លុយ នៅលើ ផ្លូវ សាធារណៈ និង ការយក ថ្លៃ ផ្ញើ ម៉ូតូ លើស ពី ការកំណត់ ក្នុង សៀវភៅ បន្ទុក ចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ តទៅ ។ លោក ហុក ម៉ារ៉ាឌី អភិបាល ក្រុច្បារមន បាន ឲ្យដឹង ថា បើ ម្ចាស់ ទីតាំង មិន ព្រម អនុវត្ត តាម សេចក្តីជូនដំណឹង នេះ រដ្ឋបាល ក្រុង នឹង ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ៕
សារព័ត៌មាន អាមេរិក ៣០០ ស្ថាប័ន ធ្វើ យុទ្ធនាការ ប្រឆាំង ការដាក់ សម្ពាធ លើ សេរីភាព សារព័ត៌មាន របស់ លោក ដូណាល់ ត្រាំ (video inside) ( វ៉ាស៊ីនតោន ) ៖ បណ្ដា សារព័ត៌មាន អាមេរិក ជាច្រើន ជាង ៣០០ ស្ថាប័ន នឹង ចាប់ផ្ដើម ធ្វើ យុទ្ធនាការ សេរីភាព សារព័ត៌មាន មួយ នៅ ថ្ងៃ ព្រហស្បតិ៍ នេះ ( ម៉ោង នៅ សហរដ្ឋ អាមេរិក ) ដើម្បី សម្ដែង ការប្រឆាំងជំទាស់ នឹង ការដាក់ សម្ពាធ លើ សេរីភាព សារព័ត៌មាន ពីសំណាក់ លោក ប្រធានាធិបតី ដូណាល់ ត្រាំ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន BBC នៅ ថ្ងៃព្រហស្បតិ៍ ទី១៦ ខែសីហា ឆ្នាំ ២០១៨ ។
ប៉ុន្តែ ព្រម ពេល ជាមួយគ្នា ក្រុម អ្នកជំនាញ ជាច្រើន បាន ព្រមាន ថា សម្ដី វាយប្រហារ របស់ លោក ដូណាល់ ត្រាំ អាចនឹង ធ្វើឱ្យ ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ លើ សេរីភាព សារព័ត៌មាន និង លិទ្ធិ ប្រជាធិបតេយ្យ ព្រមទាំង អាច បង្កឱ្យ មាន អំពើហិង្សា ប្រឆាំង នឹង អ្នកសារព័ត៌មាន ផងដែរ ៕ កងពល តូច លេខ ៧០ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ លទ្ធផល បោះឆ្នោត ដែល គណបក្ស ប្រជាជន កម្ពុជា ឈ្នះ គ្រប់គ្រង ទាំង ១២៥ អាសនៈ ក្នុង រដ្ឋសភា
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ មេបញ្ជាការ បញ្ជាការដ្ឋាន កងពល តូច លេខ ៧០ និង មេបញ្ជាការ នាយ ទាហាន នាយ ទាហាន រង ព្រមទាំង ពល ទាហាន ទាំងអស់ នៅ ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី ០៦ ប្រកាស ដោយ គ.ជ. ប ដែល បង្ហាញ ថា គណបក្ស ប្រជាជន កម្ពុជា បាន ឈ្នះ ឆ្នោត គ្រប់គ្រង ទាំង ១២៥ អាសនៈ ក្នុង រដ្ឋសភា ។
បន្ថែម ពី នេះ លោក ឧត្តមសេនីយ៍ មេបញ្ជាការ ក៏ បាន ធ្វើ ការប្ដេជ្ញាចិត្ត ថា នឹង ការពារ យ៉ាង ម៉ឺងម៉ាត់ នូវ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង ការពារ រដ្ឋធម្មនុញ្ញ ការពារ ព្រះមហាក្សត្រ មិន ឲ្យ បរទេស ណា មក បំពាន ឬ ក្រុម អមិត្ត ណា មក ផ្ដួល រំលំ បាន នោះ ឡើយ ។
សូម ជម្រាប ថា ការប្រកាស ចូលរួម អបអរសាទរ នេះ ធ្វើឡើង បន្ទាប់ពី លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី ០៦ បាន បង្ហាញ ទាំងស្រុង នៅ វេលា ម៉ោង ៧៖៣០ នាទី យប់ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ ដោយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត បាន ប្រកាស ថា គណបក្ស ប្រជាជន កម្ពុជា ដែល ជា បក្ស កាន់អំណាច បាន គ្រប់គ្រង អាសនៈ ទាំង ១២៥ នៅក្នុង រដ្ឋសភា តែ ម្តង ចំណែក គណបក្ស ផ្សេង ៗ ដែល ចូលរួម ក្នុង ការបោះឆ្នោត ពុំ បាន ទទួល អាសនៈ ណាមួយ ឡើយ ៕
តំណាង ទេសរដ្ឋមន្រ្តី ប្រាក់ សុខុន ជំរុញ ឲ្យ សិស្សានុសិស្ស ខិតខំ យកចិត្តទុកដាក់ លើ ការសិក្សា ត្រៀម ប្រឡង ឆ្នាំ ២០១៨ នេះ
លោក សន វី បាន ថ្លែង បែប នេះ នៅក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ សិស្សានុសិស្ស វិទ្យាល័យ ស្អាង និង លោកគ្រូ អ្នកគ្រូ បង្រៀន ថ្នាក់ ទី ១២ ចំនួន ៣៩ នាក់ និង បេក្ខជន ត្រៀម ប្រឡង យក សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ឆ្នាំ សិក្សា ២០១៧ - ២០១៨ ប្រមាណ ៤៤០ នាក់ កាលពី ព្រឹក ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នៅ សាល ប្រជុំ ស្នាក់ការ គណបក្ស ប្រជាជន ស្រុក ស្អាង ។
លោក បាន ថ្លែង បន្ត ទៀត ថា ក្មួយ ៗ សិស្សានុសិស្ស ទាំងអស់ បាន ខិតខំ ប្រឹងប្រែង រៀនសូត្រ អស់ រយៈពេល ១២ ឆ្នាំ មកហើយ ដូច្នេះ នៅ ថ្ងៃ ចុងក្រោយ មុន ការ ប្រឡង កុំ ខំ ប្រឹងប្រែង រៀន ពេក អី គួរតែ គេង និង លេង កីឡា ឱ្យ បាន ច្រើន ហើយ ត្រូវ ចៀស ឆ្ងាយ ពី គ្រឿងញៀន និង អំពើ អបាយ មុខ ផ្សេង ៗ ព្រោះ វា អាច ធ្វើឱ្យ ការខិតខំ ប្រឹងប្រែង រៀនសូត្រ អស់ រយៈពេល ជាច្រើន ឆ្នាំ នោះ រលាយ បាត់ អស់ ត្រឹម មួយ ពព្រិច ភ្នែក ។
លោក ក៏ បាន ផ្តាំផ្ញើរ ដល់ ក្មួយ ៗ សិស្សានុសិស្ស ជា បេក្ខជន ត្រូវ ប្រឡង យក សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ទាំងអស់ ត្រូវ មាន ការតាំងចិត្ត ខ្ពស់ កុំ ភិតភ័យ ត្រូវ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម វិន័យ និង គោលការណ៍ នៃ ការប្រឡង ចេះ ប៉ុណ្ណា ធ្វើ ប៉ុណ្ណឹង ទៅ តាម សមត្ថភាព របស់ យើង ។
លោក ក៏ បាន អំពាវនាវ ឱ្យ សិស្សា និស្ស ទាំងអស់ ត្រូវ ខិតខំ ប្រឹងប្រែង ដណ្តើមយក និទ្ទេស A ឱ្យ បាន ច្រើន ជាង ឆ្នាំ មុន ៗ ហើយ សូម ឱ្យ ក្មួយ ៗ សិស្សានុសិស្ស ទាំងអស់ មាន សុវត្ថិភាព គ្រប់ ពេល ធ្វើដំណើរ ។ ចុងបញ្ចប់ លោក ក៏ បាន នាំយក ថវិកា លោក ប្រាក់ សុខុន រួមទាំង ថវិកា លោក ផ្ទាល់ និង សហការី ទៅ ចែកជូន ដល់ លោកគ្រូ អ្នកគ្រូ បង្រៀន ថ្នាក់ ទី ១២ ចំនួន ៣៩ នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ថវិកា ៥ម៉ឺន រៀល និង សិស្សានុសិស្ស ចំនួន ៤៤០ នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ថវិកា ចំនួន ៣ម៉ឺន រៀល ផងដែរ ៕
លោក គីម ជុង ណាំ ត្រូវបាន គេ សម្លាប់ ដោយ ប្រើប្រាស់ សារធាតុ គីមី ពុល VX នៅឯ អាកាសយានដ្ឋាន ទីក្រុង គូឡាឡាំពួរ កាលពី ថ្ងៃ ទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០១៧ ។ ចំណែកឯ សហរដ្ឋ អាមេរិក ធ្លាប់ បាន ចោទប្រកាន់ ថា រដ្ឋាភិបាល កូរ៉េ ខាងជើង គឺជា អ្នក នៅ ពីក្រោយ អំពើ ឃាតកម្ម នេះ ប៉ុន្តែ ទីក្រុង ព្យុងយ៉ាង បាន បដិសេធ រាល់ ការចោទប្រកាន់ ៕
ម្ចាស់ លំនៅឋាន អាច ទទួល អត្ថប្រយោជន៍ ពី សេវាកម្ម ផ្គូផ្គង ជាមួយ ជាង សំណង់ ដោយ ឥត គិត ថ្លៃ ពី SCG
( ព្រះសីហនុ) ៖ ម្ចាស់ លំនៅឋាន និង ម្ចាស់ គម្រោង អភិវឌ្ឍន៍ អចលន ទ្រព្យ នានា នៅ ទូទាំង ប្រទេស កម្ពុជា នៅ ពេល នេះ អាច ទទួល អត្ថប្រយោជន៍ ពី សេវាកម្ម ផ្គូផ្គង ជាង សំណង់ ដោយ ឥត គិត ថ្លៃ ពី ក្រុមហ៊ុន អេសស៊ី ជី (SCG) ដែល សេវាកម្ម នេះ មាន បំណង លើកកម្ពស់ លទ្ធភាព ឲ្យ កាន់តែ ទូលំទូលាយ ក្នុង ការស្វែងរក ជាង សំណង់ និង សម្ភារ សំណង់ ដែល មាន គុណភាព ក៏ ដូចជា ជួយ បង្កើន ប្រាក់ ចំណូល ដល់ ជាង សំណង់ កម្ពុជា ផងដែរ ។
ជាង សំណង់ ដែល បាន ទទួល គម្រោង សាងសង់ ពី អ្នកស្រី ឃាង ចិន្ដា មុនី គឺ លោក ព្រំ បុរី ។ លោក ទើបតែ បញ្ចប់ វគ្គ បណ្ដុះបណ្ដាល ក្នុង កម្មវិធី បណ្ដុះបណ្ដាល ជាង សំណង់ របស់ អេសស៊ី ជី ហើយ លោក បាន ថ្លែង កោតសរសើរ ដល់ ក្រុមហ៊ុន ដែល បាន ជួយ ដល់ រូបលោក ក្នុង ការស្វែងរក អតិថិជន ល្អ ៗ ។
ក្រសួង ធនធាន ទឹក៖ កម្ពស់ ទឹក ស្ទឹង សង្កែ ខេត្ត បាត់ដំបង ឡើង ដល់ កម្រិត ប្រកាស ឲ្យ មាន ការប្រុងប្រយ័ត្ន . ទឹក ចាប់ផ្ដើម ហូរ លិច តំបន់ ផ្សារ បឹង ឈូក ខណៈ អាជ្ញាធរ កំពុង ជួយ ទប់ស្កាត់
( បាត់ដំបង ) ៖ គិត មកដល់ ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ នេះ កម្ពស់ ទឹក ស្ទឹង សង្កែ ខេត្ត បាត់ដំបង បាន ឡើង ដល់ ១៣. ៧៥ម៉ែត្រ ដែល ជា កម្ពស់ ទឹក ក្នុង កម្រិត ប្រកាស ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខណៈ ដែល តំបន់ ផ្សារ បឹង ឈូក ក្នុង ក្រុង បាត់ដំបង ត្រូវបាន ទឹក ជន់ លិច ជា បណ្ដើរ ៗ តាមរយៈ ហូរ តាម លូ ។ នេះ បើ យោង តាម ការបញ្ជាក់ របស់ លោក ចាន់ យុត្ថា អ្នកនាំពាក្យ ក្រសួង ធនធាន ទឹក ។
យ៉ាងណា ក៏ដោយ នៅ ពេល នេះ អាជ្ញាធរ កម្លាំង សមត្ថកិច្ច បូករួម ទាំង កម្លាំង យោធា របស់ ភូមិភាគ ទី៥ ជាច្រើន នាក់ កំពុងតែ ជួយ អន្ដរាគមន៍ យកប៉ាវ ខ្សាច់ ដែល ផ្ដល់ជូន ដោយ លោក លឹម គាន ហោ រដ្ឋមន្ដ្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ចំនួន ៥.០០០ បាវ ទៅ បិត តាម មាត់ ស្ទឹង ដែល ទាប ជាង គេ ក្នុង គោលបំណង ការពារ ទឹក ឡើង បន្ដ ហើយ ហូរ ចូល ក្រុង បាត់ដំបង ។
សម្រាប់ ស្ថានភាព កម្ពស់ ទឹក នេះ ត្រូវបាន អ្នកនាំពាក្យ អះអាង ថា នៅ វេលា ម៉ោង ៤ ឬ ៥ល្ងាច នេះ នឹង ចាប់ផ្ដើម ស្រក ហើយ ក៏ ព្រោះតែ លំហូរ ទឹក ពី ផ្នែក ខាងលើ ត្រូវបាន រដ្ឋមន្ដ្រី ក្រសួង ធនធាន ទឹក ចាត់ ឲ្យ ក្រុមការងារ ធ្វើ ការទប់ស្កាត់ និង បង្ហូរ ចេញ ទៅ តាម ប្រឡាយ មេ មួយចំនួន ។
បន្ទាប់មក ទឹក នេះ បាន ហូរ មកដល់ ទំបន់ កង្ហត ក្នុង ស្រុក បាណន់ ពេល នោះ លោក រដ្ឋមន្ដ្រី ឲ្យ បង្វែរ ហូរ ទៅ ប្រឡាយ មេ២ខ្សែ ដែល អាច ស្រូបយក បាន ១៥០ ម៉ែត្រ គូប ក្នុង មួយ វិនាទី ដូច្នេះ ទឹក ដែល ហូរ ចាក់ បន្ដ មកកាន់ ស្ទឹង សង្កែ ត្រឹម កម្រិត ១. ០៥០ ទៅ១.១០០ ម៉ែត្រ គូប ក្នុង មួយ វិនាទី ហើយ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែសីហា នេះ លោក រដ្ឋមន្ត្រី បាន បញ្ជា ឲ្យ ទម្លាក់ ទ្វារ ទឹក ចុះ បន្ថែម ទៀត ដើម្បី កាត់បន្ថយ ធារ ទឹក នៅ ផ្នែក ខាងក្រោម ។
បើ តាម លោក ចាន់ យុត្ថា ទឹក ស្ទឹង សង្កែ បាន កើនឡើង ដល់ កម្ពស់ ១៣. ៧៥ម៉ែត្រ ជា កម្រិត ប្រកាស ឲ្យ មាន ការប្រុងប្រយ័ត្ន ហើយ កម្រិត ប្រកាស អាសន្ន គឺ ១៤.៥០ ម៉ែត្រ ដូច្នេះ កម្ពស់ ទឹក ត្រឹម នេះ ធ្វើឲ្យ មាត់ ស្ទឹង ដែល ទាប ជាង គេ ស្ថិត នៅក្នុង ភូមិ ចិន សង្កាត់ ព្រែក ព្រះស្ដេច អាច ប្រឈម ការហ៊ា ចូល ក្រុង បាត់ដំបង ដែល តម្រូវឲ្យ ក្រសួង និង អាជ្ញាធរ ព្រមទាំង សមត្ថកិច្ច ជួយ អន្ដរាគមន៍ ដាក់ ប៉ាវ ខ្សាច់ ៕
ចិន នឹង បញ្ជូន ប្រតិភូ ទៅ ចរចា ជម្លោះ ពាណិជ្ជកម្ម ជាមួយ សហរដ្ឋ អាមេរិក នៅ ចុង ខែសីហា នេះ
( ប៉េកាំង ) ៖ រដ្ឋាភិបាល ចិន នឹង បញ្ជូន ប្រតិភូ ជាន់ ខ្ពស់ មួយ ក្រុម ទៅកាន់ សហរដ្ឋ អាមេរិក នៅ ចុង ខែសីហា នេះ ដើម្បី ចាប់ផ្ដើម កិច្ចចរចា ពាណិជ្ជកម្ម ឡើងវិញ នៅក្នុង បរិបទ ដែល ជម្លោះ ពាណិជ្ជកម្ម រវាង មហា យក្ស សេដ្ឋកិច្ច ទាំង ពីរ នៅតែ បន្ត កើនឡើង ។ នេះ បើ តាម ក្រសួង ពាណិជ្ជកម្ម ចិន ដកស្រង់ ដោយសារព័ត៌មាន CGTN នៅ ថ្ងៃព្រហស្បតិ៍ ទី១៦ ខែសីហា ឆ្នាំ ២០១៨ ។
សេចក្ដីថ្លែងការណ៍ ដដែល បាន បញ្ជាក់ ដូច្នេះ ថា៖ « រដ្ឋាភិបាល ចិន ស្វាគមន៍ ជានិច្ច កិច្ចសន្ទនា និង ការទំនាក់ទំនង ទាំងឡាយ ណា ដែល ឈរ លើ មូលដ្ឋាន ស្មើភាព និង គោរព គ្នា ទៅ វិញ ទៅមក ។ ប៉ុន្តែ ទន្ទឹម គ្នា ទីក្រុង ប៉េកាំង នៅតែ ប្រកាន់ ជំហរ ប្រឆាំង ជាដាច់ខាត នឹង ការ អនុវត្ត ពាណិជ្ជកម្ម ឯកតោ ភាគី និង គាំពារ និយម ហើយ នឹង មិន ទទួលស្គាល់ ឡើយ នូវ វិធាន ឯកតោ ភាគី រឹតត្បិត លើ ការធ្វើ ពាណិជ្ជកម្ម » ។
គួរ បញ្ជាក់ ថា ដំណើរទស្សនកិច្ច របស់ ប្រតិភូ ចិន ធ្វើឡើង បន្ទាប់ពី សហរដ្ឋ អាមេរិក និង ចិន ត្រូវបាន គេ រាយការណ៍ ថា គ្រោង នឹង អនុវត្ត ការដំឡើង ពន្ធ សា ជា ថ្មី លើ ផលិតផល មាន តម្លៃ ជាង ១៦ ពាន់ លាន ដុល្លារ ដាក់ គ្នា ទៅ វិញ ទៅ មក នៅ ថ្ងៃទី ២៣ ខែសីហា នេះ ៕ អភិបាល ខេត្ត កំពត ស្នើឲ្យ ប្រធាន មន្ទីរ ចៅហ្វាយ ក្រុង និង ចៅសង្កាត់ ទាំងអស់ ត្រូវ រួមគ្នា កែលម្អ សោភ័ណភាព ទីក្រុង
លោក ជា វ តាយ សង្ឃឹម យ៉ាង មុតមាំ ថា ថ្ងៃ ខាងមុខ ឆាប់ ៗ នេះ ក្រុង កំពត នឹង ក្លាយជា ក្រុង មួយ មាន សោភ័ណភាព ស្អាត បរិស្ថាន ស្អាត គ្មាន សំរាម ខ្យល់អាកាស បរិសុទ្ធ ពិសេស មាន ផ្លូវ ល្អ ប្រព័ន្ធ លូ បង្ហូរ ទឺក គ្មាន បញ្ហា កកស្ទះ ប្រព័ន្ធ ខ្សែ បណ្តាញ អគ្គិសនី មាន របៀបរៀបរយ បណ្តាញ ផ្គត់ផ្គង់ ទឹក ស្អាត មាន គ្រប់ ទីកន្លែង ។
( ភ្នំពេញ ) ៖ វេទិកា សម្ព័ន្ធ សង្គម ស៊ីវិល នៅ ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស គាំទ្រ ទាំងស្រុង នូវ លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី ០៦ ដែល ប្រកាស ដោយ គ.ជ. ប កាលពី ម្សិលមិញ នេះ បង្ហាញ ថា គណបក្ស ប្រជាជន កម្ពុជា ឈ្នះ ឆ្នោត គ្រប់គ្រង ទាំង ១២៥ អាសនៈ នៅក្នុង រដ្ឋសភា ។
វេទិកា សម្ព័ន្ធ សង្គម ស៊ីវិល បាន លើកឡើង ថា លទ្ធផល នេះ គឺជា ជោគជ័យ របស់ ប្រជាជន កម្ពុជា យើង ទាំងមូល ។ វ .ស. ស គាំទ្រ គោល នយោបាយ ឯកភាព ជាតិ និង លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ដោយ គោរព នីតិវិធី ដោយ ឈរ លើ គោលការណ៍ សុខដុមរមនីយកម្ម ដើម្បី សុខ សន្តិភាព ស្ថិរភាព និង ឧត្តម ប្រយោជន៍ ជាតិ ៕
ស៊ី កុក ប្រកាស គាំទ្រ ទាំងស្រុង នូវ លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត ដែល គណបក្ស ប្រជាជន កម្ពុជា ឈ្នះ ទាំង ១២៥ អាសនៈ នៅក្នុង រដ្ឋសភា
( ភ្នំពេញ )៖ គណៈកម្មាធិការ សម្របសម្រួល កម្ពុជា ហៅ កាត់ ថា ស៊ី កុក ដែល ជា សម្ព័ន្ធ អង្គការ - សមាគម ខ្មែរ មិន មែន រដ្ឋាភិបាល នៅ ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស គាំទ្រ ទាំងស្រុង នូវ លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី ០៦ ដែល ប្រកាស ដោយ គ.ជ. ប ថា គណបក្ស ប្រជាជន កម្ពុជា ឈ្នះ ឆ្នោត គ្រប់គ្រង ទាំង ១២៥ អាសនៈ នៅក្នុង រដ្ឋសភា ៕
ខាងក្រោម នេះ ជា សារលិខិត អបអរសាទរ របស់ ស៊ី កុក៖
ខាងក្រោម នេះ ជា សារលិខិត អបអរសាទរ របស់ នាយក រដ្ឋមន្រ្តី សិង្ហបុរី៖
រសៀល ថ្ងៃ នេះ តុលាការ នឹង បន្ត បើក សវនាការ កាត់ទោស បុរស ជនជាតិ អូស្រ្តាលី ដែល បង្ហោះ ដ្រូន ប្រមូលផ្តុំ ព័ត៌មាន នៅ រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ បើ មិន មាន ការកែប្រែ ទេ នៅ រសៀល ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ សាលាដំបូង រាជធានី ភ្នំពេញ នឹង បន្ត ជំនុំជម្រះ លើ សំណុំរឿង បុរស ជនជាតិ អូស្ត្រាលី ម្នាក់ ដែល កំពុង ជាប់ ឃុំ ពាក់ ពន្ធ័ និង បទ ចោទ « ប្រមូលផ្តុំ ព័ត៌មាន ជាអាទិ៍ ដែល អាច ធ្វើឲ្យ អន្តរាយ ការការពារ ជាតិ អំពើ ទទួល ឬ ប្រមូលផ្តុំ ដើម្បី ផ្តល់ ព័ត៌មានវិទ្យា ឬ សលាក បត្រ ដែល អាច ធ្វើឲ្យ អន្តរាយ ការការពារ ជាតិ » ។ នេះ បើ កាលបរិច្ឆេទ ដែល តុលាការ បាន កំណត់ បន្ទាប់ពី បាន លើក ពេល ជំនុំជម្រះ កាលពី ពាក់កណ្តាល ខែមិថុនា កន្លងទៅ ។
គួរ រំលឹក ថា បុរស ជនជាតិ អូស្រ្តាលី ម្នាក់ នេះ បាន បង្ហោះ ដ្រូន ពីលើ អាកាស កាលពី ព្រឹក ថ្ងៃទី ៧ ខែមិថុនា ឆ្នាំ ២០១៧ នៅ រាជធានី ភ្នំពេញ តែ ត្រូវបាន សមត្ត កិច្ច នគរបាល ការិយាល័យ ស៊ើបអង្កេត និង អនុវត្ត និតិវិធី ផែន អន្តោប្រវេសន៍ ឃាត់ខ្លួន បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ៕ ស្លាប់ ៣នាក់ និង របួស ៣នាក់ ក្នុង ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ យ៉ាងហោចណាស់ មនុស្ស ៣នាក់ បាន ស្លាប់ និង ៣នាក់ ទៀត បាន រងរបួស ធ្ងន់ ស្រាល ត្រូវបាន គេ បញ្ជូន ទៅ ធ្វើ ការសង្រ្គោះ នៅឯ មន្ទីរពេទ្យ ដែល បណ្តាល មកពី គ្រោះថ្នាក់ ចរាចរណ៍ គោយន្ត កែច្នៃ បុក ជាមួយ រថយន្ត មួយ គ្រឿង ទៀត ក្នុង ទិសដៅ បញ្រ្ចាស ទិស គ្នា យ៉ាង ពេញ ទំហឹង ។
ហេតុការណ៍ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ៤៖៥០ នាទី ល្ងាច ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៦២ ក្នុង ភូមិ ថ្នល់ បែក ឃុំ ថ្មី ស្រុក គូលែន ខេត្ត ព្រះវិហារ ។
ក្រោយ ការវាស់វែង រួច សមត្ថកិច្ច បាន ស្ទូច រថយន្ត និង គោយន្ត កែច្នៃ យក ទៅ រក្សាទុក ដើម្បី ដោះស្រាយ តាម ច្បាប់ ចំណែក សាកសព ជនរងគ្រោះ យក ទៅ តម្កល់ ទុក នៅ វត្ត តាកឹង ដើម្បី រង់ចាំ សាច់ញាតិ មក ចាត់ចែង ធ្វើ បុណ្យ ជូន តាម ប្រពៃណី ៕ មន្រ្តី កាំ កុងត្រូល ខេត្ត បាត់ដំបង រកឃើញ ទំនិញ ខូច គុណភាព ១៦៨ គីឡូក្រាម ដាក់ តាំង លក់ នៅ ផ្សារ ថ្ម គោល និង ផ្សារ ខ្នាច រមាស . ក្រុមការងារ យកមក រក្សាទុក ដើម្បី ដុត កម្ទេចចោល
( បាត់ដំបង ) ៖ មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត បាត់ដំបង នា ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ បាន សហការ ជាមួយ មន្រ្តី មន្ទីរ ពាណិជ្ជកម្ម នគរបាល និង អាជ្ញាធរដែនដី បាន ចុះ ត្រួតពិនិត្យ ទំនិញ ដាក់ លក់ ក្នុង ផ្សារ ក្នុង ស្រុក ចំនួន ២ ដោយ រកឃើញ ទំនិញ ខូច គុណភាព ១៦៨ គីឡូក្រាម ដាក់ តាំង លក់ នៅ ផ្សារ ថ្ម គោល ស្រុក ថ្មគោល និង ផ្សារ ខ្នាច រមាស ស្រុក បវេល ហើយ យកមក រក្សាទុក នៅ សាខា ដើម្បី ធ្វើ ការដុត កម្ទេចចោល តាម ក្រោយ ។
លោក បាន បញ្ជាក់ ថា ទោះជា អាជីវករ មួយចំនួន នៅ មិន ទាន់ យល់ ពី ផល ប៉ះពាល់ សុខភាព ដោយ នៅតែ ដាក់ លក់ ទំនិញ របស់ ខ្លួន ខូច គុណភាព និង មាន ការ ហួស កាលបរិច្ឆេទ កំណត់ យ៉ាងណា ក៏ដោយ មន្រ្តី ជំនាញ នៅតែ ចុះ ត្រួតពិនិត្យ ធ្វើ ការទប់ស្កាត់ និង ណែនាំ ពី ផល ប៉ះពាល់ សុខភាព ដល់ អ្នកប្រើប្រាស់ ជាប្រចាំ ។ ម្យ៉ាង វិញ ទៀត អ្នក ដែល ដាក់ លក់ ទំនិញ ខូច គុណភាព គិត តែ ផលប្រយោជន៍ ផ្ទាល់ខ្លួន ដោយ មិន គិត ពី សុខភាព អ្នកដទៃ គឺ សមត្ថកិច្ច ជំនាញ តែងតែ ទប់ស្កាត់ បាន ទាន់ វេលា រហូតមក ផងដែរ ។
វេទិកា នេះ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី ពង្រឹង ចំណង សេដ្ឋកិច្ច រវាង បណ្តា ប្រទេស CLMVT ដែល មាន ដូចជា ប្រទេស កម្ពុជា ប្រទេស ឡាវ ប្រទេស មីយ៉ាន់ម៉ា ប្រទេស វៀតណាម និង ប្រទេស ថៃ និង ដើម្បី ជំរុញ សហប្រតិបត្តិការ ក្នុង តំបន់ រួមគ្នា ដោះស្រាយ ប្រឈម បញ្ហា នានា ក្នុង បរិបទ ពាណិជ្ជកម្ម ពិភពលោក ហើយ វេទិកា នៅ ឆ្នាំ នេះ សង្កត់ធ្ងន់ ទៅ លើ ការប្រើប្រាស់ បច្ចកវិទ្យា ឌីជីថល ប្រកបដោយ និរន្តភាព ។
ប្រទេស ថៃ បាន ផ្តូច ផ្តើម គំនិត បង្កើត វេទិកា CLMVT ឡើង នៅក្នុង ឆ្នាំ ២០១៦ ដើម្បី រឹតបន្តឹង ទំនាក់ទំនង ផ្នែក សេដ្ឋកិច្ច ពាណិជ្ជកម្ម វិនិយោគ និង ទេសចរណ៍ រវាង បណ្តា ប្រទេស CLMVT ព្រមទាំង ជំរុញ បណ្តាញ កិច្ចសហប្រតិបត្តិការ គ្រប់ កម្រិត ។
វេទិកា CLMVT ឆ្នាំ ២០១៨ ក៏ បាន ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី ជំរុញ ភាពរុងរឿង រួមគ្នា ក្នុង តំបន់ ព្រម ជាមួយនឹង គោលដៅ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ដើម្បី ដោះស្រាយ បញ្ហា ប្រឈម នានា ដែល កំពុង កើតមាន ក្នុង បរិបទ សេដ្ឋកិច្ច នា ពេល បច្ច ប្បន្ន ព្រមទាំង ដើម្បី ពង្រឹង និង អភិវឌ្ឍ បណ្តាញ អ្នក ធ្វើ អាជីវកម្ម សហគ្រិន អ្នកធ្វើ គោល នយោបាយ និង យុវជន ជំនាន់ ថ្មី នៅក្នុង តំបន់ CLMVT ។
វេទិការ នេះ មាន ការអញ្ចើញ ចូលរួម ពី រដ្ឋមន្រ្តី ពាណិជ្ជកម្ម ឧស្សាហកម្ម វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា ព្រមទាំង នាយក ប្រតិបត្តិ ជាន់ ខ្ពស់ និង សហគ្រាស ធុន តូច និង មធ្យម ជាមួយ អ្នកជំនួញ និង សហគ្រិន វ័យ ក្មេង ផ្សេង ៗ ទៀត ដែល បាន បច្ចេកវិទ្យា ក្នុង ការជំរុញ ទាក់ទង ពាណិជ្ជកម្ម សេដ្ឋកិច្ច មកពី បណ្តា ប្រទេស CLMVT ។
ឥណ្ឌា៖ មនុស្ស ៦៧ នាក់ ស្លាប់ ដោយសារ គ្រោះ ទឹក ជំនន់ ដ៏ អាក្រក់ នៅ រដ្ឋ ភាគ ខាងត្បូង
រដ្ឋ Kerala ដែល មាន ភាពល្បីល្បាញ ដោយ ទេសភាព ឆ្នេរសមុទ្រ ដ៏ ស្រស់ ត្រកាល រួម ជាមួយ ទិដ្ឋភាព នៃ ចម្ការ តែ នោះ បាន និង កំពុង រង ការវាយលុក យ៉ាង ដំណំ ពី ការធ្លាក់ ភ្លៀង ជោគជាំ ខុសពី ធម្មតា នា រដូវ វស្សា ឆ្នាំ នេះ ខណៈ ភូមិ រាប់ រយ កន្លែង ត្រូវបាន ជន់ លិច ហើយ ជើងហោះហើរ ចេញ និង ចូល ប្រចាំ តំបន់ ត្រូវបាន ផ្អែក ថែម ទៀត ។
គួរ ជម្រាប ថា ក្រៅពី នេះ កំណាត់ ផ្លូវ សរុប ប្រវែង ជាង ១០.០០០ គីឡូម៉ែត្រ ព្រមទាំង លំនៅឋាន រាប់ ពាន់ ខ្នង ក៏ ត្រូវ បំផ្លិចបំផ្លាញ ទាំងស្រុង ឬ ធ្វើឲ្យ ខូចខាត នៅ ទូទាំង រដ្ឋ ផងដែរ ខណៈ អាជ្ញាធរ ក្នុង តំបន់ បាន ចេញ សេចក្តីប្រកាស អាសន្ន ដើម្បីឲ្យ ប្រជាជន មាន ការប្រុង យ័ត្ន ខ្ពស់ នៅ ចំពោះមុខ ការបន្ត ធ្លាក់ ភ្លៀង កាន់តែ ខ្លាំង ថែម ទៀត ៕
យោង តាម អ្នកនាំពាក្យ រូប នេះ ដដែល មេដឹកនាំ នៃ ប្រទេស ទាំង ពីរ បាន ប្ដេជ្ញាចិត្ត ថា នឹង បង្កើន កិច្ចសហប្រតិបត្តិការ តាមរយៈ ការ ទំនាក់ទំនង និង ផ្លាស់ប្ដូរ ទស្សនកិច្ច កម្រិត ខ្ពស់ ទៅ វិញ ទៅមក ។ លើស ពី នេះ ទៅ ទៀត នៅក្នុង កិច្ចសន្ទនា តាម ទូរស័ព្ទ មេដឹកនាំ ទាំង ពីរ ក៏ បាន ពិភាក្សា គ្នា ផងដែរ ស្ដីពី ការរៀបចំ ដំណើរទស្សនកិច្ច របស់ លោក អឺ ដូហ្កាន់ មកកាន់ ប្រទេស អាល្លឺម៉ង់ ដែល គ្រោង នឹង ប្រពឹ្រត្ត ទៅ ពី ថ្ងៃទី ២៨ ដល់ ថ្ងៃទី ២៩ ខែកញ្ញា ខាងមុខ នេះ ។
សូម ជម្រាប ថា លោក អឺ ដូហ្កាន់ បាន បំពេញ ដំណើរទស្សនកិច្ច លើក ចុងក្រោយ នៅ អាល្លឺម៉ង់ កាលពី ឆ្នាំ ២០១៤ ។ ប៉ុន្តែ អ្វី ដែល គួរឱ្យ កត់សម្គាល់ គឺ ថា ជំនួប រវាង មេដឹកនាំ ទាំង ពីរ កើត មាន ឡើង នៅ ចំពេល អាល្លឺម៉ង់ និង តួកគី សុទ្ធតែ កំពុង ទទួលរង សម្ពាធ ពាណិជ្ជកម្ម ពី សហរដ្ឋ អាមេរិក ៕
ទណ្ឌកម្ម ទៀត ហើយ ! សហរដ្ឋ អាមេរិក ដាក់ទណ្ឌកម្ម ក្រុមហ៊ុន ចិន និង រុស្ស៊ី ដោយ ចោទ ថា រកស៊ី ខុស ច្បាប់ ជាមួយ កូរ៉េ ខាងជើង (video inside) ( វ៉ាស៊ីនតោន ) ៖ សហរដ្ឋ អាមេរិក បាន សម្រេចចិត្ត ដាក់ទណ្ឌកម្ម លើ ក្រុមហ៊ុន ចិន និង រុស្ស៊ី ដោយ ចោទ ថា មាន ជាប់ពាក់ព័ន្ធ នឹង ការធ្វើ ពាណិជ្ជកម្ម ខុស ច្បាប់ ជាមួយ កូរ៉េ ខាងជើង ដោយ រំលោភ លើ ទណ្ឌកម្ម សេដ្ឋកិច្ច របស់ ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន យ៉ុន ហាប់ នៅ ថ្ងៃព្រហស្បតិ៍ ទី១៦ ខែសីហា ឆ្នាំ ២០១៨ ។
សូម អាន ព្រឹត្តិបត្រ ព័ត៌មាន និង ការព្យាករណ៍ ពី កម្ពស់ ទឹក៖ តំណាង បញ្ញវន្ត ទូទាំង ប្រទេស ចេញ សេចក្តីថ្លែងការណ៍ និង ទទួលស្គាល់ លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី ០៦
( ភ្នំពេញ ) ៖ សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា បាន ចេញ សេចក្តីថ្លែងការណ៍ មួយ បង្ហាញ ការគាំទ្រ និង ទទួលស្គាល់ លទ្ធផល ជា ផ្លូវការ នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី ០៦ ដែល ប្រកាស ដោយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ ។
សម្រាប់ លទ្ធផល ផ្លូវការ នេះ គណបក្ស ប្រជាជន កម្ពុជា ដែល ជា គណបក្ស កាន់អំណាច បាន ទទួល សំឡេង គាំទ្រ ច្រើន លើសលប់ រហូតដល់ ៤. ៨៨៩. ១១៣ សំឡេង ដោយ ទទួលបាន អាសនៈ ចំនួន ១២៥ គ្រប់គ្រង សភា ទាំងមូល តែម្តង ។ ចំណែក គណបក្ស រាជានិយម ហ៊្វុនស៊ិនប៉ិច ទទួលបាន សំឡេង គាំទ្រ ៣៧៤. ៥១០ សំឡេង . គណបក្ស សម្ព័ន្ធ ដើម្បី ប្រជាធិបតេយ្យ (LDP) ទទួលបាន សំឡេង ៣០៩. ៣៦៤ សំឡេង ។ ត ពីក្រោយ នេះ គឺ គណបក្ស ឆន្ទៈ ខ្មែរ របស់ កូនប្រុស លោក គង់ គាំ ដែល មាន ចំនួន ២១២. ៨៦៩ សំឡេង ៕
ខាងក្រោម នេះ ជា សេចក្តីថ្លែងការណ៍ របស់ សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា៖
នៅ ព្រឹក ថ្ងៃ នេះ គណបក្ស ប្រជាជន កម្ពុជា រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី « លទ្ធផល ជា ផ្លូវការ នៃ ការបោះឆ្នោត »
( ភ្នំពេញ ) ៖ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៨ នេះ រៀបចំ ធ្វើ សន្និសីទ សារព័ត៌មាន ស្តីពី « លទ្ធផល ជា ផ្លូវការ នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី ០៦ ឆ្នាំ ២០១៨ » នេះ បើ យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន របស់ គណបក្ស ប្រជាជន កម្ពុជា បាន ដឹង ថា ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ ដែល បាន បិទ បញ្ចប់ ទៅ ថ្មី ៗ នេះ ប្រព្រឹត្ត ឡើង ដោយ សេរី យុត្តិធម៌ និង មាន តម្លាភាព ហើយ ការបោះឆ្នោត នេះ ត្រូវបាន ចូលរួម ដោយ អ្នកបោះឆ្នោត ដែល មាន លក្ខណៈ សម្បតិ្ត គ្រប់គ្រាន់ យ៉ាង ច្រើន កុះករ និង បាន ទទួលស្គាល់ ដោយ អ្នក សង្កេតការណ៍ ជាតិ និង អន្តរជាតិ មកពី បណ្តា ប្រទេស ជុំវិញ ពិភពលោក ថា ជា សញ្ញា បញ្ជាក់ យ៉ាង ច្បាស់ នូវ ភាព ចាស់ទុំ របស់ កម្ពុជា នៅក្នុង លទ្ធិ ប្រជាធិបតេយ្យ ។
សម្រាប់ លទ្ធផល ផ្លូវការ នេះ គណបក្ស ប្រជាជន កម្ពុជា ដែល ជា គណបក្ស កាន់អំណាច បាន ទទួល សំឡេង គាំទ្រ ច្រើន លើសលប់ រហូតដល់ ៤. ៨៨៩. ១១៣ សំឡេង ដោយ ទទួលបាន អាសនៈ ចំនួន ១២៥ គ្រប់គ្រង សភា ទាំងមូល តែម្តង ៕
សូម កុំ បើកបរ ស្ថិត ក្រោម ឥទ្ធិពល គ្រឿងញៀន ! ស្លាប់ ៤នាក់ និង រងរបួស ២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៥ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ . របួស ស្រាល ម្នាក់ និង របួស ធ្ងន់ ម្នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៥លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៣គ្រឿង . រថយន្ដ ធុន តូច ៣គ្រឿង . រថយន្ដ ធុន ធំ ៣គ្រឿង . ម៉ូតូ កង់ បី២ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . មិន គោរព សិទ្ធិ . ស្រវឹង . ប្រជែង . មិន គោរព សិទ្ធិ និង បត់ គ្រោះថ្នាក់ ។
នៅ យប់ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ អគ្គ ស្ថានីយ៍ វិទ្យុ - ទូរទស្សន៍ មជ្ឈិម ចិន ដែល មាន មូលដ្ឋាន នៅ ទីក្រុង ប៉េកាំង បាន អនុញ្ញាតឲ្យ អង្គភាព ព័ត៌មាន Fresh News ផ្សព្វផ្សាយ ជាមួយ ខ្លឹមសារ បកប្រែ ផ្លូវការ យ៉ាង ដូច្នេះ ថា៖
