( ប៉ៃលិន ) ៖ លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន បាន ដឹកនាំ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ អង្គភាព ជំនាញ ជុំវិញ ខេត្ត ព្រមទាំង លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស ចុះ រៀបចំ តុបតែង កែលម្អ ដាំ ផ្កា និង បំពាក់ ភ្លើង បំភ្លឺ នៅ សួន រង្វង់ មូល ស្តេច កន នៅលើ ដង ផ្លូវ ជាតិ លេខ ៥៩ ក្នុង ស្រុក សាលា ក្រៅ ដើម្បី បង្កើន សោភ័ណភាព និង បម្រើ ឱ្យ ប្រយោជន៍ សាធារណៈ ក្នុង ខេត្ត ។
លោក ផាន់ ចាន់ ធុល ក៏ បាន ជំរុញ ដល់ អាជ្ញាធរ មូលដ្ឋាន ជាពិសេស រដ្ឋបាល ស្រុក សាលា ក្រៅ ត្រូវ មាន ការទទួលខុសត្រូវ ខ្ពស់ ចំពោះ ការថែទាំ ដើម្បី រួមចំណែក លើក កំពស់ សោភ័ណភាព សាធារណៈ ក្នុង ខេត្ត ក្នុង នាម ជា មន្ត្រីរាជការ បម្រើ ជាតិ និង ប្រជាជន ។
សូម បញ្ជាក់ ថា នៅលើ ដង ផ្លូវ ជាតិ លេខ ៥៩ ក្នុង ភូមិសាស្ត្រ ខេត្ត ប៉ៃលិន មាន រង្វង់ មូល ធំ ៗ ចំនួន ២ គឺ រង្វង់ មូល ព្រះគោ និង រង្វង់ មូល ស្តេច កន ដែល បច្ចុប្បន្ន អាជ្ញា ខេត្ត បាន កំពុង រៀបចំ ធ្វើ ការកែកម្អរ ដើម្បី បង្កើន សោភ័ណភាព ក្នុង ការទាក់ទាញ ភ្ញៀវ ទេសចរណ៍ ជាតិ និង អន្តរជាតិ មក កំសាន្ត នៅ ខេត្ត ឱ្យ បាន កាន់តែ ច្រើន ឡើង ជាពិសេស ចូលរួម ការប្រឡង ប្រណាំង ទីក្រុង ស្អាត ផងដែរ ៕ អភិបាល ខេត្ត រតនគិរី ជំរុញ មន្ត្រី បង្កើន សមត្ថភាព និង ទទួលខុសត្រូវ តាម តួនាទី ភារកិច្ចកាន់តែ ខ្លាំង សម្រាប់ អាណត្តិ ថ្មី
( រតនគិរី ) ៖ ថ្លែង នូវ ក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព ខេត្ត នៅ ព្រឹក ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០១៨ នេះ លោក ថង សាវុន អភិបាល ខេត្ត រតនគិរី បាន ជម្រុញ ដល់ មន្ត្រីរាជការ ពិសេស មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ឲ្យ បង្កើន សមត្ថភា និង ទទួលខុសត្រូវ តាម តួនាទី ភារកិច្ចកាន់តែ ខ្លាំង សម្រាប់ អាណត្តិ ថ្មី របស់ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ឲ្យ សម ទៅនឹង អ្វី ដែល ប្រជាពលរដ្ឋ បាន ផ្តល់ នូវ ការជឿទុកចិត្ត កន្លងមក ថ្មី ៗ នេះ ។
លោក អភិបាល ខេត្ត ក៏ បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ នៅ ទូទាំង ខេត្ត ទាំង មុនពេល កំឡុង ពេល និង ក្រោយពេល បោះឆ្នោត ដោយ អាជ្ញាធរ ជំនាញ បាន សហការ យកចិត្តទុកដាក់ រក្សា បាន នូវ សន្តិសុខ សុវត្ថិភាព បរិយាកាស នយោបាយ ប្រកបដោយ ភាពស្ងប់ស្ងាត់ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បញ្ជាក់ ទៀត ថា បើ តាម ការប្រកាស របស់ គ.ជ. ប ការប្រកាស លទ្ធផល ផ្លូវការ អំពី ការបែងចែក អាសនៈ នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត សម្រាប់ នីតិកាល ទី៦ នឹង ត្រូវ ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ១៥ ខែសីហា ស្អែក នេះ ។
នៅ ថ្ងៃស្អែក នេះ ដែរ ខ្ញុំ ក៏ នឹង ចុះ ជួប សួរ សុខទុក្ខ ព្រមទាំង ដោះស្រាយ បញ្ហា ប្រឈម នានា មួយចំនួន ដល់ កូនក្មួយ កម្មករ នៅ ខណ្ឌ ឬស្សីកែវ រាជធានី ភ្នំពេញ ផងដែរ ។ អរគុណ ណាស់ ដែល ក្មួយ ៗ បាន បោះឆ្នោត គាំទ្រ អោយ គណបក្ស ប្រជាជន លេខ ២០ កន្លងមក នេះ ។
ការបោះឆ្នោត ឆ្នាំ ២០១៨ នេះ គឺ កម្ពុជា បាន បង្ហាញ ឲ្យ ពិភពលោក បាន ឃើញ ច្បាស់ ថា ប្រជាពលរដ្ឋ ៨៣. ០២ % បាន ទៅ បោះឆ្នោត ដើម្បី កំណត់ ជោគវាសនា ប្រទេសជាតិ ព្រោះ ថា មាន តែ កម្ពុជា ទេ ទើប អាច យល់ ច្បាស់ អំពី អ្វី ដែល ខ្លួន ចង់បាន ជាពិសេស និរន្តភាព នៃ ការអភិវឌ្ឍ និង សុខ សន្តិភាព យូរអង្វែង ។ ជូនពរ បងប្អូន ជន រួម ជាតិ ទូទាំង ប្រទេស ជួប តែ សេចក្តីសុខ ចម្រុង ចម្រើន គ្រប់ ទីកន្លែង !» ៕
ក្រុមហ៊ុន ៧៣ និង បញ្ជរ ១១៦ នឹង ចូលរួម ក្នុង ពិព័រណ៍ ការងារ និង ផលិតភាពជាតិ នៅ ថ្ងៃទី ២៧ - ២៨ ខែតុលា ខាងមុខ នេះ
( ភ្នំពេញ ) ៖ តាម ការគ្រោងទុក ពិព័រណ៍ ការងារ និង ផលិតភាពជាតិ នឹង ទាក់ទាញ អ្នកចូលរួម ទស្សនា ប្រមាណ ជាង ៣ម៉ឺន នាក់ ដោយ នាំមក នូវ ក្រុមហ៊ុន សហគ្រាស គ្រឹះស្ថាន អប់រំ បណ្តុះបណ្តាល ចំនួន ១៥០ ដែល នឹង ចូលរួម តាំង បង្ហាញ អំពី តម្រូវការ ជ្រើសរើស កម្លាំង ពលកម្ម មគ្គុទេសក៍ និង បទពិសោធន៍ សម្រាប់ ឈានចូល ទីផ្សារ ការងារ ព្រមទាំង ឱកាស បណ្តុះបណ្តាល ជំនាញ ផ្សេង ៗ ទៀត ។
ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ គ្រោង នឹង រៀបចំ ពិព័រណ៍ ការងារ និង ផលិតភាពជាតិ ឆ្នាំ ២០១៨ របស់ ខ្លួន រយៈពេល ពីរ ថ្ងៃ ជាប់ ៗ គ្នា គឺ ថ្ងៃទី ២៧ - ២៨ ខែ តុលា ឆ្នាំ ២០១៨ នា ពេល ខាងមុខ នេះ នៅ សាល ពិព៌រណ៍ កោះ ពេជ្រ ។ នេះ ជា លើក ទី២ ហើយ សម្រាប់ ការរៀបចំ ពិព័ណ៌ ការងារ និង ផលិតភាពជាតិ ខណៈ ពិព័រណ៌ ការងារ ថ្នាក់ ជាតិ រៀបចំឡើង ជា លើក ទី៨ ។
គោលបំណង នៃ ការរៀបចំ ព្រឹត្តិការណ៍ ការងារ ថ្នាក់ ជាតិ ដ៏ ធំ នេះ គឺ ដើម្បីឱ្យ និយោជក ធ្វើ ការផ្សព្វផ្សាយ ពី ផែនការ តម្រូវការ គោល នយោបាយ ក្នុង ការជ្រើសរើស ពលកម្ម នា ពេល បច្ចុប្បន្ន និង អនាគត ដើម្បី ទាក់ទាញ អ្នក ស្វែងរក ការងារ ធ្វើ ដែល មាន សមត្ថភាព ។ ផ្តល់ ការអប់រំ បណ្តុះបណ្តាល ផ្សព្វផ្សាយ កម្មវិធី សិក្សា វគ្គ ខ្លី ៗ និង កម្មវិធី អភិវឌ្ឍ ជំនាញ ផ្សេង ៗ ។
( វ៉ាស៊ីនតោន ) ៖ បើ ទោះជា មាន ការខ្វែងគំនិត គ្នា មួយចំនួន ក៏ ពិត មែន តែ សហរដ្ឋ អាមេរិក និង ចិន នៅតែ អាច ធ្វើ ការងារ រួមគ្នា ដើម្បី ដោះស្រាយ បញ្ហា ទាំងឡាយ និង កង កសាង អនាគត ដ៏ ភ្លឺស្វាង នៃ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ។ នេះ បើ តាម ការលើកឡើង ដោយ អគ្គ រដ្ឋទូត អាមេរិក ប្រចាំ ប្រទេស ចិន ដកស្រង់ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃអង្គារ ទី ១៤ ខែសីហា ឆ្នាំ ២០១៨ ។
យ៉ាងណាមិញ នេះ ជាបទចម្រៀង ដែល កញ្ញា ប៊េប៊ី ចេញ ស្ទីល រ៉េប យ៉ាង ប្លែក ត្រចៀក ខណៈ ដែល តារា រូប នេះ ក៏ បាន ប្រកាស ថា នឹង ចំណាយ ទុន ផលិត ជា MV ឲ្យ ញាក់ សាច់ បន្ទាប់ពី បទចម្រៀង នេះ ចេញមក ក៏ មាន ការពេញនិយម ខុសពី ការគ្រោងទុក ។
ដោយឡែក អ្នកស្នេហា វិស័យ បទចម្រៀង រ៉េប បាន សរសើរ មិន ដាច់ ពី មាត់ ជាមួយនឹង សមត្ថភាព របស់ នាង ដែល ក្រៅពី អាច បកស្រាយ បទចម្រៀង បែប មនោសញ្ចេតនា និង បទ ប្រភេទ ញាក់ ៗ បាន ល្អ ហើយ ស្រាប់តែ នាង អាច បកស្រាយ បទចម្រៀង ប្រភេទ រ៉េប មួយ បទ នេះ បាន ទៀត ៕
