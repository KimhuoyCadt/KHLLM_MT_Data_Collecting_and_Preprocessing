( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា បាន ចេញ សេចក្ដីជូនដំណឹង មួយ ប្រកាស ផ្អាក ការផ្គត់ផ្គង់ អគ្គិសនី នៅ តំបន់ ភ្លើង មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ក្នុង រាជធានី ភ្នំពេញ រយៈពេល ៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៩ - ១២ ខែសីហា ឆ្នាំ ២០១៨ សម្រាប់ ការងារ ជួសជុល ដំឡើង បរិក្ខារ ៕
យោង តាម លិខិត ជូន ព័ត៌មាន របស់ ក្រសួង ការបរទេស ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ព្រលឹម អុរ ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន ឲ្យដឹង ថា កាលពី ថ្ងៃទី ០៥ ខែសីហា ឆ្នាំ ២០១៨ លោក អាឡាន ភីធ័រ ស. ខា យ៉េតាណូ រដ្ឋមន្ត្រី ការបរទេស ហ្វីលីពីន បាន ផ្ញើ លិខិត មក កាន់ ទេសរដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង បរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ សម្តែង ការអបអរសាទរ ចំពោះ ដំណើរការបោះឆ្នោត នៅ កម្ពុជា ។
ក្នុង លិខិត នោះ រដ្ឋមន្ត្រី ការបរទេស ហ្វីលីពីន បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ « ក្នុង នាម ឯកឧត្តម ប្រធានាធិបតី រូឌ្រីហ្គោ ឌូតឹ តេ និង ប្រជាជន ហ្វីលីពីន ខ្ញុំ សូម អបអរសាទរ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា ចំពោះ ការបោះឆ្នោត នា ពេល ថ្មី ៗ នេះ ដែល បាន ប្រព្រឹត្តទៅ ប្រកបដោយ សន្តិភាព និង មាន សណ្តាប់ធ្នាប់ » ។
ក្នុង លិខិត នោះ រដ្ឋមន្រ្តី ការបរទេស ហ្វីលីពីន ក៏ បាន បញ្ជាក់ ដែរ ថា ហ្វីលីពីន នៅតែ ប្តេជ្ញាចិត្ត ធ្វើការ ជាមួយ កម្ពុជា ដើម្បី ពង្រឹង បន្ថែម ទៀត នូវ ទំនាក់ទំនង ជា មិត្តភាព និង ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ក្នុង កម្រិត ទ្វេ ភាគី តំបន់ និង អន្តរជាតិ ។
សូម បញ្ជាក់ ថា ហ្វីលីពីន ជា ប្រទេស សមាជិក អាស៊ាន ទី៣ ហើយ ដែល បាន ប្រកាស គាំទ្រ ការដំណើរការបោះឆ្នោត នៅ កម្ពុជា បន្ទាប់ពី ប្រទេស ឡាវ និង វៀតណាម ។ ក្រៅពី ប្រទេស សមាជិក អាស៊ាន ទាំង៣ នេះ ប្រទេស ចិន និង អង្គការ អន្តរជាតិ មួយចំនួន ទៀត ក៏ បាន ប្រកាស គាំទ្រ ដំណើរការបោះឆ្នោត នៅ កម្ពុជា ផងដែរ ។
បើ តាម ការឲ្យដឹង ពី អាជ្ញាធរ ឥណ្ឌូណេស៊ី នៅ ថ្ងៃពុធ នេះ គ្រោះ រញ្ជួយ ដី ខាងលើ ដែល បាន កើត មាន ឡើង កាលពី ថ្ងៃអាទិត្យ បាន ផ្តាច់ ជីវិត មនុស្ស កើន ដល់ ៣៤៧ នាក់ ។ មិន តែ ប៉ុណ្ណោះ គ្រោះ ធម្មជាតិ នេះ ក៏ បាន បង្ក ភាពវឹកវរ ជាខ្លាំង ដល់ ប្រជាជន រស់ នៅក្នុង តំបន់ ព្រមទាំង ភ្ញៀវ ទេសចរ ផងដែរ ហើយ វា កើតឡើង តែ មួយ សប្តាហ៍ ប៉ុណ្ណោះ ក្រោយ កោះ ទេសចរណ៍ Lombok ដែល មាន មនុស្ស រស់ នៅ ជាង ០៣លាន នាក់ នេះ ទើបតែ បាន ទទួលរង ការវាយលុក ដោយ គ្រោះ រញ្ជួយ ដី កម្រិត ធ្ងន់ មួយ ផ្សេង ទៀត ដែល បាន សម្លាប់ ជីវិត មនុស្ស ១៧នាក់ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី ០៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ អតីត នាយក រដ្ឋមន្រ្តី ម៉ាឡេស៊ី លោក ណា ជី ប រ៉ាហ្សាក់ (Najib Razak) នា ថ្ងៃពុធ នេះ បាន រង បទ បោទ ប្រកាន់ ចំនួន ០៣ ករណី ទៀត ទាក់ទិន នឹង ការលាង លុយក ខ្វក់ បន្ថែម ពីលើ ការចោទប្រកាន់ មួយចំនួន កាលពី ខែកក្កដា ដែល ពាក់ព័ន្ធ នឹង ការរំលោភ លើ ទំនុកចិត្ត និង អំពើពុករលួយ ដែល ធ្វើឲ្យ លោក កាន់តែ ទទួលរង ការប្រឈមមុខ ធ្ងន់ធ្ងរ បន្ថែម ទៀត ចំពោះមុខ ការកាត់ក្តី ពី តុលាការ ៕
៣៖ កូរ៉េ ខាងជើង បាន ចោទប្រកាន់ កូរ៉េ ខាងត្បូង នៅ ថ្ងៃពុធ នេះ ថា កំពុង ស្វែងរក ការប្រឈមមុខ ដាក់ គ្នា ជាថ្មី និង បំផ្លាញ បរិយាកាស សន្តិភាព បច្ចុប្បន្ន នៅលើ ឧបទ្វីប កូរ៉េ ដោយ សំអាង លើ ជំនួប យោធា នា ពេល ថ្មី ៗ នេះ រវាង ទីក្រុង វ៉ាស៊ីនតោន និង ទីក្រុង សេអ៊ូល ៕
៥៖ រដ្ឋាភិបាល ឡាវ បាន ប្រកាស ថា ខ្លួន នឹង ចុះ ធ្វើការត្រួតពិនិត្យ លើ ស្តង់ដា សុវត្ថិភាព ក្នុង ដំណើរការ សាងសង់ ទំនប់ វារី អគ្គិសនី នៅ ទូទាំង ប្រទេស ក្រោយ កើតមាន គ្រោះមហន្តរាយ បាក់ ទំនប់ នៅ ខេត្ត អាត់ តាពើ ភាគ ខាងត្បូង ដែល បាន បង្ក ការបំផ្លិចបំផ្លាញ យ៉ាង ខ្លាំងក្លា ៕
( ភ្នំពេញ ) ៖ មន្ត្រី នគរបាល អន្តរាគមន៍ ពិសេស នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ម្នាក់ បាន ទាញ កាំភ្លើង ខ្លី ម៉ាក កា៥៤ មួយ ដើម បាញ់ មេឃ ជិត ១០គ្រាប់ បណ្ដាលឲ្យ ផ្ទុះ លាន់ ឮ ឡើង យ៉ាង កក្រើក នៅ រសៀល ថ្ងៃទី ៨ ខែសីហា ឆ្នាំ ២០១៨ នៅ ចំណុច បន្ទប់ ជួល ជាន់ ទី៣ ក្នុង ភូមិ ព្រៃ ទា សង្កាត់ ចោម ចៅ ទី៣ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្ន ពេញ ។
មន្ត្រី នគរបាល រូប នោះ មាន ឈ្មោះ កែវ សុផល អាយុ ៤០ ឆ្នាំ ស្នាក់ នៅ បន្ទប់ ជួល ជាន់ ទី៣ ភូមិ ព្រៃ ទា ។ គាត់ បាន ប្រើប្រាស់ កាំភ្លើង ខ្លី ម៉ាកា៥៤ ដោយ បាញ់ ជិត ១០គ្រាប់ ហើយ កាំភ្លើង នោះ ក៏ ត្រូវបាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ ដកហូត និង រកឃើញ គ្រាប់ កាំភ្លើង ចំនួន ៤គ្រាប់ រួម ជាមួយ សំបក គ្រាប់ ជាច្រើន ទៀត ផងដែរ ។
ប្រជាពលរដ្ឋ នៅ កន្លែង កើត ហេតុ បាន និយាយ ថា នៅ វេលា កើត ហេតុ ខាង លើ ពួកគាត់ បាន ឃើញ បុរស រូប នេះ ឈរ កាន់ កាំភ្លើង នៅ ជាន់ ទី៣ ក្នុង ផ្ទះ ជួល ខាងលើ បន្ទាប់មក ស្រាប់ បាញ់ ឡើង លើ ជាច្រើន គ្រាប់ តែម្ដង ដោយ មិន ដឹង ថា គាត់ មាន វិបត្តិ អ្វី ឡើយ ។ ពេល នោះ ដោយ ខ្លាច មាន គ្រោះថ្នាក់ ពួកគាត់ បាន នាំគ្នា រត់ ចូលក្នុង ផ្ទះ ទាំង ព្រលឹង ចុង សក់ ។
ក្រោយមក បន្ទាប់ពី ឃើញ កម្លាំង នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ ចុះ ទៅដល់ នាំ ខ្លួន បុរស នេះ ទើប ពួក គាត់ ហ៊ាន ចេញ ក្រៅ ផ្ទះ វិញ ។ បើ តាម ការសួរនាំ ជា ជំហ៊ាន ដំបូង នោះ មន្រ្តី នគរបាល រូប នេះ បាន និយាយ ថា មូលហេតុ ដែល គាត់ បាញ់ ជិត ១០គ្រាប់ យ៉ាង ដូច្នេះ ដោយសារ គាត់ បាន យល សុបិន្ត ឃើញ មនុស្ស មួយ ក្រុម ដេញ វាយ គាត់ និង ចាប់ វះ ពោះ គាត់ ទើប បានជា មមើទៅ ទាញ កាំភ្លើង បាញ់ យ៉ាង ដូច្នេះ ។
យ៉ាងណា ក៏ដោយ នេះ ជា ការឆ្លើយ របស់ មន្រ្តី នគរបាល រូប នេះ តែ សម្រាប់ ចំណាត់ការ បែប ណា នោះ រង់ចាំ ការស៊ើបអង្កេត របស់ សមត្ថកិច្ច ជំនាញ សិន ខណៈ កំពុង សួរនាំ នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ នៅឡើយ ៕
អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល៖ ការស្នើ របស់ ឧបការី អាមេរិក ឱ្យ កម្ពុជា ដោះលែង លោក កឹម សុខា ជា សំណើ ខុស ទិសដៅ
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា លោក ផៃ ស៊ីផាន នៅ រសៀល ថ្ងៃទី ៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន លើកឡើង ថា ការស្នើ របស់ ឧបការី អាមេរិក ឲ្យ កម្ពុជា ដោះលែង លោក កឹម សុខា អតីត ប្រធាន គណបក្ស សង្រ្គោះ ជាតិ ឲ្យ នៅ ក្រៅ ឃុំ នោះ គឺជា ខុស ទិសដៅ ដោយសារតែ សមត្ថកិច្ច នេះ មិន ឋិតនៅលើ រាជ រដ្ឋាភិបាល កម្ពុជា នោះ ទេ ប៉ុន្តែ វា ជា ដែន សមត្ថកិច្ច របស់ ស្ថាប័ន តុលាការ ។
បើ តាម លោក ផៃ ស៊ីផាន . ការសម្រេច ឲ្យ ដោះលែង ឬ មិន ដោះលែង អតីត ប្រធាន គណបក្ស សង្គ្រោះ ជាតិ រូប នេះ និង មន្ត្រី ជាន់ ខ្ពស់ អតីត គណបក្ស នេះ មិន មែន ជា ដែន សមត្ថកិច្ច របស់ រាជ រដ្ឋាភិបាល នោះ ទេ តែ ជា ដែន សមត្ថកិច្ច របស់ តុលាការ ដែល មាន អំណាច ដាច់ដោយឡែក ត្រូវបាន ចែង ដោយ រដ្ឋធម្មនុញ្ញ ។
លោក បាន បញ្ជាក់ ថា « ការស្នើសុំ របស់ ឧបការី រូប នេះ ក្នុង ការដោះលែង លោក កឹម សុខា និង អ្នកទោស មួយចំនួន ទៀត នោះ គឺ ខុស ទិសដៅ មិន មែន ឋិតនៅក្នុង ដែន សមត្ថកិច្ច របស់ រាជ រដ្ឋាភិបាល នោះ ទេ គឺជា ដែន សមត្ថកិច្ច របស់ តុលាការ »។ លោក បន្ត ថា « ដោយឡែក ករណី របស់ លោក កឹម សុខា ករណី នេះ គឺ កំពុង ស្ថិត នៅក្នុង ដំណើរការ នៃ នីតិវិធី របស់ តុលាការ » ។
សូម បញ្ជាក់ ថា លោក កឹម សុខា ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន នៅ យប់ រំលង អាធ្រាត្រ ឈានចូល ថ្ងៃទី ០៣ ខែកញ្ញា ឆ្នាំ ២០១៧ នៅ គេហដ្ឋាន របស់ លោក ស្ថិត នៅក្នុង សង្កាត់ បឹងកក់២ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ក្រោយពី សារព័ត៌មាន CBN អូស្រ្តាលី ចេញ វីដេអូ មួយ បង្ហាញ ថា លោក បាន អនុវត្ត តាម ការបញ្ជា របស់ សហរដ្ឋ អាមេរិក ដែល ជា អំពើ ក្បត់ ជាតិ ដើម្បី ដណ្តើម អំណាច ពី រាជ រដ្ឋាភិបាល កម្ពុជា ស្រប ច្បាប់ ដែល កើត ចេញពី ការបោះឆ្នោត ។
ក្រោយ ការចាប់ខ្លួន តុលាការ បាន សម្រេច ចោទប្រកាន់ លោក កឹម សុខា ពី បទ « សន្ទិដ្ឋិភាព ជាមួយ បរទេស » ដែល ជា បទល្មើស មួយ ក្នុង អំពើ ក្បត់ ជាតិ ក្នុង មាត្រា ៤៤៣ នៃ ក្រម ព្រហ្មទណ្ឌ ដែល បទល្មើស នេះ ប្រឈម នឹង ការដាក់ ពន្ធនាគារ ពី ១៥ ទៅ៣០ ឆ្នាំ ហើយ លោក កឹម សុខា ក៏ ត្រូវបាន ដាក់ ពន្ធនាគារ ជា បណ្តោះអាសន្ន ផងដែរ ៕ ឯក អគ្គ រដ្ឋទូត ថ្មី របស់ ឥណ្ឌូនេស៊ី ប្រចាំ កម្ពុជា សន្យា នឹង ខិតខំ អស់ លទ្ធភាព ដើម្បី ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ លើ វិស័យ កសិកម្ម រវាង ប្រទេស ទាំង ពីរ ឲ្យបាន់តែ ល្អ ប្រសើរ ថែម ទៀត
លោក ឯក អគ្គ រដ្ឋទូត បាន កោតសរសើរ ពី ការរីកចម្រើន របស់ ប្រទេស កម្ពុជា និង វាយតម្លៃ ខ្ពស់ លើ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ នា ពេល កន្លងមក ពិសេស លើ វិស័យ កសិកម្ម ហើយ លោក ឯក អគ្គ រដ្ឋទូត បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ លោក រដ្ឋមន្រ្តី និង ថ្នាក់ដឹង នាំ ក្រសួង គ្រប់ លំដាប់ថ្នាក់ ដែល បាន ផ្តល់ កិច្ចសហប្រតិបត្តិការ ជាមួយ រដ្ឋាភិបាល ឥណ្ឌូនេស៊ី យ៉ាង ល្អ ប្រសើរ ក្នុង រយៈពេល កន្លងមក ។
ក្នុង ឱកាស បំពេញ បេសកកម្ម ការ ទូត នៅ កម្ពុជា លោក ឯក អគ្គ រដ្ឋទូត សន្យា ថា នឹង ខិតខំ អស់ លទ្ធភាព ដើម្បី ធ្វើ ជួយ ជំរុញ ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ លើ វិស័យ កសិកម្ម រវាង ប្រទេស ទាំង ពីរ ឲ្យបាន់តែ ល្អ ប្រសើរ មួយ កម្រិត ទៀត ហើយ ទាក់ទង នឹង សំណើ ដែល លោក រដ្ឋមន្រ្តី បាន លើកឡើង លោក ឯក អគ្គ រដ្ឋទូត សន្យា ថា នឹង នាំយក សំណើ នេះ ទៅ ពិភាក្សា ជាមួយ ក្រសួង ឬ ស្ថាប័ន ពាក់ព័ន្ធ បន្ទាប់ នឹង ឈាន ទៅ ធ្វើ ការផ្លាស់ប្តូរ មន្រ្តី ជំនាញ ឬ បង្កើត ក្រុមការងារ បច្ចេកទេស ដើម្បី ស្វែងរក ដំណោះស្រាយ ៕
យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៨ ខែសីហា លទ្ធផល៖ បង្ក្រាប ១៦ករណី ឃាត់ខ្លួន ២៧ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៨ ខែសីហា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
ទំហំ ពាណិជ្ជកម្ម កម្ពុជា នៅ ឆមាស ទី១ ឆ្នាំ ២០១៨ មាន ជាង ១៣ ពាន់ លាន ដុល្លារ ក្នុង នាំចេញ ជិត ៦ពាន់ លាន ដុល្លារ !
ពាក់ព័ន្ធ នឹង ការកើនឡើង នៃ ទំហំ ពាណិជ្ជកម្ម របស់ កម្ពុជា នេះ លោក ស៊ាង ថៃ អ្នកនាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម បាន ថ្លែង ឲ្យដឹង នៅ ល្ងាច ថ្ងៃទី ០៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ ថា កម្ពុជា បាន នាំចេញ ទៅ ប្រទេស មួយចំនួន ដូចជា សហគម អឺរ៉ុប . សហរដ្ឋ អាមេរិក . កាណាដា . ជប៉ុន និង បណ្ដា ប្រទេស ផ្សេង ៗ ទៀត ហើយ វិស័យ ដែល នាំចេញ បាន ច្រើន ជាង គេ រួម មាន សម្លៀកបំពាក់ និង អង្ករ ជាដើម ។
លោក បាន បញ្ជាក់ ទៀត ថា កត្តា ដែល នាំឲ្យ ទំហំ ពាណិជ្ជកម្ម ក្នុង ឆ្នាំ នេះ មាន ការកើនឡើង បណ្ដាល មកពី ស្ថិរភាព របស់ ប្រទេស កម្ពុជា មាន ភាពល្អ ប្រសើរ ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ មាន វិនិយោគិន បរទេស ជាច្រើន បាន មក វិនិយោគ នៅ កម្ពុជា ។ មួយ វិញទៀត ការផលិត របស់ កម្ពុជា មាន សន្ទុះ បូករួម នឹង គុណភាពល្អ ប្រសើរ ទើប ធ្វើឲ្យ ការនាំចេញ ស្ទុះ ងើប ឡើង ។
លោក ប៉ាន សូស័ក្ដិ រដ្ឋមន្រ្ដី ក្រសួង ពាណិជ្ជកម្ម បាន បញ្ជាក់ ថា ក្នុង ឆមាស ទី០១ ឆ្នាំ ២០១៨ នេះ កម្ពុជា បាន នាំចេញ សម្លៀកបំពាក់ បាន ចំនួន ៤. ១៤៣លាន ដុល្លារ កើនឡើង ១១ភាគរយ ចំណែកឯ ផលិតផល កសិកម្ម មាន ចំនួន ២៧២ លាន ដុល្លារ កើន ៨ភាគរយ ខណៈ ការនាំចេញ ផ្សេង ៗ មាន ចំនួន ១. ៣៧៩ លាន ដុល្លារ កើន ១៤ភាគរយ បើ ធៀប នឹង រយៈពេល ដូចគ្នា ឆ្នាំ ២០១៨ ។
ទេសរដ្ឋមន្រ្តី អៀង មូលី ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ អញ្ជើញ ជូន ភ្លើង សព លោក សាស្រ្តាចារ្យ វេជ្ជ. លី ប៉ូរ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត សុខ ទូច ប្រធាន រាជ បណ្ឌិត សភា កម្ពុជា បាន លើកឡើង ថា ចំពោះ មន្ត្រី ហៃ អើរនិយម មាន មុខតំណែង សុំ លា លែង ឱ្យ ហើយ ទៅ ទុក មុខតំណែង នេះ ឲ្យ មន្ត្រី ដែល សកម្ម ជា អ្នកធ្វើ ការងារ ម្តង ។ លោក ថា នឹង ត្រៀម ជ្រើសរើស មន្ត្រី ថ្មី ឲ្យ ចូល បម្រើ ការងារ នៅ រាជ បណ្ឌិត សភា កម្ពុជា ហើយ លោក ក៏ ជា អ្នក មើល ដោយ ផ្ទាល់ ដើម្បី ជ្រើសរើស បាន មន្ត្រី ល្អ ៗ មន្ត្រី បម្រើ ការងារ ផងដែរ ។
លោក បណ្ឌិត សុខ ទូច បាន លើកឡើង ដូចនេះ នៅ ព្រឹក ថ្ងៃទី ៨ ខែសីហា ឆ្នាំ ២០១៨ នេះ ក្នុង ឱកាស ដែល លោក អញ្ជើញ ជា គណៈអធិបតី ក្នុង សន្និសីទ សារព័ត៌មាន ស្តីពី សមិទ្ធផល ១ ឆ្នាំ និង ទិសដៅ ការងារ ថ្មី របស់ រាជ បណ្ឌិត សភា កម្ពុជា ដែល ពិធី នេះ ដែរ មាន ការចូលរួម ពី មន្ត្រី បំរើ ការងារ នៅក្នុង រាជ បណ្ឌិត សភា កម្ពុជា ប្រមាណ ១០០ នាក់ ផងដែរ ។
លោក បណ្ឌិត សុខ ទូច បាន បញ្ជាក់ ទៀត ថា មន្ត្រី ទ្រឹស្តី និយម មាន ច្រើន ណាស់ មាន ន័យ ថា មន្ត្រី ដែល ចេះតែ ដើរ បង្រៀន មួយ ជីវិត បង្រៀន តែ មេរៀន ដដែល ៗ អត់ ដែល ធ្វើ អ្វី ថ្មី ៗ ទេ ហើយ មន្ត្រី ទ្រឹស្តី និយម គួរតែ ត្រូវបាន បញ្ចប់ ហើយ សូម ឱ្យ យក ទ្រឹស្តី ផ្សារ ភ្ញាប់ នឹង ការអនុវត្ត កុំ យក តែ របស់ គេ មក ហើយ ធ្វើ ដូចជា ខ្លួន ឯង នឹង ពូកែ នោះ ហើយ ចំពោះ ថ្នាក់ដឹង នាំ គ្រួសារ និយម ក៏ គួរតែ ត្រូវបាន កាត់បន្ថយ ផងដែរ ៕
