ចាប់ពី ថ្ងៃ ដាក់ ឲ្យ ប្រើប្រាស់ ម៉ាស្ទ័រ កាត រហូតមកដល់ ថ្ងៃ នេះ អតិថិជន របស់ វីង បាន ធ្វើ ប្រតិបត្តិការ ទូទាត់ ប្រាក់ រហូតដល់ ជិត ១០ម៉ឺន ប្រតិបត្តិការ ដែល នេះ ជា សាក្សី មួយ ដែល បង្ហាញ អំពី ទំនុកចិត្ត របស់ អតិថិជន ទៅ លើ សេវាកម្ម របស់ ធនាគារ ឯកទេស វីង ដែល ជា ក្រុមហ៊ុន ឈាន មុខ គេ លើ សេវាកម្ម ធនាគារ ចល័ត នៅ កម្ពុជា ។
ថ្លែង នៅក្នុង ពិធី ចាប់ រង្វាន់ នោះ លោក ចូចូ ម៉ាឡូឡូស អគ្គ នាយក ធនាគារ ឯកទេស វីង បាន ថ្លែង ថា ការចាប់ រង្វាន់ នេះ គឺជា ការចាប់ រង្វាន់ ធំ បន្ទាប់ពី ការចាប់ រង្វាន់ ប្រចាំ ខែ នូវ ទឹកប្រាក់ ១០០ ដុល្លារ ចំនួន ៥០រង្វាន់ កន្លងមក ។
លោក ម៉ាឡូឡូស បាន បន្ដ ថា « សូម អបអរសាទរ ចំពោះ អ្នក ឈ្នះ រង្វាន់ ទាំង បី រូប ។ យើង ជឿជាក់ យ៉ាង មុតមាំ ថា អតិថិជន នឹង បន្ត ប្រើប្រាស់ នូវ វីង អនឡាញ ម៉ាស្ទ័រ កាត ដោយ ហេតុ ថា ធនាគារ ឯកទេស វីង និង ដៃគូ របស់ យើង ម៉ាស្ទ័រ កាត នឹង បន្ត ផ្តល់ ជូន នូវ កម្មវិធី ថ្មី ជាច្រើន ដែល កាន់តែ ភ្ញាក់ផ្អើល និង រំភើប សម្រាប់ អតិថិជន » ។
លោក តេក សុផល តំនាង ម៉ាស្ទ័រ កាត ប្រចាំ នៅ ប្រទេស កម្ពុជា បាន ថ្លែង ថា « សូម អរគុណ អតិថិជន ដែល គាំទ្រ វីង អនឡាញ ម៉ាស្ទ័រ កាត កន្លងមក ។ យើង សូម ជូនពរ អតិថិជន ដែល ឈ្នះ រង្វាន់ ទាំងអស់ សូមឲ្យ មាន ភាពសប្បាយរីករាយ នៅ ពេល ដែល ពួកគាត់ ធ្វើដំណើរកំសាន្ត ទៅកាន់ ប្រទេស សិង្ហបុរី » ។
ធនាគារ ឯកទេស វីង នឹង ធ្វើ ការទំនាក់ទំនង ទៅកាន់ អ្នក ឈ្នះ រង្វាន់ ទាំងអស់ ក្នុង ចន្លោះ ថ្ងៃទី១០ ដល់ ថ្ងៃទី ២៣ ខែសីហា ឆ្នាំ ២០១៨ តាមរយៈ លេខ ០២៣ ៩៩៩ ៩៨៩ និង មិន តម្រូវឲ្យ អតិថិជន បង់ ថ្លៃ អ្វី ទាំងអស់ ហើយ យើង ក៏ នឹង មាន ពិធី ប្រគល់ រង្វាន់ នេះ ទៅដល់ អ្នក ឈ្នះ រង្វាន់ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០១៨ នៅ សណ្ឋាគារ កាំបូឌីយ៉ាណា ផងដែរ ។
សម្រាប់ អតិថិជន ដែល មិន បាន ឈ្នះ រង្វាន់ លើក នេះ សូម កុំ បារម្ភ ព្រោះថា ធនាគារ ឯកទេស វីង នឹង មាន កម្មវិធី ជាច្រើន សម្រាប់ លោក អ្នក ។ អ្វី ដែល លោក អ្នក ត្រូវ ធ្វើ គឺ គ្រាន់តែ បន្ត ធ្វើ ប្រតិបត្តិការ ទូទាត់ ប្រាក់ ដោយ ប្រើប្រាស់ វីង អនឡាញ ម៉ាស្ទ័រ កាត និង រង់ចាំ តាមដាន នូវ ប្រូម៉ូសិន ពី វីង ដែល នឹង មាន ក្នុង ពេល ឆាប់ ៗ នេះ ។
( សេអ៊ូល ) ៖ ក្រសួង បង្រួបបង្រួម ជាតិ កូរ៉េ ខាងត្បូង បាន បញ្ជាក់ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ ថា ទីក្រុង សេអ៊ូល និង ទីក្រុង ព្យុងយ៉ាង នឹង រៀបចំ កិច្ចប្រជុំ កម្រិត ខ្ពស់ មួយ នៅ សប្ដាហ៍ ក្រោយ នេះ ដើម្បី ត្រួតពិនិត្យ នូវ ការអនុវត្ត តាម អ្វី ដែល មាន ចែង ក្នុង សេចក្ដីថ្លែងការណ៍ រួម Panmunjom ក៏ ដូចជា ពិភាក្សា ផងដែរ ពី លទ្ធភាព នៃ ការរៀបចំ នួន កំពូល រវាង មេដឹកនាំ នៃ ប្រទេស ទាំង ពីរ ជាថ្មី ម្ដង ទៀត ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន យ៉ុន ហាប់ នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី០៩ ខែសីហា ឆ្នាំ ២០១៨ ។
អភិបាល ខណ្ឌ ឬស្សីកែវ ចុះ ថ្លែងអំណរគុណ ដល់ ពលរដ្ឋ នៅ សង្កាត់ គីឡូម៉ែត្រ លេខ ៦ ក្រោយ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន ឲ្យ ទទួលបាន ជ័យជម្នះ
សូម ជម្រាប ថា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន ណែនាំ ដល់ ថ្នាក់ដឹកនាំ និង មន្ដ្រី គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ ត្រូវតែ បន្ដ ចុះ ជួប សំណេះសំណាល់ និង សួរសុខទុក្ខ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ទោះបី មិន ទាន់ បង្កើត រាជ រដ្ឋាភិបាល ថ្មី ក៏ដោយ ដើម្បី ឆ្លើយតប នូវ ការខិតខំ របស់ ពលរដ្ឋ ដែល បាន ជឿជាក់ មក លើ គណបក្ស ប្រជាជន កម្ពុជា ៕ សាលា ប៊ែល ធី អន្តរជាតិ បើក បវេសនកាល ថ្មី ឆ្នាំ សិក្សា ២០១៨ - ២០១៩ ចូលរៀន ថ្ងៃទី ០៣ កញ្ញា !
កាំ កុងត្រូល អាកាសយានដ្ឋាន អន្ដរជាតិ ភ្នំពេញ ចុះ ពិនិត្យ ទំនិញ នៅ ផ្សារ ជម្ពូរ វ័ន្ដ ខណ្ឌ ពោធិ៍សែនជ័យ រកឃើញ ប្រហិត ត្រី លាយ សារធាតុ គីមី
( ភ្នំពេញ ) ៖ មន្ត្រី សាខា កាំ កុងត្រូល អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ដឹកនាំ ដោយ លោក ហុង លឹម ហ៊ុន ប្រធាន ប៉ុស្តិ៍ បាន សហការ ជាមួយ មន្ត្រី មន្ទីរពិសោធន៍ របស់ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល ( រួម ជាមួយ រថយន្ត ពិសោធន៍ ចល័ត ) និង មន្រី្ត មន្ទីរ ពាណិជ្ជកម្ម គណៈកម្មការ ផ្សារ រជម្ពូរ វ័ន្ត ដើម្បី ចុះ ត្រួតពិនិត្យ គុណភាព សុវត្ថិភាព ផលិតផល ទំនិញ ម្ហូប អាហារ នៅ ផ្សារ ជម្ពូរ វ័ន្ត ។
ប្រតិបត្តិការ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០១៨ នេះ ក្រុមការងារ ក៏ បាន អប់រំ ផ្សព្វផ្សាយ ស្តីពី សុវត្ថិភាព ម្ហូប អាហារ ដល់ អាជីវករ ដោយ មន្ត្រី ជំនាញ បាន យក គំរូ ម្ហូប អាហារ មួយចំនួន ដូចជា ស សៃ គុយ ទាវ មី គ្រឿង សមុទ្រ ប្រហិត គ្រប់ មុខ និង បន្លែ ដើម្បី រក សារធាតុ គីមី ដែល ច្បាប់ ហាមឃាត់ ទៅ ធ្វើ ការពិនិត្យ ។
លោក ប្រធាន ប៉ុស្ដិ៍ បាន ឲ្យដឹង ថា សមត្ថកិច្ច ជំនាញ បាន ដកហូត ដើម្បី យក ទៅ កម្ទេចចោល តាម នីតិវិធី និង កំពុង ស្រាវជ្រាវ បន្ត រក កន្លែង ប្រភព ចែកចាយ ហើយ បាន ណែនាំ ដល់ អាជីវករ អំពី ការរក្សាទុក ទំនិញ ឲ្យបាន ត្រឹមត្រូវ និង យល់ដឹង អំពី ការទទួលខុសត្រូវ ចំពោះ ច្បាប់ លើ ផលិតផល ទំនិញ ម្ហូប អាហារ របស់ ខ្លួន លក់ ៕
នៅឯ រោងចក្រ ផលិត ក្នុង ក្រុមហ៊ុន ផលិត ស្លាប យន្តហោះ គួយ ចូវ អ្នក បច្ចេកទេស កំពុង កែសម្រួល ខ្សែ ដំឡើង ស្លាប យន្តហោះ ដ៏ ឆ្លាតវៃ មួយ ។ នៅពេល កែសម្រួល រួច គេ រំពឹង ថា ខ្សែ ដំឡើង នេះ នឹង ក្លាយជា ខ្សែ ដ៏ ទំនើប បំផុត មួយ ក្នុង ពិភពលោក ។
រចនា ឡើង ដោយ ក្រុមហ៊ុន នេះ និង សាកលវិទ្យាល័យ ល្បី ៗ មួយចំនួន នៅ ប្រទេស ចិន ខ្សែ ដំឡើង នេះ ប្រើ បច្ចេកវិទ្យា ទិន្នន័យ ធំ ជាច្រើន ដើម្បី បង្កើន ប្រសិទ្ធភាព របស់ វា ។ ការស្រាវជ្រាវ និង ការអភិវឌ្ឍ នេះ ចំណាយ ថវិកា អស់ ត្រឹមតែ ១ភាគ៣ នៃ ខ្សែ ដំឡើង ដែល ស្រដៀង គ្នា នេះ ប៉ុណ្ណោះ ។
លោក ហ៊ូ មីង អ្នកគ្រប់គ្រង ផ្នែក ផលិតកម្ម ក្រុមហ៊ុន ផលិត ស្លាប យន្តហោះ គួយ ចូវ បាន ថ្លែង ថា « រោងចក្រ របស់ យើង មាន ភាពបត់បែន និង ឆ្លាតវៃ ។ គ្រប់ ឧបករណ៍ ទាំងអស់ សុទ្ធតែ ប្រើ បច្ចេកវិទ្យា ទិន្នន័យ ធំ ដើម្បី ប្រមូល និង វិភាគ ទិន្នន័យ ។ ហើយ ទិន្នន័យ ដែល វិភាគ រួច នឹង យកមក ប្រើ ដើម្បី អភិវឌ្ឍ បច្ចេកទេស ផលិត របស់ យើង ។ កាលពី មុន ២ភាគរយ នៃ ផលិតផល ដែល យើង ផលិត បាន គឺ ត្រូវ ដក ចេញ វិញ ។ តែ ក្រោយពី យើង ប្រើ ទិន្នន័យ ធំ វា ធ្លាក់ មកសល់ ត្រឹម ០. ០១ ភាគរយ វិញ ហើយ ។ ពិតជា គួរឱ្យ ស្ញប់ស្ញែង មែន » ។
ក្រុមហ៊ុន នេះ គឺជា ឧទាហរណ៍ មួយ ដែល ឆ្លុះបង្ហាញ ឱ្យ ឃើញ ពី បំណង របស់ ខេត្ត គួយ ចូវ ដែល ចង់ អភិវឌ្ឍ វិស័យ ផលិត របស់ ខ្លួន ដោយ ប្រើ បច្ចេកវិទ្យា ទិន្នន័យ ធំ ។
លោក ហ័ង ស៊ី ឈី នាយក រង មន្ទីរ ឧស្សាហកម្ម នៃ គណៈកម្មការ ព័ត៌មាន និង សេដ្ឋកិច្ច ខេត្ត គួយ ចូវ បាន ថ្លែង ថា « គេ គួរតែ ប្រើ ទិន្នន័យ ធំ នៅក្នុង គ្រប់ ដំណើរការ ទាំងអស់ នៃ វិស័យ ឧស្សាហកម្ម តែ ម្តង គឺ ចាប់ពី ផ្នែក ស្រាវជ្រាវ និង អភិវឌ្ឍ រចនា ផលិត រហូតដល់ ផ្នែក សេវាកម្ម ដើម្បី បង្កើត បានជា ប្រព័ន្ធ ឧស្សាហកម្ម ដ៏ ទំនើប មួយ » ។
អ្វី ដែល កាន់តែ ពិសេស គឺ មាន ការសម្ដែង នូវ ទស្សនិយភាព ដ៏ គួរឲ្យ ជក់ចិត្ត ជាមួយនឹង ចង្វាក់ រស់រវើក កាយវិការ ទន់ភ្លន់ នៅលើ ឆាក ធ្វើឲ្យ ទស្សនិកជន ទស្សនា ស្ទើរតែ មិន ចង់ ប្រិច ភ្នែក ។
កម្មវិធី ប្រឡង ឯកទេស ជំនាញ ខាង លើ នេះ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃព្រហស្បតិ៍ ១៣ រោច ខែ ទុតិយសាឍ ឆ្នាំ ច សំរិទ្ធ ស័ក ព .ស ២៥៦២ ត្រូវនឹង ថ្ងៃទី ៩ ខែ សីហា ឆ្នាំ ២០១៨ នៅឯ ភូមិ បឹង បាយ៉ាប សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ដោយ មាន ការអញ្ជើញ ចូលរួម យ៉ាង ច្រើន កុះករ ពីសំណាក់ មហាជន យុវវ័យ មិន ថា ក្មេង ចាស់ ប្រុស ស្រី ចូលរួម ទស្សនា ។
ទន្ទឹមនឹង នេះ លោក វិន ឡៃ ជូ អគ្គ នាយក រង បច្ចេកទេស វប្បធម៌ និង ជា នាយក ស្ដី ទី សាលា មធ្យមសិក្សា វិចិត្រ សិល្បៈ ក៏ បាន បន្ថែម ថា ក្រោយពី សិស្ស បញ្ចប់ ការសិក្សា សញ្ញាប័ត្រ បាក់ ឌុប ដែល មាន ចំណេះ ជំនាញ ឯកទេស រៀង ៗ ខ្លួន អាច យក ទៅ ប្រកបរបរ ចិញ្ចឹម ជីវិត បាន ហើយ កន្លងមក មាន សិស្ស មួយចំនួន ក៏ មាន ឱកាស បាន ចេញ ទៅ ធ្វើការ នៅ ក្រៅ ប្រទេស ទៀតផង ។
( បន្ទាយមានជ័យ ) ៖ នា ព្រឹក ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០១៨ នេះ លោក សាន ស៊ាន ហូ អភិបាល ក្រុង ប៉ោយប៉ែត អម ដំណើរ ដោយ លោក ទូច មុនី អភិបាល រង ខេត្ត បាន ដឹកនាំ មន្ត្រី ជំនាញ មេភូមិបាលិលេយ្យ១ មេភូមិបាលិលេយ្យ២ ប្រជាការភូមិ ចុះ ពិនិត្យ ជាក់ស្តែង ប្រព័ន្ធ លូ បូប លូ បូប ដី និង រៀបចំ សោភ័ណភាព តាម ដងផ្លូវ បេតុង ចាប់ផ្តើម ពី ចំណុច ផ្លូវ ក្រោយ ធនាគារ អេស៊ីលីដា ក្រុង ប៉ោយប៉ែត មុន គេ ។
លោក សាន ស៊ាន ហូ បាន ឲ្យដឹង ថា ចាប់ពី ម៉ោង នេះ ពេលនេះ ថ្ងៃ នេះ ចំណុច ២ភូមិ នេះ ត្រូវ ធ្វើ មុន គេ ក្នុង រយះពេល១ សប្តា ហ៏ ឲ្យបាន ស្អាត មាន អនាម័យ ល្អ សោភ័ណភាព រតាម ដងផ្លូវ សាធារណៈ មិន អនុញ្ញាតិ ឲ្យ មាន ការដាក់ តាំង លក់ ទំនិញ សម្ភារ សំរាម ហៀរ ចូលមក លើ ផ្លូវ បេតុង ជាដាច់ខាត់ ។
ក្នុង ឱកាស ចុះ ពិនិត្យមើល សោភ័ណភាព ក្នុង ទីក្រុង ប៉ោយប៉ែត នេះ ដែរ ប្រជាពលរដ្ឋ បាន ចូលរួម មតិ ជាច្រើន និង ស្រដៀង គ្នា ថា បាន សន្យា ចូលរួមចំណែក ជាមួយ អាជ្ញាធរ ក្រុង ប៉ោយប៉ែត ដើម្បីឲ្យ ក្រុង ប៉ោយប៉ែត មួយ នេះ ស្អាត មាន សោភ័ណភាព ល្អ សណ្តាប់ធ្នាប់ ល្អ ទោះបីជា ពួកគាត់ ត្រូវ រុះរើ កាត់ សំយ៉ាប ជាពិសេស សម្ភារ ការលក់ដូរ ហៀរ ចូលចិញ្ចើមផ្លូវ ក៏ដោយ ៕
គួរ ជម្រាប ជូន ថា បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ ឥណ្ឌូណេស៊ី ចំនួន អ្នកស្លាប់ ដោយសារ គ្រោះ រញ្ជួយ ដី កម្រិត ៦. ៩រ៉ិចទ័រ ដែល បាន វាយប្រហារ លើ កោះ លុម បុក កាលពី ថ្ងៃអាទិត្យ បាន កើន ដល់ ៣៤៧ នាក់ និង ១. ៤៧៧ នាក់ រងរបួស ហើយ ១៦៥. ០០៣ នាក់ ត្រូវបាន ជម្លៀស ខ្លួន ចេញ ពី ទីលំនៅ របស់ ពួកគេ ៕ សហភាព អាហ្វ្រិក ស្នើ កម្ពុជា គាំទ្រ បេក្ខភាព របស់ ខ្លួន ជា អគ្គ លេខាធិការ អង្គការ ប្រទេស និយាយ ភាសា បារាំង
( ភ្នំពេញ ) ៖ ទេសរដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន អនុញ្ញាតឲ្យ លោកស្រី ល្វីស មុស៊ី គីវ៉ា បូ រដ្ឋមន្រ្តី ការបរទេស កិច្ចសហប្រតិបតិ្តការ និង សហគមន៍ អាហ្រ្វិក បូព៌ា នៃ សាធារណរដ្ឋ រ៉ូវ៉ាន់ ដា និង លោក ម៉ាម៉ាឌី ទូរ៉េ រដ្ឋមន្រ្តី ការបរទេស នៃ ប្រទេស ហ្គីណេ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ មួយចំនួន ។
លោក កេត សោ ផាន់ អ្នកនាំពាក្យ ក្រសួង ការបរទេស ដែល ទើប ចូលមក ជំនួស តំណែង លោក ជុំ សុន្ទរី បាន ប្រាប់ ក្រុម អ្នក ព័ត៌មាន នៅ ក្រោយ ជំនួប ថា ក្នុង ជំនួប នោះ លោកស្រី ល្វីស មុស៊ី គីវ៉ា បូ បាន ជម្រាប គោលបំណង របស់ លោកជំទាវ មកកាន់ ប្រទេស កម្ពុជា នា ពេលនេះ ។ បំណង របស់ លោកស្រី គឺ ស្វែងរក ការគាំទ្រ ពី ប្រទេស កម្ពុជា ដែល ជា សមាជិក អង្គការ ប្រទេស និយាយ ភាសា បារាំង បោះឆ្នោត គាំទ្រ លោកជំទាវ ធ្វើជា អគ្គ លេខាធិការ ថ្មី នៃ អង្គការ មួយ នេះ ។
លោកស្រី បាន អះអាង ថា បើសិន លោកស្រី ជាប់ ជា អគ្គ លេខាធិការ នៃ អង្គការ អន្តរជាតិ មួយ នេះ លោកជំទាវ នឹង ជំរុញ កិច្ចសហប្រតិបត្តិការ ឲ្យ កាន់តែ ស៊ីជម្រៅ ជាពិសេស ផ្តោត លើ យុវជន ធ្វើឲ្យ មាន តុល្យភាព រវាង ទិដ្ឋភាព នយោបាយ ក៏ ដូចជា ទិដ្ឋភាព សេដ្ឋកិច្ច ។ លោកស្រី ក៏ សន្យា ជំរុញ តួនាទី អង្គការ អន្តរជាតិ នេះ ឲ្យ មាន តុល្យភាព ផងដែរ លើ ការអនុវត្តន៍ នូវ នយោបាយ និង សេរីភាព របស់ ប្រទេស ជា សមាជិក ។
បើ តាម អ្នកនាំពាក្យ ថ្មី រូប នេះ ជា កិច្ច ឆ្លើយតប លោក ទេសរដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន ថ្លែង អរគុណ ចំពោះ វត្តមាន របស់ លោកស្រី ល្វីស មុស៊ី គីវ៉ា បូ និង លោក ម៉ាម៉ាឌី ទូរ៉េ រដ្ឋមន្រ្តី ការបរទេស នៃ ប្រទេស ហ្គីណេ ដែល បាន មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ។
ចំពោះ សំណើ គាំទ្រ លោកស្រី ល្វីស មុស៊ី គីវ៉ា បូ ជា អគ្គ លេខាធិការ ថ្មី នៃ អង្គការ ប្រទេស និយាយ ភាសា បារាំង នោះ ត្រូវបាន ក្រសួង ការបរទេស ដាក់ សំណើ សម្រេច ទៅ រាជ រដ្ឋាភិបាល កម្ពុជា រួចហើយ ។ ចំណែក លទ្ធផល នឹង ដឹង នៅពេល បោះឆ្នោត ដែល នឹង ធ្វើឡើង នៅ ខែតុលា ឆ្នាំ ២០១៨ នៅ ប្រទេស អាមេនី ។
ក្នុង ជំនួប ព្រឹក មិញ នេះ លោក ទេសរដ្ឋមន្ត្រី ប្រាក់ សុខុន ក៏ បាន ជម្រាប ជូន ភ្ញៀវ និង ចែករំលែក គំនិត មួយចំនួន លើ កិច្ចសហប្រតិបត្តិការ និង ការជំរុញ ឲ្យ អង្គការ ប្រទេស និយាយ ភាសា បារាំង មាន ការរីកចម្រើន និង វិបុលភាព ។
សូម បញ្ជាក់ ថា លោកស្រី ល្វីស មុស៊ី គីវ៉ា បូ រដ្ឋមន្រ្តី ការបរទេស កិច្ចសហប្រតិបតិ្តការ និង សហគមន៍ អាហ្រ្វិក បូព៌ា នៃ សាធារណរដ្ឋ រ៉ូវ៉ាន់ ដា និង លោក ម៉ាម៉ាឌី ទូរ៉េ រដ្ឋមន្រ្តី ការបរទេស នៃ ប្រទេស ហ្គីណេ គឺជា ភ្ញៀវ អន្តរជាតិ ដំបូង គេ ហើយ ដែល បាន អញ្ជើញ មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ក្រោយ ប្រទេស កម្ពុជា បាន រៀបចំ ការបោះឆ្នោត កាលពី ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងទៅ ថ្មី ៗ នេះ ។
លោកស្រី ល្វីស មុស៊ី គីវ៉ា បូ និង ឯកឧត្តម ម៉ាម៉ាឌី ទូរ៉េ កំពុង បំពេញ ទស្សនកិច្ច នៅក្នុង ប្រទេស និយាយ ភាសា បារាំង នៅ ឥណ្ឌូចិន ដូចជា កម្ពុជា ឡាវ និង វៀតណាម ដើម្បី ស្វែងរក ការគាំទ្រ សម្រាប់ បេក្ខភាព ជា អគ្គ លេខាធិការ នៃ ក្រុម ប្រទេស និយាយ ភាសា បារាំង ៕ សមាគម « យុវជន និង ការតបស្នង » នាំយក អំណោយ ចែកជូន ពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់ ចំនួន ២០ គ្រួសារ នៅ ខេត្ត ក្រចេះ
( ក្រចេះ ) ៖ លោក ឧត្ដមសេនីយ៍ ត្រី ថន ប៊ុន ធី ប្រធាន ក្រុមប្រឹក្សាភិបាល សមាគម « យុវជន និង ការតបស្នង » នៅ ព្រឹក ថ្ងៃទី ៩ ខែសីហា ឆ្នាំ ២០១៨ បាន ដឹកនាំ សមាជិក របស់ សមាគម ចុះ ចែក អំណោយ ដល់ ពលរដ្ឋ ជួប គ្រោះមហន្តរាយ ដោយសារ ទឹក ជំនន់ លិច លង់ ខ្លាំង ជាង គេ ចំនួន ២០ គ្រួសារ នៅ ក្រុង ក្រចេះ ក្នុង នោះ ដែរ ក៏ មាន ការចូលរួម ពី លោក ឡាច សុវង្ស ប្រធាន សមាគម យុវជន និង ការតបស្នង . លោក ម៉ែន វណ្ណា អភិបាល រង ក្រុង ក្រចេះ និង ចៅសង្កាត់ ជាច្រើន នាក់ ទៀត ផងដែរ នៅ សាលាក្រុង ក្រចេះ ។
សមាគម ក៏ បាន ជួយ ឧបត្ថម្ភ ដល់ អ្នកជំងឺ ១នាក់ ដែល សម្រាក់ ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ក្រចេះ ចំនួន ៣០ ម៉ឺន រៀល ដែល គាត់ មាន ជំងឺ ដាច់ សសៃ ឈាម អញ្ចាញ ធ្មេញ ហូរ ឈាម រហូត ហើយ មាន ជីវភាព ក្រ លំបាក ខ្លាំង ។
លោក បន្ដ ទៀត ថា អំណោយ ទាំងនេះ បាន មកពី សប្បុរស ធម៍ រួម មាន ព្រះតេជគុណ ធឹង ចិន្រ្តា ព្រះចៅ អជិការវត្ត បច្ឆា ឧបត្ថម្ភ មី ២០ កេស ចាន់ ស្រះ២០ និង ថវិការ ចំនួន ២០ ម៉ឺន រៀល លោក ម៉ុក ជីតូ ប្រធាន នាយកដ្ឋាន គ្រឿងញៀន និង លោកស្រី ឧបត្ថម្ភ ថវិការ ចំនួន ១លាន រៀល និង សមាគម របស់ លោក ផ្ទាល់ សរុប ជា ទឹកប្រាក់ ប្រមាណ ជាង ១.៥០០ ដុល្លារ ។
លោក បាន ឱ្យដឹង ទៀត ថា សមាគម របស់ លោក បង្កើតឡើង ក្នុង គោលបំណង ការងារ មនុស្សធម៍ មិន ប្រកាន់ និន្នាការ នយោបាយ ជួយ ដល់ ពលរដ្ឋ ក្រីក្រ ជួប ការលំបាក ទូរគត់ ជន ពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់ និង គ្រោះថ្នាក់ ផ្សេង ៗ អប់រំ ផ្សព្វផ្សាយ បរិស្ថាន ចរាចរណ៍ ... ។ល៕ តុលាការ ចេញ ដីកា សម្រេច ឃុំ ខ្លួន ក្រុម ចោរ ឆក់ ៣នាក់ ដែល តែង ធ្វើ សកម្មភាព យ៉ាង ខ្លាំង ក្នុង រាជធានី ភ្នំពេញ ដាក់ ពន្ធនាគារ
( ភ្នំពេញ ) ៖ ជន ត្រូវ ចោទ ពាក់ព័ន្ធ បទល្មើស ឆក់ ( លួច មាន ស្ថាន ទម្ងន់ ទោស ) ចំនួន ០៣ នាក់ ត្រូវបាន លោក អ៊ឹម វណ្ណៈ ចៅក្រម ស៊ើបសួរ សាលាដំបូង រាជធានី ភ្នំពេញ បាន សម្រេច ចេញ ដីកា ឃុំ ខ្លួន ដាក់ ពន្ធនាគារ និង ម្នាក់ ទៀត ជាប់ចោទ ពី បទ រក្សារ ទុក នូវ គ្រឿងញៀន ដោយ ខុស ច្បាប់ ក៏ ត្រូវបាន សម្រេច ឃុំ ខ្លួន ដូចគ្នា ដែរ ដោយ ចៅក្រម ស៊ើប លោក ឌុច សុខ សារិន ។
ការសម្រេច ឃុំ ខ្លួន នេះ គឺ ធ្វើឡើង នៅ ល្ងាច ថ្ងៃទី ០៨ ខែសីហា ឆ្នាំ ២០១៨ ក្រោយ ជនសង្ស័យ ទាំង ០៤ នាក់ នេះ ត្រូវបាន ចាប់ខ្លួន ដោយ កម្លាំង នគ បាល ព្រហ្មទណ្ឌ កំរិត ស្រាល នៃ ស្នងការ នគ បាល រាជធានី ភ្នំពេញ និង បន្ទាប់ពី តំណាង អយ្យការ បាន បញ្ចប់ ការសន្និដ្ឋាន បទ ចោទ រួច ។
បើ តាម របាយការណ៍ សម្ថកិច្ច បញ្ជាក់ ថា ក្នុង ចំណោម ជនសង្ស័យ មាន ម្នាក់ ប្រើប្រាស់ គ្រឿងញៀន និង ៣នាក់ ផ្សេង ទៀត ដែល ជំនាញ ឆក់ ទ្រព្យសម្បត្តិ ផ្សេង ៗ ពី ជន បរទេស និង ប្រជាពលរដ្ឋ ខ្មែរ តាម ដងផ្លូវ យ៉ាង សកម្ម ។
លោក វរសេនីយ៍ ឯក ប៊ុន សត្យា នាយ ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល ដែល បាន ដឹកនាំ ប្រតិបត្តិការ បង្ក្រាប នេះ បាន ឲ្យដឹង ថា ប្រតិបត្តិការ នេះ ស្ថិត ក្រោម ការបញ្ជា ដោយ ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ក្រោម ការសម្របសម្រួល ពី លោក សៀង សុខ ព្រះរាជអាជ្ញា រង អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
កម្លាំង ការិយាល័យ ជំនាញ បាន បើក ការស៊ើបអង្កេត ភ្លាម ៗ រយៈពេល ពេញ មួយ សប្ដាហ៍ ឯណោះ ទើប ឈានដល់ ការបង្ក្រាប ឃាត់ខ្លួន ក្រុម ជនសង្ស័យ បាន ក្រោយពី ធ្វើ សកម្មភាព ឆក់ យ៉ាង សកម្ម នា ពេល កន្លងមក ចំនួន ៨លើក មក ហើយ នៅឯ ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល និង នៅ សង្កាត់ ចាក់អង្រែលើ ខណ្ឌ មានជ័យ . សង្កាត់ ផ្សារ ដើថ្កូវ ខណ្ឌ ចំការមន . សង្កាត់ ផ្សារ ដេប៉ូ១ សង្កាត់ ទឹកល្អ ក២ និង សង្កាត់ បឹងសាឡាង ខណ្ឌ ទួលគោក . សង្កាត់ ជ័យ ជំនះ ខណ្ឌ ដូនពេញ ក្នុង រាជធានី ភ្នំពេញ ។
