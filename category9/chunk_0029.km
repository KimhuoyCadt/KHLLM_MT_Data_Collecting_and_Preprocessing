( ភ្នំពេញ ) ៖ កម្លាំង កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន បញ្ជូន ជនសង្ស័យ ម្នាក់ ឈ្មោះ អ៊ុន សំណាង អាយុ ៣៩ ឆ្នាំ ពាក់ព័ន្ធ ករណី រំលោភ សេពសន្ថវៈ លើ ក្មួយ ស្រី បង្កើត ខ្លួន ឯង ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ។
បើ តាម មន្ត្រី អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ប្រាប់ ភ្នាក់ងារ Fresh News ប្រចាំ តុលាការ ឲ្យដឹង ថា ជនសង្ស័យ ឈ្មោះ អ៊ុន សំណាង អាយុ ៣៩ ឆ្នាំ មុខរបរ កម្មករ រោងចក្រ ទីកន្លែង កំណើត ឃុំ ទឹក ហូត ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង មាន ទីលំនៅ បច្ចុប្បន្ន ស្នាក់ នៅ បន្ទប់ ជួល លេខ 161 ភូមិ អង្គ សង្កាត់ ចោម ចៅ ខណ្ឌ ពោធិ៍សែនជ័យ បាន រំលោភ ក្មួយ ស្រី រហូត ដល់ ០៣ ដង ទើប បាន សម្រេច ។
បើ តាម របាយការណ៍ អាវុធហត្ថ ដដែល បាន បញ្ជាក់ ទៀត ថា លើក ទី១៖ គឺ នៅ ពេល យប់ មិន ចាំ ថ្ងៃ ខែ ពេល ដែល ក្មួយ ស្រី កំពុង ដេកលក់ ខ្លួន បាន ធ្វើ សកម្មភាព យក កន្ត្រៃ លួច កាត់ គូទ ខោ ក្មួយ ស្រី ដើម្បី លូក ដៃ ទៅ ស្ទាប់ អង្អែល ប្រដាប់ ភេទ ដោយ ប៉ុនប៉ង រំលោភ តែ ដោយសារ មាន ប្រពន្ធ ដេក ក្បែរ ទើប ខ្លួន លេង ប្រដាប់ ភេទ ខ្លួន ឯង រហូត បាន សម្រេច ដាក់ ក្នុង ខោ ក្មួយ ស្រី ។
លើក ទី ២៖ ខ្លួន បាន ប៉ុនប៉ង ចាប់រំលោភ នៅពេល បាយ ថ្ងៃត្រង់ ដោយ ខ្លួន បាន សុំ នាង រួមភេទ តែ នាង មិន ព្រម ខ្លួន ក៏ បាន ចាប់ ផ្តួល នាង ទៅ លើ ឥដ្ឋ ការ៉ូ និង បាន អុក មួយ ជង្គង់ ចំដើមទ្រូង ធ្វើឲ្យ ចុក ឆ្អល់ រួច ខ្លួន បាន ចាប់រំលោភ តែ ក្មួយ ស្រី បាន សុំ អង្វរ ខ្លួន ក៏ បាន ដើរ ចេញ ទៅ ធ្វើការ បាត់ ទៅ ។
( សៀមរាប ) ៖ ជនជាតិ ចិន ៣នាក់ បាន ប្រើប្រាស់ អាវុធ មួយ ដើម ធ្វើ សកម្មភាព ចូល ប្លន់ ផ្ទះ លក់ មាស ប្ដូរ ប្រាក់ នៅ ស្រុក ពួក ខេត្ត សៀមរាប នៅ វេលា ម៉ោង ០៧៖ ២០ នាទី យប់ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០១៨ តែ មិន បាន សម្រេច ហើយ កម្លាំង នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត សៀមរាប តាម បង្ក្រាប បាន ភ្លាម ៗ ។
មន្ដ្រី នគរបាល ដដែល បញ្ជាក់ ថា មុនពេល កើត ហេតុ ជនរងគ្រោះ បាន ជិះ ឡាន មកពី ប្រកប មុខរបរ លក់ មាស ប្ដូរ ប្រាក់ នៅ ក្រុង សៀមរាប លុះ មកដល់ មុខ ផ្ទះ គាត់ ជនរងគ្រោះ ឈ្មោះ តៅ សុភា បាន ចុះ ពីលើ ឡាន ដើម្បី ទៅ បើក ទ្វារ ចូល ផ្ទះ ស្រាប់តែ មាន ក្រុម ជនសង្ស័យ មាន គ្នា ០៣ នាក់ បាន មក វាយ គាត់ ពីក្រោយ ដោយ វត្ថុ រឹង និង វាយ កញ្ចក់ ឡាន បំណង យក ទ្រព្យសម្បត្តិ មាន តំលៃ តែ ជនរងគ្រោះ បាន ស្រែក ផ្អើល អ្នកជិតខាង ជនសង្ស័យ ក៏ បាន រត់គេចខ្លួន ឆ្លង ស្ទឹង បាត់ ។
ជំនន់ ទឹក ស្ទឹង សង្កែ ខេត្ត បាត់ដំបង កំពុង គំរាមកំហែង ប្រជាពលរដ្ឋ . ថ្ងៃ នេះ រដ្ឋមន្ដ្រី លឹម គាន ហោ ដឹកនាំ មន្ដ្រី ចុះ ទប់ស្កាត់ កុំ ឲ្យ លិច លង់ ក្រុង បាត់ដំបង
( បាត់ដំបង ) ៖ ជំនន់ ទឹក ស្ទឹង សង្កែ ខេត្ត បាត់ដំបង បាន និង កំពុង គំរាមកំហែង ដល់ ប្រជាពលរដ្ឋ ប៉ុន្ដែ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ លោក លឹម គាន ហោ រដ្ឋមន្ដ្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដឹកនាំ មន្ដ្រី ជំនាញ ចុះ ទប់ស្កាត់ ដើម្បី កុំ ឲ្យ លិច លង់ នៅ ក្រុង បាត់ដំបង ។ នេះ បើ តាម ការឲ្យដឹង ពី លោក ចាន់ យុត្ថា នាយក ខុទ្ទកាល័យ និង ជា អ្នកនាំពាក្យ ក្រសួង ធនធាន ទឹក ។
បើ តាម លោក ចាន់ យុត្ថា ទឹក ស្ទឹង សង្កែ នៅ ក្រុង បាត់ដំបង នា ព្រឹក ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ មាន កម្ពស់ ១១. ៤៨ម៉ែត្រ ខណៈ កម្រិត ប្រកាស ឲ្យ ប្រុងប្រយ័ត្ន ១៣. ៧៥ម៉ែត្រ ។ យ៉ាងណា ក៏ដោយ លោក រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម កំពុង ដឹកនាំ ក្រុមការងារ ទប់ស្កាត់ នឹង ជំនន់ នេះ ដើម្បី ការពារ ក្រុង បាត់ដំបង កុំ ឲ្យ មាន ការលិចលង់ ៕ ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ឱកាស អញ្ជើញ ចុះ ជួប សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី ជាង ១ម៉ឺន នាក់ នៅ ខណ្ឌ សែនសុខ
( ភ្នំពេញ ) ៖ ផ្ទុយ ពី ការទស្សន៍ទាយ និង ការលើកឡើង របស់ ក្រុម អ្នក ប្រឆាំង ថា ក្រោយ បោះឆ្នោត សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ឈប់ ចុះ ជួប កម្មករ កម្ម ការិនី នោះ នៅ ព្រឹក ថ្ងៃពុធ ៤កើត ខែ ស្រា ពណ៍ ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស ២៥៦២ ត្រូវនឹង ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ សម្តេច តេជោ ហ៊ុន សែន បន្ត អញ្ជើញ ចុះ ជួប សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី ទៀត ហើយ ។ កិច្ច សំណេះសំណាល នេះ ធ្វើឡើង នៅ ភូមិ អន្លង់ ក្ងាន សង្កាត់ ឃ្មួញ ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
* សម្តេច តេជោ ហ៊ុន សែន ចាប់ផ្តើម ថ្លែង សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី ជាង ១ម៉ឺន នាក់ នៅ ខណ្ឌ សែនសុខ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ទោះបី លទ្ធផល ផ្លូវការ មិន ទាន់ ប្រកាស តែ គេ អាច ដឹង បាន ហើយ ថា គណបក្ស ប្រជាជន កម្ពុជា ឈានមុខ ក្នុង ការគ្រប់គ្រង អាសនៈ នៅក្នុង រដ្ឋសភា ហើយ ឈាន ទៅ ដឹកនាំ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច មិន ទម្លាប់ ប្រែប្រួល និង ក្បត់ ពាក្យសន្យា នោះ ទេ ដូច្នេះ សម្តេច នៅតែ បន្ត ចុះ ជួប សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី ដូច ការសន្យា នៅពេល មុន បោះឆ្នោត ។
* មិន ខុសពី ជំនួប លើក មុន ៗ ដែរ សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល បាន ថ្លែង ថា សម្តេច មាន ក្តីសប្បាយរីករាយ ខ្លាំង ណាស់ ដែល បាន ចុះ មក ជួប សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី នា ព្រឹក ថ្ងៃ នេះ ។
* ជំនួប នា ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ដល់ កម្មករ កម្ម ការិនី ក៏ ដូចជា ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ដែល បាន ចេញ ទៅ បោះឆ្នោត មាន ចំនួន រហូតដល់ទៅ ជាង ៨៣ ភាគរយ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក ការចេញ ទៅ បោះឆ្នោត របស់ ប្រជាពលរដ្ឋ គឺជា ជោគជ័យ ដ៏ ធំធេង នៃ ដំណើរ ការលទ្ធិ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បន្ត ថា តាមរយៈ តួលេខ នៃ ការចេញ ទៅ បោះឆ្នោត ដ៏ ច្រើន សន្ធឹកសន្ធាប់ រហូតដល់ ៨៣. ០២ ភាគរយ គឺជា ការបរាជ័យ ដ៏ ធំធេង នៃ យុទ្ធនាការ « ដេក ផ្ទះ ឈ្នះ ស្អាត » របស់ អតីត បក្ស ប្រឆាំង
* សម្តេច តេជោ ហ៊ុន សែន សម្តែង ការហួសចិត្ត យ៉ាង ខ្លាំង ដែល ទណ្ឌិត សម រង្ស៊ី ចោទ ថា សម្តេច តេជោ ជួល ឃាតក តាម សម្លាប់ រូបលោក នៅ ប្រទេស បារាំង នោះ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី ថា ប្រសិនបើ សម្តេច ចង់ សម្លាប់ ទណ្ឌិត សម រង្ស៊ី មែន នោះ គឺ សម្លាប់ តាំងពី នៅ ស្រុក ខ្មែរ ម្ល៉េះ គឺ គប់ តែ នឹង ផ្លែ ត្របែក ក៏ ស្លាប់ ដែរ ។ សម្តេច តេជោ បាន បញ្ជាក់ ថា សម្តេច មិន ដែល មាន បំណង សម្លាប់ ខ្មែរ ណា ម្នាក់ នោះ ទេ សូម្បីតែ មេដឹកនាំ ខ្មែរ ក្រហម ក៏ មិន ដែល មាន បំណង សម្លាប់ នោះ ដែរ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បាន លើកឡើង ទៀត ថា លទ្ធផល បោះឆ្នោត នៅ ឆ្នាំ ២០១៨ គឺជា ការបង្ហាញ ឲ្យ ឃើញ ភាព ចាស់ទុំ របស់ ប្រជាពលរដ្ឋ កម្ពុជា ជាពិសេស ការបោះឆ្នោត ឆ្នាំ នេះ មិន បាន ធ្វើឲ្យ ពលរដ្ឋ ព្រួយបារម្ភ ដូច ការបោះឆ្នោត ឆ្នាំ ២០១៣ នោះ ទេ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ថា ទម្រាំ កម្ពុជា មាន ការអភិវឌ្ឍ ដូច ពេល បច្ចុប្បន្ន នេះ មិន មែន ជា រឿង ធម្មតា នោះ ទេ គឺ មាន ការប្រឹងប្រែង ខ្លាំង ណាស់ ពី ថ្នាក់ដឹកនាំ របស់ រាជ រដ្ឋាភិបាល និង ប្រជាពលរដ្ឋ ខ្មែរ ទាំងមូល ។
* សម្តេច តេជោ ហ៊ុន សែន ផ្តាំផ្ញើ ទៅ លោក គង់ វិបុល អគ្គ នាយក ពន្ធដារ ឲ្យ មាន ការពិចារណា យក តម្លៃ ពន្ធ ប្រថាប់ លើ ការលក់ ដី ផ្ទះ ដោយ មិន ត្រូវ អនុវត្តន៍ តាម តម្លៃ ដី ផ្ទះ ដូច ពេល មុន នោះ ទេ ។ ពោល សម្តេច ចង់ឲ្យ មាន ការតម្លើង តម្លៃ ពន្ធ ប្រថាប់ ត្រា ទៅ លើ ដី ផ្ទះ ដែល មាន ការកើន តម្លៃ នា ពេល បច្ចុប្បន្ន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ភាពជោគជ័យ នៃ ការបោះឆ្នោត មិន មែន ជា ជោគជ័យ របស់ សម្តេច និង មេដឹកនាំ គណបក្ស ប្រជាជន នោះ ទេ តែ ក៏ ជា ជោគជ័យ របស់ ប្រជាពលរដ្ឋ ខ្មែរ និង កម្មករ កម្ម ការិនី ផងដែរ ។
* ត្រង់ ចំណុច នេះ សម្តេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ថា ជោគជ័យ របស់ គណបក្ស ប្រជាជន កម្ពុជា គឺ ការរក្សា បាន នូវ សុខ សន្តិភាព ដែល សុខ សន្តិភាព គឺជា កត្តា ដ៏ ចាំបាច់ ក្នុង ការ រក្សា ការងារ ជូន កម្មករ កម្ម ការិនី និង ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ទៀត ថា ការរីកចម្រើន និង ការវិនិយោគ មិន អាច ចាប់ ផ្ទៃ នៅក្នុង ប្រទេស មាន សង្គ្រាម នោះ ទេ ដូចជា បណ្តា ប្រទេស នៅ មជ្ឈឹម បូព៌ា ។
* សម្តេច ប្រមុខ រាជ រដ្ឋាភិបាល បាន បន្ថែម ថា ការចេញ ទៅ បោះឆ្នោត របស់ ប្រជាពលរដ្ឋ ជា ការរក្សា នូវ របប ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស និង ជា ការចេញ ទៅ ការពារ នូវ សុខ សន្តិភាព ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា តម្លៃ សុខ សន្តិភាព ដែល ប្រជាពលរដ្ឋ ជ្រើសរើស តាមរយៈ ការបោះឆ្នោត នៅ ឆ្នាំ ២០១៨ នេះ គឺជា ការជ្រើសរើស ដ៏ ត្រឹមត្រូវ ។
* សម្តេច តេជោ ហ៊ុន សែន បន្ត អំពាវនាវ ដល់ កម្មករ កម្ម ការិនី និង ប្រជាពលរដ្ឋ រួមគ្នា ថែរក្សា នូវ សុខ សន្តិភាព មិន ត្រូវ ឲ្យ ជន ណា ម្នាក់ មក បំផ្លាញ សុខ សន្តិភាព នេះ ឡើយ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី ថ្លែង ថា អវត្តមាន សន្តិភាព អវត្តមាន សន្តិសុខ សណ្តាប់ធ្នាប់ គឺជា ការបាត់បង់ ការអភិវឌ្ឍ ការវិនិយោគ និង បាត់បង់ ប្រាក់ ចំណូល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហើប ថា ករណី កម្មករ កម្ម ការិនី ផ្ទុះ កូដកម្ម នៅក្នុង ខេត្ត ស្វាយរៀង រឿង ថៅកែ កាត់ប្រាក់ ឈ្នួល ព្រោះ ទៅ បោះឆ្នោត គឺជា ការបំផុស ព័ត៌មាន ពី អ្នក ញុះញង់ តែ ធាតុ ពិត ថៅកែ មិន បាន កាត់ នោះ ទេ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ស្នើឲ្យ លោក សេង ទៀង តាមដាន ឲ្យបាន ម៉ត់ចត់ លើ ករណី អ្នក មាន កូន ភ្លោះ បី ហើយ ត្រូវ ដោះស្រាយ បញ្ហា ខ្វះខាត គាត់ ឲ្យបាន ទាន់ ពេល វេលា ។ ការក្រើន រំលឹក របស់ សម្តេច បាន ធ្វើឡើង ក្រោយ សម្តេច បាន ឃើញ ពី ការត្អូញត្អែ ខ្វះ លទ្ធភាព ចិញ្ចឹម កូន របស់ អ្នក កូន ភ្លោះ បី មួយ គ្រួសារ ។ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា សម្តេច បាន ឧបត្ថម្ភ ថវិកា ៥លាន រៀល ដល់ គ្រួសារ ដែល ខ្វះខាត នោះ ហើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជា ឲ្យ លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល តាមដាន ឲ្យបាន ម៉ត់ចត់ លើ កម្មវិធី ព្យាបាល ឥត គិត ថ្លៃ ជូន កម្មករ កម្ម ការិនី ។
* សម្តេច តេជោ បាន បញ្ជាក់ ថា នៅក្នុង អាណត្តិ ថ្មី សម្តេច នឹង ធ្វើ សកម្មភាព កាន់តែ សកម្ម ហើយ ទម្លាក់ ថវិកា កាន់តែ ច្រើន ទៅក្នុង វិស័យ សុខាភិបាល និង វិស័យ អប់រំ ដើម្បី លើកកម្ពស់ សុខុមាលភាព និង ចំណេះដឹង របស់ ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា មកដល់ ពេលនេះ រាជ រដ្ឋាភិបាល បាន បញ្ចេញ ថវិកា ២២លាន ដុល្លារ អាមេរិក ក្នុង ការជួយសង្គ្រោះ កម្មករ .
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អ្នក លួច ហ្វេសប៊ុក សម្តេច ជា ទង្វើ អាក្រក់ ជូរ ជាតិ ។ សម្តេច តេជោ រំពឹង ថា ក្រុម អ្នក ប្រឆាំង ឧក្រិដ្ឋកម្ម បច្ចេកវិទ្យា នឹង ស្វែងរក មុខ ក្រុម អ្នក លួច នោះ មក ផ្តន្ទាទោស ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ហៅ អ្នក លួច ហ្វេសប៊ុក របស់ សម្តេច ហើយ បង្ហោះ ព័ត៌មាន ពី ការបែងចែក អាសនៈ ទៅឲ្យ បក្ស សម្ព័ន្ធ ដើម្បី ប្រជាធិបតេយ្យ និង គណបក្ស ហ៊្វុនស៊ិនប៉ិច គឺជា អ្នក មាន ចេតនា បំផ្លាញ ការប្រកាស លទ្ធផល បោះឆ្នោត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា អ្នក លួច ហ្វេសប៊ុក របស់ សម្តេច គឺជា ទណ្ឌិត សម រង្ស៊ី ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច ទុក លទ្ធភាព ឲ្យ ប្រធានាធិបតី បារាំង ពិនិត្យ លើ សំណុំរឿង ដែល ទណ្ឌិត សម រង្ស៊ី ចោទ សម្តេច ជួល មនុស្ស ទៅ សម្លាប់ លោក ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន លើកឡើង ផងដែរ ពី ការសម្លាប់ បណ្ឌិត កែម ឡី ។ សម្តេច បាន លើកឡើង ថា អ្នកសម្លាប់ កែម ឡី គឺជា អ្នក ដែល ទទួលបាន ប្រយោជន៍ ច្រើន ជាង គេ ពី ការសម្លាប់ នេះ ។ សម្តេច បន្ថែម ថា រាជ រដ្ឋាភិបាល គ្មាន ផលចំណេញ អ្វី ពី ការសម្លាប់ នេះ ឡើយ ។
* សម្តេច តេជោ បាន ថ្លែង ថា បាន ដឹង ពី តម្រុយ អ្នក លួច ហ្វេសប៊ុក សម្តេច ហើយ តែ សម្តេច ទុកឲ្យ នគរបាល ជា អ្នកធ្វើការ ។ សម្តេច តេជោ ក៏ បាន ថ្លែងអំណរគុណ ដល់ ក្រុមហ៊ុន ហ្វេសប៊ុក ដែល បាន សហការ ទាន់ ពេល វេលា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច ចង់ បង្កើត វេទិកា ពិគ្រោះយោបល់ រវាង រាជ រដ្ឋាភិបាល និង គណបក្ស ដែល បាន ចូលរួម បោះឆ្នោត ។
* សម្តេច តេជោ បាន ថ្លែង ថា ការបង្កើត វេទិកា នេះ ដើម្បី ផ្តល់ ឱកាស ដល់ គណបក្ស នយោបាយ ចូលរួម អភិវឌ្ឍន៍ ប្រទេសជាតិ ជាពិសេស ជា ការបង្កើត វប្បធម៌ សន្ទនា រវាង បក្ស នយោបាយ នៅក្នុង រដ្ឋសភា និង បក្ស នយោបាយ នៅ ក្រៅ រដ្ឋសភា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ទៀត ថា ជំនួប នោះ សម្តេច មិន មែន ជួប ក្នុង ឋានៈ ជា ប្រធានបក្ស ទេ តែ សម្តេច នឹង ជួប ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី ។ សម្តេច បញ្ជាក់ ថា សម្តេច នឹង ធ្វើ លិខិត អញ្ជើញ បណ្តា មេដឹកនាំ គណបក្ស នយោបាយ ទាំងនោះ មក ជួប ជជែកគ្នា លើ កិច្ចការ ជាតិ នៅ វិមាន រាជ រដ្ឋាភិបាល ។ បើ តាម សម្តេច តេជោ ហ៊ុន សែន តាម រយ : វេទិកា នេះ ក៏ ផ្តល់ ឱកាស ឲ្យ បក្ស នយោបាយ ក្រៅ សភា តាមដាន កម្មវិធី នយោបាយ របស់ រាជ រដ្ឋាភិបាល ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ថា នឹង អញ្ជើញ ប្រធាន គណបក្ស នយោបាយ មក ធ្វើជា ទីប្រឹក្សា ឬ រដ្ឋលេខាធិការ នៅ តាម បណ្តា ក្រសួង នានា ដើម្បី ចូលរួមចំណែក អភិវឌ្ឍន៍ ជាតិ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច ចង់ ជួប ជាមួយ មេ គណបក្ស ដទៃ ដែល ចូលរួម បោះឆ្នោត នៅ មុនពេល បង្កើត រាជ រដ្ឋាភិបាល ថ្មី ។
* សម្តេច តេជោ ហ៊ុន សែន ចង់ អញ្ជើញ តំណាង គណបក្ស នយោបាយ ទាំង ២០ មក ផ្តល់ យោបល់ អំពី គោល នយោបាយ ដល់ នាយក រដ្ឋមន្រ្តី អាណត្តិ ថ្មី ដើម្បី កសាង ប្រទេស
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គណបក្ស ហ៊្វុនស៊ិនប៉ិច និង គណបក្ស ខ្មែរ រួបរួម ជាតិ កំពុង ប្រើ លុយ រត់ ការ ដើម្បី បាន តំណែង ក្នុង ជួរ រាជ រដ្ឋាភិបាល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ចប់ ការថ្លែង សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី នៅ វេលា ម៉ោង ៩៖ ៣៥ នាទី . សូម អរគុណ ចំពោះ ការទស្សនា ផ្សាយ ផ្ទាល់ ៕
សេចក្តីជូនដំណឹង របស់ គជប បាន ឲ្យដឹង ថា លទ្ធផល ផ្លូវការ ដែល ប្រកាស នៅ យប់ ថ្ងៃ នេះ នឹង បង្ហាញ ទាំងអស់ នូវ សំឡេង សន្លឹក ឆ្នោត ឈ្មោះ បេក្ខជន ជាប់ ឆ្នោត រួមទាំង ចំនួន អាសនៈ រដ្ឋសភា ដែល គណបក្ស នយោបាយ ទទួលបាន ។
( ភ្នំពេញ ) ៖ លោក យ៉ុង សាំង កុមារ បេក្ខជន នាយក រដ្ឋមន្ត្រី របស់ គណបក្ស ប្រជាធិបតេយ្យ មូលដ្ឋាន (GDP) នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន បង្ហាញ ការគាំទ្រ ចំពោះ ការលើកឡើង របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល ចង់ឱ្យ មាន ជំនួប ពិភាក្សា រវាង គណបក្ស នយោបាយ ទាំងអស់ ដើម្បី ដោះស្រាយ បញ្ហា ជាតិ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន ប្រកាស បង្កើត វេទិកា សំណេះសំណាល មួយ រវាង រាជ រដ្ឋាភិបាល និង គណបក្ស នយោបាយ ទាំង ២០ ដែល បាន ចូលរួម បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី ០៦ ដើម្បី បាន ទទួល ស្តាប់ នូវ គំនិត យោបល់ នានា ពី មេដឹកនាំ គណបក្ស នយោបាយ ទាំងអស់ នោះ យក ធ្វើជា ធាតុ ចូលក្នុង ដឹកនាំ និង អភិវឌ្ឍន៍ ជាតិ កម្ពុជា ឱ្យ កាន់តែ រីកចម្រើន ថែម ទៀត ។
បើ តាម សម្តេច តេជោ ហ៊ុន សែន ការប្រកាស បង្កើត វេទិកា នេះ ឡើង ដើម្បី ផ្តល់ ឱកាស ឱ្យ គណបក្ស នយោបាយ ដែល បាន ចូលរួម ប្រកួតប្រជែង ការបោះឆ្នោត ហើយ មិន ទទួលបាន អាសនៈ នោះ បាន ចូលរួម កែលំអរ គោល នយោបាយ និង ផ្តល់ ជា គំនិត យោបល់ ល្អ ៗ សម្រាប់ ចង្អុលបង្ហាញ ដល់ រាជ រដ្ឋាភិបាល ក្នុង ការដឹកនាំ និង អភិវឌ្ឍន៍ ជាតិ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន លើកឡើង ដែរ ថា គណបក្ស នយោបាយ ទាំងអស់ នោះ អាច លើក បង្ហាញ ពី ការអនុវត្តន៍ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ផងដែរ ដើម្បី កុំ ឱ្យ រាជ រដ្ឋាភិបាល ជិះ សេះ លែង ដៃ ៕
អភិបាល ខេត្ត កំពង់ធំ ព្រមាន មន្ត្រី ខិល ខូច ដែល ពាក់ព័ន្ធ បទល្មើស នេសាទ ត្រូវ ដក ខ្លួន ចេញ ជាបន្ទាន់ បើ ពុំ នោះ ទេ ច្បាស់ជា ប្រឈមមុខ នឹង ច្បាប់ មិន ខាន
( កំពង់ធំ )៖ ក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ នៅ ឃុំ ផាត់ សណ្តាយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ជិត១ ពាន់ នាក់ នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០១៨ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ បាន ព្រមាន មន្ត្រី ខិល ខូច ទាំងឡាយ ដែល ពាក់ព័ន្ធ នឹង ការប្រព្រឹត្ត បទល្មើស នេសាទ ត្រូវ ដក ខ្លួន ចេញ ជាបន្ទាន់ បើ ពុំ នោះ ទេ ច្បាស់ជា ប្រឈមមុខ នឹង ច្បាប់ ។
លោក បន្ត ថា ការធ្វើ បែប នេះ ដើម្បី រក្សា នូវ ពូជ ត្រី ធនធាន ធម្មជាតិ ជីវ ចម្រុះ ឡើងវិញ ក្នុង ការជួយ ទ្រទ្រង់ ជីវភាព រស់ នៅ ដល់ ប្រជាជន កម្ពុជា ជាពិសេស ទុក សម្រាប់ ប្រកប មុខរបរទេ សាទ ជា លក្ខណៈ គ្រួសារ ។
លោក សុខ លូ បាន ថ្លែង ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ប្រកាស លុបចោល ឡូតិ៍ នេសាទ ទូទាំង ប្រទេស ដើម្បី ប្រជាពលរដ្ឋ ទទួលបាន ផលប្រយោជន៍ នេសាទ ជា លក្ខណៈ គ្រួសារ ជាពិសេស ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ ផាត់ សណ្តាយ ស្រុក កំពង់ស្វាយ ដែល ពឹងផ្អែក លើ ការនេសាទ ត្រី ជាមុខរបរ សំខាន់ ទី មួយ តែម្តង ។
លោក បាន បញ្ជាក់ ថា « សូម បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ មេត្តា គោរព ច្បាប់ នេសាទ ទាំងអស់ គ្នា ដើម្បី ថែរក្សា ពូជ ត្រី និង ទិន្នផល ត្រី ឲ្យ មាន ការកើនឡើង ជាង មុន សម្រាប់ អនាគត យូអង្វែង តទៅទៀត ។ ចំពោះ មន្ត្រី ខិល ខូច ណា ដែល មាន ការពាក់ព័ន្ធ នឹង ការប្រព្រឹត្ត បទល្មើស នេសាទ សូម ធ្វើ ការដក ខ្លួន ចេញ ជាបន្ទាន់ បើ ពុំ ដូច្នោះ ទេ នឹង ប្រឈមមុខ ចំពោះ ច្បាប់ ខ្ញុំ នឹង អនុវត្តន៍ នូវ អភិក្រមទាំង ៥ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា គឺ ងូតទឹក ដុស ក្អែល ឆ្លុះ កញ្ចក់ ព្យាបាល និង វះកាត់ » ។
លោក បន្ថែម ទៀត ថា « សូម បងប្អូន ត្រូវ ចាត់ទុក ថា បឹង ទន្លេ សាប នេះ មិន មែន ជា កម្មសិទ្ធ របស់ អ្នកណា ម្នាក់ ទេ គឺជា របស់ យើង ទាំងអស់ គ្នា ព្រោះ បឹង ទន្លេ សាប មាន វិសាលភាព ដ៏ ធំធេង សម្រស់ ស្រស់ស្អាត ដែល ជា អាង ស្តុក ទឹក ធម្មជាតិ និង ជា ជំរក មច្ឆា ជាតិ ដ៏ សំខាន់ សំរាប់ ប្រជាជន កម្ពុជា និង សូម អំពាវនាវ ដល់ កងកម្លំាង សមត្ថកិច្ច ក ម្លំាង ជំនាញ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ខិតខំ ធ្វើ ការបង្ក្រាប នូវ បទល្មើស នេសាទ ប្រកបដោយ តម្លាភាព » ។
បន្ទាប់ពី សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ រួច មក លោក សុខ លូ និង ក្រុមការងារ បាន បន្ត ដំណើរ ទៅ ពិនិត្យ ស្ថានភាព សាលា បឋមសិក្សា នៅ ភូមិ ទួល នាង សាវ អំពី ការការបង្រៀន និង រៀន របស់ សិស្ស នៅ ទីនោះ ផងដែរ ។ ម្យ៉ាង វិញ ទៀត នៅក្នុង ភូមិ នេះ ក៏ មាន ការសាងសង់ អនុវិទ្យាល័យ ទួល នាង សាវ មួយ ខ្នង ទៀត ដើម្បី សម្រួល ដល់ កុមារ ឲ្យបាន សិក្សា រៀនសូត្រ ចប់ ថ្នាក់ មូលដ្ឋាន ។
លោក សុខ លូ និង លោក ឃឹម នុភាព បេក្ខជន តំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ បាន សម្រេច សាងសង់ ផ្ទះ មួយ ខ្នង ជូន លោក ជុំ លឿម និង ឧបត្ថម្ភ នូវ គ្រឿង ឧបភោគ បរិភោគ ដើម្បី ជួយ សម្រួល ដល់ ជីវភាព រស់ នៅ របស់ ពួក បាន មួយ កម្រិត ផងដែរ ៕
កម្ពុជា - ឥណ្ឌូនេស៊ី ផ្លាស់ប្តូរ បទពិសោធន៍ គ្នា លើ ការគ្រប់គ្រង ចរាចរណ៍
( ភ្នំពេញ ) ៖ នគរបាល ចរាចរណ៍ កម្ពុជា និង នគរបាល ចរាចរណ៍ ឥណ្ឌូនេស៊ី បាន ផ្លាស់ប្តូរ ពិសោធន៍ ជាមួយគ្នា ទាក់ទង នឹង ការគ្រប់គ្រង ចរាចរណ៍ ខណៈ អត្រា គ្រោះថ្នាក់ ចរាចរណ៍ នៅតែ ស្ថិត គួរឲ្យ ព្រួយបារម្ភ យ៉ាង ខ្លាំង នៅក្នុង ប្រទេស កម្ពុជា ។
ក្នុង ជំនួប នោះ ដែរ នាយ ឧត្តមសេនីយ៍ ហ៊ឹម យ៉ាន បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល ក៏ ដូចជា នគរបាល ឥណ្ឌូនេស៊ី ដែល តែងតែ ជួយ ឧបត្ថម្ភ គាំទ្រ ជាពិសេស ការចែករំលែក បទពិសោធន៍ ដល់ មន្ត្រី នគរបាល កម្ពុជា នា ពេល កន្លងមក នាយ ឧត្តមសេនីយ៍ ហ៊ឹម យ៉ាន បាន បន្ថែម ទៀត ដែរ ថា កម្ពុជា នៅតែ បន្ត ពង្រឹង កិច្ចសហប្រតិបត្តិការ ជាមួយ នគរបាល ឥណ្ឌូនេស៊ី ឲ្យ កាន់ ប្រសើរឡើង បន្ថែម ទៀត ។
លោក ឧត្តមសេនីយ៍ ឯក រុន រ័ត្ន វាសនា បាន លើកឡើង ថា នៅក្នុង កិច្ច ជំនួប នោះ ភាគី ឥណ្ឌូនេស៊ី បាន បង្ហាញ បទពិសោធន៍ ជាច្រើន ដល់ មន្រ្តី នគរបាល ចរាចរណ៍ កម្ពុជា ទាក់ទង នឹង ការគ្រប់គ្រង យានយន្ត និង ការធ្វើដំណើរ ដោយ យានយន្ត ប្រកបដោយ មាន ប្រសិទ្ធភាព បំផុត ។
( កំពង់ចាម ) ៖ លោក ជា ចាន់តូ អគ្គ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា បាន ដឹកនាំ មន្រ្ដី ធនាគារ ជាតិ ចុះ ពិនិត្យ ប្រតិបត្តិការ ស្ថានភាព ឃ្លាំង បេឡា របស់ ធនាគារ ជាតិ សាខា ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០១៨ ។
ការ ចុះ ត្រួតពិនិត្យ នេះ ធ្វើឡើង ស្រប ពេល ដែល លោក អគ្គ ទេសាភិបាល ពិនិត្យ ឃើញ ថា ស្ថានភាព ទឹក ជំនន់ នៅ តាម ដងទន្លេ មេគង្គ ពិសេស ក្នុង ខេត្ត កំពង់ចាម មាន ការកើនឡើង គួរឱ្យ កត់សម្គាល់ ៕ នៅ ថ្ងៃ នេះ ភោជនីយដ្ឋាន ល្បី ជាច្រើន នឹង បញ្ចុះ តម្លៃ នៅក្នុង ផ្សារ ទំនើប សូរិយា !
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ ផ្សារ ទំនើប សូរិយា សេនធ័រ ភ័នធ៍ ( អតីត ផ្សារទំនើប សូរិយា ) នឹង រៀបចំ ការអបអរសាទរ ខួប ១៥ ឆ្នាំ នៃ ការដំណើរការ និង ជា ផ្សារ ទំនើប ដំបូង គេ បង្អស់ នៅក្នុង ប្រទេស កម្ពុជា ។
អ្វី ដែល ជា ការផ្តល់ យ៉ាង ពិសេស ជូន នោះ គឺ ភោជនីយដ្ឋាន ល្បី ៗ ស្ទើរតែ ទាំងអស់ នឹង មាន ការបញ្ចុះ តម្លៃ នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ រួម មាន៖
មិន ត្រឹមតែ ប៉ុណ្ណោះ មិត្ត យុវវ័យ អាច ចូលរួម លេង កំសាន្ត ដើម្បី ឈ្នះ រង្វាន់ ជាច្រើន សន្ធឹកសន្ធាប់ ពេញ មួយ ថ្ងៃ ជាមួយ កម្មវិធី ពិសេស ដូច ជា៖
* ការប្រកួតប្រជែង ញុំា ភីហ្សា និង ហត ដក * ការបង្ហាត់ ធ្វើ អាយ ស្គ្រីម ខេក * ការបង្ហាញ ធ្វើ គំនូរ ពី ខ្សាច់ * ការគូរ រូប ពិត របស់ អ្នក * ការបង្រៀន ចាក់ អំបោះ វត្ថុអនុស្សាវរីយ៍
សូម បញ្ជាក់ ថា ការប្រកួតប្រជែង ញុំា ភីហ្សា នឹង ស្វែងរក អ្នក ឈ្នះ ចំនួន ៣នាក់ ដោយ ផ្តល់ ជូន ប័ណ្ណ សាច់ប្រាក់ ម្នាក់ ១០ដុល្លារ និង ការប្រកួតប្រជែង ញុំាហត ដក នឹង ស្វែងរក អ្នក ឈ្នះ ចំនួន ៣នាក់ ដោយ ផ្តល់ ជូន ប័ណ្ណ សាច់ប្រាក់ ម្នាក់ ៥ដុល្លារ ។
សម្រាប់ ព័ត៌មាន លម្អិត សូម ទំនាក់ទំនង មកកាន់ លេខ ទូរស័ព្ទ ០៨៨ ៨៧៨ ៨៨៨៨៕ ក្រុមហ៊ុន ឥណ្ឌូនេស៊ី សម្រុក ទាញយក អត្ថប្រយោជន៍ ពី វិស័យ លក់ ទំនិញ តាម អនឡាញ ដែល កំពុង ស្ទុះ ឡើង យ៉ាង ខ្លាំង នៅក្នុង ប្រទេស (Video inside) ( ចិន ) ៖ ការវិនិយោគ ដ៏ ច្រើន សន្ធឹកសន្ធាប់ របស់ ចិន កំពុង លើកស្ទួយ យ៉ាង ខ្លាំងក្លា ដល់ វិស័យ ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អ៊ីនធើណេត របស់ ប្រទេស ឥណ្ឌូនេស៊ី ដោយ វា ផ្តល់ ឱកាស ដល់ ក្រុមហ៊ុន ឥណ្ឌូនេស៊ី មួយចំនួន សម្រាប់ ពង្រីក អាជីវកម្ម ។
ជា ម្ចាស់ ហាង លក់ គ្រឿងសង្ហារឹម តាម អនឡាញ មួយ ប្រាយ អ៊ែន និយាយ ថា វេបសាយ នេះ ជួយ សម្រួល ដល់ អាជីវកម្ម របស់ សហគ្រិន នានា ដូចជា គាត់ ដែរ ។
ជាង ៥០ ភាគរយ នៃ ប្រាក់ ទុន អន្តរជាតិ ដែល ហូរ ចូលមក ក្នុង វិស័យ លក់ ទំនិញ អនឡាញ របស់ ឥណ្ឌូនេស៊ី គឺ បាន មកពី ប្រទេស ចិន ។ ក្រុមហ៊ុន ចិន នានា ដូចជា អាលី បាបា និង ធែន ស៊ែន ព្រមទាំង ក្រុមហ៊ុន វិនិយោគទុន ផង នោះ កំពុង បោះ ទុន យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ ចូលមក ក្នុង វិស័យ ដែល កំពុងតែ រីកចម្រើន យ៉ាង ឆាប់រហ័ស នេះ ។
ក្នុង ឆ្នាំ ២០១៧ ក្រុមហ៊ុន អាលី បាបា បាន ដឹកនាំ ការវិនិយោគ ចំនួន ១ ពាន់ ១រយ លាន ដុល្លារ អាមេរិក មក ក្នុង ក្រុមហ៊ុន ថូកូភីឌា ដែល នាំឱ្យ អាលី បាបា អាច ពង្រីក វត្តមាន នៅ អាស៊ី អាគ្នេយ៍ បាន កាន់តែ ឆាប់រហ័ស ។
លោក ថូម៉ាស់ លឹម បុង គឺជា ប្រធាន គណៈកម្មការ សម្របសម្រួល ការវិនិយោគ ឥណ្ឌូនេស៊ី ។ លោក និយាយ ថា ក្រុមហ៊ុន ឥណ្ឌូនេស៊ី គួរតែ ចាប់ យក ឱកាស នេះ ដើម្បី បញ្ចូល បច្ចេកវិទ្យា ថ្មី ៗ ដែល មាន ចូល ទៅក្នុង អាជីវកម្ម របស់ ពួកគេ ។
កាកបាទ ក្រហម កម្ពុជា បន្ដ ភារកិច្ច របស់ ខ្លួន ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ជូន ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ចំនួន ៨៥០ គ្រួសារ នៅក្នុង ខេត្ដ ក្រចេះ
សូម បញ្ជាក់ ជូន ថា អំណោយ ដែល នាំយក មក ចែកជូន នៅ ពេល នេះ បាន មក ពី ការចូលរួម វិភាគទាន របស់ សប្បុរស ជនជាតិ និង អន្តរជាតិ ជាពិសេស ការប្រារព្ធ ទិវា ៨ ឧសភា ដែល ធ្វើឡើង ជារៀងរាល់ ឆ្នាំ ។ សម្រាប់ អំណោយ ដែល បាន ចែកជូន ទាំង ពីរ ថ្ងៃ ខាងលើ នេះ ក្នុង គ្រួសារ នីមួយ ៗ ទទួលបាន ៖ អង្ករ ៣០គក្រ មី ១កេស ត្រីខ ១០កំប៉ុង មុង១ ភួយ១ សារុង១ និង ក្រមា១ ។
សូម បញ្ជាក់ ផងដែរ ថា កាកបាទ ក្រហម កម្ពុជា បាន ចែក អំណោយ មនុស្សធម៌ ជួយ ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ គិត ចាប់ពី ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០១៨ រហូតមកដល់ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន សរុប ចំនួន ១៦. ០២៤ គ្រួសារ បើ គិត ជា ភូមិ ស្មើនឹង ១៨១ ភូមិ ៧២ ឃុំ និង ២៦ ស្រុក នៅក្នុង ខេត្ត ចំនួន ១៥ ក្នុង ចំណោម រាជធានី - ខេត្ត ទាំង ២៥ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ៕
ក្រុម ចោរ ឆក់ ដ៏ សកម្ម ត្រូវបាន កម្លាំង នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ តាម ចាប់ខ្លួន ២នាក់ និង ដកហូត ម៉ូតូ ២ គ្រឿង
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន តាម ចាប់ខ្លួន ក្រុម ចោរ ឆក់ ដែល ធ្វើ សកម្មភាព យ៉ាង សកម្ម នៅ តាម ដង មហាវិថី នៅក្នុង ខណ្ឌ ពោធិ៍សែនជ័យ ចំនួន ២នាក់ ព្រមទាំង ដកហូត ម៉ូតូ ដែល ក្រុម ជនសង្ស័យ ទាំងនេះ ជិះ ធ្វើ សកម្មភាព បាន ចំនួន ២គ្រឿង និង នៅសល់ បក្ខពួក ផ្សេង ទៀត កំពុង រត់គេចខ្លួន ។
លោក យឹម សារ៉ាន់ អធិការ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News នៅ ព្រឹក ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ នេះ ថា ប្រតិបត្តិការ តាម បង្ក្រាប ក្រុម ចោរ ឆក់ ទាំងនេះ ធ្វើឡើង នៅ ល្ងាច ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០១៨ នៅ ចំណុច ភូមិ តា ងួន សង្កាត់ កាកាប១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ក្រោម ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ។
លោក អធិការ រូប នេះ បាន បន្ត ទៀត ថា នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០១៨ វេលា ម៉ោង ១៨៖៣០ នាទី កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល កាកាប១ សហការ ជាមួយ កម្លាំង នគរបាល ផ្នែក យុត្តិធម៌ នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ ក្រោម ការសម្របសម្រួល ពី លោក កុល បុន ព្រះរាជ្ញា រង នៃ អយ្យការ អម្យ សាលាដំបូង រាជធានី ភ្នំពេញ កម្លាំង របស់ លោក បាន ធ្វើ ការស្រាវជ្រាវ ស៊ើបអង្កេត យ៉ាង យកចិត្តទុកដាក់ រហូត ឈានដល់ ការចាប់ខ្លួន ជនសង្ស័យ ពីរ នាក់ ខាងលើ ដែល ក្នុង ចំណោម បក្ខពួក ជាច្រើន ផ្សេង ទៀត កំពុងតែ រត់គេចខ្លួន ។
លោក អធិការ រូប នេះ បាន បញ្ជាក់ ថា ក្រុម ជនសង្ស័យ ទាំងនេះ ធ្លាប់ ធ្វើ សកម្មភាព ឆក់ បាន សម្រេច ចំនួន ៤លើក នៅក្នុង ខណ្ឌ ពោធិ៍សែនជ័យ នៅ តាម ដង មហាវិថី សាធារណៈ ។
