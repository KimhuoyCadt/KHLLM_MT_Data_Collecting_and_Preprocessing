( ភ្នំពេញ ) ៖ បន្ទាប់ពី បាន រៀបចំ វេទិកា ការងារ រយៈពេល ពេញ១ ថ្ងៃ របស់ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ (NEA) បាន ផ្ដល់ ឱកាស ការងារ ដល់ បេក្ខជន ដែល មិន មាន ការងារ ធ្វើ យ៉ាងហោចណាស់ ៣៥១ នាក់ ដោយ ក្នុង នោះ មាន បេក្ខជន ចំនួន ៣៧ នាក់ បាន សម្ភាស ជាប់ ជាស្ថាពរ និង ៣១៤ នាក់ ទៀត ជាប់ បឋម ។
ថ្លែង ឲ្យដឹង ក្នុង វេទិកា ការងារ នៅ ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០១៨ យុវជន តាំង លីម គួង និស្សិត ឆ្នាំ ទី៤ នៃ សាកលវិទ្យាល័យ ភូមិន្ទ នីតិសាស្រ្ដ និង វិទ្យាសាស្រ្ដ សេដ្ឋកិច្ច សិក្សា ជំនាញ គ្រប់គ្រង ពាណិជ្ជកម្ម បាន ឲ្យដឹង ថា « ខ្ញុំ ពិតជា មាន សេចក្តីរំភើប រីករាយ យ៉ាង ខ្លាំង ដែល បាន ជួប ជាមួយនឹង ក្រុមហ៊ុន ដែល ខ្ញុំ ស្រលាញ់ ចង់ បម្រើ ការងារ ហើយ អាច ដាក់ពាក្យ ផ្ទាល់ និង សម្ភាស ជាមួយ តំណាង ក្រុមហ៊ុន ទាំងនោះ ពិសេស នោះ គឺ ខ្ញុំ អាច ជ្រើសរើស ការងារ ដែល ខ្លួន ឯង ពេញចិត្ត ទៀតផង » ។
យុវជន រូប នោះ បន្ដ ទៀត ថា ពីមុន ធ្លាប់ ដាក់ពាក្យ ស្វែងរក ការងារ តាមរយៈ Email និង ចុះ សួរ តាមរយៈ ក្រុមហ៊ុន ប៉ុន្ដែ មិន បាន លទ្ធផល និង មាន ការពិបាក ជាខ្លាំង បូករួម ជាមួយនឹង ការទន្ទឹងរងចាំ ពីសំណាក់ បណ្ដា ក្រុមហ៊ុន ទាំងនោះ តេហៅ ទៅ សម្ភាស ។
យុវុជន ដដែល រូប នោះ បន្ដ ទៀត ថា « ពេលនេះ ខ្ញុំ មាន ភាពងាយស្រួល ខ្លាំង ដោយសារតែ ពេលនេះ បាន ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ បង្កើត កម្មវិធី នេះ ឡើង ដែល កម្មវិធី នេះ ពិតជា ជួយ កាត់បន្ថយ ការលំបាក ថវិកា និង ពេលវេលា របស់ ខ្ញុំ ក៏ ដូចជា និស្សិត ផ្សេង ទៀត ក្នុង ការដាក់ពាក្យ ស្វែងរក ការងារ ធ្វើ » ។
យុវតី ផាន់ ផុន វីយ៉ា និស្សិត ឆ្នាំ ទី៤ នៃ សាកលវិទ្យាល័យ ភូមិន្ទ នីតិសាស្ត្រ និង វិទ្យាសាស្រ្ត សេដ្ឋកិច្ច សិក្សា ជំនាញ នីតិសាស្រ្ត បាន បង្ហាញ ចំណាប់អារម្មណ៍ ថា « ខ្ញុំ មានអារម្មណ៍ សប្បាយ និង គាំទ្រ នូវ កម្មវិធី ដែល រៀបចំឡើង ដោយ NEA នេះ ណាស់ ព្រោះ មិន ត្រឹមតែ ផ្ដល់ ឱកាស ការងារ ដល់ និស្សិត ប៉ុណ្ណោះ ទេ ប៉ុន្ដែ ថែមទាំង ជួយ សម្រួល ពេលវេលា និង ការជំណាយ ដល់ និស្សិត ទៀតផង » ។
កញ្ញា បន្ដ ថា « ខ្ញុំ ចង់ឲ្យ មាន កម្មវិធី នេះ ជារៀងរាល់ ខែ និង សូមឲ្យ ក្រុមហ៊ុន ចូលរួម ឲ្យបាន ច្រើន ដើម្បី ផ្តល់ នូវ ឱកាស ការងារ និង កម្មសិក្សា ជូន ដល់ សិស្ស / និស្សិត បន្ថែម ទៀត » ។
ដូច្នេះ សូម ប្អូន ៗ សិស្ស និស្សិត កុំ ភ្លេច រៀបចំ ប្រវត្តិ រូប សង្ខេប (CV) ដើម្បី ចូលរួម សម្ភាស ការងារ ដោយ ផ្ទាល់ ចាប់ពី ម៉ោង ៨៖០០ ព្រឹក ដល់ ម៉ោង ៥៖០០ ល្ងាច នៅ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ ស្ថិត នៅក្នុង ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
( ភ្នំពេញ ) ៖ លោក អាគីរ៉ា គឺជា ជនជាតិ កម្ពុជា មួយ រូប ត្រូវបាន ទូរទស្សន៍ CNN ជ្រើសរើស ចូលរួម ប្រកួតប្រជែង ក្នុង កម្មវិធី « បុរស ឆ្នើម » កាលពី ឆ្នាំ ២០១០ កន្លងទៅ បន្ទាប់ពី រូប លោក បាន ចូលរួម ក្នុង សកម្មភាព បោស សំអាត មីន ដោយ ស្ម័គ្រចិត្ត ។ អាគីរ៉ា បាន ក្លាយជា បេក្ខជន ១០រូប ចុងក្រោយ ក្នុង កម្មវិធី របស់ CNN បន្ទាប់ពី ឆ្លងកាត់ ការប្រកួត ជ្រើសរើស បេក្ខជន រាប់ ពាន់ នាក់ ។
បុរស ដែល បាន សាង ភាពល្បាញ ល្បី លើ ពិភពលោក តាមរយៈ កញ្ចក់ ទូរទស្សន៍ CNN រូប នេះ ត្រូវបាន កម្លាំង នគរបាល ខេត្ត សៀមរាប ឃាត់ខ្លួន បញ្ជូន ទៅកាន់ តុលាការ ហើយ កាលពី ថ្ងៃទី ២៧ ខែសីហា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ក្រោម ការចោទប្រកាន់ ថា បាន លាក់ ទុក អាវុធ ខុស ច្បាប់ ។
ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០១៨ កម្លាំង ជំនាញ ស៊ីម៉ាក់ បាន បន្ត ឆែកឆេរ នៅ ឃ្លាំង មួយ ទៀត តែ មិន មាន អ្វី ទេ ខុស ច្បាប់ ទេ តែ ព្រះរាជអាជ្ញា បាន សម្រច ឲ្យ ផ្អាក បណ្តោះអាសន្ត សកម្មភាព ការងារ របស់ អង្គការ ដោយ រងចាំ បន្ត និតិវិធី តុលាការ បន្ត ។ កម្លាំង នគរបាល ក៏ បាន រកឃើញ ក្មេង ៗ នៅក្នុង អង្គការ ចំនួន ១៧នាក់ ស្រី ៧នាក់ ហើយ បាន មន្ទីរ សង្គមកិច្ច ខេត្ត យក ទៅ រក្សាទុក នៅ កន្លែង មាន សុវត្ថិភាព ។
ដោយឡែក ឈ្មោះ ហ៊ាញ សុគន្ធា ( បុគ្គិក ផ្នែក ប្រតិបត្តិ ) និង ឈ្មោះ អឿន យ៉ុន ( អនុប្រធាន ) បាន ឆ្លើយ ប្រាប់ សមត្ថកិច្ច ថា ពួកគាត់ មិន ដឹង ថា លោក អាគី រ៉ា យក គ្រាប់ មិន ទាន់ ផ្ទុះ និង គ្រាប់បែក មក ទុក នៅក្នុង បន្ទប់ នោះ តាំងពី ពេលណា នោះ ទេ ព្រោះ បន្ទប់ លោក អាគី រ៉ា ជា អ្នកប្រើប្រាស់ ផ្ទាល់ខ្លួន ។ ចំណែក បុគ្គលិក ផ្សេង ទៀត ក៏ ឆ្លើយ បែប នេះ ផងដែរ ។
បន្ទាប់ពី កម្លាំង នគរបាល សួរនាំ បច្ចុប្បន្ន លោក អាគី រ៉ា. លោក ហ៊ាញ សុគន្ធា និង លោក អឿន យ៉ុន ត្រូវបាន បញ្ជូន ខ្លួន ទៅកាន់ តុលាការ ហើយ ត្រូវបាន ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង ខេត្ត សៀមរាប សម្រេច ឃុំ ខ្លួន នៅ ពន្ធនាគារ ជា បណ្ដោះអាសន្ន កាលពី ល្ងាច ថ្ងៃទី៣០ ខែសីហា ។
សូម បញ្ជាក់ ថា លោក អាគីរ៉ា មាន ឈ្មោះ ដើម អឿន យក្ស មាន ស្រុក កំណើត នៅ ភូមិ សំរោង ឃុំ សំរោង ស្រុក សូទ្រនិគម ខេត្ត សៀមរាប គឺជា កូន ពៅ ក្នុង គ្រួសារ កសិករ មួយ ដែល មាន បងប្អូន ចំនួន ៣នាក់ ( ប្រុស ២ និង ស្រី ១) ។ អាគីរ៉ា បាន ចាប់ផ្ដើម ស្គាល់ គ្រាប់ មីន តាំងពី អំឡុង ឆ្នាំ ១៩៨២ - ១៩៨៣ ដែល បាន ចេះ ដាក់ គ្រាប់ មីន និង គ្រាប់ ច្នៃ ពី កងទ័ព ខ្មែរ ក្រហម និង កងទ័ព រដ្ឋ កម្ពុជា ។
វិទ្យុ ទាក់ទង ដៃ ២៣ គ្រឿង ត្រូវបាន បំពាក់ ជូន ប្រជាការពារ ឃុំ ទ្រៀល នៅ ស្រុក បារាយណ៍ ដើម្បី បន្ត អនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព
( កំពង់ធំ )៖ ដោយ អនុវត្ត តាម គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព ទាំង ៩ ចំណុច របស់ រាជ រដ្ឋាភិបាល និង មាន ការយកចិត្តទុកដាក់ ពី សន្តិសុខ សុវត្ថិភាព របស់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ រង យោធភូមិភាគ ទី៤ និង ជា មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បាន បំពាក់ វិទ្យុ ទាក់ទង ដៃ ចំនួន ២៣ គ្រឿង ជូន ដល់ ប្រជាការពារ ចំនួន ០៥ ភូមិ គឺ៖ ភូមិ កំញ៉ាត . ភូមិ ព្នៅ . ភូមិ ត្នោត . ភូមិ ទន្សាយ និង ភូមិ ញាតិ ទន្លេ របស់ ឃុំ ទ្រៀល ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ ។
ពិធី នេះ បាន ប្រព្រឹត្តទៅ នៅ ព្រឹក ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០១៨ នៅក្នុង បរិវេណ វត្ត ពោធិ៍វង្ស ហត្ថី ហៅ វត្ត ពោធិ៍ ស្ថិត នៅក្នុង ភូមិ កំញ៉ាត ឃុំ ទ្រៀល ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ ដែល ជា ការចូលរួម ឧបត្ថម្ភ របស់ ព្រះអង្គ ព្រះនាម ចែម មុន្នី ចិន្តា គ្រូ ចៅអធិការ វត្ត ពោធិ៍វង្ស ហត្ថី ហៅ វត្ត ពោធ៍ ។
ក្នុង ឱកាស នោះ ដែរ ក្រោយពី បំពាក់ វិទ្យុ ទាក់ទង ដៃ ជូន ដល់ ប្រជាការពារ រួច មក លោក បាន ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ជ ដែល បាន នាំគ្នា អញ្ជើញ ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ដែល ប្រព្រឹត្តទៅ កាលពី ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងមក ដើម្បី ថែរក្សា នូវ សន្តិភាព និង បន្ត អភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន បន្ត ទៅ មុខ ទៀត ។
លោក ក៏ បាន ធ្វើ ការផ្សព្វផ្សាយ នូវ ខ្លឹមសារ គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព ទាំង ៩ ចំណុច អំពី តួនាទី ភារកិច្ច និង សិទ្ធិ ជូន ដល់ ប្រជាការពារ ដែល ត្រូវ អនុវត្ត ជៀសវាង ប្រព្រឹត្ត ខុសពី គោលការណ៍ ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ ។
លោក សោម ស៊ុន បាន ថ្លែង ថា សូម ផ្តាំផ្ញើ ជូន ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ចូលរួម ថែរក្សា ទ្រព្យសម្បត្តិ ផ្ទាល់ខ្លួន ទ្រព្យសម្បត្តិ សាធារណៈ ដើម្បី ចូលរួមចំណែក ក្នុង ការអនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព របស់ រាជ រដ្ឋាភិបាល ទាំងអស់ គ្នា ៕ ក្រសួង ការពារ ជាតិ ជប៉ុន ស្នើ បន្ថែម កញ្ចប់ ថវិកា ជាតិ ដើម្បី ផលិត ប្រព័ន្ធ មីស៊ីល ទុក បាញ់ កម្ទេច មីស៊ីល កូរ៉េ ខាងជើង ...
( តូក្យូ ) ៖ ក្រសួង ការពារ ជាតិ ជប៉ុន បាន ស្នើសុំ បង្កើន កញ្ចប់ យោធា សម្រាប់ ឆ្នាំ ២០១៩ សំដៅ យក ទៅ អភិវឌ្ឍន៍ ប្រព័ន្ធ ខែល ការពារ មីស៊ីល ទុក បាញ់ កម្ទេច មីស៊ីល របស់ កូរ៉េ ខាងជើង ដែល ទីក្រុង តូក្យូ នៅតែ ចាត់ទុក ថា ជា ការគំរាមកំហែង ដ៏ ធំ ដល់ សន្តិសុខ ជាតិ របស់ ខ្លួន បើ ទោះជា លោក គីម ជុង អ៊ុន សន្យា បោះបង់ ចោល អាវុធ នុយក្លេអ៊ែរ ក៏ដោយ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ រសៀល ថ្ងៃសុក្រ ទី ៣១ ខែសីហា ឆ្នាំ ២០១៨ ។
ក្រសួង ការពារ ជាតិ ជប៉ុន នៅ ថ្ងៃសុក្រ នេះ បាន ស្នើសុំ កញ្ចប់ ថវិកា យោធា រហូតដល់ ៤៨ ពាន់ លាន ដុល្លារ ឬ កើនឡើង ២.១ភាគរយ សម្រាប់ ឆ្នាំ ២០១៩ ដោយ រាប់ ចាប់ផ្ដើម ពី ថ្ងៃទី ០១ ខែមេសាត ទៅ ។ ម្យ៉ាង វិញ ទៀត បើសិនជា កញ្ចប់ ថវិកា នេះ ត្រូវបាន អនុម័ត នោះ វា មាន ន័យ ថា ជា ការបង្កើន កញ្ចប់ ថវិកា យោធា ០៧ លើក ជាប់ ៗ គ្នា ខណៈ នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក ស៊ីន ហ្សូ អាបេ កំពុង ពង្រឹង សមត្ថភាព យោធា ជប៉ុន ដើម្បី ឆ្លើយតប ទៅនឹង ការគំរាមកំហែង ពី មីស៊ីល កូរ៉េ ខាងជើង និង ការកើនឡើង ឥទ្ធិពល យោធា ចិន នៅក្នុង តំបន់ ។
គួរ ជម្រាប ថា ការកោតសរសើរ របស់ លោក ឌូតឺ តេ ចំពោះ លោក Marcos ត្រូវបាន គេ ចាត់ទុក ជា រឿង ចម្រូងចម្រាស មួយ ដោយសារតែ ប្រជាជន ហ្វីលីពីន ជាច្រើន នាក់ នៅតែ មិន ទាន់ អាច បំភ្លេច បាន នៅឡើយ ទេ ពី សម័យកាល ខ្មៅ ងងឹត រយៈពេល ០២ ទសវត្សរ៍ នៃ ការគ្រប់គ្រង ប្រទេស របស់ លោក Marcos ដែល បាន បញ្ចប់ ទៅ ដោយ បះបោរ កាលពី ឆ្នាំ ១៩៨៦៕ ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ . អភិបាល ខណ្ឌ ដង្កោ បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ និង លូ ជូន ប្រជាពលរដ្ឋ ក្នុង ភូមិ សំបួរ សង្កាត់ ដង្កោ
( ភ្នំពេញ ) ៖ លោក នុត ពុធ ដារ៉ា អភិបាល ខណ្ឌ ដង្កោ នៅ ព្រឹក ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ បេតុង ០១ ខ្សែ ប្រវែង ១៨៦ ម៉ែត្រ ទទឹង ៨ម៉ែត្រ និង ដាក់ បំពង់ លូមូល រំដោះ ទឹក ០១ ខ្សែ ប្រវែង ២៨០ ម៉ែត្រ មុខ កាត់ ០.៦ម៉ែត្រ ស្ថិត ក្នុង ភូមិ សំបួរ សង្កាត់ ដង្កោ ។
ក្នុង ឱកាស នោះ លោក អភិបាល ខណ្ឌ បាន ផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធិ បណ្ឌិត ជូន ដល់ ប្រជាពលរដ្ឋ ព្រមទាំង ធ្វើការ ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ ដែល បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ឲ្យ ទទួលបាន ជ័យជម្នះ ភ្លូក ទឹក ភ្លូក ដី ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ឆ្នាំ ២០១៨ ដើម្បី បន្ត ជូន សម្តេច តេជោ ហ៊ុន សែន ធ្វើជា នាយក រដ្ឋមន្ត្រី បន្ត ថែរក្សា សុខ សន្តិភាព និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ឲ្យបាន រីកចម្រើន បន្ថែម ទៀត ។
លោក អភិបាល ខណ្ឌ ដង្កោ បាន ប្តេជ្ញា អនុវត្ត ដោះស្រាយ បញ្ហា នានា ដែល បាន សន្យា ជាមួយ ប្រជាពលរដ្ឋ មុន បោះឆ្នោត ឲ្យបាន ជោគជ័យ ហើយ ផ្លូវ បេតុង ថ្មី និង ប្រព័ន្ធ លូរំដោះ ទឹក ដែល បើក ការដ្ឋាន ស្ថាបនា នៅ ពេល នេះ គឺ ដើម្បី ឆ្លើយតប នឹង តម្រូវការ របស់ ប្រជាពលរដ្ឋ ក្នុង ភូមិ សំបួរ ព្រមទាំង ជួយ សម្រួល ដល់ ការធ្វើដំណើរ បញ្ជៀស ការលិចលង់ នៅ រដូវ វស្សា និង បង្កើន សោភណ្ឌភាព នៃ ការរស់នៅ ផងដែរ ។
បន្ថែម ពី នេះ លោក នុត ពុធ ដារ៉ា ក៏ បាន ផ្តាំផ្ញើរ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម សហការ ក្នុង ការស្ថាបនា ឲ្យបាន ឆាប់ រួចរាល់ និង ចូលរួម ថែរក្សា ដើម្បី ប្រើប្រាស់ បាន យូរអង្វែង ។
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ ក្នុង ភូមិ សំបួរ បាន ធ្វើការ ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ដែល បាន គិតគូរ ដល់ ការលំបាក របស់ ពួកគាត់ និង ជួយ សម្រួល ដល់ ការរស់នៅ ប្រចាំ ថ្ងៃ ផងដែរ ៕
ពិព័រណ៍ វិស័យ ស្ថាបត្យកម្ម អគារ និង សំណង់ អន្ដរជាតិ ធំ ជាង គេ បំផុត របស់ កម្ពុជា ឆ្នាំ ២០១៨ ធ្វើឡើង នៅ កោះ ពេជ្រ រយៈពេល ៣ ថ្ងៃ មាន ប្រទេស ២៣ចូលរួម
( ភ្នំពេញ ) ៖ CAMBUILD ជា ការតាំងពិព័រណ៍ វិស័យ ស្ថាបត្យកម្ម អគារ និង សំណង់ អន្ដរជាតិ ធំ ជាង គេ បំផុត របស់ កម្ពុជា ដែល នឹង ផ្ដោត លើ ការយកចិត្តទុកដាក់ លើ ប្រធានបទ គំនិត ច្នៃប្រឌិត ការរចនា និង ការរៀបចំ បែប ទីក្រុង បៃតង សម្រាប់ ទីក្រុង វៃ ឆ្លាត សម្រាប់ ការអភិវឌ្ឍ ទីក្រុង នា ពេល អនាគត នៅ កម្ពុជា ។
ពិព័រណ៍ នេះ ត្រូវ រៀបចំឡើង នៅ ថ្ងៃទី ១២ - ១៤ ខែកញ្ញា ឆ្នាំ ២០១៨ នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ កោះ ពេជ្រ ។
គំនិត ផ្ដួច ផ្ដើម ទីក្រុង វៃ ឆ្លាត នឹង ធ្វើឲ្យ ទីក្រុង កម្ពុជា កាន់តែ មាន សុវត្ថិភាព ប្រសិទ្ធភាព និង និរន្ដភាព អម ជាមួយ បរិស្ថាន ល្អ សម្រាប់ អ្នក ដែល រស់ នៅក្នុង ទីក្រុង ភ្នំពេញ ត្រូវបាន បង្ហាញ ក្នុង សន្និសីទ សារព័ត៌មាន នៅ ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០១៨ នៅ សណ្ឋាគារ កាំបូឌីយ៉ា ណា ។
លោក បន្ថែម ថា ស្តង់ តាំងពិព័រណ៍ ជាង ៣៥០ ក្រុមហ៊ុន និង ម៉ាក ផលិតផល អន្ដរជាតិ មកពី ២៣ ប្រទេស ។ លើស ពី នេះ ទៀត ក៏ មាន កម្មវិធី ផ្ដល់ជូន ពិសេស ៗ ភ្ជាប់ ជាមួយ បញ្ចុះ តម្លៃ ជាច្រើន ផងដែរ ។
លោក ភឿន សោភ័ណ អគ្គ លេខាធិការ ក្រុមប្រឹក្សាភិបាល ស្ថាបត្យករ កម្ពុជា និង ជា រដ្ឋលេខាធិការ ក្រសួង ដែនដី នគរូបនីយកម្ម បាន ថ្លែង ថា ការតាំងពិព័រណ៍ CAMBUILD ឆ្នាំ ២០១៨ ស្រប ពេល ដែល ប្រទេស កម្ពុជា មាន សុខ សន្ដិភាព និង ការអភិវឌ្ឍ និង មាន ការអភិវឌ្ឍ រីកចម្រើន គ្រប់ វិស័យ ជាពិសេស វិស័យ សំណង នៅ កម្ពុជា ទាំងមូល ។
