ខ្ញុំពិតជាត្រូវការ ការងារមួយ ដូច្នេះខ្ញុំអាច រកប្រាក់សម្រាប់ការងារនេះ ។
ដូច្នេះបន្ថែមទៀតប្រសិនបើវាមិនមែន ។
ពួកគេ នឹង នាំ អ្នកធ្វើដំណើរ ឆ្លងកាត់ ។
ខ្ញុំ នឹង និយាយ រឿង នេះ អំពី កុមារ ។
ឬ អ្នក ដែល ចាប់ផ្តើម ពី មូលដ្ឋាន ដំបូង ។
អ្នកប្រជាធិបតេយ្យនៅរដ្ឋកាលីហ្វ័រញ៉ាបាននិយាយថានាងនិងសមាជិក សភាដទៃទៀត ។
ភាពជាដៃគូ យុទ្ធសាស្ត្រ ជាមួយ ទីក្រុង ប៉េកាំង ។
ក្នុង ករណី នីមួយ ៗ ខ្ញុំ សង្កត់ធ្ងន់ លើ ភាពយុត្តិធម៌ ។
មិន មែន គ្រាន់តែ និយាយ ទេ ប៉ុន្តែ ធ្វើ វា ។
ទៅដល់ ប្រទេស ចិន តាម យន្តហោះ ។
អ្នកខ្លះដោះសម្លៀក បំពាក់ដើម្បីបង្ហាញត្រគាករបស់ពួកគេដែលពាក់ដោយក្រវាត់ ។
អ្នកដែលដើរដោយថ្មើរ ជើងគឺ ជាអ្នកត្រាច់ចរ ( ចិត្ត រវើរវាយ ) ។
ពួកយើង ដែល មាន សំណាង គ្រប់គ្រាន់ ក្នុង ការស្គាល់ និង ធ្វើ ការ ដោយ ប្រើប្រាស់ Steve បាន លះបង់ មិត្ត រួម ការងារ ជាទីគោរព និង ការណែនាំ ដ៏ បំផុស គំនិត ។
ការវិនិយោគ លើ ផ្សារ ហ៊ុន គឺ សាមញ្ញ !
យើង សង្ឃឹម ថា បញ្ហា នេះ នឹង ផ្តល់ ការយល់ដឹង ខ្លះ ៗ អំពី អ្នក ទាំង បី ។
វិធី ធ្វើឱ្យ វា កាន់តែ ទាក់ទាញ ។
ករណី មួយ នៅក្នុង ចំណុច គឺ ភាសា អារ៉ាប់
ខ្ញុំគិតថា យើងនឹងក្លាយជាមិត្តដ៏រឹងមាំ » ។
គ្រោះថ្នាក់ , សាធារណជន ត្រូវតែ ត្រឹមត្រូវ ។
គាត់ ដឹង ថា ជីវិត ថ្មី របស់ គាត់ ហៀប នឹង ចាប់ផ្តើម ។
ខ្ញុំ ធ្លាក់ ក្នុង អន្លង់ ស្នេហ៍ ជាមួយ ប្លក់ របស់ អ្នក និង ការថត រូប ដ៏ ស្រស់ស្អាត ។
តាំងពីផ្លាស់ មកទីនេះ យើងបានជួបតែសេចក្ដី សប្បុរស ។
នៅ ទីនេះនឹងមិនមានថ្មមួយដុំនៅលើថ្មមួយទៀត ដែលនឹងមិនត្រូវបោះចោលឡើយ » ។
ពួកគេ មិន ដឹង ពី របៀប សម្រេចចិត្ត ។
ក្រុម គ្រូពេទ្យ ឯករាជ្យ ជាច្រើន នៅ ជុំវិញ ពិភពលោក ក៏ កំពុង បន្ត នីតិវិធី នេះ ផងដែរ ។
ដំណាក់កាល ទី 2 ត្រូវបាន បែងចែក ជាៈ
ដែល ត្រូវបាន ធ្វើឱ្យ ប្រសើរឡើង សម្រាប់ ប្រតិបត្តិការ ស្វែងរក បែប នេះ ។
អេសេគាល 23:32 ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលដូច តទៅ : « អ្នកនឹងពិសាពែងដ៏ជ្រៅ និងទូលាយរបស់បងស្រីអ្នក ។ អ្នកនឹងត្រូវបានគេមើលងាយ និង ចំអក ព្រោះវាមានច្រើនណាស់ ។
សេរីភាពក្នុងការ ធ្វើតាមជំនឿរបស់ខ្លួន - ស្ថិតក្រោម បទប្បញ្ញត្តិរបស់រដ្ឋ
ប្រធានាធិបតី បារ៉ាក់ អូបាម៉ា បាន ផ្តល់
« អស់អ្នកដែលស្ថិតនៅក្រោមនឹមនៃទាសភាព គួរចាត់ទុកចៅហ្វាយរបស់ខ្លួន សមនឹងការ គោរពយ៉ាងពេញ លេញ ដើម្បីកុំឲ្យនាមរបស់ព្រះ និងការ បង្រៀនរបស់យើងត្រូវបានគេបង្កាច់បង្ខូច ។
មុន ពេល ដែល នៅជិត ការលេង ហ្គេម ថ្មី ។
ការ ហៅទូរសព្ទ៖ បុរស ចំណាស់
ព្រឹកមិញនេះមិនបានគិតអ្វីសោះ ...
នៅពេល សួរ អំពី ឈ្មោះ ក្រុម ។
កុំខ្លាចចុះទៅស្រុកអេស៊ីបឡើយ ដ្បិតនៅ ទីនោះ យើងនឹងធ្វើឲ្យអ្នកក្លាយជាប្រជាជាតិធំ » ។
គាត់នៅលើយន្តហោះ ពេលខ្ញុំឃើញគាត់ ហើយខ្ញុំស្គាល់គាត់ភ្លាម » ។
វា ជា ការងារ រំដោះ ។
ក្រុមប្រឹក្សាភិបាល ប្រមូលផ្តុំ ពេល ខ្លះ ក្នុង មួយ ខែ ។
រង់ចាំ សិទ្ធិ ច្បាស់លាស់ ។
តើមានអ្វីគួរឲ្យចាប់អារម្មណ៍ចំពោះកាលវិភាគប្រកួតបាល់ទាត់អាស៊ីឆ្នាំ ២០១៨ ?
ពេលអ្នកទាំងពីរនៅជាមួយគ្នា វាតែងតែមានរូបរាងល្អ។
« ដូច្នេះចាប់ពីថ្ងៃនោះមក ពួកគេមានគម្រោងសម្លាប់គាត់ » ។
ហើយពួកគេប្រាកដជាមិនបានប្រើវាដើម្បីសង្គម កាន់ តែប្រសើរនោះទេ ។
ក្នុងជីវិតរបស់គាត់ គាត់បានផ្ដល់គំរូ ដ៏ល្អឥតខ្ចោះដល់មនុស្សក្នុងការ គោរពតាមច្បាប់របស់ព្រះ។
ពួកគេបានធ្វើការ យ៉ាងល្អក្នុងការ រក្សាការ សម្ងាត់ ។
ថម បានដឹងរឿងនេះ ។
កាល ខ្ញុំ នៅ ក្មេង ខ្ញុំ មក ទីនេះ ញឹកញាប់ ជាមួយ ឪពុក ម្តាយ និង បង ប្រុស របស់ ខ្ញុំ ។
សន្តិភាព នឹង មិន ចាកចេញ ពី ខ្ញុំ ទេ ។
ទ្រង់បានទទួល ការ រំលងរបស់យើង និងនឹមនៃអំពើទុច្ចរិតរបស់យើង ហើយត្រូវ របួសដោយ សារអំពើរំលងរបស់យើង ។
នេះ ជា ការបញ្ជាទិញ ដែល ខ្ញុំ នឹង ទាក់ទង ភ្នាក់ងារ ទាំង នេះ ។
ការកើនឡើង នៃ ប្រទេស ចិន ។
បាទ មាន ការពន្យល់ ជាច្រើន ។
បល្ល័ង្ក និង សត្វ មាន ជីវិត និង មនុស្ស ចាស់ ។
៩ត្បិតអ្នក រាល់គ្នាស្គាល់ព្រះគុណនៃព្រះយេស៊ូវ គ្រីស្ទជា ព្រះអម្ចាស់នៃយើងហើយថា ទោះបីគាត់ ជាអ្នកមានក៏ដោយ ប៉ុន្តែគាត់បានទៅជាអ្នកក្រ ដើម្បីអ្នក រាល់គ្នាដោយ ភាព ក្រីក្រ របស់គាត់បានក្លាយជាអ្នកមាន ។
ចូរ និយាយ អំពី ថាមពល ដែល វា ផ្គត់ផ្គង់ ក្នុង ស្ថានភាព ស្ថិរភាព ។
សៀវភៅ យ៉ូអែល ទាំងមូល គឺជា រឿង មួយ - វិវរណៈ របស់ ព្រះយេស៊ូវ គ្រីស្ទ ។
ដែល មាន ប្រយោជន៍ សម្រាប់ អ្នក ។
ជាប់ ច្រវាក់ ទៅនឹង រឿង
តើខ្ញុំព្យាយាមធ្វើអ្វីចំពោះគាត់ ?
នៅ ទីនេះ ពួកគេ បាន ប្រែ ទៅជា ទម្រង់ នៃ ការធ្វើដំណើរ ពេលវេលា ។
ទោះជា យ៉ាងណា ក៏ដោយ ប្រសិនបើ អ្នក មិន អាច ធ្វើ វា ដោយ ខ្លួន ឯង បាន ទេ អ្នក គួរតែ ស្វែងរក ជំនួយ ។
ពួកគេនឹងហួស ចិត្ត ហើយគេនឹងមិនបានរៀនសូត្រច្រើនពីការ លើសចំណុះនោះទេ ។
« ខ្ញុំដាក់កញ្ចក់ ដល់អ្នក រាល់គ្នា - ដល់ប៉ាឡេស្ទីន និងអ៊ីស្រាអែល » ។
« យើងអាចឃើញពួកគេបីនាក់ចេញពីទឹក » ។
បុគ្គលដែលមានអាពាហ៍ ពិពាហ៍មិនសប្បាយ ចិត្ត
ព្រះ ដែល ទ្រង់ កំពុង ស្តាប់ ។
ឥឡូវនេះ ត្រឡប់ ទៅ ការកំណត់ ហើយ ឥឡូវនេះ អ្នក នឹង អាច ឃើញ ជម្រើស អ្នកអភិវឌ្ឍន៍ ។
ដោយ ភាពខ្ជាប់ខ្ជួន និង ដោយ សេចក្តីព្យាយាម នោះ គេ នឹង បង្ខំ ឲ្យ មក ហើយ វា នឹង នៅ យូរ
ឥឡូវខ្ញុំត្រូវរកកន្លែងសម្រាប់ពួកគេ !
តើ អ្វី ជា រឿង សំខាន់ ដែល អ្នក ចាប់ផ្តើម ដំបូង ទាំងអស់ ត្រូវ ចងចាំ មុនពេល ចាប់ផ្តើម ហ្គេម ?
សម្រាប់ ប្រជាជន ជាពិសេស ប្រជាជន ក្រីក្រ ។
ច្រកទ្វារ យើង បាន ឃើញ ជីវិត ទាំងអស់ ដែល បាន ប្រមូលផ្តុំ នៅ ទីនោះ ។
តើយើងមិនបានទទួលសិទ្ធិមិនត្រូវបានគេវិនិច្ឆ័យដោយរូបរាងរបស់យើងឬ ?
