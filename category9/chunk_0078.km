បញ្ជា ក់៖ « ខ្ញុំកំពុងទាក់ទាញ ភាពសម្បូរបែបចូល មកក្នុងជីវិតរបស់ខ្ញុំជារៀងរាល់ថ្ងៃ ។
គាត់ អន់ចិត្ត ចំពោះ បុរស តូច ម្នាក់ ។
ខ្ញុំ កំពុង រង់ចាំ បុរស នោះ បង្ហាញ ខ្លួន នៅ ទីនេះ ។
អ្នក អាច បង្កើន ប្រសិទ្ធភាព ថា ស រឹង របស់ អ្នក ដោយ ខ្លួន ឯង ។
កូនរបស់អ្នកត្រូវបានបង្កើតឡើងដោយអ្នកដែលខ្ពស់ជាងខ្លួនឯង ហើយ កំណើតរបស់គាត់គឺនៅក្នុងដៃរបស់ព្រះ ដ៏មាន មហិទ្ធិ ឫទ្ធិ ។
អ្នកគួរតែពឹងផ្អែកលើមួយវិនាទីមុនពេលកាមេរ៉ារួចរាល់ដើម្បីប្រើម្ដងទៀត ។
១៦ នៅទី ណាដែលមានការ ច្រណែន និងការប្រជែងគ្នា នោះមាន ភាព វឹកវរ និងអំពើអាក្រក់គ្រប់បែបយ៉ាង ។
ភ្លើងបានធ្លាក់មកពីស្ថាន សួគ៌ ហើយលេបត្របាក់ពួកគេ ។
ដូច្នេះហើយ ម្យ៉ាង វិញ ទៀត ភាពចម្រុះ នៃ សត្វ ដែល សហគមន៍ នានា ចូលចិត្ត
ជួបគ្នា ម្តង ទៀត នៅ ពេល ក្រោយ ។
តាមពិត វ្ល៉ាឌីមៀ ពូទីន ។
សំលៀកបំពាក់ ផ្ទាល់ខ្លួន របស់ នាង សម្រាប់ ការបញ្ចាំង លើក ដំបូង ។
ដើម្បី វាយតម្លៃ ពី របៀប ដែល ល្អ បំផុត ដើម្បី ជួយ កូន របស់ អ្នក ។
២២ ទូលបង្គំបានប្រទានសិរីល្អដល់ពួកគេ ដែលទ្រង់បានប្រទាន មកទូលបង្គំ ដើម្បីឲ្យពួកគេបានរួមគ្នាដូចជាយើងតែមួយ
នេះ បើ យោង តាម របាយការណ៍ របស់ ប៉ូលីស ។
វា ងាយស្រួល រៀន និង គួរឱ្យ ចាប់អារម្មណ៍ ហើយ ប្រហែលជា ខ្ញុំ អាច រក លុយ បាន ខ្លះ នៅពេល ខ្ញុំ ត្រឡប់ ទៅ រដ្ឋ វិញ ។
វាគឺជាគេហទំព័រដ៏ល្អមួយនៅជុំវិញ » ។
ច្របាច់ គ្រាប់ ពូជ ចេញពី ខាងក្នុង ។
យើងនៅមិនទាន់ដឹងថារឿងនេះនឹងត្រូវ បញ្ចប់ដោយរបៀប ណាទេ ។
ពេលមកដល់ចំណុចនេះ !
បន្ទាប់ពី បី ខែ ពួកគេ នឹង ចាកចេញ ។
ពី អេក្រង់ បើក ទៅ ប្រព័ន្ធ ពិន្ទុ ។
ព្រះយេស៊ូមានព្រះបន្ទូល ថា៖ « ខ្ញុំជាមាគ៌ា ជាសេចក្ដី ពិត និងជាជីវិត គ្មានអ្នក ណាមក ឯព្រះវរ បិតាទេ គឺមកតាមខ្ញុំ » ។
គ្រោះថ្នាក់ អាច កើតឡើង គ្រប់ ពេលវេលា ទោះបីជា អ្នក មាន ការប្រុងប្រយ័ត្ន ខ្លាំង ក៏ដោយ ។
ទោះបីជាខ្ញុំចូល ចិត្តពេលគាត់បែបនេះ ខ្ញុំចូល ចិត្តលួង លោមគាត់ ។
នេះជាការ ស្ដារឡើងវិញនៃរាជាណាចក្ររបស់ព្រះ។
ត្រូវបាន ហាមឃាត់ យ៉ាង តឹងរ៉ឹង ក្នុង ការប្រកាស ព្រះនាម របស់ ព្រះ។
ថៅកែ ដើម្បី បណ្តេញ សហជីព ចេញពី ឧស្សាហកម្ម សំណង់ ។
ម៉ាន់ បាន ចូល ស្ទូឌីយ៉ូ តាំងពី ព្រលឹម ។
ដូច្នេះ អ្នកសារភាព ចំពោះ គ្រប់ វិធី ដែល អ្នក បាន ឃើញ ។
ពួកសិស្សភ្ញាក់ផ្អើល ។ « តើនេះអាច ជាអ្នក ណាដែលសូម្បីតែខ្យល់ និងសមុទ្រក៏ស្តាប់បង្គាប់ទ្រង់ ? »
ផ្តោត លើ អ្វី ដែល សំខាន់ សម្រាប់ អ្នក និង អ្នកស្តាប់ របស់ អ្នក ។
ខ្ញុំ អាច ពឹងផ្អែក លើ ពួកគេ ក្នុង កម្រិត មួយ ដើម្បី ជួយ ខ្ញុំ ចេញ នូវ កាតព្វកិច្ច យាម ។
ការស្វែងរក ការពិត ២០០៧
នាងក៏បានបន្ថែមថា “ យើងដឹងគុណចំពោះការ ស្រឡាញ់និងគាំទ្រគ្រួសាររបស់យើង ។
មនុស្សជាច្រើនអាច កែ លម្អបាន » ។
81 ដូច្នេះ កុំយកកូនស្រីរបស់អ្នកទៅរៀបការ ជាមួយនឹងកូនប្រុសរបស់ពួកគេ ហើយក៏កុំយកកូនស្រីទៅឲ្យកូនប្រុសរបស់អ្នកដែរ ។
ប៉ុន្តែបានដកខ្លួនចេញដោយយកទម្រង់ជាទាសករមកធ្វើដូចមនុស្ស ។
ប្រសិនបើពួក មន្ត្រីបានឮថាខ្ញុំនិយាយជាមួយអ្នក ហើយ គេ មក រកអ្នក ហើយនិយាយថា ចូរប្រាប់យើងអំពីអ្វីដែលអ្នកបានប្រាប់ស្តេច និងអ្វីដែលស្តេចបានប្រាប់អ្នក ។ កុំ លាក់ វា ពី យើង ហើយ យើង នឹង មិន សម្លាប់ អ្នក ឡើយ
នៅ ពេលព្រឹក មានអារម្មណ៍ អស់ កម្លាំង និង ធ្ងន់ នៅក្នុង ជើង ( សាមសិប វិនាទី )
ពួកគេ ត្រូវតែ ស្វែងរក ទិសដៅ របស់ ពួកគេ ។
បាន និយាយ ថា គាត់ នឹង ទុក វា ទៅ ការវិនិច្ឆ័យ
ប្រភេទ នៃ បច្ចេកវិទ្យា កាន់តែ ប្រសើរ ។
« ហើយយើងបាននាំកូនចៅអ៊ីស្រា ‌ អែលឆ្លងសមុទ្រ ហើយ កាលនោះ ព្រះចៅផារ៉ោន និង ពលបរិវាររបស់ទ្រង់បានដេញតាមពួកគេដោយកំហឹង និងការ ជិះ ជាន់យ៉ាងខ្លាំង រហូតដល់ [ ពួកគេត្រូវទឹកសមុទ្រគ្រប ដណ្តប់ ។
" នេះជាកូនជាទី ស្រឡាញ់របស់ខ្ញុំ ដែលខ្ញុំពេញ ចិត្ត " ។
តើអ្នកបានគិតពីអ្វីដែលធ្វើឱ្យអ្នកម្ដាយភ្ញាក់ផ្អើលក្នុងថ្ងៃបុណ្យម្ដាយ ?
វាក៏នឹងត្រូវត្រឡប់ទៅគណៈកម្មាធិការ ដើម្បីពិនិត្យមើលផងដែរ » ។
ពាក្យ ដំបូង របស់ គាត់ បន្ទាប់ពី ការដើរ លើ ឋាន ព្រះច័ន្ទ " នោះ ជា ជំហាន តូច មួយ សម្រាប់ មនុស្ស ការលោត ដ៏ ធំ សម្រាប់ មនុស្សជាតិ " ត្រូវបាន ចាក់ផ្សាយ តាម ទូរទស្សន៍ ដល់ ផែនដី និង បាន ស្តាប់ រាប់ លាន នាក់ ។
បាន ចាប់ផ្ដើម ឡើងវិញ មួយ សប្តាហ៍ មុន ។
ដំបូង បង្អស់ វា ចាំបាច់ ដើម្បី កំណត់ ម៉ាស៊ីន មេ អាជ្ញាប័ណ្ណ
ឈប់ប្រៀបធៀបខ្លួនឯងនឹងអ្នក ដទៃ៖ ផ្ដោតលើខ្លួនឯង ហើយមាន តែខ្លួន ឯង ។
ពួកគេ ត្រូវបាន ជំរុញ ដោយ ជំនឿ និង ការតស៊ូ ។
ដើម្បីឱ្យ ពួកគេ បង្ហាញ កាន់តែ ប្រសើរ ។
« ដូចជាព្រះវរ បិតាដែលមានព្រះជន្មរស់បានចាត់ខ្ញុំមក ហើយខ្ញុំក៏រស់ដោយព្រោះព្រះវរ បិតា នោះអ្នកដែលចិញ្ចឹមខ្ញុំនឹង រស់ដោយព្រោះខ្ញុំ » ។
ជាពិសេស តើ យើង ត្រូវ ធ្វើ ដូចម្តេច អំពី ការចែករំលែក ការចងចាំ រវាង ដំណើរការ ?
ដូច្នេះ ដើម្បី រក្សា ឆ្នាំ ទាំងនោះ ។
វា កើតឡើង ដោយសារតែ ទទឹង ផ្លូវ មិន ស៊ីសង្វាក់ គ្នា ។
គ្មាន អ្វី ដែល អ្នក អាច ធ្វើ បាន អំពី វា ទេ លើកលែងតែ រង់ចាំ ដល់ វេន របស់ អ្នក ដើម្បី ពង្រីក វា ប៉ុណ្ណោះ ។
១០ តើអ្នកមិនបានអានវគ្គ បទគម្ពីរនេះ ទេ៖ « ថ្មដែលអ្នក សង់បានបដិសេធ នោះបានក្លាយទៅជាថ្មគោលហើយ ... » ។
ខ្ញុំ ចង់ សាកល្បង សាលា មត្តេយ្យ នៅ ផ្ទះ ។
