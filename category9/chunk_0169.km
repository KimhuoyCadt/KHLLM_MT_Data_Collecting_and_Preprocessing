នេះ ពោលគឺ អាច នៅក្នុង ឆ្នាំ ២០១៩ នេះ ហើយ គ្រោង ប្រើ រយៈពេល សាងសង់ ក្នុង ចន្លោះ ៣ទៅ ៤ឆ្នាំ ។
លោក អាងច័ន្ទ រិទ្ធិ មានប្រសាសន៍ ថា ៖
សង្គម ស៊ីវិល ក៏ លើកឡើង ថា ពលរដ្ឋ ខ្មែរ មិន សូវ ទុកចិត្ត គុណភាព ផលិតផល របស់ ប្រទេស ចិន នោះ ទេ ។
ប្រទេស មីយ៉ាន់ម៉ា មិន ត្រូវបាន អនុញ្ញាតឱ្យ ចូលរួម ទេ ។
ហើយ ស្ថានភាព ទឹក ជំនន់ នៅក្នុង ក្រុង ពេលនេះ ហាក់ មិន មាន អ្វី គួរ បារម្ភ ឡើយ ។
ផងដែរ នៅពេល មាន ធ្ល្កាក់ ឈាម រដូវ ។
អត្ថបទ នេះ ត្រូវបាន ផ្សាយ ក្នុង សេដ្ឋកិច្ច ។
ឯកឧត្តម ណុះ ស្លេះ ពេល ផ្តល់ បទសម្ភាសន៍
គ្មាន ជីវិត រីករាយ ណា ដែល ថា មិន ធ្លាប់ ឆ្លងកាត់ ព្យុះភ្លៀង នោះ ទេ ។
អ្នកទទួល ជ័យលាភី នឹង ត្រូវបាន ជ្រើសរើស ដោយ តាមរយៈ ចំ
ករណី សំយោគ - កែច្នៃ ១ករណី ឃាត់ខ្លួន ២នាក់ ស្រី ១នាក់ ។
ហើយ តាមរយៈ សូម៉ាដា និង បងប្អូន វើ ដប្រែ ស ។
អ្នក ឱ្យ តម្លៃ ខ្លាំង ហួស ពេក ចំពោះ រូបភាព ខាងក្រៅ
បន្ទាយ គ្រប់ ទីកន្លែង ត្រូវតែ មាន លក្ខណសម្បត្តិ ដូច ខាងលើ នេះ ។
ទោះជា បែប ណា ស្ថានទូត និង ក្រសួង ការបរទេស វៀតណាម មិន ទាន់ មាន ប្រតិកម្ម បែប ណា ជុំវិញ ស្ថានការណ៍ នេះ ទេ ។
លោក បាន ទទូច ថា ការទាមទារ របស់ ក្រុម ឧទ្ទាម អាចនឹង ត្រូវបាន ដាក់បញ្ចូល ទៅក្នុង របៀបវារៈ នៃ កិច្ចសន្ទនា ដែល នឹង ធ្វើឡើង ក្នុង ពេល ខាងមុខ នេះ ។
ផ្អែក លើ កត្តា មួយ ចំនួន ក្នុង រយៈពេល ៧ឆ្នាំ កន្លងមក នេះ សបញ្ជាក់ ថា ពលរដ្ឋ កម្ពុជា អាចនឹង ត្រូវ រង់ចាំ ច្បាប់ នេះ យូរ តទៅទៀត ។
ការសម្រេច ជុំវិញ បញ្ហា សមុទ្រ ចិន ខាងត្បូង ជា សេចក្តីសម្រេច ចុងក្រោយ
លោក អ៊ុំ សំអាន ត្រូវបាន បញ្ចូន ខ្លួន ទៅកាន់ តុលាការ ភ្លាម ៗ
វប៌្បធ ម សេដ្ឋកិច្ច នយោបាយ និង ពាណិជ្ជកម្ម ។
មាន មនុស្ស ជាង ៣០០ នាក់ បាន ស្លាប់ នៅក្នុង សោកនាដកម្ម នេ
សិស្សសាលា ឯកជន ត្រូវ ប្រឡង បាក់ឌុប នៅ ថ្ងៃទី ១៧ - ១៨ ខែសីហា
ផ្ញើ មតិ ស្ថាបនា សំគាល់ សញ្ញា ចាំបាច់ ត្រូវ បំពេញ ។
ឯកឧត្តម រដ្ឋមន្ត្រី បាន បញ្ជាក់ បន្ថែម ថា យន្តការ នៃ ការដោះស្រាយ ការប្រើប្រាស់ គ្រឿងញៀន ក្លាយជា កម្មវត្ថុ ចម្បង ក្នុង ការធ្វើ វិសោធនកម្ម ច្បាប់ នេះ ។
អែអង្គ ហ៊ីង បាន ឡើង ជា មហា អុបរាជ ។
ទៀត មិន អាច បង្ហោះ បាន ត្រូវបាន អ្នក និយម ប្រើប្រាស់ មាន ចម្ងល់ យ៉ាង ខ្លាំង ដោយ មិន ដឹង ថា មូលហេតុ អ្វី នោះ ទេ ។
ពួកគាត់ បៃានាំ សក្គឿង ច្ក្ក ។
ទើប ស្រលាញ់ គ្នា មិន ទាន់ បាន ជ្រៅជ្រះ យើង មិន គួរ លេង ដល់ ៗ
ពួក ជនរងគ្រោះ អ្នក មាន ៗ
ឥត ងាកចេញ ឡើយ ។
ករណី មិន មាន ការឯកភាព គ្នា ត្រូវ កសាង សំណុំរឿង ជូន តុលាការ ដើម្បី ដោះស្រាយ តាម ផ្លូវ ច្បាប់ ។
បង្គោល ភ្លើង រង ការខូចខាត ។
លោក វេង សា ខុន បាន គូសបញ្ជាក់ ថា ការប្រមូល ត្រី ប្រហុក នៅ ឆ្នាំ នេះ មាន ផល ល្អ ប្រសើរ ជាង ឆ្នាំ កន្លងទៅ ។
លោក ចោទ ថា សាលក្រម របស់ តុលាការ ខ្មែរ ជា សាលក្រមលំអៀង ស្ថិត នៅក្រោម គម្នាប និង មាន ចរិក នយោបាយ ដែល គេ ត្រូវតែ មាន ដំណោះស្រាយ តាម ផ្លូវ នយោបាយ ។
លោក ចាង ប៊ុន លាង ម្ចាស់ ហាង ប្រោន កាហ្វេ ។
សម្លាប់ ប្រជាពលរដ្ឋ ស្លូត ត្រង់ ត្រូវ ចាប់ យកមក កាត់ទោស !
ដោយ ការបោះឆ្នោត របស់ សហរដ្ឋ អាមេរិក កាន់តែ ខិត ជិត មកដល់ បញ្ហា សន្តិសុខ តាម ប្រព័ន្ធ អ៊ីនធឺណិត បាន ធ្វើឱ្យ អ្នកជំនាញ ក្នុង ផ្នែក នេះ និង អ្នកតាក់តែង ច្បាប់ មាន ការបារម្ភ ។
ទីបំផុត អង្គការ សុខភាព ពិភពលោក អនុញ្ញាតឱ្យ ប្រើប្រាស់ បន្ទាន់ វ៉ាក់សាំង របស់ ប្រទេស ចិន ហើយ
លោក យល់ ថា ប្រសិនបើ អាជ្ញាធរ ព្រម ដោះស្រាយ ជូន ពលរដ្ឋ គឺ វា អាចនឹង ប៉ះពាល់ ដល់ ផលប្រយោជន៍ របស់ ពួកគេ ៖
ចិន នឹង ទិញ យន្តហោះ ជាង ៧ពាន់ គ្រឿង ច្រើន ជាង អាមេរិក
យើង មាន ជំនឿ ជឿជាក់ ថា ជន ដែល រមឹល គុណ បុព្វបុរស ខ្លួន ពិតជា នឹង ទទួលរង នូវ បាបកម្ម ធ្ងន់ធ្ងរ និង ត្រូវ ទេព តាប រាមុខ ជា មិន ខាន ។
ខាត់ សុឃឹម ក្តៅក្រហាយ យ៉ាង ខ្លាំង ចំពោះ មួយ ក្រុម ដែល ចោទប្រកាន់ នាង លើ រឿង មួយ នេះ
ពួក អ្នកស្ម័គ្រចិត្ត ទាំងអស់ នេះ សុទ្ធតែ ត្រូវបាន ពិនិត្យ ធ្មេញ ។
ទៀត ទាក់ទិន នឹង ស្ថានភាព ថ្មី ៗ
លោក សម រង្ស៊ី ចោទប្រកាន់ រដ្ឋាភិបាល ថា …
ប៉ុន្តែ ពិធី ការិនី រូប នេះ ហាក់ដូចជា ប្រឡូក ក្នុង អាជីព នេះ ដូច ភ្នែក បន្ទោស ម្តង ចេញមុខ ម្តង បាត់ មិន ទៀងទាត់ ទេ ។
ពី បទ ចូលមក ធ្វើ ការងារ ដោយ គ្មាន ប័ណ្ណ អនុញ្ញាត ត្រឹមត្រូវ ។
គួរ បញ្ជាក់ ថា ការបោះឆ្នោត នឹង ត្រូវ បញ្ចប់ នៅ ម៉ោង ២២ ៖
ទោះបី ក្នុង រដូវ ក្តៅ ក៏ដោយ អ្នក ពុំ គួរ បរិភោគ អាហារ ត្រជាក់ នា ពេលព្រឹក ឱ្យ សោះ ។
អ៊ីចឹង នៅ ពេល ដែល ពួកគាត់ ក្លាយជា ថ្នាក់ដឹកនាំ សហជីព អ្នក ខ្លះ គាត់ ភ័យ ប្រឈម នឹង បញ្ហា ទាំងអស់ ហ្នឹង ។
ពួកគេ ជា មនុស្ស ដែល មាន កាយសម្បទាន មាំ មួន និង ពូកែ ខាង សេដ្ឋកិច្ច ។
បង ភ័ក្រ - អនុប្រធាន ស្ថានីយ
អាមេរិក ពង្រីក ទំនាក់ទំនង ពាណិជ្ជកម្ម ជាមួយ អាស៊ាន
សម្រាប់ បុរស ភាគ ច្រើន ក្រពេញ នេះ អាចនឹង រីក ធំ បានជា …
ការប្រកាន់ ភាព ហិង្សា វាយដំ ប្រពន្ធ ពីសំណាក់ បុរស ជា ប្តី គឺជា ភាពអគតិ ដែល មិន គប្បី ប្រព្រឹត្ត ឡើយ ៕
ពាក់ ពន្ធ័ នឹង ខ្លួន យើង នឹង ពិបាក ទៅ តាម នោះ ដូចគ្នា កុំ ថា ឡើយ តែ ការរកស៊ី សូម្បី ទំនាក់ទំនង ផ្សេង ទៀត ក៏ មិន ល្អ ដែរ ។
ស្លាកលេខ សម្គាល់ រថយន្ត តាម ស្ថាប័ន រដ្ឋ ទាំងអស់ មាន ដូចជា ៖
កុំ បារម្ភ ទោះ មាន ឬ គ្មាន អាការ ទាំង នេះ ក្រោយ ចាក់ វ៉ាក់សាំង ក៏ នៅតែ មាន ប្រសិទ្ធភាព ចំពោះ រាងកាយ
កុំ ភ្លេច បង្ហាញ អានុភាព អ្នក ជាមួយ ព្រឹត្តិការណ៍ ពេជ្ឈឃាដ កំណាច នេះ !
ហើយ ពិសេស នៅក្នុង រាជធានី ភ្នំពេញ តែម្តង ។
ជាទូទៅ យើង មិន អាច បង្ហាញ ពី តួលេខ នៃ ការលក់ ក្នុង ប្រទេស ណាមួយ ឬ នៅក្នុង តំបន់ ឡើយ ។
ម្យ៉ាងទៀត ការដកដង្ហើម វែង ៗ
នៅតែ មិន មាន ចម្លើយ ចំពោះ អ្វី ដែល បណ្តាលឱ្យ យន្តហោះ ដឹក អ្នកដំណើរ ពាណិជ្ជកម្ម ថ្មី បំផុត និង ទំនើប បំផុត របស់ ពិភពលោក នេះ ធ្លាក់ ។
បែប នេះ កម្ពុជា ត្រូវបាន កាសែត បរទេស ចាត់ទុក ថា ជា ទីក្រុង ឃាតកម្ម ប្រចាំ តំបន់ អាស៊ី ។
ទៀត ដោយ គ្មាន វត្តមាន គណបក្ស ប្រឆាំង នោះ មាន ន័យ ថា សភា មិន គ្រប់ លក្ខណៈ នោះ ទេ ។
ទៀត នៃ ប្រទេស រុស្ស៊ី នឹង នៅតែ បន្ត ផ្អាក ដំណើរការ ដដែល ដោយ ពុំ មាន ពេលវេលា កំណត់ នោះ ឡើយ ។
ឯ ម្តាយ ឪពុក អ្នក វិញ ត្រូវការ
ភិក្ខុ កើត សារ៉ាយ មាន ស្មារតី ល្អ ហើយ បន្ត ចិត្ត ជា អ្នកបួស ទោះ កំពុង ជាប់ ឃុំ
ទៅ ក៏ ក្លាយជា មិត្តភ័ក្តិ នឹង គ្នា ក៏ ជិះ ឡាន ជុំគ្នា ដោយ រថយន្ត មួយ មាន គ្នា ប្រមាណ ១០នាក់ ។
ហេតុ នេះ គេ ត្រូវតែ មាន សេចក្តី អំណត់ និង តាំងចិត្ត អនុវត្តន៍ ខ្ជាប់ខ្ជួន ទើប ទទួលបាន ផល ។
នេះ បើ យោង តាម របាយការណ៍ អង្កេត មួយ ធ្វើឡើង ដោយ គម្រោង យុត្តិធម៌ ពិភពលោក ដែល បាន ចេញផ្សាយ កាលពី ដើម ខែមិថុនា នេះ ។
របស់ អ្នក រួម មាន ដូចជា ៖
មនុស្ស មាន ល្បិច កល់ កប់ សែន ជ្រៅ
ជំនួយការគណនេយ្យ ចំនួន ០២ នាក់ បន្ទាន់ ម៉ោង ធ្វើការ ៖
គ្មាន ឈ្មោះ និយាយ ថា ៖
ពេលនេះ ជនសង្ស័យ ទាំង ៥ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន យក ទៅ សួរនាំ នៅ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ ។
ប្រើប្រាស់ ប្រអប់ ស្នោ អាច បណ្តាលឱ្យ កើត ជំងឺ មហារីក ដែរ ទេ ?
ខ្មែរ បាត់បង់ តន្ត្រី រ៉ុក ។
លោក ថា ឯកសារ ដែល រឹបអូស បាន ទាំងនោះ ត្រូវបាន បញ្ជូន ទៅ តុលាការ ហើយ ។
តាមរយៈ ការងារ និង ក្រមសីលធម៌ របស់ អ្នកសារព័ត៌មាន គាត់ ទទួលបាន ការជឿទុកចិត្ត ពី អ្នក ដែល កាន់ ព័ត៌មាន ដែល មិន ត្រូវ គេ ដឹង ឬ លាក់បាំង ។
មកពី គាត់ មិន ឱ្យ អាទិភាព ទៅ លើ ច្បាប់ ហ្នឹង ឬមួយ ក៏ ច្បាប់ ហ្នឹង វា អាច មាន ឥទ្ធិពល ទៅ លើ ការគ្រប់គ្រង រដ្ឋ ឬមួយ យ៉ាង ម៉ិច ?
គន្លឹះ ទាំងនោះ មាន ដូច ខាងក្រោម ៖
គ្នា ដោយ នា ពេល កន្លងមក ក៏ មាន ករណី លួច រត់ នេះ ជាញឹកញាប់ ផងដែរ ។
ប្រិយមិត្ត ខេធី ៤២ខាន ជូប គ្នា អស់ រយៈពេល ១១ ថ្ងៃ មក ហើយ យ៉ាងម៉េច ដែរ សុខសប្បាយ ជា ទេ ?
សមិទ្ធិ សូត្រ ទី២
ញៀន សិច ងាយ កើត រោគ ផ្លូវចិត្ត , ធ្វើ អត្តឃាត
ដែល មាន ប្រយោជន៏ ដល់ ការសិក្សា ស្រាវជ្រាវ របស់ សិស្សានុសិស្ស ក៏ ដូចជា បងប្អូន ជន រួម ជាតិ ទាំងអស់ ក្នុង ការសិក្សា បន្ថែម ដើម្បី ជា ប្រយោជន៏ ដល់ ការសាង ជីវភាព អោយ កាន់តែ ប្រសើរឡើង ។
ទើប មក ម្តង ដោយ ទុក កូន ឱ្យ នៅ ជាមួយ ជីដូន ក្រីក្រ ដូចគ្នា ។
អូស្ត្រាលី ការពារ គោល នយោបាយ អន្តោប្រវេសន៍ តឹង តែង របស់ ខ្លួន ក្នុង កិច្ចប្រជុំ អង្គការ សហ ប្រជាជាតិ
ដោយ លោក បញ្ជាក់ ថា លោក បាន លើក ពី ករណី ចាប់ខ្លួន មនុស្ស រើ ឡើងវិញ កាលពី ពេល ថ្មី ៗ
ខិត្តប័ណ្ណ បី រមៀល ទំនាក់ទំនង ឥឡូវនេះ
មាន ការសង្ស័យ ថា សង្គ្រាម អាចនឹង កើតឡើង ដោយ ចៀស មិន ផុត ។
បន្ទប់ ទទួលទាន ០១
ផ្អាក ការផ្គត់ផ្គង់ ទឹក នៅ ផ្លូវ ជាតិ លេខ ៤អ្នក ខណ្ឌ ពោធិ៍សែនជ័យ
ក្រោយពី ការដាក់ ញត្តិ ទៅ ស្ថាប័ន រដ្ឋ សំខាន់ ៗ
លោក គួច ចំរើន បាន បង្ហាញ ការប្តេជ្ញាចិត្ត ថា …
បឹង កេត វិសាខា និង ប៉ូលិស រក បាន ៣ពិន្ទុ ដូចគ្នា
ដោយសារ ថា លោក ទាំង ពីរ ជួបគ្នា ហើយ នោះ ខ្ញុំ ក៏ សូម រំព្ញក រឿង ដើម បន្តិច ប៉ុន្តែ ក៏ មិន មែន ក្នុង ន័យ ចង់ បន្តុះបង្អាប់ អ្នកនយោបាយ ខ្មែរ ណា ម្នាក់ ឡើយ ។
ស្វាយ ម្រេច ក្រូច
ង ការិយាល័យ ធម្មការ និង សាសនា សក
ការអស់កម្លាំង គឺជា រឿង មួយ ដែល កើតឡើង ជាមួយ អ្នក នៅពេល មាន បញ្ហា ច្រើន នៅលើ ប្លោក នោម ពេក ។
រំលោភ នារី ម្នាក់ មិន បាន សម្រេច វាយ ស្លាប់ នៅ ស្រុក ភ្នំព្រឹក
សង្គម ស៊ីវិល ធ្វើ ការ ផ្នែក ការពារ ជន ពិការ មើលឃើញ ថា កន្លងមក ពេល បោះឆ្នោត ម្តង ៗ
២២៨ គយគន់ នារី អេស៊ីលីដា
នៅលើ ហ្វេសប៊ុក ។
នៅ ព្រឹក នេះ យន្តហោះ ចម្បាំង ចំនួន ២ត្រូវបាន ហោះ ចេញ ពី មូលដ្ឋាន ផ្សេង ៗ
ហើយ បើ នៅក្នុង បន្ទប់ ឧស្សាហ៍ មាន ដី ហុយ ខ្លាំង យើង ត្រូវ ប្តូរ មួយ សប្តាហ៍ បី ដង ។
កាលពី មុន នេះ ២ ឆ្នាំ រូបថត អាក្រាត មួយចំនួន ដែល ត្រូវបាន គេ ជឿ ថា ជា
បុរស មួយចំនួន បាន ប្រាប់ អោយ ដឹង ថា ក្រោយពេល វះកាត់ រួច ពួកគេ នៅតែ អាច រួមភេទ បាន ដដែល ។
ឯកឧត្តម រស់រ៉េន
រ៉េ បើ ចឹង ខ្ញុំបាទ ខ្ញុំម្ចាស់ នឹង ឆ្លៀត ចូលមក សប្បាយ ទី ឋាន ដូសិត នេះ ឱ្យ បាន
ការប្រមូលផ្តុំ នេះ ត្រូវបាន រឹតបន្តឹង មិន ឱ្យ មាន ការហែ ក្បួន ដោយ អាជ្ញាធរ ក្រុង ភ្នំពេញ ។
ប្រភព ដដែល បន្ត ថា មូលហេតុ កំពុង ស្រាវជ្រាវ ។
អាការៈ ទាំងនេះ ហើយ ដែល គិត ថា អ្នក អាច មាន ជំងឺ ខ្សោយ បេះដូង រស្មី កម្ពុជា
មួន ម៉ារ៉ា ថា ប្រពន្ធ ចូលចិត្ត ស្តាយ៍ អឺរ៉ុប
១៤ - ផលិតផល ថ្មី គឺ មាន លក្ខណៈ ថ្មី ក្នុង បែប ណាមួយ ពាក់ព័ន្ធ នឹង ក្រុមហ៊ុន មាន ដូចជា ៖
លោក ហ៊ុន សែន បន្ថែម ថា កងកម្លាំង ទាំងអស់ ត្រូវតែ ការពា រដ្ឋាភិបាល មិន មែន ការ បក្ស ប្រឆាំង ទេ ។
ទៀត ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ ជាក់ស្តែង របស់ កម្ពុជា ដែល កំពុងតែ អភិវឌ្ឍន៍ ទៅ មុខ ឥត ឈប់ឈរ ។
កម្ទេច ប្លាស្ទិក តូច ៗ
ចលនា នេះ កើត មាន ឡើង គួរឱ្យ កត់សម្គាល់ នៅ តាម ទីក្រុង ប៉ុន្តែ មិន សូវ មាន សកម្មភាព នៅ តាម ទី ជនបទ ឡើយ ។
តើ ផល ប៉ះពាល់ ជាទូទៅ នៃ ថ្នាំ បំបាត់ ការឈឺចាប់ មិន មែន ជា ស្តេរ៉ូអ៊ីត មាន អ្វី ខ្លះ ?
ល្បែង ល្អ បំផុត ព្រមទាំង មាន របៀប លេង ជាច្រើន ហាង ក៏ ខ្ពស់ ។
ពិធី ប្រកាស បើក ការប្រកួត បាល់ទាត់ ដណ្តើម ពានរង្វាន់ ឯកឧត្តម វង សូត ឆ្នាំ ២០១៩
តិច និង ច្រើន ទាំង១០ របស់ ប្រជាជន ជប៉ុន និង ផ្សេង ទៀត
នាង ធី សុវណ្ណ ថា នេះ ពិតជា ជន បង្កប់ របស់ គណបក្ស ប្រជាជន មែន ។
លោក ហ៊ុន សែន បាន ឱ្យដឹង ថា ការដំឡើង ប្រាក់ខែ របស់ គ្រូបង្រៀន គឺជា ការងារ បន្ត ធ្វើ បន្តិច ម្តង ៗ
បទ ភាជនីយ និយាយ អំពី ពទ្ធច ក្ក១៥
ប៉ុន្តែ ស្ថានទូត កូរ៉េ ខាងជើង ប្រចាំ ប្រទេស ម៉ាឡេស៊ី បាន សំដែង ការក្រោធ ខឹង យ៉ាង ខ្លាំង ទៅនឹង ការអះអាង របស់ អាជ្ញាធរ ម៉ាឡេស៊ី ។
មន្ត្រី ចាប់តាំងពី ថ្នាក់ អភិបាល ទៅដល់ ប្រធាន សង្កាត់ ត្រូវបាន ប្រាប់ ឱ្យ ផ្តោត ជាពិសេស លើ ការ…
សុវត្ថិភាព និង សុខភាព ក្នុង ការងារ សហជីព
លោក ហ៊ុន សែន នឹង ផ្តល់ មេដាយ មាស ឱ្យ និស្សិត វាស់ ដី
រឿង ទី ៥ទឹកចិត្ត ម្តាយ សម័យ ថ្មី ផលិត ក្នុង ឆ្នាំ ២០១៥
អង្កេត អំពី ប្រធាន អង្គភាព នេះ ។
ដូច្នេះ គួរ កុំ រវល់ តែ គិត ថា អ្វី ដែល ខ្លួន ធ្វើ ទៅ នោះ វា ធ្វើឱ្យ ស្ត្រី ជា ដៃគូ ពេញចិត្ត ឱ្យ សោះ ពីព្រោះ បញ្ហា អស់ ទាំងនេះ ជួនកាល ស្ត្រី ជា ដៃគូ មិន ហ៊ាន ស្រដី ប្រាប់ ត្រង់ ៗ
ម៉ៅ សុចាន់ ធីនឹង បញ្ចប់ បណ្តឹង មុន ទៅ អាមេរិក
មូលហេតុ ចំបង នៃ គោលការណ៍ ណែនាំ របប អាហារ នេះ គឺ ដើម្បីៈ -
គ្នា ចំនួន ប្រាំពីរ ប្រភេទ ។
ចិន ជា សម្ពន្ធមិត្ត ដ៏ ធំ តែ មួយ គត់ របស់ រដ្ឋាភិបាល ក្រុង ព្យុងយ៉ាង និង ក៏ ជា ដៃគូ ពាណិជ្ជកម្ម ធំ បំផុត របស់ ខ្លួន ផងដែរ ។
ដែល អ្នក ធ្វើ ហើយ មិន ទទួលបាន ជោគជ័យ ។
ជាមួយនឹង ការចូល ប្រជុំ សភា លោក កឹម សុខា ក៏ មាន គំរោង ជួបពិភាក្សា ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ផងដែរ ៕
ភាពឈ្លាសវៃ គឺ ចង់ឱ្យ អ្នក ដឹង កាលៈទេសៈ ឆាប់ យល់ ឆាប់ ចាប់ បាន ពី អ្វី ដែល គេ និយាយ ។
លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង គោរព ថ្លែងអំណរគុណ ឯកឧត្តម ហ៊ុន ម៉ានី
តាម ផែនការ ក្នុង រយៈពេល បំពេញ ទស្សនកិច្ច នៅ
រាល់ ថ្ងៃ ផ្ទះ វីឡា រថយន្ត ស៊ីរ៊ី ទំនើប ៗ
ចំនួន អ្នក ផ្ទុក កើនឡើង ដល់ ៥១ នាក់ ដោយ មិន ទាន់ រាប់ ទាំង មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការបរទេស
កម្មករ ប្រមូល សំរាម ម្នាក់ ត្រូវ គោយន្ត កន្ត្រៃ ក្រឡាប់ សង្កត់ បណ្តាលឱ្យ ស្លាប់
បង្ក្រាប យ៉ាងណា ក៏ នៅតែ មាន មិន ឈប់ ជាក់ស្តែង ដូច ករណី នេះ ចឹង
ប៉ុន្តែ ចំពោះ មេដឹកនាំ របប សព្វ ថ្ងៃ នេះ វិញ មិន ឈឺ ក្បាល នឹង ការព្រួយបារម្ភ ទាំងនេះ ទេ ។
ប៉ុន្តែ នៅ ជប៉ុន ខុសប្លែក ពី នេះ ។
លោក បាន ឱ្យដឹង ទៀត ថា ទោះជា យ៉ាងណា ក៏ដោយ លិខិត បទដ្ឋាន នានា ក្នុង កិច្ចព្រមព្រៀង គ្រាន់តែ ជា ក្របខ័ណ្ឌ ច្បាប់ ដើម្បី ផ្តល់ លទ្ធភាព ឱ្យ សហគមន៍ ព្រៃឈើ រៀបចំ ដំណើរការតែ ប៉ុណ្ណោះ ។
គ្រប់គ្រង អស់ មួយ ផ្នែក ធំ
សេចក្តីជូនដំណឹង បាន ឱ្យដឹង ទៀត ថា នៅ ទីតាំង មណ្ឌល ផ្តល់ សេវា សាធារណៈ របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ទាំងអស់ ត្រូវ ផ្អាក ដំណើរការប្រឡង យក ប័ណ្ណ បើកបរ យានយន្ត រយៈពេល ១៥ ថ្ងៃ ដោយ គិត ចាប់តាំងពី ថ្ងៃទី ១ដល់ ថ្ងៃទី ១៥ ខែធ្នូ ឆ្នាំ ២០២០ ។
បន្ត ការគ្រប់គ្រង ត្រួតពិនិត្យ ជន បរទេស គ្រប់ ប្រភេទ ចូល - ចេញ ស្នាក់ ធ្វើ ការងារ ប្រកប អាជីវកម្ម ផ្សេង ៗ
ណែនាំ បណ្ឌិត តែង ដឹកនាំ អ្នកដទៃ ទៅកាន់ សេចក្តី ចម្រើន ។
ពត៌មាន ប្រចាំ ថ្ងៃចម មែនិង ជូត ខែ៨ នេះ ខ្វះ ជាង គេ គឺ ឃ្លាំង ទុក ទ្រព្យ តែ ម្តង
តាមពិត ទៅ ពីក្រោយ លេខ ២៨០ នេះ មាន រឿង គួរឱ្យ ចាប់អារម្ម …
សរសេរ អត្ថបទ ព័ត៌មាន សិល្បៈ យ៉ាងហោចណាស់ មួយ ក្នុង មួយ ថ្ងៃ ។
លោក បាន មានប្រសាសន៍ ទៀត ថា យើង ទើបតែ ទទួលបាន ព័ត៌មាន ផ្តល់ មកវិញ នេះ ហើយ ខ្ញុំ មាន បំណង ដោះស្រាយ ចំណុច ដែល នៅ សេសសល់ ដ៏ សំខាន់ នេះ នៅ ពីរ បី ថ្ងៃ ខាងមុខ ។
បើ ជា អំពើពុករលួយ តើ ជា ប្រព័ន្ធ ឫកេងបន្លំ ជា ប្រយោជន៍ ផ្ទាល់ខ្លួន ?
ជាក់ស្តែង នៅ ពេល ដែល យើង ព្យាបាល ទៅ លើ បញ្ហា ក្នុង ការនិយាយ ប្រជាជន ចង់ ប្រើប្រាស់ ភាសា ដែល ពួកគាត់ ធ្លាប់ និយាយ ។
ព្រះមហេសី របស់ ព្រះអង្គ ដែល ឯកសារ នានា រៀបរាប់ ច្រើន បំផុត គឺ អ្នក ម្នាង អង្គ ប៉ែន ឬ ព្រះបរម រាជ នី ប៉ែន ត្រូវ យួន សំលាប់ ដោយ ពន្លិច ទឹក នៅ ពេល ដែល យួន បាន ឃុំឃាំង បុត្រី ទាំង៤ របស់ ព្រះអង្គ ច័ន្ទ ចោទ ថា ក្បត់ ដោយសារ ព្រះមាតា របស់ ព្រះនាង បាន ទៅ ប្តឹង ស្តេច សៀម ជា បុត្រី ច្បង របស់ ព្រះអង្គ ច័ន្ទ ដែល ជា ព្រះរាម បង ប្រុស របស់ ព្រះអង្គ ។
ប៉ុន្តែ ទោះជា ពេល ដែល យើង មិន អាច មើល ទ្រង់ ឃើញ ហើយ ទោះបីជា ពេល ដែល យើង បរាជ័យ នៅក្នុង ការស្តាប់ បង្គាប់ ទ្រង់ ក៏ដោយ ក៏ យើង នៅតែ អាច អធិស្ឋាន បែប នេះ បាន ដែរ ថា ៖
ដូច្នេះ លោក ស៊ី ជីន ភីង តែងតែ ចងចាំ ដំបូន្មាន របស់ ម្តាយ ក្នុង ការបំពេញ កាតព្វកិច្ច របស់ ខ្លួន ។
មនុស្ស ជាច្រើន រងចាំ រហូតដល់ ពេល មួយ ដែល ពួកគេ ត្រូវ ចាកចេញ ពី ការងារ ឬ ស្ថាប័ន …
នេះ នាង ខ្ញុង បាន ថែមទាំង បង្កើត មុខរបរ ថ្មី គឺ ទទួល ធ្វើ ម្ហូប ការ ដែល ពេលនេះ កំពុង ទទួលបាន ការគាំទ្រ យ៉ាង ច្រើន ពីសំណាក់ អតិថិជន នានា ។
រួម ជាមួយនិង ការជូនពរ អោយ ភិន សុដាលី ស និង កូនស្រី មាន សុខភាពល្អ ។
នោះ ជា ការជួបជុំគ្នា ដែល ខ្ញុំ កំពុង ទន្ទឹងរង់ចាំ !
ឯកឧត្តម គួច ចំរើន អភិបាល នៃ គណៈអភិបាល ខេត្ត ព្រះសីហនុ ។
អ្នក សរសេរ ប្លក ជាច្រើន ចូលចិត្ត ប្រើ វីដេអូ ខ្លី ៗ
ប៊ូត សង្ឃឹម ទទួលបាន ឱកាស ប្រកួត ជាថ្មី
វា គឺជា ការព្យាបាល ដោយ មិន ឆ្លងកាត់ ការវះកាត់ និង មិន ប្រើ ឱសថ ។
ហេតុការណ៍ រថភ្លើង បុក គ្នា បែប នេះ ប្រទេស ស្វ៊ីស ធ្លាប់ ស្គាល់ ច្រើន លើក មក ហើយ ។
