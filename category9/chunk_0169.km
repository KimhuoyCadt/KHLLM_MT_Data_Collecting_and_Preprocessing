កម្មវិធី នេះ នឹង ត្រូវបាន ប្រារព្ធ ឡើង ក្នុង ខែមិថុនា ខាងមុខ នេះ ហើយ នឹង រួម មាន ការតាំងពិពណ៌ បច្ចេកវិទ្យា និង ការផ្គូរ ផ្គង អាជីវកម្ម ផងដែរ ។
នេះ នឹង នាំឱ្យ អ្នកដឹង នូវ ចំណុច ដូច ខាងក្រោម ៖
អ្នកស្រី បន្ថែម ថា ក្នុង ករណី នីមួយ ៗ
ចិន គាំទ្រ តែ កូរ៉េ ខាងត្បូង និង អាមេរិក រង់ចាំ មើល
មាន បញ្ហា ក្អក ជាប្រចាំ ឬ បញ្ហា បំពង់ ក
ប្រមុខ សិទ្ធិ មនុស្ស របស់ អង្គការ សហ ប្រជាជាតិ កាលពី ថ្ងៃសុក្រ បាន អំពាវនាវ ឱ្យ មាន ការស៊ើបអង្កេត អន្តរជាតិ មួយ …
នៅ ប្រទេស កម្ពុជា ប៉ុន្តែ គេ កម្រ ឃើញ មាន ពាក្យបណ្តឹង ទាក់ទង ជាមួយ ការទិញ ដូរ តំណែង នេះ ជា ផ្លូវការ ណាស់ ៕
សត្វ ទាំងនេះ អាចនឹង ផ្តល់ ភាពពិបាក ខ្លាំង ណាស់ ក្នុង ការកំចាត់ វា បើ ទោះបីជា ផ្ទះ របស់ អ្នក តែងតែ សម្អាត បាន យ៉ាង ស្អាត ក៏ដោយ ។
ឈរ នៅ ពីក្រោយ ការភ័យខ្លាច នៃ ការបរាជ័យ ដើម្បី ទទួលបាន លិង្គ ឡើង រឹង វា គឺជា ការថប់ អារម្មណ៍ ដ៏ សំខាន់ មួយ ដែល មាន ន័យ ថា ខ្លាច មិន ទទួលយក ។
ព្រះនាង មាន រូប ឆោមលោម ពណ៌ ស្អាត ល្អ ណាស់
លោក ស្ថាបនា និង លោក អ្នកលេង ខ្ញុំ យល់ស្រប អ្វី ដែល លោក ទាំង ពីរ បាន លើកឡើង លោក និយាយ ពិតជា ត្រូវ និង ការពិត ។
សង្គ្រាម នៅ ស៊ីរី បាន មើលឃើញ ការប្រើប្រាស់ ដ្រូន ដ៏ ច្រើន សម្បើម ជា លើក ដំបូង នៅក្នុង ការវាយប្រហារ ធំ មួយ ក្នុង គោលបំណង រំខាន ខែល ការពារ អាកាស ។
កញ្ញា ថា បាន ដឹង រឿង ឪពុក ឈឺ ធ្ងន់ ទើបតែ ប៉ុន្មាន ថ្ងៃ មុន ប៉ុណ្ណោះ គឺ ដឹង ក្នុង ពេល ដែល លោក មាន សភាព ធ្ងន់ធ្ងរ តែ ហើយ ។
នៅក្នុង នគរ វិញ គឺ មាន សន្តិភាព បរិបូរណ៍ គ្មាន ការ ងើប បះបោរ គឺ សូម្បីតែ ក្រុម សេសសល់ របស់ ស្តេច កន ក៏ មិន ងើប ឡើង ដែរ ។
លោក មុនី បាន រំឭក ថា ក្រោយពី លោក ចាប់ផ្តើម លក់ ម៉ាំ ល្ហុង កាលពី ឆ្នាំ មុន អតិថិជន តែងតែ សំណូមពរ ឱ្យ លោក ច្រៀង តែ លោក មិន អាច ច្រៀង បទចម្រៀង អស់ នោះ ទេ ។
បក្ស កុម្មុយនីស្ត បញ្ចប់ សមាជ បក្ស នៅ ថ្ងៃ នេះ
លោក នីចរិយា ប្រធាន ផ្នែក ស៊ើបអង្កេត នៃ សមាគម ការពារ សិទ្ធិ មនុស្ស អាដហុក បាន មានប្រសាសន៍ ថា ៖
ប្រជាពលរដ្ឋ កម្ពុជា ប្រមាណ តែ ២០ ភាគរយ ប៉ុណ្ណោះ ដែល មាន គណនី ធនាគារ ឫប័ណ្ណ ឥណទាន ។
អ្នកនាង កាតុ ស្រក់ ទឹកភ្នែក ពេល គេ ថា យក ប្តី អ្នកក្រ…
ដូច្នេះ ក្នុង ច្បាប់ បើសិនជា ភាព មិន ប្រក្រតី ហ្នឹង ធ្ងន់ធ្ងរ អត់ ទទួលយក បាន នោះ រដ្ឋសភា ហ្នឹង គឺ ដូចជា អត់ មាន អញ្ចឹង ។
រដ្ឋាភិបាល បាន បង្កើត ឱ្យ មាន ការតាំងពិព័រណ៍ មួយ ដើម្បី រំឭក អំពី អំពី គុក នេះ ។
លោក ប្រធាន មន្ទីរ បញ្ជាក់ ទៀត ថា ការហូរ ចូលក្នុង ទឹក ស្ទឹង នូវ សារធាតុ ពុល នេះ ដោយសារតែ មាន ភ្លៀង ធ្លាក់ ខ្លាំង ២ ថ្ងៃ ជាប់ ៗ
មាន បញ្ជា និង ចេញ កម្លាំង ២៥ នាក់ បន្ថែម តាម ស្វែងរក មនុស្ស កំពុង បាត់ខ្លួន
នៅពេល ភាព មិន ប្រក្រតី នៃ ឥវ៉ាន់ កើតឡើង យើង តែងតែ ខិតខំ អស់ ពី សមត្ថភាព ដើម្បី ជួយ អ្នក
អាជ្ញាធរ ខេត្ត ស្រះកែវ បញ្ជូន ខ្លួន ពលរដ្ឋ ខ្មែរ ៧នាក់ …
ក្រៅពី បង្ហាញ ចំនួន កើនឡើង នៃ អ្នកជំងឺ ទៅ រក សេវា ព្យាបាល ជំងឺ នៅក្នុង មន្ទីរពេទ្យ នេះ ។
ចិន គឺជា ប្រទេស មួយ ដែល មាន ប្រវត្តិសាស្ត្រ ជាង ៥ ពាន់ ឆ្នាំ ហើយនិង ក៏ ជា ប្រទេស ដែល មាន វប៌្បធម និង អរិយធម៌ ដ៏ រុងរឿង ។
ហើយក៏ រហូតមកដល់ ពេលនេះ ដែរ មេធាវី ការពារ ក្តី របស់ លោក បន្ត ដាក់ពាក្យ សុំ ឱ្យ លោក បាន នៅ ក្រៅ ឃុំ ។
សំរាប់ អភិវឌ្ឍន៍ ធនធាន មនុស្ស ក្នុង ជួរ កងកម្លាំង នគរបាល ជាតិ ។
ខ្លាំងក្លា ជាង នរណា ៗ
ត្បួុងឃ្មុំ ដីឡូតិ៍ រងចាំ បងប្អូន មក ធ្វើជា ម្ចាស់
ពួកគេ ថា ការដំឡើង ប្រាក់ ឈ្នួល ដែល នៅ មាន ចំនួន តិច នេះ គឺជា ផ្នែក មួយ នៃ ការ មិន អាច ធ្វើឱ្យ មាន ការបង្កើន ផលិតភាព កាន់តែ ច្រើន ទៅ វិញ ។
មិន ត្រឹមតែ ប៉ុណ្ណោះ ក្រៅពី ការធ្វើ បទបង្ហាញ និង ការពិភាក្សា លើ ប្រធានបទ ផ្សេង ៗ
ពលរដ្ឋ មាន ការសង្ស័យ ថា ក្រុម អ្នកដឹក ឈើ ទាំង នេះ អាច មាន វិជ្ជាមន្តអាគមន៍ ចេះ កំបាំង កាយ ពី សមត កិច្ច ៕
ករណី នេះ អ្នកបើកបរ ម៉ូតូ ម្ខាង ទៀត បាន បើក គេច ទៅ បាត់ ។
ពោលគឺ ទំហ៊ុំ ពាណិជ្ជកម្ម បាន លើស ពី ៦០ ពាន់ លាន ដុល្លារ ។
ទិវា ពិភពលោក នៃ អ្នកបរិច្ចាគ ឈាម ដែល ប្រារព្ធ នៅ ថ្ងៃទី ១៤ ខែមិថុនា ជា ខួប លើក ទី ១២ ដើម្បី ថ្លែងអំណរគុណ និង លើកទឹកចិត្ត ដល់ អ្នក ដែល បាន ស្ម័គ្រចិត្ត ផ្តល់ ឈាម ។
ី្លៃថ្នូរ អាកប្បកិរិយាប
ក្រុម អ្នកស្រាវជ្រាវ ថ្មី ៗ
អ្នកទិញ និង ក្រុមហ៊ុន ពាក់ព័ន្ធ ជាច្រើន ទៀត ។
ទារក ទើបនឹង កើត ត្រូវបាន សង្គ្រោះ ចេញ ពី ក្នុង ទុយោ បង្គន់
ជាក់ស្តែង បើ មើល ពី ជម្លោះ រវាង លោក នាយក រដ្ឋមន្ត្រី និង
ខ្ញុំបាទ និង អង្គរក្ស សូម អំពាវនាវ ដល់ សម្តេច នាយក រដ្ឋមន្ត្រី សូម មេត្តា ជួយ រក យុត្តិធម៌ ឱ្យ យើងខ្ញុំ ទាំងអស់ គ្នា ផង ។
ការដឹកជញ្ជូន អាច ធ្វើ តាមរយៈ កប៉ាល់ សមុទ្រ ។
ខ្ញុំ ចង់ឱ្យ លោក បញ្ជាក់ ត្រង់ ចំណុច នេះ ប្រកបដោយ ភាពស្មោះត្រង់ ប្រាប់ ទៅ ប្រជាពលរដ្ឋ កម្ពុជា ថា តើ នេះ ជា ការពិត ដែរ ឬ ទេ ?
ស្ត្រី សម្រស់ តារាង ពេលវេលា នៃ ការហាត់ប្រាណ ដែល ធ្វើឱ្យ អ្នក ស្គម
ប្រទេស នូវេសាឡង់ ៖
កម្ពុជា ថៃ ខេត្ត ជាប់ ព្រំដែន គ្នា បង្កើន ទំនាក់ទំនង ទេ …
អ្នកចាត់ការសញ្ជាតិ អាល្លឺម៉ង់ ឆ្លើយ ទាំង មិន ស្ទាក់ស្ទើរ ថា ៖
គេ បាន បន្ត ទៀត ថា ឥឡូវនេះ ម្ចាស់ កុងត្រូល ជជុះ ទាំងនោះ បាន ធ្វើ សកម្មភាព យក លុយ ទាំងអស់ ពីសំណាក់ រថយន្ត តូច ៗ
នេះ បើ យោង តាម អ្នកជំនាញ ខាង ចំណាកស្រុក និង មីក្រូ ហិរញ្ញវត្ថុ ។
សិស្ស គ្រប់ គ្នា គោរព វិន័យ សាលា បាន ល្អ នោះ សង្គម នឹង ពោរពេញ ដោយ ភាពថ្លៃថ្នូរ
ដោយ ព្យាយាម រំឭក ពេល ធ្វើដំណើរ ខណៈ ភ្លឹក នោះ លោក តា មុត ប៊ាន បាន មានប្រសាសន៍ ថា ៖
ដោយឡែក នៅក្នុង ថ្ងៃសៅរ៍ នេះ តើ កម្មវីធី ពេញចិត្ត ឬ អត់ ?
លោក វេជ្ជបណ្ឌិត ជ្រួញ ចិញ្ចើម បង្ហាញ អាការៈ អល់ អែក គាត់ ពោល យឺត ៗ
លើក នេះ សង្ឃឹម ថា ក្រុម ជម្រើសជាតិ កម្ពុជា អាច យកឈ្នះ ក្រុម ជម្រើសជាតិ ទីម័រ ខាងកើត ជា បន្ត ទៀត ។
អ្នក អាច ម្រេច ក្តីសុបិន បាន កាលណា អ្នក ឈប់ គិត រវើរវាយ ខ្លាំង ពេក ហើយ ងាក មក ផ្តោត លើ ទង្វើ ឱ្យ បាន ច្រើន ប្រសើរ ៕
រកឃើញ សរុប អ្នក ផ្ទុក ១២នាក់ មាន ទាំង កីឡាករ និង ក្រុម បុគ្គលិក ។
ចាប់ផ្តើម រៀបចំ អនាគត របស់ លោក អ្នក ជាមួយ គណនី បញ្ញើ សន្សំ របស់ ធនាគារ ស្ថាបនា ។
ការឈប់ សម្រាក ក្រៅ ផ្លូវការ នេះ អាចនឹង បន្ត រហូតដល់ ថ្ងៃចន្ទ ទី១៩ ខែកុម្ភៈ ឆ្នាំ ២០១៨ ៕
មិន ត្រូវ សម្លាប់ ជនជាតិ អ៊ីស្រាអែល ណា ម្នាក់ ក្នុង ថ្ងៃ នេះ ឡើយ ដ្បិត ខ្ញុំ ដឹង ច្បាស់ ថា ខ្ញុំ ពិតជា ស្តេច លើ ប្រជាជន អ៊ីស្រាអែល វិញ ហើយ !
បាន ធ្វើ នៅក្នុង វេទិកា មួយ នៅ ខេត្ត កំពត ដែល លោកស្រី យល់ ថា ប៉ះពាល់
ស្ត្រី រូប នេះ បាន រៀបការ អស់ រយៈពេល ១១ឆ្នាំ មកហើយ តែ ពុំ មាន កូន ចៅ មួយ គ្រាប់ សោះ ។
នៅ មុន នេះ បន្តិច អ្នកនាង យុគ ចិន្តា បង្ហោះ សារ លើ ហ្វេសប៊ុក ពី រឿង លោក អ៊ិត សេដ្ឋា …
ប៊ូហ្វេ សាច់ អាំង និង ស៊ុប ហូប មួយ ចម្អែត នឹង បើក ឆាប់ ៗ
លោក បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា ខ្ញុំ បាន បញ្ជាក់ ហើយ ថា ពួកគាត់ មិន មែន ឯកោ ទេ ។
នៅលើ បណ្តាញ សង្គម ឈ្លោះ ចុះ ព្រោះ ដើម្បី ចង់បាន ផលចំណេញ រៀង ៗ
លោក ភូឡែត្តា ជំនួយការ នាយក សាខា
តារាង បំលែង សង្ខេប ហិចតូ ម៉ែត្រ ទៅ សង់ទីម៉ែត្រ
ការញ៉ាំ រក ប្រភព កន្លែងណា ដែល ទុកចិត្ត ។
រំលង បាន ១ ឆ្នាំ បទ ភ្ជុំ បិណ្ឌ នឹក ស្រុក របស់ ម៉ៅ ហាជី ត្រូវបាន អ្នកលេង បណ្តាញ សង្គម ស៊ែរត ៗ
យើង នឹង បន្ត តវ៉ា រហូត ទទួលបាន ដំណោះស្រាយ សមរម្យ មួយ ។
លោក បាន បន្ថែម ថា សកម្មភាព នោះ គឺ ខុសឆ្គង កាលពី ពេល នោះ ហើយ ថ្ងៃ នេះ នៅតែ ខុសឆ្គង ។
នេះ ក្រោយពេល លេចឮ ថា កំពុង ភ្ជាប់ ស្នេហ៍ ជាមួយ ប្រុស កូរ៉េ ស្រាប់តែ មាន ព័ត៌មាន ថា នាង មាន ទំនាក់ទំនង ស្នេហ៍ ជាមួយ ប្រុស ក្មេង ម្នាក់ ឈ្មោះ សុធា ពិសិដ្ឋ ។
អ្នក ទាំងអស់ គ្នា ប្រាកដជា ស្គាល់ កម្មវិធី កាត់ត រូបភាព ដ៏ ពេញនិយម មួយ នេះ ដែរ មាន មនុស្ស ដ រាប់ លាន អ្នក កុំ ពុង ប្រើប្រាស់ នូវ កម្មវិធី នេះ កម្មវិធី
លោក បន្ត ទៀត ថា ប្រសិនបើ មិន បាន ស្រាវជ្រាវ អាច មាន ករណី ម្ចាស់ ផ្ទះ នោះ ជាប់ បំណុល ធនាគារ ឬ យក ផ្ទះ នោះ ទៅ បញ្ចាំ ហើយ ប្រកាស លក់ ទៀត ។
នេះ ដើម្បី ជួយ ផ្សព្វផ្សាយ ការអប់រំ លើកកម្ពស់ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ នៅ តាម បណ្តា ខេត្ត ។
លោក មាស ប៉េង សកម្មជន គណបក្ស សម រង្ស៊ី ត្រូវ ចាប់ខ្លួន កាលពី ថ្ងៃ ម្សិលមិញ
បីតិ គឺ សេចក្តីឆ្អែត ចិត្ត
បក្សពួក និយម សូកប៉ាន់ ជាដើម !
ទាំងអស់ រស់ និង គោរព តាម សាសនា នានា ដែល គេ ជឿជាក់ ដោយ សេរី តាម មនសិការ និង ជំនឿ របស់ ពួកគេ ។
របស់ អតិថិជន ដែល បាន ទទួល ការអនុមតិ ពី ធនាគារ
គឺ នៅក្នុង ភូមិ រំដួល នេះ ហើយ ដែល កងទ័ព ទាំងអស់ បាន រៀបចំ ពិធី ជប់លៀង មួយ ដើម្បី អបអរសាទរ នូវ ជ័យ ជំនះ លើ ព្រះនាង ដោយ ស្តេច ព្រាន ព្រៃ របស់ គេ ។
ការបែងចែក ប្រភេទ ដី
មនុស្ស ចំនួន ៧នាក់ បាន ស្លាប់ ដោយសារ ករណី ពុល ស្រា នៅ ស្រុក ឈូក ខេត្ត កំពត កាលពី ថ្ងៃទី ២៧ដល់ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២១ ។
មុន នេះ បន្តិច រដ្ឋសភា អនុម័ត វិសោធនកម្ម ច្បាប់ ស្តីពី គណបក្ស នយោបាយ ហើយ
បេមនុស ឱប ពឹតិល
ខ្ញុំ ជឿជាក់ ថា យើង អាច ទទួលបាន អត្ថប្រយោជន៍ ពី ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ នេះ ។
ទោះជា យ៉ាង នេះ ក្រុម អ្នកស្រាវជ្រាវ និយាយ ថា ការងារ ប្តូរ វេន គឺ រឹតតែ បង្កើន ភាពចុះ អន់ថយ នេះ ទ្វេ ដង ។
ចិត្ត របស់ លោក រលត់ បាន ជាមួយនឹង សំយោជន១០ ?
បន្ទប់ ស្ថានការណ៍ បោះឆ្នោត វាយតម្លៃ ថា ការបោះឆ្នោត ល្អ ជាង មុន
ប៉ុន្តែ ចូរ កុំ ឱ្យ គិត ថា វិធីសាស្ត្រ សំខាន់ ជាង ព្រះបន្ទូល ដ៏ ជា ដំណឹង ល្អ ដែល ព្រះអង្គ បាន ប្រទាន មក ឱ្យ យើង នោះ ឡើយ ។
គុណ ប្រយោជន៍ ជាច្រើន ដែល ស្មាន មិន ដល់ របស់ ទឹក ប្រទាល កន្ទុយ ក្រពើ
ទៀត បាន ចូលរួម ជា ភ្ញៀវ កិត្តិយស ។
លុយកាក់ មាន អ្នក ជួយ យក អាសា ក្នុង ការគ្រប់គ្រង លុយ ។
ហេតុ អ្វី បានជា មាន ពលរដ្ឋ លោក ខាងលិច ចូលរួម ជាមួយ ក្រុម អ៊ិស្លាម បង្កើត រដ្ឋ
ប្រជាជន នៅក្នុង ទីក្រុង ភ្នំពេញ ដែល ភៀសខ្លួន មកពី ខេត្ត ផ្សេង ៗ
ប៉ុន្តែ ខាង ក្រុមហ៊ុន មិន បាន អនុវត្ត តាម សេចក្តី បង្គាប់ របស់ ក្រុមប្រឹក្សា អាជ្ញា កណ្តាល នោះ ទេ ។
អ្វី ដែល សំខាន់ នោះ លោក អ្នក គួរតែ ចៀសវាង នូវ ការច្នៃ ម៉ូត សក់ ញឹកញាប់ ពេក ។
ទៀត នោះ ឡើយ ប៉ុន្តែ ពួកគាត់ គ្រាន់តែ ដឹង ពី ការប្រកាស នេះ តាម សារព័ត៌មាន ប៉ុណ្ណោះ ។
ដូច្នេះ ត្រូវ ប្រាកដ ថា អ្នក លាក់បាំង រឿងរ៉ាវ មួយចំនួន ពី គូស្នេហ៏ របស់ អ្នក តែ ប៉ុណ្ណោះ ។
គ្នា ដោយ ការញ៉ាំ អាហារ មាន សារជាតិ បន្លែ ផ្លែ ឈើ ហើយ អាច គេង បាន ៨ ម៉ោង ឱ្យ បាន គ្រប់គ្រាន់ ។
ងាយស្រួល ក្នុង ការផ្ទេរ ប្រាក់ ទូទាត់ ជា កញ្ចប់ ឱ្យ អ្នកទទួល ផល ជា ក្រុម ច្រើន នាក់ ឬ ច្រើន គណនី ក្នុង ពេល តែ មួយ ។
ទូរសព្ទ ម៉ាក វីហ្វូន ចំនួន មួយ គ្រឿង ។
អ្នក អាច ជួល ពួកគេ ឱ្យ ធ្វើជា មិត្តភក្តិ របស់ អ្នក ឬ ក៏ សមាជិក គ្រួសារ អ្នក ដើម្បី អ្នក អាច ថត រូប ជួបជុំ គ្រួសារ ។
ប៊ីរីយ៉ា ដែល បាន សម្តែង ជា តួឯក ម្នាក់ ក្នុង រឿង ស្នេហ៍ ស្វ័យ គុណ៤ បាន ថ្លែង ប្រាប់ ថា នាង បើក អាជីវកម្ម ធ្វើដំណាប់ អំពិល ប្រមាណ ៣ - ៤ខែ ហើយ ដោយ អំពិល ធ្វើជា ដំណាប់ ទាំងនោះ នាង ធ្វើ ដោយ ដៃ ខ្លួន ផ្ទាល់ ។
ហើយ ប្រជ្រៀត គ្នា នៅ ក្រោម ដើម ផ្អាវ ។
ការបាត់បង់ ប្រាក់ ចំណូល ដែល រដ្ឋាភិបាល ភ័យខ្លាច អាចនឹង ប៉ះពាល់ ដោយ វិស័យ ឯកជន ។
ទន្ទឹមនឹង នេះ លោក ហ៊ុន សែន បាន ធ្វើឱ្យ សហគមន៍ ជនជាតិ ខ្មែរ ខឹងសម្បា ព្រោះ លោក បាន ព្រមាន ថា លោក នឹង តាម វ៉ៃ ដល់ ផ្ទះ ចំពោះ អ្នកតវ៉ា ដែល ដុត ទីង មោង រូបលោក នៅក្នុង ទីក្រុង ស៊ីដនី ។
ប្រព័ន្ធ ហ្វ្រាំង ក្រោយ ហ្វ្រាំង ស្បែក ដែល តំណើរ ការរួមបញ្ចូល គ្នា CBS
នេះ នឹង ចូលរួម ស្បថ សច្ចា ប្រណិធាន ហើយ នេះ គឺជា លើក ទី១ ហើយ ដែល ការស្បថ នេះ ត្រូវបាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ នយោបាយ ប្រចាំ ឆ្នាំ ។
នេះ ផ្លូវ មុខ វត្ត ដែល នៅជាប់ ដឿង ហែម ផ្សារ
នេះ ជា ការបាញ់ សាកល្បង មីស៊ីល ជា លើក ទី ៧ហើយ របស់ កូរ៉េ ខាងជើង ក្នុង រយៈពេល មិន ដល់ មួយ ខែ ផង ចាប់ពី ថ្ងៃទី ២៥ ខែកក្កដា មកដល់ ថ្ងៃទី ២៤ ខែសីហា ។
កាលពី ពេល កន្លងទៅ ថ្មី ៗ
ដែល តម្រូវ ឱ្យ មាន ការព្យាបាល ជាមុន ។
បន្ទាប់ពី ឆ្លងកាត់ ការដាំ រោម ចិញ្ចើម រយៈពេល ៦ ម៉ោង នាង ក្លែរ ក៏ ទទួលបាន នូវ ចិញ្ចើម ដែល ក្រាស់ ជាង មុន ដូច ក្តីប្រាថ្នា របស់ នាង ។
ួ ធម្មការ និង សាសនា គូសបញ្ជា កថា
មន្ទីរពេទ្យ គន្ធ បុប្ផា បាន បើក ដំណើរការ និង ផ្តល់ សេវា ព្យាបាល ជំងឺ ដល់ ស្ត្រី មាន ផ្ទៃពោះ និង កុមារ ដោយ ឥត គិត ថ្លៃ អស់ រយៈពេល ជាង ២៥ ឆ្នាំ ហើយ ។
ទាហាន អាហ្វហ្គានីស្ថាន ៤៣ នាក់ ស្លាប់ ក្នុង វាយប្រហារ ទាំង យប់ ដោយ ក្រុម តាលី បង់ !
ប៉ុន្មាន សន្លឹក របស់ ឱក សុគន្ធ កញ្ញា និង ឆន សុវណ្ណ រាជ ធ្វើឱ្យ មហាជន ពេញចិត្ត ស្តូក !
ពាក្យ ទាក់ទង ក្រសួង បរិស្ថាន ធម្មជាតិ មន្ត្រី ឧទ្យានុរក្ស
ជាក់ស្តែង អ្នកស្រី បាន ថត រូប ជាមួយ អ្នកណា នោះ នៅ ក្រុង ឡុងហើយ ការរាលដាល នៃ រូបភាព នេះ ពុំ មែន ជា រឿង ចៃដន្យ ទេ !
តំណាងរាស្ត្រ គណបក្ស សង្គ្រោះ ជាតិ លោក អ៊ុំ សំអាន ពេល បញ្ជូន មក តុលាការ កំពូល កាលពី ថ្ងៃទី ២១កញ្ញា
ការងារ ប្រយ័ត្នប្រយែង ព្រោះ មាន អ្នក ច្រណែន ឈ្នានីស ក្នុង ការងារ ។
ប្រភព នៃ បុណ្យ កាន់ បិណ្ឌ នឹង ភ្ជុំ បិណ្ឌ
ជា ការឆ្លើយតប ទៅនឹង ការរិះគន់ នេះ នៅ ឆ្នាំ ២០០៦ ក្រុមហ៊ុន ផលិត ស្រា ប៊ៀរ ធំ ៗ
មាស បាន បញ្ចប់ ឈ្មោះ ៖
ហាមប្រាម មិន ឱ្យ កីឡាករ ទាំង ពីរ រូប ចូល លេង ។
បញ្ហា នេះ កើតឡើង បាន ដោយសារតែ ជាតិ ស្ករ នៅក្នុង ឈាម អ្នក ចុះ ទាប ។
ក្នុង ន័យ នយោបាយ លោក ត្រាំ បាន វិនិយោគ យ៉ាង ច្រើន ក្នុង ការទទួលបាន ជោគជ័យ នៃ កិច្ចប្រជុំ នេះ ដូច្នេះ មន្ត្រី អាមេរិក ភាគ ច្រើន ក៏ ដូចជា អ្នកសង្កេតការណ៍ នៅ ខាងក្រៅ រំពឹងទុក ជា លក្ខណៈ ឯកជន ថា កិច្ចប្រជុំ នេះ នឹង ដំណើរការ ទៅ មុខ ។
និងោរវវឌណន៍ រដសៀល ៕
ដាក់ ទៅ ក្រសួង ដើម្បី ក្រសួង ពិចារណា ៖
នៅ ប៉ុន្មាន ម៉ោង មុន នេះ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បាន បង្ហើប ពី តម្រុយ …
ឥឡូវ មិន ចាំបាច់ រក មនុស្ស មក ថែ មនុស្ស ចាស់ ទេ មាន មនុស្ស យន្ត សម្រាប់ ថែ មនុស្ស ចាស់ ហើយ
ប៉ុន្តែ ប្រសិនបើ អ្នក មាន បញ្ហា នៃ ការគេង នេះ ជា ទៀងទាត់ ហើយ អ្នក គិត ថា វា កំពុងតែ ប៉ះពាល់ ដល់ អារម្មណ៍ ឬ ការងារ ប្រចាំ ថ្ងៃ ដល់ អ្នក សូម ទៅ ជួប នឹង គ្រូពេទ្យ ៕
អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ កម្ពុជា បាន បញ្ជាក់ ថា ពលរដ្ឋ កម្ពុជា ប្រមាណ ៧០ នាក់ ដែល កំពុង រស់ នៅ សហរដ្ឋ អាមេរិក នឹង ត្រូវ បញ្ចូន មកកាន់ ប្រទេស កម្ពុជា វិញ នៅ ខែធ្នូ នេះ ។
ខ្ញុំ គិត ថា នៅ មាន ទំនាក់ទំនង សំខាន់ ៗ
៤.កដត្តាកម្ម ជាកម្ម ដែល ធ្វើអោយ ឥត ចេតនា ។
នៅ មុន ថ្ងៃ ចូល ឆ្នាំ ថ្មី ឆ្នាំ សកល ២០២១ លោក ស៊ី ជីន ភីង ប្រធាន រដ្ឋ ចិន បាន ថ្លែង សុន្ទរកថា ជូនពរ ឆ្នាំ ថ្មី តាមរយៈ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន និង បណ្តាញ អ៊ីនធើណេត ។
រៀងរាល់ ថ្ងៃ នេះ មនុស្ស យើង ម្នាក់ ៗ
ដូច្នេះ គម្រោង នេះ ហាក់ដូចជា មិន សម ហេតុផល ឡើយ ។
ដោយឡែក នៅ ថ្ងៃ នេះ អ្នកនាង ម៉ាក សែនសូនីតា បាន បង្ហោះ សារ អម ជាមួយនឹង រូបភាព របស់ អ្នកនាង ថត ជាមួយនិង ស្វាមី ទុក ជា អនុស្សាវរីយ៍ មុនពេល សម្រាល កូន ។
ទោះ យ៉ាងណា លោក មីត ស៊ូយ៉ា បាន បន្ថែម ថា ពួកគេ នឹង ត្រូវបាន អនុញ្ញាតឱ្យ ចូលរួម ហ្វឹកហាត់ ។
អនុសញ្ញា លេខ ៨៧ស្តីពី សេរីភាព នៃ សមាគម និង ការការពារ សិទ្ធិ នៃ ការបង្កើត សមាគម
សាសនា ការបំផុស គំនិត
ប៉ុន្តែ នៅតែ មិន ច្បាស់ ថា នឹង ដំណើរការ តាម ការគ្រោងទុក ឬ អត់ នោះ ទេ ។
ប៉ុន្តែ ត្រូវ ប្រុងប្រយ័ត្ន កុំ បើកបរ ឬ ធ្វើ ការងារ គ្រោះថ្នាក់ ពីព្រោះ ថ្នាំ នេះ អាច ធ្វើឱ្យ អ្នកងងុយ គេង បាន ។
ដោយសារតែ ការប្រកួត នៅ បន្ត ដូច ច្នេះ ៦១៩ នៅ វៃ តាម ធម្មតា ។
ខ្ញុំ សង្ឃឹម ថា ឯកឧត្តម គោ ស៊ុំ សារឿត នឹង យកចិត្តទុកដាក់ ដោះស្រាយ បញ្ហា នេះ ដោយ ជោគជ័យ ទុក ជា ស្នាដៃ ព្រោះ កន្លងមក មាន មន្ត្រី ឋានៈ ធំ ៗ
មនុស្ស ស្រី ខាន រួមភេទ នឹង មាន អាការៈ ៧ចំណុច នៅក្នុង អត្ថបទ នេះ
មនុស្ស ជាច្រើន មាន បំណង លុបបំបាត់ ចោល បទពិសោធ ឈឺចាប់ របស់ ខ្លួន ។
ខ្លាដំបង ធាតុ ឈើ ក្រអូប នឹង មាន ទ្រព្យ ជា សេដ្ឋី ចរចា ទៀង ត្រង់ ។
ប្រសើរ ខ្លាំង ណាស់ !
បាតុភូត ធម្មជាតិ រន្ទះ បាញ់ បណ្តាលឱ្យ ស្លាប់ មនុស្ស ចំនួន ០២ នាក់
