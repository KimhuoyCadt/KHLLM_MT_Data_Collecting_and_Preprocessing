ពិការ មិន មែន ជា កូន ធម្មតា នោះ ទេ គាត់ តស៊ូ ចិញ្ចឹម ពួកគេ រហូត ។
បញ្ញា វគ្គ មហា បញ្ញាក ថា
កម្មវិធី នេះ ក៏ មាន ម៉ូឌុល ដែល អាច បង្កើន ការអនុវត្ត ប្រព័ន្ធ នេះ និង បង្កើន ប្រសិទ្ធភាព ការលេង ហ្គេម នេះ ។
ហើយ ត្រូវ ខ្មាំង កៀរ ទៅ រក ភាព អន្ធការ ។
ឥឡូវ ចាប់ផ្តើម ប្រើ ពូ ថៅ ប្រើ កាំបិត ។
ជា អកុសល តាម ផ្លូវ ត្រលប់ មកវិញ លោក ក៏ បាន បាត់បង់ ស្មារតី គ្រូពេទ្យ បាន ជួយសង្គ្រោះ ដែរ តែ មិន អាច ជួយ បាន ។
ក្នុង រយៈពេល ៥ខែ ឆ្នាំ ២០២០ នេះ ការនាំចេញ របស់ កម្ពុជា នៅ មាន ភាពវិជ្ជមាន នៅឡើយ - ក្រសួង ព័ត៌មាន
ការថែទាំ និង យកចិត្តទុកដាក់ ចំពោះ សុខភាព ជា រឿង ដែល លោក អ្នក ចាំបាច់ គិតគូរ ជា ចម្បង ។
ថ្ងៃទី ៣១ ខែមករា ជីវប្រវត្តិ និង សៀវភៅ ល្អ បំផុត របស់ មេហ្គាន មេវេល
ម្យ៉ាងទៀត ដើម្បី ទស្សនកិច្ច ឱ្យ យល់ ពី ប្រជាជន នៃ ប្រទេស កម្ពុជា ផង និង ដើម្បី បង្កើន កិច្ចសហប្រតិបត្តិការ បន្ត ទៀត ផងដែរ ។
ប៉ុន្តែ គាត់ នេះ នៅតែ ចចេស ក្នុង បទល្មើស ដដែល ទៀត ដោយ មាក់ងាយ ថា កម្ពុជា មិន ហ៊ាន ធ្វើ អ្វី គេ នោះ ទេ ។
កម្រង អនុស្សាវរីយ៍ ឆ្នាំ ២០១២ ជាមួយនឹង មិត្ត អ្នកនិពន្ធ ខ្មែរ
១ពែង កូរ ឱ្យ សព្វ សឹម ទទួលទាន ជា ការស្រេច ។
ត្រូវតែ ព្យាយាម ពេញ ទំហឹង ព្រោះ ប្រឹង នឹង ព្រេង ជា គូ គ្នា ។
យើង នឹង ជួបជុំគ្នា ហើយ យើង នឹង ដើរ ចូល ប្រទេស កម្ពុជា ឱ្យ បាន មនុស្ស ១លាន នាក់ ។
របស់ ព្រះសមន គោត្តម ដែល ជា ព្រះសាស្តារ នៃ មនុស្ស និង ទេព្វតា ។
ទៀត នៃ កីឡាដ្ឋាន ឡាវ នេះ ។
យោង តាម សេចក្តីថ្លែងការណ៍ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា មាន ការសោកស្តាយ ចំពោះ សេចក្តីសម្រេច ដ៏ …
លោក គង់ គាំ ប្រធាន គណបក្ស សម រង្ស៊ី ថ្មី
លោក បន្ត ថា ករណី ហិង្សា នេះ ជា រឿង គួរឱ្យ សោកស្តាយ និង រឿង ដ៏ ចម្លែក ។
ប៉ុន្តែ មិន បាន បញ្ជាក់ អំពី ទំហំ បំណុល សរុប សម្រាប់ គម្រោង ទាំងនោះ ទេ ។
ដ្បិត ព្រះអម្ចាស់ បាន លោះ កូន ចៅ របស់
មិន គួរ គិត តែ ប្រយោជន៍ ផ្ទាល់ខ្លួន តែ មួយ មុខ នោះ ទេ ក្នុង នោះ ក៏ ត្រូវ មាន ចំណែក ណាមួយ សម្រាប់ ជួយ សង្គម ផងដែរ ។
នេះ មិន មែន ជា លើក ទី មួយ នោះ ឡើយ ដែល មហាជន បាន ប្រតិកម្ម ទៅនឹង ការប្តូរ ឈ្មោះ ទីតាំង សំខាន់ ៗ
សូម បញ្ជាក់ ថា ឡៅ ស៊ីណាត និង វ៉ែន សុវណ្ណ ជា គូ ទស្សន៍ទាយ ។
ពីព្រោះតែ អាជ្ញាធរ មិន បាន គោរព ទៅ តាម ពាក្យសន្យា ដែល ថា នឹង ផ្តល់ ដី ស្រែ ដី ចម្ការ ដល់ ពួកគាត់ ។
ពុំ មាន ការចាំបាច់ ណាមួយ ដែល យើង ត្រូវ អង្រួន អ្នក ជម្ងឺ ឬ តំម្លើង សម្លង ក្នេុង ការនិយាយ ស្តី ទៅកាន់ អ្នក ជម្ងឺ នោះ ឡើយ ។
ពួកគេ ចូលចិត្ត ការផ្តួចផ្តើម ទាំង នេះ ដែល វា នឹង ជួយ ផ្តល់ ដល់ កុមារ ៗ
ចំពោះ ទឹកភ្លៀង ក្នុង ខណ្ឌ ទាំង បួន កណ្តាល រាជធានី ទឹក បាន ហូរ ទាន់ ពេល មិន បណ្តាលឱ្យ លិច លង់ ទេ ៕
មនុស្ស ចំនួន ៣នាក់ ត្រូវបាន សង្គ្រោះ ហើយ ក្រុម អ្នកសង្គ្រោះ បាន កំពុង ស្វែងរក អ្នក ដែល បាត់ខ្លួន ។
ទទួលបន ព័ត៌ មន ជ
ពេល ងូតទឹក រួច ត្រូវ ចាក់ ទឹក ក្តៅ អ៊ុន ៗ
ចំពោះ ប្អូន វិសាល និង ក្រុមគ្រួសារ ផងដែរ ។
ឱក សេរី សោភ ក្តិ៍
១៩ ប៉ុន្តែ ប្រសិនបើ អ្នក រាល់គ្នា បែកចិត្ត ចេញ ពី យើង ហើយ មិន កាន់ តាម ច្បាប់ និង បទបញ្ជា ដែល យើង ប្រគល់អោយ ទេ ឬ ប្រសិនបើ អ្នក រាល់គ្នា បែរ ទៅ គោរព និង ថ្វាយបង្គំ ព្រះដទៃ ២០ យើង នឹង ដក អ្នក រាល់គ្នា ចេញ ពី ទឹកដី របស់ យើង គឺ ទឹកដី ដែល យើង ប្រគល់អោយ អ្នក រាល់គ្នា ហើយ យើង ក៏ នឹង បោះបង់ ចោល ដំណាក់ ដែល យើង ញែក ទុក សំរាប់ នាម យើង នេះ អោយ ឆ្ងាយ ពីមុខ យើង ដែរ ។
១៣ផលិតភាព ល្អ ៗ
គីម មិន ដែល បាន ជួប ប្រធានាធិបតី ចិន ស៊ី ជីន ពីង ទេ ចាប់តាំងពី លោក ចូលកាន់ តំណែង ក្រោយមរណភាព ឪពុក របស់ លោក គីម ជុង អ៊ីល នៅ ឆ្នាំ ២០១១ ។
នេះ គឺជា កន្លែង ទទួល ផ្ញើ កង់
គឺជា ការហាម ប្រាម ធម្មតា ៗ
គ្រូ គុយ បា កំពុង គេចវេះ ពី ការវិលត្រឡប់ ទៅ ស្រុក កំណើត
ដូច្នេះ ការងាក មក រក វិធី ដើម្បី ជម្រះ នូវ អារម្មណ៍ ដែល តប់ប្រមល់ ឱ្យ ប្រែ ជា ស្រឡះ ទើប ជា ការប្រសើរ ចំពោះ សុខភាព នឹង សុពលភាព ខួរក្បាល របស់ អ្នក ។
សុដន់ ប្រែប្រួល បែប ណា ដែល បញ្ជាក់ ថា មាន ផ្ទៃពោះ ?
ស្ត្រី នៅក្នុង ប្រទេស នេះ ពុំ មាន សិទ្ធិ ចុះហត្ថលេខា លើ ឯកសារ ច្បាប់ ណាមួយ ឡើយ បើ គ្មាន ការអនុញ្ញាត ពី ស្វាមី របស់ ខ្លួន ។
ជាលិកា មនុស្ស ឬ វត្ថុ រាវ ។
ហើយ គំរោងការ របស់ គេ
ដូច្នេះ មនុស្ស ទាំងឡាយ ដែល មាន ចង្កេះ ធំ ជាង ១៤២សង់ទីម៉ែត្រ មិន អាច អង្គុយ នៅលើ កៅអី ថ្នាក់ ទី មួយ នោះ បាន ឡើយ ។
ក្នុង ១៥៨០ វា ត្រួវ បាន សហជាតិ និង អេស្ប៉ាញ បាន ហៅ ថា
ភាពល្បី និង ជំនួញ របស់ របស់ ហ៊ុន តូ ៖
ក្រសួង វប៌្បធម អនុញ្ញាតឱ្យ រោង ភាពយន្ត បើក ឡើងវិញ
ភាគី ទាំង២បាន សឱ្យ នូវ
ពួកគេ អាន ទស្សនាវដ្តី អត្ថបទ និង សូម្បីតែ អ្វី ដែល បុគ្គលិក សរសេរ នៅលើ បណ្តាញ សង្គម ។
ខូច វិភាគ ប្រព័ន្ធ ។
កញ្ញា ជំរុញ ឱ្យ មាន ការរៀបចំ ពិព័ណ៍ បែប នេះ រៀងរាល់ ឆ្នាំ ។
លោក បញ្ជាក់ ថា កន្លងមក ប្រជាពលរដ្ឋ ធ្លាប់ មាន ប្រតិកម្ម ចំពោះ បញ្ហា នេះ ម្តង រួម មក ហើយ ។
ប៉ុន្តែ បើ ខ្ញុំ យក ល្បឿន បិទ យឺត ជាង ល្បឿន ម៉ូតូ នោះ រួប ម៉ូតូ ព្រាល ។
តើ យុវជន ត្រូវ ត្រៀមលក្ខណៈ សម្បត្តិ អ្វី ខ្លះ ដើម្បី បម្រើ ការងារ ផ្នែក នេះ ?
ចូរ បំពេញ ជាតិ ទឹក ឱ្យ គ្រប់គ្រាន់ ដល់ រាងកាយ ដើម្បី ឱ អ្នក មាន ទឹកដោះ គ្រប់គ្រាន់ ៕
ប្រភព ក្រសួង វប៌្ប ធម និង វិចិត្រ សិល្បះ
ខាងលើ ជា ចំណោទ បញ្ហា មួយ ដែល គ្រូពេទ្យ សូម ធ្វើ ការបកស្រាយ ដូច ខាងក្រោម ។
យ៉ាងម៉េច យ៉ាងណា ទៅ ផ្ទះ សិន ចុះ ។
បុក គេ ស្លាប់ ឬក៏ ធ្វើឱ្យ គេ រងរបួស កម្ទេច ឡាន ខ្លួន ឯង ចោល ទៀត ។
