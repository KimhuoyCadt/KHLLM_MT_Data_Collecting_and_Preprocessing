ស្តេច មុខ លុយ មុខ អំណាច ហើយ ពិសេស មុខ តណ្ហា ។
ដែល បាន ទៅ ចូលរួម ព្រឹត្តិការណ៍ នោះ ។
មើល តែ ការស៊ើបអង្កេត ក៏ អាច ឱ្យ គេ ឯង គ្រប់ គ្នា សង្ស័យ បាន ដែរ ។
៥ប្រទេស ដែល ពលរដ្ឋ កម្ពុជា អាច ចេញ ចូល ដោយ មិន ចាំបាច់ សុំ ទិដ្ឋាការ ឆ្លង ដែន មេឃា
លី បង់ គឺជា ប្រទេស តូច មួយ ដែល មាន ផ្ទៃដី ជាង ១ម៉ឺន គីឡូម៉ែត្រ ការ៉េ ប៉ុណ្ណោះ ។
ទើប ពួក គាត់ បាន នាំគ្នា មក ស្នាក់ការ គណបក្ស ប្រជាជន អស់ រយៈពេល ពីរ ថ្ងៃ មក នេះ ។
យ៉ង ពិត ជមនបសិទ ភពិធ
ដូច ផ្ទុះ គ្រាប់បែក អ្នកដំណើរ ក្នុង ឡាន នាំគ្នា ភ្ញាក់ ក្រញាង គ្រប់ គ្នា ។
សូម កុំ មក បំផ្លាញ កម្ពុជា ជនក្បត់ សួន សេរី រដ្ឋា ។
សំណង់ ថ្មី កំពុង សាងសង់ នេះ អាច ជា មហា កុដិ ឬ ពុទ្ធិក សិក្សា
ដើម្បី លក់ នៅក្នុង ស្រុក និង នាំចេញ ទៅ ប្រទេស ក្នុង តំបន់ ។
ទៀត យូរ ឆ្នាំ ដែរ មិន មាន ការស៊ើបអង្កេត ។
នៅ ថ្ងៃសុក្រ នេះ មន្ត្រី យោធា ការពារ ជាតិ ហ្វីលីពីន បាន ចេញមុខ មក បកស្រាយ ឡើងវិញ អំពី ការធ្វើ អត្ថាធិប្បាយ របស់ លោក ប្រធានាធិបតី ។
គួរ រំលឹក ថា កាលពី ឆ្នាំ ២០០៣ លោក ហ្គាដាហ្វី បាន យល់ បោះបង់ ចោល កម្មវិធី នុយក្លេអ៊ែរ និង អាវុធ គីមី ជា ថ្នូរ នឹង ការដក ទណ្ឌកម្ម សេដ្ឋកិច្ច ។
សុខភាព ពេល យប់ មិន ត្រូវ បរិភោគ អាហា មាន ខ្លាញ់ ប្រេង ច្រើន ។
ខ្ញុំ ពិការ ហើយ សុំ ក្តី មេត្តា និង អាណិត សុំ តែ សុខ មិន និយាយ អ្វី ទាំងអស់ ។
៣ដើម ដំណាង ភាពសប្បាយរីករាយ
មាន អាជីព រៀង ៗ
ស្ទើរ គ្រប់ ខេត្ត ដែល នៅ មាន សល់ ព្រៃឈើ ល្អ ៗ
ដូចនេះ យើង អាច សន្និដ្ឋាន បាន ថា ព្រះមហា ព្រហ្ម មុនីនង បាន លាចាក សិក្ខាបទ មុន ឆ្នាំ ១៨៥៤ ។
ការទទួលបាន ការងារ ល្អ សព្វ ថ្ងៃ នេះ ជា រឿង ដែល ពិបាក និង មាន លក្ខណៈ ប្រកួតប្រជែង ខ្លាំង ។
គ្រប់ បាន ដែល គាត់ ត្រូវការ ដូចជា លុយ ផ្ទះសម្បែង ការងារ និង ក្រុមគ្រួសារ ។
សមាជិក ស្រី រូប ស្រស់ របស់ ក្រុម ជួញដូរ គ្រឿងញៀន ចេញ សារភាព បាន រួមរក្ស ជាមួយ សាកសព បុរស ៗ
ក្នុង ពេលនេះ វា បាន ក្លាយទៅជា របស់ អស្ចារ្យ មួយ ដែល ក្មេង ជំទង់ ត្រូវ មាន ទុក ជក់ បង្អួត គ្នា ៕
សាយ សៀរ៉ា លេង រាប់ សុទ្ធតែ តារា ស្រី ចឹង ហ្មង
ដី លក់ និង អាគារ លក់ បន្ទាន់ ខណ្ឌ ដូនពេញ២. ៥លាន ដុល្លារ
លទ្ធផល បោះឆ្នោត ដឹង ហើយ ពេលនេះ មិន មែន ជា ពេល ជេរ គ្នា ទេ តែ ជា ពេល ប្រកួត គ្នា បម្រើ ប្រជាជន
មិន មែន គ្រាន់តែ ជា អង្គការ ក្រៅ ច្បាប់ ទេ ជា ភេរវករ តែម្តង ។
អ្នកស្រី មិន មានិត ម្តាយ សុខ សីឡាលីន បាន លើកឡើង ថា ៖
វិញ្ញាសារពន្យល់ ។
កម្ពុជា ដែល ជា ប្រទេស ក្រីក្រ ត្រូវការ លុយ ដ៏ សន្ធឹកសន្ធាប់ របស់ ចិន ដើម្បី អភិវឌ្ឍ ប្រទេស ឱ្យ ជឿនលឿន ដូច គេ ដូច ឯង ។
ការកែប្រែ ធម្មនុញ្ញ គឺ សំខាន់ សម្រាប់ អន្តរកាល នៅ មីយ៉ាន់ម៉ា
ប្រទេស នេះ ជា ប្រទេស ដែល មាន សង្គ្រាម ច្រើន ហើយ ពលរដ្ឋ ងាយ នឹង ប្រឈមមុខ នឹង កង្វះខាត ស្បៀងអាហារ ។
ជំងឺ នេះ បង្កឡើង ដោយ បាក់តេរី ខុស ៗ
នៅពេល អាការៈ ទាំង នេះ កើតឡើង ជាមួយនឹង រោគសញ្ញា ដែល បាន រៀបរាប់ ខាងលើ ។
អ្នកស្រី បាន ក្លាយជា ស្ត្រី ដែល កាន់ តំណែង ខ្ពស់ ជាង គេ បំផុត នៅក្នុង ប្រវត្តិសាស្ត្រ សហរដ្ឋ អាមេរិក ជាង ២០០ ឆ្នាំ កន្លងមក នេះ ។
នៃ ការទទួលទាន អយ ស្ទ័រ ៖
ស្វាយរៀង និង វេស្ទើន ប្រាប់ ពី ការចំណាយ ធ្វើ ទីលាន ថ្មី ឯ ទ័ព ប្រាប់ ពី ប្រាក់ ជួសជុល ស្តាត ចាស់
ជាមួយគ្នា នេះ ដែរ លោក អ្នក អា
រូបថត ដែល បាន បង្ហោះ មួយ នេះ ឥឡូវនេះ មាន ពេញ ដោយសារ ចូលរួម រំលែក ទុក្ខ ពី អ្នកគាំទ្រ ជាច្រើន ។
នេះ បាន បង្ហាញ ថា ក្មេងស្រី វ័យ
រួមរស់ ជាមួយគ្នា ៣ ឆ្នាំ អត់ កូន ដល់ ពេល មាន កូន ម្តង ៥នាក់
សូកូឡា ស្វីស ដ៏ ផ្អែម ឆ្ងាញ់ ជាង គេ លើ ពិភពលោក គេ ប្រាប់ អីចឹង
គេ លើក តម្កើង សិរី រុងរឿង របស់ អ្នក
កូន ខ្មែរ កើត នៅ អាមេរិក រូប នេះ មាន ក្តី ស្រលាញ់ ក្បាច់គុន តាមរយៈ វីដេអូ ហ្គេម និង ខ្សែភាពយន្ត ប៉ុន្តែ ប៉ុន្តែ គេ គ្មាន សិទ្ធិ ធ្វើ អ្វី ឱ្យ បាន ច្រើន លើស ពី ក្តី ស្រលាញ់ ឡើយ ។
ដើមទ្រូង ទ្រលុកទ្រលន់ របស់ ហេង ស្រី ពេជ្រ ធម្មជាតិ ពិត ៗ
បារាំង ដាក់ សម្ពាធ …
តែ ទ្រង់ នឹង ស្ថិតស្ថេរ នៅ វិញ
ហើយ ប្រើ ពេល ដើរកម្សាន្ត នៅ លំហ ធំ ៗ
មួយចំនួន ដែល អ្នក គួរតែ អនុវត្ត ដើម្បី ថែរក្សា និង សម្អាត ពូក របស់ អ្នក ឱ្យ បាន ស្អាត ល្អ ។
ចំណុច ទាំង បី នេះ បាន ធ្វើឱ្យ ការវិភាគ របស់ សម្តេច ទទួលបាន ជោគជ័យ និង មាន ភាពត្រឹមត្រូវ ៕
បន្ថែម លើ នេះ អ្នក ប្រតិបត្តិ សាសនា នឹង មាន ការសូត៌្រ ធម បួងសួង មុនពេល យន្តហោះ ចេញដំណើរ ។
អ្នក គួរតែ ជា មនុស្ស ល្អ ចិត្ត សប្បុរសចេះដឹង ទុក្ខ ធុរៈ អ្នក ដ៏ទៃ ។
របស់ គណបក្ស ប្រឆាំង ទូទាំង ប្រទេស តែម្តង ។
សញ្ញា ដែល បង្ហាញ ថា ការបាត់បង់ ឈាម របស់ អ្នក ហួស ប្រមាណ មាន ដូចជា ៖
សម រង្ស៊ី មិន ដឹង ពី កន្លែង ដែល ត្រូវ កត់ត្រា អ្វី ជា វិជ្ជមាន និង អ្វី ជា អវិជ្ជមាន ក្នុង កិច្ចការ នយោបាយ របស់ ខ្លួន ទេ ។
មិន ត្រឹមតែ ប៉ុណ្ណោះ ទេ ពណ៌ ក្រចក នីមួយ ៗ
ទិន្នន័យ ប៉ូលិស បង្ហាញ ថា ករណី រំលោភ ភាគ ច្រើន កើត លើ កុមារ
ងាក មក តំបន់ សេដ្ឋកិច្ច ពិសេស វិញ តើ លោកជំទាវ ទទួលបាន ជោគជ័យ យ៉ាងដូចម្តេច ?
ជន បរទេស ទាំង ពីរ នាក់ នេះ បាន នាំចូល ប្រាក់ ដុល្លារ ចំនួន ២លាន ២សែន ដុល្លារ ដែល សង្ស័យ ថា ជា លុយ ខុស ច្បាប់ ។
ឧស្សាហ៍ ប្រាប់ ពួកគេ ថា ជីវិត និង សុខ ទុក្ខ អ្នកដទៃ គឺ សំខាន់ ខ្លាំង ដូច ខ្លួន របស់ ពួកគេ ដែរ ។
ជិះ កង់ រយៈពេល យូរ ៗ
ចំណុច ទី១០សមីការ នៃ ស្វ៊ែ
ចង់ ដឹង ថា ព្រឺព្រួច កម្រិត ណា សូម ទស្សនា វីដេអូ ខាងក្រោម ៖
ខ្ញុំ គិត ថា លីហ្សាយល់ ពី ដំណើរ ខ្ញុំ ទៅ២ ប្រទេស ជាមួយ ដាឡែន នេះ ៕
ការតវ៉ា ដីធ្លី នៅ តំបន់ ផ្សេង ទៀត ក៏ រង ការបង្ក្រាប ដោយ ការបាញ់ គ្រាប់ កាំភ្លើង ផងដែរ ។
បច្ចុប្បន្ន សព ត្រូវ ប្រគល់ជូន សាច់ញាតិ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ៕
របប រាជានិយម ផ្តាច់ការ ត្រូវ បិទ បញ្ចប់ ជំនួស មកវិញ ដោយ របប រាជានិយម អាស្រ័យ រដ្ឋធម្មនុញ្ញ ។
ស្រលាញ់ លើស បម្រាម 1
ស្ថានការណ៍ នៅ ប្រទេស លីប៊ី នេះ វិវឌ្ឍ ទៅ យ៉ាង វិនាសកម្ម ។
កូនប្រុស រដ្ឋមន្ត្រី មហាផ្ទៃ ឥណ្ឌា ត្រូវបាន គេ សង្ស័យ ពី បទ
នេះ កូនស្រី របស់ តារា សម្តែង ជើង ចាស់ លោក សាវិន ហ្វីលីព បាន ហក់ ចូល ក្នុង សិល្បៈ តាម គន្លង របស់ ឪពុក ។
សារធាតុ បន្ថែម ដែល អ្នកទិញ ទាំងឡាយ គួរ ប្រុងប្រយ័ត្ន
យើង សុទ្ធតែ ដឹង មូលហេតុ សំខាន់ គឺ ការសម្រាល កូន ឬ អត់ ។
នៅ ពេល ដែល ខ្ញុំ មក ទីនេះ ខ្ញុំ បាន បាត់បង់ ប្រាក់ ចំណូល មួយចំនួន តែ ខ្ញុំ មិន ខ្វល់ នោះ ទេ ។
ក្មេង តូច ម្នាក់ ធ្លាក់ អណ្តូង ទឹក លង់ ស្លាប់ យ៉ាង អាណោច អាធម៌
ខណៈ កំពុង ជិះ រថយន្ត ជាមួយ សង្សារ ត្រូវបាន បុរស ជា សង្សារ ដឹក សព ចូល សារភាព ព្រោះ ដោយសារតែ
មួយចំនួន ក្នុង ការដោះស្រាយ បញ្ហា ប្រឈម សំរាប់ ជន ពិការ ។
ខ្លួន ដោយ មិន មាន ការប្តឹង ផ្តល់ អ្វី ឡើយ ៕
ទោះបីជា នាង និយាយ ថា អត់ អី ក៏ដោយ ក៏ អ្នក តែងតែ ត្រូវ រង់ចាំ នាង ដើម្បី ធ្វើ អ្វី ទៀត ជាមួយ អ្នក ដែរ ។
ជារៀងរាល់ ថ្ងៃ គាត់ បាន រកស៊ី ស្ទើរតែ គ្មាន ថ្ងៃ សម្រាក សូម្បីតែ ភ្លៀង ក៏ មិន សម្រាក ដែរ ។
ទោះជា លោក អ្នក ឋិត នៅ ទីណា ក៏ដោយ មិន ថា កន្លែង ធ្វើការសាលារៀន ទីកម្សាន្ត ឬ ទីកន្លែងណា ក៏ដោយ តេលា ម៉ាត នឹង នៅ ចាំ បម្រើ លោក អ្នក ជា និច …
ហើយ បើសិនជា ភាគី ណា មិន សុខចិត្ត ទេ ប្តឹង ឧទ្ធរណ៍ ទៅ លើ សាលក្រម ហ្នឹង ទៅ ដែល ជា សិទ្ធិ ដែល ច្បាប់ បាន តំណត់ ។
ដែល បង្ក ទុក្ខសោក និង ភាពអសកម្ម របស់ រដ្ឋាភិបាល ដ៏ គួរឱ្យ សោកស្តាយ ។
តាមពិត ការញាំ អាហារ គឺជា អ្វី ដែល មនុស្ស ជាទូទៅ ចូលចិត្ត ទោះបីជា យើង ត្រូវ ធ្វើជា រៀងរាល់ ថ្ងៃ ក៏ដោយ ។
ដួង ម៉ានិច និង បុត្រ ត្រៀម ចូល រោង ការឆាប់ ៗ
ប៉ុន្តែ អ្នករិះគន់ នានា បាន និយាយ ថា សហរដ្ឋ អាមេរិក ទទួលបាន ផលប្រយោជន៍ ទាំងអស់ នោះ មែន ប៉ុន្តែ ខាតបង់ កេរ្តិ៍ឈ្មោះ របស់ ខ្លួន ក្នុង នាម ជា ជើងឯក សិទ្ធិ មនុស្ស ។
ខ្សែ សម្រាប់ ភ្ជាប់ ឧបករណ៍ បច្ចេកវិទ្យា អាច ត្រូវបាន កែច្នៃ ដើម្បី លួច ទាញយក ទិន្នន័យ
អ្នក មាន ជីវិត ជា របស់ ខ្លួន ឯង ត្រូវ មាន ពេល សម្រាប់ ខ្លួន ឯង កុំ ឱ្យ អ្នកដទៃ មក គ្រប់គ្រង អី ៕
ព្រមទាំង ដើម្បី រៀបចំ កែសម្រួស របប សន្តិសុខ សង្គម ស្រប តាម លិខិត បទដ្ឋាន គតិយុត្ត ថ្មី ៗ
សូម គោរព ជម្រាប ជូន សម្តេច ទ្រង់ ឯកឧត្តម លោក លោកស្រី នាង កញ្ញ នឹង ប្រជាពលរដ្ឋ គ្រប់ តំបន់ បាន ជ្រាប ថា
ប៉ុន្តែ សំណើ ទាំងនេះ មិន ទាន់ ទទួលបាន ការយល់ព្រម ពី គណបក្ស ប្រជាជន កម្ពុជា នៅឡើយ ទេ ហើយ បែរជា ចោទប្រកាន់ ថា ជា ការខុស ច្បាប់ ទៅ វិញ ។
មិន មែន តែ ប៉ុណ្ណឹង ទេ គាត់ គឺជា ភ្ញៀវ ដ៏ ពិសេស អង្គុយ រង់ចាំ ស្វាគមន៍ ទស្សនិកជន យ៉ាង ច្រើន កុះករ ។
ទោះបីជា យ៉ាង នេះ ក្តី មិន មាន ប្រភព ណាមួយ អាច បញ្ជាក់ ថា រឿងរ៉ាវ ឈ្លោះគ្នា នៅលើ ឆ្នេរខ្សាច់ នោះ ផ្តើម ចេញ ពី អ្វី ឱ្យ ប្រាកដ នោះ ទេ ៕
នយោបាយ នេះ បាន អូសបន្លាយ អស់ ២០ ឆ្នាំ ហើយ ។
នេះ ជា លើក ដំបូង លើ ពិភពលោក ដែល គេ អាច ធ្វើ បែប នោះ បញ្ជាក់ ពី ការរីកចម្រើន ខាង ផ្នែក អាកាសចរណ៍ ។
មាន ការអះអាង គួរឱ្យ ភ្ញាក់ផ្អើល ថា ស្ត្រី ៗ
គោលក់ ប្រញាប់ លុយ
ផ្តល់ យោបល់ និង អនុសាសន៍ ដើម្បី ពង្រឹង ប្រព័ន្ធ ទីផ្សារ កសិកម្ម
បក្ស ភឿ ថៃ ដាក់ ប្រធានបក្ស អនាគត ទៅ មុខ ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី
ទី១ទាមទារ ឱ្យ មាន ការស៊ើបអង្កេត ដោយ តម្លាភាព ចំពោះ ភាព មិន ប្រក្រតី នៃ ការបោះឆ្នោត ។
យុវវ័យ ជនជាតិ ជប៉ុន ភាគ ច្រើន មិន បាន ទទួល ការរួមភេទ គ្រប់គ្រាន់
ដែល តំណាង ឱ្យ ខេត្ត កំពង់ចាម វិញ ម្តង ។
ក្បាល មេក្រូ ក៏ ត្រូវបាន ហុច ទៅ លើ ដៃ សមាជិក ផ្សេង ។
សេវា អនាម័យ និង គុណភាព ត្រូវបាន គេ គិត ជា ចម្បង ។
នា ពេល កន្លងមក រួចហើយ ដែរ ទើប ផ្តល់ ទំនុកចិត្ត ឱ្យ ផលិត រឿង ថ្មី ៗ
ការងារ រង សម្ពាធ ច្រើន ធ្វើឱ្យ ស្មារតី ទ្រុឌទ្រោម ។
នេះ របាយការណ៍ តាម មូលដ្ឋាន បាន បង្ហាញ …
១. រក ជា ចំនួន គត់ វិជ្ជមាន ផ្ទៀងផ្ទាត់ សមីការ ។
២. ព្យាបាល របួស
នៅពេល កម្មករ សន្លប់ ពួក នេះ មិន បាន យកចិត្តទុកដាក់ មើល ថែ ទេ គឺ ទុក ឱ្យ ដេក សន្លប់ រហូតដល់ ដឹងខ្លួន វិញ ។
យើង គួរតែ នាំគ្នា ជួយ រំលត់ គ្នា ទើប ល្អ ។
ប៉ុន្តែ គាត់ បាន ដឹងខ្លួន ភ្លាម ៗ
ខ្សែភាពយន្ត ចំនួន ៤នឹង បង្ហាញ វត្តមាន នៅក្នុង រោងកុន អាមេរិក នៅ ថ្ងៃសុក្រ ទី ៣០កក្កដា នេះ ។
សំខាន់ គឺ គ្រាន់តែ លើក មក បង្ហាញ ត្រួស ៗ
ពួកគាត់ គិត តែ គាបសង្កត់ ជីវភាព ពលរដ្ឋ ។
ពួកយើង គ្មាន អ្វី លាក់ លៀម ហើយក៏ មិន បាន សម្តែង ល្ខោន ដែរ ។
ទៀត ដែល មាន ចម្ងាយ រហូតដល់ ១០០ លាន ឆ្នាំ ពន្លឺ ឯណោះ ។
១. កញ្ញា បាន មុន្នីល័ក្ខ
ល់ ថា អាណាព្យាបាល ភាគ ច្រើន អោយ កូន ប
ជ្រើសរើស ម្សៅ ទឹកដោះគោ ម៉េច ទើប ល្អ កូន ម៉ឹម ទៅ មិន មាន បញ្ហា សុខភាព ផ្សេង ៗ
បង្កើត បណ្តាញ រឹងមាំ និង មាន ប្រសិទ្ធភាព !
បណ្តា ប្រទេស អាស៊ី អាគ្នេយ៍ ត្រូវការគោ …
ម៉ឺន មេឃាជា បេក្ខភាព កីឡាករ កម្ពុជា តែ ម្នាក់ …
ជំហាន ថ្មី មួយ បាន កើតឡើង កាលពី ខែកក្កដា ឆ្នាំ ២០១២ នៅពេល ហាង មួយ របស់ បណ្តាញ
