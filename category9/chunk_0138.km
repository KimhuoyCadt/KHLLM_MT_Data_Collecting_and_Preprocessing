សាក្រាម៉ង់ និង ហ៊ូស្តុន - អាកាសធាតុ ការប្រៀបធៀប
មិន គួរឱ្យ ជឿ គួរឱ្យ ចាប់អារម្មណ៍ ជាច្រើន ទៀត សូម ចុច ត្រង់ នេះ !
ដោយសារតែ ចង់ ដឹង ថា វា សិចស៊ី ឬក៏ អត់ ប្រសិនបើ ប្រុស ពាក់ វិញ នោះ ថ្មី ៗ
បងប្អូន ចូលរួម ធ្វើ បាតុកម្ម រឺ មិន ចូលរួម គេ គង់ នឹង ត្រូវ គ្នា ដ៏ ដែល ណឹង ។
រឿង តូចតាច ទាំង១០ ដែល អ្នក ប្រហែលជា មិន ធ្លាប់ ដឹង ថា កំពុងតែ ធ្វើ ខុស ជារៀងរាល់ ថ្ងៃ !
ឥឡូវ អ្នកសារព័ត៌មាន កំពុង មាន ឧបសគ្គ ក្នុង ការបំពេញ ការងារ ។
ក្រុម ឧទ្ទាម ម៉ៅ និយម បាន និយាយ ថា ពួកគេ កំពុង តស៊ូ ប្រយុទ្ធ ដើម្បី ការគ្រប់គ្រង សហគមន៍ និង សិទ្ធិ កាន់តែ ច្រើន ឡើង សម្រាប់ ក្រុម ជន កុលសម្ព័ន្ធ និង ប្រជាជន ក្រីក្រ នៅ ជនបទ ។
អ្នក ខ្លះ ទៀត និយាយ ថា ដល់ ពេល ហើយ ដែល ប្រទេស នីហ្សេរីយ៉ា ត្រូវ ដើរ ចេញពី ការពឹងផ្អែក របស់ ខ្លួន ។
រដ្ឋមន្ត្រី ថៃ សុំទោស ចំពោះ ការ និយាយ ថា ទេសចរ ណា អ…
ការពិត ជាក់ស្តែង ក្រុម មនុស្ស មួយចំនួន តែងតែ ទទួលបាន ឱកាស ការងារ …
ដូច្នេះ ប្រជាជន ដ៏ វិសុទ្ធ ត្រូវ មាន ចិត្ត ព្យាយាម និង មាន ជំនឿ ។
ដោយសារតែ សម្រស់ ស្រស់ស្អាត និង មាន ទេពកោសល្យ តារា ថៃ ទាំងនេះ សុទ្ធតែ ធ្លាប់ ល្បី រៀង ៗ
១ ខ្ញុំ ប៉ូល ជា អ្នក បំរើ របស់ ព្រះជាម្ចាស់ និង ជាសាវ័ក របស់ ព្រះយេស៊ូគ្រិស្ត ។
ប៉ុន្តែ ខុសពី ព្រះបិតា ដែល ចូលចិត្ត សោយ ស្រា បារាំង និង អាហារ ល្អ ៗ
ប៉ុន្តែ ការបដិវត្តន៍ នៅ កម្ពុជា ត្រូវបាន គេ ក្បត់ ។
លោក ពូទីន គាប់ ចិត្ត នឹង ភាពតានតឹង …
លោក បាន បន្ថែម ថា ពួកគេ ភាគ ច្រើន ប្រឈម នឹង បញ្ហា ដកដង្ហើម រាក រូស និង គ្រុន ក្តៅ ហើយ ពួកគេ មាន ជំងឺ ហង់ សិន ព្រោះ ពួកគេ រស់ នៅ គ្មាន អនាម័យ ។
អ្នកវិភាគ ឯករាជ្យ គឺ លោក បណ្ឌិត កែម ឡី ។
ហើយ លួច ដឹក សម្ភារៈ ចេញ ដោយ មិន បើក ប្រាក់ ឈ្នួល ឱ្យ កម្មករ ។
៧ មាន ការលាក់បាំង ច្រើន
មាន សិក្ខាកាម ត្រឹមតែ ៧០ នាក់ ប៉ុណ្ណោះ ។
សូម រង់ចាំ អាន ពិស្តារ ក្នុង សៀវភៅ អំពី ខ្សែ ជិវិត របស់ ខ្ញុំ ៕
ប៉ុន្តែ ពេល និយាយ អំពី តួលេខ នៅក្នុង របាយការណ៍ លោក បាន ថ្លែង ថា តួលេខ នោះ ហាក់បីដូចជា មាន កម្រិត ទាប ។
ហើយ ថត រូប ជា អនុស្សាវរីយ៍ ដើម្បី ជា ការចងចាំ និង មើល ម្តង ទៀត ពេល យើង ធុញ ថប់ ។
ប៉ុន្តែ មុន នេះ បន្តិច បាន ដឹងខ្លួន និង និយាយ បាន ខ្លះ ៗ
ធ្លាប់ មាន ក្តីសុបិន ចង់ ក្លាយជា តួ សម្តែង មែន ទេ ?
ទៅ មុខ បន្ទាប់ រូបថត ទាំង ១៩បន្ទាប់ ដែល គួរ ត្រូវបាន គេ ទុក យូរ មកហើយ
បើ តាម ការណែនាំ ម្ចាស់ រ…
លោក ដោក ប៊ុន ធួន នាយក សាខា
គេហទំព័រ ខ្មែរ ៧មករា អត្តឃាត ម្ចាស់ ពានរង្វាន់ ផលិត ករ ឆ្នើម អាយុ លើស ពី ២០ ឆ្នាំ របស់ ហេតុ អ្វី ត្រូវ បញ្ឈប់
ស្ត្រី មិន អាច រៀបការ ដោយ គ្មាន ការអនុញ្ញាត ពី អាណាព្យាបាល ប្រុស បាន ទេ ហើយ អ្នក ដែល ចង់ រៀបការ ជាមួយ ជន បរទេស ត្រូវតែ ទទួលបាន ការឯកភាព ពី ក្រសួង មហាផ្ទៃ ។
ប៉ុន្តែ រ៉ូម មាន ទំនាស់ ផ្ទៃក្នុង ជា បន្តបន្ទាប់ ។
ខ្ញុំ ចង់ បង្ហាញ ថា តើ មុខងារ នីមួយ ៗ
ប្រទេស ជប៉ុន មនុស្ស ជាង ១លាន ៦សែន នាក់ បាន ត្រូវ បង្ខំ ជម្លៀស ចេញ ពី ផ្ទះសម្បែង របស់ ខ្លួន !
ប្រុស ខ្លះ បើ បបួល ស្រី ម្នាក់ ហ្នឹង ដើរលេង បាន គេ អាច គិត ថា នាង ប្រហែល ចូលចិត្ត ដើរលេង ជាមួយ ប្រុស ៗ
មាន ៤ ចំណុច គ្រូមន្តអាគម អគ្គីនេត្រ ត្រូវ …
បរទេស នៅ ឆ្នាំ ២០១៦ នេះ មាន រឿង អាក្រក់ ជាច្រើន ដែល បាន កើតឡើង ក្នុង ចំណង ស្នេហ៍ របស់ តារា ហូលីវូត បើ រាប់ ត្រួស ៗ
ធម្មជាតិ នឹង កើត សារជាថ្មី មិន ដឹង មាន អ្នកណា ដឹង ថា វា មាន ន័យ យ៉ាងម៉េច នោះ ទេ
មាន លក់ ក្នុង ស្តុក
នោះ ទេ ប៉ុន្តែ យើង អាច កាត់បន្ថយ ការប្រើប្រាស់ ប្ល ស្ទិាក បាន ។
អាច លក់ ១ឡូត៍ ៗ
នេះ មិន គួរ ជា មូលហេតុ ដែល ធ្វើឱ្យ អ្នក ស្អប់ គាត់ នោះ ឡើយ ។
មាន អារម្មណ៍ មិន ដូចគ្នា ទេ ។
គង់ គាំក៏ បាន ធ្វើ ការ ផ្តាំផ្ញើរ ជូន ទៅដល់ ប្រជាពលរដ្ឋ ទាំង
គ្នា ដែល ទាក់ទង នឹង ប្រធានបទ តែ មួយ ។
ក្រៅពី ជា គូ ជីវិត នឹង គ្នា ឥឡូវ លោក ជា សុវណ្ណា រិទ្ធ និង ភរិយា ក្លាយជា ដៃគូ ពិធី ករ ទៀតផង ៕
ពួក រដ្ឋ អ៊ិស្លាម ដឹង ហើយ នា ពេលនេះ ។
អាហារូបករណ៍ នេះ ជា បំណងប្រាថ្នា របស់ និស្សិត ដែល មាន វ័យ ២៥ ឆ្នាំ រូប នេះ ។
មួយចំនួន និង ផ្លូវ ជាតិ នានា ផងដែរ ។
ដាក់ពាក្យ ប្តឹង អង្គការ ណា តូ ជាបន្ទាន់ !
តាំង អ្នក ឱ្យ ជា អ្នកនេសាទ មនុស្ស វិញ ម៉ាថា យ៤១៩ ។
វា មាន លក្ខណៈ អាក្រក់ សម្រាប់ សហភាព អឺរ៉ុប ក៏ ដូចជា ប្រទេស លោក ខាងលិច ។
ប៉ុន្តែ ជា ស្នេហ៍ ពិត បើ អ្នក ឃើញ សញ្ញា ទាំង ៥នេះ
ខ្ញុំ មិន ភិតភ័យ ហើយ ខ្ញុំ ពិតជា រំភើប ណាស់ ។
ដោយ មាន ការរិះគន់ ពី ប្រជាពលរដ្ឋ ច្រើន ទៅ ៗ
ខ្ញុំ ចង់ និយាយ រឿង មួយ ៖
ជំងឺ ជំងឺ ផ្លូវចិត្ត គួរ ដឹង !
ពលរដ្ឋ ទាំង៦ ខេត្ត នេះ នឹង មាន ផ្លូវកាត់ ទៅ លេង សមុទ្រ ឆាប់ ៗ
កាស៊ីណូ ផ្សាយ ផ្ទាល់ ទទួលបាន ប្រាក់ រង្វាន់ រហូតដល់ 25
មិន មាន ការលាក់បាំង បើ ដឹកនាំ តែ ឯក បក្ស នាំឱ្យ មាន ការបិទបាំង ព័ត៌មាន ច្រើន ។
ើង គាត់ បាន ចូល ទីលាន
សម្គាល់ ហើយ ខ្ញុំ សង្ឃឹម ថា វិនិយោគ
ដែល ការញែក ទាំងនោះ ជា ការសង្កេត ដោយ ខ្លួនខ្ញុំ ផ្ទាល់ និង តាម ដឹង ឮ ពី នេះ ពី នោះ ។
ពួកគេ មិន បាន និយាយ ទៅកាន់ ប្រជាជន នោះ ទេ ។
ស្ត្រី ឞុ ទុឞ្តា សុវ៌្ឞ្ណោយ ជាយ តេវ៌្ណ សំករះ ៕
ទៀត សម្រាប់ ការរស់នៅ របស់ ពលរដ្ឋ ។
ក្នុង នោះ មាន ប្រយោគ សរសេរ ថា ក្នុង ពេល ដែល យើង កំពុង រួមគ្នា ប្រឆាំង នឹង ខ្មាំង សត្រូវ ថ្មី ចូរ រួមគ្នា បួងសួង ឱ្យ ប្រទេស អង់គ្លេស ។
ទៀត នៅ អឺរ៉ុប ហើយ កាលពី ថ្ងៃព្រហស្បតិ៍ បាន ប្រកាស ការបន្ត លើ វិធានការ ទាំងនោះ ៣សប្តាហ៍ ទៀត ។
សំណុំរឿង របស់ ជន នេះ នឹង ត្រូវ ឆ្លងកាត់ ប្រព័ន្ធ តុលាការ ផ្សេង ៗ
អ្នក ទាំង ពីរ ក៏ យល់ព្រម អោយ គាត់ ទៅ សាកល្បង លមើល ។
ស្ថាប័ន ត្រូវការ អ្នក ធ្វើ ច្រើន ជាង អ្នក និយាយ …!
ប៉ែន ចំរ៉ុង បាន រៀបការ ជាមួយ អ្នកនាង ហ៊ុន ម៉ាណេ កាលពី ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩
វៀតណាម ក៏ បាន ចាក់បញ្ចូល ទុន វិនិយោគ យ៉ាង ច្រើន ក្រាស់ក្រែល នៅក្នុង វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ ។
តាមពិត ទៅ ខ្ញុំ ធ្លាប់ មក លេង ទីនេះ ច្រើន ដង ដែរ ។
នាង ចង់ រក្សា សម្រស់ ធម្មជាតិ របស់ នាង ។
មិន ថា និកាយ ណាមួយ នៅក្នុង ជំនឿ គ្រីស្ទ បរិស័ទ ទេ គឺ សុទ្ធតែ ជឿ លើ សេចក្តីពិត ដ៏ សាមញ្ញ មួយ ដែល ថា ៖
ម្យ៉ាងទៀត សារ នេះ ក៏ ជា រំឭក អស់ ប្អូន ៗ
ខ្ញុំ គិត អំពី បញ្ហា នេះ ។
លោកគ្រូ មាន ត្រណម មួយ នៅ ថ្ងៃ កោរ ពុកចង្ការ ។
ហើយ ពី អស់ អ្នក ដែល ស្អប់ ទូលបង្គំ ដែរ
១ ខ្ញុំ ជា ចាស់ទុំ សូម ជំរាប មក លោកស្រី ដែល ព្រះជាម្ចាស់ បាន ជ្រើសរើស និង ជំរាប មក កូន ចៅ របស់ លោកស្រី ដែល ខ្ញុំ ស្រឡាញ់ តាម សេចក្តីពិត មិន មែន តែ ខ្ញុំ ប៉ុណ្ណោះ ទេ ដែល ស្រឡាញ់ គឺ អស់ អ្នក ដែល បាន ស្គាល់ សេចក្តីពិត ក៏ ស្រឡាញ់ ដែរ ២ព្រោះតែ សេចក្តីពិត នៅ ជាប់ នឹង យើង ឥឡូវនេះ ហើយក៏ នឹង នៅ ជាមួយ យើង រៀង រហូត អស់ កល្ប ជានិច្ច ។
សូម ងាក មើល ការធ្វើ សង្គ្រាម របស់ ខុង បេង ។
ចាប់ផ្តើម មុន ដំបូង ខុស ទៅ ហើយ នីតិវិធី នោះ !
លុះ ព្រលឹម ឡើង អ្នក អាច វិលត្រឡប់ ទៅ លំនៅដ្ឋាន របស់ អ្នកវិញ ។
ប្រើ វិធី ទាំងនេះ ធានា ថា ទឹកមាត់ អ្នក នឹង ប្រៃ និយាយ អ្វី គឺ គេ ឆាប់ ជឿ ស៊ប់
អ្នក មិន គួរ វាស់វែង អាយុកាល ថ្ម ទូរសព្ទ អ្នក ជា ចំនួន ឆ្នាំ នោះ ទេ ដោយឡែក ចំនួន សាក ទៅ វិញ ទេ ដែល ជា អ្នក កំណត់ អាយុកាល នៃ ថ្ម ទូរសព្ទ ។
និង ចៅ លោកស្រី សុខចិត្ត ទៅ ធ្វើការ នៅ ប្រទេស ម៉ាឡេស៊ី ដោយ ប្រថុយប្រថាន ។
គ្រួសារ ដែល នៅ សេសសល់ នឹង ទទួលបាន ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី នៅក្នុង ឆ្នាំ ២០២១ ។
យើង ការពារ ប្រជាពលរដ្ឋ យើង និយាយ រឿង ហ្នឹង ។
លុះ ព្រឹកឡើង ទើប សមត្ថកិច្ច ចុះ ទៅ ផ្ទះ កើត ហេតុ ធ្វើ ការសាកសួរ ដើម្បី ស្រាវជ្រាវ រក ជនល្មើស មក ផ្តន្ទាទោស តាម ច្បាប់ ។
ជួនកាល គាត់ គិត តែ ពី រឿង ដែល គាត់ ចង់បាន កម្រិត ខ្ពស់ ទាល់តែ ប្រាក់ ខ្ពស់ បាន ធ្វើ ហើយ អារម្មណ៍ អស់ ហ្នឹង វា នៅតែ ដិត ក្នុង អារម្មណ៍ កម្មករ របស់ យើង ស្ទើរតែ ទាំងអស់ ទៅ ហើយ ។
តមក ទៀត ខ្ញុំ ក៏ ត្រឡប់មក រស់ នៅ ភូមិ កំណើត វិញ និង ប្រកបរបរ ធ្វើ ស្រែ ចម្ការ មក ទល់ សព្វ ថ្ងៃ នេះ ៕
ការឡើង ទម្ងន់ គឺជា សត្រូវ របស់ មនុស្ស ស្រី គ្រប់ ៗ
ខាងក្រោម នេះ គឺជា អត្ថប្រយោជន៍ មួយចំនួន ដែល អ្នក នឹង ទទួលបាន ប្រសិនបើ អ្នក បាន ក្រោក ពី ដំណេក នៅក្នុង ពេលព្រឹក ព្រលឹម ៖
អ្នក ដែល មាន បញ្ហា សន្លាក់ មិន គួរ ទទួលទាន គ្រឿងស្រវឹង ឡើយ ទោះ ក្នុង កម្រិត មធ្យម ក៏ដោយ ៕
គាត់ ពុំ បាន យក ព្រះជាម្ចាស់ ជា ទីពឹង ទេ
យើង ស្វាគមន៍ ការវិនិយោគ ពី ក្រុមហ៊ុន ឯកជន ។
រវាង ខ្ញុំ និង នាង គឺ មាន ការខុសគ្នា តែ បន្តិចបន្តួច ប៉ុណ្ណោះ ។
មិត្ត ដែល ស្រលាញ់ យើង យល់ ចិត្ត យើង មិន ចាំបាច់ ជា មនុស្ស ក៏ បាន ដែរ
លក្ខណា ទ្វារ ផ្ទះ បែប នេះ កាន់តែ ប្រសើរ ពេល អ្នក បើកចំហ ទ្វារ ទាំង សងខាង ។
អ្នក ត្រូវតែ ចងចាំ នូវ ការ ប្រើប្រាស់ ពាក្យសម្តី អោយ សមស្រប ទៅតាម កាលៈទេសៈ និង ពេលវេលា អោយ បាន ត្រឹមត្រូវ ។
៩ ប្រសិនបើ គាត់ គ្មាន កូនស្រី ទេ ត្រូវ ប្រគល់ កេរ មត៌ក ទៅ អោយ បងប្អូន របស់ គាត់ ។
ចន្ទ្រា ជា អ្នក ប្រដាល់ មួយ រូប ដែល ល្អ ហើយ ការប្រកួត របស់ គេ កម្រ ជួប បរាជ័យ ណាស់ ។
គណបក្ស ពីរ បាន ចង សម្ព័ន្ធភាព គ្នា នៅ ព្រឹក នេះ រស្មី កម្ពុជា
អស់ លោក ត្រូវការ ច្រើន ណាស់ ក្នុង ការលើក ជា ផែនការ ដើម្បី អភិវឌ្ឍ ក្នុង ភូមិ ឃុំ ។
មនុស្ស ទី មួយ ដែល ត្រូវ ទទួលខុសត្រូវ គឺ ខ្ញុំ ។
នៅក្នុង នោះ ប្រមាណ ជា ២០ កញ្ចប់ ។
ការលះបង់ អ្វី ដែល មិន ស្ថិតស្ថេរ ដើម្បី ទទួលបាន នូវ ព្រះពរ ដ៏ អស់ កល្ប ជានិច្ចជា ការបណ្តាក់ទុន ដ៏ ល្អ ។
ផ្ទះ គេ នៅក្បែរ នេះ កន្លងទៅ ថ្មី ៗ
គេ តែ ប៉ុណ្ណោះ ព្រោះ ការឈ្នះ ឆ្នោត របស់ គណបក្ស កាន់អំណាច គឺ ដោយសារតែ គណកម្មាធិការ
ហើយ និង ច្បាប់ កុងត្រា ពាណិជ្ជកម្ម ជាដើម ។
ប្រជាជន និង អ្នកនយោបាយ របស់ ប្រទេស នេះ កំពុង សម្លឹក មើល ការផ្លាស់ប្តូរ ជន ផ្តាច់ការបាន ដោយ ជោគជ័យ ។
សម្រាប់ លោក សម រង្ស៊ី វា ហាក់បីដូចជា មាន ការលំបាក នៅក្នុង ការរង់ចាំ ព្រោះ គាត់ មាន អាយុ 64 ឆ្នាំ ។
នៅក្នុង បន្ទុក ក្រុមគ្រួសារ មាន សេចក្តីសុខ យ៉ាង ក្រៃលែង ។
ក្រុម ណា មាន សង្ឃឹម នៅក្នុង រាត្រី នេះ ?
ប៉ុន្តែ គេ មិន បាន ស្តាប់ តាម ដំណឹង ល្អ ទាំងអស់ គ្នា ទេ ដ្បិត លោក អេសាយ មានប្រសាសន៍ ថា ឱ ព្រះអម្ចាស់ អើយ តើ មាន អ្នកណា ខ្លះ បាន ជឿ សេចក្តី ដែល យើងខ្ញុំ ប្រាប់ រ៉ូម ១០១១ - ១៦ ។
នៅពេល យើង ឃើញ ភាព អសកម្មភាព អវិជ្ជមាន យើង ត្រូវតែ រិះគន់ ។
លើ ក្រុមហ៊ុន នេះ នា ពេល អនាគត ។
ជាពិសេស នោះ ខ្ញុំ ចង់ឱ្យ អនាគត ភរិយា ខ្ញុំ សប្បាយ ចិត្ត ហើយ ខ្ញុំ នឹង ផ្តល់ អ្វី គ្រប់ ដល់ នាង ។
សព ជនរងគ្រោះ ឈ្មោះ កាត់ គឹម សួ
ខ្ញុំ ជំពាក់ គេ ដោយសារ ធ្វើ ស្រែ បានជា ខ្ញុំ ប្រកបរបរ ដុត ធ្យូង លក់ ។
មួយចំនួន កំពុង បង្ហាញ ខ្លួន និង កំពុង មាន ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ផងដែរ ។
ដូច្នេះ បាន បញ្ចាក់ អំពី តម្លៃ !
ម្យ៉ាងទៀត វា អាច កើត ដោយសារតែ តំណ ពូជ ហ្សែន ផងដែរ ។
ព្រះយេស៊ូវ ដែល ជា ព្រះរាជ បុត្រា ទ្រង់ គឺជា អត្ថន័យ នៃ បុរស ដ៏ ពិត ដែល ល្អ ឥត ខ្ចោះ ។
ប៉ុន្តែ មាន អ្នក ខ្លះ ពុំ គិត ដូច្នោះ ទេ ព្រោះ គេ ស្រលាញ់ងប់ មិន អាច ដកចិត្ត រួច ឡើយ ។
ជា ការពិត ណាស់ យើង ម្នាក់ ៗ
វិទ្យាស្ថាន ស្លឹក រឹត កើតឡើង ពី ចិត្ត ស្អប់ និង ចិត្ត ស្រឡាញ់
គ្មាន នរណា អាច យល់ ពី ជម្រៅ ចិត្ត របស់ អ្នកម្តាយ បាន ឡើយ ។
ចិន ច្រានចោល ការចោទ របស់ អាមេរិក ដែល …
ទូរទស្សន៍ ក្នុង ស្រុក មួយចំនួន ក៏ ធ្លាប់ ប្រើប្រាស់ មធ្យោបាយ នេះ ដែរ ៕
ការបញ្ចូល គ្នា - ត្រជាក់ រួមបញ្ចូល គ្នា
ឡើយ ប៉ុន្តែ វា ត្រូវការ ពេលវេលា យូរ ដែរ ៕
ពត៌មាន ប្រចាំ ថ្ងៃ ស្នេហា និង ផ្លូវភេទ សុវត្ថិភាព អត់ ដែល រួមភេទ ទាំង កំពុងតែ មក រដូវ ?
ទោះបី បាត់ដំណឹង ជាច្រើន ឆ្នាំ ក៏ន …
មិន ត្រូវ សម្លឹងមើល អ្វី ដែល មាន ពន្លឺ ខ្លាំង ពេក ឬ តិច ពេក ។
ការសម្រក ទម្ងន់ អាច ធ្វើឡើង ដោយ ជោគជ័យ មិន ថា អ្នក នៅ ក្មេង ឬ មាន អាយុ ច្រើន ។
ជា អាទិ៍ គេ គួរ មាន វិធានការ ការពារ សុវត្ថិភាព ពត៌មាន ក្នុង កំរិត សមស្រប មួយ ។
ការប្រារព្ធ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ថ្ងៃទី ៩ ខែវិច្ឆិកា នៅ ឆ្នាំ នេះ ធ្វើឡើង ដោយ មិន សូវ មាន ភាព អ៊ឹក ធឹក ដូច ឆ្នាំ មុន នោះ ទេ ។
លើក នេះ អត់ មាន អ្នក ពន្យល់ ឱ្យ ច្បាស់លាស់ ។
លោក បន្ត ថា ភាព វិជ្ជមាន នេះ នឹង មិន អាច បញ្ចប់ នៅពេល ឆាប់ ៗ
របស់ ខ្ញុំ ធ្វើ អាជីវកម្ម ដោយ សុចរិត និង ស្រប ច្បាប់ ដោយ គោរព យ៉ាង ហ្មត់ចត់ តាម ច្បាប់ របស់ កម្ពុជា ។
ញ៉ាំ ស៊ុត រាល់ ថ្ងៃ ប៉ះពាល់ សុខភាព បេះដូង អត់ ?
ប្រសិនបើ ស្ថាប័ន នេះ បរាជ័យ នោះ មាន ន័យ ថា ព័ន្ធ កិច្ច ផ្សេង ៗ
ចំណែកឯ បាយ ដែល ចម្អិន ចេញ ពី អង្ករ ប្លាស្ទិក នឹង មិន ផ្អូម ឡើយ ៕
សកម្មជន សិទ្ធិ មនុស្ស ប៉ាគីស្ថាន ម្នាក់ ដែល បាន និយាយ រិះគន់ ប្រឆាំង នឹង កងទ័ព បាន រត់ ចេញ ពី ប្រទេស ទៅកាន់ សហរដ្ឋ អាមេរិច ក្រោយពេល លាក់ ខ្លួន អស់ រយៈពេល ជាច្រើន ខែ ។
ដែល កំពុង កើតឡើង ជាមួយ អាជីវកម្ម ឬ អតិថិជន របស់ យើង ដូចជា សេដ្ឋកិច្ច ពួកគេ មាន លុយ ពី ណា មក ហូប ?
នៅ កន្លែង ធ្វើការ ឬ នៅ កន្លែង សាធារណៈ ។
ទៀត ដោយសារតែ វា ធ្វើដំណើរ ក្នុង ទម្រង់ ជា រលក ខ្លី ៗ
លោក លោកស្រី មាន ចំណាប់អារម្មណ៍ សូម ទំនាក់ទំនង ៖
យ៉េតាស៊ី ក្លួ ធ្លាក់ ទឹក ហើយ របូត កន្សែង ទៀត
បើ ទោះបី វា ជា បញ្ហា ដែល ច្រើន កើតមាន ប៉ុន្តែ វា មិន មាន នរណា ម្នាក់ បាន ដឹង ពី រឿង ដំបូង នៃ ការឡើង ខ្ពស់ នៃ ទ្រីគ្លីសេរីត នេះ ទេ ។
ជួនកាល យើង ពិតជា មិន ដឹង ពី សមត្ថភាព និង ទំនោរ របស់ ខ្លួន ឡើយ ។
ខ្ញុំ ជឿ ថា ពាក្យ ព្រះបាន វិវត្តិ នា សម័យ នេះ
តើ មនុស្ស ប៉ុន្មាន នាក់ នឹង ស្លាប់ បើ មាន សង្គ្រាម ម្តង ទៀត ៕
អ្នកណា ជា អ្នកគ្រប់គ្រង សុវត្ថភាព ចំណីអាហារ ?
អ្នក ប្រវត្តិសាស្ត្រ ហ្សាង លីហ្វាន់ និយាយ ថា ប្រហែលជា មិន អាច ធ្វើ ទៅ បាន ទេ ។
ក្នុង នាម ជា មេ គ្រួសារ មួយ រូប វា ពិបាក ណាស់ សម្រាប់ ខ្ញុំ ក្នុង ការរក្សា ទម្លាប់ នេះ ឱ្យ នៅតែ មាន ។
ប្រទេស ឥណ្ឌូនេស៊ី បន្ទាប់ពី មាន ការស៊ើបអង្កេត អស់ រយៈពេល ២ខែ ។
ខ្ញុំ ចង់ ធ្វើឱ្យ ប្រាកដ ថា បទចម្រៀង ទាំងនេះ មាន សំឡេង ដូច ទៅនឹង អារម្មណ៍ របស់ ខ្ញុំ ៕
ពួកគេ រៀបរាប់ អំពី និមិត្ត ហេតុ
ការបញ្ចេញមតិ មាន ការថយចុះ ដោយសារ អាស៊ី សេរី មិន បាន ចុះផ្សាយ អោយ ដូច ពីមុន !
បំភ្លឺ , អេក្រង់ កាន់តែ ធំ
ពី នេះ ពី នោះ កំនត់ ហេតុ ខ្ញុំ
ពួកគេ ឥត មាន សេចក្តីស្រឡាញ់ របស់ ព្រះ នៅក្នុង ចិត្ត របស់ ពួកគេ ទេ យ៉ូហាន ៥៤២ ។
យើង លំបាក ណាស់ ទម្រាំ បាន មកដល់ ពេលនេះ ។
នេះ គឺជា កំហឹង ដែល លោក អ្នក ត្រូវតែ មាន ចំពោះ អ្នក ដែល ផលិត រូបភាព មិន ល្អ ទាំងនោះ ដែរ ។
ហើយ ជារៀងរាល់ ពេល មួយ ខែ ម្តង នាង តែងតែ ទៅ ពិនិត្យ និង សម្អាត ធ្មេញ ជាមួយ ទន្ត ពេទ្យ ផងដែរ ។
ហេតុ នេះ ស្ត្រី ទាំងនោះ មាន ចំណេះដឹង ខ្លះ ៗ
កាល ក្វាន ចុង ប្រើ ធ្នូ បាញ់ ព្រះអង្គ គឺ
ទាំងអស់ នោះ ទេ បើសិនជា គ្មាន ប្រាក់ តើ ស្នេហា របស់ អ្នក នឹង អាច យូរ ដល់ ប៉ុណ្ណា ?
ពួកគាត់ ទើប ជា ជនរងគ្រោះ ពិតប្រាកដ មិន មែន ឈុត ឆាក ល្ខោន ទេ ។
ព្រះតេជ ព្រះគុណ ចាន់ សុផាន បន្ត ថា ៖
បេក្ខជន ពេជ្រ ថៃ កូរ ពេញ ឆាក រហូត បង្វិល កៅអី ទាំង៣ របស់ គណៈកម្មការ !
ការសម្រេច នានា អាចនឹង ធ្វើឡើង នៅក្នុង ឱកាស វេទិកា កំពូល មួយ ទៀត នៅក្នុង ឆ្នាំ នេះ ។
មិន ខ្ចី ខ្លាច ប្រេត ស៊ី វងឹម ងួន
រកឃើញ ករណី កូវីដថ្មី ១ករណី នៅ ព្រឹក នេះ
យើង ត្រូវតែ មាន ទំនុកចិត្ត ខ្ពស់ លើ ខ្លួន ឯង ។
ករណី ណា ដែល ត្រូវបាន អនុវត្ត វិធី សាកែ ពង្រីក សុដន់ យារ ធ្លាក់ ឡើងវិញ
លោក មិន ឃិន ចូលរួម ក្នុង កម្មវិធី អប់រំ សិស្ស និង កូន ចៅ ប្រជាពលរដ្ឋ
លោក អ្នក គួរតែ ចេះ ធ្វើឱ្យ ខ្លួន ឯង រីករាយ ។
បើ ទោះ ធ្លាប់ ត្រូវ គេ តាម សម្លាប់ ក៏ មិន បោះបង់ ការងារ ការពារ សិទ្ធិ កម្មករ - វិទ្យុ វា យោ
នៅក្នុង ដំណាក់កាល នោះ បងប្អូន បាន ផ្ទះ ស្នាក់ ហើយ ។
រថយន្ត ដឹក ទំនិញ ទាំងនោះ ត្រូវបាន គេ ទម្លាយ ថា គយ បាន ឃុបឃិត គ្នា ឱ្យ ឈ្មួញ ដឹក តាម អំពើចិត្ត ជា ថ្នូរ ទៅ ផលប្រយោជន៍ អាច តាម របៀប ពុក លួយ ។
បាទ ហ្គេយ៍ មាន គ្រប់ សម័យកាល គ្រាន់តែ កាល នោះ គេ មិន ទាន់ ដឹង សារជាតិ របស់ ខ្លួន ប៉ុណ្ណោះ ។
និង សារ មួយចំនួន ទៀត ដើម្បី អបអរ ទិវា នេះ ។
ប្រាសាទ អង្គរវត្តមាន សំណង់ រឹងមាំ ល្អ ហើយ ស្អាត ។
ម្យ៉ាងទៀត គេ នឹង អាច ចងចាំ ពី វត្តមាន របស់ យើង ផងដែរ ។
