ទ្រង់ ហោះ រំលង ព្រះរាជ វាំង ទោះ មារ មក
ដូច្នេះ ពួកគេ ពិតជា ត្រូវ មាន ដៃគូ ចម្រុះ ។
ពួកគេ មិន រំលង វីធី ណាមួយ ឡើយ នេះ ជា ដើឹមហេតុ ដែល ធ្វើឱ្យ ពួកគេ មាន សម្រស់ ស្រស់ស្អាត ជានិច្ច ។
តើ មាន ពលរដ្ឋ ប៉ុន្មាន % ដែល មាន ប្រាក់ គ្រប់គ្រាន់ សំរាប់ ព្យាបាល ជំងឺ ?
ស្រី ស្រស់ ម្នាក់ ធ្លាក់ ពីលើ ខុនដូរ ជាន់ ទី ១២
ព្រះយេស៊ូវ ទ្រង់ មិន បាន មាន បន្ទូល ចេញ ហើយ មិន បាន ការពារ ខ្លួន ទ្រង់ សោះ នៅ ពេល ដែល ទ្រង់ ត្រូវបាន គេ វាយ ហើយ ឆ្កាង ទ្រង់ ដូចជា ទ្រង់ មាន បន្ទូល ទៅកាន់ លោក ពី ឡាត់ ខ្ញុំ បាន កើត មក ហើយក៏ ចូលក្នុង លោកីយ៍ នេះ សំរាប់ តែ ការ នោះ ឯង យ៉ូហាន ១៨៣៧ ។
ថ្ងៃ មួយ ពួក ខ្ញុំ បបួល វា ចេញមក ទាត់ បាល់ ដើម្បី កាត់
ខ្ញុំ មិន ដឹង ថា វុធ និយាយ បែប នេះ គ្រាន់
លុយកាក់ កើនឡើង ។
ហើយ ដើរ វង់ ទៅដល់ ជើង មេឃ ម្ខាង
ដោយ គម្ពីរ ជួយ សំរាល ទុក្ខ យើង និង អោយ យើង ចេះ ស៊ូទ្រាំ យើង មាន សេចក្តីសង្ឃឹម ។
ថ្ងៃ នេះ មាន ឱកាស រក ចំណូល ល្អ គួរ ឧស្សាហ៍ ទាក់ទង ជាមួយ មិត្តភក្តិ ។
ការបង្រៀន ថ្នាក់ និទស្សន៍ ស្តីពី គណិតវិទ្យា ពេលវេលា សាលារៀន អន្តរ ទ្វីប អាមេរិកាំង
យើង ក៏ មាន ផែនការសួរចម្លើយ ប្រពន្ធ របស់ ជន នោះ ហើយនិង អ្នកជិតខាង របស់ ពួកគេ ។
បន្ទាប់ ទាញយក វីដេអូ
ប្រការ នេះ មាន ន័យ ថា ចំណែក នៃ ការនាំចេញ សព្វាវុធ អន្តរជាតិ ទាំងអស់ របស់ ចិន បាន កើនឡើង ៥ភាគរយ ពី ចំនួន ២ភាគរយ ហើយ ប្រទេស នេះ បាន លោត មកពី លេខ ៨មក លេខ ៥ក្នុង តារាង ចំណាត់ថ្នាក់ ។
បន្ទាប់ពី ចេញដំណើរ បាន មួយ ភ្លែត នៅពេល យន្តហោះ នេះ បាន ជួប នឹង អាកាសធាតុ អាក្រក់ ។
ការហាត់ របៀប នេះ បាន ជួយ ខ្ញុំ កុំ ឱ្យ ឈឺចាប់ ខ្លាំង ពេក ។
បើ គ្រប់គ្រង អោយ ស្រួល មិន មាន អំពើពុករលួយ មិន ខ្វះ ទេ លុយ ។
អ្នក ក៏ អាច ប្រាកដ ក្នុង ចិត្ត ថា ព្រះនឹង បំបាត់ ការឈឺចាប់ និង អំពើ អយុត្តិធម៌ ដែរ ។
យ៉ាងណា ក៏ដោយ លោក នឹង ឱ្យ មន្ត្រី ចុះ ទៅ ពិនិត្យមើល ។
ខ្ញុំ មិន ដឹង ឆ្លើយ បែប ណា ទេ ព្រោះ គ្មាន អ្វី ក្រៅពី មាន អ្នក នៅក្បែរ ខ្លួន ផង ។
គ្នា កំពុង កោត ស្ញប់ស្ញែង នឹង ការ ទាំង ប៉ុន្មាន ដែល ព្រះអង្គ បាន ធ្វើ ព្រះយេស៊ូ មាន ព្រះបន្ទូល ទៅ ពួក សាវ័ក ថា ៖
មាន បំណង ចង់ ប៉ះ អ្នក
កងទ័ព ចិន និង ឥណ្ឌា ប៉ះទង្គិច គ្នា ជាថ្មី ម្តង ទៀត នៅ ព្រំដែន តំបន់ ភ្នំ ហិមាល័យ
៨លោក សូល ក្រោក ឡើង ទោះបី គាត់ ខំប្រឹង បើក ភ្នែក យ៉ាងណា ក៏ដោយ ក៏ គាត់ មើល អ្វី មិន ឃើញ ដែរ ។
ចាប់តាំងពី ឆ្នាំ ២០០៥ រហូតដល់ ថ្ងៃ នេះ ខ្ញុំ មិន ដែល ត្រលប់ ទៅ ភូមិ នោះ វិញ ទេ ។
កាតា បាន ឆ្លើយតប វិញ ថា ទាំងអស់ នេះ គឺជា រៀបចំ បំប៉ោង ដោយសារតែ គេ ចង់ ត្រួតត្រា លើ អធិបតេយ្យភាព របស់ កាតាតែ មិន បាន សម្រេច ។
គាត់ អត់ ខ្វល់ រឿង កម្មករ បាត់បង់ ការងារ ។
លោក ថ្លែង នៅឯ រដ្ឋសភា កាលពី ពេល នោះ ថា ៖
វា ជា ឋានសួគ៌ ក្លាយជា ឋាន នរក ភ្លាម ៗ
ពេលនេះ គ្មាន ទូរស័ព្ទ ហ្វេសប៊ុក ទេ - ទស្សនាវដ្តី វិទ្យាសាស្ត្រ កុំព្យូទ័រ
ហើយ គាត់ អាច កំណត់ នាទី ដល់ ភ្លើង ស្តុប ហ្នឹង បាន ។
ការងារ មាន ឱកាស ល្អ មកដល់ អ្នក កុំ ខកខាន ឱ្យ សោះ ។
គឺ ដើម្បី យកមក បម្រើ នូវ សេចក្តីសប្បាយ របស់ ខ្លួន ឯង តែ គេ មិន បាន ដឹង ទាល់តែសោះ ថា ខ្លួន គេ កំពុងតែ ក្លាយជា អ្នកបម្រើ នៃ សម្ភារ ទាំងអស់ នោះ ព្រោះតែ បំពេញ តណ្ហា របស់ ខ្លួន ឯង ទៅ វិញ ទេ ។
ឥស្សរិយ ស្មឹឋ បេតិ
លោក ថា កំហុស នេះ ត្រូវ ដោះស្រាយ ទៅ តាម ច្បាប់ បោះឆ្នោត កំណត់ ៖
ការរៀបរាប់ ខាងលើ នោះ វា មិន ត្រឹមត្រូវ ទេ ។
ចូរ យើង ព្យាយាម ស្វែងរក ដំណោះស្រាយ ដោយ គ្មាន ការរារាំង ឬ ក៏ លក្ខខណ្ឌ ជាមុន អ្វី នោះ ឡើយ … ។
អាខ្វាក់ ហ៊ុន សែន អើយ ឯង ធ្វើបាប ខ្មែរ ថ្ងៃ ណាមួយ អា និង ពូជ អា ត្រូវ ទទួលរង កម្ម
នៅ មុខ តុលាការ មិន ប៉ះពាល់ ដល់ សវនាការ ទេ ៕
ប៉ុន្តែ នេះ គ្រាន់តែ ជា ទ្រឹស្តី ប៉ុណ្ណោះ មិន ដែល ធ្លាប់ ទទួលបាន ផ្លែ ផ្កា នោះ ទេ ។
ខ្ញុំ ធ្វើ ខ្ញុំ និយាយ គឺ ខ្ញុំ ដឹង តែ មិន អាច កែ បាន ទេព សុវិចិត្រ
នៅ ឆ្នាំ នេះ ដោយសារតែ គោល នយោបាយ ផ្តល់ ប្រាក់ ដល់ ជន ចាស់ជរា ចាប់ពី អាយុ ៦៥ ឆ្នាំ ឡើង ក្នុង ម្នាក់ ៗ
ទៅ លើ សេវា ថែទាំ សុខភាព របស់ ពួកគេ ។
ពួកគេ ចូលចិត្ត បង្ហាញ ពី គំនិត ដែល ពួកគេ មាន ទៅ អ្នកដទៃ ។
ដី សំរាប់ លក់ ឬ ជួល បន្ទាន់
ជជែក រ៉ូឡែត - វីដេអូ ជជែក ពិភពលោក
ខ្ញុំ ចូលចិត្ត អូអិឈិ ដែរ តែ ចូលចិត្ត រស់ជាតិ ស្រូវ សាឡី …
ម៉ារិនី យល់ ច្បាស់ ណាស់ ថា ពួកគាត់ មិន មាន ប្រាក់ ចំណាយ ចូល ហាង ញ៉ាំ អាហារ ទាំងនោះ ទេ ។
ប្រជារាស្ត្រ ព្រមទាំង វិនាស អន្តរាយ ដល់ ប្រទេសជាតិ ទេ នោះ
និង កម្មវិធី បែប ផ្លូវការ ជាច្រើន ក្នុង ការធ្វើជា ពិធីការិនី ។
ថ្លែង ទៅកាន់ លោកគ្រូ …
តោះ កុំ ឱ្យ រង់ចាំ យូរ ទៅ មើល អាយ ដល របស់ អ្នក ថា បច្ចុប្បន្ន ពួកគេ កំពុងតែ ជិះ រថយន្ត មួយ ណា ៖
ដូច្នេះហើយ គួរតែ មនុស្ស ម្នាក់ ៗ
ខ្ញុំ ឈឺ ដោយ រោគ ស្រឡាញ់ ។
មួយ ខែ ក្រោយមក ថៅកែ ក្រុមហ៊ុន បាន ប្តឹង កម្មករ ទៅកាន់ តុលាការ ។
ការគិតគូរ បែប នេះ ធ្វើឡើង ខណៈ មាន ការរំពឹង ថា នឹង មាន ការបាត់បង់ ការងារ បន្ថែម ទៀត នៅ ប៉ុន្មាន ខែ ខាងមុន ។
ខ្ញុំ បាន ចំណាយ ពេល ១៨ ឆ្នាំ នៅក្នុង គុក - ខ្ញុំ បាន ជួយ ដល់ ថ្នាក់ ទាំងនោះ ដោយ បទពិសោធន៍ ។
៨រាល់ តែ ព្រឹក ទូលបង្គំ នឹង បំផ្លាញ អស់ ពួក មនុស្ស អាក្រក់
ដែល ប្រើ វា តែ ប៉ុណ្ណោះ ។
កនហងៃង យប់ នីមួយ ៗ
លោក សម រង្សី បាន និយាយ ក្នុង កិច្ចសម្ភាសន៍ …
បញ្ហា នោះ ធ្វើឱ្យ វា លំបាក ខ្លាំង ណាស់ សម្រាប់ អ្នកកាសែត ក្នុង ស្រុក ។
ដ្បិត ក្រៅពី ព្រះអង្គ គ្មាន នរណា ផ្សេង
គាត់ បាន អ្នក បង្កើត សាលា នៃ ឧក្រិដ្ឋកម្ម របស់ ប្រទេស អ៊ីតាលី ។
វា ក៏ ប្រហែលជា ធ្វើឱ្យ អ្នក ងាយ
៦. ភាគ ច្រើន មិន ទាន់ ចេះ បែងចែង រវាង ការចំណាយ ល្អ និង អាក្រក់
ស្រួល ណាស់ ហើយ ស្រាល ផង ។
និង អំពើ ទុច្ចរិត របស់ គេ ទៀត ដែរ ។
បញ្ចេញ យោបល់ អ្នក លើ ប្រធានបទ នេះ ទៅ កុំ អោយ នៅសង្ស័យ !
យើង ប្រើ សើម ចំណេញ ជាង ស្ងួត តែ ពិបាក ដឹកជញ្ជូន ធ្ងន់ ។
ទូទៅ មាន ប្រជាពលរដ្ឋ ខ្លះ ពួក ក្រុម ប្រឆាំង ទេ ដែល វា ភ័យ ។
វា ជា ការពិត ហើយ ខ្ញុំ ក៏ សង្កេតឃើញ ថា ពិត ដែរ គឺ តែងតែ មាន ដំណោះស្រាយ ចំពោះ បញ្ហា ជានិច្ច ។
មន្ត្រី ប៉ូលីស បាន ឱ្យដឹង ថា ពួកគេ បាន រកឃើញ គ្រាប់បែក ចំនួន ២ នៅក្នុង ឡាន ចំនួន ២ផ្សេង គ្នា ។
វា មាន សំឡេង ខ្លាំង ៗ
ការឆ្លង មេរោគ លើ ផ្លូវ ដង្ហើម ផ្នែក ខាងលើ ត្រូវ ហើយ មិន មាន ត្រូវ ហើយ ពីរ %
ពិតជា រំខាន មែន ។
ច្បាប់ គេ តម្រូវ ឱ្យ មាន សញ្ជាតិ តែ មួយ ។
តាមពិត ទៅ ខ្ញុំ ស្តាប់ ឮ អ្វី ទាំងអស់ តាម ជញ្ជាំង ។
ទារក វ៉ក ឃើរ ពហុ មុខងារ វ៉ក ឃើរ ជាមួយ តន្ត្រី និង ពន្លឺ
នេះ ជា ព្រឹត្តិការណ៍ ដែល កើត នៅក្នុង រយៈពេល ៦ខែ នៃ ចុង ឆ្នាំ ២០១២ ចំណែកឯ រាល់ ព្រឹត្តិការណ៍ ដែល បាន កើតមាន នៅក្នុង រយៈពេល ៦ខែ …
បើ សេវាកម្ម ដែល អ្នក កំពុង ប្រើ អនុញ្ញាតឱ្យ អ្នក បង្កើត សំណួរ ផ្ទាល់ខ្លួន ព្យាយាម បង្កើត សំណួរ ដែល មាន តែ អ្នក ម្នាក់ គត់ ដឹង ចម្លើយ និង មិន មែន ជា អ្វី ដែល អ្នក បាន ប្រកាស ជាសាធារណៈ ឬ បាន ចែករំលែក លើ បណ្តាញ សង្គម ។
ទំនាក់ទំនង របស់ ប្រទេស ទាំង ពីរ បានជាប់គាំង នៅក្នុង ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ប៉ុន្តែ នៅ ខែ ក្រោយ នេះ ប្រទេស ទាំង ពីរ នឹង ជួបពិភាក្សា ផ្នែក សន្តិសុខ ជា លើក ដំបូង របស់ ខ្លួន នៅក្នុង រយៈពេល បួន ឆ្នាំ កន្លងមក ។
ចំៈ មាន ពីរ គឺៈ
ជន យោធា និង នយោបាយ ។
បន្លែ ផ្លែ ឈើ ទាំង នេះ ល្អ ខ្លាំង សម្រាប់ អូន ៗ
ស្តាប់ តាម ការរៀបរាប់ របស់ លោក ទៅ ខ្ញុំ ក៍ កាន់តែ កំសត់ ទៅ ៗ
នៅក្នុង វីដេអូ ឃ្លីប បង្ហាញ ពី អារម្មណ៍ ក្តៅ ឆួល កញ្ញា សុខ ពិសី បាន គាស់កកាយ ថា ៖
មិន ត្រឹមតែ ប៉ុណ្ណោះ ក្រៅពី គ្រួសារ ដ៏ ពេញលេញ មួយ នេះ ហ្វេន ៗ
មិន គួរ ដើមឈើ គាប ឡើង លើ សោះ ឱ្យ ខ្ញុំ ស្រណោះ
ទី មួយ គឺ កម្រិត នៃ ការបូជា របស់ ព្រះគ្រីស្ទ ដើម្បី ជួយសង្គ្រោះ យើង ពី ទណ្ឌកម្ម នៃ អំពើ បាប របស់ យើង ។
តើ យើង ធ្វើ យ៉ាងដូចម្តេច ទើប ទាក់ទាញ អតិថិជន បាន ច្រើន ?
ជា ការពិត ណាស់ យើង មិន ត្រូវ ថ្កោល ទោស កិរិយ៉ា ដែល មាន បាប នោះ ឡើយ តែ ព្រះអម្ចាស់ នៃ យើង បាន ត្រាសហៅ យើង ឱ្យ បង្ហាញ សេចក្តីមេត្តា ដល់ អ្នកដទៃ ។
ការដុះ រោម លើ ខ្លួន គឺជា រឿង ធម្មតា ទេ ប៉ុន្តែ ក្មេងស្រី មួយចំនួន មិន ចូលចិត្ត ការប្រែប្រួល ដូច្នេះ ឡើយ ។
គេ ស្ទើរតែ តាម មិន ទាន់ ល្បិច អ្នកប្រព្រឹត្តិ អំពើ ទុច្ចរិត ទាំងនេះ ។
ជាពិសេស មនុស្ស ស្រី ច្រើន តែ ងាយ នឹង ទទួល នូវ បញ្ហា មួយ នេះ ។
ជា ការពិត ណាស់ គ្មាន មនុស្ស ស្រី ណា ទ្រាំទ្រ នឹង ក្លិន ខ្លួន ដ៏ អាក្រក់ របស់ អ្នក ឡើយ ដូច្នេះ មុនពេល រួមភេទ អ្នក ត្រូវ ងូតទឹក ឬ បាញ់ ទឹក អប់ ដែល នាង ចូលចិត្ត ។
ប៉ុន្តែ ព្រះជាម្ចាស់ ក៏ បាន ព្រមាន ដល់ កូន នេះ ដែរ ថា ប្រសិនបើ គេ មិន ស្តាប់ បង្គាប់ ហើយ មិន បង្ហាញ ពី ចរិត លក្ខណៈ បរិសុទ្ធ របស់ ទ្រង់ ទេ នោះ ទ្រង់ នឹង បណ្តេញ គេ ចេញ ពី ទឹកដី នោះ ។
ខ្ញុំ មិន ដែល ស្គាល់ គាត់ ទេ ។
ឪពុក ម្តាយ ដ៏ កំឡៅ របស់ អ្នក ជា អ្នកសាង មហន្តរាយ នេះ
សហរដ្ឋ អាមេរិក មិន ស្ថិត ក្នុង ការផ្តួចផ្តើម កាត់បន្ថយ ទិន្នផល នេះ ទេ ។
ប៉ុន្តែ មកដល់ ពេលនេះ ជាច្រើន ខែ មក ហើយ គឺ នៅ ពុំ ទាន់ បាន ដឹង ថា សំណុំរឿង លោក ទុយ ស៊ីវិល នោះ បាន ដំណើរការដោះស្រាយ ដល់ ណា ហើយ ទេ ។
ចង់ ជួប សួរ ក្រសួង ឱ្យ បាន ច្បាស់លាស់ ។
ជា ចំណុច ចាប់ផ្តើម មុននឹង អាច ធ្វើ ការងារ បាន ល្អ មនុស្ស ម្នាក់ ៗ
គាត់ ស្នើ ឱ្យ ថៅ កែ រោងចក្រ គោរព សិទ្ធិ កម្មករ ។
ខ្ញុំ ឆ្ងល់ និង ភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង !
គ្នា ច្រើន តាមរយៈ អ្វី ដែល ពួកយើង ទទួលបាន នា ពេល សិក្សា ។
រថយន្ត បើក ភ្លើង ពេល ថ្ងៃ បាន ចំនួន ០២ គ្រឿង ពិន័យ ទាំងអស់ ។
តើ អ្នក ចូលចិត្ត អ្វី
ខ្លួន ១៤ ថ្ងៃ ហើយ បើ មាន អាការៈ មិន ស្រួល សូម ទៅ យក សំណាក ធ្វើតេស្ត ជា ចាំបាច់ ។
លោក ឈាង វុន បាន មានប្រសាសន៍ ថា លោក អ៊ីវ៉ាន មិន ធ្វើឱ្យ ខ្ញុំ ឈឺ ក្បាល ទេ ។
ដែល បាន ដាច់ ស្តុក ពេលនេះ មាន ក្នុង ស្តុក វិញ ហើយ ។
ថា ជា ការសងសឹក ប្រឆាំង នឹង អន្តរាគមន៍ បារាំង នៅ ម៉ាលី ។
ចូលចិត្ត វីដេអូ របស់ អ្នក 1នាទី
តើ មកដល់ បច្ចុប្បន្ន មនុស្ស ប៉ុន្មាន នាក់ ហើយ បាន ជាន់ ភព ព្រះចន្ទ ?
ពួកគេ បាន ថ្លែងអំណរគុណ ដល់ ការឆ្លើយតប យកចិត្តទុកដាក់ ជួសជុល កំណាត់ ផ្លូវ ចូលមឌល សុខភាព នេះ ។
ផ្សេង ទៀត មិន មែន កម្ពុជា
អ្នក មិន ត្រឹមតែ ទទួលទាន សម្រាប់ មនុស្ស ២នាក់ ទេ តែ អ្នក ក៏ ត្រូវ សម្រាក ឱ្យ បាន គ្រប់គ្រាន់ សម្រាប់ មនុស្ស ២នាក់ ផងដែរ ។
វា មិន អាច បំពេញភាព ឥត ខ្ចោះ មួយ ដែល យើង ទាំងអស់ គ្នា ចង់បាន ទេ ។
ការរាំ ក៏ ជា វិធី ដ៏ អស្ចារ្យ មួយ ផងដែរ ដើម្បី រក្សា រាង ខ្ញុំ បន់ ឱ្យ ខ្ញុំ អាច ធ្វើ បែប នោះ ជារៀងរាល់ ថ្ងៃ ។
កាដូ មិន ចាំបាច់ ថ្លៃ ពេក ទេ ព្រោះថា ទឹកចិត្ត អ្នក ដែល ចងចាំ ថ្ងៃ សំខាន់ របស់ គេ គឺ វា ពិសេស បំផុត ទៅ ហើយ ។
លោកស្រី បាន យល់ស្រប ថា ការអនុវត្ត កំណែទម្រង់ ទាំងនេះ នឹង ត្រូវការ ចំណាយ យ៉ាង ច្រើន ។
ព្រះអម្ចាស់ មាន ព្រះបន្ទូល ថា នេះ ជា មធ្យោបាយ ដ៏ ប្រសើរ សំរាប់ ល្បួង គេ ដូច្នេះ ចូរ ទៅ ធ្វើ ចុះ !
បើ តាម ការផ្សព្វផ្សាយ ពី បណ្តាញ សារព័ត៌មាន មួយ បាន ប្រកាស ឱ្យដឹង កាលពី ពេល ថ្មី ៗ
មកពី ព្រោះ លិខិតស្នាម បាន រៀបចំ រួចរាល់ អស់ ហើយ ។
វិទ្យាសាស្ត្រ កម្មវិធី - ហ្គេម ទូទៅ ឆាប់ ៗ
វិទ្យុ ចំនួន ពីរ ប្រភេទ ដែល យើង មិន តម្រូវឱ្យ បង់លុយ គឺ វិទ្យុ ជន ពិការ និង វិទ្យុ ព្រះពុទ្ធ សាសនា ។
២៧ ប្រជាជន ច្រើន កុះករ ដើរ តាម ព្រះអង្គ ទៅ ព្រមទាំង មាន ពួក ស្ត្រី គក់ ទ្រូង យំ សោក អាណិត ព្រះអង្គ ផង ។
ដូច ច្បាប់ ដីធ្លី មាន បញ្ហា ជាច្រើន ។
តែ អ្នកវិភាគ យល់ ថា សង្គម ប្រជាធិបតេយ្យ រដ្ឋ ត្រូវ បើក ទូលាយ ចំពោះ អ្នក ព័ត៌មាន គ្រប់ រូប ។
អ្នកស្រី បញ្ជាក់ ថា កម្មករ ស្ទើរតែ ទាំងអស់ ជំពាក់ បំណុល គេ ។
មាន ភាព មិន ច្បាស់លាស់ នោះ ទេ ។
ខ្ញុំ ពុំ មាន ទំនុកចិត្ត លើ ប៉ូលិស ម្នាក់ ណា ទេ ។
ការគិត ដូចនេះ មិន អាច ជួយ ដល់ អាជីវកម្ម របស់ អ្នក ក្នុង រយៈពេល វែង ទៅ មុខ បាន ឡើយ ។
ការជំរុញ ឬ គោល នយោបាយ នៃ ការជំរុញ មាន ដូចជា ការពង្រឹង ស
មិន ត្រូវ សម្លឹងមើល អ្វី យូរ ពេក ឬ ជិត ពេក និង កន្លែង សម្លឹងមើល ត្រូវ មាន ពន្លឺ គ្រប់គ្រាន់
បន្ទាយ ឆ្មារ ក្រោយ ភ្លៀង ធ្លកា់ មួយ លាយ លំ ជាមួយ ផ្គរ រន្ទះ ។
តាម ពាក្យបណ្តឹង ឱ្យដឹង ថា ក្នុង អំឡុង ពេល រស់ នៅ ជាមួយគ្នា នោះ គាត់ មាន ផ្ទ
ដូច យ៉ាង សម្តី គ្រោត គ្រាត ដែល ធ្លាប់
បន្តិច ក្រោយមក ព្រឹទ្ធសភា បាន បោះឆ្នោត អនុម័ត សេចក្តីសម្រេច ទី ពីរ ។
អ្វី ដែល គាត់ អសមត្ថភាព អត់ ហ៊ាន សារភាព ទេ ។
ខ្ញុំ មិន ដឹង ឆ្លើយ ថា ប៉ុន្មាន ឱ្យ ប្រាកដ ។
ការសម្រេច នេះ ចាំបាច់ ត្រូវ អនុម័ត ដោយ គណៈ រដ្ឋមន្ត្រី ។
ពេលនេះ បាន ចេញមុខ បង្ហើប ពី អាថ៌កំបាំង ការចងចាំ ដ៏ ពិសេស នេះ មាន វីដេអូ
ត្រូវ គិត អំពី ថា តើ មូលហេតុ អ្វី បានជា ការប្រច័ណ្ឌ គឺជា បញ្ហា មួយ ។
សាសន៍ ទាំង ប៉ុន្មាន បាន ឡោមព័ទ្ធ ខ្ញុំ តែ ដោយ នូវ ព្រះនាម ព្រះយេហូវ៉ា ខ្ញុំ នឹង បំផ្លាញ គេ ចេញ
លោក ប្រធានាធិបតី ត្រាំ ជា អ្នក ជាតិ និយម ខាង សេដ្ឋកិច្ច ចាប់តាំងពី ដំបូង មក ។
សំរាប់ អាហារ ថ្ងៃ នេះ គឺ នំប៉័ង ខ្ទិះ
ចាប់តាំងពី ថ្ងៃ ដំបូង ដែល យើង បាន និយាយ គ្នា ខ្ញុំ ក៏ ជាប់ ចិត្ត នឹង បង ទៅ ហើយ ។
ដូច ខ្ញុំ និយាយ ខាង ដើម អញ្ចឹង ត្រូវ ចរចា គ្នា ដោយ សន្តិវិធី រក វិធី ដោះស្រាយ ។
យើង នឹង ក្លាយជា ម្ចាស់ ពិតប្រាកដ លើ ការសិក្សា របស់ យើង ។
ជនសង្ស័យ ម្នាក់ ក្នុង ចំណោម ២នាក់ ត្រូវបាន …
គ្មាន បណ្ណ បើកបរ ទី៤ ៖
ហេតុ អ្វី បានជា ប្រតិបត្តិការ កម្ទេច …
ខ្ញុំ ត្រូវតែ ក្លាហាន ដើម្បី សេចក្តីសុខ របស់ ខ្ញុំ …
កាល កេតុ ក៏ យល់ព្រម ដោយ គ្មាន ការសង្ស័យ ។
យ៉ាងណាមិញ នៅ ពេល ដែល យើង រៀន ទទួលយក ភាព ខ្សោយ របស់ ខ្លួន ក៏ ជា ពេល ដែល យើង អាច បង្ហាញ អំពី ភាពខ្លាំង របស់ យើង ដូចគ្នា ។
អ្នក ដែល រិះគន់ ថា នៅ កម្ពុជា មិន មាន សេរីភាព គ្រប់គ្រាន់ នោះ ប្រាកដជា មិន បាន សង្កេត ពិចារណា អោយ បាន ដិតដល់ ទេ ។
ដូច្នេះ បើ មិត្ត ៗ
លើក ព្រះនាម ទ្រង់ ឡើង នៅ ជុំវិញ បល្ល័ង្ក ព្រះជាម្ចាស់
យើង ផ្តល់ ជូន កំពស់ ស្រោមជើង2 ប្រភេទ សម្រាប់ ម៉ូឌែល នេះ ។
ចិន ព្រមាន អង់គ្លេស កុំ ឱ្យ លូកលាន់ កិច្ចការ ផ្ទៃក្នុង របស់ ខ្លួន នៅ ហុងកុង
តាំងពី ពេល នោះ មក ប៊ូម៉េង លែង បាន ជួប មុខ ប្រពន្ធ គាត់ ជារៀងរហូត ។
គាត់ និយាយ ថា នេះ ជា ការសម្រេច ល្អ អស្ចារ្យ មួយ ។
និង ទំនិញ ផ្ទាល់ខ្លួន ដែល ពួកគេ ទិញ មក លក់ ។
តថាគត អនុញ្ញាតឱ្យ ភិក្ខុ ចូលកាន់ វស្សា ទៅ តាម ការអនុវត្ត លើក ខែ របស់ ព្រះរាជា ចុះ ។
ស្រាយ ចេញ អោយ ឆាប់ កុំ អោយ ទុក យូរ សេចក្តីមូទូ
ប៉ុន្តែ ក្រសួង កំពុង បន្ត ការស្រាវជ្រាវ ជា បន្ត ទៀត ។
បន្ទាប់ គម្រប អាង បាត
ភាគ ច្រើន ស្ត្រី ទាំងនោះ មិន បាន ដឹង អំពី គ្រោះថ្នាក់ នៃ ការស្តែង ចេញ ពី សកម្មភាព មួយចំនួន ដែល ពួកគេ កំពុងតែ ប្រព្រឹត្ត ក្នុង អំឡុង ពេល មក រដូវ នោះ ទេ ដោយសារតែ គ្មាន នរណា ម្នាក់ ជួយ ក្រើន រំលឹក ឱ្យ ប្រយ័ត្ន ដល់ ពួកគេ ។
ដើម្បី ដោះស្រាយ បញ្ហា ទាំងអស់ នេះ ក្បួន ហុង ស …
គួរអោយ ញញើត ពេល ឃើញ ក្តាម អាំង ចេញ សុទ្ធតែ ដង្កូវ បែប នេះ
សេរីភាព អ៊ីនធឺណិត ចុះ ថយ នៅ ទូទាំង ពិភពលោក
គឺជា រឿង គួរឱ្យ ចាប់អារម្មណ៍ ហើយក៏ ជា អ្វី ដែល ស្រី ៗ
នាយ យ៉ាន និយាយ រឿង បាត់ខ្លួន ១ ខែ
មិន ប្រាកដ ថា អ្នក ពូកែ ប៉ុណ្ណា នឹង ចេះដឹង និង យល់ គ្រប់ បញ្ហា នោះ ទេ ។
អត្ថប្រយោជន៍ នៃ ការផឹក ទឹកក្រូចឆ្មា មួយ កែវ ជារៀងរាល់ ព្រឹក
របស់ ខ្ញុំ មិន និយាយ ភាសា ព័រទុយហ្គាល់ នោះ ទេ ។
ជាច្រើន ដែល បាន ជាប់ ក្នុង បញ្ជីរ នោះ ។
ប្រភព បន្ត ទៀត ថា ក្រោយពី កូន ស្លាប់ ជនរងគ្រោះ ចេះតែ ស្រង៉ូត ស្រង៉ាត់ អារម្មណ៍ ភាំង ៗ
កំពុងតែ ឆ្ងាញ់ ស្រាប់តែ ប៉ូលិស មកដល់ រក រត់ មិន ទាន់ !
ទាត់ ម៉ាត់ កែង ចេញ ដូចគ្នា ពោល ម្នាក់ ៗ
តែ ទោះជា យ៉ាងណា ខ្ញុំ ចង់ រម្លឹក បុគ្គលិក ទាំងអស់ ត្រូវតែ ប្រកាន់ខ្ជាប់ ទៅនឹង គោលការណ៍ នៃ ការស្លៀកពាក់ នៅក្នុង កន្លែង ការងារ នេះ ។
រឺ មួយ អ្នក គិត ថា រដ្ឋាភិបាល ជា អ្នកបង្កអោយ រឿង នេះ កើតឡើង ?
ដោយ សង្ស័យ ថា គាត់ និយាយ កុហក នាង ក៏ សម្រេចចិត្ត ធ្វើ អំពើរ ដ៏ ឃោឃៅ នេះ ទៅ ៕
ហើយ ការបង្ក្រាប បាន តិចតួច បំផុត ។
ម្យ៉ាងទៀត ក្រុមហ៊ុន អាច ចនឹង ផ្តាច់ការធានា ទូរស័ព្ទ របស់ យើង ទៀតផង ។
យើង មិន ចាត់ទុក ថា វា ជា ទីផ្សារ ក្នុង ការទាក់ទង នឹង ការទិញ ឬ លក់ ឡើយ ។
ស្រាប់តែ លេចឮ ដំណឹង នៃ ការវិល ចូល សិល្បៈ វិញ
ថ្ងៃទី៣ - ថ្ងៃទី ៣នៃ គំរោង របស់ អ្នក ចាប់ផ្តើម និង បញ្ចប់ ដោយ ការដើរ រយៈពេល ៩នាទី ពេលព្រឹក និង ពេលល្ងាច ។
ទៅ កម្សាន្ត នៅ ខេត្ត មណ្ឌលគិរី កុំ ភ្លេច ចូល មើល ចម្ការ ស្ត្រ បប៊ើរី
ប្រសិនបើ ព្រះជា ម្ចាស់ មិន បាន ប្រទាន នូវ ចិត្ត ស្កប់ ដ៏ ឥត ខ្ចោះ ដល់ យើង ភ្លាម ៗ
ខ្ញុំ ចង់ឱ្យ យុវជន មាន សំឡេង តែ មួយ ដើម្បី មាន កម្លាំង រឹងមាំ ។
ដូច្នេះ ខ្ញុំ ដាស់តឿន អ្នក រាល់គ្នា ឱ្យ យក គំរូ តាម ខ្ញុំ ចុះ
នាំ កូនក្រមុំ គេ ដើរលេង មួយ យប់ ក្លាយទៅជា អ្នកទោស ស្នេហា
