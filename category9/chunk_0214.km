នាយក នៃ មូលនិធិ ការពារ របួស អាស៊ី (AIP) លោក គឹម ប៉ាណា មានប្រសាសន៍ ថា គ្រោះថ្នាក់ ចរាចរណ៍ ដែល ពាក់ព័ន្ធ នឹង កម្មករ រោងចក្រ កាត់ដេរ និង ផលិត ស្បែកជើង នៅតែ បន្ត ជា បញ្ហា ធំ នៅ កម្ពុជា ។
លោក Pantha បាន ធ្វើការកត់សម្គាល់ កាលពី ថ្ងៃអង្គារ នៅក្នុង សិក្ខាសាលា ស្តីពី " ការលើកកម្ពស់ សុវត្ថិភាព ចរាចរណ៍ សម្រាប់ កម្មករ កម្ពុជា " នៅ រាជធានី ភ្នំពេញ ។ ជារៀងរាល់ ថ្ងៃ គ្រោះថ្នាក់ ចរាចរណ៍ បណ្ដាលឲ្យ មនុស្ស ស្លាប់ និង របួស ជាច្រើន នាក់ ។ លោក ថា គ្រោះថ្នាក់ នេះ ក៏ នាំ ទុក្ខ ដល់ គ្រួសារ ជនរងគ្រោះ ផងដែរ ។
លោក Pagna បាន និយាយ ថា យើង អាច ការពារ និង កាត់បន្ថយ គ្រោះថ្នាក់ ដ៏ មហន្តរាយ នេះ ប្រសិនបើ យើង ទាំងអស់ គ្នា ចូលរួម នៅក្នុង ស្មារតី រួម និង ចាត់ វិធានការឆ្លើយតប រួម គ្នា ។
យោង តាម របាយការណ៍ របស់ បេឡា ជាតិ របប សន្តិសុខ សង្គម ( ប.ស. ស) បាន ឲ្យដឹង ថា ក្នុង ឆ្នាំ ២០១៩ គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ចំនួន ៦៩៨ លើក លើ កម្មករ កាត់ដេរ និង ផលិត ស្បែកជើង បណ្តាលឲ្យ មនុស្ស ស្លាប់ ១៥ នាក់ និង របួស ធ្ងន់ ១៣៨ នាក់ ។
កម្មករ ខ្លះ ដែល រងរបួស ត្រូវ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ និង នៅ ផ្ទះ ច្រើន ថ្ងៃ ខណៈ ខ្លះ ទៀត ពិការ និង បាត់បង់ សមត្ថភាព ធ្វើការ ។ របាយការណ៍ បាន និយាយ ថា ពួកគេ បាន ក្លាយជា បន្ទុក បន្ថែម សម្រាប់ ឪពុក ម្តាយ និង បងប្អូន ក្នុង ការថែរក្សា ជាប្រចាំ ។
ប្រធាន ការិយាល័យ គោល នយោបាយ បេឡា ជាតិ របប សន្តិសុខ សង្គម លោក ហេង សុផាន់ ណារិទ្ធ មានប្រសាសន៍ ថា ទោះបីជា កម្មករ ដែល រង របួស ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ បាន ទទួល ការធានារ៉ាប់រង ពី បេឡា ជាតិ របប សន្តិសុខ សង្គម ក៏ដោយ ក៏ ពួកគេ នៅតែ ត្រូវ ដោះស្រាយ ផលវិបាក នៃ ការរង របួស ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ របស់ ពួកគេ ។
គ្រោះថ្នាក់ ចរាចរណ៍ បាន បន្សល់ទុក នូវ សោកនាដកម្ម និង ផល ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ ដល់ សុខុមាលភាព គ្រួសារ និង សេដ្ឋកិច្ច ។ នេះ ជា បញ្ហា ប្រឈម ធ្ងន់ធ្ងរ ដែល គ្មាន ក្រសួង ស្ថាប័ន ឬ មន្ទីរ ណាមួយ អាច បញ្ឈប់ កាត់បន្ថយ ឬ លុបបំបាត់ ដោយ ខ្លួន ឯង បាន ទេ ព្រោះ វា ជា បញ្ហា ទូទៅ សម្រាប់ យើង ទាំងអស់ គ្នា ។
របាយការណ៍ របស់ ក្រុមការងារ ដឹកជញ្ជូន ដែល ជា ក្រុម តំណាង ម៉ាក យីហោ និង ដៃគូ អភិវឌ្ឍន៍ ដែល សម្របសម្រួល ដោយ រោងចក្រ កាន់តែ ប្រសើរ កម្ពុជា (BFC) ដើម្បី គាំទ្រ កម្មករ បាន និយាយ ថា គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ប្រាំបី បាន កើតឡើង ពាក់ព័ន្ធ នឹង រថយន្ត ដឹក កម្មករ - កម្ម ការិនី ។
មនុស្ស ពីរ នាក់ បាន ស្លាប់ ៣២ នាក់ របួស ធ្ងន់ និង ១៨៩ នាក់ របួស ស្រាល ក្នុង គ្រោះថ្នាក់ នេះ ។
លោក Pamela Wharton នាយក រង កម្មវិធី ប្រចាំ ប្រទេស នៃ មជ្ឈមណ្ឌល សាមគ្គីភាព កម្ពុជា មានប្រសាសន៍ ថា កម្មករ ប្រឈម នឹង គ្រោះថ្នាក់ តាម វិធី ផ្សេង ៗ ជារៀងរាល់ ថ្ងៃ នៅពេល ពួកគេ ធ្វើដំណើរ ទៅ ធ្វើការ នៅ រោងចក្រ របស់ ពួកគេ ។ ខ្លះ ធ្វើដំណើរ តាម យានជំនិះ សមូហភាព ដែល មិន សមរម្យ សម្រាប់ អ្នកដំណើរ ។ ពួកគេ អាច កកកុញ និង មិន មាន សុវត្ថិភាព ។
ពួកគេ ងាក ទៅ រក ការដឹក ទំនិញ លើស ទម្ងន់ ដើម្បី រក ប្រាក់ ចំណូល សមរម្យ ។
ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ថ្ងៃអង្គារ នេះ បាន ចេញ សេចក្តីជូនដំណឹង អំពី ទឹក ជំនន់ សម្រាប់ ប្រជាពលរដ្ឋ រស់ នៅ តំបន់ ទំនាប ជាប់ ភ្នំ និង ផ្លូវ ទឹក ។
ការព្រមាន អំពី ស្ថានភាព អាកាសធាតុ កាលពី ថ្ងៃចន្ទ បាន ឱ្យដឹង ថា ខ្យល់ មូសុង និរតី កំពុង បក់ មក លើ ប្រទេស កម្ពុជា ក្នុង កម្រិត មធ្យម ខណៈ ដែល ប្រព័ន្ធ សម្ពាធ ទាប បន្ត ធ្លាក់ លើ ប្រទេស ថៃ ឡាវ និង វៀតណាម កំពុង បង្កឱ្យ មាន ការប្រែប្រួល យ៉ាង ខ្លាំង នៅក្នុង លក្ខខណ្ឌ អាកាសធាតុ កម្ពុជា ។
ក្រសួង បាន រាយការណ៍ ថា ខេត្ត មួយចំនួន នៅ តំបន់ ទំនាប កណ្តាល ជួរ ភ្នំ ដងរែក និង តំបន់ ខ្ពង់រាប ភាគ ឦសាន ទំនង ជា ទទួលបាន ភ្លៀង ធ្លាក់ រាយប៉ាយ ពី មធ្យម ទៅ ច្រើន ។ តំបន់ ខ្លះ អាចនឹង មាន ភ្លៀង ធ្លាក់ ខ្លាំង ហើយ ខេត្ត ជាប់ មាត់ សមុទ្រ ខ្លះ អាច ឃើញ មាន ភ្លៀង ធ្លាក់ រាយប៉ាយ ។
ក្រសួង បន្ត ថា ចាប់ពី ថ្ងៃទី ៣១ ខែកក្កដា ដល់ ថ្ងៃទី ៤ ខែសីហា ខេត្ត មួយចំនួន អាចនឹង មាន ទឹក ជំនន់ ។
ការព្យាករណ៍ អំពាវនាវ ដល់ កសិករ ដែល រស់ នៅ តំបន់ ទាំងនេះ ប្រញាប់ប្រមូល ផល ឱ្យ ទាន់ ពេលវេលា ដើម្បី កុំ ឱ្យ បាត់បង់ ។
ទស្សនា វីដេអូ៖ មន្ត្រី រដ្ឋបាល ព្រៃឈើ ខេត្ត កំពង់ធំ ៣នាក់ បាន ដាក់ ពាក្យ បណ្តឹង ទៅ តុលាការ ខេត្ត កំពង់ធំ ប្រឆាំង នឹង ជនសង្ស័យ ចំនួន ៥០ នាក់ ដែល ពួកគេ បាន អះអាង ថា បាន វាយប្រហារ ពួកគេ ក្នុង ជម្លោះ ដីធ្លី ។
