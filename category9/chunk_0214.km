ប្រសិនបើ សំណុំរឿង នេះ ត្រូវបាន បញ្ជូន ទៅ តុលាការ មិន ប្រាកដ ថា អ្នកណា នឹង ឈ្នះ នោះ ទេ ។ ដូច្នេះហើយ ទើប លោក សម្រេច ដោះស្រាយ ដោយ ដាក់ទណ្ឌកម្ម រដ្ឋបាល ដែល លោក ចាត់ទុក ថា ធ្ងន់ធ្ងរ ជាង ច្បាប់ ។
អ្នកនាំពាក្យ សាលាដំបូង ខេត្ត ពោធិ៍សាត់ លោក ហេង ដូនីន បាន និយាយ កាលពី ថ្ងៃច័ន្ទ ថា ចៅក្រម សាលាដំបូង ខេត្ត ពោធិ៍សាត់ បាន ឃុំ ខ្លួន ទាហាន អាយុ ៥៧ ឆ្នាំ ម្នាក់ ឱ្យ ឃុំ ខ្លួន បណ្តោះអាសន្ន កាលពី ថ្ងៃចន្ទ បន្ទាប់ពី ចោទប្រកាន់ គាត់ ពី បទ ឃាតកម្ម គិត ទុក ជាមុន តាម មាត្រា ២០០ នៃ ក្រម ព្រហ្មទណ្ឌ ។
ចៅក្រម សាលាដំបូង ខេត្ត ពោធិ៍សាត់ សម្រេច ឃុំ ខ្លួន បណ្ដោះអាសន្ន ក្រោម បទ ចោទ ឃាតកម្ម គិត ទុក ជាមុន ។ ខ្ញុំ មិន ទាន់ ដឹង ថា តើ សវនាការ នឹង ត្រូវ ធ្វើ នៅ ពេលណា នៅឡើយ ទេ ។ យើង នឹង រង់ចាំ ការសម្រេចចិត្ត ។
ជនសង្ស័យ ឈ្មោះ ប្រាក់ សុផល ប្រឈម នឹង ការផ្ដន្ទាទោស ដាក់ ពន្ធនាគារ អស់ មួយ ជីវិត ប្រសិនបើ ត្រូវបាន ផ្តន្ទាទោស ។
ស្នងការ នគរបាល ខេត្ត ពោធិ៍សាត់ លោក ស ថេង បាន និយាយ នៅ ថ្ងៃចន្ទ នេះ ថា នគរបាល ស្រុក ក្រគរ បាន បញ្ជូន លោក សុផល ទៅ ស្នងការ ខេត្ត ពោធិ៍សាត់ កាលពី ថ្ងៃអាទិត្យ បន្ទាប់ពី លោក បាន បាញ់ សម្លាប់ បុរស ម្នាក់ កាលពី ថ្ងៃទី ១៨ ខែកញ្ញា នៅ ឃុំ ត្នោត ជុំ ស្រុក ក្រគរ ។ វា ទាក់ទង នឹង ការឈ្លោះប្រកែកគ្នា ពេល កំពុង ផឹក ស្រា ។
លោក ឃុន រី នាយ រង ផ្នែក សន្តិសុខ នៃ អធិការដ្ឋាន នគរបាល ស្រុក ក្រគរ បាន និយាយ កាលពី ថ្ងៃអាទិត្យ ថា លោក សុផល ជា អនុប្រធាន ការិយាល័យ ហ្វឹកហ្វឺន នៅ កងពល តូច អន្តរាគមន៍ លេខ ១៤ ក្នុង ស្រុក ក្រគរ ។
មន្ត្រី បាន សហការ ជាមួយ កងរាជអាវុធហត្ថ ស្រុក ក្រគរ ក្នុង ការពិនិត្យ សព ។ ជនសង្ស័យ ត្រូវបាន ចាប់ខ្លួន នៅ ថ្ងៃ ដដែល បន្ទាប់ពី លាក់ ខ្លួន នៅ ផ្ទះ ក្បែរ នោះ ។
មេបញ្ជាការ កងរាជអាវុធហត្ថ ស្រុក ក្រគរ លោក វិច្ឆិកា សុជាតិ បាន ទទួលស្គាល់ កាលពី ថ្ងៃអាទិត្យ ថា កម្លាំង របស់ លោក បាន ចូលរួម ក្នុង ប្រតិបត្តិការ នេះ ប៉ុន្តែ សំណុំរឿង នេះ ត្រូវបាន បញ្ជូន ទៅ អគ្គ ស្នងការ នគរបាល ជាតិ ។
លោក បាន មានប្រសាសន៍ ថា ខ្ញុំ មិន ដឹង ច្បាស់ ទេ ប៉ុន្តែ ខ្ញុំ បាន សួរ អ្នកភូមិ ហើយ គេ ថា មន្ត្រី យោធា ឈ្មោះ ផល បាន ដក កាំភ្លើង បាញ់ ជនរងគ្រោះ ។
ធនាគារ ឯកទេស វីង ( ខេមបូឌា ) រួម ជាមួយនឹង ក្រុមហ៊ុន រ៉ូយ៉ាល់ គ្រុប ភ្នាក់ងារ វីង អតិថិជន និង ដៃគូ នានា កាលពី ខែ មុន បាន អះអាង សារជាថ្មី នូវ ការប្តេជ្ញាចិត្ត របស់ ពួកគេ ចំពោះ មន្ទីរពេទ្យ កុមារ អង្គរ ( អេអេ អេអេស៊ី ) ដែល ជា មជ្ឈមណ្ឌល សុខភាព កុមារ ឈាន មុខ គេ មួយ របស់ ប្រទេស ។
ដោយសារ ផល ប៉ះពាល់ សង្គម និង សេដ្ឋកិច្ច នៃ ការរាតត្បាត Covid-19 អ្នកជំងឺ មួយចំនួន កំពុង ប្រឈមមុខ នឹង ឧបសគ្គ ថ្មី ក្នុង ការទទួលបាន ការព្យាបាល ដោយ ឥត គិត ថ្លៃ នេះ ។
លោកជំទាវ ម៉ៅ ចំណាន ប្រធាន ផ្នែក ប្រតិបត្តិការ វីង មានប្រសាសន៍ ថា លោកស្រី អាច យល់ ចិត្ត ជាមួយ ក្រុមគ្រួសារ ដែល កំពុង ស្វែងរក ការថែទាំ ។
នាង បាន និយាយ ថា៖ ក្នុង នាម ជា ម្តាយ ខ្ញុំ ដឹង ថា ពេល កូន នៅ កន្លែងណា ក៏ ឈឺ ម្តាយ របស់ ពួកគេ តែងតែ បារម្ភ ។ " នោះ ជា ការពិតជា ពិសេស ប្រសិនបើ នាង មិន អាច ស្វែងរក មន្ទីរពេទ្យ ដែល អាច ទុកចិត្ត បាន ដើម្បី ស្វែងរក ការព្យាបាល ។
លោកជំទាវ ម៉ៅ ចំណាន មានប្រសាសន៍ ថា វីង មាន មោទនភាព ក្នុង ការជួយ ឧបត្ថម្ភ AHC តាមរយៈ ជំងឺ រាតត្បាត ដើម្បី បន្ត ដំណើរ របស់ មន្ទីរពេទ្យ និង បេសកកម្ម ក្នុង ការផ្តល់ ការថែទាំ ដោយ ឥត គិត ថ្លៃ និង មាន ប្រសិទ្ធភាព ដល់ កុមារ កម្ពុជា ។
អំណោយ របស់ វីង ក៏ រួមបញ្ចូល ការរួមចំណែក ពី បុគ្គល ល្បី ៗ ដូចជា ឧកញ៉ា លី ហួរ លោកជំទាវ នួន ពេជ្រ សុផល និង ទូច សុជាតា ។
វីង បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការងារ សប្បុរសធម៌ ចាប់តាំងពី ការបង្កើតឡើង ក្នុង ឆ្នាំ ២០០៩ ។
ក្នុង ពិធី នេះ លោក វេជ្ជបណ្ឌិត ងួន ចាន់ ភក្ត្រា នាយក មន្ទីរពេទ្យ AHC បាន ថ្លែងអំណរគុណ ដល់ ធនាគារ និង តំណាង របស់ ធនាគារ នេះ ដែល បាន បរិច្ចាគ ថវិកា ។
លោក វេជ្ជបណ្ឌិត ចាន់ ភក្ត្រា បាន ថ្លែង ថា៖ ការបរិច្ចាគ ដ៏ ច្រើន សន្ធឹកសន្ធាប់ គឺជា ការវិនិយោគ ដែល ចាំបាច់ សម្រាប់ មន្ទីរពេទ្យ ។ មូលនិធិ នេះ នឹង ជួយ ផ្តល់ ការថែទាំ ប្រកបដោយ គុណភាព ដល់ កុមារ ដែល សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ និង ជា ផ្នែក មួយ យ៉ាង សំខាន់ ក្នុង ការធ្វើឱ្យ ប្រសើរឡើង នូវ ការថែទាំ សុខភាព នៅ កម្ពុជា ដោយ មិន ទុក កុមារ ឱ្យ ឈឺ ។
ចាប់តាំងពី ការបង្កើតឡើង ក្នុង ឆ្នាំ 2009 វីង បាន ប្តេជ្ញាចិត្ត ក្នុង ការរស់នៅ តាម គោលការណ៍ នៃ ការអភិវឌ្ឍន៍ ប្រកបដោយ និរន្តរភាព ។ សព្វ ថ្ងៃ នេះ ធនាគារ ផ្តោត លើ គោលការណ៍ ទាំងនោះ នៅក្នុង តួនាទី សង្គម និង សីលធម៌ របស់ ខ្លួន ក្នុង នាម ជា ពលរដ្ឋ សាជីវកម្ម របស់ កម្ពុជា ។
Manu បាន និយាយ ថា " កុមារ រាប់ ពាន់ នាក់ បាន ឈឺ ជារៀងរាល់ ថ្ងៃ ហើយ មន្ទីរពេទ្យ នេះ គឺជា ក្តីសង្ឃឹម ដំបូង របស់ ពួកគេ ក្នុង ការព្យាបាល " ។ " ការបរិច្ចាគ របស់ យើង មាន ន័យ ថា យើង កំពុង ជួយ កុមារ ក្រីក្រ ឱ្យ ទទួលបាន ការថែទាំ សុខភាព ប្រកបដោយ គុណភាព ហើយ ការរួមចំណែក ផ្ទាល់ខ្លួន របស់ អ្នក មាន តម្លៃ យ៉ាង ធំ ធេង ក្នុង ការជួយសង្គ្រោះ ជីវិត កុមារ ខ្វះខាត ក្នុង អំឡុង ពេល មិន ច្បាស់លាស់ នេះ ។
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន ចេញ សារ អបអរសាទរ ទិវា សន្តិភាព អន្តរជាតិ កាលពី ថ្ងៃច័ន្ទ ដោយ មានប្រសាសន៍ ថា ប្រទេស មហា អំណាច និង ប្រទេស លោក ខាងលិច មួយចំនួន បាន សហការ ជា ប្រព័ន្ធ ដើម្បី ដាក់ សម្ពាធ នយោបាយ មក លើ កម្ពុជា ដូច ដែល ពួកគេ បាន ធ្វើ ក្នុង ទសវត្សរ៍ ឆ្នាំ 1970 និង 1980 ។
លោក ហ៊ុន សែន ថ្លែង ថា ការគាបសង្កត់ កម្ពុជា ឲ្យ អនុវត្ត តាម ជំនឿ នយោបាយ ផ្សេង ៗ គ្នា គឺជា ការរំលោភ លើ គោលការណ៍ សមភាព និង អធិបតេយ្យភាព រវាង រដ្ឋ និង គោលការណ៍ មិន ជ្រៀត ជ្រែក ចូល កិច្ចការ ផ្ទៃក្នុង របស់ ប្រទេស ដទៃ ដូច មាន ចែង ក្នុង ធម្មនុញ្ញ អង្គការ សហ ប្រជាជាតិ និង ច្បាប់ អន្តរជាតិ ។
សារ នោះ បាន សរសេរ ថា សមិទ្ធិផល ដ៏ អស្ចារ្យ ដែល កម្ពុជា សម្រេចបាន ជាង ៤០ ឆ្នាំ មិន ដែល ទទួលបាន ការអបអរសាទរ ឬ ការកោតសរសើរ ពី មហា អំណាច មួយចំនួន និង ប្រទេស លោក ខាងលិច ឡើយ ។
ប្រទេស ទាំងនេះ មាន តែ របៀបវារៈ នយោបាយ ដើម្បី ទាក់ទាញ កម្ពុជា ឱ្យ ដើរ តួនាទី ជា ជំហាន ឆ្ពោះ ទៅរក មហិច្ឆតា នយោបាយ របស់ ពួកគេ ។
លើស ពី នេះ ពួកគេ មិន ស្ទាក់ស្ទើរ ក្នុង ការអនុវត្ត ស្តង់ដារ ទ្វេរ ដង ក្នុង ការវាយតម្លៃ ការអនុវត្ត សិទ្ធិ មនុស្ស នៅ កម្ពុជា ។
ពួកគេ ក៏ ប្រើ បញ្ហា សិទ្ធិ មនុស្ស នេះ ជា ឧបករណ៍ នយោបាយ ឬ ជា លេស សម្រាប់ ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង រំលោភ អធិបតេយ្យភាព និង ឯករាជ្យ របស់ កម្ពុជា និង ប្រទេស ទន់ខ្សោយ ផ្សេង ទៀត ។
លោក គិន ភា នាយក វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃអាទិត្យ ថា គោល នយោបាយ បរទេស ត្រូវបាន បង្កើតឡើង ដោយ ប្រទេស នីមួយ ៗ ដើម្បី បម្រើ ខ្លួន ឯង ។
លោក ភា មានប្រសាសន៍ ថា កម្ពុជា ជា ប្រទេស តូច មួយ ដែល ពឹងផ្អែក លើ សេដ្ឋកិច្ច របស់ បរទេស ដូច្នេះ ត្រូវតែ គិត ពី ការបង្កើត គោល នយោបាយ ការបរទេស ពិសេស សម្រាប់ ខ្លួន ឯង ។
ដោយសារ វា បែប នេះ យើង មិន អាច ចម្លង គំរូ ប្រទេស ណាមួយ មក អនុវត្ត បាន ទេ ។ នយោបាយ ដាក់ សម្ពាធ កម្ពុជា ឲ្យ ធ្វើ បែប នេះ ឬ តាម ប្រទេស មួយ គឺជា គោល នយោបាយ ចុះ កាលបរិច្ឆេទ ។
ប្រសិនបើ ប្រទេស មួយ ត្រូវបាន បង្ខំ ឬ ដាក់ សម្ពាធ ឱ្យ ដើរ តាម គន្លង នៃ ប្រទេស មួយ ផ្សេង ទៀត ឬ ការប្រកួតប្រជែង រវាង ប្រទេស មហា អំណាច ធំ ៗ ពីរ ទី មួយ វា មាន ន័យ ថា វា ជា ការរំលោភ លើ អធិបតេយ្យភាព ផ្ទៃក្នុង របស់ ប្រទេស មួយ ។
ទី ពីរ វា អាចនឹង ធ្វើឲ្យ ប្រទេស ដែល មាន សម្ពាធ មួយ ជួបប្រទះ នឹង បញ្ហា និង ភាពចម្រូងចម្រាស ជាច្រើន ។ វា អាច ធ្លាក់ ចូល ទៅក្នុង សង្រ្គាម ។ ជួនកាល សង្រ្គាម ស៊ីវិល កើតឡើង នៅក្នុង ប្រទេស ដែល ជាប់ ក្នុង សង្រ្គាម ត្រជាក់ ឬ នៅ ពេល ដែល ប្រទេស ធំ ៗ ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង ។
ប្រធាន វិទ្យាស្ថាន កម្ពុជា ដើម្បី ប្រជាធិបតេយ្យ លោក ប៉ា ច័ន្ទ រឿន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃអាទិត្យ ថា ជាទូទៅ ប្រទេស តូច មួយ ឬ ប្រទេស កំពុង អភិវឌ្ឍន៍ តែងតែ ទទួលបាន ឥទ្ធិពល ពី ប្រទេស ធំ ៗ ឬ មហា អំណាច ។
ចំណុច សំខាន់ គឺ ថា មេដឹកនាំ នៅក្នុង ប្រទេស ត្រូវតែ មាន ប្រាជ្ញា ក្នុង ការទទួល និង ប្រើប្រាស់ ឥទ្ធិពល នោះ ដើម្បី ប្រែក្លាយ វា ទៅជា ផលប្រយោជន៍ ជាតិ ។
លោក បាន មានប្រសាសន៍ ថា មេដឹកនាំ ដាក់ ប្រទេសជាតិ ជា អាទិភាព ហើយ ប្រើប្រាស់ រដ្ឋធម្មនុញ្ញ របស់ ខ្លួន ជា មូលដ្ឋាន ដើម្បី ធានា អធិបតេយ្យភាព បូរណភាព ទឹកដី និង បម្រើ ប្រជាពលរដ្ឋ ។
លោក ចាន់ រឿន បាន មានប្រសាសន៍ ថា ប្រទេស កម្ពុជា ធ្លាប់ រង គ្រោះ ជា ប្រវត្តិសាស្ត្រ ដោយ ឥទ្ធិពល បរទេស មុន ពេល ដែល និយាយ អំពី សម័យ សង្គម រាស្រ្ត និយម និង រយៈពេល ក្រោយ របប ខ្មែរ ក្រហម ដួលរលំ ។
ជាពិសេស ភាពចម្រូងចម្រាស រវាង ប្លុក សេរី និង កុម្មុយនិស្ត ធ្វើឱ្យ យើង បាត់បង់ ការពឹងផ្អែក លើ ខ្លួន ឯង ហើយ ជាពិសេស យើង បាត់បង់ ជំហរ របស់ យើង លើ អព្យាក្រឹតភាព ។
យើង ងាក ទៅជា ប្រទេស ដ៏ សំខាន់ មួយ នៃ ប្លុក កុម្មុយនិស្ត ដែល ធ្វើឲ្យ យើង បាត់បង់ តុល្យភាព ក្នុង ទំនាក់ទំនង បរទេស ជាមួយ ប្រទេស មហា អំណាច ។ វា ធ្វើឲ្យ ប្រទេស យើង ធ្លាក់ ចូល ក្នុង ជម្លោះ ផ្ទៃក្នុង ហើយ ឈាន ទៅរក សង្គ្រាម ស៊ីវិល រ៉ាំរ៉ៃ ។
រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន រាយការណ៍ ថា ប្រជាពលរដ្ឋ ចំនួន ៤នាក់ បាន លង់ទឹក ស្លាប់ នៅ ចន្លោះ ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី ២០ ខែកញ្ញា ក្នុង នោះ មាន កុមារី អាយុ ៤ឆ្នាំ ២នាក់ ដែល បាន លង់ទឹក ស្លាប់ កាលពី ព្រឹក ថ្ងៃអាទិត្យ នៅ ស្រុក ព្រៃនប់ ។
ឪពុក ម្តាយ របស់ ក្មេងស្រី ទាំង ពីរ នាក់ បាន និយាយ ថា ពួកគេ បាន ទៅ ធ្វើការ នៅ ម៉ោង ៨ព្រឹក ដោយ ទុក កូន នៅក្នុង ជម្រក ។ លុះ ត្រឡប់ មកវិញ នៅ វេលា ម៉ោង ១១ព្រឹក កូន ៗ របស់ ពួកគេ បាន បាត់ខ្លួន ហើយ ត្រូវបាន គេ ប្រទះឃើញ លង់ទឹក ក្នុង អាង ក្បែរ នោះ ។
ស្ត្រី អាយុ ៣៥ ឆ្នាំ ម្នាក់ នៅ សង្កាត់ ទី១ ក្រុង ព្រះសីហនុ ក៏ ត្រូវបាន គេ ប្រទះឃើញ លង់ទឹក ស្លាប់ កាលពី ថ្ងៃសៅរ៍ ។ នាង បាន រអិល ជើង ធ្លាក់ ចូល ប្រឡាយ ។
កុមារី អាយុ ១ឆ្នាំ ៨ខែ ម្នាក់ រអិល ជើង ធ្លាក់ ចូល ទឹក ហូរ យ៉ាង លឿន បាត់ ស្រមោល ។
អាជ្ញាធរ បាន ប្រទះឃើញ សព ក្មេង ដែល ទើប ចេះ ដើរ តេះ តះ ប្រហែល ម៉ោង ៧ ព្រឹក ថ្ងៃសុក្រ អណ្តែត លើ ឈើ ចំងាយ ៣០០ ម៉ែត្រ ពី ផ្ទះ ។
របាយការណ៍ របស់ រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន ឲ្យដឹង ថា ទឹក ជំនន់ នៅ ស្រុក ព្រៃនប់ និង ខេត្ត ព្រះសីហនុ បាន ប៉ះពាល់ ប្រជាពលរដ្ឋ ចំនួន ១.៩៥៨ គ្រួសារ ក្នុង ឃុំ ចំនួន ១១ ខណៈ ប្រជាពលរដ្ឋ នៅ ស្រុក ព្រៃនប់ ៤៧៥ នាក់ ត្រូវបាន ជម្លៀស ចេញ ពី ផ្ទះសម្បែង ។ ទឹក ជំនន់ ក៏ បាន បង្ក ការខូចខាត ផ្លូវ ជាច្រើន ផងដែរ ។
ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ លោក ជួន ណារិន បាន មានប្រសាសន៍ ថា ទឹក នៅ តំបន់ នោះ បាន ស្រក ស្ទើរ ទាំងស្រុង ។ ពលរដ្ឋ ខ្លះ ត្រូវបាន អនុញ្ញាតឱ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ ។
កម្រិត ទឹក វិល មក រក កម្រិត ធម្មតា វិញ ហើយ ។ ប៉ូលិស និង គណៈ បញ្ជាការ ឯកភាព ខេត្ត នៅតែ ស្ថិត ក្នុង តំបន់ លិច ទឹក ដើម្បី ជួយ ពលរដ្ឋ ។
ព្យុះ នេះ បាន បង្កឱ្យ មាន ខ្យល់ បក់ ខ្លាំង និង បង្កើត បានជា រលក ធំ ៗ មិន ធម្មតា នៅ ខេត្ត កោះកុង ។ ទោះបីជា យ៉ាងណា ក៏ មិន មាន សេចក្តីរាយការណ៍ ពី ផ្ទះ ដែល ត្រូវ ជន់ លិច ដែរ ។
ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន រាយការណ៍ ពី ឥទ្ធិពល របស់ លោក នួន គិត ត្រឹម ថ្ងៃទី ២០ ខែកញ្ញា ។
អ្នកនាំពាក្យ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ លោក ឃុន សុខា មានប្រសាសន៍ ថា លោក មិន ទាន់ មាន របាយការណ៍ ចុងក្រោយ ស្តីពី ការខូចខាត ដោយសារ ខ្យល់ព្យុះ នេះ ទេ ប៉ុន្តែ ស្រុក ព្រៃនប់ រង ផល ប៉ះពាល់ ខ្លាំង ជាង គេ ។ លោក បន្ត ថា៖ ខេត្ត មិន ទាន់ រាយការណ៍ ស្ថិតិ ដល់ ថ្នាក់ ជាតិ នៅឡើយ ទេ ។
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន ឯកភាព ជាមួយ លទ្ធផល នៃ ក្រុមការងារ អន្តរ ក្រសួង ស្តីពី ការសិក្សា ការទន្ទ្រាន ព្រៃឈើ ខុស ច្បាប់ ក្នុង តំបន់ ការពារ ក្នុង ខេត្ត មណ្ឌលគិរី ។
ប៉ុន្តែ លោក មិន ទាន់ ចេញ សេចក្តីប្រកាស ជា ផ្លូវការ នៅឡើយ ទេ បន្ទាប់ពី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ស ខេង ស្នើសុំ ឱ្យ បញ្ចប់ មុខតំណែង ផ្លូវការ មួយចំនួន នេះ បើ យោង តាម អ្នកនាំពាក្យ ក្រសួង ។
លោក សុភ័ក្រ្ត បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃអាទិត្យ ថា ក្រុមការងារ អន្តរ ក្រសួង បាន នឹង កំពុង សិក្សា ករណី ទន្ទ្រាន យក ដី ព្រៃ ខុស ច្បាប់ និង ការទន្ទ្រាន យក តំបន់ ការពារ ក្នុង ខេត្ត មណ្ឌលគិរី ប្រកបដោយ តម្លាភាព សុចរិតភាព និង ភស្តុតាង ។
យើង មាន គោលការណ៍ ទាំងអស់ ប៉ុន្តែ យើង មិន ទាន់ ទទួលបាន ការណែនាំ សម្រាប់ ការអនុវត្ត ។ យើង នឹង មិន អាច ប្រកាស ជាសាធារណៈ បាន ទេ ។ វា មិន មែន ជា អាថ៌កំបាំង ទេ ។
យើង មាន អ្វី គ្រប់ យ៉ាង ដែល នាយក រដ្ឋមន្ត្រី បាន ចាត់ ឲ្យ យើង ធ្វើ រួចហើយ ។ យើង បាន រាយការណ៍ ទៅ នាយក រដ្ឋមន្ត្រី ហើយ គាត់ យល់ស្រប នឹង អ្វី ដែល ក្រុមការងារ អន្តរ ក្រសួង បាន បញ្ចប់ ។
លោក ស ខេង កាលពី ថ្ងៃទី ២២ ខែកក្កដា បាន ចេញ សេចក្តីសម្រេច ស្តីពី ការបង្កើត ក្រុមការងារ អន្តរ ក្រសួង ដើម្បី សិក្សា ករណី ទន្ទ្រាន កាន់កាប់ ដី ព្រៃ ខុស ច្បាប់ និង ការទន្ទ្រាន យក តំបន់ ការពារ ក្នុង ខេត្ត មណ្ឌលគិរី ។
ការសម្រេច បង្កើត ក្រុមការងារ អន្តរ ក្រសួង នេះ គឺ ផ្អែក លើ កំណត់ ត្រា របស់ នាយក រដ្ឋមន្ត្រី ចុះ ថ្ងៃទី ៨ ខែកក្កដា ។
លោក ស ខេង តែងតាំង រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ លោក អង្គ មង្គល ដឹកនាំ ក្រុមការងារ ចុះ សិក្សា ករណី ទន្ទ្រាន កាន់កាប់ ដី ព្រៃ ខុស ច្បាប់ និង ទន្ទ្រាន យក តំបន់ ការពារ ក្នុង ខេត្ត មណ្ឌលគិរី ។
កាលពី ថ្ងៃទី៣០ ខែសីហា លោក ស ខេង បាន ដាក់ លិខិត ទៅ លោក ហ៊ុន សែន ដើម្បី ពិនិត្យ និង សម្រេច លើ លទ្ធផល នៃ ការសិក្សា សំណើ សុំ កែប្រែ ភារកិច្ច អភិបាល ខេត្ត និង បញ្ចប់ មុខតំណែង មន្ត្រី ចំនួន ៩រូប ។
លិខិត នោះ បាន បញ្ជាក់ ថា៖ បន្ទាប់ពី ស្តាប់ របាយការណ៍ របស់ ក្រុម សិក្សា ហើយ ក្រុម នេះ យល់ឃើញ ថា អភិបាល ខេត្ត ស្វាយ សំអ៊ាង មិន បាន ប្រព្រឹត្ត កំហុស ធ្ងន់ធ្ងរ ដូច ការចោទប្រកាន់ នោះ ទេ ហើយ បាន ស្នើឲ្យ លោក នាយក រដ្ឋមន្ត្រី រក្សា តួនាទី របស់ គាត់ និង អប់រំ គាត់ ឲ្យ បំពេញ ការទទួលខុសត្រូវ ។ .
លិខិត ដដែល បាន កត់សម្គាល់ សំណើ សុំ បញ្ចប់ តំណែង សមាជិក ព្រឹទ្ធសភា ភូមិភាគ ទី៨ លោក ណូយ ស្រ៊ុន ។ ក្រុម នេះ រកឃើញ ថា ស្រ៊ុន បាន ប្រើ តួនាទី និង អំណាច ក្នុង ការណែនាំ មន្ត្រី មូលដ្ឋាន ឲ្យ ចុះហត្ថលេខា លើ ឯកសារ ដីធ្លី ខុស ច្បាប់ ។
លិខិត នោះ បាន សរសេរ ថា " ផ្អែក លើ ហេតុផល នេះ អង្គប្រជុំ បាន ស្នើសុំ ដោយ គោរព សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា អប់រំ ណយ ស្រន់ " ។
យោង តាម លិខិត របស់ លោក ស ខេង អនុប្រធាន រដ្ឋបាល សាលា ខេត្ត មណ្ឌលគិរី លោក សុខ សេរី ត្រូវបាន ក្រសួង មហាផ្ទៃ ស្នើ ឱ្យ សម្រួល ភារកិច្ច របស់ ខ្លួន ដោយ ត្រឡប់ ចូល បម្រើ ការងារ នៅ ក្រសួង មហាផ្ទៃ វិញ ។
សេរ៉ា ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា៖ ខ្ញុំ បាន ផ្លាស់ ទៅ ក្រសួង មហាផ្ទៃ វិញ ដោយសារតែ បញ្ហា មួយចំនួន ។
លោក សៀក មុនី អភិបាល ស្រុក អូរ រាំង ត្រូវបាន ស្នើឲ្យ ផ្តល់ ការអប់រំ បន្ថែម ទៀត ។
លោក ប៉ោ ប៉េ មេឃុំ ស្រែ ព្រះ ស្រុក កែវសីមា លោក ថា វ៉ាន់ ត្រិល មេឃុំ សែនមនោរម្យ ស្រុក អូរ រាំង និង លោក ប៊ុត សំអែល មេឃុំ ស្រែ ខ្ទុម ស្រុក កែវសីមា ត្រូវបាន ក្រសួង មហាផ្ទៃ ស្នើឲ្យ ដាក់ វិន័យ ធំ ជាង នេះ ។ សកម្មភាព ក្រោម ច្បាប់ ស្តីពី រដ្ឋបាល ឃុំ សង្កាត់ ។
តាម លិខិត របស់ លោក ស ខេង ឈ្មោះ មន្ត្រី ផ្សេង ទៀត ត្រូវបាន ផ្ញើ ទៅ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ដើម្បី ពិនិត្យ ។
លោក គ្រឹង តុលា សកម្មជន ការពារ ព្រៃឈើ ខេត្ត មណ្ឌលគិរី ទទូច ឲ្យ ផ្លាស់ប្តូរ មន្ត្រី ជាន់ ខ្ពស់ រដ្ឋបាល ខេត្ត មណ្ឌលគិរី មួយចំនួន ។ លោក អះអាង ថា នៅ ពេល ដែល មន្ត្រី ជាន់ ខ្ពស់ ខេត្ត មាន កេរ្តិ៍ឈ្មោះ អាក្រក់ ពាក់ព័ន្ធ នឹង បទល្មើស បែប នេះ ប្រជាពលរដ្ឋ នឹង លែង គាំទ្រ ហើយ ការដឹកនាំ ក៏ គ្មាន ប្រសិទ្ធភាព ដែរ ។
ការកាប់បំផ្លាញ ព្រៃឈើ និង ការទន្ទ្រាន យក ដី រដ្ឋ ក្នុង ខេត្ត មណ្ឌលគិរី មិន អាច កើតឡើង បាន ទេ បើ គ្មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ខេត្ត ។ បើ យើង ទុកឲ្យ មន្ត្រី បន្ត ធ្វើ បែប នេះ គេ នឹង មិន អាច កែប្រែ ទម្លាប់ បាន ទេ ។ ដូច្នេះ មាន តែ ការផ្លាស់ប្តូរ ប៉ុណ្ណោះ ដែល អាច រក្សា ព្រៃឈើ និង ធនធាន ធម្មជាតិ ក្នុង ខេត្ត មណ្ឌលគិរី បាន ។
លោក ប៊ូ សុធី ស្នងការ រង នគរបាល ខេត្ត ព្រះសីហនុ ទទួលបន្ទុក ផ្នែក អាវុធ ជាតិ ផ្ទុះ និង អគ្គិភ័យ បាន មានប្រសាសន៍ ថា អគ្គិភ័យ បាន បណ្តាលឲ្យ ខូចខាត រោងចក្រវាយន ភណ្ឌ ១កន្លែង ក្នុង សង្កាត់ ទី១ ក្រុង ព្រះសីហនុ នៅ ថ្ងៃទី ១៩ ខែកញ្ញា ។
លោក បាន ថ្លែង ថា៖ សន្តិសុខ ម្នាក់ បាន និយាយ ថា ពួកគេ អាច ធុំ ក្លិន ខ្សែភ្លើង ហើយ ឃើញ ផ្សែង ចេញ ពី ឃ្លាំង ប៉ុន្តែ ពួកគេ មិន អាច ចូល បាន ទេ ព្រោះ វា ត្រូវបាន ចាក់សោ ។
លោក សុធី បាន បន្ត ថា អគ្គិភ័យ បាន លេប ត្របាក់ ឧបករណ៍ និង វត្ថុធាតុ ដើម រួម មាន អំបោះ និង ក្រណាត់ រាប់ ពាន់ ម៉ែត្រ ។
លោក បាន មានប្រសាសន៍ ថា បណ្តាញ អគ្គិសនី ទាំងអស់ នៅក្នុង ឃ្លាំង និង រោងចក្រ ផលិត របស់ រោងចក្រ នេះ ត្រូវបាន បិទ ដោយសារ រោងចក្រ បាន អនុញ្ញាតឱ្យ កម្មករ ឈប់ សម្រាក មួយ សប្តាហ៍ ដើម្បី អបអរ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ជាមួយ ក្រុមគ្រួសារ ។
ខ្ញុំ នៅ មិន ទាន់ ដឹង ពី មូលហេតុ ពិតប្រាកដ នៃ អគ្គិភ័យ នេះ ទេ ប៉ុន្តែ ខ្ញុំ មិន គាំទ្រ ការសន្មត របស់ ប៉ូលិស ទេ ។ យើង បាន បិទ ភ្លើង នៅក្នុង រោងចក្រ ហើយ កម្មករ របស់ យើង មិន បាន ធ្វើការ ទេ ។ ត្រង់ ចំណុច ណាមួយ មាន ការដាច់ចរន្ត អគ្គិសនី ។ យើង ចង់ឲ្យ មាន ការស៊ើបអង្កេត បន្ថែម ទៀត លើ អគ្គិភ័យ នេះ ។
ក្នុង ករណី ដាច់ដោយឡែក មួយ អាជ្ញាធរ មូលដ្ឋាន បាន រាយការណ៍ ថា មាន អគ្គិភ័យ នៅ ផ្សារ សំរោង យ៉ុង ស្រុក បាទី ខេត្ត តាកែវ ។ អគ្គិភ័យ បាន លេប ត្របាក់ ហាង ចំនួន ២៣០ ក្នុង ចំណោម ២៨២ ហាង នៅ ថ្ងៃព្រហស្បតិ៍ ដែល ជា ថ្ងៃ ចុងក្រោយ នៃ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ។
អភិបាល រង ខេត្ត តាកែវ លោក យ ស ណា ស៊ី បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា អគ្គិភ័យ នេះ ត្រូវបាន គេ ប៉ាន់ប្រមាណ ថា ឆេះ អស់ ប្រហែល ៨លាន ដុល្លារ ខណៈ ហាង ត្រូវបាន ឆេះ និង ខូចខាត ស្ទើរតែ ទាំងស្រុង ។
ម៉ិច ម៉ារីកា តារា សម្ដែង ខ្មែរ ដែល កំពុង មាន ហាង នៅលើ ទីផ្សារ បាន ប្រាប់ សារព័ត៌មាន ក្នុង ស្រុក ថា ទំនិញ ក្នុង ហាង របស់ នាង មាន តម្លៃ ប្រហែល ២ ម៉ឺន ដុល្លារ ។
នាង បាន និយាយ ថា៖ ខ្ញុំ អស់សង្ឃឹម ជាខ្លាំង ដែល ខ្ញុំ គេង មិន លក់ អស់ ពីរ យប់ ដោយសារ ខ្ញុំ បាន បន្ត គិត ពី កាបូប និង ស្បែកជើង ទាំងអស់ នៅ ហាង របស់ ខ្ញុំ ។
អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល លោក ឱ វណ្ណឌីន បាន ថ្លែង ថា មនុស្ស ជិត ៦០០ នាក់ បាន ឆ្លង ជំងឺ ផ្ដាសាយ ក្នុង ខេត្ត ចំនួន ៨ ក្នុង ខែ កន្លងទៅ ។
ក្រសួង កំពុង ណែនាំឲ្យ មាន ការប្រុងប្រយ័ត្ន បំផុត ។
របាយការណ៍ ដែល ចេញផ្សាយ ដោយ Vandine កាលពី ថ្ងៃសៅរ៍ បាន និយាយ ថា ក្រសួង សុខាភិបាល បាន សង្កេតឃើញ ការឆ្លង ជំងឺ ផ្តាសាយ ចន្លោះ ពី ថ្ងៃទី ១៥ ខែសីហា ដល់ ថ្ងៃទី ១៨ ខែកញ្ញា ។
សេចក្តីប្រកាស បន្ត ថា អ្នកជំងឺ ដែល ឆ្លង រួម មាន ព្រះសង្ឃ ៣៦ អង្គ នៅ ខេត្ត តាកែវ ៤៦អង្គ បាត់ដំបង ១៧នាក់ នៅ ត្បូងឃ្មុំ និង ២៦ នាក់ នៅ ខេត្ត បន្ទាយមានជ័យ ។
ក្នុង នោះ ក៏ មាន អ្នកទោស ចំនួន ១៦៩ នាក់ នៅ ខេត្ត កោះកុង និង ១៤៧ នាក់ នៅ ខេត្ត ព្រះវិហារ ។ របាយការណ៍ របស់ វ៉ាន់ ឌីន បាន ឲ្យដឹង ថា អ្នកទោស ចំនួន ៥៧ នាក់ ក្នុង ខេត្ត កំពង់ធំ កំពុង ទទួល ការព្យាបាល ។
ក្រៅពី ព្រះសង្ឃ និង ទណ្ឌិត សមាជិក សហគមន៍ ចំនួន ៦៧ នាក់ ដែល រស់ នៅក្នុង មណ្ឌល សុខភាព សោម ធំ ស្រុក អូរយ៉ាដាវ ខេត្ត រតនគិរី បាន ធ្វើតេស្ត វិជ្ជមាន ។
ដើម្បី ឆ្លើយតប នឹង ជំងឺ គ្រុន ផ្តាសាយ ក្រុមការងារ នៃ មន្ទីរ សុខាភិបាល ខេត្ត ទាំង៨ បាន ធ្វើ សកម្មភាព និង ឆ្លើយតប យ៉ាង សកម្ម ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ និង ផ្តល់ ការព្យាបាល ដល់ ព្រះសង្ឃ និង ប្រជាពលរដ្ឋ ។
ក្នុង ខេត្ត កំពង់ធំ ១៥ ភាគរយ បាន ជាសះស្បើយ ។
នាង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃអាទិត្យ ថា គិត ត្រឹម ថ្ងៃទី ២០ ខែកញ្ញា មិន មាន ករណី ជំងឺ គ្រុន ផ្តាសាយ ថ្មី ទេ ។ ក្រសួង សុខាភិបាល ក៏ បាន ប្រកាស ថា មិន មាន ករណី ឆ្លង ជំងឺ កូវីដ - ១៩ ថ្មី នៅ កម្ពុជា ក្នុង អំឡុង ពេល បុណ្យ ភ្ជុំ បិណ្ឌ នោះ ទេ ។
រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល លោក ម៉ម ប៊ុន ហេង អំពាវនាវ ដល់ ព្រះសង្ឃ ទូទាំង ប្រទេស ចាត់ វិធានការ បង្ការ តាម ការណែនាំ របស់ គ្រូពេទ្យ ដើម្បី ជៀសវាង ការរីករាលដាល នៃ ជំងឺ ផ្តាសាយ ។
លោក ប៊ុន ហេង បន្ត ថា វិធានការ នេះ រួម មាន អនាម័យ ផ្ទាល់ខ្លួន និង បរិស្ថាន រស់ នៅ ស្អាត ជាពិសេស ការលាង ដៃ ។ គួរ ប្រើ របាំង មុខ ជាពិសេស ពេល ចូល វត្ត ឬ នៅ កន្លែង ដែល មាន មនុស្ស ច្រើន ហើយ ពេល ក្អក ឬ កណ្តាស់ ត្រូវ ខ្ទប់ មាត់ និង ច្រមុះ ដោយ កន្សែង ក្រមា ឬ ក្រដាស ជូត មាត់ ។
ជៀសវាង ការប៉ះពាល់ ផ្ទាល់ ជាមួយ ថនិក សត្វ និង បក្សី ។ ប្រសិនបើ ប៉ះពាល់ ពួកគេ គួរ លាង ដៃ នឹង សាប៊ូ ឱ្យ បាន ឆាប់ តាម ដែល អាច ធ្វើ ទៅ បាន មុនពេល ប៉ះ វត្ថុ ឬ មុននឹង ប៉ះ មុខ ។
លោក ក៏ បាន ណែនាំឲ្យ ប្រជាពលរដ្ឋ ផឹក ទឹក ឆ្អិន ក្តៅ និង ញ៉ាំ អាហារ ឆ្អិន ស្រាប់ ។ អាហារ ត្រូវ រក្សា អនាម័យ ហើយ បើ មាន បញ្ហា សុខភាព ប្រជាពលរដ្ឋ មិន គួរ ចូលរួម ក្នុង ពិធី ណាមួយ ឡើយ ។
របាយការណ៍ របស់ បេឡា ជាតិ របប សន្តិសុខ សង្គម ( ប.ស. ស) បាន ឲ្យដឹង ថា រដ្ឋាភិបាល បាន ផ្តល់ ថវិកា ជិត ២០លាន ដុល្លារ ដល់ ម្តាយ ធ្វើ ការ ដែល ជា សមាជិក បេឡា ជាតិ របប សន្តិសុខ សង្គម ក្នុង រយៈពេល ពីរ ឆ្នាំ កន្លងមក នេះ ។
នាយក ប.ស.ស. ស លោក អ៊ុក សំវិជ្ជា មានប្រសាសន៍ ថា ម្តាយ ធ្វើ ការមាន ឋានៈ ខ្ពស់ ក្នុង បញ្ជី អាទិភាព របស់ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន សម្រាប់ ប្រជាពលរដ្ឋ ដែល ត្រូវការ ជំនួយ ។
លោក បាន មានប្រសាសន៍ ថា លោក និង មន្ត្រី បេឡា ជាតិ របប សន្តិសុខ សង្គម បាន និង កំពុង ដឹកនាំ ការអនុវត្ត ប្រាក់ ឧបត្ថម្ភ ហើយ ពួកគេ បាន ធ្វើឱ្យ សេវា កាន់តែ ប្រសើរ និង មាន ប្រសិទ្ធភាព ជាង មុន សម្រាប់ សមាជិក របស់ ខ្លួន ។
អ្នកស្រី មាស សុខ នី បុគ្គលិក បេឡា ជាតិ របប សន្តិសុខ សង្គម ដែល ទើប សម្រាល បាន មានប្រសាសន៍ ថា គ្រួសារ របស់ គាត់ មាន ជីវភាព ក្រីក្រ ហើយ គាត់ ត្រូវ ចំណាយ ប្រាក់ ច្រើន ហួស ហេតុ ពេក ក្នុង អំឡុង ពេល សម្រាល កូន ។ ប៉ុន្តែ ដោយសារ នាង មាន ប័ណ្ណ ប .ស. ស នាង បាន ទទួល ការគាំទ្រ ពី រដ្ឋាភិបាល ។
ខ្ញុំ បាន ទទួល ថវិកា ចំនួន ៤០ ម៉ឺន រៀល ពី រដ្ឋាភិបាល តាមរយៈ ប .ស.ស ។ នេះ មិន មែន ជា ប្រាក់ ច្រើន សម្រាប់ អ្នក ដែល មាន ជីវភាព ធូរធារ នោះ ទេ ប៉ុន្តែ វា ច្រើន សម្រាប់ ខ្ញុំ និង មាន តម្លៃ ណាស់ ក្នុង ការជួយ ដោះស្រាយ ការលំបាក ជាមួយនឹង ស្ថានភាព រស់ នៅ របស់ ខ្ញុំ ។
គំនិត ផ្តួចផ្តើម របស់ រដ្ឋាភិបាល ក្នុង ការជួយ ដល់ ម្តាយ ធ្វើ ការអនុញ្ញាតឱ្យ កម្មករ ដែល សម្រាល បាន កូន ម្នាក់ ទទួលបាន ថវិកា ចំនួន ៤០ ម៉ឺន រៀល ។ អ្នក ដែល មាន កូន ភ្លោះ ទទួលបាន ៨០ ម៉ឺន រៀល និង ម្ដាយ កូន ភ្លោះ ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ១.២លាន រៀល ។
ទស្សនា វីដេអូ៖ យ៉ាងហោចណាស់ មនុស្ស ១៦ នាក់ បាន ស្លាប់ និង ៧៨ នាក់ រងរបួស ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៦ - ១៨ ខែកញ្ញា ។
មន្ត្រី រដ្ឋាភិបាល និង អង្គការ ចរាចរណ៍ បាន និយាយ ថា ចំនួន នេះ គឺជា ការប្រសើរ ជាង ឆ្នាំ មុន ៗ ។
អ្នកនាំពាក្យ អគ្គ ស្នងការ នគរបាល ជាតិ លោក ឆាយ គឹម ឃឿន មានប្រសាសន៍ ថា ចំនួន គ្រោះថ្នាក់ បាន ថយចុះ ២៥ ភាគរយ បើ ធៀប នឹង ឆ្នាំ ២០១៩ ចំនួន អ្នកស្លាប់ មាន តិច ជាង ១០ នាក់ ថយចុះ ៣៨ ភាគរយ ។ ចំនួន ជនរងគ្រោះ បាន ធ្លាក់ចុះ ចំនួន ២នាក់ ។
ក្នុង រយៈពេល ១៦ ថ្ងៃ ចាប់ពី ថ្ងៃ បុណ្យ ភ្ជុំ បិណ្ឌ ដល់ ថ្ងៃទី ០៣ - ១៨ ខែកញ្ញា មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ចំនួន ១៦៥ លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧៤ នាក់ និង របួស ២៧៤ នាក់ ។
ស្ថានភាព ចរាចរណ៍ ឆ្នាំ នេះ ល្អ ជាង ឆ្នាំ មុន ៗ ។ ជា រួម យើង បាន ធានា សន្តិសុខ សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ សាធារណៈ បាន ជោគជ័យ ក្នុង រយៈពេល ១៦ ថ្ងៃ នៃ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ។
លោក បញ្ជាក់ ថា គ្រោះថ្នាក់ ភាគ ច្រើន គឺ បណ្តាល មកពី បើកបរ ហួស ល្បឿន កំណត់ មិន គោរព សិទ្ធិ ក្នុង ស្ថានភាព គ្រោះថ្នាក់ និង បត់ មិន ប្រយ័ត្ន ។ ចំនួន អ្នកស្លាប់ ច្រើន ជាង គេ គឺ នៅ រាជធានី ភ្នំពេញ និង ខេត្ត កំពង់ធំ កណ្តាល ពោធិ៍សាត់ និង តាកែវ ។
នាយក វិទ្យាស្ថាន សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក លោក គង់ រតនៈ មានប្រសាសន៍ ថា អ្នកបើកបរ ជាច្រើន នៅតែ មិន គោរព ច្បាប់ ចរាចរណ៍ ប៉ុន្តែ ស្ថានភាព ហាក់ដូចជា ប្រសើរ ជាង មុន ។
រតនៈ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា៖ ខ្ញុំ គិត ថា ស្ថានភាព ហាក់ដូចជា ល្អ ជាង ឆ្នាំ មុន ៗ បន្តិច ព្រោះ នៅ តាម ដងផ្លូវ ដែល ខ្ញុំ បាន ធ្វើដំណើរ មិន សូវ មាន គ្រោះថ្នាក់ ច្រើន ដូច ឆ្នាំ មុន ៗ ទេ ។ វា នៅតែ មិន ល្អ ដូច ការរំពឹងទុក ។
លោក រតនៈ បញ្ជាក់ ថា គ្រោះថ្នាក់ មិន អាច កំណត់ អត្តសញ្ញាណ បាន ដោយ កត្តា តែ មួយ ទេ ព្រោះ ជាទូទៅ គ្រោះថ្នាក់ តែងតែ មាន កត្តា ជាច្រើន ដូចជា ការបើកបរ ក្រោម ឥទ្ធិពល នៃ គ្រឿងស្រវឹង ល្មើស ល្បឿន ស្ថានភាព ផ្លូវ លំបាក និង អាកាសធាតុ ជាដើម ។
លោក ថា ប្រសិនបើ អ្នកបើកបរ គោរព ច្បាប់ គោរព ច្បាប់ សុវត្ថិភាព និង មិន ពិសារ គ្រឿងស្រវឹង និង បើកបរ ទេ នោះ នឹង មិន មាន គ្រោះថ្នាក់ ច្រើន នោះ ទេ ។
រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក លោក ស ខេង បាន មានប្រសាសន៍ កាលពី សប្តាហ៍ មុន ថា ចំនួន គ្រោះថ្នាក់ ចរាចរណ៍ ក្នុង រយៈពេល ៨ ខែ ដើម ឆ្នាំ នេះ មាន ការថយចុះ បើ ធៀប នឹង រយៈពេល ដូចគ្នា កាលពី ឆ្នាំ មុន ។
ប្លង់ មេ សម្រាប់ គម្រោង សាងសង់ ក្រុង សៀមរាប ដើម្បី សាងសង់ ឬ ជួសជុល ផ្លូវ ចំនួន ៣៨ ខ្សែ ប្រវែង ៩៨.៣៤ គីឡូម៉ែត្រ គ្រោង នឹង ដាក់ បង្ហាញ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ។ គម្រោង នេះ គ្រោង នឹង បញ្ចប់ នៅ ចុង ឆ្នាំ ២០២១ ។
ថ្ងៃ ផុត កំណត់ ត្រូវបាន កំណត់ នៅ ថ្ងៃពុធ ដោយ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន (MPWT) និង ដឹកនាំ ដោយ លោក ទៀ បាញ់ ប្រធាន គណៈកម្មាធិការ អន្តរ ក្រសួង ទទួលបន្ទុក គម្រោង ។
កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពី រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ លោក ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ លោក ស៊ុន ចាន់ថុល និង មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការពារ ជាតិ ។
លោក Banh បាន ណែនាំ ដល់ ក្រុមការងារ ដែល ទទួលបន្ទុក រៀបចំ ផ្លូវថ្នល់ ដើម្បី ឈានដល់ ការឯកភាព គ្នា ផ្នែក បច្ចេកទេស ដើម្បី ធានា ថា ការសាងសង់ មាន គុណភាព ខ្ពស់ និង និរន្តរភាព ។
ហ្វេសប៊ុក លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន នៅ ថ្ងៃទី ៤ ខែកញ្ញា បាន ប្រកាស ថា រដ្ឋាភិបាល នឹង ចំណាយ ថវិកា ១៥០ លាន ដុល្លារ ដើម្បី សាងសង់ ផ្លូវ ទាំង ៣៨ ខ្សែ ក្នុង ខេត្ត សៀមរាប ឡើងវិញ ។
ទោះបី ប្រទេសជាតិ យើង កំពុង ប្រឈមមុខ នឹង ជំងឺ កូវីដ - ១៩ ក៏ដោយ វា មិន ប៉ះពាល់ ដល់ ការអភិវឌ្ឍន៍ ទេ ។ ផ្លូវ តូច និង ធំ ដែល គ្រោង នឹង សាងសង់ នៅក្នុង ទីក្រុង នេះ នឹង ជួយ លើក កំពស់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ។ ផ្លូវ ក៏ នឹង ជួយ ជំរុញ កំណើន សេដ្ឋកិច្ច ផងដែរ ។
លោក ថា លោក នឹង អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក ការដ្ឋាន សាងសង់ ហើយ ថា ចុង ឆ្នាំ ក្រោយ ប្រជាពលរដ្ឋ នឹង ឃើញ ផ្លូវ ស្អាត នៅលើ ទឹកដី អង្គរ ។
លោក ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ ការរួមចំណែក របស់ គ្រប់ ស្ថាប័ន ។ លោក ថា មិន ខ្ជះខ្ជាយ លុយ ទេ ព្រោះ រដ្ឋាភិបាល សន្សំ បាន ជាង ៦០០ លាន ដុល្លារ ដើម្បី អភិវឌ្ឍ ប្រទេស ។
ការស្តារ ហេដ្ឋារចនាសម្ព័ន្ធ នេះ គឺ ដើម្បី ប្រែក្លាយ ទំព័រ ថ្មី ដែល មិន ធ្លាប់ មាន ពីមុន មក នៅក្នុង ផ្លូវ ដែល ឆ្លងកាត់ ខេត្ត សៀមរាប ។
លោក បាន បន្ត ថា៖ នេះ នាំឲ្យ រដ្ឋាភិបាល យកចិត្តទុកដាក់ ក្នុង ការប្រែក្លាយ ទីក្រុង នៃ វប្បធម៌ ចម្រុះ ទៅជា កន្លែង ទាក់ទាញ ភ្ញៀវ ទេសចរ ជាមួយនឹង ការវិនិយោគ បន្ថែម ទៀត ស្រប តាម គោល នយោបាយ អភិវឌ្ឍន៍ របស់ យើង ។
អ្នកនាំពាក្យ MPWT លោក ហ៊ាង សុធាយុទ្ធ បាន និយាយ កាលពី ថ្ងៃព្រហស្បតិ៍ ថា សមាជិក ទាំងអស់ នៃ គណៈកម្មាធិការ អន្តរ ក្រសួង និង ភាគី ពាក់ព័ន្ធ នឹង យក ផែនការ និង ផែនការលម្អិត សម្រាប់ ពិភាក្សា នៅក្នុង កិច្ចប្រជុំ ថ្ងៃទី ២៣ ខែកញ្ញា ។
លោក បាន មានប្រសាសន៍ ថា កិច្ចប្រជុំ នឹង ធ្វើឡើង មួយ ថ្ងៃ បន្ទាប់ពី ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ហើយ យើង នឹង សុំ ការអនុញ្ញាត ពី ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ ដើម្បី បើក ការដ្ឋាន សាងសង់ ក្នុង ពេល ឆាប់ ៗ នេះ ។
នគរបាល ខេត្ត ព្រះសីហនុ បាន សាកសួរ បុរស ម្នាក់ កាលពី ថ្ងៃពុធ ពាក់ព័ន្ធ នឹង ការឈូសឆាយ ដី នៅ តំបន់ ពហុ ប្រើប្រាស់ នៃ ព្រែក ទឹក សាប ក្បាល ឆាយ ក្នុង ឃុំ ប៊ីត ត្រាង ស្រុក ព្រៃនប់ ។
ស្នងការ រង នគរបាល ខេត្ត លោក កុល ផល្លី ទទួលបន្ទុក ឧក្រិដ្ឋកម្ម ធ្ងន់ធ្ងរ បាន និយាយ កាលពី ថ្ងៃព្រហស្បតិ៍ ថា ជនសង្ស័យ គឺជា ម្នាក់ ក្នុង ចំណោម ៣នាក់ ដែល បាន រត់ គេច ពី អនុ រក្ស ។
យើង បាន ទទួល ករណី នេះ ពី មន្ត្រី បរិស្ថាន ។ លោក បាន ដើរល្បាត ក្នុង តំបន់ នោះ ហើយ បាន ចាប់ខ្លួន ជនសង្ស័យ ម្នាក់ ក្នុង ចំណោម ជនសង្ស័យ បី នាក់ នៅ តំបន់ ក្បាល ឆាយ ។ គាត់ បាន បញ្ជូន សំណុំរឿង និង ភស្តុតាង មក យើង ។
សេចក្តីប្រកាស ព័ត៌មាន របស់ មន្ទីរ បរិស្ថាន ខេត្ត ព្រះសីហនុ បាន ឲ្យដឹង ថា រដ្ឋាភិបាល បាន បង្កើត តំបន់ ប្រើប្រាស់ ចម្រុះ នៃ ព្រែក ទឹក សាប ក្បាល ឆាយ ស្ថិត ក្នុង ឃុំ បិត ត្រាំង ស្រុក ព្រៃនប់ នៅ ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០១៦ ។
