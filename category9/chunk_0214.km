គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា (CHRC) នៅ ថ្ងៃពុធ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ស្ថានភាព សិទ្ធិ មនុស្ស ការអនុវត្ត លទ្ធិ ប្រជាធិបតេយ្យ និង នីតិរដ្ឋ នៅ កម្ពុជា ។
CHRC បាន និយាយ ថា លទ្ធិ ប្រជាធិបតេយ្យ មាន គោលការណ៍ រួម ប៉ុន្តែ ការអនុវត្ត របស់ វា មាន ភាពបត់បែន និង ប្រែប្រួល ទៅ តាម បរិបទ និង តម្លៃ នៃ ប្រទេស នីមួយ ៗ ដោយសារ ប្រជាជាតិ នីមួយ ៗ ដាក់ ផលប្រយោជន៍ ជាតិ ជា អាទិភាព ។
នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន ដែល មាន ប្រាំពីរ ទំព័រ CHRC បាន លើកឡើង អំពី បច្ចុប្បន្នភាព នៃ ស្ថានភាព សិទ្ធិ មនុស្ស ការអនុវត្ត ច្បាប់ ការលើកកម្ពស់ លទ្ធិ ប្រជាធិបតេយ្យ និង នីតិរដ្ឋ នៅ កម្ពុជា ។ សេចក្តីប្រកាស ព័ត៌មាន ក៏ បាន ឆ្លើយតប ទៅនឹង អ្វី ដែល CHRC ចាត់ទុក ថា មាន ការរិះគន់ និង ការចោទប្រកាន់ ដោយ មិន មាន មូលដ្ឋាន ច្បាស់លាស់ ដោយ អង្គការ សង្គម ស៊ីវិល មួយចំនួន (CSOs) ដែល ខ្លួន បាន និយាយ ថា " មាន និន្នាការ នយោបាយ ប្រឆាំង នឹង រដ្ឋាភិបាល " ។
លទ្ធិ ប្រជាធិបតេយ្យ មាន គោលការណ៍ រួម ប៉ុន្តែ មិន មាន ស្តង់ដារ រួម ដែល តម្រូវឱ្យ ប្រទេស ទាំងអស់ អនុវត្ត តាម របៀប ដូចគ្នា នោះ ទេ ។ ការអនុវត្ត របស់ វា ត្រូវតែ មាន ភាពបត់បែន និង ផ្លាស់ប្តូរ ទៅ តាម បរិបទ និង តម្លៃ នៃ ប្រទេស និង តំបន់ នីមួយ ៗ ពីព្រោះ ប្រទេស នីមួយ ៗ យក ផលប្រយោជន៍ ជាតិ របស់ ខ្លួន ជា អាទិភាព ។
ដូច្នេះ ការវាយតម្លៃ ប្រកបដោយ ឧត្តម គតិ យុត្តិធម៌ គ្រប់ ជ្រុងជ្រោយ និង មិន លំអៀង នៃ ស្ថានភាព ប្រជាធិបតេយ្យ និង សិទ្ធិ មនុស្ស ក្នុង ប្រទេស មួយ ក៏ ត្រូវ ធ្វើឡើង ដោយ ផ្អែក លើ គោលការណ៍ រួម ក៏ ដូចជា បរិបទ និង តម្លៃ នៃ ប្រទេស និង តំបន់ ។ ស្ថានភាព មិន ត្រូវ វាយតម្លៃ ផ្តោត លើ សិទ្ធិ ណាមួយ ឡើយ ខណៈ ដែល វឌ្ឍនភាព នៃ ការអនុវត្ត សិទ្ធិ ផ្សេង ទៀត ត្រូវបាន បំភ្លេច ចោល ។
CHRC បាន គូសបញ្ជាក់ ពី ការអនុវត្ត ច្បាប់ ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង សកម្មភាព ខុស ច្បាប់ រួមទាំង វិធានការប្រឆាំង នឹង ការតវ៉ា ដើម្បី ដាក់ សម្ពាធ លើ តុលាការ យោបល់ លើ កិច្ចការ ព្រំដែន និង ការរាយការណ៍ ដោយ លំអៀង និង មិន គ្រប់ ជ្រុងជ្រោយ អំពី ស្ថានភាព សិទ្ធិ មនុស្ស ទៅកាន់ អង្គការ សហ ប្រជាជាតិ ។
CHRC ក៏ បាន លើកឡើង ពី វិធានការ របស់ ជន បរទេស និង ស្ថាប័ន អន្តរជាតិ មួយចំនួន ដែល ជ្រៀត ជ្រែក ចូល កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា ។
កាលពី ឆ្នាំ មុន សហរដ្ឋ អាមេរិក បាន ប្រកាស ដាក់ទណ្ឌកម្ម លើ មន្ត្រី កម្ពុជា មួយចំនួន បន្ទាប់ពី ខ្លួន បាន ចោទប្រកាន់ ពួកគេ ថា មាន ជាប់ពាក់ព័ន្ធ នឹង ការរំលោភ សិទ្ធិ មនុស្ស ។ ថ្មី ៗ នេះ សហរដ្ឋ អាមេរិក ក៏ បាន ប្រកាស ដាក់ទណ្ឌកម្ម លើ ក្រុមហ៊ុន ឯកជន មួយ នៅ កម្ពុជា ផងដែរ ។
CHRC បាន និយាយ ថា វា បង្ហាញ យ៉ាង ច្បាស់ ពី ការបាត់បង់ សណ្តាប់ធ្នាប់ អន្តរជាតិ និង ភាពអនាធិបតេយ្យ នៃ នយោបាយ អន្តរជាតិ នា ពេល ថ្មី ៗ នេះ ។ ការ ដែល រដ្ឋ អាច រៀបចំ ច្បាប់ តាម អំពើចិត្ត និង ឯកតោ ភាគី ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង របស់ រដ្ឋ ផ្សេង ទៀត ក្រោម លេស នៃ លទ្ធិ ប្រជាធិបតេយ្យ និង សិទ្ធិ មនុស្ស ព្រមទាំង អនុវត្ត ទណ្ឌកម្ម លើ រដ្ឋ ផ្សេង ទៀត មេដឹកនាំ និង សហគ្រាស ឯកជន ដោយ មិន ឆ្លងកាត់ យន្តការ របស់ អង្គការ សហ ប្រជាជាតិ គឺជា ផលប្រយោជន៍ នយោបាយ ។ ជាង ហេតុផល សិទ្ធិ មនុស្ស ។
CHRC បាន និយាយ ថា កម្ពុជា ដឹង ថា វិធានការ របស់ ប្រទេស ដែល មិន បញ្ចេញ ឈ្មោះ និង ស្ថាប័ន អន្តរជាតិ ផ្សេង ទៀត មាន ភាពលំអៀង អយុត្តិធម៌ និង ប្រើប្រាស់ ស្តង់ដារ ទ្វេ ។ វិធានការ នេះ មាន ហេតុផល នយោបាយ ។ ពួកគេ បាន ប្រើ លទ្ធិ ប្រជាធិបតេយ្យ និង សិទ្ធិ មនុស្ស ជា លេស ដើម្បី ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា ។
យ៉ាងណា ក៏ដោយ កម្ពុជា នឹង បន្ត កិច្ចសហប្រតិបត្តិការ ជាមួយ គ្រប់ យន្តការអន្តរជាតិ និង ភាគី ពាក់ព័ន្ធ ។
អ្នកនាំពាក្យ CHRC លោក ជិន ម៉ាលី ន បាន និយាយ កាលពី ថ្ងៃពុធ ថា សេចក្តីប្រកាស ព័ត៌មាន បាន បង្ហាញ ពី ការពិត នៃ ស្ថានភាព សិទ្ធិ មនុស្ស នៅ កម្ពុជា និង ឆ្លើយតប ទៅ អង្គការ សង្គម ស៊ីវិល ដែល តែងតែ ចោទប្រកាន់ រដ្ឋាភិបាល ថា បាន រំលោភ សិទ្ធិ មនុស្ស ។ សេចក្តីប្រកាស ព័ត៌មាន ក៏ បាន ឆ្លើយតប ទៅ អគ្គ លេខាធិការ អង្គការ សហ ប្រជាជាតិ ដែល បាន បង្ហាញ អំពី ស្ថានភាព សិទ្ធិ មនុស្ស ដោយ ផ្អែក លើ របាយការណ៍ របស់ អង្គការ សង្គម ស៊ីវិល ប្រឆាំង រដ្ឋាភិបាល ។
ប្រធាន វិទ្យាស្ថាន ប្រជាធិបតេយ្យ ដើម្បី ប្រជាធិបតេយ្យ លោក ប៉ា ចាន់ រឿន មានប្រសាសន៍ ថា CHRC និង រដ្ឋាភិបាល មិន គួរ ចាត់ទុក អង្គការ សង្គម ស៊ីវិល ដែល ធ្វើ ការលើ សិទ្ធិ មនុស្ស ជា សត្រូវ ឬ គណបក្ស ប្រឆាំង រដ្ឋាភិបាល នោះ ទេ ព្រោះ ក្នុង សង្គម ប្រជាធិបតេយ្យ ការបញ្ចេញមតិ ត្រូវបាន អនុញ្ញាត ហើយ ជួនកាល មាន ភាពខុសគ្នា ។
ដូច្នេះហើយ រដ្ឋាភិបាល មិន គួរ ចាត់ទុក ទស្សនៈ របស់ អង្គការ សង្គម ស៊ីវិល ដែល ជា ដៃគូ ក្នុង ការអភិវឌ្ឍន៍ ប្រទេស ថា ជា សត្រូវ ឬ ក្រុម ប្រឆាំង នោះ ទេ ។ រដ្ឋាភិបាល គួរតែ ចាត់ទុក សំឡេង របស់ អង្គការ សង្គម ស៊ីវិល ជា មតិ ។
មតិ កែលម្អ មាន តួនាទី ជា ព័ត៌មាន កែលម្អ ការងារ ផ្តល់ សេវា ឬ អភិបាលកិច្ច ។ សង្ឃឹម ថា ការងារ របស់ រដ្ឋាភិបាល និង ការផ្តល់ សេវា ជូន ពលរដ្ឋ មាន គុណភាព និង ប្រសិទ្ធភាព កាន់តែ ប្រសើរ ។
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន ប្រកាស ថា ដោយសារ ស្ថានភាព សេដ្ឋកិច្ច មិន ច្បាស់លាស់ រដ្ឋាភិបាល នឹង ផ្អាក ការដំឡើង ប្រាក់ខែ ដល់ មន្ត្រីរាជការ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ឆ្នាំ ក្រោយ ។
យ៉ាងណាមិញ រដ្ឋាភិបាល នឹង ចំណាយ ១០លាន ដុល្លារ ដើម្បី ផ្តល់ ប្រាក់ ឈ្នួល ដល់ មន្ត្រី ចូល និវត្តន៍ ។
លោក បាន មានប្រសាសន៍ ថា រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ អូន ព័ន្ធ មុនីរ័ត្ន មាន គម្រោង ដំឡើង ប្រាក់ខែ ប៉ុន្តែ ខ្ញុំ បាន សុំ ឱ្យ គាត់ ផ្អាក ការដំឡើង នេះ សម្រាប់ ឆ្នាំ ២០២១ ។ ដូច្នេះ ខ្ញុំ សុំទោស ជាមុន ។
ជាមួយគ្នា នេះ លោក នាយក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា មន្ត្រីរាជការ នឹង រក្សា ប្រាក់ បៀវត្សរ៍ ដដែល ហើយ ប្រាក់ បំណាច់ ឆ្នាំ ថ្មី និង បុណ្យ ភ្ជុំ បិណ្ឌ នៅតែ ផ្តល់ ជូន ។
លោក ថា រដ្ឋាភិបាល ក៏ កំពុង យកចិត្តទុកដាក់ ចំពោះ អតីត យុទ្ធជន និង និវត្ត ជន និង បង្កើន ប្រាក់ បៀវត្សរ៍ របស់ ពួកគេ ។
ប្រាក់ខែ របស់ អ្នកចូលនិវត្តន៍ ពី មុន មាន តែ ៤០ ម៉ឺន រៀល ( ៩៧ ដុល្លារ ) ។ ក្រោយពី កាត់ រួច នៅសល់ តែ ៣០ ម៉ឺន រៀល ប៉ុណ្ណោះ ។ បើ ប្រៀបធៀប នឹង អ្នកចូលនិវត្តន៍ បច្ចុប្បន្ន ប្រាក់ បៀវត្សរ៍ មួយ លាន រៀល ។ ដូច្នេះ មាន ភាពខុសប្លែក គ្នា រវាង អ្នកចូលនិវត្តន៍ ពី មុន និង បច្ចុប្បន្ន ។ ដូច្នេះ យើង នឹង ចំណាយ ប្រហែល ១០ លាន ដុល្លារ ដើម្បី ធានា ថា អ្នកចូលនិវត្តន៍ មុន ៗ មិន ឆ្ងាយ ប៉ុន្មាន ទេ ។
លោក ឡុង រីម សមាជិក ក្រុមប្រឹក្សាភិបាល នៃ សមាគម គ្រូបង្រៀន កម្ពុជា ឯករាជ្យ បាន មានប្រសាសន៍ ថា ខណៈ ដែល រដ្ឋាភិបាល កំពុង ផ្អាក ការដំឡើង ប្រាក់ បៀវត្សរ៍ សម្រាប់ មន្ត្រីរាជការ គួរតែ គិតគូរ ដល់ លំហូរ ទំនិញ នៅលើ ទីផ្សារ ផងដែរ ដើម្បី ចៀសវាង ការឡើង ថ្លៃ ហួសហេតុ ។
រដ្ឋាភិបាល តែងតែ ដំឡើង ប្រាក់ បៀវត្សរ៍ មន្ត្រីរាជការ ជារៀងរាល់ ឆ្នាំ មិន ថា តូច ឬ ធំ ដើម្បីឱ្យ មន្ត្រីរាជការ អាច រស់ បាន ។ បើ ប្រាក់ខែ មិន ឡើង ប៉ុន្តែ តម្លៃ ទំនិញ នៅលើ ទីផ្សារ បន្ត កើនឡើង វា នឹង ប៉ះពាល់ ដល់ ជីវភាព មន្ត្រីរាជការ ។
ប្រធាន ការិយាល័យ សោធន និវត្តន៍ ខេត្ត ព្រៃវែង លោក មីន ថា មានប្រសាសន៍ ថា រដ្ឋាភិបាល បាន ដំឡើង ប្រាក់ សោធន និវត្តន៍ របស់ មន្ត្រីរាជការ ជារៀងរាល់ ឆ្នាំ ដោយ ផ្អែក លើ ប្រាក់ បៀវត្សរ៍ របស់ មន្ត្រី ។ លោក ថា មន្ត្រី ចូល និវត្តន៍ ដែល មាន ប្រាក់ បៀវត្សរ៍ ទាប អាចនឹង កើនឡើង ក្នុង ចន្លោះ ពី ២ ម៉ឺន ទៅ ៣ ម៉ឺន រៀល ក្នុង មួយ ឆ្នាំ ។
លោក ថ្លែង ថា៖ ក្នុង ខេត្ត របស់ ខ្ញុំ មាន មន្ត្រីរាជការ ចូលនិវត្តន៍ ជាង ៣ ពាន់ នាក់ ហើយ ប្រាក់ខែ ទាប បំផុត គឺ ៦០ ម៉ឺន រៀល ។
អ្នកនាំពាក្យ ក្រសួង មុខងារ សាធារណៈ លោក យុគ ប៊ុណ្ណា មានប្រសាសន៍ ថា មន្ត្រីរាជការ ចូលនិវត្តន៍ ដែល ទទួលបាន ការដំឡើង ប្រាក់ សោធន និវត្តន៍ គឺជា អ្នក ដែល ចូលនិវត្តន៍ នៅ ឆ្នាំ ២០១៤ មុនពេល រដ្ឋាភិបាល បញ្ចូល មន្ត្រីរាជការ ទៅក្នុង ប្រព័ន្ធ ថ្មី ។
លោក ប៊ុន ណា បាន មានប្រសាសន៍ ថា ដូច្នេះហើយ មន្ត្រីរាជការ ដែល ចូលនិវត្តន៍ នៅ ឆ្នាំ ២០១៤ ទទួលបាន ប្រាក់ សោធន និវត្តន៍ ទៅ តាម ប្រាក់ខែ ចាស់ របស់ ពួកគេ ដែល ពន្យល់ ពី គម្លាត ប្រាក់ខែ រវាង មន្ត្រី មុន និង មន្ត្រី ចូល និវត្តន៍ បច្ចុប្បន្ន ។
លោក ថា ចំនួន មន្ត្រីរាជការ និង អតីត យុទ្ធជន សរុប ដែល បាន ចូលនិវត្តន៍ នៅ ទូទាំង ប្រទេស មាន ជាង ១០ម៉ឺន នាក់ ។
រដ្ឋាភិបាល អូស្ត្រាលី បាន ផ្តល់ ថវិកា ចំនួន 1 លាន ដុល្លារ អូស្រ្តាលី (714.000 ដុល្លារ ) ក្នុង ការពង្រឹង មន្ទីរពិសោធន៍ គុណភាព ឱសថជាតិ នៃ ប្រទេស កម្ពុជា និង សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ ខណៈ ដែល ប្រទេស ទាំង ពីរ ប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល នៃ ឱសថ ក្លែងក្លាយ នេះ បើ យោង តាម សេចក្តីប្រកាស ព័ត៌មាន ចេញផ្សាយ កាលពី ថ្ងៃពុធ ដោយ ស្ថានទូត អូស្ត្រាលី ប្រចាំ នៅ ភ្នំពេញ ។
សេចក្តីប្រកាស ព័ត៌មាន បាន បន្ថែម ទៀត ថា ការគាំទ្រ របស់ អូស្ត្រាលី នឹង ជួយ ដល់ មន្ទីរពិសោធន៍ ត្រួតពិនិត្យ គុណភាព ផលិតផល សុខភាព ជាតិ របស់ កម្ពុជា ក្នុង ការកែលម្អ ប្រព័ន្ធ គ្រប់គ្រង គុណភាព យុទ្ធសាស្ត្រ មន្ទីរពិសោធន៍ ជាតិ និង ផែនការ អាជីវកម្ម ។ មូលនិធិ នេះ ក៏ នឹង ជួយ បង្កើន ការធ្វើតេស្ត និង ការរាយការណ៍ អំពី ថ្នាំ ដែល មិន មាន ស្តង់ដារ និង ក្លែងក្លាយ (SFM) ផងដែរ ។
លោក Pablo Kang ឯក អគ្គ រដ្ឋទូត អូស្ត្រាលី ប្រចាំ នៅ កម្ពុជា មានប្រសាសន៍ ថា មន្ទីរពិសោធន៍ ត្រួតពិនិត្យ គុណភាព ជាតិ មាន សារៈសំខាន់ ណាស់ ដើម្បី ការពារ ប្រឆាំង នឹង ផលិតផល វេជ្ជសាស្ត្រ ដែល មិន មាន ស្តង់ដារ និង ក្លែងបន្លំ ។ ដូច្នេះហើយ អូស្ត្រាលី មាន មោទនភាព ក្នុង ការជួយ ដល់ មន្ទីរពិសោធន៍ ត្រួតពិនិត្យ គុណភាព ផលិតផល សុខភាព ជាតិ របស់ កម្ពុជា ដើម្បី ទទួលបាន ការទទួលស្គាល់ ពី អង្គការ សុខភាព ពិភពលោក (WHO) ជាមុន ។
សេចក្តីប្រកាស ព័ត៌មាន បាន បន្ថែម ថា អូស្ត្រាលី គឺជា អ្នកគាំទ្រ ដ៏ រឹងមាំ នៃ ប្រព័ន្ធ តាមដាន និង ត្រួតពិនិត្យ សកល របស់ អង្គការ សុខភាព ពិភពលោក (GSMS) ធ្វើការ ដើម្បី កែលម្អ បរិមាណ គុណភាព និង ការវិភាគ ទិន្នន័យ ត្រឹមត្រូវ លើ ផលិតផល SFM និង ដើម្បី ប្រើប្រាស់ ទិន្នន័យ នោះ សម្រាប់ ការបង្ការ ការរកឃើញ និង ការឆ្លើយតប កាន់តែ ប្រសើរឡើង ចំពោះ ការពារ សុខភាព សាធារណៈ ។
ស្ថានទូត បាន បន្ថែម ថា ជំនួយ ចុងក្រោយ របស់ អូស្ត្រាលី សម្រាប់ កម្ពុជា គឺ បន្ថែម លើ ថវិកា ចំនួន 50 លាន ដុល្លារ អូស្រ្តាលី ដែល បច្ចុប្បន្ន ផ្តល់ ដល់ គម្រោង លើកកម្ពស់ សមធម៌ សុខភាព និង គុណភាព ។
អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល អ្នកស្រី ឱ វណ្ណឌីន មិន អាច ទាក់ទង សុំ ការបំភ្លឺ បាន ទេ នៅ ថ្ងៃពុធ ។
ក្រុម អ្នក ប្រមូល សំរាម របស់ ក្រុមហ៊ុន ស៊ីន ទ្រី នឹង ចូល ធ្វើ ការ វិញ នៅ ថ្ងៃព្រហស្បតិ៍ បន្ទាប់ពី កិច្ចប្រជុំ ជោគជ័យ ជាមួយ អាជ្ញាធរ ក្រុង ភ្នំពេញ នៅ ថ្ងៃពុធ ។
កម្មករ ខ្លះ មិន ទាន់ សម្រេចចិត្ត ថា ត្រូវ វិលវិញ ឬ អត់ ។
កម្មករ នឹង ត្រឡប់ ទៅ ធ្វើ ការវិញ ។ ក្រុមហ៊ុន និង សហជីព នឹង សម្រុះសម្រួល បន្ថែម ទៀត ជាមួយ កម្មករ ដោយ ពន្យល់ ពី ច្បាប់ ។
ក្នុង ជំនួប ជាមួយ លោក ស្រេង មន្ត្រី ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ក្រុមហ៊ុន និង សហជីព បាន សម្រេច ថា សំណើ របស់ កម្មករ នឹង ត្រូវ ពិភាក្សា បន្ទាប់ពី កិច្ចសន្យា បាន ផុត កំណត់ ។
ភាគី ទាំងនោះ បាន និយាយ ថា ក្រុមហ៊ុន ដែល រំពឹង ថា នឹង ឈប់ ធ្វើ អាជីវកម្ម នឹង ទទួលខុសត្រូវ តាម ច្បាប់ ហើយ រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង ធានា ឱ្យ កម្មករ មិន បាត់បង់ ប្រាក់ ឈ្នួល ដោយ មិន គិត ពី អនាគត ក្រុមហ៊ុន ឡើយ ។
ថ្លែង ទៅកាន់ កម្មករ ដែល ធ្វើ កូដកម្ម នៅ កន្លែង តវ៉ា នៅមុខ ទីស្នាក់ការ ក្រុមហ៊ុន ស៊ីន ទ្រី កាលពី ថ្ងៃពុធ លោក ស្រេង មានប្រសាសន៍ ថា សាលា រាជធានី ភ្នំពេញ បាន ជ្រើសរើស ក្រុមហ៊ុន ចំនួន បី តាមរយៈ ការដេញថ្លៃ ដើម្បី ប្រមូល សំរាម នា ពេល អនាគត ។
លោក បាន បន្ត ថា៖ យើង នឹង ទទួល អ្នក ទាំងអស់ គ្នា ឲ្យ ធ្វើការ នៅ ក្រុមហ៊ុន ផ្សេង ទៀត ហើយ មិន ធ្វើឱ្យ អ្នក បាត់បង់ ការងារ ឬ អត្ថប្រយោជន៍ ផ្សេង ទៀត ឡើយ ។
លោក ទូច កុសល ប្រធាន សហព័ន្ធ សហជីព កម្មករ ទេសចរណ៍ កម្ពុជា បាន ថ្លែង ថា លោក ចង់ឲ្យ កម្មករ ចូល ធ្វើ ការវិញ ព្រោះ សាលាក្រុង និង ក្រុមហ៊ុន ទទួលខុសត្រូវ រួចហើយ ។
យើង មាន របាយការណ៍ ជាក់លាក់ មួយ ដែល យើង អាច ទុកចិត្ត បាន ។ កន្លងមក យើង មិន បាន យល់ ច្បាស់ ថា អ្នកណា ជា អ្នក ទទួលបន្ទុក លើ អត្ថប្រយោជន៍ កម្មករ ។ ឥឡូវ យើង ដឹង ហើយ ថា ស៊ីន ទ្រី និង រដ្ឋបាល រាជធានី ភ្នំពេញ ទទួលខុសត្រូវ លើ កម្មករ ។
អគ្គ លេខាធិការ សហព័ន្ធ ទេសចរណ៍ លោក ម៉ៃ ផន បាន និយាយ កាលពី ថ្ងៃពុធ ថា កម្មករ មួយចំនួន ដែល ជា អ្នក បោសសម្អាត យល់ព្រម ត្រឡប់ ទៅ ធ្វើ ការវិញ ប៉ុន្តែ អ្នកបើកបរ និង អ្នកប្រមូល សំរាម មិន ទាន់ សម្រេច នៅឡើយ ។
វា ពិបាក ណាស់ ។ កម្មករ ជាច្រើន មិន យល់ព្រម ត្រឡប់ ទៅ ធ្វើ ការវិញ ទេ ហើយ ពួកគេ ចង់ឱ្យ ក្រុមហ៊ុន ផ្តល់ សំណង ដែល ពួកគេ ស្នើសុំ ។ ខ្ញុំ ចង់ឲ្យ ពួកគេ ធ្វើ ការព្រោះ ពួកគេ នឹង បាត់បង់ ប្រាក់ ឈ្នួល និង អត្ថប្រយោជន៍ ផ្សេង ទៀត ប្រសិនបើ ពួកគេ តវ៉ា យូរ ពេក ។
អ្នក ប្រមូល សំរាម ម្នាក់ ឈ្មោះ សុផល បាន និយាយ ថា គាត់ មិន សប្បាយ ចិត្ត នឹង ដំណោះស្រាយ នៅឡើយ ទេ ប៉ុន្តែ ប្រសិនបើ កម្មករ ភាគ ច្រើន ចូល ធ្វើ ការវិញ គាត់ ក៏ ទៅ វិញ ។
អ្នក ប្រមូល សំរាម ប្រហែល ២០០០ នាក់ បាន ធ្វើ កូដកម្ម ចាប់តាំងពី ថ្ងៃទី ២ ខែតុលា ។
ជនជាតិ ចិន ចំនួន ប្រាំមួយ នាក់ ត្រូវបាន ឃុំ ខ្លួន ដើម្បី សាកសួរ កាលពី ថ្ងៃអង្គារ បន្ទាប់ពី ប៉ូលីស ត្រូវបាន ដាក់ពង្រាយ ដើម្បី ត្រួតពិនិត្យ អាវុធ នៅលើ ផ្លូវ ក្នុង សង្កាត់ លេខ 2 ខេត្ត ព្រះសីហនុ ។
ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ លោក ទៀ វិសាល បាន ថ្លែង នៅ ថ្ងៃពុធ នេះ ថា ជនសង្ស័យ ៥ នាក់ ត្រូវបាន ដោះលែង វិញ ហើយ បន្ទាប់ពី សមត្ថកិច្ច បាន សាកសួរ ពួកគេ ។
បុរស អាយុ ៣១ ឆ្នាំ ម្នាក់ កាន់ កាំភ្លើង ដោយ គ្មាន ការអនុញ្ញាត ច្បាប់ ត្រូវបាន គេ រកឃើញ ថា ពាក់ព័ន្ធ ទៅនឹង បទល្មើស ហើយ ត្រូវបាន ឃាត់ខ្លួន ។
លោក វិសាល បញ្ជាក់ ថា៖ សមត្ថកិច្ច ខ្ញុំ កំពុង បន្ត សាកសួរ ជនសង្ស័យ នេះ ដើម្បី កសាង របាយការណ៍ បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ។
កាលពី ថ្ងៃអង្គារ មន្ត្រី ប៉ូលិស បាន ស៊ើបអង្កេត របាយការណ៍ នៃ អាវុធ ជាតិ ផ្ទុះ នៅក្បែរ ផ្សារ ពាណិជ្ជកម្ម ក្នុង ឃុំ ទី ២។ លោក បន្ត ថា មន្ត្រី បាន ឃាត់ រថយន្ត មួយ គ្រឿង ដែល មាន មនុស្ស ៦នាក់ នៅ ខាងក្នុង ។
ម្ចាស់ កាំភ្លើង បាន ប្រាប់ ប៉ូលីស ថា គាត់ និង បក្សពួក គឺជា អ្នកទេសចរ ដែល បាន មកដល់ ខេត្ត ព្រះសីហនុ កាលពី តិច ជាង មួយ ខែ មុន ។ គាត់ ថា គាត់ ទិញ កាំភ្លើង នេះ សម្រាប់ ការពារ ខ្លួន ។
អ្នកសម្របសម្រួល សមាគម ការពារ សិទ្ធិ មនុស្ស អាដហុក ជា សុធារី នៅ ខេត្ត ព្រះសីហនុ មានប្រសាសន៍ កាលពី ថ្ងៃពុធ ថា មនុស្ស ជាច្រើន ផ្លាស់ ទៅ ខេត្ត ព្រះសីហនុ ដើម្បី ធ្វើ ការ ឬ ទេសចរណ៍ ។
សុធារី បន្ត ថា ការហូរ ចូល នៃ មនុស្ស នាំឲ្យ មាន បទល្មើស គ្រឿងញៀន និង ឧក្រិដ្ឋកម្ម ហិង្សា ។
អ្នកស្រី បាន ថ្លែង ថា៖ យើង ឃើញ ថា ទាំង មន្ត្រី ប៉ូលិស និង តុលាការ យកចិត្តទុកដាក់ ខ្លាំង ក្នុង ការស្រាវជ្រាវ រក ជនល្មើស ។
ចៅក្រម ស៊ើបសួរ សាលាដំបូង ខេត្ត មណ្ឌលគិរី បាន កំណត់ មុខ សញ្ញា ជនសង្ស័យ ១០នាក់ ពាក់ព័ន្ធ ករណី លោក ឧត្តមសេនីយ៍ ទោ ពៅ សុធារ៉ាន់ ពាក់ព័ន្ធ ការកាប់ រាន ព្រៃឈើ នៅ ឃុំ ដាក ស្រុក អូរ រាំង ។
អ្នកនាំពាក្យ សាលាដំបូង ខេត្ត លោក មាស ប្រុស មានប្រសាសន៍ កាលពី ថ្ងៃពុធ ថា សុធារ៉ាន់ បាន ទន្ទ្រាន យក ដី ដោយ ខុស ច្បាប់ ។
ចៅក្រម បាន ស៊ើបអង្កេត និង កំណត់ អត្តសញ្ញាណ មនុស្ស ១០នាក់ ។ ខ្ញុំ មិន អាច បង្ហាញ អត្តសញ្ញាណ ពួកគេ តាម នីតិវិធី របស់ តុលាការ បាន ទេ ។ ខ្ញុំ ចង់ រង់ចាំ រហូតដល់ គេ ចាប់ បញ្ជូន ទៅ តុលាការ សិន ទើប យើង ដឹង រឿង ។ យើង បាន ចាប់ខ្លួន ពួកគេ បួន នាក់ រួចហើយ ។
ប្រធាន មន្ទីរ បរិស្ថាន ខេត្ត ព្រះសីហនុ លោក កែវ សុភ័គ បាន ថ្លែង នៅ ថ្ងៃពុធ នេះ ថា មន្ត្រី មន្ទីរ បាន សហការ ជាមួយ មន្ត្រី ថ្នាក់ ជាតិ ដើម្បី ស៊ើបអង្កេត ករណី នេះ ។
ចំពោះ ករណី របស់ សុធារ៉ាន់ ខ្ញុំ បាន ទទួល ព័ត៌មាន ថា តុលាការ បាន ឃុំ ខ្លួន មនុស្ស បួន នាក់ ។ ម្នាក់ ជា នាយក កាសែត ពីរ នាក់ ជា ពលរដ្ឋ និង ម្នាក់ ទៀត ជា ឧត្តមសេនីយ៍ ឯក ។ ពួកគេ ត្រូវបាន ឃុំ ខ្លួន ។ យើង នឹង ស៊ើបអង្កេត បន្ថែម ទៀត ដើម្បី ស្វែងរក អ្នក ពាក់ព័ន្ធ ផ្សេង ទៀត ។
រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ លោក ស ខេង នៅ ថ្ងៃអង្គារ នេះ បាន ស្នើសុំ ប្រធាន ព្រឹទ្ធសភា លោក សាយ ឈុំ ឲ្យ ផ្តល់ យោបល់ ដល់ លោក ណយ ស្រន់ សមាជិក ព្រឹទ្ធសភា ដែល ពាក់ព័ន្ធ នឹង ការទន្ទ្រាន យក ដី ទំហំ ៥៣១ ហិកតា នៅ ឃុំ សែនមនោរម្យ ស្រុក អូរ រាំង ។
បន្ទាប់ពី សំណើ នេះ ព្រឹទ្ធសភា បាន ចេញ លិខិត មួយ កាលពី ថ្ងៃអង្គារ តាម កំណត់ សម្គាល់ មុន ដែល សរសេរ ដោយ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន កាលពី ថ្ងៃទី២ ខែកញ្ញា អំពី របៀប ដែល លោក ស្រ៊ុន ពាក់ព័ន្ធ នឹង ការរៀបចំ ឯកសារ ដើម្បី កាន់ កាប់ ដោយ ខុស ច្បាប់ លើ ផ្ទៃដី ចំនួន ៥៣១ ហិកតា ។
លោក ឈុំ អនុប្រធាន ទី១ ព្រឹទ្ធសភា លោក ស៊ឹម កា និង អនុប្រធាន ទី២ លោក ទេព ង ន បាន ជួប ពិភាក្សា គ្នា អំពី បញ្ហា នេះ ជាមួយ លោក ស្រ៊ុន កាលពី ថ្ងៃទី ២៣ ខែកញ្ញា ។
តាម ការណែនាំ របស់ ថ្នាក់ដឹកនាំ ព្រឹទ្ធសភា លោក ស្រ៊ុន បាន សុំទោស ចំពោះ កំហុសឆ្គង ដែល បង្ក ការលំបាក ដល់ ពួកគេ ។ លោក បាន ចុះហត្ថលេខា លើ លិខិត កាលពី ថ្ងៃទី ២៣ ខែកញ្ញា ដើម្បី បញ្ជាក់ ថា លោក នឹង លែង រំលោភ យក ដី ទៀត ហើយ ។
មន្ត្រី សមាគម អាដហុក លោក ប៉ែន ប៊ុណ្ណារ៍ ថ្លែង នៅ ថ្ងៃពុធ នេះ ថា នៅ ពេល ដែល មន្ត្រី ប្រព្រឹត្ត ខុស ហើយ មាន តែ ការសុំទោស ជា ការផ្ដន្ទាទោស វា បង្ហាញ ថា មាន ស្តង់ដារ ទ្វេ ដង ទាក់ទង នឹង ការអនុវត្ត ច្បាប់ ។
សរុប មក ច្បាប់ មិន ដាក់ទោស មន្ត្រី ជាន់ ខ្ពស់ ទេ ។ អ្នក ដែល ប្រព្រឹត្ត ដូចគ្នា តែ មិន មាន ឋានៈ ខ្ពស់ ត្រូវ អនុវត្ត ច្បាប់ យ៉ាង តឹងរ៉ឹង ។
ការទន្ទ្រាន យក ដី គឺជា ឧក្រិដ្ឋកម្ម ដែល មិន អាច លើកលែង បាន ដោយ ការសុំ ការអភ័យទោស ឬ សារភាព ចំពោះ កំហុស ។ ខ្ញុំ បាន ឃើញ ព័ត៌មាន ចុងក្រោយ ដែល មាន មន្ត្រី ជាន់ ខ្ពស់ ជាច្រើន ដែល ប្រព្រឹត្ត បទល្មើស បញ្ចប់ វា ដោយ ការសុំទោស ដែល ផ្ទុយ នឹង នីតិវិធី ច្បាប់ ។
លោក បន្ត ថា ប្រសិនបើ ប្រព័ន្ធ យុត្តិធម៌ ត្រូវបាន គេ ទុកចិត្ត ម្តង ទៀត ច្បាប់ ត្រូវតែ អនុវត្ត ហើយ អ្នកប្រព្រឹត្ត ល្មើស នឹង ត្រូវ ផ្ដន្ទាទោស ដោយ មិន លម្អៀង ។
ភ្នំពេញ ប៉ុស្តិ៍ មិន អាច ទាក់ទង អ្នកនាំពាក្យ ព្រឹទ្ធសភា លោក ម៉ម ប៊ុន នាង ឬ លោក ស្រ៊ុន ដើម្បី សុំ ការអត្ថាធិប្បាយ បន្ថែម បាន ទេ ។
ព្រឹទ្ធសភា កាលពី ថ្ងៃពុធ បាន ចេញ សេចក្តី បំភ្លឺ មួយ ដោយ និយាយ ថា លោក ស្រ៊ុន មិន ទាន់ បាន កាន់កាប់ ផ្ទៃដី ៥៣១ ហិកតា នៅឡើយ ទេ ។ លោក ស្រ៊ុន ស្ថិត ក្នុង ដំណាក់កាល ដំបូង នៃ ការស្នើសុំ កាន់កាប់ ដី ហើយ អាជ្ញាធរ បាន បដិសេធ សំណើ របស់ លោក ។
តំណាង ស្ថាប័ន សហជីព សហព័ន្ធ សមាគម និង អង្គការ ក្រៅ រដ្ឋាភិបាល ប្រមាណ ៦ បាន ផ្ញើ លិខិត ទៅ រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បន្ទាប់ពី ដឹង ថា អាជ្ញាធរ មូលដ្ឋាន នឹង ចង ក្រង ស្ថិតិ បុគ្គលិក ខ្មែរ និង បរទេស ។ ជា ការឆ្លើយតប អាជ្ញាធរ បាន និយាយ ថា ពួកគេ នឹង មិន បន្ត ធ្វើ ជំរឿន បុគ្គលិក ឡើយ ។
ប្រធាន សហភាព ការងារ កម្ពុជា (CLC) លោក អាត់ ធន់ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃពុធ នេះ ថា នៅ រាជធានី ភ្នំពេញ អាជ្ញាធរ ខណ្ឌ មានជ័យ បាន ផ្ញើ លិខិត មួយ ច្បាប់ ទៅ សហជីព របស់ លោក ដើម្បី ស្នើសុំ ការអនុញ្ញាតឱ្យ ចូលរួម ក្នុង ការធ្វើ ជំរឿន បុគ្គលិក ដែល និយោជិត ទាំងអស់ ត្រូវ មាន រូបថត បញ្ជាក់ ពី មុខ តំណែង របស់ ពួកគេ ។ ឯកសារ បញ្ជាក់ អត្តសញ្ញាណ និង ឯកសារ លិខិត អនុញ្ញាត ស្នាក់ នៅ ។
លោក ថ ន អះអាង ថា សកម្មភាព បែប នេះ ហាក់ ដាក់ សម្ពាធ លើ សហជីព ព្រោះ មួយ រយៈ ចុងក្រោយ នេះ សកម្មជន ត្រូវបាន ចាប់ខ្លួន ។
មេដឹកនាំ សហជីព ក៏ ដូចជា និយោជិត ភាគ ច្រើន តែងតែ ចូលរួម ក្នុង សកម្មភាព សង្គម ក្នុង ការតស៊ូ មតិ ដូច្នេះ ប្រសិនបើ ពួកគេ ត្រូវបាន គេ កំណត់ អត្តសញ្ញាណ ពួកគេ ច្បាស់ជា ជា គោលដៅ ។ វា ពិបាក ក្នុង ការស្វែងរក អ្វី ផ្សេង ទៀត ដូច្នេះ វា ធ្វើឱ្យ បុគ្គលិក និង អ្នកគ្រប់គ្រង របស់ យើង ភ័យខ្លាច ពីព្រោះ ឥឡូវនេះ វា កើតឡើង យ៉ាង ងាយ ចាប់ខ្លួន ។
អ្នកសម្របសម្រួល កម្មវិធី នៃ មជ្ឈមណ្ឌល សម្ព័ន្ធភាព ការងារ និង សិទ្ធិ មនុស្ស ( កណ្តាល ) លោក ឃុន ថា រ៉ូ មានប្រសាសន៍ ថា ជំរឿន បុគ្គលិក របស់ អាជ្ញាធរ មូលដ្ឋាន គឺជា ទម្រង់ នៃ ការបំភិតបំភ័យ និង ប្រឆាំង នឹង ច្បាប់ ។
លោក ថ្លែង ថា៖ នេះ គឺ ផ្ទុយ នឹង គោលការណ៍ នៃ ច្បាប់ ស្តីពី សហជីព គោលការណ៍ នៃ ច្បាប់ ស្តីពី អង្គការ មិន មែន រដ្ឋាភិបាល និង គោលការណ៍ នៃ អនុសញ្ញា ស្នូល របស់ អង្គការ ពលកម្ម អន្តរជាតិ ILO ។
ប្រធាន បណ្តាញ យុវជន កម្ពុជា (CYN) លោក អ៊ុល វណ្ណ មានប្រសាសន៍ ថា ជំរឿន របស់ អាជ្ញាធរ ពាក់ព័ន្ធ ការជ្រៀត ជ្រែក ក្នុង ការរៀបចំ សមាគម ឯករាជ្យ ក្នុង វិស័យ សិទ្ធិ មនុស្ស និង សិទ្ធិ ការងារ ដែល ត្រូវបាន ហាមឃាត់ ដោយ អនុសញ្ញា ស្នូល របស់ ILO ។
លោក បាន បន្ថែម ថា ព័ត៌មាន ដែល កំពុង ទាមទារ ដោយ អាជ្ញាធរ មាន នៅក្នុង របាយការណ៍ ដែល អង្គការ សង្គម ស៊ីវិល បាន ដាក់ ជូន ក្រសួង មហាផ្ទៃ និង ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ រួចហើយ ។
ហេតុ អ្វី បានជា អាជ្ញាធរ មូលដ្ឋាន ក្នុង ខណ្ឌ មានជ័យ ផ្ញើ លិខិត ស្នើសុំ ជំរឿន តែ ពី សហជីព និង អង្គការ ក្រៅ រដ្ឋាភិបាល ដែល ធ្វើ ការលើ វិស័យ សិទ្ធិ មនុស្ស និង ការតស៊ូ មតិ ដើម្បី លើកកម្ពស់ លទ្ធិ ប្រជាធិបតេយ្យ និង ការពារ ធម្មជាតិ ដែល ក្នុង នោះ មាន ស្ថាប័ន ប្រហែល ៤ ទៅ ៥។ ខណៈពេល ដែល ស្ថាប័ន ផ្សេង ទៀត មិន បាន ទទួល លិខិត ? វ៉ាន់ សួរ ។
លោក វណ្ណ បន្ថែម ថា លិខិត នោះ មិន សម ហេតុផល និង មិន ត្រឹមត្រូវ ទេ ដោយសារ ស្ថាប័ន ទាំងនោះ ក៏ ដូចជា អង្គការ ក្រៅ រដ្ឋាភិបាល ផ្សេង ទៀត បាន ធ្វើ បច្ចុប្បន្នភាព ជាមួយ ក្រសួង ពាក់ព័ន្ធ រួចហើយ ។
យើង សង្កេតឃើញ ថា មិន មាន លក្ខខណ្ឌ ផ្លូវ ច្បាប់ ដែល និយាយ ថា យើង ត្រូវតែ ធ្វើ បច្ចុប្បន្នភាព មន្ត្រី មូលដ្ឋាន ជាពិសេស អាជ្ញាធរ ស្រុក ។ ដូច្នេះ យើង មើលឃើញ ថា វា ជា ការរឹតត្បិត លើ សេរីភាព នៃ ការបង្កើត សមាគម ក្នុង ការអនុវត្ត សកម្មភាព របស់ ខ្លួន ក្នុង បរិបទ បច្ចុប្បន្ន ។
អធិការ នគរបាល ខណ្ឌ មានជ័យ លោក ម៉េង វិមាន តារា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃពុធ ថា ជំរឿន មិន មាន ពាក់ព័ន្ធ នឹង ការបំភិតបំភ័យ សហជីព និង អង្គការ ក្រៅ រដ្ឋាភិបាល ដោយ ចេតនា នោះ ទេ ។ អាជ្ញាធរ ចង់ ដឹង អំពី អង្គការ និង សហជីព ទាំងនោះ ។ លោក បន្ត ថា វា ដូចជា ការធ្វើ ជំរឿន ប្រជាជន អ៊ីចឹង ។
អាជ្ញាធរ នឹង មិន ប្រមូល ស្ថិតិ នៅ អង្គការ ទេ លុះត្រាតែ ពួកគេ យល់ព្រម ។ បើ សហជីព និង អង្គការ ក្រៅ រដ្ឋាភិបាល មិន ឯកភាព ទេ អាជ្ញាធរ នឹង មិន ធ្វើ ជំរឿន ទេ ។
ធ្វើ បែប នេះ មិន ដូច ការអនុវត្ត ដីកា ទេ វា គ្រាន់តែ សុំ កិច្ចសហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន អត់ មាន អ្វី ធ្ងន់ធ្ងរ ទេ ។ យើង បាន សម្រេច លុបចោល ផែនការ នេះ ដើម្បី ប្រមូល ស្ថិតិ របស់ សហជីព និង បុគ្គលិក អង្គការ ក្រៅ រដ្ឋាភិបាល ។
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ជំរុញ ឲ្យ ប្រជាកសិករ និង អាជ្ញាធរ មូលដ្ឋាន ពាក់ព័ន្ធ រក្សា ទឹក ទុក ក្នុង អាង ដើម្បី ជៀសវាង ការស្រក នៅ រដូវ ប្រាំង ខាងមុខ ។
លោក ថា យោង តាម ការព្យាករណ៍ អាកាសធាតុ របស់ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ប្រព័ន្ធ សម្ពាធ ទាប ពី សមុទ្រ ចិន ខាងត្បូង ត្រូវបាន គេ រំពឹង ថា នឹង បោកបក់ មក លើ ប្រទេស វៀតណាម នៅ ថ្ងៃពុធ នេះ ដែល បណ្តាលឱ្យ មាន ភ្លៀង ធ្លាក់ បន្ថែម ទៀត នៅក្នុង ប្រទេស កម្ពុជា ។
ទោះជា យ៉ាង នេះ ក្តី លោក ថា កម្រិត ទឹក ទន្លេ នៅ មាន កម្រិត ទាប នៅឡើយ ដែល ទាមទារ ឱ្យ មាន ប្រព័ន្ធ ស្តុក ទឹក ដែល មាន ការរៀបចំ បាន ល្អ ដើម្បី ស្តុក ទឹក សម្រាប់ រដូវ ប្រាំង ។
លោក នាយក រដ្ឋមន្ត្រី បាន ជំរុញ ឱ្យ ក្រសួង ពាក់ព័ន្ធ និង ស្ថាប័ន ជំនាញ ពិចារណា លើ ការស្តុក ទុក ជា យុទ្ធសាស្ត្រ ដើម្បី ត្រៀមខ្លួន ឆ្លើយតប ទៅនឹង ការខ្វះខាត ។ លោក ក៏ បាន ជំរុញ ឱ្យ មាន ការរៀបចំ ព្យុះ ផងដែរ ។
លោក បន្ត ថា៖ យើង ត្រូវ ស្តុក ទឹក ស៊ីអ៊ីវ គុយ ទាវ អង្ករ និង បន្លែ និង ថ្នាំ គ្រប់ ប្រភេទ ដើម្បី សង្គ្រោះ ប្រជាជន យើង ពី ការអត់ឃ្លាន ។
ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត កំពង់ឆ្នាំង លោក ងិន ហ៊ុន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃពុធ ថា យុទ្ធសាស្ត្រ របស់ មន្ទីរ របស់ លោក គឺ សហការ ជាមួយ មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម និង មន្ទីរ ពាក់ព័ន្ធ ផ្សេង ទៀត ដែល ស្ថិត ក្រោម ដែន សមត្ថកិច្ច របស់ ខ្លួន ។
លោក ថា រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង បាន ចុះ ពិនិត្យ ប្រភព ទឹក ក្នុង បឹង ប្រឡាយ និង ប្រព័ន្ធ ប្រឡាយ ដើម្បី ធ្វើ ការវាស់វែង ទប់ស្កាត់ ការរក្សា ទឹក ឬ បើក ប្រឡាយ ដើម្បី ការពារ ការជន់ លិច វាល ស្រែ ។
បើ តាម លោក ងិន ហ៊ុន មន្ទីរ របស់ លោក បាន សហការ ជាមួយ មន្ទីរ ធនធាន ទឹក និង មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត កំពង់ឆ្នាំង ដើម្បី រៀបចំ បូម ទឹក ពី អូរ និង ទន្លេ មួយចំនួន ចូលក្នុង អាង ស្តុក ទឹក ។
ប្រជាពលរដ្ឋ ចំនួន ២០ គ្រួសារ នៅក្នុង ខេត្ត កំពង់ស្ពឺ បាន និយាយ ថា មន្ត្រី បរិស្ថាន បាន បំផ្លាញ ដំណាំ របស់ ពួកគេ រុះរើ ផ្ទះសម្បែង និង បញ្ជា ឱ្យ ពួកគេ ផ្លាស់ ទីលំនៅ ចេញ ពី ដី ដែល ពួកគេ អះអាង ថា បាន រស់ នៅ អស់ រយៈពេល ១០ឆ្នាំ មកហើយ ។
ថ្លែង ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃពុធ អ្នកស្រី សុខ ស្រី ណាត ប្រជាពលរដ្ឋ នៅ ភូមិ ពោធិត្រា ឃុំ ត្រពាំង ជោ មានប្រសាសន៍ ថា អ្នកស្រី និង ប្រជាពលរដ្ឋ ផ្សេង ទៀត បាន អាស្រ័យ ផល លើ ដី នេះ អស់ រយៈពេល ១០ ឆ្នាំ មកហើយ ប៉ុន្តែ អាជ្ញាធរ ភូមិ ឃុំ មិន ដែល ចេញ ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី ទេ ។
ប្រជាពលរដ្ឋ ស្រី លាភ បាន ឲ្យដឹង កាលពី ថ្ងៃពុធ ថា ការដ្ឋាន លំនៅឋាន របស់ ប្រជាពលរដ្ឋ ទាំង ២០ គ្រួសារ នេះ មាន ទំហំ ទទឹង ១០ ម៉ែត្រ និង បណ្តោយ ១០០ ម៉ែត្រ ។
មេឃុំ ត្រពាំងជោ លោក ទេព នឹម មានប្រសាសន៍ កាលពី ថ្ងៃពុធ ដី នេះ មាន ជម្លោះ ជា យូរ មកហើយ ។ លោក ថា ពេល ក្រុមហ៊ុន ក្ស័យ ធន រដ្ឋ យក ដី មក គ្រប់គ្រង វិញ ។
លោក បាន និយាយ ថា កាល នោះ ប្រជាជន រស់ នៅ ទីនោះ ប៉ុន្តែ លោក មិន ដឹង ច្បាស់ ថា តើ ការតាំង ទីលំនៅ របស់ ពួកគេ ពិតជា ត្រូវបាន អនុញ្ញាត ឬ យ៉ាងណា នោះ ទេ ។
ខ្ញុំ មិន ដឹង ច្បាស់ ទេ ប៉ុន្តែ គេ ថា គេ សុំ កុងត្រា បណ្ដោះអាសន្ន ជាមួយ មន្ត្រី បរិស្ថាន ។ នៅ ពេល ដែល ពួកគេ ស្នាក់ នៅ រយៈពេល យូរ រដ្ឋ តម្រូវ ឱ្យ ពួកគេ ចាកចេញ ហើយ ពួកគេ មិន បាន ។ ដូច្នេះ មន្ត្រី បរិស្ថាន បាន ដក ពួកគេ ចេញ ។
នាយក រង ដែន ជម្រក សត្វ ព្រៃ ភ្នំ ឱរ៉ាល់ លោក ហ៊ុល ម៉ារ៉ា បាន ច្រានចោល ការទាមទារ នេះ ។
លោក ថ្លែង ថា៖ ពួកគេ មិន មែន ជា ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ទេ ប៉ុន្តែ ពួកគេ បាន ឆ្លៀត ឱកាស យក ដី ទាមទារ ពី រដ្ឋាភិបាល បែងចែក ឲ្យ ពួកគេ ។
លោក បន្ត ថា ពលរដ្ឋ រស់ នៅ តំបន់ នោះ អះអាង ថា បាន មកដល់ ១០ឆ្នាំ តាម ឯកសារ ប៉ុន្តែ តាមពិត ទើប មក នៅ ខែកុម្ភៈ ។
ការតាំង ទីលំនៅ របស់ ពួកគេ រួម មាន ការកាប់ ព្រៃ ដើម្បី ធ្វើ របង និង លក់ ដី ឲ្យ អ្នកដទៃ ។ អ្នកទិញ បាន ប្តឹង ពួកគេ ព្រោះ ពួកគេ មិន អាច ស្នាក់ នៅ ទីនោះ បាន ។ អ្នកទិញ មិន ត្រូវបាន អនុញ្ញាតឲ្យ រស់ នៅ ទេ ដូច្នេះ ពួកគេ ទុកឲ្យ អ្នកលក់ រស់ នៅ ទីនោះ ។
លេខាធិការដ្ឋាន នៃ គណៈកម្មាធិការ ជាតិ សម្រាប់ សន្តិសុខ ដែន សមុទ្រ (NCMS) បាន បញ្ជាក់ ជាថ្មី នូវ ការប្តេជ្ញាចិត្ត របស់ ខ្លួន ក្នុង កិច្ចសហប្រតិបត្តិការ យ៉ាង ជិតស្និទ្ធ ជាមួយ ដៃគូ អន្តរជាតិ ទាំងអស់ ដើម្បី បង្កើន សមត្ថភាព របស់ ទី បញ្ជាការបញ្ជាការ យុទ្ធសាស្ត្រ (TCH) ។
ការប្តេជ្ញាចិត្ត នេះ ត្រូវបាន ធ្វើឡើង នៅក្នុង សេចក្តីថ្លែងការណ៍ ផ្លូវការ មួយ ដើម្បី បញ្ជាក់ ពី ការរុះរើ TCH នា ពេល ថ្មី ៗ នេះ ដែល មាន ទីតាំង នៅ មូលដ្ឋាន ទ័ព ជើងទឹក រាម ក្នុង ខេត្ត ព្រះសីហនុ ដែល ត្រូវបាន ជួសជុល ដោយ សហរដ្ឋ អាមេរិក ។ TCH គ្រោង នឹង ផ្លាស់ប្តូរ ទីតាំង ចម្ងាយ ប្រហែល ៣០ គីឡូម៉ែត្រ ទៅ កោះ ព្រាប ។
លេខាធិការដ្ឋាន NCMS ប្តេជ្ញា យ៉ាង មុតមាំ ក្នុង ការរក្សា និង លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ជិតស្និទ្ធ ជាមួយ ដៃគូ អន្តរជាតិ ទាំងអស់ ប្រកបដោយ តម្លាភាព និង ការគោរព ផលប្រយោជន៍ ទៅ វិញ ទៅមក ។
វា បាន និយាយ ថា ទីតាំង ចាស់ មិន មាន កន្លែង ចត និង សក្តានុពល មាន កម្រិត ក្នុង ការពង្រីក ហេដ្ឋារចនាសម្ព័ន្ធ ។ វា ក៏ បង្ហាញ ពី ការលំបាក សម្រាប់ បុគ្គលិក ដែល មិន មែន ជា យោធា ក្នុង ការធ្វើការ នៅក្នុង តំបន់ ហាមឃាត់ ពិសេស នេះ ។
NCMS បាន និយាយ ថា ក្នុង នាម ជា ស្ថាប័ន ជាតិ TCH ទាមទារ ទីតាំង ឯករាជ្យ ដែល អាច ជួយ សម្រួល និង បង្កើន ប្រតិបត្តិការ អន្តរាគមន៍ និង កិច្ច ខិតខំ ប្រឹងប្រែង ជួយសង្គ្រោះ ។
TCH ត្រូវការ ដើម្បី អភិវឌ្ឍ សមត្ថភាព របស់ ខ្លួន តាមរយៈ ហេដ្ឋារចនាសម្ព័ន្ធ និង ប្រសិទ្ធភាព ប្រតិបត្តិការ ហើយ វា មិន អាច សម្រេចបាន នៅ ទីតាំង មុន របស់ ខ្លួន ឡើយ ។
ក្រោម កម្មវិធី យោធា ក្នុង កិច្ចសហប្រតិបត្តិការ ជាមួយ ដៃគូ អន្តរជាតិ សហរដ្ឋ អាមេរិក និង អូស្ត្រាលី បាន ផ្តល់ ការគាំទ្រ ជាមួយនឹង ហេដ្ឋារចនាសម្ព័ន្ធ ខ្នាត តូច និង ការបណ្តុះបណ្តាល ។
វា បាន និយាយ ថា ការផ្លាស់ ទីលំនៅ នេះ ត្រូវបាន ធ្វើឡើង បន្ទាប់ពី ការសិក្សា ដែល បាន ធ្វើឡើង ក្នុង ឆ្នាំ 2017 ។ វា ក៏ បាន ពន្យល់ ពី មូលហេតុ នៃ ការផ្លាស់ប្តូរ ទីតាំង ទៅ កាន់ ដៃគូ អន្តរជាតិ ជាពិសេស សហរដ្ឋ អាមេរិក ហើយ មិន បាន ទទួល ការជំទាស់ ជា ផ្លូវការ ណាមួយ ចំពោះ ផែនការផ្លាស់ប្តូរ ទីតាំង នោះ ទេ ។
NCMS បាន និយាយ ថា " ទីតាំង ថ្មី នេះ នឹង ជួយ សម្រួល ដល់ ការបង្កើន ប្រសិទ្ធភាព ប្រតិបត្តិការ ជាមួយនឹង កន្លែង ចត របស់ ខ្លួន សម្រួល ទំនាក់ទំនង រវាង ស្ថាប័ន ជាតិ ពាក់ព័ន្ធ ផ្តល់ សេរីភាព សម្រាប់ ការពង្រីក ហេដ្ឋារចនាសម្ព័ន្ធ បន្ថែម ទៀត និង លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ជាមួយ ដៃគូ អន្តរជាតិ " ។
ប៉ុន្មាន ថ្ងៃ កន្លងមក នេះ អង្គការ ដែល មាន មូលដ្ឋាន នៅ សហរដ្ឋ អាមេរិក និង សារព័ត៌មាន បរទេស ជាច្រើន បាន ចុះផ្សាយ អត្ថបទ ជា បន្តបន្ទាប់ ថា កម្ពុជា បាន រុះរើ អគារ ដែល សាងសង់ ដោយ សហរដ្ឋ អាមេរិក ហើយ ការពង្រីក កំពង់ផែ រាម កំពុង ដំណើរការ ដោយ មាន ការគាំទ្រ ពី ប្រទេស ចិន ។
ទោះ យ៉ាងណា ការរុះរើ អគារ និង ការពង្រីក កំពង់ផែ រាម ត្រូវបាន គេ គ្រោង ទុក មុន នេះ ។ កាលពី ថ្ងៃទី១ ខែមិថុនា លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន និយាយ អំពី ការអភិវឌ្ឍ កំពង់ផែ នេះ ពេល លោក ចុះ ពិនិត្យ ការអភិវឌ្ឍ នៅ ខេត្ត ព្រះសីហនុ ។
លោក ហ៊ុន សែន បាន ថ្លែង ថា៖ ច្រក នេះ មិន អាច មើលឃើញ ថា ជា សំណង់ របស់ ចិន ទេ ដោយសារតែ វា ជា មូលនិធិ ដោយ ប្រទេស ចិន ។ និយាយ ឱ្យ ត្រង់ ទៅ យើង ត្រូវការ ហិរញ្ញប្បទាន ពី ចិន ដើម្បី សាងសង់ វា ។ ទោះ យ៉ាងណា ក៏ដោយ យើង នឹង ស្វាគមន៍ ការផ្តល់ មូលនិធិ ពី គ្រប់ ភាគី ដែល ចាប់អារម្មណ៍ ។
នៅលើ ការចូល ទៅកាន់ មូលដ្ឋាន ទ័ព ជើងទឹក រាម ខ្ញុំ ចង់ ប្រកាស ថា យើង ស្វាគមន៍ កប៉ាល់ មក ពី គ្រប់ ប្រទេស រួមទាំង សហរដ្ឋ អាមេរិក បារាំង កាណាដា ឥណ្ឌា ចក្រភព អង់គ្លេស ជប៉ុន អូស្ត្រាលី ហើយ មិន ត្រឹមតែ មកពី ប្រទេស ចិន ប៉ុណ្ណោះ ទេ ដើម្បី ធ្វើ ការហៅ តាម កំពង់ផែ ឬ ចូលរួម ក្នុង ការរួមគ្នា ។ ហាត់ សម ជាមួយ កម្ពុជា ។
វា គ្មាន មូលដ្ឋាន ទេ ក្នុង ការអះអាង ថា កម្ពុជា បាន ផ្តល់ សិទ្ធិ ផ្តាច់ មុខ ដល់ ចិន ពី ៥០ ទៅ ៩០ ឆ្នាំ សម្រាប់ មូលដ្ឋាន នេះ ។
លោក ហ៊ុន សែន ថ្លែង ថា កម្ពុជា ស្វាគមន៍ រាល់ ជំនួយ ពី ប្រទេស នានា រួម មាន សហរដ្ឋ អាមេរិក បារាំង ជប៉ុន និង ចិន ដើម្បី សាងសង់ ទីស្នាក់ការ កណ្តាល និង អភិវឌ្ឍន៍ កំពង់ផែ ។
លោក ថា ការពង្រីក កំពង់ ផែ នេះ កើតឡើង ដោយសារ កម្ពុជា ពិបាក យក កប៉ាល់ មក ជួសជុល ពី ប្រទេស ថៃ និង វៀតណាម ។ នៅ ពេល ដែល ច្រក នេះ ត្រូវបាន សាងសង់ វា នឹង មាន កន្លែង សម្រាប់ ជួសជុល ដែល បើកចំហ សម្រាប់ ទាំងអស់ គ្នា ។
លោក ថា បើ ទោះជា កម្ពុជា ទទួលបាន ហិរញ្ញប្បទាន ពី ប្រទេស ចិន ដើម្បី អភិវឌ្ឍ កំពង់ផែ ក៏ដោយ ក៏ នឹង មិន អនុញ្ញាតឱ្យ កងទ័ព បរទេស ប្រើប្រាស់ វា ជា មូលដ្ឋាន យោធា នៅក្នុង ប្រទេស នោះ ទេ ព្រោះ វា ផ្ទុយ នឹង រដ្ឋធម្មនុញ្ញ ។
បន្ទាប់ពី ការពិភាក្សា កាលពី ថ្ងៃច័ន្ទ និង ថ្ងៃអង្គារ រវាង តំណាង ក្រុមហ៊ុន Nutrilatt ដែល ជា អ្នកនាំចូល ផលិតផល ម្សៅ ទឹកដោះគោ និង ឪពុក ម្តាយ របស់ កុមារ ដែល រង ផល ប៉ះពាល់ តាមរយៈ ការប្រើប្រាស់ ផលិតផល របស់ ខ្លួន អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ ការប្រកួតប្រជែង និង ការទប់ស្កាត់ ការក្លែងបន្លំ របស់ ក្រសួង ពាណិជ្ជកម្ម បាន ផ្តល់ ពេល ឱ្យ ភាគី ទាំង ពីរ រយៈពេល មួយ ខែ ។ ដើម្បី ដោះស្រាយ បញ្ហា នៅ ក្រៅ តុលាការ ។
យើង កំពុង ផ្តល់ ពេល ឱ្យ ពួកគេ ដើម្បី ដោះស្រាយ បញ្ហា នេះ ខណៈ ដែល ដំណោះស្រាយ ដោយ ព្រះរាជអាជ្ញា ជា ជំហាន បន្ទាប់ ។ យើង ទុក ពេល ឲ្យ ក្រុមហ៊ុន មួយ ខែ ដើម្បី ធ្វើ របាយការណ៍ ពិនិត្យ និង ផ្តល់ សំណង ដល់ ឪពុក ម្តាយ ទាំងនោះ ។ ពួកគេ អាចនឹង ដោះស្រាយ បែប នេះ ។
បន្ទាប់មក ពួកគេ បាន ដាក់ ពាក្យ បណ្តឹង ទៅ ក្រសួង សុខាភិបាល និង អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ ការប្រកួតប្រជែង និង ការទប់ស្កាត់ ការក្លែងបន្លំ របស់ ក្រសួង ពាណិជ្ជកម្ម ក្នុង ខែកក្កដា និង សីហា ។
