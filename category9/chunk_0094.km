ហើយគាត់បាននិយាយថា៖ « កុំដាក់ដៃលើក្មេងនោះឡើយ ហើយកុំធ្វើអ្វីចំពោះគាត់ឡើយ ដ្បិតឥឡូវនេះខ្ញុំដឹងថាអ្នក កោតខ្លាចព្រះ ដោយឃើញថាអ្នកមិនបានដកកូនប្រុស តែមួយរបស់អ្នកពីខ្ញុំទេ » ។ ( ២២: ១២)
អ្វី គ្រប់ យ៉ាង ដើម្បី បំបែក ជញ្ជាំង ផ្ទះល្វែង ។
ឱកាស ដែល អ្នក នឹង អាច និយាយ ជាមួយ អ្នក ដែល និយាយ ភាសា អង់គ្លេស បាន ។
ទី១ ការ ដែលគាត់ឆ្លើយ បញ្ជាក់ថាគាត់នៅ តុរបស់គាត់ !
របស់ អ៊ីរ៉ង់ ទេ ។
ពួកយើង ភាគ ច្រើន ស្គាល់ ពី គ្រោះថ្នាក់ នៃ ការបំពុល បរិយាកាស ខាងក្រៅ ។
មនុស្ស ខ្លះ មិន ស្គាល់ ពួកគេ រហូតមកដល់ ពេលនេះ ។
ពួកគេបានបោកសម្លៀក បំពាក់របស់ខ្លួនដោយឈាមរបស់កូនចៀម ។
នៅក្រោម ស្ពាន - ជីវិត ផ្ទាល់ខ្លួន របស់ ពួកគេ ។
ពី សតវត្ស ទី ដប់ ប្រាំ ។ ទៅ លើ ភាពញឹកញាប់ និង អាំង តង់ស៊ីតេ នៃ ការវាយប្រហារ
នៅក្នុង សមរភូមិ ដើម្បី សង្គ្រោះ
សៀវភៅ សុភាសិត គឺ ពោរពេញ ដោយ ប្រាជ្ញា ហើយ ត្បូង ដែល នៅ ខាងក្នុង កំពុង ស្រែក ឱ្យ អ្នក ចាប់ យក និង បញ្ចូល ទៅក្នុង បេះដូង របស់ អ្នក ។
បុរសដែលនិយាយថា “ ខ្ញុំស្គាល់ទ្រង់ ” ប៉ុន្តែមិនធ្វើតាមបង្គាប់នោះទេ គឺ ជាអ្នកកុហក ហើយសេចក្តី ពិតក៏មិននៅក្នុងខ្លួនដែរ ។
អ្នក ណានិយាយថា “ ខ្ញុំស្គាល់ទ្រង់ ” តែមិនធ្វើតាមបង្គាប់ នោះជាមនុស្សកុហក ហើយសេចក្តី ពិតក៏មិននៅក្នុងខ្លួនដែរ ។
ទាំង នេះ គឺជា ដើមឈើ លូតលាស់ យឺត ។
ហេតុ អ្វី បានជា អ្នក មិន តវ៉ា ចំពោះ ការពិត ដែល ថា អ្នក ដែល គ្រប់គ្រង ជីវិត របស់ អ្នក បាន ធ្វើឱ្យ អ្នក ខាតបង់ គ្រប់ យ៉ាង ។
អ្នក ហាក់ដូចជា អ្នកសុំ ទាន ។
អ្នកបម្រើ អ្នក បំរើ ចូរ ពន្យល់ លោកគ្រូ ។
ដូច ដែល ព្រះជាម្ចាស់ បាន ធ្វើ ។
កុំ បារម្ភ អំពី ការគូរ ផ្នែក ខាងក្រោម នៃ ការតុបតែង ព្រោះ វា នឹង មិន អាច មើលឃើញ ។
វាជាដីគ្មានមនុស្ស ណាដែលមនុស្សអាក្រក់ ណាដែលមិនចង់បានត្រូវបញ្ជូន មក » ។
វា ពិតជា មិន ស្រួល ដូច និយាយ ថា ចង្កឹះ ។
យើង កំពុង សុំ ការអធ្យាស្រ័យ របស់ អ្នក ដើម្បី កុំ ឱ្យ ជនជាប់ចោទ ត្រូវ ឆ្លងកាត់ ការកាត់ក្តី ដែល គាត់ មិន ត្រូវ ប្រឈមមុខ ។
ហើយ នៅ ពេល ដែល គាត់ និយាយ អំពី អំណាច នៃ ព្រះ ដើម្បី រីកចម្រើន ។
ខ្ញុំ ដឹង ថា អ្នក បាន ថត រូប សត្វ ក្តាន់ របស់ កូនស្រី អ្នក ។
សុបិន្ត ក្លាយជា ការពិត ហើយ ពួកគេ ខ្លះ ទទួលបាន ជោគជ័យ ។
ស្លាក ពេលវេលា នៃ ពេល ដែល ពួកគេ ត្រូវបាន ផ្ទុក ឡើង ។
ខ្ញុំ បាន មើល វា ដូច ដែល ខ្ញុំ ត្រូវ
បើនិយាយពីការ ប្រកាសរបស់សម្ដេច
អ៊ីរ៉ង់បានបដិសេធចំពោះការ លើកឡើងនេះ ដោយលើកឡើងថា ចក្រភពអង់គ្លេសកំពុងធ្វើជំនួសឲ្យសហរដ្ឋអាមេរិក ។
សេចក្តីស្រឡាញ់ និង ការដឹង គុណ ចំពោះ
ជាអកុសលនៅយប់មិញនេះយើងជួប ប្រទះនឹងភ្លើង ...
យើងបានទទូចឲ្យព្យួរលើទិដ្ឋភាពនៃបណ្តា សា នៃអំពើ បាបនេះ ។
នៅ ពេល ដែល មនុស្ស ស្ថិត ក្នុង ដំណាក់កាល នៃ ការផ្លាស់ប្តូរ មាន ការភ័យខ្លាច នៅ ចំពោះមុខ ពួកគេ ។
« អ្នក ជាមនុស្សម្នាក់ក្នុងចំណោមអ្នកដែលនៅជាមួយនឹងព្រះ យេស៊ូ ជាអ្នកស្រុកកាលីឡេ!» ។
10 ហើយគេយកចង្រ្កានទៅឈរនៅចំពោះព្រះចៅផារ៉ោន ហើយលោកម៉ូសេ បានបោះវាឡើងលើអាកាស ហើយវាបានក្លាយទៅជាការ ផ្ទុះនៃ ខ្ទុះលើមនុស្ស និងសត្វ ។
កម្ពុជា ពិតជា មិន ធម្មតា មែន ។
នេះ កំពុង បង្កើត បញ្ហា សម្រាប់ អ្នក ជួល បច្ចុប្បន្ន របស់ យើង ។
ហេតុ អ្វី បានជា គាត់ ធ្វើ បេសកកម្ម ទៅ កាន់ តំបន់ ជាច្រើន នៃ ពិភពលោក ?
វា មិន ញឹកញាប់ ទេ ដែល អ្នកទម្លាក់ អ្វី មួយ
ប៉ុន្តែដើម្បីធ្វើការ សម្រេច ចិត្តបានល្អបំផុតសម្រាប់ខ្លួនឯង អ្នកត្រូវសួរខ្លួនឯងថាតើអ្នកចង់បានអ្វី ?
អ្នក គោរពបូជាច្រើននៃការ មិនសុចរិត
ក្មេងប្រុសដែល កាន់ដៃម្ខាងទៀតរបស់នាងមិនអាចមានអាយុច្រើនជាងដប់ ប្រាំពីរនាក់នោះទេ ។
គ្រប់គ្រង , រំលឹក ភាព អនាមិក នៃ ចម្លើយ ។
• ការមាន អំណាច មិន នាំមក នូវ សន្តិភាព ឬ ការពេញចិត្ត នោះ ទេ ។
ដោយសារតែ ពេលនេះ សញ្ញា ទាំងអស់ ចង្អុល ទៅ ខាង មេរោគ ។
សម្រាប់ ឆ្នាំ និង ផល ប៉ះពាល់ ។
ខ្ញុំពិតជាមាន ពរណាស់ដែលអាចបង្កើតរូប មន្តដែលមនុស្សចូល ចិត្តយ៉ាងពិតប្រាកដ » ។
ច្បាប់ អន្តោប្រវេសន៍ នៅ សហរដ្ឋ អាមេរិក គឺ ខុស ។
មិន អាច ចាប់ផ្តើម ដោយ ងាយស្រួល និង អាច ទុកចិត្ត បាន ។
អ្វីដែលគួរឱ្យភ្ញាក់ផ្អើលនោះគឺថាវាមិនបានណាត់ជួបច្រើន។
លោកយេស៊ូត្រូវបានគេឆ្កាងជាមួយនឹងឧក្រិដ្ឋ ជនពីរនាក់ ហើយម្នាក់ទៀត « ជេរប្រមាថគាត់ដោយនិយាយថា៖ « អ្នកមិនមែនជាព្រះ គ្រីស្ទឬ ?
ចូលរួម ជាមួយ ពួកយើង នៅ ពេល ដែល យើង នាំ អ្នក ជុំវិញ ពិភពលោក ហើយ បង្ហាញ អ្នក នូវ កិច្ចព្រមព្រៀង ធ្វើដំណើរ ដ៏ ល្អ បំផុត សម្រាប់ ( ស្ទើរតែ ) ដោយ ឥត គិត ថ្លៃ ។
ព្រះអម្ចាស់មិនបានធ្វើ កិច្ចព្រមព្រៀងនេះជាមួយនឹងបុព្វបុរសរបស់យើងទេ ប៉ុន្តែជាមួយយើង យើងទាំងអស់គ្នាដែល រស់នៅ ទីនេះសព្វថ្ងៃ ។
ខ្ញុំគិតថា ប៉ុន្តែមិនប្រាកដថាវិចិត្រសាលក៏នឹងមានដែរ ។
រដ្ឋាភិបាលក៏មិនយុត្តិធម៌ដែរ ។
ពួកគេមិនអាចលៃល ក ដំបូលក្បាលបានទេ ។
យើងដឹងថាព្រះជាម្ចាស់មានព្រះបន្ទូលមក កាន់លោកម៉ូសេ ប៉ុន្តែយើងមិនដឹងថាលោកមកពី ណាទេ » ។
ម្យ៉ាងទៀត យើងមានគោលដៅបំផ្លាញរដ្ឋអ៊ីស្រាអែល » ។
អ្នកស្រី ហ្វីលីព និយាយថា៖ «យាយចាស់កំប្លែង » ។
ស៊ូ យូ មានជំងឺចលនា ។
ឆ្កែត្រូវបានគេព្យួរ កជាមេធ្មប់ ។
ប្រជាជន ដែល រស់ នៅ ជើង ភ្នំ មាន
ពួកគេនឹងនិយាយថា ' យើងនឹងឲ្យរបស់ល្អរបស់យើងទៅអ្នក ប្រសិនបើអ្នកឲ្យរបស់ល្អច្រើនដល់យើង ' ។
