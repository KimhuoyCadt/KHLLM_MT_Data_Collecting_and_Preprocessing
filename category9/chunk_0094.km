យេរេមា 50:20 ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលថា នៅ គ្រានោះ និងនៅ គ្រានោះ យើងនឹងស្វែង រកអំពើទុច្ចរិតរបស់ជន ‌ជាតិអ៊ីស្រា ‌ អែល តែគ្មានទេ ។ ចំពោះ អំពើ បាប របស់ ជនជាតិ យូដា តែ គេ នឹង រក មិន ឃើញ ឡើយ ។ ដ្បិតខ្ញុំនឹងលើកលែងទោសអ្នកដែលខ្ញុំចាកចេញទៅជាអ្នកដែលនៅសេសសល់ » ។
កាលពីសប្តាហ៍មុន គាត់ថែមទាំងបានចូលរួមក្រុមរបស់យើងទៀតផង ។
ពេលចូលទៅក្នុងម្លប់ដើមឈើខ្ពស់ៗក៏មកដល់
ហើយមនុស្សសាមញ្ញទាំងអស់បានជឿថា យ៉ូហានជាហោរា ។
ហេតុនេះហើយបានជាព្រះ‌បន្ទូលរបស់ព្រះ‌ជា ‌ អម្ចាស់
ក្នុង អំឡុង ពេល សម្អាត និទាឃ រដូវ ដែល ត្រូវការ ច្រើន
១៧ ហើយក្នុងក្រឹត្យ វិន័យរបស់អ្នក មានចែងទុកថា ទី បន្ទាល់របស់បុរសពីរនាក់គឺពិត ។
ទោះបីជា ខ្ញុំ មិន តែងតែ យល់ព្រម ក៏ដោយ ក៏ ខ្ញុំ ទទួលស្គាល់ សិទ្ធិ របស់ មនុស្ស ក្នុង ការបញ្ចេញមតិ របស់ ពួកគេ ។
សម្រាប់អ្នកផ្សេងទៀតសូមដាក់ចំណងជើងរង !
ព្រះអម្ចាស់នៃផែនដីទាំងមូល » ។
មនុស្សជាច្រើននិយាយថា " តើអ្នក ណានឹងបង្ហាញយើងពី ភាពល្អ ? "
ចែករំលែក ជំនឿ របស់ អ្នក ជាមួយ អ្នកដទៃ ។
គ្រប់គ្រង ពួកវា នីមួយ ៗ ហើយ ក្រឡេក មើល ជ្រុង សម្រាប់ សញ្ញា នៃ ថ្ម ម៉ាប ។
អ្នក ដែល ពួកគេ បាន ណែនាំ ។
ការយល់ដឹង នៅក្នុង សៀវភៅ នេះ នឹង លើក អ្នក ទៅកាន់ កម្ពស់ ថ្មី ។
ដែលគ្មានការ បំផ្លិចបំផ្លាញ ( នោះគឺ ជាអ្នកដែលនៅអស់ កល្ប ជានិច្ច ) ។
ខ្ញុំ ត្រូវការ មិត្ត ស្រី សម្រាប់ ថ្ងៃ ។
មិនមានគុណធម៌ទេ ប៉ុន្តែពូកែជាង ។
កើតមក ហើយត្រូវបានគេហៅពីដើម មក
