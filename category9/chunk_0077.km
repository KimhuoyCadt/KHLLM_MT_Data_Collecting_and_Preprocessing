វា មាន សារៈសំខាន់ ជាពិសេស សម្រាប់ ប្រពន្ធ ក្នុង ការមាន អារម្មណ៍ ថា មាន ការ ការពារ ពី ប្តី របស់ ពួកគេ ។
កសិករទីពីរបានឆ្លើយយ៉ាង ចង្អុលថា " បាទ ខ្ញុំត្រូវយក ចិត្តទុកដាក់ជាមុនសិន !"
ការរស់ ឡើងវិញ នៃ មនុស្ស ស្លាប់ : សាកសព របស់ មនុស្ស សុចរិត
“ ប្រជាជន មកពី បណ្តា ប្រទេស អាហ្វ្រិក និង មជ្ឈិមបូព៌ា ក៏ ទិញ ផលិតផល របស់ យើង ដែរ ។
តើ មាន ជម្រើស សម្រាប់ ទិដ្ឋាការ ទេសចរណ៍ ទេ ?
ជាញឹកញយរឿងល្អច្រើនពេកមិនធ្វើឱ្យវាប្រសើរជាងមុនទេ ។
តើ ប្រិយមិត្ត យល់ យ៉ាងណា ដែរ ចំពោះ ព្រះនាង នេះ ?
កុំ បង្ក គ្រោះថ្នាក់ ដល់ នរណា ម្នាក់ នៅក្រោម ឥទ្ធិពលរបស់ នរណា ម្នាក់ ។
សូម ទុក ពេល បី ថ្ងៃ ទៀត ដើម្បី សុវត្ថិភាព ។
ចាំ ថា រាង ពេជ្រ ទាំងអស់ ។
គ្រូបានឲ្យគាត់សួរសំណួរដល់ថ្នាក់ ។
អ្វី ដែល អ្នក មិន ត្រូវ ភ្លេច គឺ៖ កុំ រក្សាទុក ឯកសារ ដែល បាន សង្គ្រោះ នៅលើ កន្លែង ដដែល ដែល អ្នក បាត់ ពួក វា ក្នុង ករណី ដែល អ្នក សរសេរ ជាន់ ពីលើ ពួកគេ ។
ប៉ុន្តែ បញ្ហា ប្រឈម គឺ របៀប ដែល អ្នក ចាប់ផ្តើម ធ្វើ វា ។
កុំ ភ័យខ្លាច ឬបាក់ទឹក ចិត្តដោយព្រោះស្ដេចស្រុកអាស្ស៊ី រី ឬកងទ័ពដ៏ខ្លាំងក្លា របស់ទ្រង់ឡើយ ដ្បិតមានអំណាចធំជាងនៅខាងយើងហើយ !» ។
ការធ្វើតេស្ត មុន ; មើល របាយការណ៍ ។
យើង ផ្តល់ ពេលវេលា ឱ្យ ពួកគេ ច្រើន ប៉ុន្តែ យើង ត្រូវ កាត់ផ្តាច់ ។
ខ្ញុំធានាថាខ្ញុំមិនខ្លាចស្លាប់។
បើចិនដើរតាមវាជាអព្ភូតហេតុ ។
មនុស្ស ភាគ ច្រើន នឹង និយាយ ថា៖ គ្មាន អ្វី ទេ ។
យើងពិតជាស្រឡាញ់គេ ហើយគេក៏ស្រឡាញ់យើង ។
ឥឡូវនេះ អ្នក ស្ថិត នៅក្នុង ការប្រយុទ្ធ នៃ ជីវិត របស់ អ្នក ។
អាហ្វហ្គានីស្ថាន មិន បាន ទៅ ណា ទេ ។
ប៉ា បាន ជ្រើសរើស មិន និយាយ អ្វី ទាំងអស់ ។
អាច ទទួលបាន មួយ ទៀត នៅពេល អនាគត ។
ឬថាវានៅកាត់ពីផ្សារដោះ ដូរទំនិញ ( ចម្លែកអី !) ។
សូមឲ្យរាជាណាចក្រទ្រង់បាន មក ។
ស្ត្រី ភាគ ច្រើន ចាប់ផ្តើម នៅ អាយុ ប្រហែល សែសិប ប្រាំ ។
ដូច្នេះមនុស្សជាច្រើនមានការ សប្បាយ ចិត្ត ។
ពួកគេនឹងមិនចុះចាញ់ឡើយ ហើយមានច្រើនពេកក្នុងចំណោមពួកគេដែលត្រូវបំផ្លាញចោល ។
ពួកគេបាននិយាយថា យើងពិតជាមិនមានទេ ។
អង់គ្លេសកំពុងដុតភ្លើងក្រោមសហភាពអឺរ៉ុបដោយ ...
សក់ ស្កូវ គឺជា បញ្ហា ដែល មនុស្ស ជាច្រើន ប្រឈមមុខ ។
នេះអាច សន្និដ្ឋានបានថាមានប្រហែលប្រាំនាក់ដែលកើតមក ។
យើង មិន ចូលនិវត្តន៍ ពី ការធ្វើជា កូន របស់ ព្រះទេ ។
ត្រូវបានបន្តការ ប្រឆាំងនឹងការ លួច ហើយបន្ទាប់ពីការ ថ្កោលទោសពួកគេបានបណ្តេញពួកគេដោយ ភាពព្រងើយ ក ន្តើយ។
ការស្តីបន្ទោស លើ មីង និង វិធី ចិញ្ចឹម កូន
" ខ្ញុំ មាន មិត្ត ប្រុស " កំពុង ប្រើ ភាព មិន ស្មោះត្រង់ បន្តិច ដើម្បី បន្ធូរបន្ថយ ស្ថានភាព លំបាក ។
ប៉ុន្តែគ្មានអ្វីទាំងនេះសម្រាប់ស្ត្រីទេ ។
សម្រាប់ ស្នេហា គឺ ខ្លាំង ជាង
យុត្តិធម៌ គឺជា ការពិត ។
ចំណាំ៖ ចិត្ត នឹង ប្រាប់ អ្នក ជានិច្ច ថា អ្នក បាន ធ្វើ មុនពេល អ្នក ហើយ ។
ហើយ ក្មេងប្រុស រង ទុក្ខ យ៉ាង ខ្លាំង ។
ឥឡូវនេះបានបាត់អស់ហើយ ។
នេះជាការ កែ លម្អដ៏ធំមួយ ប៉ុន្តែយើងអាចធ្វើបានល្អជាងនេះ ។
ដូច្នេះ ដូច ដែល វា គឺ សម្រាប់ ការបញ្ជាទិញ ដំបូង
ដើម្បីមានសុវត្ថិភាព ពួកគេនឹងចង់ដាស់តឿនអ្នកដែលនៅជុំវិញខ្លួនឱ្យមានការ ប្រុងប្រយ័ត្នពេលមានភ្លើងឆេះ ។
យើងក៏ពឹងលើព្រះអម្ចាស់ដែរ ពេលយើងប្រឈមមុខនឹងការតស៊ូក្នុងជីវិត ។
អ្នក រក្សា ភាពក្លាហាន របស់ អ្នក !
ការខះជាតិ ទឹក៖ មនុស្ស ជាច្រើន មិន ទទួលបាន ទឹក គ្រប់គ្រាន់ ជារៀងរាល់ ថ្ងៃ ។
ខ្ញុំមិនបានដឹងថាគាត់គឺជាការ គួរឱ្យខ្លាច។
ដែលគេធ្លាប់ចូលចិត្តធ្វើព្រោះខ្មាសមុខមាត់ ។
ប៉ុន្តែពេលអ្នកចាស់ទៅ អ្នកនឹងលាតដៃចេញ ហើយអ្នកផ្សេងនឹងយកក្រវាត់ជុំវិញខ្លួន ហើយដឹកអ្នកទៅកន្លែងដែលអ្នកមិនចង់ទៅ » ។
មនុស្ស ចាស់ ធំ ឡើង ដោយ គ្មាន បច្ចេកវិទ្យា ។
ឧទាហរណ៍៖ " ការពិតដែលគេអះអាងនេះជាការពិតចំពោះអ្នកណា ?
ខ្ញុំមិនចង់និយាយច្រើនទេ » ។
នៅក្នុង ទិដ្ឋភាព ច្បាស់ ហើយ កុំ ប៉ះ ពេល វេលា ។
18 ហើយអស់អ្នកដែលបានឮក៏ភ្ញាក់ផ្អើលនឹងពាក្យដែលពួកគង្វាលនិយាយ ។
ចងចាំ ពាក្យ ដែល អ្នកប្រើ និង ភាសា កាយវិការ របស់ អ្នក ។
ទោះបីជាយ៉ាង ណាក៏ដោយ ខ្ញុំចង់ស្នាក់នៅ » ។
សម្រាប់ រឿង នេះ គាត់ បាន សម្លាប់ មនុស្ស ពីរ នាក់ និង សេះ ពីរ ។
ដូច្នេះវាជាពេលវេលាដ៏លំបាកមួយដែលជនជាតិរុស្ស៊ីមាន ។
នោះ មិន ធ្លាប់ មាន ពីមុន មក វិធី ដ៏ លំបាក បំផុត ក្នុង ការធ្វើ វិធីសាស្រ្ត នេះ ។
គាត់ ប្រហែលជា មិន ដឹង ថា ស្នេហាជា អ្វី ទេ ។
នោះ គឺជា កូនប្រុស របស់ នរណា ម្នាក់ បង្ហាញ ពី ការគោរព ខ្លះ ។
ផឹក វា ក្នុង រយៈពេល ប្រាំពីរ ទៅដប់ ឆ្នាំ ខាងមុខ ។
គាត់ បាន និយាយ អំពី ការស្តារ ឡើងវិញ ។
របៀប ស្វែងរក អាយុ នៃ ដែន
អ្វី ៗទាំងអស់ស្ថិតក្នុងកណ្តាប់ដៃយោធា » ។
ថាទុក្ខដែលកើតមកលើវានឹងត្រូវរងទុក្ខដោយបុគ្គល
កាលពីឆ្នាំមុនក្រីក្រណាស់ គឺ ភាព ក្រីក្រ .. .
17 ដ្បិតនគរនៃព្រះ មិនមែនជាបញ្ហានៃការស៊ីផឹកទេ ប៉ុន្តែ មកពីសេចក្តី សុចរិត សន្តិភាព និងសេចក្តី អំណរក្នុងព្រះវិញ្ញាណបរិសុទ្ធ
សង្ឃឹម ថា ពួកគេ នឹង ចូល ស្តុក វិញ
ថ្ងៃ មួយ មាន អំណាច កំណត់
នៃកុលសម្ព័ន្ធយូដា
សកម្មភាព និង ករណី ដែល បាន កំណត់ ឱ្យ អ្នក និង តំបន់ ជួរ ។
ដូច្នេះ គាត់ងាយ រងគ្រោះច្រើនជាងការ ធ្វើ បាប ។
