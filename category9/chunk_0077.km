រាល់ថ្ងៃខ្ញុំព្យាយាមប្ដូរវា ព្រោះខ្ញុំជានរណា ខ្ញុំតែងមាន ។
បើអ្នកស្គាល់ម្នាក់ដែលគាត់មិនបានចុះ បញ្ជីទុកឱ្យគាត់ដឹង ។
ក្នុងការ ការពាររបស់ខ្ញុំ ក្មេងស្រីនោះមិនមានសក់ទេ ។
ម្ដាយរបស់ក្មេងស្រីនេះបានកើតទុក្ខដោយការ ភ័យខ្លាច ។
ពួកគេពិតជាកូនភ្នំខេត្តថ្មីមែន ។
នៅ ពេល ដែល អ្នក នៅតែ រង់ចាំ ក្នុង បញ្ជី ដូច្នេះ យើង ព្យាយាម ជម្រះ
គាត់នឹងត្រូវហៅថា " អ្នកដែលបានសរសេរទុក " ។
អ្នក អាច រៀន បាន ច្រើន ពី ជីវិត របស់ យ៉ូសែប ។
ជាបុត្ររបស់ព្រះបាទហេរ៉ូដ ដែលទ្រង់បានធ្វើគុត ។ ហើយ នេះ គឺជា ការញុះញង់ ដល់ គាត់
ឥឡូវនេះ ស្ត្រី វ័យ ក្មេង យើង នៅ ទីនេះ ដើម្បី ផ្តល់ យុត្តិធម៌ ។
នាង ត្រូវបាន ជំនួស ដោយ បុរស ម្នាក់ ដោយ ប្រាក់ខែ របស់ នាង ពីរ ដង ។
មាន រឿង ព្រេង ជាច្រើន ដែល ប្រាប់ អំពី ការបង្កើត ពិធី បុណ្យ នេះ ។
សមស្រប ក្នុង ស្ថានភាព ជាក់លាក់ មួយ ។
តើអ្នកចង់ចាកចេញពីគ្រួសារអ្នកជាមួយនឹង បន្ទុកក្នុងការ ដោះស្រាយបញ្ហានេះទេ ?
ថែរក្សាកូនផង ព្រោះវាមានតម្លៃណាស់ ។
អ្នក ប្រហែលជា ពិតជា មិន ស្រួល ។
នៅស្រុកអេស៊ីប ពេលដែលគាត់បានបំផ្លាញជន ជាតិអេស៊ីប ហើយដោះលែងប្រជាជនរបស់យើង » ។
ប្រទេសមួយដែលខ្ញុំមិនបានទៅលេង » ។
ថា អ្នក នឹង ត្រូវ ដាក់ទណ្ឌកម្ម ។
ពីអ្វីដែលខ្ញុំបានជួបផ្ទាល់ ខ្ញុំមិនគិតថាគាត់ស្ថិតនៅក្នុងតុលាការកំពូលទេ » ។
រឹង ហើយនឹងបញ្ចេញ ភាព កខ្វក់ និងទឹកដល់កម្រិត ណាមួយ ។
តើវាមិនមានវិមាត្រ សារភាពចំពោះជម្លោះទេឬ ?
គ្រាន់តែ សួរ មួយ ក្នុង ចំណោម ។
សាកល្បងពួកគេហើយហុចដៃឱ្យពួកគេ។
នាំ មនុស្ស ធ្វើដំណើរ ។
ព្រះច័ន្ទ និង ទន្សាយ នៅលើ ភ្លៅ របស់ នាង
« ចូរខំ ប្រឹងឲ្យអស់ពី ចិត្តដើម្បីរស់នៅដោយសន្តិវិធីជាមួយនឹងមនុស្សទាំងអស់ ហើយបានបរិសុទ្ធ បើគ្មាន ភាពបរិសុទ្ធ គ្មានអ្នក ណានឹងឃើញព្រះ យេហូវ៉ាឡើយ » ។
ប៉ុន្តែ អាល័យ ជីវិត ខ្ញុំ ក៏ ដូចគ្នា ដែរ ។
ដើរត្រូវថ្លៃថ្នូរ ។
« យើងញ៉ាំខ្លះលក់ខ្លះដើម្បីទិញរបស់ផ្សេង » ។
តើគាត់និយាយទៅ កាន់នាងថា៖ « អ្នកមានសម្បុរស ពីខាងក្រៅ ប៉ុន្តែខាងក្នុងពេញទៅដោយ ភាពពុក រលួយឬទេ ?
ខ្ញុំ ឮថាគាត់ចូលនិវត្តន៍ ឬជិតដល់ហើយ ។
វា មិន ងាយស្រួល ទេ ប៉ុន្តែ ឥឡូវនេះ អ្នក នៅជិត កំពូល ។
ទុក អ្នក ជ្រើសរើស ឱ្យ ជាប់ពាក់ព័ន្ធ រហូតដល់ ចុងបញ្ចប់ នៃ ដំណើរការ ។
សាច់ញាតិរបស់ស្ត្រីមួយចំនួនត្រូវបានគេនិយាយថាកំពុងជាប់ពន្ធនាគារ ។
យ៉ាង ណាក៏ដោយ មហា បូជាចារ្យអាណាណា ស បាន បញ្ជាអ្នកដែលឈរក្បែរប៉ូលវាយគាត់ចំ មាត់ ។
នៅថ្ងៃបុណ្យទី៥០ ពេត្រុសបានក្រោកឈរជាមួយនឹងពួកដប់ មួយ ហើយថ្លែងទៅ កាន់ហ្វូងមនុស្សនៅក្នុង ក ...
ផ្ទះនឹងមាន ភាព រីក រាយ ហើយក្មេងៗត្រូវមានអាកប្បកិរិយាល្អ ។
មនុស្ស បី នាក់ រស់ នៅ ជាមួយគ្នា ប្រៀប ដូចជា ភូមិ មួយ ។
យើង មាន លក្ខណៈ គ្រប់គ្រាន់ ដើម្បី គ្រប់គ្រង នៅ ពេល ដែល យើង អភិវឌ្ឍ ភាព ដូច ព្រះ ឬ គុណលក្ខណៈ នៃ ភាពត្រឹមត្រូវ ដោយ ធ្វើ អ្វី ដែល ត្រឹមត្រូវ ។
ចំណុច ទាំង បួន ត្រូវតែ ចងចាំ នៅ ទីនេះ ។
នៅក្នុង តំបន់ ជាច្រើន នៅ ជុំវិញ ប្រទេស ការផ្លាស់ប្តូរ បាន កើតឡើង រួចហើយ ។
ភាព ជា អ្នកដឹកនាំ ក្នុង យុគសម័យ ជីវិត ខ្មៅ
ខ្ញុំ គ្រាន់តែ ព្រងើយ កន្តើយ ចំពោះ អ្នក ដែល មិន ទទួលបាន អ្នក !
តើអ្វីដែលយើងដឹងថាយើងនឹងទទួលបានការ ចង់បាន ?
ដើម្បីជៀស វាងកុំឲ្យមានរឿងនេះកើតឡើងទៀត ។
អគារ ណាមួយ នៅក្នុង ទីក្រុង ឬ ទីក្រុង ណាមួយ សម្រាប់ ស្ថេរភាព សម្រាប់
ការ ចាប់ផ្តើ ម ដ៏ខក ចិត្តចំពោះការ មើលរឿងភ័យរន្ធត់ក្នុងឆ្នាំនេះ
បន្ទោសវាលើវាសនាដ៏អាក្រក់ ដែលនាងបង្កើតតាំងពីដំបូង
ក្នុងនាមជាអគ្គ មេ បញ្ជាការ ប្រធានគួរតែទទួលខុសត្រូវទាំង ស្រុង ។
ក្នុងសំឡេងខកចិត្តខ្លាំង ខ្ញុំត្រូវបានគេប្រាប់ ជារៀងរាល់ ថ្ងៃថាពួកគេមិន មានអ្វីទាំងអស់។
គាត់បាននិយាយថា អ្នកមានអនុស្សាវរីយ៍ដែលស្រលាញ់យើង ហើយអ្នកចង់ឃើញយើងឲ្យបានច្រើនតាមដែលយើងចង់ឃើញអ្នក ។
តើ មាន អ្វី កើតឡើង , បណ្ឌិត ? - ព្រឹត្តិការណ៍ ម្តង ក្នុង មួយ ជីវិត នឹង ត្រូវបាន សង្កត់ធ្ងន់
ខណៈដែលសត្វ កន្លាត រត់ទៅឆ្ងាយ ពួកគេទាំងពីរបានទាញកន្សែងដៃចេញ ។
ខ្ញុំ នៅ ទីនេះ ដើម្បី លើកទឹកចិត្ត អ្នក ឱ្យ សួរ ខ្លួន ឯង នូវ សំណួរ ផ្សេង ៗ ។
ការរំលោភ លើ សេរីភាព សារព័ត៌មាន ក្នុង ខែធ្នូ ឆ្នាំ ២០១១
យ៉ាង ណាក៏ដោយ ព្រះ បានប្រោសគាត់ឲ្យ រស់ឡើងវិញ ។
អ្នកដែលមាន ចិត្តរាបទាបនឹងបានរង្វាន់ ហើយអ្នកដែលមាន ចិត្តក្រអឺត ក្រទមនឹងត្រូវបន្ទាបចុះ ។ ការ បន្ទាប ខ្លួន ជា គុណធម៌ មោទនភាព ជា អំពើ បាប ។
ព្យាយាមដាក់ ចង្កឹះ និងដើម្បីសាងសង់ កង់ ដើម្បីឲ្យពួកគេអាចសម្របតាមភាពងាយស្រួល ។
ឥឡូវនេះ ខ្ញុំ ជាអ្នក បម្រើ » ។
ពី ប្រអប់ ដែល គាត់ បាន យក វា ជា សំបុត្រ ដែល គាត់ បាន សរសេរ កាលពី ប៉ុន្មាន ឆ្នាំ មុន ។
ព្រះរាជា ទ្រង់ មាន បន្ទូល អំពី មុខវិជ្ជា ផ្សេង ៗ ។
មិនមែនអំពីសមត្ថភាពទេ - សិស្សមិនប្រពៃណីត្រូវការ ការ គាំទ្រដើម្បីជោគជ័យ !
ពេត្រុសបានដកស្រង់ទំនាយមួយអំពីប៉ុន្មានថ្ងៃកន្លង មក ហើយអនុវត្តវាទៅនឹងពេលវេលារបស់គាត់ ( កិច្ចការ ២,១៦: ១៧) ដូចជាអ្នក និពន្ធសំបុត្រទៅ កាន់ហេព្រើរ ( ហេព្រើរ ១,២) ។
ប្រភេទ សត្វ ខ្លះ ជាពិសេស សម្រាប់ ប្រាំមួយ បន្ទាប់ គឺ ភាពក្លាហាន ។
ការគិត និង បុរស នៅតែ បន្ត រំខាន ។
យើងចង់បានសន្តិភាព យើងមិនចង់បានសង្គ្រាមទេ » ។
ទូរស័ព្ទ មក ខ្ញុំ ហើយ និយាយ ថា វា រួចរាល់ ហើយ ។
គ្រប់គ្រាន់ នៃ ការស្រែក - ពី គ្លីនតុន ទាំង ពីរ ។
