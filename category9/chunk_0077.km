18 កុំឲ្យអ្នក ណាបញ្ឆោតខ្លួនឯងឡើយ ប្រសិនបើអ្នក ណាម្នាក់ក្នុងចំណោមអ្នក រាល់គ្នាហាក់ដូចជាមានប្រាជ្ញាក្នុងលោកនេះ ចូរឲ្យអ្នកនោះធ្វើជាមនុស្សល្ងង់ ដើម្បីឲ្យគេមានប្រាជ្ញា ។
ប៉ា និយាយដោយមោទនភាព ថា " នេះជាកូនរបស់ខ្ញុំ !"
ក្នុងនោះមាន សារថា “ អូនអាយុ ១ ឆ្នាំហើយ !
« បុណ្យជ្រមុជទឹករបស់លោក យ៉ូហាន តើមកពីស្ថានសួគ៌ឬ ជាមនុស្ស ?
កិច្ចការ 24:15 " ហើយខ្ញុំក៏មានសេចក្ដីសង្ឃឹមលើព្រះ ដូចមនុស្សទាំងនេះដែរ ថានឹងមានជីវិតរស់ឡើងវិញទាំងមនុស្សសុចរិត និងមនុស្សទុច្ចរិត » ។
និង ទឹក សម្រាប់ ពេល នៃ គ្រោះ រាំងស្ងួត
ការ នៅពីមុខកាមេរ៉ាអាចធ្វើឲ្យភ័យ !
ព្រះជាម្ចាស់ បាន ប្រោស ព្រះអង្គ អោយ មាន ព្រះជន្ម រស់ ឡើងវិញ នៅ ថ្ងៃទី បី ហើយ បង្ហាញ ព្រះអង្គ ដោយ ចំហ មិន មែន ដល់ មនុស្ស ទាំងអស់ នោះ ទេ គឺ បង្ហាញ ដល់ សាក្សី ដែល បាន ជ្រើសរើស នៅ ចំពោះ ព្រះភ័ក្ដ្រ ព្រះជាម្ចាស់ សូម្បីតែ ចំពោះ ពួកយើង ដែល បាន បរិភោគ និង ផឹក ជាមួយ ព្រះអង្គ បន្ទាប់ពី ព្រះអង្គ បាន រស់ ឡើងវិញ ។
ដោយ សន្លឹក ឆ្នោត របស់ អ្នក ដែល ទើប បង្កើត សិទ្ធិ ថ្មី ។
ប្រេង និង ត្រា ទឹក ។
ហើយសម្លឹងមើលវា ហើយព្យាយាមរៀនពីអារម្មណ៍របស់វា ។
គាត់បានផ្តល់ បទ ចម្រៀងថ្មីមួយដល់ខ្ញុំ
ប្រសិនបើ អ្នក ពិតជា ពូកែ អ្វី ដែល អ្នក ធ្វើ នោះ មនុស្ស នឹង ជួល អ្នក សម្រាប់ អ្វី ដែល អ្នក មាន តម្លៃ ទោះបីជា ការពិត អ្នក ផ្សេង ទៀត នឹង ធ្វើ វា ដោយ មិន គិត ថ្លៃ ក៏ដោយ ។
ប្រហែលជា ប្រភេទ ប៉ូលីកាបូណាត ។
យើង មិន អាច សូម្បីតែ គាំទ្រ ចំណែក តូច មួយ របស់ យើង នៃ ពិភពលោក ។
ទន្ទឹមនឹងនោះកងពលលេខ ២០បានបើក
នៅ តែបែរមុខចេញពីខ្ញុំ វាហាក់ដូចជាងាយស្រួលក្នុងការ និយាយ ។
បុរសដៃញាប់ញ័រម្នាក់នៅក្នុងសាលា ប្រជុំ ។
ដូច្នេះ ពួកគេ ប្រាកដជា ស្ថិត ក្នុង ទីតាំង មួយ ដើម្បី ទទួលបាន ប្រាក់ ក្រោយ ។
« អស់អ្នកដែលមានសុខភាពល្អមិនត្រូវការ គ្រូពេទ្យទេ គឺមាន តែអ្នកដែលឈឺ » ម៉ាថា យ ៩: ១២ ។
គូ ស្វាមី ភរិយា វ័យ ក្មេង ត្រូវការសង្គ្រោះ មុខ ។
មិនមែនអ្នកដែលប្រព្រឹត្តទេ គឺ ជាអ្នកដែលរងទុក្ខ ។
ក្តីសង្ឃឹម គឺ ខ្លាំង ជាង ការស្អប់ - ចំណុច ទាំងអស់ នៃ ទិដ្ឋភាព
២២ អ្នក ទាំងនេះជាកូនរបស់នាង រ៉ា ជែល ដែលកើតពីយ៉ាកុប សរុបទាំងអស់មាន១៤ នាក់ ។
ហើយបន្ទាប់មកយើងបានទៅផ្ទះដោយមិនមានអ្វីឡើងនៅលើជញ្ជាំង។
ខ្ញុំបានចាត់អ្នកទៅស្រុកអេស៊ីប » ។
ខ្ញុំ នឹង ផ្តល់ឱ្យ អ្នក នូវ សារ ឡើងវិញ
ប្អូន ស្រី របស់ មិត្ត ប្រុស ខ្ញុំ នឹង មក ជួប យើង នៅ ថ្ងៃ បន្ទាប់ ។
ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ហើយ គ្មាន ថ្ងៃ កំណត់ ច្បាស់លាស់ រវាង ពួកគេ ទេ ។
ប៉ុន្តែចំពោះអព្ភូតហេតុវិញ ខ្ញុំមិនជឿលើវាខ្លាំងពេកទេ ។
លោកយេស៊ូមាន ប្រសាសន៍ថា៖ « គឺជាវិញ្ញាណដែលផ្ដល់ជីវិត ។
គេនឹងស្វែង យល់ពីវាយ៉ាងលំបាកនៅថ្ងៃនេះ » ។
ថ្វាយបង្គំ រូប ព្រះ។
«វាជាជម្រើសរបស់ពួកគេ បើពួកគេចង់ តវ៉ាដោយសន្តិវិធី ។
បើអ្នក ស្រឡាញ់នរណាម្នាក់ អ្នកនឹងមិនធ្វើឱ្យគាត់ ខុសឡើយ ។
វាត្រូវបានគេសាង សង់នៅក្នុងតំបន់នៃ 60 ។
យើង នឹង ថែរក្សា កន្សែង ។
« អ្វីដែលយើងបានកត់សម្គាល់ឃើញយ៉ាងច្បាស់នោះគឺវា កាន់ តែក្តៅ ។
ព្រះទ្រង់ត្រាស់ហៅមនុស្សម្នាក់ ៗពីមួយទៅមួយ ។
ខ្ញុំ នឹង នាំ អ្នកវិទ្យាសាស្ត្រ មក ។
យ៉ូហានចាកចេញពីពួកគេ ហើយត្រឡប់ទៅក្រុងយេរូសាឡិមវិញ ។
ដូច្នេះគាត់អាចធ្វើបែបនេះម្តងរៀងរាល់ ១០ នាទីម្តង ហើយល្អ។
ទុក្ខ សោកប្រភេទនេះគឺជាជីវិតដែលគ្មានការ ដោះលែង ។
១៧ ព្រះគ្រីស្ទមិនបានចាត់ខ្ញុំឲ្យធ្វើបុណ្យជ្រមុជទឹកទេ ប៉ុន្តែដើម្បីផ្សាយដំណឹងល្អវិញ ។
ប៉ុន្តែ ទ្រង់បានជ្រើស រើសដាក់ទ្រង់នៅក្រោមពួកគេ ដោយព្រោះទ្រង់បានរើសយក ចិត្តនៃអ្នក បម្រើ ។
តើអ្នកមានយោបល់សម្រាប់ការ ប្រកាសប្លក់ទេ ?
មុខ ម្ហូប ថ្មី រួម មាន អាំង នៅ ថ្ងៃអាទិត្យ ។
សំឡេង ញ័ររបស់វារំកិលទៅនឹង រលក
គិតថាបើមានសង្គ្រាម
“ ឥឡូវនេះឯងមើលទៅប្រាកដហើយ ។
អូ សំឡេង នៃ ភាសា កូដ ប្រកួតប្រជែង ពីរ នៅ ពេលព្រឹក ។
ជា ដំបូង ការទប់ស្កាត់ ការចូល ប្រើ រូបភាព អាសអាភាស ។
ខ្ញុំ មិន ចង់ ធ្វើឱ្យ នាង ខកចិត្ត ទេ ។ ប្រពន្ធ ចាស់ទុំ រន្ធ គូថ
មនុស្ស ម្នាក់ ឆ្ងល់ ថា តើ ពួកគេ គិត យ៉ាងណា ចំពោះ ប្រភព បើកចំហ ។
ក្រុមនេះមានការ រីក ចម្រើនដោយការ លេងសើចរបស់ពួកគេតាំងពីដើម មក
ពួកគេកំពុងដាក់ខ្លួនក្នុងគ្រោះថ្នាក់លើរឿងនេះ ។
« ថ្ងៃក្រោយនឹងមានការ ប្រកាស ។
ខ្ញុំមានសាច់ចៀម និង ថម យុំហ្គូង ។
អូតូ ខ្លួន ឯង ។
គាត់ គោះអ្នក បម្រើម្នាក់លើស្មា ។
ចេញ ពី គំនិត របស់ ខ្ញុំ៖ ស្ត្រី សម្រាល កូន នៅ ហាសិប ប្រាំបី
លេខ ទូរស័ព្ទ មិន ដូចគ្នា ទេ ។
ប៉ុន្តែសម្រាប់ភាគ ច្រើននៃអ្វីដែលខ្ញុំសរសេរថា « ខ្ញុំគ្មាន បញ្ជាពីព្រះអម្ចាស់ទេ ប៉ុន្តែខ្ញុំផ្ដល់យោបល់ថាជាអ្នកដែលគួរឲ្យទុក ចិត្តដោយសេចក្ដី មេត្តា ករុណារបស់ព្រះអម្ចាស់ » ។
បន្ទាប់មកគួរតែដកស្ត្រីចេញ។
ទិដ្ឋភាព សង្គម នៃ អក្ខរកម្ម ឌីជីថល
មាន ប្រយោជន៍ សម្រាប់ អ្នក ទាំងអស់ គ្នា ។
គាត់រង់ចាំឲ្យវាស្ងប់ ដោយធ្វើពុតជាបំពាន ។
ពេលមកដល់ទីនេះដំបូង ខ្ញុំពិតជាមិនដឹងថាខ្លួនកំពុងធ្វើអ្វីទេ ។
ព្រះ បានចាត់ព្រះរាជបុត្រារបស់ព្រះអង្គមក ហើយបានបដិសេធដោយមនុស្ស
ខ្ញុំ នឹង មើលថែ អ្នក ជាមុន សិន ហើយ ត្រូវ ប្រាកដ ថា អ្នក ចូលចិត្ត ឡាច
ដោយ សារអ្នក ណាដែលជឿលើព្រះ ដែលបានប្រោសគាត់ឡើង ...
ស្រមោល សម្លៀកបំពាក់ ងងឹត មកដល់ ហើយ !
ការិយាល័យ បច្ចេកវិទ្យា ទំនើប ។
នៅ ឆ្នាំ ១៩៨២ គាត់ បាន ចាប់ផ្តើម តែងតាំង គ្រូ ជំនួយ ដើម្បី ជួយ គាត់ បំពេញ តម្រូវការ ដែល កំពុង កើនឡើង សម្រាប់ វគ្គ សិក្សា វិបស្សនា ។
នៅ ពេល ដែល អ្នក ជឿ ថា មាន ការគំរាមកំហែង ដល់ អាយុជីវិត ឬ ដើម្បី ការពារ ការរងរបួស ធ្ងន់ធ្ងរ
" នោះជាការ យល់ថាគាត់ប្រហែលជាល្បួងបន្តិចហើយ " ។
ដំណោះស្រាយ រដ្ឋ តែ មួយ គឺជា មធ្យោបាយ តែ មួយ គត់ ឆ្ពោះទៅ មុខ សម្រាប់ អ៊ីស្រាអែល និង ប៉ាឡេ ស្ទីន
កុំ ចាក់ វ៉ាក់សាំង ជាមួយ វ៉ាក់សាំង បន្ត ផ្ទាល់ ។
ដើមឈើ ណាដែលមិនផ្ដល់ផ្លែល្អនឹងត្រូវប្រមូលយកទៅដុតក្នុងភ្លើង ។
ម្ហូប ជាមួយ ពិភពលោក និង ការព្យាបាល វេជ្ជសាស្រ្ត ជា លើក ដំបូង ។
តើមិនមែនដើម្បីដាក់លើជើង ចង្កៀងទេឬ ?
លោក សម រង្ស៊ី ក្នុង កិច្ច ប្រជុំសមាជិក សភា សេរីនិយមមកពីប្រទេស ជាច្រើនក្នុងសន្និសីទនៃសហភាពអន្តរ សភា (IPU) នៅទីក្រុងបែល ក្រាដ ប្រទេសស៊ែប៊ី កាលពីថ្ងៃទី១៤ ខែ តុលា ឆ្នាំ ២០១៩ ។
នៅក្នុង សេចក្តីស្លាប់ ដែល អ្នក បាន ពន្យល់ ។
ខ្ញុំមិនដឹងថាមានរឿងអ្វីទេ ខណៈគាត់ បក់មួកសុវត្ថិភាព ដល់ដី ។
មនុស្ស ជាច្រើន ចាកចេញ ពី ផ្ទះ របស់ ពួកគេ អស់ រយៈពេល ជាច្រើន ឆ្នាំ ដោយ សង្ឃឹម ថា នឹង មាន អ្វី ផ្លាស់ប្តូរ ។
មានអ្នកអភិវឌ្ឍន៍ ក្រីក្រជាងខ្ញុំទៅទៀត ។
ពេលដែលអាចយល់បាន ' នោះគឺរូបសំណាកនេះត្រូវបានគេយល់ភ្លាមថាជាការ វាយ ប្រហារនៅលើ
« បើគេចង់កាត់ទោសខ្ញុំ គេអាចធ្វើបាន » ។
នៅ ទីបំផុតមាន សង្ឃម្នាក់ដើរតាមផ្លូវដដែល ប៉ុន្តែពេលឃើញបុរសនោះក៏ឆ្លងទៅត្រើយម្ខាង ។
ពេលនោះហើយដែលគាត់នឹកឃើញពីការ បំផ្ទុះដែលបានឆក់យកភ្នែកគាត់ ។
ការងារ របស់ អ្នកបកប្រែ គឺ បកប្រែ អ្វី ដែល សរសេរ ។
