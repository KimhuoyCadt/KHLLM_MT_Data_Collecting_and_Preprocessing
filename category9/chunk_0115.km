( ភ្នំពេញ ) ៖ ក្នុង ឱកាស ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ រយៈពេល ៤ ថ្ងៃ នេះ មាន ភ្ញៀវ ទេសចរ និង ប្រជាពលរដ្ឋ មក ទស្សនា និង លេង កម្សាន្ត នៅ សង្ក្រាន្ត វត្តភ្នំ ប្រមាណ ១លាន
អ្នកនាំពាក្យ រដ្ឋបាល រាជធានី ភ្នំពេញ លោក ម៉េត មាស ភក្ដី បាន ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០២៤ នេះ ថា ក្នុង ឱកាស ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ រោង ឆស័ក ព .ស ២៥៦៨ គ.ស ២០២៤ រយៈពេល ៤ ថ្ងៃ នេះ មាន ភ្ញៀវ ទេសចរ ជាតិ អន្តរជាតិ មក ទស្សនា និង លេង កម្សាន្ត នៅ សង្ក្រាន្ត វត្តភ្នំ ប្រមាណ ១លាន ៣សែន នាក់ ។
ក្នុង នោះ សម្រាប់ ថ្ងៃទី១ ត្រូវនឹង ថ្ងៃទី ១៣ ខែមេសា ភ្ញៀវ ទេសចរ ជាតិ អន្តរជាតិ ចូលរួម ចូល ឆ្នាំ ខ្មែរ ប្រពៃណី ជាតិ ជាង ២៣ម៉ឺន នាក់ ថ្ងៃទី២ ប្រមាណ ២៥ ម៉ឺន នាក់ ថ្ងៃទី ៣ ប្រមាណ ៣០ម៉ឺន នាក់ និង ថ្ងៃទី ១៦ មេសា ដែល ជា ថ្ងៃ ចុងក្រោយ គឺ ចំនួន ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ បាន កើនឡើង រហូតដល់ ចំនួន ៥២ ម៉ឺន នាក់ ។ បើ សរុប ទាំង៤ ថ្ងៃ នៃ ពិធី ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ នេះ គឺ មាន ភ្ញៀវ ទេសចរ និង ប្រជាពលរដ្ឋ មក ទស្សនា និង លេង កម្សាន្ត នៅ សង្ក្រាន្ត វត្តភ្នំ ប្រមាណ ១លាន ៣សែន នាក់ ។
ប្រឈមមុខ នឹង គ្រោះ ទឹក ជំនន់ នេះ អាជ្ញាធរ ក្នុង ប្រទេស អេមីរ៉ាត អារ៉ាប់ រួម បាន បិទ សាលារៀន ជា បណ្ដោះអាសន្ន នៅ ទូទាំង ប្រទេស ហើយ អាចនឹង បន្ត បិទ ទ្វារ នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ ខណៈ មាន ការព្យាករ ថា ព្យុះភ្លៀង អាចនឹង កើតមាន ជាថ្មី ។
គួរ បញ្ជាក់ ថា នៅក្នុង ប្រទេស អូម៉ង់ អាជ្ញាធរ បាន រកឃើញ សាកសព ក្មេងប្រុស ម្នាក់ កាលពី ថ្ងៃអង្គារ ទី ១៦ ខែមេសា ដែល នេះ ធ្វើឱ្យ ចំនួន អ្នកស្លាប់ ក្នុង គ្រោះ ទឹក ជំនន់ កើន ដល់ ១៨ នាក់ និង ២នាក់ បាត់ខ្លួន ៕ ខេត្ត កំពង់ចាម ទទួលបាន ភ្ញៀវ ទេសចរ ជាង ៥.៣លាន នាក់ រយៈពេល ៤ ថ្ងៃ នៃ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី
( ស្ទឹងត្រែង ) ៖ រយៈពេល ៤ ថ្ងៃ នៃ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ គឺ ចាប់ពី ថ្ងៃ ទី ១៣ ដល់ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២៤ ខេត្ត ស្ទឹងត្រែង ទទួលបាន ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ជាង ៣ម៉ឺន នាក់ ។
ក្នុង សភាព ដ៍ អធឹក អធម ក្រោម សំឡេង អើង កង បង្ហាញ ភាពសប្បាយរីករាយ នៅ ទីតាំង មហាសង្ក្រាន្ត នៅ បរិវេណ ចំណត រថយន្ត ជិត មាត់ ទន្លេ សាសាន ក្នុង ក្រុង ស្ទឹងត្រែង នៅ ថ្ងៃទី ១៦មេសា ឆ្នាំ ២០២៤ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត បាន ចាត់ទុក ថា សង្ក្រាន្ត ឆ្នាំ ថ្មី ឆ្នាំ ២០២៤ បាន ផ្តល់ ឱកាស សប្បាយរីករាយ យ៉ាង ក្រៃលែង ដល់ បងប្អូន ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ មកពី បណ្តា ខេត្ត ផ្សេង ៗ ជាច្រើន ទៀត បាន ចូលរួម លេង សប្បាយ ក្នុង កម្មវិធី បុណ្យ ចូល ឆ្នាំ ថ្មី នេះ ។
លោក អភិបាល ខេត្ត បាន ថ្លែង ថា នៅ ឆ្នាំ ២០២៥ អាជ្ញាធរ និង រៀបចំ ទីតាំង ឱ្យ បាន ធំទូលាយ ជាង នេះ ដើម្បី បង្កើន និង ផ្តល់ លទ្ធភាព ជូន ភ្ញៀវ ទេសចរ និង ប្រជាពលរដ្ឋ នាំគ្នា មក កម្សាន្ត សប្បាយ ឱ្យ បាន ច្រើន ជាង នេះ ព្រោះ សកម្មភាព នេះ បាន បង្ហាញ ឱ្យ ឃើញ ពី កត្តា សាមគ្គីភាព គ្នា ល្អ ហើសមត្ថកិច្ច ក៏ បាន ចូលរួម រៀបចំ សណ្តាប់ធ្នាប់ មាន សុវត្ថិភាព ល្អ ប្រសើរ ដែរ ។
លោក អ៊ុន ប៉ោសឿន ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត បាន គាត់ សំគាល់ ថា នៅ ឆ្នាំ នេះ ភ្ញៀវ ទេសចរ មាន ការទទួលខុសត្រូវ ខ្ពស់ ទាំង ភ្ញៀវ ក្រៅ ខេត្ត និង ក្នុង ខេត្ត ព្រោះ សង្កេតឃើញ ចំណុល្អ ៗ ច្រើន ដែល ពួកគាត់ បាន ចូលរួម អនុវត្ត ទាំង នៅ តាម ទីប្រជុំជន និង នៅ តាម រមណីយដ្ឋាន នានា ផងដែរ ។
លោក ប្រធាន មន្ទីរ បាន បន្ត ថា អនុវត្ត បាន ល្អ នេះ ដូចជា ផ្នែក អនាម័យ បរិស្ថាន ការគោរព ច្បាប់ ចរាចរណ៍ ហើយ បងប្អូន អាជីវករ លក់ដូរ មិន តម្លើង ថ្លៃ នេះ ជា ត្រីវិស័យ មួយ សម្រាប់ មន្ទីរ ជំនាញ យក ធ្វើជា បទពិសោធន៍ និង ធ្វើ ការផ្សព្វផ្សាយ ទៅ ឆ្នាំ ក្រោយ ៗ ទៀត ។
លោកស្រី ថន ថា វី អ្នកលក់ដូរ នៅជិត បរិវេណ កម្សាន្ត នេះ បាន បញ្ជាក់ ថា បច្ចុប្បន្ន ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ពេញលេញ មាន ភ្ញៀវ មក លេង មក កុះករ លក់ដូរ ទទួលបាន ប្រាក់ ចំណូល ច្រើន ធ្វើឱ្យ សប្បាយ ចិត្ត ។
លោកស្រី សំណូមពរ ទៅ អាជ្ញាធរ ពាក់ព័ន្ធ នៅ ឆ្នាំ ២០២៥ សូម រៀបចំ ឱ្យ មាន ភាពអធឹអធម ជាង នេះ ដើម្បី យើង បាន អភិរក្ស ប្រពៃណី វប្បធ៌ម យើង ផង ហើយ ប្រជាពលរដ្ឋ យើង សប្បាយរីករាយ ផង ។
សូម បញ្ជាក់ ថា ឆ្នាំ នេះ វត្តមាន ភ្ញៀវ ទេសចរ និង ប្រជាពលរដ្ឋ ជាង ៣ម៉ឺន នាក់ ក្នុង សម្លៀកបំពាក់ ចម្រុះ ពណ៌ បាន រាំ លេង កម្សាន្ត លាប ម្សៅ បាញ់ ទឹក បង្កើន ភាពត្រជាក់ បាន ទប់ទល់ ជាមួយ បរិមាណ កំដៅ អាកាសធាតុ ផង ដែល ជា សកម្មភាព បង្កើន ភាពសប្បាយរីករាយ យ៉ាង ក្រៃលែង ៕
សង្រ្កាន្ត បាត់ដំបង ទទួលបាន ភ្ញៀវ ទេចរ ជាង ១លាន ៧សែន នាក់ ចូលរួម លេង កម្សាន្ត ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី
ជា លទ្ធផល រដ្ឋបាល ខេត្ត បាត់ដំបង បាន សហការ ជា មយយ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត មន្ទីរ អង្គភាព និង រដ្ឋបាល ក្រុង ស្រុក ទូទាំង ខេត្ត រៀបចំ ព្រឹត្តិការណ៍ សង្ក្រាន្ត បាត់ដំបង ឆ្នាំ ២០២៤ មាន ភាពទាក់ទាញ ភ្ញៀវ ទេសចរ មក លេង កម្សាន្ត សប្បាយ ច្រើន ។
សម្រាប់ សង្ក្រាន្ត បាត់ដំបង បាន រៀបចំ ព្រឹត្តិការណ៍ ទាក់ទាញ សំខាន់ ៗ ដូច ជា៖ តំបន់ ត្រជាក់ចិត្ត តំបន់ រណប ត្រជាក់ចិត្ត ( តំបន់ ពាង ) តំបន់ សាសនា ( ពិធី ពូន ភ្នំ ខ្សាច់ ពិធី ថ្វាយ ទេវតា ឆ្នាំ ថ្មី ពិធី ស្រង់ ព្រះគន្ធ វារី ) ការសម្តែង សិល្បៈ ( របាំ ) ការសម្តែង សៀក ការស្តែង ល្ខោន ខោល ការប្រគុំតន្ត្រី ខ្នាត យក្ស ចំនួន ២ តន្រ្តី ស្រុក ស្រែ ពិព័រណ៌ ម្ហូប អាហារ និង ផលិតិ ផល ក្នុង ស្រុក ពិព័រណ៌ ផលិតផល ទូទៅ ការបាញ់ កាំជ្រួច ទាំង ៤ ថ្ងៃ ការលេង ល្បែង ប្រជាប្រិយ ។ល ។
