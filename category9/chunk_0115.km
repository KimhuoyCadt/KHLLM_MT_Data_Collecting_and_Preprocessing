( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៤ នេះ ឧប នាយក រដ្ឋមន្ដ្រី ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ មជ្ឈមណ្ឌល កម្ពុជា ៤.០ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង វេទិកា កម្ពុជា ៤.០ លើក ទី២ ស្ដីពី « សន្តិសុខ សាយប័រ » នៅ សាកលវិទ្យាល័យ ខេម តិច ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ហ៊ុន ម៉ានី បាន សម្តែង នូវ សេចក្តី សោមនស្ស និង ថ្លែងអំណរគុណ ចំពោះ អ្នកចូលរួម ដែល អញ្ជើញ មក ពី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ គ្រឹះស្ថាន សិក្សា វិស័យ ឯកជន និង យុវជន ដែល បាន អញ្ជើញ ចូលរួម ក្នុង វេទិកា ដ៏ មាន សារៈសំខាន់ នា ឱកាស នេះ ។
ជាមួយគ្នា នេះ លោក បាន លើកឡើង ថា វេទិកា នា ថ្ងៃ នេះ គឺជា ការយកចិត្តទុកដាក់ ចូលរួម ជំរុញ បំផុស ផ្សព្វផ្សាយ និង បញ្ជ្រាប ការយល់ដឹង ឲ្យ កាន់តែ ទូលំទូលាយ ពាក់ព័ន្ធ នឹង សន្តិសុខ សាយប័រ និង គន្លឹះ ការពារ ខ្លួន ពី ការវាយប្រហារ ដល់ សាធារណជន ក៏ ដូចជា ស្ថាប័ន រដ្ឋាភិបាល និង ឯកជន នៅ កម្ពុជា ពិសេស យុវជន ដើម្បី ចូលរួម ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម ឌីជីថល នៅ កម្ពុជា និង ការបន្សាំ ជាមួយ បដិវត្តន៍ ឧស្សាហកម្ម ៤.០ ។
លោក ហ៊ុន ម៉ានី បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ចាត់ទុក បច្ចេកវិទ្យា ជា វិស័យ អាទិភាព មួយ ក្នុង យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ ។ ក្នុង ន័យ នេះ ដើម្បី ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ជំរុញ ការកសាង មូលធន មនុស្ស និង លើកកម្ពស់ ឌីជីថល ភាវូបនីយកម្ម លោក បាន ជំរុញ ភាគី ពាក់ព័ន្ធ ជាពិសេស ប្រតិបត្តិករ ជាក់ស្ដែង បង្កើន ការយកចិត្តទុកដាក់ និង ធ្វើ ការរួមគ្នា តាម អភិក្រម ជវភាព នៃ ប្រព័ន្ធ តួអង្គ តែ មួយ ។
ទន្ទឹមនឹង នេះ លោក ហ៊ុន ម៉ានី បាន លើកទឹកចិត្ត ឲ្យ អ្នកប្រើប្រាស់ ស្វែងយល់ ពី វិធីសាស្ត្រ ក្នុង ការការពារ ខ្លួន តាម ប្រព័ន្ធ អ៉ីនធឺណេត និង ជំរុញ វិស័យ ឯកជន ឲ្យ រៀបចំ យុទ្ធសាស្ត្រ សន្តិសុខ សាយប័រ នៅក្នុង ស្ថាប័ន ខ្លួន ព្រមទាំង លើកកម្ពស់ ការអភិវឌ្ឍ មូលធន មនុស្ស ជំនាញ ផ្នែក សន្តិសុខ សាយប័រ ឲ្យ សមស្រប តាម តម្រូវការ ទីផ្សារ ការងារ នៅ កម្ពុជា ។
សូម ជម្រាប ជូន ថា វេទិកា នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ វា គ្មិន ជា តំណាង ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ក្រសួង មហាផ្ទៃ ក្រុមហ៊ុន Ezecom និង សាកលវិទ្យាល័យ ខេម តិច រួមទាំង និស្សិត សរុប ប្រមាណ ៤០០ នាក់ ៕ លោក ប្រាក់ សុខុន ផ្ញើ លិខិត ថ្លែងអំណរគុណ អនុប្រធាន សភា សិង្ហបុរី ចំពោះ សារ ជូនពរ ដែល លោក បាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ លោក ប្រាក់ សុខុន អនុប្រធាន ទី១ ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក អៀង ម៉ូលី ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ អេដស៍ ចំពោះ សារ ជូនពរ ដែល លោក ត្រូវបាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា អាណត្តិ ទី៥ ។
ក្នុង ឱកាស ដ៏ ប្រពៃ ថ្លៃថ្លា នេះ ខ្ញុំ និង ក្រុមគ្រួសារ សូម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ កែវ ទាំង បី វត្ថុ ស័ក្កសិទ្ធ ក្នុង លោក សូម ជួយ បីបាច់ ថែរក្សា ប្រសិទ្ធ ពរ ជ័យ បវរ សួស្តី ជ័យ មង្គល វិបុល សុខ គ្រប់ ប្រការ ដល់ ឯកឧត្តម និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ សូម បាន ប្រកប តែ ពុទ្ធ ពរ ដ៏ ប្រពៃ ថ្លៃថ្លា ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ លោក ប្រាក់ សុខុន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក មាស គឹម ហេង ចំពោះ សារ ជូនពរ ដែល លោក បាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ លោក ប្រាក់ សុខុន អនុប្រធាន ទី១ ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក មាស គឹម ហេង រដ្ឋលេខាធិការ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្ដរជាតិ ចំពោះ សារ ជូនពរ ដែល លោក ត្រូវបាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា អាណត្តិ ទី៥ ។
ក្នុង ឱកាស ដ៏ ប្រពៃ ថ្លៃថ្លា នេះ ខ្ញុំ និង ក្រុមគ្រួសារ សូម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ កែវ ទាំង បី វត្ថុ ស័ក្កសិទ្ធ ក្នុង លោក សូម ជួយ បីបាច់ ថែរក្សា ប្រសិទ្ធ ពរ ជ័យ បវរ សួស្តី ជ័យ មង្គល វិបុល សុខ គ្រប់ ប្រការ ដល់ ឯកឧត្តម និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ សូម បាន ប្រកប តែ ពុទ្ធ ពរ ដ៏ ប្រពៃ ថ្លៃថ្លា ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ លោក ប្រាក់ សុខុន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក គង់ វិបុល ចំពោះ សារ ជូនពរ ដែល លោក បាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ លោក ប្រាក់ សុខុន អនុប្រធាន ទី១ ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក គង់ វិបុល រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្តី ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ ចំពោះ សារ ជូនពរ ដែល លោក ត្រូវបាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា អាណត្តិ ទី៥ ។
ជា ទីបញ្ចប់ លោក មេធាវី ចេង ប៉េង ហាប់ បាន ថ្លែង នូវ អំណរ អរគុណ ចំពោះ វត្តមាន ចូលរួម របស់ ភ្ញៀវ កិត្តិយស និង បាន ជូន ពរ ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល នឹង ចូល មកដល់ នៅ រាត្រី ថ្ងៃសៅរ៍ ទី ១៣ ខែមេសា ឆ្នាំ ២០២៤ ខាងមុខ នេះ ព្រមទាំង បាន ប្រគល់ នូវ កន្ត្រក ផ្លែ ឈើ ដ៏ ស្រស់ស្អាត ជូន ឯកឧត្តម ទេសរដ្ឋមន្ត្រី គី តិច ជា ការថ្លែងអំណរគុណ និង ការជូនពរ ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ផងដែរ ។
ពិធី នេះ បាន ប្រព្រឹត្តទៅ យ៉ាង រលូន ប្រកបដោយ ភាពស្និទ្ធស្នាល ហើយក៏ មាន ការច្រៀង លេង និង រាំ កម្សាន្ត តាម ចង្វាក់ ប្រពៃណី ជាតិ ខ្មែរ ប្រកបដោយ បរិយាកាស សប្បាយរីករាយ ផងដែរ ៕ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ លិខិត ថ្លែងអំណរគុណ នាយក រដ្ឋមន្ត្រី សិង្ហបុរី ដែល បាន ផ្ញើ លិខិត អបអរសាទរ ជូន សម្តេច ក្នុង ឱកាស ជាប់ ឆ្នោត ជា ប្រធាន ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត មួយ ថ្លែងអំណរគុណ ចំពោះ នាយក រដ្ឋមន្ត្រី សិង្ហបុរី លោក LEE HSIEN LOONG ដែល បាន សារលិខិត សម្តែង ការអបអរសាទរ និង ជូន សព្ទ សាធុការ ពរ ជូន សម្តេច និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ ក្នុង ឱកាស ដែល សម្តេច ត្រូវបាន សម័យ ប្រជុំ ដំបូង ព្រឹទ្ធសភា នីតិកាល ទី៥ បោះឆ្នោត ជា ឯកច្ឆ័ន្ធ ជ្រើសរើស ជា « ប្រធាន ព្រឹទ្ធសភា » នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
កងទ័ព ចិន បាន និយាយ ក្នុង សេចក្តីថ្លែងការណ៍ ថា នៅ ថ្ងៃទី ៧ ខែមេសា ទី បញ្ជាការ ភូមិភាគ ខាងត្បូង របស់ យោធា ចិន នឹង រៀបចំ ធ្វើ សមយុទ្ធ រួម រវាង កងកម្លាំង ជើងទឹក និង ជើង អាកាស នៅ សមុទ្រ ចិន ខាងត្បូង ដែល ផ្តោត លើ ការល្បាត ត្រៀម ប្រយុទ្ធ ។ សេចក្តីប្រកាស នេះ កើត មាន ឡើង មួយ ថ្ងៃ បន្ទាប់ពី ប្រមុខ ការពារ ជាតិ អាមេរិក ហ្វីលីពីន ជប៉ុន និង អូស្រ្តាលី បាន ប្រកាស ថា យោធា ប្រទេស ទាំង៤ នឹង ធ្វើ សមយុទ្ធ រួមគ្នា នៅក្នុង តំបន់ សមុទ្រ មាន ជម្លោះ នេះ នៅ ថ្ងៃអាទិត្យ ដូចគ្នា ។
សិស្ស យ៉ាងតិច ៣៣០ នាក់ ចូលរួម ប្រកួត ពានរង្វាន់ អប់រំ ពេញ មួយ ជីវិត ប្រចាំ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ ថែមទាំង ពង្រីក ការយល់ដឹង បន្ថែម ដល់ សិស្ស រាប់ លាន នាក់ ទៀត
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន សិស្ស លើស ពី ៣៣០ នាក់ បាន ចូលរួម ផ្ទាល់ ក្នុង កម្មវិធី ប្រកួត ពានរង្វាន់ អប់រំ ពេញ មួយ ជីវិត ក្រោម ប្រធានបទ « ការអភិវឌ្ឍ មូលធន មនុស្ស គឺជា សរសៃ ឈាម ជួយ ឱ្យ កម្ពុជា ឈានទៅ សម្រេចបាន នូវ ចក្ខុវិស័យ ឆ្នាំ ២០៣០ និង ឆ្នាំ ២០៥០ » ដែល រៀបចំ ដោយ ឌីប៉ាតឺ ម៉ង់ អប់រំ ពេញ មួយ ជីវិត នៃ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ (RUPP) ។
កម្មវិធី នេះ ត្រូវបាន រៀបចំឡើង ដោយ ជោគជ័យ ចំនួន ៣លើក មក ហើយ តាំងពី ឆ្នាំ ២០២២មក ដោយ លើក ទី៣ ចុងក្រោយ នេះ ក៏ ទើបតែ បញ្ចប់ ទៅ នា ល្ងាច ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២៤ ខណៈ លើក ទី៣ នេះ ដែរ មាន សិស្ស ចូលរួម ដល់ ទៅ ១១០ ក្រុម ដោយ ក្នុង មួយ ក្រុម ៗ មាន សិស្ស ៣នាក់ សរុបទៅ យ៉ាងតិច ក៏ ៣៣០ នាក់ ដែរ ។
លោក ប្រធាន ដេប៉ាតឺ ម៉ង់ មឿន ចន្ទ្រា បាន ឱ្យដឹង ថា ពានរង្វាន់ អប់រំ ពេញ មួយ ជីវិត លើក ទី៣នេះ គឺ ត្រូវបាន បែងចែក ជា២ ដំណាក់កាល៖
* ដំណាក់កាល ទី ២៖ ជើង ខ្លាំង ៥ក្រុម នេះ នឹង ត្រូវ មក ធ្វើ បង្ហាញ ដោយ ផ្ទាល់ នៅ ចំពោះ មុខ គណៈកម្មការ លើ ស្នាដៃ របស់ ខ្លួន ក៏ ដូចជា ការយល់ឃើញ បន្ថែម របស់ ក្រុម ព្រមទាំង មាន ការឆ្លើយ សំណួរ របស់ គណៈកម្មការ ទៀត ដែរ ដើម្បី ដាក់ ពិន្ទុ ចុងក្រោយ ដូច្នេះ គណៈកម្មការ បូក ពិន្ទុ នៅ ដំណាក់កាល ទី១ និង ដំណាក់កាល ទី២បញ្ចូល គ្នា ដើម្បី ធ្វើ សេចក្ដីសម្រេច ចុងក្រោយ លើ ជ័យលាភី លេខ១ លេខ ២ និង លេខ ៣ (Top 3) ។
លោក មឿន ចន្ទ្រា បាន បន្ត ថា ជ័យលាភី លេខ ១ទទួលបាន រង្វាន់ ជា កុំព្យូទ័រ ម្នាក់១ គ្រឿង សម្រាប់ បង្កើន ប្រសិទ្ធភាព ក្នុង ការសិក្សា បន្ត របស់ ពួកគេ ។ ជ័យលាភី លេខ ២ និង ជ័យលាភី លេខ ៣ គឺ ទទួលបាន ថវិកា លើកទឹកចិត្ត មួយចំនួន ទៀត ។ ក្រុម លេខ ៤ និង លេខ ៥ ក៏ ទទួលបាន ថវិកា លើកទឹកចិត្ត ខ្លះ ដែរ តាម លំដាប់ ។ សម្រាប់ សិស្ស ដែល មកពី ខេត្ត ឆ្ងាយ ៗ គណៈកម្មការ ក៏ មាន ផ្ដល់ ថវិកា ជា សោហ៊ុយ ក្នុង ការធ្វើដំណើរ ស្នាក់ នៅ ខ្លះ ផងដែរ ។
លោក បាន បញ្ជាក់ ថា ការរៀបចំ កម្មវិធី ប្រកួត ពានរង្វាន់ អប់រំ ពេញ មួយ ជីវិត នេះ ឡើង គឺ ដើម្បី រួមចំណែក ផ្សព្វផ្សាយ និង ផ្ដល់ ចំណេះដឹង ពី គោល នយោបាយ ស្ដីពី ការសិក្សា ពេញ មួយ ជីវិត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង ដើម្បីឱ្យ យុវជន បង្កើន ការលើកកម្ពស់ ការប្រើប្រាស់ ភាសា ជាតិ តាមរយៈ ការសរសេរ សំណេរ ជា ភាសា ខ្មែរ ។ គួរ ជម្រាប ថា គោល នយោបាយ ស្ដីពី ការសិក្សា ពេញ មួយ ជីវិត ត្រូវបាន ដាក់ ឱ្យ អនុវត្ត តាំងពី ឆ្នាំ ២០១៩មក ម្ល៉េះ ។
ជា ការកត់សម្គាល់ របស់ ប្រធាន ដេប៉ាតឺ ម៉ង់ អប់រំ ពេញ មួយ ជីវិត ដោយ ផ្អែក លើ សំណេរ របស់ ក្រុម សិស្ស នីមួយ ៗ គឺ បង្ហាញ ពី ការយល់ដឹង កាន់តែ ច្រើន ពិសេស គឺ បាន ដឹង និង បង្ហាញ អំពី យុទ្ធសាស្ត្រ បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ដែល សរបញ្ជាក់ ឱ្យ ឃើញ ថា យុវជន របស់ កម្ពុជា កំពុង តាមដាន និង យល់ អំពី ចក្ខុវិស័យ របស់ រាជ រដ្ឋាភិបាល អ៉ឺ ចឹង ពួកគាត់ នឹង រួមចំណែក បន្ថែម ទៀត ក្នុង ការអនុវត្ត គោល នយោបាយ នេះ ។
យុវតី គ្រេង ច័ន្ទ ពិសី . យុវជន ឆាន់ សុផានរបុត្រ និង យុវជន ខុន សុខ ណែម ជា ក្រុម ជ័យលាភី លេខ ១ បាន ឱ្យដឹង ថា នេះ ជា លើក ដំបូង ហើយ ដែល ពួកគេ ចូលរួម ប្រកួត ជាសាធារណៈ បែប នេះ តែ ក្រុម នេះ បាន ប្ដេជ្ញា ជាមួយគ្នា ថា នឹង ធ្វើឱ្យ អស់ ពី សមត្ថភាព ទោះជា បាន លទ្ធផល យ៉ាងណា ក៏ អស់ចិត្ត ទាំងអស់ គ្នា ប៉ុន្តែ លទ្ធផល ទទួលបាន នេះ គឺ ពិតជា រីករាយ ដោយ មិន នឹកស្មាន ដល់ ។
លោក រដ្ឋលេខាធិការ ណុះ ស្លេះ បាន កើត សរសើរ ចំពោះ ការរៀបចំ កម្មវិធី ប្រកួត ពានរង្វាន់ អប់រំ ពេញ មួយ ជីវិត នេះ និង គាំទ្រ ឱ្យ ធ្វើ នៅ ឆ្នាំ បន្តបន្ទាប់ ទៀត ពីព្រោះ ជា ការរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍ មូលធន មនុស្ស ដើម្បី ឈាន ទៅរក ការអភិវឌ្ឍ សង្គម សេដ្ឋកិច្ចកាន់តែ រីកចម្រើន ។
លោក រដ្ឋលេខាធិការ បាន បញ្ជាក់ ថា ការចូលរួម ជំរុញ ការសិក្សា ពេញ មួយ ជីវិត នឹង ចូលរួម ជំរុញ ចក្ខុវិស័យ របស់ រដ្ឋាភិបាល គឺ កម្ពុជា ក្លាយជា ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ជា ប្រទេស ដែល មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
គិត ត្រឹម ថ្ងៃទី ៣១ ខែមីនា យន្តហោះ នៅ វៀតណាម មាន ចំនួន ២០៥ គ្រឿង ដោយ ក្នុង នោះ មាន យន្តហោះ ចំនួន ២៦ គ្រឿង ត្រូវបាន ដក ម៉ាស៊ីន សម្រាប់ ការត្រួតពិនិត្យ និង ជួសជុល តាម ការតម្រូវ របស់ ក្រុមហ៊ុន PW ។ ការជួសជុល នេះ ត្រូវបាន រំពឹង ថា នឹង ចំណាយ ពេល ប្រហែល ១៨ ខែ ហើយ ដំណោះស្រាយ ចប់ ទាំងស្រុង ចំពោះ បញ្ហា ម៉ាស៊ីន នេះ រំពឹង ថា នឹង ចប់ នៅ ចុង ឆ្នាំ ២០២៦ ឬ ដើម ឆ្នាំ ២០២៧ ។
ស្ថានភាព នេះ គួបផ្សំ នឹង ការរៀបចំ បំណុល ឡើងវិញ របស់ ក្រុមហ៊ុន អាកាសចរណ៍ មួយចំនួន បាន នាំឱ្យ មាន ការកើនឡើង តម្លៃ ជួល យន្តហោះ នៅ ទូទាំង ពិភពលោក និង មាន ភាពខ្វះខាត យន្តហោះ សម្រាប់ ជួល ។
លោក Thang បាន ប៉ាន់ប្រមាណ ថា កង្វះខាត យន្តហោះ នឹង ជះឥទ្ធិពល ដោយ ផ្ទាល់ ទៅ លើ សមត្ថភាព ដឹកជញ្ជូន ចំនួន យន្តហោះ និង សមត្ថភាព ផ្គត់ផ្គង់ ការធ្វើដំណើរ លើ ផ្លូវ ក្នុង ស្រុក និង អន្តរជាតិ ពេញ មួយ ឆ្នាំ ២០២៤ និង ២០២៥ ។ ក៏ មាន ការព្យាករ ផងដែរ ថា ក្នុង កំឡុង រដូវ ក្តៅ ដែល ជា រដូវ ធ្វើដំណើរ ច្រើន នា ពេល ខាងមុខ នេះ នឹង មាន ការខ្វះខាត សមត្ថភាព ផ្គត់ផ្គង់ ចំនួន ប្រហែល ២៤លាន កៅអី ។
សូម ពាក់ មួក សុវត្ថិភាព ជានិច្ច ពេល ធ្វើដំណើរ តាម ម៉ូតូ ! ស្លាប់ ២នាក់ និង របួស ១៨ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៦ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ស្រាល ១៨ នាក់ ។
លោក ផារ៉ា មង្គល និង លោកស្រី តាវ ម៉ាឌីណា ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ និង ចែក ធុង សំរាម ចំនួន ២៥៦ ធុង ដល់ គ្រប់ អង្គភាព នៅក្នុង ស្រុក ក្រូចឆ្មារ
( ត្បូងឃ្មុំ ) ៖ រសៀល ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៤ លោក ផារ៉ា មង្គល សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក ក្រូចឆ្មារ និង លោកស្រី តាវ ម៉ាឌីណា ផារ៉ា មង្គល បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ផ្ដល់ ធុង សំរាម ចំនួន ២៥៦ ធុង ដល់ គ្រប់ អង្គភាព មាន ដូចជា សាលារៀន មន្ទីរពេទ្យ វត្ត អារាម វិហារ ឥស្លាម នៅក្នុង ស្រុក ក្រូចឆ្មារ និង ចែក ដប ទឹក ចំនួន ២០០ ផងដែរ ជូន ដល់ សិស្សានុសិស្ស នៃ អនុវិទ្យាល័យ ជា ចក ដើម្បី កាត់បន្ថយ ការប្រើប្រាស់ ថង់ ប្លាសិ្ទក ។
ចំពោះ សម្ភារៈ ដែល លោក ផារ៉ា មង្គល នាំយក មក ផ្តល់ ជូន ទាំងអស់ នេះ ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត និង លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុនី្ន តាមរយៈ លោក អ៊ាង សុផល្លែត សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា អនុប្រធាន ទី២ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត ត្បូងឃ្មុំ ដើម្បី ទុកដាក់ សម្រាម ការពារ បរិស្ថាន ជាពិសេស ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ ឆ្នាំ ថ្មី នេះ ។
ជាមួយគ្នា នោះ លោក ផារ៉ា មង្គល មានប្រសាសន៍ និង ធ្វើ ការអបអរសាទរ ក្នុង ឱកាស សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី ដែល ទទួលបាន ការបោះឆ្នោត ជាប់ ជា ប្រធាន ព្រឹទ្ធសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។ តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ បាន នាំ កម្ពុជា ទទួលបាន សុខ សន្តិភាព ពេញលេញ ឯកភាព ជាតិ ឯកភាព ទឹកដី ទាំងស្រុង ។
បន្ថែម ពី នេះ លោក ផារ៉ា មង្គល បាន ពាំនាំ ការផ្ដាំផ្ញើ សួរសុខទុក្ខ និង ជូនពរ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា និង សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ទាំងអស់ ផងដែរ ។
ស្ថិត ក្នុង ឱកាស នេះ ដែរ លោក ក៏ បាន លើកទឹកចិត្ត ដល់ លោកគ្រូ អ្នកគ្រូ ត្រូវ ខិតខំ ប្រឹងប្រែង បង្រៀន សិស្សានុសិស្ស និង ណែនាំ កូនសិស្ស ឱ្យ ថែរក្សា អនាម័យ ដោយ ហូប ស្អាត ផឹក ស្អាត រស់ នៅ ស្អាត ដើម្បី បង្ការ ជំងឺ ឆ្លង ដែល បណ្តាល មកពី កង្វះ អនាម័យ ។
ជា ចុងក្រោយ លោក ផារ៉ា មង្គល បាន ផ្តាំផ្ញើ ដល់ ក្មួយ ៗ សិស្សានុសិស្ស ទាំងអស់ ត្រូវ ខិតខំ ប្រឹងប្រែង សិក្សា រៀនសូត្រ ជៀស ឆ្ងាយ ពី គ្រឿងញៀន និង ល្បែងស៊ីសង ដើម្បី ប្រែក្លាយ ខ្លួន ជា យុវជន គំរូ និង ជា ទំពាំង ស្នង ឫស្សី សម្រាប់ ប្រទេសជាតិ នា ពេល អនាគត ៕
លុបបំបាត់ គ្រឿងញៀន ត្រូវ ផ្តើម ចេញ ពី យើង ទាំងអស់ គ្នា ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ០៦ ខែ មេសា៖ បង្ក្រាប ១៨ករណី ឃាត់ខ្លួន ៦០ នាក់
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៨ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៦០ នាក់ ។
ប្រធាន គណៈកម្មាធិការ ជាតិ នៃ សភា ប្រឹក្សា នយោបាយ ប្រជាជន ចិន ផ្ញើ សារ អបអរសាទរ ជូន សម្តេច តេជោ ហ៊ុន សែន ដែល ត្រូវបាន សម័យ ប្រជុំ ដំបូង ព្រឹទ្ធសភា បោះឆ្នោត ជា ឯកច្ឆ័ន្ធ ជ្រើសរើស ជា « ប្រធាន ព្រឹទ្ធសភា »
( ភ្នំពេញ ) ៖ លោក វាំង ហ៊ុយ នឹង ប្រធាន គណៈកម្មាធិការ ជាតិ នៃ សភា ប្រឹក្សា នយោបាយ ប្រជាជន ចិន (CPPCC) បាន ផ្ញើ សារលិខិត សម្តែង ការអបអរសាទរ យ៉ាង កក់ក្តៅ បំផុត ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ដែល សម្តេច ត្រូវបាន សម័យ ប្រជុំ ដំបូង ព្រឹទ្ធសភា នីតិកាល ទី៥ បោះឆ្នោត ជា ឯកច្ឆ័ន្ធ ជ្រើសរើស ជា « ប្រធាន ព្រឹទ្ធសភា » នៃ ព្រះរាជាណាចក្រ កម្ពុជា កាលពី ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២៤ ។
តាមរយៈ សារលិខិត លោក វាំង ហ៊ុយ នឹង បាន បញ្ជាក់ ដូច្នេះ ថា៖ « ខ្ញុំ មាន សេចក្តី សោមនស្ស រីករាយ ដែល បាន ទទួល ដំណឹង ពី ការបោះឆ្នោត ជ្រើសរើស សម្តេច តេជោ ជា ប្រធាន ព្រឹទ្ធសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។ ក្នុង នាម គណៈកម្មាធិការ ជាតិ នៃ សភា ប្រឹក្សា នយោបាយ ប្រជាជន ចិន (CPPCC) និង ក្នុង នាម ខ្លួនខ្ញុំ ផ្ទាល់ ខ្ញុំ សូម សម្តែង ការអបអរសាទរ យ៉ាង កក់ក្តៅ បំផុត ជូន ចំពោះ សម្តេច ប្រធាន » ។
ប្រធាន គណៈកម្មាធិការ ជាតិ នៃ សភា ប្រឹក្សា នយោបាយ ប្រជាជន ចិន ក៏ បាន ជូន ពរ ព្រះរាជាណាចក្រ កម្ពុជា ជួបប្រទះ តែ វិបុលភាព និង ប្រជាជន កម្ពុជា ជួបប្រទះ តែ សុភមង្គល ព្រមទាំង បាន ជូន ពរ សម្តេច តេជោ បន្ត ទទួលបាន ជោគជ័យ គ្រប់ ភារកិច្ច ដ៏ ឧត្តុង្គឧត្តម របស់ សម្តេច ៕
ខាងក្រោម នេះ ជា សារលិខិត របស់ ប្រធាន គណៈកម្មាធិការ ជាតិ នៃ សភា ប្រឹក្សា នយោបាយ ប្រជាជន ចិន៖
សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ លិខិត ថ្លែងអំណរគុណ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ដែល បាន ផ្ញើ លិខិត អបអរសាទរ ជូន សម្តេច ក្នុង ឱកាស ជាប់ ឆ្នោត ជា ប្រធាន ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត មួយ ថ្លែងអំណរគុណ ចំពោះ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ដែល បាន សារលិខិត សម្តែង ការអបអរសាទរ និង ជូន សព្ទ សាធុការ ពរ ជូន សម្តេច និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ ក្នុង ឱកាស ដែល សម្តេច ត្រូវបាន សម័យ ប្រជុំ ដំបូង ព្រឹទ្ធសភា នីតិកាល ទី៥ បោះឆ្នោត ជា ឯកច្ឆ័ន្ធ ជ្រើសរើស ជា « ប្រធាន ព្រឹទ្ធសភា » នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ខាងក្រោម នេះ ជា សារលិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន៖ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ លិខិត ថ្លែងអំណរគុណ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ដែល បាន ផ្ញើ លិខិត អបអរសាទរ ជូន សម្តេច ក្នុង ឱកាស ជាប់ ឆ្នោត ជា ប្រធាន ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត មួយ ថ្លែងអំណរគុណ ចំពោះ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ដែល បាន សារលិខិត សម្តែង ការអបអរសាទរ និង ជូន សព្ទ សាធុការ ពរ ជូន សម្តេច និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ ក្នុង ឱកាស ដែល សម្តេច ត្រូវបាន សម័យ ប្រជុំ ដំបូង ព្រឹទ្ធសភា នីតិកាល ទី៥ បោះឆ្នោត ជា ឯកច្ឆ័ន្ធ ជ្រើសរើស ជា « ប្រធាន ព្រឹទ្ធសភា » នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ខាងក្រោម នេះ ជា សារលិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន៖ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ លិខិត ថ្លែងអំណរគុណ សម្តេច រដ្ឋសភា ធិបតី ឃួន សុដារី ដែល បាន ផ្ញើ លិខិត អបអរសាទរ ជូន សម្តេច ក្នុង ឱកាស ជាប់ ឆ្នោត ជា ប្រធាន ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត មួយ ថ្លែងអំណរគុណ ចំពោះ សម្តេច មហា រដ្ឋសភាធិការ ធិបតី យួន សុដារី ប្រធាន រដ្ឋសភា កម្ពុជា ដែល បាន សារលិខិត សម្តែង ការអបអរសាទរ និង ជូន សព្ទ សាធុការ ពរ ជូន សម្តេច និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ ក្នុង ឱកាស ដែល សម្តេច ត្រូវបាន សម័យ ប្រជុំ ដំបូង ព្រឹទ្ធសភា នីតិកាល ទី៥ បោះឆ្នោត ជា ឯកច្ឆ័ន្ធ ជ្រើសរើស ជា « ប្រធាន ព្រឹទ្ធសភា » នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ខាងក្រោម នេះ ជា សារលិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន៖ ឃាតកម្ម សម្លាប់ ដុត សាកសព នៅ ក្រុង ប៉ោយប៉ែត កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ដឹកនាំ ស្រាវជ្រាវ បង្ក្រាប បាន ជន ដៃ ដល់
នៅ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២៤ ដដែល នេះ ប្រជាពលរដ្ឋ បាន យក សំរាម ទៅ ដុត ចោល ក្នុង រណ្តៅ ដុត សំរាម ហើយ ប្រទះឃើញ សាកសព ត្រូវ ដុត ចោល ក្នុង រណ្តៅ ដែល មាន ភិនភាគ ដូច ទៅនឹង ជនរងគ្រោះ ខាងលើ ហើយ បាន រាយការណ៍ ជូន សមត្ថកិច្ច ។
ក្រោយពី បាន ធ្វើ កោសល្យវិច័យ គឺ សាកសព មាន សភាព កាត់ ក ដៃ និង កាត់ ម្រាម ដៃ កាត់ កែង ជើង ហើយ យកមក ដុត ចោល នៅរណ្តៅ ដុត សំរាម ឆេះ សល់ តែ ដង ខ្លួន និង សាច់ដុំ ដៃ និង ក្បាល ឆេះ សក់ អស់ ស្ថិត នៅក្នុង ភូមិ អណ្តូង ថ្ម មាស សង្កាត់ ផ្សារ កណ្តាល ក្រុង ប៉ោយប៉ែត ។
បន្ទាប់ពី ទទួលបាន ព័ត៌មាន ដោយ អនុវត្ត តាម បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ . អគ្គ ស្នងការ រង ទទួល ផែន អគ្គ ស្នងការ រង ទទួល នាយកដ្ឋាន . លោក ឧត្តមសេនីយ៍ ឯក ង៉េង ជួ ប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន បញ្ជា កម្លាំង ជំនាញ នាយកដ្ឋាន បើក ការស្រាវជ្រាវ ។
កម្លាំង ជំនាញ របស់ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ហ៊ុន មុន្នីរ័ត្ន និង លោក ហែម បូណា និង លោក វរសេនីយ៍ ឯក ឆាន់ គឹម លី អនុប្រធាន នាយកដ្ឋាន បាន ធ្វើ ការសហការ ជាមួយ កម្លាំង ជំនាញ របស់ អធិការដ្ឋាន នគរបាល ក្រុង ប៉ោយប៉ែត ប្រើ វិធានការ ជំនាញ ធ្វើ ការស្រាវជ្រាវ តាម នីតិវិធី រហូត កំណត់ បាន អត្តសញ្ញាណ និង ទីតាំង លាក់ ខ្លួន របស់ ជនសង្ស័យ ។
លុះ ដល់ ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២៤ វេលា ម៉ោង ១៧៖០០ នាទី កម្លាំង ជំនាញ របស់ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន បន្ត ស្រាវជ្រាវ រហូតដល់ ធ្វើ ការឃាត់ខ្លួន បាន ជនសង្ស័យ បាន ចំនួន ម្នាក់ ឈ្មោះ ជា សារាជ ភេទ ប្រុស អាយុ ២៤ ឆ្នាំ ជនជាតិ ខ្មែរ នៅ ត្រង់ ចំណុច សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
បច្ចុប្បន្ន ជន ដៃ ដល់ កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន ប្រគល់ ជូន អធិការដ្ឋាន នគរបាល ក្រុង ប៉ោយប៉ែត ដើម្បី ចាត់ការបន្ដ តាម នីតិវិធី ៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចាត់ តំណាង ចុះ សួរសុខទុក្ខ និង ផ្ដល់ អំណោយ ដល់ ស្ត្រី មាន ផ្ទៃពោះ ស្ត្រី មាន កូន តូច អនីតិជន និង ស្ដ្រី វ័យ ចំណាស់ នៅ មណ្ឌល អប់រំ កែប្រែ ទី២ ខណ្ឌ ដង្កោ
ក្នុង ឱកាស នោះ លោកស្រី អគ្គ លេខាធិការ រង ទី១ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ការគិតគូរ និង ក្តី អាណិត ស្រឡាញ់ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចំពោះ បងប្អូន ក្មួយ ៗ ទាំងអស់ នៃ មណ្ឌល អប់រំ កែប្រែ ទី២នេះ ។
លោកស្រី បាន ថ្លែង បន្ដ ថា នៅ ចំពោះមុខ នេះ បងប្អូន ក្មួយ ៗ ទាំងអស់ ត្រូវ ទទួល ការផ្តន្ទាទោស ទៅតាម ច្បាប់ ដោយសារតែ ការប្រព្រឹត្ត នូវ អំពើ ខុស ច្បាប់ របស់ បងប្អូន ។ ក៏ប៉ុន្តែ នៅ ទីនេះ បន្ទុក របស់ រាជ រដ្ឋាភិបាល និង មន្ត្រី មាន សមត្ថកិច្ច បាន យកចិត្តទុកដាក់ ផ្តល់ កន្លែង ស្នាក់ នៅ ការហូបចុក និង ការអប់រំ កែប្រែ ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ជំនាញ និង បំនិន ជីវិត ដើម្បី អាច មាន សមត្ថភាព ប្រកបរបរ ចិញ្ចឹម ជីវិត វិញ បាន ដោយ សុច្ចរិត បន្ទាប់ពី មាន សេរីភាព ឡើងវិញ ក្រោម ម្លប់ នៃ សុខ សន្តិភាព ។
ជាមួយគ្នា នេះ បងប្អូន ក្មួយ ៗ ក៏ ត្រូវ ទទួលយក នូវ ការអប់រំ ផ្លូវចិត្ត តាម ផ្លូវ ព្រះធម៌ គឺ ការប្រព្រឹត្ត នូវ អំពើ ល្អ ទទួលបាន នូវ ផល ល្អ . ការប្រព្រឹត្ត អំពើ មិន កុសល នឹង ទទួល ទោស ទៅ តាម នោះ ដែរ ដូច្នេះ សូម យើង ទាំងអស់ គ្នា ប្រកាន់ខ្ជាប់ នូវ សីល សមាធិ បញ្ញា ឱ្យ បាន គ្រប់ ៗ គ្នា ។
លោកស្រី អគ្គ លេខាធិការ រង ទី១ បាន លើកឡើង ទៀត ថា នៅក្នុង មណ្ឌល អប់រំ កែប្រែ ទី២នេះ មាន ៦៥% ដែល ពាក់ព័ន្ធ នឹង ករណី គ្រឿងញៀន គឺ គ្រឿងញៀន ជា អ្នក បំផ្លាញ យើង ទាំងអស់ គ្នា បំផ្លាញ ក្រុមគ្រួសារ ញាតិមិត្ត និង សង្គមជាតិ យើង . ហេតុ ដូចនេះ យើង ទាំងអស់ គ្នា ត្រូវ ជៀស ឱ្យ ឆ្ងាយ ពី គ្រឿងញៀន ។
តុលាការ សម្រេច ឃុំ ខ្លួន បុគ្គល ឈ្មោះ ដែន សូនី ក្រោយ ចោទប្រកាន់ ពី បទ « ហិង្សា ដោយ ចេតនា »
ការសម្រេច ឃុំ ខ្លួន នេះ ក្រោយ តំណាង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ លោក សេង ហៀង សម្រេច ចោទប្រកាន់ ពី បទ ហិង្សា ដោយ ចេតនា តាម មាត្រា ២១៧ នៃ ក្រម ព្រហ្មទណ្ឌ ។
លោក គង់ សុខ សែន ហៅ ដែន សូនី ត្រូវបាន នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ឃាត់ខ្លួន កាលពី ថ្ងៃទី៤ ខែមេសា ឆ្នាំ ២០២៤ ហើយ បញ្ជូន ទៅកាន់ តុលាការ បន្ទាប់ពី សួរចម្លើយ រួច ។
ការឃាត់ខ្លួន នេះ ធ្វើឡើង តាម បញ្ជា របស់ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ដោយ កម្លាំង នគរបាល បាន ចុះ ទៅ ឃាត់ខ្លួន លោក សែន សូនី តែម្តង បន្ទាប់ពី វីដេអូ របស់ លោក ដែល បាន ប្រើ ហិង្សា ដោយ ចេតនា ប្រព្រឹត្ត នៅ ចំណុច បន្ទប់ ជួល លេខ ១០០៩ ផ្លូវ លំ ភូមិ ស្វាយ តា អុក១ សង្កាត់ វាល ស្បូវ ខណ្ឌ ច្បារអំពៅ កាលពី ថ្ងៃទី ៥ ខែធ្នូ ឆ្នាំ ២០២៣ ត្រូវបាន បែក ធ្លាយ ។
ក្រោយ វីដេអូ បែកធ្លាយ ហើយ មាន ការរិះគន់ យ៉ាង ខ្លាំងក្លា ពី អ្នកប្រើប្រាស់ បណ្តាញ សង្គម ហ្វេសប៊ុក នោះ លោក ដែន សូនី បាន ចេញមុខ បកស្រាយ ថា វីដេអូ ដែល ឃើញ ប្រើប្រាស់ អំពើហិង្សា នោះ ជា វីដេអូ សម្តែង ប៉ុណ្ណោះ ដោយ ខ្លួន បាន សម្តែង (Prank) ជាមួយនឹង ប្អូនស្រី របស់ ខ្លួន ហើយ បន្ទាប់មក ក៏ បាត់ ទូរស័ព្ទ ដែល បាន ថត វីដេអូ នោះ តែម្តង ។
ប្រតិភូ ក្រសួង ការងារ ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ របស់ សម្តេច ធិបតី និង លោកជំទាវ បណ្ឌិត ផ្តល់ ជូន កងពល តូច អន្តរាគមន៍ លេខ ៧
លោក រដ្ឋមន្ត្រី ស្តីទី បាន កោតសរសើរ ដ៏ ស្មោះស័្ម គ្រ ចំពោះ នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន ព្រម ទំាង អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ដែល បាន យកចិត្តទុកដាក់ សហការ គ្នា យ៉ាង ជិត សិ្នទ្ធ ចូលរួមចំណែក យ៉ាង សស្រាក់សស្រាំ ក្នុង ការបំពេញ បេសកកម្ម ជា ប្រវត្តិសាស្រ្ត របស់ បងប្អូន កងកម្លាំងប្រដាប់អាវុធ នៃ កងពល តូច អន្តរាគមន៍ លេខ ៧ ក្នុង ការការពារ បូរណភាព ទឹកដី និង ការពារ សន្តិសុខ សុវត្តិភាព ជូន ជាតិ យើង ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ២២២ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៤
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២.១៣០ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១.៥៦៤ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៥៦៦ គ្រឿង ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៤ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៨ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០២ នាក់ របួស ចំនួន ១៨នាក់ ( របួស ធ្ងន់ ចំនួន ១២នាក់ ) ។ រយៈពេល ០៦ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៥១ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ២៥ នាក់ របួស ៥៩ នាក់ ( របួស ធ្ងន់ ៣២ នាក់ )៕
លោក ប្រាក់ សុខុន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក ហ៊ុន ក្រង ផាណង ចំពោះ សារ ជូនពរ ដែល លោក បាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ លោក ប្រាក់ សុខុន អនុប្រធាន ទី១ ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក ហ៊ុន ក្រង ផាណង ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ប្រទេស ឡាវ ចំពោះ សារ ជូនពរ ដែល លោក ត្រូវបាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា អាណត្តិ ទី៥ ។
ក្នុង ឱកាស ដ៏ ប្រពៃ ថ្លៃថ្លា នេះ ខ្ញុំ និង ក្រុមគ្រួសារ សូម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ កែវ ទាំង បី វត្ថុ ស័ក្កសិទ្ធ ក្នុង លោក សូម ជួយ បីបាច់ ថែរក្សា ប្រសិទ្ធ ពរ ជ័យ បវរ សួស្តី ជ័យ មង្គល វិបុល សុខ គ្រប់ ប្រការ ដល់ ឯកឧត្តម និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ សូម បាន ប្រកប តែ ពុទ្ធ ពរ ដ៏ ប្រពៃ ថ្លៃថ្លា ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ លោក ប្រាក់ សុខុន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក ងី ច័ន្ទ្រ ផល ចំពោះ សារ ជូនពរ ដែល លោក បាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ លោក ប្រាក់ សុខុន អនុប្រធាន ទី១ ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក ងី ច័ន្ទ្រ ផល រដ្ឋលេខាធិការ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្ដរជាតិ ចំពោះ សារ ជូនពរ ដែល លោក ត្រូវបាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា អាណត្តិ ទី៥ ។
( ភ្នំពេញ ) ៖ លោក ប្រាក់ សុខុន អនុប្រធាន ទី១ ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោកស្រី សឿង រដ្ឋ ចាវី ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ប្រទេស ចិន ចំពោះ សារ ជូនពរ ដែល លោក ត្រូវបាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា អាណត្តិ ទី៥ ។
ក្នុង ឱកាស ដ៏ ប្រពៃ ថ្លៃថ្លា នេះ ខ្ញុំ និង ក្រុមគ្រួសារ សូម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ កែវ ទាំង បី វត្ថុ ស័ក្កសិទ្ធ ក្នុង លោក សូម ជួយ បីបាច់ ថែរក្សា ប្រសិទ្ធ ពរ ជ័យ បវរ សួស្តី ជ័យ មង្គល វិបុល សុខ គ្រប់ ប្រការ ដល់ ឯកឧត្តម និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ សូម បាន ប្រកប តែ ពុទ្ធ ពរ ដ៏ ប្រពៃ ថ្លៃថ្លា ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ លោក ប្រាក់ សុខុន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក សួស យ៉ារ៉ា ចំពោះ សារ ជូនពរ ដែល លោក បាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ លោក ប្រាក់ សុខុន អនុប្រធាន ទី១ ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក សួស យ៉ារ៉ា ប្រធាន គណៈកម្មាធិការ បរទេស សហប្រតិបត្តិការ អន្ដរជាតិ និង ព័ត៌មាន ចំពោះ សារ ជូនពរ ដែល លោក ត្រូវបាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា អាណត្តិ ទី៥ ។
( ភ្នំពេញ ) ៖ លោក ប្រាក់ សុខុន អនុប្រធាន ទី១ ព្រឹទ្ធសភា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ចំពោះ សារ ជូនពរ ដែល លោក ត្រូវបាន ជាប់ ឆ្នោត ជា អនុប្រធាន ទី១ ព្រឹទ្ធសភា អាណត្តិ ទី៥ ។
ក្នុង ឱកាស ដ៏ ឧត្ដុង ឧត្ដម ប្រសើរ ថ្លៃថ្លា នេះ ខ្ញុំ សូម សម្ដែង ការកោតសរសើរ ដោយ ស្មោះ អស់ ពី ដួងចិត្ត ជូន ចំពោះ សម្តេច វិបុល សេនា ភក្តី ដែល ជា ថ្នាក់ដឹកនាំ ប្រកបដោយ ទឹកចិត្ត ស្នេហាជាតិ និង ជាទីគោរព ស្រឡាញ់ របស់ ប្រជាពលរដ្ឋ តាមរយៈ ការសម្រេចបាន ជោគជ័យ ដ៏ ត្រចះត្រចង់ ជូន ជាតិ មាតុភូមិ ក្នុង ការដឹកនាំ ស្ថាប័ន ព្រឹទ្ធសភា កន្លងមក ។
សម្ដេច បាន ពុះពារ ត ស៊ូ និង លះបង់ ដ៏ ធំធេង ក្នុង បុព្វហេតុ សន្តិភាព ស្ថេរភាព និង អភិវឌ្ឍ ជាតិ មាតុភូមិ ជា ទីស្រឡាញ់ បំផុត របស់ សម្តេច ហើយ គំរូ ប្រកបដោយ វីរៈ ភាព ដ៏ ថ្លៃថ្លា នេះ នឹង ស្ថិត នៅជា រាង ដរាប នៅក្នុង ការចងចាំ និង បេះដូង របស់ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ និង ប្រជាជន កម្ពុជា គ្រប់ ៗ រូប ។
ខ្ញុំ និង ក្រុមគ្រួសារ សូម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ កែវ ទាំង បី វត្ថុ ស័ក្កសិទ្ធ ក្នុង លោក សូម មេត្តា ជួយ បីបាច់ ថែរក្សា ប្រសិទ្ធ ពរ ជ័យ បវរ សួស្តី ជ័យ មង្គល វិបុល សុខ គ្រប់ ប្រការ ជូន សម្តេច វិបុល សេនា ភក្តី និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ សូម បាន សម្រេច នូវ ជោគជ័យ ដ៏ ត្រចះត្រចង់ ក្នុង បុព្វហេតុ បម្រើ ជាតិ មាតុភូមិ និង វឌ្ឍនភាពសង្គម ដ៏ រុងរឿង ៕ លោក ប៉ែន បូណា៖ ចូល ឆ្នាំ ថ្មី មាន អត្ថន័យ លើស ពី ការជួបជុំ ដ៏ សប្បាយរីករាយ !
( ភ្នំពេញ ) ៖ លើស ពី កម្មវិធី ជួបជុំ កម្សាន្ត សប្បាយ តាម ទំនៀមទម្លាប់ ប្រពៃណី ជាតិ ដែល រាជ រដ្ឋាភិបាល ក៏ដូចជា អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ រៀបចំ សម្រាប់ ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ បរទេស បុណ្យ ចូល ឆ្នាំ ថ្មី ក៏ ជា ឱកាស ដែល យើង បាន ឃើញ ពី ការយកចិត្តទុកដាក់ របស់ រាជ រដ្ឋាភិបាល ចំពោះ ប្រជាពលរដ្ឋ មន្ត្រីរាជការ និង កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ។
ទី១៖ រថយន្តក្រុង សាធារណៈ រាប់ រយ គ្រឿង ត្រូវបាន រៀបចំ ដើម្បី ដឹកជញ្ជូន ប្រជាពលរដ្ឋ ពី ភ្នំពេញ ទៅ ស្រុក កំណើត និង ពី ស្រុក កំណើត មក ភ្នំពេញ វិញ ដោយ ឥត គិត ថ្លៃ ។ ក្រៅពី ផ្តល់ ផល ចំណេញ យ៉ាង ច្រើន ដល់ ប្រជាពលរដ្ឋ និង កម្មករ កម្ម ការិនី ដោយ ពួកគេ មិន បាច់ ចំណាយ លើ ថ្លៃ ធ្វើដំណើរ រថយន្តក្រុង ក៏ ផ្តល់ ជូន នូវ ការធ្វើដំណើរ ប្រកបដោយ ផាសុកភាព និង អាច កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ តាម ដងផ្លូវ ទៀតផង ។
ទី ២៖ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី នេះ ដែរ រាជ រដ្ឋាភិបាល បាន ឧបត្ថម្ភ ថវិកា ៥ម៉ឺន រៀល ដល់ មន្ត្រីរាជការ ស៊ីវិល និង កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ព្រមទាំង មន្ត្រី ថ្នាក់ ក្រោម ជាតិ រហូតដល់ និវត្ត ជន និង ជន បាត់បង់ សម្បទារ វិជ្ជាជីវៈ ទៀតផង ។ ការឧបត្ថម្ភ នេះ សបញ្ជាក់ ពី ការយកចិត្តទុកដាក់ របស់ រាជ រដ្ឋាភិបាល ចំពោះ អ្នកខិតខំ ធ្វើ ការបម្រើ ជាតិ និង បាន លះបង់ ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាជន ។
ទី ៤៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ប្រមុខ ដឹកនាំ នៃ រាជ រដ្ឋាភិបាល ទើបតែ ចេញ អនុក្រឹត្យ ស្តីពី ការដំឡើង ប្រាក់ បំណាច់ មុខងារ ជូន ដល់ មន្ត្រីរាជការ ស៊ីវិល កងកម្លាំងប្រដាប់អាវុធ និង ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែ ដល់ មន្ត្រី អាជ្ញាធរ ថ្នាក់ ក្រោម ជាតិ ។ នេះ ជា កិច្ច ខិតខំ ប្រឹងប្រែង ជាប្រចាំ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការបង្កើន ជីវភាព អ្នក ដែល ធ្វើ ការបម្រើ ជាតិ ទាំងអស់ ។
ទី៥៖ កម្មវិធី គោល នយោបាយ អាទិភាព ៦ចំណុច ដែល បាន ប្រកាស ឱ្យ អនុវត្ត ជាបន្ទាន់ កាលពី ចុង ខែសីហា ឆ្នាំ ២០២៣ ដោយ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា សុទ្ធតែ ផ្តោត សំខាន់ ទៅ លើ ការលើកកម្ពស់ ជីវភាព ប្រជាពលរដ្ឋ ជាពិសេស គ្រួសារ ក្រីក្រ និង ងាយ រង ហានិភ័យ ។ នេះ ជា គោល នយោបាយ ជួយ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ មាន ជីវភាព ធូរធារ ឡើង ជាលំដាប់ ។
ទី ៦៖ ក្នុង យុទ្ធសាស្ត្រ បញ្ចកោណ គោលដៅ ដ៏ សំខាន់ បំផុត របស់ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត គឺ ឆ្ពោះទៅ សម្រេច ចក្ខុវិស័យ កម្ពុជា ឆ្នាំ ២០៥០ ក្លាយជា ប្រទេស ដែល មាន ចំណូល ខ្ពស់ ពោលគឺជា ប្រទេស ដែល មាន សេដ្ឋកិច្ច រឹងមាំ មាន កិត្យានុភាព ខ្ពស់ ប្រជាពលរដ្ឋ មាន ជីវភាព ធូរធារ មាន ចំណេះដឹង និង សីលធម៌ ល្អ រស់ នៅក្នុង បរិស្ថាន បៃតង បរិយាកាស ល្អ បរិសុទ្ធ និង ទទួលបាន ការគាំពារ គ្រប់ យ៉ាង ពី សង្គម ។
សរុប មកវិញ មន្ត្រីរាជការ ស៊ីវិល និង កងកម្លាំងប្រដាប់អាវុធ ក៏ ដូចជា ប្រជាពលរដ្ឋ ទូទៅ មាន ភាព កក់ក្តៅ មាន ក្តីសង្ឃឹម ក្នុង ជីវិត និង មាន មោទនភាព ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល គណបក្ស ប្រជាជន កម្ពុជា ៕
កូន ឈើ ជាង ១លាន ដើម ត្រូវបាន បណ្តុះ នៅ តាម ថ្នាល់ បណ្តុះ កូន ឈើ នៅ តាម បណ្តា រាជធានី - ខេត្ត សម្រាប់ ចែកជូន ពលរដ្ឋ ដាំ នៅ រដូវ វស្សា
( ភ្នំពេញ ) ៖ ក្រសួង បរិស្ថាន បាន បណ្តុះ កូន ឈើ ចំនួន ជាង ១លាន ដើម នៅ តាម ថ្នាល់ បណ្តុះ កូន ឈើ នៃ មន្ទីរ បរិស្ថាន រាជធានី ខេត្ត នានា និង ១ ផ្នែក ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន សម្រាប់ យុទ្ធនាការដាំ ដើមឈើ យ៉ាងតិច ១លាន ដើម ជារៀងរាល់ ឆ្នាំ ចាប់ពី រដូវ វស្សា ឆ្នាំ ២០២៤ នេះ តទៅ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ លោក ខ្វៃ អាទិត្យា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន ។
ជាក់ស្តែង គិត រហូតដល់ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២៤ ក្រសួង បរិស្ថាន បាន បណ្តុះ កូន ឈើ សរុប ចំនួន ៦៤២៣១០ ដើម និង ការចែកជូន កូន ឈើ ជា បន្តបន្ទាប់ ដល់ ប្រជាពលរដ្ឋ យក ទៅ ដាំ តាម ផ្ទះ សាលារៀន វត្ត អារាម សហគមន៍ បាន ចំនួន ២០៥៥២៨ ដើម ។ ជាមួយគ្នា នេះ លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន ផ្តល់ ជូន អំណោយ កូន ត្នោត ចំនួន ជាង ៣០ម៉ឺន ដើម ក្នុង យុទ្ធនាការ នេះ ផងដែរ ។
តាមរយៈ យុទ្ធនាការ ថ្ងៃ១០ ខែតុលា ឆ្នាំ ២០២៣ នេះ លោក រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ ចូលរួម ដាំ ដើមឈើ ដាំ ស្តារ ព្រៃ និង ចូលរួម ការពារ អភិរក្ស ព្រៃឈើ និង បរិស្ថាន ធម្មជាតិ ដើម្បី បង្កើន គម្រប ព្រៃ និង អាច លក់ កាបូន ដើម្បី អាច បង្កើន ប្រាក់ ចំណូល នៅក្នុង សហគមន៍ ។
លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន ថ្លែង ថា យុទ្ធសាស្រ្ត ភាព បៃតង របស់ កម្ពុជា រៀបចំឡើង ស្រប តាម យុទ្ធសាស្រ្ដ ចក្រា វិស័យ បរិស្ថាន ដែល បាន ដាក់ចេញ អនុលោម តាម យុទ្ធសាស្រ្ដ បញ្ចកោណ ដំណាក់កាល ទី១ នៃ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ដើម្បី ឈាន ឆ្ពោះទៅ សម្រេច ទស្សនវិស័យ បង្កើន គម្រប ព្រៃ ចំនួន ៦០ % នា ឆ្នាំ ២០៥០ ៕
នគរបាល ឃាត់ខ្លួន ចៅសង្កាត់ រង ទី២ នៃ សង្កាត់ អូរឬស្សី ទី៤ ខណ្ឌ ៧មករា ពាក់ព័ន្ធ ការផ្តល់ ឯកសារ ក្លែង
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២៤ ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កំរិត ធ្ងន់ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន សហការ ជាមួយ ផែនការងារ សន្តិសុខ បាន ស្រាវជ្រាវ នាំ ខ្លួន ជនសង្ស័យ ម្នាក់ នៅ ចំណុច ផ្លូវ ១០៧ កែង ១៦៦ សង្កាត់ អូ ឬ ស្សី៤ ខណ្ឌ ៧មករា រាជធានី ភ្នំពេញ តាម ដីកា បញ្ជា ឲ្យ ចូល ខ្លួន របស់ លោក ស៊ិត វណ្ណះ ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
អ្នកនាំពាក្យ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ លោក សំ វិច្ឆិកា បាន បញ្ជាក់ ថា ការចាប់ខ្លួន ឈ្មោះ គឹម ហុង មាន តួនាទី ចៅសង្កាត់ រង ទី២ នៃ សង្កាត់ អូរឬស្សី ទី៤ បាន ធ្វើឡើង តាម ដីកា បញ្ជា ឲ្យ នាំចូល ខ្លួន របស់ តំណាង អយ្យការ ពី បទ « សុំឲ្យ ផ្តល់ ឯកសារ ដោយ ទុច្ចរិត » ( ចុះឈ្មោះ ចូល បញ្ជី រាយ នាម បេក្ខជន បម្រុង ក្រុមប្រឹក្សា ខណ្ឌ ៧មករា ឲ្យ គណបក្ស ឆន្ទៈ ខ្មែរ ដោយ គ្មាន ការអនុញ្ញាត ពី សាម៉ីខ្លួន ) ប្រព្រឹត្ត នៅ រាជធានី ភ្នំពេញ កាលពី ថ្ង ១៣ ខែមីនា ឆ្នាំ ២០២៤ ។
បច្ចុប្បន្ន សមត្ថកិច្ច កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម និតិវិធី ច្បាប់ ៕
ក្រុម អ្នកចរចា ត្រូវបាន រំពឹង ថា នឹង ជួបជុំគ្នា ជាថ្មី ក្នុង ទីក្រុង គែរ ខណៈ សង្រ្គាម អ៉ី ស្រាអែល និង ហាម៉ាស ជិត ដល់ ខួប កន្លះ ឆ្នាំ
( ហ្កាហ្សា ) ៖ ក្រុម អ្នកចរចា អាមេរិក និង អ៉ី ស្រាអែល ត្រូវបាន រំពឹង ថា នឹង មាន វត្តមាន ក្នុង ទីក្រុង គែរ ប្រទេស អេហ្ស៉ីប នៅ ចុង សប្ដាហ៍ នេះ ដើម្បី សាកល្បង ជំរុញ ជាថ្មី ឱ្យ មាន បទ ឈប់ បាញ់ មួយ ជា ថ្នូរ នឹង ការដោះលែង ចំណាប់ខ្មាំង នៅក្នុង សង្រ្គាម រវាង អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស ក្នុង តំបន់ ហ្កាហ្សា ដែល អូសបន្លាយ ពេល ជិត កន្លះ ឆ្នាំ មក នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសៅរ៍ ទី៦ ខែមេសា ឆ្នាំ ២០២៤ ។
នៅ មុន ជំនួប កើតឡើង ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន បាន ផ្ញើ លិខិត ទៅកាន់ មេដឹកនាំ នៃ ប្រទេស អេហ្ស៉ី ប និង កាតា ជាមួយ ការជំរុញ ឱ្យ ពួកគេ ដាក់ សម្ពាធ លើ ក្រុមហា ម៉ាស ឱ្យ ទទួលយក បទ ឈប់ បាញ់ ។ សហរដ្ឋ អាមេរិក កាតា និង អេហ្ស៉ី ប បាន ស្វះស្វែងរក បទ ឈប់ បាញ់ និង ការដោះលែង ចំណាប់ខ្មាំង អស់ រយៈពេល ជាច្រើន ខែ មក ហើយ ប៉ុន្តែ មិន ទាន់ សម្រេចបាន លទ្ធផល ជា ដុំកំភួន នោះ ទេ ចាប់តាំងពី មាន បទ ឈប់ បាញ់ រយៈពេល មួយ សប្ដាហ៍ កាលពី ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
គួរ បញ្ជាក់ ថា អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស បាន ចោទប្រកាន់ និង ទម្លាក់ កំហុស ដាក់ គ្នា ទៅ វិញ ទៅ មក ជុំវិញ ការខ្វះ ភាពរីកចម្រើន ក្នុង កិច្ចចរចា ដោយ ក្នុង នោះ ហាម៉ាស នៅតែ ប្រកាន់ ជំហរ ទាមទារ ឱ្យ អ៉ី ស្រាអែល ដក កងទ័ព ចេញពី តំបន់ ហ្កាហ្សា ៕
ក្រសួង បរិស្ថាន បំពាក់ ឧបករណ៍ ពិនិត្យ គុណភាព ខ្យល់ ចំនួន ១២ទីតាំង បន្ថែម ទៀត នៅ តាម ខេត្ត មួយចំនួន
( ភ្នំពេញ ) ៖ លោក ខ្វៃ អាទិត្យា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២៤ នេះ ថា ក្រសួង បាន បំពាក់ បំពាក់ ឧបករណ៍ ពិនិត្យ គុណភាព ខ្យល់ ចំនួន ១២ទីតាំង បន្ថែម ទៀត នៅ តាម បណ្តា ខេត្ត មួយចំនួន ដើម្បី ពង្រឹង ការតាមដាន គុណភាព ខ្យល់ នៅក្នុង ប្រទេស កម្ពុជា ។
លោក ខ្វៃ អាទិត្យា បាន បញ្ជាក់ ថា ឧបករណ៍ ថ្មី ចំនួន ១២ មាន ទីតាំង ស្ថិត នៅ ទីតាំង រួម មាន៖
ក្នុង ឱកាស នោះ ជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត បាន លើក ទ្បើង ថា ការរៀបចំ កម្មវិធី សប្បុរសធម៌ នេះ គឺ ដើម្បី ចែករំលែក សេចក្តីស្រលាញ់ របស់ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា នៃ សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា ដល់ សមាជិក មូលនិធិ ត្រី ចក្រ យាន កម្ពុជា ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល នឹង ខិត ដល់ នា ពេល ឆាប់ ៗ ខាងមុខ នេះ និង ជា ការចូលរួម លើកកម្ពស់ សកម្មភាព សប្បុរសធម៌ នៅក្នុង សង្គម កម្ពុជា ផងដែរ ។
សូម បញ្ជាក់ ថា មូលនិធិ ត្រី ចក្រ យាន កម្ពុជា ត្រូវបាន បង្កើតឡើង នា ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០១៨ ជា គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា សំដៅ អភិរក្ស ត្រី ចក្រ យាន ( ស៊ី ក្លូ ) ដែល មាន ដើមកំណើត តាំងពី ឆ្នាំ ១៩៣៦មក ម្ល៉េះ ។
សមាជិក មូលនិធិ ត្រី ចក្រ យាន កម្ពុជា ទាំង ២៩៦ នាក់ ទទួលបាន ប្រាក់ខែ ទៀងទាត់ ដោយ ក្នុង មួយ ខែ ពួកគាត់ អាច បើក បាន ចំនួន ៣ដង ដើម្បី ជួយ សម្រួល ការលំបាក ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ។
( ភ្នំពេញ ) ៖ បុគ្គល ម្នាក់ ឈ្មោះ កើត សារ៉ាយ ត្រូវបាន កម្លាំង ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ចាប់ខ្លួន នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៤ នេះ ក្រោយពី បុគ្គល ម្នាក់ នេះ មាន ចេតនា អាក្រក់ ដើរ ញុះញង់ ឲ្យ ប្រជាពលរដ្ឋ នៅក្នុង ទឹកដី ខេត្ត ព្រះវិហារ ភ័យខ្លាច គោលបំណង ដើម្បី គេង ចំណេញ នយោបាយ បង្កឲ្យ មាន ការភាន់ច្រឡំ ថា អាជ្ញាធរ គៀប សង្កត់ ប្រជាពលរដ្ឋ ។
ក្រៅពី មាន ចេតនា ទុច្ចរិត បំផ្លាញ សន្តិភាព បុគ្គល នេះ និង បក្សពួក ក៏ បាន ដើរ ប្រឌិត ព័ត៌មាន ក្លែងក្លាយ ហើយ ផ្ដល់ បទសម្ភាស ដល់ សារព័ត៌មាន នៅ ក្រៅ ស្រុក ក្នុង ចេទនា ញុះញង់ បង្ក ចលាច ល ពាក់ព័ន្ធ ករណី ដីធ្លី នៅ ខេត្ត ព្រះវិហារ ។ ដូច្នេះ ដើម្បី ជា ទប់ស្កាត់ នូវ អំពើ បង្ក ភាពចលាចល នៅក្នុង ឱកាស ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ តុលាការ បាន សម្រេច ចេញ ដីកា ឃាត់ខ្លួន ជន នេះ ដើម្បី ការទប់ស្កាត់ នូវ ការ បង្ក អស្ថេរភាព និង បង្ក ការរំខាន ដល់ ប្រជាពលរដ្ឋ និង អាជ្ញាធរ ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News លោក វរសេនីយ៍ សំ វិច្ឆិកា អ្នកនាំពាក្យ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា ការចាប់ខ្លួន បុគ្គល ឈ្មោះ កើត សារ៉ាយ នេះ ធ្វើឡើង តាម ដីកា បញ្ជា ឲ្យ ចូល ខ្លួន របស់ លោក សេង ហៀង ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ពី បទ « ញុះញង់ បង្កឲ្យ មាន ភាពវឹកវរ ធ្ងន់ធ្ងរ ដល់ សន្ដិសុខ សង្គម » ។
បើ តាម អ្នកនាំពាក្យ . បុគ្គល រូប នេះ ធ្លាប់ ត្រូវបាន ចាប់ខ្លួន និង ជាប់ ពន្ធនាគារ ម្ដង រួច មកហើយ ពី បទ « ញុះញង់ បង្កឲ្យ មាន ភាពវឹកវរ ធ្ងន់ធ្ងរ ដល់ សន្ដិសុខ សង្គម » ដូចគ្នា នេះ ។ ប៉ុន្ដែ បុគ្គល នេះ មិន រៀង ចាល នោះ ឡេីយ ។
ពោល កាលពី ពេល កន្លងទៅ ថ្មី ៗ នេះ បុគ្គល ឈ្មោះ កើត សារ៉ាយ បាន ប្រឌិត នូវ ព័ត៌មាន ក្លែងក្លាយ ពាក់ព័ន្ធ បញ្ហា វិវាទ ដីធ្លី នៅ ខេត្ត ព្រះវិហារ ដេីម្បី ផ្ដល់ បទសម្ភាស ដល់ សារព័ត៌មាន នៅ ក្រៅ ស្រុក ក្នុង គោលបំណង ញុះញង់ បង្កឲ្យ មាន ការរេីស អេីង និង ធ្វេី ឲ្យ ការខឹងសម្បារ មកដល់ រាជ រដ្ឋាភិបាល ពិសេស ទៅកាន់ ឆាក អន្ដរជាតិ ។
លោក វរសេនីយ៍ ឯក សំ វិច្ឆិកា បាន បញ្ជាក់ បែប នេះ ថា « យើង អាច សន្និដ្ឋាន បាន ថា ឈ្មោះ កើត សារ៉ាយ គឺ ពិតជា មាន ចេតនា ញុះញង់ ឲ្យ ប្រជាពលរដ្ឋ មាន ការខឹងសម្បាញ នឹង រាជ រដ្ឋាភិបាល ហើយ បុគ្គល នោះ ថែមទាំង បាន ផ្តល់ ព័ត៌មាន ដល់ សារព័ត៌មាន ឧទ្ទាម មាន VOD និង RFA ចេញផ្សាយ បំភ្លៃ ព័ត៌មាន មិន ពិត និង ប្រឌិត ព័ត៌មាន ដើម្បី បង្ហាញ ឲ្យ ក្រៅ ប្រទេស បាន ឃើញ និង ដាក់ទណ្ឌកម្ម មក លើ កម្ពុជា » ។
សូម ជម្រាប ថា ក្រោយ ការចាប់ខ្លួន ជនសង្ស័យ រូប នេះ ត្រូវបាន បញ្ជូន ទៅកាន់ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការបន្ដ តាម នីតិវិធី ៕
កងរាជអាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ បញ្ជូន ជនសង្ស័យ ម្នាក់ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី រំលោភ លើ ទំនុកចិត្ត
( បន្ទាយមានជ័យ )៖ កាលពី ថ្ងៃទី៤ ខែមេសា ឆ្នាំ ២០២៤ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ប៉ោយប៉ែត បាន ឃាត់ ស្រ្តី ម្នាក់ ឈ្មោះ វិន សុភក្ត្រា អាយុ ៣៧ ឆ្នាំ បច្ចុប្បន្ន ស្នាក់ នៅ បណ្តោះអាសន្ន ភូមិ ក្បាល ស្ពាន ១ សង្កាត់ អូរ ជ្រៅ ក្រុង ប៉ោយប៉ែត ពាក់ព័ន្ធ ករណី រំលោភ លើ ទំនុកចិត្ត ដែល ប្រព្រឹត្ត កាលពី អំឡុង ឆ្នាំ ២០២០ រហូតដល់ ខែធ្នូ ឆ្នាំ ២០២៣ ។
ករណី នេះ ធ្វើឡើង តាម ពាក្យបណ្ដឹង របស់ ជនរងគ្រោះ ២នាក់ រួម មាន៖ ឈ្មោះ ងួន ប៊ុន រី ភេទ ប្រុស អាយុ ៣៩ ឆ្នាំ ទីលំនៅ បច្ចុប្បន្ន ភូមិ គីឡូម៉ែត្រ លេខ ៤ សង្កាត់ ផ្សារ កណ្តាល និង ឈ្មោះ ខេង សេង ថៃ ភេទ ប្រុស អាយុ ៣៨ ឆ្នាំ ទីលំនៅ បច្ចុប្បន្ន ភូមិ គីឡូម៉ែត្រ លេខ ៤ សង្កាត់ ផ្សារ កណ្តាល ។
ជនសង្ស័យ បាន លួច យក ប្រាក់ ថ្លៃ ឈ្នួល ផ្ទះ មួយចំនួន ទៀត មិន បាន បាញ់ ចូល គណនេយ្យ របស់ ក្រុមហ៊ុន ឡើយ ក្រោយមក ខាងក្រុមហ៊ុន ដី ឡូតិ៍ បាន ហៅ ជនសង្ស័យ មក ទូរទាត់ ប្រាក់ តែ ជនសង្ស័យ បាន និយាយ ថា ប្រាក់ ទាំងអស់ នោះ បាន យក ទៅ ប្រើប្រាស់ រកស៊ី ផ្ទាល់ខ្លួន និង លេង ល្បែង អស់ ហើយ ។
ក្រោយពី ទទួលបាន របាយការណ៍ សុំ បើក ការស៊ើបអង្កេត បឋម របស់ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ប៉ោយប៉ែត រួច នៅ ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២៤ ការិយាល័យ ជំនាញ បាន ធ្វើ របាយការណ៍ សុំ បើក ការស៊ើបអង្កេត បឋម ទៅ អយ្យការ អម សាលាដំបូង ខេត្ត បន្ទាយមានជ័យ តាម នីតិវិធី ដោយ ទទួលបាន ដីកា សម្រេច ឱ្យ បើក ការស៊ើបអង្កេត បឋម របស់ លោក កើត វណ្ណារ៉េត ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត បន្ទាយមានជ័យ ។
លោក វរសេនីយ៍ ត្រី នួន នីណារ៉ូ បន្ត ថា ក្រោយពី ទទួលបាន ដីកា សម្រេច ឱ្យ បើក ការស៊ើបអង្កេត បឋម ការិយាល័យ ជំនាញ បាន បញ្ជូន ដីកា ទៅ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ប៉ោយប៉ែត ដើម្បី ចំណាត់ការ តាម នីតិវិធី រហូតដល់ វេលា ម៉ោង ១៤ និង ០០ នាទី ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២៤ ដើម បណ្តឹង ខាងលើ បាន នាំ ឈ្មោះ វិន សុភក្ត្រា ( ជនសង្ស័យ ) មកកាន់ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ប៉ោយប៉ែត ដើម្បី សួរនាំ ពាក់ព័ន្ធ ករណី រឿង ហេតុ ហើយ ធ្វើ ការឃាត់ខ្លួន តែម្ដង ។
ក្រោយ ឃាត់ខ្លួន . ជនសង្ស័យ បាន ឆ្លើយ សារភាព ថា រូប ខ្លួន ពិតជា បាន យក ប្រាក់ របស់ ក្រុមហ៊ុន ពិតប្រាកដ មែន ។ ដោយ ផ្អែក លើ ចម្លើយ សារភាព កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង បាន កសាង សំណុំរឿង បញ្ជូន មកកាន់ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត ចាត់ការ បន្ត តាម នីតិវិធី ។
លោក វរសេនីយ៍ ឯក ម៉ែន ភិរម្យ មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខេត្ត ទទួល ការងារ ស្រាវជ្រាវ និង បង្ក្រាប បទល្មើស បាន ឱ្យដឹង ថា ការឃាត់ នេះ ក៏ ទទួលបាន បញ្ជា ពី លោក ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត និង មាន ការសម្របសម្រួល នីតិវិធី ពី លោក កើត វណ្ណារ៉េត ។
បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ ខេត្ត បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ហើយ នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ០៦ ខែមេសា ឆ្នាំ ២០២៤ ដើម្បី អនុវត្ត តាម នីតិវិធី ៕ លោក ជា សុផារ៉ា អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង ប្រធាន គណបក្ស ប្រជាជន ខេត្ត ត្បូងឃ្មុំ ថ្មី . លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ ជំនួស លោក ស៊ាក ឡេង ជាប់ ជា សមាជិក ព្រឹទ្ធសភា
( ត្បូងឃ្មុំ ) ៖ លោក ជា សុផារ៉ា សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ មូលដ្ឋាន ខេត្ត ត្បូងឃ្មុំ តំណាង សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស នៅ ព្រឹក ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២៤ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ប្រកាស ទទួលស្គាល់ ចូលកាន់ តំណែង លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ត្បូងឃ្មុំ ជំនួស លោក ស៊ាក ឡេង ជាប់ ជា សមាជិក ព្រឹទ្ធសភា នៃ កម្ពុជា ។
ក្នុង ឱកាស នោះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន អញ្ជើញ ទទួល សេចក្តីប្រកាស និង ត្រា ព្រមទាំង ឡើង ធ្វើ ការប្តេជ្ញាចិត្ត គោរព អនុវត្តន៍ តាម បទបញ្ជា លក្ខន្តិកៈ គណបក្ស និង អនុសាសន៍ ណែនាំ របស់ ថ្នាក់ដឹកនាំ គណបក្ស រក្សា សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង បក្ស ឲ្យ រឹងមាំ ជាពិសេស បន្ត ដឹកនាំ ការងារ គណបក្ស ធ្វើ យ៉ាងណា ឲ្យ គណបក្ស ប្រជាជន បន្ត ឈ្នះ ឆ្នោត គ្រប់ ៗ អាណត្តិ ។
លោក ជា សុផារ៉ា បាន ថ្លែង ថា គណបក្ស ប្រជាជន កម្ពុជា ក្រោម គោល នយោបាយ នៃ មាគ៌ា ដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា រួម នឹង ថ្នាក់ដឹកនាំ កំពូល ៗ របស់ គណបក្ស បាន ធ្វើឲ្យ គណបក្ស ប្រជាជន កម្ពុជា ក្លាយជា គណបក្ស ដែល ធំ ជាង គេ និង មាន ប្រជាប្រិយភាព ព្រមទាំង មាន ការគាំទ្រ ដ៏ ច្រើន លើសលប់ ពីសំណាក់ ប្រជាពលរដ្ឋ ។
កញ្ចប់ ជំនួយ ហិរញ្ញប្បទាន សហគ្រិន ខ្មែរ ត្រូវបាន ប្រគល់ ឱ្យ ធុរកិច្ច ថ្មី និង សហគ្រាស ធុន តូច និង មធ្យម ចំនួន ៣៨ សម្រាប់ យក ទៅ ស្តារ និង ពង្រីក អាជីវកម្ម
( ភ្នំពេញ ) ៖ ធុរកិច្ច ថ្មី និង សហគ្រាស ធុន តូច និង មធ្យម ចំនួន ៣៨ ត្រូវបាន សហគ្រិន ខ្មែរ សម្រាំង និង ជ្រើសរើស ផ្តល់ កញ្ចប់ ជំនួយ សហគ្រិន ខ្មែរ ដើម្បី ជួយ គាំទ្រ សហគ្រាស ធុន តូច និង មធ្យម ទាំងនោះ ស្តារ អាជីវកម្ម និង ការរក្សា លំនឹង ក្នុង ការចាប់ យក ឱកាស ថ្មី ដើម្បី ពង្រីក អាជីវកម្ម ទៅតាម វិស័យ រៀង ៗ ខ្លួន ។
ពិធី ប្រគល់ កញ្ចប់ ជំនួយ ហិរញ្ញប្បទាន ដល់ ធុរកិច្ច ថ្មី និង សហគ្រាស ធុន តូច និង មធ្យម ក្នុង ន័យ គាំទ្រ សហគ្រាស ស្ដារ លទ្ធភាព . ពង្រឹង ប្រតិបត្ដិការ អាជីវកម្ម និង បង្កើន សក្ដានុពល នាំចេញ បាន រៀបចំឡើង កាលពី ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២៤ នៅ អគារមជ្ឍ មណ្ឌល អភិវឌ្ឍ ធុរកិច្ច ក្រោម អធិបតីភាព លោក ហែម វណ្ណឌី រដ្ឋមន្រ្តី ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ និង ជា ប្រធាន ក្រុមប្រឹក្សា បរធន បាល នៃ សហគ្រិន ខ្មែរ ។
រាជ រដ្ឋាភិបាល កម្ពុជា បើក ផ្លូវ ឱ្យ ក្រុមហ៊ុន SCA អាច ដើរ តួនាទី ជា ប្រតិបត្តិករ នៃ អាកាសយានដ្ឋាន អន្តរជាតិ តេជោ ពេល ដាក់ ឱ្យ ដំណើរការ
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បើក ភ្លើង ខៀវ ឱ្យ ក្រុមហ៊ុន SCA ដែល កំពុង ប្រតិបត្តិការ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ បច្ចុប្បន្ន អាច ដើរ តួនាទី ជា ប្រតិបត្តិករ នៃ អាកាសយានដ្ឋាន អន្តរជាតិ តេជោ ពេល ចាប់ផ្តើម ដាក់ ឱ្យ ដំណើរការ បន្ទាប់ពី បិទ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ។
ការប្រគល់ សិទ្ធិ នេះ ធ្វើឡើង បន្ទាប់ពី រដ្ឋលេខាធិការដ្ឋាន អាកាសចរណ៍ ស៊ីវិល បាន ចុះ កិច្ចព្រមព្រៀង ជាមួយ ក្រុមហ៊ុន សូស៊ី យេ តេ កុង សេស្យូនែរ ដឺ ឡា អេរ៉ូព័រ ( ហៅ កាត់ SCA) ស្តីពី គោលការណ៍ សម្រាប់ ការស្តារ សម តុល្យ ហិរញ្ញវត្ថុ នៃ កិច្ចព្រមព្រៀង សម្បទាន រវាង រាជ រដ្ឋាភិបាល កម្ពុជា និង ក្រុមហ៊ុន សូស៊ី យេ តេ កុង សេស្យូនែរ ដឺ ឡា អេរ៉ូព័រ នា ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២៤ ។
ថ្លែង ក្នុង ពិធី ចុះ កិច្ចព្រមព្រៀង នេះ លោក បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្រ្តី ទទួលបន្ទុក រដ្ឋលេខាធិការដ្ឋាន អាកាសចរណ៍ ស៊ីវិល មានប្រសាសន៍ ថា បន្ទាប់ពី ការចុះ កិច្ច ព្រៀង ព្រៀង នេះ រាជ រដ្ឋាភិបាល នឹង ប្រគល់ ឱ្យ ក្រុមហ៊ុន SCA ដើរ តួនាទី ជា ប្រតិបត្តិករ នៃ អាកាសយានដ្ឋាន អន្តរជាតិ តេជោ ពេល ចាប់ផ្តើម ដាក់ ឱ្យ ដំណើរការ ។ ជា មួួយ គ្នា នេះ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ នឹង បន្ថែម រយៈពេល ឱ្យ ក្រុមហ៊ុន SCA ធ្វើ ការអភិវឌ្ឍ និង ពង្រឹង សមត្ថភាព អាកាសយានដ្ឋាន អន្តរជាតិ ខេត្ត ព្រះសីហនុ ។
សូម ជម្រាប ថា កាលពី ឆ្នាំ ១៩៩៥ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ផ្តល់ ការវិនិយោគ ឱ្យ ក្រុមហ៊ុន SCA អភិវឌ្ឍន៍ សាងសង់ និង គ្រប់គ្រង ប្រតិបត្តិការ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ និង នៅ ឆ្នាំ ២០០៦ រាជ រដ្ឋាភិបាល បាន ផ្ដល់ ការវិនិយោគ ឱ្យ ក្រុមហ៊ុន បារាំង នេះ ធ្វើ ការអភិវឌ្ឍ សាងសង់ និង គ្រប់គ្រង ប្រតិបត្តិការ អាកាសយាន ដ្ឋាន អន្តរជាតិ ខេត្ត ព្រះសីហនុ លំដាប់ថ្នាក់ 4E លើ ផ្ទៃដី ទំហំ ៦៨២ ហិកតា ៕
