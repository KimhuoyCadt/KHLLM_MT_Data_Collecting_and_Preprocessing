( កំពង់ធំ )៖ លោក សួស យ៉ារ៉ា អ្នកតំណាងរាស្ត្រ មណ្ឌល ខេត្ត កំពង់ធំ និង ជា ប្រធាន កិត្តិយស ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កំពង់ស្វាយ បាន ចាត់ ក្រុមការងារ អ្នកតំណាងរាស្រ្ត មក ប្រគល់ រថយន្ត ពន្លត់ អគ្គិភ័យ ១គ្រឿង ដល់ រដ្ឋបាល ស្រុក កំពង់ស្វាយ នៅ ថ្ងៃទី ០៤ ខែ ឧសភា ឆ្នាំ ២០២៤ ដើម្បី ប្រើប្រាស់ បម្រើ ជូន បងប្អូន ប្រជាពលរដ្ឋ ដែល កំពុង ជួបប្រទះ នូវ ការខ្វាត ទឹក ប្រើប្រាស់ និង ដើម្បី បង្ការ គ្រោះ អគ្គិភ័យ ជា យថាហេតុ ។
លោក អ៊ុត វណ្ណរ៉ា អភិបាល ស្រុក កំពង់ស្វាយ បាន ថ្លែងអំណរគុណ ដល់ លោក សួស យ៉ារ៉ា និង ភរិយា ដែល ជានិច្ចកាល លោក តែងតែ យកចិត្តទុកដាក់ ពី ទុក្ខ កង្វល់ របស់ ប្រជាជន នៅ ថ្នាក់ មូលដ្ឋាន ក្នុង នាម លោក ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ស្រុក លោក នឹង ចាត់ចែង រថយន្ត នេះ ប្រើប្រាស់ ត្រៀម បង្ការ សង្រ្គោះ បន្ទាន់ ពេល មាន គ្រោះមហន្តរាយ អគ្គិភ័យ ឬ គ្រោះ រាំងស្ងួត ជួយ អន្តរាគមន៍ និង ដោះស្រាយ ជូន បងប្អូន ប្រជាពលរដ្ឋ ឲ្យបាន ទាន់ ពេល វេលា ។
លោក សូម ជូនពរ អ្នកតំណាងរាស្រ្ត និង លោកស្រី ព្រមទាំង ក្រុមគ្រួសារ សូម មាន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង មាំ មួន ដើម្បី រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្រ្តី ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ លើ គ្រប់ វិស័យ ៕ ប្រកាស ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន សង្កាត់ ទាំង៨ នៃ ក្រុង ស្ទឹង សែន ខេត្ត កំពង់ធំ ជាង ៥០០ នាក់
( កំពង់ធំ )៖ លោក អេង ទូច សមាជិក គណៈកម្មការធិការ កណ្តាល . អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ និង ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង ស្ទឹង សែន បាន អញ្ជើញ ប្រកាស សមាសភាព ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន សង្កាត់ ទាំង៨ នៃ ក្រុង ស្ទឹង សែន ខេត្ត កំពង់ធំ ដែល ចំនួន សរុប ជាង ៥០០ នាក់ នៅ ទីស្នាក់ការ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ក្រុង ស្ទឹង សែន កាលពី ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២៤ ។
នៅក្នុង ឱកាស នោះ ដែរ លោក អេង ទូច បាន សំដែង នូវ ការអបអរសាទរ ចំពោះ សមាសភាព ទាំង ជាង ៥០០ នាក់ ដែល ត្រូវបាន គណបក្ស ផ្តល់ សេចក្តីទុកចិត្ត ចាត់តាំង ជា ប្រធាន . អនុប្រធាន និង ជា សមាជិក សមាជិកា ក្នុង ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន សង្កាត់ ទាំង៨ នៃ ក្រុង ស្ទឹង សែន ខេត្ត កំពង់ធំ ។
លោក បាន បន្ត ថា ដូចនេះ ដើម្បី តបស្នង ចំពោះ ទំនុកចិត្ត ដែល គណបក្ស បាន ប្រគល់ ជូន . ក្រុមការងារ ត្រូវ ខិតខំ ប្រតិបត្តិ នូវ តួនាទី និង ភារកិច្ច ដែល គណបក្ស បាន ប្រគល់ ជូន ពិសេស ការបម្រើ ប្រជាជន ប្រកបដោយ ភាពស្មោះត្រង់ និង មាន គុណភាព និង ប្រសិទ្ធភាព ខ្ពស់ ជាមួយនឹង ការប្តេជ្ញាចិត្ត មុតមាំ . ហ៊ាន លះបង់ និង ផ្អែក លើ ទង្វើ ជាក់ស្តែង ។ លោក អេង ទូច បាន សង្កត់ធ្ងន់ ថា គ្មាន បេសកកម្ម ណា ដែល ពិសិដ្ឋ ថ្លៃថ្លា ជាង ការបម្រើ ប្រជាជនន ទេ ! ។
លោក អេង ទូច បាន បន្ត លើកឡើង ផងដែរ អំពី តួនាទី និង ភារកិច្ច សំខាន់ ៗ របស់ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ជាពិសេស ការគាំទ្រ និង ចូលរួម ជាមួយ អង្គការ ចាត់តាំង គណបក្ស នៅ មូលដ្ឋាន ដើម្បី ពង្រឹង អង្គការ ចាត់តាំង គណបក្ស នៅ មូលដ្ឋាន ទាំង វិស័យ នយោបាយ សតិអារម្មណ៍ ចាត់តាំង និង ហិរញ្ញវត្ថុ និង ធ្វើជា ស្នូល នៃ សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង របស់ គណបក្ស និង ធ្វើជា គំរូ ដល សមាជិក និង អ្នកគាំទ្រ ក៏ ដូចជា មហាជន ទូទៅ ។
លោក អេង ទូច បាន ផ្តល់ ការណែនាំ ដល់ ក្រុមការងារ ត្រូវ តៀម លក្ខណៈ ឱ្យ បាន ល្អ ពិសេស ការអនុវត្ត ផែនការ សកម្មភាព នៅក្នុង យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ខេត្ត . ក្រុមប្រឹក្សា ក្រុង និង ក្រុមប្រឹក្សា ស្រុក អាណត្តិ ទី៤ ឆ្នាំ ២០២៤ ដើម្បី ដណ្តើម ជ័យជម្នះ ជូន គណបក្ស ឱ្យ បាន ច្រើន លើសលុប ។
លោក អេង ទូច បាន បន្ត ថា យើង ត្រូវ ធ្វើ កិច្ចការ នេះ ឱ្យ ដូច ភ្លៀង រលឹម និង ឱ្យ បាន ម៉ត ចត់ បំផុត ដើម្បី រួមគ្នា សម្រេច ឱ្យ បាន នូវ ចក្ខុវិស័យ និង ទិសដៅ ការងារ របស់ លោក វង្សី វិស្សុត សមាជិក គណៈ អចិន្រ្តៃយ៍ គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ ក្នុង ការធ្វើឱ្យ ខេត្ត កំពង់ធំ ក្លាយទៅជា មូលដ្ឋាន គាំទ្រ ដ៏ រឹងមាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ៕
( ភ្នំពេញ ) ៖ មន្រ្តី ជាន់ ខ្ពស់ នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន លើកទឹកចិត្ត ឱ្យ កសិករ ដែល មាន ដី តូច ៗ ហើយ ចង់ ធ្វើ កសិកម្ម បែប ពាណិជ្ជកម្ម គួរ ចង គ្នា ជា សហគមន៍ ប្រើប្រាស់ ដី ជា ផលិតកម្ម រួម ប្រមូលផ្តុំ គ្នា រក ប្រព័ន្ធ គ្រប់គ្រង រួម ដើម្បី ជំរុញ ឱ្យ ការធ្វើ កសិកម្ម របស់ ខ្លួន ទទួលបាន ប្រាក់ ចំណញ ច្រើន ដូច អ្នក ដែល មាន ដី ធំ ៗ ដែរ ។
លោក ឃឹម ហ្វីណង់ អនុ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ នៃ ក្រសួង កសិកម្ម បាន ឱ្យដឹង ថា បច្ចុប្បន្ន នេះ កសិករ នៅ កម្ពុជា ប្រមាណ ២លាន គ្រួសារ ដែល មាន ដី កសិកម្ម ប្រមាណ ១ហិកតា ក្នុង គ្រួសារ ។ ប្រសិនបើ កសិករ ក្នុង មួយ គ្រួសារ មាន ដី ត្រឹម មួយ ហិកតា ហើយ ចង់ ធ្វើ កសិកម្ម លក្ខណៈ ពាណិជ្ជកម្ម ឱ្យ ទទួលបាន ប្រាក់ ចំណេញ ច្រើន នឹង ពិបាក ធ្វើ ទៅ រួច និង ពិបាក ក្នុង ការប្រកួតប្រជែង នៅក្នុង ទីផ្សារ ព្រោះ ថ្លៃ ដើម ផលិត ខ្ពស់ ។
តែ យ៉ាងណាមិញ លោក លើកឡើង ថា ក្រុម កសិករ តូច ៗ ទាំងនេះ នឹង អាច ធ្វើ កសិកម្ម ដោយ ប្រើ ថ្លៃ ដើម ទាប និង មាន លទ្ធភាព ទទួលបាន ប្រាក់ ចំណញ ច្រើន ដូច អ្នក ដែល មាន ដី ធំ ៗ ធ្វើ លក្ខណៈ ពាណិជ្ជកម្ម ដែរ តាមរយៈ ការចងក្រង គ្នា ជា សហគមន៍ កសិកម្ម ។ ហេតុ នេះ ហើយ ទើប ក្រសួង លើកទឹកចិត្ត ឱ្យ កសិករ ដែល មាន ដី តូច ៗ លក្ខណៈ គ្រួសារ ចងក្រង គ្នា ជា សហគមន៍ កសិកម្ម ទំនើប ។
លោក បាន ពន្យល់ បន្ថែម ទៀត ថា កសិករ ខ្នាត តូច គ្រាន់តែ ផ្លាស់ប្តូរ ពី ការធ្វើ កសិកម្ម ជា លក្ខណៈ គ្រួសារ មក ជា ធ្វើ ប្រមូលផ្តុំ គ្នា នោះ ថ្លៃ ដើម គាត់ នឹង ធ្លាក់ចុះ ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ៨នាក់ ស្លាប់ និង អ្នករបួស ៦នាក់ ។
ក្រុម អ្នកចរចា របស់ ហាម៉ាស ទៅដល់ អេហ្ស៉ី ប សម្រាប់ កិច្ចពិភាក្សា បទ ឈប់ បាញ់ នៅ តំបន់ ហ្គាហ្សា
( គែរ ) ៖ ក្រុម អ្នកចរចា របស់ ហាម៉ាស បាន ទៅដល់ ទីក្រុង គែរ ប្រទេស អេហ្ស៉ីប ហើយ នៅ ថ្ងៃសៅរ៍ នេះ សម្រាប់ កិច្ចពិភាក្សា លើ បទ ឈប់ បាញ់ នៅ តំបន់ ហ្គាហ្សា ដែល អាច នាំឱ្យ មាន ការ វិល ត្រលប់ នៃ ចំណាប់ខ្មាំង ទៅកាន់ អ៉ី ស្រាអែល វិញ ដោយ មន្ត្រី ហាម៉ាស់ ម្នាក់ និយាយ ថា លោក នាយក
ទូរទស្សន៍ អេហ្ស៉ី ប ក៏ បាន រាយការណ៍ អំពី ការមកដល់ នៃ គណៈប្រតិភូហា ម៉ាស នៅ ទីក្រុង គែរ ផងដែរ ។ សន្តិសុខ អេហ្ស៉ី ប ម្នាក់ បាន ប្រាប់ Reuters ថា លទ្ធផល នៅ ថ្ងៃ នេះ អាចនឹង ខុសពី រាល់ ដង ដោយ មាន ការ ឈាន ដល់ កិច្ចព្រមព្រៀង មួយ លើ ចំណុច ជាច្រើន ។ ចំណែក មន្រ្តី ប៉ាឡេ ស្ទីន មួយ រូប បាន និយាយ ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ ថា អ្វី ៗ មើល ទៅ ប្រសើរ ជាង មុន ប៉ុន្តែ កិច្ចព្រមព្រៀង មួយ អាច កើតឡើង ឬ អត់ អាស្រ័យ លើ អ៉ី ស្រាអែល អាច ផ្តល់ អ្វី បាន ខ្លះ ដើម្បី ជា ផ្នែក នៃ ការសម្រេចបាន ។
( ភ្នំពេញ ) ៖ យោង តាម វីដេអូ កាមេរ៉ា សុវត្ថិភាព ដែល បែកធ្លាយ បាន បង្ហាញ នៅ ថ្ងៃ កើត ហេតុ ឱ្យដឹង ថា លោក វរសេនីយ៍ ត្រី ផាត ផានណូ ដែល ត្រូវ បណ្តេញ ចេញ ពី ក្របខណ្ឌ ពុំ បាន បាញ់ ការពារ ខ្លួន នោះ ទេ ប៉ុន្តែ ជា ការធ្វើ សកម្មភាព បាញ់បោះ សេរី ។ ជាមួយគ្នា នេះ លោក ក៏ ត្រូវបាន សមត្ថកិច្ច រកឃើញ ថា មាន សារធាតុ ញៀន នៅក្នុង ខ្លួន និង ប្រើប្រាស់ អាវុធ ខុស ច្បាប់ ថែម ទៀត ។
