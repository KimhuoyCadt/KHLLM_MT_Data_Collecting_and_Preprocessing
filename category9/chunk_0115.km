( ភ្នំពេញ ) ៖ កុមារ ក្រីក្រ និង កុមារ ដែល ធ្លាប់ រស់ នៅ លើ គំនរ សំរាម នៅ ស្ទឹងមានជ័យ ជាង ១ពាន់ នាក់ ដែល បច្ចុប្បន្ន បាន មក ជ្រក ដំបូល របស់ អង្គការ លើកស្ទួយ ប្រជាពលដ្ឋ ដែល ស្ថិត នៅ ភូមិ ដំណាក់ ធំ១ សង្កាត់ ស្ទឹងមានជ័យ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ គឺ នៅតែ បន្ដ ទទួលបាន ការយកចិត្ដទុកដាក់ ខ្ពស់ ពី សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ។
ដោយ នៅ ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២៤ នេះ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ចាត់ លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា ដឹកនាំ សហការី ចុះ សំណេះសំណាល សួរសុខទុក្ខ ផ្ដល់ ជា អំណោយ នូវ គ្រឿង ឧបភោគ បរិភោគ ជាពិសេស បាន រៀបចំ ម្ហូប អាហារ ដ៏ ឈ្ងុយ ឆ្ងាញ់ ពិសា ភ្ជាប់ ជាមួយនឹង ក្ដី ស្រលាញ់ យ៉ាង កក់ក្ដៅ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ ខ្មែរ ជិត ឈាង មកដល់ នៅ ជាង មួយ សប្ដាហ៍ ទៀត នេះ ។
ក្នុង ឱកាស សំណេះសំណាល នេះ ផងដែរ លោកស្រី ម៉ែន នារី សោភ័គ បាន ពាំនាំ ការផ្ដាំផ្ញើ សួរសុខទុក្ខ ក្ដី អាណិត ស្រលាញ់ ដោយ មិន រំលង ពី សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ទោះ មាតា មនុស្សធម៌ មិន បាន អញ្ជើញ ដោយ ផ្ទាល់ តែ បេះដូង ហាក់ ឋិត មិន ឆ្ងាយ ស្រលាញ់ បារម្ដ គ្រប់ ពេលវេលា សួរនាំ និង ចាត់ ឱ្យ មក កុំ ឱ្យ ខាន ពិសេស ការរៀបចំ អាហារ ត្រូវតែ ឆ្ងាញ់ បបូរណ៍ ចម្រុះ រសជាតិ ។
ដូច្នេះ ភាព ជាក់ស្ដែង ក៏ កូនក្មួយ និង ចៅ ឃើញ ថ្ងៃ នេះ ក្រុមការងារ របស់ កាកបាទ ក្រហម កម្ពុជា បាន រៀបចំ ជូន កូនក្មួយ យ៉ាង ពេញចិត្ដ មាន ម្ហូប អាហារ ច្រើន មុខ ចម្រុះ គ្នា រួមទាំង បង្អែម ទុក លាង មាត់ យ៉ាង ឆ្ងាញ់ ពិសា មាន អ៊ុំ ពូមីង កំដរ មើល ថែ ថែម ទៀត ។
លោកស្រី ក៏ បាន យក ឱកាស នេះ ថ្លែង លើកទឹកចិត្ដ ដល់ កុមារ នៃ អង្គការ នេះ ឱ្យ ខិតខំ រៀនសូត្រ ធ្វើជា ក្មេង ល្អ កូន ល្អ សិស្ស ល្អ ឧស្សាហ៍ ព្យាយាម ត ស៊ូ នៅក្នុង ជីវិត ចូល ប្រព្រឹត្ដ តែ រឿង ត្រឹមត្រូវ ពិសេស ត្រូវ ចេះ ស្រលាញ់ សុខភាព ជា ចម្បង ស្រលាញ់ ខ្លូន ស្ងួន ចំណី ស្ករ តិច ខ្លាញ់ តិច អំបិល តិច សុខភាព ល្អ ។
ជា ការឆ្លើយតប លោក ចន ជា គ្រូ ស្ម័គ្រចិត្ដ ជនជាតិ ណូវែលហ្សេឡង់ (New Zealand) បាន ថ្លែង ថា « ខ្ញុំ ពិតជា ពេញចិត្ដ និង ស្រលាញ់ កុមារ កម្ពុជា ណាស់ គាត់ ជា ក្មេង ចេះ តស៊ូ ស្រលាញ់ ការសិក្សា ធ្វើឱ្យ ខ្ញុំ ជា គ្រូ មាន ក្ដីសប្បាយរីករាយ ក្នុង ការជួយ ពួកគាត់ ត្បិត ណាស់ ថា មិន មែន សញ្ជាតិ ដូចគ្នា តែ បេះដូង ខ្ញុំ មាន វត្ដមាន ពួកគាត់ គឺ សប្បាយចិត្ដ ហើយ ខ្ញុំ នឹង បន្ដ ជួយ លើកកម្ពស់ ការសិក្សា របស់ គាត់ បន្ដ ដោយ មិន នឿយហត់ ពិសេស និង ជួយ កៀរ គរ សប្បុរសធម៌ ពី ក្រៅ ប្រទេស បន្ថែម ដើម្បី មក ជួយ កុមារ ៗ នៅ ទីនេះ » ។
ត្បិត ណាស់ ថា ការជួយជ្រោមជ្រែង ក្នុង ការជួយ កុមារ ពីសំណាក់ សប្បុរស ជនជាតិ និង អន្ដរជាតិ មាន ជា បន្ដ បន្ទាប់ ពិសេស ការជួយ អស់ ពី ចិត្ដ ពី ថ្លើម របស់ ថ្នាក់ដឹកនាំ កំពូល នៃ កម្ពុជា តែ តម្រូវការ ដឹង ហើយ តែងតែ មាន មិន ចេះ ចប់ មិន ចេះ ហើយ ដូច្នេះ លោកស្រី នួន ភី មាន ដែល ជា ស្ថានិក នៃ អង្គការ ខាងលើ បាន ថ្លែង ឱ្យដឹង ថា ដោយសារ វិបត្ដិ កូវីដ១៩ ក៏ ដូចជា វិបត្ដិ សកលលោក ការជួយ ឧបត្ថម្ភ គាំទ្រ ពី គ្រប់ មជ្ឈដ្ឋាន ក៏ មាន អន់ ថយ ។
តែ ទន្ទឹម នឹង នោះ លោកស្រី ស្ថានិក នៃ អង្គការ ជួយ លើកស្ទួយ ប្រជាពលរដ្ឋ បាន ថ្លែង គោរព ការអំណរគុណ ដ៏ ជ្រាលជ្រៅ ដល់ ប្រមុខ រាជ រដ្ឋាភិបាល និង ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ ពិសេស អ្នកម្ដាយ មនុស្សធម៌ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន បន្ដ ជួយ កូន ៗ ចៅ ៗ គ្រប់ ពេលវេលា ទោះ ក្នុង កាលៈទេសៈ ណា ក៏ដោយ ពិសេស ពី ខ្វះខាត តែម្ដង តែងតែ លេច វត្ដមាន របស់ អ្នកម្ដាយ ជាក់ស្ដែង ដូច ថ្ងៃ នេះ ។
សូម ជម្រាប ថា សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នៅ ថ្ងៃទី ៤មេសា នេះ បាន ចាត់ ឱ្យ លោកស្រី ម៉ែន នារី សោភ័គ លោក យូ ឡាណា អគ្គ លេខាធិការ រង ទី២ និង សហការី រួម ជាមួយ សប្បុរសជន អញ្ជើញ ចុះ សួរសុខទុក្ខ នាំយក អំណោយ មនុស្សធម៌ ជា លើក ទី ១២ ដោយ គិត ចាប់តាំងពី ឆ្នាំ ២០១៤ និង រៀបចំ អាហារ ថ្ងៃត្រង់ មួយ ពេល ជូន ដល់ កុមារ និង សិស្សានុសិស្ស ចំនួន ១. ២២០ នាក់ នៃ អង្គការ លើកស្ទួយ ប្រជាពលដ្ឋ ដែល ស្ថិត នៅ ភូមិ ដំណាក់ ធំ១ សង្កាត់ ស្ទឹងមានជ័យ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។
ឱកាស នោះ ក្រុម កុមារ និង សិស្សានុសិស្ស នៃ អង្គការ លើកស្ទួយ ប្រជាពលរដ្ឋ ក៏ បាន ទទួលស្វាគមន៍ គណៈប្រតិភូ ដោយ ភាពសប្បាយរីករាយ ក្នុង ចិត្ដ ជាខ្លាំង ក្នុង នោះ កុមារ ៗ ក៏ មាន ការសម្តែង របាំ ជូនពរ នារី ជា ជួរ និង របាំ គោះ ត្រឡោក ដែល បង្ហាញ ពី ទំនៀមទម្លាប់ ប្រពៃណី ខ្មែរ ដ៏ ផូរផង់ របស់ យើង ផងដែរ ៕
ទោះបីជា មាន ការរំលោភ លើ ច្បាប់ របស់ អ៊ុយក្រែន ក៏ដោយ អ្នក ដែល មាន ទំនួល ខុសត្រូវ ចូល បម្រើ យោធា ត្រូវបាន ឃុំ ខ្លួន ទាំង នៅ ចំពោះមុខ ប្រពន្ធ និង កូន ដោយ ពួកគេ ត្រូវបាន បញ្ជូន ទៅ ការិយាល័យ ចុះឈ្មោះ យោធា ទាំង បង្ខំ ហើយ បន្ទាប់ពី បញ្ចប់ វគ្គ សិក្សា មួយ ខែ ឬ សប្តាហ៍ ដោយ គ្មាន ការហ្វឹកហ្វឺន យោធា ពួកគេ ត្រូវបាន បញ្ជូន ទៅ ជួរ មុខ ។ ចំនួន ករណី បែប នេះ គឺ រាប់ ពាន់ នាក់ ។
ប្រព័ន្ធ ផ្សព្វផ្សាយ អ៊ឺរ៉ុប រាយការណ៍ ថា ទាហាន អ៊ុយក្រែន ភាគ ច្រើន ជា បុរស ដែល មាន ប្រាក់ ចំណូល ទាប រស់ នៅក្នុង តំបន់ ជនបទ និង ទីក្រុង តូច ៗ ។ វា ច្បាស់ ណាស់ ថា អាជ្ញាធរ អ៊ុយក្រែន កំពុង ជៀសវាង ការធ្វើ យុទ្ធនាការ ជ្រើសរើស ចូល បម្រើ កងទ័ព ពេញ លក្ខណៈ នៅក្នុង ទីក្រុង ធំ ៗ ដោយ ភ័យខ្លាច ភាពចលាចល ដ៏ ធំ ពី អ្នក មាន ឥទ្ធិពល ក្នុង សង្គម និង វិស័យ នយោបាយ ដែល សុបិន ចង់ ដក លោក Zelensky ចេញ ពី តំណែង ប្រធានាធិបតី ដើម្បី បញ្ចប់ ជម្លោះ ឱ្យ បាន លឿន តាម ដែល អាច ធ្វើ ទៅ បាន ។
( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន ចេញ អនុក្រឹត្យ មួយ បញ្ចប់ មុខតំណែង លោក ឧត្តមសេនីយ៍ ឯក យុាំ ស៊ីង ម៉ៅ ពី ប្រធាន នាយកដ្ឋាន កណ្តាល នគរបាល យុត្តិធម៌ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ចំណុះ ក្រសួង មហាផ្ទៃ ។
ដី ប្រមាណ ១ម៉ឺន ហិកតា ត្រូវបាន ឃ្លុំ ទុក ជា សម្បត្តិ រដ្ឋ ដើម្បី ដាំ ស្តារ ព្រៃ ឡើងវិញ ឃាត់ខ្លួន មនុស្ស ៣២ នាក់ ក្នុង ប្រតិបត្តិការ ក្តៅ ទប់ស្កាត់ បទល្មើស ធនធាន ធម្មជាតិ នៅ ខេត្ត ពោធិ៍សាត់
លើស ពី នេះ ក្រុម ចម្រុះ បាន រុះរើ ខ្ទម បណ្តោះអាសន្ន នៅលើ ទីតាំង ដែល បាន កាប់ រុករាន ដី ព្រៃ ក្នុង តំបន់ ការពារ ធម្មជាតិ ធ្វើជា កម្មសិទ្ធិ ចំនួន ៥២០ ខ្ទម និង បាន ដកហូត សម្ភារ មួយចំនួន ទុក ជា វត្ថុតាង រួម មាន៖ រណា យន្ត៣៥ គ្រឿង ម៉ូតូ ១៦ គ្រឿង គោយន្ត១ គ្រឿង ផាល ត្រាក់ទ័រ ៦គ្រឿង ម៉ាស៊ីន កាត់ ស្មៅ ២៣ គ្រឿង ម៉ាស៊ីន បាញ់ ថ្នាំ ស្មៅ ០៩ គ្រឿង កាំភ្លើង កែច្នៃ ចំនួន ១១ដើម អង្គប់ ចំនួន ៧៥ កាំបិត ចំនួន ២៨ បង្គោល របង ចំនួន ៣. ៦៥២ បង្គោល និង ដំណាំ ចម្រុះ បាន ជាច្រើន គុម្ព និង បាច់ ផងដែរ ។
ដោយឡែក ប្រតិបត្តិការ នៅ ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២៤ កម្លាំង ចម្រុះ បាន អន្តរាគមន៍ ចុះបង្រ្កាប ទប់ស្កាត់ បទល្មើស កាប់ រុន រាន ដី ព្រៃ ធ្វើជា កម្មសិទ្ធិ បាន ឃ្លុំ ដី ទុក បាន ចំនួន ១២. ៦២ ហិកតា ឃាត់ខ្លួន មនុស្ស ចំនួន ២នាក់ អប់រំ ប្រជាពលរដ្ឋ ចំនួន ៥នាក់ និង រឹបអូស បាន វត្ថុតាង នៅ ហ្នឹង កន្លែង មាន ដូច ជា៖ ដកហូត ម៉ូតូ ១គ្រឿង និង ដើម ដំឡូវ មី ចំនួន ១បាច់ ។
ប្រធាន សភា សិង្ហបុរី ផ្ញើ លិខិត អបអរសាទរ ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ត្រូវបាន បោះឆ្នោត ជ្រើសរើស ជា ប្រធាន ព្រឹទ្ធសភា នីតិកាល ទី៥
( ភ្នំពេញ ) ៖ លោក Seah Kian Peng ប្រធាន សភា សិង្ហបុរី បាន ផ្ញើ សារលិខិត អបអរសាទរ ជូន ចំពោះ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ក្នុង ឱកាស សម្តេច ត្រូវបាន បោះឆ្នោត ជ្រើសរើស ជា ប្រធាន ព្រឹទ្ធសភា នីតិកាល ទី៥ ក្នុង សម័យ ប្រជុំ ដំបូង ព្រឹទ្ធសភា នីតិកាល ទី៥ នៅ ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២៤ ក្រោម ព្រះរាជា ធិបតី ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ប្រធាន សភា សិង្ហបុរី បាន បញ្ជាក់ ក្នុង លិខិត ទាំងស្រុង យ៉ាង ដូច្នេះ ថា៖
សម្តេច តេជោ ហ៊ុន សែន ជាទីគោរព ដ៏ ខ្ពង់ខ្ពស់ ! សូម សម្តេច មេត្តា ទទួលយក នូវ សេចក្តី អបអរសាទរ និង សព្ទ សាធុការ ពរ របស់ ខ្ញុំ ជូន ចំពោះ សម្តេច ដែល ត្រូវបាន បោះឆ្នោត ជ្រើសរើស ជា ប្រធាន ព្រឹទ្ធសភា ។
ប្រទេស សិង្ហបុរី និង ព្រះរាជាណាចក្រ កម្ពុជា មាន ទំនាក់ទំនង ល្អ ប្រសើរ និង យូរអង្វែង ជាមួយគ្នា ។ ខ្ញុំ ទន្ទឹងរង់ចាំ ធ្វើការ ជាមួយ សម្តេច ក្នុង ការពង្រឹង ទំនាក់ទំនង រវាង ស្ថាប័ន នីតិប្បញ្ញត្តិ របស់ យើង ក៏ ដូចជា ក្នុង ចំណោម សភា ជា សមាជិក នៃ អន្តរសភា អាស៊ាន (AIPA) ។
ខ្ញុំ សូម គោរព ជូនពរ សម្តេច ទទួលបាន នូវ ជោគជ័យ រាល់ ភារកិច្ច បន្ត ទៀត ។ សូម សម្តេច មេត្តា ទទួល នូវ ការ ជូនពរ សុខភាព ល្អ បរិបូរណ៍ ពី រូប ខ្ញុំ ។ សូម សម្តេច មេត្តា ទទួល នូវ ការគោរព ដ៏ ខ្ពង់ខ្ពស់ បំផុត ពី ខ្ញុំបាទ ៕
បន្ទាប់ពី ចូលរួម កិច្ចប្រជុំ នៃ រដ្ឋមន្រ្តី ការបរទេស ណា តូ នៅក្នុង ទីក្រុង ព្រុច សែល លោក Peters បាន បញ្ជាក់ ថា « នូវែលសេឡង់ ប្តេជ្ញា ធ្វើ ការរួមគ្នា ជាមួយ ដៃគូ ណា តូ ដើម្បី រួមចំណែក ដល់ សន្តិសុខ សមូហភាព ដូចជា តាមរយៈ ការគាំទ្រ របស់ យើង សម្រាប់ ការការពារ ស្វ័យភាព របស់ អ៊ុយក្រែន ជាដើម »។ លោក Peters បន្ថែម ថា « យើង ក៏ រំពឹង ថា នឹង បញ្ចប់ កិច្ចចរចា ភាព ជាដៃគូ នៅ ប៉ុន្មាន ខែ ខាងមុខ និង យល់ព្រម លើ ផ្នែក ជាក់ស្តែង នៃ កិច្ចសហប្រតិបត្តិការ » ។
គួរ បញ្ជាក់ ថា នូវែលសេឡង់ បាន និង កំពុង ចរចា លើ ភាព ជាដៃគូ ប្រភេទ ថ្មី ជាមួយ អង្គការ ណា តូ ខណៈ ដែល សម្ព័ន្ធភាព នេះ ត្រូវ ផ្លាស់ប្តូរ ភាពជាដៃគូ ទាំងអស់ របស់ ខ្លួន ទៅជា កម្មវិធី ភាព ជាដៃគូ លក្ខណៈ បុគ្គល ៕
ឯកឧត្តម សួង ម៉េង គា រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង លោកជំទាវ បរិច្ចាគ ថវិកា ៣ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ ឯកឧត្តម សួង ម៉េង គា រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន បរិច្ចាគ ថវិកា ចំនួន ៣ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
ឯកឧត្តម សួង ម៉េង គា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
បណ្ឌិត អ៉ិន ចាន់ នី និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បន្ត ពង្រឹង សមត្ថភាព ដល់ មន្ត្រី អនុវត្ត ច្បាប់
( ភ្នំពេញ ) ៖ វិទ្យាស្ថាន ជាតិ ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ កាលពី ថ្ងៃទី៤ ខែមេសា ឆ្នាំ ២០២៤ បាន បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី « ការអនុវត្ត នីតិវិធី ចាត់ចែង រក្សា ការពារ និង នីតិវិធី ក្ស័យ ធន » ក្នុង គោលបំណង លើកកម្ពស់ ការយល់ដឹង អំពី ការអនុវត្ត នីតិវិធី ទាំងនេះ ដើម្បី ចូលរួម ដោះស្រាយ ផល ប៉ះពាល់ ដែល កើត ចេញពី ការបិទ សហគ្រាស គ្រឹះស្ថាន មិន ដំណើរការ និង នៅពេល មាន ករណី ក្ស័យ ធន ដើម្បី ការពារ ផលប្រយោជន៍ ជូន បងប្អូន កម្មករ និយោជិត ឱ្យ បាន ទាន់ ពេល វេលា ។
មុននឹង បញ្ចប់ លោក រដ្ឋលេខាធិការ បាន ស្នើសុំ ឱ្យ អង្គ សិក្ខាកាម ទាំងអស់ យកចិត្តទុកដាក់ ស្វែងយល់ បន្ថែម លើ ការអនុវត្ត នីតិវិធី ចាត់ចែង រក្សា ការពារ និង នីតិវិធី ក្ស័យ ធន ដើម្បី យក ទៅ អនុវត្ត ការពារ ប្រយោជន៍ ជូន ដល់ កម្មករ និយោជិត ដោយ ស្មារតី ទទួលខុសត្រូវ ៕
សម្តេច រដ្ឋសភា ធិបតី ឃួន សុដារី សារលិខិត អបអរសាទរ ជូន ឯកឧត្តម អ៊ុច បូរ រិទ្ធ ដែល ត្រូវបាន អង្គ ព្រឹទ្ធសភា បោះឆ្នោត ជ្រើសរើស ជា « អនុប្រធាន ទី២ ព្រឹទ្ធសភា »
( ភ្នំពេញ ) ៖ សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា តំណាង ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា និង មន្រ្តី រាជការ រដ្ឋសភា ទាំងអស់ បាន សម្តែង នូវ មនោសញ្ចេតនា យ៉ាង ជ្រាលជ្រៅ ព្រម ជាមួយ អំណរ សាទរ យ៉ាង ក្រៃលែង ជូន ចំពោះ ឯកឧត្តម អ៊ុច បូរ រិទ្ធ ដែល ត្រូវបាន ព្រឹទ្ធសភា បោះឆ្នោត ជ្រើសរើស ជា « អនុប្រធាន ទី២ ព្រឹទ្ធសភា » នា សម័យ ប្រជុំ ព្រឹទ្ធសភា លើក ទី១ នីតិកាល ទី៥ នៅ ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២៤ នេះ ។
ឆ្លៀត ក្នុង ឱកាស ដ៏ វិសេសវិសាល នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម សម្តែង នូវ ការគោរព និង កោតសរសើរ ដោយ ស្មោះ អស់ ពី ដួងចិត្ត ជូន ចំពោះ ឯកឧត្តម ដែល បាន ខិតខំ ប្រឹងប្រែង លះបង់ អស់ ពី កម្លាំង កាយ ពល និង បញ្ញា ញាណ ព្រមទាំង បាន ធ្វើ ពលិកម្ម គ្រប់ បែបយ៉ាង ក្នុង បេសកកម្ម ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាជន កម្ពុជា ។
( ភ្នំពេញ ) ៖ សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា តំណាង ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា និង មន្រ្តី រាជការ រដ្ឋសភា ទាំងអស់ បាន សម្តែង នូវ មនោសញ្ចេតនា យ៉ាង ជ្រាលជ្រៅ ព្រម ជាមួយ អំណរ សាទរ យ៉ាង ក្រៃលែង ជូន ចំពោះ ឯកឧត្តម ប្រាក់ សុខុន ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ដែល ត្រូវបាន ព្រឹទ្ធសភា បោះឆ្នោត ជ្រើសរើស ជា « អនុប្រធាន ទី១ ព្រឹទ្ធសភា » នា សម័យ ប្រជុំ ព្រឹទ្ធសភា លើក ទី១ នីតិកាល ទី៥ នៅ ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២៤ នេះ ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃពុធ កន្លងទៅ បណ្ដា រដ្ឋមន្ត្រី នៃ ប្រទេស ជា សមាជិក NATO ក៏ បាន ឯកភាព គ្នា ផងដែរ ថា នឹង ចាប់ផ្ដើម ផែនការ សម្រាប់ ការដើរ តួនាទី មួយ ក្នុង ការសម្របសម្រួល ជំនួយ ដើម្បី ជួយ អ៊ុយក្រែន បន្ត តស៊ូ ប្រយុទ្ធ ប្រឆាំង ជាមួយ រុស្ស៉ី ៕
ត្រីមាស ទី១ ឆ្នាំ នេះ កម្ពុជា អនុម័ត គម្រោង វិនិយោគ ចំនួន ១០៦ ទុន សរុប ប្រមាណ ២.២ពាន់ លាន ដុល្លារ
( ភ្នំពេញ ) ៖ គម្រោង វិនិយោគ ចំនួន ១០៦ ដែល មាន ទុន វិនិយោគ សរុប ប្រមាណ ២.២ពាន់ លាន ដុល្លារ អាមេរិក ត្រូវបាន អនុម័ត ដោយ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ក្នុង ត្រីមាស ទី១ នៃ ឆ្នាំ ២០២៤ អាច បង្កើត ការងារ បាន ជាង ១០៧ ពាន់ កន្លែង ។ នេះ បេី តាម សេចក្ដីប្រកាស ព័ត៌មាន របស់ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៥ ខែមករា ឆ្នាំ ២០២៤ ។
ជា ការកត់សម្គាល់ គម្រោង វិនិយោគ ដែល មាន ទីតាំង ស្ថិត នៅ ក្រៅ តំបន់ សេដ្ឋកិច្ច ពិសេស មាន ចំនួន ៧៣ គម្រោង ក្នុង នោះ មាន គម្រោង ពង្រីក ផលិតកម្ម ចំនួន ៣គម្រោង ដោយឡែក គម្រោង វិនិយោគ ដែល មាន ទីតាំង ស្ថិត នៅក្នុង តំបន់ សេដ្ឋកិច្ច ពិសេស មាន ចំនួន ៣៣ គម្រោង ក្នុង នោះ មាន គម្រោង ពង្រីក ផលិតកម្ម ចំនួន ៣គម្រោង ។
ជា រួម ក្នុង ត្រីមាស ទី១ ឆ្នាំ ២០២៤ នេះ ការអនុម័ត គម្រោង វិនិយោគ មាន ការកើនឡើង ចំនួន ៦៧ គម្រោង ខណៈ ទុន វិនិយោគ មាន ការកើនឡើង គួរឱ្យ កត់សម្គាល់ ប្រមាណ ជិត ២ពាន់ លាន ដុល្លារ អាម៉េរិក ស្មើនឹង ប្រមាណ ៦៤៩ % ធៀប នឹង រយៈពេល ដូចគ្នា នៅ ឆ្នាំ ២០២៣ ។
ការកើនឡើង យ៉ាង គំហុក នេះ គឺ ដោយសារ វត្តមាន នៃ គម្រោង ថ្មី នៅក្នុង វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ . វិស័យ ឧស្សាហកម្ម . វិស័យ ទេសចរណ៍ និង គម្រោង ពង្រីក ផលិតកម្ម នៃ វិស័យ ឧស្សាហកម្ម នៅក្នុង តំបន់ សេដ្ឋកិច្ច ពិសេស ៕
ការអត្ថាធិប្បាយ បែប នេះ របស់ លោក ណេតាន់ យ៉ាហ៊ូ កើត មាន ឡើង បន្ទាប់ពី កងកម្លាំង អ៉ី ស្រាអែល បាន ប្រកាស ផ្អាក ការឈប់ សម្រាក សម្រាប់ កង អង្គភាព ប្រយុទ្ធ ទាំងអស់ ដើម្បី ត្រៀមលក្ខណៈ ទប់ទល់ នឹង ការសងសឹក ណាមួយ ក្រោយ អ៉ីរ៉ង់ ចោទ ថា អ៉ី ស្រាអែល ជា អ្នកវាយប្រហារ តាម ផ្លូវ អាកាស សម្លាប់ មេបញ្ជាការ របស់ ខ្លួន ជាច្រើន នាក់ ក្នុង ទីក្រុង ដាម៉ាស ប្រទេស ស៊ីរី កាលពី ប៉ុន្មាន ថ្ងៃ កន្លងទៅ នេះ ។
ថ្លែង នា ឱកាស ចាប់ផ្ដើម កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី ខាង សន្តិសុខ លោក ណេតាន់ យ៉ាហ៊ូ បាន គូសបញ្ជាក់ ដូច្នេះ ថា « អស់ រយៈពេល ជាច្រើន ឆ្នាំ មកហើយ អ៉ីរ៉ង់ បាន ធ្វើ សកម្មភាព ប្រឆាំង នឹង ពួកយើង ទាំង ប្រយោល និង ដោយ ផ្ទាល់ ដូច្នេះ អ៉ី ស្រាអែល កំពុង ធ្វើ សកម្មភាព ប្រឆាំង អ៉ីរ៉ង់ និង ចលនា ប្រដាប់អាវុធ គាំទ្រ ដោយ តេហេរ៉ង់ ជាមួយ ការការពារ ខ្លួន និង វាយ បក» ។
គួរ បញ្ជាក់ ថា ក្រោយ មាន ការវាយប្រហារ លើ បរិវេណ ស្ថានទូត អ៉ីរ៉ង់ ប្រចាំ ទីក្រុង ដាម៉ាស ប្រទេស ស៊ីរី កាលពី ថ្ងៃទី១ ខែមេសា អ៉ី រ៉ង់ បាន ចោទប្រកាន់ ថា ជា ស្នាដៃ របស់ អ៉ី ស្រាអែល ហើយក៏ បាន គំរាម សងសឹក ផងដែរ ។ អ៉ី ស្រាអែល មិន បាន ទទួលស្គាល់ ហើយក៏ មិន បាន ប្រកែក ចំពោះ ការវាយប្រហារ នេះ ទេ រីឯ លោក ណេតាន់ យ៉ាហ៊ូ ក៏ មិន បាន និយាយ អ្វី ពី ការវាយប្រហារ នោះ ដែរ ៕
ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន យាង ចាកចេញ ពី រាជធានី ភ្នំពេញ ហើយ ដើម្បី ទៅ បំពេញ ព្រះរាជ ទស្សនកិច្ច នៅ ប្រទេស ជប៉ុន (Video inside) ( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃសុក្រ ១២រោច ខែ ផល្គុន ឆ្នាំ ថោះ បញ្ចស័ក ពុទ្ធ សករាជ ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន យាង ចាកចេញ ពី រាជធានី ភ្នំពេញ ហើយ ដើម្បី បំពេញ ព្រះរាជ ទស្សនកិច្ច ផ្លូវការ នៅ ប្រទេស ជប៉ុន ចាប់ពី ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២៤ត ទៅ ។
នៅក្នុង ឱកាស អវត្តមាន របស់ ព្រះមហាក្សត្រ នៅក្នុង ប្រទេស ព្រះអង្គ បាន ប្រគល់ ភារកិច្ច ជូន សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា ឱ្យ ទទួល ជួយ ព្រះអង្គ ក្នុង ឋានៈ ជា ប្រមុខរដ្ឋ ស្តីទី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។ នេះ បើ តាម ព្រះរាជ សារលិខិត របស់ ព្រះមហាក្សត្រ ៕
