( ក្រចេះ ) ៖ កូន ផ្សោត មួយ ក្បាល ទៀត ត្រូវបាន ប្រទះឃើញ នៅ អន្លង់ ផ្សោត ព្រែក កាំ ពី ភូមិ ជ្រោយ បន្ទាយ ឃុំ ជ្រោយ បន្ទាយ ស្រុក ព្រៃ ប្រសព្វ ខេត្ត ក្រចេះ ។
ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ឱ្យដឹង ថា កូន ផ្សោត ទើប កើត ថ្មី មួយ ក្បាល នេះ ត្រូវបាន ប្រទះឃើញ ដោយ ក្រុមការងារ ស្រាវជ្រាវ នៃ រដ្ឋបាល ជលផល និង អង្គការ WWF វេលា ម៉ោង ១៥៖១០នាទី នា ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ ។ កូន ផ្សោត នេះ ស្ថិត នៅក្នុង ក្រុម សត្វ ផ្សោត ធំ ៗ ចំនួន ៣ក្បាល ផ្សេង ទៀត ។
សូម ជម្រាប ថា នេះ គឺជា កូន ផ្សោត ទី៧ ដែល បាន កើត នៅ ដើម ឆ្នាំ ២០២៤ នេះ ។ រដ្ឋបាល ជលផល នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ អរគុណ ចំពោះ ឆ្មាំ ទន្លេ អាជ្ញាធរ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម ថែរក្សា និង ការពារ ធនធាន ជល ផល ដ៏ មាន តម្លៃ ។
ក្រសួង ធនធាន ទឹក ជូនដំណឹង អំពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង អំពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ ។
ក្រសួង បញ្ជាក់ ថា សម្ពាធ ទាប គ្របដណ្ដប់ មក លើ ឈូង សមុទ្រ ថៃ ព្រះរាជាណាចក្រ កម្ពុជា និង សមុទ្រ ចិន ខាងត្បូង ។ ស្ថានភាព បែប នេះ នឹង ធ្វើ ឱ្យ៖ ចាប់ពី ថ្ងៃទី ២៣ ដល់ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤៖
ដំណើរទស្សនកិច្ច ដែល មាន រយៈពេល ពីរ ថ្ងៃ ធ្វើឡើង តប តាម ការអញ្ជើញ របស់ ព្រះមហាក្សត្រ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ។
ក្នុង អំឡុង ពេល ទស្សនកិច្ច នៅ កម្ពុជា ប្រធាន រដ្ឋឡាវ នឹង ជួប សវនាការ ជាមួយ ព្រះករុណា ព្រះមហាក្សត្រ នៅ ព្រះបរម រាជ វាំង ។
លោក ប្រធាន រដ្ឋ ក៏ នឹង មាន ជំនួប សម្តែង ការគួរសម ដាច់ដោយឡែក ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា និង សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ភាគី ទាំង ពីរ នឹង ពិភាក្សា អំពី ការលើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ក្នុង ក្របខណ្ឌ ទ្វេ ភាគី និង ពហុ ភាគី រួមទាំង បញ្ហា តំបន់ និង អន្តរជាតិ ដែល ជា ផលប្រយោជន៍ រួម ។
ប្រធាន រដ្ឋឡាវ នឹង អញ្ជើញ ដាក់ កម្រង ផ្កា គោរព វិញ្ញាណក្ខន្ធ នៅ វិមាន ឯករាជ្យ និង នៅ មណ្ឌប តម្កល់ ព្រះបរម រូប ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ នរោត្ដម សីហនុ « ព្រះបរម រតន កោដ្ឋ » ។
ក្រសួង ការបរទេស កម្ពុជា ចាត់ទុក ដំណើរទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ ពេល នេះ នឹង ក្លាយជា ព្រឹត្តិការណ៍ ដ៏ មាន សារសំខាន់ ក្នុង ការពង្រឹង និង លើកកម្ពស់ បន្ថែម ទៀត នូវ ទំនាក់ទំនង ដ៏ ល្អ ប្រសើរ អ្នកជិតខាង ល្អ ទំនាក់ទំនង ជា បងប្អូន និង សាមគ្គីភាព ព្រមទាំង ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ និង យូរអង្វែង ដើម្បី វិបុលភាព រួមន ប្រទេស ទាំង ពីរ ៕ ឯកឧត្ដម ប្រាជ្ញ ចន្ទ និង លោកជំទាវ ឱម សារី បរិច្ចាគ ថវិកា ២០ លាន រៀល ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ប្រាជ្ញ ចន្ទ និង លោកជំទាវ ឱម សារី បាន បរិច្ចាគ ថវិកា ចំនួន ២០ លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
ឯកឧត្ដម ប្រាជ្ញ ចន្ទ និង លោកជំទាវ ឱម សារី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោកជំទាវ ងួន ធួន មិន ឃិន និង លោកជំទាវ មិន ចណ្ឌីណែត បរិច្ចាគ ថវិកា ១ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ លោកជំទាវ ងួន ធួន មិន ឃិន និង លោកជំទាវ មិន ចណ្ឌីណែត បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
លោកជំទាវ ងួន ធួន មិន ឃិន និង លោកជំទាវ មិន ចណ្ឌីណែត តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អ្នកនាំពាក្យ ខុទ្ទកាល័យ នាយក រដ្ឋមន្ដ្រី បង្ហាញ លទ្ធផល ផ្លូវការ នៃ ជំនួប រវាង សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត និង អនុប្រធាន ក្រុមប្រឹក្សា អូឡាំពិក អាស៊ី
ក្នុង ឱកាស នៃ ជំនួប លោក តាង ហ្គោ ដុន បាន ថ្លែងអំណរគុណ ចំពោះ សម្ដេច ធិបតី ដែល បាន ឆ្លៀត ពេលវេលា ដ៏ មមាញឹក អនុញ្ញាតឲ្យ រូប លោក និង សហការី ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ព្រមទាំង បាន សម្តែង នូវ ការអរគុណ យ៉ាង ខ្លាំង ចំពោះ សម្ដេច ធិបតី ដែល បាន ទទួលស្គាល់ នូវ ការងារ និង ការចូលរួម របស់ លោក ក្នុង ការអភិវឌ្ឍ វិស័យ កីឡា នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ។
ជា ការឆ្លើយតប សម្ដេច ធិបតី បាន សម្តែង នូវ ការស្វាគមន៍ ចំពោះ លោក តាង ហ្គោ ដុន និង សហការី ដែល បាន អញ្ជើញ មក បំពេញ ទស្សនកិច្ច នៅ ព្រះរាជាណាចក្រ កម្ពុជា ព្រមទាំង បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការចូលរួមចំណែក របស់ លោក ក្នុង ការគាំទ្រ និង អភិវឌ្ឍ វិស័យ កីឡា នៅ ព្រះរាជាណាចក្រ កម្ពុជា រួមទាំង ផ្នែក យុទ្ធ គុន ចម្រុះ ផងដែរ ។
សម្ដេច ធិបតី ក៏ បាន គូសបញ្ជាក់ ជូន លោក តាង ហ្គោ ដុន ស្ថាប័ន ពាក់ព័ន្ធ របស់ រាជ រដ្ឋាភិ - បាល កម្ពុជា និង វិស័យ ឯកជន នឹង ត្រៀមខ្លួន ក្នុង ការសម្របសម្រួល និង សហការ ក្នុង ការរៀបចំ ព្រឹត្តិការណ៍ គុន ចម្រុះ នេះ ជាមួយនឹង ក្រុមប្រឹក្សា អូឡាំពិក អាស៊ី ។
ពាក់ព័ន្ធ ទៅនឹង ការរៀបចំ កីឡា យុវជន អាស៊ី ឆ្នាំ ២០២៩ សម្ដេច ធិបតី បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន រៀបចំ ត្រៀមលក្ខណៈ គ្រប់គ្រាន់ ដើម្បី ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កីឡា យុវជន អាស៊ី នេះ ហើយ ដោយ ផ្អែក លើ បទពិសោធន៍ ដែល កម្ពុជា ធ្លាប់ បាន រៀបចំ ដោយ ជោគជ័យ នូវ ព្រឹត្តិការណ៍ ប្រកួត កីឡា ស៊ីហ្គេម លើក ទី ៣២ និង កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ កាលពី ឆ្នាំ ២០២៣ កន្លងទៅ នេះ ។
ក្នុង ឱកាស នៃ ជំនួប លោក តាង ហ្គោ ដុន បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច ធិបតី ដែល បាន ឆ្លៀត ពេលវេលា ដ៏ មមាញឹក អនុញ្ញាតឱ្យ រូប លោក និង សហការី ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ព្រមទាំង បាន សម្តែង នូវ ការអរគុណ យ៉ាង ខ្លាំង ចំពោះ សម្តេច ធិបតី ដែល បាន ទទួលស្គាល់ នូវ ការងារ និង ការចូលរួម របស់ លោក ក្នុង ការអភិវឌ្ឍ វិស័យ កីឡា នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ។
ពាក់ព័ន្ធ ទៅនឹង ការរៀបចំ កីឡា យុវជន អាស៉ី ឆ្នាំ ២០២៩ សម្ដេច ធិបតី បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន រៀបចំ ត្រៀមលក្ខណៈ គ្រប់គ្រាន់ ដើម្បី ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កីឡា យុវជន អាស៉ី នេះ ហើយ ដោយ ផ្អែក លើ បទពិសោធន៍ ដែល កម្ពុជា ធ្លាប់ បាន រៀបចំ ដោយ ជោគជ័យ នូវ ព្រឹត្តិការណ៍ ប្រកួត កីឡា ស៉ី ហ្គេម លើក ទី ៣២ និង កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ កាលពី ឆ្នាំ ២០២៣ កន្លងទៅ នេះ ។
មុននឹង បញ្ចប់ សម្ដេច ធិបតី ក៏ បាន លើកទឹកចិត្ត ឱ្យ លោក តាង ហ្គោ ដុន បន្ត ជួយ គាំទ្រ ក្នុង ការអភិវឌ្ឍ វិស័យ កីឡា នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា និង ជាពិសេស គាំទ្រ ដល់ កម្មវិធី ហ្វឹកហាត់ របស់ អត្តពលិក កម្ពុជា នៅ ប្រទេស ចិន ជា បន្ត ទៀត ដើម្បី ពង្រឹង នូវ សមត្ថភាព ឆ្ពោះ ទៅ ការប្រកួតប្រជែង ក្នុង កីឡា យុវជន អាស៉ី ឆ្នាំ ២០២៩ ផងដែរ ៕
គួរ បញ្ជាក់ ថា សកម្មភាព យោធា របស់ អ៉ី ស្រាអែល បាន ស្ថិត នៅក្រោម ការតាមដាន កាន់តែ ខ្លាំង ឡើង ខណៈ កងកម្លាំង របស់ ខ្លួន បាន សម្លាប់ ជនជាតិ ប៉ាឡេ ស្ទីន ចំនួន ៣៤.០០០ នាក់ នៅក្នុង តំបន់ ហ្កាហ្សា ដែល បើ តាម អាជ្ញាធរ សុខាភិបាល ប៉ាឡេស្ទីន ភាគ ច្រើន គឺជា ជន ស៉ី វិល និង កុមារ ។ ពេលនេះ តំបន់ ហ្កាហ្សា ស្ទើរតែ ក្លាយទៅជា វាលរហោស្ថាន ហើយ ការខ្វះខាត ស្បៀងអាហារ យ៉ាង ខ្លាំង បាន ជំរុញ ឱ្យ មាន ការភ័យខ្លាច ពី គ្រោះ ទុរ្ភិក្ស ៕
ទេសរដ្ឋមន្រ្តី លី ធុជ ជួបប្រជុំ ទ្វេ ភាគី ជាមួយ អនុ រដ្ឋមន្រ្តី ការបរទេស នៃ សាធារណរដ្ឋ ហ្វីជី ស្វែងរក គាំទ្រ ក្នុង ការធ្វើ សកល ភាវូនីយកម្ម នៃ អនុសញ្ញា អូតា វ៉ា
ក្នុង ជំនួប នេះ ទេសរដ្ឋមន្រ្តី លី ធុជ បាន លើកឡើង អំពី គោលដៅ អាទិភាព ចំនួន ៣ របស់ កម្ពុជា ក្នុង នាម ជា ប្រធាន អនុសញ្ញា អូតា វ៉ា ឆ្នាំ ២០២៤ រួម មាន ការធ្វើ សកល ភាវូនីយកម្ម នៃ អនុសញ្ញា កិច្ចការ បោសសម្អាត មីន និង កិច្ច សង្រ្គោះ ជនរងគ្រោះ ដោយសារ មីន ។
ក្នុង ការធ្វើ សកល ភាវូនីយកម្ម នៃ អនុសញ្ញា កម្ពុជា កំពុង ស្វែងរក គាំទ្រ និង កៀរគរ បណ្ដា ប្រទេស ដែល ពុំ ទាន់ ក្លាយជា រដ្ឋ ភាគី នៃ អនុសញ្ញា ឲ្យ ចូលរួម ជា រដ្ឋ ភាគី ក្នុង នោះ មាន ប្រទេស ចំនួន ៣ រួម មាន តុង ហ្កា ម៉ាក្រូណេស៊ី និង កោះ ម៉ាស្យល ស្ថិត ក្នុង តំបន់ ប៉ាស៊ីហ្វិក ផងដែរ ។
ជាមួយគ្នា នេះ កម្ពុជា មាន បំណង កៀរគរ ប្រទេស ទាំង ៣ នេះ ក្នុង ចំណោម ប្រទេស ដទៃ ទៀត ដើម្បី ប្រែក្លាយ តំបន់ ប៉ាស៊ីហ្វិក ទាំងមូល ជា តំបន់ គ្មាន មីន ដែល កិច្ចការ នេះ ត្រូវការគាំទ្រ ពី ប្រទេស ហ្វីជី ក្នុង ការបញ្ចុះបញ្ចូល និង កៀរគរ ប្រទេស ទាំង បី ឲ្យ ចូលរួម ជា រដ្ឋ ភាគី នៃ អនុសញ្ញា អូតាវ៉ា ។
ក្នុង ឱកាស នោះ លោក បណ្ឌិត លី ធុជ បាន ថ្លែងអំណរគុណ ដល់ ប្រទេស ហ្វីជី ដែល បាន ផ្តល់ ការគាំទ្រ ដល់ ការអនុវត្ត នៃ អនុសញ្ញា អូតា វ៉ា ដែល ជា អនុសញ្ញា មនុស្សធម៌ ក្នុង ការលប់ បំបាត់ ទុក្ខវេទនា ដោយសារ មីន ប្រឆាំង មនុស្ស ។
តាង នាម សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី លោក ទេសរដ្ឋមន្រ្តី លី ធុជ បាន អញ្ជើញ ថ្នាក់ដឹកនាំ នៃ សាធារណរដ្ឋ ហ្វីជី ចូលរួម ក្នុង កិច្ចប្រជុំ កំពូល សៀមរាប - អង្គរ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ កិច្ចប្រជុំ នៅ ទឹកដី ខេត្ត សៀមរាប ក្នុង ខែវិច្ឆិកា ឆ្នាំ ២០២៤ ខាងមុខ ។
ជា ការឆ្លើយតប លោកស្រី Lenora Qereqeretabua បាន ថ្លែង ថា ប្រទេស ហ្វីជី ស្វាគមន៍ ចំពោះ សំណើ របស់ កម្ពុជា ដើម្បី ធ្វើឲ្យ តំបន់ ប៉ាស៊ីហ្វិក ទាំងមូល គ្មាន មីន ព្រមទាំង សម្តែង នូវ ការគាំទ្រ ភាព ជា ប្រធាន របស់ កម្ពុជា សម្រាប់ អនុសញ្ញា អូតា វ៉ា ឆ្នាំ ២០២៤ ផងដែរ ៕ លោក បណ្ឌិត អូស្មាន ហាស្សាន់ ដឹកនាំ គណៈប្រតិភូ កម្ពុជា ចូលរួម សម័យ ប្រជុំ លើក ទី ៤៦ របស់ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គការ សម្ព័ន្ធ ពិភព ឥស្លាម នៅ ប្រទេស អារ៉ាប៊ី សាអូឌីត
កិច្ចប្រជុំ នេះ មាន គោលបំណង ជ្រើសរើស និង បន្ត សុពលភាព អាណត្តិ នៃ សមាជិក ឧត្តម ក្រុមប្រឹក្សា ដែល ជា ថ្នាក់ដឹកនាំ ឥស្សរជន តំណាង ប្រទេស ( ជាង ១០០ ) និង សហគមន៍ ឥស្លាម មកពី ជុំវិញ ពិភពលោក ។
ក្រសួង វប្បធម៌ រៀបចំ បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី គរុកោសល្យ វិធីសាស្រ្ត បង្រៀន និង គ្រប់គ្រង ថ្នាក់រៀន ជំហាន ២
( ភ្នំពេញ ) ៖ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ បាន រៀបចំ កម្មវិធី បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី គរុកោសល្យ វិធីសាស្រ្ត បង្រៀន និង គ្រប់គ្រង ថ្នាក់រៀន ជំហាន២ ក្រុម១ ក្រោម អធិបតីភាព លោក ធៀង វណ្ណ ដារ៉ុង អនុ រដ្ឋលេខាធិការ តំណាង លោកស្រី បណ្ឌិត សភាចារ្យ រដ្ឋមន្រ្តី អម ដោយ ថ្នាក់ដឹកនាំ និង សិក្ខាកាម ជា លោកគ្រូ អ្នកគ្រូ សាលា មធ្យម វិចិត្រ សិល្បៈ ចូលរួម ចំនួន ៨៥ រូប ។
លោក ហេង កំសាន្ត នាយក ស្តីទី សាលា មធ្យម វិចិត្រ សិល្បៈ ក៏ បាន ថ្លែង ថា វគ្គ បណ្តុះបណ្តាល នេះ នឹង ជ្រើសរើស យក លោកគ្រូ អ្នកគ្រូ ដែល ធ្លាប់ ទទួលបាន ការបណ្តុះបណ្តាល នូវ ជំហាន១ មក បណ្តុះបណ្តាល នូវ ជំហាន ២បន្ត ដើម្បីឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព នៃ ការបង្រៀន ប្រកបដោយ ក្រមសីលធម៌ និង វិជ្ជាជីវៈ គ្រូបង្រៀន ក្នុង បរិបទ ថ្មី បែប ឌីជីថល ពោលគឺ ផ្តោត លើ បំណិន នៃ ការគ្រប់គ្រង ថ្នាក់រៀន និង វិធីសាស្រ្ត ក្នុង ការគ្រប់គ្រង សិស្ស ជាដើម ។
សូម បញ្ជាក់ ជូន ថា វគ្គ បណ្តុះបណ្តាល ខាងលើ ក៏ មាន ការបញ្រ្ជាប សារ អប់រំ បង្ការ ទប់ស្កាត់ ការប្រើប្រាស់ ការជួញដូរ គ្រឿងញៀន ដល់ លោកគ្រូ អ្នកគ្រូ ដើម្បី យក ទៅ ផ្សព្វផ្សាយ បន្ត ដល់ សិស្សានុសិស្ស ដែល ស្ថិត ក្រោម ការគ្រប់គ្រង របស់ ខ្លួន ៕
ក្រសួង ការបរទេស បង្ហាញ លទ្ធផល សម្តេច ធីបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ចូលរួម ថ្លែង សុន្ទរកថា ពិសេស ក្នុង ពិធី បើក សន្និបាត លើក ទី៨០ គណៈកម្មការ សេដ្ឋកិច្ច និង សង្គម របស់ អង្គការ សហ ប្រជាជាតិ សម្រាប់ អាស៊ី - ប៉ាស៊ីហ្វិក
( ភ្នំពេញ ) ៖ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ កម្ពុជា បាន បង្ហាញ លទ្ធផល របស់ សម្តេច ធីបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ចូលរួម ថ្លែង សុន្ទរកថា ពិសេស នា ឱកាស ពិធី បើក សន្និបាត លើក ទី ៨០ របស់ គណៈកម្មការ សេដ្ឋកិច្ច និង សង្គម របស់ អង្គការ សហ ប្រជាជាតិ សម្រាប់ អាស៊ី - ប៉ាស៊ីហ្វិក នៅ ទីក្រុង បាងកក ប្រទេស ថៃ កាលពី ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ ក្រសួង ការបរទេ ស៖ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ ស្នើ ឱ្យ រដ្ឋបាល គ្រប់ ថ្នាក់ គ្រប់ អង្គភាព ផ្តល់ កិច្ចសហការ ល្អ ជាមួយ ក្រុមការងារ អគ្គ នាយកដ្ឋាន សវនកម្ម ផ្ទៃក្នុង ដើម្បីឱ្យ ដំណើរការធ្វើ សវនកម្ម ប្រព្រឹត្តិ ទៅ ទទួលបាន ល្អ ប្រសើរ
( ស្វាយរៀង ) ៖ លោក ម៉ក់ សម្បត្ដិ អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ បាន ស្នើ ឱ្យ រដ្ឋបាល គ្រប់ ថ្នាក់ គ្រប់ អង្គភាព ចូលរួម ផ្តល់ កិច្ចសហការ ល្អ ជាមួយ ក្រុមការងារ អគ្គ នាយកដ្ឋាន សវនកម្ម ផ្ទៃក្នុង នៃ ក្រសួង មហាផ្ទៃ ដើម្បីឱ្យ ដំណើរការ នៃ ការ ធ្វើ សវនកម្ម នេះ ប្រព្រឹត្តិ ទៅ ទទួលបាន លទ្ធផល ល្អ ប្រសើរ និង ទទួលយក នូវ អនុសាសន៍ នានា ដើម្បី កែលម្អ ដល់ គ្រប់គ្រង ដឹកនាំ របស់ អង្គភាព នីមួយ ៗ កាន់តែ មាន ភាពល្អ ប្រសើរ ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ។
ការស្នើ បែប នេះ របស់ លោក ម៉ក់ សម្បត្តិ អនុ រដ្ឋាធិការ ក្រសួង មហាផ្ទៃ បាន នៅក្នុង ឱកាស ដែល លោក ចូលរួម បើក សវនកម្ម ផ្ទៃក្នុង នៅ រដ្ឋបាល ខេត្ត ស្វាយរៀង សម្រាប់ ការិយបរិច្ឆេទ ២០២៣ និង បណ្តា ឆ្នាំ ពាក់ព័ន្ធ ( ផ្នែក រដ្ឋបាល ស៊ីវិល ផ្នែក សន្តិសុខ សាធារណៈ និង ផ្នែក ពន្ធ ធានាគារ ) នា រសៀល ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម លោក សុខ រស់ អភិបាល រង ខេត្ត ស្វាយរៀង តំណាង លោក ប៉េង ពោធិ៍សា អភិបាល ខេត្ត ព្រមទាំង លោក លោកស្រី ដែល ជា អ្នក ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក សុខ រស់ បាន ថ្លែង ថា កិច្ចប្រជុំ ដ៏ សំខាន់ សម្រាប់ ការងារ សន វកម្ម ផ្ទៃក្នុង ព្រោះ ត្រូវបាន ចាត់ទុក ថា ជា ការងារ អាទិភាព មួយ ដ៏ មាន សារៈសំខាន់ និង ទទួលបាន ការយកចិត្ដទុកដាក់ យ៉ាង ខ្លាំង ហើយ ការអនុវត្ដ កិច្ចការ នេះ បាន ក្លាយជា កាតព្វកិច្ច ដែល កំណត់ ដោយ ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ដ នានា ។
លោក បាន បន្ត ថា ទន្ទឹម នោះ ជា កិច្ចការ ដែល មាន ភាពឯករាជ្យ និង ជាមុខងារ របស់ ស្ថាប័ន ដែល បាន ផ្ដល់ នូវ គុណ តម្លៃ បន្ថែម និង លើកកម្ពស់ ប្រសិទ្ធភាព និង ប្រសិទ្ធផល នៃ កិច្ច ប្រតិបត្ដិការ នានា របស់ ស្ថាប័ន នីមួយ ៗ ដែល ជួយ ឱ្យ សម្រេច នូវ គោលបំណង តាមរយៈ ការពិនិត្យមើល និង វាយតម្លៃ នូវ កិច្ច ដំណើរការ នានា នៃ ការគ្រប់គ្រង ហានិភ័យ ការត្រួតពិនិត្យ និង អភិបាលកិច្ច របស់ ស្ថាប័ន ។
ការប្តេជ្ញាចិត្ត រវាង រដ្ឋាភិបាល កម្ពុជា - ចិន បាន ធ្វើឡើង អំឡុង ទស្សនកិច្ច របស់ លោក វ៉ាង យី សមាជិក ការិយាល័យ នយោបាយ . ប្រធាន ការិយាល័យ គណៈកម្មការ កិច្ចការ បរទេស នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ត ចិន និង ជា រដ្ឋមន្រ្តី ការបរទេស ចិន មកកាន់ ប្រទេស កម្ពុជា រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២១ដល់ ២៣ ខែមេសា ឆ្នាំ ២០២៤ ។
សេចក្តីថ្លែងការណ៍ រួម កម្ពុជា - ចិន ស្តីពី លទ្ធផល នៃ ទស្សនកិច្ច នេះ បាន ឱ្យដឹង ថា៖ « ភាគី ទាំង ពីរ បាន សង្កត់ធ្ងន់ លើ ការប្តេជ្ញាចិត្ត ក្នុង ការអនុវត្ត យ៉ាង ពេញលេញ និង ប្រកបដោយ ប្រសិទ្ធភាព នូវ សេចក្តីថ្លែងការណ៍ ស្តីពី ការប្រតិបត្តិ នៃ ភាគី នានា នៅ សមុទ្រ ចិន ខាងត្បូង (DOC) និង ជំរុញ ការពិគ្រោះយោបល់ លើ ក្រម ប្រតិបត្តិ នៅ សមុទ្រ ចិន ខាងត្បូង (COC) សម្រាប់ ការសន្និដ្ឋាន ជា ជំហាន ដំបូង » ។
ពាក់ព័ន្ធ នឹង បញ្ហា សមុទ្រ ចិន ខាងត្បូង នេះ នា ពេល កន្លងទៅ កម្ពុជា តែងតែ អំពាវនាវ ដល់ ភាគី ទាំងអស់ ឱ្យ អនុវត្ត ដំណោះស្រាយ ប្រកបដោយ សន្តិវិធី និង បន្ត ប្រើប្រាស់ យន្តការ អាស៊ាន - ចិន សម្រាប់ ការអនុវត្ត ដោយ ពេញលេញ នូវ សេចក្តីប្រកាស ស្តីពី ការប្រតិបត្តិ នៃ ភាគី នានា នៅ សមុទ្រ ចិន ខាងត្បូង (DOC) និង ជំរុញ ឱ្យ អាស៊ាន និង ចិន ធ្វើ ការរួមគ្នា បន្ថែម ទៀត ដើម្បី សម្រេចបាន នូវ ក្រម ប្រតិបត្តិ នៅ សមុទ្រ ចិន ខាងត្បូង (COC) ៕
ការប្រកាស របស់ ចិន បាន បង្ហាញ តាមរយៈ លោក វ៉ាង យី សមាជិក ការិយាល័យ នយោបាយ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ត ចិន . ប្រធាន ការិយាល័យ គណៈកម្មការ កិច្ចការ បរទេស និង ជា រដ្ឋមន្ត្រី ការបរទេស ចិន ក្នុង ឱកាស អញ្ជើញ មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ចាប់ពី ថ្ងៃទី ២១ ដល់ ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ ។
ភាគី ទាំង ពីរ ក៏ បាន ឯកភាព ធ្វើ អានុភាវូបនីយកម្ម តួនាទី សម្របសម្រួល របស់ គណៈកម្មាធិការ សម្របសម្រួល អន្តរ រដ្ឋាភិបាល កម្ពុជា - ចិន ដើម្បី កសាង សហគមន៍ វាសនា រួម កម្ពុជា - ចិន ក្នុង យុគសម័យ ថ្មី ប្រកបដោយ គុណភាព ខ្ពស់ . កម្រិត ខ្ពស់ . និង ស្តង់ដារ ខ្ពស់ ព្រមទាំង រួមគ្នា ជំរុញ ពហុ ភាគី និយម និង សកល ភាវូបនីយកម្ម សេដ្ឋកិច្ច ដែល ផ្តល់ ផលប្រយោជន៍ រួម ប្រកបដោយ សេរី . បើក ចំហ . សមភាព និង បរិយា បន្ន ។
សេចក្តីប្រកាស ព័ត៌មាន រួម បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ភាគី ចិន បាន គូសបញ្ជាក់ សារជាថ្មី នូវ ការគាំទ្រ ចំពោះ ជម្រើស របស់ កម្ពុជា លើ មាគ៌ា អភិវឌ្ឍន៍ ដែល ស្រប នឹង លក្ខខណ្ឌ ជាតិ . គាំទ្រ ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ កម្ពុជា ដើម្បី ការពារ អធិបតេយ្យភាព ជាតិ . សន្តិសុខ និង ផលប្រយោជន៍ នៃ ការអភិវឌ្ឍ ព្រមទាំង ប្រឆាំង ដាច់ខាត ចំពោះ ការជ្រៀត ជ្រែក ពី ផ្នែក ខាងក្រៅ ក្នុង កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា » ។
ព្រះមហាក្សត្រ កម្ពុជា រៀបចំ ព្រះរាជ ពិធី ទទួលស្វាគមន៍ និង សវនាការ ជូន លោក ថង លុន ស៊ី សុលីត និង ជំទាវ ទី១ឡាវ ដែល មក បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ នៅ វេលា ម៉ោង ៩ព្រឹក ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ នេះ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន រៀបចំ ព្រះរាជ ពិធី ទទួលស្វាគមន៍ និង សវនាការ ជូន លោក ថង លុន ស៊ី សុលីត ប្រធាន រដ្ឋឡាវ និង ជំទាវ ទី១ឡាវ ណាលី ស៊ី សុលីត ដែល បាន មក បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ កម្ពុជា ។
ប្រមុខរដ្ឋ ឡាវ លោក ថង លុន ស៊ី សុលីត បាន អញ្ជើញ មកដល់ កម្ពុជា នៅ ម៉ោង ៧៖៣០ នាទី ព្រឹក ថ្ងៃអង្គារ នេះ ដើម្បី បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ រយៈពេល ពីរ ថ្ងៃ តប តាម ការអញ្ជើញ របស់ ព្រះមហាក្សត្រ កម្ពុជា ។
ក្នុង អំឡុង ពេល ទស្សនកិច្ច នៅ កម្ពុជា លោក ប្រធាន រដ្ឋ ក៏ នឹង មាន ជំនួប សម្តែង ការគួរសម ដាច់ដោយឡែក ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា . សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា និង សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ផងដែរ ៕
ប្រមុខរដ្ឋ ឡាវ អញ្ជើញ បំពាក់ កម្រង ផ្កា និង គោរព ព្រះវិញ្ញាណក្ខន្ធ ព្រះបរម រតន កោដ្ឋ នៅ វិមាន ឯករាជ្យ
( ភ្នំពេញ ) ៖ បន្ទាប់ពី បញ្ចប់ សវនាការ ចូល គាល់ ព្រះមហាក្សត្រ កម្ពុជា . នៅ វេលា ម៉ោង ៩៖៥០ នាទី ព្រឹក ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ នេះ លោក ថង លុន ស៊ី សុលីត ប្រធាន រដ្ឋឡាវ និង គណៈប្រតិភូ ជាន់ ខ្ពស់ ឡាវ បាន អញ្ជើញ ទៅកាន់ វិមាន ឯករាជ្យ ដើម្បី បំពាក់ កម្រង ផ្កា និង គោរព ព្រះវិញ្ញាណក្ខន្ធ ព្រះបរម រតន កោដ្ឋ ។
នៅក្នុង កិច្ចសន្ទនា តាម ទូរស័ព្ទ មួយ កាលពី ថ្ងៃចន្ទ ទី២២ ខែមេសា ដែល ត្រូវបាន ដកស្រង់ ចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP លោក បៃ ដិន ក៏ បាន បញ្ជាក់ ឡើងវិញ ផងដែរ ពី ការប្ដេជ្ញាចិត្ត របស់ សហរដ្ឋ អាមេរិក ចំពោះ អ៊ុយក្រែន ខណៈ ទីក្រុង កៀវ កំពុង ការពារ សេរីភាព របស់ ខ្លួន ប្រឆាំង នឹង ការឈ្លាន ពាន ពី រុស្ស៉ី ។ តាម លោក បៃ ដិន អាមេរិក នឹង ប្រញាប់ បញ្ជូន ជំនួយ យោធា ថ្មី ទៅ ឱ្យ អ៊ុយក្រែន ឱ្យ បាន ឆាប់ តាម ដែល អាច ធ្វើ ទៅ បាន ដើម្បី បំពេញ តម្រូវ ការចាំបាច់ នៅលើ សមរភូមិ និង ការការពារ ដែន អាកាស ។
រដ្ឋសភា អាមេរិក កាលពី សប្ដាហ៍ មុន បាន បោះឆ្នោត អនុម័ត លើ សេចក្ដីព្រាង ច្បាប់ មួយ ស្ដីពី កញ្ចប់ ជំនួយ យោធា ទំហំ ៦១ ពាន់ លាន ដុល្លារ សម្រាប់ អ៊ុយក្រែន បន្ទាប់ពី ជាប់គាំង អស់ រយៈពេល ជាច្រើន ខែ មក នេះ ។ សេចក្ដីព្រាង ច្បាប់ នេះ នឹង ត្រូវ បញ្ជូន បន្ត ទៅកាន់ ព្រឹទ្ធសភា សម្រាប់ ការបោះឆ្នោត អនុម័ត មុននឹង បញ្ជូន ទៅ លោក ចូ បៃ ដិន ចុះហត្ថលេខា ឱ្យ ក្លាយទៅជា ច្បាប់ ។
គួរ បញ្ជាក់ ថា នៅក្នុង កិច្ចសន្ទនា តាម ទូរស័ព្ទ លោក ហ្សេលេន ស្គី បាន អរគុណ ដល់ លោក បៃ ដិន សម្រាប់ ការគាំទ្រ ឥត ងាក រេដល់ ទីក្រុង កៀវ ហើយក៏ បាន ទទួលស្គាល់ ដែរ ថា លោក បៃ ដិន បាន ប្រាប់ រូបលោក ផ្ទាល់ ថា សហរដ្ឋ អាមេរិក នឹង ប្រញាប់ បញ្ជូន កញ្ចប់ ជំនួយ យោធា នេះ នៅពេល ត្រូវបាន ព្រឹទ្ធសភា អនុម័ត ៕
ចំណែក លោក Ismail al-Thawabta ជា ប្រធាន ការិយាល័យ ប្រព័ន្ធ ផ្សព្វផ្សាយ របស់ រដ្ឋាភិបាល ហាម៉ាស នៅក្នុង ដែនដី ប៉ាឡេស្ទីន ក៏ បាន អះអាង ដែរ ថា មាន សាកសព មនុស្ស ២៨៣ នាក់ ត្រូវបាន រកឃើញ នៅក្នុង មន្ទីរពេទ្យ ខាងលើ ខណៈ ការស្វែងរក សាកសព នៅ សេសសល់ អាចនឹង បន្ត ធ្វើឡើង រហូតដល់ ថ្ងៃព្រហស្បតិ៍ សប្ដាហ៍ នេះ ។ ប៉ុន្តែ ខាង យោធា អ៉ី ស្រាអែល មិន ទាន់ បាន ធ្វើ ការអត្ថាធិប្បាយ ឆ្លើយតប ទៅនឹង ការអះអាង នេះ នោះ ទេ ៕
រដ្ឋបាល ខេត្ត កំពង់ធំ ចេញ សេចក្តីជូនដំណឹង ពី ការត្រៀម បង្ការ គ្រោះមហន្តរាយ រាំងស្ងួត ឆ្នាំ ២០២៤ និង ក្រើន រំលឹក ពលរដ្ឋ ឱ្យ ប្រុងប្រយ័ត្ន ខ្ពស់
( កំពង់ធំ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ធំ បាន ចេញ សេចក្តីជូនដំណឹង ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ ក្រុង / ស្រុក ក្នុង ខេត្ត កំពង់ធំ ស្តីពី ការត្រៀម បង្ការ គ្រោះមហន្តរាយ រាំងស្ងួត ឆ្នាំ ២០២៤ ។
តាមរយៈ សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត កំពង់ធំ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ បាន ឱ្យដឹង ថា ដោយ ផ្អែក លើ ស្ថានភាព បច្ចុប្បន្ន រលក កម្ដៅ នៃ អាកាសធាតុ មាន ភាពក្តៅ ហួត ហែង រហូតដល់ កម្រិត សីតុណ្ហភាព ចន្លោះ ៣៩ - ៤០ អង្សារ សេ ដែល ស្ថិត នៅ កម្រិត ឱ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ។
តាមរយៈ សេចក្ដីជូនដំណឹង ដដែល រដ្ឋបាល ខេត្ត កំពង់ធំ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម បណ្តា ក្រុង / ស្រុក ក្នុង ខេត្ត កំពង់ធំ មេត្តា បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ក្នុង ការប្រើប្រាស់ ភ្លើង ចង្ក្រាន ដុត ទៀន ធូប នៅ តាម ផ្ទះសម្បែង រៀង ៗ ខ្លួន ពិសេស ការទុកដាក់ ប្រេងឥន្ធនៈ ឧស្ម័ន ចំហេះ វត្ថុ ដែល ងាយ ឆាបឆេះ ឬ ងាយ ផ្ទុះ ដែល បណ្តាលឱ្យ មាន អគ្គិភ័យ កើតឡើង ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត កំពង់ធំ៖ កម្ពុជា - ចិន ចេញ សេចក្តីប្រកាស ព័ត៌មាន រួម ស្តីពី ដំណើរទស្សនកិច្ច របស់ លោក វ៉ាង យី មកកាន់ កម្ពុជា និង កិច្ចប្រជុំ លើក ទី៧ នៃ គណៈកម្មាធិការ សម្របសម្រួល អន្តរ រដ្ឋាភិបាល កម្ពុជា - ចិន
( ភ្នំពេញ ) ៖ កម្ពុជា - ចិន នៅ ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន ចេញ សេចក្តីប្រកាស រួម មួយ ស្តីពី ដំណើរទស្សនកិច្ច របស់ លោក វ៉ាង យី សមាជិក ការិយាល័យ នយោបាយ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ត ចិន . ប្រធាន ការិយាល័យ គណៈកម្មការ កិច្ចការ បរទេស . និង ជា រដ្ឋមន្ត្រី ការបរទេស មកកាន់ ប្រទេស កម្ពុជា និង បើក កិច្ចប្រជុំ លើក ទី៧ នៃ គណៈកម្មាធិការ សម្របសម្រួល អន្តរ រដ្ឋាភិបាល កម្ពុជា - ចិន ចាប់ពី ថ្ងៃទី ២១ ដល់ ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស រួម៖ រដ្ឋមន្ត្រី សុខាភិបាល ណែនាំ ដល់ មន្ត្រី ក្រោម ឱវាទ ខិតខំ បំពេញ ការងារ ប្រកបដោយ ទំនួល ខុសត្រូវ ដើម្បី បំពេញ ភាពខ្វះចន្លោះ ឲ្យ មាន ភាពល្អ ប្រសើរ
( ភ្នំពេញ ) ៖ លោក សាស្ត្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន ណែនាំ ដល់ ថ្នាក់ដឹកនាំ មន្ត្រី បុគ្គលិក ទាំងអស់ ខិតខំ បំពេញ ការងារ ប្រកបដោយ ទំនួល ខុសត្រូវ ដើម្បី បំពេញ ភាពខ្វះចន្លោះ ឲ្យ មាន ភាពល្អ ប្រសើរ ។
ការថ្លែង ដូច្នេះ របស់ លោក សាស្ត្រាចារ្យ ក្នុង ឱកាស ដឹកនាំ កិច្ចប្រជុំ កម្រិត ថ្នាក់ដឹកនាំ លើក ទី២ នៃ ខែមេសា ដើម្បី ពិនិត្យ វឌ្ឍនភាព ការងារ និង លើក ទិសដៅ ការងារ បន្ត ដែល ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ នៅ ទីស្តីការ ក្រសួង សុខាភិបាល ។
ក្នុង នោះ គោលដៅ ដែល ត្រូវ យកចិត្តទុកដាក់ គឺ ត្រូវកាត់បន្ថយ អត្រា ឈឺ ដោយ ជំងឺ មិន ឆ្លង ជំរុញ នូវ ការ លើកកម្ពស់ សុខភាព បន្ត ពូជ ម្តាយ និង ទារក បង្កើន សមត្ថភាព ស្ថាប័ន ដើម្បី ផ្លាស់ប្តូរ ការដឹកនាំ ឱ្យ ត្រូវ នឹង បរិបទ បច្ចុប្បន្ន ជំរុញឱ្យ មាន កិច្ចសហប្រតិបត្តិការ រវាង ស្ថាប័ន អង្គភាព ព្រមទាំង ភាគី ពាក់ព័ន្ធ ទាំងឡាយ ។
ជា ចុងក្រោយ លោក សាស្រ្តាចារ្យ រដ្ឋមន្ត្រី ក្រើន រំលឹក ដល់ ថ្នាក់ដឹកនាំ ត្រូវ ត្រៀម ចំពោះ បញ្ហា ប្រឈម ចំពោះ មុខ ដូចជា ឆ្លើយតប ជាមួយ តម្រូវការ របស់ ប្រជាពលរដ្ឋ ទាក់ទង នឹង ជំងឺ ឆ្លង សុខភាព សាធារណៈ ដោយ បង្កើន ការផ្សព្វផ្សាយ សារ អប់រំ សុខភាព រហូតដល់ កាត់បន្ថយ នូវ ជំងឺ រ៉ាំរ៉ៃ ដែល អាចនឹង បណ្តាលឱ្យ ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច គ្រួសារ និង តាមដាន ការងារ ទប់ស្កាត់ ជំងឺ ឆ្លង ដូចជា ជំងឺ អេដស៍ ជំងឺ គ្រុនចាញ់ ។ល ។
សូម បញ្ជាក់ ផងដែរ កិច្ចប្រជុំ រៀបចំឡើង តាមរយៈ ប្រព័ន្ធ ហ៊ីប្រីដ៍ (Hybrid) ដែល មាន ការអញ្ជើញ ចូលរួម ផ្ទាល់ នៅ ទីស្តីការ ក្រសួង សុខាភិបាល រួម មាន រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ ទីប្រឹក្សា អគ្គ នាយក អគ្គ នាយក រង អគ្គាធិការ អគ្គាធិការ រង ប្រធានាយកដ្ឋាន នៃ ក្រសួង សុខាភិបាល ប្រធាន មន្ទីរ សុខាភិបាល នៃ រដ្ឋបាល រាជធានី ភ្នំពេញ និង ថ្នាក់ដឹកនាំ ដែល ជា ទីប្រឹក្សា នៅ តាម បណ្តា ខេត្ត តាមរយៈ ប្រព័ន្ធ វីដេអូ សន្និសីទ ៕
ប្រមុខរដ្ឋ ឡាវ ឯកឧត្តម ថង លុន ស៊ី សុលីត បាន អញ្ជើញ មកដល់ រាជធានី ភ្នំពេញ ដើម្បី បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ កម្ពុជា (Video inside) ( ភ្នំពេញ ) ៖ ប្រមុខរដ្ឋ ឡាវ ឯកឧត្តម ថង លុន ស៊ី សុលីត បាន អញ្ជើញ បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា នៅ ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ នេះ ហើយ ។ ដំណើរទស្សនកិច្ច ដែល មាន រយៈពេល ពីរ ថ្ងៃ ធ្វើឡើង តប តាម ការអញ្ជើញ របស់ ព្រះមហាក្សត្រ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ។
ឯកឧត្តម ប្រធាន រដ្ឋ ក៏ នឹង មាន ជំនួប សម្តែង ការគួរសម ដាច់ដោយឡែក ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា និង សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ក្នុង ជំនួប នោះ លោក វ៉ាង យី បាន សន្យា ថា ចិន នឹង ពង្រឹង កិច្ចសហប្រតិបត្តិការ ជាមួយ រដ្ឋាភិបាល ថ្មី គាំទ្រ ការពារ សន្តិសុខ ជូន សម្ដេច និង ក្រុមគ្រួសារ និង យកចិត្តទុកដាក់ រវាង បក្ស ទាំង ពីរ ដើម្បី រួមចំណែក ក្នុង ការផ្លាស់ប្ដូរ ព័ត៌មាន ប្រឆាំង ដាច់ខាត ការធ្វើ បដិវត្តន៍ ពណ៌ ខិតខំ អភិវឌ្ឍន៍ ជាពិសេស អ្វី ដែល មាន ការព្រមព្រៀង គ្នា ពីមុន មក ដើម្បីឲ្យ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ កាន់តែ រឹងមាំ និង រីកចម្រើន បន្ថែម ទៀត ។
លោក បន្ត ទៀត ថា ថ្នាក់ដឹកនាំ ចិន មាន ការយកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ មេដឹកនាំ កម្ពុជា ។ លោក បាន មានប្រសាសន៍ បញ្ជាក់ ថា ការផ្លាស់ប្ដូរ ពី ជំនាន់ ចាស់ មក ជំនាន់ ថ្មី នេះ គឺ បាន ដើរ លើ មាគ៌ា ដ៏ ត្រឹមត្រូវ ហើយ លោក សង្ឃឹម ថា មិត្តភាព រវាង កម្ពុជា និង ចិន និង កាន់តែ បន្ត រីកចម្រើន ហើយ ចិន នៅតែ ជា ដៃគូ ដ៏ គួរឲ្យ ទុកចិត្ត របស់ កម្ពុជា ។
សម្ដេច តេជោ បាន មានប្រសាសន៍ រំលឹក ថា កាលពី ខែសីហា កន្លងទៅ នេះ លោក Wang Yi ក៏ ធ្លាប់ បាន មក ធ្វើ ទស្សនកិច្ច នៅ កម្ពុជា ផងដែរ ដែល រហូតមកដល់ ពេលនេះ មិន ដល់ រយៈពេល មួយ ឆ្នាំ ផង លោក បាន អញ្ជើញ មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ម្ដង ទៀត ដែល នេះ បង្ហាញ ឲ្យ ឃើញ ច្បាស់ ពី ការយកចិត្តទុកដាក់ របស់ ថ្នាក់ដឹកនាំ ចិន ចំពោះ កម្ពុជា ។
សម្ដេច តេជោ បាន មានប្រសាសន៍ បន្ត ទៀត ថា លោក Wang Yi មកកាន់ កម្ពុជា នា ពេលនេះ ក្រោយពេល នៃ ការផ្លាស់ប្ដូរ អ្នក បន្ត វេន ជំនាន់ ក្រោយ ដែល ពេលនេះ អ្វី ៗ គឺ ដំណើរការ ទៅ ដោយ រលូន ទាំង ស្ថិរភាព នយោបាយ សេដ្ឋកិច្ច ក៏ ដំណើរការ ល្អ ហើយ មាន ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ។
លោក ក៏ បាន ជម្រាប ជូន សម្ដេច តេជោ អំពី សកម្មភាព នៃ ដំណើរទស្សនកិច្ច របស់ លោក មកកាន់ ប្រទេស កម្ពុជា ជាពិសេស នៅក្នុង កិច្ចប្រជុំ នៃ គណៈកម្មការ ចម្រុះ កាលពី ព្រឹក ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ ដែល បាន ទទួល លទ្ធផល ដ៏ ល្អ ប្រសើរ ហើយ អ្វី ៗ រវាង ប្រទេស យើង ទាំង ពីរ ក៏ ដូចជា បក្ស ទាំង ពីរ គឺ យើង បាន ឈានដល់ ដំណាក់កាល ថ្មី មួយ ទៀត ។
លោក បាន លើក សរសើរ ពី គុណសម្បត្តិ របស់ សម្ដេច តេជោ ដែល មាន ទស្សនៈ វិស័យ វែងឆ្ងាយ ក្នុង ការផ្ទេរ អំណាច ពី ជំនាន់ ចាស់ មកកាន់ ជំនាន់ ថ្មី ដោយ ភាព រលូន ។ ជាមួយគ្នា នោះ ផងដែរ លោក ក៏ បាន ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ លោក ស៊ី ជិន ពីង ប្រធានាធិបតី ចិន ពី នាយក រដ្ឋមន្ត្រី ចិន លី ឈាង ពី ប្រធាន សភា ចិន និង ថ្នាក់ដឹកនាំ ចិន ដទៃ ទៀត ។
លោក ក៏ បាន អបអរសាទរ ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន ឈ្នះ ការបោះឆ្នោត ជ្រើសរើស សមាជិក ព្រឹទ្ធសភា នា ពេល កន្លងទៅ ថ្មី ៗ នេះ ហើយ អបអរសាទរ ចំពោះ សម្តេច តេជោ ដែល ក្លាយជា ប្រធាន ព្រឹទ្ធសភា នា ពេលនេះ ផងដែរ ។
លោក បាន បញ្ជាក់ ថា អ្វី ៗ ដែល កើត មាន ឡើង នេះ គឺ កើត ចេញ ពី ការខិតខំ ប្រឹងប្រែង ប្រកបដោយ ភាពឈ្លាសវៃ របស់ សម្ដេច តេជោ ពេល សម្ដេច នៅ ជា នាយក រដ្ឋមន្ត្រី ដែល សម្ដេច ជា អ្នកនយោបាយ ដែល មាន ចក្ខុវិស័យ ច្បាស់លាស់ ។
សម្ដេច តេជោ ប្រធាន ព្រឹទ្ធសភា ក៏ បានអំណរគុណ ចំពោះ លោក Wang Yi ដែល បាន ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ ថ្នាក់ដឹកនាំ នៃ ប្រទេស ចិន ។
សម្ដេចក៏ បាន មានប្រសាសន៍ ជំរុញ ឲ្យ មាន ការផ្លាស់ប្ដូរ ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ ការផ្លាស់ប្ដូរ ប្រជាជន និង ប្រជាជន ៕ អនាគត របស់ អ្នក នឹង បាត់បង់ ប្រសិនបើ អ្នក ជួប គ្រោះថ្នាក់ ចរាចរណ៍ ! ស្លាប់ ៧នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២២ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ និង របួស ធ្ងន់ ស្រាល ១០នាក់ ។
ឯកឧត្ដម បណ្ឌិត ហេង វុទ្ធី និង លោកជំទាវ កេត រ៉ាឌី សមាជិក សភា ពាណិជ្ជកម្ម កម្ពុជា បរិច្ចាគ ថវិកា ១ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ ឯកឧត្ដម បណ្ឌិត ហេង វុទ្ធី និង លោកជំទាវ កេត រ៉ាឌី សមាជិក សភា ពាណិជ្ជកម្ម កម្ពុជា បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
ឯកឧត្ដម បណ្ឌិត ហេង វុទ្ធី និង លោកជំទាវ កេត រ៉ាឌី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម ស៊ុយ សែម និង លោកជំទាវ ជា ខេង បរិច្ចាគ ថវិកា ៥ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ស៊ុយ សែម តំណាងរាស្ដ្រ ខេត្ដ ពោធិ៍សាត់ និង លោកជំទាវ ជា ខេង បាន បរិច្ចាគ ថវិកា ចំនួន ៥ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
ឯកឧត្ដម ស៊ុយ សែម និង លោកជំទាវ ជា ខេង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម ង៉ាន់ ភិរម្យ និង លោកជំទាវ បរិច្ចាគ ថវិកា ៥លាន រៀល ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ង៉ាន់ ភិរម្យ ទីប្រឹក្សា ឯកឧត្ដម អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ៥លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
ឯកឧត្ដម ង៉ាន់ ភិរម្យ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ លោក អេង ថា និង លោកស្រី ( សណ្ឋាគារ ស៊ីសាយ កំពង់សោម ) បាន បរិច្ចាគ ថវិកា ចំនួន ២ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
លោក អេង ថា និង លោកស្រី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក សោម សុឌីម៉ង់ និង លោកស្រី សួន វល័ក្ខ ( ម្ចាស់ ហាង បង្អែម រំដួល ) បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ លោក សោម សុឌីម៉ង់ និង លោកស្រី សួន វល័ក្ខ ( ម្ចាស់ ហាង បង្អែម រំដួល ) បាន បរិច្ចាគ ថវិកា ចំនួន ៥០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
លោក សោម សុឌីម៉ង់ និង លោកស្រី សួន វល័ក្ខ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឧកញ៉ា អ៊ុក សំរិទ្ធិ ពេជ្រ និង លោកជំទាវ សាម សុភា បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ ឧកញ៉ា អ៊ុក សំរិទ្ធិ ពេជ្រ និង លោកជំទាវ សាម សុភា បាន បរិច្ចាគ ថវិកា ចំនួន ៥០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
ឧកញ៉ា អ៊ុក សំរិទ្ធិ ពេជ្រ និង លោកជំទាវ សាម សុភា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ក្រុមហ៊ុន ល្បី STEFANO RICCI ជ្រើស ទីតាំង ពាក់ព័ន្ធ បេតិកភណ្ឌ វប្បធម៌ ស្ថាបត្យកម្ម និង ធនធាន ធម្មជាតិ របស់ ខ្មែរ ដើម្បី ថត រូប សម្រាប់ ផ្សព្វផ្សាយ ភ្ជាប់ ជាមួយ ផលិតផល ទៅកាន់ ពិភពលោក
( កំពង់ឆ្នាំង ) ៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ នា ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ បាន ដឹកនាំ ប្រតិភូ និង មន្ដ្រី ជំនាញ នៃ នាយកដ្ឋាន ផ្គត់ផ្គង់ ទឹក ជន បទ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ចុះ ពិនិត្យ ស្ថានភាពប្រភព ផ្គត់ផ្គង់ ទឹក សម្រាប់ ប្រើប្រាស់ របស់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង ស្រុក ទឹក ផុស និង ស្រុក សាមគ្គី មាន ជ័យ ខេត្ត កំពង់ឆ្នាំង ។
នៅ ស្រុក ទឹក ផុស លោក រដ្ឋមន្ត្រី បាន ចុះ ពិនិត្យ ស្ថានភាពអណ្តូង ស្នប់ ទឹក ចំនួន ២កន្លែង និង ស្រះ ទឹក សហគមន៍ មួយ កន្លែង ដែល រីងស្ងួត ស្ថិត ក្នុង ឃុំ ក្រាំង ស្គា និង ស្រះ ទឹក សហគមន៍ មួយ កន្លែង ទៀត ដែល គោក រាក់ ស្ថិត ក្នុង ឃុំ ក្តុល សែន ជ័យ ។
បន្ទាប់មក លោក រដ្ឋមន្ត្រី បាន បន្ដ ចុះ ពិនិត្យ ស្ថានភាពប្រភព ផ្គត់ផ្គង់ ទឹក សម្រាប់ ប្រើប្រាស់ របស់ សហគមន៍ ដែល រួម មាន អណ្ដូង លូ អណ្ដូង ស្នប់ និង ពាង យក្ស ស្តុក ទឹកភ្លៀង នៅ តាម ខ្នង ផ្ទះ ប្រជាពលរដ្ឋ ដែល រស់ ក្នុង ភូមិសាស្ដ្រ ឃុំ ចំនួន ៤ទៀត គឺ ឃុំ ខ្នាឆ្មារ ឃុំ សេដ្ឋី ឃុំ ស្វាយ និង ឃុំ ឈានឡើង ស្រុក សាមគ្គី មាន ជ័យ ។
សូម បញ្ជាក់ ថា ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន យកចិត្តទុកដាក់ ខ្ពស់ បំផុត ចំពោះ ការខ្វះខាត ទឹក ប្រើប្រាស់ របស់ ប្រជាជន ទូទាំង ប្រទេស អាស្រ័យ ហេតុ នេះ ក្រសួង ក៏ បាន ចេញ សេចក្ដីណែនាំ ដល់ ថ្នាក់ដឹកនាំ និង អង្គភាព ក្រោម ឱវាទ ក្រសួង ទាំងអស់ ចាត់ វិធានការ និង កិច្ចអន្តរាគមន៍ បន្ទាន់ លើ ការខ្វះខាត ទឹក ប្រើប្រាស់ និង ទឹក បរិភោគ ដោយសារ កត្តា ប្រែប្រួល ធាតុអាកាស ៕ អ្នកនាំពាក្យ ខុទ្ទកាល័យ នាយក រដ្ឋមន្រ្តី បង្ហាញ លទ្ធផល ជំនួប រវាង សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជាមួយ វ៉ាង យី
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ ខុទ្ទកាល័យ នាយក រដ្ឋមន្រ្តី នៅ យប់ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ លទ្ធផល ផ្លូវការ នៃ ជំនួប រវាង សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោក វ៉ាង យី (WANG YI) រដ្ឋមន្ត្រី ការបរទេស សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល ធ្វើឡើង នា រសៀល ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ នៅ វិមាន សន្តិភាព ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ អ្នកនាំពាក្យ ខុទ្ទកាល័យ នាយក រដ្ឋមន្រ្តី៖ មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង អប់ រំ៖ ព្រឹត្តិការណ៍ បោះជំរំ អន្តរជាតិ នា ពេលនេះ បាន ដើរ តួនាទី សំខាន់ ក្នុង ការអប់រំ ចិត្ត គំនិត និង ស្មារតី
( ភ្នំពេញ ) ៖ មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ឱ្យដឹង ថា ព្រឹត្តិការណ៍ បោះជំរំ អន្តរជាតិ នា ពេលនេះ បាន ដើរ តួនាទី សំខាន់ ក្នុង ការអប់រំ ចិត្ត គំនិត និង ស្មារតី ដែល ជា មូលដ្ឋានគ្រឹះ ដ៏ រឹងមាំ ក្នុង ភាព ជា អ្នកដឹកនាំ ដ៏ ត្រឹមត្រូវ និង អ្នក បន្ត វេន របស់ ប្រទេសជាតិ ។
លោក បណ្ឌិត បន្ដ ថា ការផ្លាស់ប្តូរ ចេញ ពី ចិត្ត គំនិត និង ការផ្លាស់ប្តូ រ ទាំងស្រុង ចេញ ពី ដែន កំណត់ ដ៏ តូច ចង្អៀត របស់ មនុស្ស គឺ អាច ធ្វើឲ្យ យើង ចេះ គ្រប់គ្រង ខ្លួន ឯង ចំពោះ មុខ នូវ គ្រប់ ស្ថានភាព ។ បាតុភូត នៃ ការគិត និង ចំណង់ របស់ យុវជន តែងតែ កើនឡើង លឿន ជាង សេដ្ឋកិច្ច គ្រួសារ ពោលគឺ ចង់បាន ភាពសុខ ស្រួល ប៉ុន្តែ មិន អាច គ្រប់គ្រង ចំណង់ របស់ ខ្លួន បាន ពុំ ស្គាល់ ពី ដំណោះស្រាយ បញ្ហា របស់ ខ្លួន ប្រកបដោយ ប្រសិទ្ឋភាព នោះ ទេ ។
វិភាគ អន្តរជា តិ៖ ហេតុ អ្វី ឥណ្ឌូណេស៊ី ផ្អៀង ទៅ រក ចិន ?
( ភ្នំពេញ ) ៖ ប្រមុខ ការទូត ចិន លោក វ៉ាង យី បាន ប្រកាស បង្ហាញ ជំហរ រដ្ឋាភិបាល របស់ ខ្លួន បន្ត ប្រឹងប្រែង គាំទ្រ ដល់ កិច្ចអភិវឌ្ឍន៍ របស់ កម្ពុជា តាមរយៈ ជំរុញ វិស័យ កសិកម្ម ឧស្សាហកម្ម និង បច្ចេកវិទ្យា ។
ក្នុង ជំនួប ជាមួយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា នា រសៀល ថ្ងៃចន្ទ ទី២២ ខែមេសា ឆ្នាំ ២០២៤ នេះ លោក វ៉ាង យី បាន លើកឡើង ថា ចិន និង កម្ពុជា គឺជា មិត្ត ដ៏ ជិតស្និទ្ធ និង ស្មោះត្រង់ ជាមួយគ្នា ។ លោក វ៉ាង យី បាន សម្តែង ក្ដី សោមនស្ស រីករាយ ដែល រដ្ឋាភិបាល ទាំង ពីរ បាន អនុវត្ត កិច្ចសហប្រត្តិការ ទាំងឡាយ បាន យ៉ាង ល្អ ក្នុង ភាពជាដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ ហើយ បាន ជំរុញ ចំណង មិត្តភាព ចិន - កម្ពុជា កាន់តែ រឹងមាំ ដូច ដែក ថែប ។
ប្រមុខ ការទូត ចិន ដែល ចេញ ចូល កម្ពុជា យ៉ាង ញឹកញាប់ រូប នេះ បាន គូស រំលេច ថា កម្ពុជា មាន តួនាទី កាន់តែ សំខាន់ លើ ឆាក អន្តរជាតិ ហើយ ដំណើរទស្សនកិច្ច ផ្លូវការ លើក ដំបូង របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នៅ ចិន កាលពី ឆ្នាំ ២០២៣ បាន ឆ្លុះបញ្ចាំង និង បាន រួមចំណែក រឹត ចំណង ទំនាក់ទំនង មិត្តភាព និង សាមគ្គីភាព ចិន - កម្ពុជា ឱ្យ កាន់តែ ស្អិត រមួត បន្ថែម ទៀត ។
ប្រមុខ ការទូត ចិន បាន គូសបញ្ជាក់ ថា ទស្សនកិច្ច របស់ លោក នៅ កម្ពុជា ពេលនេះ នឹង បន្ត គាំទ្រ និង ជំរុញ កិច្ចសហប្រតិបត្តិការ នៃ ការកសាង សហគមន៍ វាសនា រួម ចិន - កម្ពុជា ក្នុង យុគសម័យ ថ្មី ឱ្យ លេចចេញ ជា រូបរាង និង មាន ដំណើរការ កាន់តែ រឹងមាំ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន សម្តែង ការស្វាគមន៍ លោក រដ្ឋមន្ត្រី វ៉ាង យី និង គណៈប្រតិភូ ប្រកបដោយ ភាពកក់ក្តៅ បំផុត ចំពោះ ដំណើរ បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ។ សម្តេច ធិបតី បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហប្រតិបត្តិការ កម្ពុជា - ចិន ដែល បាន រួមចំណែក ក្នុង ការជំរុញ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច កម្ពុជា ឱ្យ មាន ការរីកចម្រើន ។
បន្ថែម ពីលើ នេះ សម្តេច ធិបតី ក៏ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ គំនិត ផ្តួចផ្តើម ខ្សែក្រវ៉ាត់ និង ផ្លូវ (BRI) ដែល បាន រួមចំណែក ផ្តល់ លទ្ធភាព ដល់ កម្ពុជា ក្នុង ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ ដូចជា ផ្លូវ លឿន ភ្នំពេញ - ក្រុង ព្រះសីហនុ និង អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ជាដើម ដែល បាន រួមចំណែក ដល់ កំណើន សេដ្ឋកិច្ច កម្ពុជា ។
សម្តេច ធិបតី ក៏ បាន បង្ហាញ ក្តីរីករាយ និង វាយតម្លៃ ខ្ពស់ អំពី វឌ្ឍនភាព នៃ ក្របខ័ណ្ឌ កិច្ចសហប្រតិបត្តិការ ត្បូង ពេជ្រ ដែល ប្រទេស ទាំង ពីរ បាន ឯកភាព កាលពី ឆ្នាំ ២០២៣ ។
តាមរយៈ ការកំណត់ យក ឆ្នាំ ២០២៤ ជា ឆ្នាំ នៃ ការផ្លាស់ប្តូរ រវាង ប្រជាជន និង ប្រជាជន សម្តេច ធិបតី មាន ជំនឿ ជាក់ ថា រំហូរ វិនិយោគ និង អ្នកទេសចរ មកពី ប្រទេស ចិន នឹង កើនឡើង ថែម ទៀត ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ស្នើ ចិន ពិនិត្យ លទ្ធភាព ជំរុញ កិច្ចសហប្រតិបត្តិការ បង្កើត តំបន់ ពាណិជ្ជកម្ម សេរី កម្ពុជា - ចិន និង តំបន់ សេដ្ឋកិច្ច ពិសេស បន្ថែម ទៀត ៕ ឧប នាយក រដ្ឋមន្ត្រី ប្រចាំ ការ វង្សី វិស្សុត បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី « ទស្សនវិជ្ជា នយោបាយ - រដ្ឋបាល - ច្បាប់ »
គណៈ រដ្ឋមន្រ្តី និស្សិត មកពី សាកលវិទ្យាល័យ នានា សរុប ប្រមាណ ជាង ៤០០ នាក់ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រចាំ ការបាន ចាត់ទុក ប្រធានបទ ស្តីពី ទស្សនវិជ្ជា នយោបាយ - រដ្ឋបាល - ច្បាប់ ពិតជា មាន សារសំខាន់ និង ឆ្លើយតប ទៅនឹង តួនាទី និង ភារកិច្ច របស់ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ដែល ជា សេនាធិការ ជូន រាជ រដ្ឋាភិបាល សម្រាប់ សម្របសម្រួល ការងារ ប្រចាំ ថ្ងៃ របស់ គណៈ រដ្ឋមន្ត្រី ទាំងមូល ក៏ ដូចជា សម្រាប់ នាយក រដ្ឋមន្ត្រី ជាពិសេស លើ ការងារ ពិនិត្យ និង កែសម្រួល គោល នយោបាយ និង ផែនការ យុទ្ធសាស្ត្រ ជាតិ ក្នុង វិស័យ រដ្ឋបាល និង ច្បាប់ ។
លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រចាំ ការ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ លោក បណ្ឌិត សាយ បូរី ដែល ជា វាគ្មិន កិត្តិយស ដ៏ មាន សក្តានុពល និង ពោរពេញ ដោយ សមត្ថភាព និង បទពិសោធន៍ ដែល បាន លះបង់ ពេលវេលា ដ៏ មាន តម្លៃ ស្ម័គ្រចិត្ត ចែករំលែក ចំណេះដឹង និង បទពិសោធន៍ ដល់ វគ្គ បណ្តុះបណ្តាល នេះ ៕
សំណុំរឿង អត្រានុកូលដ្ឋាន ប្រចាំ សប្តាហ៍ ទី១៣ គិត ត្រឹម ថ្ងៃទី ១៩ ខែមេសា សាលាដំបូង ខេត្ត ឧត្តរមានជ័យ ចាត់ការ រួច បាន ៣៥៩ សំណុំរឿង
( ឧត្តរមានជ័យ )៖ លោក អ៊ុំ ចាន់ថុល ប្រធាន សាលាដំបូង ខេត្ត ឧត្តរមានជ័យ បាន ថ្លែង ថា សំណុំរឿង អត្រានុកូលដ្ឋាន ប្រចាំ សប្តាហ៍ ទី១៣ គិត ត្រឹម ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២៤ សាលាដំបូង ខេត្ត ឧត្តរមានជ័យ ចាត់ការ រួច បាន ចំនួន ៣៥៩ សំណុំរឿង ។
ថ្លែង ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News នៅ ល្ងាច ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ នេះ លោក អ៊ុំ ចាន់ថុល បញ្ជាក់ ថា សំណុំរឿង អត្រានុកូលដ្ឋាន មុន យុទ្ធនាការ មាន ចំនួន ១៤០ រឿង សំណុំរឿង អត្រានុកូលដ្ឋាន ក្នុង ពេល យុទ្ធនាការ មាន ចំនួន ២៨៥ រឿង សំណុំរឿង ចាត់ការ រួច ក្នុង រយៈពេល ៣ខែ មាន ចំនួន ៣៥៩ រឿង និង សំណុំរឿង អត្រានុកូលដ្ឋាន កំពង់ចាត់ការ មាន ចំនួន ៦៦ រឿង ។
បើ តាម លោក ប្រធាន សាលាដំបូង ខេត្ត ឧត្តរមានជ័យ ការស្នើសុំ កែតម្រូវ សំបុត្រ កំណើត មាន ចំនួន ៤០៧ រឿង ស្មើនឹង ៩៥. ៧៦ % កែ សំបុត្រ អាពាហ៍ពិពាហ៍ មាន ចំនួន ១១រឿង ស្មើ ២. ៥៨% កែ សំបុត្រ មរណភាព មាន ចំនួន ៧រឿង ស្មើនឹង ១. ៦៥% ។ លោក បញ្ជាក់ ថា មូលហេតុ នៃ កំហុស ដែល នាំឱ្យ មាន ការស្នើសុំ កែតម្រូវ ដោយសារ កំហុស មន្ត្រី អត្រានុកូលដ្ឋាន និង ដោយ សាមីខ្លួន ផ្ទាល់ ។
លោក អ៊ុំ ចាន់ថុល បាន ថ្លែង បញ្ជាក់ យ៉ាង ដូច្នេះ ទៀត ថា ការស្នើសុំ កែតម្រូវ សំណុំរឿង អត្រានុកូលដ្ឋាន គឺ មិន តម្រូវ ឱ្យ មាន ការបង់ប្រាក់ ឡើយ ហើយ ចំពោះ រយៈពេល គឺ យ៉ាង យូរ មួយ សប្តាហ៍ ប្រជាពលរដ្ឋ អាច មក ទទួល ដើម្បី យក ទៅ ប្រើប្រាស់ បាន ៕ ក្រសួង មុខងារ សាធារណៈ ចុះ MoU ជាមួយ ក្រសួង បុគ្គលិក ទទួល បណ្តឹង សាធារណៈ និង សោធន និវត្តន៍ នៃ សាធារណរដ្ឋ ឥណ្ឌា
( ភ្នំពេញ ) ៖ ក្រសួង មុខងារ សាធារណៈ និង ក្រសួង បុគ្គលិក ទទួល បណ្តឹង សាធារណៈ និង សោធន និវត្តន៍ នៃ សាធារណរដ្ឋ ឥណ្ឌា បាន ចុះ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ស្តីពី កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អភិវឌ្ឍន៍ ធនធាន មនុស្ស ក្នុង វិស័យ មុខងារ សាធារណៈ ។
អនុស្សរណៈ នៃ ការយោគយល់ គ្នា នេះ សង្កត់ធ្ងន់ លើ ការអនុវត្ត ជាក់ស្តែង និង ធ្វើជា ឧទាហរណ៍ នៃ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ប្រកបដោយ ប្រសិទ្ធភាព ក្នុង វិស័យ សេវាកម្ម ស៊ីវិល ។
សូម ជម្រាប ថា ក្រសួង មុខងារ សាធារណៈ បាន ចាប់ផ្ដើម សហការ ការងារ ជាមួយ ស្ថានទូត ឥណ្ឌា ប្រចាំ នៅ កម្ពុជា ក៏ ដូចជា ភាគី នៃ សាធារណរដ្ឋ ឥណ្ឌា ចាប់តាំងពី ឆ្នាំ ២០១៥មក ក្នុង កិច្ចសហប្រតិបត្តិការ ដើម្បី លើកកម្ពស់ វិស័យ មុខងារ សាធារណៈ នៃ ប្រទេស ទាំង ពីរ ឲ្យ កាន់តែ ប្រសើរឡើង ៕
ក្រសួង ទេសចរណ៍ ឯកភាព ជំរុញ កិច្ច ប្រតិបត្តិការ ជាមួយ រដ្ឋបាល ខេត្ត ហឺណាន ក្រោម ស្មារតី « ឆ្នាំ ផ្លាស់ប្តូរ ប្រជាជន និង ប្រជាជន កម្ពុជា - ចិន ២០២៤ »
ក្នុង កិច្ចប្រជុំ នេះ លោក រដ្ឋមន្ត្រី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ដំណើរទស្សនកិច្ច របស់ លោក ស៊ុន សូវ កាង និង បាន ថ្លែងអំណរគុណ ចំពោះ លោក ដែល គាំទ្រ ដល់ ស្មារតី “ ឆ្នាំ នៃ ការផ្លាស់ប្តូរ ប្រជាជន និង ប្រជាជន កម្ពុជា - ចិន ២០២៤ ” តាមរយៈ ការសហការ រៀបចំ “ ការសម្តែង ក្បាច់គុន សាវលីញ និង ល្បុក្កតោ នៅ អង្គរ ” ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៤ នៅ បរិវេណ ខាងជើង ប្រាសាទ បាយ័ន ខេត្ត សៀមរាប ដើម្បី ជួយ ដល់ ការទាក់ទាញ ទេសចរ អន្តរជាតិ ជាពិសេស ទេសចរ ចិន មកកាន់ ខេត្ត សៀមរាប ។
លោក រដ្ឋមន្ត្រី ក៏ បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ ក្រោម ការដឹកនាំ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា មាន ការយកចិត្តទុកដាក់ ខ្ពស់ ដល់ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ដែល ជា ចលករ ដ៏ សំខាន់ មួយ ក្នុង ការចូលរួម ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច កម្ពុជា ។
លោក ស៊ុន សូវ កាង បាន លើកឡើង ថា កម្ពុជា ជា មិត្ត ដ៏ ស្មោះត្រង់ របស់ ចិន ហើយ តែង គាំទ្រ គោល នយោបាយ ចិន និង បាន ប្ដេជ្ញា ចូលរួម គាំទ្រ អនុវត្ត នូវ វិធានការ និង សកម្មភាព យុទ្ធសាស្ត្រ នានា ដែល បាន ដាក់ចុះ ក្នុង ការស្ដារ វិស័យ ទេសចរណ៍ កម្ពុជា ឡើងវិញ ។
លោក រដ្ឋមន្ត្រី សុខ សូកេន និង លោក ស៊ុន សូវ កាង បាន ចុះហត្ថលេខា លើ កំណត់ហេតុ នៃ កិច្ចប្រជុំ ដោយ ផ្តោត លើ ការជំរុញ អនុវត្ត « គម្រោង ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា - ហឺ ណាន - អាស៊ាន “ « គម្រោង វិថី សូត្រ ផ្លូវ អាកាស ” និង បាន ឯកភាព បង្កើត ក្រុមការងារ ដើម្បី អនុវត្ត ខ្លឹមសារ កំណត់ហេតុ នៃ កិច្ចប្រជុំ ខាងលើ នេះ ឱ្យ ទទួលបាន ប្រសិទ្ធភាព ខ្ពស់ ដើម្បី គាំទ្រ ដល់ ការអភិវឌ្ឍ ទេសចរណ៍ នៃ ប្រទេស ទាំង ពីរ ៕ កម្ពុជា នឹង មាន ភូមិ ខ្មែរ នៅ ប្រទេស ជប៉ុន នា ពេល ខាងមុខ
ក្នុង កិច្ចពិភាក្សា ដែល ធ្វើឡើង នៅ ទីស្តីការ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ គណៈប្រតិភូ នៃ ក្រុមហ៊ុន កុជី ម៉ា(KOJIMA HOLDINGS) ដែល ជា អ្នក ផ្តើម គំនិត វិនិយោគ បង្កើត ភូមិ ខ្មែរ នេះ បាន ជម្រាប ជូន ឯកឧត្តម រដ្ឋមន្ត្រី អំពី ដំណើរការ រៀបចំ និង ការតុបតែង ដើម្បីឱ្យ កសិដ្ឋាន របស់ ខ្លួន ទៅជា ទីតាំង ដែល មាន សោភណ្ឌភាព ជា ខ្មែរ ដើម្បី ទាក់ទាញ ការចាប់អារម្មណ៍ ពីសំណាក់ ភ្ញៀវ បរទេស ភ្ញៀវ ជប៉ុន ក៏ ដូចជា ពលរដ្ឋ ខ្មែរ ដែល កំពុង ធ្វើ ការ ស្នាក់ នៅ និង រៀនសូត្រ នៅ ប្រទេស ជប៉ុន ។
សូម បញ្ជាក់ ថា លោក រដ្ឋមន្ត្រី ការងារ កាលពី ថ្ងៃទី ១៨ ខែធ្នូ ឆ្នាំ ២០២៣ ធ្លាប់ បាន ទៅ ទស្សនកិច្ច ដល់ ទីតាំង ដើម្បី ពិនិត្យមើល ការផ្តើម ការសាងសង់ ។ ដើម្បី ធ្វើឱ្យ ទីតាំង មាន សោភណ្ឌភាព ជា ខ្មែរ ក្រសួង ការងារ និង បណ្តុះបណ្តាល បណ្តាល វិជ្ជាជីវៈ បាន ផ្គត់ផ្គង់ សម្ភារ មួយចំនួន ដើម្បី ប្រើប្រាស់ និង ដាក់ តាំង បង្ហាញ នៅក្នុង ភូមិ ដែល រួម មាន ស្គរ ឆៃ យ៉ាំ ទ្រ មុខ ស្វា មុខ ត្លុក ជាដើម ។
យ៉ាងណា ក៏ដោយ ភាគី ជប៉ុន បាន លើកឡើង ថា ភូមិ ខ្មែរ នេះ នឹង អាច បើក ឱ្យ ដំណើរការ នៅ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០២៤ ខាងមុខ ៕ ឧកញ៉ា ម៉ី តារា រិទ្ធ សមាជិក ទីប្រឹក្សា សភា ពាណិជ្ជកម្ម កម្ពុជា និង លោកជំទាវ ផល្លា ម៉ានីណូ បរិច្ចាគ ថវិកា ៣ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ ឧកញ៉ា ម៉ី តារា រិទ្ធ សមាជិក ទីប្រឹក្សា សភា ពាណិជ្ជកម្ម កម្ពុជា និង លោកជំទាវ ផល្លា ម៉ានីណូ បាន បរិច្ចាគ ថវិកា ចំនួន ៣ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
ឧកញ៉ា ម៉ី តារា រិទ្ធ និង លោកជំទាវ ផល្លា ម៉ានីណូ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឧកញ៉ា អ៊ុន យុទ្ធី សមាជិក ជ្រើសតាំង សភា ពាណិជ្ជកម្ម កម្ពុជា និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ២ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
ឧកញ៉ា អ៊ុន យុទ្ធី និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ២២៤ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៤.៧៦៩ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៣.៥២៦ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.២៤៣ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្រវឹង ញៀន កែច្នៃ ភ្លើង / ផ្លាក ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ឆៀក ស្រវឹង ដឹក ទំនិញ សំពីង សំពោង ល្មើស ល្បឿន ស្រវឹង អត់ បណ្ណ បើកបរ និង ភ្លើង - ផ្លាក ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១២លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៧ នាក់ របួស ចំនួន ១០នាក់ ( របួស ធ្ងន់ ចំនួន ០៩ នាក់ ) ។ រយៈពេល ២២ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ២០៦ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១១៩ នាក់ របួស ២៨២ នាក់ ( របួស ធ្ងន់ ១៧៧ នាក់ )៕
ឧកញ៉ា ថៃ ស៊ាង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គួរ បញ្ជាក់ ថា បទសម្ភាស ខាងលើ ធ្វើឡើង បន្ទាប់ពី លោក Duda បាន បំពេញ ទស្សនកិច្ច ទៅកាន់ ទីក្រុង New York ជា ទី ដែល រូប លោក បាន បើក កិច្ចពិភាក្សា នៅ អង្គការ សហ ប្រជាជាតិ និង ជជែក អំពី សង្រ្គាម នៅ អ៊ុយក្រែន ជាមួយ អតីត ប្រធានា ធីបតី អាមេរិក លោក ដូណាល់ ត្រាំ ។ រីឯ កាលពី ខែមីនា កន្លងទៅ លោក ប្រធានាធិបតី ប៉ូឡូញ បាន ធ្វើដំណើរ ទៅ រដ្ឋធានី វ៉ាស៉ីនតោន ជា ទី ដែល លោក បាន ជួប ជាមួយ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន ៕
គណ:កម្មាធិការ ជាតិ អេស្កាប់ កម្ពុជា ដឹកនាំ កិច្ចប្រជុំ ពេញ អង្គ ថ្នាក់ រដ្ឋមន្ត្រី ស្តីពី « ការប្រើប្រាស់ ន វានុវត្តន៍ សម្រាប់ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព នៅ អាស៊ី និង ប៉ាស៊ីហ្វិក » នៃ UNESCAP
( បាងកក . ថៃ )៖ នៅ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ តាង នាម រាជ រដ្ឋាភិបាល កម្ពុជា បណ្ឌិត លី ធុជ ទេសរដ្ឋមន្ត្រី និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ អេស្កាប់ បាន ដឹកនាំ កិច្ចប្រជុំ ពេញ អង្គ ថ្នាក់ រដ្ឋមន្ត្រី ស្តីពី « ការប្រើប្រាស់ ន វានុវត្តន៍ ឌីជីថល សម្រាប់ ការអភិឌ្ឍ ប្រកបដោយ ចីរភាព នៅ អាស៊ី និង ប៉ាស៊ីហ្វិក » នៃ សន្និបាត ប្រចាំ ឆ្នាំ លើក ទី ៨០ នៃ គណ:កម្មការ សេដ្ឋកិច្ច និង សង្គមកិច្ច សម្រាប់ តំបន់ អាស៊ី និង ប៉ាស៊ីហ្វិក នៃ អង្គការ សហ ប្រជាជាតិ (UNESCAP) ។
កិច្ចប្រជុំ នេះ បាន ផ្តោត ជាពិសេស លើ សក្តានុពល នៃ ន វានុវត្តន៍ ឌីជីថល ក្នុង តំបន់ អាស៊ី និង ប៉ាស៊ីហ្វិក ក្នុង ការបង្កើន ល្បឿន អភិវឌ្ឍន៍ ដើម្បី សម្រេចបាន នូវ របៀបវារៈ ឆ្នាំ ២០២៣ សម្រាប់ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ក្នុង នោះ ក៏ មាន ការចូលរួម ថ្លែងការណ៍ របស់ រដ្ឋ សមាជិក នានា អំពី យុទ្ធសាស្ត្រ ក្នុង ការជំរុញ និង គាំទ្រ ការអភិវឌ្ឍ និង ការពង្រីក ន វានុវត្តន៍ ឌីជីថល ផងដែរ ។
( ភ្នំពេញ ) ៖ ការប្រែប្រួល ស្ថានភាព សង្គ្រាម នៅ មជ្ឈិម ព៌ា កំពុង ស្ថិត នៅក្នុង ក្រសែភ្នែក អ្នកវិភាគ សេដ្ឋកិច្ច ដោយ វា នឹង បន្ត ជះ ឥទ្ធិពល ចំពោះ សេដ្ឋកិច្ច ពិភពលោក ។ លោក បណ្ឌិត គី សេរី វឌ្ឍន៍ អ្នកជំនាញ សេដ្ឋកិច្ច និង ជា ប្រធាន វិទ្យាស្ថាន សិក្សា ចិន បាន អះអាង ថា សេដ្ឋកិច្ច ពិភពលោក នឹង មាន កំណើន បើសិនជា អ៉ីរ៉ង់ មិន ឈានជើង ចូល សង្រ្គាម ដោយ ផ្ទាល់ នៅក្នុង តំបន់ មជ្ឈិមបូព៌ា នោះ ទេ ។
បើ តាម ការបញ្ជាក់ របស់ អ្នកជំនាញ រូប នេះ នៅក្នុង កិច្ចពិភាក្សា Fresh News នា សប្តាហ៍ មុន នេះ បាន ឱ្យដឹង ថា កំណើន សេដ្ឋកិច្ច ពិភពលោក ដែល ព្យាករណ៍ ក្នុង រង្វង់ ២ភាគរយ ក៏ អាច ផ្លាស់ប្តូរ ទៅជា ធ្លាក់ចុះ វិញ បាន ដែរ ប្រសិនជា ប្រទេស អ៉ីរ៉ង់ ជា បង ធំ មួយ នៅ មជ្ឈិមបូព៌ាំ លូក ដៃ ចូលក្នុង សង្រ្គាម មជ្ឈិមបូព៌ា ដោយ ផ្ទាល់ ប្រយុទ្ធ នឹង អ៉ី ស្រាអែល ដែល មាន សហរដ្ឋ អាមេរិក ជា បង្អែក ។
លោក បណ្ឌិត បាន បន្ថែម ថា បើសិនជា អ៉ីរ៉ង់ លូក ដៃ ចូល ផ្ទាល់ នៅក្នុង សង្រ្គាម មជ្ឈិមបូព៌ា នោះ វិបត្តិ ប្រេង អាចនឹង កើត មាន ឡើង ដែល នាំឲ្យ ខ្វះខាត ប្រេង និង ឡើង ថ្លៃ ប្រេង ជាដើម ។ ជាមួយគ្នា នេះ ដែរ វិបត្តិ ជាច្រើន ទៀត ក៏ អាច លេចចេញ ជា រូបរាង ផងដែរ ដោយសារ សង្រ្គាម នៅ តំបន់ មជ្ឈិមបូព៌ា នេះ ។
យ៉ាងណាមិញ សម្រាប់ ប្រទេស កម្ពុជា ដែល នៅ ឆ្ងាយ ពី តំបន់ ក៏ អាច រង នូវ ឥទ្ធិពល អវិជ្ជមាន និង វិជ្ជមាន ដែរ ។ នេះ គឺជា ការបញ្ជាក់ បន្ថែម ពី លោក បណ្ឌិត គី សេរី វឌ្ឍន៍ ៕
អ្នកជំនាញ ផ្នែក អារ្យធម៌ ខ្មែរ ស្នើ អ្នក ពាក់ព័ន្ធ ក្បាច់គុន ល្បុក្កតោ រួមគ្នា អភិវឌ្ឍ ក្បាច់គុន នេះ ឱ្យ បាន ដាក់ បង្ហាត់ ក្នុង វិស័យ អប់រំ
( ភ្នំពេញ ) ៖ អ្នកជំនាញ ផ្នែក អារ្យធម៌ ខ្មែរ លោក រ័ត្ន សណ្ដាប់ នៅ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ បាន ស្នើសុំ អ្នក ពាក់ព័ន្ធ ទាំងអស់ មិន ថា ក្រសួង អប់រំ យុវជន និង កីឡា សហព័ន្ធ កីឡា ល្បុក្កតោ កម្ពុជា និង គ្រូ ល្បុក្កតោ រួមគ្នា អភិវឌ្ឍ ក្បាច់គុន នេះ ឱ្យ បាន ដាក់ បង្ហាត់ ក្នុង វិស័យ អប់រំ ។ បើ តាម លោក រ័ត្ន សណ្តាប់ ល្បុក្កតោ គឺជា ក្បាច់គុន មួយ របស់ ជាតិ ដែល យើង ត្រូវតែ លើកស្ទួយ ជាពិសេស ត្រូវ ដាក់ ក្នុង ប្រព័ន្ធ អប់រំ ទាំង សាលា រដ្ឋ និង ឯកជន ។
គំនិត របស់ អ្នកជំនាញ អារ្យធម៌ ខ្មែរ បន្ទាប់ពី ឃើញ ថា គ្រូបង្ហាត់ ល្បុក្កតោ នៅ តាម សាលា ឯកជន យក ថ្លៃ ពេក ធ្វើឱ្យ គេ មិន អាច បញ្ចូល ទៅក្នុង កម្មវិធី សិក្សា បាន ។ ជាមួយគ្នា នេះ ក្បាច់គុន មួយ នេះ ក៏ អត់ ទាន់ មាន បង្ហាត់ នៅក្នុង សាលា រដ្ឋ ទៀត ផង ។
សម្រាប់ លោក រ័ត្ន សណ្ដាប់ បាន ផ្តល់ ជា គំនិត ថា បើសិនជា ក្រសួង អប់រំ យុវជន និង កីឡា រួមគ្នា ជាមួយ សហព័ន្ធ កីឡា ល្បុក្កតោ កម្ពុជា សម្រួល ឱ្យ មាន ការបង្ហាត់ ល្បុក្កតោ នៅ តាម វិស័យ អប់រំ ក្បាច់គុន របស់ ជាតិ មួយ នេះ នឹង រីកចម្រើន ពេញ ផ្ទៃ ប្រទេស ។
អ្នកនាំពាក្យ ក្រសួង អប់រំ មិន ទាន់ ឆ្លើយតប នឹង បញ្ហា នេះ ទេ ៕
ក្រសួង ពាណិជ្ជកម្ម ហាមឃាត់ ការប្រើប្រាស់ ពាក្យពេចន៍ និង សកម្មភាព មួយចំនួន ក្នុង ការផ្សព្វផ្សាយ លក់ ផលិតផល ទំនិញ និង សេវា
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ចេញ ប្រកាស ហាមឃាត់ ការផ្សព្វផ្សាយ លើ ពាក្យពេចន៍ មួយចំនួន ដើម្បី លក់ ផលិតផល ទំនិញ និង សេវា ដែល មាន ភ្ជាប់ សេចក្តី បរិយាយ ពាណិជ្ជកម្ម មិន ពិត ។
