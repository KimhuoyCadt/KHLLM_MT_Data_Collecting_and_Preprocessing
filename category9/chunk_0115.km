( ភ្នំពេញ ) ៖ ករណី គប់ កញ្ចក់ រថយន្ដ២ គ្រឿង នៅ សង្កាត់ សំរោង ក្រោម ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៤ កន្លងទៅ ដែល បណ្ដាលឲ្យ ស្ដ្រី ជនរងគ្រោះ ម្នាក់ ដែល ជិះ ក្នុង រថយន្ដ រងរបួស ផ្ទៃ មុខ ធ្ងន់ធ្ងរ ដេរ រហូត ៣០ថ្នេរ និង ខូចខាត កញ្ចក់ រថយន្ដ នោះ ត្រូវ កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ស្រាវជ្រាវ ចាប់ខ្លួន បាន ជា បន្ដ បន្ទាប់ ចំនួន ៦នាក់ ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង ដោយ អនុវត្ត តាម បទបញ្ជា របស់ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ និង លោក ឧត្តមសេនីយ៍ ត្រី ប៊ុន សត្យា ស្នងការ រង ទទួល ផែនការងារ នគរបាល ព្រហ្មទណ្ឌ និង មាន ការដឹកនាំ បញ្ជា ផ្ទាល់ ដោយ លោក ឧត្តមសេនីយ៍ ទោ លី ប៊ុន អេង ស្នងការ រង ទទួល ដឹកនាំ ការិយាល័យ ខណៈ ការិយាល័យ ជំនាញ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ឯក ម៉ម សាវន ។
របាយការណ៍ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន ឲ្យដឹង ថា ជនសង្ស័យ ទាំង៦នាក់ នេះ ត្រូវបាន ឃាត់ខ្លួន ជា បន្ដ បន្ទាប់ នៅ ថ្ងៃទី ១៩ និង ថ្ងៃទី ២០ ខែមេសា ដើម្បី យកមក ធ្វើ ការសួរនាំ និង ចាត់ការបន្ដ តាម នីតិវិធី ។
ដោយឡែក ទី ១៖ ឈ្មោះ ង៉ាន់ សូលីដា ភេទ ស្រី អាយុ ៤២ ឆ្នាំ មុខរបរ មន្ត្រីរាជការ បែករយៈ លើ ថ្ងាស ចំនួន ២កន្លែង ដេរ ចំនួន ៣០ថ្នេរ ( រងរបួស ធ្ងន់ ) និង បែក កញ្ចក់ រថយន្ត ខាងមុខ ចំនួន ១ផ្ទាំង និង ទី២៖ ឈ្មោះ ចន្ថា សុថ ន អាយុ ៣៧ ឆ្នាំ មុខរបរ នគរបាល ជាតិ ខូចខាត បែក កញ្ចក់ រថយន្ត ខាងមុខ ចំនួន ១ផ្ទាំង ។ បច្ចុប្បន្ន ជនសង្ស័យ និង សម្ភារៈ ចាប់ យក ខាងលើ ការិយាល័យ កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម នីតិវិធី ៕
( ភ្នំពេញ ) ៖ ក្មេង ស្ទាវ មួយ ក្រុម ប្រមាណ ១៤នាក់ ជិះ ម៉ូតូ ចំនួន ០៧ គ្រឿង ប្រដាប់ ដោយ ដាវ កាំបិត និង ផ្គាក់ ដែល បាន ធ្វើ សកម្មភាព កាប់ លើ ជនរងគ្រោះ ត្រូវ ចំនួន ២កន្លែង ត្រង់ ខ្នង និង មុខ ( មុត រយៈ ដេរ ចំនួន ២៤ថ្នេរ ) នៅ សង្កាត់ កាកាប១ ខណ្ឌ ពោធិ៍សែនជ័យ ត្រូវបាន កម្លាំង អាវុធហត្ថ រាជធានី ភ្នំពេញ ចាប់ខ្លួន បាន ម្នាក់ ហើយ និង កំពុង កសាង សុំ ណុំរឿង បញ្ជូន ទៅ តុលាការ ខណៈ បក្ខពួក ផ្សេង ទៀត កំពុង តាម ចាប់ខ្លួន ។
ក្រោយពេល ទទួលបាន បណ្តឹង ពី ក្រុមគ្រួសារ ជនរងគ្រោះ រួច មក កម្លាំង ជំនាញ អាវុធហត្ថ រាជធានី ភ្នំពេញ ក្នុង មូលដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ បាន ធ្វើ ការស្រាវជ្រាវ និង ឈានដល់ ការឃាត់ខ្លួន ជន ដៃ ដល់ ឈមោះ ឡៃ មក រា ភេទ ប្រុស អាយុ ១៩ ឆ្នាំ នាំយក មក មូលដ្ឋាន ខណ្ឌ និង ធ្វើ ការស្តាប់ ចម្លើយ តាម នីតិវិធី ។ ជនសង្ស័យ បាន សារភាព ឲ្យដឹង ថា នៅ ថ្ងៃ កើត ហេតុ ខាង លើ ខ្លួន និង បក្ខពួក ជាច្រើន នាក់ ទៀត ពិតជា បាន នាំគ្នា ដេញ កាប់ ទៅ លើ ជនរងគ្រោះ បណ្តាលឲ្យ រងរបួស ពិតប្រាកដ មែន ។
បច្ចុប្បន្ន ជនសង្ស័យ ខាងលើ កំពុង ត្រូវបាន កម្លាំង ជំនាញ ការិយាល័យ ប្រឆាំង បទល្មើស ព្រហ្មទណ្ឌ នៃ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ កសាង សុំ ណុំរឿង បញ្ជូន ទៅ តុលាការ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ចំណែក បក្ខពួក ដែល រត់ គេច សមត្ថកិច្ច ជំនាញ អាវុធហត្ថ រាជធានី ភ្នំពេញ កំពុង ស្រាវជ្រាវ ស្វែងរក ចាប់ខ្លួន បន្ត ទៀត ៕ ធនាគារ ថៃ នឹង ទម្លាក់ អត្រា ការប្រាក់ ០.២៥ ភាគរយ សម្រាប់ ក្រុម អតិថិជន ងាយ រងគ្រោះ
( បាងកក )៖ សមាគម ធនាគារ របស់ ប្រទេស ថៃ បាន ឱ្យដឹង នៅ ថ្ងៃព្រហស្បតិ៍ ថា ធនាគារ ក្នុង ប្រទេស ថៃ នឹង ទម្លាក់ អត្រា ការប្រាក់ កម្ចី ចំនួន ២៥ ពិន្ទុ មូលដ្ឋាន ឬ ស្មើនឹង ០.២៥ ភាគរយ សម្រាប់ ក្រុម ដែល ងាយ រងគ្រោះ សម្រាប់ រយៈពេល ប្រាំមួយ ខែ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ។
ការសម្រេចចិត្ត នេះ បាន ធ្វើឡើង បន្ទាប់ពី នាយក រដ្ឋមន្រ្តី ថៃ លោក សេដ្ឋា ថា វីស៊ីន បាន និយាយ នៅ សប្តាហ៍ នេះ ថា លោក បាន ស្នើសុំ ឱ្យ ស្ថាប័ន ផ្តល់ ប្រាក់ កម្ចី ធំ ទាំង បួន របស់ ប្រទេស ថៃ កាត់បន្ថយ អត្រា ការប្រាក់ ដើម្បី ជួយ ដល់ អាជីវកម្ម ខ្នាត តូច និង សេដ្ឋកិច្ច ។ លោក សេដ្ឋា បាន ជំរុញ ម្តង ហើយ ម្តង ទៀត ឱ្យ ធនាគារ កណ្តាល ថៃ ទម្លាក់ អត្រា ការប្រាក់ ដើម្បី ជំរុញ សេដ្ឋកិច្ច ។
សមាគម ធនាគារ ថៃ បាន ឱ្យដឹង ថា វិធានការ នេះ នឹង ជួយ សម្រាល បន្ទុក ការប្រាក់ តែ សមាគម មិន បាន បញ្ជាក់ ថា តើ មាន ធនាគារ ប៉ុន្មាន នឹង ចូលរួម ក្នុង គំនិត ផ្តួចផ្តើម នេះ ទេ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ៕
ដំណើរទស្សនកិច្ច របស់ លោក Blinken គឺ តំណាង ឱ្យ ទំនាក់ទំនង កម្រិត ខ្ពស់ ចុងក្រោយ បំផុត រវាង ប្រទេស ទាំង ពីរ ដែល បាន រួមចំណែក កាត់បន្ថយ អរិភាព រវាង គ្នា ដែល បាន ឈានដល់ កម្រិត ដែល មិន ធ្លាប់ មាន ពីមុន មក កាលពី ឆ្នាំ មុន ។ ទោះបីជា មាន ភាពតានតឹង ជាប់ លាប់ ក៏ដោយ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ក្រុមការងារ ពាណិជ្ជកម្ម និង ទំនាក់ទំនង យោធា បាន ជួយ សម្រួល បរិយាកាស នៃ ការប្រឈមមុខ ដាក់ គ្នា ។
ក្នុង អំឡុង ពេល ជួប ជាមួយ មន្ត្រី កំពូល របស់ ចិន នៅ ទីក្រុង សៀងហៃ គឺ លោក Chen Jining លោក Blinken បាន សម្តែង ការព្រួយបារម្ភ អំពី គោល នយោបាយ និង ការអនុវត្ត ពាណិជ្ជកម្ម របស់ ចិន ដែល ខុសពី គោលការណ៍ ទីផ្សារ ។ លោក បាន សង្កត់ធ្ងន់ លើ សារៈសំខាន់ នៃ ការប្រកួតប្រជែង សេដ្ឋកិច្ច ដោយ យុត្តិធម៌ និង ការគោរព ស្មើភាព គ្នា សម្រាប់ កម្មករ និង ក្រុមហ៊ុន អាមេរិក ដែល កំពុង ប្រតិបត្តិការ នៅក្នុង ប្រទេស ចិន ។
ជា ការឆ្លើយតប អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន លោក Wang Wenbin បាន រំលឹក ឡើងវិញ នូវ ការប្តេជ្ញាចិត្ត របស់ ប្រទេស ចិន ក្នុង ការធ្វើ កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម ដោយ ផ្អែក លើ គោលការណ៍ ទីផ្សារ អន្តរជាតិ ។ លោក Wang បាន អំពាវនាវ ឱ្យ មាន ការគោរព គ្នា ទៅ វិញ ទៅ មក ចំពោះ គោលការណ៍ នៃ ការប្រកួតប្រជែង ដោយ ស្មើភាព ការប្រកាន់ខ្ជាប់ នូវ បទប្បញ្ញត្តិ របស់ អង្គការ ពាណិជ្ជកម្ម ពិភពលោក (WTO) ។
ករណី គ្រូ ល្បុក្កតោ យក ថ្លៃ ! អ្នកនាំពាក្យ ក្រសួង អប់រំ ថា ក្រសួង លើកទឹកចិត្ត ដល់ សាលា នីមួយ ៗ អាច បន្ថែម កម្មវិធី សិល្បៈ និង កីឡា ទៅតាម ចំណង់ចំណូលចិត្ត សិស្ស
ការថ្លែង របស់ លោកស្រី បន្ទាប់ពី ឃើញ ការផ្សាយ ថា គ្រូបង្ហាត់ ល្បុក្កតោ នៅ តាម សាលា ឯកជន យក ថ្លៃ ពេក ធ្វើឱ្យ គេ មិន អាច បញ្ចូល ទៅក្នុង កម្មវិធី សិក្សា បាន ។ ជាមួយគ្នា នេះ ក្បាច់គុន មួយ នេះ ក៏ អត់ ទាន់ មាន បង្ហាត់ នៅក្នុង សាលា រដ្ឋ ទៀត ផង ។
អ្នកនាំពាក្យ បាន បញ្ជាក់ ថា « បច្ចុប្បន្ន ក្រសួង បាន ដាក់បញ្ចូល កម្មវិធី សិល្បៈ និង កីឡា ចូល ទៅក្នុង សាលា ។ ក្រៅពី ការអប់រំ ជា មូលដ្ឋាន លើ មុខវិជ្ជា ទាំង ២នេះ សាលា នីមួយ ៗ ក៏ អាច បន្ថែម កម្មវិធី សិល្បៈ និង កីឡា ទៅតាម ចំណង់ចំណូលចិត្ត សិស្ស មូលដ្ឋាន និង ធនធាន ដែល មាន ដែរ ។ កន្លងមក សាលា មួយចំនួន ក៏ បាន ចាប់ផ្តើម សាកល្បង កីឡា នានា រួច មកហើយ » ។
ថ្មី ៗ នេះ អ្នកជំនាញ ផ្នែក អារ្យធម៌ ខ្មែរ លោក រ័ត្ន សណ្ដាប់ ក៏ បាន ស្នើសុំ អ្នក ពាក់ព័ន្ធ ទាំងអស់ មិន ថា ក្រសួង អប់រំ យុវជន និង កីឡា សហព័ន្ធ កីឡា ល្បុក្កតោ កម្ពុជា និង គ្រូ ល្បុក្កតោ រួមគ្នា អភិវឌ្ឍ ក្បាច់គុន នេះ ឱ្យ បាន ដាក់ បង្ហាត់ ក្នុង វិស័យ អប់រំ ។ បើ តាម លោក រ័ត្ន សណ្តាប់ ល្បុក្កតោ គឺជា ក្បាច់គុន មួយ របស់ ជាតិ ដែល យើង ត្រូវតែ លើកស្ទួយ ជាពិសេស ត្រូវ ដាក់ ក្នុង ប្រព័ន្ធ អប់រំ ទាំង សាលា រដ្ឋ និង ឯកជន ។
ការស្នើសុំ របស់ អ្នកជំនាញ ផ្នែក អារ្យធម៌ ខ្មែរ បន្ទាប់ពី សហព័ន្ធ កីឡា ល្បុក្កតោ កម្ពុជា ច្រានចោល មតិ ថា គ្រូបង្ហាត់ ល្បុក្កតោ យក ថ្លៃ ពេក លើ សេវា បង្ហាត់ បង្រៀន ។
ប្រទេស ដែល មាន ក្បាច់គុន ជាតិ ដូច នៅ កូរ៉េ គេ លើក ស្ទូយ តេខ្វាន់ ដូ រីឯ ជប៉ុន គេ លើកស្ទួយ ការ៉ាត់ តេ ដូច ចិន លើកស្ទួយ កុង ហ្វូដែរ ហើយ បើ តាម លោក អ៊ុន ជីម អ្នកសិក្សា ផ្នែក វិទ្យាសាស្ត្រ នយោបាយ និង វប្បធម៌ បាន លើក ជា យោបល់ ថា ទាំង សាលា រដ្ឋ និង ឯកជន គួរតែ បង្រៀន ល្បុក្កតោ ដល់ សិស្ស ជា លក្ខណៈ កីឡា ហាត់ប្រាណ ផង និង លក្ខណៈ ប្រយុទ្ធ ផង ។ ជា លក្ខណៈ កីឡា ហាត់ប្រាណ ដើម្បីឱ្យ សិស្ស មាន សុខភាព ល្អ រីឯ លក្ខណៈ ប្រយុទ្ធ ដើម្បី សិស្ស ចេះ ការពារ ខ្លួន ពី សត្រូវ ។
លោក អ៊ុន ជឹម ក៏ ស្នើ ឱ្យ អ្នក ពាក់ព័ន្ធ មាន គំនិត លើក ស្ទូយ ល្បុក្កតោ ដែល ជា ក្បាច់គុន បុរាណ ខ្មែរ ជា វប្បធម៌ ខ្មែរ ឱ្យ ផុល ផុស ដោយ បញ្ជាក់ ថា « ធ្វើ បែប នេះ ដើម្បី ពង្រឹង ក្បាច់គុន ល្បុក្កតោ យើង » ។
លោក គង់ សំនៀង បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « វា មាន ការលំបាក បន្តិច ក្នុង ការរក គ្រូ ហើយ គ្រូ ហាក់បីដូចជា យក ថ្លៃ ខ្ពស់ ពេក ធ្វើឱ្យ ការចំណាយ របស់ សាលា មាន ការកើនឡើង ។ ជា ចេតនា យើង ក៏ ចង់ ដាក់ ដែរ ។ ឯកជន ចង់ លើក តម្លៃ វប្បធម៌ ជាតិ ជាពិសេស ល្បុក្កតោ ប៉ុន្តែ តម្លៃ ខ្ពស់ ពេក » ។
លោក គង់ សំនៀង បាន អះអាង ថា ចេតនា របស់ សាលា ឯកជន ចង់ លើក តម្លៃ ក្បាច់គុន ខ្មែរ តែ ដោយសារ គ្រូបង្ហាត់ យក ថ្លៃ ពេក នាំឱ្យ សាលា ពិបាក រៀបចំ ព្រោះ ការចំណាយ មាន ការកើនឡើង បើ បញ្ចូល ល្បុក្កតោ ក្នុង ម៉ោង សិក្សា ។
លោក សាន គឹម ស៊ាន បណ្ឌិត ព្រឹទ្ធាចារ្យ ក្រមា មាស នៃ បណ្ឌិត្យ សភា គុន ល្បុក្កតោ កម្ពុជា បាន អះអាង ថា គ្រូបង្ហាត់ ល្បុក្កតោ ដែល យក ថ្លៃ អាច មិន មែន ចេញ ពី បណ្ឌិត្យ សភា គុន ល្បុក្កតោ កម្ពុជា នោះ ឡើយ ។ គ្រូ ល្បុក្កតោ ដែល ស្រប ច្បាប់ ត្រូវតែ ចេញ ពី បណ្ឌិត្យ សភា គុន ល្បុក្កតោ កម្ពុជា ហើយ ចំពោះ គ្រូបង្ហាត់ ដែល ចេញ ពី ខាង សហព័ន្ធ លោក អត់ ទទួលខុសត្រូវ ទេ ។
បើ តាម លោក សាន គឹម ស៊ាន បណ្ឌិត្យ សភា គុន ល្បុក្កតោ កម្ពុជា កំពុងតែ រៀបចំ ទីតាំង ដើម្បី បណ្តុះបណ្តាល គ្រូ ដែល មាន វិជ្ជាជីវៈ ។
សូម ជម្រាប ថា ល្បុក្កតោ ជា ក្បាច់គុន បុរាណ ខ្មែរ ដែល ចាក់ ឫស ចាក់ គល់ យ៉ាង ជ្រៅ នៅក្នុង សង្គម ខ្មែរ ជាច្រើន សតវត្ស មក ហើយ ៗ បន្ត រស់រាន ក្នុង សង្គម ខ្មែរ រហូតដល់ បច្ចុប្បន្ន ។ ចម្លាក់ លើ ជញ្ជាំង ប្រាសាទ សម័យ អង្គរ ជា ភស្តុតាង បង្ហាញ ច្បាស់ អំពី ការហាត់ សម ក្បាច់គុន នេះ ដែរ ។ ការបង្ហាត់ បង្ហាញ ក្បាច់គុន ល្បុក្កតោត ៗ គ្នា ពី ជំនាន់ មួយ ទៅ ជំនាន់ មួយ គឺ ដើម្បី ពង្រឹង ប្រាជ្ញា ស្មារតី និង សមត្ថភាព ការពារ ខ្លួន ពី សត្វ សហាវ ព្រមទាំង សត្រូវ នានា ផង និង ការពារ សង្គមជាតិ និង មាតុភូមិ ផង ។
សម្រាប់ លោក រ័ត្ន សណ្ដាប់ បាន ផ្តល់ ជា គំនិត ថា បើសិនជា ក្រសួង អប់រំ យុវជន និង កីឡា រួមគ្នា ជាមួយ សហព័ន្ធ កីឡា ល្បុក្កតោ កម្ពុជា សម្រួល ឱ្យ មាន ការបង្ហាត់ ល្បុក្កតោ នៅ តាម វិស័យ អប់រំ ក្បាច់គុន របស់ ជាតិ មួយ នេះ នឹង រីកចម្រើន ពេញ ផ្ទៃ ប្រទេស ៕
ការលើកទឹកចិត្ត ដល់ សិល្បករ សិល្បការិនី របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ធ្វើឡើង ក្នុង ឱកាស សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែ និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី នៅ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ឲ្យដឹង ថា « ខ្ញុំ សូម លើកទឹកចិត្ត ដល់ សិល្បករ សិល្បការិនី គ្រប់ ទម្រង់ ចូលរួម ចង់ ក្រង ជា សមាគម ឬ ចូលរួម ជាមួយ សមាជិក សមាគម សិល្បៈ គ្រប់ ទម្រង់ ដើម្បី ប្រសិទ្ធិភាព នៃ ការធ្វើ ការរួមគ្នា ក្នុង ភាព ជា បងប្អូន ដោយ ចេះ ជួយ គ្នា ទៅ វិញ ទៅ មក ស្រប តាម ទំនៀមទម្លាប់ ប្រពៃណី ដូនតា របស់ ខ្មែរ យើង » ។
សម្ដេច ធិបតី បាន ថ្លែង បន្ដ ថា ដូច្នេះ មុននឹង ជ្រើសយក សកម្មភាព ណាមួយ សិល្បករ សិល្បការិនី ទាំងអស់ គួរ ប្រកាន់ភ្ជាប់ នូវ គោលការណ៍ សីលធម៌ គុណធម៌ សច្ចៈ ធម៌ ទាំង សំណេរ ទាំង ការប្រើប្រាស់ ពាក្យ ពេជ្យន៍ កាយវិការ សកម្មភាព ឥរិយាបទ ការស្លៀកពាក់ ដោយ រក្សា ឲ្យបាន នូវ ភាព ថ្លៃថ្នូរ និង ការចូលរួម លើកកម្ពស់ សីលធម៌ ក្នុង សង្គម ដែល នឹង ចូលរួម ដល់ ការពង្រឹង នូវ អត្តសញ្ញាណ ជាតិ ៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ផ្តល់ យោបល់ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី ។ ពិធី នេះ បាន រៀបចំឡើង នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ នា ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ ។
សម្តេច បាន ថ្លែង ថា ក្រោម ម្លប់ នៃ សន្តិភាព និង ការបោះជំហាន ទៅ មុខ ជាប់ មិន ដាច់ លើ គ្រប់ វិស័យ វឌ្ឍនភាព នៃ វិស័យ សិល្បៈ ក៏ ទទួលបាន នូវ សន្ទុះ មួយ ជា ទី មោទនៈ ផងដែរ ។ ដើម្បី ចូលរួម តម្រង់ ទិស និង ពង្រឹង ភាពជោគជ័យ របស់ សិល្បករ សិល្បការិនី គ្រប់ រូប សម្តេច សូម រំលឹក និង ជូន ជា យោបល់ មួយចំនួន ដូច ខាងក្រោម៖
១. ខ្ញុំ ស្នើ ដល់ គ្រប់ សិល្បករ សិល្បការិនី ទាំងអស់ ផ្តោត អារម្មណ៍ ឱ្យ កាន់តែ ខ្លាំង ទៅ លើ ទ្រឹស្ដី « ចង្កឹះ មួយបាច់ » ដើម្បី ពង្រឹង សាមគ្គីភាព និង ភាពរឹងមាំ ព្រមទាំង ដើម្បី ពង្រឹង គោលដៅ រួម និង ជោគជ័យ រួម ។ ក្នុង ន័យ នេះ ខ្ញុំ សូម លើកទឹកចិត្ត ដល់ សិល្បករ សិល្បការិនី គ្រប់ ទម្រង់ ចូលរួម ចង ក្រង ជា សមាគម ឬ ចូល ជា សមាជិក សមាគម សិល្បៈ គ្រប់ ទម្រង់ ដើម្បី ប្រសិទ្ធភាព នៃ ការធ្វើ ការរួមគ្នា ក្នុង ភាព ជា បងប្អូន ដោយ ចេះ ជួយ គ្នា ទៅ វិញ ទៅ មក ស្រប តាម ប្រពៃណី ទំនៀមទម្លាប់ របស់ ដូនតា យើង ។
៣. ខ្ញុំ យល់ ថា ការបង្កើត យុទ្ធសាស្ត្រ ទាញ ចំណាប់អារម្មណ៍ ពី សាធារណជន គួរ មាន ការ ថ្លឹងថ្លែង និង ពិចារណា ជាមុន ពី ផល ប៉ះពាល់ ផ្នែក វប្បធម៌ ប្រពៃណី និង សីលធម៌ សង្គម ដោយ ពុំ គួរ ប្រើប្រាស់ ជំហរ អត្តនោម័តិ ឬ ជំហរ ចង់ ល្បី ភ្លាម ៗ ដែល អាច ប៉ះពាល់ ដល់ បុគ្គល ផង ដល់ តម្លៃ ជាតិ ផង នោះ ទេ ។ ខ្ញុំ មាន ជំនឿ ថា គ្រប់ សិល្បករ សិល្បការិនី ទាំងអស់ សុទ្ធតែ មាន ការទទួលខុសត្រូវ ខ្ពស់ ជាមួយនឹង ការទទួលស្គាល់ និង ការកែប្រែ នូវ រាល់ កំហុសឆ្គង ដោយ ចេតនា និង អចេតនា ។
៤. ក្នុង បរិបទ នៃ បរិវត្តកម្ម ឌីជីថល ការចែករំលែក ព័ត៌មាន ក្នុង សង្គម កាន់តែ លឿន និង ពិបាក ទប់ស្កាត់ ។ ដើម្បី ចូលរួម ដល់ ភាពរឹងមាំ នៃ សង្គម យើង ខ្ញុំ សូម រំលឹក ដល់ គ្រប់ សិល្បករ សិល្បការិនី ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចៀសវាង ឱ្យ បាន នូវ ការប្រឌិត និង ការសម្តែង ទាំងឡាយ ដែល មាន លក្ខណៈ មិន ពិត អុជ អាល បំបែកបំបាក់ ប្រកាន់ ពូជសាសន៍ ពណ៌ សម្បុរ និង ជំនឿ សាសនា ។
៥. ពាក់ព័ន្ធ នឹង ការបង្កើត ស្នាដៃ ថ្មី និង ការតែង និពន្ធ ក្រៅពី ការគិតគូរ ទៅដល់ ភាពប្លែក ថ្មី សប្បាយ ទាក់ទាញ ខ្ញុំ សូម ស្នើសុំ ឱ្យ មាន ការយកចិត្តទុកដាក់ ខ្ពស់ ទៅ លើ ការបញ្ចូល សារ អប់រំ និង សារ លើកស្ទួយ សង្គម ដោយ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ សច្ចធម៌ គុណធម៌ មិន លួច ចម្លង ក្នុង ទិសដៅ តម្កល់ ស្នាដៃ ដែល បាន បង្កើត ជា គំរូ និង កេរ ដំណែល សម្រាប់ ជន ជំនាន់ ក្រោយ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ស្នើ សិល្បករ សិល្បការិនី ចៀសវាង ការប្រឌិត និង ការសម្តែង លក្ខណៈ មិន ពិត អុជ អាល បំបែកបំបាក់ ប្រកាន់ ពូជសាសន៍ ពណ៌ សម្បុរ និង ជំនឿ សាសនា (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ស្នើ ទៅ សិល្បករ សិល្បការិនី ចៀសវាង ការប្រឌិត និង ការសម្តែង លក្ខណៈ មិន ពិត អុជ អាល បំបែកបំបាក់ ប្រកាន់ ពូជសាសន៍ ពណ៌ សម្បុរ និង ជំនឿ សាសនា ។
សម្តេច ធិបតី ក៏ បាន ថ្លែង ស្នើឲ្យ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ត្រូវ ធ្វើ ការណែនាំ កែលម្អ ចំពោះ កំហុសឆ្គង នានា ព្រមទាំង តម្រង់ ទិស និង ចង្អុលបង្ហាញ ពី ឥរិយាបថ ដែល គួរ ប្រកាន់ យក ដើម្បី ភាពថ្លៃថ្នូរ និង បង្ការ ផល ប៉ះពាល់ ជា យថាហេតុ មក លើ សិល្បៈ វប្បធម៌ ប្រពៃណី ជាតិ ។
សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី ថ្លែង បែប នេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី នា រសៀល ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ក្នុង បរិបទ នៃ បរិវត្តកម្ម ឌីជីថល ការចែករំលែក ព័ត៌មាន ក្នុង សង្គម កាន់តែ លឿន និង ពិបាក ទប់ស្កាត់ ។ ដើម្បី ចូលរួម ដល់ ភាពរឹងមាំ នៃ សង្គម យើង ខ្ញុំ សូម រំលឹក ដល់ គ្រប់ សិល្បករ សិល្បការិនី ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចៀសវាង ឱ្យ បាន នូវ ការប្រឌិត និង ការសម្តែង ទាំងឡាយ ដែល មាន លក្ខណៈ មិន ពិត អុជ អាល បំបែកបំបាក់ ប្រកាន់ ពូជសាសន៍ ពណ៌ សម្បុរ និង ជំនឿ សាសនា » ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សិល្បករ សិល្បការិនី ខ្មែរ តាមរយៈ ស្នាដៃ និង ទេពកោសល្យ របស់ ខ្លួន បាន ក្លាយជា ស្ពាន នាំ កម្ពុជា ទៅកាន់ ពិភពលោក ដោយ រួមទាំង ការចែករំលែក បទពិសោធន៍ និង ចំណេះដឹង នៃ ប្រវត្តិសាស្ត្រ ជាតិ កម្ពុជា ទាំង ការតស៊ូ ទាំង ការឈឺចាប់ ហើយក៏ ជា កាតាលីករ នៃ ការជំរុញ ការផ្លាស់ប្តូរ វប្បធម៌ និង ការគោរព គ្ន ទៅ វិញ ទៅមក ។
សម្តេច ធិបតី យល់ ថា ការបង្កើត យុទ្ធសាស្ត្រ ទាញ ចំណាប់អារម្មណ៍ ពី សាធារណជន គួរតែ មាន ការ ថ្លឹងថ្លែង និង ពិចារណា ជាមុន ពី ផល ប៉ះពាល់ ដល់ ប្រពៃណី វប្បធម៌ និង សីលធម៌ សង្គម ដោយ ពុំ គួរ ប្រើប្រាស់ ជំហរ អត្តនោម័ត ឬ ជំហរ ចង់ ល្បី ភ្លាម ៗ ដោយ អាច ប៉ះពាល់ ដល់ បុគ្គល ផង ដល់ តម្លៃ ជាតិ ផង ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ថែមទាំង បាន ថ្លែង លើកទឹកចិត្ត ដល់ សិល្បករ សិល្បការិនី គ្រប់ ទម្រង់ ចូលរួម ចង ក្រង ជា សមាគម ឬ ចូល ជា សមាជិក សមាគម សិល្បៈ ដើម្បី ប្រសិទ្ធភាព នៃ ការធ្វើ ការរួមគ្នា ក្នុង ភាព ជា បងប្អូន ដោយ ចេះ ជួយ គ្នា ទៅ វិញ ទៅ មក ស្រប តាម ប្រពៃណី ទំនៀមទម្លាប់ របស់ ដូនតា យើង ។
សម្តេច ធិបតី ក៏ ស្នើ ដល់ គ្រប់ សិល្បករ សិល្បការិនី ទាំងអស់ ផ្តោត អារម្មណ៍ ឱ្យ កាន់តែ ខ្លាំង ទៅ លើ ទ្រឹស្ដី « ចង្កឹះ មួយបាច់ » ដើម្បី ពង្រឹង សាមគ្គីភាព និង ភាពរឹងមាំ ព្រមទាំង ដើម្បី ពង្រឹង គោលដៅ រួម និង ជោគជ័យ រួម ៕
សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង យ៉ាង ដូចនេះ នា រសៀល ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ នា ឱកាស ដែល សម្តេច និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី ។ ពិធី នេះ រៀបចំឡើង នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ ។
កម្មវិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស រៀបចំ ធ្វើឡើង ស្រប តាម គោលការណ៍ នយោបាយ របស់ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី និង ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ។
ដើម្បី កែលម្អ ចំពោះ កំហុសឆ្គង នានា ដែល ជា ហេតុ នាំឱ្យ ប៉ះពាល់ លើ សិល្បៈ វប្បធម៌ ប្រពៃណី ជាតិ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ដូចនេះ ថា « ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ក៏ ត្រូវ ធ្វើ ការណែនាំ កែលម្អ ចំពោះ កំហុសឆ្គង នានា ព្រមទាំង តម្រង់ ទិស និង ចង្អុលបង្ហាញ ពី ឥរិយាបថ ដែល គួរ ប្រកាន់ យក ដើម្បី ភាពថ្លៃថ្នូរ និង បង្ការ ផល ប៉ះពាល់ ជា យថាហេតុ មក លើ សិល្បៈ វប្បធម៌ ប្រពៃណី ជាតិ » ។
ក្នុង ឱកាស នោះ ដែរ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ដែរ ថា « រលក ថ្មី ច្រាន រលក មុខ » គឺជា ក្រឹត្យ ក្រម ធម្មជាតិ ។ សិល្បករ សិល្បការិនី រៀមច្បង មិន ត្រឹមតែ ជា រលក នាំមុខ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ជា តួអង្គ ដែល មាន បទពិសោធន៍ និង ជា គំរូ ដល់ រលក ជំនាន់ ក្រោយ ដល់ យុវជន បន្ត វេន ។ ក្នុង ន័យ នេះ ការជួយជ្រោមជ្រែង បង្ហាត់ បង្រៀន ផ្ទេរ ចំណេះដឹង និង ការលើកទឹកចិត្ត ដល់ យុវជន វ័យ ក្មេង គឺជា កាតព្វកិច្ច ដើម្បី បន្ត ថែរក្សា មរតក ដូនតា និង ការបន្ត រីកចម្រើន ទៅ មុខ របស់ វិស័យ សិល្បៈ វប្បធម៌ របស់ យើង ។
ស្រប ជាមួយគ្នា នោះ ដែរ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ដល់ គ្រប់ តួអង្គ នៃ វិស័យ សិល្បៈ ទាំងអស់ ដែល បាន ចូលរួម គាំទ្រ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ការពារ ថែរក្សា កេរ ដំណែល ដូនតា និង ការចូលរួម ពង្រឹង អត្តសញ្ញាណ ជាតិ និង ប្រជាជន ជាពិសេស ចំពោះ ការលះបង់ ទាំង កម្លាំង កាយ ចិត្ត ដើម្បី ចូលរួម គាំទ្រ និង ផ្ទេរ ចំណេះដឹង និង បទពិសោធន៍ ដល់ យុវជន បន្ត វេន ផងដែរ ៕
នាយ ឧត្តមសេនីយ៍ សៅ សុខា អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង មេបញ្ជាការ អាវុធហត្ថ ថ្មី ខេត្ត ស្ទឹងត្រែង . លោក ឧត្តមសេនីយ៍ ត្រី សេង សុភាព ជំនួស លោក ឧត្តមសេនីយ៍ ត្រី អៀវ វ៉ាន់ ឌី
នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន ឲ្យដឹង ថា យោង កម្មវិធី នយោបាយ របស់ រាជ រដ្ឋាភិបាល ស្តីពី កំណែទម្រង់ កងកម្លាំងប្រដាប់ អាវុធ និង យុទ្ធសាស្ត្រ ធ្វើ កំណែទម្រង់ កងយោធពល ខេមរភូមិន្ទ ៥ ឆ្នាំ កងរាជអាវុធហត្ថ បាន សម្រួច ការធ្វើ កំណែទម្រង់ ឆ្ពោះទៅ ( ប្រមូលផ្តុំ . រៀបរយ . ទំនើបកម្ម និង ប្រសិទ្ធភាព ) ។
លោក សង្ឃឹម ជឿជាក់ លើ ស្មារតី ទទួលខុសត្រូវ របស់ អស់ លោក តាម តួនាទី ភារកិច្ច រៀង ៗ ខ្លួន៖
លោកជំទាវ ឧកញ៉ា នឹម វណ្ណៈ និង លោក វេជ្ជបណ្ឌិត ម៉ម សុខ វិសាល ចូលរួម ឧបត្ថម្ភ ថវិកា ៤លាន រៀល ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា តាមរយៈ ការប្រកួត បាល់ទាត់ មនុស្សធម៌ ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន
ម្ចាស់ អចលន ទ្រព្យ ដែល មិន ទាន់ បាន ចុះបញ្ជី និង ធ្វើ បច្ចុប្បន្នភាព មាន ឱកាស ទទួលបាន ការលើកលែង ទណ្ឌកម្ម រដ្ឋបាល រហូតដល់ ដំណាច់ ខែមិថុនា
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច អនុគ្រោះ ពន្ធ លើ អចលន ទ្រព្យ ដោយ លើកលែង ទណ្ឌកម្ម រដ្ឋបាល រួម មាន ពន្ធ បន្ថែម និង ការប្រាក់ ចំពោះ អចលន ទ្រព្យ ដែល មិន ទាន់ បាន ចុះបញ្ជី នៅ រដ្ឋបាល សារពើពន្ធ ( មិន ធ្លាប់ បង់ ពន្ធ លើ អចលន ទ្រព្យ ) ឬ អចលន ទ្រព្យ ដែល ប្រកាស និង បង់ ពន្ធ មិន បាន ត្រឹមត្រូវ នា ឆ្នាំ កន្លងមក ។
ព្រឹត្តិបត្រ ព័ត៌មាន ប្រចាំ សប្តាហ៍ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ដែល ចេញផ្សាយ នៅ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន បញ្ជាក់ ថា ដើម្បី ទទួលបាន ការលើកលែង ទណ្ឌកម្ម រដ្ឋបាល នេះ ម្ចាស់ អចលន ទ្រព្យ ត្រូវ រួសរាន់ មក ចុះបញ្ជី ឬ ធ្វើ បច្ចុប្បន្នភាព ព័ត៌មាន អចលន ទ្រព្យ របស់ ខ្លួន នៅ អគ្គ នាយកដ្ឋាន ពន្ធដារ ឬ សាខា ពន្ធដារ ដែល អចលន ទ្រព្យ ស្ថិត នៅ ឲ្យបាន មុន ដំណាច់ ខែមិថុនា ឆ្នាំ ២០២៤ ខាងមុខ នេះ ។
ចំពោះ អចលន ទ្រព្យ ដែល ធ្វើ ការផ្ទេរ កម្មសិទ្ធិ ឬ សិទ្ធិ កាន់កាប់ បន្ត គ្នា ជាច្រើន លើក ត្រូវបាន អនុគ្រោះ ពន្ធ លើ អចលន ទ្រព្យ ដោយ អនុញ្ញាតឲ្យ គិត ពន្ធ ចាប់ពី រយៈពេល ដែល ម្ចាស់ កម្មសិទ្ធិ ចុងក្រោយ បាន ទទួល សិទ្ធិ កាន់កាប់ អចលន ទ្រព្យ នោះ ប៉ុន្តែ ម្ចាស់ អចលន ទ្រព្យ ត្រូវ រួសរាន់ មក ចុះបញ្ជី អចលន ទ្រព្យ របស់ ខ្លួន ឲ្យបាន មុន ដំណាច់ ខែមិថុនា ឆ្នាំ ២០២៤ ផងដែរ ។
ជាមួយគ្នា នេះ អគ្គ នាយកដ្ឋាន ពន្ធដារ ក៏ បាន ប្រាប់ អំពី ឯកសារ សំខាន់ ៗ ដែល ម្ចាស់ អចលន ទ្រព្យ ត្រូវ ត្រៀម សម្រាប់ ការចុះបញ្ជី អចលន ទ្រព្យ ឬ ធ្វើ បច្ចុប្បន្នភាព ព័ត៌មាន អចលន ទ្រព្យ ផងដែរ ។
អ្នក ជាប់ ពន្ធ ដែល ជា ម្ចាស់ អចលន ទ្រព្យ មាន តម្លៃ លើស ពី ១០០ ០០០ ០០០ រៀល ត្រូវ មាន កាតព្វកិច្ច ចុះបញ្ជី នៅ រដ្ឋបាល សារពើពន្ធ ក្នុង ភូមិសាស្ដ្រ ដែល អចលន ទ្រព្យ នោះ ស្ថិត នៅ ឬ នៅ អគ្គ នាយកដ្ឋាន ពន្ធដារ យ៉ាង យឺត បំផុត ត្រឹម ថ្ងៃទី៣០ ខែកញ្ញា នៃ ឆ្នាំ ជាប់ ពន្ធ ។
ដើម្បី ចុះបញ្ជី បង់ ពន្ធ លើ អចលន ទ្រព្យ អ្នក ជាប់ ពន្ធ ដែល ជា ម្ចាស់ អចលន ទ្រព្យ ត្រូវ រៀបចំ ឯកសារ សំខាន់ ៗ មួយចំនួន ដូច ជា៖
អ្នក ជាប់ ពន្ធ ត្រូវ ផ្ដល់ ព័ត៌មាន ជូន រដ្ឋបាល សារពើពន្ធ ( បច្ចុប្បន្នភាព ព័ត៌មាន អចលន ទ្រព្យ ) ដោយ ត្រូវ ភ្ជាប់ មក ជាមួយ នូវ ឯកសារ ដូច បាន បញ្ជាក់ ខាងលើ រួម ជាមួយ បង្កាន់ដៃ បញ្ចាក់ ការបង់ប្រាក់ ពន្ធនា ឆ្នាំ កន្លងមក ឬ លេខ អត្តសញ្ញាណកម្ម អចលន ទ្រព្យ (PIN) ឬ ប័ណ្ណ សម្គាល់ ការបង់ ពន្ធ លើ អចលន ទ្រព្យ ចំពោះ អចលន ទ្រព្យ ដែល៖
* មូលដ្ឋាន គិត ពន្ធ ត្រូវបាន ប្រែប្រួល ដូចជា ដី ត្រូវបាន យក ទៅ សាងសង់ ផ្ទះ អគារ និង / ឬ សំណង់ ផ្សេង ៗ ឬ ផ្ទះ អគារ និង សំណង់ ផ្សេង ៗ ត្រូវបាន សាងសង់ បន្ថែម ឬ បន្ថយ ឬ រំលាយ ចោល * អចលន ទ្រព្យ ត្រូវបាន ផ្លាស់ប្ដូរ កម្មសិទ្ធិ ករ អ្នកកាន់កាប់ ឬ អ្នក ទទួល ប្រយោជន៍ ចុងក្រោយ នៃ អចលន ទ្រព្យ ៕
អភិបាល ខេត្ត ពោធិ៍សាត់ ប្រកាស តែងតាំង នាយក បណ្តោះអាសន្ន វិទ្យាល័យ ពោធិ៍សាត់ . លោក ជា ឡេង ឃួន ជំនួស លោក ជិន ផល្លា ដែល ត្រូវ ចូលនិវត្តន៍
( ពោធិ៍សាត់ )៖ លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ នា រសៀល ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ លោកគ្រូ អ្នកគ្រូ និង ប្រកាស តែងតាំង នាយក បណ្តោះអាសន្ន នៃ វិទ្យាល័យ ពោធិ៍សាត់ . លោក ជា ឡេង ឃួន ឋានន្តរស័ក្តិ ជា គ្រូបង្រៀន កម្រិត ឧត្តម ដើម ខ្សែ ពិសេស ថ្នាក់ លេខ ៤ នៃ ក្របខ័ណ្ឌ គ្រូបង្រៀន កម្រិត ឧត្តម បច្ចុប្បន្ន ជា នាយក រង វិទ្យាល័យ ឱ្យ កាន់ តួនាទី ជា នាយក បណ្តោះអាសន្ន នៃ វិទ្យាល័យ ពោធិ៍សាត់ ជំនួស លោក ជិន ផល្លា ដែល ត្រូវ ចូលនិវត្តន៍ ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពីសំណាក់ លោក អភិបាល រង ខេត្ត ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ អាជ្ញាធរ ក្រុង ក្រុមប្រឹក្សា សង្កាត់ ព្រមទាំង បុគ្គលិក អប់រំ យុវជន និង កីឡា យ៉ាង ច្រើន កុះករ នៅ សាល ប្រជុំ បណ្តាល័យ សាមគ្គី វិទ្យាល័យ ពោធិ៍សាត់ ។
លោក សូម ឱ្យ នាយ បណ្តោះអាសន្ន ដែល ត្រូវបាន ប្រកាស តែងតាំង នា ពេលនេះ គប្បី ខិតខំ ប្រឹងប្រែង ឱ្យ អស់ លទ្ធភាព ក្នុង ការបំពេញ តួនាទី ភារកិច្ច ក្នុង នាម ខ្លួន យើង ជា ថ្នាក់ដឹកនាំ គេ ត្រូវ មាន ព្រហ្មវិហា ធម៌ ទាំង ៤ មាន វប្បធម៌ ចែករំលែក បង្កើន នូវ ចំណង សាមគ្គី ផ្ទៃក្នុង ល្អ មាន មនសិកា ស្នោះត្រង់ យោគយល់ ឱ្យ គ្នា ទៅ វិញ ទៅមក ។ ទាំងអស់ នេះ គឺជា កិត្តិយស និង ភាពថ្លៃថ្នូរ របស់ លោកគ្រូ អ្នកគ្រូ ទាំងមូល ដែល ទទួលបាន ការសាទរ ពីសំណាក់ មាតាបិតា អាណាព្យាបាល សិស្ស និង ប្រជាពលរដ្ឋ ជាក់ ជា មិន ខាន ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ខូយ រីដា ក៏ បាន ប្រគល់ ប័ណ្ណ សរសើរ ដល់ គណៈ គ្រប់គ្រង វិទ្យាល័យ និង ប្រកាស ផ្តល់ ដំណើរទស្សនកិច្ច សិក្សា សម្រាប់ បុគ្គលិក អប់រំ ក្នុង ក្រុង ពោធិ៍សាត់ ទៅ ខេត្ត ព្រះសីហនុ ឬ ខេត្ត សៀមរាប នៅ ដើម ខែឧសភា ឆ្នាំ ២០២៤ ខាងមុខ នេះ ដោយ ចាប់ផ្តើម ដំបូង គឺ វិទ្យាល័យ ពោធិ៍សាត់ ផងដែរ ៕
សហភាព អង្គការ សង្គម ស៊ីវិល តំណាង អង្គការ សមាគម និង សហគមន៍ ទាំង ៥០ ស្ថាប័ន ថ្កោល ទោស ចំពោះ សារ របស់ លោក សម រង្ស៊ី ថា គ្មាន ការពិចារណា ក្នុង ន័យ បង្អាក់ ដំណើរការ « គម្រោង ព្រែក ជីក ហ្វូណន - តេជោ »
( ភ្នំពេញ ) ៖ សមាគម សហភាព អង្គការ សង្គម ស៊ីវិល តំណាង អង្គការ សមាគម និង សហគមន៍ ទាំង ៥០ ស្ថាប័ន បាន ចេញ សេចក្ដីថ្លែងការណ៍ ថ្កោល ទោស យ៉ាង ខ្លាំង ចំពោះ សារ របស់ លោក សម រង្ស៊ី គ្មាន ការពិចារណា ក្នុង ន័យ បង្អាក់ ដំណើរការ « គម្រោង ព្រែក ជីក ហ្វូណន - តេជោ » ដូច បងប្អូន ជន រួម ជាតិ បាន ជ្រាប ហើយ ថា គម្រោង ព្រែក ជីក ហ្វូណន - តេជោ មាន សារៈសំខាន់ ខ្លាំង ណាស់ សម្រាប់ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម កសិកម្ម ទេសចរណ៍ ដឹកជញ្ជូន និង សារៈប្រយោជន៍ ផ្សេង ៗ ជាច្រើន ទៀត សម្រាប់ ប្រទេស កម្ពុជា ។
ផ្ទុយ មកវិញ បែរជា លោក សម រង្ស៊ី ចេញ សារ គ្មាន ការសិក្សា ស្រាវជ្រាវ ពិចារណា បង្អាក់ ដំណើរការ « គម្រោង ព្រែក ជីក ហ្វូណន តេជោ » ក្នុង ន័យ នេះ គឺ លោក មាន គំនិត ទុច្ចរិត និង ញុះ ញ៉ង់ ជាតិ សាសន៍ ឱ្យ មាន ការបែកបាក់ សាមគ្គីភាព ចំពោះ ប្រជាជន កម្ពុជា និង ដើម្បី តែ ប្រយោជន៍ នយោបាយ ខ្លួន ព្យ យាម បង្អាក់ ដំណើរការអភិវឌ្ឍ ជាតិ កម្ពុជា ។
សហភាព អង្គការ សង្គម ស៊ីវិល តំណាង អង្គការ សមាគម និង សហគមន៍ ទាំង ៥០ ស្ថាប័ន សូម ថ្កោល ទោស ចំពោះ លោក សម រង្ស៊ី ៕
ខាងក្រោម នេះ ជា សេចក្តីថ្លែងការណ៍ របស់ សហភាព អង្គការ សង្គម ស៊ីវិល តំណាង អង្គការ សមាគម និង សហគមន៍ ទាំង ៥០ ស្ថាប័ន៖
សេព គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គម ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៥ ខែ មេសា៖ បង្ក្រាប ៧ករណី ឃាត់ខ្លួន ២៨ នាក់
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៧ករណី ឃាត់ខ្លួន ជនសង្ស័យ ២៨ នាក់ ។
រាជ រដ្ឋាភិបាល កម្ពុជា កំពុង រៀបចំ គោល នយោបាយ ជាតិ ស្ដីពី ការអភិវឌ្ឍ វិស័យ យានយន្ត អគ្គិសនី
ទន្ទឹម នេះ . ដើម្បី ធានា ភាព គ្រប់ ជ្រុងជ្រោយ និង ស៊ីជម្រៅ អភិក្រម ក្នុង ការរៀបចំ គោល នយោបាយ ជាតិ នេះ ប្រកាន់ភ្ជាប់ នូវ គោលការណ៍ ចំនួន ៣គឺ៖ ១៖ ការរក្សា លំនឹង សេដ្ឋកិច្ច . សង្គម និង សុខុមាលភាព ប្រជាជន . ២៖ អនុលោម តាម ក្របខ័ណ្ឌ បរិស្ថាន . សង្គម និង អភិបាលកិច្ច និង ៣៖ ធានា សហ - ថាមពល និង ព្យាសកម្ម ។
( ភ្នំពេញ ) ៖ មហាជន ទូទៅ បាន ដឹង ច្បាស់ ណាស់ ថា បុគ្គល បរាជ័យ ដ៏ ឯកា ឈ្មោះ សម រង្ស៊ី ដែល ជាប់ ពូជ សណ្តាន ក្បត់ ជាតិ ដល់ ទៅ ៣ជំនាន់ មួយ ថ្ងៃ ៗ គ្មាន បាន ធ្វើ អ្វី ជា ប្រយោជន៍ ដល់ ជាតិ និង ប្រជាជន កម្ពុជា ទាល់តែសោះ មាន តែ ការប្រឆាំង យ៉ាង ងប់ ងល់ បំផ្លើស ការពិត គ្រប់ បែបយ៉ាង និង ញុះញង់ ដោយ អគតិ ចំពោះ ថ្នាក់ដឹកនាំ ជាតិ ក្នុង គំនិត ប៉ុនប៉ង បំផ្លាញ សេចក្តីសុខសាន្ត និង បន្ទុចបង្អាក់ ការទទួល ផល ពី វឌ្ឍនភាពសង្គម របស់ ប្រជាពលរដ្ឋ ។
ដោយ មើលឃើញ នូវ ទង្វើ ពុត ត្បុត ដ៏ ខ្មៅ កខ្វក់ របស់ សម រង្ស៊ី បែប នេះ ហើយ គួបផ្សំ នឹង ការយល់ ច្បាស់ អំពី នយោបាយ ដឹកនាំ បែប ស្នេហាជាតិ បម្រើ ឧត្តម ប្រយោជន៍ ជាតិ របស់ រាជ រដ្ឋាភិបាល នៃ គណបក្ស ប្រជាជន កម្ពុជា ទើប អតីត សមាជិក នៃ ក្រុម ប្រឆាំង ដែល ធ្លាប់ តែ ស្និទ្ធ នឹង បុគ្គល នេះ បាន បន្ត ផ្តាច់ ខ្លួន និង ចូលមក រួមរស់ ជាមួយ ជាតិ និង ប្រជាជន វិញ ជា បន្តបន្ទាប់ ។
មេ ឧបឃាត សម រង្ស៊ី នៅសល់ តែ ភាពឯកា ភាពបរាជ័យ និង ជាប់ ឈ្មោះ ក្បត់ ជាតិត ជំនាន់ តែ ប៉ុណ្ណោះ ។
ការពិត ពី មាតុភូមិ . ថ្ងៃព្រហស្បតិ៍ ២រោច ខែ ចេត្រ ឆ្នាំ រោង ឆស័ក ពុទ្ធ សករាជ ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤
អគ្គ នាយក និយ័តករបរ ធន បាលកិច្ច នាំយក ថវិកា ១០លាន រៀល ប្រគល់ ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា
សម្រាប់ កាកបាទ ក្រហម កម្ពុជា ក្នុង នាម ជា សមាជិក ទី ៨៥ របស់ ចលនា អន្តរជាតិ កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ក្នុង ឱកាស នេះ ក៏ បាន បន្ដ អំពាវនាវ កៀរគរ ដល់ សប្បុរសជាតិ អន្ដរជាតិ ចូលរួម ឧបត្ថម្ភ គាំទ្រ ដើម្បីឱ្យ ដំណើរការ នៃ ការងារ មនុស្សធម៌ ជួយសង្គ្រោះ ដល់ ជន ងាយ រងគ្រោះ និង រងគ្រោះ បំផុត នៅ កម្ពុជា និង បណ្ដា ប្រទេសជា មិត្ដ ។
លោកស្រី កិត្តិបណ្ឌិត អ៊ុក ម៉ាលី អគ្គ ហិរ ញ្ញឹក កាកបាទ ក្រហម កម្ពុជា បាន ឲ្យដឹង ថា ក្នុង នាម សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ សប្បុរសជន ទាំងអស់ ដែល សមាន ទឹកចិត្ត ប្រកបដោយ សប្បុរសធម៌ ចូលរួមចំណែក ជាមួយ កាកបាទ ក្រហម កម្ពុជា ហើយ សកម្មភាព ដ៏ ថ្លៃថ្លា នេះ គឺជា កម្លាំង ចលករ មិន អាច ខ្វះ បាន ជួយ ទ្រទ្រង់ និរន្តរភាព នៃ ប្រតិបត្តិការ មនុស្សធម៌ របស់ សមាគម ជាតិ កាកបាទ ក្រហម កម្ពុជា ។
ដោយឡែក ថ្មី នេះ ក្រុម ប្រតិបត្តិកាកបាទ ក្រហម កម្ពុជា ក៏ បាន ផ្តល់ អំណោយ មនុស្សធម៌ ជា បន្តបន្ទាប់ ជូន អង្គការ សមាគមន៍ ចំនួន ៥ រួម មាន អង្គការ សង្គ្រោះ ជន អស់សង្ឃឹម អង្គការ លើ ស្ទួយ ប្រជាពលរដ្ឋ មជ្ឈមណ្ឌល បុរី ទារក និង កុមារ ជាតិ សមាគម តន្ត្រី សំនៀង ជន ពិការ និង អង្គការ ផ្ទះបាយ កុមារ ដែល មាន អ្នកទទួល ផល រាប់ ពាន់ នាក់ ។
ជា ការពិត ណាស់ ថា កាកបាទ ក្រហម កម្ពុជា តែង ចាត់ទុក ទិវា ៨ឧសភា ជា ព្រឹត្តិការណ៍ មហាសប្បុរស មួយ ដែល ជួយ កៀរគរ រក មូលនិធិ សប្បុរសធម៌ បាន ច្រើន សម្រាប់ ទ្រទ្រង់ ប្រតិបត្តិការ និង បេសកកម្ម របស់ ខ្លួន ហើយក៏ ជា ឱកាស មួយ សម្រាប់ សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន បាន បង្ហាញ ពី បេះដូង មនុស្សធម៌ តាមរយៈ វប្បធម៌ នៃ ការចែករំលែក រៀង ៗ ខ្លួន តាម សទ្ធា ជ្រះថ្លា និង ការស្ម័គ្រចិត្ត ។
( ភ្នំពេញ ) ៖ បុរស ឈ្មោះ ផាត់ ផា ត្រូវបាន កម្លាំង សមត្ថកិច្ច នៃ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ ចាប់ខ្លួន បញ្ជូន ទៅ តុលាការ នៅ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ ពាក់ព័ន្ធ ករណី ចេញ មូល ប្បទាន បត្រ គ្មាន សាច់ប្រាក់ ( សែក ស្អុយ ) ចំនួន ១០ម៉ឺន ដុល្លារ ។
ការចាប់ខ្លួន ជន ត្រូវ ចោទ ឈ្មោះ ផាត់ ផា អាយុ ៣៩ ឆ្នាំ ដែល មុខរបរ ពាណិជ្ជករ បាន ធ្វើឡើង នៅ ភូមិ១ សង្កាត់ លេខ ២ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
ការចាប់ខ្លួន នេះ គឺ អនុវត្ត តាម ដីកា បង្គាប់ឱ្យ ខ្លួន របស់ ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ ពី បទ « ឆបោក និង មិន បំពេញ កាតព្វកិច្ច ចំពោះ ឧបករណ៍ អាច ជួញដូរ បាន » តាម បណ្តឹង របស់ ជនរងគ្រោះ ៕ លោក ហេង សួរ បញ្ជាក់ ទៅកាន់ សភា ពាណិជ្ជកម្ម អឺរ៉ុប ប្រចាំ នៅ កម្ពុជា (EUROCHAM) អំពី ការកែសម្រួល សេវា ដើម្បី បង្កើន បរិយាកាស វិនិយោគ
( ភ្នំពេញ ) ៖ លោក ហេង សួរ រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន ថ្លែង បញ្ជាក់ ទៅកាន់ សមាជិក សភា ពាណិជ្ជ កម្ម អឺរ៉ុប ប្រចាំ នៅ កម្ពុជា (EuroCham) អំពី ការកែសម្រួល សេវា របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ អាណត្តិ ទី៧ថ្មី នេះ ដើម្បី បន្ត ជួយ គាំទ្រ និង បង្កើន បរិយាកាស អាជីវកម្ម នៅ កម្ពុជា ឱ្យ កាន់តែ ប្រសើរឡើង បន្ថែម ទៀត ។
អ្នក នៅក្នុង ទីផ្សារ មួយចំនួន មើលឃើញ ថា កម្រិត អត្រា ប្តូរ ប្រាក់ ១៥៥ យ៉េន គឺជា បន្ទាត់ ព្រំដែន មួយ ដែល នឹង ជំរុញ ឱ្យ អាជ្ញាធរ ក្រុង តូក្យូ ចាត់ វិធានការ ។ ប្រាក់ អឺរ៉ូ បាន ឡើង ថ្លៃ ដល់ កម្រិត ខ្ពស់ រយៈពេល ១៦ឆ្នាំ ដោយ ជួញដូរ ក្នុង អត្រា ១៦៦. ៩៨ យ៉េន ក្នុង មួយ អឺរ៉ូ ហើយ ចុងក្រោយ បាន ឡើង ថ្លៃ ០.៤៥ ភាគរយ ដែល នាំឱ្យ ការជួញដូរ ធ្លាក់ចុះ មក នៅ ត្រឹម ១៦៦. ៩៥ យ៉េន វិញ ។
លោក បាន បន្ថែម ថា៖ « ប្រសិនបើ ពួកគេ ទិញ ប្រាក់ យ៉េន សម្ពាធ នៅតែ អាច កើនឡើង ដោយសារតែ វិនិយោគិន ជាច្រើន កំពុង រង់ចាំ ការធ្វើអន្តរាគមន៍ ដើម្បី លក់ រូបិយប័ណ្ណ ជប៉ុន ចេញ » ។ លោក បាន លើកឡើង ថា ប្រាក់ យ៉េន អាច ឡើង ថ្លៃ ដល់ ១៦០ ទោះបីជា មាន អន្តរាគមន៍ ក៏ដោយ ៕
សហរដ្ឋ អាមេរិក តែងតាំង បេសកជន ពិសេស ថ្មី សម្រាប់ បញ្ហា មនុស្សធម៌ នៅ មជ្ឈិមបូព៌ា
រដ្ឋមន្ដ្រី សុខាភិបាល៖ ផ្ដល់ ឈាម មួយ ប្លោក ស្មើនឹង សង្គ្រោះ អាយុជីវិត មនុស្ស ម្នាក់ . ការផ្ដល់ ឈាម មិន ប៉ះពាល់ ដល់ សុខភាព ទេ សូម លើកទឹកចិត្ដ ដល់ ពលរដ្ឋ ចូលរួម បរិច្ចាគ ឈាម ដោយ ស្ម័គ្រចិត្ដ
( ភ្នំពេញ ) ៖ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន ថ្លែង ថា ការផ្ដល់ ឈាម មិន ប៉ះពាល់ ដល់ សុខភាព នោះ ទេ ហើយ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ សូម ចូលរួម បរិច្ចាគ ឈាម ឱ្យ បាន គ្រប់ ៗ គ្នា ហើយ សម្រាប់ អ្នក ដែល ធ្លាប់ ចូលរួម បរិច្ចាគ ឈាម សូម បន្ដ បរិច្ចាគ ឱ្យ ក្លាយជា ទម្លាប់ ដ៏ ប្រពៃ យូរអង្វែង និង ផុល ផុស ដើម្បី ជួយសង្គ្រោះ ជីវិត អ្នកជំងឺ ។
ក្នុង ពិធី បរិច្ចាគ ឈាម ខាងលើ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ ទីប្រឹក្សា ក្រសួង អគ្គ នាយក អគ្គ នាយក រង មន្ទីរពេទ្យ កាល់ម៉ែត លោកស្រី ជឹង សុគន្ធាវី នាយិកា ប្រតិបត្តិ ក្រុមហ៊ុន វ័ន ហ្រេ្វត ធើនីធី ( វីតាល់ ) លោក ប្រធាន មជ្ឈមណ្ឌល ជាតិ ផ្តល់ ឈាម និង លោក លោកស្រី ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ នៃ មន្ទីរពេទ្យ កាល់ម៉ែត មន្ទីរពេទ្យ ជាតិ តេជោ សន្តិភាព មន្ទីរពេទ្យ ព្រះសីហនុ មណ្ឌល នៃ ក្តីសង្ឃឹម រួមទាំង មន្ទីរពេទ្យ ជាតិ នានា និង និស្សិត នៃ សាកលវិទ្យាល័យ វិទ្យាសាស្រ្ត សុខាភិបាល ។
ការស្នើ នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច និង លោក ជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី ។ ពិធី នេះ បាន រៀបចំ ឡើង នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ នា ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ ។
សម្តេច ធិបតី បាន ស្នើ ដល់ គ្រប់ សិល្បករ សិល្បការិនី ទាំងអស់ ឲ្យ ផ្តោត អារម្មណ៍ ឱ្យ កាន់តែ ខ្លាំង ទៅ លើ ទ្រឹស្ដី « ចង្កឹះ មួយបាច់ » ដើម្បី ពង្រឹង សាមគ្គីភាព និង ភាពរឹងមាំ ព្រមទាំង ដើម្បី ពង្រឹង គោលដៅ រួម និង ជោគជ័យ រួម ។
សម្ដេច ធិបតី បាន លើកទឹកចិត្ត ដល់ សិល្បករ សិល្បការិនី គ្រប់ ទម្រង់ ចូលរួម ចង ក្រង ជា សមាគម ឬ ចូល ជា សមាជិក សមាគម សិល្បៈ ដើម្បី ប្រសិទ្ធភាព នៃ ការធ្វើ ការរួមគ្នា ក្នុង ភាព ជា បងប្អូន ដោយ ចេះ ជួយ គ្នា ទៅ វិញ ទៅ មក ស្រប តាម ប្រពៃណី ទំនៀមទម្លាប់ របស់ ដូនតា ។
ការប្រកាស គាំទ្រ បែប នេះ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ ក្នុង ឱកាស ដែល សម្តេច និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ផលិតផល ដូចគ្នា ប៉ុន្តែ ពេល ខ្លះ សម្រាប់ អ្នកទស្សនា នៅក្នុង ប្រទេស តែ មាន ការច្នៃប្រឌិត ឱ្យ ស្រប តាម ស្តង ដារ អន្តរជាតិ តែ មិន នៅ រក្សា បាន អន្តសញ្ញាណ ខ្មែរ រៀបរាប់ ពី រឿង អក្សរសិល្ប៍ របស់ ខ្មែរ ចំណុច នេះ គឺជា ការរុញ វប្បធម៌ របស់ ខ្មែរ ទៅកាន់ ឆាក អន្តរជាតិ បន្ថែម ទៀត ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា ការអភិរក្ស និង ការអភិវឌ្ឍ ត្រូវការដើរ ទន្ទឹម គ្នា ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ វប្បធម៌ សិល្បៈ របស់ ខ្មែរ នៅ គង់វង្ស ថិត ថេរ រាប់ ពាន់ ឆ្នាំ ចំណុច នេះ គឺជា អ្វី ដែល កម្ពុជា ត្រូវ បន្ត ធ្វើ យើង ប្រែប្រួល ទៅ តាម របត់ ប៉ុន្តែ មិន ឱ្យ បាត់បង់ អត្តសញ្ញាណ ជាតិ ខ្មែរ នោះ ទេ ។
បន្ថែម ពី នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ណែនាំ ឱ្យ មាន ការកត់ត្រា ឱ្យ បាន ច្បាស់លាស់ ដើម្បី រក្សា អត្តសញ្ញាណ វប្បធម៌ សិល្បៈ របស់ ខ្មែរ ឱ្យ បាន ពិតប្រាកដ ។ ការអភិវឌ្ឍ ផ្នែក សិល្បៈ ត្រូវ ផ្សារភ្ជាប់ នូវ ទម្រង់ ដែល ជា អត្តសញ្ញាណ របស់ ខ្មែរ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការធ្វើ សមាហរណកម្ម វិស័យ វប្បធម៌ ចូល ទៅក្នុង ពិភពលោក គឺ បង្កើត បានជា ឱកាស ឱ្យ កម្ពុជា អាច បង្ហាញ អ្វី ដែល ខ្មែរ មាន អ្វី ដែល ជា អត្តសញ្ញាណ របស់ ខ្មែរ នៅលើ ឆាក អន្តរជាតិ ។ ការសម្ដែង របាំ ខ្មែរ ជាច្រើន នៅលើ វេទិកា ជាតិ និង អន្តរជាតិ ជាច្រើន បាន នាំ ប្រពៃណី វប្បធម៌ របស់ កម្ពុជា ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន អះអាង ថា បាន របាំ ជូនពរ របាំ សហសម័យ ចម្រៀង សម័យ នៅ កម្ពុជា នៅ ក្រៅ ប្រទេស តាម វេទិកា ផ្សេង ៗ ទៅ បង្ហាញ អន្តរជាតិ ការរៀបចំ ពិធី ដាក់ តាំងពិពណ៌ ផ្សេង ៗ ដែល មាន រូបចម្លាក់ ខ្មែរ នៅ គ្រប់ ពិពណ៌ អន្តរជាតិ ភាពយន្ត ខ្មែរ ដែល បាន ដាក់បញ្ចាំង នៅ អន្តរជាតិ ភាពយន្ត ខ្មែរ ដែល ថត ពី កម្ពុជា បាន អនុញ្ញាតឱ្យ នាំយក នូវ វប្បធម៌ សិល្បៈ របស់ ខ្មែរ ទៅ បង្ហាញ បរទេស ៕
ការលើកឡើង របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី រួម ជាមួយ លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី នា ល្ងាច ថ្ងៃទី ២៥ ខែេម សា ឆ្នាំ ២០២៤ នេះ ។ ពិធី នេះ រៀបចំឡើង នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ ។
សម្ដេច ធិបតី នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « សិល្បករ សិល្បការិនី ខ្មែរ តាមរយៈ ស្នាដៃ និង ទេពកោសល្យ របស់ ខ្លួន បាន ក្លាយជា ស្ពាន នាំ កម្ពុជា ទៅកាន់ ពិភពលោក ដោយ រួមទាំង ការចែករំលែក បទពិសោធន៍ និង ចំណេះដឹង នៃ ប្រវត្តិសាស្ដ្រ ជាតិ របស់ កម្ពុជា ហើយក៏ ជា កាតាលីករ ជំរុញ ការផ្លាស់ប្ដូរ វប្បធម៌ និង ការគោរព គ្នា ទៅ វិញទៅ មក » ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន អះអាង ថា តាមរយៈ ការបំពាក់ នូវ គ្រឿង ឥស្សរិយយស នៅ ពេល នេះ គឺជា និមិត្តរូប នៃ ការទទួលស្គាល់ ការចូលរួមចំណែក របស់ សិល្បករ សិល្បការិនី នៅ ទូទាំង ប្រទេស ដែល ចូលរួម ក្នុង កសាង ពង្រឹង វប្បធម៌ ជាតិ របស់ កម្ពុជា ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត . ក្នុង សាកល ភាវូបនីយកម្ម នា ពេល បច្ចុប្បន្ន តួនាទី របស់ សិល្បករ សិល្បការ នី ខ្មែរ កាន់តែ មាន សារៈសំខាន់ ខ្លាំងក្លា ជាពិសេស សិល្បករ មួយ រូប ៗ សុទ្ធតែ អាច ជា ឯក អគ្គ រាជ ទូត តំណាង វប្បធម៌ នៅលើ ឆាក ជាតិ និង អន្តរជាតិ និង អាច ឆក់ យក ឱកាស ទាំងអស់ នេះ បំផុស ឲ្យ កាន់តែ ខ្ពស់ ឡើង នូវ អត្តសញ្ញាណ ជាតិ ភាពរុងរឿង សា ជា ថ្មី និង ក្តីស្រឡាញ់ ការពារ វប្បធម៌ ជាតិ ឲ្យ កាន់តែ ខ្លាំងក្លា ឡើង ។
ជាមួយគ្នា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែងអំណរគុណ សិល្បករ សិល្បការិនី និង ភ្ញៀវ បរទេស ទាំងអស់ ដែល បាន ចូលរួម លេង កម្សាន្ត ប្រកបដោយ ភាពរីករាយ ព្រមទាំង ថែរក្សា បាន ប្រពៃណី វប្បធម៌ ដ៏ ផូរផង់ របស់ ខ្មែរ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឯកភាព ចំពោះ ការលើកឡើង របស់ លោកស្រី ភឿង ស កុណា រដ្ឋមន្ដ្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ពាក់ព័ន្ធ នឹង តួនាទី គន្លឹះ របស់ សិល្បករ សិល្បការិនី គ្រប់ ទម្រង់ ក្នុង ការចូលរួម ថែរក្សា ប្រពៃណី វប្បធម៌ សិល្បៈ ដ៏ ផូរផង់ បន្សល់ទុក ពី ដូន តា យើង ព្រមទាំង ការអភិវឌ្ឍ និង ផ្សព្វផ្សាយ មរតក ដ៏ ថ្លៃថ្លា នេះ ទៅ លើ ឆាក អន្តរជាតិ ។
ការថ្លែង របស់ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី ។
សម្តេច ធិបតី បាន ថ្លែង ថា « ម្សិលមិញ យើង មាន ការរៀបចំ សម្តែក ក្បាច់គុន សៅ លីញ ជាមួយនឹង ល្បុក្កតោ ដើម្បី បង្ហាញ មិន ត្រឹមតែ ទស្សនិកជន នៅ កម្ពុជា ទេ ប៉ុន្តែ នៅ ចិន និង នៅលើ ពិភពលោក ការផ្លាស់ប្តូរ នូវ ក្បាច់គុណ ក្បាច់ បុរាណ និង សិល្បៈ វប្បធម៌ បង្ហាញ អំពី កម្ពុជា » ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការធ្វើ សមាហរណកម្ម និង ការធ្វើ សាកល ភាវូបនីយកម្ម របស់ កម្ពុជា បាន ផ្តល់ ឱកាស ជាច្រើន ឱ្យ កម្ពុជា ប៉ុន្តែ ជាមួយគ្នា នេះ សាកល ភាវូបនីយកម្ម វប្បធម៌ បាន បង្ក ជា បញ្ហា មួយចំនួន សម្រាប់ ប្រទេស កម្ពុជា និង ប្រទេស ជាច្រើន ទៀត នៅលើ សកលលោក ពាក់ព័ន្ធ នឹង ការថែរក្សា វប្បធម៌ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សាកល ភាវូបនីយកម្ម ផ្នែក សិល្បៈ អាចនឹង ធ្វើឱ្យ យុវជន ខ្មែរ មាន ភាពស្រពិចស្រពិល ចំពោះ វប្បធម៌ បរទេស និង វប្បធម៌ របស់ ខ្លួន ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការរីកសាយភាព វប្បធម៌ សិល្បៈ បរទេស នឹង ធ្វើឱ្យ យុវជន ពី មួយ ជំនាន់ ទៅ មួយ ជំនាន់ យល់ ច្រឡំ បើ ខ្វះ ការយល់ដឹង ។ ត្រង់ ចំណុច នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើក ជា ឧទាហរណ៍ នៃ ថ្ងៃ ក្តីស្រឡាញ់ ១៤កុម្ភៈ មាន យុវជន ខ្មែរ មួយចំនួន យល់ មិន ទាន់ ច្បាស់ នៅឡើយ ។
ព្រឹត្តិការណ៍ នេះ ត្រូវបាន រៀបចំឡើង ក្នុង គោលបំណង ផ្សព្វផ្សាយ បញ្ជ្រាប ការយល់ដឹង អំពី យុទ្ធនាការ « ឆ្នាំ នៃ ការផ្លាស់ប្តូរ ប្រជាជន និង ប្រជាជន កម្ពុជា - ចិន ២០២៤ » ដល់ ស្រទាប់ យុវជន ប្រជាជន នៃ ប្រទេស ទាំង ពីរ និង ថ្នាក់ដឹកនាំ ជំនាន់ ក្រោយ ដើម្បី សម្រេចបាន នូវ ចក្ខុវិស័យ នៃ ការបង្កើត « សហគមន៍ ជោគវាសនា រួម កម្ពុជា - ចិន »៕
ឧប នាយក រដ្ឋមន្ត្រី ស សុខា និង គណៈប្រតិភូ ជាន់ ខ្ពស់ កម្ពុជា បាន ជួបប្រជុំ ជាមួយ អភិបាល ក្រុង Kempten និង មន្ត្រី ជាន់ ខ្ពស់ អាល្លឺម៉ង់
ការបង្ហាញ នូវ ក្ដីរំភើប បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ នា រសៀល ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ពេល បុណ្យ ចូល ឆ្នាំ នេះ ខ្ញុំ សប្បាយចិត្ដ ហើយ ខ្ញុំ មាន ការរំភើប នៅ ការចូលរួម លេង ល្បែង ប្រជាប្រិយ យើង គឺ គ្រប់ កន្លែង ទាំងអស់ នៅ តាម បណ្ដា ស្រុក បណ្ដា ក្រុង គឺ មាន ការរៀបចំ ជំរុញ ការលេង ល្បែង ប្រពៃណី » ។
ទន្ទឹម គ្នា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ការជំរុញ ឲ្យ មាន ការលេង ល្បែង ប្រជាប្រិយ ឡើងវិញ នៅ គ្រប់ ទីកន្លែង នេះ គឺជា សន្ទះ ផុស ផុល . ជា សញ្ញា វិជ្ជមាន . ជា កត្ដា ចំបាច់ ក្នុង ការថែរក្សា វប្បធម៌ ដោយសារ ប្រជាជន នៅ បន្ដ គាំទ្រ បន្ដ ប្រើប្រាស់ និង បន្ដ អនុវត្ដ ។ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការបំផុត ស្មារតី ឲ្យ មាន ការចូលរួម លេង ល្បែង ប្រជាប្រិយ គឺ ល្អ ។
បន្ថែម ពី នោះ ទៀត សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា ការថែរក្សា វប្បធម៌ មិន មែន ជា កាតព្វ របស់ បុគ្គល រូប ណា នោះ ទេ គឺ វប្បធម៌ ដើម្បី ទាំងអស់ គ្នា ហើយ ទាំងអស់ គ្នា ដើម្បី វប្បធម៌ ។
សូម ជម្រាប ថា ការរៀបចំ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ នៅ ឆ្នាំ នេះ រៀបចំ បាន ល្អ បង្ក ភាពសប្បាយរីករាយ ជូន ប្រជាពលរដ្ឋ នៅ គ្រប់ ទីកន្លែង ។ ដោយឡែក បញ្ហា អសន្តិសុខ និង ការបង្ក ហិង្សា នានា ថយចុះ ប្រមាណ ៣០ ភាគរយ ។
យោង តាម របាយការណ៍ បាន បង្ហាញ ថា នៅ ទូទាំង ប្រទេស កម្ពុជា ទទួលបាន ភ្ញៀវ ទេសចរ សរុប ជាង ២១. ៨១លាន នាក់ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី រយៈពេល ៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៣ - ១៦ ខែមេសា ឆ្នាំ ២០២៤ ។ ក្នុង ចំណោម ភ្ញៀវ ទេសចរ សរុប ទាំង ជាង ២១លាន នាក់ នោះ មាន ភ្ញៀវ ទេសចរ ជាតិ និង ប្រជាពលរដ្ឋ ប្រមាណ ២១. ៧០លាន នាក់ និង ទេសចរ បរទេស ប្រមាណ ១១ម៉ឺន នាក់ ៕
អ្នក ឧកញ៉ា ឃុន ស៊ា និង លោកជំទាវ ចូលរួម ឧបត្ថម្ភ ថវិកា ១០ម៉ឺន ដុល្លារ ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា តាមរយៈ ការប្រកួត បាល់ទាត់ មនុស្សធម៌ ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន
ឯកឧត្តម កែប ជុតិ មា ឧបត្ថម្ភ ថវិកា ៥លាន រៀល ជូន ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា តាមរយៈ ការប្រកួត បាល់ទាត់ មនុស្សធម៌ ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន
ចំណេះដឹង ទូទៅ៖ ក្បួន ពី ដើម ក្នុង ពិធី លាង ជើង គេ ឱ្យ ប្អូន កូនក្រមុំ ឬ សាច់ញាតិ លាង ជើង ឱ្យ កូន កម្លោះ
( ភ្នំពេញ ) ៖ បែបបទ នៃ ការធ្វើ ពិធី លាង ជើង គឺជា ចំណុច សំខាន់ ណាស់ ដែល វា ជា ផ្នែក មួយ នៃ ពិធី មង្គលការ ។ គេ សង្កេតឃើញ ថា ការលាង ជើង ត្រូវបាន ខ្មែរ ដែល ទទួល ឥទ្ធិពល អឺរ៉ុប អះអាង ជា ការបន្ថោក តម្លៃ ស្ត្រី ដោយ មតិ នេះ ហើយ ធ្វើឱ្យ ពិធី លាង ជើង ត្រូវបាន កាត់ចោល នៅក្នុង ពិធី អាពាហ៍ពិពាហ៍ ភាគ ច្រើន តែម្តង ។ ខ្មែរ ដែល កាត់ ជំនឿ របស់ គ្រិស្ត សាសនា បាន ឱ្យ កូនក្រមុំ លាង ជើង កូន កម្លោះ ឯ កូន កម្លោះ ត្រូវ លាង ជើង កូនក្រមុំ វិញ ចាក ឆ្ងាយ ពី ប្រពៃណី ដើម របស់ ខ្មែរ ។
ខ្មែរ ដែល ពុំ ដឹង និង អ្នកទទួល ឥទ្ធិពល អឺរ៉ុប ផង នោះ យល់ ថា សិទ្ធិ បុរស និង ស្ត្រី គឺ ស្មើគ្នា ។ ហេតុ នេះ ហើយ បើ កូនក្រមុំ លាង ជើង កូន កម្លោះ កូន កម្លោះ ក៏ ត្រូវ លាង ជើង កូនក្រមុំ ។ ពួកគេ ឆ្ងាញ់ នឹង ឥទ្ធិពល អឺរ៉ុប ពេក អត់ បាន យល់ ទស្សនវិជ្ជា ខ្មែរ ឡើយ ។
ការចង់ឱ្យ លះបង់ ពិធី លាង ជើង ជា ការយល់ ខុស ។ ខ្មែរ បាន ឱ្យ តម្លៃ ស្ត្រី ហើយ ដោយ យល់ឃើញ ពី តម្លៃ ស្ត្រី ទើប ខ្មែរ បង្កើត នូវ រឿង មួយចំនួន ដូចជា ឱ្យ បុរស ដណ្តឹង ស្រ្តី ឱ្យ បុរស ទៅ បម្រើ ខាង ស្រី ពេល រៀបការ ឱ្យ ស្ត្រី កាន់ លុយ ជាដើម ។
គេ មើលឃើញ ថា ពិធី មង្គលការ ត្រូវ ក្បួន គឺ គួរ យក តាម ការកត់ត្រា របស់ ព្រះជ័យ ចេស្តា និង ត្រូវបាន សរសេរ ឡើងវិញ ដោយ អ្នក ឧកញ៉ា មហា ភក្តី ញិក នូវ និង ឧត្តម ប្រី ជា ចាប ពិន ហើយ យើង គួរឱ្យ អ្នកជំនាញ រៀប សៀវភៅ ទី៣ ដែល ល្អ ឥត ខ្ចោះ និង ងាយ មើល ។ គេ គួរឱ្យ ធ្វើ ពិធី លាង ជើង នេះ ដោយ អនុលោម តាម ព្រះជ័យ ចេស្តា ដោយ ឱ្យ ប្អូន ឬ សាច់ញាតិ ខាង ស្រី ជា អ្នក លាង ជើង កូន កម្លោះ ។
ប្រហែល ដោយសារ ភាព វ័យ ឆ្លាត របស់ ព្រះជ័យ ចេស្តា ដែល ព្រះអង្គ បាន ឱ្យ អ្នក លាង ជើង គឺជា ប្អូន ឬ ក្មេង សាច់ញាតិ ខាង ស្រី ជំនួស កូនស្រី គឺ ធ្វើ បែប នេះ ពិធី លាង ជើង អាច រក្សា បាន ទាំង ប្រពៃណី និង ចៀស បាន ពី ការគិត ខុស ថា ជា ការបន្ថោក តម្លៃ ស្ត្រី ទៅ វិញ នោះ ៕
ស្រាវជ្រាវ និង ចង ក្រង ដោយ៖ លោក កែវ ពិសិដ្ឋ ( កែវ គីម សេម ) អ្នកនិពន្ធ បេក្ខជន បណ្ឌិត រាជ បណ្ឌិត្យ សភា កម្ពុជា
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ២រោច ខែ ចេត្រ ឆ្នាំ រោង ឆស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ពិសា អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន លោកគ្រូ អ្នកគ្រូ សិល្បករ និង សិល្បការិនី ។ ពិធី នេះ រៀបចំឡើង នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ ពិសារ អាហារ សាមគ្គី និង បំពាក់ គ្រឿង ឥស្សរិយយស ជូន សិល្បករ និង សិល្បការិនី៖
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សម្តេច និង លោកជំទាវ បណ្ឌិត មាន សេចក្តី សោមនស្ស រីករាយ ដោយ បាន ចូលរួម ជាថ្មី ម្តង ទៀត ក្នុង ពិធី ជួបជុំ មហា គ្រួសារ សិល្បៈ កម្ពុជា បន្ទាប់ពី ទិវា វប្បធម៌ ជាតិ ៣មីនា កន្លងទៅ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែងអំណរគុណ សិល្បករ សិល្បការិនី និង ភ្ញៀវ បរទេស ទាំងអស់ ដែល បាន ចូលរួម លេង កម្សាន្ត ប្រកបដោយ ភាពរីករាយ ព្រមទាំង ថែរក្សា បាន ប្រពៃណី វប្បធម៌ ដ៏ ផូរផង់ របស់ ខ្មែរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឯកភាព ចំពោះ ការលើកឡើង របស់ លោកស្រី ភឿង ស កុណា ពាក់ព័ន្ធ នឹង តួនាទី គន្លឹះ របស់ សិល្បករ សិល្បការិនី គ្រប់ ទម្រង់ ក្នុង ការចូលរួម ថែរក្សា ប្រពៃណី វប្បធម៌ សិល្បៈ ដ៏ ផូរផង់ បន្សល់ទុក ពី ដូន តា យើង ព្រមទាំង ការអភិវឌ្ឍ និង ផ្សព្វផ្សាយ មរតក ដ៏ ថ្លៃថ្លា នេះ ទៅ លើ ឆាក អន្តរជាតិ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សិល្បករ សិល្បការិនី ខ្មែរ ដ៏ ច្រើន រាប់ មិន អស់ នៅ គ្រប់ ជំនាន់ បាន បូជា កម្លាំង កាយ ចិត្ត ស្មារតី ទេពកោសល្យ រហូត ជីវិត របស់ ខ្លួន ដើម្បី ថែរក្សា ការពារ កេរមរតក ដូនតា គ្រប់ ៗ ទម្រង់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សិល្បករ សិល្បការិនី ខ្មែរ តាមរយៈ ស្នាដៃ និង ទេពកោសល្យ របស់ ខ្លួន បាន ក្លាយជា ស្ពាន នាំ កម្ពុជា ទៅកាន់ ពិភពលោក ដោយ រួមទាំង ការចែករំលែក បទពិសោធន៍ និង ចំណេះដឹង នៃ ប្រវត្តិសាស្ត្រ ជាតិ កម្ពុជា ទាំង ការតស៊ូ ទាំង ការឈឺចាប់ ហើយក៏ ជា កាតាលីករ នៃ ការជំរុញ ការផ្លាស់ប្តូរ វប្បធម៌ និង ការគោរព គ្ន ទៅ វិញ ទៅមក ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ក្នុង សាកល ភាវូបនីយកម្ម នា ពេល បច្ចុប្បន្ន តួនាទី របស់ សិល្បករ សិល្បការ នី ខ្មែរ កាន់តែ មាន សារៈសំខាន់ ខ្លាំងក្លា ជាពិសេស សិល្បករ មួយ រូប ៗ សុទ្ធតែ អាច ជា ឯក អគ្គ រាជ ទូត តំណាង វប្បធម៌ នៅលើ ឆាក ជាតិ និង អន្តរជាតិ និង អាច ឆក់ យក ឱកាស ទាំងអស់ នេះ បំផុស ឱ្យ កាន់តែ ខ្ពស់ ឡើង នូវ អត្តសញ្ញាណ ជាតិ ភាពរុងរឿង សា ជា ថ្មី និង ក្តីស្រឡាញ់ ការពារ វប្បធម៌ ជាតិ ឱ្យ កាន់តែ ខ្លាំងក្លា ឡើង ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ក្រោម ម្លប់ នៃ សន្តិភាព និង ការបោះជំហាន ទៅ មុខ ជាប់ មិន ដាច់ លើ គ្រប់ វិស័យ វឌ្ឍនភាព នៃ វិស័យ សិល្បៈ ក៏ ទទួលបាន នូវ សន្ទុះ មួយ ជា ទី មោទនៈ ផងដែរ ។ ជា ការពិត បញ្ហា និង ភាពរអាក់រអួល ដោយ ចេតនា ឬ អចេតនា តែងតែ កើតមាន ចៀស មិន ផុត ពីព្រោះ ជា លក្ខណៈ ធម្មជាតិ ពុំ មាន បុគ្គល ណា មួយ មាន ភាព ឥត ខ្ចោះ នោះ ទេ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ថ្លែង ថា ការសម្តែង ក្បាច់គុណ សៅ លីង និង ល្បុក តោ នៅ ខេត្ត សៀមរាប ជា ការបង្ហាញ វប្បធម៌ ទៅកាន់ ពិភពលោក
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការរីកសាយភាព វប្បធម៌ សិល្បៈ បរទេស នឹង ធ្វើឱ្យ យុវជន ពី មួយ ជំនាន់ ទៅ មួយ ជំនាន់ យល់ ច្រឡំ បើ ខ្វះ ការយល់ដឹង ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើក ជា ឧទាហរណ៍ នៃ ថ្ងៃ ក្តីស្រឡាញ់ ១៤កុម្ភៈ មាន យុវជន ខ្មែរ មួយចំនួន យល់ មិន ទាន់ ច្បាស់ នៅឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សាកល ភាវូបនីយកម្ម ផ្នែក សិល្បៈ អាចនឹង ធ្វើឱ្យ យុវជន ខ្មែរ មាន ភាពស្រពិចស្រពិល ចំពោះ វប្បធម៌ បរទេស និង វប្បធម៌ របស់ ខ្លួន ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា អភិរក្ស និង អភិវឌ្ឍន៍ ត្រូវ ដើរ ជាមួយគ្នា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការអភិវឌ្ឍ ផ្នែក សិល្បៈ ត្រូវ ផ្សារភ្ជាប់ នូវ ទម្រង់ ដែល ជា អត្តសញ្ញាណ របស់ ខ្មែរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត គាំទ្រ ការយក ហូល ផា មួង កាត់ ជា អាវធំ ហើយ ចង់ឱ្យ ភរិយា កាត់ ជូន សម្តេច ផងដែរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ណែនាំ ឱ្យ មាន ការកត់ត្រា ឱ្យ បាន ច្បាស់លាស់ ដើម្បី រក្សា អត្តសញ្ញាណ វប្បធម៌ សិល្បៈ របស់ ខ្មែរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ថ្លែង កោតសរសើរ ចំពោះ អ្នក សិល្បៈ ក្រៅ ប្រព័ន្ធ ដែល បាន ប្រឹងប្រែង បង្ហាញ ទម្រង់ សិល្បៈ ខ្មែរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សម្តេច មាន ក្តី រំភើប នៅពេល មាន ល្បែង ប្រជាប្រិយ របស់ ខ្មែរ ច្រើន ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ស្នើ ដល់ គ្រប់ សិល្បករ សិល្បការិនី ទាំងអស់ ផ្តោត អារម្មណ៍ ឱ្យ កាន់តែ ខ្លាំង ទៅ លើ ទ្រឹស្ដី « ចង្កឹះ មួយបាច់ » ដើម្បី ពង្រឹង សាមគ្គីភាព និង ភាពរឹងមាំ ព្រមទាំង ដើម្បី ពង្រឹង គោលដៅ រួម និង ជោគជ័យ រួម ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង លើកទឹកចិត្ត ដល់ សិល្បករ សិល្បការិនី គ្រប់ ទម្រង់ ចូលរួម ចង ក្រង ជា សមាគម ឬ ចូល ជា សមាជិក សមាគម សិល្បៈ ដើម្បី ប្រសិទ្ធភាព នៃ ការធ្វើ ការរួមគ្នា ក្នុង ភាព ជា បងប្អូន ដោយ ចេះ ជួយ គ្នា ទៅ វិញ ទៅ មក ស្រប តាម ប្រពៃណី ទំនៀមទម្លាប់ របស់ ដូនតា យើង ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការបង្កើត យុទ្ធសាស្ត្រ ទាញ ចំណាប់អារម្មណ៍ ពី សាធារណជន គួរ មាន ការ ថ្លឹងថ្លែង និង ពិចារណា ជាមុន ពី ផល ប៉ះពាល់ ផ្នែក វប្បធម៌ ប្រពៃណី និង សីលធម៌ សង្គម ដោយ ពុំ គួរ ប្រើប្រាស់ ជំហរ អត្តនោម័តិ ឬ ជំហរ ចង់ ល្បី ភ្លាម ៗ ដែល អាច ប៉ះពាល់ ដល់ បុគ្គល ផង ដល់ តម្លៃ ជាតិ ផង នោះ ទេ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ក្នុង បរិបទ នៃ បរិវត្តកម្ម ឌីជីថល ការចែករំលែក ព័ត៌មាន ក្នុង សង្គម កាន់តែ លឿន និង ពិបាក ទប់ស្កាត់ ។ ដើម្បី ចូលរួម ដល់ ភាពរឹងមាំ នៃ សង្គម យើង សូម រំលឹក ដល់ គ្រប់ សិល្បករ សិល្បការិនី ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចៀសវាង ឱ្យ បាន នូវ ការប្រឌិត និង ការសម្តែង ទាំងឡាយ ដែល មាន លក្ខណៈ មិន ពិត អុជ អាល បំបែកបំបាក់ ប្រកាន់ ពូជសាសន៍ ពណ៌ សម្បុរ និង ជំនឿ សាសនា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា « រលក ថ្មី ច្រាន រលក មុខ » គឺជា ក្រឹត្យ ក្រម ធម្មជាតិ ។ សិល្បករ សិល្បការិនី រៀមច្បង មិន ត្រឹមតែ ជា រលក នាំមុខ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ជា តួអង្គ ដែល មាន បទពិសោធន៍ និង ជា គំរូ ដល់ រលក ជំនាន់ ក្រោយ ដល់ យុវជន បន្ត វេន ។ ក្នុង ន័យ នេះ ការជួយជ្រោមជ្រែង បង្ហាត់ បង្រៀន ផ្ទេរ ចំណេះដឹង និង ការលើកទឹកចិត្ត ដល់ យុវជន វ័យ ក្មេង គឺជា កាតព្វកិច្ច ដើម្បី បន្ត ថែរក្សា មរតក ដូនតា និង ការបន្ត រីកចម្រើន ទៅ មុខ របស់ វិស័យ សិល្បៈ វប្បធម៌ របស់ យើង ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ស្នើឲ្យ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ត្រូវ ធ្វើ ការណែនាំ កែលម្អ ចំពោះ កំហុសឆ្គង នានា ព្រមទាំង តម្រង់ ទិស និង ចង្អុលបង្ហាញ ពី ឥរិយាបថ ដែល គួរ ប្រកាន់ យក ដើម្បី ភាពថ្លៃថ្នូរ និង បង្ការ ផល ប៉ះពាល់ ជា យថាហេតុ មក លើ សិល្បៈ វប្បធម៌ ប្រពៃណី ជាតិ ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៣៥៤ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ២៥ ខែមីនា ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៥.៧៥៩ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៤.២៣៣ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.៥២៦ គ្រឿង ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៣ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០១នាក់ របួស ចំនួន ០៧ នាក់ ( របួស ធ្ងន់ ចំនួន ០១នាក់ ) ។ រយៈពេល ២៥ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ២២២ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១២៥ នាក់ របួស ៣១៤ នាក់ ( របួស ធ្ងន់ ១៩៤ នាក់ )៕
ក្រុម មយុវជន សង្គម ស៊ីវិល អង្គការ សមាគម និង ក្រុម សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ផ្តាំ ទៅ ក្រុម ប្រឆាំង ជ្រុលនិយម ថា កុំ យក រឿង ព្រែក ជីក ហ្វូណន - តេជោ ធ្វើជា ឧបករណ៍ កេង ចំណេញ ផ្នែក នយោបាយ
លោក ហេង សំណាង បាន ចេញមុខ លើកឡើង បែប នេះ បន្ទាប់ពី មាន ការចុះផ្សាយ ក៏ ដូចជា ការលើកឡើង ទាំ ងងឹតងងុល របស់ ក្រុម ប្រឆាំង ជ្រុលនិយម ក្រៅ ប្រទេស មួយ ក្ដាប់ តូច នៅតែ ធ្វើ សកម្មភាព ចោទប្រកាន់ ដោយ គ្មាន មូលដ្ឋាន ទាក់ទង នឹង ករណី ព្រែក ជីក ហ្វូណន - តេជោ ទៅនឹង ភូមិសាស្រ្ដ នយោបាយ ជាមួយ ប្រទេស ចិន ។
លោក បាន លើកឡើង ថា ការចោទប្រកាន់ ទាំង គ្មាន មូលដ្ឋាន របស់ ក្រុម ប្រឆាំង ជ្រុលនិយ ភ្លេច ជាតិ កំណើត ខ្លួន ទាំងនោះ គឺ ផ្ទុយ ពី ការពិត ខណៈ ដែល គម្រោង សាង កសាង ព្រែក ជីក ហ្វូណន - តេជោ នេះ គឺ ធ្វើឡើង ដើម្បី តែ ផលប្រយោជន៍ សេដ្ឋកិច្ច សង្គម របស់ ប្រជាពលរដ្ឋ កម្ពុជា តែ ប៉ុណ្ណោះ ពោល ជួយ ឱ្យ កម្ព ជា មាន ផ្លូវ ទឹក ដឹកជញ្ជូន ទៅកាន់ សមុទ្រ បន្ថែម លើ ផ្លូវ ដឹកជញ្ជូន តាម ដងទន្លេ មេគង្គ ។
លោក ហេង សំណាង បាន ថ្លែង ថា បើ និយាយ អំពី សន្តិភាព និង ការអភិវឌ្ឍ គឺ គេ តែង នឹង ដល់ ការលះបង់ និង តស៊ូ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន លះបង់ សាច់ ស្រស់ ឈាម ស្រស់ ជាង ៤០ ឆ្នាំ មក នេះ ។ សម្តេច តេជោ បាន ចូលរួម ក្នុង បុព្វហេតុ ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ និង ប្រជាជន ខ្មែរ ហើយ ការលះបង់ របស់ សម្ដេច តេជោ គឺជា គំរូ សម្រាប់ យុវជន ជំនាន់ ក្រោយ បន្ត រៀនសូត្រ ។
លោក បាន គូសបញ្ជាក់ ថា៖ « បើ យើង ធៀប កម្ពុជា មុន នឹង មាន ថ្ងៃ នេះ គឺ បាន ឆ្លងកាត់ ភាពលំបាក ច្រើន ស្ទើរតែ បាត់បង់ ប្រទេស បើ គ្មាន ការដឹកនាំ ប្រទេស ដ៏ ប៉ិនប្រសប់ របស់ សម្តេច តេជោ ទេ នោះ ម្ល៉េះ កម្ពុជា អាចនឹង បន្ត ជោគជាំ ដោយ ភ្លើង សង្គ្រាម គ្មាន ថ្ងៃ ផ្សះផ្សា និង សមាហរណកម្ម បាន នោះ ឡើយ »៕
លោក ចាត់ទុក ការឆ្លើយតប នេះ គឺជា សារ មួយ សម្រាប់ ជន អគតិ ពិសេស ក្រុម ទណ្ឌិត ភៀង ខ្លួន ក្រៅ ប្រទេស ឬ ក្រុម ប្រឆាំង ជ្រុល និយម មួយ ចំនួន តូច គួរតែ រៀនសូត្រ និង យល់ ពី តម្លៃ សន្តិភាព ជាជាង អង្គុយ រិះរក មធ្យោបាយ បង្អាក់ ឬ ចង់ បំផ្លាញ សន្តិភាព នៅ កម្ពុជា ពិសេស បញ្ឈប់ នូវ វប្បធម៌ លាប ពណ៌ មក លើ កម្ពុជា និង កុំ យក គម្រោង ព្រែក ជីក ហ្វូណន តេជោ ធ្វើជា រឿង នយោបាយ រួច វាយប្រហារ មក លើ រាជ រដ្ឋាភិបាល ។
លោក សង្កត់ធ្ងន់ ថា វត្តមាន ដ៏ ខ្ពស់ ខ្ពស់ របស់ សម្តេច តេជោ ដែល បាន បូជា សាច់ ស្រស់ ឈាម ស្រស់ ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ កន្លងមក ក៏ ដូចជា ការខិតខំ ប្រឹងប្រែង ឥត ឈប់ឈរ ទាំង យប់ ទាំង ថ្ងៃ គឺ បាន កែប្រែ មុខមាត់ កម្ពុជា ជា ប្រវត្តិសាស្ត្រ ងើប មុខ លើ ឆាក អន្តរជាតិ ដែល បង្ហាញ ពី ភាពរីកចម្រើន លើ គ្រប់ វិស័យ រក្សា បាន សុខ សន្តិភាព ឯករាជ្យភាព អធិបតេយ្យ បូរណភាព ទឹកដី យ៉ាង ពេញលេញ ។
អតីត សមាជិក ក្រុម ប្រឆាំង ចេញមុខ ប្រឆាំង ដាច់ខាត ចំពោះ សារ របស់ លោក សម រង្ស៉ី ដែល ជំទាស់ នឹង គម្រោង ព្រែក ជីក ហ្វូណន
( ភ្នំពេញ ) ៖ អតីត សមាជិក ក្រុម ប្រឆាំង បាន ចេញ ថ្កោល ទោស លោក សម រង្ស៉ី ដែល បាន រិះគន់ លើ គម្រោង ព្រែក ជីក ហ្វូណន ដែល បម្រើ ឱ្យ ផលប្រយោជន៍ ជាតិ ។ អតីត សមាជិក ក្រុម ប្រឆាំង នេះ បាន ស្នើ ឱ្យ ទណ្ឌិត សម រង្ស៉ី បញ្ឈប់ រាល់ សកម្មភាព ញុះញង់ ឲ្យ មាន ការរើសអើង រដ្ឋាភិបាល កម្ពុជា ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ខ្មែរ សាមគ្គី គ្នា ក្នុង ការអភិវឌ្ឍន៍ ប្រទេសជាតិ ។
