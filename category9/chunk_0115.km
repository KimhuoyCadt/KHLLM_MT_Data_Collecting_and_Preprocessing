( ប៉េកាំង ) ៖ នៅ ថ្ងៃពុធ នេះ ចិន បាន ចេញមុខ ព្រមាន ថា ការគាំទ្រ ផ្នែក យោធា របស់ សហរដ្ឋ អាមេរិក សម្រាប់ តៃវ៉ាន់ កំពុងតែ បង្កើន ហានិភ័យ នៃ ជម្លោះ នៅ តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ បន្ទាប់ពី សភា ទាំង២ របស់ អាមេរិក បាន អនុម័ត ថវិកា ចំនួន ៨ ពាន់ លាន ដុល្លារ សម្រាប់ ផ្តល់ ការគាំទ្រ ផ្នែក យោធា ដល់ ដែន កោះ នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នា ថ្ងៃពុធ ទី២៤ ខែមេសា ឆ្នាំ ២០២៤ ។
លោក Wang បាន បន្ត ថា « ភាពជិតស្និទ្ធ នៃ ទំនាក់ទំនង យោធា មិន អាច ជួយ សង្រ្គោះ ជោគវាសនា អន្តរាយ នៃ ចលនា ឯករាជ្យ តៃវ៉ាន់ ឡើយ ។ សហរដ្ឋ អាមេរិក គួរតែ ឈប់ បំពាក់ អាវុធ ឱ្យ តៃវ៉ាន់ ឈប់ បង្កើត ភាពតានតឹង នៅ ច្រក សមុទ្រ តៃវ៉ាន់ ហើយ ឈប់ បំផ្លាញ សុខ សន្តិភាព និង ស្ថិរភាព នៅ ត្រើយ ទាំង សងខាង នៃ ច្រក សមុទ្រ តៃវ៉ាន់ ត ទៅទៀត » ។
( ភ្នំពេញ ) ៖ និយ័តករ អាជីវកម្ម អចលន វត្ថុ និង បញ្ចាំ ( ន. អ. ប. ) សេចក្តីជូនដំណឹង ថ្មី មួយ ដោយ ធ្វើ បច្ចុប្បន្នភាព សេចក្តីជូនដំណឹង ចុះ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៤ ស្តីពី ឈ្មោះ ក្រុមហ៊ុន / គម្រោង ដែល ប្រកប អាជីវកម្ម អភិវឌ្ឍ ដីឡូត៍ ដោយ គ្មាន អាជ្ញាបណ្ណ ពី និយ័តករ អាជីវកម្ម អចលន វត្ថុ និង បញ្ចាំ ។
គម្រោង ដីឡូត៍ ដែល គ្មាន អាជ្ញាបណ្ណ ដែល ត្រូវ ប្រកាស ឈ្មោះ នេះ មាន ចំនួន ៧គម្រោង ៕
ថវិកា ធានារ៉ាប់រង សង្គម ជាង ២២ លាន រៀល និង អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ប្រគល់ ជូន គ្រួសារ សព អតីត យុទ្ធជន ២គ្រួសារ នៅ ក្រុង ស្ទឹង សែន
( កំពង់ធំ )៖ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ រួម ជាមួយនឹង ថ្នាក់ដឹកនាំ នៃ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត កំពង់ធំ នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន នាំយក ថវិកា ធានារ៉ាប់រង សង្គម ចំនួន ២២. ១៩៥. ២០០ រៀល និង អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ទៅ ឧបត្ថម្ភ ជូន គ្រួសារ សព អតីត យុទ្ធជន ចំនួន ២គ្រួសារ នៅ ក្រុង ស្ទឹង សែន ។
គ្រួសារ សព អតីត យុទ្ធជន ទាំង ២គ្រួសារ នោះ ក្នុង មួយ គ្រួសារ សព ទទួលបាន ថវិកា ជាង ១១ លាន រៀល និង អង្ករ ២៥ គីឡូក្រាម មីជាតិ ១កេស ទឹកត្រី ទឹក ស៊ី អ៉ីវ ១យួរ និង ត្រីខ កំប៉ុង ១យួរ ផងដែរ ។
លោក ជួន សិលា វុត ប្រធាន សាខា មូលនិធិ ជំនួយ សង្គម នៃ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត កំពង់ធំ បាន ជម្រាប ជូន ក្រុមគ្រួសារ សព អតីត យុទ្ធជន អំពី របប ថវិកា ធានារ៉ាប់រង សង្គម ដែល គ្រួសារ នីមួយ ៗ ត្រូវ ទទួលបាន ទៅ តាម ឋានន្តរសក្តិ និង អតីតភាព ការងារ របស់ សព អតីត យុទ្ធជន នីមួយ ៗ ហើយ ថវិកា ធានារ៉ាប់រង សង្គម ដែល ត្រូវបាន ប្រគល់ ជូន នៅ ពេល នេះ គឺជា ការគិតគូរ យកចិត្តទុកដាក់ ពី ប្រមុខ រដ្ឋាភិបាល កម្ពុជា ។
នា ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន ថ្លែង នូវ ការសោកស្ដាយ ចំពោះ ការបាត់បង់ជីវិត របស់ អតីត យុទ្ធជន ដែល ធ្លាប់ មាន គុណ បំណាច់ ចំពោះ ជាតិ មាតុភូមិ និង ប្រជាជន និង សូម បួងសួង ដល់ វិញ្ញាណក្ខន្ធ បងប្អូន អតីត យុទ្ធជន ទាំងនោះ សូម បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
លោក ឧត្ដមសេនីយ៍ ទោ សោម ស៊ុន ក៏ បាន បញ្ជាក់ ថា ក្រោម ការយកចិត្តទុកដាក់ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ក្រោម ការចង្អុល ណែនាំ របស់ លោក ទេសរដ្ឋមន្ត្រី នាយ ឧត្តមសេនីយ៍ គន់ គីម លោក បាន យកចិត្តទុកដាក់ គ្រប់ បែបយ៉ាង ពី សុខ ទុក្ខ និជីវភាព រស់ របស់ អតីត យុទ្ធជន នៅ គ្រប់ ទីកន្លែង និង គ្រប់ ពេលវេលា ព្រោះ អតីត យុទ្ធជន បាន ចូលរួមចំណែក ធ្វើឲ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញលេញ ដូច សព្វ ថ្ងៃ នេះ ។
កិច្ចសន្ទនា នេះ ត្រូវបាន ធ្វើឡើង កាលពី ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២៤ កន្លងទៅ នៅ វត្ត និគ្រោធ វ័ន គល់ ទទឹង ស្ថិត ក្នុង ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ។ កិច្ចសន្ទនា នេះ ទទួលបាន ការនិមន្ត និង អញ្ជើញ ចូលរួម ជា វាគ្មិន ដោយ ព្រះមេធានុរ័ក្ខ គូ សុភាព សាស្ត្រាចារ្យ នៅ សាកលវិទ្យាល័យ បញ្ញាសាស្ត្រ កម្ពុជា និង លោក ប៉ែន បូណា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ។
កិច្ចសន្ទនា នេះ មាន គោលបំណង សំខាន់ ៗ ចំនួន ៤រួម មាន៖ ១៖ យល់ដឹង ពី គោលការណ៍ ព្រះពុទ្ធ សាសនា ក្នុង កិច្ច បដិបត្តិ ប្រចាំ ថ្ងៃ ២៖ យល់ដឹង ពី ការអប់រំ ចិត្ត និង របៀប ដោះស្រាយ បញ្ហា តាម គន្លង មាគ៌ា ព្រះពុទ្ធ សាសនា ៣៖ លើកទឹកចិត្ត សាធារណជន ក្នុង ការប្រើប្រាស់ ប្រព័ន្ធ បណ្តាញ សង្គម ប្រកបដោយ ទំនួល ខុសត្រូវ ខ្ពស់ ៤៖ លើកទឹកចិត្ត សាធារណជន ក្នុង ការចូលរួមចំណែក អភិវឌ្ឍ សង្គមជាតិ ៕
ក្នុង ឱកាស នោះ លោក សាស្ត្រាចារ្យ ឈាង រ៉ា បាន ថ្លែង សារលិខិត របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន ចេញ សារលិខិត ក្នុង ឱកាស ប្រារព្ធ ទិវា ជាតិ ប្រយុទ្ធ នឹង ជំងឺ គ្រុនចាញ់ ក្រោម ប្រធានបទ « លើកកម្ពស់ សមធម៌ សុខភាព សមភាព យេនឌ័រ និង សិទ្ធិ មនុស្ស ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ គ្រុនចាញ់ » ។
លោក សាស្ដ្រាចារ្យ រដ្ឋមន្ដ្រី បាន លើកឡើង ទៀត ថា « ទិវា គ្រុនចាញ់ ពិភពលោក និង ទិវា ជាតិ ប្រយុទ្ធ នឹង ជំងឺ គ្រុនចាញ់ នៅ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៤ . សម្រាប់ កម្ពុជា យើង បាន ប្រារព្ធ ធ្វើ មុន មួយ ថ្ងៃ នេះ គឺ បញ្ជាក់ អំពី ភាពបុរេសកម្ម របស់ ប្រជាពលរដ្ឋ និង ភ្នាក់ងារ របស់ យើង » ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ លោក សាស្ដ្រាចារ្យ រដ្ឋមន្ដ្រី បាន ថ្លែងអំណរគុណ ដល់ រាជ រដ្ឋាភិបាល អាជ្ញាធរ មូលដ្ឋាន កងកម្លាំងប្រដាប់អាវុធ មន្ដ្រី ពាក់ព័ន្ធ និង ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន ចូលរួម យ៉ាង សស្រាក់សស្រាំ ក្នុង ការលុបបំបាត់ ជំងឺ គ្រុនចាញ់ នេះ ពិសេស ការទទួលបាន ជោគជ័យ ៣ឆ្នាំ ជាប់ គ្នា មក នេះ ដែល កម្ពុជា មិន មាន ករណី ស្លាប់ ដោយ ជំងឺ គ្រុនចាញ់ នោះ ទេ ៕ សម្តេច ព្រះពោធិវ័ង្ស កិត្តិបណ្ឌិត អំ លីមហេង បើក វគ្គ បណ្តុះបណ្តាល គណៈ គ្រប់គ្រង សាលា ពុទ្ធិក មធ្យមសិក្សា សម្រាប់ ឆ្នាំ សិក្សា ២០២៤ - ២០២៥
( ភ្នំពេញ ) ៖ សម្តេច ព្រះពោធិវ័ង្ស កិត្តិបណ្ឌិត អំ លីម ហេង ព្រះអគ្គាធិការ នៃ អគ្គាធិការដ្ឋាន ពុទ្ធិក សិក្សា ក្រសួង ធម្មការ និង សាសនា នៅ ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៤ បាន និមន្ត ជា ព្រះរាជា ធិបតី បើក វគ្គ បណ្តុះបណ្តាល គណៈ គ្រប់គ្រង សាលា ពុទ្ធិក មធ្យមសិក្សា សម្រាប់ ឆ្នាំ សិក្សា ២០២៤ - ២០២៥ ។ វគ្គ បណ្តុះបណ្តាល នេះ ធ្វើឡើង រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៤ មាន សិក្ខាកាម ចូលរួម ៧៨ រូប ។
យោង តាម របាយការណ៍ របស់ ព្រះសង្ឃាលង្ការ មុនី បណ្ឌិ យ៉ន កុសល្យ ប្រធាន ផ្នែក ពុទ្ធិក មធ្យមសិក្សា ឱ្យដឹង ថា នៅក្នុង ឆ្នាំ សិក្សា ២០២៤ - ២០២៥ គ្រឹះស្ថាន ពុទ្ធិក មធ្យមសិក្សា ទាំង ពីរ កម្រិត មាន ចំនួន ៥៣ សាលា គ្រូ ចំនួន ៨៣៧ រូប និង សមណ សិស្ស សិស្ស ចំនួន ៩៤៤៤ នាក់ រូប ។
របាយការណ៍ របស់ ព្រះសង្ឃាលង្ការ មុនី បណ្ឌិ យ៉ន កុសល្យ ឱ្យដឹង បន្ត ថា មុខវិជ្ជា ដែល ត្រូវ បណ្តុះបណ្តាល រួម មាន៖
១៖ យន្តការ នៃ ការប្រលង សញ្ញាបត្រ និង របប ពិន្ទុ ធ្វើ បទបង្ហាញ ដោយ លោក មឹង វាសនា ២៖ ការគ្រប់គ្រង ការបង្រៀន និង រៀន គឺជា យន្តការ ឆ្ពោះ ទៅរក គុណភាព ធ្វើ បទបង្ហាញ ដោយ លោក បណ្ឌិត គួយ សូគាន ៣៖ បរិវត្តកម្ម បច្ចេកវិទ្យា អប់រំ ឌីជីថល នៅ សាលា ផ្នែក ទ្រឹស្តី ធ្វើ បទបង្ហាញ ដោយ លោក សម្យ កំសាន្ត និង ផ្នែក អនុវត្តន៍ ធ្វើ បទបង្ហាញ ដោយ លោកស្រី គឹម មិថុនា ៤៖ វឌ្ឍនភាព នៃ ពុទ្ធ កសិក្សា ព្រះសុរា ម្រឹត ធ្វើ បទបង្ហាញ ដោយ សម្តេច ព្រះមង្គល មុនីវង្ស ហ៊ូ ឈីវនា ។
នា ឱកាស នោះ ដែរ សម្តេច ព្រះពោធិវ័ង្ស កិត្តិបណ្ឌិត អំ លីមហេង បាន មាន ផ្តាំផ្ញើ សិក្ខាកាម ឱ្យ យកចិត្តទុកដាក់ ត្រងត្រាប់ ស្តាប់ ការធ្វើ បទបង្ហាញ ដើម្បី យក ចំណេះដឹង ទៅ ប្រើប្រាស់ ត្រឹមត្រូវ តាម ការរំពឹងទុក ៕ ឧប នាយក រដ្ឋមន្រ្តី ស សុខា និង លោកស្រី អញ្ជើញ ចូលរួម ពិសា អាហារ សាមគ្គី ពេល ល្ងាច ផ្លូវការ នៅ ទីក្រុង ប៊េន
ជនរងគ្រោះ ក្នុង សំណុំរឿង សែក ស្អុយ ជាង ១លាន ដុល្លារ ស្នើ ក្រសួង យុត្តិធម៌ ជួយ តាមដាន ដំណើរការ កាត់ក្ដី នៅ សាលាដំបូង រាជធានី ភ្នំពេញ . សវនាការ ធ្វើឡើង នៅ ថ្ងៃទី ២៩ ខែមេសា
( ភ្នំពេញ ) ៖ ស្ដ្រី ម្នាក់ ឈ្មោះ លី ដា អេ អាយុ ៥១ ឆ្នាំ ស្នាក់ នៅ ផ្ទះ លេខ ១៧ ផ្លូវ លខ ៤៨៤ សង្កាត់ ផ្សារ ដើម ថ្កូវ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ត្រូវបាន គេ ស្គាល់ ថា ជា ឈ្មួញ រកស៊ី ដីធ្លី ម្នាក់ និង ជា ថៅកែ ហ្ការ៉ា សាំង ជាច្រើន កន្លែង នោះ បាន ចេញ មូល ប្បទាន ប័ត្រ ( សែក ស្អុយ ) ចំនួន ២សន្លឹក ដោយ ពុំ មាន សាច់ប្រាក់ ជូន ជនរងគ្រោះ ម្នាក់ សរុប ជាង ១លាន ដុល្លារ ហើយ ត្រូវបាន សាលាដំបូង រាជធានី ភ្នំពេញ ចោទប្រកាន់ ពី បទ « មិន បំពេញ កាព្វកិច្ច ចំពោះ ឧបករណ៍ អាច ជួញដូរ បាន » ។
សាលាដំបូង រាជធានី ភ្នំពេញ ក៏ បាន ចេញ ដីកា បង្គាប់ ឲ្យ ជនជាប់ចោទ រូប នេះ ចូល ខ្លួន មក ជំនុំជម្រះ ទោស នៅ ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២៤ វេលា ម៉ោង ២រសៀល ក្នុង បន្ទប់ សាល សាវនា ការ ទី៣ ដើម្បី ផ្តល់ យុត្តិធម៌ ដល់ ជនរងគ្រោះ ។
ទាក់ទិន ករណី នេះ កន្លងមក ស្រ្តី ឈ្មោះ លី ដាអេ មិន ដែល ចូល ខ្លួន មក ដោះស្រាយ និង តែងតែ ព្យាយាម គេចវេស ពី ការទទួលខុសត្រូវ របស់ ខ្លួន ដែល ជា ហេតុ បណ្ដាលឲ្យ សាលាដំបូង រាជធានី ភ្នំពេញ ធ្វើ ការចោទប្រកាន់ ។
ស្រ្តី ខាងលើ នេះ កាលពី ថ្ងៃ ១៥ ខែមិថុនា ឆ្នាំ ២០២១ ធ្លាប់ ត្រូវបាន ចាប់ខ្លួន ម្តង រួច មកហើយ តែ បន្ទាប់មក ស្រ្តី នេះ បាន បន្ត លួងលោម បោក បញ្ឆោត ជនរងគ្រោះ ដោយ ឲ្យ កូនស្រី ខ្លួន ឈ្មោះ លី ឈីវ ហ៊ុយ ចេញ សែក ជំនួស ដើម្បីឲ្យ ជនរងគ្រោះ ជឿជាក់ ម្តង ហើយ ម្តង ទៀត តែ ទីបំផុត ដល់ ថ្ងៃ បើក លុយ ក៏ នៅជា សែក ស្អុយ គ្មាន ទឹកប្រាក់ ដដែរ ។
ពេល នោះ ជនរងគ្រោះ ក៏ បាន ដាក់ ពាក្យ បណ្តឹង ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ម្តង ទៀត ដើម្បី រក យុត្តិធម៌ ។ ក្រោយមក សមត្ថកិច្ច ក៏ បាន ចាប់ខ្លួន ស្រ្តី ជា កូន ឈ្មោះ លី ឈីវ ហ៊ុយ នោះ បញ្ជូន ទៅ តុលាការ ដើម្បី ធ្វើ ការសាកសួរ រួច ក៏ ត្រូវបាន តុលាការ ដោះលែង វិញ កាលពី ថ្ងៃទី ១២ ខែធ្នូ ឆ្នាំ ២០២២ ។
ក្នុង ន័យ នេះ ជនរងគ្រោះ ស្នើសុំ មក ក្រសួង យុត្តិធម៌ មេត្តា ជួយ ពិនិត្យ និង តាមដាន ការជម្រះ ក្ដី របស់ សាលាដំបូង នេះ ផង ដើម្បី ធានា ថា ជនរងគ្រោះ ទទួលបាន នូវ ភាពយុត្តិធម៌ ពិតប្រាកដ ៕ លោក បណ្ឌិត សូ ណារ៉ូ៖ « ថ្ងៃ២៤ ខែមេសា ឆ្នាំ ២០២៣ ជា ថ្ងៃ កំណត់ វាសនា គ្រួសារ ខ្ញុំ »
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត សូ ណារ៉ូ រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី បាន បង្ហោះ សារ មួយ លើ ហ្វេសប៊ុក ដោយ រៀបរាប់ អំពី ការផ្លាស់ប្តូរ ជីវិត នយោបាយ របស់ លោក ដោយ ដាក់ ចំណងជើង ថា « ថ្ងៃ២៤ ខែមេសា ឆ្នាំ ២០២៣ ជា ថ្ងៃ កំណត់ វាសនា គ្រួសារ ខ្ញុំ » ដើម្បី បង្ហាញ ពី ការដឹង គុណ សម្តេច តេជោ ហ៊ុន សែន ។
តាមរយៈ ហ្វេសប៊ុក លោក បណ្ឌិត សូ ណារ៉ូ បាន ថ្លែង សារ ទាំងស្រុង ដូច ខាងក្រោម នេះ៖
២ខែ ក្រោយពី ចាប់ខ្លួន ទ្រង់ សិរី វុឌ្ឍន៍ មក គណបក្ស ប្រជាជន កម្ពុជា មាន ប្រៀប យ៉ាង ខ្លាំង ក៏ ស្នើ សម្តេច ក្រុម ព្រះចេញ អនុក្រឹត្យ ទទួលស្គាល់ ទិវា ៧មករា ជា ថ្ងៃ បុណ្យ ជ័យជម្នះ លើ របប ប្រល័យ ពូជសាសន៍ ដោយ អនុញាត ឲ្យ ឈប់ សម្រាក មួយ ថ្ងៃ ។
បន្ទាប់មក ខ្ញុំ ក៏ អស់ ការងារ ធ្វើជា អគ្គ លេខា នៅក្នុង សមាគមន៍ អ្នកសារព័ត៌មាន ខ្មែរ ជាង ១ឆ្នាំ ដើរ ទាត់ ខ្យល់ ។ ក្រោយមក ខ្ញុំ ក៏ ស្នើសុំ ការងារ ដោយ ផ្ទាល់ ជាមួយ សម្តេច ហ៊ុន សែន នៅក្នុង ពិធី ជប់លៀង មួយ ហើយ ត្រូវបាន តែងតាំង ជា សមាជិក ក្រុម លេខា ក្រោយមក ជា ជំនួយការ នាយក រដ្ឋមន្រ្តី ទី២ ។
ពេលវេលា បាន កន្លងផុត មួយ ឆ្នាំ គត់ តែ នៅ បន្សល់ទុក នៅក្នុង បេះដូង ពួកយើង នូវ ទឹកចិត្ត ព្រហ្មវិហា ធម៍ សេចក្តីស្រឡាញ់ ការយកចិត្តទុកដាក់ ចំពោះ ក្រុមគ្រួសារ ខ្ញុំ ក៏ ដូច ក្រុមគ្រួសារ ខ្មែរ រាប់ លាន នាក់ របស់ សម្តេច ទាំង ទ្វេ គឺ ធំ ធេង មហាសាគរ គ្មាន កោះ គ្មាន ត្រើយ ។
សូម គោរព អរគុណ ដោយ កត្ត ញូតាធម៌ អស់ ពី ដួងចិត្ត និង គោរព ជូនពរ សម្តេច ពុក សម្តេច ម៉ែ មាន សុខភាព ល្អ បរិបូណ៍ អាយុ យឿន យូរ រយ ព្រះវស្សា ដើម្បី បន្ត ជា ម្លប់ ដ៏ ត្រជាក់ ត្រជុំ ដល់ ប្រជានុរាស្រ្ត ខ្មែរ រាប់ លាន នាក់ ដែល គោរព ស្រឡាញ់ ដឹង គុណ លោក ទាំង ពីរ ក្នុង នោះ មាន ក្រុមគ្រួសារ ខ្ញុំបាទ ទាំងអស់ គ្នា ៕
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការរក ឃើញ អ្នក ឆ្លង កូវីដ១៩ ចំនួន ១នាក់ ខណៈ ជា អ្នក ជាសះស្បើយ គ្មាន ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ថា ក្រុមហ៊ុន មាន គោលបំណង បង្កើន វត្តមាន ហាង 7-Eleven ទូទាំង ពិភពលោក ចំនួន ១៨ ភាគរយ ដល់ ប្រហែល ១សែន ហាង នៅ ឆ្នាំ ២០៣០ នៅក្នុង ប្រទេស និង តំបន់ ចំនួន ៣០ ដែល កើនឡើង ពី ចំនួន ២០ ក្នុង ពេល បច្ចុប្បន្ន នេះ ។
ផែនការ នេះ គឺជា ផ្នែក មួយ នៃ ការរៀបចំ រចនាសម្ព័ន្ធ ឡើងវិញ ទ្រង់ទ្រាយ ធំ ដែល ពាក់ព័ន្ធ នឹង ការលក់ ទ្រព្យ សកម្ម ផ្សារ ទំនើប ដែល ដំណើរការ មិន ល្អ ពោលគឺ ជា យុទ្ធសាស្រ្ត មួយ ដែល បាន ធ្វើឡើង បន្ទាប់ពី មាន សម្ពាធ ពី វិនិយោគិន សកម្មជន ។
( កំពង់ស្ពឺ ) ៖ លោក ជួន គន្ធា ត្រូវបាន កម្លាំង នគរបាល នៅ ឃាត់ខ្លួន នៅ រសៀល ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ តាម ដីកា របស់ តំណាង អយ្យការ ខេត្ត កំពង់ស្ពឺ ពាក់ព័ន្ធ ប្រកាស យក ដី រដ្ឋ ទៅ ចែកជូន ប្រជាពលរដ្ឋ នៅ ឃុំ តាសាល ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ។
តាម ដីកា បញ្ជា ឲ្យ ចូល ខ្លួន របស់ លោក ទិន សុចិត្រា ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត កំពង់ស្ពឺ បាន ចោទប្រកាន់ លោក ជួន គន្ធា ពី បទ « ប៉ុនប៉ង ឆបោក និង ញុះញង់ ឲ្យ មាន ការប្រព្រឹត្ត បទឧក្រិដ្ឋ ជាអាទិ៍ » កើតឡើង កាលពី ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៤ នៅ ចំណុច ភូមិ រោង ម៉ាស៊ីន និង ភូមិ ធ្នៀរ ឃុំ តាសាល ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ។
លោក បាន សារភាព ទៀត ថា ចំពោះ លិខិត ទិញ - លក់ នោះ ធ្វើឡើង ការសម្របសម្រួល ពីសំណាក់ មេធាវី ឈ្មោះ អ៊ែល វណ្ណៈ ជា ក្រុម ខាង អ្នកលក់ ដី ( គំនិត មេធាវី បាន ប្រាប់ អ្នក ពាក់ព័ន្ធ ថា មិន បាច់ ធ្វើ កិច្ចសន្យា លក់ អី ទេ ធ្វើ កិច្ចសន្យា រួម តែ ម្តង ទៅ ក្នុង ការទូទាត់ ប្រាក់ និង ក្នុង ការបំពេញ លក្ខខណ្ឌ នានា ) ដោយ លោក ជួន គន្ធា មិន បាន សាកសួរ រក លិខិត លក់ ផ្តាច់ ពី អ្នកលក់ ឲ្យ ឡើយ ។
ករណី លោក ជួន គន្ធា ដែល ត្រូវបាន ចាប់ខ្លួន ពាក់ព័ន្ធ រឿង ចែក ដី រដ្ឋ ជូន ពលរដ្ឋ នៅ ស្រុក ឱរ៉ាល់ សារភាព ថា មាន ជាប់ពាក់ព័ន្ធ ជាមួយ បុគ្គល ច្រើន នាក់ ហើយ រៀប ជា ប្រព័ន្ធ
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រះសីហនុ នា រសៀល ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ បាន អញ្ជើញ ទទួល អំណោយ មនុស្សធម៌ ពី បងប្អូន សប្បុរសជន ក្នុង ទិវា ខួប លើក ទី ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤ ក្រោម ប្រធានបទ « រួមគ្នា ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដើម្បី សហគមន៍ មាន សុខភាព ល្អ និង មាន ភាពធន់ នឹង អាកាសធាតុ » នៅ ទីស្នាក់ការស្ថិត នៅ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ ។
ក្នុង ឱកាស នោះ លោក គួច ចំរើន សង្ឃឹម យ៉ាង មុតមាំ ថា អ្នក ឧកញ៉ា ឧកញ៉ា លោក លោកស្រី អ្នកនាង កញ្ញា និង សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន នឹង ចូលរួម បរិច្ចាគ ធនធាន ឧបត្ថម្ភ ជា ថវិកា សម្ភារៈ ដល់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រះសីហនុ ពុំ ខាន ឡើយ ។ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រះសីហនុ រង់ចាំ ទទួល អំណោយ ពី សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន រៀងរាល់ ម៉ោង ធ្វើការ ចាប់ពី ថ្ងៃ នេះ តទៅ នៅ ទីស្នាក់ការសាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រះសីហនុ គ្រប់ ពេលវេលា ។
សូម បញ្ជាក់ ថា ថវិកា ដែល ទទួលបាន ពី សប្បុរសជន លើក ទី១ នៃ ទិវា ខួប លើក ទី១៦១ នេះ បាន ចំនួន ៣៥ នាក់ សរុប ថវិកា ចំនួន ១៤៩ ៧៩០ ០០០ រៀល និង ប្រាក់ ដុល្លា ចំនួន ៨៣ ៩៥០ ដុល្លារ អាមេរិក ៕ ក្រសួង អភិវឌ្ឍន៍ ជនបទ រៀបចំ វគ្គ បណ្ដុះបណ្ដាល ពង្រឹង សមត្ថភាព មន្រ្ដី រាជការ ស្ដីពី ភាព ជា អ្នកដឹកនាំ លើ វិស័យ អភិវឌ្ឍន៍ ជនបទ ដល់ មន្ត្រី ជាង ៥០០ នាក់
( ភ្នំពេញ ) ៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្រ្ដី ក្រសួង អភិវឌ្ឍន៍ ជនបទ នា ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៤ បាន បើក វគ្គ បណ្ដុះបណ្ដាល ពង្រឹង សមត្ថភាព មន្រ្ដី រាជការ ស្ដីពី ភាព ជា អ្នកដឹកនាំ លើ វិស័យ អភិវឌ្ឍន៍ ជនបទ ដើម្បី ផ្ដល់ និង ពង្រឹង ពុទ្ធិ បន្ថែម ទៀត លើ ការប្រតិបត្តិការ ការងារ របស់ មន្ដ្រីរាជការ ដើម្បី បង្កើន ការទទួលខុសត្រូវ និង ប្រសិទ្ធភាព ការងារ តាមរយៈ ការផ្លាស់ប្ដូរ ឥរិយាបថ ក្នុង ការបំពេញ ការងារ នៅ តាម អង្គភាព របស់ ខ្លួន ។
ក្នុង ពិធី បើក វគ្គ បណ្ដុះបណ្ដាល នេះ មាន ការចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ និង សិក្ខាកាម ដែល ជា អនុប្រធាន នាយកដ្ឋាន អនុប្រធាន មន្ទីរ និង ប្រធាន ការិយាល័យ នៃ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ទាំង ២៥ រាជធានី - ខេត្ត និង អនុប្រធាន ការិយាល័យ នៅ ទីស្ដីការ ក្រសួង សរុប ចំនួន ៥៤២ នាក់ ស្រី ចំនួន ១៣៧ នាក់ ។
លោក រដ្ឋមន្ដ្រី បាន ផ្ដាំផ្ញើ ដល់ សិក្ខាកាម ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ត្រង់ ត្រាប់ ស្ដាប់ នូវ ការធ្វើ បទបង្ហាញ របស់ គ្រូ ឧទ្ទេស ចែករំលែក ចំណេះដឹង និង បទពិសោធន៍ ដើម្បី ទទួលបាន ជា ពុទ្ធិ ថ្មី ៗ បន្ថែម ទៀត យក ទៅ អនុវត្ត លើ ការងារ ក្នុង អង្គភាព របស់ ខ្លួន ប្រកបដោយ ប្រសិទ្ធភាព និង ការទទួលខុសត្រូវ ៕ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង ឧត្តមសេនីយ៍ ត្រី សោ សាវឿន ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត រតនគិរី
( រតនគិរី ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ប្រកាស ចូលកាន់ មុខតំណែង លោក ឧត្តមសេនីយ៍ ត្រី សោ សាវឿន ជា មេបញ្ជការ កងរាជអាវុធហត្ថ ខេត្ត រតនគិរី ជំនួស លោក ឧត្តមសេនីយ៍ ត្រី ថា វ យ៉េន ដែល ត្រូវ ផ្ទេរ ភារកិច្ច ទៅ កន្លែង ថ្មី ។
ពិធី នេះ ធ្វើឡើង នៅ ទីបញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត រតនគិរី ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក ណាប់ ប៊ុន ហេង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព ពាក់ព័ន្ធ ជាច្រើន ទៀត ។
ក្នុង ឱកាស នោះ លោក ញ៉ែ ម សំអឿន បាន សម្តែង ការកោតសរសើរ នាយ ទាហាន ពល ទាហាន រង និង ពល អាវុធហត្ថ ដែល បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ គោរព យ៉ាង ម៉ឺងម៉ាត់ នូវ គោលការណ៍ ដឹកនាំ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស គោរព តាម គោលការ ច្បាប់ បទបញ្ជា ក្រមសីល ធ៌ម វិជ្ជាជីវៈ ។
នាយ ទាហាន ពល ទាហាន រង និង ពល អាវុធហត្ថ នៃ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត បាន បំពេញ តួនាទី ភារកិច្ច ប្រកបដោយ ភាពស្មោះត្រង់ លះបង់ មាន ឆន្ទៈ ខ្ពស់ ក្នុង ការបំពេញ តួនាទី ភារកិច្ច ប្រកបដោយ មោទនភាព ។
លោក អភិបាល ខេត្ត បាន កោតសរសើរ លោក ឧត្តមសេនីយ៍ ត្រី ថា វ យ៉េន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ដែល ក្នុង ការបំពេញ តួនាទី ដឹកនាំ បញ្ជា គ្រប់គ្រង កងរាជអាវុធហត្ថ ខេត្ត សម្រេចបាន នូវ តួនាទី ភារកិច្ច របស់ ខ្លួន ក្នុង អាណត្តិ របស់ ខ្លួន កន្លងមក ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន ផ្តាំផ្ញើ ដល់ កម្លាំង អាវុធហត្ថ ទាំងអស់ សូម ឈរ នៅ ទី ខ្ពស់ សម្លឹង ឲ្យបាន ឆ្ងាយ និង ពិនិត្យមើល ឲ្យបាន ច្បាស់ នូវ ប្រភព នៃ បញ្ហា ដែល បាន កើតឡើង នៅលើ ពី ភពលោក ក៏ ដូចជា ក្នុង តំបន់ និងៈ ភ្ជាប់ មក ជាមួយ ប្រទេស កម្ពុជា របស់ យើង ដើម្បី ធ្វើ ការពិចារណា ឲ្យបាន ជ្រះថ្លា ដើម្បី កសាង នូវ កម្លាំង រួម មួយ ពោលគឺ មហាសាមគ្គី ប្រជាជាតិ ទាំងមូល ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី ។
នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន សង្កត់ធ្ងន់ ឲ្យ ចូលរួម បន្ត ថែរក្សា សុខ សន្តិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ ជំរុញ ការអភិវឌ្ឍ ប្រទេស ឆ្ពោះ ទៅ កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាជន និង កសាង ប្រទេស កម្ពុជា ឲ្យបាន ជឿនលឿន បន្ថែម ទៀត សម្រាប់ ថ្ងៃ អនាគត ៕
អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម មកពី ឃុំ ព្រះរំកិល ស្រុក បុរី អូរ ស្វាយ សែន ជ័យ ទទួលបាន ការពិនិត្យ សុខភាព បឋម
( ស្ទឹងត្រែង ) ៖ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា សហការ ជាមួយ រដ្ឋបាល ស្រុក បុរី អូរ ស្វាយ សែន ជ័យ ខេត្ត ស្ទឹងត្រែង និង មន្ទីរពេទ្យ ខេវី ត្បូងឃ្មុំ រៀបចំ វេទិកា ពិនិត្យ សុខភាព បឋម ជូន ដល់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម សរុប ចំនួន ២០០ នាក់ នៅ មណ្ឌល សុខភាព ព្រះរំកិល នៅ ឃុំ ព្រះរំកិល ស្រុក បុរី អូរ សា្វយសែន ជ័យ ដែល ប្រព្រឹត្តទៅ អស់ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៣ ដល់ ថ្ងៃទី ២៥ ខែមេសា ។
វេទិកា ពិនិត្យ សុខភាព បឋម នេះ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី ផ្ដល់ ការពិនិត្យ សុខភាព បឋម ជូន ដល់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ដែល រស់ នៅ ទី ដាច់ស្រយាល និង កំពុង ប្រឈម បញ្ហា សុខភាព និង ផ្ដល់ ការណែនាំ អំពី ការថែទាំ សុខភាព ។
លោកស្រី សម្បត្តិ រចនា អភិបាល រង ស្រុក បុរី អូរ ស្វាយ សែន ជ័យ បញ្ជាក់ អំពី សារសំខាន់ នៃ ការដឹង អំពី ស្ថានភាព សុខភាព និង របៀប ថែទាំ សុខភាព របស់ ពលរដ្ឋ ដែល សុទ្ធតែ ជា អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ដែល រស់ នៅ ឆ្លងកាត់ ទុក្ខលំបាក នៃ សង្រ្គាម និង របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ។ លោកស្រី អភិបាល រង ស្រុក បាន បន្ត ថា ការមក ពិនិត្យ សុខភាព នា ពេលនេះ គឺ ពិតជា មាន សារសំខាន់ សម្រាប់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ដែល កំពុងតែ ឈានចូល វ័យ ចាស់ជរា ។
លោក អ៊ំ ទាំង២ និង ប្រជាពលរដ្ឋ ផ្សេង ទៀត សុទ្ធតែ មិន ចង់ឲ្យ របប ខ្មែរ ក្រហម កើតឡើង ជាថ្មី ម្តង ទៀត នោះ ទេ ដោយសារតែ របប នេះ ធ្វើបាប ប្រជាជន យ៉ាង ខ្លាំង ៕
នាយក រដ្ឋមន្រ្តី អង់គ្លេស រំពឹង ថា នឹង ធ្វើឱ្យ ទំនាក់ទំនង ការពារ ជាតិ កាន់តែ ស៉ី ជម្រៅ ក្នុង ដំណើរទស្សនកិច្ច នៅ អាល្លឺម៉ង់
គួរ បញ្ជាក់ ថា លោក Sunak មិន បាន បំពេញ ទស្សនកិច្ច នៅ អាល្លឺម៉ង់ ឡើយ ចាប់តាំងពី លោក ឡើង កាន់ តំណែង ជា នាយក រដ្ឋមន្រ្តី អង់គ្លេស កាលពី ខែតុលា ឆ្នាំ ២០២២មក ។ ដំណើរទស្សនកិច្ច នៅ ពេល នេះ ធ្វើឡើង មួយ ថ្ងៃ បន្ទាប់ពី លោក បាន ប្រកាស បង្កើន ការចំណាយ លើ វិស័យ ការពារ ជាតិ ឱ្យ ដល់ ២.៥ភាគរយ នៃ ផលិតផល ក្នុង ស្រុក សរុប (GDP) នៅ ឆ្នាំ ២០៣០ ដោយ លើកឡើង ពី បញ្ហា ប្រឈម ចំពោះ បណ្តា ប្រទេស អឺរ៉ុប និង ការព្យាយាម ពង្រឹង ទំនាក់ទំនង សន្តិសុខ កាន់តែ ជិតស្និទ្ធ ជាមួយ អាល្លឺម៉ង់ ៕
អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា បញ្ជាក់ ពី ការដោះដូរ ផ្ទះ យក ដី គឺ សម្រាប់ តែ អតិថិជន ស្ម័គ្រចិត្ត ដែល មាន តម្រូវ ការចាំបាច់ . ចំណែក គម្រោង បុរី នៅតែ ប្រកាន់ គោលជំហរ បញ្ចប់ ការដោះស្រាយ ជូន អតិថិជន ទាំងស្រុង
( ភ្នំពេញ ) ៖ ដោយ មាន ការសំណូមពរ ពី អតិថិជន មួយចំនួន ជុំវិញ ការសាងសង់ ផ្ទះ យឺតយ៉ាវ ឲ្យ មាន ការដោះដូរ ផ្ទះ យក ដី នៅ តម្លៃ ស្មើរ បុរី ឡេង ណា វ៉ា ត្រា បាន ធ្វើ តាម សំណើរ ទាំងនោះ ហើយ អតិថិជន មួយចំនួន ធំ កំពុងតែ ទទួលយក ការដោះដូរ ដី នោះ នៅ តម្លៃ ទីផ្សារ ស្មើ ដោយ សប្បាយ ចិត្ត មិន មាន ការបង្ខិតបង្ខំ ឡើយ ។ នេះ បើ ផ្អែក លើ សារ សំឡេង អម ដោយ វីដេអូ ផ្ទះ ដែល ផេក ផ្លូវការ របស់ អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា ។
អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា បាន បន្ត ទៀត ថា នេះ គ្រាន់តែ ជា ដំណោះស្រាយ មួយ សម្រាប់ ពុក ម៉ែ បងប្អូន តម្រូវការ ចំពោះ គម្រោង ការសាងសង់ គឺ យើង ដំណើរការ ធម្មតា ធ្វើ ម៉េច ស្ថានភាព បែប ហ្នឹង អ្នក ឧកញ៉ា ក៏ មិន ចង់ ជួប ក្រុមហ៊ុន ផ្សេង ក៏ មិន ចង់ ជួប ។ បច្ចុប្បន្ន មាន ក្រុមហ៊ុន ជាង ២០០ ក្រុមហ៊ុន ដែល មាន ការយឺតយ៉ាវ មិន មែន តែ បុរី និង ក្រុមហ៊ុន អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា នោះ ទេ ។
ក្រុមហ៊ុន នឹង ខិតខំ បញ្ចាប់ គម្រោង ខណៈ នេះ អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា បាន លក់ ដី ច្រើន កន្លែង លក់ បាន ខ្លះ ដើម្បី ប្រមែប្រមូល យក និង កំពុងតែ ធ្វើការ ជាមួយ ក្រសួង ដើម្បី ដោះស្រាយ បំបែក ប័ណ្ណ រឹង ឲ្យបាន លឿន និង ឲ្យបាន គ្រប់ គ្នា ។ ហើយក៏ ចង់ គោរព ពុក ម៉ែ បងប្អូន ពី ជំហាន នៃ កា ដោះស្រាយ ជា ផ្នែក ទើប គ្រប់ យ៉ាង យើង បាន លទ្ធផល ល្អ ប្រសើរ ទាំងអស់ គ្នា ទាំងស្រុង ។
ឥឡូវនេះ អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា លក់ បាន ខ្លះ ហើយ កំពុង ខិតខំ ធ្វើ យ៉ាងណា ដើម្បី អភិវឌ្ឍន៍ ដើម្បី ជា ប្រយោជន៍ រួម របស់ ពុក ម៉ែ បងប្អូន ទាំងអស់ គ្នា ដែល អ្នក ឧកញ៉ា ប្រមែប្រមូល លក់ បាន លឿន ទីតាំង ផ្សេង ការដោះស្រាយ ក៏ បាន លឿន ការបញ្ចប់ គម្រោង អាចនឹង លឿន ជាង ការគ្រោងទុក ៕ កម្ពុជា - ចិន រៀបចំ ព្រឹត្តិការណ៍ ពិព័រណ៍ វប្បធម៌ ទេសចរណ៍ និង ការសម្ដែង ក្បាច់គុន ល្បុក្កតោ និង ក្បាច់គុន សៅ លីង នៅ បរិវេណ ប្រាសាទ បាយ័ន
( សៀមរាប ) ៖ ក្រសួង ទេសចរណ៍ សហការ ជាមួយ រដ្ឋបាល ប្រជាជន ខេត្ត ហឺណាន និង រដ្ឋបាល ខេត្ត សៀមរាប រៀបចំ ព្រឹត្តិការណ៍ ពិព័រណ៍ វប្បធម៌ ទេសចរណ៍ និង ព្រឹត្តិការណ៍ សម្ដែង ក្បាច់គុន ល្បុក្កតោ និង ក្បាច់គុន សៅ លីង នៅលើ ដែនដី អតីត ក្រុង អង្គរ ធំ នា ព្រឹក ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៤ នេះ ។
ការរៀបចំ ព្រឹត្តិការណ៍ នេះ ឡើង ក្នុង គោលបំណង ផ្សព្វផ្សាយ គោលដៅ ទេសចរណ៍ រួមគ្នា រវាង ខេត្ត ហឺណាន និង ខេត្ត សៀមរាប រួម ជាមួយ ការសម្តែង រួមគ្នា រវាង ក្បាច់គុន សៅ លីញ និង ក្បាច់គុន ល្បុក ត្តោ ។ ព្រឹត្តិការណ៍ នេះ មាន ការចូលរួម ពី លោក សុខ សូកេន រដ្ឋមន្ដ្រី ក្រសួង ទេសចរណ៍ និង ភាគី ចិន មន្ត្រី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ព្រមទាំង អ្នកចូលរួម ទស្សនា ជាច្រើន រយ នាក់ ។
ព្រឹត្តិការណ៍ នេះ សំដៅ ទាក់ទាញ ចំណាប់អារម្មណ៍ ភ្ញៀវ ទេសចរ និង វិនិយោគិន ចិន ឱ្យ មក ទស្សនា និង វិនិយោគ នៅ កម្ពុជា កាន់តែ ច្រើន ថែម ទៀត ក៏ ដូចជា ចូលរួម អបអរសាទរ ដល់ ការអនុវត្ត យុទ្ធនាការ « ទស្សនា សៀមរាប ឆ្នាំ ២០២៤ » និង « ឆ្នាំ នៃ ការផ្លាស់ប្តូរ ប្រជាជន និង ប្រជាជន កម្ពុជា - ចិន ២០២៤ » ផងដែរ ៕ ក្រសួង ការងារ និង KOSHA ជួបគ្នា ពិនិត្យមើល វឌ្ឍនភាព នៃ ដំណើរការ សាងសង់ មជ្ឈមណ្ឌល បណ្ដុះបណ្ដាល សុវត្ថិភាព និង សុខភាព ការងារ
កិច្ចប្រជុំ នេះ ធ្វើឡើង នា រសៀល ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ មាន គោលបំណង ពិនិត្យ អំពី វឌ្ឍនភាព នៃ ដំណើរការ សាងសង់ មជ្ឈមណ្ឌល បណ្ដុះបណ្ដាល សុវត្ថិភាព និង សុខភាព ការងារ (OSHTC) និង ការពិនិត្យ អំពី គម្រោង នៃ ការរៀបចំ ដំឡើង និង បំពាក់ សម្ភារ បរិក្ខា និង ឧបករណ៍ នៅក្នុង អគារ មជ្ឈមណ្ឌល នេះ ។
នា ឱកាស នោះ ភាគី ទាំង ពីរ បាន ធ្វើ បទបង្ហាញ អំពី វឌ្ឍនភាព នៃ ដំណើរការ សាងសង់ មជ្ឈមណ្ឌល បណ្ដុះបណ្ដាល សុវត្ថិភាព និង សុខភាព ការងារ (OSHTC) ដែល សម្រេចបាន ៦០% និង សកម្មភាព គាំទ្រ គម្រោង រួមទាំង ការរៀបចំ ក្របខណ្ឌ ច្បាប់ ក្នុង ការគាំទ្រ ការអនុវត្ត គម្រោង អភិវឌ្ឍ ផ្លូវការ (ODA) ឱ្យ បាន ប្រសិទ្ធភាព ខ្ពស់ ។
ទន្ទឹម នឹង នោះ ភាគី កម្ពុជា ក៏ បាន លើកឡើង អំពី វឌ្ឍនភាព នៃ ការរៀបចំ ច្បាប់ OSH និង ប្រកាស ដែល គាំទ្រ ដល់ ការអនុវត្ត ច្បាប់ នេះ ។
ភាគី កម្ពុជា បាន ថ្លែងអំណរគុណភាគី កូរ៉េ ដែល តែងតែ ជួយ គាំទ្រ ដល់ ការអនុវត្ត វិស័យ សុវត្ថិភាព និង សុខភាព ការងារ នៅក្នុង ប្រទេស កម្ពុជា កន្លងមក ដែល បាន ចូលរួមចំណែក ក្នុង ការបង្ការ និង កាត់បន្ថយ គ្រោះថ្នាក់ ការងារ នៅ កន្លែង ធ្វើការ ។
