( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៤ករណី ឃាត់ខ្លួន ជនសង្ស័យ ២៩ នាក់ ។
បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត បាត់ដំបង រៀបចំ ពិធី សូត្រ មន្ត លើក រាសី នា ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ
( បាត់ដំបង ) ៖ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត បាត់ដំបង បាន រៀបចំ សូត្រ មន្ត ចម្រើន ព្រះបរិត្ត ប្រោះ ព្រំ លើក រាសី សុំ សិរី សួស្តី ជូន ដល់ នាយ ទាហាន នាយ ទាហាន រង នៃ កងរាជអាវុធហត្ថ នា ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ នា ព្រឹក ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២៤ តាម គន្លង ប្រពៃណី ព្រះពុទ្ធ សាសនា ។
ពិធី នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក ឧត្តមសេនីយ៍ ត្រី ហែម វុទ្ធី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត បាត់ដំបង និង ភរិយា ព្រមទាំង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ មេបញ្ជាការ រង ប្រធាន អនុប្រធាន មន្ទីរ ប្រធាន អនុប្រធាន ការិយាល័យ និង មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ស្រុក ចំនួន ២១៦ រូប ចូលរួម ផងដែរ ។
ពិធីសាសនា នេះ ដែរ ជា ការគោរព ប្រតិបត្តិ ប្រពៃណី ទំនៀមទម្លាប់ ជាតិ និង បង្ហាញ ពី ភាពសុខសាន្ដ របស់ ប្រជាពលរដ្ឋ ស្រប ពេល ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញលេញ ក្រោម ម្លប់ នៃ សន្ដិភាព ដែល រក្សា បាន នូវ ខឿន សេដ្ឋកិច្ច វឌ្ឍនភាពសង្គម ដ៏ ល្អ ប្រសើរ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ នៃ ប្រជាជាតិ កម្ពុជា ទាំងមូល ៕ គ្មាន ការបាញ់ ទឹក ដោយ កាំភ្លើង ប៉ាត ម្សៅ និង បង្ក ភាព គ្មាន សណ្តាប់ធ្នាប់ ឡើយ ក្នុង ការអបអរសាទរ ពិធី ចូល ឆ្នាំ ថ្មី នៅ សាកលវិទ្យាល័យ ភូមិន្ទ វិចិត្រ សិល្បៈ
( ភ្នំពេញ ) ៖ ពិតជា គួរឱ្យ កោតសរសើរ ! ក្នុង ការអបអរសាទរ ពិធី ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ចំនួន ៣ ថ្ងៃ នៅ សាកលវិទ្យាល័យ ភូមិន្ទ វិចិត្រ សិល្បៈ គ្មាន ទេការបាញ់ ទឹក ដោយ កាំភ្លើង ប៉ាត ម្សៅ និង បង្ក ភាព គ្មាន សណ្តាប់ធ្នាប់ ឡើយ ផ្ទុយទៅវិញ មាន តែ ការសម្តែង សិល្បៈ ទស្សនីយភាពចម្រុះ និង ការលេង ល្បែង ប្រជាប្រិយ តែ ប៉ុណ្ណោះ ។
សកម្មភាព នេះ ត្រូវបាន អ្នកតាមដាន ព្រឹត្តិការណ៍ សង្គម កោតសរសើរ យ៉ាង ក្រៃលែង ដែល មិន ត្រឹមតែ បាន អនុវត្ត ត្រឹមត្រូវ តាម សេចក្តីណែនាំ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ នោះ ទេ តែ ក៏ បាន លើក តម្លៃ វប្បធម៌ ខ្មែរ ផងដែរ ។
នេះ ជា ការលើកទឹកចិត្ត ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង ទាំង ថ្ងៃ ទាំង យប់ របស់ គណៈ គ្រប់គ្រង លោកគ្រូ អ្នកគ្រូ និង និស្សិត ទាំងអស់ ដែល បាន រួម កម្លាំង សាមគ្គី គ្នា ក្នុង ការរួម ថែរក្សា អភិរក្ស អភិវឌ្ឍន៍ និង លើកស្ទួយ ប្រពៃណី ទំនៀមទម្លាប់ ដូនតា ខ្មែរ ក្នុង បុព្វហេតុ ប្រតិបត្តិ ខ្លួន ជា កូន ល្អ និស្សិត គំរូ និង ជា យុវជន ល្អ ក្នុង សង្គម ចៀស ឱ្យ ផុត ពី គ្រឿងញៀន និង អំពើ អបាយ មុខ ផ្សេង ៗ ។
ក្នុង កម្មវិធី នោះ ដែរ ក្រៅពី ការតាំងពិព័រណ៍ ស្នាដៃ សិល្បៈ និស្សិត ក៏ មាន ការតាំង នូវ ផលិតផល សិប្បកម្ម វត្ថុ សិល្បៈ ផលិតផល ពី ត្នោត ស្ដង់ អាហារ និង វត្ថុអនុស្សាវរីយ៍ ដែល បង្ហាញ ពី សិល្បៈ ខ្មែរ ផងដែរ ។ នា ឱកាស ដ៏ មាន សារៈសំខាន់ នៃ កម្មវិធី ខាងលើ ថ្នាក់ដឹកនាំ និង និស្សិត ក៏ បាន រៀបចំ ហិប រៃ អង្គាស ថវិកា សម្រាប់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដើម្បី ចូលរួម បន្ត និរន្តរភាព នៃ កិច្ច ដំំណើរការ របស់ មន្ទីរពេទ្យ ក៏ ដូចជា ការចូលរួម ផ្តល់ ស្នាមញញឹម ដល់ កុមារ កម្ពុជា ។
លោក បណ្ឌិត ហេង សុផាឌី បាន បញ្ជាក់ យ៉ាង ដូច្នេះ « យើង ដឹង ហើយ ថា សាកលវិទ្យាល័យ ភូមិន្ទ វិចិត្រ សិល្បៈ ជា សាកលវិទ្យាល័យ ផ្តោត លើ ការសិក្សា លើ សិល្បៈ វប្បធម៌ ដែល ជា អត្តសញ្ញាណ ជាតិ គឺ យើង ធ្វើ អ្វី ៗ ដោយ រក្សា ភ្ជាប់ ទៅ តាម ទំនៀមទម្លាប់ ប្រពៃណី មិន ឱ្យ ប្រាសចាក ទេ » ។
បើ តាម លោក បណ្ឌិត សាកលវិទ្យាធិការ ព្រឹត្តិការណ៍ នេះ មិន មែន ដើម្បី តែ ភាពសប្បាយរីករាយ ប៉ុណ្ណោះ ទេ តែ បាន ឱ្យ និស្សិត បង្ហាញ ស្នាដៃ និង ទេពកោសល្យ ដែល ពួកគាត់ បាន សិក្សា នៅ ទីនេះ ។ លោក បន្ត ថា ម្យ៉ាងទៀត នេះ ក៏ ជា ផ្សព្វផ្សាយ សិល្បៈ វប្បធម៌ ជាតិ ឱ្យ មហាជន បាន ដឹង ។
ជាមួយគ្នា នេះ លោក បណ្ឌិត គិន ភា អ្នកតាមដាន ព្រឹត្តិការណ៍ សង្គម បាន លើកឡើង ថា សម្រាប់ លោក ផ្ទាល់ ការរៀបចំ ពិធី ចូល ឆ្នាំ ថ្មី ក្នុង ទម្រង់ បែប នេះ លោក គាំទ្រ មែនទែន ។ លោក បណ្ឌិត បាន កោតសរសើរ និង វា តម្លៃ ខ្ពស់ បំផុត ចំពោះ សាកលវិទ្យាល័យ ភូមិន្ទ វិចិត្រ សិល្បៈ ជាពិសេស លោកស្រី បណ្ឌិត សភាចារ្យ រដ្ឋមន្ត្រី ដែល ផ្តួចផ្តើម រៀបចំ ពិធី មួយ ដែល ប្រកបដោយ អត្ថន័យ ខ្លឹមសារ បែប នេះ ។
ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ កម្ពុជា នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន ចាត់ទុក ថា ព្រឹត្តិការណ៍ នេះ ពិតជា បាន រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការថែរក្សា អភិរក្ស អភិវឌ្ឍ និង លើកស្ទួយ ប្រពៃណី ទំនៀមទម្លាប់ ខ្មែរ យើង ពី ដូន តា ពិសេស ជា គំរូ មួយ សម្រាប់ យុវជន ខ្មែរ យើង ។
លោក បណ្ឌិត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ « ដូច យើង ដឹង ហើយ ថា និន្នាការ បច្ចុប្បន្ន នេះ ការប្រារព្ធ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ របស់ យើង ហាក់ដូចជា មាន ការប្រាសចាក ឆ្ងាយ បន្តិច អំពី ទម្រង់ ដើម ដែល ជា ប្រពៃណី ទំនៀមទម្លាប់ ដ៏ ល្អ ផូរផង់ របស់ ដូនតា ខ្មែរ យើង ដែល បន្សល់ទុក មក ឱ្យ កូន ចៅ ជំនាន់ នេះ និង ជំនាន់ ក្រោយ ៗ ទៀត ។ យើង ឃើញ ថា និន្នាការ ប្រារព្ធ ពិធី មាន ការច្រៀង រាំ ផឹក ស៊ី ជះ ទឹក ប៉ាត ម្សៅ ជាដើម ទាំងនោះ មិន មែន ជា ទម្រង់ ប្រពៃណី ទំនៀមទម្លាប់ ខ្មែរ យើង ទេ » ។
សូម ជម្រាប ថា ក្នុង ឱកាស រៀបចំ អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ជាពិសេស ក្មួយ ៗ ជា យុវជន យុវនារី សិស្ស និស្សិត និង កម្មករ កម្ម ការិនី ទាំងអស់ ដូច ជា៖
ឆ្លងកាត់ នូវ ព្យុះភ្លៀង ប្រជាជន ហុងកុង កាន់តែ ឱ្យ តម្លៃ និង ថែរក្សា សុខ សន្តិភាព ដែល បាន មក ដោយ មិន ងាយស្រួល ជាង ពេល ណា ៗ ទាំងអស់ ។ បច្ចុប្បន្ន នេះ ហុងកុង បាន និង កំពុង ស្ថិត ក្នុង ដំណាក់កាល ដ៏ គន្លឹះ ដែល ឆ្ពោះ ទៅកាន់ “ ពី អធិការកិច្ច ដល់ មាន វិបុលភាព ” រួម ដំណើរ ស្រប ជាមួយ ការអភិវឌ្ឍ ដោយ ល្បឿន លឿន របស់ តំបន់ ចិន ដី គោក ខិតខំ ប្រឹងប្រែង ទៅ មុខ មិន ឈប់ឈរ និង មាន ការរំពឹងទុក នៅ ថ្ងៃស្អែក ហុងកុង ពិតជា នឹង មាន អនាគត កាន់តែ ល្អ បវរ ជា មិន ខាន !
អត្ថបទ និង រូបភាព ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន
មន្ទីរព័ត៌មាន ខេត្ត កណ្តាល ធ្វើតេស្ត រក សារធាតុ ញៀន ដល់ មន្ត្រីរាជការ ក្នុង អង្គភាព ចំនួន ៦១ រូប . លទ្ធផល អវិជ្ជមាន ទាំងអស់ គ្នា
( កណ្តាល ) ៖ នា រសៀល ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២៤ លោក ចាប វន្នី ប្រធាន មន្ទីរព័ត៌មាន ខេត្ត កណ្តាល បាន បើក យុទ្ធនា ការធ្វើតេស្ត រក សារធាតុ ញៀន ចំពោះ មន្ត្រីរាជការ និង មន្ត្រី ជាប់ កិច្ចសន្យា ចំនួន ៦១ នាក់ ស្រី ២៥ នាក់ នៅ មន្ទីរព័ត៌មាន ខេត្ត កណ្តាល ។
ការធ្វើតេស្ត រក សារធាតុ ញៀន នេះ ដោយ អនុវត្ត តាម បទបញ្ជា លេខ ០១ប ប ចុះ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៤ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ស្តីពី ការដាក់ចេញ វិធានការ ម៉ឺងម៉ាត់ ក្នុង ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ នៅ តាម ក្រសួង ស្ថាប័ន និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ។
លោក ចាប វន្នី បាន ឱ្យដឹង ថា ការធ្វើតេស្ត រក សាធាតុ ញៀន លើ មន្ត្រីរាជការ និង មន្ត្រី ជាប់ កិច្ចសន្យា នា ពេលនេះ ដើម្បី ចូលរួមចំណែក ធានា ប្រសិទ្ធភាព នៃ ការអនុវត្ត យុទ្ធនាការ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ក៏ ដូចជា ការលើកកម្ពស់ ជំនឿ ទុកចិត្ត ប្រសិទ្ធភាព ការងារ និង អភិបាលកិច្ច ល្អ នៅក្នុង ស្ថាប័ន ។
( កំពង់ចាម ) ៖ នៅ រសៀល ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២៤ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា និង ថ្នាក់ដឹកនាំ ជាច្រើន ទៀត បាន អញ្ជើញ សំណេះសំណាល និង ផ្តល់ ជូន កញ្ចប់ អាហារ ស្រាយ បួស ខែរ៉ាម៉ាឌន ដល់ សាសនិក ឥស្លាម ៣០០ គ្រួសារ ក្នុង វិហារ ឥស្លាម នៅ ភូមិ រកា សង្កាត់ សំបួរ មាស ក្រុង កំពង់ចាម ។
លោក អ៊ុន ចាន់ ដា បាន លើកឡើង ថា « ដោយសារ ប្រទេស យើង មាន សុខ សន្តិភាព មាន ការរីកចម្រើន គ្រប់ វិស័យ ទើប យើង អាច មាន ឱកាស មក ជួបជុំ ប្រារព្ធ ពិធីសាសនា ទៅ តាម ជំនឿ រៀង ៗ ខ្លួន ក៏ ដូចជា ការជួបជុំ សំណេះសំណាល និង ផ្តល់ ជូន កញ្ចប់ អាហារ ស្រាយ បួស ខែរ៉ាម៉ាឌន ក្នុង ឱកាស នេះ » ។
លោក ថា « កត្តា សុខ សន្តិភាព ធ្វើឲ្យ យើង មាន លទ្ធភាព ក្នុង ការធ្វើដំណើរ ទៅ ខាងក្រៅ ប្រទេស ដើម្បី រក ជំនួយ ពី សប្បុរសជន ផ្ដល់ មក តាមរយៈ ថ្នាក់ដឹកនាំ សហគមន៍ ដើម្បី យកមក ជួយ ផ្ដល់ជូន បងប្អូន ប្រជាពលរដ្ឋ យើង តាម បណ្ដា ខេត្ត ឬ តាម បណ្ដា វិហារ នីមួយ ៗ » ។
គួរ បញ្ជាក់ ថា ហ្វាំងឡង់ បាន បិទ ព្រំដែន គោក របស់ ខ្លួន ជាមួយ រុស្ស៉ី កាលពី ឆ្នាំ មុន ចំពោះមុខ ការកើនឡើង នូវ អ្នកដំណើរ មកពី ប្រទេស ផ្សេង ៗ រួមទាំង ស៉ីរី និង សូម៉ាលី ។ ហ្វាំងឡង់ ចោទប្រកាន់ រុស្ស៉ី ថា ប្រើប្រាស់ ការធ្វើ ចំណាកស្រុក ជា អាវុធ ប្រឆាំង នឹង ប្រទេស របស់ ខ្លូន ប៉ុន្តែ វិមាន ក្រឹមឡាំង បាន បដិសេធ ៕
លោក បណ្ឌិត តូច ប៉ូលីវ៉ា ស្នើ មន្ទីរ សុខាភិបាល ខេត្ត ត្រូវ ខិតខំ សហការ គ្នា ជំរុញ ការងារ ការថែទាំ សុខភាព បឋម ឲ្យ កាន់តែ ប្រសើរឡើង
( ស្វាយរៀង ) ៖ លោក បណ្ឌិត តូច ប៉ូលីវ៉ា អភិបាល រង ខេត្ត ស្វាយរៀង បាន ស្នើ មន្ទីរ សុខាភិបាល ខេត្ត និង មន្ត្រី សុខាភិបាល ទាំងអស់ ត្រូវ ខិតខំ ប្រឹងប្រែង សហការ គ្នា ជំរុញ ការងារ ការថែទាំ សុខភាព បឋម ដើម្បី លើកកម្ពស់ ប្រសិទ្ធភាព វិស័យ សុខាភិបាល ឲ្យ កាន់តែ ល្អ ប្រសើរឡើង ។
ការថ្លែង បែប នេះ របស់ លោក តូច ប៉ូលីវ៉ា ខណៈ ដែល លោក តំណាង លោក អភិបាល ខេត្ត អញ្ជើញ ចូលរួម ក្នុង កម្មវិធី សិក្ខាសាលា តម្រង់ ទិស ស្តីពី ការអនុវត្ត ការជំរុញ បង្កើន ការថែទាំ សុខភាព បឋម នៅ សាល ប្រជុំ សាលា ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២៤ ។
សិក្ខាសាលា នេះ មាន ការចូលរួម ពី លោក នាយក រដ្ឋបាល សាលា ខេត្ត លោក វេជ្ជបណ្ឌិត គុជ ស៊ី ថា ប្រធាន មន្ទីរ សុខាភិបាល នៃ រដ្ឋបាល ខេត្ត លោក លោកស្រី អភិបាល រង ក្រុង ស្រុក សមាជិក ក្រុមការងារ គ្រប់គ្រង ក្របខ័ណ្ឌ អនុវត្ត ប្រធាន - អនុប្រធាន មន្ទីរ - អង្គភាព ជា សមាជិក ជំរុញ បង្កើន ការថែទាំ សុខភាព លោក លោកស្រី ប្រធាន - អនុប្រធាន សមាជិក លេខាធិការដ្ឋាន ក្រុមការងារ គ្រប់គ្រង ក្របខ័ណ្ឌ អនុវត្ត ជា ច្រល ននាក់ ផងដែរ ។
លោក បន្ត ថា « សិក្ខាសាលា តម្រង់ ទិស នេះ ពិតជា មាន សារៈសំខាន់ ណាស់ សម្រាប់ ជា ធាតុ ចូល មួយ ក្នុង ការបញ្ជ្រាប សកម្មភាព ការផ្តល់ សេវា ថែទាំ សុខភាព បឋម ចូលក្នុង ផែនការវិនិយោគ ៣ឆ្នាំ រំកិល របស់ ឃុំ សង្កាត់ ដោយ ផ្អែក លើ ផែនការ យុទ្ធសាស្ត្រ សុខាភិបាល ដើម្បី សម្រេច គោលដៅ អភិវឌ្ឍ ប្រកបដោយ ចេរភាព និង ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧» ។
លោក បណ្ឌិត បន្ថែម ថា ដើម្បី អនុវត្ត ការងារ នេះ មាន ប្រសិទ្ធភាព សូម ស្នើ ដល់ មន្ត្រី សុខាភិបាល គ្រប់ លំដាប់ថ្នាក់ ត្រូវ អនុវត្ត យុទ្ធសាស្រ្ត គន្លឹះ របស់ រាជ រដ្ឋាភិបាល និង ក្រសួង សុខាភិបាល ដែល បាន ដាក់ចេញ ក្នុង ការពង្រឹង មណ្ឌល សុខភាព ពង្រឹង គុណភាព ប្រសិទ្ធភាព សុវត្ថិភាព និង សមធម៌ តាម មន្ទីរពេទ្យ ស្រុក ខេត្ត និង ពង្រឹង ស្ថាប័ន តាមរយៈ បន្ត ខិតខំ ចូលរួម រៀនសូត្រ បង្កើន សមត្ថភាព ផងដែរ ។
ជាមួយគ្នា នេះ លោក បណ្ឌិត បាន មាន មតិ ផ្តាំ ផ្ងើរ ដល់ មន្រ្តី ពាក់ព័ន្ធ គ្រប់ រូប៖
នាវា ចម្បាំង កងទ័ព ជើងទឹក ភូមិន្ទ ថៃ១ គ្រឿង ចូល សុំ ចត ដល់ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ រយៈពេល ៣ ថ្ងៃ
( ព្រះសីហនុ) ៖ នាវា ចម្បាំង កងទ័ព ជើងទឹក ភូមិន្ទ ថៃ១ គ្រឿង បាន ចូល សុំ ចត ដល់ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ ប្រកបដោយ សុវត្ថិភាព នៅ វេលា ម៉ោង ៨៖០០ នាទី ព្រឹក ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២៤ នេះ ។
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ជេត ជាលី សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ បាន លើកឡើង ថា ជន បរទេស នៅ បណ្តា ប្រទេស ជាច្រើន បាន បង្ហាញ ថា ពួកគេ ចូលចិត្ត ពលរដ្ឋ និង កម្លាំង ពលកម្ម របស់ កម្ពុជា ដោយសារ ពួកគេ មាន ភាពឧស្សាហ៍ ព្យាយាម ស្មោះត្រង់ ចេះ គោរព ចំពោះ មេ កើយ និង មិន ខិលខូច ជាដើម ដែល លោក លើកឡើង ថា នេះ គឺជា ភាព ខ្លាំង មួយ របស់ ពលរដ្ឋ កម្ពុជា ។
លោក បាន មានប្រសាសន៍ ថា ស្រប ពេល ជន បរទេស បង្ហាញ ការពេញចិត្ត ចំពោះ កម្លាំង ពលកម្មកម្ព ជា អ្នករៀបចំ គោល នយោបាយ គួរ បង្កើន ជំនាញ ដល់ កម្លាំង ពលកម្ម កម្ពុជា ឱ្យ កាន់តែ ច្បាស់លាស់ ឱ្យ ចំ ជំនាញ នីមួយ ៗ ជាពិសេស ក្នុង ផ្នែក អប់រំ គួរតែ ផ្តល់ ការបណ្តុះបណ្តាល ផ្នែក វិទ្យាសាស្រ្ត ដល់ ពួកគេ បន្ថែម ទៀត ពោលគឺ បើ ជំនាញ គណនេយ្យ ឱ្យ ច្បាស់ ជំនាញ គណនេយ្យ កុំព្យូរ ទ័រ ឱ្យ ច្បាស់ កុំព្យូទ័រ ។
លោក បន្ត ថា « សម្រាប់ ខ្ញុំ អ្នកអប់រំ ក្តី អ្នក គោល នយោបាយ អ្នកធ្វើ ការសម្រេចចិត្ត ក្តី ខ្ញុំ គិត ថា គួរតែ អង្គុយ ជជែកគ្នា ឱ្យ ស៊ីជម្រៅ កន្លែងណាភាព ខ្លាំង របស់ យើង យើង មិន អាច ទៅ ប្រកួត ជាមួយ គេ គ្រប់ រឿង បាន ទេ ដូច ស៊ីហ្គេម ថ្មី ៗ នេះ យើង មិន អាច ប្រកួត គ្រប់ វិញ្ញាសារ បាន នោះ ទេ យើង មើល វិញ្ញាសារ ណា ខ្លាំង យើង ធ្វើ អ៊ីចឹង ទៅ » ៕
សូម ស្តាប់ ការពន្យល់ បន្ថែម របស់ លោក ជេត ជា លី៖ ក្រុមប្រឹក្សា ខេត្ត សៀមរាប បើក កិច្ចប្រជុំ សាមញ្ញ លើក ទី ៥៨ ឆ្នាំ ទី៥ ដើម្បី ដោះស្រាយ លើ បញ្ហា ពាក់ព័ន្ធ មួយ ចំនួន
ក្នុង កិច្ចប្រជុំ នេះ ដែរ សមាជិក នៃ កិច្ចប្រជុំ ក្រុមប្រឹក្សា ខេត្ត បាន លើ នូវ បញ្ហា ពាក់ព័ន្ធ មួយ ចំនួន ទៅនឹង រដ្ឋបាល ខេត្ត ដោយ បាន ផ្តោត ទៅ លើ ការស្នើសុំ បង្កើត ទី ចាត់ការ ទីក្រុង ឆ្លាតវៃ . ពាក់ព័ន្ធ ធនធាន មនុស្ស នៃ រដ្ឋបាល ខេត្ត . បញ្ហា ការគ្រប់គ្រង ស្ថានីយ៍ ប្រេងឥន្ធ នះ និង ហ្គាស ក្នុង ការចេញ នូវ អាជ្ញាប័ណ្ណ ធ្វើ អាជីវកម្ម ។ ក្នុង នោះ ដែរ ត្រូវបាន ថ្នាក់ដឹកនាំ មន្ទីរ ពាក់ព័ន្ធ បាន ធ្វើ ការបកស្រាយ បំភ្លឺ ទៅនឹង សំណួរ របស់ សមាជិក ក្រុមប្រឹក្សា ខេត្ត បាន លើកឡើង ផងដែរ ។
លោក អ៊ាន ឃុន បាន លើកឡើង ថា តាមរយៈ ការចូលរួម ធ្វើ ការពិនិត្យ ពិភាក្សា ឆ្លុះបញ្ចាំង មតិ យោបល់ ល្អ ៗ ប្រកបដោយ ក្រមសីលធម៌ វិជ្ជាជីវៈ ពីសំណាក់ ស្រី លោកស្រី សមាជិក សមាជិកា ក្រុមប្រឹក្សា ខេត្ត គណៈ អភិបាល ខេត្ត ប្រធាន មន្ទីរ អង្គភាព និង អ្នក ពាក់ព័ន្ធ ទាំងអស់ បាន ញ៉ាំង ឲ្យ ដំណើរការ នៃ កិច្ចប្រជុំ សាមញ្ញ លើក ទី ៥៩ របស់ ក្រុមប្រឹក្សា ខេត្ត ប្រព្រឹត្តទៅ តាម លំដាប់លំដោយ និង ទទួលបាន លទ្ធផល តាម ការគ្រោងទុក ។
លោក បាន បញ្ជាក់ ថា គ្រប់ កាលៈទេសៈ ដែល ប្រជាពលរដ្ឋ ជួប ការលំបាក អាជ្ញាធរ ខេត្ត បាន យកចិត្តទុកដាក់ ក្នុង ការដោះស្រាយ រាល់ បញ្ហា ដែល បាន លើកឡើង ព្រោះ បញ្ហា ទាំងនេះ គឺជា បញ្ហា របស់ ប្រជាពលរដ្ឋ ដែល តែងតែ លើកឡើង ជា អន្លើ ៗ និង បាន ដោះស្រាយ ប្រកបដោយ ប្រសិទ្ធភាព មាន សាមគ្គីភាព ផ្ទៃក្នុង និង មាន ស្មារតី ទទួលខុសត្រូវ ក្នុង ការបំពេញ ការងារ ស្រប តាម គោល នយោបាយ ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ នឹង កំណែទម្រង់ វិមជ្ឈការ និង វិសហមជ្ឈការ នៅ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ផងដែរ ៕
( ភ្នំពេញ ) ៖ ឆ្លើយតប នឹង ការលើកឡើង របស់ មហាជន ដែល តែងតែ លើកឡើង ថា អ្នករៀន ចប់ ថ្នាក់ ឧត្ដម សិក្សា ពេល ចេញ ធ្វើ ការ បាន ប្រាក់ខែ តិច ជាង អ្នក មិន បាន រៀន ត្រូវបាន លោក ជេត ជាលី សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ (RUPP) បកស្រាយ ថា ការលើកឡើង នេះ ត្រូវ មួយ ជ្រុង ប៉ុន្ដែ មិន ត្រូវ ទាំងមូល ។
លោក បណ្ឌិត ជេត ជាលី បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ការលើកឡើង នេះ អាច ត្រូវ មួយ ជ្រុង ប៉ុន្ដែ មិន ត្រូវ រូបភាព ទាំងមូល ក្រុមហ៊ុន សហគ្រាស ផ្ដល់ ប្រាក់ខែ មិន អាស្រ័យ លើ សញ្ញាបត្រ ទេ ប៉ុន្ដែ អាស្រ័យ លើ ផលិតផល ភាព ការងារ ទោះបីជា មាន សញ្ញាបត្រ ធំ ប៉ុណ្ណា ក៏ដោយ បើ ផលិតផល ភាព ការងារ មិន សូវ មាន ក៏ គេ មិន សូវ ឲ្យ ប្រាក់ខែ ច្រើន ដែរ ប៉ុន្ដែ មុននឹង គេ មើល ផលិតភាព ការងារ គឺ គេ មើល សញ្ញាបត្រ ជាមុន សិន » ៕
( កំពង់ស្ពឺ ) ៖ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត កំពង់ស្ពឺ បាន ពន្លឿន ក្នុង ការជួសជុល និង ពង្រីក តួ ផ្លូវ ពី ទទឹង ជាង ៤ម៉ែត្រ ទៅ ទទឹង ៦ម៉ែត្រ និង ក្រាល កៅស៊ូ ២ស្រទាប់ (DBST) ឲ្យ កាន់តែ ប្រសើរ ជាង មុន ងាយស្រួល ក្នុង ការបញ្ជៀស ចរាចរណ៍ ទៅ - មក របស់ ប្រជាពលរដ្ឋ និង ក្រុម ភ្ញៀវ ទេសចរណ៍ ។
លោក ស៊ូ ស៊ុន្ធ រ៉ា ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត កំពង់ស្ពឺ បាន ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២៤ ថា ការងារ នេះ បាន ធ្វើឡើង ដោយ មាន ការណែនាំ ដ៏ ខ្ពង់ខ្ពស់ ពីសំណាក់ លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ ។
លោក ថា « តម្រូវ ការចាំបាច់ អំពី កំណើន ទេសចរណ៍ ដែល មក លេង កំសាន្ត នៅលើ ភ្នំ គីរីរម្យ ( ឧទ្យាន ជាតិ ព្រះសុរាម្រិត - កុសមៈ គីរីរម្យ ) ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ កាន់តែ មាន ភ្ញៀវ មក កំសាន្ត ច្រើន ទើប តម្រូវ ការចាំបាច់ ត្រូវ ពង្រីក តួ ផ្លូវ ឲ្យ កាន់តែ ធំ និង ជួសជុល ជង្ហុក ដែល ខូចខាត ដោយសារតែ ទឹកភ្លៀង ឲ្យបាន ប្រសើរ ឡើងវិញ » ។
លោក ប្រធាន មន្ទីរ បាន ឲ្យដឹង ទៀត ថា ផ្លូវ មួយ ខ្សែ នេះ មាន ប្រវែង ២៧ គីឡូម៉ែត្រ គិត ចាប់ពី ផ្លូវ ជាតិ លេខ ៤ រហូតដល់ លើ ភ្នំ ហើយ បច្ចុប្បន្ន នេះ មន្ទីរ បាន ថែទាំ ជាប្រចាំ និង ជួសជុល រួច មាន ប្រវែង ជាង ១០គីឡូម៉ែត្រ ហើយ ។ សព្វ ថ្ងៃ មន្ទីរ បាន ពន្លឿន ការជួសជុល ឲ្យបាន ល្អ ប្រសើរ មុន បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ ២០២៤ ។
លោក ប្រធាន មន្ទីរ បាន បញ្ជាក់ ថា « ការជួសជុល បាន ជួប ផលវិបាក ខ្លះ ដោយសារតែ ស្ថានភាព ផ្លូវ ឡើង ភ្នំ ហើយ មាន ផ្លូវ បត់បែន ជាច្រើន កន្លែង ធ្វើឲ្យ គ្រឿងចក្រ ខ្លះ មិន អាច ប្រើ បច្ចេកទេស ដូច ផ្លូវ លាត ស្មើ បាន ឡើយ » ។ រំលឹក ថា ផ្លូវ មួយ ខ្សែ នេះ បាន បន្សល់ទុក តាំងពី សម័យ សង្គម រាស្ត្រ និយម ដែល កសាងឡើង ដោយ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះនរោត្តម សីហនុ ( ព្រះមរមរត កោដ្ឋ )៕ កិច្ចប្រជុំ កំពូល ធុរកិច្ច អាស៊ាន - កម្ពុជា ឆ្នាំ ២០២៤ នៅ រាជធានី ភ្នំពេញ បញ្ចប់ ទៅ ប្រកបដោយ ជោគជ័យ
( ភ្នំពេញ ) ៖ កិច្ចប្រជុំ កំពូល ធុរកិច្ច អាស៊ាន - កម្ពុជា ឆ្នាំ ២០២៤ ដែល បាន បញ្ចប់ នៅ ថ្ងៃទី២ ខែមេសា បាន កត់ត្រា នូវ ព្រឹត្តិការណ៍ ដ៏ សំខាន់ មួយ ក្នុង កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច ក្នុង តំបន់ ដែល នាំមក នូវ វឌ្ឍនភាព គួរឱ្យ កត់សម្គាល់ ក្នុង ការបង្កើត ភាពជាដៃគូ ថ្មី និង គំនិត ផ្តួចផ្តើម សេដ្ឋកិច្ច ជា យុទ្ធសាស្ត្រ ។
រៀបចំឡើង ដោយ សភា ពាណិជ្ជកម្ម កម្ពុជា សហការ ជាមួយ ដៃគូ សភា ពាណិជ្ជកម្ម អន្តរជាតិ និង សមាគម ពាណិជ្ជកម្ម អន្តរជាតិ នានា នៅ កម្ពុជា កិច្ចប្រជុំ កំពូល នេះ គឺជា សក្ខីភាព មួយ នៃ ស្មារតី សហការ ជំរុញ អនាគត សេដ្ឋកិច្ច របស់ អាស៊ាន ។
ពិធី បើក កិច្ចប្រជុំ កំពូល បាន ចាប់ផ្ដើម នៅ ថ្ងៃទី២ ខែមេសា ឆ្នាំ ២០២៤ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ស្សរជន ជាន់ ខ្ពស់ រួម មាន៖ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី មន្ត្រី ជាន់ ខ្ពស់ របស់ រាជ រដ្ឋាភិបាល និង ឯក អគ្គ រដ្ឋទូត រួម ជាមួយ ថ្នាក់ដឹកនាំ ធុរកិច្ច ជាង ៥០០ រូប មកពី អាស៊ាន និង ជុំវិញ ពិភពលោក រួមទាំង នាយក ប្រតិបត្តិ នៃ សាជីវកម្ម អន្តរជាតិ ធំ ៗ ដែល កំពុង ប្រតិបត្តិការ ក្នុង ប្រទេស កម្ពុជា បាន ចូលរួម នៅក្នុង កិច្ចប្រជុំ កំពូល នេះ ។
នៅក្នុង សុន្ទរកថា គន្លឹះ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន អបអរសាទរ ការវិវត្តន៍ ដ៏ គួរឱ្យ កត់សម្គាល់ របស់ អាស៊ាន ដែល បាន ប្រែក្លាយទៅជា តំបន់ សេដ្ឋកិច្ច ថា មវន្ត ចាប់តាំងពី ការបង្កើតឡើង ក្នុង ឆ្នាំ ១៩៦៧ ។ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន សង្កត់ធ្ងន់ លើ តួនាទី របស់ កម្ពុជា ជា ដៃគូ សកម្ម និង ស្និទស្នាល ក្នុង ចង្កោម គ្រួសារ អាស៊ាន ហើយ បាន បញ្ជាក់ ជាថ្មី ពី ការយកចិត្តទុកដាក់ របស់ ប្រទេស កម្ពុជា ក្នុង ការរួមចំណែក ដល់ សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន ដែល មាន ភាពធន់ ចីរភាព បរិយាប័ន្ន និង ភាពប្រកួតប្រជែង ។
កិច្ចប្រជុំ កំពូល នេះ ក៏ មាន ការរៀបចំ ពិធី ជប់លៀង Cocktails នៅ ថ្ងៃទី១ ខែមេសា ឆ្នាំ ២០២៤ ក្រោម អធិបតីភាព លោកស្រី ចម និម្មល រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា ដើម្បី បង្កើត ទំនាក់ទំនង ដ៏ មាន តម្លៃ នៅ ទូទាំង វិស័យ ធុរកិច្ច រដ្ឋាភិបាល និង ការវិនិយោគ ។
លោកស្រី បាន សង្កត់ធ្ងន់ លើ ការ ផ្តោត សំខាន់ នៃ កិច្ចប្រជុំ លើ ការបោះជំហាន សេដ្ឋកិច្ច របស់ អាស៊ាន និង សក្តានុពល សម្រាប់ ការតភ្ជាប់ ក្នុង តំបន់ ដែល កាន់តែ កើនឡើង ដោយ ជំរុញ ឱ្យ មាន ការប្តេជ្ញាចិត្ត ចំពោះ កំណើន ប្រកបដោយ និរន្តរភាព និង បរិយាប័ន្ន ដោយ កម្ពុជា បាន ត្រៀម ខ្លួន ជា ច្រកទ្វារ ដ៏ សំខាន់ មួយ ទៅកាន់ ទីផ្សារ អាស៊ាន ។
កិច្ចប្រជុំ កំពូល បាន សិក្សា ស្វែងយល់ អំពី សសរ ស្តម្ភ បរិវត្តកម្ម ចំនួន បី រួម មាន៖
១. ការបញ្ចេញ ថាមពល នៃ ការតភ្ជា ប់៖ ផ្នែក នេះ បាន គូសបញ្ជាក់ ពី សារៈសំខាន់ នៃ ការជំរុញ ភាពជាដៃគូ ឆ្លង ដែន និង គំនិត ផ្តួចផ្តើម រួមគ្នា ដែល មាន សារៈសំខាន់ ក្នុង ការសម្រេចបាន សក្តានុពល សេដ្ឋកិច្ច រួម របស់ អាស៊ាន ។
២. កម្ពុជា ជា ច្រកទ្វារ ទៅកាន់ អាស៊ាន៖ ការពិភាក្សា បាន បំភ្លឺ អំពី ជំហរ យុទ្ធសាស្ត្រ របស់ កម្ពុជា និង សក្តានុពល ដែល កំពុង រីកចម្រើន ក្នុង នាម ជា មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម ការវិនិយោគ និង កិច្ចសហប្រតិបត្តិការ ក្នុង អាស៊ាន ដែល ជំរុញ ឱ្យ មាន សមាហរណកម្ម កាន់តែ ស៊ីជម្រៅ នៅក្នុង តំបន់ ។
៣. ការប្រើប្រាស់ ន វានុវត្តន៍ បច្ចេកវិទ្យា និង ឌីជីថល នីយកម្ម សម្រាប់ កំណើន ដែល មាន បរិយាប័ន្ន៖ កិច្ចប្រជុំ កំពូល បាន ពិភាក្សា អំពី របៀប ដែល បរិវត្តកម្ម ឌីជីថល និង បច្ចេកវិទ្យា ដែល កំពុង រីកចម្រើន ដូចជា បញ្ញា សិប្បនិមិត្ត (AI) អាច នាំឱ្យ មាន ការផ្លាស់ប្ដូរ ការប្រកប អាជីវកម្ម បំពេញ គម្លាត ឌីជីថល និង ជំរុញ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង ជា ប្រធាន ក្រុមប្រឹក្សា ពិគ្រោះយោបល់ ធុរកិច្ច អាស៊ាន - កម្ពុជា បាន លើកឡើង ពី សារៈសំខាន់ នៃ កិច្ចប្រជុំ កំពូល ដែល កម្ពុជា បន្ត ការចូលរួម នៅក្នុង សមាហរណកម្ម សេដ្ឋកិច្ច អាស៊ាន ។
