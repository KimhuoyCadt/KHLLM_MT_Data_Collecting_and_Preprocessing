( ភ្នំពេញ ) ៖ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង លោកជំទាវ បណ្ឌិត បាន បរិច្ចាគ ថវិកា ចំនួន ៣ម៉ឺន ដុល្លារ និង ២០ លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ បណ្ឌិត តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម កេីត ឆែ និង លោកជំទាវ យុត សុវណ្ណ រីដា បរិច្ចាគ ថវិកា ១០លាន រៀល ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ ឯកឧត្តម កេីត ឆែ និង លោកជំទាវ យុត សុវណ្ណ រីដា បាន បរិច្ចាគ ថវិកា ចំនួន ១០លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
ឯកឧត្តម កេីត ឆែ និង លោកជំទាវ យុត សុវណ្ណ រីដា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
មេធាវី ប្រមាណ ជាង ៨០០ នាក់ ចូលរួម ពិធី ពិសា អាហារ សាមគ្គី ដែល រៀបចំឡើង ដោយ លោក មេធាវី ចេង ប៉េង ហាប់
ថ្លែង ក្នុង ឱកាស ដ៏ វិសេសវិសាល នេះ លោក មេធាវី ចេង ប៉េង ហាប់ បាន បញ្ជាក់ ពី គោលបំណង នៃ ពិធី ពិសា អាហារ សាមគ្គី នេះ គឺ ដើម្បី បង្កើត ឱកាស ក្នុង ការជួបជុំ រឹត ចំណង មិត្តភាព សាមគ្គីភាព ភាតរភាព ផ្លាស់ប្តូរ ទស្សនៈ វិស័យ គំនិត យោបល់ ចែករំលែក បទពិសោធន៍ ល្អ ៗ និង ផ្សាភ្ជាប់ ទំនាក់ទំនង រវាង បងប្អូន សហភាតា ព្រមទាំង អ្នក ច្បាប់ មក ពី គ្រប់ វិស័យ ឲ្យ កាន់តែ មាន ភាពស្និទ្ធស្នាល ។
លុបបំបាត់ គ្រឿងញៀន ត្រូវ ផ្តើម ចេញ ពី យើង ទាំងអស់ គ្នា ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៨ ខែមេសា៖ បង្ក្រាប ១៥ករណី ឃាត់ខ្លួន ៣៧ នាក់
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៥ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៣៧នាក់ ។
ប្រទេស កាតា ដែល មាន ទីស្នាក់ការ កណ្តាល របស់ ក្រុមហា ម៉ាស់ នៅ ទីក្រុង ដូហា បាន ដើរ តួនាទី យ៉ាង សំខាន់ ជា អ្នកសម្រុះសម្រួល ក្នុង អំឡុង ពេល ជម្លោះ អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស់ ។ រួម ជាមួយ សហរដ្ឋ អាមេរិក និង អេហ្ស៊ីប កាតា បាន ដើរ តួយ៉ាង សំខាន់ ក្នុង ការឈាន ទៅដល់ បទ ឈប់ បាញ់ បណ្តោះអាសន្ន កាលពី ខែវិច្ឆិកា ដែល សម្រេចបាន នូវ ការដោះលែង ចំណាប់ខ្មាំង ជាច្រើន នាក់ ផងដែរ ។
ទោះបីជា មាន ការចរចា ជាច្រើន ជុំ ក៏ដោយ ក៏ គ្មាន បទ ឈប់ បាញ់ បន្ថែម ណាមួយ ត្រូវបាន សម្រេច ឡើយ ។ ទាក់ទង នឹង បញ្ហា នេះ ប្រទេស កាតា បាន សម្តែង ការខកចិត្ត យ៉ាង ខ្លាំង ដោយ កាលពី សប្តាហ៍ មុន បាន ប្រកាស ថា ខ្លួន កំពុង ពិចារណា ឡើងវិញ នូវ តួនាទី របស់ ខ្លួន ជា អ្នកសម្រុះសម្រួល ។
លោក បាន សង្កត់ធ្ងន់ ថា « យើង សង្ឃឹម ថា នឹង ឃើញ ការប្តេជ្ញាចិត្ត និង ភាពម៉ឺងម៉ាត់ បន្ថែម ទៀត ពី ភាគី ទាំង ពីរ » ។ ទោះជា យ៉ាងណា លោក មិន បាន ផ្តល់ ព័ត៌មាន ជាក់លាក់ អំពី ស្ថានភាព បច្ចុប្បន្ន នៃ ការចរចា នេះ ទេ ប៉ុន្តែ បាន លើកឡើង ថា ពួកគេ បាន ឈានដល់ ចំណុច ជាប់គាំង ដោយ ភាគី ទាំង ពីរ ប្រកាន់ ជំហរ យ៉ាង ម៉ឺងម៉ាត់ ។
( កំពង់ចាម ) ៖ លោក សន្តិ បណ្ឌិត នេត សាវឿន សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ខេត្ត កំពង់ចាម នា រសៀល ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន សំណេះសំណាល ជាមួយ អង្គ បោះឆ្នោត និង ប្រកាស បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ខេត្ត កំពង់ចាម អាណត្តិ ទី៤ ។
លោក នេត្រ ភក្ត្រា៖ សម្តេច តេជោ សម្តេច ធិបតី និង គណបក្ស ប្រជាជន កម្ពុជា ជា កម្លាំង ស្នូល និង ជា បង្អែក ដ៏ កក់ក្តៅ និង រឹងមាំ របស់ ប្រជាជន
( ភ្នំពេញ ) ៖ លោក នេត្រ ភក្ត្រា សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ក្រសួង ព័ត៌មាន បាន ថ្លែង ថា សម្តេច តេជោ ហ៊ុន សែន សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ថ្នាក់ដឹកនាំ កំពូល ៗ និង គណបក្ស ប្រជាជន កម្ពុជា ទាំងមូល ជា កម្លាំង ស្នូល និង ជា បង្អែក ដ៏ កក់ក្តៅ និង រឹងមាំ របស់ ប្រជាជន ក្នុង បុព្វហេតុ កសាង និង ការពារ មាតុភូមិ ។
លោក នេត្រ ភក្ត្រា ថ្លែង នេះ ក្នុង ឱកាស ចូលរួម ជា អធិបតី កិច្ចប្រជុំ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ក្រសួង ព័ត៌មាន នៅ វិមាន ៧ មករា រាជធានី ភ្នំពេញ នា ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២៤ ដើម្បី ពិនិត្យ លើ វឌ្ឍនភាព ការងារ របស់ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ក្រសួង ព័ត៌មាន ការធ្វើ បច្ចុប្បន្នភាព នៃ សមាជិក បក្ស ការប្រកាស សេចក្តីសម្រេច ស្តពី ការទទួលស្គាល់ ក្រុមការងារ យុវជន បក្ស ក្រសួង ព័ត៌មាន ដោយ មាន ការចូលរួម ពី សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ក្រសួង ព័ត៌មាន សរុប ជាង ៦០០ នាក់ ។
លោក នេត្រ ភក្ត្រា បាន ថ្លែង ថា ការសប្បាយរីករាយ របស់ ប្រជាជន កម្ពុជា នៅ ថ្ងៃ នេះ គឺ ពិតជា ផ្តើម ចេញ ពី ជ័យជម្នះ ៧មករា បើ គ្មាន ជ័យជម្នះ ៧មករា គឺ ពិតជា មិន អាច មាន អ្វី ៗ ដូច សព្វ ថ្ងៃ នេះ ឡើយ ។ ដូច្នេះ សមាជិក ទាំងអស់ គ្នា ជា សមាជិក សមាជិកា គណបក្ស ត្រូវការពារ ស្មារតី ៧ មករា និង ការពារ សុខ សន្តិភាព ដែល រក បាន មក ដោយ ពិបាក នេះ ទោះ ក្នុង តម្លៃ ណា ក៏ដោយ ៕
លោក ឡាយ ឈុន ហួ ឧបត្ថម្ភ ថវិកា ២០ លាន រៀល ជូន ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា តាមរយៈ ការប្រកួត បាល់ទាត់ មនុស្សធម៌ ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន
សម្តេច បាន បញ្ជាក់ ផងដែរ ថា សម្រាប់ សប្បុរសជន ចង់ ចូល រួម តាមរយៈ សម្តេច ក្នុង ព្រឹត្តិការណ៍ ប្រកួត បាល់ទាត់ មនុស្សធម៌ នេះ សូម ទាក់ទង ទៅ លោក សេង ទៀង ដែល មាន លេខ ទូរស័ព្វ ០១២ ៩៦១ ៩៧១ ៕ មេធាវី ស្ត្រី នៃ គណៈមេធាវី ចែករំលែក ក្តីស្រឡាញ់ និង លើកទឹកចិត្ត ដល់ កុមារី និង យុវតី នៃ អង្គការ អាហ្វេ ស៊ីប កម្ពុជា
( ភ្នំពេញ ) ៖ មេធាវី ស្ត្រី នៃ គណៈមេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ជួប សំណេះសំណាល ដោយ ផ្ទាល់ ជាមួយ កុមារី និង យុវតី នៅ អង្គការ អាហ្វេ ស៊ីប កម្ពុជា (AFESIP) ជាមួយនឹង ការចែករំលែក ក្ដី ស្រឡាញ់ ការលើកទឹកចិត្ត ដ៏ មាន តម្លៃ ដល់ កុមារី និង យុវតី ឲ្យ ខិតខំ អភិវឌ្ឍ ខ្លួន ដើម្បី កសាង អនាគត ដ៏ ថ្លៃថ្លា ។
លោកស្រី ម៉ម សុម៉ាលី ប្រធាន អង្គការ អាហ្វេ ស៊ីប កម្ពុជា (AFESIP) បាន ឱ្យដឹង ថា អង្គការ នេះ បាន បង្កើតឡើង តាំងពី ឆ្នាំ ១៩៩៦ ដោយ ផ្ដើម ចេញ ពី បុព្វហេតុ ស្រណោះ អាណិត ដល់ កុមារី កម្ពុជា ដែល រង ការរំលោភបំពាន ដើម្បី ជួយ ស្រោចស្រង់ អនាគត របស់ ពួកគេ ឱ្យ បាន ល្អ ប្រសើរ ឡើងវិញ ប្រែក្លាយ ពួកគេ ឱ្យ ក្លាយ ធនធាន មនុស្ស ដែល មាន តម្លៃ ។
នៅពេល ពួកគេ មាន ការងារ ធ្វើ មាន ប្រាក់ ចំណូល ឬ ក៏ មាន លទ្ធភាព គួរ សម ហើយ ពួកគេ ក៏ អាច បន្ត ការជួយ អ្នកដទៃ ទៀត ដែល ជួប បញ្ហា លំបាក ឬ រងគ្រោះ ដោយ ប្រការ ណាមួយ នេះ ហើយ គឺជា បំណង និង បណ្ដាំ របស់ លោកស្រី ម៉ម សុម៉ាលី ដែល កុមារី និង យុវតី គ្រប់ គ្នា តែង ហៅថា « ម៉ែ ចាស់ ៗ » ពោលគឺ លោកស្រី ម៉ម សុម៉ាលី មិន ត្រូវការ ឱ្យ មាន ការតបស្នង មកកាន់ លោកស្រី វិញ ទេ តែ លោកស្រី ចង់ឱ្យ ពួកគេ ចេះ ជួយ សង្គម សង គុណ ផែនដី សង គុណ ប្រទេសជាតិ របស់ ខ្លួន ។
លោកស្រី ឈីវ ភិរម្យ ក៏ បាន ចែករំលែក បទពិសោធន៍ ដល់ កុមារី និង យុវវតី ក្នុង កម្មវិធី នោះ អំពី ការតស៊ូ ក្នុង ជីវិត តាំងពី កុមារភាព ក្នុង ជីវភាព ក្រខ្សត់ ប៉ុន្តែ នៅតែ ខិតខំ តស៊ូ ជម្នះ ព្រេង វាសនា ខិតខំ សិក្សា អភិវឌ្ឍ ចំណេះដឹង ឆ្លងកាត់ ឧបសគ្គ ច្រើន ជំពូក តែ ដោយសារ ការព្យាយាម ទើប ទទួលបាន សមិទ្ធផល និង ការងារ ដ៏ ល្អ ក្នុង ជីវិត នា ពេល ជាង ៤០ ឆ្នាំ មក នេះ ។
ជាមួយគ្នា នោះ លោកស្រី ឈីវ ភិរម្យ ក៏ បាន នាំយក នូវ បណ្ដាំ ៥ឃ្លា ដែល ជា ឃ្លា វេទមន្ត ធ្លាប់ បាន ប្រើ ក្នុង ជីវិត និង បន្ត ប្រើប្រាស់ តទៅ មុខ ទៀត ចែករំលែក ជូន កុមារី និង យុវតី នៃ អង្គការ អាហ្វេ ស៊ីប ផងដែរ ក្នុង នោះ រួម មាន៖
លោកស្រី ឈីវ ភិរម្យ ក៏ បាន ពាំនាំ នូវ ប្រយោគពរ ជ័យ សំខាន់ ៗ មួយចំនួន ទៀត ដែរ ចែកជូន ដល់ កុមារី និង យុវវតី នៃ អង្គការ អាហ្វេ ស៊ី ប៖
គួរ ជម្រាប ថា លោកស្រី ឈីវ ភិរម្យ ព្រមទាំង មេធាវី ស្ត្រី នៃ គណៈមេធាវី ក៏ ដូចជា សប្បុរសជន បាន ប្រគល់ អំណោយ មាន ជា គ្រឿង ឧបភោគ បរិភោគ វត្ថុអនុស្សាវរីយ៍ ថវិកា មួយ ចំនួន ចែកជូន ដល់ លោកគ្រូ អ្នកគ្រូ បុគ្គលិក យុវតី កុមារី តូច ៗ នៃ អង្គការ អាហ្វេ ស៊ីប កម្ពុជា ពិសេស នោះ ក៏ មាន ការរៀបចំ ខួប អនុវស្សា វីយ របស់ អង្គការ AFESIP ផងដែរ ៕ ថៃ ចុះ កិច្ចព្រមព្រៀង ស្តីពី បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ ជាមួយ អូស្ត្រាលី
( បាងកក )៖ ប្រទេស ថៃ និង អូស្ត្រាលី បាន ចុះហត្ថលេខា លើ កិច្ចសហប្រតិបត្តិការ ផ្នែក បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ ដើម្បី លើកកម្ពស់ ឧស្សាហកម្ម បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ (fintech) ក្នុង ស្រុក ។ នេះ បើ យោង តាម កាសែត បាងកក ប៉ុស្តិ៍ ។
ស្រវឹង សូម កុំ បើកបរ ! ស្លាប់ ៥នាក់ និង របួស ៤នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៨ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ៤នាក់ ។
ឯកឧត្តម បណ្ឌិត អូស្មាន ហាស្សាន់ ផ្ញើ សារ ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ គ្រួសារ យោធិន ពលី ជីវិត ក្នុង ហេតុការណ៍ ផ្ទុះ គ្រាប់ នៅ បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ទី៣
( ភ្នំពេញ ) ៖ ឯកឧត្តម បណ្ឌិត អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្រ្តី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ភរិយា មាន ក្តី ក្តុកក្តួល រន្ធត់ ចិត្ត ឥត ឧបមាដោយ បាន ទទួល ដំណឹង អំពី ឧបទ្ទវហេតុ ផ្ទុះ ឃ្លាំង ស្តុក គ្រាប់ នៅ ទីបញ្ជាការ យោធ ភូមិភាគ ទី៣ នា ថ្ងៃសៅរ៍ ៤រោច ខែ ចេត្រ ឆ្នាំ រោង ឆស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២៤ បង្កឱ្យ យោធិន ចំនួន ២០ នាក់ បាន ពលី ជីវិត និង យោធិន មួយចំនួន បាន រងរបួស ។
ក្នុង វេលា ដ៏ ក្រៀមក្រំ នេះ ខ្ញុំ និង ភរិយា សូម សម្ដែង នូវ សមាន ទុក្ខ ដ៏ ធំធេង និង សោកស្ដាយ ស្រណោះ អាឡោះអាល័យ ជា ទីបំផុត ជាមួយ ក្រុមគ្រួសារ យោធិន ពលី ព្រោះ ការបាត់បង់ នេះ គឺជា ការបាត់បង់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ឆ្នើម ដែល បាន ធ្វើ ពលិកម្ម បូជា សាច់ ស្រស់ ឈាម ស្រស់ ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ ជា ទី ស្នេហា ពិសេស រួមចំណែក យ៉ាង សំខាន់ ក្នុង បុព្វហេតុ ការពារ បូរណភាព ទឹកដី កសាង សុខ សន្តិភាព ស្ថិរភាព សង្គម និង រួម សុខ ទុក្ខ ជាមួយ ប្រជាជន កម្ពុជា រហូតដល់ ថ្ងៃ អវសាន ជីវិត ។
