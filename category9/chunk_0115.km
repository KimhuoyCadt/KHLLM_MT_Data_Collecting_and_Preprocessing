( បន្ទាយមានជ័យ )៖ លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ និង លោកស្រី ជ័យ ណារី អ៊ុំ រាត្រី . លោក ប្លែក វ៉ារី ប្រធាន ក្រុមប្រឹក្សា ខេត្ត រួម ជាមួយ លោក លោកស្រី អភិបាល រង ខេត្ត និង មន្ត្រីរាជការ នៃ រដ្ឋបា ខេត្ត បាន និមន្ត ព្រះសង្ឃ រៀបចំ ពិធី ពិធី សូត្រ មន្ត សុំ សិរី សួស្តី សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ មន្ត្រី ជាប់ កិច្ចសន្យា និង បុគ្គលិក ស្ម័គ្រចិត្ត នៃ សាលា ខេត្ត ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ នៅ រសៀល ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២៤ ធ្វើ នៅ សាល ប្រជុំ សាលា ខេត្ត បន្ទាយមានជ័យ ។
នៅក្នុង ពិធី សូត្រ មន្ត ប្រោះ ព្រំ លើក រាសី ដើម្បី ចូលរួម អបរសាទរ ទេវតា ឆ្នាំ ថ្មី នោះ ថ្នាក់ដឹកនាំ ខេត្ត ក៏ ដូចជា មន្ត្រីរាជការ បាន បួងសួង ដល់ វត្ថុ សក្ដិសិទ្ធិ ទេវតា ឆ្នាំ ថ្មី សូម ជូយ ប្រោស ព្រំ ប្រសិទ្ធ ពរ ជ័យ សិរី សួស្តី ជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត បន្ទាយមានជ័យ ទាំងមូល រស់ នៅ ប្រកប ទៅ ដោយ ភាពសុខដុមរមនា ចៀស ផុត អំពី គ្រោះ កាច ទាំងឡាយ ទាំងពួង ពិសេស ជួយ ឲ្យ ខេត្ត បន្ទាយមានជ័យ មាន ការអភិវឌ្ឍ ទៅ មុខ ជាលំដាប់ ។
ក្នុង ពិធី សូត្រ មន្ត ប្រោះ ព្រំ នោះ លោក អ៊ុំ រាត្រី បាន កោតសរសើ និង ថ្លែងអំណរ អរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ លោក លោកស្រី អភិបាល រង ខេត្ត និង មន្ត្រីរាជការ និង មន្ត្រី ជាប់ កិច្ចសន្យា និង បុគ្គលិក ស្ម័គ្រចិត្ត នៃ សាលា ខេត្ត ដែល បាន សហការ គ្នា បំពេញ តួនាទី និង ភារកិច្ច ក្នុង ការដឹកនាំ គ្រប់គ្រង ឱ្យ ទទួលបាន ប្រសិទ្ធភាព ក្នុង រយៈ កន្លងមក ។
ជាមួយគ្នា នោះ អភិបាល ខេត្ត បាន ផ្តាំផ្ញើ លោក លោកស្រី អភិបាល រង ខេត្ត និង មន្ត្រីរាជការ និង មន្ត្រី ជាប់ កិច្ចសន្យា និង បុគ្គលិក ស្ម័គ្រចិត្ត នៃ សាលា ខេត្ត ត្រូវ បន្ត ចូលរួម សហការ គ្នា ក្នុង ការបំពេញ ភារកិច្ច និង រួមចំណែក ក្នុង ដំណើរការ ពង្រឹង និង អភិវឌ្ឍន៍ ខេត្ត ទៅ មុខ ជាលំដាប់ និង ការអនុវត្ត ជាក់ស្ដែង នៅ តួនាទី របស់ យើង គ្រប់ ៗ គ្នា ៕
បទ វិភាគ៖ ហ្វីលីពីន គួរតែ ប្រកាន់ខ្ជាប់ យុទ្ធសាស្ត្រ ដោយ ម្ចាស់ ការ ក្នុង ន័យ គាំពារ សន្តិភាព និង ស្ថិរភាព ក្នុង តំបន់
លោក Marcos ប្រធានា ធីបតី ហ្វីលីពីន ធ្លាប់ អះអាង ថា មិត្ត នៅ តំបន់ ខាងក្រៅ បាន “ លើកឡើង ដោយ ម្ចាស់ ការ ថា ចង់ ជួយ យើង និង បំពេញ តម្រូវការ របស់ ហ្វីលីពីន ” ។ ទាក់ទិន នឹង សុន្ទរកថា គួរឱ្យ អស់ សំណើច បែប នេះ អ្នកវិភាគ បាន និយាយ ផ្គើន ថា ហ្វីលីពីន មិន មែន ជា ស្រី ស្អាត ដែល មាន មន្តស្នេហ៍ ម្នាក់ ទេ ប្រទេស លោក ខាងលិច ទាំង នេះ មក សហការ គ្នា ពី ទី ឆ្ងាយ ក៏ មិន មែន ស្វែងរក ចំណង មិត្តភាព និង ក្តីស្រឡាញ់ ជាមួយ ហ្វីលីពីន ដែរ ។
ដូច្នេះ អ្នកផង ទាំងពួង បាន មើលឃើញ ឈុត ឆាក ដ៏ ប្រេះស្រាំ បែប នេះ ពោលគឺ មួយ ផ្នែក ប្រទេស អាស៊ាន ភាគ ច្រើន ខិតខំ ប្រឹងប្រែង គាំពារ សុខ សន្តិភាព ក្នុង តំបន់ ក្នុង ន័យ ជំរុញ កិច្ចសហប្រតិបតិ្តការ ក្នុង តំបន់ និង សមាហរណកម្ម ផ្នែក សេដ្ឋកិច្ច មួយ ផ្នែក ទៀត ក្រោម ការញុះញង់ និង ការទ្រទ្រង់ ពី ប្រទេស ធំ នៅ តំបន់ ខាងក្រៅ ហ្វីលីពីន សុខចិត្ត ធ្វើជា កូន អុក បង្ក រឿង និង ធ្វើឱ្យ ស្ថានការណ៍ សមុទ្រ ចិន ខាងត្បូង មាន ភាពច្របូកច្របល់ ក៏ ដូចជា ធ្វើ ផ្ទុយ នឹង គោលបំណង រួម របស់ តំបន់ ទាំងមូល ផងដែរ ។
សូម បញ្ជាក់ ថា ហ្វីលីពីន ជា សមាជិក នៃ ប្រទេស អាស៊ី ជា សមាជិក នៃ សមាគម អាស៊ាន ។ ដូច្នេះ ហ្វីលីពីន ពិតជា ត្រូវ ត្រឡប់ ទៅ គ្រួសារ ធំ នៅ តំបន់ អាស៊ី អាគ្នេយ៍ ជា មិន ខាន ពោលគឺ ត្រូវ ដើរ តាម ចរន្ត ប្រវតិ្តសាស្ត្រ ប្រកាន់ខ្ជាប់ យុទ្ធសាស្ត្រ ដោយ ម្ចាស់ ការ ក៏ ដូចជា គាំពារ សន្តិភាព និង ស្ថិរភាព ក្នុង តំបន់ ៕
មេបញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ ប្រជុំ ផ្សព្វផ្សាយ ផែនការ ស្តីពី កិច្ចការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ និង សង្រ្គោះ ឧបទ្ទវហេតុ ផ្សេង ៗ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី
កិច្ចប្រជុំ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក មេបញ្ជាការ រង លោក នាយ សេនាធិការ រង លោក ប្រធាន មន្ទីរ ទាំង ០៧ និង នាយ ការិយាល័យ ទាំងអស់ ចំណុះ មន្ទីរ លោក មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង / ស្រុក ទាំង ០៩ នាយ ទាហាន នៃ កងរាជអាវុធហត្ថ សរុប ចំនួន ១១៥ នាក់ ដែល ធ្វើឡើង នៅ សាល ប្រជុំ ធំ ជាន់ ទី២ អគារ សេនាធិការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ ។
ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ ត្រី វង្ស ធី បាន ផ្ដាំផ្ញើ និង សួរសុខទុក្ខ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ជូន ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ កងរាជអាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ ដោយ ក្តី នឹករលឹក ។
លោក ឧត្តមសេនីយ៍ ត្រី មេបញ្ជាការ រង ក៏ បាន ថ្លែង នូវ ការកោតសរសើរ ចំពោះ នាយ អាវុធហត្ថ ទាំងអស់ ដែល កន្លងមក បាន ចូលរួម ក្នុង កិច្ចការងារ ការពារ សន្តិសុខ សណ្ដាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ជាពិសេស ត្រៀម ការងារ ការពារ សន្តិសុខ សណ្ដាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល នឹង ឈានចូល មកដល់ ប៉ុន្មាន ថ្ងៃ ខាងមុខ នេះ ។
( ស្វាយរៀង ) ៖ នាយ ឧត្តមសេនីយ៍ ទៀ សីហា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ នៅ ព្រឹក ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ចុះ ពិនិត្យ វឌ្ឍនភាព នៅ តាម ខ្សែ បន្ទាត់ ព្រំដែន នៅ ស្រុក កំពង់រោទិ៍ និង សួរសុខទុក្ខ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៅ វរសេនា តូច លេខ ២ តំបន់ ប្រតិបត្តិការ សឹក រង ស្វាយរៀង ស្ថិត ក្នុង ភូមិ ប្រសូត្រ ឃុំ ក ណ្តៀង រាយ ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង ។
ក្នុង ដំណើរ ចុះ មក ពិនិត្យ វឌ្ឍនភាព តាម បន្ទាប់ ព្រំដែន នៃ ខេត្ត ស្វាយរៀង នេះ ក៏ មាន ការចូលរួម ពី លោក ប៉េង ពោធិ៍សា អភិបាល ខេត្ត ស្វាយរៀង និង កងកម្លាំង ទាំង បី ប្រភេទ អាជ្ញាធរដែនដី ជាច្រើន នាក់ ផងដែរ ។
សម្តេច រដ្ឋសភា ធិបតី ឃួន សុដារី ៖ រាជ រដ្ឋាភិបាល យកចិត្តទុកដាក់ លើ និវត្ត ជន និង មនុស្ស ចាស់ ទាំង សុខភាព និង ជីវភាព
( ភ្នំពេញ ) ៖ សម្តេច រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន មានប្រសាសន៍ លើកឡើង ថា រាជ រដ្ឋាភិបាល បាន បន្ត អនុវត្ត គោល នយោបាយ ជាតិ ស្តីពី មនុស្ស វ័យ ចាស់ ដោយ បន្ត ជំរុញ ការអនុវត្ត កម្មវិធី អភិវឌ្ឍ មនុស្ស វ័យ ចាស់ សកម្ម នៅ តាម សហគមន៍ និង កម្មវិធី ថែទាំ មនុស្ស ចាស់ តាម គ្រួសារ ឱ្យ បាន ប្រសើរ ។ កិច្ចការ ទាំង នេះ គឺជា ការយកចិត្តទុកដាក់ និង លើក សម្ពស់ សុខភាព មនុស្ស វ័យ ចាស់ ។
សម្តេច រដ្ឋសភា ធិបតី បាន មានប្រសាសន៍ បែប នេះ នៅក្នុង ឱកាស ជួប សំណេះសំណាល់ ជាមួយ អតី មន្រ្តី អគ្គ លេខាធិកាដ្ឋាន រដ្ឋសភា ដែល ជា និវត្ត ជន នៅ រសៀល ថ្ងៃចន្ទ ទី៨ ខែមេសា ឆ្នាំ ២០២៤ នៅ វិមាន រដ្ឋសភា ។
នៅក្នុង ឱកាស នោះ សម្តេច ប្រធាន រដ្ឋសភា បាន ថ្លែងអំណរគុណ ដល់ បងប្អូន មន្រ្តី ទាំងអស់ ជាពិសេស និវត្ត ជន ដែល បាន ខិតខំ យក អស់ កម្លាំង កាយ ចិត្ត ប្រាជ្ញា ស្មារតី ការលះបង់ និង ឆន្ទៈ មោះ មុត ក្នុង ការ បម្រើ ការងារ នា ពេល កន្លងមក ។
សម្តេច រដ្ឋសភា ធិបតី បាន គូសបញ្ជាក់ ថា និវត្ត ជន មាន គុណ បំណាច់ ច្រើន ណាស់ សម្រាប់ សង្គមជាតិ ។ គ្មាន និវត្ត ជន មិន មាន ការរីកចម្រើន ដូច សព្វ ថ្ងៃ នេះ ទេ ។ អ្វី ៗ ដែល មាន ពេល បច្ចុប្បន្ន នេះ ជា ពលីកម្ម របស់ មន្រ្តី ជំនាន់ មុន ដែល ពេលនេះ លោក បាន ក្លាយជា និវត្ត ជន និង បាន បង់ អាយុជីវិត ទៅ ហើយក្តី ។
នៅក្នុង ឱកាស ដ៍ រីករាយ និង ស្និទ្ធស្នាល នោះ សម្តេច រដ្ឋសភា ធិបតី បាន ចែករំលែក ពី សភាពការណ៍ ពិភពលោក និង សង្គមជាតិ ជូន ដល់ និវត្ត ជន បាន ជ្រាប ផងដែរ ។ សម្តេច ក៏ បាន លើកឡើង ពី ការងារ ជា ទិភាព របស់ រដ្ឋសភា នីតិកាល ទី៧ នៅក្នុង ការបម្រើ សង្គមជាតិ និង ប្រជាពលរដ្ឋ ។
មហា អំណាច លោក ខាងលិច បាន សម្តែង ការខឹងសម្បារ ចំពោះ អ្វី ដែល ពួកគេ ចាត់ទុក ថា ជា ការកើនឡើង ដែល មិន អាច ទទួលយក បាន នៅក្នុង ចំនួន អ្នកស្លាប់ របស់ ជន ស៊ីវិល ប៉ាឡេស្ទីន និង វិបត្តិ មនុស្សធម៌ នៅ តំបន់ ហ្គាហ្សា ដែល បណ្តាល មកពី ការវាយលុក របស់ យោធា អ៊ីស្រាអែល ដើម្បី បំផ្លាញ ក្រុមហា ម៉ាស នៅ តំបន់ ហ្គាហ្សា ស្ទ្រីប ដ៏ តូច មួយ ដែល មាន ប្រជាជន រស់ នៅ យ៉ាង ណែន តាន់តាប់ ។
អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស់ បាន បញ្ជូន ក្រុមការងារ របស់ ខ្លួន ទៅ ប្រទេស អេហ្ស៊ីប កាលពី ថ្ងៃអាទិត្យ បន្ទាប់ពី ការ ទៅដល់ របស់ នាយក CIA លោក William Burns កាលពី ថ្ងៃសៅរ៍ ដែល វត្តមាន របស់ គាត់ បង្ហាញ ពី សម្ពាធ កាន់តែ ខ្លាំង ឡើង របស់ អាមេរិក ក្នុង ការឈាន ដល់ កិច្ចព្រមព្រៀង ដែល នឹង ដោះលែង ចំណាប់ខ្មាំង ដែល ឃុំ ខ្លួន នៅ ហ្គាហ្សា និង ផ្តល់ ជំនួយ ដល់ ជន ស៊ីវិល ដែល រងគ្រោះ ។
គួរ ជម្រាប ថា នៅ ថ្ងៃចន្ទ ដដែល នេះ ប្រភព សន្តិសុខ អេហ្ស៊ីប ពីរ និង ប្រព័ន្ធ ផ្សព្វផ្សាយ អេហ្ស៉ី ប Al-Qahera បាន រាយការណ៍ ថា កិច្ចពិភាក្សា នៅ ទីក្រុង គែរ សម្រេចបាន ភាពរីកចម្រើន គួរឱ្យ កត់សម្គាល់ ។
អេហ្ស៉ីប កាតា និង សហរដ្ឋ អាមេរិក ដែល ជា សម្ព័ន្ធមិត្ត ដ៏ សំខាន់ របស់ អ៉ី ស្រាអែល បាន ព្យាយាម សម្របសម្រួល ក្នុង កិច្ចចរចា ជាច្រើន លើក កន្លងមក ហើយ ប៉ុន្តែ នៅ មិន ទាន់ អាច សម្រេចបាន កិច្ចព្រមព្រៀង លើ ឈប់ បាញ់ នៅឡើយ ទេ ដោយ ក្នុង នោះ លោក ណេតាន់ យ៉ាហ៊ូ អះអាង ថា នឹង មិន មាន បទ ឈប់ បាញ់ ទេ បើ មិន មាន ការដោះលែង ចំណាប់ខ្មាំង ។ ចំណែក ក្រុមហា ម៉ាស វិញ បាន ទទូច ឱ្យ អ៉ី ស្រាអែល ដក កងទ័ព ចេញពី តំបន់ ហ្កាហ្សា ៕
រដ្ឋបាល ក្រុង បាវិត ប្រារព្ធ ពិធី អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល នឹង ឈានចូល មកដល់ ពេល ខាងមុខ នេះ
( ស្វាយរៀង ) ៖ លោក ណេប សារ៉ុន ប្រធាន ក្រុមប្រឹក្សា ក្រុង បាវិត និង លោក លឹម សៀង ហេង អភិបាល ក្រុង បាវិត នា រសៀល ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២៤ នេះ បាន ដឹកនាំ មន្ត្រីរាជការ សាលាក្រុង រៀបចំ កិច្ចប្រជុំ ពង្រឹង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ដើម្បី បង្កើន ចំណង សាមគ្គីភាព មិត្តភាព ជាមួយ ស្រុក ជាប់ ព្រំដែន គឺ រវាង ក្រុង បាវិត ប្រទេស កម្ពុជា និង ស្រុក បេន កូវ និង ទី រួម ខេត្ត ត្រាង បាង ប្រទេស វៀតណាម និង ចូលរួម អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ រោង ឆស័ក ព .ស ២៥៦៧ គ. ស២០២៤ ។
លោក បាន បញ្ជាក់ ថា ក្រោម ការដឹកនាំ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ធ្វើឲ្យ កម្ពុជា មាន សុខ សន្តិភាព និង មាន ការរីកចម្រើន ឡើង គួរ ជា ទី មោទនៈ ដែល ធ្វើឲ្យ ជីវភាព របស់ ប្រជាពលរដ្ឋ មាន ភាពធូរធាល្អ ប្រសើរ ជាង មុន ។
តំណាង ឲ្យ អាជ្ញាធរ ក្រុង បាវិត សូម ថ្លែងអំណរគុណ ដល់ ភាគី ជា មិត្ត ពិសេស កងទ័ព ការពារ ព្រំដែន ម៉ុក បាយ ដែល ជានិច្ច ជាកាល តែងតែ ជួយ សម្រួល ដល់ ការលំបាក របស់ ប្រជាពលរដ្ឋ ខ្មែរ ដែល មាន ជំងឺ ហើយ ត្រូវ ឆ្លង ទៅ ព្យាបាល ជំងឺ នៅ ប្រទេស វៀតណាម និង បាន ជួយ អន្តរាគមន៍ សហការផ្តល់ រថយន្ត ពន្លត់ អគ្គីភ័យ នៅពេល មាន អគ្គីភ័យ កើតឡើង នៅ តាម ព្រំដែន ក្នុង ក្រុង បាវិត ។
លោក បាន បន្ត ថា ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ រោង ឆស័ក ព .ស ២៥៦៧ គ. ស២០២៤ ដែល នឹង ឈានចូល មកដល់ នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ក្នុង នាម អាជ្ញាធរដែនដី ក្រុង បាវិត លោក សូម ឧទ្ទិស បួងសួង ដល់ ទេវតា ឆ្នាំ ថ្មី សូម ជួយ ប្រោស ព្រំ ប្រសិទ្ធ ពរ ជ័យ សិរី មង្គល វិបុល សុខ មហា ប្រសើរ គ្រប់ ប្រការ ៕ គណៈកម្មាធិការ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ឃុំ ប្រឡាយ នាំយក អំណោយ មនុស្សធម៌ ជូន ដល់ គ្រួសារ ដែល មាន ជីវភាព ខ្វះខាត
( កំពង់ធំ )៖ លោក ម៉េង លីនណា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ឃុំ ប្រឡាយ ប៉ុស្តិ៍ រដ្ឋបាល និង មេភូមិ បាន ចុះ សាកសួរ សុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៍ ចែកជូន ប្អូន ស្រី រ៉ាន ពិសិដ្ឋ កំពុង មាន ជំងឺ រស់ នៅ មួយ ឪពុក នៅ ភូមិ តា ទ្រៀល ឃុំ ប្រឡាយ ស្រុក ស្ទោង នៅ រសៀល ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២៤ ។
លោក បាន ជំរុញ ឲ្យ ប្អូន ស្រី ត្រូវ ថែទាំ សុខភាព ឲ្យបាន ល្អ និង មាន អនាម័យ ខ្ពស់ ដោយ អនុវត្ត នៅ វិធានការ ហូប ស្អាត ផឹក ស្អាត និង រស់ នៅ ស្អាត ។
លោក បាន ជំរុញ ឲ្យ អាជ្ញាធរ មូលដ្ឋាន ពិសេស លោក មេភូមិ ត្រូវតែ តាមដាន នៅ ស្ថានភាព របស់ ប្អូន ស្រី ឬ ក៏ ក្រុមគ្រួសារ ដែល ជួប ទុក្ខលំបាក ផ្សេង ទៀត ដើម្បី ផ្ដល់ ព័ត៌មាន ដល់ អាជ្ញាធរ ឃុំ និង ក្រុមការងារ សសរ យក ក ក្នុង ការចូលរួម សហការ គ្នា ស្វែងរក មោធិសប្បុរសធម៌ ផ្សេង ៗ ទៀត ទៅ តាម លទ្ធភាព ជួយ ដល់ ពួកគាត់ ឱ្យ បាន ទាន់ ពេល វេលា ។
អគ្គ លេខាធិការ គណ:កម្មាធិការ ជាតិ ទន្លេ មេគង្គ កម្ពុ បាន ឱ្យដឹង ថា ស្ទឹង ណា ម ខាន់ (Nam Khan) ជា ដៃ នៃ ទន្លេ មេគង្គ ហូរ ចាក់ ចូល ទន្លេ មេគង្គ ត្រង់ ចំណុច ទីក្រុង លួង ព្រះបាង ហើយ មាន ចម្ងាយ ពី ព្រំប្រទល់ កម្ពុជា - ឡាវ ដល់ ទីនោះ ប្រមាណ ១.៣៧០ គីឡូម៉ែត្រ ខាងលើ ក្រុង ប៉ាក់ សេប្រមាណ ១.២២០ គីឡូម៉ែត្រ និង ខាងលើ រដ្ឋធានី វៀង ច័ន្ទ ប្រមាណ ៥០០ គីឡូម៉ែត្រ ។ នៅក្រោម ទីក្រុង លួង ព្រះបាង ចម្ងាយ ប្រមាណ ១២០ គីឡូម៉ែត្រ មាន ទំនប់ វារី អគ្គិសនី សាយា បូរី នៅលើ ដង ទន្លេ មេគង្គ ផងដែរ ។
សូម បញ្ជាក់ ថា រថយន្ត ដឹក សារធាតុ គីមី មួយ គ្រឿង បាន ក្រឡាប់ ហើយ ហៀរ ចូល ស្ទឹង ណា ម ខាន់ ភូមិ ភូសាង ខាំ ក្នុង ខេត្ត លួង ព្រះបាង ប្រទេស ឡាវ ។ សាលាក្រុង លួង ព្រះបាង បាន ហាមឃាត់ ប្រជាពលរដ្ឋ របស់ ខ្លួន មិន ឱ្យ ងូតទឹក ហែលទឹក ឬ ប្រមូល ត្រី ងាប់ ពី ស្ទឹង ណា ម ខាន់ និង ពី ទន្លេ មេគង្គ ក្នុង ទឹកដី លួង ប្រាបាង មក លក់ ឬ មក បរិភោគ ។
អាជ្ញាធរ ក្រុង បាន ណែនាំ ឱ្យ អាជ្ញាធរ ភូមិ ភូសាង ខាំ ត្រូវ ផ្តល់ ដំណឹង និង ព្រមាន អ្នកភូមិ ជា ប្រចាំ អំពី បញ្ហា នេះ ។
តាម មន្ត្រី លេខាធិការដ្ឋាន MRC ប្រចាំ នៅ ទីក្រុង វៀង ច័ន្ទ ប្រទេស ឡាវ បាន ឱ្យដឹង ថា សារធាតុ គីមី ដែល កំពប់ ហៀរ នោះ គឺ អាស៊ីត ស៊ុល ភួរិច ដែល មាន បរិមាណ សរុប ប្រហែល ៣០តោន តែ ហូរ ចូលក្នុង ទឹក មិន ទាំងអស់ ទេ ។ ករណី នេះ នាយកដ្ឋាន បរិស្ថាន ឡាវ បាន សហការ ជាមួយ ការិយាល័យ ក្រុង ហ្លួង ព្រះបាង ដើម្បី អនុវត្ត វិធានការត្រួតពិនិត្យ ដើម្បី ឆ្លើយតប ទៅនឹង ស្ថានភាព ខាងលើ នេះ ។ ទោះជា យ៉ាងណា មិន បង្ក ផល ប៉ះពាល់ ដល់ ទន្លេ មេគង្គ ផ្នែក ខាងក្រោម នោះ ឡើយ ៕
អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ទទួល សម្ភារ ផ្សព្វផ្សាយ បញ្ហា គ្រឿងញៀន ពី គ្រឹះស្ថាន ហិរញ្ញវត្ថុ អិល អូអិល ស៊ី លើក ទី ៩
ពិធី ប្រគល់ នេះ បាន ធ្វើឡើង នៅ ការិយាល័យ កណ្តាល របស់ អិល អូអិល ស៊ី ដោយ លោក សុខ វឿន ប្រធាន នាយក ប្រតិបត្តិ និង ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត ប្រធាន នាយកដ្ឋាន ផ្សព្វផ្សាយ អប់រំ និង ទំនាក់ទំនង សាធារណ: នៃ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ។
លោក សុខ វឿន ប្រធាន នាយក ប្រតិបត្តិ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ អិល អូអិល ស៊ី មាន បាន ថា « ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ជា ការងារ រួម របស់ យើង ទាំងអស់ គ្នា ដោយ មិន អាច ចាត់ទុក ជា ការងារ ផ្តាច់ មុខ របស់ នរណា ម្នាក់ ឬ ក្រុម ណាមួយ ឡើយ ការដោះស្រាយ គឺ ត្រូវ ផ្តើម ពី យើង ទាំងអស់ គ្នា ការលុបបំបាត់ គ្រឿងញៀន ជា បញ្ហា រួម ចម្បង ដែល យើង គ្រប់ គ្នា ត្រូវ ចូលរួម ដោះស្រាយ ដើម្បី បញ្ចៀស គ្រោះថ្នាក់ និង នាំមហន្តរាយ ដល់ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គមជាតិ » ។
លោក បាន សំណូមពរ ឱ្យ អ្នក ពាក់ព័ន្ធ ទាំងអស់ និង ប្រជាពលរដ្ឋ គ្រប់ រូប រួម សហការ គ្នា ដើម្បី បង្ការ ទប់ស្កាត់ ការរីករាលដាល បញ្ហា គ្រឿងញៀន ដែល នាំឲ្យ បំផ្លាញ សហគមន៍ ។ លោក បាន បន្ថែម ទៀត ថា អិល អូអិល ស៊ី នឹង បន្ត គាំទ្រ ដល់ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន យ៉ាង ពេញ ទំហឹង ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ។
សូម បញ្ជាក់ ថា នេះ ជា លើក ទី៩ ហើយ ដែល អិល អូអិល ស៊ី LOLC ផ្តល់ ជូន អគ្គ លេខាធិការដ្ឋាន នៃ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន នូវ សម្ភារ ផ្សព្វផ្សាយ គ្រឿងញៀន ដែល នេះ ឆ្លុះបញ្ចាំង ពី ការប្តេជ្ញាចិត្ត របស់ អិល អូអិល ស៊ី (LOLC) ក្នុង ការបន្ត ចូលរួម ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន នៅ កម្ពុជា ៕ នាយ ឧត្តមសេនីយ៍ សឹង សំណាង អញ្ជើញ កាត់ ឫស្ស សីមា ព្រះវិហារ និង សម្ពោធ ឆ្លង សមិទ្ធផល នានា ក្នុង វត្ត ព្រះរាម រង្សី
លោក អភិបាល ស្រុក បាន ឱ្យដឹង ថា វត្ត ព្រះរាម រង្សី មាន ប្រវត្តិ យូរ លង់ មកហើយ ដោយ ផ្ដើម កសាង តាំងពី ឆ្នាំ ១៩១០មក ម៉្លេះ ហើយ ជា វត្ត ដែល មាន ព្រះចៅ អធិការ ជាច្រើន អង្គ បាន ចូលរួម កសាង តាម ដំណាក់កាល នីមួយ ៗ រហូតដល់ ឆ្នាំ ១៩៧៥ - ១៩៧៩ វត្ត នេះ ត្រូវបាន ពួក ខ្មែរ ក្រហម ឈូសឆាយ កម្ទេច ចាប់ ផ្សឹក ព្រះសង្ឃ និង ធ្វើ ទារុណកម្ម យ៉ាង ព្រៃផ្សៃ ។
ទី វត្តអារាម នៅ ទីនេះ ត្រូវបាន កកើត ឡើងវិញ ក្រោយ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ក្រោម ការដឹកនាំ របស់ រណសិរ្ស សាមគ្គី សង្គ្រោះ ជាតិ កម្ពុជា និង គណបក្ស ប្រជាជន កម្ពុជា ។ ពេល នោះ ប្រជាពលរដ្ឋ បាន រួមគ្នា បោស សំអាត ទី វត្តអារាម និង មាន ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ចូលរួម ធ្វើ បុណ្យ ទាន ឡើងវិញ ដើម្បី ស្ដារ និង កសាង សមិទ្ធិផល ក្នុង វត្ត ឡើងវិញ ជា បន្តបន្ទាប់ ។
រហូតដល់ ឆ្នាំ ២០០៩ ទើប មាន ការចាប់ផ្តើម ក សាង ព្រះវិហារ ថ្មី ។ ព្រះវិហារ នៅក្នុង វត្ត ព្រះរាម រង្សី បាន កើតឡើង ដោយសារ កិច្ចសហការ គាំទ្រ ពី អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ និង ពុទ្ធ សាសនិក បាន រួមគ្នា ជា កម្លាំង ចលករ ធ្វើឱ្យ វត្ត បាន រីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។ ផ្អែក តាម របាយការណ៍ ការកសាង ព្រះវិហារ បាន ចំណាយ ថវិកា ប្រមាណ ២២០. ៦៨៦ ដុល្លារ ។
នាយ ឧត្តមសេនីយ៍ បណ្ឌិត សឹង សំណាង បាន ពាំនាំ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ និង ក្តី នឹក រឮ ក យ៉ាង ជ្រាលជ្រៅ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា និង ជា ប្រធាន ក្រុមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោកជំទាវ បណ្ឌិត ប្រគេន ព្រះសង្ឃ គ្រប់ ព្រះអង្គ និង ជូន ចំពោះ អាជ្ញាធរដែនដី ប្រជាពលរដ្ឋ ដែល មាន វត្តមាន ក្នុង ខេត្ត កំពង់ឆ្នាំង ។
នាយ ឧត្តមសេនីយ៍ បណ្ឌិត បាន កោតស សើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ព្រះទ័យ ផ្តួចផ្តើម និង ការខិតខំ ប្រឹងប្រែង របស់ ព្រះអង្គ ព្រះចៅ អធិការ គ្រប់ ជំនាន់ ព្រះថេរានុត្ថេរៈ គ្រប់ ព្រះអង្គ សប្បុរសជន និង ពុទ្ធ បរិស័ទ ទាំងអស់ ដែល ផ្តល់ ការជឿជាក់ ដោយ បាន បរិច្ចាគ ធនធាន និង ថវិកា តាម សទ្ធា ជ្រះថ្លា រួម សាមគ្គី កសាង ព្រះវិហារ ថ្មី ក្នុង វត្ត ព្រះរាម រង្សី សម្រាប់ ទុក ជាទីគោរព ប្រណិប័តន៍ ។
នាយ ឧត្តមសេនីយ៍ សឹង សំណាង ចាត់ទុក សមិទ្ធផល ទាំងនេះ បង្ហាញ ឱ្យ ឃើញ ពី ការយកចិត្តទុកដាក់ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង មិន អាច ផ្ដាច់ បាន ពី ការខិតខំ ប្រឹងប្រែង និង ការចូលរួមចំណែក យ៉ាង សស្រាក់សស្រាំ ពី ពីសំណាក់ ថ្នាក់ដឹកនាំ ស្ថាប័ន ក្រុមការងារ រាជ រដ្ឋាភិបាល មន្ត្រី រដ្ឋបាល ខេត្ត ព្រះសង្ឃ ឧបាសក ឧបាសិកា ប្រជាពលរដ្ឋ ដែល បាន រួម សាមគ្គី គ្នា បរិច្ចាគ ទ្រព្យសម្បត្តិ ផ្ទាល់ខ្លួន ដើម្បី កសាង សមិទ្ធផល ទាំងនេះ ។
នាយ ឧត្តមសេនីយ៍ បណ្ឌិត សឹង សំណាង បាន រំលឹក ប្រជាពលរដ្ឋ ឱ្យ បាន ដឹង ពី ប្រវត្តិ នៃ ដំណើរ ប្រទេស កម្ពុជា ដែល បាន ឆ្លងកាត់ ពី ដំណាក់កាល នីមួយ ៗ រហូតដល់ ឆ្នាំ ១៩៧០ ទី អារាម បាន ក្លាយជា គោលដៅ នៃ ការវាយប្រហារ ទម្លាក់ គ្រាប់បែក ពីលើ អាកាស និង បំផ្លិចបំផ្លាញ ជីវិត ប្រជាជន កម្ពុជា ទៀតផង ។ ជាពិសេស ក្នុង របប ប៉ុល ពត បាន ប្រល័យ ជីវិត មនុស្ស យ៉ាង ព្រៃផ្សៃ ក្នុង នោះ វត្ត ព្រះរាម រង្សី ក៏ ត្រូវបាន យក ធ្វើជា កន្លែង កាប់ សម្លាប់ ប្រជាជន ស្លូតត្រង់ ផងដែរ ។
តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្ដេច តេជោ ហ៊ុន សែន រួម ជាមួយ ការដឹកនាំ អនុវត្ត គោល នយោបាយ ជាច្រើន ដំណាក់កាល ធ្វើឱ្យ កម្ពុជា សម្រេចបាន ការផ្លាស់ប្ដូរ មុខមាត់ ថ្មី ប្រែក្លាយ ខ្លួន ពី ប្រទេស មាន សោកនាដកម្ម នៃ សង្គ្រាម មក ជា ប្រទេស មាន សន្តិភាព ការឯកភាព ជាតិ ពេញលេញ មាន បេះដូង មនុស្សធម៌ មាន កេរ្ដិ៍ ឈ្មោះ ល្អ ល្បីរន្ទឺ លើ ឆាក អន្តរជាតិ ។
នាយ ឧត្តមសេនីយ៍ សឹង សំណាង បាន គូស រំលេច ថា រាជ រដ្ឋាភិបាល កម្ពុជា អាណត្តិ ទី៧ ដឹកនាំ ដោយ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជា រាជ រដ្ឋាភិបាល បន្ត វេន បាន ខិតខំ ប្រឹងប្រែង បន្ត អភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ។
នាយ ឧត្តមសេនីយ៍ បណ្ឌិត សឹង សំណាង បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ពង្រឹង សុខដុមនីយកម្ម រវាង គ្រប់ សាសនា នៅ កម្ពុជា រាំង ស្កាត់ ការ ធ្វើ អាជីវកម្ម លើ សាសនា ប្រឆាំង ការរើសអើង បែងចែក ប្រជាជន ដែល មាន ភាពខុសគ្នា ខាង ជំនឿ និង សាសនា សំដៅ ប្រែក្លាយ សក្ដានុពល សាសនា ទាំងអស់ ទៅជា កម្លាំង សាមគ្គី ជាតិ តែ មួយ ដ៏ ខ្លាំងក្លា ក្នុង ការកសាង សន្តិភាព ឯកភាព ជាតិ ។
ជាមួយគ្នា នេះ រាជ រដ្ឋាភិបាល បាន ចាត់តាំង ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ក្រុង ស្រុក ដើម្បី ចូលរួម គាំទ្រ និង ជំរុញ ការអនុវត្ត កម្មវិធី នយោបាយ យុទ្ធសាស្ត្រ បញ្ចកោណ ផែនការ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ ជាតិ គោល នយោបាយ និង កម្មវិធី កំណែទម្រង់ នានា របស់ រាជ រដ្ឋាភិបាល ឲ្យបាន សកម្ម ផល ផុស នៅ តាម មូលដ្ឋាន និង ការដោះស្រាយ ឆ្លើយតប សំណូមពរ និង តម្រូវការ របស់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន នីមួយ ៗ ប្រកបដោយ ប្រសិទ្ធិភាព តម្លាភាព ដោយ ផ្អែក លើ ច្បាប់ និង លិខិត បទដ្ឋាន ជាធរមាន ។
ឆ្លៀត ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ សឹង សំណាង បាន សម្ដែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ អាជ្ញាធរដែនដី កងកម្លាំងប្រដាប់អាវុធ គ្រប់ លំដាប់ថ្នាក់ ដែល បាន រួមគ្នា ខិតខំ ការពារ សន្តិភាព សន្តិសុខ សណ្ដាប់ធ្នាប់ ក្នុង មូលដ្ឋាន តាម ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ទទួលបាន ជោគជ័យ កន្លងមក នេះ ។
នៅក្នុង ពិធី កាត់ ឫស្ស សីមា ដ៏ រីករាយ នោះ នាយ ឧត្តមសេនីយ៍ បណ្ឌិត សឹង សំណាង បាន ប្រគេន បច្ច័យ ព្រះសង្ឃ ២៨ អង្គ និង ជូន ថវិកា ចំពោះ លោកគ្រូ អ្នកគ្រូ ចំនួន ២៧ នាក់ សិស្ស ចំនួន ២៣០ នាក់ ជូន កម្លាំងប្រដាប់អាវុធ និង កម្លាំង មាន សមត្ថកិច្ច ចំនួន ៦៧ នាក់ ដូន ជីតា ជី ចំនួន ៥០ នាក់ សរុប ថវិកា ចំនួន ១២.៨៦០.០០០ រៀល ៕
ខុទ្ទកាល័យ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បង្ហាញ លទ្ធផល ជំនួប រវាង សម្តេច ធិបតី ជាមួយ ឯក អគ្គ រដ្ឋទូត អូស្ត្រាលី
លោក ចាស្ទីន ខេវិន វ៉ាយ អេត បាន បញ្ចប់ ការងារ ជា ឯក អគ្គ រដ្ឋទូត នៅ កម្ពុជា ហើយ ជំនួប ជាមួយ សម្តេច ធិបតី នា រសៀល ថ្ងៃ នេះ គឺជា ការចូល ជម្រាប លា ។
ក្នុង ជំនួប ជម្រាប លា នេះ លោក ចាស្ទីន ខេវិន វ៉ាយ អេត បាន ថ្លែងអំណរគុណ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ដែល បាន ឆ្លៀត ពេលវេលា ដ៏ មមាញឹក អនុញ្ញាតឱ្យ រូប លោក និង សហការី ជួប សម្តែង ការគួរសម និង ជម្រាប លា ។ ឯក អគ្គ រដ្ឋទូត ចប់ អាណត្តិ រូប នេះ បាន វាយតម្លៃ ខ្ពស់ អំពី ទំនាក់ទំនង ដ៏ ល្អ រវាង អូស្រ្តាលី - កម្ពុជា ហើយក៏ បាន សម្តែង ការអរគុណ ចំពោះ ការគាំទ្រ និង កិច្ចសហប្រតិបត្តិការ របស់ ក្រសួង ស្ថាប័ន របស់ កម្ពុជា ក្នុង ការរឹត ចំណង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ នា ពេល កន្លងមក ។
លោក ឯក អគ្គ រដ្ឋទូត ក៏ បាន គោរព ជម្រាប ជូន សម្តេច ធិបតី អំពី វឌ្ឍនភាព លើ កិច្ចសហប្រតិបត្តិការ ដែល សម្តេច ធិបតី និង នាយក រដ្ឋមន្ត្រី អូស្រ្តាលី បាន ពិភាក្សា ថ្មី ៗ នេះ នៅ ប្រទេស អូស្រ្តាលី ។ ទន្ទឹម គ្នា នោះ លោក ឯក អគ្គ រដ្ឋទូត ក៏ បាន ជម្រាប សម្តេច ធិបតី អំពី ការបន្ត គាំទ្រ លើ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អប់រំ តាមរយៈ ការបន្ត ផ្តល់ អាហារូបករណ៍ បន្ថែម ដល់ និស្សិត កម្ពុជា និង ការភ្ជាប់ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង សាកលវិទ្យាល័យ អូស្ត្រាលី និង សាកលវិទ្យាល័យ នានា របស់ កម្ពុជា ។
លោក ចាស្ទីន ខេវិន វ៉ាយ អេត ក៏ បាន បញ្ជាក់ ជំហរ បន្ត កិច្ចសហប្រតិបត្តិការ នៃ ប្រទេស ទាំង ពីរ លើ វិស័យ អាទិភាព មួយចំនួន រួម មាន៖ កសិកម្ម ការវិនិយោគ ពាណិជ្ជកម្ម ហេដ្ឋារចនាសម្ព័ន្ធ ថាមពល បៃតង និង ការពារ ជាតិ និង សន្តិសុខ ។
សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ បេសកកម្ម ការ ទូត របស់ លោក ចាស្ទីន ខេវិន វ៉ាយ អេត ព្រមទាំង បាន សម្តែង ក្តីរីករាយ ចំពោះ វឌ្ឍនភាព លើ កិច្ចសហប្រតិបត្តិការ ដែល សម្តេច និង លោក នាយក រដ្ឋមន្រ្តី អូស្រ្តាលី បាន ពិភាក្សា គ្នា នា ពេល កន្លងមក ។
សម្តេច ធិបតី បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការគាំទ្រ លើ វិស័យ អាទិភាព និង លើ កិច្ចសហប្រតិបត្តិការ ពីសំណាក់ ប្រទេស អូស្រ្តាលី ។ ពាក់ព័ន្ធ នឹង វិស័យ វិនិយោគ និង ពាណិជ្ជកម្ម សម្តេច ធិបតី បាន ប្រកាស ប្រឹងប្រែង ជំរុញ ការតភ្ជាប់ រវាង វិស័យ ឯកជន និង ឯកជន ហើយ មាន ជំនឿ ជាក់ ថា ការភ្ជាប់ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ នឹង កាន់តែ ប្រសើរឡើង ដើម្បី ផ្តល់ ផលប្រយោជន៍ ទៅ វិញ ទៅមក សម្រាប់ ប្រជាជន ។
ចំពោះ វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ និង ថាមពល បៃតង វិញ សម្តេច ធិបតី បាន គូសបញ្ជាក់ អំពី កិច្ចប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្នុង ការជំរុញ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ និង ការអភិវឌ្ឍ ថាមពល បៃតង ដោយ លើកកម្ពស់ ការចូលរួម របស់ វិស័យ ឯកជន លើ ការអភិវឌ្ឍ និង ការវិនិយោគ លើ វិស័យ ទាំងនេះ ។
ក្នុង ក្របខ័ណ្ឌ វិស័យ ការពារ ជាតិ និង សន្តិសុខ សម្តេច ធិបតី បាន បញ្ជាក់ ពី ការបន្ត ការផ្សារ ភ្ជាប់ ទំនាក់ទំនង នៃ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ការពារ ជាតិ និង សន្តិសុខ កម្ពុជា - អូស្រ្តាលី តាមរយៈ ការជំរុញ ការបណ្តុះបណ្តាល និង ការកសាង សមត្ថភាព ជាដើម ។
សម្តេច ធិបតី និង លោក ឯក អគ្គ រដ្ឋទូត ក៏ បាន ផ្លាស់ប្តូរ យោបល់ គ្នា អំពី កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ក្នុង ការចូលរួមចំណែក ថែរក្សា នូវ សុខ សន្តិភាព និង វិបុលភាព នៅក្នុង តំបន់ និង អន្តរជាតិ ទាំង ក្នុង ក្របខ័ណ្ឌ ទ្វេ ភាគី និង ពហុ ភាគី ផងដែរ ៕ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ ថ្លែងអំណរគុណ ប្រធាន គណៈកម្មាធិការ ជាតិ នៃ សភា ប្រឹក្សា នយោបាយ ប្រជាជន ចិន ដែល បាន ផ្ញើ សារ អបអរសាទរ ជូន សម្តេច ក្នុង ឱកាស ជាប់ ឆ្នោត ជា ប្រធាន ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ព្រឹទ្ធសភា បាន ផ្ញើ សារ ឆ្លើយតប និង ថ្លែងអំណរគុណ លោក វាំង ហ៊ុយ នឹង ប្រធាន គណៈកម្មាធិការ ជាតិ នៃ សភា ប្រឹក្សា នយោបាយ ប្រជាជន ចិន (CPPCC) ដែល បាន ផ្ញើ សារ សម្តែង ការអបអរសាទរ ជូន សម្តេច ក្នុង ឱកាស ជាប់ ឆ្នោត ជា ប្រធាន ព្រឹទ្ធសភា នីតិកាល ទី៥ ។ លោកស្រី បណ្ឌិត ជា សិរី៖ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី នឹង បន្ត ជំរុញ វត្ត អារាម ឲ្យ ក្លាយជា មជ្ឈមណ្ឌល នៃ ជីវភាព ខាង ស្មារតី
( កំពង់ធំ )៖ លោកស្រី បណ្ឌិត ជា សិរី អគ្គ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល ក្នុង អាណត្តិ ថ្មី នឹង បន្ត លើកស្ទួយ ព្រះពុទ្ធ សាសនា ជា សាសនា របស់ រដ្ឋ នឹង បន្ត ខិតខំ ធ្វើឱ្យ ទី វត្តអារាម ក្លាយជា មជ្ឈមណ្ឌល នៃ ជីវភាព ខាង ស្មារតី ដែល ចូលរួម យ៉ាង សកម្ម ក្នុង ការអភិវឌ្ឍ សង្គមជាតិ ខាង ផ្នែក វប្បធម៌ អប់រំ សុខាភិបាល សង្គមកិច្ច និង សីលធម៌ សង្គម ។
ការលើកឡើង របស់ លោកស្រី បណ្ឌិត ជា សិរី ធ្វើឡើង ក្នុង ពិធី បុណ្យ សម្ភោធ ឆ្លង ឧបដា្ឋន សាលា ពុទ្ធាភិសេក និង សមិទ្ធផល នានា ក្នុង វត្ត មុនី រតនា រាម ( ហៅ វត្ត ល្អក់ ) ស្ថិត នៅ ឃុំ កំពង់ថ្ម ស្រុក សន្ទុក ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២៤ ។
លោកស្រី បណ្ឌិត បន្ត ថា សមិទ្ធផល សម្រេច បាន ទាំងអស់ នេះ កើតឡើង ដោយសារ ការខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្នុង ការរក្សា បាន សន្តិភាព ពេញលេញ និង ស្ថិរភាព នយោបាយ ពុទ្ធ ចក្រ និង អាណាចក្រ ត្រូវ ដើរ ទន្ទឹម គ្នា ពឹង គ្នា និង ជួយ ទំនុកបម្រុង គ្នា ទៅ វិញ ទៅ មក ជាក់ស្តែង ពុទ្ធ ចក្រ ជួយ ផ្នែក ស្មារតី ផ្នែក ខាង ទស្សនវិជ្ជា ដោយសារ មាន ពុទ្ធ ចក្រ ទើប អាណាចក្រ អាច រុងរឿង បាន ។
