ដំណើរទស្សនកិច្ច ផ្លូវការ របស់ នាយក រដ្ឋមន្រ្តី ឡាវ ផន ខាំ វី ផាវ៉ាន់ នៅ កម្ពុជា ក្នុង អំឡុង ពេល ដែល កម្ពុជា កំពុង បើក ប្រទេស ឡើងវិញ នឹង រួមចំណែក ក្នុង ការបន្ត ពង្រឹង បន្ថែម ទៀត នូវ ចំណង មិត្តភាព ជា ប្រពៃណី ដ៏ យូរអង្វែង សាមគ្គីភាព ជា ភាតរភាព ភាពជា អ្នកជិតខាង ល្អ ដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ និង យូរអង្វែង និង កិច្ចសហប្រតិបត្តិការ ដ៏ ជិតស្និទ្ធ រវាង ប្រទេស ទាំង ពីរ ក៏ ដូចជា ជំរុញ កិច្ចសហប្រតិបត្តិការ នៅក្នុង ក្របខ័ណ្ឌ អាស៊ាន ដើម្បី សន្តិភាព ស្ថិរភាព និង វិបុលភាព នៅក្នុង តំបន់ និង ពិភពលោក ។
សូម ជំរាប ថា ពិធី ជប់លៀង ជូន នាយក រដ្ឋមន្រ្តី ឡាវ ធ្វើឡើង ក្រោយពី បញ្ចប់ ជំនួប ទ្វេ ភាគី រវាង សម្តេច តេជោ ហ៊ុន សែន និង លោក ផាន់ ខាំ វី ផាវ៉ាន់ នាយក រដ្ឋមន្ត្រី ឡាវ នៅ វិមាន សន្តិភាព នា ល្ងាច ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ។
នៅក្នុង ជំនួប សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ផ្ដល់ ជំនួយ ចំនួន ១៣លាន ដុល្លារ និង វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ៥០ ម៉ឺន ដូស បន្ថែម ទៀត ដល់ រដ្ឋាភិបាល និង ប្រជាជន ឡាវ ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។ ថវិកា ៣លាន ដុល្លារ របស់ រាជ រដ្ឋាភិបាល និង ១០លាន ដុល្លារ របស់ ក្រុមហ៊ុន ឯកជន ។
សូម បញ្ជាក់ ថា នៅក្នុង ជំនួប ពិភាក្សា ការងារ នេះ លោក ផន ខាំ វី ផាវ៉ាន់ នាយក រដ្ឋមន្ត្រី ឡាវ បាន អបអរសាទរ កម្ពុជា ដែល ទទួលបាន ជោគជ័យ លើ ការគ្រប់ វិស័យ មាន ដូចជា ការធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ កំពូល អាស៊ី - អឺរ៉ុប និង ការទទួល ធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ កំពូល អាស៊ាន នា ឆ្នាំ ២០២២ ខាងមុខ ។ ពាក់ព័ន្ធ ការធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ កំពូល អាស៊ាន នេះ លោក នាយក រដ្ឋមន្ត្រី ឡាវ បាន សន្យា សហការ ជាមួយ កម្ពុជា ជួយ កម្ពុជា ឱ្យ ទទួលបាន ជោគជ័យ លើ ការធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ កំពូល អាស៊ាន នេះ ។
បើ តាម លោក អ៊ាង សុផល្លែត នៅក្នុង ជំនួប នេះ លោក នាយក រដ្ឋមន្ត្រី ឡាវ ក៏ បាន ស្នើ សម្ដេច តេជោ បន្ត ពង្រឹង ពង្រីក កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ។ ជាពិសេស គឺ ការបន្ត កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី គ្នា ទៅ វិញ ទៅ មក ដើម្បី បញ្ចប់ បញ្ហា នៃ ការព្រមព្រៀង គ្នា ជា ពេល កន្លងមក ។ ជាពិសេស ការចរចា គ្នា នឹង ពិភាក្សា គ្នា ធ្វើ យ៉ាងណា បញ្ចប់ កិច្ចព្រមព្រៀង កិច្ចសហប្រតិបត្តិការ ក្នុង ភាពជាដៃគូ គ្រប់ ជ្រុងជ្រោយ ។
លោក នាយក រដ្ឋមន្ត្រី ឡាវ ក៏ បាន ជំរុញ ឲ្យ គណៈកម្មការ ចម្រុះ ព្រំដែន នៃ ប្រទេស ទាំង ពីរ បន្ត ធ្វើ យ៉ាងណា សម្រេច ការងារ ព្រំដែន ដូច ដែល បាន កំណត់ ។ លោក ផន ខាំ វិផាវ៉ាន់ ក៏ បាន ស្នើ ជំរុញ កិច្ចសហប្រតិបត្តិការ លើ ការធ្វើ ពាណិជ្ជកម្ម ទ្វេ ភាគី និង ពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អប់រំ វប្បធម៌ និង លើ វិស័យ ទេសចរណ៍ ផ្សេង ទៀត ។ លោក នាយក រដ្ឋមន្ត្រី ឡាវ ក៏ បាន ស្នើ ជំរុញ ការវិនិយោគ នៅឡាវ ផងដែរ ។
សម្រាប់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី កម្ពុជា វិញ បាន ស្នើសុំ ឱ្យ នាយក រដ្ឋមន្ត្រី ឡាវ ធ្វើ យ៉ាងណា ឲ្យ ប្រជាជន ទាំង ពីរ អាច ធ្វើដំណើរ ទៅ វិញ ទៅ មក ដើម្បី ដោះដូរ ពាណិជ្ជកម្ម តាម ព្រំដែន ។ សម្ដេច តេជោ បាន បង្ហាញ ការគាំទ្រ ការលើកឡើង ក្នុង ការជំរុញ ពាណិជ្ជកម្ម ទ្វេ ភាគី ដោយ ជំរុញ ការវិនិយោគ ប្រទេស ទាំង ពីរ គាំទ្រ វិនិយោគិន ប្រទេស ទាំង ពីរ ព្រោះ ការវិនិយោ គ គឺជា ជា មូលដ្ឋាន ក្នុង ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ ទាំង ផ្នែក នយោបាយ សេដ្ឋកិច្ច ជាដើម ។
សម្តេច តេជោ ហ៊ុន សែន ថ្លែងអំណរគុណ នាយក រដ្ឋមន្រ្តី ឡាវ ដែល គាំទ្រ កម្ពុជា ធ្វើជា ប្រធាន អាស៊ាន និង បាន ចូលរួម កិច្ចប្រជុំ ASEM13
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ដូចនេះ នា ល្ងាច ថ្ងៃទី ទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ នៅក្នុង ឱកាស ទទួល បដិសណ្ឋារកិច្ច និង មាន ជំនួប ទ្វេ ភាគី ជាមួយ លោក ផន ខាំ វី ផាវ៉ាន់ ដែល បាន មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ។
សូម បញ្ជាក់ ថា កិច្ចប្រជុំ កំពូល អាស៉ី - អឺរ៉ុប លើក ទី ១៣ (ASEM13) ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ បាន ប្រព្រឹត្តទៅ រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៥ - ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២១ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ៥១ ប្រទេស និង ២ស្ថាប័ន តំបន់ ( សហភាព អឺរ៉ុប និង លេខាធិការដ្ឋាន អាស៊ាន ) ជា ដៃគូ តាម ប្រព័ន្ធ វីដេអូ ដោយ កិច្ចប្រជុំ នេះ បាន ប្រព្រឹត្តទៅ បាន ដោយ រលូន និង ជោគជ័យ ។
ជាមួយគ្នា នេះ ដែរ ប្រទេស កម្ពុជា នៅ ឆ្នាំ ២០២២ ខាងមុខ នេះ និង ធ្វើជា ប្រធាន អាស៊ាន ផងដែរ ៕ នាយក រដ្ឋមន្ត្រី កម្ពុជា ស្នើ នាយក រដ្ឋមន្ត្រី ឡាវ ឲ្យ ប្រជាជន អាច ធ្វើដំណើរ ទៅ វិញ ទៅ មក
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ស្នើ ដល់ លោក ផាន់ ខាំ វី ផាវ៉ាន់ នាយក រដ្ឋមន្ត្រី ឡាវ ក្នុង ការពិចារណា ឲ្យ ប្រជាជន ប្រទេស ទាំង ពីរ អាច ធ្វើដំណើរ ទៅ វិញ ទៅមក បាន ។ ការស្នើ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង ក្នុង ជំនួប ពិភាក្សា ការងារ ទ្វេ ភាគី នៅ វិមាន សន្តិភាព នា ល្ងាច ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ។
កម្ពុជា បាន ប្រកាស បើក ប្រទេស ទទួល ទេសចរណ៍ អន្តរជាតិ ចាប់ពី ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ។ ក្នុង នោះ អ្នក ដែល មិន បាន ចាក់ វ៉ាក់សាំង គឺ តម្រូវឲ្យ ធ្វើចត្តាឡី ស័ក ៧ ថ្ងៃ ខណៈ អ្នក ដែល បាន ចាក់ វ៉ាក់សាំង មិន តម្រូវឲ្យ ធ្វើចត្តាឡី ស័ក នោះ ទេ តែ ភ្ញៀវ ទេសចរ ទាំងអស់ ត្រូវ ធ្វើតេស្ត CPR ចំនួន ៧២ ម៉ោង មុន ហើយ ពេល មកដល់ ច្រកទ្វារ ព្រំដែន កម្ពុជា ត្រូវ ធ្វើតេស្ត រហ័ស សិន ។
ក្នុង ជំនួប ទ្វេ ភាគី នេះ ដែរ លោក ផន ខាំ វិផាវ៉ាន់ ក៏ បាន ស្នើ ជំរុញ កិច្ចសហប្រតិបត្តិការ លើ ការធ្វើ ពាណិជ្ជកម្ម ទ្វេ ភាគី និង ពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អប់រំ វប្បធម៌ និង លើ វិស័យ ទេសចរណ៍ ផ្សេង ទៀត ។ លោក នាយក រដ្ឋមន្ត្រី ឡាវ ក៏ បាន ស្នើ ជំរុញ ការវិនិយោគ នៅឡាវ ផងដែរ ។
បើ តាម លោក អ៊ាង សុផល្លែត . សម្រាប់ វិស័យ វិនិយោគ សម្តេច តេជោ ហ៊ុន សែន បាន គាំទ្រ ជំរុញ ឲ្យ មាន ការវិនិយោគិន រវាង ប្រទេស ទាំង ពីរ ព្រោះថា ការវិនិយោគ នេះ ជា មូលដ្ឋាន សម្រាប់ ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ ទាំង ផ្នែក នយោបាយ សេដ្ឋកិច្ច ជាដើម ៕ លោក គង់ វិបុល ថ្វាយ សារ លិខិត ចូលរួម រំលែក ព្រះមរណទុក្ខ ចំពោះ ការយាង ចូល ព្រះទិវង្គត របស់ សម្តេច ក្រុម ព្រះ នរោត្តម រណ ឫទ្ធិ
( ភ្នំពេញ ) ៖ លោក គង់ វិបុល រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ នា ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ បាន ថ្វាយ សារ លិខិត ចូលរួម រំលែក ព្រះមរណទុក្ខ ទូល ថ្វាយ ព្រះអង្គម្ចាស់ក្សត្រិយ៍ នរោត្តម ម៉ារី រណឫទ្ធិ និង ព្រះរាជ បុត្រា បុត្រី ព្រះអង្គម្ចាស់ក្សត្រិយ៍ ចំពោះ ការយាង ចូល ព្រះទិវង្គត របស់ សម្តេច ក្រុម ព្រះ នរោត្តម រណ ឫទ្ធិ ព្រះប្រធាន គណបក្ស ហ៊្វុនស៉ិន ប៉ិច និង ជា ព្រះប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ។
យោង តាម សារ លិខិត រំលែក ទុក្ខ របស់ លោក គង់ វិបុល បាន បញ្ជាក់ ថា « ទូលព្រះបង្គំ និង ក្រុមគ្រួសារ មាន ក្តី ក្តុកក្តួល រំជួល ចិត្ត ឥត ឧបមាដោយ បាន ទទួល ដំណឹង ថា សម្តេច ក្រុម ព្រះ នរោត្តម រណ ឫទ្ធិ ព្រះប្រធាន គណបក្ស ហ៊្វុនស៊ិនប៉ិច និង ជា ព្រះប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ទ្រង់ សោយព្រះទិវង្គត នៅ ថ្ងៃអាទិត្យ ៩រោច ខែកត្តិក ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស .២៥៦៥ ត្រូវនឹង ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ក្នុង ព្រះជន្មាយុ ៧៧ ព្រះវស្សា ដោយ ព្រះរោគា ពាធ ។
រាជ រដ្ឋាភិបាល និង ឧកញ៉ា ល្បី ៗ ៦រូប នៅ កម្ពុជា បរិច្ចាក ថវិកា ១៣លាន ដុល្លារ ដល់ មិត្ត ឡាវ ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា និង ឧកញ៉ា ល្បី ឈ្មោះ របស់ កម្ពុជា ចំនួន ៦រូប បាន រួមគ្នា បរិច្ចាគ ថវិកា សរុប ចំនួន ១៣លាន ដុល្លារ ជូន ដល់ រដ្ឋាភិបាល ឡាវ ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស ឡាវ ។ ក្នុង រាជ រដ្ឋាភិបាល ចំនួន ៣លាន ដុល្លារ ក្រុមហ៊ុន ឯកជន ល្បី ៗ ចំនួន ១០លាន ដុល្លារ ។
អភិបាល ខេត្ត កំពត ចុះ សួរសុខទុក្ខ ប្រជាពលរដ្ឋ និង អាជីវករ នៅ ស្រុក ជុំ គិរី
( កំពត ) ៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត នា ព្រឹក ថ្ងៃទី ២៩ ខែ វិច្ឆិកា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ មន្ត្រី នៃ ស្ថាប័ន កងកម្លាំង និង អាជ្ញាធរ ពាក់ព័ន្ធ ចុះ សំណេះសំណាល និង សាកសួរ សុខទុក្ខ បងប្អូន កូនក្មួយ ដែល បាន មក ពិនិត្យ ផ្ទៃពោះ និង បាន សម្រាល កូន នៅ មណ្ឌល សសុខភាព ត្រពាំង រាំង និង បន្ត ជួប សំណេះសំណាល ជាមួយ អាជីវករ ក្នុង ផ្សារ ជុំ គីរី ស្ថិត ក្នុង ភូមិ ត្រពាំង វែង ឃុំ ត្រពាំង រាំង ស្រុក ជុំ គីរី ខេត្ត កំពត ។
ក្នុង ឱកាស ជួប សំណេះសំណាល នោះ លោក ម៉ៅ ធ និន បាន ណែនាំ ដល់ អ្នកគ្រប់គ្រង ផ្សារ និង អាជ្ញាធរ ស្រុក មិន ត្រូវ យក ថ្លៃ ភាស៊ី តម្លៃ លើស សៀវភៅ បន្ទុក ឬ ចំពោះ ប្រជាពលរដ្ឋ ដែល មាន វ័យ ចំណាស់ និង ប្រជាពលរដ្ឋ ដែល ដាក់ លក់ តាម កញ្ច្រែង ល្អី តូច ៗ នោះ ទេ ហើយ ត្រូវ ធ្វើ យ៉ាងណា សម្រួល ទីតាំង ឱ្យ ពួកគាត់ លក់ដូរ បាន ល្អ ប្រសើរ ផងដែរ ។
ម្យ៉ាង វិញ ទៀត អ្នកគ្រប់គ្រង ផ្សារ និង អាជ្ញាធរ ត្រូវ ធ្វើ យ៉ាងណា រក្សា ការពារ សន្តិសុខ សុវត្ថិភាព ជូន ដល់ ប្រជាពលរដ្ឋ ក៏ ដូចជា អាជីវករ លក់ដូរ ឱ្យ បាន ល្អ ដើម្បី ជៀសវាង ការបាត់បង់ នូវ ទ្រព្យសម្បត្តិ ឬ ធ្វើឱ្យ មាន គ្រោះថ្នាក់ ផ្សេង ៗ បង្ករ ឱ្យ មាន ភាពភ័យខ្លាច ដល់ ប្រជាពលរដ្ឋ និង អាជីវករ ។ ពិសេស ត្រូវ រៀបចំ ប្រព័ន្ធ ខ្សែភ្លើង ដែល មាន ភាព រញ៉េរញ៉ៃ កាត់ ពី ខាងលើ ដំបូល ផ្សារ ឱ្យ មាន សណ្តាប់ធ្នាប់ និង សុវត្ថិភាព ឱ្យ បាន ល្អ ឆាប់ បំផុត ជៀសវាង នាំឱ្យ កើតឡើង នូវ អគីភ័យ ផ្សេង ៗ នៅក្នុង ផ្សារ ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ប្រកាស ផ្ដល់ ជំនួយ ចំនួន ១៣លាន ដុល្លារ និង វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ៥០ ម៉ឺន ដូស បន្ថែម ទៀត ដល់ រដ្ឋាភិបាល និង ប្រជាជន ឡាវ ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។ ថវិកា ៣លាន ដុល្លារ របស់ រាជ រដ្ឋាភិបាល និង ១០លាន ដុល្លារ របស់ ក្រុមហ៊ុន ឯកជន ។
យោង តាម លោក អ៊ាង សុផល្លែត បាន គូសបញ្ជាក់ ថា ថវិកា ដែល សម្តេច តេជោ ប្រកាស ជួយ ដល់ ប្រទេស ឡាវ នេះ ៣លាន ដុល្លារ ជា ថវិកា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង ១០លាន ដុល្លារ ទៀត គឺជា ថវិកា របស់ សប្បុរសជន កម្ពុជា ។
សូម បញ្ជាក់ ផងដែរ ថា ពាក់ព័ន្ធ ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នេះ កាលពី ឆ្នាំ ២០២០ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ផ្តល់ ជំនួយ មនុស្សធម៌ ជា ម៉ាស់ ២លាន ម៉ាស់ និង បរិក្ខារ វេជ្ជសាស្ត្រ ចំនួន ១១មុខ ផ្សេង ទៀត ជូន រដ្ឋាភិបាល ឡាវ ។ កាពី ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០២១ កម្ពុជា បាន ផ្តល់ ជំនួយ ជា វ៉ាក់សាំង ប្រភេទ ស៊ីណូ វ៉ាក់ ចំនួន ២០ម៉ឺន ដូស ដល់ ឡាវ ផងដែរ ៕ កិត្តិ សេដ្ឋា បណ្ឌិត ជា ម យៀប ថ្វាយ សារ ចូលរួម រំលែក ព្រះមរណទុក្ខ ចំពោះ ការយាង ចូល ព្រះទិវង្គត របស់ សម្តេច ក្រុម ព្រះ នរោត្តម រណ ឫទ្ធិ
( ភ្នំពេញ ) ៖ លោក កិត្តិ សេដ្ឋា បណ្ឌិត ជា ម យៀប អនុប្រធាន ទី១ រដ្ឋសភា នា ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ បាន ថ្វាយ សារ លិខិត ចូលរួម រំលែក មរណទុក្ខ ទូល ថ្វាយ ព្រះអង្គម្ចាស់ក្សត្រិយ៍ នរោត្តម ម៉ារី រណឫទ្ធិ និង ព្រះរាជ បុត្រា បុត្រី ព្រះអង្គម្ចាស់ក្សត្រិយ៍ ចំពោះ ការយាង ចូល ព្រះទិវង្គត របស់ សម្តេច ក្រុម ព្រះ នរោត្តមរណឫទ្ធិ ព្រះប្រធាន គណបក្ស ហ៊្វុនស៉ិន ប៉ិច និង ជា ព្រះប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ។
( ភ្នំពេញ ) ៖ ដើម្បី រួមចំណែក ក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ តាមរយៈ ការពន្លឿន យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ក្នុង ក្រុម ដែល នៅ តាម តំបន់ គោលដៅ ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ នៃ ប្រទេស ជប៉ុន (JICA) បាន ប្រគល់ ជូន ធុង ត្រជាក់ ផ្ទុក វ៉ាក់សាំង ចល័ត ចំនួន ២០០ និង ទែ ម៉ូម៉ែត សម្រាប់ ផ្ទុក ទិន្នន័យ សីតុណ្ហភាព ចំនួន ២០០ គ្រឿង ជូន ឃ្លាំង ស្តុក ឱសថ កណ្តាល នៃ ក្រសួង សុខាភិបាល ។
សេចក្តីប្រកាស ព័ត៌មាន របស់ JICA បាន បញ្ជាក់ ថា ការប្រគល់ និង ទទួលបាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ តាមរយៈ គម្រោង កិច្ចសហប្រតិបត្តិការ បច្ចេកទេស « គម្រោង ពង្រឹង សមត្ថភាព ឆ្លើយតប នឹង ជំងឺ កូវីដ១៩ ក្នុង ប្រទេស កម្ពុជា » ។
ទីភ្នាក់ងារ JICA នឹង បន្ត សហការ ជាមួយ ក្រសួង សុខាភិបាល ក្នុង ការផ្តល់ នូវ ឧបករណ៍ និង ការគាំទ្រ ផ្នែក បច្ចេកទេស ចាំបាច់ ផ្សេង ៗ ទៀត ក្នុង កំឡុង ពេល ដ៏ លំបាក នៃ ជំងឺ រាតត្បាត នេះ ។ JICA សង្ឃឹម ថា ការគាំទ្រ ទាំង នេះ នឹង អាច ជួយ ដល់ បុគ្គលិក សុខាភិបាល ដែល បាន នឹង កំពុង ខិតខំ ប្រឹងប្រែង យ៉ាង ខ្លាំង ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ៕ លោក គង់ គាំ ថ្លែង កោតសរសើរ លោក កឹម សុខា ដែល ព្រមាន ចំៗ ឱ្យ សម រង្ស៉ី ឈប់ យក រូប និង ឈ្មោះ លោក ទៅ គេង ចំណេញ នយោបាយ
កាលពី ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២១ លោក កឹម សុខា បាន ប្រកាស ថា ខ្លួន លោក និង សម រង្ស៉ី មិន មែន ជា មនុស្ស តែ មួយ ទៀត ទេ និង ព្រមាន ចំៗ ទៅកាន់ លោក សម រង្ស៉ី មេច លនា ឧទ្ទាម ក្រៅ ច្បាប់ ឱ្យ ឈប់ យក រូប និង ឈ្មោះ របស់ លោក ទៅ ប្រើប្រាស់ ធ្វើ សកម្មភាព បម្រើ មហិច្ឆតា នយោបាយ របស់ ខ្លួន តទៅទៀត ដែល ធ្វើឲ្យ សាធារណមតិ ជាតិ និង អន្តរជាតិ មាន ការភាន់ច្រឡំ ។ នេះ ជា លើក ដំបូង ដែល លោក ព្រមាន ចំឈ្មោះ លោក សម រង្ស៉ី ចាប់តាំងពី សម្ព័ន្ធ ភាគី ទាំង ពីរ បាន បែក ខ្ញែក ក្រោយ ការរំលាយ គណបក្ស សង្រ្គោះ ជាតិ
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ បាន ប្រោសប្រទាន ព្រះរាជ សារលិខិត ចូលរួម រំលែក ព្រះមរណទុក្ខ ជូន ព្រះអង្គម្ចាស់ នរោត្តម ចក្រាវុឌ្ឍ
និង ព្រះអង្គម្ចាស់ក្សត្រា ព្រះអង្គម្ចាស់ក្សត្រី ជា ព្រះបុត្រា ព្រះបុត្រី សម្តេច ក្រុម ព្រះ នរោត្តម រណ ឫទ្ធិ ព្រះប្រធាន គណបក្ស ហ៊្វុនស៊ិនប៉ិច និង ជា ព្រះប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ចំពោះ ការយាង ចូល ព្រះទិវង្គត របស់ ព្រះអង្គ ។
ការយាង ចូល ព្រះទិវង្គត នៃ សម្តេច ក្រុម ព្រះ នរោត្តម រណឫទ្ធិ គឺជា ការបាត់បង់ ព្រះបិតា ដ៏ ល្អ ប្រពៃ មួយ ព្រះអង្គ ដែល ជាទីគោរព ស្រឡាញ់ នៃ ព្រះបុត្រា ព្រះបុត្រី ព្រមទាំង ព្រះញាតិ វង្សានុវង្ស និង ញាតិមិត្ត ទាំងពួង និង ជា ការបាត់បង់ ព្រះឥស្សរជន ដ៏ ប្រពៃ មួយ ព្រះអង្គ ដែល មាន ស្នា ព្រះហស្ត និង ព្រះគុណ បំណាច់ ដ៏ ធំធេង ក្នុង ការបម្រើ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
« ខ្ញុំ សូម បួងសួង សូម ព្រះវិញ្ញាណក្ខន្ធ សម្តេច ក្រុម ព្រះ នរោត្តម រណ ឫទ្ធិ យាង ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។ សូម ព្រះអង្គម្ចាស់ក្សត្រា ព្រះអង្គម្ចាស់ក្សត្រី ទទួល នូវ សេចក្តីស្រឡាញ់ រាប់អាន អំពី ខ្ញុំ » ។ នេះ ជា ព្រះរាជ តម្រាស់ បន្ថែម របស់ ព្រះមហាក្សត្រ ។
ការផ្ដល អនុសាសន៍ ខាងលើ នៅ ថ្ងៃចន្ទ សប្ដាហ៍ នេះ ( ម៉ោង នៅ វ៉ាស៊ីនតោន ) បាន កើតឡើង បន្ទាប់ពី និយតករ សុខាភិបាល អាមេរិក កាលពី សប្តាហ៍ មុន បាន ពង្រីក សិទ្ធិ ទទួលបាន ការចាក់ វ៉ាក់សាំង ដូស ជំរុញ ដល់ មនុស្ស ពេញ វ័យ គ្រប់ រូប ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ទៅ ៤៩ ឆ្នាំ ។
បើ តាម CDC មនុស្ស ពេញ វ័យ ប្រហែល ៤៧លាន នាក់ ដែល មិន ទាន់ បាន ទទួល ការចាក់ វ៉ាក់សាំង ត្រូវបាន លើកទឹកចិត្ត ឱ្យ ទៅ ទទួល ការចាក់ វ៉ាក់សាំង ឱ្យ បាន ឆាប់ តាម ដែល អាច ធ្វើ ទៅ បាន រីឯ កុមារ និង ក្មេង វ័យ ជំទង់ គួរតែ ត្រូវ ទទួល ការចាក់ វ៉ាក់សាំង ផងដែរ ដើម្បី កាត់បន្ថយ ឱកាស នៃ ការឆ្លង ជាមួយនឹង ការធ្លាក់ខ្លួន ឈឺ ធ្ងន់ធ្ងរ ។
ជំនួយ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ចំនួន ៥០ ម៉ឺន ដូស និង រថយន្ត ដឹក វ៉ាក់សាំង ចំនួន ២គ្រឿង ដែល ជា ទឹកចិត្ត សប្បុរស របស់ កម្ពុជា ក្នុង ការជួយ ដល់ ប្រទេស ឡាវ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នឹង ត្រូវ ប្រគល់ ដល់ រដ្ឋាភិបាល ឡាវ នា ព្រឹក ថ្ងៃសុក្រ ទី ០៣ ខែធ្នូ ឆ្នាំ ២០២១ ខាងមុខ នេះ ។ នេះ បើ តាម លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ។
ពិធី ប្រគល់ វ៉ាក់សាំង ធ្វើឡើង នៅ ព្រំដែន កម្ពុជា - ឡាវ ចំណុច ព្រំប្រទល់ ខេត្ត ស្ទឹងត្រែង ដោយ ភាគី កម្ពុជា ដឹកនាំ ដោយ លោក ស្រ្តាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល អម ដោយ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង ៕
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២១ បាន បង្ហោះ សារ អបអរសាទរ ខួប៥ ឆ្នាំ នៃ ការដាក់បញ្ចូល ចា ប៉ី ដង វែង ក្នុង បញ្ជី បេតិកភណ្ឌ វប្បធម៌ អរូបី នៃ មនុស្សជាតិ របស់ អង្គការ យូណេស្កូ ( ៣០ វិច្ឆិកា ២០១៦ - ៣០ វិច្ឆិកា ២០២១) ។
លើស ពី នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន អំពាវនាវ ដល់ កូន ខ្មែរ គ្រប់ រូប ត្រូវ ចេះ ស្រឡាញ់ ថែរក្សា ការពារ នូវ សម្បត្តិ បេតិកភណ្ឌ ដ៏ មាន តម្លៃ របស់ ជាតិ និង ពិភពលោក ទាំងមូល ។
គួរ បញ្ជាក់ ថា សម្បត្តិ បេតិកភណ្ឌ បេតិកភណ្ឌ ខ្មែរ ទាំង៨ ដែល ត្រូវបាន ចុះ បញ្ជី សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក រួម មាន៖
អាកាសចរណ៍ អន្តរជាតិ ទាំង តូច ទាំង ធំ នៅលើ ពិភពលោក បាន ចាត់ វិធានការ ភ្លាម ៗ កាលពី សប្តាហ៍ មុន ដើម្បី តាមដាន លើ អ្នកដំណើរ មកពី ប្រទេស អាហ្វ្រិក ខាងត្បូង ដែល ត្រូវបាន គេ ដឹង ថា ជា អ្នក រកឃើញ វីរុស បំប្លែង ថ្មី Omicron នេះ មុន គេ ។ ការចាត់ វិធានការ ភ្លាម ៗ នេះ គឺ ត្រូវបាន ចាត់ទុក ថា ជា ការរួមចំណែក ជួយ ទប់ទល់ នៅក្នុង ដំណាក់កាល បឋម ដើម្បី កុំ ឲ្យ វីរុស ថ្មីន នេះ រីករាលដាល ទៅ ប្រទេស ផ្សេង ៗ ទៀត ។
ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ថ្វាយ សារ លិខិត ចូលរួម រំលែក ព្រះរាជ មរណទុក្ខ ចំពោះ ការយាង ចូល ទិវង្គត របស់ សម្តេច ក្រុម ព្រះ
( ភ្នំពេញ ) ៖ លោក កិត្តិនីតិកោសល បណ្ឌិត អ៉ឹម ឈុន លឹម ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ និង ភរិយា ព្រមទាំង សមាជិក សមាជិកា ក្រុមប្រឹក្សា ធម្មនុញ្ញ មន្ត្រីរាជការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ មាន សេចក្តីក្រៀមក្រំ ដ៏ ក្រៃលែង ចំពោះ ការយាង ចូល ទិវង្គត របស់ សម្តេច ក្រុម ព្រះ នរោត្តម រណ ប្ញទ្ធិ ព្រះប្រធាន គណបក្ស ហ្វ៊ុន ស៊ិនប៉ិច និង ជា ព្រះប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ។
ក្នុង ឱកាស ដ៏ ក្រៀមក្រំ នេះ លោក កិត្តិនីតិកោសល បណ្ឌិត អ៉ឹម ឈុន លឹម ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ និង ភរិយា ព្រមទាំង សមាជិក សមាជិកា ក្រុមប្រឹក្សា ធម្មនុញ្ញ មន្ត្រីរាជការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ចូលរួម ព្រះមរណទុក្ខ ជាមួយ ព្រះអង្គម្ចាស់ក្សត្រិយ៍ និង ព្រះបុត្រា - បុត្រី ព្រមទាំង រាជ វង្សានុវង្ស និង សូម ឧទ្ទិស បួងសួង សូមបដិសន្ធិ ព្រះវិញ្ញាណក្ខន្ធ សម្តេច ក្រុមព្រះ នរោត្តម រណប្ញទ្ធិ ទ្រង់ បាន យាង ទៅកាន់ ព្រះសុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ព្រឹក នេះ រដ្ឋមន្ដ្រី ក្រសួង រ៉ែ និង ថាមពល កម្ពុជា - ឡាវ ជួប ពិភាក្សា ការងារ អំឡុង បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា
ជំនួប នេះ ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង រ៉ែ និង ថាមពល ។
ការប្រកាស ផ្តល់ ជំនួយ ជា ថវិកា និង វ៉ាក់សាំង នេះ បាន ធ្វើឡើង នៅក្នុង ជំនួប ពិភាក្សា ការងារ ទ្វេ ភាគី រវាង សម្តេច តេជោ ហ៊ុន សែន និង លោក ផាន់ ខាំ វី ផាវ៉ាន់ នាយក រដ្ឋមន្ត្រី ឡាវ នៅ វិមាន សន្តិភាព នា ល្ងាច ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ៕
ក្រសួង បាន បញ្ជាក់ ថា ព្រះរាជាណាចក្រ កម្ពុជា ទទួល ឥទ្ធិពល ពី ទ្រនុង សម្ពាធ ខ្ពស់ ប្រទេស ចិន ដែល បន្ត រំកិល ចុះ មក ក្រោម ជាមួយនឹង ខ្យល់ មូសុង ឦសាន បង្កើន ល្បឿន ក្នុង កម្រិត ពី មធ្យម ទៅ បង្គួរ ។
ជាមួយគ្នា នេះ ក្រសួង ធនធាន ទឹក អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ ការធ្លាក់ចុះ នៃ សីតុណ្ហភាព ត្រជាក់ នេះ ៕ ថ្ងៃ នេះ ជា ថ្ងៃ ចុងក្រោយ នៃ ការពិនិត្យ និង ចុះឈ្មោះ បោះឆ្នោត ! សូម ពលរដ្ឋ ខ្មែរ គ្រប់ អាយុ បោះឆ្នោត អញ្ជើញ ទៅ ចុះឈ្មោះ បោះឆ្នោត
( ភ្នំពេញ ) ៖ ការចុះឈ្មោះ បោះឆ្នោត មាន សារសំខាន់ ខ្លាំង ណាស់ សម្រាប់ ប្រជាពលរដ្ឋ ដើម្បី មាន សិទ្ធិ ចូលរួម ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់ នា ឆ្នាំ ២០២២ និង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នា ឆ្នាំ ២០២៣ ។
ប្រសិនបើ មិន បាន ចុះឈ្មោះ ក្នុង បញ្ជី ឈ្មោះ បោះឆ្នោត ដែល រៀបចំ ដោយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) ទេ នោះ ប្រជាពលរដ្ឋ ខ្មែរ ទាំង ពីរ ភេទ មិន មាន សិទ្ធិ ចូលរួម បោះឆ្នោត នោះ ឡើយ ។
សម្រាប់ ការឆ្នាំ ២០២១ នេះ គ.ជ. ប ចាប់ផ្តើម ពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ចាប់ពី ថ្ងៃទី ១២ ខែតុលា ដល់ ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ដែល មាន រយៈពេល ៥០ ថ្ងៃ ។ គិត ត្រឹម ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ ជា ថ្ងៃ ចុងក្រោយ នៃ ដំណើរការ ពិនិត្យ និង ចុះឈ្មោះ បោះឆ្នោត ។
គ.ជ. ប បាន ប្រកាស ថា ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត នេះ ធ្វើឡើង រៀងរាល់ ថ្ងៃ រួមទាំង ថ្ងៃសៅរ៍ និង ថ្ងៃអាទិត្យ ផងដែរ ។ ពេលព្រឹក ធ្វើ ការចាប់ពី ម៉ោង ៧៖០០ នាទី ដល់ ម៉ោង ១១៖៣០ នាទី និង ពេល រសៀល ចាប់ពី ម៉ោង ២៖០០ នាទី ដល់ ម៉ោង ៥៖៣០ នាទី នៅ តាម សាលា ឃុំ - សង្កាត់ និង ទីតាំង មួយចំនួន ក្នុង ឃុំ - សង្កាត់ ។
ដើម្បី ចុះឈ្មោះ បោះឆ្នោត បាន ប្រជាពលរដ្ឋ មាន សញ្ជាតិ កម្ពុជា ទាំង ពីរ ភេទ ត្រូវ បំពេញ តាម លក្ខខណ្ឌ ដូច ខាងក្រោម៖
+ ក៖ ប្រជាពលរដ្ឋ ខ្មែរ រស់ នៅក្នុង ឃុំ សង្កាត់ ដែល មាន អាយុ យ៉ាងតិច ១៨ ឆ្នាំ គិត ដល់ ថ្ងៃ បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ( ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២២ ) គឺ កើត មុន ឬ ត្រឹម ថ្ងៃទី ៦ ខែមិថុនា ឆ្នាំ ២០០៤ ហើយ ដែល មិន ទាន់ មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត នៃ ឃុំ សង្កាត់ ដែល ខ្លួន កំពុង រស់ នៅ ទាំងអស់ អាច សុំ ចុះឈ្មោះ បោះឆ្នោត បាន ។
+ ខ៖ ដើម្បី ចុះឈ្មោះ បោះឆ្នោត ប្រជាពលរដ្ឋ ខ្មែរ ត្រូវ ទៅ ជួប ដោយ ផ្ទាល់ ជាមួយ ក្រុម ចុះឈ្មោះ បោះឆ្នោត ដោយ យក អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ទៅ បង្ហាញ ដល់ ប្រធាន ក្រុម ចុះឈ្មោះ បោះឆ្នោ ត៖
* បើ អាសយដ្ឋាន ក្នុង អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ស្ថិត នៅក្នុង ឃុំ - សង្កាត់ ដែល ប្រជាពលរដ្ឋ កំពុង រស់ នៅ និង សុំ ចុះ ឈ្មាះ ត្រូវ គ្នា នោះ ក្រុម ចុះឈ្មោះ បោះឆ្នោត នឹង រៀបចំ ចុះឈ្មោះ ជូន តាម នីតិវិធី របស់ គ.ជ. ប
* បើ អាសយដ្ឋាន ក្នុង អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ខុសពី ឃុំ - សង្កាត់ ដែល ប្រជាពលរដ្ឋ សុំ ចុះឈ្មោះ នោះ ប្រជាពលរដ្ឋ ត្រូវ យក បន្ថែម នូវ សៀវភៅ គ្រួសារ ឬ សៀវភៅ ស្នាក់ នៅ ឬ លិខិត បញ្ជាក់ ទីលំនៅ ក្នុង ឃុំ - សង្កាត់ ដែល ស្នើសុំ ចុះឈ្មោះ ។
* ការធ្វើ លិខិត បញ្ជាក់ ទីលំនៅ ត្រូវ ធ្វើ នៅ ឃុំ - សង្កាត់ ទៅ តាម ប្រកាស របស់ ក្រសួង មហាផ្ទៃ ដែល តម្រូវ ឱ្យ មាន អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ និង លិខិត អនុញ្ញាតឱ្យ ស្នាក់ នៅ បណ្តោះអាសន្ន ( ក៩ ) និង សាក្សី ម្នាក់ ដែល ជា ប្រជាពលរដ្ឋ មាន សិទ្ធិ បោះឆ្នោត ក្នុង ឃុំ សង្កាត់ ជាមួយគ្នា ។
* ក្នុង ករណី ប្រជាពលរដ្ឋ គ្មាន អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ នោះ ប្រជាពលរដ្ឋ ត្រូវ ទៅ ជួប មេឃុំ ឬ ចៅសង្កាត់ ដើម្បី ស្នើសុំ ឯកសារ បញ្ជាក់ អត្ត - សញ្ញាណ បម្រើ ឱ្យ ការចុះឈ្មោះ បោះឆ្នោត ដោយ ត្រូវ នាំ ទៅ ជាមួយ នូវ សំបុត្រ បញ្ជាក់ កំណើត ឬ ឯកសារ បញ្ជាក់ ពី សញ្ជាតិ រូបថត ៣x៤ ចំនួន ០២ សន្លឹក និង សាក្សី ០២ រូប ដែល មាន សិទ្ធិ បោះឆ្នោត ក្នុង ឃុំ - សង្កាត់ ជាមួយគ្នា ( សាក្សី ត្រូវតែ មិន មែន ជា សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ( កបឃ .ស ) មេឃុំ ចៅសង្កាត់ ជំទប់ ចៅសង្កាត់ រង ឬ ស្មៀន ឃុំ - សង្កាត់ ) ។
+ គ៖ បើ ប្រជាពលរដ្ឋ មិន បាន បំពេញ តាម លក្ខខណ្ឌ ដូច បាន ជម្រាប ជូន ខាងលើ ទេ នោះ ប្រធាន ក្រុម ចុះឈ្មោះ បោះឆ្នោត នឹង សម្រេច បដិសេធ ការស្នើសុំ ចុះឈ្មោះ ដោយ ចេញ ទម្រង់ បដិសេធ ១០០៩ ហើយ ប្រជាពលរដ្ឋ ដែល ត្រូវបាន បដិសេធ អាច ប្តឹង ទៅ ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ក្នុង រយៈពេល យ៉ាង យូរ ៣ ថ្ងៃ បន្ទាប់ពី ថ្ងៃ បាន ទទួល ទម្រង់ បដិសេធ ១០០៩ ហើយ នីតិវិធី ត្រូវ ធ្វើ បន្តបន្ទាប់ តាម ច្បាប់ បោះឆ្នោត រហូតដល់ ក្រុមប្រឹក្សា ធម្មនុញ្ញ ។
សូម បញ្ជាក់ ថា គ.ជ. ប តែង បាន រៀបចំ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ជារៀងរាល់ ឆ្នាំ ដើម្បី ផ្តល់ ឱកាស ឱ្យ ពលរដ្ឋ មាន អាយុ គ្រប់ ១៨ ឆ្នាំ អាច ចូលរួម បោះឆ្នោត បាន ។ សម្រាប់ ឆ្នាំ ២០២១ នេះ គ.ជ. ប មាន ផែនការចុះឈ្មោះ អ្នកបោះឆ្នោត ថ្មី ចំនួន ១. ៦៣៥. ៩៩០ នាក់ និង លុប ឈ្មោះ ចេញ ពី បញ្ជី បោះឆ្នោត ចំនួន ៨៣. ០៤៣ នាក់ ៕
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ២២ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៤.១៣៧ . ៦៤២ នាក់ ។ ក្នុង រួម មាន៖
លោកស្រី ពុំ ចន្ទីនី អញ្ជើញ ជា អធិបតីភាព ក្នុង កិច្ចប្រជុំ បូកសរុប សកម្មភាព ការងារ អភិវឌ្ឍន៍ ធនធាន អ្នកស្ម័គ្រចិត្ត និង យុវជន កក្រក ឆ្នាំ ២០២១ និង លើក ទិសដៅ បន្ត ឆ្នាំ ២០២២
( ភ្នំពេញ ) ៖ លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ នៃ កាកបាទ ក្រហម កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បើក កិច្ចប្រជុំ បូកសរុប សកម្មភាព ការងារ អភិវឌ្ឍន៍ ធនធាន អ្នកស្ម័គ្រចិត្ត និង យុវជន កក្រក ឆ្នាំ ២០២១ និង លើក ទិសដៅ បន្ត ឆ្នាំ ២០២២ ។
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង នៅ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក ពិត ចំណាន អនុប្រធាន អចិន្ត្រៃយ៍ ក្រុមការងារ ទ្រទ្រង់ សកម្មភាព យុវជន និង អ្នកស្ម័គ្រចិត្ត និង ជា សមាជិក គណៈកម្មាធិការ កណ្តាល ក ក្រក . អគ្គ លេខាធិការ រង ទាំង២ រួមទាំង ថ្នាក់ដឹកនាំ ក្រុមការងារ យុវជន និង អ្នកស្ម័គ្រចិត្ត កក្រក នៃ សាខា ទាំង ២៥ រាជធានី ខេត្ត ។
នៅក្នុង កិច្ចប្រជុំ នេះ លោកស្រី ពុំ ចន្ទីនី ក៏ បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សួរ សុខ ទុក្ខ និង ក្តី នឹករលឹក ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប្រធាន ដែល ជា ប្រធាន ក្រុមការងារ ទ្រទ្រង់ សកម្មភាព យុវជន និង អ្នកស្ម័គ្រចិត្ត កក្រក ដើម្បី អភិវឌ្ឍ កម្លាំង ចលករ ទាំង ពីរ ក្រុម នេះ និង តែងតែ ឧបត្ថម្ភ គាំទ្រ ដោយ ឥត សំចៃ ទាំង កម្លាំង កាយ និង កម្លាំងចិត្ត ។
ជាង នេះ ទៅ ទៀត ក្នុង រយៈពេល ២ឆ្នាំ នេះ ២០២០ - ២០២១ មិន ថា ការចម្លង វីរុស កូវីដ១៩ ខ្លាំងក្លា យ៉ាងណា ក៏ អ្នកស្ម័គ្រចិត្ត និង យុវជន កក្រក នៅតែ អាច រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការទប់ស្កាត់ ការចម្លង វីរុស កូវីដ - ១៩ ដោយ ការលះបង់ កម្លាំង កាយ - ចិត្ត ចូលរួម ធ្វើ ការផ្សព្វផ្សាយ ចំណេះដឹង អំពី ការការពារ ខ្លួន កុំ ឱ្យ ឆ្លង មេរោគ ពី ខ្នង ផ្ទះ១ ទៅ ខ្នង ផ្ទះ ១ ពី ក្រុម ១ទៅ ក្រុម ១ទៀត ដោយ ចាប់ផ្តើម តាំងពី ចំណេះដឹង មូលដ្ឋាន រហូត សារ យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល ។
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រសួង សុខាភិបាល បាន ចេញ សេចក្តីសម្រេច ហាមឃាត់ អ្នកដំណើរ ពី ប្រទេស ចំនួន ១០ នៅ ទ្វីប អាហ្រ្វិក ឬ មាន ប្រវត្តិ ធ្វើដំណើរ ទៅកាន់ ប្រទេស ទាំង១០ នៅក្នុង ពេល ៣សប្តាហ៍ នេះ បើ យោង តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន មុន នេះ បន្តិច នា យប់ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ។
