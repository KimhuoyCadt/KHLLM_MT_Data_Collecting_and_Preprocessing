( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បន្ត បញ្ជាក់ ជាថ្មី ពី ការប្តេជ្ញាចិត្ត របស់ ខ្លួន ក្នុង ការលើកកម្ពស់ ទំនាក់ទំនង រវាង បណ្តា ប្រទេស មហាសមុទ្រ ឥណ្ឌា និង សមាគម ប្រជាជាតិ អាស៉ី អាគ្នេយ៍ ( អាស៊ាន ) ជាពិសេស ពេល កម្ពុជា ធ្វើជា ប្រធាន អាស៊ាន នៅ ឆ្នាំ ក្រោយ ។
នេះ ជា ការលើកឡើង របស់ លោក អ៊ុច បូរ រិទ្ធ រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ កម្ពុជា ពេល ថ្លែង សុន្ទរកថា សន្និសីទ មហាសមុទ្រ ឥណ្ឌា លើក ទី៥ នៅ ទីក្រុង អាប៊ុយ ដាប៊ី ប្រទេស អារ៉ាប់ រួម នៅ ថ្ងៃទី ០៤ - ០៥ ខែធ្នូ ឆ្នាំ ២០២១ ។
លោក បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ខ្ញុំ សូម បញ្ជាក់ ឡើងវិញ នូវ ការប្តេជ្ញាចិត្ត ដ៏ មុតមាំ របស់ កម្ពុជា ក្នុង ការលើកកម្ពស់ ទំនាក់ទំនង ទៅ វិញ ទៅ មក រវាង បណ្ដា ប្រទេស មហាសមុទ្រ ឥណ្ឌា និង អាស៊ាន ជាពិសេស នៅ ពេល ដែល កម្ពុជា នឹង ទទួល តួនាទី ដ៏ សំខាន់ ជា ប្រធាន អាស៊ាន ចាប់ពី ខែមករា ឆ្នាំ ២០២២ ដើម្បី យើង ទាំងអស់ គ្នា អាច កសាង ភាពសុខដុមរមនា សន្តិភាព ចីរភាព និង វិបុលភាព សម្រាប់ តំបន់ ទាំងមូល » ។
ពាក់ព័ន្ធ នឹង ប្រធានបទ ខាងលើ នេះ ដែរ បើ តាម លោក អ៊ុច បូរ រិទ្ធ បាន ថ្លែង ទៀត ថា មហាសមុទ្រ ឥណ្ឌា គឺជា ទីតាំង ផ្លូវ សមុទ្រ សំខាន់ ៗ ដែល តភ្ជាប់ មជ្ឈឹម បូព៌ា អាហ្វ្រិក និង អាស៊ី បូព៌ា ជាមួយ អឺរ៉ុប និង អាមេរិក ។ ផ្លូវ សមុទ្រ សំខាន់ ៗ អស់ ទាំងនេះ បាន សម្រួល ដល់ ការធ្វើ ពាណិជ្ជកម្ម តាម សមុទ្រ នៅក្នុង តំបន់ មហាសមុទ្រ ឥណ្ឌា ផ្ទុក ប្រេង លើស ពី ពាក់កណ្តាល នៃ ពិភពលោក និង ជា ម្ចាស់ ផ្ទះ កំពង់ផែ ចំនួន ២៣ ក្នុង ចំណោម កំពង់ផែ កុងតឺន័រ កំពូល ទាំង ១០០ នៅក្នុង ពិភពលោក ។
ដោយ វិបត្តិ កូវីដ - ១៩ ត្រូវបាន គេ រំពឹង ថា នឹង មាន ភាពធូស្រាល ក្នុង ពេល ដ៏ ខ្លី ខាងមុខ នោះ លោក អ៊ុច បូរ រិទ្ធ បាន ថ្លែង ជា ទស្សនៈ បន្ថែម ថា ការលើកកម្ពស់ ប្រក្រតីកម្ម នៃ លំហូរ ពាណិជ្ជកម្ម ធុរកិច្ច និង ការវិនិយោគ ស្រប តាម ការផ្លាស់ប្តូរ ពិភពលោក គឺជា កិច្ចការ សំខាន់ និង បន្ទាន់ សំដៅ ស្តារ និង លើកកម្ពស់ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច នៅក្នុង តំបន់ មហាសមុទ្រ ឥណ្ឌា ។
« ពាណិជ្ជកម្ម អន្តរជាតិ គឺជា ក្បាល ម៉ាស៉ីន សំខាន់ មួយ សម្រាប់ ជំរុញ កំណើន សេដ្ឋកិច្ច និង បង្កើត ការងារ ជូន ប្រជាជន ។ ជាមួយនឹង និន្នាការ នៃ ផ្លាស់ប្តូរ នៅក្នុង ពាណិជ្ជកម្ម និង ខ្សែ ច្រវាក់ ផ្គត់ផ្គង់ សកល ខ្ញុំ យល់ឃើញ ថា តំបន់ មហាសមុទ្រ ឥណ្ឌា ត្រូវ យកចិត្តទុកដាក់ បន្ថែម ទៀត ចំពោះ ការគាំទ្រ ប្រព័ន្ធ ពាណិជ្ជកម្ម ពហុ ភាគី ជាពិសេស ការពង្រឹង បន្ថែម ទៀត នូវ សេរីភាវូបនីយកម្ម ពាណិជ្ជកម្ម » ។ នេះ បើ តាម លោក អ៊ុច បូរ រិទ្ធ ។
លើស ពី នេះ ការសម្រប ខ្លួន ទៅនឹង ភាពធម្មតា ថ្មី នឹង ជំរុញ កាន់តែ ខ្លាំង ដល់ ការចាប់ យក បច្ចេកវិទ្យា ឌីជីថល សម្រាប់ ការអភិវឌ្ឍន៍ ឧស្សាហកម្ម និង ការធ្វើ ឧស្សាហូបនីយកម្ម សេដ្ឋកិច្ច ។ អាស្រ័យ ហេតុ នេះ ត្រូវតែ ធ្វើ ការរួមគ្នា ដើម្បី ជំរុញ បដិវត្តន៍ ឧស្សាហកម្ម ទី ៤ ឱ្យ ដល់ កម្រិត អតិបរមា ដើម្បី បង្កើត សសរ ស្តម្ភ កំណើន ថ្មី មួយ ប្រកបដោយ ភាពធន់ ៕ មនុស្ស ៥នាក់ ស្លាប់ ក្រោយ កម្លាំង សន្តិសុខ មីយ៉ាន់ម៉ា បើក រថយន្ត បំបុក ក្រុម បាតុករ នៅ ទីក្រុង រ៉ង់ ហ្គូន
( ណៃ ពិដោ) ៖ ប្រព័ន្ធ ផ្សព្វផ្សាយ នៅ ប្រទេស មីយ៉ាន់ម៉ា បាន ឲ្យដឹង ថា មនុស្ស ៥នាក់ បាន បាត់បង់ជីវិត និង យ៉ាងហោច ១៥នាក់ ត្រូវ ចាប់ខ្លួន បន្ទាប់ពី កងកម្លាំង យោធា មីយ៉ាន់ម៉ា បាន បើក រថយន្ត បំបុក ក្រុម បាតុករ កាលពី ព្រឹក ថ្ងៃអាទិត្យ នេះ នៅឯ ទីក្រុង រ៉ង់ ហ្គូន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃអាទិត្យ ទី០៥ ខែធ្នូ ឆ្នាំ ២០២១ ។
គួរ បញ្ជាក់ ថា សកម្មភាព ធ្វើ បាតុកម្ម នៅតែ បន្ត ក្នុង ប្រទេស មីយ៉ាន់ម៉ា បើ ទោះបីជា គិត ចាប់តាំងពី រដ្ឋប្រហារ ថ្ងៃទី ០១ ខែកុម្ភៈ ឆ្នាំ ២០២១ រហូតមកទល់ ពេលនេះ មនុស្ស ច្រើន ជាង ១.៣០០ នាក់ ត្រូវបាន សម្លាប់ ក៏ដោយ ។ ខាង យោធា មីយ៉ាន់ម៉ា មិន ទាន់ ឃើញ ចេញមុខ ផ្តល់ ការបកស្រាយ អ្វី នៅឡើយ ទេ ជុំវិញ ហេតុការណ៍ ខាងលើ ៕
សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ផ្ដល់ អំណោយ ជូន ពលរដ្ឋ ៣០៤ គ្រួសារ ដែល មាន ជីវភាព ខ្វះខាត នៅ ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ដល់ អំណោយ ជូន ប្រជាពលរដ្ឋ ចំនួន ៣០៤ គ្រួសារ ដែល មាន ជីវភាព ខ្វះខាត ក្នុង អំឡុង ពេល វិបត្តិ កូវីដ១៩ រស់ នៅ ឃុំ ព្រែក កក់ ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម ។
អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ត្រូវបាន លោក ហ៊ុន ណេង អនុប្រធាន ទី១ ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ត កំពង់ចាម និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក ស្ទឹងត្រង់ បាន ចាត់ លោក សោ សាវឿន អនុប្រធាន ក្រម ការងារ ចុះ ជួយ ស្រុក ស្ទឹងត្រង់ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ ព្រែក កក់ ស្រុក ស្ទឹងត្រង់ យក ទៅ ប្រគល់ ជូន នៅ ព្រឹក ថ្ងៃទី ០៥ ខែធ្នូ ឆ្នាំ ២០២១ នេះ ។
គួរ បញ្ជាក់ ថា អំណោយ មនុស្សធម៌ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត នា ពេលនេះ រួម មាន អង្ករ ២៥ គីឡូក្រាម . អាវ រងា ចំនួន ១. ថវិកា ម្នាក់ ១០.០០០ រៀល ផងដែរ ៕ ប្រជាពលរដ្ឋ ចំនួន ៤០០ គ្រួសារ នៅ ឃុំ ស្រឡប់ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ទទួលបាន អំណោយ មនុស្សធម៌ ពី សមាគម ប្រភព ល្អ កម្ពុជា
( ត្បូងឃ្មុំ ) ៖ ប្រជាពលរដ្ឋ ចំនួន ៤០០ គ្រួសារ នៅ ភូមិ អង្គ ជា និង ភូមិ ដង កាំបិត ឃុំ ស្រឡប់ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ទទួលបាន អំណោយ មនុស្សធម៌ ពី សមាគម ប្រភព ល្អ កម្ពុជា ដែល ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី ៥ ខែធ្នូ ឆ្នាំ ២០២១ នេះ ក្រោម អធិបតីភាព លោក ឆាយ វណ្ណា សមាជិក ព្រឹទ្ធសភា និង ជា ប្រធាន ផ្នែក វប្បធម៌ និង សាសនា នៃ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្ដាល ។
លោក ឆាយ វណ្ណា បាន លើកឡើង ថា សម្ដេច តេជោ ហ៊ុន សែន ជា បិតា សន្តិភាព កម្ពុជា ដែល តស៊ូ រំដោះ ជាតិ យើង ពី សង្រ្គាម ដែល បាន បំផ្លាញ គ្រប់ យ៉ាង បន្សល់ តែ ផេះ ផង់ រហូតដល់ មាន ការរីកចំរើន ស្រុក ទេស យើង មាន ការអភិវឌ្ឍន៍ ។
លោក ថា រាជ រដ្ឋាភិបាល កម្ពុជា មាន គោនយោបាយ សុខដុម និយកម្ម ដ៏ ល្អ បំផុត បើក ទូលាយ ដល់ គ្រប់ សាសនិក អាច ប្រណិបត្តិ សាសនា របស់ ខ្លួន បាន យ៉ាង ពេញលេញ ។ ពិសេស សាសនិក អ៉ី ស្លាម មាន សិទ្ធិ ក្នុង ការប្រតិបត្តិ សាសនា របស់ ខ្លួន បាន គ្រប់ ពេល ។
លោក បាន ផ្ដាំផ្ញើ ដល់ ពលរដ្ឋ ខ្មែត អ៉ី ស្លាម ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ព្រោះ មាន តែ គណបក្ស ប្រជាជន ទេ ដែល អាច នាំមក នូវ សុខ សន្តិភាព និង មាន ការអភិវឌ្ឍន៍ រីកចំរើន ទៅ មុខ ជារៀងដរាប ។
ជាមួយគ្នា នេះ លោក តហើរ អូមើរ ប្រធាន សមាគម ប្រភព ល្អ កម្ពុជា បាន លើកឡើង ថា នេះ ជា អំណោយ របស់ ប្រជាពលរដ្ឋ នៃ រដ្ឋ គូ វែត ដែល បាន ឧបត្ថម្ភ មកដល់ បងប្អូន ខ្មែរ អ៉ី ស្លាម យើង ហើយ លោក សន្យា ថា នឹង នៅតែ បន្ត ស្វែងរក ជំនួយ ឲ្យបាន ច្រើន ដើម្បី មក ជួយ ដល់ ពលរដ្ឋ ខ្មែរ អ៉ី ស្លាម យើង ឲ្យបាន គ្រប់ ៗ គ្នា ។
គួរ ជម្រាប ថា ការចែក អំណោយ នេះ សមាគម បាន ចែក អង្ករ សរុប ចំនួន ១០តោន និង ម៉ាស់ ចំនួន ២ម៉ឺន ម៉ាស ដែល សកម្មភាព មនុស្សធម៍ នេះ ដែរ ត្រូវបាន សមាគម ប្រភព ល្អ បាន ធ្វើ ទូទាំង ប្រទេស និង នៅតែ បន្ត ធ្វើ សកម្មភាព របស់ ខ្លួន តទៅ មុខ ទៀត ៕
ឧប នាយក រដ្ឋមន្ត្រី ហោ ណាំ ហុង នាំ អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ៣៥០ គ្រួសារ នៅ ស្រុក គងពិសី និង ស្រុក បរសេដ្ឋ ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ លោក ឧប នាយក រដ្ឋមន្ត្រី ហោ ណាំ ហុង បាន ជួប សំណេះសំណាល និង នាំ អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ៣៥០ គ្រួសារ រស់ នៅ ស្រុក គងពិសី ចំនួន ៣ឃុំ និង ស្រុក បរសេដ្ឋ ចំនួន ១ឃុំ ក្នុង ខេត្ត កំពង់ស្ពឺ នា ព្រឹក ថ្ងៃទី ៥ ខែធ្នូ ឆ្នាំ ២០២១ ។ ក្នុង ពិធី នេះ ក៏ មាន ការអញ្ជើញ ពីសំណាក់ លោក ហ៊ុន ម៉ានី តំណាងរាស្ត្រ មណ្ឌល កំពង់ស្ពឺ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត អភិបាល ខេត្ត កំពង់ស្ពឺ ព្រម ជាមួយ មន្ត្រីរាជការ និង កងកម្លាំង ផងដែរ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ឧប នាយក រដ្ឋមន្ត្រី ហោ ណាំ ហុង បាន នាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដោយ ក្តី នឹករលឹក ដែល ជានិច្ចកាល សម្តេច ទាំង ទ្វេរ តែងតែ យកចិត្ត ទុក្ខ ដាក់ ខ្ពស់ ចំពោះ ទុក្ខលំបាក ប្រជាពលរដ្ឋ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បាន ក្រើន រំលឹក ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ត្រូវ រួម ធ្វើ អនាម័យ ឲ្យបាន គ្រប់ គ្នា អនុវត្ត នូវ វិធានការ « ៣ការពារ និង ៣កុំ » របស់ រាជ រដ្ឋាភិបាល ឲ្យបាន ខ្ជាប់ខ្ជួន ដើម្បី ការពារ ខ្លួន ពី ជំងឺ កូវីដ១៩ បើ ទោះបីជា ស្ថានភាព នៃ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ និង អ្នកស្លាប់ នៅក្នុង ប្រទេស មាន ការថយចុះ យ៉ាងណា ក៏ដោយ ពិសេស សំណូមពរ ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ អញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង ឲ បាន គ្រប់ ៗ គ្នា នៅ តាម ទីតាំង ដែល អាជ្ញាធរ ភូមិ - ឃុំ បាន ជម្រាប ជូន ។
លោក បៃ ដិន និង លោក ពូទីន ត្រៀម ជួបគ្នា នៅ សប្តាហ៍ ក្រោយ ដើម្បី ជជែក អំពី ស្ថានការណ៍ តានតឹង ពាក់ព័ន្ធ អ៊ុយក្រែន
( វ៉ាស៉ីន តោន ) ៖ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន និង ប្រធានាធិបតី រុស្ស៉ី លោក វ៉្លាឌីមៀ ពូទីន នឹង ជួបគ្នា តាម ប្រព័ន្ធ វីដេអូ អនឡាញ នៅ ថ្ងៃអង្គារ សប្តាហ៍ ក្រោយ ដើម្បី ពិភាក្សា អំពី ស្ថានការណ៍ ដែល កំពុង មាន ភាពតានតឹង ទាក់ទង នឹង ប្រទេស អ៊ុយក្រែន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃអាទិត្យ ទី០៥ ខែធ្នូ ឆ្នាំ ២០២១ ។
អ្នកនាំពាក្យ សេតវិមាន អាមេរិក លោកស្រី ចេន ផ្សាគី (Jen Psaki) បាន ឲ្យដឹង ក្នុង សេចក្តីថ្លែងការណ៍ យ៉ាង ដូច្នេះ ថា « លោក បៃ ដិន នឹង សង្កត់ធ្ងន់ អំពី ក្តីបារម្ភ របស់ សហរដ្ឋ អាមេរិក ជុំវិញ សកម្មភាព យោធា រុស្ស៉ី នៅ តាម បណ្តោយ ព្រំប្រទល់ ជាមួយ អ៊ុយក្រែន ហើយ លោក ក៏ នឹង បញ្ជាក់ សា ជា ថ្មី ផងដែរ នូវ ការគាំទ្រ របស់ ទីក្រុង វ៉ាស៉ីន តោន ចំពោះ អធិបតេយ្យភាព និង បូរណភាព ទឹកដី របស់ អ៊ុយក្រែន » ។
