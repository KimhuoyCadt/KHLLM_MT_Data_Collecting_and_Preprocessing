( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ០៦ ខែធ្នូ ឆ្នាំ ២០២១ នេះ លោកស្រី ម៉ាណ ណាវី តំណាងរាស្ត្រ រាជធានី ភ្នំពេញ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ ច្រាំង ចំេ រះទី១ បាន ដឹកនាំ ក្រុមការងារ ចុះ ជួយ សង្កាត់ ច្រាំង ចំេ រះទី១ និង អាជ្ញាធរ បាន នាំយក អំណោយ ចែកជូន ពលរដ្ឋ រងគ្រោះ ដោយ អគ្គីភ័យ នៅ វិហារ ធំ គីឡូម៉ែត្រ ៩ សង្កាត់ ច្រាំង ចំេ រះទី១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។
ក្នុង ឱកាស សំណេះសំណាល នោះ លោកស្រី តំណាងរាស្រ្ត បាន ចូលរួម រំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ដល់ ប្រជាពលរដ្ឋ ដែល ត្រូវ អគ្គីភ័យ ឆាបឆេះ និង បាន ផ្ដាំផ្ញើ ឲ្យ ពួកគាត់ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ អគ្គីភ័យ ដែល អាច កេីត ជា យថាហេតុ ណាមួយ ដែល យេីង មិន អាច ដឹង មុន ទេ ។
បន្ថែម ពី នេះ លោកស្រី ម៉ាណ ណាវី បាន លើកទឹកចិត្ត ដល់ ពួកគាត់ កុំ បាក់ទឹកចិត្ត ឲ្យ សោះ ពោល ត្រូវ តស៊ូ ទៅ មុខ បន្ត ទៀត ហើយ លោកស្រី សង្ឃឹម ថា នឹង មាន សប្បុរសជន មក ជួយ បងប្អូន បន្តបន្ទាប់ ទៀត យើង រួម សុខ រួម ទុក្ខ ជាមួយគ្នា ថ្នាក់ដឹកនាំ មិន ទុក បងប្អូន ចោល នោះ ទេ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ០៦ ខែធ្នូ ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៤.១៧៧ . ២៦២ នាក់ ។ ក្នុង រួម មាន៖
លោក Briggs មានប្រសាសន៍ ថា៖ « ខណៈ ដែល សំណួរ ជាច្រើន នៅតែ មិន មាន ចម្លើយ ឥឡូវនេះ យើង គិត ថា មាន សេណារីយ៉ូ ធ្លាក់ចុះ តិចតួច ដែល ក្នុង សេណារីយ៉ូ នេះ ការរីករាលដាល យ៉ាង ឆាប់រហ័ស របស់ វីរុស នេះ តែ មាន ភាពស៊ាំ ទប់ទប់ នឹង ជំងឺ កាច់ សាហាវ នេះ ត្រឹមតែ ទំនងជា បង្កឱ្យ មាន ការធ្លាក់ចុះ តិចតួច ប៉ុណ្ណោះ » ។
សេដ្ឋវិទូ រូប នេះ បាន បន្ថែម ថា វីរុស អូមី ក្រុង ទំនងជា មាន ផល ប៉ះពាល់ តិចតួច ប៉ុណ្ណោះ លើ ការចំណាយ លើ សេវាកម្ម តែ អាច បង្កឱ្យ មាន កង្វះ ការផ្គត់ផ្គង់ មាន ភាព ធ្ងន់ធ្ងរ ហើយ វា ក៏ អាច បង្ក មនុស្ស ខ្លះ បាត់បង់ អារម្មណ៍ វិល ត្រលប់ ទៅ ធ្វើ ការវិញ ។
លោក Briggs បាន មើលឃើញ ផល ប៉ះពាល់ ចម្រុះ ទៅ លើ អតិផរណា ។ ខណៈ ដែល វិស័យ ដែល មាន ភាពរសើប ចំពោះ វីរុស ដូចជា វិស័យ ធ្វើដំណើរ អាច រង ប៉ះពាល់ នោះ កង្វះខាត ការផ្គត់ផ្គង់ បន្ថែម និង កង្វះខាតក កម្លាំង ពលកម្ម អាច ជំរុញឱ្យ មាន កំណើន ថ្លៃ ក្នុង របៀប មួយ ដែល កើតមាន កាន់តែ យូរអង្វែង ។
លោបន្ថែម ថា ការខាតបង់ សេដ្ឋកិច្ច នេះ មាន ទំហំ ទឹកប្រាក់ ស្មើនឹង ចំនួន ៨៤៧ ទ្រី លាន ដុង ឬ ៣៧ប៊ីលាន ដុល្លារ បើ គិត តាម តម្លៃ ទីផ្សារ បច្ចុប្បន្ន ។
លោក Phong ជឿជាក់ ថា វា ចាំបាច់ ដែល ត្រូវ មាន កញ្ចប់ ស្តារ សេដ្ឋកិច្ច ឡើងវិញ មួយ សម្រាប់ ធ្វើជា វិធានការ កាត់បន្ថយ ការខាតបង់ ដែល កញ្ចប់ ស្តារ សេដ្ឋកិច្ច នេះ មាន កម្លាំង ចលករ សំខាន់ ៗ ចំនួន ៤ ដូចជា ការវិនិយោគ ការនាំចេញ ការប្រើប្រាស់ ក្នុង ស្រុក និង ការផ្លាស់ប្តូរ ទៅជា ឌីជីថល ។
លោក ថ្លែង ថា៖ « កម្លាំង ជំរុញ បឋម សម្រាប់ កំណើន សេដ្ឋកិច្ច កំពុង វិនិយោគ ដើម្បី បង្កើន តម្រូវការ និង ការផ្គត់ផ្គង់ តាមរយៈ ការលើកទឹកចិត្ត ឱ្យ មាន ការប្រើប្រាស់ ក្នុង ស្រុក » ។
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ មាន ៣៣ ករណី ជា ករណី នាំចូល ក្រៅពី នោះ ជា ករណី ឆ្លង ក្នុង ស្រុក ទាំងអស់ ខណៈ ទីក្រុង ហូជីមិញ ដែល ជា ចំណុច កណ្តាល នៃ ការផ្ទុះ រីករាលដាល ជំងឺ នេះ បាន រ៉ាប់រង ចំនួន ១. ១៧៤ ករណី ។
ក្នុង របាយការណ៍ ថ្ងៃចន្ទ នេះ ដែរ ក្រសួង សុខាភិបាល វៀតណាម ក៏ បាន ប្រកាស ពី ករណី អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ២២៣ នាក់ បន្ថែម ទៀត ផងដែរ ។
ប្រធាន នាយកដ្ឋាន ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា លោក ឧត្តមសេនីយ៍ ឯក ជា ពៅ សូម ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រកាស គាំទ្រ ឯកឧត្តម ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី នា ពេល អនាគត
( ភ្នំពេញ ) ៖ ប្រធាន នាយកដ្ឋាន ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា លោក ឧត្តមសេនីយ៍ ឯក ជា ពៅ ព្រមទាំង មន្រ្តី នគរបាល ក្រោម ឱវាទ ទាំងអស់ សូម ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ប្រសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ការប្រកាស គាំទ្រ ឯកឧត្តម ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី នា ពេល អនាគត ។
( ភ្នំពេញ ) ៖ ស្នងការ នគរបាល ខេត្ត ត្បូងឃ្មុំ លោក ឧត្តមសេនីយ៍ ត្រី ម៉ុន មាគ៌ា ព្រមទាំង មន្រ្តី នគរបាល ខេត្ត ត្បូងឃ្មុំ ទាំងអស់ សូម ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ប្រសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ការប្រកាស គាំទ្រ ឯកឧត្តម ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី នា ពេល អនាគត ។
ក្រុមការងារ អភិវឌ្ឍ យុវជន ខេត្ត ព្រៃវែង ប្តេជ្ញា បន្ត ធ្វើ ការងារ សង្គម និង សប្បុរសធម៌ ដើម្បី ទទួលបាន ទំនុកចិត្ត ពី ប្រជាពលរដ្ឋ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ងិន បាណាល់ ប្រធាន ក្រុមការងារ អភិវឌ្ឍ យុវជន ខេត្ត ព្រៃវែង បាន ថ្លែង ថា ក្នុង គោលបំណង បង្កើត ក្តីស្រឡាញ់ និង ជឿ ទុកចិត្ត ពីសំណាក់ ប្រជាពលរដ្ឋ មាន កិច្ចការងារ បី ទៀត ដែល ក្រុមការងារ អភិវឌ្ឍ យុវជន ខេត្ត ព្រៃវែង កំពុង ធ្វើ គឺ ការងារ សង្គម ការងារ មនុស្សធម៌ និង ការងារ វប្បធម៌ ប្រពៃណី សាសនា ។
ថ្លែង ក្នុង សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ឆ្នាំ ២០២២ របស់ ក្រុមការងារ អភិវឌ្ឍ យុវជន ខេត្ត ព្រៃវែង លោក បាន ឱ្យដឹង ថា ចំពោះ ការងារ មនុស្សធម៌ ទទួលបាន ការទំនុកបម្រុង និង ឧបត្ថម្ភ ជា អំណោយ ពី លោក ស សុខា និង លោក ស្រី យក ទៅ ជូន ដល់ ជន ក្រីក្រ ជន ចាស់ជរា កុមារ កំព្រា និង ជន ពិការ ជាដើម ។
ជាមួយគ្នា នេះ ក្រុមការងារ អភិវឌ្ឍ យុវជន ខេត្ត ព្រៃវែង បាន រៀបចំ យន្តការ ការងារ ពង្រឹង ការគ្រប់គ្រង រដ្ឋបាល ក្រុមការងារ អភិវឌ្ឍ ខេត្ត ក្រុង ស្រុក និង បាន រៀបចំ ផែនការ យុទ្ធសាស្រ្ត ផែនការ សកម្មភាព ផែនការ ថវិកា និង ផែនការបី ឆ្នាំ រំកិល ដើម្បី ធ្វើជា ត្រី វិស័យ ក្នុង ការបង្ហាញ ទិស សម្រាប់ អនុវត្ត ការងារ ។
លោក មានប្រសាសន៍ បន្ថែម ថា « យើង មាន កិច្ចការងារ បី ដែល កំពុង ធ្វើ គឺ ការអប់រំ សតិអារម្មណ៍ និង ចាត់តាំង » ។ លោក បន្ថែម ថា ក្រុមការងារ លើកទឹកចិត្ត យុវជន សកម្ម ដោយ ផ្តល់ នូវ ក្តីសង្ឃឹម និង កាលានុវត្តភាព តាមរយៈ ការប្រែក្លាយ សុបិន យុវជន ឱ្យ ក្លាយជា ការពិត ដូចជា ការប្រគល់ តួនាទី សំខាន់ ៗ ដល់ យុវជន ដែល មាន ស្នាដៃ ជាដើម ។
ថ្លែង ក្នុង ពិធី បិទ អង្គ សន្និបាត លោក ស សុខា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត ព្រៃវែង និង ជា ប្រធាន កិត្តិយស ក្រុមការងារ អភិវឌ្ឍ យុវជន ខេត្ត ព្រៃវែង មានប្រសាសន៍ ថា ជ័យជម្នះ ក្នុង ការបោះឆ្នោត របស់ គណបក្ស ប្រជាជន កម្ពុជា គឺ បន្ត អភិវឌ្ឍ សេដ្ឋកិច្ច ជាតិ ខឿន សន្តិភាព ឱ្យ កាន់តែ រឹងមាំ និង ថែរក្សា ស្ថិរភាព នយោបាយ ជូន ជាតិ មាតុភូមិ ចៀស ផុត ពី សង្រ្គាម ។
ឯកឧត្តម ហ៊ុន ម៉ានី សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា សូម ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រកាស គាំទ្រ ឯកឧត្តម ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី នា ពេល អនាគត
( ភ្នំពេញ ) ៖ ឯកឧត្តម ហ៊ុន ម៉ានី សមាជិក មួយ រូប នៃ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា សូម ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ប្រសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ការប្រកាស គាំទ្រ ឯកឧត្តម ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី នា ពេល អនាគត ។
គួរ បញ្ជាក់ ថា ថវិកា ផាក ពិន័យ ចំនួន ១០លាន ដុល្លារ អាមេរិក ត្រូវបាន ផ្ញើរ ពី ក្រុមហ៊ុន ម្ចាស់ កប៉ាល់ ចូល ទៅក្នុង គណនី របស់ អាជ្ញាធរ រូបិយវត្ថុ របស់ ម៉ាល់ ឌីវ ដែល ជា ធនាគារ កណ្តាល របស់ ប្រទេស នេះ ។ ចំណែក កប៉ាល់ ដែល ត្រូវបាន អាជ្ញាធរ ម៉ាល់ ឌីវ ឃាត់ទុក ជា បណ្តោះអាសន្ន បន្ទាប់ពី ឧប្បត្តិហេតុ ខាង លើ ក៏ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ទៅ វិញ ផងដែរ បន្ទាប់ពី សំណង ត្រូវបាន ទូទាត់ រួចរាល់ ៕
សមាគម ធនាគារ នៅ កម្ពុជា បង្ហាញ ពី បញ្ហា ប្រឈម ចម្បង ៗ ដែល បង្អាក់ ការទទួលបាន ឥណទាន របស់ SMEs និង សហគ្រិន ស្រ្ដី
( ភ្នំពេញ ) ៖ លោក ប៊ុន យីន អនុប្រធាន សមាគ ធនាគារ នៅ កម្ពុជា បាន លើកឡើង ពី បញ្ហា ប្រឈម ចម្បង ៗ មួយចំនួន ដែល បាន បង្អាក់ ការទទួលបាន ឥណទាន របស់ សហគ្រាស ធុន តូច និង មធ្យម និង សហគ្រិន ស្រ្ដី ពី គ្រឹះស្ថាន ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ ដែល បញ្ហា ប្រឈម ចម្បង ៗ ទាំងនោះ មាន ការ មិន មាន របាយការណ៍ ហិរញ្ញវត្ថុ ជាក់លាក់ និង ត្រឹមត្រូវ និង ការ មិន បាន ចុះបញ្ជី ជា ផ្លូវការ នៃ អាជីវកម្ម របស់ សហគ្រាស ធុន តូច និង មធ្យម និង សហគ្រិន ស្រ្ដី ។ កត្តា ទាំង នេះ ជា ហេតុផល ចម្បង ក្នុង ការបង្អាក់ ការផ្ដល់ជូន ឥណទាន ។
ការលើកឡើង របស់ លោក ប៊ុន យីន ធ្វើឡើង ក្នុង សិក្ខាសាលា ក្រោម ប្រធានបទ ស្ដីពី បញ្ហា ប្រឈម និង ការរក ដំណោះស្រាយ លើ បញ្ហា នៃ ការទទួលបាន ឥណទាន របស់ សហគ្រាស ធុន តូច និង មធ្យម និង សហគ្រិន ស្រ្ដី ។ សិក្ខាសាលា នេះ រៀបចំឡើង ដោយ សមាគ ធនាគារ នៅ កម្ពុជា និង សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា ព្រមទាំង អង្ក ការ Pact រួមទាំង ដៃគូរ ជាច្រើន ទៀត ។
លោក បាន ឲ្យដឹង ថា សហគ្រាស ធុន តូច និង មធ្យម និង សហគ្រិន ស្រ្ដី បច្ចុប្បន្ន នេះ មាន ច្រើន ដែល បាន ទទួល សេវា ហិរញ្ញវត្ថុ ផ្លូវការ និង ការប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ប្រកបដោយ ការទទួលខុសត្រូវ និង អាច ចូលរួម ដល់ ការអភិវឌ្ឍន៍ សង្គម សេដ្ឋកិច្ច របស់ គ្រួសារ និង សហគម កាន់តែ ច្រើន ។ ទាំងនេះ ដែល នាំឲ្យ ឆ្ពោះ ទៅរក ជីវភាព កាន់តែ ប្រសើរ មាន ឱកាស ពង្រីក អាជីវកម្ម មាន ការសន្សំ និង ការត្រៀមខ្លួន ចំពោះ ភាពអាសន្ន នៃ វិស័យ ហិរញ្ញវត្ថុ ។
លោក កត់សំគាល់ ឃើញ ថា « សហគ្រាស ធុន តូច និង មធ្យម និង សហគ្រិន ស្រ្ដី នៅតែ ប្រឈម បញ្ហា នៃ ការទទួល ឥណទាន ពី គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ បញ្ហា ចម្បង ៗ ដែល ង្អាក ការទទួលបាន ឥណទាន ការ មិន មាន របាយការណ៍ ហិរញ្ញវត្ថុ ជាក់លាក់ និង ត្រឹមត្រូវ និង ការ មិន បាន ចុះបញ្ជី ជា ផ្លូវការ នៃ អាជីវកម្ម និង បញ្ហា មួយចំនួន ជាច្រើន ផ្សេង ទៀត » ។
លោក បាន បន្ថែម ថា ចំពោះ សិក្ខាសាលា នៅក្នុង ថ្ងៃ នេះ នឹង ចូលរួម ដោះស្រាយ និង រិះរក មធ្យបាយ ដោះស្រាយ នូវ បញ្ហា នៃ ការទទួលបាន ឥណទាន ពី វិស័យ ធនាគារ និង ហិរញ្ញវត្ថុ និង ផ្ដល់ ព័ត៌មាន ជាច្រើន ដល់ សាធារណជន អ្នក ប្រកប អាជីវកម្ម ជាដើម ដើម្បី យល់ដឹង ពី សេវាកម្ម ឥណទាន និង ផលិតផល ហិរញ្ញវត្ថុ ។
បន្ថែម ពី បញ្ហា ប្រឈម នៃ ការបង្អាក់ ការទទួលបាន ឥណទាន របស់ សហគ្រាស ធុន តូច និង មធ្យម និង សហគ្រិន ស្រ្ដី នេះ កញ្ញា នាង សុវ៉ាត ថា ប្រធាន គ្រប់គ្រង គម្រោង នៃ សហគ្រិន វ័យ ក្មេង កម្ពុជា ក៏ បាន លើកឡើង អំពី ចំណុច មួយចំនួន ទៀត ដែល នាំឲ្យ សហគ្រាស ធុន តូច និង មធ្យម និង សហគ្រិន ស្រ្ដី មិន ទទួលបាន ឥណទាន រួម មាន៖
១៖ ក្រុមហ៊ុន មិន មាន កំណត់ ត្រា របាយការណ៍ ហិរញ្ញវត្ថុ និង ផែនការ អាជីវកម្ម ត្រឹមត្រូវ ។ ២៖ ក្រុមហ៊ុន មិន មាន ទ្រព្យ បញ្ចាំ ដូច្នេះ មិន អាច យក ប្រាក់ កម្ចី ដោយ មាន អត្រា ការប្រាក់ ល្អ ។៣៖ ក្រុមហ៊ុន ដែល រង ផល ប៉ះពាល់ ដោយ កូវីដ១៩ មិន អំណោយផល អនុម័ត កម្ចី ពី ស្ថាប័ន ហិរញ្ញវត្ថុ ។៤៖ សមត្ថភាព ក្នុង ការសង បំណុល និង ភាពស្មុគស្មាញ ដល់ កាតព្វកិច្ច ហិរញ្ញប្បទាន ។ ៥៖ ប្រវត្តិ នៃ ការសង បំណុល មាន ការខកខាន ។៦៖ ក្រុមហ៊ុន ន ចុះបញ្ជី អាជីវកម្ម ។
លោក គា បូរាណ ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា បាន លើកឡើង ផងដែរ ពី ភាពសំខាន់ នៃ ការចូលរួម របស់ សហគ្រាស ធុន តូច និង មធ្យម និង តួនាទី របស់ សហគ្រិន ជា ស្រ្ដី ដែល បាន រួមចំណែក ដល់ សេដ្ឋកិច្ច ជាតិ កម្ពុជា ។
លោក បាន បន្ថែម ថា ក្នុង នោះ ២០. ៩ភាគរយ ប្រើប្រាស់ សម្រាប់ វិស័យ ពាណិជ្ជកម្ម និង ជំនួញ . ១៥.៩ ភាគរយ ប្រើប្រាស់ សម្រាប់ វិស័យ សេវាកម្ម និង ១៩.៣ភាគរយ ប្រើប្រាស់ សម្រាប់ វិស័យ កសិកម្ម ។ ក្នុង នោះ អាជីវករ ជា ស្រ្ដី មាន អត្រា ភាគរយ ជោគជ័យ ខ្ពស់ បើ ធៀប នឹង បុរស ជាពិសេស ការគ្រប់គ្រង ហិរញ្ញវត្ថុ ៕ ប្រធានាធិបតី រុស្ស៊ី លោក ពូទីន ផ្ដើម ធ្វើ ទស្សនកិច្ច នៅ ឥណ្ឌា ដោយ សម្លឹង ឃើញ ការពង្រឹង ទំនាក់ទំនង យោធា និង ថាមពល
គេ នៅ ចាំ បាន ថា នៅក្នុង កិច្ចប្រជុំ កំពូល តាម ប្រព័ន្ធ វីដេអូ កាលពី ខែកញ្ញា កន្លងទៅ នេះ . លោក នាយក រដ្ឋមន្ត្រី ណារិន ដ្រា ម៉ូឌី បាន ប្រាប់ លោក វ្ល៉ាឌីមៀ ពូទីន ថា រុស្ស៊ី គឺជា មិត្ត ដ៏ អស្ចារ្យ របស់ ឥណ្ឌា ។ នៅក្នុង ជំនួប នៅ ថ្ងៃចន្ទ នេះ ក្នុង ទីក្រុង ញូដេលី លោក ម៉ូឌី និង លោក ពូទីន ត្រូវបាន គេ រំពឹង ថា នឹង ពិភាក្សា លើ ការប្រគល់ ប្រព័ន្ធ មីស៊ីល S-400 ដែល ឥណ្ឌា បញ្ជាទិញ ពី រុស្ស៊ី . ការពង្រឹង ទំនាក់ទំនង យោធា ថាមពល និង ពាណិជ្ជកម្ម ជាដើម ។
គួរ បញ្ជាក់ ថា ដំណើរទស្សនកិច្ច រយៈពេល ខ្លី ខាងលើ របស់ លោក ពូទីន ទៅកាន់ ប្រទេស ឥណ្ឌា គឺជា ដំណើរទស្សនកិច្ច នៅឯ បរទេស ជា លើក ទី២ បន្ទាប់ពី លោក ពូទីន បាន ជួប ពិភាក្សា ដោយ ផ្ទាល់ ជាមួយ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន ក្នុង ទីក្រុង ហ្សឺណែវ ប្រទេស ស្វីស កាលពី ខែមិថុនា កន្លងទៅ ៕
លោកជំទាវ ប៉ុក ក រុណា អគ្គ លេខាធិការ ស្តីទី នៃ អគ្គ លេខាធិការដ្ឋាន គ.ជ. ព ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រកាស គាំទ្រ ឯកឧត្តម ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី នា ពេល អនាគត
ឧស្សាហកម្ម អាវុធ រក កម្រៃ បាន ៥៣១ ពាន់ លាន ដុល្លារ ក្នុង ឆ្នាំ ២០២០ ទោះ ពិភពលោក ជួប វិបត្តិ សេដ្ឋកិច្ច
