លោក ពុយ គា អគ្គ លេខាធិការ ក្លិប អ្នកកាសែត កម្ពុជា បាន បង្ហាញ ការសោកស្តាយ ចំពោះ ការលើកឡើង នេះ ។ លោក បាន ចាត់ទុក ការប្រើ សម្តី នេះ វា ធ្ងន់ បន្តិច ហើយ និង ចង់ឲ្យ ប្រធាន កិត្តិយស បក្ស នេះ ប្រើ សម្តី ឲ្យបាន សមរម្យ ជាង នេះ ។
ទី២៖ គឺជា ការមាក់ងាយ ធ្ងន់ធ្ងរ ចំពោះ អ្នកសារព័ត៌មាន ដែល បាន ខិតខំ បំពេញ ការងារ របស់ ខ្លួន និង កំពុង ពង្រឹង សមត្ថភាព វិជ្ជាជីវៈ យ៉ាង សកម្ម ដើម្បី បម្រើ សង្គម ឲ្យ កាន់តែ ល្អ ប្រសើរ ។ គាត់ អាច រិះគន់ កែលម្អរបាន ប្រសិនបើ ឃើញ ចំណុច ខ្វះខាត តែ មិន ត្រូវ ជេរ ប្រមាថ ឡើយ ពីព្រោះ វា មិន មែន សីលធម៌ របស់ ខ្មែរ ។
ប្រធាន ក្លឹប អ្នកកាសែត កម្ពុជា រូប នេះ បាន សង្កត់ធ្ងន់ ថា កំហុស ធំ ៗ ទាំង ពីរ នេះ បញ្ជាក់ ថា ប្រធាន កិត្តិយស គណបក្ស ខ្មែរ ក្រោក នៅ មិន ទាន់ ស័ក្តិសម ធ្វើជា អ្នកនយោបាយ ទេ ។ ដូច្នេះ គួរតែ កែតម្រូវ ពាក្យពេចន៍ ឡើងវិញ និង ខិតខំ រៀបចំ ខ្លួន ឲ្យបាន ល្អ ជាង នេះ ។
អ្នក ព័ត៌មាន រូប នេះ បាន បន្ថែម ថា អ្នក ព័ត៌មាន នៅ កម្ពុជា ភាគ ច្រើន បំផុត បម្រើ ការកើត ចេញ ពី ឆន្ទៈ មនសិការ របស់ ខ្លួន ព្រោះថា ការបំពេញ ការងារ នេះ មិន មាន ការឧបត្ថម្ភ ថវិកា ពី ស្ថាប័ន រដ្ឋ ឬ ប្រជាពលរដ្ឋ ណាមួយ នោះ ឡើយ ។ ថវិកា ដែល បាន គឺ បាន ពី ស្ថាប័ន ព័ត៌មាន ដែល ពួកគេ យក កម្លាំង កាយ បញ្ញា ញាណ របស់ គេ ទៅ ប្តូរ យកមក ។
អ្នក ព័ត៌មាន រូប នេះ បាន ឆ្លៀត ចោទ សួរ ទៅ ថ្នាក់ដឹកនាំ បក្ស ខ្មែរ ក្រោក ថា អ្នក ព័ត៌មាន ទោះ មិន រស់ ដោយ លុយ ជាតិ និង ប្រជាជន តែ បាន ធ្វើ ការងារ ជាច្រើន សម្រាប់ ជាតិ និង ប្រជាជន ចុះ គណបក្ស ខ្មែរ ក្រោក ក្នុង តួនាទី ជា សមាជិក ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ចាយ លុយ ជាតិ និង ប្រជាជន អស់ ជាច្រើន ខែ មក ហើយ នោះ បាន ធ្វើការ ជាប្រយោជន៍ ជាតិ និង ប្រជាជន បាន អ្វី ខ្លះ ហើយ ? បេសកកម្ម យក កោះ ត្រល់ ដល់ ណា ហើយ ឬ បាន ត្រឹមតែ ស្រែក កោក វាយ ធុង វាយ ប៉ោត យក តែ មុខ ទេ ? ។
អ្នកកាសែត ជើង ចាស់ លោក ម៉ា យ៉ារិទ្ធ ចេញមក ប្រដៅ ថ្នាក់ដឹកនាំ គណបក្ស ខ្មែរ ក្រោក គួរ រៀន ប្រើ ភាសា ឱ្យ បាន សមរម្យ ក្នុង នាម ជា កូន ខ្មែរ
( ភ្នំពេញ ) ៖ លោក ម៉ា យ៉ារិទ្ធ អ្នកកាសែត ជើង ចាស់ ដ៏ ល្បី មួយ រូប ដែល ជា នាយក គ្រប់គ្រង ទូរទស្សន៍ អប្សរាណិត នៅ ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន ចេញមុខ ប្រដៅ ថ្នាក់ដឹកនាំ គណបក្ស ខ្មែរ ក្រោក ឱ្យ ចេះ រៀន ប្រើ ភាសា ឱ្យ បាន សមរម្យ ក្នុង នាម ជា កូន ខ្មែរ ។
លោក ម៉ា យ៉ារិទ្ធ បាន លើកឡើង យ៉ាង ដូច្នេះ ថា៖ « ថ្នាក់ដឹកនាំ គណបក្ស ខ្មែរ ក្រោក មិន គួរ ប្រើ សម្តី នេះ ប្រមាថ អ្នកកាសែត ខ្មែរ ទេ ។ គណបក្ស នេះ មិន ទាន់ ស្គាល់ អ្នកកាសែត ខ្មែរ ច្បាស់ ទេ ។ គួរ រៀន ប្រើ ភាសា ឱ្យ បាន សមរម្យ ឱ្យ សម ជា កូន ខ្មែរ អ្នក ចេះដឹង ថ្លៃថ្នូរ » ។
សូម បញ្ជាក់ ថា អ្នក ព័ត៌មាន នៅ កម្ពុជា បាន ខឹងសម្បា យ៉ាង ខ្លាំង ចំពោះ ថ្នាក់ដឹកនាំ គណបក្ស ខ្មែរ ក្រោក ដែល បាន ប្រើ សម្តី ប្រមាថ មើលងាយ អ្នក ព័ត៌មាន នៅ កម្ពុជា រហូត ហៅ កាសែត នៅ ស្រុក ខ្មែរ ថា ជា កាសែត « ខ្ចប់ ចេក ចៀន » ។ ជាមួយ ការខឹងសម្បា ក្រុម អ្នក ព័ត៌មាន គ្រោង ធ្វើ សកម្មភាព ផ្សេង ៗ ឲ្យ ថ្នាក់ដឹកនាំ បក្ស នេះ ចេញមក កែតម្រូវ ពាក្យ សម្តី និង សុំទោស ជាសាធារណៈ ជាដើម ចំពោះ ការប្រមាថ មួយ នេះ ។
តាមពិត ទៅ សម្តេច តេជោ ហ៊ុន សែន នៅក្នុង ជំនួប ជាមួយ អ្នក ព័ត៌មាន ក្រោម បរិយាកាស ដ៏ ស្និទ្ធស្នាល នៅ ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០១៩ មិន បាន សម្តែង កាយវិការ ខឹងសម្បា ណាមួយ ចំពោះ អ្នក ព័ត៌មាន ដូច ការលើកឡើង របស់ ថ្នាក់ដឹកនាំ បក្ស ខ្មែរ ក្រោក នោះ ឡើយ ។ សម្តេច តេជោ ហ៊ុន សែន មាន តែ ការថ្លែង កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ អ្នក ព័ត៌មាន ក្នុង បេសកកម្ម ការងារ ផ្សព្វផ្សាយ ដំណឹង និង ធ្វើជា ស្ពាន ចម្លង ដំណឹង ពី រាជ រដ្ឋាភិបាល ទៅ ប្រជាពលរដ្ឋ ឬ ពី ប្រជាពលរដ្ឋ ទៅកាន់ រាជ រដ្ឋាភិបាល ។
បន្ថែម ពីលើ នោះ សម្តេច នាយក រដ្ឋមន្ត្រី ចង់ឲ្យ អ្នក ព័ត៌មាន នៅ កម្ពុជា ហ៊ាន សរសេរ វិភាគ ចំពោះ ស្ថានការណ៍ វិវឌ្ឍន៍ របស់ អន្តរជាតិ ដូចជា បញ្ហា នៅ សហរដ្ឋ អាមេរិក ជាដើម ។ អ្វី ដែល សម្តេច តេជោ លើកឡើង នោះ គ្រាន់តែ ជា សំណូមពរ តែ ប៉ុណ្ណោះ មិន មែន ជា ការបង្គាប់បញ្ជា អ្វី នោះ ឡើយ ព្រោះ សម្តេច បាន យល់ ច្បាស់ ណាស់ ពី របប សារព័ត៌មាន របស់ កម្ពុជា ជា ព័ត៌មាន ឯករាជ្យ មិន មាន នរណា ម្នាក់ ទៅ បង្គាប់បញ្ជា ស្ថាប័ន ព័ត៌មាន ឬ អ្នក ព័ត៌មាន ណាមួយ នោះ ឡើយ ៕
លើស ពី នោះ លោក អ្នក នឹង ទទួលបាន ឱកាស ឈ្នះ រង្វាន់ ជាច្រើន ព្រោះ នៅក្នុង ឆ្នាំ ២០១៩នេះ ក្រុមហ៊ុន នឹង ផ្ដល់ជូន រង្វាន់ ច្រើន ជាង ឆ្នាំ មុន ៗ ដែល មាន រង្វាន់ ម៉ូតូ ទូរទស្សន៍ LED និង កាត សម្រាប់ ចាក់ សាំង តូតាល់ ( តូតាល់ ក្លឹប កាត ) ។
Refill and Win ជា កម្មវិធី ប្រចាំ ឆ្នាំ ដែល ផ្ដួច ផ្ដើម បង្កើតឡើង ដោយ ក្រុមហ៊ុន តូតាល់ កាំបូត ដើម្បី ផ្ដល់ រង្វាន់ ជូន អតិថិជន ដែល បាន គាំទ្រ ក្រុមហ៊ុន កន្លងមក ។ សូម បញ្ជាក់ ថា កម្មវិធី នេះ បាន ប្រព្រឹត្ដទៅ អស់ រយៈពេល បី ខែ ដោយ ចាប់ផ្ដើម ពី ខែកញ្ញា ដល់ ខែធ្នូ ឆ្នាំ ២០១៨ និង មាន សន្លឹក ឆ្នោត រាប់ លាន សន្លឹក ត្រូវបាន ដាក់ ផ្សង សំណាង នៅ តាម ស្ថានីយ តូតាល់ ទូទាំង ប្រទេស ។
២៖ សេចក្ដីស្លាប់ ពុំ មែន រឿង គួរឱ្យ ខ្លាច ទេ តែ ស្លាប់ ទាំង មិន បាន ឃើញ ប្រទេស ខ្លួន ទទួលបាន ឯករាជ្យ ទើប ជា រឿង គួរឱ្យ ភ័យខ្លាច ។ អាចារ្យ ហែម ចៀវ ព្រះសង្ឃ កម្ពុជា ក្រោម មួយ អង្គ ដែល ចូលរួម តស៊ូ ទាមទារ ឯករាជ្យ ពី អាណានិគម បារាំង ។
៤៖ កុំ ដើរ តាម ហ្វូង មនុស្ស សូម ដឹកនាំ គេ ឱ្យ ដើរ តាម អ្នក វិញ ។ លោកស្រី ម៉ាការ៉េត ថាត់ ឆឺរ អតីត នាយក រដ្ឋមន្ត្រី ចក្រភព អង់គ្លេស ។
៥៖ ភាព ជា អ្នកដឹកនាំ និង ការសិក្សា ត្រូវ មាន ទំនាក់ទំនង ជាមួយគ្នា មិន អាច ខ្វះ បាន ។ លោក ចន ខេន ណឺឌី អតីត ប្រធានាធិបតី សហរដ្ឋ អាមេរិក ។
៦៖ មេដឹកនាំ គឺជា អ្នកជំនួញ ម្នាក់ ដែល មាន សង្ឃឹម ជានិច្ច ។ ព្រះចៅ ណា ប៉ូឡេអុង បូណា ផាត របស់ បារាំង ។
៩៖ ខ្ញុំ មិន បាន ខ្វល់ខ្វាយ ពី អ្នកដទៃ ដែល មិន ស្ដាប់ ខ្ញុំ នោះ ទេ ខ្ញុំ ខ្វល់ តែ សមត្ថភាព ផ្ទាល់ខ្លួន របស់ ខ្ញុំ តែ ប៉ុណ្ណោះ ។ លោក ខុង ជឺ អ្នកប្រាជ្ញ បុរាណ ចិន ។
យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៣ ខែមករា នេះ លទ្ធផល៖ បង្ក្រាប ១៩ករណី ឃាត់ខ្លួន ៣៣ នាក់
