( ភ្នំពេញ ) ៖ នាយកដ្ឋាន អប់រំ កាយ និង កីឡា នៃ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ វេលា ម៉ោង ៣៖០០ នាទី រសៀល នេះ នឹង ធ្វើ សន្និសីទ សារព័ត៌មាន មួយ ស្តីពី ការបោះឆ្នោត ជ្រើសរើស លោកស្រី កែ ឡេង ជា កីឡាការិនី ប៉េតង់ ឆ្នើម ពិភពលោក ប្រចាំ ឆ្នាំ ២០១៨ ។
សូម ជំរាប ថា លោកស្រី កែ ឡេង គឺជា វីរកីឡាការិនី កម្ពុជា ១រូប គត់ ដែល បាន ឈ្នះ មេដាយ មាស ពិភពលោក នៃ ការប្រកួត ប៉េតង់ ចំនួន ៤លើក មក ហើយ ។ ព្រឹត្តិការណ៍ ឈ្នះ ទាំង៤លើក នោះ គឺ៖ ឆ្នាំ ២០១៣ នៅ ប្រទេស បារាំង . ឆ្នាំ ២០១៥ នៅ ប្រទេស ថៃ . ឆ្នាំ ២០១៧ នៅ ប្រទេស ចិន និង ឆ្នាំ ២០១៨ នៅ ប្រទេស បារាំង ម្តង ទៀត ។
មន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន អះអាង ផងដែរ ថា ដំណើរការ ជួសជុល ស្ពាន អាចនឹង បញ្ចប់ ទាំងស្រុង នៅ អំឡុង ខែមិថុនា ។
សូម បញ្ជាក់ ស្ពាន ជ្រោយ ចង្វារ ទី១ ត្រូវបាន ផ្អាក ដំណើរ ឆ្លងកាត់ និង ជួសជុល ឡើងវិញ កាលពី កំលុង ខែតុលា ឆ្នាំ ២០១៧ បន្ទាប់ពី ស្ពាន ដែល សាងសង់ ឡើង ក្រោម ជំនួយ រដ្ឋាភិបាល ជប៉ុន នា អំឡុង ឆ្នាំ ១៩៦៦ មួយ នេះ មាន សភាព ទ្រុធ ទ្រោម ខ្លាំង ។
« យើង បាន បាត់បង់ ឱកាស កសាង ប្រទេសជាច្រើន ឆ្នាំ មកហើយ ដោយសារ សង្រ្គាម ។ ក្រោយពី ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញលេញ គឺ យើង ត្រូវការ ទេសចរ ពាណិជ្ជករ និង អ្នក វិនិយោគទុន បរទេស ជាច្រើន មក វិនិយោគ នៅ កម្ពុជា ។ ដូច្នេះ ការចូលរួម ផ្សព្វផ្សាយ ព័ត៌មានវិជ្ជមាន ពិតប្រាក គឺ កាន់តែ ផ្តល់ នូវ ទំនុកចិត្ត ដល់ ទេសចរ បរទេស និង វិនិយោគ គិន បរទេស » ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បញ្ជាក់ ។
សូម បញ្ជាក់ ថា នៅ ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០១៩ស្អែក នេះ សម្តេច តេជោ ហ៊ុន សែន នឹង អញ្ជើញ ជួប សំណេះសំណាល និង ពិសារ បាយ សាមគ្គី ជាមួយ អ្នក ព័ត៌មាន កម្ពុជា ជា លើក ទី៣ នៅ មជ្ឈមណ្ឌល សន្និបាត និង ពិព័រណ៍ កោះ ពេជ្រ ។
លោក ផុស សុវណ្ណ អ្នកនាំពាក្យ ក្រសួង ព័ត៌មាន បាន ឲ្យដឹង ថា ជំនួប រវាង សម្តេច តេជោ និង អ្នក ព័ត៌មាន នៅ ឆ្នាំ នេះ មាន អ្នក ព័ត៌មាន ៤.៦០០ នាក់ ហើយ បាន ចុះបញ្ជី សុំ កាត ចូលរួម ។ ចំនួន នេះ អាច មាន ការកើនឡើង ព្រោះ នៅ មាន អ្នក ព័ត៌មាន មួយចំនួន ទៀត កំពុង ធ្វើ ការស្នើសុំ ជា បន្ដ បន្ទាប់ ប៉ុន្ដែ ចំនួន ដែល ក្រសួង កំណត់ នោះ គឺ ក្នុង រង្វង់ ត្រឹម ៥.០០០ នាក់ ដោយ ហេតុ ថា ទីតាំង ប្រារព្ធ ពិធី អាច ដាក់ អ្នកចូលរួម បាន ត្រឹម ៥.០០០ នាក់ ប៉ុណ្ណោះ ។
បើ តាម អ្នកនាំពាក្យ ក្រសួង ព័ត៌មាន រូប នេះ បាន ឲ្យដឹង ផងដែរ ថា លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បាន ធ្វើ សំណើ មួយ ដាក់ ទៅ ខុទ្ទកាល័យ សម្ដេច តេជោ ហ៊ុន សែន ដើម្បី សុំឲ្យ អ្នក ព័ត៌មាន បាន បញ្ចេញមតិ យោបល់ ក្នុង ជំនួប ជាមួយ សម្ដេច តេជោ ផងដែរ ។ ប៉ុន្តែ សំណើ របស់ លោក រដ្ឋមន្ដ្រី រហូតមកដល់ ពេលនេះ មិន ទាន់ ទទួលបាន ការឆ្លើយតប ពី ខាង ខុទ្ទកាល័យ របស់ សម្ដេច តេជោ ហ៊ុន សែន នៅឡើយ ។
លោក ផុស សុវណ្ណ បាន អះអាង ថា បើ មាន ការអនុញ្ញាត ពី សម្តេច តេជោ នឹង រៀបចំ តំណាង អ្នក ព័ត៌មាន ២ ឬ ៣នាក់ ឲ្យ ឡើង សម្តែង មតិ យោបល់ ។
ក្រោម មាន ជំនួប រវាង ប្រមុខ រាជ រដ្ឋាភិបាល ជាមួយ អ្នក ព័ត៌មាន លោក ផុស សុវណ្ណ បាន មើលឃើញ ថា វិស័យ ព័ត៌មាន កាន់តែ រីកចម្រើន និង ប្រសើរឡើង ដោយសារតែ អ្នក ព័ត៌មាន ទទួលបាន ការណែនាំ និង កែលម្អ មួយចំនួន ពី ប្រមុខ ដឹកនាំ កំពូល របស់ ប្រទេស ផ្ទាល់ តែម្ដង ៕ ប្រធាន សមាគម នារី ខណ្ឌ មានជ័យ ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ និង ផ្តល់ ជំនួយ សប្បុរសធម៌ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ៥គ្រួសារ នៅ ខណ្ឌ មានជ័យ
( ភ្នំពេញ ) ៖ លោកស្រី ចន គន្ធា ប្រធាន សមាគម នារី ខណ្ឌ មានជ័យ និង ជា ភរិយា របស់ អភិបាល ខណ្ឌ មានជ័យ និង លោកស្រី ទាវ ធីតា ជា អនុប្រធាន សមាគម រួម នឹង សមាជិក នៃ សមាគម ជាច្រើន នាក់ ទៀត នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន ចុះ ទៅ សួរសុខទុក្ខ និង ផ្តល់ ជំនួយ សប្បុរសធម៌ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ៥គ្រួសារ រស់ នៅ ភូមិ ព្រែក ទល់១ សង្កាត់ ស្ទឹង មាន ជយ័២ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។
លោកស្រី ចន គន្ធា ប្រធាន សមាគម នារី ខណ្ឌ មានជ័យ និង លោកស្រី ទាវ ធីតា ជា អនុប្រធាន សមាគម និង ថ្នាក់ដឹកនាំ សមាគ មួយចំនួន ទៀត បាន ឧបត្ថម្ភ ដល់ ពលរដ្ឋ ក្រីក្រ ៥គ្រួសារ ដោយ ក្នុង ១គ្រួសារ ទទួលបាន ៤០ ម៉ឺន រៀល និង ប្រេង ឆា មួយ ដប ទឹកត្រី ៣ដប ទឹក ស៊ីអ៊ីវ៣ដប អំបិល១ គីឡូ មី១ កេស និង ទឹក សុទ្ធ ១កេស និង សំភារៈ ប្រើប្រាស់ ជាច្រើន ទៀត ។
ក្នុង ឱកាស អញ្ជើញ ផ្តល់ អំណោយ សប្បុរសធម៌ នេះ ផងដែរ លោកស្រី ទាំង ពីរ រូប ក៏ បាន លើកទឹកចិត្ត ដល់ ពួកគាត់ ឲ្យ ថែរក្សា សុខភាព ឲ្យបាន ល្អ ដើម្បី មើល ការរីកចម្រើន របស់ ប្រទេស កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល នៃ កម្ពុជា ។
ជាមួយគ្នា នោះ គ្រួសារ ដែល ទទួលបាន អំណោយ នា ថ្ងៃ ដដែល នេះ ក៏ បាន ថ្លែងអំណរគុណ ដល់ លោកស្រី ចន គន្ធា ប្រធាន សមាគម នារី ខណ្ឌ មានជ័យ និង លោកស្រី ទាវ ធីតា ជា អនុប្រធាន សមាគម រួម នឹង សមាជិក នៃ សមាគម ជាច្រើន នាក់ ទៀត សូមឲ្យ មាន សុខភាព ល្អ និង បន្ត ដឹកនាំ សមាគម ឲ្យ មាន ការរីកចម្រើន ទៅ មុខ ទៀត ដើម្បី ជួយ ដល់ ជនរងគ្រោះ ជាពិសេស គឺ ស្រ្តី តែម្តង ។
លោកស្រី ចន គន្ធា ប្រធាន សមាគម នារី ខណ្ឌ មានជ័យ និង លោកស្រី ទាវ ធីតា ជា អនុប្រធាន សមាគម នេះ បាន លើកឡើង ព្រម ៗ គ្នា ថា សមាគម នារី ខណ្ឌ មានជ័យ បាន បង្កើត ឡើង ជាយូរ មក ហើយ សមាគម មួយ នេះ ផ្តោត ជា សំខាន់ ក្នុង ការជួយ ទៅដល់ ស្រ្តី និង ស្រ្តី រងគ្រោះ និង ចាស់ជរា ដែល ខ្វះខាត និង គ្មាន សមត្ថភាព ក្នុង ការបំពេញ ការងារ ដើម្បី ផ្គត់ផ្គង់ ការរស់នៅ ប្រចាំ ថ្ងៃ ៕
រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម៖ វគ្គ បណ្តុះបណ្តាល របស់ ក្រសួង រួមចំណែក លើកស្ទួយ សមត្ថភាព ប្រកួតប្រជែង របស់ កម្ពុជា
( ភ្នំពេញ ) ៖ ឥឡូវនេះ សមត្ថភាព របស់ វិស័យ ឯកជន ក្នុង ការបំពេញ ឯកសារ ដើម្បី ស្នើសុំ វិញ្ញាបនប័ត្រ ផ្លូវការ ពី ក្រសួង ពាណិជ្ជកម្ម កាន់តែ មាន ភាពប្រសើរឡើង ដែល បាន រួមចំណែក ដល់ ការពង្រឹង សមត្ថភាព ប្រកួតប្រជែង របស់ កម្ពុជា ទាក់ទង នឹង ចំណាត់ថ្នាក់ ប្រចាំ ឆ្នាំ ស្តីពី ភាពងាយស្រួល ក្នុង ការធ្វើ ធុរកិច្ច និង សន្ទស្សន៍ ប្រតិបត្តិការ ដឹកជញ្ជូន (LPI) ។ នេះ បើ តាម ការអះអាង របស់ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
« អ្វី ដែល ធ្វើឱ្យ ខ្ញុំ កាន់តែ មាន មោទនភាព គឺ វគ្គ បណ្តុះបណ្តាល នេះ បាន រួមចំណែក បង្កើន ប្រសិទ្ធភាព អភិបាលកិច្ច ល្អ ជាពិសេស ការអនុវត្ត ច្បាប់ និង ការបំពេញ នីតិវិធី ពាក់ព័ន្ធ កិច្ច សម្រួល ពាណិជ្ជកម្ម នៅក្នុង ប្រទេស កម្ពុជា » ។ លោក រដ្ឋមន្ត្រី បាន មានប្រសាសន៍ បន្ថែម ។
នៅក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន សម្តែង ការអបអរ ចំពោះ សិក្ខាកាម ទាំងអស់ ដែល បាន ប្រឹងប្រែង យកចិត្តទុកដាក់ សិក្សា ជាមួយ គ្រូ ឧទ្ទេសនាម មកពី វិទ្យាស្ថាន បណ្តុះបណ្តាល ពាណិជ្ជកម្ម និង ស្រាវ ស្រាវ និង នាយកដ្ឋាន នាំចេញ - នាំចូល រហូត បាន ប្រឡង ជាប់ ជាស្ថាពរ ។
លោក បាន ស្នើ ដល់ សិក្ខាកាម ទាំងអស់ ប្រើប្រាស់ ចំណេះដឹង ថ្មី ៗ ដែល ទទួលបាន ពី វគ្គ បណ្តុះបណ្តាល ដើម្បី អនុវត្តន៍ ការងារ ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ និង ហ៊ាន ទទួលខុសត្រូវ រាល់ ព័ត៌មាន ឬ ឯកសារ ទាំងឡាយ ដែល ផ្តល់ មក ក្រសួង ពាណិជ្ជកម្ម ស្រប តាម ខ្លឹមសារ ប្រកាស លេខ ២៥៨ព .ណ . ចបព . ប្រក ស្តីពី ការទទួលស្គាល់ អ្នកតំណាង ស្រប ច្បាប់ ក្នុង ការស្នើសុំ ចុះបញ្ជី ពាណិជ្ជកម្ម ឬ ឯកសារ នាំចេញ - នាំចូល នៅ ក្រសួង ពាណិជ្ជកម្ម ។
អធិការ ខណ្ឌ ឬស្សីកែវ បង្ក្រាប ការជួញដូរ ថ្នាំ ញៀន ឃាត់ខ្លួន ជនសង្ស័យ ២នាក់ ដកហូត ថ្នាំ ញៀន មួយចំនួន នៅ សង្កាត់ ស្វាយប៉ាក
( ភ្នំពេញ ) ៖ លោក វរសេនីយ៍ ទោ គល់ យី អធិការ នគរបាល ខណ្ឌ ឬស្សីកែវ បាន បង្ហាញ ថា នា ព្រលប់ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០១៩ កម្លាំង នគរបាល របស់ លោក បាន បង្ក្រាប ការជួញដូរ គ្រឿងញៀន ១ករណី ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ២នាក់ ដកហូត បាន ថ្នាំ ញៀន ៧កញ្ចប់ នៅ ត្រង់ ចំណុច ក្រុម ទី៨ ភូមិ លូ សង្កាត់ ស្វាយប៉ាក ខណ្ឌ ឫស្សីកែវ បន្ទាប់ពី បាន រាយការណ៍ ជូន លោក ជា ពិសី ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ និង លោក ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ។
លោក អធិការ ថា ជនសង្ស័យ ទាំង ២នាក់ និង វត្ថុតាង ពាក់ព័ន្ធ សកម្មភាព ជួញដូរ ថ្នាំ ញៀន ត្រូវបាន បន្ត នាំយក មក ឃុំ ខ្លួន សាកសួរ បណ្ដោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ឬស្សីកែវ ក្នុង ការកសាង សំណុំរឿង បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម និតិវិធី ៕
នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ អះអាង ថា ការបង្ក្រាប បទល្មើស គ្រឿងញៀន តូចតាច បាន ជោគជ័យ ទើប ឈានដល់ ការបង្ក្រាប បាន មេក្លោង ធំ
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការ រង នគរបាល ជាតិ ទទួល ផែន ប្រឆាំង គ្រឿងញៀន បាន អះអាង ថា ការបង្ក្រាប បទល្មើស គ្រឿងញៀន តូច ៗ ទទួលបាន ជោគជ័យ ទើប ឈានដល់ ការបង្ក្រាប បទល្មើស ធំ ឬ មេក្លោង បាន ជោគជ័យ ដូចគ្នា ដូច្នេះហើយ កម្លាំង សមត្ថកិច្ច ទាំងអស់ ត្រូវតែ រួម ដៃ គ្នា ដើម្បី ខិតខំ បង្ក្រាប បទល្មើស មួយ នេះ ឲ្យ ខាងតែ បាន ។
ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រយុទ្ធ ប្រឆាំង បទល្មើស គ្រឿងញៀន ឆ្នាំ ២០១៨ និង លើក ទិសដៅ បន្ដ នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « យើងខ្ញុំ បាន ណែនាំ ហើយ ថា យើង មិន អាច ចោល ករណី តូចតាច បាន នោះ ទេ យើង មាន ពិសោធន៍ ថា យើង បង្ក្រាប ករណី តូច យើង បន្ដ ស្រាវជ្រាវ ដោយ យកចិត្តទុកដាក់ ព្យាយាម យើង រកឃើញ ករណី ធំ ៗ ច្រើន បន្ថែម ទៀត ។ ជនល្មើស ទាំងអស់ នោះ គឺជា ដៃ ជើង ឬ កូន ចៅ របស់ មេក្លោង ធំ ៗ » ។
បន្ថែម ពី នេះ នាយ ឧត្តមសេនីយ៍ អគ្គ ស្នងការ រង រូប នេះ នៅតែ បន្ដ ដាក់ បទបញ្ជា ដល់ កម្លាំង មាន សមត្ថកិច្ច ត្រូវតែ បង្ក្រាប គ្រប់ មូលដ្ឋាន សម្ងាត់ របស់ សមត្ថកិច្ច រូប ណា ដែល ធ្លាក់ខ្លួន លួច រកស៊ី គ្រឿងញៀន ព្រោះថា កម្លាំង មូលដ្ឋាន សម្ងាត់ មិន អាច ឲ្យ ធ្លាក់ខ្លួន ទៅ ប្រព្រឹត្ត បទល្មើស បាន ឡើយ ហើយ បើ ប្រព្រឹត្ត ត្រូវតែ បង្ក្រាប គ្មាន ការលើកលែង ។
ទន្ទឹង នឹង ការដាក់ បទបញ្ជា ឲ្យ ខិតខំ ប្រឹងប្រែង បង្ក្រាប បន្ដ ទៀត នោះ នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ ក៏ បាន ណែនាំ ផងដែរ ថា ក្នុង ប្រតិបត្តិការ បង្ក្រាប ត្រូវតែ យកចិត្តទុកដាក់ ដើម្បី រក្សា សុវត្ថិភាព ផ្ទាល់ខ្លួន របស់ កងកម្លាំង បើ ជៀសវាង បាន កុំ ឲ្យ មាន ការផ្ទុះ អាវុធ ជាដាច់ខាត ។ ករណី បង្ក្រាប ថ្ងៃ នេះ មិន បាន ត្រូវតែ ព្យាយាម តាម បង្ក្រាប បន្ដ ទៀត នៅ ថ្ងៃ ក្រោយ ដោយ មិន ត្រូវ មាន សមត្ថកិច្ច ណា ម្នាក់ រងគ្រោះថ្នាក់ ឡើយ ។
ជាមួយគ្នា នេះ នាយក មន្ទីរ ប្រឆាំង គ្រឿងញៀន នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ លោក ឧត្តមសេនីយ៍ ឯក ឡឹក វណ្ណៈ បាន ធ្វើ ការអំពាវនាវ ដល់ កម្លាំង សមត្ថកិច្ច ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ រួមចិត្ត រួម ថ្លើម ជាមួយគ្នា ដើម្បី លុបបំបាត់ គ្រឿងញៀន ឲ្យ អស់ ពី ប្រទេស កម្ពុជា ខណៈ ឆ្នាំ ២០១៨ នគរបាល បង្ក្រាប គ្រឿងញៀន បាន ជិត ៦. ៨០០ ករណី ឃាត់ខ្លួន ជនសង្ស័យ ១៣. ៣៩៧ នាក់ និង រឹបអូស ថ្នាំ ជាង ៥០០ គីឡូក្រាម នោះ ។
ឧត្តមសេនីយ៍ ឯក ឡឹក វណ្ណៈ ក៏ បាន ណែនាំឲ្យ ខិតខំ ក្ដាប់ ជាប់ សភាពការណ៍ បទល្មើស គ្រឿងញៀន នៅ តាម មូលដ្ឋាន និង ចុះ ត្រួតពិនិត្យ ជាប្រចាំ ការធ្វើ បច្ចុប្បន្នភាព មុខ សញ្ញា ដោយ ផ្អែក លើ ផែនការប្រៀប សមរភូមិ ប្រឆាំង បទល្មើស គ្រឿងញៀន ផ្សាភ្ជាប់ ជាមួយ ការចាត់តាំង អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ។
បើ តាម លោក ឧត្តមសេនីយ៍ ប្រធាន មន្ទីរ សមត្ថកិច្ច ទាំងអស់ ត្រូវ បន្ដ ការទំនាក់ទំនង ល្អ ជាមួយ ស្ថាប័ន អយ្យការ និង តុលាការ ដើម្បី បម្រើ ការងារ ជំនាញ ក្នុង កិច្ចសហប្រតិបត្តិការ បង្ការ និង បង្ក្រាប បទល្មើស គ្រឿងញៀន ឲ្យ មាន ប្រសិទ្ធភាព និង ស្រប តាម នីតិវិធី ៕
ទេសរដ្ឋមន្ត្រី មាស សុភា អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ ត្រូវ ចងចាំ ថ្ងៃ រំដោះ ៧ មករា ឲ្យបាន គ្រប់ ៗ គ្នា . សត្រូវ របស់ ថ្ងៃ ៧ មករា គឺ របប ប៉ុល ពត
( ព្រះវិហារ ) ៖ លោក មាស សុភា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ ៗ រូប ត្រូវ ចងចាំ ជានិច្ច ថ្ងៃ រំដោះ ៧ មករា ហើយ សត្រូវ របស់ ថ្ងៃ ៧ មករា គឺ មាន តែ មួយ ប៉ុណ្ណោះ គឺ របប ប៉ុល ពត ។
បន្ថែម លើស ពី នោះ ទៅ ទៀត ទេសរដ្ឋមន្ត្រី មាស សុភា បាន បន្ដ ថា បើ យើង បាន ផឹក ទឹក យើង ត្រូវតែ ចេះ នឹក ដល់ ប្រភព នៃ ទឹក នោះ ដូច្នេះ ប្រសិនបើ គ្មាន ថ្ងៃ ៧ មករា គ្មាន ការប្តូរផ្តាច់ តស៊ូ ជា កម្លាំង សាមគ្គី ក្រោម ការដឹកនាំ របស់ សម្តេច ទាំង ៣ ក្នុង ការផ្តូល រំលំ របប កម្ពុជា ប្រជាធិបតេយ្យ ប្រល័យ ពូជសាសន៍ ប៉ុល ពត នោះ ទេ គឺ យើង ពិតជា គ្មាន អ្វី ៗ ដូច សព្វ ថ្ងៃ នេះ ឡើយ ។
លោក ទេសរដ្ឋមន្ត្រី បាន ថ្លែង យ៉ាង ដូច្នេះ ក្នុង ឱកាស ដែល លោក អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ដង្ហែ ក្បួន ព្យុះ ហយាត្រា អបអរសាទ រំលឹក ខួប អនុស្សាវរីយ៍ លើក ទី៤០ ទិវា ជ័យជម្នះ ៧មករា ( ០៧ មករា ១៩៧៩ - ០៧ មករា ២០១៩ ) ដែល រៀបចំ ដោយ រដ្ឋបាល ខេត្ត ព្រះវិហារ នា ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ ។
ក្នុង ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ឡុង សុវណ្ណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ព្រះសង្ឃ សិស្សានុសិស្ស និង ប្រជាពលរដ្ឋ ប្រមាណ ជាង ៣.០០០ នាក់ ដែល ប្រារព្ធ ធ្វើ នៅ បរិវេណ មជ្ឈមណ្ឌល កីឡា ខេត្ត ។
ក្នុង ពិធី ដ៍ មហោឡារឹក នោះ ក៏ មាន ការដើរ ជា ក្បួន ព្យុះ ហយាត្រា ចំនួន ១៨ ក្បួន យ៉ាង ស្វាហាប់ និង ទឹកមុខ ញញឹម មុះ មុត ដើម្បី ចូលរួម រំលឹក ឡើងវិញ ការចង់ចាំ នៃ ស្មារតី ៧មករា ដែល ជា ជ័យជម្នះ ជា ប្រវត្តិសាស្ត្រ របស់ ប្រជាជន កម្ពុជា ដែល កូន ខ្មែរ គ្រប់ រូប ចារ ជាប់ ក្នុង ចិត្ត នោះ ។
សុន្ទរកថា ប្រកបដោយ អត្ថន័យ និង ខ្លឹមសារ យ៉ាង ជ្រាលជ្រៅ ទាំងស្រុង ចំនួន ១១ទំព័រ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ពិតជា បាន ធ្វើឲ្យ យើង បាន នឹកឃើញ នូវ របប ខោរឃៅ នោះ ដោយ មិន អាច គ្មាន ថ្ងៃ បំភ្លេច បាន ។
សម្តេច ប្រធាន រដ្ឋសភា កម្ពុជា បាន បង្ហាញ ដល់ លោក លេខាធិការ មជ្ឈឹម បក្ស អំពី ការរៀបចំ ខួប លើក ទី ៤០ នៃ ទិវា ជ័យជម្នះ ៧មករា នា ថ្មី ៗ នេះ និង បាន ថ្លែងអំណរគុណ ចំពោះ បក្ស កម្មុយនីស្ត វៀតណាម ប្រជាជន និង កងទ័ព ស្ម័គ្រចិត្ត វៀតណាម ដែល បាន រួមចំណែក យ៉ាង ធំធេង ក្នុង ការជួយ រំដោះ ប្រជាជន កម្ពុជា ឱ្យ រួចផុត ពី របប ប្រល័យ ពូជសាសន៍ « ប៉ុល ពត » នៅ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។
សម្តេច បាន គូសបញ្ជាក់ ថា រយៈពេល ៤០ ឆ្នាំ មក នេះ កម្ពុជា បាន ខិតខំ យ៉ាង លំបាក ក្នុង ការស្តារ កសាង និង អភិវឌ្ឍ ប្រទេសជាតិ ឱ្យ មាន ការរីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ដោយ មាន ការជួយ ឧបត្ថម្ភ គាំទ្រ ពី មិត្តភ័ក្តិ ប្រទេស ជា មិត្ត ជិត ឆ្ងាយ ជាពិសេស គឺ រដ្ឋាភិបាល និង ប្រជាជន វៀតណាម ៕ រកឃើញ ស្នូល សណ្តែក មាន ជាតិ គីមី ពង មាន់ និង សាច់ មាន់ នាំ ពី វៀតណាម ត្រូវបាន មន្ត្រី កាំ កុងត្រូល ខេត្ត ស្វាយរៀង ដកហូត ទុក បំផ្លាញ ចោល
( ស្វាយរៀង ) ៖ មន្ត្រី សាខា កាំ កុងត្រូល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន សហការ ជាមួយ យោធា កង វរសេនា តូច លេខ ២ បាន ចុះ ពិនិត្យ ទំនិញ នាំចូល ពី ប្រទេស វៀតណាម តាម ច្រក កំពង់ស្ពាន ក្រុង បាវិត ខេត្ត ស្វាយរៀង ។
ជា លទ្ធផល នៃ ការធ្វើតេស្ដ ជា បឋម លើ ទំនិញ ៣៣ គំរូ ដែល ផ្តោត សំខាន់ លើ ចំណីអាហារ នោះ ក្រុមការងារ បាន ដកហូត ពង មាន់ ៩០០ គ្រាប់ សាច់ មាន់ ២០ គីឡូ និង រកឃើញ ស្នូល សណ្តែក ដែល មាន សារធាតុ គីមី បូរ៉ាក់ ផងដែរ ។
លោក ផឹង និល ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង ថា « ជា លទ្ធផល ក្រោយ ចុះ អនុវត្ត ការងារ មន្ត្រី ជំនាញ យើង បាន ដកហូត នំ ស្នូល សណ្តែក បន្ទះ ចំនួន ៣គីឡ ក្រាម មាន ផ្ទុក សារធាតុ គីមី បូរ៉ាក់ ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ និង ដកហូត ពង មាន់ ចំនួន ៩០០ គ្រាប់ សាច់ មាន់ ចំនួន ២០ គីឡូក្រាម ដែល ច្បាប់ ហាមឃាត់ ហើយ ទំនិញ ទាំងនោះ មន្ត្រី យើង ធ្វើ ការកម្ទេចចចោល ភ្លាម ៗ ផងដែរ » ។
លោក ប្រធាន សាខា កាំ កុងត្រូល បាន បញ្ជាក់ ថា សារធាតុ បូរ៉ាក់ នេះ គឺ ធ្វើឲ្យ ប៉ះពាល់ ដល់ សុខភាព ដូច ជា៖ ខូច ក្រពះ ពោះវៀន . ក្រលៀន និង អាច បង្ក ទៅជា មហារីក ធ្វើឲ្យ បែក ឈាម តាម រោម យ៉ាង ធ្ងន់ធ្ងរ ទៀត ផងដែរ ។
( កំពង់ធំ )៖ ម្សៅ ស៊ុប ម៉ាក រ៉តឌី និង ប្រហិត សាច់ មាន់ ខូច គុណភាព ត្រូវបាន រកឃើញ ក្រុម អាជីវករ យក ដាក់ លក់ នៅ ផ្សារ តាំង ក្រសាំង ដែល ផលិត ទាំងនេះ ធ្វើឲ្យ ប៉ះពាល់ សុខភាព យ៉ាង ខ្លាំង តែ ត្រូវបាន មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត កំពង់ធំ ចុះ ទៅ ប្រមូល យក ទៅ ដុត កម្ទេចចោល ។
ការរកឃើញ ម្សៅ ស៊ុប ម៉ាក រ៉តឌី និង ប្រហិត សាច់ មាន់ ទាំងនេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ ពេល មន្រ្តី សាខា កាំ កុងត្រូល សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម អាជ្ញាធរដែនដី បាន បន្ត ចុះ ពិនិត្យ ផ្សព្វផ្សាយ អំពី គុណភាព និង សុវត្ថិភាព ម្ហូប អាហារ នៅក្នុង ផ្សារ តាំង ក្រសាំង ស្ថិត នៅ ភូមិ តាំង ក្រសាំង ឃុំ តាំង ក្រសាំង ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ។
ក្រុមការងារ បាន ធ្វើតេស្ត លើ ណែម ដើម្បី រក សារធាតុ បូរ៉ាក់ តែ ជា លទ្ធផល មិន មាន សារធាតុ បូរ៉ាក់ នៅក្នុង ណែម នោះ ឡើយ ។ យ៉ាងណាមិញ ក្រុមការងារ ជំនាញ ក៏ បាន ស្វែងរក ផលិតផល តៅ ហ៊ូ ពង មាន់ . តៅ ហ៊ូមូល . តៅ ហ៊ូ ប្រអប់ ប៉ុន្តែ ពុំ មាន ឃើញ លក់ នៅលើ ទីផ្សារ ទេ ។
ទន្ទឹមនឹង នេះ ក្រុមការងារ បាន ណែនាំ ដល់ អាជីវករ ឲ្យ ចៀស វៀង ពី ការប្រើប្រាស់ សារធាតុ គីមី បន្ថែម ទៅ លើ ផលិតផល ម្ហូប អាហារ ឬ ការកែច្នៃ ម្ហូប អាហារ ដែល ធ្វើឲ្យ មាន គ្រោះថ្នាក់ ដល់ សុខភាព ៕
( ភ្នំពេញ ) ៖ ក ន្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន បញ្ជូន ជនសង្ស័យ ចំនួន ៣នាក់ ទៅកាន់ តុលាការ ដើម្បី អនុវត្ត នីតិវិធី ។
លោក លឹម គាន ហោ និង មហាជន ជាង ១ ពាន់ នាក់ ប្រារព្ធ អង្គ មីទ្ទិញ អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៤០ នៃ ទិវា ជ័យជម្ន អះ ៧ មករា នៅ ស្រុក ពញា ឮ ខេត្ត កណ្តាល
( កណ្តាល ) ៖ លោក លឹម គាន ហោ រដ្ឋមន្រ្តី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម . អនុប្រធាន ក្រុមការងារ គណៈ ពង្រឹង មូលដ្ឋាន ខេត្ត កណ្តាល និង ជា ប្រធាន គណៈ ពង្រឹង មូលដ្ឋាន ស្រុក ពញា ឮ ខេត្ត កណ្តាល នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ប្រារព្ធ ពិធី អង្គ មីទ្ទិញ អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៤០ នៃ ទិវា ជ័យជម្ន អះ ៧មករា ( ៧ មករា ១៩៧៩ - ៧ មករា ២០១៩ ) នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជជន កម្ពុជា ស្រុក ពញា ឮ ខេត្ត កណ្តាល ដែល មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ ប្រមាណ ១២៥០ នាក់ ។
ជាមួយគ្នា នេះ ដែរ ថ្នាក់ នាំ គណបក្ស ប្រជាជន កម្ពុជា នៅ តាម មូលដ្ឋាន និង ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម នៅក្នុង កម្មវិធី នា ព្រឹក នេះ បាន ប្តេជ្ញាចិត្ត ជា ធ្លុង មួយ ដើម្បី បន្ត ថែរក្សា ឱ្យ បាន ជាដាច់ខាត នូវ សុខ សន្តិភាព សម្រាប់ បន្ត ការកសាង និង ការអភិវឌ្ឍ ប្រទេស កម្ពុជា ឱ្យ មាន ការរីកចម្រើន កាន់តែ ខ្លាំងក្លា ថែម ទៀត និង ដោយ ចីរភាព ផងដែរ ៕
អភិបាល ខេត្ត ព្រះសីហនុ និង ឧកញ៉ា ឡាយ ស៊ា ឧបត្ថម្ភ ស្បៀងអាហារ និង សម្ភារ មួយចំនួន ដល់ យោធា ខេត្ត កំពង់ធំ
ក្នុង ឱកាស នេះ លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន ប្តេជ្ញាចិត្ត យក នូវ អំណោយ ដ៏ ថ្លៃថ្លា ទាំងអស់ នេះ ដើម្បី ទៅ បម្រើ សេចក្តី ត្រូវការ របស់ ប្រជាជន អតីត យុទ្ធជន និង ការប្រើប្រាស់ ក្នុង អង្គភាព ឱ្យ បាន ល្អ ប្រសើរ ។
ក្នុង ការងារ មនុស្សធម៌ នេះ ដែរ អ្នក ឧកញ៉ា ឡាយ ស៊ា បាន ឧបត្ថម្ភ អង្ករ ចំនួន ០២តោន . មី យើង ចំនួន ១០០ កេស និង កៅអី ជ័រ ចំនួន ៣០០ កៅអី បន្ថែម ទៀត ផងដែរ ៕
រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ បាន រៀបចំ ពិធី រំលឹក ខួប លើក ទី ៤០ ថ្ងៃ ជ័យជម្នះ ៧ មករា ដោយ មាន មហាជន ចូលរួម ជាង ៣ពាន់ នាក់
( កំពង់ស្ពឺ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន រៀបចំ ពិធី រំលឹក ខួប លើក ទី ៤០ ថ្ងៃ ជ័យជម្នះ ៧ មករា ក្រោម អធិបតីភាព ទេសរដ្ឋមន្ត្រី ឆាយ ថន រដ្ឋមន្ត្រី ក្រសួង ផែនការ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ ។
នៅក្នុង ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក វ៉ី សំណាង អភិបាល នៃ គណៈអភិបាល ខេត្ត កំពង់ស្ពឺ និង លោក យឹម សុខុម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កំពង់ស្ពឺ ព្រមទាំង មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស ជាង ៣.០០០ នាក់ ។ កម្មវិធី នេះ ត្រូវបាន ប្រារព្ធ ធ្វើឡើង យ៉ាង កង រំពង ជារៀងរាល់ ឆ្នាំ នៅ ទីលាន បាល់ទាត់ របស់ សាលា ខេត្ត កំពង់ស្ពឺ ។
សម្រាប់ ឆ្នាំ ២០១៩ នេះ ការអបអរសាទរ ខួប ៤០ ឆ្នាំ នៃ ថ្ងៃ ជ័យជម្នះ ៧ មករា បាន ធ្វើ យ៉ាង មហោឡារឹក អធិកអធម នៅ ពហុកីឡដ្ឋាន អូឡាំពិក ជាង បណ្តា ឆ្នាំ កន្លងទៅ ដែល មាន ការចូលរួម ពី មហាជន ជាមួយ ការរំលេចចេញ នូវ ផ្ទាំង ទស្សនីយភាព សិល្បៈ នានា ដូច ជា៖ ការឈរ តម្រៀប គ្នា ចេញ ជា រូប ទង់ជាតិ របស់ កម្ពុជា ការតម្រៀប ចេញ ជា រូបភាព ព្រាប និង អក្សរ ផ្សេង ៗ ។
ក្នុង នោះ ក៏ មាន ការបង្ហាញ ពី សមិទ្ធផល នានា កើត ចេញ ពី សុខ សន្តិភាព ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។
គណបក្ស ប្រជាជន កម្ពុជា ក៏ ដូចជា ប្រជាពលរដ្ឋ កម្ពុជា ទូទាំង ប្រទេស បាន ចាត់ទុក ថ្ងៃ ៧ មករា ឆ្នាំ ១៩៧៩ ជា ថ្ងៃ ជ័យជម្នះ ជា ប្រវត្តិសាស្រ្ត របស់ ប្រជាជន កម្ពុជា ដែល បាន វាយ ផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត បញ្ចប់ សម័យកាល ដ៏ ខ្មៅ ងងឹត បំផុត នៅ កម្ពុជា ដែល បាន កាប់ សម្លាប់ និង ធ្វើឲ្យ ប្រជាពលរដ្ឋ ខ្មែរ ស្លាប់ ជាង ៣លាន នាក់ ។ ៧មក រា ១៩៧៩ គឺជា ថ្ងៃ បើក ឡើងវិញ នូវ ទំព័រ សករាជ ថ្មី គឺ ឯករាជ្យ សេរីភាព ប្រជាធិបតេយ្យ និង វឌ្ឍនភាពសង្គម ៕
ស្អែក នេះ ព្រឹទ្ធសភា បន្ត សម័យ ប្រជុំ លើក ទី២ ដើម្បីឱ្យ យោបល់ លើ សេចក្តីស្នើ ច្បាប់ ចំនួន ២ ពាក់ព័ន្ធ នឹង រដ្ឋបាល រាជធានី - ខេត្ត - ក្រុង - ស្រុក - ខណ្ឌ
( ភ្នំពេញ ) ៖ ព្រឹទ្ធសភា បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន ផ្លូវការ អំពី លទ្ធផល នៃ កិច្ចប្រជុំ គណៈកម្មាធិការ អចិន្ដ្រៃយ៍ ព្រឹទ្ធសភា នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ ក្រោម អធិបតីភាព សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា ។ បន្ទាប់ពី បាន ពិនិត្យ និង ពិភាក្សា រួច មក គណៈកម្មាធិការ អចិន្ដ្រៃយ៍ ព្រឹទ្ធសភា បាន កំណត់ យក ព្រឹក ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០១៩ ស្អែក នេះ ដើម្បី បន្ដ សម័យ ប្រជុំ លើក ទី២ ព្រឹទ្ធសភា នីតិកាល ទី៤ ដែល មាន របៀបវារៈសំខាន់ ៗ រួម មាន៖
ទី១៖ ពិនិត្យ និង ឱ្យ យោបល់ លើ សេចក្តីស្នើ ច្បាប់ ស្តីពី វិសោធនកម្ម ច្បាប់ ស្តីពី ការគ្រប់គ្រង រដ្ឋបាល រាជធានី - ខេត្ត - ក្រុង - ស្រុក - ខណ្ឌ ។
ទី២៖ ពិនិត្យ និង ឱ្យ យោបល់ លើ សេចក្តីស្នើ ច្បាប់ ស្តីពី វិសោធនកម្ម ច្បាប់ ស្តីពី ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ ៕
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្តីប្រកាស ព័ត៌មាន របស់ ព្រឹទ្ធសភា ដូច ខាងក្រោម៖ ឱកាស ពិសេស ! ចុះឈ្មោះ រៀន ភាសា ចិន និង អង់គ្លេស ក្រៅ ម៉ោង នៅ សាលា « អន្តរជាតិ វីន » ទទួលបាន ការបញ្ចុះ តម្លៃ ៥០ %
( ភ្នំពេញ ) ៖ វិស័យ អប់រំ នៅ ប្រទេស កម្ពុជា មាន សន្ទុះ កើនឡើង យ៉ាង ខ្លាំង ដែល ធ្វើឲ្យ ប្រជាពលរដ្ឋ កម្ពុជា មាន ចំណេះដឹង ខ្ពស់ មាន សមត្ថភាព អាច ប្រកួតប្រជែង ជាមួយ ប្រជាជន នៅ លើ ពិភពលោក បាន ។ រាជ រដ្ឋាភិបាល ក៏ បាន គិតគូរ យ៉ាង ខ្លាំង លើ បញ្ហា អប់រំ ដោយ បាន ជំរុញ ឲ្យ មាន សាលា បណ្តុះបណ្តាលឲ្យ បាន ច្រើន ទាំង សាលា រដ្ឋ និង ឯកជន ផងដែរ ។
ជាក់ស្តែង សាលា « អន្តរជាតិ វីន » ដែល ជា សាលា បង្រៀន ភាសា បរទេស ផ្តល់ គុណភាព អប់រំ ប្រកបដោយ គុណធម៌ សុជីវធម៌ សីលធម៌ វិន័យ ដែល ជា ទី ទុកចិត្ត របស់ គ្រប់ អតិថិជន ។ សាលា អន្តរជាតិ នេះ ផ្តល់ ជូន លោកគ្រូ អ្នកគ្រូ ជនជាតិ ខ្មែរ និង ជនជាតិ បរទេស ដែល មាន គរុកុសល្យ អប់រំ ពី ក្រសួង អប់រំ យុវជន និង កីឡា ។
សាលា « អន្តរជាតិ វីន » ដែល មាន ទីតាំង នៅ ផ្ទះ លេខ ៤២០ ផ្លូវ ៦៩BT សង្កាត់ បឹង ទំពន់ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ មាន លោកគ្រូ អ្នកគ្រូ ជនជាតិ ខ្មែរ និង ជនជាតិ បរទេស រង់ចាំ បង្ហាត់ បង្រៀន បុត្រធីតា លោក អ្នក ប្រកបដោយ គុណធម៌ មាន ភក្តីភាព និង ពោ ពេញ ដោយ បទពិសោធន៍ ស្តង់ដារ បង្រៀន បែប កំរិត អន្តរជាតិ ផងដែរ ។ ជាមួយគ្នា នេះ ការចុះឈ្មោះ ចូលរៀន ពេលនេះ នឹង ទទួលបាន ការបញ្ចុះ តំលៃ ៥០ % ទាំង ថ្នាក់ ភាសា ខ្មែរ ថ្នាក់ ភាសា បរទេស គ្រប់ កំរិត ។
( ព្រះវិហារ ) ៖ ការប្រកួត កីឡា មហាជន ដោយ មាន កីឡាករ ចំនួន ១៨ ក្រុម មកពី បណ្តា ឃុំ ទូទាំង ស្រុក រវៀង ខេត្ត ព្រះវិហារ ត្រូវបាន រៀបចំឡើង និង ធ្វើ ការប្រកួត វិលជុំ មាន រយៈពេល ៨ ថ្ងៃ ដើម្បី អបអរសារទរ ខួប អនុស្សាវរីយ៍ លើក ទី៤០ ទិវា ជ័យ ជំនះ ៧មករា ។
នៅក្នុង ឱកាស នោះ លោក ពឹង ទ្រី ដា ប្រធាន ក្រុមការងារ ខេត្ត ចុះ ជួយ ស្រុក រវៀង បាន លើកឡើង ថា ដោយសារ ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន យក អាយុជីវិត ធ្វើជា ដើមទុន បាន ធ្វើ ការរំដោះ ប្រទេសជាតិ និង ប្រជាពលរដ្ឋ ឲ្យ ផុត ពី របប ប្រល យ័ពូជសាសន៍ នៅ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ទើប យើង មាន អ្វី ៗ គ្រប់ យ៉ាង ដូច សព្វ ថ្ងៃ នេះ . បើ គ្មាន ថ្ងៃ ៧មករា ឆ្នាំ ១៩៧៩ ទេ នោះ យើង ក៏ គ្មាន ថ្ងៃ នេះ ដែរ ។
លោក ពឹង ទ្រី ដា បាន លើកឡើង បែប នេះ នៅ ថ្ងៃទី ៨ ខែមករា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល លោក អញ្ជើញ ចូលរួម ក្នុង កម្មវិធី បិទ ការប្រកួត កីឡា មហាជន របស់ សិស្ស អនុវិទ្យាល យ័ វិទ្យាល យ័ទូទាំង ស្រុក រវៀង ។
លោក បាន លើកឡើង ថា ថ្ងៃ នេះ កាលពី ៤០ ឆ្នាំ មុន ប្រទេស កម្ពុជា របស់ យើង បាន ឆ្លងកាត់ នូវ របប មហា ឃោរឃៅ ប្រល័យ ពូជសាសន៍ ដែល ធ្វើឱ្យ ប្រជាពលរដ្ឋ ខ្មែរ ៣លាន នាក់ បាន ស្លាប់ បាត់បង់ជីវិត តាម រូបភាព ផ្សេង ៗ យ៉ាង អយុត្តិធម៌ ជា ទីបំផុត ។
ជាមួយគ្នា នោះ លោក ពឹង ទ្រី ដា បាន ថ្លែង ប្រាប់ ឲ្យ យុវជន គ្រប់ រូប ត្រូវ មាន ការចងចាំ ជានិច្ច ចំពោះ ថ្ងៃ ៧មករា ព្រោះ ជា ថ្ងៃ កំណើត ទី២ ដែល យើង មាន ជីវិត រស់រាន មកដល់ ពេលនេះ ហើយ បើ គ្មាន ថ្ងៃ ៧ មករា ទេ យើង ក៏ គ្មាន អ្វី ៗ ដូច ពេលនេះ ហើយក៏ មិន បាន ជួបជុំគ្នា ប្រារព្វ ពិធី នេះ ដែរ ។
ជនជាតិ អាមេរិក ម្នាក់ ទៀត ហើយ ត្រូវ អាជ្ញាធរ អ៊ីរ៉ង់ ចាប់ ឃុំ ខ្លួន ទាំង មិន ទាន់ បញ្ជាក់ ពី មូលហេតុ !
( តេហេរ៉ង់ ) ៖ រដ្ឋាភិបាល អ៊ីរ៉ង់ បាន ទទួលស្គាល់ ថា ពិតជា បាន ចាប់ ឃុំ ខ្លួន ពលរដ្ឋ អាមេរិក ម្នាក់ ជា លើក ដំបូង បំផុត ក្នុង អាណត្តិ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ខណៈ បច្ចុប្បន្ន ជនជាតិ អាមេរិក ០៣ នាក់ ផ្សេង ទៀត កំពុង ជាប់ ឃុំ នៅ អ៊ីរ៉ង់ ស្រាប់ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន BBC នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី១០ ខែមករា ឆ្នាំ ២០១៩ ។
គួរ បញ្ជាក់ ថា សហរដ្ឋ អាមេរិក និង អ៊ីរ៉ង់ មិន បាន រក្សា ទំនាក់ទំនង ការទូត ជាមួយនឹង គ្នា ឡើយ ដូច្នេះ រាល់ ការទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ត្រូវ ធ្វើឡើង តាមរយៈ ប្រទេស ស្វីស ៕
នេះ បើ យោង តាម របាយការណ៍ ដែល បាន បង្ហាញ ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រយុទ្ធ ប្រឆាំង បទល្មើស គ្រឿងញៀន ឆ្នាំ ២០១៨ និង លើក ទិសដៅ បន្ដ ឆ្នាំ ២០១៩ របស់ មន្ទីរ ប្រឆាំង គ្រឿងញៀន នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ ក្រោម អធិបតីភាព នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការ រង នគរបាល ជាតិ ទទួល ផែន ប្រឆាំង គ្រឿងញៀន ។
របាយការណ៍ ដដែល បញ្ជាក់ ថា ក្នុង ប្រតិបតិ្តការពេញ មួយ ឆ្នាំ នេះ កម្លាំង នគរបាល ទូទាំង ប្រទេស រឹបអូស គ្រឿងញៀន ចំនួន ៥០៨ គីឡូក្រាម ក្នុង នោះ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បង្ក្រាប បាន ចំនួន ១. ០១៧ ករណី ឃាត់ខ្លួន ជនល្មើស ១. ៧២៥ នាក់ ស្រី ២១៨ នាក់ ដោយ រឹបអូស ថ្នាំ ញៀន បាន ចំនួន ១៥៨ គីឡូក្រាម ។
ជាមួយគ្នា នេះ ក្នុង ឆ្នាំ ២០១៨មន្ទីរ ប្រឆាំង គ្រឿងញៀន បាន សហការ ជាមួយ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ខេត្ត ព្រះសីហនុ និង ខេត្ត សៀមរាប ដើម្បី រួមគ្នា បង្ការ គ្រប់គ្រង និង បង្ក្រាប បទល្មើស គ្រឿងញៀន នៅ តាម បណ្ដា ទីតាំង កម្សាន្ដ ផ្សេង ផងដែរ ។
ទីផ្សារ ដែល ទិញ អង្ករ កម្ពុជា ច្រើន ជាង គេ គឺ ទីផ្សារ សហគមន៍ អឺរ៉ុប ដែល មាន ចំនួន ជិត ២៧ម៉ឺន តោន ស្មើនឹង ៤២. ៩៨ ភាគរយ នៃ ចំនួន ដែល បាន នាំចេញ ទាំងអស់ ។
គួរគត់ សម្គាល់ ថា ប្រទេស វៀតណាម និង ប្រទេស ថៃ ដែល ជាប់ ព្រំដែន កម្ពុជា ហើយក៏ ជា ប្រទេស ផលិត អង្ករ បាន ច្រើន ផងដែរ នោះ តែ បែរជា ទិញ អង្ករ ពី កម្ពុជា ទៅ វិញ ។
សូម ជម្រាប ថា វិស័យ ស្រូវ អង្ករ កម្ពុជា កំពុង រង់ចាំ ការសម្រេច ចុងក្រោយ របស់ សហគមន៍ អឺរ៉ុប ថា តើ សហគមន៍ អន្តរជាតិ មួយ នេះ ដាក់ គំនាប ពន្ធដារ លើ អង្ករ កម្ពុជា ដែរ ឬ យ៉ាងណា ? បន្ទាប់ពី មាន បណ្តឹង មិន សម ហេតុផល ពី ប្រទេស អ៊ីតាលី និង អេស្ប៉ាញ ថា ការឲ្យ នាំចូល អង្ករ កម្ពុជា ទៅ អឺរ៉ុប ប៉ះពាល់ ដល់ កសិករ របស់ ប្រទេស ពួកគេ តែ ធាតុ ពិត កសិករ របស់ ពួកគេ ផលិត បាន តែ អង្ករស ធម្មតា ប៉ុណ្ណោះ ខណៈ កម្ពុជា នាំចេញ ទៅ អឺរ៉ុប គឺជា ប្រភេទ អង្ករ ក្រអូប ដែល អឺរ៉ុប មិន អាច ដាំដុះ បាន ៕
ស្ត្រី ម្នាក់ បើក រថយន្ត ដឹក ទំនិញ បុក រះ ម៉ូតូ ឈប់ ចាំ ភ្លើង ស្តុប បណ្តាលឲ្យ ខូចខាត ម៉ូតូ៥ គ្រឿង និង មនុស្ស ៥នាក់ រងរបួស
( ភ្នំពេញ ) ៖ សេចក្តីរាយការណ៍ បាន ឲ្យដឹង ថា នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ មាន ករណី ស្ត្រី ម្នាក់ បើក រថយន្ត ដឹក ទំនិញ បុក រះ ម៉ូតូ ប្រហែល៤ - ៥គ្រឿង បណ្តាលឲ្យ មនុស្ស ៥នាក់ រងរបួស ។
ហេតុការណ៍ នេះ កើតឡើង នៅ ចំណុច ភ្លើង ស្តុប មួយ កន្លែង ស្ថិត លើ ផ្លូវ ២១៧ ក្នុង ភូមិ ឬ ស្សី សង្កាត់ ស្ទឹងមានជ័យ ខណ្ឌ មានជ័យ ។
អ្នក ឃើញ ហេតុការណ៍ នេះ បាន បញ្ជាក់ ថា មូលហេតុ បណ្តាលឲ្យ បុក រះ នេះ ដោយសារតែ ស្ត្រី អ្នកបើកបរ នោះ ជាន់ ហ្ការថយន្ត ជ្រុល ពេល ចំណុច ផ្លូវ បត់ ។ ជន បង្ក ត្រូវបាន សមត្ថកិច្ច ឃាត់ ដើម្បី ដោះស្រាយ ៕
សូម កុំ ប្រើប្រាស់ ទូរស័ព្ទ ពេល កំពុង បើកបរ ! ស្លាប់ ២នាក់ និង របួស ៩នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៩ ខែមករា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៩ ខែមករា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៦លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ . របួស ស្រាល ៤នាក់ និង របួស ធ្ងន់ ៥នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៦លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៧គ្រឿង . រថយន្ត តូច ៤គ្រឿង . និង រថយន្ដ ធុន ធំ១ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន ល្មើស ល្បឿន . មិន ប្រកាន់ ស្ដាំ . ប្រជែង និង ស្រវឹង ។
ជីវិត រៀបការ រយៈពេល ២៥ ឆ្នាំ កន្លងទៅ នេះ ពួកគេ មាន កូន ចំនួន ៤នាក់ ក្នុង នោះ មាន កូនប្រុស ៣នាក់ និង កូនស្រី ម្នាក់ ។
យ៉ាងណា ក៏ដោយ មិន ទាន់ មាន ការប្រាប់ ឲ្យដឹង នោះ ទេ ថា ការលែងលះ គ្នា របស់ គូរ ស្នេហ៍ មហាសេដ្ឋី លំដាប់ ពិភពលោក នេះ កើតឡើង ដោយសារ មូលហេតុ អ្វី ៕
លោក Obrador ដែល ទើបតែ ឡើង កាន់ តំណែង ជា ប្រធានាធិបតី ម៉ិចស៊ីកូ កាលពី ឆ្នូ ឆ្នាំ ២០១៨ កន្លងទៅ ធ្វើការកត់សម្គាល់ បែប នេះ នៅក្នុង សន្និសីទ សារព័ត៌មាន មួយ និង បន្ទាប់ពី ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន អះអាង ថា វិបត្តិ មនុស្សជាតិ កាន់តែ រីក ធំ ឡើង នៅ ព្រំដែន ភាគ ខាងត្បូង ជាប់ នឹង ប្រទេស ម៉ិចស៊ីកូ ហើយ លោក បាន ទាមទារ ឲ្យ សភា អនុម័ត ថវិកា ដើម្បី សាងសង់ ជញ្ជាំង ព្រំដែន ជាបន្ទាន់ ។
នា ឱកាស ថ្លែង សារ តាម កញ្ចក់ ទូរទស្សន៍ ជា លើក ដំបូង ចេញពី សេតវិមាន នៅ ថ្ងៃអង្គារ សប្ដាហ៍ នេះ លោក ត្រាំ បាន លើកឡើង ដូច្នេះ ថា៖ « « ប្រជាជន អាមេរិក កំពុង រងគ្រោះ ដោយសារ ការធ្វើ អន្តោប្រវេសន៍ ខុស ច្បាប់ យ៉ាង អនាធិបតេយ្យ ។ ជញ្ជាំង ព្រំដែន គឺ ពិតជា ចាំបាច់ បំផុត សម្រាប់ ការរក្សា សន្តិសុខ តាម ព្រំប្រទល់ ដូច្នេះហើយ តើ ត្រូវ ចាំ យូរ ដល់ ពេលណា ទៀត ទើប សភា យល់ព្រម ផ្តល់ ថវិកា សម្រាប់ គម្រោង ដ៏ សំខាន់ នេះ » ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី ០៩ ខែមករា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០១៩
៤៖ នាយក រដ្ឋមន្ត្រី កម្ពុជា អំពាវនាវ កុំ ឱ្យ មាន ការដំឡើង ថ្លៃ ទំនិញ ខ្ពស់ ពេក ខណៈ ថវិកា មន្រ្តី រាជការ បាន ត្រៀម រួចរាល់ ហើយ សម្រាប់ បើក ប្រាក់ បៀវត្សរ៍ ពីរ សប្តាហ៍ ម្តង ( ចុច អាន )
៥៖ សម្តេច តេជោ ហ៊ុន សែន ប្រាប់ ឲ្យ សហជីព កុំ ញុះញង់ កម្មករ ឲ្យ ទារ បើក ផ្តាច់ប្រាក់ អតីតភាព ដែល នាំឲ្យ រោងចក្រ អាច ក្ស័យ ធន ( ចុច អាន )
៦៖ លោក ស៊ុន ចាន់ថុល គ្រោង ស្នើសុំ សម្ដេច តេជោ ហ៊ុន សែន សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ រថភ្លើង ស៊េរី ទំនើប ទើប នាំ មកដល់ កម្ពុជា ( ចុច អាន )
៧៖ ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល ប្រកាស ថា ឆ្នាំ ២០១៩នេះ ក្រុមហ៊ុន កែច្នៃ យានយន្ដ គ្មាន ច្បាប់ អនុញ្ញាត ត្រឹមត្រូវ ត្រូវតែ បិទ ចោល ទាំងអស់ ( ចុច អាន )
៨៖ រឹតបន្តឹង ច្បាប់ ចរាចរណ៍ ទ្រង់ទ្រាយ ធំ ! អភិបាល រាជធានី ភ្នំពេញ និង ស្នងការ បញ្ជា ឲ្យ ស្ទាក់ ចាប់ រថយន្ត ដឹក ទំនិញ ធុន ធំ ចេញ ចូល ម៉ោង ខុស ច្បាប់ . រថយន្ត ជិត ១០០ គ្រឿង ត្រូវបាន ឃាត់ទុក ( ចុច អាន )
៨៖ លោក ដូណាល់ ត្រាំ ថ្លែង សារ តាម កញ្ចក់ ទូរទស្សន៍ ពី សេតវិមាន៖ បញ្ហា ព្រំដែន អាមេរិក - ម៉ិចស៊ីកូ គឺជា វិបត្តិ មនុស្សជាតិ ដូច្នេះ លុយ កសាង ជញ្ជាំង ព្រំដែន ត្រូវតែ សម្រេច ! ( ចុច អាន )
១០៖ វេណេស៊ុយអេឡា កំពុង ដាក់ សម្ពាធ រហូតដល់ កូឡុំប៊ី ព្រម ប្រគល់ ក្រុម រៀប គំរោង ធ្វើឃាត លោក ប្រធានាធិបតី ម៉ាឌូរ៉ូ មក ឲ្យ វេណេស៊ុយអេឡាកាត់ទោស ! ( ចុច អាន )
១១៖ កាដូ ឆ្នាំ ថ្មី សម្រាប់ វេណេស៊ុយអេឡា ? អាមេរិក ទើប ដាក់បញ្ចូល ឈ្មោះ បុគ្គល និង អង្គភាព វេណេស៊ុយអេឡា បន្ថែម ទៀត ទៅក្នុង បញ្ជីខ្មៅ នៃ ទណ្ឌកម្ម ! ( ចុច អាន )
១៣៖ ស្វែងយ ល់៖ ជីវប្រវត្តិ នៃ ព្រះមហាក្សត្រ ម៉ាឡេស៊ី និង មូលហេតុ ឈាន ទៅដល់ ការប្រកាស ដាក់ រាជ្យ មុនពេល កំណត់ របស់ ទ្រង់ ( ចុច អាន )
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៩ ខែមក រា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៥៣៥ គ្រឿង និង ផាក ពិន័យ ៣៧៦ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៩ ខែមករា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ២.៤២៤ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៥៣៥ គ្រឿង ( ម៉ូតូ ៨០ %) អប់រំ១៥៩ គ្រឿង និង ផាក ពិន័យ ៣៧៦ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ៩ ខែមករា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ១. ៣២២ គ្រឿង . អប់រំ១១០ គ្រឿង និង ផាក ពិន័យ ២២៥ គ្រឿង ។
អតីត ទាហាន ខ្មែរ ក្រហម នៅ ខេត្ត ឧត្តរមានជ័យ ទទួលបាន ផ្ទះ ៧ខ្នង ពី សម្តេច តេជោ ហ៊ុន សែន
( ឧត្តរមានជ័យ ) ៖ អតីត ទាហាន ខ្មែរ ក្រហម ក្នុង ស្រុក ចុង កាល់ ខេត្ត ឧត្តរមានជ័យ ដែល ភាគ ច្រើន មាន ពិការភាព ព្រោះតែ ភ្លើង សង្គ្រាម ក្នុង ទសវត្សរ៍ ឆ្នាំ ៨០ ទទួលបាន ផ្ទះ សម្រាប់ ស្នាក់ នៅ ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ។
ផ្ទះ ចំនួន ៧ខ្នង ធ្វើ ពី ឈើ ប្រក់ សង្ក័ សី ទំហំ ៥ម៉ែត្រ គុណ ៥ម៉ែត្រ និង តសំយ៉ាបស័ង្កសី៣ម៉ែត្រ ត្រូវបាន លោក ទេសរដ្ឋមន្រ្តី គន់ គីម អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ចុះ ទៅ ប្រគល់ ជូន អតីត យុទ្ធជន និង ជា អតីត ទាហាន ខ្មែរ ក្រហម នៅ ភូមិ បាត់ ថ្កៅ ឃុំ ចុង កាល់ ស្រុក ចុង កាល់ ខេត្ត ឧត្តរមានជ័យ នា ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០១៩ នេះ ។ ពិធី នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ ។
ថ្លែង ក្នុង ឱកាស នោះ ទេសរដ្ឋមន្ដ្រី គន់ គីម ក៏ បាន នាំយក ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន ជូន ដល់ អតីត យុទ្ធជន បន្ទាប់មក ទេសរដ្ឋមន្ដ្រី បាន ផ្តាំផ្ញើ ដល់ សមាជិក ដែល មក រស់ នៅ ទីនេះ ត្រូវ រក្សា អនាម័យ ដើម្បី បង្ការ ជំងឺ និង ត្រូវ ចេះ ថែរក្សា ផ្ទះសម្បែង ដែល បាន ទទួល ។
ជាមួយគ្នា នោះ លោក ទេសរដ្ឋមន្ត្រី អគ្គ លេខាធិការ បាន ណែនាំ លោក អភិបាល ខេត្ត ចាត់តាំង តាម មន្ទីរ ការិយាល័យ ជុំវិញ ខេត្ត ចែក គ្នា ជួយ ឧបត្ថម្ភ ដល់ សមាជិក អតីត យុទ្ធជន ក្នុង ដំណាក់កាល ដែល ពួកគាត់ ទើប មក នៅ ថ្មី ។
ដោយ មាន សំណូមពរ ពី សមាជិក ដែល មក នៅ ទីនេះ គ្មាន ដី បង្កើន ផល នោះ លោក ទេសរដ្ឋមន្រ្តី គន់ គីម បាន ស្នើសុំ សម្តេច តេជោ ហ៊ុន សែន ហើយ ត្រូវបាន សម្តេច អនុញ្ញាត ដោះស្រាយ ដី ដែល មាន ស្រាប់ ជូន ក្នុង មួយ គ្រួសារ ២ហិកតា ។
ដោយ គោរព តាម គោល នយោបាយ ចម្បង ទាំង៣ នៃ នយោបាយ ឈ្នះ ឈ្នះ ( ធានា អាយុជីវិត . ធានា មុខរបរ អាជីព និង ធានា កម្មសិទ្ធិ ទ្រព្យសម្បត្តិ ) របស់ សម្តេច តេជោ ហ៊ុន សែន នោះ អតីត ទាហាន ខ្មែរ ក្រហម ក្នុង ខេត្ត ឧត្តរមានជ័យ ត្រូវបាន រក្សាទុក តួនាទី មុខរបរ និង ទ្រព្យសម្បត្តិ របស់ ពួកគេ ដដែល ក្រោយពេល ធ្វើ សមាហរណកម្ម នៅ ចុង ឆ្នាំ ១៩៩៨ ។
មកដល់ ពេល បច្ចុប្បន្ន អតីត ទាហាន ខ្មែរ ក្រហម ដែល ធ្លាក់ខ្លួន ពិការ ដោយសារ ភ្លើង សង្គ្រាម និង ជួប ផលលំបាក ផ្សេង ៗ ទទួលបាន ការយកចិត្តទុកដាក់ ខ្ពស់ ពី សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដូចជា ការផ្តល់ ផ្ទះសម្បែង និង ដោះស្រាយ ការលំបាក ផ្សេង ៗ ។
អតីត ទាហាន ខ្មែរ ក្រហម ទាំង ៧គ្រួសារ ដែល ទទួលបាន លំនៅដ្ឋាន សម្រាប់ ស្នាក់ នៅ និង ដី សម្រាប់ បង្កបង្កើន ផល បាន បង្ហាញ ក្តីរំភើប រីករាយ ក្នុង ចិត្ត និង ប្រកាស ដឹង គុណ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល តែងតែ គិតគូរ ចំពោះ ពួកគាត់ ៕
រដ្ឋមន្ត្រី កសិកម្ម៖ ឈើ គ្រញូង ជា ប្រភេទ ឈើ កម្រ ទើប ចាំបាច់ បង្កើត ស្ថាប័ន មួយ បន្ថែម ទប់ស្កាត់ ការកាប់បំផ្លាញ និង ជួញដូរ
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ទើបនឹង បាន សម្រេច បង្កើត ស្ថាប័ន ថ្មី មួយ បន្ថែម ទៀត គឺ « លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ ថ្នាក់ ជាតិ បង្ការ ទប់ស្កាត់ និង បង្ក្រាប ការកាប់ ការដឹកជញ្ជូន ការប្រមូល ការស្តុក ទុក និង ការនាំចេញ ឈើ គ្រញូង » ។ លោក រដ្ឋមន្ត្រី ថា ការបង្កើត លេខាធិការដ្ឋាន នេះ ឡើង ដើម្បី ទប់ស្កាត់ ការកាប់បំផ្លាញ និង ការជួញដូរ ឈើ គ្រញូង ដែល ជា ប្រភេទ ឈើ កម្រ នៅក្នុង ប្រទេស កម្ពុជា ឲ្យកាន់តែ មាន ប្រសិទ្ធភាព ថែម ទៀត ។
លោក រដ្ឋមន្ត្រី បាន អះអាង បន្ថែម ថា ក្រុមការងារ នៃ លេខាធិការដ្ឋាន នេះ មិន មែន ធ្វើ ការតែ លើ បទល្មើស ឈើ គ្រញូង មួយ មុខ ទេ គឺ អាច ធ្វើ ការងារ លើ បទល្មើស ឈើ ដទៃ ទៀត ផងដែរ ។
ឆ្លើយតប សំណួរ ថា តើ ស្ថាប័ន ថ្មី នេះ នឹង អាច បង្ក្រាប់ ទប់ស្កាត់ បទល្មើស ឈើ ក្រញូង បាន កម្រិត ណា នោះ ? លោក វេង សាខុន មិន ទាន់ អាច បញ្ជាក់ បាន ទេ ដោយ លោក គូសបញ្ជាក់ ថា បទល្មើស ជួញដូរ ឈើ ប្រណិត រួមទាំង ឈើ ក្រញូង មាន បញ្ហា ស្មុគស្មាញ ឈ្មួញ មាន ល្បិច កិច្ច កល ច្រើន ។ តែ ទោះជា យ៉ាងណា លោក វេង សា ខុន បាន ប្តេជ្ញា ប្រឹងប្រែង ទប់ស្កាត់ បទល្មើស ឈើ ក្រញូង ក៏ ដូចជា ឈើ ប្រណិត ដទៃ ទៀត ឲ្យបាន ខ្លាំងក្លា បំផុត ។
សូម បញ្ជាក់ លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ ថ្នាក់ ជាតិ បង្ការ ទប់ស្កាត់ និង បង្ក្រាប ការកាប់ ការដឹកជញ្ជូន ការប្រមូល ការស្តុក ទុក និង ការនាំចេញ ឈើ គ្រញូង នេះ មាន សមាសភាព មកពី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ក្រសួង ការពារ ជាតិ ក្រសួង មហាផ្ទៃ ក្រសួង ពាណិជ្ជកម្ម ក្រសួង បរិស្ថាន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង អភិបាល រាជធានី ខេត្ត ផងដែរ ៕
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ទើបនឹង បាន សម្រេច បង្កើត ស្ថាប័ន ថ្មី មួយ បន្ថែម ទៀត គឺ « លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ ថ្នាក់ ជាតិ បង្ការ ទប់ស្កាត់ និង បង្ក្រាប ការកាប់ ការដឹកជញ្ជូន ការប្រមូល ការស្តុក ទុក និង ការនាំចេញ ឈើ គ្រញូង » ។ លោក រដ្ឋមន្ត្រី ថា ការបង្កើត លេខាធិការដ្ឋាន នេះ ឡើង ដើម្បី ទប់ស្កាត់ ការកាប់បំផ្លាញ និង ការជួញដូរ ឈើ គ្រញូង ដែល ជា ប្រភេទ ឈើ កម្រ នៅក្នុង ប្រទេស កម្ពុជា ឲ្យកាន់តែ មាន ប្រសិទ្ធភាព ថែម ទៀត ។
មេទ័ព កម្ពុជា - ថៃ ប្តេជ្ញា រឹត ចំណង សាមគ្គីភាព និង កិច្ចសហប្រតិបត្តិការ តាម ខ្សែ របន្ទាត់ ព្រំដែន ឱ្យ បាន ល្អ ដើម្បី ភាពរីកចំរើន របស់ ប្រទេស ទាំង ពីរ
( ព្រះវិហារ ) ៖ មេទ ព័ របស់ កម្ពុជា និង មេទ ព័ របស់ ថៃ នៅ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន ប្តេជ្ញា បន្ត រឹត ចំណង សាមគ្គីភាព និង កិច្ចសហប្រតិបត្តិការ ល្អ នៅ តាម ខ្សែ របន្ទាត់ ព្រំដែន ដើម្បី ភាពរីកចម្រើន របស់ ប្រទេស និង ប្រជាពលរដ្ឋ ទាំង ពីរ ផងដែរ ។ ការប្តេជ្ញាចិត្ត របស់ មេទ័ព នៃ ប្រទេស ទាំង ពីរ នេះ ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ នៅ ច្រក អាន សេះ ស្ថិត ក្នុង ភូមិ អាន សេះ ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ។
កិច្ចប្រជុំ នេះ ភាគី កម្ពុជា ដឹកនាំ ឧត្តមសេនីយ៍ ឯក ស្រី ឌឹក មេបញ្ជាការ រង កង ទព័ជើង គោក និង ជា មេបញ្ជាការ កងពល ធំ អន្តរាគមន៍ លេខ ៣ ជា ប្រធាន គណៈ បញ្ជាការ សមរភូមិ ទិសទី១ ប្រាសាទ ព្រះវិហារ និង មាន ការចូលរួម ពី លោក ជា គឹម សេង អភិបាល ស្រុក ជាំ ក្សាន្ត ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ជាច្រើន រូប ផងដែរ ។ ចំណែក ភាគី ថៃ ដឹកនាំ ដោយ វរសេនីយ៍ ឯក ណាត់ ស៊ីអ៊ីន មេបញ្ជាការ រង កងកម្លាំង សុរះ នារី និង លោក អភិបាល ស្រុក ណាំ យឺន ខេត្ត អ៊ូប៊ុន ព្រមទាំង កងកម្លាំង ជាច្រើន រូប ផងដែរ ។
លោក បាន បន្ត ថា ដំណើរ អនុវត្តន៍ ទៅ តាម គោលការណ៍ ប្រសាសន៍ របស់ នាយក រដ្ឋមន្ត្រី ទាំង ពីរ បាន ប្រកាស បើក ច្រក អន្តរជាតិ តាម ព្រំដែន កម្ពុជា ថៃ ក្នុង នោះ មាន ច្រក អាន សេះ ជា ច្រក អន្តរជាតិ ដែរ ។ លោក ថា គណៈកម្មាធិការ ក្រសួង ខាង កម្ពុជា - ថៃ និង ខេត្ត និង ខេត្ត បាន បញ្ជូន ក្រុមការងារ មក ធ្វើ ការវាស់វែង ហើយ នៅតែ និតិវិធី ធ្វើ ទៅ តាម ច្បាប់ និង សម្រេច ជា ក្រោយ ទេ ។
លោក សង្កត់ធ្ងន់ ថា បញ្ហា ច្រក មិន មែន មួយ ឆ្នាំ អាច បើក បាន ទេ ព្រោះ ត្រូវការ ពេលវេលា វែង អាច មួយ ឆ្នាំ ឫ លើស ពី នេះ ទៀត ដើម្បី ដំណើរការបើក ឫក៍ មុននឹង បើសិនជា ដំណើរការបាន ល្អ ។ ជាមួយគ្នា នោះ លោក បាន ជម្រុញ ឱ្យ ភាគី ថៃ ត្រូវ ធ្វើ អ្វី ដែល ដូច ពីមុន ចំពោះ ការលក់ដូរ របស់ ប្រជាពលរដ្ឋ សូម ឱ្យ ធ្វើ ដូច ពីមុន កុំ ឱ្យ មាន ការ កំណត់ លើ ការទិញ លើ មុខ ទំនិញ ផ្សេង ៗ ដើម្បី ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ទាំង សងខាង ។
ដោយឡែក លោក វរសេនីយ៍ ឯក ណាត់ ស៊ី អ៉ីន ក៏ បាន ឯកភាព ចំពោះ ការស្នើរ ឡើង ដោយ ភាគី កម្ពុជា និង ជម្រុញ ឱ្យ កងកម្លាំង នៅ តាម ព្រំដែន ត្រូវ ឧស្សាហ៍ ជួបគ្នា ញឹកញាប់ ដើម្បី ដោះស្រាយ បញ្ហា ប្រឈម ផ្សេង ៗ ហើយ ចំពោះ ការស្នើរ របស់ ភាគី កម្ពុជា កុំ ឱ្យ មាន ការ កំណត់ បញ្ហា លក់ដូរ ទំនិញ រវាង ប្រជាពលរដ្ឋ នៅ ច្រក អាន សេះ នោះ លោក និង យក សំណើរ នេះ ទៅ រាយការណ៍ ជូន លោក មេបញ្ជាការ កងកម្លាំង សុរះ នារី ថៃ ដើម្បី ដោះស្រាយ នៅ ពេល ក្រោយ ៗ ទៀត ៕ កាន់តែ ពិសេស ចំណេញ កាន់តែ ច្រើន សម្រាប់ អតិថិជន ក្នុង ឱកាស ខួប៥ ឆ្នាំ របស់ BMW !
លើស ពី នេះ ទៀត លោក អ្នក នឹង មាន ឱកាស ឈ្នះ រង្វាន់ ជាច្រើន ដោយ គ្រាន់តែ អញ្ជើញ មក ទស្សនា រថយន្ត និង ចុះឈ្មោះ នៅ អគារ តាំង បង្ហាញ រថយន្ត BMW ដែល មាន ទីតាំង នៅ តាម បណ្ដោយ មហាវិថី សហព័ន្ធ រុស្សី ជិត ក្រសួង ពាណិជ្ជកម្ម តែ ប៉ុណ្ណោះ ។
* តម្លៃ ស្តង់ដារ លើ គ្រឿង បន្លាស់ និង សេវាកម្ម ជួសជុល
* ការធានា រយៈពេល ២ ឆ្នាំ រាល់ គ្រឿង បន្លាស់ និង បរិក្ខារ បំពាក់ លំអរ រថយន្ត
អនុប្រធាន សភា សហភាព អឺរ៉ុប ចូល ជួប រដ្ឋមន្ដ្រី កសិកម្ម ដើម្បី ពិភាក្សា ការងារ ទាក់ទង នឹង ដំណើរការ វិវឌ្ឍន៍ វិស័យ កសិកម្ម នៅ កម្ពុជា
ក្នុង ឱកាស នោះ ក្នុង នាម ឲ្យ រាជ រដ្ឋាភិបាល កម្ពុជា និង ក្នុង នាម លោក រដ្ឋមន្ត្រី ផ្ទាល់ លោក វេង សា ខុន បាន វាយតម្លៃ ខ្ពស់ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ សហភាព អឺរ៉ុប ដែល បាន កំពុង និង បន្ត ជួយ ឧបត្ថម្ភ ទាំង បច្ចេកទេស និង ហិរញ្ញវត្ថុ សម្រាប់ ការអភិវឌ្ឍន៍ ប្រទេស កម្ពុជា ជា រួម និង ដោយឡែក សម្រាប់ ការអភិវឌ្ឍន៍ វិស័យ កសិកម្ម ។
លោក រដ្ឋមន្ដ្រី បាន លើកឡើង ថា ពិត ណាស់ លទ្ធផល នៃ ការអភិវឌ្ឍន៍ នេះ បាន ប្រែក្លាយ ប្រទេស កម្ពុជា ពី ប្រទេស ក្រីក្រ និង អសន្តិសុខ ស្បៀង មក ជា ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ទាប ហើយ សង្ឃឹម និង ជឿជាក់ ថា តាមរយៈ ការអនុវត្ត យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល នឹង អាច ប្រែក្លាយ ប្រទេស កម្ពុជា ទៅជា ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នា ឆ្នាំ ២០៣០ និង ជា ប្រទេស មាន ចំណូល ខ្ពស់ នា ឆ្នាំ ២០៥០ ។
កាលពី ឆ្នាំ ២០១៥ ថៃ ដែល ជា ប្រទេស នាំចេញ គ្រឿង សមុទ្រ លំដាប់ថ្នាក់ លេខ បី នៅលើ ពិភពលោក បាន ទទួល ការពិន័យ កាត លឿង ពី សហភាព អឺរ៉ុប ដោយសារតែ ការធ្វើ នេសាទ គ្មាន និរន្តរភាព ហើយ វា គឺជា ការព្រមាន មួយ ដែល អាចនឹង ក្លាយជា បម្រាម ហាមឃាត់ លែង ឲ្យ នាំចេញ គ្រឿង សមុទ្រ ទៅកាន់ ទីផ្សារ អឺរ៉ុប តែម្តង ។ បន្ទាប់មក រដ្ឋាភិបាល យោធា ថៃ ក៏ បាន ចេញ ប្រតិបត្តិការ ក្តៅ បង្រ្កាប ការ នេសាទ ដែល ខុស ច្បាប់ និង ដាក់ចេញ នូវ កំណែទម្រង់ នៃ ឧស្សាហកម្ម នេះ ទាំងមូល ។
គួរ បញ្ជាក់ ថា នៅ ថ្ងៃអង្គារ សប្តាហ៍ នេះ គណៈកម្មការ អឺរ៉ុប បាន ឲ្យដឹង ថា បច្ចុប្បន្ន សហភាព អឺរ៉ុប មើលឃើញ ប្រទេស ថៃ ដែល ជា គូ ថ្មី មួយ ដែល ប្រកបដោយ ការប្តេជ្ញា រឹងមាំ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង សកម្មភាព នេសាទ ខុស ច្បាប់ ដែល ធ្វើឲ្យ ហិនហោច ធនធាន មច្ឆា នៅ ជុំវិញ ភព លោក និង បង្ក ការប៉ះពាល់ ដល់ ជន ទាំងឡាយ រស់ នៅ ប្រចាំ ថ្ងៃ ដោយ អាស្រ័យ លើ ធនធាន ក្នុង សមុទ្រ ៕ ផ្ទុះ មីន នៅ ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ បណ្តាលឲ្យ មន្រ្តី យោធា ម្នាក់ ស្លាប់
( ព្រះវិហារ ) ៖ មន្រ្តី យោធា ម្នាក់ បាន ស្លាប់ គួរឲ្យ អណោច អាធ័ម ដោយសារតែ ផ្ទុះ មីន ខណៈ ជនរងគ្រោះ កំពុងតែ ត្រួស ព្រៃ ដី ចម្ការ នៅ ភូមិ តេជោ បុស្បូវ ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ។ ភ្លាម ៗ នៅ ថ្ងៃទី ៩ ខែមករា ឆ្នាំ ២០១៩ នេះ អាជ្ញាធរ មីន ក្រោម ការណែនាំ ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ចុះ ទៅ សួរសុខទុក្ខ និង ជូន អំណោយ ដល់ ជនរងគ្រោះ ផងដែរ ។
មន្រ្តី នៃ អាជ្ញាធរ មីន បាន ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News ថា « ចំពោះ ហេតុការណ៍ នេះ សម្តច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អាជ្ញាធរ មីន មាន សេចក្តីសោកស្តាយ បំផុត បន្ទាប់ពី ទទួលបាន ព័ត៌មាន ថា មាន គ្រោះថ្នាក់ ដោយសារ គ្រាប់ មិន ទាន់ ផ្ទុះ មួយ ករណី កើតឡើង នៅ ភូមិ តេជោ បុស្បូវ ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ » ។
បើ តាម មន្រ្តី ក្នុង ឧប្បតិ្តហេតុ នោះ បាន បណ្តាលឲ្យ យោធា ម្នាក់ ស្លាប់ នៅ ពេល ដែល គាត់ កំពុង ត្រួស ព្រៃ ដី ចម្ការ បាន កាប់ ចំ គ្រាប់ ប្រភេទ ៦០មីលីម៉ែត្រ បណ្តាលឲ្យ ផ្ទុះ រងរបួស ធ្ងន់ធ្ងរ និង បាន ស្លាប់ ក្រោយពី បញ្ជូន មកដល់ មន្ទីរពេទ្យ ។
ជនរងគ្រោះ ឈ្មោះ ប្រាក់ សាខិន អាយុ ៤៦ ឆ្នាំ មាន ទីលំនៅ ភូមិ តេជោ បុស្បូវ ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ៕
មុននឹង ដាក់ លិខិត នេះ . លោក គង់ បូរ៉ា បាន ប្រកាស រួចហើយ ថា លោក នឹង ស្នើសុំ សិទ្ធិ ធ្វើ នយោបាយ ទោះបីជា មាន ការអំពាវនាវ ហាមឃាត់ ដោយ លោក សម រង្ស៉ី ដែល ជា អតីត ប្រធាន នៃ អតីត គណបក្ស សង្រ្គោះ ជាតិ ក៏ដោយ ។
ច្បាប់ ស្តីពី វិសោធនកម្ម មាត្រា ៤៥ ថ្មី ( ស្ទួន ) នៃ ច្បាប់ ស្តីពី គណបក្ស នយោបាយ ដែល ជា ការបើក ផ្លូវ ឲ្យ អ្នកនយោបាយ ជាប់ បម្រាម អាច ធ្វើ សកម្មភាព នយោបាយ របស់ ខ្លួន ឡើងវិញ នោះ ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ចេញ ព្រះរាជ ក្រម ប្រកាស ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ ហើយ កាលពី ថ្ងៃទី ០២ ខែមករា ឆ្នាំ ២០១៩ ។
សេចក្តីស្នើ ច្បាប់ វិសោធនកម្ម ច្បាប់ គណបក្ស នយោបាយ ត្រូវបាន ចុះហត្ថលេខា ដោយ តំណាងរាស្រ្ត ចំនួន ៨៧ រូប ដែល ត្រូវ រដ្ឋសភា អនុម័ត កាលពី ថ្ងៃទី ១៣ ខែធ្នូ ឆ្នាំ ២០១៨ និង ត្រូវបាន ឱ្យ យោបល់ ឯកភាព ទាំងស្រុង ដោយ ព្រឹទ្ធសភា កាលពី ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ ។
ក្រោយ ច្បាប់ នេះ ចូល ជាធរមាន លោក គង់ គាំ អតីត ប្រធាន គណបក្ស សម រង្ស៉ី និង ជា អតីត មនុស្ស ជំនិត របស់ លោក សម រង្ស៉ី នោះ បាន ដាក់ លិខិត ស្នើសុំ របស់ លោក បាន ចូល ដល់ ក្រសួង មហាផ្ទៃ តាំងពី វេលា ម៉ោង ប្រមាណ ជាង ១០៖៣០ ព្រឹក ថ្ងៃទី ០៩ ខែមករា នេះ ម្ល៉េះ ។
លោក គង់ គាំ និង លោក គង់ បូរ៉ា រួមទាំង អតីត ថ្នាក់ដឹកនាំ អតីត គណបក្ស សង្រ្គោះ ជាតិ សរុប ចំនួន ១១៨ នាក់ ត្រូវបាន តុលាការ កំពូល ចេញ សាល ដីកា ផ្អាក សកម្មភាព នយោបាយ រយៈពេល ៥ ឆ្នាំ កាលពី ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៧ បន្ទាប់ពី តុលាការ ជឿជាក់ ថា អតីត គណបក្ស ប្រឆាំង នេះ បាន ឃុបឃិត ជាមួយ បរទេស ក្នុង គោលបំណង ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ របស់ កម្ពុជា ៕
នាយ ឧត្តមសេនីយ៍ មាស សុភា អញ្ជើញ បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ លទ្ធផល នៃ អង្គ សន្និបាទ គណៈកម្មាធិការ កណ្តាល លើក ទី ៤១ អាណត្តិ ទី៥ គណបក្ស ប្រជាជន កម្ពុជា នៅ ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ នាយ ឧត្តមសេនីយ៍ មាស សុភា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស លើ កិច្ចការ មីន យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ និង ការងារ វិស្វកម្ម នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតីភាព បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ លទ្ធផល នៃ អង្គ សន្និបាទ គណៈកម្មាធិការ កណ្តាល លើក ទី ៤១ អាណត្តិ ទី៥ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
ពិធី នេះ ធ្វើឡើង នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក សួស យ៉ារ៉ា អ្នកតំណាងរាស្ត្រ មណ្ឌល ព្រះវិហារ . លោក អ៊ុន ចាន់ ដា សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ ព្រមទាំង ក្រុមការងារ ថ្នាក់ កណ្តាល ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក - ក្រុង - ឃុំ - សង្កាត់ និង ប្រធានបក្ស តាម មូលដ្ឋាន ជាច្រើន រូប ទៀត ។
សូម បញ្ជាក់ ថា សន្និបាទ គណៈកម្មាធិការ កណ្តាល លើក ទី ៤១ អាណត្តិ ទី៥ របស់ គណបក្ស ប្រជាជន កម្ពុជា បាន ដំណើរការ ពី ថ្ងៃទី ១៨ ដល់ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន កិត្តិយស គណបក្ស ។
ជាមួយគ្នា នោះ អង្គ សន្និបាទ បាន ឯកភាព ខ្ពស់ លើ ការងារ សំខាន់ ៗ ចំនួន ១១ ចំណុច ក្នុង គោលបំណង ពង្រឹង គណបក្ស ឲ្យ មាន ការ រឹងមាំ លើ គ្រប់ វិស័យ ដែល ជា កិច្ចការ មាន អត្ថន័យ កំណត់ ចំពោះ ជោគជ័យ របស់ គណបក្ស ក៏ ដូច រយៈពេល កន្លងមក ទាំង បច្ចុប្បន្ន និង តទៅ មុខ ទៀត ៕ មុខ សញ្ញា គ្រឿងញៀន ៦នាក់ ត្រូវ នគរបាល បង្រ្កាប និង ដកហូត បាន ថ្នាំ ញៀន មួយចំនួន នៅ ក្រុង ក្រចេះ
( ក្រចេះ ) ៖ កម្លាំង ជំនាញ នគរបាល ខេត្ត ក្រចេះ ក្រោម ការបញ្ជា ផ្ទាល់ ពីសំណាក់ លោក ឧត្តមសេនីយ ទោ លន់ សុផាត ស្នងការ នគរបាល ខេត្ត ក្រោម ការសម្របសម្រួល ពី ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត នា ថ្ងៃទី ៨ ខែមករា ឆ្នាំ ២០១៩ បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៦នាក់ ពាក់ ពន្ធ័ករណី ប្រើប្រាស់ ខុស ច្បាប់ នូវ សាធាតុ ញៀន នៅ ចំណុច ភូមិ ផ្សារ វែង សង្កាត់ ក្រចេះ ក្រុង ក្រចេះ ។
មន្រ្តី នគរបាល បាន ឱ្យដឹង ថា ទាំង៦នាក់ ខាងលើ រួម មាន ទី១៖ ឈ្មោះ លីវ ម៉ាដែន អាយុ ២៩ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ . ទី ២៖ ឈ្មោះ ស៊ុន ស៊ឹង អាយុ ២៨ ឆ្នាំ ( ធ្លាប់ ជាប់ ពន្ធនាគារ ) មុខរបរ មិន ពិតប្រាកដ អ្នក ទាំង ពីរ រស់ នៅ ភូមិ - ឃុំ កើត ហេតុ ដោយ ដកហូត វត្ថុតាង រួម មាន៖ ឧបករណ៍ សម្រាប ជក់ គ្រឿងញៀន មួយចំនួន ។
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង ៦នាក់ និង វត្ថុតាង ត្រូវបាន កម្លាំង ជំនាញ ឃុំ ខ្លួន បណ្ដោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ក្រុង ក្រចេះ ដើម្បី កសាង សំណុំរឿង តាម នីតិវិធី ច្បាប់ ៕ ក្រសួង កសិកម្ម បង្កើត លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ ថ្នាក់ ជាតិ ដើម្បី បង្រ្កាប ការកាប់ និង ការនាំចេញ ឈើ ក្រញូង
( ភ្នំពេញ ) ៖ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន សម្រេច បង្កើត លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ ថ្នាក់ ជាតិ ដើម្បី បង្ការ និង បង្ក្រាប ការដឹកជញ្ជូន ការប្រមូល ការស្តុក ទុក និង ការនាំចេញ ឈើ ក្រញូង ។ នេះ បើ យោង តាម សេចក្តីសម្រេច ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០១៩ នេះ ៕
ព័ត៌មាន លម្អិត សូម អាន សេចក្តីសម្រេច របស់ ក្រសួង កសិកម្ម ខាងក្រោម នេះ៖
រីករាយ ការបញ្ចុះ តម្លៃ ពិសេស គ្រប់ ប្រភេទ ពី ស្រាបៀរ ស្រស់ របស់ ម៉ូនិច ហ្វ្រេស បៀរ !
* ការផ្ដល់ជូន នេះ មាន សុពលភាព ចាប់ពី ថ្ងៃ ផ្សាយ ដំណឹង នេះ តទៅ រហូតដល់ ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០១៩ នៅតែ សាខា ព្រះមុនីវង្ស ប៉ុណ្ណោះ ៕
យោង តាម ស៊ីន ហួរ លោក គីម ក៏ បាន ប្រាប់ ប្រធានាធិបតី ចិន លោក ស៊ី ជិន ពីង ដោយ សង្ឃឹម យ៉ាង មុតមាំ ថា ភាគី ពាក់ព័ន្ធ ទាំងអស់ អាចនឹង យល់ ពី ក្ដី ព្រួយបារម្ភ ប្រកបដោយ ហេតុផល របស់ កូរ៉េ ខាងជើង ហើយ ផ្ដល់ ចម្លើយតប មកវិញ ដូច ដែល ទីក្រុង ព្យុងយ៉ាង បាន និង កំពុង ធ្វើ នា ពេល បច្ច ប្បន្ន ដើម្បី លើកកម្ពស់ ក៏ ដូចជា ស្វែងរក ដំណោះស្រាយ សម្រាប់ តំបន់ ឧបទ្វីប កូរ៉េ ។
គួរ បញ្ជាក់ ថា លោក គីម ជុង អ៊ុន បាន បញ្ចប់ ដំណើរទស្សនកិច្ច ជា លើក ទី៤ របស់ លោក ក្នុង ទីក្រុង ប៉េកាំង កាលពី ថ្ងៃពុធ ហើយ ដំណើរទស្សនកិច្ច នេះ ទៀតសោត កើត មាន ឡើង បន្ទាប់ពី មាន សេចក្ដីរាយការណ៍ ថា លោក នឹង ត្រូវ ជួប ជាមួយ លោក ដូណាល់ ត្រាំ ក្នុង កិច្ចប្រជុំ កំពូល ជា លើក ទី២នា ពេល ឆាប់ ៗ នេះ សំដៅ ដោះស្រាយ ភាព ជាប់គាំង ជុំវិញ ការលុបបំបាត់ អាវុធ នុយក្លេអ៊ែរ កូរ៉េ ខាងជើង ដែល មេដឹកនាំ ទាំង ពីរ ធ្លាប់ បាន សន្យា នៅឯ កិច្ចប្រជុំ ក្នុង ប្រទេស សិង្ហបុរី កាលពី ខែមិថុនា ឆ្នាំ ២០១៨ កន្លងទៅ ៕
ជាមួយគ្នា នេះ លោក អេង ជា សាន ក៏ បាន អញ្ជើញ ប្រជាពលរដ្ឋ រួសរាន់ ទៅ ទិញ ត្រី ធ្វើ ប្រហុក ផ្អក ត្រី ឆ្អើរ ។ល ។ សម្រាប់ ទុក បរិភោគ ប្រចាំ ឆ្នាំ ។ លោក ប្រធាន រដ្ឋបាល ជលផល ក៏ បាន អំពាវនាវ ដល់ អាជ្ញាធរ មូលដ្ឋាន សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ មេត្តា បង្ក លក្ខណៈ ងាយស្រួល ជូន ដល់ ប្រជាពលរដ្ឋ បាន ធ្វើដំណើរ ទៅ មក ស្នាក់ នៅ និង ដឹកជញ្ជូន ផលិតផល ត្រី កុំ ឲ្យ មាន ការរាំងស្ទះ តាម ការគួរ ។
រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ លោក វេង សាខុន ធ្លាប់ បាន អះអាង ថា ការប្រមូល ផល ត្រី សម្រាប់ ធ្វើ ប្រហុក ផ្អក នៅ ឆ្នាំ នេះ អាច បាន ច្រើន ជាង បណ្តា ឆ្នាំ កន្លងទៅ ព្រោះតែ ឆ្នាំ នេះ ទឹក បាន ធំ តាំងពី ដើម ឆ្នាំ ដែល អាច ឲ្យ ត្រី បំលាស់ ទីពង កូន បាន ច្រើន ។
សូម បញ្ជាក់ ភូមិសាស្ត្រ តាម បណ្តោយ ដង ទន្លេ សាប ក្នុង ស្រុក ពញាឭ ខេត្ត កណ្តាល និង រាជធានី ភ្នំពេញ ជា កន្លែង ដាក់ ដាយ ចាប់ យក ត្រី នោះ គឺជា ទីតាំង ប្រមូលផ្តុំ មួយ សម្រាប់ ប្រជាពលរដ្ឋ នាំគ្នា មក ទិញ ត្រី ធ្វើ ប្រហុក ផ្អក ក្នុង អំឡុង ចុង ខែធ្នូ និង ដើម ខែមករា ដែល ជា ពេល មួយ ត្រី ចាប់ផ្តើម បំលាស់ ទីចេញ ពី បឹង ទន្លេ សាប ៕ អ្នក ជិះ បញ្ច្រាស រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត មាន . ក្នុង យប់ មិញ សមត្ថកិច្ច ឃាត់ បាន យានយន្ត ចំនួន ៣គ្រឿង ថែម ទៀត
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការ ស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០១៩ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ០៣ គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០១៩ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន ០៣ គ្រឿង ក្នុង នោះ រួម មាន ម៉ូតូ ០៣ គ្រឿង ។
អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន បញ្ចប់ នូវ ការអនុវត្ត យុទ្ធសាស្ត្រ កៀរ គរ ចំណូល (RMS 2014-2018) ដោយ សម្រេចបាន នូវ ភាពជោគជ័យ នៃ ការធ្វើ កំណែទម្រង់ និង ទំនើបកម្ម ពន្ធដារ ដែល ក្នុង នោះ ក្នុង រយៈពេល ០៦ ឆ្នាំ ចុងក្រោយ នេះ គឺ លទ្ធផល នៃ ការគ្រប់គ្រង ប្រមូល ចំណូល ពន្ធ និង អាករ គ្រប់ ប្រភេទ តែងតែ សម្រេចបាន គ្រប់ និង លើស ផែនការ ច្បាប់ កំណត់ ។
ជាមួយគ្នា នេះ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន បង្ហាញ អំពី ការកែទម្រង់ លើ ការគ្រប់គ្រង ការបង្វិល សង អាការ លើ តម្លៃ បន្ថែម VAT-Refund និង E-refund របស់ កម្ពុជា ហើយ ទទួលបាន ការគាំទ្រ និង ជំរុញ លើកទឹកចិត្ត លើ ការងារ កំណែទម្រង់ នេះ ហើយ បញ្ជាក់ ថា អ្វី ដែល អគ្គ នាយកដ្ឋាន ពន្ធដារ កំពុង ធ្វើ គឺ កំពុង ស្ថិត ក្នុង មាគ៌ា ការវិវត្ត នៃ ប្រព័ន្ធ បច្ចេកវិទ្យា ព្រមទាំង និន្នាការ វិវត្ត របស់ ពន្ធដារ សាកលលោក ។
លោក Segev ដែល ធ្លាប់ ជា រដ្ឋមន្ត្រី ថាមពល ក្នុង ឆ្នាំ ១៩៩០ ត្រូវបាន គេ ចោទប្រកាន់ ថា ជា ទីភ្នាក់ងារ ម្នាក់ អំឡុង ពេល លោក ធ្វើការ ជា វេជ្ជបណ្ឌិត នៅ ប្រទេស នីហ្សរីយ៉ា ។ មិន តែ ប៉ុណ្ណោះ លោក ក៏ ជាប់ចោទ ពី បទ ធ្វើឱ្យ បែក ធ្លាយ ព័ត៌មាន លម្អិត របស់ មន្ត្រី អ៊ីសាអែល ជាច្រើន នាក់ និង ទីតាំង សន្តិសុខ ផងដែរ ។ លោក Segev ត្រូវបាន ឃុំ ខ្លួន នៅក្នុង ប្រទេស អេក្វាទ័រ ហ្គីណេ កាលពី ខែឧសភា ឆ្នាំ ២០១៨ ហើយ ក្រោយមក ត្រូវ បញ្ជូន មកកាន់ អ៊ីស្រាអែល ។
យោង តាម យោធា តៃវ៉ាន់ សមយុទ្ធ យោធា នឹង ត្រូវ ធ្វើឡើង ក្នុង ពេល ឆាប់ ៗ នេះ ក្នុង គោលបំណង ពង្រឹង និង សិក្សា ក៏ ដូចជា បង្កើត យុទ្ធសាស្ត្រ ការពារ ជាតិ ថ្មី ៗ សំដៅ ប្រឆាំង នឹង ការលុកលុយ ឬ ឈ្លានពាន ណាមួយ ពីសំណាក់ មហា យក្ស ចិន ។ ប៉ុន្តែ ព្រម ពេល ជាមួយគ្នា យោធា តៃវ៉ាន់ មិន ទាន់ បញ្ជាក់ អ្វី លម្អិត បន្ថែម ពី សមយុទ្ធ យោធា នេះ នៅឡើយ ទេ ។
គួរ បញ្ជាក់ ថា ចិន បាន ចាត់ទុក ថា កោះ តៃវ៉ាន់ គឺជា ខេត្ត របស់ ខ្លួន និង ក៏ បាន ព្រមាន ជាច្រើន ឆ្នាំ មកហើយ ដែរ ថា នឹង ប្រើប្រាស់ កម្លាំង យោធា វាយ យក កោះ តៃវ៉ាន់ បើសិនជា ទីក្រុង តៃ ប៉ិ ហ៊ាន ប្រកាស ឯករាជ្យ ៕
ឯក អគ្គ រដ្ឋទូត ឥណ្ឌូនេស៊ី៖ ទំនាក់ទំនង ពាណិជ្ជកម្ម ឥណ្ឌូនេស៊ី - កម្ពុជា កើនឡើង ១០ភាគរយ
( ភ្នំពេញ ) ៖ ឯក អគ្គ រដ្ឋទូត ឥណ្ឌូនេស៊ី ប្រចាំ នៅ កម្ពុជា បាន ថ្លែង ថា បើ គិត ពី ទំហំ ពាណិជ្ជកម្ម រវាង ប្រទេស ឥណ្ឌូនេស៊ី និង កម្ពុជា រយៈពេល ១០ឆ្នាំ មក នេះ បាន កើនឡើង ប្រមាណ ១០ភាគរយ និង ដោយឡែក បើ គេ គិត ពី ទំហំ ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ កាលពី អំឡុង ឆ្នាំ ២០១៨ កន្លងមក នេះ មាន ទំហំ ទឹកប្រាក់ ជាង ៦០០ លាន ដុល្លារ អាមេរិក ។
លោក ថា ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ទំហំ ពាណិជ្ជកម្ម និង ពលរដ្ឋ ប្រទេស ទាំង ពីរ មាន ទំនាក់ទំនង កាន់តែ ល្អ ប្រសើរ ហើយ ពិសេស ប្រទេស ទាំង ពីរ ក៏ បាន លើកទឹកចិត្ត ឱ្យ មាន ការបណ្តាក់ទុន ចំពោះ គ្នា ច្រើន ឡើង ដែរ ។ ជាក់ស្តែង នា ពេលនេះ ក្រុមហ៊ុន ឥណ្ឌូនេស៊ី និង កម្ពុជា រួមគ្នា បង្កើត ក្រុមហ៊ុន ឌីណា ម៉េច អាហ្គេន នេះ ឡើង ជាដើម ។
លោក ថា ក្នុង នាម ជា ជនជាតិ ឥណ្ឌូនេស៊ី លោក មាន មោទនភាព ចំពោះ ការពង្រីក ក្រុមហ៊ុន Dexa Group នៅលើ ទីផ្សារ អន្តរជាតិ ជាពិសេស នៅក្នុង ប្រទេស កម្ពុជា ។ ក្នុង នាម ជា ក្រុមហ៊ុន ឱសថ ដ៏ ល្បីល្បាញ និង ធំ បំផុត មួយ នៅក្នុង ប្រទេស ឥណ្ឌូនេស៊ី Dexa Group តែងតែ បង្ហាញ នូវ ការប្តេជ្ញាចិត្ត របស់ ខ្លួន ក្នុង ការផ្តល់ នូវ គុណ តម្លៃ បន្ថែម ទៀត សម្រាប់ អត្ថប្រយោជន៍ របស់ អតិថិជន ដៃគូ អាជីវកម្ម និង អ្នក ពាក់ព័ន្ធ ។ ជាមួយគ្នា នៅ ថ្ងៃ ខាងមុខ ក្រុមហ៊ុន នឹង មាន គម្រោង បង្កើ រោងចក្រ ឱសថ នៅ កម្ពុជា ផងដែរ ។
ដោយឡែក លោក ថម គីម សុន នាយក ប្រតិបត្តិ របស់ ក្រុមហ៊ុន ឌីណា ម៉ិច អាហ្គន ឯ . ក បាន ឱ្យដឹង ដែរ ឱសថ ដែល នាំមក ចែកចាយ លក់ តាមរយៈ កិច្ចសហប្រតិបត្តិការ រវាង ក្រុមហ៊ុន ទាំង ពីរ នេះ ជា ប្រភេទ ឱសថ ស្តង់ដា ខ្នាត អន្តរជាតិ ហើយ បើ គិត ពី តម្លៃ នោះ គឺ ថោក ជាង ឱសថ នាំចូល ដទៃ ទៀត ហេតុ នេះ អាច ជួយ សម្រួល ច្រើន ដល់ ជីវភាព និង ការថែទាំ សុខភាព របស់ ពលរដ្ឋ កម្ពុជា ៕ និពន្ធ នាយក ទស្សនាវដ្ដី ពាណិជ្ជកម្ម ជប៉ុន CBP ៖ ការវិនិយោគ របស់ ជប៉ុន កាន់តែ កើនឡើង ជាលំដាប់ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ លោក តា កាណូរិ ណា រឺ មិ និពន្ធ នាយក ទស្សនាវដ្ដី ពាណិជ្ជកម្ម ជប៉ុន CBP បាន ថ្លែង ថា ស្រប ពេល ដែល កម្ពុជា មាន សុខ សន្ដិភាព និង ស្ថេរភាព នយោបាយ ការអភិវឌ្ឍន៍ របស់ កម្ពុជា កាន់តែ រីកចម្រើន លើ គ្រប់ វិស័យ ដែល ជា ហេតុ ធ្វើឲ្យ វិនិយោគិន ពី ក្រៅ ប្រទេស មក វិនិយោគ នៅ ទីនេះ កាន់តែ ច្រើន ។
ជាក់ស្ដែង សម្រាប់ អ្នក វិនិយោគ ពី ជប៉ុន ក៏ មាន ចំនួន កាន់ ច្រើន ផងដែរ ដោយ យោង ទៅតាម របាយការណ៍ របស់ ក្រសួង ពាណិជ្ជកម្ម បាន ឲ្យដឹង ថា កាលពី ឆ្នាំ ២០១០ ក្រុមហ៊ុន ជប៉ុន នៅ កម្ពុជា មាន ត្រឹមតែ ១៩ ក្រុមហ៊ុន ប៉ុណ្ណោះ ដែល បាន ចុះបញ្ជី នៅ ក្រសួង ពាណិជ្ជកម្ម ។ ប៉ុន្តែ ចាប់ពី ឆ្នាំ ២០១៤មក មាន ក្រុមហ៊ុន ជប៉ុន ប្រមាណ ជា ជាង ២០០ ក្រុមហ៊ុន បាន ចុះបញ្ជី ធ្វើ ពាណិជ្ជកម្ម ក្នុង ប្រទេស កម្ពុជា ជារៀងរាល់ ឆ្នាំ ។
