( ភ្នំពេញ ) ៖ ២នាក់ ប្ដី - ប្រពន្ធ ត្រូវបាន នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ ចាប់ខ្លួន បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ នា ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០១៩ នេះ ពាក់ព័ន្ធ និង សំណុំរឿង ឆបោក ក្រោម រូបភាព លក់ ដី ខ្យល់ ប្រមូល ប្រាក់ ពី អ្នកទិញ ប្រមាណ ១លាន ដុល្លារ ។
មន្រ្តី នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News បាន ឲ្យដឹង ថា ជនសង្ស័យ ទាំង ២នាក់ មាន ទី១៖ ឈ្មោះ ជៀម ច័ន្ទ បុរី អាយុ ៥០ ឆ្នាំ ជា ប្រពន្ធ មាន ស្រុក កំណើត នៅ ភូមិ គោក ទ្រា ឃុំ ព្រៃ ផ្ដៅ ស្រុក ព្រៃ កប្បាស ខេត្ត តាកែវ បច្ចុប្បន្ន រស់ នៅ ផ្ទះ លេខ ៥៤៥៥ ផ្លូវ សម្បត្តិ មាស១ បុរី សម្បត្តិ មាស ភូមិ បឹង សាឡាង សង្កាត់ ឬស្សីកែវ ខណ្ឌ ឬស្សីកែវ និង ទី២៖ ឈ្មោះ អ៊ូ សៀក រ៉ាន់ អាយុ ៤៨ ឆ្នាំ ត្រូវ ជា ប្ដី ។
សប្តាហ៍ ក្រោយ ប្រមុខ ការទូត កម្ពុជា ដឹកនាំ គណៈប្រតិភូ ទៅ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន - សហភាព អឺរ៉ុប នៅ បែលហ្ស៊ិក
( ភ្នំពេញ ) ៖ លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា នឹង ដឹកនាំ គណៈប្រតិភូ អញ្ជើញ ទៅ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន - សហភាព អឺរ៉ុប ដែល នឹង ប្រព្រឹត្តទៅ នៅ ទីក្រុង ព្រុច ស៊ែល ប្រទេស បែលហ្ស៊ិក នៅ ថ្ងៃទី ២១ ខែមករា ឆ្នាំ ២០១៩ ។ នេះ បើ តាម ការប្រកាស របស់ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ។
តាម សេចក្តីប្រកាស នេះ . នៅក្នុង អំឡុង ពេល នៃ កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន និង សមភាគី អឺរ៉ុប នឹង ពិភាក្សា គ្នា អំពី វិស័យ នៃ កិច្ចសហប្រតិបត្តិការ មួយចំនួន ដែល មាន ផលប្រយោជន៍ រួម ដើម្បី សម្រេច នូវ គោលបំណង រួម មួយ នៃ សមាហរណកម្ម តំបន់ ប្រកបដោយ សន្តិភាព ស្ថិរភាព និង វិបុលភាព ។
ក្នុង អំឡុង ពេល ស្នាក់ នៅ ទីក្រុង ព្រុច សែល ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន មាន គម្រោង នឹង ជួប ទ្វេ ភាគី ជាមួយ ឯកឧត្តម ឌីឌ៉្យេ រ រ៉េនឌ័រ ឧប នាយក រដ្ឋមន្រ្តី និង ជា រដ្ឋមន្រ្តី ការបរទេស និង កិច្ចការ អឺរ៉ុប របស់ បែលហ្ស៊ិក លោកស្រី សេស៊ីលីយ៉ា ម៉ាល ស្រ្តុម ស្នងការ ពាណិជ្ជកម្ម សហភាព អឺរ៉ុប និង ជាមួយ ប្រធាន គណៈប្រតិភូ ផ្សេង ៗ ទៀត ។
បើ តាម ក្រសួង ការបរទេស កម្ពុជា . សហភាព អឺរ៉ុប បាន ក្លាយជា ដៃគូ សន្ទនា អាស៊ាន នៅ ឆ្នាំ ១៩៧៧ ហើយ ចាប់តាំងពី ពេល នោះ មក ទំនាក់ទំនង រវាង តំបន់ ទាំង ពីរ បាន ឈានដល់ កម្រិត ខ្ពស់ មួយ ដោយ គ្របដណ្តប់ លើ វិស័យ កិច្ចសហប្រតិបត្តិការ ជាច្រើន រួម មាន នយោបាយ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម សង្គម និង ការតភ្ជាប់ ជាដើម ។ ឈរ លើ ភាពជាដៃគូ ជាច្រើន ទសវត្សរ៍ នេះ កិច្ចព្រមព្រៀង ជាច្រើន ត្រូវបាន ចុះហត្ថលេខា ដែល ជា មូលដ្ឋាន ដ៏ រឹងមាំ សម្រាប់ ទិសដៅ អនាគត នៃ តំបន់ ទាំង ពីរ ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបរទេ ស៖ សន្និសីទ សារព័ត៌មាន របស់ ក្រសួង ពាណិជ្ជកម្ម ឆ្លើយតប នឹង ករណី អឺរ៉ុប ដាក់ ពន្ធ នាំចូល លើ ទំនិញ អង្ករ កម្ពុជា ត្រូវបាន ពន្យារ ពេល
( ភ្នំពេញ ) ៖ សន្និសីទ សារព័ត៌មាន ដែល រៀបចំ ធ្វើឡើង ដោយ ក្រសួង ពាណិជ្ជកម្ម ស្តីពី ចំណាត់ការ របស់ ក្រសួង ពាណិជ្ជកម្ម ក្នុង ការឆ្លើយតប ការដាក់ ពន្ធ នាំចូល លើ ទំនិញ អង្ករ កម្ពុជា ដែល ត្រូវ រៀបចំ នៅ វេលា ម៉ោង ៤រសៀល ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០១៩ ត្រូវបាន ពន្យារ ពេល ទៅ ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០១៩ស្អែក នេះ វិញ ។
ថ្លែង ប្រាប់ ក្រុម អ្នកយកព័ត៌មាន ដែល កំពុង អង្គុយ រង់ចាំ យក ព័ត៌មាន នៅក្នុង សន្និសីទ នេះ លោក ស៊ាង ថៃ អ្នកនាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម បាន បញ្ជាក់ ថា ដោយសារតែ ក្រសួង ទើបតែ ទទួលបាន សំណុំ ឯកសារ ពី គណៈកម្មាការ អឺរ៉ុប ពាក់ព័ន្ធ នឹង ការសម្រេច យក ពន្ធ នាំចូល អង្ករ របស់ កម្ពុជា និង មីយ៉ាន់ម៉ា ដូច្នេះ ក្រសួង មិន ទាន់ ស្វែងយល់ នៃ ខ្លឹមសារ នេះ អស់ នៅឡើយ ។
លោក ស៊ាង ថៃ បាន បន្ថែម ទៀត ថា ហេតុ ដូច្នេះ ក្រសួង សុំ មិន ធ្វើ សន្និសីទ សារព័ត៌មាន ឆ្លើយតប នឹង ករណី អឺរ៉ុប ដាក់ ពន្ធ នាំចូល លើ ទំនិញ អង្ករ កម្ពុជា នៅ ថ្ងៃ នេះ ទេ ដោសូម ពន្យារ ពេល លើក ទៅ វេលា ម៉ោង ២៖៣០ រសៀល ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០១៩ ស្អែក វិញ ។
សូម ជម្រាប ថា ការសន្និសីទ របស់ ក្រសួង ពាណិជ្ជកម្ម ធ្វើឡើង បន្ទាប់ពី គណៈកម្មការ អឺរ៉ុប បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន មួយ បញ្ជាក់ ថា សហគមន៍ មួយ នេះ នឹង ចាប់ផ្តើម គិត ពន្ធ លើ ការនាំចូល អង្ករ របស់ កម្ពុជា និង ប្រទេស មីយ៉ាន់ម៉ា ដែល នាំចេញ ទៅកាន់ ប្រទេស ដែល ជា សមាជិក អឺរ៉ុប ចំនួន ២៨ ប្រទេស សម្រាប់ រយៈពេល ៣ ឆ្នាំ ចាប់ពី ឆ្នាំ ២០១៩ - ២០២១ ។
បណ្ឌិត សុខ ទូច ជំរុញ ឱ្យ បញ្ញវន្ត ខ្មែរ ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី អភិវឌ្ឍ កម្ពុជា ឱ្យ រីកចម្រើន លើ គ្រប់ វិស័យ បន្ថែម ទៀត
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត សភាចារ្យ សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន ជំរុញ ដល់ ក្រុម បញ្ញា វន្ត ខ្មែរ ទាំងអស់ ឱ្យ ចូលរួម សហការ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី លើកស្ទួយ និង អភិវឌ្ឍ ប្រទេស កម្ពុជា ឱ្យ មាន ការរីកចម្រើន លើក គ្រប់ វិស័យ បន្ថែម ទៀត ។
ការជំរុញ របស់ ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា រូប នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០១៩ នៅក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង សិក្ខាសាលា ផ្សព្វផ្សាយ លើ សេចក្តីព្រាង ស្តីពី « គោល នយោបាយ ជាតិ ស្តីពី ភាសា ខ្មែរ » ដែល រៀបចំឡើង ដោយ ក្រុមប្រឹក្សា ជាតិ ភាសា ខ្មែរ ( ក . ជ. ភ.ខ ) នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា នៅ សណ្ឋាគារ ភ្នំពេញ ។
លោក បណ្ឌិិត សុខ ទូច បាន ថ្លែង ថា បញ្ញវន្ត ទាំងអស់ និយាយ ហើយ ត្រូវតែ នាំគ្នា ធ្វើ មិន មែន គ្រាន់តែ និយាយ រួច តែ ពី មាត់ រួច អង្គុយ ចាំ មើល គ្នា នោះ ទេ សូម កុំ នាំគ្នា ក្តិច ត្រួយ គ្នា ឈ្នានីស គ្នា ត្រូវ នាំគ្នា ធ្វើ ទាំងអស់ គ្នា ដើម្បី ជា ផលប្រយោជន៍ សម្រាប់ ប្រទេសជាតិ របស់ យើង ទាំងអស់ គ្នា ។ សូម ក្រុម បញ្ញវន្ត ទាំងអស់ កុំ ធ្វើ អ្វី រង់ចាំ តែ នាយក រដ្ឋមន្ត្រី តែ ម្នាក់ឯង ឱ្យ សោះ ។
លោក សុខ ទូច បាន បញ្ជាក់ ថា បញ្ញវន្ត ត្រូវ ដើរ តួនាទី សំខាន់ ខ្លាំង ណាស់ ក៏ ដូចជា រឿង និទាន ធំ ៗ ត្រូវតែ សរសេរ ជា ភាសា ខ្មែរ ដើម្បីឱ្យ ក្មេង ៗ អាន សម្រាប់ បណ្តា ប្រទេស នានា គេ មាន ការរៀបចំ រួចហើយ សម្រាប់ បញ្ហា នេះ ដូច្នេះ ក្រុម បញ្ញវន្ត ទាំងអស់ ត្រូវ នាំគ្នា ជួយ គិត ដើម្បិី បណ្តុះបណ្តាល កុមារ ឱ្យ មាន មូលដ្ឋានគ្រឹះ ពីក្រោម ឡើង មក លើ ដើម្បី បង្ហាញ ពី មោទនភាពជាតិ ខ្មែរ ៕ រដ្ឋមន្ដ្រី កសិកម្ម ដឹកនាំ មន្ដ្រី ជំនាញ ចូលរួម ស្តាប់ បទបង្ហាញ ពី អ្នកស្រាវជ្រាវ វិទ្យាសាស្ត្រ លើ ដំណាំ ស្រូវ នៅ ប្រទេស ហ្វីលីពីន
បទបង្ហាញ នេះ ធ្វើឡើង ដើម្បី រួមគ្នា ពិភាក្សា ផ្លាស់ប្តូរ បទពិសោធន៍ ការងារ ស្តីពី យុទ្ធសាស្រ្ត អភិវឌ្ឍ វិស័យ ស្រូវ អង្ករ យន្តការ នៃ ការផលិត និង ការបង្កាត់ ពូជ ស្រូវ តាម តម្រូវចិត្ត និង តម្រូវការ ទីផ្សារ បង្កើន តម្លៃ បន្ថែម លើ ផលិកម្ម ដំណាំ ស្រូវ ការបំពេញ ខ្សែ ចង្វាក់ ផលិតកម្ម កសិកម្ម ការធ្វើ ទំនើបកម្ម កសិកម្ម ការធ្វើ កសិកម្ម តាម កិច្ចសន្យា បញ្ហា ប្រឈម និង គម្រោង ពាក់ព័ន្ធ នានា ។
ជាមួយគ្នា នោះ លោកស្រី បណ្ឌិត ក៏ បាន ធ្វើ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ប្រទេស កម្ពុជា ដែល បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការផ្គត់ផ្គង់ អង្ករ ទៅ ទីផ្សារ ពិភពលោក និង សាទ រ ដែល កម្ពុជា ទទួលបាន ចំណាក់ ថ្នាក់ លេខ ១ ក្នុង ក្របខណ្ឌ អង្ករ ល្អ ជាង គេ លើ ពិភពលោក ជា លើក ទី៤ ។
លោកស្រី បាន បញ្ជាក់ ថា ការកើនឡើង នៃ តម្រូវការ នៃ អង្ករ ពី ប្រជាជន ទូទាំង ពិភពលោក នេះ ទាមទារ ឲ្យ វិទ្យាស្ថាន បង្កើន សកម្មភាព ទាំង ការងារ ស្រាវជ្រាវ បច្ចេកវិទ្យា ថ្មី ទំនើប យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ និង កិច្ចសហប្រតិបត្តិការ ជាមួយ គ្រប់ ដៃគូរ ពាក់ព័ន្ធ ធ្វើ យ៉ាងណា បង្កើន ផលិតភាព ផលិតកម្ម ដំណាំ ស្រូវ ស្រប តាម យន្តការ ទំនើបកម្ម កសិកម្ម ដើម្បី ធានា ដល់ សន្តិសុខ ស្បៀង និង ចូលរួម លើកកម្ពស់ សេដ្ឋកិច្ច គ្រួសារ និង កាត់បន្ថយ ភាពក្រីក្រ ។
ក្នុង ឱកាស នោះ តាង នាម ឲ្យ រាជ រដ្ឋាភិបាល នៃ កម្ពុជា និង រូបលោក ផ្ទាល់ លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ ជូន ចំពោះ វិទ្យាស្ថាន ដែល បាន និង កំពុង ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង កាអភិវឌ្ឍ វិស័យ ស្រូវ អង្ករ នៅ កម្ពុជា ហើយ លោកសង្ឃឹម និង ជឿជាក់ ថា វិទ្យាស្ថាន នឹង បន្ត ជួយ ដល់ រាជ រដ្ឋាភិបាល ធ្វើ យ៉ាងណា សម្រេច ឲ្យបាន នូវ ចក្ខុវិស័យ ក្នុង ការប្រែក្លាយ ប្រទេស ទៅជា ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នា ឆ្នាំ ២០៣០ ។
ពាក់ព័ន្ធ នឹង ប្រធានបទ ខាងលើ លោក រដ្ឋមន្ត្រី វេង សា ខុន បាន គូសបញ្ជាក់ ផងដែរ ថា កិច្ចសហប្រតិបត្តិការ យ៉ាង ល្អ ប្រសើរ នេះ ត្រូវបាន ពង្រឹង និង ពង្រីក មួយ កម្រិត បន្ថែម ទៀត តាមរយៈ ទស្សនកិច្ច ផ្លូវការ នា ថ្ងៃ នេះ ព្រម ជាមួយ លទ្ធផល ជា ផ្លែ ផ្កា ដែល ទទួលបាន ពី កិច្ចពិភាក្សា រវាង ភាគី ទាំង ពីរ ដោយ ភាគី ទាំង ពីរ បាន ឯកភាព រួម គ្នា៖
រដ្ឋមន្រ្តី ក្រសួង ធម្មការ និង សាសនា សំណូមពរ ឲ្យ អាចារ្យ ទាំងអស់ ត្រូវ បន្ត ខិតខំ រៀនសូត្រ នូវ គម្ពីរ ក្បួន ច្បាប់ ឱ្យ បាន ជ្រៅជ្រះ ថែម ទៀត
( ភ្នំពេញ ) ៖ ទេសរដ្ឋមន្រ្តី ហ៊ឹម ឆែម រដ្ឋមន្រ្តី ក្រសួង ធម្មការ និង សាសនា បាន សំណូមពរ ឲ្យ អាចារ្យ ទាំងអស់ ត្រូវ ខិតខំ លើកកម្ពស់ ប្រពៃណី និង ទំនៀមទម្លាប់ ខ្មែរ ឱ្យ បាន គត់ មត់ ។
លោក សូម ឱ្យ អាចារ្យ ទាំងអស់ ត្រូវ បន្ត ខិតខំ រៀនសូត្រ នូវ គម្ពីរ ក្បួន ច្បាប់ ឱ្យ បាន ជ្រៅជ្រះ ថែម ទៀត ដើម្បីឱ្យ ការអនុវត្តមាន ភាពត្រឹមត្រូវ ទៅ តាម ក្បួន ច្បាប់ បុរាណ ខ្មែរ ទើប អាច ថែរក្សា បាន គង់វង្ស និង រីកចម្រើន នូវ អត្តសញ្ញាណ របស់ ជាតិ យើង ។ ការសំណូមពរ របស់ លោក ទេសរដ្ឋមន្ត្រី បាន ធ្វើឡើង ក្នុង ពិធី បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី តួនាទី ភារកិច្ច និង ក្រមសីលធម៌ អាចារ្យ ខ្មែរ ជំនាន់ ទី ៣១ នៅ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០១៩ ។
លោក ទេសរដ្ឋមន្ត្រី បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ បុគ្គលិក នៃ ក្រសួង ធម្មការ និង សាសនា ក៏ ដូចជា នាយកដ្ឋាន ស្រាវជ្រាវ ផ្សព្វផ្សាយ ព្រះពុទ្ធ សាសនា ផ្សារភ្ជាប់ សង្គម និង អង្គភាព ពាក់ព័ន្ធ ដែល បាន ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ បង្កើត ឱ្យ មាន ការវិវត្ត រីកចម្រើន ថ្មី ៗ បន្ថែម ទៀត ទាក់ទង ទៅ នឹង ការថែរក្សា និង អភិរក្ស នូវ វប្បធម៌ ប្រពៃណី ទំនៀម - ទម្លាប់ របស់ ជាតិ សំដៅ រួមចំណែក កសាង ធនធាន មនុស្ស និង លើកស្ទួយ វិស័យ វប្បធម៌ សាសនា ។
ជាពិសេស គឺ ការចែករំលែក ចំណេះដឹង ដើម្បី តម្រង់ ទិស របៀប រៀបចំ ពិធី មង្គល និង ពិធី បុណ្យ ផ្សេង ៗ ដោយ មាន ការចូលរួម យ៉ាង សកម្ម ប្រកបដោយ ស្មារតី ព្យាយាម យកចិត្តទុកដាក់ និង ឆន្ទៈ មុះ មុត របស់ ព្រះឧទ្ទេសាចារ្យ ឧទ្ទេសាចារ្យ ក្នុង ការបង្ហាត់ បង្រៀន ផ្ទេរ ចំណេះដឹង ដើម្បី បំពេញ បន្ថែម នូវ ចំណេះដឹង ចំណេះ ធ្វើ ដល់ សិក្ខាកាម អាចារ្យ រហូតដល់ ទទួលបាន ជា ផ្លែ ផ្កា គួរ ជា ទី មោទនៈ ។
លោក បន្ត ថា សមិទ្ធផល នានា ដែល សម្រេចបាន តាមរយៈ ការបណ្តុះបណ្តាល ស្តីពី តួនាទី ភារកិច្ច និង ក្រមសីលធម៌ អាចារ្យ ខ្មែរ ដែល បង្ហាញ ថា តែងតែ បាន យកចិត្តទុកដាក់ អនុវត្តន៍ គ្រប់ មធ្យោយ បាយ ដើម្បី ធានា ដល់ ការអភិវឌ្ឍ និង អភិរក្ស នូវ កេរមត៌ក វប្បធម៌ ដ៏ ល្អ ផូរផង់ របស់ ជាតិ ។ កិច្ចការ ដែល បាន នឹង កំពុង ធ្វើ នេះ គឺ រក្សា បាន នូវ ការអភិរក្ស និង អភិវឌ្ឍ ប្រពៃណី ទំនៀមទម្លាប់ វប្បធម៌ អរិយធម៌ និង សាមគ្គីភាព ដ៏ យូរ លង់ របស់ ដូនតា ខ្មែរ ។
សម្បត្តិ ធនធាន និង កេរមរតក ទាំងអស់ នេះ គឺជា មូលធន សង្គម ដ៏ ចាំបាច់ និង មាន តម្លៃ មិន អាច កាត់ថ្លៃ បាន សម្រាប់ ការកសាង សង្គម កម្ពុជា មួយ ដែល មាន កោសិកា ផ្សារភ្ជាប់គ្នា ដ៏ រឹងមាំ មាន ប្រជាជន ដែល មាន ចំណេះដឹង ជ្រៅជ្រះ ច្បាស់លាស់ អំពី វប្បធម៌ ប្រពៃណី និង ទំនៀមទម្លាប់ របស់ ជាតិ ខ្លួន រស់ នៅក្នុង ជីវភាព ថ្លៃថ្នូរ ប្រកបដោយ សុខ សន្តិភាព មាន ភាពសុខុដុមរមនា និង មាន ការអភិវឌ្ឍ ប្រកបដោយ ចិរភាព និង វិបុលភាព ។
លោក យល់ ថា សមិទ្ធផល ទាំងឡាយ ដែល នឹង កើត ចេញ ពី វគ្គ បណ្តុះបណ្តាល នេះ គឺ មិន ត្រឹមតែ ជា មោទនភាព និង ជា ប្រយោជន៍ សម្រាប់ តែ សិក្ខាកាម ផ្ទាល់ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ វា ក៏ ជា មោទនភាព របស់ សង្គមជាតិ ទាំងមូល ដែរ ដោយ នឹង ទទួលបាន នូវ ធនធាន អាចារ្យ បន្ថែម ទៀត ដែល មាន ចំណេះដឹង ត្រឹមត្រូវ តាម ក្បួន ច្បាប់ ពី បុរាណ សម្រាប់ ចូលរួមចំណែក និង ជួយ ជំរុញ ដំណើរការអភិវឌ្ឍ សង្គម ដោយ រក្សា បាន នូវ វប្បធម៌ ដ៏ ផូរផង់ និង អត្តសញ្ញាណ ជាតិ ផងដែរ ។
តាមរយៈ វគ្គ បណ្តុះបណ្តាល នេះ លោក ទេសរដ្ឋមន្ត្រី ហ៉ឹម ឆែម បាន សង្ឃឹម ថា សិក្ខាកាម នឹង ប្រព្រឹត្ត នូវ អំពើ ទាំងឡាយ ដែល ជា ប្រយោជន៍ ដល់ សង្គម ដែល ក្នុង នោះ រួមទាំង ការអប់រំ ឬ ការប្រៀន ប្រដៅ កូន ចៅ ដើម្បី ពត់ ចិត្ត គំនិត ម នោសញ្ចេតនា ឱ្យ ស្គាល់ យល់ដឹង ពី តម្លៃ នៃ សីលធម៌ ដ៏ ខ្ពង់ខ្ពស់ ដែល ជា កេរមរតក ពី ដូនតា និង ការប្រព្រឹត្តទៅ តាម គន្លង ធម៌ នៃ ព្រះពុទ្ធ សាសនា ផងដែរ ។
គួរ ជម្រាប ថា ការទទួលស្គាល់ ពី ដំណើរទស្សនកិច្ច ទៅកាន់ សហរដ្ឋ អាមេរិក របស់ លោក Liu He កើត មាន ឡើង តែ ជាង ០២ ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី មន្ត្រី ពាណិជ្ជកម្ម ចិន និង អាមេរិក បាន ជួបប្រជុំគ្នា ក្នុង ជំនួប ថ្នាក់ អនុ រដ្ឋមន្ត្រី នៅឯ ទីក្រុង ប៉េកាំង ជាមួយ ការអះអាង ដូចគ្នា ពី ភាពជឿនលឿន ឆ្ពោះ ទៅរក ដំណោះស្រាយ បញ្ចប់ ជម្លោះ ពាណិជ្ជកម្ម រវាង មហា យក្ស សេដ្ឋកិច្ច ទាំង ២៕
នាវា ទេសចរណ៍ យក្ស១ គ្រឿង នាំ ភ្ញៀវ ចម្រុះ ជាតិ សាសន៍ ជិត ៤ពាន់ នាក់ មក លេង នៅ កម្ពុជា
ភ្ញៀវ ទេសចរ បាន ធ្វើដំណើរទស្សនា នៅ តាម តំបន់ រមណីយដ្ឋាន នានា ក្នុង ខេត្ត ព្រះសីហនុ តំបន់ នេសាទ ស្ថិត ក្នុង សង្កាត់ លេខ ១ ក្រុង ព្រះសីហនុ ទីប្រជុំ ផ្សារ និង តាម តំបន់ ឆ្នេរសមុទ្រ ជាដើម ៕ ម្ហូប អាហារ ពុំ មាន សុវត្ថិភាព ជាង ៦៦តោន ត្រូវបាន រកឃើញ និង កម្ទេចចោល នៅ ឆ្នាំ ២០១៨. រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម ប្តេជ្ញា អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ លើ ការត្រួតពិនិត្យ គុណភាព ចំណី ម្ហូប អាហារ
( ភ្នំពេញ ) ៖ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម នៅ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន លើកឡើង ថា ដើម្បី ឆ្លើយតប ឲ្យ ទាន់ ពេលវេលា ចំពោះ ទំនិញ មាន ផ្ទុក សារធាតុ គីមី ឬ ខូច គុណភាព ក្រសួង និង ស្ថាប័ន កាំ កុងត្រូល នឹង ចូលរួម កែតម្រូវ គោល នយោបាយ ដើម្បី គ្រប់គ្រង នូវ កិច្ចការ សមស្រប ទៅ តាម ច្បាប់ កំពុង អនុវត្តន៍ ទៅ លើ សុវត្ថិភាព ម្ហូប អាហារ ការពារ អ្នកប្រើប្រាស់ និង ភាពប្រកួតប្រជែង ឲ្យ មាន សមភាព ។
សម្រាប់ ឆ្នាំ ២០១៨ កន្លងទៅ ម្ហូប អាហារ ពុំ មាន សុវត្ថិភាព ជាង ៦៦តោន ត្រូវបាន រកឃើញ និង កម្ទេចចោល ( បន្លែ គ្រឿង សមុទ្រ សាច់ ស្រស់ មាន សារធាតុ គីមី ហាមឃាត់ និង សំណល់ ថ្នាំ កសិកម្ម ) ។
ការលើកឡើង យ៉ាង ដូច្នេះ របស់ លោក ប៉ាន សូរស័ក្តិ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក អញ្ជើញ ចូលរួម សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ រថយន្ត ពិសោធន៍ ចល័ត ផ្នែក ម្ហូប អាហារ នា ព្រឹក ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០១៩ នេះ ដែល រៀបចំ ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង ពាណិជ្ជកម្ម ។
លោក ប៉ាន សូរស័ក្ដិ បាន បញ្ជាក់ ថា « ក្នុង កិច្ចការ នេះ ជា កិច្ចការ ទាំងមូល របស់ កំា កុងត្រូល នៅ ទូទាំង ប្រទេស ទោះបីជា យើង មិន ឈរជើង នៅ តាម ច្រក ព្រំដែន អន្តរជាតិ ក៏ដោយ ប៉ុន្តែ នឹង ឈរជើង នៅ តាម មន្ទីរពិសោធន៍ ខ្នាត តូច ដែល នៅជាប់ ព្រំដែន អន្តរជាតិ ដើម្បី ការពារ និង ផលប្រយោជន៍ ទាំងមូល ជូន ប្រជាពលរដ្ឋ » ។
ទាក់ទិន នឹង ការប្រកាស របស់ សម្តេច នាយក រដ្ឋមន្រ្តី នា ពេល កន្លង ថា ដក ផ្នែក កាំ កុងត្រូល នៅ តាម ច្រក ព្រំដែន ដែល ទុកឲ្យ ផ្នែក គយ និង អន្តោសប្រវេសន៍ បំពេញ ការងារ លោក រដ្ឋមន្រ្តី បាន បញ្ជាក់ ថា នេះ ជា កិច្ចការ មួយ ដែល ប្រទេស ជាតិ ត្រូវ ឈានចូល ដល់ ការប្រកួតប្រជែង អន្តរជាតិ ហើយ ដែល ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ទាប ដល់ ឆ្នាំ ២០៣០ ចំណូល កម្រិត ខ្ពស់ ។
លោក រដ្ឋមន្ដ្រី បន្ដ ទៀត ថា ហើយ នេះ ក៏ ជា កិច្ចការ មួយ ដែល យើង ត្រូវ រៀបចំ ដោយ ខ្លួន ឯង ដើម្បី ទាក់ទាញ អ្នក វិនិយោគ និង បង្កើន នូវ ភាព ប្រកួតប្រជែង សម្រាប់ ឲ្យ វិនិយោគិន អាច ចូលមក វិនិយោគ នៅ កម្ពុជា កាន់តែ ច្រើន ថែម ទៀត ។ ដូច្នេះ ការត្រួតត្រា នូវ វិស័យ ទំនិញ នាំចូល និង អ្វី ៗ ដែល នាំចូល ពី អន្តរជាតិ និង ការធ្វើ វិនិយោគ ក៏ ធ្វើឲ្យ កាត់បន្ថយ ពេលវេលា មាន ភាព ចំណេញ សម្រាប់ អ្នក វិនិយោគ ច្រើន ផងដែរ ។
សូម ជម្រាប ថា គិត មក ទល់ បច្ចុប្បន្ន អគ្គ នាយកដ្ឋាន កាំកុងត្រូល នៃ ក្រសួង ពាណិជ្ជកម្ម បាន សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ រថយន្ត មន្ទីរពិសោធន៍ ចល័ត ៣ គ្រឿង ហើយ ក្នុង នោះ ២គ្រឿង សម្រាប់ ត្រួតពិនិត្យ និង វិភាគ ផលិតផល ម្ហូប អាហារ និង ១ គ្រឿង ផ្សេង ទៀត សម្រាប់ ត្រួតពិនិត្យ គុណភាព ប្រេង និង បរិមាណ ប្រេង នៅ តាម ស្ថានីយ ប្រេងឥន្ធនៈ នៅ ទូទាំង ប្រទេស កម្ពុជា ដែល ក្នុង ១ គ្រឿង មាន តម្លៃ ជាង ១០ម៉ឺន ដុល្លារ អាមេរិក ៕
វេជ្ជបណ្ឌិត ត្រាន់ ថាញ់ ទុង បន្ថែម ទៀត ថា មន្ទីរពេទ្យ ជោរៃ នឹង បន្ត ធ្វើ ការងារ មនុស្សធម៌ បែប នេះ ជាមួយនឹង ក្រុមហ៊ុន ឱសថស្ថាន DHG Phama ទៀត នៅក្នុង ឆ្នាំ ២០១៩ នេះ ហើយ ថែមទាំង ចង់ ធ្វើការ មនុស្ស បែប នេះ ជាមួយនិង ក្រុមហ៊ុន ផ្សេង ៗ ដែល មាន បំណង ចង់ ព្យាបាល អ្នកជំងឺ នៅ កម្ពុជា ផងដែរ ។
សូម ជម្រាប ថា កម្មវិធី ពិនិត្យ និង ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ជូន អ្នកជំងឺ នេះ គឺជា កម្មវិធី មនុស្សធម៌ ដ៏ មាន អត្ថន័យ របស់ មន្ទីរពេទ្យ ជោរៃ ភ្នំពេញ និង ក្រុមហ៊ុន ឱស ថ DHG Pharma ចូលរួមចំណែក លើកកម្ពស់ សុខុមាលភាព ជូន ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ឱ្យ មាន ឱកាស ទទួលបាន ការថែទាំ សុខភាព ប្រកបដោយ គុណភាព ពីសំណាក់ វេជ្ជបណ្ឌិត ឯកទេស វៀតណាម ដែល មាន បទពិសោធន៍ ខ្ពស់ រួម ជាមួយ សម្ភារ បរិក្ខារ ពេទ្យ ទំនើប ដែល មាន បំពាក់ នៅ មន្ទីរពេទ្យ ជោរៃ ភ្នំពេញ ។
លោក បន្ត ទៀត ថា ក្រោម កិច្ចសហការ រវាង DHG Phama និង មន្ទីរពេទ្យ ជោរៃ ភ្នំពេញ ក៏ បាន លើកកម្ពស់ វិស័យ សុខាភិបាល មួយ ផ្នែក ផងដែរ និង ម្យ៉ាង វិញ ទៀត ក៏ បាន កាត់បន្ថយ ភាពក្រីក្រ របស់ បងប្អូន ប្រជាពលរដ្ឋ កម្ពុជា ដោយសារតែ ការពិនិត្យ និង ព្យាបាល ជំងឺ របស់ ក្រុម គ្រូពេទ្យ ដោយ មិន គិត ប្រាក់ ។ មួយ វិញទៀត លោក មើលឃើញ ថា អ្នកជំងឺ ជាង ១ ពាន់ នាក់ ដែល បាន ចូលមក ពិនិត្យ ទាំងអស់ នោះ ពិតជា មាន ភាពសប្បាយរីករាយ ផងដែរ ដោយ មាន ការព្យាបាល ពី សំណាក ក្រុម គ្រូពេទ្យ ជំនាញ ៗ នៅ កម្ពុជា និង ប្រទេស វៀតណាម ។
