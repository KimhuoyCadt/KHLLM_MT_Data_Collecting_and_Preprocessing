( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល ខណ្ឌ ឬស្សីកែវ បាន តាម ចាប់ខ្លួន ស្ត្រី ម្នាក់ ដកហូត ក្រាម ពណ៌ ស ថ្លា ចំនួន ០៦ កញ្ចប់ នៅ ត្រង់ ចំណុច ក្រុម ១៤ ស្ថិត ក្នុង ភូមិ ផ្សារ តូច សង្កាត់ ទួល សងែ្ក១ ខណ្ឌ ឬស្សីកែវ នា យប់ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៩ ។
លោក គល់ យី អធិការ នគរបាល ខណ្ឌ ឬស្សីកែវ បាន ឲ្យដឹង ថា ជនសង្ស័យ ជា ស្ត្រី ដែល ឃាត់ខ្លួន បាន ក្នុង បទល្មើស ជួញដូរ ថ្នាំ ញៀន ឈ្មោះ វ៉ាន់ រ៉ាឌីន អាយុ ១៩ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ សា្នក់ នៅ បណ្ណោះ អាសន្ន ក្នុង ភូមិ ផ្សារ តូច សង្កាត់ ទួល សងែ្ក១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។
លោក អធិការ បាន បន្ដ ទៀត ថា មុន ឈានដល់ ការឃាត់ខ្លួន ជនសង្ស័យ ជា ស្ត្រី ជួញដូរ ថ្នាំ ញៀន កម្លាំង នគរបាល ប៉ុស្ដិ៍ និង កម្លាំង ជំនាញ គ្រឿងញៀន ខណ្ឌ បាន បើក ការស្រាវជ្រាវ ដើម្បី កំណត់ ឲ្យបាន ច្បាស់ អំពី ពេលវេលា ទីតាំង និង អត្តសញ្ញាណ របស់ ជនសង្ស័យ នៃ ការប្រព្រឹត្ត បទល្មើស ទើប អាច លប ឆ្មក់ ឡោមព័ទ្ធ បង្ក្រាប តែម្ដង ក្រៅពី ឃាត់ខ្លួន នោះ បាន រកឃើញ ថ្នាំញៀន ចំនួន ៦កញ្ចប់ ផងដែរ ។
បច្ច ប្បន្ន ជនសង្ស័យ និង វត្ថុតាង ដែល ដកហូត បាន ក្នុង សកម្មភាព ជួញដូរ ថ្នាំ ញៀន ត្រូវបាន នាំយក មក បន្ត ឃុំ ខ្លួន សាកសួរ បណ្ដោះអាសន្ន នៅ អធិការដ្ឋាន ខណ្ឌ ដើម្បី កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការ តាម នីតិវិធី ៕ អ៊ីរ៉ង់ ប្រឆាំងជំទាស់ នឹង ប៉ូឡូញ ជុំវិញ ការរៀបចំ ជំនួប អន្តរជាតិ ស្ដីពី អ៊ីរ៉ង់ ជាមួយ សហរដ្ឋ អាមេរិក
( ឌូបៃ ) ៖ ក្រសួង ការបរទេស អ៊ីរ៉ង់ នៅ ថ្ងៃអាទិត្យ នេះ បាន កោះហៅ មន្ត្រី ជាន់ ខ្ពស់ ប៉ូឡូញ ម្នាក់ ឱ្យ ចូល ជួប ដើម្បី សម្ដែង ការតវ៉ា និង ជំទាស់ ចំពោះ ការសម្រេចចិត្ត រៀបចំ ជំនួប អន្តរជាតិ រួមគ្នា ជាមួយ សហរដ្ឋ អាមេរិក ដែល ផ្ដោត សំខាន់ លើ អ៊ីរ៉ង់ និង តំបន់ មជ្ឈិមបូព៌ា ។ នេះ បើ តាម សារព័ត៌មាន អ៊ីរ៉ង់ IRNA ដកស្រង់ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃអាទិត្យ ទី១៣ ខែមករា ឆ្នាំ ២០១៩ ។
គួរ ជម្រាប ថា ប្រតិកម្ម របស់ ក្រសួង ការបរទេស អ៊ីរ៉ង់ កើត មាន ឡើង ក្រោយ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក លោក ម៉ៃក៍ ប៉ុម ប៉េអូ បាន អះអាង ថា កាលពី ថ្ងៃសុក្រ ថា កិច្ចប្រជុំ អន្តរជាតិ មួយ នឹង ត្រូវ ប្រព្រឹត្តទៅ នៅក្នុង ទីក្រុង Warsaw ប្រទេស ប៉ូឡូញ ចាប់ពី ថ្ងៃទី ១៣ ដល់ ថ្ងៃទី ១៤ ខែកុម្ភៈ ដោយ ផ្តោត សំខាន់ លើ ស្ថេរភាព និង សន្តិសុខ នៅក្នុង តំបន់ មជ្ឈិមបូព៌ា ព្រមទាំង មធ្យោបាយ ទប់ស្កាត់ សកម្មភាព បង្ក អស្ថេរភាព របស់ អ៊ីរ៉ង់ នៅក្នុង តំបន់ ៕
អភិបាល ខេត្ត មណ្ឌលគិរី អំពាវនាវ ឱ្យ ពលរដ្ឋ ចូលរួម ការពារ សមិទ្ធផល ដែល សម្រេចបាន ក្រោយ ថ្ងៃ ៧មករា និង ផ្សព្វផ្សាយ ពី សមិទ្ធផល ទាំងនោះ ទៅ អ្នកដទៃ
( មណ្ឌលគិរី ) ៖ ខ្លឹមសារ ដ៏ សំខាន់ មួយ ដែល លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី បាន ប្រកាស ក្នុង ពិធី រំលឹក ខួប លើក ទី ៤០ នៃ ទិវា ជ័យជម្នះ ៧មករា គឺ ការអំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ចូលរួម ការពារ ឱ្យ បាន គង់វង្ស នូវ សមិទ្ធផល ដែល សម្រេចបាន ក្រោយ ថ្ងៃ ជ័យជម្នះ ៧ មក រា ១៩៧៩ និង ត្រូវ ចូលរួម ផ្សព្វផ្សាយ ពី សមិទ្ធផល ទាំងនោះ ទៅ អ្នកដទៃ ឱ្យ បាន ទូលំទំលាយ ។
ពិធី រំលឹក ខួប លើក ទី ៤០ នៃ ទិវា ជ័យជម្នះ ៧ មករា ជា ប្រវត្តិសាស្ត្រ នេះ ប្រារព្ធ ឡើង នា ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០១៩ នៅ ក្រុង សែនមនោរម្យ ដោយ មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា ខេត្ត មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត កងកម្លាំង ទាំង បី អាជ្ញាធរ ក្រុង / ស្រុក ប្រជាពលរដ្ឋ យុវជន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត សម្ពន្ធ យុវជន ស្រលាញ់ សន្តិភាព យុវជន កាកបាទ ក្រហម កម្ពុជា យុវជន កាយ រឹទ្ធិ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ប្រមាណ ២.០០០ នាក់ ។
ថ្លែង ក្នុង អង្គ មិទ្ទិញ លោក ស្វាយ សំអ៊ាង បាន អាន សុន្ទរកថា របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដោយ បាន លើកឡើង ថា ប្រសិនជា គ្មាន ថ្ងៃ ៧មករា នោះ ទេ គឺ គ្មាន សមិទ្ធផល រីក ដុះដាល រហូតមកដល់ បច្ចុប្បន្ន នេះ ទេ ។
លោក បន្ត ថា ដោយសារ កម្លាំង មហាសាមគ្គី ជាតិ នេះ ហើយ ទើប ធ្វើឱ្យ ប្រទេស កម្ពុជា ទាំងមូល ត្រូវបាន រំដោះ ឲ្យ រួច ចាក ផុត ពី របប កម្ពុជា ប្រជាធិបតេយ្យ ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ដ៏ សាហាវ យង់ឃ្នង និង បាន នាំមក នូវ សុខ សន្តិភាព សិទ្ធិ សេរីភាព សេចក្ដីថ្លៃថ្នូរ វឌ្ឍនភាពសង្គម នៅ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ១៩៧៩ ដែល ប្រជាជន កម្ពុជា ទូទាំង ប្រទេស ចាត់ទុក ជា ថ្ងៃ កំណើត លើក ទី២ និង ចងចាំ ជានិច្ច មិន អាច បំភ្លេច បានជា រៀងដរាប ទៅ ។
លោក អភិបាល ខេត្ត ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ រួមគ្នា ជួយ ការពារ និង ថែរក្សា សន្តិភាព ដែល រកបាន ដោយ លំបាក បំផុត នេះ ឱ្យ ស្ថិត ស្ថិរ គង់វង្ស ប្រកបដោយ និរន្តភាព សម្រាប់ អនាគត់ យូរអង្វែង តទៅ និង ត្រូវ រួមគ្នា ជួយ ផ្សព្វផ្សាយ ពី សមិទ្ធផល ដែល រាជ រដ្ឋាភិបាល ខិតខំ ប្រឹងប្រែង សម្រេចបាន ឲ្យ ទៅដល់ ប្រជាពលរដ្ឋ ទូទៅ បាន យល់ ជ្រោត ជ្រាប កាន់តែ ច្បាស់ ពី ការរីកម្រើន របស់ ប្រទេសជាតិ នា ពេល បច្ចុប្បន្ន នេះ ។
សូម បញ្ជាក់ ថា ក្នុង អង្គ មិ ទ្ទិញ នោះ ដែរ ក៏ មាន ការដង្ហែរ ក្បួន រថយន្ត បុស្បុក ចំនួន ៧ គ្រឿង រួម មាន៖ រថយន្ត រដ្ឋបាល សាលា ខេត្ត រថយន្ត តំណាង កងកម្លាំង ទាំង បី រថយន្ត តំណាង ក្រុង - ស្រុក ទាំង៥ និង រថយន្ត តំណាង មន្ទីរ ជំនាញ ចំនួន ៤ និង ការដើរ ព្យូហ យាត្រា ចែកចេញ ជា ១២ផែន ៕ រដ្ឋមន្ត្រី កសិកម្ម អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ធ្វើ ប្រហុក ទុក ជា ស្បៀង ប្រចាំ គ្រួសារ ខណៈ រដូវ នេសាទ កំពុង ត្រូវ ខ្លាំង
ក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ នៅ ទី ជិត ឆ្ងាយ មក ធ្វើ ប្រហុក ទុក ជា ស្បៀង ប្រចាំ គ្រួសារ ខណៈ រដូវ នេសាទ កំពុងតែ ត្រូវ ខ្លាំង ។
មន្រ្តី រដ្ឋបាល ជលផល បាន ឲ្យដឹង ដែរ ថា រដូវ នេសាទ ចាប់ផ្តើម ត្រូវ ជា បន្តបន្ទាប់ តាំងពី ថ្ងៃទី ១១ ខែធ្នូ ឆ្នាំ ២០១៨ នៅ តាម ដាយ នៃ ដង ទន្លេ សាប ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ដែល អាច នេសាទ ត្រី បានជា បណ្តើរ ៗ ។
បច្ចុប្បន្ន ត្រី ប្រហុក នៅនឹង កន្លែង ថ្លៃ ១៥០០ រៀល ទៅ ២០០០ រៀល ក្នុង ១គីឡូក្រាម តែ តម្លៃ នេះ មន្រ្តី ជំនាញ បាន បញ្ជាក់ ថា វា អាស្រ័យ ពេលវេលា លើក ដាយ ត្រី ផងដែរ ៕ ព្យុះ ព្រិល ទឹកកក សម្លាប់ មនុស្ស ៧នាក់ នៅ សហរដ្ឋ អាមេរិក
គួរ បញ្ជាក់ ថា ប្រជាជន អាមេរិក ច្រើន ជាង ៦៥លាន នាក់ ត្រូវបាន អាជ្ញាធរ បង្គាប់ឱ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ព្រោះថា ព្យុះ ព្រិល ទឹកកក អាចនឹង បង្កឱ្យ មាន អាកាសធាតុ ចុះ ត្រជាក់ ខ្លាំង ក៏ ដូចជា បង្ក ការរំខាន ដល់ ការធ្វើដំណើរ ផងដែរ ៕ គ្រឿងអលង្ការ ស្នាដៃ កូន ខ្មែរ ដ៏ ប្រណិត ប្រកបដោយ ភាពទាន់សម័យ នឹង បង្ហាញ វត្ដមាន លើ ផ្សារ កម្ពុជា ឆាប់ ៗ នេះ (Video Inside)
លោក សុខ ឥសាន បាន បន្ថែម ថា បុគ្គល ប្រែត អាដាម គឺជា អ្នក ប្រឆាំង នឹង ភាពសុខសាន្ត ក៏ ដូចជា ភាពរីកចម្រើន របស់ កម្ពុជា ម្ល៉ោះហើយ បានជា មន្រ្តី សិទ្ធិ មនុស្ស ដែល ធ្លាប់ រង ការបណ្តេញ ចេញ ពី កម្ពុជា រូប នេះ តែងតែ ធ្វើ ការរិះគន់ និង វាយប្រហារ លើ រាជ រដ្ឋាភិបាល កម្ពុជា មិន ចេះ ជិនណាយ ទោះបីជា អ្វី ដែល រាជ រដ្ឋាភិបាល ធ្វើ នោះ ត្រឹមត្រូវ ក៏ដោយ ។
លោក សុខ ឥសាន បាន ថ្លែង យ៉ាង ដូច្នេះ៖ « ដោយ នៅ ពី ចម្ងាយ ពី កម្ពុជា ប្រែត អាដាម ធ្វើ ខ្លួន ដូចជា ដឹង រឿង នៅ កម្ពុជា ច្បាស់ ជាង អ្នក នៅក្នុង ស្រុក ខ្មែរ ទៅ ទៀត ដោយសារតែ បុគ្គល រូប នេះ មាន និន្នាកា កាន់ ជើង អតីត បក្ស ប្រឆាំង យ៉ាង ងុបងល់ » ។
លោក សុខ ឥសាន បាន បញ្ជាក់ ថា ឥឡូវ ទោះបី ខិតខំ កាន់ ជើង ទាំង ទទឹង ទិស យ៉ាងណា ក៏ ឥត ប្រយោជន៍ ដែរ ពីព្រោះ គ្មាន អ្នកណា ដឹង ជាង សាមីជន ទេ ដែល នេះ ជា ភស្តុតាង ដាក់ បន្ទុក របស់ តុលាការ ៕
លោក ពេជ សោភ័ន៖ កម្ពុជា សំណាង ណាស់ ដែល រួចផុត ពី របប ប្រល័យ ពូជសាសន៍ និង គេច ផុត ពី បដិវត្ត ពណ៌
( តាកែវ )៖ លោក ពេជ សោភ័ន សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា សហ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ របស់ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក ព្រៃ កប្បាស បាន លើកឡើង ប្រាប់ ប្រជាពលរដ្ឋ ថា កម្ពុជា សំណាង ណាស់ ដែល បាន រួច ផុត ពី របប ប្រល័យ ពូជសាសន៍ ចាប់ពី ថ្ងៃ ជ័យជម្នះ ៧ មក រា ១៩៧៩ និង បាន គេច ផុត ពី បដិវត្ត ពណ៌ នៅ អំឡុង ឆ្នាំ ២០១៣ ដែល ហៀប នឹង កើតឡើង ដោយសារ អំពើ ក្បត់ ជាតិ របស់ ពួក អតីត បក្ស ប្រឆាំង ។
លោក បណ្ឌិត បាន ថ្លែង បែប នេះ នៅក្នុង ពិធី ផ្សព្វផ្សាយ លទ្ធផល នៃ សន្និបាត គណៈកម្មាធិការ កណ្ដាល លើ ទី ៤១ អាណត្តិ ទី៥ របស់ គណបក្ស ប្រជាជន កម្ពុជា និង ពិធី រំឭក ខួប អនុស្សាវរីយ៍ លើក ទី ៤០ នៃ ទិវា ជ័យជម្នះ ៧ មករា ដែល ប្រារព្ធ ឡើង នា ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០១៩ ស្ថិត នៅ ឃុំ ពោធិ៍ រំចាក ស្រុក ព្រៃ កប្បាស ខេត្ត តាកែវ ។
លោក ពេជ សោភ័ន បាន បន្ត ថា ទោះបីជា រាជ រដ្ឋាភិបាល កម្ពុជា ស្រប ច្បាប់ បាន ទប់ស្កាត់ ទង្វើ របស់ ពួក ក្បត់ ជាតិ យ៉ាង នេះ ក្ដី ប៉ុន្តែ ពួក នេះ នៅតែ ស្រែក បំភ្លៃ សភាព ការពិត ក្នុង ប្រទេស កម្ពុជា កោក ៗ ពី ក្រៅ ប្រទេស ដដែល ។ ត្រង់ ចំណុច នេះ លោក ពេជ សោភ័ន ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ផងដែរ សូម កុំ លង់ ជឿ តាម ការឃោសនា អកុសល របស់ ពួកគេ ឲ្យ សោះ ។
ក្រៅពី នេះ លោក បាន ដាស់តឿន ដល់ ប្រជាពលរដ្ឋ ពិសេស យុវជន ត្រូវ ខិតខំ ពង្រឹង ការសិក្សា និង ការងារ ប្រចាំ ថ្ងៃ របស់ ខ្លួន ពីព្រោះ អ្វី ដែល មាន ដូច ពេល បច្ចុប្បន្ន នេះ មិន ងាយ រក បាន ឡើយ ដូច្នេះ ត្រូវតែ ក្ដាប់ ឱកាស នេះ ឲ្យ ជាប់ ។
លោក បាន ដាស់តឿន ផងដែរ ដល់ អាជ្ញាធរ មន្ត្រីរាជការ មូលដ្ឋាន នានា គ្រូពេទ្យ លោកគ្រូ អ្នកគ្រូ ត្រូវ បន្ត ខិតខំ បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ ប្រសើរ ថែម ទៀត ដើម្បី រួមគ្នា អភិវឌ្ឍន៍ មូលដ្ឋាន ស្រុក ព្រៃ កប្បាស ឲ្យ កាន់ មាន ការរីកចម្រើន និង លេចធ្លោរ ក្នុង ក្របខណ្ឌ ជាតិ ។
បើ តាម លោក ពេជ សោភ័ន រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា នៅតែ ខិតខំ ថែរក្សា សន្តិភាព ស្ថិរភាព នយោបាយ អភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ការពារ ឯករាជ្យ ជាតិ អធិបតេយ្យភាព ជាតិ ដើម្បី ធ្វើឲ្យ ប្រជាពលរដ្ឋ កាន់តែ មាន ភាពរីកចម្រើន ប្រសើរឡើង ជាង មុន ពិសេស ស្រុក ព្រៃ កប្បាស នេះ តាមរយៈ ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន នេះ ក៏ នៅតែ បន្ត ខិតខំ បំពេញ ការងារ បម្រើ ប្រជាពលរដ្ឋ ឲ្យបាន ប្រសើរឡើង ថែម ទៀត ដែរ ។
លោក ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ នៅ ស្រុក ព្រៃ កប្បាស សូមអញ្ជើញ ទៅ ទស្សនា នៅ វិមាន អនុស្សាវរីយ៍ នៃ នយោបាយ ឈ្នះ - ឈ្នះ ដែល មាន ទីតាំង ស្ថិត នៅ រាជធានី ភ្នំពេញ ដើម្បី ស្វែងយល់ ឱ្យ កាន់តែ ច្បាស់ ពី ប្រវត្តិ តស៊ូ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង យុទ្ធជន ដទៃ ទៀត ក្នុង ការផ្ដួល រំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
ជាមួយគ្នា នោះ លោក ហេង សួរ អនុប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ព្រៃ កប្បាស និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ឃុំ ពោធិ៍ រំចាក ស្រុក ព្រៃ កប្បាស ក៏ បាន អាន និង ផ្សព្វផ្សាយ នូវ លទ្ធផល នៃ សន្និបាត គណៈកម្មាធិការ កណ្ដាល លើក ទី ៤១ អាណត្តិ ទី៥ របស់ គណបក្ស ប្រជាជន កម្ពុជា និង ពិធី រំឭក ខួប អនុស្សាវរីយ៍ លើក ទី ៤០ នៃ ទិវា ជ័យជម្នះ ៧មករា ជូន អង្គ ពិធី បាន ជ្រោត ជ្រាប ផងដែរ ។
( ស្ទឹងត្រែង ) ៖ ក្បួន រថយន្ត ដឹកជញ្ជូន បទល្មើស ឈើ បាន បើក បុក រថយន្ត សមត្ថកិច្ច ខេត្ត ស្ទឹងត្រែង បណ្តាលឱ្យ រង ការខូចខាត យ៉ាង ដំណំ គ្រា សមត្ថកិច្ច ចេញ បង្ក្រាប បទល្មើស ហើយ ចាប់ បាន រថយន្ត ដឹក ឈើ ១ គ្រឿង ។ ចំណែក រថយន្ត ជាច្រើន គ្រឿង ទៀត បើក បាន គេច ចេញ ដោយ សុវត្ថិភាព ។
ហេតុការណ៍ នោះ បាន កើតឡើង នៅ ម៉ោង ប្រមាណ ៥៖០០ ទៀប ភ្លឺ ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០១៩ នេះ នៅលើ កំណាត់ ផ្លូវ ជាតិ លេខ ៧ ស្ថិត ក្នុង សង្កាត់ សាមគ្គី ក្រុង ស្ទឹងត្រែង ។
ប្រភព បាន ឱ្យដឹង ថា រថយន្ត មួយ គ្រឿង ដែល រង ការបុក បើក ផ្លូវ ពី ក្បួន រថយន្តក្រុម ឈ្មួញ ឈើ ធី កាប៉ូ នោះ គឺជា រថយន្ត របស់ មន្ត្រី ព្រៃឈើ មួយ រូប នៅ ស្នាក់ការបណ្តុះ កូន ឈើ ភ្នំ ក្រហម អូរ ពង មាន់ ។
ក្រោយ ការធ្វើ សកម្មភាព បុក រថយន្ត មន្ត្រី ព្រៃឈើ រួច មក សមត្ថកិច្ច បង្ក្រាប បាន រថយន្ត បាឡែន មួយ គ្រឿង របស់ ក្រុម ឈ្មួញ ធី កាប៉ូ និង ច្រើន គ្រឿង ទៀត បាន បើក គេច ចេញ ដោយ សុវត្ថិភាព ។
ប្រជាពលរដ្ឋ បាន បង្ហាញ ក្តីសង្ឃឹម ថា សមត្ថកិច្ច ខេត្ត ស្ទឹងត្រែង នឹង បន្ត ចុះបង្ក្រាប បទល្មើស គ្រប់ ប្រភេទ ជាពិសេស បទល្មើស ព្រៃឈើ ដោយ ធ្វើឡើង ដូច ភ្លៀង រលឹម ទៅ តាម អនុសាសន៍ របស់ រាជ រដ្ឋាភិបាល ៕ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត៖ ជា មោទនភាព របស់ កងទ័ព កម្ពុជា ដែល មាន យុវជន យុវតី ដាក់ពាក្យ ចូល ប្រឡង ក្របខណ្ឌ កាន់តែ កើនឡើង
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក និង ជា ប្រធាន អនុគណៈកម្មការ ប្រឡង ជ្រើសរើស នាយ ទាហាន នៃ កងយោធពល ខេមរភូមិន្ទ ឆ្នាំ ២០១៩ បាន ថ្លែង ថា កងទ័ព របស់ កម្ពុជា កាន់តែ មាន មោទនភាព ដោយសារតែ យុវជន យុវតី ជំនាន់ ក្រោយ បាន ដាក់ពាក្យ ចូល ប្រឡង ប្រជែង បំពេញ ក្របខ័ណ្ឌ មាន ការកើនឡើង ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ។
មុនដំណើរការប្រឡង នៅ ទូទាំង ប្រទេស នា ព្រឹក ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០១៩ នេះ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ដែល បាន ចុះ ពិនិត្យ ទិដ្ឋភាព ផ្ទាល់ នៅ មណ្ឌល រាជធានី ភ្នំពេញ នា វិទ្យាល័យ បាក់ទូក បាន លើកឡើង ថា ចំពោះ បេក្ខជន ដែល បាន ដាក់ពាក្យ ចូល ប្រឡង ក្របខ័ណ្ឌ កងទ័ព នៅ ឆ្នាំ ២០១៩ នេះ គឺ មាន ការកើនឡើង ជាបណ្ដា ឆ្នាំ កន្លងទៅ ប្រមាណ ជាង ១ ពាន់ នាក់ ។
តួរ លេខ របស់ អនុគណៈកម្មការ ប្រឡង ជ្រើសរើស នាយ ទាហាន នៃ កងយោធពល ខេមរភូមិន្ទ ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា សម្រាប់ ក្របខ័ណ្ឌ ទូទាំង ប្រទេស មាន បេក្ខជន ចូលរួម ប្រឡង សរុប ចំនួន ៨. ៣៥២ នាក់ ស្រី ៣. ២៧០ នាក់ ក្នុង បែងចែក ជា ៣៥៦ បន្ទប់ ។ ក្នុង នោះ ក្រសួង សម្រេច ជ្រើសយក នាយ ទាហាន សកម្ម ចំនួន ២០០ នាក់ . នាយ ទាហាន ទ័ព ជើងគោក ចំនួន ២៥០ នាក់ . នាយ ទាហាន បន្ត វេន ចំនួន ១៧០ នាក់ និង នាយ ទាហាន ជំនាញ បច្ចេកទេស ចំនួន ៦០ នាក់ ។
ទន្ទឹម គ្នា នេះ លោក ហ៊ុន ម៉ាណែត ក៏ បាន ណែនាំ ដល់ អនុគណៈកម្មការ ប្រឡង ជ្រើសរើស នាយ ទាហាន និង គណៈកម្មការ ជ្រើសរើស ត្រូវ រក្សា ដំណើរការ ប្រឡង ប្រព្រឹត្តទៅ ដោយ រលូន ត្រឹមត្រូវ មាន តម្លាភាព និង មាន យុត្តិធម៌ ។ មាន ន័យ ថា អ្នក ដែល ជោគជ័យ ក្រោយ ការប្រឡង ទាំង ចំណេះដឹង ទូទៅ ភាសា និង កីឡា គឺជាប់ ដោយ សមត្ថភាព ផ្ទាល់ ហើយ ចំពោះ អ្នក ដែល ប្រឡង មិន ជាប់ គឺ អស់ចិត្ត ដោយ ខ្លូន ឯង ។
លោក សង្កត់ធ្ងន់ ថា « អនុគណៈកម្មការ ប្រឡង ក៏ ដូចជា គណៈកម្មការ ជ្រើសរើស របស់ យើង គឺ ថា ធ្វើ មិច ឲ្យ ការជ្រើសរើស នាយ ទាហាន របស់ យើង ប្រព្រឹត្តទៅ ដោយ រលូន ត្រឹមត្រូវ មាន តម្លាភាព និង យុត្តិធម៌ ។ អ្វី ដែល យើង ចង់បាន គឺ ធ្វើឲ្យ បាន ត្រឹមត្រូវ យុត្តិធម៌ ដើម្បីឲ្យ ប្អូន ៗ ទាំងអស់ បាន បង្ហាញ នូវ សមត្ថភាព របស់ ខ្លួន » ។
ជាមួយគ្នា នេះ លោក ឧត្តមសេនីយ៍ ឯក ប៊ុត សុភាព នាយក សាលា នាយ ទាហាន សកម្ម និង ជា អនុប្រធាន ប្រចាំ ការអនុគណៈកម្មការ ប្រឡង ជ្រើសរើស នាយ ទាហាន និង ជា ប្រធាន មណ្ឌល ប្រឡង រាជធានី ភ្នំពេញ ក៏ បាន ថ្លែង ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន ផងដែរ ថា សម្រាប់ ចំនួន បេក្ខជន ដែល ចូលរួម ប្រឡង នៅ មណ្ឌល របស់ លោក គ្រប់គ្រង មាន ចំនួន ៣. ៧៧៧ នាក់ ។
បើ តាម លោក ឧត្តមសេនីយ៍ ប៊ុត សុភាព សម្រាប់ បញ្ហា សន្ដិសុខ សណ្ដាប់ធ្នាប់ ទូទៅ នៅក្នុង មណ្ឌល ប្រឡង នា វិទ្យាល័យ និង បឋមសិក្សា បាក់ទូក នេះ គឺ បាន ដំណើរការ ទៅ យ៉ាង រលូន មិន មាន បញ្ហា អ្វី ទាំងអស់ ដោយ មាន ការចូលរួម សហការ យ៉ាង ល្អ ពីសំណាក់ សមត្ថកិច្ច និង អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ។
លោក ប្រធាន មណ្ឌល រូប នេះ ក៏ ណែនាំ ដល់ បេក្ខជន ទាំង នៅ មណ្ឌល រាជធានី ភ្នំពេញ និង តាម បណ្ដា យោធ ភូមិភាគ ទាំងអស់ នៅ ទូទាំង ប្រទេស ត្រូវតែ ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ និង បញ្ចេញ អស់ សមត្ថភាព ដែល ខ្លួន ធ្លាប់ បាន សិក្សា រៀនសូត្រ ដើម្បី ទទួលបាន ជោគជ័យ ក្នុង ការប្រឡង លើក នេះ ព្រោះថា ការប្រឡង នេះ មិន មាន ការសូកប៉ាន ឬ ប្រកាន់ បក្ខពួក អ្វី ឡើយ ដោយ អ្នក មាន សមត្ថភាព ពិត គឺជាប់ ។
គួរ បញ្ជាក់ ដែរ ថា ការប្រលង ជ្រើសរើស នាយ ទាហាន នៃ កង យោពល ខេមរភូមិន្ទ វគ្គ នាយ ទាហាន សកម្ម ជំនាន់ ទី២៣ វគ្គ នាយ ទាហាន ទ័ព ជើងគោក ជំនាន់ ទី១១ វគ្គ នាយ ទាហាន បន្ត វេន ជំនាន់ ទី ១២ និង វគ្គ នាយ ទាហាន ជំនាញ បច្ចេកទេស យោធា ឆ្នាំ ២០១៩ នេះ នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១៣ - ១៧ ខែមករា ឆ្នាំ ២០១៩ ដែល ផ្ដោត ទៅ លើ វិញ្ញាសា ចំណេះដឹង ទូទៅ ភាសា បរទេស និង វិញ្ញាសា កីឡាកាយសម្បទា ៕
សូម ជម្រាប ថា លោក កុក ស មេដឹកនាំ ជនជាតិ ភាគ តិច វៀតណាម និង លោក សម រង្ស៉ី បាន ចុះហត្ថលេខា រួមគ្នា មួយ នៅលើ ទឹកដី សហរដ្ឋ អាមេរិក កាលពី អំឡុង ឆ្នាំ ២០១៣ ដោយ លោក សម រង្ស៉ី បាន សន្យា ថា នៅពេល គណបក្ស សង្គ្រោះ ជាតិ ដឹកនាំ រដ្ឋាភិបាល លោក នឹង កាត់ ខេត្ត រតនគិរី មណ្ឌលគិរី ស្ទឹងត្រែង និង ក្រចេះ ឲ្យ ក្រុម ជនជាតិ ភាគ តិច វៀតណាម Degar ( ម៉ុង តាញ៉ា ) ដឹកនាំ ដោយ លោក កុក ស ដើម្បី គ្រប់គ្រង ផ្តល់ ស្វ័យភាព និង មាន សិទ្ធិ ពេញលេញ អាច រស់ នៅ និង មាន សិទ្ធិ ដូច ប្រជាជន កម្ពុជា ដែរ ។
ជាមួយគ្នា នេះ តាមរយៈ កិច្ចសម្ភាសន៍ ជាមួយ កាសែត ភ្នំពេញ ប៉ុស្តិ៍ លោក សម រង្ស៉ី ពុំ បាន ខ្លាច ច្បាប់ នោះ ទេ ថែមទាំង បាន សារភាព ថា លោក ពិតជា បាន ចុះហត្ថលេខា ជាមួយ លោក Kok Ksor នៅ សហរដ្ឋ អាមេរិក កាលពី ឆ្នាំ ២០១៣ នោះ ពិតប្រាកដ មែន ។
ពាក់ព័ន្ធ ករណី នេះ តំណាង អយ្យការ ក៏ បាន ចេញ ដីកា កោះហៅ លោក សម រង្ស៉ី ឱ្យ ចូល បំភ្លឺ នៅ សាលាដំបូង រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ០៧ ខែឧសភា ឆ្នាំ ២០១៨ ផងដែរ ប៉ុន្តែ លោក សម រង្ស៉ី បាន អវត្តមាន ក្នុង ការចូល បំភ្លឺ ។ ទោះជា យ៉ាង នេះ ក្តី តំណាង អយ្យការ បាន អះអាង ថា ខ្លួន នឹង បន្ត នីតិវិធី របស់ ខ្លួន បន្ត ទៀត ចំពោះ សំណុំរឿង នេះ ៕
លោក សៅ សុខា ជំរុញ ឲ្យ សិស្សានុសិស្ស ត្រូវ ស្វែងយល់ ពី ប្រវត្តិសាស្ត្រ ជ័យជម្នះ ៧មករា ដោយ កុំ ជឿ តាម ការបំភ្លៃ របស់ ក្រុម ប្រឆាំង ឡើយ
( ស្វាយរៀង ) ៖ លោក សៅ សុខា សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ខេត្ត ស្វាយរៀង ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក រមាសហែក នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៩ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៤០ ទិវា ជ័យជម្នះ ៧មករា ( ១៩៧៩ - ២០១៩ ) នៅ មន្ទីរ បក្ស ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ សមាជិក សមាជិកា ជាច្រើន រូប ផងដែរ ។
លោក បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « អ្វី ដែល យើង និយាយ នា ពេលនេះ វា ជា រឿង ពិត ដែល បាន កើត មាន ឡើង នៅក្នុង ប្រទេសជាតិ យើង ដោយសារ ផលប្រយោជន៍ នយោបាយ មាន មជ្ឈដ្ឋាន ខ្លះ ជាពិសេស មជ្ឈដ្ឋាន ប្រឆាំង នឹង ថ្ងៃ ៧មករា គឺ ពួកគេ មិន ទទួលស្គាល់ ថា ថ្ងៃ នេះ រំដោះ ជាតិ ធ្វើឱ្យ ប្រជាជន រស់រាន មាន អាយុ ឡើងវិញ ពិតប្រាកដ នោះ ទេ គឺ ពួកគេ តែងតែ ថា ជា ថ្ងៃ ក្លែងក្លាយ ជា ថ្ងៃ ឈ្លានពាន របស់ បរទេស មក លើ ប្រទេស កម្ពុជា ប៉ុន្តែ ធាតុ ពិត គឺ ដូច សុន្ទរកថា របស់ សម្តេច តេជោ ដែល បាន ឡើង » ។
លោក សៅ សុខា បាន បញ្ជាក់ បន្ថែម ថា ជាក់ស្តែង សាលា ក្តី ខ្មែរ ក្រហម បាន ឆ្លុះបញ្ជាំង ពី រឿង ពិត របស់ កម្ពុជា បើ មិន ដូច្នេះ ទេ បរទេស មិន ឧបត្ថម្ភ ថវិកា ដើម្បី ជួយ ដំណើរការ សាលា ក្តី ខ្មែរ ក្រហម នោះ ឡើយ ។
គួរ បញ្ជាក់ ថា កាលពី ឆ្នាំ ២០១៨ យោធា អ៊ីស្រាអែល ត្រូវបាន គេ រាយការណ៍ ថា បាន ដឹកនាំ ការវាយប្រហារ តាម ផ្លូវ អាកាស ជាច្រើន លើ មូលដ្ឋាន យោធា របស់ អ៊ីរ៉ង់ និង ក្រុម ឧទ្ទាម លី បង់ ហេស ប៊ូល ឡា ដែល បាន និង កំពុង ជួយ រដ្ឋាភិបាល ទីក្រុង ដាម៉ាស់ វាយ យក ទឹកដី ស្ទើ តែ ទាំងស្រុង មកវិញ ពី ពួក ISIS និង ក្រុម ឧទ្ទាម ស៊ីរី ៕
គួរ បញ្ជាក់ ថា មក ទល់នឹង ពេលនេះ អាជ្ញាធរ ចិន មិន ទាន់ បញ្ជាក់ ពី មូលហេតុ បាក់ អណ្ដូង រ៉ែ ធ្យូងថ្ម ខាងលើ នៅឡើយ ទេ ខណៈ ការស៊ើបអង្កេត កំពុង ធ្វើ បន្ត ធ្វើឡើង ។ ប៉ុន្តែ ជារឿយ ៗ គ្រោះថ្នាក់ បែប នេះ ត្រូវបាន គេ បន្ទោស ទៅ លើ ការអនុវត្ត ច្បាប់ ធូរ រលុង និង បញ្ហា បទដ្ឋាន សុវត្ថិភាព ក្នុង ឧស្សាហកម្ម រ៉ែ នៅ ប្រទេស ចិន ៕
តើ មាន អ្វី កើតឡើង នៅក្នុង ការស៊ើបអង្កេត ?
លោក Mueller ត្រូវបាន តែងតាំង ជា រដ្ឋអាជ្ញា ពិសេស អាមេរិក តែ ប៉ុន្មាន ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី លោក Comey ត្រូវបាន បណ្ដេញចេញ ពី តំណែង ។ ចំណែកឯ លោក ត្រាំ វិញ បាន ច្រានចោល រាល់ ការចោទប្រកាន់ ទាំងឡាយ ហើយ ថា ការស៊ើបអង្កេត របស់ លោក Mueller ក្នុង សំណុំរឿង រុស្ស៊ី គឺជា រឿង នយោបាយ តែ ប៉ុណ្ណោះ បើ ទោះជា អតីត ក្រុម មន្ត្រី ជំនិត ជាច្រើន នាក់ របស់ លោក ត្រូវបាន តុលាការ ចោទប្រកាន់ និង ខ្លះ ទៀត ត្រូវបាន កាត់ទោស ដាក់ ពន្ធនាគារ ក៏ដោយ ។
គួរ បញ្ជាក់ ថា សេតវិមាន បាន ថ្កោលទោស និង ច្រានចោល សេចក្ដីរាយការណ៍ របស់ សារព័ត៌មាន អាមេរិក New York Times ជាមួយ ការបញ្ជាក់ ថា ប្រធានាធិបតិ អាមេរិក លោក ដូណាល់ ត្រាំ មិន មាន ទំនាក់ទំនង ណាមួយ នឹង រុស្ស៊ី នោះ ទេ តែ ផ្ទុយទៅវិញ លោក បាន និង កំពុង ចាត់ វិធានការ ជាច្រើន ប្រឆាំង នឹង ទីក្រុង ម៉ូស្គូ ដើម្បី ការពារ សណ្ដាប់ធ្នាប់ អន្តរជាតិ និង ផលប្រយោជន៍ អាមេរិក ៕
សូម បង្កើន ការប្រុងប្រយ័ត្ន ! អគ្គិភ័យ ឆាបឆេះ ភោជនីយដ្ឋាន មួយ នៅ ខណ្ឌ ដូនពេញ ប៉ុន្តែ មិន បង្កឱ្យ មាន មនុស្ស របួស - ស្លាប់ ឡើយ គ្រាន់តែ ខូចខាត សម្ភារ បន្តិចបន្តួច
( ភ្នំពេញ ) ៖ នា វេលា ព្រឹក ថ្ងៃ ១៣ ខែមករា ឆ្នាំ ២០១៩ មាន ករណី អគ្គីភ័យ មួយ កន្លែង កើតឡើង នៅ ភោជនីយដ្ឋាន រ៉ាឌី ស្ថិត តាម ណ្តោយ ផ្លូវ លេខ ៥១ កែង នឹង ផ្លូវ លេខ ២១៤ អគារ លេខ ២១ និង អគារ លេខ ២៣ ស្ថិត ក្នុង សង្កាត់ បឹង រាំង ខណ្ឌ ដូនពេញ បណ្ដាលឱ្យ ខូចខាត សម្ភារ ប្រើប្រាស់ នៅក្នុង ហាង បន្តិចបន្តួច តែ ពុំ បាន ឆេះ រាលដាល ដល់ ផ្ទះ អ្នកជិតខាង និង មិន បង្កឱ្យ មនុស្ស ណា ម្នាក់ រងរបួស និង ស្លាប់ ឡើយ ។
លោក ថា មូលហេតុ ដែល នាំឱ្យ មាន អគ្គិភ័យ នេះ គឺ បណ្ដាល មកពី ឆ្លង ចរន្ត អគ្គិសនី ក្នុង នោះ កម្លាំង សមត្ថកិច្ច បាន ប្រើប្រាស់ រថយន្ត ការិយាល័យ អគ្គិភ័យ ចំនួន ១គ្រឿង និង ប្រេី ប្រាស់ ទឹក អស់ ចំនួន ១ឡាន ។
ខណៈ ដែល រដូវ នេះ ជា រដូវ ប្រាំង អាកាសធាតុ ក្ដៅ ផង នោះ សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ នៅ គ្រប់ ទិសទី គប្បី បង្កើន ការប្រុងប្រយ័ត្ន ឱ្យ ខ្ពស់ ជា ទីបំផុត ចំពោះ បញ្ហា ចរន្ត អគ្គិសនី នេះ ៕ ព័ត៌មាន សំខាន់ ៗ ចំនួន ១០ប្រចាំ សប្តាហ៍ សម្រាប់ ថ្ងៃអាទិត្យ ទី១៣ ខែមករា ឆ្នាំ ២០១៩ នេះ
១៖ សម្តេច តេជោ ហ៊ុន សែន ប្រាប់ សមាជិក សភា ប្រទេស មកពី អឺរ៉ុប ថា ការប្រើ ទណ្ឌកម្ម ដោយ ដក ប្រព័ន្ធ អនុគ្រោះ ពន្ធ (EBA) ជា ការបង្កើត កំហុស ទី៣ លើ កម្ពុជា
២៖ សម្តេច តេជោ ហ៊ុន សែន ជំរុញ ឱ្យ អ្នកសារព័ត៌មាន រួមគ្នា ប្រយុទ្ធ ទប់ស្កាត់ ព័ត៌មាន ក្លែងក្លាយ តាមរយៈ ការបង្ហាញ នូវ ព័ត៌មាន ពិត
៣៖ លិខិត មិត្ត អ្នកអាន៖ សម រង្ស៉ី ចាត់ទុក មន្ត្រី របស់ ខ្លួន ជា គោ ក្នុង ក្រោល !
៤៖ ព្រឹទ្ធសភា អាមេរិក បញ្ជូន ឈ្មោះ បេក្ខភាព អគ្គ រដ្ឋទូត អាមេរិក ប្រចាំ កម្ពុជា ត្រឡប់ ទៅ លោក ដូណាល់ ត្រាំ វិញ ក្រោយពី លោក ត្រូវបាន បដិសេធ
៥៖ នាវា ចម្បាំង មហា យក្ស ចិន៣ គ្រឿង បាន ចូល សុំ ចត ដល់ កំពង់ផែ ព្រះសីហនុ ដើម្បី បំពេញ ទស្សនកិច្ច រយៈពេល ៤ ថ្ងៃ
៦៖ ក្រុម មេធាវី លោក កឹម សុខា ផ្អាក ប្តឹង ជំទាស់ មួយ រយៈ បន្ទាប់ពី មាន ការកោះហៅ លោក គង់ គាំ ធ្វើជា សក្សី
៧៖ ច្បាប់ វិសោធនកម្ម ច្បាប់ គណបក្ស នយោបាយ ដែល បើក ផ្លូវ ឲ្យ អ្នកនយោបាយ ជាប់ បម្រាម ធ្វើ នយោបាយ ឡើងវិញ ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រម ប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់
៩៖ ខួប ៤០ ឆ្នាំ ថ្ងៃ កំណើត ទី ពីរ ៧មករា សម្តេច តេជោ ហ៊ុន សែន ប្តេជ្ញា អនុវត្ត កិច្ចការ ចម្បង៤ ដើម្បី ធានា ដល់ វឌ្ឍនភាព ជាតិ និង សេចក្តីសុខ របស់ ប្រជាពលរដ្ឋ
១០៖ តុលាការ ចេញ សេចក្តីសម្រេច បដិសេធ ពាក្យ ស្នើសុំ ទម្លាក់ បទ ចោទប្រកាន់ លើ លោក កឹម សុខា ពីសំណាក់ ក្រុម មេធាវី ការពារ សិទ្ធិ របស់ កឹម សុខា
គួរ បញ្ជាក់ ថា បាតុកម្ម តវ៉ា របស់ ក្រុម បាតុករ បារាំង អាវ កាក់ ពណ៌ លឿង បាន ឈានចូល ចុង សប្ដាហ៍ ទី ៩ហើយ កាលពី ថ្ងៃសៅរ៍ បើ ទោះជា រដ្ឋាភិបាល ប្រធានាធិបតី បារាំង លោក ម៉ាក្រុង យល់ព្រម លុបចោល គម្រោង ដំឡើង ពន្ធ លើ ឥន្ធនៈ តាម ការទាមទារ ពី ដំបូង របស់ ក្រុម បាតុករ ក៏ដោយ ។ ប៉ុន្តែ ពួកគេ នៅតែ បន្ថែម ការទាមទារ ជាច្រើន ក្នុង នោះ រួម មាន ទាំង ស្នើ ឱ្យ លោក ម៉ាក្រុង ចុះចេញ ពី តំណែង ផងដែរ ៕ អ្នក ជិះ បញ្ច្រាស រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត មាន . ក្នុង យប់ មិញ សមត្ថកិច្ច ឃាត់ បាន យានយន្ត ចំនួន ១ គ្រឿង ថែម ទៀត
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៩ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន១ គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៩ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន១ គ្រឿង ក្នុង នោះ រួម មាន : ម៉ូតូ ១ គ្រឿង ។
ភាព សណ្ដោស ប្រណី របស់ សម្ដេច តេជោ ហ៊ុន សែន ធ្វើ ប្រទាន កម្ម ដីធ្លី ជូន ពលរដ្ឋ នៅ តំបន់ ប្រឡាយ ស្ទឹងមានជ័យ . អភិបាល រាជធានី ភ្នំពេញ ចុះ ចែក ប័ណ្ណ កម្មសិទ្ធិ ដោយ ផ្ទាល់ ដៃ
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ជូន ដំណឹង នៅលើ ទំព័រ Facebook បញ្ជាក់ ថា មាន ការ សណ្តោស ប្រណី ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ ប្រទាន កម្ម ដីធ្លី ជូន ប្រជាពលរដ្ឋ នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៨ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ដឹកនាំ ដោយ លោក ឃួង ស្រេង អភិបាល រាជធានី បាន ប្រគល់ ប័ណ្ណ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ នៅ ប្រឡាយ ស្ទឹងមានជ័យ ។
បើ តាម រដ្ឋបាល រាជធានី ភ្នំពេញ នេះ ជា ជំហាន ទី១ ក្នុង ការផ្តល់ ជូន ប្រជាពលរដ្ឋ ចំនួន ១៥៣ ខ្នង ផ្ទះ ក្នុង ចំណោម ៥៦២ ខ្នង ផ្ទះ ហើយ នឹង ត្រូវ ប្រគល់ ជូន ជា បន្តបន្ទាប់ រហូតដល់ អស់ សព្វគ្រប់ ។ ជាមួយគ្នា នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ទទួលបាន ប្រឡាយ ទឹក រីឯ ប្រជាពលរដ្ឋ ទទួលបាន កម្មសិទ្ធិ ស្រប ច្បាប់ ។
គួរ បញ្ជាក់ ថា នៅ តំបន់ ស្ទឹងមានជ័យ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន និង កំពុង ស្ថាបនា ប្រឡាយ ស្ទឹងមានជ័យ មាន ប្រវែង១.៣៩៨ ម៉ែត្រ ដោយ ចាក់ បេតុង បុក ស៊ី ផាយ ទទឹង ៨ម៉ែត្រ ហើយ គម្រោង នេះ ត្រូវបាន បែងចែក ជា ៤តំណាក់កាល ។ ក្នុង នោះ តំណាក់កាល ទី១ មាន ប្រវែង ៣២៦ ម៉ែត្រ សងខាង ប្រឡាយ សរុប ប្រវែង ៦៥២ ម៉ែត្រ ហើយ ក្នុង ជំហាន ទី១ នេះ រដ្ឋបាល រាជធានី បាន សម្រេច ចាប់ ឆ្នោត ប្រគល់ ដី ជូន ប្រជាពលរដ្ឋ ដែល រស់ នៅ លើ ប្រឡាយ នេះ ១៥៣ គ្រួសារ រួចហើយ ដែរ កាលពី ប៉ុន្មាន ខែ មុន នេះ ។
ប្រឡាយ ស្ទឹងមានជ័យ ដែល រដ្ឋបាល រាជធានី ភ្នំពេញ បាន និង កំពុង ធ្វើ ការអភិវឌ្ឍ នេះ ឆ្លងកាត់ ខណ្ឌ ចំនួន ២ គឺ ខណ្ឌ មានជ័យ និង ខណ្ឌ សែនសុខ ដែល មាន ប្រជាពលរដ្ឋ រស់ នៅ និង រង ផល ប៉ះពាល់ ប្រឡាយ នេះ ចំនួន ៥៦២ គ្រួសារ ហើយ ប្រជាពលរដ្ឋ ទាំងអស់ នេះ នឹង ទទួលបាន ដី ទំហំ ៤គុណ និង ៦ម៉ែត្រ ជា កម្មសិទ្ធិ ស្រប ច្បាប់ នៅ កន្លែង តែម្តង ។
សូម ជម្រាប ថា ប្រឡាយ ស្ទឹងមានជ័យ បាន ដើរ តួយ៉ាង សំខាន់ ក្នុង ការនាំ ទឹក ទម្លាក់ ចូលទៅ បឹង ទំពុន ។ ជា គម្រោង តួ ប្រឡាយ ស្ទឹងមានជ័យ មាន ទំហំ ៨ម៉ែត្រ ចិញ្ចើម២ម៉ែត្រ សាងសង់ ផ្លូវ បេតុង ទទឹង ៦ម៉ែត្រ ផ្លូវ មុខ ផ្ទះ ៥ម៉ែត្រ ដី នៅសល់ មុខ ផ្ទះ១ ម៉ែត្រ កន្លះ និង ក្រោយ ផ្ទះ កន្លះ ម៉ែត្រ ៕
បុណ្យ ដាលាន ត្រូវបាន ប្រារព្ធ ឡើង នៅ ខេត្ត បាត់ដំបង !
( បាត់ដំបង ) ៖ លោក វេង សាខុន រដ្ឋមន្រី្ត ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ចូលរួម ជា អធិបតីភាព ពិធី បុណ្យ ដា លាន ដែល រៀបចំ ធ្វើឡើង ដោយ អគ្គ នាយកដ្ឋាន កសិកម្ម សហការ ជាមួយ អាជ្ញាធរដែនដី មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត នៅ ស្ថានីយ ពូជ ស្រូវ ទួល សំរោង ក្នុង ភូមិ អូរញ ឃុំ បឹង ព្រីង ស្រុក ថ្មគោល ខេត្ដ បាត់ដំបង ។
ពិធី បុណ្យ ដាលាន នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង និង ថ្នាក់ដឹកនាំ ក្រសួង លោក - លោកស្រី នាង កញ្ញា ភ្ញៀវ កិត្តិយស ជាតិ - អន្តរជាតិ ព្រះសង្ឃ សិស្សានុសិស្ស ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។
ក្នុង ឱកាស នោះ លោក រដ្ឋមន្រ្តី ក្នុង នាម ថ្នាក់ដឹកនាំ ក្រសួង ព្រមទាំង លោក អភិបាល ខេត្ត បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ និង សេចក្តីនឹករលឹក ដ៏ ជ្រាលជ្រៅ ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធ បណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រគេន ចំពោះ ព្រះករុណា គ្រប់ ព្រះអង្គ និង ជូន ចំពោះ បងប្អូន ជន រួម ជាតិ ទាំងអស់ ដែល មាន វត្តមាន នៅ ទីនេះ សូម ទទួល នូវ សិរី សួស្តី ជ័យ មង្គល វិបុល សុខ គ្រប់ ប្រការ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ទាក់ទង នឹង ពិធី បុណ្យ ដារ លាន នា ពេលនេះ លោក រដ្ឋមន្រ្តី វេង សា ខុន បាន រំលឹក ជូន អង្គ ពិធី ជ្រាប ដោយ សង្ខេប ពី ប្រវត្តិ បុណ្យ នេះ ថា បុណ្យ ដារ លាន ជា បុណ្យ ដែល ទាក់ទង ទៅ នឹង ជំនឿ សាសនា របស់ ប្រជាពលរដ្ឋ ខ្មែរ ភាគ ច្រើន ជា កសិករ តែងតែ ប្រកាន់ខ្ជាប់ នូវ ប្រពៃណី នេះ ក្រោយពី បញ្ចប់ ការច្រូត ស្រូវ និង បោក បែន រួចរាល់ ក្នុង គោលបំណង រក្សា នូវ អត្ដសញ្ញាណ ព្រលឹង ជាតិ ខ្មែរ គោរព ដឹងគុណ ចំពោះ ម្ចាស់ ទឹក ម្ចាស់ ដី និង វត្ថុ ស័ក្តិសិទ្ធិ ។
លោក បន្ដ ទៀត ថា ក្នុង នោះ ក៏ ដូចជា បង្ក ឱកាស ជូន ប្រជាកសិករ ឲ្យ ជួបជុំ ញាតិមិត្ដ ជិត ឆ្ងាយ ដើម្បី ពង្រីក នូវ ចំណង ភាតរភាព សាមគ្គីភាព និង មិត្តភាព ហើយ ផ្លាស់ប្ដូរ យោបល់ គ្នា អំពី ការងារ បង្កបង្កើន ផល និង ជាពិសេស គឺ ដើម្បី កម្សាន្ដ សប្បាយ បន្ទាប់ពី បាន ចំណាយ កម្លាំង កាយ និង កម្លាំងចិត្ត គ្រប់ បែបយ៉ាង នៅក្រោម កម្ដៅ ព្រះអាទិត្យ និង ភ្លៀង ផ្គរ យ៉ាង ប្ដូរផ្ដាច់ អស់ រយៈពេល ពេញ មួយ រដូវ បង្កបង្កើន ផល កន្លងមក ។
លោក រដ្ឋមន្រ្តី ក៏ បាន ជម្រាប ជូន អង្គ ពិធី ជ្រាប ដោយ សង្ខេប ផងដែរ អំពី ស្ថានភាព ទូទៅ នៃ ការវិវឌ្ឍន៍ ផ្នែក នយោបាយ សង្គម និង ការវិវឌ្ឍន៍ រីកចម្រើន របស់ ប្រទេសជាតិ ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ និង មាន ចក្ខុវិស័យ វែងឆ្ងាយ របស់ រាជ រដ្ឋាភិបាល រួម ជាមួយ ផែនការ និង ទិសដៅ អភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ជាពិសេស វិស័យ កសិកម្ម ។
ទី ៣៖ បន្ដ កិច្ចសហប្រតិបត្ដិការ ល្អ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ស្ថាប័ន ជំនាញ ពាក់ព័ន្ធ គ្រប់ លំដាប់ថ្នាក់ និង ដៃគូ អភិវឌ្ឍន៍ នានា ឲ្យបាន ល្អ ប្រសើរ ដើម្បី ផ្តល់ ព័ត៌មាន ថ្មី ៗ ស្ដីពី បច្ចេកទេស ផលិតកម្ម កសិកម្ម ឲ្យ មាន លក្ខណៈ ប្រទាក់ ក្រឡា គ្នា ដើម្បី ដោះស្រាយ បញ្ហា ដែល កសិករ ជួបប្រទះ ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព ៕
( ប៉ារីស )៖ ភ្នាក់ងារ ពន្លត់ អគ្គីភ័យ ២នាក់ បាន បាត់បង់ជីវិត ហើយ មនុស្ស យ៉ាងហោចណាស់ ចំនួន ៤៧ នាក់ ផ្សេង ទៀត បាន រងរបួស ក្នុង ហេតុការណ៍ ផ្ទុះ យ៉ាង កក្រើក ដែល គេ សង្ស័យ ថា បង្កឡើង ដោយ ការធ្លាយ ហ្គាស នៅ កណ្តាល ទីក្រុង ប៉ារីស ។ នេះ បើ តាម ការបញ្ជាក់ ពី រដ្ឋមន្រ្តី មហាផ្ទៃ បារាំង ដកស្រង់ សម្តី ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ យប់ ថ្ងៃសៅរ៍ ទី ១២ ខែមករា ឆ្នាំ ២០១៩ ។
គួរ ជម្រាប ថា ឆ្លើយតប ចំពោះ ហេតុការណ៍ នេះ ក្រុម ភ្នាក់ងារ ពន្លត់ អគ្គិភ័យ ជាង ២០០ នាក់ និង ប៉ូលិស ប្រមាណ ជា ១០០ នាក់ ត្រូវបាន ដាក់ពង្រាយ នៅ កន្លែង កើត ហេតុ ហើយ ឧទ្ធម្ភាគចក្រ២ គ្រឿង ក៏ ត្រូវបាន បញ្ជូន ទៅឲ្យ ជម្លៀស ជនរងគ្រោះ ផងដែរ ។ ជាមួយគ្នា នេះ អាជ្ញាធរ បារាំង បាន អះអាង ថា ករណី ខាងលើ គឺជា រឿង គ្រោះថ្នាក់ ចៃដន្យ សុទ្ធសាធ ដែល ទំនង មកពី ការលេច ធ្លាយ ហ្គាស ៕
មន្ដ្រី អាវុធហត្ថ ខណ្ឌ រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា ប្រតិបត្តិការ ឃាត់ខ្លួន នេះ ត្រូវបាន ធ្វើឡើង នៅ យប់ ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០១៩ ដោយ ជនសង្ស័យ ឈ្មោះ ឌីណា ពុទ្ធិ សាក់ ហៅ ក្រៅ ទី អាយុ ២១ មុខរបរ សិស្សសាលា មាន ស្រុក កំណើត និង ទីលំនៅ បច្ចុប្បន្ន ភូមិ អង្គ កែវ សង្កាត់ ចោម ចៅ៣ ខណ្ឌ ពោធិ៍សែនជ័យ ។
ដោយឡែក សម្ភារ ដែល យក បាន ពី នារី រងគ្រោះ រូប គេ បាន ប្រគល់ឲ្យ មិត្តភក្តិ ឈ្មោះ ត្រា . ឧត្តម . ស្នា និង ជា ដូរ យក គ្រឿងញៀន មួយ កញ្ចប់ ធំ មក ចែក គ្នា ជក់ និង លក់ បន្ត ។ បច្ចុប្បន្ន អាវុធហត្ថ រាជធានី ភ្នំពេញ កំពុង បន្ត និតិវិធី ស្រាវជ្រាវ ស្វែងរក ចាប់ខ្លួន គូរ កន របស់ ជនសង្ស័យ ដែល នៅ សេសសល់ ជា បន្ត ទៀត ៕
អភិបាល ខេត្ត សៀមរាប ចូលរួម បិទ ការប្រកួត កីឡា បាល់ទាត់ អបអរ ខួប លើក ទី៤០ ទិវា ជ័យជម្នះ ៧មករា នៅ សាលា អនុវិទ្យាល័យ ហ៊ុន សែន រលួស
( សៀមរាប ) ៖ លោក ទៀ សីហា អភិបាល ខេត្ត សៀមរាប នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី បិទ ការប្រកួត កីឡា បាល់ទាត់ ដើម្បី អបអរសាទរ ខួប លើក ទី៤០ ទិវា ជ័យជម្នះ ៧មករា ( ៧ មករា ១៩៧៩ - ៧ មករា ២០១៩) ដោយ មាន ការចូលរួម ពី អាជ្ញាធរ មូលដ្ឋាន លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស យុវជន កីឡាករ និង ប្រជាពលរដ្ឋ ប្រមាណ ២ពាន់ នាក់ ។
លោក ទៀ សីហា បាន ថ្លែង ទៅកាន់ អង្គ ពិធី ថា ជា ការពិត ណាស់ សន្ដិភាព សេរីភាព និង ការអភិវឌ្ឍ ដែល យើង ទាំងអស់ គ្នា កំពុង មាន សព្វ ថ្ងៃ នេះ គឺជា ផ្លែ ផ្កា នៃ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដោយ បាន យក ជីវិត ធ្វើជា ដើមទុក ក្នុង ការចរចា ជាមួយ កម្លាំង របស់ ខ្មែរ ក្រហម ដែល នៅ សេសសល់ ឈាន ទៅ បញ្ចប់ សង្គ្រាម ផ្ទៃក្នុង រវាង ខ្មែរ និង ខ្មែរ ដែល ជាតិ យើង ជួប វិបត្តិ នេះ រាប់ រយ ឆ្នាំ មកហើយ ដើម្បី ប្ដូរ យក សន្តិភាព និង ការអភិវឌ្ឍ ជូន ជាតិ ។
កត្តា មាន សុខ សន្ដិភាព ការអភិវឌ្ឍន៍ មាន លើ គ្រប់ វិស័យ នេះ ហើយ វិស័យ កីឡា ក៏ មាន ការ ឈានឡើង ជា ពី សេស យុវជន ជំនាន់ ក្រោយ តាមរយៈ កម្មវិធី ប្រកួត កីឡា បាល់ទាត់ ដែល រៀបចំឡើង ដោយ ក្រុមការងារ ចុះ ជួយ ឃុំ រលួស ស្រុក ប្រាសាទ បាគង ខេត្ត សៀមរាប នា ពេលនេះ បាន បង្ហាញ ឲ្យ ឃើញ ពី ការរីកចម្រើន នៃ វិស័យ កីឡា ពិសេស កីឡា បាល់ទាត់ ទាំង បរិមាណ និង គុណភាព ដោយ មាន ការចូលរួម និង គាំទ្រ ទាំង ស្មារតី និង សម្ភារ ពី មហាជន យុវជន និង សប្បុរស ជន មួយចំនួន ផងដែរ ។
លោក អភិបាល ខេត្ត ក៏ បាន លើកទឹកចិត្ត ឲ្យ ប្រជាជន ពិសេស យុវជន លេង កីឡា ទាំងអស់ គ្នា ជៀស ឆ្ងាយ ពី គ្រឿងញៀន និង ល្បែងស៊ីសង ផ្សេង ៗ ដើម្បី ធ្វើ ខ្លួន ក្លាយជា ទំពាំង ស្នង ឬស្សី សម្រាប់ សង្គមជាតិ ទៅ ថ្ងៃ មុខ ។
ក្នុង កម្មវិធី នេះ លោក អភិបាល និង ក្រុមការងារ ក៏ បាន ចូលរួម និមន្ត ព្រះសង្ឃ សូត្រ មន្ត បង្សុកូល នូវ រូបសំណាក របស់ សម្ដេច សង្ឃ ជួន ណាត ដែល ក្រុមការងារ របស់ គណក្ស ប្រជាជន កម្ពុជា និង សប្បុរសជន បាន សាងសង់ ពី ថ្ម អស់ តម្លៃ ជាង ៣ពាន់ ដុល្លារ សម្រាប់ ដាក់ តម្កល់ នៅក្នុង បរិវេណ សាលា អនុវិទ្យាល័យ ហ៊ុន សែន រលួស នេះ ផងដែរ ៕ សមាជិក សភា និង អភិបាល ក្រុង ប្រិស បិន ចូលរួម អបអរសាទរ ខួប ទី៤០ ទិវា ជ័យជម្នះ ៧មករា រៀបចំ ដោយ សមាគម ខ្មែរ - អូស្ត្រាលី រដ្ឋ ឃ្វីន ស្លែន
កម្មវិធី នេះ ត្រូវបាន រៀបចំឡើង ដោយ សមាគម ខ្មែរ - អូស្រ្តាលី ប្រចាំ រដ្ឋ ឃ្វីន ស្លែន ប្រទេស អូស្រ្តាលី ដែល មាន លោក ហង្ស សុជាតិ ជា ប្រធាន ស្ថិត ក្រោម អធិបតីភាព លោក កុយ គួង ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ប្រទេស អូស្ត្រាលី និង ណូវ៉ែលហ្សេឡង់ . លោក គឹម សន្តិភាព រដ្ឋលេខាធិការ ក្រសួង យុត្តិធម៌ . លោក ស៊ូនី វង្ស វិសិដ្ឋ មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង ការពារ ជាតិ និង មាន ការចូលរួម ពី មន្រ្តី ជាន់ ខ្ពស់ កម្ពុជា ជាច្រើន រូប ។
( កំពង់ចាម ) ៖ លោក គួច ចំរើន ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ចូលរួម ក្នុង ការប្រកាស បញ្ជូល សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ចំនួន ៤រូប ដែល ជា សកម្មជន អតីត គណបក្ស សង្រ្គោះ ជាតិ និង គណបក្ស សិទ្ធិ មនុស្ស ។
សមាជិក ថ្មី ចំនួន ៤រូប របស់ គណបក្ស ប្រជាជន រួម មាន៖ លោក លី វណ្ណ ស៊ី ជា អតីត សមាជិក ក្រុមប្រឹក្សា ស្រុក គណបក្ស សង្រ្គោ ជាតិ . លោក រុន ណារិន ជា អតីត ប្រធាន ប្រតិបត្តិ គណបក្ស សិទ្ធិ មនុស្ស ស្រុក ចំការលើ . លោក ហេង លឹម ខេង ជា អតីត សមាជិក គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស សង្រ្គោះ ជាតិ ខេត្ត កំពង់ចាម និង លោក ជុំ ម៉េង ជា អតីត សមាជិក យុវជន គណបក្ស សង្រ្គោះ ជាតិ ខេត្ត កំពង់ចាម ។
តាមរយៈ ការសុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា នេះ សមាជិក អតីត បក្ស ប្រឆាំង ទាំង៤ រូប សុទ្ធតែ អះអាង ដូចគ្នា ថា ដោយ មើលឃើញ និង ជឿជាក់ លើ គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា ពិសេស ជឿជាក់ លើ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ទើប ពួកគេ បាន មក សុំ រួមរស់ ជីវភាព នយោបាយ ជាមួយ វិញ ។
ក្នុង នាម ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា នៅ ខេត្ត កំពង់ចាម លោក គួច ចំរើន សូម ប្រកាស ស្វាគមន៍ ចំពោះ ឆន្ទៈ ពិតប្រាកដ របស់ សមាជិក ថ្មី ទាំង ៤រូប ដែល បាន សម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ មក ចូលរួម ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បន្ត ដឹកនាំ ប្រទេសជាតិ កាន់តែ រុងរឿង ឡើង ជូន ដល់ ពលរដ្ឋ ខ្មែរ ទាំងអស់ ទាំង ជំនាន់ នេះ និង ទុក ជូន កូន ចៅ ជំនាន់ ក្រោយ ។
បន្ថែម ពី នេះ លោក គួច ចំរើន ក៏ បាន ណែនាំ ដល់ សមាជិក ថ្មី ត្រូវ បន្ដ រក្សា សាមគ្គីភាព ផ្ទៃក្នុង មិន ថា សមាជិក ចាស់ ឬ ថ្មី នោះ ទេ ដើម្បី ចូលរួមចំណែក ជាមួយ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ន័យ លើកកម្ពស់ និង អភិវឌ្ឍន៍ ប្រទេសជាតិ កាន់តែ រីកចម្រើន បន្ថែម ទៀត ៕ បុរី ឡុង នី គម្រោង ទី៣ បើក ការដ្ឋាន សាងសង់ នៅ ថ្ងៃទី ១២មករា នេះ ហើយ !
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ទទួលបាន ភាពជោគជ័យ ទំាង ២គម្រោង កន្លងមក នេះ . បុរី ឡុង នី បាន បន្ដ ផ្ដត់ ផ្គង់ តំរូវការ ទីផ្សារ របស់ អតិថិជន ដោយ នៅ ព្រឹក ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន ក្រុង ពាលី បើក ការដ្ឋាន សាងសង់ គម្រោង ទី៣ របស់ ខ្លួន ហើយ ។
សម្រាប់ អតិថិជន ដែល បាន ទិញ ផ្ទះ ឬ កក់ ប្រាក់ លើ ប្រភេទ ផ្ទះ ណា ក៏ដោយ នឹង ទទួលបាន នូវ កាដូ ពិសេស មួយ ពី គម្រោង ទី៣ សម្រាប់ តែ ថ្ងៃ បុក គ្រឹះ បើក ការដ្ឋាន សាងសង់ នេះ តែ ប៉ុណ្ណោះ ។
ភាពស្រស់ស្អាត នៃ វីឡា ភ្លោះ ព្រមទាំង ទីតាំង ដ៏ ល្អ ជាង គេ មាន នៅ បុរី ឡុងនី គំរោង ទី២ និង ទី៣ ។ សូម កុំ រំលង ឱកាស ក្លាយជា ម្ចាស់ គេហដ្ឋាន ដ៏ ស្អាត បវរ នេះ ឲ្យ សោះ ។ ពិសេស រាល់ គម្រោង របស់ បុរី ឡុង នី សុទ្ធតែ យកចិត្តទុកដាក់ លើ គុណភាព សំណង់ និង សម្ភារ សំណង់ មិន តែ ប៉ុណ្ណោះ គឺ មាន ការសាងសង់ លឿន ដើម្បី បំពេញ តាម តំរូវការ របស់ អតិថិជន ៕
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៥.៤៣២ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៧០៥ គ្រឿង ( ម៉ូតូ ៧៩ %) អប់រំ២៦៣ គ្រឿង និង ផាក ពិន័យ ៤៣៩ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ១២ ខែមករា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ៣. ១៥៨ គ្រឿង . អប់រំ១៧២ គ្រឿង និង ផាក ពិន័យ ៤០៤ គ្រឿង ។
ដើម្បី ធានា ដល់ តម្លាភាព សុក្រឹត យុត្តិធម៌ ក្នុង ការប្រឡង នេះ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក និង ជា ប្រធាន អនុគណៈកម្មការ ប្រលង ជ្រើសរើស នាយ ទាហាន កងយោធពល ខេមរភូមិន្ទ ឆ្នាំ ២០១៩ ដាក់ចេញ នូវ បទបញ្ជា យ៉ាង ម៉ឹង ម៉ាត់ រឹតបន្តឹង វិន័យ ប្រឡង ដោយ ហាម ដាច់ខាត មិន ឲ្យ អ្នក គ្មាន ភារកិច្ច ចូល មណ្ឌល ប្រឡង នោះ ឡើយ រួមទាំង មន្ត្រី យោធា ដែល ពាក់ ផ្កាយ ពីរ ផ្កាយ បី ផងដែរ ។
ការដាក់ បំរាម របស់ លោក ហ៊ុន ម៉ាណែត ធ្វើឡើង បន្ទាប់ពី បាន សង្កេតឃើញ ថា ការប្រឡង បណ្ដា ឆ្នាំ កន្លងទៅ មាន មន្ដ្រី យោធា ជាន់ ខ្ពស់ មួយចំនួន គ្មាន ភារកិច្ច ក្នុង ការប្រឡង បាន ជូន កូន ក្មួយ ឬ សាច់ញាតិ ចូលក្នុង មណ្ឌល ប្រឡង ។
មេបញ្ជាការ កងទ័ព ជើងគោក រូប នេះ បាន សង្កត់ធ្ងន់ ថា ការប្រឡង ជ្រើសរើស មន្ត្រី យោធា នេះ គឺ ត្រូវ ធ្វើឲ្យ អ្នក ជាប់ ជាប់ ដោយ រីករាយ ដោយ មោទន ហើយ អ្នក ធ្លាក់ ត្រូវ ធ្លាក់ ដោយ អស់ចិត្ត ។
សូម ជម្រាប ថា ការប្រលង ជ្រើសរើស នាយ ទាហាន នៃ កង យោពល ខេមរភូមិន្ទ វគ្គ នាយ ទាហាន សកម្ម ជំនាន់ ទី២៣ វគ្គ នាយ ទាហាន ទ័ព ជើងគោក ជំនាន់ ទី១១ វគ្គ នាយ ទាហាន បន្ត វេន ជំនាន់ ទី ១២ និង វគ្គ នាយ ទាហាន ជំនាញ បច្ចេកទេស យោធា ឆ្នាំ ២០១៩ នេះ នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១៣ - ១៧ ខែមករា ឆ្នាំ ២០១៩ ដែល មាន ចំនួន ៦ មណ្ឌល គឺ នៅ មណ្ឌល រាជធានី ភ្នំពេញ យោធ ភូមិភាគ ទី១ ទី២ ទី៣ ទី៤ និង ទី៥ ដោយ ផ្ដោត ទៅ លើ វិញ្ញាសា ចំណេះដឹង ទូទៅ ភាសា បរទេស និង វិញ្ញាសា កីឡាកាយសម្បទា ។
លោក ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត ក៏ បាន បង្ហាញ តួរ លេខ ថា ការជ្រើសរើស នាយ ទាហាន នៃ កងយោធពល ខេមរភូមិន្ទ ឆ្នាំ ២០១៩ នេះ មាន ការកើនឡើង បើ ប្រៀបធៀប ទៅ និង ឆ្នាំ ២០១៨ កន្លងមក ហើយ ការកើនឡើង នេះ បាន កើនឡើង នៅ តាម បណ្តា យោធ ភូមិភាគ ។ នេះ ដោយសារ ការមើលឃើញ នៃ ការជ្រើសរើស នាយ ទាហាន នៃ កង យោពល ខេមរភូមិន្ទ បណ្ដា ឆ្នាំ មុន ៗ កន្លងមក មាន ភាពសុក្រឹត យុត្តិធម៌ ត្រឹមត្រូវ និង តម្លាភាព ៕
ប្រជាពលរដ្ឋ នៅ ស្រុក កំចាយ មារ ជាង ៧០០ នាក់ ជួបជុំ ប្រារព្ធ ខួប ថ្ងៃ កំណើត ទី២ របស់ ខ្លួន ក្រោម ម្លប់ សន្តិភាព និង ការអភិវឌ្ឍ
មិទ្ទិញ នេះ ត្រូវបាន ក្រោម វត្តមាន របស់ លោក ស្តើង សុខុម ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក កំចាយ មារ និង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ស្រុក កំជាយ មារ ក្រុមការងារ កណ្តាល ជួយ ស្រុក គណៈកម្មាធិការ រគណបក្ស ស្រុក និង ក្រុមប្រឹក្សា ឃុំ គ្រប់ ឃុំ យុវជន គណបក្ស ស្រុក និវត្តន៍ ជន នាយក សាលា គ្រប់ កម្រិត ប្រជាពលរដ្ឋ និង កង កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ។
លោក ស្តើង សុខុម បាន អាន សន្ទរកថា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក្នុង មហា មិទ្ទិញ រំលឹក ខួប ៤០ ឆ្នាំ ទិវា ជ័យជម្នះ ៧មករា ជូន ដល់ អង្គ មិទ្ទិញ ដែល ក្នុង នោះ លោក បាន ទាញយក ចំណុច សំខាន់ ៗ មួយចំនួន ក្នុង សន្ទរកថា ដោយ គូស រំលេច ថា « ៧មករា ជា ថ្ងៃ កំណើត ទី២ របស់ ប្រជាជន កម្ពុជា ហើយ ៧មករា គឺជា និមិត្តរូប និង ស្មារតី នៃ ការ សង្រ្គោះ រួបរួម និង អភិវឌ្ឍន៍ ជាតិ » ។
ក្នុង ន័យ នេះ លោក បាន ធ្វើ ការពន្យល់ ថា ជ័យជម្នះ ៧មករា បាន សង្គ្រោះ ទាន់ ពេលវេលា នូវ ឤយុជីវិត ប្រជាជន កម្ពុជា រាប់ លាន នាក់ ដែល នៅ រង់ចាំ តែ សេចក្តីស្លាប់ បាន ធ្វើឲ្យ រាល់ តម្លៃ ទាំង ខាង ស្មារតី និង សម្ភារ របស់ ប្រជាជាតិ ខ្មែរ ដែល ត្រូវបាន កសាង ពូន ជ្រំ ក្នុង ប្រវត្តិសាស្ត្រ រាប់ ពាន់ ឆ្នាំ របស់ ខ្លួន ហើយ បាន ស្រក ស្រុត ស្ទើរ រលាយ សាបសូន្យ បាត់ អស់ នៅ ក្នុង របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
ថ្ងៃ៧ មក រា ១៩៧៩ ប្រជាជាតិ ខ្មែរ បាន រស់ ឡើងវិញ បាន បិទ ទំព័រ ដ៏ ខ្មៅ ងងឹត បំផុត នៃ ប្រវត្តិសាស្ត្រ កម្ពុជា ហើយ បើក ឡើង នូវ សករាជ ថ្មី គឺ សករាជ នៃ ឯករាជ្យ សេរីភាព ប្រជាធិបតេយ្យ និង វឌ្ឍនភាពសង្គម ជូន ដល់ ប្រជាជាតិ ដ៏ កំសត់ នៃ យើង និង បាន ផ្តល់ ជូន ប្រជាជន កម្ពុជា នូវ សិទ្ធិ សេរីភាព គ្រប់ យ៉ាង ក្នុង ការធ្វើជា ម្ចាស់ លើ ជោគវាសនា របស់ ខ្លួន ពិតប្រាកដ ។ លើស ពី នេះ ទៀត ជ័យជម្នះ ៧ មករា ១៩៧៩ ក៏ បាន រួម វិភាគទាន ដ៏ សកម្ម ដល់ សន្តិភាព និង ស្ថិរភាព នៅក្នុង តំបន់ ផងដែរ ។
ប្រជាជន កម្ពុជា បាន ប្រសិទ្ធ នាម ថា ថ្ងៃ ៧មករា ១៩៧៩ គឺជា ថ្ងៃ កំណើត ទី ពីរ របស់ ខ្លួន បើ គ្មាន ជ័យជម្នះ ៧មករា ក៏ យើង គ្មាន អ្វី ៗ នៅ ថ្ងៃ នេះ ដែរ ដែល នេះ ជា សច្ចធម៌ ប្រវត្តិសាស្ត្រ គ្មាន ជន ណា ឬ កម្លាំង ណាឤច មក បំភ្លៃ ឬ បំផ្លាញ បាន ឡើយ ។
ប្រជាពលរដ្ឋ ស្រុក កំចាយ មារ បាន កំណត់ ក្នុង ចិត្ត ច្បាស់ ថា ៧មករា គឺជា ថ្ងៃ កំណើត ទី២ របស់ ខ្លួន . ៧មករា ពិតជា បាន នាំមក នូវ ការបង្រួបបង្រួម ជាតិ ៧មករា ពិតជា បាន នាំមក នូវ ការអភិវឌ្ឍ ជាតិ ។ ប្រជាពលរដ្ឋ កំចាយ មារ ពិតជា បាន ផ្តល់ នូវ សច្ច ធ៌ម សម្រាប់ ថ្ងៃ ៧មករា ហើយ ចងចាំ ទុក ជារៀងរហូត ដូច្នេះ ទិវា ជា ប្រវត្តិសាស្ត្រ នេះ ត្រូវបាន កត់ត្រា ទុក ជារៀងរហូត នៅក្នុង ការចងចាំ របស់ ប្រជាជន គ្រប់ ៗ រូប គ្រប់ ៗ ជំនាន់ ដែល ស្រឡាញ់ សន្តិភាព សេរីភាព និង យុត្តិធម៌ ។
នៅក្នុង ពិធី នេះ លោក ស្តើង សុខុម ក៏ បាន ឆ្លៀត ជម្រាប ជូន អង្គ មិទ្ទិញ អំពី លទ្ធផល នៃ សន្និបាត គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា លើក ទី៤៥ បើក ទូលាយ ជូន ដល់ សមាជិក សមាជិកា នៃ អង្គមិ ទ្ទិញ ថា សន្និបាត គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា កាលពី ចុង ខែធ្នូ កន្លងទៅ បាន អញ្ជើញ តំណាង សំខាន់ ៗ គ្រប់ សមាសភាព ពី ថ្នាក់ ក្រោម ជាតិ និង ថ្នាក់ ជាតិ ចូលរួម ។
លោក Castro មាន អាយុ ៤៤ ឆ្នាំ ដែល ជា ចៅ ប្រុស ជនភៀសខ្លួន ម៉ិចស៊ីកូ ម្នាក់ និង ជា អតីត រដ្ឋមន្ត្រី លំនៅដ្ឋាន និង អភិវឌ្ឍ ទីក្រុង ក្នុង សម័យ លោក បារ៉ាក់ អូបាម៉ា បាន ប្រកាស ឈរឈ្មោះ ជា បេក្ខភាព ប្រធានាធិបតី អាមេរិក ជា ផ្លូវការ កាលពី ថ្ងៃសៅរ៍ ( ម៉ោង នៅក្នុង តំបន់ ) ដើម្បី ចូលរួម ប្រកួតប្រជែង ជាមួយ បេក្ខភាព ដទៃ ព្រមទាំង លោក ដូណាល់ ត្រាំ នៅក្នុង ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី អាមេរិក ដែល គ្រោង នឹង ប្រព្រឹត្ត ទៅ នៅ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
ជាមួយគ្នា នោះ ដែរ ថ្លែង នា ឱកាស បើក យុទ្ធនាការ ក្រោម ពាក្យស្លោក « ប្រជាជាតិ មួយ ជោគវាសនា តែ មួយ » លោក Castro បាន លើកឡើង ដូច្នេះ ថា៖ « ខ្ញុំ បាន សម្រេចចិត្ត ចូលរួម ប្រជែង យក តំណែង ជា ប្រធានាធិបតី អាមេរិក ពីព្រោះ វា គឺជា ពេលវេលា សម្រាប់ មេដឹកនាំ ថ្មី និង ជា ពេល វេលា សម្រាប់ ថាមពល ថ្មី ហើយ វា ក៏ ជា ពេលវេលា សម្រាប់ ការប្ដេជ្ញាចិត្ត បង្កើត ឱកាស នានា សម្រាប់ ប្រជាជន អាមេរិក គ្រប់ រូប ផងដែរ » ។
( ព្រះវិហារ ) ៖ ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក រវៀង ខេត្ត ព្រះវិហារ លោក ហោ ប៊ុន ហ៊ួរ ត្រូវបាន ប្រកាស ចូលកាន់ តំណែង ជា ផ្លូវការ ក្រោម វត្តមាន លោក អ៊ុន ចាន់ ដា សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ ។
ពិធី ប្រកាស ចូលកាន់ តំណែង បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០១៩ នេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ គណបក្ស ខេត្ត ស្រុក ឃុំ ភូមិ ជាច្រើន រូប ទៀត ។
លោក អ៊ុន ចាន់ ដា បាន ថ្លែង ថា គណបក្ស ប្រជាជន កម្ពុជា គឺជា គណបក្ស មួយ ដែល ធំ ជាង គេ ដែល មាន ប្រជាប្រិយភាព មាន ការគាំទ្រ ច្រើន លើសលប់ ពីសំណាក់ ប្រជាពលរដ្ឋ ខ្មែរ ។ លោក បាន ជំរុញ ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន គ្រប់ លំដាប់ថ្នាក់ ត្រូវ បន្ត ធ្វើ នូវ អំពើ ល្អ ជានិច្ច ជាមួយ ប្រជាពលរដ្ឋ ។
លោក អ៊ុន ចាន់ ដា ក៏ បាន ជំរុញ មន្ត្រី គណបក្ស ប្រជាជន កម្ពុ ជាពិសេស លោក ប្រធាន គណបក្ស ស្រុក រវៀង ដែល ទើបតែងតាំង ថ្មី ត្រូវ មាន សាមគ្គីភាព គ្នា ឯកភាព ផ្ទៃក្នុង ។ លោក សង្កត់ធ្ងន់ ថា គ្មាន គណបក្ស ណា អាច ផ្តួលរំលំ គណបក្ស ប្រជាជន កម្ពុជា បាន ទេ មាន តែ មន្ត្រី គណបក្ស ប្រជាជន កម្ពុជា ទេ ដែល អាច ផ្តួលរំលំ គណបក្ស ប្រជាជន កម្ពុជា ខ្លួន ឯង បាន ដោយ ផ្តើម ចេញ ពី ការបែកបាក់ សាមគ្គី នេះ ឯង ។
លោក ហោ ប៊ុន ហ៊ួរ ដែល ត្រូវបាន តែងតាំង ថ្មី នេះ បាន ប្តេជ្ញាចិត្ត ខិតខំ ធ្វើការ ដោយ រួម សហការ ជាមួយ មន្ត្រី គណបក្ស គ្រប់ លំដាប់ថ្នាក់ ទូទាំង ស្រុក រវៀង ដើម្បី ដណ្តើម ជ័យ ជូន គណបក្ស ប្រជាជន កម្ពុជា គ្រប់ ការបោះឆ្នោត នៅ អាណត្តិ ក្រោយ ៗ ទៀត ៕ លោក ប៉ែន បូណា៖ សំណេរ ប្រធាន កិត្តិយស បក្ស ខ្មែរ ក្រោក សាង កំហុស ធំ ពីរ គឺ បំភ្លៃប្រសាសន៍ សម្តេច នាយក រដ្ឋមន្ត្រី និង មើលងាយ អ្នក ព័ត៌មាន
( ភ្នំពេញ ) ៖ ប្រធាន ក្លឹប អ្នកកាសែត កម្ពុជា លោក ប៉ែន បូណា បាន លើកឡើង ថា សំណេរ របស់ ប្រធាន កិត្តិយស គណបក្ស ខ្មែរ ក្រោក លោក ព្រំ ពិសិដ្ឋ បាន សាង កំហុស ធំ ចំនួន ពីរ ។ កំហុសទី១ គឺ បំភ្លៃប្រសាសន៍ ដើម របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង កំហុស ទី២ គឺ មើលងាយ ធ្ងន់ធ្ងរ ចំពោះ អ្នកសារព័ត៌មាន ។
សូម បញ្ជាក់ ថា អ្នក ព័ត៌មាន នៅ កម្ពុជា ជាច្រើន បាន ខឹងសម្បា ចំពោះ សម្តី ឥត សីលធម៌ របស់ ប្រធាន កិត្តិយស បក្ស ដែល មាន ប្រធាន ជា ក្មេង មាន ប្រវត្តិ មិន ល្អ រុំ ស្រោម ដោយ រឿង អាស្រូវ បោកប្រាស់ គេ និង វាយ ធ្វើបាប ភរិយា ជាដើម នោះ ។
ភស្តុតាង ដែល អាច បញ្ជាក់ បាន យ៉ាង ច្បាស់ នោះ គឺ នៅ ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ លោក ព្រំ ពិសិដ្ឋ បាន ផ្សាយ ផ្ទាល់ លើ គណនី មួយ នេះ ដោយ និយាយ ពី ការធ្វើ កំណែទម្រង់ ប្រព័ន្ធ យុត្តិធម៌ នៅ កម្ពុជា ។ ការផ្សាយ ផ្ទាល់ បែប នេះ មិន មាន ជន ដទៃ ណាមួយ អាច មក ធ្វើ បាន នោះ ឡើយ ក្រៅតែ ពី ម្ចាស់ គណនី ផ្ទាល់ ។
លិខិត មិត្ត អ្នកអាន៖ បូក លេខ មិន ដែល ត្រូវ ជា អាស្រូវ នយោបាយ ធំ បំផុត របស់ សម រង្ស៊ី
( ភ្នំពេញ ) ៖ ក្នុង នាម អ្នកតាមដាន នយោបាយ តាម តុ កាហ្វេ ម្នាក់ ខ្ញុំ បាន សង្កេតឃើញ ថា ជាង ២៥ ឆ្នាំ មក នេះ គឺ លោក សម រង្ស៊ី ពិតជា អ្នកនយោបាយ ខ្សោយ បញ្ញា និង អន់ ខាង គណិតវិទ្យា ខ្លាំង ណាស់ ពីព្រោះ គាត់ គុណ គូរ បូក លេខ មិន ដែល ត្រូវ ម្តង ណា ឡើយ ។ នេះ ជា មូលហេតុ ចម្បង ដែល ធ្វើឲ្យ ជីវិត នយោបាយ របស់ គាត់ តែងតែ បរាជ័យ និង បន្ត ធ្លាក់ ដុន ដាប ដល់ ម្លឹង ។
ដើម្បី មើល ឲ្យ ឃើញ ថា ហេតុអី បានជា ខ្ញុំ ហ៊ាន និយាយ ថា លោក សម រង្ស៊ី អន់ បញ្ញា និង ខ្សោយ ខាង គណិតវិទ្យា យើង គួរ ក្រឡេក ថយ ក្រោយ បន្តិច ទៅ មើល ការសម្រេចចិត្ត សំខាន់ ៗ មួយចំនួន ខាង នយោបាយ របស់ គាត់ ដែល ជា លទ្ធផល នៃ ការវាយតំលៃ សភាពការណ៍ មិន ត្រូវ និង បូក លេខ ខុស ដែល ជា កំហុស ផ្នែក យុទ្ធសាស្ត្រ និង យុទ្ធ វិធី ក្នុង ការប្រកួតប្រជែង នយោបាយ ដណ្តើម ប្រជាប្រិយភាព និង អំណាច ដូចតទៅ នេះ៖
ទីបំផុត ហ្វ៊ុន ស៊ិនប៉ិច ក៏ រលាយ គណបក្ស សម រង្ស៊ី ក៏ គ្មាន កំណើត ។ កាល ណោះ បើ គាត់ កុំ ដាក់ លេខ បូក សុប្បនិម្មិត ច្រើន ពេក លើ ខ្លួន គាត់ ហើយ អត់ធ្មត់ នៅ រួបរួម ជាមួយ សម្តេច ក្រុម ព្រះ ហើយ កុំ បំបែក ហ្វ៊ុន ស៊ិនប៉ិច ម្ល៉េះ សម គណបក្ស រាជានិយម មួយ នេះ ប្រហែលជា អាច នៅតែ ខ្លាំង រហូត សព្វ ថ្ងៃ មិន ចុះ ដុន ដាប បែប នេះ ទេ ហើយ លោក សម រង្ស៊ី ក៍ ប្រហែលជា អាច មាន ប្រជាប្រិយភាព អំណាច និង ឥទ្ធិពល មិន រសាត់ អណ្តែត ដូច សព្វ ថ្ងៃ នេះ ដែរ ។
ទី៣៖ នៅ ឆ្នាំ ២០០៨ លោក សម រង្ស៊ី បាន វាយតំលៃ ជ្រុល ហួស និង ដាក់ លេខ បូក ទាំង ស្រមើស្រមៃ ថា គាត់ អាច មាន កំលាំង លើ ស ពី គ្រប់គ្រាន់ ដើម្បី ឈោង ចាប់ អំណាច បាន ឆាប់ ប្រសិនបើ រដ្ឋធម្មនុញ្ញ កំណត់ ត្រឹម សំឡេង ៥០% បូក ១ ។ ភាព ស្រមើស្រមៃ ដេក យល់សប្តិ ឃើញ តែ អំណាច ក៏ បាន ជំរុញ ចិត្ត លោភលន់ របស់ គាត់ ឲ្យ គាំទ្រ និង ចូលរួម ធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ ដោយ ប្តូរ ពី ពីរ ភាគ បី មក ជា ៥០% បូក១ វិញ ។
តាមពិត រូប មន្ត ថ្មី នេះ មាន បាន ជួយ គាត់ ឯណា តែ ផ្ទុយទៅវិញ គឺជា អំណោយផល ដល់ បក្ស កាន់អំណាច ហើយក៏ ធ្វើឲ្យ គាត់ ឃ្លាត ឆ្ងាយ ពី អំណាច កាន់តែ ឆ្ងាយ ទៅ ៗ ។ បើសិនជា សម រង្ស៊ី ពូកែ គណិតវិទ្យា ជាង នេះ តែ បន្តិច ម្ល៉េះ សម គាត់ នឹង ទទួលបាន ផលចំណេញ ច្រើន ជាង នេះ ក្នុង ល្បែង នយោបាយ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ។
ប៉ុន្តែ ផ្ទុយទៅវិញ សម រង្ស៊ី បែរជា បង្ខាំង អ្នក ទាំងអស់ នោះ អោយ នៅក្នុង ទ្រុង ជាមួយ គាត់ ទាំង ពេល ទ្វារ បើកចំហ ។ មិន តែ ប៉ុណ្ណោះ សម រង្ស៊ី បែរ ទៅជា និយាយ ថា លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បរាជ័យ ពីព្រោះ គ្មាន អ្នកណា មក ទទួល សិទ្ធិ ធ្វើ នយោបាយ ? នេះ ជា រឿង គួរឲ្យ អស់ សំណើច ។ ចុះ អ្នកនយោបាយ អី ក៏ បញ្ញា អន់ យ៉ាង នេះ ?
សមត្ថកិច្ច ចាប់ ជនសង្ស័យ ៤នាក់ ពាក់ព័ន្ធ ករណី ឆក់ ទូរស័ព្ទ ជន បរទេស នៅ ភ្នំពេញ
( ភ្នំពេញ ) ៖ កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន ឃាត់ខ្លួន ជនសង្ស័យ ៤នាក់ ជា បន្ដ បន្ទាប់ ពាក់ព័ន្ធ ករណី ឆក់ ទូរស័ព្ទ ជនជាតិ បារាំង និង ជនជាតិ ចិន ២កន្លែង ផ្សេង គ្នា ដោយ មួយ ករណី នៅ ខណ្ឌ ដូនពេញ និង មួយ ករណី ទៀត នៅ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ។
វរសេនីយ៍ ឯក ខេង ម៉េង ឈាង នាយ ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល បាន ប្រាប់ អង្គភាព Fresh News ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០១៩ នេះ ថា ប្រតិបត្តិការ ជា បន្ដ បន្ទាប់ នេះ បាន ធ្វើឡើង ក្រោម ការណែនាំ និង បញ្ជា ផ្ទាល់ ពី ឧត្តមសេនីយ៍ ឯក ង៉េង ជួ ប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ និង អគ្គ ស្នងការ រង នគរបាល ជាតិ ទទួល ផែន កណ្ដាល នគរបាល យុត្តិធម៌ ។
