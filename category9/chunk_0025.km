( កណ្តាល ) ៖ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន ធ្វើ បច្ចុប្បន្នភាព ចំនួន ទ័ព - កូន និង យុទ្ធោបករណ៍ កងរាជអាវុធហត្ថ ក្រោម អធិបតីភាព ឧត្តមសេនីយ៍ ទោ ជួន ជឿន ស្នងការ នៃ ស្នងការដ្ឋាន សម្ភារ បច្ចេកទេស កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា ប្រធាន អនុគណៈកម្មការ ទី២ ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី ឧត្តមសេនីយ៍ ទោ ហ៉ឺម ភីរិន្ទ នាយក រង ទី ចាត់ការ បុគ្គលិក អគ្គ បញ្ជាការ ជា អនុគណៈកម្មការ ទី២ និង ឧត្តមសេនីយ៍ ត្រី សំ តុលា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល ព្រមទាំង ក្រុមការងារ ដែល មាន ការពាក់ព័ន្ធ និង នាយ រង អាវុធហត្ថ ខេត្ត កណ្តាល ជាច្រើន រូប ទៀត ។
ដោយឡែក ចំពោះ ការចុះ មក ត្រួតពិនិត្យ នេះ គឺ គណៈកម្មាធិការ គ្រាន់តែ ស្រង់ ឱ្យដឹង ថា មាន ខុស អ្វី ខ្លះ ត្រូវ អ្វី ខ្លះ និង ខុស មាន ចំនួន ប៉ុន្មាន ។ ចំពោះ ការកែតម្រូវ ឬ មិន កែតម្រូវ ក្រុមការងារ ធ្វើ បច្ចុប្បន្នភាព ចំនួន ទ័ព - កូន គ្មាន សិទ្ធ នោះ ទេ គឺ ដាក់ ជូន ថ្នាក់ លើ ជា អ្នកសម្រេច ៕
ថ្លែង ក្នុង ពិធី បើក ការដ្ឋាន សាងសង់ សាលារៀន មួយ កន្លែង នៅ ភាគ ខាងជើង រដ្ឋធានីម៉ានីល លោក ឌូតឺ តេ បាន និយាយ ថា មាន តែ រូប លោក ម្នាក់ ប៉ុណ្ណោះ ដែល អាច ហៅ ក្រុម អាចារ្យ គ្រឹស្ត សាសនា ថា ជា កូនស្រី សំផឹង បាន ហើយ វា ជា ការពិត ជាក់ស្តែង ។ លោក ប្រធានាធិបតី ហ្វីលីពីន បាន បន្ត ទៀត ថា ភាគ ច្រើន នៃ បុគ្គល ទាំងនេះ គឺ សុទ្ធតែ ជា មនុស្ស ស្រឡាញ់ ភេទ ដូចគ្នា ដូច្នេះ ពួកគេ គួរតែ ឈប់ ធ្វើពុត ទៀត ហើយ បោះបង់ វិន័យ សាសនា ចោល ទៅ ដើម្បីឲ្យ អាច មាន មិត្ត ប្រុស បាន ។
លោក ឌូតឺ តេ មិន បាន បញ្ជាក់ ហេតុផល ច្បាស់ ថា តើ ហេតុ បានជា លោក ធ្វើ ការតិះដៀល លើ ក្រុម អាចារ្យ គ្រឹស្ត សាសនា នៅ ថ្ងៃព្រហស្បតិ៍ នេះ ឡើយ ប៉ុន្តែ លោក ក៏ ធ្លាប់ បាន ធ្វើ យ៉ាង ដូច្នេះ ពីមុន មក ផងដែរ ដោយ កាល នោះ សមាគម ព្រះវិហារ គ្រឹស្ត សាសនា នៅ ហ្វីលីពីន បាន រិះគន់ លើ យុទ្ធ ការ បង្រ្កាប គ្រឿងញៀន ដ៏ ចម្រូងចម្រាស របស់ លោក ។
គួរ ជម្រាប ថា ព្រះវិហារ គ្រឹស្ត សាសនា រ៉ូមាំង កាតូលិក កំពុង ប្រឈមមុខ នឹង រឿង អាស្រូវ បៀតបៀន ផ្លូវភេទ ( ជាពិសេស លើ ក្មេងប្រុស ៗ ) នៅ តាម តំបន់ ខុស ៗ គ្នា ជុំវិញ ពិភពលោក ក៏ប៉ុន្តែ នៅ ហ្វីលីពីន ហាក់ ដូច មិន មាន ករណី ធំដុំ ណាមួយ បាន ផ្ទុះឡើង នោះ ឡើយ ។ សម្រាប់ ប្រជាជន ជាង ១០០ លាន នាក់ នៃ ប្រទេស ហ្វីលីពីន ក្នុង នោះ ៨០ ភាគរយ គឺជា អ្នក កាន់ សាសនា គ្រឹស្ត និកាយ រ៉ូមាំង កាតូលិក ៕
នាយក រដ្ឋមន្រ្តី តៃវ៉ាន់ និង គណៈ រដ្ឋមន្រ្តី ទាំងមូល ត្រៀម លា លែង ពី តំណែង នៅ ថ្ងៃស្អែក ក្រោយ ចាញ់ ឆ្នោត ថ្នាក់ តំបន់
យ៉ាងណា ក៏ដោយ ការចាកចេញ របស់ លោក Lai ត្រូវបាន មនុស្ស ភាគ ច្រើន រំពឹងទុក មុន រួចស្រេច ទៅ ហើយ ពីព្រោះ វា គឺជា ស្តង់ដា ទំនៀមទម្លាប់ នៅ តៃវ៉ាន់ នៅពេល គណបក្ស នយោបាយ របស់ ថ្នាក់ដឹកនាំ ចាញ់ ឆ្នោត សំខាន់ ៗ ណាមួយ ពួកគេ តែងតែ ដើរ ចេញ ។
ការចាញ់ ឆ្នោត នេះ គឺ បញ្ហា ប្រឈម ធំ មួយ សម្រាប់ លោកស្រី Tsai ដែល បាន ទទួលរង ការរិះគន់ ជាខ្លាំង នៅក្នុង ស្រុក ជុំវិញ គោលដៅ កំណែទម្រង់ របស់ លោកស្រី ព្រមទាំង ការគំរាមកំហែង កាន់តែ ខ្លាំង ឡើង ពីសំណាក់ ទីក្រុង ប៉េកាំង ៕
មន្ត្រី៖ កម្ពុជា នឹង ដាក់ ឲ្យ ប្រើប្រាស់ ច្បាប់ ពាណិជ្ជកម្ម អនឡាញ នៅក្នុង ឆ្នាំ នេះ !
ច្បាប់ ពាណិជ្ជកម្ម អនឡាញ ដែល គ្រោង ដាក់ ចេញ នេះ ត្រូវបាន គណៈ រដ្ឋមន្ត្រី កំពុង ពិនិត្យ លើ សំណុំ ឯកសារ មួយចំនួន ដោយ គេ បាន ព្យាករណ៍ ថា នឹង ត្រូវ ចេញ ជា រូបរាង នៅក្នុង ឆ្នាំ នេះ ។
លោក ថៅ សុខ មុនី អនុ រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម ឲ្យដឹង ក្នុង សិក្ខាសាលា ស្ដីពី « ការអភិវឌ្ឍន៍ ពាណិជ្ជកម្ម នៅ តំបន់ ជនបទ ក្នុង ប្រទេស កម្ពុជា » ដែល រៀបចំឡើង នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩នេះ ថា ច្បាប់ ពាណិជ្ជកម្ម អនឡាញ ដែល ក្រសួង ពាណិជ្ជកម្ម បាន ចងក្រង ឡើង អស់ រយៈពេល ជា យូរ ឆ្នាំ មកហើយ ខណៈពេលនេះ កំពុង ស្ថិត ក្នុង ដំណាក់កាល ពិនិត្យ កម្រិត ជំនាញ នៅ គណៈ រដ្ឋមន្ត្រី ។
លោក បន្ដ ថា « ការដាក់ចេញ ច្បាប់ ពាណិជ្ជកម្ម អនឡាញ នេះ ដើម្បី ជំរុញ ផលិតផល ក្នុង ស្រុក ឲ្យ មាន ទីផ្សារ កាន់តែ ទូលំទូលាយ មាន ន័យ ថា ប្រជាជន នៅ កម្ពុជា មាន ប្រមាណ ១៦លាន នាក់ តែ ប្រសិនបើ យើង លក់ ទំនិញ ធម្មតា លក់ បាន ត្រឹមតែ ១៦លាន នាក់ ប៉ុន្ដែ បើ លក់ តាម ប្រព័ន្ធ អនឡាញ នឹង លក់ បាន ច្រើន ជាង នេះ មិន ត្រឹមតែ លក់ ក្នុង ស្រុក ប៉ុណ្ណោះ ទេ តែ លក់ ដល់ បរទេស ថែម ទៀត ផង » ។
លោក បន្ថែម ថា ការដាក់ចេញ ច្បាប់ ពាណិជ្ជកម្ម អនឡាញ នេះ គឺ ល្អ ប្រសើរ បំផុត សម្រាប់ កម្ពុជា ព្រោះ ផ្ដល់ ប្រយោជន៍ ដល់ អ្នកលក់ និង អ្នកទិញ មាន ន័យ ថា នៅពេល ច្បាប់ នេះ ចេញ ជា ផ្លូវការ អ្នកលក់ មិន អាច បោកប្រាស់ អ្នកទិញ ដោយ ប្រការ ផ្សេង ៗ ដូច ជា៖ ទំនិញ មិន ដូច រូបភាព . ទំនិញ គ្មាន គុណភាព . គ្មាន ភាពទទួលខុសត្រូវ លើ ការដឹកជញ្ជូន ឲ្យ អតិថិជន ផ្ញើ លុយ តែ មិន ផ្ញើ ទំនិញ ជាដើម ។ ដោយឡែក សម្រាប់ អ្នកទិញ ក៏ ដូចគ្នា ដែរ គឺ មិន អាច បោកប្រាស់ អ្នកលក់ ដោយ ប្រការ ផ្សេង ៗ ឡើយ ។
លោក បញ្ជាក់ ថា « ប្រសិនបើ ច្បាប់ ពាណិជ្ជកម្ម អនឡាញ នេះ ត្រូវបាន ពិភាក្សា ពី គណៈ រដ្ឋមន្រ្ដី នូវ កម្រិត បច្ចេកទេស ទៅ ឃើញ ថា គ្រប់គ្រាន់ នឹង អាច ចេញ លឿន និយាយ រួម ច្បាប់ នេះ នឹង ចេញ ជា ផ្លូវការ នៅក្នុង ឆ្នាំ ២០១៩ តែម្ដង » ។
លោក បណ្ឌិត គី សេរី វឌ្ឍន៍ អ្នកជំនាញ សេដ្ឋកិច្ច និង ជា ប្រធាន មជ្ឈមណ្ឌល សិក្សា ចិន នៃ រាជ បណ្ឌិត សភា កម្ពុជា ឲ្យដឹង ថា ពាណិជ្ជកម្ម អនឡាញ ពិតជា មាន សារៈសំខាន់ ប៉ុន្ដែ មាន ប្រជាពលរដ្ឋ តាម ទី ជនបទ មិន ទាន់ យល់ដឹង និង ចេះ ប្រើប្រាស់ នូវ ប្រព័ន្ធ អ៊ីនធើណេត នេះ នៅឡើយ ទេ ដូច្នេះ គួរតែ មាន គ្រូបង្គោល ប្រចាំ តាម តំបន់ នីមួយ ៗ ដើម្បី បណ្ដុះបណ្ដាល ពី ការប្រើប្រាស់ ប្រព័ន្ធ អ៊ីនធើណេត នេះ ។
លោក បន្ថែម ថា ដើម្បីឲ្យ អាជីវកម្ម រ នេះ ដើរ បាន ដោយ រលូន និង ជោគជ័យ ភាគី ពាក់ព័ន្ធ ទាំងអស់ គួរតែ រក វិធីសាស្រ្ដ នានា ទៅ លើ ការចែករំលែក ប្រព័ន្ធ ព័ត៌មាន ឲ្យ កាន់តែ ទូលំទូលាយ . ការរក កន្លែង រក្សាទុក ទំនិញ ផ្សេង ៗ . ប្រព័ន្ធ ដឹកជញ្ជូន . ការទូទាត់ ជាដើម ។
លោក ងួន ម៉េង តិច អគ្គ នាយក សភា ពាណិជ្ជកម្ម កម្ពុជា ឲ្យដឹង ថា តាំងពី ដើម រហូតដល់ បច្ចុប្បន្ន ការធ្វើ ពាណិជ្ជកម្ម នៅ កម្ពុជា ត្រូវ ពឹងផ្អែក លើ ការទូទាត់ ប្រាក់ សុទ្ធ និង ត្រូវ ទៅដល់ ទីតាំង ទំនិញ ផ្ទាល់ តែម្ដង កត្តា ទាំងនេះ ធ្វើឲ្យ ខាត ពេលវេលា . ខាតបង់ ប្រាក់កាស និង ផ្ដល់ កត្តា ហានី ភ័យ សម្រាប់ អ្នកលក់ និង អ្នកទិញ ។
វីរកីឡាការិនី ប៉េតង់ កម្ពុជា បាន ថ្លែង បែប នេះ ក្នុង ឱកាស ដែល នាយកដ្ឋាន អប់រំ និង កីឡា បាន រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី ការជ្រើសតាំង លោកស្រី ជា បេក្ខភាព នារី ប៉េតង់ ឆ្នើម ពិភពលោក ប្រចាំ ឆ្នាំ ២០១៨ នៅ ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក នា រសៀល ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ ។
កីឡាការិនី វ័យ ៥៧ ឆ្នាំ រូប នេះ បាន ឱ្យដឹង បន្ថែម ថា ក្រៅពី មេដាយ ដ៏ ច្រើន ខាងលើ លោកស្រី ក៏ តែងតែ ទទួលបាន ប្រាក់ រង្វាន់ លើកទឹកចិត្ត ពី រាជ រដ្ឋាភិបាល កម្ពុជា គ្រប់ ពេល ត្រឡប់ មកពី ការប្រកួត ផងដែរ ដែល នេះ ជា កត្តា ជំរុញ ឱ្យ លោកស្រី ត្រូវ ខិតខំ ប្រឹង ស្វែងរក មេដាយ ជូន ជាតិ ជា បន្តបន្ទាប់ ទៀត ។
គួរ ជម្រាប ថា លោកស្រី កែ ឡេង ត្រូវបាន ជ្រើសរើស ឱ្យ ឈរ ជា បេក្ខ នារី ប៉េតង់ ឆ្នើម ពិភពលោក សម្រាប់ ឆ្នាំ ២០១៨ តំណាង ឱ្យ ប្រទេស កម្ពុជា ដើម្បី ប្រកួត តាមរយៈ ការបោះឆ្នោត Online ក្នុង ចំណោម បេក្ខភាព ជាច្រើន នាក់ មកពី ជុំវិញ ពិភពលោក ។ លោកស្រី គឺជា វីរកីឡាការិនី កម្ពុជា តែ១ រូប គត់ ដែល បាន ឈ្នះ មេដាយ មាស ពិភពលោក នៃ ការប្រកួត ប៉េតង់ ចំនួន ៤លើក មក ហើយ គឺ៖ ឆ្នាំ ២០១៣ នៅ ប្រទេស បារាំង . ឆ្នាំ ២០១៥ នៅ ប្រទេស ថៃ . ឆ្នាំ ២០១៧ នៅ ប្រទេស ចិន និង ឆ្នាំ ២០១៨ នៅ ប្រទេស បារាំង ម្តង ទៀត ។
រដ្ឋលេខាធិការ និង ជា មន្ត្រី នាំ ពាក្យ ក្រសួង បរិស្ថាន បាន ថ្លែង នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ ថា បឹង លំកុដ ជា បឹង ធម្មជាតិ ដែល សម្បូរ ដោយ ធនធាន ធម្មជាតិ មាន ព្រៃឈើ សត្វ ព្រៃ និង ទេសភាព ល្អ ស្អាត និង ប្រព័ន្ធ អេកូឡូស៊ីសម្បូរបែប ផ្សេង ទៀត ហើយ បច្ចុប្បន្ន នេះ បាន និង កំពុង ទាក់ទាញ ភ្ញៀវ ទេសចរ ទៅ កម្សាន្ត នៅ ទីនោះ ហេតុ ដូច្នេះហើយ បានជា ក្រសួង បរិស្ថាន ស្នើសុំ ដាក់ បឹង លំកុដ នេះ ជា តំបន់ ការពារ ទេសភាព ។
បើ តាម រដ្ឋលេខាធិការ កករសួង បរិស្ថាន រូប នេះ បច្ចុប្បន្ន ប្រព័ន្ធ តំបន់ ការពារ ធម្មជាតិ រួម មាន តំបន់ ការពារ ធម្មជាតិ ចំនួន និង របៀង អភិរក្ស ជីវៈ ចម្រុះ សរុប ជិត ៦០ កន្លែង មាន ផ្ទៃដី ទំហំ ៧. ៥ លាន ហិកតា ស្ថិត នៅក្រោម ការគ្រប់គ្រង ការពារ និង អភិរក្ស របស់ ក្រសួង បរិស្ថាន ។ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រសួង បរិស្ថាន បាន ចាត់ វិធានការ ចាំបាច់ នានា ដើម្បី ការពារ និង អភិរក្ស ធនធាន ធម្មជាតិ ឱ្យ បាន គង់វង្ស សម្រាប់ មនុស្ស រាប់ ជំនាន់ តទៅទៀត ៕
សាស្ត្រាចារ្យ ស៊ា ហ៊ួង ផ្សព្វផ្សាយ របាយការណ៍ និង លទ្ធផល សន្និបាត គណៈកម្មាធិការ កណ្តាល លើក ទី ៤១ អាណត្តិ ទី៥ របស់ គណបក្ស ប្រជាជន កម្ពុជា
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ គណបក្ស មូលដ្ឋាន មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត និង គណបក្ស មូលដ្ឋាន នាយកដ្ឋាន រដ្ឋបាល - ហិរញ្ញវត្ថុ នៃ ក្រសួង សុខាភិបាល បាន ធ្វើ ការផ្សព្វផ្សាយ របាយការណ៍ និង សេចក្តីសម្រេចចិត្ត ស្តីពី លទ្ធផល សន្និបាត គណៈកម្មាធិការ កណ្តាល លើក ទី ៤១ អាណត្តិ ទី៥ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
កម្មវិធី នេះ ក្រោម អធិបតីភាព លោក សាស្ត្រាចារ្យ ស៊ា ហ៊ួង សមាជិក អចិន្ដ្រៃយ៍ គណបក្ស ប្រជាជន កម្ពុជា និង មាន ការចូលរួម ដោយ បុគ្គលិក សមាជិក សមាជិកា បក្ស ទាំងអស់ សរុប ចំនួន ៧៥៥ នាក់ ។
លោក សាស្ត្រាចារ្យ ស៊ា ហ៊ួង បាន បញ្ជាក់ បន្ថែម ពី ជោគជ័យ របស់ គណបក្ស ប្រជាជន ដែល បាន អនុវត្តន៍ គោលការណ៍ របស់ ខ្លួន កន្លងមក ទទួលបាន លទ្ធផល ល្អ ប្រសើរ ។ កន្លងមក នេះ សមាជិក យើង ទំាង អស់ គ្នា បាន អនុវត្ត និង ពង្រឹង ពង្រីក សមត្ថភាព របស់ ខ្លួន បាន យ៉ាង រឹងមាំ ដែល ជា កិច្ច មាន អត្ថន័យ ចំពោះ ជោគជ័យ របស់ គណបក្ស ។
ក្នុង ឱកាស ក៏ មាន ការអាន របាយការណ៍ និង ទិសដៅ របស់ សន្និបាត គណៈកម្មការ កណ្តាល លើក ទី ៤១ អាណត្តិ ទី៥ របស់ គណបក្ស ប្រជាជន ផងដែរ ។
ក្រោយពី ការស្តាប់ លទ្ធផល នៃ ការផ្សព្វផ្សាយ សន្និបាត គណៈកម្មាធិការ កណ្តាល លើក ទី ៤១ អាណត្តិ ទី៥ របស់ គណបក្ស ប្រជាជន កម្ពុជា រួច មក សមាជិក សមាជិកា នៃ គណបក្ស ប្រជាជន បាន ជ្រួតជ្រាប និង យល់ដឹង កាន់តែ ច្បាស់ អំពី សារសំខាន់ នៃ អង្គ សន្និបាត នេះ ផងដែរ ៕
ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន៖ ការប៉ាន់ស្មាន ជា បឋម នៅក្នុង ឆ្នាំ ២០១៨ អត្រា កំណើន សេដ្ឋកិច្ច របស់ កម្ពុជា អាច សម្រេចបាន ក្នុង រង្វង់ ៧.៣%
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ថ្លែង ថា ការប៉ាន់ស្មាន ជា បឋម អត្រា កំណើន សេដ្ឋកិច្ច របស់ កម្ពុជា នៅក្នុង ឆ្នាំ ២០១៨ កន្លងទៅ នេះ អាច សម្រេចបាន ក្នុង រង្វង់ ៧.៣% ដែល កំណើន នេះ ទទួលបាន ពី ការកើនឡើង ដ៏ រឹងមាំ នៃ វិស័យ សំណង់ វិស័យ កាត់ដេរ វិស័យ ទេសចរណ៍ រួមទាំង វិស័យ ទូរគមនាគមន៍ និង ដឹកជញ្ជូន ។
លោក ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន បាន ថ្លែង យ៉ាង ដូចនេះ នា រសៀល ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល លោក បាន អញ្ជីញ ជា អធិបតី ក្នុង ពិធី បិទ សន្និបាទ បូកសរុប ការងារ របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។ ដែល ពិធី នេះ ដែរ ក៏ មាន ការចូលរួម ពី លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ព្រមទាំង មន្ត្រី គ្រប់ ជាន់ ថ្នាក់ ជាច្រើន រូប ទៀត ផងដែរ នៅ សាល សន្និសីទ ចតុមុខ ។
លោក អូន ព័ន្ធ មុនីរ័ត្ន បាន ថ្លែង ថា ឈរ លើ មូលដ្ឋាន នៃ លទ្ធផល ដែល សម្រេចបាន ខាងលើ នេះ កម្ពុជា បាន កំណត់ បំណងប្រាថ្នា របស់ ខ្លួន កាន់តែ ខ្ពស់ ជាង មុន ក្នុង ការប្រែក្លាយ ខ្លួន ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ ក្នុង ឆ្នាំ ២០៣០ និង ទៅជា ប្រទេស មាន ចំណូល ខ្ពស់ ត្រឹម ឆ្នាំ ២០៥០ ។
លោក បាន បញ្ជាក់ ថា ទន្ទឹម នេះ កម្ពុជា ក៏ បាន និង កំពុង ពង្រឹង ការតភ្ជាប់ ជាមួយ ប្រទេស នៅក្នុង តំបន់ គ្រប់ ប៉ូល និង របៀង សេដ្ឋកិច្ច សំខាន់ ៗ នៅក្នុង ប្រទេស និង ការចាប់ផ្ដើម រៀបចំ នូវ ប្រព័ន្ធ ឡូជី ស្ទីក ក្នុង ស្រុក ដែល នឹង រួមចំណែក កាត់ តែ ច្រើន ឡើង ៗ ក្នុង ការលើកកម្ពស់ សមត្ថភាព ប្រកួតប្រជែង និង ជំរុញ ពាណិជ្ជកម្ម មូលដ្ឋាន គាំទ្រ កំណើន សេដ្ឋកិច្ច របស់ កម្ពុជា បន្ថែម ទៀត ផងដែរ ។
សាខា កាំ កុងត្រូល ខេត្ត កំពង់ស្ពឺ ចុះ ពិនិត្យ ទំនិញ នៅ ផ្សារ ចំនួន ៣ និង ហាង ទំនិញ នានា នៅ តាម ផ្លូវ ជាតិ លេខ ៤
( កំពង់ស្ពឺ ) ៖ សាខា កាំ កុងត្រូល ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០១៩ នេះ បាន សហការ ជាមួយ មន្រ្តី មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត កំពង់ស្ពឺ បាន ចុះ អង្កេត ទីផ្សារ ចំនួន ៣ទីតាំង គឺ ផ្សារ ព្រៃ ផ្តៅ . ផ្សារ ត្រពាំង អំពិល . ផ្សារ សាមគ្គី និង ហាង លក់ ទំនិញ នានា តាម ផ្លូវ ជាតិ លេខ ៤ ចំនួន ៩ហាង ។
ក្នុង ប្រតិបត្តិការ នេះ មន្ដ្រី ជំនាញ បាន ត្រួតពិនិត្យភាព អនុលោម តាម បទដ្ឋាន បច្ចេក ទេស លើ ផ្លាក សញ្ញា ផលិតផល វេចខ្ចប់ ស្រេច ក្នុង គោលដៅ ធានា ដល់ ការប្រកួតប្រជែង ពាណិជ្ជកម្ម ប្រកបដោយ សមធម៌ និង កិច្ចការពារ អ្នកប្រើប្រាស់ និង ឲ្យ អាជីវករ សន្យា បញ្ឈប់ ការលក់ នំ ចំណី អាហារ វេចខ្ចប់ ស្រាប់ ទាំងឡាយ ណា ដែល មាន សំបក វេចខ្ចប់ មិន មាន ម៉ាក យីហោ អាសយដ្ឋាន ត្រឹមត្រូវ តាម បទដ្ឋាន បច្ចេកទេស នឹង ប្រឈមមុខ ការដកហូត និង ទទួលខុសត្រូវ តាម ច្បាប់ ជាធរមាន ។
បន្ថែម ពី នេះ មន្ដ្រី ជំនាញ បាន ពន្យល់ ណែនាំ ដល់ អាជីវករ ឲ្យ យល់ដឹង អំពី ផលវិបាក នៃ ការប្រើប្រាស់ សារធាតុ គីមី ហាម ឃាត់ ទៅ លើ ផលិតផល ម្ហូប អាហារ ឬ ការកែច្នៃ ម្ហូប អាហារ ដែល ធ្វើអោយ គ្រោះថ្នាក់ ដល់ សុខភាព ។ យល់ដឹង ពី លក្ខណៈ អនាម័យ នៃ ការដាក់ តាំង លក់ និង ការទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ លើ ផ្នែក សុវត្ថិភាព ម្ហូប អាហារ និង ប្រុងប្រយ័ត្ន ជៀសវាង ការដាក់ តាំង លក់ ទំនិញ ហួស កាលបរិច្ឆេទ ខូច គុណភាព និង ទំនិញ ក្លែងបន្លំ ។
( ភ្នំពេញ ) ៖ កម្ពុជា - វៀតណាម ចេញ សេចក្ដីប្រកាស ព័ត៌មាន រួមគ្នា ក្រោយ កិច្ចប្រជុំ លើក ទី១០ ស្តី កិច្ចសហប្រតិបត្តិការ និង ការអភិវឌ្ឍ បណ្តា ខេត្ត ជាប់ ព្រំដែន កម្ពុជា - វៀតណាម នៅ ថ្ងៃទី ០៩ - ១០ ខែមករា ឆ្នាំ ២០១៩នេះ នាទីក្រុង ហូជីមិញ នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ ជាមួយ លោក ផាម ប៊ិញ មីញ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ការបរទេស នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ។
សេចក្ដីប្រកាស រួមគ្នា រវាង កម្ពុជា - វៀតណាម មាន ខ្លឹមសារ ទាំងស្រុង នៅ ខាងក្រោម នេះ៖
* ភាគី ទាំង ពីរ បាន សង្កត់ធ្ងន់ អំពី សារៈសំខាន់ នៃ ការថែរក្សា ទំនាក់ទំនង ជា មិត្តភាព និង សហប្រតិបត្តិការ បណ្តា ខេត្ត ព្រំដែន កម្ពុជា - វៀតណាម ក៏ ដូចជា ពង្រឹង ពង្រីក ចំណង ទំនាក់ទំនង ក្នុង លក្ខណៈ ជា ភូមិ ផង ល្អ ប្រសើរ មិត្តភាព ជា ប្រពៃណី កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ ឋិតថេរ យូរអង្វែង រវាង កម្ពុជា និង វៀតណាម
* ភាគី ទាំង ពីរ បាន វាយតំលៃ ខ្ពស់ ចំពោះ ការផ្លាស់ប្តូរ ដំណើរទស្ស កិច្ច ទៅ វិញ ទៅ មក រវាង ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ នៃ ប្រទេស ទាំង ពីរ
