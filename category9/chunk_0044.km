« លោកម្ចាស់ តើលោកនឹងស្ដាររាជាណាចក្រដល់អ៊ីស្រាអែលនៅពេលនេះឬ ? » ។
ខ្ញុំ នឹង និយាយ អ្វី ដែល ប្រធាន ក្រុម នឹង មិន ។
បន្ទាប់មក គាត់បានឡើងទៅលើផ្ទះ កាច់នំបុ័ងបរិភោគ ។
បន្ទាប់មក ពួកគេចង់ឲ្យលោកនៅ ជាមួយពួកគេមួយថ្ងៃទៀត ។
ពួកគេបានទទួល ប្រយោជន៍ ទោះបីជាពួកគេខ្វះជំនឿក៏ដោយ ។
គាត់អង្វរព្រះយេស៊ូម្ដងហើយម្ដងទៀតកុំឲ្យបញ្ជូនគេចេញពីតំបន់នោះ ។
ហើយសំឡេងរបស់ពួកគេបានរំសាយសំឡេងកុមារ ។
វា ធ្វើឱ្យ អ្នក ផ្តោត អារម្មណ៍ នៅក្នុង ការណែនាំ របស់ អ្នក ដូច្នេះហើយ អ្នក និង គោលដៅ របស់ អ្នក កាន់តែ ច្រើន នៅក្នុង ជីវិត របស់ អ្នក ។
៣ ដើម្បីឲ្យអ្នក រាល់គ្នាបានសុខ សប្បាយ ហើយមានអាយុវែងនៅផែនដី » ។
សូម ទាក់ទង ទីប្រឹក្សា របស់ យើង ។
ពួកគេ បាន សម្លាប់ កូនប្រុស របស់ ខ្ញុំ ។
ខ្ញុំត្រូវបានផ្តល់ឧបករណ៍ដើម្បីស្វែង រកមេ ដឹកនាំនៅក្នុងខ្លួនខ្ញុំ ។
អ្នក ជាកូនរបស់សាតាំង ដែលបង្កើតសាតាំងជាឪពុករបស់អ្នក » ។
« អ្នក ណាដែលជឿលើខ្ញុំ ទោះជាស្លាប់ក៏ដោយ អ្នក នោះនឹងរស់ ហើយអ្នក ណាដែលមានជីវិត ហើយជឿលើខ្ញុំនឹងមិនស្លាប់ឡើយ ។
“ ខ្ញុំមិនដឹងថាខ្ញុំនឹងទៅ ណាទេ បើខ្ញុំត្រូវចាកចេញពីទីនេះ ។
យើងខ្លះគ្រាន់ តែល្អជាងយើងមួយចំនួនទៀត ( មើលត្រង់នេះ )!
អ្នក និយាយថា៖ « ព្រះ យេហូវ៉ាទ្រង់គង់ជាមួយនឹងយើង ។
" ហើយខ្ញុំគិតថាវាពិតជាសំណួរគោលនយោបាយដែលត្រូវនិយាយថា ' តើយើងធ្វើការ នៅកន្លែង ណា ហើយហេតុអ្វីបានជាយើងធ្វើការ នៅទីនោះ ? '"
នៅថ្ងៃកើត ហេតុ គាត់នៅក្រៅក្រុង ។
« ផ្ទុយទៅវិញ អ្នក ណាដែលឮព្រះបន្ទូលនៃព្រះ ហើយអនុវត្តនោះ មាន ពរហើយ » ( លូកា.
ច្បាប់ សំខាន់ មួយ ទៀត សម្រាប់ តាន់ គឺ ការសតិអារម្មណ៍ អ្នកដទៃ ដោយ គិត បី ដង អំពី អ្វី ដែល អ្នក នឹង និយាយ មុនពេល អ្នក និយាយ ដើម្បី ការពារ កុំ និយាយ ខុស និង ធ្វើឱ្យ នរណា ម្នាក់ ឈឺចាប់ ដោយ មិន ដឹងខ្លួន ។
ចូរ នាំ ពួកគេ មក ទីនេះ នោះ ខ្ញុំ នឹង ប្រោស ពួកគេ ឲ្យ ជា ព្រោះ ខ្ញុំ អាណិត អ្នក
នាងមានអាការផ្តាសាយតិចតួចពេញមួយសប្តាហ៍ ដូច្នេះយើងបានតាម ដាននាង ។
ដែលស្វែង រកព្រះភក្ត្រនៃព្រះ នៃយ៉ាកុប » ។
គណិតវិទ្យា គឺជា បិតា នៃ វិទ្យាសាស្ត្រ ។
នាង នៅ ម្នាក់ឯង គ្មាន កូន ។
ដូច្នេះខ្ញុំអាចនឹងទៅទីនេះ និងទីនោះដើម្បីសេព គប់ជាមួយនឹងអ្នក កាន់សាសនារបស់ទ្រង់ និងចានី » ។
នេះ អាច ជា ទីក្រុង ។
ចូរពោលនូវព្រះគុណរបស់ព្រះអង្គ ចូរ កាន់ ខ្ជាប់នូវអ្វីដែល ល្អ ។
នឹងធ្វើឲ្យគេនឹកឃើញដល់វត្ថុស័ក្តិសិទ្ធិ ដើម្បីឲ្យគេចាប់យក ។
បាន នាំ ពួកគេ មក ក្រោម កំហឹង ដែល ត្រូវបាន បង្ហូរ ទៅ លើ អ្នក មិន ជឿ ប៉ុន្តែ នៅតែ ការពារ អ្នក ជឿ ដូច ដែល ទ្រង់ បាន នាំ ពួកគេ ឆ្លងកាត់ ។
តើ អ្នក មិន ដឹង ថា ពួក បរិសុទ្ធ នឹង វិនិច្ឆ័យ ពិភពលោក ទេ ? ហើយ ប្រសិនបើ ពិភពលោក នឹង ត្រូវបាន វិនិច្ឆ័យ ដោយ អ្នក តើ អ្នក មិន សក្តិសម ឬ ?
ពួកគេ ចូលចិត្ត និយាយ អំពី វា ។
១ - តក្កវិជ្ជាត្រូវបានប្រើដើម្បីឈានដល់ការសន្និដ្ឋាន ។
វិចារណក ថា ជា កម្មសិទ្ធិ របស់ ព្រះ ជា របស់ ព្រះគ្រីស្ទ ។
អ្វីដែលធ្វើឱ្យអ្នកគិតថាខ្ញុំមិនចូលទៅហើយឱ្យលុយគេ។
គ្មានអ្នក ណាស្លាប់នៅថ្ងៃ បន្ទាប់ ឬថ្ងៃក្រោយឡើយ ។
យើងដាក់ សញ្ញារាប់ពាន់ » ។
ស្រឡាញ់ ពួកគេ ដោយ មិន គិត ពី ជំនឿ ។
ភាព ប្រៃនៃបឹងបានកើនឡើងពី៥...
យើង មិន មាន អ្នក សម្របសម្រួល យុទ្ធនាការ ទេ យើង កំពុង ធ្វើ អ្វី ៗ គ្រប់ យ៉ាង ដោយ ខ្លួន ឯង ។
នេះជាសេចក្ដី ស្លាប់ទីពីរ គឺបឹងភ្លើង ; ហើយបើរកមិនឃើញឈ្មោះអ្នក ណាសរសេរក្នុងសៀវភៅជីវិតទេ នោះគេត្រូវបោះទៅក្នុងបឹងភ្លើង » ។
គាត់បាននិយាយថា៖ « វាជារាត្រីដ៏ អស្ចារ្យ ហើយមានអ្នកចូលរួមយ៉ាងខ្លាំង ។
ហើយ ខ្ញុំ បាន ឃើញ ទេវតា ទាំង ប្រាំពីរ ដែល ឈរ នៅ ចំពោះ ព្រះ។ ហើយ ពួកគេ បាន ទទួល ត្រែ ប្រាំពីរ ។
ឈរ នៅ ចំពោះ ព្រះអម្ចាស់ នៃ ផែនដី ទាំងមូល ។
“ នាងថា … នាងថាយើងជាមិត្តនឹងគ្នា ម្តង ។
35 វាត្រូវបានបង្ហាញដល់អ្នក ដើម្បីឲ្យអ្នកបានដឹងថាព្រះ យេហូវ៉ាជាព្រះ ហើយគ្មានអ្នក ណានៅក្រៅពីទ្រង់ឡើយ ។
“ កូនប្រុស របស់ ខ្ញុំ កើត ជំងឺ ផ្តាសាយ ។
« ហើយខ្ញុំបានឮសំឡេងពីលើមេឃនិយាយថា៖ « ចូរសរសេរនេះថា មាន ពរហើយមនុស្សស្លាប់ដែលស្លាប់ក្នុងព្រះ អម្ចាស់ពីពេលនេះទៅ » « ព្រះវិញ្ញាណមាន បន្ទូលថា « មាន ពរហើយ ដើម្បីឲ្យពួកគេបានសម្រាកពីការនឿយ ហត់របស់ខ្លួន ត្បិតអំពើដែលគេធ្វើតាមគេ !
និង ឧបករណ៍ ដែល បាន រកឃើញ នៅ ទីនោះ ។
១៥ ម្យ៉ាងទៀត ខ្ញុំនឹងប្រុងប្រយ័ត្នដោយឃើញថា ក្រោយពីខ្ញុំសោយទិវង្គតទៅ អ្នកនឹងត្រូវបានរំឭកអំពីរឿងទាំងនេះជានិច្ច ។
និយាយបែបនេះ ប៉ុន្តែវាជាការ ពិត ។
បន្ទាប់ពី នោះ អ្នក អាច មក រក នាង ហើយ ក្លាយជា ប្តី របស់ នាង ហើយ នាង នឹង ក្លាយជា ប្រពន្ធ របស់ អ្នក ។
នៅ សេវាកម្ម របស់ អ្នក លោកស្រី !
មនុស្សមួយហ្វូងយ៉ាងច្រើនបានដើរតាមទ្រង់ ដោយព្រោះពួកគេបានសង្កេតមើលទី សម្គាល់អព្ភូតហេតុដែលទ្រង់បានធ្វើលើអ្នកជំងឺ ។
ហើយគាត់បានបន្តជំរុញគាត់ដូច្នេះគាត់បានយកវា។
ការផ្លាស់ប្តូរ ទាក់ទង នឹង " អ្វី ដែល បុរស ចង់បាន "
ប្រទេស ស៊ីរី ត្រូវបាន ចាត់ទុក ថា ជា ប្រទេស គ្រោះថ្នាក់ បំផុត ទី ពីរ ។
15ដ្បិតអ្នកទាំងនេះមិនស្រវឹងដូចអ្នក ស្មានទេ ព្រោះម៉ោងប្រាំបួនព្រឹកប៉ុណ្ណោះ ។
ហើយយកព័ត៌មាននោះត្រឡប់ទៅរដ្ឋរបស់ពួកគេវិញ ដើម្បីពួកគេអាចធ្វើបានដូចគ្នា ។
គឺដូចម្តាយរបស់នាងមែនទេ ?
ពួកគេមិនយក ចិត្តទុកដាក់ចំពោះព្រះពិតតែមួយ និងរបៀបនៃជីវិតរបស់ទ្រង់ ។
កន្លែងដែលគ្រូវិន័យ និងពួកព្រឹទ្ធាចារ្យបានមកជុំគ្នា ។
នេះជាការ ប្រកាសរបស់ព្រះជាអម្ចាស់ ។
ខ្ញុំប្រាប់អ្នក រាល់គ្នាជាប្រាកដថា ប្រសិនបើអ្នក រាល់គ្នាមិនបានបរិភោគសាច់កូនមនុស្ស និងពិសាឈាមរបស់ព្រះអង្គទេ នោះអ្នកគ្មានជីវិតឡើយ » ។
ចំណាយ ពេល ជាមួយ មនុស្ស ដែល ពោរពេញ ដោយ ជំនឿ នោះ វា នឹង ពង្រឹង ជំនឿ របស់ អ្នក ផ្ទាល់ ។
ព្យាយាម ជៀសវាង ពួកគេ ហើយ នៅ ឱ្យ ឆ្ងាយ ពី អ្នកយាម ។
យក ចិត្តទុកដាក់ចំពោះអ្វីដែលត្រូវធ្វើសម្រាប់អ្នក » ។
ប្រព័ន្ធ ភាពស៊ាំ របស់ អ្នក កាត់បន្ថយ ការឆ្លង មេរោគ HPV ភាគ ច្រើន ជាញឹកញាប់ ក្នុង រយៈពេល ពីរ ឆ្នាំ ។
ហើយគេមិនបានស្តាប់តាមច្បាប់របស់ទ្រង់ទេ ។
ឈ្មោះ របស់ អ្នក គឺ នៅក្នុង សៀវភៅ
« ទុកឲ្យអ្នក បម្រើរបស់អ្នក សុំម៉ាកដែលគេបម្រើខ្ញុំ ។
លោកបានបន្តថា៖ « ប្តីរបស់អ្នកបានបែរខ្នងដោយចេតនា ។
ប្រសិនបើគាត់មិនបានកាត់ស្បែកទេ គាត់នឹងបំពានលើសេចក្ដី សញ្ញាជាមួយនឹងព្រះ។
ឥឡូវនេះ ក្បាល ខ្ញុំ ធំ ហើយ ។
នៅពេលដែលខ្ញុំបានធ្វើការ ផ្លាស់ ប្តូ រ ទីបី ខ្ញុំបានដឹងថាខ្ញុំត្រូវការ ទីបួន » ។
គ្រួសារ របស់ ខ្ញុំ បាន សុខសប្បាយ ។
ខ្ញុំសុំប្រាប់អ្នក រាល់គ្នាតាមការ ពិតថា អ្នក ណាដែលមិនទទួលរាជាណាចក្ររបស់ព្រះ ដូចជាក្មេងតូច អ្នក នោះនឹងមិនចូលទៅក្នុងនគរនោះឡើយ » ។
ប្រយ័ត្ន គ្រប់ បញ្ហា ។
" អ្នក រាល់គ្នាដែលជាកម្មសិទ្ធិរបស់ mo
ថែរក្សា ប្រាក់ បញ្ញើ ល្អ ដែល ត្រូវបាន ប្រគល់ ឱ្យ អ្នក - ការពារ វា ដោយ ជំនួយ ពី ព្រះវិញ្ញាណ បរិសុទ្ធ ដែល គង់ នៅក្នុង យើង ។
មាន ការធានា បន្ថែម ។
ត្រូវដូចជាថ្ងៃស្អែករបស់គាត់ ;
អ្នកបង្កើតសន្តិភាពមានសុភមង្គលហើយ ដ្បិតគេនឹងត្រូវដាក់ឈ្មោះថាជាកូនរបស់ព្រះ។
ប៉ុន្តែគាត់មិនមានការ និយាយក្នុងការរត់ហ្វូងនោះទេ ។
គេនឹងមិនដឹងពីមូលហេតុនៃភ្លើងទេ រហូតដល់វា រលត់ទាំងស្រុង ។
ពិតប្រាកដ ណាស់ ភាព ងងឹត បាន ធ្លាក់ មក លើ ផែនដី ទាំងមូល ។
ដូច្នេះ សាលក្រម៖ មែន ហើយ ខ្ញុំ នៅតែ មិន អាច អាន ភាសា ជប៉ុន បាន ។
( អាន៖ ស្បែកកូននឹងស្អាតហើយមិន រ មាស់ បើដូចនេះ !
បន្ទាប់មក លោកសួរពួកគេ ថា៖ « ក្នុងចំណោមអ្នក រាល់គ្នា តើអ្នក ណានឹងជួសជុលដល់ ទីលានរបស់ផារ៉ោន ជាម្ចាស់ក្រុង មីរ៉ា អ៊ីម ហើយឆ្លើយ តបនឹងការ សួរ ចម្លើយរបស់គាត់ ? ...
ទ្រង់ជាសិរីល្អនៃពួកបរិសុទ្ធរបស់ទ្រង់ ។
ប៉ុន្តែ ដោយ ធ្វើ តាម ការសន្យា របស់ ទ្រង់ យើង កំពុង ទន្ទឹងរង់ចាំ ស្ថាន សួគ៌ ថ្មី និង ផែនដី ថ្មី ដែល ជា ផ្ទះ នៃ សេចក្ដីសុចរិត ។
១៤ ហើយកំពែងក្រុងមាន គ្រឹះដប់ ពីរ ហើយ នៅលើ ពួកគេ ទាំង ដប់ ពីរ ឈ្មោះ នៃ សាវ័ក ទាំង ដប់ ពីរ របស់ កូន ចៀម ។
ហើយអ្នក រាល់គ្នាមិនបានជឿគាត់ ហើយក៏មិនបានស្តាប់តាមសំឡេងគាត់ដែរ ។
ដូច អ្នក ភាគ ច្រើន ដែរ យើង មិន សប្បាយ ចិត្ត នឹង អ្វី ដែល បាន កើតឡើង នៅក្នុង ត្រីមាស ទី បួន ។
ជនខិល ខូច និងអ្នកការពារពួកគេគួរតែទទួលខុសត្រូវ » ។
ពេលគាត់បង្ហាញកន្លែងឲ្យគាត់ធ្វើការ សម្រេច ចិត្ត ។
រសជាតិ ជូរ ចត់ ប៉ុន្តែ មិន មែន ជា កម្មសិទ្ធិ របស់ នរណា ម្នាក់ ឡើយ ។
ពីរ បី ថ្ងៃ បន្ទាប់ពី ការស្លាប់ របស់ គាត់ ម្តាយ របស់ គាត់ ។
ខ្ញុំ ជឿ ថា ព្រះយេស៊ូវ បាន ប្រាប់ យើង ។
ថ្ងៃ នេះ ខ្ញុំ បាន ធ្វើ ដូចគ្នា ។
« ចំរូតមានច្រើនណាស់ ប៉ុន្តែអ្នកធ្វើការ មានតិច ដូច្នេះសូមលោកម្ចាស់នៃការ ច្រូតកាត់ចាត់កម្មករចេញ » ។
៣១ ពេលគាត់ បានចេញទៅហើយ នោះលោកយេស៊ូមាន ប្រសាសន៍ ថា៖ « ឥឡូវនេះ កូនមនុស្សបាន ត ម្កើងឡើង ហើយព្រះជាម្ចាស់ក៏លើក ត ម្កើងគាត់ ។
