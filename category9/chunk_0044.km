ទ្រង់នឹងគង់នៅ ជាមួយនឹងគេ ហើយពួកគេនឹងក្លាយជា រាស្ដ្ររបស់ទ្រង់ ហើយទ្រង់នឹងជាព្រះ របស់ពួកគេ ដែលនៅ ជាមួយនឹងពួកគេជានិច្ច ។
ប្រសិនបើយ៉ាកុបយកប្រពន្ធពីក្នុងចំណោមស្ត្រីក្នុងស្រុកនេះ ជីវិតខ្ញុំនឹងមិនសមនឹង រស់នៅឡើយ » ។
អាកប្បកិរិយា របស់ កូន អ្នក នឹង ផ្តល់ សញ្ញា ព្រមាន ដល់ អ្នក ។
សូមមាន ពរហើយអ្នក ណាដែល មកក្នុងព្រះនាមនៃព្រះ អម្ចាស់ » ។
លោកថាចំនួននេះអាចកើនឡើង ។
វា អាច ត្រូវបាន ទម្លាក់ មក លើ ខ្ញុំ ។
ចូរអធិស្ឋានពេញមួយថ្ងៃដោយការ សរសើរ ហើយអធិស្ឋានសម្រាប់យប់ខាង មុខ ។
បន្ទាប់មកសេះបាននាំយកពួកគេចេញ » ។
បងប្អូន ជា ទីស្រឡាញ់ អើយ សូម ស្ដាប់៖ តើ ព្រះជាម្ចាស់ បាន ជ្រើសរើស អស់ អ្នក ដែល ក្រក្នុង ក្រសែភ្នែក លោកីយ៍ អោយ ក្លាយជា អ្នក មាន ដោយ ជំនឿ និង ដើម្បី គ្រងរាជ្យ ដែល ទ្រង់ បាន សន្យា នឹង អស់ អ្នក ដែល ស្រឡាញ់ ទ្រង់ ជា មរតក ទេ ឬ ?
10 រឿងនេះបានកើតឡើងបីដង ហើយបន្ទាប់មកវាត្រូវបានទាញឡើងទៅស្ថាន សួគ៌ម្ដងទៀត ។
ខ្ញុំ ដឹង ថា ជាមួយនឹង ព្រឹត្តិការណ៍ ល្អ ពួកគេ នឹង ធ្វើ ដូច្នេះ អ្នក នឹង ត្រូវ សួរ ។
ព្រះ‌ អម្ចាស់មិនឆ្លើយ តបនឹងអ្នកនៅថ្ងៃនោះទេ ។
បន្ទាប់ពី អ្នក ទាំងអស់ គ្នា គេង ហើយ ?
« ត្រូវចងចាំអ្នកដែលជាប់គុកឲ្យដូចជាអ្នក ជាអ្នក ទោសរួមគ្នា ហើយអ្នកដែលត្រូវគេធ្វើ បាបហាក់ដូចជាអ្នក រាល់គ្នារងទុក្ខ » ។
កម្មវិធី នេះ នឹង វាស់វែង ពេលវេលា សម្រាប់ អ្នក ។
4 សូមរំដោះទូលបង្គំឲ្យរួចផុតពីអន្ទាក់ដែលគេដាក់ឲ្យទូលបង្គំ ព្រោះព្រះអង្គជាអ្នកការពារទូលបង្គំ ។
អ្នក នោះស្លៀកសម្លៀក បំពាក់នៃការ ពិត ប៉ុន្តែការ ពិតគឺស្ថិតនៅលើករណីរបស់ខ្លួននៅថ្ងៃនេះ ដូច្នេះអ្នកបោក ប្រាស់ខ្លាចការ បោក ប្រាស់របស់ខ្លួនត្រូវលាត ត្រដាង » ។
អាច មកពី ហេតុផល ទាំងនេះ !
គាត់ចូលទៅក្នុងដំណាក់របស់ព្រះជាម្ចាស់ យកនំបុ័ងដែលថ្វាយដល់ព្រះជាម្ចាស់បរិភោគ ហើយប្រគល់អោយមនុស្សរបស់ព្រះអង្គដែរ ។
លុះព្រឹកឡើង ពេលទ្រង់កំពុងធ្វើដំណើរត្រឡប់ទៅក្រុង ទ្រង់ឃ្លាន ។
36 ពេលគាត់ឮហ្វូងមនុស្សដើរកាត់ គាត់សួរថាមានអ្វីកើតឡើង ។
ទោះជា យ៉ាងណា ក៏ដោយ ផ្ទុយទៅវិញ សកម្មភាព សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម មាន កម្រិត ។
ហើយគេទៅភូមិផ្សេង ។
គាត់ ចង់ឱ្យ បល្ល័ង្ក របស់ គាត់ ខ្ពស់ ជាង របស់ ព្រះ។
ប្រាប់ រឿងរ៉ាវ អំពី របៀប ដែល អ្នក មក តាម ព្រះយេស៊ូវ ?
កាលគេតាម ដានព្រះអង្គនៅត្រើយម្ខាងនៃបឹង ក៏សួរព្រះអង្គ ថា៖ « ព្រះគ្រូ តើលោកមកដល់ពេលណា ? » ។
ដែល ស្មើនឹង ទម្ងន់ មួយ តោន នៃ ភាពខុសគ្នា នីមួយ ៗ
38 ប៉ុន្តែប្រសិនបើខ្ញុំធ្វើការ ទាំងនោះ ទោះជាអ្នក រាល់គ្នាមិនជឿខ្ញុំក៏ដោយ ចូរជឿកិច្ចការទាំងនោះ ដើម្បីឲ្យអ្នក រាល់គ្នាបានដឹង ហើយយល់ថា ព្រះ‌បិតាគង់នៅក្នុងខ្ញុំ ហើយខ្ញុំនៅក្នុងព្រះ‌បិតា » ។
មិន ត្រឹមតែ ថ្ងៃ ឈប់សម្រាក របស់ ព្រះត្រូវបាន ជំនួស ដោយ អ្នក មិន ជឿ ប៉ុណ្ណោះ ទេ ថែមទាំង មាន អំណរ ជាច្រើន នៃ ការថ្វាយបង្គំ និង ការសរសើរ ផងដែរ ។
ខ្ញុំបានទំលាក់ច្រើនពីនាង ។
នាងមិនអាច ទ្រាំនឹងគំនិតចង់ត្រឡប់ទៅផ្ទះល្វែងវិញទេ ។
ហើយ ថា អ្នក នឹង អាច ជាសះស្បើយ ។
រ៉ូម ជា កម្មសិទ្ធិ របស់ សេចក្តីសុចរិត នៃ សេចក្តីជំនឿ ។
« យើងឃើញកន្លង មករដ្ឋាភិបាលកម្ពុជាបានអនុញ្ញាតឲ្យជនជាតិវៀតណាមចូល មកវិញដោយគ្រាន់ តែអនុវត្តតាមគោលការណ៍របស់ក្រសួងសុខាភិបាល ។
ប្រព័ន្ធ , ប្រព័ន្ធ សរីរាង្គ មួយ ក្នុង ចំណោម ប្រព័ន្ធ 11 នៅក្នុង រាងកាយ ។
« គឺព្រោះវាបំផ្លាញកេរ្តិ៍ឈ្មោះរបស់មនុស្សល្អ ដោយធ្វើឲ្យមនុស្សទាំងអស់មានលក្ខណៈដូចគ្នា ។
មិន មាន អ្វី សំខាន់ ជាង ការដឹង ថា ព្រះយេស៊ូវ គ្រីស្ទ ជា នរណា និង អ្វី ដែល ទ្រង់ បាន ធ្វើ សម្រាប់ យើង នោះ ទេ ។
តើអ្នកនឹង ពន្យារពេលនិង បញ្ចប់ដោយមានអារម្មណ៍ថាមានកំហុស ( ដោយភ្នែកក្រហម ) ?
មិនមានការ លើកឡើងពីគាត់ឱ្យផ្លែល្វាមួយអំពីវាបន្ទាប់ពីចាប់ផ្ទះ បននោះទេ ។
ខ្ញុំអាចឮតែពាក្យរបស់ពួកគេ ។
វា ពិតជា ល្អ ណាស់ ដែល ធ្វើអោយ មនុស្ស ភ្ញាក់ផ្អើល បែប នេះ ។
ខ្ញុំនឹងមិននិយាយជាមួយអ្នកយូរទៀតទេ ដ្បិតព្រះអង្គម្ចាស់នៃពិភពលោកនេះនឹង មកដល់ ហើយព្រះអង្គមិនបានចាប់ខ្ញុំឡើយ ។
អ្នកដែលបង្ហាញ ចិត្តសប្បុរសចំពោះ ជនក្រីក្រនឹងទទួលបាន ពរ ។
ពួកគេគិតថាគេនឹងត្រូវគេចាប់យកប្រសិនបើមិនលាក់ខ្លួន ។
ដូច្នេះដោយគ្មានការ ភ្ញាក់ផ្អើលបន្ថែមទៀតសូមចូលទៅក្នុង បញ្ជីរបស់យើង។
ទំនង តិច បំផុត នឹង ទទួលបាន បន្ទាប់ពី ពាក្យបញ្ជា បន្ទាប់មក មិន អាច បំភ្លេច បាន
អ្នកអាចបង្ហាញអាហារដល់គាត់ជាមុនសិន ដូច្នេះអ្នកត្រូវយក ចិត្តទុកដាក់ ។
អ្វីដែលជា បន្ទាប់គឺជាក់ ស្តែ ងមែនទេ ?
ក្មេងស្រី ចាប់ផ្តើម និយាយ ។
៥ អ្នក ទាំងនោះចេញទៅរង់ចាំយើងនៅក្រុង ត្រូអាស ។
« គ្មាននរណាបានឡើងទៅស្ថាន សួគ៌ឡើយ គឺមាន តែព្រះអង្គដែលបានយាងចុះពីស្ថាន សួគ៌មក គឺជាបុត្រមនុស្ស ( ព្រះអម្ចាស់យេស៊ូវគ្រីស្ទ )» ។
" អ្នក ប្រាជ្ញនិយាយព្រោះមានអ្វីត្រូវនិយាយ ល្ងង់ព្រោះត្រូវនិយាយអ្វីមួយ "
បើ មិន ទាន់ រៀបការ កុំ រក ប្រពន្ធ ។
តើមានអ្វីដែលព្រះ បានប្រទាន មកអ្នក ប៉ុន្តែអ្នកបានធ្វេសប្រហែសក្នុងការ យកវាឬ ?
អ្នកអាច រកអ្វីដែលអ្នកចង់បាន ដោយមិនចាំបាច់ក្រោកពីគេងពីផ្ទះផ្ទាល់ខ្លួនឡើយ ។
ខ្សែ អក្សរ ដែល កំណត់ ហាង ដែល ដើម្បី បង្កើត ស្លាក ។
« ត្រូវ ប្រឹងប្រែងឲ្យអស់ ពីសមត្ថភាពដើម្បីចូលតាមទ្វារ ចង្អៀត ។
ដូចមានចែងទុកមកថា៖ «តែមនុស្សសុចរិតនឹង រស់ដោយសេចក្ដី ជំនឿ ។
ខ្ញុំ បាន ប្រាប់ អ្នក ថា ខ្ញុំ គិត អំពី រឿង នេះ ច្រើន ។
ពួកគេមិនដែលមានបំណងចូលរួមនៅស៊ីរីទេ ។
ខ្ញុំគិតថាអ័ ប្រាហាំបាននិយាយថា ' គេមានម៉ូសេ និងហោរា ' ដោយ សារពួកគេដឹងការ សរសេររបស់ម៉ូសេ និងពួកហោរា ។
ពេលខ្លះខ្ញុំថែមទាំងពាក់ វាដោយខ្លួនឯងក៏ល្អដែរ ។
ពួកគេទាំងអស់កំពុងអង្គុយដើម្បីធ្វើឱ្យប្រាកដ ថាពួកគេមិនបញ្ចេញពីទំនាញផែនដី ។
ការភ័យខ្លាច នៃ ការបរាជ័យ អាច ត្រូវបាន ផ្សារភ្ជាប់ ទៅនឹង មូលហេតុ ជាច្រើន ។
រក កន្លែង អង្គុយ
ចំនួនកងកម្លាំងអាមេរិកមានចំនួនតិចជាងឆ្នាំ មុន ។
វិធីដើម្បីទាក់ទងនឹងព្រះ ហើយភ្ជាប់ជាមួយទ្រង់ ។
១១ ដូច្នេះ ប៉ូលបានស្នាក់នៅមួយឆ្នាំកន្លះ ហើយបង្រៀនពួកគេអំពីព្រះបន្ទូលនៃព្រះ។
ទ្រង់នឹង សង្គ្រោះគេឲ្យរួចពីការ បំផ្លិចបំផ្លាញនៃការ ដែលផ្ទុយនឹងទ្រង់ ។
នៅ ពេល ដែល ព្រះវិញ្ញាណ សណ្ឋិត លើ ពួកគេ ពួកគេ បាន ទាយ ។
១៧ មានសំឡេងមួយ មកពីលើមេឃ ថា៖ នេះជាបុត្រដ៏ ជាទី ស្រឡាញ់របស់យើង ។
វិវរណៈ 16:11 ហើយពួកគេបានប្រមាថព្រះ នៃស្ថាន សួគ៌ដោយព្រោះ តែទុក្ខ វេទនា និងដោយ សារ តែការ ឈឺចាប់ ហើយពួកគេមិនបាន ប្រែ ចិត្តពីការ ប្រព្រឹត្តរបស់ខ្លួនឡើយ ។
ក្នុង អំឡុង ពេល ប្រាំមួយ ម៉ោង បន្ទាប់ សេចក្តីមេត្តា ករុណា មិន ត្រូវបាន បង្ហាញ ទេ ។
ខ្ញុំ នៅតែ ស្ទាក់ស្ទើរ បង ស្រី របស់ ខ្ញុំ បាន ជួយ ខ្ញុំ ។
ដើម្បី លាក់បាំង ស្នាម ប្រេះ ។
ខ ៤៨ កាលមនុស្សទាំងអស់ដែលបានប្រមូលផ្ដុំគ្នាធ្វើជាសាក្សីឃើញហេតុ ការណ៍កើតឡើង ពួកគេវាយដើមទ្រូង ហើយដើរចេញទៅ ។
អ្នកណា ជឿ លើ ខ្ញុំ ; ស្មានថាគាត់ស្លាប់ តែគាត់នឹងមានជីវិត ហើយអ្នក ណាដែលរស់ ហើយជឿលើខ្ញុំនឹងមិនស្លាប់ឡើយ » ។
« យើងត្រូវ តែសុំទោសក្នុងនាមអ្នក រាល់គ្នាចំពោះអ្នកជំងឺ និងពលរដ្ឋ ។
ពួកគេ មិន ចូលចិត្ត អ្វី ដែល ខ្ញុំ បង្កើត នោះ ទេ ។
« ខ្ញុំនឹងមិនចូលទៅក្នុងព្រះវិហារទេ ។
' មនុស្ស ត្រូវ ស្លាប់ ហើយ នឹង ស្លាប់ ដែល មិន ត្រូវតែ ស្លាប់ ។
ទទួលស្គាល់ថាមិនអីទេ ?
ព្រះ មិនបានទុកឲ្យយើងវង្វេងដោយគ្មានគោល ដៅនោះទេ ។
ពួកអ្នកដើរតាមបានប្រកែកគ្នាក្នុងចំណោមពួកគេថាតើពួកគេមួយ ណាធំជាងគេ ។
ឈ្លាសវៃ និង ពោរពេញ ដោយ ការគិត ទុក ជាមុន ។
នៃចៅក្រមដើម្បីស្តាប់មេធាវីការពារក្តីរបស់គាត់ដោយ ភាពព្រងើយ កន្តើយ » ។
24 ម៉ោង មិន គ្រប់គ្រាន់ សម្រាប់ អ្នកទេ ។
កន្លែង នៅក្នុង ទីក្រុង ដែល អ្នក អាច រីករាយ ជាមួយ ភេសជ្ជៈ ឬ អាហារ របស់ អ្នក ។
វាគឺ មកពីទីនេះដែលអ្វីគ្រប់យ៉ាងចាប់ ផ្តើ ម » ។
ត្រូវការ ការ សងប្រាក់វិញយ៉ាងឆាប់ រហ័ស ...
ហើយ តន្ត្រី គឺ ដូចគ្នា ។
ពេលនោះ អ្នកនឹងឃើញ ភាពខុសគ្នាម្ដងទៀតរវាងមនុស្សសុចរិត និងមនុស្សអាក្រក់ រវាងអ្នកដែលបម្រើព្រះ និងអ្នកដែលមិនធ្វើ » ( ម៉ាឡាគី 3:17-18 TLV) ។
លក់ ដោយ៖ ក្នុង ពន្លឺ ។
ដូច្នេះ តើការ ធ្វើជាអ្នក បម្រើព្រះ នៅកន្លែងដែលយើងរស់នៅ និងធ្វើការ មាន ន័យយ៉ាង ណា ?
នោះជាអំណោយទានដែលព្រះរាជាណាចក្រស្ថាន សួគ៌នៅជិតដៃ ។
ពេលនោះ គេនឹងដឹងថា យើងជាព្រះ‌ អម្ចាស់ ជាព្រះ របស់គេ » ។
ពេលនោះ គេនឹងដឹងថា យើងជាព្រះ‌ អម្ចាស់ ជាព្រះ របស់គេ » ។
លោកបាននិយាយថា៖ « មានការ រៀបចំជាច្រើនកំពុងត្រូវបានធ្វើ ហើយនឹងមានថ្ងៃមួយ » ។
តើអ្នកមានជំនឿ ណាមួយដែលគ្មានការសង្ស័យ ( មិនប្រកាន់សាសនា ) ?
« នៅកន្លែងនេះ តើខ្ញុំពិតជាបានឃើញអ្នកដែលឃើញខ្ញុំមែនឬ ? »
ខ្ញុំ សន្មត់ ថា អ្នក ជា អ្នក ប៉ូឡូញ ។
ស្ត្រីស្អាតធំ : នេះបើតាមខ្លួននាងផ្ទាល់។
ប្រញាប់ ឡើង ទិញ ទាំងអស់ គ្នា ណា ។
23 ចូរប្រាប់យើងពីអ្វីដែលនឹង មកដល់នៅពេលនេះ ដើម្បីឲ្យយើងបានដឹងថាអ្នក រាល់គ្នាជាព្រះ។ ចូរធ្វើល្អ ឬធ្វើអាក្រក់ ដើម្បីឲ្យយើងខ្លាច និង តក់ស្លុត ។
មនុស្ស ទាំងអស់ ដែល មិន ចូលរួម
ពួកសិស្សរបស់លោកក៏ទទួល យកពួកគេដូច្នេះដែរ ។
ខ្ញុំ បាន ក្រឡេក មើល ដំបូង របស់ នាង ។
នរណា ម្នាក់ នឹង ស្គាល់ ខ្ញុំ ។
ល្អ ចំពោះ ពួកគេ នឹង ក្លាយជា អ្វី ដែល អ្នក មើលឃើញ ថា ល្អ ហើយ អាក្រក់ ចំពោះ ពួកគេ នឹង ក្លាយជា អ្វី ដែល អ្នក មើលឃើញ ថា អាក្រក់ ។
ហើយ ខ្ញុំ ប្រាប់ ពួកគេ ថា អ្នក ជា មិត្ត របស់ ខ្ញុំ
ប៉ុន្តែប្រសិនបើអ្នកសរសេរពួកគេនឹង ពន្យារពេលកំណត់យ៉ាងប្រាកដ ។
អ្វី គ្រប់ យ៉ាង ត្រូវបាន ដុត បំផ្លាញ ។
ខណៈពេលដែលបានត្រេក អរនិងបានមើលទៅដោយដៃស្តាំរបស់
« តែអ្នក ណាដែលជ្រកកោននឹងខ្ញុំ អ្នក នោះនឹងបានទឹកដី ជា មរដក ហើយនឹងបានភ្នំបរិសុទ្ធរបស់យើងជាម្ចាស់ » ។ — អេសាយ ៥៧ : ១៣
ដូច្នេះ ចូរអធិស្ឋានដល់ព្រះ‌ អម្ចាស់នៃការ ច្រូតកាត់ ដើម្បីចាត់កម្មករឲ្យចូលច្រូតកាត់របស់ទ្រង់ » ។
ទ្រង់មិនបានបែងចែករវាងយើងនិងគេឡើយ ដ្បិតដោយ សារសេចក្ដី ជំនឿ ទ្រង់បាន ប ន្សុទ្ធ ចិត្តគេ ។
យើងបានមកជឿ ហើយដឹងថាទ្រង់ជាព្រះ ដ៏ វិសុទ្ធនៃព្រះ» ។
យើងខ្ញុំបានជឿ ហើយដឹងថាអ្នក ជាព្រះ ដ៏វិសុទ្ធរបស់ព្រះ» ។
ពួកគេ មាន អារម្មណ៍ ថា មាន ការរំជើបរំជួល នៅក្នុង ចិត្ត របស់ ពួកគេ ហើយ បាន ឃើញ ការបញ្ជាក់ បាន ធ្លាក់ ចូល ទៅក្នុង កន្លែង ។
បន្ទាប់មក លោកមាន ប្រសាសន៍ទៅគេ ថា៖ « អ្នក រាល់គ្នាមាន វិធីដ៏ល្អក្នុងការ បដិសេធព្រះបញ្ញត្តិរបស់ព្រះ ដើម្បីរក្សាប្រពៃណីរបស់អ្នក!» ។
ដូច្នេះ អ្នក អាច ស្ថិត ក្នុង ក្រុម ឈាម មួយ ក្នុង ចំណោម ក្រុម ឈាម ទាំង ប្រាំ បី៖
« ហើយបានការពារឡុតជាមនុស្សទៀង ត្រង់ ដែលមានទុក្ខយ៉ាងខ្លាំងដោយជីវិតមិនបរិសុទ្ធរបស់ពួកទុច្ចរិត » ។
ប្រសិនបើ អ្នក មិន មាន កូន ទេ អ្នក នឹង មិន មាន លក្ខណៈ គ្រប់គ្រាន់ ទេ ។
មាសរបស់យើងនៅទី នោះ » ។
បន្ទាប់មកគេសម្លាប់គាត់មួយ រយៈ ។
« ទុកវាចោលមួយឆ្នាំទៀត ខ្ញុំនឹងជីក ក កាយវា ហើយដាក់ជី » ។
ប៉ុន្តែនៅថ្ងៃនៃសេចក្តី វិនាស យើងត្រូវដោះស្រាយជាមួយអ្នកដែលមានទម្រង់នៃការ គោរពព្រះ ប៉ុន្តែបដិសេធអំណាចរបស់វា ។
លុះ ដល់ថ្ងៃបុណ្យទី៥០ ពួកគេនៅកន្លែង តែមួយ ។
នេះ ជាព្រំដែនកូនស្រីរបស់ ខ្ញុំ៖
« អ្នកនឹងផឹកពែងដែលខ្ញុំផឹក ហើយអ្នកនឹងទទួលបុណ្យជ្រមុជដោយបុណ្យជ្រមុជទឹកដែលខ្ញុំទទួលបុណ្យជ្រមុជទឹក ។
១១ សាក្សីទុច្ចរិតក្រោកឡើងសួរពីរឿងដែលខ្ញុំមិនដឹង ។
ទោះជា ឥឡូវនេះ ខ្ញុំដឹងថាអ្វីដែលអ្នក សុំពីព្រះ នោះព្រះ នឹងប្រទានឲ្យអ្នក » ។
ទន្ទឹងរង់ចាំ បង ធំ ១៧.
ទេ នេះ ជាបញ្ជា ដ៏ ទេវភាព ដែល ត្រូវបាន ផ្តល់ឱ្យ យើង ។ បុរសដែលស្រឡាញ់ព្រះ ក៏ត្រូវជាអ្នកដែលស្រឡាញ់បងប្អូនរបស់ខ្លួនដែរ » ។
ទាំងអស់ នឹង ស្ថិត នៅក្នុង ករណី បង្ហាញ ។
វា នឹង ជួយ សន្សំ សំចៃ ពេលវេលា សម្រាប់ អ្នក ក្នុង ការដំឡើង វា រៀងរាល់ ពេល ។
« ដូច្នេះ គេក៏ទៅធ្វើផ្នូរឲ្យប្រាកដ ដោយបិទថ្ម ហើយដាក់នាឡិកា ។
ហើយ ប្រសិនបើ ខ្ញុំ មិន រៀបការ ?
អ្នកមិនត្រូវធ្វើឲ្យស្រុកដែលព្រះ‌ អម្ចាស់ ជាព្រះ របស់អ្នកប្រគល់ឲ្យអ្នក ទុកជា មរតកឡើយ » ។
« បន្ទាប់មក ពេត្រុស និងសាវ័ក ឯទៀតបានឆ្លើយថា យើងគួរតែស្តាប់បង្គាប់ព្រះ ជាជាងមនុស្ស » ។
7 អ្នក ដឹងថាខ្ញុំមិនមែនជាមនុស្សអាក្រក់ ; គ្មាន នរណា អាច រំដោះ ចេញ ពី ដៃ អ្នក បាន ទេ ។
ចូរទៅខ្មាសខ្លួនឯង ហើយចំណាយពេលពីរថ្ងៃចុងក្រោយនេះ ប្រែចិត្តចំពោះព្រះ» ។
ដោយសារតែ ពួកគេ ជា ផ្នែក មួយ នៃ មួក ។
ខ្ញុំ ប្រាប់ អ្នក តាម ការពិត ថា៖ ព្រះបិតា នឹង ប្រទាន អោយ អ្នក នូវ អ្វី ដែល អ្នកសុំ ពី គាត់ ក្នុង នាម ខ្ញុំ ។ សុំ នោះអ្នកនឹងទទួលបាន ដើម្បីឲ្យសុភមង្គលរបស់អ្នកបានពេញលេញ ។
ក្រុមហ៊ុន នេះ បាន ប្តូរ ឈ្មោះ ជាច្រើន ដង ។
យើងបានទុក ចិត្ត ហើយបានដឹងថាទ្រង់ជាព្រះ ដ៏បរិសុទ្ធនៃព្រះ» ។
៧៖ ឥឡូវនេះ អ្នកមិនមែនជាខ្ញុំបម្រើទៀតទេ គឺជាកូនរបស់ព្រះ។
បើសិនជាដីមិនអាចប្រើបានមួយ រយៈ តើគេទៅណា ?
ខ្ញុំបានដឹងថាខ្ញុំមិនបានមើលស្ត្រីស្និទ្ធស្នាលម្នាក់នេះដោយប្រយ័ត្ន ប្រយែងអស់មួយ រយៈ មកហើយ ។
អរគុណ ចំពោះ ការអត់ឱន ចំពោះ អាកប្បកិរិយា របស់ ខ្ញុំ ខ្ញុំ ពិតជា ពិបាកចិត្ត ណាស់ បន្ទាប់ពី រញ៉េរញ៉ៃ ជាមួយ វា 2 ថ្ងៃ ។
ហើយបានគាស់ពួកគេនៅក្នុងផ្ទះ ។
ខ្ញុំបានធ្វើគ្រប់យ៉ាងហើយខ្ញុំនៅ តែមិនអាចទទួលបានល្បឿន 3g ។
បារ៉ាក់ អូបាម៉ា ជា នរណា ?
ហើយ ការ ល្អ ជាច្រើន ដែល ពួកគេ បាន ធ្វើ ខ្ញុំ ។
ហេតុ អ្វី បានជា គាត់ មិន ជួយសង្គ្រោះ យើង ?
រក្សា កូន របស់ អ្នក ឱ្យ សកម្ម នៅ ពេល ថ្ងៃ ប៉ុន្តែ ជៀសវាង ការធ្វើ លំហាត់ប្រាណ ខ្លាំង មុនពេល ចូល គេង ។
‹ គ្មានអ្នក ណាបានឡើងទៅស្ថាន សួគ៌ឡើយ ក្រៅពីទ្រង់ដែលបានយាងចុះពីស្ថាន សួគ៌ នោះគឺជាបុត្រមនុស្សដែលគង់នៅស្ថាន សួគ៌ › ។
16 គេបានបញ្ចុះ សពគាត់នៅក្រុង ដាវីឌ ក្នុងចំណោមស្តេច ពីព្រោះគាត់បានប្រព្រឹត្តអំពើល្អនៅស្រុកអ៊ីស្រា ‌ អែល ថ្វាយព្រះ និងដល់ដំណាក់របស់ព្រះ។
ទោះជា យ៉ាងណា ក៏ដោយ សហរដ្ឋ អាមេរិក ស្ថិត ក្នុង ស្ថានភាព លំបាក មួយ នៅពេល និយាយ អំពី ប្រទេស ឥណ្ឌា ។
លោកបានផ្តាំផ្ញើថានឹងត្រូវធានាថាមិនមានគ្រោះថ្នាក់ដល់វិហារឥស្លាមនោះទេ។
រក្សា តុល្យភាព និង ស្តាប់ រាងកាយ របស់ អ្នក ខណៈពេល ដែល ឱប ក្រសោប ជីវិត ឱ្យ ពេញលេញ បំផុត ។
បទនេះសមនឹងសំឡេងនាងជាង ។
ពេលនោះ ពេត្រុសបានពេញដោយព្រះវិញ្ញាណបរិសុទ្ធ ហើយមាន ប្រសាសន៍ទៅគេ ថា៖ « ពួកអ្នកគ្រប់គ្រង និងពួកព្រឹទ្ធាចារ្យរបស់ប្រជាជន !
ខ្ញុំ បាន ត្រឡប់ មកវិញ មុន ពេល ដែល ខ្ញុំ មក ទីនេះ ។
5 ប៉ុន្តែ គាត់នឹងនិយាយថា ខ្ញុំមិនមែនជាព្យាការីទេ គឺ ជាអ្នកធ្វើការ នៅលើដីវិញ ។ ព្រោះ ខ្ញុំ ជា ម្ចាស់ ដី តាំងពី ខ្ញុំ នៅ ក្មេង ។
គ្រោះថ្នាក់ អាច កើតឡើង គ្រប់ ពេលវេលា ប្រសិនបើ អ្នក មិន ប្រុងប្រយ័ត្ន ។
ខ្ញុំ បាន ប្រែក្លាយ ពី ព្រះដោយសារតែ ភាពអសកម្ម របស់ គាត់ ដោយសារតែ ការ មិន មាន ។
ខ្ញុំមិនចង់ទុកវាចោលនៅកន្លែងបែបនេះទេ ប៉ុន្តែវាជាពេលវេលារបស់ខ្ញុំសម្រាប់ព្រះអម្ចាស់ អរគុណសម្រាប់ការ យល់ដឹង » ។
កូនតូច ៗ កុំឲ្យអ្នក ណាបោកបញ្ឆោតអ្នកឡើយ ។
កូនតូច ៗអើយ កុំឲ្យអ្នក ណាបោកបញ្ឆោតអ្នកឡើយ ។
៣៧ ពេលនោះ ប្រជាជនទាំងអស់នៅតំបន់កេរ៉ា សេនបានសុំព្រះ យេស៊ូឲ្យចាកចេញពីពួកគេ ព្រោះពួកគេ ភ័យខ្លាច ។
១២ ព្រះយេស៊ូមានព្រះបន្ទូលទៅគេ ថា៖ « មកបរិភោគអាហារពេលព្រឹក » ។ គ្មានសិស្ស ណាម្នាក់ហ៊ានសួរព្រះអង្គ ថា៖ « អ្នក ជានរណា ? » ។ ដោយ ដឹង ថា វា គឺជា ព្រះអម្ចាស់ ។
ដ្បិតយើងមិនបានពង្រីកខ្លួនយើងលើស លប់ ដូចជាយើងមិនបានទៅដល់អ្នក រាល់គ្នាទេ ព្រោះយើងបានមក រកអ្នកដោយដំណឹងល្អនៃព្រះ គ្រីស្ទ ។
« តើអ្នក ណាអាចសម្អាតរបស់មិនស្អាតបាន ? » ។
បន្ទាប់មក គាត់នឹងសួរថា « តើអំណាចទាំងអស់ជារបស់អ្នក ណាក្នុងថ្ងៃនេះ ?
នេះជាពាក្យនៃសេចក្ដី ជំនឿដែលយើងផ្សាយ ។
នេះ ប្រហែលជា វិធី ដ៏ ល្អ មួយ ដើម្បី ដឹង ពី អ្វី ដែល គាត់ ចូលចិត្ត ។
ថ្ងៃ នោះ ជា ថ្ងៃ របស់ ព្រះអម្ចាស់ ។
បន្ទាប់ពីការ ប្រយុទ្ធគ្នាអស់ សង្ឃឹម ដែលក្នុងនោះមានអ្នកប្រដាល់ជាច្រើន។
នេះគឺអាក្រក់សម្រាប់ឥរិយាបថរាងកាយរបស់អ្នក ។
លោកបានបន្តថា៖ « ចង់បានអ្វីមួយហើយខ្លាចឪពុកម្តាយមិនឲ្យដូច្នេះទើបនិយាយថានឹងធ្វើអត្តឃាត » ។
ពួកសិស្សបានចេញទៅក្រុងដើម្បីទិញអាហារ ។
