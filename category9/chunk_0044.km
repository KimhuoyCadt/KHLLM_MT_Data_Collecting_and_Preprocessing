គាត់ ឈប់ ហើយ គ្រវី ក្បាល ដោយ មិន ដឹងខ្លួន ។
ព្រះគម្ពីរ បង្រៀន : មនុស្ស ភាគ ច្រើន ដែល បាន ស្លាប់ នឹង រស់ ឡើងវិញ ។
ពួកគេមិនសមនឹងការ យល់ឃើញរបស់ខ្ញុំ ( ការ យល់ឃើញជាមុន ) និងការលម្អៀង ។
បន្ទាប់មក ពួកគេ បាន បន្ថែម ការស្វែងរក ដោយ ចៃដន្យ ។
នេះជាការ ស្លាប់លើកទីពីរ ។
អ្នក នឹង ឃើញ ការពេញចិត្ត កាន់តែ ច្រើន នៅក្នុង ជីវិត ។
បានលើកទឹក ចិត្តពួកគេទាំងអស់គ្នាឲ្យរក្សា ភាព ស្មោះត្រង់ចំពោះព្រះអម្ចាស់ ។
ជាមួយនឹង ការឆ្លងកាត់ នៃ ព្រលឹង នៃ ពរ ជ័យ ចូល ទៅក្នុង
ទាំងអស់ត្រូវបានគេវាយ ប្រហារនៅផ្ទះពេលពួកគេដេក ។
ឥឡូវនេះ ពួកសាវ័ក និងបងប្អូននៅស្រុកយូដាបានឮថា សាសន៍ ដទៃក៏ទទួល យកព្រះបន្ទូលរបស់ព្រះ ដែរ ។
យើង ត្រូវតែ មាន លទ្ធិ ប្រជាធិបតេយ្យ ពិតប្រាកដ
នៅ ទីនោះ ស្ត្រីពីរនាក់បានឈ្លោះប្រកែកគ្នាអំពីប្តីដែលមានឋានៈខ្ពស់ជាង ។
១៦ ទោះជាយ៉ាង ណា បើអ្នក រងទុក្ខក្នុងនាមជាគ្រិស្ដសាសនិក កុំត្រូវខ្មាសឡើយ ចូរសរសើរ ត ម្កើងព្រះ ដែលអ្នកមានឈ្មោះនោះ ។
ពួកគេនៅក្នុងរបងភក់ដែលមានជញ្ជាំងដែល ជន់លិចពេលមានភ្លៀង ។
បន្ទាប់មក ព្រះ យេស៊ូបានអធិដ្ឋានសុំ «អស់អ្នកដែលនឹងជឿ លើ តាម រយៈពាក្យរបស់ពួកគេ » ។
« មានម្នាក់ក្នុងចំណោមពួកគេឈ្មោះកៃ ផាស ដែលជាមហាបូជាចារ្យនៅឆ្នាំនោះ បាននិយាយឡើងថា
សុន្ទរកថាទៅកាន់ពួកគេដែលទ្រង់បានដាស់តឿនដល់ការ សងសឹក ។
ប្រជាជាតិដែលបានកើតចេញពីអំពើ បាប ។
ការសន្យា ដែល ខ្លួន បាន ធ្វើ ចំពោះ ប្រជាជន
ដើម្បីក្លាយជាផ្នែកមួយនៃការ គោរពនេះ និងជាមួយពួកគេ គឺពិតជា អស្ចារ្យណាស់ » ។
យើង ខ្លាច ថា យើង នឹង ធ្វើឱ្យ ពួកគេ មាន អារម្មណ៍ មិន ល្អ ឬ ធ្វើឱ្យ ពួកគេ ខឹង ។
យើង ជឿ ថា អ្នក ដាក់ បាទ នៅក្នុង ចិត្ត និង គំនិត របស់ ពួកគេ ថា នេះ នឹង ក្លាយជា ថ្ងៃ ដែល ពួកគេ នឹង មក រក អ្នក ដោយ ប្រែចិត្ត និង អធិស្ឋាន សុំ ការអភ័យទោស ហើយ បាន កើត ជាថ្មី នៅក្នុង ព្រះរាជាណាចក្រ របស់ អ្នក ! ,
គាំទ្រ ដល់ គោលដៅ របស់ សហភាព អឺរ៉ុប
៣ ដូច្នេះ ទ្រង់មាន បន្ទូលថា យើងជាព្រះ ជាព្រះ នៃឪពុកឯង កុំខ្លាចចុះទៅស្រុកអេស៊ីព្ទឡើយ ដ្បិតអញនឹងតាំងឯងឲ្យក្លាយជា សាសន៍ដ៏ធំនៅទី នោះ ។
គេនឹងនិយាយថា “ អ្នកទាំងពីរចូលទៅក្នុងភ្លើងជាមួយនឹងអ្នកចូលផ្សេងទៀត ។
លុយដែលខ្ញុំនឹងយកចេញត្រូវបាន បង់ពន្ធចំនួន ៤៥% ។
ឬ ពួកគេ គ្រាន់តែ ចង់ ឃើញ អ្វី ដែល ពួកគេ ចូលចិត្ត ?
ក និងខ្នងរបស់ខ្ញុំមិនឈឺទេ » ។
៤ នេះជាប្រវត្តិនៃស្ថាន សួគ៌ និងផែនដីនៅពេលដែលវាត្រូវបានបង្កើតឡើង ។
៦ ប្រាកដហើយ ទុក្ខព្រួយមិនកើតចេញពីដីទេ ហើយទុក្ខលំបាកក៏មិនកើតចេញពីដីដែរ ។
បត់ ឆ្អឹងជំនីរ ទៅ គ្នា ទៅ វិញ ទៅមក ។
ស្រា ទំពាំងបាយជូរ នៃ សេចក្តីក្រោធ ដ៏ កាច នៃ ព្រះ ជា ព្រះ ដ៏ មាន មហិទ្ធិ ឫទ្ធិ ។
« ព្រះយេស៊ូវបានយាងមកឈរនៅក្នុងចំណោមពួកគេ ហើយមានព្រះបន្ទូល ថា៖ ‹ សន្តិភាពនៅជាមួយអ្នក›» ។
« ហើយប្រសិនបើខ្ញុំដេញអារក្សដោយបេល សេប៊ូល តើកូនប្រុសរបស់អ្នក ដេញវាដោយនរណា ?
ប៉ុន្តែប្រសិនបើយើងមានអាហារ និងសម្លៀក បំពាក់ នោះយើងនឹងពេញ ចិត្តនឹងរឿងនោះ ។
ពិត ទេ ហើយ ខ្ញុំ នឹង បញ្ជាក់ ។
ជើង ធំ នៅ ពេលល្ងាច ជាង ពេលព្រឹក ។
សម្រាប់អ្នក ប្រមាញ់ត្រូវបានបង្ហាញជាមួយនឹង entrails ឆ្អិននៃសត្វព្រៃរបស់គាត់និង
« ដើម្បីរង់ចាំព្រះរាជ បុត្រាទ្រង់ពីស្ថាន សួគ៌ ដែលទ្រង់បានប្រោសឲ្យ រស់ឡើងវិញ សូម្បីតែព្រះយេស៊ូវដែរ » ។
ឥឡូវនេះឃាត់គាត់ ដើម្បីឲ្យគាត់បានលេចមកនៅពេលគាត់ ។
នៅ ពេលព្រឹក គាត់ នឹង មាន អារម្មណ៍ ខ្មាស់អៀន ។
អ្នក ដែល មិន បាន បង្កើត វា នៅលើ ហ្វេសប៊ុក ។
និយាយ តាម ត្រង់ វា មកពី ខ្ញុំ ។
ខ្ញុំបានធ្វើការ ដើម្បី យល់ច្បាស់ពីអ្វីដែលបានកើតឡើង និងរបៀបធ្វើឱ្យប្រាកដថារឿងនេះមិនកើតឡើងទៀតទេ » ។
វា ចាំបាច់ មិន គ្រប់គ្រាន់ ទេ ។
ពេលចូល លុកលុយតំបន់នេះ គេចាប់យកវប្បធម៌ពីមុន មក ។
២០ ខ្ញុំសូមប្រាប់អ្នក រាល់គ្នានៅចំពោះព្រះ ថា អ្វីដែលខ្ញុំសរសេរទៅអ្នកគឺមិនមែនជាការ កុហក ...
ប្រសិនបើ អ្នក មិន ខ្វល់ ខ្លះ គឺជា ប្រាសាទ ដែល ត្រូវការ ។
ព្រោះគេមិនបានបង្ហាញខ្លួននៅផ្ទះយើង !
នេះ គឺជា ពេលវេលា សម្រាប់ បុរស ។
ដល់អស់អ្នកដែលជាប់ក្នុងអំពើ បាប ។
ពួកគេបានឃើញអ្វីដែលហាក់ដូចជាអណ្តាត ភ្លើងដែលបែកគ្នា ហើយមកសណ្ឋិតលើពួកគេម្នាក់ ៗ ។
តើ អ្នក មិន ជំទាស់ នឹង ការផ្លាស់ប្តូរ ធម្មនុញ្ញ នេះ ទេ ។
តើអ្នកមិនអាចរង់ចាំឱ្យខ្ញុំដើម្បីធ្វើឱ្យសំណួរព្រះ ?
ពួកគេបានស្បថថាមិនបរិភោគឬផឹកឡើយ រហូតដល់គេសម្លាប់ប៉ូល ។
អាច ត្រូវបាន ញ៉ាំ តែ ម្នាក់ឯង ឬ ជាមួយ អាហារ ផ្សេង ទៀត ។
ពួកវា ទាប ធំ ទូលាយ និង រឹងមាំ ដូច្នេះហើយ ពួកគេ មាន ផាសុកភាព សម្រាប់ អ្នក ដែល ចង់ លុត ជង្គង់ ។
ប្រសិនបើអ្នកធ្វើការ ទាំងនេះ ចូរបង្ហាញខ្លួនទៅ កាន់ពិភពលោកចុះ › ។
គោល ដៅរបស់ពួកគេគឺដើម្បីចែករំលែក ផលផ្លែនៃអំណោយទានដែលពួកគេបានទទួល ពរ ។
ពួកគេ មិន ខ្លាច អ្វី ទាំងអស់ ពួកគេ មាន ទំនុកចិត្ត និង ក្លាហាន ។
ប៉ុន្តែ លោកម៉ូសេ ទូលព្រះថា៖ « ខ្ញុំ ជាអ្នក ណា ដែលខ្ញុំត្រូវទៅជួបស្ដេចផារ៉ោន
អ្នក មានអារម្មណ៍ ល្អ ពេល យប់ ។
តើអ្នកនឹងសម្លាប់យើងដូចជាអ្នកបានសម្លាប់ជន ជាតិអេហ្ស៊ីបឬ ? » ។
ខ្ញុំជា សាសន៍លេវី មកពីភូមិបេត លេហិមនៃស្រុកយូដា ហើយខ្ញុំកំពុងធ្វើដំណើរទៅកន្លែង ណាដែលខ្ញុំអាច រកឃើញ ។
អ្វី មួយ ដែល ខ្ញុំ អាច ធ្វើបាន នៅក្នុង ប្រទេស នោះ ។
17 កាលគេឃើញព្រះអង្គ គេក៏ថ្វាយ ‌បង្គំព្រះអង្គ ប៉ុន្តែអ្នកខ្លះ សង្ស័យ
ខទី 10: នៅក្នុង ការអធិស្ឋាន របស់ ខ្ញុំ គ្រប់ ពេលវេលា ; ហើយខ្ញុំអធិស្ឋានថា ឥឡូវនេះតាមព្រះហឫទ័យរបស់ព្រះ ផ្លូវអាចនឹងត្រូវបានបើកឲ្យខ្ញុំមក ឯអ្នក រាល់គ្នា ។
អ្នក ទាំងនេះបានមកជួបដាវីឌ និងអ្នកដែលនៅ ជាមួយគាត់ ។
ត្រូវ មាន ចិត្ត សប្បុរស និង មេត្តា ចំពោះ អ្នកដទៃ ។
កុំដោះលែងគាត់អី ដោះលែងបារ៉ា បាស មកយើងវិញ !» ។
អ្នក ណាតាំងខ្លួនជាចៅក្រមនៃសេចក្តី ពិត និងចំណេះដឹង
៣៨ ខ្ញុំនិយាយអំពីអ្វីដែលខ្ញុំបានឃើញជាមួយនឹងបិតារបស់ខ្ញុំ ហើយអ្នក រាល់គ្នាធ្វើតាមអ្វីដែលអ្នកបានឮពីឪពុករបស់អ្នក » ។
ដូច ទៅនឹង ជញ្ជាំង ភ្លើង ដែរ អ្នក អាច មាន អ្នក ផ្តល់ សេវា ច្រើន ប៉ុន្តែ អ្នក ប្រហែលជា ត្រូវការ តែ មួយ ប៉ុណ្ណោះ ។
១៤ បន្ទាប់មក លោកយេស៊ូបានបង្ហាញខ្លួនឲ្យសិស្សទាំង១១ នាក់ឃើញ ពេលពួកគេកំពុងបរិភោគ ។
អ្នក ស្មោះត្រង់ត្រូវបានគេល្បួង ហើយខ្លះទៀតកំពុងតែលួចចូល ។
វា ទំនងជា នឹង ត្រូវបាន ប្ដូរ តាម បំណង ស្រប តាម ចំណង់ចំណូលចិត្ត របស់ អ្នក ។
យើងនឹងស្តាប់ ហើយយើងនឹងចាត់វិធានការ » ។
(1) “ ខ្ញុំសើចពេលឮថាត្រីក្នុងទឹកស្រេក ។
ដំបូងអត់មានអ្នក ណារាំទេ ហើយក្រោយមក ...
ខ្ញុំមិននឹកស្មានថាមានអ្វីខុសជាមួយខ្ញុំទេ ប៉ុន្តែខ្ញុំដឹងថាមានអ្វីមួយត្រូវកើតឡើង ។
ចងចាំ ថា ត្រូវ គូសបញ្ជាក់ ពាក្យ ដែល អ្នក បាន ផ្គត់ផ្គង់ ។
“ ពួកគេ ថ្ងូរ យ៉ាង ខ្លាំង សូម្បីតែ បន្ទាប់ពី ជំនួស ពួកគេ ខ្លះ ក៏ដោយ ។
សិស្សមិនលើស គ្រូរបស់ខ្លួនឡើយ ប៉ុន្តែអ្នក ណាដែលបានបង្ហាត់យ៉ាងពេញ លេញនឹងបានដូចគ្រូរបស់ខ្លួន ។
ពីរ ភាគ បី នៃ មនុស្ស 239 នាក់ នៅលើ យន្តហោះ គឺ មកពី ប្រទេស ចិន ហើយ សមាជិក គ្រួសារ របស់ ពួកគេ ជាច្រើន និយាយ ថា ពួកគេ នឹង មិន ជឿ ការសន្និដ្ឋាន របស់ រដ្ឋាភិបាល ម៉ាឡេស៊ី រហូតដល់ មន្ត្រី ផ្តល់ ភស្តុតាង ។
ប្រសិនបើ អ្នកទិញ របស់ ដែល មិន ត្រូវការ អ្នក ប្រហែលជា ត្រូវ លក់ របស់ ដែល អ្នក ត្រូវការ នៅពេល អនាគត ។
20 នៅថ្ងៃនោះ អ្នកនឹងដឹងថា ខ្ញុំនៅក្នុងព្រះ‌បិតារបស់ខ្ញុំ ហើយអ្នក រាល់គ្នានៅក្នុងខ្ញុំ ហើយខ្ញុំក៏នៅក្នុងអ្នកដែរ ។
« ទុកឲ្យគេវិនិច្ឆ័យមនុស្សគ្រប់ពេល ។
លោកមិនប្រឈមមុខនឹងការ ចោទប្រកាន់ពីការ ប្រព្រឹត្តខុសនោះទេ ។
មិនបានរក្សាល្បឿនជាមួយបញ្ញា » ។
ព្រះ មិនបានបោះ បង់ចោលជន ជាតិអ៊ីស្រាអែលឡើយ ។
ហើយដំណឹងអំពីគាត់បានសាយភាយពេញតំបន់ជុំវិញ ។
អ្នក ដែល បរាជ័យ គឺ ត្រូវ ទុកចោល ។
មាន ពរហើយអ្នកបង្កើតសន្តិភាព ដ្បិតគេនឹងត្រូវបានហៅថាជាកូនរបស់ព្រះ...
សម្រាប់ នោះ យើង ត្រូវ ធ្វើ គណិតវិទ្យា ជាមុន សិន ។
ដើមឈើ ត្រូវបាន គេ ស្គាល់ ដោយសារ ផ្លែ ឈើ របស់ វា ប៉ុន្តែ កម្លាំង របស់ ដើមឈើ គឺ ស្ថិត នៅលើ ឫស របស់ វា ។
ហើយពួន សម្ងំក្នុងភួយរង់ចាំព្រះអាទិត្យ រះ ។
« ហើយគាត់បានចេញពីទីនោះ ហើយទៅតំបន់យូឌា និងហួសទន្លេយ័រ ដាន់ ហើយហ្វូងមនុស្សបានមក ឯទ្រង់ម្ដងទៀត ហើយទ្រង់ក៏បង្រៀនពួកគេតាមទម្លាប់របស់ទ្រង់ម្ដងទៀត » ។
លើកលែងតែ ឪពុក របស់ អ៊ីសាក ។
ហើយបាន បង្វែរក្រុងសូដុំ ម និងក្រុងកូម៉ូរ៉ាទៅជា ផេះ កាត់ទោសពួកគេឲ្យវិនាស ដោយបានធ្វើជាគំរូដល់អស់អ្នកដែល រស់នៅក្នុងផ្លូវទុច្ចរិត ។
ខ្ញុំត្រូវការ អ្នក ។
ពួកគេ ពីរ នាក់ បាន បន្ត ទៅ ក្រុង សូដុំម ។
គាត់ បាន និយាយ ថា " យើង គួរតែ ស្វែងរក ពិរុទ្ធជន ទាំងនោះ នៅក្នុង ប្រទេស ចិន ម្តង មួយ ៗ ហើយ នាំ ពួកគេ មក កាត់ទោស ។
ថាគេមិនត្រូវធ្វើឲ្យស្មៅដុះលើផែនដីរង របួស ឬក៏ដោយ
ប្រាកដជាត្រូវផ្តួលក្រុមបេង ហ្គាល់ ។
ភ្នាក់ងារ លក់ ធានារ៉ាប់រង ។
អ្នក អាច ពិនិត្យមើល ដោយ ខ្លួន ឯង បាន
ប្រសិនបើ អ្នក មាន សំណួរ អំពី ផលិតផល មួយ របស់ យើង ។
បង្ហាញ អ្វី ដែល អ្នក មាន ។
គាត់បាននិយាយថា គ្មានអ្នក ណាដាក់ ស្រាថ្មីក្នុងស្បែកស្រាចាស់ឡើយ ។
ពួកគេនឹងនិយាយថា “ វាគឺសម្រាប់ពេលនេះហើយ ” ។
បើ ព្រះគង់ សម្រាប់ យើង តើ អ្នកណា ប្រឆាំង នឹង យើង ?
ខ្ញុំគិតថា “ ខ្ញុំមិនបានគិតពីរឿងត្រឹមត្រូវទេ !
ជួយ ខ្ញុំ រកមើល ពួកគេ ។
វា ជា បញ្ហា ប្រឈម ក្នុង ការដើរ
យើង ទាំងអស់ គ្នា ត្រូវ ឆ្លើយ ទៅកាន់ ព្រះជាម្ចាស់ ដោយ ខ្លួន ឯង ។
" ខ្ញុំ គ្រាន់តែ ចងចាំ អ្នក ប៉ុណ្ណោះ ។
ប្រជាជាតិ នានា នៅលើ ផែនដី នឹង ដើរ ដោយ ពន្លឺ របស់ វា ។
យើងមានអ្វីមួយសំខាន់ណាស់ក្នុងការ រៀនឥឡូវនេះ ។
20 ខ្ញុំប្រាថ្នាចង់បាននៅ ជាមួយអ្នក ឥឡូវនេះ ហើយផ្លាស់ប្តូរសំឡេងរបស់ខ្ញុំ ព្រោះខ្ញុំឆ្ងល់អំពីអ្នក ។
10 មិនត្រូវរួមជាមួយនឹងអ្នកប្រព្រឹត្តអំពើប្រាសចាកសីលធម៌ខាងផ្លូវភេទរបស់លោកីយ៍នេះ ឬជាមួយនឹងពួកឈ្លើយសឹក និងឈ្លើយ ឬអ្នកថ្វាយ បង្គំរូបព្រះ ឡើយ តាំងពីពេលនោះមក អ្នក រាល់គ្នាគួរចាកចេញ ពីពិភពលោកទៅ ។
យើងអាចសុំព្រះឲ្យជួយយើងអធិស្ឋានឲ្យពួកគេ ហើយទ្រង់នឹងធ្វើ !
កូនប្រុស របស់ ខ្ញុំ អាច ប្រើ របស់ ទាំងនេះ ។
រហូតមកដល់ពេលនោះ ភាពល្ងង់ ខ្លៅដែលបាន បង្ខំគឺជាពាក្យនៃថ្ងៃនេះ។
« ដ្បិតហេរ៉ូឌខ្លាច យ៉ូហាន ដោយដឹងថាគាត់ជាមនុស្សសុចរិត និងបរិសុទ្ធ .. .
ដូច្នេះ ខ្ញុំមិនគិតថាអ្នកអាចវិនិច្ឆ័យអ្វីដោយពួកគេទេ ។
នៅក្នុងសួនអេដែន ព្រះ យេហូវ៉ាបានមាន បន្ទូលថា៖ « វាមិនល្អទេសម្រាប់បុរសដែលនៅ តែម្នាក់ឯង ។
ខ្ញុំមិនអាចផឹកស្រាបានទេ » ។
នាង មិន បាន ធ្វើ អ្វី ល្អ សម្រាប់ អាមេរិក ទេ ។
ព្រះមហាក្សត្រ ដែល តែងតាំង ពួកគេ ។
