តើនឹងមានអ្វីកើតឡើងនៅពេលដែលអ្នកទាំងពីរ មកជួបគ្នា ?
នាងបានបន្តថា “ អ្នក រាល់គ្នាចាកចេញពីផ្ទះ ។
ខ្លាចក្នុងការ ផ្តល់អ្វីដែលអ្នកមិនអាចទទួលបាន វិញ » ។
ពួកអ្នក បម្រើទូលព្រះអង្គ ថា៖ ‹ តើលោកចង់ឲ្យយើងទៅទាញពួកគេឡើងឬ ? › ។
នៅសល់ ទាំងអស់ ត្រូវ បន្ត សរសើរ តម្កើង ព្រះអម្ចាស់ គ្រប់ ពេលវេលា ។
បន្ទាប់ពីយើងប្រែក្លាយទៅជាគ្រីស្តាល់ » ។
អ៊ីស្រា ‌ អែលអើយ បើឯងស្តាប់ខ្ញុំ !
ខ្ញុំ ឃើញ ទីបញ្ចប់ នៃ ពូជ មនុស្ស
" យូដូ បាន ផ្លាស់ប្តូរ ជីវិត របស់ ខ្ញុំ ។
“ អ្នកគាំទ្រជាទី ស្រឡាញ់ ឥឡូវដល់ពេលហើយ ហើយខ្ញុំនឹង បញ្ចប់អាជីពសកម្មរបស់ខ្ញុំនៅចុងរដូវ កាលនេះ ។
នឹង អាច បង្កើត ទ្រព្យសម្បត្តិ កាន់តែ ច្រើន ។
ខ្ញុំរំភើប ចិត្តដែលគេជ្រើស រើសខ្ញុំ » ។
ហើយ គាត់ បាន ចងចាំ រាល់ ទង្វើ របស់ នាង ដែល នាង បាន ធ្វើ ក្នុង ជីវិត របស់ នាង ហើយ គាត់ បាន ទួញ សោក នាង យ៉ាង ខ្លាំង ។ ដ្បិតគាត់ស្រឡាញ់នាងអស់ពី ចិត្ត និងអស់ពីព្រលឹង ។
ខ្ញុំ មិន ចាប់អារម្មណ៍ នឹង បុរស ទេ ?
បុរសខាងចុងបានស្វាគមន៍
នៅ ពេល ដែល វា ជា កំណត់ ត្រា រួចហើយ វា គឺជា អារេ នៅក្នុង លទ្ធផល ហើយ នៅ ពេល ដែល វា ត្រូវបាន បន្ថែម វា គ្រាន់តែ ជា លេខ ប៉ុណ្ណោះ ។
ពួកគេ និយាយ ថា " ភាពរស់រវើក របស់ អ្នក ទាក់ទាញ កុលសម្ព័ន្ធ របស់ អ្នក " ដែល យោង ទៅតាម ច្បាប់ នៃ ការទាក់ទាញ គឺជា ការពិត ។
ដូច្នេះ ចូរអធិស្ឋានដល់ព្រះ អម្ចាស់នៃការ ច្រូតកាត់ឲ្យទ្រង់ចាត់អ្នកច្រូតមកក្នុងការ ច្រូតកាត់របស់ទ្រង់ ... ។
អ្វីដែលគេធ្វើគឺខុស ហើយខ្ញុំមិនអាចអត់ទោសឲ្យពួកគេបានឡើយ » ។
អ័ ប្រាហាំ ត្រូវបាន សង្គ្រោះ ដោយ កិច្ចព្រមព្រៀង ។
ត្រូវបានបញ្ចេញពន្លឺចេញពីពន្លឺដែលត្រូវបានគេចាត់ទុកថាពិសិដ្ឋ
៦.បញ្ញត្តិទាំងនេះដែលខ្ញុំឲ្យអ្នកនៅថ្ងៃនេះ គឺត្រូវស្ថិតនៅក្នុង ចិត្តអ្នក ។
សេចក្តីពិត ដែល នាំ ទៅដល់ កម្រិត ខ្ពស់
ហើយកុំឲ្យខ្ញុំព្រោះគម្ពីរចែងដូច្នេះ ។
ខណៈពេល ដែល ស្នេហា ឈឺចាប់ វា ជា ការសំខាន់ ដែល ត្រូវ ចងចាំ ថា ស្នេហា ក៏ ធ្វើឱ្យ អ្នក ដែរ ។
អ្នកនឹងសម្លាប់ក្មេងនោះ » ។
ឆ្ងល់ ថា តើ មាន អ្វី កើតឡើង នៅក្នុង ក្បាល អ្នកនិពន្ធ ?
ការ តុបតែងបែបនេះត្រូវបានគេមើលឃើញថាជាពាក្យជេរ ហើយអ្នកដែលពាក់ វាត្រូវបានគេមើលងាយ » ។
អ្នក ចូលចិត្ត វា ហើយ អ្នក ចង់ ចែករំលែក វា ជាមួយ អ្នកដទៃ ។
~ « ពេលអ្នកបានលើកកូនមនុស្សឡើងហើយ នោះអ្នកនឹងដឹងថាខ្ញុំ ជា ហើយថាខ្ញុំមិនធ្វើអ្វីដោយខ្លួនឯងឡើយ ប៉ុន្តែនិយាយតាមអ្វីដែលខ្ញុំបានឮពីព្រះវរ បិតារបស់ខ្ញុំ ... » ។ ១៣]
ខ្ញុំចង់ឲ្យអ្នកទៅដល់ថ្ងៃដែលអ្នកបានជួបបុរសនោះ គឺពេលដែលអ្នកបានក្លាយជាមនុស្សអមតៈ » ។
ថ្ងៃដែលយើងកើត និងថ្ងៃដែលយើងរកឃើញថាហេតុ អ្វីបានជា » ។
នៅ ពេល ដែល ខ្ញុំ ប្រាថ្នា ចង់បាន អ្វី ប្លែក
យើងនឹងធ្វើឱ្យអាមេរិកកាន់តែអាក្រក់ឡើងវិញ។
ប៉ុន្តែវាហាក់ដូចជាមិនរំខានម៉ារីយ៉ាមទេ ។
សូមមេត្តា ក រុណាដល់ទូលបង្គំ តាមពាក្យរបស់ព្រះអង្គ ។
តើ អ្នក ចូលចិត្ត សមាជិក ទាំងអស់ ទេ ?
ហើយ មិន មាន អ្វី កាន់តែ អាក្រក់ បន្ទាប់ពី ជា មធ្យម បី ឆ្នាំ ។
អ្នកមិនអាចយកលុយទៅជាមួយពេលអ្នកស្លាប់ទេ » ។
« ទ្រង់នឹងបង្ហាញផ្លូវនៃជីវិតដល់ទូលបង្គំ ដោយព្រះភក្ត្រទ្រង់ពោរពេញដោយសេចក្តី អំណរ ហើយនៅខាងស្ដាំទ្រង់ជាសេចក្តី រីករាយ ជារៀងរហូត » ។
ចារឹក លើ វា ជា ព្រះនាម របស់ ព្រះ។
កុំភ្លេចកំដរមនុស្សចម្លែកឲ្យសោះ ព្រោះមនុស្សខ្លះបានលេងទេវតាដោយមិនដឹងខ្លួន ។
យើង នឹង ធ្វើ អ្វី គ្រប់ យ៉ាង ក្នុង នាម របស់ អ្នក ក្រោម ម៉ាក របស់ អ្នក ។
អ្នក នឹង ត្រូវបាន សួរ ( ពីរ ដង ) សម្រាប់ ពាក្យ សម្ងាត់ សម្រាប់ អ្នកប្រើប្រាស់ ថ្មី ។
អ្នកដែលសុចរិតជាអ្នក នាំផ្លូវដល់អ្នកជិតខាង ប៉ុន្តែផ្លូវរបស់មនុស្សទុច្ចរិតនាំគេឲ្យវង្វេង (Pr 12:26) ។
36 ដូច្នេះ បើព្រះ‌ បុត្រាប្រោសអ្នក រាល់គ្នាឲ្យមានសេរី ‌ភាព នោះអ្នក រាល់គ្នានឹងមានសេរីភាពយ៉ាងពិតប្រាកដ ។
សប្ប័ទ ; វាមិនមានច្បាប់សម្រាប់អ្នក យកគ្រែរបស់អ្នកទេ » ។
បាន បើក ទ្វារ ស្ថាន សួគ៌ ។
ប៉ុន្តែ អស់អ្នកដែលបានឮព្រះ‌បន្ទូលជាច្រើនបានជឿ ហើយចំនួនមនុស្សមានប្រហែលប្រាំពាន់នាក់ ។
បើគាត់មិនគោរពកិច្ចសន្យា គាត់នឹងត្រូវទទួល ទោស ។
10 លើសពីនេះទៅទៀត ពួកគេគួរ តែត្រូវបានសាកល្បងជាមុនសិន ។ ដូច្នេះ បើគ្មានអ្វីទាស់នឹងគេទេ ចូរឲ្យគេធ្វើជា ឌី កុន ។
ព្រះ មាន បន្ទូលថា៖ « តើបុរសនេះមិនមែនជាឈើដុតដែលឆក់យកពីភ្លើងទេឬ ?
រក្សាពួកគេបានកំណត់ផងដែរហើយការ រំលងពួកគេគឺជាការ ខុស។
« ចំពោះមនុស្សរឿងនេះមិនអាចទៅរួចទេ ប៉ុន្តែចំពោះព្រះវិញ អ្វី ៗទាំងអស់គឺអាចទៅរួច » ។
ដូច្នេះយើងនឹងស្វែងរកពួកគេ » ។
អ្នកដែលជឿបានលាក់ខ្លួនក្នុងហិប ។
“ អ្នក រាល់គ្នាប្រឆាំងនឹងខ្ញុំ ។
មនុស្សបែបនេះបានមកពីដៃអ្នកបង្កើតរបស់គាត់ ។
ពី ផ្ទៃ ម្តាយ របស់ គាត់ ។ ហើយកូនចៅអ៊ីស្រាអែលជាច្រើននាក់នឹងបែរទៅរកព្រះអម្ចាស់ ជាព្រះ របស់ពួកគេ ។
« ទុកឲ្យគាត់ស្ដាប់នៅថ្ងៃស្អែក » ។
វាត្រូវបានគេអះអាងថាអាចប្រើបានរហូតដល់ 10.5 ម៉ោងលើការ សាកថ្មមួយដង ។
ការលួច និង ការលួច ក៏ ជា លក្ខណៈ ទូទៅ ដែរ ។
តើខ្មោចនោះគិតថាគាត់កំពុងធ្វើអ្វី ?
ខ្ញុំ រកឃើញហើយបង !
វាមិនមែនជារបស់បុរសចំណាស់នោះទេ ប៉ុន្តែ ជារបស់អ្នកនៅក្បែរគាត់ ។
ក្នុងនោះគាត់បានបង្ហាញ ភាព ក្លាហានជាក់ ស្តែង ។
ហើយគេគិតថាអ្នកទាំងពីរមានក្លិនស្អុយ ។
មាន តែ អ្នកក្លាហាន ប៉ុណ្ណោះ ដែល ត្រូវ ការចុះឈ្មោះ ។
ខ្ញុំ ក៏ ចូលចិត្ត លេង ហ្គេម អនឡាញ ដែរ ។
៣ ដើម្បីឲ្យអ្នកបានសុខ សប្បាយ ហើយអ្នកអាច រស់នៅលើផែនដីបានយូរ ។
