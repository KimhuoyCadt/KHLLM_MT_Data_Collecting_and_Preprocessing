ហេតុ អ្វីមិនមានរឿងកើតឡើងចំពោះខ្ញុំ ?
ចូរមើលទៅថា គ្មាននរណាម្នាក់ខ្វះព្រះគុណរបស់ព្រះ ឡើយ ហើយក៏គ្មានឫសនៃ ភាព ជូរ ចត់ដុះឡើងដើម្បីបង្កបញ្ហា និង បង្ខូចមនុស្សជាច្រើនដែរ ។
បុរសម្នាក់នេះមិនបានធ្វើអ្វីដែលគាត់ត្រូវស្លាប់ ។
លោកបានមាន ប្រសាសន៍ថា៖ « នៅប្រទេសកម្ពុជា យើងបានឃើញថាច្បាប់មួយចំនួនត្រូវបានបង្កើតឡើងដើម្បីរឹតត្បិតសិទ្ធិសេរីភាពរបស់ប្រជាជនច្រើនជាងការ ការពារនិងផ្តល់សិទ្ធិសេរីភាព ដល់ពួកគេទៅទៀត ។
ប៉ុន្តែឥឡូវនេះ យើងនៅ តែត្រូវឆ្លងកាត់១៤ ថ្ងៃទៀតនៅពេលយើងត្រឡប់ទៅកាណាដាវិញ » ។
ប៉ុន្តែយើងជឿថា យើងនឹងត្រូវបាន សង្គ្រោះតាម រយៈព្រះគុណនៃព្រះអម្ចាស់យេស៊ូវរបស់យើង ដូចជាពួកគេនឹងធ្វើ ។
បាក់ ឆ្អឹង៖ នៅ ពេល ដែល ចាប់ បាន ដោយ ឧក្រិដ្ឋ ជន ឆ្អឹង បាក់ អាច បណ្តាល មកពី ។
ប៉ុន្តែប្រសិនបើខ្ញុំដេញអារក្សដោយម្រាម ដៃរបស់ព្រះជាម្ចាស់ នោះនគររបស់ព្រះជាម្ចាស់បានមកដល់អ្នកហើយ » ។
ប៉ុន្តែក្នុង នយោបាយប្រធានាធិបតីមានការ ផ្លាស់ប្តូរ ។
៨ ឥឡូវនេះ បើយើងបាន សុគត ជាមួយនឹងព្រះ គ្រីស្ទ នោះយើងជឿថា យើងនឹង រស់នៅ ជាមួយនឹងទ្រង់ដែរ ។
នេះ គ្រាន់តែ ជា សិល្បៈ អ្នកគាំទ្រ ប៉ុណ្ណោះ !
សត្វ តិរច្ឆាន ហើយ ថ្វាយបង្គំ ព្រះនាម របស់ វា ។
20 ទ្រង់បានសម្ពោធផ្លូវ រស់នៅថ្មីសម្រាប់យើងតាម រយៈវាំងនន ពោលគឺសាច់ឈាមរបស់ទ្រង់ ។
លោកបានប្រកាសថា៖ « មេដឹកនាំដ៏ត្រឹមត្រូវរបស់ប្រជាជន គឺបុគ្គលដែលអង្គុយលើបល្ល័ង្ក » ។
ពួកគេមិនខ្លាចមានមនុស្សប្រឆាំងនឹងពួកគេ ឬប្រឆាំងនឹង សារដែលគេផ្សាយនោះទេ ។
« អ្នក ណាដែលបដិសេធព្រះបុត្រាក៏គ្មានព្រះបិតាដែរ អ្នក ណាដែលទទួលស្គាល់ព្រះបុត្រាក៏មានព្រះបិតាដែរ » ។
ប្រហែលជា អ្នក អាច ធ្វើជា មិត្ត របស់ ពួកគេ ។
ខ្ញុំ គ្រាន់តែ ចែករំលែក វា សម្រាប់ អ្នក ទាំងអស់ គ្នា ។
15 ប៉ុន្តែដោយ សារវាជាបញ្ហានៃពាក្យនិងឈ្មោះនិងច្បាប់របស់អ្នកផ្ទាល់ , មើលវាដោយខ្លួនឯង ; ខ្ញុំមិនចង់ធ្វើជាចៅក្រមលើរឿងទាំងនេះទេ ។
អនាគត ខ្ញុំ មាន តែ សេចក្តីស្លាប់ !
កុំ ប្រើ ផលិតផល ប្រសិនបើ អ្នក មិន ត្រូវបាន ណែនាំ សម្រាប់ វា ដោយ វេជ្ជបណ្ឌិត របស់ អ្នក ។
គាត់បាននិយាយថា “ ខ្ញុំសូមអបអរសាទរអ្នកទទួលបានរង្វាន់ទាំងអស់ ។
ប៉ុន្តែប្រសិនបើខ្ញុំដេញអារក្សដោយម្រាម ដៃរបស់ព្រះជាម្ចាស់ នោះនគររបស់ព្រះជាម្ចាស់បានមកសណ្ឋិតលើអ្នក ហើយ ។
ពេត្រុសនៅគ្រប់ទីកន្លែង ។
នៅក្នុង សាសនា គ្រឹស្ត ព្រះគឺ ល្អ អារក្ស គឺ អាក្រក់ ។
យើងត្រូវ តែស្វែង រកដំណោះស្រាយ ព្រោះអ្វីដែលយើងកំពុងធ្វើនៅពេលនេះមិនគ្រប់គ្រាន់ទេ ។
បន្ទាប់មក លោកម៉ូសេ បានបែងចែកមនុស្សជាច្រើននាក់ ដែលជាច្រើនបានផ្លាស់ ទីយ៉ាងប្រញាប់ប្រញាល់ ភ័យខ្លាចទៅខាងលោក ។
ដូច្នេះ គេនឹងធ្វើជាចៅក្រមរបស់អ្នក ។
១៤ ខ្ញុំសរសេរនេះមិនមែនដើម្បីធ្វើឲ្យអ្នក រាល់គ្នាខ្មាសឡើយ គឺដើម្បីដាស់តឿនអ្នកក្នុងនាមជាកូនជាទី ស្រឡាញ់របស់ខ្ញុំ ។
ចូល ទៅក្នុង ជ្រលង ភ្នំ ពួកគេ បាន ប្រញាប់ប្រញាល់ ចេញ ទៅ នៅ ជើង របស់ គាត់ ។
ពួកគេ ខ្វាក់ ភ្នែក ចំពោះ អាថ៌កំបាំង នៃ ភាពប្លែក ។
អ្នកត្រូវ នាំអ្នក នាំភ្ញៀវមិនលើសពីប្រាំមួយនាក់ឡើយ » ។
28 ប៉ុន្តែ ក្រោយពីខ្ញុំបានរស់ឡើងវិញហើយ ខ្ញុំនឹងទៅស្រុកកាលីឡេមុនអ្នក រាល់គ្នា » ។
វេទនា ដល់អ្នក រាល់គ្នា ព្រោះអ្នកប្រៀបដូចជាផ្នូរគ្មានស្លាក សញ្ញា ដែលមនុស្សដើរឆ្លងកាត់ដោយមិនដឹងខ្លួន ។
នេះបើតាមការ សិក្សាមួយ
ខ្ញុំមិនយល់ថា ហេតុអ្វីបានជានាងសម្លាប់កូនរបស់នាង ។
គាត់ចង់ឃើញថាព្រះយេស៊ូវជានរណា ប៉ុន្តែគាត់ជាមនុស្សខ្លី គាត់មិនអាចទៅរួចទេ ដោយសារហ្វូងមនុស្ស ។
លុះ មកដល់ទ្រង់មានព្រះ‌បន្ទូលទៅគេថា៖
កូនស្តាប់ឪពុកគាត់និយាយត្រូវ ។
យើង ទាំងអស់ គ្នា ចង់ ដឹង ការពិត ។
ប៉ាប៉ា ដោះលែង ខ្ញុំ ។
នៅ ថ្ងៃ នេះ សូម គិត អំពី ការសន្យា នៃ ព្រះបន្ទូល របស់ ព្រះ និង សូម្បីតែ ការសន្យា ដែល បាន ផ្តល់ឱ្យ អ្នក ដោយ ការបំផុស គំនិត នៃ
កាលនៅក្មេង លោកបានស្ងើច នឹងពាក្យរបស់សាឡូម៉ូន ។
កូនដែលខ្ញុំឈឺចាប់ពីការ សម្រាលកូនម្ដងទៀត រហូតដល់ព្រះ គ្រីស្ទបានបង្កើតក្នុងអ្នក រាល់គ្នា .... .
អរគុណ ដាវីឌ ខ្ញុំ នឹង ក្រោក ឡើង ភ្លាម ៗ ។
ខ្ញុំបានប៉ះគេរួចហើយ ជូន ពរពួកគេ ដូច្នេះមិនអីទេ ( សើច ) យើងអាចសន្សំពេលខ្លះ ( ទះដៃ ) ។
យើង ថ្វាយបង្គំ ព្រះជាម្ចាស់ ដែល បាន សុគត ជំនួស យើង ព្រះអម្ចាស់ ដែល ត្រូវ គេ ឆ្កាង ។
35 ខ្ញុំនិយាយនេះដើម្បីប្រយោជន៍ខ្លួនឯង មិនមែនដើម្បីដាក់ កំហិតអ្នកទេ ប៉ុន្តែដើម្បីឲ្យអ្នកបានរស់នៅក្នុងផ្លូវត្រឹមត្រូវ ដោយការ លះបង់ចំពោះព្រះ‌ អម្ចាស់ ។
គេបញ្ចុះ សពលោកនៅក្រុង ដាវីឌ ប៉ុន្តែគេមិនបានបញ្ចុះ សពលោកនៅក្នុងផ្នូររបស់ស្ដេចឡើយ ។
យើងជឿថារាល់សុន្ទរកថាដែលប្រឈមនឹងអធិបតេយ្យភាព ជាតិ និងស្ថិរភាព សង្គម មិនស្ថិតក្នុងវិសាលភាពនៃសេរីភាពនៃការ បញ្ចេញ មតិនោះទេ » ។
ដូច្នេះហើយ យើង គួរតែ បង្ហាញ បដិសណ្ឋារកិច្ច ចំពោះ មនុស្ស បែប នេះ ដើម្បី យើង អាច ធ្វើការ ជាមួយគ្នា ដើម្បី ការពិត ។
ហើយ សូម្បីតែ សក់ ក្បាល របស់ អ្នក ក៏ ត្រូវបាន រាប់ ផងដែរ ។
គាត់បាននិយាយបែបនេះថា « ចូរជឿខ្ញុំចុះ ពេលខ្ញុំនិយាយថាខ្ញុំនៅក្នុងព្រះវរ បិតា ហើយព្រះវរ បិតាគង់នៅក្នុងខ្ញុំ ឬយ៉ាង ហោចណាស់ក៏ជឿលើភស្ដុតាងនៃការ ដែលខ្លួនគេធ្វើ » ។
តើគ្មានបណ្តា សា លើអ្នក ណាដែលដកចេញពី បទគម្ពីរទេឬ ?
ដែល គាត់ បាន ផ្ដល់ ជីវិត ។
ខ្ញុំរំភើប ចិត្តនឹងរឿងនេះ ព្រោះខ្ញុំចាប់អារម្មណ៍ចង់សាកល្បងវាមួយ រយៈហើយ ។
តើគាត់មើលថែអគ្គិសនីទាំងអស់ដែរឬទេ ?
