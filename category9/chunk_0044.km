គាត់ ចាប់ផ្តើម ធ្វើការ នៅក្នុង គ្រួសារ របស់ គាត់ ។
« អ្នកនឹងផឹកពែងដែលខ្ញុំបានផឹក ហើយទទួលបុណ្យជ្រមុជទឹកដែលខ្ញុំបានទទួលបុណ្យជ្រមុជទឹក ។
ហើយ ការពារ អ្នក ពី គ្រោះមហន្តរាយ ទាំងអស់ នៅលើ ផែនដី ។
« នោះមិនត្រឹម តែជាសិទ្ធិរបស់យើងទេ វាក៏ជាការ ទទួលខុសត្រូវរបស់យើងផងដែរ » ។
ខ្ញុំ គ្រាន់តែ ដឹង ថា ខ្ញុំ ចង់បាន ប៊ឺហ្គឺ ខ្លះ ។
" ខ្ញុំ សុំ ឱ្យ អ្នកអនុញ្ញាតឱ្យ ខ្ញុំ ទទួលខុសត្រូវ ចំពោះ កាសែត ឌឹ ខេមបូឌា ដេលី សម្រាប់ ពេលវេលា ដែល វា ស្ថិត នៅក្រោម កម្មសិទ្ធិ របស់ ខ្ញុំ ហើយ កុំ ឱ្យ ការទទួលខុសត្រូវ នេះ ទៅ កូនស្រី របស់ ខ្ញុំ ។
នៅ ឆ្នាំ ២០០២ គាត់ បាន ទទួល ចៅហ្វាយ របស់ គាត់ ។
បន្ទាប់មកយកវាទៅហាលថ្ងៃមួយឬពីរថ្ងៃសិន មុននឹងបន្ថែមវាទៅក្នុង វី វ៉ារៀមរបស់អ្នក។
បន្ទាប់មក យើងបានបែរចេញដំណើរទៅក្នុងទី រហោស្ថាន ក្នុងទិស ដៅទៅសមុទ្រក្រហម ដូចព្រះអម្ចាស់មានព្រះបន្ទូលមកខ្ញុំ ។
អ្នកនឹងផ្តល់ រង្វាន់ដោយឆន្ទៈរបស់ពួកគេដើម្បីផ្គាប់ ចិត្តអ្នក ។
ដើម្បីទិញអាហារសម្រាប់ប្រជាជនរបស់គាត់ ។
អំណាច ដើម្បី យល់ ពី អ្វី គ្រប់ យ៉ាង ។
ពួកគេក្រាបនៅចំពោះទ្រង់ ហើយថ្វាយ បង្គំទ្រង់ ។
នេះ នឹង ធ្វើឱ្យ អាមេរិក កាន់តែ ច្រើន ។
នាងបាននិយាយដោយ សង្ឃឹមថា " តើអ្នកអាចនៅជាមួយខ្ញុំមួយ រយៈបានទេ ? "
ហើយ មនុស្ស ទាំងអស់ បាន និយាយ ថា អាម៉ែន ។
ហើយអ្នកនឹងមានបំណងប្រាថ្នា ហើយអ្នកនឹងគ្រប់គ្រងលើវា ») ។
គ្មាន នរណា ម្នាក់ ធ្វើការ នៅ ថ្ងៃ នេះ ទេ ។
ខ្ញុំទើប តែចាប់ផ្ដើម ហើយខ្ញុំក៏នឹងឈប់ដែរ ។
ការ មិន ជឿ ការបដិសេធ ការសោកសៅ ។
ទ្វាររបស់គាត់ រួចប្រគល់ទៅឲ្យអ្នកចិញ្ចឹមជ្រូក
« មាន ពរហើយ អ្នកដែលមាន ចិត្តបរិសុទ្ធ ដ្បិតគេនឹងឃើញព្រះ។
និងអស់អ្នកដែលបានប្រព្រឹត្តអំពើអាក្រក់ ដល់ការ រស់ឡើងវិញនៃការ ផ្ដន្ទាទោស » ។
ខ្ញុំចង់បាន ប៉ុន្តែខ្សែនេះត្រូវបានបិទ ។
30 ដ្បិតប្រជាជាតិទាំងអស់ក្នុងពិភពលោកស្វែង រករបស់ទាំងនេះ ហើយព្រះ‌បិតារបស់អ្នក ជ្រាបថាអ្នកត្រូវការ របស់ទាំងនោះ ។
ចូរបន្តទៅ មុខរហូតដល់ពេលដែល ពរ ជ័យរបស់ព្រះអម្ចាស់នឹង មកដល់អ្នក » ។
កក់ក្តៅ នៅក្នុង ការដួលរលំ របស់ ពួកគេ ។
ព្យួរ វា ឡើង ប្រសិនបើ អ្នក ខ្មាស់អៀន ។
“ យើងបានឃើញការ សម្តែងរបស់បុរសនេះ ។
៣ នៅថ្ងៃ បន្ទាប់ យើងមកដល់ក្រុង ស៊ី ដូន ។
ខ្ញុំ បាន លឺ ច្រើន អំពី មជ្ឈមណ្ឌល សន្និបាត នេះ ។
ខកចិត្ត ក្នុង ការបម្រើ គ្រប់ ផ្នែក ។
មានបុរស ជាច្រើននាក់ផ្សេងទៀតដែលបានទស្សនាការ សម្ដែងនេះច្រើនដូចជាខ្ញុំធ្វើ។
« ដូច្នេះតើគេអាចហៅអ្នកដែលគេមិនបានជឿដោយរបៀប ណា ហើយធ្វើដូចម្ដេចឲ្យគេជឿលើអ្នកដែលគេមិនបានឮ ។
សៀវភៅ នេះ មិន ត្រឹមតែ ជា សំឡេង សម្រាប់ អ្នក ដែល ត្រូវបាន បន្សល់ទុក ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ក៏ ជា គណនី ស្រាវជ្រាវ យ៉ាង ត្រឹមត្រូវ សម្រាប់ អ្នក ដែល ជឿ ថា ការបិទបាំង នេះ នឹង ត្រូវបាន លាតត្រដាង ហើយ ការពិត ត្រូវបាន លាតត្រដាង នៅ ថ្ងៃ ណាមួយ » ។
ពីព្រោះឯងបានឲ្យគាត់មានអំណាចលើមនុស្សទាំង អស់ ដើម្បីឲ្យគាត់អាចឲ្យជីវិតអស់ កល្ប ជា និច្ចដល់អស់អ្នកដែលឯងបានប្រគល់ឲ្យគាត់ ។
២០ ដ្បិតយើងមិនអាចឈប់និយាយអំពីអ្វីដែលយើងបានឃើញ និងបាន ឮឡើយ ។
ស្ម័គ្រ ចិត្ត កាន់អាវុធ ហើយដោយហេតុនេះ ពួកគេបានចុះចូលក្រោមមេ រឹង
អ្នក ណាស្វែង រក អ្នក នោះនឹងឃើញ ហើយអ្នក ណាដែលគោះ ទ្វារនឹងត្រូវបើក ។
នៅ ពេល ដែល ផ្លែ ទំពាំងបាយជូ ត្រូវបាន ចុច សម្រាប់ ស្រា គ្រាប់ ពូជ នៃ ទំពាំងបាយជូ ត្រូវបាន ទុកចោល ។
វប្បធម៌ ឥណ្ឌូនេស៊ី ឬ អត់ ។
ហើយពួកគេបានត្រៀមខ្លួនជា ស្រេចដើម្បីសរសើរគាត់សម្រាប់ថ្ងៃនោះ !
នោះ នឹង ជា ពេលវេលា យំសោក សម្រាប់ អ្នក ដែល បាន ជ្រើសរើស ដូច្នេះ មនុស្ស ជាច្រើន នឹង ត្រូវ ស្លាប់ ។
ទិវាមនុស្សចាស់គឺជាថ្ងៃនៃ ការ គួរ សម
កុក និង ម៉ាកូក ។
ឈប់ សម្លឹងមើល មនុស្ស ដែល មើលងាយ អ្នក ។
ធ្វើ សម្រាប់ អ្នក ប៉ុន្តែ អ្វី ដែល អ្នក
គ្រប់ ពេលវេលា និង ត្រឹមត្រូវ ។
មុនពេល អ្នកស្លាប់ !
ទ្រង់នឹងមិនដោះលែងអ្នកឡើយ រហូតដល់អ្នកបានដង្វាយធួនសម្រាប់អំពើ បាបរបស់អ្នក ។
កិច្ចព្រមព្រៀង ជាមួយ សេចក្តីស្លាប់ និង សម្ព័ន្ធភាព ជាមួយ ឋាន នរក ។
គាំទ្រ៖ ទំហំ គឺ សមរម្យ សម្រាប់ ខ្ញុំ និង កូនស្រី របស់ ខ្ញុំ ។
គ្រប់ ទីកន្លែង ដែល នាង ទៅ នាង ក្លាយជា ចំណុច កណ្តាល នៃ ការយកចិត្តទុកដាក់ ។
យើងអាចទៅកន្លែងដែលយើងចង់បាន ។
យើងបានចំណាយពេលជាច្រើនម៉ោងដើម្បីអធិស្ឋាន ស្វែងរកព្រះអម្ចាស់ សិក្សាព្រះបន្ទូល រៀបចំផែនការ និង បន្ទាប់មក កត់ត្រា ( និងកត់ត្រាឡើងវិញ ) ពី មួយ ថ្ងៃទៅ មួយ ថ្ងៃព្រះបន្ទូលរបស់ព្រះ។
កុមារ ត្រូវ មាន ការត្រួតពិនិត្យ គ្រប់ ពេលវេលា ។
យើង ទាំងអស់ គ្នា ចង់ ដឹង ការពិត ។
មិន គ្រប់គ្រាន់ ដើម្បី បកស្រាយ អត្ថន័យ ប្រយោគ ។
ទៅ ស្អាត និង ងាយស្រួល ។
ហេតុ អ្វី បានជា គ្មាន នរណា ម្នាក់ ដឹង អ្វី អំពី ក្រុម ?
« ប៉ុន្តែ អ្នក បានបដិសេធព្រះ ដ៏បរិសុទ្ធ និងសុចរិត ហើយបានសុំឲ្យដោះលែងបុរសម្នាក់ដែលជាឃាតកឲ្យរួចខ្លួន » ។
35 រួចមាន ប្រសាសន៍ទៅពួកគេ ថា៖ « ជន ជាតិអ៊ីស្រា ‌ អែលអើយ ចូរពិចារណាឲ្យបានច្បាស់អំពីអ្វីដែលអ្នក រាល់គ្នានឹងធ្វើចំពោះ ជនទាំងនេះ
ព្រះគឺ ខ្លាំង ជាង អំណាច នៃ ភាពងងឹត គ្មាន ទីបញ្ចប់ ។
វា ធ្វើ តាម រឿង ដ៏ អស្ចារ្យ ជាច្រើន នៃ អំណាច របស់ ព្រះសម្រាប់ និង ប្រឆាំង នឹង រាស្ដ្រ របស់ ទ្រង់ នៅក្នុង គម្ពីរ សញ្ញា ចាស់ ដែល ផ្តល់ឱ្យ យើង នូវ គំរូល្អ និង គំរូ សម្រាប់ ការយល់ដឹង អំពី ប្រាជ្ញា ។
២៤ ក្រោយមក ខ្ញុំជឿជាក់លើព្រះហឫទ័យរបស់ព្រះអម្ចាស់ថា ខ្ញុំនឹងមកភ្លាមដែរ ។
ហើយមួយនេះក៏ត្រូវបានមនុស្សដដែលយកមកដែរ ។
មិនលើសពីដប់ ពីរថ្ងៃមុន ខ្ញុំបានឡើងទៅក្រុងយេរូសាឡិមដើម្បីថ្វាយបង្គំ ។
តូច ហ៊ាន និយាយ ។
នៅពេល ខ្ញុំ មាន អាយុ ដប់ ប្រាំបី ខ្ញុំ បាន ចុះឈ្មោះ ចូល កងទ័ព ។
ហើយ នៅ ពេល ដែល វា មកដល់ ការរៀបចំ សម្រាប់
ដោយ ពួកគេ បាន ឡើង ពី ផ្ទះ នៅលើ ដំបូល
ខ្ញុំបានជួបបុរសម្នាក់ដែលជឿជាក់ថាព្រះ មិនអាចអត់ទោសគាត់ចំពោះរឿងដែលគាត់បានធ្វើ ។
ខ្ញុំ បាន អត់ទោស ឱ្យ គាត់ ព្រោះ ខ្ញុំ យល់ ។
ប្រសិនបើអ្នករង់ចាំថ្ងៃ ណាមួយសម្រាប់អ្នក ដើម្បីក្រមួន និងមានច្រើនក្នុងជីវិត នោះគឺថ្ងៃនោះហើយ ។
... ” ចូរទៅខាងមុខហិប នៃព្រះ‌ អម្ចាស់ ជាព្រះ របស់អ្នក ចូលទៅកណ្តាលទន្លេយ័រ ដាន់ ។
ខ្ញុំ ចង់ រាំ រាំ ជាមួយ អ្នក
ខ្ញុំមិនខ្វល់ថាតើគេប្រហែលជាអាចទាញ វាចេញបានល្អជាងខ្ញុំទេ ។
ខ្ញុំនឹងមិនបូជាដល់ព្រះអម្ចាស់ ជាព្រះ របស់ខ្ញុំឡើយ ។
ចូរអង្វរ រកព្រះវរ បិតា » ។
ដំណើរការវា ឡើងវិញ បន្តិច គំនិត ?
ដូច្នេះ គេក្រាបនៅចំពោះទ្រង់ ។
« ប្រសិនបើ ពួកគេ ព្រួយបារម្ភ អំពី មនុស្ស ដែល រង់ចាំ ពួកគេ នឹង ត្រូវ តាមដាន ជានិច្ច ពី អ្វី ដែល ពួកគេ កំពុង ដោះស្រាយ នៅ ចំពោះមុខ ពួកគេ ។
មាន យានដ្ឋាន មួយ នៅ ចំហៀង ។
ខ្ញុំ ភ្ញាក់ផ្អើល ពេល ឃើញ អ្នក អង្គុយ នៅ ទីនោះ ។
ពួកគេ បី នាក់ បងប្អូន ។
នេះ ជា សាក្សី ប្រឆាំង នឹង ខ្ញុំ ។
៨ ការ បញ្ចុះបញ្ចូលបែបនោះមិនបានមកពីព្រះ ដែលហៅអ្នកនោះទេ ។
តើអ្នកដឹងថាគាត់បានធ្វើអ្វីនៅក្នុង សភាទេ ?
សូមប្រោសអ្នកជំងឺដែលនៅ ទីនោះជា សះស្បើយ ហើយប្រាប់ពួកគេថា ‹ ព្រះរាជាណាចក្ររបស់ព្រះ បានមកជិតអ្នកហើយ ›» ។
« ខ្ញុំនឹងឲ្យអ្នក នូវសំបុត្រមួយច្បាប់សម្រាប់ស្ដេចអ៊ីស្រាអែល » ។
លោកបាននិយាយថា៖ « នេះមិនមែននិយាយពីមនុស្សដែលកំពុងតែអស់សង្ឃឹមទេ ហើយយើងជាអ្នក ឲ្យខ្ចីជម្រើសចុងក្រោយ » ។
ពិតណាស់ គាត់បានយកខ្ញុំទៅផ្ទះភ្លាម ។
“ យើងត្រូវ ប្រជែងខ្លួនឯង ហើយប្រហែលជាត្រូវបង្កើតអ្វីមួយនៅថ្ងៃស្អែក ។
អ្នក នឹង ទទួលបាន រង្វាន់ ជាមួយនឹង សមិទ្ធិផល
« ខ្ញុំចង់ឲ្យអ្នក រាល់គ្នានិយាយភាសា ដទៃ ប៉ុន្តែខ្ញុំសូមឲ្យអ្នក រាល់គ្នាទាយជាជាង ។
« ដោយ សារអ្នកបានឃើញខ្ញុំ អ្នក បានជឿ ។ សូមប្រទាន ពរដល់អ្នកដែលមិនបានឃើញ ហើយមិនបានជឿ » ។
១៣ ក្រោយពីគេឈប់និយាយ លោកយ៉ាកុប តប ថា៖ « បងប្អូនអើយ ចូរស្ដាប់ខ្ញុំ ។
អ្នកបង្កើត សន្តិភាព មាន ពរ ។ ដ្បិតគេនឹងត្រូវហៅថាជាកូនរបស់ព្រះ» ។
ចូលចិត្ត យក ទឹក ផ្ទាល់ខ្លួន ។
ហើយ ដោយសារតែ អ្នក ស្គាល់ ខ្ញុំ ដូច ដែល អ្នក ស្គាល់ ខ្លួន ឯង
១៨ ខ្ញុំប្រាប់អ្នក ឥឡូវនេះថា អ្នកនឹងត្រូវវិនាស ជាប្រាកដ ។ អ្នកនឹងមិនមានអាយុវែងនៅលើទឹកដីដែលអ្នកឆ្លងទន្លេយ័រ ដាន់ដើម្បីចូលទៅ កាន់ កាប់នោះទេ ។
បើគ្មានពួកគេទេ ជីវិតនាពេលបច្ចុប្បន្ននេះនឹងមិនអាច ស្រមៃបានឡើយ ។
ជាលើក ទីបីដែលអារក្សនិយាយថា៖ « បួសចេញទៅ » ។
ធ្វើការ ជាមួយ ស្រទាប់ ។
២១ ប៉ុន្តែ អ្នក ណាដែល រស់នៅតាមសេចក្ដី ពិត មករកពន្លឺ ដើម្បីឲ្យកិច្ចការរបស់ខ្លួនបានត្រូវសម្ដែងដោយព្រះ។
គាត់ បាន ប្រាប់ មិត្ត របស់ គាត់ អំពី ខ្ញុំ ។
អ្នក ណាលោភៈ អ្នក ណាប្រាថ្នាចង់បានទ្រព្យ សម្បត្តិ ហើយរក្សាទ្រព្យដែលខ្លួន រក ?
( ប្រសិនបើគាត់បែរមកលើទ្រូង គាត់ត្រូវបានរមៀល មកលើចង្កេះវិញ ) ។
ហើយខ្ញុំបាននិយាយថា ៖ សូមស្តាប់ចុះ ខ្ញុំសូមអង្វរអ្នក រាល់គ្នាជាប្រមុខយ៉ាកុប និង ជាអ្នកគ្រប់គ្រងនៃ វង្សអ៊ីស្រាអែល ។ តើអ្នក រាល់គ្នាមិនស្គាល់យុត្តិធម៌ទេឬ ?
ត្រលប់ មកវិញ ហើយ ទុកសារ ។
4/ គាត់ គឺជា ថ្ម ការងារ របស់ គាត់ គឺ ល្អ ឥត ខ្ចោះ ។ ដ្បិត គ្រប់ ទាំង ផ្លូវ របស់ ទ្រង់ គឺជា យុត្តិធម៍ ជា ព្រះនៃ សេចក្តីពិត និង គ្មាន ភាពអយុត្តិធម៌ ។ ទ្រង់សុចរិតនិងទៀង ត្រង់ ។
វាគឺជាការឆ បោក ហើយពួកគេកំពុងកេង ចំណេញពីមនុស្សចាស់ » ។
ព្រះ របស់លោកម៉ូសេ ជាព្រះ របស់អ្នក !
ខ្ញុំ អាច ជួយ អ្នក បាន៖
បើអត់ទេ ដេវីនត្រៀមទៅហើយ » ។
ជញ្ជាំង ដែល អាច មើលឃើញ យ៉ាង ច្បាស់ ។
ចូរ ចាំ ថា ទេវតា មិន ត្រូវ ថ្វាយបង្គំ ឡើយ ។
ហើយ នៅ ទីតាំង ងាយស្រួល ។
ត្រឡប់ ទៅ ពន្ធដារ វិញ ។
កុំបះបោរប្រឆាំងនឹងលោកហាសេម ហើយអ្នកនឹងមិនខ្លាចប្រជាជនក្នុងស្រុកឡើយ » ។
ការពិត នេះ មាន ន័យ ថា វា ពិតជា អាច ទៅ រួច ក្នុង ការធ្វើ អ្វី មួយ ដូចជា
ព្រះ បានធ្វើដូចគ្នានេះសម្រាប់កូនចៅអ៊ីស្រាអែល ពេលទ្រង់ព្រមានពួកគេថា ចិត្តរបស់ព្រះចៅផារ៉ោននឹងរឹងមាំ ហើយផារ៉ោននឹងព្យាយាម « ហួស ពីព្រះ» ។
គាត់ នឹង ក្លាយជា របាំង ចុងក្រោយ ប្រឆាំង នឹង ព្រះ។
ចូរលើក ត ម្កើងព្រះអម្ចាស់ ជាព្រះ នៃយើង ។
ប្រាកដជាថាការ ជក់បារីមិនល្អសម្រាប់អ្នកទេ ប៉ុន្តែចុះអ្នកផឹកច្រើន ឬអ្នកញ៉ាំច្រើន
បន្ទាប់មក គាត់ បាន សុំ នាង ទៅ ពិធី ជប់លៀង ហើយ នាង ក៏ ទទួលយក ម្តង ទៀត ។
រស់ នៅ ដោយ សប្បាយរីករាយ និង មាន កូន ច្រើន ។
អ្នកដែលត្រឹមត្រូវគឺអ្នកដោះស្រាយបញ្ហារបស់មនុស្ស
ខ្ញុំ ចង់ ក្លាយជា មនុស្ស តូចតាច ។
នាងប្រាកដជាមិនដែលឃើញបុរសនេះទេ ។
ញ៉ាំ ជាតិ សរសៃ ច្រើន ជាមួយ អាហារ ។
ខ្ញុំនឹងបាត់ពេលជាច្រើនជាមួយប្រពន្ធ និងកូនស្រីរបស់ខ្ញុំ ។
« កុំធ្វើ បាបផែនដី ឬសមុទ្រ ឬដើមឈើឡើយ រហូតដល់យើងបានបិទ ត្រាអ្នក បម្រើនៃព្រះ នៃយើងនៅលើថ្ងាសរបស់ពួកគេ » ។
មួយ ឆ្នាំ ក្រោយមក អ្នក ទាំង ពីរ បាន ជួបគ្នា ម្តង ទៀត ។
នៅ ពេល ដែល ខ្ញុំ ចង់បាន អ្វី ដែល ប្លែក ។
ខ្ញុំ រំភើប ហើយ ទន្ទឹងរង់ចាំ ធ្វើការ ជាមួយ អ្នក !
វា ហាក់ដូចជា គាត់ ចូលចិត្ត ផ្លាស់ប្តូរ ព័ត៌មាន លម្អិត តិចតួច ។
ទេវតាបានប្រកាសថា៖ « សូមលើក ត ម្កើងព្រះ នៅស្ថានដ៏ខ្ពស់បំផុត ហើយនៅលើផែនដីនេះមានសេចក្ដី សុខសាន្ត មាន ចិត្តសប្បុរសចំពោះមនុស្ស » ។
ហើយគាត់បាននិយាយថា៖ « វាជាការ លើកលែងចំពោះអ្វីដែលបានកើតឡើងក្នុងការ ជួបជុំនោះ » ។
បាន សង្គ្រោះ ពួកគេ ពី ការបំផ្លាញ ។
ហើយ នាំខ្ញុំទៅក្នុងផ្លូវនៃជីវិតដ៏អស់ កល្ប ជានិច្ច ។
ប្រយ័ត្ន ក្នុង គ្រប់ យ៉ាង ។
« យើងមិនអាចឡើងទៅវាយប្រជាជនបានទេ ព្រោះគេខ្លាំងជាងយើង ។
៧ បុរសនោះក្រោកឡើងទៅផ្ទះ ។
ទោះ យ៉ាងណា ក៏ដោយ វា នៅតែ ស្ថិត ក្នុង ការសាកល្បង បេតា ។
នេះ ជា អ្វី ដែល អ្នក នឹង ឃើញ នៅ ក្រោម តំណភ្ជាប់ ទៅ ខាង ស្តាំ៖
២៩ ប៉ុន្តែ អ្នក ណាដែលនៅទីស្ងាត់កំបាំងជា សាសន៍យូដា ។ ហើយ ការកាត់ ស្បែក គឺជា បេះដូង ខាង វិញ្ញាណ មិន មែន នៅក្នុង សំបុត្រ នោះ ទេ ។ ការ សរសើរមិនមែនមកពីមនុស្សទេ គឺ មកពីព្រះ។
តាមការសន្និដ្ឋានថា ទង្វើនៃការ គោរពទាំងនេះគឺជាការ ពិត ។
៣ ពេលនោះ ភ្នែកអ្នកដែលអាចមើលឃើញនឹងមិនងាកចេញឡើយ
សួរថា៖ « តើសត្វមានជីវិតមួយក្នុងចំណោមទេវតាទាំងបួននិយាយអ្វីទៅ កាន់ យ៉ូហាន ពេល ត្រាទីមួយត្រូវបានបើក ?
គម្រោង និង គំនិត ផ្សេង ទៀត របស់ គាត់ នៅ ពេល នេះ រួម មាន បណ្តាញ ឧបករណ៍ វេជ្ជសាស្ត្រ និង ទីផ្សារ សេវាកម្ម ដែល គ្មាន ការកកិត ។
ភ្នែកដែលមិនស្ងប់ ចិត្តរបស់គាត់ត្រូវបានជួសជុល ប៉ុន្តែគាត់នៅឆ្ងាយជាងជើង មេឃ ។
អ្នក ណាដែលមានគុណធម៌ដែលមិនរើសមុខបានក្បត់អ្នក
២៤ ហើយអ្នកខ្លះបានជឿតាមអ្វីដែលគាត់បាននិយាយ ឯអ្នកខ្លះទៀតមិនជឿ ។
ចាក់ក្នុងទឹកស្ងោរជាមួយផ្លែ ឈើផ្សេង ៗ គ្រឿងទេសដូចជា cinnamon និងកំបោរ វាជាភេសជ្ជៈផ្តល់ ភាពស្រស់ស្រាយប្រចាំ ថ្ងៃ ។
មួយ ណាល្អជាងមួយ ប៉ុន្តែមិនល្អជាងមួយទៀត » ។
វា អាស្រ័យ លើ លោក អូបាម៉ា
ដូច្នេះ អ្នក ត្រូវ ញ៉ាំ តិច ជាង អ្នក ដុត ។
កាលពីប៉ុន្មានឆ្នាំមុន ខ្ញុំបាន សន្យាថាខ្ញុំនឹងទាញនាងចូល រទេះដើម្បីមើលសមុទ្រ ដូច្នេះឥឡូវនេះ ខ្ញុំគោរពការសន្យារបស់ខ្ញុំ » ។
យើងបានរកឃើញខ្លួនយើងនិយាយជាច្រើនម៉ោងដោយមិនដឹងថាវា។
ប្រសិនបើ ពួកគេ ព្យាយាម រក ប្រាក់ ពី ទ្រព្យសម្បត្តិ របស់ ពួកគេ នោះ តម្លៃ នៃ ទ្រព្យសម្បត្តិ របស់ ពួកគេ នឹង ធ្លាក់ចុះ ។
ប្រជាជនពឹងផ្អែកលើគាត់ដើម្បីព្យាបាលជំងឺរបស់ពួកគេ ។
ពិតណាស់គ្មាននរណាដឹងថាតើចិន - អាមេរិកនៅពេលណា ? សង្គ្រាម ពាណិជ្ជកម្ម នឹង បញ្ចប់ ជា ផ្លូវការ ។
វា មាន ន័យ ថា ធ្វើ ដូចជា ព្រះ។
ឈ្មោះ របស់ ខ្ញុំ គឺ ច្រើន ជាង
នេះ គឺជា លទ្ធផល ដែល គាត់ ត្រូវបាន គេ ជួល ។
អ្នកដែលបង្កើតសន្តិភាព អ្នកនោះមានសុភមង្គលហើយ ព្រោះគេនឹងហៅថាជាកូនរបស់ព្រះ។
មាន ពរ ហើយ អ្នកបង្កើត សន្តិភាព៖ ពួកគេ នឹង ត្រូវបាន គេ ហៅ ថា ជា ព្រះរាជ បុត្រា នៃ ព្រះ!
ចុះ អ្នក ទាំងអស់ គ្នា វិញ សមាជិក ថ្មី នៅ ទីនេះ ។
គាត់ដេកនៅមុខវាលស្មៅ ហើយប្រកាច់ដោយការ ឈឺចាប់
នៅ អាយុ របស់ ខ្ញុំ អ្វី ដែល សំខាន់ បំផុត សម្រាប់ ខ្ញុំ ហើយ អ្វី ដែល ខ្ញុំ ចង់ ធ្វើ គឺ ការលេង ។
ដូចជាដើមឈើ អំពើអាក្រក់នឹងត្រូវបំផ្លាញ ។
ខ្ញុំមិនបានដឹងថា ម្តាយរបស់អ្នកបានស្លាប់ផងដែរ ។
គាត់បានប្រកាសសង្គ្រាមលើប្រទេសយើង » ។
ហើយ សម្រាក ពី អាពាហ៍ពិពាហ៍ ដែល ដួលរលំ ។
១៩ ខ្ញុំ ប៉ូល បាន សរសេរ វា ដោយ ដៃ របស់ ខ្ញុំ ផ្ទាល់ ។ ខ្ញុំនឹង តបស្នង វិញ ដោយខ្ញុំមិនប្រាប់អ្នក ថា អ្នកជំពាក់ខ្ញុំផ្ទាល់ដែរ ។
« ប៉ូលជាអ្នកជាប់ឃុំបានទូរស័ព្ទមកខ្ញុំ ហើយសុំឲ្យខ្ញុំនាំយុវជននេះមក ឯអ្នក ដូចជាគាត់មានរឿងចង់និយាយទៅ កាន់អ្នក » ។
វា អាច ជា អាកប្បកិរិយា របស់ មនុស្ស ?
ប្រាក់ កម្ចី ដែល ត្រូវបាន ផ្តល់ឱ្យ ព្រះអម្ចាស់ ។
៣ ដោយពោលថា កុំធ្វើ បាបដី ឬសមុទ្រ ឬដើមឈើឡើយ រហូតដល់យើងបានបិទ ត្រាអ្នក បម្រើនៃព្រះ នៃយើងនៅលើថ្ងាសរបស់ពួកគេ ។
ប្រសិនបើ អ្នក ក្រឡេក មើល ទម្រង់ និង រចនាសម្ព័ន្ធ របស់ វា
ពួកគេ បាន គំរាម ជីវិត របស់ គាត់
សូមព្រះអម្ចាស់គង់ជាមួយនឹងអ្នក ដូចព្រះអង្គបានគង់នៅ ជាមួយនឹងបិតារបស់ខ្ញុំដែរ ។
ទល់ មុខ គ្នា ភ្នែក មិន ព្រិច ភ្នែក
សម្លាប់អ្នកដែលហ៊ានបង្កបញ្ហា ហើយឆ្លៀតឱកាស វឹកវរ ។
ពេល ខ្លះមនុស្សទាំង ពីរអាចនិយាយភាសាដូចគ្នា ហើយនៅតែមិនយល់ពាក្យគ្នាទៅ វិញ ទៅ មក។
ស្ថាប័ន របស់ យើង មិន អាច តំណាង ឱ្យ ពិភពលោក របស់ យើង បាន ទេ ប្រសិនបើ ពួកគេ មិន ផ្តល់ សំឡេង ដល់ ទ្វីប អាហ្រ្វិក ដែល មាន សមាជិក ច្រើន ជាង មួយ ភាគ បួន នៃ អង្គការ សហ ប្រជាជាតិ ឬ ប្រទេស ប្រជាធិបតេយ្យ ដ៏ ធំ បំផុត របស់ ពិភពលោក ដែល មាន មនុស្សជាតិ មួយ ភាគ ប្រាំមួយ ។
« តើរឿងនេះអាចកើតឡើងក្នុងស្ថានទូតដោយរបៀបណា ?
យើងបានរៀបការ តាំងពីឆ្នាំ ២០០៧ ដោយគ្មានកូន ។
កូនមនុស្សពោរពេញទៅដោយអំពើអាក្រក់ ហើយ ភាពឆ្កួតក៏នៅក្នុង ចិត្តដែរ ។
តណ្ហាខាងសាច់ឈាម ដោយការ លោភលន់ជាច្រើន អស់អ្នកដែលស្អាតស្អំបានរួចខ្លួន
« ពេលចូលដល់ផ្ទះ ណាមួយ ត្រូវនិយាយជាដំបូងថា « ផ្ទះនេះមានសន្តិភាព » ។
ដូច្នេះកុំញ៉ាំអាហារជាមួយបុរសនោះ។
យើង បាន ថ្វាយបង្គំ ។
« ដូច្នេះ ពួកគេបាននិយាយព្រះបន្ទូលរបស់ព្រះអម្ចាស់ដល់គាត់ និងដល់អ្នក រាល់គ្នាក្នុងផ្ទះរបស់គាត់ ។
នោះ កំពុង មាន កំហុស ។
ប្រសិនបើ យើង ព្រងើយ កន្តើយ នឹង ស្ថានភាព ជនជាតិ នេប៉ាល់ របស់ យើង ខ្ញុំ មិន មាន អ្វី ត្រូវ និយាយ ទេ ។
ឬដូចដែលប៉ុលបានសរសេរថា ៖ ដូច្នេះ បងប្អូនជាទី ស្រឡាញ់អើយ ចូរឈរឲ្យមាំ មួន ។
១២ ពេលនោះ ក្រុមជំនុំទាំងអស់ឆ្លើយយ៉ាងខ្លាំង ថា៖ « យើងត្រូវ តែធ្វើតាមដែលលោកបានមាន ប្រសាសន៍អំពីយើង ។
