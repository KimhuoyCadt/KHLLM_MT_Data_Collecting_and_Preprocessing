( ភ្នំពេញ ) ៖ កន្លងមក ពលរដ្ឋ ខ្មែរ ធ្លាប់ តែ ស្ញប់ស្ញែង ចំពោះ ឯក អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ កម្ពុជា ដែល មាន សមត្ថភាព និយាយ ភាសា ខ្មែរ យ៉ាង ស្ទាត់ ពេល បំពេញ ការងារ នៅ កម្ពុជា ។ ប៉ុន្តែ ពេលនេះ មាន ឯក អគ្គ រដ្ឋទូត របស់ រុស្ស៉ី ម្នាក់ ទៀត ក៏ ចេះ និយាយ ភាសា ខ្មែរ យ៉ាង ច្បាស់លាស់ ផងដែរ ។
លោក Anatoly Borovik ឯក អគ្គ រដ្ឋទូត ថ្មី របស់ សហព័ន្ធ រុស្ស៉ី ប្រចាំ នៅ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០ ពេល អញ្ជើញ ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៅ ទីស្តីការ ក្រសួង ការបរទេស បាន និយាយ ភាសា ខ្មែរ យ៉ាង ច្បាស់ ។
ការ និយាយ ភាសា ខ្មែរ យ៉ាង ច្បាស់ របស់ លោក Borovik ធ្វើឲ្យ ប្រមុខ ការទូត មន្ត្រី ការទូត ខ្មែរ ជាពិសេស ក្រុម អ្នកសារព័ត៌មាន មាន ការចាប់អារម្មណ៍ យ៉ាង ខ្លាំង ។ សម្រាប់ ក្រុម អ្នកសារព័ត៌មាន ប្រចាំ ក្រសួង ការបរទេស បាន លើកឡើង ស្រដៀង គ្នា ថា ក្រៅពី ឯក អគ្គ រដ្ឋទូត ជប៉ុន ពួកគេ មិន ដែល ឃើញ ឯក អគ្គ រដ្ឋទូត រុស្ស៉ី រូប ណា និយាយ ភាសា ខ្មែរ បែប នេះ ឡើយ ។
ការ ដែល លោក ឯក អគ្គ រដ្ឋទូត រុស្ស៉ី អាច និយាយ ភាសា ខ្មែរ បាន នេះ ដោយសារតែ រូប លោក ធ្លាប់ បាន មក ធ្វើការ នៅ កម្ពុជា តាំងពី ទសវត្សរ៍ ឆ្នាំ ៨០ ហើយក៏ ធ្លាប់ បាន រៀន អក្សរសាស្ត្រ ខ្មែរ ផងដែរ ។
នៅ ជុំវិញ បញ្ហា ភ្លើង ឆេះ ព្រៃ ខាងលើ អាជ្ញាធរ តំបន់ Sonoma បាន គូសបញ្ជាក់ ថា « យើង បាន ណែនាំឲ្យ មាន ការជម្លៀស ប្រជាជន សា ជា ថ្មី ជាពិសេស នៅ តាម តំបន់ ដែល យើង មិន អាច គ្រប់គ្រង បាន ខណៈ ដែល មនុស្ស ០៥ នាក់ ត្រូវបាន ចាប់ខ្លួន ក្រោយ ពួកគេ បន្ត ស្ថិត ក្នុង តំបន់ ដែល តម្រូវឲ្យ មាន ការជម្លៀស ខ្លួន ដោយ គ្មាន ការអនុញ្ញាត ។
រហូតមកទល់ ពេលនេះ អគារ សរុប ចំនួន ១១៥ ខ្នង ក្នុង នោះ រួម មាន ទាំង ផ្ទះ ចំនួន ៨០ ខ្នង និង កន្លែង ផលិត ស្រា ក្រហម មួយ ចំនួន ត្រូវបាន បំផ្លាញ ហើយ មនុស្ស ជាង ២២.០០០ នាក់ កំពុង រង ការគំរាមកំហែង ដោយសារតែ អណ្តាត ភ្លើង ដែល កំពុង ឆាបឆេះ កាន់តែ ខ្លាំង នៅ ភាគ ខាងជើង នៃ រដ្ឋ កាលីហ្វ័រញ៉ា ។
គួរ បញ្ជាក់ ថា ទីភ្នាក់ងារ ព្យាករណ៍ អាកាសធាតុ នៃ រដ្ឋ កាលីហ្វ័រញ៉ា បាន ប្រកាស ពី កម្រិត អាសន្ន ពណ៌ ក្រហម អំពី គ្រោះថ្នាក់ នៃ ឆ្លើង ឆេះ ព្រៃ នៅ តាម តំបន់ ឆ្នេរសមុទ្រ ភាគ ខាងជើង និង តំបន់ ជុំវិញ នោះ ចាប់ផ្តើម ពី រសៀល ថ្ងៃព្រហស្បតិ៍ ( ពេលវេលា នៅ អាមេរិក ) ។ ទន្ទឹម គ្នា នេះ អាជ្ញាធរ រដ្ឋ កាលីហ្វ័រញ៉ា ក៏ បាន ព្រមាន ពី ការធ្លាក់ចុះ នៃ គុណ ខ្យល់ បង្កឡើង ដោយ ផ្សែង ភ្លើង ឆេះ ព្រៃ ដែល អាច ប៉ះពាល់ ដល់ សុខភាព ផងដែរ ៕
អំពូលភ្លើង ជាង ៥០០ ត្រូវ អាជ្ញាធរ បំពាក់ នៅ តាម ផ្លូវ សាធារណៈ ក្នុង ទីប្រជុំជន ក្រុង ស្វាយរៀង ដើម្បី សោភ័ណភាព ទីក្រុង
( ស្វាយរៀង ) ៖ អំពូលភ្លើង ថ្មី សម្រាប់ បំភ្លឺ ផ្លូវ ជាង ៥០០ អំពូល នៅ ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០ នេះ ត្រូវបាន អាជ្ញាធរ ខេត្ត ស្វាយរៀង បាន យកមក បំពាក់ នៅ តាម ផ្លូវ សាធារណៈ ក្នុង ទីប្រជុំជន ក្រុង ស្វាយរៀង ដើម្បី សោភ័ណភាព ទីក្រុង ។
ការដាក់ អំពូលភ្លើង ថ្មី នេះ គឺ ជំនួស អំពូលភ្លើង ចាស់ ៗ មួយចំនួន ដែល ដាច់ដោយ កន្លែង ក្រោយ ប្រើប្រាស់ យូរ ឆ្នាំ ជាពិសេស អំពូលភ្លើង ថ្មី ជាង ៥០០ អំពូល នេះ ក៏ មាន រៀបចំ ដាក់ នៅ ទីប្រជុំជន ផ្សារ ក្រោល គោ និង ទីប្រជុំជន ផ្សារ ស្វាយ ជ្រំ ផងដែរ ។
មន្ត្រី ដដែល បាន បន្ត ថា ដើម្បីឱ្យ សោភ័ណភាព ក្រុង ស្វាយរៀង ក៏ ដូចជា តាម បណ្តា ក្រុង ស្រុក ដទៃ ទៀត មាន ភ្លើង បំភ្លឺ ផ្លូវ សាធារណៈ នៅពេល រាត្រី លោក អភិបាល ខេត្ត តែងតែ ខិតខំ រិះរក គ្រប់ មធ្យោបាយ នានា ន ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ មាន ភ្លើង បំភ្លឺ ផ្លូវ ជា បន្តបន្ទាប់ ដើម្បី ចូលរួម ប្រឡង ប្រណាំង ទីក្រុង ស្អាត ៕
( ភ្នំពេញ ) ៖ លោក គង់ វិបុល ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៅ ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន គូសបញ្ជាក់ ថា ពន្ធ លើ ចំណេញ មូលធន មិន មែន បង្កើត សម្រាប់ សង្កត់ .ក រាស្ត្រ ទេ តែ ផ្ទុយទៅវិញ ពន្ធ នេះ នឹង ជួយ ពលរដ្ឋ ក្រីក្រ ។
ការគូសបញ្ជាក់ បែប នេះ របស់ លោក គង់ វិបុល ធ្វើឡើង ក្នុង កម្មវិធី « ពន្ធដារ កម្ពុជា » ស្តីពី ពន្ធ លើ ចំណេញ មូលធន ដែល រៀបចំឡើង ដោយ អគ្គ នាយកដ្ឋាន ពន្ធដារ នា ព្រឹក ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០ នេះ ។
បើ តាម អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន ឲ្យដឹង ថា ពន្ធ លើ ចំណេញ មូលធន ដែល មាន អត្ថប្រយោជន៍ សម្រាប់ ប្រជាពលរដ្ឋ ក្រក្រី ក៏ ដូចជា សម្រាប់ យក ទៅ អភិវឌ្ឍន៍ ជនបទ ធ្វើ ផ្លូវ ធ្វើអណ្ដូង ទឹក និង ស្រះ ទឹក ជាដើម ។
ពាក់ព័ន្ធ នឹង ការលើកឡើង ថា ពន្ធ នេះ បង្កើតឡើង ដើម្បី សង្កត់ .ក រាស្ត្រ ត្រូវបាន លោក គង់ វិបុល ប្រាប់ ថា ជា ការលើកឡើង ភ័ន្ដច្រឡំ ថា គ្រប់ ប្រជាពលរដ្ឋ ដែល មាន អចលន ទ្រព្យ ត្រូវតែ ជាប់ ពន្ធ ប៉ុន្ដែ មិន ដូច្នេះ ទេ លុះត្រាតែ លក់ ហើយ លក់ ចំណេញ ទៀត បាន ជាប់ ពន្ធ នេះ ។
បន្ថែម ពី នេះ ទៀត លោក គង់ វិបុល បាន គូសបញ្ជាក់ ថា ពន្ធ លើ ចំណេញ មូលធន បើ ប្រៀបធៀប ជាមួយ ប្រទេស ដទៃ ទៀត ប្រទេស កម្ពុជា មាន ភាពអនុគ្រោះ ពន្ធ នេះ ខ្ពស់ ជាង គេ ។
លោក គង់ វិបុល បាន ឲ្យដឹង ទៀត ថា ពន្ធ ពី ចំណេញ មូលធន នេះ រាជ រដ្ឋាភិបាល យកមក ជួយ កម្មករ រាប់ សែន នាក់ ដែល ជួប ការលំបាក និង ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ក្រីក្រ និង យក ទៅ ថែទាំ ហេដ្ឋារចនាសម្ព័ន្ធ មួយ ចំនួន ។
ជាមួយគ្នា នោះ លោក គង់ វិបុល ក៏ បាន បញ្ជាក់ ឲ្យដឹង ផងដែរ ទៅ ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០២១ ខាងមុខ នេះ អគ្គ នាយកដ្ឋាន ពន្ធដារ នឹង ចាប់ផ្ដើម អនុវត្ដ លើ ពន្ធ ចំណេញ មូលធន នេះ លើកលែងតែ មាន ការប្រែប្រួល តាម ការសម្រេច ណាមួយ របស់ រាជ រដ្ឋាភិបាល តាមរយៈ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
បើ តាម លោក វ៉ាន់ ពុទ្ធិពល អនុ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ឲ្យដឹង ថា អ្នក ដែល បង់ ពន្ធ នេះ ច្រើន ជាង គេ ៩០ ភាគរយ គឺ អ្នក ដែល មាន របរ អាជីវកម្ម ទៅ លើ ខាង ផ្នែក អចលន ទ្រព្យ ប៉ុន្ដែ ចំពោះ ប្រជាជន ទូទៅ មិន ជាប់ នោះ ទេ បើសិនជា មិន មាន ការលក់ អចលន ទ្រព្យ ហើយ ជាប់ ពន្ធ លុះត្រាតែ លក់ ចំណេញ ៕ កម្ពុជា - សឹង្ហ បូរី បើក កិច្ចពិភាក្សា លើ សេចក្តីព្រាង កិច្ចព្រមព្រៀង ក្របខ័ណ្ឌ អភិវឌ្ឍ កន្លែង ស្តុក ទំនិញ នៅ រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នៅ ព្រឹក ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ គណៈប្រតិភូ ចូលរួម កិច្ចប្រជុំ រវាង មន្ត្រី ជាន់ ខ្ពស់ កម្ពុជា និង សឹង្ហ បូរី តាម ប្រព័ន្ធ វីដេអូ ពី ចម្ងាយ ពិភាក្សា លើ សេចក្តីព្រាង កិច្ចព្រមព្រៀង ក្របខ័ណ្ឌ សម្រាប់ អភិវឌ្ឍ មជ្ឈមណ្ឌល ភស្តុភារកម្ម ភ្នំពេញ ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ពី ថ្នាក់ នាំ ជាន់ ខ្ពស់ នៃ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ របស់ ប្រទេស ទាំង ពីរ រួមទាំង ថ្នាក់ដឹកនាំ ក្រុមហ៊ុន YCH និង ក្រុមហ៊ុន IA ក្នុង គោលបំណង ពិភាក្សា លើ សេចក្តីព្រាង កិច្ចព្រមព្រៀង ក្របខណ្ឌ ក៏ ដូចជា ប្រមូល ធាតុ ចូល បន្ថែម ពី គ្រប់ ស្ថាប័ន ពាក់ព័ន្ធ សំដៅ ឱ្យ កិច្ចព្រមព្រៀង នេះ មាន ខ្លឹមសារជា គតិយុត្តិ គ្រប់ ជ្រុងជ្រោយ អាច ទទួលយក បាន ពី គ្រប់ ភាគី ជាពិសេស បម្រើ ឱ្យ ប្រយោជន៍ ជាតិ ជា រួម ស្រប តាម ចក្ខុវិស័យ វែងឆ្ងាយ របស់ រាជ រដ្ឋាភិបាល ។
លោក ទេសរដ្ឋមន្ត្រី បាន បន្ត ថា ដើម្បី ជំរុញ ឱ្យ គម្រោង នេះ មាន ដំណើរការ កាន់តែ រលូន និង ឆ្ពោះទៅ មុខ ។ តាម ផែនការ ក្រសួង កំពុង ស្វែងរក ដៃគូ អភិវឌ្ឍន៍ ហើយ ធ្វើ របាយការណ៍ ជូន ថ្នាក់ដឹកនាំ ដើម្បី ទទួលបាន ការណែនាំ និង ចង្អុលបង្ហាញ បន្ថែម មុន ចាប់ផ្តើម កិច្ចប្រជុំ លើក ក្រោយ ។
សូម បញ្ជាក់ ថា មជ្ឈមណ្ឌល ភស្តុភារកម្ម គឺជា កន្លែង ស្តុក ទុក ទំនិញ ដែល ទុក សម្រាប់ ការចែកចាយ ទំនិញ នៅក្នុង ប្រទេស និង បន្ត ចែកចាយ ទៅ ក្រៅ ប្រទេស ផ្សេង ៗ និង ជា កន្លែង ទុក សម្រាប់ ប្រមូលផ្តុំ ការស្តុក ទុក ទំនិញ ពី ប្រទេស ក្រៅ ដើម្បី បង្កើត ភាពងាយស្រួល ក្នុង ការចែកចាយ ទៅកាន់ ប្រទេស ផ្សេង ៗ ទៀត ផងដែរ ៕
រដ្ឋបាល ខេត្ត ក្រចេះ ប្រគល់ បណ្ណ កម្មសិទ្ធិ កាន់កាប់ ដី ជូន ពលរដ្ឋ ចំនួន ៦៩១ ក្បាល ដី នៅ ស្រុក ចិត្ត បុរី
( ក្រចេះ ) ៖ រដ្ឋបាល ខេត្ត ក្រចេះ នៅ ថ្ងៃទី ១ ខែតុលា ឆ្នាំ ២០២០ នេះ ប្រគល់ បណ្ណ កម្មសិទ្ធិ សម្គាល់ ម្ចាស់ អចលន វត្ថុ ជូន ជូន ប្រជាជន នៅ ភូមិ បន្ទាយ ឃុំ គោលាប់ ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ចំនួន ៦៩១ ក្បាល ដី ក្រោម អធិបតីភាព លោក វ៉ា ថន អភិបាល ខេត្ត ។
លោក វ៉ា ថន បាន ថ្លែង ថា ក្រោម ការដឹកនាំ ប្រកបដោយ ស្មារតី ស្នេហាជាតិ មាតុភូមិ និង ស្រឡាញ់ ប្រជាពលរដ្ឋ ប្រមុខ រាជ រដ្ឋាភិបាល បាន ធ្វើ កំណែទម្រង់ ដីធ្លី ដោយ ក្នុង នោះ រាជ រដ្ឋាភិបាល បាន ធ្វើ យុទ្ធនាការ ចុះ វាស់វែង ដីធ្លី ដើម្បី ធ្វើ ការចុះបញ្ជី និង ចេញ បណ្ណ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ពាក់ព័ន្ធ នឹង ដី ដែល ប្រជាពលរដ្ឋ កាន់កាប់ ជាក់ស្តែង ហើយ ពុំ ទាន់ មាន មូលដ្ឋាន ច្បាស់លាស់ ។
( ភ្នំពេញ ) ៖ ប្រព័ន្ធ ស្វ័យប្រវត្តកម្ម ផ្ទេរ កម្មសិទ្ធិ រថយន្ត ដែល អនុញ្ញាតឱ្យ ម្ចាស់ រថយន្ត ស្នើសុំ ផ្ទេរ កម្មសិទ្ធិ តាម ប្រព័ន្ធ អនឡាញ ត្រូវបាន ប្រកាស ដាក់ ឱ្យ ដំណើរ ហើយ នៅ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០២០ ។
ការផ្ទេរ កម្មសិទ្ធិ រថយន្ត ត្រូវបាន គេ មើល ថា មាន បញ្ហា ស្មុគស្មាញ ច្រើន ព្រោះតែ នីតិវិធី ការ នៃ ការផ្ទេរ ។ ការលំបាក នេះ បាន នាំឱ្យ ការទិញ លក់ រថយន្ត មួយចំនួន មិន មាន ការផ្ទេរ កម្មសិទ្ធិ រវាង ម្ចាស់ រថយន្ត ចាស់ ទៅ ម្ចាស់ រថយន្ត ទិញ បន្ត នោះ ឡើយ ។ ការទិញ លក់ រថយន្ត ដោយ មិន ផ្ទេរ កម្មសិទ្ធិ នេះ ក៏ បាន បង្ក ទៅជា បញ្ហា ស្មុគស្មាញ ច្រើន ផងដែរ ពេល ដែល រថយន្ត នោះ មាន បញ្ហា ពាក់ព័ន្ធ នឹង ផ្លូវ ច្បាប់ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ថ្លែង ថា ប្រព័ន្ធ ស្វ័យប្រវត្តកម្ម ផ្ទេរ កម្មសិទ្ធិ រថយន្ត នេះ នឹង ផ្តល់ ភាពងាយស្រួល លើ ការងារ គ្រប់គ្រង យានជំនិះ គ្រប់ ប្រភេទ នៅ កម្ពុជា ផ្តល់ កម្មសិទ្ធិ ស្រប ច្បាប់ ជូន ម្ចាស់ យានជំនិះ ព្រមទាំង រួមចំណែក ក្នុង ការប្រមូល ប្រាក់ ពន្ធ អាករ ធានា ឱ្យ បាន នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ សុវត្ថិភាព សង្គម និង ទប់ស្កាត់ ការក្លែងបន្លំ ផ្សេង ៗ ឱ្យ មាន ប្រសិទ្ធិភាព ។
លោក រដ្ឋមន្ត្រី បន្ថែម ថា តាមរយៈ កំណែទម្រង់ តាម ប្រព័ន្ធ បច្ចេកវិទ្យា ឌីជីថល ប្រជាពលរដ្ឋ នឹង កាន់តែ មាន ភាពងាយស្រួល និង អាច មក ទទួល សេវា សាធារណៈ ប្រកបដោយ តម្លាភាព ប្រសិទ្ធិភាព និង គណនេយ្យភាព ។
លោក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន គូសបញ្ជាក់ ថា ប្រព័ន្ធ ស្វ័យប្រវត្តិកម្ម ផ្ទេរ កម្មសិទ្ធិ យានជំនិះ អាច ចូលរួម កាត់បន្ថយ ភាពស្មុគស្មាញ ដល់ ប្រជាពលរដ្ឋ ដែល មក ទទួល សេវា សាធារណៈ ពី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ដើម្បី ផ្តល់ សេវា ឱ្យ បាន ទាន់ ពេលវេលា កាត់បន្ថយ ការចំណាយ ផ្លូវការ ផ្សេង ៗ ដោយ ប្រព័ន្ធ ស្វ័យប្រវត្តិកម្ម នេះ បាន កំណត់ តម្លៃ រួច ជាស្រេច គ្រាន់តែ បង់ តាម តម្លៃ នោះ ថវិកា នឹង ចូល ទៅក្នុង ថវិកា ជាតិ មិន ចូលទៅ ណា ផ្សេង នោះ ទេ ។
លោក ទេសរដ្ឋមន្រ្តី ស៊ុន ចាន់ថុល បាន ជំរុញ ដល់ ប្រជាពលរដ្ឋ ដែល ទិញ - លក់ យានយន្ត បាន ចុះបញ្ជី រួច ប៉ុន្តែ ពុំ ទាន់ បាន ធ្វើ ការផ្ទេរ កម្មសិទ្ធិ យានយន្ត ត្រូវ មក ធ្វើ ការផ្ទេរ កម្មសិទ្ធិ យានយន្ត ដើម្បី កាន់ កាប់ យានយន្ត របស់ ខ្លួន ត្រឹមត្រូវ តាម ច្បាប់ និង រួចផុត ពី កាតព្វកិច្ច ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ដូចជា ករណី រថយន្ត បង្ក គ្រោះថ្នាក់ ចរាចរណ៍ ឬ រថយន្ត ប្រព្រឹត្តិ បទល្មើស ផ្សេង ៗ ជាដើម ។
សូម បញ្ជាក់ ថា បន្ទាប់ពី ដាក់ពាក្យ ស្នើសុំ ផ្ទេរ កម្មសិទ្ធិ រថយន្ត តាម អនឡាញ ហើយ នោះ ម្ចាស់ យានយន្ត អាច ទៅ យក បណ្ណ សម្គាល់ រថយន្ត ឬ កាត គ្រី នៅ មជ្ឈមណ្ឌល ផ្តល់ សេវា នៅ ផ្សារ ទំនើប ជីប ម៉ុង ណូរ៉ូម៉ល តាម បណ្តោយ មហាវិថី ព្រះនរោត្តម សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន ឬ តាម កន្លែង ផ្តល់ សេវា ដទៃ ៗ ទៀត ។
សូម ទស្សនា វីដេអូ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បញ្ជាក់ ពី គុណ តម្លៃ នៃ ប្រព័ន្ធ ស្វ័យប្រវត្តកម្ម នៃ ការផ្ទេរ កម្មសិទ្ធិ រថយ ន្ត៖
( ភ្នំពេញ ) ៖ លោក លឹម ជា វុត្ថា អគ្គ នាយក អង្គភាព ព័ត៌មាន Fresh News និង ភរិយា សូម សម្ដែង នូវ អំណរ សាទរ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ លោក ឯ ម ច័ន្ទ មករា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ ដែល ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង មុខ តំណែង ជា រដ្ឋលេខាធិការ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បន្ថែម លើ មុខងារ បច្ចុប្បន្ន ។
ឆ្លៀត ក្នុង ឱកាស ដ៏ វិសេសវិសាល ថ្លៃ ថ្លា ខ្ញុំ សូម សម្ដែង នូវ អំណរ សាទរ ដោយ ស្មោះ អស់ ពី ដួងចិត្ត និង សូម បួងសួង ដល់ វត្ថុ ស័ក្ដិសិទ្ធិ ទាំងឡាយ ក្នុង លោក សូម ប្រសិទ្ធ ពរ ជ័យ បវរសួស្ដី សិរី មង្គល មហា ប្រសើរ ជូន លោក ឯ ម ច័ន្ទ មករា សូម មាន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង កាយ មាំ មួន ប្រាជ្ញា ភ្លឺ ថ្លា អាយុ យឺន យូរ ឈ្នះ អស់ មារស ត្រូវ គ្រប់ ទិសទី និង ទទួលបាន ជោគជ័យ គ្រប់ ភារកិច្ច ។
ជាថ្មី ម្ដង ទៀត ខ្ញុំ សូម បួងសួង ដល់ វត្ថុ ស័ក្ដិសិទ្ធិ ទាំងឡាយ ក្នុង លោក សូម តាម ជួយ បីបាច់ ថែរក្សា លោក ឯ ម ច័ន្ទ មករា និង ភរិយា ព្រមទាំង បុត្រី ជា ទីស្រឡាញ់ សូម ជួប តែ មហាវិបុល សុខ សុភមង្គល និង ប្រកបដោយ ពុទ្ធ ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
មន្រ្តី ជាន់ ខ្ពស់ សង្គមកិច្ច៖ រាជ រដ្ឋាភិបាល កំពុង ប្រឹងប្រែង កាត់បន្ថយ ជា អតិបរមា នូវ អំពើ ជួញដូរ មនុស្ស និង ការធ្វើ អាជីវកម្ម លើ មនុស្ស
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា បាន នឹង កំពុង ខិតខំ ប្រឹងប្រែង បង្កើត រៀបចំ ចង ក្រង ផ្សព្វផ្សាយ និង អនុវត្ត គោល នយោបាយ យុទ្ធសាស្រ្ត ផែនការ កិច្ចព្រមព្រៀង ទ្វេ ភាគី និង ពហុ ភាគី និង យន្តការ នានា សំដៅ ប្រយុទ្ធ ប្រឆាំង និង កាត់បន្ថយ ឱ្យ បានជា អតិបរមា នូវ អំពើ ជួញដូរ មនុស្ស និង ការធ្វើ អាជីវកម្ម លើ មនុស្ស ទាំង ក្នុង ក្របខ័ណ្ឌ ជាតិ អនុ តំបន់ តំបន់ និង លើ ពិភពលោក ។
អំពើ ជួញដូរ មនុស្ស បាន និង ង កំពុង កើតឡើង គ្រប់ ទីកន្លែង ក្នុង រូបភាព ភាគ ច្រើន ជា ឧក្រិដ្ឋកម្ម ឆ្លង ដែន និង ក្នុង ប្រទេស ដែល មាន អង្គការ ចាត់តាំង ហើយ ឧក្រិដ្ឋកម្ម នេះ បាន ជះ ឥទ្ធិពល ជា អវិជ្ជមាន ដល់ បុគ្គល គ្រួសារ និង សហគមន៍ ជាពិសេស ទាំង នៅ ថ្នាក់ ជាតិ តំបន់ និង ពិភពលោក ។
នេះ ជា ការលើកឡើង របស់ លោក ញ៉ឹក វណ្ណារ៉ា រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា តំណាង លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ថ្លែង ក្នុង ឱកាស បើក សិក្ខាសាលា ពិគ្រោះយោបល់ « ការអនុវត្ត គោល នយោបាយ និង បទដ្ឋាន អប្បបរមា ស្តីពី កិច្ចការពារ សិទ្ធិ ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស » នា ថ្ងៃទី ០១ ខែតុលា ២០២០ នៅ សណ្ឋាគារ កាំបូឌីយ៉ាណា រាជធានី ភ្នំពេញ ។
លោក បាន បន្ត ថា ក្រសួង សង្គមកិច្ច បាន បំពេញ ការងារ យ៉ាង សកម្ម និង សម្រេចបាន នូវ សមិទ្ធផល ជាច្រើន ក្នុង កិច្ចការពារ ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស ការងារ កសាង គោល នយោបាយ ការបង្ការ ទប់ស្កាត់ អំពើ ជួញដូរ មនុស្ស ការពង្រឹង កិច្ច សហប្រតិបត្តិការ និង ការបង្កើន ភាព ជាដៃគូ ។ ទោះបី ក្រសួង សម្រេចបាន សមិទ្ធផល ជាច្រើន យ៉ាងណា ក៏ដោយ ក៏ ការការពារ ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស នៅ មិន ទាន់ បាន ឆ្លើយតប បាន ទាំងស្រុង នៅឡើយ ទេ ជាពិសេស ការផ្តល់ សេវា គាំទ្រ សម្រាប់ ជនរងគ្រោះ នៅ មាន កម្រិត នៅឡើយ ។
លោក ញ៉ឹក វណ្ណារ៉ា សង្ឃឹម ថា ភាគី ដែល បាន ចូលរួម នៅក្នុង ថ្ងៃ នេះ នឹង ខិតខំ អស់ ពី កំលាំង កាយ កំលាំងចិត្ត ដើម្បី ពិភាក្សា និង ផ្តល់ មតិ យោបល់ ដ៏ មាន តម្លៃ ដល់ សិក្ខាសាលា នេះ ដើម្បីឲ្យ ក្រុមការងារ បច្ចេកទេស បាន កែសម្រួល លើ គោល នយោបាយ និង បទដ្ឋាន អប្បបរមា ស្តីពី កិច្ចការពារ សិទ្ធិ របស់ ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ និង បម្រើ ឧត្តម ប្រយោជន៍ ដល់ ជនរងគ្រោះ របស់ យើង ៕
( កំពង់ឆ្នាំង ) ៖ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង បាន សាងសង់ ផ្សារ ថ្មី មួយ កន្លែង ទៀត នៅក្នុង ភូមិ ឆ្នុក ទ្រូ ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូណ៌ ដើម្បី ជួយ សម្រួល ដល់ ការលំបាក ជូន ប្រជាពលរដ្ឋ ដែល ធ្លាប់ តែ ចល័ត តូប លក់ដូរ តាម ទឹក ទន្លេ ឡើង និង ស្រក ជារៀងរាល់ ឆ្នាំ ។ ផ្សារ ថ្មី នេះ មាន កន្លែង លក់ដូរ មាន សោភ័ណភាព និង សុវត្ថិភាព ល្អ សម្រាប់ បម្រើ ដល់ ការលក់ដូរ ទំនិញ របស់ ប្រជាពលរដ្ឋ ។
លោក មេឃុំ ឆ្នុក ទ្រូ បាន បញ្ជាក់ ថា មកដល់ ពេលនេះ ផ្សារ សមុទ្រ ទឹក សាប ឆ្នុក ទ្រូ បាន សាងសង់ រួចរាល់ហើយ ដោយ មាន កន្លែង លក់ដូរ ចំនួន ២២៤ កន្លែង ។ ប្រជាពលរដ្ឋ ដែល មាន លទ្ធភាព អាច ចូលមក កក់ ប្រាក់ ជួល កន្លែង លក់ដូរ ក្នុង ផ្សារ ថ្មី នេះ បាន ហើយ ដោយ កក់ ប្រាក់ ចំនួន ១.៥០០ ដុល្លារ ក្នុង ១កន្លែង ៗ សម្រាប់ ការលក់ដូរ រយៈពេល ៣ឆ្នាំ ។
ដោយឡែក អ្នក គ្មាន លទ្ធភាព គ្មាន ប្រាក់ ជួល ដែល ប៉ះពាល់ ជីវភាព ដោយ ជំងឺ កូវីដ - ១៩ អាច បង់ រំលោះ ទៅ តាម លទ្ធភាព ជាក់ស្តែង ក្នុង ពេល ឈប់ លក់ដូរ មុន រយៈពេល កំណត់ ៣ ឆ្នាំ ត្រូវ ជូនដំណឹង មក គណៈកម្មការ ផ្សារ ជាមុន រយៈពេល ៣ខែ ចំពោះ ប្រាក់ កក់ គឺ អាច ដក យក ទៅ វិញ បាន ។ ចំណែក ថ្លៃ ឈ្នួល តូប ប្រចាំ ខែ ក្នុង ១តូប ៗ ថ្លៃ ៣៥ ដុល្លារ ។
ការសិក្សា ស្រាវជ្រាវ ថ្មី មួយ ដែល ទើប ចេញផ្សាយ ក្នុង សប្តាហ៍ នេះ នៅលើ ទស្សនាវដ្តី ធម្មជាតិ - វិទ្យាសាស្រ្ត បាន ទទួលស្គាល់ អំពី ការរកឃើញ បឹង ក្រោម ផ្ទាំង ទឹកកក ឆ្នាំ ២០១៨ ហើយ បាន គាំទ្រ របកគំហើញ នោះ ជាមួយ ការរកឃើញ វត្តមាន បឹង ស្រដៀង គ្នា ចំនួន ០៣ ថែម ទៀត នៅឯ តំបន់ ប៉ូល ខាងត្បូង របស់ ភព អង្គារ ។ ក្រុម អ្នកស្រាវជ្រាវ បាន ប្រើប្រាស់ ទិន្នន័យ រ៉ាដា ពី យានអវកាស - ផ្កាយ រណប Mars Express របស់ អង្គការ អវកាស អឺរ៉ុប ESA កាលពី ចន្លោះ ឆ្នាំ ២០១២ - ២០១៩ ។
( ភ្នំពេញ ) ៖ អភិបាល ខណ្ឌ ចំការមន លោក ថេង សុថុល នៅ ព្រឹក ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០ នេះ ក្នុង ឱកាស ចុះ ពិនិត្យ ទីតាំង ចុះឈ្មោះ បោះឆ្នោត នៃ សង្កាត់ ចំនួន ៥ ក្នុង មូលដ្ឋាន បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល មិន ទាន់ មាន ឈ្មោះ ក្នុង បញ្ជី ឈ្មោះ បោះឆ្នោត ត្រូវ ប្រញាប់ រួសរាន់ ទៅ ចុះឈ្មោះ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា ។
លោក ថេង សុថុល ក្នុង ដំណើរ ចុះ ត្រួតពិនិត្យ ទី តំាង ចុះឈ្មោះ បោះឆ្នោត ក្នុង សង្កាត់ ចំនួន ៥ នៃ ខណ្ឌ ចំការមន នា ព្រឹក មិញ នេះ ក៏ បាន នាំយក នូវ ទឹក អាល់កុល និង ម៉ាស ជូន ដល់ ការិយាល័យ ចុះឈ្មោះ បោះឆ្នោត ទាំង៥ សង្កាត់ ក្នុង យុទ្ធនាការ បង្ការ និង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នោះ ផងដែរ ។
សង្កាត់ ទំាង ៥ នោះ រួម មាន៖ សង្កាត់ បឹងត្របែក . សង្កាត់ ផ្សារ ដើម ថ្កូវ . សង្កាត់ ទួល ទំពូង១ សង្កាត់ ទួល ទំពូង២ និង សង្កាត់ ទន្លេបាសាក់ ។
យោង តាម ការជូនដំណឹង របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត គ.ជ. ប បាន តម្រូវឲ្យ ប្រជាពលរដ្ឋ ចាប់ពី វ័យ គ្រប់ អាយុ ត្រូវ បោះឆ្នោត ត្រូវ នាំគ្នា ទៅ ពិនិត្យ ឈ្មោះ នៅក្នុង បញ្ជី ឈ្មោះ បោះឆ្នោត តាម ទី តំាង សង្កាត់ នានា នៃ ខណ្ឌ នីមួយ ៗ ដែល បាន រៀបចំ នោះ ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០២០ ។
អ្នកនាំពាក្យ ក្រសួង ការបរទេស បាន ឲ្យដឹង បន្ត ថា ក្នុង ជំនួប រវាង ប្រមុខ ការទូត កម្ពុជា និង លោក ឯក អគ្គ រដ្ឋទូត រុស្ស៉ី នោះ ភាគី កម្ពុជា បាន ថ្លែងអំណរគុណ ដល់ រុស្ស៉ី ចំពោះ ជំហរ ប្រកាស គាំទ្រ កម្ពុជា មួយ នេះ ។ ជាមួយគ្នា នេះ ភាគី រុស្ស៉ី តាមរយៈ លោក ឯក អគ្គ រដ្ឋទូត ក៏ បាន អរគុណ កម្ពុជា វិញ ផងដែរ ដែល កម្ពុជា តែងតែ គាំទ្រ ខ្លួន គ្រប់ កាលៈទេសៈ ទាំង លើ ឆាក តំបន់ និង អន្តរជាតិ ។
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង លោក ឯ ម ច័ន្ទ មករា ជា រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បន្ថែម លើ មុខងារ បច្ចុប្បន្ន ។ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្សត្រ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃ ទ ០១ ខែតុលា ឆ្នាំ ២០២០ នេះ ។
