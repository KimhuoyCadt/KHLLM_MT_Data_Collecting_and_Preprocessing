( ភ្នំពេញ ) ៖ បុរស ម្នាក់ ប្រុង លោត សម្លាប់ ខ្លួន ពីលើ អគារ កម្ពស់ ៣ជាន់ នៃ សាលា អន្តរជាតិ World ស្ថិត នៅ ផ្លូវ លេខ ២៣០ ហៅ ផ្លូវ កោស ដូង សង្កាត់ ទឹកល្អក់៣ ខណ្ឌ ទួលគោក បាន បង្ក ការភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង ដល់ ប្រជាពលរដ្ឋ នៅ ព្រឹក ថ្ងៃទី ០២ ខែតុលា ឆ្នាំ ២០២០ នេះ តែ ត្រូវបាន កងកម្លាំង ប្រតិបត្តិការ រុករក និង សង្គ្រោះ ៧១១ កងពល តូច លេខ ៧០ ជួយសង្គ្រោះ ទាន់ ពេល វេលា ។
តែ ទោះ យ៉ាងណា ក៏ដោយោ ការប៉ុនប៉ង លោត សម្លាប់ ខ្លួន នេះ គេ មិន ទាន់ ដឹង ពី មូលហេតុ ពិតប្រាកដ របស់ ជនរងគ្រោះ នោះ ឡើយ ។
លោក ឧត្តមសេនីយ៍ ទោ សូយ ណារិទ្ធ មេបញ្ជាការ រង កងពល តូច លេខ ៧០ ទទួល ផែន ក្រុម ៧១១ បាន ឲ្យដឹង ថា បុរស ខាងលើ មាន ឈ្មោះ សុខ ឧត្តម អាយុ ៣៥ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ហើយ ស្នាក់ នៅ ផ្ទះ ជួល ម្ដុំ ផ្សារ បឹង ឈូក ។
ក្រោយ កើត ហេតុ សមត្ថកិច្ច ប៉ុស្តិ៍ បាន បញ្ជូន ជនសង្ស័យ ខាងលើ ទៅកាន់ ប៉ុស្តិ៍ នឹង ទាក់ទង ទៅ ខាង សាលា ខណ្ឌ ដើម្បីឲ្យ បញ្ជូន ជនសង្ស័យ ខាងលើ ទៅកាន់ មន្ទីរ សង្គមកិច្ច និតី សម្បទា ៕
រដ្ឋបាល ខេត្ត បាត់ដំបង បិទ វគ្គ បណ្តុះបណ្តាល ស្តីពី តួនាទី ភារកិច្ច និង ទំនាក់ទំនង ការងារ រវាង ក្រុមប្រឹក្សា និង គណៈ អភិបាល លើ ការអនុវត្ត ការងារ
( បាត់ដំបង ) ៖ អស់ រយ: ពេល៤ ថ្ងៃ វគ្គ បណ្តុះបណ្តាល ស្តីពី តួនាទី ភារកិច្ច និង ទំនាក់ទំនង ការងារ រវាង ក្រុមប្រឹក្សា គណៈ អភិបាល លើ ការអនុវត្ត ការងារ នៅ ខេត្ត បាត់ដំបង ត្រូវបាន បិទ បញ្ចប់ វគ្គ នា ព្រឹក ថ្ងៃទី ២ ខែតុលា ឆ្នាំ ២០២០ នៅ សាល ប្រជុំ សាលា ខេត្ត របស់ ក្រសួង មហាផ្ទៃ ដោយ បាន សហការ ជាមួយ រដ្ឋបាល ខេត្ត បាត់ដំបង ។
វគ្គ បណ្តុះបណ្តាល ស្តីពី តួនាទី ភារកិច្ច និង ទំនាក់ទំនង ការងារ រវាង ក្រុមប្រឹក្សា គណៈ អភិបាល ជា ការអនុវត្ត មុខងារ និង ធនធាន និង យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៤ និង ផែនការ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ ជាតិ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ពិធី បិទ និង បើក វគ្គ នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក អ៊ុយ រី ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង . គ្រូ ឧទ្ទេស មកពី នាយកដ្ឋាន ផ្សព្វផ្សាយ នៃ ក្រសួង មហាផ្ទៃ ថ្នាក់ អភិបាល រង ខេត្ត សមាជិក ក្រុមប្រឹក្សា ខេត្ត លោក អភិបាល ក្រុង ស្រុក មន្ទីរ កងកម្លាំង អង្គភាព នានា ក្នុង ខេត្ត និង មន្រ្តី ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ចូលរួម ផងដែរ ។
លោក ងួន រតនៈ បាន ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ ក្រសួង មហាផ្ទៃ ពិសេស នាយកដ្ឋាន បណ្តុះបណ្តាល នៃ ក្រសួង មហាផ្ទៃ ដែល បាន ចំណាយ ពេល អស់ រយ: ពេល៤ ថ្ងៃ ខិតខំ បង្រៀន ពន្យល់ ដល់ សិក្ខាកាម ទាំងអស់ ដែល បាន យកចិត្តទុកដាក់ ស្តាប់ ខ្លឹមសារ សំខាន់ ៗ រហូតដល់ ពេល បញ្ចប់ វគ្គ ប្រកបដោយ ជោគជ័យ ។
ក្នុង ពិធី នេះ ដែរ គ្រូ ឧទ្ទេស បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋបាល ខេត្ត បាត់ដំបង ដែល បាន ចូលរួម សហការ ធ្វើការសម្របសម្រួល ដល់ មន្រ្តី នាយកដ្ឋាន ជា គ្រូ ឧទ្ទេស បាន បំពេញ បេស សកម្ម ប្រកបដោយ ជោគជ័យ ឈានដល់ ទី បញ្ចប់ វគ្គ ហើយ ធ្វើឲ្យ សិក្ខាកាម ទាំងអស់ បាន យល់ កាន់តែ ច្បាស់ សម្រាប់ យក ទៅ អនុវត្ត ការងារ ប្រចាំ ថ្ងៃ ផងដែរ ។
ក្នុង ឱកាស នោះ ដែរ លោក ងួន រតនៈ បាន ផ្តាំផ្ញើ ដល់ សិក្ខាកាម ទាំងអស់ ដែល បាន មក ទទួលបាន ចំណេះដឹង ពី ការវគ្គ បណ្តុះបណ្តាល នេះ នៅពេល ត្រលប់ ទៅ មូលដ្ឋាន វិញ ទាំង ក្រុមប្រឹក្សា និង គណ: អភិបាល ក្រុង ស្រុក សូម យក ទៅ អនុវត្ត ចំ គោលដៅ និង តាម តួរ នាទី ភារកិច្ច រៀង ៗ ខ្លួន ស្រប តាម ការណែនាំ របស់ ក្រសួង បាន ដាក់ចុះ ។
ស្ត្រី ជនជាតិ ទំពូន ម្នាក់ យក សត្វ គីង្គក់ ទៅ ធ្វើ ម្ហូប បណ្តាលឱ្យ ពុល ស្លាប់ នៅ ស្រុក អណ្តូង មាស ខេត្ត រតនគិរី
( រតនគិរី ) ៖ ពិតជា រឿង មួយ ដ៏ គួរឱ្យ សោកស្តាយ និង ត្រូវ មាន ការប្រុងប្រយ័ត្ន . ស្ត្រី ជនជាតិ ទំពូន ម្នាក់ បាន យក សត្វ គីង្គក់ ទៅ ធ្វើ ម្ហូប ហូប បណ្តា ឱ្យ ពុល រាករូស រហូតដល់ បាត់បង់ជីវិត នៅ ល្ងាច ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០ នៅ ផ្ទះ ជនរងគ្រោះ ស្ថិត ភូមិ កាតែ ឃុំ ម៉ាលិក ស្រុក អណ្តូង មាស ខេត្ត រតនគិរី ។
លោក អធិការ នគរបាល ស្រុក អណ្តូង មាស រូប នេះ បាន បញ្ជាក់ ឲ្យដឹង ទៀត ថា ក្រោយពី ធ្វើ កោសល្យវិច្ច័យ រួច ឃើញ ថា ជនរងគ្រោះ ពិតជា ពុល ដោយសារ យក សត្វ គីង្គក់ យកមក ធ្វើ ម្ហូប រួច ហូប តែ ម្នាក់ឯង បណ្តាលឲ្យ មាន អាការៈ ក្អូត រាក រូស បែក ពពុះមាត់ មិន អាច ជួយសង្គ្រោះ ទាន់ ព្រោះ បងប្អូន ទៅ ចំការអស់ ហើយ ពោលគឺ គ្មាន ស្លាកស្នាម ឃាតកម្ម អ្វី កើតឡើង នោះ ទេ ។
សព ជនរងគ្រោះ ត្រូវបាន សមត្ថកិច្ច ប្រគល់ឲ្យ ក្រុមគ្រួសារ ធ្វើ បុណ្យ តាម ប្រពៃ ជនជាតិ ដោយឡែក ប្រភព ព័ត៌មាន ពី អ្នកជិតខាង បាន ឲ្យដឹង ថា ជនរងគ្រោះ ជា មនុស្ស មាន សតិ មិន គ្រប់ ផងដែរ ៕
គួរ បញ្ជាក់ ថា កងទ័ព អាមេនី និង អាហ្សែ បៃហ្សង់ នៅតែ បន្ត បាញ់ ផ្លោង ដាក់ គ្នា ឈាន ចូល មកដល់ ថ្ងៃព្រហស្បតិ៍ ម្សិលមិញ ។ ទាហាន និង ជន ស៊ីវិល សរុប ២១ នាក់ បាន បាត់បង់ជីវិត និង ជាង ១០០ នាក់ រងរបួស នៅក្នុង ការប្រយុទ្ធ គ្នា ដ៏ ក្តៅ គគុក រវាង កងទ័ព អាមេនី និង អាហ្សែ បៃហ្សង់ នៅ តំបន់ ជម្លោះ រវាង ប្រទេស ទាំង ពីរ នេះ កាលពី ថ្ងៃអាទិត្យ សប្តាហ៍ មុន ដែល មិន ធ្លាប់ មាន នោះ ឡើយ គិត ចាប់តាំងពី ឆ្នាំ ២០១៦ ។
( ភ្នំពេញ ) ៖ ថ្ងៃទី ០២ ខែតុលា ឆ្នាំ ២០២០ នេះ ជា ថ្ងៃទី ០២ ហើយ នៃ ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២០ ដែល រៀបចំឡើង ដោយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ហៅ កាត់ ថា គ.ជ.ប ។
ដើម្បី ចុះឈ្មោះ បោះឆ្នោត បាន ប្រជាពលរដ្ឋ ខ្មែរ ទាំង ពីរ ភេទ ដែល កើត មុន ឬ ត្រឹម ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០០៣ ត្រូវ មាន អត្តសញ្ញាណ បណ្ណ ។ បើ មិន ទាន់ មាន អត្តសញ្ញាណ បណ្ណ ទេ ត្រូវ ទៅកាន់ សាលា ឃុំ សង្កាត់ ដើម្បី ធ្វើ ឯកសារ បញ្ជាក់ អត្តសញ្ញាណ បម្រើ ដល់ ការបោះឆ្នោត ។
ការចុះឈ្មោះ បោះឆ្នោត មាន សារសំខាន់ ខ្លាំង ណាស់ សម្រាប់ ប្រជាពលរដ្ឋ ដើម្បី មាន សិទ្ធិ ចូលរួម ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់ នា ឆ្នាំ ២០២២ និង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នា ឆ្នាំ ២០២៣ ។
ប្រសិនបើ មិន បាន ចុះឈ្មោះ ក្នុង បញ្ជី ឈ្មោះ បោះឆ្នោត ដែល រៀបចំ ដោយ គ.ជ. ប ទេ ប្រជាពលរដ្ឋ ខ្មែរ ទាំង ពីរ ភេទ មិន មាន សិទ្ធិ ចូលរួម បោះឆ្នោត នោះ ឡើយ ។ គ.ជ. ប បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ទាំង ពីរ ភេទ ដែល កើត មុន ឬ ត្រឹម ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០០៣ អញ្ជើញ ទៅ ចុះឈ្មោះ បោះឆ្នោត និង ពិនិត្យ បញ្ជី ឈ្មោះ បោះឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា ។
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា ស្ត្រី ជនជាតិ ខ្មែរ ដែល ទើប រកឃើញ ឆ្លង កូវីដ១៩ មាន អាយុ ៣៣ ឆ្នាំ អាសយដ្ឋាន ស្នាក់ នៅ ភូមិ ក្តុល ឃុំ ក្តុល ដូន ទាវ ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង ជា អ្នកធ្វើដំណើរ មកពី សហរដ្ឋ អាមេរិក ដោយ បាន បន្ត ជើងហោះហើរ នៅ ប្រទេស ចិន ( តៃវ៉ាន់ ) មកដល់ កម្ពុជា នៅ ថ្ងៃទី ១៦ ខែកញ្ញា ឆ្នាំ ២០២០ ។
បន្ទាប់មក នៅ ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០២០ គាត់ បាន ចាកចេញ ពី រាជធានី ភ្នំពេញ ទៅ ខេត្ត បាត់ដំបង ក្រោយ លទ្ធផល តេស្ត លើក ទី ០១ របស់ គាត់ អវិជ្ជមាន វីរុស កូវីដ - ១៩ ។ នៅ ថ្ងៃទី ១៣ នៃ ការធ្វើចត្តាឡី ស័ក នៅ ផ្ទះ របស់ គាត់ គឺ ត្រូវនឹង ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០២០ ការវិភាគ វត្ថុ សំណាក លើក ទី២ របស់ គាត់ គឺ ទទួលបាន លទ្ធផល វិជ្ជមាន វីរុស កូវីដ - ១៩ ហើយ បច្ចុប្បន្ន នេះ អ្នកជំងឺ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង ។
ក្រុមការងារ នឹង បន្ត ការស្រាវជ្រាវ រក អ្នក ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល ជា បន្ត ទៀត នៅ ថ្ងៃទី ០២ ខែតុលា នេះ និង នៅ ថ្ងៃ បន្តបន្ទាប់ ទៀត ដោយសារ ស្ថានភាព អាកាសធាតុ នៅ ខេត្ត បាត់ដំបង នា យប់ ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០ មាន ភ្លៀង ធ្លាក់ ខ្លាំង ពេក និង យប់ ជ្រៅ ផង នោះ ។ ក្រសួង នឹង បន្ត ជម្រាប ជូន សាធារណជន នូវ លទ្ធផល នៃ ការស្រាវជ្រាវ រក អ្នក ប៉ះពាល់ នូវ ពេល បញ្ចប់ ការងារ នេះ ។
សូម ជម្រាប ថា គិត ត្រឹម ម៉ោង ០៧៖០០ ព្រឹក ថ្ងៃទី ០២ ខែតុលា ឆ្នាំ ២០២០ នេះ នៅ កម្ពុជា រកឃើញ អ្នក មាន វីរុស កូវីដ - ១៩ មាន ចំនួន សរុប ២៧៨ នាក់ ក្នុង នោះ ចំនួន អ្នក ព្យាបាល ជាសះស្បើយ សរុប ទូទាំង ប្រទេស មាន ចំនួន ២៧៥ នាក់ និង អ្នក កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ចាក់អង្រែ ចំនួន ០១នាក់ មន្ទីរពេទ្យ ខេត្ត សៀមរាប ចំនួន ០១ នាក់ និង មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង ចំនួន ០១ នាក់ ៕
ក្រសួង សេដ្ឋកិច្ច និង ក្រសួង រ៉ែ ចេញ ប្រកាស រួម កំណត់ អត្រា សួយ សារ លើ តម្លៃ ផលិតផល រ៉ែ និង នីតិវិធី នៃ ការបង់ ថ្លៃ សួយ សារ
ព័ត៌មាន លម្អិត សូម អាន ប្រកាស អន្តរ ក្រសួង ដូច ខាងក្រោម៖
ទស្សនា វីដេអូ សម្ដេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប្រារព្ធ ពិធី បុណ្យ ឆ្លង វិមាន គុណ មាតាបិតា
( ត្បូងឃ្មុំ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នៅ ថ្ងៃព្រហស្បតិ៍ ទី០១ ខែ តុលា ឆ្នាំ ២០២០ បាន ប្រារព្ធ ពិធី បុណ្យ ឆ្លង វិមាន គុណ មាតាបិតា ដើម្បី ឧទ្ទិស មហា កុសល ជូន ដួង វិញ្ញាណក្ខន្ធ មហា ឧបាសក លីន គ្រី និង អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី នៅ ភូមិ ២ ឃុំ រកាខ្នុរ ស្រុក ក្រូចឆ្មារ ខេត្ត ត្បូងឃ្មុំ ។
ពិធី បុណ្យ ឆ្លង វិមាន គុណ មាតាបិតា ធ្វើឡើង រយៈពេល ៣ ថ្ងៃ គឺ ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០២០ ។ ពិធី បុណ្យ ត្រូវបាន ធ្វើឡើង ទៅតាម ប្រវេណី ខ្មែរ ដោយ មាន ការនិមន្ត ព្រះសង្ឃ សូត្រ មន្ត ប្រោស ព្រំ ប្រសិទ្ធ ពរ ជ័យ សម្តែង ព្រះធម៌ ទេសនា និង ការរាប់ បាត្រ ប្រគេន ចង្ហាន់ ព្រះសង្ឃ ជាដើម ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី កូន ចៅ ក្រុមគ្រួសារ សាច់ញាតិ ព្រមទាំង មន្ត្រី ជាន់ រាជការ រាជ រដ្ឋាភិបាល ខ្មែរ ជាច្រើន រូប ។
សូម ទស្សនា វីដេអូ នៃ ការរៀបចំ ប្រារព្ធ ពិធី បុណ្យ ឆ្លង វិមាន គុណ មាតាបិតា៖
នៅ ជុំវិញ បញ្ហា ខាងលើ សហភាព អឺរ៉ុប (EU) បាន ចូលរួម វិភាគទាន ចំនួន ៤០០ លាន អឺរ៉ូ ( ប្រហែលជា ៤៦៩ លាន ដុល្លារ អាមេរិក ) ដើម្បី គាំទ្រ ដល់ គម្រោង COVAX ប៉ុន្តែ EU ខ្លួន ឯង ផ្ទាល់ មិន មាន បំណង ចូលរួម នៅក្នុង គម្រោង នោះ ទេ ដោយសារ រដ្ឋ សមាជិក គ្មាន ទំនុកចិត្ត លើ សមត្ថភាព ក្នុង ការចែកចាយ របស់ កម្មវិធី ខាងលើ ។ ផ្ទុយទៅវិញ EU បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ដើម្បី ទិញ វ៉ាក់សាំង ច្រើន ជាង ១ពាន់ លាន ដូស ជាមួយ បណ្តា ក្រុមហ៊ុន អភិវឌ្ឍ វ៉ាក់សាំង ដោយ ផ្ទាល់ ។
ជា ផ្នែក មួយ នៃ គម្រោង COVAX . WHO និង GAVI បាន ស្នើសុំ ឲ្យ បណ្តា ប្រទេស នានា ផ្តល់ អាទិភាព ដល់ បុគ្គលិក សុខាភិបាល ជួរ មុខ បន្ទាប់មក មនុស្ស វ័យ ចំណាស់ ជាមួយនឹង គោលដៅ ចាក់ វ៉ាក់សាំង ឲ្យបាន ២០ ភាគរយ នៃ ចំនួន ប្រជាជន ពិភពលោក ។ បញ្ហា ប្រឈម មួយ ទៀត គឺ បេក្ខភាព វ៉ាក់សាំង ជាច្រើន ទាមទារ ឲ្យ រក្សា នៅក្នុង សីតុណ្ហភាព ត្រជាក់ ពី កន្លែង ផលិត រហូតដល់ អ្នកជំងឺ ដូច្នេះហើយ ការដឹកជញ្ជូន នឹង ក្លាយជា ឧបសគ្គ ចំបង ។
ឧបសគ្គ មួយ ទៀត គឺ ថា បេក្ខភាព វ៉ាក់សាំង ឈាន មុខ គេ ភាគ ច្រើន តម្រូវឲ្យ ចាក់ ០២ ដូស សម្រាប់ មនុស្ស ម្នាក់ ដែល អាច បង្កឲ្យ មាន ភាពស្មុគស្មាញ ។ លើស ពី នេះ បញ្ហា ភ័យខ្លាច ចំពោះ ការប្តឹង ផ្តល់ ក្នុង ករណី ដែល វ៉ាក់សាំង មិន មាន ប្រសិទ្ធភាព ក៏ អាច បង្ក បញ្ហា លំបាក ដល់ កិច្ចព្រមព្រៀង បាន ផងដែរ ព្រោះថា ក្រុមហ៊ុន អភិវឌ្ឍ វ៉ាក់សាំង អាចនឹង ទាមទារ ឲ្យ មាន ការធានា ច្បាស់លាស់ ថា ពួកគេ នឹង មិន ប្រឈម ជាមួយ ការប្តឹង ផ្តល់ អ្វី ឡើយ ក្នុង ករណី មាន អ្នកស្លាប់ ឬ អ្នករង ផល ប៉ះពាល់ អវិជ្ជមាន ពី វ៉ាក់សាំង របស់ ពួកគេ ។
( បរទេស ) ៖ រយៈពេល រាប់ ពាន់ ឆ្នាំ មក នេះ មនុស្សលោក យើង តែង សំឡឹង មើល ផ្កាយ នៅលើ ផ្ទៃ មេឃ ហើយ ស្រមើស្រមៃ អំពី ការធ្វើដំណើរ ទៅកាន់ ពួក វា ។ ខណៈ ការបញ្ជូន អវកាសយានិក ឲ្យ ចេញ ទៅ ក្រៅ ប្រព័ន្ធ ព្រះអាទិត្យ នៅតែ ជា ការស្រមៃ ដ៏ សែន វែងឆ្ងាយ នៅឡើយ ក៏ដោយ ក្តី មនុស្សលោក បាន បញ្ជូន យាន រ៉ូបូត ស្រាវជ្រាវ សរុប ចំនួន ០៥ គ្រឿង ឲ្យ ធ្វើ យ៉ាង ដូច្នោះ ហើយ ក្នុង ចំណោម នោះ មាន ២គ្រឿង ត្រូវ គេ អះអាង ថា បាន ចេញ ផុត ហើយ ។
ក្រុម អ្នកវិទ្យាសាស្រ្ត ដឹង ច្បាស់ ថា យាន ទាំង នេះ នឹង ត្រូវ ចេញ ផុត ពី ប្រព័ន្ធ ព្រះអាទិត្យ ហេតុ ដូច្នេះហើយ ទើប ៤គ្រឿង ក្នុង ចំណោម ៥គ្រឿង មាន ពាំនាំយក ទៅ ជាមួយ នូវ សារ ដែល បង្ហាញ ពី អត្តសញ្ញាណ និង ទីតាំង របស់ ភព ផែនដី នៅក្នុង ចក្រវាឡ សម្រាប់ ទម្រង់ ជីវិត ឆ្លាតវៃ ណាមួយ ដែល អាច ប្រទះឃើញ ពួកវា នា ពេល អនាគត ។
( ភ្នំពេញ ) ៖ កូន សម្តេច ទាំង បី និង បងប្អូន ថ្លៃ បាន រៀបចំ អាហារ សាមគ្គី មួយ នា ល្ងាច ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០២០ ដោយ មាន ការចូលរួម ពី មន្រ្តី អ្នកមុខអ្នក ការ អ្នកជំនួញ និង ក្រុមការងារ យុវជន ប្រមាណ ជាង ១០០ នាក់ ។
លោក ក៏ បាន លើកឡើង ផងដែរ ថា នឹង មាន ការជួបជុំ ជា បន្តបន្ទាប់ និង មាន លក្ខណៈ ទូលំទូលាយ ជាង នេះ ៕
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០
១៖ ថ្ងៃ នេះ ក្រសួង សុខាភិបាល បន្ត ប្រកាស ថា គ្មាន រកឃើញ ករណី ឆ្លង ជំងឺ កូវីដ១៩ ថ្មី នោះ ទេ ហើយ ករណី ជាសះស្បើយ ក៏ គ្មាន ដែរ
៣៖ សំឡេង សន្ទនា សំងា ត់៖ ជុន ច័ន្ទ បុត្រ ស្អប់ខ្ពើម ណាស់ យុទ្ធសាស្រ្ត ជេរ យួន របស់ ក្រុម បក្ស ប្រឆាំង ដើម្បី ក្លាយ វីរបុរស
៥៖ កម្ពុជា នាំចេញ ផលិតផល កសិកម្ម ជិត ៦លាន តោន ក្នុង រយៈពេល ៩ខែ ឆ្នាំ ២០២០
៦៖ UN« វា គឺ ដល់ ពេល ហើយ ដែល ប្រទេស នានា ត្រូវ ចាប់ផ្តើម ប្រើប្រាស់ កញ្ចប់ ថវិកា ជាតិ របស់ ខ្លួន ដើម្បី ជួយ ដល់ កម្មវិធី វ៉ាក់សាំង របស់ អង្គការ សុខភាព ពិភពលោក »
៧៖ កម្ពុជា ទទួលបាន ចំណូល ជាង ១៨លាន ដុល្លារ ពី ការលក់ បណ្ណ ចូល ទស្សនា រមណីយដ្ឋាន អង្គរ នៅ ៩ខែ ឆ្នាំ នេះ
៨៖ មេបក្ស ប្រឆាំង រុស្ស៊ី អះអាង ថា លោក វ្ល៉ាឌីមៀ ពូទីន គឺជា អ្នកបញ្ជា ឲ្យ គេ បំពុល រូប លោក !
៩៖ កម្ពុជា នាំចេញ ផលិតផល កសិកម្ម ជិត ៦លាន តោន ក្នុង រយៈពេល ៩ខែ ឆ្នាំ ២០២០
១០៖ ចំនួន អ្នកទស្សនា ការតស៊ូ មតិ លើក ទី១ រវាង បេក្ខភាព ប្រធានាធិបតី អាមេរិក ឆ្នាំ ២០២០ មាន ការធ្លាក់ចុះ បើ ធៀប នឹង ឆ្នាំ ២០១៦
១១៖ លោក ស៊ុន ចាន់ថុល បង្ហាញ សារ ប្រយោជន៍ ប្រព័ន្ធ ផ្ទេរ កម្មសិទ្ធិ រថយន្ត តាម អនឡាញ
១២៖ ត្រាំ កំពុង រៀបចំ រឹតត្បិត ការនាំចូល វត្ថុធាតុ ដើម សំខាន់ ៗ ពី ចិន និង ប្រទេស មួយចំនួន ក្រោម ហេតុផល សន្តិសុខ ជាតិ
១៤៖ លោក ចូ បៃ ដិន លើកឡើង នូវ បញ្ហា ដ៏ រសើប មួយ នាំឲ្យ ប្រធានាធិបតី ប្រេស៊ីល ឆេះ ដុំ និង ប្រកាស គាំទ្រ លោក ត្រាំ ពេញ ទំហឹង
១៥៖ ការិយាល័យ សម្រាប់ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ទូទាំង ប្រទេស ចាប់ បើក ដំណើរការ នៅ ថ្ងៃ នេះ
១៦៖ រដ្ឋ មួយ នៅ ប្រេស៊ីល ចុះ កិច្ចព្រមព្រៀង ទិញ វ៉ាក់សាំង កូវីដ - ១៩ ពី ក្រុមហ៊ុន ចិន ក្នុង តម្លៃ ជិត ១០០ លាន ដុល្លារ !
១៧៖ ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ កម្ពុជា ថយចុះ គួរឱ្យ គត់ សម្គាល់ នៅ រយៈពេល ៩ខែ ឆ្នាំ ២០២០ នេះ បន្ទាប់ពី រឹតបន្តឹង ការផាកពិន័យ
១៨៖ ឥណ្ឌា នឹង បើក សាលារៀន រោងកុន និង អាង ហែលទឹក ឡើងវិញ ទោះបី មាន ការព្រមាន ថា ចំនួន អ្នក ឆ្លង កូវីដ - ១៩ នឹង វ៉ា ដាច់ សហរដ្ឋ អាមេរិក
១៩៖ គ.ជ. ប៖ គណបក្ស នយោបាយ ចំនួន ៥ ដាក់ ភ្នាក់ងារ សង្កេត ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត
២១៖ អាល្លឺម៉ង់ ផ្តល់ ថវិកា ជាង ៨លាន ដុល្លារ ទៀត ដល់ កម្ពុជា ឆ្លើយតប នឹង វិបត្តិ កូវីដ១៩
២២៖ អ៉ីរ៉ាក់ ថា មិន សប្បាយ ចិត្ត ទាល់តែសោះ ក្រោយ អាមេរិក គំរាម បិទ ស្ថានទូត ក្នុង ទីក្រុង បាកដាដ
