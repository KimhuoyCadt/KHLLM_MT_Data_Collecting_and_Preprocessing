លោក ថា នៅ ថ្ងៃទី ២៤ធ្នូ នគរបាល បាន រារាំង ពលរដ្ឋ ប្រមាណ ១០០ នាក់ រួមទាំង លោក ផង មិន ឱ្យ ឡើង ឡាន ទៅ ប្រកប ការងារ ជា កម្មករ ទេ ។
លោក ហ៊ុន សែន បាន មានប្រសាសន៍ ទៀត ថា យើង នឹង បិទ ព្រំដែន ថ្ងៃ នេះ ។
ប្រើប្រាស់ តាម តម្រូវ ការចាំបាច់ ដោយ គ្មាន ជន ណា ម្នាក់ អាច កេងបន្លំ បាន ឡើយ ។
សម្រាប់ ព័ត៌មាន និង ទំនាក់ទំនង មកកាន់ មេឃា ៖
ទោះបី យ៉ាង នេះ ក្តី ការរៀបចំ ឆ្នាំ នេះ អាច ខុសប្លែក ពី ឆ្នាំ មុន ៗ
វ៉ែន សុវ៉ាត់ សន្លប់ លើក នេះ ធ្ងន់ ជាង មុន សុំ ចាញ់ ដោយ អស់ចិត្ត
ឃុំ យាង ការដាក់បញ្ចូល តំណ ភ្ជាប់ កែប្រែ
កូរ៉េ ខាងជើង ដែល អត់ឃ្លាន តែ មាន សមត្ថភាព យោធា ហួស ពី ការគិត ។
មាន វ័យ ក្មេង មែនទែន តែ ម្តង ព្រោះ មធ្យម ភាគ អាយុ របស់ ក្រុម នេះ គឺ ស្មើនឹង ១២,៦ឆ្នាំ តែ ប៉ុណ្ណោះ ។
នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកុម្ភៈ វៀតណាម មិន រកឃើញ ករណី ឆ្លង កូវីដ១៩
ពួកគេ មក បោះឆ្នោត ខុស ច្បាប់ ។
ចំណែក មន្ត្រី ជំនាញ ជល ផល ក៏ ត្រូវបាន គេ សង្ស័យ ថា បាន ឃុបឃិត និង បទល្មើស នេសាទ នេះ ដែរ ។
ព្រោះ អង្ករ ក្លាយជា បាយ ហើយ ចាំ កាល មិន ដួស ហូប
អ្នកស្រាវជ្រាវ ការអភិវឌ្ឍ សង្គម លោក មាស នី មើលឃើញ ថា បញ្ហា នេះ គឺជា រឿង ដដែល ៗ
ឥឡូវ នាង មាន អារម្មណ៍ ថា ខ្លួន ឯង កាន់តែ ទន់ភ្លន់ និង ចាស់ទុំ ឡើង ។
ប្រភេទ អាហារ ទឹកដោះគោ ក៏ ជា ប្រភព ល្អ នៃ អ៊ីយ៉ូត ផងដែរ ។
សុខ សោម៉ាវត្តី ស៊ី ថ្លៃ ជាង ស្រី ក្រមុំ
យោធ ភូមិភាគ ទាំង ៩
នេះ ប្រជាពលរដ្ឋ នៅក្នុង រាជធានី ភ្នំពេញ កំពុង មាន បញ្ហា ព្រួយ កង្វល់ ជាមួយនឹង បញ្ហា សំរាម ដែល នៅ ព័ទ្ធ ជុំវិញ តំបន់ ដែល ពួកគេ រស់ នៅ ។
ថា សើច ច្រើន ចំរើន អាយុ ។
អាល្លឺម៉ង់ គឺជា អ្នកនាំចេញ ផលិតផល ធំ ជាង គេ ទី១ និង នាំចូល ធំ ជាង គេ ទី២ ។
គេ ស្រាវជ្រាវ ឃើញ ថា វា នឹង មាន ឥទ្ធិពល ដល់ សុខភាព ឆ្អឹង ។
អាសយដ្ឋាន ក្បែរ ទួលគោក ភ្នំពេញ ។
ការប្រយុទ្ធ គ្នា រវាង កងទ័ព កម្ពុជា - ថៃ គឺជា សង្គ្រាម
ខែ យុវជន មាន គោលដៅ ឃោសនា ចំពោះ សមាជិក ម្នាក់ ៗ
សូម មើល ការលើកឡើង របស់ បុរស សង្ហា វ័យ ៤០ ឆ្នាំ ខាងក្រោម ៖
ពាក់ព័ន្ធ នឹង អំណាច នយោបាយ ជាង តាម ផ្លូវ ច្បាប់ ។
អ្នកវិភាគ នយោបាយ លោក បណ្ឌិត សុខ ទូច បាន ស្រប នឹង គំនិត ដែរ នេះ ។
ប៉ុន្តែ ក្លឹប ទាំង ពីរ នៅតែ បន្ត និយាយ គ្នា ។
កាលពី អាយុ១០ ឆ្នាំ គាត់ ចាប់ផ្តើម ចាប់អារម្មណ៍ លើ មុខវិទ្យា គីមី និង គ្រីស្តាល់ ។
លោក បាន បន្ថែម ទៀត ថា នៅក្នុង ពិធី នោះ ក៏ នឹង មាន ការអញ្ជើញ ចូលរួម
នាង បាន ប្រឡង ច្រៀង នៅ ភោជនីយដ្ឋាន មួយ ក្បែរ ផាកវ៉េ កាលពី ឆ្នាំ ២០០១ និង បាន ដើរ ច្រៀង តាម ភោជនីយដ្ឋាន នានា មួយចំនួន ផងដែរ ។
អ្នក ចូលចិត្ត រឿង ស្នេហា បែប រ៉ូមែនទិក លាយឡំ នឹង ភាពកំប្លុង កំប្លែង បើ ទោះជា ពេល ខ្លះ មាន អារម្មណ៍ ថា វា ជា រឿង អត់ ប្រយោជន៍ ក៏ដោយ ។
ជា អ្នកថែរក្សា ។
ការរៀបចំ ចាត់ចែង បាន ល្អ ដូច ពួក អាវ លឿង ។
អត្ថប្រយោជន៍ របស់ ផ្លែ ធូរេន ខ្ញុំ និង អ្នក
ហើយ អ្វី ដែល សំខាន់ បំផុត គឺ យើង នឹង ត្រូវបាន ការពារ ដោយ ព្រះជាម្ចាស់ ។
ភីណា ភ្លាត់ មាត់ ស្រែក សួរ ភ្លាម ៖
មគ្គុទ្ទេស វែង គ្មាន
និយាយ បែប នោះ គឺជា ការបំផ្លើស ទាំងស្រុង ។
អ្នក អាច ប្រើប្រាស់ ឧបករណ៍ ណា ដែល សម នឹង ប្រភេទ សក់ ។
រួចទៅហើយ ដូចជា ខ្វះ ការងារ ធ្វើ គ្មាន ការងារ ថែម ម៉ោង និង ងាយ រង ការបញ្ឈប់ ពី ថៅកែ រោងចក្រ ជាដើម ។
បើ តាម អក្សរចារឹក តម្កល់ នៅ ទីនោះ ព្រះបាទ
ជនជាតិ អាមេរិកាំង ដែល គិតគូរ អំពី គ្រួសារ របស់ ក្រុម អ្នក ធ្វើ ការងារ ត្រូវតែ ធ្វើ អ្វី ៗ
ក្នុង រយៈពេល ៤ ថ្ងៃ កន្លងមក នេះ លោក ដូណាល់ ត្រាំ បាន បន្ថែម បញ្ហា ជា បន្តបន្ទាប់ ។
ក្នុង សហរដ្ឋ អាមេរិក ទទួល ការបញ្ចូល ឈាម នេះ ។
អាជ្ញាធរ សៀមរាប នឹង ក្លាយជា គំរូ សម្រាប់ អាជ្ញាធរ ដទៃ ទៀត ៕
ការងារ ច្រូត កាត់ ដក ស្ទូង មាន ភាពលំបាក យ៉ាង ខ្លាំង សម្រាប់ គាត់ នៅ ពេល នោះ ។
ការសង្ខេប ខ្លី គឺជា និមិត្ត សញ្ញា មួយ ។
ខេត្ត ក្រចេះ មាន តំបន់ ទេសចរណ៍ មួយចំនួន ។
ហើយ បញ្ចេញ ជា សកម្មភាព នោះ អ្នក មិន មានអារម្មណ៍ ថា ឯកោ ទៀត ទេ ។
វា ប្រាកដជា ឈឺចាប់ សំរាប់ អ្នកតែ អ្នក មិន ត្រូវ បណ្តោយ អោយ វា ប៉ះពាល់ ដល់ អ្នក ឡើយ ពីព្រោះ មនុស្ស ម្នាក់ ៗ
ទៀត នៅ តាម បណ្តា ខេត្ត នានា ផងដែរ ។
េធ្វើ ក រងរផរធម ម
ហេតុ កម្ចាត់ នូវ គំនុំ១០
ទី ១៧កោះ ឬ ស្សី
ក៏ ដូចជា ចម្លើយ ចំពោះ ចម្ងល់ ជាច្រើន ទាក់ទង នឹង ទី អវកាស ៕
មិន មែន ជួ អ្នកលក់ ជាតិ គម្រាម និង ពុករលួយ ទេ ហាហា ។
នេះ ជា មូលហេតុ ស្រី ៗ
មិត្ត កំពុងតែ មាន ជម្ងឺ មហារីក ណាមួយ ប៉ុន្តែ មិន ទាន់ បាន ព្យាបាល , មិត្ត ចង់ រក នៅ ថ្នាំ ល្អ បំផុត ឱ្យ ជម្ងឺ នេះ ។
កម្មករ បាន ធ្វើ ការតវ៉ា ចំពោះ សេចក្តីសម្រេច ដំឡើង ប្រាក់ខែ គោល ពី ៨០ដល់ ១០០ ដុល្លារ ក្នុង មួយ ខែ ដោយ និយាយ ថា វា នៅតែ មិន គ្រប់គ្រាន់ សម្រាប់ ចិញ្ចឹម ជីវិត ដដែល ។
អាយុជីវិត មនុស្ស ទេ ។
ខាងក្រោម នេះ ជា រូបភាព ថត យក ផ្ទៃ មុខ មនុស្ស ដែល ថត ចេញពី កាមេរ៉ា ទាំង ពីរ ៖
កំពូល ខ្សែភាពយន្ត ទាំង៥ ដែល រក ចំណូល បាន ច្រើន ជាង គេ កាលពី ចុង សប្តាហ៍ មុន
ខ្ញុំ រីករាយ នឹង ឆ្លើយតប នូវ អ្វី ដែល អ្នក ចង់ ដឹង អំពី ផ្នែក ព័ត៌មានវិទ្យា បាន ទៅ តាម អ្វី ដែល ខ្ញុំ បាន ដឹង ។
ហើយ សម្រាប់ ឆ្នាំ នេះ នាង បាន ត្រៀម រួម ជាស្រេច ថា ត្រូវ ជូន អ្វី ដល់ អ្នកម្តាយ ៖
