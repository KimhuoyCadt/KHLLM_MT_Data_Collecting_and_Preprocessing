សង្សារ ក៏ដោយ ប្តី ប្រពន្ធ ក៏ដោយ អាច បែក គ្នា បើ ធ្វើ រឿង ៨យ៉ាង នេះ
លោក សុខ ង៉េង មាន ប្រវត្តិ ចេញ មក ពី គ្រួសារ ធម្មតា មួយ ។
ការបូម ខ្លាញ់ ក្បាលពោះ មាន សារប្រយោជន៍ ដូចជា ៖
ស៊ូឱ្យ បែក ព្រាត់
មកកាន់ ប្រទេស កម្ពុជា នា ពេល ខាងមុខ ។
ក្រោយ បង្កហេតុ ជន បង្ក ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ដើម្បី យក ទៅ សួរនាំ ផងដែរ ៕
ខណៈ លោក សម្តែង ការសោកស្តាយ ចំពោះ លោកស្រី គ្លីនតុន ដែល មិន បានជាប់ ឆ្នោត ។
ធ្វើឱយ ខ្ញុំ កាន់តែ រលឹក និង ចង់ ទៅ លេង ឆាប់ ៗ
ផ្ទុយទៅវិញ សម រង្ស៊ី បាន ចំណាយ លុយ ច្រើន ណាស់ ក្នុង មួយ ឆ្នាំ ៗ
ខំ រត់គេចខ្លួន យូរ ហើយ ស្រាប់តែ នឹកឃើញ ចង់ រស់ នៅ …
ព្រីនស៍ មាន បរិក្ខារ ចំនួន ៨ នៅ ជុំវិញ ពិភពលោក ដោយ មាន ទីតាំង ចំនួន ៣ នៅ សហរដ្ឋ អាមេរិក ៖
៤ស្ថាប័ន ពាក់ព័ន្ធ និង កិច្ចសហការ ៥
ការគោរព គឺជា ផ្នែក មួយ ដ៏ សំខាន់ បំផុត សម្រាប់ ទំនាក់ទំនង គ្រប់ យ៉ាង ។
ហេតុ អ្វី បានជា បញ្ហា តៃវ៉ាន់ បាន ធ្វើឱ្យ អាមេរិក និង ចិន ដំឡើង ធ្មុង ដាក់ គ្នា ខ្លាំង ម្ល៉េះ ?
ខណៈ អនក្ខរ ជន គឺ ងាយ រងគ្រោះថ្នាក់ ជាង គេ ក្រោម រូបភាព ផ្តល់ កម្ចី ជា អត្រា ការប្រាក់ ។
សូម កុំ កាត់សេចក្តីឱ្យ ជីវិត ព្រោះតែ រឿង ពិបាក នៅ ពេល ណាមួយ ហើយ សូម កុំ ឱ្យ សេចក្តី ឈឺចាប់ នៃ រដូវកាល ណាមួយ ធ្វើឱ្យ ភាព សប្បាយរីករាយ ទាំងអស់ ក្នុង ជីវិត បាត់បង់ ទៅ ។
ខ្ញុំ ហត់ ណាស់ ហត់ ចំពោះ ការក្លាយជា បញ្ហា គ្រប់ យ៉ាង នៅ ក្លឹប - កីឡា
ពិធី សែន ឆេង ម៉េង
នៃ បណ្តាំ របស់ លោក អ៊ុំ ហូជីមិញ ។
លោក ហូជីមិញ ថែមទាំង ធ្លាប់ បាន ស្នាក់ នៅ ទីនោះ ទៀតផង ។
ឡើងវិញ បន្ទាប់ពី ឧទ្យាន នេះ ត្រូវ
ទី ចុង បំផុត ខ្លឹមសារ ពិតប្រាកដ គឺ បំផ្លាញ ជាតិ ។
វា គឺ ការធ្វើដំណើរ យ៉ាង ខកចិត្ត ដែល គ្មាន បាន អ្វី ទាំងអស់ ។
សហជីព និង ក្រុម កម្មករ រំពឹង ថា នឹង មាន ដំណោះស្រាយ ខាងមុខ ឆាប់ ៗ
សម្តេច ព្រះនរោត្តម សីហនុ ព្រះអង្គ អស់ ព្រះជន្ម គឺ ប្រជារាស្ត្រ ខ្មែរ នឹង មាន ការរិះគន់ និង តវ៉ា យ៉ាង
គង់ សុធារ៉ា លើ គណិតវិទ្យា ថ្ងៃ នេះ
ដែល បញ្ចេញ ដោយ ឡានឡ ដុត ធ្យូង រោងចក្រ ។
ទេសចរណ៍ វប្បកសិកម្ម - ទិសដៅ ថ្មី នៃ ទេសចរណ៍ ងេ អាន
សូម បំពេញ ទម្រង់បែបបទ ស្នើសុំ តាម អ៊ិនធើណិត តាមរយៈ វែបសាយត៍ ៖
លោក ក៏ បាន ផ្តល់ យោបល់ ផងដែរ ថា យើង ត្រូវ បែរ ឆ្ពោះ ទៅរក វិស័យ កសិកម្ម ។
ទេ ខ្ញុំ និយាយ តែ ក្រុម បំផ្លាញ សន្តិភាព ទេ ។
កាលណា វត្ត អារាម មាន សម្លេង រំខាន មិន ដាច់ វា នឹង ក្លាយទៅជា រឿង មួយ គួរឱ្យ បារម្ភ ។
តៃវ៉ាន់ សាទរ ចំពោះ ការគាំទ្រ ជា បន្ត របស់ អាមេរិក ដោយ ព្រមាន ពី ការបង្ខិតបង្ខំ របស់ ចិន
នេះ គឺជា គុណ តម្លៃ នៃ ស្ត្រី សម័យ ទំនើប ដែល មាន លក្ខណៈ ពេញលេញ ។
តារាចម្រៀង វ័យ ក្មេង របស់ ផលិតកម្ម សាន់ដេនាង អ៊ីវ៉ា ។
សមត្ថកិច្ច ចាប់ខ្លួនអ្នកលេង ល្បែងស៊ីសង ៦នាក់ និង រឹបអូស វត្ថុតាង បាន មួយចំនួន ក្នុង ក្រុង កំពង់ចាម
ដុត នំ និង ១២នាទី រហូតដល់ ពួកគេ វ៉ៃ ។
នៅលើ យន្តហោះ យប់ មិញ ភេសជ្ជៈ ហ្វ្រី លើ យន្តហោះ យប់ មិញ
កាល នោះ ឡរ៉ា បាន អរគុណ ខ្ញុំ ទាំង ទឹកភ្នែក រលីងរលោង គឺ អរគុណ សម្រាប់ ការអធិស្ឋាន របស់ ពួក ជំនុំ របស់ យើង ឱ្យ បង ប្រុស នាង ដែល កំពុងតែ ឱ្យ គ្រូពេទ្យ ពិនិត្យមើល ជម្ងឺ មហារីក ។
អ្នក ញ៉ាំ ប្រៃ ភាគ ច្រើន នឹង លើស សម្ពាធ ឈាម
ស្ត្រី ជា អ្នកបើកបរ បាន គេចខ្លួន បាត់ ភ្លាម ។
តាមពិត ការស៊ើបអង្កេត នេះ គ្រាន់តែ ជា រឿង មួយ គ្រាន់តែ ជា ការឧបកិច្ច ទេ ដោយសារ ពួកគាត់ បាន ដឹង ចម្លើយ មុន ធ្វើ ការស៊ើបអង្កេត ទៅទៀត ។
សូម ចុច លើ តំណ នេះ ដើម្បើមើល អំពី របៀប ដោន ឡូត
ស៊ូ ថេបរលាស់ ខ្លួន មិន ទទួលខុសត្រូវ ក្រោយពេល អាជ្ញាធរ ប្រេងកាត លាតត្រដាង
សូម ប្រាកដ ថា ប្រវែ អឈ្មោះ ឯកសារ ត្រូវ
សិន ហើយ ធ្មេច ភ្នែក មួយ ភ្លែត គិត ថា ខ្ញុំ ជា
មាន មនុស្ស ប្រមាណ ជាង ២០០ នាក់ តែ ប៉ុណ្ណោះ បាន មក ចូលរួម គោរព វិញ្ញាណក្ខន្ធ សព លោក ជា វិជ្ជា នៅ ថ្ងៃ នេះ ។
សូម ជួយ កែតម្រូវផង ថ្ងៃទី ១៥ មិន មែន ថ្ងៃអាទិត្យ ទេ គឺ ថ្ងៃសៅរ៍
សម្តេច ប៉ែននុត គឺជា អ្នកនយោបាយ ខ្មែរ ម្នាក់ ។
៤កុំ យក កំហឹង ទល់ កំហល់
ពីមុន មក គ្រួសារ ខ្ញុំ មិន ពិបាក អី ទេ រឿងរ៉ាវ ចំណាយ ចំណូល ផ្សេង ៗ
តាម ការពិនិត្យ របស់ ខ្ញុំ ម្តាយ មាន សម្ពាធ ឈាម ធម្មតា តែ កូន ក៏ មិន អី ដែរ ពេលនេះ ។
មាន មនុស្ស មួយចំនួន ដែល ងាយ នឹង មាន ជំងឺ នេះ ណាស់ ជាពិសេស នៅពេល វា កើតឡើង ជា លក្ខណៈ គ្រួសារ ។
ប្រជាជន ទាំងអស់ បាន ឃើញ ភ្លៀង នោះ ប្រឹង តែ ស្ងើច ប្រឹង តែ សរសើរ ថា ៖
១ គេង លក់ ស្រួល
វីដេអូ លើ យូធូប
ចរាចរណ៍ ចាប់ផ្តើម មមាញឹក នៅ រដូវ ភ្ជំ បិណ្ឌ - វិទ្យុ វា យោ
ប៉ុន្តែ វា អាច ធ្វើឱ្យ ប្រតិបត្តិការ របស់ អ្នក ទាំង ពីរ មាន ភាព កាន់តែ ប្រសើរឡើង ប្រសិនបើ អ្នក ចេះ អនាម័យ ខ្លួនប្រាណ បាន ល្អ ។
វា ស្ថិត ក្នុង ក្រុម ប្រភេទ ជិត ផុត ពូជ ហើយ មិន មាន គោ ព្រៃ ណាមួយ ត្រូវបាន គេ ប្រទះឃើញ ទេ អស់ ពេល ជាច្រើន ឆ្នាំ មកហើយ ៕
ភាព មិន ចាញ់ មិន ឈ្នះ រវាង រដ្ឋាភិបាល និង គណបក្ស សង្គ្រោះ ជាតិ ដែល ជា គណបក្ស ប្រឆាំង មាន អស់ រយៈពេល ជិត មួយ ឆ្នាំ ។
នាម ដើម អ៊ុក អ៊ូ
គឺជា គ្រូ ដ៏ ល្អ ដែល គួរ បង្រៀន កូន ពី ចំណេះដឹង និង អនាម័យ ផ្លូវភេទ ជាពិសេស ពេល មក រដូវ ដំបូង ។
