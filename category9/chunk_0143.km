ការពិត ពាក្យ នេះ ជា ពាក្យ កម្ចីពី ចិន ។
ក៏ប៉ុន្តែ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ខ្មែ
ប៉ូលិស និយាយ ថា ពួកគេ គឺជា អ្នក រត់ ម៉ូតូ ឌុប ។
ប្រធានាធិបតី កូរ៉េ ខាងត្បូង តែងតាំង នាយក រដ្ឋមន្ត្រី ថ្មី និង រដ្ឋមន្ត្រី ហិរញ្ញវត្ថុ ថ្មី ចំពេល មាន រឿង អាស្រូវ ដ៏ រំជើបរំជួល
ទន្ទឹមនឹង នេះ លោក អនុប្រធានាធិបតី អាមេរិក នៅតែ គាំទ្រ ជំហរ ព្រមាន ធ្ងន់ ៗ
ស្តេច ពុំ មាន ព្រះហឫទ័យ ស្រឡាញ់ ព្រះអម្ចាស់ ជា ព្រះរបស់ ខ្លួន ដូច ព្រះបាទ ដាវីឌ ជា អយ្យកោ ឡើយ ។
ប៉ុន្តែ គ្រួសារ នេះ ហាក់ដូច បាត់បង់ អ្វី ទាំងអស់ ចាប់តាំងពី កូនប្រុស របស់ ពួកគេ បាន បាត់ខ្លួន ។
បងប្អូន ទាំងនោះ ក៏ ជា មនុស្ស សុភាព ដែរ ។
របស់ តារា ស្រី ពិភពលោក
គាត់ បាន សំឡាប់ អេបិល ជា ប្អូន ទៅ ។
សម្តេច ហ៊ុន សែន រង់ចាំ ចាប់ខ្លួន លោក សម រង្ស៊ី នៅពេល លោក មកដល់ ស្រុក ខ្មែរ មែន ។
ទាល់តែ ត្រូវ ខ្លះ ខុស ខ្លះ បាន ដឹង ចិត្ត គ្នា ថា ពេល ជួប បញ្ហា ចេះ ធ្វើ អារម្មណ៍ ដោះស្រាយ បាន បែប ណា ។
សុភ័ក្ត្រ កុសុមាបង្ហោះ រូប របស់ ខ្លួន ហើយ បាន សរសេរ សារ ប្លែក ៗ
មួន ជា មេ កង ម្នាក់ ដ៏ ក្លាហាន មាន ស្ពាយ
ដែល ធ្វើ ខុស គឺ ត្រូវ ចេះ ផ្លាស់ប្តូរ ចេញ ដើម្បីឱ្យ សេចក្តីស្រលាញ់ របស់ អ្នក ទាំង ពី មាន ភាពផ្អែមល្ហែម ថែម ទៀត ។
ស្រវា ស្រទេញ ចង់ មាន ចង់បាន ដោយ ចំណេញ ពី ដីធ្លី នេះ ឯង ។
ការប្រែប្រួល សេដ្ឋកិច្ច នេះ មាន ន័យ ថា ក្រុមគ្រួសារ អាមេរិក ពាក់កណ្តាល មាន ប្រាក់ ចំណូល ទាប ជាង កាលពី ឆ្នាំ ២០០០ ហើយ សេដ្ឋកិច្ច មិន អាច ធ្វើឱ្យ មាន កំណើន ប្រាក់ ចំណូល ទូលំទូលាយ នោះ ទេ ៕
ចប់ ភណ្ឌ គ្គាម វគ្គ ទី១ ។
ប៉ុន្តែ ដោយសា កៅអី ទាំងអស់ លក់ អស់ យ៉ាង លឿន ក៏ បន្ថែម ការប្រគំ តន្ត្រី មួយ ថ្ងៃ ទៀត ។
ចិន សូម ជំទាស់ យ៉ាង ដាច់ខាត ចំពោះ វា ។
សូម មើល រូបភាព សាលា មត្តេយ្យ ធ្វើ ពី យន្តហោះ យ៉ាង ទាក់ទាញ !
មុន ក្បាល ខ្មៅ ជា បញ្ហា ស្បែក មួយ ប្រភេទ ដែល អ្នក ចង់ កម្ចាត់ ចេញ ឱ្យ បាន ឆាប់ បំផុត ។
ជា ដំបូង យើង មាន ការរួបរួម ក្នុង និង តាមរយៈ ព្រះយេស៊ូវ គ្រីស្ទ ។
ការសាងសង់ ទាំងអស់ ទាមទារ ឱ្យ មាន ការត្រួតពិនិត្យ យ៉ាង ហ្មត់ចត់ ។
ហាង មួយចំនួន នៅក្នុង ផ្សារ សហគមន៍ នេះ បាន បើក ដំណើរការ ហើយ ។
គ្នា ទោះជា បាន តិច ឬមួយ ច្រើន យ៉ាងណា ក៏ដោយ ។
ក្រោយពី លាង សម្អាត រួច ចូរ ប្រើ កន្សែង ឬ ក្រដាស អនាម័យ ដើម្បី សំងួត បន្ត ហើយ កុំ ភ្លេច អោយ រោម នៅនឹង រន្ធ គូថ នោះ ស្ងួត ផងដែរ ។
ខ្ញុំ គេង មិន លក់ និង ចេះតែ អស់ កម្លាំង ល្ហិតល្ហៃ ។
បើ ច្រើន ម្លឹង គួរ សរសេរ ចំណុច សំខាន់ ៗ
រដ្ឋាភិបាល ចិន ទទួល មេរៀន ពី ការឆ្លង រាតត្បាត មេរោគ ផ្លូវ ដង្ហើម SARS កាលពី ១៧ឆ្នាំ មុន
ក្រោយ សាកសួរ អស់ ប៉ុន្មាន ម៉ោង សកម្មជន ទាំងនោះ ក៏ ត្រូវបាន ដោះលែង វិញ ដោយ ភ្ជាប់ ជាមួយ កិច្ចសន្យា ។
ហើយ មិន ព្យាយាម បញ្ចូល របៀប រស់ នៅ របស់ អាមេរិក ទៅ ឱ្យ អ្នកដទៃ ធ្វើ តាម នោះ ឡើយ ។
នេះ កូន ភ្លោះ ទាំង ៨បាន ធ្វើ ពិធី ខួបកំណើត អាយុ ៨ឆ្នាំ របស់ ពួកគេ ផងដែរ ។
ពួកគេ បោះ ទ័ព និង លើក ទួល ព័ទ្ធ ជុំវិញ ក្រុង យេរូសាឡឹម ។
ទំព័រ ដើម យល់ដឹង ទូទៅ ទេសចរណ៍
និង មាន ឈាម មិន គ្រប់គ្រាន់ ។
ការផ្ទេរ ប្រាក់ បាន កើនឡើង ៥,២ភាគរយ ដល់ ១១, ៩ពាន់ លាន ដុល្លារ ក្នុង រយៈពេល ៧ខែ ដំបូង ។
ត្រូវ ហើយ នាង មាន ដូចជា អ្នក ហាត់ប្រាណ ហើយ នៅលើ ក្រពះ !
ហាង គុយ ទាវ នេះ បាន ទទួលរង ការខូចខាត ខ្លាំង ។
យើង ធ្លាប់ ទៅ ថ្វាយបង្គំ ព្រះជាម្ចាស់ ជាមួយគ្នា
សម្តេច តេជោ បាន បន្ត ទៀត ថា សូម អរគុណ បងប្អូន និង កូនក្មួយ ដែល មាន ជំនឿ ទុកចិត្ត មក លើ ខ្ញុំ និង គណបក្ស ប្រជាជន ។
សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ សម័យ ប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី
ប៉ុន្តែ មកដល់ ថ្ងៃអង្គារ កម្ពស់ ទឹក បាន ស្រកចុះ កម្រិត ៣តឹក ហើយ ។
ប៉ុន្តែ ប្រសិនបើ លោក ត្រាំ គិត ថា ចង់ បង្អើល យើង ជាមួយនឹង សំឡេង ឆ្កែ ព្រុស នោះ វា ពិត ណាស់ ថា លោក កំពុង យល់សប្តិ ហើយ ។
ព្រះអង្គ បាន ប្រហារ ពួកយើង
ខាងក្រោម នេះ ជា បទពិសោធន៍ នៃ តំណែង និង តួនាទី របស់ លោក វង្ស ពិសេន ត្រួស ៗ
ពេល នោះ គេ ក៏ ស្ទុះ ទៅ ចាប់ ថើបញក់ ញី លើ នាង ទាំង កំរោល ហើយ អ្នក ទាំង ពីរ បាន ប្រតាយ ប្រតប់ គ្នា មួយ ប្រាវ ទើប ប្អូន ស្រី នាង រងគ្រោះ រួមទាំង មិត្តភ័ក្តិ របស់ នាង មក ទាន់ ។
ផ្តោត លើ ការជួយ ដល់ ថ្នាក់ដឹកនាំ ទូទាំង ពិភពលោក ពិចារណា និង ជៀសវាង នូវ កំហុស ដដែល ៗ
ស្ថិត ក្នុង ករណី បន្ទាន់ វា ប្រហែលជា មិន មាន ពេលវេលា គ្រប់គ្រាន់ ដើម្បី ពិភាក្សា ទៅ លើ ជម្រើស នៃ ការសម្រាល កូន ដោយ ការវះកាត់ នោះ ទេ ។
ស្រដៀង គ្នា នេះ ដែរ សម្រាប់ ប្រជាជន ជប៉ុន ដើម្បី សិក្សា វប៌្បធម របស់ កម្ពុជា គឺ ត្រូវ យល់ដឹង ពី ប្រជាជន កម្ពុជា ។
មិន ខុសគ្នា នោះ ទេ ក្មេង តូច ៗ
ខ្លួន យ៉ាង អស់ ពី សមត្ថភាព ប៉ុន្តែ ពួកយើង ធ្វើ ពុំ បាន ល្អ ដូចគ្នា នៅជិត បញ្ចប់ ម៉ោង ។
បទបង ស្រលាញ់ ខ្ញុំ បង មាន គិត ខ្ញុំ ទេ
កាលពី ដើម ពួកគេ បាន នៅ ដាច់ ឆ្ងាយ ពី ព្រះប៉ុន្តែ ឥឡូវនេះ ពួកគេ គឺជា អ្នក ជឿ ដែល មាន ចំណែក នៅក្នុង ព្រះគុណ របស់ ទ្រង់ ដោយសារ ការសុគត និង ការរស់ ឡើងវិញ នៃ អង្គ ព្រះយេស៊ូវ គ្រីស្ទ ។
បើ ខ្ញុំ នៅ កូរ៉េ ច្បាស់ជា ចូលរួម នឹង គេ ហើយ ។
ត្រឹម ក្លាហាន សរសេរ ពេល នៅរស់ ។
បន្ទាប់មក បាន ទំនាក់ទំនង គ្នា តាម ទូរស័ព្ទ លក្ខណៈ ជា សង្សារ ។
ទន្ទឹមនឹង នេះ ដែរ លិខិត ឆ្លង ដែន ថៃ របស់ អ្នកស្រី យីង ឡាក់ ក៏ ត្រូវបាន ក្រសួង ការបរទេស បាន ដកហូត ។
មិន ចង់ ផ្លាស់ប្តូរ ឬ កែប្រែ ហើយ វា នឹង បាត់បង់ ឱកាស រហូត ។
ចូលរួម ទស្សន៍ទាយ !
ការជ្រុះ រោម ចិញ្ចើម មិន ខុសគ្នា នឹង ការជ្រុះ សក់ ដែរ គឺ វា សុទ្ធតែ ធ្វើឱ្យ អ្នក បារម្ភ ខ្លាំង ។
ប្រយ័ត្ន ចាញ់ ឆ្នោត ដោយសារ ការពារ ទ្រីភាព ។
នេះ បើ តាម មន្ត្រី ប្រទេស តួកគី ។
សូម អាន លិខិត បំភ្លឺ របស់ លោក ស៊ុន ស៊ិន ខាងក្រោម នេះ ។
មិន គួរ លះបង់ រឿង ទាំងនេះ ឱ្យ មនុស្ស ប្រុស ទើប មិន ស្តាយក្រោយ
ប៉ុន្តែ ក៏ ត្រៀម ជាស្រេច ដែរ ក្នុង ការចូលរួម មហា បាតុកម្ម នៅក្នុង រូបភាព ផ្សេង ទៀត ដូចជា ការហែ ក្បួន តវ៉ា ជាដើម ។
ទីផ្សារ ផលិតផល កសិកម្ម សរីរាង្គ នៅ កម្ពុជា កំពុង ទទួលបាន ការចាប់អារម្មណ៍ គួរឱ្យ កត់សម្គាល់
តើ ភ្លេង ប្រភេទ ណា ខ្លះ ដែល គេ ប្រគុំ ក្នុង បរិយាស កាស ស្រងេះ ស្រងោច ?
ចុះឈ្មោះ ខ្ញុំ !
ប៉ុន្តែ តុលាការ ថៃ បាន បន្ថយ ទោស មក នៅ ត្រឹមតែ ពីរ ឆ្នាំ វិញ ដោយសារតែ លោក បាន សហការ ជាមួយ តុលាការ ។
គ្នា ឯង ឈ្លក់ វង្វេង នៅ ពេល ដែល ពួកគេ តុបតែង ខ្លួន ជា មនុស្ស ស្រី ។
មូលហេតុ សុខភាព៦ នេះ អាច នាំឱ្យ អ្នកអស់ កម្លាំង ជា ប្រចាំ
យើង សប្បាយ ចិត្ត ជាមួយនឹង ការបិទ បញ្ចប់ នៃ សវនាការ សំណុំរឿង ០០១ របស់ ឌុច ។
ហើយ ក្រុម ប្រទេស ផ្តល់ ជំនួយ ចាំបាច់ ត្រូវ ផ្តល់ ថវិកា ដើម្បី ធានា ថា ដំណើរការ នោះ កើតឡើង បាន ។
ដោយ លោក ឈុន សារ៉ាត
សំអាត បរិស្ថាន នៅ ក្រុង សៀមរាប ក្រោម ប្រធានបទ ខ្ញុំ ស្រលាញ់ ទីក្រុង ស្អាត
ហេតុ នេះ ពួកគេ នឹង ប្រឈម ចំពោះ មុខ ច្បាប់ ៕
ជារៀងរាល់ ថ្ងៃ រហូតដល់ ពោះវៀន ធ្លាយ ចេញមក ។
ប៉ុន្តែ មួយ ក្នុង នាម រដ្ឋាភិបាល ខ្ញុំ ជា អ្នក អនុវត្ត ច្បាប់ ត្រូវតែ អនុវត្ត ច្បាប់ តែ ប៉ុណ្ណឹង ។
របប អាហារ សម្រាប់ មនុស្ស ចាស់ - ចំណី ចំណុក អាហារ សម្រាប់ ចាស់ ៗ
គេហទំព័រ សម្រាប់ កូន ខ្មែរ
