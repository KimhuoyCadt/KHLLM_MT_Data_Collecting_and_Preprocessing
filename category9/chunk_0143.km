លើ ផ្ទៃ មុខ គ្រាន់តែ អ្នក អនុវត្ត វិធី ធម្មជាតិ ទាំង៥ យ៉ាង នេះ
ក្មេងស្រី ម្នាក់ ត្រូវបាន គ្រូពេទ្យ ធ្មេញ ចាប់ ដង្កូវ ចេញ ពី ក្នុង មាត់ របស់ នាង ក្រោយពេល ដែល នាង មាន ការឈឺចាប់ យ៉ាង ខ្លាំង អស់ ជាច្រើន ថ្ងៃ ។
គ្រូបង្វឹក ទាំង១០ រូប ដែល ឈ្នះ ពានរង្វាន់ បាន ច្រើន ជាង គេ នៅ តំបន់ អឺរ៉ុប
ជីវិត ទាំងអស់ គឺជា ការពិសោធន៍ ។
រក្សា ចម្ងាយ យ៉ាងហោចណាស់ ២- ៤ម៉ែត្រ ពី អ្នកដទៃ
សវនាការ វាយតម្លៃ សុខភាព របស់ ជនជាប់ចោទ អៀង សារី
ធានា អនុវត្ត ពេញលេញ ។
ជាទូទៅ មនុស្ស ដែល នៅជិត គ្នា ច្រើន តែ គិត ថា ពួកគេ អាច ធ្វើ អ្វី ដែល ពួកគេ ចង់បាន រហូតដល់ ពួកគេ ភ្លេច ពី អារម្មណ៍ របស់ អ្នកដទៃ ។
ក្រោយពេល ឪពុក ខ្ញុំ ស្លាប់ ខ្ញុំ នៅសល់ តែ បង ប្រុស តែ ខ្ញុំ នៅតែ បម្រើ គាត់ ដូច បាន បម្រើ ឪពុក ខ្ញុំ ដែរ ។
សម្រាប់ គណៈ រដ្ឋមន្ត្រី ប្រើ ជា អនុ រដ្ឋលេខាធិការ ៕
ថ្វីត្បិតតែ បែប នេះ ក្តី ប៉ុន្តែ មនុស្ស ស្រី គឺ ចូលចិត្ត អត្តចរិត បែប នេះ បំផុត ហើយ ។
លោក ដូណាល់ ត្រាំ ថា ខ្ញុំ នឹង ប្រកាស ពី ជ័យជម្នះ នៅ ពេល ដែល ឈ្នះ តែ ប៉ុណ្ណោះ
ការញ៉ាំ អាហារ សម្រន់ គឺ ប្រសើរ ជាង ទុក ឱ្យ ខ្លួនអ្នកឃ្លាន ខ្លាំង ។
ពេល ដែល ការច្រៀង មាន លក្ខណៈ ងាយស្រួល សម្រាប់ ពួកគេ ហើយ លោក អ្នក អាច ចាប់ផ្តើម ប្តូរ ខ្លឹមសារ ចម្រៀង ។
មិត្តភាព ទាំង បី នាក់ ចាប់ផ្តើម កើតឡើង ប៉ុន្តែ រាជ ហាក់ដូចជា មានអារម្មណ៍ គិត ទៅ លើ នីកា លើស ពី មិត្តភក្តិទៅ ទៀត ។
លោក អះអាង ដូច្នេះ ដោយ លោក គិត ថា នេះ ជា រឿង របស់ ជាតិ របស់ ប្រទេសជាតិ មិន មែន ជា ប្រយោជន៍ បុគ្គល ទេ ។
មុន ដំបូង ពួក ក្មេង ៗ
លោក បាន កាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ប្រទេស នេះ អស់ រយៈពេល ជាច្រើន ឆ្នាំ គឺ ចាប់តាំងពី លោក មាន អាយុ ៣៣ឆ្នាំ មក ម្ល៉េះ ដែល អាច រាប់ បាន ថា ជា នាយក រដ្ឋមន្ត្រី ដែល មាន អាយុ តិច បំផុត ។
បើសិន លោក សម រង្ស៊ី និយាយ គាំទ្រ វា អាច មាន គន្លឹះ មួយ ដើម្បី ទៅ មុខ តទៅទៀត ។
យើង ទាំងអស់ គ្នា យល់ស្រប គ្នា ថា
ហើយ បើ មាន គេ បង្ក្រាប ដោយ អំពើហឹង្សា ខ្ញុំ អត់ ចូលរួម ទេ ។
ក្រុម អ្នកស្រាវជ្រាវ ជនជាតិ អង់គ្លេស បាន និយាយ ថា មនុស្ស អាយុ ៥២ ឆ្នាំ ហើយ មាន ការឃ្លាត ឆ្ងាយ
២៥ លោក ធ្វើដំណើរ ចេញពី ទីនោះ ឆ្ពោះ ទៅកាន់ ភ្នំ កើមែល រួច ត្រឡប់ ទៅ ក្រុង សាម៉ារី វិញ ។
តែងតែ ធ្វើ ក្រោយពេល រួមភេទ រួច ។
មូលហេតុ ទូទៅ ដែល ធ្វើអោយ ស្ត្រី មិន អាច មាន គភ៌ បាន
ដល់ ខ្មែរ យើង ទើបតែ ខាន ច្បាំង ពី ឆ្នាំ ១៩៩៨មក ទេ ។
តែង ខ្លួន បែប នេះ សុវត្ថិ មុន្នី វណ្ណ ពិតជា ធ្វើឱ្យ នារី ៗ
អាជ្ញាធរ នឹង ផាក ពិន័យ អ្នកធ្វើដំណើរ តាម ច្រក ព្រំដែន ដែល មិន សហការ ឱ្យ ត្រួតពិនិត្យ សុខភាព
អ្វី ដែល រាសី ឡើង គឺ នៅ ថ្ងៃទី ២១ ខែមេសា
មាន ឃ្លា ខុសគ្នា ។
ចេញ ធ្វើ បែប នេះ មួយ សប្តាហ៍ ២ទៅ ៣ដង លោក អ្នក នឹង ទទួលបាន លទ្ធផល ព្រោះ ខ្ញុំ ផ្ទាល់ បាន សាកល្បង រួច មកហើយ …
ពួកគេ ហើយនិង ធ្វើ វា បាន ល្អ ជាង ស្ត្រី ជា ម្តាយ ទៀតផង ។
លោក ថា ពេល ខ្លះ មេដឹកនាំ អាច គិត ត្រូវតែ ពេល ខ្លះ ត្រូវ មើល ប្រទេស ជិតខាង និង ទំនោ អន្តរជាតិ ។
វា អាស្រ័យ លើ សមត្ថភាព របស់ បុគ្គល ម្នាក់ ។
ងើយ ស្កក ឳន ដាក់ គ្រាប់ - សុភាសិត ខ្មែរ អធិប្បាយ
មនុស្ស ភាគ ច្រើន ចូលចិត្ត និយាយ តែ មិន ចូលចិត្ត ធ្វើ ចូលចិត្ត សរសើរ ស្អប់ ការបង្អាប់ ។
ភរិយា អ្នកផលិត រឿង ម្តាយ ខ្ញុំ លក់ ខ្ញុំ ដែល ត្រូវ ចាប់ខ្លួន រក អន្តរាគមន៍ ពី ស្ថានទូត រុស្ស៊ី
ពិធី បុណ្យ នេះ តែង ប្រារព្ធ ធ្វើ ក្នុង រយៈពេល ២ ថ្ងៃ ហើយ វា បាន ទាក់ទាញ មនុស្ស រាប់ រយ នាក់ ឱ្យ ចូលរួម ។
តើ អ្នក ត្រូវការធ្វើ ទំនាក់ទំនង អ្វី និង ជាមួយ នរណា អោយ ពិតប្រាកដ ទៅ ?
នារី ម្នាក់ ចូលចិត្ត អ្នក មាន កាយវិការ បែប ណា ?
លោក បាន សន្យា ថា ការចាប់ ដៃ គ្នា រវាង រូបលោក ផ្ទាល់ និង លោក កឹម សុខា នឹង មិន អាច មាន នណា ម្នាក់ មក បំបែកបំបាក់ បាន ឡើយ ។
វា បាន ប្រាប់ យើង ពី គម្រោង នានា ក្នុង ការវាយប្រហារ លើក ក្រោយ ៗ
បើ យ៉ាង នេះ ព្រះអង្គ ឈួន ដា ត្រូវ បរាជិក រហូតដល់ បី មិន អាច សម្តែង អាបត្តិ បាន ឡើយ ។
យើង សុទ្ធតែ ដឹង ថា ស្ត្រី មាន អាយុកាល ជា មធ្យម វែង ជាង បុរស ។
ឥឡូវ មិន ទាន់ ដឹង មកពី មូលហេតុ អ្វី ពិតប្រាកដ បណ្តាលឱ្យ ឆេះ ដូច្នេះ នៅឡើយ ទេ ។
ទឹក លិច ផ្លូវ ស្ទើរ គ្រប់ ទីកន្លែង ទាំងអស់ ។
វា ជា សកម្មភាព ភេរវកម្ម និង ជា ទង្វើ នៃ ការស្អប់ ៕
គួរ ដុស ធ្មេញ យ៉ាងតិច ពីរ ដង ។
អត់ មាន សម្រាប់ លីនុច ផង
នៅក្នុង ប្រទេស ចិន ប្រើ កម្មវិធី លើស ពី ៤០ នាទី ក្នុង មួយ ថ្ងៃ
គ្រាន់តែ ចុច លុប ។
ដល់ មជ្ឈិម វ័យ ទើប មាន ការរីកលូតលាស់ និង ចម្រុង ចម្រើន ។
ភ្ជាប់ ជាមួយនឹង បញ្ហា ប្រឈម នៃ ការចូលរួម របស់ ស្ត្រី នេះ ទាមទារ ឱ្យ មាន ការបើក ចិត្ត ឱ្យ ទូលាយ មែនទែន ពីសំណាក់ សហគមន៍ ពីសំណាក់ អ្នក នៅ ជុំវិញ ខ្លួន របស់ គាត់ ឱ្យ យល់ឃើញ ពី សារៈសំខាន់ របស់ ស្ត្រី ។
គាត់ បាន និយាយ ថា ក្មេង ៗ
ក្រុមហ៊ុន នេះ គ្រោង សង់ ស្ពាន ចំនួន បី ឆ្លង ស្ទឹង នេះ ។
ចូលចិត្ត ធ្វើ ម្ហូប ៖
នាង ទេវី ព្រឺព្រួច ក្នុង ក្នុង ចិត្ត ។
អ្នកគាំទ្រ របស់ យើង មក ចួូល រួម ដោយ មិន រំពឹង ថា ទទួលបាន អ្វី សម្រាប់ ខ្លួន គេ ឡើយ ។
រីឯ ពេលវេលា និង កម្មវិធី ប្រកួត មាន ដូច ខាងក្រោម ៖
ប្រទេស កម្ពុជា គ្រោង នឹង រៀបចំ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ដើម្បី បង្កើត រដ្ឋាភិបាល ថ្មី មួយ ដឹកនាំ ប្រទេស សម្រាប់ អាណត្តិ ទី៦រយៈពេល ៥ឆ្នាំ ទៅ មុខ ទៀត ។
១.២ឆក្កនិបាត ជាតក
បើ ពិនិត្យ ពី ថវិកា ជាតិ និង ហិរញ្ញវត្ថុ ហើយ មក ត្រឹមតែ បួន ថ្ងៃ
កំពង់ផែ ទេសចរណ៍ នៅ ខេត្ត កំពត នឹង ចាប់ផ្តើម សាងសង់ នៅ ឆ្នាំ នេះ
ខ្ញុំ គិត ថា យើង នឹង ទទួលបាន ចម្លើយ លើ សំណួរ ទាំងនោះ ក្នុង ពេល ឆាប់ ៗ
គ្រប់គ្រង កូដ ជាមួយនឹង កម្មវិធី GIT
