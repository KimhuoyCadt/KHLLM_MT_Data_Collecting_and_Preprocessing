ដោយសារ កម្លាំង និង ប្រាជ្ញា របស់ យើង ផ្ទាល់
ប្រភេទ កីឡា ដែល មិន ទាន់ ដណ្តើម បាន មេដាយ ត្រូវតែ ពង្រឹង ខ្លួន ឱ្យ បាន ល្អ ។
ដូច្នេះ លោក ថា គណៈកម្មការ នៅ មិន ទាន់ អាច ឆ្លើយ ប្រាប់ ពី លទ្ធផល នៃ ការចុះបង្ក្រាប នេះ បាន ទេ ។
ការសម្តែង របាំ អប្សរា បាន ក្លាយជា ប្រពៃណី ជាតិ ។
ក្នុង ចំណោម ប្រជាជន ទាំងនោះ អ្នក ខ្លះ សំដែង ការខកចិត្ត ព្រោះថា ពួកគាត់ ចំណាយ ពេល និង ថវិកា ធ្វើដំណើរ ដើម្បី គោរព ព្រះបរម រូប ក៏ ដូចជា ការគោរព ដល់ ព្រះវិញ្ញាណក្ខន្ធ របស់ ព្រះអង្គ តែ ត្រូវ សមត្ថកិច្ច ហាមឃាត់ ទៅ វិញ ។
ទំព័រ ដើម ស្វែងរក ក្នុង វេបសាយ - បុណ្យ អំណរ បាយ ថ្មី
ភាគ ច្រើន ការកើត ជាំ មុខ ដូចជា ៖
មាន ចំនួន រាប់ លាន រាប់ កោដិ
មាន បញ្ជី នៃ លទ្ធភាព ថា ហេតុ អ្វី បានជា កម្មវិធី បម្លែង វីដេអូ របស់ អ្នក បាន ឈប់ ធ្វើ ការ ជា ។
កន្លែង នេះ ក្រពេក ។
ប៉ុន្តែ ខ្ញុំ គិត ថា ដោយសារតែ សមត្ថភាព របស់ រដ្ឋាភិបាល យើង ឃើញ ថា រដ្ឋាភិបាល ត្រូវ បង្ហាញ ឱកាស មួយ និង ត្រូវ ដើរ តួនាទី ក្នុង ការធ្វើជា តំណាង ឱ្យ ប្រទេស ទាំងនោះ ។
ហើយ ខ្ញុំ ស្រឡាញ់ បេក្ខជន មួយ ណា ឱ្យ គេ ចុះឈ្មោះ ឱ្យ ខ្ញុំ ទៅ ខ្ញុំ ផ្ញើ ទៅ ឱ្យ គេ អា ហ្នឹង ខ្ញុំ ក៏ ចាប់អារម្មណ៍ បោះ ។
វា មិន មាន ឧបសគ្គ សម្រាប់ កីឡាការិនី នោះ ទេ ។
ជនជាប់ចោទ ១០២ នាក់ ក្នុង នោះ មាន មេទ័ព ថៃ ម្នាក់
ដូច្នេះ ធ្វើឱ្យ គាត់ ខឹង ក៏ បាន ចាប់ ដោះ អាវ កូន តែ ម្តង ដើម្បី ធ្វើឱ្យ នាង រាងចាល ប៉ុណ្ណោះ ។
សប្តាហ៍ ក្រោយ សូម ជូន ភាគ ទី៤ អំពី ផ្នត់គំនិត អ្នកដឹកនាំ យួន ចំពោះ ជនជាតិ ខ្មែរ ពី ឆ្នាំ ១៩៣០មក ទល់ បច្ចុប្បន្ន ។
តែ ខណៈពេល ដែល ពួកគេ កំពុង គូរូប គំនូរ និង ឆ្លាក់ រូប ដែល ស្តី អំពី ពិធី លៀង ព្រះអម្ចាស់ ពួកគេ ស្រាប់តែ មានអារម្មណ៍ ល្អ បង្ហូរ ចេញមក ក្នុង ចំណោម ពួកគេ ដោយ ឯកឯង ។
យប់ នេះ នឹង មាន រថយន្ត ដឹក ឈើ ប្រណីត ច្រើន គ្រឿង សម្រុក ចេញ ពី ស្រុក សៀម ប៉ាង ខេត្ត ស្ទឹងត្រែង
ការញ៉ាំ បែប នេះ ក្នុង រយៈពេល យូរ នឹង ធ្វើឱ្យ ប្រព័ន្ធ ភាពស៊ាំ របស់ យើង ចុះខ្សោយ ។
ផ្សារ ភាគហ៊ុន កម្ពុជា បើក ដំណើរការ ថ្ងៃ ដំបូង
ការធ្វើ លំហាត់ប្រាណ ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការលើក កំពស់ កម្រិត IQ របស់ ទារក ។
ឥត ឈប់ឈរ នៅតែ ញញឹម រាក់ទាក់ ស្វាគមន៍ ភ្ញៀវ មក កម្សាន្ត ជានិច្ច ។
នរណា ដែល មិន ដឹង មិន ឮ អំពី ឥទ្ធិពល លទ្ធភាព និង មហិច្ឆិតា របស់ ចិន ក្នុង ពេល បច្ចុប្បន្ន នេះ ?
និង ផ្សព្វផ្សាយ ពាណិជ្ជកម្ម ផងដែរ ។
លទ្ធផល ចុងក្រោយ គឺ ពិភពលោក នឹង មាន សន្តិភាព ។
ប៉ុន្តែ ប្រាំពីរ ខែ ក្រោយមក ក្រុម អ្នក សង្កេតការណ៍ ជាច្រើន កំពុង ចោទ សួរ អំពី គុណ តម្លៃ នៃ កិច្ចព្រមព្រៀង នេះ ។
សុវត្ថិ មុនី វណ្ណ អរគុណ ដល់ អ្នកគាំទ្រ ដែល បាន ជូន កាដូ កាលពី យប់ មិញ !
តើ ការរង្គោះរង្គើរ នេះ បាន ប៉ះពាល់ ដល់ ប្រទេស កម្ពុជា ទាំងមូល និង ខ្លួនអ្នក ផ្ទាល់ ដោយ របៀប ណា ?
អង្គភាព យើង មិន អាច សុំ ការបកស្រាយ ពី លោក លន់ សុផាត ស្នងការនិង លោក វ៉ាថន ចៅហ្វាយ ខេត្ត ក្រចេះ បាន នោះ ទេ ?
ខ្ញុំ សំណូមពរ ឱ្យ អាជ្ញាធរ ជួយ រក យុត្តិធម៌ ជូន ពលរដ្ឋ ព្រោះ អី ពលរដ្ឋ ពិបាក ។
ឆ្នាំ កន្លងទៅ នេះ យើង សល់ ស្រូវ ប្រមាណ ជិត ៦លាន តោន ឯណោះ ។
លោក កឹម សុខា អាច ដើរ ហើរ ក្នុង ប្រទេស កម្ពុជា ក្រោយពេល ទទួលបាន ការបន្ថូរ បន្ថយ លក្ខខណ្ឌ នៅ ក្រៅ ឃុំ
ចំពោះ ទស្សនកិច្ច របស់ លោក សម រង្ស៉ី វិញ ជា ដំណើរ ស្វែងរក ផលប្រយោជន៍ នយោបាយ ដូចគ្នា ។
អ្នកទស្សនា គួរ ពិនិត្យមើល សេចក្តីជូនដំណឹង អំពី ឯកជន ភាព របស់ វិបសៃ ដទៃ នោះ ពីព្រោះ យើង មិន មាន ការគ្រប់គ្រង ទៅ លើ ព័ត៌មាន ដែល បាន ប្រគល់ ជូន ឬ ប្រមូល ដោយ ភាគី ផ្សេង ទាំងនេះ ឡើយ ។
យើង ឧស្សាហ៍ ផ្សាយ ព័ត៌មាន ពី ពួកគាត់ ណាស់ ។
និង ធ្វើឱ្យ គ្រប់ គ្នា ភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង ពេល ដឹង ដំណឹង នេះ ។
សម្តេច ហេង សំរិន បាន ពន្យល់ ថា ៖
អគ្គិសនី កម្ពុជា ក៏ បាន បញ្ជាក់ ដែរ ថា មូលហេតុ នៃ ការផ្អាក ការផ្គត់ផ្គង់ អគ្គិសនី នេះ គឺ ដើម្បី អនុវត្ត ការង …
វា ជា ភាពផ្ទុយ គ្នា ស្រឡះ ដែល កំពុង ធ្វើឱ្យ បាត់បង់ជីវិត មនុស្ស ។
