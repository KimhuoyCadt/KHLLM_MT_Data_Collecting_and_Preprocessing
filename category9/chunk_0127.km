យោង តាម មជ្ឈមណ្ឌល អាស៊ាន កូរ៉េ មាន កិច្ច ព្រម ព្រៀង មាន តម្លៃ ជាង ២ លាន ដុល្លារ ដែល បាន ចុះ ហត្ថលេខា នៅ ក្នុង ពិព័រណ៍ ពាណិជ្ជកម្ម ពី ឆ្នាំ មុន ។
ក្រុមហ៊ុន កម្ពុជា ១០ ដែល បាន ចូលរួម នៅ ក្នុង ការ តាំង ពិព័រណ៍ ឆ្នាំ នេះ ត្រូវ បាន ជ្រើសរើស ដោយ ក្រសួង ពាណិជ្ជកម្ម ដោយ ឈរ លើ មូលដ្ឋាន ផលិតផល របស់ ពួក គេ និង សមត្ថភាព ក្នុង ការ នាំ ចេញ ទៅ ប្រទេស កូរ៉េ ខាង ត្បូង ។
ប៉ុន្តែ លោក បាន ថ្លែង ថា មាន ការ ពិបាក ក្នុង ការ ប្រកួត ប្រជែង សម្រាប់ ផលិតផល កម្ពុជា ក្នុង ការចូល ទីផ្សារ កូរ៉េ ។
អាជីវកម្មផ្តល់សេវាបុណ្យ សពជនបរទេសនៅកម្ពុជា
តើ ក្រុមហ៊ុន របស់ អ្នក ផ្តល់ សេវា អ្វី ខ្លះ ?
តើ អ្នក ប្រតិបត្តិការ រយៈពេល យូរ ប៉ុន្មាន ហើយ ?
យើង ប្រតិបត្តិការ នៅ ទីនេះ រយៈពេល ១០ ខែ ហើយ ។
ខ្ញុំ ប្រតិបត្តិការ អាជីវកម្ម បុណ្យ សព អស់ រយៈពេល ១១ ឆ្នាំ ហើយ ហើយ មាន អាជ្ញាប័ណ្ណ នាយក បុណ្យ សព កន្លង មក ចំនួន ៣ ។
បច្ចុប្បន្ន ខ្ញុំ មាន អាជ្ញាប័ណ្ណ និង រក្សា អាជ្ញាប័ណ្ណ ពេញ លេញ តាម រយៈ រដ្ឋ វ៉ាស៊ីនតោន ហើយ ខ្ញុំ មាន សញ្ញាបត្រ ខាង អប់ សព ( ការ រក្សា សាកសព ) និង ការ រៀបចំ ពិធី បុណ្យ សព ។
ដំបូង ក្រសួង ពាណិជ្ជកម្ម មិន ប្រាកដ ថា អ្វី ជា ប្រភេទ អាជ្ញា ប័ណ្ណ ដើម្បី ផ្ដល់ ឲ្យ យើង នោះ ទេ ដោយ សារ តែ មិន មាន បច្ចេកទេស ដូចជា ផ្ទះ បុណ្យ សព នៅ ក្នុង ប្រទេស កម្ពុជា នោះ ហើយ យើង បាន ទទួល អាជ្ញាប័ណ្ណ ជា ក្រុមហ៊ុន ផ្ដល់ សេវា បុណ្យ សព ។
តើ អ្នក ប្រតិបត្តិការ សេវា សម្រាប់ អ្នក ដែល មាន សាសនា ខុស ៗ គ្នា ដូច ម្ដេច ?
ខ្ញុំ មាន នាម ប័ណ្ណ ទំនាក់ ទំនង សម្រាប់ មេ ដឹក នាំ សាសនា ក្នុង ស្រុក ជាច្រើន ។
ខ្ញុំ តែងតែ ផ្ដល់ សេវា ប្រភេទ នេះ មួយ ចំនួន ។
កន្លែង ដែល តម្លៃ ប្រែប្រួល គឺ ការ ដឹក ជញ្ជូន ។
ការ ដឹក ជញ្ជូន សាកសព ទាំង មូល ទៅ ផ្ទះ មាន តម្លៃ មិន ក្រោម ៨០០០ ដុល្លារ ហើយ វា ដោយ សារ តែ តម្រូវការ ទាំង អស់ ក្នុង ការ ដឹក ជញ្ជូន ពី ក្រុមហ៊ុន អាកាស ចរណ៍ ។
យើង ស្ថិត ក្នុង បរិយាកាស ត្រូពិក ប្រសិន បើ អ្វី ៗ មិន ដំណើរ នៅ ក្នុង ល្បឿន រហ័ស នោះ ទេ ការ អប់ សព អាច ពិបាក យ៉ាង ខ្លាំង ។
តើ ការ ផ្សព្វផ្សាយ ពាណិជ្ជកម្ម សេវា របស់ អ្នក ដូច ម្ដេច ?
ការ ផ្សព្វផ្សាយ ពាណិជ្ជកម្ម ជា ការ ចំណាយ ប្រាក់ ឥត ប្រយោជន៍ សម្រាប់ ពួក យើង ។
ប្រជាជន ស្វែងរក យើង តាម អន ឡាញ ។
ពេល សាក សព ជន បរទេស ត្រូវ បាន រក ឃើញ មន្ដ្រី ព្យាយាម ស្វែងរក អត្ត សញ្ញាណ របស់ ពួក គេ ដើម្បី ជូន ដំណឹង ដល់ ស្ថាន ទូត ។
ឧបករណ៍ របស់ យើង និង ផលិតផល ប្រើ ទាំង អស់ មក ពី ប្រទេស អាមេរិក ចិន ថៃ និង អូស្រា្ដលី ។
របស់ ជា មូលដ្ឋាន ដូច ជា ស្បៃ បង់ ស្អិត វេជ្ជសាស្ដ្រ សារធាតុ គីមី សម្រាប់ រុំ និង សម្អាត ដែល យើង ទទួល បាន ពី ក្រុមហ៊ុន ផ្គត់ផ្គង់ វេជ្ជសាស្ដ្រ ក្នុង ស្រុក ។
អ្វី ជា សេចក្ដី សង្ឃឹម របស់ អ្នក សម្រាប់ ពេល អនាគត សម្រាប់ សេវា នេះ នៅ កម្ពុជា ?
វា អាក្រក់ ណាស់ ។
កម្ពុជា នឹង ទទួល ប្រយោជន៍ ពី ប្រព័ន្ធ អ្នក វិភាគ ស ព ឯករាជ្យ និង កណ្ដាល ជាមួយ នឹង អត្រា និង នីតិវិធី ដែល បាន បង្កើត ឡើង ជា ជាង ការ ពឹង លើ ក្រុមហ៊ុន វេជ្ជសាស្ដ្រ និង ក្រុមហ៊ុន ឯកជន រក ប្រាក់ ចំណូល ។
កន្លែង កណ្ដាល ដែល អាច ត្រូវ បាន ប្រើប្រាស់ ជា ទី ក្រុង ដាក់ សព នឹង កាត់ បន្ថយ ការ យល់ ច្រឡំ ។
ពិធី បុណ្យ សព តាម ប្រពៃណី គឺជា ពិធី ស្រមោល ។
យើង គឺជា ក្រុមហ៊ុន យើង មាន ទូ ក្លាស្សេ ធំ ៗ ហើយ មាន សាកសព ក្នុង ទូ ក្លាស្សេ នោះ ។
ភាព មិន អើពើ គឺជា សេចក្ដី សុខ ពេល និយាយ អំពី រឿងរ៉ាវ ខ្លះ ៕
កាស៊ីណូនិងសណ្ឋាគារ Naga2 បើកសាកល្បង
ការ បើក ដំណើរ ការ សាក ល្បង នេះ មាន រយៈ ពេល រហូត ដល់ ថ្ងៃទី ៤ ខែ វិច្ឆិកា និង ផ្ដល់ ការ បញ្ចុះ តម្លៃ ៨០ ភាគ រយ ដល់ ប្រជាជន កម្ពុជា លើ អាហារ និង ការ ប្រគំ តន្ដ្រី របស់ ខ្លួន ទោះបីជា ប្រជាជន កម្ពុជា ត្រូវ បាន ហាម ឃាត់ ដោយ ច្បាប់ មិន ឲ្យ មាន សកម្ម ភាព លេង ល្បែង នៅ ក្នុង ការ ស៊ីណូ ក៏ ដោយ ។
អាមេរិកដកពន្ធលក់បង្ខូចថ្លៃលើបន្ទះអាលុយមីញ៉ូមចិន
ការ ហូត ពន្ធ ថ្មី នេះ កើត មាន ឡើង បន្ទាប់ពី មាន ការ សម្រេច របស់ ក្រសួង ពាណិជ្ជកម្ម អាមេរិក នៅ ខែ សីហា ដែល ក៏ បាន ហូត ពន្ធ នាំ ចូល ផង ដែរ ដើម្បី ឆ្លើយតប នឹង ការ ឧបត្ថម្ភ ធន ចិន ដោយ មិន ស្មើភាព ដែល ត្រូវ បាន ចោទប្រកាន់ ក្នុង ឧស្សាហកម្ម បន្ទះ អាលុយមីញ៉ូម ។
លោក ប្រធានាធិបតី ដូណាល់ ត្រាំ នឹង ធ្វើ ដំណើរ ទស្សនកិច្ច នៅ ប្រទេស ចិន ដែល ជា ផ្នែក មួយ នៃ ដំណើរ ទស្សនកិច្ច របស់ លោក រយៈពេល ១១ ថ្ងៃ ទៅ កាន់ តំបន់ អាស៊ី ដែល នឹង ចាប់ផ្តើម នៅ សប្តាហ៍ នេះ ។
រដ្ឋបាល របស់ លោក ត្រាំ បាន ព្យាយាម យ៉ាង អន្ទះសា ស្វែងរក ដំណោះស្រាយ បញ្ហា ពាណិជ្ជកម្ម នៅ ក្នុង ទំនាក់ ទំនង ពាណិជ្ជកម្ម ជាមួយ នឹង រដ្ឋាភិបាល ក្រុង ប៉េកាំង ដោយ បាន ស៊ើបអង្កេត លើ ការ អនុវត្ត ពាណិជ្ជកម្ម របស់ ចិន លើ កម្មសិទ្ធិ បញ្ញា និង ការ ស៊ើបអង្កេត លើ ពាណិជ្ជកម្ម អាលុយមីញ៉ូម និង ដែក ដោយ ឈរ លើ មូលហេតុ សន្តិសុខ ជាតិ ។
ការ ប្រព្រឹត្ត មិន ត្រឹមត្រូវ របស់ ចិន ដែល ត្រូវ បាន គេ កត់សម្គាល់ ផ្នែក ពាណិជ្ជកម្ម គឺជា មូលដ្ឋាន នៃ យុទ្ធនាការ ដ៏ មាន ប្រជាប្រិយភាព របស់ លោក ត្រាំ ដើម្បី ឡើង កាន់ តំណែង នៅ សេតវិមាន តែ ចាប់ តាំងពី បាន ឡើង កាន់ តំណែង មក លោក មិន បាន ចាត់ទុក ថា រដ្ឋាភិបាល ក្រុង ប៉េកាំង គឺជា អ្នក កេងប្រវ័ញ្ច រូបិយប័ណ្ណ ទេ ។
