មិនអាចបើកឯកសារ % 1 សម្រាប់សរសេរ ។
ឯកសារត្រូវបានរក្សាទុក
មិនអាចបើកឯកសារ % 1បានឡើយ
មើលកាតាឡុកជាមុន
ក្រឡា ច ត្រង្គកូអរ ដោណេ
មិនអាចបើកឯកសារ % 1បានឡើយ
ប្រើពណ៌ផ្ទាល់ខ្លួនសម្រាប់ វាយបន្ទាត់
ពណ៌សម្រាប់បន្ទាត់គ្រូ
បន្ទាត់របស់គ្រូ
ផ្លាស់ប្តូរពណ៌អត្ថបទសម្រាប់បន្ទាត់សិស្ស
អ្នកអាចផ្លាស់ប្ដូរពណ៌នៃអត្ថបទដែលអ្នកវាយក្នុងបន្ទាត់សិស្ស នៅទីនេះ ។
ផ្ទៃខាងក្រោយសម្រាប់បន្ទាត់របស់គ្រូ
នៅ ទីនេះ អ្នកអាចផ្លាស់ប្ដូរពណ៌ផ្ទៃខាងក្រោយសម្រាប់បន្ទាត់របស់គ្រូ ( បន្ទាត់អក្សរអ្នកអ្នកត្រូវតែវាយ )
ប្រើពណ៌ផ្សេងនៅលើការ វាយដែលរំលង
ជ្រើស ពណ៌ផ្ទៃខាងក្រោយសម្រាប់កំហុសក្នុងបន្ទាត់ដែលវាយ
នៅពេលអ្នកបានធីក ' ប្រើពណ៌ខុស ៗ គ្នាពេលមានកំហុសក្នុងបន្ទាត់ដែលវាយ ' បន្ទាប់អ្នកអាចជ្រើស ពណ៌សម្រាប់ផ្ទៃខាងក្រោយនៃកំហុស ។ អ្នកនឹងមានកំហុសពេលដែលអ្នកវាយតួអក្សរខុសក្នុងបន្ទាត់ដែលវាយ ។ វាជាមធ្យោបាយសម្រាប់ធ្វើឲ្យឃើញកំហុសរបស់អ្នក ។
ជ្រើស ពណ៌អត្ថបទ ពេលមានកំហុសក្នុងការវាយតាមបន្ទាត់
នៅពេលអ្នកបានធីក ' ប្រើពណ៌ខុស ៗ គ្នាពេលមានកំហុសក្នុងបន្ទាត់ដែលវាយ ' បន្ទាប់អ្នកអាចជ្រើស ពណ៌សម្រាប់អត្ថបទកំហុស ។ អ្នកនឹងមានកំហុសពេលដែលអ្នកវាយតួអក្សរខុសក្នុងបន្ទាត់ដែលវាយ ។ វាជាមធ្យោបាយសម្រាប់ធ្វើឲ្យឃើញកំហុសរបស់អ្នក ។
ឧបករណ៍បង្កើតពណ៌ចម្រ
គ្រោង ពណ៌ដែលបាន កំណត់ដោយអ្នកប្រើ
ឈ្មោះពណ៌ចម្រុះ ៖
ពណ៌បន្ទាត់ស្លាយ
ផ្ទៃខាងក្រោយរបស់គ្រូ ៖
អត្ថបទ របស់ គ្រូ ៖
ផ្ទៃខាងក្រោយសិស្ស ៖
អត្ថបទសិស្សពេលមាន កំហុស៖
ផ្ទៃខាងក្រោយសិស្សពេលមានកំហុស ៖
ពណ៌ផ្ទៃខាងក្រោយសម្រាប់គ្រាប់ ចុចធម្មតា៖
ផ្ទៃខាងក្រោយដែលបានបន្លិច ៖
ពណ៌គ្រាប់ ចុចធម្មតា៖
ពណ៌អត្ថបទដែលបានបន្លិច ៖
ស៊ុមគ្រាប់ ចុច ៖
គ្រាប់ចុច កែប្រែ / ផ្សេង ៖
លៃតម្រូវកម្រិតស្វ័យប្រវត្តិ
ភាពត្រឹមត្រូវ ៖
បំពេញកម្រិតបង្រៀនទាំងមូលមុននឹងបន្ត
ដែនកំណត់ដែលត្រូវបង្កើនកម្រិត
ដែនកំណត់ដែលត្រូវ បន្ថយកម្រិត
បិទប៊ូតុងផ្លាស់ប្ដូរកម្រិតដោយដៃ
ការកំណត់បន្ទាត់អត្ថបទ
បដិសេធពុម្ពអក្សរបង្រៀន
ពុម្ពអក្សរសម្រាប់អត្ថបទដែល បង្ហាញ / វាយ ៖
ប៊ូតុងនេះនឹងបង្ហាញប្រអប់ពុម្ពអក្សរដែលអ្នកអាចផ្លាស់ប្ដូរពុម្ពអក្សរសម្រាប់បន្ទាត់សិស្ស និង គ្រូ ។ ពេលអ្នក ចាកចេញពីប្រអប់ពុម្ពអក្សរ ពុម្ពអក្សរថ្មីត្រូវបានបង្ហាញជាមុនក្នុងបន្ទាត់ខាងក្រោម និង ត្រូវបានអនុវត្ត តែនៅពេលអ្នកចុចប៊ូតុងអនុវត្តខាងក្រោម ។
កម្មវិធី និពន្ធ ប្លង់ ក្តារ ចុច
ទិន្នន័យអត្តសញ្ញាណក្ដារចុច
ចំណងជើងគ្រាប់ ចុច៖
លេខ សម្គាល់ភាសា៖
លក្ខណៈ សម្បត្តិគ្រាប់ ចុច
ជ្រើស គ្រាប់ ចុចម្រាម ដៃ
ជម្រើសកែសម្រួលក្ដារចុច
រក្សាទុកក្ដារចុច
ធរណី មាត្រគ្រាប់ ចុច
បន្ទាត់ តភ្ជាប់ក្ដារចុច
ជម្រះបន្ទាត់ តភ្ជាប់
បន្ថែម / ធ្វើឲ្យបន្ទាត់ តភ្ជាប់ទាន់ សម័យ
ប្លង់ក្ដារចុច ( ចុចដើម្បីធ្វើឲ្យ គ្រាប់ ចុចសកម្មសម្រាប់ កែសម្រួល ឬអូសគ្រាប់ ចុច )
កម្រិតបច្ចុប្បន្ន
វាបង្ហាញកម្រិតមួយ ណាដែលអ្នក នៅ ។
នេះបង្ហាញថាអ្នកវាយលឿនយ៉ាង ណា ។ វាវាស់ល្បឿនវាយគិតជាតួអក្សរក្នុងមួយវិនាទី ។
តើអ្នកវាយបានត្រឹមត្រូវប៉ុន្មាន ?
នេះបង្ហាញថាអ្នកវាយត្រឹមត្រូវយ៉ាង ណា ។
តួអក្សរថ្មីក្នុងកម្រិតនេះ
បន្លឺ សម្លេង ប៊ីបចំពោះកំហុសក្នុងការ វាយនីមួយ ៗ
បើធីក ( លំនាំដើម ) វានឹងបន្លឺសម្លេងគ្រប់ពេលដែលអ្នកធ្វើឲ្យមានកំហុស ក្នុងការ វាយ ។
បង្កើតសំឡេងម៉ាស៊ីន អង្គូលី លេខសម្រាប់ កា រ ចុចគ្រាប់ ចុចនីមួយ ៗ
ប្រសិនបើបានគូស ធីក វានឹងចាក់សំឡេងម៉ាស៊ីនអង្គូលី លេខសម្រាប់រាល់ កា រ ចុចគ្រាប់ ចុច ។
លេងសម្លេងពេលកម្រិតផ្លាស់ប្ដូរដោយស្វ័យប្រវត្តិ ។
បើធីកនេះ ( លំនាំដើម ) សម្លេងនឹងត្រូវបានលេងដោយស្វ័យប្រវត្តិគ្រប់ពេលដែលអ្នកផ្លាស់ប្ដូរកម្រិតដោយស្វ័យ ប្រវត្តិ ។
សេចក្ដី សង្ខេបកម្រិតបង្រៀន
ពិន្ទុខ្ពស់សម្រាប់កម្រិតនេះ
តួអក្សរក្នុងមួយវិនាទី
ពិន្ទុខ្ពស់ទាំងអស់សម្រាប់កម្រិតនេះ
លក្ខណៈ សម្បត្តិការ បង្រៀន
កម្មវិធី និពន្ធកម្រិត
ទិន្នន័យកម្រិតនៃកម្រិត ១០
សេចក្តីអធិប្បាយកម្រិត( ដែលអាចជ្រើស បាន ) ៖
តួអក្សរថ្មីក្នុងកម្រិតនេះ៖
ទិន្នន័យកម្រិត ៖
ស្ថិតិ ការ បង្ហាត់
សម័យ ការ បង្ហាត់បច្ចុប្បន្ន
ស្ថិតិសម័យការបង្ហាត់បច្ចុប្បន្ន
កម្រិតក្នុងសម័យនេះ
តួអក្សរដែលបានវាយ៖
ចំនួនពាក្យដែលបានវាយកន្លង មក ។
បង្ហាញចំនួនតួអក្សរខុសដែលអ្នកបានវាយ ។
ចំនួនតួរ អក្សរ( ត្រឹមត្រូវ និង ខុស ) ដែលអ្នកបានវាយកន្លង មក។
វាបង្ហាញចំនួនវិនាទីដែលអ្នកបានវាយក្នុងសម័យ បង្ហាត់នេះ ។
តួអក្សរដែលបានវាយខុស៖
ពាក្យដែលបានវាយ៖
សម មាត្រនៃ តួអក្សរដែលបានវាយត្រឹមត្រូវធៀបនិងចំនួនតួអក្សរដែលបានវាយសរុប ។
ចំនួនពាក្យដែលអ្នកបានវាយក្នុងមួយនាទី។
ចំនួនតួរ អក្សរត្រឹមត្រូវដែលបានវាយក្នុងមួយនាទី។
ពាក្យក្នុងមួយនាទី៖
តូរ អក្សរក្នុងមួយនាទី៖
តួអក្សរត្រូវបានរាយនៅទីនេះ ដែលអ្នកខកខានក្នុងការ វាយកំឡុងពេលការ ប្រលងវាយ ។ ភាគរយបង្ហាញសម មាត្រនៃ ចំនួនគ្រាប់ ចុចដែលខកខានក្នុងការ វាយ ធៀបនិងចំនួនគ្រាប់ចុចដែលបានវាយជាសរុប ។ ចំនួនច្រើនបង្ហាញថា បានខកខានក្នុងការ វាយគ្រាប់ ចុចជាច្រើន ។
ស្ថិតិតួអក្សរ( តួអក្សរដែលអ្នកផ្តោតអារម្មណ៍លើ )
ស្ថិតិកម្រិតបច្ចុប្បន្ន
តួអក្សរត្រូវបានរាយនៅទីនេះដែលអ្នកបានខកខានក្នុងកំឡុងពេលការ ប្រលងវាយ ។ ភាគរយបង្ហាញសម មាត្រនៃចំនួនគ្រាប់ចុចដែលខកខាងក្នុងការ វាយធៀបនិងចំនួនគ្រាប់ចុចដែលបានវាយត្រឹមត្រូវ ។ ចំនួនច្រើនបង្ហាញថាបានខកខានក្នុងការ វាយគ្រាប់ចុចជាច្រើន ។
