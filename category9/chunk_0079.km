សេចក្តីថ្លែងការណ៍៖ ខ្ញុំ ជឿ ថា ខ្ញុំ ជាប់គាំង លើ ជំហាន ទី ៧ ដែល ត្រូវ៖
ដោយស្មានថាគាត់ ជាអ្នក ថែសួន នាងនិយាយថា « លោកម្ចាស់ បើអ្នកបានយកវាទៅហើយ សូមប្រាប់ខ្ញុំពីកន្លែងដែលអ្នកបានដាក់គាត់ចុះ ខ្ញុំនឹងយកវាទៅ » ។
មេបញ្ជាការ បាន និយាយ ថា រដ្ឋ ដែល ពាក់ព័ន្ធ នឹង គំនិត នេះ គឺ ពេញចិត្ត នឹង គំនិត នេះ ។
ពួកគេ ឈរ ជា គ្រួសារ ។
ពួកគេចង់យល់ថា ហេតុអ្វីបានជាមានរឿងនេះកើតឡើងចំពោះពួកគេ ។
ទ្រង់ផ្ទាល់បានមាន បន្ទូលថា៖ « បើអ្នក រាល់គ្នាមិនបរិភោគសាច់នៃកូនមនុស្ស ហើយមិនពិសា ព្រះលោហិតរបស់ទ្រង់ទេ នោះអ្នក រាល់គ្នាគ្មានជីវិតឡើយ » ( យ៉ូហាន ៦: ៥៣) ។
កូតា៖ ស្ត្រីមានផ្ទៃពោះ៨ ខែម្នាក់ត្រូវបានគេសម្លាប់ ខណៈពេលនោះ
ធាតុ ដូចជា ការពិត នៅក្នុង អតីត ; ពោលគឺ ស្ថានភាព នៃ ស្មារតី ។
ខ្ញុំ និង ប៉ូល កំពុង ដាក់ទង់ នៅ ទីនេះ ។
24 ហើយទ្រង់នឹងប្រគល់ស្តេចរបស់ពួកគេ មកក្នុងកណ្ដាប់ដៃអ្នក ហើយអ្នកនឹងធ្វើឲ្យឈ្មោះរបស់គេត្រូវវិនាសបាត់ បង់ ពីក្រោមស្ថាន សួគ៌ទៅ៖ គ្មាននរណាអាចឈរនៅចំពោះមុខអ្នកបានឡើយ ដរាប ណាអ្នកបានបំផ្លាញពួកគេ ។
ទោះ យ៉ាងណា ក៏ដោយ ច្រើន ជាង នេះ ទៅ ទៀត អ្នក នឹង ស្ថិត ក្នុង ពាក់កណ្តាល នៃ វគ្គ ការងារ នៅ ពេល ដែល អ្នក ត្រូវការ
ខ្ញុំបានបាត់ បង់មិត្ត ភក្តិទាំងអស់ក្នុងថ្នាក់ ទីប្រាំពីរ ។
ក្នុង នាម មនុស្ស រាប់ ពាន់ នាក់ បាន ទៅ
សេចក្តីស្រឡាញ់ ដែល ទ្រង់ ប្រទាន មក យើង ។
សាកសព ជាច្រើន ត្រូវតែ មាន ភាព ស្រដៀង គ្នា ទៅនឹង ផ្នែក ខាងក្រោម
១៥ មានសំឡេងមួយបន្លឺឡើងជាលើកទីពីរ ថា៖ « កុំនិយាយថារបស់ដែលព្រះ បានធ្វើនោះមិនបរិសុទ្ធឡើយ » ។
១៩ មុខងារ ពេល គាត់ កាន់ តំណែង ។
ខ្ញុំដឹងថានឹងមានការ ចែករំលែកបន្ថែមទៀត » ។
ខ្ញុំ នឹង តាមដាន ការដឹកជញ្ជូន ផងដែរ ។
ចំណាំ C - នៅក្នុង ការអនុវត្ត ច្បាប់ នេះ ថ្ងៃ បន្ទាប់ នឹង ត្រូវបាន ចាត់ទុក ថា ជា ថ្ងៃ ឈប់សម្រាក៖
បច្ចុប្បន្នមិនមានព័ត៌មានអំពីអ្នក រង របួសនោះទេ ។
ពួកគេនឹងមានអារម្មណ៍ថាបានស្អាតបរិសុទ្ធ ហើយពួកគេនឹងមើលទៅលើអំពើអាក្រក់ដោយសេចក្តី ស្អប់ខ្ពើម » ។
ឥឡូវគាត់មានស្រីម្នាក់ហើយនាងកំពុងតែ .. .
ដល់ ចំណុច នៃ ការបញ្ចេញមតិ ក្នុង ចំណោម ពួកគេ ។
“ ហើយជាងឆ្នាំមុននេះ ពួកគេបានផ្តល់បន្ថែមទៀត ។
« អ្នកមានពុតអើយ ចូរយកបន្ទះឈើចេញពីភ្នែករបស់អ្នក ជាមុនសិន នោះអ្នកនឹងឃើញយ៉ាងច្បាស់ ដើម្បីដកស្នាមប្រឡាក់ចេញពីភ្នែកបងប្អូនអ្នក ។
១៧ហេតុដូច្នោះហើយ នៅពេលពួកគេ មកដល់ទី នេះ ដោយមិន បង្អង់យូរទេ នៅថ្ងៃ បន្ទាប់ ខ្ញុំបានអង្គុយលើកៅអីជំនុំ ជម្រះ ហើយបានបង្គាប់ឲ្យនាំបុរសនោះចេញ ។
ពេល ខ្លះ ពួកគេ ដើរ ចេញពី យើង ។
យើងមិនចង់ឲ្យមេដឹកនាំ និងប្រទេស ដទៃសើច ចំអកដាក់យើងទៀតទេ ។
ប្រសិនបើអ្នកនឹងមិនមានព្រះ គ្រីស្ទ នោះមិនមានអ្វីផ្សេងទៀតទេ ។
ថ្មី ៗ នេះ ក្រុមហ៊ុន ត្រូវបាន រិះគន់
យើងមាន ភាពជឿនលឿនជាងពីទស្សនៈនេះ ។
មកដល់ពេលនេះ ខ្ញុំប្រមូល ផលសត្វក្តាន់បានប្រាំពីរក្បាលហើយ ។
បទពិសោធន៍ របស់ នាង ត្រូវបាន ចោទសួរ ។
ឥឡូវនេះ វា ច្បាស់ ណាស់ ថា យើង ជឿជាក់ ទាំងស្រុង សម្រាប់ អ្នក ។
ជា អកុសល នោះ គឺជា តំបន់ ដែល បាតុករ បាន កាន់កាប់ ។
មិនថាអ្នកបរិភោគ ឬផឹក ឬធ្វើអ្វីក៏ដោយ ចូរធ្វើគ្រប់យ៉ាងដើម្បីលើក ត ម្កើងព្រះ។
មុនក្លាយជាអ្នក ចម្រៀង បទអ្វី ?
ពីព្រោះ នៅ ពេល ដែល តួអង្គ នេះ លេចឡើង យើង នឹង ប្រាប់ អ្នក អំពី អ្វី មួយ ។
ខ្ញុំ មាន ទំនុកចិត្ត លើ ប៉ូលីស និង ប្រាកដ អំពី ភាពស្មោះត្រង់ របស់ ទាហាន ឥណ្ឌា របស់ យើង ផ្ទាល់ ។
ម៉្យាង វិញ ទៀត ខ្លួន ទទួលស្គាល់ ថា ប្រជាជន ម៉ាឡេស៊ី កំពុង ទាមទារ ឱ្យ មាន ការផ្លាស់ប្តូរ
អ្នក បានប្រៀបធៀបខ្លួនឯងទៅនឹងអ្នកបំបាត់ចោលការ ប្រឆាំងនឹងអ្នក កាន់ទាសករ ។
“ ហាក់ដូចជាកន្លែងកើតឡើងនៅជុំវិញតំបន់នេះ ។
20 ដោយ សារពួកគេមិនអាចទ្រាំទ្រនឹង បញ្ជាដែលពោលថា៖ « បើសូម្បីតែសត្វពាល់ភ្នំក៏ត្រូវគប់ដុំថ្មស្លាប់ដែរ » ។
សូម្បីតែ ខ្ញុំ ក៏ មិន រំពឹង ថា នឹង ចូលចិត្ត វា ដែរ ។
ពួកគេ ខ្លះ ស្ថិត ក្នុង ឈុត នេះ ហើយ ខ្លះ ទៀត កំពុង ត្រូវបាន រក្សាទុក សម្រាប់ ពេល ក្រោយ ។
សិទ្ធិ ទទួលបាន សេរីភាព និង សេរីភាព ។
និង ការរត់ ជាច្រើន ផងដែរ ។
បន្ទាប់មក វា គឺជា ផ្នែក មួយ នៃ លំនៅ ថ្មី នៃ ពិសិដ្ឋ ។
រហូតដល់ពេលវេលារបស់ទ្រង់ គ្មានអ្នក ណាអាចធ្វើ បាបទ្រង់បានឡើយ ។
២ ធី ម៉ូថេ 2:11 - ពាក្យនេះគួរឲ្យទុក ចិត្ត ដ្បិតបើយើងបានស្លាប់ជាមួយនឹងគាត់ យើងក៏នឹង រស់នៅ ជាមួយនឹងគាត់ដែរ ។
មួយ សន្ទុះ ក្រោយមក ប្អូន ស្រី របស់ នាង ក៏ បាន មក ។
ប្រសិនបើ វា ត្រូវបាន ឆ្លាក់ គ្រប់គ្រាន់ សម្រាប់ អ្នក - អ្នក រួចរាល់ ហើយ !
កូរ៉េ ខាងជើង៖ ចិន ។
ឥឡូវខ្ញុំទៅកាត់ សក់ហួសកំណត់ ។
គាត់ នឹង មិន ដែល ធ្វើឱ្យ អ្នក ឈឺចាប់ ឡើយ ។
យឺត ៗ សមីការ ដែល នៅសល់ បាន កើតឡើង ចំពោះ នាង ។
នៅ ការិយាល័យ មិន ចាំបាច់ និយាយ ទេ បុគ្គល ត្រូវ ដឹង កិច្ចការ ដែល មាន ច្រើន ។
កុំ បណ្តោយ ឱ្យ ការចង់បាន ជ័យជំនះ លើស ពី ការស្វែងរក ឧត្តមភាព ។
អាចនិយាយអំពី វាថា " នេះមិនមែនជាម៉ាកដែលបានដកចេញពីភ្លើងទេឬ ? "
ប៉ុន្តែមានសៀវភៅជាច្រើនទៀតដែលខ្ញុំបានចុះចូល ។
អ្នកត្រូវតែស្តាប់ខ្លឹមសារសង្ខេប ។
ការ ដក យក ចេញ យើង កំពុង ស្វែងរក
ដែល អាច កើតឡើង កំឡុង ពេល ប្រើប្រាស់ ។
« តើគេចង់ឲ្យយើងខ្ចប់អ្វី ?
ប៉ុន្តែពេលខ្ញុំមើលបួននាក់ដោយមិនដឹងខ្លួន ខ្ញុំគិតថាច្រើនពេក ។
ខ្ញុំ បាន ព្យាយាម ស្វែងរក គាត់ តែ រក មិន ឃើញ ។
«វាកម្រណាស់ដែលមិន មានមនុស្សច្រើនដឹងអំពី វា។
« ប្រាសាទនេះត្រូវចំណាយពេលសាងសង់សែសិបប្រាំមួយឆ្នាំ ហើយតើអ្នកនឹង សង់វាក្នុងរយៈពេលបីថ្ងៃឬ ? » ។
ហើយ ខ្ញុំ នឹង លើក គាត់ ឡើង នៅ ថ្ងៃ ចុងក្រោយ ។
