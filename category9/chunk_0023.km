សម្តេច តេជោ ជា ប្រមុខ ដឹកនាំ ជាតិ ដ៏ ឈ្លាសវៃ និង ប៉ិនប្រសប់ បំផុត ក្នុង ការកសាង សមិទ្ធផល ជាតិ លើ គ្រប់ វិស័យ ទទួលបាន នូវ មហា ជោគជ័យ ដើម្បី ជា ឧត្តម ប្រយោជន៍ ប្រជាជាតិ មាតុភូមិ និង ប្រជារាស្ត្រ កម្ពុជា ព្រមទាំង បាន ខិតខំ បំបាត់ ភាពក្រីក្រ ក្នុង សង្គមជាតិ និង លើកតម្កើង កិត្យានុភាព នៃ ប្រជាជាតិ យើង នៅលើ ឆាក អន្តរជាតិ ។
នៅក្នុង ឱកាស ដ៏ ថ្លៃថ្លា នេះ ខ្ញុំ សូម សម្តែង នូវ សេចក្តីកោតសរសើរ ដ៏ កក់ក្តៅ ជា ទីបំផុត និង សូម ផ្តល់ ការគាំទ្រ ជានិច្ច ចំពោះ សម្តេច តេជោ ជា អ្នកស្នេហាជាតិ ដ៏ ខ្ពង់ខ្ពស់ ហើយ ខិតខំ បំពេញ ភារកិច្ច ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជារាស្ត្រ កម្ពុជា គ្រប់ កាលៈទេសៈ ទទួលបាន ជ័យជម្នះ គ្រប់ ភារកិច្ច និង សូម ជូនពរ សម្តេច អគ្គ មហា សេនា បតី តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង ក្រុមគ្រួសារ សូម បាន ប្រកប តែ នឹង ព្រះពុទ្ធ ពរ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ខាងក្រោម នេះ ជា ព្រះរាជ សារ របស់ សម្តេច ម៉ែ៖
បន្ថែម ពី ខាងលើ នេះ វា ក៏ រួម មាន ទាំង កម្ទេចកម្ទី អវកាស ប្រហែល ១០.០០០ បំណែក ផងដែរ ដោយ ៣.០០០ បំណែក ក្នុង នោះ ទៀតសោត ត្រូវបាន បង្កើតឡើង ដោយ ព្រឹត្តិការណ៍ តែ មួយ ប៉ុណ្ណោះ គឺ ការបាញ់ ធ្វើតេស្ត កម្ទេច ផ្កាយ រណប របស់ ចិន កាលពី ឆ្នាំ ២០០៧ នៅរយៈកម្ពស់ ៨៥៣ គីឡូម៉ែត្រ ពី ផ្ទៃដី ។ ក្រៅពី ឥណ្ឌា និង ចិន រុស្ស៊ី ព្រមទាំង សហរដ្ឋ អាមេរិក ផ្ទាល់ ក៏ ធ្លាប់ បាន ធ្វើតេស្ត ដូចគ្នា នេះ ផងដែរ ហើយ សុទ្ធតែ បាន បន្សល់ សំរាម ដូច តែ គ្នា នៅ ទី អវកាស ។
អ្នក ជិះ បញ្ច្រាស រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត មាន . ក្នុង យប់ មិញ សមត្ថកិច្ច ឃាត់ បាន យានយន្ត ១ គ្រឿង ថែម ទៀត
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០១៩ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត១ គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឱ្យដឹង ថា នៅ ថ្ងៃទី១ ខែមេសា ឆ្នាំ ២០១៩ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ២២៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ ម៉ូតូ ១ គ្រឿង ។
បច្ចុប្បន្ន យានយន្ត ទាំងនោះ បាន បញ្ជូន ទៅ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ កា អប់រំ ណែនាំ បន្ត តាម នីតិវិធី ៕ ឧប នាយក រដ្ឋមន្ត្រី ម៉ែន សំអន អញ្ជើញ បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៨ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០១៩ របស់ ក្រសួង កិច្ចការ នារី
( ភ្នំពេញ ) ៖ លោកស្រី ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច នា ព្រឹក ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៨ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០១៩ របស់ ក្រសួង កិច្ចការ នារី នៅ សណ្ឋាគារ ភ្នំពេញ ។
លោកស្រី បាន បញ្ជាក់ ថា អង្គ សន្និបាត ទាំងមូល បាន ពិនិត្យមើល លើ វឌ្ឍនភាព សំខាន់ ៗ របស់ ក្រសួង និង មន្ទីរ កិច្ចការ នារី ដែល បាន អនុវត្ត កាលពី ឆ្នាំ ២០១៨ កំណត់ លើ បញ្ហា ប្រឈម ចំណុច ខ្លាំង និង លើក ជា ទិសដៅ អាទិភាព សម្រាប់ ការអនុវត្ត បន្ត នៅ ឆ្នាំ ២០១៩ ។
រដ្ឋមន្ត្រី ក្រសួង កិច្ចការ នារី បាន លើកឡើង ថា ទិសដៅ អាទិភាព សម្រាប់ ឆ្នាំ ២០១៩ រួម មាន៖
ក្រសួង សង្គមកិច្ច៖ រាជ រដ្ឋាភិបាល កម្ពុជា មាន គោលដៅ រូម និង បាន ខិតខំ គ្រប់ ផ្នែក និង គ្រប់ វិស័យ ពាក់ព័ន្ធ ដើម្បី ប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស គ្រប់ ទម្រង់
បន្ដែម ពីលើ នេះ លោក ញឹក វណ្ណារ៉ា បាន ឲ្យដឹង ថា នៅ តាម ក្រសួង ស្ថាប័ន និង អង្គការ មិន មែន រដ្ឋាភិបាល ដែល ជា អនុប្រធាន សមាជិក នៃ ក្រុមការងារ ការពារ ជនរងគ្រោះ ដោយ អំពើហិង្សា ជួញដូរ មនុស្ស បាន អនុវត្ត សកម្មភាព ជាច្រើន ពិសេស នាយកដ្ឋាន ប្រឆាំង ការជួញដូរ មនុស្ស និង សមារណកម្ម ជនរងគ្រោះ គឺជា ការងារ ស្នួល របស់ នាយកដ្ឋាន នេះ ។
កិច្ចប្រជុំ នា ពេលនេះ មាន គោលបំណង ពង្រីក និង លើកកម្ពស់ ប្រសិទ្ធភាព ការការពារ និង ជួយ ជនរងគ្រោះ គ្រប់ រូបភាព ការអនុវត្ត ច្បាប់ ការផ្តន្ទាទោស ជនល្មើស ជួញដូរ មនុស្ស និង អំពើ ធ្វើ អាជីវកម្ម ផ្លូវភេទ ប្រកបដោយ ភាពអយុត្តិធម៌ និង ការផ្តល់ សេវា ដែល មាន គុណភាព និង សមស្រប ក្នុង គោលដៅ រួម ដើម្បី ដោះស្រាយ និង លុបបំបាត់ ទម្រង់ នៃ អំពើ ជួញដូរ មនុស្ស ព្រមទាំង អំពើ ធ្វើ អាជីវកម្ម ផ្លូវភេទ និង អំពើ គេង ប្រវ័ញ្ច គ្រប់ រូបភាប ដែល កើតមាន នៅក្នុង ប្រទេស កម្ពុជា ។
លោក ញឹក វណ្ណារ៉ា សង្ឃឹម ថា លិខិត បទដ្ឋាន គត្តិ យុត្តិ ជាតិ អន្តរជាតិ ត្រូវបាន និង កំពុង អនុវត្ត យ៉ាង សកម្ម និង ប្រសិទ្ធភាព ត្រូវតែ បន្ត ឲ្យបាន ទូលំទូលាយ សម្រាប់ ជា ឧត្តម ប្រយោជន៍ ជួយ ដល់ ជនរងគ្រោះ ។
គួរ បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន បង្កើត គណៈកម្មការ ជួញដូរ មនុស្ស បាន បែងចែក ក្រុមការងារ អន្តរ ក្រសួង ស្ថាប័ន ចំនួន ០៦ ក្នុង នោះ ក្រុមការងារ ការពារ ជនរងគ្រោះ ដឹកនាំ ដោយ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ដែល មាន សេចក្តីសម្រេច ស្តីពី ការតែងតាំង សមាសភាព ក្រុមការងារ ការពារ ជនរងគ្រោះ ចុះ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៥ ។
ពាក់ព័ន្ធ បញ្ហា នេះ ផងដែរ ប្រជាពលរដ្ឋ ជាច្រើន នាក់ បង្ហាញ ការយល់ឃើញ របស់ ពួកគាត់ ស្រដៀង គ្នា នឹង មន្ត្រី នគរបាល ជំនាញ ផងដែរ ដោយ ពួកគាត់ លើកឡើង ថា តាមពិត ទៅ គ្មាន នរណា មិន ចង់ ទៅកាន់ ឈ្មោះ យានយន្ត ឲ្យបាន ត្រឹមត្រូវ នោះ ទេ ប៉ុន្តែ ដោយសារ ការ ចំណាយ ខ្ពស់ ដើមហេតុ ដែល ធ្វើឲ្យ ពួកគាត់ រុញ រា ។ ពួកគាត់ លើកឡើង នូវ សំណូមពរ ថា ប្រសិនបើ ការចំណាយ សមរម្យ ហើយ មាន ការសម្រួល បែបបទ និង ពេលវេលា កាន់តែ ល្អ នោះ គឺ ពួកគាត់ ចង់ ណាស់ ការកាត់ ឈ្មោះ នេះ ។
លោក វរសេនីយ៍ ឯក ថី វសាល បាន បញ្ជាក់ ឲ្យដឹង ថា ចំពោះ ការចំណាយ ខ្ពស់ លើ ការ កាត់ ឈ្មោះ លើ យានយន្ត នេះ រាជ រដ្ឋាភិបាល បាន នឹង កំពុង ខិតខំ សម្រួល លើ បញ្ហា នេះ ដោយ បច្ចុប្បន្ន ក្រសួង សាធារណការ និង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន និង កំពុង រួមគ្នា តាក់តែង លើ សេចក្ដីព្រាង ប្រកាស អន្តរ ក្រសួង មួយ ដើម្បី កំណត់ លើ ការបង់ សេវា នេះ ដែល ធ្វើ យ៉ាងណា ឲ្យ មាន ភាពងាយស្រួល ជាង នេះ ។
ចំពោះ ផលវិបាក នៃ ការ មិន ទៅ កាត់ ឈ្មោះ ឲ្យបាន ត្រឹមត្រូវ នេះ លោក វរសេនីយ៍ ឯក ថី វិសាល បាន បញ្ជាក់ ថា ពិតជា មាន ការលំបាក ដល់ សមត្ថកិច្ច នៅ ពេល ដែល យានយន្ត នោះ ជួប នឹង គ្រោះថ្នាក់ ចរាចរណ៍ ដោយ ប្រការ ណាមួយ និង មាន បញ្ហា ដល់ ម្ចាស់ ដើម នៃ យានយន្ត នោះ នឹង ជាប់ពាក់ ផ្លូវ ច្បាប់ ជាមួយ សមត្ថកិច្ច ។
លោក បាន អំពាវនាវ ថា សម្រាប់ ប្រជាពលដ្ឋរ ទាំងអស់ នៅពេល ធ្វើ ការលក់ ទិញ និង ផ្ដល់ អំណោយ ឬ លើ ស្ថានភាព ផ្សេង ៗ ទៀត លើ បញ្ហា ផ្លាស់ប្ដូរ យានយន្ត របស់ ខ្លួន នោះ គឺ សូម បងប្អូន មក បំពេញ បែបបទ ក្នុង ការផ្ទេកម្មសិទ្ធិ ឬ កាត់ ឈ្មោះ លើ យានយន្ត របស់ ខ្លួន ដើម្បី កុំ ឲ្យ មាន ផលលំបាន ទៅ ថ្ងៃ ក្រោយ នៅ ពេល ដែល យានយន្ត របស់ ខ្លួន ជាប់ពាក់ព័ន្ធ ជាមួយនឹង បទល្មើស ។
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម ចេញ តារាង កំណត់ តម្លៃ ប្រេងឥន្ធនៈ លក់ រាយ តាម ស្ថានីយ ក្នុង ប្រទេស កម្ពុជា ចាប់ពី ថ្ងៃ នេះ ដល់ ១៥ ខែមេសា ឆ្នាំ ២០១៩ ដោយ បញ្ជាក់ ថា តម្លៃ សាំង ធម្មតា មាន តម្លៃ ៣៧៥០ រៀល ក្នុង ១លីត្រ និង ម៉ាស៊ូត មាន តម្លៃ ៣៥៥០ រៀល ក្នុង ១លីត្រ៕ ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ដំណើរការ ប្រព័ន្ធ ផ្គត់ផ្គង់ ទឹក ស្អាត ខេត្ត កំពត តម្លៃ ជាង ២៦ លាន ដុល្លារ
ប្រតិកម្ម របស់ ទីក្រុង ប៉ារីស កើត មាន ឡើង បន្ទាប់ពី មជ្ឈមណ្ឌល រុស្ស៊ី សម្រាប់ ការផ្សះផ្សា ស៊ីរី រាយការណ៍ ថា ទីភ្នាក់ងារ ស៊ើប ការណ៍ សំងាត់ ប៊ែលហ្សិក និង បារាំង បាន ផ្ដិត យក រូបភាព ការវាយប្រហារ តាម ផ្លូវ អាកាស លើ ឃ្លាំង អាវុធ របស់ ពួក ភេរវករ នៅក្នុង ខេត្ត Idlib នា ពេល ថ្មី ៗ នេះ ដើម្បី ប្រើ វា ជា លេស ទម្លាក់ ថា រុស្ស៊ី និង រដ្ឋាភិបាល ស៊ីរី ថា ជា អ្នកប្រើប្រាស់ អាវុធ គីមី ។
ប៉ុន្តែ ជា ការឆ្លើយតប អ្នកនាំពាក្យ ក្រសួង ការបរទេស បារំាង បាន ចាត់ទុក ថា ព័ត៌មាន នេះ គឺជា រឿង ប្រឌិត ។ អ្នកនាំពាក្យ រូប នេះ ដដែល បាន លើកឡើង ដូច្នេះ ថា៖ « វា មិន មែន ជា ព័ត៌មាន នោះ ទេ ប៉ុន្តែ វា គ្រាន់តែ រឿង ប្រឌិត និង កុហក ដែល បង្កើតឡើង ដោយ រុស្ស៊ី និង ស៊ីរី ប៉ុណ្ណោះ » ។
គួរ បញ្ជាក់ ថា កាលពី ឆ្នាំ ២០១៨ ខេត្ត Idlib បាន ក្លាយជា ចំណុច កណ្ដោល នៃ ភាពតានតឹង រវាង រុស្ស៊ី និង លោក ខាងលិច ជាពិសេស គឺ សហរដ្ឋ អាមេរិក ដោយសារតែ ការចោទប្រកាន់ គ្នា ទៅ វិញទៅ មក ពី ការប្រើប្រាស់ អាវុធ គីមី ដែល បណ្ដាលឱ្យ ជន ស៊ីវិល ស្លូតត្រង់ រាប់ សិប នាក់ បាត់បង់ជីវិត បើ ទោះជា មាន បទ ឈប់ បាញ់ ជាច្រើន លើក ក៏ដោយ ៕
ដាច់ចរន្ត អគ្គិសនី នៅ តំបន់ មួយចំនួន ក្នុង ក្រុង បាន លុង ខេត្ត រតនគិរី ដោយសារ រថយន្ត១ គ្រឿង បើក បុក បាក់ បង្គោល ខ្សែភ្លើង
អគ្គិសនី កម្ពុជា បាន បញ្ជាក់ ថា ក្រុមការងារ បច្ចេកទេស កំពុង ធ្វើ ការជួសជុល ផ្លាស់ប្តូរ បង្គោល ថ្មី និង បរិក្ខារ អគ្គិសនី មួយចំនួន ដើម្បី ភ្ជាប់ ចរន្ត ជូន អតិថិជន ឲ្យ មាន ចរន្ត ប្រើប្រាស់ ឡើងវិញ នៅ វេលា ម៉ោង ២១៖០០ នាទី យប់ នេះ ។
កិច្ចសម្ភាស ន៍៖ រាជ រដ្ឋាភិបាល កំពុង ខិតខំ បង្កើន ការផលិត ថាមពល អគ្គិសនី ផ្ទុយ ពី ការរិះគន់ របស់ វិទ្យុ ឧទ្ទាម បរទេស ដែល ចោទ ថា រដ្ឋាភិបាល មិន គិតគូរ លើ បញ្ហា នេះ
( ភ្នំពេញ ) ៖ បច្ចុប្បន្ន នេះ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន និង កំពុង គិតគូរ យ៉ាង យកចិត្តទុកដាក់ ដើម្បី បង្កើន ការផលិត ថាមពល អគ្គិសនី ពិសេស ថាមពល អគ្គិសនី ដើរ ដោយ ពន្លឺ ព្រះអាទិត្យ ( សូឡា ) ផ្ទុយ ពី ការរិះគន់ របស់ វិទ្យុ ឧទ្ទាម បរទេស អាស៊ី សេរី ។ នេះ ជា ការថ្លែង នៅក្នុង បទសម្ភាសន៍ រវាង លោក កែវ រតនៈ រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា អគ្គ នាយក អគ្គិសនី កម្ពុជា ជាមួយ អគ្គ នាយក អង្គភាព ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០១៩ ។
ការចេញមក បញ្ជាក់ របស់ លោក កែវ រតនៈ ធ្វើឡើង បន្ទាប់ពី វិទ្យុ ដែល មាន និន្នាការ ប្រឆាំង ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ផ្សាយ ចោទប្រកាន់ ថា ការទិញ នាវា អគ្គិសនី ពី ប្រទេស គួក គី ដើម្បី ផ្គត់ផ្គង់ ជា បណ្ដោះអាសន្ន នៅពេល កម្ពុជា កំពុងតែ ខ្វះ ថាមពល អគ្គិសនី មិន មែន ជា ដំណោះស្រាយ ល្អ ចំពោះ បញ្ហា នេះ នោះ ទេ ។
លោក កែវ រតនៈ បាន បញ្ជាក់ នៅក្នុង កិច្ចសម្ភាសន៍ អំពី បញ្ហា នេះ យ៉ាង ដូច្នេះ ថា « វិទ្យុ ឧទ្ទាម អាស៊ី សេរី ផ្សាយ ថា រដ្ឋាភិបាល មិន គិតគូរ អំពី បញ្ហា កង្វះ ថាមពល អគ្គិសនី ដើម្បីឲ្យ ប្រជាពលរដ្ឋ ប្រើប្រាស់ នោះ តាមពិត ទៅ រដ្ឋាភិបាល គិតគូរ ណាស់ ដូចជា ការខិតខំ ពង្រីក ថាមពល ដើរ ដោយ ពន្លឺ ព្រះអាទិត្យ ខ្នាត ធំ ដែល យើង ហៅ ថា សូឡា ការគិតគូរ នេះ រាជ រដ្ឋាភិបាល អត់ មាន យក ពន្ធ នាំចូល អ្វី នោះ ទេ ខុសពី អ្នក មួយចំនួន ដែល ថា រដ្ឋាភិបាល យក ពន្ធ លើ បញ្ហា នេះ » ។
អគ្គ នាយក អគ្គិសនី កម្ពុជា រូប នេះ បាន អះអាង ថា ស្ថានីយ៍ ថាមពល ដើរ ដោយ ពន្លឺ ព្រះអាទិត្យ នោះ រួម មាន នៅ ក្រុង បាវិត ខេត្ត ស្វាយរៀង មាន អានុភាព ១០មេហ្គាវ៉ាត់ . ៦០ មេហ្គាវ៉ាត់ នៅ ត្មាត ពង ក្នុង ស្រុក ឧដ្គុង ខេត្ត កំពង់ស្ពឺ . ១២០ មេហ្គាវ៉ាត់ នៅ ខេត្ត កំពង់ឆ្នាំង និង ៦០ មេហ្គាត វ៉ាត់ នៅ ខេត្ត ពោធិ៍សាត់ ដែល ទាំងអស់ នេះ ជា ការគិតគូរ រួចទៅហើយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា លើ បញ្ហា ថាមពល អគ្គិសនី ។
លោក កែវ រតនៈ បាន គូសបញ្ជាក់ បន្ថែម ថា នៅពេល ខាងមុខ នេះ រាជ រដ្ឋាភិបាល នឹង សិក្សា មើល ជម្រើស ជាច្រើន ផ្សេង ទៀត ដើម្បី ប្រើប្រាស់ ថាមពល ដើរ ដោយ ពន្លឺ ព្រះអាទិត្យ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព និង កាន់តែ ទូលំទូលាយ ហើយ ទាំងអស់ នេះ ជា ការប្ដេជ្ញាចិត្ត របស់ រដ្ឋាភិបាល និង អគ្គិសនី កម្ពុជា ។
ក្នុង រដូវ ប្រាំង នៅ ឆ្នាំ ២០១៩នេះ កម្ពុជា នឹង ជួប គ្រោះ ក្តៅ ហួត ហែង ខ្លាំង ជាពិសេស ក្នុង អំឡុង ខែមេសា និង ឧសភា ខាងមុខ ដែល កម្តៅ នឹង ហក់ ឡើង ដល់ ៤០ ទៅ ៤២ អង្សា ដោយសារតែ ការរង ដោយ ប្រយោល នៃ ឥទ្ធិពល បាតុភូត អែល នីណូ (El Nino) ដែល ធ្វើឲ្យ វារី អគ្គិសនី មិន អាច ផលិត ថាមពល បាន គ្រប់គ្រាន់ ។ កម្ពុជា កំពុង ខ្វះ ថាមពល អគ្គិសនី ប្រមាណ ៤០០ មេហ្គាវ៉ាត់ ។
ចំពោះ កង្វះខាត អគ្គិសនី នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ មាន ភាពអត់ធ្មត់ និង យោគយល់ អធ្យាស្រ័យ ។ សម្តេច បាន បញ្ជាក់ ថា កង្វះ ថាមពល អគ្គិសនី នេះ មិន ទាន់ ប៉ះពាល់ ដល់ សង្វាក់ ផលិតកម្ម នៅ តាម រោងចក្រ សហគ្រាស នៅឡើយ ទេ ព្រោះ កម្ពុជា នៅ មាន ថាមពល អគ្គិសនី រហូតដល់ ជាង ១.០០០ មេហ្គាវ៉ាត់ ទៀត ឯណោះ ៕
អភិបាល ខេត្ត ព្រះវិហារ ណែនាំឲ្យ មន្រ្តី កុំ រើសអើង និង កុំ ចាត់ទុក អ្នកសារព័ត៌មាន ជា យន្តការ ដាច់ដោយឡែក នោះ នឹង ក្លាយជា អ្នកដឹកនាំ ដែល គ្មាន ទំនាក់ទំនងជាក់ ជា មិន ខាន
( ព្រះវិហារ ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ បាន ចាត់ទុក អ្នកសារព័ត៌មាន ជា ដៃគូរ ដ៏ ល្អ សម្រាប់ ការដឹកនាំ របស់ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ។ លោក ថា អាជ្ញាធរ ធ្វើ សកម្មភាព ការអភិវឌ្ឍន៍ បាន ច្រើន ប៉ុន្តែ បើ គ្មាន ការផ្សព្វផ្សាយ ពី អ្នកសារព័ត៌មាន ទេ ប្រជាពលរដ្ឋ នឹង ថ្នាក់ ជាតិ លោក មិន បាន ឃើញ ទេ ។
ការថ្លែង របស់ លោក អ៊ុន ចាន់ ដា បែប នេះ ក្នុង ឱកាស ដែល លោក អញ្ជើញ ចូលរួម សំណេះសំណាល ជាមួយ អ្នកសារព័ត៌មាន ប្រចាំ ខេត្ត ព្រះវិហារ ដោយ មាន ការចូលរួម ពីសំណាក់ ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត អភិបាល ក្រុង - ស្រុក ទាំង៨ នៅ រសៀល ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០១៩ នេះ ។
ជាមួយគ្នា នោះ លោក ក៏ បាន ស្នើសុំ ថា អ្នកសារព័ត៌មាន ត្រូវ ដើរតួ ជា កញ្ចក់ ត្រូវ បង្ហាញ អ្វី ដែល ជា ការពិត និង មាន ភាពស្មោះត្រង់ និង គ្នា ។ ដៃគូរ ដ៏ ល្អ គឺជា ដៃគូរ ដែល មាន ភាពស្មោះត្រង់ ជាមួយគ្នា បើសិន មិន មាន ភាពស្មោះត្រង់ ទេ កញ្ចក់ ដែល បងប្អូន បញ្ចាំង ទៅ យូរ ទៅ នឹង មាន ភាព ប្រេះស្រាំ ព័ត៌មាន មិន ពិត នឹង បាន បង្ហាញ ឲ្យ ឃើញ ពី ការបាត់បង់ នូវ ប្រជាប្រិយភាព និង បាត់បង់ នូវ ការគាំទ្រ ហើយ សារព័ត៌មាន នោះ នឹង ប្រឈម ការដួលរលំនៅ ថ្ងៃ អនាគត មិន ខាន ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី០១ ខែមេសា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
សហភាព សហជីព ការងារ កម្មករ ដើម្បី អភិវឌ្ឍន៍ នាំ អំណោយ ទៅ ចែកជូន កុមារ កំព្រា ២៧ នាក់ នៅ អង្គការ កុមារដ្ឋាន ម្លប់ នៅ ក្រុង តាខ្មៅ
( កណ្តាល ) ៖ លោក ជុំ បី ត ប្រធាន សហភាព សហជីព ការងារ កម្មករ ដើម្បី អភិវឌ្ឍន៍ ព្រមទាំង ក្រុមប្រឹក្សាភិបាល ទាំងអស់ នៃ សហភាព សហជីព នា ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ បាន យក អំណោយ មួយចំនួន ចែកជូន កុមារ កំព្រា ចំនួន ២៧ នាក់ នៅ អង្គការ កុមារដ្ឋាន ម្លប់ ដែល ជា អង្គការ ជួយ ដល់ កុមារ ដែល ឪពុក ម្តាយ បោះបង់ ចោល ដែល មាន អាសយដ្ឋាន នៅ ភូមិ ព្រែក សំរោង៣ សង្កាត់ តា ខ្មៅ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ។
សម្រាប់ អំណោយ នេះ ប្រធាន អង្គការ កុមារដ្ឋាន ម្លប់ សូម អរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ កាយវិការ ប្រកបដោយ សម្បុរស របស់ លោក ជុំ បី ត និង សហការី ដែល បាន ចំណាយ ពេល និង ទ្រព្យធន ផ្ទាល់ខ្លួន មក ជួយ ដល់ អង្គការ កុមារដ្ឋាន ម្លប់ នា ពេលនេះ ៕
អាជ្ញាធរ ចិន បាន ឲ្យដឹង ថា មនុស្ស សរុប ទាំងអស់ ៣០ នាក់ បាន បាត់ខ្លួន ក្នុង នោះ មាន ភ្នាក់ងារ ពន្លត់ អគ្គីភ័យ ២៧ នាក់ និង ០៣ នាក់ ទៀត ជា ប្រជាជន រស់ នៅក្នុង តំបន់ ដែល បាន ចូលរួម ប្រតិបត្តិការ ពន្លត់ អគ្គីភ័យ បន្ទាប់ពី ភ្លើង ឆេះ ព្រៃ នេះ បាន កញ្រ្ចោល ឡើង ខ្លាំង នៅ ថ្ងៃអាទិត្យ សប្តាហ៍ មុន ដោយសារតែ ការប្រែប្រួល ភ្លាម ៗ នៃ ទិសដៅ ខ្យល់ បក់ ។
គួរ បញ្ជាក់ ថា ប្រតិបត្តិការ រុករក នៅតែ បន្ត ប្រព្រឹត្តទៅ ខណៈ មនុស្ស មួយចំនួន ទៀត កំពុង បាត់ខ្លួន ហើយ មនុស្ស ដល់ ទៅ ជិត ៧០០ នាក់ កំពុងតែ បន្ត ព្យាយាម ពន្លត់ ភ្លើង ឆេះ ព្រៃ នេះ ។ គ្រោះមហន្តរាយ ភ្លើង ឆេះ ព្រៃ ខាងលើ បាន រីករាលដាល ឡើង កាលពី វេលា យប់ ថ្ងៃសៅរ៍ ចុង សប្តាហ៍ មុន នៅ តាម ចំណុច មួយចំនួន ខុស ៗ គ្នា នៅក្បែរ ទន្លេ យ៉ាឡុង (Yalong) ៕
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០១ ខែមេសា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ២៦០ គ្រឿង និង ផាក ពិន័យ ១៥៧ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ១.៥២៣ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ២៦០ គ្រឿង ( ម៉ូតូ ៤០ %) អប់រំ១០៣ គ្រឿង និង ផាក ពិន័យ ១៥៧ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ០១ ខែមេសា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ៩៩៨ គ្រឿង . អប់រំ ៦៤ គ្រឿង និង ផាក ពិន័យ ១៤៣ គ្រឿង ៕ ស្រាបៀរ លី អូ ប្រគល់ រង្វាន់ ទឹកប្រាក់ សុទ្ធ ដល់ គូ ស្វាមី ភរិយា ថ្មី ចំនួន ១០គូ ក្នុង កម្មវិធី « ចំណង ដៃ ដ៏ មាន ន័យ ជាមួយ ស្រាបៀរ លី អូ» លើក ទី២ ឆ្នាំ ២០១៩
គូ ស្វាមី ភរិយា ថ្មី ចំនួន ២គូ បាន ឈ្នះ រង្វាន់ ទឹកប្រាក់ សុទ្ធ៥.០០០ ដុល្លារ និង ៨គូ ផ្សេង ទៀត បាន ឈ្នះ រង្វាន់ ទឹកប្រាក់ សុទ្ធ១.០០០ ដុល្លារ ដែល ពួកគាត់ បាន មកពី ទូទាំង ប្រទេស មាន រាជធានី ភ្នំពេញ និង បណ្តា ខេត្ត នានា ។
គូ ស្វាមី ភរិយា ថ្មី មួយ គូ លោក ឈន វាសនា និង លោកស្រី យ៉ូង ឆេង មកពី ខេត្ត ប៉ៃលិន ដែល ជា ម្ចាស់ រង្វាន់ ទឹកប្រាក់ សុទ្ធ៥.០០០ ដុល្លារ បាន ឲ្យដឹង ថា « យើង ទាំង ពីរ នាក់ រំភើប ភ្ញាក់ផ្អើល រក អ្វី មក ប្រៀប មិន បាន ទេ ពេល ដែល ឮ គេ ប្រកាស ឈ្មោះ អ្នក ឈ្នះ រង្វាន់ គឺជា ខ្លួន នៅក្នុង កម្មវិធី ចាប់ ឆ្នោត ផ្សង សំណាង កាលពី ថ្ងៃទី ២៤ ខែមីនា កន្លងទៅ ។ នេះ ជា ចំណង ដៃ ដ៏ រីករាយ អស្ចារ្យ បំផុត សម្រាប់ ពួកយើង » ។
លោក អ៊ូ ស៊ី នួន អ្នកតំណាង របស់ ក្រុមហ៊ុន ស្រាបៀរ លី អូ បាន ថ្លែង ក្នុង កម្មវិធី ប្រគល់ រង្វាន់ ថា « ជារៀងរាល់ ឆ្នាំ ស្រាបៀរ លី អូ តែង មាន កម្មវិធី ចំណង ដៃ ដ៏ មាន ន័យ ជាមួយ ស្រាបៀរ លី អូ ដើម្បី ជា កិច្ច ថ្លែងអំណរគុណ និង បង្ហាញ ពី ការយកចិត្តទុកដាក់ របស់ ក្រុមហ៊ុន ចំពោះ អតិថិជន ដ៏ មាន តម្លៃ របស់ យើង ដែល បាន ជ្រើសរើស ស្រាបៀរលី អូ សម្រាប់ ថ្ងៃ មង្គល របស់ ពួកគេ ហើយ យើង ក៏ សង្ឃឹម ថា អតិថិជន នៅតែ បន្ត គាំទ្រ ស្រាបៀរ លី អូ ដើម្បី ញ៉ាំង ឲ្យ កម្មវិធី មង្គលការកាន់តែ មាន ភាពសប្បាយរីករាយ » ។
សូម បញ្ជាក់ ថា នេះ ជា ការចាប់ រង្វាន់ លើក ទី២ សម្រាប់ កម្មវិធី ចាប់ ឆ្នោត ផ្សង សំណាង ផ្តល់ ចំណង ដៃ ដ៏ មាន ន័យ ឆ្នាំ ២០១៩ នេះ ។ សូម ជាវ ស្រាបៀរ លី អូ សម្រាប់ ទទួល ភ្ញៀវ ក្នុង ពិធី អាពាហ៍ពិពាហ៍ របស់ លោក អ្នក ពីព្រោះ នៅ មាន រង្វាន់ ជាច្រើន សន្ធឹកសន្ធាប់ ទៀត កំពុង រង់ចាំ លោក អ្នក ៕
( ពោធិ៍សាត់ )៖ លំនៅដ្ឋាន ២ខ្នង ធ្វើ អំពី ឈើ ប្រក់ ក្បឿង និង ស័ង្កសី បាក់ ធ្លាក់ រាប ដល់ ដី នៅ ភូមិ ឥធ្យា និង ភូមិ បាគូ ឃុំ ស្រែ ស្តុក ស្រុក កណ្តៀង ខេត្ត ពោធិ៍សាត់ នៅ ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០១៩ នេះ ត្រូវបាន សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ពោធិ៍សាត់ នាំយក អំណោយ មនុស្សធម៌ ជូន ដល់ ទីកន្លែង ដើម្បី ជួយ សម្រួល ដល់ គ្រួសារ រងគ្រោះ បាន មួយ គ្រា ដោយ មួយ គ្រួសារ ទទួលបាន អង្ករ៥០ គីឡូក្រាម មី១ កេស តង់១ កន្ទេល១ ឃីត១ កញ្ចប់ និង ថវិកា ១០ម៉ឺន រៀល ។
លោក បាន កត់សម្គាល់ ឃើញ ថា ភូមិសាស្ត្រ ឃុំ ស្រែ ស្តុក នេះ គឺជា តំបន់ ទំនាប ជាប់ បឹង ទន្លេ សាប តែងតែ ជួប បញ្ហា ហានិភ័យ ជាញឹកញាប់ ដូចនេះ សូម ឱ្យ ប្រជាពលរដ្ឋ ជូនដំណឹង ជាបន្ទាន់ ដល់ អាជ្ញាធរ មូលដ្ឋាន ដើម្បី មាន វិធានការដោះស្រាយ និង ឆ្លើយតប ឱ្យ បាន ទាន់ ពេល វេលា ។
លោក ឌី ពៅ ជំនួយការ សម្ដេច តេជោ ហ៊ុន សែន រៀបចំ ពិធី បុណ្យ បច្ច័យ បួន និង ចម្រើន ព្រះជន្ម ជូន ឧបាសិកា ទូច សុន នៅ ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ លោក ឌី ពៅ ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ បាន ផ្តួចផ្តើម គំនិត ប្រារព្ធ ពិធី បុណ្យ កត្តញ្ញូ បច្ច័យ បួន ចម្រើន ព្រះជន្ម និង ឡើង គេហដ្ឋាន ចាស់ ផ្លាស់ មក ទីតាំង ថ្មី ជូន ចំពោះ ឧបាសិកា ទូច សុន ដែល កំពុង មាន ជន្មាយុ រស់ នៅ សព្វ ថ្ងៃ និង ឧទ្ទិស កុសល ជូន ដល់ បុព្វការី ជន ទាំងឡាយ ដែល បាន ធ្វើ កាល កិរិយា ទៅកាន់ លោក ខាងមុខ ហើយ នោះ ។
នៅក្នុង ពិធី បុណ្យ តាម បែប សាសនា ដែល ធ្វើ ឡើង នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ ក្នុង ភូមិ ព្រែក សង្កែ ឃុំ ពាម កោះ ស្នារ ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម ក៏ មាន ការអញ្ជើញ ចូល រួម ពី លោក ស៊ាង ប៊ុន លាង និង លោកស្រី ហ៊ុន ប៊ុន ធឿន . លោក សេង ទៀង និង លោកស្រី ឈាង វណ្ណា . លោក គួច ចំរើន អភិបាល ខេត្ត កំពង់ចាម ព្រមទាំង លោក លោកស្រី ញាតិមិត្ត ជិត ឆ្ងាយ របស់ ឧបាសិកា ទូច សុន ។
នៅក្នុង ពិធី នោះ ដែរ លោក ឌី ពៅ បាន ជូន អំណោយ សារុង ក្រម៉ា និង ថវិកា មួយ ចំនួន ជូន ចាស់ សិលវ័ន្ត ចាស់ សិលវតី និង អ៊ុ ពូ មីង លោកយាយ លោក តា ដែល មាន វត្តមាន ក្នុង ពិធី បុណ្យ តាម បែប សាសនា នេះ ផងដែរ ៕ ក្នុង ខែមីនា គម្រោង វិនិយោគ រោងចក្រ និង មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម ចំនួន ២៣ ត្រូវបាន ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា អនុម័ត សរុប ទុន វិនិយោគ ជិត ១៦០ លាន ដុល្លារ !
