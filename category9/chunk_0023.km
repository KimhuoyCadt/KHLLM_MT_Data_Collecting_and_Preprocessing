( ត្បូងឃ្មុំ ) ៖ សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋាសភា កម្ពុជា កម្ពុជា បាន អំពាវនាវ ទៅកាន់ អាជ្ញាធរ នៅ តាម មូលដ្ឋាន ទូទាំង ប្រទេស ជួយ សម្រួល រាល់ បញ្ហា របស់ ប្រជាពលរដ្ឋ ដែល កំពុង ប្រឈម នា ពេល បច្ចុប្បន្ន ដូចជា គ្រោះ រាំងស្ងួត ការខ្វះ ទឹក ប្រើប្រាស់ និង ការដឹកជញ្ជូន ជាដើម ។
ការអំពាវនាវ របស់ សម្តេច ហេង សំរិន បាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ ក្នុង ពិធី បុណ្យ សម្ពោធ ឆ្លង ឧបដ្ឋាន សាលា កុដិ និង សមិទ្ធផល នានា ក្នុង វត្ត សិលា រង្សី ហៅ វត្ត ត្រពាំង ថ្កូវ ភូមិ ត្រពាំង រង្សី ឃុំ រកាព ប្រាំ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ នេះ ។
ក្នុង ឱកាស នោះ សម្តេច ហេង សំរិន បាន គូស រំលេច នូវ បញ្ហា មួយចំនួន ដែល ប្រជាពលរដ្ឋ កំពុង ប្រឈម នា ពេល បច្ចុប្បន្ន ដូចជា គ្រោះ រំាង ស្ងួត និង ការខ្វះ ទឹក ប្រើប្រាស់ ។
សម្តេច ប្រធាន រដ្ឋ បាន បាន មានប្រសាសន៍ លើក ដូច្នេះ « គ្រប់ អាជ្ញាធរ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ រួមគ្នា ដោះស្រាយ ដោយ រក្សា ឱ្យ បាន នូវ ប្រភព ទឹក ដែល មាន ស្រាប់ ការប្រើប្រាស់ សន្សំ សំចៃ រិះរក មធ្យោបាយ នានា ដើម្បី ជួយសង្គ្រោះ ឱ្យ បាន ទាន់ ពេល វេលា ។ បាតុភូត នេះ ក៏ មិន មែន កើតមាន នៅតែ ប្រទេស យើង ទេ វា ជា បញ្ហា សកល ដែល ប្រទេស ជាច្រើន ក៏ កំពុង ប្រឈម នឹង បញ្ហា បរិស្ថាន គឺ ការខ្វះខាត ទឹក ប្រើប្រាស់ » ។
ជាមួយគ្នា នេះ សម្តេច ប្រធាន រដ្ឋសភា ក៏ បាន អំពាវនាវ ប្រជាពលរដ្ឋ ថែរក្សា សុខភាព ធ្វើ អនាម័យ ខ្លួនប្រាណ ប្រយ័ត្នប្រយែង ចំណីអាហារ ដើម្បី បង្ការ និង ការពារ ជំងឺ ឆ្លង នានា ។ ឪពុក ម្តាយ ត្រូវ នាំ កូន តូច ៗ ចាក់ វ៉ាក់សាំង បង្ការ ឲ្យបាន គ្រប់ រូប និង ជំរុញ ឱ្យ កុមារ ទាំងអស់ ទទួល ការសិក្សា អប់រំ គ្រប់ ៗ គ្នា ។
សម្តេច បាន វាយតម្លៃ ខ្ពស់ ចំពោះ គំនិត ផ្តួចផ្តើម និង កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ព្រះគ្រូ ចៅអធិការ ព្រះថេរានុត្ថេរៈ គ្រប់ ព្រះអង្គ ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត និង សប្បុរ ជន ជិត ឆ្ងាយ ទាំងអស់ នៃ វត្ត សិលា រង្សី ហៅ វត្ត ត្រពាំង ថ្កូវ ដែល បាន រួបរួម សាមគ្គី គ្នា យ៉ាង សស្រាក់សស្រាំ ក្នុង ការកសាង សមិទ្ធផល សំខាន់ ៗ ដ៏ ច្រើន ក្នុង ទី អារាម នេះ ដែល ឆ្លុះបញ្ចាំង ពី ការរួមចំណែក ដល់ ការអភិវឌ្ឍ នៅក្នុង ខេត្ត ត្បូងឃ្មុំ ឱ្យ កាន់តែ មាន ភាពសម្បូរបែប និង កាន់តែ មាន ការរីកចម្រើន ខ្លាំង ឡើង ថែម ទៀត ។
សម្តេច ប្រធាន រដ្ឋសភា បាន គូសបញ្ជាក់ ថា ឧប្បដ្ឋាន សាលា និង កុដិ រួមទាំង សមិទ្ធផល ផ្សេង ៗ ទៀត ដែល នឹង ដាក់ ឱ្យ ប្រើប្រាស់ នា ថ្ងៃ នេះ បាន មកពី ការបរិច្ចាគ ក្នុង ទឹកចិត្ត ជា សទ្ធា ជ្រះថ្លា របស់ សប្បុរសជន ទាំង ក្នុង និង ក្រៅ ប្រទេស រួម ជាមួយ លោកយាយ លោក តា បងប្អូន ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ជិត ឆ្ងាយ ទាំងអស់ ក្នុង គោលដៅ ចូលរួមចំណែក លើកស្ទួយ វិស័យ ព្រះពុទ្ធ សាសនា ។
អគ្គ នាយក ធនាគារ អភិវឌ្ឍន៍ ជនបទ ស្នើឲ្យ សហគមន៍ ផលិត ពូជ ស្រូវ នៅ ខេត្ត បាត់ដំបង បង្កើន ការផលិត ពូជ ស្រូវ សុទ្ធ ចែកជូន កសិករ កុំ ឲ្យ ឈ្មួញ មាន លេស បង្អាប់ ថ្លៃ !
គោលបំណង នៃ កិច្ចពិភាក្សា នេះ គឺ ដើម្បី ស្នើសុំ សហគមន៍ ផលិត ពូជ ស្រូវ ធ្វើ ការពង្រីក ការផលិត បន្ថែម ពូជ ស្រូវ សុទ្ធ តាម បច្ចេកទេស . បង្កើត មជ្ឈមណ្ឌល ផលិត និង បែងចែក ពូជ ស្រូវ សុទ្ធ . សម្របសម្រួល កិច្ចសន្យា ផលិតកម្ម កសិកម្ម រវាង ក្រុម អ្នកផលិត ពូជ និង ក្រុមហ៊ុន ទទួល ទិញ ពូជ . លើកទឹកចិត្ត ដល់ កសិករ ដាំដុះ ពូជ ស្រូវ សុទ្ធ ។
លោក កៅ ថា ច បាន បន្ថែម ថា ក្នុង ឆ្នាំ ២០១៩ នេះ ទិន្នផល ស្រូវ របស់ បងប្អូន មាន ការធ្លាក់ចុះ ដោយសារ កត្តា អាកាសធាតុ និង បញ្ហា មួយចំនួន ជា ហេតុ ធ្វើឲ្យ តំលៃ ស្រូវ មាន ការធ្លាក់ចុះ បើ ប្រៀន ធៀប ទៅ បណ្តា ឆ្នាំ មុន ៗ ។ ក៏ប៉ុន្តែ ទន្ទឹម នេះ បញ្ហា ធំ បំផុត នោះ ដែល រួមចំណែក ធ្វើឲ្យ ផល ស្រូវ ធ្លាក់ចុះ នោះ គឺ មកពី បងប្អូន ប្រជាកសិករ មួយចំនួន បាន ដាំដុះ ពូជ ស្រូវ មិន សុទ្ធ ល្អ ទើប ធ្វើឲ្យ ទិន្នផល ធ្លាក់ចុះ និង មិន សូវ បាន ផល ល្អ ជា ហេតុ ធ្វើឲ្យ ឈ្មួញ បង្អាប់ តំលៃ ។
ដោយ មើលឃើញ ពី កត្តា ពូជ ស្រូវ នេះ លោក កៅ ថា ច បាន ស្នើសុំ តំណាង សហគមន៍ ផលិត ពូជ ស្រូវ ទាំង ៣២ ក្នុង ខេត្ត បាត់ដំបង ឲ្យ បង្កើន ការផលិត ពូជ ស្រូវ សុទ្ធ ល្អ និង ប្រមូលផ្តុំ ជា មជ្ឈមណ្ឌល ពូជ ស្រូវ ដើម្បី ធ្វើ ការបែងចែក ឲ្យ កសិករ ក្នុង តំបន់ ដាំដុះ ពូជ ស្រូវ សុទ្ធ វិញ ។ ដោយឡែក បញ្ហា ចំណាយ លើ ការផលិត ពូជ ស្រូវ សុទ្ធ នេះ ធនាគារ អភិវឌ្ឍន៍ ជនបទ ធានា ទំលាក់ ថវិកា ឥណទាន ដោយ អត្រា ការប្រាក់ អនុគ្រោះ បំផុត សម្រាប់ សហគមន៍ ផលិត ពូជ ស្រូវ ។
ក្រុម អ្នកគាំទ្រ និង ក្រុម អ្នក ប្រឆាំង រដ្ឋាភិបាល វេណេស៊ុយអេឡា ចេញមក ប្រមូលផ្តុំ គ្នា ចំពោះ មុខ បញ្ហា ដាច់ ភ្លើង ទ្រង់ទ្រាយ ធំ ជា បន្តបន្ទាប់ ក្នុង ខែ នេះ
( ការ៉ាកាស់ ) ៖ ទាំង ក្រុម អ្នកគាំទ្រ និង ក្រុម អ្នក ប្រឆាំង រដ្ឋាភិបាល វេណេស៊ុយអេឡា នា ថ្ងៃសៅរ៍ សប្តាហ៍ នេះ បាន ចេញមក ប្រមូលផ្តុំ គ្នា ខណៈ បញ្ហា ដាច់ចរន្ត អគ្គិសនី ទ្រង់ទ្រាយ ធំ ស្ទើរតែ នៅ ទូទាំង ប្រទេស បាន កើត មាន ឡើង ម្តង ហើយ ម្តង ទៀត ក្នុង ខែមីនា នេះ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ ។
ការប្រមូលផ្តុំ គ្នា នៃ ក្រុម អ្នកគាំទ្រ រដ្ឋាភិបាល ប្រធានាធិបតី លោក នីកូឡាស់ ម៉ាឌូរ៉ូ បាន ប្រព្រឹត្តទៅ នៅឯ រដ្ឋធានី ការ៉ាកាស់ និង នៅ តាម ទីក្រុង ធំ ៗ ដទៃ ទៀត ដើម្បី សម្តែង ការប្រឆាំង ចំពោះ អ្វី ដែល ពួកគេ ចាត់ទុក ថា ជា ការវាយប្រហារ ដែល មាន អាមេរិក នៅ ពីក្រោយ ខ្នង មក លើ រដ្ឋាភិបាល និង ប្រព័ន្ធ រចនាសម្ព័ន្ធ របស់ វេណេស៊ុយអេឡា ។
គួរ ជម្រាប ថា បញ្ហា ដាច់ចរន្ត អគ្គិសនី ទ្រង់ទ្រាយ ធំ បាន ចាប់ផ្តើម កើត មាន ឡើង នៅ វេណេស៊ុយអេឡា កាលពី ថ្ងៃទី ០៧ ខែមីនា ខណៈ ប្រមាណ ជាង មួយ សប្តាហ៍ បន្ទាប់ ក៏ ត្រូវបាន ស្រោចស្រង់ ឡើងវិញ ប៉ុន្តែ មកដល់ សប្តាហ៍ នេះ រដ្ឋ យ៉ាងតិច ២០ ក្នុង ចំណោម រដ្ឋ ទាំង ២៣ នៃ ប្រទេស អាមេរិក ឡាទីន មួយ នេះ ក៏ បាន ជួប បញ្ហា ដាច់ ភ្លើង ជាថ្មី ម្តង ទៀត ។
លោក ដូណាល់ ត្រាំ ប្រកាស ផ្តាច់ ជំនួយ ទៅកាន់ ហ្គាតេម៉ា ហុងឌូរ៉ាស់ និង អែល សាល វ៉ាឌ័រ ហើយ គំរាម បិទ ព្រំដែន ភាគ ខាងត្បូង ដោយសារតែ បញ្ហា លំហូរ ចូល ជន អន្តោប្រវេសន៍
ចុង សប្តាហ៍ នេះ លោក ដូណាល់ ត្រាំ បាន ថ្លែង ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន ថា លោក បាន បិទ បញ្ចប់ ការផ្តល់ ជំនួយ ជា លុយ ទៅកាន់ ហ្គាតេម៉ាឡា ទៅកាន់ ហុងឌូរ៉ាស់ និង ទៅកាន់ អែល សាល វ៉ាឌ័រ ហើយ គឺ គ្មាន លុយ ចេញ ទៅកាន់ ប្រទេស នោះ ទាំងនោះ ទៀត ឡើយ ។ ជាមួយគ្នា នេះ ដែរ លោក ត្រាំ បាន ចោទប្រទេស អាមេរិក កណ្តាល ទាំងនេះ ថា មិន បាន ជួយ អ្វី មកវិញ សម្រាប់ អាមេរិក នោះ ទេ ។
បន្ទាប់មក ទៀត លោក ប្រធានាធិបតី អាមេរិក ក៏ បាន បង្ហោះ សារ លើ បណ្តាញ សង្គម Twitter រិះគន់ ប្រជាជាតិ ទាំង បី រួម ជាមួយនិង ម៉ិចស៊ីកូ ដោយសារតែ ពួកគេ បរាជ័យ មិន អាច រារាំង លំហូរ ចូល នៃ ជន អន្តោប្រវេសន៍ ខុស ច្បាប់ មក ក្នុង សហរដ្ឋ អាមេរិក ។ បន្ថែម ពី នេះ លោក ត្រាំ ក៏ បាន គំរាម បិទ ព្រំដែន ភាគ ខាងត្បូង ជាប់ ម៉ិចស៊ីកូ ទាំងស្រុង ឬមួយ ផ្នែក ធំ ផងដែរ នា សប្តាហ៍ ក្រោយ ។
គួរ ជម្រាប ថា ដោយសារ ភាពក្រីក្រ បទល្មើស ផ្សេង ៗ រួមទាំង អំពើពុករលួយ ហ្គាតេម៉ា ហុង ដូរ៉ាស់ និង អែល សាល វ៉ាឌ័រ បាន ក្លាយជា ប្រភព ចម្បង នៃ ជន អន្តោប្រវេសន៍ ដែល ព្យាយាម ភៀសខ្លួន មកកាន់ ទឹកដី អាមេរិក ៕ សមណ និស្សិត ជិត ៧០០ រូប ប្រឡង ចូលរៀន ថ្នាក់ ឆ្នាំ សិក្សា មូលដ្ឋាន នៅ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា
( ភ្នំពេញ ) ៖ សមណ និស្សិត - និស្សិត ចំនួន ៦៧០ រូប មក ពី គ្រប់ រាជធានី ខេត្ត បាន នាំគ្នា មក ប្រឡង ប្រជែង ដើម្បី ចូលរៀន ថ្នាក់ ឆ្នាំ សិក្សា មូលដ្ឋាន ក្នុង ឆ្នាំ សិក្សា ២០១៩ - ២០២០ លើ ឯកទេស ចំនួន ៦ គឺ ទស្សនវិជ្ជា និង សាសនា វិទ្យាសាស្រ្ត អប់រំ នីតិសាស្រ្ត អក្សរសាស្រ្ត អង់គ្លេស គ្រប់គ្រង ទូទៅ និង ព័ត៌មានវិទ្យា នៅ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា ។
ជាមួយគ្នា នោះ ព្រះសុមេធ វង្ស សុខ ប៊ុន ធឿន ព្រះប្រធាន ផ្នែក ពុទ្ធិក ឧត្តម សិក្សា ក៏ បាន មាន សង្ឃ ដិការ ថា ការមក ប្រឡង នៅ ពេល នេះ ទាល់តែ មាន សមត្ថភាព ទើប អាច ជាប់ នឹង ចូលរៀន ថ្នាក់ ឆ្នាំ សិក្សា មូលដ្ឋាន បាន ព្រោះ នៅ ទីនេះ ត្រូវការ ធនធាន ដ៏ ពិតប្រាកដ ដែល នឹង ក្លាយទៅជា អ្នកដឹកនាំ អង្គភាព ស្ថាប័ន រដ្ឋ និង ឯកជន ដ៏ មាន សក្កដានុពល សម្រាប់ បំរើ ប្រទេសជាតិ នៅពេល អនាគត ។
ព្រះអង្គ បញ្ជាក់ ថា ពុទ្ធិក សាកលវិទ្យាល័យ មាន បង្រៀន ទាំង ផ្នែក លោក វិទ្យា ដែល ហៅ ថា វិទ្យាសាស្រ្ត និង ធម្មវិជ្ជា សិក្សា ដែល មាន សីលធម៌ ទស្សនវិទ្យា និង សាសនា ជាដើម ។ ក្រៅពី នោះ ក៏ មាន ការបណ្តុះបណ្តាលឱ្យ មនុស្ស មាន គុណធម៌ ក្លាយទៅជា អ្នកប្រាជ្ញ តាមរយៈ បង្រៀន ឱ្យ ស្គាល់ ពី គុណធម៌ សីល គុណ និង វប្បធម៌ ដោយ ប្រកាន់ នូវ លទ្ធិ ឥស្សូ និង ឥស្សី ធ្វើឱ្យ មនុស្ស មាន ចំណេះដឹង មាន សមត្ថភាព និង មាន ជំនាញ ពិតប្រាកដ ។
លោក សេង មុនី រដ្ឋលេខាធិការ ជា តំណាង រដ្ឋមន្រ្តី ក្រសួង ធម្មការ និង សាសនា បាន មានប្រសាសន៍ ថា អ្នក រៀន នៅ ទីនេះ បាន ក្លាយទៅជា អ្នកដឹកនាំ នៅ តាម ក្រសួង ស្ថាប័ន រដ្ឋ និង ឯកជន ជាច្រើន ។ ដូច្នេះ អ្នក ទាំងអស់ គ្នា ត្រូវតែ បន្ត វប្បធម៌ នេះ ឱ្យ បាន ច្រើន ថែម ទៀត ។
លោក បញ្ជាក់ ថា ក្នុង ចំណោម បេក្ខជន ជិត ៧០០ រូប ដែល មក ប្រឡង នៅ ថ្ងៃ នេះ គឺ ត្រូវ កំណត់ យក តែ ៥០០ រូប ប៉ុណ្ណោះ ដូច្នេះ អ្នកចាំ អ្នក ចេះ គឺ ត្រូវតែ ជាប់ នឹង បាន ចូល រៀន ទទួលយក ចំណេះដឹង នៅ ទីនេះ ៕
សមត្ថកិច្ច ចម្រុះ ខេត្ត ត្បូងឃ្មុំ ចាប់ ម៉ូតូ និង រថយន្ត ជាច្រើន គ្រឿង ដឹក ជ្រូក គ្មាន លិខិត អនុញ្ញាត ពី មន្ត្រី ពេទ្យ តាម ច្រក របៀង ពី វៀតណាម
បើ តាម នគរបាល អន្តោប្រវេសន៍ ប្រចាំ ច្រក ទ្វារ អន្តរជាតិ ត្រពាំង ផ្លុង បាន ឲ្យដឹង ថា កាលពី យប់ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ មន្ត្រី អន្តោរប្រវេសន៍ ច្រក ត្រពាំង ផ្លុង បាន ឈរជើង នៅ តាម តំបន់ ច្រក របៀង ក្នុង ដែន សមត្ថកិច្ច ច្រក ត្រពាំង ផ្លុង ក៍ ប្រទះឃើញ ក្រុម ឈ្មួយ ដឹក ជ្រូក ពី វៀតណាម ដែល សង្ស័យ ថា គ្មាន ច្បាប់ អនុញ្ញាត ក៍ បាន ឃាត់ខ្លួន ក្រុម ទាំងនោះ បន្ទាប់មកក៍ បាន រាយការណ៍ ភ្លាម ទៅកាន់ លោក ស្នងការ ខេត្ត និង លោក អភិបាល ខេត្ត ។
ភ្លាម ៗ ក្រោយ ទទួល ដំណឹង លោក អភិបាល ខេត្ត និង លោក ស្នងការ ខេត្ត បាន ចាត់ ឲ្យ ក្រុម សមត្ថកិច្ច ចម្រុះ សហការ គ្នា ចុះ ទៅ បង្ក្រាប ជា បន្តបន្ទាប់ រហូតដល់ ព្រឹក ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ ទើប ប្រគល់ មនុស្ស និង វត្ថុតាង ទៅឲ្យ ជំនាញ បសុពេទ្យ នៃ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ត្បូងឃ្មុំ ដើម្បី ចាត់ការបន្ដ តាម នីតិវិធី ។
( វ៉ាស៊ីនតោន ) ៖ តាមរយៈ ការប្រើប្រាស់ កែវយឺត មួយ ប្រភេទ ដែល បំពាក់ នៅលើ យន្តហោះ តារាវិទូ បាន អង្កេតឃើញ ការចាប់កំណើត នៃ ផ្កាយ មួយ ក្រុម ដែល ស្ថិត នៅ ចម្ងាយ ជិត ១៧.០០០ ឆ្នាំ ពន្លឺ ពី យើង ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ ។
ក្រោម អធិបតីភាព លោក ស៊ាន បូរ៉ាត រដ្ឋលេខាធិការ និង ជា តំណាង លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្រ្តី ក្រសួង អប់រំ យុវជន និង កីឡា ដែល បាន ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ២៨ - ៣០ ខែមីនា ឆ្នាំ ២០១៩ នៅ សាល មហោស្រព កោះ ពេជ្រ ។
ការបោះជំរំ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី វា គ្មិន ល្បី ៗ រួម មាន លោក បណ្ឌិត បាក់ អុក ស៊ូ ស្ថាបនិក អង្គការ សម្ព័ន្ធ យុវជន អន្តរជាតិ លោក បណ្ឌិត លី ឆេង តំណាងរាស្ត្រ មណ្ឌល រាជធានី ភ្នំពេញ និង ជា សមាជិក គណៈកម្មាធិការ ប្រឹក្សា យោបល់ នៃ អង្គការ សម័្ពន្ធ យុវជន អន្តរជាតិ ឧត្តមសេនីយ៍ ត្រី ចេវ ហាក់ ស្នងការ រង នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ( ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ) និង វា គ្មិន ល្បី ៗ ជាច្រើន នាក់ ទៀត ។
ក្នុង ឱកាស នោះ ដែរ ឯកឧត្តម បណ្ឌិត លី ឆេង បាន លើកឡើង ថា ការបោះជំរំ នេះ ក្នុង គោលបំណង ៤គឺ៖
១. យល់ដឹង អំពី ការអប់រំ ចិត្ត ខ្លួន ឯង ចេះ ស្រឡាញ់ ជាតិ មាតុភូមិ គ្រួសារ និង ខ្លួន ឯង ។ ទន្ទឹម នោះ ត្រូវ ចេះ គោរព ច្បាប់ រដ្ឋ ច្បាប់ ធម្មជាតិ សាសនា ។ល ។
ក្នុង ឱកាស នោះ ដែរ លោក បណ្ឌិត បាក់ អុក ស៊ូ គ្រូ ជំនាញ ផ្នែក អប់រំ ចិត្ត បាន មានប្រសាសន៍ ថា ការអប់រំ ស្មារតី និង ចិត្ត គំនិត ពិតជា មាន សារៈសំខាន់ ណាស់ សម្រាប់ យុវជន កម្ពុជា ដើម្បី យល់ ពី អត្ថន័យ ពិត នៃ ជីវិត ចេះ ផ្លាស់ប្តូរ ផ្នត់គំនិត រៀន ទទួលយក នូវ គំនិត របស់ អ្នកដទៃ និង បើកចិត្ត ឲ្យ ទូលាយ ក្នុង ការទំនាក់ទំនង ដើម្បី រស់ នៅ ចុះ សម្រុង ក្នុង សង្គម ។
ក្នុង ពិធី បិទ នេះ ដែរ លោក ស៊ាន បូរ៉ាត បាន មានប្រសាសន៍ ថា ក្នុង នាម ក្រសួង អប់រំ យុវជន និង កីឡា សូម កោតសរសើរ និង ថ្លែងអំណរគុណ ចំពោះ លោក បណ្ឌិត បាក់ អុក ស៊ូ ស្ថាបនិក អង្គការ សម្ព័ន្ធ យុវជន អន្តរជាតិ មកពី ប្រទេស កូរ៉េ និង លោក លី ឆេង តំណាងរាស្ត្រ មណ្ឌល រាជធានី ភ្នំពេញ និង ជា សមាជិក គណៈកម្មាធិការ ប្រឹក្សា យោបល់ នៃ អង្គការ សម័្ពន្ធ យុវជន អន្តរជាតិ ដែល បាន សហការរៀបចំ កម្មវិធី ដ៏ មាន សារៈសំខាន់ នេះ ឡើង និង ទទួលបាន ជោគជ័យ ។
ក្នុង ឱកាស នោះ ដែរ លោក ស៊ាន បូរ៉ាត បាន មានប្រសាសន៍ ថា ការពង្រឹង គុណភាព អប់រំ គឺជា គ្រឹះ ដ៏ រឹងមាំ សម្រាប់ ឲ្យ យុវជន របស់ យើង មាន ចំណេះដឹង ពិតប្រាកដ មាន សិលធម៌ ល្អ មាន គុណធម៌ និង គតិបណ្ឌិត អាច ចេះ ពិចារណា រក ហេតុ នឹង ផល ឲ្យ ឃើញ នេះ ជា ចំណុច ដ៏ សំខាន់ ណាស់ ។
លោក ស៊ាន បូរ៉ាត បាន បន្ត ថា ប្រសិនបើ យុវជន ខ្វះ សិលធម៌ ដើរ ខុស ទិស ហើយ ទៅ រក គោលដៅ ដែល គេ អត់ ចង់បាន សង្គម មិន ទទួលស្គាល់ នេះ ហើយ ជា បរិបទ របស់ សង្គម ដែល យើង កំពុង ធ្វើ កិច្ចការងារ នេះ ដើម្បី អប់រំ យុវជន ។ យុវជន គឺជា ក្រដាស ដ៏ ស ស្អាត ប្រសិនបើ យើង អុស ទាញ គេ ទៅ រក ផ្លូវ ល្អ ពួកគេ នឹង ក្លាយទៅជា ជន ដែល មាន ភាពប្រសព្វ មាន ភាព ទៅ ឆ្លាត ហើយ អាច បណ្ដុះចិត្ត គិនិត តាមរយៈ ការផ្ដល់ នៅ ចំណេះដឹង ដល់ ពួកគេ គ្រប់ ៗ គ្នា ។
លោក បាន បន្ត ថា ដើម្បីឲ្យ ប្អូន ៗ ក្មួយ ៗ ក្លាយទៅជា ជន ដែល មាន សក្ដានុពល ក្នុង ការចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី បន្ដ វេន ក្នុង ការដឹកនាំ ប្រទេសជាតិ ទៅ ថ្ងៃ អនាគត គោលការណ៍ ដល់ សំខាន់ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការកសាង ធនធាន មនុស្ស ចាប់ពី មត្តេយ្យ សិក្សា រហូតដល់ ឧត្តម សិក្សា ។
ក្នុង ពិព័រណ៍ នោះ នឹង មាន តាំង បង្ហាញ ទំនិញ សម្លៀកបំពាក់ ផលិតផល ធ្វើ ពី ស្បែក វត្ថុអនុស្សាវរីយ៍ សម្ភារ ប្រើប្រាស់ ក្នុង ផ្ទះ និង គ្រឿងសង្ហារឹម ។
ឧប នាយក រដ្ឋមន្ដ្រី កែ គឹម យ៉ាន ជួប សំណេះសំណាល និង ពិសារ អាហារ សាមគ្គី ជាមួយ ក្រុមការងារ យុវនិស្សិត ខេត្ត បន្ទាយមានជ័យ
( សៀមរាប ) ៖ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត បន្ទាយមានជ័យ និង លោកស្រី ម៉ៅ ម៉ាល័យ នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ជួប សំណេះសំណាល និង ពិសារ អាហារ សាមគ្គី ជាមួយ ក្រុមការងារ យុវនិស្សិត ខេត្ត បន្ទាយមានជ័យ ដែល បាន និង កំពុង បន្ត ការសិក្សា នៅ ខេត្ត សៀមរាប ។
ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ថ្លែង នូវ ការកោតសសេីរ ដល់ ក្មួយ ៗ យុវនិស្សិត ខេត្ត បន្ទាយមានជ័យ ទាំងអស់ ដែល បាន ចាកចេញ ពី លំនៅដ្ឋាន ឪពុក ម្តាយ មក បន្ត ការសិក្សា នៅ លេី ទឹកដី ខេត្ត សៀបរាប ដែល មិន មែន ជា ទី កំណេីត បាន ខិតខំ រៀនសូត្រ ចេះ ស្រឡាញ់ រាប់អាន គ្នា ជួយ គ្នា ទៅ វិញ ទៅ មក ជា ពលរដ្ឋ ល្អ រួម សហការ ល្អ ជាមួយ សហគមន៍ មូលដ្ឋាន និង បាន ចូលរួម ការងារ សង្គម មនុស្សធម៌ ។
ជាមួយនឹង ការគិតគូរ ថែរក្សា ត្រពាំង ឲ្យបាន ល្អ សម្រាប់ បន្ត វេន ទៅ ថ្ងៃ អនាគត ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន និង លោកស្រី ព្រមទាំង ក្រុម កាងារ បាន ឧបត្ថម្ភ ថវិកា សម្រាប់ ជួយ ទ្រទ្រង់ មូលនិធិ យុវជន ក្រីក្រ ខេត្ត បន្ទាយមានជ័យ ចំនួន ៣៨.០០០ ដុល្លារ . ក្រុមការងារ យុវនិស្សិត ខេត្ត បន្ទាយមានជ័យ ប្រចាំ ខេត្ត សៀមរាប ចំនួន ៥០ នាក់ ម្នាក់ ទទួលបាន ថវិកា ១០មុឺន រៀល និង យុវនិស្សិត ខេត្ត បន្ទាយមានជ័យ មក បន្ត ការសិក្សា នៅ ខេត្ត សៀមរាប ចំនួន ៤៥០ នាក់ ម្នាក់ ទទួលបាន ថវិកា ៥មុឺន រៀល ផងដែរ ៕
ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន៖ ប្រទេសជាតិ មាន សុខ សន្តិភាព ធ្វើឲ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ព្រះពុទ្ធ សាសនា ត្រូវបាន លើកកម្ពស់ ជា បន្តបន្ទាប់
( ព្រះវិហារ ) ៖ ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច បាន គូសបញ្ជាក់ ថា ប្រទេសជាតិ មាន សុខ សន្តិភាព ស្ថេរភាព ធ្វើឲ្យ មាន ការរីកចម្រើន អភិវឌ្ឍ លើ គ្រប់ វិស័យ ក្នុង នោះ វិស័យ ព្រះពុទ្ធ សាសនា ក៏ ត្រូវបាន លើកកម្ពស់ ជា បន្តបន្ទាប់ ។
នេះ ជា លើកឡើង ក្នុង ពេល ដែល លោកស្រី តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា អញ្ជើញ ជា អធិបតី ក្នុង ពិធី អភិសេក ប្រាសាទ ចតុមុខ នៅក្នុង ខេត្ត ព្រះវិហារ នា ព្រឹក ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ នេះ ។
ក្នុង ឱកាស សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ លោកស្រី ម៉ែន សំអន បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ជានិច្ចកាល សម្តេច ទាំង ពីរ តែងតែ មាន មនោសញ្ចេតនា ស្រឡាញ់ រាប់អាន និង រួម សុខ ទុក្ខ ជាមួយ បងប្អូន ជន រួម ជាតិ ទាំងអស់ និង ជួយ ដោះស្រាយ ទុក្ខលំបាក សព្វ បែប យ៉ាង គ្រប់ ទីកន្លែង ទូទាំង ប្រទេស កម្ពុជា ។
មិន តែ ប៉ុណ្ណោះ សម្តេច ទាំង ពីរ គឺជា ពុទ្ធសាសនូបត្ថម្ភ ដ៏ ថ្លៃថ្លា ដោយ បាន ប្រែក្លាយ ពី ប្រទេស ដែល ពោរពេញ ទៅ ដោយ សង្រ្គាម មក ជា ប្រទេស ដែល មាន ការរីកចម្រើន និង មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ក្នុង នោះ វិស័យ ព្រះពុទ្ធ សាសនា និង ជំនឿ សាសនា ក៏ ត្រូវបាន រស់ ឡើងវិញ ។
ជាក់ស្តែង ពិធី បុណ្យ ឆ្លង នា ពេលនេះ ដើម្បី ឧទ្ទិស ដល់ ព្រះពុទ្ធ សាសនា ផង ក៏ ដូច រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍ ជាតិ ផង និង បាន ទទួល អានិសង្ឃ ផល បុណ្យ យ៉ាង ត្រចះត្រចង់ ផងដែរ ។ សមិទ្ធផល ថ្មី នេះ ពិតជា រួមចំណែក ជួយ ដល់ ខេត្ត ព្រះវិហារ ក្នុង ការជំរុញ ដល់ ការទាក់ទាញ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ មក ទស្សនា និង ស្វែងយល់ ពី អរិយធម៌ វប្បធម៌ ខ្មែរ ដ៏ រុងរឿង ថែមទាំង បាន រួមចំណែក ប្រមូល ថវិកា ជូន ជាតិ ទៀតផង ។
សូម បញ្ជាក់ ថា ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ និង សហការី បាន សិក្សា ស្រាវជ្រាវ និង ជួសជុល ប្រាសាទ នេះ ឡើងវិញ ដោយ ប្រើ ពេលវេលា ប្រមាណ ជាង ៥ខែ ចាប់ពី ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០១៨ ដល់ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ទើប បាន បញ្ចប់ ក្រោម កិច្ច សម្របសម្រួល ពីសំណាក់ អាជ្ញាធរ ខេត្ត រួម ជាមួយ អង្គភាព ពាក់ព័ន្ធ នានា ៕
ព្រះមហាក្សត្រ ថៃ ដកហូត គ្រឿង ឥស្សរិយយស ពី លោក ថាក់ស៊ីន ក្រោយ រិះគន់ ការបោះឆ្នោត ថា គ្មាន តម្លាភាព
នា ឱកាស ធ្វើ សន្និសីទ សារព័ត៌មាន នៅ សណ្ឋាគារ សុខា អង្គរ នា ថ្ងៃទី ៣០ ខែមីនា ឆ្នាំ ២០១៩ នេះ លោក ជា បូរ៉ា រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង ជា អគ្គ លេខាធិការ សហព័ន្ធ វាយ កូល គោល កម្ពុជា បាន ឱ្យដឹង ថា ព្រឹត្តិការណ៍ កីឡា វាយ កូនគោល អាស៊ី លើក ទី៨ នេះ នឹង ប្រព្រឹត្តទៅ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ៣ - ៥ ខែមេសា ឆ្នាំ ២០១៩ ខាងមុខ ។ កីឡា វាយ កូនគោល នេះ ធ្វើឡើង នៅ ទីលាន វាយ កូនគោល របស់ រមណីយដ្ឋាន សុខា - អង្គរ សណ្ឋាគារ ភូកេត្រា និង សណ្ឋាគារ ប៊ូយ៉ុង ។
លោក បាន បន្ត ថា ជាមួយនឹង ព្រឹត្តិការណ៍ កីឡា វាយ កូនគោល នេះ ក៏ មាន ពិធី ជួបជុំ ដ៏ ធំ មួយ រវាង អ្នកលក់ និង អ្នកទិញ ប្រមាណ ជាង ៤០០ នាក់ ដើម្បី ពិភាក្សា គ្នា លើ ការទិញ - លក់ កញ្ចប់ ទស្សនកិច្ច ទេសចរណ៍ ជូន ភ្ញៀង ទេសចរ ពីព្រោះ ពួកគេ ភាគ ច្រើន ជា ក្រុមហ៊ុន នាំ ភ្ញៀវ ទេសចរ ដើរ ទស្សនា ផង និង លេង កីឡា ផង ពិសេស កីឡា វាយ កូនគោល នេះ តែម្ដង ។
លោក រដ្ឋលេខាធិការ ជា បូរ៉ា បាន បន្ត ទៀត ថា « ទេសចរណ៍ កីឡា វាយ កូនគោល នេះ ជា ប្រភេទ ទេសចរណ៍ មួយ ដែល ភ្ញៀវ ទេសចរ មាន ការចំណាយ ច្រើន ជាង ដំណើរកម្សាន្ត ផ្សេង ៗ ពីព្រោះ អ្នក ចូល លេង ភាគ ច្រើន ជា អ្នក វិនិយោគ ម្ចាស់ ក្រុមហ៊ុន មហាសេដ្ឋី ឬក៏ អ្នក ដែល មាន ជីវភាព ធូរធាណាស់ » ។
លោក អះអាង ថា ការរៀបចំ ព្រឹត្តិការណ៍ កីឡា នេះ គឺ ស្រប ទៅនឹង គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា ក្រសួង ទេសចរណ៍ ដែល កំពុង ខិតខំ ជំរុញ វិស័យ ទេសចរណ៍ កីឡា វាយ កូល គោល នេះ ឱ្យ រីក ដុះដាល ឡើង ដើម្បី ផ្សព្វផ្សាយ ពី វិស័យ ទេសចរណ៍ នៅ កម្ពុជា ផង និង ដើម្បី ត្រៀមខ្លួន ក្នុង ការប្រកួត កីឡា ស៊ីហ្គេម ឆ្នាំ ២០២៣ ដែល កម្ពុជា នឹង ទទួល ធ្វើ ម្ចាស់ ផ្ទះ ។
នៅក្នុង សន្និសីទ សារព័ត៌មាន ខាងលើ ដូចគ្នា លោក Peter walton អគ្គ នាយក អង្គការ ទេសចរណ៍ វាយ កូនគោល អន្តរជាតិ បាន ឱ្យដឹង ថា ព្រឹត្តិការណ៍ កីឡា វាយ កូនគោល អន្តរជាតិ នេះ តែង ធ្វើឡើង នៅ តាម ប្រទេស នានា ជារៀងរាល់ ឆ្នាំ ដូចជា នៅ ប្រទេស ថៃ ម៉ាឡេស៊ី ចិន ឥណ្ឌូនេស៊ី វៀតណាម ហ្វីលីពីន ហើយ នៅ ឆ្នាំ ២០១៩ នេះ អង្គការ លោក បាន ជ្រើសរើសយក ខេត្ត សៀមរាប ប្រទេស កម្ពុជា រៀបចំ ព្រឹត្តិការណ៍ នេះ ឡើង ។
លោក ប្រាប់ ពី មូលហេតុ ថា ដោយសារ ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ពេញលេញ មាន ទីលាន វាយ កូនគោល បទដ្ឋាន អន្តរជាតិ មាន តំបន់ ទេសចរណ៍ ដ៏ ល្បីល្បាញ នៅ ទូទាំង ពិភពលោក គឺ សៀមរាប - អង្គរ ទើប ភ្ញៀវ ទេសចរ និង អ្នក វិនិយោគ ធំ ៗ លើ វិស័យ ទេសចរណ៍ កីឡា វាយ កូនគោល ពេញចិត្ត ក្នុង ការមក ទស្សនា និង មក ចូលរួម ក្នុង ព្រឹត្តិការណ៍ កីឡា អន្តរជាតិ ដ៏ ធំ នេះ ។
អគ្គ នាយក រូប នេះ បាន បន្ថែម ថា អ្នកចូលរួម ទាំងនោះ មិន ត្រឹមតែ មក លេង កីឡា វាយ កូនគោល ប៉ុណ្ណោះ ទេ តែ ថែមទាំង បាន ចូល ទស្សនា នៅ តាម ប្រាសាទ និង រមណីយដ្ឋាន ទេសចរណ៍ នានា នៅ កម្ពុជា ពិសេស គឺ ប្រាសាទ អង្គរវត្ត ហើយ នឹង បាន ភ្លក្ស ម្ហូប អាហារ ខ្មែរ ដែល មាន រសជាតិ ឆ្ងាញ់ ពិសា បាន មើលឃើញ ដោយ ផ្ទាល់ នូវ ស្នាមញញឹម ពី ធម្មជាតិ និង ភាពរួសរាយ រាក់ទាក់ របស់ ប្រជាជន កម្ពុជា ។
ជាមួយគ្នា នោះ លោក ជា បូរ៉ា បាន បង្ហាញ ការរំពឹងទុក ថា តាមរយៈ ព្រឹត្តិការណ៍ កីឡា វាយ កូនគោល ពិភពលោក លើក ទី៨ នេះ នឹង ចូលរួម ផ្សព្វផ្សាយ ពី វិស័យ ទេសចរណ៍ នៅ កម្ពុជា សំដៅ ជំរុញ កំណើន ទេសចរ អន្តរជាតិ មកកាន់ កម្ពុជា បន្ថែម ទៀត ក្រោយពី កម្ពុជា ទទួលបាន ភ្ញៀវ ទេសចរ អន្តរជាតិ ប្រមាណ ៦.២លាន នាក់ កើនឡើង ១០.៧ភាគរយ នៅ ឆ្នាំ ២០១៨ កន្លងទៅ ៕
អភិបាល ខេត្ត ព្រះសីហនុ បញ្ចប់ ការចូលរួម វេទិការសន្ទនា អភិបាល ខេត្ត អាស៊ាន និង ចិន . វិនិយោគិន ចិន ចាប់អារម្មណ៍ អំពី សក្តានុពល វិនិយោគ នៅ កម្ពុជា
( ព្រះសីហនុ) ៖ លោក យន្ត មីន អភិបាល ខេត្ត ព្រះសីហនុ បាន បញ្ជាក់ ថា វិនិយោគិន ចិន នៃ កោះ ហៃ ណាន់ និង ម៉ាកាវ បាន ចាប់អារម្មណ៍ អំពី សក្តានុពល វិនិយោគ នៅ កម្ពុជា និង បាន សន្យា ថា នឹង រក ពេលវេលា សមស្រប មក សិក្សា ស្វែងយល់ ពី ឱកាស វិនិយោគ នៅ កម្ពុជា ជាពិសេស លើ វិស័យ ទេសចរណ៍ និង ឧស្សាហកម្ម ។
លោក យន្ត មីន បាន ថ្លែង យ៉ាង ដូច្នេះ នា ល្ងាច ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ នេះ ក្នុង ឱកាស វិល ត្រលប់ មកដល់ ប្រទេស កម្ពុជា វិញ បន្ទាប់ពី បញ្ចប់ ការចូលរួម វេទិការសន្ទនា អភិបាល ខេត្ត អាស៊ាន និង ចិន រយៈពេល ៥ ថ្ងៃ នៅ ប្រទេស ចិន ។
នៅពេល អញ្ជើញ ដល់ ព្រលាន អន្តរជាតិ ភ្នំពេញ នា រសៀល ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ នេះ លោក យន្ត មីន បាន ថ្លែង ប្រាប់ អ្នកសារព័ត៌មាន ឱ្យដឹង ទៀត ថា រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន ទៅ ចូលរួម ក្នុង កិច្ចប្រជុំ រដ្ឋបាល ខេត្ត របស់ ប្រទេស អាស៊ាន ដែល បាន ប្រព្រឹត្តទៅ នៅ តំបន់ ស្វ័យ ត័ម៉ាកាវ និង កោះ ហៃ ណាន់ ព្រមទាំង បាន ធ្វើ ទស្សនកិច្ច នៅ តំបន់ អភិវឌ្ឍន៍ មួយចំនួន របស់ ប្រទេស ចិន ផងដែរ ។
លោក យន្ត មីន បាន ឱ្យដឹង បន្ត ថា ដំណើរទស្សនកិច្ច នេះ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី សិក្សា ស្វែងយល់ បទពិសោធន៍ នៃ ការអភិវឌ្ឍ ខេត្ត ពី គ្នា ទៅ វិញ ទៅ មក ការពង្រឹង មិត្តភាព និង សាមគ្គីភាព រវាង គ្នា និង គ្នា ។
លោក បញ្ជាក់ ថា ឆ្លៀត ក្នុង ឱកាស នៃ កិច្ចប្រជុំ លោក ក៏ បាន បង្ហាញ អំពី សក្តានុពល ដ៏ ល្អ របស់ កម្ពុជា ជាពិសេស ខេត្ត ព្រះសីហនុ ព្រមទាំង បាន អំពាវនាវ ដល់ វិនិយោគិន ចិន ឱ្យ មក បណ្តាក់ទុន វិនិយោគ នៅ កម្ពុជា ផងដែរ ៕ តុលាការ ចេញ ដីកា ឃុំ ខ្លួន បុរស ម្នាក់ ដាក់ ពន្ធនាគារ ករណី បង្ហោះ ព័ត៌មាន មិន ពិត ធ្វើឲ្យ ប៉ះពាល់ ដល់ រាជ រដ្ឋាភិបាល
នៅក្នុង ដីកា របស់ តុលាការ ជន ជាប់ចោទ ត្រូវបាន ព្រះរាជអាជ្ញា ចោទប្រកាន់ ពី បទ « ការញុះញង់ ឲ្យ ប្រព្រឹត្ត បទឧក្រិដ្ឋ ជាអាទិ៍ » ។
សូម បញ្ជាក់ ថា កម្លាំង នគរបាល នាយកដ្ឋាន ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា ក្រសួង មហាផ្ទៃ កាលពី ថ្ងៃទី ២៦ ខែមីនា បាន សហការ ជាមួយ កម្លាំង នគរបាល ព្រហ្មទណ្ឌ និង នគរបាល ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ ចុះ អនុវត្ត ដីកា បញ្ជា ឲ្យ ចូល ខ្លួន លេខ ០៩៨ ចុះ ថ្ងៃទី ២៦ ខែមីនា ឆ្នាំ ២០១៩ ចេញ ដោយ លោក កែវ សុធា ព្រះរាជអាជ្ញ អម សាលាដំបូង រាជធានី ភ្នំពេញ ឃាត់ខ្លួន បុរស ម្នាក់ ឈ្មោះ វឿន គឹម លន់ អាយុ ២៤ ឆ្នាំ រស់ នៅ ភូមិ ព្រហូត សង្កាត់ អូរ អំបិល ក្រុង សិរី សោភ័ណ ។
ក្រសួង បាន បញ្ជាក់ ថា ការផ្តល់ បន្ត ប្រតិបត្តិ ឡើងវិញ នេះ ដោយសារ ក្រសួង ត្រូវការ ពេលវេលា គ្រប់គ្រាន់ ក្នុង ការសិក្សា ឲ្យបាន គ្រប់ ជ្រុងជ្រោយ លើ លក្ខខណ្ឌ គិត យុត្តិ និង បច្ចេកទេស ពាក់ព័ន្ធ ក្នុង ការគ្រប់គ្រង ដំណើរការ ផ្លូវ ដែក ក្រសួង អនុញ្ញាតឲ្យ ក្រុមហ៊ុន រ៉ូយ៉ាល់ រេវ៉េ បន្ត ប្រតិបត្តិការ ដឹកជញ្ជូន ទំនិញ និង អ្នកដំណើរ តាម ផ្លូវ ដែក ភាគ ខាងត្បូង ដដែល ។
សូម ជំរាប ថា ក្នុង វេទិកា រាជ រដ្ឋាភិបាល និង វិស័យ ឯកជន លើក ទី១៨ កាលពី ថ្ងៃសុក្រ ទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ កន្លងទៅ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ដកហូត សិទ្ធិ វិនិយោគ និង ធ្វើ អាជីវកម្ម លើ ផ្លូវ រថយន្ត ពី ភ្នំពេញ ទៅកាន់ ខេត្ត ព្រះសីហនុ បន្ទាប់ពី សម្តេច បាន មើលឃើញ ថា ផ្លូវ ដែក មួយ ខ្សែ នេះ មិន មាន ការអភិវឌ្ឍ សមត្ថភាព ផ្នែក ដឹកជញ្ជូន ។ ក្រោយពេល ដកហូត គឺ ប្រគល់ ភារកិច្ច ទៅឲ្យ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ជា អ្នកគ្រប់គ្រង និង រង់ចាំ រក អ្នក វិនិយោគ ថ្មី ។
( កណ្តាល ) ៖ លោក វង្សី វិស្សុត រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ អនុប្រធាន ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ប្រចាំ ស្រុក មុខ កំពូល ខេត្ត កណ្តាល បាន អញ្ជើញ ក្នុង ពិធី បុណ្យ ឆ្លង ព្រះវិហារ និង សមិទ្ធផល នានា នៅក្នុង ពុទ្ធ សីមាវត្ត វេឡុវនា រាម ហៅ វត្ត ស្វាយ អំពារ ស្ថិត នៅក្នុង ឃុំ ស្វាយ អំពារ ស្រុក មុខ កំពូល ខេត្ត កណ្តាល ។
គួរ បញ្ជាក់ ដែរ ថា វត្ត វេឡុវនា រាម ហៅ វត្ត ស្វាយ អំពារ ត្រូវបាន កសាងឡើង នៅក្នុង ឆ្នាំ ១៨៦៧ ដែល គិត មក ទល់នឹង ពេលនេះ មាន អាយុកាល ជាង ១៥២ ឆ្នាំ មកហើយ និង បាន ឆ្លងកាត់ ការដឹកនាំ របស់ ព្រះចៅ អធិការ ចំនួន ០៦ អង្គ ។
នៅក្នុង ឆ្នាំ ២០១៥ ដោយ មើលឃើញ ពី សំណង់ ព្រះវិហារ ដែល សភាព ទ្រុឌទ្រោម ខ្លាំង ព្រះចៅ អធិការ វត្ត និង គណៈកម្មការ អាវត្ត ព្រមទាំង ពុទ្ធ បរិស័ព ចំណុះ ជើង វត្ត បាន រុះរើ ធ្វើ ព្រះវិហារ ថ្មី និង បាន កសាង នូវ សមិទ្ធផល ជាច្រើន ទៀត ដូច ជា៖ របង ក្លោងទ្វា កុដិ និង ការចាក់ សាប នៅក្នុង ធ្លាវត្ត ដោយ ចំណាយ អស់ ទឹកប្រាក់ ប្រមាណ ជិត ២៥ ម៉ឺន ដុល្លារ អាមេរិក ។
លោក វង្សី វិស្សុត បាន បន្ត ថា ការរីកចម្រើន នៅក្នុង ទី អារាម នេះ ក៏ ដូចជា នៅក្នុង ទី អារាម នានា នៅ ទូទាំង ប្រទេស គឺជា ការសបញ្ជាក់ ឱ្យ ឃើញ ថា ប្រទេសជាតិ របស់ យើង កាន់តែ រីកចម្រើន ហើយ សេដ្ឋកិច្ច ជាតិ យើង ក៏ កាន់តែ លូតលាស់ ជាពិសេស បងប្អូន ប្រជាពលរដ្ឋ កាន់ តែ មាន ជីវភាព ធូរធា ។
រាជ រដ្ឋាភិបាល បាន កសាង នូវ សមិទ្ធផល ជាច្រើន ជូន ប្រទេសជាតិ និង ប្រជាជន ។ ដោយឡែក នៅក្នុង ស្រុក មុខ កំពូល របស់ យើង និយាយ ជា រួម និង ដោយឡែក នៅក្នុង ឃុំ ស្វាយ អំពារ របស់ យើង ក៏ ទទួលបាន នូវ សមិទ្ធផល ជាច្រើន ផងដែរ ដូចជា ផ្លូវ និង ប្រឡាយ ទឹក ជាដើម ។ល ។
សម ទិ្ធផល ទាំងនេះ បាន និង កំពុង ប្រែក្លាយ មុខមាត់ របស់ ឃុំ ស្វាយ អំពារ របស់ យើង ទាំងមូល ។ ជាក់ស្តែង ការស្ថាបនា ផ្លូវ បាន ជួយ ធ្វើឱ្យ ឃុំ ស្វាយ អំពារ របស់ យើង មាន ការតភ្ជាប់ កាន់តែ ប្រសើរ ជាពិសេស ការតភ្ជាប់ ឃុំ ស្វាយ អំពារ ជាមួយនឹង រាជធានី ភ្នំពេញ ។
ជាមួយគ្នា នេះ ដែរ លោក ក៏ បាន ផ្តាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម បញ្ចូន កូន ចៅ ទៅ សិក្សា រៀនសូត្រ ឱ្យ បាន គ្រប់ ៗ គ្នា ដើម្បី ម្យ៉ាង ធ្វើឱ្យ កូន ចៅ បងប្អូន អាច ទទួលបាន ការងារ ធ្វើ ល្អ . មាន ប្រាក់ ចំណូល និង មាន ជីវភាព ធូរធារ នៅ ថ្ងៃ អនាគត និង ម្យ៉ាងទៀត ដើម្បី ធ្វើ ប្រទេសជាតិ របស់ យើង កាន់តែ រីកចម្រើន ។
លោក ក៏ បាន ផ្តល់ ការណែនាំ ដល់ អាជ្ញាធរ មូលដ្ឋាន យកចិត្តទុកដាក់ ក្នុង បញ្ហា បរិស្ថាន និង ការ រក្សា ការពារ ឱ្យ បាន នូវ ទ្រព្យសម្បត្តិ របស់ រដ្ឋ គ្រប់ ប្រភេទ ព្រមទាំង លុបបំបាត់ នូវ សកម្មភាព អសកម្ម ផ្សេង ៗ នៅក្នុង មូលដ្ឋាន ដូចជា ការប្រើប្រាស់ និង ជួញដូរ គ្រឿង ញឿន ។
នៅក្នុង ឱកាស នោះ ដែរ លោក វង្សី វិស្សុត រួម នឹង ក្រុមការងារ អម ដំណើរ បាន ប្រគេន នូវ បច្ច័យ ១ ម៉ឺន ដុល្លារ អាមេរិក ដល់ ព្រះចៅ អធិការ ដើម្បី ទូទាត់ ថ្លៃ ជំពាក់ ថ្លៃ ជាង ៕ យន្តហោះ ដឹកជញ្ជូន យោធា ទី មួយ ដែល រុស្ស៊ី ផលិត ឡើង ក្រោយ សម័យ សហភាព សូវៀត ឆ្លងកាត់ ការតេស្ត ហោះហើរ លើក ដំបូង ដោយ ជោគជ័យ
អាង ហែលទឹក ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក គ្រោង បញ្ចប់ ការជួសជុល និង សាង សាង់ នៅ ចុង ខែឧសភា ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ អាង ហែលទឹក នៅ ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក គ្រោង បញ្ចប់ ការជួសជុល និង សាងសង់ នៅ ចុង ខែឧសភា ឆ្នាំ ២០១៩ នេះ ដើម្បីឱ្យ អត្តពលិក កម្ពុជា ហ្វឹកហាត់ ត្រៀមខ្លួន យក មេដាយ ជូន ជាតិ ក្នុង ព្រឹត្តិការណ៍ កីឡា ស៊ីហ្គេម ឆ្នាំ ២០២៣ ដែល កម្ពុជា ធ្វើ ម្ចាស់ ផ្ទះ ។
នៅ ថ្ងៃអាទិត្យ ១១រោច ខែ ផល្គុន ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស .២៥៦២ ត្រូវនឹង ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ជា ប្រធាន សហព័ន្ធ កីឡា ហែលទឹក កម្ពុជា បាន អញ្ជើញ ចុះ ពិនិត្យមើល វឌ្ឍនា ភាព ការងារ ជួសជុល និង សាងសង់ អាង ហែលទឹក នៅ ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ ក្រសួង និង សហព័ន្ធ ជាច្រើន រូប ផ្សេង ទៀត ។
ថ្លែង ក្នុង ឱកាស ចុះ ពិនិត្យមើល ការសាងសង់ នោះ លោក ទេសរដ្ឋមន្រ្តី បាន គូសបញ្ជាក់ ពី ការខិតខំ ប្រឹងប្រែង ក្នុង ការស្វែងរក ប្រភព ថវិកា ពី សប្បុរសជន និង ក្រុមហ៊ុន ឯកជន នានា ដើម្បី កសាង អាង ហែលទឹក ឱ្យ បាន ច្រើន កន្លែង ទៀត ក្នុង គោលបំណង អភិវឌ្ឍន៍ វិស័យ កីឡា ហែលទឹក នៅ កម្ពុជា ឱ្យ មាន ការរីកចម្រើន និង ដើម្បី ស្វែងរក មេដាយ ជូន ជាតិ ឱ្យ បាន ច្រើន ក្នុង ព្រឹត្តិការណ៍ កីឡា ស៊ីហ្គេម ដែល កម្ពុជា នឹង ធ្វើ ម្ចាស់ ផ្ទះ នៅ ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
លោក ទេសរដ្ឋមន្រ្តី បាន បន្ថែម ទៀត ថា ការថែទាំ ជួសជុល អាង ហែលទឹក នៅ ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក គម្រោង ចំណាយ រយៈពេល ពី ប្រាំពីរ ខែ ទៅ ប្រាំបី ខែ ហើយ កីឡាករ - កីឡាការិនី ដែល កំពុង ទទួល ការហ្វឹកហាត់បច្ចុប្បន្ន ទាំងអស់ នឹង ត្រូវ ទៅ ហ្វឹកហាត់ នៅ កន្លែង ថ្មី ជា បណ្តោះអាសន្ន សិន រង់ចាំ ការជួសជុល និង សាងសង់ បាន បញ្ចប់ ជាស្ថាពរ ។
ជាមួយគ្នា នេះ លោក ទេសរដ្ឋមន្រ្តី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ សប្បុរសជន ក៏ ដូចជា ក្រុមហ៊ុន ឯកជន នានា ដែល បាន ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ ការជួសជុល ថែទាំ អាង ហែលទឹក ក្នុង ពហុ កីឡដ្ឋាន នេះ ឱ្យ មាន ភាពល្អ ប្រសើរ ឡើងវិញ ប្រកបដោយ លក្ខណៈ ស្តង់ដារ អន្តរជាតិ និង ដែល បាន ចូលរួម ចំណែក អភិវឌ្ឍ វិស័យ កីឡា នៅ កម្ពុជា ។
ការប្រកាស នេះ ត្រូវបាន ធ្វើឡើង កាលពី ព្រឹក ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ នេះ ក្រោម វត្តមាន ចូលរួម ពីសំណាក់ តំណាង រោងចក្រ ផលិត ឧសថ បំប៉ន សុខភាព ផ្ទាល់ ថ្នាក់ដឹកនាំ ក្រុមហ៊ុន និង ភ្ញៀវ កិត្តិយស ហើយ រឿង ដែល អស្ចារ្យ បំផុត នោះ គឺ នៅ ព្រឹក ថ្ងៃ សម្ពោធ នេះ មាន អតិថិជន រាប់ ពាន់ នាក់ បាន ឈរ តំរង់ ជួរ យ៉ាង វែងមុខ ក្រុមហ៊ុន ដើម្បី ចាំ ទិញ ផលិតផល សារ៉ាយ សមុទ្រ ឃូស៊ី ដែល ទិដ្ឋភាព បែប នេះ កម្រ កើតមាន ណាស់ នៅ ប្រទេស កម្ពុជា ។
ការគាំទ្រ យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ បែប នេះ ក៏ ព្រោះតែ ជា ផលិតផល នេះ ប្រើ មួយ ដឹង មួយ មិន ស្តាយ លុយ មាន ប្រសិទ្ធភាព ខ្លាំង ផលិត ពី វត្ថុធាតុ ដើម ធម្មជាតិ សុទ្ធសាទ មាន ស្តង់ដា ខ្ពស់ របស់ អាមេរិក និង មាន អ្នកប្រើប្រាស់ យ៉ាង ច្រើន បាន ជាសះស្បើយ ពី ជម្ងឺ ផ្សេង ៗ ពី គ្នា ។ នេះ បើ តាម ការបញ្ជាក់ របស់ អតិថិជន ដែល បាន ឈរ តំរង់ ជួរ មុខ ក្រុមហ៊ុន សម្រស់ ធម្មជាតិ ដើម្បី ចាំ ទិញ ផលិតផល សារ៉ាយ សមុទ្រ ឃូស៊ី ទាំង ព្រឹក ព្រលឹម ។
លោកស្រី នួន ស៊ុន្ទរី អគ្គ នាយិកា សម្រស់ ធម្មជាតិ បាន លើកឡើង ថា « សុខភាព គឺជា ទ្រព្យ សំខាន់ ជាង គេ ហើយ អ្នកណា ក៏ ចង់ មាន សុខភាព ល្អ ដែរ » ។ លោកស្រី បន្ត ថា ក្រុមហ៊ុន សម្រស់ ធម្មជាតិ បាន កំណត់ ទស្សនវិស្ស័យ យ៉ាង មុត ស្រួច ថា « ក្រុមហ៊ុន នឹង ធ្វើអោយ ប្រជាជន កម្ពុជា មាន សុខភាពល្អ ប្រសើរ ជាង មុន និង អាច រស់ បាន យូរ ជាង មុន ១០ឆ្នាំ បន្ថែម ទៀត នៅ ឆ្នាំ ២០៣០» ។
លោកស្រី បន្ថែម ថា ក្រុមហ៊ុន សម្រស់ ធម្មជាតិ មិន យក សុខភាព និង សម្រស់ របស់ អតិថិជន មក លេងសើច ជាដាច់ខាត ហើយ ទំនុកចិត្ត ពី អតិថិជន គឺជា រឿង សំខាន់ មក លើ ផលិតផល មួយ នេះ ដោយ ទំនុកចិត្ត គឺ កើត ចេញ ពី គុណភាព នៃ ផលិតផល ប្រសិទ្ធភាព នៃ ផលិតផល និង ការសន្យា របស់ ក្រុមហ៊ុន ជាមួយ អតិថិជន ដែល មិន និយាយ កុហក់ អតិថិជន យក តែ លុយ ។
អ្វី ដែល កាន់តែ ធ្វើឲ្យ អតិថិជន ធ្លាប់ ទិញ យក ទៅ ប្រើប្រាស់ ហើយ ជាប់ ចិត្ត នោះ គឺ ផលិតផល របស់ សម្រស់ ធម្មជាតិ ជា ផលិតផល កម្រ គុណភាព លេខ១ ប្រើ មួយ ដឹង មួយ ហើយ អតិថិជន អាច ទទួលបាន ការប្រឹក្សា ពី សុខភាព និង សម្រស់ ជារៀងរហូត ផងដែរ ។
សម្រាប់ ថ្ងៃ បើក ប្រកាស សម្ពោធ ដំណើរការ ជា ផ្លូវការ នេះ ដែរ ក្រុមហ៊ុន ក៏ មាន កម្មវិធី នៃ ការលក់ ជូន ដល់ អតិថិជន ដ៏ អស្ចារ្យ ហើយ មាន តែ ម្តង គត់ គឺ ការទិញ ២កំប៉ុង ថែម ជូន១ កំប៉ុង និង ថែម ជូន ការដូរ ពិសេស ១ កញ្ចប់ ថែម ទៀត ផង ។
លោកស្រី នួន ស៊ុន្ទ រី សង្ឃឹម ថា ការប្រកាស បើក សម្ពោធ ដំណើរការ ផលិតផល ក មួយ នេះ ជា ផ្លូវការ នឹង កាន់តែ ផ្តល់ ទំនុកចិត្ត ខ្ពស់ និង បន្ថែម ភាព កក់ក្តៅ លើ ផលិតផល មួយ នេះ ដល់ អតិថិជន ។
គួរ បញ្ជាក់ ថា ក្រុមហ៊ុន សម្រស់ ធម្មជាតិ ដែល នាំចូល ផលិតផល ពី សហរដ្ឋ អាមេរិក ផ្ដាច់ មុខ មាន តែ មួយ គត់ នៅ ប្រទេស កម្ពុជា មាន អាសយដ្ឋាន ស្ថិត នៅ ផ្ទះ លេខ 35A កែង ផ្លូវ 510 សង្កាត់ ផ្សារ ដើម ថ្កូវ ចំការមន នៅ ខាងត្បូង រង្វង់ មូល ផ្សារ ដើម ថ្កូវ ១គីឡូម៉ែត្រ ៕
អភិបាល ខេត្ត ព្រះវិហារ ប្រគល់ ផ្ទះ ជា អំណោយ បក្ស ប្រជាជន ដល់ គ្រួសារ ក្រីក្រ នៅ ស្រុក ត្បែងមានជ័យ
( ព្រះវិហារ ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត នៅ ព្រឹក ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន ប្រគល់ ផ្ទះ ឈើ ប្រក ស័ង្កសី មួយ ខ្នង និង សម្ភារ ប្រើប្រាស់ ជាច្រើន ទៀត ជូន គ្រួសារ ក្រីក្រ មួយ គ្រួសារ ដែល មាន ជីវភាព ខ្វះខាត មាន កូន តូច ៗ ចំនួន ៦នាក់ ក្នុង បន្ទុក រស់ នៅ ភូមិ បុស្ស ធំ ឃុំ ប្រមេរ ស្រុក ត្បែងមានជ័យ ។
លោក អ៊ុន ចាន់ ដា បាន លើកឡើង ថា ក្នុង នាម ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ លោក បាន ប្រកាស ជំហរ ហើយ ថា ទីណា ប្រជាពលរដ្ឋ មាន ការលំបាក ទីនោះ តែងតែ មាន ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា គ្រប់ លំដាប់ថ្នាក់ នៅ រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា បាន ន័យ ថា មិន បណ្តែត បណ្តោយ ឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ រស់ នៅ លំបាក វេទនា ឬ រស់ នៅ ឯកោ ឡើយ ។
លោក ថា ក្រោម គោល នយោបាយ និង មាគ៌ា ដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន ធ្វើអោយ ប្រទេសជាតិ ទទួលបាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ ក្នុង ទិសដៅ គិតគូរ ពី ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ គ្រប់ ៗ រូប ហើយ គណបក្ស ប្រជាជន កម្ពុជា ក៏ មិន ដែល សន្យា បោកប្រាស់ ដូច គណបក្ស នយោបាយ ខ្លះ នោះ ទេ ។
ជាក់ស្តែង ទង្វើ របស់ គណបក្ស ប្រជាជន កម្ពុជា មិន មែន ធ្វើ តែ ក្នុង ពេលនេះ ឫ ក៏ ពេល ឃោសនា បោះឆ្នោត នោះ ទេ គឺ យើង បាន ធ្វើជា យូរ ឆ្នាំ មកហើយ ជាប្រចាំ ។ ហើយ កន្លងមក គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ ក៏ បាន ប្រគល់ ផ្ទះ ទេវតា ជាច្រើន ខ្នង នៅ តាម បណ្តា ក្រុង ស្រុក ទូទាំង ខេត្ត ជូន ប្រជាពលរដ្ឋ ដែល ខ្វះខាត ផងដែរ ។
លោក ក៏ បាន ផ្តាំផ្ញើ ដល់ ក្រុមគ្រួសារ ដែល ទទួលបាន ផ្ទះ ពី គណបក្ស ប្រជាជន កម្ពុជា នៅ ពេល នេះ ត្រូវ ខិតខំ បង្កបង្កើន ផល បន្ថែម ដើម្បី បង្កើន ជីវភាព គ្រួសារ អោយ រឹតតែ ប្រសើរ ហើយ ត្រូវ មាន ការជឿជាក់ លើ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ក៏ ដូចជា អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ ដោយ មិន ត្រូវ ជឿ តាម ការញុះញង់ ផ្សេង ៗ ពី ក្រុម ជន អគតិ ណាមួយ នោះ ទេ ៕
អតីត យុទ្ធជន ៤គ្រួសារ នៅ ព្រៃវែង ទទួលបាន ផ្ទះ ពី សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត
( ព្រៃវែង ) ៖ ផ្ទះសម្បែង ជា ជម្រក ដ៏ ចាំបាច់ សម្រាប់ មនុស្ស គ្រប់ រូប នៅលើ លោកា យើង នេះ ។ ដោយសារតែ ជីវភាព ខ្វះខាត អតីត យុទ្ធជន ៤គ្រួសារ នៅក្នុង ស្រុក ពាម ជរ ខេត្ត ព្រៃវែង បាន ខ្វះ ផ្ទះសម្បែង ធ្វើជា ទ្រនំ សម្រាប់ ការរស់ នៅ ។ ឥលូវ ភាព លំបាក ការខ្វះ ផ្ទះសម្បែង របស់ ពួកគេ ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដោះស្រាយ ជូន ហើយ ដោយ បាន ប្រគល់ ផ្ទះ ចំនួន ៤ខ្នង ជូន ពួកគេ សម្រាប់ រស់ នៅ ជួប គ្រួសារ ដោយ ភាពកក់ក្តៅ ។
ផ្ទះ ជា អំណោយ ប្រកបដោយ ទឹកចិត្ត សម្បុរស ធម៌ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវបាន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ចុះ ទៅ ប្រគល់ជូន ដោយ ផ្ទាល់ នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ នេះ ។ ការចុះ ប្រគល់ ផ្ទះ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ សមាគម អតីត យុទ្ធជន ខេត្ត ព្រៃវែង ។
នាយ ឧត្តមសេនីយ៍ គន់ គីម បាន លេីក ឡេីង ពី ការយកចិត្តទុកដាក់ របស់ សម្តេច ទាំង ទ្វេ លេី សុខ ទុក្ខ និង ជីវភាព ប្រចាំ ថ្ងៃ របស់ សមាជិក អតីត យុទ្ធជន កម្ពុជា ។
លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន ជំរុញ ក្រុមគ្រួសារ ដែល ទទួលបាន ផ្ទះ ពី សម្តេច ត្រូវ ចេះ ថែទាំ និង ត្រូវ ខិតខំ ប្រកបរបរ ចិញ្ចឹម ជីវិត លេីក ស្ទួយ ជីវភាព រស់ នៅ ឱ្យ កាន់តែ ប្រសើរ ។
ក្នុង ឱកាស នោះ ដែរ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ក៏ បាន រំលឹក ដល់ ថ្នាក់ដឹកនាំ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត ព្រៃវែង ត្រូវ គ្រប់គ្រង សមាជិក ស. អ. ក ដែល រស់ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ។ ពេល ពួកគាត់ មាន បញ្ហា អ្វី មួយ ត្រូវ ជួយ ដោះស្រាយ ឱ្យ ទាន់ ពេលវេលា និង បាន ជំរុញ ឱ្យ បេីក ប្រាក់ បេឡាម រណៈ សង្គ្រោះ ឱ្យ បាន ទាន ពេលវេលា និង បន្ត ធ្វេី ផ្ទះ អំណោយ របស់ សម្តេច ឱ្យ រួច តាម ផែនការ៣៧ ខ្នង ដេីម្បី ប្រគល់ ជូន សមាជិក អតីត យុទ្ធជន ដែល ខ្វះខាត ឱ្យ បាន ទាន់ ពេល វេលា ។
លោក សាត ពុធ ជា ជនពិការ រស់ នៅ ភូមិ កោះ ចេក ឃុំ កោះ ចេក ស្រុក ពាម ជរ តំណាង ឱ្យ បងប្អូន ទាំង ៤គ្រួសារ បាន គោរព ថ្លែងអំណរគុណ សម្តេច ទាំង ពីរ ដែល ផ្ដល់ ផ្ទះ ជូន ពួកគាត់ ធ្វេី ឱ្យ ជីវភាព រស់ នៅ របស់ ពួកគាត់ មាន លំនឹង និង បាន គោរព ជូនពរ ឱ្យ សម្តេច ទាំង ពីរ និង ក្រុមគ្រួសារ មាន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង ពលំ ខ្លាំងក្លា ដឹកនាំ នាវា កម្ពុជា កាន់តែ រីកចម្រើន ៕ វត្តមាន ម្ហូប ដ៏ ល្អ ឯក របស់ កូរ៉េ នឹង បង្ហាញ ខ្លួន ក្នុង ពិព័រណ៍ អាហារ ស្លាបព្រា ដ៏ ធំ បំផុត ប្រចាំ ឆ្នាំ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ទទួលបាន ការគាំទ្រ និង ជោគជ័យ ២ ឆ្នាំ ជាប់ ៗ គ្នា នៃ ព្រឹត្តិការណ៍ ពិព័រណ៍ អាហារ ក្នុង ប្រទេស កម្ពុជា រួច មក ស្លាបព្រា បាន រៀបចំ ពិព័រណ៍ អាហា ដ៏ ធំ ម្តង ទៀត សម្រាប់ ឆ្នាំ ២០១៩ ។
ព្រឹត្តិការណ៍ ដ៏ អស្ចារ្យ និង គួរឱ្យ ចាប់អារម្មណ៍ នេះ បាន ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី ៣០ - ៣១មីនា ឆ្នាំ ២០១៩ នេះ នៅ ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក ដែល មាន ការចូលរួម ពី អាជីវករ និង ក្រុមហ៊ុន ផ្នែក ចំណីអាហារ ប្រមាណ ជាង ២០០ ក្រុមហ៊ុន និង មាន អ្នកចូលរួម ប្រមាណ ជាង ៣០០.០០ នាក់ ដោយ ស្លាបព្រា បាន ធ្វើ ការផ្តល់ ជូន ជម្រើស កាន់តែ ច្រើន នៃ មុខ ម្ហូប បែប ខ្មែរ និង អន្តរជាតិ ជាច្រើន មុខ ដែល មាន រសជាតិ ឈ្ងុយ ឆ្ងាញ់ បំផុត ។
អ្នកស្រី ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ ស្លាបព្រា ដែល បាន ផ្តល់ ឱកាស ក៏ដូចជា ទីតាំង ដ៏ ល្អ ក្នុង ការបង្ហាញ និង លើកកម្ពស់ ម្ហូប អាហារ ដ៏ ល្អ បំផុត របស់ ប្រទេស កូរ៉េ ជូន ដល់ ប្រទេស កម្ពុជា ។ អ្នកស្រី បាន បញ្ជាក់ ទៀត ថា “ ប្រទេស កូរ៉េ គឺ ត្រូវបាន ពិភពលោក ស្គាល់ និង ទទួលបាន ភាពល្បីល្បាញ តាមរយៈ ឧស្សាហ៍កម្មតន្រី្ត ប៉ុន្តែ ប្រទេស កូរ៉េ ក៏ មាន ម្ហូប ដែល ល្អ បំផុត ចំពោះ សុខភាព ដែល ប្រទេស ទូទាំង ពិភពលោក គ្រប់ ជាតិ សាសន៍ អាច រីករាយ និង ទទួលយក បាន ផងដែរ ” ។
សូម រំឭក ផងដែរ ថា ក្រៅពី ការភ្លក់ និង ញុំា អាហារ ដ៏ ឈ្ងុយ ឆ្ងាញ់ សម្រាប់ សុខភាព និង សម្រស់ ដោយ ឥត គិត ថ្លៃ ក្រុមហ៊ុន aT ក៏ បាន ផ្តល់ ឱកាស ដល់ អ្នកចូលរួម ក្នុង ស្តង់ របស់ ខ្លួន ទាំងអស់ ថត រូប អនុស្សាវរីយ៍ និង ធ្វើ ការផ្តល់ ជូន បទពិសោធន៍ ដ៏ អស្ចារ្យ ដំបូង គេ ជាមួយនឹង ការពាក់ សម្លៀកបំពាក់ បែប ប្រពៃណី កូរ៉េ “hanbok” ដ៏ ល្បីល្បាញ ទូទាំង ពិភពលោក ដែល យើង តែងតែ ឃើញ ក្នុង ខ្សែភាពយន្ត តែ ប៉ុន ណោះ ។
ជា ចុងក្រោយ ក្រុមហ៊ុន aT បាន សន្យា ថា ខ្លួន នឹង បន្ត ចូលរួម គ្រប់ កម្មវិធី អាហារ ជាច្រើន ទៀត ដើម្បី ធ្វើ ការបង្ហាញ នូវ រសជាតិ អាហារ ថ្មី ៗ ដ៏ មាន ឱជារស ជូន ដល់ ប្រទេស កម្ពុជា ក៏ ដូចជា ធ្វើ ការស្វែងយល់ និង ផ្លាស់ប្តូរ វប្បធម៌ រវាង ប្រទេស កូរ៉េ និង ព្រះរាជាណាចក្រ កម្ពុជា ផងដែរ ៕
ទៅ លេង ស្រុក កំណើត ខ្ចី កាំភ្លើង មិត្តភក្តិ បាញ់ លេង ត្រូវ សមត្ថកិច្ច ឃាត់ខ្លួន
( ត្បូងឃ្មុំ ) ៖ យុវជន ជាជាង ផ្សារ ដែក ម្នាក់ បាន ខ្ចី កាំភ្លើង ខ្លី របស់ មិត្តភក្តិ ទុក ជាប់ នឹង ខ្លួន ទៅ លេង ស្រុក កំណើត ហើយ បាន បាញ់ ១គ្រាប់ លេង បង្កឱ្យ មាន ការភ្ញាក់ផ្អើល ហើយ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ។ ហេតុការណ៍ នេះ កើតឡើង កាលពី វេលា ម៉ោង ៨ យប់ ថ្ងៃទី ២៧ ខែមីនា ឆ្នាំ ២០១៩ នៅក្នុង ភូមិ ស្លាប ក្តោង ឃុំ ជប់ ស្រុក ត្បូងឃ្មុំ ។
ជនសង្ស័យ ដែល ត្រូវ សមត្ថកិច្ច ចាប់ ឃាត់ខ្លួន មាន ឈ្មោះ ហេង សុភា ហៅ អ៊ួក អាយុ ២៤ ឆ្នាំ មុខរបរ ជាង ផ្សារ ដែក នៅ ផ្សារ ចម្ការ ដូង សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ និង មាន លំនៅក្នុង ភូមិ ស្លាប ក្តោង ឃុំ ជប់ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ។
តាម ប្រភព ពី កន្លែង កើត ហេតុ បាន ឱ្យដឹង ថា នៅ មុនពេល កើត ហេតុ មិន ដឹង ជា មាន បញ្ហា អ្វី ក៏ ស្រាប់តែ ជនសង្ស័យ ឈ្មោះ ហេង សុភា ហៅ អ៊ួក ដែល ជា ជាង ផ្សារ ដែក សោះ មិន ដឹង ជា បាន កាំភ្លើង ខ្លី មកពី ណា ក៏ ស្រាប់តែ ដក បាញ់ ១គ្រាប់ បង្កឱ្យ មាន ការភ្ញាក់ផ្អើល ឡើង ទាំង យប់ ។
ប្រភព បន្ត ថា លុះ នៅ ថ្ងៃ បន្ទាប់ នៅ វេលា ម៉ោង ៥និង ៣០ នាទី ល្ងាច ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០១៩ កម្លាំង ជំនាញ នៃ អធិការដ្ឋាន នគរបាល ស្រុក ត្បូងឃ្មុំ សហការ ជាមួយ កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ជប់ស្រាវជ្រាវ ឃាត់ខ្លួន ជនសង្ស័យ នាំយក មក សាកសួរ ដោយ ដកហូត វត្ថុតាង អាវុធ ខ្លី១ ដើម ម៉ាក ឡុក លេខ S2022 ផលិត នៅ ប្រទេស ទួរ គី បង់១ គ្រាប់ ចំនួន ៣គ្រាប់ ។
នៅ ចំពោះមុខ សមត្ថកិច្ច ជនសង្ស័យ បាន ឆ្លើយ សារភាព ថា អាវុធ នេះ ខ្លួន បាន ខ្ចី ពី មិត្តភក្តិ ដែល ជា ជាង ដែក ដូចគ្នា និង ទើប ស្គាល់ គ្នា បាន ៤ខែ យកមក លេង ស្រុក ។ លុះ មកដល់ វេលា ម៉ោង ៨យប់ ថ្ងៃទី ២៧ ខែមីនា ឆ្នាំ ២០១៩ ខ្លួន ក៏ បាន បាញ់ បោះ ចំនួន ១គ្រាប់ នៅ ចំណុច ផ្ទះ ឪពុក ខ្លួន បន្ទាប់មក ក៏ ត្រូវ សមត្ថកិច្ច ចុះ មក ចាប់ខ្លួន តែម្តង ។
បច្ចុប្បន្ន ជនសង្ស័យ ខាងលើ ត្រូវបាន សមត្ថកិច្ច កសាង សំណុំរឿង បញ្ជូន ខ្លួន ទៅកាន់ សាលាដំបូង ខេត្ត ដើម្បី ចាត់ការ បន្ត តាម នីតិវិធី ៕ យល់ដឹង ផ្នែក ច្បាប់៖ ប្រតិភូ បុគ្គលិក
នៅ គ្រប់ បណ្ដា សហគ្រាស និង គ្រឹះស្ថាន ទាំងអស់ ដែល ស្ថិត នៅក្រោម បទប្បញ្ញត្តិ នៃ ច្បាប់ ស្តីពី ការងារ ហើយ បាន ប្រើប្រាស់ កម្មករ និយោជិត ចាប់ពី ៨ ( ប្រាំបី ) នាក់ ឡើង ទៅ ត្រូវ បង្កើត ឲ្យ មាន ប្រតិភូ បុគ្គលិក ។ ការបង្កើត ប្រតិភូ បុគ្គលិក នៅក្នុង សហគ្រាស គ្រឹះស្ថាន គឺ ដើម្បី ធ្វើជា តំណាង ឲ្យ កម្មករ និយោជិត តែ មួយ គត់ ។
តើ អ្វី ទៅ ដែល ហៅ ថា ប្រតិភូ បុគ្គលិក ? ហើយ ប្រតិបុគ្គលិក មាន តួនាទី អ្វី ខ្លះ នៅក្នុង សហគ្រាស និង គ្រឹះស្ថាន ?
ប្រតិភូ បុគ្គលិក គឺ សំដៅ ដល់ អ្នកតំណាង កម្មករ និយោជិត តាមរយៈ ការបោះឆ្នោត ជ្រើសរើស ចេញ ពី កម្មករ និយោជិត ដោយ ផ្ទាល់ ។ ( មាត្រា៤ នៃ ច្បាប់ ស្តីពី សហជីព )
យោង តាម ប្រការ១ នៃ ប្រកាស របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន កំណត់ អំពី ប្រភេទ សហគ្រាស គ្រឹះស្ថាន ដែល ត្រូវ ឲ្យ មាន ប្រតិភូ បុគ្គលិក រួម មាន៖ គ្រឹះស្ថាន ឧស្សាហកម្ម ពាណិជ្ជកម្ម រ៉ែ សំណង់ សេវា ធនាគារ កសិកម្ម កំពង់ផែ សណ្ឋាគារ ភោជនីយដ្ឋាន សាលា បង្រៀន និង ផលិតកម្ម ផ្សេង ៗ ទៀត ។
ចំនួន ប្រតិភូ បុគ្គលិក ត្រូវ កំណត់ តាម សមាមាត្រ នឹង ចំនួន កម្មករ និយោជិត ក្នុង សហគ្រាស គ្រឹះស្ថាន ដូច ខាងក្រោម៖
ការបោះឆ្នោត ជ្រើសរើស ប្រតិភូ បុគ្គលិក ជា ភារកិច្ច របស់ ម្ចាស់ សហគ្រាស គ្រឹះស្ថាន ដោយ និយោជក ត្រូវ ធ្វើ ការអញ្ជើញ តំណាង កម្មករ និយោជិត ដើម្បី ពិភាក្សា អំពី បែបបទ ចាត់តាំង កាលបរិច្ឆេទ នៃ ការបោះឆ្នោត និង ចំនួន អាសនៈ ដែល ត្រូវ បែងចែក ទៅឲ្យ គណៈ អ្នកបោះឆ្នោត ។ នៅ ពេល ដែល សហគ្រាស គ្រឹះស្ថាន មាន សហជីព មួយ ឬ ច្រើន សហជីព ទាំងនោះ អាច ធ្វើ ការជ្រើសតាំង បេក្ខជន ឈរឈ្មោះ ទៅ តាម ចំនួន អាសនៈ នៃ ប្រតិភូ បុគ្គលិក ពេញ សិទ្ធិ និង ប្រតិភូ បុគ្គលិក ជំនួយ ។
ក្នុង ករណី កម្មករ និយោជិត ដែល មិន មែន ជា សមាជិក សហជីព ក៏ អាច ឈរឈ្មោះ ជា បេក្ខជន ប្រតិភូ បុគ្គលិក ពេញ សិទ្ធិ និង ប្រតិភូ បុគ្គលិក ជំនួយ បាន ដែរ ។ ដោយ និយោជក ត្រូវ ពិភាក្សា ជាមួយ សហជីព ទាំងនោះ និង តំណាង កម្មករ និយោជិត ដើម្បី ធ្វើ ការកំណត់ អំពី បែបបទ កាលបរិច្ឆេទ និង ចំនួន អាសនៈ ដែល ត្រូវ បែងចែក ទៅឲ្យ គណៈ អ្នកបោះឆ្នោត ។
ដោយឡែក ក្នុង ករណី ដែល សហគ្រាស គ្រឹះស្ថាន ដែល ពុំ មាន សហជីព ឬ ពុំ មាន កម្មករ និយោជិត ស្ម័គ្រចិត្ត ឈរឈ្មោះ ឬ មិន អាច បំពេញ លក្ខខណ្ឌ ឈរឈ្មោះ ជា បេក្ខជន ប្រតិភូ បុគ្គលិក ពេញ សិទ្ធិ ឬ ប្រតិភូ បុគ្គលិក ជំនួយ នោះ រដ្ឋមន្រ្តី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ត្រូវ ធ្វើ ការដោះស្រាយ លើ បញ្ហា នេះ ។
អំពី នីតិវិធី នៃ ការបោះឆ្នោត ជ្រើសរើស ប្រតិភូ បុគ្គលិក ដូច ខាងក្រោម៖
ប្រការ២ នៃ ប្រកាស របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ
តួនាទី ភារកិច្ច របស់ ប្រតិភូ បុគ្គលិក មាន បេសកម្ម ជា អាទិ៍៖
ប្រតិភូ បុគ្គលិក ពេញ សិទ្ធិ និង ប្រតិភូ បុគ្គលិក ជំនួយ ត្រូវបាន បោះឆ្នោត ជ្រើសរើស សម្រាប់ អាណត្តិ២ ( ពីរ ) ឆ្នាំ ហើយ អាច ឈរឈ្មោះ បោះឆ្នោត ជាថ្មី ឡើងវិញ បាន ។ មុខងារ របស់ ប្រតិភូ បុគ្គលិក ត្រូវបាន បញ្ចប់ នៅពេល ទទួលមរណៈភាព លា លែង ចេញ ពី តំណែង និង បញ្ចប់ កិច្ចសន្យា ការងារ ។ ( មាត្រា ៤១ នៃ ច្បាប ស្ដីពី សហជីព )
ការបញ្ឈប់ ប្រតិភូ បុគ្គលិក ឬ បេក្ខជន ឈរឈ្មោះ ជា ប្រតិភូ បុគ្គលិក ត្រូវតែ មាន ការយល់ព្រម ពី អធិការ ការងារ ។ ហើយ ការបញ្ឈប់ ប្រតិភូ បុគ្គលិក អាច ត្រូវបាន ធ្វើឡើង តាម រយៈ៖
១. ការបញ្ឈប់ ប្រតិភូ បុគ្គលិក ដោយ និយោជក៖
ការបញ្ឈប់ ប្រតិភូ បុគ្គលិក ឬ បេក្ខជន ដែល បាន ឈរឈ្មោះ ជ្រើសរើស ប្រតិភូ បុគ្គលិក ពី ការងារ ត្រូវតែ មាន ការយល់ព្រម ពី ផ្នែក អធិការ ការងារ ។ វិធាន នេះ ត្រូវ អនុវត្ត ចំពោះ អតីត ប្រតិភូ បុគ្គលិក ក្រោយពេល បញ្ចប់ អាណត្តិ របស់ ខ្លួន រយៈពេល ៣ ខែ និង ក្នុង រយៈពេល ៣ ខែ ចំពោះ អតីត បេក្ខជន ដែល មិន ជាប់ ឆ្នោត ក្រោយ ការប្រកាស លទ្ធផល នៃ ការបោះឆ្នោត ។
ក្នុង ករណី មាន កំហុស ធ្ងន់ នាយក សហគ្រាស អាច ចេញ សេចក្តីសម្រេច មួយ បញ្ឈរ ជើង សាម៉ីខ្លួន ភ្លាម ៗ បាន ប៉ុន្តែ វា គ្រាន់តែ ជា វិធាន បណ្ដោះអាសន្ន ក្នុង ការរងចាំ សេចក្តីសម្រេច របស់ អធិការ ការងារ ។ ប្រសិនបើ សេចក្តីសម្រេច របស់ អធិការ ការងារ សម្រេច ថា មិន យល់ព្រម ឲ្យ បញ្ឈប់ ការងារ របស់ សាម៉ីខ្លួន នោះ ទេ នោះ ការបញ្ឈរ ជើង នេះ ត្រូវបាន ទុក ជា មោឃៈ ហើយ ការសម្រេច បញ្ឈរ ជើង របស់ ម្ចាស់ សហគ្រាស ត្រូវបាន លុបចោល ដោយ ពេញ ច្បាប់ ។
២. ការបញ្ឈប់ ប្រតិភូ បុគ្គលិក ដោយ កម្មករ និយោជិត៖
កម្មករ និយោជិត អាច បណ្តេញ ប្រតិភូ បុគ្គលិក ចេញ ពី តំណែង មុនពេល ចប់ អាណត្តិ បាន ក្នុង ករណី ដែល ប្រតិភូ បុគ្គលិក ដែល ជា តំណាង កម្មករ និយោជិត មិន បាន បំពេញ ភារកិច្ច របស់ ខ្លួន ។ ការសម្រេច សេចក្តីពី ការបណ្តេញ នេះ ត្រូវ ធ្វើ តាម របៀប និង បែបបទ បោះឆ្នោត ដូចគ្នា នឹង នីតិវិធី នៃ ការបោះឆ្នោត ជ្រើស ផងដែរ ។
ដោយ កម្មករ និយោជិត ត្រូវ ធ្វើ ការ ជូនដំណឹង ជា ផ្លូវការ ទៅ អធិការ ការងារ ក្នុង រយៈពេល ៣ ថ្ងៃ យ៉ាង យូរ បន្ទាប់ពី សម្រេច បណ្តេញ ប្រតិភូ បុគ្គលិក ចេញ ពី តំណែង ។ នៅ ពេល ដែល ប្រតិភូ បុគ្គលិក ពេញ សិទ្ធិ ត្រូវបាន បោះឆ្នោត បណ្តេញ ចេញ ពី តំណែង នោះ រាល់ ការងារ របស់ ប្រតិភូ បុគ្គលិក ពេញ សិទ្ធិ ត្រូវបាន ជំនួស ដោយ ប្រតិភូ បុគ្គលិក ជំនួយ រហូតដល់ មាន ការបោះឆ្នោត ជ្រើសរើស ប្រតិភូ បុគ្គលិក ពេញ សិទ្ធិ សម្រាប់ អាណត្តិ ថ្មី ។
សូម បញ្ជាក់ ផងដែរ ថា ប្រតិភូ បុគ្គលិក ដែល ត្រូវបាន កម្មករ និយោជិត បោះឆ្នោត បណ្តេញ ចេញ ពី តំណែង នៅតែ ជា កម្មករ និយោជិត នៅក្នុង សហគ្រាស ដដែល ។
សរុប សេចក្តី មក ប្រតិភូ បុគ្គលិក គឺជា អ្នកតំណាង កម្មករ និយោជិត តាមរយៈ ការបោះឆ្នោត ជ្រើសរើស ចេញ ពី កម្មករ និយោជិត ដោយ ផ្ទាល់ និង ត្រូវបាន បង្កើត តាមរយៈ ការបោះឆ្នោត ។ អ្នក ដែល មាន សិទ្ធិ ឈរឈ្មោះ ជា ប្រតិភូ បុគ្គលិក បាន គឺ ត្រូវ មាន អាយុ ចាប់ពី ២៥ ឆ្នាំ ហើយ បាន បំពេញ ការងារ យ៉ាងតិច៦ ( ប្រាំមួយ ) ខែ នៅក្នុង សហគ្រាស គ្រឹះស្ថាន ដែល ពួកគេ បំពេញ ការងារ ។
ប្រតិភូ បុគ្គលិក ដែល ត្រូវបាន ជាប់ ឆ្នោត គឺ មាន អាណត្តិ២ ឆ្នាំ ហើយ អាច បន្ត ឈរឈ្មោះ ជាថ្មី ឡើងវិញ បាន ។ មុខងារ របស់ ប្រតិភូ បុគ្គលិក ត្រួវ បាន បញ្ចប់ ដោយ ហេតុ នៃ មរណភាព ពេល លា លែង ចេញ ពី តំណែង និង ពេល បញ្ចប់ កិច្ចសន្យា ។
លោក រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី បន្ត ថា ការដំឡើង ប្រព័ន្ធ សូឡា បំពាក់ នៅ លំនៅដ្ឋាន របស់ ប្រជាពលរដ្ឋ ជាង ១០ម៉ឺន ប្រព័ន្ធ រួចហើយ តម្លៃ រហូតដល់ ជាង ២៧លាន ដុល្លារ អាមេរិក ដែល ជា មូលនិធិ អគ្គិសនី ជនបទ នៃ អគ្គិសនី កម្ពុជា សំដៅ ជួយ សម្រួល ដល់ ការរស់នៅ និង ជីវភាព របស់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ លើ ផ្ទៃ ទឹក ។
លោក កែវ រតនៈ បន្ថែម ទៀត ថា សម្រាប់ ផែនការ ឆ្នាំ ថ្មី នេះ អគ្គិសនី កម្ពុជា នឹង បន្ថែម អនុភាព យ៉ាងតិច ៣២៥វ៉ាត់ សម្រាប់ ប្រព័ន្ធ ថាមពល អគ្គិសនី ដើរ ដោយ ពន្លឺ ព្រះអាទិត្យ ដើម្បី ប្រជាពលរដ្ឋ អាច ប្រើប្រាស់ សម្រាប់ ដាំ បាយ បាន និង ពង្រីក ការដាក់ពង្រាយ ជូន ពលរដ្ឋ បន្ថែម ដើម្បី សម្រួល ជីវភាព ដល់ បងប្អូន ប្រជ ពលរដ្ឋ ពិសេស បងប្អូន រស់ នៅ លើ ទឹក និង ជួយ កាត់បន្ថយ ការកាប់ ព្រៃ លិច ទឹក យកមក ចម្អិន អាហារ ។
លោក បញ្ជាក់ ទៀត ថា ដើម្បី ជំរុញ ការអភិវឌ្ឍន៍ ថាមពល ស្អាត ឬ ថាមពល អគ្គិសនី ដែល កកើត ឡើងវិញ ដើរ ដោយ ពន្លឺ ព្រះអាទិត្យ សម្រាប់ ការនាំចូល សម្ភារ ឧបករណ៍ បម្រើ ដល់ ស្ថានីយ៍ ផលិត ថាមពល គឺ រាជ រដ្ឋាភិបាល កម្ពុជា មិន បាន គិត ពន្ធ អ្វី ទាំងអស់ ដែល នេះ ជា ការលើកទឹកចិត្ត ដល់ ការរីកចម្រើន របស់ វិស័យ នេះ ៕ ព័ត៌មាន សំខាន់ ៗ ចំនួន ១០ប្រចាំ សប្តាហ៍ សម្រាប់ ថ្ងៃអាទិត្យ ទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ នេះ
៧៖ នាយក រដ្ឋមន្ត្រី ប្រាប់ ទណ្ឌិត សម រង្ស៉ី កុំ ឲ្យ ចូលមក កម្ពុជា តាម ព្រំដែន ក្រែង មាន គ្រោះថ្នាក់ ដល់ ជីវិត ( ចុច អាន )
៨៖ ព័ត៌មាន ក្លែងក្លាយ មិន ត្រឹមតែ ពាក់ព័ន្ធ នឹង សន្តិសុខ នយោបាយ ប៉ុណ្ណោះ ទេ វា ក៏ ជា សង្គ្រាម ចិត្តសាស្ត្រ ដ៏ គ្រោះថ្នាក់ ( ចុច អាន )
១០៖ កម្ពុជា និង បណ្ដា ប្រទេស ដែល បរិច្ចាគ កម្លាំង មួក ខៀវ បាន ប្តេជ្ញាចិត្ត បន្ត ចូលរួម រក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ ( ចុច អាន )
លោក នេត្រ ភក្រ្តា៖ ពលរដ្ឋ ម្នាក់ ៗ អាច ចូលរួម ការពារ ផែនដី បាន ដោយ គ្រាន់តែ សន្សំ សំចៃ ការប្រើប្រាស់ ទឹក អគ្គិសនី ចូលរួម ដាំ ដើមឈើ និង កាត់បន្ថយ សំណល់
នេះ គឺជា ការអំពាវនាវ របស់ រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន លោក នេត្រ ភក្ត្រា នៅ រាត្រី ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ នៅក្នុង ឱកាស នៃ ការប្រារព្ធ ពិធី ទិវា “ មួយ ម៉ោង សម្រាប់ ភព ផែនដី ” ឆ្នាំ ២០១៩ ក្រោម ប្រធានបទ “ ភ្ជាប់ ទំនាក់ទំនង ជាមួយនឹង ផែនដី ” នៅក្នុង បរិវេណ ផ្សារ ទំនើប អ៊ីអន ២ សែន សុខ ដោយ មាន ការចូលរួម ជាច្រើន រយ នាក់ ។
ដើម្បី បង្ការ និង ទប់ស្កាត់ ភ្លើង ឆេះ ព្រៃ លោក រដ្ឋលេខាធិការ នេត្រ ភក្ត្រា បាន លើកឡើង ថា ក្រសួង បរិស្ថាន សូម ធ្វើ ការអំពាវនាវ ដល់ អង្គភាព ជំនាញ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ មន្ទីរ បរិស្ថាន អាជ្ញាធរ មាន សមត្ថកិច្ច រួមទាំង សហគមន៍ មូលដ្ឋាន និង អ្នក ពាក់ព័ន្ធ ទាំងអស់ ឱ្យ អនុវត្ត វិធានការ ដូច ខាងក្រោម៖
១៖ ទប់ស្កាត់ និង ណែនាំ ឱ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ពី ការប្រើប្រាស់ ភ្លើង ជា មធ្យោបាយ ដើម្បី ប្រមូល ផល អនុផល ព្រៃឈើ ការដុត ព្រៃ ស្ទាក់ ចាប់ សត្វ និង ការដុត វាល ស្មៅ ។ល ។
២៖ ទប់ស្កាត់ ការកាប់ឆ្ការ ទន្រ្ទាន ឈូសឆាយ ដុត ព្រៃឈើ និង ព្រៃ លិច ទឹក ក្នុង គោលបំណង ផ្សេង ទៀត ដែល ជា សកម្មភាព ល្មើស ច្បាប់ និង បង្កឱ្យ មាន ភ្លើង ឆេះ ព្រៃឈើ ព្រៃ លិច ទឹក និង រាលដាល ដល់ ផ្ទះសម្បែង របស់ ប្រជាពលរដ្ឋ ស្នាក់ការ ស្នាក់ការ រង និង ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត នានា នៅក្នុង និង ជុំវិញ តំបន់ ការពារ ធម្មជាតិ ។
៣៖ ត្រូវ ប្រុងប្រយ័ត្ន ខ្ពស់ ក្នុង ការប្រើ ភ្លើង ជា មធ្យោបាយ ក្នុង ការដុត កាកសំណល់ ផ្សេង ៗ នៅក្នុង តំបន់ ការពារ ធម្មជាតិ និង របៀង អភិរក្ស ជីវៈ ចម្រុះ ។
៤៖ អាជ្ញាធរ ពាក់ព័ន្ធ ត្រូវ ណែនាំ អ្នក ពាក់ព័ន្ធ អនុវត្ត វិធានការបច្ចេកទេស សមស្រប ដែល អាច ធានា សុវត្ថិភាព ចំពោះ ភ្លើង ព្រៃ ដោយ ត្រូវ ពន្លត់ ភ្លើង ឱ្យ អស់ ជា ចាំបាច់ មុនពេល ចាកចេញ ពី ទីតាំង ប្រើប្រាស់ ភ្លើង ។
៥៖ ក្នុង ករណី កើតមាន ភ្លើង ឆេះ ព្រៃ ធ្ងន់ធ្ងរ សូម សមត្ថកិច្ច ពាក់ព័ន្ធ ប្រញាប់ ចាត់ វិធានការ ទប់ស្កាត់ ជាបន្ទាន់ តាមរយៈ ការប្រកាស អាសន្ន ហើយ គណៈ បញ្ជាការ ឯកភាព រាជធានី - ខេត្ត ត្រូវ ដឹកនាំ បញ្ជា ផ្ទាល់ ក្នុង ការប្រើ កម្លាំង ចម្រុះ រួម មាន ប្រជាពលរដ្ឋ សហគមន៍ ព្រះសង្ឃ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង អ្នក ពាក់ព័ន្ធ ទាំងអស់ ដែល ឈរជើង នៅក្នុង មូលដ្ឋាន នោះ រួមគ្នា ទប់ស្កាត់ និង ពន្លត់ ភ្លើង ព្រៃ ឱ្យ មាន ប្រសិទ្ធភាព ។
លោក រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន នេត្រ ភក្ត្រា បាន បង្ហាញ សុទិដ្ឋិនិយម យ៉ាង មុតមាំ ថា ស្មារតី នៃ ការប្រារព្ធ « ទិវា មួយ ម៉ោង សម្រាប់ ភព ផែនដី » នា ពេលនេះ នឹង ធ្វើឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ កាន់តែ មាន ការយល់ដឹង និង ចូលរួម យ៉ាង សកម្ម ថែម ទៀត ក្នុង កិច្ច គាំពារ បរិស្ថាន និង ភព ផែនដី យើង ប្រកបដោយ និរន្តភាព និង ស្រស់បំព្រង ៕ លោក ជា សុផារ៉ា កោតសរសើរ ចំពោះ សកម្មភាព របស់ លោក ឧកញ៉ា ទៀ វិចិត្រ និង បំផុស ឲ្យ យុវជន ចូលរួម ដាំ កូន ឈើ និង អភិរក្ស សត្វ កម្រ
( ព្រះសីហនុ) ៖ លោក ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ នា ឱកាស ដឹកនាំ មន្ត្រី ក្រោម ឱវាទ ជាង ៣ពាន់ នាក់ មក ធ្វើ ទស្សនកិច្ច សិក្សា នា ខេត្ត ព្រះសីហនុ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៩ ដល់ ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ ។
ជាង នេះ ទៀត លោក ជា សុផារ៉ា ក៏ បាន គាំទ្រ ចំពោះ សកម្មភាព របស់ លោក ឧកញ៉ា ទៀ វិចិត្រ ក្នុង នាម វិស័យ ឯកជន នា ខេត្ត ព្រះសីហនុ ដែល បាន ចូលរួម ធ្វើ ការងារ មនុស្ស ធ៌ម ជួយ ដល់ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក អ្នក ជម្ងឺ ខ្វះ លទ្ធភាព ព្យាបាល ជន ចាស់ជរា ខ្វះ ទីពឹង ជន ពិការ និង កុមារ កំព្រា ជាដើម ដែល ជា ផ្នែក មួយ របស់ វិស យ័ឯកជន ក្នុង ចលនា រួមចំណែក ជួយ ដល់ សង្គមជាតិ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ត្រង់ ចំណុច នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា ក៏ បាន លើកទឹកចិត្ត ដល់ លោក ឧកញ៉ា ទៀ វិចិត្រ ក៏ ដូចជា វិស័យ ឯកជន ដទៃ ទៀត ឲ្យ ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល លើ ការងារ អភិរក្ស សត្វ ព្រៃ និង សត្វ កម្រ គ្រប់ ប្រភេទ ឲ្យបាន គង់វង្ស និង សម្បូរបែប ឡើងវិញ ។
ជាង នេះ ទៀត លោក ជា សុផារ៉ា ក៏ បាន ស្នើ ដល់ យុវជន មន្ត្រីរាជការ ប្រជាពលរដ្ឋ ក៏ ដូចជា វិស័យ ឯកជន ផ្សេង ៗ ត្រូវ រួមគ្នា ធ្វើ ការងារ មនុស្ស ធ៌ម ឲ្យបាន ច្រើន ទៅ តាម លទ្ធភាព ជាក់ស្តែង រៀង ៗ ខ្លួន ដើម្បី ចូលរួម ចែករំលែក ទុក្ខលំបាក ដល់ អ្នក ជួប បញ្ហា ខ្វះខាត ទាំងនោះ ផង និង ដើម្បី ធ្វើ កុសល្យ ផល បុណ្យ ផង ។
បន្ថែម លើ នេះ លោក ជា សុផារ៉ា ដែល ជា ប្រធាន គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង និង អភិវឌ្ឍ តំបន់ ឆ្នេរសមុទ្រ កម្ពុជា ផង នោះ ក៏ បាន បំផុស ដល់ មហាជន ទូទៅ ឲ្យ ចេះ ស្រលាញ់ និង ការពារ បរិស្ថាន ដោយ ត្រូវ រួម សហការ គ្នា ដាំ កូន ឈើ នៅ តាម ទីតាំង រៀង ៗ ខ្លួន ឲ្យបាន ច្រើន និង ត្រូវ ថែរក្សា ឲ្យបាន គង់វង្ស ។
នា ឱកាស ដឹកនាំ មន្ត្រីរាជការ ក្រោម ឱវាទ ក្រសួង រៀបចំ ដែនដី មក ទស្សនា តាម ឆ្នេរ អូរ ត្រេះ នៅ ល្ងាច ថ្ងៃសៅរ៍ ទី៣០ ខែមីនា ឆ្នាំ ២០១៩ លោក ជា សុផារ៉ា ក៏ បាន បំផុស ឲ្យ មន្ត្រីរាជការ ទាំងនោះ ចូលរួម ដាំ កូន ឈើ ប្រណិត ៗ ជាច្រើន ដើម នៅ តាម ឆ្នេរ អូរ ត្រេះ ក្រុង ព្រះសីហនុ ថែម ទៀត ផង ។
ទន្ទឹម គ្នា នេះ លោក ឧកញ៉ា ទៀ វិចិត្រ ដែល ជា ប្រធាន សមាគម ទូក ដឹក ភ្ញៀវ ទេសចរណ៍ ប្រចាំ ខេត្ត ព្រះសីហនុ និង ជា ម្ចាស់ ទីតាំង សម្រាក លម្ហែ មាន ឈ្មោះ ថា « ម៉ាហ្វីយ៉ា រី ស៊្សត » មាន ទីតាំង នៅ ឆ្នេរ ភ្លោះ កោះ ឋានសួគ៌ នៃ សង្កាត់ កោះ រ៉ុង ផង នោះ ។
លោក ឧកញ៉ា ក៏ បាន នាំយក សត្វ ល្មិច ឬ អណ្តើក សមុទ្រ ធំ ៗ ចំនួន ២ក្បាល បន្ថែម ទៀត យក ទៅ លែង ឲ្យ រស់ នៅក្នុង សមុទ្រ នា ឆ្នេរ អូរ ត្រេះ ដោយ មាន ការចូលរួម ពី លោក ឧប នាយក ជា សុផារ៉ា លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ លោក ឧកញ៉ា ម៉ុង ឫទ្ធី សមាជិក ព្រឹទ្ធសភា និង លោក ឈិន សេង ងួន អភិបាល ស្តីទី ខេត្ត ព្រះសីហនុ ព្រមទាំង ថ្នាក់ដឹកនាំ ក្រសួង មន្ទីរ ពាក់ព័ន្ធ ជាច្រើន ទៀត ក៏ បាន អញ្ជើញ ចូលរួម ផងដែរ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ឧកញ៉ា ទៀ វិចិត្រ ដែល ជា ប្រធាន ក្រុម មនុស្ស ធ៌ម អូរ បី (O3) ផងដែរ នោះ ក៏ បាន ថ្លែង សារ អំពាវនាវ ក្នុង នាម វិស យ័ឯកជន ដល់ ក្រុម យុវជន ក៏ ដូចជា ប្រជាពលរដ្ឋ ជាពិសេស ប្រជា នេសាទ ឲ្យ ចូលរួម សហការ លើ ការងារ អភិរក្ស សត្វ ព្រៃ និង សត្វ សមុទ្រ កម្រ គ្រប់ ប្រភេទ រួម មាន៖ សត្វ ល្មិច ឬ អណ្តើក សមុទ្រ ជាដើម កុំ ឲ្យ បាត់បង់ ។
ជាពិសេស មិន ត្រូវ ធ្វើ នេសាទ ឬ ចាប់ សត្វ ល្មិច យកមក ចំអិន ធ្វើ ម្ហូប អាហារ ទទួលទាន ទៀត ទេ ព្រោះ វា ជា ប្រភេទ សត្វ សមុទ្រ កម្រ និង កំពុង ត្រូវបាន ធ្វើ ការអភិរក្ស ថែម ទៀត ផង ៕
រុស្ស៊ី ទទូច ឲ្យ សហរដ្ឋ អាមេរិក ឈប់ ជ្រៀត ជ្រែក ចូលក្នុង បញ្ហា នៅ វេណេស៊ុយអេឡា ដើម្បី កុំ ឲ្យ ប្រទេស នេះ ធ្លាក់ ក្នុង សង្រ្គាម ស៊ីវិល
( ម៉ូស្គូ) ៖ ក្រសួង ការបរទេស រុស្ស៊ី នា ថ្ងៃសៅរ៍ បាន ព្រមាន សហរដ្ឋ អាមេរិក អំពី ការបន្ត លូក ដៃ ជ្រៀត ជ្រែក លើ បញ្ហា ផ្ទៃក្នុង របស់ វេណេស៊ុយអេឡា ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ ។
អ្នកនាំពាក្យ ក្រសួង ការបរទេស រុស្ស៊ី លោកស្រី Maria Zakharova បាន លើកឡើង ក្នុង សេចក្តីថ្លែងការណ៍ មួយ យ៉ាង ដូច្នេះ ថា « យើង ផ្តល់ ជា អនុសាសន៍ ថា អាមេរិក គួរតែ បញ្ឈប់ ការគំរាមកំហែង ការជិះ ជាន់ សេដ្ឋកិច្ច និង ការរុញច្រាន វេណេស៊ុយអេឡា ឲ្យ ឆ្ពោះ ទៅរក សង្រ្គាម ស៊ីវិល ដែល ជា ការរំលោភ លើ ច្បាប់ អន្តរជាតិ ទាំង បើក ចំហ ទៀត ទៅ » ។
គួរ ជម្រាប ថា ទីក្រុង វ៉ាស៊ីនតោន បាន បញ្ចេញ ប្រតិកម្ម អវិជ្ជមាន ជាខ្លាំង នៅពេល រុស្ស៊ី បាន បញ្ជូន កងទ័ព ប្រមាណ ជិត ១០០ នាក់ ទៅកាន់ ប្រទេស វេណេស៊ុយអេឡា កាលពី ថ្ងៃទី ២៣ ខែមីនា ដែល ទីក្រុង ម៉ូស្គូ អះអាង ថា ធ្វើឡើង ក្រោម កិច្ចព្រមព្រៀង ទ្វេ ភាគី ស្តីពី កិច្ចសហប្រតិបត្តិការ ផ្នែក យោធា និង បច្ចេកទេស ។
ប្រទេស អាមេរិក ឡាទីន មួយ នេះ បាន ផុង ខ្លួន ក្នុង វិបត្តិ នយោបាយ ដ៏ តានតឹង ចាប់តាំងពី ចុង ខែមករា នៅ ពេល ដែល មេ បក្ស ប្រឆាំង លោក Juan Guaido បាន ប្រកាស លើក ខ្លួន ឯង ជា ប្រធានាធិបតី ស្តី ទី របស់ វេណេស៊ុយអេឡា ហើយ ត្រូវបាន សហរដ្ឋ អាមេរិក និង សម្ព័ន្ធមិត្ត មួយចំនួន របស់ ទីក្រុង វ៉ាស៊ីនតោន ចេញមុខ ទទួលស្គាល់ ៕ អ្នក ជិះ បញ្ច្រាស រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត មាន . ក្នុង យប់ មិញ សមត្ថកិច្ច ឃាត់ បាន យានយន្ត ចំនួន ៤គ្រឿង ថែម ទៀត
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០១៩ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន ៤គ្រឿង ក្នុង នោះ រួម មាន : ម៉ូតូ៣ គ្រឿង និង ១ គ្រឿង ។
បច្ចុប្បន្ន យានយន្ត ទាំងនោះ បាន បញ្ជូន ទៅ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ កា អប់រំ ណែនាំ បន្ត តាម នីតិវិធី ។
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ប្រុងប្រយ័ត្ន ! ស្លាប់ ២នាក់ និង របួស ៣នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី៣០ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៣លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ . របួស ស្រាល ២នាក់ និង របួស ធ្ងន់ ១នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ៣លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៣គ្រឿង . រថយន្ត តូច ១គ្រឿង ។ ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធ . មិន ប្រកាន់ ស្ដាំ . ប្រជែង . បត់ ឆ្វេង ស្ដាំ . និង កត្ដាយាន ។
( កាប៊ុល) ៖ អាជ្ញាធរ អាហ្វហ្កានីស្ថាន នៅ ថ្ងៃសៅរ៍ នេះ បាន ឱ្យដឹង ថា គ្រោះ ទឹក ជំនន់ ភ្លាម ៗ បាន ផ្ដាច់ ជីវិត មនុស្ស យ៉ាងហោច ណាស់ ៣២ នាក់ និង ជាច្រើន នាក់ ទៀត បាន បាត់ខ្លួន ស្រប ពេល ផ្ទះ ជាច្រើន ខ្នង រង ការបំផ្លិចបំផ្លាញ ។ នេះ បើ តាម ការចេញ ផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃសៅរ៍ ទី៣០ ខែមីនា ឆ្នាំ ២០១៩ ។
យ៉ាងណា ក៏ដោយ សម្រាប់ ហេតុការណ៍ នេះ អភិបាល ខណ្ឌ ជ្រោយ ចង្វារ លោក ឃ្លាំង ហួត និង អាជ្ញាធរ មូលដ្ឋាន បាន ចេញ អន្ដរាគមន៍ ជា បន្ដ បន្ទាប់ ដែរ ប៉ុន្ដែ ដោយសារ ទំហំ នៃ ការបាក់ ធំ ហើយ ចេះតែ បន្ដ កើតឡើង ជា បន្ដ បន្ទាប់ ហេតុ នេះ ប្រជាពលរដ្ឋ បន្ដ ស្នើសុំ កិច្ចអន្ដរាគមន៍ ពី អាជ្ញាធរ ដើម្បី មាន វិធានការ ទប់ស្កាត់ ។
ជាមួយគ្នា នេះ ដែរ ក្រុម ប្រជាពលរដ្ឋ ក៏ សូម សំណូមពរ ដល់ អាជ្ញាធរ ក៏ ដូចជា មន្ទីរ ជំនាញ មេត្តា ចុះ មក ត្រួតពិនិត្យមើល ទីតាំង បាក់ ច្រាំង ទន្លេ នេះ ផង ថា តើ ការបាក់ ច្រាំង ទន្លេ នេះ បណ្តាល មកពី មូលហេតុ អ្វី ឱ្យ ច្បាស់លាស់ ព្រោះ កន្លងមក មាន មន្ត្រី ជំនាញ ចុះ មក ពិនិត្យ និង បាន ចាក់ ដី បំពេញ កន្លែង បាក់ នេះ ប៉ុន្តែ នៅតែ មិន មាន ប្រសិទ្ធភាព ៕
រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ ថោង ខុន៖ ឆ្នាំ ២០២១ សណ្ឋាគារ កម្រិត ផ្កាយ ប្រាំនៅ ខេត្ត ព្រះសីហនុ នឹង អាច កើន ដល់ ជិត ១ម៉ឺន បន្ទប់
ជា រួម វឌ្ឍនភាព ការងារ វិស័យ ទេសចរណ៍ និង ទីក្រុង ស្អាត ទទួលបាន លទ្ធផល ដូច ខាងក្រោម៖
២៖ ការងារ រៀបចំ សណ្តាប់ធ្នាប់ សាធារណៈ គ្រប់គ្រង បរិស្ថាន និង អនាម័យ របស់ ខេត្ត មាន លក្ខណៈ ល្អ ប្រសើរ តាម រយះ ការចាត់ វិធានការ តឹងរឹង អប់រំ និង ផ្សព្វផ្សាយ ដល់ មូលដ្ឋាន អាជីវកម្ម ទេសចរណ៍ ក៏ ដូចជា មូលដ្ឋាន លំនៅដ្ឋាន ប្រជាពលរដ្ឋ ដោយ ផ្ទាល់ ។
៣៖ ការងារ សន្តិសុខ និង សុវត្តិភាព ត្រូវបាន គ្រប់គ្រង យ៉ាង ល្អ និង បញ្ហា នានា ត្រូវបាន ដោះស្រាយ ជា បន្តបន្ទាប់ ប្រកបដោយ ប្រសិទ្ធភាព ។
៤៖ ការពង្រឹង គុណភាព សេវាកម្ម ទេសចរណ៍ និង ស្លាក យីហោ អាជីវកម្ម ត្រូវបាន ពង្រឹង ល្អ ប្រសើរ ដោយ ក្រុមការងារ ចុះ ត្រួតពិនិត្យ ជាប្រចាំ ។
៥៖ បន្ត ជម្រុញ ដល់ ស្ថាប័ន ហិរញ្ញវត្ថុ នានា និង ប្រតិបត្តិករ ទេសចរណ៍ សហការ ប្រើប្រាស់ ប្រតិបត្តិការ ទូទាត់ តាម អ៊ន ឡាញ ដោយ ប្រព័ន្ធ QR Code ឬ ដោយ មធ្យោបាយ ផ្សេង ៗ ។
៦៖ ដើម្បី គាំទ្រ ដល់ ការរីកចម្រើន វិស័យ ទេសចរណ៍ យ៉ាង គំហុក និង ជា បន្តបន្ទាប់ នៅ ខេត្ត ព្រះសីហនុ ក្រសួង ទេសចរណ៍ បាន និង កំពុង រៀបចំ ផែនការបណ្តុះបណ្តាល ធនធាន មនុស្ស និង ពង្រឹង គុណភាព បុគ្គលិក ជំនាញ តាមរយៈ ការបើក វគ្គ បណ្តុះបណ្តាល ជាប្រចាំ និង ជម្រុញ ដល់ គ្រប់ មូលដ្ឋាន អាជីវកម្ម ទេសចរណ៍ ធ្វើ ការបើក វគ្គ ពង្រឹង សមត្ថភាព នៅ មូលដ្ឋាន ផ្ទាល់ (In house training) ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃសៅរ៍ ទី៣០ ខែមីនា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
នៅក្នុង សេចក្ដីថ្លែងការណ៍ ចេញផ្សាយ កាលពី យប់ ថ្ងៃសុក្រ ( ម៉ោង នៅក្នុង តំបន់ ) ក្រសួង ការជាតិ រុស្ស៊ី បាន បញ្ជាក់ ថា យន្ដហោះ ចម្បាំង MiG-31 ក៏ បាន ហោះ អម ដំណើរ យន្ដហោះ ទម្លាក់ គ្រាប់បែក ទាំង ០២ ខាងលើ ផងដែរ ដោយ ចំណាយ ពេល ជាង ១៣ ម៉ោង រួមទាំង ការហ្វឹកហាត់ ចាក់ សាំង នៅលើ អាកាស ។
អភិបាល ខេត្ត រតនគិរី ដឹកនាំ គណៈប្រតិភូ ខេត្ត ចូលរួម ពិធី បុណ្យ វប្បធម៌ និង ទេសចរណ៍ អន្តរជាតិ នៅ ទីក្រុង ឆុង ជ័រ ខេត្ត ក្វាង ស៊ី
( ភ្នំពេញ ) ៖ លោក ថង សាវុន អភិបាល ខេត្ត រតនគិរី បាន ដឹកនាំ គណៈប្រតិភូ ខេត្ត រតនគិរី ចំនួន ៨រូប រួម មាន ថ្នាក់ដឹកនាំ មន្ទីរ ទេសចរណ៍ វប្បធម៌ ព័ត៌មាន ពាណិជ្ជកម្ម និង សភា ពាណិជ្ជកម្ម ខេត្ត អញ្ជើញ ទៅ ចូលរួម ពិធី បុណ្យ វប្បធម៌ និង ទេសចរណ៍ អន្តរជាតិ នៅ ទីក្រុង ឆុង ជ័រ ខេត្ត ក្វាង ស៊ី នៃ ប្រទេស ចិន នា រសៀល ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ នៅ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ ។
ដំណើរទស្សនៈកិច្ច នេះ ធ្វើឡើង តប តាម ការអញ្ជើញ របស់ ការិយាល័យ ការបរទេស និង ប្រជាជន ចិន នៅ ក្រៅ ប្រទេស ទីក្រុង ឆុង ជ័រ ខេត្ត ក្វាង ស៊ី នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
