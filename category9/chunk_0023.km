( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ១៨ករណី ក្នុង នោះ មាន ករណី ប្រើប្រាស់ ៤ករណី និង ជួញដូរ ១៤ករណី ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៤៧នាក់ និង ដកហូត ថ្នាំ ញៀន សរុប ជា ៤០០ ក្រាម និង ១២កញ្ចប់ តូច ។
រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « យើងខ្ញុំ សូម គោរព ថ្លែងអំណរគុណ និង សម្តែង ការកោតសរសើរ ដោយ ស្មោះ ចំពោះ ឯកឧត្តម ឧប នាយក រដ្ឋមន្ត្រី និង ឯកឧត្តម លោកជំទាវ លោក លោកស្រី ជា អនុប្រធាន អគ្គ លេខាធិការ សមាជិក សមាជិកា ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង អស់ ពី កម្លាំង កាយ ចិត្ត ប្រាជ្ញា ស្មារតី ក្នុង ការដឹកនាំ អនុវត្ត ការងារ នេះ ទទួលបាន លទ្ធផល ល្អ គួរ ជា ទី មោទនៈ » ។
សូម ជម្រាប ថា ក្រសួង រៀបចំ ដែនដី នគរ រូបនីយកម្ម និង សំណង់ ធ្វើដំណើរទស្សនកិច្ច ស្វែងយល់ អំពី ការអភិវឌ្ឍ និង ការលើកកម្ពស់ បរិស្ថាន ក្នុង ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី ២៩ - ៣១ ខែមីនា ឆ្នាំ ២០១៩ ដែល ដឹកនាំ ដោយ ឧប នាយក រដ្ឋមន្ដ្រី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរ រូបនីយកម្ម និង សំណង់ និង មាន ការចូលរួម ពី មន្ត្រី តាម បណ្តា ខេត្ត រាធានី ចំនួន ៣ពាន់ នាក់ ។
ទស្សនកិច្ច ស្វែងយល់ អំពី ការអភិវឌ្ឍ និង ការលើកកម្ពស់ បរិស្ថាន រៀបចំឡើង ដើម្បី យល់ដឹង ពី ការរីកចំរើន សេដ្ឋកិច្ច ទេសចរណ៍ ជាពិសេស លើ វិស័យ រៀបចំ ដែនដី និង សំណង់ ដែល មាន ការរើក ចំរើន យ៉ាង ឆាប់រហ័ស ក្នុង ក្រុង ព្រះសីហនុ និង ការស្វែងយល់ ពី ការថែរក្សា បរិស្ថាន នៅ តាម ទី សាធារណៈ នានា ដូចជា នៅ តាម ឆេ្នរ តាម ផ្លូវ និង តាម ការដ្ឋាន សំណង់ ក្នុង ខេត្ត ព្រះសីហនុ ៕
( ភ្នំពេញ ) ៖ អគ្គិភ័យ ដែល បាន ឆាបឆេះ ផ្ទះ ពលរដ្ឋ យ៉ាង សន្ធោ សន្ធៅ ក្បែរ ផ្សារ ស្ទឹងមានជ័យ ថ្មី ស្ថិត តាម ណ្តោយ ផ្លូវ លេខ ២១៧ ផ្ទះ លេខ ១៧A ក្រុម១ ភូមិ ទ្រា៣ នៅ ស្កាត់ ស្ទឹងមានជ័យ ទី១ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ នា រសៀល ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ នេះ បាន រលត់ ទាំងស្រុង ហើយ ។
ផ្ទះ នេះ ជា ប្រភេទ សំណង់ ថ្ម បេតុង ទំហំ ០៤ ម៉ែត្រ គុណ នឹង ០៨ម៉ែត្រ ដែល ការខូចខាត គឺ បាន ឆេះ ជាន់ ទី១ ទំហំ ដោយ សម្ភារ ប្រើប្រាស់ ប្រចាំ ថ្ងៃ អស់ ទាំងស្រុង និង រោល ផ្ទះ អ្នកជិតខាង បន្តិចបន្តួច ។ នេះ បើ យោង តាម របាយការណ៍ ដដែល បាន បញ្ជាក់ បន្ថែម ។
ករណី នេះ សមត្ថកិច្ច បាន ប្រើប្រាស់ រថយន្ត ការិយា អន្លត់ អគ្គិភ័យ ចំនួន ១០គ្រឿង ដោយ ប្រើប្រាស់ ទឹក អស់ ១០ឡាន . រថយន្ត ជំនួយ របស់ អគ្គិភ័យ កងរាជអាវុធ រាជធានី ភ្នំពេញ ចំនួន ០៤ គ្រឿង ដោយ ប្រាស់ ទឹក អស់ ០៤ ឡាន . រថយន្ត អគ្គិភ័យ ផ្សារ ស្ទឹងមានជ័យ ថ្មី ចំនួន ០១ គ្រឿង ប្រើប្រាស់ ទឹក អស់ ០១ឡាន ផងដែរ ។
ជាមួយគ្នា នេះ លោក ឌី រ័ត្ន ខេមរុណ អភិបាល រង ខណ្ឌ មានជ័យ ដែល បាន ដឹកនាំ កម្លាំង អាជ្ញាធរ ចុះ ជួយ អន្តរាគមន៍ ផងដែរ នោះ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទូទៅ សូម នាំគ្នា ប្រយ័ត្ន គ្រប់ ៗ គ្នា ចំពោះ គ្រោះ អគ្គិភ័យ ដោយសារ រដូវ នេះ អាកាសធាតុ ក្តៅ មាន ការកើនឡើង ផងដែរ ៕
រុស្ស៊ី បើក កន្លែង បង្រៀន បើកបរ ឧទ្ធម្ភាគចក្រ ទំនើប នៅក្នុង ប្រទេស វេណេស៊ុយអេឡា ខណៈ ស្ថានការណ៍ កំពុង តានតឹង (Video Inside) ( ម៉ូស្គូ) ៖ ខណៈ ដែល ស្ថានការណ៍ ក្នុង តំបន់ កំពុងតែ តានតឹង ខ្លាំង នោះ ប្រទេស រុស្ស៊ី បាន បើក ដំណើរការ មជ្ឈមណ្ឌល មួយ ដែល មាន បង្រៀន ជំនាញ បើកបរ ឧទ្ធម្ភាគចក្រ ទំនើប នៅក្នុង ប្រទេស វេណេស៊ុយអេឡា ផ្ទាល់ តែម្តង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នា រសៀល ថ្ងៃសៅរ៍ ទី៣០ ខែមីនា ឆ្នាំ ២០១៩ ។
សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ អគារ សិក្សា និង សមិទ្ធផល នានា របស់ សាលា បឋមសិក្សា សសរ ពល នៅ ស្រុក បាណន់
( បាត់ដំបង ) ៖ នា ព្រឹក ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ លោក តាន់ សុខ វិជ្ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក បាណន់ តំណាង លោក សុខ ផល អនុប្រធាន ក្រុមការងារ ចុះ ខេត្ត បាត់ដំបង និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក បាណន់ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពី ធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ អគារ សិក្សា និង សមិទ្ធផល នានា របស់ សាលា បឋមសិក្សា សសរ ពក ដែល ស្ថិត ក្នុង ភូមិ សសរ ពក ឃុំ កន្ទឺ១ ស្រុក បាណន់ ខេត្ត បាត់ដំបង ។
ក្នុង ពិធី នេះ លោក តាន់ សុខ វិជ្ជា បាន សម្ដែង នូវ សេចក្ដីរីករាយ ជា ទីបំផុត ចំពោះ ការអញ្ជើញ មក ចូលរួម របស់ ប្រជាពលរដ្ឋ និង សិស្សានុសិស្ស ទាំងអស់ ។ លោក ក៏ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ប្រជាពលរដ្ឋ សប្បុរសជន និង អាជ្ញាធរ ដែល បាន រួមគ្នា ក្នុង ការកសាង អគារ សិក្សា និង សមិទ្ធផល នានា របស់ សាលា បឋមសិក្សា សសរ ពល នា ពេលនេះ ។
ឆ្លៀត ក្នុង ឱកាស នេះ ដែរ លោក តាន់ សុខ វិជ្ជា រួមទាំង សហការី បាន នាំយក សម្ភារ សិក្សា និង កង់ សម្រាប់ ជូន សិស្ស ពូកែ ប្រចាំ សាលា បឋមសិក្សា សសរ ពក ព្រមទាំង ថ្នាំ ពេទ្យ និង គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ផងដែរ ៕
កម្មវិធី បោះជំរំ អន្តរជាតិ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី វា គ្មិន ជាតិ - អន្តរជាតិ សំខាន់ ៗ រួម មាន លោក បណ្ឌិត បាក់ អុក ស៊ូ ស្ថាបនិក អង្គការ សម្ព័ន្ធ យុវជន អន្តរជាតិ . លោក បណ្ឌិត លី ឆេង តំណាងរាស្ត្រ មណ្ឌល រាជធានី ភ្នំពេញ និង ជា សមាជិក គណៈកម្មាធិការ ប្រឹក្សា យោបល់ នៃ អង្គការ សម័្ពន្ធ យុវជន អន្តរជាតិ . ឧត្តមសេនីយ៍ ត្រី ចេវ ហាក់ ស្នងការ រង នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ និង វា គ្មិន ល្បី ៗ ជាច្រើន រូប ទៀត ។
ទី ១៖ និយមន័យ នៃ ភាព ជា អ្នកដឹកនាំ ទី ២៖ ប្រភព សំខាន់ ៗ ទាំង ៣ប្រភេទ របស់ អ្នកដឹកនាំ ទី ៣៖ ភាពខុសគ្នា រវាង អ្នកដឹកនាំ និង អ្នកគ្រប់គ្រង ទី ៤៖ លក្ខណៈ សម្បត្តិ ដើម្បី ក្លាយ ខ្លួន ជា អ្នកដឹកនាំ ដ៏ ល្អ ប្រកបដោយ សមត្ថភាព ទី ៥៖ កត្តា ចម្បង ៗ ដើម្បី ដឹកនាំ ក្រុមហ៊ុន ឬ ស្ថាប័ន ឲ្យ ទទួលបាន ជោគជ័យ ។
ទន្ទឹម គ្នា នោះ លោក បណ្ឌិត លី ឆេង ក៏ បាន ចែករំលែក បទពិសោធន៍ ជោគជ័យ ផ្ទាល់ខ្លួន ក្នុង ការដឹកនាំ ប៊ែល ធី គ្រុប ពី ម្នាក់ឯង រហូត មាន បុគ្គលិក បម្រើការ ជាង ២. ៥០០នាក់ ជាមួយនឹង អគារ សិក្សា សាលា ប៊ែល ធី អន្តរជាតិ ចំនួន ២២ ទីតាំង ព្រមទាំង សាកលវិទ្យាល័យ ប៊ែល ធី អន្តរជាតិ ចំនួន ២ទីតាំង ជូន ដល់ សិស្ស - និស្សិត ទាំងអស់ ដែល បាន ចូលរួម ក្នុង កម្មវិធី បោះជំរំជា អន្តរជាតិ (World Camp) លើក ទី៩ នៅ កម្ពុជា ផងដែរ ។
លោក បណ្ឌិត សង្ឃឹម យ៉ាង មុតមាំ ថា ក្មួយ ៗ សិស្ស - និស្សិត ទាំងអស់ នឹង អាច យក ចំណេះដឹង និង បទពិសោធន៍ ទាំងអស់ នេះ ធ្វើជា ទន់ សម្រាប់ ពង្រឹង សមត្ថភាព និង ធ្វើ ខ្លួន ឲ្យ សាកសម ជា ទំពាំង ស្នង ឫស្សី ដើម្បី រួមចំណែក អភិវឌ្ឍ ប្រទេសជាតិ នា ពេល អនាគត ៕ លោក ស្វាយ ស៊ីថា៖ ព័ត៌មាន ក្លែងក្លាយ មិន ត្រឹមតែ ពាក់ព័ន្ធ នឹង សន្តិសុខ នយោបាយ ប៉ុណ្ណោះ ទេ វា ក៏ ជា សង្គ្រាម ចិត្តសាស្ត្រ ដ៏ គ្រោះថ្នាក់
( ភ្នំពេញ ) ៖ លោក ស្វាយ ស៊ី ថា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស បាន ថ្លែង ថា ព័ត៌មាន ក្លែងក្លាយ មិន ត្រឹមតែ ពាក់ព័ន្ធ នឹង សន្តិសុខ នយោបាយ ប៉ុណ្ណោះ ទេ តែ វា ជា សង្គ្រាម ចិត្តសាស្ត្រ ដ៏ គ្រោះថ្នាក់ ដែល គេ បាន និង កំពុង បង្កើតឡើង ដើម្បី ទាក់ទាញ ប្រជាប្រិយភាព តាមរយៈ ការបំភ័ន្តមតិ ប្រជាពលរដ្ឋ ។
ការលើកឡើង របស់ មន្រ្តី ជាន់ ខ្ពស់ រូប នេះ បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ក្នុង ឱកាស ដែល លោក អញ្ជើញ បិទ វគ្គ បណ្តុះបណ្តាល វិជ្ជាជីវៈ ស្តីពី ព័ត៌មាន ក្លែងក្លាយ ដោយ បាន ផ្តល់ នូវ មតិ បូកសរុប និង បង្ហាញ ចំណុច គន្លឹះ មួយចំនួន ដល់ សិក្ខាកាម ប្រមាណ ១០០ នាក់ ដែល ជា តំណាង មកពី ក្រសួង ស្ថាប័ន រាជធានី ខេត្ត ដើម្បី ជា មូលដ្ឋានគ្រឹះ ក្នុង ការយក ទៅ អនុវត្ត ការងារ ជាក់ស្តែង នៅ តាម ក្រសួង ស្ថាប័ន នីមួយ ៗ ក្រោយពី ទទួល ការបណ្តុះបណ្តាល រយៈពេល ៥ ថ្ងៃ មក នេះ ។
លោក ស្វាយ ស៊ី ថា ក៏ បាន ធ្វើការកត់សម្គាល់ ផងដែរ ថា បច្ចុប្បន្ន ព័ត៌មាន ក្លែងក្លាយ មួយចំនួន បាន និង កំពុង បំពុល សង្គម និង នាំឱ្យ ប្រជាពលរដ្ឋ ខាតបង់ ពេលវេលា ថវិកា ចាញ់បោក ឬ ក៏ បាន ធ្វើ ការសំរេចចិត្ត ខុស ដោយសារព័ត៌មាន ក្លែងក្លាយ ដែល ក្រុម ជន មួយចំនួន បាន បង្កឡើង ។ ហេតុ នេះ សិក្ខាកាម ទាំងអស់ ត្រូវ តាមដាន ត្រួតពិនិត្យ ផ្ទៀងផ្ទាត់ ព័ត៌មាន ដែល បាន កើតឡើង ក្នុង បណ្តាញ ផ្សព្វផ្សាយ សង្គម និង ត្រូវ ខិតខំ ចូលរួមគ្នា ទប់ស្កាត់ និង បន្សាប ព័ត៌មាន ក្លែងក្លាយ ឱ្យ បាន ទាន់ ពេល វេលា ។
បន្ថែម ពីលើ នេះ ដើម្បី ចូលរួមចំណែក ក្នុង ការបញ្ឈប់ នូវ ការផ្សព្វផ្សាយ ព័ត៌មាន ក្លែងក្លាយ បណ្តាញ ផ្សព្វផ្សាយ ព័ត៌មាន មន្ត្រី សាធារណៈ និង អ្នកប្រើប្រាស់ ហ្វេសប៊ុក ត្រូវ រួមគ្នា ប្រយុទ្ធ ប្រឆាំង ទៅនឹង ព័ត៌មាន ក្លែងក្លាយ តាមរយៈ ការ មិន ផ្សព្វផ្សាយ បន្ត ឬ ចែករំលែក នូវ ព័ត៌មាន ក្លែងក្លាយ និង ចូលរួម បន្សាប នូវ ព័ត៌មាន ក្លែងក្លាយ នៅ ពេល ដែល វា ត្រូវបាន បង្កើតឡើង ឱ្យ បាន ទាន់ ពេល វេលា ។
លោក ស្វាយ ស៊ី ថា ក៏ បាន ឱ្យដឹង បន្ថែម ទៀត ថា បណ្តា ប្រទេស ជាច្រើន បាន បង្កើត នូវ ច្បាប់ ដើម្បី ប្រយុទ្ធ ប្រឆាំង ទៅនឹង ព័ត៌មាន ក្លែងក្លាយ ដែល ក្នុង នោះ មាន ដូចជា ប្រទេស បារាំង រុស្ស៉ី ម៉ាឡេស៊ី កាតា និង អេស្ស៊ី ប ជាដើម ។ ប្រទេស ជាច្រើន ដទៃ ទៀត ក៏ បាន ចាប់ផ្តើម ដាក់ចេញ នូវ វិធានការណ៍ ដើម្បី ដោះស្រាយ បញ្ហា នៃ ការកើនឡើង នូវ ព័ត៌មាន ក្លែងក្លាយ ដូចជា ប្រទេស អូស្ត្រាលី ប៊ែលហ្សិក កាណាដា ចិន បង់ក្លាដេស ឥណ្ឌា ស៉ិងហ្គា ពួរ និង ប្រទេស ហ្វីលីពីន ជាដើម ។
លោក ស្វាយ ស៊ី ថា បាន លើកទឹកចិត្ត ដល់ សិក្ខាកាម ទាំងអស់ ឱ្យ បង្កើន និង រឹត ចំណង មិត្តភាព និង ទំនាក់ទំនង ជាមួយនឹង អ្នកគាំទ្រ និង បណ្តាញ ប្រព័ន្ធ ផ្សព្វផ្សាយ ក៏ ដូចជា អ្នក រាយការណ៍ ព័ត៌មាន ។ លោក ស្វាយ ស៊ី ថា ក៏ បាន សំណូមពរ ដល់ សិក្ខាកាម គ្រប់ រូប សូម ឱ្យ ធ្វើ ការងារ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ និង ប្រកបដោយ វិជ្ជាជីវៈ ក្នុង ការប្រយុទ្ធ ប្រឆាំង ទៅនឹង ព័ត៌មាន ក្លែងក្លាយ នេះ ។
ស្នងការ រង នគរបាល រាជធានី ភ្នំពេញ លោក ឧត្តមសេនីយ៍ ត្រី ចេវ ហាក់ ធ្វើ បទបង្ហាញ ពី សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ក្នុង កម្មវិធី បោះជំរំ អន្តរជាតិ លើក ទី ៩
ក្នុង កម្មវិធី បោះជំរំ អន្តរជាតិ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី វា គ្មិន ល្បី ៗ រួម មាន៖ លោក បណ្ឌិត បាក់ អុក ស៊ូ ស្ថាបនិក អង្គការ សម្ព័ន្ធ យុវជន អន្តរជាតិ . លោក បណ្ឌិត លី ឆេង តំណាងរាស្ត្រ មណ្ឌល រាជធានី ភ្នំពេញ និង ជា សមាជិក គណៈកម្មាធិការ ប្រឹក្សា យោបល់ នៃ អង្គការ សម័្ពន្ធ យុវជន អន្តរជាតិ លោក ឧត្តមសេនីយ៍ ត្រី ចេវ ហាក់ ស្នងការ រង នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ និង វា គ្មិន ល្បី ៗ ជាច្រើន នាក់ ទៀត ។
លោក ឧត្តមសេនីយ៍ ត្រី ចេវ ហាក់ ស្នងការ រង នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ធ្វើ បទបង្ហាញ ៥ចំណុច សំខាន់ ៗ ដូច ជា៖
* ទី១៖ ត្រូវ គោរព ច្បាប់ ចរាចរណ៍ និង សញ្ញា ចរាចរណ៍ ( គំនូស ស្លាក ភ្លើង និង សញ្ញាបញ្ជា របស់ ភ្នាក់ងារ ចរាចរណ៍ )* ទី ២៖ ត្រូវ ពាក់ មួក សុវត្ថិភាព ទាំង អ្នកបើកបរ ម៉ូតូ និង អ្នក រួម ដំណើរ* ទី ៣៖ មិន ត្រូវ បើកបរ ស្ថិត ក្រោម ឥទ្ធិពល គ្រឿងស្រវឹង ឬ គ្រឿងញៀន *ទី ៤៖ ត្រូវ បន្ថយ លឿន និង គោរព សិទ្ធិ អាទិភាព នៅ ផ្លូវ ប្រសព្វ * ទី ៥៖ ត្រូវ មាន សុជីវធម៌ ក្នុង ការបើកបរ ដោយ ចេះ យោគយល់ និង អធ្យាស្រ័យ គ្នា ។
( កំពង់ឆ្នាំង ) ៖ ប្រជាពលរដ្ឋ ជាង ៣០០ នាក់ រស់ នៅក្នុង ភូមិ គោក ពេញ ឃុំ ជៀប ស្រុក ទឹក ផុស បាន នាំគ្នា ផ្ដិត មេដៃ និង ធ្វើដំណើរ មកកាន់ការ រដ្ឋាន នគរបាល ខេត្ត កំពង់ឆ្នាំង ដើម្បី ធ្វើ ការតវ៉ា ដោយ ស្នើសុំ ឲ្យ អភិបាល នៃ គណៈអភិបាល ខេត្ត និង លោក ឧត្ដមសេនីយ៍ ទោ ខូវ លី ស្នងការ នគរបាល ខេត្ត កំពង់ឆ្នាំង ពិនិត្យ ឡើងវិញ ករណី បក្ខពួក ក្រុម ជន ទំនើង ដែល បង្ក ជម្លោះ ប្រកាប់ ចាក់ គ្នា ដោយ ខ្លួន ឯង នៅក្នុង កម្មវិធី បុណ្យ រួចហើយ ចោទ ថា ប៉ូល វាយ និង ស្វាយ កាំភ្លើង AK ។
ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភូមិ គោក ពេញ យល់ឃើញ ករណី ចោទប្រកាន់ មក លើ ប៉ូលីស គឺជា រឿង អយុត្តិធម៌ បំផុត ដែល មិន អាច ទទួលយក បាន ឡើយ ។ ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ដែល បាន ឃើញ ហេតុ ផ្ទាល់ ភ្នែក បាន អះអាង ថា លោក មេ ប៉ុស្តិ៍ ឃុំ ជៀប មិន បាន ប្រព្រឹត ដូច ការចោទប្រកាន់ នោះ ទេ ។
លោកស្រី ក្ដាន់ ហ៊ុន ជា ម្ចាស់ ដើម បុណ្យ បាន លើកឡើង ថា លោកស្រី ស្អប់ ប៉ូលីស ជា ទីបំផុត ! បើ រូប គាត់ ខុស ក៏ ត្រូវ ប៉ូលីស ចាប់ រូប គាត់ ដែរ ប៉ុន្តែ រឿង នេះ អយុត្តិធម៌ សម្រាប់ ប៉ូលីស ពេក ហើយ ! សូមឲ្យ ថ្នាក់ លើ មេត្តា ពិចារណា និង ស្រាវជ្រាវ ស៊ើបអង្កេត ឱ្យ បាន ច្បាស់លាស់ យើងខ្ញុំ ជា ម្ចាស់ ដើម បុណ្យ បើក ថ្នាក់ លើ យក មនុស្ស ល្អ ទៅ ដាក់ទោស មែន នោះ ក្នុង នាម អ្នកស្រី ជា ម្ចាស់ ដើម បុណ្យ និង ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភូមិ នេះ មិន សុខចិត្ត ទេ ។
ចំពោះ លោក ជៀម វិចិត្ត ដែល ជា មេ ប៉ុស្តិ៍ នោះ អះអាង ថា ពេល មាន កម្មវិធី បុណ្យ លោក តែងតែ បាន ទៅ ការពារ សុវត្ថិភាព រក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ រាប់ មិន អស់ ហើយ ពេលនេះ មិន ខុសពី ពេល មុន ៗ ដែរ រីឯ ថា រូប លោក បាន ប្រើ អំពើហិង្សា វាយ ទៅ លើ បុគ្គ ឈ្មោះ ស៊ិន វុទ្ធី នោះ ជា រឿង មិន ពិត ឡើយ ។
ពាក់ព័ន្ធ ករណី ខាងលើ លោក អៀរ ប៊ុន ធឿន ស្នងការ រង នគរបាល ខេត្ត កំពង់ឆ្នាំង បាន ប្រាប់ ឲ្យដឹង ថា ចំពោះ ការចោទប្រកាន់ ខាង លើ នេះ ក្រោយពី បាន អង្កេត និង ស្រាវជ្រាវ នោះ សមត្ថកិច្ច រក មិន ឃើញ ភ័ស្ភ តាង ឬ បទល្មើស ណាមួយ ដែល អាច ចោទប្រកាន់ ចំពោះ លោក ជៀម វិចិត្ត មេ ប៉ុស្តិ៍ ឃុំ ជៀប ដូច ការចោទប្រកាន់ នោះ ទេ ។
លោក ឧត្ដមសេនីយ៍ ទោ ខូវ លី ស្នងការ នគរបាល ខេត្ត កំពង់ឆ្នាំង ក៏ បាន ឲ្យដឹង ថា ចំពោះ លោក ជៀម វិចិត្ត . លោក បាន ហៅ មកកាន់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ដើម្បី សាកសួរ បន្ត ប្រសិនបើ រកឃើញ ថា ពិតជា បាន ប្រព្រឹត នោះ លោក នឹង ចាត់ វិធានការ ច្បាប់ មិន ឱ្យ រួច ខ្លួន ឡើយ ។
បើ ទោះ យ៉ាងណា ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភូមិ គោក ពេញ ឃុំ ជៀប ស្រុក ទឹក ផុស ជាង ៣០០ នាក់ បាន សម្ដែង នូវ ការ ហួសចិត្ត ហើយ អំពាវនាវ ដោយ ស្នើសុំ ឲ្យ ថ្នាក់ លើ ជាពិសេស នោះ លោក ឧត្ដមសេនីយ៍ ទោ ខូវ លី សូម លោក ពិចារ្យ ណា ឡើងវិញ ហើយ កំយក មនុស្ស ល្អ ដែល គ្មាន កំហុស យក ទៅ ដាក់ទោស ដោយសារតែ ការចោទប្រកាន់ គ្មាន មូលដ្ឋាន ច្បាស់លាស់ ឬ ជា រឿង អ្វី មួយ នោះ ពិតជា អយុត្តិធម៌ ពេក ហើយ ៕
( ភ្នំពេញ ) ៖ ក្រុង តាខ្មៅ ជា តំបន់ មាន សក្កានុពល ខ្លាំង ដោយសារតែ កត្តា ធម្មជាតិ ហើយ ជា តំបន់ ខ្ពស់ រាប ងាយស្រួល ក្នុង ការរំដោះ ទឹក ។
មិន តែ ប៉ុណ្ណោះ បិតា ស្ថាបត្យកម្ម ខ្មែរ លោក វណ្ណ ម៉ូលីវណ្ណ បាន បន្សល់ទុក ចក្ខុវិស័យ ថា រាជធានី ភ្នំពេញ គួរ អភិវឌ្ឍន៍ ឆ្ពោះទៅ ភាគ ខាងត្បូង ។
ក្រៅពី នៅ កៀក ជិត រាជធានី ភ្នំពេញ ក្រុង តាខ្មៅ ក៏ ស្ថិត នៅ ចន្លោះ កណ្ដាល ផ្លូវ ជាតិ លេខ ២ និង ផ្លូវ សម្ដេច ហ៊ុន សែន ( ៦០ម៉ែត្រ ) ដែល ជា ផ្លូវ ធំ ទូលាយ ហើយ កំពុង មាន ភាពមមាញឹក ខ្លាំង សាកសម ក្នុង ការបើក អាជីវកម្ម ។
( ព្រះវិហារ ) ៖ បុរស ម្នាក់ បាន ដាច់ចិត្ត ចង ក សម្លាប់ ខ្លួន ឯង ចោល ប្រពន្ធ កូន មូលហេតុ ដោយសារ តូចចិត្ត ខឹង ប្រពន្ធ សុំ លុយ ដើម្បី ទៅ សង ថ្លៃ ស្រា គេ មិន បាន ។ ហេតុការណ៍ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ១០៖ ២២នាទី យប់ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ ស្ថិត ក្នុង ភូមិ ស្វាយប៉ាត ឃុំ រំដោះ ស្រុក រវៀង ខេត្ត ព្រះវិហារ ។
លោក វរសេនីយ៍ ឯក សាយ ដេត អធិការ នគរបាល ស្រុក វៀង បាន ប្រាប់ ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ នេះ ថា មុនពេល កើត ហេតុ ជនរងគ្រោះ ជា ប្តី បាន ត្រឡប់ មកពី ផឹក ស្រា លុះ មកដល់ ផ្ទះ ក៏ សុំ លុយ ប្រពន្ធ ដើម្បី យក ទៅ សង ថ្លៃ ស្រា គេ តែ ប្រពន្ធ ក៏ មិន បាន ឆ្លើយតប ធ្វើឲ្យ បុរស ជា ប្តី តូចចិត្ត រត់ ទៅ ចង ក ក្រោម ដើម ស្វាយ ក្រោយ ផ្ទះ ស្លាប់ បាត់បង់ជីវិត ។
បន្ទាប់ពី លោក Antonio Guterres បាន ឡើង ថ្លែង បើក កិច្ចប្រជុំ រួច មក បណ្តា រដ្ឋមន្ត្រី ការពារ ជាតិ និង តំណាង ឲ្យ រដ្ឋមន្ត្រី ការពារ ជាតិ មកពី បណ្តា ប្រទេស ដែល បាន ចូលរួម បរិច្ចាក កម្លាំង ក្នុង ប្រតិបត្តិការ រក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ បាន ឡើង ថ្លែង សុន្ទរកថា ជា បន្តបន្ទាប់ ដោយ បាន បញ្ជាក់ ឡើងវិញ ចំពោះ ការប្តេជ្ញាចិត្ត របស់ ពួកគេ ក្នុង ការចូលរួម ថែរក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ ។
បណ្ដា ប្រទេស ទាំងអស់ នោះ រួមទាំង កម្ពុជា ផងដែរ បាន អះអាង ថា ការថែរក្សា សន្តិភាព គឺជា ឧបករណ៍ ដ៏ មាន ប្រសិទ្ធភាព បំផុត មួយ សម្រាប់ អង្គការ សហ ប្រជាជាតិ ក្នុង ការលើកកម្ពស់ និង ថែរក្សា សន្តិភាព និង សន្តិសុខ អន្តរជាតិ ។
កិច្ចប្រជុំ នា ឱកាស នោះ ក៏ បាន ផ្តល់ វេទិកា ពិភាក្សា និង បង្កើត សមត្ថភាព ជំនាញ ចាំបាច់ សម្រាប់ ប្រតិបត្តិការ រក្សា សន្តិភាព នា ពេល បច្ចុប្បន្ន ក៏ ដូចជា ឆ្លុះបញ្ចាំង ពី កិច្ចប្រឹងប្រែង ពង្រឹង ការងារ តាមរយៈ គំនិត ផ្តួចផ្តើម សកម្មភាព សម្រាប់ ការងារ រក្សា សន្តិភាព ដោយ ផ្តោត លើ សមត្ថភាព ជំនាញ ការអនុវត្តន៍ និង ការការពារ ជន ស៊ីវិល ព្រមទាំង ការបង្កើន ចំនួន ស្ត្រី ក្នុង វិស័យ រក្សា សន្តិភាព ឲ្យបាន ច្រើន ផងដែរ ។
សម្តេច ទៀ បាញ់ បាន បញ្ជាក់ ថា កម្ពុជា ធ្លាប់ ជា ប្រទេស មួយ ទទួល កងទ័ព មួក ខៀវ មក ជួយ ស្វែងរក សុខ សន្តិភាព ជូន ប្រជាពលរដ្ឋ កម្ពុជា បច្ចុប្បន្ន បាន ប្រែក្លាយជា ប្រទេស ដែល បញ្ជូន កងទ័ព មួក ខៀវ ដើម្បី ស្វែងរក សុខ សន្តិភាព ជូន បណ្តា ប្រទេស នៅលើ ពិភពលោក វិញ ។
ចាប់តាំង ឆ្នាំ ២០០៦ រហូតមកដល់ បច្ចុប្បន្ន កម្ពុជា មាន មោទនភាព ដែល បាន រួមចំណែក បញ្ជូន កងកម្លាំង មួក ខៀវ ទៅ ប្រតិបត្តិការ ក្រោម ឆ័ត្រ របស់ អង្គការ សហ ប្រជាជាតិ នៅ ប្រទេស ស៊ូ ដង់ ស៊ូ ដង់ ខាងត្បូង ឆាដ លី បង់ ម៉ាលី អាហ្វ្រិក កណ្តាល ស៊ីរី និង ប្រទេស សាយ ព្រឺស ។ បច្ចុប្បន្ន កម្លាំង កម្ពុជា កំពុង មាន វត្តមាន ក្នុង តំបន់ បេសកកម្ម នៅ អាហ្រ្វិក កណ្តាល លី បង់ ស៊ូ ដង់ ខាងត្បូង និង ម៉ាលី ។
( ម៉ូស្គូ . រុស្ស៊ី )៖ ដំណើរទស្សនកិច្ច នៃ គណៈប្រតិភូកងទ័ព ជើងគោក នៃ កងយោធពល ខេមរភូមិន្ទ ដឹកនាំ ដោយ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កង យុទ្ធ ពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក បាន ជួប ពិភាក្សា ការងារ ជាមួយ ឧត្តមសេនីយ៍ ទោ អ៉ីហ្គរ ម៉ីតស៊ូ គីន (IGOR MITHSHUTKIN) សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ យោធា សហព័ន្ធ រុស្ស៊ី នៅ ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០១៩ នៅ រដ្ឋធានី ម៉ូស្គូ ។
ភាគី ទាំង ពីរ បាន ពិភាក្សា គ្នា ដើម្បី បង្កើន កិច្ចសហប្រតិបត្តិការ រវាង សាកលវិទ្យាល័យ យោធា សហព័ន្ធ រុស្ស៊ី និង កងទ័ព កម្ពុជា ក្នុង ការបណ្ដុះបណ្ដាល បង្កើន សមត្ថភាព ។
ឧត្តមសេនីយ៍ ទោ IGOR MITHSHUTKIN បាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ និង មាន ចិត្ត សប្បាយរីករាយ ដែល បាន ទទួល ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត និង គណៈប្រតិភូកងទ័ព ជើងគោក ។ បន្ទាប់មក ភាគី មិត្ត រុស្ស៉ី បាន ធ្វើ បទបង្ហាញ ពី សាកលវិទ្យាល័យ ជូន គណៈប្រតិភូ កម្ពុជា ហើយ បាន ជម្រាប ជូន គណៈប្រតិភូ ខិត ផងដែរ ថា និស្សិត កម្ពុជា ដែល កំពុង សិក្សា នៅ ទីនោះ បាន ខិតខំ ប្រឹងប្រែង ក្រេប យក ចំណេះ វិជ្ជា ព្រមទាំង គោរព វិន័យ បាន យ៉ាង ល្អ ។
លោក សាកលវិទ្យាធិការ បាន បញ្ជាក់ ថា សាកលវិទ្យាល័យ បាន ត្រៀម ខ្លួន ជាស្រេច ក្នុង ការទទួល និស្សិត កម្ពុជា បន្ថែម ទៀត នៅពេល អនាគត ។
ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត បាន ថ្លែងអំណរគុណ ចំពោះ រដ្ឋាភិបាល រុស្ស៊ី កងទ័ព សហព័ន្ធ រុស្ស៉ី ជាពិសេស ថ្នាក់ដឹកនាំ សាកលវិទ្យាល័យ និង យោធាចារ្យ ដែល បាន ជួយ បណ្ដុះបណ្ដាល និស្សិត របស់ កម្ពុជា ហើយ ចាត់ទុក កងទ័ព កម្ពុជា និង និស្សិត កម្ពុជា មិត្ត ដ៏ ល្អ ។ លោក ឧត្ដមសេនីយ៍ បាន បញ្ជាក់ ថា កម្ពុជា ស្វាគមន៍ ផងដែរ ចំពោះ និស្សិត និង សិក្ខាកាម រុស្ស៉ី ដែល នឹង ទៅ សិក្សា នៅ សាកលវិទ្យាល័យ ការពារ ជាតិ កម្ពុជា ។
បន្ទាប់ពី ជំនួប ពិភាក្សា ការងារ រួច មក គណៈប្រតិភូ នៃ កងទ័ព ជើងគោក កម្ពុជា បាន អញ្ជើញ ទស្សនា អាគារ សាកលវិទ្យាល័យ និង សកម្មភាព បណ្ដុះបណ្ដាល ធនធាន មនុស្ស នៅក្នុង សាកលវិទ្យាល័យ នេះ ផងដែរ ៕
មន្ដ្រី ជាន់ ខ្ពស់ សុខាភិបាល៖ ការធានា គុណភាព សុវត្ថិភាព និង ប្រសិទ្ធិភាព របស់ ឱសថ ជា ការងារ ចម្បង ក្នុង ផ្ដល់ សេវា ដល់ អ្នកជំងឺ
( សៀមរាប ) ៖ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល លោកស្រី វេជ្ជបណ្ឌិត ឱ វណ្ណឌីន បាន ថ្លែង ថា ការធានា គុណភាព សុវត្ថិភាព និង ប្រសិទ្ធិភាព របស់ ឱសថ ដែល ទទួលបាន ការអនុញ្ញាត ឱ្យ ចរាចរណ៍ នៅ កម្ពុជា គឺជា ការងារ ចម្បង និង មាន សារៈសំខាន់ ចាំបាច់ ក្នុង ការលើកកម្ពស់ គុណភាព សេវា សុខាភិបាល ជូន ដល់ ប្រជាពលរដ្ឋ ។
ការថ្លែង បែប នេះ របស់ លោកស្រី រដ្ឋលេខាធិការ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ចូលរួម បិទ សិក្ខាសាលា ថ្នាក់ ជាតិ ស្តីពី « ការត្រួតពិនិត្យ គុណភាព ឱសថ លើ ទីផ្សារ » ដល់ មន្ត្រី សុខាភិបាល មកពី នាយកដ្ឋាន ឱសថ មជ្ឈមណ្ឌល ជាតិ ពិសោធន៍ សុខាភិបាល មជ្ឈមណ្ឌល ជាតិ កំចាត់ រោគរ បេង និង ហង់ សិន មជ្ឈមណ្ឌល ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៏ សើស្បែក និង កាមរោគ ឃ្លាំង ឱសថ កណ្តាល និង មន្រ្ដី ភ្នាក់ងារ ត្រួតពិនិត្យ ឱសថ មកពី មន្ទីរ សុខាភិបាល រាជធានី ខេត្ត ចំនួន ១២ ។
ក្នុង ឱកាស នោះ លោកស្រី បាន ថ្លែង បន្ដ ថា « សម្រាប់ ប្រសិទ្ធិភាព របស់ ឱសថ ឬ គុណភាព ឱសថ គឺ មាន ទំនាក់ទំនង គ្នា យ៉ាង ជិតស្និទ្ធ ទៅនឹង គុណភាព នៃ ការព្យាបាល បើ ឱសថ មិន មាន គុណភាព ត្រឹមត្រូវ តាម បទដ្ឋាទ បច្ចេកទេស ទេ នោះ គុណភាព នៃ ការព្យាបាល មិន អាច ទទួលបាន ជោគជ័យ ឡើយ ទោះបីជា គ្រូពេទ្យ នោះ មាន ជំនាញ និង ពូកែ យ៉ាងណា ក៏ដោយ ។ ហើយ បើ ឱសថ អន់ គុណភាព នោះ នឹង ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ ដល់ សុខភាព សាធារណៈ ក៏ ដូចជា ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច គ្រួសារ និង សេដ្ឋកិច្ច ជាតិ ផងដែរ » ។
ជាង នេះ ទៅ ទៀត លោកស្រី បន្ដ ថា ក្រសួង សុខាភិបាល តែងតែ យកចិត្តទុកដាក់ និង គាំទ្រ យ៉ាង សកម្ម ដល់ សកម្មភាព គ្រប់គ្រង និង តាមដាន គុណភាព ឱសថ ក្នុង ប្រទេស កម្ពុជា ជាក់ស្តែង ចំពោះ ឱសថ ដែល បាន អនុញ្ញាតឲ្យ ដាក់ លក់ ឬ ចរាចរណ៍ លើ ទីផ្សា ហើយ នោះ ក្រសួង សុខាភិបាល បាន ចាត់ ឲ្យ ភ្នាក់ងារ ត្រួតពិនិត្យ ឱសថ ចុះ ត្រួតពិនិត្យ ជាប្រចាំ និង ទិញ ឱសថ ពី ទីផ្សារ ដើម្បី យក មកវិភាគ គុណភាព ឡើងវិញ ហើយ បាន ចាត់ វិធានការ ចំពោះ ឱសថណា ដែល មាន គុណភាព មិន ត្រឹមត្រូវ តាម បទដ្ឋាន បច្ចេកទេស ។
លោកស្រី បន្ដ ថា សិក្ខាសាលា នេះ បាន ផ្តល់ ចំណេះដឹង អំពី ការប្រើប្រាស់ ឧបករណ៍ សម្រាប់ កំណត់ មុខ ឱសថ និង ទីតាំង ដែល ត្រូវ ធ្វើ ការស្រង់ ឱសថ ដោយ ផ្អែក លើ ហានិភ័យ ។ បើ យើង អនុវត្ត តាម ឧបករណ៍ នេះ យើង នឹង ជ្រើសរើស បាន មុខ ឱសថ និង ទីតាំង ដែល ត្រូវ ចុះ ស្រង់ បាន ចំ គោលដៅ ដោយ ប្រើប្រាស់ ថវិកា តិច និង ចំណេញ ពេល វេលា ។ សិក្ខាសាលា នេះ ក៏ បាន កែលម្អ ផងដែរ នូវ ពិធីសារ សម្រាប់ ការតាមដាន គុណភាព ឱសថ ឲ្យ ស្រប តាម ស្ថានភាព ជាក់ស្តែង ក្នុង ប្រទេស បច្ចុប្បន្ន ។
សិក្ខាសាលា ស្តីពី ការត្រួតពិនិត្យ ឱសថ នៅលើ ទីផ្សារ ដោយ យោង ទៅតាម ហានិភ័យ បាន ចូលរួមចំណែក ដល់ ការពារ ការរក ឲ្យ ឃើញ និង ការចាត់ វិធានការ ឱ្យ បាន ឆាប់ ចំពោះ ឱសថ ក្លែងក្លាយ និង អន់ គុណភាព ដែល សិក្ខាសាលា នៅ កម្ពុជា នា ពេលនេះ ជា គំរូ សម្រាប់ ប្រទេស ក្នុង តំបន់ ។
ទន្ទឹម នោះ តំណាង អង្គការ សុខភាព ពិភពលោក អញ្ជើញ មក ពី ទីក្រុង ហ្សឺណែវ ប្រទេស ស្វីស លោកស្រី Diana Aram Lee បាន បញ្ជាក់ បន្ថែម ថា បញ្ហា ឱសថ ក្លែងក្លាយ និង អន់ គុណភាព មិន មែន ជា បញ្ហា ដែល មាន នៅតែ ប្រទេស ណាមួយ នោះ ទេ ប៉ុន្តែ វា ជា បញ្ហា ដែល កើត មាន ឡើង ជា សកល ដែល យើង ត្រូវតែ រួមគ្នា ដោះស្រាយ ។ អង្គការ សុខភាព ពិភពលោក មាន ការប្តេជ្ញាចិត្ត ក្នុង ការពង្រឹង សមត្ថភាព មន្ត្រី ភ្នាក់ងារ ត្រួតពិនិត្យ ឱសថ រួមបញ្ចូល ទាំង ការគាំទ្រ លើ សកម្មភាព ត្រួតពិនិត្យ ឱសថ នៅលើ ទីផ្សារ ផងដែរ ។
ព្រម ជាមួយគ្នា នោះ ដើម្បី ធានា ឲ្យបាន នូវ គុណភាព សុវត្ថិភាព និង ប្រសិទ្ធិភាព របស់ ឱសថ លោកស្រី រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន បន្ថែម ថា ការងារ ត្រួតពិនិត្យ គុណភាព ឱសថ នេះ តំរូវ ឱ្យ មាន ការចូលរួម ពី ផ្នែក ពាក់ព័ន្ធ ដែល បាន ទទួល ការបណ្តុះបណ្តាល នា ពេលនេះ ពិសេស មន្ដ្រី ទាំងអស់ ត្រូវ អនុវត្ដន៍ ខ្ជាប់ខ្ជួន ដូច ជា៖
* នាយកដ្ឋាន ឱស ថ ចំណីអាហារ បរិក្ខារ ពេទ្យ និង គ្រឿង សំអាង និង មន្ទីរ សុខាភិបាល រាជធានី / ខេត្ត ត្រូវ ធ្វើ ការ ចុះ ត្រួតពិនិត្យ ឲ្យបាន ទៀងទាត់ ជាប់ ជាប្រចាំ ដល់ គ្រឹះស្ថាន ផលិត ឱសថ គ្រឹះស្ថាន អាហរ័ណ នីហរ័ណ ឱសថ និង គ្រឹះស្ថាន លក់ ឱសថ ទៅ តាម ភារកិច្ច នៅ តាម ដែន សមត្ថកិច្ច របស់ ខ្លួន ។
* ត្រូវ ត្រួតពិនិត្យ គុណភាព ឱសថ លើ ទីផ្សារ ត្រូវ ធ្វើ ការកំណត់ មុខ ឱសថ និង ទីតាំង ស្រង់ ឱសថ ដោយ ផ្អែក តាម ចំណាត់ថ្នាក់ ហានិភ័យ ។
* មជ្ឈមណ្ឌល ជាតិ ពិសោធន៍ សុខាភិបាល ត្រូវ បន្ត ពង្រឹង សមត្ថភាព ក្នុង ការត្រួតពិនិត្យ គុណភាព ឱសថ រួមទាំង ឱសថ បុរាណ ឱសថ បំប៉ន សុខភាព និង គ្រឿង សំអាង ផងដែរ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោកស្រី អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ជៀសវាង ការប្រើប្រាស់ ឱសថ តាម គ្នា ដោយ គ្មាន វេជ្ជបញ្ជា ត្រឹមត្រូវ និង ឱសថ ដែល លក់ តាម បណ្តាញ សង្គម និង គេហទំព័រ ព្រោះ ឱសថ ទាំង នេះ ពុំ មាន សុវត្ថិភាព ឡើយ ប៉ុន្តែ វា ធ្វើឲ្យ បងប្អូន ខាតបង់ ថវិកា ពន្យា ពេលវេលា នៃ ការព្យាបាល និង អាច បណ្តាលឲ្យ មាន គ្រោះថ្នាក់ ដល់ ជីវិត ថែម ទៀត ផង ៕
អភិបាល ស្រុក ស្អាង ខេត្ត កណ្ដាល អំពាវនាវ ឲ្យ ក្រុម អាជីវករ រក្សា ភាពស្ងប់ស្ងៀម ក្រោយ ផ្អើល ថា ថៅកែ ផ្សារ ស្អាង យក គ្រឿងចក្រ ទៅ រុះរើ ផ្សារ ទាំង យប់
( កណ្ដាល ) ៖ ក្រោយពី ផ្ទុះ ការតវ៉ា របស់ អាជីវករ ផ្សារ ស្អាង ខាងត្បូង ទាំង យប់ ខណៈ ឃើញ កម្មករ ផ្សារ យក គ្រឿងចក្រ ទៅ ជួសជុល ដំបូល ។ លោក ញឹម វណ្ណ ឌិន អភិបាល ស្រុក ស្អាង បាន ថ្លែង នៅក្នុង កិច្ចប្រជុំ គណៈកម្មការ ផ្សារ ថា សូមឲ្យ អាជីវករ រក្សា ភាពស្ងប់ស្ងៀម អ្វី ដែល អាជីវករ ផ្សារ កំពុង ធ្វើ នោះ គឺ ត្រូវ ប្រកប ដដែល មិន មាន ការរុះរើ នោះ ទេ ។
ការផ្ទុះ ការតវ៉ា នេះ ធ្វើឡើង កាលពី យប់ ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០១៩ កន្លងទៅ នៅក្នុង បរិវេណ ផ្សារ ស្អាង ខាងត្បូង ភូមិ ព្រែក រុន ឃុំ ព្រែក គយ ស្រុក ស្អាង ខេត្ត កណ្តាល ។
លោក ប៉ោ សេង ទទួលម៉ៅ ភាស៊ី ផ្សារ ស្អាង ទាំង ពីរ បាន ប្រាប់ អ្នកយកព័ត៌មាន ថា ចំពោះ ការភ្ញាក់ផ្អើល របស់ អាជីវករ ផ្សារ ស្អាង ខាងត្បូង ថា ក្រុម កម្មករ ផ្សារ យក គ្រឿងចក្រ ទៅ ឈូស រុះរើ ផ្សារ ទាំង យប់ នោះ គឺជា រឿង ភ័ន្តច្រឡំ នោះ ទេ ដោយសារ នៅ ត្រង់ កន្លែង ភ្ញាក់ផ្អើល នោះ ដំបូល ផ្សារ ខូចខាត ហើយ មិន អាច ឡើង ជួសជុល បាន លោក បាន ឲ្យ យក គ្រឿងចក្រ ទៅ ឈរ ជាន់ ដើម្បី វ៉ៃ ជួសជុល ដំបូល ឡើងវិញ ។ ប៉ុន្តែ ក្រោយ មាន ការភ្ញាក់ផ្អើល គឺ លោក បាន ឲ្យ កម្មករ ឈប់ ភ្លាម ដើម្បី ដោះស្រាយ ។
លោក ជឺ គឺ មហៃ អភិបាល រង ស្រុក ស្អាង បាន ប្រាប់ ក្រុម អាជីវករ នៅក្នុង ពិធី ជួបជុំ នៅ សាល ប្រជុំ សាលា ស្រុក ស្អាង ថា ក្នុង នាម លោក ជា ប្រធាន គណកម្មការ ផ្សាស្អាង សូមឲ្យ អាជីវករ រក្សា ភាព ដដែល បើ មិន ទាន់ មាន ការជូនដំណឹង ពី គណកម្មការ នោះ ។
លោក បាន បញ្ជាក់ ថា កិច្ចសន្យា សាងសង់ ផ្សារ របស់ ប៉ោ សេង គឺ ហួស សុពលភាព ហើយ ការយឺតយ៉ាវ នេះ មិន មែន កំហុស លោក ប៉ោ សេង ទេ ដោយសារ ផ្សារ នេះ ជាប់ រឿងក្តី ក្តាំ គ្នា ជាមួយ ប្រជាពលរដ្ឋ មួយ គ្រួសារ រស់ នៅ លើ ដី ផ្សារ ត្រង់ កាច់ជ្រុង ផ្សារ ប្តឹង ផ្តល់ រហូតដល់ តុលាការ មិន ទាន់ ចប់ នៅឡើយ ទើប មិន អាច សាងសង់ បាន នោះ ។
លោក បាន បន្ថែម ទៀត ថា លោក ជា ប្រធាន គណកម្មការ ផ្សារ លោក បាន ឡើង តុលាការ ជាច្រើន លើក មក ហើយ តែ មិន ទាន់ ចប់ ទើប អូសបន្លាយ រហូតដល់ ពេលនេះ ម្យ៉ាង វិញ ទៀត ក្រោយ ពិនិត្យ ឃើញ កិច្ចសន្យា ហួស សុពលភាព បែប នេះ គណកម្មការ ផ្សារ ធ្វើ កិច្ចពិភាក្សា និង លើក សំណើរ ទៅ គណៈ អភិបាល ខេត្ត ដើម្បី ធ្វើ កិច្ចសន្យា ម្តង ទៀត រៀបចំ ឲ្យ ផ្សារ មាន សោភណ្ឌភាព ល្អ និង សំណូមពរ ដល់ អាជីវករ ចូលរួម ទាំងអស់ គ្នា ផងដែរ ។
លោក ញឹម វណ្ណ ឌិន អភិបាល ស្រុក ស្អាង បាន និយាយ ថា បច្ចុប្បន្ន យើង មាន គណៈកម្មការ ផ្សារ ត្រឹមត្រូវ ដូច្នេះ មុននឹង ធ្វើ អ្វី ៗ គឺ ត្រូវ ពិគ្រោះយោបល់ នៅក្នុង គណៈកម្មការ សិន ហើយ ស្ថានភាព កាលពី យប់ មិញ នេះ ទោះជា យ៉ាងណា យើង គួរតែ កុំ ធ្វើ នៅ ពេល ដែល យើង មើល មិន ឃើញ ច្បាស់ លើកលែងតែ រឿង បន្ទាន់ ។
ចំពោះ មធ្យោបាយ លោក គិត ថា គួរតែ កុំ ប្រើ គ្រឿងចក្រ ដើម្បី កុំ ឲ្យ មាន ការយល់ ច្រឡំ គឺ ត្រូវ ប្រើ មធ្យោបាយ ធម្មតា ហើយ សូមឲ្យ មាន ការចូលរួម ពី បងប្អូន អាជីវករ ក្បែរ នោះ ផងដែរ ។ រឿង ដែល កើតឡើង កាលពី យប់ មិញ នេះ លោក មិន ធ្វើ ការវ៉ែក ញ៉ែក រក អ្នក នៅ ពីមុខ ពីក្រោយ អី នោះ ទេ ព្រោះ វា មិន ចាំបាច់ សម្រាប់ លោក លោក សូម តែ ឲ្យ មាន ការយោគយល់ ទាំងអស់ គ្នា រួម មាន៖
ទី ១៖ មុននឹង យើង ធ្វើ អ្វី ៗ នៅក្នុង តំបន់ ផ្សារ ទាំង ពីរ នេះ សូមឲ្យ ស្ថិត នៅក្រោម ឆ័ត្រ គណៈកម្មការគ្រប់គ្រង ផ្សារ ដើម្បី កុំ ឲ្យ មាន ការខ្វែងគំនិត គ្នា ។
ទី២៖ សូម រក្សា ស្ថានភាព ស្ងប់ សុខ ដដែល បើសិនជា មិន មាន ការណែនាំ ពី ថ្នាក់ដឹកនាំ ខាងលើ ព្រោះ តាំងពី មុន បោះឆ្នោត ក្រោយ បោះឆ្នោត រហូតមកដល់ ពេលនេះ គឺ យើង មាន ភាពស្ងប់ស្ងាត់ ល្អ ណាស់ ជាមួយនឹង ការរួមចំណែក ពី គ្រប់ អ្នក ពាក់ព័ន្ធ ទាំងអស់ ពិសេស គឺ បងប្អូន ប្រជាពលរដ្ឋ និង អាជីវករ តែម្តង ។
សារ នេះ បាន បង្ហោះ ឡើង បន្ទាប់ពី ឃើញ មាន អ្នក ឈ្នះ រង្វាន់ ៤០ លាន រៀល ពី ក្រវិល កំប៉ុង ស្រាបៀរ កម្ពុជា ជាច្រើន នាក់ ផុស នៅលើ ហ្វេសប៊ុក ជាញឹកញាប់ ។
តាម ព័ត៌មាន ពី អ្នកជិតស្និត របស់ កញ្ញា បាន ឱ្យដឹង ថា បញ្ញា តែងតែ ស្ម័គ្រចិត្ត ចូលរួម សម្តែង ក្នុង កម្មវិធី បុណ្យ ជាតិ មួយចំនួន ច្រើន កន្លងមក ក្នុង ទូរទស្សន៍ ជាតិ កម្ពុជា ដោយ មិន ទទួល កម្រៃ និង កម្មវិធី រៀប ចំឡើង ដោយ និស្សិត ក្នុង គោលបំណង សប្បុរសធម៌ ជាច្រើន ទៀត ។
ជាមួយ ការតាំងចិត្ត នេះ និង ការស្ម័គ្រចិត្ត ចូលរួមចំណែក កិច្ចការងារ សង្គម ជា រឿយ ធ្វើឱ្យ កញ្ញា ទទួលបាន ប្រជាប្រិយភាព កាន់តែ ខ្លាំង ឡើង ៕
ពលរដ្ឋ ខ្មែរ អាច សួរសុខទុក្ខ និង ផ្ញើ ប្រាក់ ជូន សាច់ញ្ញាតិ ខ្លួន ដែល ជាប់ ឃុំ នៅ ពន្ធនាគារ ខ្លង ព្រេម ប្រទេស ថៃ បន្ទាប់ពី បុណ្យ ចូល ឆ្នាំ ខ្មែរ ហើយ
យោង តាម សេចក្តីជូនដំណឹង បាន ឲ្យដឹង ថា ទីតាំង ពន្ធនាគារ ខ្លង ព្រេម ស្ថិត នៅ សង្កាត់ ទុចាក់ រាជធានី បាំងកក ហើយ កាលបរិច្ឆេទ នៃ ការសួរសុខទុក្ខ ត្រូវបាន កំណត់ ដូច ខាងក្រោម៖
បើ តាម សេចក្តីជូនដំណឹង ដដែល ពន្ធនាគារ ខ្លង ព្រេម ក៏ នឹង អនុញ្ញាតឲ្យ ប្រជាពលរដ្ឋ ខ្មែរ ប្រើប្រាក់ ជូន សាច់ញ្ញាតិ ខ្លួន ដែល ជាប់ ឃុំ តាមរយៈ គណៈ ធនាគារ ក្រុង ថៃ ដោយ មិន គិត សេវា តែ ត្រូវ បំពេញ បែបបទ ដាក់ពាក្យ ស្នើសុំ « បណ្ណ ប្រើប្រាស់ សេវាកម្ម ផ្ញើ ប្រាក់ » នៅ ពន្ធនាគារ ជាមុន សិន ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ អគ្គ នាយកដ្ឋាន ពន្ធ នាគា រ៖ ក្រសួង ពាណិជ្ជកម្ម ថៃ កៀរ គរ ពាណិជ្ជករ ខ្មែរ ឲ្យ ចូលរួម ពិព័រណ៍ រយៈពេល ៥ ថ្ងៃ នៅ ទីក្រុង បាងកក ប្រទេស ថៃ
( មណ្ឌលគិរី ) ៖ ក្រុមការងារ គណៈកម្មការ ទី៧ នៃ រដ្ឋសភា ដឹកនាំ ដោយ លោក ហ៊ុន ម៉ានី នៅ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ បាន ជួបប្រជុំ ជាមួយ រដ្ឋបាល ខេត្ត មណ្ឌលគិរី ដឹកនាំ ដោយ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ។
ក្នុង កិច្ចប្រជុំ នោះ ប្រតិភូ នៃ គណៈកម្មការ ទី៧ បាន ផ្តោត ការពិភាក្សា ស៊ីជម្រៅ លើ ការរក្សា ភាពសុខដុមរមនា នៃ វប្បធម៌ ប្រពៃណី ទំនៀមទម្លាប់ ជាតិ សាសន៍ និង ជីវភាព រស់ នៅ របស់ ប្រជាជន ជាពិសេស បងប្អូន ជនជាតិ ភាគ តិច នៅក្នុង ខេត្ត មណ្ឌលគិរី ។
សូម ជម្រាប ថា ខេត្ត មណ្ឌលគិរី គឺជា ខេត្ត ទី១២ ដែល គណៈកម្មការ អប់រំ យុវជន កីឡា ធម្មការ កិច្ចការ សាសនា វប្បធម៌ និង ទេសចរណ៍ នៃ រដ្ឋសភា បាន ចុះ បំពេញ បេសកកម្ម ។ ខេត្ត មណ្ឌលគិរី ជា ខេត្ត ដែល មាន ចំនួន បងប្អូន ប្រជាន ជន ដែល ជនជាតិ ដើម ភាគ តិច រហូតដល់ ១០ក្រុម ស្នើ នឹង ៧០ % នៃ ប្រជាជន សរុប នៃ ខេត្ត ៕
មេធាវី ទិត សុខ វណ្ណា ចេញ លិខិត បដិសេធ ចំពោះ សំណុំរឿង អនុវត្ត ដោយ បង្ខំ របស់ សាលាដំបូង ខេត្ត ព្រះសីហនុ
( ភ្នំពេញ ) ៖ លោក ទិត សុខ វណ្ណា ជា សមាជិក នៃ គណៈមេធាវី កម្ពុជា នា ថ្មី ៗ នេះ បាន ចេញ លិខិត មួយ ដើម្បី បដិសេធ ចំពោះ សំណុំរឿង អនុវត្ត ដោយ បង្ខំ លេខ ២៩ ចុះ ថ្ងៃទី ០២ ខែវិច្ឆិកា ឆ្នាំ ២០១៥ របស់ សាលាដំបូង ខេត្ត ព្រះសីហនុ ។
ខាងក្រោម នេះ ជា លិខិត បដិសេធ ទាំងស្រុង របស់ មេធាវី ទិត សុខ វណ្ណា ៖ អ្នកនាំពាក្យ អាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ចេញមុខ បំភ្លឺ ករណី យក សម្លៀកបំពាក់ កីឡា ក្លែងក្លាយ ដុត បំផ្លាញ ចោល . បើ យក ទៅ ចែកចាយ ឬ ធ្វើជា អំណោយ ស្នើ នឹង គាំទ្រ ផលិតផល ក្លែងក្លាយ
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស លោក ឧត្តមសេនីយ៍ ត្រី អេង ហ៊ី បាន បំភ្លឺ ជូន សាធារណជន ជុំវិញ ករណី កងរាជអាវុធហត្ថ ក្រោយ ការឯកភាព ពី តំណាង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន ធ្វើ ការដុត បំផ្លាញ ចោល នូវ សម្លៀកបំពាក់ កីឡា ក្លែងក្លាយ ដែល បង្ក្រាប បាន នា ពេល កន្លងទៅ ។
លោក ឧត្ដមសេនីយ៍ ត្រី អេង ហ៊ី បាន បញ្ជាក់ ទៀត ថា ក្នុង ករណី ដូច មហាជន បាន លើកឡើង ថា ឲ្យ សម្លៀកបំពាក់ កីឡា ទាំងអស់ នោះ ទៅ ចែកចាយ ឬ ធ្វើជា អំណោយ ផ្សេង នោះ មាន ន័យ ថា សមត្ថកិច្ច ឬ សហភាព សហព័ន្ធ កីឡា បាល់ទាត់ កម្ពុជា គាំទ្រ នូវ ការ ផលិតផល ក្លែងក្លាយ ទាំងអស់ នោះ ។
អ្នកនាំពាក្យ កងរាជអាវុធហត្ថ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំបាទ ឧត្តមសេនីយ៍ ត្រី អេង ហ៊ី អ្នកនាំពាក្យ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស សូម ធ្វើ ការឆ្លើយតប ជាមួយ បងប្អូន សាធារណជន ដែល បាន បញ្ចេញមតិ យោបល់ ពាក់ព័ន្ធ នឹង ការដុត បំផ្លាញ ចោល សម្លៀកបំពាក់ ក្លែង បន្លំ ពាណិជ្ជសញ្ញា សេវា សញ្ញា ម៉ាក សមូហភាព ពាណិជ្ជនាម និយាយ ជា រួ ម គឺ សម្លៀកបំពាក់ ក្លែងក្លាយ រូប សញ្ញា សហព័ន្ធ កីឡា បាល់ទាត់ កម្ពុជា ដែល ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ នេះ ។
ជា បឋម ខ្ញុំបាទ សូម អរគុណ ចំពោះ មតិ យោបល់ របស់ បងប្អូន សាធារណជន ទាំងអស់ នៅក្នុង ការផ្សព្វផ្សាយ ព័ត៌មាន របស់ កងរាជអាវុធហត្ថ នា ពេល កន្លងទៅ ខ្ញុំបាទ សុំ ទទួលយក នូវ មតិ យោបល់ ទាំងនេះ ។
សូម បងប្អូន មេត្តា ពិចារណា មើល បន្តិច ថា បើ យើង យក សម្លៀកបំពាក់ ទាំងអស់ នេះ ទៅ ចែកចាយ ឬ ចែក អំណោយ ជូន ទៅ អ្នកដទៃ នោះ មាន ន័យ ថា សមត្ថកិច្ច ឬ សហព័ន្ធ កីឡា បាល់ទាត់ កម្ពុជា គាំទ្រ នូវ ផលិតផល ក្លែងក្លាយ នោះ ។
ដោយសារ មាន ការគិតគូរ វែងឆ្ងាយ និង ស្រប តាម ផ្លូវ ច្បាប់ ផង សហព័ន្ធ កីឡា បាល់ទាត់ កម្ពុជា បាន ស្នើសុំ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ធ្វើ ការបំផ្លាញ ចោល នូវ សម្លៀកប ពាក់ ដែល ចាប់ យក ចំនួន ២. ៤៥៣កំប៉្លេ កាលពី ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ » ។
ជាង នេះ ទៅ ទៀត លោកស្រី បាន បញ្ជាក់ ថា ជាក់ស្ដែង នៅ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ ម្សិលមិញ នេះ ក្រសួង សុខាភិបាល បាន រៀបចំ សិក្ខាសាលា មួយ ស្ដីពី « ការណែនាំ ការប្រឡង ប្រណាំង មណ្ឌល សុខភាព ក្នុង កម្មវិធី ការគ្របដណ្ដប់ សុខភាព ជា សកល » ដែល ធ្វើឡើង នៅ ក្រុង កំពង់ចាម ខេត្ត កំពង់ចាម ដោយ មាន ការសហការ គ្នា រវាង នាយកដ្ឋាន មន្ទីរពេទ្យ ជាមួយ អង្គការ សុខភាព ពិភពលោក ហើយ កម្មវិធី នេះ គឺ គ្របដណ្ដប់ សុខភាព ជា សកល នៃ ខេត្ត ចំនួន ៣ កំពង់ធំ . កំពង់ស្ពឺ និង កំពត ។
កម្មវិធី នេះ ក៏ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ នាយកដ្ឋាន មជ្ឈមណ្ឌល ជាតិ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ធំ កំពត កំពង់ស្ពឺ ការិយាល័យ ស្រុក ប្រតិបត្តិ កំពង់ធំ កំពង់ត្រា ច ភ្នំ ស្រួច និង មណ្ឌល សុខភាព ចំនួន ៤២ ដែល ស្ថិត នៅក្រោម ស្រុក ប្រតិបត្ត ទាំង បី នៃ ខេត្ត ទាំង៣ ព្រមទាំង តំណាង អង្គការ សុខភាព ពិភពលោក សរុប ចំនួន ១០២ នាក់ ។
លោកស្រី រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន គូសបញ្ជាក់ ថា « ការកែលម្អ គុណភាព សេវា សុខាភិបាល មាន សារសំខាន់ ណាស់ ក្នុង មូលដ្ឋាន សុខាភិបាល សាធារណៈ ទាំងអស់ ជាពិសេស ការលើកកម្ពស់ គុណភាព សេវា កាន់តែ ប្រសើរឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ជា កិច្ចការ ដែល យើង ទាំងអស់ គ្នា ត្រូវ ធ្វើជា ប្រចាំ ដោយ មិន បង្អែរបង្អង់ ឡើយ » ។
បន្ថែម ពីលើ នេះ លោកស្រី បាន សង្កត់ធ្ងន់ លើ សូចនាករ ចំនួន ២១ ដែល បាន ដាក់ចេញ សម្រាប់ ការប្រឡង ប្រណាំង មណ្ឌល សុខភាព តាំងពី ខែមេសា ឆ្នាំ ២០១៧ ដែល ការងារ អនាម័យ ស្អាត និង ត្រួតពិនិត្យ ការចម្លង រោគ នៅ តាម មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ ជា សមាសធាតុ ចាំបាច់ ដែល មិន អាច ខ្វះ បាន ផងដែរ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ លោកស្រី បាន សំណូម ឱ្យ បុគ្គលិក សុខាភិបាល ទាំងអស់ ជួយ អប់រំ ទៅដល់ ប្រជាជន នៅ តាម មូលដ្ឋាន របស់ ខ្លួន អំពី ការថែរក្សា សុខភាព តាមរយៈ ការអនុវត្ត អនាម័យ រស់ នៅ ស្អាត ហូប ស្អាត និង បរិស្ថាន ល្អ ចេះ ការពារ ខ្លួន កុំ ឲ្យ កើត ជំងឺ ឆ្លង និង ការការពារ ជំងឺ មិន ឆ្លង ដោយ អនុវត្ត ការបន្ថយ ការញាំ អាហារ កុំ ប្រៃ ពេក កុំ ផ្អែម ពេក និង កុំ មាន ជាតិ ខ្លាញ់ ច្រើន ពេក ហើយ បង្កើន ការធ្វើ លំហាត់ប្រាណ ជាប់ ប្រចាំ ។
( សៀមរាប ) ៖ ប្រធាន នាយកដ្ឋាន គ្រប់គ្រង សន្តិសុខ ឯកជន លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខារស្មី លើកឡើង ថា យើង ទាំងអស់ គ្នា ត្រូវ រួមគ្នា ថែរក្សា ការពារ ឲ្យបាន ដាច់ខាត នូវ ភាព សុខសាន្ត របស់ ប្រជាពលរដ្ឋ ក្នុង នោះ វិស័យ សន្តិសុខ ឯកជន ក៏ ជា វិស័យ មួយ ដ៏ សំខាន់ ក្នុង ការរួមចំណែក ថែរក្សា សុវត្ថិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ។
ក្នុង ពិធី បិទ វគ្គ បំប៉ន ជំនាញ ភ្នាក់ងារ សន្ដិសុខ ឯកជន លើក ទី ១៤ នៅ ល្ងាច ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ នេះ នៅ ខេត្ត សៀមរាប លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខា រស្មី បាន បញ្ជាក់ ថា ក្រោម គោល នយោបាយ ឈ្នះ ឈ្នះ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើឲ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព ស្ថេរភាព និង រីកចម្រើន ឥត ឈប់ឈរ លើ គ្រប់ វិស័យ នេះ ក៏ ព្រោះតែ ការដឹកនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន ។
ភាពរីកចម្រើន ទាំងអស់ នេះ ទាមទា ឲ្យ ប្រជាពលរដ្ឋ និង សមត្ថកិច្ច ទាំងអស់ ត្រូវ រួមគ្នា ការពារ ឲ្យបាន ដាច់ខាត នូវ ការ ប៉ុនប៉ន ណាមួយ ពីសំណាក់ ក្រុម ជ្រុលនិយម ដែល តែងតែ មាន ចេតនា ចង់ បំផ្លេច បំផ្លាញ សុខ សន្តិភាព ដែល រកបាន ដោយ កម្ររ នេះ ។
លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខា រស្មី បាន បញ្ជាក់ ថា ភ្នាក់ងារ សន្ដិសុខ ឯកជន ជា កម្លាំង ជំនួយ ដល់ កងកម្លាំង នគរបាល ជាតិ និង ជា អ្នកការពារ ថែរក្សា សន្ដិសុខ សុវត្ថិភាព សណ្ដាប់ធ្នាប់ នៅនឹង កន្លែង ផ្ទាល់ ជាមួយ ប្រជាពលរដ្ឋ ដូច្នេះ បើ ភ្នាក់ងារ សន្ដិសុខ ឯកជន មាន វិជ្ជាជីវៈ ច្បាស់លាស់ នោះ វា នឹង ធ្វើឲ្យ ប្រសើរឡើង នូវ ការចូលរួម ថែរក្សា សន្ដិសុខ បាន យ៉ាង ល្អ ប្រសើរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន សរសេរ យ៉ាង ដូច្នេះ ថា៖ « ទោះបី រវល់ ប៉ុណ្ណា ក៏ដោយ គឺ ការនឹក រឮ ក របស់ ខ្ញុំ មាន ជាប់ ជាមួយ បងប្អូន និង កូនក្មួយ គ្រប់ ៗ គ្នា ។ សង្ឃឹម ថា ថ្ងៃ នេះ បងប្អូន បាន សប្បាយរីករាយ ជាមួយនឹង ក្រុមគ្រួសារ ទាំង នៅក្នុង ទីក្រុង និង ក្នុង ដំណើរកំសាន្ត ទៅកាន់ តំបន់ រមណីយដ្ឋាន នានា ។ ប្រទេស យើង មាន សុខ សន្តិភាព និង កាន់តែ ឆ្ពោះ ទៅរក ភាពល្អ ប្រសើរ ជា វិជ្ជមាន ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។ ឯករាជ ភាព ទាំង នយោបាយ និង សេដ្ឋកិច្ច គឺ ធ្វើឱ្យ កម្ពុជា យើង កាន់តែ រឹងមាំ និង រីកចម្រើន » ។
សម្តេច បាន ថ្លែងអំណរគុណ ដល់ ជន រួម ជាតិ ទាំងអស់ ដែល បាន ចូលរួម ថែរក្សា សន្តិភាព ដើម្បី គ្រប់ ៗ គ្នា មាន ឱកាស និង ប្រទេសជាតិ កាន់តែ រីកចម្រើន រុងរឿង ។
ឆ្លៀត ក្នុង ឱកាស នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន អំពាវនាវ ដល់ អ្នកបើកបរ ទាំងអស់ ត្រូវ មាន សុជីវធម៌ គុណធម៌ និង គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា ៕
ក្រុមហ៊ុន ព្រូដិនសល ចុះ MoU ជាមួយ ធនាគារ អេស៊ីលីដា ដើម្បីឱ្យ អតិថិជន អាច បង់ ធានារ៉ាប់រង អាយុជីវិត តាម សេវា អេស៊ីលីដា យូនី ធី ទាន់ចិត្ត
