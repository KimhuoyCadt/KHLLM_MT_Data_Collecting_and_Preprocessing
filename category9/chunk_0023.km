( ស្ទឹងត្រែង ) ៖ ក្រុម ប្រជាពលរដ្ឋ ដែរស់ នៅក្នុង ខេត្ត ស្ទឹងត្រែង បាន ទទូច សុំ ឱ្យ លោក គឹម ប្រុស ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ស្ទឹងត្រែង គួរតែ ចាត់ វិធានការ ឱ្យ បាន តឹងរឹង បំផុត ក្នុង ការចុះ ត្រួតពិនិត្យ គុណភាព ចំណីអាហារ និង ទំនិញ គ្រប់ ប្រភេទ ដែល ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ លក់ដូរ និង បរិភោគ ដែល នាំឱ្យ ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ ។
ពាក់ព័ន្ធ នឹង កង្វល់ របស់ ប្រជាពលរដ្ឋ ទៅ លើ បញ្ហា ចំណីអាហារ និង ផលិតផល ហូបចុក នោះ ប្រជាពលរដ្ឋ ទាំងអស់ ក៏ បាន លើកឡើង ថា ក្នុង នាម ជា មន្ត្រី ជំនាញ មិន ត្រូវ ធ្វើឡើង ដោយ គ្រាន់តែ បង្គ្រប់ កិច្ច ផ្គាប់ ចិត្ត និង បំពេញ របាយការណ៍ ជូន ថ្នាក់ លើ នោះ ឡើយ ។
ប្រជាពលរដ្ឋ បន្ត ថា អ្វី ដែល ត្រូវ តែ ត្រួតពិនិត្យ ដោយ ខាន មិន បាន នោះ គឺ ពេល មាន ការដាក់ តាំង លក់ ផលិតផល និង ទំនិញ គ្រប់ ប្រភេទ ដែល នាំចូល ពី ក្រៅ ប្រទេស យកមក លក់ តាម ស្តង់ ឬ តូប នៅក្នុង ពិធី បុណ្យ ទាន នានា នៅក្នុង ដែនដី ខេត្ត ស្ទឹងត្រែង ភាគ ឦសាន ប្រទេស មួយ នេះ ដែល ប្រជាពលរដ្ឋ ភាគ ច្រើន យល់ដឹង នៅ មាន កម្រិត ក្នុង ការពិនិត្យ និង ជ្រើសរើស យក ទំនិញ ដែល គ្មាន ជាតិ ប៉ូរ៉ាក់ « ទំនិញ ហួស ដាលេ គ្មាន គុណភាព » យកមក បរិភោគ និង ប្រើប្រាស់ ដែល នាំឱ្យ រង ការប៉ះពាល់ ដល់ សុខ មាលភាព ប្រជាពលរដ្ឋ ៕
ជូនដំណឹង ! បេឡា ជាតិ អតីត យុទ្ធជន នឹង បើក ប្រាក់ របប សន្តិសុខ សង្គម ប្រចាំ ខែមេសា និង ប្រាក់ ឧបត្ថម្ភ បុណ្យ ចូល ឆ្នាំ ខ្មែរ ជូន អតីត យុទ្ធជន និង គ្រួសារ អតីត យុទ្ធជន ចាប់ពី ម៉ោង ២រសៀល ថ្ងៃទី ១០ ខែមេសាត ទៅ
( ភ្នំពេញ ) ៖ បេឡា ជាតិ អតីត យុទ្ធជន នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង បើក ប្រាក់ របប សន្តិសុខ ប្រចាំ ខែមេសា ឆ្នាំ ២០១៩ និង ប្រាក់ ឧបត្ថម្ភ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ ជូន អតីត យុទ្ធជន គ្រប់ ប្រភេទ និង គ្រួសារ អតីត យុទ្ធជន ចាប់ពី ម៉ោង ០២រសៀល ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០១៩ត ទៅ តាម ប្រព័ន្ធ ធនាគារ កាណាឌីយ៉ា និង ធនាគារ អេស៊ីលីដា នៅ ទូទាំង ប្រទេស ។
ប្រធាន ក្រុមប្រឹក្សាភិបាល បេឡា ជាតិ អតីត យុទ្ធជន៖ អតីត មន្ត្រីរាជការ ស៊ីវិល និង អតីត យុទ្ធជន ទទួលបាន ការ បន្ថែម របប សន្តិសុខ សង្គម ជា បន្តបន្ទាប់ ពី រាជ រដ្ឋាភិបាល កម្ព ជា
( ភ្នំពេញ ) ៖ លោក សំហេង បុរស រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ បេឡា ជាតិ អតីត យុទ្ធជន បាន លើកឡើង ថា អតីត មន្ត្រីរាជការ ស៊ីវិល និង អតីត យុទ្ធជន ទទួលបាន ការ បន្ថែម របប សន្តិសុខ សង្គម ជា បន្តបន្ទាប់ពី រាជ រដ្ឋាភិបាល កម្ព ជា ។ បន្ថែម ពីលើ នេះ រាជ រដ្ឋាភិបាល ក៏ បាន ផ្តល់ ប្រាក់ ឧបត្ថម្ភ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ កុរ ឯកស័ក ព .ស . ២៥៦២ ចំនួន ៥ម៉ឺន រៀល ក្នុង ម្នាក់ ៗ ផងដែរ ។
ការលើកឡើង របស់ លោក សំហេង បុរស បាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ ក្រុមប្រឹក្សាភិបាល នៃ បេឡា ជាតិ អតីត យុទ្ធជន លើក ទី ១៤ អាណត្តិ ទី៣ នាទី ស្តីការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ ។
លោក សំហេង បុរស បាន លើកឡើង ទៀត ថា យោង តាម អនុក្រឹត្យ លេខ ៤៨ អន ក្រ. បក ស្តីពី ការបន្ថែម របប សន្តិសុខ សង្គម សម្រាប់ អតីត មន្ត្រីរាជការ ស៊ីវិល និង អតីត យុទ្ធជន ត្រូវបាន កែប្រែ និង ដំឡើង ដូច ខាងក្រោម៖
របប សន្តិសុខ សង្គម សម្រាប់ អតីត មន្ត្រីរាជការ ស៊ីវិល និង អតីត យុទ្ធជន ប្រចាំ ខែ ដែល បាន កំណត់ ក្នុង ខាងលើ នឹង ត្រូវ អនុវត្ត ចាប់ពី ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០១៩ ។ លោក សំហេង បុរស បាន បន្ថែម ថា នេះ គឺជា ផ្តល់ ការលើកទឹកចិត្ត និង ជា ការបង្ហាញ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន យកចិត្តទុកដាក់ ខ្ពស់ ដល់ បងប្អូន អតីត មន្ត្រីរាជការ ស៊ីវិល និង អតីត យុទ្ធជន ។ ការផ្តល់ ជូន របស់ រាជ រដ្ឋាភិបាល នា ពេលនេះ នឹង កាន់តែ ធ្វើឲ្យ បងប្អូន អតីត មន្ត្រីរាជការ ស៊ីវិល និង អតីត យុទ្ធជន មាន ជីវភាពល្អ ប្រសើរ ជាង មុន ផងដែរ ។
នៅក្នុង ឱកាស នោះ ផងដែរ លោក ប្រធាន ក្រុមប្រឹក្សាភិបាល ក៏ បាន ប្រកាស សមាសភាព លោក ហុង ហ៊ាន ជា នាយក បេឡា ជាតិ អតីត យុទ្ធជន ផងដែរ ។
( ស្វាយរៀង ) ៖ លោក តូច ប៉ូលីវ៉ា អភិបាល រង ខេត្ត ស្វាយរៀង បាន ថ្លែង ទៅ មន្ត្រី សុខាភិបាល ជាច្រើន រូប នៅក្នុង អង្គ សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០១៨ និង ទិសដៅ ការងារ ឆ្នាំ ២០១៩ របស់ មន្ទីរ សុខាភិបាល ខេត្ត ស្វាយរៀង នា ព្រឹក ថ្ងៃទី ៩ ខែមេសា ឆ្នាំ ២០១៩ នេះ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន តម្កល់ ទុក សុខភាព ប្រជាពលរដ្ឋ ជា កត្តា ចម្បង សម្រាប់ អភិវឌ្ឍ ធនធាន មនុស្ស វឌ្ឍនភាពសង្គម និង សេដ្ឋកិច្ច ប្រកបដោយ និរន្តរភាព ។
នៅក្នុង ពិធី មាន ការចូលរួម ពី វេជ្ជបណ្ឌិត កែ រដ្ឋា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត និង អស់ លោក លោកស្រី ជា ប្រធាន មន្ទីរពេទ្យ ប្រតិបត្តិ ស្រុក ក្រុង មណ្ឌល សុខភាព នៅ ទូទាំង ខេត្ត ស្វាយរៀង ផងដែរ ។
លោក អភិបាល រង ខេត្ត ស្វាយរៀង បាន ថ្លែង ទៀត ថា វឌ្ឍនភាព ដែល មន្ទីរ សុខាភិបាល សំរេច បាន នៅក្នុង ឆ្នាំ ២០១៨ បាន ឆ្លុះបញ្ចាំង ពី ភាព កាន់តែ ប្រសើរឡើង នៃ សុខភាព ប្រជាពលរដ្ឋ ក្នុង នោះ រួម ទាំង ការគ្របដណ្តប់ សេវា គាំពារ សុខភាព មាតា និង ទារ ក សុខភាព កុមារ អត្រា នៃ ការចាក់ ថ្នាំ បង្កា ជំងឺ ផ្សេង ៗ កើនឡើង និង អត្រា ធ្លាក់ចុះ នៃ ជំងឺ នានា ព្រមទាំង ការ លុបបំបាត់ ឱសថ ក្លែង ក្លាយ និង សេវា សុខាភិបាល ឯកជន ខុស ច្បាប់ ផងដែរ ។
លោក តូច ប៉ូលីវ៉ា បាន បញ្ជាក់ ថា ជុំវិញ សមិទ្ធផល ដែល យើង សំរេច បាន ក៏ យើង នៅ មាន ការប្រឈម ជាច្រើន ទៀត ដែល ត្រូវ ប្រយុទ្ធ ប្រឆាំង ដើម្បី ធ្វើឲ្យ វិស័យ សុខាភិបាល កាន់តែ មាន ភាពរីកចម្រើន ផ្តល់ នូវ ជំនឿ ទុកចិត្ត ពី ប្រជាពលរដ្ឋ កាន់តែ ខ្លាំង មក លើ ប្រពន្ធ័ សុខាភិបាល របស់ យើង ធ្វើឲ្យ វិស័យ នេះ រឹតតែ មាន តួនាទី សកម្ម ថែម ទៀត ក្នុង ការរួមចំណែក កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ ។
លោក អភិបាល រង ខេត្ត បាន បន្ត ទៀត ថា ដើម្បី ជំរុញ ឲ្យ វិស័យ សុខាភិបាល បាន ទទួល ជោគជ័យ កាន់តែ ធំ ធេង ថែម ទៀត នោះ ទាមទារ ឲ្យ មន្ទីរ សុខាភិបាល ត្រូវ មាន កិច្ចសហការ ឲ្យបាន រលូន ជាមួយ ស្ថាបន័ពាក់ ពន្ធ័ ជាពិសេស អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ ។
ក្នុង ន័យ នេះ វិស័យ សុខាភិបាល សាធារណៈ និង ឯកជន ត្រូវ ដើរ តួនាទី ជា ដៃគូរ អភិវឌ្ឍន៍ និង ប្រាស្រ័យ ទំនាក់ទំនង ល្អ ជាមួយគ្នា ទៅ វិញ ទៅ មក ហើយ ត្រូវ ខិតខំ លុបបំបាត់ ភាព អនាធិបតេយ្យ លើ វិស័យ នេះ ដែល ជា ហេតុ ធ្វើអោយ ប៉ះពាល់ សុខភាព និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ។
ក្នុង នោះ មន្ទីរ សុខាភិបាល ត្រូវ ខិតំពង្រឹង គុណភាព ធនធាន មនុស្ស ឲ្យបាន ខ្លាំងក្លា ថែម ទៀត នៅ ថ្នាក់ មណ្ឌល សុខភាព ដែល ជា កម្រិត មួយ នៅ គៀក នឹង ប្រជាពលរដ្ឋ ជាង គេ ។ ដូច្នេះ ត្រូវ រៀបចំ បែងចែក និង គ្រប់គ្រង ធនធាន មនុស្ស ឲ្យបាន ល្អ ដើម្បី ធានា ថា ធនធាន មនុស្ស គ្រប់ កម្រឹត បច្ចេកទេស សម្រាប់ បំរើ វិស័យ សុខាភិបាល ប្រកបដោយ ប្រសិទ្ធភាព នៅ គ្រប់ លំដាប់ បណ្តាញ សុខាភិបាល ទាំង ទីក្រុង និង ជនបទ ៕
លោក ឧកញ៉ា ទៀ វិចិត្រ៖ ខេត្ត ព្រះសីហនុ ត្រៀមលក្ខណៈ រួច ជាស្រេច ដើម្បី ទទួល ភ្ញៀវ មក ទស្សនា ព្រឹត្តិការណ៍ « សង្ក្រាន្ត សមុទ្រ » នៅ ខេត្ត ព្រះសីហនុ
លោក ឧកញ៉ា ទៀ វិចិត្រ បាន បន្ត ថា ក្នុង ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណីយ៍ ជាតិ ខ្មែរ ដែល នឹង ចូល មកដល់ នៅ ពាក់កណ្តាល ខែមេសា ខាងមុខ នេះ ខាង វិស័យ ឯកជន ដែល បើក បំរើ សេវា ដឹកជញ្ជូន ភ្ញៀវ ចេញ ទៅ ម្សាន្ត តាម បណ្ដា កោះ មួយចំនួន នា ខេត្ត ព្រះសីហនុ គឺ បាន ត្រៀមលក្ខណៈ រួច ជាស្រេច រង់ចាំ បំរើ តាម សេចក្តីត្រូវការ របស់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ។
លោក ឧកញ៉ា ទៀ វិចិត្រ ដែល ជា ប្រធាន ក្រុម មនុស្ស ធ៌ម អូរ បី (O3) និង ជា ម្ចាស់ « ម៉ាហ្វីយ៉ារី ស្សត » មាន ទីតាំង នៅ ឆ្នេរ ភ្លោះ កោះ ឋានសួគ៌ នៅ សង្កាត់ កោះ រ៉ុង ក្រុង - ខេត្ត ព្រះសីហនុ ផងដែរ នោះ បញ្ជាក់ ថា បច្ចុប្បន្នភាព នៃ គោលដៅ ទេសចរណ៍ នៅ តាម បណ្តា កោះ មួយចំនួន នា ខេត្ត ព្រះសីហនុ គឺ មាន ការអភិវឌ្ឍ ប្រកបដោយ សោភ័ណភាព អនាម័យ និង មាន បរិស្ថាន ល្អ គួរ ជា ទី គយគន់ មុន ចេះ ជិនណាយ ពីសំណាក់ ភ្ញៀវ ទេសចរ នៅ គ្រប់ រដូវកាល ។
ត្រង់ ចំណុច នេះ លោក ឧកញ៉ា ទៀ វិចិត្រ បញ្ជាក់ ថា រាល់ ថ្ងៃ នេះ ប្រតិបត្តិករ ឬ វិស័យ ឯកជន បើក បម្រើ សេវា លើ វិស័យ ទេសចរណ៍ នៅ តាម បណ្តា កោះ មួយចំនួន គឺ ពួកគេ បាន រៀបចំ តុបតែង ទី កន្លែង រៀង ៗ ខ្លួន មាន បរិស្ថាន អនាម័យ និង មាន សោភ័ណភាព ល្អ និង រក្សា សុវត្ថិភាព សន្តិសុខ ជូន ភ្ញៀវ ទេសចរ មាន ការទទួលខុសត្រូវ ខ្ពស់ ព្រោះ បាន សហការ ជាមួយ កម្លាំង អាជ្ញាធរ មាន សមត្ថកិច្ច ចម្រុះ នៅ តាម មូលដ្ឋាន នីមួយ ៗ ជាប្រចាំ ។
លោក ឧកញ៉ា ទៀ វិចិត្រ បញ្ជាក់ ថា បច្ចុប្បន្នភាព នៃ ឆ្នេរ កោះ ឋានសួគ៌ ឆ្នេរ ភ្លោះ កោះ រ៉ុង គឺ មាន បំរើ ទាំង ចំណីអាហារ និង កន្លែង ស្នាក់ នៅ ជូន ដល់ ភ្ញៀវ ទេសចរ ដោយឡែក « ម៉ាហ្វីយ៉ារី ស្សត » ក៏ មាន បំរើ នូវ ឧបករណ៍ កម្សាន្ត ជាច្រើន ប្រភេទ ទៀត សម្រាប់ ផ្តល់ ជម្រើស សប្បាយរីករាយ ជូន ភ្ញៀវ ទេសចរ ទាំង ជាតិ និង អន្តរជាតិ ដែល បាន ធ្វើដំណើរ មកដល់ កោះ នេះ ។
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន លើកឡើង ថា ក្រសួង សាធារណការ កំពុង ធ្វើការ ជាមួយនឹង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដើម្បី រក វិធី ដោះស្រាយ លើ ការកាត់ ឈ្មោះ កម្មសិទ្ធិ យានយន្ដ ឲ្យ កាន់តែ មាន ភាពងាយស្រួល ដល់ ម្ចាស់ រថយន្ដ ទាំងអស់ ។
ការលើកឡើង របស់ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ទេសរដ្ឋមន្ដ្រី អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ ត្រួតពិនិត្យ លទ្ធផល ការងារ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ប្រចាំ ត្រីមាស ទី១ ឆ្នាំ ២០១៩ ក្រោម អធិបតីភាព សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក នា ព្រឹក ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០១៩ នេះ ។
ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « បងប្អូន ប្រជាពលរដ្ឋ របស់ យើង មិន ចង់ ដូរ ទេ ដោយសារតែ ដូរ ទៅ ត្រូវ បង់ប្រាក់ ប្រហែល៤ ភាគរយ តម្លៃ នៃ ការដូរ កម្មសិទ្ធិ ហើយ វា មាន ផល ពិបាក ផង ដូច្នេះ ក្រសួង សាធារណការ កំពុង ធ្វើការ ជាមួយ ក្រសួង សេដ្ឋកិច្ច ដើម្បី តភ្ជាប់ ប្រព័ន្ធ ពន្ធដារ ជាមួយ ប្រព័ន្ធ Online របស់ ក្រសួង ធ្វើ តែ មួយ កន្លែង បាន ហើយ គាត់ អាច ដូរ ឈ្មោះ កម្មសិទ្ធិ របស់ គាត់ បាន » ។
លោក រដ្ឋមន្ដ្រី បាន បន្ថែម ទៀត ថា ក្រសួង សាធារណការ និង ក្រសួង សេដ្ឋកិច្ច ក៏ កំពុងតែ ពិភាក្សា គ្នា ឲ្យ មាន ការយក កម្រៃ ទាប ចំពោះ ប្រជាពលរដ្ឋ ណា ដែល មាន មិន ទាន់ មក កាត់ ឈ្មោះ ផងដែរ ក្នុង រយៈពេល ៣ខែ ។ លោក បន្ដ ថា ក្នុង រយៈពេល ៣ខែ នេះ លោក ក៏ ចង់ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ម្ចាស់ រថយន្ដ ទាំងអស់ មក ធ្វើ បច្ចុប្បន្នភាព អំពី ទីលំនៅ របស់ គាត់ បើ មិន ដូច្នេះ នៅ ពេល ដែល ផាក ពិន័យ រក មិន ឃើញ នោះ ទេ ។
ជាមួយគ្នា នោះ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ក៏ បាន ស្នើឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ម្ចាស់ រថយន្ដ ទាំងអស់ ដែល មាន ស្លាកលេខ ចាស់ សូមអញ្ជើញ មក ប្ដូរ យក ស្លាកលេខ ថ្មី ដែល មាន QR Code ដើម្បី មាន សិទ្ធិ រក្សាទុក ស្លាកលេខ របស់ ខ្លួន នៅ ពេល ដែល លក់ រថយន្ដ ៕ ដំណឹង មរណភាព ! សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា លោក ម៉ោញ កុសល ទទួលមរណភាព ក្នុង ជន្មាយុ ៧០ ឆ្នាំ
សូម បញ្ជាក់ ថា លោក ម៉ោញ កុសល ធ្លាប់ ជា សមាជិក សភា ពីរ អាណត្តិ គឺ ពី ឆ្នាំ ១៩៩៣ - ១៩៩៨ និង ចាប់ពី ឆ្នាំ ១៩៩៨ - ២០០៣ ។ លោក ក៏ ធ្លាប់ ជា អតីត អភិបាល ខេត្ត កំពង ស្ពឺ និង អភិបាល ខេត្ត បន្ទាយមានជ័យ មុនពេល បោះឆ្នោត សកល ឆ្នាំ ១៩៩៣ ផងដែរ ហើយ មុនពេល ទទួលមរណភាព លោក ជា សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ផងដែរ ៕ អ្នកនាំពាក្យ ការបរទេ ស៖ កម្ពុជា -UN នឹង បើក កិច្ចសន្ទនា ប្រចាំ ឆ្នាំ នៅ ខែ ក្រោយ
( ភ្នំពេញ ) ៖ កិច្ចសន្ទនា ប្រចាំ ឆ្នាំ រវាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ក្រុមការងារ របស់ អង្គការ សហ ប្រជាជាតិ (UN team) នឹង ធ្វើឡើង នា ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០១៩ ខាងមុខ នេះ នៅ រាជធានី ភ្នំពេញ ។ នេះ បើ យោង តាម លោក កេត សោ ផាន់ អ្នកនាំពាក្យ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ។
លោក បន្ថែម ថា នៅក្នុង កិច្ចសន្ទនា ប្រចាំ ឆ្នាំ រវាង ប្រមុខ ដឹកនាំ កំពូល រាជ រដ្ឋាភិបាល កម្ពុជា និង ក្រុមការងារ UN កម្ពុជា ក៏ នឹង លើក ប្រធានបទ ចំនួន ៣ ដើម្បី ស្នើសុំ ឲ្យ ក្រុមការងារ UN ជួយ សហការ ដែរ ។ ប្រធានបទ ទាំងនោះ រួម មាន៖ ទី ១៖ ការការពារ សង្គម . ទី ២៖ ទន្និន័យ សម្រាប់ ការអភិវឌ្ឍ និង ទី៣៖ របាយការណ៍ ប្រចាំ ឆ្នាំ មួយ របស់ ប្រទេស កម្ពុជា ដែល របាយការណ៍ ទាំង នេះ នឹង ត្រូវ ដាក់ ជូន ទៅ UN នៅ ទីក្រុង ញ៉ូវយ៉ក នៅ ខែកក្កដា ខាងមុខ នេះ ។
លោក កេត សោ ផាន់ បាន ឲ្យដឹង ថា តប តាម ការស្នើសុំ របស់ មន្ត្រី ជាន់ ខ្ពស់ UN ប្រមុខ ការទូត កម្ពុជា បាន បញ្ជាក់ នូវ ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ថា កម្ពុជា នឹង បន្ត កិច្ចសហប្រតិបត្តិការ ជាមួយ UN ជារៀងរហូត ជាពិសេស នឹង គាំទ្រ កិច្ចសន្ទនា ប្រចាំ ឆ្នាំ រវាង សម្តេច តេជោ ហ៊ុន សែន និង ក្រុមការងារ UN នា ពេល ខាងមុខ នេះ ផងដែរ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន បញ្ជាក់ នូវ ការគាំទ្រ យ៉ាង រឹងមាំ ថា នឹង បន្ត កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ នេះ ដល់ ពេល អនាគត ហើយ ជាពិសេស នៅ ថ្ងៃទី ០៦ ខែឧសភា នេះ ជា កិច្ចសន្ទនា ប្រចាំ ឆ្នាំ រវាង សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង ក្រុមការងារ UN» ៕ ល្ងាច នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ពិសា ភោជនាហារ ជាមួយ ថ្នាក់ដឹកនាំ និង សមាជិក សមាគម សម្ព័ន្ធ ខ្មែរ - ចិន
( ភ្នំពេញ ) ៖ នៅ ល្ងាច ថ្ងៃអង្គារ ៥កើត ខែ ចេត្រ ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស ២៥៦២ ត្រូវនឹង ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នឹង អញ្ជើញ ពិសារ ភោជនាហារ ជាមួយ ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា សមាគម សម្ព័ន្ធ ខ្មែរ - ចិន នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ ។
លោក ឧកញ៉ា ពុង ឃាវ សែ ប្រធាន សមាគម សម្ព័ន្ធ ខ្មែរ - ចិន នៅ កម្ពុជា បាន ឱ្យដឹង ថា ជំនួប ពិសា ភោជនា ហារ រវាង សម្តេច តេជោ ជាមួយ សមាគម នៅ ល្ងាច ថ្ងៃ នេះ គឺជា ការពិសា ភោជនាហារ លើក ទី៣ ហើយ ។ ឧកញ៉ា ពុង ឃាវ សែ ចាត់ទុក ការការអញ្ជើញ ចូលរួម ពិសា ភោជនា ហារ របស់ សម្តេច តេជោ ហ៊ុន សែន ជាមួយ ថ្នាក់ដឹកនាំ និង សមាជិក សមាគម គឺជា ផ្តល់ កិត្តិយស ដ៏ ថ្លៃថ្លា សម្រាប់ សមាគម ។ ជាពិសេស បង្ហាញ ពី ការយកចិត្តទុកដាក់ ចំពោះ ក្រុម អ្នក វិនិយោគ ពាណិជ្ជករ និង ធុរ ជន ដែល កំពុង រកស៊ី នៅ កម្ពុជា ។
ការជួប ពិសា ភោជនា ហារ នា ពេលនេះ ក៏ ជា ឱកាស ទទួលបាន នូវ អនុសាសន៍ បន្ថែម ទៀត ពី សម្តេច តេជោ ហ៊ុន សែន សម្រាប់ ការវិនិយោគ នៅ កម្ពុជា ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក ពុង ឃាវ សែ ។
បើ តាម លោក ពុង ឃាវ សែ សមាគម សម្ព័ន្ធ ខ្មែរ - ចិន នៅ កម្ពុជា បាន រួមចំណែក ធ្វើ សកម្មភាព ជាច្រើន នៅក្នុង ឆ្នាំ ២០១៨ កន្លងទៅ ដើម្បី គាំទ្រ ដល់ ការរកស៊ី របស់ ខ្មែរ - ចិន នៅ កម្ពុជា ហើយក៏ បាន ធ្វើ សកម្មភាព មនុស្សធម៌ ច្រើន ផងដែរ ។
ទន្ទឹម នឹង នោះ សមាគម បាន ឧបត្ថម្ភ ប្រាក់ខែ ដល់ គ្រូបង្រៀន ក្រីក្រ ដែល បង្រៀន នៅ សាលា ចិន ទូទាំង ប្រទេស . ផ្តល់ មូលនិធិ ដល់ មជ្ឈមណ្ឌល បណ្តុះបណ្តាល គ្រូបង្រៀន លើកកម្ពស់ ការអប់រំ ភាសា ចិន នៅ តាម មូលដ្ឋាន និង បណ្តុះបណ្តាល អ្នកជំនាញ ភាសា ចិន ផងដែរ ។
ក្រៅពី នេះ ទៀត សមាគម បាន ទាក់ទង យ៉ាង សកម្ម ជាមួយ សមាគម ពាណិជ្ជកម្ម និង ស្ថាប័ន វិនិយោគ ផ្សេង ៗ និង បាន ផ្តល់ ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ គណៈប្រតិភូ មកពី ទូទាំង ពិភពលោក ដើម្បី បម្រើ និង ដើរ តួនាទី ជា ស្ពាន តភ្ជាប់ អ្នក មាន សែ ស្រឡាយ ចិន នៅ កម្ពុជា ឲ្យ មាន ទំនាក់ទំនង និង សហប្រតិបត្តិការ ជាមួយ ប្រទេស ចិន និង ទូទាំង ពិភពលោក ៕ អគ្គ នាយក ធនាគារ អភិវឌ្ឍន៍ ជនបទ ជំរុញ ឲ្យ យុវជន លេង កីឡា ឲ្យបាន ច្រើន ខិតខំ រៀនសូត្រ ធ្វើជា ពលរដ្ឋ ល្អ ជៀស ឆ្ងាយ ពី គ្រឿងញៀន
លោក កៅ ថា ច បាន កោតសរសើរ និង ថ្លែងអំណរគុណ ដល់ អាជ្ញធរ ស្រុក ដែល បាន រៀបចំ ការប្រកួត កីឡា បាល់ទាត់ នេះ ឡើង ក្នុង បរិកាស ល្អ មាន សណ្តាប់ធ្នាប់ និង មាន វិន័យ ក្នុង ការប្រកួត ។
លោក បាន លើកទឹកចិត្ត ដល់ យុវជន ចូលរួម លេង កីឡា ឲ្យបាន ច្រើន ព្រោះ ការលេង កីឡា នាំមក នូវ សុខភាព មាន សាមគ្គីភាព និង ធ្វើឲ្យ យុវជន មាន សន្តិភាព ផ្លូវចិត្ត ។ លោក អំពាវនាវ ដល់ យុវជន ត្រូវ ខិតខំ រៀនសូត្រ ធ្វើជា ពលរដ្ឋ ល្អ ជៀស ឆ្ងាយ ពី គ្រឿងញៀន និង ត្រូវ ចូលរួម អភិវឌ្ឍន៍ សង្គមជាតិ ម្យ៉ាងទៀត ក្នុង នាម យុវជន ត្រូវ ចូលរួម រក្សា សុខ សន្តិភាព ដែល រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេចបាន ។
រដ្ឋមន្រ្តី សាយ សំអាល់ ជំរុញ ឲ្យ អាជ្ញាធរ ខេត្ត ស្រុក ក្រុង នៅក្នុង ខេត្ត ព្រះសីហនុ ប្រែក្លាយ និង កសាង ខ្លួន ជា រដ្ឋបាល ទំនើប
( ព្រះសីហនុ) ៖ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត ព្រះសីហនុ បាន ជំរុញ ឲ្យ អាជ្ញាធរ ខេត្ត ស្រុក ក្រុង នៅក្នុង ខេត្ត ព្រះសីហនុ ប្រែក្លាយ និង កសាង ខ្លួន ជា រដ្ឋបាល ទំនើប ក៏ ដូចជា ចេះដឹកនាំ សេដ្ឋកិច្ច នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ដើម្បី បម្រើ និង ឆ្លើយតប នឹង បំណង ដ៏ ពិសិដ្ឋ របស់ បងប្អូន ប្រជាពលរដ្ឋ ។
ស្រុក កំពង់សិលា ជា ស្រុក មួយ ក្នុង ចំណោម ស្រុក ក្រុង ទាំង ៥ ខេត្ត ព្រះសីហនុ ដែល ពោរពេញ ដោយ សក្តានុពល ដែល មាន តំបន់ សេដ្ឋកិច្ច ពិសេស ក សិឧស្សាហកម្ម ការដាំ ដើម អាកាស្យា ចម្ការ ផ្លែ ឈើ និង ចម្ការ ដូង ប្រេង ព្រមទាំង មាន រោងចក្រ ជាច្រើន ទៀត ។
លោក សាយ សំអាល់ បាន មានប្រសាសន៍ ថា៖ « ក្នុង ការងារ គ្រប់គ្រង មូលដ្ឋាន របស់ ខ្លួន អាជ្ញាធរ ត្រូវ ប្រែក្លាយ និង កសាង ខ្លួន ជា រដ្ឋបាល ទំនើប និង ចេះដឹកនាំ សេដ្ឋកិច្ច ក្នុង មូលដ្ឋាន របស់ ខ្លួន ដោយ ត្រូវ ស្គាល់ ថា តើ កន្លែងណា ខ្លះ ជា ប្រភព សេដ្ឋកិច្ច របស់ ខ្លួន និង ធ្វើ ការរៀបចំ ផែនការ ឱ្យ បាន ត្រឹមត្រូវ និង គ្រប់ ជ្រុងជ្រោយ ដើម្បី ទាញ ផល នៃ ការអភិវឌ្ឍ សម្រាប់ ការអភិវឌ្ឍ មូលដ្ឋាន ។
រដ្ឋមន្ត្រី បាន មានប្រសាសន៍ ថា៖ « យើង ទាំងអស់ គ្នា ត្រូវ រួមគ្នា គិតគូរ ដើម្បី ទាញយក ផល នៃ ការអភិវឌ្ឍ ក្នុង គោលដៅ ដើម្បី រក្សា កំណើន សេដ្ឋកិច្ច ជាតិ ក្នុង រង្វង់ ៧% ក្នុង មួយ ឆ្នាំ បង្កើត ការងារ ធ្វើ សម្រាប់ ពលរដ្ឋ កម្ពុជា កាត់បន្ថយ ភាពក្រីក្រ បង្កើន ចំណូល ជីវភាព របស់ ប្រជាជន និង ធានា នូវ ការអភិវឌ្ឍ ប្រកបដោយ និរន្តរភាព » ។
ប្រធាន ក្រុមការងារ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត ព្រះសីហនុ បាន គូសបញ្ជាក់ យ៉ាង មុតមាំ ថា ខេត្ត ព្រះសីហនុ ត្រូវ បញ្ចប់ ជម្លោះ ដីធ្លី ដែល រ៉ាំរ៉ៃ ជា យូរ មកហើយ ឱ្យ បាន ទាំងស្រុង ។ លោក ថ្លែង ថា « មិន ត្រូវ ឱ្យ កើតឡើង នូវ ជម្លោះ ថ្មី ៗ ទៀត ឡើយ និង ត្រូវ ខិតខំ ប្រឹងប្រែង ដោះស្រាយ ជម្លោះ ដីធ្លី ចាស់ ឱ្យ បាន បញ្ចប់ ទាំងស្រុង » ។
ទាក់ទង នឹង បញ្ហា ទឹក សាប សម្រាប់ ប្រើប្រាស់ នៅក្នុង ខេត្ត ព្រះសីហនុ លោក សាយ សំអាល់ បាន លើកឡើង ថា ត្រូវតែ រក្សា ប្រភព ទឹក សាប នៅក្នុង តំបន់ នានា ក្នុង ខេត្ត ព្រះសីហនុ ដើម្បី រក្សា ឱ្យ បាន គង់វង្ស នូវ ប្រភព ទឹក សម្រាប់ ប្រើប្រាស់ ឱ្យ បាន យូរអង្វែង ក៏ ដូចជា ការផលិត ទឹក និង ការចែកចាយ ទឹក ស្រប តាម តម្រូវការ របស់ ប្រជាពលរដ្ឋ និង អាជីវកម្ម នានា នៅក្នុង ខេត្ត ព្រៃ សីហនុ នេះ ។
រដ្ឋមន្ត្រី ប្រធាន ក្រុមការងារ ក៏ បាន ថ្លែង ថា ករណី ដូចគ្នា នេះ ក៏ ត្រូវ អនុវត្ត ផងដែរ ចំពោះ ការគ្រប់គ្រង ចរន្ត អគ្គិសនី ក៏ ដូចជា ប្រព័ន្ធ លូ និង ការគ្រប់គ្រង សំណល់ រឹង សំរាម ។ ដើម្បី គ្រប់គ្រង អនាម័យ បរិស្ថាន ខេត្ត ព្រះសីហនុ ឱ្យ បាន ល្អ ស្អាត រដ្ឋមន្ត្រី បាន ស្នើ ឱ្យ គ្រប់ ស្ថាប័ន ពាក់ព័ន្ធ រួម នឹង បងប្អូន ប្រជាពលរដ្ឋ រួម នឹង ម្ចាស់ អាជីវកម្ម ទីកន្លែង កម្សាន្ត នានា នៅក្នុង ក្រុង ព្រះសីហនុ រួម សហការ សម្អាត អនាម័យ បរិស្ថាន និង ទុកដាក់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ ។
( ភ្នំពេញ ) ៖ ដើម្បី ចូលរួម អបអរ ពិធី បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ ខាងមុខ នេះ ធនាគារ ឯកទេស វីង ( ខេមបូឌា ) លីមីធីត បាន ធ្វើ ការសហការ ជាមួយ ក្រុមហ៊ុន សែល កាត និង ក្រុមហ៊ុន ទឹក បរិសុទ្ធ អារុណា ចែកជូន កាដូ រាប់ ពាន់ ដល់ អតិថិជន ដែល គាំទ្រ ផលិតផល និង សេវាកម្ម របស់ វីង ។
ការផ្តល់ ជូន នេះ ប្រព្រឹត្ត ឡើង នៅ ខាងមុខ ការិយាល័យ កណ្តាល នៃ ធនាគារ ឯកទេស វីង ក៏ ដូចជា ក្រុមហ៊ុន សែល កាត ចាប់ពី ថ្ងៃទី ០៨ ដល់ ថ្ងៃទី ១២ ខែមេសា ដោយ ធនាគារ ឯកទេស វីង នឹង ផ្តល់ ជូន អតិថិជន នូវ ទឹក បរិសុទ្ធ អារុណា រាប់ ពាន់ កេស សម្រាប់ អតិថិជន ដែល បាន ធ្វើ ប្រតិបត្តិការ យ៉ាងហោចណាស់ ៣ដុល្លារ តាមរយៈ គណនី វីង ចាប់ពី ថ្ងៃទី ០១ ខែមេសា ដល់ ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០១៩ ។
ដើម្បី ទទួលបាន កាដូ នេះ អតិថិជន គ្រាន់តែ ស្វែងរក បុគ្គលិក វីង ដែល កំពុង រង់ចាំ នៅ ស្តង់ វីង នៅ តាម ទីតាំង ខាងលើ ណាមួយ និង បង្ហាញ ប្រតិបត្តិការ ចុងក្រោយ របស់ ពួកគេ លើកលែងតែ ការដាក់ ប្រាក់ និង ទូទាត់ វិក្កយបត្រ ភ្លើង ក្រោម ២៥ ដុល្លារ ។ រាល់ ប្រតិបត្តិការ តាមរយៈ គណនី វីង ចាប់ពី ០៣ ដុល្លារ ឡើង ទៅ អាច ធ្វើ ការប្តូរ ជា កាដូ ទឹក បរិសុទ្ធ អារុណា ចំនួន មួយ កេស ។
លោក ចូចូ ម៉ាឡូឡូស អគ្គ នាយក ធនាគារ ឯកទេស វីង បាន ថ្លែង ថា វា គឺជា គោលបំណង របស់ ធនាគារ ក្នុង ការធានា ថា ក្រៅពី ការនាំយក ផលិតផល និង សេវាកម្ម ប្រកបដោយ ភាពច្នៃប្រឌិត ដែល អាច ជួយ ធ្វើឲ្យ ប្រសើរឡើង នូវ ជីវភាព ប្រចាំ ថ្ងៃ រាល់ អតិថិជន របស់ វីង នឹង អាច នាំយក នូវ កាដូ ដ៏ គួរឲ្យ ចងចាំ នេះ ពេល ពួកគេ ធ្វើដំណើរ ទៅកាន់ ស្រុក កំណើត ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ខ្មែរ ។
ក្រៅពី ទទួលបាន ទឹក បរិសុទ្ធ អារុណា ដោយ ឥត គិត ថ្លៃ អតិថិជន ដែល មកកាន់ ទីតាំង ទាំង ពីរ ក៏ អាច ទទួលបាន កាដូ ជាច្រើន ផងដែរ នៅពេល ពួកគេ ចុះឈ្មោះ ប្រើប្រាស់ ស៊ីម សែល កាត ។ លើស ពី នេះ ទៅ ទៀត ពួកគេ អាច រីករាយ ជាមួយ ការបញ្ចុះ តម្លៃ ជាច្រើន ប្រសិនបើ ពួកគេ ធ្វើ ការទិញ ទឹក បរិសុទ្ធ អារុណា បន្ថែម ៕
មន្ដ្រី ជាន់ ខ្ពស់ សុខាភិបាល ជំរុញ គ្រូពេទ្យ ទូទាំង ប្រទេស ផ្ដល់ ប្រឹក្សា ឱ្យ សុក្រឹត ដល់ អ្នកជំងឺ និង គ្រួសារ អ្នកជំងឺ ដើម្បី លើកកម្ពស់ ចំណេះដឹង សុខភាព
( ភ្នំពេញ ) ៖ ក្រៅពី គុណភាព ផ្ដល់ សេវា សុភាព ជូន ប្រជាពលរដ្ឋ ក្នុង នាម ជា គ្រូពេទ្យ ត្រូវតែ ព្យាយាម ពន្យល់ ណែនាំ ផ្ដល់ ប្រឹក្សា ដល់ អ្នកជំងឺ ពិសេស គ្រួសារ អ្នកជំងឺ ឱ្យ យល់ ពី ស្ថានភាព ជំងឺ ការថែរក្សា ការព្យាបាល ពិសេស សុខភាព នៃ ការរស់នៅ ប្រចាំ របស់ ពួកគាត់ ។ នេះ បើ តាម ការលើកឡើង របស់ លោកស្រី វេជ្ជបណ្ឌិត ឱ វណ្ឌ ឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល ។
លោកស្រី រដ្ឋលេខាធិការ បាន ថ្លែង បន្ដ ថា ការអប់រំ ផ្ដល់ ប្រឹក្សា ដល់ អ្នកជំងឺ និង គ្រួសារ របស់ គេ គឺជា ផ្នែក មួយ ដ៏ សំខាន់ ដើម្បី បញ្ជៀប ការយល់ដឹង ពី សុខភាព និង អនាម័យ ក្នុង ការរស់នៅ ប្រចាំ ថ្ងៃ របស់ គាត់ ដែល អាច ជៀស ផុត ពី ជំងឺ នានា ៗ ផងដែរ ។
លោកស្រី វេជ្ជបណ្ឌិត បាន ថ្លែង បញ្ជាក់ ទៀត ថា « ដើម្បី លើកកម្ពស់ ចំណេះដឹង សុខភាព និង ឱ្យ ប្រជាពលរដ្ឋ ទទួលបាន សុខភាព ល្អ ពិសេស នៅ តាម ទី ដាច់ស្រយាល ធ្វើ ម៉េច យើង ត្រូវ ខិតខំ អប់រំ ណែនាំ ដល់ ពួកគាត់ ឱ្យ ច្រើន ដើម្បី ផ្លាស់ប្ដូរ ឥរិយោប ថ ក្នុង ការរស់នៅ ប្រកបដោយ សុខុមាលភាព ទោះ ត្រូវ ទាមទារ ពេលវេលា យូរ ក៏ដោយ ក៏ យើង ត្រូវតែ ចូលរួម ទាំងអស់ គ្នា ទើប ការងារ ដែល យើង អនុវត្ដន៍ ទៅ នេះ នឹង ផ្ដល់ អត្ថប្រយោជន៍ ខ្ពស់ ជូន ដល់ ប្រជាពលរដ្ឋ » ។
លោកស្រី វេជ្ជបណ្ឌិត ក៏ បាន ផ្តាំផ្ញើ ដល់ បុគ្គលិក មន្ត្រី សុខាភិបាល គ្រប់ ជាន់ ថ្នាក់ និង ស្ថាប័ន ពាក់ព័ន្ធ ផ្តល់ ការគាំទ្រ និង សហការ ឲ្យបាន ល្អ ប្រសើរ ក្នុង ការអនុវត្ត គម្រោង សុខភាព ទាំង ពីរ នេះ ក៏ ដូចជា គម្រោង និង អន្តរាគមន៍ នានា ដែល មាន ស្រាប់ នៅក្នុង ភូមិសាស្រ្ត របស់ ខ្លួន ពេល ត្រលប់ ទៅកាន់ មូលដ្ឋាន វិញ ចូលរួមចំណែក ក្នុង ការលើកកម្ពស់ គុណភាព និង ប្រសិទ្ធភាព នៃ ការផ្តល់ សេវា ថែទាំ សុខភាព ឆ្លើយតប ទៅ តាម តម្រូវការ របស់ ប្រជាជន ។
( ភ្នំពេញ ) ៖ សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា បាន ផ្ញើ សារលិខិត ជូន ពរ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ឆ្នាំ កុរ ឯកស័ក ពុទ្ធ សករាជ ២៥៦៣ នា ពេល ខាងមុខ នេះ ។
សម្ដេច ពញា ចក្រី ហេង សំរិន ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី
( ភ្នំពេញ ) ៖ សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា បាន ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ សូម ក្រាបបង្គំទូល ថ្វាយ សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ក្នុង សេរីភាព សេចក្តីថ្លៃថ្នូរ និង សុភមង្គល ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ នា ឱកាស ដ៏ មហាន ក្ខត្ត ឫក្ស នៃ ព្រះរាជ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ឆ្នាំ កុរ ឯកស័ក ពុទ្ធ សករាជ ២៥៦៣ ។
ខាងក្រោម នេះ ជា លិខិត ថ្វាយ ព្រះពរ របស់ សម្ដេច ពញា ចក្រី ហេង សំរិន៖
មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង ព័ត៌មាន៖ កម្ពុជា មាន សារព័ត៌មាន បោះពុម្ព ផ្សាយ ៦៥០ អង្គភាព ក្នុង នោះ មាន ភាសា ខ្មែរ ៤១១ អង្គភាព និង បរទេស ២៥ អង្គភាព
( ភ្នំពេញ ) ៖ លោក ផុស សុវណ្ណ ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ព័ត៌មាន និង សោត ទស្សន៍ ក្រសួង ព័ត៌មាន បាន លើកឡើង ថា បច្ចុប្បន្ន កម្ពុជា មាន សារព័ត៌មាន បោះពុម្ព ផ្សាយ សរុប មាន ចំនួន ៦៥០ អង្គភាព ដោយ ក្នុង នោះ កាសែត ផ្សាយ ជា ភាសា ខ្មែរ ៤១១ អង្គភាព និង កាសែត ផ្សាយ ជា ភាសា បរទេស ២៥ អង្គភាព ។
លោក ផុស សុវណ្ណ បាន បញ្ជាក់ ថា « នៅ កម្ពុជា វិស័យ ប្រព័ន្ធ ផ្សព្វផ្សាយ មាន ការរីកចម្រើន គួរឲ្យ កត់សម្គាល់ ហើយ បច្ចុប្បន្ន សារព័ត៌មាន បោះពុម្ព ផ្សាយ សរុប មាន ចំនួន ៦៥០ អង្គភាព ក្នុង នោះ កាសែត ផ្សាយ ជា ភាសា ខ្មែរ ៤១១ អង្គភាព កាសែត ផ្សាយ ជា ភាសា បរទេស ២៥ អង្គភាព ទស្សនាវដ្ដី ១៩៤ អង្គភាព និង ព្រឹត្ត បត្រ ព័ត៌មាន ២០ អង្គភាព » ។
លោក ថា ការិយាល័យ ទីភ្នាក់ងារ សារព័ត៌មាន បរទេស ការិយាល័យ តំណាង វិទ្យុ - ទូរទស្សន៍ បរទេស ប្រចាំ ការអចិន្ត្រៃយ៍ សរុប មាន ចំនួន ២១ អង្គភាព ដែល ក្នុង នោះ ក៏ មាន ផងដែរ វិទ្យុ អន្តរជាតិ ចិន (CRI) និង អង្គភាព សារព័ត៌មាន ចិន ជាច្រើន ផ្សេង ទៀត ផងដែរ ។ ក្រៅពី នេះ មាន ស្ថាប័ន រដ្ឋ និង ឯកជន របស់ ចិន ជាច្រើន ផងដែរ ដែល បាន និង កំពុង ធ្វើ កិច្ចសហប្រតិបត្តិការ ជាច្រើន ជាមួយ ក្រសួង ព័ត៌មាន កម្ពុជា ។
អគ្គ នាយកដ្ឋាន ព័ត៌មាន និង សោត ទស្សន៍ ក្រសួង ព័ត៌មាន រូប នេះ បាន គូសបញ្ជាក់ ថា តាមរយៈ ការរីកចម្រើន ខាង វិស័យ ព័ត៌មាន និង សោត ទស្សន៍ នេះ គឺ បាន បញ្ជាក់ ឲ្យ ពិភពលោក បាន ដឹង ថា រាជ រដ្ឋាភិបាល កម្ពុជា គាំទ្រ លើ សេរីភាព សារព័ត៌មាន ។
កម្ពុជា ក៏ បាន ត្រៀម រៀបចំ ធ្វើ វិសោធនកម្ម ច្បាប់ ស្តីពី របប សារព័ត៌មាន ត្រៀម រៀបចំ តាក់តែង ច្បាប់ ស្តីពី សោត ទស្សន៍ ច្បាប់ ស្តីពី ការផ្សព្វផ្សាយ ពាណិជ្ជកម្ម និង ជំរុញ គាំទ្រ ការគោរព ជំនាញ វិជ្ជាជីវៈ សារព័ត៌មាន ដើម្បី ធានា បាន សារព័ត៌មាន កាន់តែ មាន ប្រសិទ្ធភាព និង ប្រកបដោយ វិជ្ជាជីវៈ ក្នុង ការចូលរួមចំណែក អភិវឌ្ឍន៍ ប្រទេសជាតិ ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក ផុស សុវណ្ណ ។
លោក ថា ដូច្នេះ តាមរយៈ កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ នានា ដើម្បី ជំរុញ ការអភិវឌ្ឍ ប្រទេស ធានា បាន យូរអង្វែង រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ នូវ គោល នយោបាយ គាំពារ និង លើកកម្ពស់ បង្ក លក្ខណៈ ងាយស្រួល ដល់ វិនិយោគិន បរទេស ដែល ក្នុង នោះ មាន ទាំង វិនិយោគិន និង ប្រជាជន ចិន ជាច្រើន ហើយ ការប្រើប្រាស់ ភាសា ចិន នៅ កម្ពុជា កាន់តែ មាន ការយកចិត្តទុកដាក់ ខ្ពស់ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ៕
អគារ វិទ្យាសាស្ត្រ និង មជ្ឈមណ្ឌល បណ្តុះ ធុរកិច្ច ថ្មី « តេជោ » បាន បើក ដំណើរ ជា ផ្លូវការ
ចំណែក មជ្ឈមណ្ឌល បណ្តុះ ធុរកិច្ច ថ្មី « តេជោ » ត្រូ បាន បង្កើតឡើង ជាមួយនឹង បេសកកម្ម បង្កើត និង បណ្តុះ ធុរកិច្ច ថ្មី ឱ្យ លូតលាស់ ក្លាយជា អាជីវកម្ម ជោគជ័យ តាមរយៈ ការអនុវត្ត គោលការណ៍ ន វានុវត្តន៍ និង បច្ចេកវិទ្យា ថ្មី ជឿនលឿន ក្រោម កម្មវិធី គាំទ្រ ច្បាស់លាស់ ដើម្បី រួមចំណែក ក្នុង ការអភិវឌ្ឍ សហគ្រិន និង ការលើកកម្ពស់ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា និង ដើម្បី ជំរុញ ការធ្វើ ពិពិធកម្ម សេដ្ឋកិច្ច និង ការអភិវឌ្ឍ ប្រភព កំណើន សេដ្ឋកិច្ច គន្លឹះ និង ថ្មី ៗ រួមទាំង វិស័យ សេដ្ឋកិច្ច ឌីជីថល ផង ។
មជ្ឈមណ្ឌល នេះ នឹង បន្ត ពង្រីក វិសាលភាព សកម្មភាព ការងារ របស់ ខ្លួន និង ធ្វើ កិច្ចសហការ ជាមួយ គ្រឹះស្ថាន ឧត្តម សិក្សា និង គ្រឹះស្ថាន បណ្តុះបណ្តាល ដ៏ទៃ ទៀត ផងដែរ ដើម្បី ផ្តល់ ឱកាស ដល់ គ្រប់ និស្សិត ឱ្យ ទទួលបាន នូវ សេវា និង ធនធាន របស់ មជ្ឈមណ្ឌល ៕
គួរ ជម្រាប ថា សហរដ្ឋ អាមេរិក បាន និង កំពុង ប្រើប្រាស់ គោល នយោបាយ ដាក់ សម្ពាធ សេដ្ឋកិច្ច និង ការទូត ប្រឆាំង នឹង រដ្ឋាភិបាល វេណេស៊ុយអេឡា ដើម្បី គាំទ្រ មេ បក្ស ប្រឆាំង វេណេស៊ុយអេឡា លោក ហ្ស៊ាន ហ្គៃដូ (Juan Guaido) ដែល រដ្ឋបាល លោក ដូណាល់ ត្រាំ បាន ទទួលស្គាល់ ជា ប្រធានាធិបតី ស្តីទី នៃ ប្រទេស អាមេរិក ឡាទីន មួយ នេះ ។ ជា ការឆ្លើយតប នឹង ទង្វើ របស់ អាមេរិក រដ្ឋាភិបាល លោក ម៉ាឌូរ៉ូ ក៏ បាន សម្រេច កាត់ផ្តាច់ ចំណត ការទូត និង នយោបាយ ជាមួយ សហរដ្ឋ អាមេរិក ៕
លោក សំ សុខ នាង អ្នកគ្រប់គ្រង ការអភិវឌ្ឍ អាជីវកម្ម របស់ Proseth Solutions បាន លើកឡើង ថា បច្ចុប្បន្ន សេដ្ធ កិច្ច បែប ឌីជីថល មាន ការរីកចម្រើន ខ្លាំង ដែល នាំឲ្យ មាន ការផ្លាស់ប្តូរ គំរូ អាជីវកម្ម និង បង្កើត នូវ តម្រូវការ ថ្មី ៗ សម្រាប់ វិស័យ IT ។ ដើម្បី ពន្លឿន ល្បឿន អាជីវកម្ម និង ការប្រកួតប្រជែង នៅលើ ទីផ្សារ IT ត្រូវតែ មាន តួនាទី សំខាន់ នៅក្នុង អាជីវកម្ម ដើម្បី ច្នៃប្រឌិត នាំយក កម្មវីធី ថ្មី ៗ ចូល ទៅក្នុង ទីផ្សារ ឲ្យបាន លឿន ផ្តល់ ជូន នូវ តំរូវការ និង បទពិសោធន៍ ថ្មី ៗ ដែល ធ្វើឲ្យ អតិថិជន ពេញចិត្ត ។
លោក ថា ដើម្បីឲ្យ សម្រេចបាន នូវ គោលដៅ ទាំងអស់ នេះ IT ត្រូវតែ មាន លទ្ធភាព ក្នុង ការដាក់ពង្រាយ ហេដ្ឋារចនាសម្ព័ន និង កម្មវិធី ឲ្យបាន រហ័ស ។
ជា ចុងក្រោយ នេះ លោក ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ អតិថិជន ដែល បាន អញ្ជើញ ចូលរួម ជា ភ្ញៀវ កិត្តិយស នៅក្នុង សិក្ខាសាលា នេះ ។ លោកសង្ឃឹម យ៉ាង មុតមាំ ថា អតិថិជន ទាំងអស់ នឹង ទទួលបាន នូវ ចំណេះដឹង ថ្មី ៗ រួម ជាមួយ បច្ចេកវិទ្យា ទំនើប ៗ របស់ ក្រុមហ៊ុន Cisco និង ក្រុមហ៊ុន Veeam ដែល ជា ដំណោះស្រាយ ដ៏ ល្អ បំផុត ក្នុង ការជួយ បង្កើន អាជីវកម្ម ឲ្យ កាន់តែ រីកចម្រើន ៕ សម្តេច ពញា ចក្រី ហេង សំរិន ផ្ញើ សារលិខិត ជូន ជន រួម ជាតិ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ
នៅក្នុង សារលិខិត សម្តេច ពញា ចក្រី ហេង សំរិន បាន ឱ្យដឹង ថា ឆ្នាំ ចាស់ ផ្លាស់ ជំនួស វិញ នូវ ឆ្នាំ ថ្មី បាន នឹង កំពុង ប្រព្រឹត្តទៅ ក្នុង បរិយាការណ៍ ដែល ប្រជាជន កម្ពុជា កំពុង រស់ នៅក្នុង ភាពសុខដុមរមនា មាន សិទ្ធិ សេរីភាព ពេញលេញ សម្បូរសប្បាយ និង ពោរពេញ ទៅ ដោយ មោទនភាព ក្រៃលែង ចំពោះ សមិទ្ធផល ទាំងឡាយ ដែល យើង ទាំងអស់ គ្នា សម្រេចបាន ក្នុង រយៈពេល កន្លងមក នេះ ។
ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សណ្តាប់ធ្នាប់ សង្គម ហើយ ផ្អែក លើ មូលដ្ឋាន នេះ សេដ្ឋកិច្ច ជាតិ សម្រេចបាន កំណើន ខ្ពស់ ជា មធ្យម ជាង ៧ភាគរយ រយៈពេល ពីរ ទស្សវត្ស កន្លងមក នេះ ដែល បាន ធ្វើឱ្យ កម្ពុជា ប្រែក្លាយ ពី ប្រទេស ក្រីក្រ តោកយ៉ាក ដែល មាន ប្រាក់ ចំណូល ទាប ទៅជា « ប្រទេស ដែល មាន ប្រាក់ ចំណូល មធ្យម កម្រិត ទាប » ហើយ កំពុង បន្ត ដំណើរ របស់ ខ្លួន យ៉ាង ស្វាហាប់ ក្នុង ការឈាន ឆ្ពោះទៅជា « ប្រទេស ដែល មាន ចំណូល កម្រិត មធ្យម កម្រិត ខ្ពស់ »៕
ខាងក្រោម នេះ ជាសារលិខិត របស់ សម្តេច ពញា ចក្រី ហេង សំរិន៖
ក្រៅពី ប្រូម៉ូសិន ពិសេស មិន ធ្លាប់ មាន នេះ គម្រោង បុរី ឌឹ ផ្ល រ៉ា ក៏ មាន ការ បន្ថែម ដូចជា ទូរតាំង ទូរទស្សន៍ ទូរតាំង សម្ភារៈ ម៉ាស៊ីន បឺត ផ្សែង និង ទូរចង្ក្រាន បាយ លើ - ក្រោម ដែរ ផ្តល់ ភាពងាយស្រួល និង បន្ថែម ភាពស្រស់ស្អាត ដល់ គេហដ្ឋាន លោក អ្នក មួយ កម្រិត ទៀត ។
បុរី ឌឹ ផ្ល រ៉ា ធ្វើ ការផ្គត់ផ្គង់ ផ្ទះ ទៅ តាម តម្រូវការ ជាក់ស្តែង របស់ អតិថិជន គ្រប់ ស្រទាប់ វណ្ណៈ ក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ជាមួយនឹង ការសាងសង់ អគារ លំនៅ ស្ថាន តាម រយៈ បុរី ដ៏ ទំនើប បំផុត ដែល មាន ការ រចនា ម៉ូត បែប ខ្មែរ និង អឺរ៉ុប រួមបញ្ចូល គ្នា ក្នុង គោលបំណង ផ្តល់ឱ្យ អតិថិជន រស់ នៅក្នុង លំនៅ ស្ថាន ដ៏ ទំនើប មាន គុណភាព និង ប្រកបដោយ សេចក្តីសុខ ក្នុង វីឡា គ្រប់ ប្រភេទ វីឡា និង ផ្ទះល្វែង អាជីវកម្ម ។
រដ្ឋបាល ខេត្ត ក្រចេះ ប្រារព្ធ ពិធី សូត្រ មន្ត ចំរើន សិរី សួស្តី ក្នុង ឱកាស បុណ្យ ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ
( ក្រចេះ ) ៖ រដ្ឋបាល សាលា ខេត្ត ក្រចេះ បាន រៀបចំ ប្រារព្ធ ធ្វើ ពិធី សូត្រ មន្ត ចំរើន សិរី សួស្តី ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ឆ្នាំ កុរ ឯកស័ក ព .ស ២៥៦៣ និង រំលឹក គុណ ដល់ វិញ្ញាណក្ខន្ធ យុទ្ធជន យុទ្ធ នារី ពលី បុព្វហេតុ ការពារ ទឹកដី ជូន ជាតិ មាតុភូមិ ។
ពិធី នេះ ដែរ ធ្វើ នៅ ព្រឹក ថ្ងៃទី ៩ ខែមេសា ឆ្នាំ ២០១៩ ក្រោម អធិបតីភាព លោក វ៉ា ថន អភិបាល ខេត្ត និង លោកស្រី . លោក នូ ភឿង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោកស្រី រួម មន្ត្រីរាជការ កងកម្លាំង គ្រប់ ប្រភេទ ក្នុង ខេត្ត និង តា ជី យាយ ជី ផងដែរ ។
ពិធី នេះ តែងតែ ប្រារព្វ ធ្វើឡើង ជារៀងរាល់ ឆ្នាំ ដោយ មាន ការចូលរួម ពី មន្រ្តី រាជការ សាលា ខេត្ត អង្គភាព ជុំវិញ ខេត្ត ធ្វើ ការបន់ស្រន់ ដើម្បី ឧទ្ទិស កុសល ផល បុណ្យ ជូន ដល់ វិញ្ញា ក្ខន្ធ ជីដូន ជីតា បុព្វការី ជន និង បងប្អូន ប្រជាពលរដ្ឋ ដែល បាន បង់ ជីវិត ក្នុង របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ព្រមទាំង យុទ្ធ ជន យុទ្ធ នារី ដ៏ អង់អាច ក្លាហាន របស់ កម្ពុជា ដែល បាន បាត់បង់ជីវិត ក្នុង បុព្វហេតុ ការពារ ជាតិ មាតុភូមិ ។
ពិតជា ពិសេស មែនទែន ! ដូច្នេះ អតិថិជន ទាំងអស់ នឹង មិន ចាំបាច់ ចំណាយ ថវិកា បន្ថែម ជាមួយនឹង សេវា ជាង តម្លើង ក៏ ដូចជា ខាត ពេលវេលា ក្នុង ការដើរ រក ទិញ គ្រឿង ឬ ជើង ទម្រ សម្រាប់ ភ្ជាប់ ជញ្ជាំង ទៀត នោះ ទេ !
នេះ ជា ឱកាស ដ៏ ល្អ បំផុត ដែល លោក អ្នក អាច ទទួលបាន នូវ ម៉ាស៊ីន ត្រជាក់ ថ្មី ដ៏ ឆ្លាតវៃ ទាន់សម័យ ដែល ត្រូវបាន បំពាក់ នូវ បច្ចេកវិទ្យា កាន់តែ ទំនើប ជួយ សន្សំ សំចៃ ថាមពល បាន កាន់តែ ខ្ពស់ បំផុត កាត់បន្ថយ នូវ សំឡេង រំខាន គុណភាព ល្អ ប្រើប្រាស់ បាន យូរ មិន ប៉ះពាល់ ដល់ បរិស្ថាន ដំណើរការផ្តល់ ភាពត្រជាក់ លឿន កម្ចាត់ មេរោគ ព្រមទាំង មុខងារ សំខាន់ ៗ ជាច្រើន ទៀត ។
បញ្ជា ក់៖ ការថែម ជូន ដ៏ អស្ចារ្យ នេះ ចាប់ផ្តើម ពី ថ្ងៃទី ០៩ មីនា ដល់ ១៣ មេសា ២០១៩ តែ ប៉ុន ណោះ ហើយ រាល់ ផលិតផល សាម សុង ទាំងអស់ គឺ ត្រូវតែ មាន តែ ម បញ្ជាក់ ពី ផលិតផល ផ្លូវការ របស់ ក្រុមហ៊ុន ដោយ មាន ការធានា ត្រឹមត្រូវ ក្នុង ការប្រើប្រាស់ ។
ក្នុង ពិធី ប្រគល់ - ទទួល លោក ជា វ តាយ បាន កោតសរសើរ និង ថ្លែងអំណរគុណ ចំពោះ ក្រុមហ៊ុន « កំពត ឋានសួគ៌ » ដែល បាន ផ្ដល់ ធុង សម្រាម និង ម៉ូតូ ព្រមទាំង ថវិកា ដើម្បី ជា ការរួមចំណែក ជាមួយ រដ្ឋបាល ខេត្ត កំពត ក្នុង ការថែរក្សា អនាម័យ បរិស្ថាន ក៏ ដូចជា ការរួមចំណែក កិច្ចអភិវឌ្ឍ ខេត្ត បាន កាន់តែ រីកចម្រើន ថែម ទៀត សំដៅ លើកស្ទួយ ជីវភាព ប្រជាពលរដ្ឋ បាន កាន់តែ ប្រសើរឡើង ។
ពិសេស ការរួមចំណែក ជាមួយ រដ្ឋបាល ខេត្ត កំពត ដែល បច្ចុប្បន្ន កំពង់តែ តម្រូវការ នូវ ធុង សម្រាម សម្រាប់ ដាក់ តាម ដងផ្លូវ និង សួន សាធារណៈ ក្នុង ក្រុង កំពត នា ឱកាស ដែល រដ្ឋបាល ខេត្ត នឹង ត្រូវ ប្រារព្ធ ធ្វើ នូវ ព្រឹត្តការណ៍ កំពត សង្ក្រាន ដើម្បី អបអរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឈាន មកដល់ ខាងមុខ នេះ ក៏ ដូចជា ការរៀបចំ ព្រឹត្តការណ៍ ពិធី បុណ្យ សមុទ្រ ចុង ឆ្នាំ ២០១៩ នេះ ផងដែរ ។
លោក អភិបាល ខេត្ត ក៏ បាន ជូន ពរ ដល់ ក្រុមហ៊ុន និង សហការី ទទួលបាន នូវ ពរ ទេវតា ឆ្នាំ ថ្មី ខាងមុខ និង ប្រកប ការងារ អាជីវកម្ម រក ស៉ី របស់ ខ្លួន ទទួលបាន ជោគជ័យ ។
ក្នុង ឱកាស នោះ តំណាង ក្រុមហ៊ុន កំពត ស្ថាន សួគ៌ ក៏ បាន សំដែង ការកោតសរសើរ ពី ភាពរីកចម្រើន របស់ ខេត្ត កំពត បច្ចុប្បន្ន និង ពី បំណង ការចូលរួមចំណែក ជាមួយ រដ្ឋបាល ខេត្ត កំពត ដើម្បី លើកកម្ពស់ សោភ័ណភាព និង អនាម័យ បរិស្ថាន ក្រុង កំពត អោយ បាន កាន់តែ មាន ភាពទាក់ទាញ ពិសេស ក្នុង ឱកាស នា កំពត សង្ក្រាន្ត ឆ្នាំ ២០១៩នេះ បាន កាន់តែ ប្រសើរឡើង ថែម ទៀត ផងដែរ ៕
ទឹក បរិសុទ្ធ កម្ពុជា ចំនួន ៤. ៥០០កេស ចែកជូន អ្នកជំងឺ នៅ មន្ទីរពេទ្យ គុន្ធ បុប្ជា ដោយ ឥត គិត ថ្លៃ
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស បាន ចូលរួម សហការ ជាមួយ មន្ទីរពេទ្យ គុន្ធ បុប្ជា ចែក ទឹក បរិសុទ្ធ កម្ពុជា ចំនុះ ១.៥លីត ចំនួន ៤. ៥០០កេស ជូន ដល់ អ្នកជំងឺ នៅ មន្ទីរពេទ្យ គន្ធ បុប្ជា ចាប់ពី ថ្ងៃ នេះ តទៅ ។
កម្មវិធី ចែក ទឹក បរិសុទ្ធ កម្ពុជា នឹង ប្រព្រឹត្តទៅ ចាប់ពី ម៉ោង ៨ព្រឹក រហូតដល់ ម៉ោង ១១ព្រឹក ត្រង់ ទីតាំង កែង ច្រក ចូល ទី៤ នៃ មន្ទីរពេទ្យ គុន្ធ បុប្ជា IV ក្នុង សង្កាត់ ស្រះចក ខណ្ឌ ដូច ពេញ ។
ទឹក បរិសុទ្ធ កម្ពុជា ទាំង ពីរ ប្រភេទ ត្រូវបាន ចែកជូន ដល់ អ្នកជំងឺ សម្រាប់ ទុក ពិសា អំឡុង ពេល សម្រាក ព្យាបាល ក្នុង មន្ទីរពេទ្យ និង ដើម្បី លើកកម្ពស់ សុខុមាលភាព កុមារ និង ការប្រើប្រាស់ ទឹក ស្អាត ផងដែរ ។
សូម បញ្ជាក់ ផងដែរ ថា ទឹក បរិសុទ្ធ កម្ពុជា មាន ២ប្រភេទ គឺ ទឹក បរិសុទ្ធ កម្ពុជា មាន សារធាតុ រ៉ែ សំបូរ ដោយ សារធាតុ រ៉ែ ជំនួយ ឆ្អឹង បំពេញ ជាតិ ទឹក ក្នុង រាងកាយ និង ជួយ ឲ្យ ស្បែក មាន សំណើម រីឯ ទឹក បរិសុទ្ធ កម្ពុជា ទឹក ពិសា ស្តង់ដារ ខ្ពស់ គឺ គ្មាន សារធាតុ រ៉ែ ហើយ ត្រូវបាន បន្សុទ្ធ ១០០ % ដែល អាច ជួយ បំពេញ ជាតិ ទឹក ក្នុង ខ្លួន ធ្វើឲ្យ ស្បែក មាន សំណើម និង អាច ប្រើប្រាស់ ជា ជម្រើស ទឹក បរិសុទ្ធ ដែល មាន គុណភាព ខ្ពស់ សម្រាប់ ឆុង ជាមួយ ម្សៅ ទឹកដោះគោ ទារក ផងដែរ ៕
អធិការ ស្រុក ស្អាង ខេត្ត កណ្ដាល ពង្រឹង កម្លាំង ដើម្បី ការពារ សន្តិសុខ ជូន ប្រជាពលរដ្ឋ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ
បើ យោង តាម លោក ប្រធាន ផ្នែក សណ្តាប់ធ្នាប់ និង ចរាចរ ស្រុក ស្អាង បាន ឲ្យ អ្នកយកព័ត៌មាន ដឹង ថា ដើម្បី មាន ប្រសិទ្ធភាព ខ្ពស់ ក្នុង ការបញ្ជា ដឹកនាំ ការពារ អធិការ រដ្ឋាន ស្រុក ស្អាង បាន រៀបចំ គណៈ បញ្ជាការ ចំនួន ៧ ផ្នែក ដោយ នៅ តាម គោលដៅ នីមួយ ៗ មាន អធិការ រង ម្នាក់ ជា អ្នកទទួលខុសត្រូវ និង ដឹកនាំ បញ្ជា ។
ជាមួយគ្នា នោះ ដែរ ដើម្បី លើកទឹកចិត្ត ដល់ កងកម្លាំង ទាំងអស់ លោក អធិការ បាន ឧបត្ថម្ភ ដល់ ប៉ុស្តិ៍ នីមួយ ៗ ស្រាបៀរ ៥កេស និង ឧបត្ថម្ភ ដល់ កងកម្លាំង ទាំងអស់ នូវ ថវិកា មួយ ចំនួន ផងដែរ ។
( សៀមរាប ) ៖ ក្រសួង ទេសចរណ៍ មាន គម្រោង ជំរុញ ការរៀបចំ តំបន់ ភ្នំ គូលែន ទៅជា « តំបន់ ទេសចរណ៍ វប្បធម៌ ប្រវត្តិសាស្ត្រ និង ធម្មជាតិ » រួមទាំង « ទេសចរណ៍ ផ្សង បែប ផ្សងព្រេង » ដ៏ ទាក់ទាញ ថ្មី មួយ ទៀត នៅ ខេត្ត សៀមរាប - អង្គរ ដើម្បី បំពេញ តម្រូវការ ជូន ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ និង ដើម្បី ចូលរួម អនុវត្ត នូវ យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល ដែល តែងតែ ជំរុញ ឱ្យ មាន ការបង្កើត ផលិតផល ទេសចរណ៍ ថ្មី ៗ បន្ថែម ។
ជាពិត ណាស់ តំបន់ ភ្នំ គូលែន នៃ ខេត្ត សៀមរាប មាន សក្ដានុពល ផ្នែក វប្បធម៌ ប្រវត្តិសាស្ត្រ និង ធម្មជាតិ រួចទៅហើយ ហើយក៏ មាន ភ្ញៀវ ទេសចរ ទៅ ទស្សនា កម្សាន្ត ជាច្រើន ផងដែរ ប៉ុន្តែ មិន ទាន់ មាន ការរៀបចំ ទៅ តាម ស្ដង់ដា ជាតិ និង អន្តរជាតិ នៅឡើយ ។
គណៈកម្មការ អន្តរ ក្រសួង នេះ ក៏ បាន ឯកភាព គ្នា រៀបចំ ផែនការ មេអភិវឌ្ឍន៍ នៅ គោលដៅ ទេសចរ ដ៏ ធំ ៗ ចម្បង សម្រាប់ ឆ្នាំ ២០២០ - ២០៤០ ផងដែរ ក្នុង នោះ មាន គម្រោង អភិវឌ្ឍន៍ រយៈពេល ខ្លី ៥ ឆ្នាំ ( ២០១៨ - ២០២៣) . ផែនការជំរុញ ការរៀបចំ កសាង ហេដ្ឋ រចនាសម្ព័ន្ធ រឹង នៅ ទីក្រុង សៀមរាប ដែល មាន ជាអាទិ៍៖ ការជួសជុល ផ្លូវ ក្នុង ខេត្ត ផ្លូវ ក្រវាត់ ជុំវិញ ក្រុង ការផ្គត់ផ្គង់ ទឹក ស្អាត អគ្គិសនី ការគ្រប់គ្រង សំណល់ រឹង - រាវ សណ្តាប់ធ្នាប់ អនាម័យ ក្នុង ទីក្រុង ។
ព្រម ជាមួយ នោះ អង្គប្រជុំ ក៏ បាន ឯក គ្នា ប្រគល់ ភារកិច្ច ជូន លោក អភិបាល ខេត្ត សៀមរាប ដើម្បី ដឹកនាំ អង្គប្រជុំ សម្របសម្រូល មួយ ដើម្បី ប្រែក្លាយ សហគមន៍ នេសាទ ជ្រាវ ទៅជា សហគមន៍ តាម ស្តង់ដា ជាតិ និង អាស៊ាន ដ៏ ទាក់ទាញ ឱ្យ បាន ឆាប់ រហ័ស ផងដែរ ។
នៅក្នុង អនុសាសន៍ ណែនាំ នោះ ដែរ លោក ថោង ខុន ក៏ បាន ជំរុញ ឱ្យ មាន ការពង្រឹង គុណភាព សេវាកម្ម ទេសចរណ៍ និង ធនធាន មនុស្ស ក្នុង វិស័យ ទេសចរណ៍ ដោយ ត្រូវ ពង្រឹង គុណភាព សាលា បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ ការបណ្តុះបណ្តាល ផ្ទៃក្នុង និង ជំរុញ ការអនុវត្ត ស្តង់ដា អាស៊ាន ក្នុង វិស័យ ទេសចរណ៍ ដោយ ក្នុង នោះ រាជ រដ្ឋាភិបាល បាន បង្កើត ឲ្យ មាន « គណៈកម្មការ ជាតិ ផ្នែក ជំនាញ ទេសចរណ៍ » ដោយ មាន ក្រសួង ទេសចរណ៍ ជា ប្រធាន ហើយ សព្វ ថ្ងៃ កម្ពុជា បាន ដាក់ ឲ្យ អនុវត្ត នូវ កម្មវិធី បណ្តុះបណ្តាល អាស៊ាន លើ ៣២ មុខជំនាញ ។
ម្យ៉ាងទៀត ការត្រៀមលក្ខណៈ សម្បត្តិ ទទួល ភ្ញៀវ ទេសចរ អន្តរជាតិ ដើម្បី ធានា ផលប្រយោជន៍ អតិបរមា ពិសេស ការត្រៀមលក្ខណះ ទទួល ទេសចរ ចិន ដែល នឹង មាន កំណើន យ៉ាង ច្រើន ជារៀងរាល់ ឆ្នាំ ដោយ ត្រូវ អនុវត្តន៍ អោយ បាន ល្អ តាម សៀវភៅ ស្តីពី «China Ready» និង យុទ្ធសាស្រ្ត ទីផ្សារ ដោយឡែក សម្រាប់ ភ្ញៀវ ទេសចរ ចិន ។
លោក ស៊ុន ចាន់ថុល បាន ឱ្យដឹង ថា អ្នក រត់ ម៉ូតូ ឌុប ប្រមាណ ជា ៩៨ ភាគរយ មិន ទាន់ មាន បណ្ណ បើកបរ នៅឡើយ នោះ ទេ ។ លោក បាន អះអាង ថា ការចាត់ វិធានការបង្ខំឱ្យ អ្នក រត់ ម៉ូតូកង់ បី ទៅ រៀន ច្បាប់ ចរាចរណ៍ និង ប្រឡង យក បណ្ណ បើកបរ នេះ ក្នុង គោលបំណង រួមចំណែក កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរ និង ការកកស្ទះ ចរាចរណ៍ ក្នុង រាជធានី ភ្នំពេញ ដែល បណ្តាល មកពី ការ មិន យល់ដឹង ពី ច្បាប់ ចរាចរណ៍ ក្នុង ពេល បើកបរ របស់ ពួកគេ ៕ ក្មួយ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ទទួលមរណភាព ដោយសារ គាំង បេះដូង
ក្មួយ ប្រុស របស់ លោក ខៀវ កាញារីទ្ធ នេះ មាន ឈ្មោះ នាវ នៅ បញ្ញា ពិសិដ្ឋ អនុ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន ។
បើ តាម លោក គឹម គុណ វឌ្ឍ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន បាន បញ្ជាក់ នៅលើ Facebook របស់ លោក ថា លោក នាវ នៅ បញ្ញា ពិសិដ្ឋ ជា មន្រ្តី សកម្ម ម្នាក់ របស់ ក្រសួង ព័ត៌មាន វ័យ ក្មេង ។ លោក បាន ចូលរួម រំលែក ទុក្ខ ជាមួយ ក្រុមគ្រួសារ លោក នាវ នៅ បញ្ញា ពិសិដ្ឋ ផងដែរ ៕ អភិបាល រាជធានី ភ្នំពេញ សំណេះសំណាល ជាមួយ តំណាង សង្គម ស៉ី វិល ៧០០ នាក់ ក្នុង វេទិកា ភាព ជាដៃគូរ វាង អាជ្ញាធរ រាជធានី ភ្នំពេញ និង អង្គការ សង្គម ស៊ីវិល
( ភ្នំពេញ ) ៖ វេទិកា « ភាពជាដៃគូរ វាង អាជ្ញាធរ រាជធានី ភ្នំពេញ និង អង្គការ សង្គម ស៊ីវិល » ត្រូវបាន ប្រារព្ធ ឡើង ជាថ្មី ម្តង ទៀត នៅ ព្រឹក ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០១៩ នេះ នៅ មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម កោះ ពេជ្រ ។
វេទិកា នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង លោក គឹម រ័ត្ន វិសិដ្ឋ ប្រធាន ក្រុមប្រឹក្សាភិបាល វេទិកា សម្ព័ន្ធ សង្គម ស៊ីវិល ដោយ មាន សមាជិក ចូលរួម ប្រមាណ ៧០០ នាក់ មក ពី ក្រសួង ស្ថាប័ន និង អង្គការ សង្គម ស៊ីវិល ប្រមាណ ៣២៥ អង្គការ / សមាគម ។
ក្នុង ឱកាស នោះ លោក ឃួង ស្រេង ក្នុង នាម អាជ្ញាធរ មូលដ្ឋាន បាន ស្នើឲ្យ អង្គការ សង្គម ស៊ីវិល បន្ដ សហការ ជាមួយ អាជ្ញាធរ រាជធានី ភ្នំពេញ ខណ្ឌ សង្កាត់ ដើម្បី ប្រសិទ្ធភាព ការងារ ការពារ ផលប្រយោជន៍ ស្រប ច្បាប់ និង ការពារ ផលប្រយោជន៍ សាធារណៈ ព្រមទាំង លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ក្នុង ភាពជាដៃគូ ព្រមទាំង លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ក្នុង ភាពជា មិត្ដ ជា បងប្អូន ជា ឪពុក ម្ដាយ ជា គ្រូ និង ជា សិស្ស ក្នុង គោលដៅ តែ មួយ គឺ រួមគ្នា បង្កើន ការកសាង សេដ្ឋកិច្ច - សង្គម ឲ្យ ទទួលបាន ការរីកចម្រើន ទៅ ថ្ងៃ អនាគត ៕
កាកបាទ ក្រហម កម្ពុជា ចូលរួម រំលែក ទុក្ខ ដល់ គ្រួសារ សព ស្ដ្រី ម្នាក់ និង ចៅ ស្រី ដែល ទទួលមរណភាព ដោយសារ ឃាតកម្ម យ៉ាង ព្រៃផ្សៃ នៅ ស្រុក ព្រៃឈរ ខេត្ត កំពង់ចាម
ស្ថិត ក្នុង សមាន ទុក្ខ ដ៏ សោក សង្រេង នេះ កាកបាទ ក្រហម កម្ពុជា សូម សម្ដែង នូវ ការសោកស្ដាយ និង ក្ដី អាណិតអាសូរ ជា ទីបំផុត ចំពោះ ការបាត់បង់ សាច់ញាតិ ជា ទីស្រឡាញ់ នៅក្នុង គ្រួសារ និង សូម បួងសួង ដល់ វិញ្ញាណក្ខន្ធ នៃ សព បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ជាមួយគ្នា នេះ កាកបាទ ក្រហម កម្ពុជា បាន នាំយក សម្ភារ ចូល បុណ្យ សព រួម មាន អង្ករ ១០០ គីឡូក្រាម មី ៥កេស ត្រីខ ៥០ កំប៉ុង ទឹកក្រូច ៥កេស និង បច្ច័យ មួយចំនួន ៕ ថ្នាក់ដឹកនាំ គ.ជ. ប កំពុង ចុះ ត្រួតពិនិត្យ ការប្រលង ជ្រើសរើស មន្រ្តី ចុះឈ្មោះ បោះឆ្នោត នៅ តាម បណ្តា ខេត្ត
បើ តាម អ្នកនាំពាក្យ រូប នេះ គឺ ក្នុង មួយ ឃុំ - សង្កាត់ គ.ជ. ប ត្រូវការ ជ្រើសរើស ប្រធាន ក្រុម ចុះឈ្មោះ បោះឆ្នោត ១រូប និង ការី កុំព្យូទ័រ មួយ រូប ដែល នឹង ធ្វើការ ជាមួយ ស្មៀន នៃ ឃុំ - សង្កាត់ ដើម្បី ចុះឈ្មោះ បោះឆ្នោត ប្រចាំ ឆ្នាំ ២០១៩ ចាប់ពី ថ្ងៃទី១ ដល់ ថ្ងៃទី ២២ ខែឧសភា ឆ្នាំ ២០១៩ ។
លោក ឌឹម សុវណ្ណា រុំ បាន បញ្ជាក់ ទៀត ថា៖ នៅ ព្រឹក ថ្ងៃ នេះ គឺជា ការបើក វិញ្ញាសា ប្រលង នៅ ចំពោះមុខ បេក្ខជន ដើម្បី តម្លាភាព និង សុក្រិតភាព ។ គជប បាន គ្រោង ចុះឈ្មោះ អ្នកបោះឆ្នោត ដែល គ្រប់ អាយុ ១៨ ឆ្នាំ នៅ ឆ្នាំ ២០១៩ នេះ ចំនួន ជាង ៣៧ម៉ឺន នាក់ ។
លោក បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ដែល គ្រប់ អាយុ ១៨ ឆ្នាំ អញ្ជើញ ចូលរួម ឲ្យបាន គ្រប់ ៗ គ្នា ៕
ជាមួយគ្នា នេះ សម្តេច តេជោ ហ៊ុន សែ ក៏ បាន ឆ្លៀត អរគុណ ដល់ ម្ចាស់ សណ្ឋាគារ និង ផ្ទះសំណាក់ ព្រមទាំង ម្ចាស់ រថយន្ត តាក់ស៊ី ដែល មាន ទឹកចិត្ត ល្អ មិន ដំឡើង ថ្លៃ ដល់ ប្រជាពលរដ្ឋ ក្នុង ដំណើរកម្សាន្ត នា ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី នេះ ។
សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល ក៏ បាន លើក យក ពី តម្លៃ នៃ សន្តិភាព ដែល ធ្វើឲ្យ ប្រជាជន កម្ពុជា មាន ឱកាស ប្រារព្ធ ពិធី បុណ្យ ទាន តូច ធំ ដោយ គ្មាន ការបារម្ភ ឬ ភ័យ ព្រួយ ឡើង ។
មាន សន្តិភាព និង ការអភិវឌ្ឍន៍ ទើប កម្ពុជា មាន អ្វី ៗ គ្រប់ យ៉ាង រួមទាំង ឱកាស នៃ ការប្រារព្ធ បុណ្យ ទាន តូច ធំ នៅក្នុង ប្រទេស ។ សូម ជូនពរ បងប្អូន ជន រួម ជាតិ សុខ សប្បាយ ចម្រុង ចម្រើន និង ទទួលបាន លាភ សំណាង គ្រប់ គ្នា នៅក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ខាងមុខ នេះ »៕
ក្រសួង យុត្តិធម៌ បង្ហាញ លទ្ធផល នៃ ការប្រឡង ប្រជែង ផ្ទៃក្នុង ជ្រើសរើស ចៅក្រម និង ព្រះរាជអាជ្ញា
( ភ្នំពេញ ) ៖ ក្រសួង យុត្តិធម៌ បាន បង្ហាញ លទ្ធផល នៃ ការប្រឡង ប្រជែង ផ្ទៃ ក្នុង ជ្រើសរើស ចៅក្រម និង ព្រះរាជអាជ្ញា ដែល ការប្រឡង សរសេរ ធ្វើឡើង កាលពី ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០១៩ និង វិញ្ញាសារ ផ្ទាល់ មាត់ ធ្វើឡើង កាលពី ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០១៩ ។
សូម អាន បញ្ជី រាយ នាម ឈ្មោះ បេក្ខជន ប្រឡង ជាប់ ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៣គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន៣ គ្រឿង ក្នុង នោះ រួម មាន៖ ម៉ូតូ២ គ្រឿង និង រថយន្ត ១ គ្រឿង ។
ការអះអាង យ៉ាង ដូចនេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល លោក ដឹកនាំ ក្រុមការងារ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក រដ្ឋមន្ត្រី ក្រសួង សាធារណការ ថៃ ចុះ ពិនិត្យមើល តំណរ ភ្ជាប់ ផ្លូវ រថភ្លើង កម្ពុជា - ថៃ នៅ ច្រក ប៉ោយប៉ែត ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ថ្លែង ថា ផ្លូវ រថភ្លើង តភ្ជាប់ ពី កម្ពុជា ទៅ ប្រទេស ថៃ បាន ដាច់ ដោយសារ សង្ក្រាម ៤៥ ឆ្នាំ មកហើយ ហើយ នៅ ពេល នេះ បាន រៀបចំ ឱ្យ មាន ការតភ្ជាប់ ឡើងវិញ ដែល ទទួលបាន ជំនួយ ដែក ពី ប្រទេស ម៉ាឡេស៊ី ហើយ ភាគី ថៃ ក៏ បាន ជួយ ដឹក បន្ត មក ឱ្យ ដល់ ច្រក ប៉ោយប៉ែត និង បាន ធ្វើជា ផ្លូវ ដែក នេះ ឡើង ហើយ បាន តភ្ជាប់ ជា បន្តបន្ទាប់ រហូតដល់ ភ្នំពេញ ។
លោក ទេសរដ្ឋមន្ត្រី បាន បន្ត ទៀត ថា ចំពោះ ផ្លូវ ដែក តភ្ជាប់ ទៅ ថៃ នេះ គឺ បាន តភ្ជាប់ រួចរាល់ អស់ ហើយ តែ មិន ទាន់ បាន រត់ ទៅ មក ជាមួយ ថៃ នោះ ទេ ដោយសារ មិន ទាន់ មាន ការព្រមព្រៀង ការរត់ ផ្លូវ ដែក រវាង កម្ពុជា និង ថៃ ។ មកដល់ ពេលនេះ កិច្ចព្រមព្រៀង នេះ បាន ធ្វើ ចប់ សព្វគ្រប់ អស់ ហើយ នៅ ចាំ តែ ទៅដល់ ថ្ងៃទី ២២ ខែមេសា ខាងមុខ នេះ នៅ ពេល ដែល សម្តេច តេជោ ហ៊ុន សែន ទទួល ទូរថភ្លើង ដែល ភាគី ថៃ បាន ផ្តល់ឱ្យ នោះ នឹង មាន ការចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ការដឹកជញ្ជូន តាម ផ្លូវ ដែក តែម្តង ។
បើ តាម លោក ស៊ុន ចាន់ថុល . សម្តេច នាយក រដ្ឋមន្ត្រី កម្ពុជា និង នាយក រដ្ឋមន្ត្រី ថៃ នឹង ជិះ រថភ្លើង ឆ្លងកាត់ ទៅ មក កម្ពុជា - ថៃ ដើម្បី បញ្ជាក់ ពី ការដាក់ ឱ្យ ដំណើរការ តភ្ជាប់ ផ្លូវ រថភ្លើង រវាង កម្ពុជា និង ថៃ ឡើងវិញ ផងដែរ ។
លោក ស៊ុន ចាន់ថុល បាន ឱ្យដឹង ទៀត ថា ការដឹកជញ្ជូន តាម ផ្លូវ ដែក នេះ ពិតជា មាន សារសំខាន់ ណាស់ ព្រោះ វា អាច ជួយ កាត់បន្ថយ ការខូចខាត ផ្លូវថ្នល់ ផង និង អាច ដឹក ទំនិញ បាន ច្រើន ផងដែរ ក្នុង នោះ ដែរ កម្មករ កម្ម ការិនី ក៏ អាច ធ្វើដំណើរ ពី បាងកក មកដល់ ស្ថានីយ៍ ប៉ោយប៉ែត នេះ ផងដែរ ព្រោះ នេះ គឺជា ស្ថានីយ រថភ្លើង លំដាប់ថ្នាក់ អន្តរជាតិ ៕
ព្រឹក ស្អែក សម្តេច តេជោ ហ៊ុន សែន នឹង ជួប ជាមួយ មន្ត្រី អង្គការ សហ ប្រជាជាតិ នៅ វិមាន សន្តិភាព
តាម ការគ្រោងទុក ជំនួប នេះ នឹង ធ្វើឡើង នៅ វេលា ម៉ោង ៩ព្រឹក ។ ចំពោះ លទ្ធផល នឹង ចេញផ្សាយ នៅ ក្រោយ បញ្ចប់ ជំនួប ៕
ការសម្រេចចិត្ត ខាងលើ ធ្វើឡើង នៅ អំឡុង កិច្ចប្រជុំ ពិសេស របស់ ម្ចាស់ ភាគហ៊ុន ទាំងអស់ ក្រោយ លោក Ghosn ត្រូវ បាន អាជ្ញាធរ ជប៉ុន ចាប់ខ្លួន សាថា ជាថ្មី កាលពី សប្ដាហ៍ មុន ។ លោក Ghosn ត្រូវបាន បណ្ដេញចេញ ពី តំណែង ជា ប្រធាន ក្រុមហ៊ុន Nissan បន្ទាប់ពី អាជ្ញាធរ ចាប់ខ្លួន ជប៉ុន ចាប់ខ្លួន រូបលោក កាលពី ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅក្នុង សំណុំរឿង ប្រើប្រាស់ ហិរញ្ញវត្ថុ ក្រុមហ៊ុន ដើម្បី ប្រយោជន៍ ផ្ទាល់ខ្លួន បើ ទោះជា សាមីខ្លួន បដិសេធ ជាច្រើន ដង ក៏ដោយ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី០៨ ខែមេសា ឆ្នាំ ២០១៩ នេះ មាន នូវ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន រួម មាន ទាំង ព្រឹត្តិ ការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដែល គួរឲ្យ ចាប់អារម្មណ៍ ។ ខាងក្រោម នេះ ជា រូបភាព ខ្លះ ៗ បង្ហាញ អំពី ព្រឹត្តិការណ៍ ដែល បាន កើត មាន ឡើង ក្នុង ថ្ងៃ នេះ៖
១៖ សម្ដេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ ធនាគារ ជាតិ និង អ្នក ពាក់ព័ន្ធ រួមគ្នា ថែរក្សា មរតក ប្រាក់ រៀល និង ប្រមែប្រមូល ប្រវត្តិសាវតា នានា ពាក់ព័ន្ធ រូបិយវត្ថុ របស់ កម្ពុជា ( ចុច អាន )
២៖ នាយក រដ្ឋមន្រ្តី សម្តេច តេជោ ហ៊ុន សែន៖ កម្ពុជា មិន ចង់ ឃើញ ប្រទេស ដទៃ ជួប រឿង ប្រើប្រាក់ ដុល្លារ យ៉ាង គំហុក ដូច កម្ពុជា ពី អតីតកាល ឡើយ ( ចុច អាន )
៤៖ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ដឹកនាំ គណៈប្រតិភូកងទ័ព កម្ពុជា ទស្សនកិច្ច ផ្លូវការ លើក ដំបូង នៅ អាមេរិក ( ចុច អាន )
៧៖ ប្រមុខ រាជ រដ្ឋាភិបាល៖ បច្ចុប្បន្ន នេះ កម្ពុជា មាន លទ្ធភាព បោះ ក្រដាស ប្រាក់ រៀល ដោយ ម៉ាស៊ីន ទំនើប ៗ និង មិន បារម្ភ ពី ការក្លែងបន្លំ ( ចុច អាន )
៨៖ សម្ដេច តេជោ ហ៊ុន សែន៖ ការមើល រំលង រូបិយវត្ថុ ជាតិ ធ្វើឲ្យ បាត់បង់ ម្ចាស់ ការលើ ការគ្រប់គ្រង សេដ្ឋកិច្ច និង អធិបតេយ្យ ជាតិ ( ចុច អាន )
១២៖ ក្រសួង កសិកម្ម៖ គ្មាន សកម្មភាព ដឹកជញ្ជូន ឈើ ចេញពី តំបន់ បាត អាង ទំនប់ វារី អគ្គិសនី សេសាន ក្រោម ២ ដូច ការផ្សព្វផ្សាយ របស់ វិទ្យុ អាស៊ី សេរី ឡើយ ( ចុច អាន )
១៣៖ ព្រះមហាក្សត្រ និង សម្តេច ម៉ែ បាន យាង និវត្តន៍ មកដល់ កម្ពុជា វិញ ហើយ ក្រោយ បញ្ចប់ ការពិនិត្យ ព្រះរាជ សុខភាព នៅ រដ្ឋធានី ប៉េកាំង ( ចុច អាន )
១៥៖ កម្ពុជា ចុះហត្ថលេខា លើ ពិធីសារ នៃ ការប្តេជ្ញាចិត្ត បើក ចំហរ សេវា ហិរញ្ញវត្ថុ នៅក្រោម កិច្ចព្រមព្រៀង ក្របខណ្ឌ អាស៊ាន ស្តីពី សេវា ( ចុច អាន )
១៦៖ ក្រសួង ការងារ៖ បុគ្គលិក បម្រើការ នៅ ស្ថាន តំណាង បរទេស ភ្នាក់ងារ UN និង អង្គការ អន្តរជាតិ នានា ប្រចាំ កម្ពុជា ត្រូវបាន លើកលែង ការអនុវត្ត ប្រកាស លេខ ៤៤២ និង លេខ ៤៤៣ ( ចុច អាន )
២៖ សហរដ្ឋ អាមេរិក ទាមទារ ឲ្យ មេទ័ព គ្រប់គ្រង ភាគ ខាងលិច លីប៊ី បញ្ឈប់ ការវាយប្រហារ មក លើ ទីក្រុង ទ្រី ប៉ូលី ជា បន្ទាន់ ! ( ចុច អាន )
៤៖ សមាជិក សភា ប៉ូឡូញ៖ ប៉ូឡូញ គួរតែ ទារ ថ្លៃ សង ការខូចខាត ក្នុង សង្រ្គាម លោក លើក ទី២ ៩០០ ពាន់ លាន ដុល្លារ ពី អាល្លឺម៉ង់ ( ចុច អាន )
លោក សាយ សំអាល់៖ ខេត្ត ព្រះសីហនុ កំពុង ទទួល ផ្លែ ផ្កា សុខ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ដែល បាន មកពី ការយក ជីវិត ធ្វើ ដើមទុន របស់ ថ្នាក់ដឹកនាំ
លោក រដ្ឋមន្ត្រី បាន មានប្រសាសន៍ ថា៖ « យើង ទាំងអស់ គ្នា ត្រូវ រួមគ្នា គិតគូរ ដើម្បី ទាញយក ផល នៃ ការអភិវឌ្ឍ ក្នុង គោលដៅ ដើម្បី រក្សា កំណើន សេដ្ឋកិច្ច ជាតិ ក្នុង រង្វង់ ៧% ក្នុង មួយ ឆ្នាំ បង្កើត ការងារ ធ្វើ សម្រាប់ ពលរដ្ឋ កម្ពុជា កាត់បន្ថយ ភាពក្រីក្រ បង្កើន ចំណូល ជីវភាព របស់ ប្រជាជន និង ធានា នូវ ការអភិវឌ្ឍ ប្រកបដោយ និរន្តរភាព ។
ជាមួយគ្នា នេះ លោក រដ្ឋមន្ត្រី សាយ សំអាល់ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត ព្រះសីហនុ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ខេត្ត ព្រះសីហនុ បាន គូសបញ្ជាក់ យ៉ាង មុតមាំ ថា ខេត្ត ព្រះសីហនុ ត្រូវ បញ្ចប់ ជម្លោះ ដីធ្លី ដែល រ៉ាំរ៉ៃ ជា យូរ មកហើយ ឱ្យ បាន ទាំងស្រុង ។ លោក ថ្លែង ថា៖ « មិន ត្រូវ ឱ្យ កើតឡើង នូវ ជម្លោះ ថ្មី ៗ ទៀត ឡើយ និង ត្រូវ ខិតខំ ប្រឹងប្រែង ដោះស្រាយ ជម្លោះ ដីធ្លី ចាស់ ឱ្យ បាន បញ្ចប់ ទាំងស្រុង » ។
លោក រដ្ឋមន្ត្រី ប្រធាន ក្រុមការងារ ក៏ បាន ថ្លែង ថា ករណី ដូចគ្នា នេះ ក៏ ត្រូវ អនុវត្ត ផងដែរ ចំពោះ ការគ្រប់គ្រង ចរន្ត អគ្គិសនី ក៏ ដូចជា ប្រព័ន្ធ លូ និង ការគ្រប់គ្រង សំណល់ រឹង សំរាម ។ ដើម្បី គ្រប់គ្រង អនាម័យ បរិស្ថាន ខេត្ត ព្រះសីហនុ ឱ្យ បាន ល្អ ស្អាត លោក រដ្ឋមន្ត្រី បាន ស្នើ ឱ្យ គ្រប់ ស្ថាប័ន ពាក់ព័ន្ធ រួម នឹង បងប្អូន ប្រជាពលរដ្ឋ រួម នឹង ម្ចាស់ អាជីវកម្ម ទីកន្លែង កម្សាន្ត នានា នៅក្នុង ក្រុង ព្រះសីហនុ រួម សហការ សម្អាត អនាម័យ បរិស្ថាន និង ទុកដាក់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ ។
រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន ថ្លែង យ៉ាង ដូចនេះ នៅ រសៀល ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ចុះ សួរសុខទុក្ខ កងទ័ព នៅ យោធ ភូមិភាគ ទី៣ ខេត្ត កោះកុង ដោយ មាន ការចូលរួម អម ដំណើរ ដោយ នាយ ឧត្តមសេនីយ៍ ប៊ុន លើ ត រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ . នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ ព្រមទាំង នាយ ទាហាន ជាន់ ខ្ពស់ ខេមរភូមិន្ទ នៅក្នុង ក្រសួង ការពារ ជាតិ អគ្គ បញ្ជាការ ជាច្រើន រូប ទៀត ផងដែរ ។
ថ្លែង ក្នុង ពិធី សំណេះសំណាល នោះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ញើ ជូន ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន គ្រប់ កង ឯកភាព នៅក្នុង ទិសដៅ យោធ ភូមិភាគ ទី៣ ទាំងអស់ ក្នុង មនោសញ្ចេតនា នឹករលឹក និង ការគិតគូរ ខ្ពស់ ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ បងប្អូន ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ក៏ បាន ក្រើន រំលឹក និង ជម្រុញ បន្ថែម ដល់ កងកម្លាំង ទាំងអស់ និង មន្ត្រីរាជការ ស៊ីវិល គ្រប់ លំដាប់ថ្នាក់ ខេត្ត កោះកុង ត្រូវ ចូលរួម ឲ្យបាន សកម្ម ថែម ទៀត ក្នុង ការ ជួយ ថែរក្សា សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ និង សណ្តាប់ធ្នាប់ សាធារណៈ សង្គម ឱ្យ បាន កាន់តែ ល្អ ប្រសើរឡើង ហើយ កង កំលាំងប្រដាប់ អាវុធ គឺ ត្រូវ ធ្វើ យ៉ាងណា ឲ្យ ប្រជាពលរដ្ឋ មាន ភាព កក់ក្តៅ មាន ជំនឿ ទុកចិត្ត លើ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ។
សម្តេច ពិជ័យ សេនា ក៏ បាន អំពាវនាវ ដល់ នាយ ទាហាន ភូមិភាគ ទី៣ ត្រូវ អនុវត្ត ឱ្យ បាន នូវ ប្រសាសន៍ ដ៏ មាន សារៈសំខាន់ ទាំង១០ ចំណុច របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក្នុង ឱកាស ដែល សម្តេច បាន ថ្លែង ក្នុង ពិធី ប្រារព្ធ ខួប លើក ទី ២០ ថ្ងៃ បង្កើត បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក កាលពី ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០១៩ កន្លងមក នេះ ៕
ទេសរដ្ឋមន្ត្រី អៀង មូលី៖ « ជោគជ័យ ក្នុង ការប្រយុទ្ធ នឹង ជំងឺ អេដស៍ កើត ចេញពី ការប្តេជ្ញាចិត្ត ខាង នយោបាយ ភាពជាដៃគូ និង ការវិនិយោគ ដើម្បី ឈាន ទៅ បញ្ចប់ អេដស៍ »
ឯក អគ្គ រាជ ទូត ខ្មែរ នៅ ថៃ រៀបចំ សង្ក្រាន្ត ដើម្បី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែ ដោយ មាន និមន្ត និង ចូលរួម ជិត ៥០០ អង្គ នាក់
( បាងកក )៖ លោក អ៊ូក សោភ័ណ ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ព្រះរាជាណាចក្រ ថៃ ឡង់ ដ៏ នា ចុង សប្តាហ៍ បាន ដឹកនាំ រៀបចំ មហាសង្ក្រាន្ត ខ្មែរ នៅក្នុង បរិវេណ ស្ថានទូត កម្ពុជា ដើម្បី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល នឹង ចាប់ផ្តើម នៅ ថ្ងៃទី ១៤ ដល់ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០១៩ ដែល ត្រូវ នឹង កាលពី ថ្ងៃអាទិត្យ ៣កើត ខែ ចេត្រ ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស .២៥៦២ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ផងដែរ លោក អ៊ូក សោភ័ណ ដែល ទើបតែ បាន តែងតាំង ថ្មី បាន មាន មតិ សំណេះសំណាល ទៅកាន់ បងប្អូន យើង ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា មិន ថា ថ្ងៃសៅរ៍ ឬ អាទិត្យ ឡើយ សម្តេច តេជោ តែងតែ ចុះ តាម មូលដ្ឋាន ដើម្បី សាកសួរ សុខទុក្ខ បងប្អូន ពលរដ្ឋ ខ្មែរ និង ដោះស្រាយ បញ្ហា ជូន បងប្អូន យើង ជាពិសេស គឺ បងប្អូន ពលករ - ពល ការិនី តាម បណ្តា រោងចក្រ នានា ។
លោក អ៊ូក សោភ័ណ បាន បន្ត ថា ដើម្បីឱ្យ ស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋា បាល ស្ថានទូត បាន យកចិត្ត ទុក ខ្លាំង ចំពោះ បងប្អូន ដែល បាន មក ស្នើសុំ សេវា និង ការបញ្ជាក់ ឯកសារ នានា រាល់ ពេល កើត បញ្ហា ឡើង មន្ត្រី ស្ថានទូត តែងតែ ចុះ ទៅ ជួយ ដោះស្រាយ ជូន បងប្អូន គ្រប់ ពេលវេលា ស្ថានទូត បាន រៀបចំ បន្ទប់ ម៉ាស៊ីន ត្រជាក់ សម្រាប់ រង់ ចំា និង ទទួល បងប្អូន យើង ដើម្បី កុំ ឱ្យ មាន ការលំបាក និង មាន ការចែក នំ ដល់ ប្អូន ៗ កុមារ ផងដែរ ។
ស្ថានទូត បាន ផ្លាស់ប្តូរ វេណ មន្ត្រី ប្រចាំ ការ មិន សម្រាក ថ្ងៃត្រង់ ដើម្បី ផ្តល់ សេវា ជូន បងប្អូន ជាពិសេស ស្ថានទូត បាន បើក ផ្តល់ សេវា ឯកសារ នានា ជូន បងប្អូន យើង ក្នុង ឪកាស ចូល ឆ្នាំ ថ្មី ខាងមុខ នេះ រហូតដល់ ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០១៩ ដើម្បីឱ្យ បងប្អូន យើង បាន ធ្វើដំណើរ ត្រឡប់ ទៅ ស្រុក កំណើត ជួបជុំ ក្រុមគ្រួសារ ក្នុង ពិធី ចូល ឆ្នាំ ។
បច្ចុប្បន្ន នេះ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ក្រោម ការដឹកនាំ របស់ ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន បាន ធ្វើ ការកែទម្រង់ ថ្មី ព្រមទាំង បាន ណែនាំ ដល់ អ្នកការទូត ខ្មែរ ទាំងអស់ ថា នៅ ពេល នេះ ការងារ ការទូត របស់ កម្ពុជា មិន មែន ជា ការងារ ការទូត បែប ប្រពៃណី ធម្មតា ដូច ពេល មុន ទៀត ទេ ការទូត ត្រូវ ចាប់ផ្តើម ផ្តោត សារៈសំខាន់ ក្នុង ការរួមចំណែក ជំរុញ និង លើកស្ទួយ ទំនាក់ទំនង សេដ្ឋកិច្ច ពាណិជ្ជកម្ម វប្បធម៌ និង ទេសចរណ៍ បន្ថែម ទៀត ផងដែរ ។
លោក បណ្ឌិត កែវ អូម៉ាលី ស្ស ដឹកនាំ គណៈប្រតិភូ ចុះ សួរសុខទុក្ខ កងទ័ព ការពារ អាកាស មុន ឱកាស បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត កែវ អូម៉ាលី ស្ស ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា ប្រធាន រដ្ឋបាល ព្រៃឈើ នៅ ថ្ងៃទី ៩ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ កងទ័ព ឈរ ជើង នៅ បញ្ជាការដ្ឋាន ការពារ អាកាស ដែល ជា អង្គភាព សម្ព័ន្ធ មេត្រីភាព មុន ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ។
ក្នុង ឱកាស នេះ ដែរ លោក បណ្ឌិត កែវ អូម៉ាលី ស្ស បាន កោតសរសើរ ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាហាន ទាំងអស់ ដែល បាន លះបង់ កម្លាំ កាយ កម្លាំងចិត្ត អាយុជីវិត ការពារ ជាតិ ការពារ បូរណភាព ទឹកដី នាំមក នូវ សុខ សន្តិភាព ពេញលេញ ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។ ក្នុង នាម រដ្ឋបាល ព្រៃឈើ សូម ថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ចំពោះ ការលះបង់ របស់ កងទ័ព ទាំងអស់ និង ខិតខំ បន្ត ចូលរួមចំណែក គាំទ្រ ដល់ វិស័យ នេះ ។
ទន្ទឹមនឹង នេះ ដែរ លោក ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា ប្រធាន រដ្ឋបាល ព្រៃឈើ បាន គូសបញ្ជាក់ ថា កងទ័ព របស់ កម្ពុជា បាន នាំមក នូវ សន្តិភាព ពេញលេញ ជូន ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស បាន គូសបញ្ចាក់ ថា កងទ័ព បាន នាំមក នូវ សន្តិភាព ពេញលេញ ជូន ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ។
លោក ឧត្តមសេនីយ ឯក អ៊ុល ណាវី នាយ រង សេនាធិការ ចម្រុះ និង ជា មេបញ្ជាការបញ្ជាការដ្ឋាន ការពារ អាកាស បាន រាយការណ៍ អំពី លទ្ធផល ការងារ ដែល សម្រេចបាន តាម ផែនការ និង ទិសដៅ អនុវត្ត បន្ត របស់ អង្គភាព ពិសេស លើ ការងារ បណ្តុះបណ្តាល ហើយ លោក ឧកញ៉ា ឈន ថា រី នាយក ក្រុមហ៊ុន ថា រី ពាណិជ្ជ ដែល ជា ក្រុមហ៊ុន សម្ព័ន្ធ មេត្រីភាព ដែរ នាះ បាន លើក ទ្បើង អំពី ការចូលរួម របស់ វិស័យ ឯកជន ជាមួយ បញ្ជាការដ្ឋាន ផងដែរ ។
ពិធី ចុះ សួរសុខទុក និង សំណេះសំណាល រដ្ឋបាល ព្រៃឈើ និង ក្រុមហ៊ុន ថា រី ពាណិជ្ជ បាន នាំមក នូវ ថវិកា សរុប ចំនួន ៣០ លាន រៀល ជូន ដល់ បញ្ជាការដ្ឋាន សម្រាប់ ជូន ដល់ គ្រួសារ កងទ័ព ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ នា ពេល ខាងមុខ នេះ ៕
លោក អ៊ាង សុផល្លែត ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ប្រាប់ អ្នកយកព័ត៌មាន ក្រោយ បញ្ចប់ ជំនួប ថា លោកស្រី បាន គោរព ជម្រាប ជូន សម្តេច តេជោ ដោយ UN-ESCAP ទទួលស្គាល់ នូវ សុខ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ របស់ កម្ពុជា ។
លោកស្រី បាន ថ្លែង ទៀត ថា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន . កម្ពុជា មាន សុខ សន្តិភាព ស្ថិរភាព និង សមត្ថភាព ពេញលេញ ។ ពី នេះ ទៅ ទៀត កម្ពុជា ក៏ បាន ទទួល នូវ ការអភិវឌ្ឍន៍ នៅលើ វិស័យ ជាច្រើន ។ ក្នុង ន័យ នេះ ដែរ លោកស្រី ក៏ បាន គោរព ថ្លែងអំណរគុណ សម្ដេច តេជោ ចំពោះ កិច្ចសហប្រតិបត្តិការ ល្អ ជាមួយនឹង អង្គការ សហ ប្រជាជាតិ អង្គការ UN-ESCAP ផងដែរ ។
ជា ការឆ្លើយតប សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ជាមួយនឹង ការលើកឡើង របស់ លោកស្រី ហើយ បាន ជម្រាប លោកស្រី ផងដែរ ថា ជា ការពិត ណាស់ មិន មាន ប្រទេស ច្រើន ទេ ដែល បង្កើត គណៈកម្មការ ជាតិ សម្រាប់ ធ្វើ ការសម្របសម្រួល ជាមួយនឹង UN-ESCAP ហើយ មិន តែ ប៉ុណ្ណោះ ទេ កម្ពុជា បាន សហការ យ៉ាង ល្អ ជា ទីបំផុត ជាមួយនឹង ភ្នាក់ងារ UN ទាំងអស់ នៅក្នុង ប្រទេស កម្ពុជា ។
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នឹង រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី « ស្ថានភាព ជាក់ស្តែង និង ការអនុវត្ត សិទ្ធិ កម្មករ កម្ពុជា ប្រកបដោយ ចីរភាព និង ប្រសិទ្ធភាព » ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃព្រហស្បតិ៍ ទី១១ ខែមេសា ឆ្នាំ ២០១៨ វេលា ម៉ោង ៣រសៀល នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង របស់ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៩ ខែមេសា នេះ ។
សន្និសីទ នេះ គឺ មាន ទិសដៅ និង គោលបំណង ឆ្លើយតប ដើម្បី បំភ្លឺ ដល់ សាធារណជន ព្រមទាំង បណ្តាញ សារព័ត៌មាន បរទេស មួយចំនួន ដែល ប្រឌិត និង បកស្រាយ បំផ្លើស ពី ស្ថានភាព ជាក់ស្តែង កម្ពុជា ក្នុង វិស័យ កម្មករ កម្មការិនី ។ សេចក្តីជូនដំណឹង នេះ ចាត់ទុក ជា សេចក្តីអញ្ជើញ សារព័ត៌មាន គ្រប់ និន្នាការ ចូលរួម យក ព័ត៌មាន ដើម្បី ផ្សព្វផ្សាយ ជាសាធារណៈ ។
រួមគ្នា ជួយ ជនរងគ្រោះ ! កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល បរិច្ចាគ ឈាម ដើម្បី ជួយសង្គ្រោះ ជីវិត មនុស្ស
( កណ្តាល ) ៖ ដើម្បី ផ្ដល់ ជា កាដូ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ ឆ្នាំ កុរ កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល សហការ ជាមួយ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត កណ្តាល និង មជ្ឈមណ្ឌល ជាតិ ផ្តល់ ឈាម បាន រៀបចំ ពិធី ផ្តល់ ឈាម ដើម្បី ជួយ ជីវិត ជនរងគ្រោះ ដែល ត្រូវការ ឈាម ចាំបាច់ ។
សកម្មភាព នេះ ធ្វើឡើង នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ ដែល ពិធី នេះ ក៏ មាន ការអញ្ជើញ ពី លោក ឧត្តមសេនីយ៍ ត្រី សំ តុលា មេបញ្ជាការ អាវុធហត្ថ ខេត្ត កណ្ដាល លោក គីម រិទ្ធី អភិបាល រង ខេត្ត កណ្តាល និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត កណ្តាល ព្រមទាំង នាយ ទាហាន នាយ រង ទាហាន នៃ កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល ជាច្រើន រូប ទៀត ។
លោក មេបញ្ជាការ បាន បន្ថែម ថា កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល បាន ធ្វើជា គំរូល្អ និង មាន ស្នាដៃ កិត្តិយស កេរ្ត៍ ឈ្មោះ ល្អ នេះ ដោយ មាន ការដឹកនាំ ចង្អុលបង្ហាញ ពី នាយ ឧត្តមសេនីយ៍ សៅ សុខា ឱ្យ យកចិត្តទុកដាក់ ឈរ លើ ការគោរព បទបញ្ជា ការគោរព វិន័យ មាន សាមគ្គី ឯកភាព ផ្ទៃក្នុង រឹងមាំ គោរព តាម ឋានានុក្រម ពិសេស មាន ឆន្ទៈ ក្នុង ការការពារ និង បម្រើ ប្រជាជន ។
ជាមួយ នោះ កងរាជអាវុធហត្ថ ក៏ មាន តួនាទី យ៉ាង សំខាន់ សម្រាប់ ជួយ ដល់ សង្គម ទាំងមូល ក្នុង ការថែរក្សា ការពារ ពង្រឹង សន្តិសុខ ស្ថិរភាព នយោបាយ និង រក្សា សណ្តាប់ធ្នាប់ សាធារណៈ ហើយ មកដល់ បច្ចុប្បន្ន នេះ កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល បាន បង្កើត នូវ សមិទ្ធផល ជាច្រើន សម្រាប់ អង្គភាព ជាពិសេស ក្រៅពី ការងារ ស្នូល កងរាជអាវុធហត្ថ ខេត្ត បាន ចូលរួម សហការ និង ចុះ ជួយ ដល់ ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា នៅ ពេល ដែល ប្រជាពលរដ្ឋ មាន តម្រូវការ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម ដំណាច់ ឆ្នាំ ២០១៨ កន្លងទៅ សមាគម - អង្គការ មិន មែន រដ្ឋាភិបាល ក្នុង ស្រុក ដែល បាន តម្កល់ សំណុំ ឯកសារ និង ចុះបញ្ជី នៅ ក្រសួង មហាផ្ទៃ មាន ចំនួន សរុប ៥. ៥២៣ អង្គភាព និង សមាគម - អង្គការ មិន មែន រដ្ឋាភិបាល បរទេស ដែល បាន ចុះ អនុស្សរណៈ នៅ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ មាន ចំនួន សរុប ៤១៩ អង្គភាព ។
តួលេខ នេះ ត្រូវបាន បង្ហាញ ក្នុង ពិធី បើក វេទិកា ពិគ្រោះយោបល់ ជាមួយ សមាគម - អង្គការ មិន មែន រដ្ឋាភិបាល និង សហគមន៍ នានា នៅក្នុង មូលដ្ឋាន រាជធានី ភ្នំពេញ ក្រោម ប្រធានបទ ស្តីពី « ភាព ជាដៃគូ ប្រកបដោយ ការទទួលខុសត្រូវ » ។ ពិធី នេះ ធ្វើឡើង នា ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០១៩ នៅ មជ្ឈមណ្ឌល សន្និបាត និង ពិព័រណ៍ កោះ ពេជ្រ ក្រោម អធិបតីភាព លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង លោក គឹម រ័ត្ន វិសិដ្ឋ ប្រធាន ក្រុមប្រឹក្សាភិបាល វេទិកា សម្ព័ន្ធ សង្គម ស៊ីវិល ។
លោក អភិបាល រាជធានី ភ្នំពេញ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « គិត ត្រឹម ដំណាច់ ឆ្នាំ ២០១៨ កន្លងទៅ សមាគម - អង្គការ មិន មែន រដ្ឋាភិបាល ក្នុង ស្រុក ដែល បាន តម្កល់ សំណុំ ឯកសារ និង ចុះបញ្ជី នៅ ក្រសួង មហាផ្ទៃ មាន ចំនួន សរុប ៥. ៥២៣ អង្គភាព និង សមាគម - អង្គការ មិន មែន រដ្ឋាភិបាល បរទេស ដែល បាន ចុះ អនុស្សរណៈ នៅ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ មាន ចំនួន សរុប ៤១៩ អង្គភាព » ។
លោក បាន បន្ត ថា ក្នុង ចំណោម សមាគម - អង្គការ ទាំងនោះ សមាគម - អង្គការ មិន មែន រដ្ឋាភិបាល និង សហគមន៍ ដែល មាន មូលដ្ឋាន ក្នុង រាជធានី ភ្នំពេញ មាន ចំនួន ៧២៩ អង្គភាព បាន និង កំពុង ប្រតិបត្តិការ សកម្មភាព របស់ ខ្លួន ដោយ រលូន ស្រប តាម ច្បាប់ ជាធរមាន ដោយ គ្មាន ការហាមឃាត់ ឬ ការរារាំង ណាមួយ ឡើយ ។
លោក បាន បញ្ជាក់ ថា តាមរយៈ តួលេខ ខាងលើ បាន បង្ហាញ ថា ចំនួន សមាគម - អង្គការ មិន មែន រដ្ឋាភិបាល គ្មាន ការថយចុះ ដូច ការព្រួយបារម្ភ របស់ បុគ្គល មួយចំនួន ដែល ជាញឹកញាប់ តែងតែ ចោទប្រកាន់ មក លើ រាជ រដ្ឋាភិបាល កម្ពុជា និង អាជ្ញាធរ មូលដ្ឋាន ពី ការដាក់កំហិត លើ សិទ្ធិ សេរីភាព ក្នុង ការបង្កើត សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល រួមទាំង សិទ្ធិ សេរីភាព នៃ ការបញ្ចេញមតិ នោះ ឡើយ ។
បើ តាម លោក អភិបាល រាជធានី ភ្នំពេញ សម្រាប់ វេទិកា ពិគ្រោះយោបល់ ជាមួយ សមាគ - អង្គការ មិន មែន រដ្ឋាភិបាល និង សហគមន៍ នានា នៅក្នុង មូលដ្ឋាន រាជធានី ភ្នំពេញ ក្នុង ថ្ងៃ នេះ គឺជា លើក ទី១ សម្រាប់ ឆ្នាំ ២០១៩ និង ជា លើក ទី២ហើយ ដែល រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ចាត់ចែង រៀបចំ ព្រឹត្តិការណ៍ នេះ បន្ទាប់ពី ជំនួប នៃ វេទិកា លើក ដំបូង កាលពី ថ្ងៃទី ១៧ ខែឧសភា ឆ្នាំ ២០១៨ និង ក្រោយពេល ដែល ក្រសួង មហាផ្ទៃ ទើបតែ បាន រៀបចំ វេទិកា នេះ ជា លើក ទី២ កាលពី ថ្ងៃ១៧ ខែមករា ឆ្នាំ ២០១៩ កន្លងទៅ ៕
គួរ បញ្ជាក់ ថា កាលពី ឆ្នាំ ២០១៧ ការធ្វើ ពាណិជ្ជកម្ម រវាង ចិន និង កូរ៉េ ខាងជើង បាន ថយចុះ អស់ ច្រើន ជាង ១០ភាគរយ ឬ ស្មើនឹង ០៥ ពាន់ លាន ដុល្លារ ដោយសារតែ ទណ្ឌកម្ម អន្តរជាតិ ។ ប៉ុន្តែ ការបើក ច្រក ព្រំដែន ថ្មី នេះ ត្រូវបាន គេ រំពឹង ថា នឹង ជួយ បង្កើន ទំនាក់ទំនង ពាណិជ្ជកម្ម ទ្វេ ភាគី រវាង ប្រទេស ទាំង ពីរ ឡើងវិញ ខណៈ គេ មិន ទាន់ ដឹង ឡើយ ថា តើ ច្រក ព្រំដែន នេះ នឹង ដំណើរការ ទៅ យ៉ាងដូចម្ដេច ចំពោះ មុខ ទណ្ឌកម្ម ពី អន្តរជាតិ ដែល កំពុង សង្កត់ លើ របប ដឹកនាំ លោក គីម ជុង អ៊ុន នោះ ឡើយ ៕
ប្រេស៊ី ល៖ « យើង មិន អាច ទុកឲ្យ វេណេស៊ុយអេឡា ក្លាយជា កូរ៉េ ខាងជើង ឬ គុយ បាទី ពីរ នោះ ទេ . ប្រេស៊ីល កំពុង សហការ ជាមួយ អាមេរិក ដើម្បី ផ្តួលរបប ម៉ាឌូរ៉ូ »
គួរ បញ្ជាក់ ថា គិត ចាប់តាំងពី ឆ្នាំ ២០១៧ មន្ត្រី ជាន់ ខ្ពស់ អាមេរិក ជាច្រើន នាក់ បាន លា លែង ចេញ ពី តំណែង និង ខ្លះ ទៀត ត្រូវ បណ្ដេញ ដោយ លោក ដូណាល់ ត្រាំ ក្នុង នោះ មាន ដូចជា អតីត រដ្ឋមន្ត្រី ការបរទេស អាមេរិក លោក រិច ធី ល្លឺសុន និង អតីត រដ្ឋមន្ត្រី ការពារ ជាតិ លោក ជែមស៍ ម៉ាត់ ទី ស ជាដើម ៕
ជូនដំណឹង ! បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្ត្រីរាជការ ស៊ីវិល នឹង បើក ប្រាក់ របប សន្តិសុខ សង្គម ប្រចាំ ខែមេសា និង ប្រាក់ ឧបត្ថម្ភ បុណ្យ ចូល ឆ្នាំ ខ្មែរ ជូន និវត្ត ជន និង អតីត មន្ត្រីរាជការ ស៊ីវិល ចាប់ពី ថ្ងៃទី ១០ ខែមេសាត ទៅ
( ភ្នំពេញ ) ៖ បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្រ្តី រាជការ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង បើក ប្រាក់ របប សន្តិសុខ សង្គម ប្រចាំ ខែមេសា ឆ្នាំ ២០១៩ និង ប្រាក់ គោល នយោបាយ សោធន សម្រាប់ ខែមេសា ឆ្នាំ ២០១៩ និង ប្រាក់ ឧបត្ថម្ភ បុណ្យ ចូល ឆ្នាំ ខ្មែរ ជូន និវត្ត ជន និង អតីត មន្រ្តី រាជការ ស៊ីវិល ចាប់ពី ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០១៩ត ទៅ តាម ប្រព័ន្ធ ធនាគារ កាណាឌីយ៉ា និង ធនាគារ អេស៊ីលីដា នៅ ២៥ រាជធានី - ខេត្ត ទូទាំង ប្រទេស ។
យោង តាម សេចក្តីជូនដំណឹង របស់ បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្រ្តី រាជការ ស៊ីវិល ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន បញ្ជាក់ ថា « ប្រាក់ គោល នយោបាយ របប សន្តិសុខ សង្គម និង ការបន្ថែម របប សន្តិសុខ សង្គម សម្រាប់ និវត្ត ជន និង ជន បាត់បង់ សម្បទា វិជ្ជាជីវៈ សម្រាប់ ខែមេសា ឆ្នាំ ២០១៩ នឹង ត្រូវ បើក ចាប់ពី ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០១៩ » ។
( ភ្នំពេញ ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក នៅ ព្រឹក ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០១៩ នេះ អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ ត្រួតពិនិត្យ លទ្ធផល ការងារ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ប្រចាំ ត្រីមាស ទី១ ឆ្នាំ ២០១៩ ។
របាយការណ៍ បាន បង្ហាញ ថា ប្រតិបត្តិការ ត្រួតពិនិត្យ អនុវត្ត ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ក្នុង ត្រីមាស ទី១ ឆ្នាំ ២០១៩ ទទួល លទ្ធផល ដូច ខាងក្រោម៖
អនុវត្ត ការបង់ប្រាក់ ពិន័យ តាម ស្នាក់ការ នគរបាល ចរាចរណ៍ ផ្លូវគោក ដែល បាន កំណត់ ទទួលបាន ប្រាក់ ពិន័យ ចំនួន ១. ០៤០. ៧០៥.០០០ រៀល ។
ដោយឡែក ការត្រួតពិនិត្យ ល្បឿន បាន ដំណើរការ យ៉ាង សកម្ម រកឃើញ រថយន្ត បើកបរ ល្មើស ល្បឿន ចំនួន ២.៥៨៩ គ្រឿង ចាត់ការ តាម ច្បាប់ ។
តាមរយៈ កិច្ចសហប្រតិបត្តិការ និង ភាពជាដៃគូ កន្លងមក UNESCAP បាន កោតសរសើរ ចំពោះ កម្ពុជា ថា កម្ពុជា ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា គឺជា ករណី ជោគជ័យ សំខាន់ មួយ របស់ ប្រទេស ដែល ធ្លាប់ ត្រូវបាន ញាំញី ដោយ សង្រ្គាម ហើយ សម្រេចបាន នូវ ការផ្លាស់ប្តូរ មុខមាត់ ថ្មី គួរ ជា ទី មោទនៈ ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៩នាក់ របួស ស្រាល ៤នាក់ និង របួស ធ្ងន់ ១៥នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១៧លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ១៨ គ្រឿង . រថយន្ត តូច៦ គ្រឿង និង រថយន្ដ ធំ៨ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធ . មិន ប្រកាន់ ស្ដាំ . បត់ ឆ្វេង - ស្ដាំ . និង ងងុយដេក ។
អតីត គ្រូបង្រៀន សាលា បាក់ទូក រួម ជាមួយ នាយក សាលា បច្ចុប្បន្ន និង មិត្ត រួម ជំនាន់ នាំ មនោសញ្ចេតនា រំភើប រីករាយ មកកាន់ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ
ស្ថិត ក្នុង បរិយាកាស ជា ទី មនោរម្យ នេះ លោក តូច កន្តាល់ នាយក វិទ្យាល័យ បាក់ទូក បច្ចុប្បន្ន និង អតីត លោកគ្រូ អ្នកគ្រូ ចាស់ ៗ ជាច្រើន រូប ព្រមទាំង មិត្តភក្តិ រួម ជំនាន់ ជាច្រើន នាក់ បាន នាំយក កន្ត្រក ផ្កា ចម្រុះ ពណ៌ មក ប្រគល់ ជូន លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង ដើម្បី បង្ហាញ ពី មនោសញ្ចេតនា ស្រឡាញ់ នឹករលឹក និង អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ធ្វើឲ្យ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង រំភើប ក្តុល ក្តួល រីករាយ បំផុត ។
ជាមួយគ្នា នេះ ផងដែរ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង ក៏ បាន បង្ហាញ នូវ ទឹកចិត្ត គោរព ស្រឡាញ់ ដឹង គុណ អតីត លោកគ្រូ អ្នកគ្រូ និង ទឹកចិត្ត ស្រឡាញ់ នឹករលឹក ដល់ មិត្ត រួម ជំនាន់ ទាំងអស់ ព្រមទាំង បាន ជូន អំណោយ ដល់ អតីត លោកគ្រូ អ្នកគ្រូ ក្នុង ម្នាក់ ៗ នូវ ថវិកា ១០០ ដុល្លារ . ទឹកក្រូច ០២ កែស. ទឹក ចាហួយ ០១កែស. មី០១ កែស និង ជូន មិត្តភក្តិ នូវ ទឹកក្រូច ក្នុង ម្នាក់ ០១កែស ផងដែរ ៕
កងទ័ព ជើងគោក ឥណ្ឌា បញ្ចេញ កាំភ្លើង ធំ សម្រាប់ បាញ់ ផ្លោង ចម្ងាយ ឆ្ងាយ ដែល ផលិត ក្នុង ស្រុក ផ្ទាល់ ខណៈ តាម ព្រំដែន នៅតែ មាន ភាពតានតឹង
( បន្ទាយមានជ័យ )៖ ស្ពាន ស្ទឹង បត់ ដែល មាន ប្រវែង ៦០៥ ម៉ែត្រ តភ្ជាប់ ប្រទេស កម្ពុជា និង ប្រទេស ថៃ នៅ តំបន់ ច្រក អន្តរជាតិ ប៉ោយប៉ែត នឹង ត្រូវ ដាក់ សម្ពោធ ឱ្យ ប្រើប្រាស់ នៅ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន ដើម្បី សម្រួល ដល់ ការដឹកជញ្ជូន ទំនិញ កម្ពុជា - ថៃ ។ នេះ បើ តាម លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ថ្លែង ឱ្យដឹង យ៉ាង ដូចនេះ នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល រូប លោក រួម ជាមួយ រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ថៃ ចុះ ពិនិត្យមើល ស្ពាន ស្ទឹង បត់ ដើម្បី ត្រៀម ដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ នា ថ្ងៃទី ២២ ខែមេសា ខាងមុខ នេះ ។
លោក ទេសរដ្ឋុ មន្ត្រី ស៊ុន ចាន់ថុល បាន ថ្លែង ថា ស្ពាន ស្ទឹង បត់ នេះ បាន កសាង ដោយ វិស្វករ ថៃ ទាំងស្រុង តែ ម្តង ដែល មាន ប្រវែង ៦០៥ ម៉ែត្រ ក្នុង នោះ ខាង កម្ពុជា មាន ប្រវែង ២១៥ ម៉ែត្រ ។ ស្ពាន នេះ ដែរ ភាគី ថៃ ជា អ្នក ចេញ លុយ ទាំងស្រុង ដោយ បាន តភ្ជាប់ ប្រទេស ថៃ និង កម្ពុជា ដែល ទុក សម្រាប់ តែ ដឹក ទំនិញ តែ ប៉ុណ្ណោះ ខណៈ អ្នកដំណើរ ត្រូវ ចូល តាម ច្រក ទ្វារ អន្តរជាតិ ប៉ោយប៉ែត ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន បញ្ជាក់ ទៀត ថា ភាគី ថៃ ក៏ បាន ផ្តល់ ប្រាក់ កម្ចី ដើម្បី សាង សង់ ប៉ុស្តិ៍ ត្រូវ ពិនិត្យ នៅ តាម ព្រំដែន ផងដែរ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ១៥ករណី ក្នុង នោះ មាន ករណី ប្រើប្រាស់ ៨ករណី និង ជួញដូរ ៧ករណី ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៥៧ នាក់ ។
ពិធី សម្ពោធ ជា ផ្លូវការ នៃ សារមន្ទីរ « ព្រះស្រី ឦសាន វរ្ម័ន » ត្រូវបាន ប្រារព្ធ ធ្វើឡើង យ៉ាង មហោឡារិក អធិកអធម ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង មាន ការអញ្ជើញ ចូលរួម ពី មន្ត្រី ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល កម្ពុជា ថ្នាក់ដឹកនាំ មកពី តាម ក្រសួង ស្ថាប័ន នានា ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ នៃ ធានាគារ ជាតិ និង ប្រជាពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ ជាច្រើន រូប ផ្សេង ទៀត ។
« សារ មន្ទីរ សេដ្ឋកិច្ច និង រូបិយវត្ថុ ព្រះស្រី ឦសាន វរ្ម័ន » ត្រូវបាន ចាប់ផ្តើម ក សាងឡើង បន្ទាប់ពី ទទួលបាន អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក្នុង ឱកាស ប្រារព្ធ ខូប អនុស្សាវរីយ៍ ទី៣០ នៃ ការបង្កើត ធនាគារ ជាតិ នៃ កម្ពុជា ឡើងវិញ កាលពី ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០០៩មក ក្នុង គោលបំណង បង្ហាញ ជូន សាធារណជនជាតិ និង អន្តរជាតិ ពី ប្រវត្តិ សេដ្ឋកិច្ច និង រូបិយវត្ថុ របស់ កម្ពុជា ។ ការសាងសង់ និង រៀបចំ សារ មន្ទីរ នេះ មាន រយៈពេល ១០ឆ្នាំ គត់ ដើម្បី បញ្ចប់ ជាស្ថាពរ ។
ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី សម្ពោធ ជា ផ្លូវការ នៃ សារមន្ទីរ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន សម្តែង ការរីករាយ ពោរពេញ ដោយ មោទនភាព ចំពោះ វត្តមាន ជា ប្រវត្តិសាស្ត្រ នៃ សារមន្ទីរ « ព្រះស្រី ឦសាន វរ្ម័ន » ដែល កើត ចេញពី កិច្ច ខិតខំ ប្រឹងប្រែង ពី អ្នកជំនាញ ជាច្រើន រូប ក្រោម ការដឹកនាំ ផ្ទាល់ របស់ លោក ជា ចាន់តូ អគ្គ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា ។
លោក ជា ចាន់តូ បាន បន្ថែម ថា ការសាងសង់ និង រចនា នូវ អគារ សារ មន្ទីរ សេដ្ឋកិច្ច និង រូបិយវត្ថុ « ព្រះស្រី ឦសាន វរ្ម័ន » ត្រូវបាន ចាប់ផ្តើម ស្រាវជ្រាវ ពី ចំណុច សូន្យ ។ បើ តាម លោក ជា ចាន់តូ ដោយសារតែ ប្រវត្តិសាស្ត្រ របស់ កម្ពុជា មាន ការប្រែប្រួល ច្រើន និង មាន ភាពស្មុគស្មាញ ព្រមទាំង មិន សូវ មាន ការចងក្រង ឯកសារ ផង នោះ បាន បង្ក ជា ការលំបាក ក្នុង ការចងក្រង ប្រមូលផ្តុំ និង សាងសង់ នូវ សារមន្ទីរ មួយ នេះ ផងដែរ ។
សូម បញ្ជាក់ ថា សារមន្ទីរ សេដ្ឋកិច្ច និង រូបិយវត្ថុ « ព្រះស្រី ឦសាន វរ្ម័ន » ដែល ជា សារមន្ទីរ នាំឱ្យ ពលរដ្ឋ ខ្មែរ បាន ស្គាល់ ពី សាវតា នៃ ការធ្វើ សេដ្ឋកិច្ច និង រូបិយវត្ថុ ដ៏ យូរ លង់ របស់ ខ្លួន នេះ មាន ទីតាំង ស្ថិត នៅ ចំ កណ្តាល បេះដូង រាជធានី ភ្នំពេញ និង ធ្លាប់ ជា អតីត សាលាក្រុង ភ្នំពេញ ក្នុង ឆ្នាំ ១៩០៨. អតីត ក្រុមហ៊ុន អាកាសចរណ៍ ក្នុង ឆ្នាំ ១៩៩២ ។ អគារ សារ មន្ទីរ បាន បង្ហាញ ពី ចរ នាបថ សម័យ អាណាព្យាបាល នា ដើម សតវត្សរ៍ ទី២០ ។
សារ មន្ទីរ នេះ ក៏ មាន បណ្ណាល័យ ហាង លក់ វត្ថុអនុស្សាវរីយ៍ ហាង កាហ្វេ និង សួនច្បារ ដ៏ ស្រស់ស្អាត ។ បន្ទាប់ពី បើក សម្ពោធ ហើយ សាធារណជន នឹង អនុញ្ញាតឱ្យ ចូល ទស្សនា នៅក្នុង សារមន្ទីរ ដែល បង្ហាញ ពី ប្រវត្តិ នៃ ការធ្វើ សេដ្ឋកិច្ច និង រូបិយវត្ថុ របស់ កម្ពុជា តាំងពី សម័យ ហ្វូណន មួយ នេះ ។
គម្រោង ដ៏ សម្បើម ដែល មាន អគារ ចំនួន៥ បន្ទប់ សណ្ឋាគារ ចំនួន ៤. ៧២០ បន្ទប់ ជា ការប្តេជ្ញាចិត្ត ដ៏ មុតមាំ ក្នុង ការវិនិយោគទុន នៅក្នុង សេដ្ឋកិច្ច នៃ ប្រទេស កម្ពុជា ។
លោក ថា ចក្ខុវិស័យ របស់ NagaCorp គឺ ដើម្បី សាងសង់ រមណីយដ្ឋាន រួមបញ្ចូល គ្នា ដ៏ ធំ និង ទូលំទូលាយ បំផុត នៅលើ ពិភពលោក រមណីយដ្ឋាន មួយ ជាប់ នឹង ទន្លេ មេគង្គ ដ៏ ស្រស់ស្អាត និង មនោសញ្ចេតនា ដែល ជា ទន្លេ ដ៏ ធំ មួយ នៅក្នុង ទ្វីប អាស៊ី ។
គម្រោង ណាហ្គា៣ ត្រូវបាន សាងសង់ ដើម្បី បំពេញ តម្រូវការ ទេសចរ ចិន ដែល រំពឹងទុក ថា នឹង មាន ចំនួន ៥. ៥លាន នាក់ ដែល ត្រូវបាន គេ រំពឹង ថា នឹង មក ទស្សនា ប្រទេស កម្ពុជា នៅ ឆ្នាំ ២០២៥ ។
