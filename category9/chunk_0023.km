សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន គូសបញ្ជាក់ ថា សម្រាប់ ឆ្នាំ ថ្មី ឆ្នាំ កុរ ឯកស័ក ព .ស.២៥៦៣ រាជ រដ្ឋាភិបាល នៃ កម្ពុជា នឹង ខិតខំ ពុះពារ គ្រប់ បែបយ៉ាង ជា បន្ត ទៀត ដើម្បី បន្ត ថែរក្សា ការពារ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ និង សណ្តាប់ធ្នាប់ សាធារណៈ ឲ្យបាន កាន់តែ រឹងមាំ ការពារ រដ្ឋធម្មនុញ្ញ ការពារ របប រាជានិយម ស្រប តាម បាវចនា ជាតិ សាសនា ព្រះមហាក្សត្រ និង ការពារ រាល់ សមិទ្ធផល ដែល រាជ រដ្ឋាភិបាល និង ប្រជាពលរដ្ឋ ទាំងមូល សម្រេចបាន នា ពេល កន្លងទៅ ។
ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ដឹកនាំ គណៈប្រតិភូកងទ័ព កម្ពុជា ទស្សនកិច្ច ផ្លូវការ លើក ដំបូង នៅ អាមេរិក
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក បាន ដឹកនាំ គណៈប្រតិភូកងទ័ព កម្ពុជា ទៅ បំពេញ ទស្សនកិច្ច ផ្លូវការ ជា លើក ដំបូង នៅ សហរដ្ឋ អាមេរិក ដែល ទស្សនកិច្ច នេះ ធ្វើឡើង ចាប់ពី ថ្ងៃទី ៨ ដល់ ១២ ខែមេសា ឆ្នាំ ២០១៩ តាម ការអញ្ជើញ របស់ មេបញ្ជាការ នៃ បញ្ជាការដ្ឋាន ប្រតិបត្តិការ ពិសេស តំបន់ ប៉ាស៉ី ហ្វិក នៃ កងទ័ព សហរដ្ឋ អាមេរិក
បើ តាម ការផ្សព្វផ្សាយ របស់ ក្រុមការងារ របស់ លោក ហ៊ុន ម៉ាណែត គឺ ក្នុង ដំណើរទស្សនកិច្ច នេះ លោក ឧត្តមសេនីយ៍ ឯក នឹង ចូលរួម សិក្ខាសាលា អន្តរជាតិ ស្តីពី ប្រតិបត្តិការ ពិសេស តំបន់ ប៉ាស៉ី ហ្វិក « PASOC 19 » ។ នា ឱកាស នោះ ផងដែរ មេបញ្ជាការ កងទ័ព ជើងគោក នឹង ជួបពិភាក្សា ការងារ ជាមួយ មេបញ្ជាការ បញ្ជាការដ្ឋាន ប្រតិបត្តិការ ពិសេស តំបន់ ប៉ា ស៉ីហ្វិក នៃ កងទ័ព សហរដ្ឋ អាមេរិក ក្នុង គោលបំណង រឹត បណ្តឹង ចំណង មិត្តភាព និង សហប្រតិបត្តិការ នៃ កងទ័ព ប្រទេស ទាំង ពីរ កម្ពុជា - សហរដ្ឋ អាមេរិក ។
សូម ជម្រាប ថា លោក ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត បាន ឡើង កាន់ តំណែង ជា មេបញ្ជាការ កងទ័ព ជើងគោក ក្រោយ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី០៦ ។ មុននឹង មាន ទស្សនកិច្ច នៅ សហរដ្ឋ អាមេរិក នេះ លោក បាន បំពេញ ទស្សនកិច្ច នៅ បណ្តា ប្រទេស សំខាន់ មួយចំនួន ក្នុង នោះ រួម មាន ដូចជា មហា យក្ស ចិន រុស្ស៉ី និង ប្រទេស ថៃ ជាដើម ៕
រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច៖ សេដ្ឋកិច្ច ជាតិ និង សេដ្ឋកិច្ច ពលរដ្ឋ រីកចម្រើន យ៉ាង ឆាប់រហ័ស ក្រោម ម្លប់ សន្តិភាព
( ព្រៃវែង ) ៖ ថ្លែង ទៅកាន់ មន្ត្រី ថ្នាក់ ក្រោម ជាតិ នៅ ស្រុកំចាយ មារ ខេត្ត ព្រៃវែង នា ថ្ងៃទី ៧ ខែមេសា ក្នុង ពិធី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ លោក ស្តើង សុខុម រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង បាន លើកឡើង ថា សេដ្ឋកិច្ច ជាតិ និង សេដ្ឋកិច្ច ពលរដ្ឋ មាន ការរីកចម្រើន យ៉ាង ឆាប់រហ័ស ក្រោម ម្លប់ នៃ សន្តិភាព ក្នុង រយៈពេល ពីរ ទសវត្សរ៍ ចុងក្រោយ នេះ ។
រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច រូប នេះ បាន លើកឡើង ថា ក្នុង រយៈពេល ២០ ឆ្នាំ ចុងក្រោយ នេះ សេដ្ឋកិច្ច របស់ កម្ពុជា មាន កំណើន ៧ភាគរយ អត្រា នៃ ភាពក្រីក្រ បាន ថយចុះ មួយ ឆ្នាំ ជាង ១ភាគរយ ។ ជាក់ស្តែង ឆ្នាំ ២០១៨ សេដ្ឋកិច្ច កម្ពុជា សម្រេចបាន កំណើន លើស ការរំពឹងទុក ក្នុង អត្រា ៧.៥% ដែល ជា កំណើន មួយ ខ្ពស់ បំផុត ក្នុង រយៈពេល ១០ឆ្នាំ ចុងក្រោយ នេះ ។
នៅក្នុង ពី ធី សំណេះសំណាល នោះ ដែរ លោក ស្តើង សុខុម ក៏ បាន នាំយក នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ របស់ ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ជូន ចំពោះ បងប្អូន ជា មន្រ្តី នៅ មូលដ្ឋាន ។
ក្នុង នាម ជា មន្ត្រី ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក កំចាយ មារ លោក ស្តើង សុខុម បាន នាំមក ជាមួយ នូវ បទបញ្ជា និង ការណែនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ក៏ ដូចជា មតិ ណែនាំ សម្តេច ក្រឡាហោម ស ខេង ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត ព្រៃវែង ជូន ចំពោះ ប្រធាន ក្រុមប្រឹក្សា ស្រុក ប្រធាន ស្រុក និង មេឃុំ ក្រុមប្រឹក្សា ឃុំ សង្កាត់ និង មេភូមិ ត្រូវ យកចិត្តទុកដាក់ ព្រោះ វា ជា ទិសដៅ សម្រាប់ ការដឹកនាំ ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ។
នៅ ថ្ងៃ ដដែល នោះ ដែរ លោក ស្តើង សុខុម និង ប្រតិភូ អម ដំណើរ ក៏ បាន អញ្ជើញ ពិនិត្យមើល ការស្ថាបនា ផ្លូវ បេតុង នៅក្នុង សាលា បឋមសិក្សា មហា ឧបាសក ស ប៊ិត និង មហា ឧបាសិកា ម៉ុក សែម ព្រៃ ទួល ។ បន្ទាប់មក លោក ប្រធាន ក្រុមការងារ ក៏ បាន បន្ត ដំណើរ ទៅ ពិនិត្យមើល ទីតាំង សម្រាប់ កសាង អគារ សិក្សា ស្មាច់ ស្ថិត ក្នុង ភូមិ ស្មាច់ ឃុំ ក្រ បៅ និង បាន បន្ត ដំណើរ ទៅ ពិនិត្យមើល ការកសាង ផ្លូវ បេតុង នៅក្នុង សាលា បឋមសិក្សា ក្របៅ ថ្មី ។
ចុងក្រោយ លោក ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក កំចាយ មារ ក៏ បាន បន្ត ដំណើរ ទៅ ពិនិត្យមើល ការដ្ឋាន សាងសង់ អគារ សិក្សា ចំនួន ៤ ខ្នង ១៦ បន្ទប់ បណ្តាល័យ មួយ និង តារាង បាល់ទាត់ ដែល ជា អំណោយ របស់ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី នៅ អនុវិទ្យាល័យ មិត្តភាព កម្ពុជា ឥណ្ឌូនេស៊ី ក្នុង ឃុំ ត្របែក ស្រុក កំចាយ មារ ។
( ភ្នំពេញ ) ៖ ដើម្បី អបអរ ពិធី បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ ដែល នឹង ឈានចូល មកដល់ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ រាល់ អតិថិជន ដែល ទិញ វីឡា ទោល ពី បុរី ឡុង នី ចាប់ពី ថ្ងៃទី១ ខែមេសា ដល់ ថ្ងៃទី ១៥មេសា ឆ្នាំ ២០១៩ លើ គម្រោង ទី២ និង ទី៣ បុរី ឡុង នី ដែល ជា ប្រភេទ លំនៅឋាន ដ៏ សំបូរ បែប ធ្វើឱ្យ អតិថិជន ពេញចិត្ត ក្នុង ការរស់នៅ នោះ នឹង ទទួលបាន កាដូរ ម៉ាស៊ីនភ្លើង ១ គ្រឿង ភ្លាម តែម្តង ។
ការជ្រើស ទិញ ផ្ទះ ឬ លំនៅឋាន ពិតជា ការពិបាក ក្នុង ការសំរេចចិត្ត ក៏ប៉ុន្តែ បើ លោកអ្នក សំរេចចិត្ត ជ្រើសយក បុរី ឡុង នី គឺ មិន ចាំបាច់ ពិបាកចិត្ត ទេ ដោយ ហេតុ ថា បុរី ឡុង នី ជា លំនៅឋាន នៅក្នុង ក្តី សុបិន្ត របស់ លោក អ្នក និង ជា បុរី ទី១ ដែល យល់ ចិត្ត និង អារម្មណ៍ ដែល លោក អ្នក ត្រូវការ គឺ មិន ជ្រាប ទឹក ។
បុរី ឡុង នី សូម ណែនាំ ប្រភេទ វីឡា កូន កាត់ ( តូច ឬ ធំ ) ជា ប្រភេទ វីឡា ម៉ូត ថ្មី សន្លាង ដែល ស្រស់ស្អាត ទាំង រូប ខាងក្រៅ និង ខាងក្នុង ដែល ធ្វើឱ្យ លោក អ្នក ទទួលបាន នូវ អារម្មណ៍ ត្រជាក់ចិត្ត និង ពោរពេញ ដោយ ក្តី សប្បាយរីករាយ ជាមួយនឹង ក្រុមគ្រួសារ ។
ទីតាំង គំរោង ២៖ ផ្លូវ៣០ ម៉ែត្រ ភូមិ ទួល ពង្រ សង្កាត់ ចោម ចៅ១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ( បត់ ឆ្វេង ត្រង់ ស្តុប អាងទឹក ផ្លូវ វេង ស្រេង ប្រហែល700 ម៉ែត្រ ) ។
ទេសរដ្ឋមន្ដ្រី គន់ គីម អញ្ជើញ ប្រកាស សមាសភាព ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត ឧត្ដរ មានជ័យ និង ផ្សព្វផ្សាយ យុទ្ធសាស្ដ្រ រាជ រដ្ឋាភិបាល
( ឧត្ដរ មានជ័យ )៖ ទេសរដ្ឋមន្ដ្រី គន់ គីម ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ខេត្ត ឧត្តរមានជ័យ និង លោក ងី ចន្ទ្រ ផល នៅ ព្រឹក ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ នេះ អញ្ជើញ ប្រកាស សមាសភាព ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ដើ ម្បី ត្រួតពិនិត្យ និង គាំទ្រ ការ អនុវត្ត កម្មវីធី នយោបាយ និង យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ប្រចាំ ខេត្ត ឧត្ដរ មានជ័យ និង ប្រជុំ ការងារ លើក ដំបូង ។
ទេសរដ្ឋមន្រ្តី គន់ គីម ក្នុង នាម ប្រធាន ក្រុម ការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត ឧត្ដរ មានជ័យ បាន ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ លោក លោក ស្រី មកពី បណ្តា ក្រសួង ស្ថាប័ន ដែល ត្រូវបាន ចាត់តាំង ឲ្យ មក បំពេញ ការងារ ជា ក្រុមការងារ ថ្នាក់ ជាតិ នៅ ខេត្ត ឧត្ដរ មានជ័យ នេះ និង សូមឲ្យ ក្រុមការងារ ត្រូវ រួម សាមគ្គី គ្នា និង សហការ ល្អ ជាមួយ មូលដ្ឋាន ។
( រតនគិរី ) ៖ លោក ថង សាវុន អភិបាល ខេត្ត រតនគិរី នៅ ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន បើក កិច្ចប្រជុំ ដើម្បី ត្រួតពិនិត្យ ទីតាំង និង បង្កើត ក្រុមការងារ ទទួលបន្ទុក រៀបចំ សង្រ្កាន្ត « រតនគិរី » នា ឱកាស បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ ដែល នឹង ខិត ជិត មកដល់ នា ពេល ឆាប់ ៗ ខាង នេះ ឱ្យ ទទួលបាន ជោគជ័យ ។
នៅក្នុង កិច្ចប្រជុំ នេះ ដែរ លោក អភិបាល ខេត្ត ក៏ បាន សម្រេច ដាក់ ឈ្មោះ សង្រ្កាន្ត « រតនគិរី » ហើយ កំណត់ យក ទីតាំង បរិវេណ មន្ទីរ វប្បធម៌ និង វិចិត្រ ខេត្ត ជា កន្លែង ប្រារព្ធ ពិធី សង្រ្កាន្ត ដើម្បី អបអរសាទរ ក្នុង ឱកាស ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល នឹង ឈាន មកដល់ ខាងមុខ នេះ និង បង្កើត ក្រុមការងារ រៀបចំ កម្ម ពិធី កម្សាន្ត នានា នៅក្នុង ទីក្រុង បាន លុង ដែល ជា ទី រួម ខេត្ត ផងដែរ ។
ការលើកឡើង របស់ សម្តេច ក្រឡាហោម ស ខេង បាន ថ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល លោក ចុះ ពិនិត្យ ទីតាំង សាងសង់ អាង ហែលទឹក សកលវិទ្យាល័យ បាត់ដំបង ។ ពិធី នេះ ក៏ មាន ការចូលរួម អម ដំណើរ ដោយ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន រួមទាំង ក្រុមការងារ លោកគ្រូ អ្នកគ្រូ សិស្ស និស្សិត ជាច្រើន រូប ផងដែរ ។
( ភ្នំពេញ ) ៖ ដំណេក ជា វដ្ដ ធម្មជាតិ នៃ រាងកាយ និង ផ្លូវចិត្ដ របស់ មនុស្ស ដែល ផ្សារភ្ជាប់ ជាមួយ ការ កាត់ផ្ដាច់ការទទួល ដឹង ញាណ ទាំងឡាយ ការកាត់ផ្ដាច់ ស្ទើរ ទាំងអស់ នូវ ការភ្ញោច រាល់ សាច់ដុំ ឆន្ទះ និង បន្ថយ ការឆ្លើយតប ទៅនឹង មជ្ឈដ្ឋាន ខាងក្រៅ ។
ជំងឺ ដំណេក ដែល កើត ពី រឿង របស់ គេ វិញ គឺ មកពី សម្ពាធ សង្គម ដែល មាន ជុំវិញ ខ្លួន យើង ការធ្វើ ការ ការរស់នៅ បាន ធ្វើឱ្យ យើង គិត ច្រើន ដោយ ពេល ខ្លះ ធ្វើឱ្យ យើង មាន ជំងឺ ផ្លូវចិត្ដ ដូច ជា៖ ជំងឺ ថប់ អារម្មណ៍ ជំងឺ ធ្លាក់ទឹកចិត្ដ ជំងឺ មេនៀរ ( មិន គ្រប់ ទឹក ) និង ជំងឺ វិកលចារិក ជាដើម ។ បងប្អូន មួយចំនួន ដើម្បី បំបាត់ វិបត្ដិ នេះ គឺ តែងតែ ប្រើប្រាស់ សារធាតុ ញៀន ដូចជា កាហ្វេអ៊ីន និង សារធាតុ ភ្ញោច គ្រឿងស្រវឹង ថ្នាំ ព្យាបាល មួយចំនួន ផងដែរ ដែល នេះ មិន សមស្រប នោះ ទេ ។
លោក វេជ្ជបណ្ឌិត យឹម សុបុត្រា បាន ថ្លែង បន្ដ ថា « ដូច្នេះ ប្រសិនបើ មាន វិបត្ដិ នេះ កុំ គិត ថា ជា រឿង ធម្មតា និង ទៅ ថ្នាំ ងងុយ គេង និង ថ្នាំ ជំនួយ ណាមួយ ព្យាបាល ដោយ ខ្លួន ឱ្យ សោះ ព្រោះ វា នឹង បណ្ដាល ឱ្យ គ្រោះថ្នាក់ ម្ដង បន្ដិច ៗ ដាច់ខាត ត្រូវ មក ពិគ្រោះ ជាមួយ គ្រូពេទ្យ ជំនាញ ដើម្បី ស្វែងយល់ ពី ជំងឺ របស់ ខ្លួន និង អាច ព្យាបាល ឆាប់ មាន ប្រសិទ្ធិភាព ខ្ពស់ » ។
ទន្ទឹម នឹង នោះ ផងដែរ លោក វេជ្ជបណ្ឌិត ក៏ បាន បង្ហាញ ពី គន្លះ ១០យ៉ាង ដើម្បី ទទួលបាន ដំណេក ប្រកបដោយ សុខ ភាព៖
សូម បញ្ជាក់ ថា ដើម្បី ឆ្លើយតប ទៅនឹង បញ្ហា នេះ ហើយ ប្រធាន មូលនិធិ អៀង លោក អៀង សុធារ៉ា ដែល ជា ស្ថាបនិក នៃ សិក្ខាសាលា សាធារណៈ នេះ បាន រៀបចំ សិក្ខាសាលា សុខភាព ផ្លូវចិត្ដ នេះ ឡើង ក្រោម ប្រធានបទ « វិបត្ដិ ដំណេក » ដើម្បី ចូលរួមចំណែក ក្នុង ការលើកស្ទួយ វិស័យ អប់រំ និង សុខភាព ទៅដល់ ពលរដ្ឋ កម្ពុជា ទាំងអស់ ។ ដោយ ស្ថានិក រូប នេះ យល់ ថា នេះ គឺជា រឿង ចំាបាច់ បំផុត ដើម្បីឱ្យ មនុស្ស ទទួលបាន សុភមង្គល និង ជោគជ័យ ក្នុង ដំណើរ ជីវិត ៕
( ភ្នំពេញ ) ៖ ដោយសារតែ មាន ការគាំទ្រ ខ្ពស់ និង ទំនុកចិត្ត ពី អតិថិជិន ដែក ថែប អ៊ីតាលី ម៉ាក វី (V) ដែល ជា ផលិតផល ដែល ត្រូវបាន ទទួល សិទ្ធ ធ្វើ ពាណិជ្ជកម្ន និង នាំចូល ផ្តាច់ មុខ ដោយ ក្រុមហ៊ុន ជី ប ម៉ុង ចាប់តាំងពី ឆ្នាំ ១៩៩៧មក ។
ជាមួយគ្នា នេះ ដែរ ក៏ ត្រូវបាន ផលិតផល ដែក ថែប របស់ ក្រុមហ៊ុន ផ្សេង ៗ ទៀត បាន យក ទៅ ប្រើប្រាស់ អក្សរ និមិត្ត សញ្ញា ស្រដៀង គ្នា ដែល ធ្វើឱ្យ អតិថិជន មាន ការភាន់ច្រលំ ។
ដែក ថែប អ៊ីតាលី ម៉ាក វី គឺជា ដែក ថែប ដែល បាន ទទួល វិញ្ញាបនបត្រ ស្តង់ដារ ISO 9001:2008 បញ្ជាក់ គុណភាព និង ទទួលបាន ទំនុកចិត្ត ខ្ពស់ ភាព ជឿជាក់ ពីសំណាក់ អតិថិជន អ្នកសាងសង់ និង វិស្វករ នានា ដោយសារ តែ រាល់ វត្ថុធាតុ ដើម ដែល យកមក ផលិត ដែក ថែប ម៉ាក វី (V) សុទ្ធសឹងតែ ជា វត្ថុធាតុ ដើម ល្អ បំផុត លំដាប់ ពិភពលោក ដោយ ប្រើប្រាស់ បច្ចេកវិទ្យា ទំនើប ចុងក្រោយ បង្អស់ ពី ប្រទេស អ៊ីតាលី និង ត្រួតពិនិត្យ យ៉ាង យកចិត្តទុកដាក់ ដោយ វិស្វករ ជំនាញ ។
ដែក ថែប អ៊ីតាលី ម៉ាក វី (V) គឺជា ផលិតផល ជម្រើស ទី មួយ សម្រាប់ វិស័យ សំណង់ ជាច្រើន ទសវត្សរ៍ ក្នុង ទីផ្សារ កម្ពុជា ដោយ តែងតែ ត្រូវបាន ជ្រើសរើស ប្រើប្រាស់ នៅក្នុង គម្រោង សាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ ធំ ៗ ដូចជា ផ្លូវថ្នល់ សណ្ឋាគារ អគារ ខ្ពស់ ៗ ដែល កំពុង លេចចេញ ជា រូបរាង គ្រប់ ទីកន្លែង ក្នុង ប្រទេស កម្ពុជា ៕
ធនាគារ ជាតិ នៃ កម្ពុជា៖ វិស័យ ធនាគារ នៅ កម្ពុជា ត្រូវបាន ទទួលស្គាល់ ថា មាន លក្ខណៈ បើក ទូលាយ និង មាន សមាហរណកម្ម ខ្ពស់ ក្នុង តំបន់
( ថៃ )៖ វិស័យ ធនាគារ នៅ កម្ពុជា ត្រូវបាន ទទួលស្គាល់ ថា មាន លក្ខណៈ បើក ទូលាយ ហើយ មាន សមាហរណកម្ម ខ្ពស់ ក្នុង តំបន់ ដោយ បច្ចុប្បន្ន គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ មកពី ប្រទេស ក្នុង តំបន់ ភាគ ច្រើន មាន វត្តមាន នៅ កម្ពុជា ។ បើ តាម ការឲ្យដឹង ពី លោក ជា ចាន់តូ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា ។
ការលើកឡើង បែប នេះ របស់ លោក ជា ចាន់តូ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក អញ្ជើញ ចូលរួម កិច្ចប្រជុំ ថ្នាក់ ទេសាភិបាល ធនាគារ កណ្តាល អាស៊ាន លើក ទី ១៥ និង កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្រ្តី ហិរញ្ញវត្ថុ និង ទេសាភិបាល ធនាគារ កណ្តាល អាស៊ាន លើក ទី៥ នៅ ខេត្ត ឈៀង រ៉ៃ ប្រទេស ថៃ ។
កិច្ចប្រជុំ ជាន់ ខ្ពស់ កម្រិត តំបន់ នៃ វិស័យ ហិរញ្ញវត្ថុ នេះ មាន គោលបំណង ពិនិត្យ និង ពិភាក្សា លើ វឌ្ឍនភាព សមាហរណកម្ម និង កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ ហិរញ្ញវត្ថុ អាស៊ាន ដើម្បី គាំទ្រ កំណើន សេដ្ឋកិច្ច និង ពង្រឹង ស្ថិរភាព ហិរញ្ញវត្ថុ ក្នុង តំបន់ ស្រប តាម គោលដៅ នៃ ផែនការ សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន ឆ្នាំ ២០២៥ ។
ធនាគារ ជាតិ នៃ កម្ពុជា បាន ដើរ តួនាទី គន្លឹះ មួយ ក្នុង សមាហរណកម្ម ហិរញ្ញវត្ថុ អាស៊ាន បាន ចូលរួម ពង្រឹង សមាហរណកម្ម វិស័យ ធនាគារ និង ការតភ្ជាប់ ប្រព័ន្ធ ទូទាត់ ក្នុង តំបន់ ។ វិស័យ ធនាគារ កម្ពុជា ត្រូវបាន ទទួលស្គាល់ ថា មាន លក្ខណៈ បើក ទូលាយ ហើយ មាន សមាហរណកម្ម ខ្ពស់ ទៅក្នុង តំបន់ ដោយ បច្ចុប្បន្ន គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ មកពី ប្រទេស ក្នុង តំបន់ ភាគ ច្រើន មាន វត្តមាន នៅ កម្ពុជា ។
គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ទាំងនេះ បាន នាំមក នូវ មូលធន និង បច្ចេកវិទ្យា ដែល ផ្តល់ បរិយាកាស អំណោយផល ដល់ ការអភិវឌ្ឍ វិស័យ ធនាគារ នៅ កម្ពុជា ។ ម្យ៉ាងទៀត កម្ពុជា បាន តភ្ជាប់ ប្រព័ន្ធ ទូទាត់ របស់ ខ្លួន ជាមួយ ប្រទេស ក្នុង តំបន់ និង ពិភពលោក ។
បច្ចុប្បន្ន ធនាគារ ជាតិ នៃ កម្ពុជា កំពុង អភិវឌ្ឍ ប្រព័ន្ធ ទូទាត់ តាមរយៈ បច្ចេកវិទ្យា ទំនើប រួម មាន៖ ប្រព័ន្ធ QR Code ជាមួយ ប្រទេស ក្នុង តំបន់ ដូចជា ប្រទេស ថៃ ជាដើម ។ ការទូទាត់ តាម ប្រព័ន្ធ QR Code នឹង រួមចំណែក លើកកម្ពស់ ប្រសិទ្ធភាព ទូទាត់ ឱ្យ មាន សុវត្ថិភាព និង ចំណាយ ទាប សមរម្យ ។
( ភ្នំពេញ ) ៖ តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ បាន ប្រារព្ធ ឡើង នូវ កម្មវិធី ប្រគំ តន្រ្តី ដ៏ ធំ ប្រចាំ ឆ្នាំ របស់ ខ្លួន ដែល មាន ឈ្មោះ ថា « សង្រ្កាន្ត ភីភី អេស អ៊ីហ្សិត ២០១៩ » បាន យ៉ាង ជោគជ័យ ដើម្បី ស្វាគមន៍ សង្រ្កាន្ត ឆ្នាំ ថ្មី ដែល នឹង ខិត ចូល មកដល់ និង ដើម្បី ផ្តល់ ភាពសប្បាយរីករាយ ដល់ កម្មករ និយោជិត និង ប្រជាពលរដ្ឋ ដែល រស់ នៅ ជុំវិញ តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ ប្រមាណ ជាង ៣ម៉ឺន នាក់ ។
កម្មវិធី នេះ ប្រព្រឹត្ត ឡើង ក្រោម អធិបតីភាព របស់ លោក ជា វុទ្ធី អគ្គ លេខាធិការ រង នៃ គណៈកម្មាធិការ តំបន់ សេដ្ឋកិច្ច ពិសេស កម្ពុជា និង ជា ប្រធាន រដ្ឋបាល តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ លោកស្រី អ៊ុក ដារ៉ា មេបញ្ជាការ រង កងពល តូច លេខ ៧០ និង លោក ហែម ដារិទ្ធ អភិបាល នៃ គណៈអភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ ។
អភិបាល ក្រុមហ៊ុន ភ្នំពេញ អេស អ៊ីហ្សិត ភី អិល ស៊ី លោក តាន់ កាក់ ឃុន បាន លើកឡើង ថា បើក កម្មវិធី ថា « នេះ គឺជា ឆ្នាំ ទី៦ ហើយ ដែល ក្រុមហ៊ុន បាន រៀបចំ កម្មវិធី ប្រគុំត ន្រ្តី នេះ ឡើង » ។
កម្មវិធី នេះ ជា កិច្ច ស្វាគមន៍ ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ នឹង ជា កាដូ ដល់ ប្អូន ៗ ក្មួយ ៗ កម្មករ កម្ម ការិនី និង ប្រជាពលរដ្ឋ ដែល បាន មក លេង កំសាន្ត មុនពេល ត្រឡប់ ទៅ ជួបជុំ ឪពុក ម្តាយ និង បងប្អូន ឯ ស្រុក កំណើត នា ថ្ងៃ ចូល ឆ្នាំ ខ្មែរ ខាងមុខ នេះ ។
លោក បាន បន្ថែម ទៀត ថា ថ្ងៃ នេះ យើង ទាំងអស់ គ្នា នឹង បាន ឃើញ កម្មករ កម្ម ការិនី ក្នុង តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ មិន ត្រឹមតែ មាន ជំនាញ ការងារ ក្នុង រោងចក្រ ប៉ុណ្ណោះ ទេ ពួកគាត់ ក៏ នៅ មាន សមត្ថភាព និង ទេពកោសល្យ ផ្នែក សិល្បៈ ពិសេស ៗ រៀង ៗ ខ្លួន ថែម ទៀត ផង ។
ជា កិច្ច បញ្ចប់ នូវ ចំណាប់អារម្មណ៍ ដ៏ មាន ន័យ លោក ជា វុទ្ធី បាន ជូន ពរ ដល់ ក្មួយ ៗ ភ្ញៀវ កិត្តិយស ក៏ ដូចជា ក្មួយ ៗ កម្មករ កម្ម ការិនី ទាំងអស់ ដែល បាន មក ទស្សនា យ៉ាង ច្រើន កុះករ នា រាត្រី នេះ ឲ្យ ជួបប្រទះ តែ នឹង ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
( កំពង់ចាម ) ៖ ដើម្បីឲ្យ ប្រជាពលរដ្ឋ មាន ភាពសប្បាយរីករាយ ដោយ សុខដុមរមនា ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ នា ពេល ខាងមុខ នេះ អភិបាល ខេត្ត កំពង់ចាម លោក គួច ចំរើន បាន ត្រៀម កងកម្លាំង ប្រមាណ ជាង ១ម៉ឺន នាក់ ដើម្បី ថែរក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ នៅ ទូទាំង ខេត្ត កំពង់ចាម ផងដែរ ។
លោក អភិបាល ខេត្ត កំពង់ចាម បាន ថ្លែង ដូច្នេះ នៅក្នុង ពិធី ប្រជុំ ត្រួតពិនិត្យ ការងារ ស្ដីពី ផែនការ បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ ដោយ មាន ការចូលរួម ពី មន្ទីរ ពាក់ព័ន្ធ ជុំវិញ ខេត្ត និង អភិបាល ស្រុក - ក្រុង ទាំង១០ នៅ ព្រឹក ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩នេះ នៅ សាល ប្រជុំ សាលា ខេត្ត កំពង់ចាម ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា សម្រាប់ កងកម្លាំង ទាំងអស់ គឺ មាន ចំនួន ១២. ៥៤៥ នាក់ ដែល ក្នុង នោះ រួម មាន៖ មន្ត្រី នគរបាល មាន ចំនួន ១.០៨៧ នាក់ . អាវុធហត្ថ ៥១ នាក់ . យោធា ចំនួន ១២៧ នាក់ . និង កម្លាំង ប្រជាការពារ ១១. ២៨០ នាក់ ហើយ កម្លាំង ទាំងអស់ ត្រៀម ចូលរួម អនុវត្ត តាម ផែនការដឹកនាំ របស់ គណៈ បញ្ជាការ ឯកភាព ក្រុង - ស្រុក ដើម្បី ថែរក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ ជូន ប្រជា ពលរដ្ឋ កម្សាន្ត សប្បាយ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ ខាងមុខ នេះ ។
លោក បាន បន្ត ថា « ត្រូវ ត្រៀម កម្លាំម ត្រៀមលក្ខណៈ នៅក្នុង ហេតុការណ៍ ដែល អាចនឹង កើតឡើង ផ្សេង ៗ ដូចជា អ្នក ទៅ កម្សាន្ត នៅ តាម ទឹក ទន្លេ . ផ្នែក អគ្គីភ័យ . ផ្នែក សុខាភិបាល . ពោលគឺ គ្រប់ ហេតុការណ៍ ដែល កើតឡើង យើង ត្រូវ រួមគ្នា ដោះស្រាយ ឲ្យបាន ទាន់ ពេលវេលា ផងដែរ » ។
( កំពត) ៖ នៅ ព្រឹក ថ្ងៃច័ន្ទ ៤កើត ខែ ចេត្រ ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស ២៥៦២ ត្រូវ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ នេះ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត បាន ជួប សំណេះសំណាល ជាមួយ យុវជន គណបក្ស ប្រជាជន កម្ពុជា សម្ព័ន្ធ ភាព យុវជន ស្រលាញ់ សន្តិភាព និង សហភាព សហព័ន្ធ យុវជន កម្ពុជា ប្រមាណ ជាង ៦០០ នាក់ ។
ក្នុង ជំនួប សំណេះសំណាល នោះ លោក អភិបាល ខេត្ត ជា វ តាយ បាន ណែនាំ ផ្ដាំផ្ញើ ដល់ ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព អាជ្ញាធរ ក្រុង កំពត និង ក្រុម យុវជន ទាំង បី ផ្នែក ត្រូវ ត្រៀមលក្ខណៈ ចូលរួម លេង ក្នុង កម្មវិធី បង្ក ការកម្សាន្ត សប្បាយ ក្នុង ព្រឹត្តិការណ៍ កំពត សង្ក្រាន្ត ឆ្នាំ ២០១៩ នេះ ។ រដ្ឋបាល ខេត្ត កំពត រៀបចំ សង្ក្រាន្ត ចាប់ពី ថ្ងៃទី ១៣ដល់ ថ្ងៃ ១៦ ខែមេសា ឆ្នាំ ២០១៩ ។
លោក អភិបាល ខេត្ត ក៏ សង្ឃឹម ថា ព្រឹត្តិការណ៍ កំពត សង្ក្រាន្ត ដែល រដ្ឋបាល ខេត្ត កំពត រៀបចំ ឆ្នាំ នេះ នឹង មាន ភាព កាន់តែ ធំ និង សប្បាយរីករាយ ព្រមទាំង មាន ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរណ៍ ជាតិ - អន្តរជាតិ ចូលរួម កម្សាន្ដ រីករាយ ជាង បណ្ដា ឆ្នាំ កន្លងទៅ ។
ក្នុង ឱកាស ជួប សំណេះសំណាល ជាមួយ យុវជន ទាំង បី ក្រុម នោះ លោក ជា វ ក៏ បាន ជូន ថវិកា ដល់ យុវជន ទាំង បី ក្រុម ជាង ៦០០ នាក់ ដែល ត្រូវ ចូលរួម ក្នុង កម្មវិធី កំពត សង្ក្រាន្ដ សរុប ចំនួន ១៨.០០០ ដុល្លារ អាមេរិក ផងដែរ ៕
( ភ្នំពេញ ) ៖ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន បង្ហាញ លទ្ធផល នៃ ការអញ្ជើញ ចូលរួម របស់ គណៈប្រតិភូ របស់ ខ្លួន ក្នុង វេទិកា នយោបាយ អាស៉ី - អឺរ៉ុប លើក ទី៣ និង កិច្ចប្រជុំ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ អាយ កាប់ លើក ទី ៣២ នៅ រដ្ឋធានី កូឡុំ បូ ស្រីលង្កា ចាប់ពី ថ្ងៃទី ០៥ ដល់ ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០១៩ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ គណបក្ស ប្រជាជន កម្ពុជា៖
សម្ដេច តេជោ ហ៊ុន សែន៖ ការមើល រំលង រូបិយវត្ថុ ជាតិ ធ្វើឲ្យ បាត់បង់ ម្ចាស់ ការលើ ការគ្រប់គ្រង សេដ្ឋកិច្ច និង អធិបតេយ្យ ជាតិ (Video inside) ( ភ្នំពេញ ) ៖ ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា សម្ដេច តេជោ ហ៊ុន សែន នៅ ព្រឹក ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន លើកឡើង ថា ការមើល រំលង តួនាទី រូបិយវត្ថុ ជាតិ ធ្វើឲ្យ បាត់បង់ ភាព ម្ចាស់ការ លើ ការគ្រប់គ្រង សេដ្ឋកិច្ច អធិបតេយ្យ ជាតិ ហើយ ប្រទេសជាតិ នឹង មាន ភាពទន់ខ្សោយ ។
ក្នុង ឱកាស អញ្ជើញ សម្ពោធ ដំណើរការ ជា ផ្លូវការ នូវ សារ មន្ទីរ សេដ្ឋកិច្ច និង រូបិយវត្ថុ « ព្រះស្រី ឦសាន វរ្ម័ន » ដែល ជា សារមន្ទីរ បង្ហាញ អំពី សាវតា សេដ្ឋកិច្ច និង រូបិយវត្ថុ របស់ ខ្មែរ តាំងពី សម័យកាល ហ្វូណន សម្ដេច តេជោ ហ៊ុន សែន បាន អះអាង ថា ដែល កត្តា ទាំងអស់ នេះ ជំរុញ ឲ្យ ព្រះមហាក្សត្រ ខ្មែរ មួយចំនួន ព្យាយាម កសាង អធិបតេយ្យ ជាតិ ដោយ បាន បោះផ្សាយ រូបិយវត្ថុ ជាតិ ដោយ ខ្លួន ឯង ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ការមើល រំលង តួនាទី រូបិយវត្ថុ ជាតិ ធ្វើឲ្យ បាត់បង់ ភាព ម្ចាស់ការលើ ការគ្រប់គ្រង សេដ្ឋកិច្ច អធិបតេយ្យ ជាតិ ហើយ ប្រទេសជាតិ នឹង មាន ភាពទន់ខ្សោយ លើ គ្រប់ វិស័យ ដែល កត្តា ទាំងអស់ នេះ បាន ជំរុញ ឲ្យ ព្រះមហាក្សត្រ ខ្មែរ មួយចំនួន ព្យាយាម កសាង អធិបតេយ្យ ជាតិ ដោយ បាន បោះផ្សាយ រូបិយវត្ថុ ជាតិ ដោយ ខ្លួន ឯង » ។
សម្ដេច បាន គូសបញ្ជាក់ ថា កម្ពុជា ធ្លាប់ បាន ប្រើប្រាស់ រូបិយវត្ថុ ដែល មាន ប្រភព ពី តំបន់ ផ្សេង ៗ តាមរយៈ ការធ្វើ ពាណិជ្ជកម្ម ជាមួយ បរទេស តាំងពី សតវត្ស ទី១ នៅ សម័យ នគរ ភ្នំ រហូតមកដល់ សម័យ អង្គរ ពេល ដែល កម្ពុជា បាន ក្លាយជា អាណាចក្រ មាន ការរីកចម្រើន ដល់ កំពូល ប៉ុន្តែ កម្ពុជា ពុំ បាន បោះពុម្ព រូបិយវត្ថុ ជាតិ នោះ ទេ តែ បាន ប្រើប្រាស់ ប្រាក់ សំប៉ែត ដែល នាំមក ដោយ ជនជាតិ ចិន ។
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០១៩ នេះ លោក វរសេនីយ៍ ឯក សឹង្ហ ទុំ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ កងពល តូច ថ្មើរជើង លេខ ៥១ បាន ដឹកនាំ កម្លាំង ចុះ ជួយ រុះរើ ជួសជុល ផ្ទះ ជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ខ្យល់ កន្រ្តាក់ រលំ ផ្ទះ ជាច្រើន ខ្នង នា ល្ងាច ថ្ងៃ៧ ខែមេសា ឆ្នាំ ២០១៩ សរុប ចំនួន ៤៨ ខ្នង ស្ថិត នៅក្នុង ស្រុក ចំនួន ២ ឃុំ តា គង់ ស្រុក ម៉ាឡៃ និង ឃុំ សឿ ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ ។
លោក វរសេនីយ៍ ឯក សឹង្ហ ទុំ បាន ឱ្យដឹង ថា កាលពី រសៀល ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០១៩ ភ្ញៀវ មួយ មេ ធំ លាយឡំ ផ្គរ ន្ទះ ជាខ្លាំង បណ្តាលឱ្យ រលំ ផ្ទះ ប្រជាពលរដ្ឋ ព្រមទាំង ខូចខាត សម្ភារ មួយចំនួន ក៏ប៉ុន្តែ មិន បង្កឱ្យ ប៉ះពាល់ អាយុជីវិត ប្រជាពលរដ្ឋ ណា ម្នាក់ នោះ ឡើយ ។ នា ពេល នោះ ដែរ ប្រជាពលរដ្ឋ បាន សម្តែង ភាពសោមនស្ស រីករាយ បាន ឃើញ អាជ្ញាធរ ស្រុក - ខេត្ត និង កម្លាំងប្រដាប់អាវុធ តែងតែ យកចិត្តទុកដាក់ ខ្លាំង ចំពោះ ពួកគាត់ ។
គេ សង្កេតឃើញ ចុះ ទៅ រុះរើ និង កសាង ជួសជុល ផ្ទះ ប្រជាពលរដ្ឋ ឡើងវិញ មិន តែ ប៉ុណ្ណោះ នាំយក ស័ង្កសី ជាច្រើន សន្លឹក និង អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ដែល ជា អំណោយ របស់ ឧប នាយក រដ្ឋមន្រ្តី កែ គឹម យ៉ាន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត បន្ទាយមានជ័យ យក ទៅ ប្រគល់ ជូន ដល់ ដៃ ប្រជាពលរដ្ឋ រង ខូចខាត ផ្ទះ ដើម្បី ជួយ សង្រ្គោះ បឋម ដើម្បី ដោះស្រាយ ទុក លំបាក់ របស់ ប្រជាពលរដ្ឋ ៕
រូប ប្រាសាទ យាយ ព័ន្ធ ក្លាយជា និមិត្ត សញ្ញា សម្រាប់ ខេត្ត កំពង់ធំ ជា ផ្លូវការ
បើ តាម សេចក្តីប្រកាស នេះ គឺ និមិត្ត សញ្ញា ខេត្ត កំពង់ធំ នឹង ត្រូវ ដាក់ ឱ្យ ប្រើប្រាស់ ដូចជា ដាក់ នៅ កន្លែង ធ្វើការងារ ដាក់ នៅលើ ក្បាល លិខិត ឯកសារ និង ស្រោម សំបុត្រ ផ្លូវការ ប្រើប្រាស់ ក្នុង ពិធី នានា របស់ រដ្ឋបាល ខេត្ត កំពង់ធំ និង ប្រើប្រាស់ ក្នុង ករណី ផ្សេង ៗ របស់ ខេត្ត កំពង់ធំ ដែល ចាំបាច់ ៕
រដ្ឋមន្ត្រី ក្រសួង ដឹកជញ្ជូន កម្ពុជា - ថៃ គ្រោង បើក កិច្ចប្រជុំ ដើម្បី បើក ឱ្យ ឆ្លងកាត់ ព្រំដែន តាម ផ្លូវ ដែក និង តាម ច្រក ស្ទឹង បត់
( បន្ទាយមានជ័យ ) ៖ រដ្ឋមន្ត្រី ក្រសួង ដឹកជញ្ជូន កម្ពុជា - ថៃ នឹង បើក កិច្ចប្រជុំ បើក ការឆ្លងកាត់ ព្រំដែន តាម ផ្លូវ ដែក ប៉ោយប៉ែត - ខ្លង លឹក និង តាម ច្រក ព្រំដែន ថ្មី ស្ទឹង បត់ - ណង អៀន នា ពេល ដ៏ ខ្លី ខាងមុខ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ មន្រ្តី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
សមាគម សហគ្រិន ស្រ្ដី ព្យាយាម ស្វះស្វែង ជំរុញ ឲ្យ មាន ការចាប់ផ្ដើម អាជីវកម្ម របស់ ស្រ្ដី កម្ពុជា
( ភ្នំពេញ ) ៖ ដើម្បី លើកកម្ពស់ ស្រ្ដី ឲ្យ មាន ភាពក្លាហាន ក្នុង ការប្រកប អាជីវកម្ម ផ្សេង ៗ សមាគម សហគ្រិន ស្រ្ដី កម្ពុជា បាន និង កំពុង រិះរក មធ្យោបាយ គ្រប់ បែបយ៉ាង ដើម្បី ជំរុញ លើកទឹកចិត្ត ស្រ្ដី ឲ្យ មាន ការចាប់ផ្ដើម អាជីវកម្ម ។ នេះ បើ តាម ការលើកឡើង ពី លោកស្រី អេង លី គង់ ប្រធាន សមាគម សហគ្រិន ស្រ្ដី កម្ពុជា ឲ្យដឹង ក្នុង កម្មវិធី ខួប អនុស្សាវរីយ៍ លើក ទី៧ របស់ សមាគម សហគ្រិន ស្រ្ដី កម្ពុជា ដែល រៀបចំឡើង នៅ យប់ ថ្ងៃទី ៧ ខែមីនា ឆ្នាំ ២០១៩ ។
លោកស្រី អេង លី គង់ បាន ឲ្យដឹង ថា « សមាគម បាន បង្កើត នូវ គំនិត ផ្ដួច ផ្ដើម ជាច្រើន ដើម្បី ជំរុញ ឲ្យ មាន ការចាប់ផ្ដើម អាជីវកម្ម ដល់ ស្រ្ដី ដែល ក្នុង នោះ រួម មាន៖ ការប្រឹក្សា យោបល់ . ការបណ្ដុះបណ្ដាល ដើម្បី ជួយ ឲ្យ ស្រ្ដី ជា សហគ្រិន ផ្លាស់ប្ដូរ ឬ ពង្រីក អាជីវកម្ម របស់ ខ្លួន ពី លក្ខណៈ គ្រួសារ ទៅជា ក្រុមហ៊ុន ស្ដង់ដារ ពី សហគ្រាស ខ្នាត តូច ទៅជា មធ្យម - ធំ ឬ ជា ក្រុមហ៊ុន មាន ការចុះបញ្ជី ត្រឹមត្រូវ ជាដើម » ។
លោកស្រី បន្ដ ថា ដើម្បី ជំរុញ ឲ្យ នូវ មតិ យោបល់ នេះ បាន ល្អ ល្អ ប្រសើរ សមាគម សហគ្រិន ស្រ្ដី ក៏ មាន ក្រុមការងារ បច្ចេកទេស ដែល មាន សមត្ថភាព . មាន គណៈកម្មការ យ៉ាង សកម្ម ដែល ស្ម័គ្រចិត្ត ជួយ សមាគម និង ជំរុញ ឲ្យ សមាគម ទទួលបាន លទ្ធផល ជា ទី គាប់ ចិត្ត ។
លោកស្រី ខៀវ ទេព រង្សី កាញ៉ារីទ្ធ បាន លើកឡើង ថា ការរៀបចំ កម្មវិធី ខួប អនុស្សាវរីយ៍ លើក ទី៧ របស់ សមាគម សហគ្រិន ស្រ្ដី កម្ពុជា មិន ត្រឹមតែ ផ្ដល់ ឱកាស ក្នុង ការជួបជុំ ប៉ុណ្ណោះ ទេ ប៉ុន្ដែ បាន ចូលរួម ចែករំលែក បទពិសោធន៍ នៃ ភាពជោគជ័យ និង ចំណេះដឹង លើ មុខរបរ អាជីវកម្ម ផ្សេង ៗ ដល់ គ្នា ទៅ វិញ ទៅ មក ដើម្បី លើកកម្ពស់ សេដ្ឋកិច្ច គ្រួសារ និង សង្គមជាតិ ។
លោកស្រី បន្ថែម ថា ជាក់ស្ដែង សហគ្រិន ភាព ជា ស្រ្ដី មាន ការកើនឡើង គួរឲ្យ កត់សម្គាល់ មិន ត្រឹមតែ ធ្វើឲ្យ មុខជំនួញ របស់ ខ្លួន មាន ភាពជោគជ័យ នោះ ទេ តែ ស្រ្ដី តែងតែ ស្ថិត នៅ ពីក្រោយ ប្រឹក្សា យោបល់ ដើម្បី ជំរុញ លើកទឹកចិត្ត សមាជិក គ្រួសារ ឲ្យ ឈាន ទៅ រក ភាពជោគជ័យ គ្រប់ ភារកិច្ច ក្រោម ស្នាមញញឹម ។
គួរ បញ្ជាក់ ថា មូលហេតុ ដែល បង្ក ទៅជា អគ្គីភ័យ ខាងលើ នេះ គឺ មិន ទាន់ មាន ការបញ្ជាក់ នោះ ឡើយ ប៉ុន្តែ ក្រោយពី ការភៀសខ្លួន ចេញ ពី អគារ នោះ លោក នាយក រដ្ឋមន្ត្រី បាន វិលត្រឡប់ ទៅកាន់ លំនៅឋាន របស់ លោក វិញ ស្ថិត នៅក្នុង តំបន់ Bani Gala នៃ ទីក្រុង អ៊ីស្លា ម៉ា បាដ និង បាន បញ្ជា ឲ្យ បើក ការស៊ើបអង្កេត យ៉ាង ល្អិតល្អន់ ចំពោះ ករណី ខាងលើ នេះ ផងដែរ ៕
រដ្ឋមន្ត្រី ទេសចរ ណ៍៖ វិស័យ សាធារណៈ និង ឯកជន នៅ សៀមរាប ត្រូវ បង្កើត ផលិតផល ទេសចរណ៍ ថ្មី ៗ ទៀត សម្រាប់ បំពេញ តម្រូវការ ជូន ភ្ញៀវ ក្រៅពី អង្គរ
( សៀមរាប ) ៖ រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ លោក ថោង ខុន តែង លើកឡើង ថា ភ្ញៀវ ទេសចរ ដែល មក ទស្សនា ខេត្ត សៀមរាប មិន ត្រឹមតែ មក ទស្សនា ប្រាសាទ អង្គរវត្ត តែ មួយ ផ្នែក ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ពួកគេ ក៏ ត្រូវការ ផលិតផល ទេសចរណ៍ ផ្សេង ៗ ទៀត ក្រៅពី ប្រាសាទ អង្គរវត្ត ខណៈ ការបង្កើត ផលិតផល ទេសចរណ៍ ថ្មី ៗ ក៏ មិន ទាន់ មាន ច្រើន តាម តម្រូវការ ភ្ញៀវ ទេសចរ នៅឡើយ ដែរ ។
បើ តាម ការរាយការណ៍ របស់ ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត សៀមរាប លោក ង៉ូវ សេង កាក់ បាន ឱ្យដឹង ថា បច្ចុប្បន្ន អាជ្ញាធរ ខេត្ត ក៏ ដូចជា មន្ទីរ ទេសចរណ៍ ខេត្ត សៀមរាប ក៏ កំពុងតែ ខិតខំ ជំរុញ ការរៀបចំ « សៀមរាប ក្រៅពី ប្រាសាទ អង្គរ » ជាមួយ វិស័យ ឯកជន បណ្ដើរ ៗ ហើយ ដែរ ។
លោក ជុក ជំនោរ បាន បន្ត ថា ក្រៅពី នោះ មាន ការភ្ជាប់ ខ្សែ ទស្សនកិច្ច ទៅដល់ ប្រាសាទ ព្រះវិហារ និង ក្រុម ប្រាសាទ កោះ កេរ នៅ ខេត្ត ព្រះវិហារ ប្រាសាទ បេង មាលា ឬ បឹង មាលា នៅ ស្រុក ស្វាយលើ តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក នៅ ខេត្ត កំពង់ធំ និង ទៅដល់ ប្រាសាទ វត្ត ភូ ប្រទេស ឡាវ ផងដែរ ដែល ជា ខ្សែ ទស្សនកិច្ច បេតិកភណ្ឌ ។
ប្រធាន នាយកដ្ឋាន នៃ ក្រសួង ទេសចរណ៍ រូប នេះ បាន បន្ថែម ទៀត ថា ការរៀបចំ ទស្សនីយភាពសម្ដែល សិល្ប វប្បធម៌ នៅ តាម ភោជនីយដ្ឋាន សណ្ឋាគារ នានា នៅក្នុង ក្រុង សៀមរាប ផ្សារ ទំនើប កន្លែង កម្សាន្ត នានា នៅក្នុង ស្រុក សៀមរាប ក៏ ជា ផលិតផល ទេសចរណ៍ ទាក់ទាញ ភ្ញៀវ ទេសចរ ដែរ ។
លោក ថា ប៉ុន្តែ កន្លែង ទេសចរណ៍ ខ្លាត តូច និង រមណីយដ្ឋាន ទេសចរណ៍ របស់ វិស័យ ឯកជន មួយចំនួន ហាក់ មិន ទាន់ ទទួលបាន ការចាប់អារម្មណ៍ ពីសំណាក់ ភ្ញៀវ ទេសចរ អន្តរជាតិ នៅឡើយ នេះ ក៏ ប្រហែល មក ពី ក្រុមហ៊ុន ទីភ្នាក់ងារ ទេសចរណ៍ មិន សូវ រៀបចំ ជា ខ្សែ ទស្សនកិច្ច សម្រាប់ ភ្ញៀវ ។
ក្នុង កិច្ចប្រជុំ ដដែល ខាងលើ លោក រដ្ឋមន្ត្រី ថោង ខុន បាន ណែនាំ បន្ថែម ថា វិស័យ សាធារណៈ និង វិស័យ ឯកជន ក្នុង វិស័យ ទេសចរណ៍ ត្រូវ រួមគ្នា បង្កើត ផលិតផល ទេសចរណ៍ និង រមណីយដ្ឋាន ទេសចរណ៍ បន្ថែម ទៀត ដើម្បី បំពេញ ចំណាប់អារម្មណ៍ និង តម្រូវការកម្សាន្ត របស់ ភ្ញៀវ ទេសចរ អន្តរជាតិ ធ្វើ យ៉ាងណា ឱ្យ ភ្ញៀវ ទេសចរ ដែល មក ទស្សនា កម្ពុជា មាន ឱកាស ស្នាក់ នៅ យូរ ថ្ងៃ យូរ ខែ និង ចាយ ច្រើន ។
