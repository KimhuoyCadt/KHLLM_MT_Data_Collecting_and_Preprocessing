( កំពង់ធំ )៖ លោកស្រី ឃួន ឃុន ឌី ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ស្រុក កំពង់ស្វាយ បន្ត ចុះ ផ្សព្វផ្សាយ គោល នយោបាយ និង បង្រៀន គូស សន្លឹក ឆ្នោត ដល់ បងប្អូន ប្រជាពលរដ្ឋ ជិត ២០០ នាក់ ក្នុង ឃុំ ត្បែង ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២៣ ។
លោកស្រី ឃួន ឃុន ឌី បាន សំដែង ភាពសប្បាយរីករាយ ជា ទីបំផុត និង ថ្លែងអំណរគុណ ដ៏ ជ្រាលជ្រៅ ដល់ ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ ត្បែង និង បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន មក ជួបជុំគ្នា ថ្ងៃ នេះ ដើម្បី គាំទ្រ គោល នយោបាយ និង គោរព ស្រឡាញ់ ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា ។
លោកស្រី ឃួ ន ឃុន ឌី បាន អំពាវនាវ ឲ្យ សមាជិក និង ប្រជាពលរដ្ឋ ទាំងអស់ ដែល មាន ឈ្មោះ ក្នុង បញ្ជី ឈ្មោះ បោះឆ្នោត ត្រៀមលក្ខណៈ អញ្ជើញ ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ជូន គណបក្ស ប្រជាជន កម្ពុជា លេខរៀង ទី ១៨ ដែល មាន មាន និមិត្ត សញ្ញា ទេវតា បាច ផ្កា ជា សម្គាល់ ៕ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង និង ផ្ដល់ ឋានៈ អនុប្រធាន និង សមាជិក នៃ លេខាធិការដ្ឋាន គណៈកម្មាធិការ ជាតិ ប្រឆាំង ភេរវកម្ម ចំនួន ១៨ រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង និង ផ្ដល់ ឋានៈ អនុប្រធាន និង សមាជិក នៃ លេខាធិការដ្ឋាន គណៈកម្មាធិការ ជាតិ ប្រឆាំង ភេរវកម្ម ចំនួន ១៨ រូប ក្នុង នោះ មាន ឋានៈ ស្មើ អគ្គ នាយក រហូតដល់ រដ្ឋមន្ដ្រី ។ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២៣ ។
ខាងក្រោម នេះ ជា ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្សត្រ៖ សម្ដេច ក្រឡាហោម ស ខេង ជួប ក្រុមប្រឹក្សា កីឡា ក្រសួង មហាផ្ទៃ ដែល ត្រៀម ចេញ ទៅ ប្រកួត កីឡា នគរបាល និង កង ពន្លត់ អគ្គិភ័យ ពិភពលោក នៅ ប្រទេស កាណាដា
លោក សរ សិទ្ធិ អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ ទទួល ជួយ ការងារ ដឹកនាំ អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា កីឡា ក្រសួង មហាផ្ទៃ បាន ធ្វើ របាយការណ៍ ជូន សម្ដេច ក្រឡាហម និង អង្គ ពិធី ថា លោក នឹង ដឹកនាំ ប្រតិភូ កីឡា ក្រសួង មហាផ្ទៃ ចំនួន ៤៨ នាក់ ធ្វើដំណើរ ទៅ ប្រទេស កាណា ដើម្បី ចូលរួម ព្រឹត្តិការណ៍ កីឡាកម្រិត ពិភពលោក នេះ ដែល កម្មវិធី ប្រកួត នឹង ចាប់ផ្ដើម ពី ថ្ងៃទី ២៨ ខែកក្កដា រហូតដល់ ថ្ងៃទី ៦ ខែសីហា ឆ្នាំ ២០២៣ ។
លោក បាន ឲ្យដឹង ថា ការរៀបចំ កីឡា នគរបាល និង កង ពន្លត់ អគ្គិភ័យ ពិភពលោក គឺ ដើម្បី បង្ហាញ ពី សមាគ្គីភាព សមត្ថភាព និង ទេព្យកោសល្យ របស់ កង នគរបាល នៃ ប្រទេស នីមួយ ៗ និង តែងតែ មាន ប្រទេស ជាង ៧០ បាន ចាត់ បញ្ជូន ប្រតិភូ កីឡា ចូលរៀងរាល់ ការប្រកួត ហើយ ប្រទេស កម្ពុជា ធ្លាប់ បាន បញ្ជូន ប្រតិភូ កីឡា ចូលរួម ចំនួន ២លើក ក្នុង ចំណោម ការរៀបចំ ចំនួន ២០ លើក ។
សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា និង ថ្នាក់ដឹកនាំ ក្រសួង មហាផ្ទៃ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ចំពោះ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា កីឡា ក្រសួង មហាផ្ទៃ ដែល បាន រៀបចំ ប្រភេទ កីឡា និង ត្រៀម ចេញ ទៅ ចូលរួម ប្រកួត នៅ ប្រទេស កាណាដា ដែល ជា បេសកកម្ម ដ៏ មាន សារៈសំខាន់ នេះ មិន ត្រឹមតែ សម្រាប់ ក្រសួង មហាផ្ទៃ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ គឺ សម្រាប់ ប្រទេសជាតិ ទាំងមូល ។
ក្នុង ឱកាស នោះ សម្ដេច ក្រឡាហោម ស ខេង បាន ថ្លែង ដោយ សង្ខេប ទៅកាន់ អង្គ ពិធី អំពី មិទ្ធផល និង ការងារ សំខាន់ ៗ ដែល ក្រសួង មហាផ្ទៃ សម្រេចបាន ក្នុង រយៈពេល ៥ ឆ្នាំ នៃ នីតិកាល ទី៦ ពី ឆ្នាំ ២០១៨ ដល់ ឆ្នាំ ២០២៣ ក្នុង នោះ មាន ដូចជា វិស័យ កំណែទម្រង់ រដ្ឋបាល សាធារណៈ កំណែទម្រង់ កងកម្លាំង នគរបាល ជាតិ ព្រមទាំង កំណែទម្រង់ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា កីឡា ក្រសួង មហាផ្ទៃ ផងដែរ ។
លោក បណ្ឌិត ចន ណារិទ្ធ៖ គណបក្ស ប្រជាជន តែងតែ ឈរ ជាមួយ ប្រជាជន គ្រប់ កាលៈទេសៈ ប្រឹងប្រែង ជម្នះ គ្រប់ ឧបសគ្គ ហ៊ាន ធ្វើ ពលិកម្ម ឥត រួញរា ដើម្បី ប្រទេស កម្ពុជា
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ចន ណារិទ្ធ បាន ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ប្រជាជន ប្រចាំ សាខា អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម ។
នៅក្នុង ពិធី សំណេះសំណាល . បណ្ឌិត ចន ណារិទ្ធ បាន ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ សមាជិក សមាជិកា ទាំងអស់ ដែល បាន សម្រេចចិត្ត ចូលរួម និង គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី រួមគ្នា រក្សា សុខ សន្តិភាព និង ជំរុញ ការអភិវឌ្ឍ ។
បណ្ឌិត ចន ណារិទ្ធ ក៏ បាន ប្រកាស គាំទ្រ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ជា បេក្ខជន នាយក រដ្ឋមន្ត្រី និង បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខជន នាយក រដ្ឋមន្ត្រី នា ពេល អនាគត ដោយ បាន បញ្ជាក់ បន្ថែម ថា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន គឺ បោះឆ្នោត ឲ្យ ខ្លួន ឯង ដូច ច្នេះ នៅពេល គណបក្ស ប្រជាជន ទទួលបាន ជ័យជំនះ យើង ទាំងអស់ គ្នា ក៏ ទទួលបាន ជ័យជំនះ ដែរ ។
តំណាងរាស្ត្រ សេរី កុសល បន្ដ សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ជាង ៤០០ នាក់ ភូមិ ចំនួន ៣ ក្នុង ស្រុក ភ្នំស្រុក និង អំពាវនាវ ឲ្យ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា លេខរៀង ទី ១៨
( បន្ទាយមានជ័យ )៖ លោក សេរី កុសល តំណាងរាស្ត្រ ខេត្ត បន្ទាយមានជ័យ និង ក្រុមការងារ ចុះ ជួយ ស្រុក ភ្នំស្រុក នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២៣ ដែល ជា ថ្ងៃ ចុងក្រោយ នៃ យុទ្ធនាការ ឃោសនា រក សម្លេង ឆ្នោត បាន បន្ដ ដឹកនាំ ក្រុមការងារ ចុះ សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ប្រមាណ ជាង ៤០០ នាក់ មកពី ភូមិ ចំនួន ៣ រួម មាន៖ ភូមិ មុខ ឈ្នាង លើ . ភូមិ មុខ ឈ្នាង ក្រោម និង ភូមិ រោគ ក្នុង ឃុំ ស្ពាន ស្រែង ស្រុក ភ្នំស្រុក ខេត្ដ បន្ទាយមានជ័យ ។
លោក សេរី កុសល បាន ឲ្យដឹង ថា នៅ ឃុំ ស្ពាន ស្រែង មាន បងប្អូន អញ្ជើញ មកពី បក្ស ផ្សេង ចំនួន ២៩៨ នាក់ និង អំពាវនាវ ដល់ អ្នក ផ្សេង ទៀត រួមទាំង ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ នេះ ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ស្នង គុណ សម្ដេច តេជោ ដែល បាន ខិតខំ ក្នុង រយៈកាល នា ពេល កន្លងមក ។
លោក សេរី កុសល បាន ជម្រាប អំពី មូលហេតុ ដែល បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី ១៨ គឺ ក្នុង កាលៈទេសៈ នេះ មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល មាន លទ្ធភាព និង សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការថែរក្សា សន្តិភាព និង អភិវឌ្ឍន៍ ប្រទេសជាតិ និង ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ នានា ដែល ធ្វើឲ្យ ប្រជាជន មាន ជីវភាពរីកចម្រើន ។
ក្នុង ឱកាស នោះ លោក សេរី កុសល ក៏ បាន ពាំនាំ នៅ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល ជានិច្ចកាល សម្ដេច តែងតែ យកចិត្តទុកដាក់ សុខ ទុក្ខ របស់ បងប្អូន ប្រជាពលរដ្ឋ ដោយ បាន ថែរក្សា នៅ សុខ សន្តិភាព ស្ថេរភាព នយោបាយ រហូតមកដល់ ពេលនេះ ។
ទន្ទឹម គ្នា នេះ លោក សេរី កុសល បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង អណត្តិ ទី៧ នេះ ជាបន្ត ទៀត និង គាំទ្រ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី បន្ត វេន នា ពេល អនាគត ។
លើស ពី នោះ ទៀត លោក សេរី កុសល បាន ណែនាំឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ចូលរួម ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា នា ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ នា ពេល ខាងមុខ នេះ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា កុំបី អាក់ ខាន ឡើយ ។
ពិធី សំណេះសំណាល នេះ បាន បញ្ចប់ ទៅ ភាពរីករាយ ហើយក៏ មាន ការហូប នំបញ្ចុក និង ការ៉េម កី រួមគ្នា ដើម្បី បង្ហាញ ពី ការសាមគ្គីភាព និង មិត្តភាព ផងដែរ ។
តំណាង ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ជួប សំណេះសំណាល ជាមួយ ភ្នាក់ងារ គណបក្ស ប្រជាជន ស្រុក ខ្សាច់ កណ្តាល ជាង ៨៧០ នាក់ រំលឹក ពី តួនាទី ក្នុង នាម ជា អ្នកសង្កេតការណ៍ បោះឆ្នោត
ក្នុង ឱកាស នេះ ដែរ លោក បណ្ឌិត បាន ផ្តាំផ្ញើ ដល់ ភ្នាក់ងារ គណបក្ស ប្រជាជន កម្ពុជា អំពី ព្រឹត្តិការណ៍ ពត៌មាន ថ្មី ៗ កំពុង កើត មាន ឡើង និង បាន ធ្វើ ការណែនាំ ដល់ ភ្នាក់ងារ គណបក្ស ទាំងអស់ ដែល ជា តំណាង របស់ គណបក្ស សង្កេតមើល ដំណើរការបោះឆ្នោត និង ការរាប់ សន្លឹក ឆ្នោត ត្រូវ យល់ដឹង ឱ្យ ច្បាស់លាស់ ពី តួនាទី ភារកិច្ច សិទ្ធិ និង ការទទួលខុសត្រូវ របស់ ភ្នាក់ងារ គណបក្ស ក្នុង ពេល បំពេញ កិច្ចការ ក្នុង ការិយាល័យ បោះឆ្នោត របស់ ខ្លួន ។
លោក បណ្ឌិត បាន បន្ត ថា ភ្នាក់ងារ គណបក្ស ត្រូវ យល់ដឹង៖
លើស ពី នេះ លោក បណ្ឌិត បាន សង្កត់ធ្ងន់ និង អំពាវនាវ ដល់ សមាជិក សមាជិក និង ភ្នាក់ងារ គណបក្ស ទាំងអស់ ត្រូវ ចូលរួម បង្ការ ទប់ស្កាត់ រាល់ សកម្មភាព នានា និង ឧបាយកល ដែល ប៉ុនប៉ង រំលោភបំពាន បំផ្លាញ នូវ ដំណើរការបោះឆ្នោត និង បំផ្លាញ សន្លឹក ឆ្នោត ព្រមទាំង សកម្មភាព ប៉ុនប៉ង បង្កឱ្យ មាន ភាពចលាចល វឹកវរ ក្នុង សង្គម តាម គ្រប់ រូបភាព ។
លោក បណ្ឌិត មាន ក្តីសង្ឃឹម យ៉ាង មុតមាំ ថា សមាជិក សមាជិកា ទាំងអស់ រួមគ្នា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា មាន លេខរៀង ទី ១៨ ដើម្បីឱ្យ គណបក្ស ប្រជាជន កម្ពុជា សម្រេចបាន ជោគជ័យ ក្នុង ការបោះឆ្នោត ជ្រើសរើស តាំង តំណាងរាស្ដ្រ នីតិកាល ទី៧ ដើម្បីឱ្យ គណបក្ស ប្រជាជន កម្ពុជា មាន លទ្ធភាព គ្រប់គ្រាន់ ក្នុង ការដឹកនាំ អនុវត្ត កម្មវិធី នយោបាយ នានា របស់ គណបក្ស ជាពិសេស ទៀត នោះ បង្កើត បាន សមិទ្ធផល ធំ ៗ ថ្មី ទៀត លើ មាគ៌ា សន្តិភាព ប្រជាធិបតេយ្យ នីតិរដ្ឋ និង ការអភិវឌ្ឍន៍ ៕
លោក លើកឡើង ថា ក្នុង នាម ជា អ្នកដឹកនាំ នៅ ពេល ដែល យើង មាន ការទទួលខុសត្រូវ កាន់តែ ធំ ច្បាស់ ណាស់ នឹង បាន អ្នកចាំ វាយប្រហារ និង រិះគន់ ចូរ កុំ ផ្តោត សំខាន់ លើ អ្នករិះគន់ ប៉ុន្តែ យើង ត្រូវ ប្រកាន់ ជំហរ ឱ្យ បាន ច្បាស់ ថា យើង ធ្វើ អ្វី ពិតប្រាដក អនុវត្តន៍ ដោយ ទទួលខុសត្រូវ ។
លោក បន្ត ថា សម្រាប់ ការដឹកនាំ ប្រទេស របស់ សម្តេច តេជោ ហ៊ុន សែន និង គណបក្ស ប្រជាជន មាន គោលជំហរ ផ្តល់ ប្រយោជន៍ ប្រជាពលរដ្ឋ ជា ធំ និង នៅ ជាមួយ ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ទោះបី មាន ខ្លះ ចាំ វាយប្រហារ និង រិះគន់ ក៏ដោយ ដែល នេះ ហើយ នាំឱ្យ គណបក្ស ប្រជាជន កម្ពុជា តែងតែ ឈ្នះ ឆ្នោត ជានិច្ច ។
( បារាំង . ប៉ារីស )៖ លោក ផូ ផល្លា បច្ចុប្បន្ន កំពុង រស់ នៅក្នុង ទីក្រុង ប៉ារីស ប្រទេស បារាំង បាន ប្រកាស ផែនការសប្បុរស ធម៌ ដ៏ ធំ មួយ ដោយ លោក នឹង ធ្វើ យុទ្ធនាការ ជិះ កង់ ឆ្លងកាត់ ៨ប្រទេស ស្ថិត ក្នុង ទ្វីប អឺរ៉ុប ដើម្បី រៃ អង្គាស ថវិកា ពី សប្បុរសជន ផ្ដល់ជូន មន្ទីរពេទ្យ កុមារ អង្គរ ។
យុទ្ធនាការ ដ៏ ធំ នេះ នឹង ចាប់ផ្ដើម ដោយ ចាប់ផ្តើម ពី ថ្ងៃទី ២៥ ខែកក្កដា ដល់ ថ្ងៃទី ០៣ ខែកញ្ញា ឆ្នាំ ២០២៣ ។ លោក នឹង ជិះ កង់ ឆ្លងកាត់ ទីក្រុង និង ឆ្លងកាត់ ប្រទេស តំបន់ អឺរ៉ុប មួយចំនួន ដូចជា បារាំង ស្វីស លុច្ស សំបួរ បែលហ្សិច អង់គ្លេស អ៊ីតាលី ហូឡង់ និង អាល្លឺម៉ង់ ថវិកា ដែល ប្រមូល បាន នឹង ផ្ដល់ជូន មន្ទីរពេទ្យ កុមារ អង្គរ ខេត្ត សៀមរាប ទាំងអស់ ។
លោក ផូ ផល្លា មាន ស្រុក កំណើត នៅ ខេត្ត កំពង់ឆ្នាំង បាន ចាកចេញ ទៅ រស់ នៅ ប្រទេស បារាំង ដើម ឆ្នាំ ២០២២ តាម ភរិយា ដែល ជា មន្ត្រី នៃ ស្ថាន ឯក អគ្គ រាជ ទូត តំណាង ព្រះរាជាណាចក្រ កម្ពុជា ប្រចាំ ទីក្រុង ប៉ារីស ។ លោក ផូ ផល្លា ប្រាប់ ថា តាម ច្បាប់ របស់ ប្រទេស បារាំង ជា គ្រួសារ របស់ មន្ត្រី ការទូត ដូច លោក គឺ គេ មិន អនុញ្ញាតឲ្យ ធ្វើ ការងារ ជា បុគ្គលិក ពេញ សិទ្ធិ នៅ ទីណា នោះ ទេ ។
ដូច្នេះ រាល់ ថ្ងៃ គឺ លោក បាន ទៅ ធ្វើ ការស្ម័គ្រចិត្ត ផ្សេង ៗ ។ ដូច្នេះ ពេល ទំនេរ លោក តែងតែ ជិះ កង់ ដើម្បី សុខភាព ប៉ុន្តែ ស្រប ពេល មើលឃើញ ពី តម្រូវការ មូលនិធិ ទ្រទ្រង់ មន្ទីរពេទ្យ កុមារ អង្គរ ដើម្បី មន្ទីរពេទ្យ អាច បន្ត បេសកកម្ម ជួយ កុមារ កម្ពុជា ប្រកបដោយ និរន្តរភាព ទើប លោក លេចឡើង នូវ គំនិត ជិះ ឲ្យ លើស ពី លក្ខខណ្ឌ សុខភាព ទៅជា ជិះ ដើម្បី បាន ប្រយោជន៍ ដល់ កុមារ កម្ពុជា នេះ ឡើង ។
សម្រាប់ បេសកកម្ម នេះ លោក បាន ស្នើសុំ សហការ ពី មន្ទីរពេទ្យ កុមារ អង្គរ ផ្ទាល់ ។ បន្ថែម ពីលើ នេះ លោក ក៏ បាន ធ្វើ លិខិត ជូន ដំណឹង ទៅ ស្ថាន ឯក អគ្គ រាជ ទូត ខ្មែរ ប្រចាំ ប្រទេស អឺរ៉ុប ចំនួន ៥ ស្វែងរក ការគាំទ្រ អំពី បេសកកម្ម នេះ ។ ជា លទ្ធផល លោក ថា ស្ថាន ឯក អគ្គ រាជ ទូត ខ្មែរ ខ្លះ ក្នុង ចំណោម នោះ បាន ឆ្លើយតប ជា វិជ្ជមាន ពោលគឺ គេ គាំទ្រ និង សន្យា ជួយ ផ្សព្វផ្សាយ បន្ត ពី បេសកកម្ម របស់ លោក ប្រយោជន៍ ជួយ ពង្រីក វិសាលភាព ដំណឹង កៀរ គរ ថវិកា ជួយ កុមារ ខ្មែរ តាមរយៈ មន្ទីរពេទ្យ ខាងលើ ។
នេះ លើក ទី១ សម្រាប់ ការជិះ ដើម្បី សប្បុរសធម៌ ប៉ុន្តែ ជា លើក ទី២ សម្រាប់ យុទ្ធនាការ ទូទៅ ជាក់ស្ដែង កាលពី ខែមិថុនា និង ឧសភា លោក ផូ ផល្លា ក៏ ធ្លាប់ បើក យុទ្ធនាការ ផ្ទាល់ខ្លួន ជិះ កង់ ចម្ងាយ ៤០០០ គីឡូម៉ែត្រ ។ កាល នោះ គឺ លោក ជិះ ដើម្បី អបអរ កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ ព្រឹត្តិការណ៍ កីឡា ស៊ីហ្គេម លើក ទី ៣២ និង ប៉ារ៉ាហ្គេម លើក ទី ១២ ។
