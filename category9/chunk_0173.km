( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៦ករណី ក្នុង នោះ ករណី ជួញដូរ ២ករណី . ប្រេី ប្រាស់ ៣ករណី និង ដឹកជញ្ជូន រក្សាទុក ១១ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥២ នាក់ ។
បទ អត្ថាធិប្បាយ៖ តើ ដំណើរទស្សនកិច្ច ជាញឹកញាប់ របស់ មន្ត្រី ជាន់ ខ្ពស់ អាមេរិក ទៅកាន់ តំបន់ ប៉ាស៊ីហ្វិក ខាងត្បូង មាន គោលបំណង អ្វី ?
សម្រាប់ បណ្តា ប្រទេស កោះ ប៉ាស៊ីហ្វិក ការគំរាមកំហែង ពិតប្រាកដ បំផុត ដែល ពួកគេ កំពុង ប្រឈមមុខ គឺ វិបត្តិ រស់រាន មាន ជីវិត ដែល នាំមក ដោយ ការប្រែប្រួល អាកាសធាតុ គឺ កម្រិត ជីវភាព រស់ នៅ ទាប របស់ ប្រជាជន ដែល បណ្តាល មកពី ការអភិវឌ្ឍ យឺតយ៉ាវ មិន ចង់ ក្លាយទៅជា កូន អុក របស់ ភាគី អាមេរិក សម្រាប់ ធ្វើ ការប្រកួតប្រជែង ភូមិសាស្ត្រ នយោបាយ ទាល់តែសោះ ។
វិទ្យុ មិត្តភាព កម្ពុជា - ចិន នាយក រដ្ឋមន្ត្រី នៃ ប្រទេស ប្រជុំ កោះ សាឡូម៉ូន សម្តែង ការកោតសរសើរ យ៉ាង ខ្លាំង ចំពោះ គំនិត ផ្តួចផ្តើម ជា សកល ចំនួន ៣ របស់ ចិន ក្នុង គោលបំណង ពួត ដៃ គ្នា កសាង អនាគត រួម
មន្ទីរ សង្គមកិច្ច ខេត្ត ស្ទឹងត្រែង បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី ការអនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន ស្ត្រី មាន ផ្ទៃពោះ និង កុមារ អាយុ ក្រោម ២ ឆ្នាំ ក្នុង អត្រា ឧបត្ថម្ភ ថ្មី
( ស្ទឹងត្រែង ) ៖ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត ស្ទឹងត្រែង សហការ ជាមួយ មូលនិធិ ជាតិ ជំនួយ សង្គម ក្រោម ការឧបត្ថម្ភ ពី យូនី សេហ្វ បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី ការអនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន ស្ត្រី មាន ផ្ទៃពោះ និង កុមារ អាយុ ក្រោម ២ ឆ្នាំ ក្នុង អត្រា ឧបត្ថម្ភ ថ្មី ។ ពិធី នេះ ធ្វើឡើង នៅ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ ក្រោម អធិបតីភាព លោកស្រី កែវ សាវឿន អភិបាល រង ខេត្ត ស្ទឹងត្រែង ។
លោក ប្រធាន មន្ទីរ ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ ថ្នាក់ដឹកនាំ ខេត្ត ជាពិសេស អភិបាល ខេត្ត ដែល បាន គាំទ្រ និង បង្ក លក្ខណៈ ងាយស្រួល ដល់ មូលនិធិ ជាតិ ជំនួយ សង្គម នៃ មន្ទីរ សង្គមកិច្ច ខេត្ត ក្នុង ការអនុវត្ត នូវ គ្រប់ សកម្មភាព ការងារ និង សូម អរគុណ ចំពោះ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ និង មន្ទីរ អង្គភាព នានា ដែល បាន ចូលរួម សហការ អនុវត្ត ការងារ បាន យ៉ាង ល្អ ប្រកបដោយ ប្រសិទ្ធភាព ។
មន្ទីរ សង្គមកិច្ច ខេត្ត កំពង់ឆ្នាំង រៀបចំ វគ្គ បណ្ដុះបណ្ដាល ស្ដីពី ការអនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន ស្ត្រី មាន ផ្ទៃពោះ និង កុមារ អាយុ ក្រោម ២ឆ្នាំ
លោក ឈាង ចន្ធី ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវតិសម្បទា ខេត្ត កំពង់ឆ្នាំង បាន លើកឡើង ថា ក្នុង នាម មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវតិសម្បទា ខេត្ត កំពង់ឆ្នាំង និង ក្នុង នាម រូប លោក ផ្ទាល់ ពិតជា មាន កិត្តិយស និង មាន សេចក្តី សោមនស្ស រីករាយ យ៉ាង ក្រៃលែង ដែល បាន រៀបចំ វគ្គ បណ្ដុះបណ្ដាល ស្ដីពី ការពង្រឹង យន្តការអនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន ស្ត្រី មាន ផ្ទៃពោះ និង កុមារ អាយុ ក្រោម ២ ឆ្នាំ ក្នុង អត្រា ឧបត្ថម្ភ ថ្មី នា ពេលនេះ ។
( សៀមរាប ) ៖ នៅ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ លោកស្រី ទាង អេង ទៀសីហា អនុប្រធាន គណៈកម្មាធិការ កាកបាទ ក្រហម កម្ពុជា សាខា ខេត្ត សៀមរាប បាន អញ្ជើញ ប្រគល់ ផ្ទះ មនុស្សធម៌ ទី ៨៧ ដល់ លោកតា សាត វឿន អាយុ ៧៣ ឆ្នាំ និង ប្រពន្ធ ឈ្មោះ ឆែម អាន ដែល ជា ជន ចាស់ជរា ទីទ័ល ក្រ រស់ នៅ ភូមិ ល្វា ឃុំ ស្រែ ណូយ ស្រុក វ៉ារិន ខេត្ត សៀមរាប ។
ក្នុង ឱកាស នោះ លោកស្រី ទាង អេង ទៀសីហា បាន លើកឡើង ថា ផ្ទះ មនុស្សធម៌ ទី ៨៧ និង អំណោយ ដែល បាន នាំយក មក ប្រគល់ ជូន លោក តា លោកយាយ និង ប្រជាពលរដ្ឋ នា ពេលនេះ គឺ ទទួលបាន ពី សាខា កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន ។ ជានិច្ច ជាកាល សម្ដេច តែងតែ មាន ការយកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ ជួប ទុក្ខលំបាក ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ ពណ៌ សម្បុរល សាសនា អ្វី ឡើយ ។
លោកស្រី ក៏ បាន ថ្លែងអំណរគុណ ដល់ ក្រុមការងារ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត សៀមរាប ដែល តែងតែ លះបង់ នូវ កម្លាំង កាយ មិន ខ្លាច ការនឿយហត់ ធ្វើ យ៉ាងណា ទៅ ឱ្យ ដល់ កន្លែង ប្រជាពលរដ្ឋ ដែល កំពុង ជួប ទុក្ខលំបាក ក៏ ដូចជា កិច្ចសហការ ល្អ ពី អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ ផងដែរ ។
ទន្ទឹម នោះ ដែរ លោកស្រី ក៏ បាន បង្ហាញ នូវ ទឹកចិត្ត សប្បាយរីករាយ ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង ស្រុក វ៉ារិន ដែល បាន បង្ហាញ នូវ ឆន្ទៈ ទៅ ចូលរួម បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ កន្លងមក យ៉ាង ច្រើន កុះករ ។ លោកស្រី បន្ត ថា នេះ ជា សកម្មភាព បង្ហាញ ពី ការឈឺឆ្អាល ជាមួយ ប្រទេសជាតិ ដើម្បី ជ្រើសរើស មេដឹកនាំ ដែល មាន សមត្ថភាព និង សាកសម សម្រាប់ ដឹកនាំ ប្រទេស កម្ពុជា ទៅរក សុខ សន្តិភាព និង ការអភិវឌ្ឍ កាន់ រីកចម្រើន បន្ថែម ទៀត ។
សូម ជម្រាប ថា ផ្ទះ មនុស្សធម៌ ទី ៨៧ នេះ សង់ លើ ផ្ទៃដី ផ្ទាល់ខ្លួន របស់ លោក តា លោកយាយ មាន ទំហំ ៦ម៉ែត្រ គុណ៦ម៉ែត្រ មាន ២បន្ទប់ ដំបូល ប្រក់ ស័ង្កសី ភ្លី ក្បឿង ជញ្ជាំង ស្មាត បត និង បាត ក្រាល ការ៉ូ មាន កម្ពស់ ផុត ពី ដី កន្លះ ម៉ែត្រ ។
អំណោយ ដែល ចែកជូន លោក តា លោកយាយ ដើម្បី ឡើង គេហដ្ឋាន ថ្មី រួម មាន៖ អង្ករ ៦០ គីឡូក្រាម មី ២កេស ត្រីខ២យួរ ថវិកា ៤០ ម៉ឹន រៀល ព្រមទាំង គ្រឿង ឧបភោគ បរិភោគ និង សម្ភារៈ មួយចំនួន ទៀត ។ ដោយឡែក គ្រួសារ ក្រីក្រ ចំនួន ១០០ គ្រួសារ ទទួលបាន៖ អង្ករ ៣០ គីឡូក្រាម មី១ កេស ត្រីខ១យួរ ថវិកា ៤ម៉ឹន រៀល ព្រមទាំង គ្រឿង ឧបភោគ បរិភោគ និង សម្ភារៈ មួយចំនួន ទៀត ផងដែរ ៕
លោក លី ធុជ កោតសរសើរ និង ថ្លែងអំណរគុណ ក្រុមការងារ ចុះ មូលដ្ឋាន ក្រុង បាវិត គ្រប់ ជាន់ ថ្នាក់ ចំពោះ ភាពជោគជ័យ នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ
( ភ្នំពេញ ) ៖ លោក លី ធុជ ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង បាវិត បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ក្រុមការងារ គ្រប់ ជាន់ ថ្នាក់ ទាំងអស់ នៅ មូលដ្ឋាន ក្រុង បាវិត រហូត ទទួលបាន ការគាំទ្រ លើស ផែនការ ដែល បាន កំណត់ និង ទទួលបាន ជ័យជម្នះ យ៉ាង ត្រចះត្រចង់ ជូន គណបក្ស ប្រជាជន កម្ពុជា នៅក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ នេះ ។
ទន្ទឹមនឹង នេះ ដំណើរការ នៃ ការបោះឆ្នោត បាន ប្រព្រឹត្តទៅ ដោយ រលូន សេរី ត្រឹមត្រូវ និង យុត្តិធម៌ ជោគជ័យ ក្រោម បរិយាកាស ស្ងប់ស្ងាត់ សុខ សន្តិភាព និង គ្មាន អំពើហិង្សា និង បាន បង្ហាញ ទៅកាន់ មជ្ឈដ្ឋាន ជាតិ និង អន្តរជាតិ ឲ្យ ឃើញ នូវ ភាព កាន់តែ ចាស់ទុំ និង ភាពម្ចាស់ការ ព្រមទាំង ឆ្លុះបញ្ចាំង ពី ការប្តេជ្ញាចិត្ត ដ៏ ម៉ឺងម៉ាត់ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការ អនុវត្ត នូវ គោលការណ៍ នៃ លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ដូច មាន ចែង ក្នុង រដ្ឋធម្មនុញ្ញ ។
ខ្ញុំ ក៏ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ប្រជាពលរដ្ឋ ក្រុង បាវិត ទាំងមូល ដែល ស្រឡាញ់ គាំទ្រ និង បាន បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ឈ្នះ ដាច់ តាម លទ្ធផល ជា បឋម របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ដោយ ទទួលបាន សំឡេង គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង អត្រា ៨១. ៦១% ។
ខ្ញុំបាទ និង ក្រុមការងារ គ្រប់ លំដាប់ថ្នាក់ នៅ ក្រុង បាវិត សូម គោរព ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ អនុសាសន៍ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ថ្លែង កាលពី ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០២៣ និង គាំទ្រ យ៉ាង ក្លៀវក្លា ឯកឧត្ដម បណ្ឌិត ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី សម្រាប់ នីតិកាល ទី៧ នេះ ។
ជាថ្មី ម្តង ទៀត ខ្ញុំ សូម យក ឱកាស ដ៏ ថ្លៃថ្លា នេះ ប្រសិទ្ធ នូវ សព្ទ សាធុការ ពរ ជ័យ សិរី មង្គល វិបុល សុខ បវរ មហា ប្រសើរ គ្រប់ ប្រការ ជូន ចំពោះ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា ក្រុមការងារ គ្រប់ លំដាប់ថ្នាក់ និង ប្រជាពលរដ្ឋ ទូទាំង ក្រុង បាវិត សូម បាន ភព ប្រសប់ តែ នឹង ពុទ្ធ ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណ : សុខ : និង ពល : កុំបី ឃ្លៀងឃ្លាត ឡើយ »៕
ការបំផ្លាញ គម្ពី គួរ អាន ក្នុង ប្រទេស ស៊ុយអែត និង ដាណឺម៉ាក បាន ធ្វើឲ្យ ប្រជាជន កាន់ សាសនា អ៉ី ស្លាម ជាច្រើន មាន ការអាក់អន់ចិត្ត ។ រដ្ឋាភិបាល ស៊ុយអែត កំពុង ប្រឈមមុខ នឹង ការរក្សា តុល្យភាព ដ៏ លំបាក មួយ ជុំវិញ ការការពារ សិទ្ធិ សេរីភាព នៃ ការបញ្ចេញមតិ និង បញ្ចៀស ការប្រមាថ ចំពោះ ប្រជាជន កាន់ សាសនា អ៉ី ស្លាម ។
លោក គ្រីស្ទឺ ស សុន បាន ប្រាប់ ទីភ្នាក់ងារ ព័ត៌មាន TT របស់ ស៊ុយអែត ឲ្យដឹង ថា មាន សំណើ សុំ ធ្វើ បាតុកម្ម បន្ថែម ទៀត ត្រូវបាន ដាក់ ទៅកាន់ ប៉ូលិស ហើយ ការសម្រេចចិត្ត អនុញ្ញាត ឬ អត់ នោះ គឺ អាស្រ័យ ទៅ លើ ប៉ូលិស ។ លោក គ្រីស្ទឺ ស សុន បាន គូសបញ្ជាក់ ថា « ប្រសិនបើ យើង ចេះតែ អនុញ្ញាតឲ្យ ពួកគេ ធ្វើ បាតុកម្ម យើង នឹង ប្រឈមមុខ នឹង ហានិភ័យ នៅ ថ្ងៃ ណាមួយ ។ ខ្ញុំ ព្រួយបារម្ភ ខ្លាំង ណាស់ ចំពោះ អ្វី ដែល វា អាច នាំទៅ ដល់ បញ្ហា នោះ » ។
គួរ បញ្ជាក់ ថា ក្រុម អ្នកតវ៉ា ដែល ខឹងសម្បារ ចំពោះ ផែនការដុត គម្ពី គួរ អាន បាន សម្រុក ចូល ស្ថានទូត ស៊ុយអែត ប្រចាំ នៅ ទីក្រុង បាកដាដ ប្រទេស អ៉ីរ៉ាក់ កាលពី ថ្ងៃទី ២០ ខែកក្កដា ។ ទាំង ដាណឺម៉ាក និង ស៊ុយអែត មិន ពេញចិត្ត ចំពោះ ការដុត គម្ពី គួរ អាន នោះ ទេ ប៉ុន្តែ មិន អាច ទប់ស្កាត់ នៅក្រោម ច្បាប់ ការពារ សិទ្ធិ បញ្ចេញមតិ បាន ឡើយ ៕
លោក ពូទីន មិន បាន រៀបរាប់ លម្អិត ថា តើ ទីក្រុង ព្យុងយ៉ាង បាន ផ្តល់ ការគាំទ្រ ក្នុង ទម្រង់ បែប ណាមួយ ឡើយ ចំពោះ អ្វី ដែល រុស្ស៉ី នៅតែ បន្ត ហៅ ថា « ប្រតិបត្តិការ យោធា ពិសេស » នៅ អ៊ុយក្រែន ប៉ុន្តែ នា ពេល កន្លងមក នេះ ក្រុម មន្រ្តី អាមេរិក ធ្លាប់ បាន អះអាង ថា កូរ៉េ ខាងជើង បាន លក់ គ្រាប់ រ៉ុក្កែត ក៏ ដូចជា គ្រាប់ កាំភ្លើង ធំ សរុប ខ្ទប់ រាប់ លាន គ្រាប់ ឱ្យ ទៅ ប្រទេស រុស្ស៉ី សម្រាប់ ការប្រើប្រាស់ ក្នុង សមរភូមិ នៅ អ៊ុយក្រែន ។ សង្រ្គាម ឈ្លានពាន របស់ រុស្ស៉ី បាន ផ្ទុះឡើង កាលពី ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
រដ្ឋបាល ខេត្ត ព្រះសីហនុ បើក កិច្ចប្រជុំ សម្របសម្រួល លើក ចុងក្រោយ ជាមួយ ពលរដ្ឋ ជាង ២០ គ្រួសារ ដែល បាន ទន្ទ្រាន ដោយ ខុស ច្បាប់ លើ ដី កម្មសិទ្ធ របស់ ក្រុមហ៊ុន កាណាឌីយ៉ា
( ព្រះសីហនុ) ៖ រដ្ឋបាល ខេត្ត ព្រះសីហនុ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែកក្ដ ដា ឆ្នាំ ២០២៣ បាន បើក កិច្ចប្រជុំ សម្របសម្រួល ជាមួយ ប្រជាពលរដ្ឋ ប្រមាណ ជាង ២០ គ្រួសារ ពាក់ព័ន្ធ ទៅនឹង ការចូលកាន់កាប់ ដីធ្លី ដោយ ខុស ច្បាប់ របស់ ក្រុមហ៊ុន កាណាឌីយ៉ា នៅ ចំណុច អូត្រា វ ឃុំ បិត្រាំង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
ដំណើរ នៃ កិច្ចប្រជុំ មាន ការចង្អុលបង្ហាញ ពី លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ ដឹកនាំ ដោយ លោក ប៊ូ វឌ្ឍនា នាយក ទី ចាត់ការ អន្តរ វិស័យ សាលា ខេត្ត ព្រះសីហនុ និង បាន សហការ អាជ្ញាធរ មាន សមត្ថកិច្ច តំណាង ប្រជាពលរដ្ឋ និង ប្រជាពលរដ្ឋ ជាង ១០គ្រួសារ ក្នុង ចំណោម ២៦ គ្រួសារ បាន ចូលរួម នៅ សាល ប្រជុំ សាលា ខេត្ត ព្រះសីហនុ ។
កន្លងមក រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន ធ្វើ ការសម្របសម្រួល និង ដោះស្រាយ បញ្ហា ទំនាស់ ដីធ្លី នេះ ក្រៅ ប្រព័ន្ធ តុលាការ ជា បន្តបន្ទាប់ រួច មកហើយ ដែរ ជា លទ្ធផល ប្រជាពលរដ្ឋ ប្រមាណ ៨៥ % បាន ឯកភាព ទទួលយក គោលការណ៍ ដោះស្រាយ របស់ ធនាគារ កាណាឌីយ៉ា ដោយ យល់ព្រម ទទួលយក ដីឡូត៍ ទំហំ ៥ម៉ែត្រ គុណ ២០ម៉ែត្រ និង យល់ព្រម រុះរើ សំណង់ ផ្សេង ៗ និង របង ថ្ម ចេញ ពី ទីតាំង ដី ខាងលើ ដោយ ស្ម័គ្រចិត្ត ។
ប្រជាពលរដ្ឋ ដែល បាន ឯកភាព ខាងលើ រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន សម្របសម្រួល បំពេញ បែបបទ ឯកសារ ជូន ដើម្បី ត្រៀម ចុះបញ្ជី ទទួលយក ប័ណ្ណ កម្មសិទ្ធិ ដី លើ ទីតាំង ដីឡូត៍ ដែល ធនាគារ បាន រៀបចំ ជូន ។ ក្នុង នោះ នៅ ថ្ងៃទី ០៨ ខែមិថុនា ឆ្នាំ ២០២៣ កន្លងទៅ នេះ រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន រៀបចំ ពិធី ចាប់ ឆ្នោត និង ប្រគល់ លេខ ដីឡូត៍ ជូន ប្រជាពលរដ្ឋ ដែល យល់ព្រម តាម គោលការណ៍ ដោះស្រាយ របស់ ធនាគារ កាណាឌីយ៉ា រួចរាល់ ។ ដោយឡែក នៅតែ ប្រមាណ ជាង ២០ គ្រួសារ តែ ប៉ុណ្ណោះ នៅ មិន ទាន់ យល់ព្រម ទទួលយក ។
ក្នុង នាម រដ្ឋបាល ខេត្ត ក៏ ដូចជា អាជ្ញាធរ ពាក់ព័ន្ធ នៅតែ ព្យាយាម ពន្យល់ ណែនាំ សម្របសម្រួល និង នៅតែ បន្ត ដោះស្រាយ តាម គោល នយោបាយ ឈ្នះ ៗ ជាក់ស្តែង នៅ ព្រឹក នេះ ប្រជាពលរដ្ឋ ជាង ១០គ្រួសារ ក្នុង ចំណោម ២៦ គ្រួសារ បាន មក ចូលរួម ក្នុង កិច្ចប្រជុំ ដើម្បី ស្តាប់ ការណែនាំ សម្របសម្រួល ពី មន្ត្រី ជំនាញ នៃ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ។
ក្រោយ ការពិនិត្យ ស្រាវជ្រាវ របស់ ក្រុមការងារ បាន រកឃើញ ថា ការចូលកាន់កាប់ រស់ នៅ របស់ ប្រជាពលរដ្ឋ គឺជា ការចូល ទន្ទ្រាន លើ ដី កម្មសិទ្ធិ ឯកជន របស់ អ្នកដទៃ តាមរយៈ ក្រុម មេខ្យល់ មួយ ក្រុម ដែល បាន ធ្វើ សកម្មភាព ចាប់ ដី ខាងលើ លក់ បន្ត ឲ្យ ទៅ ប្រជាពលរដ្ឋ ផ្សេង ទៀត ក្នុង តម្លៃ ទាប ។ បន្ទាប់មក ក្រុម មេខ្យល់ នេះ បាន កៀរគរ ប្រមូល ប្រាក់ ពី ប្រជាពលរដ្ឋ ដែល បាន ទិញ ដី ខាងលើ ដោយ អះអាង ថា យក ប្រាក់ ទាំងនេះ ទៅ រត់ ការធ្វើ ប័ណ្ណ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ។
ចំពោះ ក្រុម មេខ្យល់ ដែល ធ្វើ សកម្មភាព ខាងលើ នេះ ត្រូវបាន ក្រុមការងារ ស្រាវជ្រាវ ទំនាស់ ដីធ្លី នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ បាន កំណត់ មុខ សញ្ញា រួចរាល់ហើយ ផងដែរ ក្នុង នោះ មាន ចំនួន ៣នាក់ ដូច ខាងក្រោម៖
តាម ការបញ្ជក់ របស់ រដ្ឋបាល ខេត្ត ព្រះសីហនុ នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន បាន ក្រើន រំលឹក ដល់ បងប្អូន ប្រជាពលរដ្ឋ បើ នៅតែ បន្ត ធ្វើ សកម្មភាព ល្មើស ច្បាប់ រដ្ឋបាល ខេត្ត ព្រះសីហនុ នឹង អនុវត្ត វិធានការ ច្បាប់ យ៉ាង ម៉ឺងមាត់ ដោយ គ្មាន ការលើកលែង ចំពោះ បងប្អូន និង មេខ្លោង ទាំងឡាយ ណា ដែល ព្យាយាម ញុះញង់ ឲ្យ មាន ការទន្រ្ទាន កាន់កាប់ ដី ដោយ ខុស ច្បាប់ យកមក ផ្តន្ទាទោស ឲ្យ ខាន តែ បាន ៕
សាធារណរដ្ឋ ស៊ីប អបអរសាទរ ចំពោះ ជោគជ័យ នៃ ដំណើរការ រៀបចំ ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ នីតិកាល ទី៧ កន្លងទៅ នេះ ប្រកបដោយ សេរី និង យុត្តិធម៌
ការលើកឡើង នេះ បាន ធ្វើឡើង ពេល លោកស្រី នៅ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ បាន ជួប ពិភាក្សា ជាមួយ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន ។ សូម បញ្ជាក់ ថា សាធារណរដ្ឋ ស៊ីប មាន និវេសនដ្ឋាន នៅ ទីក្រុង ប៉េកាំង នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
ក្នុង ឱកាស នោះ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ បាន លើកឡើង អំពី ដំណើរការ បញ្ចប់ សង្រ្គាម រ៉ាំរ៉ៃ នៅ កម្ពុជា និង ដំណើរការស្វែងរក សុខ សន្តិភាព ពេញលេញ ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល ជា បិតា សន្តិភាព ។ ក្រោម នយោបាយ ឈ្នះ ឈ្នះ ប្រទេស កម្ពុជា ទាំងមូល បាន ឯកភាព ជាតិ ហើយ ប្រជាពលរដ្ឋ ទាំងអស់ បាន រួមរស់ ជាជាតិ ខ្មែរ តែ មួយ ប្រកបដោយ សុខដុមរមនា ។
លោក ទេសរដ្ឋមន្រ្តី បាន បន្ត ទៀត ថា ក្រោយ បញ្ចប់ សង្រ្គាម សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ គោល នយោបាយ និង យកចិត្ត ទុក ខ្ពស់ លើ ការស្តារ ឡើង នូវ សេដ្ឋកិច្ច សង្គម រហូតដល់ មាន ការរីកចម្រើន ដូច សព្វ ថ្ងៃ នេះ ហើយ ជីវភាព រស់ នៅ របស់ ប្រជាជន កម្ពុជា កាន់តែ មាន ភាពល្អ ប្រសើរ និង ធូរធារ ជាមុន ។
ទន្ទឹម នឹង នោះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បង្កើត ឲ្យ មាន នូវ ច្បាប់ វិនិយោគ និង គោល នយោបាយ ជាតិ សំខាន់ ៗ ដទៃ ទៀត ដើម្បី ទាក់ទាញ ការវិនិយោគ ពី ក្រៅ ប្រទេស និង សម្រួល ដល់ ដំណើរការ ធុរកិច្ច នៅ កម្ពុជា ដែល ធ្វើឲ្យ អ្នកវិនិយោគិន ទទួលបាន នូវ ភាព កក់ក្តៅ និង ឱកាស ដ៏ ច្រើន លើសលប់ សម្រាប់ ការរកស៊ី នៅ កម្ពុជា ព្រមទាំង បាន ប្រែក្លាយ កម្ពុជា ជា ផ្ទះ ទី ពីរ របស់ ខ្លួង ផងដែរ ។
ដោយឡែក សម្រាប់ វិស័យ សកម្មភាព មីន នៅ កម្ពុជា លោក ទេសរដ្ឋមន្រ្តី បាន លើកឡើង ថា រយៈពេល ជាង ៣០ ឆ្នាំ នេះ កម្ពុជា សម្រេចបាន នូវ សមិទ្ធផល ជា ប្រវតិ្តសាស្រ្ត ក្នុង ការងារ បោសសម្អាត មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម លើ ផ្ទៃដី រាប់ ម៉ឺន ហិកតា ចូលរួម ដល់ ការកាត់បន្ថយ អត្រា គ្រោះថ្នាក់ និង ផ្តល់ ដី ប្រកបដោយ សុវត្ថិភាព សម្រាប់ ការតាំង លំនៅឋាន កសិកម្ម និង ការស្តារ ឡើង នូវ ហេដ្ឋារចនាសម្ព័ន្ធ រូបវ័ន្ត ជាដើម ។
ជាមួយនឹង បទពិសោធន៍ និង ជំនាញ ដ៏ ច្រើន របស់ កម្ពុជា ផែ្នក បោសសម្អាត មីន និង ក្នុង នាម ជា ប្រទេស ធ្លាប់ រង គ្រោះ ដោយសារ សង្រ្គាម រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន បាន សម្រេច បញ្ជូន កងកម្លាំង រក្សា សន្តិភាព ជាង ៨០០០ នាក់ ក្រោម ឆ័ត្រ របស់ អង្គការ សហ ប្រជាជាតិ ដើម្បី ចូលរួម ធានា ដល់ សុខ សុវត្ថិភាព ដល់ ប្រជាជន ក្នុង ប្រទេស ចំនួន ៩ នៅលើ ពិភពលោក ក្នុង នោះ រួម មាន សាធារណរដ្ឋ ស៊ីប ផងដែរ ។
លោកស្រី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន បញ្ចូន កងកម្លាំង រក្សា សន្តិភាព ចូលរួម រក្សា សុខ សុវត្ថិភាព ក្នុង ប្រទេស ស៊ីប ហើយ ទំនាក់ទំនង ល្អ រវាង ប្រទេស និង ប្រជាជន ទាំង ពីរ កាន់តែ មាន ភាពល្អ ប្រសើរឡើង ។
ជាមួយគ្នា នេះ លោកស្រី ឯក អគ្គ រដ្ឋទូត បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន ស្វែងរក សុខ សន្តិភាព ជូន ដល់ ប្រជាជន កម្ពុជា និង ធ្វើឲ្យ កម្ពុជា មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ៕
គួរ បញ្ជាក់ ថា មុន ទៅដល់ ប្រទេស ចិន ព្យុះ Doksuri បាន ធ្វើដំណើរ ឆ្លងកាត់ ក្បែរ ភាគ ខាងត្បូង កោះ តៃវ៉ាន់ និង ភាគ ខាងជើង ហ្វីលីពីន ។ វា បាន កាត់ផ្តាច់ ថាមពល សម្រាប់ លំនៅឋាន ជាង ២៧៨. ៩៩៩ ខ្នង និង ផ្តួលរំលំ ដើមឈើ នៅ តៃវ៉ាន់ ហើយ ជើងហោះហើរ និង សេវា រថភ្លើង ក៏ បាន រង ការរំខាន ថែម ទៀត ផង ។ រីឯ នៅ ហ្វីលីពីន ព្យុះ ទីហ្វុង នេះ បាន សម្លាប់ មនុស្ស សរុប យ៉ាងហោច ជាង ៣០ នាក់ បើ រាប់ ទាំង ករណី លិច ទូក នៅ បឹង ក្បែរ ទីក្រុង ម៉ានីល កាលពី ថ្ងៃព្រហស្បតិ៍ ដែល កើតឡើង អំលុង ខ្យល់ បោកបក់ ខ្លាំង ៕
អ្នកវិភាគ ចៅ ចាក់ ស្មុក៖ ការរិះគន់ មួល បង្កាច់ វាយប្រហារ គ្រប់ បែបយ៉ាង ដោយ គ្មាន មូលដ្ឋាន របស់ ក្រុម ប្រឆាំង ជ្រុលនិយម ជា ការចូលរួម ពង្រឹង មូលដ្ឋាន បន្ថែម នៃ ជំនឿ ទុកចិត្ត យ៉ាង រឹងមាំ របស់ ពលរដ្ឋ ខ្មែរ ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា . សម្តេច តេជោ ហ៊ុន សែន និង យុវជន បន្ត វេន
( ភ្នំពេញ ) ៖ ដោយ គ្មាន យុទ្ធសាស្ត្រ នយោបាយ និង ផែនការ ច្បាស់លាស់ ក្រុម ប្រឆាំង ជ្រុលនិយម ដឹកនាំ ដោយ ជន ក្បត់ ជាតិ ៣ ជំនាន់ ធ្វើ នយោបាយ ដើម្បី បង្កើន ប្រជាប្រិយភាព និង ទាក់ទាញ ការគាំទ្រ ក្នុង ចំណោម ប្រជាពលរដ្ឋ តាមរយៈ ការធ្វើ នយោបាយ ញុះញង់ បញ្ឆេះ កំហឹង រើស អើង និង ស្អប់ខ្ពើម ជាតិ សាសន៍ ការរិះគន់ ជេរ ប្រមាថ វាយប្រហារ និង មួល បង្កាច់ ដៃគូ នយោបាយ និង បំភ្លៃ បំផ្លើស បំភ័ន្ត និង បំប៉ោង ស្ថានការណ៍ ខុសពី ការពិត ជាក់ស្តែង របស់ កម្ពុជា ។
យោង តាម លទ្ធផល បណ្តោះអាសន្ន នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ពលរដ្ឋ ចំនួន ជាង ៨.២លាន នាក់ ស្មើ ៨៤. ៥៨% បាន ចេញ ទៅ បោះឆ្នោត ហើយ គណបក្ស ប្រជាជន កម្ពុជា បាន ទទួល សំឡេង គាំទ្រ ជាង ៦.៣លាន សំឡេង ស្មើ ប្រមាណ ៨២ % នៃ សំឡេង ឆ្នោត បាន ការ ដែល ចំនួន នេះ ច្រើន ជាង ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ឆ្នាំ ២០២២ និង បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ អាណត្តិ ទី៦ ។
នៅក្នុង ការថ្លែង សារ ពិសេស នា ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០២៣ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ដល់ ក្រុម ប្រឆាំង ដែល ប្រឹង ជេរ សម្តេច និង ឯកឧត្តម ហ៊ុន ម៉ាណែត រហូត ធ្វើឱ្យ បក្ស ប្រជាជន កម្ពុជា ទទួលបាន ការគាំទ្រ ពី ប្រជាពលរដ្ឋ រហូតដល់ ទទួល សំឡេង ឆ្នោត ជាង ៨២% ។ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែង ថា មិត្ត បរទេស តែងតែ បន្ទោស បង្អាប់ រាជ រដ្ឋាភិបាល តាំងពី ឆ្នាំ ២០១៨ តែ ពួកគេ នៅតែ ធ្វើការ ជាមួយ សម្តេច រាប់ ទាំង កិច្ចប្រជុំ កំពូល អាស៊ាន ផងដែរ ។
រដ្ឋបាល ខណ្ឌ ចំការមន ថ្លែងអំណរគុណ គ្រប់ ភាគី ពាក់ព័ន្ធ ដែល ចូលរួម ថែរក្សា សន្តិសុខ នៅ តាម ការិយាល័យ បោះឆ្នោត ក្នុង ភូមិសាស្ត្រ ខណ្ឌ ចំការមន ប្រព្រឹត្តទៅ ក្នុង បរិយាកាស ល្អ ប្រសើរ
ខាងក្រោម នេះ ជា លិខិត ថ្លែងអំណរគុណ របស់ រដ្ឋបាល ខេត្ត ចំការមន៖ អាជ្ញាធរ រាជធានី ភ្នំពេញ រៀបចំ ចាប់ ឆ្នោត រើស តូប ឲ្យ អាជីវករ ចូល លក់ដូរ នៅ ផ្សារ សេន ជូរី ផ្លាហ្សា ថ្មី និង អរគុណ អាជីវករ ដែល ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ លោក នួន ផារ័ត្ន អភិបាល រង រាជធានី ភ្នំពេញ តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ចូលរួម ជា អធិបតី ក្នុង ពិធី ចាប់ ឆ្នោត ជ្រើសរើស តូប លក់ដូរ ជូន អាជីវករ ដែល កំពុង លក់ដូរ បណ្តោះអាសន្ន លើ សួន កុមារ ពោធិ៍ ចិន តុង ឲ្យ ចូល លក់ដូរ ក្នុង ផ្សារ សេន ជូរី ផ្លាហ្សា ទើប សាងសង់ ថ្មី វិញ នៅ សាល ប្រជុំ ធំ នៃ សាលា ខណ្ឌ ពោធិ៍សែនជ័យ ។
លោក បាន បន្ថែម ថា តាមរយៈ លទ្ធផល បណ្តោះអាសន្ន ដែល បាន បង្ហាញ ដោយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ក្នុង ចំណោម គណបក្ស ទាំង ១៨ ដែល បាន ចូលរួម ប្រកួតប្រជែង នៅ មណ្ឌល រាជធានី ភ្នំពេញ ក៏ ដូចជា នៅ ទូទាំង ប្រទេស គណបក្ស ប្រជាជន កម្ពុជា នៅតែ ឈាន មុខ និង បាន ទទួល ជោគជ័យ យ៉ាង ត្រចះត្រចង់ ក្នុង ការទទួលបាន អាសនៈ រដ្ឋសភា នៅក្នុង នីតិកាល ទី៧ នេះ ។
លោក នួន ផារ័ត្ន ក៏ បាន ថ្លែងអំណរគុណ ដល់ បងប្អូន អាជីវករ និង ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន បន្ត ជឿជាក់ លើ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង បាន ចូលរួម បោះឆ្នោត យ៉ាង ច្រើន លើសលុប ផងដែរ ។
គួរ បញ្ជាក់ ថា រដ្ឋបាល រាជធានី ភ្នំពេញ បាន សម្រេច អនុញ្ញាតឲ្យ បើក ការដ្ឋាន សាងសង់ ផ្សារ សេន ជូរី ផ្លាហ្សា ថ្មី បន្ទាប់ពី ទទួលបាន ការឯកភាព ទាំងស្រុង ពី អាជីវករ ផ្សារ កាលពី ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ កន្លងទៅ និង បាន រៀបចំ កែប្រែ សោភណ័ភាព បរិស្ថាន និង អនាម័យ ឲ្យ ផ្សារ នេះ ក្លាយទៅជា តំបន់ ឧស្សាហកម្ម . ពាណិជ្ជកម្ម . សេវាកម្ម និង ជា តំបន់ ទេសចរណ៍ ដ៏ សំខាន់ បន្ថែម ទៀត សម្រាប់ បម្រើ ឲ្យ សេចក្ដីត្រូវការ របស់ ប្រជាពលរដ្ឋ និង ភ្ញៀវ អន្តរជាតិ នៅក្នុង រាជធានី ភ្នំពេញ ។
ការសាងសង់ ផ្សារ នេះ ត្រូវបាន គិតគូរ ជាពិសេស ដល់ អាជីវករ ចាស់ ៗ ហើយ ធានា យ៉ាងណា ឲ្យ ពួកគាត់ អាច ត្រឡប់ ចូលមក លក់ដូរ នៅក្នុង ផ្សារ ដែល បាន សាងសង់ ថ្មី វិញ ក្រោយពី ផ្សារ បាន សាងសង់ រួចរាល់ ជា ស្ថាពរ ។
( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន ក្រើន រំលឹក ដល់ មន្ត្រី សុខាភិបាល ទាំងអស់ ត្រូវតែ គោរព ក្រមសីលធម៌ វិជ្ជាជីវៈ និង ខិតខំ កែលម្អ គុណភាព សេវា ដោយ មាន បែងចែក វេន ប្រចាំ ការ ២៤ ម៉ោង លើ ២៤ ម៉ោង ។
បន្ថែម លើស ពី នេះ លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា ការសម្រេច របស់ រាជ រដ្ឋាភិបាល ក្នុង ការផ្ដល់ បណ្ណ សរសើរ ជូន មន្ត្រី សុខាភិបាល នា ឱកាស នេះ គឺ ពិតជា សរបញ្ជាក់ ឱ្យ ឃើញ ពី ការគិតគូរ យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ លោក លោកស្រី ជា ក្រុម គ្រូពេទ្យ និង មន្ត្រី សុខាភិបាល គ្រប់ លំដាប់ថ្នាក់ ដែល បាន ខិតខំ បំពេញ ការងារ ប្រកបដោយ គុណ តម្លៃ និង ស្នាដៃ ល្អ ប្រសើរ ជូន ជាតិ មាតុភូមិ ជាពិសេស នៅក្នុង កិច្ចការ ប្រតិបត្តិការ ប្រយុទ្ធ ប្រឆាំង ទៅនឹង ជំងឺ ឆ្លង រាតត្បាត កូវីដ១៩ ។
លោក ម៉ែន វិបុល បាន ផ្ដាំផ្ញើ ដល់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង បុគ្គលិក សុខាភិបាល ទាំងអស់ នូវ កិច្ចការ សំខាន់ ៗ មួយចំនួន ដូច ខាងក្រោម៖
* ១៖ ត្រូវ លើកកម្ពស់ ស្មារតី ទទួលខុសត្រូវ និង ម៉ឺងម៉ាត់ ក្នុង ការងារ ជាពិសេស គឺ ការគោរព ម៉ោង ពេល បម្រើ ការងារ នៅ តាម បណ្ដា មន្ទីរពេទ្យ បង្អែក និង មណ្ឌល សុខភាព ជាមួយនិង ការយកចិត្តទុកដាក់ ខ្ពស់ ថែរក្សា បរិស្ថាន អនាម័យ ឱ្យ បាន ស្អាត ល្អ ទាំង នៅក្នុង និង ក្រៅ បរិវេណ មន្ទីរពេទ្យ ។
* ២៖ សំណូមពរ ដល់ ក្រុម គ្រូពេទ្យ យើង ទាំងអស់ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ក្រមសីលធម៌ គ្រូពេទ្យ ដោយ ត្រូវ ប្រើ ឥរិយាបទ និង ពាក្យសំដី ឱ្យ បាន សមរម្យ និង មិន ត្រូវ រើសអើង ជាមួយ ប្រជាពលរដ្ឋ និង អ្នកជំងឺ ដែល មក ទទួល សេវា នៅ តាម មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ រដ្ឋ ជាដាច់ខាត ។
* ៣៖ ត្រូវ បន្ត ខិតខំ លុបបំបាត់ ឱសថ ក្លែងក្លាយ និង សេវា សុខាភិបាល ខុស ច្បាប់ ជាពិសេស អ្នក រកស៊ី ដើរ ចាក់ ថ្នាំ គ្មាន សញ្ញាបត្រ និង គ្មាន ច្បាប់ អនុញ្ញាត ដែល ជា មូលហេតុ អាច បង្កឱ្យ មាន ផល ប៉ះពាល់ ដល់ សុខភាព និង ឈាន ទៅដល់ ប៉ះពាល់ ដល់ អាយុជីវិត របស់ ប្រជាពលរដ្ឋ ។
* ៤៖ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ពង្រឹង ការអនុវត្ត ការផ្តល់ សេវា សុខភាព ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ជាពិសេស ក្នុង ការអនុវត្ត គោល នយោបាយ គាំពារ សង្គម ផ្សេង ៗ ជូន មន្ត្រីរាជការ ប្រជាពលរដ្ឋ និង កម្មករ កម្ម ការិនី ឱ្យ បាន ត្រឹមត្រូវ និង មាន ប្រសិទ្ធភាព តួយ៉ាង កម្មវិធី មូលនិធិ សមធម៌ សម្រាប់ ប្រជាពលរដ្ឋ ក្រីក្រ និង ការប្រើប្រាស់ បណ្ណ បេឡា ជាតិ របប សន្តិសុខ សង្គម សម្រាប់ មន្ត្រីរាជការ និង កម្មករ កម្ម ការិនី ជាដើម ។
* ៥៖ ត្រូវ ខិតខំ និង យកចិត្តទុកដាក់ ពង្រឹង បន្ថែម នូវ សមត្ថភាព ជំនាញ ដល់ មន្ត្រី សុខាភិបាល ទាំង សមត្ថភាព ជំនាញ ធ្វើ រោគវិនិច្ឆ័យ ព្យាបាល និង ថែទាំ តាមរយៈ ការបណ្តុះបណ្តាល បឋម មុនពេល ចូល បម្រើ ការងារ និង ធ្វើ វិក្រឹត្យ ការបន្ថែម នៅពេល បម្រើ ការងារ ជាពិសេស ការពង្រឹង ធនធាន មនុស្ស នៅ ថ្នាក់ មណ្ឌល សុខភាព ដែល ជា កម្រិត មួយ នៅ គៀក នឹង ប្រជាពលរដ្ឋ ជាង គេ ។
* ៦៖ ត្រូវ រៀបចំ ផែនការពង្រាយ បុគ្គលិក និង មាន យន្តការលើកទឹកចិត្ត ជូន ដល់ បុគ្គលិក សុខាភិបាល ជាពិសេស នៅ តាម ទី ជនបទ ដាច់ស្រយាល ដើម្បី ធានា ថា ធនធាន មនុស្ស គ្រប់ កម្រិត បច្ចេកទេស សម្រាប់ បម្រើ វិស័យ សុខាភិបាល ក្នុង ខេត្ត ប្រកបដោយ ប្រសិទ្ធភាព មាន នៅ គ្រប់ លំដាប់ បណ្តាញ សុខាភិបាល ទាំង ទីប្រជុំជន និង ជនបទ ។
* ៧៖ ត្រូវ បន្ត យកចិត្តទុកដាក់ ការងារ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ទាំង ដូស មូលដ្ឋាន និង ដូស ជំរុញ ជូន ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ផងដែរ ៕
គ.ជ. ប បាន ឱ្យដឹង ថា បន្ទាប់ពី បាន ទទួល សម្ភារ និង ឯកសារ បោះឆ្នោត ខាងលើ គ.ជ. ប នឹង ធ្វើ ការត្រួតពិនិត្យ និង ផ្ទៀងផ្ទាត់ បញ្ជាក់ អំពី ភាពត្រឹមត្រូវ លើ លទ្ធផល នៃ ការបោះឆ្នោត តាម មណ្ឌល បោះឆ្នោត រាជធានី ខេត្ត នីមួយ ៗ ចាប់ពី ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២៣ ស្អែក នេះ ចាប់ពី វេលា ម៉ោង ៨:៣០ នាទី ព្រឹក នៅ ទីស្ដីការ គ.ជ. ប ៕
អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ដឹកនាំ ក្រុម ទី១ វេន ប្រចាំ បញ្ជា របស់ លេខាធិការដ្ឋាន នៃ គ.ស. អ ដើម្បី ក្ដាប់ សភាពការណ៍ ក្រោយ ការបោះឆ្នោត
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ លោក ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន អគ្គ ស្នងការ រង នគរបាល ជាតិ តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ជា ប្រធាន លេខាធិការដ្ឋាន នៃ គ.ស. អ បាន ដឹកនាំ ក្រុម ទី១ វេន ប្រចាំ បញ្ជា របស់ លេខាធិការដ្ឋាន នៃ គ.ស. អ ដើម្បី ក្ដាប់ សភាពការណ៍ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ នៅ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
សមាជិក សភា មកពី គណបក្ស សាធារណរដ្ឋ ចំនួន ២៥ រូប បាន ប្រាប់ លោក បៃ ដិន ថា ការលក់ នាវា មុជទឹក នុយក្លេអ៊ែរ ចំនួន ៣គ្រឿង ទៅឲ្យ អូស្រ្តាលី ក្រោម ភាពជាដៃគូ នៃ កិច្ចព្រមព្រៀង AUKUS នឹង ធ្វើឲ្យ កង នាចរណ៍ អាមេរិក ចុះខ្សោយ ប្រសិនបើ មិន មែន ផែនការ ច្បាស់លាស់ ក្នុង ការបំពាក់ អាវុធ ផ្សេង មក ជំនួស ចំពោះមុខ ការព្រួយបារម្ភ អំពី ការរីកចម្រើន ផ្នែក យោធា របស់ ចិន ។
នៅក្នុង « សៀវភៅ ស » ប្រចាំ ឆ្នាំ របស់ ខ្លួន ក្រសួង ការពារ ជាតិ ជប៉ុន បាន សង្កត់ធ្ងន់ ពី សារៈសំខាន់ នៃ ការបង្កើន កញ្ចប់ ថវិកា យោធា ក្នុង បរិបទ ដែល ពិភពលោក បាន ឈានចូល យុគសម័យ ថ្មី មួយ នៃ វិបត្តិ ។ ខណៈ សៀវភៅ ស នេះ ផ្ដោត ជា សំខាន់ លើ អំណាច យោធា ចិន កាន់តែ ធំ នៅក្នុង តំបន់ និង សង្រ្គាម ឈ្លានពាន របស់ រុស្ស៉ី នៅ អ៊ុយក្រែន កូរ៉េ ខាងជើង ក៏ ត្រូវបាន ចាត់ទុក ជា ក្ដីកង្វល់ មួយ ដ៏ ធំ របស់ ជប៉ុន ផងដែរ ។
សៀវ សនេះ ដដែល បាន គូសបញ្ជាក់ ដូច្នេះ ថា « សកម្មភាព យោធា របស់ កូរ៉េ ខាងជើង បាន និង កំពុង បង្ក ការគំរាមកំហែង ធ្ងន់ធ្ងរ និង បន្ទាន់ បំផុត ជាង ពេលណា ៗ ទាំងអស់ ដល់ សន្តិសុខ ជាតិ ជប៉ុន ... កូរ៉េ ខាងជើង មាន សមត្ថភាព វាយប្រហារ លើ ជប៉ុន ដោយ ប្រើ មីស៊ីល បាលិស្ទី គបំពាក់ ដោយ ក្បាល គ្រាប់ នុយក្លេអ៊ែរ » ។
គួរ បញ្ជាក់ ថា « សៀវភៅ ស » ខាងលើ ដែល ត្រូវបាន អនុម័ត ដោយ គណៈ រដ្ឋមន្ត្រី នៃ នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក ហ្វូមី អុ គីស៊ី ដា នៅ ព្រឹក ថ្ងៃសុក្រ នេះ កើត មាន ឡើង ចំ ពេល កូរ៉េ ខាងជើង កំពុង បង្កើន ការធ្វើតេស្ដមីស៊ីល កាន់តែ ញឹកញាប់ ឡើង ។ កាលពី ចុង ឆ្នាំ ២០២២ រដ្ឋាភិបាល លោក គីស៊ី ដា បាន អនុម័ត លើ ផែនការបង្កើន កញ្ចប់ ថវិកា យោធា ដល់ ២ភាគរយ នៃ ផលិតផល ក្នុង ស្រុក សរុប (GDP) គិត ត្រឹម ឆ្នាំ សារពើពន្ធ ២០២៧ ឬ ស្មើនឹង ជាង ៧៨. ៧ពាន់ លាន ដុល្លារ ៕
លោកស្រី ហ៊ុន ចាន់ ធី ម៉ៅធ និន នាំ អំណោយ ចែកជូន ស្រ្តី ងាយ រងគ្រោះ និង ពលរដ្ឋ មាន ជីវភាព ខ្វះខាត ចំនួន ៧០ គ្រួសារ នៅ ស្រុក កំពង់ត្រា ច
តំណាង លោកស្រី ហ៊ុន ចាន់ ធី ម៉ៅ ធ និន និង លោកស្រី យូ សុគន្ធ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ប្រធាន សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ និង លោក ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត ដែល ជានិច្ច ជាកាល តែងតែ បាន យកចិត្តទុកដាក់ គិតគូរ ពី សុខ ទុក្ខ របស់ បងប្អូន ប្រជាពលរដ្ឋ មាន ជីវភាព ខ្វះខាត រងគ្រោះ និង ងាយ រងគ្រោះ ក្នុង ខេត្ត កំពត គ្រប់ ទីកន្លែង ។
លោកស្រី បាន បញ្ជាក់ ថា ខេត្ត កំពត ក្រោម ការដឹកនាំ របស់ លោក ម៉ៅ ធ និន លោក បាន ផ្តោត សំខាន់ ទៅ លើ ការអភិវឌ្ឍ មូលដ្ឋាន ការបម្រើ សេវា សាធារណៈ ផ្សេង ៗ ឱ្យ កាន់តែ ប្រសើរ និង បាន ដោះស្រាយ រាល់ បញ្ហា ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ធ្វើ យ៉ាងណា ដើម្បីឱ្យ ពលរដ្ឋ គ្រប់ មូលដ្ឋាន ទទួល នូវ ភាព កក់ក្តៅ និង រស់ នៅក្នុង ភាពសុខដុមរម្យ នា ជា គ្រួសារ តែ មួយ ។
សិង្ហបុរី មាន ការផ្តន្ទាទោស ប្រហារជីវិត សម្រាប់ បទឧក្រិដ្ឋ មួយចំនួន រួម មាន ទាំង ឃាតកម្ម ហើយក៏ ជា ប្រទេស ដែល មាន ច្បាប់ ប្រឆាំង គ្រឿងញៀន ដ៏ តឹងរ៉ឹង បំផុត មួយ លើ ពិភពលោក ផងដែរ ។ នៅ ប្រទេស សិង្ហបុរី ការរត់ ពន្ធ កញ្ឆា លើស ពី ៥០០ ក្រាម និង ហេរ៉ូ អ៉ីន លើស ពី ១៥ក្រាម អាច ត្រូវ ប្រឈម ទោស ប្រហារជីវិត បាន ៕
ទីភ្នាក់ងារ សារព័ត៌មាន AFP ធ្វើ សេចក្ដីរាយការណ៍ បែប នេះ ដោយ ផ្អែក លើ ប្រភព ដែល ខ្លួន ទទួលបាន ពី មន្ត្រី ម្នាក់ មកពី គណបក្ស សម្ព័ន្ធ ជាតិ ដើម្បី ប្រជាធិបតេយ្យ របស់ លោកស្រី ស៊ូជី នៅ ថ្ងៃសុក្រ នេះ ។ មន្ត្រី រូប នេះ ដដែល បាន ប្រាប់ AFP ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ ដូច្នេះ ថា « លោកស្រី អោង សាន ស៊ូជី ត្រូវបាន ផ្ទេរ និង បញ្ជូន ទៅកាន់ អគារ មួយ កាលពី យប់ ថ្ងៃចន្ទ » ។
គួរ បញ្ជាក់ ថា សង្រ្គាម កូរ៉េ ត្រូវបាន បិទ បញ្ចប់ ក្រោម បទ ឈប់ បាញ់ មួយ នៅ ថ្ងៃទី ២៧ ខែកក្កដា ឆ្នាំ ១៩៥៣ ប៉ុន្តែ កូរ៉េ ខាងជើង បាន ចាត់ទុក ថ្ងៃ បិទ បញ្ចប់ សង្រ្គាម នេះ ជា ទិវា ជ័យជម្នះ របស់ ខ្លួន ៕
( ភ្នំពេញ ) ៖ គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ សូម គាំទ្រ យ៉ាង ពេញ ទំហឹង នូវ ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កាលពី ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០២៣ បាន ប្រកាស ជាសាធារណៈ លា លែង ពី តំណែង នាយក រដ្ឋមន្ត្រី ដោយ បាន ផ្តល់ នូវ សេចក្តីទុកចិត្ត បាន ផ្ទេរ តំណែង ជូន ទៅ ឱ្យ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី ក្នុង នីតិកាល ទី៧ នៃ រដ្ឋសភា ជាតិ ។
សមាជិក សមាជិកា នៃ គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ សូម ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី ដើម្បី ដឹកនាំ រាជ រដ្ឋាភិបាល កម្ពុជា អាណត្តិ ថ្មី បន្ត ការអភិវឌ្ឍន៍ ជាតិ និង ការពារ សន្តិភាព ឱ្យ បាន រឹងមាំ ប្រកប ទៅ ដោយ លទ្ធិ ប្រជាធិបតេយ្យ ដើម្បី ធ្វើឱ្យ សេដ្ឋកិច្ច ជាតិ កាន់តែ រីកចម្រើន ការរស់នៅ របស់ ប្រជា ពលរដ្ឋ ទទួលបាន ការគោរព សិទ្ធិ គ្នា និង មាន ជីវភាព កាន់តែ ធូធារ ល្អ ប្រសើរឡើង ថែម ទៀត ។
ក្នុង ឱកាស ដ៍ ថ្លៃថ្លា នេះ សមាជិក សមាជិកា នៃ គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ សូម គោរព ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រានី ហ៊ុន សែន ព្រមទាំង បុត្រា បុត្រី ចៅ ប្រុស ចៅ ស្រី ទាំងអស់ សូម ប្រកប នូវ ពុទ្ធ ពរ បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ ភោជនីដ្ឋាន ពន្លឺ ថ្មី នៅ សង្កាត់ ឡា បាន សៀក ក្រុង បាន លុង ត្រូវ ភ្លើង ឆេះ បណ្តាលឲ្យ ទ្រព្យសម្បត្តិ ជាច្រើន ត្រូវបាន បំផ្លាញ
( រតនគិរី ) ៖ ទោះបី មាន ការអន្តរាគមន៍ ពី ប្រជាពលរដ្ឋ និង អាជ្ញាធរ សមត្ថកិច្ច មូលដ្ឋាន យ៉ាងណា ក៏ មិន អាច ពន្លត់ អគ្គិភ័យ ឆាបឆេះ ភោជនីដ្ឋាន ពន្លឺ ថ្មី នៅ ភូមិ ថ្មី សង្កាត់ ឡា បាន សៀក ក្រុង បាន លុង បាន ដែរ ។
ម្ចាស់ ហាង ពន្លឺ ថ្មី លោក តា ទ្រី បាន រៀបរាប់ ថា ខណៈពេល ដែល គាត់ កំពុង ដេក លង់លក់ ក្នុង បន្ទប់ ក្នុង ភោជនីដ្ឋាន កើត ហេតុ នេះ ស្រាប់តែ មាន អ្នក នៅ ជាមួយ គាត់ ម្នាក់ ទៀត មក ដាស់ គាត់ ថា មាន ភ្លើង ឆេះ ហាង នៅ វេលា ប្រហែល ម៉ោង ២៣៖៣០ យប់ ថ្ងៃទី ២៧ ខែកក្កដា ។
គាត់ បន្ត ថា ខណៈ នោះ គាត់ មាន ការតក់ស្លុត យ៉ាង ខ្លាំង រត់ ចេញមក ក្រៅ ទាំង គ្មាន សំលៀកបំពាក់ ត្រឹមត្រូវ ផង ដូច្នេះ សម្ភារៈ មាន តម្លៃ និង លុយ មួយចំនួន ធំ ត្រូវ អគ្គិភ័យ លេប ត្របាក់ អស់ ហើយ ។
ម្ចាស់ ហាង ខាងលើ បញ្ជាក់ ទៀត ថា គាត់ បាន បាត់ ម៉ូតូ ១ គ្រឿង ម៉ាក ស៊ូមមើ ពាក់ ស្លាកលេខ រតនគិរី ២៥៧ ( ពណ៌ ក្រហម លាយ ស) ក្នុង ចំណោម ៣គ្រឿង ហើយ ទ្វារ ម្ខាង ក្នុង ហាង ដែល គាត់ ចាក់សោពី ខាងក្នុង ពេល គាត់ ស្ទុះ ចេញ ក្រៅ ហាង ទ្វារ ដែល ចាក់សោរ នោះ អត់ ឃើញ មាន សោ ។
ទន្ទឹមនឹង ហេតុការណ៍ គួរឲ្យ សោក សង្រេង នេះ តា ទ្រី ដែល ជា ម្ចាស់ ភោជនីដ្ឋាន ពន្លឺ ថ្មី សុំ ណូមពរ ឲ្យ សមត្ថកិច្ច ជួយ ស្រាវជ្រាវ រក ម៉ូតូ ដែល បាត់ នោះ មកវិញ ។
បើ តាម មន្ត្រី មគរបាល ពន្លត់ អគ្គីភ័យ នៃ ស្នងការ នគរបាល ខេត្ត រតនគិរី បាន ប្រាប់ ឲ្យដឹង នៅ ព្រលឹម ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ ថា កម្លាំង អន្តរាគមន៍ ប្រើប្រាប់ ឡាន ទឹក អស់ ជាង ៤០ ឡាន មក ហើយ រហូតមកដល់ វេលា ម៉ោង ជាង ៨ទៅ ហើយ នៅតែ គ្រប់គ្រង ស្ថានការណ៍ មិន ទាន់ បាន នៅឡើយ ទេ ដោយសារ ភោជនីដ្ឋាន ពន្លឺ ថ្មី មាន ស្ថានភាពស្មុកស្មាញ ពិបាក ឡាន ទឹក ចូល ។ ក្រុម មន្ត្រី នគរបាល ពន្លត់ អគ្គិភ័យ ខាងលើ បាន សន្និដ្ឋាន ហេតុការណ៍ ខាង លើ នេះ មូលហេតុ សង្ស័យ ទុស្សេ ខ្សែភ្លើង ៕
រដ្ឋបាល ខេត្ត រតនគិរី រៀបចំ នាំយក ទៀន ព្រះវស្សា ទេយ្យ វត្ថុ និង គ្រឿង បរិភោគ ប្រគេន ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា ចំនួន ៣៦វត្ត នៅ ទូទាំង ខេត្ត
សូម បញ្ជាក់ ថា ទេយ្យ វត្ថុ និង ទេយ្យ ទាន ដែល បាន ប្រគេន ព្រះសង្ឃ ចំនួន ៣៦វត្ត ក្នុង ខេត្ត រតនគិរី ក្នុង មួយ វត្ត ទទួលបាន៖
( ត្បូងឃ្មុំ ) ៖ លោក វង សូត ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ និង ឃុំ ជា ច ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង និង លោកស្រី នៅ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្ដាល ថ្នាក់ ខេត្ត ថ្នាក់ ស្រុក និង សមាជិក សមាជិកា បក្ស មូលដ្ឋាន ឃុំ ទាំង៨ នៃ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ និង ឃុំ ជា ច ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង សរុប ប្រមាណ ២ពាន់ នាក់ នៅ ស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក ពញា ក្រែក ។
នា ឱកាស នោះ លោក វង សូត សម្តែង នូវ មោទនភាព យ៉ាង ខ្លាំង សម្រាប់ ខេត្ត ត្បូងឃ្មុំ ពិសេស ស្រុក ពញា ក្រែក ដែល ទទួលបាន សំឡេង ឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ ចំនួន ប្រមាណ ៦៤.០៣៧ នាក់ ស្មើនឹង ជាង ៨១ % នៃ អ្នកបោះឆ្នោត សរុប ។ ដោយឡែក សន្លឹក ឆ្នោត មិន បាន ការមាន ចំនួន ៣. ៥៦៧ សន្លឹក ។
លោក វង សូត ក៏ បាន ថ្លែង នូវ ការអបអរសាទរ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ បងប្អូន ក្រុមការងារ យើង ទាំងអស់ ទាំង ក្រុមការងារ ថ្នាក់ កណ្ដាល និង នៅ ថ្នាក់ មូលដ្ឋាន ដោយ បាន ប្រើប្រាស់ ទាំង កម្លាំង កាយ ចិត្ត ទាំង ថវិកា និង សម្ភារ អស់ យ៉ាង ច្រើន ដើម្បី បម្រើ និង ជួយ ដល់ គណបក្ស ប្រជាជន កម្ពុជា យើង ឱ្យ ទទួលបាន ជោគជ័យ សម្រាប់ ការបោះឆ្នោត នៅ អាណត្តិ ទី៧ ឆ្នាំ ២០២៣ នេះ ។
ប្រធាន ក្រុមការងារ លោក វង សូត បាន បង្ហាញ ពី មោទនភាព ក្នុង ការរួម កម្លាំង គ្នា ដើម្បី ធ្វើការ ឱ្យ មូលដ្ឋាន ។ ជាមួយគ្នា នោះ យើង ត្រូវ ចាំ ឱ្យ ច្បាស់ ថា បងប្អូន ប្រជាពលរដ្ឋ មាន ការស្រឡាញ់ គាំទ្រ យើង ទាល់តែ យើង ស្រឡាញ់ គាត់ ដែរ ។ ហើយ មាន តែ កត្តា ខិតខំ ប្រឹងប្រែង ធ្វើការងារ ដោយ យកចិត្តទុកដាក់ គឺ មិន អាច ប្រហែល បាន នោះ ទេ ទើប យើង ទទួលបាន ជោគជ័យ បន្ត ទៀត ។ ដោយ ការទទួលបាន ជោគជ័យ នេះ គឺ បាន មកការលះបង់ និង ការ ខិតខំ ប្រឹងប្រែង របស់ យើង ទាំងអស់ គ្នា ។
ក្នុង ឱកាស នោះ ដែរ លោក វង សូត និង លោកស្រី ក៏ បាន អញ្ជើញ ប្រគល់ ប័ណ្ណ សរសើរ ទុក ជា អនុស្សាវរីយ៍ និង ថវិកា លើកទឹកចិត្ត ផងដែរ ដល់ ក្រុមការងារ គណបក្ស ដែល មាន ស្នាដៃ ដែល បាន ចូលរួមចំណែក ជួយ ឧបត្ថម្ភ នូវ សម្ភារ និង ថវិកា ក្នុង ដំណើរការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ នេះ ហើយ បន្ទាប់ពី បញ្ចប់ ពិធី នោះ ក៏ មាន ទទួល នូវ អាហារ សាមគ្គី ផងដែរ ។
លោក បណ្ឌិត កែវ បេង វឌ្ឍន៍ នាំយក ទៀន វស្សា និង ទេយ្យ ទាន ទៅ ប្រគេន ព្រះសង្ឃ ចំនួន ៥វត្ត និង សាលា បុណ្យ មួយ ក្នុង ក្រុង អរិយក្សត្រ ខេត្ត កណ្តាល
( ភ្នំពេញ ) ៖ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស.ស .យ .ក ) បាន ចេញ សេចក្ដីថ្លែងការណ៍ ចំពោះ ដំណើរការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ នៅ ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ កន្លងទៅ ។
ក្នុង សេចក្ដីថ្លែងការណ៍ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន អះអាង ថា ខ្លួន បាន បញ្ជូន សមាជិក សរុប ចំនួន ៤១. ៣៣៣ នាក់ ដើម្បី ធ្វើជា អ្នកសង្កេតការណ៍ នៅ តាម បណ្តា ការិយាល័យ បោះឆ្នោត នៅ ទូទាំង ២៥ រាជធានី - ខេត្ត ក្នុង ព្រឹត្តិការណ៍ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ កាលពី ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ កន្លងទៅ ថ្មី ៗ នេះ ។
ផ្អែក តាម របាយការណ៍ ដែល ទទួលបាន ពី អ្នកសង្កេតការណ៍ ខ្លួន នៅ ទូទាំង ប្រទេស សហភាព សហព័ន្ធ យុវជន កម្ពុជា សូម ធ្វើ ការវាយតម្លៃ អំពី ដំណើរការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ដូច ខាងក្រោម៖
* ១៖ អំឡុង ពេល នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោ ត៖ យុទ្ធនាការ ឃោសនា បោះឆ្នោត រយៈពេល ២១ ថ្ងៃ បាន ប្រព្រឹត្តទៅ ស្រប តាម ច្បាប់ បទបញ្ជា និង នីតិវិធី នៃ ការបោះឆ្នោត ជាធរមាន ។ គ្រប់ គណបក្ស នយោបាយ ឈរ ឈ្មោះ បោះឆ្នោត បាន ធ្វើ សកម្មភាព ឃោសនា រក សំឡេង ឆ្នោត យ៉ាង ផុសផុល ហើយ បាន ប្រព្រឹត្តទៅ ដោយ រលូន ក្រោម បរិយាកាស សន្តិសុខ និង សណ្តាប់ធ្នាប់ ល្អ ប្រសើរ ពិសេស ពុំ មាន ករណី គំរាមកំហែង ឬ អំពើហិង្សា ណាមួយ ដែល ត្រូវបាន រាយការណ៍ នៅក្នុង អំឡុង ពេល ឃោសនា បោះឆ្នោត នេះ ឡើយ ។
* ៣៖ ការរាប់ សន្លឹក ឆ្នោត៖ ដំណើរការ រាប់ សន្លឹក ឆ្នោត បាន ប្រព្រឹត្តទៅ ដោយ មាន ការចូលរួម ពី គ្រប់ ភាគី ពាក់ព័ន្ធ រួម មាន ភ្នាក់ងារ របស់ គណបក្ស នយោបាយ នានា អ្នកសង្កេតការណ៍ ជាតិ - អន្តរជាតិ ព្រមទាំង ភ្នាក់ងារ សារព័ត៌មាន ជាតិ និង អន្តរជាតិ ជាច្រើន ។ ចំណុច នេះ ឆ្លុះបញ្ចាំង ឱ្យ ឃើញ ពី តម្លាភាព ភាពត្រឹមត្រូវ និង បើក ចំហរ នៃ ដំណើរការ រាប់ សន្លឹក ឆ្នោត ស្រប តាម ច្បាប់ បទបញ្ជា និង នីតិវិធី ជាធរមាន ទាក់ទង នឹង ការបោះឆ្នោត ។
បន្ទាប់ពី ទូក នោះ បាន លិច ពេល កំពុង មាន ខ្យល់ បោកបក់ ខ្លាំងក្លា អាជ្ញាធរ ហ្វីលីពីន ជួយ សង្រ្គោះ មនុស្ស បាន ៤០ នាក់ កាលពី ថ្ងៃព្រហស្បតិ៍ ដែល មាន ន័យ ថា វា ផ្ទុក អ្នកដំណើរ ហួស ពី ចំនួន ដែល អាច ដឹក បាន ដោយ សុវត្ថិភាព ។ បើ តាម ឆ្មាំ សមុទ្រ ហ្វីលីពីន ទូក ខាងលើ មាន សមត្ថភាព ដឹក អ្នកដំណើរ បាន ត្រឹម ខ្ទង់ ៤០ នាក់ ប៉ុណ្ណោះ ដោយ សុវត្ថិភាព ។ មកទល់ ពេលនេះ នៅតែ មិន ច្បាស់ នោះ ទេ ថា មនុស្ស ប៉ុន្មាន នាក់ ឱ្យ ប្រាកដ ដែល ត្រូវបាន អនុញ្ញាតឱ្យ ឡើង លើ ទូក ខណៈ បញ្ជី អ្នកដំណើរ បង្ហាញ ឈ្មោះ មនុស្ស តែ ២២ នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ បងប្អូន ជន រួម ជាតិ ដែល បាន ផ្តល់ នូវ សេចក្តីស្រឡាញ់ ការគាំទ្រ និង ទំនុកចិត្ត ជ្រាលជ្រៅ ចំពោះ សម្តេច និង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្រ្តី ដើម្បី ដឹកនាំ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រាប់ អាណត្តិ ទី៧ ឆ្នាំ ២០២៣ ។ សម្តេច បាន ជូនពរ បងប្អូន ជន រួម ជាតិ ជួប តែ សេចក្តីសុខ និង សំណាង ល្អ ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០២៣ សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ថា សម្តេច មិន បន្ត តំណែង ជា នាយក រដ្ឋមន្ត្រី ក្នុង អាណត្តិ ថ្មី នោះ ឡើយ ។ ការ ដែល សម្តេច ប្រញាប់ប្រញាល់ លា ឈប់ ពី តំណែង ជា នាយក រដ្ឋមន្ត្រី នេះ គឺជា ការរៀបចំ ទុក ជាមុន សម្រាប់ ការរក្សា ស្ថេរភាព រយៈពេល វែង ដែល ជា មូលដ្ឋានគ្រឹះ សម្រាប់ ការអភិវឌ្ឍន៍ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការចូលកាន់ តំណែង របស់ លោក ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី មិន បាន រំលង នីតិវិធី ទាំងឡាយ នោះ ឡើយ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ក្រោយពេល សម្តេច លា ឈប់ ពី រាជ រដ្ឋាភិបាល សម្តេច នឹង ត្រូវ ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា ប្រធាន ឧត្តម ក្រុមប្រឹក្សា ព្រះមហាក្សត្រ ។ សម្តេច ក៏ នឹង ត្រូវ ក្លាយទៅជា ប្រធាន ព្រឹទ្ធសភា ជំនួស សម្តេច សាយ ឈុំ ក្រោយ ការបោះឆ្នោត ព្រឹទ្ធសភា នា ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ផងដែរ ៕ ក្រោយ បោះឆ្នោត រួច . លោក ឃួង ស្រេង ណែនាំឲ្យ មន្ដ្រី បន្ដ ខិតខំ ប្រឹងប្រែង បម្រើ ប្រជាពលរដ្ឋ និង អភិវឌ្ឍន៍ មូលដ្ឋាន របស់ ខ្លួន
( ភ្នំពេញ ) ៖ តាមរយៈ លទ្ធផល បណ្តោះអាសន្ន សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ នេះ គណបក្ស ប្រជាជន កម្ពុជា នៅតែ រក្សា បាន នូវ ឧត្តមភាព និង ប្រៀប ឈ្នះ របស់ ខ្លួន ដែល នេះ ពិតជា បាន បង្ហាញ ឲ្យ ឃើញ កាន់តែ ច្បាស់ ពី ទឹកចិត្ត របស់ ប្រជាជន កម្ពុជា ដោយ ពួកគាត់ នៅតែ ជឿជាក់ និង គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ដោយ ឥត ងាក រេ ។
នេះ ជា ការលើកឡើង របស់ លោក ឃួង ស្រេង សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស រាជធានី ភ្នំពេញ ក្នុង ពិធី សំណេះសំណាល ជាមួយ ប្រធាន គណបក្ស ខណ្ឌ - សង្កាត់ - យុវជន - នារី សហជីព សង្កាត់ និង ក្រុមការងារ ចុះ សង្កាត់ នា ព្រឹក ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ នៅ មន្ទីរ បក្ស រាជធានី ភ្នំពេញ ។
លោក ឃួង ស្រេង ក៏ បាន ផ្តាំផ្ញើ ឲ្យ ថ្នាក់ដឹកនាំ គណបក្ស ខណ្ឌ គណបក្ស សង្កាត់ ថ្នាក់ដឹកនាំ គណបក្ស មូលដ្ឋាន និង ក្រុមការងារ ចំណុះ រចនាសម្ព័ន្ធ គណបក្ស រាជធានី គ្រប់ ជាន់ ថ្នាក់ ត្រូវ គោរព នូវ លក្ខន្តិកៈ បទបញ្ជា ផ្ទៃក្នុង និង សេចក្តីសម្រេច ផ្សេង ៗ របស់ គណបក្ស ព្រមទាំង ត្រូវ បន្ត អនុវត្ត នូវ តួនាទី - ភារកិច្ច ខ្លួន ក្នុង ការបម្រើ ប្រជាពលរដ្ឋ និង ការអភិវឌ្ឍ មូលដ្ឋាន ក្នុង នោះ ត្រូវ បន្ត យកចិត្ត ទុកដាក់ លើ ចំណុច មួយចំនួន ក្នុង នោះ៖
* ទី១៖ គណបក្ស ខណ្ឌ ត្រូវ ប្រើប្រាស់ យន្តការ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខណ្ឌ ដើម្បី ថែរក្សា នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ របៀបរៀបរយ សាធារណៈ ក៏ ដូច ពង្រឹង ការអនុវត្ត គោលការណ៍ « ភូមិ - សង្កាត់ មាន សុវត្ថិភាព »
* ទី២៖ បន្ត ត្រួតពិនិត្យ និង តាមដាន រាល់ សកម្មភាព នានា ក្រុម ប្រឆាំង ជ្រុលនិយម ដើម្បី ធានា បាន ថា ក្រុម នេះ មិន បង្ក សកម្មភាព ឬ បាតុភាព ណាមួយ ដែល ប៉ះពាល់ ដល់ សន្តិសុខ ជាតិ និង ស្ថិរភាព នយោបាយ
* ទី៣៖ បន្ត ពង្រឹង មន្ត្រី ជន បង្គោល របស់ គណបក្ស គ្រប់ លំដាប់ថ្នាក់ ជាពិសេស នៅ ថ្នាក់ ភូមិ និង ក្រុម បក្ស ឲ្យ មាន ភាព នឹង ន និង ជឿជាក់ លើ ការដឹកនាំ របស់ ថ្នាក់ដឹកនាំ គណបក្ស
* ទី៤៖ បន្ត ពង្រឹង សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង គណបក្ស ឱ្យ មាន ភាព រីកចម្រើន គ្រប់ ទីកន្លែង និង គ្រប់ កាលៈទេសៈ
* ទី៥៖ បន្ត ខិតខំ ដោះស្រាយ បញ្ហា ប្រឈម និង ក្តាប់ នូវ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ធ្វើ យ៉ាងណា ទាក់ទាញ សមានចិត្ដ និង ជួសជុល ការថ្នាំង ថ្នាក់ របស់ ពួកគាត់ ឲ្យ មក ជឿជាក់ លើ សមត្ថភាព បទពិសោធន៍ របស់ គណបក្ស ដែល ជា ស្នូល ក្នុង ការដឹកនាំ ប្រទេស
* ទី៦៖ បន្ត លើកកម្ពស់ គុណភាព និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ឲ្យ កាន់តែ ល្អ ប្រសើរ តាមរយៈ ការបន្ត អភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត រូបិយ និង អរូបិយ ការបន្ត យកចិត្តទុកដាក់ លើ ការបង្កើន និង កែទម្រង់ ការផ្តល់ សេវា ទឹក ស្អាត អគ្គិសនី សំរាម និង សំណល់ គ្រប់ ប្រភេទ សេវា សុខាភិបាល អប់រំ និង សង្គមកិច្ច ជាពិសេស ការផ្តល់ សេវា សុខភាព ដោយ ឥត គិត ថ្លៃ ជូន បុគ្គលិក សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ជន ងាយ រងគ្រោះ និង ជន ក្រីក្រ គ្រប់ ប្រភេទ ៕
នគរបាល ក្រុង ក្រចេះ ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៥នាក់ ពាក់ព័ន្ធ ករណី ជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន
យោង តាម របាយការណ៍ នគរបាល ក្រុង ក្រចេះ បាន បញ្ជាក់ ឱ្យដឹង ថា ជនសង្ស័យ ទាំង ៥នាក់ រួម មាន៖
ក្នុង ប្រតិបត្ត ការបង្រ្គាប ករណី ខាងលើ នេះ កម្លាំង នគរបាល ចាប់ យក វត្ថុតាង និង សម្ភារៈ រួម មាន៖ ម្សៅ ក្រាម ពណ៍ សសង្ស័យ ជា គ្រឿងញៀន ចំនួន ០៤ កញ្ចប់ តូច . ទុយោ សម្រាប់ ចូក រំលែក គ្រឿងញៀន ចំនួន ០១. ឧបករណ៍ សម្រាប់ ជក់ គ្រឿងញៀន មួយចំនួន . ទូរស័ព្ទដៃ ចំនួន ០១ គ្រឿង ។
តាម របាយការណ៍ បញ្ជាក់ ទៀត ថា តាម ចម្លើយ សារភាព របស់ ឈ្មោះ សន សាមុត ( ហៅ ជាំង ) នៅ ថ្ងៃ ខែ ឆ្នាំ ដដែល វេលា ម៉ោង ១១: ៥០នាទី កម្លាំង អធិការដ្ឋាន នគរបាល ក្រុង ក្រចេះ បន្ត ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ០១នាក់ បន្ថែម ទៀត នៅ ចំណុច ផ្លូវ លំ ស្ថិត នៅ ភូមិ ស្រែ ស្តៅ សង្កាត់ អូរឫស្សី ក្រុង ក្រចេះ ខេត្ត ក្រចេះ ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង ត្រូវបាន ឃាត់ និង រក្សាទុក ជា បណ្តោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ក្រុង ក្រចេះ ដើម្បី កសាង សំណុំរឿង តាម នីតិវិធី ៕
ក្រសួង ការបរទេស ក៏ បាន ប្រាប់ ដល់ ពលរដ្ឋ អាមេរិក ដែល កំពុង ស្ថិត នៅ ទីនោះ ឲ្យ ចាកចេញ ផងដែរ ដោយ ប្រើប្រាស់ រយៈ មធ្យោបាយ សាធារណៈ ឬ ឯកជន តាម ដែល អាច ធ្វើ ទៅ បាន ។ នៅក្នុង គេហទំព័រ ណែនាំ ដំណើរកម្សាន្ត ក្រសួង ការបរទេស បាន គូសបញ្ជាក់ ថា « ការចាប់ ជំរិត កំពុង រីករាលដាល ហើយ មាន ជនរងគ្រោះ ជាប្រចាំ ក្នុង នោះ រួមទាំង ពលរដ្ឋ អាមេរិក ។ អ្នក ចាប់ ជំរិត អាច ប្រើ ផែនការ ដ៏ មាន ឥទ្ធិពល ឬ ឆ្លៀត ឱកាស ណា មួយ ហើយ សូម្បីតែ ក្បួន រថយន្ត របស់ មន្រ្តី ក៏ រង នូវ ការវាយប្រហារ ដែរ » ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៨. ៩៣៧ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៥. ៨៨១ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត និង លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុន្នី ចាត់ តំណាង ចុះ សួរសុខទុក្ខ លោក ថោង ឈិន ដល់ គេហដ្ឋាន ស្ថិត នៅ ខណ្ឌ ព្រែក ព្នៅ
លោក ចាយ បូរិន បាន នាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ប្រធាន គណបក្ស សម្តេច លោក លោកស្រី ដែល ជា ថ្នាក់ដឹកនាំ គណបក្ស គ្រប់ លំដាប់ថ្នាក់ ជាពិសេស លោក បណ្ឌិត ហ៊ុន ម៉ាណែត និង លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុន្នី ជូន ចំពោះ លោក ថោង ឈិន និង ក្រុមគ្រួសារ ។
លោក មាន ការពេញចិត្ត យ៉ាង ខ្លាំង ចំពោះ សកម្មភាព សួរសុខទុក្ខ របស់ យុវជន គណបក្ស ថ្នាក់ កណ្ដាល ក្រោម ការដឹកនាំ របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ដែល តែងតែ យកចិត្តទុកដាក់ ពី សុខ ទុក្ខ ជីវភាព រស់ នៅ ផ្តល់ ភាពកក់ក្តៅ និង ក្តីសង្ឃឹម ដល់ ចាស់ ព្រឹទ្ធាចារ្យ ទាំងអស់ ដែល មាន គុណ បំណាច់ ចំពោះ គណបក្ស និង ប្រទេសជាតិ ។
លោក ក៏ បាន សម្តែង នូវ ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ប្រសាសន៍ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន ថ្លែង សារ នយោបាយ ពិសេស នៅ ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០២៣ កន្លងមក នេះ និង បាន គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្រ្តី ថ្មី សម្រាប់ នីតិកាល ទី៧ នៃ រដ្ឋសភា ដើម្បី បន្ត ដឹកនាំ ប្រទេស ជាតិ រក្សា សុខ សន្តិភាព មាន ការអភិវឌ្ឍ កាន់តែ រីកចំរើន ហើយ ប្រជាជន កាន់តែ មាន ជីវភាព ធូរធារ និង រស់ នៅ ប្រកបដោយ សេចក្តីសុខសាន្ត ក្រោម ម្លប់ សន្តិភាព
លោក បាន រៀបរាប់ ពី ប្រវត្តិការងារ ថា ក្រោយ ថ្ងៃ រំដោះ ៧ មក រា ១៩៧៩ បាន ចូល បម្រើ ការងារ ជា ប្រធាន មន្ទីរ ខេត្ត ក្រចេះ អនុប្រធាន គណៈ ឃោសនា អប់រំ មជ្ឈិម អនុប្រធាន គណៈ ចាត់តាំង មជ្ឈិម បក្ស អនុ រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ បច្ចុប្បន្ន ជា សមាជិក គណៈកម្មាធិការ ត្រួតពិត្យ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ។
ក្នុង ឱកាស ដ៏ មាន អត្ថន័យ នេះ លោក ចាយ បូរិន ព្រមទាំង សមាជិក ប្រតិភូ បាន ប្រគល់ ជូន វត្ថុអនុស្សារីយ៍ ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត និង លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុន្នី ជូន ដល់ លោក ថោង ឈិន និង សូម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ វត្ថុ ស័ក្តិសិទ្ធិ ក្នុង លោក សូម តាម ជួយ បីបាច់ ថែរក្សា លោក មាន សុខភាព ល្អ កម្លាំង មាំ មួន និង មាន ជន្មាយុ យឺនយូរ ៕
អភិបាល ខេត្ត កំពង់ចាម ជំរុញ ឱ្យ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង ស្រុក បង្ក្រាប បទល្មើស នានា ដែល កើតមាន ក្នុង មូលដ្ឋាន របស់ ខ្លួន
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ជំរុញ ឱ្យ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង ស្រុក ត្រូវ រួមគ្នា បង្ក្រាប បទល្មើស នានា និង អនុវត្ត ភូមិ ឃុំ មាន សុវត្ថិភាព ឱ្យ បាន ល្អ ប្រសើរ ដើម្បី រក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ។
ការជំរុញ បែប នេះ របស់ លោក អភិបាល ខេត្ត កំពង់ចាម បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២៣ ក្នុង ឱកាស លោក បាន ដឹកនាំ កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត កំពង់ចាម ប្រចាំ ឆមាស ទី១ ឆ្នាំ ២០២៣ ដោយ មាន ការចូលរួម ពី អង្គភាព កងកម្លាំងប្រដាប់អាវុធ ទាំង បី ប្រភេទ និង គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង ស្រុក ទាំង១០ ផងដែរ ។
លោក អ៊ុន ចាន់ ដា បាន ថ្លែ ថា នៅក្នុង កំឡុង ពេល បើក យុទ្ធនាការ ឃោសនា បោះឆ្នោត និង ពេល បោះឆ្នោត អាច មាន ក្រុម ទុច្ចរិត ឬ ពួក ឆ្លៀត ឱកាស បាន បង្កើត ជា បទល្មើស ផ្សេង ៗ ក្រោម រូបភាព ប្រជាពលរដ្ឋ ដើម្បី កេង ចំណេញ ផលប្រយោជន៍ ផ្ទាល់ខ្លួន គឺ ចំពេល ដែល គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង ស្រុក សមត្ថកិច្ច ពាក់ព័ន្ធ កំពុង ជាប់ រវល់ ក្នុង ការងារ រក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ នៃ ដំណើរការ រៀបចំ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ។
