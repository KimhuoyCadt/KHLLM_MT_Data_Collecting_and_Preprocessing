( ត្បូងឃ្មុំ ) ៖ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ នៅ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន ច្រានចោល ការចុះផ្សាយ លើ បណ្តាញ សង្គម អំពី ការបើក ល្បែងស៊ីសង ខុស ច្បាប់ ក្នុង ភូមិសាស្ត្រ ឃុំ ដារ ស្រុក មេមត់ ។
ដូចនេះ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ រង់ចាំ ទទួល កិច្ចសហការ ពី បណ្ដាញ សារព័ត៌មាន ដែល បាន ផ្សព្វផ្សាយ ព័ត៌មាន ខាងលើ នេះ ដើម្បី ជា ធាតុ ចូលំ បន្ថែម ទៀត ក្នុង ការចុះ ស្រាវជ្រាវ ស្វែងរក ព័ត៌មាន ពិត លើ ករណី នេះ សម្រាប់ សមត្ថកិច្ច ពាក់ព័ន្ធ ក្នុង ខេត្ត ត្បូងឃ្មុំ ឈាន ទៅរក ការបញ្ជាក់ ការពិត ជូន សាធារណជន ជៀសវាង ការភ័ន្តច្រលំ នានា លើ ការខិតខំ ប្រឹងប្រែង អនុវត្ត តួនាទី ភារកិច្ច របស់ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ៕ ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ១៖ ទាហាន ជើង ទឹក អាមេរិក ២នាក់ ត្រូវបាន ឃាត់ខ្លួន ជុំវិញ ការលក់ ព័ត៌មាន សម្ងាត់ ទៅ ឱ្យ ចិន
២៖ លោក ដូណាល់ ត្រាំ ប្រាប់ តុលាការ ថា លោក ជា មនុស្ស សា្អតស្អំ ជុំវិញ ការចោទប្រកាន់ ទាក់ទិន នឹង ការបោះឆ្នោត ឆ្នាំ ២០២០
៣៖ កូរ៉េ ខាងជើង ថ្កោល ទោស ជំនួយ អាវុធ របស់ អាមេរិក សម្រាប់ តៃវ៉ាន់ ជា ការបង្កហេតុ ដ៏ គ្រោះថ្នាក់
៤៖ សហរដ្ឋ អាមេរិក ថា នឹង ធានាការនាំចេញ ស្បៀងអាហារ របស់ រុស្ស៉ី ប្រសិនបើ កិច្ចព្រមព្រៀង ធញ្ញជាតិ ត្រូវបាន ស្តារ ឡើងវិញ
( សៀមរាប ) ៖ នៅ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ លោក លី សំរិទ្ធ អភិបាល រង ខេត្ត សៀមរាប និង ដឹកនាំ ក្រុមការងារ នាំយក នូវ គ្រឿង ឧបភោគ បរិភោគ និង បច្ច័យ មួយចំនួន មក ប្រគេន ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា នៅក្នុង វត្ត ប្រាសាទ គោក ចក ស្ថិត នៅ សង្កាត់ គោក ចក ក្រុង សៀមរាប ខេត្ត សៀមរាប ។
លោក លី សំរិទ្ធ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ដល់ ព្រះសង្ឃ គ្រប់ អង្គ រួម ជាមួយ ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ប្រាសាទ គោក ចក ទាំងអស់ ដែល បាន ដែល បាន និមន្ត និង អញ្ជើញ ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ អាណត្តិ ទី៧ គឺ បាន បំពេញ កាតព្វកិច្ច ជា ពលរដ្ឋ ល្អ ក្នុង ការជ្រើសរើស អ្នក ដឹកនាំ ប្រទេសជាតិ ប្រកបដោយ គុណធម៌ និង សមត្ថភាព ដើម្បី ដឹកនាំ ប្រទេសជាតិ ឲ្យ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ បន្ត ទៀត ។
ព្រះគ្រូ ព្រះគ្រូ វិចិត្រ វង្សា ញាតិធ ម្មោ ហែម គឹម សាន ព្រះគ្រូ ចៅអធិការ វត្ត ប្រាសាទ គោក ចក មាន សង្ឃ ដីកា ថា ព្រះសង្ឃ នៅ គ្រប់ ទី វត្តអារាម ទូទាំង ប្រទេស គោរព ប្រពៃណី សាសនា ព្រះពុទ្ធ ត្រូវ ចូលកាន់ ព្រះវស្សា ក្នុង រយៈពេល អស់ មួយ ត្រី មាស ដែល ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា ។
( កំពត) ៖ នៅ ល្ងាច ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ ទទួលបាន ការអនុញ្ញាត ពី ថ្នាក់ដឹកនាំ លោក ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត ប្រធាន នាយកដ្ឋាន នីតិកម្ម អប់រំ និង ស្តារ នីតិសម្បទា នៃ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ជួប សំណេះសំណាល ជាមួយ ជនរងគ្រោះ សម្រាក ផ្តាច់ ភាព ញៀន នៅ មជ្ឈមណ្ឌល ព្យាបាល និង ស្តារ នីតិសម្បទា អ្នក ញៀន គ្រឿងញៀន នៅ តំបន់ ម្លេច ភូមិ បាក់នឹម ឃុំ ច្រេស ស្រុក ជុំ គិរី ខេត្ត កំពត ។
លោក ឧត្តមសេនីយ៍ ត្រី គឹម កុសល ប្រធាន មជ្ឈមណ្ឌល បាន ឲ្យដឹង ថា មជ្ឈមណ្ឌល ទទួល ព្យាបាល និង ស្តារ និតិសម្បទា ជនរងគ្រោះ មកពី បណ្តា ខេត្ត នានា តាម រយ : មាតាបិតា អាណាព្យាបាល និង បញ្ជូន ដោយ ច្បាប់ ដែល មកដល់ ពេលនេះ យើង បាន ទទួល ព្យាបាល ជនរងគ្រោះ សរុប ចំនួន ជិត៣.០០០ នាក់ ហើយ ក្នុង នោះ នារី ៧២ នាក់ ។
ថ្លែង ក្នុង នាម នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ អគ្គ លេខាធិការ និង ថ្នាក់ដឹកនាំ នា ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត បាន នាំ ការសួរសុខទុក្ខ និង កោតស សើរ ដល់ គណៈ គ្រប់គ្រង មជ្ឈមណ្ឌល ដែល បាន ខិតខំ ថែទាំ ជនរងគ្រោះ ទាំងអស់ ដូចជា កូន ប្អូន នៃ ខ្លួន ផ្តល់ ក្តីសង្ឃឹម និង ជីវិត ថ្មី ដល់ ពួកគេ ហើយ ស្រប តាម គោលការណ៍ ណែនាំ របស់ គណកម្មាធិការ ជាតិ ទទួលបន្ទុក ការងារ ព្យាបាល និង ស្តារ នីតិសម្បទា អ្នក ញៀន គ្រឿងញៀន ។
លោក ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត បាន ណែនាំ ដល់ គណៈ គ្រប់គ្រង មជ្ឈមណ្ឌល ទាំងអស់ ត្រូវ បន្ត យកចិត្តទុកដាក់ បន្ត កៀគរ ដៃគូ ផ្តល់ កិច្ចសហការបណ្តុះបណ្តាល វិជ្ជាជីវ : បំណិន ជិវិត កាន់តែ សម្បូរបែប ស្រប ទីផ្សារ ការងារ ដើម្បី ជា ទុន ផ្តល់ ដល់ ពួកគាត់ ទាំងអស់ អាច រក ចំណូល ចិញ្ចឹម ជិវិត បាន ពេល ពួកគាត់ ត្រឡប់ ទៅ រស់ នៅ ជាមួយ ក្រុមគ្រួសារ និង សហគមន៍ វិញ ៕
ប្រតិកម្ម របស់ លោក សុង សារិទ្ធ បាន កើត មាន ឡើង បន្ទាប់ ក្រុម អ្នកប្រឆាំង នៅ ប្រទេស បារាំង បាន បំពាក់ ផ្កាយ ចោទប្រកាន់ លោក ថា ជា ជនក្បត់ ជាតិ និង ជា ជនជាតិ យួន ជាដើម ក្រោយពេល រូប លោក សម្រេចចិត្ត ដើរ ចេញ ពី ក្រុម ប្រឆាំង ចូលមក រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
ក្នុង វីដេអូ ឃ្លីប ឆ្លើយតប នឹង ការលាប ពណ៌ នេះ លោក សុង សារិទ្ធ ក៏ បាន ឆ្លៀត លើកឡើង ពី ការជ្រើសតាំង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី ផងដែរ ។ លោក សារិទ្ធ បាន គាំទ្រ ចំពោះ ការតែងតាំង នេះ ព្រោះ លោក មើលឃើញ ថា លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា មនុស្ស មាន សមត្ថភាព ផ្នែក ដឹកនាំ និង មាន ចំណេះដឹង ជ្រៅជ្រះ ។
ឆ្លើយតប ការចោទ របស់ ក្រុម ប្រឆាំង ថា ការតែងតាំង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា ទង្វើ បក្ខពួក និយម នោះ លោក សារិទ្ធ បាន សួរ ទៅ ក្រុម ប្រឆាំង ថា តើ ពួកគេ អត់ មាន ចរិត បក្ខពួក និយម ទេ ឬ ? ទន្ទឹមនឹង សួរ សំណួរ បែប នេះ លោក សារិទ្ធ បាន រំលឹក ថា ពេល ក្រុម ប្រឆាំង ទទួលបាន អាសនៈ នៅក្នុង រដ្ឋសភា បាន ជ្រើសរើស សាច់ញាតិ និង ភរិយា ខ្លួន ឱ្យ ទៅ បម្រើការ នៅ រដ្ឋសភា នោះ តើ ជា ទង្វើ បក្ខពួក និយម ដែរ ឬ ទេ ? ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង លោក ហេង ឡាលីន ជា រដ្ឋលេខាធិការ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា នៅ ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ ទ្រង់ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង លោក ហេង ឡាលីន ជា រដ្ឋលេខាធិការ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ។ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ៕
ប្រទេស រុស្ស៊ី កាលពី ខែ មុន បាន បដិសេធ មិន បន្ត កិច្ចព្រមព្រៀង ដែល អនុញ្ញាតឱ្យ អ៊ុយក្រែន ដឹកជញ្ជូន គ្រាប់ ធញ្ញជាតិ ពី កំពង់ផែ សមុទ្រ ខ្មៅ របស់ ខ្លួន ទោះបីជា មាន សង្រ្គាម ក៏ដោយ ដោយ លើកឡើង ថា កិច្ចព្រមព្រៀង នេះ មិន បាន បំពេញ លក្ខខណ្ឌ ដែល ខ្លួន បាន ទាមទារ នោះ ទេ ខណៈ ដែល ការនាំចេញ ស្បៀងអាហារ និង ជី របស់ រុស្ស៉ី នៅតែ ជួប បញ្ហា ដដែល ។ ប៉ុន្តែ បាន គូសបញ្ជាក់ ថា រុស្ស៉ី នៅ ត្រៀមខ្លួន ជាស្រេច ដើម្បី ត្រឡប់ ទៅ រក កិច្ចព្រមព្រៀង វិញ នៅ ពេល ដែល បញ្ហា ទាំងនេះ ត្រូវបាន ដោះស្រាយ ។
គួរ បញ្ជាក់ ថា នៅ ថ្ងៃសុក្រ សប្តាហ៍ នេះ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក លោក Antony Blinken បាន និយាយ ថា សហរដ្ឋ អាមេរិក នឹង បន្ត ធ្វើ អ្វី ៗ គ្រប់ យ៉ាង ដែល ចាំបាច់ ដើម្បី ធានា ថា រុស្ស៉ី អាច នាំចេញ ស្បៀងអាហារ ប្រសិនបើ កិច្ចព្រមព្រៀង ដែល អនុញ្ញាតឱ្យ អ៊ុយក្រែន នាំចេញ ធញ្ញជាតិ តាម សមុទ្រ ខ្មៅ ដោយ សុវត្ថិភាព ត្រូវបាន ស្ដារ ឡើងវិញ ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ចេញ អនុក្រឹត្យ ស្តីពី ការបង្កេីត តំបន់ បេតិកភណ្ឌ ធម្មជាតិ និង ការកំណត់ ទីតាំង បេតិកភណ្ឌ វប្បធម៌ ប្រវត្តិសាស្រ្ត នគរ ភ្នំ ឈើ កាច់ បាភ្នំ ស្ថិត នៅក្នុង ភូមិសាស្ត្រ ខេត្ត ព្រៃវែង ៕ នេះ បើ តាម អនុក្រឹត្យ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ៤ ខែសីហា នេះ ៕
យល់ដឹង ពី ព្រះគណេស ក្នុង សង្គម ខ្មែរ
( ភ្នំពេញ ) ៖ សារមន្ទីរ ជាតិ របស់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នៅ ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ បាន ផ្សព្វផ្សាយ អត្ថបទ មួយ ពាក់ព័ន្ធ នឹង « ព្រះគណេស ក្នុង សង្គម ខ្មែរ » ។ ក្នុង អត្ថបទ នោះ បាន សរសេរ ថា ព្រះគណេស ជា ទេព នៅក្នុង រឿង ទេវកថា របស់ ព្រាហ្មណ៍ សាសនា ដែល បង្ហាញ ព្រះអង្គ ក្នុង ទម្រង់ ខ្លួន មនុស្ស និង ព្រះសិរជា សត្វ ដំរី មាន សត្វ កណ្ដុរ ជា យានជំនិះ ។ ព្រះអង្គ ជា បុត្រា របស់ ព្រះឥសូរ និង ព្រះនាង បរវតី ។
ព្រះអង្គ ជា ទេព តំណាង ឲ្យ ចំណេះដឹង និង បញ្ជៀស ឧបសគ្គ ផ្សេង ៗ ក្នុង នាម ជា អាទិទេព កំចាត់ ឧបសគ្គ តែ ក៏ អាច បង្កើត ឧបសគ្គ បាន ដូចគ្នា ។ តាមរយៈ សិលាចារឹក ព្រះអង្គ មាន ឈ្មោះ ជាច្រើន ដូច ជា៖ គនី ស្វរ គណបតី ស្រី គណបតិ មហា គណបតិ វិឃ នេស ឃ្នាបតិ វិឃេ្ន ស្វរ វិនាយក ។ល ។ ព្រាហ្មណ៍ សាសនិក គោរព និង ផ្តល់ កិត្តិយស ដល់ ព្រះគណេស គ្រប់ កម្មវិធី ទាំងអស់ ដូចជា ពេល ផ្តើម ការងារ ផ្សេង ៗ ធ្វើដំណើរ សាងសង់ ផ្ទះ សរសេរ សៀវភៅ ជាដើម ។
ក្រោយ បាន ជ្រាប ដំណឹង នេះ ព្រះនាង បរវតី កើតទុក្ខ យ៉ាង ខ្លាំង ។ ដោយ មើលឃើញ បែប នេះ ព្រះឥសូរ បាន បញ្ជា ឲ្យ កងទ័ព ដើរ ស្វែងរក ក្បាល មនុស្ស ឬ សត្វ ដែល ពួកគេ ជួបប្រទះ មុន គេ បង្អស់ បន្ទាប់មក ពួកគេ បាន ជួប សត្វ ដំរី មុន គេ ក៏ កាត់ យក ក្បាល ដំរី នោះ ទៅ ប្រគល់ឲ្យ ព្រះឥសូរ ដើម្បី ភ្ជាប់ ទៅ លើ ដងខ្លួន របស់ វិឃ្នេ ស្វរ វិញ ។ ហេតុ នេះ ទើប វិឃ្នេស្វរ ក្លាយទៅជា គជនន ( ដំរី ) ហៅ ថា ព្រះគណេស តាំងពី ពេល នោះ មក ។
( អត្ថបទ៖ ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ) អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៤គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២៤ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ០ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២៤ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គ្មាន បទល្មើស ។ ដោយឡែក រថយន្ត រួម មាន៖ ល្មើស សញ្ញា ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១០លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៥ នាក់ របួស ចំនួន ១២នាក់ ( របួស ធ្ងន់ ចំនួន ០៩ នាក់ ) ។ រយៈពេល ០៤ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៤៣ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១៦នាក់ របួស ៦០ នាក់ ( របួស ធ្ងន់ ៣៧នាក់ )៕
ដាណឺម៉ាក រឹតបន្តឹង ការគ្រប់គ្រង ព្រំដែន បន្ទាប់ពី មាន ការដុត គម្ពី គួរ អាន
( អូស្លូ) ៖ ក្រសួង យុត្តិធម៌ របស់ ប្រទេស ដាណឺម៉ាក បាន ឲ្យដឹង កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ ថា ប៉ូលិស កំពុង រឹតបន្តឹង ការគ្រប់គ្រង ព្រំដែន បន្ទាប់ពី ការដុត គម្ពី គួរ អាន (Koran) ដែល បង្ក ផល ប៉ះពាល់ ដល់ ស្ថានភាព សន្តិសុខ ដោយ ស្រដៀង គ្នា ទៅនឹង ចំណាត់ការ របស់ ស៊ុយអែត កាលពី ដើម សប្តាហ៍ នេះ ដែរ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសុក្រ ទី៤ ខែសីហា ឆ្នាំ ២០២៣ ។
សេចក្តីថ្លែងការណ៍ របស់ ក្រសួង យុត្តិធម៌ ដាណឺម៉ាក បាន បញ្ជាក់ ថា តាម ការសន្និដាន របស់ អាជ្ញាធរ វា ចាំបាច់ ក្នុង ពេលនេះ ដើម្បី បង្កើន ការយកចិត្តទុកដាក់ លើ អ្នក ដែល ចូលមក ប្រទេស ដាណឺម៉ាក ជា ឆ្លើយតប ទៅនឹង ការគំរាមកំហែង ចំពោះ មុខ ។ ការត្រួតពិនិត្យ ព្រំដែន កាន់តែ តឹង តែង នឹង ចាប់ផ្តើម រហូតដល់ ថ្ងៃទី ១០ ខែសីហា ។
គួរ បញ្ជាក់ ថា សកម្មជន ប្រឆាំង ក្នុង ប្រទេស ដាណឺម៉ាក និង ស៊ុយអែត បាន នាំគ្នា ដុត និង បំផ្លាញ ច្បាប់ ចម្លង មួយចំនួន នៃ សៀវភៅ ពិសិដ្ឋ របស់ ប្រជាជន កាន់ សាសនា ឥស្លាម ក្នុង រយៈពេល ប៉ុន្មាន ខែ ថ្មី នេះ ។ រដ្ឋាភិបាល នៃ ប្រទេស ទាំង ពីរ បាន ថ្កោល ទោស ចំពោះ សកម្មភាព នេះ និង កំពុង ពិចារណា លើ ច្បាប់ ថ្មី ដែល អាច បញ្ឈប់ ពួកគេ ។ ប៉ុន្តែ ក្រុម អ្នករិះគន់ ក្នុង ស្រុក និយាយ ថា ការសម្រេចចិត្ត បែប នេះ នឹង បំផ្លាញ ដល់ សេរីភាព នៃ ការបញ្ចេញមតិ របស់ ពួកគេ ៕
ចូរ ប្រាប់ មនុស្ស ជា ទីស្រឡាញ់ ពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៤ ខែសីហា៖ បង្ក្រាប ២៧ករណី ឃាត់ខ្លួន ៧៣ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៧ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៧ករណី . ជួញដូរ ៤ករណី និង ដឹកជញ្ជូន រក្សាទុក ១៦ ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៧៣ នាក់ ។
( ភ្នំពេញ ) ៖ លោក កែវ រ៉េមី រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន គណៈកម្មាធិការ សិទិ្ធ មនុស្ស កម្ពុជា បាន រៀបចំ សន្និសីទ សារព័ត៌មាន ស្ដីពី លទ្ធិ ប្រជាធិបតេយ្យ សិទ្ធិ មនុស្ស និង ការបោះឆ្នោត នៅ កម្ពុជា ។
សន្និសីទ សារព័ត៌មាន នេះ បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ នៅ ទីស្នាក់ការ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ៕
សូម ទស្សនា វីដេអូ សន្និសីទ សារព័ត៌មាន ទាំងស្រុង ដូច ខាងក្រោម៖ រដ្ឋមន្រ្តី ខៀវ កាញារីទ្ធ ជំរុញ ការផលិត ព័ត៌មាន ឲ្យ កាន់តែ មាន គុណភាព ដើម្បី ទទួលបាន ការគាំទ្រ ពីសំណាក់ ប្រជាពលរដ្ឋ
( ភ្នំពេញ ) ៖ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន នៅ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន ជំរុញ មន្ដ្រី សារព័ត៌មាន ត្រូវ មាន គំនិត ច្នៃប្រឌិត ព័ត៌មាន ឲ្យ កាន់តែ មាន គុណភាព ដើម្បី ទទួលបាន ការគាំទ្រ ពីសំណាក់ ប្រជាពលរដ្ឋ ។
ការជំរុញ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ខៀវ កាញារីទ្ធ អញ្ជើញ ជា អធិបតី ក្នុង កម្មវិធី បទបង្ហាញ ស្ដីពី « ថ្នាល អ៊ីនធឺណិត ព័ត៌មាន » នាទី ស្ដីការ ក្រសួង ព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ ។
លោក ខៀវ កាញារីទ្ធ បាន ថ្លែង ថា កន្លងទៅ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ថ្លែង ថា កាលពី យុទ្ធសាស្រ្ត នៃ ការអភិវឌ្ឍន៍ របស់ កម្ពុជា គឺ ផ្តោត លើ ចតុកោណ គឺ មនុស្ស ទឹក ភ្លើង ផ្លូវ ប៉ុន្ដែ សម័យ បច្ចុប្បន្ន នេះ គឺ បញ្ចកោណ ដែល ផ្តោត លើ មនុស្ស ទឹក ភ្លើង ផ្លូវ និង អ៊ីនធឺណិត ដើម្បីឲ្យ ស្រប តាម នឹង ការរីកចម្រើន តាម សម័យ បច្ចេកវិទ្យា ។
លោក បាន បន្ថែម ថា ដូចនេះ នៅក្នុង អាណត្តិ ថ្មី មន្ដ្រី ព័ត៌មាន នៃ ក្រសួង ព័ត៌មាន ត្រូវ បង្កើន ការច្នៃប្រឌិត បង្កើន សមត្ថភាព តាម សម័យ បច្ចេកវិទ្យា ទើប យើង អាច ធ្វើ ការប្រកួតប្រជែង បាន ។
លោកស្រី បន្ដ ថា តាម ស្ថានភាព ការវិវត្ត នៃ បច្ចេកវិទ្យា ឌីជីថល ក្រសួង ព័ត៌មាន ត្រូវ ការចាំបាច់ នូវ សន្តិសុខ ព័ត៌មាន និង បច្ចេកវិទ្យា ថ្មី ៗ ព្រមទាំង មាន កិច្ចសហការ ជាមួយ ក្រសួង ស្ថាប័ន នានា ជាពិសេស ក្រសួង មហាផ្ទៃ និង សហប្រតិបត្តិការ ជាមួយ ដៃគូ ជាតិ និង អន្តរជាតិ ដើម្បី សិក្សា និង ផ្លាស់ប្ដូរ បទពិសោធន៍ លើ ការគ្រប់គ្រង សន្តិសុខ ព័ត៌មាន និង បច្ចេកវិទ្យា ដើម្បី ឈាន ទៅរក ការពង្រឹង និង អភិវឌ្ឍ វិស័យ ព័ត៌មាន នា ពេល អនាគត ប្រកបដោយ ប្រសិទ្ធភាព និង សុវត្ថិភាព ខ្ពស់ ។
រដ្ឋបាល ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ជូនដំណឹង ពី ការផ្អាក ការចរាចរ ឆ្លងកាត់ កំណាត់ ជាតិ លេខ ៤៤ ចាប់ពី រង្វង់ មូល ផ្សារ កន្ទួត ដល់ ភូមិ តាំង បំពង់ ជា បណ្ដោះអាសន្ន សិន ដោយ មាន ជំនន់ ទឹកភ្លៀង ហក់ ឡើង ខ្លាំង
( កំពង់ស្ពឺ ) ៖ រដ្ឋបាល ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ នា ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ពី ការផ្អាក ការចរាចរ ឆ្លងកាត់ កំណាត់ ជាតិ លេខ ៤៤ ចាប់ពី រង្វង់ មូល ផ្សារ កន្ទួត ឃុំ សង្កែ សាទ ប ទៅដល់ ភូមិ តាំង បំពង់ ឃុំ តាសាល ជា បណ្ដោះអាសន្ន សិន ដោយសារ នៅក្នុង ភូមិសាស្ត្រ នេះ ជំនន់ ទឹកភ្លៀង កំពុង ហក់ ឡើង ខ្លាំង ពិសេស នៅ ទឹក នៅ ទំនប់ តា សាល ហក់ ឡើង ដល់ កម្រិត ប្រកាស អាសន្ន ។
អនុ រដ្ឋលេខាធិការ ក្រសួង អប់ រំ៖ ការពង្រឹង បាន នូវ សុខភាព សិក្សា គឺជា ផ្នែក មួយ ជួយ ពង្រឹង បាន នូវ គុណភាព អប់រំ
( ពោធិ៍សាត់ )៖ លោកស្រី សឿ សុជាតា អនុ រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ថ្លែង ថា ការពង្រឹង បាន នូវ សុខភាព សិក្សា គឺជា ផ្នែក មួយ ជួយ ពង្រឹង បាន នូវ គុណភាព អប់រំ នាំឱ្យ ការអភិវឌ្ឍ ប្រទេស ទៅ មុខ បាន លឿន ដោយ ចីរភាព ។
ការថ្លែង បែប នេះ ក្នុង ឱកាស បើក សិក្ខាសាលា ផ្សព្វផ្សាយ ពី បញ្ហា គ្រឿងញៀន បារី អេឡិចត្រូនិក មេរោគ អេដស៍ និង គ្រោះ នៃ គ្រឿងញៀន ជាមួយ សិស្សនុសិស្ស លោកគ្រូ អ្នកគ្រូ អាជ្ញាធរ មូលដ្ឋាន ចំនួន ២៥៨ នាក់ នៅ ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ ។
លោកស្រី សឿ សុជាតា បាន ពាំនាំ ការសាកសួរ ទុក្ខ និង កោតស សើរ ថ្នាក់ដឹកនាំ ជាតិ ពិសេស បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្រ្តី ក្រសួង អប់រំ យុវជន និង កីឡា ជូន សិស្សនុសិស្ស លោកគ្រូ អ្នកគ្រូ ដែល បាន ចូលរួម អនុវត្ត នូវ ផែនការជាតិ លើកកម្ពស់ សុខភាព សិក្សា ផ្តល់ ភាពសុខដុម ដល់ សិស្ស និង មាតាបិតា សិស្ស ។
( ភ្នំពេញ ) ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា កម្ពុជា នៅ ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន ផ្ញើ សារលិខិត ជូន ពរ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ឱកាស ចម្រើន ជន្មាយុ គម្រប់ ៧១ ឆ្នាំ ។
( សៀមរាប ) ៖ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ក្រុង ពាលី ជួសជុល ដំបូល ហោ និង រៀបចំ កែលម្អ បរិស្ថាន សំណង់ ឡើងវិញ នៅ ទី សក្ការៈ ព្រះអង្គ ចេក ព្រះអង្គ ចម ខេត្ត សៀមរាប នា ព្រឹក ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ ។
យោង តាម ការតំណាល ត ៗ គ្នា ថា ព្រះអង្គ ចេក ព្រះអង្គ ចម ជា ទេពធីតា ដែល ជា អតីត ព្រះរាជ បុត្រី របស់ ព្រះបាទ សូរ្យ វរ្ម័ន ទី២ ដែល ជា ស្ថាបនិក សាង ប្រាសាទ អង្គរវត្ត ។
មូលហេតុ ដែល នាំឲ្យ ប្រជាពលរដ្ឋ មាន ជំនឿ ចាប់អារម្មណ៍ និង គោរព បូជា ចំពោះ ព្រះនាង ចេក ព្រះអង្គ ចម គឺ ដោយសារតែ ភាពសុច្ច រឹត ទៀង ត្រង់ ទន់ភ្លន់ និង ប្រកបដោយ ក្ដី មេត្តា ក រុណា យ៉ាង ខ្ពង់ខ្ពស់ ដែល ព្រះអង្គ ទាំង ពីរ តែងតែ អាណិតអាសូរ ធ្វើ បុណ្យ ដាក់ ទាន ដល់ អស់ ប្រជានុរាស្រ្ត ដែល ត្រូវការ ព្រះនាង ទាំង ពីរ ជួយ ពិសេស ទៅ ទៀត ព្រះនាង ទាំង ពីរ បាន អប់រំ អ្នកទោស ទាំងឡាយ ឲ្យ ដើរ តាម គន្លង ទូន្មាន របស់ ព្រះពុទ្ធ សាសនា និង បាន ដោះលែង ពួកគេ ឲ្យ មាន សេរីភាព ថែម ទៀត ។
ព្រះនាង ទាំង ពីរ គឺជា អ្នក ដែល គោរព ប្រតិបត្តិ ព្រះពុទ្ធ សាសនា យ៉ាង ខ្ជាប់ខ្ជួន ដែល ប្រជារាស្រ្ត ទូទាំង នគរ បាន ដឹង អំពី ចរិក លក្ខណៈ ដ៏ ប្រពៃ របស់ ព្រះនាង ទាំង ពីរ ម្លោះ ហើយ ពី មួយ ជំនាន់ ទៅ មួយ ជំនាន់ រហូតដល់ រជ្ជកាល ព្រះបាទ អង្គ ចន្ទ រាជា ឡើង គ្រងរាជ្យសម្បត្តិ នា សតវត្សរ៍ ទី១៦ ព្រះអង្គ បាន អនុញ្ញាតឱ្យ គេ សាង រូប ព្រះនាង ចេក ចម សម្រាប់ ប្រជារាស្ត្រ ទូទៅ គោរព បូជា ។
លុះ ក្រោយមក រូប ទាំង ពីរ នេះ បាន ធ្វើឲ្យ ប្រជារាស្រ្ត រស់ នៅ ប្រកបដោយ សេចក្ដីសុខ ចម្រើន ទើប ប្រជារាស្រ្ត បាន ចាត់ទុក រូប ទាំង ជា ព្រះពុទ្ធរូប ដ៏ ស័ក្ដិសិទ្ធិ និង មាន កិត្តិនាម ល្បីរន្ទឺ ទូទាំង ប្រទេស មិន ត្រឹមតែ ប៉ុណ្ណោះ រូប ទាំង ពីរ បាន ក្លាយជា ភាពទាក់ទាញ សម្រាប់ បុគ្គល មាន អំណាច និង ឈ្មួញ ទុច្ចរិត ដោយ ពួកគេ ចាប់ផ្ដើម រៀប ផែនការលួច សម្រាប់ ទុក ធ្វើជា កម្មសិទ្ធិ និង ការលក់ដូរ ។
ហេតុ នេះ ហើយ បានជា រូប ព្រះ អង្គ ចេក ព្រះអង្គ ចម បាន បាត់ មួយ រយៈ ក្នុង អំឡុង ពេល នៃ តំបន់ អង្គរ ត្រូវបាន គេ បោះបង់ ចោល ។ ទោះ យ៉ាងណា ក៏ដោយ រូបសំណាក ទាំង ពីរ នេះ ត្រូវបាន រកឃើញ ឡើងវិញ ក្នុង ឆ្នាំ ១៩៥០ នៅក្នុង ព្រៃ ម្ដុំ ក្រុង អង្គរ ធំ ដោយ ក្រុម មន្ត្រី អភិរក្ស អង្គរ ខេត្ត សៀមរាប ដែល គេ ជឿ ថា រូប ព្រះអង្គ ចេក ព្រះអង្គ ចម កាលពី ដើម ត្រូវបាន តម្កល់ ទុក នៅក្នុង ប្រាសាទ អង្គរវត្ត ។
លុះ មកដល់ សម័យ ខ្មែរ ក្រហម គ្រប់គ្រង នៅ ឆ្នាំ ១៩៧៥ - ១៩៧៩ រូបសំណាក ព្រះអង្គ ចេក ព្រះអង្គ ចម ក៏ ត្រូវ ក្រុម ទាហាន ខ្មែរ ក្រហម យក ទៅ ទម្លាក់ ចោល ក្នុង ស្ទឹង សៀមរាប ស្រុត កប់ បាត់ ទៅក្នុង ភក់ បាត ស្ទឹង រហូតដល់ ខេត្ត សៀមរាប ត្រូវបាន រំដោះ នៅ ឆ្នាំ ១៩៧៩ ។
គេ ជឿ ថា ក្រុម ទាហាន ខ្មែរ ក្រហម ដែល នាំគ្នា ដឹក យក រូបសំណាក ទាំង ពីរ នេះ ទៅ ចោល ក្នុង ស្ទឹង សៀមរាប បាន ស្លាប់ ដោយសារ បារមី របស់ ព្រះអង្គ ចេក ព្រះអង្គ ចម នៅ ក្រោយពេល មិន យូរ ប៉ុន្មាន បន្ទាប់ពី យក ព្រះពុទ្ធរូប ទាំង ពីរ នេះ មក ទម្លាក់ ចោល ក្នុង ទឹក ស្ទឹង ។
ក្រោយមក នៅ ឆ្នាំ ១៩៨២ ព្រះចៅ អធិការ វត្ដ ដំណាក់ រួម ជាមួយ នឹង ការចូលរួម ពី លោក អភិបាល ខេត្ត សៀមរាប គឺ លោក នៅ សម បាន នាំគ្នា កសាង អាស្រម តូច មួយ នៅក្បែរ ព្រះរាជ ដំណាក់ ស្ដេច ក្នុង បរិវេណ សួន ឯករាជ្យ ឬ សួន ដំណាក់ ស្ដេច ហើយ ប្រារព្ធ ពិធី ដង្ហែ ព្រះពុទ្ធរូប ទាំង ពីរ អង្គ ពី វត្ត ដំណាក់ មក តម្កល់ ទុក នៅ ទីនោះ ។
សព្វ ថ្ងៃ នេះ ក្លាយជា កន្លែង អាច ឲ្យ ពុទ្ធ បរិស័ទ្ធ និង ប្រជាពលរដ្ឋ ខ្មែរ ទូទាំង ប្រទេស សម្រាប់ គោរព បូជា និង បួងសួង សុំ សេចក្ដីសុខ សប្បាយ តាម សេចក្ដីប្រាថ្នា របស់ ពួកគេ ម្នាក់ ៗ តាម ការបន់ស្រន់ រៀង ៗ ខ្លួន ។
បន្ទាប់មក ទៀត សម្តេច កិត្តិសង្គហ បណ្ឌិត ក៏ បាន អញ្ជើញ ទស្សនា ប្រាសាទ មួយ ចំនួន ក្នុង ខេត្ត សៀមរាប ផងដែរ ៕
លោក បណ្ឌិត សម តារា ប្រគេន ទៀន ព្រះវស្សា និង ទេយ្យ ទាន ដល់ ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា ចំនួន ២វត្ត នៅ ស្រុក ចន្ទ្រា
សូម បញ្ជាក់ ថា លោក បណ្ឌិត សម តារា បាន ប្រគេន ទៀន ព្រះវស្សា និង ទេយ្យ វត្ថុ សរុប បច្ច័យ ៦លាន រៀល ក្នុង ១វត្ត ផងដែរ ៕ ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ លោក សំ ព្រហ្មនា សមាជិក ក្រុមប្រឹក្សា ធម្មនុញ្ញ
( ភ្នំពេញ ) ៖ លោក កិត្តិនីតិកោសល បណ្ឌិត អ៉ឹម ឈុន លឹម ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ បាន ផ្ញើ សារ រំលែក ទុក្ខ ជូន លោក សំ ព្រហ្មនី និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ លោក សំ ព្រហ្មនា សមាជិក ក្រុមប្រឹក្សា ធម្មនុញ្ញ ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ ក្នុង ជន្មាយុ ៨១ ឆ្នាំ ដោយ រោគា ពាធ ។
« ក្នុង នាម ក្រុមប្រឹក្សា ធម្មនុញ្ញ ខ្ញុំ និង ភរិយា ព្រមទាំង មន្ត្រីរាជការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ មាន សេចក្តីរន្ធត់ សង្វេគ ក្នុង ចិត្ត យ៉ាង ក្រៃលែង និង សោកស្តាយ ជា អនេក ដោយ ទទួលបាន ដំណឹង អំពី មរណភាព របស់ ឯកឧត្តម សំ ព្រហ្មនា សមាជិក ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៅ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ វេលា ម៉ោង ១៣៖០០ នាទី ក្នុង ជន្មាយុ ៨១ ឆ្នាំ ដោយ រោគា ពាធ ។
ខ្ញុំ សូម ចូលរួម រំលែក មរណទុក្ខ ជាមួយនឹង ឯកឧត្តម និង ក្រុមគ្រួសារ ចំពោះ ការបាត់បង់ លោកឪពុក លោកឪពុក ក្មេក និង ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ជាទីគោរព ស្រឡាញ់ របស់ ក្រុមគ្រួសារ ឯកឧត្តម ។
ក្នុង ឱកាស ដ៏ ក្រៀមក្រំ នេះ តាង នាម សមាជិក សមាជិកា នៃ ក្រុមប្រឹក្សា ធម្មនុញ្ញ និង មន្ត្រីរាជការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ខ្ញុំ និង ភរិយា សូម ចូលរួម នូវ មរណទុក្ខ ដ៏ ក្រៀមក្រំ អាឡោះអាល័យ ជាមួយ ឯកឧត្តម ព្រមទាំង ក្រុមគ្រួសារ និង បួងសួង សូមបដិសន្ធិ វិញ្ញាណ របស់ ឯកឧត្តម សំ ព្រហ្មនា បាន អញ្ជើញ ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សូម ឯកឧត្តម និង ក្រុមគ្រួសារ ទទួល នូវ ការចូលរួម រំលែក មរណទុក្ខ ដ៏ សែន ក្រៀមក្រំ បំផុត នេះ ដោយ ស្មោះ អស់ ពី ដួងចិត្ត ពី ខ្ញុំ និង ភរិយា » ៕
គ.ជ. ប ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ កិច្ចប្រជុំ ពិនិត្យ និង សម្រេច លើ ឯកសារ មួយចំនួន
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នា ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន បើក កិច្ចប្រជុំ ក្រោម អធិបតីភាព លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ. ប ដើម្បី ពិនិត្យ និង សម្រេច លើ របាយការណ៍ សង្ខេប ស្តីពី ការគ្រប់គ្រង និង ប្រព្រឹត្តទៅ នៃ ការបោះឆ្នោត ខ្លឹមសារ ឯកសារ ផ្សព្វផ្សាយ សម្រាប់ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២៣ លិខិត ឆ្លើយតប និង ឯកសារ លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ។
គ្រឿងញៀន ជាង ៧៨០ គីឡូក្រាម ចរាចរណ៍ កាត់ កម្ពុជា ត្រូវបាន កម្លាំង នគរបាល បង្ក្រាប បាន ជាមួយ ឧក្រិដ្ឋ ជន ៦នាក់
( ភ្នំពេញ ) ៖ កម្លាំង ជំនាញ របស់ មន្ទីរ ប្រឆាំង គ្រឿងញៀន នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន បើក ប្រតិបត្តិការ បង្ក្រាប ក្រុម ឧក្រិដ្ឋ ជន ចរាចរណ៍ គ្រឿងញៀន ឆ្លង ដែន ជាង ៧៨០ គីឡូក្រាម ពី តំបន់ ត្រីកោណ មាស ឆ្លងកាត់ ឡាវ - កម្ពុជា បន្ត ចេញ ទៅ កោះ តៃវ៉ាន់ ប្រទេស ចិន តាម លំហរ សមុទ្រ ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង ដោយ អនុវត្ត តាម បញ្ជា របស់ នាយ ឧត្ដមសេនិយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង នាយ ឧត្ដមសេនិយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការ រង ទទួល ផែន ប្រឆាំង បទល្មើស គ្រឿងញៀន ក្រោម ការបញ្ជាដឹកនាំ ផ្ទាល់ របស់ លោក ឧត្ដមសេនីយ៍ ឯក ឃឹង សារ៉ាត់ នាយក មន្ទីរ ប្រឆាំង គ្រឿងញៀន ។
នៅពេល បង្ហាញ មុខ ជាសាធារណៈ នៅ ព្រឹក ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បាន ឲ្យដឹង ថា បន្ទាប់ពី បាន ទទួល ព័ត៌មាន ចារកម្ម ពី (DEA) កម្លាំង ជំនាញ នៃ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បាន បើក ការស៊ើបអង្កេត រយៈពេល ជាង ៤ខែ ដើម្បី ស្រាវជ្រាវ ច្បាម មុខ សញ្ញា ឧក្រិដ្ឋ ជន គ្រឿងញៀន ដែល មាន អង្គការ ចាត់តាំង ជនជាតិ ចិន ( តៃវ៉ាន់ ) ១ក្រុម ដែល បាន ធ្វើ សកម្មភាព ចរាចរណ៍ គ្រឿងញៀន ឆ្លង ដែន ពី តំបន់ ត្រីកោណ មាស ឆ្លងកាត់ ឡាវ - កម្ពុជា បន្ត ចេញ ទៅ កោះ តៃវ៉ាន់ ប្រទេស ចិន តាម លំហរ សមុទ្រ ។
សរុប លទ្ធផល ឃាត់ខ្លួន ជនសង្ស័យ ៦នាក់ ភេទ ប្រុស ជនជាតិ ចិន ( តៃវ៉ាន់ ) និង ចាប់ យក វត្ថុតាង សារធាតុ ញៀន ប្រភេទ កេតាមីន ចំនួន ៧៨៥ ដុំ ស្មើ ទម្ងន់ ៧៨៩. ៧៨១ គីឡូក្រាម . រថយន្ត ៤គ្រឿង . ម៉ូតូ ២គ្រឿង . ទូរស័ព្ទ៧ គ្រឿង និង គណនី ធនាគារ ៨គណនី ។
បច្ចុប្បន្ន ជនសង្ស័យ ព្រមទាំង វត្ថុតាង ចាប់ យក ខាងលើ បាន កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការ បន្ត តាម នីតិវិធី ។
សូម ជម្រាប ថា មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ក្រោយពេល ឧត្តមសេនីយ៍ ឯក ឃឹង សារ៉ាត់ ចូលមក ដឹកនាំ ការងារ គឺ បង្ក្រាប បាន បទល្មើស គ្រឿងញៀន ធំ ៗ ជាច្រើន ករណី ជា បន្តបន្ទាប់ ។ ជាមួយគ្នា នេះ ឧត្តមសេនីយ៍ ឯក ឃឹង សារ៉ាត់ បាន ប្តេជ្ញាចិត្ត ខ្ពស់ ក្នុង បង្ក្រាប បទល្មើស គ្រឿង ដូច ភ្លៀង រលឹម នៅ ទូទាំង ប្រទេស ឱ្យ ដល់ ឫស គល់ ៕
អគ្គ លេខាធិការ អាស៊ាន ចូលរួម វេទិកា អាស៊ាន និង អាស៉ី លើក ទី ១៥ នៅ ប្រទេស សិង្ហបុរី
នៅ ព្រឹក ថ្ងៃ ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ នៅ ប្រទេស សិង្ហបុរី មុនពេលវេទិកា អាស៊ាន និង អាស៊ី លើក ទី ១៥ បាន ចាប់ផ្តើម លោក បណ្ឌិត កៅ គឹម ហួន បាន ផ្តល់ កិច្ចសម្ភាស ដល់ ទូរទស្សន៍ CNBC ។ នៅក្នុង កិច្ចសម្ភាស នោះ អគ្គ លេខាធិការ អាស៊ាន បាន ចែករំលែក ទស្សនៈ ស្តីពី វឌ្ឍនភាព ចុងក្រោយ នៃ សមាហរណកម្ម អាស៊ាន មជ្ឈភាព អាស៊ាន និង បញ្ហា តំបន់ និង អន្តរជាតិ មួយចំនួន ទៀត ។
ក្រោយមក លោក បណ្ឌិត កៅ គឹម ហួន បាន អញ្ជើញ ផ្តល់ សុន្ទរកថា បើក ក្នុង វេទិកា អាស៊ាន និង អាស៊ី លើក ទី១៥ ។ នៅក្នុង សន្ទរកថា អគ្គ លេខាធិការ អាស៊ាន បាន គូសបញ្ជាក់ ពី អាស៊ាន ក្នុង នាម ជា កម្លាំង ស្នូល នៅក្នុង កិច្ចការ តំបន់ ដែល ដើរ តួនាទី សំខាន់ ក្នុង ការផ្សាភ្ជាប់ រវាង តួអង្គ តំបន់ នានា ជាមួយ តួអង្គ ពាក់ព័ន្ធ ទាំងអស់ ក្នុង ការលើកកម្ពស់ ការសម្របសម្រួល និង សហការ នៅក្នុង វិស័យ នៃ កិច្ចសហប្រតិបត្តិការ មួយចំនួន ។ វេទិកា នេះ មាន ការចូលរួម ពី មន្ត្រី ជាន់ ខ្ពស់ និង មេដឹកនាំ ធុរកិច្ច ផងដែរ ។
ក្រុម ISIS បាន កើនឡើង ឥទ្ធិពល យ៉ាង ខ្លាំង នៅ ប្រទេស អ៉ីរ៉ាក់ និង ស៉ីរី កាលពី ឆ្នាំ ២០១៤ ដោយ ទឹកដី មួយ ផ្នែក ធំ នៃ ប្រទេស ទាំង ពីរ បាន ស្ថិត ក្រោម ការកាន់កាប់ របស់ ក្រុម ភេរវករ នេះ ។ ប៉ុន្តែ ប៉ុន្មាន ឆ្នាំ ក្រោយមក ISIS ក៏ ត្រូវបាន កម្ចាត់ ទៅ វីញ នៅ អ៉ីរ៉ាក់ កាលពី ឆ្នាំ ២០១៧ និង នៅ ប្រទេស ស៉ីរី ២ឆ្នាំ បន្ទាប់មក ទៀត ។ ទោះជា បែប នេះ ក្តី បណ្តាញ ភ្នាក់ងារ របស់ ISIS ដែល សំងំ លាក់ ខ្លួន នៅតែ បន្ត ធ្វើ សកម្មភាព វាយប្រហារ ម្តងម្កាល ដដែល ទាំង នៅ ប្រទេស អ៉ីរ៉ាក់ និង នៅ ស៉ីរី ។
( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន ទម្លាយ អំពី សារសំឡេង របស់ សមាជិក ក្រុម ប្រឆាំង នៅ ក្រៅ ប្រទេស ម្នាក់ ឈ្មោះ មាស លក្ខិណា ដែល បាន បក អាក្រាត អំពី អំពើ ឃោរឃៅ របស់ មេដឹកនាំ ក្រុម ប្រឆាំង នៅ ក្រៅ ប្រទេស ដែល បាន ធ្វើ ចំពោះ ខ្លួន និង ក្រុមគ្រួសារ ។
សូម ស្តាប់ សំដី លោកស្រី មាស់ លក្ខិណា ដែល និយាយ អំពី ភាពសាហាវ របស់ ក្រុម ប្រឆាំង នៅ ក្រៅ ប្រទេស និង ការលំបាក នៃ ជីវភាព សម្រាប់ អ្នក រស់ នៅ ប្រទេស ក្រៅ ។ ទោះបី លោកស្រី ស្អប់ និង ជេរ ប្រមាថ ខ្ញុំ តែ លោកស្រី នៅតែ ចាត់ទុក ក្រុម លោកស្រី ជា អ្នកសាហាវ ។ សូម កុំ សួរ ថា សម្លេង នេះ បាន មក ដោយ របៀប ណា ? និង សូម ស្តាប់ ទាំងអស់ គ្នា ។
បើ តាម វីដេអូ សំឡេង ខាងលើ នេះ លោកស្រី មាស លក្ខិណា បាន ត្អូញត្អែរ អំពី ការរង ការធ្វើ ទុក្ខបុកម្នេញ របស់ ក្រុម លោក ម៉ែន សុថាវរិន្ទ្រ ដោយ មាន ការគំរាម សម្លាប់ លោកស្រី និង កូន ៗ ៕
ខាងក្រោម ជា សារសំឡេង របស់ សមាជិក ក្រុម ប្រឆាំង នៅ ក្រៅ ប្រទេស ម្នាក់ ឈ្មោះ មាស លក្ខិណា៖
ស្រប ពេល ដែល ផលិតផល ប្លាស្មា នៅលើ ពិភពលោក និង ជាពិសេស នៅក្នុង តំបន់ អាស៊ី កំពុងតែ មាន ការខ្វះខាត នោះ វា បាន ជះ ឥទ្ធិពល អវិជ្ជមាន ទៅដល់ ដំណើរការថែទាំ សុខុមាលភាព របស់ មនុស្ស ជាច្រើន នៅ តាម បណ្តា ប្រទេស នានា ។ ជា ហេតុ នាំឱ្យ ភាព ជាដៃគូ នៃ សហប្រតិបត្តិ រវាង ភាគី ទាំង បី នៅ ពេល នេះ គឺជា ជំហាន ទៅ មុខ ដ៏ សំខាន់ មួយ នៅក្នុង ការលើកកម្ពស់ ប្រព័ន្ធ សុខាភិបាល ដើម្បី ការឆ្ពោះ ទៅរក គោលដៅ សម្រាប់ អាស៊ាន អាច មាន លទ្ធភាព ក្នុង ការប្រើប្រាស់ ផលិតផល ព្យាបាល ប្លាស្មា បាន គ្រប់គ្រាន់ ទៅ តាម តម្រូវការ ។
សូម បញ្ជាក់ ថា ប្លាស្មា គឺជា ធាតុ រាវ នៃ ឈាម ដែល មាន ផ្ទុក សមាសធាតុ គីមី នៅក្នុង ឈាម ដូចជា សារធាតុ ចិញ្ចឹម កាកសំណល់ ហើយ ក្នុង នោះ ក៏ មាន ផងដែរ នូវ អង់ទីករ ។ វា មាន ប្រយោជន៍ សំខាន់ សម្រាប់ សុខភាព ដូចជា ការព្យាបាល ជំងឺ មហារីក ការគ្រប់គ្រង កំណក ឈាម និង ការព្យាបាល វេជ្ជសាស្រ្ត ជាច្រើន ផ្សេង ទៀត ។
អ្នក ឧកញ៉ា គិត ម៉េង បាន គូសបញ្ជាក់ ទៀត ថា ក្រុមហ៊ុន នឹង ធើ្វ ការផ្តោត សំខាន់ ទៅ លើ៖ ១. ប្រមូល ទិញ ធាតុ ប្លាស្មា នៅ ជុំវិញ តំបន់ អាស៊ី អាគ្នេយ៍ ២. សាងសង់ មន្ទីរ សម្រាប់ ប្រភាគ ប្លាស្មា ថ្មី មួយ នៅ ប្រទេស សិង្ហបុរី ក្នុង តម្លៃ ៤០០ លាន ដុល្លារ ដែល មាន សមត្ថភាព ប្រភាគ ប្លាស្មា ចំនួន ១លាន លីត្រ ក្នុង ១ឆ្នាំ សម្រាប់ អាស៊ាន និង ៣. សាងសង់ ទីកន្លែង ផលិតផល សម្រេច នៅ ប្រទេស កម្ពុជា ដើម្បី វេចខ្ចប់ និង ចែកចាយ ប្លាស្មា ។
សូម ជម្រាប ថា ក្រុមហ៊ុន រ៉ូយ៉ាល់ គ្រុប គឺជា ក្រុមហ៊ុន វិនិយោគ ដ៏ ធំ ជាង គេ នៅក្នុង ប្រទេស កម្ពុជា ដែល ត្រូវបាន គេ ទទួលស្គាល់ ជាទូទៅ ថា ជា ក្រុមហ៊ុន អាជីវកម្ម ដែល មាន សក្តានុពល និង មាន ភាព ចម្រុះ ជាង គេ បំផុត នៅក្នុង ប្រទេស មួយ នេះ ។ ក្រុមហ៊ុន បាន ធើ្វ ការបណ្តាក់ទុន លើ វិស័យ ជាច្រើន រួម មាន ទូរគមនាគមន៍ ការដឹកជញ្ជូន ថាមពល ប្រព័ន្ធ ផ្សព្វផ្សាយ ព័ត៌មាន និង ការកម្សាន្ត ធនាគារ និង ហិរញ្ញវត្ថុ ការធានារ៉ាប់រង សណ្ឋាគារ និង រមណីយដ្ឋាន ការអប់រំ ការអភិវឌ្ឍ អចលន ទ្រព្យ ការជួញដូរ និង កសិកម្ម ជាដើម ។
ក្រុមហ៊ុន រ៉ូយ៉ាល់ គ្រុប គឺជា ច្រកទ្វារ យុទ្ធសាស្ត្រ ដ៏ សំខាន់ នៃ ការវិនិយោគ នៅក្នុង ប្រទេស កម្ពុជា ជាមួយនឹង ប្រវត្តិ នៃ ភាពជោគជ័យ និង ភាពជាដៃគូ ដែល ឈាន មុខ គេ នៅលើ ទីផ្សារ ជាមួយនិង ក្រុម អ្នក វិនិយោគ នៅក្នុង វិស័យ ឧស្សាហកម្ម នានា ជាច្រើន ហើយ នឹង ផ្តល់ នូវ សក្តានុពល វិនិយោគ ដ៏ ច្រើន លើសលប់ នៅក្នុង សេដ្ឋកិច្ច ទីផ្សារ សេរី ដ៏ ពិតប្រាកដ ដំបូង គេ នៅក្នុង តំបន់ ដង ទន្លេ មេគង្គ នៃ អាស៊ី ៕
អាជ្ញាធរ ខេត្ត សៀមរាប ចុះ ពិនិត្យ និង វាយតម្លៃ ពី ស្ថានភាព ផល ប៉ះពាល់ ជំនន់ ទឹកភ្លៀង នៅ ស្រុក ក្រឡាញ់ និង ស្រុក អង្គរ ជុំ
( សៀមរាប ) ៖ ដោយ ស្ថានភាព អាកាសធាតុ ក្នុង រយៈពេល មួយ សប្តាហ៍ មក នេះ ដោយ មាន ភ្លៀង ធ្លាក់ ជា បន្តបន្ទាប់ បាន ធ្វើឲ្យ ស្រុក មួយចំនួន ក្នុង ភូមិសាស្ត្រ ខេត្ត សៀមរាប បាន ទទួលរង នូវ ផល ប៉ះពាល់ ជំនន់ ទឹកភ្លៀង នៅ រសៀល ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២៣ អាជ្ញាធរ ខេត្ត សៀមរាប ដឹកនាំ ដោយ លោក អ៊ឹង គឹម លាង អភិបាល រង ខេត្ត ចុះ ត្រួតពិនិត្យ និង វាយតម្លៃ អំពី ផល ប៉ះពាល់ ដោយ ជំនន់ ទឹកភ្លៀង នៅក្នុង ភូមិសាស្ត្រ ស្រុក ក្រឡាញ់ និង ស្រុក អង្គរ ជុំ ។
តាម ការបញ្ជាក់ របស់ អាជ្ញាធរ ស្រុក ក្រឡាញ់ បាន ឲ្យដឹង ថា ក្នុង រយៈពេល មួយ សប្តាហ៍ មក នេះ ឃុំ មួយចំនួន នៅ ផ្នែក ខាងលើ បាន ទទួលរង ផល ប៉ះពាល់ ដោយ ជំនន់ ទឹកភ្លៀង មាន នៅ ឃុំ ស្នួល និង ឃុំ ក្រូច គរ ធ្វើឲ្យ ដំណាំ ស្រូវ វស្សា រង ផល ប៉ះពាល់ ទឹក ជំនន់ ទឹកភ្លៀង ចំនួន ៣១៣ ហិកតា ។ ក្នុង នោះ ដែរ មាន ស្រូវ កណ្ដាល ២៣៦ ហិកតា ស្រូវ ធ្ងន់ ៧៧ ហិកតា មាន គ្រួសារ រង ផល ប៉ះពាល់ ចំនួន ៣១៥ គ្រួសារ ព្រមទាំង បាន លិច ទីធ្លា សាលារៀន មួយ កន្លែង ផងដែរ ។
លោក បាន បញ្ជាក់ ថា ដើមី្ប កុំ ឲ្យ មាន ការលិច លុង នៅ ទី រួម ស្រុក អង្គរ ជុំ បន្ត ទៀត ទៅ ជា ប្រពៃណី នោះ អាជ្ញាធរ ស្រុក បាន សហការ ជាមួយ មន្ត្រី ជំនាញ និង អាជ្ញាធរ មូលដ្ឋាន បាន ធ្វើ ការបើ មុខ ទឹក និង ស្តារ សម្រាម ដែល កកស្ទះ នៅ តាម ប្រព័ន្ធ លូ មួយចំនួន ក្នុង ការសម្រួល ចរន្ត ទឹក ហូរ ឲ្យបាន ទាន់ ពេល ក្នុង ការបញ្ជៀស ការលិច ទី រួម ស្រុក បន្ត ទៅ ទៀត ផងដែរ ។
លោក អ៊ឹង គឹម លាង បាន បញ្ជាក់ ក្នុង ការចុះ ពិនិត្យ និង វាយតម្លៃ ពី ស្ថានភាព ទឹក ជំនន់ នោះ ជូន ដល់ អាជ្ញាធរ ទាំង ពីរ ស្រុក ត្រូវ បង្កើន ការយកចិត្ត តាមដាន បន្ត ទៀត ចំពោះ បញ្ហា ជំនន់ ទឹកភ្លៀង នេះ ពីព្រោះថា រដូវ វស្សា ទើប ចូល មកដល់ ហើយ ភូមិសាស្ត្រ ស្រុក មួយចំនួន ទទួលរងគ្រោះ ទឹក ជំនន់ តែ បើ យើង យោង តាម ការព្យាករណ៍ របស់ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ តាម បណ្តា ខេត្ត នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង រង នូវ សម្ពាធ ឥដ្ឋិពល នៃ ព្យុះ ពី បណ្តា ប្រទេស ចិន ។
លោក អ៊ឹង គឹម លាង បាន បន្ត ថា ដើមី្ប ឆ្លើយតប ឲ្យបាន ទាន់ ពេលវេលា តាម ប្រសាសន៍ ណែនាំ ផ្តាំផ្ញើ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ធ្វើ យ៉ាងណា ឲ្យ អាជ្ញាធរ ខេត្ត ស្រុក ធ្វើ ការសិក្សា វាយតម្លៃ បានជា មូលដ្ឋាន អំពី ការរង ផល ប៉ះពាល់ ជាក់លាក់ ទាំង ការងារ បង្កបង្កើន ផល និង ហេដ្ឋារចនាសម្ព័ន្ធ នានា នៅក្នុង មូលដ្ឋាន រួម នឹង តម្រូវការសំណូមពរ ជាក់ស្ដែង របស់ ប្រជាពលរដ្ឋ ដើម្បី ជួយ អន្តរាគមន៍ ធ្វើ ការស្ដារ ឡើងវិញ ឲ្យ បាន ឆាប់ រហ័ស ទាន់ ពេល វេលា ។
លោក បញ្ជាក់ ថា អាជ្ញាធរ មូលដ្ឋាន ត្រូវ មាន ភាពម្ចាស់ការ ក្នុង ពេល មាន គ្រោះមហន្តរាយ ធម្មជាតិ កើតមាន ក្នុង ភូមិសាស្ត្រ ខ្លួន និង ត្រូវ ធ្វើ យ៉ាងណាង កុំ ឲ្យ មាន ផល ប៉ះពាល់ ដាល់ ប្រជាពលរដ្ឋ ព្រមទាំង ត្រូវ ប្រើ ឲ្យ អស់ គ្រប់ វិធានការ ក្នុង ការដោះស្រាយ ជូន ដល់ ប្រជាពលរដ្ខ រស់ នៅ ប្រកបដោយ សេចក្តីសុខ ៕
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៧៥ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០៣ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៧៥ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ ។
