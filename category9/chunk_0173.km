( ភ្នំពេញ ) ៖ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី ជា ប្រធាន រដ្ឋសភា នៅ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន ផ្ញើ សារ ថ្លែងអំណរគុណ ដល់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល បាន ផ្ញើ លិខិត អបអរសាទរ ជូន លោកជំទាវ ក្នុង ឱកាស ដែល រដ្ឋ សភា បាន អនុម័ត គាំទ្រ ឱ្យ ទទួល តំណែង ជា ប្រធាន រដ្ឋសភា សម្រាប់ នីតិកាល ទី៧
ជាថ្មី ម្តង ទៀត សូម សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត និង សម្តេច អគ្គ មហា សេនា បតី តេជោ សូម បាន ប្រកបដោយ ពុទ្ធ ពរ និង ពរ ទាំង ប្រាំ ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ បដិភាណៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។ សូម សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត មេត្តា ទទួល នូវ ការគោរព ដ៏ ខ្ពង់ខ្ពស់ អំពី នាងខ្ញុំ »៕ សុន្ទរកថា ទាំងស្រុង របស់ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង កិច្ចប្រជុំ រដ្ឋសភា នីតិកាល ទី៧
( ភ្នំពេញ ) ៖ សុន្ទរកថា ទាំងស្រុង របស់ ឯកឧត្តម កិត្តិ ទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង កិច្ចប្រជុំ រដ្ឋសភា នីតិកាល ទី៧ នៃ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២៣ . ខាងក្រោម ជា សុន្ទរកថា ទាំង ស្រុង៖ កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ស្វាយរៀង ឃាត់ ជនជាតិ វៀតណាម ៨នាក់ និង វត្ថុតាង គ្រឿងញៀន មួយចំនួន
( ស្វាយរៀង ) ៖ សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន កងរាជអាវុធហត្ថ ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២៣ បាន បញ្ជូន ជនជាតិ វៀតណាម ៨នាក់ ទៅ តុលាការ ដើម្បី ផ្ដន្ទាទោស តាម ច្បាប់ ពាក់ព័ន្ធ ករណី រក្សាទុក ឬ ជួញដូរ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង ត្រូវបាន កម្លាំង ជំនាញ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត ស្វាយរៀង ក សាង សំណុំរឿង បញ្ជូន ទៅ អយ្យការ អម សាលាដំបូង ខេត្ត ស្វាយរៀង ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕ អភិបាល ខេត្ត កែប ណែនាំឲ្យ សិស្សនុសិស្ស និង អ្នក ពាក់ព័ន្ធ ការជួញដូរ ការប្រើប្រាស់ គ្រឿងញៀន ត្រូវ បញ្ឈប់ ជាបន្ទាន់ ចៀសវាង ការអនុវត្ត តាម ច្បាប់
( កែប )៖ លោក បណ្ឌិត សោម ពិសិដ្ឋ អភិបាល ខេត្ត កែប បាន ណែនាំ ដល់ ប្អូន ៗ សិស្សនុសិស្ស និង អ្នក ដែល មាន ការពាក់ព័ន្ធ ជាមួយ ការជួញដូរ ការប្រើប្រាស់ គ្រឿងញៀន ត្រូវ បញ្ឈប់ ជាបន្ទាន់ បើ មិន ដូច្នោះ ទេ ត្រូវ អនុវត្ត តាម នីតិវិធី ច្បាប់ ជាក់ ជា ពុំ ខាន់ ឡើយ ។
មានប្រសាសន៍ ថ្លែង ដូច្នេះ ក្នុង ទិវា អន្តរជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ២៦ មិថុនា ២០២៣ ក្រោម ប្រធានបទ « អ្វី ៗ ដើម្បី ប្រជាជន ជា ចម្បង បញ្ឈប់ ការរើសអើស និង ការមាក់ងាយ អ្នក ញៀន គ្រឿងញៀន ពង្រឹង ការអប់រំ បង្ការ » ។ ពិធី នេះ បាន ប្រារព្ធ ធ្វើឡើង នា រសៀល ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២៣ នៅ សាល ប្រជុំ សាលា ខេត្ត កែប ដោយ ចូលរួម ពី អ្នក ពាក់ព័ន្ធ ប្រមាណ ជាង ៤០០ នាក់ ។
ទន្ទឹម នេះ លោក អភិបាល ខេត្ត សោម ពិសិដ្ឋ ក៏ បាន ណែនាំ គ្រប់ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទាំងអស់ នៅ ទូទាំង ខេត្ត កែប ត្រូវ យកចិត្តទុកដាក់ គ្រប់គ្រង និង ក្ដាប់ ឲ្យបាន ច្បាស់លាស់ នូវ មុខ សញ្ញា លក់ និង ចែកចាយ គ្រឿងញៀន ជាពិសេស អ្នក ដែល ពាក់ព័ន្ធ និង អ្នក ចំណូល ស្រុក មក ស្នាក់ នៅ បណ្ដោះអាសន្ន ឬ ប្រកប មុខរបរ ផ្សេង ៗ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន និង ត្រូវ បង្ក្រាប ឲ្យបាន ទាន់ ពេល វេលា ។
លោក អភិបាល ខេត្ត ក៏ បាន ស្នើ ដល់ អង្គភាព សមត្ថកិច្ច ជំនាញ ពាក់ព័ន្ធ ត្រូវ គ្រប់គ្រង និង ក្តាប់ នូវ មុខ សញ្ញា ចែកចាយ គ្រឿងញៀន នៅក្នុង ខេត្ត សំដៅ កាត់ផ្តាច់ការជួញដូរ និង បន្ត ជំរុញ ពង្រឹង សមត្ថភាព គុណភាព និង ប្រសិទ្ធភាព នៃ យន្តការបន្សាប គ្រឿងញៀន នៅ តាម មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ ដែល មាន ស្រាប់ នៅក្នុង ខេត្ត ឲ្យ មាន ដំណើរការ ល្អ និង កាន់តែ មាន ប្រសិទ្ធភាព ធ្វើ យ៉ាងណា ឲ្យ ជន ងាយ រងគ្រោះ ដោយសារ សារធាតុ ញៀន ទទួលបាន សេវា បន្សាប គ្រឿងញៀន និង ស្ដារ នីតិសម្បទា ឡើងវិញ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា ការប្រារព្ធ ទិវា អន្ត ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន នេះ ក្នុង គោលបំណង ដើម្បី បន្ត ពង្រឹង និង លើកកម្ពស់ ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ ស្រប ទៅនឹង បរិបទ របស់ ពិភពលោក ៕
នៅក្នុង ឱកាស នេះ លោក ជា សែ បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ប្រជាជន ចិន ស្ថានទូត ចិន ប្រចាំ នៅ កម្ពុជា ក្រសួង ពាណិជ្ជកម្ម ចិន និង វិទ្យាស្ថាន ស្រាវជ្រាវ ភាសា ចិន អន្តរជាតិ ប៉េកាំង ដែល បាន គាំទ្រ លើ គម្រោង ផ្សេង ៗ និង គាំទ្រ ដល់ ក្រសួង ទេសចរណ៍ នៅក្នុង ការជំរុញ អភិវឌ្ឍ សមត្ថភាព មន្ត្រី ជំនាញ អ្នកជំនាញ ទេសចរណ៍ និយាយ ភាសា ចិន សម្រាប់ ឆ្នាំ ២០២៣ នេះ ។
លោក រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ បាន ថ្លែង ទៀត ថា ចំណង មិត្តភាព រវាង កម្ពុជា និង ចិន ជាង ៦០ ឆ្នាំ កន្លងមក នេះ ដែល ត្រូវបាន បង្កើត រួមគ្នា និង ថែរក្សា យ៉ាង យកចិត្តទុកដាក់ ពី ថ្នាក់ដឹកនាំ នៃ ប្រទេស ទាំង ពីរ ដែល បាន ស្តែង ចេញ យ៉ាង ច្បាស់ ថា ពេលវេលា កាន់តែ យូរ គឺ កាន់តែ មាន តម្លៃ និង មាន ទំនាក់ទំនង កាន់តែ ជិតស្និទ្ធិ ជារៀងរហូត ។
កន្លងមក នេះ ការផ្លាស់ ប្តួរ បទពិសោធន៍ និង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ វប្បធម៍ និង វិស័យ ទេសចរណ៍ គឺជា ផ្នែក មួយ សំខាន់ ភាពជាដៃគូរ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ កម្ពុជា - ចិន ដែល បាន បង្កើន ការផ្លាស់ប្តូរ វប្បធម៌ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ និង បាន ដើរ តួនាទី យ៉ាង ពិសេស ក្នុង ការពង្រឹង មិត្តភាព ជា « មិត្ត ដែក ថែប » ឱ្យ កាន់តែ រឹងមាំ ថែម ទៀត ។
លោក ថា ដើម្បី ជំរុញ ការបណ្តុះបណ្តាល ជំនាញ ទេសចរណ៍ និង ការអភិវឌ្ឍ ធនធាន មនុស្ស ក្នុង វិស័យ ទេសចរណ៍ ឱ្យ ឆ្លើយតប ទៅនឹង តម្រូវការ ទីផ្សារ ទេសចរណ៍ ទាំង បរិមាណ និង គុណភាព ក្នុង គន្លង ថ្មី នេះ ក្រសួង ទេសចរណ៍ បាន មើលឃើញ ច្បាស់ ពី សារៈសំខាន់ នៅក្នុង ការប្រើប្រាស់ ប្រព័ន្ធ បច្ចេកវិទ្យា និង ព័ត៍មាន ជួយ ដល់ ការរៀបចំ បណ្តុះបណ្តាល និង វាយតម្លៃ សមត្ថភាព អ្នកជំនាញ ទេសចរណ៍ តាម រយះ ប្រព័ន្ធ អនឡាញ ដោយ បាន បង្កើត ប្រព័ន្ធ គ្រប់គ្រង ការ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសរចណ៍ អនឡាញ ។
