( ស្វាយរៀង ) ៖ លោក ហោ សារុន រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង ជា អនុប្រធាន គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី សម្រួល ការធ្វើដំណើរ និង ដឹកជញ្ជូន ភ្ញៀវ ទេសចរ និង អ្នកដំណើរ នៅ តំបន់ ច្រកទ្វារ ព្រំដែន អន្តរជាតិ និង ច្រកទ្វារ អន្តរជាតិ ទូទាំង ប្រទេស បាន បញ្ជាក់ ថា កម្ពុជា មាន សុទិដ្ឋិនិយម ថា នឹង ទទួលបាន ភ្ញៀវ ទេសចរ អន្តរជាតិ ក្នុង កម្រិត ដូច សម័យ មុន វិបត្តិ ជំងឺ កូវីដ១៩ ពោល គឺ ប្រមាណ ៧លាន នាក់ នៅក្នុង ឆ្នាំ ២០២៥ ឬ ដើម ឆ្នាំ ២០២៦ ។
ការបង្ហាញ សុទិដ្ឋិនិយម បែប នេះ របស់ លោក ហោ សារុន បាន ធ្វើឡើង ក្នុង ឱកាស លោក អញ្ជើញ ជា អធិបតីភាព បើក សិក្ខាសាលា ស្តីពី « បដិសណ្ឋារកិច្ច ល្អ ទេសចរណ៍ មាន សុវត្ថិភាព » នៅ ច្រកទ្វារ ព្រំដែន អន្តរជាតិ បាវិត ខេត្ត ស្វាយរៀង នា ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ ដោយ មាន ការចូលរួម ពី លោក សេង សិលា អភិបាល រង ខេត្ត ស្វាយរៀង តំណាង លោក ម៉ែន វិបុល អភិបាល ខេត្ត ។
ពិធី នេះ មាន កិច្ចសហការ ខ្ពស់ ជាមួយ អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ ក្រសួង មហាផ្ទៃ និង រដ្ឋបាល ខេត្ត ស្វាយរៀង និង មាន ការចូលរួម ពី បណ្តា សមត្ថកិច្ច គ្រប់ អង្គភាព ពាក់ព័ន្ធ ដែល កំពុង បម្រើ ការងារ នៅ ច្រកទ្វារ ព្រំដែន អន្តរជាតិ បាវិត ខេត្ត ស្វាយរៀង សរុប ចំនួន ១៧០ នាក់ ។
( វ៉ាស៊ីនតោន ) ៖ កងទ័ព ជើងទឹក និង កង ម៉ារីន ជាង ៣.០០០ នាក់ របស់ សហរដ្ឋ អាមេរិក បាន ធ្វើដំណើរ ទៅដល់ តំបន់ សមុទ្រ ក្រហម ហើយ កាលពី ទី៦ ខែសីហា កន្លងទៅ នេះ នៅ ចំពេល រដ្ឋបាល លោក ប្រធានាធិបតី ចូ បៃ ដិន កំពុង ថ្លឹងថ្លែង ពី ជម្រើស ដើម្បី កំញើញ ទប់ស្កាត់ អ៉ីរ៉ង់ ពី ការរឹបអូស កប៉ាល់ ដឹក ប្រេង នៅក្នុង តំបន់ ឈូង សមុទ្រ ពែ ក្ស ។
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី១៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖ ១៖ លោក គីម ជុង អ៊ុន ធ្វើ ទស្សនកិច្ច ទៅកាន់ រោងចក្រ ផលិត មីស៊ីល ចំពេល មាន ការចោទប្រកាន់ ពី ការផ្គត់ផ្គង់ អាវុធ ឱ្យ រុស្ស៉ី
២៖ បេសកកម្ម រក្សា សន្តិភាព UN ប្រចាំ ប្រទេស ម៉ាលី ចាកចេញ ពី មូលដ្ឋាន មុន កាល កំណត់ ដោយសារ អសន្តិសុខ
៣៖ តៃវ៉ាន់ នឹង មិន ចុះ ញ៉ម ចំពោះ ការគំរាមកំហែង ឡើយ . នេះ ជា សម្ដី របស់ មេដឹកនាំ រង កោះ តៃវ៉ាន់ ក្នុង ដំណើរទស្សនកិច្ច នៅ អាមេរិក
៤៖ រុស្ស៉ី នឹង បំពាក់ មីស៊ីល ល្បឿន លឿន ជាង សំឡេង លើ នាវា មុជទឹក នុយក្លេអ៊ែរ ស៊េរី ថ្មី
* ទី១៖ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ឯក អឿ សុភា នាយ ការិយាល័យ ចរាចរណ៍ ផ្លូវគោក សហការ ជាមួយ កម្លាំង ស្រុក បាធាយ និង ស្រុក កង មាស បាន ចុះ ធ្វើ ការអប់រំ ណែនាំ តែ មិន មាន ការ ផាកពិន័យ និង ចែកជូន ឯកសារ ពាក់ព័ន្ធ ស្ដីពី សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ចំពោះ អ្នកប្រើប្រាស់ ផ្លូវ ដែល ល្មើស នឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក មាន ចំនួន ៨១ នាក់ មធ្យោបាយ ចំនួន ៥៤ គ្រឿង ក្នុង នោះ៖
មិន ពាក់ មួក សុវត្ថិភាព ចំនួន ៤៥ នាក់ មិន ទាន់ គ្រប់ អាយុ បេីក បរ ចំនួន ២នាក់ ម៉ូតូ សណ្ដោង រឺ ម៉ក គ្មាន ភ្លើង បំភ្លឺ ចំនួន ១៣ គ្រឿង មិន ពាក់ ខ្សែក្រវ៉ាត់ ចំនួន ៩នាក់ រថយន្ត គ្មាន ផ្លាល លេខ ចំនួន ២គ្រឿង ផ្ទុក លើស ចំណុះ ០២ គ្រឿង ប្រើប្រាស់ ទូរស័ព្ទ ចំនួន ៦នាក់ រថយន្ត បែន ដឹក ដី មិន គ្រប ត្រឹមត្រូវ ចំនួន ៤គ្រឿង ។
* ទី២៖ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ទោ ខាន់ វាសនា នាយ រង ការិយាល័យ សហការ ជាមួយ កម្លាំង សាធារណការ និង កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក កំពង់សៀម បាន ចុះ ផ្សព្វផ្សាយ ច្បាប់ ចរាចរណ៍ ផ្លូវគោក នៅ សាលា បឋមសិក្សា និង អនុវិទ្យាល័យ អង្គរ ដែល មាន លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ចូលរួម សរុប ចំនួន ១. ៩០៧ នាក់ ស្រី ៩៣៤ នាក់ និង បាន ចែកជូន នូវ ឯកសារ ពាក់ព័ន្ធ ស្ដីពី សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក មួយចំនួន ទៀត ផងដែរ ។
បន្ដ ចុះ អប់រំ ណែនាំ ចំពោះ អ្នក ល្មើស ច្បាប់ បាន ចំនួន ២៨ នាក់ មធ្យោបាយ ចំនួន ៤២ គ្រឿង ក្នុង នោះ៖ មិន ពាក់ មួក សុវត្ថិភាព ចំនួន ៧នាក់ មិន ពាក់ ខ្សែក្រវ៉ាត់ ចំនួន ៧នាក់ គ្មាន ផ្លាល លេខ ចំនួន ៣គ្រឿង ផ្ទុក លើស ចំណុះ ៣គ្រឿង ប្រើប្រាស់ ទូរស័ព្ទ ចំនួន ៨នាក់ ៕ ក្រសួង បរិស្ថាន ប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ កម្មវិធី ទូរស័ព្ទ « ដើរលេង ស្រុក យើង »
នា ឱកាស នោះ ដែរ លោក សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន បាន លើកឡើង ថា ការដាក់ ឱ្យ ដំណើរការ កម្មវិធី ទូរសព្ទ « ដើរលេង ស្រុក យើង » ជា ការបញ្ជក់ មួយ ទៀត ពី រ បត់ ថ្មី របស់ សង្គម កម្ពុជា ងាក រក ទំនើបកម្ម បច្ចេកវិទ្យា ស៊ីវីល័យ ស្រលាញ់ គ្រួសារ សង្គម ផ្សារភ្ជាប់ នឹង បរិស្ថាន ។
លោក សាយ សំអាល់ បាន សម្តែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ក្រុមការងារ និង ថ្លែងអំណរគុណ ដល់ អង្គការ ដៃគូ ដែល បាន ចូលរួម យ៉ាង សកម្ម បង្កើត បានជា កម្មវិធី ទូរសព្ទ « ដើរលេង ស្រុក យើង » មិន ត្រឹមតែ ជា សមិទ្ធផល មួយ ទេ ប៉ុន្តែ បង្ហាញ ឱ្យ ឃើញ ថា ជីវភាព របស់ ប្រជាជន កម្ពុជា បាន ងាក ទៅ រក ភាព សុខដុមរមនា និង សុភមង្គល មាន ឱកាស ពេញលេញ ធ្វើដំណើរកម្សាន្ត ជាមួយ ក្រុមគ្រួសារ មិត្តភក្តិ គ្រប់ ទីកន្លែង ។
លោក បាន សង្កត់ធ្ងន់ ថា កម្ពុជា ផ្លាស់ប្តូរ ពី សង្គមជាតិ មួយ ដែល ធ្លាប់ បែកបាក់ ផេះ ផង់ ដោយសារ សង្គ្រាម មក ជា សង្គមជាតិ មួយ ដែល ជីវភាពល្អ ប្រសើរ សង្គមរស់រវើក ប្រជាជន មាន ចំណេះដឹង ទូលំទូលាយ ចេះ ចែករំលែក្តី សុខ និង សុភមង្គល តាមរយៈ លម្ហែ ជាមួយនឹង ធម្មជាតិ ។ ទាំងនេះ ជា ផ្លែ ផ្កា នៃ សុខ សន្តិភាព ដែល យើង កំពុង ទទួលបាន ហើយ វប្បធម៌ នៃ សន្តិភាព ក៏ បាន ចាក់ ឬ ស យ៉ាង មាំ ក្នុង ក្រអៅបេះដូង ប្រជាជន កម្ពុជា គ្រប់ រូប ផងដែរ ។
នេះ គឺជា ការឆ្លើយតប មួយ ទៅនឹង គោល នយោបាយ អភិវឌ្ឍន៍ អេកូ ទេសចរណ៍ ក្រោម ពាក្យស្លោក « ទេសចរណ៍ ផ្សារភ្ជាប់ ទឹកដី » ដែល នឹង ជំរុញ ឱ្យ ជីវភាព របស់ ប្រជាពលរដ្ឋត នៅ តាម តំបន់ ការពារ ធម្មជាតិ មាន ភាពប្រសើរឡើង ជាលំដាប់ តាមរយៈ ចំណូល ពី ភ្ញៀវ ទេសចរ ដែល មក ទស្សនា កម្សាន្ត រួមចំណែក ពង្រឹង ជីវភាព សហគមន៍ ដូចជា ឱកាស សម្រាប់ អភិវឌ្ឍន៍ ទេសចរណ៍ ធម្មជាតិ ហើយ រួមចំណែក កាត់បន្ថយ សកម្មភាព ទាំងឡាយ ណា ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ ធនធាន ធម្មជាតិ ៕
អភិបាល ខេត្ត កំពង់ស្ពឺ៖ រោងចក្រ សហគ្រាស ចំនួន ២៥ ទីតាំង ទៀត នឹង លេច រូបរាង ឡើង ខេត្ត កំពង់ស្ពឺ ជាមួយ កម្លាំង ពលកម្ម ប្រមាណ ២៣.០០០ នាក់
( ក្វាវ ចូវ) ៖ នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ដឹកនាំ គណៈប្រតិភូ ចូល ជួប ពិភាក្សា ការងារ និង ពិនិត្យ ច្រវាក់ ផលិតកម្ម តាម បណ្តា រោងចក្រ សហគ្រាស ជាច្រើន នៅ ខេត្ត ក្វាង ចូវ សាធារណៈ រដ្ឋ ប្រជាមានិត ចិន ។
ជា លទ្ធផល គណៈប្រតិភូ បាន អញ្ជើញ ជួប ពិភាក្សា ការងារ និង ទស្សនៈកិច្ច ផ្ទាល់ ជាមួយ សហគ្រាស រោងចក្រ ចំនួន ៣ រោងចក្រ ក្នុង នោះ មាន៖
* ទី៣៖ សួន ឧស្សាហកម្ម ហ្វីចូវ ( មាន ៤៤ រោងចក្រ សហគ្រាស ) ជា រោងចក្រ ផលិត សម្លៀកបំពាក់ និង តម្បាញ . ផលិត ស្បែកជើង . គ្រឿង បង្គុំ អេឡិកត្រូនិក . ស្រោម ទូរស័ព្ទ និង ស្គ្រីន ទូរស័ព្ទ . ជ្រលក់ ព័ណ៌ ក្រណាត់ ។ សួន ឧស្សាហកម្ម នេះ មាន រោងចក្រ សហគ្រាស ១៧ នឹង ត្រូវ ទៅ បង្កើត នៅ ខេត្ត កំពង់ស្ពឺ ដែល មាន តម្រូវការកម្លាំង ពលកម្ម ជំហាន ដំបូង ប្រមាណ ១៤.០០០ នាក់ ។
លោក វ៉ី សំណាង បាន បញ្ជាក់ ពី ក្វាង ចូវ បន្ថែម ថា សរុប ជា រួម រោងចក្រ សហគ្រាស ដែល នឹង ត្រូវ ទៅ បង្កើត នៅ ខេត្ត កំពង់ស្ពឺ មាន ចំនួន ២៥ ទីតាំង ហើយ ជា ជំហាន ដំបូង នេះ រោងចក្រ សហគ្រាស មាន តម្រូវការកម្លាំង ពលកម្ម ប្រមាណ ២៣.០០០ នាក់ ដែល ជា ត្រូវការ នៅក្នុង ខេត្ត កំពង់ស្ពឺ នា ចុង ឆ្នាំ ២០២៣ នេះ លើ តម្រូវការ សរុប ប្រមាណ ជាង ៥០.០០០ នាក់ ជាក់ស្តែង ៕
យើង អាច និយាយ បាន ថា ចិន បាន បោះ ចំហ៊ាន មុន គេ គ្រប់ យ៉ាង ទាំង ការជូនពរ ក្រោយ ការបោះឆ្នោត ហើយ បច្ចុប្បន្ន គឺ ការមក បំពេញ ទស្ស កិច្ច ផ្លូវការ របស់ ប្រមុខ ការទូត ចិន ។
តើ ហេតុ អ្វី នៅ បានជា ចិន ជ្រើស ប្រទេស កម្ពុជា និង ប្រទេស អាស៊ាន ២ទៀត នៅក្នុង ដំណើរទស្ស កិច្ច ក្នុង តំបន់ អាស៊ាន លើក នេះ ? ហើយ មាន លក្ខណះ ពិសេស ឬ គ្រាន់តែ ជា ភាព ចៃដន្យ ដែរ ចិន បាន បោះជំហ៊ាន មុន គេ ទាំង ការជូនពរ និង ការមក បំពេញ ទស្សនកិច្ច ?
ការបញ្ជាក់ នេះ ធ្វើឡើង ក្នុង កិច្ចប្រជុំ បូកសរុការងារ របស់ គណៈកម្មាធិការ ជាតិ អ្នកជំនាញ ទេសចរណ៍ នៅ ទីស្តីការ ក្រសួង ទេសចរណ៍ នា ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ ដែល មាន ការចូលរួម ពី លោក លោកស្រី ជា សមាជិក សមាជិកា និង តំណាង ស្ថាប័ន បណ្តុះបណ្តាល ប្រមាណ ៥០ រូប ។
លោក រដ្ឋមន្ត្រី ថោង ខុន បាន រំលេច ពី សមិទ្ធផល នានា ដែល គណៈកម្មាធិការ ជាតិ សម្រេចបាន ក្នុង ការបណ្ដុះបណ្ដាល ជំនាញ ទេសចរណ៍ លើ យុវជន ស្រប តាម យន្តការជាតិ និង អាស៊ាន រួម មាន ការរៀបចំ កម្មវិធី សិក្សា ការបណ្ដុះបណ្ដាល គ្រូ បទដ្ឋាន គតិយុត្តិ ផ្សេង ៗ ការអនុវត្ត កម្មវិធី វាយតម្លៃ អ្នកជំនាញ មាន បទពិសោធន៍ តែ ពុំ មាន វិញ្ញាបនត្របញ្ចូល កម្មវិធី សិក្សា ទេសចរណ៍ តាម វិទ្យាល័យ ចំណេះ ទូទៅ និង បច្ចេកទេស មួយចំនួន ព្រមទាំង កម្មវិធី សិក្សា ផ្សេង ៗ ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា តាម ការវាយតម្លៃ របស់ វិទ្យាស្ថាន ERIA កម្ពុជា នៅតែ ជា ប្រទេស ដែល នាំមុខ គេ ក្នុង ការបណ្ដុះបណ្ដាល ជំនាញ ទេសចរណ៍ ក្នុង ក្របខណ្ឌ អាស៊ាន តាម ស្តង់ដា កម្មវិធី រួម ។
នា ឱកាស នោះ លោក ទ្រី ឈីវ ប្រធាន លេខាធិការដ្ឋាន គ.ជ. អ. ទ និង ជា ប្រធាន នាយកដ្ឋាន សហប្រតិបត្តិការ អន្តរជាតិ និង អាស៊ាន បាន ធ្វើ បទបង្ហាញ អំពី បច្ចុប្បន្នភាព និង សមិទ្ធផល នៃ ការអភិវឌ្ឍ ជំនាញ ស្រប តាម ស្តង់ដា អាស៊ាន (MRA) ។
គួរ កត់សម្គាល់ ថា ឆ្នាំ ២០២២ កន្លងទៅ កម្ពុជា បាន ដឹកនាំ សម្រេច ការងារ អាស៊ាន មាន ដូច ជា៖ * ការរៀបចំ គោលការណ៍ ណែនាំ អាស៊ាន ស្តីពី ការវាយតម្លៃ លើ ការសិក្សា ពី មុន (RPL)* ការរៀបចំ គោលការណ៍ ណែនាំ អាស៊ាន ស្តីពី អនាម័យ និង សុវត្ថិភាព ដល់ អ្នកជំនាញ ទេសចរណ៍ និង សហគមន៍ សម្រាប់ ឧស្សាហកម្ម ទេសចរណ៍ * ការដឹកនាំ រៀបចំ កម្មវិធី សិក្សា ជំនាញ ស្ប៉ា និង សុខុមាលភាព អាស៊ាន ជាដើម ។
ខាងក្រោយ នេះ ជា លិខិត អញ្ជេីញ របស់ អគ្គ នាយក ដា្ឋ ន គយ និង រដ្ឋាករ កម្ពុជា៖
ទឹក ជំនន់ និង ការរអិល បាក់ ដី កើតឡើង ជា រើយ ៗ ដោយ បណ្តាលឱ្យ មាន ការបំផ្លិចបំផ្លាញ យ៉ាង ធ្ងន់ធ្ងរ ក្នុង អំឡុង រដូវ ខ្យល់ មូសុង របស់ ប្រទេស ឥណ្ឌា ប៉ុន្តែ អ្នកជំនាញ និយាយ ថា ការប្រែប្រួល អាកាសធាតុ កំពុង បង្កើន ភាព ញឹកញាប់ និង ភាពធ្ងន់ធ្ងរ របស់ វា កាន់តែ ខ្លាំង ។
គួរ បញ្ជាក់ ថា ខ្យល់ មូសុង បាន នាំមក នូវ ទឹកភ្លៀង ប្រចាំ ឆ្នាំ ប្រហែល ៨០ ភាគរយ ហើយ មាន សារៈសំខាន់ សម្រាប់ វិស័យ កសិកម្ម និង ជីវភាព រស់ នៅ របស់ មនុស្ស រាប់ លាន នាក់ ។ ប៉ុន្តែ វា ក៏ នាំមក នូវ ការបំផ្លិចបំផ្លាញ ជារៀងរាល់ ឆ្នាំ ក្នុង ទម្រង់ នៃ ការបាក់ ដី និង ទឹក ជំនន់ ផងដែរ ៕
អ្នកតាមដាន ផ្នែក សង្គម និង ទំនាក់ទំនង កម្ពុជា - ចិន ស្វាគមន៍ ចំពោះ ការវិនិយោគ របស់ ចិន នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ អ្នកតាមដាន ផ្នែក សង្គម និង ទំនាក់ទំនង កម្ពុជា - ចិន បាន ស្វាគមន៍ ចំពោះ គម្រោង វិនិយោគ របស់ ចិន នៅ កម្ពុជា ដើម្បី កំណើន សេដ្ឋកិច្ច ជាតិ និង បង្កើត ការងារ ជូន ប្រជាពលដ្ឋ កាន់តែ ច្រើន ។
លោក គង់ សិរី រ័ត្ន អ្នកតាម អាន ផ្នែក សង្គម និង ទំនាក់ទំនង កម្ពុជា - ចិន បាន មានប្រសាសន៍ ថា ប្រទេស ចិន គឺជា ដៃគូ វិនិយោគ របស់ កម្ពុជា យ៉ាង សំខាន់ លើ គ្រប់ វិស័យ ជាពិសេស វិស័យ កសិ- ឧស្សាហកម្ម ។ ការវិនិយោគ របស់ ចិន នេះ បាន ជំរុញ ឱ្យ សេដ្ឋកិច្ច កម្ពុជា កាន់តែ រីកចម្រើន និង បង្កើត ការងារ ជូន ប្រជាពលរដ្ឋ រាប សែន នាក់ នៅ តាម មូលដ្ឋាន ហើយ អាច កាត់បន្ថយ ការចំណាកស្រុក ជាដើម ។
ក្នុង សន្និសីទ សារព័ត៌មាន ស្តីពី គម្រោង វិនិយោគ លើ វិស័យ កសិ- ឧស្សាហកម្ម នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ លោក សៅ ស៊ូជី ប្រធាន ក្រុមហ៊ុន ដាណុង ឌីវេឡុប មែន គ្រុប បាន លើកឡើង ថា គោលបំណង នៃ ការវិនិយោគ នេះ មាន ការដាំដុះ និង បង្កាត់ ពូជ ដំណាំ និង សត្វ ចំនួន ៤ប្រភេទ ទី១. ដាំ ស្មៅ សម្រាប់ ចំណី សត្វ . ទី២. បង្កាត់ និង ដាំ ពូជ ពោត . ទី៣. ដាំ និង កែច្នៃ ដំឡូមី និង ទី៤. បង្កាត់ និង ចិញ្ចឹម សត្វ គោ និង ជ្រូក ហើយ ផលិតផល កសិកម្ម ទាំង នេះ ភាគ ច្រើន គឺ សម្រាប់ នាំចេញ ទៅ ប្រទេស ចិន ។
សេចក្តីថ្លែងការណ៍ នោះ បាន បញ្ជាក់ ថា « យើង សូម ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ចំពោះ ថ្នាក់ដឹកនាំ និង ប្រជាជន អ៉ីរ៉ង់ ចំពោះ ការវាយប្រហារ ភេរវកម្ម លើ ទី សក្ការ បូជា សាស់ ឆឺរ៉ាក់ (Shah Cheragh) នៅ ទីប្រជុំជន ស៉ីរ៉ាស់ ។ រុស្ស៉ី ថ្កោល ទោស យ៉ាង ខ្លាំង ចំពោះ ករណី នេះ ហើយ សូម សម្តែង នូវ ការអាណិតអាសូរ ចំពោះ ក្រុមគ្រួសារ ជនរងគ្រោះ និង អ្នក រងរបួស » ។
សេចក្តីថ្លែងការណ៍ ដដែល បាន បន្ថែម ថា « យើង សូម បញ្ជាក់ សារជាថ្មី អំពី ការត្រៀមខ្លួន របស់ យើង ដើម្បី ជំរុញ កិច្ចសហប្រតិបត្តិការ បន្ថែម ទៀត ជាមួយ ដៃគូ អ៉ីរ៉ង់ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង អំពើ ភេរវកម្ម » ។
គួរ បញ្ជាក់ ថា ការវាយប្រហារ លើ ទី សក្ការ បូជា សាស់ ឆឺរ៉ាក់ របស់ អ្នក កាន់ សាសនា អ៉ី ស្លាម និកាយ ស៉ី អ៉ីត បណ្តាលឲ្យ មនុស្ស ម្នាក់ ស្លាប់ ហើយ មនុស្ស ម្នាក់ ត្រូវបាន ចាប់ខ្លួន ។ មក ទល់នឹង ពេលនេះ នៅ មិន ទាន់ មាន អ្នក ចេញមុខ ទទួលខុសត្រូវ នោះ ទេ ៕
សម្ដេច ក្រឡាហោម ស ខេង បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ក្នុង ពេល ដែល យើង ធានារ៉ាប់រង បាន ច្រើន ពេល យើង មាន សមត្ថភាព គ្រប់គ្រាន់ យើង ប្រមូលផ្ដុំ បណ្ដុះបណ្ដាល នៅ ផ្ទៃក្នុង ប្រទេស ច្រើន ជាង ជា ការពិត ឥឡូវនេះ ច្រើន ជាង ទៅ ហើយ ព្រោះថា យើង មាន ហេដ្ឋារចនាសម្ព័ន្ធ ក្នុង ការបណ្ដុះបណ្ដាល ទោះបី វា មិន ទាន់ រីកចម្រើន ធំធាត់ ណាស់ ណា ក៏ដោយ ក៏ប៉ុន្តែ អាច ទទួល រ៉ាប់ រង បាន លើ ការងារ បណ្ដុះបណ្ដាល ទាំង ពី មូលដ្ឋាន រហូតដល់ បញ្ចប់ ថ្នាក់ ឧត្ដម » ។
សម្តេច ក្រឡាហោម បាន បន្ថែម ថា នេះ ជា សក្ខីភាព បង្ហាញ អំពី សមិទ្ធផល នៃ ការងារ កំណែទម្រង់ នគរបាល ជាតិ និង ការអនុវត្ត ផែនការអភិវឌ្ឍន៍ ធនធាន មនុស្ស របស់ ក្រសួង មហាផ្ទៃ ស្រប តាម គោល នយោបាយ កំណែទម្រង់ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ របស់ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ បំផុត របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ សេង ផល្លី បាន បញ្ជាក់ ថា ការរៀបចំ ពិធី ដ៏ មហោឡារឹក បែប នេះ មាន គោលបំណង ៣សំខាន់ ៗ៖
* ទី១៖ ដើម្បី ឆ្លុះបញ្ចាំង អំពី គុណភាព នៃ ការអប់រំ បណ្ដុះបណ្ដាល របស់ បណ្ឌិត្យ សភា ក្នុង ការលើកកម្ពស់ សមត្ថភាព ក្រមសីលធម៌ វិជ្ជាជីវៈ ការគោរព វិន័យ និង ការអប់រំ អាកប្បកិរិយា ដល់ កងកម្លាំង នគរបាល ជាតិ ឲ្យបាន ល្អ ប្រសើរ ស្រប តាម ផែនការអភិវឌ្ឍ ធនធាន មនុស្ស របស់ ក្រសួង មហាផ្ទៃ ។
ទី២៖ ដើម្បី លើកទឹកចិត្ត និង ផ្ដល់ កិត្តិយស ដល់ និស្សិត ជ័យលាភី ដែល បាន ខិតខំ សិក្សា រៀនសូត្រ និង ហ្វឹកហាត់ យ៉ាង សកម្ម ស្វិតស្វាញ មុននឹង ទទួលបាន ជោគជ័យ ក្នុង ការសិក្សា ។ ដូច្នេះ សញ្ញាបត្រ១ សន្លឹក ដែល និស្សិត ជ័យលាភី ម្នាក់ ៗ ទទួលបាន នៅ ថ្ងៃ នេះ ពិតជា មាន តម្លៃ ណាស់ ពីព្រោះ នេះ គឺជា លទ្ធផល សិក្សា ដែល កើត ចេញ ពី ការតស៊ូ និង ការខំប្រឹងប្រែង របស់ និស្សិត ម្នាក់ ៗ យ៉ាង ពិតប្រាកដ ។
* ទី៣៖ ដើម្បី បង្ហាញ ថា បណ្ឌិត្យ សភា បាន និង កំពុង ធ្វើ សមារណកម្ម ខ្លួន ចូល ទៅក្នុង ក្របខណ្ឌ អាស៊ាន តំបន់ និង អន្តរជាតិ ដែល ក្នុង នោះ ស្ថាប័ន បណ្ដុះបណ្ដាល កងកម្លាំង នគរបាល នៃ ប្រទេស ជឿនលឿន នានា បាន រៀបចំ ពិធី ប្រគល់ សញ្ញាបត្រ ដល់ និស្សិត ជ័យលាភី តាម ទម្រង់ ដែល កម្ពុជា កំពុង រៀបចំ នា ពេលនេះ ។
សាស្ត្រាចារ្យ ដែល មាន បទពិសោធន៍ ជិត ៤០ ឆ្នាំ លោក ឧត្តមសេនីយ៍ ទោ សាស្ត្រាចារ្យ ជំនួយ បណ្ឌិត ឡេង បុរាណ គ្រូ នគរបាល ជាតិ កម្រិត ឧត្តម ថ្នាក់ លេខ ២ និង ជា អនុប្រធាន ក្រុមប្រឹក្សា នគរបាល ជាតិ បាន ថ្លែង ថា ពិត ណាស់ ពីមុន យើង បញ្ជូន សិស្ស យើង ទៅ រៀន នៅ បរទេស តែ បច្ចុប្បន្ន យើង មាន សមត្ថភាព មិន ចាញ់ អាស៊ាន ទេ ហើយ យើង ប្ដេជ្ញា ខ្ពស់ ណាស់ លើ គុណភាព ពិសេស បណ្ឌិត្យ សភា បាន បន្ថែម លើ កម្រិត ថ្នាក់ បណ្ឌិត ថែម ទៀត ផង ៕
ក្រុម មេដឹកនាំ រដ្ឋប្រហារ បាន ឃុំ ខ្លួន លោក Bazoum និង រំលាយ រដ្ឋាភិបាល ជាប់ ឆ្នោត ស្រប ច្បាប់ ដែល សកម្មភាព នេះ បាន ទទួលរង នូវ ការចេញមុខ រិះគន់ ថ្កោល ទោស ពី ក្រុម មហា អំណាច ពិភពលោក និង ពីសំណាក់ ក្រុម ប្រទេស ជិតខាង នៅ តំបន់ អាហ្រ្វិក ខាងលិច ដែល បាន ដាក់ កងកម្លាំង យោធា ឱ្យ ប្រុង ជើង ការ ក្នុង ករណី ត្រូវ ចូល ធ្វើអន្តរាគមន៍ ដើម្បី ប្រគល់ អំណាច ឱ្យ លោក Bazoum វិញ ។
គួរ បញ្ជាក់ ថា អង្គការ ចម្បង របស់ ក្រុម ប្រទេស អាហ្រ្វិក ខាងលិច គឺ ECOWAS នឹង ព្យាយាម នៅ ថ្ងៃចន្ទ ដើម្បី ជំរុញឱ្យ មាន កិច្ចសន្ទនា បន្ថែម ជាមួយ របប សឹក នីហ្សេ ដែល បាន ឱ្យ សញ្ញា ពី ឆន្ទៈ ក្នុង ការស្វែងរក ដំណោះស្រាយ ការទូត សម្រាប់ ការប្រឈមមុខ គ្នា ជុំវិញ រដ្ឋប្រហារ កាលពី ថ្ងៃទី ២៦ ខែកក្កដា ។ ចំណែក ក្រុមប្រឹក្សា សន្តិភាព និង សន្តិសុខ របស់ សហភាព អាហ្រ្វិក ដែល មាន ៥៥ ប្រទេស វិញ ក៏ នឹង ត្រូវ ជួបប្រជុំ នៅក្នុង ថ្ងៃ ចន្ទ នេះ ផងដែរ ដើម្បី ជជែក អំពី ស្ថានការណ៍ នៅ នីហ្សេ ៕
រដ្ឋបាល ខេត្ត កណ្ដាល បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី ការប្រើប្រាស់ ប្រព័ន្ធ គ្រប់គ្រង អត្តសញ្ញាណប័ណ្ណ មន្ត្រីរាជការ ស៊ីវិល
( កណ្ដាល ) ៖ រដ្ឋបាល ខេត្ត កណ្ដាល នៅ ព្រឹក ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ ក្នុង វគ្គ បណ្តុះបណ្តាល ស្តីពី ការប្រើប្រាស់ ប្រព័ន្ធ គ្រប់គ្រង អត្តសញ្ញាណប័ណ្ណ មន្ត្រីរាជការ ស៊ីវិល ជូន អាជ្ញាធរ ស្រុក - ក្រុង និង មន្ទីរ ជុំវិញ ខេត្ត ។ ពិធី នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក នូវ ប៉េង ច័ន្ទ តារា អភិបាល រង ខេត្ត និង លោក ងន់ ម័រ អគ្គ នាយក រង និង ជា ប្រធាន មជ្ឍ មណ្ឌល បណ្តុះបណ្តាល ICT ។
លោក បាន បន្ថែម ថា នេះ ជា ភាពជោគជ័យ ដ៏ ធំធេង លើ ជ្រុង មួយ នៃ កម្មវិធី កំណែទម្រង់ រដ្ឋបាល សាធារណៈ នៅ កម្ពុជា ដែល មិន ធ្លាប់ មាន ពីមុន មក បាន ធ្វើឲ្យ មន្ត្រីរាជការ មាន ទឹកចិត្ត ស្រឡាញ់ ការងារ និង មាន ភាពស្វាហាប់ ក្នុង ការបំពេញ ការងារ ប្រកាន់ខ្ជាប់ នូវ ឥរិយាបថ ទាំង បួន គឺ ឆន្ទៈ ម្ចាស់ ការ ភក្តីភាព មនសិការ វិជ្ជាជីវៈ និង វប្បធ៌ម សេវា សាធារណៈ សំដៅ ធ្វើឲ្យ រដ្ឋបាល សាធារណៈ កាន់តែ មាន តម្លាភាព ភាព ឆ្លើយតប ប្រកបដោយ ប្រសិទ្ធផល ដើម្បី ធ្វើឲ្យ សម្រេច គោលដៅ បម្រើ ប្រជាពលរដ្ឋ ឲ្យ កាន់តែ ល្អ ប្រសើរឡើង ។
ទីក្រុង កៀវ បាន និយាយ ថា ឧប្បត្តិហេតុ ខាងលើ គឺជា ការបំពាន ច្បាប់ អន្តរជាតិ ដោយ ឥត អៀន ខ្មាស និង ជា ឧទាហរណ៍ ថ្មី មួយ ទៀត បង្ហាញ ពី ការប៉ុនប៉ង បង្ក គ្រោះថ្នាក់ ដោយ ចេតនា ចំពោះ សេរីភាព នៃ ការធ្វើ នាវាចរណ៍ និង សុវត្ថិភាព នៃ កប៉ាល់ ពាណិជ្ជកម្ម នានា នៅ សមុទ្រ ខ្មៅ ហើយ អ៊ុយក្រែន ក៏ បាន អំពាវនាវ ផងដែរ ឱ្យ សហគមន៍ អន្តរជាតិ ចាត់ វិធានការ ម៉ឺងម៉ាត់ ដើម្បី ទប់ស្កាត់ សកម្មភាព ទាំងឡាយ របស់ រុស្ស៉ី ដែល រារាំង ដល់ ការធ្វើដំណើរ ដោយ សុវត្ថិភាព របស់ កប៉ាល់ ស៉ី វិល នានា ៗ ឆ្លងកាត់ តំបន់ សមុទ្រ នេះ ។
កន្លងមក រុស្ស៉ី ធ្លាប់ បាន ព្រមាន ថា ខ្លួន នឹង ចាត់ទុក កប៉ាល់ ទាំងអស់ ដែល ធ្វើដំណើរ ឆ្ពោះ មកកាន់ កំពង់ផែ អ៊ុយក្រែន ជា គោលដៅ យោធា បន្ទាប់ពី ទីក្រុង មូស្គូ បាន ដើរ ចេញ ពី កិច្ចព្រមព្រៀង មួយ កាលពី ខែកក្កដា ដែល អនុញ្ញាតឱ្យ មាន ការដឹកជញ្ជូន ធុញ្ញជាតិ របស់ អ៊ុយក្រែន ឆ្លងកាត់ តំបន់ សមុទ្រ ខ្មៅ ដោយ សុវត្ថិភាព ក្រោយ សង្រ្គាម ផ្ទុះឡើង ៕
គួរ បញ្ជាក់ ថា គ្រោះថ្នាក់ ស្រដៀង គ្នា នេះ តែ ក្នុង កម្រិត ស្រាល ជាធម្មតា កើតឡើង នៅ មីយ៉ាន់ម៉ា ហើយ មិន ទទួលបាន ការចាប់អារម្មណ៍ ច្រើន នោះ ទេ ។ ជាទូទៅ ជនរងគ្រោះ គឺជា អ្នក ជីក រ៉ែ លក្ខណៈ គ្រួសារ ហើយ រស់ នៅ ក្បែរ ពំនូក ដី ដ៏ ធំ ៗ ដែល ក្រុមហ៊ុន ប្រើ គ្រឿងចក្រ ជីក យក រ៉ែ បន្សល់ទុក និង ប្រកបដោយ គ្រោះថ្នាក់ ។
នូវែលសេឡង់ សម្រេច លុបចោល វិធានការរឹតត្បិត កូវីដ១៩ ដែល នៅសល់ ចុងក្រោយ (Video inside) ( វែលីង តោន ) ៖ រដ្ឋាភិបាល នូវែលសេឡង់ នឹង ដក ចេញ វិញ នូវ វិធានការរឹតត្បិត កូវីដ១៩ ដែល នៅ សេសសល់ ទាំង ប៉ុន្មាន ចាប់ពី វេលា យប់ រំលង អធ្រាត្រ ឈានចូល ថ្ងៃអង្គារ សប្តាហ៍ នេះ បន្ទាប់ពី ពួក វា ត្រូវបាន បន្ត រក្សាទុក អស់ រយៈពេល ជាង ៣ឆ្នាំ មកហើយ គិត ចាប់តាំងពី ផ្ទុះឡើង នៃ ជំងឺ រាតត្បាត ជា សកល នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃចន្ទ ទី១៤ ខែសីហា ឆ្នាំ ២០២៣ ។
សមត្ថកិច្ច៖ ការផ្សព្វផ្សាយ បំភ្លៃ របស់ ក្រុម ប្រឆាំង ក្រៅ ច្បាប់ ថា « មាន ការបែកបាក់ ផ្ទៃក្នុង គណបក្ស ប្រជាជន កម្ពុជា » គឺជា ចេតនា បង្ក ចលាច ល
( ភ្នំពេញ ) ៖ សមត្ថកិច្ច កម្ពុជា កំពុង ស៊ើបអង្កេត រក អ្នក ពាក់ព័ន្ធ ជាមួយនឹង វីដេអូ មួយចំនួន ដែល ផ្សព្វផ្សាយ តាម បណ្តាញ សង្គម ថា « មាន ការបែកបាក់ ផ្ទៃក្នុង គណបក្ស ប្រជាជន កម្ពុជា » ដែល វីដេអូ នេះ ត្រូវបាន រៀបចំ បំភ្លៃ ឡើង ដោយ ក្រុម ប្រឆាំង ជ្រុលនិយម ដើម្បី បង្ក អសន្តិសុខ សង្គម ។
វីដេអូ មួយចំនួន ត្រូវបាន ក្រុម ប្រឆាំង យក ទៅ បង្ហោះ នៅលើ បណ្តាញ TikTok ដោយ បំភ្លៃ ថា នឹង មាន ការបែកបាក់ ផ្ទៃក្នុង គណបក្ស ប្រជាជន កម្ពុជា ក្រោយពេល រៀបចំ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី ។
តាមរយៈ បណ្តាញ ព័ត៌មាន Fresh News សមត្ថកិច្ច កម្ពុជា បាន ច្រានចោល ទាំងស្រុង ចំពោះ ការបំភ្លៃ បែប នេះ និង អះអាង ថា រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី បាន ប្តេជ្ញា ទប់ស្កាត់ ឱ្យ ខាងតែ បាន នូវ ការបង្ក ចលាចល ផ្សេង ៗ ដើម្បី បន្ត ថែរក្សា សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ របស់ ប្រទេស កម្ពុជា ។
ការរៀបចំ យុទ្ធនាការ ផ្សព្វផ្សាយ បំភ្លៃ ព័ត៌មាន របស់ ក្រុម ប្រឆាំង ជ្រុលនិយម ដែល មាន សេនារី យ៉ូ ច្បាស់លាស់ នេះ ជា ចំណុច មួយ ដែល រុញ ឱ្យ ក្រុម របស់ ពួកគេ នៅក្នុង ប្រទេស ត្រូវ ចាប់ខ្លួន យក ទៅ អនុវត្ត ច្បាប់ កាន់តែ ច្រើន ថែម ទៀត ៕
កាលពី ខែមេសា ឆ្នាំ នេះ លោក លី ក៏ បាន បំពេញ ទស្សនកិច្ច ទៅកាន់ រុស្ស៉ី ម្តង រួច មកហើយ ផងដែរ ។ ចំណែក កាលពី ខែ មុន ជំនួយការ ម្នាក់ របស់ លោក វ៉្លាឌីមៀ ពូទីន បាន បង្ហើប ឱ្យដឹង ថា លោក ប្រធានាធិបតី រុស្ស៉ី មាន ផែនការបំពេញ ទស្សនកិច្ច មកកាន់ ប្រទេស ចិន នា ខែតុលា ខាងមុខ បន្ទាប់ពី ប្រធានាធិបតី ចិន លោក ស៉ី ជិន ពីង បាន ទៅ បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ ទីក្រុង មូស្គូ ហើយ ប្រកាស ថា ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ បាន ឈានដល់ សករាជ ថ្មី មួយ ។
ស្នងការដ្ឋាន គរបាល ខេត្ដ បន្ទាយមានជ័យ ចេញ ប្រកាស ព័ត៌មាន ពាក់ព័ន្ធ ចាប់ខ្លួន ជនសង្ស័យ ម្នាក់ រឿង គ្រឿងញៀន រហូត ស្លាប់
( បន្ទាយមានជ័យ )៖ ជនសង្ស័យ ម្នាក់ ពាក់ព័ន្ធ បទល្មើស គ្រឿងញៀន បាន គាំង បេះដូង ស្លាប់ ពេល បញ្ជូន ខ្លួន ដល់ កន្លែង ឃុំឃាំង បណ្ដោះអាសន្ន នៃ អធិការដ្ឋាន នគរបាល ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ កាលពី ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២៣ ។
កម្លាំង ជំនាញ ក្រោម ការសម្របសម្រួល ពី តំណាង អយ្យការ បាន ចុះ ទៅដល់ វត្ត ដង រុន ប្រទះឃើញ ជនសង្ស័យ ឈ្មោះ លាង ឡាង ជិះ លើ ម៉ូតូ ក្នុង វត្ត ដៃ កាន់ ទូរស័ព្ទ បម្រុង គេចខ្លួន កម្លាំង ឃើញ ចាប់ ឃាត់ខ្លួន ហើយ ឆែកឆេរ ពុំ មាន ថ្នាំ ញៀន ទេ ពេល សួរ ជនសង្ស័យ ឆ្លើយ ថា ខ្លួន បាន បោះ ថ្នាំ ញៀន ចោល តែ សមត្ថកិច្ច រក មិន ឃើញ បន្ទាប់មក ក៏ បាន នាំ ខ្លួន មក អធិការដ្ឋាន នគរបាល ស្រុក មង្គល បូរី ដើម្បី សាកសួរ បន្ថែម ទៀត ។
ពេល មកដល់ អធិការដ្ឋាន ជនសង្ស័យ បាន សុំ ហូប បាយ និង សុំ ជួប ម្តាយ មីង ឈ្មោះ ធា ពេល នោះ សមត្ថកិច្ច បាន ឲ្យ បាយ ហូប មួយ កញ្ចប់ តែ ហូប មិន ទាន់ រួច ផង ជនសង្ស័យ ថា ឈឺ ពោះ ហើយ សុំ ទឹក ផឹក ជាច្រើន ដប ហើយ សុំ ចូល បង្គន់ ពេល នោះ ឃើញ ជនសង្ស័យ យក ទឹក ស្រោច ខ្លួន ស្រែក ថា ក្តៅ ណាស់ ហើយ សមត្ថកិច្ច សង្ស័យ ថា ជនសង្ស័យ អាច លេប ថ្នាំ ញៀន លេប ចូលក្នុង ពោះ បន្ទាប់មក ឃើញ ជនសង្ស័យ មាន អាការៈ ប្លែក បែក ពពុះមាត់ វា ពេញ ក្នុង បង្គន់ ។
ដោយ មាន ការសង្ស័យ កម្លាំង បាន រាយការណ៍ ជូន ព្រះរាជអាជ្ញា ពី អាការៈ ជនសង្ស័យ ភ្លាម ៗ នោះ នៅ ម៉ោង ១៣៖០០ នាទី ព្រះរាជអាជ្ញា ឲ្យ យក ទៅកាន់ មន្ទីពេទ្យ បាន ធ្វើតេស្ត ទឹកនោម មាន សារធាតុ ញៀន ហើយ គ្រូពេទ្យ បាន ជួយ សង្រោះ ជាបន្ទាន់ រហូតដល់ ម៉ោង ១៧៖ ១៥នាទី ជនសង្ស័យ បាន ស្លាប់ ក្រោយពីរ ការស្លាប់ កម្លាំង បាន រាយការណ៍ ជូន ព្រះរាជអាជ្ញា ថា ជនសង្ស័យ បាន ស្លាប់ បន្ទាប់មក ព្រះរាជអាជ្ញា បាន ឲ្យ យោបល់ ជៀសវាង ការចោទប្រកាន់ ។
( ព្រះវិហារ ) ៖ លោក មាស សុភា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ប្រគេន ទៀន ព្រះវស្សា គ្រឿង បរិក្ខា និង បច្ច័យ ដល់ ព្រះសង្ឃ ចំនួន ៧វត្ត ក្នុង ខេត្ត ព្រះវិហារ ។
ពិធី នេះ មាន ការអញ្ជើញ ចូលរួម ពី លោក ប្រាក់ សុវណ្ណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ព្រះវិហារ លោក ឡុង សុវណ្ណ ទីប្រឹក្សា រាជ រដ្ឋាភិបាល ព្រមទាំង ថ្នាក់ដឹកនាំ ខេត្ត ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត មន្ត្រីរាជការ និង ពុទ្ធ បរិស័ទ ជិត ឆ្ងាយ ជាច្រើន រូប ទៀត ដែល ពិធី នេះ បាន រៀបចំ ធ្វើឡើង នៅ វត្ត ប្រាសាទ គោង បេង ស្ថិត ក្នុង ភូមិ គោក បេង សង្កាត់ កំពង់ប្រណាក ក្រុង ព្រះវិហារ ខេត្ត ព្រះវិហារ ។
នៅក្នុង ឱកាស នេះ ដែរ ទេសរដ្ឋមន្ត្រី មាស សុភា បាន ថ្លែង ប្រគេន ព្រះសង្ឃ និង ជម្រាប ជូន លោកយាយ លោក តា ពី ការរីកចម្រើន របស់ ប្រទេស ទេសជាតិ ទាំង ផ្នែក អាណាចក្រ និង ផ្នែក ពុទ្ធ ចក្រ ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។
ទេសរដ្ឋមន្ត្រី មាស សុភា បាន ថ្លែង ការប្រគេន ព្រះសង្ឃ និង អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ បន្ត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា គាំទ្រ នាយក រដ្ឋ ថ្មី អាណត្តិ ទី៧ នៃ រដ្ឋសភា គឺ លោក កិត្តិទេសាភិបាល បណ្ឌិត ហ៊ុន ម៉ាណែត ដើម្បីឱ្យ ប្រទេសជាតិ ទទួលបាន សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ រីកចម្រើន គ្រប់ វិស័យ តទៅទៀត ។
( ភ្នំពេញ ) ៖ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ សូមស្វាគមន៍ ចំពោះ ព័ត៌មាន ស្តី អំពី អនុក្រឹត្យ លេខ ១៧៣ អន ក្រ. បក ស្ដីពី ការបង្កើត ឧទ្យាន ជាតិ ជួរ ភ្នំ ក្រវាញ ដែល ជា ការច្របាច់ បញ្ចូល គ្នា នៃ ឧទ្យាន ជាតិ ជួរ ភ្នំ ក្រវាញ កណ្ដាល ឧទ្យាន ជាតិ ជួរ ភ្នំ ក្រវាញ ខាងត្បូង និង របៀង អភិរក្ស ជីវៈ ចម្រុះ ប្រព័ន្ធ តំបន់ ការពារ ធម្មជាតិ ។
បណ្ឌិត ស៊ូវណ្ណា ហ្គោន ឡែត បាន ថ្លែង ថា ការច្របាច់ បញ្ចូល គ្នា នេះ គឺជា ក្តី សុបិន របស់ អ្នក អភិរក្ស ទាំងអស់ ដែល ធ្វើការ នៅ តំបន់ ជួរ ភ្នំ ក្រវាញ ដែល ចង់ ឃើញ តំបន់ ទេសភាព មួយ មាន លក្ខណៈ រួបរួម គ្នា តែ មួយ ដើម្បី រក្សាទុក សម្រាប់ អភិរក្ស តំបន់ ទី ជម្រាល ប្រភព ទឹក ដ៏ មាន សារៈសំខាន់ ស្ថិត នៅ ភាគ និរតី នៃ ប្រទេស កម្ពុជា ។
ឆ្លើយតប ទៅនឹង បទ ចោទ ដែល ថា ព្រំប្រទល់ នៅ ពុំ មាន ភាពច្បាស់លាស់ រវាង ដី ស្រែ ចម្ការ របស់ ប្រជាពលរដ្ឋ និង ព្រំប្រទល់ គម្រោង រេដ បូក អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ សូម ធ្វើ ការបំភ្លឺ ថា នេះ មិន មែន ជា ការពិត នោះ ទេ ។
អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បាន និង កំពុង ធ្វើការ យ៉ាង ជិតស្និត ជាមួយ សហគមន៍ ជនជាតិ ដើម ភាគ តិច ជង ដែល រស់ នៅក្នុង តំបន់ ជ្រលង ភ្នំ ឆាយ អារ៉ែង ដោយ បាន ជួយ កំណត់ ព្រំប្រទល់ ដី ស្រែ ចម្ការ និង ដី សម្រាប់ សហគមន៍ មូលដ្ឋាន ប្រើប្រាស់ ចាប់តាំងពី ឆ្នាំ ២០១៥មក ម្ល៉េះ ។
តាម ការកំណត់ អត្ត សញ្ញាណ ដី ប្រើប្រាស់ ខាងលើ ប្រជាពលរដ្ឋ មាន ដី លំនៅដ្ឋាន និង ដី ស្រែ ចម្ការ ជា មធ្យម ទំហំ ៥.៦ហិកតា ក្នុង មួយ គ្រួសារ ។
លើស ពី នេះ ទៅ ទៀត ការប្រមូល អនុផល ព្រៃឈើ ក៏ ត្រូវបាន អនុញ្ញាត នៅក្នុង តំបន់ គម្រោង រេដ បូក ផងដែរ ។ ការប្រមូល អនុផល ព្រៃឈើ នេះ ត្រូវបាន អនុញ្ញាត ដោយ ច្បាប់ ស្ដីពី តំបន់ ការពារ ធម្មជាតិ ឆ្នាំ ២០០៨ ។ តែ ទោះជា យ៉ាងណា ក៏ដោយ ការកាប់ ឈើ និង ការកាប់ រាន ដី ព្រៃ ស្ថិត នៅ ក្រៅ តំបន់ សហគមន៍ តម្រូវ ឱ្យ មាន ការអនុញ្ញាត ពី ក្រសួង បរិស្ថាន ជាមុន សិន ៕
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣
៣៖ រដ្ឋមន្ដ្រី ក្រសួង យុត្តិធម៌ ប្រគល់ តួនាទី ប្រធាន ស្ដីទី តុលាការ កំពូល ជូន លោក ជីវ កេង
៤៖ លោក គីម ជុង អ៊ុន ស្ដី បន្ទោស ក្រុម មន្ត្រី កូរ៉េ ខាងជើង ជុំវិញ ការខូចខាត បង្កឡើង ដោយ ព្យុះ
៥៖ លោក ពុយ គា ប្រាប់ ពី មូលហេតុ លោក វ៉ាង យី ដោះ ក្រវាត់ ក ចេញ ពេល ជួប រដ្ឋមន្រ្តី ការបរទេស សិង្ហបុរី
៦៖ តៃវ៉ាន់ នឹង មិន ចុះ ញ៉ម ចំពោះ ការគំរាមកំហែង ឡើយ . នេះ ជា សម្ដី របស់ មេដឹកនាំ រង កោះ តៃវ៉ាន់ ក្នុង ដំណើរទស្សនកិច្ច នៅ អាមេរិក
៧៖ ក្រសួង កសិកម្ម ចេញ ប្រកាស ព័ត៌មាន ពី ការចុះ ដកហូត និង ឲ្យ បំផ្លាញ ចោល ត្រី ដែល ស៊ី សាច់ ជា អាហារ ហើយ ហាម នាំចូល . ពលរដ្ឋ អាច រាយការណ៍ ទៅ ក្រសួង ភ្លាម បើសិន មាន ការលួច នាំចូល
៨៖ អង់គ្លេស ព្រមាន ពី ការវាយប្រហារ ភេរវកម្ម ដែល អាច កើតមាន នៅ ស៊ុយអែត
៩៖ បច្ចុប្បន្នភាព ប្រចាំ ថ្ងៃ៖ គិត ត្រឹម ព្រឹក ថ្ងៃ ១៤ ខែសីហា ការឆ្លង តំបន់ អាស៊ាន មាន អ្នក ឆ្លង កូវីដ១៩ មាន ការប្រែប្រួល តិចតួច ខណៈ អ្នក ឆ្លង មាន ចំនួន ជាង ៣៦. ៣លាន នាក់
១០៖ រដ្ឋមន្រ្តី ការពារ ជាតិ ចិន នឹង បំពេញ ទស្សនកិច្ច ទៅកាន់ ប្រទេស រុស្ស៉ី និង បេឡារុស ក្នុង សប្តាហ៍ នេះ
១២៖ នូវែលសេឡង់ សម្រេច លុបចោល វិធានការរឹតត្បិត កូវីដ១៩ ដែល នៅសល់ ចុងក្រោយ
១៣៖ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ រៀបចំ ប្រព័ន្ធ Hotline ថ្មី សម្រាប់ ជា មធ្យោបាយ ក្នុង ការផ្ដល់ ព័ត៌មាន ឬ ស្វែង ជំនួយ អន្ដរាគមន៍
១៤៖ រុស្ស៉ី នឹង បំពាក់ មីស៊ីល ល្បឿន លឿន ជាង សំឡេង លើ នាវា មុជទឹក នុយក្លេអ៊ែរ ស៊េរី ថ្មី
១៥៖ រុស្ស៉ី ថា ត្រៀម រួចរាល់ ក្នុង ការបង្កើន កិច្ចសហប្រតិបត្តិការ ប្រឆាំង ភេរវកម្ម ជាមួយ អ៉ីរ៉ង់
១៧៖ អ៊ុយក្រែន ថ្កោលទោស រុស្ស៉ី ជុំវិញ ការបាញ់ ព្រមាន លើកប៉ាល់ ដឹក ទំនិញ នៅ សមុទ្រ ខ្មៅ និង អំពាវនាវ ឱ្យ អន្តរជាតិ ចាត់ វិធានការឆ្លើយតប
១៨៖ របប យោធានី ហ្សេ ថា នឹង កាត់ទោស អតីត ប្រធានាធិបតី ដែល ត្រូវបាន ទម្លាក់ ពី អំណាច ក្រោម បទ ចោទប្រកាន់ ក្បត់ ជាតិ
២៖ តុលាការ អូស្ត្រាលី ពិន័យ ក្រុមហ៊ុន Dell ជាង ៦លាន ដុល្លារ សម្រាប់ ការបំភាន់ អតិថិជន លើ ការបញ្ចុះ តម្លៃ
សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ បំពាក់ គ្រឿង ឥស្សរិយយស និង រៀបចំ អាហារ ជូន អ្នកសារព័ត៌មាន ដែល តាម យក ព័ត៌មាន ផ្ទាល់ ក្នុង កម្មវិធី សម្តេច
( ភ្នំពេញ ) ៖ នៅ ល្ងាច ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ផ្តល់ កិត្តិយស អញ្ជើញ បំពាក់ គ្រឿង ឥស្សរិយយស និង រៀបចំ អាហារ ជូន អ្នកសារព័ត៌មាន ជាង ១០០ នាក់ ដែល ជា អ្នក តាមយក ព័ត៌មាន ដោយ ផ្ទាល់ ក្នុង កម្មវិធី នានា របស់ សម្តេច ។
ពិធី ប្រកបដោយ មហា កិត្តិយស សម្រាប់ អ្នកសារព័ត៌មាន នេះ ត្រូវបាន រៀបចំឡើង នៅ វិមាន សន្តិភាព ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ទី ដែល សម្តេច តេជោ តែង ទទួល គណៈប្រតិភូ បរទេស ។
សម្តេច តេជោ ហ៊ុន សែន ត្រូវ គេ ចាត់ទុក ជា មេដឹកនាំ មួយ រូប ដែល ផ្តល់ ការចាប់អារម្មណ៍ និង តម្លៃ ខ្ពស់ សម្រាប់ ប្រព័ន្ធ ផ្សព្វផ្សាយ សារព័ត៌មាន ។ សម្តេច តេជោ ចាត់ទុក សារព័ត៌មាន ជា ផ្នែក ដ៏ សំខាន់ នៃ ជីវិត នយោបាយ របស់ សម្តេច ។
ក្នុង ដំណើរ ជីវិត នយោបាយ របស់ សម្តេច ជាពិសេស ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី ជិត ៤០ ឆ្នាំ រាល់ កម្មវិធី សាធារណៈ នានា តែង មាន អ្នកសារព័ត៌មាន ទាំង របស់ ជាតិ និង វិស័យ ឯកជន តាម សម្តេច តេជោ ជាប់ ជានិច្ច ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ក្នុង ពិធី នា ល្ងាច ថ្ងៃ នេះ ជា ការថ្លែងអំណរគុណ ដល់ អ្នកសារព័ត៌មាន ទាំងអស់ ដែល បាន ជម្នះ ការលំបាក និង ប្រឹងប្រែង ផ្សព្វផ្សាយ ព័ត៌មាន ពាក់ព័ន្ធ សកម្មភាព របស់ សម្តេច ។
អ្នកសារព័ត៌មាន ដែល សម្តេច តេជោ អញ្ជើញ គ្រឿង ឥស្សរិយយស និង រៀបចំ អាហារ ជូន នា ល្ងាច ថ្ងៃ នេះ មាន អ្នក ខ្លះ បាន ដើរ តាមយក ព័ត៌មាន សម្តេច តេជោ តាំងពី ទសវត្សរ៍ ៩០ មក ម្ល៉េះ ។
ក្នុង តួនាទី ភារកិច្ច ដែល អង្គភាព ផ្តល់ ជូន ក្នុង ការតាមយក ព័ត៌មាន នៃ សកម្មភាព របស់ សម្តេច តេជោ ធ្វើឱ្យ ពួកគេ មាន អនុស្សាវរីយ៍ ជាច្រើន ក្នុង អាជីព ។ ជាពិសេស បាន ធ្វើឱ្យ ពួកគេ បាន រួមចំណែក ក្នុង កិច្ចការ សង្គមជាតិ ដ៏ មាន តម្លៃ នៅក្នុង អាជីព ។
ការទទួលបាន គ្រឿង ឥស្សរិយយស និង ការរៀបចំ អាហារ ជូន បែប នេះ គឺជា លើក ដំបូង ហើយ សម្រាប់ ពួកគេ ។ អ្នក ទទួលបាន គ្រឿង ឥស្សរិយយស និង ចូលរួម ពិសារ អាហារ នេះ រាប់ ចាប់ពី អ្នកបើក រថយន្ត អ្នករៀបចំ ឧបករណ៍ បំពង សំឡេង អ្នកកាន់ ម៉ាស៊ីន អគ្គិសនី អ្នករៀបចំ បណ្តាញ អ៉ីនធើណេត រួមទាំង ជនជាតិ ជប៉ុន ម្នាក់ ផងដែរ ។
ពួកគេ ចាត់ទុក កម្មវិធី ថ្ងៃ នេះ ជា មហា កិត្តិយស និង ជា កំណត់ត្រា ប្រវត្តិសាស្ត្រ នៃ អាជីព របស់ ពួកគេ ផងដែរ ។ ពួកគេ បាន ចាត់ទុក កម្មវិធី ថ្ងៃ បង្ហាញ ឱ្យ ឃើញ នូវ កាយវិការ របស់ សម្តេច តេជោ ជា មេដឹកនាំ មួយ រូប ដែល មាន ការយកចិត្តទុកដាក់ ខ្ពស់ គ្រប់ រឿង នៅ ជុំវិញ ខ្លួន ឬ ពាក់ព័ន្ធ នឹង ការងារ សម្តេច មិន ថា ការងារ តូច ឬ ធំ ។ ដូច អ្វី ដែល សម្តេច តែង លើកឡើង ថា មើល ស្រាល ការងារ តូច មិន អាច ធ្វើ ការងារ ធំ បាន នោះ ឡើយ ។
ក្រុម អ្នកសារព័ត៌មាន បាន បង្ហាញ ក្តី ត្រេកអរ និង ចាត់ទុក កាយវិការ សម្តេច តេជោ ជាំ វីរភាព មួយ សម្រាប់ មេដឹកនាំ ៕
យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៤ ខែសីហា៖ បង្ក្រាប ២២ករណី ឃាត់ខ្លួន ៦៧ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១១ករណី . ជួញដូរ ២ករណី . និង ដឹកជញ្ជូន រក្សាទុក ៩ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៦៧ នាក់ ។
ក្រសួង ពាណិជ្ជកម្ម សហការ រៀបចំ វគ្គ ផ្សព្វផ្សាយ « ច្បាប់ ស្តីពី សុវត្ថិភាព ម្ហូប អាហារ និង បទប្បញ្ញត្តិ ពាក់ព័ន្ធ នានា » នៅ វិទ្យាល័យ វត្ត កោះ
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ « ក. ប. ប. » នៃ ក្រសួង ពាណិជ្ជកម្ម បាន សហការ ជាមួយ វិទ្យាល័យ វត្ត កោះ នៅ រសៀល ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ រៀបចំ វគ្គ ផ្សព្វផ្សាយ « ច្បាប់ ស្តីពី សុវត្ថិភាព ម្ហូប អាហារ និង បទប្បញ្ញត្តិ ពាក់ព័ន្ធ នានា » ដល់ សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ អាជីវករ ក្នុង សាលារៀន ។
តួកម៉េនីស្ថាន ចង់ ភ្ជាប់ ជើងហោះហើរ ជាមួយ កម្ពុជា និង ពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ទេសចរណ៍ ដើម្បី ជំរុញ រំ ហូរ ទេសចរ
( ភ្នំពេញ ) ៖ តួកម៉េនីស្ថាន បង្ហាញ គោលបំណង ចង់ ភ្ជាប់ ជើងហោះហើរ ត្រង់ ជាមួយ ប្រទេស កម្ពុជា ឱ្យ បាន មុន គេ ក្នុង ចំណោម ប្រទេស នៅ តំបន់ អាស៉ី កណ្ដាល ព្រមទាំង ចាប់អារម្មណ៍ ចង់ ពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ទេសចរណ៍ រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ រឹងមាំ ដើម្បី ជំរុញ រំ ហូរ ទេសចរ ទៅ វិញ ទៅ មក ឱ្យ កាន់តែ ច្រើន ។
លោក មូហាំ ម៉េត នីយ៉ះ ម៉ាស្សា ឡូវ បាន បន្ត ថា រដ្ឋាភិបាល តួកម៉េនីស្ថាន មាន បំណង ចង់ ភ្ជាប់ ជើងហោះហើរ ត្រង់ ពី ប្រទេស ខ្លួន មក ខេត្ត សៀមរាប ដែល ជា គោលដៅ ទេសចរណ៍ ដ៏ សំខាន់ ក្នុង តំបន់ អាស៊ាន ដើម្បីឱ្យ ភ្ញៀវ ទេសចរ នៅ ប្រទេស តួកម៉េនីស្ថាន និង ភ្ញៀវ ទេសចរ ប្រទេស ជុំវិញ បាន មក ទស្សនា ខេត្ត សៀមរាប តំបន់ រមណីយដ្ឋាន អង្គរ ដែល ជា តំបន់ បេតិកភណ្ឌ ពិភពលោក ក៏ ដូចជា ទូទាំង ប្រទេស កម្ពុជា ផងដែរ ។
លោក មូហាំ ម៉េត នីយ៉ះ ក៏ បាន លើកឡើង ជា សំណើ រៀបចំ ព្រឹត្តិការណ៍ ទេសចរណ៍ នៅ ប្រទេស កម្ពុជា និង នៅ ប្រទេស តួកម៉េនីស្ថាន ដើម្បី ផ្សព្វផ្សាយ ពី សក្ដានុពល ទេសចរណ៍ គោលដៅ ទេសចរណ៍ រវាង ប្រទេស ទាំង ពី ទៅកាន់ ប្រតិបត្តិករ ទេសចរណ៍ ក៏ ដូចជា ភ្ញៀវ ទេសចរ ជាតិ / អន្តរជាតិ បន្ថែម ទៀត រួមចំណែក សម្រេចបាន នូវ គោលដៅ រួមគ្នា ជំរុញ រំ ហូរ ទេសចរ ទៅ វិញ ទៅមក ។
នៅក្នុង សប្ដាហ៍ នេះ ដែរ លោក ឯក អគ្គ រដ្ឋទូត តួកម៉េនីស្ថាន ក៏ នឹង ទៅ ទស្សនកិច្ច នៅ តំបន់ រមណីយដ្ឋាន អង្គរ ខេត្ត សៀមរាប ដើម្បី ស្វែងយល់ ពី សក្ដានុពល ទេសចរណ៍ នៅ ទីនោះ ព្រោះ ប្រាសាទ អង្គរវត្ត និង តំបន់ រមណីយដ្ឋាន ប្រវត្តិសាស្ត្រ មួយ នេះ មាន ភាពល្បីល្បាញ យ៉ាង ខ្លាំង ដែល ភ្ញៀវ ទេសចរ គ្រប់ ប៉ងប្រាថ្នា ចង់ មក ទស្សនា ។
ចំណេះដឹង ទូទៅ៖ ប្រាសាទ ដន មឿង ទើយ ខេត្ត យសោធរ ជា ប្រាសាទ ខ្មែរ ចំណាស់ ជាង គេ មួយ ស្ថិត នៅ ប្រទេស ថៃ
តាមរយៈ កំណាយ បុរាណ វត្ថុ នៅ ជុំវិញ នោះ គេ បាន រកឃើញ សំណល់ កុលាល៍ ភាជន៍ និង គ្រោងឆ្អឹង មនុស្ស សម័យ បុរេប្រវត្តិ ដែល បង្ហាញ ថា ទី បុរាណ ស្ថាន មួយ នេះ គឺ មាន មនុស្ស រស់ នៅ តាំងពី សម័យ បុរេប្រវត្តិ ហើយ មកដល់ សម័យ ប្រវត្តិសាស្ត្រ ទីនេះ មាន ទំនាក់ទំនង ជាមួយ អារ្យធម៌ ខ្មែរ ផង និង អារ្យធម៌ ទ្វារវតី ផង ក៏ ចេះតែ មាន វឌ្ឍនាការ ក្លាយជា ទីប្រជុំជន មួយ ចាប់ពី សម័យ អាណាចក្រ ភ្នំ សម័យ ចេនឡា រហូតមកដល់ សម័យ អង្គរ ក្រោម ការគ្រប់គ្រង របស់ រាជ អំណាច ខ្មែរ ។
១. សំណល់ កុលាល៍ ភាជន៍ និង គ្រោងឆ្អឹង មនុស្ស សម័យ បុរេប្រវត្តិ គេ ក៏ បាន ប្រើប្រាស់ បច្ចេកវិទ្យា ស្កេន ពីលើ អាកាស និង រកឃើញ ថា ទី បុរាណ ស្ថាន មួយ នេះ មាន មនុស្ស រស់ នៅ តាំងពី ជាង ២៥០០ ឆ្នាំ មុន មក ម្ល៉េះ ។
២. ក្រៅពី ភស្តុតាង កំណាយ នៅ សម័យ បុរេប្រវត្តិ ខាងលើ គេ ក៏ បាន រកឃើញ បំណែក ថ្ម ភក់ តូច ធំ ដែល ជា រចនាសម្ពន្ធ របស់ ប្រាសាទ ឥដ្ឋ ដន មឿង ទើយ បំណែក សិលា ខ្លះ មាន ឆ្លាក់ ក្បាច់ ផ្កា ។ មិន តែ ប៉ុណ្ណោះ នៅ ជាប់ នឹង ខឿន ប្រាសាទ ក៏ មាន ឆ្លាក់ ក្បាច់ ត្របក មួយចំនួន ផងដែរ ។
៤. ចម្លាក់ ក្បាច់ គូឌុ១ ផ្ទាំង បញ្ជាក់ អំពី សិល្បៈ រចនាបថ សំបូរ ព្រៃ គុក ។ គូឌុ គឺជា ក្បាច់ ចម្លាក់ ម្យ៉ាង នៅលើ ប្រាសាទ ខ្មែរ បុរាណ ពិសេស រចនាបថ ភ្នំ ដា រចនាបថ សំបូរ ព្រៃ គុក រចនាបថ ព្រៃ ក្មេង រចនាបថ កំពង់ ព្រះជាដើម ដែល ខ្មែរ យើង នៅ ទទួល ឥទ្ធិពល ពី ឥណ្ឌា ច្រើន នៅឡើយ គ្រាន់តែ មាន ការខុសគ្នា ខ្លះ ៗ ( មាន រឿង និយាយ លម្អិត ច្រើន ទៀត ពាក់ព័ន្ធ នឹង ចម្លាក់ គូឌុ នេះ ) ។
៥. ប្រាសាទ អណ្ដែត២ផ្ទាំង ដែល ដាច់ ចេញ ពី តួ ប៉ម ប្រាសាទ ព្រោះ ធម្មតា សិល្បៈ ស្ថាបត្យ សម័យ មុន អង្គរ ខ្មែរ យើង និយម ធ្វើ ប្រាសាទ អណ្ដែត នៅជាប់ នឹង តួ ប៉ម ប្រាសាទ ។ ដំបូល ប្រាសាទ អណ្ដែត ភាគ ច្រើន គឺ មាន ចម្លាក់ គូ ឌុជា គ្រឿង លម្អ ហើយ គូឌុ ខាងលើ នេះ ក៏ ប្រហែលជា ដាច់ ចេញ ពី ប្រាសាទ អណ្ដែត ណាមួយ នោះ ដែរ ។
៧. ចម្លាក់ សិង្ហ ធ្វើ អំពី ថ្ម ភក់ ចំនួន ១ ចម្លាក់ នេះ ត្រូវបាន បុរាណវិទូ ពិនិត្យ ឃើញ ថា ជា សិល្បៈ រចនាបថ ប្រែ រូប ពោលគឺ ក្នុង រជ្ជកាល ព្រះបាទ រា ជេន្ទ្រ វម៌្ម ទី២ ជា ព្រះមហាក្សត្រ ខ្មែរ យើង នា សម័យ អង្គរ ។ គេ បាន ធ្វើ កំណាយ រកឃើញ ចម្លាក់ សិង្ហ នេះ នៅក្រោម ដី មុខ ប្រាសាទ ដន មឿង ទើយ កាលពី ឆ្នាំ ១៩៩១ ។
ចំពោះ បុរាណ វត្ថុ ទាំង អម្បាលម៉ាន នេះ ត្រូវបាន រក្សាទុក និង តាំងពិព័រណ៍ នៅក្នុង សារមន្ទីរ បុរាណវិទ្យា ដន មឿង ទើយ នា ស្រុក ខាំ ខឿន កែវ នោះ រហូតដល់ សព្វ ថ្ងៃ ។ ពិត ណាស់ ក្នុង ចំណោម ប្រាសាទ បុរាណ ខ្មែរ ទាំង ជាង ១០០ កន្លែង នៅ ប្រទេស ថៃ ប្រាសាទ ដន មឿង ទើយ នេះ ត្រូវបាន ចាត់ទុក ថា ជា ប្រាសាទ ចំណាស់ ជាង គេ មួយ របស់ ខ្មែរ ដែល ស្ថិត នៅ ប្រទេស នេះ ៕ ក្រុមហ៊ុន ខេម លូប ( ខេមបូឌា ) ឯ . ក ជូនដំណឹង អតីត បុគ្គលិក ផ្នែក លក់ ម្នាក់ ឈ្មោះ វី សុខ ពៅ ឲ្យ ចូល ខ្លួន ដោះស្រាយ ករណី លួច លុយ និង បោកប្រាស់ អតិថិជិន
នៅក្នុង ជំនួប នេះ លោក បណ្ឌិត អ៊ុម រម្យ ណី បាន សម្តែង នូវ ការអបអរសាទរ ចំពោះ និស្សិត ជ័យលាភី ទាំង ៤០ អង្គ / នាក់ ដែល នឹង ទៅ បន្ត ការសិក្សា នៅ សាធារណរដ្ឋ ឥណ្ឌា ក្នុង រយៈពេល ដ៏ ខ្លី ខាងមុខ នេះ និង បាន គូសបញ្ជាក់ ថា ឥណ្ឌា ជា ប្រទេស ដែល មាន វប្បធម៌ សំបូរ បែប និង មាន ទំនាក់ទំនង យ៉ាង ជិតស្និទ្ធ ជា ប្រវត្តិសាស្ត្រ លើ វិស័យ ជាច្រើន ជាមួយ ប្រទេស កម្ពុជា មិន ត្រឹមតែ ប៉ុណ្ណោះ ឥណ្ឌា ជា ប្រទេស ដែល មាន ភាពរីកចម្រើន ខ្លាំង លើ ការអប់រំ ផ្នែក បច្ចេកវិទ្យា ។
ការ ទៅ សិក្សា នៅ ទីនោះ គឺ មិន ត្រឹមតែ អាច រៀនសូត្រ បង្កើន ចំណេះដឹង លើ មុខជំនាញ របស់ ខ្លួន ប៉ុណ្ណោះ ទេ ថែមទាំង អាច ស្វែងយល់ បន្ថែម ពី ឫសគល់ នៃ ប្រវត្តិសាស្ត្រ និង វប្បធម៌ ចម្រុះ ផ្សេង ទៀត ដែល នេះ ជា ឱកាស សម្រាប់ និស្សិត ទាំងអស់ អាច រៀន សង្កេត ដក ពិសោធន៍ ច្នៃប្រឌិត និង បន្ស៊ាំ ខ្លួន ជាមួយ បរិយាកាស ពហុ វប្បធម៌ ដើម្បី ទទួលបាន អត្ថប្រយោជន៍ ដល់ ការ សិក្សា និង ការរស់នៅ ប្រចាំ ថ្ងៃ ។
ជា ចុងក្រោយ លោក បណ្ឌិត អ៊ុម រម្យ ណី រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា ក៏ បាន ប្រគនពរ និង ជូនពរ ដល់ ព្រះសង្ឃ និង និស្សិត ជ័យលាភី ទាំងអស់ ទទួលបាន សុវត្ថិភាព ក្នុង ការធ្វើដំណើរ ទៅ ក្រៅ ប្រទេស និង សម្រេច ជោគជ័យ ក្នុង ការសិក្សា ។
អភិបាល ស្រុក តាំង គោក នៅ ព្រះគ្រូ ចៅអធិការ វត្ត ជោតញ្ញាណ ចុះ ចែក អំណោយ សប្បុរសធម៌ ដល់ លោកយាយ លោក តា ចំនួន ៥២ គ្រួសារ នៅ ឃុំ តាំង គោក
ក្នុង ឱកាស នោះ ព្រះគ្រូ ចៅអធិការ វត្ត សម្ដែង នូវ ទឹក ព្រះទ័យ សប្បាយរីករាយ ដែល ឃើញ ថ្នាក់ដឹកនាំ ស្រុក ក៏ ដូចជា រាជ រដ្ឋាភិបាល យកចិត្ត ទុក្ខ ដាក់ ដឹង សុខ ទុក្ខ ប្រជាពលរដ្ឋ ក្នុង ស្រុក តាំង គោក ទោះ នៅក្នុង កាលៈទេសៈ ណា ក៏ដោយ លោក តែង ចុះ ជាប់ នឹង នៅ ជាមួយ ប្រជាពលរដ្ឋ ជានិច្ច ដូចនេះ ជំរុញ ឲ្យ ព្រះអង្គ បាន ចូលរួម ជាមួយ អាជ្ញាធរ ទោះ តិច ក្តី ច្រើន ក្តី ដើម្បី ចូលរួម អភិវឌ្ឍន៍ ស្រុក តាំង គោក ។
លោក ហាក់ ម៉ុង ហួត បាន នាំ នូវ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពី ថ្នាក់ដឹកនាំ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង លោក បណ្ឌិត ថោង ខុន តែងតែ ដាស់តឿន និង ផ្តល់ ជា គំនិត ឲ្យ ថ្នាក់ដឹកនាំ ភូមិ ឃុំ ស្រុក ត្រូវ ចុះ ជាប់ ជាមួយ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន តាម ផ្ទះ ដើម្បី ដឹង ពី សុខ ទុក្ខ និង តម្រូវការ ផ្សេង ៗ ងាយស្រួល ក្នុង ការស្វែងយន្ដ ការដោះស្រាយ ជាដើម ។
លោក ក៏ បាន កោតសរសើរ និង ថ្លែងអំណរ ព្រះគុណ នូវ ទឹក ព្រះទ័យ របស់ ព្រះចៅ អធិការ និង មន្រ្តី សង្ឃ ដែល តែងតែ ចូលរួម ជាមួយ រដ្ឋបាល ស្រុក រដ្ឋបាល ឃុំ នូវ សកម្មភាព មនុស្សធម៌ និង សកម្មភាព ជាច្រើន ដើម្បី ជា ការរួមចំណែក ក្នុង ការអភិវឌ្ឍ របស់ ប្រទេសជាតិ ។ លោក អភិបាល ក៏ បាន សំណូមពរ ឲ្យ អាជ្ញាធរ ភូមិ ឃុំ បន្ត សកម្មភាព ចុះ តាម ខ្នង ផ្ទះ និង ទទួលយក សំណូមពរ របស់ ប្រជាពលរដ្ឋ ដឹង ពី សុខ ទុក្ខ របស់ ពួកគាត់ ៕
មនុស្ស ៤នាក់ ស្លាប់ និង ៧នាក់ រងរបួស ក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ដ៏ រន្ធត់ មួយ នៅ ស្រុក ពាមរក៍ ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ យ៉ាងហោចណាស់ មាន មនុស្ស ប្រុស ស្រី ក្មេង ចាស់ ចំនួន ៤នាក់ បាន ស្លាប់ និង រងរបួស ៧នាក់ ក្នុង ករណី គ្រោះថ្នាក់ ចរាចរណ៍ រថយន្ត បុក រថយន្ត ដែល បើកបរ បញ្ច្រាស ទិស គ្នា ដ៏ រន្ធត់ មួយ នៅ យប់ ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២៣ ចំណុច ភូមិ ស្ទឹង ស្លូត ឃុំ អ្នកលឿង ស្រុក ពាមរក៍ ខេត្ត ព្រៃវែង ។
ចំពោះ ការកសាង នៅ អាគារ រដ្ឋបាល ដល់ សាលា នគរបាល ជាតិ ភូមិភាគ ២នេះ គឺជា ការចូលរួម ចំណែក មួយ យ៉ាង សំខាន់ ក្នុង ការបម្រើ ដល់ កិច្ចការងារ របស់ សាលា នគរបាល ជាតិ ភូមិភាគ២ ខេត្ត កំពង់ចាម នេះ ដើម្បីឲ្យ មាន កន្លែង ធ្វើការងារ ល្អ ស្អាត និង មាន ផាសុខភាព និង ជួយ ពង្រឹង គុណភាព ការងារ នៃ សាលា នគរបាល ជាតិ ភូមិភាគ២ នេះ ឲ្យ កាន់តែ ល្អ ប្រសើរឡើង បន្ថែម ទៀត ។
ក្នុង ឱកាស នោះ លោក ជា សុមេធី បាន សម្ដែង ក្ដីសង្ឃឹម ថា សិស្សនាយ នគរបាល នាយ នគរបាល រង ទាំងអស់ ដែល កំពុង សិក្សា នៅ ទីនេះ នឹង សម្រេចបាន បេសកម្ម ដ៏ ឧត្តុង្គឧត្តម នេះ ដោយ ចាត់ទុក ការសិក្សា រៀនសូត្រ នេះ ថា ជា បេសកកម្ម បម្រើ ជាតិ បម្រើ ប្រជាពលរដ្ឋ ។ ក្រៅពី នេះ លោក សូម លើកទឹកចិត្ត ដល់ ថ្នាក់ដឹកនាំ លោកគ្រូ និង មន្រ្តី នៃ សាលា នគរបាល ជាតិ ភូមិភាគ២ បន្ត ការខិតខំ បណ្ដុះបណ្ដាល ធនធាន កងកម្លាំង នគរបាល ជាតិ ប្រកបដោយ គុណភាព បន្ថែម ទៀត ។
រដ្ឋបាល ស្រុក កំពង់លែង រៀបចំ ធ្វើ សួនច្បារ និង ច្រាំង ទន្លេ ជំហាន ទី២ សម្រាប់ ប្រជាពលរដ្ឋ លំហែ កាយ
( កំពង់ឆ្នាំង ) ៖ រដ្ឋបាល ស្រុក កំពង់លែង កំពុង ដំណើរការ គម្រោង ជួសជុល និង កសាង ច្រាំង ទន្លេ និង សួនច្បារ ជំហាន២ នៅមុខ អធិការដ្ឋាន នគរបាល ស្រុក កំពង់លែង ដើម្បី កែប្រែ សោភ័ណភាព ទី រួម ស្រុក និង សម្រាប់ ជា កន្លែង អង្គុយ លេង លំហែ កាយ របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ភ្ញៀវ ទេសចរ ។
អភិបាល ស្រុក កំពង់លែង លោក យ៉ែម លក្ខិណា នៅ ព្រឹក ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ បាន ឲ្យដឹង ថា ចំពោះ ការអភិវឌ្ឍ របស់ រដ្ឋបាល ស្រុក នៅក្នុង គម្រោង ទី២ នេះ គឺ រដ្ឋបាល ស្រុក ត្រូវ ជួសជុល ច្រាំង ទន្លេ និង សួនច្បារ នៅមុខ អធិការដ្ឋាន នគរបាល ស្រុក ដែល មាន ប្រវែង ៥០ម៉ែត្រ ទទឹង ៧ម៉ែត្រ កម្ពស់ ០. ១៥ម៉ែត្រ និង ជណ្ដើរ ចុះ ទៅ ទន្លេ មួយ កន្លែង ផងដែរ ។
លោក អភិបាល ស្រុក បាន បន្ត ថា កាលពី ជំហាន១ គឺ អភិបាល ស្រុក កំពង់លែង ចាស់ បាន កសាង ច្រាំង ទន្លេ . សួនច្បារ និង វេទិកា មួយ ខ្នង នៅមុខ សាលា ស្រុក កំពង់លែង ដើម្បី លើក សោភ័ណភាព នៅក្នុង ទី រួម ស្រុក កំពង់លែង និង ដើម្បី ជា កន្លែង អង្គុយ លេង លំហែ កាយ របស់ ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ ។
លោក បន្ថែម ថា រដ្ឋបាល ស្រុក កំពង់លែង ក៏ មាន ទិសដៅ ច្បាស់លាស់ ផងដែរ ដើម្បី អនុវត្ត ផែនការ៣ឆ្នាំ រំកិល លើ វិស័យ អប់រំ កសិកម្ម និង ទេសចរណ៍ ។ ចំពោះ វិស័យ ទេសចរណ៍ គឺ រដ្ឋបាល ស្រុក នឹង រៀបចំ តំបន់ ទេសចរណ៍ ប្រវត្តិសាស្ត្រ ច្រក បាក់ ដាវ ដោយ មាន គម្រោង កសាង រូបសំណាក តេជោ មាស តេជោ យ៉ត និង រៀបចំ តំបន់ ទឹកជ្រោះ អូរ ដា ដែល មាន ទឹកជ្រោះ លេង កម្សាន្ត នៅ ក្នុង រដូវ វស្សា តែ ប៉ុណ្ណោះ នៅក្នុង ឃុំ ដា ដើម្បី ស្វាគមន៍ ភ្ញៀវ ទេសចរ មក លេង កម្សាន្ត នៅក្នុង ស្រុក ។
ស្ដ្រី ម្នាក់ នៅ ស្រុក ស្នួល ខេត្ត ក្រចេះ ចេញមក បដិសេធ ក្រោយ មាន ការចុះផ្សាយ ថា ខ្លួន រំលោភ យក ដី ជនជាតិ ភាគ តិច និង ដី ចំណី ទំនប់ សហគមន៍
( ក្រចេះ ) ៖ ម្ចាស់ អាហារដ្ឋាន ទំនប់ ថ្ពង ដែល មាន ទីតាំង នៅ ភូមិ ថ្ពង ឃុំ ស្នួល ស្រុក ស្នួល ខេត្ត ក្រចេះ បាន ធ្វើ ការបដិសេធ ជុំវិញ ការចុះផ្សាយ តាម បណ្តាញ សារព័ត៌មាន ក្នុង ស្រុក មួយចំនួន ដែល បាន ធ្វើ ការផ្សាយ ចោទប្រកាន់ ថា លោកស្រី និង ប្ដី បាន រំលោភ យក ដី របស់ ជនជាតិ ស្ទៀង ចំណុច ខ្ទម អ្នកតា និង ដី ទំនប់ ស្ពង ធ្វើជា កម្មសិទ្ឋ ផ្ទាល់ខ្លួន នោះ គឺជា ការចោទប្រកាន់ គ្មាន មូលដ្ឋាន ច្បាស់លាស់ ។
ម្ចាស់ អាហារដ្ឋាន ទំនប់ ថ្ពង និង ប្រជាពលរដ្ឋ ចាស់ទុំ ដែល មាន ទីលំនៅ តំបន់ នោះ សុទ្ធតែ អះអាង ពី ប្រវត្តិ ដី នោះ ថា បាន កាន់កាប់ ប្រើប្រាស់ តាំងពី ជំនាន់ ជីដូន ជីតា របស់ ប្តី របស់ មក ម្លេះ ដោយ កាល នោះ មិន ទាន់ មាន ទំនប់ នោះ ទេ ទើបតែ នៅ សម័យ ខ្មែរ ក្រហម ទើប មាន ការ ជីក លើក ជា ទំនប់ ថ្ពង នេះ ឡើង ហើយ ក្រោយ ឆ្នាំ ១៩៧៩ គ្រួសារ របស់ ប្តី របស់ គាត់ ក៏ បន្ត ការកាន់កាប់ ប្រើប្រាស់ ដី នេះ រហូតមកដល់ បច្ចុប្បន្ន ។
លោកស្រី បាន លើកឡើង ទៀត ថា ការចោទប្រកាន់ ថា លោកស្រី និង គ្រួសារ បាន រំលោភ យក ដី របស់ បងប្អូន ជនជាតិ ដើម ភាគ តិច នេះ គឺជា ការប្រឌិត ព័ត៌មាន និង ជា ការមួល បង្កាច់ ទាំងស្រុង ព្រោះ វា មិន មែន ជា ការពិត មាន បងប្អូន នៅក្នុង ភូមិ ស្រុក គេ ដឹង ឮ ទាំងអស់ គ្នា ហើយ គ្រប់ ការលើកឡើង អះអាង របស់ ខ្លួន គឺ សុទ្ធសឹងតែ មាន ឯកសារ ការ កាន់កាប់ តាំងពី ដើម រហូតដល់ បច្ចុប្បន្ន ។
រីឯ ការលើកឡើង ថា រំលោភ ការកាន់កាប់ ខ្ទម អ្នកតា គឺ រឹតតែ ជា រឿង បំភ្លើស ការពិត ថា រោង អ្នកតា ឬ ខ្ទម អ្នកតា នេះ គឺ រៀបចំ កសាងឡើង ដោយ គ្រួសារ ប្ដី របស់ លោកស្រី ផ្ទាល់ ដើម្បី គោរព បូជា បន់ស្រន់ សុំ សេចក្តីសុខ ក្នុង គ្រួសារ មិន មែន ជា របស់ បងប្អូន ជនជាតិ ដើម ភាគ តិច ( ស្ទៀង ) នោះ ឡើយ ។ លោកស្រី អះអាង ទៀត ថា ចំពោះ ទីតាំង ដី ដែល លោកស្រី និង គ្រួសារ គ្រប់គ្រង នេះ គឺ បាន ប្រកប អាជីវកម្ម ភោជនីយដ្ឋាន ខារ៉ាអូខេ រយៈពេល ជាង ១៤ ឆ្នាំ មកហើយ ។
ក្នុង សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២៣ នេះ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ បាន បង្ហាញ នូវ ប្រព័ន្ធ ទំនាក់ទំនង សំខាន់ ៗ ដូច ខាងក្រោម៖
