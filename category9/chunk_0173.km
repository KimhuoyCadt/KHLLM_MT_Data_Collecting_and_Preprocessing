( កំពង់ចាម ) ៖ លោក ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី និង លោកស្រី ទន់ ខុន ព្រមទាំង លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង ថ្នាក់ដឹកនាំ ជាច្រើន នាក់ ទៀត នៅ ព្រឹក ថ្ងៃទី ៩ ខែសីហា ឆ្នាំ ២០២៣ បាន រៀបចំ ពិធី ប្រគេន ទៀន ចំណាំ ព្រះវស្សា និង គ្រឿង ទេយ្យ ទាន ដល់ ព្រះសង្ឃ នៅ មណ្ឌល អភិរក្ស សួន គ្រញូង នគរបាជ័យ ស្ថិត ក្នុង សង្កាត់ សំបូរ មាស ក្រុង កំពង់ចាម ។
បន្ទាប់ពី ធ្វើ ពិធី ប្រគេន ទៀន ចំណាំ ព្រះវស្សា និង គ្រឿង ទេយ្យ ទាន ដល់ ព្រះសង្ឃ រួច លោក ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី បាន បើក កិច្ចប្រជុំ បូកសរុប និង វាយតម្លៃ ការងារ បោះឆ្នោត ជ្រេីស តាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ផងដែរ ។
ក្នុង កិច្ចប្រជុំ នោះ ដែរ លោក អ៊ុន ចាន់ ដា បាន ថ្លែង ថា ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ បាន ប្រព្រឹត្តទៅ ប្រកបដោយ ជោគជ័យ មាន សន្តិសុខ សណ្ដាប់ធ្នាប់ ល្អ ប្រជាជន បាន ចេញ ទៅ បោះឆ្នោត ដោយ សេចក្ដីរីករាយ គ្មាន ការគម្រាមកំហែង គ្មាន អំពើហិង្សា ដែល មាន ប្រជាជន ចំនួន សរុប ៥៥៦.០៦៩ នាក់ ស្មើ ៨៥.២ ២ % នៃ ប្រជាជន មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ផ្លូវការ ។
( រតនគិរី ) ៖ នៅ ព្រឹក ថ្ងៃទី ៩ ខែសីហា ឆ្នាំ ២០២៣ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី បាន រៀបចំ ពិធី ប្រកាស ផ្ទេរ ភារកិច្ច តែងតាំង មុខ តំណែង និង បំពាក់ ឋានន្តរស័ក្តិ ជូន មន្ត្រី នគរបាល ក្រោម អធិបតីភាព នាយ ឧត្ត សេនីយ៍ ប៉ែន វិបុល អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ប្រធាន នាយកដ្ឋាន បុគ្គលិក តំណាង នាយ ឧត្ត សេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី ។
ពិធី នេះ ក៏ មាន ការចូលរួម មេបញ្ជាការ កម្លាំងប្រដាប់អាវុធ ទាំង៣ លោក - លោកស្រី ស្នងការ រង អនុប្រធាន ការិយាល័យ កណ្តាល នាយ - នាយ រង ការិយាល័យ អធិការ ស្រុក - ក្រុង មេបញ្ជាការវរសេនា តូច ការពារ ព្រំដែន លេខ ២០៣. ៦២៣ ចំណុះ ឲ្យ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ជាច្រើន រូប ផងដែរ ។
ក្រោយ ស្នងការ នគរបាល ខេត្ត រតនគិរី លោក ឧត្តមសេនីយ៍ ទោ អ៊ុង សុភាព បាន បង្ហាញ របាយការណ៍ រួច មក . លោក ឧត្តមសេនីយ៍ ឯក នួន កក្កដា អនុប្រធាន នាយកដ្ឋាន បុគ្គលិក បាន អាន សេចក្តីប្រកាស តែងតាំង ស្នងការរង ចំនួន ៤នាក់ ស្នងការ រង ទទួល ការងារ ៣នាក់ នាយ ការិយាល័យ ៣នាក់ នាយ រង ការិយាល័យ ចំនួន ៣៧នាក់ ( ស្រី ៨នាក់ ) អធិការ ១នាក់ អធិការ រង ២១ នាក់ ( ស្រី ១នាក់ ) និង មេបញ្ជាការ រង វរសេនា តូច ការពារ ព្រំដែន ៤នាក់ ។
នាយ ឧត្តមសេនីយ៍ ប៉ែន វិបុល និង លោក ញ៉ែ ម សំអឿន បាន ផ្តាំផ្ញើ នាយ - នាយ រង និង ពល នគរបាល ទាំងអស់ ដែល ទើប ទទួល តំណែង និង តម្លើង ឋានន្តរស័ក្តិ នា ពេលនេះ ត្រូវ ខិតខំ បំពេញ ភារកិច្ច ដែល ថ្នាក់ លើ ប្រគល់ ជូន ដើម្បី បំរើ ប្រទេសជាតិ បំរើ ប្រជាពលរដ្ឋ ហើយ ការប្រកាស តែងតាំង និង តម្លើង ឋានន្តរស័ក្តិ ដោយសារ គុណ បំណាច់ អស់ លោក ខិតខំ ធ្វើការ មិន ខ្លាច នឿយហត់ កន្លងមក រីឯ អ្នក មិន ទាន់ បាន តែងតាំង និង បំពាក់ ឋានន្តរស័ក្តិ គឺ ថ្នាក់ លើ នឹង រៀបចំ ជូន ពេល ក្រោយ ។
ជាង នេះ ទៅ ទៀត សូមឲ្យ នាយ - នាយ រង និង ពល នគរបាល ទាំងអស់ សូមឲ្យ មាន សាមគ្គីភាព ផ្ទៃក្នុង ល្អ . មាន ទំនាក់ទំនង ល្អ ជាមួយ មន្ទីរ អង្គភាព ស្ថាប័ន ផ្សេង ៗ . អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ហើយ អរគុណ សន្តិភាព ដែល ធ្វើឲ្យ ប្រទេសជាតិ មាន ការរីកចម្រើន ដូច សព្វ ថ្ងៃ ផងដែរ ៕ សម្ដេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ និង សម្ដេច រាជ បុត្រី ព្រះអនុជ នរោត្តម អរុណ រស្មី ផ្ញើ ព្រះសារលិខិត ជូន លោក ឆាំង យុ ចំពោះ មរណភាព ព្រឹទ្ធ មហា ឧបាសិកា កែវ ណាន ដែល ជា មាតា បង្កើត
( ភ្នំពេញ ) ៖ សម្ដេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ និង សម្ដេច រាជ បុត្រី ព្រះអនុជ នរោត្តម អរុណ រស្មី បាន ផ្ញើ ព្រះសារលិខិត ជូន លោក ឆាំង យុ និង ក្រុមគ្រួសារ ចំពោះ មរណភាព ព្រឹទ្ធ មហា ឧបាសិកា កែវ ណាន ជា មាតា បង្កើត របស់ លោក ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃទី ៥ ខែសីហា ឆ្នាំ ២០២៣ ក្នុង ជន្មាយុ ៩៩ ឆ្នាំ ។
សម្ដេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ បាន សម្ដែង ការសោកស្ដាយ បំផុត ចំពោះ ព្រឹទ្ធ មហា ឧបាសិកា កែវ ណាន ដែល ជា ការបាត់បង់ អ្នកស្នេហាជាតិ និង អ្នក ទំនុកបម្រុង ក្នុង ព្រះពុទ្ធ សាសនា ។ សម្ដេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ក៏ បាន ផ្ដាំផ្ញើ ដល់ លោក ឆាំង យុ សូម កុំ មាន ការព្រួយបារម្ភ ខ្លាំង ពេក សូម រក្សា អារម្មណ៍ ផ្លូវចិត្ត ឱ្យ បាន ធូរស្រាល និង សូម ថែទាំ សុខភាព ផ្លូវកាយ ឱ្យ បាន ល្អ ផងដែរ ។
តាមរយៈ សារលិខិត ឆ្លើយតប នេះ សម្តេច តេជោ បាន លើកឡើង ថា៖ « ខ្ញុំ មាន សេចក្តី សោមនស្ស រីករាយ និង សូម វាយតម្លៃ ខ្ពស់ ចំពោះ ទំនាក់ទំនង ប្រពៃណី ដ៏ ល្អ រវាង គណ បក្ស រួបរួម រុស្ស៊ី និង គណបក្ស ប្រជាជន កម្ពុជា ។ ខ្ញុំ សូម បញ្ជាក់ ជាថ្មី ជូន ឯកឧត្តម ថា គណបក្ស ប្រជាជន កម្ពុជា បន្ត ធ្វើ ការ យ៉ាង ជិតស្និទ្ធ ជាមួយ គណបក្ស រួបរួម រុស្ស៉ី ក្នុង ការពង្រឹង ទំនាក់ទំនង ទ្វេ ភាគី របស់ យើង បន្ថែម ទៀត ដើម្បី ការពារ សន្តិភាព សន្តិសុខ និង ស្ថិរភាព ក្នុង តំបន់ និង ពិភពលោក »៕
តំណាង អយ្យការ បន្ដ បើក ការសាកសួរ ឧកញ៉ា ហ៉ី គីម ហុង ម្ចាស់ ក្រុមហ៊ុន ពិភព ដី មាស និង បក្ខពួក រឿង បោកប្រាស លុយ ពលរដ្ឋ រាប់ រយ គ្រួសារ
( ភ្នំពេញ ) ៖ លោក សេង ហៀង ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ កំពុង បន្ត នីតិវិធី បើក ស៊ើបសួរ ក លើ សំណុំរឿង ឧកញ៉ា ហ៉ី គីម ហុង ម្ចាស់ ក្រុមហ៊ុន ពិភព ដី មាស និង បក្ខពួក ប្រមាណ ១៤ នាក់ ទៀត ដែល ពួក បាន បោកប្រាស់ លុយ របស់ ប្រជាពលរដ្ឋ ជាច្រើន លាន ដុល្លារ ក្នុង ការទិញ ដី ខ្យល់ ។
ជា លទ្ធផល ភាគី រងគ្រោះ និង ខាង ឧកញ៉ា ហ៉ី គីម ហុង បាន ចចារ គ្នា រក ដំណោះស្រាយ រួម ជាជាង នៅ បន្ត បណ្តឹង ដែល ជា ការនាំឲ្យ មាន ខាតបង់ ផលប្រយោជន៍ របស់ អ្នកស្រុក រងគ្រោះ ដែល សរុប ជា ទឹកប្រាក់ រាប់ លាន ដុល្លា ។ យ៉ាងណា ក៏ដោយ រហូតដល់ ពេលនេះ នៅ មិន ទាន់ មាន លទ្ធផល ជា ផ្លូវការ នៅឡើយ ទេ អំពី លទ្ធផល លើ ចំណាត់ នេះ ប្រសិនបើ មាន ដំណឹង ពី ដំណើរការ ចំណាត់ការ នេះ អង្គភាព ព័ត៌មាន Fresh News នឹង ផ្សព្វផ្សាយ ជា បន្ដ បន្ទាប់ ។
សូម បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ជាច្រើន រយ នាក់ បាន តម្រង់ ជួរ គ្នា ត្រៀប ត្រា នៅមុខ សាលាដំបូង រាជធានី ភ្នំពេញ នា រសៀល ថ្ងៃទី ០៨ ខែសីហា ឆ្នាំ ២០២៣ ដើម្បី ចូល បំភ្លឺ នៅ ចំពោះ មុខ តុលាការ ករណី ឧកញ៉ា ហ៉ី គីម ហុង ម្ចាស់ ក្រុមហ៊ុន ពិភព ដី មាស បោកប្រាស់ លុយ រប់ ពួកគាត់ ។ យ៉ាងណាមិញ គេ មិន ទាន់ ដឹង នៅឡើយ ទេ ថា មាន ប្រជាពលរដ្ឋ ប៉ុន្មាន ឲ្យ ពិតប្រាកដ ដែល ចាញ់បោក ឧកញ៉ា រូប នេះ ។
ឧកញ៉ា ហ៉ី គីម ហុង ម្ចាស់ ក្រុមហ៊ុន ពិភព ដី មាស និង ក្រុម អង្គរក្ស សរុប ១៤នាក់ ពាក់ព័ន្ធ ករណី បោកប្រាស់ ប្រជាពលរដ្ឋ ត្រូវបាន បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ០៨ ខែសីហា ឆ្នាំ ២០២៣ ។ លោក ឧត្តមសេនីយ៍ ត្រី សាន សុខ សីហា អ្នកនាំពាក្យ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ក្រោយ បញ្ចប់ ការសួរនាំ នៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ម្ចាស់ ក្រុមហ៊ុន ពិភព ដី មាស និង ក្រុម អង្គរក្ស ត្រូវបាន បញ្ជូន បន្ដ ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម ច្បាប់ ។
គួរ ជម្រាប ថា កម្លាំង ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ចាប់ខ្លួន ឧកញ៉ា ហ៉ី គីម ហុង ម្ចាស់ ក្រុមហ៊ុន ពិភព ដី មាស និង ក្រុម អង្គរក្ស សរុប ១៤នាក់ ពាក់ព័ន្ធ ករណី បោកប្រាស់ ប្រជាពលរដ្ឋ ។ ការចាប់ខ្លួន នេះ ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ០៧ ខែសីហា ឆ្នាំ ២០២៣ នៅ ស្នាក់ការ ក្រុមហ៊ុន ពិភព ដី មាស ស្ថិត ក្នុង ភូមិ ត្រពាំង ថ្លាន់ សង្កាត់ ពន្សាំង ខណ្ឌ ព្រែក ព្នៅ ។
សូម រំលឹក ថា ឧកញ៉ា ហ៉ី គីម ហុង នេះ ក៏ ធ្លាប់ ត្រូវបាន ស្នងការដ្ឋាន នគរបាល ខេត្ដ កំពត ចេញ លិខិត អញ្ជើញ ឲ្យ ចូល ខ្លួន ដើម្បី ធ្វើ ការសាកសួរ ពាក់ព័ន្ធ បណ្ដឹង ប្រជាពលរដ្ឋ ដែល បាន ដាក់ ទុន វិនិយោគ ជាមួយ ក្រុមហ៊ុន នេះ គិត ជា ទឹកប្រាក់ សរុប ប្រមាណ ៦លាន ដុល្លារ ប៉ុន្ដែ ឧកញ៉ា នេះ មិន ចូលខ្លួន នោះ ទេ ហើយ ថែមទាំង ព្យាយាម គេចវេស មិន ទទួលខុសត្រូវ ទៀតផង រហូត សមត្ថកិច្ច ចាប់ខ្លួន ៕ ព្រះមហាក្សត្រ ផ្តល់ គោរមងារ ជា « អ្នក ឧកញ៉ា » ជូន ឧកញ៉ា សុខ វណ្ណា
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ត្រាស់បង្គាប់ ផ្តល់ គោរមងារ « អ្នក ឧកញ៉ា » ជូន ឧកញ៉ា សុខ វណ្ណា ។
ព្រះរាជ ក្រឹត្យ ផ្តល់ គោរមងារ នេះ ត្រូវបាន ធ្វើឡើង ដោយ យោង តាម ការក្រាបបង្គំទូល ថ្វាយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
ក្រសួង ការពារ ជាតិ អាល្លឺម៉ង់ បាន បញ្ជាក់ ក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា ការពន្យារ ពេល បន្ត លើស ចុង ឆ្នាំ ២០២៣ មិន ត្រូវបាន រំពឹងទុក នោះ ទេ ហើយ ប្រព័ន្ធ មីស៉ីល Patriot មួយចំនួន របស់ អាល្លឺម៉ង់ ត្រូវការ សម្រាប់ ប្រើប្រាស់ ដោយ កម្លាំង ប្រតិកម្ម រហ័ស របស់ ណាតូ នៅ ឆ្នាំ ២០២៤ ខណៈ មួយចំនួន ត្រូវ ឆ្លងកាត់ ការត្រួតពិនិត្យ ថែទាំង ឲ ។
