ដើម្បី គ្រប់គ្រង់ ជីវិត អ្នក ឱ្យ ប្រសើរ គួរ ធ្វើ បែប ណា ?
របស់ ខ្លួន ដែល ក្នុង នោះ មិន ថា តែ គ្រឿង អេឡិចត្រូនិច សម្រាប … អាន បន្ត
កំណាព្យ របស់ ស្តេច ដាវីឌ នៅ ពេល ដែល ជនជាតិ ស៊ីភមក ទូល ស្តេច សូល ថា ស្តេច ដាវីឌ នៅ លាក់ ខ្លួន ជាមួយ ពួកគេ ។
មិន ត្រូវ ប្រើ ម៉ាស្ការ៉ា ដែល ធ្វើឱ្យ រោម ភ្នែក ស្អិត ជាប់ គ្នា ជា ដុំ ៗ
ចម្លាក់ ព្រះអង្គ ធំ ប្រាក់ យ៉ៃ ដែល លាប មាស ស្រោប ពី ក្រៅ ។
អាល់ប៊ុម សុទ្ធ របស់ ខ្ញុំ លើក ដំបូង នេះ អាច ចេញ ប្រហែល១ ខែ ទៀត តែ អត់ ទាន់ ច្បាស់ ទេ ។
ទោះជា យ៉ាងណា ភាគ ច្រើន នៃ ពួកយើង គឺ តែងតែ មើល រំលង មិន អើពើ ឡើយ ជាមួយ អ្វី ដែល រាងកាយ ព្យាយាម ប្រាប់ ។
សម្រាប់ នៅ ខេត្ត បន្ទាយមានជ័យ ពលរដ្ឋ ប្រកបរបរ កសិកម្ម និង ចម្ការ តិចតួច ខណៈ ពលរដ្ឋ ជាង ៨០ ភាគរយ ជា កសិករ ។
