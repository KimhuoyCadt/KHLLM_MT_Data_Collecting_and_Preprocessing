ហើយ មនុស្ស សុចរិត នឹង ឃើញ ព្រះភក្ត្រ ព្រះអង្គ ។
លុះ មកដល់ ចំណុច កើត ហេតុ ម៉ូតូ ទាំង ២គ្រឿង ក៏ បុក គ្នា នៅ កណ្តាល ទ្រូងផ្លូវ ចំ ពីមុខ ពេញ ទំហឹង រួច ខ្ទាត មក ចិញ្ចើមផ្លូវ ។
ជាទូទៅ ប្រជាពលរដ្ឋ រស់ នៅ តំបន់ នោះ មិន សូវ ហ៊ាន និយាយ ពី បញ្ហា ព្រំដែន ឡើយ ហើយ បើ និយាយ ក៏ សុំ លាក់ អត្តសញ្ញាណ ដែរ ។
យើង មាន រដ្ឋធម្មនុញ្ញ របស់ យើង ដូច្នេះ មាន តែ ការអង្គុយ ចុះ ដើម្បី ពិភាក្សា គ្នា ប៉ុណ្ណោះ … ។
ព្រោះ ឥឡូវនេះ យើង ម្ខាង ៗ
ព្រះរាជា ក៏ តាំង មន្ត្រី នោះ ឱ្យ ធ្វើជា ចៅហ្វាយ ស្រុក រក្សា ខេត្ត នោះ ត ទៅ ។
ប៉ុន្តែ អារម្មណ៍ ជាតិនិយម ក្នុង ក្រុម ផ្ទាល់ គឺ រឹងមាំ និង ពិតប្រាកដ ។
ខ្ញុំ ពិតជា ទទួលស្គាល់ ថា ខ្ញុំ មាន កំហុស មែន ។
បុរស ដែល ស្លាប់ ជា មនុស្ស អាណា ដែល គេ សង្កេត បុរស រូប នេះ ពុំ មាន សាច់ញាតិ អ្វី ទាំងអស់ ។
អ្នកស្រី បាន មានប្រសាសន៍ ថា ដរាបណា នៅតែ គ្មាន អ្វី ឱ្យ ពួកគេ ធ្វើ នៅ ទីនេះ ដរាប នោះ ស្ត្រី ក្មេង ៗ
ការ ដែល យល់ព្រមទាំងអស់ នេះ ប្រហែលជា យល់ព្រម តាំងពី ខែ៤មក ម្ល៉េះ មុន បុណ្យ ចូល ឆ្នាំ ម្ល៉េះ ។
គ្នា ក្នុង ពេល ធ្វើដំណើរ ។
ខ្ញុំ បាត់បង់ សតិសម្បជញ្ញៈ ដោយ ហេតុ ថា ខ្ញុំ ចង់បាន តែ ប្រាក់ ។
ប្រហែលជា ខ្ញុំ គ្មាន អ្វី នឹង សរសេរ ហើយ … បន្ត ការអាន
ឪពុក ខ្ញុំ ជា ជនជាតិ បារាំង ហើយ ម្តាយ ខ្ញុំ ជា ជនជាតិ អ៊ីតាលី ។
មិន តវ៉ា អ៊ីចឹង យើង ត្រូវ អត់ ។
ខាងក្រោម នេះ គឺជា វិធី បង្ការ ការភើរ ដែល យើង គ្រប់ គ្នា អាច ធ្វើ បាន ដោយ ខ្លួន ឯង ៖
កាលពី ថ្ងៃពុធ នេះ បើ តាម វិទ្យា
ប្រញ៉ាប់ ឡើង កុំ អោយ ឱកាស ដ៏ ល្អ នេះ កន្លងហួស ឱ្យ សោះ ៕
ព្រះទ្រង់ ក៏ បាន ឮ គាត់ អធិស្ឋាន ហើយក៏ បាន ឱ្យ សត្វ ត្រី ដោះលែង គាត់ ។
នៅ វេលា ដែល ទ្រង់ បាន យាង កាត់ ទី ហោស្ថាន
ដ៏ រាបណា ការសហការ នៅតែ មាន កម្រិត ដូច ឥឡូវនេះ បេសកកម្ម នៃ ការការពារ ព្រៃ របស់ យើង នៅតែ បរាជ័យ ដដែល ។
ចុះឈ្មោះ ពី ថ្ងៃទី ៤កុម្ភៈ ដល់ ថ្ងៃទី ២មីនា
តោះ ត្រៀម បោះឆ្នោត ខ្មែរ អើយ កុំ ឆោត រើស ក្រុមប្រឹក្សា
ដែល មាន សព្វ ថ្ងៃ ក៏ មាន ចែំណក ចូលរួម របស់ សហរដ្ឋ អាមេរិក ផងដែរ ។
អាន ហើយ ចង់ ស្រក់ ទឹកភ្នែក ព្រោះ នឹក ទៅដល់ អ្នកម្តាយ ខ្ញុម ។
បញ្ហា នេះ តើ អ្នកណា ទទួលខុសត្រូវ មាន អ្នក ចុះ ជួយ អន្តរាគមន៍ ឬ អត់ ៖
លោក ជា ន ចាន់ រ៉ា និង កូនប្រុស
ជាមួយនឹង ការអនុវត្ត បន្តិចបន្តួច នេះ អ្នក នឹង អាច ឈានដល់ ចំនុច កំពូល ជា មិន ខាន ឡើយ ។
ទោះជា យ៉ាងណា ក្តី ក្រុម អ្នកតវ៉ា បាន ទៅ ស្វែងរក ការអន្តរាគមន៍ នៅ សាលាក្រុង ប៉ោយប៉ែត បន្ត ទៀត ។
ខណៈពេលនេះ អ្វី ៗ
កុមារ ប្រាំ នាក់ ស្ថិត ក្នុង ចំណោម អ្នកស្លាប់ ។
ប្រសិនបើ វា មាន ពណ៌ លឿង មាន ន័យ ថា វា កំពុងតែ ដំណើរការ ហើយ ។
លើ ជនជាតិ ភាគ តិច ជា បន្តបន្ទាប់ ។
ឪពុក ចាន់ វឌ្ឍនាកា ត្រូវ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ផ្ទេរ ទៅកាន់ ក្របខណ្ឌ ដើម វិញ
បាតុកម្ម នេះ បាន ត្រូវ បញ្ចប់ នៅក្នុង សោកនាដកម្ម ។
គ្នា ពី មូលហេតុ ដើម ចម ដែល ធ្វើអោយ គ្រួសារ របស់ ឈានដល់ ផ្លូវ បំបែក ។
តាំងពី ដើម រៀង មក ប្រជាជន នៅ ក្រុង នេះ តែងតែ បង្កអោយ មាន ចលនា បះបោរ ជានិច្ច ។
អញ្ជើញ មក អាយ ឈប់ និយាយ គ្នា លេង បន្តិច សិន ។
ចំណាត់ ក្រុម កំនត់ ហេតុ ខ្ញុំ ពី នេះ ពី នោះ
ចូរ ស្វែងរក ការព្យាបាល អោយ បាន លឿន ប្រសិនបើ អ្នក មាន បញ្ហា អស់ ទាំងនេះ ទោះបីជា អ្នក ពុំ ធ្លាប់ មាន ជំងឺ បេះដូង ឬ សួត ពីមុន មក ក៏ដោយ ។
ខាងក្រោម នេះ គឺជា អត្តចរិក របស់ មនុស្ស ដែល មិន មាន ឱកាស ច្រើន ក្នុង ការឡើង តំណែង ៖
យ៉ាងណាមិញ ម្ជុរ នេះ ត្រូវបាន គ្រូពេទ្យ ធ្វើ ការវះកាត់ ដក ចេញ ជាបន្ទាន់ រួចហើយ ។
ការជឿ ចុះ ស៊ប់ ដោត ជាប់ ទៅក្នុង ព្រះពុទ្ធ ដែល ព្រះអង្គ ជា បុគ្គល គំរូ នៃ មនុស្ស និង ទេវតា ។
នៅ ឆ្នាំ ក្រោយ លោក នឹង ត្រូវ ដោះលែង ពី ពន្ធនាគារ ។
គ្មាន អ្នកណា គិត អីចឹង ទេ ។
តោះ ទៅ មើល បន្តិច ទៅ មើល គួរឱ្យ ចាប់អារម្មណ៍ ប៉ុណ្ណា ដែរ ទៅ ៖
ជាមួយគ្នា នេះ សម្តេច ក៏ ស្នើ ឱ្យ អ្នកសារព័ត៌មាន ទាំងនោះ ត្រូវ កែ ខ្លួន ឡើងវិញ ផងដែរ ៕
លោក នាយក រដ្ឋមន្ត្រី បាន ប្រកាស លទ្ធផល នៃ ការពិនិត្យ ឡើងវិញ នេះ កាលពី ថ្ងៃព្រហស្បតិ៍ ហើយ បាន សន្យា ថា ដី ១លាន ហិកតា ដែល ដកហូត នឹង ត្រូវ បែងចែក ជាថ្មី ឱ្យ គ្រួសារ ក្រីក្រ បំផុត នៅ ប្រទេស កម្ពុជា ។
ពេលនេះ ប្រជាពលរដ្ឋ ភ័យខ្លាច សន្តិខុស ផង ។
ចូរ ឆ្លើយ សំណួរ នេះ ។
មាន ការលើកឡើង ថា មិន គួរឱ្យ ជឿ ថា ស្រី ស្អាត សិចស៊ី ទាន់ សម័យ ដូចជា ម៉ារី បែរ
ហើយ កុំ ភ្លេច ត្រៀម ទុក នៅក្នុង ទូទឹកកក គ្រប់ ពេលវេលា ។
យើង បាន ធ្វើការ ជាមួយគ្នា រយៈពេល ជាង ១០ឆ្នាំ ។
កម្ពុជា គ្មាន កន្លែង សម្រាប់ ឧទ្ទាម ក្រៅ ច្បាប់ ទេ !
ដោយសារ ព្រះពិរោធ របស់ ព្រះអង្គ
គាត់ ត្រូវបាន អ្នកផង គោរព !
ខ្ញុំ កំពុង ទន្ទឹងរង់ចាំ ការឆ្លើយតប ពី រដ្ឋាភិបាល សហព័ន្ធ ៕
ចំណុច ទី ពីរ នោះ គឺ លោក ម៉ាក្រុង មិន មាន បទពិសោធន៍ អ្វី ទេ ក្នុង កិច្ចការ នយោបាយ អន្តរជាតិ ។
ទាំងនោះ គឺ ក្នុង ផលប្រយោជន៍ របស់ ប្រទេស ទាំង២ និង ប្រជាជន ទាំង២៕
សកម្មជន និង អ្នកការពារ សិទ្ធ ម ន៉ិស្ស មួយចំនួន ត្រូវបាន ឃាត់ខ្លួន
ស្ថានភាពអាពាហ៍ពិពាហ៍ មិន បាន រៀបការ ។
ទៀត ដែល ប្រើប្រាស់ សម្រាប់ រៀបចំ គោល នយោបាយ ។
មនុស្ស ចំនួន ១០ ផងដែរ បាន បាត់ខ្លួន នៅក្នុង ហេតុការណ៍ ដ៍ រន្ធត់ នេះ ។
គឺ ពិតជា អស្ចារ្យ ណាស់ ដែល ព្រះដ៏ ជា អ្នកនិពន្ធ ព្រះគម្ពីរ បាន បង្ហាញ យើង ឱ្យ ស្គាល់ ភាពអស្ចារ្យ នៃ ព្រះបន្ទូល ទ្រង់ ។
បើ ប្តី ខ្ញុំ បាន ប្រព្រឹត្ត ក៏ មិន តាម ដែរ ។
នៅ ឆ្នាំ នេះ គេ សង្កេតឃើញ មាន តង់ លក់
បើ ទោះបីជា វិស័យ នេះ មាន ការរីកចម្រើន ជារៀងរាល់ ឆ្នាំ ក្តី ប៉ុន្តែ យើង សង្កេតឃើញ ថា ការរីកចម្រើន នោះ ចេះតែ ថយ ទៅ ៗ
ហួសចិត្ត ទើប ចុះ ពី កុងតឺន័រ ក្តៅ ៗ
ភិក្ខុ ទាំងឡាយ ក្រាប ទូល ដំណើរ នុ៎ះ ចំពោះ ព្រះ ដ៏ មាន ព្រះភាគ ។
ដោយឡែក នា ថ្មី ៗ
ប៉ាសើច ហើយ ជួយ អួត ខ្ញុំ ៖
ប្រហែលជា ដឹងខ្លួន មិន ឈ្នះ ក្តី ទើប បាន
ទាំងអស់ នឹកស្មាន មិន ដល់ តែ ម្តាយ នៅតែ ញញឹម រង់ចាំ មើល មុខ កូន នៅ ថ្ងៃ មួយ ។
តាម ការស្ទាបស្ទង់ មតិ ទាំង ពេលនេះ ក៏ ដូចជា ពេល មុន ៗ
ទៀត នៅ ទ្រឹង ឬ មាន ការពង្រីក តិចតួច ចាប់តាំងពី ឆ្នាំ ២០០៧មក ។
បច្ចេកវិទ្យា នេះ ត្រូវ តំឡើង ទៅក្នុង ពិដាន ។
សត្វ នៅ ឆ្ងាយ ៗ
ហើយក៏ មិន ដើរ នៅក្នុង មាគ៌ា នៃ ពន្លឺ ដែរ ។
បន្ទាប់មក ទៀត ខ្ញុំ បាន ទៅ បេសកកម្ម ផ្លូវការ នៅ ប្រទេស ថៃ និង ប្រទេស ហ្វីលីពីន រយៈពេល មួយ ខែ នៅក្នុង ឆ្នាំ ១៩៩៣ ។
យើង នឹង ធ្វើជា គំរូល្អ សម្រាប់ កូន ចៅ កូនក្មួយ យើង ទៅ ថ្ងៃ មុខ ។
ហើយ ទី ពីរ តាម គណិតសាស្ត្រ គឺ ថា លទ្ធផល នៃ ការបោះឆ្នោត
ប៉ុន្តែ គួរ ឱ្យ ស្តាយ គឺ ក្រសួង សំខាន់ ៗ
ពួកគេ ជា មនុស្ស ចូលចិត្ត ភាព សប្បាយរីករាយ ពី កំណើត ។
បាន ឱដឹង ថា ជនរង មុខរបរ ជាជាង
រីឯ នៅ ទីនេះ មាន ម្នាក់ ប្រសើរ លើស ស្តេច សាឡូម៉ូន ទៅ ទៀត ។
ឈឺចាប់ ឬ ហូរ ឈាម
កុំ ចេះតែ ហ៊ាន ទោះបី ស្គាល់ ប្រវត្តិ ច្បាស់ ក៏ដោយ
ដូចនេះ តើ មាន វិធី យ៉ាងណា ដើម្បីឱ្យ លោក អ្នក អាច ធ្វើ ការងារ ជាមួយនិង មនុស្ស ដែល លោក អ្នក ស្អប់ បាន ?
ខ្ញុំ គិត ថា សម្រាប់ អភិបាលកិច្ច យើង ទទួលស្គាល់ ថា មាន ការងារ ខ្លះ ត្រូវ ធ្វើ បន្ថែម ។
កាលពី ឆ្នាំ ទៅ មិញ មនុស្ស ២៣៥ នាក់ ស្លាប់ ដោយសារ គ្រោះមហន្តរាយ ធម្មជាតិ នៅ វៀតណាម ៕
១០ខ្លាច មិន ដូច មាត់ សាសា
ខ្ញុំ ចូលចិត្ត ចង់ ដឹង ចង ឮ ពី ដំណើរ រឿង ដែល មាន រូបចម្លាក់ បង្ហាញ លើ ជញ្ជាំង ប្រាសាទ នានា ។
នាង និយាយ ទៅកាន់ គាត់ ថា
មិន ធម្មតា ទេ បង្គោល ខៀវ ធ្វើឱ្យ សិស្ស សំណព្វ អេ…
៣ប្រកួត ប៉ះ គ្នា ចុងក្រោយ វ៉ាន់ វឿន សន្លប់ របស់ បឺតសង្ឃឹម តែម្តង ៕
ដែល ព្រះជាម្ចាស់ បាន ត្រាស់ហៅ ឱ្យ ខ្ញុំ ធ្វើ ។
ក្រៅពី នេះ យើង ក៏ អាច ហែលទឹក កម្សាន្ត ដើម្បីឱ្យ មាន អារម្មណ៍ ស្រស់ស្រាយ ផងដែរ ។
១៤រីឯ ទូលបង្គំ វិញ ទូលបង្គំ នៅតែ មាន សង្ឃឹម ជានិច្ច
គាំទ្រ ចំពោះ កម្ពុជា ទាំងស្រុង ។
ដូច្នេះ វា បណ្តាលឱ្យ និស្សិត មិន មាន ពេលវេលា ច្រើន ដើម្បី ឆ្លៀត ជួប ជាមួយនឹង គ្រូបង្រៀន ពិភាក្សា ក្រៅ ម៉ោង បង្រៀន ។
ខ្ញុំ កំពុង និយាយ ពី សំណង់ ធំ ៗ
ទាំងអស់ ដោយ ចាយ លុយ របស់ ខ្ញុំ ។
ឃាត់ ជនសង្ស័យ ៤នាក់ ករណី ចាត់ចែង ឱ្យ ប្រើប្រាស់ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន
ក្រៅពី ព្រះជា ម្ចាស់ មួយ ព្រះអង្គ គ្មាន នរណា ម្នាក់ សប្បុរស ឡើយ ។
ប្រហែល២ ម៉ោង សូរ ពេញ បន្ទុក មុនពេល ប្រើ ដំបូង ។
ពីរ ទសវត្សរ៍ កន្លងទៅ នេះ ប្រទ សេកម្ព ជុា បាន បោះជំហាន
កូន គឺជា ចំណង សុភមង្គល នៃ ជីវិត គូ ស្វាមី ភរិយា ឱ្យ កាន់តែ រឹងមាំ ។
លើកទឹកចិត្ត ឱ្យ អ្នកជំងឺ បញ្ចេញ អារម្មណ៍ សោក សៅ របស់ គេ ដូចជា បើ នៅពេល គេ យំ ត្រូវ ទុក ឱ្យ គេ យំ ឱ្យ អស់ចិត្ត ។
ខ្ញុំ ចង់ ទៅ ដែរ
ក្នុង ឆ្នាំ ១៩៧៧ ប្រពន្ធ របស់ ឌុច បាន ផ្តល់ កំណើត ឱ្យ កូនស្រី ទី១ របស់ ពួកគាត់ ។
បន្ទាប់មក កូរ ជាមួយ ពង មាន់ យក ផ្នែក ស ៗ
ជាធម្មតា ក្មេង ទាំង នេះ នឹង ត្រូវ ស្នាក់ នៅ ជាមួយ គ្រូបង្វឹក ឪពុក ម្តាយ របស់ ពួកគេ ជា គ្រូបង្វឹក របស់ ពួកគេ ។
ហើយ ពលរដ្ឋ ចង់បាន ឬ មិន ចង់បាន មិន មែន សម្រេច លើ ពលរដ្ឋ ពួក គាត់ ទេ ព្រោះ នេះ ជា ការសម្រេច របស់ រាជ រដ្ឋាភិបាល ៕
ដែល អ្នក មិន ចាំបាច់ ចូលទៅ បើក កម្មវិធី នោះ ផ្ទាល់ ទេ ។
ដំណឹង ល្អ លោក ឃួង ស្រេង ប្រកាស ឱ្យ បើក ផ្សារ រដ្ឋ វិញ ហើយ ចាប់ពី ថ្ងៃ នេះ តទៅ
តែ ចុងក្រោយ នាង មិន បាន អ្វី ទាល់តែសោះ ។
ការអង្គុយ នៅមុខ កញ្ចក់ មិន មែន ជា របៀប ដែល ខ្ញុំ រស់នៅ ក្នុង ជីវិត របស់ ខ្ញុំ ទេ ។
អញ្ចឹង ទេ ពាក់ព័ន្ធ នឹង រឿង ផ្ទាល់ខ្លួនខ្ញុំ យល់ ថា ពិបាក ក្នុង ការជួបគ្នា ។
ខាងក្រោម នេះ ជា វិធីសាស្ត្រ ខ្លី ៗ
រយៈពេល វែង ប្រសិនបើ អ្នក ជា មនុស្ស ម្នាក់ ក្នុង ចំណោម អ្នក ទាំងនោះ ដែល ចង់ យក អ្វី យឺត ៗ
ដើមទ្រូង របស់ ស្ត្រី ស្រដៀង ទៅនឹង ហ្វូង តារា ដែល តំណាង ឱ្យ មនុស្ស យើង ម្នាក់ ៗ
មាន នៅក្នុង ផ្នែក ទី២ ប្រធានបទ ទី២ក្នុង សៀវភៅ មគ្គុទេសក៍ ។
ដទៃ ទៀត នៅក្នុង ផ្នែក រូបវិទ្យា ។
ឯ ស្ត្រី រួម ដំណើរ ជាមួយ រងរបួស ធ្ងន់ធ្ងរ នោះ ។
ករណី គ្រោះថ្នាក់ ចរាចរ ណ៏ …
ធ្វើ គ្រប់ បែបយ៉ាង អោយ តែ ខ្លួន បាន ឈ្នោះ ខ្លួន បាន រួច ខ្លួន ។
ប៉ុន្តែ សឺន ង៉ុក ថាញ់ មិន មែន ជា មនុស្ស កុម្មុយនិស្ត ទេ ។
ប្រហុកចិញ្ច្រាំ គ្រឿង នេះ រាល់ ពេល ធ្វើ ខ្ញុ … បន្ត ការអាន
ចុះ ឃាតក អន្តរជាតិ គឺ សហរដ្ឋ អាមេរិក វិញ បែរជា ពុំ ដែល ត្រូវបាន កាត់ទោស ដោយ ជន ណា ម្នាក់ ឡើយ ?
ប្រធានាធិបតី បាត់បង់ តំណែង ៕
លោក កែ គឹម យ៉ាន មិន អាច ទាក់ទង សុំ អធិប្បាយ បាន ទេ កាលពី ម្សិលមិញ ។
ប៉ុន្តែ ក្នុង ពេល នោះ គ្មាន អ្នកណា ហ៊ាន បញ្ចេញ អត្តសញ្ញាណ របស់ ស្វាមី អ្នកនាង ឡើយ ដោយ ក្រុម អ្នកកាសែត បាន ត្រឹមតែ សរសើរ បែប បញ្ឆិត បញ្ឆៀង ប៉ុណ្ណោះ ។
តំបន់ របស់ យើង មាន ធនធាន ធម្មជាតិ ដ៏ ធំ សម្បើម ។
មវ រំមត ស្ូប ស្ម្មត ។
យក ប្រេង ដូង ផលិត ជា សាប៊ូ និង ផលិតផល ផ្សេង ៗ
លោក វីរៈ និយាយ ថា នេះ គឺជា ការផ្លាស់ប្តូរ មួយ ដែល លោក បាន រំពឹងទុក ។
ពួកគេ សំដែង ការអាណិតអាសូរ និង សំរាល ទុក្ខ លោក ព្រោះតែ ទុក្ខវេទនា ទាំង ប៉ុន្មាន ដែល ព្រះអម្ចាស់ បាន បណ្តាល អោយ កើតមាន ដល់ លោក ។
លទ្ធផល ថ្ងៃ នេះ ពុំ ធ្វើឱ្យ ខ្ញុំ ខក បំណង ទេ ។
បាត់ ក្តី សប្បាយ ក្នុង ជីវិត !
តើ ឱកាស នៃ ការផ្សះផ្សា មាន អ្វី ខ្លះ បន្ទាប់ពី ការ ប្រេះឆារ និង អំពើហិង្សា ដូចនេះ ?
ការឈឺ បំពង់ក ធ្វើឱ្យ អ្នក ពិបាក និយាយ ។
យ៉ាងណាមិញ សាវ័ក ប៉ុល ក៏ ធ្លាប់ បាន ស្គាល់ ការផ្លាស់ ប្រែ ដ៏ ជ្រាលជ្រៅ ប្រភេទ នេះ ផងដែរ ។
លោក បន្ត ថា យើង បាន ដកស្រង់ បទពិសោធន៍ ល្អ ៗ
តួអង្គ សម្តែង រឿង រន្ធត់ និង ជីវិត នៅ ខាងក្រៅ ប្លែក ៗ
ចាប់អារម្មណ៍ យ៉ាង ខ្លាំង ។
ទោះបីជា មាន គ្រោះថ្នាក់ បែប នេះ ក្តី ក៏ ការហោះហើរ បង្ហាញ របស់ យន្តហោះ ទាំងឡាយ នៅ បន្ត ទៀត ក្នុង ពិព័រណ៍ នេះ ៕
ធ្លាប់ តែ ឃើញ ស្រី ៗ
មាន ការពិបាក បរិភោគ ជាខ្លាំង ។
ផ្លូវ ធម៌ ក្តី ក៏ បានជា អ្នកប្រាជ្ញ ដូចគ្នា ។
