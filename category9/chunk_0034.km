របប អាហារ គឺជា រឿង មួយ ផ្សេង ទៀត ដែល អ្នក គួរ ពិចារណា ដើម្បី បំបាត់ ក្លិន ក្លៀក ។
ព្រមទាំង របៀប ប្រើប្រាស់ ជី សរីរាង្គ លើ ប្រភេទ ដំណាំ ទាំងនោះ ។
ទាំង រុស្ស៊ី និង អ៊ីរ៉ង់ បាន បញ្ជូន ទាហាន ទៅកាន់ ស៊ីរី ដើម្បី គាំទ្រ របប គ្រប់គ្រង របស់ ប្រធានាធិបតី អាសាត ប្រឆាំង នឹង ពួក ឧទ្ទាម ប្រឆាំង ៕
ជាពិសេស អូន ត្រូវ សង្កេតមើល ឫកពារ របស់ បង និង របស់ នារី ណា
ខ្ញុំ គេចខ្លួន ដែរ ហ្នឹង បើសិន នៅ ហ្នឹង អាច ប្រហារជីវិត ខ្ញុំ ហើយ មើល ទៅ ។
ប៉ុន្តែ គេ នឹង ត្រូវ វិនាស អន្តរាយ រហូតត ទៅ ។
គ្រាន់តែ ផ្តល់ ព័ត៌មាន ត្រឹមត្រូវ ជាក់ច្បាស់ តាម ការសួរ របស់ មន្ត្រី ជំរឿន ដូចជា ខុស ទាស់ អ្វី ទេ ។
ណាមួយ គឺ អ្នក ផ្ទះ ហ្នឹង ព្រួយបារម្ភ ខ្លាំង គាត់ ខល ឱ្យ ខ្ញុំ ហ្នឹង ត្រឡប់មក ផ្ទះ វិញ ។
បើ យើង ចង់បាន សេចក្តីសុខ យើង ទាំងអស់ គ្នា ត្រូវ ចម្លង គុណធម៌ ពី ព្រះមហាក្សត្រ ។
ស ម្មោហ វិនោទនី គឺជា អដ្ឋក ថា គម្ពីរ វិភង្គប្បករណ៍ ។
នាង ថា លោក ស្វាយស៊ី ថា បាន មាន ទំនាក់ទំនង ជាមួយ នាង តាំងពី នាង នៅជា កុមារី អាយុ ១៤ ឆ្នាំ គឺ តាំងពី ឆ្នាំ ១៩៩៨មក ម្ល៉េះ ។
លោក ផៃ ស៊ីផាន ថ្លែង នា ពេល កន្លងមក
មាន ការកើឡើង ដូចគ្នា នេះ ដែរ ។
ខ្លួន ដើម្បី ធ្វើអោយ ខ្លួន របស់ គេ មើល ទៅកាន់តែ មាន ភាពលេចធ្លោ និង ទាក់ទាញ ផងដែរ ។
លោក បាន អះអាង បន្ថែម នៅលើ គណនី ហ្វេសប៊ុក របស់ ខ្លួន នា ថ្ងៃទី ៤មិថុនា ដូច្នេះ ៖
លោកស្រី បាន បន្ថែម ទៀត ថា ការបង្កើត បាន រោងចក្រ សហគ្រាស នៅ តាម គ្រប់ ទីកន្លែង ដែល បាន ដោះស្រាយ ការងារ ឱ្យ ក្មួយ ៗ
កើតឡើង សុទ្ធតែ មាន ហេតុផល របស់ វា ។
ហេតុ អ្វី បានជា ហៅ ឈ្មោះ បាត់ដំបង ។
ទើស លុះ ក្ស័យ ហើយ ធ្វើ ចឹង បាន ប្រាក់ខែ អត់ ។
ដូច្នេះ ជ័យ ជំនះ របស់ ឌុច នេះ ហើយ ដែល
ដូច្នេះ វិធី ដែល ល្អ បំផុត អស់ លោក ត្រូវ ពន្លត់ ភ្លើង ចោល ទៅ ។
លិច ផ្ទុះ និង បាន សម្លាប់ មនុស្ស អស់ ជាច្រើន ។
ការដើរ តាម ព្រះយេស៊ូវ មិន គ្រាន់តែ ជា ការចាប់ផ្តើម ជីវិត ថ្មី ទេ …
រហូតដល់ ស្រឡាញ់ គ្នា មែនទែន តែម្តង ។
ស្វាមី ដែល ល្អ ត្រូវ ចេះ ធ្វើ ថ្លង់ ហើយ ភរិយា ល្អ ត្រូវ ចេះ ធ្វើ ខ្វាក់
១ បើសិនជា ខ្ញុំ អាច មើលឃើញ បាន វែងឆ្ងាយ នេះ ក៏ ដោយសារតែ ខ្ញុំ បាន ឈរ នៅលើ ស្មា របស់ យក្ស នេះ ឯង ។
តាម ប្រសាសន៍ លោក អាចារ្យ វត្ត បាន ឱ្យដឹង ថា ៖
ភាគ ច្រើន ចេះ គិតគូរ ហើយ មិន ប្រព្រឹត្ត អ្វី ដែល ផ្ទុយ នឹង ប្រពៃណី ខ្មែរ ឡើយ ។
ជំងឺ ធ្លាក់ទឹកចិត្ត អំឡុង ពេល មាន ផ្ទៃពោះ អាច បង្កើន ហានិភ័យ នៃ បញ្ហា ផ្លូវចិត្ត ចំពោះ ក្មេង
នឹង រ៉ាយរ៉ាប់ បាន ។
ការសម្រេច កាម របស់ មនុស្ស ស្រី អាច ជា រឿង មួយ ពិបាក ពណ៌នា ណាស់ តែ តាមពិត ទៅ វា មិន ចាំបាច់ ឡើយ ។
ប្រធានាធិបតី អាមេរិក រូប នេះ បាន បន្ថែម ទៀត ថា គាត់ លោក ស៊ី ស្រឡាញ់ ប្រទេស ចិន ។
ជា ការណ៍ ពិត ណាស់ ប្រទេស នានា ពិតជា ត្រូវការ ថាមពល បន្ថែម ទៀត មែន ប៉ុន្តែ ពួកគេ ក៏ ចាំបាច់ ត្រូវ ការពារ ធនធាន ធម្មជាតិ ដ៏ មាន តម្លៃ ផងដែរ ។
យ៉ាងណាមិញ គ្មាន នរណា ម្នាក់ ប្រាកដ ថា ហេតុ អ្វី បានជា មាន ដើមឈើ ទាំង នេះ មាន រាង កោង ដូច្នេះ ទេ ។
ទឹកឃ្មុំ ព្រៃ មណ្ឌលគិរី និង អំបុក កំពង់ធំ នឹង សម្ពោធ ក្នុង ឆ្នាំ នេះ
ហេតុការណ៍ គ្រោះថ្នាក់ កើតឡើង ជា យថាហេតុ នៅ ចំការទុរេន !
ជាក់ស្តែង នៅក្នុង ខែវិច្ឆិការ ឆ្នាំ ២០២០ ថ្មី ៗ
បាតុកម្ម នេះ គឺ ធ្វើ ដោយ សាធារណជន ខ្លួន ឯង ។
អ្នកប្រព្រឹត្ត មិន ត្រូវបាន ផ្តន្ទាទោស នៅឡើយ ទេ ។
កូន អើយ ស្តាប់ សិន ដោយ លោក ម្ចាស់ ប៊ុន ចាន់ សុខេន
ការសិក្សា ក៏ បាន បង្ហាញ ផងដែរ ថា ការទទួលទាន កាល់ស្យូម គ្រប់គ្រាន់ អាច បណ្តាលឱ្យ មានៈ
ថ្ម ទាំង នេះ ជា ទី រំលឹក សំរាប់ ជនជាតិ អ៊ីស្រាអែល រហូតត ទៅ ។
ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ដកហូត ថ្នាំ ញៀន ១៤ កូន ថង់
ក្នុង ឱកាស នោះ គេ ក៏ នឹង ពន្យល់ បណ្តា អង្គ ទូត ទាំងអស់ ពី ប្រើ ច្បាប់ អាជ្ញា សឹក ផងដែរ ។
លោក ម៉ា បាន និយាយ ថា ការងារ របស់ គាត់ គឺ ប្រធាន មន្ត្រី អប់រំ ខណៈ ដែល គាត់ បាន ចូលរួម ក្នុង ការអប់រំ អតិថិជន និង មន្ត្រី រដ្ឋការ ហើយ ព្យាយាម បញ្ចុះបញ្ចូល ពួកគេ ឱ្យ បន្ត តាមដាន រាល់ ការអភិវឌ្ឍ នៃ បច្ចេកវិជ្ជា ។
ធ្វើ ប្រតិបត្តិការ ធនាគារ ដោយ ខ្លួន ឯង និង ចំណេញ ពេល វេលា ។
សូម ក្រោកឈរ ឡើង កាល ខ្ញុំ អាន អេភេសូរ ៦១២ ។
ច្បាប់ គេ បង្កើត មក ដើម្បី ការពារ មនុស្ស ប៉ុន្តែ ពួកយើង ជា មនុស្ស ដែរ ហេតុ អ្វី ច្បាប់ មិន ការពារ ពួកយើង ?
ពិសាវា រាល់ ព្រឹក ហើយ រង់ចាំ មើល ជាតិ ខ្លាញ់ នឹង បាត់ ដោយ មិន ដឹងខ្លួន !
លោក ចាន់ សុវេត នឹង វិល មកពី ក្រៅ ប្រទេស វិញ ថ្ងៃស្អែក
បុព្វបទ នៃ ពាក្យ នេះ នឹង មាន ។
ត្រឹមត្រូវ លោក នរក សម រង្សី ព្រោះ អី ជប៉ុន គេ មើលឃើញ រដ្ថាភិបាល ថ្ម ល្អ ទទួីល យក បាន
សៀវភៅ គណនី ឬ ថតចម្លង របាយការណ៍ ធនាគារ រយៈពេល ០៣ ខែ ចុងក្រោយ ប្រសិនបើ មាន
ខ្ញុំ ក៏ ទន្ទឹងរង់ចាំ ធ្វើការ ជាមួយ លោក ដើម្បី ពង្រឹង ចំណង មិត្តភាព រវាង ប្រទេស យ៉ាង ទាំង ពីរ ៕
តាំងពី ពេល នោះ មក ខ្ញុំ សប្បាយ ចិត្ត គ្មាន អ្វី ប្រៀប បាន ។
ព្រះជា ម្ចាស់ បម្រុងទុក មត៌ក នេះ អោយ បងប្អូន នៅ ស្ថាន បរម សុខ ៥ហើយ ឫ ទ្ធានុភាព របស់ ព្រះអង្គ ថែរក្សា បងប្អូន ដោយសារ ជំនឿ ដើម្បី អោយ បងប្អូន ទទួល ការសង្គ្រោះ ដែល ព្រះអង្គ បាន រៀបចំ ទុក ជាស្រេច ហើយ ដែល ទ្រង់ នឹង សំដែង នៅ គ្រា ចុងក្រោយ បំផុត ។
ចុះ ប្រិយមិត្ត វិញ ក្រៅពី សន្សំ លុយ ក្នុង ធនាគារ មាន សន្សំ លុយ តាម វិធី ណា ខ្លះ ?
រឿង ទេពធីតា កណ្តុរស មិន ទាន់ បញ្ចាំង
រាល់គ្នា ត្រូវតែ តាមដាន រាល់ ទង្វើ របស់ ពួកវា !
គួរ បញ្ជាក់ ថា នៅ កន្លែង នេះ អ្នក នឹង មិន អាច នោម ចេញ បាន ឡើយ ក្នុង ពេល ប្រតិបត្តិ រួមភេទ ។
ពៅ តារា លក់ ទូរសព្ទ័ ដៃ
ទោះ ប្រឹង អាន គ្មាន អ្វី ថ្មី ស្តាប់ តន្ត្រី ប្រសើរ ជាង ។
បើ បែប នេះ មែន ទីផ្សារ អន្តរជាតិ ទាំងមូល នឹង ត្រូវ ប្រែប្រួល ហើយ សេដ្ឋកិច្ច ពិភពលោក ក៏ ប្រែប្រួល ។
លោក មិន បាន ចោល ខ្ញុំ ឱ្យ នៅតែ ម្នាក់ឯង ទេ ពីព្រោះ ខ្ញុំ តែងតែ ធ្វើ អ្វី ដែល លោក ពេញចិត្ត ។
ឯង ក៏ ព្រោះតែ មិន បាន ឃើញ នូវ អរិយសច្ច ទាំង ៤តាមពិត ។
មាន បំណងប្រាថ្នា ចង់ ជួន ពរ អោយ បង្ហាញ នូវ ចំណង់
កន្លងមក ក្រោយពេល ទទួល ព័ត៌មាន ថា មាន គេ លួច កាប់ ព្រៃ ចំណុច កើត ហេតុ អាជ្ញាធរ បាន សហការ ជាមួយ ជំនាញ បរិស្ថាន ចុះ ទៅ ប៉ុន្តែ ជន ទុច្ចរិត តែងតែ រត់ ឡើង ភ្នំ អស់ និង ប្តូរ រូបភាព លួច កាប់ ពេល យប់ វិញ ។
ការិយាល័យ ប្រធានាធិបតី វៀតណាម បាន បញ្ជាក់ ថា នេះ ជា ការលើកលែង ទោស លើក ទី១ នៅក្នុង រយៈពេល ៤ ឆ្នាំ ហើយ អ្នកទោស នឹង ត្រូវ ដោះលែង នៅ ថ្ងៃពុធ នេះ ។
ទូលបង្គំ ស្អប់ ការអាក្រក់ គ្រប់ យ៉ាង ។
ខ្ញុំ ដាច់ចិត្ត ឆ្លើយ ទាំង រំភើប ៖
ដោយសារ យើងខ្ញុំ បាន លើកឡើង ពី ចំណុច ទាំងនោះ រួចហើយ ឥឡូវ យើងខ្ញុំ គិត ថា យើងខ្ញុំ អាច ឆ្លើយ សំណួរ នោះ ។
គ្រោងការណ៍ សាងសង់ នេះ នឹង បញ្ចប់ អំឡុង ពេល ១ សប្តាហ៍ ទៀត ។
ក្រសួង ការបរទេស ក៏ ត្រូវបាន គេ ចាប់ បាន ផងដែរ ការចំណាយ ជាង ៦៣ ម៉ឺន ដុល្លារ លើ ហ្វេសប៊ុក ចូលចិត្ត ។
គំនិត និង យោបល់ របស់ អ្នក ក្រោម បង្កាប់ របស់ ខ្លួន ដែល ពួកគេ ហ៊ាន និយាយ ការពិត ចេញ
ហេតុ នេះ ហើយ ទើប អ្នកសង្កេតឃើញ ថា ទារក តូច ៗ
ប៉ុន្តែ អ្នក មិន ចាំបាច់ បារម្ភ ឡើយ ព្រោះ វា នឹង ជា វិញ ក្នុង រយៈពេល មួយ សប្តាហ៍ ក្រោយ ។
ប្រសិនបើ អ្នករវល់ ពេក ក្នុង ការផឹក ទឹក ឱ្យ បាន គ្រប់គ្រាន់ នោះ លោក អ្នក គ្រាន់តែ បរិភោគ ត្រសក់ ព្រោះ ត្រសក់ មាន ជាតិ ទឹក ដល់ ទៅ 90 ភាគរយ ។
លំដាប់ នោះ ព្រះអង្គ ទ្រង់ ប្រោសយ សកុលបុត្ត ឱ្យ បាន សម្រេច ព្រះអរហត្ត ផល ព្រមទាំង សម្លាញ់ ទាំង ៤នាក់ ទៀត គឺ ព្រះវិមល ត្ថេរ ព្រះសុពាហុក ត្ថេរ១ ព្រះបុណ្ណ ជិ១ ព្រះគវម្បតិ១ ។
មេ បក្ស ប្រឆាំង មិន អាច ចូល ស្រុក បាន ឡើយ បើសិន មិន មក ទទួលទោស តាម ច្បាប់ វិមាន ៧មករា
ការពិត ខ្ញុំ និង មិត្ត រាប់អាន គ្នា យូរ មកហើយ តែ មកដល់ ថ្ងៃ មួយ មិត្តភាព របស់ យើង ក៏ ប្រែប្រួល … ខ្ញុំ ទទួល អារម្មណ៍ ថា ខ្ញុំ ស្រលាញ់ គេ !
ព្រៃឈើ នៅ ខេត្ត ក្រចេះ ។
៤. វា ធ្វើអោយ សក់ អ្នក នៅតែ ស្រស់ស្អាត
យើង ត្រូវការ ពេលវេលា បន្ថែម ទៀត ក្នុង ចំណោម ភាគី ទាំង បួន ដើម្បី រៀបចំ ឧត្តម ក្រុមប្រឹក្សា ជាតិ ។
មួយចំនួន ដែល ធ្វើឱ្យ អ្នកគាំទ្រ នៅតែ ចង់ តាមដាន មិន ចេះ ចប់ មិន ចេះ ហើយ ។
អ្នក ប្រហែលជា មិន បាន ដឹង អំពី រឿង នេះ ទេ ប៉ុន្តែ អ្នក ក៏ ប្រហែលជា កំពុងតែ មាន ភាពតានតឹង ឬ ស្ត្រេស នេះ ច្រើន ណាស់ ហើយ ។
ឯង តែងតែ ព្យាយាម ដើម្បី ខ្ញុំ និង យល់ ពី ខ្ញុំ ជានិច្ច ។
ប្អូន អាច រៀបរាប់ ពី សមិទ្ធផល សិក្សា ដែល ទទួលបាន ជយលាភី កាលពី ពេល កន្លងមក ?
អាច ធ្វើ ប្រតិបត្តិការ ធនាគារ បាន គ្រប់ ទីកន្លែង គ្រប់ ពេលវេលា នៅពេល មាន តម្រូវការ ។
វា ផ្តល់ ភាពកក់ក្តៅ មួយ នៅក្នុង ក្រុមគ្រួសារ ផង ។
នៅឡើយ ទេ ដោយ ទុក ភារកិច្ច ឱ្យ គណៈកម្មការ ជំនាញ ជា អ្នកសម្រេច ។
បើ រៀបការ គឺ ត្រូវ ក្លាយជា កសិករ នៅក្នុង ភូមិ ស្រុក របស់ ខ្លួន ។
នេះ ជា សំណួរ ដែល ប្រជាជន មួយចំនួន ធំ បាន និង កំពុង ចោទ ឡើង គ្រប់ ៗ
យក ការត្រួតពិនិត្យ ល្បឿន នៃ ការចាក់ សារ ថ្មី នៅក្នុង ឈុត វីដេអូ របស់ អ្នក ។
ទៀត ជាពិសេស ប៉ុន្មាន នាទី មុនពេល កើត ហេតុ ។
ខ្ញុំ គិត ថា បើ ខ្ញុំ អាច មាន ឱកាស វា នឹង ធ្វើឱ្យ ដំណើរកម្សាន្ត របស់ ខ្ញុំ កាន់តែ ជក់ចិត្ត ថែម ទៀត ។
ប្រសិនបើ អ្នក ទទួល វា ក្នុង រយៈពេល ១២០ ម៉ោង ៥ ថ្ងៃ បន្ទាប់ពី រួមភេទ ដោយ មិន បាន ការពារ វា មាន ប្រសិទ្ធភាព ជាង ៩៩៩ % ក្នុង ការការពារ ការមាន ផ្ទៃពោះ ។
គាត់ បាន ធ្វើការ ជាមួយ លោក លុយ បាន ហាប់ ក្នុង ការសាងសង់ សាល មហោស្រព ជាតិ ចេនឡា នៅក្នុង ឆ្នាំ ដដែល ។
បន្ទាប់មក ខ្ញុំ ក៏ ដើរ ចេញ ពី កថា ដើម្បី ស្វែងរកហត្ថលេខា ពី អ្នកដទៃ ទៀត ។
មនោសញ្ចេតនា ស្រុះ ស្រួល នឹង គ្នា បំផុត ។
ប៉ុន្តែ ពួកគេ ក៏ អាច ប្រឈម នឹង បទបរិហារ កេរ្តិ៍ ដែរ ។
ជា ទីកន្លែង ដែល អ្នក រាល់ អាច ដាក់ អត្ថបទ ទាក់ទង នឹង ប្រវត្តសាស្ត្រ
ព្រះបាទ សាឡូម៉ូន ទូល សូម ប្រាជ្ញា ពី ព្រះជាម្ចាស់
គម្រោង របស់ យើង គឺ ស្ថិត នៅ ជាយក្រុង តូច មួយ នៃ ទីក្រុង ។
ខ្លាច គេ មក កាន់អំណាច ម្តង គេ មក ធ្វើបាប យើង វិញ ។
អាន ទម្រាំ ដាច់ ព្រះជា ម្ចាស់ !
អ្នកណា ក៏ សុទ្ធសឹង ចង់ឱ្យ យើង ជួយ ។
សម្រាប់ ព័ត៌មាន បន្ថែម សូម ចុច នៅ ទីនេះ .
ល្មម ដឹងខ្លួន ហើយ បើ មិន រាងចាល ឆាប់ កែ កុន បញ្ហា ទេ នោះ ជា ពេលវេលា ចុងក្រោយ ហើយ ។
ការគ្រប់គ្រង លើ ការចំណាយ មិន មែន ជា ការងារ ងាយស្រួល ទេ ហើយ វា អាច ជា ឧបសគ្គ ដល់ យើង អ្នក មាន ភាគ ច្រើន មិន ខ្លាច នឹង ទិញ ទំនិញ ឬ ប្រើ ប័ណ្ណ ឡើយ ។
អាមេរិក អ្នកឯង មាន កង យោធា ដ៏ ខ្លាំង ជាង គេ ក្នុង ពិភពលោក ។
ដោយ ផ្អែក តាម និយមន័យ នេះ ប្រព័ន្ធ ព្រះអាទិត្យ មាន ភព ចំនួន ប្រាំបី ដែល ត្រូវបាន គេ ស្គាល់ គឺ ៖
ខ្ញុំ ក៏ បាន ប្រើ ថ្នាំ ពន្យារ កំណើត បន្ទាន់ ហើយ មួយ ខែ ក្រោយ ខ្ញុំ ក៏ មក រដូវ ធម្មតា ។
គម្រោង ធ្វើជា ម្ចាស់ ផ្ទះ ប្រកួត តេក្វាន់ ដូ អាយ …
ចូរ ចរចា តែ ពាក្យ ផ្អែម យ៉ាង ស្រស់ស្រាយ
