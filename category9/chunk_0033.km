បញ្ហា ស្ត្រី កុមារ និង ពលករ ចំណាកស្រុក នៅ កម្ពុជា
រូប ពុំ ចង់អោយ ឃ្លាត ឆ្ងាយ ពី ផ្កា នេះ ។
គាត់ ក៏ បាន ឱ្យ យោបល់ គួរ ពិសោធន៍ ដើម្បី ស្វែងយល់ លើ យោបល់ ផ្សេង ៗ
ពេល នោះ នឹង មាន ការថត រូប ជា អនុស្សាវរីយ៍ ។
លើក ទី១ ក្នុង ខែមេសា និង ៤លើក ចុងក្រោយ ក្នុង ខែឧសភា កន្លងទៅ ។
សង្ឃឹម ខ្លួន ឯង មិន កើត គាត់ ក៏ ប្រាប់ អ្នកបម្រើ ឈ្មោះ ស៊ោសិប ឱ្យ ដាស់ គាត់ នៅ ម៉ោង ៦ព្រឹក ។
ព្រះអង្គ ជា ស្តេច ឡាវ ដំបូង ដែល បង្រួបបង្រួម ក្រុម កុលសម្ព័ន្ធ នៅក្នុង អាណាចក្រ ភាគ ខាងជើង ក្នុង ឆ្នាំ ១០៩៦ ។
សូម ស្លេះ និយាយ ពី គ្នា ខ្ញុំ និង មិត្តភ័ក្តិ បន្តិច មក និយាយ បទពិសោធន៍ លើ កោះ វិញ ។
ប៉ុន្តែ ជារៀងរាល់ ថ្ងៃ មាន អ្នកទោស ដូចគ្នា មក លាង ដំបៅ របស់ គាត់ ហើយ លើកទឹកចិត្ត គាត់ អោយ បរិភោគ ចំណែក របស់ គាត់ ។
សូម អរគុណ លោក ច័ន្ទ រឿន ដែល បាន ចូលរួម ផ្តល់ មតិ ។
ប្រជាចន អត់ ដី ធ្វើ ស្រែ ចំការ មិន ឈប់ឈរ នោះ ។
ចេះ លេង ភ្លេង ដូច ឪពុក ឬ ដូចជា ធ្វើការ ក្នុង ការិយាល័យ ជាដើម ។
អ្នក ក៏ មាន តម្លៃ ចំពោះ ខ្លួន ឯង និង អ្នកដទៃ ច្រើន ប៉ុន នោះ ដែរ
ៃន ករ អភិវឌ ស្តង់
អ្វី ដែល គាត់ ធ្វើ កន្លងមក គឺ វា ខុស ច្បាប់ ។
ដូចរី ស្សត នៅ បរទេស យ៉ាងម៉េច អញ្ចឹង !
ខាងក្រោម នេះ គឺជា គន្លឹះ ដ៏ មាន ប្រយោជន៍ មួយចំនួន ដើម្បី និយាយ ទៅ អាច ធ្វើឱ្យ កូន ធ្វើ តាម អ្នក ។
គម្រូ ឈាម និង ទឹកនោម អាច ត្រូវបាន គេ យក មើល ដើម្បី ពិនិត្យ ផងដែរ ។
មាន កិច្ចការ ច្រើន ណាស់ ដែល យើង អាច ធ្វើ បាន ហើយ ប្រហែលជា មាន ប្រសិទ្ធភាព ទៀតផង ។
ធ្វើឱ្យ ម្ចាស់ ខ្មាស គេ
ចំណែក មេឃុំ រាល់ ការចាយវាយ គាត់ មិន អាច ឆ្លើយ ដាក់ អ្នកណា បាន ទេ ។
ធ្វើឱ្យ បាក់តេរី ទាំងនោះ ខ្លាំង ឡើង ៗ
ទាំង រុស្ស៊ី និង អ៊ីរ៉ង់ បាន បញ្ជូន ទាហាន ទៅកាន់ ស៊ីរី ដើម្បី គាំទ្រ របប គ្រប់គ្រង របស់ ប្រធានាធិបតី អាសាត ប្រឆាំង នឹង ពួក ឧទ្ទាម ប្រឆាំង ៕
បំភ្លឺ ឱ្យ ខ្ញុំ ក្លាយជា មិត្ត
បន្ទាប់មក សូម សម្រាក បន្តិច ហើយ សូម ធ្វើ សា ជា ថ្មី ជាមួយ ជើង ម្ខាង ៗ
អតីត និស្សិត និង បច្ចុប្បន្ន ជា អនុប្រធាន តុលាការ កំពូល ៖
ប៉ុន្តែ ឥឡូវនេះ ជន ណា ដែល បរិភោគ ឬ ធ្វើ អាជីវកម្ម សាច់ ឆ្កែ ឬ ឆ្មា នឹង ត្រូវ ផាក ពិន័យ ជា ប្រាក់ ចន្លោះ ពី ១៦៤០ ទៅ ៨២០០ ដុល្លារ អាមេរិក ។
លោកស្រី មាន ស្នាដៃ សំខាន់ ៗ
ចូរ យើង មាន ភាពស្មោះត្រង់ ចំពោះ ក្រុម ជំនុំ តាម តំបន់ របស់ យើង ។
ម៉ុងហ្គោលី និង ហ្វីលីពីន ដោយ គ្រប់គ្រង ផលប័ត្រ ចំនួន ៦០ លាន ដុល្លារ អាមេរិក
តែ អ្នក ត្រូវ ចាំ ពាក្យបញ្ជា មួយ ឃ្លា ប៉ុណ្ណោះ ៖
យ៉ាងណាមិញ តាម របាយការណ៍ របស់ ឯកឧត្តម ងិន …
សំខាន់ បំផុត យុវជនសម័យ បច្ចុប្បន្ន ចូលចិត្ត ចាប់ យក អ្វី ដែល ថ្មី និង ទាន់សម័យ ។
ព្រោះ បារី ជា អាវុធ ប្រហារជីវិត យ៉ាង សម្ងាត់ ។
លោក ម៉ាឌូរ៉ូ អះអាង ថា អ្នក ទាំង ២នាក់ នេះ ពុំ ព្រម ធ្វើ តាម ការផ្តុំ ត្រចៀក របស់ សហរដ្ឋ អាមេរិក ដូច្នេះ យើង និង ផ្តល់ កិត្តិយស ដល់ ពួកគេ ។
ទំនាក់ទំនង កម្ពុជា និង អឺរ៉ុប នៅតែ រក្សា បាន ដដែល
អ្នកដឹកនាំ ថ្មី និង ឯកសណ្ឋាន រចនា ម៉ូត ថ្មី ។
ខ្ញុំ មិន ដែល បាន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ ទេ គឺ ខ្ញុំ ទិញ ថ្នាំ យកមក លេប ។
លទ្ធផល ទាំងនេះ សម្រេចបាន តាមរយៈ សំណុំ នៃ កិច្ចអន្តរាគមន៍ ដែល បាន អនុវត្ត ក្នុង ពេល ជាមួយគ្នា មាន ជាអាទិ៍ ៖
គ្រប់ គ្នា សុទ្ធតែ មាន តារា និករ តំណាង ខែកំណើត រៀង ខ្លួន ។
យោបល់ ខ្ញុំ គឺ ប្រុងប្រយ័ត្ន បន្ថែម ប្រហែល សម្រាប់ រាជ រដ្ឋាភិបាល ថ្មី មួយ ផ្សេង ទៀត តែ មិន មាន រាជ រដ្ឋាភិបាល ថ្មី ផង ។
រីឯ ការវិនិយោគ ដែល
ខ្ញុំ មិន ចង់ ធ្វើ ការប្រមូលផ្តុំ អី ទេ ។
ដូច្នេះ អ្នក គួរ ជូត ក្លៀក ឱ្យ ស្ងួត សិន មុនពេល លាប រ៉ូអន ។
រឿង ទេពធីតា កណ្តុរស មិន ទាន់ បញ្ចាំង
នេះ ហើយ ជា អ្វី ដែល ខ្ញុំ បាន ស្នើ ទៅ លោក នាយក រដ្ឋមន្ត្រី ហើយ ខ្ញុំ សង្ឃឹម ថា នឹង មាន ការរីកចម្រើន ក្នុង សំណើរ នេះ ។
ក្នុង រយៈពេល ៧ ថ្ងៃ ខាងមុខ អ្នក នឹង អាច ប្រើ វិធី ខ្លួន ឯង ដើម្បី ចំណេញ ប្រាក់ ។
ស្ត្រី រាប់ រយ នាក់ ត្រូវបាន សម្លាប់ រៀងរាល់ ឆ្នាំ ក្នុង ប្រទេស ប៉ាគីស្ថាន ដែល មាន អ្នក កាន់ សាសនា ឥស្លាម ភាគ ច្រើន ក្នុង ការសម្លាប់ មួយ ដែល គេ ហៅ ថា ការសម្លាប់ ដោយ កិត្តិយស អនុវត្ត ឡើង ដោយ ប្តី ឬ សាច់ញាតិ សម្រាប់ ជា ការដាក់ ពិន័យ ចំពោះ ការផិត ក្បត់ ឬ ការប្រព្រឹត្ត សិច ខុស ច្បាប់ ដទៃ ទៀត ។
ខ្ញុំ គិត ថា ប្រសិនបើ គេ មិន រក យុត្តិធម៌ ឱ្យ ខ្ញុំ គឺ ខ្ញុំ ចប់ ហើយ បង ពីព្រោះ ខ្ញុំ ជា កម្មករ តូចតាច មិន អាច ប្រៀបធៀប ជាមួយ អ្នក ធំ បាន ទេ ។
ហេតុ អ្វី បានជា ប្រាសាទ ព្រះវិហារ មាន ជណ្តើរ ឡើង ស្ថិត នៅក្នុង ទឹកដី ថៃ សព្វ ថ្ងៃ នេះ ទៅ វិញ ?
លើក នេះ ឡាយ លក្ខិណា និយាយ ពាក់ព័ន្ធ ពី មិត្ត ទាំង៣
ក៏ប៉ុន្តែ នៅ ពេល នោះ ហ៊ីត្លែរ មិន បាន បញ្ឈប់ ការវាយប្រហារ តាម ផ្លូវ អាកាស ទៅ លើ អង់គ្លេស នោះ ទេ ។
ពីរ ថ្ងៃ ក្រោយពី បាន ជួប ក្មេងប្រុស ម្នាក់ នោះ ខ្ញុំ អាន ប៉ះ នៅក្នុង កាសែត ទៀត ថា ស្ត្រី ម្នាក់ នោះ បាន ស្លាប់ បាត់បង់ជីវិត ទៅ ហើយ ។
ពេល ដឹង ការពិត នៃ ភ្នាស ព្រហ្ម ចារី របស់ មនុស្ស ស្រី
ហើយ អ្នក ត្រូវ រក្សាទុក វា ឱ្យ បាន ល្អ ។
ថា ច្បាប់ បាន បញ្ចប់ លែង មាន អានុភាព អនុវត្ត ន៏ ទៀត ហើយ ។
ប៉ុន្តែ គិត មកទល់ ពេលនេះ ពុំ ទាន់ ត្រូវបាន ប្រភព មួយ ណា បញ្ជាក់ ទេ កើត មាន ឡើង ក្នុង ទឹកដី ខេត្ត នោះ ឡើយ ៕
ក្នុង ករណី នេះ គេ ប្រើ និគ្គ ហិតំ
ទន្ទឹម នឹង នោះ ពួកគេ ក៏ បាន ខិតខំ ស្វែងរក វិធី ដើម្បី ជួយ ដល់ ប្រទេស កម្ពុជា បន្ថែម ទៀត ។
ហេតុ អ្វី កម្ពុជា មាន បុរស ជាង ១២៥ នាក់ ឆ្លង កូវីដ១៩ ខណៈ ស្ត្រី តែ ៤០ នាក់
