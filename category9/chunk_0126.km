ក្នុង វេទិកា កិច្ចសហប្រតិបត្តិការ សមត្ថភាព ឧស្សាហកម្ម អន្តរជាតិ ឆ្នាំ ២០១៧ និង ពិធី ពិព័រណ៍ វិនិយោគ បរទេស ចិន លើក ទី ៩ ដែល ត្រូវ បាន រៀបចំ ឡើង នៅ ទីក្រុង ប៉េកាំង លោក Zhou Xiaofei អគ្គ លេខាធិការ រង នៃ គណៈកម្មាធិការ អភិវឌ្ឍន៍ និង កំណែទម្រង់ ជាតិ របស់ ប្រទេស ចិន បាន ឲ្យ ដឹង ថា ចំនួន បុគ្គលិក ក្នុង ស្រុក ដែល កំពុង បម្រើ ការ ឲ្យ ក្រុមហ៊ុន ចិន នៅ ក្រៅ ប្រទេស បាន កើន ឡើង ដល់ ជាង ១,៣ លាន នាក់ កាលពី ឆ្នាំ មុន ។
ការ វិនិយោគ ផ្ទាល់ នៅ ក្រៅ ប្រទេស ទូទាំង ពិភពលោក របស់ ប្រទេស ចិន ដែល រួម មាន ការ ច្របាច់ ក្រុមហ៊ុន បញ្ចូល គ្នា ការ ទិញ យក ក្រុមហ៊ុន និង ក្រុមហ៊ុន ដែល ទើប តែ បង្កើត ថ្មី នោះ បាន កើនឡើង ដល់ ជិត ១,៤ ពាន់ ពាន់ លាន ដុល្លារ នៅ ចុង ឆ្នាំ ២០១៦ ។
ម៉ាឡេស៊ី - ឥណ្ឌូនេស៊ីពង្រឹងកិច្ចសហប្រតិបត្តិការ
លោក បាន មាន ប្រសាសន៍ ថា ប្រទេស ឥណ្ឌូនេស៊ី ក៏ បាន ចាប់ផ្តើម នាំ ចេញ អង្ករ ទៅ កាន់ ប្រទេស ម៉ាឡេស៊ី ផង ដែរ នៅ ខែ តុលា ដោយ បាន នាំ ចេញ ចំនួន ២៥ ពាន់ តោន ។
លោក បន្ត ថា បរិមាណ នាំ ចេញ នេះ អាច នឹង កើនឡើង រៀងរាល់ ឆ្នាំ ។
បញ្ហា សំខាន់ មួយ ទៀត ដែល ត្រូវ បាន ពិភាក្សា ក្នុង អំឡុង កិច្ចពិភាក្សា ទ្វេ ភាគី នេះ គឺ ការ ការពារ ពលរដ្ឋ ឥណ្ឌូនេស៊ី ដែល រស់ នៅ និង ធ្វើការ នៅ ប្រទេស ម៉ាឡេស៊ី ដែល នឹង ក្លាយ ជា អាទិភាព មួយ របស់ រដ្ឋាភិបាល ឥណ្ឌូនេស៊ី ។
