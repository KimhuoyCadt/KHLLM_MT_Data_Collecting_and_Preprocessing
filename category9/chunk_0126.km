ក្រុមហ៊ុន Bosch និង Wurth នាំយកបច្ចេកវិទ្យាអាល្លឺម៉ង់គាំទ្រដល់ការបណ្តុះបណ្តាលវិជ្ជាជីវៈនៅកម្ពុជា
ក្រុមហ៊ុន អាល្លឺម៉ង់ ដ៏ ល្បីល្បាញ ចំនួន ២ បាន នាំ យក ជំនាញ បច្ចេកទេស របស់ ពួកគេ មក កម្ពុជា ជា កន្លែង ដែល សិស្ស និស្សិត កម្ពុជា កំពុង ត្រូវការ ការបណ្តុះបណ្តាល ជំនាញ យ៉ាង ខ្លាំង ។
ការសហការ គ្នា នេះ គឺ ធ្វើ ឡើង ដើម្បី បង្ហាញ ដល់ សិស្ស និស្សិត កម្ពុជា នូវ បច្ចេកវិទ្យា ទំនើប ចុងក្រោយ របស់ អាល្លឺម៉ង់ ដែល អាច ជួយ ដល់ សិស្ស និស្សិត នៅក្នុង ប្រទេស កម្ពុជា ឱ្យ ចាប់ យក ជំនាញ វិស្វកម្ម បាន ត្រឹមត្រូវ ដើម្បី ឆ្លើយតប នឹង តម្រូវការ សេដ្ឋកិច្ច របស់ ប្រទេស កម្ពុជា ដែល កំពុង រីកលូតលាស់ ។
ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ អាល្លឺម៉ង់ (GIZ) កម្មវិធី អភិវឌ្ឍន៍ សេដ្ឋកិច្ច តំបន់ (RED IV) និង ក្រុម ពាណិជ្ជករ អាល្លឺម៉ង់ គឺជា អ្នក ផ្តួចផ្តើម នៃ កិច្ចសហប្រតិបត្តិការ ក្នុង ការផ្ដល់ ជូន សម្ភារ ដល់ វិទ្យាស្ថាន នេះ ដើម្បី លើកកម្ពស់ ការផ្តល់ ជំនួយ បច្ចេកទេស រវាង ក្រុមហ៊ុន ឈាន មុខ របស់ អាល្លឺម៉ង់ និង ស្ថាប័ន ក្នុង ស្រុក ។
ដូច្នេះ ហើយ ការឧបត្ថម្ភ សម្ភារ នឹង គ្រឿង ម៉ាស៊ីន ពី ក្រុមហ៊ុន Wuerth និង Bosch នេះ គឺជា ឧទាហរណ៍ ដ៏ ល្អ បំផុត មួយ ដែល បង្ហាញ អំពី ការគាំទ្រ យ៉ាង សកម្ម ពី សំណាក់ ក្រុមហ៊ុន អាល្លឺម៉ង់ ចំពោះ ការបណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ នៅ កម្ពុជា ។
កិច្ចសហការ នេះ កើត មាន ឡើង ចំ ពេល ដែល កំពុង មាន តម្រូវការ កម្លាំង ពលកម្ម កើនឡើង នៅ ក្នុង ទីផ្សារ ការងារ នៅ កម្ពុជា ដោយ បច្ចុប្បន្ន កម្លាំង ពលកម្ម ជំនាញ នៅ មាន ចំនួន ទាប នៅ ឡើយ ។
រដ្ឋាភិបាល កំពុង ផ្តោត ការយក ចិត្ត ទុកដាក់ យ៉ាង ខ្លាំង ចំពោះ ការអភិវឌ្ឍ ធនធាន មនុស្ស ជាពិសេស កម្លាំង ពលកម្ម ជំនាញ ដែល កំពុង មាន តម្រូវការ ខ្ពស់ ដើម្បី ទ្រទ្រង់ សេដ្ឋកិច្ច ដែល កំពុង រីកលូតលាស់ និង បាន ដាក់ ចេញ នូវ គោល នយោបាយ ជាតិ ស្តីពី ការអប់រំ បណ្ដុះបណ្ដាល បច្ចេកទេស និង វិជ្ជាជីវៈ ឆ្នាំ ២០១៧ - ២០២៥ ហើយ គោលបំណង នៃ គោល នយោបាយ នេះ គឺ បង្កើត ក្របខ័ណ្ឌ រួម មួយ សម្រាប់ ដៃគូ ទាំងអស់ ក្នុង ការចូលរួម ចំណែក អភិវឌ្ឍ សមត្ថភាព កម្លាំង ពលកម្ម ។
បច្ចុប្បន្ន ប្រទេស កម្ពុជា គឺ មាន ស្ថិរភាព ហើយ សេដ្ឋកិច្ច កំពុង រីកលូតលាស់ ប៉ុន្តែ យើង ត្រូវ គិត ពី របៀប ដើម្បី រក្សា ( កំណើន ) នេះ នៅពេល អនាគត ។
គោល នយោបាយ របស់ រដ្ឋាភិបាល គឺ ដើម្បី អភិវឌ្ឍ សេដ្ឋកិច្ច និង ដើម្បី ក្លាយ ជា ប្រទេស ដែល មាន ប្រាក់ ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ក្នុង ឆ្នាំ ២០៣០ ។
លោក ឡៅ ហ៊ីម អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ នៃ ក្រសួង ការងារ បាន ថ្លែង ថា ៖
ការអភិវឌ្ឍ ធនធាន មនុស្ស នៅ មាន កម្រិត លើ ផ្នែក ខ្លះ ក្នុង វិស័យ ឯកជន ហើយ កម្លាំង ពលកម្ម ជំនាញ នៅ មាន គម្លាត នៅឡើយ ក្នុង ទីផ្សារ ការងារ » ។
នៅក្នុង ពិធី ប្រគល់ សម្ភារ នោះ ក្រុមហ៊ុន Bosch និង Wuerth បាន ផ្ដល់ជូន ម៉ាស៊ីន និង សម្ភារ សិក្សា មួយ ចំនួន ដល់ វិទ្យាស្ថាន ពហុ បច្ចេកទេស ខេត្ត បន្ទាយមានជ័យ ដើម្បី ចូលរួម ចំណែក សម្រួល ការសិក្សា របស់ សិស្ស និស្សិត នៅក្នុង វិទ្យាស្ថាន មួយ នេះ ។
នៅក្នុង ប្រទេស កម្ពុជា អាជីវកម្ម របស់ ក្រុមហ៊ុន Bosch មាន ដូចជា សម្ភារ ផ្នែក យានយន្ត ឧបករណ៍ អគ្គិសនី សម្ភារ សម្រាប់ វិស័យ សំណង់ គ្រឿង អេឡិចត្រូនិក បច្ចេកវិទ្យា សម្រាប់ វិស័យ ឧស្សាហកម្ម ពាណិជ្ជកម្ម ប្រព័ន្ធ សុវត្ថិភាព និង បច្ចេកវិទ្យា វេចខ្ចប់ ជាដើម ។
ត្រាក់ទ័រ"វៃឆ្លាត " របស់ក្រុមហ៊ុន Yanmar គឺ ជាគ្រឿង យន្តកសិកម្មដ៏ទំនើបនៅក្នុងប្រទេសកម្ពុជា
ការ ប្រើប្រាស់ បច្ចេកវិទ្យា គឺ មិន មែន ផ្តោត តែ ទៅ លើ វិស័យ ហិរញ្ញវត្ថុ របស់ កម្ពុជា តែ មួយ ប៉ុណ្ណោះ ទេ ។
បច្ចុប្បន្ន សូម្បី តែ វិស័យ កសិកម្ម នៅ ក្នុង ព្រះ រាជាណាចក្រ កម្ពុជា ក៏ កំពុង ព្យាយាម ប្រើប្រាស់ បច្ចេកវិទ្យា ទំនើប នេះ ដែរ ដើម្បី ធ្វើ ឲ្យ ជីវភាព របស់ ប្រជា កសិករ កាន់ តែ មាន ភាព ល្អ ប្រសើរ ឡើង មួយ កម្រិត ថែម ទៀត ។
តាម រយៈ ការ លក់ ត្រាក់ទ័រ ដ៏ ទំនើប ដល់ កសិករ នៅ តាម ជនបទ ក្រុមហ៊ុន ក៏ កំពុង ព្យាយាម ជួយ បង្កើន ផលិតភាព របស់ កសិករ ផង ដែរ តាម រយៈ ការ ប្រើប្រាស់ ត្រាក់ទ័រ ទំនើប នេះ ដែល វា នឹង ជួយ លើក កម្ពស់ ស្ថានភាព សេដ្ឋកិច្ច របស់ ប្រជា កសិករ ឲ្យ កាន់ តែ ប្រសើរ ហើយ ម្យ៉ាង វិញ ទៀត វា ជួយ សម្រួល ដល់ កង្វះ កម្លាំង ពលកម្ម នៅ ក្នុង វិស័យ មួយ នេះ ដោយ សារ តែ ការ ចំណាក ស្រុក មក កាន់ ទីក្រុង ។
ម្យ៉ាង វិញ ទៀត ត្រាក់ទ័រ ម៉ូដែល ដ៏ ទំនើប នេះ ប្រើប្រាស់ ម៉ាស៊ូត មាន កម្លាំង ខ្លាំង ពោរពេញ ដោយ ថាមពល និង មាន ប្រសិទ្ធភាព ខ្ពស់ ស៊ី ប្រេង តិច និង មាន ភាព ធន់ បំផុត ។
លោក ប៊ុន ណាត បាន បន្ថែម ថា៖
និយាយ ជា រួម គឺ ព័ត៌មាន ទាំង អស់ នឹង ត្រូវ បង្ហាញ នៅ លើ អេក្រង់ ទូរស័ព្ទ ដៃ របស់ កសិករ ផ្ទាល់ តែ ម្តង ។
