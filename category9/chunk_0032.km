៤ក៏ មិន ព្រម ឱ្យ ភ្នែក ទូលបង្គំ ដេកលក់
សេចក្តីស្រឡាញ់ រវាង បងប្អូន
នៅ ពេល ដែល ព្រះវរ បិតា បាន ឆ្លើយតប ថា ទេ ទៅ ចំពោះ ព្រះរាជ បុត្រា ។
សម្តេច សិរី រាជា ក្នុង គ្រា នោះ កំពុង គង់ ប្រថាប់ នៅ ខែ ត្រ កំពង់សៀម ។
គ្នា ដោយ ធ្វើដំណើរ តាម ទូក ៖
គ្នា មក ក្នុង បន្ទប់ ប្រជុំ នោះ ដើម្បី ស្តាប់ ពី គ្នា ទៅ វិញ ទៅមក ។
០៣សង្ឃឹម ថា អូន ជួប មនុស្ស ល្អ វីរៈ សិទ្ធ
វ៉ិបសាយ របស់ សារព័ត៌មាន ដើម អម្ពិល កំពុងតែ ជួប បញ្ហា គាំង មិន ដំនើរការ ។
លោក ថា មាន មន្ត្រី ពុករលួយ ច្រើន ណាស់ ក្នុង រដ្ឋាភិបាល ។
៤បន្ទាប់ នោះ មក ព្រះយេហូវ៉ា ទ្រង់ មាន ព្រះបន្ទូល នឹង ម៉ូសេ ថា មើល អញ នឹង បង្អុរ ភ្លៀង ជា នំប៉័ង ពីលើ មេឃ មក ឱ្យ ឯង រាល់គ្នា ត្រូវ ឱ្យ បណ្តា ជន ចេញ ទៅ រើស ឱ្យ ល្មមតែ ១ ថ្ងៃ រាល់ ៗ
ពួកគេ សុខចិត្ត ជំពាក់ បំណុល សំខាន់ ឱ្យ តែ បាន របស់ ល្អ ប្រើ នឹង គេ ។
ថ្ងៃស្អែក ខ្ញុំ នឹង ដាក់ រូប បន្ត ទៀត ៕
ហ្វ្លយ ដ៏ បាន ប្រាប់ ខ្ញុំ ឱ្យ រក រថយន្ត ស៊េរី ទំនើប ៗ
ទ្រព្យសម្បត្តិ ជា កេរ ដំណែល វប៌្បធម មាន តម្លៃ ខ្លាំង ជាង ទ្រព្យ ជា ប្រេងកាត !
ទទួលបាន ការឆ្លើយ មិន លើស2 ថ្ងៃ ធ្វើការ ។
បញ្ហា ខ្វះ ទឹក ប្រើប្រាស់ អាច កើតមាន ដោយសារតែ ភាពរាំងស្ងួត អូសបន្លាយ ។
ឧកញ៉ា គង់ គ្រឹង ត្រូវបាន ឃាត់ខ្លួន ពី បទល្មើស ព្រៃឈើ
ដល់ ព្រះអង្គ ក្នុង ឱកាស បុណ្យ ណូណែល នេះ ។
បញ្ហា កង្វះ អនាម័យ គឺជា កត្តា មួយ ដែល រួមចំណែក ធ្វើឱ្យ ប្រជាជន ជួបប្រទះ នូវ ភាព ក្រីក្រ ។
លោក ម៉ាក្រុន ត្រូវ ចូលរួម ក្នុង ពិធី ជប់លៀង មួយ ជាមួយ មេដឹកនាំ ដទៃ ៗ
តែ លោកស្រី បាន អរគុណ រុស្ស៊ី ចំពោះ ការប្រឹងប្រែង គាំទ្រ របប ដឹកនាំ ស៊ីរី មក ទល់ បច្ចុប្បន្ន ថែម ទៀត ផង ។
លោក មាន ដុង ផ្នែក សិល្បៈ តែ ម្នាក់ឯង ប៉ុណ្ណោះ ក្នុង ចំណោម បងប្អូន ទាំងអស់ បើ ទោះជា បង ៗ
បើ ចង់ ជួប ខ្ញុំបាទ ដោយ ផ្ទាល់ លោក អាច អញ្ជើញ មក ជួប ខ្ញុំបាទ ទៅ តាម ពេលវេលា មួយ សមស្រប ។
សម្លេង រំខាន គឺ គ្មាន អ្នកណា ចង់ឱ្យ វា កើតឡើង ពេល គេ កំពុង និយាយ អ្វី មួយ នោះ ទេ ។
តាមពិត កីឡាករ រូប នេះ ជា ខ្សែ ប្រយុទ្ធ លើ ទីលាន បាល់ទាត់ ម្នាក់ ដែរ ។
ពី បណ្តាញ សង្គម អាច យល់ បាន ថា ហេតុ អ្វី គេ ស្រឡាញ់ ប្រធានាធិបតី ខ្លួន បែប នេះ ។
កាប់ ច្រើន ខែ ហើយ រហូតដល់ ខែ នេះ សុទ្ធតែ ផ្ទុយ នឹង ច្បាប់ ។
អ្នកទទួលខុសត្រូវ គ្រប់ យ៉ាង ទាំងអស់ ។
កម្មវិធី និង ពុម្ព អក្សរ ទាំងនោះ អាច ទាញយក បាន ពី ៖
ក្រុម និស្សិត ដែល តាង ខ្លួន ជាដើម បណ្តឹង បង្ហាញ មោទនភាព ។
អ្នក ទាំង ពីរ ក៏ នាំ ព្រះឱរស ទៅ ថ្វាយ ព្រះអម្ចាស់ នៅ ក្រុង យេរូសាឡឹម ដ្បិត ក្នុង ក្រឹត្យ វិន័យ របស់ ព្រះអម្ចាស់ មាន ចែង ទុក មក ថា ៖
ឱ្យ តែ មាន ច្បាប់ អ្នកណា ហាមឃាត់ ។
លោកជំទាវ ប៉ាង ដានី បាន គូរ បញ្ជាក់ ថា សិក្ខាសាលា ខាងលើ នេះ មាន គោលបំណង ពិភាក្សា ផ្តោត ទៅ លើ ប្រធានបទ សំខាន់ ៗ
ខ្ញុំ កំពុងតែ សម្លឹងមើល ទៅ លើ ការរៀបចំ នេះ ទាំង នៅលើ និង ខាងក្រៅ ទីលាន ។
បើ តាម រូបភាព ពួកគេ ទាំងអស់ គ្នា សុទ្ធតែ បង្ហាញ អារម្មណ៍ រីករាយ របស់ ខ្លួន ដោយ នៅ ទីនោះ ពួកគេ អាច គេង ហាល ថ្ងៃ រួមរ័ក គ្នា ងូតទឹក ធ្វើ អ្វី តាម ចិត្ត ចង់ ។
ពួកយើង ត្រូវតែ ធ្វើ គ្រប់ មធ្យោបាយ ទាំងអស់ ដើម្បី បង្ហាញ ថា ពួកយើង អាច ធ្វើ អ្វី ៗ
ប្រមាណ កន្លះ ឆ្នាំ មកហើយ ដែល កីឡាករ គង់ សំបូរ ដែល ត្រូវ គេ ស្គាល់ ថា
តាម តម្រូវការ ច្បាប់ លោក អ្នក ប្រហែលជា មាន សិទ្ធិ ថែម ទៀត ដែល ទាក់ទង ទៅ នឹង ព័ត៌មាន ផ្ទាល់ខ្លួន របស់ លោក អ្នក ។
អ្នកភូមិ ដែល មាន សាច់ញាតិ នៅ ទី ជិត ឆ្ងាយ ក៏ តែង ប្រើប្រាស់ ឱកាស នេះ អញ្ជើញ គ្នា មក ជួបជុំ សប្បាយ ដែរ ។
ម្តង មួយ ជំហាន ផ្តល់ ជូន អ្នកអាន នូវ របៀប និង បញ្ជី ជំហាន របស់ អ្នក ។
ការចុះ កុងត្រា អាចនឹង កើត មាន ឡើង នៅ ដើម ខែ ក្រោយ នេះ ៕
បើ ទោះបីជា ប្រព័ន្ធ នេះ អាចនឹង មិន ខ្លាំង ណាស់ វិទ្យាសាស្ត្រ សុពលភាព គឺ ត្រូវបាន ផ្អែក លើ ការអង្កេត យ៉ាង ទូលំទូលាយ អំពី ការបកស្រាយ សំភាសន៍ និង ការចំណាយ ពេលវេលា ជាមួយនឹង វាល ចង ក្រង ជា ឯកសារ មួយចំនួន តូច កណ្តុរ ។
មិន ចេះ ចប់ មិន ចេះ ស្រេច ទាល់តែសោះ ។
យើង ទទូច សុំ ឱ្យ រដ្ឋាភិបាល ពិចារណា លើ ភាព មិន ច្បាស់លាស់ ដែល មាន លក្ខណៈ ធ្ងន់ធ្ងរ នៃ ចំណាត់ការ នេះ ។
អ្នក ប្រាកដជា ស្រលាញ់ វា ច្រើន ជាង ប្រដាប់ ដទៃ ហើយ ។
រយៈពេល នៃ ការឃុំ ខ្លួន ហើយ ។
លុះ មកដល់ ក្រុង ស៊ីរ៉ា គូស យើង បាន ស្នាក់ នៅ ទីនោះ បី ថ្ងៃ ។
អ្នកស្រី បាន និយាយ ថា ឥឡូវ ខ្ញុំ ទៅ ដួស ទឹក ពី ផ្ទះ មិត្តភក្តិ រាល់ ថ្ងៃ ។
ការជួញដូរ មនុស្ស 1
បែរជា ខំ ក្រឡៃ ការពិត ថា អ្នកដទៃ មិន បាន យល់ដឹង ពី ស្ថានភាព ពិត ប្រាកដ នៅ កម្ពុជា
គាត់ គ្រាន់តែ លើក ឧទាហរណ៍ ហើយ ចង់អោយ មាន ការ ដក ពិសោធន៍ ប៉ុណ្ណោះ !
ប៉ងប្រាថ្នា របស់ ពួកគេ ។
របាយការណ៍ របស់ អង្គការ សហ ប្រជាជាតិ ចេញផ្សាយ កាលពី ឆ្នាំ ២០១៣ ដែល ស្ទង់ មតិ បុរស នៅ ទូទាំង អាស៊ី បង្ហាញ ថា ៣១៩ ភាគរយ នៃ អ្នកឆ្លើយតប ក្នុង ប្រទេស ឥណ្ឌូនេស៊ី ទទួលស្គាល់ ថា ពួកគេ បាន បង្ខំឱ្យ ស្ត្រី រួមភេទ ជាមួយ ។
ត្រូវ ជូនពរ ក្នុង នាម ព្រះជាម្ចាស់ ដ៏ ពិតប្រាកដ
លោក ប៉េត្រូហ្វ និយាយ ថា ផ្កាយ ទាំងនេះ មាន សារៈសំខាន់ សម្រាប់ ការសិក្សា អំពី សមាសធាតុ អ៊ីយ៉ូដ នៅក្នុង កាឡាក់ស៊ី របស់ យើង ។
