សម្លម្ជូរ គ្រឿង ឆ្អឹងជំនីរ ជ្រូក ពិសេស
សៀវភៅ រឿង រឿង អ្នក រឿង ខ្ញុំ បាន សម្ពោធ នៅ ផ្ទះ មេត្តា ៕
ត្រឹម សម្រាប់ វាយ ឯកសារ និង ប្រើប្រាស់ ធម្មតា ទូទៅ ដូចនេះ តម្លៃ របស់ វា ក៏ មិន សមរម្យ ផងដែរ ។
ចុច បង្ហាញ មេភាព
ឥឡូវ សុខចិត្ត ឱ្យ ទៅ តែងតាំង មុខងារ នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី មុខងារ នយោបាយ វិញ ប៉ុន្តែ ឱ្យ នៅ កន្លែង ដើម ទៀត គឺ មិន បាន ទេ បើ មិន អ៊ីចឹង ស្ទះ ៗ
សុភ័ក្ត្រ កុសុម៉ា ៖
វា បង្ហាញ ពី ការងើប ឡើងវិញ ពី វិបត្តិ សេដ្ឋកិច្ច ដែល បាន ប៉ះទង្គិច កាលពី ឆ្នាំ ២០០៩ និង ២០១០ ហើយក៏ បង្ហាញ ផងដែរ នូវ ការវាយតម្លៃ កាន់តែ លម្អិត ជាង មុន ទៅ លើ ការវិភាគ ឥទ្ធិពល ឥណទាន ក្នុង ដំណាក់កាល អនុម័ត ។
