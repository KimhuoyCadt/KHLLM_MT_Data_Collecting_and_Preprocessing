ខាងមុខ នេះ ព្រោះ ពួក លោក យល់ ថា ការផ្តន្ទាទោស ពួក លោក រួមទាំង ការដកហូត យក ឧបករណ៍ ផ្សេង ៗ
ទឹកដោះគោ ខាប់ ២ស្លាបព្រា បាយ
ឯកឧត្តម គួច ចំរើន ដឹកនាំ កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព ខេត្ត
តាមរយៈ ការធ្វើតេស្ត ទឹកនោម ត្រូវបាន រកឃើញ ថា អវិជ្ជមាន ។
ក្នុង រយៈពេល យូរ ពិតជា គ្រោះថ្នាក់ និង ជះឥទ្ធិពល អាក្រក់ ខ្លាំង ណាស់ ចំពោះ រាងកាយ របស់ អ្នក ដូចជា ៖
ចិន ព្រមាន អាមេរិក មិន ត្រូវ ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង
រវាង ប្រទេស ទាំង ពីរ វៀតណាម និង ឥណ្ឌា ៕
២ - ផ្ទុក ទម្ងន់ មិន លើស ៥ប្រាំ ភាគរយ នៃ ទម្ងន់ កម្រិត កំណត់ ត្រូវ ធ្វើ ការព្រមាន ជា លាយលក្ខណ៍ អក្សរ ។
ជាធម្មតា គាត់ តែងតែ មើល ខ្សែភាពយន្ត ទាំងនេះ នៅក្នុង រោងកុន ដែល មាន កៅអី ចំនួន ១០០០ របស់ គាត់ ។
តាំងពី ម្សិលម៉ិញ សង្ឃឹម ថា បាន ទៅ លេង ខាងក្រៅ ហើយ តែ អាកាសធាតុ មិន អំណោយផល អោយ សោះ !
កាយ៉ា មិន ហ៊ាន បញ្ចេញ សាច់ ទេ ធ្វើឱ្យ គេ សរសើរ ថា នាង ជា តារា ស្រគត់ស្រគំ ។
កងទ័ព ស្នើ ឱ្យ មាន ការចាប់ខ្លួន អតីត សង្ឃ សឺន ហាយ …
ផុត កំណត់ ការបោះឆ្នោត ត្រឹម ថ្ងៃអង្គារ ទី ២៦ ខែកុម្ភៈ
ឥឡូវនេះ វា ហាក់ដូចជា មិន មាន ច្បាប់ ទាល់តែសោះ នៅក្នុង ន័យ នេះ ពិភពលោក បាន ក្លាយទៅជា បំណែក តូច ៗ
ដូច្នេះ សូម អាជ្ញាធរ ជួយ រៀបចំ ឱ្យ បាន ស្អាត ជាង នេះ ទៀត ព្រោះ ប្រាសាទ ជាវ ប៌្បធម របស់ ជាតិ ខ្មែរ ។
ត្រចៀកកាំ និយាយ រឿង ខ្មាស បំផុត ពេល កំពុង ថត រឿង ឈុត ស្រើប ស្រាល
ពពួក អាហារ សម្បូរ ប៉ូតាស្យូម ជាង ចេក ដែល អ្នក គួរតែ ដឹង រស្មី កម្ពុជា
សំឡេង អ្នកស្រី ពេញ គា ៖
មតិ យោបល់ ចំណាប់អារម្មណ៍ និង តម្រូវការ របស់ ពួកគេ គឺជា កត្តា ដែល ជំរុញ ដល់ ការលក់ របស់ អ្នក ។
គោយន្ត កន្ត្រៃ បាត់ រយៈពេល ៣ ថ្ងៃ ប៉ូលិស រកឃើញ វិញ
ហ្នឹង គឺ ត្រូវតែ មាន មូលដ្ឋាន ដែល ជា មរតក នយោបាយ ។
កម្មវិធី នេះ ស្កេន ប្រព័ន្ធ ដើម្បី បញ្ជាក់ ឯកសារ ដែល មិន ចាំបាច់ និង ការជួសជុល កំហុស បញ្ជី ឈ្មោះ នោះ ។
ឆ្នាំ នេះ ក្រសួង នឹង ពង្រីក ការប្រមូល ពន្ធ លើ មុខ ទំនិញ ជាច្រើន ប្រភេទ ។
យើង អាច ធ្វើ បាន ប៉ុន្តែ ត្រូវ ឆ្លុះបញ្ចាំង ពី ខ្លួន យើង សិន ។
លោក សេង ធារិន ៖
ដើម្បី ចូលរួម បម្រើ ប្រទេសជាតិ ៕
ភាពរឹងមាំ នេះ ដោយសារ មាន ការគាំទ្រ ពី កំណើន នៃ វិស័យ កាត់ដេរ សំណង់ ទេសចរណ៍ គួបផ្សំ នឹង ការកើន ល្បឿន បន្តិច នៃ វិស័យ កសិកម្ម ។
របស់ ៥យ៉ាង ជួយ ឱ្យ ស្រី ៗ
ជនសង្ស័យ ម្នាក់ ត្រូវបាន ប្រជាការពារ និង មន្ត្រី នគរបាល មូលដ្ឋាន ចាប់ខ្លួន ភ្លាម ៗ
ហើយ ចិន បាន ត្រៀមលក្ខណៈ រួច ជាស្រេច ដូច្នេះ យើង នឹង ចាប់ផ្តើម ជាមួយនឹង ពួកគេ ។
កម្ពុជា ត្រូវបាន បែងចែក ទៅជា ២៥ ខេត្ត - រាជធានី ។
ជា ក្តីសង្ឃឹម បញ្ហា នៅសល់ អាចនឹង ត្រូវ ដោះស្រាយ ហើយ សេចក្តី លម្អិត នឹង ត្រូវ បាន បញ្ជាក់ ។
តើ ថ្ងៃ ៧មករា គួរ នៅជា ថ្ងៃ ឈប់សម្រាក បុណ្យ ឬ គួរ ត្រូវ ចាត់ទុក គ្រាន់ ជា ទំព័រ ប្រវត្តិសាស្ត្រ មួយ ?
សង្ឃឹម ថា កងកម្លាំង កម្ពុជា - សហរដ្ឋ អាមេរិក នៃ ប្រទេស ទាំង ពីរ …
វា អាច បណ្តាលឱ្យ ស្ត្រី ឆ្លង មេរោគ ផ្សិត ។
មនុស្ស ជាច្រើន នាក់ បាន រងរបួស ធ្ងន់ ស្រាល ត្រូវ បញ្ជូន ទៅ មន្ទីរពេទ្យ ភ្លាម ៗ
សូម បញ្ជាក់ ថា នាវា ចម្បាំង បំបាំង កាយ របស់ រុស្ស៊ី នេះ បាន ចាប់ផ្តើម ស្ថាបនា ឡើង នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០០៩ ។
ឃាត់ខ្លួននុស្ស ២នាក់ និង បិទ ផ្ទះ ចោល បណ្តោះអាសន្ន ពាក់ព័ន្ធ និង ករណី គ្រឿ …
ប៉ុន្តែ ទោះជា យ៉ាង នេះ ក្តី ប្រជាពលរដ្ឋ អាមេរិក ភាគ ច្រើន ជឿជាក់ ថា រុស្ស៊ី ពិត បាន លូក ដៃ ចូលក្នុង ការបោះឆ្នោត ។
សហរដ្ឋ អាមេរិក ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ជាង ៣៩០ លាន ដូស
គេ នៅសល់ ២ឆ្នាំ ទៀត ក្នុង កិច្ចសន្យា ជាមួយ ក្លិប ។
ការ ដែល នាង លីយ៉ុង អេប្រសូត បាន កូន ភ្លោះ នេះ ធ្វើឱ្យ គ្រួសារ របស់ នាង មាន ក្តីរីករាយ យ៉ាង ខ្លាំង ៕
ហើយក៏ ត្រូវបាន រាល់ ដាល ទៅដល់ ពូឃ្លាំង ទៀត នោះ ។
កាលពី ពេល មុន អ្នកជំងឺ ដែល ស្ថិត ក្នុង ការសង្គ្រោះ ដោយ ការយកចិត្តទុកដាក់ ខ្ពស់ មាន រហូតដល់ ជាង ៧០០០ នាក់ ។
រណ្តៅ ដី ភ្នំ ចេញ ទឹក ពណ៌ ដូច ទឹក សមុទ្រ ២រណ្តៅ ក្លាយជា កន្លែង លេង ទឹក ដែល អាច ទាក់ទាញ ភ្ញៀវ ទេសចរណ៍ នៅ ស្រុក ស្វាយ ចេក
ចូរ អនុវត្ត ធ្វើ បែប នេះ ឱ្យ វា ក្លាយទៅជា ទម្លាប់ មួយ ទើប អ្នក នឹង មាន សុខភាព ល្អ បាន យូរ ៕
បើ ទោះបីជា ស្ត្រី និង ទារក ម្នាក់ ៗ
គាត់ ក៏ ស្ទាប អង្អែល កូនគោ ដោយ ផ្សង ថា បើ ពិតជា ព្រះគោសណ្ឋិត មែន សូម ព្រះអង្គ យាង ទៅ តាម ខ្ញុំ ម្ចាស់ កុំ ខាន !
ទោះ យ៉ាងណា ក៏ដោយ យុវជន វ័យ ២៥ ឆ្នាំ រូប នេះ មិន មាន ចិត្ត ចង់ បោះបង់ ការចិញ្ចឹម ដែល ខ្លួន ចេះ នេះ ដោយ លំបាក នោះ ទេ ។
អ្នកនាំពាក្យ ក្រសួង ការងារ លោក ហេង សួរ មិន អាច ទាក់ទង សុំ ការអត្ថាធិប្បាយ ណាមួយ បាន ទេ នៅ ថ្ងៃទី ២ខែតុលា នេះ ។
មិន ទាន់ ល្អ ប្រសើរ នេះ គឺ បន្ទាប់ពី មាន ជនល្មើស មួយ ក្រុម បាន ស្ទាក់ កាប់ លើ ប្រជាពលរដ្ឋ បណ្តាល អោយ រងរបួស ធ្ងន់ ស្រាល ចំនួន ៤នាក់ ។
ឯកឧត្តម ឃួង ស្រេង ផ្ញើ សារលិខិត អបអរសាទរ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ក្ន …
មើល រូបថត របស់ មាន សូនីតា និង ថុង វុធ កាលពី ១០ឆ្នាំ មុន និង ពេល បច្ចុប្បន្ន នេះ គ្មាន ប្រែ សូម្បី បន្តិច !
មេរោគ ដែល ចម្លង ពី ពួក អឺរ៉ុប បាន រាតត្បាត សម្លាប់ ជនជាតិ ដើម អាមេរិក ទាំង លាន ៗ
ការប្រកាន់ ការរើសអើង មិន គួរ មាន នៅក្នុង សង្គម មនុស្ស ដែល មាន អរិយ ធ៌ម ឡើយ ។
លោក ម៉ាលីន បន្ត ថា ការព្រួយបារម្ភ ទាំងនេះ កើត ចេញ ពី របាយការណ៍ និង ប្រភព ពី សកម្មជន ។
១៤ ព្រះបាទ សេដេគា បាន ចាត់ គេ អោយ ទៅ អញ្ជើញ ព្យាការី យេរេ មាមក គាល់ នៅ ក្លោងទ្វារ ទី បី នៃ ព្រះដំណាក់ របស់ ព្រះអម្ចាស់ ។
ការធ្វើ បែប នេះ គឺ ធ្វើ ដើម្បីឱ្យ ទឹកត្រី ថ្លា ល្អ ។
បងប្អូន ពីរ នាក់ ស្រី ម្នាក់ ជា បង ទី១
ទស្សនាវដ្តី ទូរស័ព្ទ
ខណៈ ដែល ជំនាញ ទាំងនេះ មិន ត្រូវបាន បង្ហាញ ជាញឹកញាប់ តារា ទាំង នេះ ជួនកាល បង្ហាញ ទេពកោសល្យ របស់ ពួកគេ នេះ តាមរយៈ កម្មវិធី សម្តែង ចម្រុះ ឬ ក៏ កម្មវិធី ផ្សាយ ពិសេស សម្រាប់ អ្នកគាំទ្រ ។
បើសិនជា នៅ ភ្លៀង បើ ភ្លៀង ជាប់ ៗ
ហេតុ អ្វី ចាំបាច់ បង្កើត ក្រុមការងារ …
ព្រឹត្តិការណ៍ នេះ យក លំអាន តាម លំអាន របស់ សហព័ន្ធ កីឡា បាល់ទាត់ ទ្វីប អាស៊ី ខណៈ យើង រំពឹង ថា នឹង វិវត្តន៍ ឱ្យ កាន់តែ រីកចម្រើន នៅ ថ្ងៃ ខាងមុខ ។
សម្រាប់ អាជីវកម្ម ធំ ៗ
លាស់ ចៀសវាង ការចាប់ មនុស្ស ឥត មាន កំហុស ។
តាំងពី អាត្មាអញ បួស មកដល់ ឥឡូវនេះ មិន ដែល ឱ្យ ភិក្ខុ ស្រែក ហៅ ធ្ងន់ មាត់ ដល់ ពីរ ម៉ាត់ ឡើយ ណ្ហើយ ចុះ ចាំ ថ្ងៃ ក្រោយ សឹម ចម្រើន ព្រះកម្មដ្ឋាន ទៀត ធ្វើ លោកុត្តរញ្ញាណ ដែល ជា ខាងលើ ឱ្យ កើតឡើង ។
សចចៈស ចាច ធោិឌន ការតាំងចិត ថ ក្សុង ការបរ
ទោះបីជា មាន វ័យ ជ្រេ ហើយក៏ ដោយ តែ ដោយសារតែ ការ
ទៀត ដូចជា កូរ៉េ ខាងត្បូង ជាដើម ។
ពិសេស ឱ្យ ពួកគាត់ ជា កសិករ ធ្វើ យ៉ាងណា អនុវត្តន៍ តាម អ្វី ដែល យើង បាន ណែនាំ កន្លងមក ។
ដូចជា ម្ហូប អាហារ និង ថ្នាំ ពេទ្យ ប៉ុណ្ណោះ អនុញ្ញាតឱ្យ បើក ទ្វារ លក់ដូរ ។
សូម ឱ្យ បង ប្រុស បាន សំរេច ក្នុង ការប្រើប្រាស់ អ្វី ដែល បង ប្រុស មាន បំណង
ត្រឡប់ មកកាន់ គេហទំព័រ ជា ភាសា ខ្មែរ វិញ ។
មិន យ៉ូរិន បង្អួត រាង ក្នុង ឈុត ហែលទឹក
ទំនុក ដំកើង ១២៧ អត្ថន័យ ខ ដោយ ខ
តែ ហេតុ អ្វី បានជា លោក កឹម សុខា បាន ឈរ នៅក្នុង កៅអី តំណាងរាស្ត្រ ?
និង វត្ថុ រូប នានា ។
ស៊ូ ថេបៈ នៅ ថ្ងៃទី ១៣ ខែមករា ខាងមុខ ជា ថ្ងៃ បិទ ក្រុង បាងកក ទាំងមូល
អ្នក រាល់គ្នា ត្រូវ ប្រកាស ក្នុង ព្រះនាម ព្រះអង្គ ឱ្យ មនុស្ស គ្រប់ ជាតិ សាសន៍ កែប្រែ ចិត្ត គំនិត ដើម្បីឱ្យ រួច ពី បាប ។
ខ្ញុំ ចង់ ស្វែងរក ពាក្យ ថា ប្រាសាទ គឺ គ្រាន់តែ ខ្ញុំ ចាប់ផ្តើម
បញ្ហា នេះ ពេល ខ្លះ អាច នាំឱ្យ មាន ការតវ៉ា របស់ កម្មករ នៅ ពេល ដែល ពួកគេ មិន ពេញចិត្ត នឹង ការដំឡើង នេះ ។
លោក ល័ក្ខនិស្ស័យ យល់ស្រប ថា នឹង មាន ការផ្លាស់ប្តូរ នៅ ផ្នែក រាប់ រង សុខភាព និង អន្តោប្រវេសន៍ ។
មុន ចាន អ្នកកាប់
បែងចែក តាម ប្រភេទ អាយុ ។
ដូចនេះ ហើយ បើ លោកអ្នក ចង់ ជ្រើស ពេល ហាត់ ឱ្យ បាន ត្រឹមត្រូវ នោះ អ្នក គួរតែ ធ្វើ ទៅ តាម គោលបំណង ចម្បង របស់ អ្នក ។
អង្គការ សិទ្ធិ មនុស្ស អន្តរជាតិ ទទូច …
ពួក ខាង គណបក្ស ប្រជាធិបតេយ្យ ជាទូទៅ បាន ថ្កោលទោស ចំណាត់ការ នេះ ។
ជនរងគ្រោះ ទាំង ពីរ នាក់ មិន ត្រូវបាន គេ ស្គាល់ អត្តសញ្ញាណ នោះ ទេ ។
នេះ គឺជា គម្រោង ដំបូង របស់ សិល្បករ របស់ ខ្ញុំ នៅលើ សញ្ញា ៩៩ ហើយ ពួកគេ បាន ឈ្នះ !
ដូច្នេះ សរុប មក បញ្ហា សិទ្ធិ មនុស្ស លើ ពិភពលោក អាស្រ័យ លើ ការដាក់ ពិន្ទុ តាម ចិត្ត របស់ ប្រែត អាដាំ តែ ប៉ុណ្ណោះ ៕
ពេលនេះ សមត្ថកិច្ច ខណ្ឌ ដូនពេញ ជាង ៥០ នាក់ កំពុង ឡោមព័ទ្ធ និង ត្រៀម បង្ក្រាប ផងដែរ ។
លោក ឌឹម សុវណ្ណា រុំ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា ៖
តើ លោក យល់ យ៉ាងដូចម្តេច ចំពោះ ការផ្លាស់ប្តូរ នៅ ទីក្រុង ភ្នំពេញ នេះ ?
ដែល យើង ត្រួតត្រា លែង បាន ។
៤. ដើម្បី សុវត្ថិភាព និង ផាសុខភាព ៖
នាង រងគ្រោះ ទី២នេះ ក៏ មាន អាយុ ៨ឆ្នាំ ដែរ ហើយ ឪពុក ម្តាយ ក៏ បាន ដាក់ ពាក្យ បណ្តឹង ចោទ ថា គ្រូ រូប នេះ ធ្លាប់ ចាប់រំលោភ បាន ៥ដង ។
ដើម្បី ជ្រាប ច្បាស់ សូម ស្តាប់ បទសម្ភាស របស់ នាយ យ៉ាន និង លោក ម៉ៅ ដូច ខាងក្រោម ៖
ខ្ញុំ ក៏ លា លែង ឈប់ ធ្វើជា សមាជិក គណបក្ស សាធារណរដ្ឋ ហើយ ប្រគល់ កាត សមាជិក ឱ្យ គេ វិញ ។
ផ្ញើ តាម ប្រៃសណីយ៍ មក ឱ្យ ញុំ មក ចឹង
ក្នុង ពេល កន្លងទៅ លោក ហួង បាន សារភាព ថា លោក បាន លង់ ស្រឡាញ់ នាង វីកគី ភ្លាម ៗ
តែ អ្វី ដែល សំខាន់ ជាង នេះ គឺ លោក ត្រាំ ពិបាក ទទួលយក អំពី បរាជ័យ មួយ បន្ទាប់ពី សង្គ្រាម ប៉ាក កា បាន កើតមាន តាំងពី ច្រើន ខែ កន្លងមក ។
យើង មាន ជម្លោះ ដី ជាមួយ គាត់ ប៉ុន្តែ បាន ដោះស្រាយ ចប់ ហើយ ។
ទោះជា យ៉ាងណា ក្រុម កម្មករ ថា នឹង បន្ត តវ៉ា ទៀត បើ ពុំ មាន ដំណោះស្រាយ ៕
៩. សម្រាប់ ការកំសាន្ត
៧. គម្រោង កម្មវិធី
តែ នៅក្នុង សេចក្តីប្រកាស នា ពេល ថ្មី ៗ
ស្លាក ផ្តួលរំលំ រាជ រដ្ឋាភិបាល
លោក គីម ជុង អ៊ុន ទន្ទឹងរង់ចាំ ជំនួប នេះ ហើយ ខ្ញុំ ក៏ អ៊ីចឹង ដែរ ។
លោក ឱ្យដឹង ទៀត ថា មូលហេតុ ដែល ជ្រើសរើស ខេត្ត កោះកុង ធ្វើជា ខេត្ត គោលដៅ ស្រាវជ្រាវ ព្រោះ ខេត្ត នេះ ជាប់ ព្រំដែន និង ប្រទេស ថៃ កំពុង ជួបប្រទះ បញ្ហា ជាច្រើន ។
លោកស្រី បាន និយាយ ថា ច្បាប់ នេះ នឹង បន្ត ធ្វើ ការបកស្រាយ លើក ទី២ របស់ ខ្លួន នៅ ថ្ងៃទី ១២ ខែមិថុនា ។
អ្នក ខ្លះ គេ នៅជិត ៗ
ពត៌មាន ប្រចាំ ថ្ងៃ មិន ចង់ ដេក ទាំង ស្ត្រេស គួរតែ …
ចំពោះ អាល់ប៊ុម ទី១០ នេះ នឹង ចេញ លក់ នូវ ខែមិថុនា ខាងមុខ ៕
ចាក ប្រធាន ហើយ អូន ស្រី ៗ
ថៃ ប្រកាស បិទ ច្រក របៀង ទៅ តាម ព្រំដែន ខេត្ត បន្ទាយមានជ័យ
ដោយសារ បែប នោះ ហើយ ទើប អារម្មណ៍ គេ ច្របូកច្របល់ ទៅ លើ បញ្ហា ស្នេហា ជាជាង ក្នុង លក្ខណៈ ជា ម្តាយ និង កូន ។
ក្នុង នាម ជា នាយិកា ក្រុម របាំ ព្រះរាជ ទ្រព្យ ព្រះអង្គ បាន បង្ហាត់ នាដ កា ជាច្រើន ជំនាន់ ហើយ បាន បង្កើត របាំ ថ្មី ៗ
