សូម អរគុណ ចំពោះ ការជ្រើសរើស ក្នុង ការគាំទ្រ ដល់ ការងារ របស់ មូលនិធិ អេស៊ីលីដា - ចារ ឌីន សម្រាប់ ការអប់រំ AJF ។
លុយកាក់ កើត ខ្ទង់ ចំនាយ ច្រើន ក្រៅ ផែនការ ។
ទេសចរណ៍ កំពង់ឆ្នាំង
ដូច្នេះ យើង មិន អាច ចូល ជិត រូបចម្លាក់ ព្រះពុទ្ធ បាន ទេ ។
ហេតុផល អ្វី បានជា ពួកគេ ជួប វាសនា ខុសគ្នា យ៉ាង នេះ ?
លោក ចច អ៉ីដហ្គា ក៏ បាន បញ្ជាក់ អំពី ការងារ សំខាន់ ៗ
ចំណែកឯ កូនប្រុស មិន មាន រងរបួស អ្វី នោះ ទេ ។
បច្ចេកវិទ្យា អាល្លឺម៉ង់ តម្លើង នៅ ចិន
ដូច្នេះ នេះ គឺជា សញ្ញាណ នៃ ការវិវឌ្ឍ ដ៏ ពិតប្រាកដ មួយ ។
តុលាការ បង្គាប់ ការឃុំ ខ្លួន ឧកញ៉ា គិត ធាង
ឱ្យ បាន សមស្រប តាម កំរិត លក្ខខណ្ឌ ទីផ្សារ ការងារ ។
កម្មករ គ្រប់ រូប ក្នុង មណ្ឌល ឧស្សាហកម្ម អាង ហ៊ីប ត្រូវ ពាក់ ម៉ាស់ និង វាស់ កម្តៅ ខ្លួន មុនពេល ចូល រោងចក្រ ។
អ្វី កាន់តែ ចាប់អារម្មណ៍ ទៀត នោះ គ្រាន់តែ ស្វា បាប៊ូ នេះ យូរី ចំណាយ ប្រាក់ អស់ ច្រើន ជាង តម្លៃ តុបតែង របស់ ខ្លួន ថែម ទៀត
អ្នកនាង ជិន ចាន់ គឺជា អ្នកធ្វើការ ក្នុង បណ្ណាល័យ ។
ផ្លូវ ចង្អៀត ច្រក រហក ដើរ តាម សញ្ចារ ។
គាំទ្រ ពី ប្រទេស ថៃ យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ រហូត នឹកស្មាន មិន ដល់ ។
ច្បាប់ នៃ ការប្រើប្រាស់
បទពិសោធន៍ ២៣ ឆ្នាំ
ច្រើន សន្ធឹកសន្ធាប់ ផ្សាយ ពត៏ មាន មិន ត្រឹមត្រូវ បោក គេ បោក ឯង ដែរ !
អ្នកនាង ចន ច័ន្ទ លក្ខិណា និង គូស្នេហ៍
រយៈពេល នៃ ការបង់ រំលោះ ពី ៣ ឆ្នាំ ដល់ ៧ ឆ្នាំ
អង្គការ សិទ្ធិ មនុស្ស អន្តរជាតិ រិះគន់ ធនាគារ ពិភពលោក រឿង បណ្តេញ ពលរដ្ឋ
១៩ សូម អបអរសាទរ
ការិយាល័យ បោះឆ្នោត ខោនធី - អ្នកបោះឆ្នោត ថ្មី - ការបោះឆ្នោត និង ព័ត៌មាន សំរាប់ អ្នកបោះឆ្នោត - រដ្ឋលេខាធិការ រដ្ឋ កាលីហ្វ័នីញ៉ា
៥៣០០០ នាក់ ក្នុង ប្រទេស ចិន បាន ឆ្លង ជំងឺ ក្រោយពី ពួកគេ ផឹក ទឹកដោះគោ ។
គំនរ ឈើ ហ៊ុប ដែល ត្រូវបាន គេ កាប់ នៅ ប្រទេស ឥណ្ឌូនេស៊ី ។
ទេ ការងារ អ៊ីចឹង ៗ
ប៉ូលិស និង បាតុករ ប្រឆាំង ប៉ះទង្គិច គ្នា នៅ ថ្ងៃទី ៤
កន្លងមក លោកស្រី ការីឡាំ និយាយ ថា ហុងកុង អាច ដោះស្រាយ វិបត្តិ នេះ បាន ដោយ ខ្លួន ឯង ដោយ មិន ចាំបាច់ សុំ ជំនួយ ពី នរណា ឡើយ ។
ចំណែកឯ ពេលវេលា ចេញ លក់ ត្រូវបាន ក្រុមហ៊ុន កំណត់ យក ក្នុង ឆ្នាំ ២០១៨តែ ចំពោះ តម្លៃ ក្រុមហ៊ុន មិន ទាន់ បាន បង្ហើប នូវ ឡើយ ទេ ៕
មនុស្ស មួយ នាក់ បាន ស្លាប់ នៅក្នុង អគ្គីភ័យ នាវា មួយ នៅ ប្រទេស ក្រិក
លោក មានប្រសាសន៍ លើ វេទិកា ថា លោកស្រី ហ៊ីល ឡារី គ្លីនតុន នឹង ជា ប្រធានាធិបតី ពិសេស មួយ រូប ហើយ ខ្ញុំ មាន មោទនភាព ដែល បាន មក នៅ អែប លោកស្រី នា ល្ងាច នេះ ។
ត្រូវ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ហើយ ត្រូវ នៅ ឱ្យ ឆ្ងាយ ពី គ្រឿងញៀន ផងដែរ ។
ព្រោះ កន្លងមក មាន អ៊ីចឹង មក ហើយ ។
ក្បាច់ រួមភេទ មួយ នេះ អាច មើល ទៅ ពិបាក បន្តិច នៅពេល សាកល្បង ជា លើក ដំបូង ។
ផ្ទះ ព័ត៌មាន ជាតិ អ្នក និយម ពិសាស …
នៅ អាមេរិក តែ រដ្ឋាភិបាល ចិន ក៏ ជំទាស់ ចំពោះ ការចោទប្រកាន់ នេះ ដូចគ្នា ៕
អំឡុង ពេល នោះ ។
ការបើកបរ លើ ផ្លូវ រដិបរ ដុប វិញ រថយន្ត នេះ អាច ដោះស្រាយ បាន យ៉ាង ល្អ ។
ទោះបីជា យ៉ាង ក៏ដោយ នៅ ព្រឹក នេះ ពុំ មាន ការផ្ទុះ អំពើហឹង្សា កើត មាន ឡើង នោះ ទេ ។
នេះ យើង គ្រាន់តែ ជា ការចូលរួមចំណែក កសាង ធនធាន មនុស្ស ប៉ុណ្ណោះ ។
ចូរ យើង សប្បាយរីករាយ និង មាន អំណរ ឡើង
ទោះជា យ៉ាងណា លោក សុន ឆ័យ មិន អាច ទាក់ទង សុំ ការបំភ្លឺ បាន ទេ ។
ការសើរើ ដកហូត នេះ គឺ ដើម្បីឱ្យ ក្រុមហ៊ុន ដទៃ សិក្សា អនុវ គម្រោង បន្ត ។
ទៀត ដែល ពុំ ទាន់ បាន អនុវត្ត ។
ជារៀងរាល់ ថ្ងៃ អរគុណ
លោក ជូលី អូខា វឺរ៉ា បាវេរ៉ា
លោក ប៉រ និង កូនស្រី
មតិ ពលរដ្ឋ ទូទៅ ជុំវិញ ការរំលាយ បក្ស ប្រឆាំង ចេញ ពី ឆាក នយោបាយ
ខ្ញុំ សូម ប្រាប់ នេះ មិន មែន ជា ការចរចា ទេ ក៏ប៉ុន្តែ ជា កម្រិត នៃ នយោបាយ ដែល គេ ហៅ ថា ជា នយោបាយ ការទូត ដែល មាន ភាពទន់ភ្លន់ និង សុឆន្ទៈ ។
នេះ ជា ចរិយា សម្បត្តិ មួយ មាន ការចាំបាច់ បំផុត សម្រាប់ ភរិយា និង ត្រូវបាន ស្វាមី ស្រឡាញ់ និង គោរព រាប់អាន ។
អស្សខ ឡុង្ក សូត្រ ទី៤
ដែល នាង សម្រេចចិត្ត ថត សុទ្ធសឹងតែ ជា រឿង ដែល ល្អ ប្លែក ត្រូវចិត្ត របស់ នាង ។
សូម ជម្រាប ជូន ថា ទោះបីជា អ្នកស្រាវជ្រាវ បាន ចេញ សេចក្តី ព្រមាន អស់ រយៈពេល ប្រមាណ ជា ៣០ ឆ្នាំ ហើយ យ៉ាងណា ក្តី ក៏ប៉ុន្តែ បញ្ហា ផែនដី ឡើង កម្តៅ នៅតែ ជា បញ្ហា មិន ទាន់ អាច ដោះស្រាយ បាន ។
និមិត្ត សញ្ញា នៃ រេស៊ីស្ទ័រ នៅក្នុង គំនូស សៀគ្វី មាន ការប្រើប្រាស់ ផ្សេង ពី គ្នា តាម ប្រទេស និមួយ ៗ
ប្តី - ប្រពន្ធ ទាំង ២នាក់ ដែល រង ការចោទ ថា វាយ ធ្វើបាប ក្មេងស្រី អាយុ ៧ ឆ្នាំ ជា ឈ្នួល បម្រើ
លោក វេជ្ជបណ្ឌិត បាន អះអាង ថា មូលហេតុ ចម្បង នៃ ការកើនឡើង ជំងឺ គ្រុន ឈាម ដោយសារត ក្នុង ឆ្នាំ នេះ មាន កម្តៅ ខុសប្លែក ពី បណ្តា ឆ្នាំ មុន ៗ
ទំព័រ ដើម ចំណេះដឹង ទូទៅ មនុស្ស ឆ្លាត ច …
រួម ជាមួយ អាហារ តិច និក ទាំងនេះ ក៏ អាច ជួយ ឱ្យ កូន លូត កម្ពស់ បាន យ៉ាង ឆាប់រហ័ស
សំឡេង យំ ខ្សឹកខ្សួល យ៉ាង អណ្តឺត អណ្តក មួយ បាន រសាត់ ចូលមក លាន់ ឮ ក្នុង ត្រចៀក ខ្ញុំ ធ្វើឱ្យ ខ្ញុំ ត្រូវ ដើរ ទៅ រក ម្ចាស់ សំឡេង នោះ ។
គាត់ មាន លុយ ច្រើន ចូលទៅ ខារ៉ាអូខេ គាត់ មាន ស្រី ញី ។
ផែនការអនុវត្ត គណនេយ្យភាព សង្គម សម្រាប់ ការអភិវឌ្ឍ តាម បែប ប្រជាធិបតេយ្យ នៅ ថ្នាក់ ក្រោម ជាតិ ឆ្នាំ ២០១៦ - ២០១៨
សូម ស្តាប់ ការលើកឡើង ពី លោក ហ៊ុន ម៉ានី ៖
ទោះ ខឹង ឬ មិន ត្រូវចិត្ត ត្រង់ណា តែ នៅតែ យោគយល់ គ្នា នោះ អ្នក ទាំង២ ពិតជា មាន ភាព ចាស់ទុំ ហើយ ។
គ្រួសារ ខ្មែរ មួយចំនួន ធំ កាលពី ១០ឬ ២០ ឆ្នាំ មុន មិន ធ្លាប់ បាន សែន ព្រេន កុង ម៉ា នៅពេល ចូល ឆ្នាំ ចិន ទេ ។
លោក កាន់ កាប់ មុខតំណែង គន្លឹះ ជាច្រើន ក្នុង ជួរ កងទ័ព ។
ពេល ស្លាប់ ភ្លាម ព្រលឹង គាត់ បាន ឡើង ដល់ ឋានសួគ៌ និង បាន ជួប ទេវតា មួយ អង្គ ឈរ ស្ទាក់ ផ្លូវ ។
ផុស ជា មន្ត្រី បំរើ ការងារ ក្នុង សាលាខេត្ត ។
ដូច លោក បណ្ឌិត ឡូដ ជ៉ោនស៍ ប្រាប់ ថា អ្នក ហើយ អ្នកតែ ១គត់ ជា ពន្លឺ នៃ លោកីយ ។
អ្នកនយោបាយ រូប នេះ និយាយ ថា ការឃោសនា មិន ឱ្យ ពលរដ្ឋ កុំ ទៅ បោះឆ្នោត ជា ចេតនា បំបែកបំបាក់ សាមគ្គី ជាតិ ។
មកដល់ ពេលនេះ រដ្ឋាភិបាល កម្ពុជា ពុំ ទាន់ បាន បញ្ចេញ សំណៅ ដើម ចុងក្រោយ នៃ សេចក្តី ច្បាប់ ស្តីពី សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល នេះ ជា សារធារណៈ ឬ ដាក់ ឱ្យ មាន ការពិគ្រោះយោបល់ ណាមួយ ថែម ទៀត នោះ ទេ ដែល ធ្វើឱ្យ មាន ការរិះគន់ ជាច្រើន ពី អង្គការ សង្គម ស៊ីវិល នានា ៕
ដូច្នេះ ប្រាក់ កម្ចី មិន មាន សារៈសំខាន់ ដើម្បី ជួយ ដោះស្រាយ បញ្ហា កើតឡើង នៅក្នុង ប្រទេស នោះ ទេ ។
គ្រោះ រញ្ជួយ ដី នេះ ក៏ បាន កាត់ផ្តាច់ សេវា អគ្គិសនី និង ទូរស័ព្ទ នៅ តាម ក្រុង ជាច្រើន របស់ ប្រទេស អ៊ីរ៉ង់ និង អ៊ីរ៉ាក់ ដែល ជា ហេតុ ធ្វើឱ្យ មាន ការលំបាក បន្ថែម ទៀត ដល់ ក្រុម អ្នក ជួយសង្គ្រោះ ៕
សភា អាឡឺម៉ង់ កាលពី ថ្ងៃទី ១១ ខែមិថុនា បាន អនុម័ត ច្បាប់ មួយ ដែល តម្រូវ ឱ្យ ក្រុមហ៊ុន ធំ ៗ
ការតំឡើង នឹង ត្រូវ គិត ថ្លៃ សេវា ៥០ ដុល្លាល ប្រសិនបើ ចំងាយ របស់ អ្នក លើស ពី៥០០ ម៉ែត្រ ពី បង្គោល សេវា របស់ យើង ។
អ្វី ដែល កម្មករ បាន និយាយ គឺ ខុស ទាំងស្រុង ។
ក្នុង នោះ ដំណើរការបោះ បង្គោល កំណត់ ព្រំដែន គោក បាន ចាប់តាំងពី ឆ្នាំ ២០០៦ ។
ការគាបសង្កត់ លើ ប្រព័ន្ធ អ៊ិនធើណែត ការបន្តបង្ក្រាប លើ សេរីភាព បញ្ចេញមតិ ក្នុង ប្រទេស កម្ពុជា
ត្រូវបាន បញ្ចប់ ហើយ ដោយ មាន ក្រុម ចូលរួម មិន តិច ជាង ១ ពាន់ ក្រុម ទេ ក្នុង តំបន់ នីមួយ ៗ
នេះ បើ តាម សមត្ថកិច្ច បញ្ជាក់ ប្រាប់ សារព័ត៌មាន ស្និទ្ធ រដ្ឋាភិបាល ហ្វ្រេស ញូវ ។
ទើបតែ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ជីវភាព របស់ ខ្ញុំ បាន ប្រសើរ បន្តិច ដោយសារតែ កូន ម្នាក់ នេះ ។
តែង កើតឡើង នៅ ប្រទេស រុស្ស៊ី ៕
តាម ផ្លូវ នោះ ទម្រាំតែ ស្អាត បាន ម្តុំ ៗ
សេង នាង ភេទ ប្រុស
អញ្ចឹង ទេ តើ ទើប បាន បាត់ អ្នកនាង អ៊ុំ គន្ធា ពី សិល្បៈ ឱ្យ ឈឹង
ជាមួយគ្នា នេះ ផងដែរ ការកើត មុន និង ស្នាម ជាំ ក៏ អាច បណ្តាលឱ្យ មាន ស…
ប្រភេទៈ ចា ហួយ ស្វិត
រើ ដល់ ការខិតខំ បំ
ណាស់ ហើយ មើល ទៅ ដូច នៅក្នុង រឿង កុន របស់ ហូលីវូដ អញ្ចឹង ។
វា មិន ចំឡែក ទេ ដែល លោក ហ៊ិន ហែន និយាយ ភាសា វៀតណាម នោះ ព្រោះ គាត់ ធ្លាប់ បានេរស់ នៅ ជា មូយ ជនជាតិ វៀតណាម ។
សម្រាប់ សម្ព័ន្ធ ស្នេហា កំលោះ ក្រមុំ មិន សូវ មាន ការលូតលាស់ ទៅ មុខ ទេ ហើយ ពិសេស ងាយ កើត ជម្លោះ ថែម ទៀត ៕
សម្រាប់ ពួក សកម្មជន នៅក្នុង ប្រទេស កម្ពុជា ពួកគេ បាន ត្រូវ គេ ប្រាប់ ឱ្យ លាក់ ខ្លួន ហើយនិង បញ្ឈប់ សកម្មភាព នយោបាយ ។
ខ្មែរ ក្រោម ប្រុស ស្រី ឃ្លាត ពី អង្គរ ។
ឯ មន្ត្រី ជំនាញ បាន ប្រាប់ ថា ចំពោះ ករណី នេះ បើ មិន បិទ ក៏ ត្រូវ ផ្អាក សកម្មភាព ។
អ្នក ឈ្នះ រង្វាន់ ឆ្នោត ផ្សង សំណាង នេះ ត្រូវបាន ជ្រើសរើស ដោយ មិន ចំពោះ តាមរយៈ ប្រព័ន្ធ ម៉ាស៊ីន កុំ ព្យួទ័រ ។
បើ ប្រៀបធៀប រយៈពេល ដូចគ្នា កាលពី ឆ្នាំ ២០១៥ កន្លងទៅ គឺ មាន ការកើនឡើង ។
ដី ផ្ទះ លក់ ក្នុង ក្រុង
ទាំងនោះ បាន ក្លែង បន្លំ នូវ អាយុ ព្រោះថា ពួកគេ ចង់ សាកល្បង និង ចង់ ដឹង នូវ អ្វី ដែល ថ្មី ប្លែក ។
មាន ប្រទេស ចំនួន ៥២ ដែល អាចនឹង ងើប ផុត ពី វិបត្តិ ហើយ មាន សេដ្ឋកិច្ច ប្រសើរ ឡើងវិញ ខណៈ ដែល ប្រទេស ចំនួន យ៉ាងហោច ៥៨ ផ្សេង ទៀត នឹង មាន សេដ្ឋកិច្ច ដើរ យឺត បំផុត ពី នេះ ដល់ ចុង ឆ្នាំ ២០២២ ។
គុណ ប្រយោជន៍ និង គ្រោះថ្នាក់ នៃ ប្រទាល កន្ទុយ ក្រពើ
តាម ការអង្កេត មួយ ការយក ពន្ធ លើ ការបញ្ចេញ ឧស្ម័ន កាបូនិក គឺ មាន ឥទ្ធិពល តិចតួច ណាស់ លើ សេដ្ឋកិច្ច របស់ ប្រទេស ទាំងមូល ។
មាន ត្រៀម កន្លែង ដើរលេង ជាមួយ មនុស្ស ជា ទីស្រឡាញ់ ហើយ ឬ នៅ ?
ខ្ញុំ មាន ចម្ងល់ ថា ហេតុ អ្វី បានជា គាត់ និយាយ អ៊ីចឹង តើ គាត់ មើលឃើញ អ្វី ដែល យើង មើល មិន ឃើញ ។
គ្នា និង ងាក មក ប្រើ សេវាកម្ម នេះ កាន់តែ ច្រើន ឡើង ៗ
ពីព្រោះ បើ លោកអ្នក គ្មាន ប្រពន្ធ សម្រាប់ ធ្វើ កិច្ចការ ទាំង នេះ ទេ លោក អ្នក ប្រាកដជា ត្រូវ ជួល គេ នោះ ហើយ ជា ចំណូល នៃ កិច្ចការ ផ្ទះ ។
ដំណាក់កាល នេះ ហើយ ដែល ផុយ ស្រួយ បំផុត ក្នុង ជីវិត ស្នេហា ។
ដំណើរកំសាន្ត របស់ លោក អិត សួង និង ដំណើរកំសាន្ត ជាញឹកញាប់ មុន ក្រោយ គ្នា របស់ មនុស្ស គ្រាក់ ៗ
ជាតិ ការ ហ្វេ អាច មាន គ្រោះថ្នាក់ ដល់ អ្នក ។
មូលហេតុ ដែល កើតមាន ជាញឹកញាប់ បំផុត គឺ ការកង្វះ ទឹក រំអិល ។
មាន ផ្ទៃពោះ ដើម្បី រក្សា គភ៌ ឱ្យ នៅ គង់ មាន សុខភាពល្អ ។
នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន មួយ របស់ សាលា ក្រុង ដែល ចេញផ្សាយ ឱ្យដឹង កាលពី ម្សិលម៉ិញ ។
ទៀត មិន បាន ដឹង ចំនួន ហើយនិង បច្ច័យ ដែល ពួកគាត់ រក តាមរយៈ ផ្សេង ៗ
នៅក្នុង ន័យ នេះ យើង ឃើញ ថា មិន ត្រឹមតែ មនុស្ស ទេ ដែល ចេះ ចែករំលែក នូវ របស់របរ នំ
និង មនុស្ស ពេញ វ័យ
ទណ្ឌកម្ម អាមេរិក ចូល ជាធរមាន ខណៈ អឺរ៉ុប ព្យាយាម ការពារ ក្រុមហ៊ុន ខ្លួន
អាមេរិក សង្ស័យ លើ សំណើ ស៊ីរី អំពី ការលា លែង របស់ លោក អាសាដ
ក្រោយពី បាន គ្រប និង យក សម្ភារ ធ្ងន់ ៗ
