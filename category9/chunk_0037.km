ក្រុម ប្រជាពលរដ្ឋ បាន អះអាង ថា នេះ ជា ការវាយប្រហារ ភេរវកម្ម ដំបូង ដែល គេ មិន បាន រំពឹង ថា កើតឡើង ។
អាច ធ្ចើ បាន បើសិនជា យើង មាន ឆន្ទះ ពឹត ។
ប៉ុន្តែ ចូរ បងប្អូន កុំ គ្រាន់តែ ពឹង លើ អ្វី ដែល ខ្ញុំ បាន លើកឡើង តែ ចូរ យើង នាំគ្នា មើល នូវ អ្វី ដែល ព្រះគម្ពីរ បាន ចែង ។
ពិសេស យូរី គេ មើលឃើញ ថា នាង ពិតជា បង្កប់ ភាពសិចស៊ី ណាស់ នៅក្នុង បទចម្រៀង នេះ ។
ស្រី លាភ ឥឡូវ ប្រុស ៗ
នេះ ជា ការប្រកាស របស់ អ្នកនាំពាក្យ ម្នាក់ នៃ រដ្ឋាភិបាល អង់គ្លេស ។
នៅ ថ្ងៃ នេះ រាល់ ឧបទ្រព និង បញ្ហា អាក្រក់ ទាំងឡាយ បាន ផ្លាស់ប្តូរ មក ល្អ ប្រសើរ បន្តិច វិញ ហើយ ធ្វើ អ្វី ក៏ តែង ជឿនលឿន គួរសម ជានិច្ច ។
និង ដឹង គុណ អាមួយខ ពួក អា ល្ងង់ មីល្ងង់ នៅ បឹងកក់ ។
ហើយ អាច ប៉ះពាល់ ដល់ សេរីភាព បញ្ចេញមតិ និង សេរីភាព បង្កើត សមាគម នៅក្នុង ប្រទេស កម្ពុជា ដែរ ឬ យ៉ាងណា ?
ប៉ុន្តែ ការចូលរួម ក្នុង កម្មវិធី នេះ បាន ផ្តល់ លទ្ធផល ហួស ពី ការរំពឹងទុក ។
អាគារ ទីស្នាក់ មាន ចំនួន ៥ នៅ ភ្នំពេញ ។
ពួក អ្នកជំនាញ ការ និយាយ ថា វា ជា ការផ្ទុះ គ្រុន ឈាម អាក្រក់ បំផុត នៅក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ មក នេះ ។
ចិញ្ចៀន អ៊ីសាបេឡា បរិមាណ អិល
ហ្គីសឡាហេតុ អ្វី បានជា អ្នក មិន ទុកចិត្ត ?
អ្វី ដែល សំខាន់ ដែរ នោះ គឺ ថា គួរតែ ចៀសវាង ការអោន ក្បាល ទាប ជាង ចង្កេះ ។
ខ្លះ មនុស្ស នឹង បំពេញ ក្តីសង្ឃឹម ពិភពលោក បំពេញ ក្តីសង្ឃឹម ដល់ ខ្លួន គេ ផ្ទាល់ ។
មិន ចាប់អារម្មណ៍ ព្រោះ ខុស វ័យ អាច ផ្ញទើៅ កូន ៗ
ខ្លួន ទៅ តាម ឆ្នាំ កំណើត ទាំងនោះ ។
លោក បាន មានប្រសាសន៍ ថា អ្វី ដែល ក្រុម ឧទ្ទាម ត្រូវការ ខ្លាំង បំផុត នៅ ពេល នេះ គឺ ការហ្វឹកហ្វឺន ក៏ប៉ុន្តែ លោក បាន ថ្លែង ច្បាស់លាស់ ថា ការណ៍ នេះ មិន គួរ អាស្រ័យ លើស . រ. អ. ទេ ។
ប្រាសាទ កុដិ គូរ សូម មើល ៖
ក៏ប៉ុន្តែ សុំ ឱ្យ អ្នក ដែល អនុវត្ត សាល ដីកា ហ្នឹង អនុវត្ត ឱ្យ បាន ត្រឹមត្រូវ ។
តាមពិត ទៅជា វែបសាយ សម្រាប់ ផ្សាយ រឿង បោកប្រាស់ ស្រាប់ ទៅ ហើយ ។
គាត់ បែរ ទៅជា ពិសារ ស្រា ហើយ ការពិសារ ស្រា នេះ ជា ផលវិបាក ប៉ះពាល់ ដល់ សង្គម កម្ពុជា យើង ។
ក្រុម ជនជាតិ ប៉ាឡេ ស្ទីន ធ្វើ បាតុកម្ម ទាំង នេះ ចង់បាន សិទ្ធិ វិលត្រឡប់ ទៅកាន់ ដែនដី ដែល ពួកគេ បាន ចាកចេញ នៅពេល បង្កើត ប្រទេស អ៊ីស្រាអែល ។
យើង អាច ស្គាល់ ពី លក្ខណៈ របស់ បុគ្គល ម្នាក់ បាន ច្រើន តាមរយៈ ឈ្មោះ របស់ គាត់ ។
ម្តេច ធ្វើ ព្រងើយ ច្រៀង ដោយ ៖
ប៉ុន្តែ ដោយសារតែ មុខរបរ បណ្តុះ ផ្សិត ចេះតែ កាក់ កប ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ធ្វើឱ្យ ម្ចាស់ កសិដ្ឋាន ខាងលើ បាន បង្រីក មុខរបរ របស់ ខ្លួន កាន់តែ ធំ ទៅ ៗ
លោក គិត ថា ថ្ងៃ ក្រោយ តំបន់ នេះ នឹង ក្លាយជា កន្លែង ដែល សំបូរ ទៅ ដោយ ជនជាតិ ចិន ។
មន្ត្រី របស់ វា មាន ធម្មតា បន្តិចបន្តួច ។
មនុស្ស ស្រី ងាប់ ប្រដាប់ ភេទ ព្រោះតែ ចម្លើយ ទី៣ ។
នេះ គឺជា បញ្ហា មួយ ដែល សង្គម យើង កំពុង ជួបប្រទះ ។
លោកយាយ ប្រាប់ ថា នេះ កាន់តែ ច្បាស់ តែម្តង ប្រសិនបើ ពេល មាន អី ហូប ឆ្ងាញ់ ៗ
លោក បាន បញ្ជាក់ ឥឡូវ កម្លាំង លោក កំពង់ស្រាវជ្រាវ រុករក មុខ សញ្ញា ហើយ ដោយ មិន នៅ ហែ អង់ ឡើយ ។
ខ្ញុំ មិន ឱ្យ កូនស្រី របស់ ខ្ញុំ ធ្វើ រឿង ឆ្កួត ៗ
ពី ស្ថាប័ន រដ្ឋ មិន ខុសពី ការស្រក់ ឈាម មួយ តំណក់ ម្តង ៗ
ទីបំផុត ខ្ញុំ អាច នៅក្នុង ពេលវេលា មួយ របស់ ខ្ញុំ ខ្ញុំ នឹង បំបែក ខ្លួន ចេញ ពី អាមេរិក ។
ខ្ញុំ បន្ត ការងារ ស្ម័គ្រចិត្ត បណ្តើរ ហើយ ខ្ញុំ ព្យាយាម ស្វះស្វែងរក ការងារ ធ្វើ គ្រប់ ច្រកល្ហក ។
ក៏ គ្មាន ការអាក់អន់ចិត្ត គ្នា ដែរ កំពុង មើល ចិត្ត គ្នា ។
គេ មិន អាច ចាត់ចែង គំរោង សាងសង់ នេះ ដោយ មាន ការចូលរួម របស់ ពួក អ្នក សាងសង់ តែ ប៉ុណ្ណោះ ទេ ។
ដែល អ្នក ធ្វើ ការងារ បាន ឈប់ សំរាក ។
គ្រូសូត្រ ក្រោយ !
ចាំ មើល ខ្ញុំ នឹង ឆ្លើយតប នៅ ពេល ក្រោយ ។
យើង នឹង ធ្វើ សេចក្តីរាយការណ៍ បន្ថែម ទៀត ជា បន្តបន្ទាប់ …
បើ អ្នក មិន ចាប់ផ្តើម ធ្វើឱ្យ ខ្លួន ឯង មាន ទំនាក់ទំនង ជាមួយ អ្នកដទៃ វិញ ទេ ។
ហើយ សូម កំណត់ ពេល មួយ
ក្រោយ កើត ហេតុ សមត្ថកិច្ច ជំនាញ បាន យក រថយន្ត ទាំង ពីរ ទៅ រក្សាទុក នៅ កន្លែង រង់ចាំ ការដោះស្រាយ ពី ម្ចាស់ រថយន្ត បង្ក តាម ផ្លូវ ច្បាប់ ។
ក្នុង ចំណោម សំណួរ ទាំងនោះ មាន តែ មួយ សំណួរ ទេ ដែល ខ្ញុំ ចង់ ឆ្លើយ គឺ ៖
ទូលបង្គំ សូម សន្យា ថា នឹង ការពារ
អរគុណ លោក ត្រឹមត្រូវ ហើយ ដោយសារ រក មិន បាន ទើប ដាក់ ស៊ុម នេះ ទៅ
ពួកគេ មិន កសាង បន្ថែម លើ បរាជ័យ នោះ ទេ ហើយ បន្ត ចាញ់ ក្រុម អ៊ុយក្រែន ៥០ ។
ក្នុង លោក នេះ មាន មនុស្ស ដែល សម្បូរ គំនិត ល្អ ៗ
ព្រះនឹង ប្រទាន ពរ ឱ្យ អ្នក រាល់គ្នា
ផ្ទះ ព័ត៌មាន សុខភាព ចូលចិត្ត ញ៉ាំ ឪ …
ក្រសួង ការពារ ជាតិ ចក្រភព អង់គ្លេស មិន បាន ឆ្លើយតប សំណើ សុំ ធ្វើ អត្ថាធិប្បាយ នោះ ឡើយ ។
ទូលបង្គំ តែង ចូល ទៅក្នុង សាលាប្រជុំ នានា ជាញឹកញាប់ ដើម្បី ធ្វើទុក្ខ ទោស អ្នក ទាំងនោះ បង្ខំឱ្យ គេ លះបង់ ចោល ជំនឿ របស់ ខ្លួន ។
កម្មករ ម្នាក់ នេះ បាន តស៊ូ ជាមួយ សិប្បកម្ម នេះ អស់ រយៈពេល ២៩ ឆ្នាំ មកហើយ ។
ដង្វាយ ធួន របស់ ទ្រង់ យកឈ្នះ លើ សេចក្តីស្លាប់ ហើយ ទ្រង់ អនុញ្ញាតឱ្យ មរណជន ដែល ស័ក្តិសម ទទួលបាន ពិធី បរិសុទ្ធ ជំនួស ទាំងអស់ នៃ សេចក្តីសង្គ្រោះ ។
អស់ រយៈពេល ជាច្រើន ឆ្នាំ ក្រុមគ្រួសារ ទាំងនោះ បាន ព្យាយាម គ្រប់ បែបយ៉ាង ។
រូបភាព អាច បង្ហាញ ពី អ្វី មួយ ដោយ ពុំ ចាំបាច់ អត្ថាធិប្បាយ ។
វា ជា កន្លែង ដែល ផ្តល់ឱ្យ ប្រជាពលរដ្ឋ នូវ ជីវិភាព ផ្សេង ៗ
ក្បាច់គុន នេះ គេ វ៉ៃ ដោយ ប្រើ ជើង និង កណ្តាប់ដៃ ជង្គង់ តែ មិន អនុញ្ញាតឱ្យ ប្រើ កែង ឡើយ ។
សំណួរ នេះ នាំ ខ្ញុំ ត្រឡប់ មកវិញ កាលពី ជាង ១០ឆ្នាំ មុន នៅ ពេល ដែល ខ្ញុំ ជា អ្នក ដាក់ ពាក្យ សុំ ការងារ ជា លើក ដំបូង ។
ដំបូង គឺ សំពះ អាចារ្យ ។
ដែល ធ្វើអោយ ខ្ញុំ ជ្រើសរើស យក មនុស្ស ស្រី ម្នាក់ មក ធ្វើជា គូរ គ្រង នោះ ទេ
ខ្ញុំ សុំ នៅ ស្ងៀមស្ងាត់ និង កុំ ភ័យ ។
ជនសង្ស័យ ៥នាក់ មាន អ្នក ជក់ និង អ្នកលក់ ត្រូវ នគរបាល បង្ក្រាប និង ដកហូត វត្ថុតាង ទ្រង់ទ្រាយ ធំ
សព្វ ថ្ងៃ នេះ ព្រះជាម្ចាស់ គង់ នៅក្នុង ចិត្ត អ្នក ជឿ គ្រប់ រូប ។
ឥឡូវ រឿង ដដែល នេះ កើតឡើង ម្តង ទៀត ។
វង្វេង នឹក រឮ កស្រី ។
ដែល កាត់បន្ថយ អាយុជីវិត យើង បាន ។
ធ្វើ នំបញ្ចុក លក់ … ពេលនេះ ដាច់ ច្រើន តោន ណាស់
ភ្លៀង រាំង ភ្លៀង រាំង យ៉ាងណា យ៉ាង ណី បងប្អូន អ្នក បាត់ដំបង ។
នេះ គឺជា អ្វី ដែល ពួកគាត់ បាន ពន្យល់ ប្រាប់ ខ្ញុំ ។
នោះ គឺ របៀប ក្នុង ការនិយាយ ទៅកាន់ មេឃា ។
ទឹកឃ្មុំ ល្អ បំផុត តែ វា កាន់តែ ល្អ ប្រសិនបើ យើង ទទួលទាន នៅ ពេលវេលា ទាំង នេះ
ដូច្នេះ ទំនាក់ទំនង គឺ នៅតែ មាន សភាព ដដែល ។
នៅ ថ្ងៃ នេះ បើ ឯង រាល់គ្នា ឮ សំឡេង ទ្រង់
បទល្មើស នេសាទ កើតឡើង ក្នុង រដូវ ហាមឃាត់ មន្ត្រី កសិកម្ម ថា គ្មាន ទេ …
គួរ ត្រូវបាន កែប្រែ កែតម្រូវ យូរ ៗ
ធ្វើអោយ មនុស្ស ជោគជ័យ ឡើយ … នេះ គឺជា រឿង ចំលែក ណាស់ ព្រោះ ការចង់
អ្នកនយោបាយ នឹង មិន មាន លទ្ធភាព ទទួលបាន សន្លឹក ឆ្នោត ច្រើន ថែម ទៀត ទេ តាមរយៈ ការប្រឆាំង ទៅនឹង ច្បាប់ នេះ ក្នុង អំឡុង ពេល នៃ ការធ្វើ យុទ្ធនាការ ។
នាងខ្ញុំ មិន អាច បើក ភ្នែក បាន ពេល នោះ ខ្ញុំ គិត ថា វា ប្រាកដជា ខ្វាក់ ហើយ ។
ហេតុ នេះ ហើយ ឥឡូវ យើង នឹង ប្រាប់ ដល់ អ្នក ពី វិធី មួយ ដែល នឹង ជួយ ដោះស្រាយ បញ្ហា របស់ អ្នក បាន ដោយ គ្រាន់តែ អនុវត្ត តាម ៤ជំហ៊ាន ងាយ ៗ
ខ្ញុំ ជា អ្នកគ្រាំ ទ្រ អ្នក និង ស្ងើចសរសើរ នូវ ចំណេះដឹង របស់ អ្នក ។
កំពុង ដក ស្កូវ ឱ្យ ឪពុក ស្រាប់តែ កូនប្រុស តូច សួរ ៖
នៅក្នុង តំបន់ អង្គរ កន្លងមក មាន ដូចជា ៖
លោកស្រី ស្ទុះ ចេញ ទៅ បើក ទ្វារ ផ្ទះ ។
លោក អ្នក អាច ដឹង ពី ផលិតភាព តាមរយៈ ការស្វែងយល់ ពី ប្រព័ន្ធ ការងារ ។
ចំពោះ ការចូល បុណ្យ សព កុមារា លង់ទឹក នា ពេលនេះ គ្រួសារ សព នីមួយ ៗ
៣៦ ពេល នោះ ព្រះយេស៊ូ យាង ចេញ ពី មហាជន ចូល ទៅក្នុង ផ្ទះ ។
មាន ពេល ខ្លះ ខ្ញុំ ក៏ បាន ស្វែងរក ចម្លើយ ឃើញ ។
ប្រធាន តុលាការ ក្រុង ភ្នំពេញ នឹង ត្រូវ ដកហូត ពី តំណែង ?
ខាងមុខ នេះ ត្រូវ មាន ចៅក្រម យ៉ាងតិច ៩រូប គាំទ្រ ។
ខ្ញុំ ស្រវឹង ហើយ ថា មិន ស្រវឹង ប្រើ ពាក្យ ម្លឹង ៗ
សូម កោតសរសើរ ព្រះបិតា ព្រះបុត្រា និង ព្រះវិញ្ញាណ ដ៏ វិសុទ្ធ
ទាំងនេះ គឺជា អ្វី ដែល កើតឡើង នៅក្នុង រាង្គកាយ របស់ មនុស្ស ស្រី ម្នាក់ នៅពេល ពួកគេ មាន សម្រើប ផ្លូវភេទ ។
ត្រូវបាន រើ ចេញ និង ដាក់ គរ នៅក្នុង បរិវេណ ទីនេះ ផងដែរ ។
ខ្ញុំ មាន បំណង សង់ ព្រះដំណាក់ សំរាប់ តម្កល់ ហិប សម្ពន្ធ មេត្រី របស់ ព្រះអម្ចាស់ ហើយ ជា កំណល់ ព្រះបាទា របស់ ព្រះនៃ យើង ។
ខ្ញុំ ជា បុគ្គល ម្នាក់ ដែរ ដែល ប៉ះពាល់ ។
លើក គម្រោង ស្នើសុំ ប៉ុន្តែ នៅ ពេល នេះ គឺ ពុំ មាន កំណត់ ទៀត ទេ ដែល ប្រទេស និមួយ ៗ
នេះ គេ បាន ឃើញ មាន ក្រុម មនុស្ស ៣នាក់ បាន
មាន មិត្ត យល់ ចិត្ត ម្នាក់ ប្រសើរ ជាង មិត្ត ធម្មតា ១០០០ នាក់ ។
និង សហការ គ្នា ទោះជា អ្នក នៅ ទីកន្លែងណា ក៏ដោយ ។
ត្រូវ ចាប់ផ្តើម ធ្វើ អ្វី ដែល អ្នក បាន គ្រោង ទុក
កុំ ភ្លេច ចែករំលែក ទៅកាន់ មិត្តភក្តិ បាន ដឹង ផង !
លោក ក៏ បាន អះអាង ដែរ ថា រហូតមកដល់ ពេលនេះ ក្រុម លោក កាន់តែ រីកចម្រើន នៅ រាល់ ពេល ប្រកួត ម្តង ៗ
លោក បន្ថែម ថា កង នាវា សហរដ្ឋ អាមេរិក ក៏ បាន រៀនសូត្រ ពី កង នាវា កម្ពុជា ដែរ ។
ទៀត ដោយ ហេតុ ថា វា មាន ភាពងាយស្រួល ក្នុង ការគ្រប់គ្រង ជាង ។
ទំព័រ ដើម ស្លត ល្អ បំផុត
នេះ ហាក់ដូចជា រឿង ចម្លែក និង សប្បាយ មួយ ។
ក្រោយពី ពួកគេ ស្លាប់ ពួកគេ មិន រស់ នៅ កន្លែងណា ផ្សេង ទៀត ទេ ។
សូម បញ្ជាក់ ដែរ ថា កន្លងមក អង្គការ សិទ្ធិ មនុស្ស ធំ ៗ
ការទទួលបាន នូវ ការធ្វើតេស្ត និង ព្យាបាល ជំងឺ ឆ្លង តាម ការរួមភេទ គឺ វា ងាយស្រួល ជាង អ្នក គិត ទៅ ទៀត ហើយ ភាគ ច្រើន អាច ព្យាបាល អោយ ជាសះស្បើយ បាន ។
ក៏ តែង មាន ការសហការ ពី អ្នកដទៃ មកវិញ ដែរ ។
អាយុ ត្រឹមតែ 23 ឆ្នាំ ខិតខំ ប្រឹងប្រែង ខ្លួន ឯង រហូត អាច សម្រេច បំណងប្រាថ្នា របស់ ខ្លួន
កម្មវិធី ថត រូប គ្រួសារ ក្រីក្រ និង ស្កេន មេដៃ សូម ទាញយក នៅ ទីនេះ
៨ ព្រះបាទ អប៊ី ម៉ាឡិច ក្រោក ឡើង ពី ព្រលឹម ស្តេច កោះហៅ អ្នកបំរើ ទាំងអស់ មកហើយ រៀបរាប់ប្រាប់ អំពី ហេតុការណ៍ អស់ ទាំងនេះ ។
ក្នុង នោះ អ្នក មិន ពាក់ មួក សុវត្ថិភាព ពេល គ្រោះថ្នាក់ ចរាចរណ៍ ១៤នាក់ យប់ ៤នាក់ ។
ឥលូវេយើង នឹង បង្ហញ ថ្រ គប់ ចំនួន ទំង អស់ កងនុ
ម្តង តែងតែ អុក ឡុក គ្រួសារ ។
ម្យ៉ាងទៀត និយោជក អាមេរិក ខ្លះ មិន ផ្តល់ ការធានារ៉ាប់រង សុខភាព ទេ ដែល ធ្វើឱ្យ ពលរដ្ឋ ខ្លះ ត្រូវ បង្ខំ ទិញ ការធានារ៉ាប់រង សុខភាព ដោយ ខ្លួន ឯង ។
ខ្ញុំ ត្រូវបាន បី បាច់ ចិញ្ចឹម ដោយ ឪពុក ម្តាយ ដ៏ ល្អ ប្រពៃ របស់ ខ្ញុំ ហើយ ខ្ញុំ មាន ជីវិត យ៉ាង រីករាយ ។
ប្រទះឃើញ គ្រាប់ យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ
កាលណា វិវាទ ថយចុះ ផលិតភាព កើនឡើង ធ្វើឱ្យ សេដ្ឋកិច្ច កើនឡើង ។
អាមេរិក នឹង ធ្វើតេស្ត ធំ ៗ
គហដ្ឋ សីល ទាញយក សៀវភៅ
ពត៌មាន ប្រចាំ ថ្ងៃ ក្រោយ ខែ នេះ កុរម មែនិង ថោះ មិន កើតទុក្ខ រឿង ខ្វះ លុយ ទៀត ទេ
ពាក់ ម៉ាស មុខ បិទ តែ ទំនងជា ក្មេងស្រី ស្អាត ៗ
ក៏ ហៅ បាន តាម ឈ្មោះ ទាំងអស់
ដល់ កម្មករ និយោជិត ឱ្យ បាន ទាន់ ពេល ស្រប តាម ច្បាប់ ។
ពេល យប់ ឱ្យ រាប់ សុក្រោជា ទី១រៀង គ្នា រហូតដល់ សុក្រោវិញ ។
មាន ន័យ ថា អំណាច ទាំងអស់ ត្រូវ ធ្លាក់ ទៅ នាយក រដ្ឋមន្ត្រី ។
ដូចនេះ កុមារ មិន សូវ ជា ចាប់អារម្មណ៍ មក មើល ទូរទស្សន៍ នោះ ទេ ។
៤ចំណូល ពេល អនាគត
កម្មវិធី ភាសា ឡាវ ក៏ ជា កម្មវិធី ចុងក្រោយ បំផុត មួយ ដែរ ដែល យើង ទើប បាន សម្ពោធ ។
ស្គាល់ ចរិត របស់ ស្ត្រី តាមរយ ការពាក់ ចិញ្ចៀន របស់ នាង
ពួកគេ បាន រកឃើញ នូវ មុខងារ ថ្មី ៗ
អ្នកនាង សូដានីតា ក៏ បាន បញ្ជាក់ ថា នេះ ជា លើក ទី១
ហេតុ អ្វី មនុស្ស ចាំបាច់ វះកាត់ ប្តូរ ក្រលៀន ?
មាន ពាក្យ ចចាមអារ៉ាម ថា ស្វាមី របស់ លោកស្រី នៅតែ លួច ទៅ ជួប នាង ហ្យុន ។
បំបាត់ អនាធិបតេយ្យ ចំណត អធិការដ្ឋាន ក្រុង ធ្វើ មិន បាន ប្រគល់ ឱ្យ ស្នងការដ្ឋាន
ក្នុង ការបរិភោគ កុមារ ដែល មាន សកម្មភាព ល្មម បរិភោគ អាហារ ដែល ខ្លួន ត្រូវការ ៕
ឆ្នាំ ច មហាសំណាង លក់ ត្រឹម៣ ថ្ងៃ គ្រប់ ថ្លៃ អីវ៉ាន់ សែន
បច្ចុប្បន្ន នាង ជា តារា សម្តែង និង ជា ពិធីការិនី ។
សហជីព ប្រកាន់ ជំហរ ប្រារព្វ ទិវា ពលកម្ម អន្តរជាតិ នៅ ទីលាន ប្រជាធិបតេយ្យ ទោះបី សាលា រាជធានី មិន អនុញ្ញាត
ពួកគេ បាន អំពាវនាវ ឱ្យ មាន ដំណើរការ នយោបាយ ដឹកនាំ ដោយ ស៊ីរី ដើម្បី សម្រេច សន្តិភាព តាមរយៈ កិច្ចសន្ទនា ដែល ឆ្លើយតប ទៅនឹង ក្តី ប្រាថ្នា ស្រប ច្បាប់ គ្រប់ ផ្នែក នៃ សង្គម ស៊ីរី និង គោរព ឯករាជភាពស៊ីរី ៕
ពួកគេ បាន ធ្វើ តាម ទំនើងចិត្ត របស់ ខ្លួន ពួកគេ នៅតែ ចចេស រឹងរូស ប្រព្រឹត្ត តាម ចិត្ត អាក្រក់ របស់ ខ្លួន ពួកគេ បែរ ខ្នង ដាក់ យើង មិន ព្រម ងាក មុខ មក រក យើង ទេ ។
កត់ក្រឹត្យ វិន័យ និង រំយោល អាវ គេ ឱ្យ វែង ៗ
យើង ចង់បាន យុវជន ច្រើន ជួយ ធ្វើការ ។
ពេល មកដល់ ផ្ទះ ខ្ញុំ បាន
៨ អ្នក ទៅជា អង្គុយ ឱប ដៃ រង់ចាំ ឱ្យ ស្ថានភាពល្អ ប្រសើរឡើង
ដើម ទទឹម នេះ រីកលូតលាស់ ល្អ ហើយ ផ្តល់ ផ្លែ រៀងរាល់ ឆ្នាំ ។
ប្រសិនបើ អ្នក បរិភោគ អំបិល មួយ ក្រោម នៅក្នុង រយៈពេល ដ៏ ខ្លី នោះ អាច បណ្តោល ឱ្យ ស្លាប់ បាន ។
កម្មករ រោងចក្រ ចំនួន ដប់ នាក់ ត្រូវ ព្យួរ ការងារ ក្នុង បរិបទ នៃ ការបោះឆ្នោត
ប៉ាយោច រឺ ប៉យោច អ្នកស្រុក អ្នកស្រែ ចំការ តាម ផ្សារ តាម ផ្ទះ
ហេតុការណ៍ បាន កើតឡើង នៅ ម៉ោង …
ហាន ណា បាន រីករាយ និង បទពិសោធន៍ ធ្វើការ ជាមួយ កុមារ ជាង ៨ឆ្នាំ មកហើយ ក្នុង កន្លែង ផ្សេង ៗ
ខ្ញុំ មិន ធ្លាប់ ឃើញ ការជន់ លិច នៅ ទីនេះ ទេ ក្នុង រយៈពេល ១០ឆ្នាំ ដែល ខ្ញុំ បាន មក រស់ នៅ ទីនេះ ។
បច្ចុប្បន្ន នេះ លោកស្រី ស្ថិត ក្នុង ចំណោម ស្ត្រី មាន បំផុត របស់ ចិន ។
និង ស្វាមី ព្រមទាំង ខ្លួន ឯង ព្រមទាំង ភ្ជាប់ សារ អរគុណ ដល់ លោក ជា វិបុល យ៉ាង ផ្អែម ។
ផ្លែ នេះ មាន គុណ ប្រយោជន៍ ណាស់ សម្រាប់ រាងកាយ ជាពិសេស ជួយ ៖
សូម រម្លឹក ថា នៅ ថ្ងៃទី ២ខែមិថុនា ឆ្នាំ ២០១៧ជា ថ្ងៃ ចុងក្រោយ នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ឃុំ សង្កាត់ រយៈពេល ១៤ ថ្ងៃ ។
នៅក្នុង រាជធានី ភ្នំពេញ មាន ភាពច្របូកច្របល់ ។
ខ្ញុំ សង្កេតឃើញ ថា បើ ប្រទេស ណា មាន អ្នកនិពន្ធ ពូកែ ច្រើន ប្រទេស នោះ ក៏ រីកចម្រើន ដែរ ។
ទំព័រ ដើម សេចក្តី អធិស្ឋាន ទំនុក ដំកើង ៣អធិស្ឋាន សំរាប់ ជំនួយ
ដូច្នេះ លោក ប៉ុល បាន ជ្រមុជ ទឹក ឱ្យ ពួកគេ នៅ ទីនោះ ក្នុង ព្រះនាម ព្រះយេស៊ូវ គ្រី ស្ទ
ប៉ុន្តែ លោកគ្រូបង្វឹក ជនជាតិ បារាំង រូប នេះ បាន និយាយ ថា មិន ជា បញ្ហា ទេ ។
ឬ ពឹងពាក្់ ទាក្់ រង គ្នប បាន ររ
ប៉ុន្តែ ពិភពលោក ផ្លាស់ប្តូរ ជារៀងរាល់ ថ្ងៃ ។
ជាច្រើន ពេញ មួយ យប់ ។
គួរឱ្យ កត់សម្គាល់ នៅ ថ្ងៃ ដង្ហែ ព្រះបរម សព សម្តេច ឪ
៥៨ នាទី ព្រឹក មិញ នេះ ម៉ោង នៅក្នុង តំបន់ ។
ខ្ញុំ មិន ចង់ ទៅ ប្រទេស ម៉ាឡេស៊ី នោះ ទេ ។
បុរស ដែល ខ្ញុំ ប្រាថ្នា ពី តំណាប់ គុយ គុយ
ហើយ ក្រោយពី មាន ការជួប ជជែកគ្នា មាន ការយល់ ពី គោលបំណង របស់ គណៈកម្មការ ។
ឆ្នាំ អ្នក យក អាសាមមីចរ ៕
លោក ហាក់ ហួសចិត្ត ចំពោះ ពួកគេ ទាំង ពីរ ដែល មិត្តភាព សោះ តែ លេង កាច យ៉ាង នេះ ។
សូប បត់ តាម ផ្លូវ ពិបាក បន្តិច ប្រមាណ មួយ ឬ ពីរ គីឡូម៉ែត្រ ដើម្បី ទៅដល់ វត្ត ។
ក្រុម កម្មករ បាន រំសាយ ការជួបជុំ នៅ ក្រោម ដើម ពោធិ៍ ខាងមុខ វត្ត បុទមវតី នោះ ភ្លាម ៗ
ព្រោះថា ក្នុង ផ្ទៃ ក្រឡា មិន ជា ធំ ប៉ុន្មាន តែ អ្នក នៅតែ អាច ចិញ្ចឹម ជ្រូក បាន យ៉ាង ច្រើន ។
អ្នក អាចនឹង ជួបប្រទះ បញ្ហា ទាំងនេះ បើសិន …
សុខរីណា ជីះ ប៉ុន្មាន ម៉ោង បាន ទៅដល់ សៀមរាប ?
ពិសារ ភេសជ្ជៈ នេះ ៣ស្លាបព្រា ក្នុង ១ ថ្ងៃ សក់ អ្នក នឹង ឆាប់ ដុះ លឿន រហ័ស
ទម្រង់ គូទ បែប នេះ មនុស្ស ស្រី គ្រប់ រូប តែងតែ ចង់បាន ។
កាលពី ថ្ងៃចន្ទ ថា អ្នកវិទ្យាសាស្ត្រ អាមេរិក ម្នាក់
ដែល កើតឡើង ហើយ រឿង ទាំងនោះ ក៏ បាន ស្ងប់ ទៅវិញ ។
ដែល នឹង ទទួលបាន យានជំនិះ ប្លែក ៗ
អ្នក មិន បាន ធ្វើ អ្វី ខុស ទេ ហេតុ នេះ មិន ចាំបាច់ ព្រួយបារម្ភ អ្វី ឡើយ ។
ប៉ុន្តែ អ្វី ដែល ជា អនុស្សាវរីយ៍ សម្រាប់ អ្នក ធ្លាប់ …
វា ដូចជា ព្រឹត្តិការណ៍ កាលពី ឆ្នាំ ២០០៦ បាន ចាប់ផ្តើម ម្តង ទៀត អញ្ចឹង ។
ឃុំ កោះ រការមាន ៧ភូមិ គឺ
ព្រះប្រោស ឱ្យ មនុស្ស បាន សុចរិត ដោយសារ ជំនឿ លើ ព្រះយេស៊ូវ គ្រី ស្ទ
នៅក្នុង ប្រទេស របស់ លោក ត្រូវបាន ហាម មិន ឱ្យ ចូលរួម ក្នុង ការបោះឆ្នោត ប្រធានាធិបតី នៅ ឆ្នាំ ក្រោយ នេះ ។
អូយ មានអារម្មណ៍ ណាស់ ពេល បាន អាន ហើយ ។
សង្ឃឹម ថា បងប្អូន បាន សេចក្តីសុខ ដូច ខ្ញុំ ដែរ ។
ក្រៅពី នេះ គ្រាន់តែ ដួល បន្តិច ក៏ អាច បង្ក ជា ការបាក់ ឆ្អឹង បាន ដែរ ។
លើស ពី នេះ លោក ថា លោក វ៉ា គឹម ហុង ព្យាយាម បកស្រាយ គេចវេះ ពី ការទទួលខុសត្រូវ ។
សញ្ញាបត្រ ក្លែងក្លាយ នេះ គឺ ធ្វើ បាន ដូច បេះបិទ នឹង សញ្ញាបត្រ បាក់ ឌុប របស់ គេ មែនទែន អ៊ីចឹង ដោយ មាន វាយ ត្រា ស្ងួត មើល ឡើង បែក ភ្នែក ។
យើង មាន ជំនឿ ថា នឹង មាន ការរើប ឡើងវិញ នៃ រដ្ឋ ឥស្លាម ប្រសិនបើ ការណ៍ នេះ មាន តទៅទៀត ៕
កុំ ភ្លេច យក គន្លឹះ ទាំងនេះ ទៅ អនុវត្ត ដើម្បីឱ្យ អាពាហ៍ពិពាហ៍ របស់ អ្នក ប្រព្រឹត្តទៅ ដោយ ភាពរីករាយ ។
នៅពេល មាន គំនិត ចាស់ទុំ មែនទែន អ្នក នឹង មាន ការគិត ខុសប្លែក ពីមុន ៥យ៉ាង នេះ
មនុស្ស កើត មក មាន វាសនា ខុសគ្នា ។
បើ ដីកា ចេញមក ឱ្យ ធ្វើ ប្លង់ សុរិយោដី អត់ ធ្វើឱ្យ ខ្ញុំ ផង ខ្ញុំ បាន ប្លង់ មកពី ណា កាន់កាប់ ។
ក្នុង ខ្លួន ក៏ មិន អាច កត់សម្គាល់ ឃើញ អ្វី ពិសេស ដែរ ។
នាយ កុយ ប្រាប់ ថា កាត់ លុយ ខ្លួន ឯង ឱ្យ ឃ្មឹប ជានិច្ច ប៉ុន្មាន កម្មវិធី មក នេះ
នេះ គ្រាន់តែ ជា ការសន្ទនា របស់ លោក ប្រធានាធិបតី សហរដ្ឋ អាមេរិក ជាមួយ មេដឹកនាំ បរទេស ប៉ុណ្ណោះ ។
អ្នក ទាំង ០៤ នាក់ ដែល ស្លាប់ នោះ មុនដំបូង កំពុង សម្រាក នៅ អគារ សម្រាប់ គ្រូ ៗ
ចេះតែ កាត់ចិត្ត ទៅ បាន នៅ ដល់ សព្វ ថ្ងៃ ហ្នឹង ទៅ ។
លោក ថា ភាគ ច្រើន សម្រាប់ បញ្ហា ប្រុស ៗ
បុគ្គល និង កុមារ ផងដែរ ។
គេ រំពឹង ថា តាមរយៈ បទពិសោធន៍ ទាំងនេះ លោក ឡេ អូណា ដូល្វី ស នឹង នាំមក នូវ បច្ចេកទេស ថ្មី ៗ
វ៉ាង ស្រី ណូទម្លាយ រឿង បាត់ មុខ
ក្នុង ពេល គ្រប់គ្រង ខ្លួន ឯង លែង បាន នាង ក៏ កាត់ លិង្គ របស់ ខ្ញុំ តែម្តង ។
ក្រោយមក វត្ត ពោធិសាល រាជ កំពង់ចាស់ ក៏ បាន រើ មក កសាង នៅ កន្លែង ថ្មី ដែល មាន ទីតាំង ឋិតនៅ កន្លែង សព្វ ថ្ងៃ នេះ វិញ ។
បណ្តា រូបថត ឈ្នះ ក្នុង ការប្រកួត រូបថត សារព័ត៌មាន ពិភពលោក ឆ្នាំ 2010
ប្រទេស ចិន ច្រក របាំង ចំណត អ្នកផ្គត់ផ្គង់
សាច់ ឆ្កែ មិន មែន សាច់ ពិសេស ដែល មិន មាន អង់ទីប៊ីយូទិក អី នោះ ទេ
ម៉ែធម៌ ឈរ យំ ក្រោយ វះកាត់ ៤ ថ្ងៃ ហើយ ប្អូន ផេង នៅ មិន ទាន់ ដឹងខ្លួន សូម ទេវតា ជួយ ផង វីដេអូ
រោយ ពីលើ សម្ល ម្ជូរ នោះ ជា ការស្រេច ៕
ដែល នឹង ត្រូវ លើក យកមក ពិភាក្សា ក្នុង កិច្ចប្រជុំ រួម មាន ៖
ប៉ុន្មាន ម៉ឺន ប៉ុន្មាន សែន ដុល្លារ នោះ ទេ បានជា មកដល់ បច្ចុប្បន្ន អាន ត
ដូច្នេះ បើសិនជា អ្នក កំពុងតែ រៀប គម្រោង ចង់ ធ្វើជា ឪពុក គេ មែន នោះ
ខាងក្រោម នេះ ជា រថយន្ត គំរូ ស្អាត ៗ
១លោក អ៊ីស្រាអែល ចេញដំណើរ ទៅ ដោយ យក អ្វី ៗ
រាល់ ១០០០ គីឡូម៉ែត្រ អ្នក នឹង ត្រូវការ ទឹក១លីត្រ និង បន្ថែម អេឡិចត្រូលីត្រ បន្តិច ។
បើ ប្តី សម្រចចិត្ត …
វា មាន លក្ខណៈ តូច ចល័ត ហេតុ ដូចនេះ ហើយ ងាយស្រួល ខ្លាំង ណាស់ ដើម្បី អនុវត្ត នៅ ជុំវិញ ។
ម្នាល ភិក្ខុ នេះ ជា ហេតុ នេះ ជាបច្ច័យ ដែល មាន ត្រជាក់ ម្តង ៗ
យ៉ាង ស្មោះស្ម័គ្រ ជារៀងរាល់ ថ្ងៃ អស់ មួយ ជីវិត ។
មួយចំនួន នៃ រដ្ឋ ការ ក្រុង វ៉ាស៊ីនតោន ។
ក្នុង នោះ លោក ក៏ អាច ទទួល ដឹង នូវ ព័ត៌មាន ដែល កើតមាន ក្នុង តំបន់ ផងដែរ ។
បើ ផ្អែក តាម ព្រឹត្តិការណ៍ កើតមាន កន្លងមក អ្វី ៗ
ប្រទេស ព័រទុយហ្គាល់ កំពុង មាន ភាគរយ ខ្ពស់ ជាង អង់គ្លេស ទៅ ទៀត …
គឺ ដោយសារតែ សហរដ្ឋ អាមេរិក ព្រងើយ កន្តើយ ចំពោះ ពួកគេ ។
ឡាយ អាច មើលឃើញ សមុទ្រ និង ព្រៃឈើ នៅលើ កោះ ។
ជហ្វា ដំបូល ព្រះវិហារ ចាស់ ត្រូវបាន រក្សាទុក រហូតដល់ បច្ចុប្បន្ន
មាន លទ្ធភាព អាច កើតឡើង ជាច្រើន តែ ពេលវេលា មាន តិចតួច ណាស់ ។
ឪពុក ម្តាយ របស់ កុមារី ចំ ប៉ី ដែល ត្រូវ ទទួលរង ការវាយ ធ្វើបាប ពេល ធ្វើជា អ្នកបម្រើ គេ នៅក្នុង ផ្ទះ នៅ ប្រទេស ម៉ាឡេស៊ី ។
ហើយ មាន ឡើងវិញ មិន ទៀងទាត់ មួយ កើត មួយ បាត់ ផ្លាស់ប្តូរ គ្នា ។
លោក មិន បាន បញ្ជាក់ ទេ ថា ជនសង្ស័យ ពីរ នាក់ ទៀត ជា កងរាជអាវុធហត្ថ ដែរ ឬ យ៉ាងណា ។
លោក ប្រធានាធិបតី ត្រាំ និយាយ ថា យើង នឹង ធ្វើ ប្រទេស កូរ៉េ ខាងជើង គ្មាន អាវុធ នុយក្លេអ៊ែរ ៕
ក៏ប៉ុន្តែ ព្រះនៃ ឪពុក របស់ បង បាន គង់ នៅ ជាមួយ បង ។
ឬ កើតមាន ដល់ ពួកយើង ឡើយ ។
ព្រះអង្គ ប៊ុន សាលួតក៍ បាន សឹក ដោយសារតែ ព្រះអង្កអស់ និស្ស័យ ជា បុព្វជិត ។
នៅ ទីនេះ ប្រធាន រដ្ឋសភា លោកស្រី
នេះ គឺជា ការគំរាមកំហែង មួយ ដែល អាជ្ញាធរ រដ្ឋ មិន ត្រូវ មើល រំលង ឡើយ ។
តាម វិន័យ ដែល ព្រះអង្គ បាន បង្គាប់ មក ។
លោកស្រី បាន បន្ត រស់ នៅក្នុង ជីវិត របៀប នេះ អស់ រយៈពេល ៣ឆ្នាំ ។
ចិត្ត ស្រឡាញ់ នៅតែ មាន តែ ធ្វើ យ៉ាងម៉េច បើ មិន ដឹង ជា ទៅដល់ ទីណា ។
ហើយ ខ្ញុំ ចង់ឱ្យ អ្នកចូលរួម ទាំងអស់ ឈ្នះ រង្វាន់ ដូច ខ្ញុំ ដែរ ។
លោក បាន បញ្ជាក់ ថា សូម បម្រើ សេវា ឱ្យ បាន លឿន ត្រូវ ជួយ ផ្តល់ សេវា ការដោះស្រាយ ជូន ពលរដ្ឋ រាល់ បញ្ហា ផ្សេង ៗ
ការរំលាយ អាហារ កាន់តែ ប្រសើរ ជាមួយ អាហារ ទាំង នេះ
១ សូម បងប្អូន យក តំរាប់ តាម ព្រះជា ម្ចាស់ ចុះ ព្រោះ បងប្អូន ជា បុត្រធីតា ដ៏ ជា ទីស្រឡាញ់ របស់ ព្រះអង្គ ។
វា អាស្រ័យ លើ ការខិតខំ របស់ យើង ទាំងអស់ គ្នា នេះ ហើយ ។
ដូច្នេះ លោកស្រី បាន សម្រេច ទៅកាន់ ក្រសួង សេដ្ឋកិច្ច ក្រែង មាន សង្ឃឹម ខ្លះ ។
ឥឡូវនេះ មាន សញ្ញា មួយ បង្ហាញ ថា រដ្ឋាភិបាល សហរដ្ឋ អាមេរិក កំពុងតែ យកចិត្តទុកដាក់ ។
ពួក អាចារ្យ ដែល ចុះ មក ពី ក្រុង យេរូសាឡឹម និយាយ ថា ៖
និយាយ ពី ថា សប្បាយ មិន បាច់ និយាយ
នាង ត្រូវតែ ចាំ ថា គ្រួសារ នាង ជា ជនជាតិ ចិន ។
៦២ ពេល នោះ លោក មហា បូជាចារ្យ ក្រោកឈរ ឡើង សួរ ព្រះអង្គ ថា ៖
