ការយល់ សប្ត មួិយចំនួន មាន ពេល ខ្លះ ក៏ អាច បញ្ជាក់ ថា អ្នក នឹង ដល់ គូ ។
នេះ បើ តាម អធិការ ខណ្ឌ ដូនពេញ ៕
គ្នា អាស្រ័យ លើ អ្នកជំងឺ ម្នាក់ ៗ
របស់ តារា ម៉ូដែល ទាំងនោះ ៖
គឺជា មរដកដល់ អ៊ីស្រាអែល ជា រាស្ត្រ របស់ ទ្រង់ ។
ខ្ញុំ ជា គ្រីស្ទ បរិស័ទ មិន ល្អ
សមាជិក ថ្មី ត្រូវបាន ចូល មកដល់ គ្រួសារ របស់ អ្នក ។
រដ្ឋាភិបាល លីប៊ី ដែល ត្រូវបាន គាំទ្រ ដោយ អង្គការ សហ ប្រជាជាតិ បាន និយាយ ថា មនុស្ស ២១ នាក់ ត្រូវបាន សម្លាប់ និង ២៧ នាក់ រងរបួស ក្នុង ការវាយប្រយុទ្ធ គ្នា នៅជិត ទីក្រុង ទ្រី ប៉ូលី ។
នេះ ជា ផ្នែក មួយ នៃ សកម្មភាព ប្រចាំ ថ្ងៃ របស់ ខ្ញុំ សកម្មភាព ដែល ខ្ញុំ ចូលចិត្ត បំផុត ។
យើង សង្ឃឹម ថា យើង អាចនឹង ទៅដល់
ខ្ញុំ ទទួលស្គាល់ ថា យើង បាន បំប្លែង ការពិត ដែរ យើង ទទួល ការរិះគន់ ទាំងអស់ ។
ដោយ ពណ៌ ទាំងអស់ នោះ មិន ដូចគ្នា ឡើយ ។
វា កំពុង បង្ហាញ លទ្ធផល ។
ព្រះទ្រង់ ជា វិស្វករ ដែល រៀបចំ គ្រប់ ការ ទាំងអស់ ។
មាន បញ្ហា វា នឹង ជះឥទ្ធិពល ដល់ ក្រុម ទាំងមូល តែម្តង ។
របស់ ពួកគេ ពុំ ធ្វើ ដូចជា អ្វី ដែល ពួកគេ រំពឹងទុក នោះ ?
ទាំងនោះ បង្ហាញ ឱ្យ ឃើញ ថា ការបោះឆ្នោត នៅ អូស្ត្រាលី ខែ ក្រោយ គឺជា ការប្រគួត ប្រជេង យ៉ាង តឹង តែង បំផុត ។
នៅ ប៉ុន្មាន ថ្ងៃ ទៀត នេះ មាន ព្រឹត្តិការណ៍ ដ៏ ចាប់អារម្មណ៍ ពីរ នឹង កើតឡើង …
ខ្ញុំ យល់ស្រប ដំណោះស្រាយ កម្មវិធី ផ្សេង ៗ
ចូរ ពន្យល់ ពី មូលហេតុ ។
ចាំ ស្តាប់ ពី អ្នកដទៃ ទៅ ។
ប៉ុន្តែ ចូរ ជឿ ខ្ញុំ ទៅ ថា រវាង ការរួមភេទ ពិតប្រាកដ
ដំណោះស្រាយ ទាំង នេះ អាច យកមក អនុវត្ត នៅ ពេល ណាមួយ ក៏ បាន ។
ហើយ ព្រះអង្គ នឹង បង្ហាញ អោយ គេ ឃើញ ថា
សរសេរ ចំនុច មួយ ដែល ខ្ញុំ មិន ទាន់ យល់ ច្បាស់ លើ ប័ណ្ណ លឿង មិន ប្រាកដ
នៅ ពេល ដែល អ្នក ធ្វើ បាន ជោគជ័យ នូវ ផែនការសម្រក ទម្ងន់ ទាំងនេះ ហើយ បាន ចេញ ជា លទ្ធផល ខ្លះ ៗ
ទាំងអស់ បច្ចេកវិទ្យា
គួរឱ្យ កត់សម្គាល់ ដែរ ថា នាង ស្កាលេត ចន សុន ទើបតែ ហ៊ាន ថត ស្រាត ទាំងស្រុង នៅលើ ផ្ទាំង សំពត់ សក្នុង ឆ្នាំ ២០១៤ នេះ តែ ប៉ុណ្ណោះ ។
មិន មាន អី ជា អស្ចារ្យ ទេ ធ្លាប់ ធ្វើ តែ ប៉ុណ្ណឹង ហើយ ។
ព្រះសិវៈ ជា អាទិទេព សាង លោក ផង និង បំផ្លាញ លោក ផង ។
ក្នុង នោះ ដែរ ដកហូត វត្ថុតាង រួម មាន ៖
កម្មវិធី ដែល អាច អោយ អ្នកបញ្ជា ទូរទស្សន៍ ដោយ ប្រើ ទូរស័ព្ទ
ចូរ នាំគ្នា មើល ហើយ ងឿងឆ្ងល់
មិន គួរ ធ្វើ រឿង ទាំងនេះ ឡើយ ក្រោយពី រួមភេទ រួច
ផែនដី ទិស ទាំង បួន ផ្កាយ ព្រះចន្ទ្រ ព្រះអាទិត្យ …
ដែល ជា បងប្អូន របស់ ពួកគេ ទទួល ភារកិច្ច បំពេញ ការងារ ទាំង ប៉ុន្មាន នៅក្នុង ព្រះពន្លា ជា ព្រះដំណាក់ របស់ ព្រះជាម្ចាស់ ។
ខណៈ ដែល អ្នក ចូលចិត្ត ចំណាយ ពេលវេលា នៅ ជាមួយ ដៃគូ របស់ អ្នក ប៉ុន្តែ អ្នក មិន គួរតែងតែ នៅ ជាមួយគ្នា រហូត នោះ ទេ ។
ក្រៅពី នេះ មួយ ភាគ បី ត្រូវបាន បិទ បញ្ចប់ មុនពេល បើក សវនាការ ។
ហើយ តែ ប៉ុន្មាន ម៉ោង ក្រោយមក ពួកគេ ត្រូវបាន ដោះលែង ឱ្យ មាន សេរីភាព ។
នឹង បរាជ័យ ប្រសិនបើ អ្នក និយាយ ថា ពួកគេ នឹង មិន ធ្វើ ទេ ។
ជរា មើល ថែ ក្មេង វិញ ម្តង ដោយសារតែ ទាល់ច្រក
ខ្ញុំ គ្មាន ពាក់ព័ន្ធ ឬ ស្គាល់ ភូមិ ឃុំ នេះ ទេ ។
រវាង ឆ្នាំ និង ជនជាតិ ជ្វីស និង ប្រជាជន ផ្សេង ទៀត ប្រមាណ លាន នាក់ ត្រូវបាន សម្លាប់ ។
ការចាក់ ថ្នាំ បង្ការ រោគ បច្ចុប្បន្ន នេះ ត្រូវបាន ផ្តល់ ជូន តែ ចំពោះ មនុស្ស ដែល មាន អាយុ ចាប់ពី ១២ ឆ្នាំ ឡើង ទៅ ប៉ុណ្ណោះ ។
គ្នា ពិតជា មាន ប្រយោជន៍ ជាច្រើន សម្រាប់ ផ្តល់ ការពិចារណា ដល់ យើង ។
ទាំង សហរដ្ឋ អាមេរិក និង សហភាព អឺរ៉ុប បាន គាំទ្រ លោកស្រី ។
ហេតុការណ៍ ដែល យើង ទើប ទទួលបាន ពី សារព័ត៌មាន ថៃ នេះ គឺ បាន កើតឡើង
យើង គួរឱ្យ គ្រូពេទ្យ វះកាត់ ពន្យល់ ពី ហានិភ័យ ទាំងនោះ មុនពេល វះកាត់ ។
មកដល់ ភ្លាម គាត់ បាន ផ្លាស់ សំលៀកបំពាក់
យើង នឹង ប្រមូល ពួកគេ ពី គ្រប់ ទិសទី ហើយ នាំ ពួកគេ វិលត្រឡប់មក ទឹកដី របស់ ខ្លួន វិញ ។
គួរតែ ឈប់ រៀន ។
ម្យ៉ាងទៀត ប្រជាពលរដ្ឋ ក៏ អាច ជិះ រថភ្លើង ដោយ មិន បង់ប្រាក់ ផងដែរ ក្នុង រដូវ បុណ្យ ចូល ឆ្នាំ ៕
លោក ថា ជាទូទៅ ការដំឡើង ឋានៈ បុគ្គល នីមួយ ៗ
គេ បាន បញ្ជាក់ យ៉ាង លម្អិត ផងដែរ ថា អ្នក រត់ការ មាន ឈ្មោះ រ៉ា ។
ចង់ នៅ ក្លឹប នេះ ជារៀងរហូត ។
បង្កើត បានជា ក្រុមហ៊ុន ធំ មួយ ។
រាល់ វិនិយោគិន មាន តំរូវការ ដែល ខ្លួន ចង់បាន រួម ជា ៖
ត្រឹន ថា ញ យ៉ាង ថាញ ហ្វ័រ
និង ភាពអយុត្តិធម៌ ។
កុំ ថា ខ្ញុំ ផ្តាច់ការ ។
គេ ជា បុត្រ របស់ ព្រះជាម្ចាស់ ដ្បិត គេ មាន ជីវិត រស់ ឡើងវិញ ។
ចំណុច ទាំង នេះ ធ្វើឱ្យ មហាជន ទូទៅ គាត់ ស្រឡាញ់ និង ចូលចិត្ត លោក ហើយ ជួយ គាំទ្រ ។
ដែល មាន ប្រជាប្រិយភាព យ៉ាង ខ្លាំង និង ជួយ ឱ្យ លោក ចាប់ ដៃ គូ សហការ ជាមួយ ក្រុមហ៊ុន ដទៃ និង ចាប់ផ្តើម រក ប្រាក់ ចំណូល ផងដែរ ។
ខ្ញុំ ស្អប់ សង្គ្រាម ។
ប្រសិនបើ ជួប ពួកគេ ។
ស្មេរ នៅតែ ស្រពេចស្រពិល នៅ ពេល ដែល ចាប់ផ្តើម សរសេរ ពាក្យ នេះ ។
ប៉ុន្តែ ទោះបីជា យើង មាន បញ្ហា នោះ ក៏ដោយ ក៏ ព្រះហស្ត ព្រះអម្ចាស់ នៅ តែ ដឹកនាំ យើង ហើយ ព្រះហស្ត ស្តាំ ព្រះអង្គ នៅតែ កាន់ យើង ជាប់ ខ.១០ ។
បុរស ម្នាក់ មាន ជំងឺ ត្រដិត ។
ពត៌មាន ប្រចាំ ថ្ងៃ ពេលព្រឹក ធ្វើ តែ រឿង នេះ ១នឹង ស៊យ ពេញ ១ ផ្ទះ តែម្តង
ក្រោយពី រៀបការ រួច ទើប ខ្ញុំ ដឹង ពី កម្រិត នៃ អំពើ បាប របស់ ខ្ញុំ ។
ទៀត ដែល កំពុង ប្រកួតប្រជែង ជាមួយនឹង សហរដ្ឋ អាមេរិក ។
វា កើត នៅ ប្រទេស អាហ្វ្រិក ខាងត្បូង កាលពី …
លើស ពី នេះ ទៀត មនុស្ស យ៉ាងហោចណាស់ ៥៩ លាន នាក់ ត្រូវបាន ជម្លៀស ចេញ ផងដែរ ។
ខាងក្រោម នេះ គឺជា ខ្សែ វីដេអូ រឿងៈ ព្រះអង្គម្ចាស់ និង នាងខ្ញុំ ៖
ប៊េស បាន និយាយ ថា យើង មាន ការចាប់អារម្មណ៍ ចំពោះ ការទាក់ទង នឹង ការស្រាវជ្រាវ នេះ ។
ខ្ញុំ គិត ថា ខ្ញុំ បាន អាន ច្បាប់ ទាំងនេះ ស្ទើរតែ ទាំងអស់ គឺ សរុប ប្រមាណ ១៣ ច្បាប់ ដែល មាន នៅក្នុង វិស័យ ព័ត៌មាន ។
យើង នឹង ផ្តល់ឱ្យ អ្នក នូវ ព័ត៌មាន ទាន់ ហេតុការណ៍ តាម ដែល យើង ដឹង ។
ប្រាក់ ឬ មូល ប្បទាន ប័ត្រ ។
ឪក សុគន្ធ កញ្ញា មិន មែន សង្សារ បង
ដើម្បី ក្លាយជា អ្នកគ្រប់គ្រង ដ៏ ល្អ ត្រូវ ប្រកាន់ខ្ជាប់ ប្រការ អ្វី ខ្លះ ?
ខ្ញុំ សូម អភ័យទោស ដល់ ផលិតកម្ម មួយ ចំនួន ដែល ក្នុង ទំព័រ ហ្វេសប៊ុក របស់ ខ្ញុំ បាន សរសេរ ប៉ះពាល់ ដោយ អចេតនា ។
ពេល នោះ គេ ក៏ ស្រែក គំរាម សម្លាប់ គ្រូពេទ្យ ។
ពិតជា មាន សារសំខាន់ បំផុត សម្រាប់ គ្រប់ ផ្នែក ទាំងអស់ ក្នុង ជីវិត របស់ អ្នក ។
ខណៈ អ្នកស្រី កំពុង លក់ នៅឯ ផ្សារ ។
ការប្តឹង សុំ មោឃភាព នៃ អាពាហ៍ពិពាហ៍ ត្រូវ ផុត អាជ្ញា យុកាល ប្រសិនបើ ការប្តឹង នោះ មិន ធ្វើ ក្នុង រយៈ៦ខែ គិត ពី ថ្ងៃ ដែល គេ លែង បង្ខំ នោះ មក ។
កាល ឆ្នាំ មុន មាន មនុស្ស ច្រើន ។
កាលពី មុន ធ្លាប់ ចូល វ៉ិប សាយ ហ្នឹង ដែរ តែ បែរជា ចេញ ទៅជា វ៉ិបសាយ ផ្សេង រឺ គ្មាន ។
ែ អុំ ពី ការន្ស្វង រក កិឆច អន តរាគមន៍ ឆុំច្ោាះ បញ្ា និង ត្រមូវការរបស្់ កុ
ផ្លែ ម្នាស់ ត្រូវបាន គេ ជឿ ថា ល្អ សម្រាប់ មនុស្ស ស្រី
សត្រូវ នោះ គឺ ការភ័យខ្លាច ។
ព្រឹត្តិការណ៍ នេះ ឥឡូវ បាន ក្លាយទៅជា ការងារ គំរូ ដល់ ពលរដ្ឋ ប៉ាគីស្ថាន ផ្សេង ទៀត ។
តំណរ ភ្ជាប់ ទៅកាន់ ទីផ្សារ អេន ដ្រយ ៖
រវាង អ៊ីរ៉ង់ និង មហា អំណាច ពិភពលោក ស្តីពី កម្មវិធី នុយក្លេអ៊ែរ នឹង ត្រូវ ពន្យារ ពេល
ប៉ុន្តែ បើ សុខភាព ក្រពះ មិន ស៊ូវ បាន ល្អ អ្នក មិន គួរ អនុវត្ត របៀប នេះ ទែ ។
ហើយ អតិភាព របស់ យើង ៗ
ឥឡូវ ខ្ញុំ មាន ជំនាញ ថ្មី ហើយ ។
ឆ្កែ ចចក ទៅ សួរសុខទុក្ខ តោ កំពុង ឈឺ
អ្នករចនាផ្ទៃ ខាងក្នុង បង ភ័ក្រ
សុភាសិត អង់គ្លេស
រដ្ឋមន្ត្រី ការពារ ជាតិ អ៊ីស្រាអែល ព្រមាន ស៊ីរី និង លី បង់ ថា កុំ ចង់ សាកល្បង យើង
សហគ្រិន ដែល បំពេញ លក្ខខណ្ឌ ខាងក្រោម អាច ចូលរួម ដាក់ពាក្យ ប្រកួតប្រជែង នៅក្នុង កម្មវិធី នេះ តាមរយៈ …
រើស យក ឃ្លាំង ទិន្នន័យ ដែល បាន បង្កើត រួច ។
មិត្រភាព ក៏ ចាប់ ស្រាំ ឬ បាក់បែក ត្រឹម ចំណុច នេះ ។
អ៊ីរ៉ង់ សាកល្បង ប្រព័ន្ធ ខែល មីស៊ីល ថ្មី និង បង្ហាញ មូលដ្ឋាន សម្ងាត់ ដ្រូន
មិត្តភក្តិ ខ្ញុំ ម៉េច ខ្ញុំ ដឹង ច្បាស់ ។
បាន ១០០ ភ្លាម ចាន់ ថេង យំ កាន់តែ ខ្លាំង ។
ដូច្នេះហើយ ខ្ញុំ មិន មាន ការចាប់អារម្មណ៍ អី ទៅ លើ ការផ្តល់ គោរមងារ នេះ ទេ ។
ព្រោះ ពួកគេ ធ្វើ បាន ល្អ ក្នុង អំឡុង ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ហើយ ពេលនេះ ពួកគេ មាន ធនធាន សម្រាប់ គាំទ្រ សកម្មភាព របស់ ពួកគេ ។
បញ្ហា ពិតប្រាកដ មកពី ទម្លាប់ ក្មេងស្រី ម្នាក់ នេះ ។
ជា ការសម្រួល ខ្លាំង ដល់ ពួក អង្គការ រដ្ឋ អ៊ីស្លាម ។
ថ្ងៃ មួយ បុរស ជា ប្តី ធ្លាក់ខ្លួន ឈឺ ។
រឿង មកពី បរទេស មែន និង
អ្នកវិទ្យាសាស្ត្រ អះអាង ថា ស្ត្រី គួរ ឈប់ ពាក់ អាវ ទ្រនាប់ !
១. ការដោះស្រាយ បញ្ហា
ដែល អ្នក រាល់គ្នា ស្រាយ នៅលើ ផែនដី ព្រះជាម្ចាស់ ក៏ នឹង ស្រាយ នៅ ស្ថាន បរម សុខ ដែរ ។
ការប្រកួត ភាពយន្ត កម្ពុជា វគ្គ ១ ជាមួយ សំណួរ ចម្លើយ
មិន ត្រូវ ឱ្យ រត់ លេង និង ជ្រក ក្រោម ដើមឈើ នៅពេល មាន ភ្លៀង ម្តង ៗ
ខណៈពេល ដែល វា គ្រាន់តែ ធ្វើអោយ សក់ មើល ទៅ
ហើយក៏ ដូចជា ផ្លាស់ ផ្តូរ អារម្ម ណ៏ អ្នក កម្សាន្ត ឱ្យ កាន់តែ រីករាយ ជាង មុន ។
អីចឹង ជា សរុប រួម មក គាត់ បាន ពេញចិត្ត ជាមួយនឹង ដំណើរទស្សនកិច្ច នេះ ។
រូប ហើយ កើតឡើង ដោយ គ្មាន នរណា ប្រាថ្នា សម្រាប់ ខ្លួន នោះ ទេ ។
មើល ចុះ មនុស្ស រាល់ ថ្ងៃ នេះ គឺ សំដៅ រក តែ ប្រាក់ គ្រប់ ផ្លូវ ដែល បាន ប្រព្រឹត្ត គ្រប់ វិធី ទោះបី ត្រូវ ធ្វើ អាក្រក់ ទុច្ចរិត ខុស ច្បាប់ ខុស ទម្លាប់ យ៉ាងណា ក៏ ព្រម ធ្វើ ទាំងអស់ ឱ្យ តែ បាន ប្រាក់ ។
ចុច ចូល ដើម្បី ចូល ទៅក្នុង គណនី របស់ អ្នក ។
ឈ្មោះ ម៉ាក ងាយស្រួល
ដល់ អ្នកទស្សនា របស់ ខ្លួន បន្ថែម លើ កម្មវិធី កម្សាន្ត មាន ស្រាប់ ។
ពុំ មាន កំណត់ អាយុ សម្រាប់ ការទទួល ពរ របស់ លោក អយ្យកោ ទេ ប៉ុន្តែ អ្នកទទួល ចាំបាច់ ត្រូវ មាន វ័យ ធំ ល្មម និង ចាស់ទុំ ដើម្បី យល់ អំពី សារៈសំខាន់ នៃ ពរ ជ័យ នេះ ។
ប៉ុន្តែ ពេល ខ្ញុំ ទៅដល់ ទីនោះ ភ្លាម ខ្ញុំ មាន របៀប រស់ នៅ ដូច ពីមុន ដដែល ។
មក ព្រមទាំង នាំ ឯង ចេញ ពី ស្រុក អេស៊ីព្ទ មក នៅ ចំពោះ ទ្រង់ ដោយ ព្រះចេស្តា ដ៏ ជា ធំ របស់ ទ្រង់
លោក បាន បញ្ចប់ សុន្ទរកថា របស់ លោក ដោយ ពាក្យ ថា សូម ព្រះជាម្ចាស់ ជួយ ដល់ យើង គ្រប់ គ្នា ។
យើង នឹង ទទួល តង្វាយ ដុត ទាំងមូល
ការងារ កំពុង ស្វែងរក ជំនួយ បន្ថែម ។
ជា ការកត់សម្គាល់ នេះ មិន មែន ជា លើក ទី១ ទេ ដែល តារា សម្តែង វណ្ណ វល័ក្ខបញ្ចេញ ភាព សិចស៊ី បែប នេះ ជា សាធារណៈ ។
លោក Malpass បាន ថ្លែង ថា លោក សង្ឃឹម ថា ផែនការ នេះ អាច ទទួលបាន ការយល់ព្រម នៅពេល គណៈកម្មការ នយោបាយ គណៈកម្មការ នយោបាយ អភិវឌ្ឍ ធនាគារ ពិភពលោក ជួបប្រជុំ ដ៏ សំខាន់ មួយ នៅ ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០២០ ខាងមុខ ៕
ចូលចិត្ត ប្រើ តែ មនុស្ស មួយចំនួន មិន យល់
ប្រទេស កូរ៉េ ជា ប្រទេស មួយ ដែល មាន ការជឿនលឿន យ៉ាង ខ្លាំង ក្នុង ទ្វីប អាស៊ី យើង ។
ប្រភព បន្ត ថា មុនពេល បាត់ខ្លួន
យំ គឺជា មធ្យោបាយ ទំនាក់ទំនង ដំបូង បំផុត របស់ ក្មេង ។
វា ប្រៀប បីដូចជា រតនសម្បត្តិ ដ៏ ស្រស់ស្អាត ដែល យើង មាន ។
សូម ដោះ ព្រលឹង ទូលបង្គំ ឱ្យ រួច ពី ការបំផ្លាញ របស់ គេ
ឡើយ ដោយ រង់ចាំ ១០ឆ្នាំ ក្រោយ ទើប ដក ទ័ព ចេញ ។
អាមេរិក កាលពី ខែ មុន ។
គាស់ វើក ភ្លាម ស្វាង ងងុយ ភ្លែត ព្រោះ ត្រូវ …
គាត់ មក ជាមួយ មេធាវី ។
សង្ឃឹម ថា ខ្ញុំ នឹង ទទួលបាន នូវ យោបល់ ល្អ ៗ
បន្ទាប់ពី សារព័ត៌មាន ចុះផ្សាយ ខុស ការពិត សម្តេច បញ្ជាក់ យ៉ាង ច្បាស់ ថា ៖
លោក បន្ត ថា ការបោះពុម្ព លុយ រៀល បន្ថែម នេះ មិន ទាក់ទង នឹង រឿង នយោបាយ ឡើយ ។
ប៉ុន្តែ ភ្លាម នោះ សមុទ្រ ក៏ មក ជ្រែក ។
ខ្ញុំ ចូលចិត្ត បែប នេះ មិន ដូច 0 សូម ចូលទៅ បោះឆ្នោត
ទូក ជន ចំណាកស្រុក ពី ប្រទេស លីប៊ី ឆ្ពោះទៅ អ៊ីតាលី បាន លិច
ខ្ញុំ គាំទ្រ ទាំងស្រុង ចំពោះ គម្រោង រថយន្តក្រុង នេះ និង បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ប្រើប្រាស់ សេវា នេះ ទាំងអស់ គ្នា ។
បើ ព្រះតេជគុណ គ្រប់ អង្គ ចាប់ផ្តើម បង្ហោះ តែ
មនុស្ស គ្រប់ រូប នឹង ផ្តល់ឱ្យ អ្នក បាន កាន់តែ ច្រើន ដរាបណា អ្នក ធ្វើឱ្យ គេ មាន អារម្មណ៍ ថា ជា មនុស្ស សំខាន់ …
លោក ម៉ូរីញ៉ូ ឥត ស្តាយក្រោយ ទេ បន្ទាប់ពី បិសាច ក្…
តែ បច្ចេកវិទ្យា អាច ជួយ សម្រួល ផល ពិបាក ទាំងនេះ បាន ។
គាត់ ក៏ រម្លឹក ដល់ យើង ថា នៅក្នុង ពិភពលោក នេះ យើង គឺជា ក្រុមហ៊ុន មួយ ដែល មាន ចរិក លក្ខណៈ និង សន្តាន ចិត្ត ដ៏ ប្រសើរ ។
លោក និយាយ ទៅកាន់ ពួក អ្នកធ្វើ ការងារ របស់ ប្រទេស អាមេរិក ។
មនុស្ស យើង ត្រូវការ ទឹក ។
មនុស្ស យើង ភាគ ច្រើន ចង់អោយ គេ មើលឃើញ ថា ខ្លួន ជា មនុស្ស រួសរាយ និង រាក់ទាក់ ជាមួយ មនុស្ស ក្នុង ក្រុម ។
តើ គួរ ធ្វើ ដូចម្តេច ទើប កូន ឆ្លាត រស់រវើក និង មាន សុជីវធម៌ ?
ឥឡូវនេះ លោក មាស សុថា ត្រូវតែ ចាកចេញ ។
អ្នក ដណ្តើម បាន មនោសញ្ចេតនា របស់ មនុស្ស ជាច្រើន ហេតុ នេះ គ្រប់ យ៉ាង សុទ្ធតែ រលូន ល្អ ។
ដូច្នេះ បាន បង្កើត ការងារ ជាច្រើន ដល់ ប្រជាជន នៅ ជនបទ ។
គ្នា តាម ទំហំ និង តម្លៃ ដូច ខាងក្រោម ៖
មួយចំនួន ត្រូវបាន បង្ខំ ចិត្ត បិទ ទ្វារ ។
ដឹង ឬ ទេ អាកញ្ចះ យួន
តើ អ្នក ធ្លាប់ បាន កត់សម្គាល់ ពី ភាពរញ៉េរញ៉ៃ និង នៅក្នុង ផ្ទះ អ្នកណា ម្នាក់ ទេ ?
ស្ត្រី មិន មែន ជា គល់ ឈើ ទេ ពួកគេ មិន ចង់ឱ្យ ដៃគូ របស់ ខ្លួន បើក ប្រតិបត្តិការ ប្រយុទ្ធ ភ្លាម ៗ
ដែល ប្រទេស មួយ ក្លាយទៅជា ប្រទេស ដែល ខ្ជិល ជាង គេ ក្នុង ពិភពលោក យើង មាន រឿង
ប៉ុន្តែ គ្មាន អ្នកណា អាច ទប់ស្កាត់ មហិច្ឆិតា របស់ អ៊ីស្រាអែល ដែល មាន អាមេរិក នៅ ការពារ ពីក្រោយ ខ្នង ។
ទាំងអស់ មិន ដូចជា ក្រុមហ៊ុន ផ្សេង ទេ ។
ហេតុ ដូចនេះ ការរៀបចំ សិក្ខាសាលា នេះ គឺ ដើម្បី បណ្តុះបណ្តាល អ្នកប្រើប្រាស់ ឱ្យ ចៀសវាង នូវ កំហុសឆ្គង នានា ក្នុង ការប្រើប្រាស់ ។
វា ជួយ បង្កើន ទំនុកចិត្ត ចំពោះ ខ្លួន ឯង ក៏ ដូចជា ទាក់ទាញ អារម្មណ៍ មនុស្ស នៅ ជុំវិញ ផងដែរ ។
សង្ឃឹម ថា លោក អ្នក អាច ដាក់ បាន យ៉ាង ងាយស្រួល ។
ក៏ ត្រូវតែ ចាត់ចែង ផងដែរ ដើម្បី
រឿងរ៉ាវ អស់ ទាំងនោះ ជាច្រើន និង ការពិត ជាក់ស្តែង ខ្លះ ក្នុង រឿង នោះ ត្រូវបាន សាធារណជន ដឹងឮ ជាទូទៅ ទៅហើយ ។
បច្ចេកទេស ចាប់ ប្លង់ មាន ច្រើន អាច ជ្រើសរើស សាកល្បង លើ ស្មាតហ្វូន បាន ។
លុះ ថ្ងៃ ក្រោយ ខ្លាឃ្មុំ ដើរ ៗ
ប៉ូលិស បាន បញ្ជាក់ ថា មូលហេតុ ដែល ធ្វើឱ្យ មាន អគ្គិភ័យ ឆាបឆេះ ឡើង គឺ បណ្តាល មកពី ទុស្សេ ខ្សែភ្លើង ហើយ ទំហំ នៃ ការខូចខាត អស់ ប៉ុន្មាន នោះ មិន ទាន់ ដឹង នៅឡើយ ទេ ៕
គ្រឿង សង្ហារឹម ខ្លះ
តែ អ្នក វិញ គាត់ មាន រឿង ហូហែរ ដើម្បី ប្រាប់ អ្នក ឱ្យដឹង នេះ ដោយសារ គាត់ ចង់ បង្កើត ទំនាក់ទំនង យូរអង្វែង ជាមួយ អ្នក ។
តែ ប្រសិនបើ អ្នក ពិត ចង់ ធ្វើ ចំណុច នេះ គួរ ប្រុងប្រយ័ត្ន ឱ្យ បាន ខ្ពស់ ក្នុង កាលៈទេសៈ នេះ ។
តែ នាងខ្ញុំ ពិតជា ចង់ឱ្យ អស់ លោក រាជ រដ្ឋាភិបាល សូម ពិចារណា ឱ្យ បាន
ខ្ញុំ រន្ធត់ ប៉ុន្តែ ខ្ញុំ ស្រលាញ់ គាត់ គឺ បច្ចុប្បន្នភាព របស់ គាត់ ហើយ គាត់ ជា បុរស ពិត ឥលូវនេះ ។
ហេតុ អ្វី បានជា មិន មាន អ្នកប្រមូល ដឹកជញ្ជូន សំរាម រៀងរាល់ ថ្ងៃ ?
តេស្ត ឌីលី សៀ ឥត គិត ថ្លៃ និង បង់ប្រាក់ បែងចែក តាម អាយុ ការបណ្តុះបណ្តាល ការយល់ដឹង
ដូច ខ្ញុំ បាន ឆ្លើយ អ៊ីចឹង អា ហ្នឹង ទី១ ។
ទោះជា មនុស្ស សើចចំអក ដាក់ យេរេមា និង ខឹង គាត់ ក៏ដោយ ហេតុ អ្វី គាត់ មិន បាន ឈប់ និយាយ អំពី ព្រះ?
បន្ថែ ទៀត សម្រាប់ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ។
លោក បាន ធ្វើ អត្ថាធិប្បាយ ភ្លាម ៗ
សម្រាប់ ក្នុង ស្រុក និង នាំចេញ ទៅ ក្រៅ ស្រុក ។
យើង យកមក តាំងពី ម្សិលមិញ ។
ទោះ យ៉ាងណា វិធានការ ថ្មី នេះ បាន ធ្វើឱ្យ ជន បរទេស មួយ …
ហើយ តើ យើង ត្រូវ ធ្វើ ដូចម្តេច ដើម្បី ឆ្លើយតប ចំពោះ បញ្ហា ដែល អាច កើតឡើង ក្នុង ឆ្នាំ ២០១២ នេះ ?
នាង បាន រៀបរាប់ ថាៈ ក្រោយ រយៈពេល មួយដ៍ វែង នេះ គឺជា ប្រការ ដ៏ អស្ចារ្យ បំផុត ដែល ខ្ញុំ បាន ធ្វើ ។
ក៏ប៉ុន្តែ ពួកគេ ពុំ បាន ចុះ សំបុត្រ អាពាហ៍ពិពាហ៍ ស្រប តាម ច្បាប់ នោះ ទេ ។
និយាយ រួម ដូច ត្រូវ បណ្តា សាវា អ៊ីចឹង ពេល យក ជីវិត វា ។
គ្នា ទើបតែ បាន បញ្ចប់ ប៉ុន្មាន ម៉ោង មុន នៅក្នុង រដ្ឋ តិចសាស់ សហរដ្ឋ អាមេរិក ថ្មី ៗ
កាន់តែ រន្ធត់ ចិត្ត នោះ នាង បាន កើត ជម្ងឺ ធ្ងន់ធ្ងរ នឹង គ្មាន សង្ឃឹម បន្ត ជីវិត នៅលើ លោក នេះ ទៀត ទេ ។
ស្រី ស្អាត ស្លៀកពាក់ លេង ស្តាយ តោះ !
ដូច្នេះ ក្រឹត្យ វិន័យ មាន នាទី ណែនាំ យើង ទៅ កាន់ ព្រះគ្រិស្ត ដើម្បីឱ្យ យើង បាន សុចរិត ដោយសារ ជំនឿ ។
ម៉េច ធ្វើ ចឹង ៕
យើង បាន ប្រើ ឫទ្ធិ អំណាច របស់ យើង
ចំពោះ ខ្ញុំ មើលឃើញ ថា ចៅក្រម ព្រះរាជអាជ្ញា ខ្លួន ឯង ហ្នឹង អត់ ទទួលបាន យុត្តិធម៌ ទៅ ហើយ ។
លោក បាន ឱ្យដឹង ថា អង្គការ លោក បាន ឧបត្ថម្ភ បន្ទប់ រៀន ភាសា អង់គ្លេស ក្នុង សហគមន៍ ។
ខ្ញុំ គិត ថា ពួកគេ សប្បាយ ចិត្ត ខ្លាំង ណាស់ អំពី រឿង នេះ ដោយសារតែ វា មាន លក្ខណៈ បង្កហេតុ ។
សមត្ថកិច្ច កំពុង សាកសួរ អ្នក ទាំង១០នាក់ នេះ ។
សម្រាប់ តំណែង បណ្ណារក្ខ ម្នាក់ មាន ឋានៈ ស្មើនឹង រដ្ឋមន្ត្រី មួយ រូប របស់ អាមេរិក ។
នេះ ជា លើក ទី១ ហើយ ក្នុង រយៈពេល ៣០ ឆ្នាំ ដែល ពហុកីឡាដ្ឋាន នេះ បាន ត្រូវ ទឹកភ្លៀង ជន់ លិច បែប នេះ ។
ឥត ប្រយោជន៍ ដូច សាសន៍ ដទៃ នោះ ឡើយ ។
នឹង សណ្ឋិត នៅលើ ព្រះបុត្រា នោះ
ការ នៅ បន្ត និរន្តរភាព របស់ តុលាការ នេះ កំពុង ស្ថិត នៅជា ចំណោទ មួយ ។
អ្នកសារព័ត៌មាន ១១០ នាក់ ត្រូវ គេ សម្លាប់ ក្នុង ឆ្នាំ ២០១៥នេះ ភាគ ច្រើន នៅក្នុង ប្រទេស ដែល មាន សន្តិភាព
ថ្ងៃ សិទ្ទិ នារី និង សិស្ស ខ្ញុំ ទេវតា ចិត្ត ល្អ
ដូចគ្នា នេះ ផងដែរ អ្នក គួរ ផ្លាស់ប្តូរ ទម្លាប់ របប អាហារ របស់ អ្នក និង ព្យាយាម ប្រើប្រាស់ អាហារ សម្បូរ វីតាមីន សារធាតុ រ៉ែ និង សារធាតុ ប្រឆាំង អុកស៊ីតកម្ម ។
គួរ បញ្ជាក់ ថា សម្រាប់ ហេតុការណ៍ ដែល នឹង កើតឡើង មុន គេ នៅពេល មនុស្ស ទាំងអស់ បាត់ខ្លួន ភ្លាម ៗ
កូន ច្បង នឹង ធ្វើជា រណប របស់ កូន ប្អូន ។
មក ចុះឈ្មោះ បោះឆ្នោត នៅក្នុង ឃុំ របស់ ខ្ញុំ ដូច្នេះ ។
ទាំងអស់ គ្នា ដែល បាន ចូលមក លេង ។
នេះ បើ តាម ការ ឱ្យដឹង ដោយ កូនប្រុស ម្នាក់ របស់ លោក
មនុស្ស ភាគ ច្រើន ចង់ ស្វែងយល់ បន្ថែម អំពី អនាគត អាជីព និង សេចក្តីស្រឡាញ់ របស់ ពួកគេ រឿង នេះ យើង មាន ការចាប់អារម្មណ៍ បំផុត គឺជា អ្នក ដែល ស្រឡាញ់ ជីវិត របស់ យើង យ៉ាងម៉េច នោះ ។
មិន ត្រឹមតែ បាត់បង់ មនុស្ស ប៉ុណ្ណោះ ទេ ប៉ុន្តែ អ្នក ក៏ នឹង ក្លាយជា បុគ្គល របស់ ខ្លួន ឯង ផងដែរ ។
រដ្ឋាភិបាល ថ្មី នេះ ត្រូវបាន ទទួលស្គាល់ ពី សហរដ្ឋ អាមេរិក ។
ការប្រកួត នេះ នឹង ចាប់ផ្តើម នៅ ថ្ងៃទី ២៦សីហា ។
នោះ ធៀប ដូចជា ព្រួញ នៅ ដៃ នៃ មនុស្ស ខ្លាំង ពូកែ
ប៉ុន្តែ ព័ត៌មាន លំអិត បែប ណា នោះ មិន អាច ទាន់ ប្រាប់ បាន ទេ ។
យើង មិន បាន ត្រៀម ខ្លួន ដើម្បី ទទួលស្គាល់ ចំណុច ខ្វះខាត ផ្ទាល់ របស់ យើង ទេ ។
បើសិនជា នាង សរសើរ អ្នក ដូចម្តាយ អ្នក សរសើរ អ្នក ដែរ នោះ មាន ន័យ ថា នាង ពិតជា សង្សារ ដ៏ ល្អ បំផុត សម្រាប់ អ្នក ហើយ ៕
ទាំង ថ្ងៃ យប់ ក្តៅ រងា ភ្លៀង ប្រឈម នឹង បញ្ហា
លុយ គាត់ នេះ វា គ្មាន ប្រភព ច្បាស់លាស់ ទេ ។
ទៅនឹង បញ្ហា នេះ នៅឡើយ ទេ ៕
ជា ការពិត ណាស់ កន្លងមក គេ តែង សង្កេតឃើញ ថា តារា ស្រី ឈិ
មួយ រយៈ កន្លងមក យើង ធ្វើ អ៊ីចឹង ។
ចំណែកឯ អ្នក ខ្លះ ទៀត ខ្មាស មិន ហ៊ាន ប្រាប់ ត្រង់ ថា ពួកគេ មិន ដឹង ចម្លើយ នោះ ទេ ។
ក្លិន អើយ អើយ ក្លិន ហេតុ អ្វី រសាត់ រសាយ ទៅ បាត់
ប៉ុន្តែ វា ក៏ ជា បញ្ហា ដែល ថា អាច និយាយ ជា ភាសា ជប៉ុន បាន ហើយ នៅតែ ប្រើប្រាស់ ភាសា កម្ចី ។
ដូចនេះ ហើយ ទើប មាន គ្នា យើង ខ្លះ មិន សូវ ហ៊ាន ទៅ ធ្វើ ធ្មេញ ផ្តេសផ្តាស ទេ ដោយសារ ខ្លាច ឆ្លង ជំងឺ តេតាណូស ។
បច្ចុប្បន្ន ពិតជា ត្រជាក់ចិត្ត និង កំពុង មើល កុន ហួស សម័យ ដ៏ ល្អ មើល ជាមួយ មិត្តភក្តិ ។
ខ្ញុំ ខំ ឈានចូលទៅ ជិត ឡើង ៗ
ខ្ញុំ ជាប់ ដេក ពេទ្យ ដោយសារ គ្រោះថ្នាក់ ការងារ ។
អ្នកឯង កំពុង ធ្វើ បទល្មើស ជាក់ស្តែង ។
លោក ថា បញ្ជា ទាំង នេះ ជា ឧបសគ្គ នៃ ការអភិវឌ្ឍ ដូច្នេះ ត្រូវ មាន តួអង្គ ចេញមុខ ដោះស្រាយ ៖
ការផ្លាស់ប្តូរ វា កំពុងតែ កើតឡើង ហើយ ។
ប្រធាន ថូម៉ាស អេស ម៉ន សុន បាន មានប្រសាសន៍ ថា គ្មាន គោលដៅ ណាមួយ របស់ អ្នក សំខាន់ ជាង ការខិតខំ ឱ្យ មាន ភាពសក្តិសម ដើម្បី ទៅ ព្រះវិហារ បរិសុទ្ធ ឡើយ ។
ពេលវេលា ម៉ោង ធ្វើការទំនាក់ទំនង ៨ព្រឹក ដល់ ៨យប់ សូម អគុណ
ពួកគេ មិន រក យុត្តិធម៌ អោយ ជន ក្រីក្រ ឡើយ ។
៣ផ្សេង ទៀត ដែល ទើបនឹង បោះជំហាន មក ក្នុង ទីផ្សារ នេះ ។
ដោយ ធ្វើ តាម តែ បញ្ជា នៃ តណ្ហា របស់ ខ្លួន គេ ក្លាយទៅជា ញៀន នឹង ការសប្បាយ ព្រៃផ្សៃ ។
្ជាតិសរ៊ីី លោក ចចសាប្រា កណ្តាល ក្នង
ខ្លួន ដោយ បន្សល់ទុក នៅ ម៉ូតូ ០១ គ្រឿង ។
មិត្ត រួម ថ្នាក់ របស់ នាង មើលឃើញ ហើយ និយាយ ថា ៖
សុំទោស អាមួយ នេះ គេ កក់ ទុក ហើយ
យើង ជា អន្តរការី រវាង កសិករ និង ទីផ្សារ ។
ហើយ យល់ យ៉ាងម៉េច ដែរ ចំពោះ មុខ
មាន នៅ ទីនេះ អាច ចូល ឆែកមើល បាន
អនុស័យ ចូរ មើល នយ លក្ខណៈ ក្នុង សង្គីតិ សូត្រ ខាង ដើម ផង ចុះ ។
អង្គែ អាច ឆ្លង គ្នា នៅក្នុង ក្រុមគ្រួសារ ។
អ្នកវិភាគ នយោបាយ កម្ពុជា យល់ ថា សកម្មភាព ទាំងនេះ …
ក្រុមហ៊ុន នេះ និយាយ ថា រថយន្ត នេះ អាចនឹង មាន ដាក់ លក់ ក្នុង រយៈពេល ពីរ ឆ្នាំ ទៀត ។
យើង អាន ថ្នាក់ ទី៧
ក្នុង ពេលនេះ សូម សាកល្បង ៖
អ្នកសារព័ត៌មាន អត់ ដឹង ទេ ព្រោះ អី ជារៀងរាល់ ថ្ងៃ យើង រាយការណ៍ ព័ត៌មាន ច្រើន ណាស់ ។
ឪពុក ម្តាយ សិស្ស ងាយ រងគ្រោះ មក ទទួល អង្ករ កន្លងមក ។
សំណើ គ្មាន រទេ ។
ពលរដ្ឋ អ្នកគាំទ្រ របស់ លោក វិញ ។
ភ្នំពេញ ប្រជាពលរដ្ឋ ជាច្រើន នាក់ បាន ប្រាប់ …
ខ្ញុំ ពិតជា ពិបាកចិត្ត ណាស់ ដែល ឃើញ ពួក នាង ត្រូវបាន គេ បញ្ជូន ដាក់ចូល ក្នុង ពន្ធនាគារ ព្រោះ រឿង នេះ ។
នោះ ជា អ្វី ដែល ធ្វើឱ្យ ក្រុម យើង ខ្លាំង ។
គុណសម្បត្តិ សំខាន់ ទាំង៣ នៃ ការធ្វើ សមាធិកាបូអ៊ីដ …
ទី មួយ យើង មិន ត្រូវ ធ្វើ ការសម្រេចចិត្ត និង ជ្រើសរើស តាម ការប្រឹក្សា របស់ មនុស្ស ដែល មិន កោតខ្លាច ព្រះឡើយ ។
រឿងក្តី លោក ជា វិជ្ជា នឹង ជំនុំជម្រះ ឡើងវិញ នៅ ថ្ងៃពុធ នេះ
ជាក់ស្តែង វា ជួយ យើង ឱ្យ ចេញ ឆ្ងាយ ពី ការធ្វើ រឿង ជាច្រើន ដែល មិន គួរ ធ្វើ និង មាន គ្រោះថ្នាក់ ។
គណះ បក្ស ប្រឆាំង ទាំងអស់ សុទ្ធតែ ជា ភេវករ សូមអញ្ជើញ ចាប់ ទៅ ។
មួយចំនួន ដើម្បី ការពារ កុំ ឱ្យ ហួស ពេល បាន ។
បញ្ជូន មក ដោយ មាន ការបំពាន សិទ្ធិ ។
និទណ្ឌភាព នៅតែ ជា ការព្រួយបារម្ភ បំផុត នៅ កម្ពុជា … ។
វា មិន ខុសពី យក កូនក្មេង អាយុ ១០ឆ្នាំ ទៅ ប្រឡង បាក់ឌុប ទេ ។
សកម្មភាព និង លទ្ធផល នានា និង បាន បង្ហាញ ថា ពួកគាត់ បាន រួមចំណក
លោក យ៉ុង ជីន ត្រូវបាន គេ ឃាត់ខ្លួន ភ្លាម ៗ
ខ្ញុំ បាន ចូលរួម លើកទឹកចិត្ត ដល់ ក្មេង ៗ
និង ទី៣. បណ្តាល មកពី ការលួងលោម ទិញ ទឹកចិត្ត រួមទាំង ការគំរាមកំហែង ផងដែរ ។
ប៉ុន្តែ តើ រួមភេទ គួរ ចាប់ផ្តើម នៅ ពេលណា ?
ខ្ញុំ មានអារម្មណ៍ ថា សំណាង ដែរ ដែល ខ្ញុំ អាច រក្សា ជីវភាព គ្រួសារ ទាំងមូល បាន ។
ការបាត់ មុខ របស់ លោក ក៏ ស្រប ពេល ដែល គណៈ រដ្ឋមន្ត្រី បាន លើក កិច្ចប្រជុំ ពេញ អង្គ ចំនួន ២សប្តាហ៍ ជាប់ ៗ
ទោះបីជា យ៉ាងណា ក៏ដោយ សហរដ្ឋ អាមេរិក មិន បាន បង្ហាញ ជាសាធារណៈ នូវ ភ័ស្តុតាង ជាក់លាក់ ណាមួយ ស្តី អំពី ថា តើ ការគំរាមកំហែង របស់ អ៊ីរ៉ង់ គឺជា អ្វី នោះ ទេ ។
បាយការណ៍ ត្រីមាស ទី៣ឆ្នាំ ២០១២
នេះ ជា លើក ទី ពីរ ហើយ ដែល ទីក្រុង ជា ម្ចាស់ ផ្ទះ នៃ ការប្រកួត បាល់ទាត់ ពិភពលោក
យ៉ាងហោចណាស់ អ្នក ត្រូវតែ ទៅ ជួប ពេទ្យ ធ្មេញ ជាង រៀងរាល់៦ ខែម្តង់ ដែរ ព្រោះ ពួកគេ អាច
ទាំងនោះ ត្រូវបាន សាយភាយ មុន ការគ្រោងទុក ។
របស់ ពួកគេ ជាមួយ មិត្តភក្តិ ឬ នៅលើ ពិភពលោក ។
ព្រះអង្គ ប្រទាន អោយ ខ្ញុំ ដើរ នៅលើ ទី ខ្ពស់ ៗ
លោក ដូណាល់ ត្រាំ ប្រឈម នឹង បទ ចោទប្រកាន់ ៣
នាយ ចឺម និង ឈុន សុវណ្ណ ភក្តី ធ្វើឱ្យ អ្នកគាំទ្រ កាន់តែ ចាប់អារម្មណ៍ !
ដូច្នេះ ចូរ មាន សង្ឃឹម និង ផ្ញើ ជីវិត លើ ព្រះអង្គ ចុះ ។
ដើម្បី ធានា ថា សិទ្ធិ និង អំណាច ស្ថិត ក្នុង ដៃ ប្រជាពលរដ្…
តើ អ្នក មាន លុយ គ្រប់គ្រាន់ សម្រាប់ ចាយវាយ នៅ ពេល ដែល អ្នក កំពុង ស្វែងរក ការងារ ថ្មី ដែរ ឬ ទេ ?
ទោះបីជា ខំប្រឹងប្រែង គេច កល់ យ៉ាងណា អំពល់ នៅ ឥត ប្រយោជន៍ ។
ជ្រោះ ត្រី នេះ ទើប ត្រូវបាន ផ្សាយ ឱ្យដឹង ជាសាធារណៈ កាលពី ប្រមាណ ២០ ឆ្នាំ មុន ។
គាត់ ប្រុង វ៉ៃ សម្រុក មក តែ គាត់ មិន យល់ ថា ខ្ញុំ ខ្លាំង ប៉ុណ្ណា ។
ដូច្នេះ សូម បងប្អូន កុំ ជេរ គាត់ អី ។
គុណវិប្បត្តិ៤យ៉ាង នៃ ការគេង កើយ ខ្នើយ របស់ ទារក
បន្ទាប់មក គេ បង្ហាញ ផ្លូវ ឱ្យ រក មេធាវី ដែល ជា បក្ខពួក គូកន របស់ គេ ឱ្យ ទៅ ទាក់ទង ដល់ អ្នក ដែល ចាញ់ ក្តី ទៅ ពឹងពាក់ មេធាវី ដើម្បី បន្ត ក្តី របស់ គេ ទៅ ថ្នាក់ លើ ទៀត ។
ដែល ទីក្រុង នេះ មិន ដែល ធ្លាប់ ជួបប្រទះ ។
ហើយ នៅពេល អ្នក ចូល គេហទំព័រ ភាសា ដទៃ ទៀត យ៉ាងម៉េច ដែរ ?
ថ្ងៃ នេះ សូម បង្ហាញ អំពី វិធី បណ្តុះ ម្នាស់ ពី គ្រាប់ ជូន ដល់ ពុក ម៉ែ បងប្អូន ដែល ជា កសិករ
តាមពិត គាត់ ជា អ្នកបម្រើ របស់ ប្រជាជន ទេ ។
អេដា និង គូស្នេហ៍ បង្អួត អាជីវកម្ម មុន ដាច់ ឆ្នាំ
ខ្ញុំ ហុច ដើម គ្រិស្ត ម៉ាស កាលពី ៧ឆ្នាំ មុន ។
ព្រោះ កើត ព្រោះ ព្រាត់ប្រាស ព្រោះ ស្លាប់ ។
នៅ បណ្តា ខេត្ត ខ្លះ អាច មាន ភ្លៀង ធ្លាក់ ខ្សោយ ។
ទិញ បំពុង ពន្លត់ អគ្គីភ័យ ទុក នៅក្នុង ផ្ទះ ករណី មាន ភ្លើង ឆាបឆេះ ល្មម ៗ
នេះ ជា ការវិនិយោគ មួយ ដែល សំខាន់ បំផុត នៅក្នុង ជីវិត ។
អ្នក គិត ជ្រៅ ចូលចិត្ត ស្តាប់ ។
ដូច្នេះ សំណង់ ដែល ប្តឹង ដោយ មន្ទីរ ជំនាញ ខាងលើ មិន ដឹង មាន ប្រសិទ្ធភាព ប៉ុន ណា ទេ ?
ឧ.វ៉ាន់ នី ដើរ ទិញ ឥវ៉ាន់ បាន សព្វគ្រប់ ។
ទោះ យ៉ាង នេះ ក្តី លោក ទទួលស្គាល់ ថា ថ្មី ៗ
ក្រុម គណបក្ស ប្រឆាំង ក៏ មិន សូវ ខ្វល់ ថា ប្រទេស ថៃ មាន មហិច្ឆតា ខ្លាំង ណាស់ ណា ទេ ។
ព្រឹត្តិការណ៍ វប៌្បធម ជា លក្ខណៈ អន្តរជាតិ ធំ ជាង គេ បង្អស់ នៅ កម្ពុជា បាន ត្រឡប់មក ជាថ្មី ម្តង ទៀត ហើយ !
ឪពុក ម្តាយ របស់ ពួកគេ បាន បដិសេធ នូវ សំណើ របស់ ពួកគេ ។
ទៅដល់ មហាជន ដែល ចង់ ដឹង រឿងរ៉ាវ ទាំងនោះ ។
មួយចំនួន ដើម្បី សម្រួល អ្នក ចុះ កម្សាន្ត នៅ តាម ដងផ្លូវ មួយ នេះ ។
អាឡ័យ ពី កានិរាស ព្រាត់ប្រាស់ ព្រះវរ មាតា ។
អាជ្ញាធរ បាន ព្រមាន អ្នកភូមិ បឹង កក់ ចំពោះ ការតវ៉ា
លោក បាន អះអាង ថា មនុស្ស ជាង ១លាន នាក់ មាន វត្តមាន ក្នុង ការតវ៉ា នេះ ។
ពួកគាត់ តែងតែ ចុះ ផ្តល់ អត្តសញ …
ជំហាន ទី1 សូម ចុច ឯកសារ នៅលើ ម៉ឺនុយ កំពូល
នារី ម្នាក់ ថែទាំ ម្តាយ ដូច ដែល ម្តាយ ធ្វើ មក លើ នាង កាលពី ២០ ឆ្នាំ មុន
ងឿងឆ្ងល់ ថា គូស្នេហ៍ នេះ ស្ម័គ្រចិត្ត គ្នា សោះ តែ បែរជា ខុស ខាង ប្រុស ទៅវិញ ?
នៅ សប្តាហ៍ នេះ ខ្សែភាពយន្ត ថ្មី ៗ
ប្រជុំ តុ មូល វគ្គ ទី១ គឺ នៅ ពេលព្រឹក និង ប្រជុំ វគ្គ ទី២គឺ នៅពេល រសៀល ថ្ងៃ ដដែល ។
ខ្ញុំ ចូលចិត្ត ប្រុស ៗ
បើ ដូចគ្នា នឹង ស្វ៊ីត ជាប់ បន្ត បន្ទាប់2 គេ បាន
វត្តមាន ក្នុង ការប្រកួត បាល់ទាត់ ពិភពលោក មាន ចំនួន 6លើក ។
ប៉ុន្តែ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ នៅ មានកំហិត នៅឡើយ ។
មនោសញ្ចេតនា ពុំ ទាន់ មាន អ្វី គួរឱ្យ សង្ឃឹម ហេតុ នេះ ធ្វើឱ្យ អ្នកនឿយណាយ ។
ក៏ប៉ុន្តែ ម្សិលមិញ មាន ការ មិន យល់ គ្នា ក៏ មាន ព្រឹត្តិការណ៍ ហ្នឹង កើតឡើង ។
ពួកគេ តែង ប្រកាស ថា ពួកគេ ជា អ្នក បំរើ រាស្ត្រ ដែល ការពិត នេះ គ្រាន់តែ ជា ពាក្យ បោកប្រាស់ ប៉ុណ្ណោះ ។
ពួកគេ ពិតជា លើកទឹកចិត្ត យ៉ាង ខ្លាំង ។
ស្រឡាញ់ មាន ពីរ យ៉ាង គឺ ៖
ខាងក្រោម នេះ យើងខ្ញុំ នឹង បង្ហាញ អ្នក ពី ស្ថានភាព៣ ដែល អ្នក មិន គួរ ញ៉ាំ ស្រា ។
បើក រថយន្ត ឱ្យ ស្រួល ទៅ មើល តិច គ្រាប់បែក ផ្ទុះ ឥឡូវ ហើយ
គាត់ គឺជា សាក្សី សុចរិត ។
សិរី មង្គល រៀល អ៊ីស្ទេត
ព្រះអង្គ ប្រទាន អោយ លោក មាន ប្រាជ្ញា វាង វៃ និង គាប់ ព្រះហឫទ័យ ព្រះចៅ ផារ៉ោន ជា ស្តេច ស្រុក អេស៊ីប ។
ស្ថិត នៅ ផ្ទៃ ខាងក្រៅ នៃ បន្ទះ បិទ ។
ប្រសិនបើ អ្នក អាច ធ្វើ បែប នេះ ជាប្រចាំ អ្នក នឹង អាច ឃើញ លទ្ធផល មិន ខាន ។
បញ្ជាក់ ដែរ ថា ទូក ចូលរួម សរុប ២៩៧ ទាំងអស់ ២៥ ស្ថាប័ន តិច ជាង ឆ្នាំ មុន ចំនួន ១ទូក ។
មាន រឿង ជាច្រើន ដែល អាច បង្ក ឬ ធ្វើអោយ មាន បញ្ហា លើ ប្រព័ន្ធ ចរន្ត អគ្គិសនី បេះដូង ។
យើង មាន ក្រុម ព័ត៌មាន មួយ ក្រុម ដែល អាច ឆ្លើយ នឹង សំនួរ របស់ លោក អ្នក បាន ។
ប្រភព ពី គេហទ័រ ៖
ដូច្នេះ វា នឹង មាន ផល ប៉ះពាល់ ប្រសិនបើ ការពិត ទីផ្សារ ទាំង នេះ ត្រូវបាន បិទ មែន នោះ ។
ប្រជាជន ដឹង ថា បន្លែ
ឧទាហរណ៍ វ៉ាក់សាំង ចិន មិន អនុញ្ញាត់ ឱ្យ មាន ការប្រើប្រាស ។
តើ អ្នកដំណើរ ជាតិ និង អន្តរជាតិ ត្រូវ ធ្វើ ដូចម្តេច ក្នុង អំឡុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ?
បាន ចូល ផ្សព្វផ្សាយ ពី យេស៊ូគ្រិស្ត ។
កម្លាំង ប៉ុស្តិ៍ នគរបាល ឃុំ ស្នួល ចុះ ផ្សព្វផ្សាយ សេចក្តី អំពាវនាវ
ជា ផ្នែក មួយ នៃ ជីវិត របស់ អ្នកប្រើប្រាស់ វា ។
យើង ចំណាយ ពេល ៩ឆ្នាំ ដើម្បី ផលិតភាពយន្ត នេះ ។
ទះ គេ មួយ ដៃ គេ សង វិញ ៥កាំបិត ប៉័ង តោរងរបួស ធ្ងន់
លោក ប៉ុន សន បាន មានប្រសាសន៍ ថា មាន ការខ្វែងគំនិត គ្នា និង ការ មិន ចុះសម្រុង គ្នា ខ្លះ ៗ
រីករាយ អនេក ស្អែក យើង ចងចាំ រាំ វង់ ឆ្លង ឆ្នាំ នៅ វិមាន ឈ្នះ ឈ្នះ ។
លើក ទី ២១ ថ្ងៃទី ១៨វិច្ឆិកា នៅ ភ្នំពេញ
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន បញ្ជាក់ ថា ដូច សព្វមួយ ដង ការងារ លោក គឺ មាន ជារៀងរាល់ ថ្ងៃ ។
ឥណ្ឌា ពាក់កណ្តាល ហើយ មនុស្សម្នា តែង សួរ ខ្ញុំ ពី បញ្ហា នោះ ។
ខ្ញុំ នឹង សរសើរ តម្កើង ព្រះអង្គ ក្នុង ចំណោម
ពិធី ជ្រមុជ ទឹក នេះ សង្គ្រោះ បងប្អូន ដោយសារ ព្រះយេស៊ូគ្រិស្ត មាន ព្រះជន្ម រស់ ឡើងវិញ ២២ ព្រះអង្គ បាន យាង ឡើង ទៅ ស្ថាន បរម សុខ គង់ នៅ ខាងស្តាំ ព្រះជាម្ចាស់ ហើយ ពួក ទេវតា ព្រមទាំង វត្ថុ ស័ក្តិសិទ្ធិ នានា ដែល មាន អំណាច និង ឫ ទ្ធានុភាព នានា ចុះ ចូល នឹង ព្រះអង្គ ទាំងអស់ ។
អយុត្តិធម៌ ចំពោះ នាង ពេក ហើយ !
ផ្តល់ អំណោយ ដល់ ពលរដ្ឋ រងគ្រោះ ភ្លើង ឆេះ ផ្ទះ នៅ សិរី សោភ័ណ
សូម បញ្ជាក់ ជូន ទាំង ខ្ញុំ ក្តី ទាំង អ្នកណា ក្តី អត់ មាន សិទ្ធិ ទេ ។
ហើយ វា មិន បាន ផ្តល់ ប្រយោជន៍ អ្វី សោះ ដល់ អ្នក ជាពិសេស ក្នុង រយៈពេល វែង ។
ដើម្បី ក្លាយជា មន្ត្រី នគរបាល ពិតប្រាកដ ត្រូវ មាន លក្ខណៈ សម្បត្តិ គ្រប់គ្រាន់ ជាមុន សិន
នេះ បាន ហៅ ថា អ្នក ដែល មាន ចិត្ត ធមិ៍ តាម ឱវាទ ព្រះសម្មាសម្ពុធ មែន ។
យ៉ាងណាមិញ ក្រៅពី ជា តារាចម្រៀង នាង ក៏ បាន វិវត្ត ខ្លួន មក ជា តារា សម្តែង ផងដែរ ។
យ៉ាងណាមិញ ក្រុម សិទ្ធិ មនុស្ស បាន ប្រតិកម្ម ខ្លាំង ៗ
សម្រាប់ ខ្ញុំ ខ្ចី ដឹង ខ្ចី ឱ្យដឹង ឱ្យ បែងចែក ដាច់ ពី គ្នា ។
ប៉ុន្តែ ជា ក្រុម មួយ ពួកគេ ត្រូវតែ ភ័យ ចំពោះ ពួកយើង ជា ក្រុម តែម្តង ៕
លោក ហ៊ុន សែន បាន មានប្រសាសន៍ រំលឹក ពី ពេល នោះ មកវិញ ថា ៖
ដូច្នេះ កម្លាំង នគរ ស្ថិត នៅលើ កសិកម្ម ។
នេះ ខ្ញុំ ពិបាក បែងចែក រវាង ភក្តីភាព ចំពោះ គ្រួសារ និង ផលប្រយោជន៍ ជាតិ វា ជា ភាពតានតឹង មួយ មិន អាច ដោះស្រាយ រួច ដល់ ពេលវេលា ហើយ ដែល មនុស្ស ឯទៀត បន្ត មុខ នាទី ទាំងនេះ ពី ខ្ញុំ ក្នុង ឋានៈ ជា សមាជិក សភា និង ជា រដ្ឋមន្ត្រី ។
វិធីសាស្ត្រ ទាំង3 ខាងលើ នេះ សុទ្ធតែ មាន លក្ខណៈ ពិសេស រៀង ខ្លួន ៗ
សម្លាប់ គេ ហើយ នៅ រួច ខ្លួន ឱ្យ គ្រហើរ ៗ
ខ្ញុំ ប្រឹង ថា ឱ្យ ចាក់ ផ្លូវ ហ្នឹង បាន មួយ ខ្សែ ទៅ ត្រឹម មជ្ឈមណ្ឌល បណ្តុះបណ្តាល របស់ ថៃ ។
ខ្ញុំ អង្គុយ មើល តាំងពីដើម មកវិញ ។
រួច អនុវត្ត ដូចគ្នា ចំពោះ ជើង ម្ខាង ទៀត ៕
អ៊ីចឹង ព្រោះ យើង រស់ នៅក្នុង សង្គម ទាំងអស់ គ្នា ។
ដោយ បរាជ័យ នេះ ជាបរាជ័យ លើក ទី១ សម្រាប់ លោក …
ដ្បិត សត្រូវ ឡោមព័ទ្ធ អ្នក ហើយ !
ជំនួប រវាង ភាគី ទាំង ពីរ បាន ធ្វើឡើង នៅ ព្រឹ…
សេចក្តីថ្លែងការណ៍ នេះ ត្រូវបាន គាំទ្រ ដោយ ការពិត ដែល ទាំង បុរស និង ស្ត្រី មាន រចនាសម្ព័ន្ត រាងកាយ ខុស ៗ
ចាប់ពី ថ្ងៃទី ១៧ ខែតុលា ទៅ ប្រទេស កាណាដា នឹង អនុញ្ញាតឱ្យ ដាំដុះ កាន់កាប់ និង ប្រើប្រាស់ កញ្ឆា សម្រាប់ គោលបំណង កែ ឆ្នៃ ។
ភិក្ខុ ឡុង ចន្ថា គេចខ្លួន ពី សមត្ថកិច្ច និង មិន ព្រម លា ចាក សិក្ខាបទ ឡើយ
័ែដល តថគត បន សែមង
ប៉ុន្តែ នៅ ថ្ងៃ បន្ទាប់ បុរស នោះ មាន អាការៈ ក្អក និង គ្រុន ក្តៅ ទាប ។
នៅក្នុង ប្រទេស ជាច្រើន វា អាច ស្រប ច្បាប់ ទោះបីជា ខុស ក្រមសីលធម៌ ក៏ដោយ ។
មនុស្ស ប្រហែល១.០០០ នាក់ បាន ចុះឈ្មោះ តាម បណ្តាញ សង្គម ហ្វេសប៊ុក ដើម្បី ចូលរួម ព្រឹត្តិការណ៍ នេះ ។
សាកសព ជនរងគ្រោះ ប៉ូលិស បាន ប្រគល់ ឱ្យ ស្ថានទូត នៅ រសៀ់ល ថ្ងៃ ដដែល នេះ ៕
សមាគម អ្នកសារព័ត៌មាន ទាំងអស់ ហ្នឹង គួរតែ រួមគ្នា ទៅ ថា តើ យើង ត្រូវ ធ្វើ យ៉ាងម៉េច ដើម្បី ការស៊ើបអង្កេត ?
តំណាងរាស្ត្រ អាមេរិក ថា កម្ពុជា មិន អាច បោះឆ្នោត ជាតិ ខាងមុខ តែ ឯង បាន ទេ
អ្នកស្រី ចំរើន ចន្ទ លីដា
ដែល យើង ចេះតែ បំភ័យ ប្រជាពលរដ្ឋ ដោយសារ គឺ យើង មិន មាន ការបោះឆ្នោត ជា សកល អ៊ីចឹង ទេ ។
ហើយ មាន តែ សាច់ញាតិ និង មិត្តភក្តិ ជិតស្និត តែ ប៉ុណ្ណោះ ដែល បាន ចូលរួម ក្នុង ពិធី លា ចុងក្រោយ កាលពី ថ្ងៃទី ២៦វិច្ឆិកា កន្លងទៅ ។
ហើយ ជាមួយគ្នា នោះ ដែរ វា ក៏ ឱ្យ យើង មាន ឱកាស ដើម្បី ទទួលបាន អាហារូបករណ៍ ផ្សេង ៗ
ថ្ងៃ ចុង សប្តាហ៍ ចែក គ្នា ហិត ក្លិន លេង ។
ខ្ញុំ ថា ខ្ញុំ អត់ទ្រាំ នឹង ការប្រើ ពាក្យ មិន សូវ ពិរោះ ស្តាប់ ដើម្បី កុំ អោយ គេ ថា ខ្ញុំ ឈ្លើយ
