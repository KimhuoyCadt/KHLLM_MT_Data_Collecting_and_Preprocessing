តោះ ប្រិយមិត្ត ទៅ មើល រូបរាង របស់ ស្រី ស្រស់ រូប នេះ បន្តិច មើល៍ !
របស់ លោក អ្នក នឹង កាន់តែ រង ទុក្ខ ។
ប្រធានាធិបតី សហរដ្ឋ អាមេរិក និង ភរិយា មេឡានៀ ត្រាំ
ទីក្រុង ភ្នំពេញ មិន មែន ជា ប្រទេស កម្ពុជា ទាំងមូល នោះ ទេ ។
ខ្ញុំ មិន យល់ ពី អនុប្រធានា តិបតី អាមេរិក ដែល សរសេរ លិខិត មក ខ្ញុំ យ៉ាង ដូច្នោះ ។
មនុស្ស រវល់ យ៉ាងណា ក៏ដោយ បើ មាន ក្តី ស្រលាញ់ ពិត គេ នៅតែ អាច បែងចែ ពេលវេលា សម្រាប់ អ្នក ។
អ្វី គ្រប់ យ៉ាង ក្នុង ជីវិត គឺជា ជម្រើស
បទ គម្ពីរ មួយ ជំពូក នេះ មាន ចំណុច សំខាន់ ពីរ យ៉ាង ដែល គួរឱ្យ កត់សំគាល់ ។
ដើម្បី ត្រួតពិនិត្យ ថា អ្នក បាន អនុវត្ត ត្រឹមត្រូវ សូម ដាក់ ដៃ មួយ លើ ពោះ និង ដៃ មួយ ទៀត លើ ទ្រូង ។
យើង គ្រាន់តែ ចូលរួម ជួយ ប្រទេសជាតិ ។
តើ ត្រូវ ធ្វើ ដូចម្តេច បើសិនជា អ្នក គិត ថា ខ្លួន ជា ជនរងគ្រោះ ?
ជាច្រើន អញ្ជើញ ចូលរួម … មាន វីដេអូ
អ្នកជំនាញ ដ៏ ល្បីល្បាញ ប្រាប់ ថា បើ ប្រទេស ជា …
ចំពោះ ម្ចាស់ ផ្ទះ ប្រឈម នឹង ចំណាត់ការ របស់ តុលាការ ៕
ជាង គេ របស់ ខ្លួន ដើម្បី ជា ប្រយោជន៍ របស់ អ្នក ផ្សេង ទៀត ។
ប៉ុន្តែ ឥឡូវនេះ គេ គ្មាន អ្វី ដោះ សា អំពី បាប របស់ ខ្លួន ឡើយ ។
ដូច្នេះ វា មាន ចំណុច យ៉ាង ជាក់លាក់ ថា អ្នក ត្រូវតែ បង្គ្រប់ ជាតិ ទឹក ដល់ រាងកាយ វិញ ដោយ ការផឹក ទឹក អោយ បាន ច្រើន ។
ម៉ារី ប្រហែលជា មិន ដឹង អំពី រឿង នេះ នោះ ទេ ប៉ុន្តែ ការស្រាវជ្រាវ ថ្មី អាច បង្ហាញ ថា វា ជំនួយ លើ អ្វី ម្យ៉ាង ។
រួម អាជីព ដែល បង្ហាញ ពី ចេតនា ឌឺដង ឱ្យ អ្នក មាន ជំនួប ស្នេហ៍ ត្រីកោណ ។
ថា ពួកគេ មិន ត្រូវ ប្រឡូក ជាមួយនិង ការរួមភេទ ទេ រហូតដល់ ពេល ពួកគេ រៀបការ ។
និង កាន់តែ អាក្រក់ ។
ជន ទុច្ចរិត នោះ គឺជា មុខសញ្ញា ដែល ដោះលែង ពី ពន្ធនាគារ ថ្មី ៗ
ទទួល ពាក្យសុំ ចាប់ពី 25កញ្ញា
ចំណែក អ្នក រងរបួស នៅ មិន ទាន់ ស្គាល់ អត្តសញ្ញាណ នៅឡើយ ។
ហើយ អស់ អ្នក ដែល ពេញចិត្ត នឹង ស្នា ព្រះហស្ត នេះ
ខ្ញុំ ចូលចិត្ត ជិះ កង់ ដើរលេង ជិត ៗ
ពួកគេ ច្រៀង ជា ភាសា អង់គ្លេស បាន ច្បាស់ ល្អ ហើយ លេង ភ្លេង បាន យ៉ាង ល្អ ទៀត ។
គេ នឹង រក្សា ការប្រើ កណ្តាប់ដៃ ដើម្បី ទប់ទល់ នឹង ក្បាច់ ពិសេស ៗ
ព្រោះតែ គំនិត អាក្រក់ របស់ អ្នកស្រុក នោះ ។
នេះ បើ យោង តាម របាយការណ៍ អង្គការ សុខភាព ពិភពលោក ៕
ម៉ែ ជំហាន គីង្គក់ ជា ជំហាន របស់ គីង្គក់ ហ្នឹង ហើយ ។
គាត់ អង្គុយ លើ សាឡុង មើល ទូរទស្សន៍ យ៉ាង ស្ងៀមស្ងាត់ ។
ប្រាប់ អូន ហើយ មិន សុំ អូន ប្រាប់ វិញ
ឥឡូវ ក្រុម អ្នកគាំទ្រ កំពុង ពិចារណា ពី ការសម្រេចចិត្ត ដ៏ អស្ចារ្យ នេះ ។
តារាចម្រៀង ៥រូប របស់ កម្ពុជា នឹង ចេញ ទៅ សម្តែង នៅ អាមេរិក
ពី ស្រែ ដល់ ក្រុង ងងឹត សូន្យ សុង ក៏ មិន រន្ធត់
នេះ បើ តាម ការបញ្ជាក់ របស់ លោក ហុក សុជី វ័ន គ្រូបង្វឹក វិសាខា ។
ខណៈពេល អ្នក បម្រើ បាន ឈរ ទ្រឹង មួយ កន្លែង ។
មែន ហើយ គាត់ ជា កំពូល អ្នកប្រាជ្ញ ដែល ខ្ញុំ គោរព បូជា ។
ក្រែង អ្នកណា អួត ខ្លួន អេភេសូរ ២៨៩ ។
តើ មាន ជំនាញ អ្វី ខ្លះ ដែល អ្នក ចង់ ទទួលបាន នៅ មុនពេល ការបង្កើត សហគមន៍ អាស៊ាន ឆ្នាំ ២០១៥ ?
សង្គម ដែល មាន ការបៀតបៀន គ្នា សង្គម នោះ តែង រក សេចក្តីសុខ បាន ដោយ លំបាក ។
ហើយ ថា តើ ហេតុ អ្វី បានជា យើង តែងតែ ជ្រើសរើស ប្រធានបទ នេះ មក បង្ហាញ ញឹកញាប់ ?
ធ្វើ យ៉ាងណា ក្នុង ផ្ទះ មិន ត្រូវ ឱ្យ មាន សារធាតុ បង្ក ការរលាក ឬ ក្អក ឡើយ ដូចជា ផ្សែង បារី និង ផ្សែង ភ្លើង ជាដើម ។
អ្នក ត្រូវតែ ចងចាំ ថា ប្រសិនបើ អ្នក ជឿជាក់ លើ ខ្លួន ឯង នោះ មនុស្ស ក្នុង លោក នេះ នឹង ជឿជាក់ លើ អ្នក ៕
បន្ទាប់ពី ព្រះមហាក្សត្រ មាន ព្រះបន្ទូល ព្រះរាជ សារ ផ្ទាល់ របស់ ព្រះអង្គ ដោយ កោតសរសើរ និង អំពាវនាវ ឱ្យ មាន សុខ សន្តិភាព ។
នាងខ្ញុំ ឈ្មោះ ប៊ន់ សាន ឡៃ ស្វែងរក ការងារ
ផ្សេង ទៀត ដែល កំពុងតែ ព្យាយាម និយាយ ។
ដោយសារ ងឿងឆ្ងល់ ពី អាថ៌កំបាំង ស្នេហា នេះ នាង ក៏ សួរ ទៅកាន់ មិត្តភក្តិ ឡើង ថាៈ
គ្មាន តម្លៃ អ្នកនិពន្ធ វង់ ផឿង
គាត់ បាន ចាប់ផ្តើម ដើម្បី ស្នើសុំ រូបភាព អាក្រាត របស់ នាង ។
ទំព័រ មុន ប្រាសាទ ក្បាល គោ ទំព័រ បន្ទាប់ ព្រះបាទ បរម រាជា
ព្រះអង្គ ស្រឡាញ់ អស់ អ្នក ដែល នៅ ជាមួយ ព្រះអង្គ នៅក្នុង ពិភពលោក នេះ ណាស់ ហើយ ព្រះអង្គ ក៏ ស្រឡាញ់ ពួកគេ ដល់ ចុង បំផុត ដែរ ។
ខ្ញុំ ស្រឡាញ់ ដំរី ពីព្រោះ វា រាំ ស្អាត ណាស់ ។
រយៈ ការផ្លាស់ប្តូរ គំនិត របស់ ប្រជាពលរដ្ឋ ។
ម្នាល ភិក្ខុ ទាំងឡាយ ទើប ពួក ឥសី អ្នក មាន សីល មាន គុណធម៌ ដ៏ ល្អ ទាំងនោះ បាន និយាយ នឹង សម្ពរ អសុរិន្ទ ដោយ គាថា ថា
ពេល ពពោះ បើ សុក ចាក់ ចូល ជញ្ជាំង ស្បូន គ្រោះថ្នាក់ ណាស់ !
យើង នឹង ទៅ មណ្ឌល សុខភាព នៅពេល រសៀល នេះ ទៅ សួរ វេជ្ជបណ្ឌិត មួយចំនួន ពី បញ្ហា នេះ ។
អ្នក ដែល មិន បាន បង្ក ជា របួស ស្នាម ផង គ្រាន់តែ នៅក្នុង ចង្កោម មួយ ដុំ ហ្នឹង ។
និង មាន កម្លាំង ខ្លាំងក្លា មក ប្រគល់អោយ អ្នក រាល់គ្នា ។
គឺជា ការយល់ ចិត្ត គ្នា ទៅ វិញ ទៅ មក
សូម អរគុណ ចំពោះ ការចំណាយ ពេល អាន និង សូម ជួយ បញ្ចេញ គំនិត យោបល់ ផ្សេង ៗ
គឺ គ្មាន ផ្លែ ទំពាំងបាយជូរ សោះ
គាត់ កំពុង បង្ហាញ ថា គាត់ ពិត ជើងឯក ៕
ហើយ ខ្ញុំ ក៏ ឃើញ ទេវតា ទាំង ប្រាំពីរ រូប ដែល ឈរ នៅមុខ ព្រះជាម្ចាស់ បាន ទទួល ត្រែ ប្រាំពីរ ។
អន្លង់ ជ្រៃ ពិតជា អាច ធ្វើឱ្យ អ្នកទទួលបាន ភាពសប្បាយរីករាយ មិន ខាន ឡើយ ។
ក្រោយមក បាន បង្ហោះ តាម
កុំ ឱ្យ ប្រព្រឹត្ត កំហុសឆ្គង បែប នេះ ទៅ ថ្ងៃ អនាគត ផងដែរ ។
កម្មករ ទូក នេសាទ សមុទ្រ ម្នាក់ ស្លាប់ ត្រូវបាន សង្ស័យ ថា ជា អំពើ ឃាតកម្ម
គេ អត់ ចាប់ ជនជាតិ អាមេរិក ទេ ។
ខាងក្រោម នេះ យើងខ្ញុំ នឹង ប្រាប់ អ្នក ពី របៀប ទាំងនោះ ដែល អ្នក អាច យក ទៅ អនុវត្ត តាម បាន ។
អ្នក អាច យល់ អំពី ហេតុផ របស់ មនុស្ស ម្នាក់ ទៀត ដោយ មិន បាច់ យល់ស្រប ជាមួយ រឿង នោះ ដែរ ។
យើង នឹង ស្តារ ពួកគេ ឡើងវិញ ព្រមទាំង សំដែង ចិត្ត អាណិតអាសូរ ពួកគេ ថែម ទៀត ផង ។
គាត់ សម្រេច ជ្រើសរើស ផ្លូវ នេះ ។
ឥទ្ធិពល របស់ គាត់ ចាប់ផ្តើម លេចឡើង ។
លុះ ដល់ ម៉ោង ៥ព្រឹក ព្រឹក ភ្ញាក់ ពី ដំណេក ទើប ដឹង ថា បាត់ រថយន្ត តែម្តង ។
នាង ស្មាន ថា ជា អ្នកថែរក្សា សួនច្បារ នាង ក៏ ទូល ព្រះអង្គ ថា ៖
នាង ទាមទារ ភាព កក់ក្តៅ ពី បុរស ។
គ្នា មាន ភ្ជាប់ ប៊ូលីង ៤០០ ។
យើងខ្ញុំ ចំណាយ ពេលវេលា មាន តម្លៃ ជូន ពលរដ្ឋ នៅ មូលដ្ឋាន ។
បើ លោក សម រង្ស៊ី មក នៅ ជាមួយ ខ្ញុំ ល្អ ជាង ខ្ញុំ នៅ ម្នាក់ឯង
នេះ គឺជា សញ្ញា បង្ហាញ ថា ទ្វីប អឺរ៉ុប កំពុង ផ្លាស់ប្តូរ ។
២.វិធី សិល្យ៍ តែង ពីរោះ ក្រៃលែង កុំ ក្រែង សិក្សា
លោក សង្ឃឹម ថា ស្ថាប័ន ពាក់ព័ន្ធ នឹង ជួយ រក យុត្តិធម៌ ជូន លោក ។
ឥលូវនេះ មក ស្កាល់ កន្លែង សប្បាយ ៗ
គ្រាប់ ថ្នាំ អេសង់ទី យ៉ុង ត្រូវបាន រឹបអូស យក និង នាំ ទៅកាន់ វិភាគ ។
អ្នកជំនាញ ខាង ជីវជាតិ ឱ្យដឹង ថា ប្រសិនបរិភោគ សាច់ គោ ជា ប្រចាំ នៅ ពេល យប់ នឹង បង្ក ផល អាក្រក់ យ៉ាង ច្រើន ចំពោះ សុខភាព ។
អនាគត ស្វាមី របស់ តារា ស្រី រូប នេះ មាន អាយុ តិច ជាង នាង ចំនួន ៣ឆ្នាំ ។
សរុប ជា រួម មក អេកូ មាន អត្ថប្រយោជន៍ ខ្លាំង ណាស់ ។
ចំពោះ ខ្ញុំ ខ្ញុំ ពិតជា មាន មោទនភាព ចំពោះ រូប បង ជាខ្លាំង ។
ជីវិត និង ស្នាដៃ របស់ វិល ប័រ និង អ័រ វិលរ៉ៃត៍ អ្នកបង្កើត យន្តហោះ ដំបូង ក្នុង ពិភពលោក ប្រព្រឹត្តិ ទៅ យ៉ាងដូចម្តេច ?
ឧប នាយក រដ្ឋមន្ត្រី ប៊ិន ឈិន បាន ថ្លែង យ៉ាង ដូច្នេះ ៖
កុំ បណ្តោយ ឱ្យ កិច្ចការ លម្អិត ទាំងអស់ នោះ រុញ ច្រាន អ្នក ធ្លាក់ ពី ផ្លូវ ដែល កំពុងតែ ព្យាយាម ។
ប្រសិនបើ របួស ស្រាល ត្រូវ ចំណាយ ពេល ៣៤ ថ្ងៃ ដើម្បីឱ្យ ជាសះស្បើយ ។
មាន អ្នក ចង់ ទិញ ជាច្រើន ។
ក្រោយមក អ្នកស្រី បាន ដឹង ថា លោក ត្រូវបាន គេ យក ទៅ ជំរំអប់រំ ។
ខ្ញុំ មិន ទាន់ ជជែក អំពី បញ្ហា នេះ ជាមួយនឹង សមភាគី ពី ខាង រាជ រដ្ឋាភិបាល នៅឡើយ ទេ ។
ដោះលែង ខ្ញុំ ទៅ សុទ្ធា សាមុត
សូម ចុច ត្រង់នេះ ដើម្បី មើល ការណែនាំ …
ជេននី ដែល បាន រៀបរាប់ នៅ ខាងលើ និយាយ ថា ៖
ករណី នេះ លោក អំពាវនាវ ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ឱ្យ បាន គ្រប់ ៗ
ជារៀងរាល់ ថ្ងៃ មនុស្ស បោកប្រាស់ តែងតែ គិត ពី វិធី ថ្មី ៗ
ម៉ាដូណា និង រ៉ូលីនប្រជែង គ្នា និយាយ ទាក់ទាញ លុយ ធីប ទៀត ហើយ
ស្ត្រី ត្រូវ ជំរុញ ក្នុង វេទិកា មួយ ឱ្យ ចូលរួម ក្នុង ឆាក នយោបាយ
ម្យ៉ាងទៀត វា ជា តំបន់ ប្រវត្តិសាស្ត្រ ធម្មជាតិ ផងដែរ ។
ច្បាប់ បោះឆ្នោត កម្ពុជា ពិតជា តឹងរ៉ឹង ចំពោះ អ្វី ដែល អាច បោះពុម្ព ផ្សាយ ទាក់ទង នឹង ការបោះឆ្នោត ពិត មែន ។
រណសិរ្ស ត្រូវបាន បង្កើតឡើង ដើម្បី រំដោះ ប្រទេស ពី លន់ នល់ ។
ជាមួយគ្នា នេះ ដែរ ខ្ញុំ ពិតជា អរគុណ ខ្លាំង បំផុត ដល់ ការគាំទ្រ របស់ បងប្អូន ទាំងអស់ ហើយ ខ្ញុំ សង្ឃឹម ថា បងប្អូន នៅតែ បន្ត គាំទ្រ ដល់ ពួកយើង ជារៀងរហូត !
បរិយាយ លេខ នេះ ចង់ កំណត់ អាណត្តិ នាយក រដ្ឋមន្ត្រី ?
៩គេ នឹង បញ្ជូន អ្នក រាល់គ្នា ទៅ ធ្វើ ទុក្ខ ទោស ព្រមទាំង អោយ គេ សម្លាប់ អ្នក រាល់គ្នា ថែម ទៀត ផង ។
ខាងក្រោម នេះ ជា ទស្សនា វីដេអូ ចុងក្រោយ របស់ អ្នកនាង សាន ស្រី ឡៃ
អរូប នាម ឧទាហរណ៍ ៖
សំណួរ ទាំង នេះ រួមទាំង ចំឡើយ និង ការបកស្រាយ ពន្យល់ របស់ ព្រះអង្គ ផង គឺ ខ្ញុំ ចេះ ចាំ យ៉ាង រត់ មាត់ ទាំងអស់ ។
អ្នកកាន់ ព្រះពុទ្ធ សាសនា ខ្លះ ចង់ ដឹង … បន្ត ការអាន
កុំ ឱ្យ ខ្វល់ខ្វាយ ឡើយ ចូរ ទូល ដល់ ព្រះជាម្ចាស់ ពី ទុក្ខ កង្វល់ របស់ អ្នក ចុះ ។
នៅពេល ចាប់ផ្តើម ទៅ ញាប់ រន្ថើន នៅពេល បញ្ចប់ ។
នៅពេល អ្នក ប្រហែលជា ត្រូវ រួមភេទ ជាមួយ មនុស្ស ស្រី រឿង ចុងក្រោយ បង្អស់ ដែល អ្នក ចង់ ធ្វើ គឺ ត្រូវ អោយ នាង មាន ចំណាប់អារម្មណ៍ លើ អ្នក ។
ថ្លែង ពី អនាគត កូនប្រសា អ្នកស្រី មិន បាន ប្រាប់ ឡើយ ថា បុរស នោះ ឈ្មោះ អ្វី មាន មុខរបរ អ្វី នៅ អាមេរិក នោះ ទេ ក្រៅពី ប្រាប់ ថា ៖
វា អាច កើតឡើង ទោះបីជា អ្នក មាន សុខភាពល្អ ឥត ខ្ចោះ ។
យ៉ាងហោចណាស់ មាន ជន កម្ពុជា ២សែន នាក់ និង គ្រួសារ របស់ គេ បាន ភៀសខ្លួន ចេញ ទាំង ហ្វូង ៗ
ប៉ុន្តែ សម្រាប់ ជាតិ វា មិន បាន ផលចំណេញ អី ទេបាទ ។
ខ្ញុំ វិញ ចាប់អារម្មណ៍ កន្ទុំ រុយ ព្រោះ វា មាន ឈ្មោះ កំប្លែង !
ប្រការ នេះ រាស្ត្រ នៅ តំបន់ នោះ សូម អំពាវនាវ ដល់ អាជ្ញាធរដែនដី និង ជំនាញ ជួយ ទប់ស្កាត់ ផង ។
អ្នក គឺជា មនុស្ស តែ ម្នាក់ គត់ ដែល អាច កម្ទេច បញ្ហា ជីវិត អ្នក បាន ៕
២២បើ មិន បាន បន្ថយ ថ្ងៃ ទាំងនោះ ឱ្យ ខ្លី ចុះ នោះ គ្មាន មនុស្ស ណា នឹង បាន សង្គ្រោះ ទេ ប៉ុន្តែ ថ្ងៃ ទាំងនោះ នឹង ត្រូវ បន្ថយ ទៅ ដោយ យល់ ដល់ ពួក រើស តាំង ម៉ាថា យ២៤២១២២ ។
តើ អាមេរិក នឹង ប្រើប្រាស់ មីស៊ីល ប្រភេទ ណា ?
ការចូល ជ្រៅ ទៅក្នុង ការស្រាវជ្រាវ ពិសោធន៍ គឺ ខ្ញុំ កំពុង ធ្វើ ការស្រាវជ្រាវ វិទ្យាសាស្ត្រ សម្រាប់ ពេល បច្ចុប្បន្ន ។
ត្រូវ ជំនួយការចុង ភៅ ចេះ កាន់ កាំបិត ហាន់ សាច់ ហាន់ បន្លែ
ពេល នោះ ខ្ញុំបាទ ក៏ យល់ព្រម ទទួលយក តាម ទំហំ ដី ជាក់ស្តែង ដែល មាន ។
