ខាងក្រោម នេះ ជា រូបភាព ដកស្រង់ ចេញ ពី រឿង ក្នុង ឆ្នាំ នីមួយ ដែល នាង បាន សម្តែង ៖
ចែក បៀ ត្រូវតែ ប្រើ ជ័រ លុប បាន ជឿជាក់ នៅ ទីនេះ មាន តាម តម្រូវការ
យើង បាន ប្រមូលផ្តុំ សាកសព មនុស្ស ដល់ ទៅ ៤០ នាក់ ក្នុង រយៈពេល ត្រឹមតែ ២ ម៉ោង ។
ជាមួយគ្នា នេះ លោក ចង់ឱ្យ អាជ្ញាធរ ខេត្ត យក អនុសាសន៍ របស់ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែនមក ដោះស្រាយ លើ ករណី នេះ ៕
ភាគ ច្រើន នៃ ករណី ថ្មី នេះ ត្រូវបាន រកឃើញ នៅក្នុង ទីក្រុង សេអ៊ូល ។
ចង់ រៀន បន្ត នៅ សកលវិទ្យាល័យ ?
គេ ដាក់ ខ្សែ នីមួយ ៗ
ម្នាល ភិក្ខុ ទាំងឡាយ បុគ្គល ៤ពួក នេះ ឯង រមែង មាន នៅក្នុង លោក ។
ពួកគេ បាន និយាយ ថា ក្រុមគ្រួសារ នៅ អូស្ត្រាលី កំពុង ត្រូវបាន ជូន ដំណឹង ពី ការស្លាប់ នេះ ហើយ ។
គេ ចង់តែ ឃើញ ទី សំគាល់ ដ៏ អស្ចារ្យ ប៉ុន្តែ ព្រះជា ម្ចាស់ មិន ប្រទាន ទី សំគាល់ ណា ផ្សេង ក្រៅពី ទី សំគាល់ របស់ ព្យាការី យ៉ូណា ស ឡើយ ។
នៅពេល រាងកាយ ស្គម ស្គាំង ពេក អ័រម៉ូន របស់ អ្នក ក៏ គ្មាន ស្ថិរភាព ដែរ ។
ប្រវត្តិសាស្ត្រ ពិភពលោក ហេតុ អ្វី បានជា ឥន្ទធ នូមាន រាង កោង ?
យុទ្ធសាស្ត្រ នេះ មិន អាច ប្រើប្រាស់ នៅ កម្ពុជា នា ពេល បច្ចុប្បន្ន បាន ឡើយ ។
ថា ហេតុ អ្វី គាត់ ធ្វើ បែប នោះ អាចនឹង ជួយ ស្វែងរក ដំណោះស្រាយ បាន ។
ពេល ដែល អ្នក ចាកចេញ ។
ដែល ជា គេហទំព័រ ព័ត៌មាន ប្រកាន់ខ្ជាប់គោលការណ៍ អព្យាក្រឹត
ក្នុង នាម ជា មេ គ្រួសារ មួយ រូប វា ពិបាក ណាស់ សម្រាប់ ខ្ញុំ ក្នុង ការរក្សា ទម្លាប់ នេះ ឱ្យ នៅតែ មាន ។
ហើយ មាន បាន ទូរស័ព្ទ ទាក់ទង ជាមួយ អ្នកស្រី ទ្រី ឈូន មេធាវី របស់ អ្នកនាង ស្រី មុំ ដែរ ឬ ទេ ?
ព្រះអង្គ នឹង ស្ថិត នៅក្នុង ចំណោម ពួកគេ ពួកគេ នឹង ទៅជា ប្រជារាស្ត្រ របស់ ព្រះអង្គ ហើយ ព្រះជាម្ចាស់ ផ្ទាល់ នឹង គង់ ជាមួយ ពួកគេ ។
ព្រះរាជ្យ របស់ ព្រះអង្គ នៅ ស្ថិតស្ថេរ អស់កល្ប ជានិច្ច
ខ្ញុំ នឹង បញ្ជូន ក្រុមការងារ ចុះបង្ក្រាប ។
ខ្ញុំ បាន រស់ នៅក្នុង ប្រទេស កម្ពុជា ប្រទេស វៀតណាម និង ប្រទេស ថៃ ខ្ញុំ ឃើញ ជា ខ្មែរ គឺ ល្ងង់ ជាង គេ បំផុត ។
បើ អ្នក ពិតជា ព្រះបុត្រា របស់ ព្រះជាម្ចាស់ មែន អញ្ជើញ ចុះ ពី ឈើ ឆ្កាង មក !
ប៉ុន្តែ សន្តិភាព មិន សំដៅ ត្រឹមតែ ការបញ្ចប់ សង្គ្រាម ស៊ីវិល ប៉ុណ្ណោះ ទេ ។
គិត តាំងពី ដើម ឆ្នាំ មកទល់ ពេលនេះ ប្រាក់ រូពី បាត់បង់ តម្លៃ អស់ ប្រមាណ ២០% ។
អាន ព្រះបន្ទូល របស់ ព្រះអង្គ ជារៀងរាល់ ថ្ងៃ ។
មកដល់ ពេលនេះ កម្មករ ជាច្រើន ធ្វើ កូដកម្ម តែ ហាក់ មាន ការ ភិតភ័យ ណាស់ ។
ប៉ុន្តែ ក្រោយ រយៈពេល ១០ឆ្នាំ ប្រតិបត្តិ នោះ ខ្លឹមសារ
ខ្ញុំ សូម បកស្រាយ នូវ ជំនាញ មួយ ៗ
នេះ គឺជា អ្វី ដែល អង្គការ សហ ប្រជាជាតិ បាន ព្រួយបារម្ភ ។
សូម ចូល មើល គេហទំព័រ របស់ យើង កម្មវិធី ទំព័រ ។
ហាម សួរ សំណួរ ទាំង នេះ ជាដាច់ខាត ទៅកាន់ អ្នក ដែល សម្ភាសន៍ ការងារ អ្នក
សម្តេច ស ខេង ប្រាប់ អាល្លឺម៉ង់ រឿង ក្រុម ប្រឆាំង បំផុស ចលនា បះបោរ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល
ប៉ុន្តែ តាមពិត មេធាវី រូប នោះ បាន លួច ទាក់ទង ប្រពន្ធ របស់ គាត់ ។
សម្រាប់ អង្គុយ គ្នា ពីរ ៗ
ធ្លាក់ខ្លួន ទៅជា ទាសី !
បន្តិច ទៀត មាន ប្រទេស ខ្លះ ផ្តល់ សញ្ញាប័ត្រ ថ្នាក់ អគ្គ បណ្ឌិត កិត្តិយស ខាង ជេរ អោយ សម្តេច ហើយ ។
ដើម្បី ទប់ ស្តាត់ ការផ្លាស់ប្តូរ បរិយាកាស ។
នេះ ជា វិធី ដែល អាជ្ញាធរ និង ប្រជាពលរដ្ឋ នៃ គ្រួសារ នីមួយ ៗ
គ្នា ខណៈ ភ្ញៀវ ទេសចរ ចិន នៅតែ កើនឡើង ។
ទាស់ តែ ទាំងអស់ នោះ សុទ្ធតែ ហេតុផល ប្រភព ឯកសារ បោក !
សេចក្តីប្រកាស នោះ មាន ន័យ ថា ឱ្យ រក្សា ស្ថានភាព ដដែល គឺ អ្នកណា នៅ ទីណា នៅ ទីនោះ សិន ។
ដើម្បីឱ្យ ឧយ្យោជន៍ កើត មាន ឡើង យើង អាច អនុវត្តន៍ តាម វិធី ខាងក្រោម ៖
លោកស្រី បាន និយាយ ថា វា ហាក់ដូចជា មិន មាន បញ្ហា ណាមួយ ទេ ។
ទំពក់ គ្មាន ទំពក់
ពិធី ជា កិត្តិយស បែប យោធា មួយ ត្រូវបាន រៀបចំ ធ្វើ ចូល
ប៉ុន្តែ យ៉ាងណា នាង មិន ទាន់ មាន គម្រោង រៀបការ នៅឡើយ ទេ ៕
ខូឡូ តូរ៉េ ចង់បាន កៅអី ឆែម ពាន លីក ត្រឡប់ មកវិញ
វិវឌ្ឍនាការ របស់ កូន តូច
ពុំ មាន របាយការណ៍ ស្តី អំពី អ្នកស្លាប់ របួស និង ការខូចខាត ដោយសារ បាតុភូត រញ្ជួយ ដី នេះ ទេ ។
នោះ ប្រាកដជា ស្គាល់ ហើយ ជាមួយនឹង រឿង រន្ធត់ ល្បី ៗ
ហើយ រយៈពេល ជាង មួយ ឆ្នាំ ក្រោយមក ម្តាយ របស់ គាត់ គឺ លោកយាយ អេដា Ada បាន សម្រេចចិត្ត រើ ចូលទៅ រស់ នៅក្នុង មណ្ឌល ជាមួយគ្នា ដើម្បី មើលថែ កូនប្រុស ច្បង របស់ គាត់ ម្នាក់ នេះ ។
ទោះ ចំណេញ ប្រាក់ រាប់ ម៉ឺន ដុល្លារ មាន មុខរបរ ពីរ ខ្ញុំ មិន ធ្វើ ដាច់ខាត
អាយុ គឺ ការកំណត់ នូវ វ័យ ឬ ថា ជា ព្រំដែន នៃ ការចម្រើន ធំធាត់ ។
បើសិន អ្នក ធ្លាប់ បាន ស្គាល់ ឬ មើល ការសម្តែង របាំ ព្រះរាជ ទ្រព្យ ក្នុង រឿង រាម កេរ្តិ៍ នោះ ប្រាកដ ណាស់ អ្នក នឹង នឹកឃើញ តួអង្គ ព្រះរាម ។
យើង ទាំង ២នាក់ ៕
រូបភាព២ ដែល បាន បង្ហោះ នៅលើ បណ្តាញ សង្គម នោះ មួយ បាន បង្ហាញ ខ្ទើយ ម្នាក់ ស្ថិត ក្នុង ស្ថានភាព ចោម ពុង សារ៉ុង និង មួយ ទៀត បង្ហាញ បុរស ម្នាក់ អង្គុយ នៅលើ ដី ខណៈ មនុស្ស ប្រុស មួយ ក្រុម ឈរ ព័ទ្ធ ជុំវិញ ដើម្បី រារាំង គាត់ មិន ឱ្យ រត់ ចេញ ។
ផ្លែ ឈើ ប្រភេទ នេះ ទើប ល្អ ទិញ សម្រាប់ គ្រួសារ ៕
អី ចីង ចាំ ខ្ញុំ ធ្ចើ ឱ្យ ល្បី ក្នុង ភូមិ តែម្តង ។
ឆ្អុង សម្រាប់ រយៈពេល ១០នាទី និង ជូត ផ្តិត ៗ
ស្ត្រី មាន ផ្ទៃពោះ ឬ ស្ត្រី ទើបតែ មាន ផ្ទៃពោះ ថ្មី ៗ
រំលឹក ពី អនុស្សាវរីយ៍ កាលពី ៤២ ឆ្នាំ មុន
បុរស ម្នាក់ ចងក សម្លាប់ ខ្លួន ដោយសារតែ ផឹក ស្រា
ចូរ ចងចាំ វិធី សាមញ្ញ ទាំងនេះ ហើយ អ្នក នឹង ទទួលបាន នូវ ប្រាក់ ចំណូល បន្ថែម ពី អ្នកជួល ជនជាតិ បរទេស ដោយ មិន លស់ ពេល ៕
វា ក៏ មាន ការគ្របដណ្តប់ វិស័យ សាធារណៈ ផងដែរ ។
របប តិច ជាង របប ហូប ប្រចាំ ថ្ងៃ ការងារ ច្រើន ។
ប្រជាជន នៅក្នុង សហគមន៍ ទាំងនេះ គឺជា ជនជាតិ វៀតណាម ពី កំណើត ឬ ពី ដូន តា របស់ ពួកគេ ប៉ុន្តែ ពួកគេ ភាគ ច្រើន បាន រស់ នៅក្នុង ប្រទេស កម្ពុជា ជាច្រើន ឆ្នាំ ឬ ច្រើន ជំនាន់ មក ហើយ ។
ខ្ញុំ សុំ លោកស្រី ថា យើង ត្រូវ ស្រឡាញ់ គ្នា ទៅ វិញ ទៅមក ។
បទ ចំរៀង របស់ ខ្ញុំ
ធ្វើអោយ ប្រព័ន្ធ ភាព សាំ មាន ភាពប្រសើរឡើង
ចង់បាន តូច រួច ធំ ជា មនុស្ស ល្ងង់ ។
ធាតុ ទាំងអស់ ត្រូវតែ មាន ការបិទ ស្លាក ថា
តើ រាង្គកាយ របស់ ខ្ញុំ ឆ្លើយតប ទៅនឹង ស្ត្រេស ដោយ របៀប ណា ?
ខ្ញុំ ទិញ បាន សៀវភៅ ទំនាយ គ្រប់ ឆ្នាំ នៅក្នុង ឆ្នាំ ជូត នេះ បើ មាន ពេល ចាំ សង្ខេប ៗ
ស្វែងរក ជាង ម៉ាស៊ីន ត្រជាក់ រថយន្ត …
ក្បួន ឃោសនា ចុងក្រោយ របស់ បក្ស ប្រឆាំង នៅ ថ្ងៃ នេះ មាន អ្នកគាំទ្រ រាប់ ម៉ឺន នាក់ ចូលរួម ។
លោកស្រី ហ្គ្រីធិហ្វែរ ម៉ូជួប ជាមួយ លោក ហោណាំ ហុង ។
វិ. អធិប្បាយ ថា អារម្មណ៍ ទាំងឡាយ ណា ដែល បុថុជ្ជន មាន ព្រោះ ហេតុ
ជនរងគ្រោះ ម្នាក់ កញ្ញា កែវ នា មានប្រសាសន៍ ថា ពួក នាង ពុំ មាន សាក្សី គឺ ដោយសារតែ អ្នក បាន ឃើញ ហេតុការណ៍ មាន ការភ័យខ្លាច ។
ប៉ុន្តែ ប្រសិនបើ អ្នក ព្យាយាម ធ្វើ ព្យាបាល ជាមួយ ឱសថ បុរាណ មួយ នេះ ជំងឺ នឹង ឆាប់ ជាសះស្បើយ ឡើងវិញ មិន ខាន ។
៤ អ្នកណា ពោល ថា ខ្ញុំ ស្គាល់ ព្រះអង្គ ហើយ តែ មិន កាន់ តាម បទបញ្ជា របស់ ព្រះអង្គ អ្នក នោះ និយាយ កុហក ហើយ សេចក្តីពិត មិន ស្ថិត នៅក្នុង ខ្លួន គេ ទេ ។
ខ្ញុំ សូម អរគុណ មេឃា ចំពោះ ការជួយ ជា យោបល់ ។
ខ្ញុំ មិន រិះគន់ ទេ តែ និយាយ ត្រង់ ៗ
ហេតុផល ដែល មនុស្ស ស្រី មិន ចាំបាច់ ប្រៀបធៀប សង្សារ ខ្លួន ទៅនឹង សង្សារ អ្នក ផ្សេង
គាត់ រំភើប ត្រេកអរ ណាស់ រាល់ ៗ
បន្ទាប់ពី នោះ មក លោក បាន ចំណាយ ពេល សឹងតែ ទាំងស្រុង ប្រមាណ ជា ៤០ ឆ្នាំ នៃ ជីវិត លោក ដើម្បី បម្រើការ នៅក្នុង អង្គការ សហ ប្រជាជាតិ ។
ទេសចរណ៍ អាកាសចរណ៍ រួម ប្រាស្រ័យ ប្រជាជន យុវវ័យ វប៌្បធម ពុទ្ធសាសនា ។
គ្នា នូវ ក្មេងស្រី ម្នាក់ មាន មុខមាត់ ស្អាត បាត ដូច ក្មេងស្រី ដទៃ ៗ
វប៌្បធម សកល គឺ វប៌្បធម ដែល យក ច្បាប់ ជា ធំ
យាយ រឿង បន្ថែម ទៀត ថា ខ្ញុំ មាន ភាពអៀនខ្មាស ក្នុង ការធ្វើជា អ្នក រាំ របាំ ។
ហើយ ប្រទេស ជប៉ុន គួរតែ ធ្វើ ដូចគ្នា នេះ ដែរ ។
៦បន្ទាប់មក ខ្ញុំ ឃើញ កូន ចៀម មួយ ឈរ នៅ ចំ កណ្តាល បល្ល័ង្ក នៅ កណ្តាល សត្វ មាន ជីវិត ទាំង បួន និង នៅ កណ្តាល ពួក ព្រឹទ្ធាចារ្យ ។
៦ប៉ុន្តែ ខ្ញុំ ចង់អោយ អ្នក រាល់គ្នា ដឹង ថា បុត្រ មនុស្ស មាន អំណាច អត់ទោស អោយ មនុស្ស នៅក្នុង លោក នេះ បាន រួច ពី បាប ។
ខ្ញុំ បាន ទៅ ពិនិត្យមើល មុខរបួស របស់ លោកយាយ សប្តាហ៍ ចំនួន ២ដង ។
ប្រសិនបើ បងប្អូន ទៅ រៀបការ ជាមួយ អ្នក មិន ជឿ នោះ ពិតប្រាកដ ណាស់ បងប្អូន មិន បាន រក អ្វី ដែល ពិសេស នៅក្នុង របៀប របស់ ព្រះជាម្ចាស់ ទេ តែ បងប្អូន បែរជា ទៅ សម្លឹង រក អ្វី ផ្សេង ទៀត ដែល ខ្លួន គិត ថា ពិសេស នៅក្នុង ដៃគូ អនាគត ជាជាង ព្រះជាម្ចាស់ ។
តែ ប៉ុណ្ណោះ ហើយ វា អាចនឹង អស់ ប្រសិទ្ធភាព ទាំងស្រុង នៅ ថ្ងៃ ណាមួយ ។
ទៀត ដែល ទាន់ ហេតុការណ៍ ដែល ប្រជាពលរដ្ឋ ចង់ ដឹង ។
ការ ដែល មាន ទម្លាប់ អង្គុយ ជាប់ រាល់ ថ្ងៃ ត្រូវបាន គេ រកឃើញ ថា មាន ទំនាក់ទំនង នឹង បញ្ហា សុខភាព ជាច្រើន ប្រភេទ ។
ពេល គេ បាន ទទួល លិខិត និង រាជ ក្រឹត្យ ហើយ ជនជាតិ យូដា នាំគ្នា កាន់ទុក្ខ យ៉ាង ខ្លាំង ។
៨ខ្ញុំ បាន ធ្វើ ពិធី ជ្រមុជ អោយ អ្នក រាល់គ្នា ក្នុង ទឹក រីឯ លោក វិញ លោក នឹង ធ្វើ ពិធី ជ្រមុជ អោយ អ្នក រាល់គ្នា ក្នុង ព្រះវិញ្ញាណ ដ៏ វិសុទ្ធ ។
អ្នក ត្រូវតែ ការពារ ដៃ របស់ អ្នក ពី ពន្លឺ ព្រះអាទិត្យ ដែល បណ្តាលឱ្យ ដៃ របស់ អ្នក ចាស់ ជាង វ័យ ។
ក៏ប៉ុន្តែ មនុស្ស គ្មាន ហេតុ អរសប្បាយ ឡើយ ។
ណិត អាន ដូច ចិត
ហើយ លោក អ្នក នឹង បញ្ឈប់ ការអធិស្ឋាន នៅ ពេលណា ដែរ ?
ប៉ូលិស បង្រាប ចាប់ បាន ចោរប្លន់ ២នាក់ ភ្លាម ៗ
កាន់តែ ធ្វើ កាន់តែ សប្បាយ ចិត្ត កាន់តែ ចង់ ធ្វើ បន្ថែម ទៀត ។
ដូច យើង បាន ធ្វើ រួច មកហើយ
លើក នេះ នឹង ក្លាយជា លើក ទី២ហើយ
វា ក៏ ជា គ្រាប់ ពេជ្រ ធម្មជាតិ ដ៏ ជាង គេ ផងដែរ ដែល ត្រូវបាន រកឃើញ នៅក្នុង ប្រទេស អង់ហ្គោឡា ។
វា ត្រូវបាន ហៅ ថា អារក្ស ហើយ សាតាំង ផងដែល បាន នាំ លោកីយ៍ ទាំងមូល ឱ្យ វង្វេង ចេញ វិវិរណៈ ១២៩ ។
ប៉ុន្តែ អ្នកស្រី ថា ស្បៀង ទាំងនេះ មិន គ្រប់គ្រាន់ នោះ ទេ ។
តើ មាន វិធីសាស្ត្រ អ្វី ខ្លះ ដើម្បីឱ្យ ស្ត្រី អាច រួចផុត ពី ជំងឺ កាច សាហាវ មួយ នេះ បាន ?
ដូច្នេះ ខ្ញុំ បាន និយាយ ជាមួយ ប្រធានាធិបតី កាលពី យប់ មិញ បន្ទាប់ពី បាន ពិភាក្សា ជាមួយ ក្រុម សន្តិសុខ ជាតិ ដែល នៅសល់ ហើយ គាត់ បាន បញ្ជា ឱ្យ យើង ចាប់ផ្តើម ដក កងកម្លាំង ដោយ ចេតនា ពី ភាគ ខាងជើង ប្រទេស ស៊ីរី ។
ដូច្នេះ ដើម្បី ធ្វើ ខ្លួន ឱ្យ ក្លាយជា នារី ដ៏ មាន …
ប៉ុន្តែ តំណាង អយ្យការ នៅ មិន ទាន់ សម្រេច យ៉ាងណា ចំពោះ ជោគវាសនា របស់ សកម្មជន អតីត បក្ស ប្រឆាំង ទាំងនោះ នៅឡើយ ។
ដូច ក្នុង ករណី ភ្លាម ៗ
វិធី បំបាត់ ក្លិន ខ្លួន តាមរយៈ ការទទួលទាន អាហារ
ទោះ ខ្ញុំ ចេះ ដើរ ក្រឡា អុក តាម ទំនើងចិត្ត របស់ ខ្លួន ក្តី ក៏ យុទ្ធសាស្ត្រ របស់ ខ្ញុំ សុទ្ធតែ មិន សូវ មាន ប្រសិទ្ធិភាព ។
ប៉ុន្តែ នេះ ក្រសួង មាន សិទ្ធិ អំណាច រឹបអូស យក តែម្តង ។
ក្រុម អ្នក បណ្តាក់ទុន និង មន្ត្រី អឺរ៉ុប ក៏ ព្រួយបារម្ភ ដែរ ថា កិច្ចចរចា អំពី ការជួយ ស្រោចស្រង់ ហិរញ្ញវត្ថុ ដល់ ប្រទេស ក្រិក អាច មាន ការពិបាក ដោះស្រាយ ក្នុង ពេល ប៉ុន្មាន ខែ ខាងមុខ នេះ ។
