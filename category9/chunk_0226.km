( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង លោកជំទាវ ម៉ៅ ចំណាន ព្រមទាំង បុត្រា បុត្រី បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
ឯកឧត្តម ថោង ខុន ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្តម ថោង ខុន រដ្ឋមន្រ្តី ក្រសួង ទេសចរណ៍ និង លោកជំទាវ ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្ដ្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ នៃ ក្រសួង ទេសចរណ៍ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
កម្មករ ៣០០ នាក់ បម្រើការ ឱ្យ គម្រោង អភិវឌ្ឍន៍ អចលន ទ្រព្យ ដ៏ ធំ របស់ កូរ៉េ លើក គ្នា តវ៉ា ដោយសារ ថៅកែ មិន បើក ប្រាក់ខែ
តំណាង កម្មករ រូប នេះ បាន បន្ត ទៀត ថា ប្រាក់ខែ ដែល ក្រុមហ៊ុន នេះ មិន ទាន់ បើក ឱ្យ ពួកគេ គឺ ចាប់ពី ខែមិថុនា ខែកក្កដា និង ខែសីហា នេះ ក៏ ពួកគេ មិន ដឹង ទទួលបាន ឬ យ៉ាងណា នៅឡើយ ។
( ភ្នំពេញ ) ៖ ឯកឧត្ដម អូ ស្មា ន ហាស្សាន់ ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង លោកជំទាវ ព្រមទាំង សហការី បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ចំពោះ មរណភាព មហាវិរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង
( ភ្នំពេញ ) ៖ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា នៅ ព្រឹក ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន ឯកឧត្តម ស៊ុន ចាន់ថុល ទេសរដ្ឋមន្តី រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហាវិរិយា ភិរក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាស នូបមត្ថម្ភក៍ ខេរ៉ូ ស៊ុន ស្រេង ត្រូវ ជា ឪពុក បង្កើត ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ និង ភរិយា មាន សេចក្តីសោកស្តាយ យ៉ាង ក្រៃលែង ជា ទីបំផុត ដោយ ទទួល ដំណឹង អំពី មរណភាព របស់ មហាវិរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ត្រូវ ជា ឪពុក របស់ ឯកឧត្តម និង លោកជំទាវ ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃអាទិត្យ ៩រោច ខែ ស្រា ពណ៍ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស .២៥៦៦ ត្រូវនឹង ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២២ ក្នុង ជន្មាយុ ៩៦ ឆ្នាំ ដោយ ជរា ពាធ » ។
សម្តេច បាន បន្ដ ទៀត ថា « ខ្ញុំ សូម ចូលរួម សម្តែង នូវ សមាន ទុក្ខ ដ៏ សែន ក្រៀមក្រំ និង សោកស្តាយ ជា ទីបំផុត ជាមួយ ឯកឧត្តម និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ នៃ សព ដែល បាន បាត់បង់ ឪពុក ជីតា និង ជីតា ទួត ប្រកបដោយ ព្រហ្ម វិហាធម៌ ជាទីគោរព ស្រឡាញ់ បំផុត » ។
ជាថ្មី ម្ដង ទៀត សម្តេច បាន បន្ថែម ថា « ខ្ញុំ និង ភរិយា សូម បួងសួង ឲ្យ វិញ្ញាណក្ខន្ធ មហាវិរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង បាន ទៅ សោយ សុខ ក្នុង ឋាន សុគតិភព ជានិច្ច និរន្តរ៍ កុំបី ឃ្លៀងឃ្លាត ឡើយ »៕
ឯកឧត្ដម ម៉ម ប៊ុន ហេង ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល និង លោកជំទាវ ព្រមទាំង មន្ត្រី ក្រោម ឱវាទ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
សម្តេច តេជោ ហ៊ុន សែន អនុញ្ញាតឱ្យ ប្រធាន មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ
សូម បញ្ជាក់ ថា លោក អាប់ ឌូឡា សាហ៉ី ដ បាន អញ្ជើញ បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា កាលពី ថ្ងៃទី ២១ ខែសីហា ។ ក្រសួង ការបរទេស កម្ពុជា បាន ឱ្យដឹង ថា ក្នុង ដំណើរទស្សនកិច្ច នៅ កម្ពុជា លោក អាប់ ឌូឡា សាហ៉ី ដ ក៏ នឹង អញ្ជើញ ជួប សម្តែង ការគួរសម ជាមួយ សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ហើយក៏ នឹង មាន ជំនួប ពិភាក្សា ការងារ ជាមួយ លោក អ៊ុច បូរ រិទ្ធ រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ផងដែរ ។
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ មេបញ្ជាការ កងពល តូច លេខ ៧០ និង មេបញ្ជាការង នាយ ទាហាន នាយ ទាហាន រង ព្រមទាំង ពល ទាហាន ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
អាជ្ញាធរ ស្រុក ជលគិរី ជួសជុល ផ្លូវ លំ ជាង ១០គីឡូ ម៉ត្រ តាម មាត់ ទន្លេ ដើម្បី សម្រួល ចរាចរណ៍ ជូន ពលរដ្ឋ
( កំពង់ឆ្នាំង ) ៖ អាជ្ញាធរ ស្រុក ជលគិរី ខេត្ត កំពង់ឆ្នាំង បាន និង កំពុង ជួសជុល ផ្លូវ លំ ប្រវែង ១០គីឡូម៉ែត្រ ស្រប តាម ដងទន្លេ ដើម្បី សម្រួល ដល់ ការធ្វើចរាចរណ៍ ទៅ មក របស់ ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ ជល សារ និង ឃុំ ពាម ឆ្កោក ក្នុង ស្រុក ជលគិរី ។
លោក ដូវ គឹម ស៉ីន អភិបាល ស្រុក ជលគិរី នា ព្រឹក ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន ឱ្យដឹង ថា ការជួសជុល ផ្លូវ លំ មួយ ខ្សែ នេះ ក្នុង គោលបំណង ដើម្បី ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ ជល សារ និង ឃុំ ពាម ឆ្កោក ធ្វើចរាចរណ៍ ទៅ មក និង ដឹកជញ្ជូន កសិផល ស្រែ ប្រាំង និង ដំណាំ កសិកម្ម ទៅកាន់ ទីផ្សារ ក្នុង ខេត្ត កំពង់ចាម ផងដែរ ។
លោក អភិបាល ស្រុក ជលគិរី ឱ្យដឹង ទៀត ថា ផ្លូវ នេះ ត្រូវបាន ធ្វើ ការជួសជុល ដែល មាន ប្រវែង ជាង ១០គីឡូម៉ែត្រ ទទឹង ៥ម៉ែត្រ ចេញ ពី ភូមិ ព្រៃ គ្រី ជើង ទៅដល់ មុខ សាលា ឃុំ ពាម ឆ្កោក ស្រុក ជលគិរី ដោយ ប្រើប្រាស់ ថវិកា មូលនិធិ របស់ រដ្ឋបាល ស្រុក ជលគិរី ឆ្នាំ ២០២២ ថវិកា របស់ ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ ជួយ មូលដ្ឋាន ស្រុក ជលគិរី និង ថវិកា របស់ សប្បុរស ជន មួយចំនួន ផងដែរ ។
លោក អភិបាល ស្រុក បាន បញ្ជាក់ ទៀត ថា នៅក្នុង ស្រុក ជលគិរី មាន ឃុំ ២ គឺ ឃុំ ជល សារ និង ឃុំ ពាម ឆ្កោក ដែល ផ្លូវ លំ មាន ការខូចខាត ខ្លាំង លំបាក ក្នុង ការធ្វើដំណើរ ដោយ ផ្លូវ ទាំង ២ខ្សែ នេះ បាន លិច ទឹក ទន្លេ៦ ខែ និង គោក ៦ខែ ហើយ ផ្លូវ មួយ ខ្សែ នេះ ដែរ អាចនឹង ជួល ជុល រួចរាល់ ក្នុង រយៈពេល ១៥ ថ្ងៃ ខាងមុខ នេះ ៕ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង ភរិយា ព្រមទាំង ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន និង មន្ត្រីរាជការ ក្រោម ឱវាទ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
តាមរយៈ សារ ចូលរួម រំលែក មរណទុក្ខ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន បង្ហាញ អារម្មណ៍ ក្តុកក្តួល យ៉ាង ដូច្នេះ ថា៖ « ខ្ញុំ និង ភរិយា មាន ក្តី រំជួល ចិត្ត ឥត ឧបមាដោយ បាន ទទួល ដំណឹង ដ៏ ក្រៀមក្រំ ថា មហា វីរិយា ភិរក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ត្រូវ ជា ឪពុក បង្កើត របស់ ឯកឧត្តម បាន ទទួលមរណភាព កាលពី ថ្ងៃអាទិត្យ ៩ រោច ខែ ស្រា ពណ៍ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស .២៥៦៦ ត្រូវនឹង ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២២ វេលា ម៉ោង ១៨:០០ នាទី ក្នុង ជន្មាយុ ៩៦ ឆ្នាំ ដោយ ជរា ពាធ ។
ខ្ញុំ និង ភរិយា សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ សព មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន សង សូម ឆាប់ បាន ចាប់កំណើត កើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។ សូម ឯកឧត្តម ទេសរដ្ឋមន្ត្រី និង លោកជំទាវ ទទួល នូវ ការ រាប់អាន ដ៏ ជ្រាលជ្រៅ ពី ខ្ញុំ »៕
ទឹក ជន់ លិច ផ្ទះសម្បែង ដំណាំ និង ផ្លូវ មួយចំនួន តាម ក្រវាត់ ព្រំដែន នៅ ខេត្ត ឧត្តរមានជ័យ ដោយសារ ភ្លៀង ធ្លាក់ ជាប់ ៗ គ្នា ប៉ុន្មាន ថ្ងៃ
( ឧត្តរមានជ័យ )៖ បញ្ហា អាកាសធាតុ ភ្លៀង ធ្លាក់ ជាប់ ៗ គ្នា ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ នេះ បាន បណ្តាលឱ្យ តំបន់ មួយចំនួន ក្នុង ខេត្ត ឧត្តរមានជ័យ រង ការប៉ះពាល់ ដូចជា លិច លង់ ផ្ទះសម្បែង សត្វ ចិញ្ចឹម ដំណាំ ផ្សេង ៗ របស់ ប្រជាពលរដ្ឋ មួយចំនួន ដែល រស់ នៅ តាម ព្រំដែន ក៏ ដូចជា ខូចខាត ផ្លូវ មួយចំនួន តាម ក្រវាត់ ព្រំដែន ជាដើម ។
បើ តាម របាយកាណ៍ របស់ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២២ នេះ ឃុំ ព្រះប្រឡាយ ក្នុង ស្រុក ត្រពាំងប្រាសាទ មាន ទឹក ជំនន់ លិច ផ្ទះ ប្រជាពលរដ្ឋ ២គ្រួសារ គឺ នៅ ភូមិ ត្រពាំង បី ឃុំ ព្រះប្រឡាយ ខូច ផ្លូវ ក្រវាត់ ព្រំដែន ប្រវែង ១៥០ ម៉ែត្រ សត្វ ចិញ្ចឹម មាន់ ទា៨០ ក្បាល និង ខូចខាត ផ្លូវ មូលនិធិ ឃុំ មួយចំនួន ដូចជា ភូមិ ប្រាសាទ ក្រហម សែន ជ័យ ដែល ទឹក ហូរ ច្រោះ ដី មាត់ លូ និង បាក់លូ១ កន្លែង ហើយ ភូមិ ត្រាំ ប៉ោង ស្រុត ដី លើ លូ ចំនួន ១កន្លែង ។
ដោយឡែក ចំពោះ ឃុំ អូរ ស្វាយ និង ឃុំ ផ្អាវ ស្ថិត ក្នុង ស្រុក ត្រពាំងប្រាសាទ ត្រូវ ទឹក ជន់ លិច ផ្លូវ យុទ្ធសាស្ត្រ ដោយ កន្លែង និង លិច ផ្លូវ នៅ ចំណុច អូរ បី ជាន់ ប្រហែល១៥០ ម៉ែត្រ ។ រីឯ ឃុំ បាក់ អន្លូង ភ្លៀង ជន់ លិច ផ្លូវ មូនិធិ ឃុំ នៅ ភូមិ ទួល ប្រសើរ និង ភូម សុខ សិរី ។
ឯកឧត្តម កិត្តិ សេដ្ឋា បណ្ឌិត ជា ម យៀប ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្តម កិត្តិ សេដ្ឋា បណ្ឌិត ជា ម យៀប អនុប្រធាន ទី១ រដ្ឋសភា បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៣៣ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ២១ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៣៣ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២២ ខែសីហា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៣៣ នាក់ នោះ មាន ១៣នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ០៥ ករណី និង ជនសង្ស័យ ២០ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១១ករណី ។
ជាមួយគ្នា នេះ លោក បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ អនុវត្ត នូវ ពាក្យស្លោក « ៣កុំ ១រាយការណ៍ » ដែល មាន ន័យ ថា « កុំ ពាក់ព័ន្ធ កុំ អន្តរាគមន៍ កុំ លើកលែង ក្នុង បទល្មើស នានា និង ជួយ រាយការណ៍ ពី បទល្មើស គ្រឿងញៀន និង បទល្មើស ផ្សេង ៗ ទៀត » ដែល កើតមាន នៅ មូលដ្ឋាន របស់ ខ្លួន ជូន ដល់ សមត្ថកិច្ច ៕កងទ័ព កងពល តូច អន្តរាគមន៍ លេខ ៧ ចុះ អន្តរាគមន៍ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ដែល ផ្ទះ ជន លិច ដោយ ជំនន់ ទឹកភ្លៀង តាម បន្ទាត់ ព្រំដែន ភ្នំ ដង រ៉ែ ក
( ព្រះវិហារ ) ៖ ភ្លៀង ធ្លាក់ ជាប់ ៗ គ្នា ប៉ុន្មាន ថ្ងៃ នេះ បាន ធ្វើឱ្យ ផ្ទះ ប្រជាពលរដ្ឋ មួយចំនួន ដែល រស់ នៅ តាម ព្រំដែន ជើង ភ្នំ ដង រ៉ែក ក្នុង ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ រង ការលិចលង់ ។ នៅ ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២២ នេះ ដែរ កងទ័ព ក្នុង អង្គភាព កងពល តូច អន្តរាគមន៍ លេខ ៧ ចំណុះ កងពល ធំ អន្តរាគមន៍ លេខ ៣ជិត ១០០ នាក់ ភ្ជាប់ ជាមួយ សម្ភារ សង្គ្រោះ ជាច្រើន ប្រភេទ បាន ចុះ ជួយ ប្រជាពលរដ្ឋ ដែល ផ្ទះ របស់ គាត់ រង ការលិចលង់ ដោយ ទឹក ជំនន់ ។
ក្រោម ការណែនាំ និង ចង្អុលបង្ហាញ ពីសំណាក់ លោក ឧត្តមសេនីយ៍ ទោ ដួង សំនៀង មេបញ្ជាការ កងពល តូច អន្តរាគមន៍ លេខ ៧ លោក វរសេនីយ៍ ទោ កើត នឿន នាយ សេនាធិការ រង កងពល តូច អន្តរាគមន៍ លេខ ៧ ដឹកនាំ កម្លាំង ចំម្រុះ ចំនួន ៨៦ នាក់ ចុះ ជួយ អន្តរាគមន៍ សម្រួល ផ្លូវ មធ្យោបាយ សម្ភារ ដឹក សហការ ជាជាមួយ អាជ្ញាធរ មូលដ្ឋាន ចុះ ជួយ ប្រជាពលរដ្ឋ នៅ ភូមិ សែន ជ័យ និង ភូមិ បុស្ស ស្បូវ ស្ថិត ក្នុង ភូមិសាស្រ្ត ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ នៅ តាម បន្ទាត់ ព្រំដែន ដែល កំពុង រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ និង នាយ ទាហាន នាយ ទាហាន រង ព្រមទាំង ពល ទាហាន ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
នាយ ឧត្តមសេនីយ៍ ឃឹម ប៊ុន សុង ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឃឹម ប៊ុន សុង រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង លោកជំទាវ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
ប្រវត្តិសាស្រ្ត ថ្មី ! កម្ពុជា នឹង ធ្វើ ម្ចាស់ ផ្ទះ កម្មវិធី ប្រកួត រ៉ូបូត អន្តរជាតិ ធំ បំផុត នៅ អាស៊ី នា ឆ្នាំ ២០២៣ !
នេះ ជា មោទនភាព និង កិត្តិយស ដែល ទូរទស្សន៍ ជាតិ កម្ពុជា នៃ ក្រសួង ព័ត៌មាន ទទួលបាន ការអនុញ្ញា ដ៏ ខ្ពង់ខ្ពស់ ពី រាជ រដ្ឋាភិបាល កម្ពុជា និង ទទួលបាន សិទ្ធិ ពី ABU ក្នុង ការរៀបចំ ការប្រកួត រ៉ូបូត ដ៏ ធំ សម្រាប់ និស្សិត ក្នុង តំបន់ អាស៊ី ប៉ាស៊ីភិក ជា លើក ទី១ ជា ប្រវត្តិសាស្រ្ត នា ឆ្នាំ ២០២៣ នៅ រាជធានី ភ្នំពេញ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន ឯកឧត្តម ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ ឯកឧត្តម ទេសរដ្ឋមន្ដ្រី ។
អ្នក ឧកញ៉ា ទ្រី ភាព និង អ្នក ឧកញ៉ា គៀន ស្រី នាង ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា ទ្រី ភាព អគ្គ នាយក ក្រុមហ៊ុន ទ្រី ភាព គ្រុប និង ភរិយា លោកជំទាវ អ្នក ឧកញ៉ា គៀន ស្រី នាង ព្រមទាំង បុគ្គលិក ក្រោម ឱវាទ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន ឯកឧត្តម ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ ឯកឧត្តម ទេសរដ្ឋមន្ដ្រី ។
ឯកឧត្តម អ៉ិត សំហេង ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្តម អ៉ិត សំហេង រដ្ឋមន្រ្តី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
ឯកឧត្ដម លឹម គាន ហោ ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្ដម លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម និង លោកជំទាវ ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ក្រោម ឱវាទ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
ប្រទេស អឺរ៉ុប ជាច្រើន សម្តែង ការព្រួយបារម្ភ យ៉ាង ខ្លាំង ចំពោះ ការវាយឆ្មក់ របស់ អ៊ីស្រាអែល លើ អង្គការ ក្រៅ រដ្ឋាភិបាល ប៉ាឡេ ស្ទីន
ក្រសួង ការបរទេស នៃ ប្រទេស ចំនួន ៩ បាន និយាយ ថា « យើង មាន ការព្រួយបារម្ភ យ៉ាង ខ្លាំង ចំពោះ ការវាយឆ្មក់ ដែល បាន ធ្វើឡើង កាលពី ព្រឹក ថ្ងៃទី ១៨ ខែសីហា ជា ផ្នែក នៃ ការថយចុះ គួរឱ្យ ព្រួយបារម្ភ នៃ លំហ សង្គម ស៊ីវិល នៅក្នុង តំបន់ » ។
ប្រទេស បែលហ្ស៊ិក ដាណឺម៉ាក បារាំង អាល្លឺម៉ង់ អៀរឡង់ អ៊ីតាលី ហូឡង់ អេស្ប៉ាញ និង ស៊ុយអែត បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា « សកម្មភាព ទាំងនេះ មិន អាច ទទួលយក បាន ទេ » ។
កាលពី ខែតុលា ក្រុម ប៉ាឡេ ស្ទីន ចំនួន ប្រាំមួយ ត្រូវបាន អ៊ីស្រាអែល កំណត់ ថា ជា ក្រុម ភេរវករ ជាមួយ ការចោទប្រកាន់ ថា ពួកគេ មាន ទំនាក់ទំនង នឹង ក្រុម សកម្ម ប្រយុទ្ធ ឆ្វេង និយម PFLP ទោះបីជា មន្ត្រី អ៊ីស្រាអែល មិន បាន ចែករំលែក ជាសាធារណៈ នូវ ភស្តុតាង នៃ ទំនាក់ទំនង បែប នេះ ក៏ដោយ ។
លោកស្រី ហុង សុធនធានី ផ្ញើ សារ អបអរសាទរ ឯកឧត្ដម មាស ប៊ុន ឡី ដែល ត្រូវបាន តែងតាំង ជា ជំនួយការ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា
( ភ្នំពេញ ) ៖ ឯកឧត្ដម មាស ប៊ុន ឡី ត្រូវបាន គណៈអចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ កណ្ដាល ចេញ សេចក្ដីសម្រេច តែងតាំង ជា ជំនួយការ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។
សម្ដេច វិបុល សេនា ភក្តី សាយ ឈុំ ផ្ញើ សារលិខិត រំលែក ទុក្ខ ចំពោះ មរណភាព មហាវិរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាស នូបមត្ថម្ភក៍ ខេរ៉ូ ស៊ុន ស្រេង
( ភ្នំពេញ ) ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រមុខរដ្ឋ ស្តីទី នៅ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហាវិរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាស នូបមត្ថម្ភក៍ ខេរ៉ូ ស៊ុន ស្រេង ត្រូវ ជា ឪពុក បង្កើត ។
សម្ដេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ និង ភរិយា មាន សេចក្តីក្រៀមក្រំ យ៉ាង ខ្លាំង ដោយ បាន ទទួល ដំណឹង ថា មហាវិរិយា ភិរក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាស នូបមត្ថម្ភក៍ ខេរ៉ូ ស៊ុន ស្រេង ត្រូវ ជា ឪពុក បង្កើត របស់ ឯកឧត្តម ទេសរដ្ឋមន្តី បាន ទទួលមរណភាព នៅ ថ្ងៃអាទិត្យ ៩រោច ខែ ស្រា ពណ៍ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស .២៥៦៦ ត្រូវនឹង ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២២ វេលា ម៉ោង ១៨៖០០ ល្ងាច ក្នុង ជន្មាយុ ៩៦ ឆ្នាំ ដោយ ជរា ពាធ » ។
ជាថ្មី ម្ដង ទៀត សម្តេច បាន បន្ថែម ថា « សូម វត្ថុ ស័ក្ដិសិទ្ធិ ក្នុង លោក និង តេជៈ បារមី នៃ ព្រះពុទ្ធ ព្រះធម៌ ព្រះសង្ឃ តាម ជួយ បីបាច់ ថែរក្សា ដល់ ដួង វិញ្ញាណក្ខន្ធ មហាវិរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាស នូបមត្ថម្ភក៍ ខេរ៉ូ ស៊ុន ស្រេង បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ »៕ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន អញ្ជើញ ចុះ សាកសួរ នាយ ទាហាន បញ្ជាការដ្ឋាន អង្គរក្ស ដែល កំពុង ឈរជើង សម្អាត ដី ដើម្បី ដាំ កូន ឈើ នៅ តំបន់ ភ្នំ តាម៉ៅ
ឯកឧត្ដម វេង សាខុន ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្ដម វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង លោកជំទាវ ព្រមទាំង មន្ត្រីរាជការ ក្រោម ឱវាទ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ ចេញផ្សាយ កាលពី ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ នេះ សេតវិមាន បាន គូសបញ្ជាក់ ទៀត ថា មេដឹកនាំ នៃ ប្រទេស ទាំង៤ បាន ពិភាក្សា គ្នា ពី កិច្ចចរចា ដែល កំពុង ប្រព្រឹត្តទៅ ពាក់ព័ន្ធ នឹង កម្មវិធី នុយក្លេអ៊ែរ អ៉ី រ៉ង់ និង ភាពចាំបាច់ នៃ ការពង្រឹង ការគាំទ្រ ដល់ បណ្ដា ប្រទេសជា ដៃគូ នៅក្នុង តំបន់ មជ្ឈិមបូព៌ា ព្រមទាំង កិច្ច ខិតខំ ប្រឹងប្រែង កំញើញ និង ទប់ស្កាត់ សកម្មភាព បង្ក អស្ថិរភាព របស់ អ៉ីរ៉ង់ នៅក្នុង តំបន់ ។
សេតវិមាន មិន បាន បញ្ជាក់ លម្អិត អ្វី បន្ថែម លើស ពី នេះ នោះ ទេ ជុំវិញ កិច្ចពិភាក្សា លើ កិច្ចការ តំបន់ មជ្ឈិមបូព៌ា រវាង ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន នាយក រដ្ឋមន្ត្រី អង់គ្លេស លោក បូរី ស ចន សុន ប្រធានាធិបតី បារាំង លោក អេម៉ានុយ អែល ម៉ាក្រុង និង អធិការបតី អាល្លឺម៉ង់ លោក អូឡាហ្វ សូលស៍ នោះ ឡើយ ។
ប៉ុន្តែ មាន ការព្រួយបារម្ភ ថា បរាជ័យ ក្នុង ការស្ដារ កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ អ៉ី រ៉ង់ ឆ្នាំ ២០១៥ ឡើងវិញ អាចនឹង បង្កើន ហានិភ័យ នៃ ការផ្ទុះ សង្រ្គាម នៅក្នុង តំបន់ នៅក្នុង បរិបទ ដែល អ៉ី ស្រាអែល បាន ព្រមាន ថា អាចនឹង ធ្វើ សកម្មភាព យោធា ប្រឆាំង អ៉ីរ៉ង់ ប្រសិនជា មធ្យោបាយ ការទូត មិន អាច រារាំង អ៉ីរ៉ង់ ពី ការអភិវឌ្ឍ ឬ ផលិត អាវុធ នុយក្លេអ៊ែរ បាន ទេ នោះ ៕
អាជ្ញាធរ ក្រុង ប៉ោយប៉ែត នាំ គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា ចែកជូន គ្រួសារ ក្រីក្រ ៥០ គ្រួសារ នៅ សង្កាត់ ប៉ោយប៉ែត
( បន្ទាយមានជ័យ )៖ លោក គាត ហ៊ុល អភិបាល ក្រុង ប៉ោយប៉ែត និង លោក ភោគ លន ចៅសង្កាត់ ប៉ោយប៉ែត បាន នាំយក គ្រឿង ឧបភោគ បរិភោគ និង ថវិការ ចែកជូន ដល់ គ្រួសារ ក្រីក្រ ចំនួន ៤ភូមិ ស្មើនឹង ៥០ គ្រួសារ ព្រមទាំង កម្លាំង អភិវឌ្ឍន៍ សង្កាត់ ប៉ោយប៉ែត ។
ការចែក អំណោយ នេះ ធ្វើឡើង នា ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២២ ស្ថិត នៅ ភូមិបាលិលេយ្យ២ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្ដម នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ឧប នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង លោកជំទាវ ព្រមទាំង មន្រ្តី ក្រោម ឱវាទ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហា វីរិយាភិរ័ត្ន សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង សូម ឆាប់ បាន ចាប់កំណើត កើត ក្នុង សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ បណ្ឌិត ហ៊ុន ម៉ាណែត៖ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្ដេច តេជោ ជា យន្តការបើក ច្រក ដោយ គ្មាន ការរើសអើង ដើម្បី ធ្វើ សកម្មភាព មនុស្សធម៌ ទូទាំង ប្រទេស
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ប្រធាន ក្រុមប្រឹក្សាភិបាល សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្ដេច តេជោ (TYDA) បាន គូសបញ្ជាក់ ថា សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្ដេច តេជោ (TYDA) គឺជា យន្តការបើក ច្រក និង ផ្ដល់ ឱកាស ឱ្យ សមាជិក - សមាជិកា ចូលរួម ដោយ គ្មាន ការរើសអើង ដើម្បី ចូលរួម ធ្វើ សកម្មភាព មនុស្សធម៌ នៅ ទូទាំង ប្រទេស ក្រោម ការសហការ ជាមួយ ដៃគូ សហការ ផ្សេង ៗ យ៉ាង ទូលំទូលាយ ។
ការគូសបញ្ជាក់ បែប នេះ របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង ក្នុង ពិធី បញ្ចូល សមាជិក សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ (TYDA) នា ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២២ ម្សិលមិញ ។
បន្ថែម ពី នេះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត អរគុណ សមាជិក - សមាជិកា សមាគម ដែល បាន លះបង់ ពេលវេលា កម្លាំង កាយ ចិត្ត ប្រើប្រាស់ ចំណេះដឹង ជំនាញ និង បទពិសោធន៍ ជួយ ពិនិត្យ ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ក៏ បាន ថ្លែងអំណរគុណ សប្បុរសជន ដែល បាន នឹង កំពុង ឧបត្ថម្ភ សម្ភារ បរិក្ខារ ក្នុង ការផ្ដល់ លទ្ធភាព និង ទ្រទ្រង់ សមាគម ឱ្យ សមាគម មាន លទ្ធភាព បំពេញ បេសកកម្ម មនុស្សធម៌ បន្ថែម ទៀត និង សូម ថ្លែងអំណរគុណ ដៃ គូ សហការ ដែល បាន ជួយ ឧបត្ថម្ភ គាំទ្រ តាមរយៈ ការចូលរួម ដោយ ផ្ទាល់ ក្នុង បេសកកម្ម ក៏ ដូចជា ការជួយសម្របសម្រួល យកចិត្តទុកដាក់ រាល់ សកម្មភាព របស់ សមាគម ៕ អភិបាល ខេត្ត ព្រះវិហារ ត្រៀម សង្គ្រោះ ពលរដ្ឋ រួច ជាស្រេច ក្នុង ករណី គ្រោះ ទឹក ជំនន់ កើតឡើង
( ព្រះវិហារ ) ៖ រយៈពេល ២ ថ្ងៃ ហើយ ថ្ងៃទី ២១ - ២២ ខែសីហា ឆ្នាំ ២០២២ ដែល លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ បាន បន្ត ដឹកនាំ ក្រុមការងារ កងកម្លាំងប្រដាប់អាវុធ និង អាជ្ញាធរ មូលដ្ឋាន ចុះ ពិនិត្យ ស្ថានភាព តាម បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ - ឡាវ និង បន្ត ចុះ ពិនិត្យ ស្ថានភាព ទឹក ជំនន់ នៅ ស្រុក ជាំ ក្សាន្ត ស្រុក ជ័យ សែន និង ស្រុក រវៀង ដើម្បី ត្រៀមលក្ខណៈ សង្រ្គោះ ប្រជាពលរដ្ឋ ឱ្យ បាន ទាន់ ពេលវេលា ក្នុង ករណី គ្រោះ ទឹក ជំនន់ កើត មាន ឡើង ។
ការចុះ ពិនិត្យ ស្ថានភាព ទឹក របស់ លោក អភិបាល ខេត្ត ព្រះវិហារ គឺ បន្ទាប់ពី ភ្លៀង ធ្លាក់ ជា បន្តបន្ទាប់ រយៈពេល ប៉ុន្មាន ថ្ងៃ កន្លងមក នេះ បណ្តាលឲ្យ មាន ជំនន់ ទឹកភ្លៀង នៅ តំបន់ ទំនាប លើ ភូមិ ចំនួន ៧ ក្នុង ភូមិសាស្រ្ត ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ។
គិត ត្រឹម ថ្ងៃទី ២១ ខែសីហា ទឹក ជំនន់ នេះ បាន ធ្វើឱ្យ លិច ផ្ទះ ប្រជាពលរដ្ឋ ៣៦ ខ្នង ប៉ើង ហូរ តាម ទឹក ១ខ្នង លិច ផ្លូវ ប្រវែង ៤. ១៣៥ម៉ែត្រ លូចំនួន ២៦កន្លែង ដី ស្រែ ចម្ការ ២១ហិកតា ងាប់ គោ១ ក្បាល ខូចខាត សម្ភារ និង មធ្យោបាយ មួយចំនួន ។
ក្នុង ហេតុការណ៍ ជំនន់ ទឹក ភ្លឿង នេះ កម្លាំង អាជ្ញាធរ ស្រុក ឃុំ សហការ ជាមួយ កម្លាំង នគរបាល ស្រុក និង កម្លាំង កងពល តូច អន្តរាគមន៍ លេខ ៧ចុះ ជួយ សង្រ្គោះ បាន ទាន់ ពេលវេលា ដោយ បាន សម្រួល ផ្លូវ ដឹកជញ្ជូន សម្ភារ មធ្យោបាយ និង ជម្លៀស ប្រជាពលរដ្ឋ រងគ្រោះ មកកាន់ ទី ទួល ដោយ សុវត្ថិភាព ពុំ មាន បង្កឲ្យ គ្រោះថ្នាក់ ដល់ អាយុជីវិត ប្រជាពលរដ្ឋ ឡើយ ។
បើ ទោះបី ស្ថាន ទឹក ចាប់ផ្តើម ស្រកចុះ ជា បណ្តើរ ៗ ហើយក៏ ដោយ ប៉ុន្តែ កម្លាំង អន្តរាគមន៍ ជួយ សង្រ្គោះ បាន ត្រៀមលក្ខណសម្បត្តិ គ្រប់ ពេលវេលា ២៤ ម៉ោង លើ ២៤ ម៉ោង ក្នុង ករណី ទឹក ជំនន់ មាន ការហក់ ឡើងវិញ ។ ចំណែក នៅលើ ភ្នំ ប្រាសាទ ព្រះវិហារ មាន ភ្លៀង ធ្លាក់ ជាប់ ៗ គ្នា ប្រមាណ ៧ ថ្ងៃ នឹង នៅ យប់ ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២២ នេះ ភ្លៀង ពេញ មួយ យប់ បណ្តាលឲ្យ ច្រោះ ផ្លូវ ឡើង ទៅ លើ ភ្នំ ត្រង់ ម្តុំ ខាងលើ ចម្ការ ចេក ។
នៅ ថ្ងៃទី ២២ នេះ លោក អភិបាល ខេត្ត ព្រះវិហារ បាន បន្ត ដឹកនាំ ក្រុមការងារ កងកម្លាំងប្រដាប់អាវុធ និង អាជ្ញាធរ មូលដ្ឋាន ចុះ ពិនិត្យ តាម តំបន់ ព្រំដែន ពិនិត្យ ស្ថានភាព ទឹក ជាក់ស្តែង បន្ត ទៀត ៕ លោក ឡី សុភាព និង ក្រុម យុវជន ក្រោម ឱវាទ សូម អបអរសាទរ អភិបាល ខណ្ឌ ៨រូប ក្នុង រាជធានី ភ្នំពេញ ដែល ត្រូវបាន តែងតាំង ថ្មី
( ភ្នំពេញ ) ៖ លោក ឡី សុភាព ប្រធាន សមាគម យុវជន សេដ្ឋកិច្ច កម្ពុជា ប្រធាន សមាគម សហព័ន្ធ វិនិយោគិន កម្ពុជា និង ក្រុម យុវជន ក្រោម ឱវាទ បាន ចេញ លិខិត អបអរសាទរ ជូន ចំពោះ ថ្នាក់ដឹកនាំ ៨រូប ដែល ត្រូវបាន រាជ រដ្ឋាភិបាល តែងតាំង ជា អភិបាល ខណ្ឌ ។
លោក ហែម ដារិទ្ធ អភិបាល ខណ្ឌ មានជ័យ លោក សុខ សម្បត្តិ អភិបាល ខណ្ឌ បឹងកេងកង លោក ថេង សុថុល អភិបាល ខណ្ឌ ៧មករា លោក ធឹម សំអាន អភិបាល ខណ្ឌ ព្រៃ ព្នៅ លោក លឹម សុភា អភិបាល ខណ្ឌ ជ្រោយ ចង្វារ លោក សក់ ច័ន្ទ កញ្ញា រិទ្ធ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ លោក កៀង ល័ក្ស អភិបាល ខណ្ឌ ចំការមន លោក ជា ខេមា អភិបាល ខណ្ឌ ដូនពេញ
លិខិត អបអរសាទរ បាន បន្ត ថា ចំពោះ ដំណឹង ដ៏ ល្អ ប្រពៃ ខាង លើ នេះ សមាគម យុវជន សេដ្ឋកិច្ច កម្ពុជា និង សមាគម សហព័ន្ធ វិនិយោគិន កម្ពុជា មាន ការកោតសរសើរ ចំពោះ ថ្នាក់ដឹកនាំ ទាំង ៨រូប ដែល បាន យក ឆន្ទៈ មនសិការ បញ្ញា ញាណ ពុះពារ រាល់ ឧបសគ្គ គ្រប់ បែបយ៉ាង រហូត សម្រេចបាន លទ្ធផល ដ៏ ប្រពៃ ដែល រួមចំណែក បម្រើ ឧត្តម ប្រយោជន៍ ជាតិ និង ប្រជាជន កម្ពុជា ស្រប តាម កម្មវិធី នយោបាយ របស់ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្ដី នៃ កម្ពុជា ៕
ថៃ៖ មនុស្ស ១. ៥៣១ នាក់ ឆ្លង កូវីដ - ១៩ និង អ្នកជំងឺ ២៨ នាក់ ស្លាប់ ក្នុង របាយការណ៍ ថ្ងៃចន្ទ នេះ
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ២៨ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ២. ២៩៨នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ព្រមទាំង នាយ ទាហាន នាយ ទាហាន រង និង ពល អាវុធហត្ថ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
ឯកឧត្ដម ជីវ កេង ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ជីវ កេង អនុប្រធាន តុលាការ កំពូល និង លោកជំទាវ ឆាយ ស៊ីណា បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
ឯកឧត្ដម ស៊ុយ សែម ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ស៊ុយ សែម រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល និង លោកជំទាវ ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ក្រោម ឱវាទ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
បើកបរ សូម ពាក់ ខ្សែក្រវាត់ សុវត្តិភាព ជានិច្ច ! ស្លាប់ ៣នាក់ និង ១៣នាក់ រងរបួស ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២១ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ១៣នាក់ ។
លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ និង រៀបចំ ពិធី ជួបជុំ សំណេះសំណាល សម្រាប់ និស្សិត ដែល នឹង បន្ត ការសិក្សា នៅ សាធារណរដ្ឋ កូរ៉េ សម្រាប់ ឆ្នាំ សិក្សា ២០២២ - ២០២៣
( ភ្នំពេញ ) ៖ លោក ហេង សួរ តំណាង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត អញ្ជើញ ចូលរួម ក្នុង ពិធី ជួបជុំ សំណេះសំណាល ជាមួយនិស្សិត ដែល នឹង បន្ត ការសិក្សា នៅ សាធារណរដ្ឋ កូរ៉េ សម្រាប់ ឆ្នាំ សិក្សា ២០២២ - ២០២៣ នៅ សណ្ឋាគារ ភ្នំពេញ ។ កម្មវិធី នេះ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រុមការងារ ESEA . អតីត និស្សិត សិក្សា នៅ សាធារណរដ្ឋ កូរ៉េ និង និស្សិត ជ័យលាភី អាហារ រូបករណ៍ ដែល នឹង ត្រូវ បន្ត ការសិក្សា នៅ សាធារណរដ្ឋ កូរ៉េ សរុប ចំនួន ៩១ នាក់ ។
លោក ហេង សួរ បាន ចាត់ទុក និស្សិត អាហារូបករណ៍ ជ័យលាភី ដែល ត្រូវ ទៅ បន្ត ការសិក្សា នៅ សាធារណរដ្ឋ កូរ៉េ ជា ធនធាន ដ៏ មាន តម្លៃ និង ជា ស្ពាន ភ្ជាប់ ទំនាក់ទំនង ការទូត រវាង កម្ពុជា - សាធារណរដ្ឋ កូរ៉េ ឲ្យ មាន ភាព កាន់តែ ប្រសើរ និង រឹងមាំ បន្ថែម ទៀត ។ លើស ពី នេះ លោក បាន លើកទឹកចិត្ត ដល់ និស្សិត អាហារូបករណ៍ ទាំងនោះ ត្រូវ ចេះ បង្កើត ឱកាស និង ក្តាប់ ឱកាស ឱ្យ បាន តាមរយៈ ការប្រាស្រ័យទាក់ទង ល្អ ជាមួយ មិត្តភក្តិ បរទេស ដែល ជា កត្តា សំខាន់ មួយ ទៀត ក្រៅពី ការសិក្សា របស់ ខ្លួន ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ហេង សួរ បាន ចូលរួម អបអរសាទរ និង ពាំនាំ នូវ ការផ្តាំផ្ញើ ប្រកបដោយ មនោសញ្ចេតនា ស្រលាញ់ រាប់អាន យ៉ាង ជ្រាលជ្រៅ ពីសំណាក់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ដែល តែងតែ គិតគូ យកចិត្តទុកដាក់ ចំពោះ សុខ ទុក្ខ របស់ ប្អូន ៗ ជាពិសេស តែងតែ ផ្តួចផ្តើម រៀបចំ ពិធី ជួបជុំ សំណេះសំណាល ចែករំលែក បទពិសោធន៍ និង មាន មតិ ផ្តាំផ្ញើ ដល់ ប្អូន ៗ មុនពេល ចេញ ទៅ បន្ត ការសិក្សា នៅឯ បរទេស ។
លោក ហេង សួរ គូសបញ្ជាក់ ថា ពិធី ជួប សំណេះសំណាល នេះ បាន ផ្តល់ ឱកាស ឲ្យ មាន ការជួបជុំគ្នា ដោយ ផ្ទាល់ សម្រាប់ ការផ្លាស់ប្តូរ ព័ត៌មាន និង បទពិសោធន៍ គ្នា ទៅ វិញ ទៅ មក ជាពិសេស ផ្តល់ ឱកាស ដល់ ប្អូន ៗ និស្សិត ក្នុង ការដកស្រង់ បទពិសោធន៍ ផ្ទាល់ ពីសំណាក់ រៀមច្បង ដែល ធ្លាប់ បាន សិក្សា នៅ សាធារណរដ្ឋ កូរ៉េ ព្រមទាំង ទទួលបាន នូវ គំនិត ជំនាញ ចំណេះដឹង ចំណេះ ធ្វើ និង ពិសោធន៍ ដ៏ ជោគជ័យ ពីសំណាក់ រៀមច្បង សម្រាប់ ជា ប្រយោជន៍ ក្នុង ការបណ្តុះ ផ្នត់គំនិត ឥរិយាបថ និង ការអនុវត្ត សម្រាប់ ការលើកកម្ពស់ សមត្ថភាព របស់ ខ្លួន ផង ។
ទេសរដ្ឋមន្ត្រី គន់ គីម ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ព្រមទាំង ថ្នាក់ដឹកនាំ ទីប្រឹក្សា និង មន្ត្រីរាជការ ទាំងអស់ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន ឯកឧត្តម ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ ឯកឧត្តម ទេសរដ្ឋមន្ដ្រី ។
ឯកឧត្ដម បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្ដម បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង លោកជំទាវ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
នាយ ឧត្តមសេនីយ៍ សួស អង្គារ៍ ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សួស អង្គារ៍ អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង លោកជំទាវ ឧកញ៉ា ញឹម សុខាល័យ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ក្រើន រំឮក ដល់ ឪពុក ម្តាយ អាណាព្យាយាបាល ទាំងអស់ ត្រូវ មើល ថែរក្សា កូន និង គ្រប់គ្រង កូន តូច ៗ តូច ៗ របស់ ខ្លួន ឱ្យ បាន ដិតដល់ ។
ការក្រើន រំឮក របស់ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន ធ្វើឡើង បន្ទាប់ពី កាលវេលា ម៉ោង ០៨ និង ៤៥ នាទី ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០២២ មាន ប្រជាពលរដ្ឋ ផ្តល់ ព័ត៌មាន តាមរយៈ លេខ ទូរស័ព្ទ ១២៩១ របស់ មណ្ឌល បញ្ជា ប្រតិបត្តិការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ដោយ បាន រាយការណ៍ ថា បាន ប្រទះឃើញ កុមារ វង្វេង ឪពុក ម្តាយ ម្នាក់ នៅ ចំណុច ផ្លូវ ៣៧១ ភូមិ ឬ ស្សី សង្កាត់ ស្ទឹងមានជ័យ ទី២ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។ បន្ទាប់ពី ទទួលបាន ព័ត៌មាន នេះ ភ្លាម ។
ភ្លាម ៗ ទទួលបាន ព័ត៌មាន លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន ដាក់បញ្ជា ដោយ ផ្ទាល់ ដល់ ក្រុមការងារ ឱ្យ ចុះ ទៅដល់ កន្លែង កើត ហេតុ ហើយ បាន ទទួលយក កុមារា ម្នាក់ នោះ មក មូលដ្ឋាន កងរាជអាវុធហត្ថ ខណ្ឌ មានជ័យ ដើម្បី ធ្វើ ការស្រាវជ្រាវ ស្វែងរក ឪពុក ម្ដាយ និង បាន ជូន ដំណឹង ទៅកាន់ បណ្តាញ សង្គម ផងដែរ ដើម្បីឱ្យ ជួយ ប្រកាស រក ឪពុក ម្ដាយ អាណាព្យាបាល មក ទទួលយក កុមារ ត្រឡប់ ទៅ ផ្ទះ វិញ ។
ក្រោយពី បាន ធ្វើ ការស្រាវជ្រាវ និង ផ្សព្វផ្សាយ តាម បណ្តាញ សង្គម ផង នោះ នៅ ទីបំផុត កុមារា ដែល វង្វេង ឪពុក ម្តាយ ម្នាក់ នេះ ត្រូវបាន ម្ដាយ ឈ្មោះ ចិន ចន្ធី ភេទ ស្រី អាយុ ៣៨ ឆ្នាំ មុខរបរ កម្មការិនី រោងចក្រ មាន ទីលំនៅ ភូមិ ដំណាក់ ធំ២ សង្កាត់ ស្ទឹងមានជ័យ២ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ មក ទទួលយក ត្រឡប់ ទៅ ផ្ទះ វិញ ដោយ សុវត្ថិភាព ។ កុមារា មាន ឈ្មោះ ថា ខេត សុខេម អាយុ ០៥ ឆ្នាំ ។
ចំពោះ ករណី កុមារ វង្វេង ផ្លូវ បាត់ ឪពុក ម្តាយ នេះ បាន ធ្វើឱ្យ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បង្ហាញ នូវ អារម្មណ៍ ក្តុកក្តួល អាណិត ស្រណោះ ជា ពន់ពេក និង សូម អំពាវនាវ ដល់ ឪពុក ម្តាយ ទូទៅ ត្រូវ មើល ថែ និង គ្រប់គ្រង កុមារ ឱ្យ បាន ដិតដល់ ជៀសវាង មាន រឿង អកុសល កើតឡើង លើ កុមារ ដោយសារតែ ការធ្វេសប្រហែស របស់ យើង ដែល អាចនឹង ក្លាយជា រឿង វិប្បដិសារី អស់ មួយ ជីវិត ៕
សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត របស់ ឯកឧត្ដម ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ផ្ញើ សារ ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ និង សោកស្ដាយ យ៉ាង ខ្លាំង ជូន ចំពោះ ឯកឧត្ដម ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ត្រូវ ជា ឪពុក បង្កើត របស់ ឯកឧត្ដម ដែល បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ៦ល្ងាច ថ្ងៃអាទិត្យ ទី ២១ ខែសីហា ឆ្នាំ ២០២២ នេះ ក្នុង ជន្មាយុ ៩៦ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង វេលា ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហា វីរិយាភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង សូម បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ខាងលើ នេះ មាន ករណី នាំចូល ចំនួន ១០៣ ករណី ក្រៅពី នោះ ជា ករណី ឆ្លង ក្នុង សហគមន៍ ទាំងអស់ ។
ឯកឧត្តម ងី តា យី និង លោកជំទាវ ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឪពុក បង្កើត ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល
( ភ្នំពេញ ) ៖ ឯកឧត្តម ងី តា យី រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង លោកជំទាវ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ចំពោះ មរណភាព របស់ មហា វីរិយា ភិរ័ក្ខ សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ ខេរ៉ូ ស៊ុន ស្រេង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ទេសរដ្ឋមន្ដ្រី ។
មន្ត្រី ស៊ើបការណ៍ សំងាត់ ជាន់ ខ្ពស់ អ៊ុយក្រែន ម្នាក់ ត្រូវបាន គេ ប្រទះឃើញ ស្លាប់ ក្នុង គេហដ្ឋាន របស់ ខ្លួន នៅ កណ្តាល ប្រទេស
ប៉ូលិស បាន បើក ការស៊ើបអង្កេត លើ ករណី ស្លាប់ នេះ ប៉ុន្តែ មិន បាន ធ្វើ អត្ថាធិប្បាយ បន្ថែម ទៀត ទេ ។
កងទ័ព កងពល តូច អន្តរាគមន៍ លេខ ៧ ចុះ អន្តរាគមន៍ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ដែល ផ្ទះ ជន លិច ដោយ ជំនន់ ទឹកភ្លៀង តាម បន្ទាត់ ព្រំដែន ភ្នំ ដង រ៉ែ ក
តាំងពីដើម មក វិស័យ ទេសចរណ៍ គឺជា ប្រភព ដ៏ សំខាន់ នៃ ដើមទុន របស់ ស្រីលង្កា ។ ក្នុង ឆ្នាំ ២០១៨ វិស័យ ទេសចរណ៍ មាន ចំនូល រហូតដល់ ចំនួន ៤.៤ពាន់ លាន ដុល្លារ ដែល ស្មើនឹង ៥.៦ភាគរយ នៃ ផលិតផល ក្នុង ស្រុក សរុប របស់ ប្រទេស នេះ ។ ប៉ុន្តែ វា បាន ធ្លាក់ចុះ មក ត្រឹមតែ ០៨ ភាគរយ ប៉ុណ្ណោះ ក្នុង ឆ្នាំ ២០២០ ដោយសារ ជំងឺ រាតត្បាត កូវីដ១៩ ។
