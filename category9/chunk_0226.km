( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឃឹម ប៊ុន សុង រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង លោកជំទាវ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព មហា ឧបាសិកា កុសល ចិត្ត ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ម្ដាយ ក្មេក លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន និង ត្រូវ ជា ម្ដាយ បង្កើត លោកស្រី ទេព រង្ស៉ី ។
សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហា ឧបាសិកា កុសល ចិត្ត ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត សូម ឆាប់ បាន ចាប់កំណើត កើត ក្នុង សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ អង្គការ កសិកម្ម មួយ គ្រោង សហការ ជាមួយ អាជ្ញាធរ និង កសិករ ផលិត ជី កំប៉ុស្តិ៍ ពី អាចម៍ ជន្លេន តាមរយៈ ការកែច្នែ សំរាម ពី ផ្សារ ដើម្បី កាត់បន្ថយ ទៅ លើ ការចំណាយ ទិញ ជី
លោក ប៉ាត សុវណ្ណ អ្នក បច្ចេកទេស កសិកម្ម នៃ អង្គការ GRET បាន ឱ្យដឹង ថា គម្រោង ផលិត ជី កំប៉ុស្តិ៍ ចេញ ពី អាចម៍ ជន្លេន នេះ ធ្វើឡើង ស្រប ពេល ដែល តម្លៃ ជី និង ធាតុ ចូល កសិកម្ម ផ្សេង ៗ កំពុង ឡើង ថ្លៃ ដែល គម្រោង នេះ នឹង ជួយ កាត់បន្ថយ ការចំណាយ របស់ កសិករ ទៅ លើ ការទិញ ជី បាន មួយ ផ្នែក ។ ពោលគឺ ការផលិត ជី កំប៉ុស្តិ៍ ពី ជន្លេន នេះ នឹង ចូលរួមចំណែក ជួយ ទាំង បរិស្ថាន និង សេដ្ឋកិច្ច កសិករ ព្រមទាំង ទទួលបាន បន្លែ សុវត្ថិភាព ។
លោក បាន ឱ្យដឹង ថា គម្រោង ផលិត ជី កំប៉ុស្តិ៍ ពី អាចម៍ ជន្លេន នេះ អង្គការ GRET បាន សហការ ជាមួយ អាជ្ញាធរ ស្រុក ដុំ ដែក ផ្នែក បរិស្ថាន និង ក្រុមហ៊ុន ស៊ិន ទ្រី ដែល ជា អ្នក ប្រមូល សម្រាម ដើម្បី ប្រមូល សំរាម ពី ផ្សារ នេះ និង តំបន់ ជុំវិញ យកមក ឱ្យ ជន្លេន ស៊ី ហើយ ផលិត ចេញ ជា ជី កំប៉ុស្តិ៍ សម្រាប់ កសិករ មក ប្រើប្រាស់ លើ ដំណាំ ផ្សេង ៗ ទាំង បន្លែ និង ស្រូវ ។
លោក បាន គូសបញ្ជាក់ ថា « យើង បាន សិក្សា ពី បរិមាណ សំរាម ដែល អាច កែច្នៃ បានជា ជី នៅក្នុង ផ្សារ ដំដែក រួចហើយ ហើយ យើង បាន សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ស្រុក សុំ ទីតាំង គាត់ ដែល យើង អាច សាងសង់ អគារ ដើម្បី ស្តុក សម្រាម និង ដាក់ ជន្លេន ក៏ ដូចជា ស្តុក ជី កំប៉ុស្តិ៍ ។ ហើយ ទីតាំង នេះ អាចនឹង សាងសង់ នៅ រយៈពេល ២ ទៅ ៣ខែ ខាងមុខ ។ អង្គការ GRET នឹង ចាប់ ផ្តល់ វគ្គ បណ្តុះបណ្តាល ដល់ អ្នកលក់ បន្លែ នៅក្នុង ផ្សារ ដុំ ដែក ដើម្បីឱ្យ ពួកគាត់ យល់ ពី ការជែក សម្រាម និង ការទុកដាក់ សម្រាម ដាច់ដោយឡែក ពី គ្នា ។ »
លោក បន្ត ថា សម្រាប់ ជី ដែល បាន ផលិត នេះ នឹង ប្រើប្រាស់ នៅក្នុង សហគមន៍ ផលិត បន្លែ នៅក្នុង ស្រុក សូទ្រនិគម ខេត្ត សៀមរាម ប្រសិនបើ បរិមាណ ផលិត ច្រើន លើ ស តម្រូវការ គម្រោង នឹង លក់ ឱ្យ កសិករ នៅ ក្រៅ សហគមន៍ ផងដែរ ។
តាម អ្នកបច្ចេកទេស កសិកម្ម រូប នេះ រំពឹង ថា ក្នុង មួយ ថ្ងៃ នឹង ប្រមូល សំរាម ឬ កាកសំណល់ ផ្សេង ៗ បាន ប្រមាណ ១តោន សម្រា ប់ យក ទៅ ផលិត ជី ដែល ក្នុង មួយ ឆ្នាំ អាច ផលិត ប្រមាណ ២០តោន ឬ ប្រមាណ ជាង ២តោន ក្នុង ខែ ៕
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០២២ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃអង្គារ ទី ០៩ ខែសីហា ឆ្នាំ ២០២២ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដូច្នេះ សូម ទស្សនា ដូច ខាងក្រោម៖ ១៖ ប៉ូលិស អាមេរិក FBI ឆ្មក់ ឆែកឆេរ ផ្ទះ អតីត ប្រធានាធិបតី លោក ដូណាល់ ត្រាំ ក្នុង រដ្ឋ ផ្ល័រីដា
២៖ រុស្ស៉ី ផ្អាក ការត្រួតពិនិត្យ ឃ្លាំង អាវុធ នុយក្លេអ៊ែរ ក្រោម សន្ធិសញ្ញា New START ជាមួយ សហរដ្ឋ អាមេរិក
៤៖ លោក ប្ល៊ីន ខិន៖ សហរដ្ឋ អាមេរិក កំពុង ស្វែងរក ភាព ជាដៃគូ ពិតប្រាកដ ជាមួយ អាហ្វ្រិក
៥៖ តៃវ៉ាន់ ធ្វើ សមយុទ្ធ បាញ់ កាំភ្លើង ធំ ចំពោះ មុខ ភាពតានតឹង ជាមួយ ចិន
នាយ ឧត្តមសេនីយ៍ សាស្រ្តាចារ្យ បណ្ឌិត ណុប រតនា ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ម្ដាយ ក្មេក រដ្ឋមន្ដ្រី ខៀវ កាញារីទ្ធ
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សាស្រ្តាចារ្យ បណ្ឌិត ណុប រតនា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ បញ្ជាការដ្ឋាន កាំភ្លើង ធំ អគ្គ បញ្ជាការ និង ភរិយា ព្រមទាំង នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន នៃ បញ្ជាការដ្ឋាន កាំភ្លើង ធំ អគ្គ បញ្ជាការ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព មហា ឧបាសិកា កុសល ចិត្តា ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ម្ដាយ ក្មេក លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន និង ត្រូវ ជា ម្ដាយ បង្កើត លោកស្រី ទេព រង្ស៉ី ។
ឯកឧត្តម ព្រុំ សុខា ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ម្ដាយ ក្មេក រដ្ឋមន្ដ្រី ខៀវ កាញារីទ្ធ
( ភ្នំពេញ ) ៖ ឯកឧត្តម ព្រុំ សុខា រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព មហា ឧបាសិកា កុសល ចិត្តា ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ម្ដាយ ក្មេក លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន និង ត្រូវ ជា ម្ដាយ បង្កើត លោកស្រី ទេព រង្ស៉ី ។
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្រ្តី ទទួលបន្ទុក បេសកកម្ម ពិសេស បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព មហា ឧបាសិកា កុសល ចិត្តា ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ម្ដាយ ក្មេក លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន និង ត្រូវ ជា ម្ដាយ បង្កើត លោកស្រី ទេព រង្ស៉ី ។
លោក បណ្ឌិត បាន សរសេរ ថា រូប ខ្ញុំ និង ភរិយា មាន សេចក្តីក្តុកក្តួល និង សោកស្តាយ ឥត ឧបមា ដោយ ទទួល ដំណឹង ដ៏ ក្រៀម កំថា មហា ឧបាសិកា កុសល ចិត្តា ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ត្រូវ ជា ម្តាយ ម្តាយ ក្មេក របស់ ឯកឧត្តម និង លោកជំទាវ បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ០៩៖ ១៥ ព្រឹក ថ្ងៃអង្គារ៍ ១២កើត ខែ ស្រា ពណ៍ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស .២៥៦៦ ត្រូវនឹង ថ្ងៃទី ៩ ខែសីហា ឆ្នាំ ២០២២ ក្នុង ជន្មាយុ ៩២ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង វេលា ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ រូប ខ្ញុំ និង ភរិយា សូម សម្តែង នូវ ការសោកស្តាយ ស្រណោះ អាឡោះអាល័យ ចំពោះ ការបាត់បង់ មហា ឧបាសិកា កុសល ចិត្តា ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត គឺជា ការបាត់បង់ ដ៏ ធំធេង របស់ ឯកឧត្តម និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ ទាំងមូល ។
មរណភាព របស់ មហា ឧបាសិកា កុសល ចិត្តា ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត គឺជា ការបាត់បង់ ម្តាយ ម្តាយ ក្មេក ជីដូន ជី ទួត ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ដ៏ ជ្រាលជ្រៅ ចំពោះ កូន ៗ និង ចៅ ៗ និង ពេញ មួយ ជីវិត របស់ មហា ឧបាសិកា បាន តស៊ូ លះបង់ កម្លាំង កាយ ចិត្ត ធនធាន និង បញ្ញា ស្មារតី ក្នុង ការលើកស្ទួយ ដល់ វិស័យ សាសនា នៅ កម្ពុជា ឲ្យកាន់តែ មាន ការរីកចម្រើន នា ពេល កន្លងមក ៕
រដ្ឋមន្ត្រី ក្រសួង ការពារ ប្រទេស វៀតណាម សម្ដែង ការអបអរសាទរ ការ រីកចម្រើន លើ គ្រប់ វិស័យ ដ៏ ឆាប់រហ័ស របស់ កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន
ការសម្តែង នូវ ការអបអរសាទរ បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ ផ្វាន វ៉ាន់ ហ្សាង បាន ធ្វើឡើង ក្នុង ជំនួប ពិភាក្សា ការងារ ជាមួយ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក នា ឱកាស នៃ ការបំពេញ ទស្សនកិច្ច ផ្លូវការ របស់ គណៈប្រតិភូ ជាន់ ខ្ពស់ កងទ័ព ជើងគោក នៃ កងយោធពល ខេមរភូមិន្ទ នៅ សាធារណរដ្ឋ សង្គម និយម វៀតណាម នា រសៀល ថ្ងៃទី ០៨ ខែសីហា ឆ្នាំ ២០២២ ម្សិលមិញ ។
ក្នុង ជំនួប នេះ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត បាន ជម្រាប ជូន នាយ ឧត្តមសេនីយ៍ ផ្វាន វ៉ាន់ ហ្សាង អំពី ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ដ៏ ជិតស្និទ្ធ រវាង កងទ័ព ជើងគោក នៃ កងយោធពល ខេមរភូមិន្ទ ជាមួយនឹង បណ្តា ស្ថាប័ន - កង ឯកភាព ជាច្រើន នៃ កងទ័ព ប្រជាជន វៀតណាម តាមរយៈ សកម្មភាព ជាច្រើន ទាំង ការអប់រំ បណ្តុះបណ្តាល ធន មនុស្ស . ការផ្លាស់ប្តូរ គណៈប្រតិភូ . លំហាត់ ហ្វឹកហ្វឺន រួម . ការផ្តល់ ជំនួយ យោធា និង សម្ព័ន្ធ មេត្រីភាព រវាង អង្គភាព និង អង្គភាព ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ ផ្វាន វ៉ាន់ ហ្សាង ក៏ បាន គូសបញ្ជាក់ ផងដែរ អំពី ការគាំទ្រ ចំពោះ ទិសដៅ ដែល បាន ឯកភាព គ្នា សំដៅ ធ្វើ យ៉ាងណា បន្ត ថែរក្សា និង លើកម្ពស់ កិច្ចសហប្រតិបត្តិការ ដែល មាន ស្រាប់ ឱ្យ កាន់តែ ជិតស្និទ្ធ និង រឹងមាំ ព្រម ជាមួយនឹង ការរួមគ្នា សំលឹង មើល សក្តានុពល ថ្មី ៗ បន្ថែម ទៀត សម្រាប់ ពេល អនាគត ។
ក៏ បាន សម្តែង នូវ ការអបអរសាទរ និង ការគាំទ្រ ផងដែរ ចំពោះ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ដែល ត្រូវបាន អង្គ សន្និបាត គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា លើក ទី ៤៣ បោះឆ្នោត ជាជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី នា ពេល អនាគត និង បាន ជូន ពរ ឱ្យ ការបោះឆ្នោត ថ្នាក់ ជាតិ ក្នុង ឆ្នាំ ២០២៣ នៅ កម្ពុជា ប្រព្រឹត្តិ ទៅ ប្រកបដោយ ភាពជោគជ័យ ៕ ជំនន់ ទឹកភ្លៀង នៅ កូរ៉េ ខាងត្បូង សម្លាប់ មនុស្ស ០៨ នាក់ និង ០៦ នាក់ ទៀត កំពុង បាត់ខ្លួន ខណៈ សេវ៉ាកម្ម សាធារណៈ មួយចំនួន ត្រូវបាន ផ្អាក
( សេអ៊ូល ) ៖ ទីស្នាក់ការ កណ្តាល ប្រយុទ្ធ ប្រឆាំង នឹង គ្រោះមហន្តរាយ កូរ៉េ ខាងត្បូង បាន ឲ្យដឹង នៅ ថ្ងៃអង្គារ នេះ ថា មនុស្ស ០៨ នាក់ បាន ស្លាប់ និង ០៦ នាក់ ផ្សេង ទៀត បាន បាត់ខ្លួន ខណៈ ដែល តំបន់ ទីប្រជុំជន របស់ ប្រទេស មួយ នេះ ត្រូវបាន វាយប្រហារ ដោយ ភ្លៀង ធ្លាក់ ខ្លាំង ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃអង្គារ ទី ០៩ ខែសីហា ឆ្នាំ ២០២២ ។
ទឹកភ្លៀង ធ្លាក់ ត្រូវបាន គេ ព្យាករណ៍ ថា មាន រហូតដល់ ៣០០ មីលីម៉ែត្រ នៅ តំបន់ ទីប្រជុំជន រហូតដល់ ថ្ងៃពុធ សប្តាហ៍ នេះ ។
ភ្លៀង ធ្លាក់ បាន បណ្តាលឲ្យ មនុស្ស ០៥ នាក់ ស្លាប់ និង ០៤ នាក់ បាត់ខ្លួន នៅក្នុង ទីក្រុង សេអ៊ូល ខណៈ ដែល ០៣ នាក់ ទៀត បាន ស្លាប់ និង ០២ នាក់ ផ្សេង ទៀត ត្រូវបាន រាប់បញ្ចូល ក្នុង ខេត្ត Gyeonggi ។ មនុស្ស ០៨ នាក់ បាន រងរបួស នៅក្នុង ខេត្ត នេះ ហើយ មនុស្ស ៣៩១ នាក់ ទៀត ដែល មកពី ២៣០ គ្រួសារ នៅក្នុង រាជធានី ត្រូវបាន ជម្លៀស ខ្លួន ទៅ ជ្រកកោន នៅ តាម កន្លែង សាធារណៈ ។
ភ្លៀង ធ្លាក់ ខ្លាំង បាន ជន់ លិច ផ្លូវ ដែក ក្នុង ទីក្រុង សេអ៊ូល និង Incheon បាន នាំឱ្យ មាន ការផ្អាក សេវាកម្ម បណ្តោះអាសន្ន នៅក្នុង ផ្នែក ខ្លះ នៃ ផ្លូវ រថភ្លើង ក្រោម ដី និង ផ្លូវ រថភ្លើង មួយចំនួន ៕
ឯកឧត្តម ទេសរដ្ឋមន្ត្រី គន់ គីម ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ម្ដាយ ក្មេក រដ្ឋមន្ដ្រី ខៀវ កាញារីទ្ធ
( ភ្នំពេញ ) ៖ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ និង លោកជំទាវ ព្រមទាំង ថ្នាក់ដឹកនាំ ទីប្រឹក្សា មន្ត្រីរាជការ ទាំងអស់ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព មហា ឧបាសិកា កុសល ចិត្ត ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ម្ដាយ ក្មេក លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន និង ត្រូវ ជា ម្ដាយ បង្កើត លោកស្រី ទេព រង្ស៉ី ។
សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហា ឧបាសិកា កុសល ចិត្ត ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត សូម ឆាប់ បាន ចាប់កំណើត កើត ក្នុង សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ រៀបចំ ពិធី អបអរសាទរ ទិវា ជនជាតិ ដើម ភាគ តិច លើក ទី ២៨ លើ ពិភពលោក និង លើក ទី១៨ នៅ ប្រទេស កម្ពុជា
( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ នា ព្រឹក ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី អបអរសាទរ ទិវា ជនជាតិ ដើម ភាគ តិច លើក ទី ២៨ លើ ពិភពលោក និង លើក ទី១៨ នៅ ប្រទេស កម្ពុជា ក្រោម ប្រធានបទ៖ « តួនាទី ស្ត្រី ជនជាតិ ដើម ភាគ តិច ក្នុង ការអភិវឌ្ឍ និង ការផ្ទេរ ចំណេះដឹង ប្រពៃណី » ដែល រៀបចំ ធ្វើឡើង នៅ សាលា ឆទាន ភូមិ កោដូន តី ឃុំ ត្រពាំង ជោ ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ។
ពិធី នេះ ដែរ ក៏ មាន ការចូលរួម ពី លោក ឧកញ៉ា ហ៊ួ សុជាតិ លោក ឧកញ៉ា ឆាយ សុធា ទីប្រឹក្សា សម្តេច ក្រឡាហោម ស ខេង រួមទាំង មាន ការចូលរួម ពី មន្ត្រី ជំនាញ លោក ប្រធាន មន្ទី ខេត្ត រួមទាំង បងប្អូន ប្រជាពលរដ្ឋ ដែល ជា ជនជាតិ ដើម ភាគ តិច អំបូរ សួយ និង អំបូរ ផ្សេង ៗ ជាច្រើន នាក់ ផងដែរ ។
លើកឡើង នា ឱកាស នោះ លោក វ៉ី សំណាង បាន គូសបញ្ជាក់ ថា ការប្រារព្ធ នូវ ទិវា នេះ មិន មែន ធ្វើឡើង ដើម្បី រំលឹក ដល់ ការចងចាំ នូវ ថ្ងៃ ប្រវត្តិសាស្ត្រ ប៉ុណ្ណោះ នោះ ទេ ប៉ុន្តែ គឺ ដើម្បី ផ្សព្វផ្សាយ អំពី សិទ្ធិ សេដ្ឋកិច្ច សង្គម និង វប្បធម៌ ជនជាតិ ដើម ភាគ តិច ឈាន ទៅរក ការលុបបំបាត់ ទាំងស្រុង ចំពោះ ការរើសអើង ក្នុង សង្គម ។
អភិបាល ខេត្ត កំពង់ស្ពឺ ក៏ បាន លើកឡើង ដែរ ថា ក្នុង ចំណោម បងប្អូន ជនជាតិ ដើម ភាគ តិច នេះ គឺ បាន និង កំពុង អាស្រ័យ ផល ដោយ ពឹងផ្អែក លើ ធនធាន ធម្មជាតិ ដូចជា ដង ជ័រ បោច វល្លិ៍ រក ផ្តៅ បន្លែ ផ្លែ ឈើ រក ទឹកឃ្មុំ ឱសថ បុរាណ រើស ជ័រ ចុង ធ្វើ ស្រែ និង កាប់ ចំការវិល ជុំ បរបាញ់ សត្វ ជា លក្ខណៈ ប្រពៃណី ជាដើម ។
សូម បញ្ជាក់ ដែរ ថា នា ឱកាស នោះ ដែរ លោក វ៉ី សំណាង ក៏ បាន ប្រគល់ អំណោយ រួម មាន៖ សំលៀកបំពាក់ កាបូប និង ថវិកា មួយចំនួន ដែល ជា ជំនួយ របស់ លោក ឧកញ៉ា ហ៊ួ សុជាតិ និង លោក ឧកញ៉ា ឆាយ សុធា រួមទាំង សប្បុរស ជន ផ្សេង ៗ ជូន ដល់ បងប្អូន ដែល ជា ជនជាតិ ដើម ភាគ តិច រស់ នៅ ស្រុក ឱរ៉ាល់ ជាច្រើន គ្រួសារ ផងដែរ ៕ ឯកឧត្តម បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ម្ដាយ ក្មេក រដ្ឋមន្ដ្រី ខៀវ កាញារីទ្ធ
( ភ្នំពេញ ) ៖ ឯកឧត្តម បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង លោកជំទាវ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព មហា ឧបាសិកា កុសល ចិត្ត ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ម្ដាយ ក្មេក លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន និង ត្រូវ ជា ម្ដាយ បង្កើត លោកស្រី ទេព រង្ស៉ី ។
ក្រុមហ៊ុន សែល កាត របស់ អ្នក ឧកញ៉ា គិត ម៉េង បង្កើត ភាព ដៃគូ ជា យុទ្ធសាស្រ្ត ជាមួយ ក្រសួង អប់រំ ដើម្បី គាំទ្រ ដល់ កម្មវិធី អប់រំ
( ភ្នំពេញ ) ៖ សែល កាត ដែល ជា ក្រុមហ៊ុន ទូរស័ព្ទ ចល័ត ឈានមុខ គេ ហើយក៏ ជា បុត្រ សម្ព័ន្ធ ក្រុមហ៊ុន រ៉ូយ៉ាល់ គ្រុប បាន ចុះ កិច្ចព្រមព្រៀង កិច្ចសហប្រតិបត្តិការ ឧបត្ថម្ភ ជា យុទ្ធសាស្ត្រ ជាមួយ ក្រសួង អប់រំ យុវជន និង កីឡា (MoEYS) ដើម្បី គាំទ្រ ដល់ កម្មវិធី អប់រំ ដែល មាន បំណង លើកកម្ពស់ ស្តង់ដា ការរអប់រំ និង ផ្តល់ ភាពងាយស្រួល ដល់ ការសិក្សា ជាពិសេស យុវជន កម្ពុជា ។
តាមរយៈ កិច្ចសហប្រតិបត្តិការ ឧបត្ថម្ភ ជា យុទ្ធសាស្ត្រ សែល កាត ត្រូវបាន ប្រសិទ្ធ នាម ជា « ដៃគូ ទូរគមនាគមន៍ ផ្លូវការ » សម្រាប់ កម្មវិធី ចំនួន ៣ ក្រោម ផ្នែក មួយ នៃ សកម្មភាព របស់ សែល កាត ទាក់ទង នឹង មូលនិធិ កសាង សមត្ថភាព និង ការស្រាវជ្រាវ និង ការអភិវឌ្ឍន៍ លើ វិស័យ ទូរគមនាគមន៍ និង បច្ចេកវិទ្យា គមនាគមន៍ និង ព័ត៌មាន ដែល ហៅ កាត់ ថា មូលនិធិ ស. អ. ។
កម្មវិធី ទាំងនេះ ត្រូវបាន រៀបចំឡើង ជាពិសេស ដើម្បី ដោះស្រាយ តម្រូវការ សម្រាប់ ការអប់រំ ប្រកបដោយ ន វានុវត្តន៍ ផ្តោត លើ ជំនាញ និង រួមបញ្ចូល ការអប់រំ ឌីជីថល ក៏ ដូចជា បណ្តុះ ចំណាប់អារម្មណ៍ ផ្នែក បច្ចេកវិទ្យា ឌីជីថល ក្នុង ចំណោម ស្ត្រី ដែល មាន ដូចជា កម្មវិធី ពង្រឹង កម្មវិធី អប់រំ គ្រូបង្រៀន នៅ កម្ពុជា ដែល ហៅ កាត់ ថា (STEPCam) កម្មវិធី សម មូល អប់រំ កម្រិត មូលដ្ឋាន តាម អ៊ីនធឺណិត ហៅ កាត់ ថា (BEEP) និង កម្មវិធី អក្ខរកម្ម នៅ រោងចក្រ ហៅ កាត់ ថា (FLP) ជាដើម ។
លោក បន្ដ ថា « ពួកយើង ជឿជាក់ លើ ឥទ្ធិពល នៃ ការអប់រំ ដើម្បី លើកកម្ពស់ កម្រិត ជីវភាព និង សេដ្ឋកិច្ច ។ ស្រប ពេល ដែល ពួកយើង បោះជំហ៊ាន ឆ្ពោះ ទៅកាន់ ឌីជីថល នីយកម្ម នៅ កម្ពុជា មូលដ្ឋានគ្រឹះ ផ្នែក អប់រំ ដ៏ រឹងមាំ គឺ ត្រូវការ ជា ចាំបាច់ ហើយ វា ក៏ ដើរ តួយ៉ាង សំខាន់ ក្នុង ការធានា ឱ្យ ចក្ខុវិស័យ នេះ ក្លាយជា ការពិត ផងដែរ ។ ពួកយើង ទន្ទឹងរង់ចាំ ការអនុវត្ត ប្រកបដោយ ជោគជ័យ និង ការខិតខំ ប្រឹងប្រែង រួមគ្នា រវាង ក្រសួង អប់រំ យុវជន និង កីឡា និង សែល កាត ក្នុង ការពង្រីក លទ្ធភាព និង ឥទ្ធិពល នៃ កម្មវិធី ទាំងនេះ » ។
ពិធី ចុះហត្ថលេខា ជា ផ្លូវការ នេះ បាន ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ៩ ខែសីហា ឆ្នាំ ២០២២ នៅ ក្រសួង អប់រំ យុវជន និង កីឡា ក្រោម ការដឹកនាំ ដោយ បណ្ឌិត ហង់ ជួន ណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា និង អ្នក ឧកញ៉ា គិត ម៉េង អគ្គ នាយក ក្រុមហ៊ុន រ៉ូយ៉ាល់ គ្រុប ។
បណ្ឌិត ហង់ ជួនណារ៉ុន បាន ស្វាគមន៍ ចំពោះ ភាពជាដៃគូ ថ្មី ជាមួយ ក្រុមហ៊ុន សែល កាត ដែល ជា សក្ខីភាព នៃ ការកើនឡើង នៃ ការវិនិយោគ ពី ដៃគូ វិស័យ ឯកជន ក្នុង ការលើកកម្ពស់ គុណភាព អប់រំ នៅ កម្ពុជា ។
បណ្ឌិត ហង់ ជួនណារ៉ុន បាន លើកឡើង ថា « ការពង្រឹង ជំនាញ ឌីជីថល របស់ គ្រូបង្រៀន បុគ្គលិក អប់រំ និង យុវជន របស់ យើង គឺជា អាទិភាព សំខាន់ មួយ ក្នុង ការអភិវឌ្ឍ ធនធាន មនុស្ស ដែល មាន ជំនាញ ក្នុង សតវត្សរ៍ ទី ២១ ដើម្បី គាំទ្រ ដល់ ការផ្លាស់ប្តូរ ឌីជីថល របស់ កម្ពុជា » ។
លោក បណ្ឌិត បន្ដ ថា « ភាពជាដៃគូ យុទ្ធសាស្ត្រ ថ្មី ជាមួយ សែល កាត នឹង គាំទ្រ ដល់ ការប្រើប្រាស់ បច្ចេកវិទ្យា ឌីជីថល នៅ កម្រិត ផ្សេង ៗ នៃ ប្រព័ន្ធ អប់រំ ដើម្បី បង្កើត ប្រព័ន្ធ រួមបញ្ចូល បន្ថែម ទៀត ដែល ផ្តល់ ការអប់រំ ប្រកបដោយ គុណភាព សម្រាប់ កុមារ និង យុវជន ទាំងអស់ នៅក្នុង ប្រទេស កម្ពុជា » ។
កិច្ចសហប្រតិបត្តិការ ឧបត្ថម្ភ ជា យុទ្ធសាស្រ្ត នឹង ផ្តល់ ការគាំទ្រ ដល់ ការអនុវត្ត និង ការពង្រីក កម្មវិធី អប់រំ បីដូច ខាងក្រោម៖
* FLP - ជា គម្រោង ផ្តួចផ្តើម របស់ ក្រសួង អប់រំ យុវជន និង កីឡា (MoEYS) និង គាំទ្រ ដោយ ដៃគូ អភិវឌ្ឍន៍ ផ្សេង ទៀត ដើម្បី បំពាក់ បំប៉ន កម្មករ រោងចក្រ កាត់ដេរ ដែល មាន អាយុ ពី ១៥ ឆ្នាំ ដល់ ៤៥ ឆ្នាំ ឲ្យ ទទួលបាន នូវ ជំនាញ អក្ខរកម្ម មូលដ្ឋាន ដោយ ជួយ ឲ្យ ពួកគេ យល់ កាន់តែ ច្បាស់ អំពី សិទ្ធិ របស់ ខ្លួន ។ គម្រោង នេះ ក៏ មាន គោលបំណង ធ្វើឲ្យ ប្រសើរឡើង នូវ ជំនាញ នៃ ការអាន ការសរសេរ និង ជំនាញ ត្រិះរិះ ពិចារណា ដើម្បី ធ្វើឲ្យ ប្រសើរឡើង នូវ ទំនាក់ទំនង ការងារ ប្រចាំ ថ្ងៃ និង ការអនុវត្ត របស់ ពួកគេ ។
* STEPCam - ជា គម្រោង ផ្តួចផ្តើម របស់ ក្រសួង អប់រំ យុវជន និង កីឡា (MoEYS) និង គាំទ្រ ដោយ ដៃគូ អភិវឌ្ឍន៍ ផ្សេង ទៀត ដើម្បី បង្កើន គុណភាព និង សមត្ថភាព គ្រូបង្រៀន កម្រិត បឋមសិក្សា ។ គម្រោង នេះ បាន ណែនាំ នូវ វិធីសាស្រ្ត គរុកោសល្យ ថ្មី ដោយ ពាំនាំ មក នូវ ជំនាញ អប់រំ ឌីជីថល ទាន់សម័យ ដើម្បី កែលម្អ ការអប់រំ នៅ ថ្នាក់ ដំបូង ដោយ បង្កើត មូលដ្ឋានគ្រឹះ ដ៏ រឹងមាំ សម្រាប់ គុណភាព អប់រំ ទាំងមូល និង បន្ស៊ី វា ទៅនឹង តម្រូវការ នៃ សម័យ ឌីជីថល បែប ថ្មី ។
ទោះជា យ៉ាងណា ក្នុង របាយការណ៍ ថ្ងៃអង្គារ នេះ ដែរ វៀតណាម ពុំ បាន រកឃើញ ករណី អ្នកស្លាប់ ថ្មី ទៀត ទេ ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ម្ដាយ ក្មេក រដ្ឋមន្ដ្រី ខៀវ កាញារីទ្ធ
ឯកឧត្ដម លឹម គាន ហោ ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ម្ដាយ ក្មេក រដ្ឋមន្ដ្រី ខៀវ កាញារីទ្ធ
( ភ្នំពេញ ) ៖ ឯកឧត្ដម លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម និង លោកជំទាវ ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ក្រោម ឱវាទ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព មហា ឧបាសិកា កុសល ចិត្ត ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ម្ដាយ ក្មេក លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន និង ត្រូវ ជា ម្ដាយ បង្កើត លោកស្រី ទេព រង្ស៉ី ។
( ភ្នំពេញ ) ៖ អង្គការ ទីមាំ សម្រាប់ កម្ពុជា បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
( ភ្នំពេញ ) ៖ អង្គការ វេទិកា អភិវឌ្ឍន៍ ស្ត្រី និង កុមារ ពិការ ខ្មែរ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ព្រមទាំង នាយ ទាហាន នាយ ទាហាន រង និង ពល អាវុធហត្ថ ទាំងអស់ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព មហា ឧបាសិកា កុសល ចិត្ត ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ម្ដាយ ក្មេក លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន និង ត្រូវ ជា ម្ដាយ បង្កើត លោកស្រី ទេព រង្ស៉ី ។
ឯកឧត្តម ងី តា យី និង លោកជំទាវ ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជាមួយ ឯកឧត្តម ខៀវ កាញារីទ្ធ និង លោកជំទាវ ទេព រង្ស៊ី ចំពោះ មរណភាព របស់ មហា ឧបាសិកា ពេន យុត
( ភ្នំពេញ ) ៖ ឯកឧត្តម ងី តា យី រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង លោកជំទាវ បាន ផ្ញើ សារ ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ បំផុត និង សោកស្ដាយ យ៉ាង ខ្លាំង ជូន ឯកឧត្តម ខៀវ កាញារីទ្ធ និង លោកជំទាវ ទេព រង្ស៊ី ចំពោះ មរណភាព របស់ មហា ឧបាសិកា កុសល ចិត្តា ពុទ្ធសាសនូបត្ថម្ភក៍ ពេន យុត ត្រូវ ជា ម្ដាយ ម្ដាយ ក្មេក របស់ ឯកឧត្តម ខៀវ កាញារីទ្ធ និង លោកជំទាវ ទេព រង្ស៊ី ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃអង្គារ ទី៩ ខែសីហា ឆ្នាំ ២០២២ នេះ វេលា ម៉ោង ៩: ១៥នាទី ក្នុង ជន្មាយុ ៩២ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង វេលា ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ ឯកឧត្តម ងី តា យី និង លោកជំទាវ សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហា ឧបាសិកា កុសល ចិត្ដា ពុទ្ធ សនូបត្ថម្ភក៍ ពេន យុត សូម បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ យោធា អាមេរិក ស្រង់ បាន មកវិញ យន្តហោះ ចម្បាំង F-18 ដែល ធ្លាក់ ពី នាវា ផ្ទុក យន្តហោះ ចម្បាំង ចូល ទៅក្នុង សមុទ្រ កាលពី ខែកក្កដា
បទ អត្ថាធិប្បាយ៖ អ្នក ចិញ្ចឹម ត្រចៀកកាំ កម្ពុជា ត្រេកអរ ចំពោះ ការត្រៀម នាំ ទឹកមាត់ ត្រចៀកកាំ ទៅ ចិន
ឯកឧត្តម វេង សា ខុន បាន ឲ្យដឹង ថា អនុស្សរណៈ យោគយល់ គ្នា នេះ គឺ ត្រូវបាន ចុះហត្ថលេខា រវាង ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម កម្ពុជា ប្រចាំ ទីក្រុង Xiamen នៃ ខេត្ត Fujian ប្រទេស ចិន ខណៈ ដែល មជ្ឈមណ្ឌល នេះ កំពុងតែ សហការ ជាមួយ ក្រុមហ៊ុន ចិន ក្នុង ការរៀបចំ ផែនការវិនិយោគ ក្នុង ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ ប្រមូល ទិញ កែច្នៃ សំបុក ត្រចៀកកាំ នៅ កម្ពុជា ដើម្បី នាំចេញ ទៅ ប្រទេស ចិន និង មាន បំណង ផ្តល់ កិច្ចសហការ ជួយ កម្ពុជា ក្នុង ការរៀបចំ ឯកសារ ចរចា បើក ទីផ្សារ ។
ឯកឧត្តម រដ្ឋមន្ដ្រី បាន ថ្លែងអំណរគុណ ជូន ចំពោះ នាយក មជ្ឈមណ្ឌល នេះ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង សហការ ជាមួយ អគ្គ នាយកដ្ឋាន កសិកម្ម ក្នុង ការជំរុញ លើកទឹកចិត្ត និង គាំទ្រ ផលិតផល កសិកម្ម ថ្មី មួយ ទៀត គឺ ការបើក ទីផ្សារ ទឹកមាត់ ត្រចៀកកាំ កម្ពុជា ទៅកាន់ ទីផ្សារ ចិន នា ពេល អនាគត ដ៏ ខ្លី ។ ឯកឧត្តម បាន វាយតម្លៃ ខ្ពស់ លើ លទ្ធផល នៃ ការខិតខំប្រឹង ប្រែង របស់ ភាគី ទាំង ពីរ ដែល ឈាន មកដល់ ការចុះហត្ថលេខា លើ ឯកសារ MOU នា ពេលនេះ ។
ឯកឧត្តម បាន លើកឡើង ថា ទឹកមាត់ ត្រចៀក កម្ម កម្ពុជា កន្លងមក ផលិត សម្រាប់ ផ្គត់ផ្គង់ ឲ្យ ទីផ្សារ ក្នុង ស្រុក និង មាន ការនាំចេញ ក្នុង បរិមាណ តិច តូច និង ក្រៅ ផ្លូវការ ។ ឯកសារ MOU ដែល បាន ចុះហត្ថលេខា នេះ នឹង ជួយ បើក ទីផ្សារ ចិន ដែល ជា ទីផ្សារ ធំ ជាង គេ ឲ្យ ទទួលយក ផលិតផល មួយ នេះ ជា ផ្លូវការ ធានា បាន នូវ ស្តង់ដា ផលិតផល មាន គុណភាព និង សុវត្ថិភាព សម្រាប់ សុខភាព សាធារណ: ឆ្លើយតប បាន តាម លក្ខខណ្ឌ តម្រូវ ភូត គាម អនាម័យ នៃ អគ្គ នាយកដ្ឋាន គយ ចិន ។
ឯកឧត្តម បញ្ជាក់ ថា ផលិតកម្ម ទឹក មាត់ ត្រចៀកកាំ ( ការចិញ្ចឹម ) ការប្រមូល ផល ការកែច្នៃ ក៏ នឹង ត្រូវបាន លើកកម្ពស់ ឆ្លើយតប បាន តាម សេចក្តីត្រូវការ ទីផ្សារ ចិន តាម រយ : ការលើកកម្ពស់ គុណភាព ផលិត និង កែច្នៃ ស្រម តាម មតិ របស់ លោក ប្រធាន មជ្ឈមណ្ឌល បាន លើកឡើង ថា មជ្ឈមណ្ឌល នឹង បង្កើត រោងចក្រ កែច្នៃ ទឹកមាត់ ត្រចៀកកាំ នៅ កម្ពុជា នា ពេល អនាគត ដ៏ ខ្លី ។
ឯកឧត្តម រដ្ឋមន្ដ្រី បាន សាទ រ និង បង្ហាញ ឆន្ទ : គាំទ្រ លើ ដំណើរការ នៃ ការអនុវត្ត ខ្លឹមសារ MOU របស់ ភាគី ទាំង ពីរ ជាមួយ ភាគី ពាក់ព័ន្ធ ក្នុង នោះ ក៏ មាន អ្នក ចិញ្ចឹម ផងដែរ ។ ឆ្លៀត ក្នុង ឱកាស នោះ ឯកឧត្តម រដ្ឋមន្ដ្រី បាន អំពាវនាវ ដល់ អ្នក ចិញ្ចឹម ត្រចៀកកាំ សូមអញ្ជើញ មក ទាក់ទង នៅ អគ្គ នាយកដ្ឋាន កសិកម្ម ដើម្បី ទទួលបាន ព័ត៌មាន បន្ថែម ទៀត ៕
ក្រុមប្រឹក្សា ខេត្ត ព្រះសីហនុ បើក កិច្ចប្រជុំ សាមញ្ញ ក្រុមប្រឹក្សា អាណត្តិ ទី៣ លើក ទី ៣៨ ដោយ លើក យក របៀបវារៈ មួយចំនួន មក ពិនិត្យ និង ពិភាក្សា
( ព្រះសីហនុ) ៖ លោក សូ ជុង ហួរ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ព្រះសីហនុ និង លោក លៀម សុដា អភិបាល រង ខេត្ត តំណាង លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០២២ បាន ដឹកនាំ កិច្ចប្រជុំ សាមញ្ញ របស់ ក្រុមប្រឹក្សា ខេត្ត ព្រះសីហនុ អាណត្តិ ទី៣ លើក ទី ៣៨ ដោយ លើក យក របៀបវារៈ មួយចំនួន មក ពិនិត្យ និង ពិភាក្សា ។
