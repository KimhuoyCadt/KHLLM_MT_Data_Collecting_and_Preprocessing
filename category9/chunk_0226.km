( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០២២ លោក នួន ផារ័ត្ន សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា អគ្គ លេខាធិការ រង គណៈ ចលនា មហាជន រួម ជាមួយ លោក សំ រិទ្ធី អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ បាន អញ្ជើញ ជា គណៈអធិបតី ក្នុង កិច្ចប្រជុំ ចែករំលែក និង ផ្លាស់ប្តូរ បទពិសោធន៍ លើ ការងារ មូលដ្ឋាន តម្រង់ ទិស ឆ្ពោះ ទៅកាន់ ជ័យជម្នះ លើ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ ជាមួយ ក្រុមការងារ គណបក្ស ចុះ ជួយ មូលដ្ឋាន នានា នៃ ខេត្ត កំពង់ស្ពឺ ប្រមាណ ៧០០ នាក់ ។
កិច្ចប្រជុំ ដែល បាន ប្រព្រឹត្តទៅ នៅ វិមាន ៧មករា ធ្វើឡើង មាន គោលដៅ ដកស្រង់ បទពិសោធន៍ ពិភាក្សា លើ បញ្ហា ប្រឈម ដែល បាន ឆ្លងកាត់ ក្នុង ការងារ មូលដ្ឋាន កាលពី ពេល កន្លងមក ទុក ជា មេរៀន ពិសោធន៍ ដើម្បី ជោគជ័យ ក្នុង ការបោះឆ្នោត នា ពេល ខាងមុខ នេះ ។
នា ឱកាស នោះ លោក នួន ផារ័ត្ន បាន ធ្វើ ការលើកឡើង នូវ បណ្តារ ចំណុច សំខាន់ ដែល ក្រុមការងារ គណបក្ស មូលដ្ឋាន ត្រូវ ប្រកាន់ខ្ជាប់ និង ពង្រឹង ដើម្បី ប្រៀប ឈ្នះ របស់ គណបក្ស លើ ការបោះឆ្នោត គ្រប់ នីតិកាល និង គ្រប់ ការបោះឆ្នោត ។
ជាមួយគ្នា នោះ លោក សំ រិទ្ធី ជំនួស មុខ ឲ្យ ក្រុមការងារ ទាំងអស់ បាន ថ្លែងអំណរគុណ ដល់ លោក នួន ផារ័ត្ន ដែល បាន ចំណាយ ពេល ដ៏ មាន តម្លៃ ចូលរួម ចែករំលែក បទពិសោធន៍ និង ពុទ្ធិ ល្អ ៗ ដល់ ក្រុមការងារ ដើម្បី យក ទៅ អនុវត្ត នៅ តាម មូលដ្ឋាន រៀង ៗ ខ្លួន ៕
ប្រជាពលរដ្ឋ នៅក្នុង ស្រុក ព្រៃ កប្បាស ខេត្ត តាកែវ បាន ទទួល ការព្យាបាល ដោយ ឥត គិត ថ្លៃ ពីសំណាក់ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ (TYDA) ជា លើក ទី៦
( តាកែវ )៖ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្ដេច តេជោ (TYDA) បាន ចុះ ព្យាបាល ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ ពោធ៍ រំចាក ស្រុក ព្រៃ កប្បាស ខេត្ត តាកែវ ដោយ មាន ការចូលរួម ជាមួយ ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ឃុំ និង ថត ស្រុក ព្រៃ កប្បាស អាជ្ញាធរដែនដី យុវជន និស្សិត សមាគម អាហារូបករណ៍ អ. ម. ត និង ផ្នែក ដែល ពាក់ព័ន្ធ ជាច្រើន ទៀត នៅ ព្រឹក ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០២២ ។
( ភ្នំពេញ ) ៖ នៅ យប់ ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០២២ លោក ជា ខេមា អភិបាល ខណ្ឌ ដូនពេញ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ប្រជាការពារ ខណ្ឌ ដើម្បី ពង្រឹង កិច្ចការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ អនាម័យ និង បរិស្ថាន ជូន បងប្អូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ខណ្ឌ ដូនពេញ ។
ក្នុង ពិធី សំណេះសំណាល នេះ លោក អភិបាល ខណ្ឌ ក៏ បាន កាត់ សម្លៀកបំពាក់ ជូន បងប្អូន ប្រជាការពារ ក្នុង ម្នាក់ ពីរ កំប្លេ សរុប ជា ទឹកប្រាក់ អស់ ៦៥៨០ ដុល្លារ ដែល ជា ថវិកា ផ្ទាល់ របស់ លោក អភិបាល ផងដែរ ។
សូម បញ្ជាក់ ថា ខណ្ឌ ដូនពេញ ត្រូវបាន គេ ចាត់ទុក ជា ទឹកដី ដែល ប្រមូលផ្តុំ ទៅ ដោយ ការតវ៉ា និង មមាញឹក នៃ ការសកម្មភាព ផ្សេង ៗ ពិសេស កិច្ចប្រជុំ ធំ ៗ និង ការស្នាក់នៅ របស់ ថ្នាក់ដឹកនាំ បរទេស ពេល មក ចូល ប្រជុំ ដែល ជា ហេតុ ធ្វើឲ្យ មាន ការ ពង្រឹង សន្តិសុខ និង សណ្តាប់ធ្នាប់ យ៉ាង ខ្លាំង ។
ដោយឡែក ការតវ៉ា របស់ បងប្អូន ប្រជាពលរដ្ឋ ចំពោះ រឿង ដីធ្លី និង បញ្ហា ផ្សេង ៗ នៅ តាម ខេត្ត នោះ វិញ ក៏ ភាគ ច្រើន មក ដាក់ ពាក្យសុំ កិច្ចអន្តរាគមន៍ នៅក្នុង ទឹកដី ខណ្ឌ ដូនពេញ ដូចជា នៅ ខុទ្ទកាល័យ សម្តេច តេជោ ក្រសួង យុត្តិធម៌ និង រដ្ឋសភា ជាដើម ។ ស្ថានភាព បែប នេះ ហើយ ទើប មន្រ្តី រាជការ និង សមត្ថកិច្ច មួយចំនួន ខ្លះ នៅ ខណ្ឌ ដូនពេញ តែងតែ និយាយ ថា ខណ្ឌ ដូនពេញ ជា កន្លែង ល្អ មើល តែ មិន ល្អ ស៊ី ៕
លោក អ៊ុន ចាន់ ដា ណែនាំឱ្យ ក្រុមប្រឹក្សា ឃុំ នានា នៅ ស្រុក បាធាយ ខិតខំ ធ្វើ អំពី ល្អ ជាមួយ ពលរដ្ឋ ដើម្បី ឈ្នះ ការបោះឆ្នោត ពេល ខាងមុខ ទៀត
( កំពង់ចាម ) ៖ ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ណែនាំ ឱ្យ ក្រុមប្រឹក្សា ឃុំ ទើប ជាប់ ឆ្នោត ក្នុង ស្រុក បាធាយ រួម ជាមួយ មន្ត្រី ពាក់ព័ន្ធ ខិតខំ ធ្វើ អំពើ ល្អ ជាមួយ ប្រជាពលរដ្ឋ ដើម្បី ភាព ឈ្នះ នៃ ការបោះឆ្នោត អាណត្តិ ខាងមុខ ទៀត ។
លោក ប្រធានបក្ស បាន លើកឡើង ដូច្នេះ នៅ រសៀល ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០២២ ក្នុង ពេល អញ្ជើញ បិទ វគ្គ បំប៉ន សមាជិក បក្ស ថ្នាក់ មូលដ្ឋាន ឃុំ នៅ ស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក បាធាយ ។
លោក អ៊ុន ចាន់ ដា បាន ថ្លែង បន្ត ថា អាជ្ញាធរ មូលដ្ឋាន ថ្នាក់ ឃុំ ត្រូវ ផ្ដល់ សេវា សាធារណៈ ដល់ ប្រជាពលរដ្ឋ ជាពិសេស សេវា រដ្ឋបាល ត្រូវ ប្រកបដោយ គុណភាព តម្លាភាព និង ទទួលបាន ជំនឿ ទុកចិត្ត ។ គ្មាន បទល្មើស លួច ឆក់ ប្លន់ គ្រឿងញៀន ល្បែងស៊ីសង ខុស ច្បាប់ រៀបចំ សណ្ដាប់ធ្នាប់ សាធារណៈ ល្អ គ្មាន គ្រោះថ្នាក់ ចរាចរណ៍ គ្មាន អំពើ អនាចារ គ្មាន ការជួញដូរ មនុស្ស ស្ត្រី និង កុមារ គ្មាន អំពើហិង្សា ក្នុង គ្រួសារ គ្មាន ក្មេង ទំនើង ត្រូវ ដោះស្រាយ វិវាទ នៅ មូលដ្ឋាន ក្រៅ ប្រព័ន្ធ តុលាការ ប្រកបដោយ គុណភាព និង ប្រសិទ្ធភាព ។
ត្រូវ មាន អនាម័យ មាន សោភ័ណភាព និង បរិស្ថាន ល្អ ឆ្លើយតប បាន ទាន់ ពេលវេលា ចំពោះ គ្រោះមហន្តរាយ និង ផ្សព្វផ្សាយ ការពារ រាល់ ជំងឺ ឆ្លង រាតត្បាត កាច សាហាវ ប្រកបដោយ ប្រសិទ្ធភាព ។
លោក អ៊ុន ចាន់ ដា បាន បញ្ជាក់ ថា ក្នុង នាម យើង ជា មន្រ្តី អនុវត្ត ច្បាប់ និង ជា អ្នក អនុវត្ត ផ្ទាល់ រាល់ កិច្ចការ ទាក់ទង ទៅ នឹង គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព យើង ចាំបាច់ ត្រូវតែ ដឹង អំពី ការងារ របស់ ខ្លួន និង អនុវត្ត ឱ្យ បាន ល្អ ដើម្បី ផ្ដល់ សេចក្តីសុខ ដល់ ប្រជាពលរដ្ឋ នឹង ទទួលបាន ទំនុកចិត្ត ពី ប្រជាពលរដ្ឋ ៕ កុំ ឲ្យ ថ្ងៃ សប្បាយ ក្លាយជា ទុក្ខ ដោយសារ ការបើកបរ របស់ អ្នក ! ស្លាប់ ៣នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ១០នាក់ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃសៅរ៍ ទី២០ ខែសីហា ឆ្នាំ ២០២២ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដូច្នេះ សូម ទស្សនា ដូច ខាងក្រោម៖
២៖ អង់គ្លេស ថា រុស្ស៉ី មិន មាន សិទ្ធិ ខាង សីលធម៌ ដើម្បី ចូលរួម កិច្ចប្រជុំ កំពូល G20 ឡើយ
៣៖ របាយការណ៍៖ ជំនួយ យោធា របស់ អឺរ៉ុប សម្រាប់ អ៊ុយក្រែន ធ្លាក់ចុះ តាំងពី ដើម ខែមេសា មក
៤៖ នាយក រដ្ឋមន្រ្តី ហ្វាំងឡង់ ធ្វើតេស្ត រក សារធាតុ ញៀន ក្រោយ បែក ធ្លាយ វីដេអូ រាំ
៥៖ តៃវ៉ាន់ អះអាង ថា ចិន បន្ត ប្រតិបត្តិការ យោធា ក្បែរ ដែន ទឹក របស់ ខ្លួន
៦៖ ឥណ្ឌូណេស៉ី បញ្ជាក់ ពី ករណី ជំងឺ អុត ស្វា លើក ដំបូង លើ ពលរដ្ឋ ត្រឡប់ មកពី បរទេស ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ចាម ណែនាំឲ្យ ក្រុមប្រឹក្សា ឃុំ ទើប ជាប់ ឆ្នោត ក្នុង ស្រុក បាធាយ ខិតខំ ធ្វើ អំពី ល្អ ជាមួយ ប្រជាពលរដ្ឋ ដើម្បី ភាព ឈ្នះ នៃ ការបោះឆ្នោត ពេល ខាងមុខ
( កំពង់ចាម ) ៖ ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ណែនាំឲ្យ ក្រុមប្រឹក្សា ឃុំ ទើប ជាប់ ឆ្នោត ក្នុង ស្រុក បាធាយ រួម ជាមួយ មន្ត្រី ពាក់ព័ន្ធ ត្រូវ ខិតខំ ធ្វើ អំពើ ល្អ ជាមួយ ប្រជាពលរដ្ឋ ដើម្បី ភាព ឈ្នះ នៃ ការបោះឆ្នោត អាណត្តិ ខាងមុខ ទៀត ។
លោក អ៊ុន ចាន់ ដា បាន ថ្លែង បន្ត ថា អាជ្ញាធរ មូលដ្ឋាន ថ្នាក់ ឃុំ ត្រូវ ផ្ដល់ សេវា សាធារណៈ ដល់ ប្រជាពលរដ្ឋ ជាពិសេស សេវា រដ្ឋបាល ត្រូវ ប្រកបដោយ គុណភាព តម្លាភាព និង ទទួលបាន ជំនឿ ទុកចិត្ត ។ គ្មាន បទល្មើស លួច ឆក់ ប្លន់ គ្រឿងញៀន ល្បែងស៊ីសង ខុស ច្បាប់ រៀបចំ សណ្ដាប់ធ្នាប់ សាធារណៈ ល្អ គ្មាន គ្រោះថ្នាក់ ចរាចរណ៍ គ្មាន អំពើ អនាចារ គ្មាន ការជួញដូរ មនុស្ស ស្ត្រី និង កុមារ គ្មាន អំពើហឹង្សា ក្នុង គ្រួសារ គ្មាន ក្មេង ទំនើង ត្រូវ ដោះស្រាយ វិវាទ នៅ មូលដ្ឋាន ក្រៅ ប្រព័ន្ធ តុលាការ ប្រកបដោយ គុណភាព និង ប្រសិទ្ធភាព ។
ត្រូវ មាន អនាម័យ មាន សោភ័ណភាព និង បរិស្ថាន ល្អ ឆ្លើយតប បាន ទាន់ ពេលវេលា ចំពោះ គ្រោះមហន្តរាយ និង ផ្សព្វផ្សាយ ការពារ រាល់ ជំងឺ ឆ្លង រាតត្បាត កាច សាហាវ ប្រកបដោយ ប្រសិទ្ធភាព ។
លោក អ៊ុន ចាន់ ដា បាន បញ្ជាក់ ថា ក្នុង នាម យើង ជា មន្រ្តី អនុវត្ត ច្បាប់ និង ជា អ្នក អនុវត្ត ផ្ទាល់ រាល់ កិច្ចការ ទាក់ទង ទៅ នឹង គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព យើង ចាំបាច់ ត្រូវតែ ដឹង អំពី ការងារ របស់ ខ្លួន និង អនុវត្ត ឱ្យ បាន ល្អ ដើម្បី ផ្ដល់ សេចក្តីសុខ ដល់ ប្រជាពលរដ្ឋ នឹង ទទួលបាន ទំនុកចិត្ត ពី ប្រជាពលរដ្ឋ ៕
គួរ បញ្ជាក់ ថា នៅ ថ្ងៃទី ២០ ខែសីហា នេះ អនុគណៈកម្មាធិការ ជាតិ ដឹកនាំ សម្រាប់ ការបង្ការ និង ត្រួតពិនិត្យ ជំងឺ កូវីដ - ១៩ របស់ ប្រទេស វៀតណាម បាន ប្រកាស ពី អ្នកស្លាប់ ដោយសារ កូវីដ ១៩ ចំនួន ៣៩០ នាក់ បន្ថែម ទៀត ដែល ធ្វើឲ្យ ចំនួន អ្នកស្លាប់ សរុប កើនឡើង ដល់ ៧. ៥៤០ នាក់ ៕
ចំណេះដឹង ទូទៅ៖ ប្រទេស ទាំង១០ ដែល មាន ភ្ញៀវ អន្តរជាតិ ទៅ ទស្សនា ច្រើន បំផុត
( ភ្នំពេញ ) ៖ កាលពី ក្នុង ឆ្នាំ ២០១៩ វិស័យ ទេសចរណ៍ អន្តរជាតិ គឺជា ឧស្សាហកម្ម មាន ទំហំ រហូតដល់ទៅ ៨. ៩ទ្រី លាន ដុល្លារ អាមេរិក ។ យ៉ាងណា ក្តី ការរាតត្បាត នៃ ជំងឺ ឆ្លង កូវីដ១៩ ដែល បាន ផ្ទុះឡើង កាលពី ចុង ឆ្នាំ ២០១៩ បាន ធ្វើឱ្យ តួលេខ នោះ មាន ការថយចុះ ជាខ្លាំង នៅ ឆ្នាំ ២០២០ - ២០២១ ។
ខាងក្រោម នេះ ជា ប្រទេស ទាំង១០ ដែល ទទួលបាន ទេសចរ អន្តរជាតិ ច្រើន ជា ទីបំផុត កាលពី ឆ្នាំ ២០១៩៖
សម្រាប់ ឆ្នាំ ២០២២ វិញ សកម្មភាព ទេសចរណ៍ របស់ ពិភពលោក បាន ប្រសើរឡើង គួរឱ្យ កត់សម្គាល់ ធៀប នឹង ២ឆ្នាំ កន្លងមក នេះ ប៉ុន្តែ បើ តាម ការព្យាករណ៍ ភាគ ច្រើន ឧស្សាហកម្ម ទេសចរណ៍ អន្តរជាតិ ហាក់ នឹង មិន ទាន់ អាច វិលត្រឡប់ ទៅ រក ស្ថានភាព ដូច កាលពី ឆ្នាំ ២០១៩ ឡើយ រហូត ទាល់តែ ដល់ យ៉ាងហោចណាស់ ក៏ ឆ្នាំ ២០២៣ ដែរ ៕
តៃវ៉ាន់ អះអាង ថា ចិន បន្ត ប្រតិបត្តិការ យោធា ក្បែរ ដែន ទឹក របស់ ខ្លួន
( តៃ ប៉ិ) ៖ ក្រសួង ការពារ ជាតិ តៃវ៉ាន់ បាន ឲ្យដឹង ថា យន្តហោះ ចិន ចម្បាំង ចំនួន ១៧គ្រឿង និង នាវា ចំនួន ៥គ្រឿង ត្រូវបាន រកឃើញ ថា កំពុង ធ្វើ ប្រតិបត្តិការ ជុំវិញ កោះ តៃវ៉ាន់ នៅ ថ្ងៃសៅរ៍ នេះ ខណៈ ដែល ទីក្រុង ប៉េកាំង បន្ត សកម្មភាព យោធា នៅជិត ដែន កោះ នេះ ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយ ទីភ្នាក់ងាសារព័ត៌មាន Reuters នៅ ថ្ងៃសៅរ៍ ទី២០ ខែសីហា ឆ្នាំ ២០២២ ។
ក្រសួង ការពារ ជាតិ តៃវ៉ាន់ បាន បន្ថែម ថា ប្រតិបត្តិការ ខាងលើ នេះ ក៏ រួមបញ្ចូល ទាំង យន្តហោះ ចំនួន ៤គ្រឿង ដែល ហោះ ឆ្លងកាត់ ខ្សែ បន្ទាត់ មេដ្យាន នៃ ច្រក សមុទ្រ តៃវ៉ាន់ ផងដែរ ។
សូម បញ្ជាក់ ថា មហាសន្និបាត អភិវឌ្ឍ ការអប់រំ ជំនាញ វិជ្ជាជីវៈ សកលលោក បាន សម្ពោធ បើក នៅ ទីក្រុង Tianjin ប្រទេស ចិន នៅ ថ្ងៃ ដដែល ដែល ក្រោម ប្រធានបទ « ការអភិវឌ្ឍ ការអប់រំ ជំនាញ វិជ្ជាជីវៈ ក្រោយ ជំងឺ ឆ្លង៖ ការប្រែប្រួល ថ្មី វិធីសាស្ត្រ ថ្មី សមត្ថភាព ថ្មី »៕
កាសែត បាងកក ប៉ុស្តិ៍ បាន រាយការណ៍ ថា បន្ទាប់ពី បញ្ចប់ កិច្ចប្រជុំ ក្រុមការងារ ទេសចរណ៍ របស់ វេទិកា កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច អាស៊ី ប៉ាស៊ីហ្វិក (APEC) លើក ទី៦០ និង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ទេសចរណ៍ APEC លើក ទី ១១ នៅ ថ្ងៃសុក្រ ក្នុង ទីក្រុង បាងកក រដ្ឋាភិបាល ថៃ បាន ចេញ សេចក្តីថ្លែងការណ៍ ស្តីពី « ទេសចរណ៍ នៃ អនាគត៖ ទេសចរណ៍ បង្កើតឡើងវិញ » ដែល បង្ហាញ ពី កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស និង តំបន់ សេដ្ឋកិច្ច ចំនួន ២១ ។
លោក Phiphat បាន និយាយ ថា ប្រទេស ជា សមាជិក បាន យល់ព្រម ធ្វើឱ្យ ប្រសើរឡើង នូវ កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច ដែល អនុញ្ញាតឱ្យ មាន លំហូរ ទំនិញ ការវិនិយោគ និង ប្រជាជន កាន់តែ ប្រសើរឡើង ដើម្បី ជំរុញ ការងើប ឡើងវិញ នៃ វិស័យ ទេសចរណ៍ ។
ទោះជា យ៉ាងណា ការឯកភាព ជា រួម មិន អាច សម្រេចបាន ទេ នៅក្នុង កិច្ចប្រជុំ នេះ ដោយសារ មាន ការខ្វែងគំនិត គ្នា មួយចំនួន លើ ចំណុច ជាក់លាក់ នានា ដូច្នេះ ការបិទ បញ្ចប់ កិច្ចប្រជុំ ត្រូវបាន ចេញ ជា « សេចក្តីថ្លែងការណ៍ របស់ ប្រធាន កិច្ចប្រជុំ » ជំនួស វិញ ។
ទន្ទឹមនឹង នេះ ក្រុមការងារ ទេសចរណ៍ APEC នឹង បន្ត ផែនការ យុទ្ធសាស្ត្រ ឆ្នាំ ២០២០ - ២០២៤ ដែល ផ្តោត លើស សរ ស្តម្ភ ចំនួន បួន៖ ការផ្លាស់ប្តូរ ទៅជា ឌីជីថល ការអភិវឌ្ឍ មូលធន មនុស្ស ការសម្រួល ការធ្វើដំណើរ និង ការប្រកួតប្រជែង និង ទេសចរណ៍ ប្រកបដោយ និរន្តរភាព និង កំណើន សេដ្ឋកិច្ច ។ នេះ បើ យោង តាម កាសែត បាងកក ប៉ុស្តិ៍ ៕
ប្រជាជន អាស៊ី អាគ្នេយ៍ ចំណាយ ៣. ៦៦ប៊ីលាន ដុល្លារ លើ តែ គជ់ ក្នុង មួយ ឆ្នាំ
ទីផ្សារ ធំ ជាង គេ ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ គឺ ប្រទេស ឥណ្ឌូនេស៊ី ដែល មាន ប្រាក់ ចំណូល ប្រចាំ ឆ្នាំ ប្រមាណ ១.៦ប៊ីលាន ដុល្លារ ។ ប្រទេស ថៃ ជាប់ ចំណាត់ថ្នាក់ លេខ ពីរ ដែល មាន ទឹកប្រាក់ ៧៤៩ លាន ដុល្លារ ដោយ មាន ហាង និង បណ្តាញ លក់ រាយ តែ គជ់ ជាង ៣១ ០០០ ហាង ។
ប្រទេស វៀតណាម ជាប់ ចំណាត់ថ្នាក់ លេខ បី ដែល មាន ទឹកប្រាក់ ៣៦២ លាន ដុល្លារ ហើយ ប្រទេស សិង្ហបុរី ជាប់ ចំណាត់ថ្នាក់ លេខ ៤ មាន ចំនួន ៣៤២ លាន ដុល្លារ ។
ការស្រាវជ្រាវ នេះ បាន រកឃើញ ថា តែ គជ់ ម៉ាក យីហោ របស់ កោះ តៃវ៉ាន់ និង ក្នុង ស្រុក បាន គ្រប់គ្រង ទីផ្សារ តែ គជ់ អាស៊ី អាគ្នេយ៍ ជា យូរ មកហើយ ។
ការសិក្សា នេះ បាន ឱ្យដឹង ទៀត ថា៖ « លើស ពី នេះ ថ្មី ៗ នេះ តែ គជ់ ម៉ាក យីហោ របស់ ប្រទេស ចិន ជាច្រើន បាន ចូលក្នុង តំបន់ ។ ទីផ្សារ តែ គជ់ នៅក្នុង ប្រទេស ចិន ត្រូវបាន គេ ប៉ាន់ប្រមាណ ថា មាន ប្រាក់ ចំណូល ប្រចាំ ឆ្នាំ ចំនួន ២០ប៊ីលាន ដុល្លារ ដែល មាន ភាពចង្អៀត និង ប្រកួតប្រជែង ខ្លាំង » ។
បកស្រាយ អំពី បម្រែបម្រួល របស់ ចិន ក្នុង រយៈពេល ១០ឆ្នាំ កន្លងទៅ ឆ្លង ភ្នំ កាត់ ជ្រោះ ក្រាល ផ្លូវ រថភ្លើង នៅ តំបន់ ឆ្ងាយ ដាច់ស្រយាល
ក្នុង រយៈពេល ១០ឆ្នាំ ចុងក្រោយ នេះ ប្រទេស ចិន បាន ដាក់ ឱ្យ ប្រើប្រាស់ នូវ ឡាន សាធារណៈ នៅ ភូមិ ចំនួន ជាង ៥ម៉ឺន ជាង នេះ ទៅ ទៀត ប្រវែង ផ្លូវ ដែក ល្បឿន លឿន ដែល បាន សាងសង់ រួច នៅ តំបន់ ភាគ ខាងលិច ប្រទេស ចិន បាន ឡើង ដល់ ៦ម៉ឺន គីឡូម៉ែត្រ ត្រូវ ជា ៤០ ភាគរយ នៃ ប្រវែង សរុប របស់ ប្រទេស ចិន ។
( ព្រះសីហនុ) ៖ នៅ ល្ងាច ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២២ លោក គួច ចំរើន អភិបាល នៃ គណៈអភិបាល ខេត្ត ព្រះសីហនុ ជួប ពិភាក្សា ការងារ ជាមួយ លោក វិទិត មុត តាបន អ្នក រាយការណ៍ ពិសេស របស់ អង្គការ សហ ប្រជាជាតិ ស្តីពី សិទ្ធិ មនុស្ស ប្រចាំ ប្រទេស កម្ពុជា ។
កិច្ចពិភាក្សា ចាប់ផ្តើម លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន ថ្លែង ស្វាគមន៍ គណៈប្រតិភូ អ្នក រាយការណ៍ ពិសេស របស់ អង្គការ សហ ប្រជាជាតិ ស្តីពី សិទ្ធិ មនុស្ស ប្រចាំ ប្រទេស កម្ពុជា ដែល បាន មក ទស្សនកិច្ច នៅ ខេត្ត ព្រះសីហនុ និង បាន ជម្រាប ជូន ពី ភូមិសាស្រ្ត ខេត្ត ព្រះសីហនុ និង ការអភិវឌ្ឍន៍ នានា ជាពិសេស ភាព រីកចម្រើន របស់ ខេត្ត នា រយៈពេល ចុងក្រោយ នេះ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក វិទិត មុត តាបន អ្នក រាយការណ៍ ពិសេស របស់ អង្គការ សហ ប្រជាជាតិ ស្តីពី សិទ្ធិ មនុស្ស ប្រចាំ ប្រទេស កម្ពុជា បាន ថ្លែងអំណរគុណ អភិបាល ខេត្ត ដែល បាន ឱ្យ ប្រតិភូ របស់ លោក សិក្សា ឈ្វេងយល់ អំពី កង្វល់ និង បញ្ហា ប្រឈម នានា ដើម្បី រក វិធី ដោះស្រាយ ឱ្យ បាន ទាន់ ពេលវេលា ក្នុង នោះ មាន ដូចជា ស្ថានភាព សិទ្ធិ មនុស្ស . ការបង្ខិតបង្ខំឱ្យ ប្រព្រឹត្ត បទល្មើស . ការជួញដូរ មនុស្ស . ឧក្រិដ្ឋកម្ម តាម ប្រព័ន្ធ អ៊ីនធើណេត . ការបោកប្រាស់ តាម ប្រព័ន្ធ អនឡាញ និង ស្ថានភាព ជនរងគ្រោះ ដែល ត្រូវបាន ជួយ សង្គ្រោះ ជាដើម ។
ជាមួយគ្នា នេះ លោក គួច ចំរើន បាន ជម្រាប ជូន លោក វិទិត មុត តាបន ថា កម្ពុជា មាន រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ជាច្រើន ទាក់ទង នឹង សិទ្ធិ មនុស្ស ការជួញដូរ មនុស្ស ឧក្រិដ្ឋកម្ម តាម ប្រព័ន្ធ អ៊ីនធើណេត និង ការបោកប្រាស់ តាម ប្រព័ន្ធ អនឡាញ ជាដើម ហើយ ធ្វើ ការប្រយុទ្ធ ប្រឆាំង ចំពោះ បញ្ហា នេះ ផងដែរ ។ រាជ រដ្ឋាភិបាល កម្ពុជា មាន ការប្តេជ្ញាចិត្ត ខ្ពស់ ប្រឆាំង អំពើ ទាំងឡាយ ណា ដែល ល្មើស នឹង ច្បាប់ កម្ពុជា និង បទដ្ឋាន គតិយុត្ត នានា របស់ អន្តរជាតិ ។
អភិបាល ខេត្ត បាន អះអាង ទៀត ថា អាជ្ញាធរ ខេត្ត ព្រះសីហនុ គ្រប់ ជាន់ ថ្នាក់ មិន ដែល គេចវេស ពី តួនាទី របស់ ខ្លួន នោះ ឡើយ ពោលគឺ យើង សហការ គ្នា អនុវត្ត ច្បាប់ និង បង្រ្កាប រាល់ បទល្មើស ដោយ គ្មាន ការបន្ធូរ ដៃ ឡើយ ។ ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត សូមស្វាគមន៍ គ្រប់ ភាគី ពាក់ព័ន្ធ និង បណ្តា ស្ថានទូត ប្រទេស នានា ជា មិត្ត ក្នុង ការសហការ ស្វែងរក ឬ សគល់ នៃ បទល្មើស ដើម្បី ឈាន ទៅដល់ ការបង្ក្រាប ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ។
លោក បាន ជម្រាប ជូន ថា កន្លងមក ប្រទេស កម្ពុជា និង ប្រទេស ថៃ មាន លំហូរ ពលករ ខុស ច្បាប់ ទៅ វិញ ទៅ មក ហើយ មាន ពលករ ខ្មែរ ទៅ ធ្វើ ការប្រទេស ថៃ និង ក៏ មាន ពលករ ថៃ មក ធ្វើការ នៅ ប្រទេស កម្ពុជា ពិសេស ក្នុង ខេត្ត ព្រះសីហនុ តាមរយៈ ការអូសទាញ ដោយ ខុស ច្បាប់ ។ លោក គួច ចំរើន បាន ថ្លែង ថា « ២០ ឆ្នាំ មុន ពលរដ្ឋ ខ្មែរ ជាច្រើន នាក់ រង ការធ្វើ ទុក្ខបុកម្នេញ ឬ ជួញដូរ នៅ ថៃ ម៉ាឡេស៊ី តៃវ៉ាន់ ចិន យើង ជា ខ្មែរ មាន ការឈឺចាប់ ។ ដូច្នេះ សម្រាប់ នៅ កម្ពុជា យើង មិន ឱ្យ ការឈឺចាប់ នេះ កើតមាន ទៀត នោះ ឡើយ » ។
លោក វិទិត មុត តាបន សម្តែង ការគាំទ្រ ចំពោះ ដំណើរការ សិទ្ធិ មនុស្ស នៅ កម្ពុជា និង ចង់ ដឹង អំពី ស្ថានភាព ទូទៅ ក្នុង ខេត្ត ព្រះសីហនុ ទាក់ទង នឹង សិទ្ធិ មនុស្ស ការជួញដូរ មនុស្ស ឧក្រិដ្ឋកម្ម តាម ប្រព័ន្ធ អ៊ីនធើណេត និង ការបោកប្រាស់ តាម ប្រព័ន្ធ អនឡាញ ជាដើម ដើម្បី រក វិធី ដោះស្រាយ បាន ទាន់ ពេល វេលា ។
មួយ គ្នា នេះ អភិបាល ខេត្ត ក៏ បាន លើកឡើង ថា ស្ថានភាព ជាក់ស្តែង នៅ ខេត្ត ព្រះសីហនុ គឺ ខុសពី អ្វី ដែល ប្រព័ន្ធ ផ្សព្វផ្សាយ មួយចំនួន បាន ផ្សព្វផ្សាយ ដូច្នេះ ឯកឧត្តម សំណូមពរ ដល់ ប្រតិភូ សូម កត់ត្រា អ្វី ដែល ជា ការពិត និង សូម ជូនពរ ដល់ ដំណើរទស្សនកិច្ច របស់ ប្រតិភូ អ្នក រាយការណ៍ ពិសេស របស់ អង្គការ សហ ប្រជាជាតិ ស្តីពី សិទ្ធិ មនុស្ស ប្រចាំ ប្រទេស កម្ពុជា នៅ ខេត្ត ព្រះសីហនុ ទទួលបាន ជោគជ័យ និង ភាពរីករាយ ៕
បើ ទោះ នេះ ជា មេរៀន បំពេញ បន្ថែម សម្រាប់ វគ្គ សរសេរ ព័ត៌មាន ក្ដៅ ពិត មែន តែ លោក ម៉ារ យ៉ារិទ្ធ បាន បង្ហាញ អំពី ចំណុច សំខាន់ និង គ្រឹះ នៃ ការសរសេរ បទ វិចារណក ថា និង បទ អត្ថាធិប្បាយ ដល់ សិក្ខាកាម ជាច្រើន ចំណុច ផងដែរ ។
នៅក្នុង នោះ ប្រធាន មជ្ឈមណ្ឌល ខាងលើ បាន ឲ្យដឹង ថា៖ « អត្ថបទ អត្ថាធិប្បាយ គឺជា អត្ថបទ ដែល ផ្តោត លើ គំនិត របស់ អ្នក ប៉ុន្តែ មិន មែន ផ្តោត លើ អ្នកទេ ។ និយមន័យ នៃ អត្ថបទ អត្ថាធិប្បាយ អាច ត្រូវ ធ្វើឲ្យ គេ យល់ កាន់តែ ច្បាស់ ពី ភាពពាក់ព័ន្ធ គ្នា ផ្សេង ៗ ក្នុង នោះ គឺ អត្ថាធិប្បាយ អំពី រឿង ចេញមក ពី បទពិសោធន៍ ដែល ធ្លាប់ មាន ធ្លាប់ ឆ្លងកាត់ និង ការអត្ថាធិប្បាយ សង្គម ទាក់ទង នឹង ការងារ សិល្បៈ ឬ ព្រឹត្តិការណ៍ ទ្រង់ទ្រាយ ធំ » ។
ខណៈ ដែល បទ វិចារណក ថា គឺជា អត្ថបទ ដែល បង្ហាញ ពី គំនិត របស់ កាសែត លើ បញ្ហា មួយ លោក ម៉ារ យ៉ារិទ្ធ បាន បញ្ជាក់ បន្ថែម ថា វិចារណក ថា គឺជា អត្ថបទ ដែល ត្រូវ តែ មាន ឯកភាព ពី ក្រុមប្រឹក្សាភិបាល ។ ក្រុមប្រឹក្សាភិបាល នេះ គឺជា ស្ថាប័ន គ្រប់គ្រង របស់ កាសែត ដែល បង្កើត ឡើង ដោយ និពន្ធ នាយក និង អ្នកគ្រប់គ្រង អាជីវកម្ម ។
លោក ថា អ្នក សរសេរ វិចារណក ថា ត្រូវ លើក នូវ ទស្សនៈ មួយ ដែល យើង គិត ថា ត្រឹមត្រូវ ការសរសេរ ត្រូវ មាន អំណះអំណាង ។ ការសរសេរ ត្រូវ ព្យាយាម បញ្ចុះបញ្ចូល អ្នកអាន ឱ្យ គិត តាម របៀប ដែល យើង យល់ ដើម្បីឱ្យ គេ គិត យល់ ដូចគ្នា ។
« ការសរសេរ វិចារណក ថា គឺ សំដៅ ចង់ បង្កើន ឥទ្ធិពល លើ មតិ សាធារណៈ លើក តំកើង គំនិត រិះគន់ និង ជួនកាល ធ្វើឱ្យ មនុស្ស ចាត់ វិធានការ លើ បញ្ហា អ្វី មួយ ។ សរុប មកវិញ បទ វិចារណក ថា គឺជា រឿងរ៉ាវ ដែល សរសេរ ផ្អែក លើ ទស្សនៈ របស់ ខ្លួន »។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ អ្នកជំនាញ សារព័ត៌មាន ជាង ៣០ ឆ្នាំ ។
ទាំងអស់ នេះ គ្រាន់តែ ជា ផ្នែក មួយ ដែល ដកស្រង់ ពី ចំណុច ដែល លោក ម៉ារ យ៉ារិទ្ធ បាន លើក មក ពន្យល់ ដល់ សិក្ខាកាម ប៉ុណ្ណោះ ។ នៅ មាន ចំណុច ជាច្រើន ទៀត ដែល លោក ម៉ារ យ៉ារិទ្ធ បាន បង្ហាញ ទៅដល់ សិក្ខាកាម ។
នៅ វគ្គ ក្រោយ ៗ ទៀត «FTC» នឹង បណ្ដុះបណ្ដាល អំពី ការសរសេរ ព័ត៌មាន ស៊ីជម្រៅ បទ យក ការណ៍ បទពិព័ណ៌នា បទ វិចារណក ថា និង បទ អត្ថាធិប្បាយ បន្ថែម ទៀត ដើម្បី បម្រើ ដល់ សេចក្ដីត្រូវការ របស់ សិក្ខាកាម ជាពិសេស សម្រាប់ អ្នក ដែល ចង់ ចាប់ ជំនាញ ផ្នែក សារព័ត៌មាន ។
សូម បញ្ជាក់ ផងដែរ ថា «FTC» បាន បង្កើតឡើង នៅ ខែកញ្ញា ឆ្នាំ ២០២១ ក្រោម គំនិត ផ្ដួច ផ្ដើម របស់ លោក លឹម ជា វុត្ថា ដើម្បី ចូលរួម ចែករំលែក ចំណេះដឹង និង បទពិសោធន៍ ផ្នែក ព័ត៌មាន ដល់ យុវជន ជំនាន់ ក្រោយ ក្នុង វិស័យ ព័ត៌មាន ។
បណ្ឌិត ហ៊ុន ម៉ាណែត៖ ស្មារតី នៃ វប្បធម៌ និង ប្រពៃណី ចែករំលែក ពីសំណាក់ ពលរដ្ឋ ទាំង ក្នុង និង ក្រៅ ប្រទេស បាន ជួយ ដល់ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ យកឈ្នះ ជំងឺ កូវីដ១៩
ការលើកឡើង បែប នេះ រ បស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង នៅក្នុង ឱកាស លោក អញ្ជើញ ពិសារ អាហារ សាមគ្គី ជាមួយ សមាគម សិល្បៈ វប្បធម៌ ខែ្មរ . សមាគម ឱសថស្ថាន (NEXTY PHARM) និង សមាគម គ្រូពេទ្យ មកពី ប្រទេស បារាំង និង ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន ប្រចាំ ទ្វីប អឺរ៉ុប ចំនួន ប្រមាណ ជាង ០០ នាក់ នៅ ភោជនីដ្ឋាន ប៉ោកី ក្នុង រាជធានី ភ្នំពេញ នា ល្ងាច ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២២ ម្សិលមិញ ។
ថ្លែង ឱកាស ជួបជុំ ដ៏ សប្បាយរីករាយ នោះ លោក ហ៊ុន ម៉ាណែត បាន សម្តែង នូវ ការអរគុណ ចំពោះ សមាគម ទាំង បី មកពី ប្រទេស បារាំង ដែល បាន ជួយ ដល់ ប្រជាជន កម្ពុជា តាមរយៈ សកម្មភាព សង្គម និង មនុស្ស ជាច្រើន រួម មាន៖ ការរៀបចំ ព្រឹត្តិការណ៍ សិល្បៈ វប្បធម៌ . ការពិនិត្យ ព្យាបាល ជំងឺ ដោយ ឥត គិត ថ្លៃ . ការផ្តល់ ជំនួយ មនុស្សធម៌ ជួយ ដល់ ជនរងគ្រោះ នៃ គ្រោះ ផ្សេង ៗ និង ជាពិសេស បាន ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ជួយ ដល់ ជនរងគ្រោះ ក្នុង វិបត្តិ នៃ ជំងឺ កូវីដ១៩ ។
ឈ្មួញ វៀតណាម សម្រុក មក ទិញ ស្រូវ ខ្មែរ នៅ ច្រក កំពង់ទូក ប្រឡាយ ទាហាន ស្រុក កំពង់រោទិ៍ ស្លាប ច្រកទ្វា អន្ត ជាតិ ព្រៃ វ ល្ល៍
( ស្វាយរៀង ) ៖ ប្រជាកសិករ ខ្មែរ កំពុងតែ សម្រុក ដឹក ស្រូវ ទៅ លក់ នៅ កំពង់ដរ ទូក ប្រឡាយ ទាហាន ស្លាប ច្រកទ្វា ព្រំដែន អន្តរជាតិ ព្រៃ វល្ល៍ ខណៈ ឈ្មួញ វៀតណាម នាំគ្នា យក ទូក កាណូត ប៉ុក ចៃ ធំ ៗ ឆ្លង ដែន ចូលមក ចាំ ទិញ ស្រូវ ខណៈ អាជីវករ វៀតណាម ខ្វះ អង្ករ នាំចេញ ទៅ លក់ នៅ ប្រទេស ទី៣ ។
បើ តាម សមត្ថកិច្ច ដែល ឈជើង នៅ កំពង់ កាណូត ប្រឡាយ ទាហាន បាន ឲ្យដឹង ថា រយៈពេល ជិត ២ខែ មក នេះ ចាប់ពី អំឡុង ខែកក្កដា ដល់ ថ្ងៃទី ២០ សីហា ២០២២ នេះ ក្រុម ឈ្មួញ វៀតណាម ខ្វះ ស្រូវ ផលិត អង្ករ នាំចេញ ទៅ ក្រៅ ប្រទេស បាន យក ទូក កាណូត ប៉ុក ចៃ ធំ ៗ ឆ្លង ដែន ចូលមក កម្ពុជា តាម ច្រក ផ្លូវ ទឹក ប្រឡាយ ទាហាន ស្ថិត នៅ ចំណុច ភូមិ ព្រៃ វល្ល័ ឃុំ ថ្មី ស្រុក កំពង់រោទ៌ ដើម្បី មក ចាំ ទិញ ស្រូវ ពី ក្រុម អាជីវករ និង ប្រជាកសិករ ខ្មែរ យើង ។
សមត្ថកិច្ច បន្ត ថា ស្រូវ មាន តិចតួច ដោយ ស្រូវ វស្សា មិន ទាន់ មាន ទុំ ច្រើន ចំណែក ស្រូវ រដូវ ប្រាំង ផុត នៅ ដើម ខែកក្កដា ហើយ ភាគី ឈ្មួញ វៀតណាម មាន តម្រូវការស្រូវ ខ្ពស់ ដើម្បី ផលិត អង្ករ នាំចេញ ទៅ ប្រទេស ទី៣ ទើប ឈ្មួញ វៀតណាម យក ទូក កាណូត ឆ្លង ដែន ចូលមក ចត ចាំ ទិញ ស្រូវ ខ្មែរ យើង ។
ប្រភព ដដែល បាន បន្ត ថា រយៈពេល កន្លងទៅ នេះ អាជីវករ និង ប្រជាកសិករ ខ្មែរ យើង នាំគ្នា ដឹក ស្រូវ មក លក់ នៅ កំពង់ កាណូត ប្រឡាយ ទាហាន តាម គោយន្ត កាឡេថង តាម រថយន្ត មក ចាំ ឈ្មួញ វៀតណាម យក ទូក ចូលមក ទិញ ស្រូវ និង ដឹក ស្រូវ ចេញ ទៅ ប្រទេស វៀតណាម ។
ប្រជាពលរដ្ឋ បាន លើកឡើង ថា នៅពេល ស្រូវ វស្សា បាន ផល ចាប់ពី ខែតុលា ដល់ ខែវិច្ឆិកា ចាប់ផ្តើម ច្រូត កាត់ គឺ ឈ្មួញ វៀតណាម ចូលមក ប្រមូល ទិញ គឺ វៀតណាម ចាប់ផ្តើម ទម្លាក់ តម្លៃ ស្រូវ ខ្មែរ មូលហេតុ ដោយ ទីផ្សារ ខ្មែរ យើង ពឹងផ្អែក លើ គេ ( វៀតណាម ) ទាំងស្រុង ។
ពលរដ្ឋ រស់ នៅ តាម ព្រំដែន លើកឡើង ថា ប្រសិនបើ ឈ្មួញ វៀតណាម មិន ចូលមក ទិញ ស្រូវ ទៀត គឺ មាន ការប្រឈម កាន់តែ ខ្លាំង ដូច្នេះ ដើម្បី រក្សារ ទីផ្សារ ស្រូវ ឲ្យ មាន តម្លៃ ទីផ្សារ នៅលើ សហគមន៍ កសិករ ខ្មែរ ប្រជាពលរដ្ឋ បាន សំណូមពរ សូមឲ្យ មន្ទីរក សិម្ម ក្រសួង កសិកម្ម ក្រសួង ពាណិជ្ជកម្ម អាជ្ញាធរ ពាក់ព័ន្ធ បង្កើន ការប្រមូល ទិញ ស្រូវ ពី ប្រជាកសិករ និង បង្កើន ការផលិត អង្ករ នាំចេញ ឲ្យបាន ច្រើន ដើម្បី ធានាទីផ្សារ ស្រូវ អង្ករ ជូន ប្រជាពលរដ្ឋ ដែល ជា អ្នកផលិត ទទួលបាន នូវ ជីវភាពល្អ ប្រសើរ ៕
ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ចុះ ពិនិត្យ ព្យាបាល ជំងឺ ដោយ ឥត គិត ថ្លៃ និង ជូន អំណោយ មួយចំនួន ដល់ អ្នកជំងឺ ១៥០ គ្រួសារ នៅ ស្រុក ព្រៃឈរ
( កំពង់ចាម ) ៖ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី បាន បន្ត ចុះ ពិនិត្យ និង ព្យាបាល ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ជាមួយនឹង ការផ្តល់ ជា អំណោយ មួយចំនួន ជូន ដល់ អ្នកជំងឹទាំង ១៥០ គ្រួសារ នៅ មន្ទីរ សម្រាក ព្យាបាល « ស៊ុន ពិសិដ្ឋ » ក្នុង ភូមិ អ្នកតា ស្នឹង ឃុំ បឹងណាយ ស្រុក ព្រៃឈរ ខេត្ត កំពង់ចាម ។
សូម រម្លឹក ថា ក្រុមការងារ គ្រូពេទ្យ ស្ម គ្រ័ចិត្ត លោក ហ៊ុន ម៉ានី មាន ចំនួន ២. ៩៤៥នាក់ បាន ចុះ បេសកកម្ម តាម ការ ឧទ្ទេសនា ម របស់ គណៈកម្មកា ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ដោយ ឥត គិត ថ្លៃ និង ដោយ ស្ម័គ្រចិត្ត ឥត គិត ថវិកា បេសកកម្ម ដោយ ចាក់ ជូន ប្រជាពលរដ្ឋ បាន ប្រមាណ ៩. ៣៥៨. ០៥២ ដូស ( ប្រាំបួន លាន សាមសិប ប្រាំ ម៉ឺន ប្រាំបី ពាន់ ហាសិប ពីរ ដូស ) ក្នុង ២៥ រាជធានី - ខេត្ត ។
លោក វេជ្ជបណ្ឌិត ស៊ុន ពិសិដ្ឋ អនុប្រធាន ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី បាន ឲ្យដឹង ទៀ ថា ប្រជាពលរដ្ឋ ពិតជា មាន ក្តី រំភើប កក់ក្តៅ ឥត ឧបមា គោរព ថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ចំពោះ សម្តេច តេជោ ហ៊ុន សែន និង លោក ហ៊ុន ម៉ានី ក្នុង ការជួយ សកម្មភាព មនុស្សធម៌ នេះ ជូន ដល់ ប្រជាពលរដ្ឋ ជារៀងរហូតមក គឺ កើត ចេញ ពី ការឧបត្ថម្ភ គាំទ្រ និង ការចង្អុលបង្ហាញ ដោយ ផ្ទាល់ ពីសំណាក់ លោក ហ៊ុន ម៉ានី ដែល លោក តែងតែ ខ្វល់ខ្វាយ គិតគូរ និង រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ក្នុង គ្រប់ កាល ទេសៈ ។
តាមរយៈ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ដ៏ ឧត្តុងឧត្តម និង ដ៏ ថ្លៃថ្លា របស់ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី រយៈពេល ជាង ១០ឆ្នាំ កន្លងមក បាន ទទួល លទ្ធផល ជា ផ្លែ ផ្កា ដែល នាំឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ គោរព ថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន លោក ហ៊ុន ម៉ានី ថ្នាក់ដឹកនាំ ខេត្ត គ្រប់ ជាន់ ថ្នាក់ និង ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា នៃ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ព្រមទាំង ក្រុមការងារ ៕
ក្រសួង ការបរទេស បញ្ជាក់ ថា ក្នុង ជំនួប ដែល បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២២ នោះ ភាគី ទាំង ពីរ បាន ផ្លាស់ប្តូរ ទស្សនៈ គ្នា អំពី ទំនាក់ទំនង ការទូត ដ៏ យូរអង្វែង និង បាន ស្វែងរក ឱកាស ជំរុញ ពាណិជ្ជកម្ម និង ទេសចរណ៍ រវាង ប្រទេស ទាំង ពីរ ។
កញ្ចប់ ជំនួយ យោធា ថ្មី ខាងលើ ក្នុង នោះ រួម មាន គ្រាប់ រំសេវ សម្រាប់ ប្រព័ន្ធ មីស៊ីល HIMARS កាំភ្លើង ធំ ហាវ វីត ស័រ (howitzers) ១៦ គ្រឿង រួម ជាមួយ គ្រាប់ សម្រាប់ កាំភ្លើង ធំ ចំនួន ៣៦.០០០ គ្រាប់ ជាដើម ។ ថ្លែង នៅក្នុង សន្និសីទ សារព័ត៌មាន រដ្ឋមន្ត្រី ការបរទេស អាមេរិក លោក អាន់តូនី ប្ល៊ីន ខិន បាន គូសបញ្ជាក់ ដូច្នេះ ថា « ភាពក្លាហាន និង ភាពខ្លាំងក្លា របស់ យោធា និង ប្រជាជន អ៊ុយក្រែន គឺ ពិតជា អស្ចារ្យ ណាស់ ហើយ សហរដ្ឋ អាមេរិក នឹង បន្ត ផ្ដល់ ជំនួយ ដល់ អ៊ុយក្រែន ។
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ២១ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ២. ២៥២នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
ក្រុមការងារ បក្ស ប្រជាជន ចុះ ជួយ ក្រុង ស្វាយរៀង នាំ ទៀន វស្សា និង ទេយ្យ ទាន ប្រគេន ដល់ ព្រះសង្ឃ នៅ វត្ត ឧប្បុរតនា រាម និង វត្ត សន្តិភាព
( ស្វាយរៀង ) ៖ លោក ជុក មុន្នី អនុប្រធាន ទី១ ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ក្រុង ស្វាយរៀង និង លោក កែរ រដ្ឋា ប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ ស្វាយរៀង ព្រមទាំង ក្រុមការងារ បាន ប្រគេន ទៀន វស្សា ទេយ្យ ទាន និង បច្ច័យ ដល់ ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា នៅ វត្ត ឧប្បុរតនា រាម និង វត្ត សន្តិភាព ក្នុង សង្កាត់ ស្វាយរៀង ។
ក្នុង ពេល នាំ ទៀន វស្សា នៅ ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០២២ នោះ លោក កែរ រដ្ឋា បាន ថ្លែង ថា ព្រះពុទ្ធ សាសនា គឺជា សាសនា របស់ រដ្ឋ ដែល យើង ទាំងអស់ គ្នា មាន ជំនឿ និង គោរព ប្រតិបត្តិ តាម ព្រោះថា ព្រះពុទ្ធ សាសនា បាន ផ្តល់ ការអប់រំ ផ្លូវចិត្ត ឲ្យ ប្រព្រឹត្ត នូវ អំពើ ល្អ និង ចេះ ជួយ យ យកអាសា គ្នា សាមគ្គីភាព គ្នា រស់ នៅក្នុង សង្គម មួយ ដោយ សុខដុមរមនា ។
លោក បាន បញ្ជាក់ ថា នៅ ជារៀងរាល់ ឆ្នាំ មិន ថា ពុទ្ធ បរិស័ទ ឬ សប្បុរសជន នោះ ឡើយ សូម្បីតែ អាជ្ញាធរ ខេត្ត និង ក្រុមការងារ ថ្នាក់ ជាតិ ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា តែងតែ បាន នាំយក នូវ ទៀន ព្រះវស្សា មក វេរ ប្រគេន ដល់ ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា នៅ តាម ទី វត្តអារាម នានា ទូទាំង ប្រទេស ដែល ជា ការបង្ហាញ នូវ ការយកចិត្តទុកដាក់ គាំទ្រ ផ្នែក វិស័យ ពុទ្ធសាសនា ដែល ជា សាសនា របស់ រដ្ឋ ផងដែរ ។
លោក បាន គូសបញ្ជាក់ ថា ទី វត្តអារាម គឺជា មូលដ្ឋានគ្រឹះ នៃ អក្សរសាស្ត្រ ខ្មែរ យើង ដែល ជា ជង្រុក នៃ សម្បត្តិ វប្បធម៌ ជាតិ និង ជា ថ្នាល បណ្តុះបណ្តាល នូវ ធនធាន មនុស្ស ទាំង វិស័យ អាណាចក្រ និង ពុទ្ធ ចក្រ ទៀតផង ។ សូម ប្រជាពុទ្ធ បរិស័ទ រួមគ្នា ធ្វើ ការអប់រំ កូន ចៅ ឲ្យ ចាក ឆ្ងាយ ពី គ្រឿងញៀន គោរព ច្បាប់ ចរាចរណ៍ និង ចូលរួម ថែរក្សា បរិស្ថាន អនាម័យ និង សូម ចូលរួម ទៅ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ដូស ជំរុញ ( ដូស ទី៣ ទី៤ និង ទី៥) ឲ្យបាន គ្រប់ ៗ ។
ក្នុង ព្រះរាជ សារ ជូន ប្រជារាស្ត្រ ខ្មែរ កាលពី ថ្ងៃទី ១៦ ខែសីហា កន្លងទៅ នេះ ព្រះករុណា ជា អម្ចាស់ ជីវិត តម្កល់ លើ ត្បូង បាន មាន ព្រះរាជ បន្ទូល ថា ព្រះអង្គ នឹង ព្រះអវត្តមាន ពី កម្ពុជា ចាប់ពី ថ្ងៃទី ២១ ខែសីហាត ទៅ ។ ក្នុង កំលុង នៃ ព្រះអវត្តមាន នេះ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា នឹង បំពេញ ភារកិច្ច ថ្វាយ ព្រះអង្គ ក្នុង ឋានៈ ជា ប្រមុខរដ្ឋ ស្តីទី ។
នៅ ឆ្នាំ ២០២២ នេះ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី និង ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ បាន យាង ទៅ ពិនិត្យ ព្រះរាជ សុខភាព រួច ម្តង មក ហើយ កាលពី ថ្ងៃទី ៤ ខែមីនា ។ ក្នុង ព្រះរាជ ដំណើរ យាង ទៅ ពិនិត្យ ព្រះរាជ សុខភាព កាល លើក ទី មួយ នោះ ព្រះអង្គ ទាំង ទ្វេ បាន គង់ ប្រថាប់ នៅ ក្រុង ប៉េកាំង រយៈពេល ជាង មួយ ខែ ។
សម្រាប់ ការយាង ចេញ ទៅ ពិនិត្យ ព្រះរាជ សុខភាព លើក ទី២ នេះ មិន ទាន់ មាន ការជូន ព័ត៌មាន ថា តើ ព្រះអង្គ ទាំង ទ្វេ នឹង យាង ត្រឡប់មក កម្ពុជា វិញ នៅ ពេលណា នោះ ទេ ៕ ព្រឹក នេះ ព្រះមហាក្សត្រ និង ព្រះវរ រាជ មាតា យាង ទៅកាន់ ក្រុង ប៉េកាំង ពិនិត្យ ព្រះរាជ សុខភាព
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះសព្វ ព្រះរាជ ហឫទ័យ យាង ទៅកាន់ ក្រុង ប៉េកាំង ប្រទេស ចិន ដើម្បី ពិនិត្យ និង ព្យាបាល ព្រះរាជ សុខភាព ។
នៅ ឆ្នាំ ២០២២ នេះ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី និង ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ បាន យាង ទៅ ពិនិត្យ ព្រះរាជ សុខភាព រួច ម្តង មក ហើយ កាលពី ថ្ងៃទី ៤ ខែមីនា ។ ក្នុង ព្រះរាជ ដំណើរ យាង ទៅ ពិនិត្យ ព្រះរាជ សុខភាព កាល លើក ទី មួយ នោះ ព្រះអង្គ ទាំង ទ្វេ បាន គង់ ប្រថាប់ នៅ ក្រុង ប៉េកាំង រយៈពេល ជាង មួយ ខែ ។
សម្រាប់ ការយាង ចេញ ទៅ ពិនិត្យ ព្រះរាជ សុខភាព លើក ទី២ នេះ មិន ទាន់ មាន ការជូន ព័ត៌មាន ថា តើ ព្រះអង្គ ទាំង ទ្វេ នឹង យាង ត្រឡប់មក កម្ពុជា វិញ នៅ ពេលណា នោះ ទេ ៕ អគ្គិសនី កម្ពុជា បញ្ជាក់ ពី ការដាច់ចរន្ត អគ្គិសនី នៅ ទៀប ភ្លឺ ថ្ងៃ នេះ
( ភ្នំពេញ ) ៖ នៅ វេលា ម៉ោង ០៣៖ ៤៩ នាទី ទៀប ភ្លឺ ថ្ងៃទី ២១ ខែសីហា នេះ មាន ការដាច់ចរន្ត អគ្គិសនី នៅ ស្ទើរ ទូទាំង រាជធានី ភ្នំពេញ និង នៅ តាម បណ្តា ខេត្ត មួយចំនួន ទៀត ។ ការដាច់ នេះ នាំឱ្យ ប្រជាពលរដ្ឋ អ្នកប្រើប្រាស់ ងឿងឆ្ងល់ ជាខ្លាំង ។
អគ្គិសនី កម្ពុជា បាន បញ្ជាក់ ថា ការដាច់ នេះ បណ្តាល មកពី លោត ឌីស្យុងទ័រ ទ្វារ ចរន្ត តង់ ស្យុង ខ្ពស់ ២៣០ គីឡូ វ៉ុល ។
ភ្លាម ៗ ក្រោយ ការដាច់ នោះ ក្រុមការងារ បច្ចេកទេស ធ្វើ ការពិនិត្យ ដើម្បី ស្ដារ ប្រព័ន្ធ និង ភ្ជាប់ ចរន្ត អគ្គិសនី ជូន អតិថិជន ឲ្យ ឆាប់ មាន ចរន្ត អគ្គិសនី ប្រើប្រាស់ ឡើងវិញ ។
អគ្គិសនី កម្ពុជា បាន បញ្ជាក់ ថា ក្រុមការងារ បច្ចេកទេស បាន ធ្វើ ការពិនិត្យ និង ស្ដារ ប្រព័ន្ធ ភ្ជាប់ ចរន្ត អគ្គិសនី ជូន អតិថិជន ឲ្យ មាន ចរន្ត អគ្គិសនី ប្រើប្រាស់ ឡើងវិញ នៅ វេលា ម៉ោង ០៦: ៣០ នាទី ព្រឹក ។
ការដាច់ចរន្ត នេះ បាន ធ្វើឲ្យ បាត់បង់ អនុភាព សរុប ចំនួន ១.០១០ មេហ្គាវ៉ាត់ ៕ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខណ្ឌ ទួលគោក បើក កិច្ចប្រជុំ ដោះស្រាយ បញ្ហា ប្រឈម ពង្រឹង សន្តិសុខ និង ការបម្រើ សេវា ជូន ពលរដ្ឋ
( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ទួលគោក និង ជា សមាជិក ក្រុម លេខា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ដឹកនាំ កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខណ្ឌ ដោយ ផ្ដោត លើ ការងារ សំខាន់ ៗ មួយចំនួន ដើម្បី បម្រើ ជូន ប្រជាពលរដ្ឋ ។
