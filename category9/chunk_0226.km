( ភ្នំពេញ ) ៖ លោក គង់ វិបុល រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៅ ព្រឹក ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ មន្រ្តី ពាក់ព័ន្ធ នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ បន្ត ចុះ ពិនិត្យ ការដាក់ បញ្ជរ ផ្ដល់ សេវា ចុះបញ្ជី ពន្ធដារ និង ចុះ អង្កេត សហគ្រាស ស្រប តាម សេចក្ដី ជូនដំណឹង លេខ ១៦៤០៣ អពដ ស្ដីពី ការចុះអង្កេត សហគ្រាស នៅ រាជធានី ភ្នំពេញ ។
ជា កិច្ច ចាប់ផ្ដើម លោក គង់ វិបុល បាន ចុះ ពិនិត្យ និង បាន ជួប សំណេះសំណាល ជាមួយ ម្ចាស់ អាជីវកម្ម មួយ ចំនួន ដែល បាន មក ទទួល សេវា នៅ បញ្ជរ ផ្ដល់ សេវា ចុះបញ្ជី ពន្ធដារ ដែល បាន រៀបចំ នៅ ផ្សារ TK Avenue នៅ សង្កាត់ បឹងកក់ទី១ ដែល មាន ទទួល ផ្ដល់ សេវា ចុះបញ្ជី អាជីវកម្ម តាម ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន ។
សូម ជម្រាប ថា បញ្ជរ ផ្ដល់ សេវា ចុះបញ្ជី ពន្ធដារ មាន សេវា ដូច ជា៖ ថត រូប និង ស្គែន ម្រាម ដៃ អ្នក ជាប់ ពន្ធ ចូលក្នុង ប្រព័ន្ធ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ផ្ដល់ ព័ត៌មាន ស្តីពី ការចុះបញ្ជី និង ធ្វើ បច្ចុប្បន្នភាព ព័ត៌មាន អ្នក ជាប់ ពន្ធ ជាពិសេស ផ្ដល់ នូវ ព័ត៌មាន ជូន អ្នក ជាប់ ពន្ធ អំពី របៀប នៃ ការទាញយក ឯកសារ និង ដំឡើង កម្មវិធី ទូរស័ព្ទ ដៃ នានា របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ និង ផ្តល់ សេវា ពន្ធដារ នានា មួយចំនួន ទៀត ផងដែរ ។
លើស ពី នេះ លោក គង់ វិបុល ក៏ បាន បន្ត ចុះ ពិនិត្យ ការអនុវត្ត ការងារ អង្កេត សហគ្រាស នៅ តាម ទីតាំង អាជីវកម្ម មួយ ចំនួន ទៀត ដែល ស្ថិត នៅក្នុង សង្កាត់ បឹងកក់ទី១ ក្នុង គោលបំណង ផ្ដល់ សេវា ចុះបញ្ជី ពន្ធដារ ជូន អ្នក ជាប់ ពន្ធ ឱ្យ បាន ងាយស្រួល និង ទូលំទូលាយ សំដៅ ជំរុញ ការបំពេញ កាតព្វកិច្ច សារពើពន្ធ ឱ្យ ស្មើភាព គ្នា ដោយ ហេតុ អគ្គ នាយកដ្ឋាន ពន្ធដារ សង្កេតឃើញ នៅ មាន កន្លែង អាជីវកម្ម ថ្មី ៗ មួយចំនួន កំពុង ប្រកបរបរ អាជីវកម្ម ដោយ មិន ទាន់ បាន ចុះបញ្ជី ពន្ធដារ នៅឡើយ ។
នា ឱកាស នោះ លោក គង់ វិបុល បាន អំពាវនាវ ដល់ ម្ចាស់ សហគ្រាស ដែល បាន និង កំពុង ប្រកប អាជីវកម្ម ទាំងអស់ ចូលរួម សហការផ្ដល់ ព័ត៌មាន ឯកសារ និង បង្ក លក្ខណៈ ងាយស្រួល ក្នុង ការអនុវត្ត ការងារ អង្កេត សហគ្រាស ព្រមទាំង ចូលរួម បំពេញ កាតព្វកិច្ច ចុះបញ្ជី ពន្ធដារ ឱ្យ បាន គ្រប់ ៗ គ្នា និង ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។
ការបង្ហាញ អំពី ឆន្ទៈ ក្នុង ការដំឡើង កម្រិត ទំនាក់ទំនង នេះ បាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ ដាច់ដោយឡែក រវាង រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន និង រដ្ឋមន្រ្តី ការបរទេស ជប៉ុន កូរ៉េ ខាងត្បូង និង ឥណ្ឌា ។
ថ្លែង ក្នុង សន្និសីទ កាសែត នៅ យប់ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២២ នេះ លោក បណ្ឌិត គង់ ភោគ អ្នកនាំពាក្យ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ បាន បញ្ជាក់ ថា ប្រទេស ទាំង៣ និង អាស៊ាន បាន បង្ហាញ បំណង ក្នុង ការដំឡើង កម្រិត ទំនាក់ទំនង ឱ្យ ទៅជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ។
លោក បញ្ជាក់ ដូច្នេះ ថា៖ « ពាក់ព័ន្ធ នឹង កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន - កូរ៉េ គឺ មាន ការបង្ហាញ បំណង កម្រិត ទៅជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ព្រោះ ឥឡូវនេះ ដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ គឺ មាន តែ ២ប្រទេស ទេ គឺ មាន ចិន និង អូស្រ្តាលី » ។
លោក បាន បន្ត ថា ក្នុង ប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន - ជប៉ុន អង្គប្រជុំ បាន បង្ហាញ អំពី បំណង របស់ ជប៉ុន ក្នុង ដំឡើង កម្រិត ទៅជា ដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ ក្នុង ឱកាស គម្រប់ ខួប នៃ កិច្ចសហប្រតិបត្តិការ នេះ ។
រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន កោតសរសើរ ចំពោះ ការចូលរួម របស់ ជប៉ុន ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដោយ កន្លងទៅ ជប៉ុន ធ្លាប់ ផ្តល់ ជំនួយ ៥០ លាន ដុល្លារ សម្រាប់ ការបង្កើត មជ្ឈមណ្ឌល អាស៊ាន សម្រាប់ ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ផងដែរ ។
ដោយឡែក សម្រាប់ កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន - ឥណ្ឌា ត្រូវបាន អ្នកនាំពាក្យ រូប នេះ បញ្ជាក់ ថា រដ្ឋមន្រ្តី ទាំងអស់ បាន កត់សម្គាល់ ប្រកបដោយ ការពេញចិត្ត ចំពោះ ទំនាក់ទំនង អាស៊ាន - ឥណ្ឌា ។ កិច្ចប្រជុំ បាន កំណត់ យក ឆ្នាំ ២០២២ ជា ឆ្នាំ មិត្តភាព អាស៊ាន - ឥណ្ឌា ។ ក្នុង កិច្ចប្រជុំ នេះ ឥណ្ឌា ក៏ បាន ស្នើ ដំឡើង កម្រិត ពី ដៃគូ យុទ្ធសាស្ត្រ ទៅជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ។
ក្រៅពី ប្រទេស ទាំង៣នេះ ដែល ចង់ ដំឡើង កម្រិត ទំនាក់ទំនង ដល់ ចំណុច កំពូល នៃ ការទូត ក៏ មាន ដែរ នូវ ប្រទេស មួយចំនួន ទៀត ចង់ ដំឡើង កម្រិត ពី ដៃគូ សន្ទនា ទៅជា ដៃគូ យុទ្ធសាស្ត្រ ក្នុង នោះ មាន កាណា ផងដែរ ។ ចំណែក អង់គ្លេស ដែល ទើប ផ្តាច់ ខ្លួន ពី អឺរ៉ុប ក៏ បាន ក្លាយទៅជា ដៃគូ សន្ទនា របស់ អាស៊ាន ផងដែរ ៕ ប្រកាស ផ្ទេរ ភារកិច្ច តែងតាំង មុខ តំណែង និង បំពាក់ ស័ក្តិ ជូន មន្ត្រី នគរបាល ខេត្ត បន្ទាយមានជ័យ ជាង ២០០ រូប
( បន្ទាយមានជ័យ ) ៖ នាយ ឧត្តមសេនីយ៍ ប៉ែន វិបុល អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ប្រធាន នាយកដ្ឋាន បុគ្គលិក និង លោក អ៊ុ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ នៅ ព្រឹក ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ប្រកាស ផ្ទេរ ភារកិច្ច តែងតាំង មុខ តំណែង និង បំពាក់ ឋានន្តរស័ក្តិ ជូន មន្ត្រី នគរបាល ជាតិ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ជាង ២០០ រូប ។
ពិធី នេះ ត្រូវបាន ប្រារព្ធ ធ្វើឡើង នៅ សាល ប្រជុំ សាលា ខេត្ត បន្ទាយមានជ័យ ដោយ មាន ការចូលរួម ពី លោក លោកស្រី តំណាង មន្ទីរ ស្ថាប័ន ពាក់ ពន្ធ័ ជុំវិញ ខេត្ត កម្លាំងប្រដាប់អាវុធ និង ប្រតិភូ អម ដំណើរ ជាច្រើន រូប ផងដែរ ។
កម្លាំង នគរបាល ជាតិ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ដែល ត្រូវបាន ប្រកាស តួនាទី និង ផ្ទេភារកិច្ច មាន ចំនួន ៨២ រូប និង បំពាក់ ឋានន្តរស័ក្តិ ចំនួន ១៤៦ រូប មាន វរៈ សេនីយ៍ ទោ ចំនួន ៦១ រូប និង វរៈ សេនីយ៍ ត្រី ចំនួន ៧៣ រូប អនុ សេនីយ៍ ឯក ចំនួន ២រូប ។
ក្រោយ បញ្ចប់ ពិធី ប្រកាស តែងតាំង មុខ តំណែង និង បំពាក់ ឋានន្តរសក្តិ នាយ ឧត្តមសេនីយ៍ ប៉ែន វិបុល ក៏ បាន អញ្ជើញ ទៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ដើម្បី កាត់ ខ្សែរបូរណ៍ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ អាគារ បណ្ណាល័យ ១ខ្នង និង សមិទ្ធផល នានា ជាច្រើន ដែល ទើប កសាង រួច ផងដែរ ៕
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ខាងលើ នេះ មាន ករណី នាំចូល ចំនួន ២៥៦ ករណី ក្រៅពី នោះ ជា ករណី ឆ្លង ក្នុង សហគមន៍ ទាំងអស់ ។
លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ឱ្យដឹង ថា ក្នុង ជំនួប នេះ ប្រមុខ ការទូត ឥណ្ឌា បាន លើកឡើង បង្ហាញ បំណង ពង្រីក និង ពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ ការតភ្ជាប់ ផ្លូវ ពី ឥណ្ឌា ឆ្លងកាត់ មីយ៉ាន់ម៉ា ថៃ មកកាន់ កម្ពុជា ។ លោក ក៏ បាន បង្ហាញ បំណង ពង្រឹង កិច្ចសហប្រតិបត្តិការ ក្នុង ក្របខណ្ឌ អាស៊ាន មេគង្គ គង្គារ លើ វិស័យ សេដ្ឋកិច្ច ទេសចរណ៍ ការពារ ជាតិ ដោះ មីន វិនិយោគ និង ការអភិវឌ្ឍ សហគមន៍ ព្រមទាំង ជួសជុល ប្រាង្គ ប្រាសាទ ផងដែរ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ស្វាគមន៍ រាល់ បំណង កិច្ចសហប្រតិបត្តិការ ដែល បាន លើកឡើង ខាងលើ នេះ ។ សម្តេច តេជោ ក៏ បាន លើកទឹកចិត្ត ឱ្យ មាន ការសិក្សា បញ្ចប់ លើ ផ្នែក បច្ចេកទេស នានា ដើម្បី ជំរុញ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី រវាង ប្រទេស ទាំង ពីរ ព្រមទាំង កិច្ចសន្យា គាំពារ វិនិយោគ ផងដែរ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន ស្នើ ឥណ្ឌា ឱ្យ ពិចារណា ហោះហើរ ត្រង់ ពី ឥណ្ឌា មកកាន់ កម្ពុជា ដើម្បី លើកស្ទួយ វិស័យ ទេសចរណ៍ និង ស្នើ ឱ្យ មាន ការពិចារណា លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ មេគង្គ - គង្គារ ឱ្យ ដល់ កម្រិត កំពូល ៕
រដ្ឋមន្ត្រី ទាំង ពីរ បាន ពិភាក្សា អំពី ការពង្រឹង ទំនាក់ទំនង ទ្វេ ភាគី ដែល ក្នុង ឱកាស នោះ លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចពិគ្រោះយោបល់ ទ្វេ ភាគី លើក ទី២ រវាង ក្រសួង ការបរទេស ទាំង ពីរ កាលពី ខែកុម្ភៈ កន្លងទៅ និង បាន គូសបញ្ជាក់ ថា កិច្ចពិគ្រោះយោបល់ ជា ទៀត ទាត់ គឺ មាន សារសំខាន់ ណាស់ ហើយ អាចនឹង ផ្តល់ មធ្យោបាយ បន្ថែម ទៀត ដើម្បី ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី នៅក្នុង គ្រប់ វិស័យ ដែល មាន សក្តានុពល ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន ជម្រាប ជូន សមភាគី របស់ លោក អំពី ស្ថានភាព បច្ចុប្បន្ន នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា និង វឌ្ឍនភាព ដែល សម្រេចបាន ក្នុង អំឡុង ពេល នៃ ដំណើរទស្សនកិច្ច ចំនួន ២លើក របស់ ឯកឧត្តម ក្នុង ឋានៈ ជា ប្រេសិត ពិសេស របស់ ប្រធាន អាស៊ាន ឆ្នាំ ២០២២ ។
លោកស្រី រដ្ឋមន្ត្រី ការបរទេស ណា ណៃ អា ម៉ាហ៊ូតា បាន គូសបញ្ជាក់ អំពី ការគាំទ្រ របស់ នូវែលសេឡង់ ចំពោះ កិច្ចព្រមព្រៀង ជា ឯកច្ឆន្ទ ប្រាំ ចំណុច របស់ អាស៊ាន និង កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ប្រធាន អាស៊ាន និង ប្រេសិត ពិសេស ក្នុង ការជំរុញ ការអនុវត្ត នេះ ។
ទន្ទឹមនឹង ការអះអាង ជាថ្មី នៃ ការប្តេជ្ញាចិត្ត ក្នុង ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ក្នុង ក្របខ័ណ្ឌ ពហុ ភាគី លោក ប្រាក់ សុខុន និង លោកស្រី ណាណៃ អា ម៉ាហ៊ូតា ក៏ បាន ផ្លាស់ប្តូរ ទស្សនៈ និង ការពិភាក្សា លើ បញ្ហា តំបន់ និង អន្តរជាតិ មួយចំនួន ដែល ជា កង្វល់ រួម និង ផលប្រយោជន៍ ទៅ វិញ ទៅ មក រួមទាំង ការប្រែប្រួល អាកាសធាតុ និង វិបត្តិ នៅ ប្រទេស អ៊ុយក្រែន ផងដែរ ៕
អូស្ត្រាលី រំពឹង ថា ទំនាក់ទំនង ជាមួយ កម្ពុជា និង ក្របខណ្ឌ អាស៊ាន ត្រូវបាន ពង្រឹង និង ពង្រីក
( ភ្នំពេញ ) ៖ លោកស្រី ផេននី វង់ រដ្ឋមន្ត្រី ក្រសួង ការបរទេស អូស្ត្រាលី បាន បង្ហាញ ការរំពឹង របស់ ខ្លួន ថា ទំនាក់ទំនង រវាង អូស្ត្រាលី និង កម្ពុជា ក៏ ដូចជា ជាមួយ អាស៊ាន នឹង ត្រូវបាន ពង្រឹង និង ពង្រីក ឱ្យ កាន់តែ ល្អ ប្រសើរ ។
លោកស្រី រដ្ឋមន្ត្រី ការបរទេស អូស្ត្រាលី បាន ថ្លែង បង្ហាញ ក្តី រំពឹង បែប នេះ ក្នុង ពេល ជួប ពិភាក្សា ការងារ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ល្ងាច ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២២ នេះ ។
ក្រៅតែ ពី បង្ហាញ បំណង ចង់ ឃើញ នូវ ទំនាក់ទំនង ត្រូវបាន ពង្រឹង និង ពង្រីក ជាមួយ កម្ពុជា និង អាស៊ាន ហើយ នោះ ក្នុង ជំនួប នេះ លោកស្រី រដ្ឋមន្ត្រី ការបរទេស អូស្ត្រាលី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ។ លោកស្រី ក៏ បាន សម្តែង នូវ ការអបអរសាទរ ជូន ចំពោះ សម្តេច តេជោ ចំពោះ ភាពជោគជ័យ ក្នុង នាម ជា ប្រធាន អាស៊ាន ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន សម្តែង នូវ ការស្វាគមន៍ ចំពោះ លោកស្រី ប្រមុខ ការទូត អូស្ត្រាលី ។ ឆ្លៀត ក្នុង ឱកាស នេះ សម្តេច តេជោ បាន សម្តែង នូវ ការអបអរសាទរ ខួប លើក ទី៧០ នៃ ការភ្ជាប់ ទំនាក់ទំនង ការទូត រវាង កម្ពុជា និង អូស្ត្រាលី ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន សម្តែង នូវ ការអបអរសាទរ ចំពោះ គណបក្ស ពលករ អូស្ត្រាលី ដែល ទទួលបាន ជ័យជម្នះ ក្នុង ការបោះឆ្នោត កាលពី ខែឧសភា កន្លងទៅ ។ សម្តេច តេជោ ក៏ បាន សម្តែង ការអបអរសាទរ ចំពោះ លោកស្រី ផេននី វង់ ដែល បាន ឡើង កាន់ តំណែង ជា រដ្ឋមន្ត្រី ការបរទេស ។
ឆ្លៀត ក្នុង ឱកាស នេះ សម្តេច តេជោ ហ៊ុន សែន បាន អរគុណ អូស្ត្រាលី ក្នុង ការចូលរួមចំណែក ស្វែងរក សុខ សន្តិភាព នៅ កម្ពុជា កាលពី អតីតកាល និង ការចូលរួមចំណែក អភិវឌ្ឍន៍ កម្ពុជា ។ មិន តែ ប៉ុណ្ណោះ ថ្មី ៗ នេះ បាន ផ្តល់ វ៉ាក់សាំង និង ឧបករណ៍ រក្សាទុក វ៉ាក់សាំង ដល់ កម្ពុជា ជួយ ឱ្យ កម្ពុជា ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ បាន ជោគជ័យ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន សម្តែង នូវ ក្តីរីករាយ ជាមួយ ភាព ជាដៃគូរ វាង កម្ពុជា និង អូស្ត្រាលី ។ ជាពិសេស រីករាយ ដោយ ឃើញ ទំហំ ពាណិជ្ជកម្ម ទ្វេ ភាគី បាន កើនឡើង ក្នុង រង្វង់ ជាង ២០០ លាន ដុល្លារ អាមេរិក ក្នុង មួយ ឆ្នាំ ចាប់តាំងពី ឆ្នាំ ២០១៩ ។
ក្នុង ជំនួប ពិភាក្សា ការងារ នេះ សម្តេច តេជោ បាន ស្នើ អូស្ត្រាលី បង្កើន សកម្មភាព ពាណិជ្ជកម្ម បង្កើន កូតា នាំ អង្ករ ពី កម្ពុជា និង បើក ទីផ្សារ ទទួល ផលិតផល កម្ពុជា ឱ្យ បាន ធំទូលាយ ជាង មុន ដើម្បី ពង្រីក កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ ពាណិជ្ជកម្ម បន្ថែម ទៀត ៕ អូស្ត្រាលី អរគុណ កម្ពុជា ចំពោះ កិច្ចប្រឹងប្រែង ជួយ ដោះស្រាយ បញ្ហា របស់ មីយ៉ាន់ម៉ា
( ភ្នំពេញ ) ៖ រដ្ឋាភិបាល អូស្ត្រាលី តាមរយៈ រដ្ឋមន្ត្រី ការបរទេស របស់ ខ្លួន បាន សម្តែង ការអរគុណ ចំពោះ កម្ពុជា ក្នុង នាម ជា ប្រធាន អាស៊ាន បាន ប្រឹងប្រែង យ៉ាង ខ្លាំង ក្នុង ការជួយ ដោះស្រាយ បញ្ហា របស់ មីយ៉ាន់ម៉ា ។
លោកស្រី ផេននី វង់ រដ្ឋមន្ត្រី ការបរទេស អូស្ត្រាលី បាន ថ្លែងអំណរគុណ ចំពោះ កិច្ចប្រឹងប្រែង របស់ កម្ពុជា ក្នុង ការដោះស្រាយ បញ្ហា របស់ មីយ៉ាន់ម៉ា នេះ ក្នុង ពេល ជួប ពិភាក្សា ការងារ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ល្ងាច ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២២ នេះ ។
តែ ទោះជា យ៉ាងណា កម្ពុជា បាន សោកស្តាយ និង ភ្ញាក់ផ្អើល ចំពោះ ការអនុវត្តន៍ ទោស ប្រហារជីវិត លើ អ្នកទោស នយោបាយ ៤រូប នា ពេល ចុងក្រោយ នេះ ។ ប្រតិកម្ម តប នឹង ឥរិយាបថ នេះ ក្នុង នាម ប្រធាន អាស៊ាន កម្ពុជា បាន បញ្ចេញ ប្រតិកម្ម តាមរយៈ សេចក្តីថ្លែងការណ៍ ផងដែរ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ថ្លែង គូសបញ្ជាក់ ថា បើ ទោះបី មាន ការលំបាក និង ស្មុគស្មាញ យ៉ាងណា ក៏ដោយ ក៏ កម្ពុជា បន្ត ខិតខំ ជួយ មីយ៉ាន់ម៉ា ឱ្យ វិល ទៅរក ប្រក្រតីភាព និង ដំណើរការ តាម គន្លង ប្រជាធិបតេយ្យ ឡើងវិញ ។
សូម បញ្ជាក់ ថា ពាក់ព័ន្ធ នឹង កិច្ចប្រឹងប្រែង របស់ កម្ពុជា ក្នុង ការដោះស្រាយ បញ្ហា របស់ មីយ៉ាន់ម៉ា នេះ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក លោក អាន់តូនី ប្លីង ខេន ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ កិច្ចប្រឹងប្រែង នេះ ផងដែរ ៕ ក្រសួង ការបរទេស បង្ហាញ លទ្ធផល ជំនួប ប្រមុខ ការទូត កម្ពុជា - ចិន
( ភ្នំពេញ ) ៖ ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ ខេត្ត តាកែវ បាន ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
( ភ្នំពេញ ) ៖ ការបើក ឱ្យ គ្រប់ ភាគី ទាំងអស់ ដែល មិន ទាន់ យល់ អំពី ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ ដាក់ សំណើ ដើម្បី ទទួលបាន ការពន្យល់ ពី ក្រសួង យុត្តិធម៌ បាន បិទ បញ្ចប់ ហើយ នៅ ល្ងាច ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២២ នេះ ប៉ុន្តែ មិន មាន ភាគី ណាមួយ បាន ដាក់ សំណើ ដើម្បី សុំ ការពន្យល់ ឡើយ ។
លោក ជិន ម៉ាលីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ បាន អះអាង ថា មូលហេតុ ដែល ភាគី ទាំងនោះ មិន ចូលមក ជជែក ត ទល់ គ្នា នេះ គឺ មាន ន័យ ពីរ យ៉ាង៖
ទី ១៖ ទទួលយក ការពន្យល់ បំភ្លឺ និង ការបកស្រាយ របស់ ក្រសួង នា ពេល កន្លងមក ថា ត្រឹមត្រូវ ។ ទី ២៖ ទទួលស្គាល់ ថា ការដាក់ ញត្តិ និង ការរិះគន់ របស់ ខ្លួន នា ពេល កន្លងមក គឺ មិន ត្រឹមត្រូវ និង ជា ការចោទប្រកាន់ ដែល គ្មាន មូលដ្ឋាន ។
សូម ជំរាប ថា ក្រសួង យុត្តិធម៌ កាលពី ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២២ បាន ប្រកាស អញ្ជើញ បក្ស នយោបាយ ឬ អង្គការ សង្គម ស៊ីវិល ដែល ជំទាស់ ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ មក ទទួល ការពន្យល់ និង បកស្រាយ បំភ្លឺ ដោយ ផ្ទាល់ បន្ថែម ទៀត ជាពិសេស ដើម្បី ជម្រះ ចោល នូវ កង្វល់ ។
ការពន្យល់ និង បកស្រាយ បំភ្លឺ ដោយ ផ្ទាល់ នេះ ត្រូវ ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង យុត្តិធម៌ នៅ រសៀល ថ្ងៃទី ២. ទី៣ និង ទី៤ ខែសីហា ឆ្នាំ ២០២២ ចាប់ពី វេលា ម៉ោង ១៤:៣០ នាទី ត ទៅ អាស្រ័យ ទៅតាម សំណើ និង ពេលវេលា របស់ គណបក្ស នយោបាយ ឬ អង្គការ សង្គម ស៊ីវិល ៕
គម្រោង វិនិយោគ ថ្មី ៗ ចំនួន ៥ទៀត សរុប ទុន វិនិយោគ ជាង ២៥ លាន ដុល្លារ ត្រូវបាន អនុម័ត ឲ្យ ដំណើរការ
( ពោធិ៍សាត់ )៖ លោក ចេង ឡៃ អភិបាល ខេត្ត ស្តីទី តំណាង លោក ជា វ តាយ អភិបាល នៃ គណៈអភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២២ បាន ដឹកនាំ កិច្ចប្រជុំ ឆ្លង របាយការណ៍ ប្រចាំ ខែកក្កដា និង លើក ទិសដៅ សម្រាប់ ខែសីហា ឆ្នាំ ២០២២ របស់ រដ្ឋបាល ខេត្ត ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ធ្វើឡើង នៅ សាល ប្រជុំ ជាន់ ទី១ អគារ រដ្ឋបាល ខេត្ត ដោយ បាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោកស្រី អភិបាល រង ខេត្ត លោក នាយក នាយក រងរដ្ឋ រដ្ឋបាល សាលា ខេត្ត ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ និង មន្ត្រី ដែល មាន ការពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
លោក ណារ៉ា ចំរើន នាយក រដ្ឋបាល សាលា ខេត្ត បាន ជម្រាប ជូន អំពី ការរៀបចំ សេចក្តីព្រាង របាយការណ៍ ប្រចាំ ខែកក្កដា ឆ្នាំ ២០២២ មាន ចំនួន ៩៦ ទំព័រ និង ចែកចេញ ជា ៤ ផ្នែក ធំ ៗ រួម មាន៖ ការគ្រប់គ្រង រដ្ឋបាល ខេត្ត ការងារ របស់ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត បញ្ហា ប្រឈម និង ដំណោះស្រាយ និង លើក ទិសដៅ អនុវត្ត ខែ បន្ត របស់ រដ្ឋបាល ខេត្ត ។
សេចក្តីព្រាង របាយការណ៍ ប្រចាំ ខែកក្កដា នេះ នឹង ត្រូវ ដាក់ ឆ្លង ក្នុង កិច្ចប្រជុំ សាមញ្ញ លើក ទី២ ឆ្នាំ ទី៤ អាណត្តិ ទី៣ របស់ ក្រុមប្រឹក្សា ខេត្ត នា ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២២ ។ តាមរយៈ របៀបវារៈ នេះ ក៏ បាន ធ្វើ ការពិភាក្សា ស្តីពី វឌ្ឍនៈ ភាព សំណូមពរ ករណី ការផ្តល់ សេវា ស្វែងរក ព្រំ ដី នៃ វិស័យ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី និង ផ្សព្វផ្សាយ ស. ជ.ណ លេខ ១៦២២ ចុះ ថ្ងៃទី ០៤ ខែមិថុនា ឆ្នាំ ២០២២ ស្តីពី ការពង្រឹង ការគ្រប់គ្រង ការងារ នៅ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ។
( តូក្យូ ) ៖ ជប៉ុន និង សហរដ្ឋ អាមេរិក នៅ ថ្ងៃសុក្រ នេះ បាន ព្រមព្រៀង ដើម្បី ធ្វើការ ជាមួយគ្នា លើ ការរក្សា សន្តិភាព ស្ថិរភាព នៅក្នុង តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ ដែល កំពុង មាន ភាពតានតឹង កាន់តែ ខ្លាំង ឡើង ចំពោះមុខ ការធ្វើ សមយុទ្ធ យោធា មិន ធ្លាប់ មាន ពីមុន មក របស់ ប្រទេស ចិន រួមទាំង បញ្ហា មី ស៉ីល ៥គ្រាប់ ដែល ធ្លាក់ នៅក្នុង តំបន់ សេដ្ឋកិច្ច ផ្តាច់ មុខ របស់ ជប៉ុន ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃសុក្រ ទី៥ ខែសីហា ឆ្នាំ ២០២២ ។
លោក គីស៉ី ដា បាន បន្ថែម ថា « យើង ក៏ បាន បញ្ជាក់ ពី ការបន្ត កិច្ចសហប្រតិបត្តិការ ជិតស្និទ្ធ ដើម្បី រក្សា សន្តិភាព និង ស្ថិរភាព នៅក្នុង ច្រក សមុទ្រ តៃវ៉ាន់ ដែល ជា ផ្លូវ ដឹកជញ្ជូន ដ៏ សំខាន់ មួយ ផងដែរ » ។
