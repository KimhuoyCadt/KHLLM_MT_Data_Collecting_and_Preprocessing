( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ សារ ជូនពរ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច ក្នុង ឱកាស ដ៏ មហាជ័យ មង្គល ចម្រើន ជន្មាយុ គម្រប់ ៦៩ ឈាន ចូល ៧០ ឆ្នាំ ត្រូវនឹង ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០២២ ។
ក្នុង សារលិខិត របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ដូចត ទៅ៖
ក្នុង ឱកាស ជ័យ មង្គល នៃ ពិធី ខួបកំណើត របស់ លោកជំទាវ គម្រប់ ៦៩ ឆ្នាំ ឈាន ចូល ៧០ ឆ្នាំ ខ្ញុំ និង ភរិយា សូម ជូនពរ ជ័យ បវរ សួស្តី សិរី វឌ្ឍនា វិបុល សុខ ជូន លោកជំទាវ កិតិ្ត សង្គហ បណ្ឌិត សូម មាន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង មាំ មួន ប្រាជ្ញា ស្មារតី ភ្លឺស្វាង មាន អាយុ យឺន យូរ ។
ខ្ញុំ សូម កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ លោកជំទាវ ដែល បាន រួមចំណែក យ៉ាង ធំ ធេង ក្នុង បុព្វហេតុ បម្រើ ប្រទេសជាតិ ។ លោកជំទាវ ជា ថ្នាក់ដឹកនាំ មួយ រូប ពោរពេញ ទៅ ដោយ គុណធម៌ និង គំរូវីរភាព ដ៏ ប្រពៃ ហើយ តែងតែ ខិតខំ ប្រឹងប្រែង លើកស្ទួយ សិទ្ធិ នារី ការពារ អត្តសញ្ញាណ ជាតិ ប្រពៃណី ទំនៀមទំលាប់ និង វប្បធម៌ ដ៏ ល្អ ផូរផង់ និង បាន ចូលរួម គ្រប់ សកម្មភាព ក្នុង ទិសដៅ បម្រើ ឧត្តម ប្រយោជន៍ ជាតិ និង សុខុមាលភាព ប្រជាជន ។
ជាថ្មី ម្ដង ទៀត ខ្ញុំ សូម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ កែវ ទាំង បី វត្ថុ ស័ក្តិសិទ្ធិ ទាំងឡាយ ក្នុង លោក ទេវតា ថែរក្សា ទឹកដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា សូម ព្រះអង្គ តាម ជួយ បីបាច់ ថែរក្សា ប្រទាន ពរ ជ័យ សិរី សួស្តី ជ័យ មង្គល គ្រប់ ប្រការ ជូន ដល់ លោកជំទាវ និង កូនប្រុស កូនស្រី ចៅ ប្រុស ចៅ ស្រី ទាំងអស់ សូម បាន ប្រកបដោយ ព្រះពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សូម លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ទទួល នូវ ការ រាប់អាន អំពី ខ្ញុំ និង ភរិយា »៕ កម្លាំង ចម្រុះ ចុះបង្ក្រាប បទល្មើស ជល ផល រឹបអូស វត្ថុតាង ជាច្រើន និង យក ទៅ បំផ្លាញ ចោល នៅ ស្រុក ឆ្លូង
( ក្រចេះ ) ៖ កម្លាំង ផ្នែក ជល ផល ព្រែក ប្រសព្វ និង មន្ត្រី ខណ្ឌ ជល ផល ក្រចេះ ដឹកនាំ ដោយ លោក ម៉ុក់ ពន្លក នាយ ខណ្ឌ ជល ផល ក្រចេះ នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន សហការ ជាមួយ គណៈ បញ្ជាការ ឯកភាព ស្រុក ឆ្លូង និង សហគមន៍ នេសាទ ចុះ ត្រួតពិនិត្យ បង្ក្រាប បទល្មើស ជល ផល នៅ ចំណុច បឹង ឈើ ទាល ភ្លោះ ឃុំ ព្រែក សាម៉ាន់ ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។
គួរ បញ្ជាក់ ថា កាលពី ខែមិថុនា កន្លងទៅ គ្រោះ ទឹក ជំនន់ ដែល បាន វាយប្រហារ លើ ភាគ ខាងត្បូង ប្រទេស ចិន បាន បង្ខំឱ្យ ប្រជាជន ជាង កន្លះ លាន នាក់ ភៀសខ្លួន ចេញ ពី ផ្ទះសម្បែង ទៅ រក ទី ទួល មាន សុវត្ថិភាព ព្រមទាំង បាន បង្ក ការខូចខាត គិត ជា ទឹកប្រាក់ ២៥០ លាន ដុល្លារ ៕ ទេសរដ្ឋមន្រ្តី គន់ គីម ដឹកនាំ សមាជិក - សមាជិកា នៃ សមាគម អតីត យុទ្ធជន កម្ពុជា អញ្ជើញ គោរព វិញ្ញាណក្ខន្ធ សព លោក ឧត្តមសេនីយ៍ ឯក ធន់ ធឿន
( កំពង់ឆ្នាំង ) ៖ ទេសរដ្ឋមន្រ្តី គន់ គីម អនុប្រធាន និង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា នៅ រសៀល ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ សមាជិក សមាជិកា នៃ សមាគម អតីត យុទ្ធជន កម្ពុជា អញ្ជើញ គោរព វិញ្ញាណក្ខន្ធ សព លោក ឧត្តមសេនីយ៍ ឯក ធន់ ធឿន អនុ រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ អតីត មេបញ្ជាការ តំបន់ ប្រតិបត្ត ការសឹក រង កំពង់ឆ្នាំង និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ឆ្នាំង ដែល បាន ទទួលមរណភាព ។
លោក ថា « ក្នុង ក្តី វិយោគ ដ៏ សែន ក្រៀមក្រំ ស្ទើរ រក ទីបំផុត គ្មាន នេះ យើងខ្ញុំ សូម ចូលរួម សោកស្តាយ ជា ទីបំផុត ចំពោះ ការបាត់បង់ ឯកឧត្តម ធន់ ធឿន ដែល ជា ឥស្សរជន ស្នេហាជាតិ ដ៏ ឧត្តុងឧត្តម ដែល មួយ ជីវិត របស់ ឯកឧត្តម បាន បូជា កម្លាំង កាយ កម្លាំងចិត្ត និង ប្រាជ្ញា ស្មារតី ក្នុង បុព្វហេតុ រំដោះ ប្រទេសជាតិ ប្រជាជន កម្ពុជា ពី របប ប្រល័យ ពូជសាសន៍ ការពារ សុខ សន្តិភាព ជូន ជាតិ មាតុភូមិ និង បាន រួមចំណែក យ៉ាង សកម្ម ក្នុង ការស្តារ និង អភិវឌ្ឍ ប្រទេសជាតិ ឱ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ » ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ ចេញផ្សាយ កាលពី ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ទៅកាន់ ក្រុម អ្នកគាំទ្រ របស់ ខ្លួន លោក ដូណាល់ ត្រាំ បាន បដិសេធ ថា លោក មិន បាន លួច លាក់ ទុក ឯកសារ សម្ងាត់ ពាក់ព័ន្ធ នឹង អាវុធ នុយក្លេអ៊ែរ ដូច ដែល ប្រព័ន្ធ ផ្សព្វផ្សាយ បាន ចុះផ្សាយ យ៉ាង ព្រោងព្រាត នោះ ទេ ។ តែ ក្នុង ពេល ព្យាយាម ដោះសាយក រួច ខ្លួន នោះ ដែរ អតីត ប្រធានាធិបតី អាមេរិក រូប នេះ បែរជា ឆ្លៀត ចោទប្រកាន់ ថា លោក បារ៉ាក់ អូបាម៉ា ក៏ ធ្លាប់ បាន លួច លាក់ ទុក ឯកសារ សម្ងាត់ ដែរ នៅពេល លោក ចាកចេញ ពី សេតវិមាន ។
លោក ដូណាល់ ត្រាំ បាន គូសបញ្ជាក់ នៅក្នុង សេចក្ដីថ្លែងការណ៍ ដូច្នេះ ថា « លោក ប្រធានាធិបតី បារ៉ាក់ អូបាម៉ា ធ្លាប់ បាន រក្សាទុក ឯកសារ ជាង ៣៣លាន ទំព័រ ហើយ ក្នុង នោះ ភាគ ច្រើន ជា ឯកសារ សម្ងាត់ ជាតិ ។ ថា តើ នៅក្នុង ចំណោម ឯកសារ ទាំងនោះ មាន ពាក់ព័ន្ធ នឹង នុយក្លេអ៊ែរ ច្រើន ប៉ុន ណា ទៅ ? ពោលគឺ វា មាន ច្រើន ណាស់ » ។
ក៏ប៉ុន្តែ ឆ្លើយតប ទៅនឹង ការចោទប្រកាន់ របស់ លោក ដូណាល់ ត្រាំ មជ្ឈមណ្ឌល ឯកសារជាតិ អាមេរិក បាន អះអាង ថា លោក បារ៉ាក់ អូបាម៉ា មិន មាន លួច លាក់ ទុក ឯកសារ សម្ងាត់ ដូច លោក ត្រាំ ចោទប្រកាន់ នោះ ទេ ៕
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ផ្ញើ សារ ជូនពរ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ក្នុង ឱកាស ចម្រើន ជន្មាយុ គម្រប់ ៦៩ ឈាន ចូល ៧០ ឆ្នាំ
ដោយ ផ្អែក លើ ប្រភព ដែល ខ្លួន ទទួលបាន សារព័ត៌មាន Nikkei បាន ឱ្យដឹង ទៀត ថា វា នឹង ក្លាយជា ដំណើរទស្សនកិច្ច ជា លើក ដំបូង មកកាន់ ប្រទេស ជប៉ុន របស់ លោកស្រី ហារី ស ក្នុង នាម ជា អនុប្រធានាធិបតី អាមេរិក ខណៈ លោកស្រី ក៏ ត្រូវបាន គេ រំពឹង ដែរ ថា នឹង ជួបពិភាក្សា ការងារ ជាមួយ នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក គីស៊ី ដា ហ្វូមី អុ ។
បន្ថែម ពីលើ នេះ អតីត ប្រធានាធិបតី អាមេរិក លោក បារ៉ាក់ អូបាម៉ា ប្រធានាធិបតី បារាំង លោក ម៉ាក្រុង រួមទាំង អតីត អធិការបតី អាល្លឺម៉ង់ លោកស្រី មឺ គែល ក៏ នឹង មាន វត្តមាន នៅក្នុង ពិធី បុណ្យ សព្វ ថ្នាក់ ជាតិ របស់ លោក អាបេ ដែរ ហើយ ទីក្រុង តូក្យូ នឹង ប្រកាស ពី បញ្ជី ឈ្មោះ អ្នកចូលរួម នៅមុន ពិធី បុណ្យ ចាប់ផ្ដើម ជា ផ្លូវការ ។
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ ផ្ញើ សារ គោរព ជូនពរ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច ក្នុង ឱកាស ដ៏ មហាជ័យ មង្គល ចម្រើន ជន្មាយុ គម្រប់ ៦៩ ឈាន ចូល ៧០ ឆ្នាំ ត្រូវនឹង ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០២២ ។
( តាកែវ )៖ សិស្ស វិទ្យាល័យ ជា ស៊ីម តាកែវ ដែល បញ្ចប់ ការសិក្សា ឆ្នាំ ២០០៥ នៅ ព្រឹក ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន នាំយក ថវិកា ជាង ១.៣០០ ដុល្លារ ជូន ដល់ លោកគ្រូ ទ្រី ឆាយ នាយក វិទ្យាល័យ ជា ស៊ីម តាកែវ សម្រាប់ ចូលរួម កែលម្អ ចាក់ សាប និង រៀបការ៉ូឡា នៅ បរិវេន សាលារៀន ដើម្បី ពង្រីក សោភ័ណ្ឌភាព នៅក្នុង សាលារៀន ឲ្យ កាន់តែ មាន ភាពស្រស់បំព្រង និង ល្អ ស្អាត ។
តំណាង សិស្ស វិទ្យាល័យ ជា ស៊ីម តាកែវ ដែល បញ្ចប់ ឆ្នាំ សិក្សា ២០០៥ បាន ថ្លែង នូវ ការ នឹករលឹក ដល់ សាលារៀន ក៏ ដូចជា លោកគ្រូ - អ្នកគ្រូ ដែល បាន ធ្លាប់ បង្ហាត់ បង្រៀន ហើយ ថវិកា ទាំងនោះ គឺជា ការរួមចំណែក បន្ដិចបន្ដួច ក្នុង ការអភិវឌ្ឍន៍ នៅ សាលារៀន ដែល ជា កន្លែង បណ្ដុះបណ្ដាល ផ្ដល់ ចំណេះដឹង ដើម្បី ពួកគេ យក ចំណេះដឹង ទៅ ប្រើប្រាស់ ជាដើមទុន សម្រាប់ ជីវភាព ក្នុង ការប្រកបរបរ ចិញ្ចឹម ជីវិត ប្រចាំ ថ្ងៃ ។
លោកគ្រូ ទ្រី ឆាយ នាយក សាលា វិទ្យាល័យ ជា ស៊ីម បាន លើកឡើង ថា សកម្មភាព របស់ អតីត សិស្ស ជំនាន់ មុន គឺជា គំរូល្អ ដល់ ក្មេង ជំនាន់ ក្រោយ បន្ទាប់ពី ពួកគាត់ បញ្ចប់ ការសិក្សា នៅ សាលា រហូតមក ពួកគាត់ អាច មាន លទ្ធភាព ជួយ ដល់ ខ្លួន ឯង ជួយ ដល់ ក្រុមគ្រួសារ និង រហូត ឈាន មកដល់ ជួយ ដល់ សង្គមជាតិ បន្ថែម ទៀត ជាពិសេស ការជួយ អភិវឌ្ឍន៍ ដល់ សាលារៀន ដែល ខ្លួន ធ្លាប់ រៀន ផងដែរ ។
ជាមួយគ្នា នេះ ផងដែរ លោក នាយក ទ្រី ឆាយ បាន បន្ត សូម អំពាវនាវ ដល់ អតីត សិស្ស ជំនាន់ មុន ដែល មាន លទ្ធភាព មេត្តា ចូលរួមគ្នា ជួយ អភិវឌ្ឍន៍ ដល់ អតីត សាលារៀន របស់ ខ្លួន ទុក បង្ហាញ សម្រាប់ ក្មេង ៗ ជំនាន់ ក្រោយ ជា អ្នក បន្ត វេន ៕
លោក ហ៊ុន ម៉ានី៖ បក្ស ប្រឆាំង តែង សាកល្បង បំបែក សាមគ្គី បក្ស ប្រជាជន កម្ពុជា តែ អង្គការ ចាត់តាំង បក្ស នៅតែ រឹងមាំ
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី សមាជិក នៃ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា បាន គូស រំលេច ថា បក្ស ប្រឆាំង តែងតែ សាកល្បង បំបែក កម្លាំង សមាគ្គី គណបក្ស ប្រជាជន កម្ពុជា តែ បំណង របស់ ពួកគេ មិន បាន សម្រេច ហើយ សាមគ្គីភាព របស់ ថ្នាក់ដឹកនាំ សមាជិក សមាជិក របស់ បក្ស នៅតែ រឹងមាំ ដូច ដែក ថែប គ្មាន កម្លាំង ណា បំបែក បាន ឡើយ ។
លោក ហ៊ុន ម៉ានី អគ្គ លេខាធិការ គណៈ ចលនា មហាជន នៃ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា បាន គូស រំលេច បែប នេះ នៅក្នុង សិក្ខាសាលា ស្តីពី « ការចែករំលែក និង ការផ្លាស់ប្តូរ បទពិសោធ លើ ការងារ ព័ត៌មាន និង ការផ្សព្វផ្សាយ មហាជន ក្នុង បរិបទ ឌីជីថល » នា ព្រឹក ថ្ងៃអាទិត្យ ទី ១៤ ខែសីហា ឆ្នាំ ២០២២ នេះ ។
ពាក់ព័ន្ធ នឹង ការបំបែក សាមគ្គីភាព របស់ គណបក្ស ប្រជាជន កម្ពុជា នេះ សម្តច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក៏ ធ្លាប់ បាន គូស រំលេច ផងដែរ ថា តាំងពី ទសវត្សរ៍ ៨០ មក ម្ល៉េះ ក្រុម ប្រឆាំង តែង សាកល្បង បំបែកបំបាក់ សាមគ្គីភាព ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ។ តែ បំណង នោះ មិន ទទួលបាន ជោគជ័យ ផ្ទុយទៅវិញ គណបក្ស ប្រជាជន កម្ពុជា កាន់តែ រឹងមាំ ខ្លាំង ឡើង ។
លោក បាន លើកទឹកចិត្ត សមាជិក សមាជិកា គណបក្ស ទាំងអស់ ឱ្យ ចេះ សម្រួច និង ស្វែងរក វិធីសាស្ត្រ នៃ ការរៀបចំ ខ្លឹមសារ ពិត ទាក់ទាញ ស្រប ជាមួយ តម្រូវការ របស់ ប្រជាជន និង ចំក្រុម គោលដៅ ហើយ ដែល ជា ព័ត៌មាន មាន ហេតុ មាន ផល មាន ប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន រៀង ៗ ខ្លួន ។
សូម បញ្ជាក់ ថា នៅ វិមាន ៧មករា ទី បញ្ជាការ ធំ របស់ គណបក្ស ប្រជាជន កម្ពុជា បាន រៀបចំ សិក្ខាស្តីពី « ការចែករំលែក និង ផ្លាស់ប្តូរ បទពិសោធន៍ លើ ការងារ ព័ត៌មាន និង ការផ្សព្វផ្សាយ មហាជន ក្នុង បរិបទ ឌីជីថល » រយៈពេល មួយ ថ្ងៃ កន្លះ ។
ពិធី បើក សិក្ខាសាលា នេះ ត្រូវបាន ធ្វើឡើង នៅ ថ្ងៃទី ១៣ ខែសីហា ម្សិលមិញ នេះ ក្រោម អធិបតីភាព លោកស្រី ម៉ែន សំអន អនុប្រធាន គណបក្ស និង ជា ប្រធាន គណៈ ចលនា មហាជន នៃ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ។
សិក្ខាសាលា នេះ មាន ការចូលរួម ពីសំណាក់ រចនាសម្ព័ន្ធ គណៈ ចលនា មហាជន រាជធានី - ខេត្ត ក្រុង ស្រុក ខណ្ឌ . ជន បង្គោល ទទួលបន្ទុក ការងារ ចលនា មហាជន ពី បណ្តា គណបក្ស ក្រសួង - ស្ថាប័ន . រចនាសម្ព័ន្ធ ផ្សព្វផ្សាយ របស់ រាជ រដ្ឋាភិបាល និង គណបក្ស ប្រមាណ ជាង ៧០០ នាក់ ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង លោក ត ហ៊ើរ អ៊ូម៊ើរ ប្រធាន សមាគម ប្រភព ល្អ កម្ពុជា ជា ទីប្រឹក្សា សម្តេច ក្រឡាហោម ស ខេង
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង លោក ត ហ៊ើរ អ៊ូម៊ើរ ប្រធាន សមាគម ប្រភព ល្អ កម្ពុជា ជា ទីប្រឹក្សា សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ មាន ឋានៈ ស្មើ អគ្គ នាយក ។ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២២ នេះ ៕
ការ គូស រំលេច របស់ លោក អ្នកនយោបាយ វ័យ ក្មេង របស់ គណបក្ស ប្រជាជន កម្ពុជា រូប នេះ បាន ធ្វើឡើង ក្នុង គ្រា ដែល គណបក្ស ប្រជាជន កម្ពុជា កំពុង រៀបចំ សិក្ខាសាលា ស្តីពី « ការចែករំលែក និង ផ្លាស់ប្តូរ បទពិសោធន៍ លើ ការងារ ព័ត៌មាន និង ការផ្សព្វផ្សាយ មហាជន ក្នុង បរិបទ ឌីជីថល » ។
នៅក្នុង សិក្ខាសាលា នា ព្រឹក ថ្ងៃអាទិត្យ នេះ លោក ហ៊ុន ម៉ានី ដែល មាន តួនាទី ជា អគ្គ លេខាធិការ គណៈ ចលនា មហាជន ដែរ នោះ បាន ប្រាប់ សកម្មជន គណបក្ស ប្រជាជន ដែរ ថា ការធ្វើ នយោបាយ ជាពិសេស តាមរយៈ ការផ្សព្វផ្សាយ ត្រូវ ធ្វើ ជាមួយ ប្រជាសាស្ត្រ ផង ភូមិសាស្ត្រ ផង និង ស្រប ជាមួយ បរិបទ ផង ។
លោក បាន លើកទឹកចិត្ត និង ផ្តាំផ្ញើ ឲ្យ សមាជិក សមាជិកា គណបក្ស ទាំងអស់ ត្រូវ ចេះ សម្រួច និង ស្វែងរក វិធីសាស្ត្រ នៃ ការរៀបចំ ខ្លឹមសារ ពិត ទាក់ទាញ ស្រប ជាមួយ តម្រូវការ របស់ ប្រជាជន ហើយ ដែល ជា ព័ត៌មាន ដែល មាន ប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ ។ លោក បាន សង្កត់ធ្ងន់ ថា៖ « ទាំងនេះ នឹង អាច ចូលរួម លុបបំបាត់ ព័ត៌មាន មិន ពិត ព័ត៌មាន ទុច្ចរិត នានា ក្នុង គោលបំណង ញុះញង់ បំបែកបំបាក់ សាមគ្គី ឯកភាព ជាតិ ដែល នឹង អាច បង្កឲ្យ មាន ភាព ច្របូល ច្របល់ ក្នុង សង្គម » ។
សូម បញ្ជាក់ ថា នៅ វិមាន ៧មករា ទី បញ្ជាការ ធំ របស់ គណបក្ស ប្រជាជន កម្ពុជា បាន រៀបចំ សិក្ខាស្តីពី « ការចែករំលែក និង ផ្លាស់ប្តូរ បទពិសោធន៍ លើ ការងារ ព័ត៌មាន និង ការផ្សព្វផ្សាយ មហាជន ក្នុង បរិបទ ឌីជីថល » រយៈពេល មួយ ថ្ងៃ កន្លះ ។
សហរដ្ឋ អាមេរិក ថា នឹង មិន បោះបង់ ចោល មជ្ឈិមបូព៌ា ទេ ខណៈ លោក ស៊ី ជិន ពីង ត្រូវ គេ រំពឹង ថា នឹង ធ្វើ ទស្សនកិច្ច ទៅកាន់ អារ៉ាប៊ី សាអូឌីត
( វ៉ាស៊ីនតោន ) ៖ រដ្ឋបាល ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ បាន ច្រានចោល ការលើកឡើង ដែល ថា ដំណើរទស្សនកិច្ច របស់ ប្រធានាធិបតី ចិន លោក ស៊ី ជិន ពីង ទៅកាន់ ប្រទេស អារ៉ាប៊ី សាអូឌីត នៅក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ គឺជា សញ្ញា បង្ហាញ ថា សហរដ្ឋ អាមេរិក កំពុង បាត់បង់ ឥទ្ធិពល ក្នុង តំបន់ មជ្ឈិមបូព៌ា ជាមួយ ការទទូច ថា អាមេរិក នឹង មិន បោះបង់ ចោល តំបន់ នេះ ឡើយ ។ នេះ បើ តាម ការដកស្រង់ ចេញផ្សាយ ចេញ ពី សារព័ត៌មាន CNBC នៅ ថ្ងៃសៅរ៍ ទី ១៤ ខែសីហា ឆ្នាំ ២០២២ ។
លោក ធី ម លែន ឌឺ ឃីង (Tim Lenderking) ជា បេសកជន ពិសេស អាមេរិក សម្រាប់ ប្រទេស យេម៉ែន ធ្វើការកត់សម្គាល់ ខាងលើ នៅក្នុង កិច្ចសម្ភាសន៍ ជាមួយ សារព័ត៌មាន CNBC អម ដោយ ការ សង្កត់ធ្ងន់ បន្ថែម ថា ដំណើរទស្សនកិច្ចការ ទូត របស់ មេដឹកនាំ នៃ ប្រទេសជា មហាអំណាច ទៅកាន់ ប្រទេស ណាមួយ វា មិន មែន ជា រឿង ចម្លែក នោះ ទេ ប៉ុន្តែ សហរដ្ឋ អាមេរិក បាន ប្ដេជ្ញាចិត្ត របស់ ខ្លួន ចំពោះ តំបន់ មជ្ឈិមបូព៌ា រួចហើយ តាមរយៈ ដំណើរទស្សនកិច្ច របស់ លោក ប្រធានាធិបតី ចូ បៃ ដិន កាលពី ខែកក្កដា កន្លងទៅ ។
ប្រតិកម្ម របស់ ក្រសួង ការបរទេស កូរ៉េ ខាងជើង ដែល ធ្វើឡើង នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ ចេញផ្សាយ ដោយ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ KCNA កើត មាន ឡើង បន្ទាប់ពី លោក អាន់តូនីញ៉ូ ហ្គូទែរ រ៉ែស កាលពី ថ្ងៃសុក្រ កន្លងទៅ នេះ បាន បង្ហាញ ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ការរំសាយ អាវុធ នុយក្លេអ៊ែរ របស់ កូរ៉េ ខាងជើង ទាំងស្រុង ក្នុង ជំនួប ជាមួយ ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក យូន ស៊ុក យុល (Yoon Suk-yeol) ។
គួរ បញ្ជាក់ ថា ក្នុង ឆ្នាំ ២០២២ នេះ កូរ៉េ ខាងជើង បាន បាញ់ សាកល្បង មីស៊ីល រាប់ សិប គ្រាប់ ខណៈ ក្រុម មន្ត្រី កូរ៉េ ខាងត្បូង និង សហរដ្ឋ អាមេរិក បាន និយាយ ថា របប ដឹកនាំ លោក គីម ជុង អ៊ុន កំពុង ត្រៀមខ្លួន ធ្វើតេស្ដ អាវុធ នុយក្លេអ៊ែរ ជា លើក ដំបូង ចាប់តាំងពី ឆ្នាំ ២០១៧មក ៕
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ត្រឡប់មក ផ្ទះ វិញ ដោយ សុវត្ថិភាព ! ស្លាប់ ៣នាក់ និង របួស ១៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៣ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ១៥នាក់ ។
គួរ បញ្ជក់ ថា បើ ក្រសួង សុខាភិបាល សិង្ហបុរី . នៅ ថ្ងៃសៅរ៍ នេះ មាន អ្នកជំងឺ កូវីដ ១៩ ចំនួន ៤នាក់ បាន ស្លាប់ ដែល នាំឲ្យ ចំនួន អ្នកស្លាប់ សរុប កើនឡើង ដល់ ១. ៥៥៦ នាក់ ៕
ក្រសួង សុខាភិបាល វៀតណាម បាន ឲ្យដឹង ថា បូករួម ទាំង ការឆ្លង ថ្មី ខាងលើ នេះ នាំឲ្យ ចំនួន អ្នក ឆ្លង សរុប ចាប់តាំងពី ជំងឺ រាតត្បាត មក កើនឡើង ដល់ ១១. ៣៦៤. ៣៥៥ នាក់ ។ ជាមួគ្នា នេះ មាន អ្នកជំងឺ កូវីដ១៩ ម្នាក់ បាន ស្លាប់ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ នេះ ។ អ្នកស្លាប់ សរុប មាន ចំនួន ៤៣. ០៩៧ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២២ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៥. ១៤៨. ០២៨ នាក់ ។ ក្នុង នោះ រួម មាន៖
កងកម្លាំង អន្តរាគមន៍ សង្គ្រោះ លេខ ៧១១ បន្ត សកម្មភាព ចុះ បាញ់ ថ្នាំ សម្លាប់ មេរោគ កូវីដ នៅ គោលដៅ មួយចំនួន ក្នុង ក្រុង ព្រះសីហនុ
( ព្រះសីហនុ) ៖ កងកម្លាំង អន្តរាគមន៍ សង្គ្រោះ លេខ ៧១១ មកពី សាលា ហ្វឹកហ្វឺន មិត្តភាព សង្គ្រោះ កម្ពុជា - ជប៉ុន កងពល តូច លេខ ៧០ ប្រចាំ ការនៅ ខេត្ត ព្រះសីហនុ នា រសៀល ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២២ បាន បន្ត សកម្មភាព ចុះ បាញ់ ថ្នាំ សម្លាប់ មេរោគ ការពារ ជំងឺ ឆ្លង កូវីដ១៩ តាម គោលដៅ មួយចំនួន ក្នុង ក្រុង ព្រះសីហនុ ។
បើ តាម ការលើកឡើង របស់ លោក វរសេនីយ៍ ត្រី គីម ណៃ ដែល ដឹកនាំ កម្លាំង ចុះ ផ្ទាល់ បាន ឲ្យដឹង ថា ក្នុង ការចូលរួម ទប់ស្កាត់ ការពារ ជំងឺ ឆ្លង កូវីដ១៩ នេះ កម្លាំង អន្តរាគមន៍ សង្គ្រោះ លេខ ៧១១ សាលា ហ្វឹកហ្វឺន មិត្តភាព សង្គ្រោះ កម្ពុជា - ជប៉ុន កងពល តូច លេខ ៧០ បាន ចុះ ធ្វើ សកម្មភាព ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ សកម្មភាព បាញ់ ថ្នាំ សម្លាប់ មេរោគ តាម មន្ទីរពេទ្យ ទីផ្សារ សាធារណៈ និង តាម លំនៅដ្ឋាន ពលរដ្ឋ ជា បន្តបន្ទាប់ ក្នុង ក្រុង ព្រះសីហនុ ។
ក្នុង ការចុះ ធ្វើ សកម្មភាព ខាងលើ នេះ ដែរ សាលា ហ្វឹកហ្វឺន មិត្តភាព សង្គ្រោះ កម្ពុជា - ជប៉ុន កងពល តូច លេខ ៧០ ក៏ មាន ការសង្គ្រោះ ដោយ ពុំ មាន ការបង់ប្រាក់ ទៅ លើ គ្រោះថ្នាក់ ឬ គ្រោះមហន្តរាយ ផ្សេង ៗ មាន ដូចជា គ្រោះថ្នាក់ អគ្គីភ័យ គ្រោះថ្នាក់ ចរាចរណ៍ គ្រោះ ទឹក ជំនន់ ឬ គ្រោះថ្នាក់ រលំបាក់ អាគារ ជាដើម ។
លោក កិត្តិ សេដ្ឋា បណ្ឌិត ជា ម យៀប ជួប សម្តែង ការគួរសម ជាមួយ អនុប្រធានាធិបតី ឥណ្ឌា នាទីក្រុង ញូដេលី
លោក កិត្តិ សេដ្ឋា បណ្ឌិត ជា ម យៀប ប្រធាន គណៈប្រតិភូ បាន សម្តែង មនោសញ្ចេតនា រីករាយ ពេញចិត្ត និង គាំទ្រ ចំពោះ ការលើកឡើង របស់ ភាគី ឥណ្ឌា និង បាន អបអរសាទរ យ៉ាង ក្លៀវក្លា ចំពោះ ឯកឧត្តម ដែល បាន ជាប់ ឆ្នោត ជា អនុប្រធានាធិបតី ឥណ្ឌា និង ជា ប្រធាន សភា ជាន់ ខ្ពស់ ឥណ្ឌា ជាពិសេស បាន ចំណាយ ពេលវេលា លើក ដំបូង គេ ក្នុង នាម ជា អនុប្រធានាធិបតី ទទួល ជួប គណៈប្រតិភូ អាយ ប៉ា នៅ ពេល នេះ ។
លោក កិត្តិ សេដ្ឋា បណ្ឌិត ប្រធាន គណៈប្រតិភូ បាន ផ្តល់ ឱកាស ឱ្យ សមាជិក គណៈប្រតិភូ ប្រទេស សមាជិក អាយ ប៉ា បាន រួមចំណែក ផ្តល់ ទស្សនៈ យល់ឃើញ នានា ជុំវិញ ផល វិជ្ជមាន នៃ ទំនាក់ទំនង មិត្តភាព អាស៊ាន - ឥណ្ឌា និយាយ ជា រួម និង ផលប្រយោជន៍ ផ្ទាល់ រវាង ឥណ្ឌា និង ប្រទេស សាមី នីមួយ ៗ និយាយ ដោយឡែក ជាមួយ ការប្តេជ្ញាចិត្ត បន្ត ជម្រុញ និង លើកទឹកចិត្ត អោយ ស្ថាប័ន នីតិប្រតិបត្តិ ឥណ្ឌា - អាស៊ាន ខិតខំ ពង្រឹង និង ពង្រីក ទំនាក់ទំនង នេះ ថែម ទៀត ។
បន្ទាប់ពី ជំនួប ខាងលើ លោក កិត្តិ សេដ្ឋា បណ្ឌិត ប្រធាន គណៈប្រតិភូ បាន ដឹកនាំ គណៈប្រតិភូ អាយ ប៉ា ផ្តល់ បទសម្ភាសន៍ ជាមួយ ស្ថានីយ៍ ទូរទស្សន៍ ក្នុង ស្រុក និង ទូរទស្សន៍ សភា របស់ ឥណ្ឌា ។ ក្នុង បទសម្ភាសន៍ លោក ប្រធាន បាន ជម្រាប ពី លទ្ធផល នៃ ជំនួប ទាំឡាយ ជាមួយ ថ្នាក់ដឹកនាំ ឥណ្ឌា ក៏ ដូចជា ការទៅ ទស្សនា ទី តាំង ប្រវត្តិសាស្រ្ត របស់ ឥណ្ឌា និង បាន ចាត់តាំង អោយ គណៈប្រតិភូ សមាជិក សភា តំណាង ប្រទេស នីមួយ ៗ ចូលរួម ជួប សម្ភាសន៍ ដោយ ផ្ទាល់ ទៀតផង ។
នៅក្នុង អំឡុង ពេល នៃ ដំណេីរទស្សនកិច្ច នេះ ក៏ មាន ចេញ នូវ ប្រកាស ព័ត៌មាន រួម ស្តីពី លទ្ធផល នៃ ដណេី រទស្សនកិច្ច ជា ផ្លូវការ និង មិត្តភាព របស់ គណៈប្រតិភូ អន្តរសភា អាស៊ាន នៅ សាធារណរដ្ឋ ឥណ្ឌា ផងដែរ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៨ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី . ជួញដូរ ៨ករណី . ដឹកជញ្ជូន រក្សាទុក ៣ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ៥២ នាក់ ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង លោក ប៊ុន លីដាវុធ ជា អនុ រដ្ឋលេខាធិការ នៃ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង លោក ប៊ុន លីដាវុធ ជា អនុ រដ្ឋលេខាធិការ នៃ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នា ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២២ នេះ ។
លោក Wang Yi សមាជិក ក្រុមប្រឹក្សា កិច្ចការ រដ្ឋ និង ជា រដ្ឋមន្ត្រី ការបរទេស ចិន ផ្តល់ បទសម្ភាសន៍ ជាមួយ ប្រព័ន្ធ ផ្សព្វផ្សាយ មជ្ឈិម ចិន
ទាក់ទិន នឹង គំនិត ឯកភាព រួម ដ៏ សំខាន់ ដែល សម្រេចបាន ក្នុង ដំណើរទស្សនកិច្ច នៅ កម្ពុជា លោក Wang Yi បាន មានប្រសាសន៍ ថា ប្រទេស ចិន និង កម្ពុជា ជា ប្រទេស ជិតខាង ដ៏ សំខាន់ និង ជា មិត្ត ដែក ថែប ។ ក្នុង ដំណើរទស្សនកិច្ច លើក នេះ ភាគី កម្ពុជា បាន បង្ហាញ ពី គោលជំហរ យ៉ាង ច្បាស់ អំពី ការប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ ចិន តែ មួយ ប្រឆាំង យ៉ាង ដាច់ខាត នូវ រាល់ ពាក្យ សម្តី ឬ ទង្វើ ណាមួយ ដែល រំលោភ លើ អធិបតេយ្យភាព និង បូរណភាព ទឹកដី របស់ ចិន ហើយ នឹង ឈរ យ៉ាង រឹងមាំ ជាមួយ ប្រជាជន ចិន ជាង ១.៤ ពាន់ លាន នាក់ ។
ជា ចុងក្រោយ លោក Wang សង្កត់ធ្ងន់ ថា ភាគី ទាំង ពីរ បាន ឯកភាព គ្នា លើ ការយក គំនិត ឯកភាព រួម របស់ ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ ធ្វើជា គោលការណ៍ ណែនាំ និង ឆ្លៀត ឱកាស ពិភាក្សា អំពី ការចុះហត្ថលេខា លើ ផែនការ ប្រតិបត្តិការ ថ្មី អំពី សហគមន៍ រួម វាសនា ដើម្បី គាំទ្រ គ្នា ទៅ វិញទៅ មក យ៉ាង ម៉ឺងម៉ាត់ ក្នុង ការបន្ត ផ្លូវ អភិវឌ្ឍន៍ ដែល សមស្រប នឹង ស្ថានភាព ជាតិ រៀង ៗ ខ្លួន និង នាំមុខ ក្នុង ការជំរុញ ការអនុវត្ត យ៉ាង ជាក់ស្តែង នូវ គំនិត ផ្តួចផ្តើម អភិវឌ្ឍន៍ សកល និង គំនិត ផ្តួចផ្តើម សន្តិសុខ សកល ៕
វិទ្យុ មិត្តភាព កម្ពុជា ចិន លោក បណ្ឌិត សឹង សំណាង ជំរុញ ឲ្យ ក្រុមប្រឹក្សា ឃុំ ដែល ទើប ជាប់ ឆ្នោត នៅ ស្រុក កំពង់លែង ត្រូវ ខិតខំ ប្រឹងប្រែង បម្រើ ប្រជាពលរដ្ឋ
បន្ទាប់ពី លោក ប្រធាន គណបក្ស ប្រជាជន ស្រុក កំពង់លែង បាន ឡើង អាន របាយការណ៍ ជូន អង្គ សន្និបាត រួច មក លោក ឌួង សុវ៉ាង តំណាងរាស្ត្រ ខេត្ត កំពង់ឆ្នាំង អនុប្រធាន ទី១ ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ស្រុក កំពង់លែង បាន ឡើង ថ្លែង បញ្ចេញមតិ ពី សកម្មភាព បោះឆ្នោត ឃុំ សង្កាត់ ក្នុង បំណង ស្វែងរក ប្រសិទ្ធភាព និង ប្រជាប្រីយភាព ក្នុង ការបោះឆ្នោត នា ពេល ខាងមុខ នេះ ។
លោក ឡុច សុវណ្ណារ៉ា អនុប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ស្រុក កំពង់លែង ក៏ បាន ថ្លែង នូវ ការ ក្រើន រំលឹក ដល់ សមាជិក គណបក្ស ប្រជាជន ត្រូវ ចូលរួម ប្រមែប្រមូល ប្រជាពលរដ្ឋ ក្នុង សហគមន៍ របស់ ខ្លួន ឲ្យ ចូលរួម ការបោះឆ្នោត ឲ្យបាន សកម្ម ជាពិសេស អស់ លោក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ថ្មី ប្រឹងប្រែង បម្រើ ប្រជាជន និង អនុវត្ត ភូមិ ឃុំ មាន សុវត្ថិភាព ឲ្យបាន ល្អ ប្រសើរ ។
លោក បណ្ឌិត សឹង សំណាង ក្នុង ឱកាស នោះ ក៏ បាន ផ្ដាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពី ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ដែល តែង យកចិត្តទុកដាក់ សុខ ទុក្ខ ប្រជាពលរដ្ឋ នៅ គ្រប់ កាលៈទេសៈ ។ លោក បណ្ឌិត បាន ថ្លែង ពី សភាពការណ៍ វិវឌ្ឍន៍ និង ការធានា បាន នូវ នយោបាយ សន្តិសុខ សាធារណ: ជា អំណោយផល ដល់ ការអភិវឌ្ឍ ប្រទេស ។ ចំណុច មួយ ទៀត ដែល ជា ភាពអសកម្ម ក្នុង ការអភិវឌ្ឍ ប្រទេស នោះ គឺ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ដែល ជា ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ដល់ សេដ្ឋកិច្ច សកល ។
* ទី១៖ ករណី ភ្លើង ស្តុប៖ បើសិន ភ្លើង ស្តុប ពណ៌ ក្រហម អ្នកបើកបរបត់ ស្តាំ ក្នុង ស្ថានភាព គ្មាន គ្រោះថ្នាក់ សូម កុំ ផាក ពិន័យ * ទី២៖ ករណី ភ្លើង លឿង៖ នៅពេល អ្នកបើកបរ ជិះ ហួស គំនូស ផ្លូវ ដើរ ទើប លោត ភ្លើង លឿង ក៏ សូម កុំ ផាក ពិន័យ គឺ ត្រូវ អប់រំ ណែនាំ * ទី៣៖ ចំណែក នគរបាល នៅ តាម គោលដៅ សម្រួល ចរាចរណ៍ សូម កុំ ឲ្យ ក្លាយទៅជា គោលដៅ អនុវត្តន៍ ច្បាប់ ចរាចរណ៍ ។
