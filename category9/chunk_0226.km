( ភ្នំពេញ ) ៖ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន អនុញ្ញាតឲ្យ លោក រស់ ថាន់ សន អនុ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន រួម ជាមួយ អតីត សហការី ក្នុង កាសែត កម្ពុជា ចូល ជួប ជូនពរ ថ្ងៃ ខួបកំណើត គម្រប់ ៧០ ឈាន ចូល ៧១ ឆ្នាំ របស់ រដ្ឋមន្ត្រី និង សុំ អនុសាសន៍ ដើម្បី បំពេញ កិច្ចការងារ បន្ត ទៅ មុខ ទៀត នៅ ព្រឹក ថ្ងៃទី ០៦ ខែកញ្ញា ឆ្នាំ ២០២២នេះ នាទី ស្តីការ ក្រសួង ព័ត៌មាន ។
ជាមួយគ្នា នោះ លោក រដ្ឋមន្រ្តី ខៀវ កាញារីទ្ធ បាន សម្ដែង នូវ ការរីករាយ ដោយ បាន ជួបជុំ សំណេះសំណាល គ្នា ជាថ្មី ម្តង ទៀត ជាមួយ អ្នក ធ្លាប់ បំពេញ កិច្ចការងារ ជាមួយគ្នា នៅ កាសែត កម្ពុជា តាំងពី យូរ មកហើយ តែ ទោះបី ឥឡូវ បាន បំពេញ ការងារ នៅ ស្ថាប័ន ផ្សេង ៗ គ្នា ក្តី តែ បាន ឆ្លៀត ពេល យូរ ៗ ម្តង ជួបជុំ សួរសុខទុក្ខ គ្នា ទៅ វិញ ទៅមក ។
លោក រដ្ឋមន្រ្តី បាន បញ្ជាក់ ថា អ្វី ដែល សំខាន់ សម្រាប់ យើង ទាំងអស់ គ្នា នា ពេលនេះ គឺ ការថែរក្សា សុខភាព ឲ្យ ល្អ ព្រោះថា អាយុ កាន់តែ ចូល វ័យ ចាស់ ៗ អស់ ទៅ ហើយ ត្រូវតែ មាន សុខភាព រឹងមាំ ដើម្បី បន្ត បំពេញ ការងារ និង បន្ត ស្រលាញ់ រាប់អាន គ្នា បាន យូរអង្វែង ទៅ មុខ ទៀត ៕
លោក បាន បញ្ជាក់ ថា បណ្តឹង ទាំង ១១៧ នោះ គឺ ពាក់ព័ន្ធ នឹង ការស្នើ អន្តរាគមន៍ ជួយសង្គ្រោះ ជន បរទេស ដែល ត្រូវបាន អះអាង ថា បង្ខាំង និង ជួញដូរ កម្លាំង ពលកម្ម នៅក្នុង ប្រទេស កម្ពុជា បន្ទាប់ពី សម្តេច បាន អំពាវនាវ ឱ្យ ភាគី ទាំងអស់ រួមទាំង បរទេស ផងដែរ សហការផ្តល់ ព័ត៌មាន ពាក់ព័ន្ធ នឹង ករណី ទាំងនេះ ។
( សៀមរាប ) ៖ បុរស ជា ឪពុក មួយ រូប ទៀត នៅ ស្រុក ឈូក ខេត្ត កំពត បាន រៀបរាប យ៉ាង ក្រៀមក្រំ និង អង្វរ ឱ្យ កូនស្រី និង កូនប្រសារ ធ្វើការ នៅ ប្រទេស កូរ៉េ ដែល ចាញ់បោក ការឃោសនា របស់ លោក ខឹម វាសនា មេ គណបក្ស សម្ព័ន្ធ ដើម្បី ប្រជាធិបតេយ្យ រត់ បោះបង់ ចោល ការងារ ចោល ក្រុមគ្រួសារ ឱ្យ ត្រឡប់មក ផ្ទះសម្បែង វិញ ។
បុរស រូប នេះ ក៏ បាន ផ្ញើ សារ ដល់ កូនស្រី ឈ្មោះ ក្រឹម សុភី និង កូនប្រសារ ប្រុស ឈ្មោះ ហេង រ៉ាមី សូម កុំ ឱ្យ ងប់ ងុល នឹង ការបោកប្រាស់ របស់ លោក ខឹម វាសនា ព្រោះ ជា អំពើ បោកប្រាស់ មួយ ដែល ធ្វើឱ្យ យើងងប់ ងុល តែ មនុស្ស មួយ ក្តាប់ តូច ដូច្នេះ គួរតែ កូន វិល ចេញមក ក្រៅ ដើម្បី ជួប ពុក ម៉ែ បងប្អូន ដែល បាន បែក គ្នា រាប់ ឆ្នាំ ហើយ មក នោះ ។
សូម ស្ដាប់ កិច្ចសម្ភាសន៍ ជាមួយ បុរស ខាងលើ ដូចត ទៅ៖
លោក ពៅ សុខ ទីប្រឹក្សា សម្ដេច តេជោ ឧបត្ថម្ភ សៀវភៅ ចំនួន ៥៥០ ក្បាល ជូន កាកបាទ ក្រហម កម្ពុជា
( ភ្នំពេញ ) ៖ លោក ពៅ សុខ ទីប្រឹក្សា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ឧបត្ថម្ភ សៀវភៅ ៣ប្រភេទ សរុប ចំនួន ៥៥០ ក្បាល ជូន កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ប្រើប្រាស់ តាម ការចាំបាច់ ។
ពិធី ប្រគល់ និង ទទួល នេះ បាន ប្រព្រឹត្តទៅ នៅ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា នា ថ្ងៃទី ៦ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ ក្រោម វត្តមាន លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា ។
ក្នុង ឱកាស នោះ លោកស្រី ម៉ែន នារី សោភ័គ បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោក ពៅ សុខ ជាពិសេស ថ្លែង នូវ ការកោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង ចង ក្រង ជា ស្នាដៃ សម្រាប់ ជា ប្រយោជន៍ ដល់ អ្នកអាន និង អ្នកស្រាវជ្រាវ គ្រប់ មជ្ឈដ្ឋាន ក៏ ដូចជា ទុក ជា មរតក សម្រាប់ អ្នក បន្ត វេន ជំនាន់ ក្រោយ ។
លោកស្រី បាន ជម្រាប ជូន ផងដែរ ថា សៀវភៅ ទាំង នេះ កាកបាទ ក្រហម កម្ពុជា នឹង ធ្វើ ការផ្តល់ ជូន សប្បុរស ជនជាតិ - អន្តរជាតិ ទៅ តាម តម្រូវ ការចាំបាច់ ជាពិសេស សប្បុរសជន ដែល បាន ឧបត្ថម្ភ គាំទ្រ ដល់ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ៕
ផ្អែក តាម របាយការណ៍ របស់ អង្គការ WWF ក្នុង ឆ្នាំ ២០២០ ស្តីពី ភាព ស្ងាត់ ស្ងៀម នៃ អន្ទាក់ និង វិបត្តិ អន្ទាក់ ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ បាន ប៉ាន់ប្រម៉ាណ ថា អន្ទាក់ ប្រហែល ១២.៣លាន បាន នឹង កំពុង គំរាមគំហែង សត្វ ព្រៃ នៅក្នុង តំបន់ ការពារ ធម្មជាតិ ចំនួន ១១កន្លែង នៅក្នុង ប្រទេស ឥណ្ឌូនេស៊ី ម៉ាឡេស៊ី វៀតណាម ឡាវ និង កម្ពុជា ។
លោក សេង ទៀក បាន បន្ត ថា តាមរយៈ ការដាក់ចេញ នូវ យុទ្ធនាការ អន្ទាក់ សូន្យ បាន បង្ហាញ ពី កិច្ច ខិតខំប្រឹង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រសួង បរិស្ថាន និង ស្ថាប័ន ពាក់ព័ន្ធ នានា ទៅ លើ ការងារ ដោះស្រាយ និង បញ្ហា ដែល បាន គំរាមកំហែង ទៅ លើ សត្វ ព្រៃ ។
បន្ថែម ពី នេះ ប្រធាន អង្គការ រូប នេះ បាន បញ្ជាក់ ថា យុទ្ធនាការ អន្ទាក់ សូន្យ នេះ កម្ពុជា បាន រៀនសូត្រ បន្ថែម លើ បទពិសោធន៍ ជាច្រើន លើ បញ្ហា ដែល បង្កឡើង ដោយសារតែ អន្ទាក់ ដូច្នេះ ក្រសួង បរិស្ថាន ព្រមទាំង អង្គការ ដៃគូ នឹង អាច ចែករំលែក បទពិសោធន៍ ដែល កំពុង នឹង អនុវត្តន៍ នេះ ទៅ បណ្តា ប្រទេស ដទៃ ទៀត ។
« ខ្ញុំ ជា អង្គការ មួយ ដែល មាន ការិយាល័យ ជាង ១០០ ប្រទេស ត្រូវបាន គេ សួរ ថា តើ អ្នក ឯង បាន ធ្វើ យ៉ាងដូចម្តេច បាន ធ្វើ ការរួមគ្នា ល្អ ម៉េស ដើម្បី ដោះស្រាយ បញ្ហា វិបត្តិ នេះ » ។ នេះ ជា ការលើកឡើង បន្ថែម របស់ លោក សេង ទៀក ។
បើ តាម លោក នេត្រ ភក្ត្រា បាន ឱ្យដឹង ថា សម្រាប់ យុទ្ធនាការ អន្ទាក់ សូន្យ ដែល បាន ដាក់ចេញ នៅ តាម ខេត្ត គោលដៅ ចំនួន ៦នេះ មិន មែន មាន ន័យ ថា ត្រូវ បិទ បញ្ចប់ នូវ យុទ្ធនាការ ទាំងស្រុង នោះ ទេ ប៉ុន្តែ យុទ្ធនាការ នេះ នឹង ត្រូវ ធ្វើ ដូច ភ្លៀង រលឹម ដើម្បី បញ្ជ្រាប ការយល់ ឱ្យ កាន់តែ ខ្លាំងក្លា បន្ថែម ទៀត ដល់ ប្រជាពលរដ្ឋ នៅ គ្រប់ ស្រទាប់ វណ្ណៈ ពី សារគុណ តម្លៃ និង សារសំខាន់ នៃ ធនធាន ធម្មជាតិ និង សត្វ ព្រៃ ដែល មាន វត្ត នៅ កម្ពុជា ។
លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី បាន ថ្លែង ថា ក្នុង នាម រដ្ឋបាល ខេត្ត គាំទ្រ ពេញ ទំហឹង ចំពោះ ការធ្វើ យុទ្ធនាការ អន្ទាក់ សូន្យ នេះ ។ លោក ថា នឹង ភ្ជាប់ យុទ្ធនាការ នេះ ទៅក្នុង វេទិកា សាធារណៈ និង កិច្ចប្រជុំ នានា របស់ រដ្ឋបាល ខេត្ត ក្រុង ស្រុក ជារៀងរាល់ កិច្ចប្រជុំ នានា បន្ថែម ទៀត ដើម្បី ផ្សព្វផ្សាយ ពី សារៈសំខាន់ នៃ យុទ្ធនាការ អន្ទាក់ សូន្យ នេះ និង បន្ត កិច្ច ខិតខំ ប្រឹងប្រែង រួមគ្នា គឺ ធ្វើ យ៉ាងណា ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ផ្លាស់ប្ដូរ ឥរិយាបថ បញ្ឈប់ ការបរបាញ់ ជួញដូរ និង បរិភោគ សាច់ សត្វ ព្រៃ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា រដ្ឋបាល ខេត្ត រតនគិរី នឹង ដាក់ បម្រាម នៅ គ្រប់ ទីផ្សារ ក្នុង ខេត្ត ទីប្រជុំជន ជាពិសេស នៅ តាម ភោជនីយដ្ឋាន ដែល តែងតែ ទទួលយក សាច់ សត្វ ព្រៃ មក ធ្វើ ម្ហូប អាហារ ជូន ភ្ញៀវ ៕
ផ្លូវ កៅស៊ូ DBST ប្រវែង ជាង ១០គីឡូម៉ែត្រ ក្នុង ស្រុក បុរី អូរ ស្វាយ សែន ជ័យ ត្រូវបាន សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់
( ស្ទឹងត្រែង ) ៖ លោក ឈាង ឡាក់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ស្ទឹងត្រែង នា ព្រឹក ទី ០៦ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ផ្លូវ កៅស៊ូ DBST ប្រវែង ១០.៩០០ ម៉ែត្រ ស្ថិត នៅក្នុង ស្រុក បុរី អូរ ស្វាយ សែន ជ័យ ។
ពិធី នេះ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ សមាជិក ក្រុមប្រឹក្សា ខេត្ត អភិបាល រង ខេត្ត ក្រុមប្រឹក្សា គណៈ អភិបាល ស្រុក បុរី អូរ ស្វាយ សែន ជ័យ កងកម្លាំងប្រដាប់អាវុធ ទាំង បី ប្រភេទ លោក លោកស្រី ប្រធាន មន្ទីរ អង្គភាព នានា ក្នុង ខេត្ត មន្រ្តី រាជការ និង សិស្សានុសិស្ស ជាច្រើន រូប ទៀត ។
លោក ស្វាយ សំអ៊ាង បាន ថ្លែង ថា ក្រោម ការដឹកនាំ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្ដី កម្ពុជា បាន ធ្វើឲ្យ ប្រទេស មាន សុខ សន្តិភាព មាន ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ហើយ កំណាត់ ផ្លូវ ដែល សម្ភោធ ដាក់ ឲ្យ ប្រើប្រាស់ នា ពេលនេះ គឺជា សមិទ្ធផល មួយ ថ្មី បន្ថែម ទៀត ដែល រាជ រដ្ឋាភិបាល បាន ផ្តល់ ជូន ប្រជាពលរដ្ឋ តាមរយៈ រដ្ឋបាល ខេត្ត សម្រាប់ ប្រើប្រាស់ ។
លោក អភិបាល ខេត្ត បន្ត ថា ស្រុក អូរ ស្វាយ សែន ជ័យ ជា ស្រុក មួយ នៅ ជាប់ ប្រទេស ឡាវ ដូច្នេះ ការអភិវឌ្ឍន៍ វា ជា ផ្នែក មួយ បង្ហាញ ឱ្យ ឃើញ នូវ ការយកចិត្តទុកដាក់ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ចំពោះ ស្រុក ដែល បាន បង្កើត ទី រួម ស្រុក ថ្មី ។
លោក ស្វាយ សំអ៊ាង បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ នាំគ្នា ចូលរួម ថែរក្សា ការពារ នូវ រាល់ សមិទ្ធិផល ចាស់ ថ្មី របស់ រាជ រដ្ឋាភិបាល ដើម្បី ប្រើប្រាស់ បាន យូរអង្វែង និង ជា ប្រយោជន៍ ដល់ កូន ចៅ ជំនាន់ ក្រោយ ៗ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ស្វាយ សំអ៊ាង បាន ឧបត្ថម្ភ ជា ថវិកា ដល់ រដ្ឋបាល ស្រុក បុរី អូស្វាយ សែន ជ័យ ចំនួន ០១ លាន រៀល និង រដ្ឋបាល ឃុំ អូរ ស្វាយ ចំនួន ៥០ ម៉ឺន រៀល ព្រមទាំង លោក តា លោកយាយ ដែល ចូលរួម ក្នុង ពិធី ក្នុង ម្នាក់ ៗ ទទួលបាន សារុង ១ និង ថវិកា ១ ម៉ឺន រៀល សិស្សានុសិស្សិ ក្នុង ម្នាក់ ៗ ទទួលបាន សម្ភារៈ សិក្សា និង ថវិកា ចំនួន ១ ម៉ឺន រៀល ផងដែរ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៣៣៤ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៦ ខែកញ្ញា ឆ្នាំ ២០២២
បើ តាម អ្នកនាំពាក្យ . គិត ថ្ងៃទី ០៦ ខែកញ្ញា ក្នុង ឆ្នាំ ២០២២ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១១២ .៣៤៨ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៩០.២១៩ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២២. ១២៩ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្រវឹង និង អត់ ស្លាកលេខ ។ ដោយឡែក រថយន្ត ល្បឿន អត់ ស្លាកលេខ ឆៀក និង អត់ ប័ណ្ណ បើកបរ ជាដើម ។
សូម ជម្រាប ថា រាជ រដ្ឋាភិបាល បាន ផ្តល់ឲ្យ ប្រជាពលរដ្ឋ ដែល គ្រប់ លក្ខខណ្ឌ និង ស្ម័គ្រចិត្ត រុះរើ សំណង់ ខុស ច្បាប់ ចេញ ពី តំបន់ រណីយដ្ឋាន អង្គរ ទៅ ចាប់ ឆ្នោត ជ្រើសរើស ដីឡូតិ៍ នៅ តំបន់ រុន តា ឯក ក្នុង មួយ គ្រួសារ ទទួលបាន ដី ចំនួន ១ឡូតិ៍ ទំហំ ២០ ម៉ែត្រ x ៣០ ម៉ែត្រ ។
ក្រុមការងារ អន្តរ ក្រសួង ដឹកនាំ ដោយ លោក ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា បាន និង កំពុង បើក យុទ្ធនាការ ទ្រង់ទ្រាយ ធំ ចុះ វាស់វែង កំណត់ និយាម កាក្បាល ដី និង អត្តសញ្ញាណ អ្នកកាន់កាប់ ដី និង សំណង់ ខុស ច្បាប់ ក្នុង តំបន់ រមណីយដ្ឋាន អង្គរ និង តំបន់ ដទៃ ទៀត ស្ថិត ក្រោម ការគ្រប់គ្រង របស់ អាជ្ញាធរ ជាតិ អប្សរា ៕
សម្តេច ព្រះមហាសង្ឃរាជ បួរ គ្រី មាន បន្ទូល ក្នុង លិខិត នេះ ថា « អាត្មាភាព សូម ចម្រើន ពរ ផ្ដល់ជូន អាហារូបករណ៍ ១០០ % ថ្នាក់ បរិញ្ញាបត្រ នៃ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា ក្នុង ឆ្នាំ សិក្សា ២០២៣ - ២០២៤ ចំនួន ១០០ កន្លែង លើ ឯកទេស ចំនួន ៧ រួម មាន៖ នីតិសាស្ត្រ . គ្រប់គ្រង ទូទៅ . វិទ្យាសាស្ត្រ អប់រំ . អក្សរសាស្ត្រ អង់គ្លេស . ព័ត៌មានវិទ្យា . ទស្សនវិជ្ជា ពុទ្ធសាសនា និង អក្សរសាស្ត្រ ខ្មែរ » ។
ក្នុង លិខិត ដដែល បញ្ជាក់ ថា ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា គឺជា គ្រឹះស្ថាន ឧត្តម សិក្សា សាធារណៈ របស់ រដ្ឋ ដែល មាន ការឧត្ថម្ភ គាំទ្រ ដោយ សម្តេច ព្រះមហាសង្ឃរាជ បួរ គ្រី គណៈ ធម្មយុត្តិក និកាយ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជា ព្រះសាកលវិទ្យាធិការ និង រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បិតា ស្ថាបនិក សន្តិភាព កម្ពុជា ។
លើស ពី នោះ ជប៉ុន ក៏ បាន ស្នើសុំ ការគាំទ្រ ពី ក្រសួង សុខាភិបាល ក្នុង ការបន្ត កិច្ចសហការ ហើយ ជប៉ុន ក៏ ប្ដេជ្ញា បន្ត គាំទ្រ វិស័យ សុខាភិបាល បន្ថែម ទៀត ផងដែរ ។
លោកស្រី រដ្ឋលេខាធិការ ក៏ បាន ជម្រាប ជូន ភាគី ជប៉ុន អំពី បទពិសោធន៍ នៃ ការគ្រប់គ្រង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ នៅ កម្ពុជា ក្នុង រយៈពេល ជាង ២ឆ្នាំ កន្លងមក នេះ ដែល ជោគជ័យ នេះ កើតឡើង ពី ការដឹកនាំ ដ៏ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ជា អគ្គមេបញ្ជការដឹកនាំ ចង្អុលបង្ហាញ ផ្ទាល់ ៕ រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ អនុញ្ញាតឲ្យ ក្រុមការងារ អ្នកជំនាញ ការធនាគារ ពិភពលោក ជួប សំដែង ការគួរសម ដើម្បី ពិភាក្សា ការងារ
បន្ទាប់ពី លោក Serdar Yilmaz បាន បង្ហាញ ពី គោលបំណង នៃ ជំនួប ដើម្បី សិក្សា ស្វែងយល់ ទិដ្ឋភាព ទូទៅ នៃ ប្រព័ន្ធ ព័ត៌មាន គ្រប់គ្រង មន្ត្រីរាជការ (HRMIS) ដើម្បី កសាង ផែនទី បង្ហាញ ផ្លូវ (Roadmap) រដ្ឋមន្ត្រី ព្រុំ សុខា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ក្នុង នាម ក្រសួង មុខងារ សាធារណៈ ចំពោះ កិច្ចសហប្រតិបត្តិការ របស់ ធនាគារ ពិភពលោក ក្នុង រយៈពេល កន្លងមក និង បាន អនុញ្ញាត ជូន ក្រុម អ្នកជំនាញ ការធនាគារ ពិភពលោក និង មន្រ្តី ជំនាញ ក្រសួង មុខងារ សាធារណៈ បន្ត ពិភាក្សា ជាមួយគ្នា លើ កិច្ចការងារ នេះ ។
ទន្ទឹម នោះ លោក រដ្ឋមន្ត្រី បាន លើកទឹកចិត្ត ដល់ ក្រុមការងារ ជំនាញ ការធនាគារ ពិភពលោក និង មន្រ្តី ជំនាញ ក្រសួង មុខងារ សាធារណៈ ត្រូវ សហការ ឱ្យ បាន ជិតស្និទ្ធ ដើម្បីឱ្យ កិច្ចសហប្រតិបត្តិ ទាំងឡាយ អាច សម្រេចបាន សមិទ្ធផល ជាក់ស្តែង និង ឆ្លើយតប នឹង តម្រូវ ការចាំបាច់ របស់ ក្រសួង និង ស្ថានភាព នៅ កម្ពុជា ។
នៅក្នុង លិខិត លា លែង ពី តំណែង ផ្ញើ ទៅកាន់ នាយក រដ្ឋមន្រ្តី លោក បូរី ស ចន សុន . លោកស្រី ផាធែល បាន លើកឡើង ថា « វា ជា កត្តិយស និង មោទ ភាព សម្រាប់ ខ្ញុំ ក្នុង ការចូលរួម បម្រើ និង ការពារ ប្រទេស ក្នុង នាម ជា រដ្ឋមន្រ្តី មហាផ្ទៃ » ។ នៅក្នុង លិខិត នេះ ដែរ លោកស្រី ផាធែល បាន ចោទប្រកាន់ គូ ប្រជែង នយោបាយ របស់ ខ្លួន ថា បាន គាំទ្រ « សកម្មភាព របស់ ឧក្រិដ្ឋ ជន . ភេរវជន និង អ្នក រត់ ពន្ធ មនុស្ស ព្រមទាំង អ្នក ដែល គ្មាន សិទ្ធិ រស់ នៅក្នុង ចក្រភព អង់គ្លេស » ។
អនុប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត កំពង់ធំ ក្រើន រំលឹក សិស្ស ថ្នាក់ ទី ១២ ប្រឹងប្រែង រៀនសូត្រ ទ្វេ ដង ដើម្បី ត្រៀម ប្រឡង បាក់ឌុប ឲ្យ ទទួលបាន ជោគជ័យ
( កំពង់ធំ )៖ លោក ថា យ៉ាវ សមាជិក គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត កំពង់ធំ បាន ចុះ ជួប សំណេះសំណាល ជាមួយ សិស្ស ថ្នាក់ ទី១២ និង បាន ក្រើន រំលឹក សិស្ស ថ្នាក់ ទី ១២ ប្រឹងប្រែង រៀនសូត្រ ទ្វេ ដង ដើម្បី ត្រៀម ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ឲ្យ ទទួលបាន ជោគជ័យ ។
ការជួប សំណេះសំណាល ជាមួយ សិស្ស ថ្នាក់ ទី១២ របស់ លោក ថា យ៉ាវ ធ្វើឡើង នៅ ថ្ងៃទី ៥ ខែកញ្ញា ឆ្នាំ ២០២២ ក្នុង ស្រុក ប្រាសាទ បល្ល័ង្ក និង ស្រុក កំពង់ស្វាយ ។
លោក ថា យ៉ាវ បាន ថ្លែង ទៅកាន់ សិស្សា និសិស្ស ត្រៀម ប្រឡង ទាំងអស់ ត្រូវ ខិតខំ និង យកចិត្តទុកដាក់ រៀនសូត្រ ពិសេស ក្នុង អំឡុង ពេល នៃ ការបង្រៀន បំប៉ន ត្រូវ មក រៀន ឲ្យបាន ទៀងទាត់ និង ត្រូវ អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ អង្គ ទាំង៤ គឺ សុ .ចិ. បុ. លិ ដោយ ចេះ ស្ដាប់ . ចេះ កត់ត្រា . ឆ្ងល់ និង ចេះ ។
លោក ថា យ៉ាវ សង្ឃឹម ថា ការប្រឡង ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ឆ្នាំ សិក្សា ២០២១ - ២០២២ នេះ សិស្ស ថ្នាក់ ទី១២ ក្នុង ស្រុក ប្រាសាទ បល្ល័ង្ក និង ស្រុក កំពង់ស្វាយ នឹង មាន សិស្ស ទទួលបាន និទ្ទេស A ច្រើន ជាង ឆ្នាំ សិក្សា មុន ៗ ។
សូម ជម្រាប ថា ក្នុង ស្រុក ប្រាសាទ បល្ល័ង្ក សិស្ស ត្រូវ ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ មាន ២៤៧ នាក់ សិស្ស នារី មាន ១៤២ នាក់ និង ស្រុក កំពង់ស្វាយ មាន ចំនួន ៣១១ នាក់ សិស្ស នារី មាន ចំនួន ១៧៦ នាក់ ៕
នាយ ឧត្តមសេនីយ៍ បាន បញ្ជាក់ ថា ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ០៥ ខែកញ្ញា ឆ្នាំ ២០២២ សមត្ថកិច្ច បាន បើក ប្រតិបត្តិការ រំដោះ ជនរង គោះ ចំនួន ២៣នាក់ ( ស្រី ៣នាក់ ) មាន ជនជាតិ ចិន ១៥នាក់ ជនជាតិ ចិន តៃវ៉ាន់ ៧នាក់ និង ជនជាតិ វៀតណាម ៧នាក់ និង ឥណ្ឌូនេស៊ី ១ នាក់ ផងដែរ ។
កាលពី ចុង ខែឧសភា កន្លងទៅ វិទ្យុ ប៉ូឡូញ បាន រាយការណ៍ ថា ទីក្រុង វ៉ាសូវី បាន ផ្តល់ កាំភ្លើង ធំ Krab ចំនួន ១៨ គ្រឿង ឱ្យ អ៊ុយក្រែន ។ កាំភ្លើង ធំ ហោវីត សឺ នេះ អាច បាញ់ ចម្ងាយ ជា អតិបរមា៤០ គីឡូម៉ែត្រ ហើយ អាច ចល័ត បាន ដោយ ខ្លួន ឯង ដោយ មិន ចាំបាច់ ត្រូវការ គ្រឿងយន្ត អូសទាញ នោះ ឡើយ ។
( ព្រះវិហារ ) ៖ កំណាត់ ផ្លូវ ជាតិ លេខ ៩៤ ប្រវែង ៥៤. ៩០ គីឡូម៉ែត្រ ចាប់ពី ឧទ្យាន ជាតិ តេជោ សែន ឫស្សី ត្រឹប ឆ្ពោះ ទៅកាន់ ព្រំដែន កម្ពុជា - ឡាវ ត្រូវបាន ក្រុមការងារ ថែទាំ ជួសជុល ផ្លូវថ្នល់ នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ ធ្វើ ការជួសជុល ឡើងវិញ បន្ទាប់ពី ផ្លូវ នេះ បាន រង ការខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង នា រដូវ វស្សា ឆ្នាំ នេះ ។
លោក សំ លាង ទ្រី ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ បាន ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ៦ ខែសីហា ឆ្នាំ ២០២២ នេះ ថា កំណាត់ ផ្លូវ ជាតិ លេខ ៩៤ ចាប់ពី ឧទ្យាន ជាតិ តេជោ សែន ឫស្សី ត្រឹប ទៅ ព្រំដែន ឡាវ បាន រង ការខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង ជា ហេតុ ធ្វើឲ្យ មាន ការលំបាក ក្នុង ការធ្វើដំណើរ ។
ដើម្បី សម្រួល ផ្លូវ នេះ ឲ្យ ប្រជាពលរដ្ឋ បាន ធ្វើដំណើរ ដោយ ស្រួល ក្រុមការងារ មន្ទីរ បាន ធ្វើ ការជួសជុល ឡើងវិញ ដោយ ធ្វើ ការ ថែម ដី ល្បាយ ថ្ម កៀសម្រួល ស្រោច ទឹក កិន បង្ហាប់ ធ្វើ យ៉ាងណា ឲ្យ ប្រជាពលរដ្ឋ អាច ធ្វើដំណើរ លើ ផ្លូវ នេះ បាន ស្រួល ។
លោក សំ លាង ទ្រី បញ្ជាក់ ថា ដោយ អនុវត្តន៍ តាម ការណែនាំ ពី លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ ពិសេស បន្ទាប់ពី លោក អភិបាល ខេត្ត ចុះ ពិនិត្យមើល ស្ថានភាព ជាក់ស្តែង ផ្លូវ ដែល រង ការខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត បាន យកចិត្តទុកដាក់ ជួសជុល ថែទាំ ផ្លូវ ឡើងវិញ ដែល គ្រប់គ្រង ដោយ មន្ទីរ ដើម្បី សម្រួល ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ លោក ចេង មុនីរ៉ា ប្រធាន កិត្តិយស អនុសាខា និង អភិបាល ខណ្ឌ ច្បារអំពៅ បាន អញ្ជើញ ចុះ សាកសួរ សុខទុក្ខ និង នាំយក អំណោយ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ចែកជូន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត ចំនួន ៥០ គ្រួសារ ស្ថិត នៅក្នុង ភូមិ ព្រែក ធំ២ សង្កាត់ ក្បាល កោះ ខណ្ឌ ច្បារអំពៅ ។
ជាមួយគ្នា នេះ លោក ក៏ សូមឲ្យ គ្រួសារ ទាំងអស់ យកចិត្តទុកដាក់ ថែរក្សា សុខភាព ដោយ ប្រកាន់ភ្ជាប់ នូវ អនាម័យ រស់ នៅ ស្អាត ហូប ស្អាត ផឹក ស្អាត និង សូម កុំ ធ្វេសប្រហែស ពី ជំងឺ កូវីដ - ១៩ ដោយ បន្ត អនុវត្ត វិធានការណ៍ ការពារ ខ្លួន ជានិច្ច គឺ ៣ការពារ និង ៣កុំ ។ លោក បាន បញ្ជាក់ ថា អំណោយ ដែល ចែកជូន នា ពេលនេះ ក្នុង មួយ គ្រួសារ ទទួលបាន៖ អង្ករ ២៥ គីឡូក្រាម . ឃីដ មួយ កញ្ចប់ និង ថវិកា មួយ ចំនួន ៕
