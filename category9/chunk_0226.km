( ភ្នំពេញ ) ៖ លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ ដឹកនាំ ក្រុមការងារ រដ្ឋបាល ខណ្ឌ ដាំ ដើម ផ្កា រំដួល ចំនួន ៤០ ដើម នៅក្នុង បរិវេណ វត្ត ខេមរៈ ប៊ុណ្ណា រាម ហៅ វត្ត ថ្មី ស្ថិត ក្នុង ភូមិ របោះ អង្កាញ់១ សង្កាត់ ព្រែក ឯង ។
ពិធី ដាំ ដើម ផ្កា រំដួល នេះ ក៏ មាន ការនិមន្ត ចូលរួម ពីសំណាក់ ព្រះគ្រូ ចៅអធិការ វត្ត ព្រះសង្ឃ គង់ នៅក្នុង វត្ត ជាច្រើន អង្គ ព្រមទាំង គណៈកម្មការ វត្ត និង ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ផងដែរ ។
លោក អភិបាល បាន បន្ត ថា ការដាំ ដើម រំដួល នេះ អាច និយាយ បាន ថា ចូលរួម អភិរក្ស ដែរ គឺ អភិរក្ស នូវ អ្វី ដែល ជា និមិត្ត សញ្ញា របស់ ជាតិ ការពារ លើកស្ទួយ លើក តម្កើង នូវ អ្វី ដែល ជា របស់ ជាតិ ។ ចាប់ពី ពេលនេះ តទៅ សង្ឃឹម ថា នៅ តាម វត្ត ដទៃ ទៀត មាន ការរៀបចំ ដើម្បី ដាំ ដើម ផ្កា រំដួល នេះ ដោយ ខ្លួន ឯង ទៅ តាម លទ្ធភាព ដូច្នេះ សូម ព្រះគ្រូ ចៅអធិការ វត្ត និង គណៈកម្មការ វត្ត សហការ ជាមួយ អាជ្ញាធរ ឬ មន្រ្តី ជំនាញ ដើម្បី ដាំ ដើម ផ្កា រំដួល នេះ ។
ជាមួយគ្នា នោះ លោក ចេង មុនីរ៉ា បាន ចូលរួម កសាង ព្រះវិហារ ថ្មី ជាមួយ ព្រះគ្រូ ចៅអធិការ នូវ ថវិកា ចំនួន ១០លាន រៀល ផងដែរ ៕ ភ្លៀង លាយ ខ្យល់ កន្ត្រាក់ បណ្តាលឲ្យ ប៉ើង ដំបូល សាលា បឋមសិក្សា ក្បាល បឹង សេះ ៥ខ្នង . ភ្លាម ៗ អភិបាល ខេត្ត ត្បូងឃ្មុំ ចុះ ពិនិត្យ និង ចាត់ ឲ្យ ជួសជុល ជាបន្ទាន់ សម្រាប់ ក្មួយ ៗ បាន ចូល រៀន ឡើងវិញ
( ត្បូងឃ្មុំ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកញ្ញា ឆ្នាំ ២០២២ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ ដឹកនាំ អភិបាល រង ខេត្ត ថ្នាក់ដឹកនាំ សាលា ខេត្ត មន្ទីរ - អង្គភាព ពាក់ព័ន្ធ ជុំវិញ ខេត្ត និង អាជ្ញាធរ មូលដ្ឋាន ចុះ ពិនិត្យ ដោយ ផ្ទាល់ និង ចាត់ ឲ្យ ជួសជុល ឡើងវិញ ភ្លាម ៗ នូវ អគារ សាលា បឋមសិក្សា ក្បាល បឹង សេះ ដែល ត្រូវបាន ខ្យល់ កន្រ្តាក់ ប៉ើង ដំបូល ស្ថិត ក្នុង ភូមិ ក្បាល បឹង សេះ ឃុំ គរ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន សម្ដែង នូវ ការសោកស្ដាយ ជាខ្លាំង និង បាន អំពាវនាវ ប្រជាពលរដ្ឋ បង្កើន ការប្រុងប្រយ័ត្ន ចំពោះ គ្រោះ ធម្មជាតិ ចំពោះ ហេតុការណ៍ ដែល បាន បង្កឡើង ដោយ សាគ្រោះ ធម្មជាតិ នេះ ហើយ វា បណ្ដាលឲ្យ ប៉ើង រដំបូង សាលា ជា ហេតុ ធ្វើឱ្យ រំខាន ដល់ ការសិក្សា របស់ ក្មួយ ៗ ។ ប៉ុន្តែ ជា សំណាង ល្អ ដែល មិន មាន បងប្អូន ប្រជាពលរដ្ឋ និង ក្មួយ ៗ ណា ម្នាក់ មាន អ្នក រង បួស ស្នាម ។
សូម បញ្ជាក់ ថា កាលពី ល្ងាច ទី ០៤ ខែកញ្ញា ឆ្នាំ ២០២២ មាន ភ្លៀង មួយ មេ ធំ លាយ លំ ជាមួយ ផ្គរ រន្ទះ និង ខ្យល់ កន្រ្តាក់ បាន ធ្វើឲ្យ ដំបូល សាលា បឋមសិក្សា ក្បាល បឹង សេះ រង ការខូចខាត យ៉ាង ដំណំ អស់ ដំបូល សាលា ៥ខ្នង គិត ជា ប្រាក់ អស់ ប្រមាណ ជាង ១០០០០ ដុល្លារ ។
ភ្លាម ៗ លោក បណ្ឌិត អភិបាល ខេត្ត បាន ចាត់ ឲ្យ មន្ត្រី ជំនាញ សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ស្វែងរក ក្រុម ជាង ជួសជុល សាលារៀន នេះ ជាបន្ទាន់ ខណៈ ថវិកា ចំណាយ ទាំង លោក បណ្ឌិត ជា អ្នក រ៉ាប់រង ដើម្បីឱ្យ ក្មួយ ៗ បាន ចូល សិក្សា ឡើងវិញ ៕
ក្រុមប្រឹក្សា ខេត្ត គណៈ អភិបាល ខេត្ត ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ខេត្ត ស្វាយរៀង អញ្ជើញ គោរព វិញ្ញាណក្ខន្ធ មហា ឧបាសិកា ញឹម តេង
( ស្វាយរៀង ) ៖ លោក ជុំ ហាត ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង និង លោក ម៉ែន វិបុល អភិបាល ខេត្ត បាន ដឹកនាំ ប្រតិភូ ខេត្ត នៅ ថ្ងៃទី ៥ ខែកញ្ញា ឆ្នាំ ២០២២ អញ្ជើញ គោរព វិញ្ញាណក្ខន្ធ លោកយាយ មហា ឧបាសិកា ញឹម តេង ម្តាយ ក្មេក របស់ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន ទទួលមរណភាព នៅ ថ្ងៃទី ៤ ខែកញ្ញា ឆ្នាំ ២០២២ វេលា ម៉ោង ១៖ ៤០ នាទី រសៀល ក្នុង ជន្មាយុ ៩៤ ឆ្នាំ ដោយ រោគា ពាធ ។
លោក អភិបាល ខេត្ត និង ប្រតិភូ បាន សម្តែង នូវ ការចូលរួម រំលែក នូវ មរណទុក្ខ ដោយ ក្ដីស្រណោះ និង សង្វេ គ សោកស្ដាយ បំផុត ជាមួយ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការ កិច្ច ព្រមទាំង ក្រុមគ្រួសារ ចំពោះ ការបាត់បង់ មហា ឧបាសិកា ញឹម តេង នា ពេលនេះ និង សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហា ឧបាសិកា ញឹម តេង សូម បាន ចាប់បដិសន្ធិ ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី ទទួល ជួប ប្រតិភូ ក្រុមប្រឹក្សា ទឹក អាស៊ី ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ
ការជំរុញ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក កែ ន សម្បត្តិ ដឹកនាំ កិច្ចប្រជុំ ជាមួយ ធនាគារ ពាណិជ្ជដៃគូ ដើម្បី ពិនិត្យ ពិភាក្សា តាមដាន វឌ្ឍនភាព និង ពង្រឹង ការអនុវត្ត អនុស្សរណៈ នៃ ការយោគយល់ គ្នា រវាង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ធនាគារ ពាណិជ្ជដៃគូ តាមរយៈ ប្រព័ន្ធ វីដេអូ ពី ចម្ងាយ (Zoom) នា ថ្ងៃទី ០២ ខែកញ្ញា ឆ្នាំ ២០២២ ។
លោក កែន សម្បត្តិ បាន ជំរុញ ឲ្យ ធនាគារ ពាណិជ្ជដៃគូ ខិតខំ យកចិត្ត ខ្ពស់ ក្នុង ការពង្រឹង និង បង្កើន ប្រសិទ្ធភាព នៃ ការផ្តល់ សេវា ទទួល ប្រាក់ ពន្ធ ជូន អគ្គ នាយកដ្ឋាន ពន្ធដារ ឲ្យបាន កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ដើម្បី លើកកម្ពស់ ការផ្តល់ សេវា បង់ ពន្ធ ជូន អ្នក ជាប់ ពន្ធ និង អនុលោម ភាព សារពើពន្ធ ។
ទន្ទឹមនឹង នេះ លោក កែន សម្បត្តិ ក៏ បាន ជំរុញ និង លើកទឹកចិត្ត ដល់ ធនាគារ ពាណិជ្ជដៃគូ ឲ្យ បន្ត សហការ ជិតស្និត ជាមួយ អគ្គ នាយកដ្ឋាន ពន្ធដារ ដើម្បី ដោះស្រាយ បញ្ហា បច្ចេកទេស ពាក់ព័ន្ធ នឹង ការទទួល ប្រាក់ ពន្ធ ឲ្យបាន ទាន់ ពេល វេលា ។
លើស ពី នោះ ទៀត លោក បាន ប្រាប់ ឲ្យ យកចិត្តទុកដាក់ ពន្លឿន ការ ធ្វើ ទំនើបកម្ម ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន របស់ ធនាគារ ដៃគូ នីមួយ ៗ ដើម្បី ឈាន ទៅ ធ្វើ សន្ធានកម្ម ជាមួយ ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ជា ប្រយោជន៍ ចូលរួម ផ្ដល់ សេវា ទទួល ប្រាក់ ពន្ធ តាម ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន ចំពោះ ធនាគារ ពាណិជ្ជដៃគូ ដែល មិន ទាន់ មាន ប្រព័ន្ធ នេះ ។
គូសបញ្ជាក់ ថា មកដល់ ពេលនេះ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចុះ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ជាមួយ ធនាគារ ពាណិជ្ជ ចំនួន ១០ រួច មកហើយ ដែល ក្នុង នោះ មាន៖
ការលើកឡើង បែប នេះ របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ពិធី ប្រគល់ សញ្ញាបត្រ ជូន និស្សិត ជ័យលាភី នៃ សាកលវិទ្យាល័យ ឥន្ទ្រវិជ្ជា នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ ។
នា ឱកាស នោះ ដែរ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ចូលរួម អបអរសាទរ ចំពោះ សមិទ្ធផល ដែល និស្សិត ជ័យលាភី ទាំងអស់ ទទួលបាន ក្នុង ថ្ងៃ នេះ និង ក៏ ជា មោទនភាព មួយ ដ៏ ធំធេង សម្រាប់ ខ្លួន ឯង និង ក្រុមគ្រួសារ ក៏ ដូចជា សង្គមជាតិ ទាំងមូល ដោយ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ប្រទេសជាតិ យើង កាន់តែ មាន ធនធាន មនុស្ស ប្រកបដោយ សក្តានុពល បន្ត កើនឡើង ។
បន្ថែម ពី នេះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បន្ត ថា សមិទ្ធផល ធំ បំផុត របស់ ប្រទេសជាតិ ដែល កើតឡើង ក្រោយ ឆ្នាំ ១៩៧៩ ដោយ ផ្អែក លើ ការផ្តល់ អាទិភាព លើ ការអនុវត្ត គោល នយោបាយ និង ចក្ខុវិស័យ លើ វិស័យ អប់រំ តាំងពី ជំនាន់ នោះ មក គឺ ការទទួលបាន នូវ ធនធាន មនុស្ស ដែល មាន សមត្ថភាព លទ្ធភាព គុណធម៌ និង សីលធម៌ និង ដែល បាន ចូលរួម ក្នុង ការដឹកនាំ គ្រប់គ្រង កសាង និង អភិវឌ្ឍ ប្រទេស ដោយ ឯករាជ្យ ម្ចាស់ ការលើ គ្រប់ វិស័យ ទាំង ផ្នែក រដ្ឋ វិស័យ ឯកជន និង អង្គការ សង្គម ស៊ីវិល ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា « នេះ គឺជា មោទនភាព ហើយ ដែល យើង ត្រូវ រួមគ្នា បន្ត ពង្រឹង ទៅ មុខ ទៀត ដើម្បី និរន្តរភាព នៃ ការអភិវឌ្ឍ ជាតិ ។ ធនធាន មនុស្ស ម្នាក់ គឺជា សសរ មួយ ដើម ដែល ទ្រទ្រង់ ប្រទេសជាតិ ជាពិសេស សរ ជំនាន់ ថ្មី ៗ ដែល ទទួលបាន ឱកាស ពេញលេញ ក្នុង ការសិក្សា រៀនសូត្រ គឺ ត្រូវ ខិតខំ កសាង ពង្រឹង ខ្លួន ឱ្យ បាន រឹងមាំ ដើម្បី ទ្រទ្រង់ និង ទទួលបន្ទុក ភារកិច្ច បន្ត កសាង ប្រទេស ដែល ចេះតែ រីកចម្រើន ធំធាត់ » ។
ជា រួម នេះ គឺជា អភិក្រម នៃ ការអភិវឌ្ឍ សមត្ថភាព ធនធាន មនុស្ស ដែល ផ្តោត ទៅ លើ ការកែប្រែ ផ្នត់គំនិត នៃ ការប្រកួតប្រជែង និង ការជឿទុកចិត្ត លើ សមត្ថភាព ខ្លួន ឯង ដោយ ត្រូវ អនុវត្ត ចាប់ពី អាយុ ក្មេង វ័យ ឡើង មក ៕
អភិបាល រង ខេត្ត កំពង់ឆ្នាំង ចំនួន ៤រូប ត្រូវបាន ប្រកាស ចូលកាន់ តំណែង ជា ផ្លូវការ
( កំពង់ឆ្នាំង ) ៖ អភិបាល រង ខេត្ត កំពង់ឆ្នាំង ចំនួន ៤រូប ត្រូវបាន ប្រកាស ចូលកាន់ តំណែង ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ ក្រោម អធិបតីភាព លោក ប៉ាវ ហម ផាន រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ តំណាង សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ស៊ុន សុវណ្ណា រិទ្ធិ អភិបាល ខេត្ត កំពង់ឆ្នាំង ក្នុង នាម គណៈ អភិបាល ខេត្ត កំពង់ឆ្នាំង សូម ប្រកាស គាំទ្រ និង សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ សម្ដេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល ដែល ផ្ដល់ ទំនុក ចិត្ត ប្រកាស តែងតាំង អភិបាល រង ខេត្ត ថ្មី ចំនួន ៤រូប ដល់ ខេត្ត កំពង់ឆ្នាំង ។
ជាមួយគ្នា នេះ លោក ប៉ាវ ហម ផាន បាន ណែនាំ ដល់ អភិបាល រង ដែល ទើប ប្រកាស ចូលកាន់ តំណែង រួម មាន ទី១៖ លោក យិន សាវ៉េន . ទី ២៖ លោក ឈឹម វុទ្ធា . ទី ៣៖ លោក ពេជ្រ កែវ មុនី និង ទី៤៖ លោក យ៉ង់ ភារម្យ ត្រូវ ប្រកាន់ ឥរិយាបថ ជា មន្ត្រី សាធារណៈ បម្រើ ប្រជាជន ដោយ ត្រូវ ស្មោះត្រង់ ជាមួយ ជាតិ សាសនា ព្រះមហាក្សត្រ និង រាជ រដ្ឋាភិបាល ។ ត្រូវ ក្លាយ ខ្លួន ពី នាក់ គ្រប់គ្រង ទៅជា អ្នក ផ្ដល់ សេវា ជូន ប្រជាពលរដ្ឋ ដោយ ប្រសិទ្ធិភាព និង ដោយ គោរព ក្នុង ស្មារតី សាមគ្គីភាព ទូលំទូលាយ មិន រើសអើង មិន ប្រកាន់ បក្សពួក ។
បន្ថែម ពី នេះ ត្រូវ ជំរុញ ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិ ភាព ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។ ដោយ ក្នុង នោះ ត្រូវ ពង្រឹង ការងារ ស្នូល ទាំង៥ នៅ គ្រប់ មូលដ្ឋាន មេឃុំ ចៅសង្កាត់ . ស្មៀន ឃុំ និង ស្មៀន សង្កាត់ . នគរបាល ប៉ុស្ដិ៍ . មណ្ឌល សុខភាព ប៉ុស្តិ៍ សុខភាព និង មេភូមិ ដែល ជា អ្នក រស់ នៅ ផ្ទាល់ ដឹង សុខ ទុក្ខ ដឹង ការលំបាក របស់ ប្រជាពលរដ្ឋ ។
លើស ពី នេះ ត្រូវ សហការ គ្នា ដោះស្រាយ ទំនាស់ និង សំ ណូមពរ នានា ដោយ យុត្តិធម៌ ឈរ លើ មូលដ្ឋាន ច្បាប់ ទើប ប្រជាពលរដ្ឋ រស់ នៅក្នុង មូលដ្ឋាន មាន ជំនឿ និង ទទួលបាន សច ក្តីសុខ ដូច ពាក្យ ថា ទី ណា មាន ថ្នាក់ដឹកនាំ ល្អ ទីនោះ មាន សុខ សន្តិភាព ។ នេះ ជា អ្វី ដែល ជា ការផ្ដាំផ្ញើ បន្ថែម របស់ លោក ប៉ាវ ហម ផាន ៕
លោក ហែម សុី ណា ត្រូវបាន ប្រកាស ចូលកាន់ មុខតំណង ជា អភិបាល ស្រុក រំដួល . អភិបាល ខេត្ត ស្វាយរៀង ផ្ដាំផ្ញើ ការងារ មួយចំនួន ដើម្បី បម្រើ ពលរដ្ឋ ឲ្យ មាន ប្រសិទ្ធភាព
( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង នា ព្រឹក ថ្ងៃទី ០៥ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ប្រកាស ចូលកាន់ មុខតំណែង អភិបាល ស្រុក រំដួល ដោយ លោក ហែម សុី ណា ប្រកាស ជា អភិបាល ស្រុក រំដួល ថ្មី ជំនួស លោក សុខា រ៉ាម ទទួល ភារកិច្ច ថ្មី ជា អភិបាល រង ខេត្ត ស្វាយរៀង ។
ពិធី ប្រកាស នេះ ក៏ មាន ការចូលរួម ពី លោក លោកស្រី ជា ប្រធាន អនុប្រធាន មន្ទីរ ជុំវិញ ខេត្ត មន្ត្រីរាជការ សាលា ស្រុក និង ការិយាល័យ នានា ជុំវិញ ស្រុក មេឃុំ ស្មៀន ឃុំ និង នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទាំង ១០ឃុំ តំណាង សមាគម អង្គការ សង្គម ស៊ីវិល ដែល កំពុង ធ្វើ សកម្មភាព ក្នុង ស្រុក រំដួល និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក អភិបាល ខេត្ត បាន ផ្ដាំផ្ញើ នូវ កិច្ចការ សំខាន់ ៗ មួយចំនួន ដូច ជា៖
* ទី១៖ ត្រូវ បន្ត ជំរុញ លើកទឹកចិត្ត ប្រជាពលរដ្ឋ ឲ្យ ចូលរួម អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព និង បង្កើន ការសហការ ក្នុង ចំណោម អាជ្ញាធរ និង សមត្ថកិច្ច ពាក់ព័ន្ធ ក្នុង ការថែរក្សា ពង្រឹង សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ ការបង្ការ ទប់ស្កាត់ និង បង្រ្កាប បទល្មើស នានា ជាពិសេស បទល្មើស គ្រឿងញៀន ការជួញដូរ មនុស្ស ចោរកម្ម និង ល្បែងស៊ីសង នៅ គ្រប់ មូលដ្ឋាន ទូទាំង ស្រុក ទន្ទឹម នេះ ក៏ ត្រូវ បន្ត ចាត់ វិធានការពង្រឹង ការអនុវត្ត ច្បាប់ ចរាចរណ៍ ឲ្យបាន តឹងរ៉ឹង និង ម៉ឺងម៉ាត់ ។
* ទី២៖ រដ្ឋបាល ស្រុក ត្រូវ បន្ត យកចិត្តទុកដាក់ ក្នុង កិច្ចការ ដឹកនាំ ការអនុវត្ត វិធានការ បង្ការ ទប់ស្កាត់ ការ រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង ជំរុញ ដឹកនាំ ការងារ ចាក់ វ៉ាក់សាំង ឲ្យបាន កាន់តែ សកម្ម ថែម ទៀត ទាំង ដូស មូលដ្ឋាន និង ដូស ជំរុញ ( ទី៣ ទី៤ និង ទី៥) ។
* ទី៣៖ រដ្ឋបាល ស្រុក ត្រូវ ធ្វើ ការផ្សព្វផ្សាយ ណែនាំ និង ជំរុញ ឲ្យ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ទៅ ពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា បើ តាម ប្រតិទិន របស់ គ.ជ. ប ត្រូវ ចាប់ផ្ដើម ពី ថ្ងៃទី ២០ ខែតុលា ដល់ ថ្ងៃទី ០៨ ខែធ្នូ ឆ្នាំ ២០២២ ។
* ទី៤៖ ត្រូវ ចូលរួម សហការ ពង្រឹង ការសាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង និង ពង្រឹង របៀបរបប ធ្វើ ការងារ ទំនាក់ទំនង ការងារ ឲ្យបាន ល្អ នៅក្នុង ក្រុមប្រឹក្សា ស្រុក គណៈ អភិបាល ស្រុក មន្ត្រី រាជការ និង កម្លាំង សមត្ថកិច្ច គ្រប់ ប្រភេទ ដោយ ត្រូវ ចៀសវាង ឲ្យបាន នូវ ទំនាស់ ផលប្រយោជន៍ និង ទំនាស់ ដែល កើត ចេញពី ការប្រើ អំណាច មិន ត្រឹមត្រូវ ។
* ទី៥៖ គណៈ អភិបាល ស្រុក ត្រូវ រៀបចំ ធ្វើ ការបែងចែក តួនាទី ភារកិច្ច និង ការទទួលខុសត្រូវ ក្នុង ជួរ គណៈ អភិបាល ស្រុក ឲ្យបាន ច្បាស់លាស់ ស្រប តាម ការណែនាំ របស់ ក្រសួង មហាផ្ទៃ ។
* ទី៦៖ គណៈ អភិបាល ស្រុក ត្រូវ យកចិត្តទុកដាក់ ពង្រឹង ការគ្រប់គ្រង វត្តមាន និង ការបំពេញ ការងារ របស់ មន្ត្រីរាជការ ក្នុង រចនាសម្ព័ន្ធ រដ្ឋបាល ស្រុក ព្រមទាំង ត្រូវ រៀបចំ និង ដាក់ ឲ្យ អនុវត្ត លក្ខខណ្ឌ ការងារ ជូន មន្ត្រីរាជការ ធ្វើ យ៉ាង ឲ្យ មន្ត្រី គ្រប់ រូប មាន ការងារ ធ្វើ គ្រប់ ៗ គ្នា ទន្ទឹម និង ការពង្រឹង ការគ្រប់គ្រង និង អភិវឌ្ឍន៍ សមត្ថភាព មន្ត្រីរាជការ ដើម្បី ត្រៀម ទទួល ការផ្ទេរ មុខងារ ពី ក្រសួង - ស្ថាប័ន ថ្នាក់ ជាតិ នា ពេល ខាងមុខ ។
* ទី៨៖ បច្ចុប្បន្ន នេះ បើ ទោះបីជា ស្រុក នៅ មិន ទាន់ រៀបចំ សម្ពោធ ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ ប៉ុន្តែ ការិយាល័យ ច្រក ចេញ ចូល តែ មួយ ស្រុក ក៏ បាន និង កំពុង ដំណើរការផ្ដល់ សេវា រដ្ឋបាល ជូន ប្រជាពលរដ្ឋ រួចហើយ ដូច្នេះ ត្រូវ ខិតខំ ពង្រឹង ការអនុវត្ត ការងារ នេះ ឲ្យ មាន ដំណើរការ ល្អ ដើម្បី លើកកម្ពស់ ការផ្ដល់ សេវា រដ្ឋបាល ជូន ប្រជាពលរដ្ឋ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ប្រកប ដោយ អភិបាលកិច្ច ល្អ ស្រប តាម បែបបទ និង នីតិវិធី នៃ ការផ្ដល់ សេវា តាម រចនាសម្ព័ន្ធ និង មុខងារ ថ្មី ៕
យ៉ាងណាមិញ នៅ រយៈកម្ពស់ ប្រហែល៤. ១៥០ម៉ែត្រ អ្នក ឡើង ភ្នំ ៦នាក់ ក៏ បាន ស្លាប់ ខណៈ ឧបទ្ទវហេតុ នោះ បង្កឡើង ដោយសារ ការធ្លាក់ ពី ទី ខ្ពស់ ។ កាលពី ថ្ងៃអាទិត្យ ម្សិលមិញ នេះ ក្រុម សង្រ្គោះ បាន ព្យាយាម បើក ឧទ្ធម្ភាគចក្រ ដើម្បី ទៅកាន់ កន្លែង ក្រុម អ្នក ឡើង ភ្នំ ទាំងនោះ ប៉ុន្តែ ខ្យល់ បោកបក់ ខ្លាំង ពេក បាន រារាំង មិន ឱ្យ ពួកគេ អាច ចុះចត ដោយ សុវត្ថិភាព បាន ។ ក្រុម អ្នក សង្រ្គោះ បាន អះអាង ថា ប្រតិបត្តិការ នឹង បន្ត ឡើងវិញ នៅពេល អាកាសធាតុ អនុញ្ញាត ។
គួរ បញ្ជាក់ ថា មកដល់ ថ្ងៃចន្ទ នេះ មាន សេចក្តីរាយការណ៍ អំពី មនុស្ស ស្លាប់ ២នាក់ ទៀត នៃ ក្រុម អ្នក ឡើង ភ្នំ ខាងលើ ។ សីតុណ្ហភាព នៅ ភ្នំ ភ្លើង គ្យូ ឆេវស្កាយ៉ា សូប កា អាច ធ្លាក់ចុះ ដល់ - ១៤ អង្សា សេ ឯណោះ កំលុង ពេល យប់ ។ អាជ្ញាធរ បាន ព្រមាន ថា ភ្នំ ភ្លើង នេះ ត្រូវបាន ចាត់ទុក ជា ភ្នំ ប្រកបដោយ គ្រោះថ្នាក់ មួយ សម្រាប់ អ្នក ឡើង ភ្នំ ដោយសារតែ កម្ពស់ របស់ វា និង ហានិភ័យ នៃ បន្ទុះ ភ្នំ ភ្លើង ៕
( សៀមរាប ) ៖ ស្ត្រី ជា ម្តាយ មួយ រូប ទៀត បាន យំសោក បោក ខ្លួន ដូច អក ព្រោះតែ កូនស្រី ជាទីស្រឡាញ់ លង់ នឹង ការពង្វក់ របស់ លោក ខឹម វាសនា ប្រធាន គណបក្ស សម្ព័ន្ធ ដើម្បី ប្រជាធិបតេយ្យ និង បក្ខពួក រហូត បោះបង់ ចោល ការសិក្សា និង ផ្ទះសម្បែង ។
ស្ត្រី ដែល មាន ស្រុក កំណើត នៅ ខេត្ត កំពង់ស្ពឺ បាន ទៅ រក កូន របស់ ខ្លួន ដែល កំពុង សម្ងំ នៅ ចម្ការ លោក ខឹម វាសនា ក្នុង ស្រុក បន្ទាយស្រី ខេត្ត សៀមរាប ។ អ្នកស្រី បាន ជួប កូន ហើយ បាន ទទូច អង្វរ ឱ្យ កូន ត្រឡប់ ទៅ ផ្ទះ វិញ ជាមួយ តែ កូន របស់ អ្នកស្រី មិន ព្រម ទៅ វិញ នោះ ឡើយ ដោយ ទទូច ស្នាក់ នៅ ចម្ការ នោះ រយៈពេល ១០ ថ្ងៃ បន្ថែម ទៀត ។
ដោយ អង្វរ កូន មិន ព្រម ត្រឡប់ ទៅ ផ្ទះ វិញ ជាមួយ ធ្វើឱ្យ ស្រ្តី ជា ម្តាយ រន្ធត់ និង ក្តុកក្តួល ចិត្ត ជាខ្លាំង ។ ដោយ ក្តី សង្វេគ ក្នុង ចិត្ត នឹកស្មាន មិន ដល់ ចំពោះ ទង្វើ របស់ កូនស្រី ដែល ងប់ ងុល ខ្លាំង រហូត លែង ស្តាប់ អ្នកស្រី ជា ម្តាយ បាន ធ្វើឱ្យ គាត់ រំជួល ចិត្ត ស្រែក ទ្រហោ យំ យ៉ាង ខ្លាំង ប្រៀប ដូចជា អក ព្រាត់ កូន ។
បើ ទោះ ម្តាយ យំ ស្ទើរ សន្លប់ ទៅ ហើយ កូនស្រី នៅតែ បន្ត ចចេស ចង់ បន្ត ស្នាក់ នៅក្នុង ចម្ការ របស់ លោក ខឹម វាសនា តាម បំណង របស់ ខ្លួន ។
យុវជន ម្នាក់ ចងក ធ្វើ អត្តឃាត ព្រោះ ខឹង ឪពុក ម្តាយ ស្តីបន្ទោស ក្រោយ ត្រឡប់ មកពី ចំការ លោក ខឹម វាសនា
( កំពង់ឆ្នាំង ) ៖ យុវជន ម្នាក់ បាន ចងក សម្លាប់ ខ្លួន បន្ទាប់ពី ត្រឡប់ មកពី ចម្ការ លោក ខឹម វាសនា នៅ ខេត្ត សៀមរាប វិញ ហើយ ត្រូវបាន ឪពុក ម្ដាយ ណែនាំ និង ស្ដី បន្ទោស ឱ្យ បន្តិចបន្តួច ព្រោះ មិន ចង់ឲ្យ កូន ត្រឡប់ ទៅវិញ ។
ជនរងគ្រោះ ដែល បាន ចងក សម្លាប់ ខ្លួន ខាងលើ នេះ មាន ឈ្មោះ ម៉ាត ម៉ាន អាយុ ២០ ឆ្នាំ មាន ទីលំនៅ ភូមិ ស្រែ ចាន ឃុំ ទួល ខ្ពស់ ស្រុក ទឹក ផុស ខេត្ត កំពង់ឆ្នាំង ។ ជនរងគ្រោះ បាន ចងក សម្លាប់ ខ្លួន នៅ នឹង ដើមឈើ ក្បែរ វាល ស្រែ នៅ វេលា ម៉ោង ៦៖៣០ នាទី ព្រឹក ថ្ងៃទី ៥ ខែកញ្ញា ឆ្នាំ ២០២២ ។
លោក អធិការ បាន បន្ត ថា យុវជន រូប នេះ បាន ទៅ ស្នាក់ នៅ ចំការ លោក ខឹម វាសនា ជាមួយនឹង មិត្តភក្កិ ដែល មកពី ប្រទេស កូរ៉េ ខណៈ នោះ ឪពុក ម្ដាយ បាន ឃាត់ កូន មិន ឲ្យ ទៅ ដែរ តែ រូប គេ នៅតែ មិន ស្ដាប់ ការហាមឃាត់ របស់ ពុក ម្ដាយ ។ រូប គេ បាន ចេញ ទៅ នៅ ចំការ លោក ខឹម វាសនា នៅ ថ្ងៃទី ២៧ ខែសីហា នឹង បាន ត្រឡប់មក វិញ នៅ ថ្ងៃទី៣០ ខែសីហា លុះ នៅ ព្រឹក ថ្ងៃទី ៥ ខែកញ្ញា នេះ យុវជនជា ជនរងគ្រោះ បាន សម្រេចចិត្ត បញ្ចប់ ជីវិត ដោយ ខ្លួន ឯង ។
ឆ្លៀត ក្នុង ឱកាស នេះ លោក អធិការ ក៏ សុំ ផ្ដាំផ្ញើ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ឈប់ ចាញ់បោក និង ជឿ តាម ការអូសទាញ របស់ ក្រុម មនុស្ស មួយចំនួន ឲ្យ ទៅ សា្នក់ នៅក្នុង ចំការ របស់ លោក ខឹម វាសនា ដើម្បី រក្សា ជីវិត ដោយសារតែ មាន ទឹក លិច ពិភពលោក ។ លោក ថា ការជឿ ដោយ ភាពឆោត នេះ បាន ធ្វើឲ្យ អ្នក ខ្លះ ចាកចេញ ចោល ពី ផ្ទះ សំបែង ចោល ក្រុមគ្រួសារ អស់ រយៈពេល ជាច្រើន ថ្ងៃ ជាមួយនឹង ការខាតបង់ ទ្រព្យសម្បត្តិ យ៉ាង ច្រើន ផងដែរ ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ដោយ ដកស្រង់ សំដី របស់ លោក Suzuki ដែល បាន ថ្លែង ក្នុង សន្និសីទ សារព័ត៌មាន មួយ ថា៖ « ចំណាប់អារម្មណ៍ របស់ ខ្ញុំ គឺ ថា ការប្រែប្រួល ទីផ្សារ រូបិយប័ណ្ណ បាន ប្រែក្លាយ កាន់តែ ខ្លាំង នៅ ពេល ថ្មី ៗ នេះ » ។
លោក បាន មានប្រសាសន៍ ថា៖ « ការប្រែប្រួល តម្លៃ រូបិយប័ណ្ណ ខ្លាំង និង គ្មាន សណ្ដាប់ធ្នាប់ អាច មាន ផល ប៉ះពាល់ អវិជ្ជមាន ដល់ សេដ្ឋកិច្ច និង ស្ថានភាព ហិរញ្ញវត្ថុ ។ យើង នឹង ឆ្លើយតប ឱ្យ បាន ត្រឹមត្រូវ តាម ការចាំបាច់ ដោយ ធ្វើ ការងារ យ៉ាង ជិតស្និទ្ធ ជាមួយ អាជ្ញាធរ របស់ ប្រទេស ផ្សេង ៗ » ។
កាថ្លែង របស់ លោក បាន ធ្វើឡើង បន្ទាប់ពី អ្នកនាំពាក្យ កំពូល របស់ រដ្ឋាភិបាល ជប៉ុន បាន ព្រមាន ម្តង ទៀត កាលពី ថ្ងៃសុក្រ ថា អាជ្ញាធរ កំពុង ឃ្លាំមើល ការប្រែប្រួល តម្លៃ រូបិយប័ណ្ណ ជាមួយ ភាពប្រុង ជើង ការ ខ្លាំង ។
លោក បាន មានប្រសាសន៍ ថា៖ « ការប្រែប្រួល ទីផ្សារ រូបិយប័ណ្ណ កំពុង កើនឡើង នា ពេល ថ្មី ៗ នេះ ដូច្នេះ រដ្ឋាភិបាល នឹង តាមដាន យ៉ាង ដិតដល់ នូវ ការផ្លាស់ប្តូរ អត្រា ប្តូរ ប្រាក់ ជាមួយនឹង ភាពប្រុង ជើង ការខ្ពស់ » ។
កម្មវិធី បុណ្យ សព មហា ឧបាសិកា ញឹម តេង ដែល នឹង ត្រូវ បូជា នៅ ថ្ងៃទី ០៧ ខែកញ្ញា នាវត្ត និរោធរ ង្ស៉ី
( ភ្នំពេញ ) ៖ ក្រុមគ្រួសារ បង្ហាញ ពេលវេលា នៃ កម្មវិធី បុណ្យ សព របស់ មហា ឧបាសិកា ញឹម តេង ដែល ជា ម្តាយ ក្មេក របស់ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃទី ៤ ខែកញ្ញា ឆ្នាំ ២០២២ វេលា ម៉ោង ១៖ ៤០ នាទី រសៀល ក្នុង ជន្មាយុ ៩៤ ឆ្នាំ ដោយ រោគា ពាធ ។
ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ម្តាយ ក្មេក លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន
យើងខ្ញុំ ទាំងអស់ គ្នា សូម ចូលរួម រំលែក នូវ មរណទុក្ខ ដោយ ក្ដីស្រណោះ និង សង្វេ គ សោកស្ដាយ បំផុត ជាមួយ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការ កិច្ច ព្រមទាំង ក្រុមគ្រួសារ ចំពោះ ការបាត់បង់ មហា ឧបាសិកា ញឹម តេង នា ពេលនេះ និង សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហា ឧបាសិកា ញឹម តេង សូម បាន ចាប់បដិសន្ធិ ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ក្នុង ជំនួប ជម្រាប លា របស់ លោក ប៉ាន យ៉ារ៉ាក់ ពុល ថាប់ ឯក អគ្គ រាជ ទូត ថៃ ប្រចាំ កម្ពុជា ក្រោយ បញ្ចប់ បេសកកម្ម ការ ទូត នៅ ព្រឹក ថ្ងៃចន្ទ ទី០៥ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន គូស រំលេច ថា ទោះបី ស្ថិត នៅក្នុង កាលៈទេសៈ នៃ ជំងឺ កូវីដ១៩ ក៏ដោយ កម្ពុជា និង ថៃ បាន ខិតខំ ធ្វើ ការរួមគ្នា ជំរុញ ទំនាក់ទំនង ប្រទេស ទាំង ពីរ និង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ពាណិជ្ជកម្ម អប់រំ និង វិស័យ ដទៃ ទៀត បាន យ៉ាង ល្អ ជាទីមោទនភាព ។
សម្រាប់ សម្តេច តេជោ ហ៊ុន សែន ការរក្សា នូវ កំណើន ពាណិជ្ជកម្ម ក៏ ដូចជា កិច្ចសហប្រតិបត្តិការ លើ វិស័យ នានា ក្នុង កំលុង ពេល វិបត្តិ ជំងឺ កូវីដ១៩ នេះ ក៏ ដោយសារ កិច្ចប្រឹងប្រែង របស់ មន្ត្រី នៃ រាជ រដ្ឋាភិបាល ប្រទេស ទាំង ពីរ ។ ក្នុង ន័យ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ចំពោះ លោក ប៉ាន យ៉ារ៉ាក់ ពុល ថាប់ ដែល បាន ខិតខំ បំពេញ បេសកកម្ម ការ ទូត ធ្វើឱ្យ ប្រទេស ទាំង ពីរ មាន ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ កាន់តែ ល្អ ប្រសើរ ។
លោក ប៉ាន យ៉ារ៉ាក់ ពុល ថាប់ ក៏ បាន លើក បង្ហាញ ពី កិច្ចប្រឹងប្រែង ក្នុង ការជំរុញ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ នានា ក្នុង កំលុង ពេល បំពេញ បេសកកម្ម ការ ទូត នៅ កម្ពុជា ផងដែរ ។ លោក បាន ជម្រាប សម្តេច តេជោ ថា ពេល លោក មក បំពេញ បេសកកម្ម ការ ទូត នៅ កម្ពុជា កាលពី ឆ្នាំ ២០១៨ លោក បាន ប្តេជ្ញា ថា នឹង ពង្រីក ពង្រឹង កិច្ចសហប្រតិបត្តិការ និង ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ ខ្លាំង ឡើង ដោយ ឈរ លើ មូលដ្ឋាន ដែល មាន ស្រាប់ ។
លោក បន្ត ថា នៅ ពេល នេះ ការសន្យា របស់ លោក បាន លេចចេញ ជា ផ្លែ ផ្កា ក្នុង នោះ កិច្ចសហប្រតិបត្តិការ និង ទំនាក់ទំនង រវាង កម្ពុជា - ថៃ ត្រូវបាន ពង្រីក និង ពង្រឹង ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ បាន កើនឡើង ១០ភាគរយ ទោះបី ស្ថិត នៅក្នុង ដំណាក់កាល នៃ វិបត្តិ ជំងឺ កូវីដ១៩ ក៏ដោយ ។ បន្ថែម ពីលើ នោះ វិស័យ អប់រំ ការអភិវឌ្ឍ ធនធាន មនុស្ស និង វិស័យ ដទៃ ទៀត ក៏ មាន ការរីកចម្រើន ផងដែរ ។
របាយការណ៍ បាន បង្ហាញ ថា ការដោះដូរ ពាណិជ្ជកម្ម រវាង កម្ពុជា - ថៃ ឆ្នាំ ២០២១ សម្រេចបាន ទឹក ជិត ៨ ពាន់ លាន ដុល្លារ កើន ប្រមាណ ១០ភាគរយ ។ ក្នុង នោះ ការនាំចេញ ពី កម្ពុជា ទៅ ថៃ មាន ទំហំ ទឹកប្រាក់ ៨៩៤ លាន ដុល្លារ អាមេរិក ។ ចំណែក ការនាំចូល ពី ថៃ មាន ទឹកប្រាក់ ៦.១ ពាន់ លាន ដុល្លារ ។
លោក ប៉ាន យ៉ារ៉ាក់ ពុល ថាប់ បាន គោរព ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជា ទីបំផុត ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន និង រាជ រដ្ឋាភិបាល កម្ពុជា ដែល តែងតែ ផ្តល់ កិច្ចសហការ ល្អ ឱ្យ បេសកកម្ម ការ ទូត របស់ លោក ទទួលបាន ជោគជ័យ ត្រជះ ត្រចង់ ។
នៅក្នុង ជំនួប ជម្រាប លា សម្តេច តេជោ នា ព្រឹក មិញ នេះ លោក ពុល ថាប់ ក៏ បាន គោរព ថ្លែងអំណរគុណ សម្តេច តេជោ ដែល បាន ផ្តល់ វ៉ាក់សាំង ចាក់ ជូន រូបលោក និង មន្ត្រី ស្ថានទូត ថៃ ប្រចាំ នៅ កម្ពុជា ។
ឯក អគ្គ រដ្ឋទូត ចប់ អាណត្តិ រូប នេះ ក៏ បាន សម្តែង នូវ ការអបអរសាទរ ជូន ចំពោះ សម្តេច តេជោ និង រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ បាន ដោយ ជោគជ័យ ហើយ ក្នុង នាម ប្រធាន អាស៊ាន បាន បើក ប្រទេស ឡើងវិញ ដឹកនាំ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន និង កិច្ចប្រជុំ ពាក់ព័ន្ធ បាន ដោយ ជោគជ័យ ដែល ជា ការឆ្លុះបង្ហាញ ឱ្យ ឃើញ ពី តួនាទី ដ៏ រឹងមាំ របស់ កម្ពុជា ក្នុង ឆាក អន្តរជាតិ ។
សូម បញ្ជាក់ ថា លោក ប៉ាន យ៉ារ៉ាក់ ពុល ថាប់ បាន អញ្ជើញ មក បំពេញ ការងារ ជា ឯក អគ្គ រាជ ទូត ថៃ ប្រចាំ នៅ កម្ពុជា កាលពី ឆ្នាំ ២០១៨ ។ ក្នុង អំឡុង ពេល បំពេញ ការងារ នៅ កម្ពុជា នេះ លោក បាន យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការលើកកម្ពស់ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ជាច្រើន រវាង កម្ពុជា និង ថៃ ដែល ជា ប្រទេស ភូមិ ផង របង ជាប់ គ្នា នេះ ៕
គួរ បញ្ជាក់ ថា អាល្លឺម៉ង់ មាន ទាហាន ប្រហែល ១.៥០០ នាក់ រួចហើយ នៅលើ ទឹកដី របស់ លីទុយ អានី ។ អតីត រដ្ឋបាល់ ទិក ដែល គ្រប់គ្រង ដោយ សូវៀត មាន អេស្តូនី ឡេតូនី និង លីទុយ អានី ដែល ឥឡូវ នេះ ជា សមាជិក របស់ សហភាព អឺរ៉ុប និង អង្គការ ណា តូ និង កំពុង មាន ការព្រួយបារម្ភ ថា ពួកគេ អាចនឹង ក្លាយជា ប្រទេស បន្ទាប់ ប្រសិនបើ រុស្ស៊ី យកឈ្នះ អ៊ុយក្រែន ៕
ស្ត្រី ជា ម្តាយ រូប នេះ បាន អះអាង ថា កូនស្រី ខ្លួន ព្រោះតែ ជឿ ការឃោសនា របស់ លោក ខឹម វាសនា និង បក្ខពួក ពី គ្រោះមហន្តរាយ ពិភពលោក ដោយសារ ការរញ្ជួយ ដី និង ទឹក ជំនន់ បាន រត់ គេច ពី កន្លែង ធ្វើការ មក ស្នាក់ នៅ ចម្ការ មិន ឱ្យ ម្តាយ និង ក្រុមគ្រួសារ ដឹង នោះ ឡើយ ។
បើ តាម ស្ត្រី ជា ម្តាយ បាន រៀបរាប់ប្រាប់ លោក ប៉ាន់ ខេម ប៊ុន ថន ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន ថា កូនស្រី របស់ លោកស្រី ជា មនុស្ស មាន ចរិត ស្លូតបូត តែ ពេលនេះ រូប នាង បាន ប្រកែក ដាច់ អហង្កា មិន ចេញមក ជួយ ម្តាយ ។ កាត់ផ្តាច់ អស់ មនោសញ្ចេតនា និង ការអាឡោះអាល័យ ទាំង រវាង ម្តាយ និង កូន ។
ស្ត្រី ជា ម្តាយ បាន រៀបចំ ទាំង ទឹកភ្នែក ថា ចាប់តាំងពី កូនស្រី រត់ មក ស្នាក់ នៅ ចម្ការ លោក ខឹម វាសនា គាត់ ទ្រហោ យំ រាល់ ថ្ងៃ នឹក អាណិត កូនស្រី ។
មកដល់ ពេលនេះ ទោះបី លោកស្រី ប្រឹង អង្វរ លួន តួយ៉ាងណា ក៏ កូនស្រី មិន ព្រម ចេញ ពី ចម្ការ នោះ ឡើយ ។ រូប គេ នៅតែ ប្រកាន់ មាំ ក្នុង ការជឿ រឿង គ្រោះមហន្តរាយ ពិភពលោក ។
ជាមួយ ទឹកភ្នែក ហូរ ស ស្រាក់ ស្ត្រី ជា ម្តាយ ទទូច សូម សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ជួយ អន្តរាគមន៍ ឱ្យ កូនស្រី របស់ ខ្លួន បាន ចេញ ពី ចម្ការ ត្រឡប់ ទៅ ផ្ទះ វិញ ។
នេះ មិន មែន ជា ករណី ទី មួយ នោះ ទេ ។ ក្រៅតែ ពី ស្ត្រី ជា ម្តាយ រូប នេះ មាន ម្តាយ ឪពុក ជីដូន ជីតា ស្វាមី ភរិយា សាច់ញាតិ ជាច្រើន ទៀត បាន ទៅ ស្វែងរក កូន ចៅ ភរិយា ស្វាមី និង សាច់ញាតិ ខ្លួន ដែល លង់ ជឿ តាម ការអូសទាញ របស់ ខឹម វាសនា និង បក្ខពួក ទៅ រស់ នៅក្នុង ចម្ការ ក្នុង ស្រុក បន្ទាយស្រី ខេត្ត សៀមរាប ដើម្បី គេច ពី គ្រោះមហន្តរាយ ពិភពលោក ដែល គេ បាន ឃោសនា និង ប្រឌិត ឡើង ។
បើ តាម លោក ទៀ សីហា អភិបាល ខេត្ត សៀមរាប បាន ឱ្យដឹង ថា មាន ពាក្យបណ្តឹង រហូតដល់ ជាង ៧០០ បណ្តឹង ហើយ បាន ប្តឹង ស្វែងរក សាច់ញាតិ ដែល គេ ពង្វក់ និង អូសទាញ ឱ្យ ទៅ នៅក្នុង ចម្ការ ។
ខាងក្រោម នេះ ជា របាយការណ៍ នៃ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ប្រទេស អាស៊ាន គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៤ ខែកញ្ញា ឆ្នាំ ២០២២៖
ថ្លែង នៅឯ វិទ្យាស្ថាន ស្រាវជ្រាវ មួយ ក្នុង ប្រទេស សិង្ហបុរី នា ថ្ងៃចន្ទ នេះ លោកស្រី ហេហ្សឺ បាន កត់សម្គាល់ ថា លោកស្រី ស៊ូជី ត្រូវបាន គេ រកឃើញ ថា ជាប់ ពិរុទ្ធ ពី បទ ក្លែងបន្លំ ការបោះឆ្នោត កាលពី សប្តាហ៍ មុន ហើយ ត្រូវបាន កាត់ទោស ឲ្យ ជាប់ ពន្ធនាគារ ៣ឆ្នាំ បន្ថែម ទៀត លើ បទល្មើស មួយចំនួន មុន ដែល តុលាការ យោធា បាន ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ សរុប ១៧ឆ្នាំ រួចទៅហើយ ។
លោកស្រី ហេហ្សឺ បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ មាន ការព្រួយបារម្ភ យ៉ាង ខ្លាំង អំពី សុខភាព របស់ លោកស្រី ស៊ូជី ដែល មាន អាយុ ៧៦ ឆ្នាំ ទៅ ហើយ នោះ និង សូម ថ្កោល ទោស ការកាត់ទោស បន្ថែម មក លើ លោកស្រី ស៊ូជី នា ពេល ថ្មី ៗ នេះ ផងដែរ » ។
គួរ បញ្ជាក់ ថា មីយ៉ាន់ម៉ា បាន ធ្លាក់ ចូល ទៅក្នុង វិបត្តិ នៅ ពេល ដែល យោធា បាន ដណ្តើម អំណាច កាលពី ឆ្នាំ ២០២១ គឺ ក្រោយពី ប្រទេស អាស៊ាន មួយ នេះ បាន កោះ ប្រជុំ សភា ថ្មី ជា លើក ដំបូង ចាប់តាំងពី ការបោះឆ្នោត ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។ ការដណ្តើម អំណាច នាំឲ្យ មាន ការតវ៉ា ទូទាំង ប្រទេស ហើយ យោធា បាន ឆ្លើយតប ដោយ ការប្រើ កម្លាំង បង្ក្រាប លើ ក្រុម ប្រឆាំង ៕
