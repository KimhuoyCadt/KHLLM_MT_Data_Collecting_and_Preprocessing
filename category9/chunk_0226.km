( ស្វាយរៀង ) ៖ លោក រស់ ផារិទ្ធ អភិបាល រង ខេត្ត ស្វាយរៀង បាន ថ្លែង ថា ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល មកពី គណបក្ស នយោបាយ ផ្សេង គ្នា ត្រូវតែ ខិតខំ រួម សាមគ្គី សហការធ្វើ ការងារ ជាមួយគ្នា ប្រកបដោយ ការទទួលខុសត្រូវ ដើម្បី បម្រើ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ឃុំ សង្កាត់ របស់ ខ្លួន ដោយ មិន ត្រូវ រើសអើង បែងចែក ពណ៌ សម្បុរ ឬ និន្នាការ នយោបាយ នោះ ឡើយ ។
ការថ្លែង បែប នេះ របស់ លោក រស់ ផារិទ្ធ អភិបាល រង ខេត្ត ស្វាយរៀង នៅក្នុង ឪកាស ដែល លោក តំណាង លោក អភិបាល ខេត្ត បើក វគ្គ បណ្តុះបណ្តាល តម្រង់ ទិស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ជាប់ ឆ្នោត ថ្មី អាណត្តិ ទី៥ នៅ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង នា ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២២ នៅ សាល ប្រជុំ សាលា ស្រុក ស្វាយ ជ្រំ ។ សិក្ខាសាលា នេះ មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា ឃុំ ដែល ជាប់ ឆ្នោត ថ្មី ជាច្រើន រូប ផងដែរ ។
លោក អភិបាល រង ខេត្ត បាន ថ្លែង កោតសរសើរ ដល់ លោក លោកស្រី ដែល ជា សមាជិក ក្រុមប្រឹក្សា ឃុំ នៅ ស្រុក ស្វាយ ជ្រំ ដែល ទើប ជាប់ ឆ្នោត ថ្មី និង បាន ចូលរួម ក្នុង វគ្គ បណ្តុះបណ្តាល តម្រង់ ទិស សម្រាប់ ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ក្នុង អាណត្តិ ថ្មី របស់ ខ្លួន ដើម្បី សម្រួល ដល់ ការងារ នៅ រដ្ឋបាល ឃុំ សង្កាត់ ឲ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ។
លោក បន្ត ថា វគ្គ បណ្តុះបណ្តាល តម្រង់ ទិស នេះ ដែល រៀបចំ ដោយ សាលា រដ្ឋបាល មូលដ្ឋាន ក្រសួង មហាផ្ទៃ និង រដ្ឋបាល ខេត្ត ពិតជា មាន សារៈសំខាន់ ណាស់ សម្រាប់ លោក លោកស្រី ជា សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល ទើបនឹង ជាប់ ថ្មី ក្នុង អាណត្តិ ទី ៥នេះ ដូច្នេះ សូម ស្នើរ ដល់ លោក លោកស្រី ត្រូវ យកចិត្តទុកដាក់ ស្តាប់ គ្រូ ឧទ្ទេស ដើម្បី ជា ពុទ្ធិ ក្នុង ការអនុវត្តន៍ ការងារ នៅ រដ្ឋបាល របស់ ខ្លួន ប្រកបដោយ ឆន្ទៈ ការគោរព នូវ តួន នាទី ភារៈកិច្ច ឲ្យបាន ល្អ ប្រសើរ ផងដែរ ។
សូម បញ្ជាក់ ថា ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ខេត្ត ស្វាយរៀង ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ជាប់ ឆ្នោត ថ្មី មាន ចំនួន ១៩៦ នាក់ ស្រី ៤៨ នាក់ ក្នុង ចំណោម ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ៥១៨ នាក់ ស្រី ១៣៤ នាក់ ៕
ពុទ្ធិក សាកលវិទ្យាល័យ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នៅ ខេត្ត កំពង់ចាម ត្រូវបាន បញ្ចុះ បឋមសិលា សាងសង់
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា និង សម្តេច ឈឹង ប៊ុន ឈា ព្រះអគ្ការធិការ រង រួម និង ថ្នាក់ដឹកនាំ ខេត្ត ជាច្រើន ទៀត នៅ ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ និង និមន្ត បញ្ចុះ បឋមសិលា សាងសង់ ពុទ្ធិក សាកលវិទ្យាល័យ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ស្ថិត នៅក្នុង បរិវេណ វត្ត ជ្រោយ ថ្ម សង្កាត់ បឹង កុក ក្រុង កំពង់ចាម ។
ក្នុង ឱកាស នោះ ព្រះសោម វេទី អ៊ឹម សុភក្តិ ព្រះសាកលវិទ្យាធិការ នៃ ពុទ្ធិក សាកលវិទ្យាល័យ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន មាន សង្ឃ ដិកា ថា ពុទ្ធិក សាកលវិទ្យាល័យ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន បាន រៀបចំ ពិធី បញ្ជុះ បឋមសិលា សាងសង់ អគារ សិក្សា ១ ខ្នង ៤ជាន់ ៩ បន្ទប់ និង សាល ប្រជុំ ចំនួន ១ ។
ពុទ្ធិក សាកលវិទ្យាល័យ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន បាន បង្កើតឡើង ដោយ អនុក្រឹត្យ លេខ ១៩២ អន ក្រ. បក ចុះ ថ្ងៃទី ២៣ ខែសីហា ឆ្នាំ ២០១១ របស់ រាជ រដ្ឋាភិបាល នៃ ព្រះរាជាណាចក្រ កម្ពុជា មាន ទីតាំង ស្ថិត នៅ វត្ត សុទស្សា នា រាម ជ្រោយ ថ្ម ផ្លូវ ព្រះបាទ សីហនុ ( ជាប់ មាត់ ទន្លេ មេគង្គ ) សង្កាត់ បឹង កុក ក្រុង កំពង់ចាម ខេត្ត កំពង់ចាម ជា គ្រឹះស្ថាន ពុទិ្ធក ឧត្តម សិក្សា របស់ រដ្ឋ ស្ថិត នៅក្រោម ការគ្រប់គ្រង របស់ ក្រសួង ធម្មការ និង សាសនា បាន ដំណើរការ បណ្តុះបណ្តាល តាំងពី ឆ្នាំ ២០១១មក ម្ល៉េះ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត បាន អំពាវនាវ ដល់ សប្បុរសជន ទូទៅ សូម បន្ត ចូលរួមចំណែក គាំទ្រ និង កសាង អភិវឌ្ឍន៍ វិស័យ ពុទ្ធិក សិក្សា នៅ កម្ពុជា ឱ្យ បាន កាន់តែ ប្រសើរឡើង ថែម ទៀត ៕ ផ្ទះ ៣ខ្នង ត្រូវបាន ផ្តល់ ជូន ដល់ គ្រួសារ ក្រីក្រ ពី សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ លោក សុខ ផេង អនុប្រធាន អចិន្ត្រៃយ៍ គណៈកម្មាធិការ សាខា នៅ ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ ក្រុម ប្រតិបត្ត សាខា និង ក្រុមការងារ អនុសាខា ក្រុង អ្នកស្ម័គ្រចិត្ត ភូមិ ទីប្រឹក្សា យុវជន និង យុវជន កាកបាទ ក្រហម កម្ពុជា ចុះ សួរសុខទុក្ខ ប្រគល់ ផ្ទះ ចំនួន ៣ខ្នង ធ្វើ អំពី ឈើ ជញ្ជាំង ស័ង្កសី និង ដំបូល ប្រក់ ក្បឿង ជ័រ រួមទាំង បង្គន់ អនាម័យ ចំនួន ៣ ដែល ជា អំណោយ របស់ សាខា ខេត្ត កាកបាទ ក្រហម កម្ពុជា ព្រៃវែង ជូន ដល់ គ្រួសារ ក្រីក្រ ៣ គ្រួសារ ក្នុង ក្រុង ព្រៃវែង ។
ក្នុង ឱកាស នោះ លោក សុខ ផេង បាន នាំមក នូការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន ប្រធាន កិត្តិយស សាខា ពិសេស សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ជានិច្ចកាល តែងតែ គិតគូរ ដល់ សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ ស្រទាប់ វណ្ណៈ ដោយ មិន ប្រកាន់ ពណ៌ សម្បុរ ពូជសាសន៍ និន្នាការ នយោបាយ អ្វី ឡើយ ស្រប តាម ពាក្យស្លោក « ទីណា មាន ទុក្ខលំបាក ទីនោះ មាន កាកបាទ ក្រហម កម្ពុជា » ។
សូម បញ្ជាក់ ថា ក្រៅពី ការប្រគល់ ផ្ទះ និង បង្គន់ អនាម័យ សាខា ក៏ បាន ផ្តល់ ជូន នូវ អំណោយ និង ថវិកា ក្នុង ១គ្រួសារ ១០០.០០០ រៀល ក្នុង នោះ អនុសាខា ក្រុង បន្ថែម ថវិកា ចំនួន ៥ ម៉ឺន រៀល ក្នុង ១គ្រួសារ ក្នុង នោះ បាន ឧបត្ថម្ភ ថវិកា ផ្ទាល់ ដល់ គ្រួសារ នៅ សង្កាត់ បារាយណ៍ ចំនួន ២០ ម៉ឺន រៀល ផងដែរ ៕
ពលរដ្ឋ រងគ្រោះ ដោយ រន្ទះ បាញ់ ស្លាប់ ម្នាក់ និង ពលរដ្ឋ ទីទ័ល ក្រ ចាស់ជរា នៅ ស្រុក ចុង កាល់ ទទួលបាន អំណោយ មនុស្សធម៌ ពី សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ឧត្តរមានជ័យ
ក្នុង នាម លោក ប៉ែន កុសល្យ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ឧត្តរមានជ័យ លោក ឃិន ញ៉ាណ បាន ថ្លែង នូវ ការចូលរួម សោកស្តាយ ចំពោះ ហេតុការណ៍ គ្រោះ ធម្មជាតិ រន្ទះ បាញ់ ដែល បណ្តាលឲ្យ ពលរដ្ឋ ជា អ្នកស្ម័គ្រចិត្ត កាកបាទ ក្រហម ម្នាក់ ស្លាប់ ចោល ក្រុមគ្រួសារ ។ លោក ក៏ បាន ណែនាំឲ្យ ប្រជាពលរដ្ឋ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ការពារ ខ្លួន ពី គ្រោះ ធម្មជាតិ ផ្សេង ៗ ពិសេស គ្រោះ ទឹក ជំនន់ ខ្យល់ កន្ត្រាក់ ភ្លៀង ផ្គរ រន្ទះ ជាដើម ។
ក្នុង ពិធី បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ បេតុង ប្រព័ន្ធ លូ បង្ហូរ ទឹក និង សួរសុខទុក្ខ សិស្ស នគរបាល វគ្គ បណ្តុះបណ្តាល កម្រិត បឋម វិជ្ជាជីវៈ នគរបាល ជំនាន់ ទី ១៥ លើក ទី២ នា ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២២ នេះ នៅ សាលា នគរបាល ជាតិ ភូមិភាគ ៤ ក្នុង ខេត្ត សៀមរាប សម្តេច ក្រឡាហោម បាន បង្ហាញ អំពី កំណែទម្រង់ កងកម្លាំង នគរបាល នៅ ចំណុច សំខាន់ ៗ ៤ចំណុច មាន៖
១៖ ធ្វើឲ្យ បាន នូវ ការ ប្រាកដប្រជា ក្នុង ការជ្រើសរើស មន្រ្តី នគរបាល ចូល ក្របខ័ណ្ឌ រដ្ឋ ដើម្បី ន ធានា គុណភាព បន្ថែម លើ នោះ រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ពុំ ទាន់ ពេញចិត្ត មួយ រយ ភាគរយ នោះ ទេ ដោយ ការប្រឡង តែ លេច ចេញ នៅមុខ សកម្ម និង អសកម្ម តែ បើ ប្រៀបធៀប កាលពី មុន គឺ បាន បោះជំហាន ទៅ មុខ តែ នៅ កែទម្រង់ និង បន្ត ដោះស្រាយ បន្ថែម ទៀត ។
២៖ ក្រោយពី ប្រឡង ជាប់ ក្រខណ្ឌ ហើយ មិន ទាន់ អាច អោយ ទៅ ធ្វើ ការកើត ទេ ត្រូវ ទទួល ការបណ្ដុះបណ្ដាល ជាមុន សិន ព្រោះ នគរបាល គឺជា មន្រ្តី ជំនាញ មួយ ទាក់ទង និង សុខ ទុក្ខ អាយុជីវិត ប្រជាពលរដ្ឋ និង ការកសាង ប្រព័ន្ធ យុត្តិធ ម៏ នៅក្នុង សង្គម ការពារ ទ្រព្យសម្បត្តិ សាធារណៈ ក៏ ដូចជា ទ្រព្យសម្បត្តិ ឯកជន របស់ ប្រជាពលរដ្ឋ ។
៣៖ ក្រោយ បញ្ចប់ ការពង្រឹង និង បណ្ដុះបណ្ដាល សមត្ថភាព វិជ្ជាជីវៈ នឹង ត្រូវបាន ប្រគល់ ភារកិច្ច បំពាក់ ឯកសណ្ឋាន ផ្លូវការ បញ្ជូល ក្របខណ្ឌ ពេញ សិទ្ធ ហើយ ត្រូវ ស្ថិត ក្រោម ការវាយតម្លៃ ពី អង្គភាព របស់ ខ្លួន ក្នុង ការបំពេញ ការងារ ឬ ការតែងតាំង ណាមួយ ។
៤៖ ការលើកស សើរ និង ការដាក់ ពិន័យ ដោយ ការលើកស សើរ តាម រយះ ការឡើង តួនាទី ឋានន្តរសក្ដិ ជាដើម ការដាក់ ពិន័យ ចំពោះ មន្រ្តី ខិល ខូច មន្រ្តី ណា ដែរ មិន ល្អ ដែរ ធ្វើអោយ ប៉ះពាល់ ដល់ ប្រយោជន៍ ប្រជាពលរដ្ឋ គឺ ត្រូវ ប្រឈមមុខ និង ការព្រមាន លើក ទី១ ទី២ បើ មិន កែប្រែ ទេ គឺ ត្រូវ លុប ឈ្មោះ ចេញ ពី ក្របខ័ណ្ឌ ។
ដំណើរទស្សនកិច្ច របស់ លោកស្រី ណូលីន ហេហ្សឺ (Noeleen Heyzer) កើត មាន ឡើង បន្ទាប់ពី ការអំពាវនាវ ថ្មី ចុងក្រោយ គេ របស់ កុ្រមប្រឹក្សា សន្តិសុខ UN ដែល ស្នើ ឱ្យ មាន ការបញ្ចប់ ជាបន្ទាន់ នូវ អំពើហិង្សា គ្រប់ ទម្រង់ ព្រមទាំង ការបើក ទទួល ជំនួយ មនុស្សធម៌ ដោយ ពុំ មាន ការរារាំង នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា ។
ប៉ុន្តែ បើ តាម អ្នកនាំពាក្យ របប យោធា មីយ៉ាន់ម៉ា វិញ លោកស្រី Heyzer នឹង ទៅដល់ ប្រទេស មីយ៉ាន់ម៉ា នៅ ថ្ងៃពុធ សប្តាហ៍ នេះ ហើយ កំលុង ពេញ ទស្សនកិច្ច លោកស្រី នឹង ជួបពិភាក្សា ជាមួយ មេដឹកនាំ ព្រមទាំង មន្រ្តី ជាន់ ខ្ពស់ មីយ៉ាន់ម៉ា ប៉ុន្តែ មិន មាន សំណើ សុំ ជួប ជាមួយ លោកស្រី ស៊ូជី ត្រូវបាន ធ្វើឡើង នោះ ឡើយ ៕
ព្រះរាជអាជ្ញា ខេត្ត កំពង់ឆ្នាំង ដឹកនាំ កម្លាំង សមត្ថកិច្ច ចុះបង្ក្រាប គ្រឿងញៀន នៅ ស្រុក រលាប្អៀ រ ឃាត់ខ្លួន ម្នាក់ និង ដកហូត ថ្នាំ ញៀន បាន ២.៥គីឡូក្រាម
( កំពង់ឆ្នាំង ) ៖ លោក អ៉ិត សុធា ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង បាន ដឹកនាំ នគរបាល ប្រឆាំង បទល្មើស គ្រឿងញៀន និង ការិយាល័យ ប្រឆាំង ភេរវកម្ម នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ឆ្នាំង សហការ ជាមួយ កងកម្លាំង នាយកដ្ឋាន សន្តិសុខ ផ្ទៃក្នុង ក្រសួង មហាផ្ទៃ ចុះបង្ក្រាប គ្រឿងញៀន ទ្រង់ទ្រាយ ធំ នៅក្នុង ភូមិ ធ្នុង កំបុត ឃុំ ក្រាំង ដី មាស ស្រុក រលាប្អៀរ ។
ប្រតិបត្តិការ នេះ កម្លាំង នគរបាល បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ និង ដកហូត វត្ថុតាង គ្រឿងញៀន ២. ៥០គីឡូក្រាម ព្រមទាំង សម្ភារ មួយចំនួន ទៀត ។ ចំពោះ ករណី នេះ សមត្ថកិច្ច ទើបតែ អនុញ្ញាតឲ្យ អ្នកសារព័ត៌មាន ផ្សព្វផ្សាយ ក្រោយពី បញ្ចប់ ការស៊ើបអង្កេត ករណី នេះ នា ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២២ ។
របាយការណ៍ របស់ សមត្ថកិច្ច បាន បង្ហាញ ថា ជនសង្ស័យ ដែល ត្រូវ សមត្ថកិច្ច ឃាត់ខ្លួន មាន ឈ្មោះ វណ្ណៈ បញ្ញា វឌ្ឍន៍ អាយុ ២៦ ឆ្នាំ មាន ទីលំនៅ ភូមិ ធ្នង់ កំបុត ឃុំ ក្រាំង ដី មាស ស្រុក រលាប្អៀរ ។
ក្នុង ប្រតិបត្តិការ បង្ក្រាប នេះ សមត្ថកិច្ច ចុះ ឆែក លំនៅដ្ឋាន ជនសង្ស័យ ដោយ រកឃើញ ថ្នាំ ញៀន ប្រភេទ មេ តំហ្វាតាមីន (ICE) ចំនួន ១៦ កញ្ចប់ លាក់ ទុក លើ ពិដាន និង ៩កញ្ចប់ ទៀត លាក់ ទុក ក្នុង ទូ បន្ទប់ ជនសង្ស័យ ។ សរុប ថ្នាំ ញៀន មាន ចំនួន ២៥ កញ្ចប់ ក្នុង មួយ កញ្ចប់ ៗ ទម្ងន់ ១០០ ក្រាម ទម្ងន់ សរុប ២.៥គីឡូក្រាម . ជញ្ជីង ថ្លឹង ថ្នាំ ញៀន ចំនួន ៥គ្រឿង . ឧបករណ៍ អ៊ុត ស្បោង ចំនួន ១ និង ឧបករណ៍ សម្រាប់ វេចខ្ចប់ ( ស្បោង ១ដុំ ) ។
សមត្ថកិច្ច បាន បញ្ជាក់ ថា ក្រោយ ឃាត់ខ្លួន និង ឆែក រកឃើញ វត្ថុតាង បទល្មើស ជាក់ស្តែង រួច ជនសង្ស័យ និង វត្ថុតាង ត្រូវបាន សមត្ថកិច្ច កសាង សំណុំរឿង បញ្ជូន ជនសង្ស័យ ទៅកាន់ នាយកដ្ឋាន សន្តិសុខ ក្រសួង មហាផ្ទៃ ចាត់ការ តាម នីតិវិធី ។
សូម បញ្ជាក់ ថា ករណី នេះ សមត្ថកិច្ច ទើប អនុញ្ញាតឲ្យ ផ្សាយ ដោយ សារ ទើប បិទ សំណុំរឿង ប្រតិបត្តិការ បង្ក្រាប គ្រឿងញៀន ខាងលើ នេះ ជា ករណី បង្ក្រាប មួយ ដែល មាន ចំនួន ដ៏ ច្រើន ដែល ពីមុន ៗ មក មិន ធ្លាប់ មាន ទេ នៅក្នុង ទឹកដី ខេត្ត កំពង់ឆ្នាំង ៕ នៅ រសៀល ស្អែក នេះ ប្រកាស ចូលកាន់ តំណែង អភិបាល រង រាជធានី ភ្នំពេញ ចំនួន ៣រូប
( ភ្នំពេញ ) ៖ អភិបាល រង រាជធានី ភ្នំពេញ ចំនួន ៣រូប ដែល ត្រូវ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចេញ អនុក្រឹត្យ តែងតាំង នោះ នឹង ត្រូវ ប្រកាស ចូលកាន់ តំណែង ជា ផ្លូវការ នៅ រសៀល ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០២២ ស្អែក នេះ ក្រោម អធិបតីភាព លោក សក់ សេដ្ឋា រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង មហាផ្ទៃ ព្រមទាំង មាន ការអញ្ជើញ ចូលរួម ពី លោក ម៉ប់ សារិន ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ និង លោក ឃួង ស្រេង អភិបាល រាជធានី ។
សម្តេច តេជោ បាន ថ្លែង ជំរុញ បែប នេះ ក្នុង ជំនួប ពិភាក្សា ការងារ ជាមួយ លោក វិទិត មុន តាប៊ន នៅ ព្រឹក ថ្ងៃអង្គារ ទី ១៦ ខែសីហា ឆ្នាំ ២០២២ នេះ នៅ វិមាន សន្តិភាព ។ លោក វិទិត មុន តាប៊ន ជនជាតិ ថៃ ត្រូវបាន អង្គការ សហ ប្រជាជាតិ តែងតាំង ទទួលបន្ទុក លើ ការងារ សិទ្ធិ មនុស្ស នៅ កម្ពុជា ជំនួស លោកស្រី រ៉ូណា ស្មីត កាលពី ខែឧសភា ឆ្នាំ ២០២១ ។
លោក បាន ផ្តើម ទស្សនកិច្ចការងារ របស់ លោក ជា លើក ដំបូង នៅក្នុង ប្រទេស កម្ពុជា ជា លើក ដំបូង ចាប់ពី ថ្ងៃទី ១៥ ដល់ ថ្ងៃទី ២៦ ខែសីហា ឆ្នាំ ២០២២ ។ ក្នុង ដំណើរ មកកាន់ កម្ពុជា ជា លើក ដំបូង ជា អ្នក រាយការណ៍ ពិសេស របស់ អង្គការ សហ ប្រជាជាតិ លើ ការងារ សិទ្ធិ មនុស្ស នៅ កម្ពុជា នេះ លោក វិទិត មុន តាប៊ន បាន ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន មុននឹង ចូល ជួប ជាមួយ អ្នក ពាក់ព័ន្ធ ទាំង ភាគី រាជ រដ្ឋាភិបាល និង អង្គការ សង្គម ស៊ីវិល ។
លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ឱ្យដឹង ថា នៅក្នុង ជំនួប ជាមួយ សម្តេច តេជោ លោក លោក វិទិត មុន តាប៊ន បាន សម្តែង ការអបអរសាទរ ចំពោះ ជោគជ័យ នៃ ការចាក់ ស្រោច វ៉ាក់សាំង នៅ កម្ពុជា ។
បើ តាម លោក អ៊ាង សុផល្លែត បាន គូសបញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន លើក បញ្ជាក់ ច្បាស់ លើ បញ្ហា សំណើ នីមួយ ៗ ដែល លើកឡើង ដោយ លោក វិទិត មុន តាប៊ន ។
បន្ថែម ពីលើ នោះ ច្បាប់ គ្រប់គ្រង ប្រទេសជាតិ ក្នុង គ្រា មាន អាសន្ន ត្រូវបាន អនុម័ត និង ដាក់ ឱ្យ ប្រើប្រាស់ ។ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន ចេញ អនុក្រឹត្យ ស្តីពី វិធានការ រដ្ឋបាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ និង ជំងឺ ឆ្លងកាច់ សាហាវ ប្រកបដោយ គ្រោះថ្នាក់ ផ្សេង ៗ ទៀត ។
សម្តេច តេជោ បាន សង្កត់ធ្ងន់ ថា ច្បាប់ ទាំងអស់ នេះ រៀបចំឡើង ក្នុង គោលបំណង ការពារ សន្តិសុខ ជាតិ និង សណ្តាប់ធ្នាប់ សាធារណៈ ការពារ អាយុជីវិត និង សុខភាព ប្រជាពលរដ្ឋ ព្រមទាំង ការពារ ទ្រព្យសម្បត្តិ និង បរិស្ថាន ។ ការចោទប្រកាន់ ថា បទបញ្ញត្តិ ទាំងនេះ ដើម្បី រឹតបន្តឹង លំហរ សង្គម ស៊ីវិល គឺ ពុំ ផ្អែក លើ មូលដ្ឋាន ត្រឹមត្រូវ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន គូស រំលេច ដែរ ថា រាល់ លិខិត បទដ្ឋាន គតិយុត្តិ ទាំងអស់ ដែល បាន អនុម័ត និង ដាក់ ឱ្យ ប្រើប្រាស់ គឺ ប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ នីត្យានុកូលភាព ភាពចាំបាច់ និង សម មាត្រ ដោយ មាន គោលបំណង តែ មួយ គត់ គឺ ដើម្បី សង្គ្រោះ អាយុជីវិត ការពារ ពលរដ្ឋ គោរព ច្បាប់ និង ការពារ បទល្មើស នានា ដែល បង្ក អស្ថិរភាព សង្គម ប៉ះពាល់ ដល់ សុខុមាលភាព ប្រជាពលរដ្ឋ និង សណ្តាប់ ថ្នាប់ សាធារណៈ ។
ពាក់ព័ន្ធ នឹង ដំណើរការបោះឆ្នោត នៅ កម្ពុជា វិញ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន លើកឡើង ថា កម្ពុជា បាន រៀបចំ ការបោះឆ្នោត យ៉ាង ទៀងទាត់ ចាប់តាំងពី ឆ្នាំ ១៩៩៣មក ។ មកដល់ ពេលនេះ កម្ពុជា បាន រៀបចំ ការបោះឆ្នោត សាកល ចំនួន ៦ដង និង ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ចំនួន ៥ដង ហើយ ត្រូវបាន អ្នក សង្កេតការណ៍ ជាតិ និង អន្តរជាតិ វាយតម្លៃ ថា បាន ប្រព្រឹត្តទៅ ដោយ តម្លាភាព សេរី និង យុត្តិធម៌ ។
សម្តេច តេជោ បាន គូស រំលេច ថា កម្ពុជា មាន មោទនភាព ចំពោះ ជោគជ័យ នៃ ដំណើរការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥ កាលពី ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២២ ដែល បាន ប្រព្រឹត្តទៅ ដោយ សេរី ត្រឹមត្រូវ និង យុត្តិធម៌ ក្នុង បរិយាកាស អព្យាក្រឹត្យ មាន សន្តិសុខ របៀបរៀបរយ គ្មាន អំពើហិង្សា និង ការគំរាមកំហែង ព្រមទាំង មាន គណបក្ស នយោបាយ ចំនួន ១៧ ចូលរួម ប្រកួតប្រជែង និង មាន ប្រជាពលរដ្ឋ ជាង ៨០ ភាគរយ ទៅ ចូលរួម បោះឆ្នោត ។
ពាក់ព័ន្ធ ការងារ អាទិភាព ជំនួយ បច្ចេកទេស និង កិច្ចសហប្រតិបត្តិការ ទៅ ថ្ងៃ អនាគត រវាង រាជ រដ្ឋាភិបាល កម្ពុជា និង ឧត្តម ស្នងការ អង្គការ សហ ប្រជាជាតិ លើ ការងារ សិទ្ធិ មនុស្ស វិញ សម្តេច តេជោ បាន ស្នើ ឱ្យ ការិយាល័យ ឧត្តម ស្នងការ អង្គការ សហ ប្រជាជាតិ និង អ្នក រាយការណ៍ ពិសេស គួរ រៀបចំ របាយការណ៍ ដែល ឆ្លុះបញ្ចាំង ការពិត ជាក់ស្តែង ត្រឹមត្រូវ និង មាន តម្លាភាព ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំ ឱ្យ ការិយាល័យ ឧត្តម ស្នងការ អង្គការ សហ ប្រជាជាតិ និង អ្នក រាយការណ៍ ពិសេស គួរ យកចិត្តទុកដាក់ ដោះស្រាយ នូវ និន្នាការ ដ៏ គួរឱ្យ ព្រួយបារម្ភ ពាក់ព័ន្ធ សិទ្ធិ មនុស្ស ដូចជា ការប្រើ សម្តី ស្អប់ខ្ពើម ការបង្កាច់បង្ខូច ការផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត ការអុជ អាល និង ការញុះញង់ ដែល ជ្រក ក្រោម ស្លាក សេរីភាព នៃ ការបញ្ចេញមតិ ។
បើ តាម លោក អ៊ាង សុផល្លែត នៅក្នុង ជំនួប នេះ លោក វិទិត មុន តាប៊ន ក៏ បាន កត់សម្គាល់ ពី ការអនុវត្តន៍ ច្បាប់ នៅ កម្ពុជា ផងដែរ ។ ពាក់ព័ន្ធ បញ្ហា ច្បាប់ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ថា ក្រោយពេល លោក កើត រិទ្ធ ឡើង កាន់ តំណែង ជា រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ គឺ បាន ពន្លឿន ការជាប់គាំង សំណុំរឿង នៅ តុលាការ ហើយ សំណុំរឿង ជាច្រើន ត្រូវបាន លើក មក ជំនុំជម្រះ ផងដែរ ។ បន្ថែម ពីលើ នោះ ក្រសួង យុត្តិធម៌ ក៏ បាន រៀបចំ យន្តការដោះស្រាយ ទំនាស់ ក្រៅ ប្រព័ន្ធ តុលាការ ដែល បាន រួមចំណែក ដោះស្រាយ បញ្ហា ជាច្រើន ។
លោក វិទិត មុន តាប៊ន ក៏ បាន កត់សម្គាល់ លើ សំណុំរឿង របស់ អ្នកនយោបាយ និង មន្ត្រី អង្គការ សង្គម ស៊ីវិល មួយចំនួន ផងដែរ ។ ក្នុង ចំណុច នេះ សម្តេច តេជោ បាន រំលឹក ថា មាន ប្រទេស និង អង្គការ មួយចំនួន ចង់ឱ្យ កម្ពុជា យក អធិបតេយ្យ ជាតិ ដោះដូរ ដែល កម្ពុជា មិន អាច ធ្វើ បាន នោះ ឡើយ ។ សម្តេច តេជោ បាន បន្ថែម ថា ដំណើរការ របស់ តុលការជា សិទ្ធិ របស់ តុលាការ ដែល រាជ រដ្ឋាភិបាល មិន អាច ទៅ លូក ដៃ ឬ បង្គាប់បញ្ជា បាន នោះ ឡើយ ។
មុននឹង បញ្ចប់ កិច្ចពិភាក្សា នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រាប់ លោក វិទិត មុន តាប៊ន ពិចារណា និង ពិនិត្យ ធ្វើ របាយការណ៍ ឱ្យ មាន តុល្យភាព មិន អាច ម្ខាង ថា រក្សា ការសម្ងាត់ ហើយ ម្ខាង ទាមទារ ឱ្យ មាន គណនេយ្យភាព នោះ ទេ ៕ បទ អត្ថាធិប្បាយ៖ ការបណ្តាក់ទុន នៅ ចិន គឺ បណ្តាក់ទុន ទៅ លើ ការអភិវឌ្ឍ នៅពេល អនាគត
( ប៉េកាំង ) ៖ ក្នុង សន្និសីទ សារព័ត៌មាន ស្តីពី ដំណើរការ សេដ្ឋកិច្ច ជាតិ ចិន ដែល បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៥ ខែសីហា អ្នកផង ជាច្រើន បាន កត់សម្គាល់ ឃើញ នូវ ពាក្យ មួយ មាត់ នេះ ថា « សេដ្ឋកិច្ច បន្ត បង្ហាញ ពី និន្នាការ ស្តារ ឡើងវិញ » ។ ការវិនិច្ឆ័យ នេះ បាន បន្ថែម ជំនឿចិត្ត របស់ មជ្ឈដ្ឋាន ខាងក្រៅ ចំពោះ សេដ្ឋកិច្ច ចិន ថែម មួយ កម្រិត ទៀត ។
អត្ថបទ វិទ្យុ មិត្តភាព កម្ពុជា ចិន តំណាងរាស្រ្ត មណ្ឌល ខេត្ត ត្បូងឃ្មុំ ផ្សព្វផ្សាយ នីតិវិធី នៃ ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ដល់ យុវជន មេភូមិ មេឃុំ មន្រ្តី សាលា ស្រុក នៅ មូលដ្ឋាន ស្រុក តំបែរ ចំនួន ២២៦ នាក់
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២២ លោក ចាយ បូរិន តំណាងរាស្រ្ត មណ្ឌល ខេត្ត ត្បូងឃ្មុំ និង ជា ប្រធាន គណៈកម្មការ ច្បាប់ បទបញ្ជា និង នីតិវិធី ខេត្ត បាន អញ្ជើញ ផ្សព្វផ្សាយ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ សម្រាប់ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា ដល់ មេភូមិ មេឃុំ និង មន្ត្រី សាលា ស្រុក ក្នុង មូលដ្ឋាន ស្រុក តំបែរ ចំនួន ២២៦ នាក់ ។
លោក ចាយ បូរិន បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច លោក លោកស្រី ដែល ជា ថ្នាក់ដឹកនាំ ស្ថាប័ន នីតិបញ្ញត្តិ នីតិប្រតិបត្តិ គ្រប់ លំដាប់ថ្នាក់ ជូន អង្គ ពិធី ទាំងមូល ។
លោក ប្រធាន គណៈកម្មការ ច្បាប់ បាន ចែករំលែក បទពិសោធន៍ ចំណេះដឹង និង ផ្សព្វផ្សាយ នូវ ឯកសារ ចាំបាច់ មួយ ចំនួន ដែល ពាក់ព័ន្ធ នឹង ការចុះឈ្មោះ ការពិនិត្យ បញ្ជី ឈ្មោះ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ជូន ដល់ សមាជិក សមាជិកា ចូលរួម ទាំងអស់ បាន យល់ដឹង អំពី ច្បាប់ និង បទបញ្ជា នីតិវិធី និង ស្រប តាម ប្រតិទិន គ.ជ. ប ដើម្បី មាន មូលដ្ឋាន យក ទៅ អនុវត្ត តាម ភារកិច្ច របស់ ខ្លួន ឱ្យ បាន កាន់តែ ប្រសើរឡើង ថែម ទៀត ។
លោក ប្រធាន គណៈកម្មការ ច្បាប់ បាន ផ្តាំផ្ញើ ដល់ មន្ត្រី សាលា ស្រុក - ឃុំ - មេភូមិ ត្រូវ យកចិត្តទុកដាក់ និង ជំរុញ ប្រជាពលរដ្ឋ ឱ្យ អញ្ជើញ ទៅ ពិនិត្យ ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ឱ្យ បាន គ្រប់ គ្នា ព្រោះថា បើ គ្មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ទេ មាន ន័យ ថា បងប្អូន មិន អាច ចូលរួម បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នៅ ឆ្នាំ ២០២៣ បាន ឡើយ ។
បន្ទាប់មក នៅ ព្រឹក ថ្ងៃ ដដែល នេះ លោក ចាយ បូរិន បាន ប្រគល់ ថវិកា ដែល ជា អំណោយ មនុស្សធម៌ របស់ សប្បុរសជន ខ្មែរ រស់នៅ រដ្ឋ មីនី សូតា សហរដ្ឋ អាមេរិក ជូន ដល់ លោក នាដ្ឋ រ៉ាវុធ ប្រធាន ក្រុមប្រឹក្សា ស្រុក សម្រាប់ ខូង អណ្តូង ទឹក ចំនួន ៧ ជូន បងប្អូន ប្រជាជន នៅក្នុង មូលដ្ឋាន ស្រុក តំបែរ ។ អ្នកតំណាងរាស្រ្ត ក៏ បាន អញ្ជើញ ពិនិត្យ ទីតាំង បុក អណ្តូង ទឹក នៅ ឃុំ តំបែរ - ឃុំ សេដា - ឃុំ ត្រពាំង ព្រីង - ឃុំ ចុង ជា ច ឃុំ គោក ស្រុក និង ឃុំ ទឹក ជ្រៅ ៕
