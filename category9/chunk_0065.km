ប្រសិនបើ ការមុជទឹក នឹង ធ្វើឱ្យ ភ្នែក ស្រវាំង ទិដ្ឋភាព នៅលើ ផែនដី នៃ កោះ នឹង មិន ធ្វើឱ្យ អ្នក ព្រងើយ កន្តើយ ឡើយ ហើយ អ្នក នឹង រកឃើញ ព្រៃឈើ ដ៏ ធំ សម្បើម នៃ ដើម ត្នោត និង សត្វ ជាច្រើន ប្រភេទ ដូចជា សត្វ ស្លាប សត្វ ល្មូន និង ស្វា ជាដើម ។
លីកកំពុងឈានដល់ការ ត្រៀមខ្លួន ។
យើងត្រូវស្តាប់អ៊ីសាយ ថូម៉ាស ពីរម៉ោង ?
អ្នក អាច ពាក់ របាំង មុខ ផ្សេង រៀងរាល់ ថ្ងៃ នៃ សប្តាហ៍ ដោយ មិន ចាំបាច់ លាង ។
« ខ្ញុំអាចធ្វើគ្រប់យ៉ាងដោយ សារព្រះ គ្រីស្ទ ដែលប្រទាន កម្លាំងដល់ខ្ញុំ » ( ភីលីព ៤: ១៣) ។
១៣ « ហើយក្នុងគ្រប់ ការណ៍ដែលខ្ញុំបាននិយាយទៅអ្នក រាល់គ្នា ចូរប្រយ័ត្ន ហើយកុំនិយាយអំពីព្រះនាមរបស់ព្រះឯទៀតឡើយ ហើយកុំឲ្យឮពីមាត់របស់អ្នកឡើយ ។
ដូចដែលគេនិយាយថា “ គ្មានអំពើល្អ ណាដែលគ្មានទោសនោះទេ ” ។
« លោកអើយ កុំនិយាយបែបនេះ វាជាចំនួនតិចតួចសម្រាប់សុភាពបុរស !
សមុទ្រ ពណ៌ ខៀវ គឺជា រឿង ស្រមើស្រមៃ ។
ខ្ញុំចង់រំលឹកអ្នកពីរឿងដែលព្រះយេស៊ូវបានមាន បន្ទូលអំពីអ្នកព្រោះគ្រាប់ពូជ ។
ឆ្នូត ពណ៌ ស នៅ វេទិកា
និយាយ ទៅកាន់ គាត់ ដើម្បី ព្រមាន គាត់ កុំ ឱ្យ ធ្វើ ខុស ។
សុខុមាលភាព ដូច អ្នក ដែរ ។
រាល់ ពេល ដែល ខ្ញុំ នៅ ម្នាក់ឯង និង មាន ពេលវេលា នៃ ជីវិត របស់ ខ្ញុំ ។
បុរសនោះដាក់ដៃប្រឆាំងនឹងអ័ព្ទពណ៌ ស សង្កត់វាដូចជញ្ជាំងកញ្ចក់ ។
23 កុំមានអ្វីពាក់ព័ន្ធនឹងការ ឈ្លោះប្រកែកគ្នាល្ងង់ ខ្លៅឡើយ ព្រោះអ្នកដឹងថាគេ ឈ្លោះប្រកែកគ្នា ។
ដែល បន្ទាប់មក អាច ត្រូវបាន រុំ ចូល ទៅក្នុង មុខងារ របស់ វា ផ្ទាល់ :
គាត់បានរកឃើញថាកំហុសរបស់នាងនៅត្រង់ ណា ហើយទ្រង់មាន បន្ទូលថា “ ទៅយកប្តីមកទីនេះ ” ។
ដូចជា នៅក្នុង ការរញ្ជួយ , ប៉ុន្តែ ក៏ មាន ផ្សេង ទៀត ។
ប៉ុន្តែសូមថយក្រោយមួយជំហានហើយមើលថាយើងទាំងអស់គ្នាជានរណាដែល រស់នៅទីនេះ ។
ប្រសិនបើ អាយុ ភាគ ច្រើន ។
សំណួរ ចំណេះដឹង ។
និង ការសន្យា ជាច្រើន ដែល ត្រូវបាន ទាយ ទុក ជាមុន
ក្លឹបអាចបញ្ជាក់ថា Heung-Min Son នឹងចាប់ផ្ដើមបំពេញកាតព្វកិច្ចយោធាក្នុងប្រទេសកូរ៉េខាងត្បូងក្នុងខែនេះ ។
ស្តាប់ ព័ត៌មាន រយៈពេល មួយ ម៉ោង ជារៀងរាល់ ថ្ងៃ
មនុស្ស នៅ ទីនេះ រាយការណ៍ ថា វា អាច ត្រូវបាន ដំឡើង ម្តង ទៀត ដោយ គ្មាន បញ្ហា ។
“ ខ្ញុំនឹងទទួលស្គាល់ថា ដំបូងឡើយ ខ្ញុំមិនជឿមួយម៉ាត់ទេ ។
ចំណាយ ពេល សម្រាប់ វត្ថុ វប្បធម៌ នៃ ជីវិត
ចុះបើគេទាក់ ទងគ្នា ?
ខ្ញុំនឹងធ្វើសង្រ្គាមដើម្បីយករដ្ឋាភិបាលយើងមកក្នុងកណ្តាប់ដៃយើងវិញ !
« មាន ពរហើយអ្នកបង្កើតសន្តិភាព ដ្បិតគេនឹងត្រូវហៅថាជាកូនរបស់ព្រះ» ។
អាថ៌កំបាំង ត្រូវបាន ពន្យល់ នៅ ចុងបញ្ចប់៖
ការអនុលោម តាម ច្បាប់ ក៏ នឹង ប្រសើរឡើង ផងដែរ ។
ខ្ញុំ សង្ឃឹមថាអ្នក រាល់គ្នានឹង យល់ » ។
ប៉ូលីស កំពុង ស្វែងរក អ្នក បាត់ខ្លួន ជាច្រើន ។
ខណៈពេល ដែល បាន រកឃើញ នៅក្នុង អំពើ បាប របស់ ខ្ញុំ ខ្ញុំ ត្រូវបាន បញ្ចូល ជាមួយនឹង សេចក្តីសុចរិត របស់ ទ្រង់ ។
អ្នកប្រើប្រាស់ ដែល មាន ស្រាប់ ដោយ ប្រើ ពាក្យបញ្ជា
៣ - បើមានអារម្មណ៍ចង់រាំអីក៏មកដែរ វាអាស្រ័យលើអ្នក
ស្នេហាគឺសំខាន់ណាស់ក្នុងការ បង្ហាញក្តីសុបិន ប៉ុន្តែចុះបើយើងមិនអាចចូលទៅបាន ?
ជីវិតរបស់អ្នកបែកបាក់គ្នា ហើយអ្នកមិនដឹងធ្វើ ដូចម្តេចដើម្បីកសាងឡើងវិញ ?
នឹង ត្រូវបាន សម្របសម្រួល ប្រសិនបើ អ្នក
កុំ អោយ នរណា ម្នាក់ បោកប្រាស់ អ្នក ។
ញ៉ាំ ផ្លែ ឈើ និង បន្លែ ឲ្យបាន ច្រើន ហើយ ព្យាយាម ជៀសវាង
ខ្ញុំអាចយល់ថាមិនឲ្យគាត់ ៧,៥ លានដុល្លារទេ ប៉ុន្តែ សង្ឃឹមថាយើងអាច លា លែងពីគាត់ ។
វាជាអំណោយដែលមិនត្រូវបានគេលើកឡើង !
បុគ្គលដែលសុខ ចិត្តស្លាប់ចំពោះអំពើ បាបដែលមនុស្សលោកមាន ហើយនឹងប្រព្រឹត្ត ...
" មកដល់ ហើយ ទាញ ចំណាប់អារម្មណ៍ ។
នរណា ម្នាក់ តែងតែ ឈ្លោះប្រកែកគ្នា ដើម្បី អង្គុយ នៅក្នុង ធុង ។
២៦ ហើយសិរីល្អ និងកិត្តិយសនៃប្រជាជាតិនានានឹងត្រូវនាំ មកក្នុងនោះ ។
នោះ ហើយ ជា មូលហេតុ ដែល ពួកគេ រិះគន់ ខ្ញុំ ។
អូដ្ឋ ជារបស់គាត់ដែលគាត់បានទិញ កាលពីបីឆ្នាំមុន ។
• យុទ្ធនាការ ទៅ អ៊ីស្លង់ ។
លើស ពីនេះ គាត់មិនអាចទម្លុះទឹកខ្ញុំបានទេ ។
វិធី នោះ ពួកគេ នឹង នៅតែ លះបង់ ចំពោះ អ្នក ។
យើងបាននិយាយអំពីរឿងនេះ ហើយអ្នកបានយល់ព្រម » ។
២ ថាខ្ញុំមានទុក្ខព្រួយ ជាខ្លាំង និងទុក្ខព្រួយជា និច្ចក្នុង ចិត្ត ។
ដាក់ វិធី មួយ ទៀត - ប្រសិនបើ អ្នក មិន មាន ហេតុផល ល្អ សម្រាប់ ការបង្រៀន មេរៀន ទេ ហេតុ អ្វី បានជា អ្នកបង្រៀន មេរៀន ?
ការ មើលឃើញអ្នកទាំងពីរដើរតាមគ្នាបានធ្វើឲ្យអ្នកធ្វើដំណើរហួស ចិត្ត » ។
អ្នក ត្រូវ ពិចារណា គាត់ បន្តិច ។
« មាន ពរហើយ អ្នកដែលស្លូតបូត អ្នកដែលមាន ចិត្តមេត្តា និងអស់អ្នកដែល ស្រេកឃ្លានសេចក្ដី សុចរិត » ។
20 ដោយ សារពួកគេមិននិយាយដោយសន្តិវិធី ប៉ុន្តែគេប្រើពាក្យបញ្ឆោតទាស់នឹងអ្នកដែលនៅស្ងៀមក្នុងស្រុក ។
ដោយហេតុនេះហើយទើបមនុស្សទូទៅយល់ឃើញនូវប្រាជ្ញា
វា ជាសមយុទ្ធដ៏ស្អាតមួយ ហើយអ្នកផ្សេងទៀតបានធ្វើវានៅទីនោះ វាជាការ ទាក់ទងការ ប្រណាំងធម្មតា ។
នាងបានរៀបការ បីដងហើយ ប៉ុន្តែឥឡូវនាងនៅ លីវ ។
នេះ ជា ផ្នែក នៃ ការឃ្លាត ឆ្ងាយ ពី សង្គម៖
ខ្ញុំមិនយល់ពីរបៀបដែលពួកគេអាចចូលខាងបានទេ » ។
ពេលខ្ញុំកាត់ សក់ ម៉ាក់ខ្ញុំក៏មិនបានកត់សម្គាល់ » ។
ភាពខុសគ្នា ប្រាំមួយ រវាង អង់គ្លេស និង អាមេរិក
21 កាលព្រះ‌ យេស៊ូមានព្រះ‌បន្ទូលដូច្នេះ ព្រះអង្គមានព្រះ‌ហឫទ័យព្រួយ បារម្ភ ។
