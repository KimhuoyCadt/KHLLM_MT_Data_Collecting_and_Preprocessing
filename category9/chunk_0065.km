តើអ្វីទៅជាអាហារដែលគេទទួល ទានច្រើនបំផុតក្នុងលោកសព្វថ្ងៃ ?
កុំ ជឿ អ្វី ដែល បង្ហោះ នៅលើ វេទិកា អ៊ីនធឺណិត !
បន្ទាត់ ទី មួយ គឺ បន្ទាត់ ពាក្យបញ្ជា ។
យើងប្រាប់អ្នកតាមការ ពិត គ្មានការ ស្រោបស្ករនៅ ទីនេះទេ ។
តែងតែ ត្រូវបាន បង្ហាញ ជាទសភាគ ។
គាត់ចេញទៅប្រាប់អ្នកក្រុងទាំងមូលអំពីអ្វីដែលលោកយេស៊ូបានធ្វើ ។
ព្រះអម្ចាស់ ជាព្រះ របស់យើង គង់នៅ ជាមួយយើង ។
ពួកគេបាននិយាយថា បុរសចំណាស់ម្នាក់នេះបានស្គាល់គាត់កាលពីពួកគេរស់ នៅខេត្តខុនខាន ហើយចង់នៅជាមួយគាត់នៅប្រាសាទ ។
អ្នក គួរតែ ប្រយ័ត្ន នៅ កន្លែង បែប នេះ ។
បើ ខ្ញុំ ចង់ រៀន
ម៉ិកស៊ិក ជា ទឹកដី កំណើត របស់ ខ្ញុំ ប៉ុន្តែ អាមេរិក ជា ផ្ទះ របស់ ខ្ញុំ ។
លោកស៊ីម៉ូនពេត្រុសសួរគាត់ ថា៖ « លោកម្ចាស់ តើលោកទៅ ណា ? » ។
ប៉ុន្តែប្រសិនបើនេះជាកូនប្រុស វានឹងមិនកើតឡើងវិញទេ ។
ដូច្នេះដល់ពេលដែលអ្នកត្រូវជួបឪពុកម្តាយមិត្តស្រីហើយ ។
អ្នក ស្តាប់របស់គាត់បានព្យាយាមទាយអត្ថន័យនៃរឿងនេះ ។
របៀប ធ្វើ ជ្រលក់ ឈីស ជាមួយ សាច់ ហាំ ប៊ឺហ្គឺ ។
ជា ការប្រសើរ ណាស់ , ខ្ញុំ ស្អប់ ផ្ទាំង គ្រប់គ្រង - រួម ជាមួយ មជ្ឈមណ្ឌល ជូនដំណឹង ។
ដឹងទេថាគេផលិតប៉ុន្មានឆ្នាំ ?
ជួយ ខ្លួនអ្នក ដោយ វិធី ពីរ យ៉ាង ។
ភាគ ច្រើន នៃ អ្នកទោស ដែល មិន ត្រូវបាន គេ បោះបង់ ចោល មាន
ដោយ អំណាច នៃ ព្រះនៅ ខាងស្តាំ របស់ គាត់ ។
ចូរទៅចុះ កុំធ្វើ បាបទៀតឡើយ » ។
ស្ត្រី តែងតែ រីករាយ ក្នុង ការឡើង លើ ។
ស្រលាញ់ គាត់ ចំពោះ អ្នក ស្គាល់ គ្នា
ត្រូវបានគេយកទៅឆ្ងាយប្រហែលបីឆ្នាំមុន ប៉ុន្តែគាត់មិនដឹងថានាងទៅ ណាទេ ។
ចំពោះអ្នក ណាដែលមិនព្រមគោរពតាមក្រឹត្យ វិន័យរបស់លោកម៉ូសេ នឹងត្រូវ ប្រហារជីវិតដោយគ្មានមេត្ដាចំពោះសាក្សីពីរឬបីនាក់ ។
ដែល មើលឃើញ ពន្លឺ ព្រះអាទិត្យ នៅ ចំណុច ណាមួយ ក្នុង មួយ ថ្ងៃ ។
« រំលងច្រើនតែមិនត្រូវរំលង !
យើង ប្រឆាំង នឹង បុរស ល្អ ។
ផ្ទាំង គំនូរ ចំនួន ៥ ត្រូវបាន បញ្ចប់ ។
យ៉ាងហោចណាស់ ក៏ នៅជិត ដូច គាត់ ដែរ ។
មាន គ្រាមួយ ទ្រង់មាន បន្ទូលទៅពួកសិស្សថា « តើខ្ញុំមិនបានរើសអ្នកទាំងដប់ ពីរនាក់ទេ ហើយម្នាក់ក្នុងចំណោមអ្នក រាល់គ្នាជាអារក្សឬ ? » ។
ដើម្បី ចាប់ ត្រី
លោកបានថ្លែងក្នុងសន្និសីទ សារព័ត៌មានក្នុងទីក្រុង រ៉ូមថា " អ្នក រាល់គ្នាដឹងថាការ ទាមទារទាំងនេះមាន ន័យថារំលោភលើអធិបតេយ្យភាពនៃរដ្ឋកាតា " ។
ទន់ សម្រាប់ រឿង នេះ ។
សាលាមិនធ្វើឲ្យអ្នកខក ចិត្តឡើយ » ។
មាន ការអធិស្ឋាន គ្រប់ ប្រភេទ ខ្លះ សម្រាប់ ការពារ ខ្លះ ទៀត សម្រាប់ ផ្តល់ និង ជាច្រើន សម្រាប់ ទិសដៅ ។
តើយើងចូលផ្ទះវិញដោយរបៀបណា ?
ខ្ញុំមិនបានសរសេរសំបុត្រនេះទេ ។
ពីរ ប្រភេទ ដែល លេចធ្លោ សម្រាប់ ខ្ញុំ
« ចូរចូលទៅតាមផ្លូវធំ និងផ្លូវនានា ហើយ បង្ខំគេឲ្យចូល » លូកា ១៤: ២៣
សួរខ្លួនអ្នកថា៖ « តើខ្ញុំចង់សប្បាយឬត្រូវ?
រាល់ ពេល ដែល ខ្ញុំ ស្រវឹង ខ្ញុំ ញ៉ាំ ច្រើន ពេក ។
វា នឹង មិន គ្រប់គ្រង សេរីភាព របស់ ហុងកុង ទេ ។
ដូច្នេះ ចូរយើងខិតខំ ប្រឹងប្រែងដើម្បីចូលទៅក្នុងកន្លែងសម្រាកនោះ ដើម្បីកុំឲ្យអ្នក ណាម្នាក់ដួលដោយការ ធ្វើតាមគំរូនៃការ មិនស្តាប់បង្គាប់ដូចគ្នា ។
« ដូច្នេះ ចូរ បន្ទាប ខ្លួន ចុះក្រោម ព្រះហស្ត ដ៏ មហិមា របស់ ព្រះ ដើម្បី ទ្រង់ អាច លើក អ្នក ឡើង បាន ទាន់ ពេល ។
៣២ ហើយយើងបានមកដល់ក្រុងយេរូសាឡិម ហើយយើងស្នាក់នៅ ទីនោះបីថ្ងៃ ។
អ្នក មានអារម្មណ៍ ថា មាន កំហុស ចំពោះ ភាពជោគជ័យ ណាមួយ ដែល អ្នក មាន មិន ថា តូច ប៉ុណ្ណា នោះ ទេ ដោយសារតែ មិត្តភក្តិ ក្រុមគ្រួសារ ឬ មិត្ត រួម ការងារ របស់ អ្នក ក៏ មិន ទទួលបាន ជោគជ័យ ដូចគ្នា ដែរ ។
ស្តង់ដារ ការ អនុវត្ត បរិស្ថាន និង សង្គម ) ។
ការរកឃើញ របស់ គាត់ ត្រូវបាន ផ្ទៀងផ្ទាត់ ដោយ មន្ទីរពិសោធន៍ ផ្សេង ទៀត ។
វា មិន គួរ ពិបាក ធ្វើ ព្យុះភ្លៀង ទេ ។
ចាក់សោ កូនស្រី !
« អ្នកដែលទទួល រង របួសគឺ ជាអ្នកសម គំនិតនឹងអ្នកប្រព្រឹត្តខុស » ។
នាងឆ្លើយ ថា៖ « ពិតមែនខ្ញុំជាស្ត្រីមេម៉ាយ ប្ដីខ្ញុំស្លាប់ហើយ ។
កុំធ្វើការ ប្រកាសធំគេមានទំនោរត្រូវបានគេមិនអើពើ ។
ពួកគេ ជាច្រើន នឹង ចេញ ពី ប្រធានបទ ។
ខ្ញុំ សន្យានឹងអ្នកថា យើងនឹងមិនធ្វើកំហុសនោះទៀតទេ » ។
នេះ ជា ច្បាប់ ដែល យើង កំពុង អនុវត្ត នៅក្នុង ផ្ទះ របស់ យើង ។
« ការ បង្រៀនរបស់ខ្ញុំមិនមែនជារបស់ខ្ញុំទេ ប៉ុន្តែ មកពីអ្នកដែលចាត់ខ្ញុំ មក ។
សូម ចងចាំ ថា សម្រាប់ ប្រភេទ នីមួយ ៗ នៃ សំឡេង យើង នឹង គ្របដណ្តប់ ជាក់ស្តែង
អ្នកអាចគិតថាបណ្ដាញងងឹតជាផ្នែក រងនៃបណ្ដាញជ្រៅ ។
ការឈឺចាប់រយៈពេលយូរគឺជារឿងចម្លែក ប៉ុន្តែអាចកើតឡើង។
មនុស្ស ម្នាក់ អាច ឆ្លង ជំងឺ ប៉េស្ត សូម្បីតែ សព្វ ថ្ងៃ នេះ ។
គាត់ ដើរលេង នៅ ទីនោះ ដើម្បី មើល ស្បែកជើង កវែង ថ្មី
នេះ ជា វីដេអូ របស់ ខ្ញុំ
ស្រេកឃ្លាន ស្លាប់ ដោយ មើល មិន ឃើញ ។
នៅ ចុងបញ្ចប់ គាត់ ដឹង ថា គាត់ ត្រូវការ យល់ ចិត្ត ប្រពន្ធ របស់ គាត់ ។
មុន ពិធី បុណ្យ ជ្រមុជ ទឹក យើង មិន មែន ជា កូន ចិញ្ចឹម របស់ ព្រះទេ ។
ខ្ញុំប្រាប់អ្នក រាល់គ្នាថា ទ្រង់នឹងប្រទានយុត្តិធម៌ដល់ពួកគេយ៉ាងឆាប់ រហ័ស ។
នៅ ស្ងៀម គាត់ នឹង ឆ្លៀត ឱកាស ចេញ ទៅ
ជំហាន ចុងក្រោយ បាន មកដល់ ហើយ រូបចម្លាក់ !
ពួកគេ ជឿ លើ ព្រះ។
៤ ពេលគាត់យករបស់គាត់ចេញអស់ហើយ គាត់ក៏ទៅមុខគេ ហើយចៀមក៏ដើរតាមគាត់ ព្រោះគេស្គាល់សំឡេងគាត់ » ។
គ្មាន ផ្ទះសម្បែង មុន ដំណាច់ ខែមីនា ។
ជនជាតិ ម៉ាយ៉ាន បាន គិត ថា ផ្លូវ នោះ ជា ផ្លូវ ទៅកាន់ ពិភព ក្រោម ដី ។
មិន ដឹងថាបាត់អ្វីទេមិត្ត !
ហើយ ការខកខាន អ្វី មួយ ដែល គួរឱ្យ ចាប់អារម្មណ៍ គឺជា រឿង បន្ទាប់ ដែល អាក្រក់ បំផុត ដែល អាច កើតឡើង ចំពោះ អ្នក ។
