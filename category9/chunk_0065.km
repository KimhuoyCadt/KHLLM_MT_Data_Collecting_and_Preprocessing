ខ្ញុំមិនដឹងថាហេតុអ្វីបានជាគេសម្រេច ចិត្តដាក់កម្រិតបែបនេះទេ ។
ដូចនេះ ហេតុ អ្វីបាន ជាអាមេរិកគួរជួយចិននៅ ពេល នេះ ?
អេសាយ 47:8 ឥឡូវនេះ អ្នក ស្រឡាញ់ការ សប្បាយអើយ ចូរស្ដាប់សេចក្ដី នេះ ដែលអង្គុយដោយសុវត្ថិភាព ដែលនិយាយក្នុង ចិត្តថា « ខ្ញុំហើយ គ្មាននរណាក្រៅពីខ្ញុំឡើយ ខ្ញុំនឹងមិនអង្គុយជាស្ត្រីមេម៉ាយ ឬស្គាល់ការ បាត់ បង់កូនឡើយ » ។ :
ពង្រីក វត្តមាន របស់ អ្នក នៅ គ្រប់ ទិសទី
តុលាការ នឹង យក គាត់ ។
អ្វី ៗ ទាំងអស់ នេះ ជាបន្ទុក សម្រាប់ ខ្ញុំ ។
« កូនមនុស្សអើយ ចូរគូសផ្លូវពីរដើម្បីឲ្យស្ដេចស្រុកបាប៊ីឡូន កាន់ដាវ ផ្លូវទាំងពីរនឹងកើតនៅក្នុងស្រុក តែមួយ ។
ក្រណាត់ របស់ ខ្ញុំ ម្តង ទៀត ហើយ អនុញ្ញាតឱ្យ ពួកគេ ឆ្លងកាត់ ខ្ញុំ ។
រដ្ឋាភិបាលកម្ពុជាបានរួចផុតពីអំពើឃាតកម្ម ។
ព្រះគ្រីស្ទ បាន យាង មក ដើម្បី នាំ សេចក្តីសង្ឃឹម ។
មាន ការផ្ទុះ នៅក្នុង ពិធី ជប់លៀង ។
វា ត្រូវតែ ស្លាប់ ព្រោះ វា ជា ឃាតករ ។
ពណ៌ ដូចគ្នា នឹង ពន្លឺ ។
« ដូច្នេះ គេក៏ទៅដោយប្រញាប់ប្រញាល់ឃើញម៉ារៀ និង យ៉ូសែប ហើយកូនដេកក្នុងស្នូក ។
យ៉ាង ណាក៏ដោយ ខ្ញុំចូល ចិត្តការ រៀបចំ៖ ៣
ដ្បិតយើងបានឃើញផ្កាយរបស់គាត់នៅទិសខាងកើត ហើយយើងបាន មកថ្វាយកិត្តិយសគាត់ » ។
ដូច្នេះ អ្វី ៗ នឹង កើនឡើង ។
ដូច្នេះ នេះ គឺជា ការភ័យខ្លាច ។
ហេតុនេះហើយបានជាបងប្អូនអើយ ខ្ញុំចង់ឲ្យអ្នកដឹងថា តាម រយៈព្រះ យេស៊ូវ ការ អត់ទោស បាបត្រូវបានប្រកាសដល់អ្នក រាល់គ្នា ។
ជូន លោកស្រី ស្មីត ។
« យើងខក ចិត្តចំពោះការ សម្រេចរបស់តុលាការថ្ងៃនេះ ប៉ុន្តែនេះមិនទាន់ចប់ទេ ។
ខ្ញុំចាត់ទុកថាការ រងទុក្ខបច្ចុប្បន្នរបស់យើងមិនសមនឹងការ ប្រៀបធៀបនឹងសិរីល្អដែលនឹងត្រូវបង្ហាញក្នុងខ្លួនយើងឡើយ ។
ខ្ញុំ ស្អប់ខ្ពើម ភាព គ្មាន ប្រសិទ្ធភាព និង កង្វះ ទំនាក់ទំនង ហើយ នោះ ជា អ្វី ដែល ទទួលបាន ចំពោះ ខ្ញុំ ។
រក្សា កែង ដៃ របស់ អ្នក ឱ្យ កោង បន្តិច ទៅ ខាងក្រៅ ។
ក្នុងឱកាសនោះ ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលមកខ្ញុំ ថា៖ ‹ គេនិយាយត្រូវហើយ ។
នាងប្រហែលជាបានបាត់ បង់ឪពុកម្តាយម្នាក់រួចទៅហើយ … កុំធ្វើឲ្យនាងបាត់ បង់អ្នកផង …» ។
ដូច្នេះ ចូររក្សាពាក្យនៃ កិច្ចព្រមព្រៀងនេះ ហើយធ្វើវា ដើម្បីឲ្យអ្នក រាល់គ្នាបានល្អក្នុងគ្រប់កិច្ចការដែលអ្នកធ្វើ ។
២ ធី ម៉ូថេ ២:៣ - ស៊ូទ្រាំនឹងការ លំបាក ជាមួយយើង ដូចជាទាហានដ៏ល្អម្នាក់របស់ព្រះ គ្រីស្ទយេស៊ូវ ។
ហើយបានទូទាត់សម្រាប់ តែការ កាត់ប្រាក់ប៉ុណ្ណោះ ។
ប៉ុន្តែបានបោះ បង់ចោលពួកគេទាំងអស់ ហើយបានសង្កេត ដើម្បីសរសេរ ខ គម្ពីរថ្មី ។
ខ្ញុំ កំពុង ស្វែងរក ទំនាក់ទំនង ឬ មិត្តភក្តិ ។
ជីវិត មាន កំណត់ ជ្រើសរើស មួយ
មិន មាន អ្វី នៅក្នុង ឈ្មោះ ទេ ប៉ុន្តែ ជារៀងរាល់
2 អ្នកត្រូវជាប់នៅក្នុងពាក្យដែលអ្នកបាននិយាយ ហើយជាប់អន្ទាក់ដោយពាក្យ សម្ដីរបស់អ្នក ។
ផ្ទុយទៅវិញ ពួកគេមានអារម្មណ៍ដូចជាត្រូវបានគេលក់ក្តី សង្ឃឹម ។
សាច់ញាតិ របស់ ភេរវករ ម្នាក់ ក្នុង ចំណោម ភេរវករ នៅ ទីក្រុង ប៉ារីស ត្រូវបាន ចាប់ខ្លួន ។
ព្រោះ វា ជា មធ្យោបាយ មួយ ក្នុង ចំណោម មធ្យោបាយ ជាច្រើន ដែល សមាជិក អាច មាន លក្ខណៈ គ្រប់គ្រាន់
ប៉ុន្តែអ្នកដែលជាជនជាតិអាមេរិកាំងម្នាក់មិនមានចម្ងល់អំពីអត្ថន័យនៃពាក្យនោះទេ ។
មុនការ បោះឆ្នោតកាលពី ២ ឆ្នាំមុន លោក ហ៊ុន សែន អាយុ៦៧ ឆ្នាំ បានថ្លែងថា ទោះបីជាមានការ ព្រួយបារម្ភពីសុខភាពក៏ដោយ លោកនឹងដឹកនាំប្រទេសកម្ពុជារយៈពេល ១០ ឆ្នាំទៀតរហូតដល់អាយុ៧៥ឆ្នាំ ។
សម្រាប់ គោលបំណង នៃ ការមើលឃើញ ។
ឥឡូវគាត់ រស់នៅសហរដ្ឋអាមេរិក » ។
មុខបរិសុទ្ធនៅ កណ្ដាលប្រជាជនយូដា ។
នេះមិនមែនជាឱកាសនោះទេ ហើយបន្ទាប់មកធ្វើថ្នាក់ដែលមានតម្លៃសមរម្យជាង !
ព្រោះបើយើងញ៉ាំក៏មិនមានដែរ ហើយបើមិនញ៉ាំក៏មិនតិចដែរ ។
ខ្ញុំ មិន ដឹង ថា ខ្ញុំ កំពុង ស្វែងរក អ្នកទេ ប៉ុន្តែ ខ្ញុំ បាន រកឃើញ អ្នក ។
ហេតុផល មួយ ដែល អ្នក ចង់ បង្កើន ល្បឿន គឺ ដោយសារតែ ពេលវេលា គឺជា លុយ ។
ដែល បាន ប្រកាស សម្រាប់ គាត់ ។
3 ដ្បិតបើអ្នក ណាគិតថាខ្លួន ជារបស់អ្វីពេលខ្លួនគ្មានអ្វីសោះ អ្នក នោះកំពុងបោកបញ្ឆោតគំនិតរបស់ខ្លួន ។
ទោះបីជាយ៉ាង ណាក៏ដោយ ខ្ញុំបានបាញ់ពីរបីគ្រាប់ដល់ពោះវៀន ។
តើអ្នកធ្វើការ ផ្លាស់ ប្តូ រដោយរបៀប ណានៅពេលដែលអ្នកបានសាកល្បងវាទាំងអស់ ?
ខ្ញុំមិនមានពេលទៅរកអ្វីផ្សេងទេ » ។
សូម្បីតែខ្ញុំក៏ជាអ្នកដែលលុបបំបាត់អំពើរំលងរបស់អ្នក រាល់គ្នាដោយយល់ដល់ខ្លួនខ្ញុំ ហើយខ្ញុំក៏មិននឹក ចាំពីអំពើ បាបរបស់អ្នកដែរ ។ — អេសាយ ៤៣: ២៥
លោកបាននិយាយថា គោលដៅធំគឺត្រូវមានកម្រិតធម្មតាត្រឹមថ្ងៃទី ៤ ខែ កក្កដា » ។
មិន ត្រឹមតែ ជា បញ្ហា នៃ ការចាប់អារម្មណ៍ ប៉ុណ្ណោះ ទេ
ហើយ បទគម្ពីរចែងថា៖ « អ្នក ណាដែលមានជំនឿ
មាន មនុស្ស ជាច្រើន ដូច គាត់ នៅ ជុំវិញ ប្រទេស អង់គ្លេស នៅ ឆ្នាំ នេះ ។
ចូល មក ដើម្បី ចូលរួម ជាមួយ យើង ។
ទោះជា ពេល នោះ ខ្ញុំ មិន បាន ឃើញ ព្រះក៏ដោយ ខ្ញុំ នៅតែ ប្រកាន់ខ្ជាប់ នូវ ជំនឿ ថា ព្រះជាម្ចាស់ គង់ នៅនឹង កន្លែង ណាមួយ ដែល ឃ្លាំមើល យើង ។
យូរទៀតហើយប្រហែលជាមិនមាន កប៉ាល់ត្រូវជួសជុលទេ ។
នៅ ពេល នោះ គាត់ គឺជា សមាជិក សភា សហរដ្ឋ អាមេរិក រួចទៅហើយ ។
មិន យូរ ប៉ុន្មាន ដើមឈើ បាន ស្តើង ហើយ ពួកវា នៅលើ វាល ទំនាប ដែល លាតសន្ធឹង ដល់ ជើង មេឃ ។
ពួកគេ នឹង ដួលរលំ ដើម្បី ទទួលបាន កម្លាំង ។
តើហ៊ុន ណាដែលឡើងថ្លៃ ?
« ព្រះអម្ចាស់ជាសេចក្ដី សុចរិតរបស់យើង » ។
( ៤) កុំ យក កាបូប លុយ ឬ កាបូប ឬ ស្បែកជើង ។ ហើយកុំឈប់ស្វាគមន៍អ្នក ណានៅតាមផ្លូវ ។
