ប៉ុន្តែ ទោះជា យ៉ាង នេះ ក្តី នាង មិន ស្វែងរក ការសងសឹក ឡើយ ។
គាត់បានបញ្ជាក់ពីអ្វីដែលខ្ញុំបានគិតពីដើម ។
យប់នេះឯងជក់បារី ឬផឹកអ្វី ?
« ហើយទ្រង់មាន បន្ទូលទៅគេថា « ខ្ញុំកំពុងមើលសាតាំងធ្លាក់ពីលើមេឃដូចផ្លេកបន្ទោរ » ។
ហើយលើសពីនេះទៀត និស្សិតដែល បញ្ចប់ការ សិក្សាសព្វថ្ងៃនេះ
សម្រាប់អ្នកមួយចំនួន នេះនឹងជាពេលដែលអ្នក សម្រេច ចិត្តដាក់ជំនឿរបស់អ្នកទៅលើព្រះយេស៊ូវ ។
អាវយឺត៖ កុំ ធ្វើ អី
ដោយមានទំនុក ចិត្តចំពោះការ នេះ ថាអ្នកដែលបានចាប់ផ្ដើមការ ល្អក្នុងអ្នក រាល់គ្នានឹងបន្តធ្វើរហូតដល់ថ្ងៃនៃព្រះគ្រិស្ដយេស៊ូ ។
ចម្លើយរបស់ អ័ ប្រាហាំគឺថា៖ « កូនអើយ ព្រះទ្រង់នឹងប្រទានកូនចៀមមួយសម្រាប់ជា តង្វាយដុតទាំងមូល » ។
រឿង ដ៏ សោក សៅ មួយ ទៀត នៃ ឧក្រិដ្ឋកម្ម ប្រឆាំង នឹង ស្ត្រី នៅក្នុង ប្រទេស ឥណ្ឌា ។
ទីបំផុត ពេលវេលា បាន មកដល់ ហើយ នាង បាន ចាកចេញ ។
លោកយេស៊ូមាន ប្រសាសន៍ថា៖ « ប្រសិនបើអ្នក រាល់គ្នាមិនបរិភោគសាច់កូនមនុស្ស ហើយពិសាឈាមរបស់លោកទេ នោះអ្នក រាល់គ្នានឹងមិនមានជីវិតឡើយ » ។
សត្វ ស្លាប ខ្លះ បាន ទទួល មេដាយ សម្រាប់ ភាពក្លាហាន របស់ ពួកគេ ។
យើង កំពុង ធ្វើការ នៅ សាលា ភាសា បរទេស ណាន ជីង ។
ប្រទាន ដល់ អស់ អ្នក ដែល សុំ ពួកគេ ។
ហើយខ្ញុំគិតថាវានឹងទៅឆ្ងាយដើម្បីពង្រឹងរឿងជាមួយគ្រួសាររបស់អ្នក » ។
រដ្ឋមន្ត្រីនិយាយថា លោកស្រី អ៊ុង សាន ស៊ូជី នឹងត្រូវដោះលែង
ថ្ម ជាច្រើន ដើម្បី ឡើង លើ ដើម្បី ចូល ទៅក្នុង ទឹក ។
ជាការ ល្អដែលត្រូវអរព្រះគុណដល់ព្រះ យេហូវ៉ា ហើយច្រៀងសរសើរដល់ព្រះនាមទ្រង់ ឱ ព្រះ ដ៏ខ្ពង់ ខ្ពស់បំផុត ។
អ្វី ដែល អ្នក បាន សន្យា ជាមួយ គាត់ ។
ដរាបណា មាន ការ សម្រាក ញឹកញាប់ ។
រសៀល ថ្ងៃ មួយ វេលា ម៉ោង ប្រហែល បី ទៀប ភ្លឺ គាត់ បាន និមិត្ត មួយ ឃើញ ទេវតា របស់ ព្រះជា ម្ចាស់ ចូលមក ហើយនិយាយ ទៅកាន់ គាត់ ថាៈ
កោះ កាណារី ត្រូវបាន គេ ដាក់ ឈ្មោះ តាម សត្វ ឆ្កែ មិន មែន សត្វ ស្លាប ទេ ។
យើងជារដ្ឋចម្រុះ កាន់ តែខ្លាំងឡើងជាមួយនឹងជាង 100 ភាសាដែលបាននិយាយ និងជាផ្ទះរបស់ជនជាតិដើមចំនួន 11។
តើវាមាន ន័យយ៉ាង ណាថា ព្រះជាព្រះ អម្ចាស់ជាព្រះ របស់ពួកគេ ?
នៅពេល ថ្ងៃ អ្នក អាច មើលឃើញ តាមរយៈ ពួកគេ ដោយសារ ពន្លឺ ភ្លើង ។
៣៖ ព្រោះអ្នក រាល់គ្នាដឹងថា ការ ល្បង លជំនឿរបស់អ្នកបង្កើតឲ្យមាន ភាព ខ្ជាប់ខ្ជួន ។
ទី មួយ មាន សំណួរ ថា តើ សត្វ ស្លាប កំពុង ត្រូវបាន នាំចេញ ឬ គួរ ត្រូវបាន នាំចេញ សម្រាប់ ការសម្លាប់ ។
ដ្បិត កាលដែលយើងនៅ តែទន់ខ្សោយ គឺនៅពេលត្រឹមត្រូវ ព្រះ គ្រីស្ទបាន សុគតជំនួសមនុស្សទុច្ចរិត ។
ខ្ញុំគិតថា ភាព លំបាកក្នុងការ ប្រកួតគឺល្អ ខ្ញុំមិនបានកម្រិត ទី ១៥ ក្នុងមួយម៉ោងទេ ។
យើង មិន បាន យក អ្វី មក ក្នុង លោកីយ នេះ ទេ ហើយ យើង មិន អាច យក អ្វី ចេញ ពី លោកីយ នេះ បាន ទេ ។ ប៉ុន្តែ បើយើងមានអាហារ និងសម្លៀក បំពាក់ នោះយើងនឹងស្កប់ ចិត្ត ។
ខ្ញុំ - ជោគវាសនា របស់ ខ្ញុំ កាន់តែ ច្បាស់ ហើយ កាន់តែ ច្បាស់ នៅក្នុង ផ្សែង នៃ ភ្លើង
អ្នកដែលរក្សាក្រុមនៅជាមួយគ្នា ទោះបីគាត់ប្រកែកជាមួយគេទាំងមូល ។
ព្រះជាម្ចាស់ អើយ តើ នោះ ពិតជា ការរើសអើង ជាតិ សាសន៍ នៅលើ ផ្នែក អត្ថាធិប្បាយ ប្លក់ មែន ទេ ?
" ដោយសារខ្ញុំបានប្រាប់អ្នកថាខ្ញុំបានឃើញអ្នកនៅក្រោមដើមឧទុម្ពរអ្នក ជឿ ? "
មនុស្ស បែប នោះ មិន បំរើ ព្រះអម្ចាស់ យេស៊ូគ្រិស្ដ របស់ យើង ទេ គឺ ចង់បាន តែ គេ ប៉ុណ្ណោះ ។ ហើយដោយពាក្យ ពេចន៍ដ៏គួរ សម និងពាក្យ ពេចន៍ បន្លឺឡើង ពួកគេបញ្ឆោត ចិត្តរបស់អ្នកដែលមានគំនិតសាមញ្ញ » ។
គាត់បាន បញ្ចប់ដោយប្រាប់ពួកគេថា « អ្នក ទាំងអស់គ្នាជាសាក្សីនៃប្រវត្តិសាស្ត្រដ៏រុងរឿង ។
សូមឲ្យអ្នកទាំងអស់ចាំក្នុង ចិត្តថា មានជំនួយ មកពីអ្នកដែលព្រះ បានជួយ ដើម្បីជា ពរ ជ័យ ដល់អ្នក ដទៃ នៅពេលដែលគ្មានអ្នក ណាលើក បន្ទុក ។
អ្នក ថ្វាយបង្គំ ព្រះ។
២ ពេលនោះ ខ្ញុំបានឃើញទេវតាទាំងប្រាំពីរអង្គ ដែលឈរនៅចំពោះព្រះ ហើយ ត្រែប្រាំពីរត្រូវបានប្រទានដល់ពួកគេ ។
អ្វី ក៏ដោយ ដែល អ្នក ចង់ ធ្វើ លំហាត់ របស់ អ្នក សម្រាប់ ថ្ងៃ !
ខាងក្រោមនេះជា វិធីដើម្បីពិនិត្យមើលពួក វា ។
ដូច្នេះ ខ្ញុំបានជ្រើសរើសគ្រោងតែកំណត់ត្រាបច្ចុប្បន្ន ( ចុងក្រោយ ) ក្នុងតារាង ។
ខ្ញុំស្រឡាញ់នាងហើយបន្តត្រឡប់មកវិញឱ្យបានច្រើនដើម្បីឱ្យខ្ញុំមានតិចនិងតិច។
ជា ការឆ្លើយតប ទៅនឹង ការប្រកួតប្រជែង 10 ឆ្នាំ ។
ភាគ ច្រើន ដូចជា ការទប់ស្កាត់ ការមក រដូវ ចំពោះ ស្ត្រី ។
នោះបានធ្វើឲ្យពួកគេពិបាកនឹងវិល មកវិញ ។
បន្ទាប់ពី ខ្មាន់ កាំភ្លើង ចូល ។
« ខ្ញុំគិតថាគាត់អាច នាំធនធាន មកស្រុក ។
ចូលកុំព្យូទ័រហើយគ្រាន់ តែបាញ់ សារមកខ្ញុំ !» ។
គាត់ បាន និយាយ ថា " យើង ដឹង ថា ការរឹតបន្តឹង ទាំងនេះ នឹង មិន ពេញនិយម ទេ ប៉ុន្តែ ពួកគេ នឹង សន្សំ សំចៃ ទឹក បាន ច្រើន ។
ខ្ញុំ ដឹង ថា ប្រសិនបើ គេ ចាប់ ខ្ញុំ ខ្ញុំ នឹង ត្រូវ គេ សម្លាប់
ព្យាយាម ស្វែងរក ជំនួយ ខ្ញុំ ?
រាល់ព្រឹត្តិ ការណ៍ត្រូវ តែចាប់យក ...
នាំ កូនប្រុស របស់ អ្នក មក ខ្ញុំ ។
នាងបាននិយាយថា ជន រងគ្រោះទាំង ៣ នាក់ជាស្ត្រី ប៉ុន្តែនាងមិនប្រាប់ពីអាយុរបស់ពួកគេឡើយ ។
អ្នកណា ស្រឡាញ់ ប្រពន្ធ គាត់ ស្រឡាញ់ ខ្លួន ឯង ។
តំណាង សហគមន៍ និយាយ ភាសា បារាំង នៃ ប្រទេស បែលហ្សិក ត្រូវបាន អនុម័ត
លេខ ចុះឈ្មោះ អាច ត្រូវបាន កំណត់
នោះជាស្ថានភាព សោកនាដកម្មមួយដែលអ្នកមានអ្នកយាមដែលពិការភ្នែក ។
