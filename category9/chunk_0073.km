“ ពួកគេ មិន មែន ជា ពលរដ្ឋ បង់ក្លាដែស ដែល មកពី មីយ៉ាន់ម៉ា ពួកគេ ជា ពលរដ្ឋ មីយ៉ាន់ម៉ា ។
សៀវភៅ ពិភពលោក បើក គ្រប់ ទំព័រ របស់ វា សម្រាប់ អ្នក ។
នៅក្នុង ការពេញចិត្ត នៃ សំលេង រំខាន ផ្សេង ៗ នៃ ប្រភេទ ឥឡូវនេះ
លោកថា និស្សិតដែលបានមកវិញគឺបានភ្ជាប់ពាក្យឡើងវិញ ។
ការហូរ ឈាម បាន ឈប់ ក្នុង រយៈពេល មួយ ថ្ងៃ ។
យើង សូម ថ្លែងអំណរគុណ ដល់ យោធា សហរដ្ឋ អាមេរិក ។
មិនទាន់ត្រូវបានភ្លើងឆេះនៅពីក្រោមពួកគេនៅឡើយទេ » ។
ការរក្សា អ្នក និង ក្រុមគ្រួសារ របស់ អ្នក ឱ្យ មាន សុវត្ថិភាព តាម អ៊ីនធឺណិត គឺជា អាទិភាព កំពូល ។
ឥឡូវអ្នកត្រូវគិតថា ខ្ញុំបានប្រាប់អ្នកថាមិនឱ្យប្រើទឹក។
នាង បាន យកចិត្តទុកដាក់ ចំពោះ ទាំងអស់ ។
នាង តក់ស្លុតបន្តិចចំពោះរឿងដែលបានកើតឡើង ហើយប្រាប់ខ្ញុំថា នាងមានមិត្តប្រុស ។
ជន ជាតិអ៊ីស្រា ‌ អែលបានធ្វើគ្រប់យ៉ាងចំពោះពួកគេ ដែលព្រះ‌ អម្ចាស់បង្គាប់លោកម៉ូសេ ទាក់ ទងនឹងពួកលេវី ។
អ្នក មាន និង អ្នកក្រ ចៅហ្វាយ នាយ និង ទាសករ របស់ ពួកគេ
ដោយ ហេតុផល ខ្លះ ខ្ញុំ ស្ទាក់ស្ទើរ ក្នុង ការសរសេរ អំពី ព័ត៌មាន លម្អិត នៅលើ ប្លក់ មួយ ។
ព្យាយាម ប្រាប់ រឿង នោះ ទៅកាន់ ប្តី ប្រពន្ធ កូន ៗ និង រដ្ឋបាល សាលា ។
១៥ ខ្ញុំលែងហៅអ្នក រាល់គ្នាថាជាបាវទៀតហើយ ដ្បិតអ្នក បម្រើមិនដឹងថាម្ចាស់កំពុងធ្វើអ្វីឡើយ ។ ប៉ុន្តែ ខ្ញុំបានហៅអ្នក រាល់គ្នាជាសម្លាញ់ ដ្បិតអ្វី ៗដែលខ្ញុំបានឮពីបិតាខ្ញុំ ខ្ញុំបានប្រាប់អ្នក រាល់គ្នាហើយ ។
៧ ដូច្នេះហើយបានជាខ្ញុំបង្គាប់អ្នក រាល់គ្នាឲ្យមើលថាក្រុងចំនួនបីត្រូវបានគេសម្គាល់សម្រាប់ការ នេះ ។
ដូច្នេះហើយ ពួកគេ ប្រឆាំង នឹង កិច្ចព្រមព្រៀង ណាមួយ ជាមួយ ប្រជាជន របស់ អ្នក ហើយ ពួកគេ ចង់ឱ្យ ពួកគេ ទាំងអស់ ចេញ ពី ពិភពលោក របស់ យើង » ។
ដូច្នេះ វា គឺជា ភាពតានតឹង ថេរ ។
គាត់បានផឹកវាដោយខ្លួនឯង ហើយកូនប្រុសរបស់គាត់ និងសត្វទាំងអស់ក៏បានផឹកវាដែរ » ។
គាត់គឺជាកន្លែងរបស់ខ្ញុំនៅលើគេហទំព័រ ។
ក្នុង ករណី នេះ វា ពិតជា ពិបាក ណាស់ នាង បាន ស្លាប់ ជិត ដប់ មួយ ឆ្នាំ មកហើយ ។
មាន ស្នែង ស្រាល ណាស់ ប្រវែង បី ហ្វីត ប្រាំពីរ អ៊ីញ ។
១៤ ពេលឪពុកក្មេករបស់លោកម៉ូសេ ឃើញការ ទាំងអស់ដែលគាត់ត្រូវធ្វើសម្រាប់ប្រជាជន គាត់មាន ប្រសាសន៍ ថា៖ « តើអ្នក ធ្វើបែប ណាចំពោះប្រជាជន ហេតុអ្វីបានជាអ្នកអង្គុយ តែម្នាក់ឯង ខណៈប្រជាជនទាំងមូលឈរនៅជុំវិញអ្នក ថ្ងៃ លិច រហូតដល់ ថ្ងៃ លិច ? "
ពួកគេធ្វើឱ្យយើងខិតខំ និងជោគជ័យ ប៉ុន្តែពួកគេមិនធ្វើឱ្យនរណាម្នាក់ឈឺចាប់ឡើយ ។
នៅ ពេល ដែល យើង ជឿ លើ ព្រះគ្រីស្ទ នោះ យើង ទទួលបាន ការអភ័យទោស ពី អំពើ បាប
បុរសម្នាក់ដែល នាំគាត់ចូល មកអង្គុយនៅជើងភ្នំ
ម្ចាស់ កូន សត្វ ដែល បាន ចុះឈ្មោះ ចំនួន ៨៩ ក្បាល ។
គ្រាប់បាល់មិនគួរឱ្យជឿជាច្រើនបានរួមតូច មកត្រឹមតែបួនគ្រាប់ប៉ុណ្ណោះ ។
នោះ ហើយ ជា មូលហេតុ ដែល មនុស្ស ចូលចិត្ត ឡាតាំង ។
ដរាបណា វា មាន ទិសដៅ ទោះជា ខ្លួន វា គឺ អាច រស់ នៅ បាន ក៏ដោយ តាម ឋានានុក្រម
កុំ បាញ់ នរណា ម្នាក់ ។
បន្ទាប់មក កុំ ធ្វើ តាម ការណែនាំ ខាងក្រោម ។
ជំនាញ អាវុធ ពីរ ដៃ ត្រូវបាន ដក ចេញ ពី ដើមឈើ ។
ដូច្នេះហើយបានជាព្រះ បានលើក ត ម្កើងគាត់ទៅកន្លែងដ៏ខ្ពស់បំផុត …» ។
ប្រសិនបើ ជំងឺ អេដស៍ / មេរោគ អេដស៍ ប៉ះពាល់ ដល់ យើង ម្នាក់ វា ប៉ះពាល់ ដល់ យើង ទាំងអស់ គ្នា ។
ព្រះ យេស៊ូវបាន បង់ថ្លៃសម្រាប់អំពើ បាបរបស់យើង ដែលយើងមិនអាចសងបាន ។
យើងបាននិយាយហើយគាត់បាននិយាយថាគាត់ចង់នៅក្នុងវីដេអូមួយ។
ក្នុង ដែន កំណត់ នៃ ក្របខ័ណ្ឌ បទប្បញ្ញត្តិ គ្រប់គ្រាន់ ។
មក អ្នកកំពុង តែធ្វើឲ្យអ្នកញ៉ាំអាហារដែលនៅ សល់យើងមើលទៅអាក្រក់ !
ខ្ញុំ បាន ដើរ នៅ ចំពោះមុខ អ្នក តាំងពី ក្មេង រហូតដល់ ថ្ងៃ នេះ ។
អ្នក រាល់គ្នានឹងត្រូវគេស្អប់ ដោយព្រោះខ្ញុំ ។
“ តាមពិតខ្ញុំគិតថាមិនមានរឿងស្នេហាទេ ។
យ៉ាងហោចណាស់ នាង នឹង មិន ចាក់ ទឹក ម្តង ទៀត ទេ ។
តែកុំតែស្តាប់ខ្ញុំ !
ដោយ សារ តែសព្វថ្ងៃនេះច្រើនជាងមនុស្ស ។
ខ្ញុំបានទទួល ប្រយោជន៍ផ្ទាល់ខ្លួនច្រើនពី ISUOG» ។
សាខា នៅ បូស្តុន ។
“ និយាយរឿងតាមកែវភ្នែកក្មេងស្រី ខ្ញុំគិតថាវាមានឥទ្ធិពលខ្លាំងណាស់ ។
ការចុះឈ្មោះ ដើម ទំពាំងបាយជូរ នឹង យក ពី ទីនោះ ។
ពេលនេះ ម៉ាស៊ីន មេ រួចរាល់ ហើយ ។
ដោយ កត់សម្គាល់ ថា តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក ខាងកើត កំពុង ដំណើរការ នគរូបនីយកម្ម លឿន បំផុត នៅលើ ពិភពលោក ( ហើយ ដូច្នេះ ក្នុង ប្រវត្តិសាស្ត្រ ) របាយការណ៍ នេះ និយាយ ថា អត្រា 3 ភាគរយ នៃ នគរូបនីយកម្ម នា ពេល បច្ចុប្បន្ន កំពុង បង្កើត បញ្ហា ដែល ត្រូវការ ដំណោះស្រាយ ជាបន្ទាន់ ។
ពួកគេ មិន មែន សូម្បីតែ ដំណាក់កាល អាល់ហ្វា នៃ ការអភិវឌ្ឍន៍ ហើយ មនុស្ស គិត ថា វា ត្រូវបាន បញ្ចប់ ។
រវាង ទារុណកម្ម និង កំពែង ក្រុង
អេវ៉ាបានឃើញថាដើមឈើនេះគឺជាការ ចង់ធ្វើឲ្យមនុស្សមានប្រាជ្ញា
