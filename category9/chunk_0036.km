ប្រជាជន ពិភពលោក ជាង ៨២០ លាន នាក់ កំពុង ជួបប្រទះ ការអត់ឃ្លាន
ពី អ្នកជំនាញ ផ្នែក សារព័ត៌មាន មកពី ជុំវិញ ពិភពលោក
ឌីវីឌីវ៉េសែត គួរឱ្យ ចាប់អារម្មណ៍ ។
ប៉ុន្តែ លោក ថា រដ្ឋាភិបាល គួរតែ មិន ឱ្យ មាន ការផ្សាយ គ្រឿងស្រវឹង តែម្តង ។
តើ ធ្វើ យ៉ាងណា ឱ្យ ការរកស៊ី អ្នក ល្អ ជាង អ្នកដទៃ ?
ដ្បិត យើង ធ្វើអោយ មាន ទឹក
ព្រឹក នោះ យើង ធ្វើ រួច ផ្នែក ខាងមុខ ។
១៣ហេតុ នេះ ហើយ បានជា យើង ត្រូវតែ ឈប់ ថ្កោល ទោស គ្នា ទៅ វិញ ទៅ មក តែ ត្រូវ ប្តេជ្ញាចិត្ត ថា មិន ត្រូវ ធ្វើ អ្វី ដែល នាំអោយ បងប្អូន ជំពប់ ដួល ឬ រវាត ចិត្ត បាត់ ជំនឿ នោះ ឡើយ ។
សន្និសីទ មាន អ្វី ប្លែក ទៅ គ្រូពេទ្យ ?
ពួកគេ មិន អាច វាយតម្លៃ ទំហំ និង កម្លាំង នៃ បាតុកម្ម ប្រឆាំង ទាំងនេះ បាន ទេ ។
បញ្ញា ក៏ អោយ ជា តាម ក បន្ទប់ របស់ ខ្លួន ដើម្បី បញ្ចប់ ការដុត គ្នា ទៅវិញ ទៅមក ។
្វែង រក ដំណោះស្រាយ ។
ព្រះអង្គម្ចាស់ តូច បាន ជួប នឹង ព្រះនាង ម្នាក់ ។
ប៉ុន្តែ ចាប់តាំងពី ក្រោយ ឆ្នាំ ១៩៩៣មក ផ្លូវ ជាតិ សំខាន់ ៗ
មនុស្ស នៅក្នុង សហគមន៍ អន្តរជាតិ គឺ មិន បាន មើលឃើញ ត្រង់ ចំណុច នេះ នោះ ទេ ។
ដំណើរការ បាន ត្រឹមត្រូវ ។
អាមេរិក ថា អាមេរិក ទើបតែ បាន ចំណាយ ប្រាក់ ថ្មី ៗ
លោក កឹម សុខា កំពុង ធ្វើ ទស្សនកិច្ច នៅ ក្រៅ ប្រទេស ។
ប្រសិនបើ នរណា ម្នាក់ មក សម្ភាសន៍ យឺតយ៉ាវ ឱកាស ក្នុង ការទទួល ការងារ គឺ ស្តួចស្តើង ណាស់ ។
បើសិនជា ចម្លើយ សុទ្ធតែ មែន នោះ មាន ន័យ ថា អ្នក កំពុងតែ មាន បញ្ហា កង្វះ ជាតិ ស័ង្កសី ក្នុង ខ្លួន ហើយ ។
តែ ប៉ុណ្ណោះ ក្នុង ពេល មាន គភ៌ នេះ ។
និង ស្រស់ស្អាត សម្រាប់ លោក លេង កម្សាន្ត ជាមួយ គ្រួសារ ៕
ស្វាមី អ្នកនាង សួស វីហ្សា
ពេលវេលា ភ្លេច ពេលវេលា ល្អ បំផុត ដើម្បី ផ្ញើ សមហេតុសមផល ។
ទាំងអស់ ដែល ញែក ជា សក្ការៈ ថ្វាយ ដល់ ព្រះអម្ចាស់ ជា ព្រះរបស់ ខ្លួន មក ថ្វាយ ជាតង្វាយ មួយ ភាគ ដប់ ដែរ ។
ដោយសារតែ ពួកគេ គឺជា មូលដ្ឋាន ដ៏ សំខាន់ ដែល យើង អាច អភិវឌ្ឍន៍ និង ស្រាវជ្រាវ លក្ខណៈ ពិសេស ថ្មី នេះ ជានិច្ច ។
បើ ភិក្ខុ នោះ ត្រេកអរ នឹង អង្គ ជាត ដែល កំពុង ចូលទៅ ក្តី ត្រេកអរ នឹង អង្គ ជាត ដែល ចូល ស៊ប់ ទៅ ហើយ ក្តីត្រេកអរ នឹង អង្គ ជាត ដែល កំពុង ស្ថិត នៅក្នុង ទ្វារ មគ្គ នោះ ក្តី ត្រេកអរ នឹង អង្គ ជាត ដែល បន្ថយ ចេញ ក្តី ត្រូវ អាបត្តិ បារាជិក ។
ដែល អាច កើតមាន ជា យថាហេតុ ។
ជាមួយគ្នា ក្រុមហ៊ុន ក៏ បាន បង់ប្រាក់ ពិន័យ ចូល ថវិកា ជាតិ គ្រប់ ចំនួន ហើយ ដែរ ។
បញ្ញា សិប្បនិម្មិត VS មនុស្ស
ក៏ មាន ចំណែក សំខាន់ ក្នុង ភាពជោគជ័យ នេះ ដែរ ។
នេះ ពួកគេ ទើបតែ បាន បញ្ចប់ ការប្រគំ តន្ត្រី របស់ ពួកគេ នៅ សហរដ្ឋ អាមេរិក ។
មនុស្ស ទី មួយ ដែល ត្រូវ ទទួលខុសត្រូវ គឺ ខ្ញុំ ។
អ្នក អាចនឹង មាន ជំងឺ មហារីក លិង្គ បើសិនជា អ្នក រោគសញ្ញា មូួយ …
៣៣ ជនជាតិ អ៊ីស្រាអែល នាំគ្នា ចាកចេញ ពី ភ្នំ របស់ ព្រះអម្ចាស់ ធ្វើដំណើរ អស់ រយៈពេល បី ថ្ងៃ ។
លោក ក៏ យក ទ្រព្យសម្បត្តិ ទាំង ប៉ុន្មាន ដែល ពួក លោក រក បាន ព្រមទាំង អ្នក បំរើ ដែល ពួក លោក ទិញ បាន នៅ ស្រុក ហារ៉ាន ទៅ ជាមួយ ដែរ ។
លោក ហ៊ន់ សុរចនា និង ភរិយា ៥លាន រៀល
ហើយ ចៅហ្វាយ ក៏ ចេះតែ ទទួល ឥត បង្អង់ ដៃ ទាល់តែ អាសុរា វា ចូលទៅ កូរ រីក ថ្លើម ប្រមាត់ ធ្វើឱ្យ ក្រងក់ក ដួល ក្រោក លែង រួច តែម្តង ។
លោក សម រង្ស៊ី កំពុង ធ្វើ កិច្ចការ នេះ ។
ចប់ រឿង ទណ្ឌកម្ម ។
នៅ តាម ទីតាំង ប្រាសាទ នីមួយ ៗ
ត្រឹមត្រូវ ខ្ញុំ ចូលចិត្ត ឃ្លា នេះ ។
លោក បាន បន្ថែម ថា វា មិន មាន បញ្ហា ទេ ប្រសិនបើ មន្ត្រី របស់ លោក មានអាវុធ ។
ឃុំ បុស្បូវ នេះ មាន ១៧ភូមិ១ ។
គ្រាន់តែ គេ ដណ្តើម ទូរស័ព្ទ សោះ គិត ខ្លី បែប នេះ !
នាង មាន សាច់ដុំ ធំ ៗ
ហេតុការណ៍ នេះ កើតឡើង ស្រប នឹង សេចក្តី ដែល មាន ចែង ទុក តាមរយៈ ព្យាការី យេរេ មាថា ៖
ពត៌មាន ប្រចាំ ថ្ងៃ កូន នឹង ក្លាយជា បែប ណា ក្រោយពេល ឳពុក ម្តាយ បែក គ្នា ?
គ្រប់ ទិសាអោយ សួគ៌ ការីករាយ ចិត្ត !
ដោយ លោក បញ្ជាក់ ថា លោក បាន លើក ពី ករណី ចាប់ខ្លួន មនុស្ស រើ ឡើងវិញ កាលពី ពេល ថ្មី ៗ
នៅក្នុង វប៌្ប ធម ភាគ ខាងកើត ដូចជា ប្រទេស ចិន ពណ៌ ក្រហម គឺជា និមិត្តរូប នៃ សំណាង ល្អ ។
នៅ ថ្ងៃទី ១២តុលា ខាងមុខ នេះ រដ្ឋសភា នឹង បើ សម័យ ប្រជុំ រដ្ឋសភា លើក ទី ៩នីតិកាល ទី៥
ឬ មាន អ្វី មួយ ទល់ ចេញមក ក្រៅ នៅក្នុង ឆ្អឹង អាង ត្រគាក
ដើម្បីឱ្យ កាន់តែ ច្បាស់ សូម លោក អ្នក ងាក មក មើល លក្ខណៈ ពិសេស ៗ
មនុស្ស កើត មក មាន វាសនា ខុសគ្នា ។
លោក បញ្ជាក់ ថា ករណី ល្មើស ឈើ លើក នេះ គឺជា របស់ លោក កែ សុវណ្ណារី យ៉ាង ពិតប្រាកដ ។
បដិសារណី យសូត្រ ទី ៩
ព្រះអម្ចាស់ ប្រទាន ឱ្យ យើង ម្នាក់ ៗ
ជួយ ថែរក្សា បរិស្ថាន ទៀតផង ពិតជា ប្រជាពលរដ្ឋ ល្អ មែន សូម គាំទ្រ ។
បែរជា ធ្វើ រឿង ទាំងនេះ មាន ន័យ ថា គាត់ បញ្ជាក់ ច្បាស់ ហើយ
ភរិយា លោក ជា សំណាង ស្ងាត់ ៗ
ចាំ មើល ខ្ញុំ នឹង ឆ្លើយតប នៅ ពេល ក្រោយ ។
មើលឃើញ នៅ ចំពោះ មុខ របស់ គេ បែប នេះ ព្រមទាំង ជឿ ថា
សុគន្ធ កញ្ញា លែង មាន ចំណែក ស្នាដៃ របស់ រ៉េត ធី ដូណា ទៀត ហើយ ។
សហរដ្ឋ អាមេរិក និង ប្រទេស អង់គ្លេស មិន បាន សន្យា ថា …
ហើយ មនុស្ស ម្នាក់ ដែល ពាក់ ឈុត តុក្កតា នោះ ធ្វើ បែប នេះ ក្នុង គោលបំណង អ្វី សូម ទស្សនា ទាំងអស់ គ្នា ៖
បន្តែ សើច ច្រើន ជាង ព្រោះថា ជា រឿង កំប្លែង ទេ តើ ។
បន្ទាប់មក ជនសង្ស័យ បាន កាប់ អំពូលភ្លើង បែក អស់ ចំនួន ១ ។
ពិតជា មិន យល់ ទាល់តែសោះ ដែល ខ្លួន ប្រកាស ថា ៖
ចាប់ពី ពេល ដែល ខ្ញុំ បាត់ ដំណឹង អ្នក ទាំងអស់ ខ្ញុំ គិត ថា គាត់ ស្លាប់ អស់ ហើយ ។
គ្រាន់តែ ចង់បាន ទេ ?
ទៀត តាម ដែល យើង ត្រូវការ ។
បន្ទាប់ពី ខ្យល់ មាន រញ្ជួយ ដី ប៉ុន្តែ ព្រះអម្ចាស់ មិន គង់ នៅក្នុង ដី ដែល រញ្ជួយ នោះ ទេ ។
ហេតុ នេះ ហើយ បានជា នៅ ថ្ងៃ ដែល ព្រះជា ម្ចាស់ វិនិច្ឆ័យ ទោស មនុស្សលោក អ្នកក្រុង ទីរ៉ូស និង អ្នកក្រុង ស៊ីដូន ទទួល ទោស ស្រាល ជាង អ្នក រាល់គ្នា ។
លោក បារ៉ាក់ អូបាម៉ាយល់ព្រម អោយ ពួក អ្នកស្រឡាញ់ ភេទ ដូចគ្នា រៀបការ
នោះ ជា ជន ស៊ីវិល ម្នាក់ ដែល គ្មាន ពាក់ព័ន្ធ អ្វី ជាមួយ ក្រុម ភេរវជន ឡើយ ។
ខ្ញុំ គិត ថា រឿង នេះ ជា ការធ្វើឱ្យ ប្រទេស បែកបាក់ គ្នា ។
បទពិសោធន៍ បាន មកពី មកពី ការសង្កេត ។
ខួប ១៦ ឆ្នាំ រំលឹក ការកាប់ សម្លាប់ …
មុហុត្តិកាច ក្កចប់ ។
អស់ អ្នក ដែល ត្រូវ គេ សង្កត់ សង្កិន ។
យើង អាច កំពុងតែ ហត់ ចិត្ត ដែល ទទួលបន្ទុក ដាស់ ជីវិត ខ្លួន ឯង និង ទាមទារ អ្វី ដែល យើង ចង់បាន ចូលមក ក្នុង ជីវិត ។
ខ្ញុំ ក្រោក ឡើង ហើយ ស្រី ៗ
យើងខ្ញុំ ឈប់ និយាយ អំពី ហេតុការណ៍ ដែល យើងខ្ញុំ បាន ឃើញ បាន ឮ នោះ ពុំ កើត ទេ ។
ក្នុង អតីតកាល ព្រះបរម ពោធិ សត្វ ធ្លាប់ កើត ជា សេដ្ឋី អ្នក មាន ទ្រព្យ ច្រើន ព្រះអង្គ តែង ធ្វើ បុណ្យ សុន្ទរ៍ ទាន ជារឿយ ៗ
អ្នក ទាំងអស់ គ្នា ប្រហែលជា ឆ្ងល់ ហើយ ថា តើ ជំងឺ នេះ មាន ឥទ្ធ ពល យ៉ាងដូចម្តេច ?
ពពួក ផ្សិត ទាំងនេះ ត្រូវបាន គេ ប្រើ រាប់ ពាន់ ឆ្នាំ មកហើយ នៅក្នុង វប៌្ប ធម មួយ ចំនួន សំរាប់ ផលប្រយោជន៌ សុខភាព ។
របស់ អស់ លោក លោកស្រី ជាមួយ គ្រឹះស្ថាន របស់ យើងខ្ញុំ ។
តុលាការ កំពូល សហរដ្ឋ អាមេរិក មាន ចៅក្រម ទាំងអស់ ចំនួន ៩រូប ។
ចំណែក វិនីត នាង នៅ ជាមួយនឹង អ្នកស្រី ណា សា ព្រមទាំង ជួយ ធ្វើ ម្ហូប ទៀតផង ។
ក្រោយពី បាន បំផ្លិចបំផ្លាញ លទ្ធិ ប្រជាធិបតេយ្យ បាន ទេ ។
ស្លាក ស្វយ័ត តូតា
ពួកយើង បាន ផ្តល់ ព័ត៌មាន ដល់ សមាជិក ព្រឹទ្ធសភា ទាំងនោះ ហើយ អង្គការ ផ្សេង ទៀត ក៏ បាន ធ្វើ ដូច្នោះ ដែរ ។
សុំ ស្រលាញ់ មិន តិច ទេ ប៉ុន្តែ នាង តែង បដិសេធ ជានិច្ច ។
លោក ថា នេះ គ្រាន់តែ ជា ការធ្វើ ការវិនិច្ឆ័យ មុន របស់ លោក រង្ស៊ី មុន ការបោះឆ្នោត មកដល់ ។
ប្រមុខ រាជ រដ្ឋាភិបាល មាន ប្រសាសន៍ ពី បញ្ហា អ្វី ខ្លះ ?
ទំនាក់ទំនង ស្នេហា របស់ គ្រីស្ទ បរិស័ទ គួរតែ ជា យាន មួយ ដែល នាំឱ្យ ពួកគាត់ កាន់តែ ចង់ ថ្វាយបង្គំ ព្រះជាម្ចាស់ ព្រោះ ការថ្វាយបង្គំ ព្រះអង្គ គឺជា ចំណុច ស្នូល នៃ ជីវិត រស់ នៅ របស់ គ្រីស្ទ បរិស័ទ ។
ស្រវឹង ងោក បើក រថយន្ត បុក ម៉ូតូ កង់ បី ឈប់ ស្ងៀម ស្លាប់ បុរស ម្នាក់
មហោស៌្រព វប្បធម អន្តរជាតិ លើក ទី១ បាន បង្ហាញ នៅក្នុង …
តែ អ្វី ដែល គួឱ្យ ខកចិត្ត បំផុត នោះ គឺ រឿង ថ្ម តែម្តង ។
បើ លោកអ្នក ខ្លះ គិត ស្មាន ថា អ្នកតំណាងរាស្ត្រ ជាង ៥០ នាក់ តើ មាន ស្អី ច្រាស នោះ ម៉េច ក៏ មិន
សប្បាយរីករាយ នឹង ការងារ របស់ អ្នក ជា រឿង សំខាន់ ណាស់ ។
រំលឹក ឡើងវិញ នូវ រាល់ ការចងចាំ ចំពោះ សព លោក ប៉ែន សមិទ្ធិ ក្នុង ឱកាស ខួប គម្រប់១ ឆ្នាំ នៃ មរណភាព របស់ លោក
ដ្រាយ ថា សរឹង នេះ នឹង អាច ចាប់ផ្តើម ក្លូន ។
អស់ លោក អាច សម្លឹង មើល ទៅ ប្រទេស អ៊ីរ៉ាក់ ស៊ីរី និង អាហ្វហ្គានីស្ថាន ជាដើម ។
យ៉ាង ដាច់ខាត និង ម៉ត់ចត់ ។
ក្រុម មន្ត្រី បាន ព្រមាន អំពី ស្ថានភាព អាកាសធាតុ អាក្រក់ ជាង នេះ ថែម ទៀត នេះ ដែល បង្កឡើង ដោយ ការប្រែប្រួល អាកាសធាតុ ។
នោះ ទេ ទាល់តែ យើង ស្នើសុំ ។
ពេល ឮ ខ្ញុំ និយាយ ដូច្នេះ អ្នក រាល់គ្នា ព្រួយ ចិត្ត ខ្លាំង ណាស់ ។
ខ្ញុំ នឹង វិល ទៅកាន់ សង្គម និយម វិញ នៅ ថ្ងៃស្អែក បើសិនជា អាច ទៅ រួច ។
លោក ម៉ែន ណាត បាន សរសេរ នៅលើ ទំព័រ ហ្វេសប៊ុក របស់ លោក ពី លក្ខខណ្ឌ ទាំង បី នោះ ក្នុង ការដកស្រង់ ទាំងស្រុង ដូច ខាងក្រោម ៖
មាត់ ថា នាង កំពុងតែ មាន គម្រោង បើក
ទី៣ គឺ បណ្តុះ សេចក្តីដឹងគុណ ។
ប្រសិន លោក អ្នក ត្រូវការសម្រាន្ត ក្នុង មួយ យប់ ៗ
ហេតុ អ្វី វិស័យ ទេសចរណ៍ អាស៊ី អាគ្នេយ៍ …
ចិត្ត កញ្ជនា ចង់ ស្រក ជាង ១០គីឡូ ទៀត
ត្រូវ សួរ តើ នាង ចង់ឱ្យ អ្នក ធ្វើ អ្វី ។
អញ្ចឹង ទេ អា នេះ ជា ការទិញ សន្លឹក ឆ្នោត ប្រដាក់ ។
ទេវតា ឆ្នាំ ថ្មី ស្រុក ស្រែ
ជាញឹកញាប់ យើង សុទ្ធតែ ធ្លាប់ មាន ពិសោធន៍ នៃ បញ្ហា ធ្វើអោយ ខឹង ទាំងនេះ នៅក្នុង ជីវិត ប្រចាំ ថ្ងៃ ។
តែ ទោះជា យ៉ាងណា ក៏ ទណ្ឌិត ដែល ធ្លាប់ មាន ឥទ្ធិពល រូប នេះ អាច ចេញ ពី ក្នុង បន្ទប់ ឃុំឃាំង បាន ច្រើន ជាង គេ ដែរ ៖
ជា ចុងក្រោយ លោក បាន ថ្លែង ថា ៖
ស្គត់ បាន បង្ហាញ ការជោគជ័យ ។
អ្នកស្រុក សុរិន្ទ្រ គ្មាន អ្វី ខុសប្លែក ពី អ្នកស្រុក ស្រែ នៅ កម្ពុជា យើង ទេ ។
ម្សៅ ស្រូវ សាលី ទាំងមូល ?
ត្រូវបាន អនុញ្ញាតឱ្យ ជ្រើសយក ផលិតផល ពីរ អាវ មួយ និង ខោ ឬ សំពត់ មួយ ។
ពត៌មាន ប្រចាំ ថ្ងៃ ទារក លូតលាស់ យឺត អាច ដោយសារតែ ហេតុផល ទាំងនេះ
ចំពោះ ការឈឺចាប់ នេះ គឺ នៅ ពេល ដែល អ្នកស្រី ធ្វើការ ធ្ងន់ ៗ
ប្រយ័ត្ន ឱ្យ មែនទែន បងប្អូន កូវីដ១៩ មកដល់ ទួល សង្កែ ហើយ !
ដាក់ ស្តុក ពេញ ឃ្លាំង គ្មាន ភាំង ប្រាជ្ញា បើ អ្នក ត្រូវការ
ខ្ញុំ និង គាត់ តែង ជួបគ្នា ជាញឹកញាប់ ។
