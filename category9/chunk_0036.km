ជុំវិញ ការចាប់ខ្លួន ថៃ ៧នាក់ កម្ពុជា ដោះស្រាយ …
លុះ ធ្វើ រួច វា ធ្លាក់ ឈាម ខ្លាំង ណាស់ ។
គ្នា ក្នុង រយៈពេល ខ្លី សោះ នាង អាច រក ប្រាក់ បាន យ៉ាង ច្រើន ដើម្បី សាងសង់ ផ្ទះល្វែង ទុក សម្រាប់ ជួល ។
ផ្តល់ឱ្យ ពួកគេ នូវ ហេតុផល ដើម្បី បង់ ឱ្យ យើង ភ្លាម ៗ
ការរកឃើញ នេះ ហាក់ដូចជា ការដើរ ថយ ក្រោយ មួយ នៅក្នុង ការស៊ើបអង្កេត ថា តើ នរណា បាន ធ្វើ ការវាយ បំផ្ទុះ គ្រាប់បែក នៅ ថ្ងៃទី ១៧ខែសីហា ដែល ជា ការវាយប្រហារ ដ៏ ប្រល័យ បំផុត មិន ធ្លាប់ មាន នៅក្នុង ប្រទេស ថៃ ។
តើ ការសសន៍ ជា ការ ល្អ ជាមួយនិង ការចែករំលែក ឈ្មោះ របស់ នាង របស់ គាត់ ។
វា នឹង ជម្រុញអោយ មាន ការងារ ជា ក្រុម ហើយ មនុស្ស ជាច្រើន នឹង ធ្វើការ ជាមួយគ្នា ដើម្បី សម្រេច នូវ គោលដៅ រួម មួយ ។
យ៉ាងណាមិញ ទស្សនិកជន ក៏ ដូចជា ហ្វេន ៗ
លោក ចូលចិត្ត រៀន វេយ្យាករណ៍ និង បកប្រែ ភាសា អង់គ្លេស ជាង គេ ។
សង្គ្រាម ពាណិជ្ជកម្ម អាច បង្កអោយ មាន ផល ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច ពិភពលោក ទាំងមូល ។
រយៈពេល ២សប្តាហ៍ នេះ ពលរដ្ឋ សម្រុក ផ្ទេរ កម្មសិទ្ធិ យានយន្ត ១ ថ្ងៃ ជាង ១០០ គ្រឿង
លក្ខណៈ ពិសេស ទាំងអស់ អាច ត្រូវបាន ចូល ដំណើរការ ពី ចំណុច ប្រទាក់ តែ មួយ ។
ដែល ស្រង់ មកពី គំនិត អ្នកជំនាញ នានា ។
តែ ដល់ គិត ឆ្ងាយ ទៅ ទើប សំរេច តាំងចិត្ត ថា រំងាប់ ចិត្ត ស្អប់ នេះ វិញ ។
អញ នឹង ស្តាប់ ។
បើ គាត់ អនុញ្ញាតឱ្យ ធ្វើ គាត់ អាច ថា នឹង ធ្វើឱ្យ បាត់បង់ ប្រជាប្រិយភាព បន្តិច ត្រង់ ថា គណបក្ស របស់ គាត់ មិន ទាន់ ចាប់ផ្តើម ធ្វើ ចេញ ពី បក្ស នៅ ឡើយ ។
ដូច្នេះ ពួកគេ គឺជា ខ្មែរ ដោយ ស្រប ច្បាប់ ។
ទោះ យើង ស្ថិត ក្នុង ស្ថានភាព យ៉ាងណា ក៏ដោយ ចូរ ឱ្យ ពន្លឺ របស់ យើង បាន ចែងចាំង នៅ គ្រប់ កន្លែង ដែល យើង ទៅ ។
ពួកគាត់ បន្ត ថា បើ តាម ខ្ញុំ ឱ្យ មាន តម្លាភាព សងខាង លុះត្រាតែ ហៅ ទាំង សងខាង ទៅ ត ទល់ គ្នា នៅ តុលាការ ។
បញ្ហា ជំនន់ ទឹកភ្លៀង នា ចុង រដូវ វស្សា ក្នុង ឆ្នាំ ២០២០ នេះ មិន ត្រឹមតែ បង្កឱ្យ មាន ការជន់ លិច នៅ តាម បណ្តា ស្រុក ជាប់ នឹង ស្ទឹង ធំ ៗ
លោក កឹម សុខា នៅក្នុង សមាជ គណបក្ស កាលពី ម្សិលមិញ ។
ប៉ុន្តែ គាត់ មាន មោទនភាព ដោយសារតែ យើង នៅ ទីនេះ ជាមួយ គាត់ ។
ក្រសួង ការងារ ឱ្យដឹង ថា មាន ពលករ ជាង ១លាន នាក់ កំពុង ធ្វើការ នៅ ក្រៅ ប្រទេស
ដូច្នេះ ស្តេច សហរ្យ មាន សេចក្តីរីករាយ ជាខ្លាំង ល្អ ណាស់ ។
ខ្ញុំ តែងតែ មាន ក្តីស្រឡាញ់ ភ្លេង អាស៊ី ជាពិសេស ភ្លេង ឥណ្ឌា ។
ដោយ ព្រោះតែ ទូលបង្គំ ប្រព្រឹត្ត តាម ការ ល្អ
លទ្ធិ ប្រជាធិបតេយ្យ កំពុង ធ្លាក់ចុះ នៅ ទូទាំង ពិភពលោក ។
ជា ការពិត ណាស់ អ្នកនយោបាយ តែង រិះគន់ គ្នា ទៅ វិញ ទៅមក ។
ប្រជាពលរដ្ឋ ២នាក់ បាន ស្លាប់ ភ្លាម ៗ
បច្ចេកវិទ្យា នេះ ស្ត្រី នឹង មិន ប្រាប់ បុរស ៗ
អ្វី ដែល មិន គួរ ធ្ចើ មាន ដូចជាៈ
នោះ ទេ រង់ចាំ ដល់ ឆ្នាំ ក្រោយ ។
សម្លេង ឆ្នោត ជា ភស្តុតាង ៖
ដូច្នេះ ក្រសួង លឹម គាង ហោ ប្រហែលជា
ខ្ញុំ ញញឹម ចេញមក នៅពេល បាន ឮ ដូច្នោះ ៖
ប្រទេសជាតិ រីកចំរើន ទៅ បាន ដោយសារ មាន ការយល់ដឹង
សុទ្ធតែ ត្រូវ ចំណាយ ពេល ជាច្រើន ថ្ងៃ ។
ពួកគេ ក៏ ចេញ ទៅ វាយប្រហារជីវិត ប្រជាជន នៅក្នុង ទីក្រុង ។
គាត់ កំពុង ធ្វើ ការស្រាវជ្រាវ ។
នៅពេល នាង មិន ធ្វើ តាម គាត់ ចង់បាន គាត់ បាន ហាម មិន ឱ្យ អ្នកនាង ធ្វើ ការងារ ថែម ម៉ោង ។
មួយចំនួន ត្រូវបាន លាក់ ទុក ដោយ ស្វ័យប្រវត្តិ មិន បង្ហាញ ឱ្យ ឃើញ នោះ ទេ ។
លោក ស្រឡាញ់ យើង ហើយ ចង់ឱ្យ យើង ស្រឡាញ់ លោក វិញ ។
ពិធី បុណ្យ ចូល ឆ្នាំ ចិន បាន ឈានចូល មកដល់ ហើយ ។
នេះ ហើយ ជា ហេតុ ដែល វា សំខាន់ សម្រាប់ កុមារ ដែល ត្រូវ ដឹង ថា ពួកគេ ត្រូវ ធ្វើ អ្វី នៅក្នុង ស្ថានភាពអាសន្ន បែប នេះ ។
នៃ កំណែទម្រង់ ប្រព័ន្ធ បោះឆ្នោត រយៈពេល ជាង ៥ខែ
ចំណែក សាស្ត្រាចារ្យ នៅ ទីនោះ វិញ ក៏ មិន
គេ ងឿងឆ្ងល់ នឹង ព្រះយេស៊ូ យ៉ាង ខ្លាំង ។
រិះគន់ ខ្លួន បាន តែ ម៉ាច័ន្ទ បញ្ញា ហាម ដាច់ កុំ មើលងាយ អ្នកគាំទ្រ
និង ស្នើសុំ ពួក នាង ឱ្យ ចូលរួម នៅក្នុង រថយន្ត របស់ គាត់ ។
ប្រសិនបើ អ្នក ក្រឡេក មើល ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ចក្រភព អង់គ្លេស ក្នុង រយៈពេល ៥ឬ ៧ឆ្នាំ ចុងក្រោយ នេះ រឿង នេះ គួរតែ ត្រូវបាន កើតឡើង ជា យូរ ណាស់ មកហើយ ។
ពាក្យ ចចាមអារ៉ាម និង រូបថត ទាំងនេះ ហាក់ ជា ភស្តុតាង សបញ្ជាក់ ថា ពួកគេ កំពុងតែ សាង ស្នេហា ជាមួយគ្នា មែន ។
រុក្ខជាតិ សុខភាព អ្នក គួរតែ ដឹង !
លោក បញ្ជាក់ ថា ហេតុដូចម្តេច បានជា មិន នាំ ជន ពាក់ព័ន្ធ នៃ ប្រទេស ទាំងនោះ មក កាត់ទោស ផង ។
គន្លឹះ2 ចាប់ផ្តើម ប្រើ របៀប ម៉ៅ ទាប
អោយ ចេះ ជេរ តាម អ៊ិនធើណែត ទៀត រហូតមកដល់ ពេលនេះ ខ្ញុំ មិន ទាន់ ដឹង ថា
ពី អង្គការ មិន មែន រដ្ឋាភិបាល របស់ អាមេរិក ដើម្បី ដោះស្រាយ វិបត្តិ ជំងឺ របេង ។
គ្នា ទៅ ទៀត ទៅ តាម ការដាស់ នូវ បាលីមន្ត ។
គ្នា អាស្រ័យ ទៅ លើ បុគ្គល នោះ ផ្ទាល់ តែម្តង ។
តើ ស្ត្រី ចង់បាន អ្វី ខ្លះ ទាក់ទង នឹង ជីវិត នៅលើ គ្រែ ?
រដ្ឋាភិបាល យួន ថា នៅលើ ពិភពលោក មាន ជនជាតិ ដើម ប៉ុន្តែ គ្មាន នៅ វៀតណាម ។
សូម និយាយ អំពី និស្សិត នៅ សម័យកាល លោក វ៉ាន់ ឌីកា អុន វិញ ។
នេះ ជា លើក ទី៣ហើយ ដែល ជាប់ ពន្ធនាគារ ។
ក្រិន ថ្លើម មាន បួន កម្រិត នេះ គ្នា យើង គួរ ស្វែងយល់
ព្រោះ គ្មាន អ្នកណា ជួយ ពួកគាត់ បាន ទេ ។
គួរឱ្យ ស្រឡាញ់ ខ្លាំង ណាស់ សម្រាប់ មនុស្ស ស្រី ទូទៅ ។
លោក បាន បញ្ចប់ សុន្ទរកថា របស់ លោក ដោយ ពាក្យ ថា សូម ព្រះជាម្ចាស់ ជួយ ដល់ យើង គ្រប់ គ្នា ។
លោក ជួន ណារិន បាន អះអាង ថា ពួកគេ បាន បាញ់ ត្រឹមតែ ឧស្ម័ន បង្ហូរ ទឹកភ្នែក និង គ្រាប់ កាំភ្លើង ជ័រ ប៉ុណ្ណោះ ។
ផ្លែ ឈើ ឬ ផល្លានុផល ទាំងនោះ គឺ ជ្រើសរើស យក តែ ផ្លែ ធំ ៗ
អ្នក ខ្លះ ទៅ តាំងពី ថ្ងៃ ម្សិលមិញ ក៏ មាន ។
ដើម្បី បញ្ជូន ពួកគេ ត្រឡប់មក ប្រទេស កម្ពុជា វិញ ឱ្យ បាន ឆាប់រហ័ស បំផុត ៖
អ្នក ដែល បាន ប្រព្រឹត្ត អបាយ មុខ នេះ នឹង ជួប សេចក្តីវិនាស ឃើញ ទាន់ហន់ ក្នុង លោក នេះ ។
សម្រាប់ ទារក តូច ៗ
គ អាបោធាតុ ទឹក ដូចជា ទឹកមាត់ ត្រូវ មាន ប្រាកដ
ខ្ញុំ ត្រូវ ចំណាយ ពេល ពេញ មួយ ថ្ងៃ នេះ និង ថ្ងៃស្អែក មួយ ថ្ងៃ ទៀត ដោយ ដេក នៅក្នុង រដ្ឋធានី នេះ មួយ យប់ ។
កូន ចង់អោយ សម្តេច និយាយ ជាមួយ លោក ប្រធានាធិបតី និង រដ្ឋសភា សំដៅ ធ្វើ យ៉ាងណា អោយ ឪពុក ម្តាយ កូន បាន ចូល សញ្ជាតិ ព្រោះ សព្វ ថ្ងៃ នេះ កូន ភ័យខ្លាច រហូត ថា ថ្ងៃ ណាមួយ ពួក ឝេ នឹង នាំយក ឪពុក ម្តាយ ទៅ ឆ្ងាយ ពី កូន ។
ថ្នាំ ញៀន ជាង ៤០ គីឡូ បង្ក្រាប បាន នៅក្នុង ខែ នេះ
ដូច្នេះហើយ ពេល ដែល គូស្នេហ៍ មួយ គូ ៗ
អរគុណ ប្រិយមិត្ត ទាំងអស់ ដែល តាមដាន អាន រឿង នេះ តាំងពី ដើម រហូតដល់ ចប់ !
ក្មេងស្រី ពីរ នាក់ នេះ ពិតជា ប្លែក មែនទែន !
ជាថ្មី ម្តង ទៀត យើងខ្ញុំ សូម បញ្ជាក់ ជូន តុលាការ មេត្តា ជ្រាប ថា ៖
នៅ ថ្ងៃទី ១៥ ខែមិថុនា ខាងមុខ នេះ មិន ត្រឹមតែ ជា ថ្ងៃ រៀបការ ប៉ុណ្ណោះ ទេ ។
យើង នាំគ្នា មក រកស៊ី អូសរទេះ ក្រុង ប៉ោយប៉ែត នេះ ១៩ ឆ្នាំ ហើយ ហើយក៏ មិន មាន កន្លែង ស្នាក់ អាស្រ័យ ពិតប្រាកដ ឡើយ ។
ហើយ រហូតមកទល់ ពេលនេះ មនុស្ស ១៨ នាក់ ត្រូវបាន ចោទប្រកាន់ ពី បទ ប្រើ អំពើហិង្សា ៕
នេះ ជា លទ្ធផល នៃ ការស្មោះ ស្នេហ៍ ដែល ខំ សាងឡើង មាន រយៈពេល ៤ឆ្នាំ ជាមួយគ្នា ។
តែ ម្ចាស់ ចម្ការ ក៏ ជួយ ចេញ សំណង មួយចំនួន ក្នុង ការចាត់ចែង ពិធី បុណ្យ សព ដែរ ៕
គេ បាន ទុកចិត្ត នឹង ទ្រង់ ហើយ មិន ត្រូវ ខ្មាស ឡើយ
ក្នុង ខណៈ ពួកគេ បាន ថត រូប ជាមួយនឹង មិត្ត ស្រី របស់ ខ្លួន ទុក ជា អនុស្សាវរីយ៍ ទៀតផង ។
កត្តា ទាំងនេះ កំពុងតែ បង្កឱ្យ មាន ការគំរាមកំហែង ដល់ សន្តិសុខ ស្បៀង
សម្រស់ ពី ធម្មជាតិ របស់ ខ្លួន ជាពិសេស ចំពោះ ស្ត្រី ។
ខ្ញុំ ចង់ រៀន ក្នុង ថ្នាក់ នៅ ថ្ងៃ ខាងមុខ ៕
គណៈប្រតិភូ មក ទស្សនកិច្ចការងារ ។
ឥឡូវ មក ដឹង ពី គ្រឿងផ្សំ និង វិធី ធ្វើ ការ៉េម ចេក ខ្ទិះ ដូង ទាំងអស់ គ្នា ៖
ព្យាការី នោះ ហ៊ាន និយាយ ដោយ ចិត្ត ឯង ដូច្នេះ កុំ ខ្លាច គេ អោយ សោះ ។
មិន តែ ប៉ុណ្ណោះ ទេ វា ត្រូវបាន គេ ជឿ ថា មាន ប្រភព មកពី តំបន់ អាស៊ី
ចុះផ្សាយ តែ អ្នក នេះ អ្នក នោះ កាដូ លុយ ឱ្យ នាងខ្ញុំ ម៉េច បាន ច្បាស់ ម្ល៉េះ ?
ប្រសិទ្ធភាព នេះ នឹង កាន់តែ សុក្រិត បន្ថែម ទៀត ប្រសិនជា ការកាត់ ចុង នោះ ធ្វើឡើង ក្រោយ អាយុ ៣៥ ឆ្នាំ ។
តើ ប្រិយមិត្ត បោះឆ្នោត ឱ្យ មួយ ណា ទុក ជីវិត ឬ ប្រហារជីវិត ។
ខ្ញុំ សង្ស័យ ថា ក្មេង រងគ្រោះ អាច ម្នាក់ ក្នុង ចំណោម ពួកគេ នេះ …
បងប្អូន មិត្តភក្តិ ជាដើម ដែល បំបែក គូស្នេហា ។
មិន អី ទេ ហើយក៏ សង្ឃឹម ថា អាច ចូលរួម រំលឹក ឡើងវិញ ចឹង ។
ទីបំផុត នាង រក ការងារ បាន មួយ ទៀត គឺ ការងារ ជា ស្ត្រី ជំនួយការមេ ផ្ទះ ។
គិត មកដល់ ពេលនេះ គឺ មាន រយៈពេល ជិត ៦ខែ ហើយ ដែល អ្នក ទាំង២ ត្រូវបាន ជាប់ ឃុំ ក្នុង ពន្ធនាគារ ៕
ប្រិយមិត្ត ប្រហែលជា អាច ទាយ ដឹង ពី សញ្ជាតិ របស់ តួអង្គ ក្នុង រឿង នេះ ហើយ ។
នេះ គឺជា នំប៉័ង ឆ្មា
កំហុស ទាំងនេះ ហើយ បាន លទ្ធផល វាស់ សម្ពាធ ឈាម ខុស ប្រក្រតី
១១ គ្មាន អំពើហិង្សា ចំពោះ កូន
មិន ត្រូវ មកដល់ មណ្ឌល ប្រឡង ក្រោយ ជួង ទី២ ។
សារ ខ្លះ យក ទឹក សុទទ្ធ កឹ
ពេលនេះ ហើយ គឺ មហាមមាញឹក ជាង មុន ទៀត ។
ធ្វើ បែប នេះ ឡើងវិញ ម្តង ទៀត នៅ២ ថ្ងៃ ក្រោយ ។
ខ្ញុំ ចង់ និយាយ ពី មន្ត្រី កែ សំបុត្រ កំណើត មួយចំនួន ធំ ពេល ប្រជាពលរដ្ឋ ទៅ កែ
ដែល ក្រសួង របស់ លោក បាន ខិតខំ ធ្វើឡើយ ។
ហ្នឹង អ្នក ក៏ ធ្លាប់ ឈ្លោះ ជាមួយ មិត្តភក្តិ ដូចគ្នា ដែរ និង អាច ទប់ទល់ នឹង បញ្ហា នោះ បាន ទៀតផង ។
ដំណើរការផលិត គឺ មិន ដូច្នេះ ទេ គេ ត្រូវ សាកល្បង ជាមុន សិន ។
តួយ៉ាង កាលពី ថ្មី ៗ
កាលពី សប្តាហ៍ មុន អាមេរិក បាន បញ្ជូន …
ថ្ងៃ នេះ ប្តី ខ្ញុំ អត់ ទាន់ បាន គេ សាកសួរ សវនាការ ទេ ។
ទំហំ និង ភាពស្មុគស្មាញ នៃ ការបោះឆ្នោត នេះ បាន កើនឡើង ចាប់តាំងពី ពេល នោះ មក ។
ពួកគេ ជា អង្គភាព ធ្វើ ការទាក់ទង បណ្តាញ សង្គម ។
គឺជា ការចាប់អារម្មណ៍ និង ការ ក្រឡេក មើល ទៅ លើ បញ្ហា នយោបាយ …
លោក ម្ចាស់ អ្ហើយ ក្រោក ឡើង ជួយ មើល ផ្លូវថ្នល់ ផង !
ជា វិបុល រំភើប ខ្លាំង ខួបកំណើត ឆ្នាំ នេះ ព្រោះ ទទួលបាន សារ ជួន ពរ យ៉ាង ពិសេស ពី ភរិយា
រាល់ បញ្ហា សុទ្ធតែ មាន ដំណោះស្រាយ ។
យន្តហោះ អាមេរិក ទាំងនេះ បាន ហោះ ចូល តំបន់ នេះ ដោយ មិន ផ្តល់ ដំណឹង អោយ អាជ្ញាធរ ចិន ដឹង ជាមុន នោះ ទេ ។
ជោគជ័យ ផ្ទាល់ខ្លួន គឺ ការយក អោយ បាន នូវ អ្វី ដែល ខ្លួន ចង់ បាន ហើយ បន្ត ចង់បាន នូវ អ្វី ដែល ខ្លួន មាន
បំផុត របស់ ខ្លួន ដោយ ក្រុម ភ្ញៀវ តែម្តង ។
សកម្មភាព ចោរ លួច ស្លាកលេខ ឡាន ពិសេស ប្រើ ពេល មិន ដល់ មួយ នាទី វីដេអូ
នៅ ពេលព្រឹក សារ ពាង្គកាយ អ្នក តែងតែ ខ្វះ ជាតិ ទឹក ដូចនេះ ទឹក ក្តៅ ឧណ្ឌ ៗ
៥នាង ចូល ទៅក្នុង ផ្នូរ ឃើញ កំលោះ ម្នាក់ អង្គុយ ខាងស្តាំ មាន សម្លៀកបំពាក់ ពណ៌ ស ពួក នាង ភ័យ ស្រឡាំងកាំង ។
យើង ត្រូវ ដឹង ថា អាហារ ពេលព្រឹក គឺជា អាហារ ដ៏ សំខាន់ បំផុត សម្រាប់ រយៈពេល ពេញ មួយ ថ្ងៃ ។
មួយចំនួន អាច ឈាម ច្រមុះ ដោយ មិន ដឹងខ្លួន ។
៣សុខ របស់ អ្នក មាន ប្តី ប្រពន្ធ ។
មេអំបៅ គឺជា និមិត្តរូប a នៃ សេរីភាព និង សម្រស់ ។
ជនជាតិ អ៊ីស្រាអែល ទាំងមូល ដឹង រឿង នេះ ហើយ គេ នឹង ភ័យខ្លាច ។
ទោះ យ៉ាងណា ក្នុង ឱកាស ដែល ខ្ញុំ កំពុង សរសេរ អត្ថបទ នីមួយ ៗ
