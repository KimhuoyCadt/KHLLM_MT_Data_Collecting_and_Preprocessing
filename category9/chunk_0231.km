( ភ្នំពេញ ) ៖ លោក កឹម គុណ វឌ្ឍន៍ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន បាន រម្លឹក ដល់ អ្នកសារព័ត៌មាន និង អង្គភាព ព័ត៌មាន នានា ឱ្យ ចាត់ វិធានការ យ៉ាង ម៉ឺងម៉ាត់ ដើម្បី ពង្រឹង គុណភាព ព័ត៌មាន និង ត្រូវ ផលិត មាតិកា សម្រាប់ បម្រើ ប្រយោជន៍ សាធារណៈ ។
ជាមួយគ្នា នេះ ដែរ លោក កឹម គុណ វឌ្ឍន៍ បាន ថ្លែង ថា ប្រព័ន្ធ ផ្សព្វផ្សាយ បាន ដើរ តួយ៉ាង លេចធ្លោ ក្នុង ការផ្សព្វផ្សាយ ព័ត៌មាន ត្រឹមត្រូវ តាម វិជ្ជាជីវៈ ក្នុង អំឡុង ពេល មាន ការផ្ទុះឡើង នៃ ជំងឺ រាតត្បាត កូវីដ១៩ និង ជួយ ផ្សព្វផ្សាយ ពី សេចក្ដីណែនាំ សុខាភិបាល វិធានការ បង្ការ និង ការពារ ដល់ សាធារណជន បាន ទាន់ ពេលវេលា ខណៈ មាន ការកើនឡើង នៃ ដំណឹង ក្លែងក្លាយ និង ព័ត៌មាន មិន ពិត ។
លោក បាន បន្ត ថា ការជួបជុំ អ្នកសារព័ត៌មាន ជាតិ និង អ្នកសារព័ត៌មាន តាម បណ្តា ប្រទេស សមាជិក LMC នា ថ្ងៃ នេះ គឺជា ការចាប់ផ្តើម មួយ ដ៏ ល្អ ដើម្បី ពង្រឹង ចំណេះដឹង និង វិជ្ជាជីវៈ ក្នុង ចំណោម អ្នកសារព័ត៌មាន LMC ហើយ ជា វេទិកា សម្រាប់ អ្នកសារព័ត៌មាន រៀនសូត្រ ពី គា្ន ពិភាក្សា គ្នា បង្កើត បណ្តាញ (networking) និង ចែករំលែក បទពិសោធន៍ គ្នា ទៅ វិញ ទៅមក អំពី តួនាទី របស់ យើង ជា អ្នកសារព័ត៌មាន ក្នុង ការចូលរួមចំណែក ពង្រឹង នូវ កិច្ចសហប្រតិបត្តិការ LMC លើកកម្ពស់ សន្តិភាព វិបុល សុខ និង ការ អភិវឌ្ឍន៍ នូវ សេដ្ឋកិច្ច ។
បន្ថែម ពី នេះ លោក រដ្ឋលេខាធិការ បាន បញ្ជាក់ ថា ដើម្បី ក្លាយជា អ្នកសារព័ត៌មាន ដែល អាច ចូលរួមចំណែក ក្នុង ការពង្រឹង នូវ កិច្ចសហប្រតិបត្តិការ នេះ អ្នកសារព័ត៌មាន ត្រូវ មាន សមត្ថភាព ក្នុង ការរាយការណ៍ និង ផ្សព្វផ្សាយ ព័ត៌មាន ពិត ត្រឹមត្រូវ និង ត្រូវ ធ្វើ កិច្ចសហប្រតិបត្តិការ ក្នុង ចំណោម អ្នកសារព័ត៌មាន ឈាន ឆ្ពោះ ទៅរក ការបង្កើត នូវ ក្លឹប អ្នកសារព័ត៌មាន ឡាន ឆាង - មេគង្គ ។
លោក កឹម គុណ វឌ្ឍន៍ បាន ឱ្យដឹង ថា កន្លងមក កិច្ចសហប្រតិបត្តិការ ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ចំណោម ប្រទេស សមាជិក LMC មាន លក្ខណៈ ទ្វេ ភាគី និង នៅ មាន កម្រិត មិន ទាន់ មាន ថ្នាល (Platform) ដែល អ្នកសារព័ត៌មាន ទាំង ៦ប្រទេស ធ្វើការ ជាមួយគ្នា ចែករំលែក នូវ ព័ត៌មាន និង បទពិសោធន៍ ការងារ នោះ ទេ ។ ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ក្នុង ចំណោម អ្នកសារព័ត៌មាន អាច ពង្រឹង គុណភាព និង ភាពសំបូរ បែប នៃ ព័ត៌មាន ប្រសិទ្ធភាព ការងារ និង ចំណេញ ពេល វេលា ។
ទន្ទឹមនឹង នេះ ដែរ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ព័ត៌មាន រូប នេះ បាន បញ្ជាក់ ថា កិច្ចសហប្រតិបត្តិការ ដ៏ មាន សក្តានុពល នេះ បាន ផ្ដោត លើស សរ ស្តម្ភ នៃ កិច្ចសហប្រតិបត្តិការ ចំនួន ៣ គឺ ទី ១៖ បញ្ហា នយោបាយ និង សន្តិសុខ ទី២៖ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច និង និរន្តរភាព និង ៣៖ សង្គម វប្បធម៌ និង ការផ្លាស់ប្ដូរ ប្រជាជន ទៅ ប្រជាជន ជាពិសេស ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន នៅ តាម តំបន់ ព្រំដែន នៃ ប្រទេស តាម ដងទន្លេ ឡាន ឆាង - មេគង្គ ។
លោក បាន គូសបញ្ជាក់ ថា ប្រព័ន្ធ ផ្សព្វផ្សាយ និង ព័ត៌មាន បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការបង្កើន ការយល់ដឹង របស់ សាធារណជន ចំពោះ កិច្ចសហប្រតិបត្តិការ LMC និង ជា មធ្យោបាយ ដ៏ មាន សារៈសំខាន់ ក្នុង ការចែករំលែក នូវ ព័ត៌មាន (Information Sharing) ពី សេដ្ឋកិច្ច នយោបាយ សង្គម និង វប្បធម៌ នៃ ប្រទេស ជា សមាជិក ។ តម្លៃ និង សារៈសំខាន់ ប្រព័ន្ធ ផ្សព្វផ្សាយ និង សារព័ត៌មាន ត្រូវបាន មើលឃើញ រឹតតែ ច្បាស់ នៅពេល ប្រទេសជាតិ ជួបប្រទះ នូវ បញ្ហា អសន្តិសុខ សង្គ្រាម ឬ វិបត្តិ សុខភាព សាធារណៈ ដូចជា ជំងឺ កូវីដ១៩ ជាដើម ។
លោក ក៏ បាន រម្លឹក ជូន ជា គតិ ជូន ដល់ វគ្គ បណ្តុះបណ្តាល ពិចារ ណា៖ « ការសិក្សា រៀនសូត្រ គឺ គ្មាន ទីបញ្ចប់ នោះ ឡើយ ការសិក្សា អស់ មួយ ជីវិត ជា ត្រី វិស័យ ចង្អុលបង្ហាញ ប្រាប់ ថា ដើម្បី មាន ចំណេះដឹង ចំណេះ ធ្វើ ចំណេះ ក្នុង ការគិត គឺ មាន តែ ការសិក្សា រៀនសូត្រ មួយ គត់ ដែល នឹង នាំ យើង ទៅកាន់ ទីតាំង មួយ ដែល សង្គមជាតិ ត្រូវការ និង ផ្តល់ តម្លៃ » ៕
អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ថ្មី ដែល ចំណាយ ទុន វិនិយោគ ចំនួន ប្រមាណ ៨៨០ លាន ដុល្លារ អាមេរិក បាន ចាប់ផ្តើម ដំណើរការ សាងសង់ នៅ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២០ ដោយ ប្រើ រយៈពេល រយៈពេល សាងសង់ សរុប ចំនួន ៣៦ ខែ ឬ ៣ ឆ្នាំ ដោយ បាន ប្រើប្រាស់ កម្មករ ប្រមាណ ជាង ១.០០០ នាក់ ក្នុង នោះ ៧០% ជា ពលករ ខ្មែរ ។
នៅក្នុង ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ អគារ មជ្ឈមណ្ឌល ត្រចៀក ច្រមុះ បំពង់ ក នៃ មនី្ទរពេទ្យ ព្រះអង្គ ឌួង នៅ ព្រឹក ថ្ងៃចន្ទ ទី២៨ ខែមីនា ឆ្នាំ ២០២២ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ថ្លែង ថា ព្រលានយន្តហោះ អន្តរជាតិ សៀមរាប - អង្គរ ថ្មី នេះ នឹង អាច មាន សមត្ថភាព ទទួលយន្តហោះ ធុន ធំ ដែល មកពី ចម្ងាយ មក ចុះចត នៅក្នុង ខេត្ត សៀមរាប តែម្តង ខណៈ ព្រលានយន្តហោះ បច្ចុប្បន្ន អាច ទទួល ការចុះចត យន្តហោះ បាន តែ ប្រភេទ ធុន តូច តែ ប៉ុណ្ណោះ ។ មិន អាច ទទួលបាន យន្តហោះ ធុន ធំ នោះ ទេ ។
សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា ពង្រឹង សមត្ថភាព ប្រធាន សាខា គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ទូទាំង ប្រទេស ដើម្បី ពង្រឹង ការផ្តល់ សេវា ដល់ អតិថិជន ឱ្យ មាន ប្រសិទ្ធភាព
( ភ្នំពេញ ) ៖ សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា បាន ពង្រឹង សមត្ថភាព ប្រធាន សាខា គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ទូទាំង ប្រទេស លើ ការគ្រប់គ្រង សាខា ប្រកបដោយ ប្រសិទ្ធភាព ចីរភាព ក្រមសីលធម៌ និង វិជ្ជាជីវៈ តាមរយៈ ការរៀបចំ សិក្ខាសាលា បណ្តុះបណ្តាល ប្រធាន សាខា ថ្នាក់ ស្រុក និង ខេត្ត របស់ គ្រឹះ មីក្រូ ហិរញ្ញវត្ថុ និង ធនាគារ ជា សមាជិក ទូទាំង ប្រទេស ។
សិក្ខាសាលា ទំាង ៥ តំបន់ នេះ ទទួលបាន ការរួម សហការ ជាមួយ ការិយាល័យ ឥណទាន កម្ពុជា (CBC) ក្រោម ការចង្អុលបង្ហាញ ពី ធនាគារ ជាតិ នៃ កម្ពុជា នឹង ចូលរួម លើកកម្ពស់ និរន្តរភាព របស់ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ផង ជា ឧត្តម ប្រយោជន៍ ដល់ អតិថិជន ផង និង វិស័យ ហិរញ្ញវត្ថុ ទាំងមូល ផង ក៏ ដូចជា ចូលរួមចំណែក ជួយ ជម្រុញ កំណើន សេដ្ឋកិច្ច ជាតិ ៕ ប្អូន ស្រី ប្ដឹង បង ប្រុស បង្កើត ទៅកាន់ តុលាការ ទាមទារ ដី យក មកវិញ ក្រោយ បង ប្រុស រំលោភ ធ្វើ របង បិទ ផ្លូវ មិន ចេញ ចូល ផ្ទះ បាន នៅ ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ ស្រ្តី វ័យ ៧១ ឆ្នាំ ម្នាក់ បាន សម្រេចចិត្ត ដាក់ពាក្យបណ្ដឹង បង ប្រុស បង្កើត របស់ ខ្លួន ទៅកាន់ សាលាដំបូង ខេត្ត កំពង់ស្ពឺ ដើម្បី ទាមទារ ដី ទំហំ ជាង ១.០០០ ម៉ែត្រ ការ៉េ យកមកក វិញ ក្រោយ បង ប្រុស របស់ ខ្លួន បាន ធ្វើ របង បិទ ផ្លូវ មិន អាច ធ្វើដំណើរ ចេញ ចូល ផ្ទះ បាន ។
ដើម បណ្ដឹង អ៊ុំ យឿន អាយុ ៧១ ឆ្នាំ រស់ នៅ ភូមិ គោក ដង្កោ ឃុំ ពេជ្រ មុន្នី ស្រុក គងពិសី ខេត្ដ កំពង់ស្ពឺ បាន បញ្ជាក់ ក្នុង បណ្ដឹង ចុះ ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០២២ ថា កាលពី ឆ្នាំ ១៩៨២ ខ្លួន បាន កាន់កាប់ អាស្រ័យ ផល លើ ក្បាល ដី លេខ ៥៧៩ ( ដែល កំពុង មាន ទំនាស់ ) ដោយ មាន អាជ្ញាធរ មូលដ្ឋាន ដឹង លឺ និង ទទួលស្គាល់ តាម ផ្លូវ ច្បាប់ ដែល ដី នោះ ស្ថិត នៅ ភូមិ គោក ដង្កោ ឃុំ ពេជ្រ មុន្នី ស្រុក គងពិសី ខេត្ដ កំពង់ស្ពឺ ។
ស្រាប់តែ នៅ ដើម ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ ឈ្មោះ អ៊ុំ ជុំ ជា បង ប្រុស បាន ធ្វើ របង បិទ ផ្លូវ មិន ឱ្យ ម្ចាស់ ដី ឈ្មោះ អ៊ុំ យឿន ចេញ ចូលទៅ ផ្ទះ នៅ ផ្នែក ខាងក្រោយ បាន ទៀត ទើប ម្ចាស់ ដី សម្រេច ដាក់ពាក្យ ប្ដឹង ទៅកាន់ តុលាការ ដើម្បី ទាមទារ ដី របស់ ខ្លួន មក វិញ និង សំណូមពរ ឱ្យ តុលាការ ជួយសម្រេច បើក ផ្លូវ ចេញ ចូល ផ្ទះ ខាងក្រោយ ផង ព្រោះ ក្រុមគ្រួសារ របស់ គាត់ ដែល រស់ នៅ ផ្នែក ខាងក្រោយ គ្មាន ផ្លូវ ចូលទៅ ផ្ទះ របស់ ខ្លួន នោះ ទេ ។
លោក ណុប សុខ មេឃុំ ពេជ្រ មុន្នី បាន ប្រាប់ ថា លោក បាន ហាមឃាត់ តាំងពី ដំបូង កុំ ឱ្យ លោក អ៊ុំ ជុំ ធ្វើ របង បិទ ផ្លូវ គេ ព្រោះ វា ខុស ច្បាប់ ប៉ុន្តែ លោក មិន ស្តាប់ មេឃុំ ទេ នៅតែ ធ្វើ ទាល់តែ បាន ទាំង បំពាន ។
លោក មេឃុំ បន្ត ថា « ដី នេះ ពិត ណាស់ ជា កម្មសិទ្ធិ ស្រប ច្បាប់ របស់ អ៊ុំ យឿន ដូច្នេះ លោក អ៊ុំ ជុំ បិទ ផ្លូវ ចូល ផ្ទះ គេ ទាំង ខុស ច្បាប់ ហើយ លោក នឹង ធ្វើ របាយការណ៍ បញ្ជាក់ ឱ្យ កាន់តែ ច្បាស់ ថែម ទៀត អំពី រឿង នេះ ប្រសិនបើ មាន ការស្នើសុំ ពី ពាក់ អ្នកច្បប់ ពាក់ព័ន្ធ ។
សូម ជម្រាប ជូន ថា ដើម បណ្ដឹង ឈ្មោះ អ៊ុំ យឿន ធ្លាប់ បាន ដាក់ពាក្យ ប្ដឹង ទៅកាន់ អាជ្ញាធរ មូលដ្ឋាន មាន ភូមិ ឃុំ ស្រុក ដើម្បី ទាមទារ ដី ខាងលើ នោះ មកកាន់កាប់ វិញ ផងដែរ ប៉ុន្ដែ ឈ្មោះ អ៊ុំ ជុំ មិន ព្រម ប្រគល់ ឱ្យ វិញ នោះ ទេ និង បាន សាងសង់ របង បិទ ផ្លូវ មិន ឱ្យ ម្ចាស់ ដី ចេញ ចូល ផ្ទះ នៅក្នុង ដី ឡូតិ៍ ផ្នែក ខាងក្រោយ ថែម ទៀត ផង ។
ជុំវិញ ករណី បណ្តឹង នេះ លោកយាយ អ៊ុំ យឿន ប្ដឹង បង ប្រុស ឈ្មោះ អ៊ុំ ជុំ ទៅ តុលាការ ដើម្បី ទាមទារ ដី នេះ ពីព្រោះ អាជ្ញាធរ មូលដ្ឋាន និង សាក្សី ជាច្រើន នាក់ ដែល បាន ដឹង រឿងរ៉ាវ ច្បាស់ បាន សម្ដែង ការគាំទ្រ និង ស្នើសុំ ឱ្យ តុលាការ ចាត់ការ រឿង នេះ ឱ្យ បាន ឆាប់ ព្រោះ ភាគី ឈ្មោះ អ៊ុំ ជុំ ពុំ ដែល ស្ដាប់ ការដោះស្រាយ និង ការហាមឃាត់ អាជ្ញាធរ មូលដ្ឋាន នោះ ទេ ដោយ អាង ថា មន្រ្តី នគរបាល ម្នាក់ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ស្ពឺ ។
ថ្លែង ប្រាប់ អ្នកយកព័ត៌មាន នៅឯ សេតវិមាន លោក បៃ ដិន បាន និយាយ ថា « ការលើកឡើង របស់ ខ្ញុំ នា ពេល នោះ គឺ មិន តំណាង ឲ្យ គោល នយោបាយ ការបរទេស របស់ សហរដ្ឋ អាមេរិក ទេ . ខ្ញុំ សម្តែង ការខឹងសម្បារ ដោយ អាម្មណ៍ ផ្ទាល់ខ្លួន ហើយ ខ្ញុំ នឹង មិន ធ្វើ ការសុំទោស ឡើយ » ។
លោក បាន បញ្ជាក់ ទៀត ថា « ការអត្ថាធិប្បាយ ដោយ អាម្មណ៍ រំជួល ចិត្ត កើតមាន នៅ ចុងបញ្ចប់ នៃ សុន្ទរកថា របស់ លោក ស្តី អំពី វិបត្តិ នៅ អ៊ុយក្រែន ក្នុង ទីក្រុង វ៉ាសូវី កាលពី ថ្ងៃសៅរ៍ ចុង សប្តាហ៍ កន្លងទៅ នេះ ដែល ធ្វើឡើង ចំពោះ មុខ ក្រុមគ្រួសារ ដែល បាន ភៀសខ្លួន ចេញ ពី សង្រ្គាម » ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន៖ នយោបាយ ឈ្នះ ឈ្នះ ដាក់ ចេញ ដោយ សម្តេច តេជោ ហ៊ុន សែន គឺជា មរតក មហាសាល នាំមក នូវ សន្តិភាព និង ការអភិវឌ្ឍ
( កំពង់ចាម ) ៖ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ បាន លើកឡើង ថា នយោបាយ ឈ្នះ ឈ្នះ ដែល ដាក់ចេញ ដោយ សម្តេច តេជោ ហ៊ុន សែន គឺជា មរតក មហាសាល នាំមក នូវ សន្តិភាព និង ការអភិវឌ្ឍ ។
ការថ្លែង របស់ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន ធ្វើឡើង ក្នុង ពេល ចុះ សួរសុខទុក្ខ កងទ័ព នៅ យោធ ភូមិភាគ ទី២ ក្នុង នាម សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ នា ព្រឹក ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២២ នេះ ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន ថ្លែង ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល ជាច្រើន ដែល នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន យោធ ភូមិភាគ ទី២សម្រេចបាន ទាំង ក្នុង ការបំពេញ ភារកិច្ចការពារ បូរណភាព ទឹកដី ការពារ សុខ សន្តិភាព ស្ថិរភាព និង ការកសាង អង្គភាព ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន លើកឡើង ពី រយៈពេល ជាង ២៣ ឆ្នាំ មក នេះ ដែល កម្ពុជា បាន បិទ បញ្ចប់ ភ្លើង សង្គ្រាម ដណ្តើម បាន មកវិញ នូវ សុខ សន្តិភាព និង ការឯកភាព ទឺក ដី បន្ទាប់ពី ការបែកបាក់ ជាង ៥០០ ឆ្នាំ ក្នុង ប្រវត្តិសាស្ត្រ កម្ពុជា ។
« នយោបាយ ឈ្នះ ឈ្នះ ដែល បាន ដាក់ចេញ ដោយ សម្តេច តេជោ ហ៊ុន សែន គឺជា មរតក ដ៏ មហាសាល សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ហើយ តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ នេះ ហើយ នាំមក នូវ ពន្លឺ ជីវិត និង សង្គម ថ្មី មួយ ពោរពេញ ដោយ ការអភិវឌ្ឍ និង ការរីកចម្រើន » ។ នេះ ជា ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន នៅ ចំពោះ មុខ នាយ ទាហាន ។
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ ឯកឧត្តម ស៊ុយ សែម រដ្ឋមន្រ្តី ក្រសួង រ៉ែ និង ថាមពល និង លោកជំទាវ ជា ខេង ដែល បាន ឧបត្ថម្ភ ថវិកា ចំនួន ២២.៥០០ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ដើម្បី ចូលរួមចំណែក ជួយ សាងសង់ ផ្ទះ ចំនួន ៦២៨ ខ្នង សម្រាប់ អតីត យុទ្ធជន កម្ពុជា ក្រីក្រ ចំនួន ៦២៨ គ្រួសារ នៅ ភូមិ ប៊ុន រ៉ានី សែន ជ័យ ដំណាក់ ត្រយឹង ឃុំ ព្រងិល ស្រុក ភ្នំ ក្រវាញ ខេត្ត ពោធិ៍សាត់ ។
សូម បញ្ជាក់ ថា ផ្ទះ នីមួយ ៗ មាន ទំហំ ៥ម៉ែត្រ គុណ នឹង ៧ម៉ែត្រ គ្រឿង បង្គុំ ធ្វើ ពី ដែក ស សរ ចាក់ស៊ីម៉ង់តិ៍ ជញ្ជាំង ស្មាត បត ដំបូល ស័ង្កសី និង តតាក ខាងក្រោយ ផ្ទះ ធ្វើជា ចង្ក្រាន បាយ ដែល ចំណាយ ថវិកា តម្លៃ ៣.៥០០ ដុល្លារ អាមេរិក ។ ដោយឡែក បង្គន់ អនាម័យ ដាច់ដោយឡែក មួយ ទៀត មាន តម្លៃ ២៧០ ដុល្លារ អាមេរិក ៕
ឯកឧត្ដម លី វណ្ណា និង លោកជំទាវ សុខ សុវត្ថា បរិច្ចាគ ថវិកា ៤លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្ដម លី វណ្ណា និង លោកជំទាវ សុខ សុវត្ថា បាន បរិច្ចាគ ថវិកា ចំនួន ៤.០០០.០០០ រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម លី វណ្ណា និង លោកជំទាវ សុខ សុវត្ថា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
