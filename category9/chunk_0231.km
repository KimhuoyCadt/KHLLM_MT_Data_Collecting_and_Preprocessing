( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១១ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៤ករណី . ដឹកជញ្ជូន រក្សាទុក ៣ករណី . ជួញដូរ ៤ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ៣២ នាក់ ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ទទួល ជួប ពិភាក្សា ការងារ ទ្វេ ភាគី ជាមួយ អគ្គ មេបញ្ជាការ កងទ័ព ហ្វីលីពីន
ក្នុង ជំនួប នេះ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន សម្ដែង នូវ ការស្វាគមន៍ ចំពោះ វត្តមាន របស់ អគ្គ មេបញ្ជាការ កងទ័ព ហ្វីលីពីន ដែល បាន មក ចូលរួម ដោយ ផ្ទាល់ ក្នុង កិច្ចប្រជុំ អគ្គ មេបញ្ជាការ កង ទ៏ ព អាស៊ាន លើក ទី១៩ ដែល ជា ការផ្ដល់ កិត្តិយស ដ៏ សំខាន់ ដល់ កម្ពុជា ។
នាយ ឧត្តមសេនីយ៍ អគ្គ មេបញ្ជាការ សង្ឃឹម ថា នៅក្នុង កិច្ចប្រជុំ អគ្គ មេបញ្ជាការ កងទ័ព អាស៊ាន នៅ ថ្ងៃស្អែក អគ្គ មេបញ្ជាការ កងទ័ព ហ្វីលីពីន នឹង ចូលរួម ពិភាក្សា ផ្លាស់ប្តូរ ទស្សនៈ ល្អ ដើម្បី សហគមន៍ អាស៊ាន បន្ត រក្សា បាន សន្តិភាព ស្ថិរភាព និង វិបុលភាព នៅក្នុង តំបន់ ។
ឧបាសិកា ស៊ុយ ស៊ុំ ម៉ាឡៃ លោកជំទាវ ពុំ ចន្ទីនី និង ក្រុមគ្រួសារ ឧបត្ថម្ភ ថវិកា ២.៧០០ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២
( ភ្នំពេញ ) ៖ ឧបាសិកា ស៊ុយ ស៊ុំ ម៉ាឡៃ លោកជំទាវ ពុំ ចន្ទីនី និង ក្រុមគ្រួសារ ឧបត្ថម្ភ ថវិកា ២.៧០០ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ នេះ ។
ឧបាសិកា ស៊ុយ ស៊ុំ ម៉ាឡៃ លោកជំទាវ ពុំ ចន្ទីនី និង ក្រុមគ្រួសារ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។
ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ប៉ា សុជាតិ វង្ស និង លោកជំទាវ អ៊ួន សុវណ្ណ រិន្ទ ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ប៉ា សុជាតិ វង្ស ទទួលបន្ទុក បេសកកម្ម ពិសេស និង លោកជំទាវ អ៊ួន សុវណ្ណ រិន្ទ ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ នេះ ។
ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ប៉ា សុជាតិ វង្ស លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។
ក្រសួង ព័ត៌មាន បើក វគ្គ បណ្តុះបណ្តាល ជំនាញ « ពិធី ករ ពិធី ការិនី » ដល់ ជន មាន ពិការ ភាព ភ្នែក និង កាយសម្បទា នៅ សមាគម តន្ត្រី សំនៀង ជន ពិការ
( ភ្នំពេញ ) ៖ លោកស្រី ញ៉ែ ម មរក ត អនុ រដ្ឋលេខាធិការ និង ជា ប្រធាន ក្រុមការងារ ពិការភាព ក្រសួង កិច្ចការ នារី និង លោក ឃឹម វុទ្ធី អគ្គ នាយក នៃ អគ្គ នាយក ដ្ធាន ទូរទស្សន៍ ជាតិ កម្ពុជា បាន អញ្ជើញ បើក វគ្គ បណ្តុះបណ្តាល ជំនាញ « ពិធី ករ ពិធីការ នី » នៅ សមាគម តន្ត្រី សំនៀង ជន ពិការ ។
វគ្គ បណ្តុះបណ្តាល នេះ សមាគម ជន ពិការ បាន ទទួល ការអនុញ្ញាត ពី រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ដឹកនាំ ដោយ លោក ឃឹម វុទ្ធី ដោយ អញ្ជើញ លោកគ្រូ អ្នកគ្រូ ជំនាញ ដែល ជា អគ្គ នាយក រង ប្រធាន អនុប្រធាន នាយកដ្ឋាន នៃ អគ្គ នាយកដ្ឋាន ទូរទស្សន៍ និង វិទ្យុជាតិ មក បង្រៀន ជំនាញ ពិធី ករ ពិធី ការិនី ដល់ ជន មាន ពិការ ភាព ភ្នែក កាយសម្បទា ចំនួន ៧៣ នាក់ ។
នេះ ជា លើក ទី១ សម្រាប់ បងប្អូន ពិការ ភ្នែក នៅ សមាគម ដែល បាន ទទួល ជំនាញ នេះ ដោយ ជន មាន ពិការ ភាព ភ្នែក ត្រូវការស្តាប់ និង និយាយ ឲ្យ ល្អ តាម ក្បួន ខ្នាត ដើម្បី ជា ទុន ក្នុង ការប្រកប មុខរបរ និង ធ្វើ ការងារ ចិញ្ចឹម ជីវិត ក្រៅពី ជំនាញ ផ្សេង ៗ ទៀត ដែល ពួកគាត់ មាន ។
សមាគម តន្រ្ដី សំនៀង ជន ពិការ បាន រៀបចំ វគ្គ បណ្ដុះបណ្ដាល ជំនាញ ពិធី ករ ពិធី ការិនី ដល់ ជន មាន ពិការ ភាព ភ្នែក កាយសម្បទា ក្នុង គោលបំណង បង្កើន និង ពង្រឹង សមត្ថភាព ទេពកោសល្យ លើ ការសរសេរ ព័ត៌មាន អត្ថាធិប្បាយ កម្មវិធី តុ មូល ផលិត កម្មវិធី វិទ្យុ និង ការនិយាយ ជា ពិធី ករ ពិធី ការិនី ដ៏ ជំនាញ នៅ តាម ស្ថានីយ ទូរទស្សន៍ វិទ្យុ និង តាម កម្មវិធី ប្រគំ តន្រ្តី នានា ។
ថ្លែង សន្ទរកថា ក្នុង ឱកាស នេះ លោក ឃឹម វុទ្ធី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ទូរទស្សន៍ ជាតិ កម្ពុជា បាន សម្តែង សេចក្ដីសោមនស្ស រីករាយ យ៉ាង ជ្រាលជ្រៅ ដែល បាន ចូលរួម ក្នុង ពិធី បើក វគ្គ បណ្ដុះបណ្ដាល ជំនាញ ពិធី ករ ពិធី ការិនី ដល់ បងប្អូន មាន ពិការ ភាព ភ្នែក និង កាយសម្បទា នៅ សមាគម តន្រ្ដី សំនៀង ជន ពិការ ដែល មាន សិក្ខាកាម សរុប ចំនួន ៧៣ នាក់ ។
លោក បាន បន្ត ទៀត ថា ទូរទស្សន៍ ជាតិ កម្ពុជា តែងតែ ចូលរួម ចែករំលែក ចំណេះដឹង និង ផ្ដល់ ឱកាស ដល់ បងប្អូន មាន ពិការភាព បាន បង្ហាញ សមត្ថភាព ក្នុង កម្មវិធី សិល្បៈ កំសាន្ដ និង ចូលរួម ប្រទ្បង មហោស្រព តន្រ្ដី ចម្រៀង សម័យ ថ្នាក់ ជាតិ នា ពេល កន្លងមក ផងដែរ ។
លើស ពី នេះ ទូរទស្សន៍ ជាតិ កម្ពុជា ក៏ បាន ចូលរួម ផ្សព្វផ្សាយ លើកកម្ពស់ គាំទ្រ និង លើកទឹកចិត្ត ដល់ បងប្អូន ជន មាន ពិការភាព សំដៅ ផ្តល់ កាលានុវត្តភាព និង សិទ្ធិ អំណាច គ្រប់គ្រាន់ ក្នុង ការចូលរួម គ្រប់ សកម្មភាព សង្គម រួម មាន វិស័យ អប់រំ ការងារ មុខរបរ ថែទាំ សុខភាព នយោបាយ សិល្បៈ កីឡា និង សេវា សង្គម នានា ដោយ ស្មើភាព ស្មើ សិទ្ធិ បរិយា បន្ន និង សេចក្តីថ្លៃថ្នូរ ក្នុង សង្គម ដើម្បី បន្ត ជំរុញ ដល់ ការអភិវឌ្ឍ លើ វិស័យ ពិការ ភាព ឱ្យ បាន ខ្លាំងក្លា ថែម ទៀត ។
