( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ លោក ឡេង ប៊ុន តេង ទីប្រឹក្សា សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា ជាតិ នៃ កម្ពុជា និង លោក ម៉ូវ ម៉ានិត អភិបាល ខណ្ឌ សែនសុខ បាន ដឹកនាំ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ ចុះ សំណេះសំណាល និង ព្យាបាល ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ តាម ខ្នង ផ្ទះ ព្រមទាំង បាន នាំយក អំណោយ ជា ថ្នាំ ពេទ្យ អង្ករ មី និង ត្រី ខ ព្រមទាំង សម្ភារ មួយចំនួន ទៀត ។
លោក ឡេង ប៊ុន តេង បាន សំណេះសំណាល និង ផ្តាំផ្ញើ ឲ្យ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម ទាំងអស់ គ្នា ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការថែរក្សា សុខ សន្តិភាព និង ស្ថេរភាព សង្គម ដែល ជា មូលដ្ឋានគ្រឹះ លើ គ្រប់ វិស័យ ដែល បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការអភិវឌ្ឍន៍ ប្រទេសជាតិ ឲ្យ រីកចម្រើន ជាពិសេស នាំមក នូវ ភាព សុខសាន្ត ដល់ ប្រជាពលរដ្ឋ របស់ យើង ។ ប្រសិនបើ ប្រទេសជាតិ គ្មាន សុខ សន្តិភាព ទេ គឺ គ្មាន ការអភិវឌ្ឍន៍ ទេ លុះត្រាតែ មាន សុខ សន្តិភាព បរិបូណ៍ ពេញលេញ ទើប យើង មាន ពេល អភិវឌ្ឍន៍ ប្រទេស យើង ជីវភាព សំបូរ សប្បាយ ។
លោក ឡេង ប៊ុន តេង ក៏ សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល មិន ទាន់ ចាក់ វ៉ាក់សាំង ត្រូវ ទៅ ចាក់ វ៉ាក់សាំង ឲ្យបាន គ្រប់ ៗ គ្នា នៅ តាម មណ្ឌល សុខភាព ឬ មន្ទីរពេទ្យ បង្អែក និង សូមឲ្យ ចៅសង្កាត់ ទាំងអស់ ត្រូវ ផ្សព្វផ្សាយ ឲ្យបាន ទូលំទូលាយ ដល់ ប្រជាពលរដ្ឋ ៕ រដ្ឋបាល ខេត្ត កោះកុង ប្រាប់ ពលរដ្ឋ កាន់កាប់ ដី នៅលើក កោះ ទទឹង ក្នុង ឃុំ កោះ ស្តេច ស្រុក គីរីសាគរ ឱ្យ រុះរើ សំណង់ និង ចាកចេញ ពី ទីតាំង ដី នេះ ឱ្យ បាន ឆាប់ បំផុត
( កោះកុង) ៖ រដ្ឋបាល ខេត្ត កោះកុង បាន ជូន ដំណឹង ដល់ ប្រជាពលរដ្ឋ ដែល ពាក់ព័ន្ធ ការកាន់កាប់ ដី នៅលើក កោះ ទទឹង ភូមិ កោះ ស្តេច ឃុំ កោះ ស្តេច ស្រុក គីរីសាគរ សូម រុះរើ សំណង់ និង ចាកចេញ ពី ទីតាំង ដី នេះ ឱ្យ បាន ឆាប់រហ័ស បំផុត និង ឈប់ ទន្រ្ទាន កាន់កាប់ ដី រដ្ឋ ឬ ទិញ លក់ ដី រដ្ឋ តទៅទៀត បើ មិន ដូច្នោះ ទេ នឹង ត្រូវ ប្រឈមមុខ ចំពោះ ច្បាប់ ជា មិន ខាន ។
រដ្ឋបាល ខេត្ត បាន ឱ្យដឹង ថា តាម ការពិនិត្យ ជាក់ស្តែង បច្ចុប្បន្ន មាន ប្រជាពលរដ្ឋ មួយចំនួន បាន កាន់កាប់ ដី និង រស់ នៅ លើ កោះ ទទឹង ជា ទីតាំង ដែល រាជ រដ្ឋាភិបាល អនុញ្ញាតឱ្យ ក្រុមហ៊ុន វិនិយោគ ៕
អ្នកជំនាញ សិក្សា ផ្នែក អាស៉ី រូប នេះ តាមរយៈ បទសម្ភាស ផ្ទាល់ នៅ ខេត្ត ព្រះសីហនុ បាន បញ្ជាក់ ច្បាស់ ៗ ថា បន្ទាប់ពី បាន បំពេញ ទស្សនកិច្ច ចប់ សព្វគ្រប់ ហើយ នោះ លោក មើលឃើញ ថា គ្មាន មូលដ្ឋាន កងទ័ព ចិន និង គ្មាន នាវា របស់ ចិន មួយ គ្រឿង ណា នៅ មូលដ្ឋាន សមុទ្រ រាម ខេត្ត ព្រះសីហនុ ដូច ការចោទប្រកាន់ កាលពី ពេល កន្លងទៅ នោះ ទេ ។
លោក បាន អះអាង ទៀត ថា មូលដ្ឋាន សមុទ្រ រាម មិន មាន លទ្ធភាព គ្រប់គ្រាន់ សម្រាប់ បង្ក លក្ខណៈ ឲ្យ កងទ័ព ចិន ឬ នាវា ចម្បាំង ចិន ចូល បោះ ទីតាំង នោះ ទេ ។ លោក បន្ថែម ទៀត ថា បើ និយាយ ពី ស្ថានភាព ទឹក វិញ នៅ ទីនេះ ទឹក រាក់ មិន សាកសម សម្រាប់ នាវា មុជទឹក ធ្វើ ប្រតិបត្តិការ យោធា នោះ ឡើយ ។
ដោយឡែក សម្រាប់ ផ្នែក ប្រតិបត្តិការ វិញ គឺ កាន់តែ មិន មាន ន័យ ទៅ ទៀត ព្រោះថា ឈូង សមុទ្រ ថៃ ហាក់ដូចជា មិន មាន ជម្រៅ ជ្រៅ សម្រាប់ នាវា មុជទឹក ប្រតិបត្តិការ នោះ ទេ ហើយ ប្រសិន នាវា នៅ ខាងលើ ទឹក វិញ វា ក៏ ងាយស្រួល ដោយ គេ អាច ចាប់ បាន និង ធ្វើ ប្រតិបត្តិការ កម្ទេច បាន ជាដើម ។ សម្រាប់ ភូមិសាស្ដ្រ នយោបាយ វិញ ចំណុច ទាំងអស់ នេះ ប្រសិនបើ មាន វត្តមាន មែន នោះ នឹង បណ្ដាលឲ្យ មាន ជម្លោះ ផ្សេង ៗ កាន់តែ ធំ ថែម ទៀត » ។
ជាមួយគ្នា នេះ លោក បាន អះអាង ថា មូលដ្ឋាន កងទ័ព សមុទ្រ រាម គឺជា មូលដ្ឋាន កងទ័ព យ៉ាង ពិតប្រាកដ របស់ កម្ពុជា គ្មាន កងទ័ព ផ្សេង មក បោះ ទីតាំង ដូច ការចោទប្រកាន់ នោះ ឡើយ បន្ទាប់ពី លោក បាន ទស្សនកិច្ច ដោយ ផ្ទាល់ នៅ ទីនេះ ។
បន្ថែម ពី នេះ លោក ក៏ បាន កត់សម្គាល់ អំពី ស្ថានភាព ទូទៅ នៅ ខេត្ត ព្រះសីហនុ ថា មាន តំបន់ ឆ្នេរ ដ៏ ស្រស់ស្អាត ហើយក៏ ជា មជ្ឈមណ្ឌល ទេសចរណ៍ កម្សាន្ដ មួយ ដ៏ សំខាន់ របស់ ប្រទេស កម្ពុជា ហើយ លោក រំពឹង ថា នឹង មាន ពេលវេលា ច្រើន ដើម្បី បាន ស្គាល់ និង កម្សាន្ដ នៅ ខេត្ត ព្រះសីហនុ ៕
បើ តាម លោកស្រី Simao ការពន្យារ ពេលនេះ គឺ ដោយសារ បញ្ហា មួយចំនួន ដែល បាន លេចឡើង ក្រោយ វិបត្តិ សង្រ្គាម រវាង រុស្ស៉ី និង អ៊ុយក្រែន ដូចជា ការកក់ ជើង ហោះហើរ និង ការប្រើប្រាស់ ក្រេឌីត កាត ជាដើម បូករួម ជាមួយ បញ្ហា ផ្សេង ៗ ទៀត ទាក់ទង នឹង ការធ្វើ ប្រតិបត្តិការ ។
អាជ្ញាធរ នៅ សហរដ្ឋ អាមេរិក បាន ចោទប្រកាន់ ថា អតីត មេដឹកនាំ ស្តាំ និយម រូប នេះ មាន ជាប់ពាក់ព័ន្ធ ក្នុង បណ្តាញ ជួញដូរ គ្រឿងញៀន កាលពី ចន្លោះ ឆ្នាំ ២០០៤ - ២០២២ ។ លោក ហឺ ណាន់ ដេស វ័យ ៥៣ ឆ្នាំ ក៏ ត្រូវបាន ចោទប្រកាន់ ពី បទ ទទួល សំណូក ក្នុង ទំហំ ទឹកប្រាក់ រាប់ លាន ដុល្លារ ដើម្បី ការពារ អ្នក ជួញដូរ គ្រឿងញៀន ពី ការស៉ើប អង្កេត និង កាត់ទោស ផងដែរ ព្រមទាំង ពី បទ ប្រើប្រាស់ ឬ ក៏ ជួយ ជ្រោមជ្រែង និង លើកទឹកចិត្ត ដល់ ការប្រើប្រាស់ អាវុធ ។
សូម ជម្រាប ថា នៅ រសៀល ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ អគ្គ មេបញ្ជាការ កងទ័ព អាស៊ាន ទាំង ១០ ប្រទេស បាន បិទ បញ្ចប់ កិច្ចប្រជុំ របស់ ខ្លួន បន្ទាប់ពី បាន ពិភាក្សា ផ្លាស់ប្តូរ ទស្សនៈ និង អនុម័ត លើ ឯកសារ មួយចំនួន ។
កូរ៉េ ខាងជើង ស្ងាត់ មាត់ ឱ្យ ឈឹង ក្រោយ ការធ្វើតេស្ត មីស៉ីល ដែល កូរ៉េ ខាងត្បូង អះអាង ថា ទទួលបរាជ័យ
កាលពី ព្រឹក ថ្ងៃពុធ សប្តាហ៍ នេះ កូរ៉េ ខាងជើង ធ្វើការ បាញ់ សាកល្បង បាញ់ មីស៉ីល មួយ គ្រាប់ ដែល ជប៉ុន ជឿជាក់ ថា ជា មីស៉ីល ផ្លោង បាលីស្ទី គ ហើយ បើ តាម យោធា កូរ៉េ ខាងត្បូង វិញ នោះ គឺ វា បាន ផ្ទុះ នៅលើ អាកាស ក្រោយ បាញ់ បង្ហោះ ឡើង បាន តែ មួយ ភ្លែត ប៉ុណ្ណោះ ចេញ ពី មូលដ្ឋាន មួយ កន្លែង ស្ថិត នៅ ជាយ រដ្ឋធានី ព្យុងយ៉ាង របស់ ប្រទេស កូរ៉េ ខាងជើង ។
គួរ បញ្ជាក់ ថា ក្រោយ ការអះអាង ថា របស់ កូរ៉េ ខាងត្បូង មកទល់ ថ្ងៃព្រហស្បតិ៍ នេះ គេ មិន ទាន់ ឃើញ រដ្ឋាភិបាល កូរ៉េ ខាងជើង ចេញមុខ ធ្វើ ការអត្ថាធិប្បាយ ជុំវិញ រឿង នេះ នៅឡើយ ទេ ហើយ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ របស់ កូរ៉េ ខាងជើង ក៏ មិន បាន ចុះផ្សាយ អំពី ការធ្វើតេស្ត មីស៉ីល ដែល បាន ប្រព្រឹត្តទៅ កាលពី មួយ ថ្ងៃ មុន ដូច រាល់ ដង នោះ ដែរ ៕
( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន រៀបចំ បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២២ ក្រោម អធិបតីភាព លោក មាស សុភា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ ។
ក្នុង នោះ ក៏ មាន ការចូលរួម ពី លោក ងី ច័ន្ទ ផល រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង លោក ឡុង សុវណ្ណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រះវិហារ ក៏ ដូចជា ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ខេត្ត ព្រះវិហារ ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត លោក អភិបាល ក្រុង ស្រុក មេឃុំ ចៅសង្កាត់ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី មាស សុភា បាន ថ្លែង នាំមក នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក៏ ដូចជា សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ដែល ជានិច្ច ជាកាល តែង យកចិត្តទុកដាក់ គិតគូរ ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ។
លោក ទេសរដ្ឋមន្ត្រី មាស សុភា បាន ថ្លែង ទៀត ថា មកដល់ ឆ្នាំ ២០២២ នេះ ស្ថានភាព ជំងឺ កូវីដ - ១៩ នៅតែ បន្ត ឆ្លង រាលដាល គួរឲ្យ ព្រួយបារម្ភ ជាពិសេស មេរោគ កូវីដ - ១៩ បំប្លែង ខ្លួន ថ្មី ប្រភេទ អូរ មី ក្រុង បាន និង កំពុងតែ ឆ្លង រីករាលដាល ក្នុង សហគមន៍ នៅ តាម បណ្តាល រាជធានី ខេត្ត ក្នុង នោះ រួម មាន ខេត្ត ព្រះវិហារ ផងដែរ ។
ផ្អែក លើ បញ្ហា ប្រឈម ជា សកល ខាងលើ និង ផ្អែក តាម ទិសដៅ ការងារ ឆ្នាំ ២០២២ ដែល បាន ឯកភាព ក្នុង អង្គ សន្និបាត នេះ ក្នុង នាម រាជ រដ្ឋាភិបាល លោក ទេសរដ្ឋមន្ត្រី មាស សុភា បាន ផ្តល់ នូវ គោលការណ៍ ជា គន្លឹះ ដូច ខាងក្រោម៖
បទ អត្ថាធិប្បាយ៖ « ស្តង់ដា ពីរ ចំពោះ បញ្ហា ជនភៀសខ្លួន » ដែល សហរដ្ឋ អាមេរិក និង ប្រទេស លោក ខាងលិច បាន អនុវត្ត គឺ គ្មាន ចិត្ត ធម៌ សោះ
គួរ បញ្ជាក់ ផងដែរ ថា ចាប់ពី វិបត្តិ ស៊ីរី កាលពី ១១ឆ្នាំ មុន រហូតដល់ វិបត្តិ អ៊ុយក្រែន នា ពេល បច្ចុប្បន្ន នេះ វាសនា របស់ ពួក ជនភៀសខ្លួន គួរឱ្យ ឈឺចាប់ ណាស់ ។ អ្នកនយោបាយ និង ប្រព័ន្ធ សារព័ត៌មាន របស់ អាមេរិក និង លោក ខាងលិច ដែល តែងតែ ឃោសនា បំប៉ាង ពី សមភាព និង យុត្តិធម៌ ទាំងនោះ គួរ លះបង់ ចោល ភាព ក្រអឺត ក្រទម និង ទស្សនៈ លម្អៀង របស់ ពួកគេ ក៏ ដូចជា ប្រកាន់ ឥរិយាបថ ត្រឹមត្រូវ ចំពោះ ទុក្ខវេទនា និង ការចោទប្រកាន់ របស់ ជនភៀសខ្លួន នៅ មជ្ឈិមបូព៌ា ហើយ បញ្ឈប់ លេង កល ល្បិច ដែល អនុវត្ត ស្តង់ដារ ពីរ » ភ្លាម ៕
លោក នង វាសនា តំណាងរាស្ត្រ កំពង់ធំ ផ្តល់ បង្គោល ភ្លើង និង អំពូល សូឡា បំភ្លឺ ផ្លូវ ៤៥ ឈុត នៅ ទីប្រជុំជន ក្នុង ឃុំ ចំនួន ៤នៃ ស្រុក សណ្តាន់ និង ស្រុក ប្រាសាទ បល្ល័ង្ក
( កំពង់ធំ )៖ នៅ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ លោក នង វាសនា តំណាងរាស្រ្ត មណ្ឌល កំពង់ធំ និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ស្រុក សណ្តាន់ បាន ផ្តល់ បង្គោល ភ្លើង បំភ្លឺ តាម ផ្លូវ និង អំពូល សូឡា ចំនួន ៤៥ ឈុត បន្ថែម ទៀត ជូន ក្រុមការងារ ដើម្បី ដាក់ បំភ្លឺ នៅ ទីប្រជុំជនជា ប្រយោជន៍ សាធារណៈ នៅ ឃុំ ទួល គ្រើ ល និង សាលា វិស័យ ស្រុក ប្រាសាទ បល្ល័ង្ក និង ឃុំ ក្លែង និង ឃុំងន ស្រុក សណ្ឋាន់ ខេត្ត កំពង់ធំ ។
ក្នុង ឱកាស ប្រគល់ បង្គោល ភ្លើង និង អំពូល សូឡា បំភ្លឺ ផ្លូវ នេះ លោក នង វាសនា បាន ថ្លែងអំណរគុណ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ពិសេស គណបក្ស ប្រជាជន កម្ពុជា ដែល ផ្តល់ សន្តិភាព និង ការអភិវឌ្ឍន៍ ដែល មាន មោទនភាព លើក មុខមាត់ កម្ពុជា ឲ្យ ស្មើ មុខ ស្មើ មាត់ លើ ឆាក អន្តរជាតិ និង ផ្តល់ ឱកាស ឲ្យ ប្រជាជន កម្ពុជា ប្រកបរបររកស៊ី សម្រាប់ អនាគត ដ៏ ល្អ នៅ ថ្ងៃ ខាងមុខ ។
លោក បាន អំពាវនាវ ដល់ បង ប្រជាជន សូម ចូលរួមគ្នា ស្រលាញ់ និង ថែរក្សា សន្តិភាព នេះ អោយ បាន គង់វង្ស រាប់ រយ ឆ្នាំ ទៀត ក្រោម ម្លប់ នៃ គណបក្ស ប្រជាជន កម្ពុជា ។
សូម ជម្រាប ថា ដើម្បី ជា ប្រយោជន៍ សាធារណៈ ពិសេស បង្ក ភាពងាយស្រួល ដល់ ប្រជាពលរដ្ឋ ធ្វើដំណើរ នៅ ពេល យប់ លោក នង វាសនា បាន ឧបត្ថម្ភ បង្គោល ភ្លើង បំភ្លឺ តាម ផ្លូវ និង អំពូល សូឡា ជាច្រើន មកហើយ ដើម្បី ដាក់ តាម ទីប្រជុំជន ក្នុង ស្រុក សណ្តាន់ ៕
ក្រសួង ការបរទេស ចិន ថ្លែង ម្តង ទៀត ជុំវិញ ករណី មន្ទីរពិសោធន៍ ជីវសាស្ត្រ របស់ អាមេរិក នៅ អ៊ុយក្រែន៖ « អាមេរិក មាន កាតព្វកិច្ច ឆ្លើយតប ចំពោះ ការយកចិត្តទុកដាក់ របស់ សហគមន៍ អន្តរជាតិ »
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា សូម ជំរុញ ឱ្យ បុគ្គលិក អប់រំ អ្នកសិក្សា មាតាបិតា គ្រប់ ភាគី ពាក់ព័ន្ធ រួមទាំង បងប្អូន ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស បន្ត ចាក់ វ៉ាក់សាំង ជំងឺ កូវីដ - ១៩ ដូស ជំរុញ ឱ្យ បាន គ្រប់ ៗ គ្នា និង បន្ត អនុវត្ត វិធានការ ៣កុំ ៣ការពារ ស្រប តាម វិធាន សុខាភិបាល និង ការណែនាំ របស់ រាជ រដ្ឋាភិបាល ដើម្បី និរន្តរភាព នៃ ការបើក ដំណើរការសង្គម - សេដ្ឋកិច្ច តាម គន្លង ប្រក្រតី ភាព ថ្មី ។
លោក រស់ សុវាចា អ្នកនាំពាក្យ ក្រសួង អប់រំ យុវជន និង កីឡា បាន បញ្ជាក់ ឲ្យដឹង នៅ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ ថា ការចាក់ វ៉ាក់សាំង គឺជា មូលដ្ឋាន ដ៏ សំខាន់ ដែល នាំឱ្យ មាន ការបើក ដំណើរការសង្គម - សេដ្ឋកិច្ច ឡើងវិញ និយាយ ជា រួម និង ជាពិសេស ការបើក ដំណើរការវិស័យ អប់រំ និយាយ ដោយឡែក ។
លោក ថា ព្រោះតែ លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស នៅ ទូទាំង ប្រទេស បាន ទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ដោយ ស្ម័គ្រចិត្ត គ្រប់ ៗ គ្នា ទើប រាជ រដ្ឋាភិបាល ហ៊ាន សម្រេច បើក សាលារៀន ឡើងវិញ ។ ផ្អែក តាម របាយការណ៍ របស់ មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី ខេត្ត គឺ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ភាគ ច្រើន បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ យ៉ាងហោចណាស់ ក្នុង ម្នាក់ បីដូស រួចរាល់ ។
ជាមួយគ្នា នេះ ក្រសួង អប់រំ សូម កោតសរសើរ និង ថ្លែងអំណរគុណ ចំពោះ លោកគ្រូ អ្នកគ្រូ សិស្ស - និស្សិត និង មាតាបិតា ដែល បាន ទៅ ទទួលយក ការចាក់ វ៉ាក់សាំង ដោយ ស្ម័គ្រចិត្ត ដើម្បី ចូលរួម បង្ការ ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ ។ ស្មារតី បែប នេះ ជា ការការពារ អាយុជីវិត ខ្លួន ឯង និង អ្នកដទៃ ពិសេស រវាង គ្រូ និង សិស្ស ដែល ត្រូវ ប្រាស្រ័យទាក់ទង គ្នា ៕ ខេត្ត កំពង់ធំ បិទ ការប្រេកួត កីឡា សិស្ស បឋមសិក្សា ជ្រើសរើស ជើងឯក ឆ្នាំ សិក្សា ឆ្នាំ ២០២១ - ២០២២
( កំពង់ធំ )៖ ខេត្ត កំពង់ធំ បាន រៀបចំ បិទ ការប្រកួត កីឡា សិស្ស បឋមសិក្សា ឆ្នាំ ២០២១ - ២០២២ នៅ សាលា បឋមសិក្សា អនុវត្តន៍ ហ៊ុន សែន អាចារ្យលាក់ ក្រោម វត្តមាន លោក តាន់ ប៊ុន ហុង ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ដោយ មាន ការចូលរួម ពី លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ជា កីឡាករ - កីឡាការិនី ជិត ៤០០ នាក់ នា រសៀល ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២២ ។
លោក ឃឹម សេង ប្រធាន ការិយា័យ កីឡា នៃ មន្ទីរ អប់រំ យុវជន និង កកីឡា ខេត្ត កំពង់ធំ បាន លើកឡើង ពី ចំនួន កីឡាករ ចូលរួម ប្រកួត ជ្រើសរើស ជើងឯក គឺ មាន ចំនួន ៣៤៦ នាក់ ស្រី ១០៤ នាក់ ដែល មកពី ៩ ក្រុង ស្រុក ទូទាំង ខេត្ត ក្នុង នោះ ប្រភេទ បាល់ទាត់ មាន០ ក្រុម ស្មើ ១៦២ នាក់ ស្រី ៣៦ នាក់ បាល់ ទះ មាន ៨ក្រុម ស្មើ ១០៨ នាក់ ស្រី ៣៦ នាក់ បាល់បោះ មាន ៣ ក្រុម ស្មើ ៣៦ នាក់ ស្រី ១២នាក់ និង អត្តពលកម្ម មាន ១០ ក្រុម ស្មើ ៤០ នាក់ ស្រី ២០ នាក់ ។
លោក បាន បន្ត ទៀត ថា ការប្រកួត នេះ មាន រយៈពេល ពីរ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៥ ដល់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២២ ដើម្បី ជ្រើសរើស យក កីឡាករ ដែល ល្អ សម្រាប់ យក ទៅ ប្រកួត នៅ ថា្នក់ ជាតិ នៅពេល ខាងមុខ ។
លោក តាន់ បុន ហុង បាន ផ្តាំផ្ញើ ដល់ កីឡាករ កីឡាការិនី ទាំងអស់ ត្រូវ បញ្ចេញ សមត្ថភាព ឱ្យ អស់ ដើម្បី ទទួលបាន ជោគជ័យ ជូន សាលារៀន ក៏ដូចជា ស្រុក របស់ ខ្លួន ការប្រកួតប្រជែង មិន មែន តែ ប្រើ កំលាំង បាយ នោះ ទេ គឺ ត្រូវ ប្រើ លក្ខណៈ បច្ចេកទេស ត្រូវ មាន ការយោគយល់ អធ្យាស្រ័យ គ្នា គោរព តាម បទបញ្ជា ផ្ទៃក្នុង ធ្វើ ការួបរួម គ្នា សាមគ្គី គ្នា ឈ្នះ ដោយ កិត្តិយស ចាញ់ ដោយ កិត្តិយស ។
លោក បាន ផ្តាំផ្ញើ ដល់ កីឡាករ ទាំងអស់ ត្រូវ ចៀស ឱ្យ ឆ្ងាយ ពី គ្រឿងញៀន ព្រោះ គ្រឿង ញឿន វា បំផ្លាញ អនាគត របស់ យើង ត្រូវ គោរព ច្បាប់ ចរាចរណ៍ និង ត្រូវ ខិតខំ រៀនសូត្រ ដើម្បីឱ្យ ក្លាយជា ពលរដ្ឋ ល្អ ក្នុង ការបម្រើ សង្គមជាតិ និង បន្ត ចូលរួម អនុវត្ត នូវ វិធានការ « ៣កុំ និង ៣ការពារ » ឱ្យ បាន គ្រប់ ៗ គ្នា ។
គួរ បញ្ជាក់ ថា លទ្ធផល ទទួបាន រួម មាន៖
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី១៧ ខែមីនា ឆ្នាំ ២០២២ ក្រោម អធិបតីភាព លោក មាន សទិ សមាជិក គ.ជ. ប និង ជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ ដើម្បី ផ្សព្វផ្សាយ អំពី ការបិទ ផ្សាយ បញ្ជី បេក្ខជន ដំបូង នៅ គណៈកម្មការ ឃុំ សង្កាត់ រៀបចំ ការបោះឆ្នោត ( គឃ.សប ) និង ការដាក់ ការទទួល និង ការដោះស្រាយ ពាក្យ បណ្តឹង ជំទាស់ លើ បញ្ជី បេក្ខជន ដំបូង ។
លោក មាន សទិ បាន ថ្លែង ថា ការបិទ ផ្សាយ បញ្ជី បេក្ខជន ដំបូង គឺ ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ដែល មាន សិទ្ធិ បោះឆ្នោត ក្នុង ឃុំ សង្កាត់ ប្តឹង ជំទាស់ ជា លាយលក្ខណ៍ អក្សរ ទៅ គ.ជ. ប អំពី បេក្ខជន ឬ បញ្ជី បេក្ខជន ដំបូង នៃ គណបក្ស នយោបាយ ណាមួយ ក្នុង រយៈពេល យ៉ាង យូរ ៣ ថ្ងៃ បន្ទាប់ពី ថ្ងៃ បិទ ផ្សាយ នេះ ។ ការបិទ ផ្សាយ បញ្ជី បេក្ខជន ដំបូង អាច ធ្វើឡើង តាម កាលបរិច្ឆេទ ផ្សេង ៗ គ្នា អាស្រ័យ លើ ករណី មាន ឬ គ្មាន បណ្ដឹង កើតឡើង ក្នុង អំឡុង ពេល ចុះបញ្ជី បេក្ខជន នៃ គណបក្ស នយោបាយ នៃ ឃុំ សង្កាត់ នីមួយ ៗ ។
ទាក់ទង នឹង ការប្តឹង ជំទាស់ ទៅនឹង បេក្ខជន ឬ ជំទាស់ ទៅនឹង បញ្ជី បេក្ខជន ដំបូង នៃ គណបក្ស នយោបាយ ណាមួយ លោក មាន សទិ បាន បញ្ជាក់ ថា ពាក្យបណ្តឹង ជំទាស់ នេះ អាច ធ្វើឡើង ក្នុង ករណី បេក្ខជន ឬ បញ្ជី បេក្ខជន ដំបូង នៃ គណបក្ស នយោបាយ ណាមួយ មិន បំពេញ បាន តាម លក្ខខណ្ឌ ដូច មាន ចែង ក្នុង មាត្រា ៣៥ មាត្រា ៣៦ មាត្រា ៣៧ មាត្រា ៣៩ មាត្រា ៤០ មាត្រា ៤១ និង មាត្រា ៤២ នៃ ច្បាប់ ស្តីពី ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ។
លោក មាន សទិ បាន បន្ថែម ទៀត ថា ប្រសិនបើ ក្នុង ឃុំ សង្កាត់ ណា គ្មាន ពាក្យបណ្តឹង ជំទាស់ ទៅ លើ បញ្ជី បេក្ខជន ដំបូង នៃ គណបក្ស នយោបាយ ណាមួយ ទេ នោះ បញ្ជី បេក្ខជន ដំបូង ក្នុង ឃុំ សង្កាត់ នោះ នឹង ក្លាយទៅជា បញ្ជី បេក្ខជន ផ្លូវការ ។ បន្ទាប់មក គណៈកម្មការ ឃុំ សង្កាត់ រៀបចំ ការបោះឆ្នោត នៃ ឃុំ សង្កាត់ នោះ ត្រូវ ធ្វើ ការចាប់ឆ្នោត ដើម្បី កំណត់ លំដាប់ លេខរៀង គណបក្ស នយោបាយ ដែល នឹង ត្រូវ ដាក់ លើ សន្លឹក ឆ្នោត ស្រប តាម បទបញ្ជា និង នីតិវិធី របស់ គ.ជ.ប ។
( បន្ទាយមានជ័យ )៖ កម្លាំង វរសេនា តូច នគរបាល ការពារ ព្រំដែន គោក លេខ ៨១៥ ឈរ ជើង នៅ ស្រុក ម៉ាឡៃ បាន ឃាត់ខ្លួន ពលករ ខ្មែរ ចំនួន ១៣០ នាក់ ដែល ឆ្លង ដែន ពី ប្រទេស ថៃ តាម ច្រក របៀង ។ បន្ទាប់ពី ឃាត់ខ្លួន មន្ត្រី ជំនាញ បាន យក ពួកគាត់ យក ទៅ ធ្វើតេស្តរហ័ស រក ជំងឺ កូវីដ១៩ ប៉ុន្តែ លទ្ធអវិជ្ជមាន ទាំងអស់ ។
លោក វរសេនីយ៍ ត្រី ប៊ុន គុន នាយ ប៉ុស្តិ៍ បាន សហការ ជាមួយ កម្លាំង ផ្នែក សឹក រង ស្រុក ម៉ាឡៃ និង កម្លាំង ប៉ុស្ដិ៍ រដ្ឋបាល ឃុំ បឹង បេង បាន ណែនាំ ដល់ ពលករ ទាំងអស់ ពី ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ និង ធ្វើ ការត្រួតពិនិត្យ រថយន្ត ដឹក ទំនិញ ឆ្លងកាត់ និង ណែនាំ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ដែល ចេញ ចូល នៅ ច្រកទ្វារ តំបន់ ម៉ាឡៃ ត្រូវ ចេះ ការពារ ការរាលដាល នៃ ជំងឺ កូវីដ ផងដែរ ។
ពលករ ខ្មែរ ទាំង ១៣០ នាក់ ក្រោយពី ធ្វើ កិច្ចសន្យា រួច ត្រូវបាន អនុញ្ញាតឱ្យ វិលត្រឡប់ ទៅ លំនៅដ្ឋាន វិញ រៀង ៗ ខ្លួន វិញ ៕ អូស្រ្តាលី ព្រមាន ដាក់ទណ្ឌកម្ម ចិន ប្រសិនបើ ផ្តល់ ជំនួយ ផ្នែក យោធា ដល់ រុស្ស៉ី
នៅពេល ត្រូវបាន សួរ ថា តើ មាន ការត្រៀម ដាក់ទណ្ឌកម្ម ណាមួយ ទៅ លើ ប្រទេស ចិន ដែរ ឬ ទេ ជុំវិញ ការ ដែល ទីក្រុង ប៉េកាំង បដិសេធ ថ្កោល ទោស ប្រតិបត្តិការ យោធា របស់ ទីក្រុង មូស្គូ ដែល កំពុង បន្ត នៅ អ៊ុយក្រែន នោះ . លោក នាយក រដ្ឋមន្រ្តី អូស្រ្តាលី បាន ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន ថា អូស្រ្តាលី នឹង ចូលរួម ជាមួយ សម្ព័ន្ធមិត្ត ក្នុង ការដាក់ទណ្ឌកម្ម លើ ចិន ។
លោក បន្ថែម ថា « យើង នឹង បោះជំហាន ដូចគ្នា ជាមួយ ដៃគូ និង សម្ព័ន្ធមិត្ត របស់ យើង លើ បញ្ហា នេះ ហើយ សហរដ្ឋ អាមេរិក ក៏ ធ្លាប់ បាន ចេញ សេចក្តីថ្លែងការណ៍ មួយចំនួន យ៉ាង ច្បាស់ ទាក់ទង រឿង នេះ ផងដែរ ដោយ យើង គាំទ្រ ចំពោះ សេចក្តីថ្លែងការណ៍ ទាំងនោះ » ។ លោក ម៉ូរី ស សុន បាន អំពាវនាវ ដល់ « ពិភពលោក ទាំងមូល ឲ្យ បញ្ឈប់ អំពើហិង្សា និង ការវាយប្រហារ ដ៏ អាក្រក់ របស់ រុស្ស៊ី នៅ អ៊ុយក្រែន » ។
ជាមួយគ្នា លោក នាយក រដ្ឋមន្រ្តី អូស្រ្តាលី បាន ទទូច ឲ្យ ទីក្រុង ប៉េកាំង ត្រូវតែ មាន « តម្លាភាព បំផុត » អំពី ចំណង ទាក់ទង របស់ ខ្លួន ជាមួយ ទីក្រុង មូស្គូ ដូចជា លទ្ធភាព នៃ ការជួយ សង្រ្គោះ ផ្នែក សេដ្ឋកិច្ច ឬ ក៏ ការជួយជ្រោមជ្រែង ផ្នែក យោធា ដល់ ប្រទេស រុស្ស៉ី ជាដើម ។
ការអត្ថាធិប្បាយ របស់ លោក នាយក រដ្ឋមន្រ្តី អូស្រ្តាលី នេះ គឹស្រដៀង គ្នា ទៅនឹង សេចក្តីថ្លែងការណ៍ របស់ ទីក្រុង វ៉ាស៊ីនតោន ដែរ ដែល បាន ព្រមាន អំពី « ផលវិបាក ធ្ងន់ធ្ងរ » សម្រាប់ ប្រទេស ចិន ប្រសិនបើ មាន ការផ្តល់ ជំនួយ ផ្នែក យោធា ឬ សេដ្ឋកិច្ច ណាមួយ ដល់ ទីក្រុង មូស្គូ ។
គួរ បញ្ជាក់ ថា ចំពោះមុខ ការសង្ស័យ ទាំងនេះ មន្រ្តី ទីក្រុង ប៉េកាំង បាន ច្រានចោល ការចោទប្រកាន់ ច្បាស់ ៗ ហើយ ថា ពួក វា ជា « ព័ត៌មាន មិន ពិត » ហើយ វាយ បក ទៅកាន់ សហរដ្ឋ អាមេរិក ថា កំពុង ព្យាយាម បំភ្លៃ ព័ត៌មាន ដើម្បី ទម្លាក់ កំហុស ទៅ លើ ចិន ៕
ស្នងការ នគ បាល ខេត្ត បន្ទាយមានជ័យ ប្រារព្ធ ពិធី សែន ក្រុង ពាលី បញ្ចុះ បឋមសិលា សាងសង់ ស្លាក ស្នងការដ្ឋាន នគរបាល ថ្មី
( បន្ទាយមានជ័យ )៖ លោក ឧត្តមសេនីយ៍ ទោ សិទ្ធិ ឡោះ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ រួម ជាមួយ ថ្នាក់ដឹកនាំ ស្នងការដ្ឋាន នគរបាល ខេត្ត បាន ប្រារព្ធ ពិធី សែន ក្រុង ពាលី បញ្ចុះ បឋមសិលា សាងសង់ ស្លាក ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ថ្មី ។
ពិធី ក៏ មាន ការចូលរួម លោក លោកស្រី ស្នងការ រង នាយ នាយ រង ការិយាល័យ និង មន្ត្រី ក្រោម ឱវាទ ជាច្រើន រូប នា ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២២ ។
ការសាងសង់ ស្លាក ថ្មី ឡើងវិញ ដើម្បី សម្គាល់ ឈ្មោះ អង្គភាព និង បង្ក លក្ខណៈ ងាយស្រួល ដល់ ប្រជាពលរដ្ឋ ស្ថាប័ន ពាក់ព័ន្ធ ងាយ ប្រាស្រ័យទាក់ទង ការងារ ។ លើស ពី នេះ ក៏ ជា ការរួម សាមគ្គី គ្នា សាង សមិទ្ធផល ថ្មី ដើម្បី បន្សល់ទុក ស្នាដៃ ដល់ មនុស្ស ជំនាន់ ក្រោយ ។
ក្រៅពី ធ្វើ ស្លាក ថ្មី . លោក ឧត្តមសេនីយ៍ ទោស្នងការ ក៏ បាន កំពុង សាងសង់ អគារ បណ្ណាល័យ ចំណត រថយន្ត ខ្នាត ធំ សួនច្បារ និង បាន ដាំ ឈើ ដាំ ផ្កា បែប ធម្មជាតិ ជាច្រើន ប្រភេទ ដើម្បី លើកកម្ពស់ សោភ័ណភាព កន្លែង ធ្វើការ ផងដែរ ៕ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង បើក កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២១ និង លើក ទិសដៅ អនុវត្ត បន្ត ឆ្នាំ ២០២២
( បាត់ដំបង ) ៖ លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាន ដឹកនាំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២១ និង លើក ទិសដៅ អនុវត្ត បន្ត ឆ្នាំ ២០២២ របស់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក លោកស្រី អនុប្រធាន សមាជិក សមាជិកា គណៈកម្មាធិការ សាខា អនុសាខា ក្រុង . ស្រុក ទាំង ១៤ មន្ត្រី ក្រុម ប្រតិបត្តិ សាខា ទីប្រឹក្សា យុវជន កាកបាទ ក្រហម កម្ពុជា នា រសៀល ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២២ ម្សិលមិញ ។
លោក សុខ លូ បាន ណែនាំ ដល់ មន្រី្ត ប្រតិបត្តិ សាខា សូម ចូលរួម បន្ត អនុវត្ត រាល់ សកម្មភាព ការងារ វិស័យ ស្នូល ទាំង៤ របស់ កាកបាទ ក្រហម កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ឱ្យ បាន កាន់តែ ល្អ ប្រសើរ និង សកម្ម ផុល ផុស ហើយ ប្រមូលផ្តុំ កម្លាំង មនុស្សធម៌ ដើម្បី ចូលរួម លើកកម្ពស់ ជីវភាព របស់ ជន ងាយ រងគ្រោះ បំផុត និង ជនរងគ្រោះ តាមរយៈ វិស័យ អាទិ៍ ភាព ចំនួន ៤ រួម មាន៖
* ការគ្រប់គ្រង គ្រោះមហន្តរាយ និង ការប្រែប្រួល អាកាសធាតុ * សុខភាព និង ការថែទាំ សុខភាព ក្នុង សហគមន៍ *ការលើកកម្ពស់ គោលការណ៍ គ្រឹះ និង តម្លៃ មនុស្សធម៌ * ការអភិវឌ្ឍ ស្ថាប័ន ម៉្យាងទៀត ត្រូវ បន្ត ជួយ ដល់ ជនរងគ្រោះ ដោយ ប្រការ ផ្សេង ៗ ជន ងាយ រងគ្រោះ នៅ តាម មូលដ្ឋាន ដូចជា អ្នក ផ្ទុក មេរោគ អេដស៍ ចាស់ជរា គ្មាន ទីពឹង កុមារ កំព្រា ធ្វើ ផ្ទះ ជូន ជន ទីទ័ល ក្រ ជាដើម
ប្រមុខរដ្ឋ ស្តីទី ចេញ ព្រះរាជ ក្រឹត្យ បញ្ចប់ តំណែង សមាជិក ក្រុមប្រឹក្សា អ្នក ច្បាប់ ចំនួន ៦រូប
សមាជិក ក្រុមប្រឹក្សា អ្នក ច្បាប់ ទាំង៦រូប នេះ រួម មាន៖
ទី១៖ លោក សួន វិសាល ទី៖ លោក សូរ ចាន់ ធីទី ៣៖ ពេជ្រ សូរិយា ទី ៤៖ លោក ផន ស៊ីន ទី ៥៖ លោក គង់ សំអុន និង ទី៦៖ លោក តុំ ប៊ុន ផាន់ ៕ ក្រសួង ទេសចរណ៍ ជូនដំណឹង ស្តីពី ការលុបចោល លក្ខខណ្ឌ តម្រូវ ឱ្យ អ្នកដំណើរ មកពី បរទេស បង្ហាញ លទ្ធផល តេស្ត PCR អវិជ្ជមាន និង លុបចោល ការធ្វើតេស្ត រហ័ស ពេល មកដល់ កម្ពុជា
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ នៅ រសៀល ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ដល់ ប្រតិបត្តិករ ទេសចរណ៍ ទេសចរ ជាតិ អន្តរជាតិ និង អ្នកដំណើរ ផ្សេង ៗ ទៀត ពី ក្រៅ ប្រទេស ទាំងអស់ មក កម្ពុជា ដែល បាន ទទួល ការចាក់ វ៉ាក់សាំង ពេញលេញ និង ដូស មូលដ្ឋាន ស្តីពី ការលុបចោល លក្ខខណ្ឌ តម្រូវ ឱ្យ អ្នកដំណើរ មកពី បរទេស បង្ហាញ លទ្ធផល តេស្ត PCR អវិជ្ជមាន និង លុបចោល ការធ្វើតេស្ត រហ័ស ពេល មកដល់ កម្ពុជា ។
នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ទេសចរណ៍ បាន ឱ្យដឹង ទៀត ថា ចាប់ពី ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ តទៅ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច ដូច ខាងក្រោម៖
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ទេសចរ ណ៍៖
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ៧៧ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ២២. ២១៧ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
រាជ រដ្ឋាភិបាល ចុះ កិច្ចព្រមព្រៀង ជាមួយ ក្រុមហ៊ុន សម្ព័ន្ធ ទូរទស្សន៍ កម្ពុជា ដើម្បី បង្កើត ក្រុមហ៊ុន ថ្នាល ទូរទស្សន៍ ឌីជីថល កម្ពុជា
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ចុះហត្ថលេខា លើ « កិច្ចព្រមព្រៀង ម្ចាស់ ភាគហ៊ុន រវាង រាជ រដ្ឋាភិបាល កម្ពុជា តំណាង ដោយ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ក្រុមហ៊ុន សម្ព័ន្ធ ទូរទស្សន៍ កម្ពុជា ឯ . ក ដើម្បី បង្កើត ក្រុមហ៊ុន ថ្នាល ទូរទស្សន៍ ឌីជីថល កម្ពុជា ឯ . ក » ។
ពិធី ចុះហត្ថលេខា នេះ បាន រៀបចំឡើង នា ថ្ងៃទី ១៧ ខែ មីនា ឆ្នាំ ២០២២ នៅ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ទទួលបាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ បណ្ឌិត អៀង ស៊ុន លី រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ជា តំណាង របស់ ភាគី រាជ រដ្ឋាភិបាល កម្ពុជា និង លោកស្រី ហ៊ុន ម៉ាណា ដែល ជា តំណាង ក្រុមហ៊ុន សម្ព័ន្ធ ទូរទស្សន៍ កម្ពុជា ឯ . ក ក៏ ដូចជា វត្តមាន របស់ ថ្នាក់ដឹកនាំ ព្រមទាំង មន្រ្តី ពាក់ព័ន្ធ របស់ ភាគី ទាំង ពីរ ជាច្រើន រូប ផ្សេង ទៀត ។
ការបង្កើត ថ្នាល ទូរទស្សន៍ ឌីជីថល នេះ ក៏ ជា លទ្ធផល នៃ ការប្តេជ្ញាចិត្ត ដ៏ មោះ មុត របស់ រាជ រដ្ឋាភិបាល ក្នុង ការអនុលោម តាម ឧត្តមានុវត្តន៍ នៃ បណ្តា ប្រទេស ក្នុង តំបន់ និង អនុសាសន៍ របស់ សហភាព ទូរគមនាគមន៍ អន្តរជាតិ (ITU) ។
ស្រប តាម គោលការណ៍ ដ៏ សំខាន់ ៗ ទាំងនេះ . រាជ រដ្ឋាភិបាល បាន កំណត់ យក ឆ្នាំ ២០២៣ ជា កាលបរិច្ឆេទ នៃ ការដាក់ ដំណើរការ ថ្នាល ទូរទស្សន៍ ឌីជីថល ជាតិ ដោយ តម្រូវ ឱ្យ ក្រុមហ៊ុន ទូរទស្សន៍ អាណាឡូក ឯកជន ទាំងអស់ ប្រើ - ប្រាស់ សេវា ថ្នាល ទូរទស្សន៍ ឌីជីថល កម្ពុជា និង បន្ត ការផ្សាយ ព្រម គ្នា (Simulcast) ជា ប្រព័ន្ធ អាណាឡូក និង ប្រព័ន្ធ ឌីជីថល ស្រប គ្នា រហូតដល់ ដំណាច់ ឆ្នាំ ២០២៥ ដែល ជា កាលបរិច្ឆេទ សម្រាប់ បិទ ការផ្សាយ ទូរទស្សន៍ តាម ប្រព័ន្ធ អាណា - ឡូក ជា ស្ថាពរ ៕
ជាមួយគ្នា នេះ ដែរ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន លើក ពី កាលពី អតីតកាល របស់ សម្តេច និង ថ្នាក់ដឹកនាំ ជាតិ ដែល បាន ធ្វើដំណើរ ចុះ តាម ខេត្ត ច្រើន ណាស់ ដើម្បី ដោះស្រាយ ការងារ និង ការកសាង ជាតិ ៕
ក្នុង អំឡុង ពេល ទស្សនកិច្ច លោក គីស៊ី ដា ហ្វូមី អូ នឹង អញ្ជើញ ដាក់ កម្រង ផ្កា គោរព វិញ្ញាណក្ខន្ធ នៅ វិមាន ឯករាជ្យ និង នៅ មណ្ឌប ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះនរោត្ដម សីហនុ « ព្រះបរម រតន កោដ្ឋ » អតីត ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។ លោក នាយក រដ្ឋមន្រ្តី ជប៉ុន ក៏ នឹង អញ្ជើញ ទៅ គោរព វិញ្ញាណក្ខន្ធ នៅ មណ្ឌប របស់ អតីត មន្ត្រី ជប៉ុន ចំនួន ២រូប ដែល បាន ពលី ជីវិត នៅក្នុង បេសកកម្ម ការងារ របស់ អង្គការ សហ ប្រជាជាតិ នៅ កម្ពុជា ផងដែរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បញ្ជាក់ ថា របៀប ធ្វើការ របស់ អាស៊ាន ក្នុង នាម ជា ប្រជាធាន អាស៊ាន វា ច្បាប់ ហើយ ប៉ុន្តែ ក្នុង អាស៊ាន គេ មាន បែងចែក ឱ្យ ប្រទេស មួយ ៗ ទទួលខុសត្រូវ ក្នុង ការសម្របសម្រួល រវាង អាស៊ាន ជាមួយនឹង ប្រទេស ណាមួយ ទទួលខុសត្រូវ ដូចជា ឥលូវនេះ ប្រទេស ដែល ធ្វើ ការសម្របសម្រួល រវាង អាស៊ាន និង អាមេរិក គឺជា ប្រទេស ឥណ្ឌូនេស៊ី ដូចនេះ ហើយ តួនាទី សម្របសម្រួល ពេលវេលា រវាង អាមេរិក ជាមួយ ឥណ្ឌូនេស៊ី គឺជា តួនាទី របស់ ឥណ្ឌូនេស៊ី ។
សម្តេច តេជោ បាន បញ្ជាក់ ថា តាម ការប៉ាន់ប្រមាណ របស់ សម្តេច ប្រធានាធិបតី អាមេរិក អាច ជាប់រវល់ ទៅ អឺរ៉ុប ព្រោះ បើ យោង តាម គម្រោង ប្រធានាធិបតី អាមេរិក អាចនឹង មាន ការប្រជុំ បន្ទាន់ នៅក្នុង ក្របខណ្ឌ ណា តូ ហើយ សមាជិក អាស៊ាន មួយចំនួន ក៏ មាន កម្មវិធី រៀង ៗ ខ្លួន ផងដែរ ។
សម្តេច បាន បញ្ជាក់ ដែរ ថា « ខ្ញុំ សូម ពន្យល់ ចំពោះ ប្រជាពលរដ្ឋ របស់ យើង សូម ឱ្យ យល់ អំពី កម្ពុជា ជា សមាជិក ម្នាក់ ប៉ុន្តែ ជា ប្រធាន អាស៊ាន ប្រធាន អាស៊ាន គ្មាន សិទ្ធិ ក្នុង ការកំណត់ កាលបរិច្ឆេទ ទេ ប្រធាន អាស៊ាន មាន សិទ្ធិ ត្រឹមតែ បញ្ចេញ យោបល់ លើ ការសម្របសម្រួល អំពី ពេលវេលា ដើម្បី មាន កុងសង់ស៊ីស ក្នុង ចំណោម អាស៊ាន ១០ ឯ អ្នក ដែល ត្រូវ សម្របសម្រួល គឺ ឥណ្ឌូនេស៊ី ទេ សូម កុំ ភាន់ ច្រឡំ ហើយ សូម ឱ្យ អ្នក ដែល មិន យល់ សូម ឱ្យ ទៅ រៀន ពី ការងារ អាស៊ាន ឡើងវិញ » ។
សម្តេច តេជោ សង្ឃឹម ថា អស់ លោក បណ្ឌិត អស់ លោក សាស្រ្តាចារ្យ កិច្ចការ អន្តរជាតិ ជាដើម ។ល។ រៀនសូត្រ ឱ្យ បាន ច្រើន ជាង នេះ កុំ ឱ្យ គេ ហៅ ថា « អាល្ងង់ ទូ» ព្រោះ ប្រទេស កម្ពុជា ពេលនេះ ក៏ មាន សេដ្ឋវិទូ ទស្សនវិទូ ហើយក៏ មាន « អាល្ងង់ ទូ » ដែរ ៕
កម្ពុជា - ចិន ចុះ អនុស្សរណៈ យោគយល់ គ្នា លើ កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ គ្រប់គ្រង មុខងារ សាធារណៈ
អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្រ្តី បាន សម្តែង នូវ ក្តី សោមនស្ស រីករាយ និង បាន លើកឡើង ថា ពិធី ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា នេះ ពិតជា មាន សារៈសំខាន់ សម្រាប់ ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី លើ វិស័យ មុខងារ សាធារណៈ កម្ពុជា - ចិន ដើម្បី ពង្រឹង និង រក្សា ឲ្យបាន នូវ មុខងារ សាធារណៈ ប្រកបដោយ គុណភាព ប្រសិទ្ធភាព ប្រសិទ្ធផល និង ផ្តោត ប្រជាជនជា ស្នូល ។
លោក ជីន ស៊ី សមាជិក ការិយាល័យ នយោបាយ និង ជា ប្រធាន គណៈ ចាត់តាំង មជ្ឈឹម បក្ស កុម្មុយនីស្ត ចិន បាន ថ្លែងអំណរគុណ និង ឯកភាព ទាំងស្រុង ចំពោះ ការលើកឡើង របស់ អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្រ្តី អំពី ទំនាក់ទំនង ដ៏ រឹងមាំ រវាង កម្ពុជា - ចិន និង ប្តេជ្ញា បន្ត ជា សកម្ម និង ភាគី ចិន ក៏ នឹង ត្រៀមខ្លួន ជានិច្ច ដើម្បី បន្ត សហការ ជាមួយ កម្ពុជា ទាំង ក្នុង ក្របខ័ណ្ឌ តំបន់ និង នៅលើ ឆាក អន្តរជាតិ ក្នុង ការរួមចំណែក ពង្រឹង ទំនាក់ទំនង ទ្វេ ភាគី កម្ពុជា - ចិន ឲ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ។
ចុង ទីបញ្ចប់ នៃ ពិធី . ភាគី ទាំង ពីរ តំណាង ដោយ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ កម្ពុជា និង លោក ហ្វូ ស៊ីង ហ្គៅ ប្រធាន រដ្ឋបាល មុខងារ សាធារណៈ ជាតិ នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន បាន ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា លើ កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ គ្រប់គ្រង មុខងារ សាធារណៈ ដែល ជា ការបើក ទំព័រ ថ្មី នៃ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ក្នុង វិស័យ មុខងារ សាធារណៈ រវាង ប្រទេស ទាំង ពីរ កម្ពុជា - ចិន ៕
លោក អូស្មាន ហាស្សាន់ ជួប សំណេះសំណាល និង ផ្ដល់ អនុសាសន៍ ជូន បេក្ខជន ក្រុមប្រឹក្សា សង្កាត់ ទាំង៧ នៅ ខណ្ឌ ឫស្សីកែវ
ក្នុង គោលដៅ លើកកម្ពស់ ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង ចំនួន សមាជិក បក្ស និង ពង្រឹង សកម្មភាព សតិអារម្មរណ៍ នយោបាយ របស់ សមាជិក បក្ស លោក អូស្មាន ហាស្សាន់ បាន បញ្ជាក់ ថា គោលការណ៍ រក្សា ចាស់ បង្កើន ថ្មី និង សមាជិក បក្ស មួយ រូប គឺជា សម្លេង ឆ្នោត គាំទ្រ របស់ គណបក្ស មួយ សន្លឹក គឺ ត្រូវ ទាមទារ ឲ្យ ក្រុមប្រឹក្សា សង្កាត់ របស់ យើង អនុវត្ត គោលការណ៍ នេះ ឲ្យបាន ជាប់ ជាប្រចាំ ដើម្បី ដណ្តើម ជ័យ ជំនះ ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា សង្កាត់ និង បោះឆ្នោត សកល ឆ្នាំ ២០២៣ ទទួលបាន ជ័យជំនះ ។
លោក ក៏ បាន លើកឡើង ថា ការជ្រើសរើស បេក្ខភាព ក្រុមប្រឹក្សា សង្កាត់ និង ផែនការ យុទ្ធសាស្ត្រ អភិវឌ្ឍ ឃុំ - សង្កាត់ សម្រាប់ រយៈពេល ៥ ឆ្នាំ ២០២២ - ២០២៧ គឺ មិន ត្រឹមតែ សំដៅ ធ្វើឲ្យ ប្រជាពលរដ្ឋ មាន ជំនឿ ទុកចិត្ត មក លើក គណបក្ស យើង តែ ប៉ុណ្ណោះ ទេ ផ្ទុយទៅវិញ ពលរដ្ឋ នៅក្នុង មូលដ្ឋាន នឹង ទទួលបាន អត្ថប្រយោជន៍ ជាច្រើន ពី គោល នយោបាយ នេះ លើ ការថែរក្សា សុខ សន្តិភាព ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្តល់ នូវ សេវា សាធារណៈ ការរក្សា សណ្តាប់ធ្នាប់ សន្តិសុខ នៅក្នុង មូលដ្ឋាន កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ។
លោក បន្ថែម ថា ក្នុង នាម ជា អ្នកដឹកនាំ និង ជា អ្នក ផ្តល់ នូវ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ត្រូវ មាន ការសាមគ្គីភាព ផ្ទៃក្នុង ដើម្បី បម្រើ ប្រជាពលរដ្ឋ ឱ្យ មាន តម្លាភាព យុត្តិធម៌ ស្មោះត្រង់ ព្រមទាំង មាន ភាព ម៉ឺងម៉ាត់ និង ទទួលបាន នូវ សេចក្តីទុកចិត្ត ពី ប្រជាពលរដ្ឋ ហើយ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥ នា ពេល ខាងមុខ នេះ គណបក្ស យើង នឹង ទទួលបាន ជោគជ័យ ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន បង្ហាញ ខ្លឹមសារ ផ្សព្វផ្សាយ ក្នុង កិច្ចប្រជុំ ជាមួយ ភាគី ពាក់ព័ន្ធ ស្តីពី ការបិទ បញ្ជី បេក្ខជន ដំបូង នៅ គឃ .សប . ការដាក់ ការទទួល និង ការដោះស្រាយ បណ្តឹង ជំទាស់ លើ បញ្ជី បេក្ខជន ដំបូង ។
ក្នុង ខ្លឹមសារ បាន ឱ្យដឹង ថា បន្ទាប់ពី បញ្ចប់ រយៈពេល ចុះបញ្ជី បេក្ខជន នៃ គណបក្ស នយោបាយ ហើយ ការប្ដឹង តវ៉ា ទាំងអស់ ត្រូវបាន ដោះស្រាយ រួចរាល់ គ.ជ. ប ត្រូវ ចាត់ ឱ្យ គឃ .សប បិទ ផ្សាយ ជាសាធារណៈ នៅ ទីស្នាក់ការ របស់ ខ្លួន នូវ បញ្ជី បេក្ខជន ដំបូង ក្នុង រយៈពេល យ៉ាង យូរ ៣ ថ្ងៃ ។
គោលបំណង នៃ ការបិទ ផ្សាយ នេះ គឺ ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ដែល មាន សិទ្ធិ បោះឆ្នោត ក្នុង ឃុំ សង្កាត់ មាន សិទ្ធិ ប្ដឹង ជំទាស់ ជា លាយលក្ខណ៍ អក្សរ ទៅ គ.ជ. ប អំពី បេក្ខជន ឬ បញ្ជី បេក្ខជន ដំបូង ក្នុង រយៈពេល យ៉ាង យូរ ៣ ថ្ងៃ បន្ទាប់ពី ថ្ងៃ បិទ ផ្សាយ ជាសាធារណៈ ។
សូម ជម្រាប ជូន ផងដែរ ថា ការបិទ ផ្សាយ បញ្ជី បេក្ខជន ដំបូង ត្រូវ ធ្វើ ទៅ តាម ករណី នៃ ឃុំ សង្កាត់ នីមួយ ៗ គឺ មិន ធ្វើ ព្រម គ្នា ទូទាំង ប្រទេស នៅ ថ្ងៃ តែ មួយ ដូចជា ការបិទ ផ្សាយ បញ្ជី បោះឆ្នោត ដំបូង នោះ ឡើយ ។
នេះ មាន ន័យ ថា បើ ឃុំ សង្កាត់ ណា ដោះស្រាយ ចប់ សព្វគ្រប់ ចំពោះ គ្រប់ គណបក្ស នយោបាយ ដែល បាន ដាក់ពាក្យ សុំ ចុះបញ្ជី បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត ឃុំ សង្កាត់ នោះ ត្រូវ បិទ ផ្សាយ បញ្ជី បេក្ខជន ដំបូង នៃ ឃុំ សង្កាត់ របស់ ខ្លួន ក្នុង រយៈពេល យ៉ាង យូរ ៣ ថ្ងៃ បន្ទាប់ពី ថ្ងៃ បាន បញ្ចប់ ដំណោះស្រាយ រួចរាល់ ។
ប្រជាពលរដ្ឋ ដែល មាន សិទ្ធិ បោះឆ្នោត នៅក្នុង ឃុំ សង្កាត់ មាន សិទ្ធិ ប្ដឹង ជំទាស់ ជា លាយលក្ខណ៍ អក្សរ ទៅ គ.ជ. ប អំពី បេក្ខជន ឬ បញ្ជី បេក្ខជន ដំបូង ក្នុង រយៈពេល យ៉ាង យូរ ៣ ថ្ងៃ បន្ទាប់ពី ថ្ងៃ បិទ ផ្សាយ ជាសាធារណៈ ។
បណ្ដឹង ជំទាស់ ត្រូវ ចោទប្រកាន់ ទៅ លើ បេក្ខជន ឬ បញ្ជី បេក្ខជន នៃ គណបក្ស - នយោបាយ ណាមួយ ដែល បំពេញ មិន បាន តាម លក្ខខណ្ឌ ដូច មាន ចែង ក្នុង មាត្រា ៣៥ ៣៦ ៣៧ ៣៩ ៤០ ៤១ និង ៤២ នៃ ច្បាប់ ស្ដីពី ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ។
គ.ជ. ប ត្រូវ បើក សវនាការ ជាសាធារណៈ ក្នុង រយៈពេល យ៉ាង យូរ ៣ ថ្ងៃ ក្រោយពី បាន ទទួល ពាក្យបណ្ដឹង ដោយ គ.ជ. ប ត្រូវ ផ្តល់ ព័ត៌មាន ដល់ គណបក្ស នយោបាយ ដែល បាន ដាក់ ស្នើ បញ្ជី បេក្ខជន មាន ការប្ដឹង ជំទាស់ ឬ តំណាង និង ផ្តល់ ព័ត៌មាន ដល់ អ្នក ប្ដឹង ជំទាស់ ហើយនិង ផ្សព្វផ្សាយ ជាសាធារណៈ អំពី កាលបរិច្ឆេទ ពេលវេលា និង ទីកន្លែង ដែល ត្រូវ បើក សវនាការ នោះ ។
ក្នុង ករណី គ.ជ. ប យល់ព្រម តាម បណ្ដឹង ជំទាស់ ចំពោះ បេក្ខជន នោះ គឃ .សប ត្រូវ បដិសេធ បេក្ខភាព ដោយ លុប បេក្ខភាព របស់ បេក្ខជន ដែល ត្រូវបាន ប្ដឹង ជំទាស់ តែ រក្សា ការ យល់ព្រម ចុះបញ្ជី បេក្ខជន របស់ គណបក្ស នយោបាយ ។
តែ បើ គ.ជ. ប យល់ព្រម តាម បណ្ដឹង ជំទាស់ ចំពោះ បញ្ជី បេក្ខជន វិញ នោះ គឃ .សប ត្រូវ បដិសេធ បញ្ជី បេក្ខជន នៃ គណបក្ស នយោបាយ ដែល មាន ការប្ដឹង ជំទាស់ នោះ រួចហើយ លុប បញ្ជី បេក្ខជន និង បដិសេធ លិខិត បញ្ជាក់ ការចុះបញ្ជី បេក្ខជន របស់ គណបក្ស នយោបាយ នោះ ។
សូម បញ្ជាក់ បន្ថែម ថា ប្រសិនបើ គ្មាន បណ្ដឹង ជំទាស់ មក លើ បញ្ជី បេក្ខជន ដំបូង ណាមួយ ទេ នោះ បញ្ជី បេក្ខជន ដំបូង នោះ នឹង ក្លាយជា បញ្ជី បេក្ខជន ផ្លូវការ ។ ផ្អែក លើ បញ្ជី បេក្ខជន ផ្លូវការ នេះ គឃ .សប ត្រូវ ធ្វើ ការចាប់ឆ្នោត ដើម្បី កំណត់ លំដាប់ លេខរៀង បញ្ជី បេក្ខជន ដែល ត្រូវ ដាក់ លើ សន្លឹក ឆ្នោត ស្រប ទៅតាម បទបញ្ជា និង នីតិវិធី របស់ គ.ជ. ប ៕
សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស អញ្ជើញ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ « ភូមិ កុមារ SOS» ស្ថិត នៅក្នុង ខេត្ត ព្រៃវែង បាន អះអាង ថា ក្រោយពី ការមើល ស្រាល របស់ គេ នៅ ទីបំផុត ទៅ ប្រទេស កម្ពុជា បាន ក្លាយទៅជា ប្រទេស គ្រប់គ្រង ការរាត ត្បាត ជំងឺ កូវីដ១៩ បាន ល្អ ជាង បណ្ដា ប្រទេស ដែល មាន បរិក្ខា ទំនើប និង ជឿនលឿន មួយចំនួន ទៅ វិញ ។
បើ តាម សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ការគ្រប់គ្រង ជំងឺ កូវីដ១៩ បាន មិន ផ្ដោត ទាំងស្រុង ទៅ លើ បច្ចេកវិទ្យា ឬ បរិក្ខា សុខាភិបាល ទំនើប ទាំងស្រុង នោះ ពោល អាស្រ័យ ទៅ លើ ឆន្ទៈ មនសិកា វិជ្ជាជីវៈ ការប្ដេជ្ញាចិត្ត ការលះបង់ និង ការខិតខំ ប្រឹងប្រែង របស់ ក្រុម គ្រូពេទ្យ ទើប អាច យកឈ្នះ លើ វិញ្ញាសារ មួយ នេះ បាន ។
សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ បែប នេះ ថា « ករណី កូវីដ តើ ប៉ុន្មាន ប្រទេស សារព័ត៌មាន ប៉ុន្មាន ប្រមាថ យើង អំពី ប្រព័ន្ធ សុខាភិបាល ទន់ខ្សោយ របស់ កម្ពុជា ប៉ុន្ដែ ឥលូវ អ្នក ទាំងនោះ គេ យល់ យ៉ាង មិច ចំពោះ យើង នៅ ពេល ដែល កម្ពុជា ក្នុង មួយ ថ្ងៃ ហើយ ថ្ងៃ នេះ ឆ្លង ប្រមាណ ជាង ១៣០ ករណី ប៉ុណ្ណោះ ( អូមី ក្រុង ) ថ្ងៃ ខ្លះ អត់ មាន ស្លាប់ ទេ ក្នុង ប្រទេស លើ ពិភពលោក ជាច្រើន កំពុងតែ ស្លាប់ រាប់ រយ រាប់ ពាន់ ឆ្លង រាប់ ម៉ឺន នាក់ ។ អញ្ចឹង តើ វាយតម្លៃ អំពី បច្ចេកវិទ្យា ឬ វាយតម្លៃ អំពី ការទទួលខុសត្រូវ ? » ។
សម្ដេច តេជោ ហ៊ុន សែន បាន អះអាង ទៀត ថា ទោះ អ្នក កើត នៅក្នុង ប្រទេស ដែល មាន បច្ចេកវិទ្យា ទាន់សម័យ ឬ ជឿនលឿន សុខាភិបាល ទាន់សម័យ ប៉ុន្ដែ ការគិត របស់ អ្នក អាចនឹង មាន កម្រិត បើ ប្រៀបធៀប ជាមួយ សកម្ម ដែល កម្ពុជា ប្រកាន់ យក ។ មកដល់ ពេលនេះ កម្ពុជា ជា ប្រទេស មួយ ក្រ ប៉ុន្ដែ កម្ពុជា បាន ចាក់ វ៉ាក់សាំង ជាង ៩២ ភាគរយ នៃ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ហើយ កំពុងតែ ដំណើរការចាក់ ឲ្យ ក្មេង អាយុ៣ និង ៤ឆ្នាំ ។
ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា រូប នេះ បាន ចោទសួរ ត្រឡប់ ទៅវិញ ថា ប្រទេស ដែល អួត អាង អ្នក ដែល អួត អាង ពី ប្រព័ន្ធ សុខាភិបាល ខ្លាំង និង បង្អាប់ កម្ពុជា ជាមួយ ប្រព័ន្ធ សុខាភិបាល ខ្សោយ តើ កម្ពុជា បាន សង្គ្រោះ កម្ពុជា របៀប ណា ដែរ ? ។
បើ ទោះបី គ្រប់គ្រង បាន ល្អ និង បើក ដំណើរការ សេដ្ឋកិច្ច ឡើងវិញ ក៏ ពិត មែន ប៉ុន្ដែ សម្ដេច តេជោ ហ៊ុន សែន នៅតែ បន្ដ អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ យកចិត្តទុកដាក់ ក្នុង ការការពារ ខ្លួន តាមរយៈ ការអនុវត្ត វិធានការ ៣ការពារ និង ៣កុំ ព្រម ពេល ដែល រាជ រដ្ឋាភិបាល កាត់បន្ថយ នូវ ការរឹតបន្ដឹង លើ បញ្ហា មួយចំនួន នោះ ។
គួរ ជម្រាប ថា បើ ទោះបី បច្ចុប្បន្ន ជំងឺ កូវីដ១៩ ប្រភេទ អូមី ក្រុង បាន ឆ្លង ចូលក្នុង សហគមន ៍ នៃ ប្រទេស កម្ពុជា ជា បន្ដ បន្ទាប់ ក្ដី ប៉ុន្ដែ កម្ពុជា បាន បិទ បញ្ចប់ នូវ ព្រឹត្តិការណ៍ ឆ្លង ចូល សហគមន៍ ធំ ៗ ជា បន្ដ បន្ទាប់ ដែល រួម មាន ព្រឹត្តិការណ៍ សហគមន៍ ៣វិច្ឆិកា . ព្រឹត្តិការណ៍ សហគមន៍ ២៨វិច្ឆិកា និង ចុងក្រោយ គេ គឺ ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ដែល មាន មនុស្ស ឆ្លង ច្រើន និង ស្លាប់ ច្រើន ជាង គេ ក្នុង ចំណោម ព្រឹត្តិការណ៍ សហគមន៍ ដែល កើតមាន នៅក្នុង ប្រទេស កម្ពុជា ។
ក្រៅពី មនសិកា និង ការទទួលខុសត្រូវ របស់ ក្រុម គ្រូពេទ្យ ដែល ធ្វើឲ្យ កម្ពុជា យកឈ្នះ លើ ជំងឹកូវីដ១៩ ហើយ នោះ ការដឹកនាំ ដែល ប្រកបដោយ ភាពប៉ិនប្រសព្វ និង គិតគូរ ខ្ពស់ បំផុត របស់ សម្ដេច តេជោ ហ៊ុន សែន ក៏ កាន់តែ មិន អាច កាត់ផ្ដាច់ បាន ថែម ទៀត ។ គេ នៅ ចាំ បាន ថា នៅ ពេល ដែល មាន ជំងឺ កូវីដ១៩ ឆ្លង ចូល សហគមន៍ ហើយ កម្ពុជា មិន ទាន់ មាន វ៉ាក់សាំង នោះ សម្ដេច តេជោ ហ៊ុន សែន បាន ស្វះស្វែងរក វ៉ាក់សាំង ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ។
ដូច ការរំពឹងទុក ក្រោយមក កម្ពុជា បាន ទទួល នូវ វ៉ាក់សាំង ដែល ជា ជំនួយ របស់ មហា មិត្ត ចិន និង មួយ ផ្នែក ជា ការបញ្ជាទិញ ដោយ ផ្ទាល់ របស់ កម្ពុជា ដើម្បី មក ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ សម្ដៅ បង្កើន ភាពស៉ាំ ក្នុង សហគមន៍ ដែល ពេលនេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ប្រើប្រាស់ នូវ យុទ្ធសាស្ដ្រ « ផ្កា រីក » ។ យុទ្ធសាស្ដ្រ នេះ គឺ ចាក់ ផ្ដើម ចេញ ពី ដំបូង នៅ តំបន់ ដែល ផ្ទុះ ខ្លាំង ពោល នៅ រាជធានី ភ្នំពេញ និង ខេត្ដ កណ្ដាល ។
បន្ថែម ពី ការជោគជ័យ លើ ការងារ ចាក់ វ៉ាក់សាំង ជូន ដល់ ប្រជាពលរដ្ឋ គ្រប់ ដូស មូលដ្ឋាន ហើយ នោះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បន្ដ គិតគូរ បន្ថែម ទៀត ក្នុង ការចាក់ វ៉ាក់សាំង ដូស ទី៣ និង ដូស ទី៤ ជូន ដល់ ប្រជាពលរដ្ឋ ដើម្បី ពង្រឹង ប្រព័ន្ធ ការពារ ជាមួយ ការបំប្លែង ខ្លួន ថ្មី ជា បន្ដ បន្ទាប់ របស់ ជំងឺ កូវីដ១៩ ។ នៅ នេះ ប្រជាជន កម្ពុជា ដែល ទទួលបាន វ៉ាក់សាំង នោះ គឺ មាន អាយុ ចាប់ពី ៣ឆ្នាំ ឡើង ទៅ ។
គិត ត្រឹម យប់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២២ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៤.៧៦៨ . ៩៨៨ នាក់ ។ នេះ បើ តាម របាយការណ៍ ផ្លូវការ ដែល បង្ហាញ ដោយ ក្រសួង សុខាភិបាល ៕
ក្រុម គ្រូពេទ្យ ជំនាញ វេជ្ជសាស្ត្រ បុរាណ ប្រឆាំង នឹង ជម្ងឺ កូវីដ១៩ ថ្នាក់ ជាតិ ចិន ដំបូង គេ ដែល ប្រទេស ចិន ចាត់ បញ្ជូន បាន មកដល់ កម្ពុជា
( ប៉េកាំង ) ៖ នា រសៀល ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២២ ក្រុម គ្រូពេទ្យ ជំនាញ វេជ្ជសាស្ត្រ បុរាណ ចិន ចំនួន ១០នាក់ បាន ធ្វើដំណើរ មកដល់ រាជធានី ភ្នំពេញ ហើយ ខណៈ ដែល សមាជិក ក្រុម ២នាក់ នៅ កម្ពុជា ស្រាប់ ដូច្នេះ សរុប ចំនួន ១២នាក់ ។ នេះ គឺជា ក្រុម ពេទ្យ ជំនាញ វេជ្ជសាស្ត្រ បុរាណ ថ្នាក់ ជាតិ របស់ ចិន ដំបូង គេ ដែល ប្រទេស ចិន ចាត់ បញ្ជូន ទៅ ក្រៅ ប្រទេស ។
ឯកឧត្តម អឿន បូរារ័ត្នន៍ រដ្ឋល ខាធិការ ក្រសួង សុខាភិបាល និង ឯកឧត្តម Wu Guoquan ទីប្រឹក្សា សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម នៃ ស្ថានទូត ចិន ប្រចាំ កម្ពុជា ព្រមទាំង មន្ត្រី ពាក់ព័ន្ធ មួយ ចំនួន ទៀត បាន អញ្ជើញ ទៅ ទទួល ដំណើរ មកដល់ នៃ ក្រុម គ្រូពេទ្យ ជំនាញ វេជ្ជសាស្ត្រ បុរាណ ចិន នា អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ នា ពេល នោះ ។
លោកស្រី Xu Fengqing ប្រធាន ក្រុម គ្រូពេទ្យ ជំនាញ វេជ្ជសាស្ត្រ បុរាណ ចិន បាន មានប្រសាសន៍ ថា បេសកកម្ម របស់ ក្រុម លោកស្រី គឺ ក្នុង គោលបំណង ចែករំលែក បទពិសោធន៍ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ជាមួយ ភាគី កម្ពុជា ។ លោកស្រី ថា ក្រុម លោកស្រី នឹង ការពិភាក្សា ផ្នែក វេជ្ជសាស្ត្រ ជាមួយ គ្រូពេទ្យ កម្ពុជា ព្រមទាំង ជាមួយនឹង ការជួយ ព្យាបាល ប្រជាជន កម្ពុជា ផងដែរ ។
ការចាត់ បញ្ជូន ក្រុម គ្រូពេទ្យ ជំនាញ វេជ្ជសាស្ត្រ បុរាណ ចិន ជួយ កម្ពុជា ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ លើក នេះ គឺជា ជំហាន សំខាន់ មួយ ទៀត នៃ វេជ្ជសាស្ត្រ និង ឱសថ បុរាណ ចិន ក្នុង ការជួយ កម្ពុជា ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ហើយ វា នឹង ពង្រឹង កិច្ចសហប្រតិបត្តិការ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ កម្ពុជា - ចិន មួយ កម្រិត បន្ថែម ទៀត ដើម្បី ចូលរួម បង្កើត សហគមន៍ វាសនា រួម កម្ពុជា ចិន និង បង្កើត សហគមន៍ សុខភាព អនាម័យ រួម នៃ មនុស្សជាតិ ផងដែរ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បញ្ជាក់ ថា ការបន្ធូរបន្ថយ លក្ខខណ្ឌ តម្រូវ ចូលមក កម្ពុជា នេះ ដើម្បី សម្រួល ដល់ ការទាក់ទាញ វិនិយោគ ការធ្វើ ធុរកិច្ច និង ទាក់ទាញ ទេសចរណ៍ រួមទាំង កាត់បន្ថយ នូវ ការ ចំណាយ ធ្វើដំណើរ ។
សម្តេច តេជោ បាន បញ្ជាក់ ថា ការលុបចោល លក្ខខណ្ឌ តម្រូវ ធ្វើតេស្ត PCR និង តេស្តរហ័ស ក៏ នឹង ជួយ សម្រួល ដល់ ការធ្វើដំណើរ ចេញ ចូល របស់ បងប្អូន ប្រជាជន ខ្មែរ ទាំង ការឈឺចាប់ ដោយសារ រុក ច្រមុះ និង ការចំណាយ ថវិកា សម្រាប់ ធ្វើតេស្ត ។
សម្តេច តេជោ បាន បញ្ជាក់ ថា តាមរយៈ ការធ្វើតេស្ត នេះ ធ្វើ រាជ រដ្ឋាភិបាល ចំណាយ ប្រាក់ យ៉ាង ច្រើន ក្នុង ១ ថ្ងៃ ៗ ទៅ លើ ឧបករណ៍ តេស្ត និង សម្លៀកបំពាក់ គ្រូពេទ្យ ផងដែរ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ថា « ការខ្វេះ ចម្រុះ មិន មែន ត្រឹមតែ ឈឺ ច្រមុះ ទេ វា អស់ លុយ មួយ ថ្ងៃ ៗ រាជ រដ្ឋាភិបាល ចាយ លុយ ច្រើន ណាស់ មាន ទាំង ឧបករណ៍ ធ្វើតេស្ត សម្លៀកបំពាក់ ធ្វើតេស្ត យើង សម្រួល បញ្ហា នេះ ដើម្បី ទាក់ទាញ ការវិនិយោគ ការធ្វើ ធុរកិច្ច និង ធ្វើ ទេសចរណ៍ នៅ កម្ពុជា ។ ចំណុច អស់ ទាំងនេះ គឺជា ចំណុច ដែល យើង នៅតែ បន្ត ក្នុង ការធ្វើ សកម្មភាព ឆ្ពោះទៅ មុខ ដើម្បី គោលដៅ នៃ ការអភិវឌ្ឍន៍ រៀន រស់ ជាមួយនឹង កូវីដ១៩ » ។
កម្ពុជា បាន សម្រេច បើក ប្រទេស របស់ ខ្លួន ពេញលេញ ឡើងវិញ កាលពី ចុង ឆ្នាំ ២០២១ ។ បើ ទោះបី វីរុស កូវីដ១៩ បំប្លែង ថ្មី អូមី ក្រុង មាន ករណី ឆ្លង ច្រើន ក្តី ប៉ុន្តែ អត្រា ស្លាប់ មាន ចំនួន តិចតួច ។ ជាពិសេស ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ ចុងក្រោយ នេះ អត្រា ឆ្លង ជំងឺ កូវីដ១៩ ដែល ប្រកាស ដោយ ក្រសួង សុខាភិបាល បាន ធ្លាក់ចុះ ជា បន្តបន្ទាប់មក នៅ ត្រឹម ជាង ១០០ នាក់ ក្នុង មួយ ថ្ងៃ ករណី ស្លាប់ ត្រឹម ១នាក់ ហើយ ថ្ងៃ ខ្លះ មិន មាន អ្នកស្លាប់ នោះ ទេ ។
ចៅក្រម នៃ តុលាការ ICJ ចេញ សេចក្ដីបង្គាប់ ខាងលើ នៅក្នុង សំឡេង គាំទ្រ ១៣ ទល់ នឹង ២សំឡេង ជំទាស់ ។ តុលាការ អន្តរជាតិ មួយ នេះ បាន បញ្ជាក់ ដូច្នេះ ថា « សហព័ន្ធ រុស្ស៊ី ត្រូវតែ បញ្ឈប់ ប្រតិបត្តិការ យោធា ដែល បាន ចាប់ផ្ដើម តាំងពី ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ មក នៅលើ ទឹកដី អ៊ុយក្រែន ជាបន្ទាន់ » ។
បន្ថែម ពីលើ នេះ ចៅក្រម តុលាការ ICJ បាន ជំរុញ ឱ្យ រុស្ស៊ី ធានា ឱ្យ បាន ថា កម្លាំង ដទៃ ដែល ស្ថិត នៅក្រោម គ្រប់គ្រង ឬ ទទួលបាន ការគំា ទ្រ ពី ទីក្រុង ម៉ូស្គូ ក៏ ត្រូវ បញ្ឈប់ សកម្មភាព យោធា ផងដែរ ។
គួរ បញ្ជាក់ ថា ទោះបីជា សេចក្ដីសម្រេច របស់ តុលាការ យុត្តិធម៌ អន្តរជាតិ (ICJ) មាន លក្ខណៈ ចាប់បង្ខំឱ្យ អនុវត្ត តាម ក៏ដោយ តែ កន្លងមក ក៏ មាន ប្រទេស មួយចំនួន បដិសេធ ឬ កម្រ នឹង មាន អ្នក អនុវត្ត តាម ណាស់ ហើយ ប្រទេស ដែល ជំទាស់ នឹង សេចក្ដីបង្គាប់ ចេញ ដោយ តុលាការ អន្តរជាតិ មួយ នេះ អាច លើក យក សំណុំរឿង នេះ ទៅ និយាយ នៅឯ ក្រុមប្រឹក្សា សន្តិសុខ UN ជា ទី ដែល រុស្ស៊ី មាន សិទ្ធិ អំណាច វ៉េតូ ស្រាប់ ៕
ថ្លែង ក្នុង ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ « ភូមិ កុមារ SOS» ស្ថិត នៅក្នុង ខេត្ត ព្រៃវែង នា ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ បាន លើកឡើង ថា៖ « សូម កុំ មាន ការភាន់ច្រឡំ ថា ប្រធាន អាស៊ាន មិន ព្រម ប្រជុំ រវាង អាស៊ាន និង អាមេរិក អ្នក ដែល ត្រូវ សម្របសម្របសម្រួល ហ្នឹង គឺ ឥណ្ឌូនេស៊ី ជា អ្នក ទទួលបន្ទុក សម្របសម្រួល ប្រធាន អាស៊ាន គឺជា សមាជិក អាស៊ាន មួយ ដែល ធ្វើ ការសម្របសម្រួល ក្រោម ភាពសម្រួប សម្រួល របស់ ឥណ្ឌូនេស៊ី តែ ប៉ុណ្ណោះ សង្ឃឹម ថា លោក បណ្ឌិត សាស្រ្តាចារ្យ រៀន យល់ ពី អាស៊ាន » ។
កិច្ចប្រជុំ កំពូល ពិសេស អាស៊ាន - អាមេរិក ដែល សហរដ្ឋ អាមេរិក ធ្វើជា ម្ចាស់ ផ្ទះ ត្រូវបាន សេតវិមាន ប្រធានាធិបតី សហរដ្ឋ អាមេរិក ប្រកាស ថា នឹង រៀបចំឡើង នៅ ថ្ងៃទី ២៨ ដល់ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២២ ខាងមុខ នេះ បន្ទាប់ពី បាន លើក ពេល ជាង ១ខែ ។
ទោះជា យ៉ាង នេះ ក្តី កាលពី ថ្ងៃទី ០៩ ខែមីនា ឆ្នាំ ២០២២ លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា បាន បញ្ជាក់ ថា កិច្ចប្រជុំ នេះ ត្រូវបាន លើក ពេល វិញ ដោយសារ មេដឹកនាំ អាស៊ាន ខ្លះ មិន អាច ប្រជុំ តាម ពេលវេលា ស្នើ ឡើង បាន ។
អ្នកវិភាគ មួយចំនួន បាន វាយប្រហារ ចំពោះ កម្ពុជា ចំពោះមុខ ការលើក ពេល កិច្ចប្រជុំ កំពូល អាស៊ាន - អាមេរិក ជា លើក ទី២នេះ ។ លោក បណ្ឌិត សូ ណារ៉ូ បាន រិះគន់ ថា ការបណ្តាលឱ្យ មាន ការ លើក ពេលនេះ អាច ដោយសារ កម្ពុជា ដែល រង ឥទ្ធិពល ពី ចិន ។
ក្នុង ពិធី ដដែល សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ការ មិន យល់ ឬ ចេះ មិន ដល់ អាច បង្កើត បាន នូវ បញ្ហា ។ សម្តេច បាន ថ្លែង ថា កន្លងទៅ មាន ការបកស្រាយ ដោយ បំភ្លៃ ការពិត ទៅ លើ ការប្រជុំ កំពូល ពិសេស អាស៊ាន - អាមេរិក ដែល គ្រោង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៨ - ២៩ ខែមីនា ។ ដោយ ចំណុច នេះ ត្រូវបាន បកស្រាយ ដោយ មនុស្ស ចំនួន ដោយ លើកឡើង ថា ប្រធាន អាស៊ាន មិន យល់ស្រប ក្នុង ការប្រជុំ រវាង អាស៊ាន - អាមេរិក នោះ ទេ ។
សម្តេច បាន គូសបញ្ជាក់ ថា « ប៉ុន្តែ ខ្ញុំ គួរតែ ប្រដៅ គេ ហើយ ផ្តល់ នូវ ព័ត៌មាន ជាក់លាក់ សម្រាប់ ការយល់ដឹង របស់ ប្រជាជន កម្ពុជា ជំនួស ឱ្យ ការខ្វះ ការចេះដឹង របស់ អ្នក ខ្លះ ដែល គេ ហៅ ថា បណ្ឌិត និង អ្នក ខ្លះ សាស្រ្តចារ្យ » ។
តាម ការប៉ាន់ប្រមាណ របស់ សម្តេច . អំឡុង ពេលនេះ ប្រធានាធិបតី អាមេរិក ក៏ អាច ជាប់រវល់ ក្នុង ការ ទៅ ចូលរួម កិច្ចប្រជុំ ប ន្ទាន់ ជាមួយ សមាជិក ណា តូ ហើយ សមាជិក អាស៊ាន មួយចំនួន ក៏ មាន កម្មវិធី រៀង ៗ ខ្លួន ផងដែរ ។
« ខ្ញុំ សូម ពន្យល់ ប្រជាពលរដ្ឋ របស់ យើង កម្ពុជា សមាជិក ម្នាក់ ប៉ុន្តែ ជា ប្រធាន អាស៊ាន ប្រធាន អាស៊ាន គ្មាន សិទ្ធិ ក្នុង ការកំណត់ កាលបរិច្ឆេទ ប្រធាន អាស៊ាន មាន សិទ្ធិ ក្នុង ការបញ្ចេញ យោបល់ លើ ការសម្របសម្រួល អំពី ពេលវេលា ដើម្បី មាន កុងសង់ស៊ីស ក្នុង ចំណោម អាស៊ាន ១០ ឯ អ្នក ដែល ត្រូវ សម្របសម្រួល គឺ ឥណ្ឌូនេស៊ី ទេ សូម កុំ មាន ការភាន់ច្រឡំ ហើយ សូម ឱ្យ អ្នក មិន យល់ ទៅ រៀន ពី ការងារ អាស៊ាន ឡើងវិញ » ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ សម្តេច តេជោ ។
សម្តេច សង្ឃឹម ថា អស់ លោក បណ្ឌិត អស់ លោក សាស្រ្តាចារ្យ កិច្ចការ អន្តរជាតិ ជាដើម ។ល។ រៀនសូត្រ ឱ្យ បាន ច្រើន ជាង នេះ កុំ ឱ្យ គេ ហៅ ថា « អាល្ងង់ ទូ» ព្រោះ ប្រទេស របស់ កម្ពុជា ពេលនេះ មាន សេដ្ឋវិទូ ទស្សនវិទូ ហើយក៏ មាន « អាល្ងង់ ទូ » ដែរ ។
សម្តេច បញ្ជាក់ ថា « ការ មិន មាន ការចេះដឹង គ្រប់គ្រាន់ គឺ ធ្វើឱ្យ ចេញ ទៅជា មនុស្ស បែប បោកប្រាស់ ឧទាហរណ៍ ទម្លាក់ កំហុស ឱ្យ ប្រធាន អាស៊ាន ថា ប្រធាន អាស៊ាន អត់ ចង់ ប្រជុំ អាស៊ាន អាមេរិក » ។
បើ តាម រដ្ឋាភិបាល ជប៉ុន គ្រោះ រញ្ជួយ ដី ខាងលើ បាន កើតឡើង ចម្ងាយ ពី ទីក្រុង តូក្យូ ប្រហែល ២៧៥ គីឡូម៉ែត្រ ហើយ ផ្ទះ រាប់ សែន ខ្នង គ្មាន អគ្គិសនី ប្រើប្រាស់ ។ ប៉ុន្តែ ប្រភព ថាមពល មួយចំនួន ត្រូវបាន ស្តារ ឡើងវិញ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ នេះ ខណៈ អាជ្ញាធរ បាន លុបចោល ការព្រមាន អំពី រលក យក្ស ស៊ូណាមិ ដែល បាន ដាក់ចេញ ក្រោយ មាន ហេតុការណ៍ រញ្ជួយ ភ្លាម ៗ ។
គួរ បញ្ជាក់ ថា បើ តាម ទីភ្នាក់ ឧតុនិយម ជប៉ុន . នៅ ពាក់កណ្តាល អាធ្រាត គ្រោះ រញ្ជួយ ដី បាន វាយប្រហារ នៅ តំបន់ ឆ្នេរសមុទ្រនស ខេត្ត ហ្វូគូ ស៊ីម៉ា ក្នុង ជម្រៅ ៦០ គីឡូម៉ែត្រ ។ ហេតុការណ៍ នេះ បាន រំលឹក ឡើងវិញ នូវ ការចងចាំ របស់ ប្រជាជន ជប៉ុន ចំពោះ ការបំផ្លិចបំផ្លាញ និង រលក យក្ស ស៊ូណាមិ ក្នុង ខែមីនា ឆ្នាំ ២០១១ គឺ ១ សប្តាហ៍ បន្ទាប់ពី ខួប ១១ ឆ្នាំ នៃ គ្រោះមហន្តរាយ ៕
លោកស្រី ឱ វណ្ណឌីន បកស្រាយ អំពី ផល ប៉ះពាល់ សុខភាព ក្រោយ ជាសះស្បើយ ពី ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន ចេញមក បកស្រាយ និង ពន្យល់ អំពី ផល ប៉ះពាល់ ដល់ សុខភាព មួយចំនួន ក្រោយពី ជាសះស្បើយ ជំងឺ កូវីដ១៩ ។ ការចេញមក បកស្រាយ របស់ លោកស្រី ឱ វណ្ណឌីន ធ្វើឡើង ដើម្បី ឆ្លើយតប ទៅនឹង ការចោទសួរ មួយចំនួន ពិសេស សម្រាប់ អ្នក ដែល ជាសះស្បើយ ពី ជំងឺ កូវីដ១៩ តែម្ដង ។
លោកស្រី ឱ វណ្ណឌីន បាន ធ្វើ ការបកស្រាយ យ៉ាង លម្អិត ដែល មាន ខ្លឹមសារ ទាំងស្រុង នៅ ខាងក្រោម នេះ៖
ករណី នេះ អាស្រ័យ លើ សរីរាង្គ របស់ បុគ្គល ម្នាក់ ៗ ដែល មាន ការឆ្លើយតប និង ការវិវត្តន៍ កើតមាន មិន ដូចគ្នា នោះ ឡើយ ជាពិសេស ស្ថានភាព នៃ អង់ទី គ័រ របស់ បុគ្គល ឆ្លើយតប ទប់ទល់ ទៅនឹង ជំងឺ នេះ ហើយក៏ អាស្រ័យ លើ ស្ថានភាព ដែល បុគ្គល បាន ឆ្លងកាត់ សភាព ជំងឺ ស្រាល ឬ ជំងឺ ធ្ងន់ធ្ងរ ផងដែរ ។
អ្នកវិទ្យាសាស្ត្រ ក៏ មិន ទាន់ អាច បញ្ជាក់ ឲ្យដឹង បាន ផងដែរ ថា តើ ផល ប៉ះពាល់ សំខាន់ ៗ អ្វី ខ្លះ ទៀត លើ សរីរាង្គ បុគ្គល ដែល បាន ជាសះស្បើយ ពី ជំងឺ កូវីដ - ១៩ នៅក្នុង កម្រិត ណា នោះ និង ក្នុង រយៈពេល យូរ ប៉ុណ្ណា នោះ នៅឡើយ ទេ ដែល តម្រូវឲ្យ មាន ការសិក្សា ច្បាស់លាស់ ជា បន្តបន្ទាប់ ទៀត ផងដែរ ។
សម្រាប់ ជំងឺ កូវីដ - ១៩ ជាពិសេស ពពួក បម្លែង ថ្មី អូមី ក្រុង នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ មាន ការយល់ដឹង ថា លទ្ធភាព វៃលុក របស់ វា មក លើ សរីរាង្គកាយ មនុស្ស អាច កើតមាន មិន អាច មើល រំលង បាន ឡើយ ហើយ ជំងឺ កូវីដ - ១៩ ក៏ មិន មែន ជា ជំងឺ ផ្តាសាយ ក្នុង លក្ខណៈ ធម្មតា និង រិត តែ មិន មែន ជា ជំងឺ ដែល សាមញ្ញ ពេក នោះ ដែរ ថ្វីត្បិតតែ វា មាន លក្ខណៈ ដូចជា ស្រាល ដោយ មួយ ចំណែក ធំ ដោយសារ ឥទ្ធិពល បាន មកពី ការស្រោចស្រព វ៉ាក់សាំង បាន ច្រើន នៅក្នុង សហគមន៍ ។
សូម កុំ ភ្លេច ថា សរីរាង្គកាយ យើង ប្រហែលជា នឹង អាច មាន ការប៉ះពាល់ សុខភាព ទោះ តិច ក្តី ឬ ច្រើន ក្តី ក្រោយពី បាន ឆ្លង ជំងឺ កូវីដ - ១៩ ប្រសិនបើ យើង មិន មាន កង ការពារ ក្នុង ខ្លួន យើង រឹងមាំ ទេ នោះ ។ ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដួស ទី៣ ឬ ដូស ជំរុញ នា ពេលនេះ នឹង ជួយ ពង្រឹង កង ការពារ នេះ ដើម្បី ទប់ទល់ ពី ការវ៉ៃ លុក ធ្ងន់ធ្ងរ លើ សរីរាង្គ បុគ្គល និង ជួយសង្គ្រោះ អាយុជីវិត មនុស្ស ផងដែរ ។
ដើម្បី បង្កើន នូវ កង ការពារ ក្នុង សរីរាង្គ របស់ បុគ្គល និង ចៀស ផុត ពី ផលវិបាក នានា ពី ជំងឺ ដ៏ កាច សាហាវ នេះ ខ្ញុំ សូម ជំរុញ និង លើកទឹកចិត្ត ដល់ ការយកចិត្តទុកដាក់ របស់ បងប្អូន នា ពេលនេះ សូមអញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង ដូស ទី៣ ឬ ដូស ជំរុញ ឲ្យបាន គ្រប់ ៗ គ្នា ហើយ អ្នក ដែល បាន ចាក់ ចនស៊ុន ចនស៊ិន បាន មួយ ដូស ហើយ នោះ ក៏ សូម ទៅ ទទួលយក វ៉ាក់សាំង ដូស ជំរុញ ឲ្យបាន គ្រប់ គ្នា ៗ ផងដែរ ។
សវនាការ កាត់ទោស លោក សម រង្ស៉ី និង បក្ខពួក នេះ មាន សមាសភាព ប្រធាន ក្រុមប្រឹក្សា លោក រស់ ពិសិដ្ឋ . ចៅក្រម ប្រឹក្សា លោក អ៉ឹម វណ្ណះ និង លោកស្រី សឿង ចរិយា . តំណាង អយ្យការ លោក សេង ហៀង និង លោក សំម ឫទ្ធី វាសនា ។
ដោយឡែក អ្នក រួម គំនិត ម្នាក់ ទៀត ឈ្មោះ ហ៉ិន ឆាន ត្រូវបាន តុលាការ ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ កំណត់ ៥ ឆ្នាំ ប៉ុន្តែ ទោស នេះ ត្រូវ ព្យួរ ធម្មតា ពី បទ រួម គំនិត ក្បត់ និង បទ ញុះញង់ ឲ្យ ប្រព្រឹត្ត អំពើ បង្កឲ្យ មាន ភាពវឹកវរ ធ្ងន់ធ្ងរ ដល់ សន្តិសុខ សង្គម ៕
លោក ពូទីន ធ្វើការកត់សម្គាល់ បែប នេះ នៅក្នុង សុន្ទរកថា មួយ ទៅកាន់ គណៈ រដ្ឋមន្ត្រី នៃ រដ្ឋាភិបាល ទីក្រុង ម៉ូស្គូ នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ ។ ថ្លែង នា ឱកាស នោះ ប្រធានាធិបតី រុស្ស៊ី រូប នេះ ក៏ បាន ទទួលស្គាល់ ផងដែរ ពី ផល ប៉ះពាល់ បង្កឡើង ទណ្ឌកម្ម លោក ខាងលិច ប៉ុន្តែ ថា រុស្ស៊ី នឹង តស៊ូ ហែល ឆ្លង ពេលវេលា ដ៏ លំបាក នេះ ។ លោក បន្ថែម ទៀត ថា បណ្ដា ប្រទេស លោក ខាងលិច ចង់ ធ្វើឱ្យ រុស្ស៊ី ក្លាយជា ប្រទេស ចំណុះ មួយ ដ៏ ទន់ខ្សោយ . បំពាន បូរណភាព ទឹកដី រុស្ស៊ី និង ចង់ បំបែក បាក់ រុស្ស៊ី ។
គួរ បញ្ជាក់ ថា បើ តាម លោក ពូទីន រុស្ស៊ី ត្រៀមខ្លួន ជាស្រេច ដើម្បី ពិភាក្សា ពី លក្ខខន្តិកៈ អព្យាក្រឹត របស់ អ៊ុយក្រែន ខណៈ សង្រ្គាម បាន ឈានចូល ដល់ សប្ដាហ៍ ទី៣ ដោយ ផ្ដាច់ ជីវិត មនុស្ស រាប់ ពាន់ នាក់ នៃ ភាគី ជម្លោះ ហើយ បង្ខំឱ្យ ប្រជាជន អ៊ុយក្រែន រត់ ភៀសខ្លួន ទៅ ក្រៅ ប្រទេស ឬ ពី ផ្ទះសម្បែង ដើម្បី គេច ចេញ ពី សង្រ្គាម ៕
កិច្ចប្រជុំ អគ្គ មេបញ្ជាការ កងទ័ព អាស៊ាន លើក ទី១៩ បាន ចាប់ផ្តើម ហើយ ដោយ ចូលរួម ផ្ទាល់ នៅ រាជធានី ភ្នំពេញ
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ ក្នុង នាម ជា ប្រធាន កិច្ចប្រជុំ បាន ថ្លែង នូវ ការស្វាគមន៍ ចំពោះ វត្តមាន បណ្តា ប្រតិភូ អញ្ជើញ ចូលរួម ដោយ បញ្ជាក់ ថា នេះ ជា លើក ដំបូង ដែល កងទ័ព អាស៊ាន អាច ជួបប្រជុំ ផ្ទាល់ ជាមួយគ្នា បន្ទាប់ពី ស្ថានភាព នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ នៅ កម្ពុជា បាន ធូរស្រាល ។
នាយ ឧត្តមសេនីយ៍ បាន ផ្តល់ ក្តីសង្ឃឹម ថា តាមរយៈ កិច្ចប្រជុំ ថ្ងៃ នេះ កងទ័ព អាស៊ាន នឹង បន្ត ពិភាក្សា ផ្លាស់ប្ដូរ ទស្សន : ការចែករំលែក ព័ត៌មាន និង គំនិត ផ្តួចផ្តើម ថ្មី ៗ ក្នុង លក្ខណៈ បើក ចំហ មិត្តភាព ដើម្បី សម្រេច ឲ្យបាន ប្រសិទ្ធភាព លទ្ធផល ផ្លែ ផ្កា ក្នុង ការពង្រឹង កិច្ចសហប្រតិបត្តិការ និង ការរួបរួម ស្អិត រមួត នៅ តំបន់ អាស៊ី អាគ្នេយ៍ ៕
EDC ជូនដំណឹង ពី ការរអាក់រអួល ចរន្ត នៅ ថ្ងៃ នេះ ដល់ ថ្ងៃទី ២០ ខែមីនា ដើម្បី រុះរើ គន្លង ខ្សែ បណ្តាញ ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ ដល់ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២២ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
« ភូមិ កុមារ SOS ព្រៃវែង » មាន អគារ សរុប ចំនួន ៩ខ្នង រួម មាន៖ អគារ ការិយាល័យ និង សាល សិល្បៈ ១ខ្នង កម្ពស់ ២ជាន់ . អគារ ផ្ទះ គ្រួសារ ៤ខ្នង កម្ពស់ ២ជាន់ . អគារ ផ្ទះ នាយក ភូមិ និង ផ្ទះ បុគ្គលិក ១ខ្នង កម្ពស់ ២ជាន់ . អគារ ផ្ទះ សហគមន៍ និង ផ្ទះ ភ្ញៀវ ១ខ្នង កម្ពស់ ២ជាន់ . អគារ ផ្ទះ អាហារូបត្ថម្ភ ១ខ្នង កម្ពស់ ២ជាន់ និង អគារ មជ្ឈមណ្ឌល បណ្តុះបណ្តាល វិជ្ជាជីវៈ ១ខ្នង ។
លោក វង សូត បាន ឱ្យដឹង ផងដែរ ថា ក្រៅតែ ពី កសាង ភូមិ កុមារ ដើម្បី ផ្តល់ ការស្នាក់ នៅ និង ផ្តល់ ការថែទាំ សម្រាប់ រយៈពេល វែង ហើយ នោះ អង្គការ មនុស្សធម៌ មួយ នេះ ក៏ បាន អនុវត្ត គម្រោង មួយចំនួន ទៀត មាន ដូច ជា៖ កម្មវិធី ពង្រឹង គ្រួសារ តាម សហគមន៍ . ការបង្កើត ផ្ទះ សម្រាប់ យុវជន . ការបង្កើត មត្តេយ្យ សាលា និង សាលារៀន ហ័រម៉ាន ម៉ៃ ន័រ . ការបង្កើត មជ្ឈមណ្ឌល បណ្តុះបណ្តាល វិជ្ជាជីវៈ មជ្ឈមណ្ឌល វេជ្ជសាស្ត្រ មជ្ឈមណ្ឌល សង្គ្រោះ បន្ទាន់ និង មជ្ឈមណ្ឌល សង្គមកិច្ច ។
បើ តាម លោក រដ្ឋមន្ត្រី គម្រោង ខាងលើ នេះ បាន ផ្តល់ ឱកាស ការងារ ដល់ អ្នកគ្រប់គ្រង បុគ្គលិក អ្នកម្តាយ ថែទាំ កុមារ លោកគ្រូ អ្នកគ្រូ សរុប ៣៤៥ នាក់ និង បាន ផ្តល់ សេវា ដល់ កុមារ និង យុវជន កំពុង ស្នាក់ នៅ សរុប ៧៥៥ នាក់ ព្រមទាំង បាន ផ្តល់ ឱកាស សិក្សា ដល់ សិស្ស ចំនួន ១. ៤៩៦ នាក់ ។ ក្នុង ការអនុវត្ត គម្រោង កន្លងមក រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ក្នុង នាម ជា សមាជិកភាព នៃ ភូមិ កុមារ SOS ក៏ បាន ផ្តល់ ភាគ ទាន ចំនួន ១ម៉ឺន ដុល្លារ អាមេរិក ក្នុង មួយ ឆ្នាំ ផងដែរ ។
លោក រដ្ឋមន្ត្រី វង សូត បាន ឱ្យដឹង បន្ថែម ទៀត ថា សម្រាប់ គម្រោង ប្រតិបត្តិការ រយៈពេល ៥ឆ្នាំ បន្ត នៅក្នុង ប្រទេស កម្ពុជា ចាប់ពី ឆ្នាំ ២០២០ - ២០២៥ អង្គការ ភូមិ កុមារ SOS គ្រោង នឹង ចំណាយ ថវិកា ក្នុង រង្វង់ ២៥ លាន ដុល្លារ អាមេរិក ។ អង្គការ ក៏ មាន គម្រោង បង្កើត ភូមិ កុមារ ទី៨ នៅក្នុង ខេត្ត ត្បូងឃ្មុំ ផងដែរ ៕
យោង ចំណារ ឯកភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ សម្រេច ដូច ខាងក្រោម៖
ការបញ្ជាក់ ជាថ្មី បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្ដេច តេជោ ហ៊ុន សែន អញ្ជើញ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ « ភូមិ កុមារ SOS» ស្ថិត នៅក្នុង ខេត្ត ព្រៃវែង នា ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ នៅតែ បញ្ជាក់ យើង ចុះ ចិត្ដ ទទួល ប្រជាពលរដ្ឋ មកពី អាហ្គានីស្ថាន ប៉ុន្ដែ ខ្ញុំ នៅតែ មិន អនុញ្ញាត ឲ្យ ប្រជាពលរដ្ឋ កម្ពុជា ធ្វើ ទាហាន ស្ម័គ្រចិត្ដទៅ ច្បាំង នៅ អ៊ុយក្រែន » ។
សម្ដេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ថា ប្រទេស ណា ចង់ ទៅ សូម ទៅ ៗ សូមអញ្ជើញ ប៉ុន្ដែ ពលរដ្ឋ កម្ពុជា ហាម ដោយ សម្ដេច បញ្ជាក់ ថា ការធ្វើ បែប នេះ ដូចជា ការយក សាំង ទៅ ចាក់ លើ ភ្លើង អីចឹង ។
សម្ដេច តេជោ បន្ដ ថា ទុកឲ្យ គេចរចា ទុកឲ្យ គេ ស្វែងរក ដំណោះស្រាយ ទៅ ប៉ុន្តែ ដល់ ថ្នាក់ ស្ម័គ្រចិត្ត ដើម្បី ទៅ ធ្វើ ទាហាន នៅ អ៊ុយក្រែន និង ទទួលបាន សញ្ជាតិ អ៊ុយក្រែន ទៀត នោះ គឺ សម្ដេច មិន លើកទឹកចិត្ដ នោះ ឡើយ ។
ទន្ទឹម គ្នា នេះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន ឲ្យដឹង ផងដែរ ថា បើ ក្នុង ករណី ដែល មាន ជនជាតិ អ៊ុយក្រែន ភៀសខ្លួន មកដល់ កម្ពុជា គឺ កម្ពុជា នឹង ទទួល ។
សូម ជម្រាប ថា រហូតមកដល់ ពេលនេះ សង្គ្រាម នៅ អ៊ុយក្រែន ដែល កើតឡើង ដោយសារ វាយ លុយ ពីសំណាក់ កងទ័ព រុស្ស៉ី បាន អូស អន្លាយ រយៈពេល ២១ ថ្ងៃ មក ហើយ ៕
រដ្ឋមន្រ្តី ការបរទេស អារ៉ាប៊ី សាអូឌីត ដែល ជា សែរាជ វង្ស នឹង យាង មក បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ កម្ពុជា ថ្ងៃស្អែក នេះ
( ភ្នំពេញ ) ៖ ព្រះអង្គម្ចាស់ ហ្វាសាល់ ប៊ីន ហ្វា ហាន់ អាល់ សូដ រដ្ឋមន្រ្តី ការបរទេស នៃ ព្រះរាជាណាចក្រ អារ៉ាប៊ី សាអូឌីត នឹង ដឹកនាំ គណៈប្រតិភូ យាង មក បំពេញ ព្រះរាជ ទស្សនកិច្ច ផ្លូវការ នៅ កម្ពុជា នៅ ថ្ងៃទី ១៨ ខែមីនា ឆ្នាំ ២០២២ ស្អែក នេះ តប តាម ការយាង របស់ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា ។
សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបរទេស ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ឱ្យដឹង ថា ក្នុង ឱកាស នៃ ព្រះរាជ ទស្សនកិច្ច នេះ ព្រះអង្គម្ចាស់ ហ្វាសាល់ ប៊ីន ហ្វា ហាន់ អាល់ សូដ នឹង មាន ជំនួប ទ្វេ ភាគី ជាមួយ ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន ដើម្បី ពិភាក្សា លើ ទិដ្ឋភាព ផ្សេង ៗ នៃ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ នានា ក៏ ដូចជា បញ្ហា តំបន់ និង អន្តរជាតិ ដែល ជា ផលប្រយោជន៍ និង ក្តីបារម្ភ រួម ។
ក្រសួង ការងារ បំភ្លឺ អំពី ភាពយឺតយ៉ាវ ក្នុង នីតិវិធី ស្នើ នៅ ក្រៅ ឃុំ របស់ អតីត បុគ្គលិក ណាហ្គាលដ៍ ៣នាក់ ហើយ រំពឹង ថា នឹង មាន ការដោះលែង ឱ្យ នៅ ក្រៅ ឃុំ ឆាប់ ៗ
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តី បំភ្លឺ មួយ អំពី ភាពយឺតយ៉ាវ ក្នុង នីតិវិធី ស្នើ នៅ ក្រៅ ឃុំ ជា បណ្តោះអាសន្ន របស់ អតីត បុគ្គលិក ណាហ្គាលដ៍ ៣នាក់ ដោយសារតែ ពួកគេ មិន ទាន់ បាន ដក ពាក្យ បណ្តឹង នៅ សាលាឧទ្ធរណ៍ ។
ទោះជា យ៉ាង នេះ ក្តី ក្រសួង ការងារ រំពឹង ថា អតីត បុគ្គលិក ទាំង ៣នាក់ អាចនឹង ត្រូវបាន ដោះលែង ឱ្យ នៅ ក្រៅ ឃុំ ជា បណ្តោះអាសន្ន ពេល ឆាប់ ៗ នេះ ខណៈ ដែល ពួកគេ កំពុង ស្នើសុំ ដក ពាក្យ បណ្តឹង របស់ ខ្លួន នៅ សាលាឧទ្ធរណ៍ ផងដែរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បែប នេះ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី១៧ ខែមីនា ឆ្នាំ ២០២២ ក្នុង ឱកាស អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ « ភូមិ កុមារ SOS» ស្ថិត នៅក្នុង ខេត្ត ព្រៃវែង ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី មានប្រសាសន៍ បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ម្សិលមិញ ខ្ញុំ មាន ឱកាស ពិភាក្សា ជាមួយ ប្រធាន ធនាគារ ពិភពលោក ដែល កម្ពុជា ត្រូវ ធ្វើជា អ្នក រៀបចំ កិច្ចសន្ទនា សកល លើ បញ្ហា ពាក់ព័ន្ធ ជាមួយនឹង អាស៊ាន ។ កម្ពុជា នឹង រៀបចំ កិច្ចសន្ទនា សកល លើក ទី២ ដែល លើក ទី១ ធ្វើ នៅ ឆ្នាំ ២០១២ ដោយ មាន ការចូលរួម ពី តួអង្គ អាស៊ាន ដៃ គួរ អាស៊ាន និង យើង អញ្ជើញ មូលនិធិ រូបិយវត្ថុ អន្តរជាតិ (IMF) ធនាគារ ពិភពលោក (WB) ធនាគារ អភិវឌ្ឍន៍ អាស៉ី (ADB) ។ លើក នេះ យើង អាច ទាញ នូវ បណ្តា ដៃគូ ដទៃ ទៀត ដើម្បី ចូលរួម » ។
ប្រមុខ ដឹកនាំ កំពូល រាជ រដ្ឋាភិបាល កម្ពុជា បាន ថ្លែង បន្ថែម ថា កម្ពុជា ក៏ កំពុង ជ្រើសរើស ប្រធានបទ ដែល ប្រធានបទ នោះ ពិតជា នឹង មាន និយាយ ពី បញ្ហា សេដ្ឋកិច្ច អំឡុង ពេល កូវីដ១៩ និង ក្រោយ កូវីដ១៩ ជាដើម ។
បើ តាម ប្រសាសន៍ សម្តេច តេជោ ហ៊ុន សែន បាន ឲ្យដឹង ទៀត ថា កម្ពុជា បាន សម្រេច លុបចោល ការបញ្ជាក់ ធ្វើតេស្ត រក កូវីដ១៩ តាម ម៉ាស៉ីន PCR មុន ចូលមក កម្ពុជា រយៈពេល ៧២ ម៉ោង ហើយ កម្ពុជា ក៏ សម្រេច លុបចោល ការធ្វើតេស្តរហ័ស នៅពេល មកដល់ កម្ពុជា និង អនុញ្ញាតឲ្យ ដំណើរការ ឡើងវិញ នូវ ការផ្តល់ ការទិដ្ឋាការ ពេល មកដល់ សម្រាប់ អ្នកដំណើរ អន្តរជាតិ ផងដែរ ដែល នេះ ជា វិធីសាស្ត្រ ទាក់ទាញ ការវិនិយោគ ជួយ ដល់ សេដ្ឋកិច្ច បាន មួយ ផ្នែក ៕
ថ្លែង ក្នុង ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ « ភូមិ កុមារ SOS» ស្ថិត នៅក្នុង ខេត្ត ព្រៃវែង នា ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ បាន រំលឹក អំពី ការហាមឃាត់ របស់ សម្តេច ចំពោះ ពលរដ្ឋ កម្ពុជា ដែល ចង់ ធ្វើជា ទាហាន ស្ម័គ្រចិត្ត ទៅ ជួយ អ៊ុយក្រែន ដែល ជា ការចាក់ សាំង នៅលើ ភ្លើង ។
សម្តេច បាន បញ្ជាក់ ដូច្នេះ ថា៖ « ខ្ញុំ មិន លើកទឹកចិត្ត ទេ អា រឿង ហ្នឹង ប៉ុន្តែ ក្នុង ករណី ដែល មាន ជនជាតិ អ៊ុយក្រែន ភៀសខ្លួន មកដល់ កម្ពុជា អា ហ្នឹង យើង ត្រូវតែ ឱ្យ នៅ ហើយ » ។
សង្រ្គាម រវាង រុស្ស៉ី និង អ៊ុយក្រែន បាន ឈានចូល ដល់ សប្តាហ៍ ទី៣ ខណៈ ដែល ការចរចា ក៏ បាន ឈានដល់ ជុំ ទី៤ ផងដែរ ។ កិច្ចចរចា ប៉ុន្មាន លើក មក នេះ រវាង ទីក្រុង កៀវ និង ទីក្រុង មូស្គូ មកទល់ ពេលនេះ ទទួលបាន ផ្តល់ លទ្ធផល តិចតួច ស្តួចស្តើង ប៉ុណ្ណោះ ក្រៅតែ ពី ការបង្កើត ច្រក របៀង មនុស្សធម៌ ដើម្បី ជម្លៀស ប្រជាជន ចេញ ពី ទីក្រុង របស់ អ៊ុយក្រែន មួយចំនួន ដែល រង ការវាយប្រហារ ធ្ងន់ធ្ងរ ពីសំណាក់ យោធា រុស្ស៉ី ។
បើ តាម ការិយាល័យ ឧត្តម ស្នងការទទួលបន្ទុក ជនភៀសខ្លួន នៃ អង្គការ សហ ប្រជាជាតិ បាន ឲ្យដឹង ថា ជនភៀសខ្លួន អ៊ុយក្រែន ជាង ៣លាន នាក់ បាន ទៅដល់ បណ្ដា ប្រទេស ជិតខាង អ៊ុយក្រែន ចាប់តាំងពី សង្រ្គាម ជាមួយ រុស្ស៉ី ផ្ទុះឡើង កាលពី ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ២០២២មក ។
តៃ វ៉ា់ន់ ធ្វើ សមយុទ្ធ យោធា បាញ់ គ្រាប់ ពិត នៅលើ កោះ ស្ថិត នៅក្បែរ ប្រទេស ចិន
( តៃ ប៉ិ) ៖ យោធា តៃវ៉ាន់ បាន ធ្វើ សមយុទ្ធ យោធា នៅលើ កោះ មួយ ដែល មាន ចម្ងាយ មិន ដល់ ៥០ គីឡូម៉ែត្រ ឡើយ ពី ប្រទេស ចិន ជាមួយ ការបាញ់ គ្រាប់ ពិត ទៅកាន់ គោលដៅ ត្រូវបាន កំណត់ ហើយ សមយុទ្ធ យោធា នេះ ធ្វើឡើង ចំពេល មាន ការព្រួយបារម្ភ កាន់តែ ខ្លាំង ឡើង នៅក្នុង ទីក្រុង តៃ ប៉ិថា ការវាយប្រហារ របស់ រុស្ស៊ី លើ អ៊ុយក្រែន អាច ជម្រុញឲ្យ ទីក្រុង ប៉េកាំង ចាប់ផ្តើម ប្រតិបត្តិការ ស្រដៀង គ្នា នេះ ។ នេះ បើ យោង តាម ការចុះផ្សាយ របស់ សារព័ត៌មាន RT នៅ ថ្ងៃព្រហស្បតិ៍ ទី១៧ ខែមីនា ឆ្នាំ ២០២២ ។
គួរ បញ្ជាក់ ថា ដុង យីន គឺជា កោះ មួយ ក្នុង ចំណោម កោះ ជាច្រើន ដែល គ្រប់គ្រង ដោយ តៃវ៉ាន់ ស្ថិត នៅ ជិត ឆ្នេរសមុទ្រ ចិន ។ ទីក្រុង តៃ ប៉ិ ត្រូវបាន គេ រាយការណ៍ ថា កំពុង រៀបចំ ផែនការធ្វើ សមយុទ្ធ ដើម្បី ពង្រឹង សមត្ថភាព ការពារ របស់ ខ្លួន លើ កូន កោះ ជាច្រើន ចំពេល មាន ការព្រួយបារម្ភ កាន់តែ ខ្លាំង ឡើង ថា ចិន នឹង ដណ្តើមយក កោះ មួយ ឬ ច្រើន ដើម្បី បង្ខំ ឲ្យ មាន ការចរចា បង្រួបបង្រួម ជាមួយ តៃ ប៉ិ៕
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២២ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៤. ៦២៤ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣០. ៤០៧ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៤៩ នាក់ ៕ ឧកញ៉ា គួច ផេង អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក ហ៊ុន ម៉ានី ដែល បាន ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ឧបាសិកា សុខ អ៉ីម
( ភ្នំពេញ ) ៖ ឧកញ៉ា គួច ផេង អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ ដល់ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ដែល បាន ចូលរួម រំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ គ្រួសារ របស់ លោក ចំពោះ មរណភាព ឧបាសិកា សុខ អ៉ីម ។
ឧកញ៉ា គួច ផេង បាន ថ្លែង ថា « តាង នាម អោយ ក្រុមគ្រួសារ ខ្ញុំបាទ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ ឯកឧត្តម ប្រធាន និង លោកជំទាវ ព្រមទាំង សមាជិក សមាជិកា នៃ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ទាំងអស់ ដែល បាន ចូលរួម រំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ គ្រួសារ ខ្ញុំ ចំពោះ មរណភាព ឧបាសិកា សុខ អ៉ីម ដែល ត្រូវ ជា ម្តាយ ម្តាយ ក្មេក និង ជីដូន ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជា ទី គោរព ស្រលាញ់ របស់ យើងខ្ញុំ » ។
សារលិខិត រំលែក ទុក្ខ របស់ ឯកឧត្តម ប្រធាន បាន បញ្ជាក់ ពី ការយកចិត្ត ទុក្ខ ដាក់ ស្រលាញ់ រាប់អាន ដ៏ ជ្រាលជ្រៅ បំផុត ចំពោះ រូប ខ្ញុំបាទ និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ ដែល ធ្វើ អោយ ខ្ញុំបាទ បំភ្លេច មិន បាន នូវ សមាន ចិត្ត របស់ ឯកឧត្តម ប្រធាន និង លោកជំទាវ ព្រមទាំង សមាជិក សមាជិកា សហភាព សហព័ន្ធ យុវជន កម្ពុជា ទាំងអស់ ។
ខ្ញុំ សូម បួងសួង ចំពោះ គុណ បុណ្យ ព្រះរតនត្រ័យ និង វត្ថុ ស័ក្តិសិទ្ធិ ទាំងឡាយ ក្នុង លោក ទេវតា តាម ថែរក្សា ទឹកដី នៃ ព្រះរាជា - ណាចក្រ កម្ពុជា សូម ជួយ តាម ថែរក្សា ការពារ និង ប្រទាន ពរ ជ័យ បវរ សួស្តី ជ័យ មង្គល និង វិបុល សុខ គ្រប់ ប្រការ ជូន ចំពោះ ឯកឧត្តម ប្រធាន និង លោកជំទាវ ព្រមទាំង សមាជិក សមាជិកា សហភាព សហព័ន្ធ យុវជន កម្ពុជា ទាំងអស់ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ឧកញ៉ា គួច ផេង អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា ផ្ញើ លិខិត ថ្លែងអំណរគុណ អ្នក ឧកញ៉ា គិត ម៉េង ដែល បាន ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ឧបាសិកា សុខ អ៉ីម
( ភ្នំពេញ ) ៖ ឧកញ៉ា គួច ផេង អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ ដល់ អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា ដែល បាន ចូលរួម រំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ គ្រួសារ របស់ លោក ចំពោះ មរណភាព ឧបាសិកា សុខ អ៉ីម ។
ឧកញ៉ា គួច ផេង បាន ឲ្យដឹង ថា « តាង នាម អោយ ក្រុមគ្រួសារ ខ្ញុំបាទ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ អ្នក ឧកញ៉ា ប្រធាន និង លោកជំទាវ អ្នក ឧកញ៉ា ឧកញ៉ា និង បងប្អូន សមាជិក សមាជិកាសភា ពាណិជ្ជកម្ម កម្ពុជា ទាំងអស់ ដែល បាន ចូលរួម រំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ គ្រួសារ ខ្ញុំ ចំពោះ មរណភាព ឧបាសិកា សុខ អ៉ីម ដែល ត្រូវ ជា ម្តាយ ម្តាយ ក្មេក និង ជីដូន ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជា ទី គោរព ស្រលាញ់ របស់ យើងខ្ញុំ » ។
សារលិខិត រំលែក ទុក្ខ របស់ អ្នក ឧកញ៉ា ប្រធាន បាន បញ្ជាក់ ពី ការយកចិត្ត ទុក្ខ ដាក់ ស្រលាញ់ រាប់អាន ដ៏ ជ្រាលជ្រៅ បំផុត ចំពោះ រូប ខ្ញុំបាទ និង ភរិយា ព្រម ទាំង ក្រុមគ្រួសារ ដែល ធ្វើអោយ ខ្ញុំបាទ បំភ្លេច មិន បាន នូវ សមាន ចិត្ត របស់ អ្នក ឧកញ៉ា ប្រធាន និង លោកជំទាវ អ្នក ឧកញ៉ា ឧកញ៉ា និង បងប្អូន ទាំងអស់ ដែល ជា សមាជិក សមាជិកា សភា ពាណិជ្ជកម្ម កម្ពុជា ទាំងអស់ ។
ខ្ញុំ សូម បួងសួង ចំពោះ គុណ បុណ្យ ព្រះរតនត្រ័យ និង វត្ថុ ស័ក្តិសិទ្ធិ ទាំងឡាយ ក្នុង លោក ទេវតា តាម ថែរក្សា ទឹកដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា សូម ជួយ តាម ថែរក្សា ការពារ និង ប្រទាន ពរ ជ័យ បវរ សួស្តី ជ័យ មង្គល និង វិបុល សុខ គ្រប់ ប្រការ ជូន ចំពោះ អ្នក ឧកញ៉ា ប្រធាន និង លោកជំទាវ អ្នក ឧកញ៉ា ឧកញ៉ា និង បងប្អូន សមាជិក សមាជិកាសភា ពាណិជ្ជកម្ម កម្ពុជា ទាំងអស់ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បញ្ជាក់ ថា នៅ ឆ្នាំ ២០២២ នេះ សម្តេច មាន ភារកិច្ច ច្រើន ក្នុង ចេញ ទៅ បំពេញ ការងារ នៅ ក្រៅ ប្រទេស ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា « បើ គ្មាន ការប្រែប្រួល ទេ នៅ ខែមេសា ក្រោយ ចូល ឆ្នាំ ខ្មែរ ខ្ញុំ អាច ទៅ ជប៉ុន ដើម្បី ចូលរួម ប្រជុំ ដោយ ផ្ទាល់ អំពី បញ្ហា ទឹក ។ ដំបូង ទម្រង់ ដើម ចង់ ប្រជុំ តាម អនឡាញ ទេ ក៏ប៉ុន្តែ ដោយសារតែ សភាពការណ៍ ធូរស្រាល គេ កំពុង គិត អំពី ការប្រជុំ តាម អនឡាញ ផង និង ប្រជុំ ផ្ទាល់ ផង ។ ដោយឡែក កម្ពុជា វេទិកា ផ្នែក ទឹក នេះ អញ្ជើញ ទៅ ផ្ទាល់ ដូច្នេះ លទ្ធភាព ដែល ខ្ញុំ ធ្វើដំណើរ ទៅកាន់ ប្រទេស ជប៉ុន ដើម្បី ចូលរួម ការប្រជុំ នោះ » ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា បន្ទាប់ពី បំពេញ ទស្សនកិច្ច នៅ ប្រទេស ជប៉ុន រួចហើយ នៅ ខែឧសភា ឆ្នាំ ២០២២ សម្តេច នឹង ធ្វើដំណើរ ទៅ ចូលរួម វេទិកា សេដ្ឋកិច្ច ពិភពលោក ដែល រៀបចំឡើង នៅ ប្រទេ ស្វីស ។ នៅពេល ត្រឡប់ មកពី ប្រទេស ស្វីស វិញ សម្តេច ក៏ មាន កិច្ចប្រជុំ តាម អនឡាញ ជាមួយ មេដឹកនាំ បណ្តា ប្រទេស ផ្សេង ៗ នៅលើ ពិភពលោក រួមទាំង នាយក រដ្ឋមន្ត្រី ជប៉ុន ផងដែរ ស្តី អំពី អនាគត អាស៊ី ។
សម្រាប់ កិច្ចប្រជុំ អាស៊ាន - អាមេរិក ដែល ត្រូវបាន លើក ពេល នោះ ត្រូវបាន សម្តេច តេជោ ថ្លែង ថា នៅ មិន ទាន់ ដឹង ពី ពេលវេលា ច្បាស់លាស់ នោះ ទេ គឺ ទុក តួនាទី រៀបចំ សម្របសម្រួល ដោយ ភាគី ឥណ្ឌូនេស៊ី ៕
ក្នុង ថ្ងៃ ដដែល នេះ កូរ៉េ ខាងត្បូង ក៏ បាន រាយការណ៍ ពី ករណី ស្លាប់ ថ្មី ច្រើន បំផុត ផងដែរ គឺ ៤២៩ នាក់ នាំឱ្យ ចំនួន អ្នកជំងឺ ស្លាប់ សរុប កើន ដល់ ១១. ៤៨១ នាក់ ។ កូរ៉េ ខាងត្បូង បាន មើលឃើញ ការកើនឡើង ខ្លាំង នៃ ករណី ឆ្លង ប្រចាំ ថ្ងៃ ចាប់តាំងពី ខ្លួន បាន រាយការណ៍ តួលេខ ៥ខ្ទង់ ជា លើក ដំបូង កាលពី ចុង ខែមករា ឆ្នាំ នេះ ហើយ ចាប់តាំងពី នោះ មក ករណី ឆ្លង ប្រចាំ ថ្ងៃ កើន បន្ត កើន យ៉ាង ឆាប់រហ័ស បំផុត ដោយ ឡើង លើស៣០០.០០០ នាក់ ជា លើក ដំបូង នៅ ថ្ងៃទី ០៩ ខែមីនា ។
គួរ បញ្ជាក់ ថា ការកើនឡើង នេះ គឺ ស្រប ពេល ដែល ប្រទេស កូរ៉េ ខាងត្បូង បាន និង កំពុង ព្យាយាម បន្ធូរបន្ថយ វិធានការរឹតត្បិត ដើម្បី ត្រឡប់ ទៅ រក ប្រក្រតី ភាព ឡើងវិញ ។ មកទល់ ឥឡូវ មនុស្ស ៣២. ២១លាន នាក់ ក្នុង ចំណោម ប្រជាជន កូរ៉េ ខាងត្បូង ៥២ លាន នាក់ ឬ ស្មើនឹង ៦២. ៨ភាគរយ បាន ចាក់ វ៉ាក់សាំង ដូស ជំរុញ ខណៈ អ្នក ទទួលបាន ការចាក់ វ៉ាក់សាំង ពេញលេញ មាន ចំនួន ៤៤. ៤៤លាន នាក់ ឬ ស្មើនឹង ៨៦.៦ភាគរយ នៃ ចំនួន ប្រជាជន សរុប ៕
ក្រុម រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច អាស៊ាន ចង់ ធ្វើឱ្យ ប្រសើរឡើង នូវ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី អាស៊ាន ជាមួយ ប្រទេស ផ្សេង ទៀត
កាសែត បាងកក ប៉ុស្តិ៍ បាន រាយការណ៍ ដោយ ដកស្រង់ សំដី របស់ លោកស្រី Auramon Supthaweethum អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ចរចា ពាណិជ្ជកម្ម របស់ ប្រទេស ថៃ ថា ក្រុម រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច រំពឹង ថា នឹង ពិភាក្សា អំពី ការស្តារ សេដ្ឋកិច្ច អាស៊ាន ឡើងវិញ ក្នុង គ្រា ដែល មាន ការរាត ត្បាត ជំងឺ និង យុទ្ធសាស្រ្ត អាស៊ាន សម្រាប់ ទំនាក់ទំនង សេដ្ឋកិច្ច ជាមួយ ប្រទេស មិន មែន ជា សមាជិក អាស៊ាន នៅក្នុង កិច្ចចង្អៀត រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច អាស៊ាន លើក ទី ២៨ ។
ក្នុង ចំណោម សមាជិក អាស៊ាន មាន តែ ប្រទេស មីយ៉ាន់ម៉ា ឥណ្ឌូនេស៊ី និង ហ្វីលីពីន ប៉ុណ្ណោះ ដែល មិន ទាន់ បាន ដាក់ ជូន ការផ្តល់ សច្ចាប័ន កិច្ចព្រមព្រៀង RCEP ទៅកាន់ លេខាធិការដ្ឋាន អាស៊ាន ។
RCEP ដែល ជា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម ធំ បំផុត ក្នុង ពិភពលោក បាន ចូល ជាធរមាន នៅ ដើម ឆ្នាំ នេះ បន្ទាប់ពី មាន ការផ្តល់ សច្ចាប័ន ដោយ ប្រទេស អាស៊ាន យ៉ាងហោចណាស់ ចំនួន ៦ និង ប្រទេស ហត្ថលេខី បី ផ្សេង ទៀត ៕
នៅក្នុង ឱកាស នោះ សម្តេច តេជោ ហ៊ុន សែន បាន អញ្ជើញ ថ្លែង សុន្ទរកថា ប្រមាណ ជាង ១ ម៉ោង . ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច តេជោ៖
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ដល់ សម្តេច ក្រឡាហោម ស ខេង ដែល បាន ឧបត្ថម្ភ ដល់ ការកសាង ភូមិ កុមារ SOS ដើម្បី ផ្តល់ ការថែទាំ និង ការរស់នៅ មួយ ដ៏ សម្រាប់ កុមារ កំព្រា និង កុមារ ខ្វះ ថែទាំ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា បាន ធ្វើ ការងារ ច្រើន ណាស់ ដើម្បី កុមារ ។ សម្តេច តេជោ បាន ថ្លែង ថា នៅលើ ពិភពលោក ដែល មាន កុមារ រងគ្រោះ ដូច កម្ពុជា នោះ ទេ ដោយសារតែ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត បន្សល់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា មាន មោទនភាព ចំពោះ កិច្ចប្រឹងប្រែង ជួយ ដល់ កុមារ ដោយ មិន ទុក កុមារ រងគ្រោះ ចោល នោះ ឡើយ ។
* សម្តេច តេជោ បាន ថ្លែង ថា កុមារ ដែល ចិញ្ចឹម បីបាច់ ដោយ អង្គការ កុមារ SOS ប្រមាណ ៤នាក់ បាន ក្លាយទៅជា វេជ្ជបណ្ឌិត . ៦នាក់ ក្លាយជា វិស្វករ . ៧នាក់ ក្លាយ អ្នកបម្រើការ នៅ ធនាគារ . ៣នាក់ ក្លាយជា ស្ថាបត្យករ . ២នាក់ ក្លាយជា អ្នករចនា និង ជាច្រើន នាក់ ទៀត បាន ក្លាយជា អ្នកបម្រើ ការងារ ក្នុង វិស័យ អាជីវកម្ម សេវា បម្រើ អតិថិជន និង បម្រើ ការងារ ក្នុង ជួរ រាជ រដ្ឋាភិបាល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា បាន ធ្វើ ការងារ ច្រើន ណាស់ ដើម្បី កុមារ ។ ក្នុង នោះ កម្ពុជា បង្កើត កម្មវិធី ទ្រទ្រង់ ដល់ កុមារ កំព្រា ប៉ុណ្ណោះ ទេ ។ តែ កម្ពុជា ក៏ បាន យកចិត្តទុកដាក់ លើ ម្តាយ និង កុមារ ដែល មាន ជីវភាព ខ្វះខាត ផងដែរ ។ ចាប់តាំងពី ឆ្នាំ ២០១៩មក មាន ម្តាយ និង កុមារ ជាង ២៥ម៉ឺន នាក់ ទទួលបាន ការឧបត្ថម្ភ ថវិកា ចាប់ផ្តើម ពី មាន ផ្ទៃពោះ ដល់ អាយុ ២ឆ្នាំ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា កំពុង ពិនិត្យ ក្នុង ការបង្កើន ថវិកា ឧបត្ថម្ភ ជូន ដល់ ម្តាយ និង កុមារ ក្នុង គ្រួសារ ក្រីក្រ ចាប់ពី ពេល មាន ផ្ទៃពោះ ដល់ អាយុ ២ ឆ្នាំ នៅពេល កម្ពុជា មាន ស្ថានភាព សេដ្ឋកិច្ចកាន់តែ ប្រសើរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច បាន សាងសង់ មជ្ឈមណ្ឌល សម្រាប់ កុមារី រងគ្រោះ ដោយ ការរំលោភបំពាន ពី ឪពុក ហើយក៏ បាន សាងសង់ សាលា សម្រាប់ កុមារ ពិការ ភ្នែក និង គរ ថ្លង់ ដែល ជា កិច្ចប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ដូចជា រូប សម្តេច និង សម្តេច ក្រឡាហោម កើត ក្នុង ស្ថានភាព មួយ ដ៏ លំបាក តែ ការប្រឹងប្រែង ក៏ បាន ក្លាយជា មេដឹកនាំ ជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន រំលឹក ថា សម្តេច ធ្លាប់ ស្តី ឱ្យ ជន បរទេស មួយចំនួន ដែល ទូន្មាន កម្ពុជា ដោយ សម្តេច បាន តប ទៅវិញ ថា ពួកគេ គ្រាន់តែ មាន ឱកាស កើត ក្នុង ប្រទេស អ្នក មាន ប៉ុណ្ណោះ តែ សមត្ថភាព មិន ប្រាកដ ថា ខ្លាំង ជាង ពលរដ្ឋ កម្ពុជា នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន រំលឹក ថា នៅពេល មាន ជំងឺ កូវីដ១៩ ផ្ទុះឡើង មាន សារព័ត៌មាន និង បណ្តា ប្រទេស មួយចំនួន បាន មើល ស្រាល កម្ពុជា ថា នឹង ជួប ស្ថានភាព អាក្រក់ ព្រោះ ជំងឺ កូវីដ១៩ នេះ ។ តែ ទីបំផុត កម្ពុជា បាន ក្លាយទៅជា ប្រទេស គ្រប់គ្រង ការរាត ត្បាត ជំងឺ កូវីដ១៩ បាន ល្អ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា សម្រេច លុបចោល ការបញ្ជាក់ ធ្វើតេស្ត រក កូវីដ១៩ តាម ម៉ាស៊ីន PCR មុន ចូលមក កម្ពុជា រយៈពេល ៧២ ម៉ោង ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា ក៏ សម្រេច លុបចោល ការធ្វើតេស្ត រហ័ស នៅពេល មកដល់ កម្ពុជា និង អនុញ្ញាតឱ្យ ដំណើរការ ឡើងវិញ នូវ ការផ្តល់ ការទិដ្ឋាការ ពេល មកដល់ សម្រាប់ អ្នកដំណើរ អន្តរជាតិ ។
