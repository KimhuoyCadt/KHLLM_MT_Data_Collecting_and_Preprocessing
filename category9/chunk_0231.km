( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៧ ខែមីនា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ ស្រាល ១៥ នាក់ ។
ទេសរដ្ឋមន្ដ្រី អូស្មាន ហាស្សាន់ បន្ដ ជួប ជាមួយ សកម្មជន និង ថ្នាក់ដឹកនាំ គណៈ ចលនា សាសនិក ឥស្លាម របស់ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ស្ទឹងត្រែង ដើម្បី ត្រៀម បោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់
ពិធី ខាងលើ ក៏ មាន ការអញ្ជើញ ចូលរួម ជា គណៈអធិបតី ពីសំណាក់ លោក ឈាង ឡាក់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង អនុប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ស្ទឹងត្រែង . លោក សុី សួង សមាជិក គណៈប្រចាំ ការ នៃ គណៈអចិន្ត្រៃយ៍ គណបក្ស ខេត្ត និង ប្រធាន មន្ទីរ គណបក្ស ប្រជាជា ជន ខេត្ត ស្ទឹងត្រែង លោក លោកស្រី ដែល ជា ថ្នាក់ដឹកនាំ គណៈ ចលនា សាសនិក ឥស្លាម កម្ពុជា និង សមាជិក សមាជិកា គណៈ ចលនា សាសនិក ឥស្លាម ខេត្ត ស្ទឹងត្រែង ជាច្រើន រូប ផងដែរ ។
ក្នុង ឱកាស នោះ ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ បាន លើកឡើង ពី ប្រវត្តិ នៃ ការបង្កើត គណកម្មការ គណៈ ចលនា សាសនិក ឥស្លាម របស់ គណបក្ស ប្រជាជន កម្ពុជា ដោយ ក្នុង ឆ្នាំ ១៩៩៨ គណៈ ចលនា នេះ ត្រូវបាន បង្កើតឡើង ដោយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
បន្ថែម ពី នេះ លោក បាន រំលឹក នូវ សមិទ្ធផល ដែល សហគមន៍ ឥស្លាម កម្ពុជា ទទួលបាន ពី រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន សហគមន៍ ឥស្លាម ទទួលបាន សិទ្ធិ ពេញលេញ ក្នុង ការរស់នៅ និង សិទ្ធិ ប្រតិបត្តិ សាសនា ។ លើស ពី នោះ ទៀត នោះ សហគមន៍ ឥស្លាម កម្ពុជា ក៏ មាន ឱកាស ចូលរួម បម្រើ ការងារ ជួរ រាជ រដ្ឋាភិបាល ជាច្រើន រូប ផងដែរ ។ ជាមួយគ្នា នោះ ដោយ ក្នុង ឆ្នាំ ២០១៥ រដ្ឋាភិបាល ក៏ បាន ផ្តល់ ជូន សហគមន៍ ឥស្លាម កម្ពុជា នូវ គ្រូ ក្របខ័ណ្ឌ រដ្ឋ ចំនួន ១. ៥០០ នាក់ ផងដែរ ។
លោក ទេសរដ្ឋមន្ដ្រី បាន ថ្លែងអំណរគុណ ដល់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ថ្មី ៗ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី បាន ស្នេី រៀបចំ ឲ្យ មាន យ៉ាងហោចណាស់ អភិបាល រង ស្រុក - ខណ្ឌ និង អភិបាល រង ខេត្ត ម្នាក់ ដែល មាន សម្ថភាព សម្រាប់ មូលដ្ឋាន ដែល មាន សាសនិក ឥស្លាម រស់ នៅ ច្រេីន ដើម្បី ភាពងាយស្រួល ទំនាក់ទំនង ក្នុង សហគមន៍ និង សុខដុម រមណី សាសនា ។
គួរ ជម្រាប ផងដែរ ថា ជា ចុងបញ្ចប់ នៃ ពិធី ខាងលើ គណៈ ចលនា សាសនិក ឥស្លាម របស់ គណបក្ស ប្រជាជន កម្ពុជា បាប ឧបត្ថម្ភ ថវិកា សម្រាប់ អ្នកចូលរួម ក្នុង ពិធី នេះ ដោយ ម្នាក់ ៗ ទទួលបាន ២មុឺន រៀល ៕
តួកគី៖ ពិភពលោក មិន អាច ដុត ចោល « ស្ពាន » ទំនាក់ទំនង ជាមួយ ប្រទេស រុស្ស៊ី ឡើយ
( អង់ការ៉ា) ៖ អ្នកនាំពាក្យ ប្រធានាធិបតី តួកគី បាន និយាយ ថា ប្រទេស តួកគី និង ប្រទេស ដទៃ ទៀត នៅតែ ត្រូវការ និយាយ ជាមួយ រុស្ស៊ី ដើម្បី ជួយ បញ្ចប់ សង្គ្រាម នៅ អ៊ុយក្រែន ដោយ បន្ថែម ថា ទីក្រុង កៀវ ត្រូវការ ការគាំទ្រ បន្ថែម ទៀត ដើម្បី ការពារ ខ្លួន ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន Reuters នៅ ថ្ងៃអាទិត្យ ទី ២៧ ខែមីនា ឆ្នាំ ២០២២ ។
សមាជិក នៃ អង្គការ សន្ធិសញ្ញា អាត្លង់ទិក ខាងជើង (NATO) ប្រទេស តួកគី គឺ មាន ទំនាក់ទំនង ល្អ ជាមួយ រុស្ស៊ី និង អ៊ុយក្រែន ហើយ បាន ព្យាយាម សម្រុះសម្រួល ក្នុង ជម្លោះ រយៈពេល ជាង មួយ ខែ មក នេះ ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង បរិស្ថាន៖ ធម្មជាតិ អាច អត់ មនុស្ស បាន ប៉ុន្តែ មនុស្ស មិន អាច រស់ បាន ដោយ គ្មាន ធម្មជាតិ បាន នោះ ទេ
នេះ ជា ការលើកឡើង របស់ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន នៅក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ក្នុង ព្រឹត្តិការណ៍ « មួយ ម៉ោង សម្រាប់ ភព ផែនដី » រៀបចំ ឡេីង នា ថ្ងៃទី ២៦ ខែមីនា ឆ្នាំ ២០២២ ។
ចលនា នៃ ទិវា នេះ បាន ផ្តល់ សារៈសំខាន់ ដល់ តួនាទី របស់ បុគ្គល ម្នាក់ ៗ ក្នុង ការចូលរួម ស្វែងរក ដំណោះស្រាយ ដើម្បី ឆ្លើយតប ទៅនឹង បញ្ហា ប្រឈម នៃ បរិស្ថាន សព្វ ថ្ងៃ ព្រមទាំង លើក គុណ តម្លៃ នៃ ឥទ្ធិពល មហាសាល នៃ ភាព រួម កម្លាំង សាមគ្គី គ្នា ដោយ មនុស្ស រាប់ លាន នាក់ ដើម្បី បង្កើត ឲ្យ មាន ការផ្លាស់ប្តូរ ជា វិជ្ជមាន សម្រាប់ ភព ផែនដី ទាំងមូល ។
ទាំង ក្នុង អំឡុង ពេល នៃ យុទ្ធនាការ ផ្សព្វផ្សាយ និង នៅក្នុង កម្មវិធី ធំ ថ្ងៃទី ២៦ ខែមីនា ឆ្នាំ ២០២២ ប្រជាជន នៅ កម្ពុជា និង នៅលើ ពិភពលោក នឹង និយាយ ចែករំលែក ចំណេះដឹង និង ពិភាក្សា អំពី សារៈសំខាន់ នៃ ធម្មជាតិ និង ភាពចាំបាច់ នៃ សាមគ្គីភាព រួមគ្នា ក្នុង ការការពារ បរិស្ថាន និង កសាង អនាគត មួយ សម្រាប់ ភព ផែនដី ប្រកបដោយ និរន្តរភាព ។
គួរ បញ្ជាក់ ផងដែរ ថា ការរៀបចំ ទិវា នេះ ក៏ មាន ដាក់បញ្ចាំង នូវ ផ្ទាំង ទស្សនីយភាពល្ខោន ស្បែក ដែល ជា កេរ្ត៍ មរតក វប្បធម៍ ខ្មែរ តាំង យូរ លុង មក របាំ ជនជាតិ ដេីម ភាគ តិច ពូនង និង ពូតាង សិល្ប: ចម្រៀង សម័យ និង មាន ការតាំង បង្ហាញ នូវ ផលិតផល កសិផល របស់ ប្រជា សហគមន៍ ផងដែរ ៕
ក្នុង របាយការណ៍ ថ្ងៃអាទិត្យ នេះ ដែរ ក្រសួង សុខាភិបាល វៀតណាម ក៏ បាន ប្រកាស ពី ករណី អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ៤៨ នាក់ បន្ថែម ទៀត ផងដែរ ។
( ភ្នំពេញ ) ៖ លោកជំទាវ កាំង ម៉េង ហ៊ុយ និង បុត្រ បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក លោកជំទាវ កាំង ម៉េង ហ៊ុយ និង បុត្រ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សមាគម និស្សិត កម្ពុជា ប្រចាំ ប្រទេស ចិន ជ្រើសរើស ប្រធាន ថ្មី របស់ សមាគម សម្រាប់ អាណត្តិ ទី៥
( ចិន ) ៖ សមាគម និស្សិត កម្ពុជា ប្រចាំ សាធារណរដ្ឋ ប្រជាមានិត ចិន បាន ជ្រើសរើស ប្រធាន សមាគម អាណត្តិ ទី៥ ដែល ពោរ ដោយ សមត្ថភាព ជាមួយ ក្តីសង្ឃឹម និស្សិត ខ្មែរ ដែល រង់ចាំ វិល ត្រលប់ ទៅ បន្ត ការសិក្សា នៅ ប្រទេស ចិន វិញ ក្នុង ឆ្នាំ ២០២២ ខាងមុខ នេះ ទាំងអស់ គ្នា ។
កាលពី ថ្ងៃទី ២៦ ខែមីនា ឆ្នាំ ២០២២ ក្រុមប្រឹក្សាភិបាល នៃ សមាគម និស្សិត កម្ពុជា ប្រចាំ សាធាណ រដ្ឋ ប្រជាមានិត ចិន ដែល ដឹកនាំ ដោយ លោក អ៊ុ វុទ្ធ ទី ជា ប្រធាន បាន រៀបចំ ការបោះឆ្នោត ជ្រើសតាំង កញ្ញា ហោ រស្មី ជា ប្រធាន សមាគម និស្សិត កម្ពុជា ប្រចាំ សាធារណរដ្ឋ ប្រជាមានិត ចិន អាណត្តិ ទី៥ សម្រាប់ ឆ្នាំ ២០២២ - ២០២៣ ។
បើ តាម កញ្ញា ប្រធាន សមាគម បាន ឲ្យដឹង ថា គិត មកដល់ ពេលនេះ មិន ទាន់ មាន បងប្អូន និស្សិត កម្ពុជា យើង បាន ត្រលប់ ទៅ បន្ត ការសិក្សា នៅ ប្រទេស ចិន ដោយ ផ្ទាល់ នៅឡើយ ទេ ប៉ុន្តែ និស្សិត មួយចំនួន ធំ ត្រូវបាន ខាង សាកលវិទ្យាល័យ នៅ ប្រទេស ចិន ដែល ពួកគាត់ សិក្សា បាន អនុញ្ញាតឲ្យ ពួកគាត់ វិល ត្រលប់ ទៅវិញ បាន តាមរយៈ បញ្ជី ឈ្មោះ របស់ ស្ថានទូត ចិន ព្រមទាំង ការជូនដំណឹង របស់ សាកលវិទ្យាល័យ ។
នា ពេល ថ្មី ៗ នេះ គណៈ គ្រប់គ្រង ក្រុមប្រឹក្សាភិបាល អាហារូបករណ៍ រដ្ឋាភិបាល ចិន ដែល ហៅ កាត់ ថា “CSC” បាន ធ្វើ សេចក្តីប្រកាស ជា សាធារណរៈ និស្សិត បរទេស ទាំងអស់ នឹង បាន ធ្វើ ត្រលប់ ទៅ បន្ត ការសិក្សា នៅ ប្រទេស ចិន វិញ នៅ ដើម ខែកញ្ញា ឆ្នាំ ២០២២ ដែល ជាដើម ឆមាស ថ្មី ឆ្នាំ សិក្សា ថ្មី ផងដែរ ។
ទាំងនេះ ជា មូលហេតុ ដែល និស្សិត ស្ទើរតែ ទាំងអស់ គ្នា មិន មាន លទ្ធភាព ចំណាយ ក្នុង ការ ត្រលប់ ទៅ បន្ត សិក្សា នៅ ឆមាស ទី២ ក្នុង ខែមីនា ឆ្នាំ ២០២២ នេះ ។
( ភ្នំពេញ ) ៖ លោកជំទាវ ម៉ែន ភក្ដី ហុកឡង់ ឌី បាន បរិច្ចាគ ថវិកា ចំនួន ៥.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក លោកជំទាវ ម៉ែន ភក្ដី ហុកឡង់ឌី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម លីវ ម៉ូវ និង លោកជំទាវ ហូ សារ៉េត បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្តម លីវ ម៉ូវ និង លោកជំទាវ ហូ សារ៉េត បាន បរិច្ចាគ ថវិកា ចំនួន ២.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្តម លីវ ម៉ូវ និង លោកជំទាវ ហូ សារ៉េត តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្ដម បណ្ឌិត សភាចារ្យ ច័ន្ទ សារុន តំណាងរាស្រ្ត មណ្ឌល ខេត្ត តាកែវ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម បណ្ឌិត សភាចារ្យ ច័ន្ទ សារុន និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក អូរ រាំង ឪ លើកឡើង ពី ការដឹកនាំ ដ៏ ល្អ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល នាំមក នូវ សន្តិភាព និង ការអភិវឌ្ឍ គ្រប់ វិស័យ
( ភ្នំពេញ ) ៖ លោក ខ្វៃ អាទិត្យា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ បាន លើកឡើង អំពី ការដឹកនាំ ដ៏ ល្អ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល នាំមក នូវ សន្តិភាព និង ការអភិវឌ្ឍ គ្រប់ វិស័យ ហើយ កំពុង បន្ត ដឹកនាំ ប្រទេស ឆ្ពោះទៅ វឌ្ឍនភាព សម្បូរ រុងរឿង ។
បាន ថ្លែង ថា ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា តែងតែ យកចិត្តទុកដាក់ ដល់ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ នៅ គ្រប់ កាលៈទេសៈ ។
លោក ខ្វៃ អាទិត្យា បាន លើកឡើង បន្ថែម ថា ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា បាន លះបង កម្លាំង កាយ កម្លាំងចិត្ត យក អាយុជីវិត ធ្វើជា ដើមទុន តស៊ូ រំដោះ ប្រទេសជាតិ កសាង ការពារ បង្រួបបង្រួម ជាតិ និង នាំយក សន្តិភាព ស្ថេរភាព នយោបាយ និង ការអភិវឌ្ឍ ជូន ជាតិ មាតុភូមិ ។
ទន្ទឹមនឹង នេះ ដោយសារ ការមើលឃើញ ជាក់ស្តែង អំពី ការដឹកនាំ ដ៏ ល្អ របស គណបក្ស ប្រជាជន កម្ពុជា លោក ក៏ បាន លើកទឹកចិត្ត ដល់ បេក្ខជន ក្រុមប្រឹក្សា ឃុំ ថ្នាក់ដឹកនាំ គណបក្ស នៅ ក្នុង មូលដ្ឋាន បន្ត យកចិត្តទុកដាក់ ខ្ពស់ បន្ថែម ទៀត ក្នុង ការសម្របសម្រួល ដោះស្រាយ បញ្ហា ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ និង ឆាប់រហ័ស ធានា ឱ្យ បាន នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ ល្អ ជូន ប្រជាពលរដ្ឋ ជាពិសេស ផ្សព្វផ្សាយ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ កុំ ជឿ ការបំពុល កុំ ជឿ ការញុះញង់ ដែល អាច បង្កឲ្យ មាន អសន្តិសុខ ដល់ សង្គមជាតិ ។
ប្រធាន ប្រតិភូ បាន ថ្លែងអំណរគុណ ថ្នាក់ដឹកនាំ បក្ស មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ នៃ ឃុំ ព្រះធាតុ បាន ខិតខំ និង បម្រើ ដោយ ស្ម័គ្រចិត្ត ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា ជាពិសេស ត្រូវ ខិតខំ បន្ថែម ដើម្បី គណបក្ស ប្រជាជន កម្ពុជា ។
សូម បញ្ជាក់ ថា លោក ខ្វៃ អាទិត្យា និង ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ ព្រះធាតុ លោក ជៀប ប៊ុន អៀង អនុប្រធាន ក្រុមការងារ ឃុំ ព្រះធាតុ លោក សា សេរី អនុប្រធាន លេខាធិការដ្ឋាន ឃុំ ព្រះធាតុ និង លោក ហេង សុវណ្ណា ជា ប្រធាន ក្រុមការងារ ទទួលបន្ទុក ភូមិ ទួល ឃ្លាំង បាន ជួប សំណេះសំណាល ជាមួយ បេក្ខជន ក្រុមប្រឹក្សា ឃុំ ប្រធាន ក្រុម បក្ស និង ថ្នាក់ដឹកនាំ បក្ស នៅ មូលដ្ឋាន ភូមិ ទួល ឃ្លាំង នៃ ឃុំ ព្រះធាតុ ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ នា ថ្ងៃទី ២៦ ខែមីនា ឆ្នាំ ២០២២ ម្សិលមិញ ។
បន្ទាប់ពី ពិធី សំណេះសំណាល នេះ ក្រុមការងារ បាន ចុះ ជួបប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ក្នុង នោះ បាន ចែកជូន ស្បៀង ជូន ប្រជាពលរដ្ឋ ជា ស្រ្តី មេម៉ាយ ជួប ការលំបាក ចំនួន ១គ្រួសារ រួម មាន ត្រីខ ១យួរ មី ១កេស តូច ទឹក សុទ្ធ ១កេស ថវិកា មួយ ចំនួន និង បាន ចូលរួម រំលែក ទុក្ខ គ្រួសារ សព សមាជិក គណបក្ស នៅ ក្នុង មូលដ្ឋាន ថវិកា ចំនួន ២០០.០០០ រៀល ផងដែរ ៕
( ភ្នំពេញ ) ៖ លោកជំទាវ បណ្ឌិត សភាចារ្យ ភឿង ស កុណា រដ្ឋមន្រ្តី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម ខៀវ កាញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម កិត្តិ សេដ្ឋា បណ្ឌិត ចម ប្រសិទ្ធ និង លោកជំទាវ បរិច្ចាគ ថវិកា ៥ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្ដម កិត្តិ សេដ្ឋា បណ្ឌិត ចម ប្រសិទ្ធ ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្រ្ត បច្ចេកវិទ្យា និង ន វានុវត្តន៍ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ៥.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម កិត្តិ សេដ្ឋា បណ្ឌិត ចម ប្រសិទ្ធ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៦០១ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២៧ ខែមីនា ឆ្នាំ ២០២២
