( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត មុនពេល បើក ការពិនិត្យ និង ព្យាបាល ជំងឺ ទូទៅ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ នា ព្រឹក ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០២២ នៅ ភូមិឡ ឥដ្ឋ សង្កាត់ បឹង កុក ក្រុង កំពង់ចាម ។
លោក អភិបាល ខេត្ត បាន ថ្លែង បន្ត ថា ពិត ណាស់ នៅក្នុង ខេត្ត កំពង់ចាម មាន មណ្ឌល សុខភាព មន្ទីរពេទ្យ បង្អែក និង គ្លីនិក ឯកជន ទំនើប ៗ ជាច្រើន ប៉ុន្តែ ការបង្កើត ឲ្យ មាន ក្រុម គ្រូពេទ្យ ជំនាញ ចុះ ពិនិត្យ និង ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ នៅ ពេល នេះ គឺ ក្នុង គោលបំណង ដើម្បី លើក កំពស់ គុណភាព ជីវភាព រស់ នៅ របស់ បងប្អូន ប្រជាពលរដ្ឋ ក៏ ដូចជា ការរួមចំណែក កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ យើង ផងដែរ ។
( ភ្នំពេញ ) ៖ បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្រ្តី រាជការ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង បើក ប្រាក់ ប្រចាំ ខែមីនា សម្រាប់ ២សប្តាហ៍ លើក ទី១ ជូន និវត្ត ជន និង អតីត មន្ត្រីរាជការ ស៊ីវិល ចាប់ពី ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២២ត ទៅ តាម ប្រព័ន្ធ ធនាគារ កាណាឌីយ៉ា និង ធនាគារ អេស៊ីលីដា នៅ ២៥ រាជធានី - ខេត្ត ទូទាំង ប្រទេស ។
យោង តាម សេចក្តីជូនដំណឹង របស់ បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្រ្តី រាជការ ស៊ីវិល ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន បញ្ជាក់ ថា « ប្រាក់ គោល នយោបាយ របប សន្តិសុខ សង្គម ប្រចាំ ខែមករា សម្រាប់ ២សប្តាហ៍ លើក ទី១ ជូន និវត្ត ជន និង ជន បាត់បង់ សម្បទា វិជ្ជាជីវៈ និង អតីត មន្ត្រីរាជការ ស៊ីវិល នឹង ធ្វើឡើង ចាប់ពី ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២២ត ទៅ » ។
( ស្ទឹងត្រែង ) ៖ ថ្លែង ពេល កំពុង ចុះ ពិនិត្យ ដំណើរការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នៅ ខេត្ត ស្ទឹងត្រែង លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ប្រុងប្រយ័ត្ន ចំពោះ ជំងឺ ផ្ដាសាយ បក្សី ប្រភេទ ថ្មី Influenze A/H9 បន្ទាប់ពី រកឃើញ មួយ ករណី លើ កុមារ នៅ ស្រុក ជីក្រែង ខេត្ត សៀមរាប ។
ក្នុង បទសម្ភាស ជាមួយ អ្នកសារព័ត៌មាន លោកស្រី ឱ វណ្ណឌីន បាន អះអាង ថា ជំងឺ ផ្ដាសាយ បក្សី ប្រភេទ នេះ កម្រ នឹង ឆ្លង ណាស់ ប៉ុន្ដែ បើ ទោះបី កម្រ ពិត មែន ក្ដី ប្រជាពលរដ្ឋ ត្រូវតែ មាន ការប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ បំផុត ។ លោកស្រី បាន បន្ដ ទៀត ថា ជំងឺ ផ្ដាសាយ បក្សី នេះ គឺ មាន អាការៈ មិន ខុសពី ជំងឺ កូវីដ១៩ នោះ ទេ មាន ន័យ ថា អាការៈ នៅពេល ឆ្លង ដូចគ្នា ស្ទើរ ទាំងអស់ ជាមួយ ជំងឹកូវីដ១៩ ។
ដើម្បី ទប់ស្កាត់ និង បង្ការ នូវ ការឆ្លង ជំងឺ ផ្ដាសាយ បក្សី នេះ លោកស្រី ឱ វណ្ណឌីន បាន ក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ ជៀសវាង ការប៉ះពាល់ ជាមួយ សត្វ បក្សី គ្រប់ ប្រភេទ ហើយ កុំ ចូល ទៅ កសិដ្ឋាន ចិញ្ចឹម សត្វ បក្សី ជាដើម ។ ដោយឡែក សម្រាប់ អាជីវករ លក់ដូរ ឬ ចិញ្ចឹម សត្វ បក្សី ត្រូវតែ ប្រើប្រាស់ មធ្យោបាយ ការពារ ខ្លួន ឲ្យបាន ត្រឹមត្រូវ តាមរយៈ ការពាក់ ម៉ាស់ និង ស្រោម ដៃ នៅពេល ប៉ះពាល់ ហើយ ត្រូវតែ លាង ដៃ ជាមួយ សាប៊ូ ក្រោយ ប៉ះពាល់ សត្វ បក្សី ។
មន្ដ្រី ជំនាញ សុខាភិបាល រូប នេះ បាន បន្ថែម ទៀត ថា នៅពេល បរិភោគ ចំណីអាហារ ផ្សេង ៗ ត្រូវតែ ចម្អិត ឲ្យបាន ឆ្អិន ល្អ ជៀសវាង ទទួលទាន សាច់ ដែល មិន បាន ឆ្អិន ល្អ និង សម្អាត មិន បាន ត្រឹមត្រូវ ។ ដោយឡែក បន្លែ និង ផ្លែ ឈើ ត្រូវ លាង សម្អាត ហើយ ដាក់ ដោយ នៅ ដាច់ ពី គ្នា ជាមួយ សាច់ ដែល មិន ឆ្អិន ។ មួយ វិញទៀត កាំបិត ជ្រុញ ត្រូវ សម្អាត ឲ្យបាន ស្អាត ជៀសវាង គ្រាន់តែ ជូត ហើយ មិន បាន លាង សម្អាត ជាមួយ ទឹក សាប៊ូ ។
ក្រសួង បញ្ជាក់ ថា ក្នុង ភូមិ កើត ជំងឺ ខាងលើ មាន មាន់ ងាប់ ចាប់តាំងពី ខែ កុម្ភៈ មក ម្ល៉េះ ។ ភ្លាម ៗ ក្រោយ មាន ករណី នេះ ក្រសួង បាន បញ្ជូន មន្រ្តី នាយកដ្ឋាន ប្រយុទ្ធ ជំងឺ ឆ្លង សហការ ជាមួយ មន្រ្តី ក្រុម ឆ្លើយតប បន្ទាន់ ខេត្ត ចុះ អង្កេត ស្រាវជ្រាវ បង្ការ និង ទប់ស្កាត់ ការរាតត្បាត និង អប់រំ សុខភាព ដល់ ប្រជាជន នៅ មូលដ្ឋាន ៕
សូម ស្ដាប់ ការលើកឡើង របស់ លោកស្រី ឱ វណ្ណឌីន ដែល មាន ទាំងស្រុង នៅ ខាងក្រោម នេះ៖ សូម ចូលរួម ការស្ទង់ មតិ៖ មជ្ឈមណ្ឌល ជាតិ នៃ មជ្ឈត្ត ការ ផ្នែក ពាណិជ្ជកម្ម និង សភា ពាណិជ្ជកម្ម អឺរ៉ុប នៅ កម្ពុជា រួមគ្នា ការរៀបចំ ការស្ទង់ មតិ តម្រូវការ សម្រាប់ ការដោះស្រាយ វិវាទ ពាណិជ្ជកម្ម ក្រៅ ប្រព័ន្ធ តុលាការ
( ភ្នំពេញ ) ៖ យន្តការដោះស្រាយ វិវាទ ពាណិជ្ជកម្ម ដែល រឹងមាំ គឺ មាន សារៈសំខាន់ ណាស់ សម្រាប់ សហគមន៍ អាជីវកម្ម ។ ការស្ទង់ មតិ គឺជា ចំណុច គន្លឹះ សំខាន់ មួយ ដើម្បី វាយតម្លៃ បរិយាកាស វិនិយោគ នៅក្នុង ទីផ្សារ ក្នុង គោលបំណង អភិវឌ្ឍ ការដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ ប្រកបដោយ ប្រសិទ្ធភាព សម្រាប់ វិវាទ ពាណិជ្ជកម្ម ។
យើង បាន សហការ គ្នា រៀបចំ ការស្ទង់ មតិ នេះ ដើម្បី សម្រេច កម្មវត្ថុ ដូច ខាងក្រោម៖
* ទី១៖ ដើម្បី វាស់វែង កម្រិត នៃ ការយល់ដឹង ការប្រើប្រាស់ និង តម្រូវការ ទីផ្សារ សម្រាប់ ការដោះស្រាយ វិវាទ ពាណិជ្ជកម្ម ក្រៅ ប្រព័ន្ធ តុលាការ តាមរយៈ មជ្ឈត្តកម្ម និង សន្ធានកម្ម ។
* ទី២៖ ដើម្បី វាស់វែង ការប្រើប្រាស់ និង ការពេញចិត្ត ចំពោះ យន្តការ ដែល មាន ស្រាប់ ក្នុង ការដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ ។
* ទី៣៖ ដើម្បី ទទួលបាន មតិ កែលម្អ សម្រាប់ លើក កម្ពស់ ការយល់ដឹង ពង្រឹង សេវាកម្ម និង បំពេញ តាម ការរំពឹងទុក របស់ អ្នកប្រើប្រាស់ ។
ការផ្តល់ មតិ បំពេញ ទម្រង់ នេះ មាន សារៈប្រយោជន៍ ក្នុង ការលើកកម្ពស់ សេដ្ឋកិច្ច ជាពិសេស គឺ បង្ក បរិយាកាស ល្អ សម្រាប់ សហគម ធុរកិច្ច ។ មូលហេតុ គឺ ដោយសារ ការយល់ដឹង សន្ធានកម្ម បង្កើត ទំនាក់ទំនង ល្អ និង ការពារ កុំ ឲ្យ មាន វិវាទ ។ ករណី កើតមាន វិវាទ ហើយ ក៏ សន្ធានកម្ម ជួយ រក្សា បាន នូវ ទំនាក់ទំនង ។ ការដោះស្រាយ តាម សន្ធានកម្ម ជួយ ឲ្យ ភាគី រិះរក និង យក ជម្រើស ដែល ខ្លួន ឯង ចង់បាន ហើយ អាច ឲ្យ បន់ បែន បាន ក្នុង ដំណើរ ដោះស្រាយ នោះ ។
ការស្ទង់ មតិ នឹង ចំណាយ ពេល ប្រហែល ២០ នាទី ដើម្បី បញ្ចប់ ។ យើងខ្ញុំ សូម ថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ចំពោះ ការចំណាយ ពេលវេលា របស់ អ្នក ។ អ្នក អាច ចែករំលែក បន្ត អំពី ការស្ទង់ មតិ នេះ ទៅកាន់ ភាគី ដែល ពាក់ព័ន្ធ ផ្សេង ៗ ទៀត បាន ។ កាលបរិច្ឆេទ ឈប់ ទទួល សម្រាប់ ការឆ្លើយតប គឺ ថ្ងៃទី ៧ ខែមេសា ឆ្នាំ ២០២២ ។
ក្រុម អ្នកនិពន្ធ សៀវភៅ បំផុស ស្មារតី យុវជន ឱ្យ លើក តម្លៃ ការអាន សៀវភៅ
( ភ្នំពេញ ) ៖ ក្រុម អ្នកនិពន្ធ សៀវភៅ ជាច្រើន រូប រួមទាំង ព្រះសង្ឃ ម្ចាស់ អាជីវកម្ម បុគ្គលិក រដ្ឋ និង ឯកជន ព្រមទាំង សិស្ស និស្សិត បាន ជួបជុំគ្នា ដើម្បី ចែករំលែក បទពិសោធន៍ នៃ ការនិពន្ធ សៀវភៅ បទពិសោធន៍ ផ្ទាល់ខ្លួន និង ផលប្រយោជន៍ នៃ ការអាន សៀវភៅ ។
ពិធី ជួបជុំ មិត្តភាព ដែល បាន ធ្វើឡើង កាលពី ចុង សប្តាហ៍ មុន នេះ នៅក្នុង ឱកាស ទិវា ជាតិ អំណាន លើក ទី៧ ប្រព្រឹត្តទៅ នៅ River House វាល ស្បូវ ដែល សហការរៀបចំ ដោយ អ្នកនិពន្ធ សៀវភៅ គ្មាន នរណា កើត មក ក្រទេ សាកលវិទ្យាល័យ បញ្ញាសាស្ត្រ កម្ពុជា ក្រុមហ៊ុន ឯកជន និង ក្រុម យុវជន ស្ម័គ្រចិត្ត ដើម្បី ការអភិវឌ្ឍ សង្គម ដោយ គោលបំណង សំខាន់ នៃ ការជួបជុំ នេះ គឺ ដើម្បី លើកកម្ពស់ បណ្តុះ ស្មារតី និង ឱ្យ តម្លៃ ការអាន សៀវភៅ ។
នា ឱកាស នោះ ដែរ លោក វ៉េង សិរី វុឌ្ឍ អ្នកនិពន្ធ សៀវភៅ គ្មាន នរណា កើត មក ក្រ ទេ បន្ទាប់ពី បាន ចែករំលែក បទពិសោធន៍ ជីវិត ពិត និង បាន គូស រំលេច ពី អត្ថប្រយោជន៍ នៃ ការអាន សៀវភៅ ថា៖ « សៀវភៅ អាច ឆ្លុះបញ្ចាំង អាច ឱ្យ យើង ត្រៀមខ្លួន អាច ផ្តល់ វិធីសាស្ត្រ ផ្តល់ បញ្ញា ខ្ពស់ និង អាច ឱ្យ យើង ដឹង មុន ពី បញ្ហា ប្រឈម » ។
ទន្ទឹមនឹង នេះ លោក ក៏ បាន លើកទឹកចិត្ត ឱ្យ មាន ការអាន សៀវភៅ ឱ្យ បាន ច្រើន នូវ សៀវភៅ ដែល ខ្លួន ចូលចិត្ត ។ ការអាន សៀវភៅ ធ្វើឱ្យ យើង ចេះ កែ នូវ ទម្លាប់ ដែល មិន ល្អ អំពើ មិន សកម្ម ដំណើរ វិវត្តន៍ មិន ចម្រើន ។
ចំណែក លោក សាស្ត្រាចារ្យ សំបូរ មាណ្ណារ៉ា សាស្ត្រាចារ្យ ខេមរវិទ្យា និង ប្រវត្តិសាស្ត្រ ខ្មែរ នៃ សាកលវិទ្យាល័យ បញ្ញាសាស្ត្រ កម្ពុជា បាន លើកឡើង ថា ការនិពន្ធ សៀវភៅ មួយ ត្រូវ ចំណាយ ពេល តិច ឬ ច្រើន វា អាស្រ័យ ទៅ លើ តម្រូវ ការចាំបាច់ នៃ ទំនាក់ទនង របស់ អ្នក សរសេរ និង អ្នកអាន ។
លោក សាស្ត្រាចារ្យ បន្ត ថា ទស្សនៈ វិស័យ របស់ អ្នក សរសេរ ប្រាកដជា មើល ឆ្ងាយ ជាង អ្នក អាច ទៅ ទៀត ប៉ុន្តែ នៅ ពេល ប្រើប្រាស់ វេលា ក្នុង ការសរសេរ មាន ការ កំណត់ មាន កាលបរិច្ឆេទ និង មាន ចំណែក នៃ ការទទួលខុសត្រូវ ។
គួរ ជម្រាប ថា នៅ ថ្ងៃទី ១១ មីនា កម្ពុជា បាន ប្រារព្ធ ទិវា ជាតិ អំណាន លើក ទី៧ ក្រោម ប្រធានបទ « អំណាន ជួយ លើកកម្ពស់ គុណភាព ជីវិត ក្នុង សង្គម ឌីជីថល » ។
ក្រសួង អប់រំ ដែល បាន រៀបចំ ទិវា នេះ ជារៀងរាល់ ឆ្នាំ ក្នុង គោលបំណង រំឭក ដល់ វីរភាព និង គុណូបការៈ ដ៏ ថ្លៃថ្លា របស់ សម្តេច ព្រះសង្ឃរាជ ជួន ណាត ដែល បាន ខិតខំ តស៊ូ ពុះពារ ការពារ មរតក វប្បធម៌ អក្សរសាស្ត្រ ខ្មែរ និង ក្នុង គោលបំណង បណ្ដុះ ទម្លាប់ អាន . ជំរុញ វប្បធម៌ អាន . លើកកម្ពស់ សមត្ថភាព អាន . ការតែង និពន្ធ . និង ការស្រាវជ្រាវ សំដៅ រួមចំណែក ការពារ និង លើកកម្ពស់ វប្បធម៌ . អរិយធម៌ ខ្មែរ ព្រមទាំង ពង្រីក ចំណេះដឹង ដល់ ពលរដ្ឋ កម្ពុជា គ្រប់ រូប ៕
អភិបាល ខេត្ត ត្បូងឃ្មុំ ចង់ កែលម្អ តំបន់ ប្រវត្តិសាស្រ្ត ដើម ពោធិ៍ ទុំ ទាវ ជា រមណីយដ្ឋាន ប្រវត្តិសាស្ត្រ ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង លោកស្រី ម៉េង វ៉ាន់ ដានីន នៅ ចុង នេះ បាន ដឹកនាំ មន្ត្រី ជំនាញ ចុះ ពិនិត្យ និង សិក្សា អំពី ទីតាំង ប្រវត្តិសាស្រ្ត ដើម ពោធិ៍ទុំ ទាវ ស្ថិត នៅ ភូមិ ជើង ខាល ឃុំ មង់ រៀវ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ។
ជាមួយនឹង ការចុះ ពិនិត្យ នេះ លោក អភិបាល ខេត្ត ក៏ បាន ណែនាំ ដល់ មន្ត្រី ជំនាញ ទាំងអស់ ត្រូវ សិក្សា រៀបចំ ទីតាំង ប្រវត្តិសាស្រ្ត មួយ នេះ ឲ្យ ក្លាយទៅជា តំបន់ ទេសចរណ៍ ប្រវត្តិសាស្ត្រ សម្រាប់ ប្រជាពលរដ្ឋ ទស្សនា កំសាន្ត និង សិក្សា ពី ប្រវត្តិសាស្ត្រ ទាំង ភ្ញៀវ ជាតិ និង អន្តរជាតិ ។ លោក ថ្លែង ថា ជំហាន ដំបូង ត្រូវ សិក្សា ធ្វើ របង ព័ទ្ធ ជុំវិញ និង ដាំ កូន ឈើ បន្ថែម លើ បរិវេណ ដើម ពោធិ៍ ប្រវត្តិសាស្ត្រ មួយ នេះ ក្នុង នោះ ក៏ ត្រូវ រៀបចំ ឲ្យ មាន បង្គន់ អនាម័យ ផងដែរ ។
សូម ជម្រាប ថា កាលពី ពេល កន្លងទៅ ថ្មី ៗ នេះ ដើម ពោធិ៍ ក្នុង តំបន់ ប្រវត្តិសាស្ត្រ ទុំ ទាវ ដ៏ ធំ មួយ ដែល គេ ឲ្យ ឈ្មោះ ថា ដើម ពោធិ៍ អ្នកតា ក្រហម ក ត្រូវបាន ខ្យល់ កន្ត្រាក់ បោក ដួលរលំ ហើយ ត្រូវបាន អាជ្ញាធរ ខេត្ត រៀបចំ ដាំ ឡើងវិញ ។ ក្រោយ ការដួលរលំ ដើម ពោធិ៍ ដ៏ ធំ មួយ នេះ តំបន់ ប្រវត្តិសាស្រ្ត ទុំ ទាវ ត្រូវបាន ប្រជាពលរដ្ឋ មាន ការចាប់អារម្មណ៍ ចង់ ឃើញ និង ស្គាល់ ដោយ បាន ចូលទៅ ទស្សនា បន្តបន្ទាប់ ពិសេស ប្រជាពលរដ្ឋ ដែល មកពី បណ្ដា ខេត្ត ផ្សេង ៗ ផងដែរ ៕
មន្ត្រី ជាន់ ខ្ពស់ អាកាសចរ ស៉ី វិល៖ ជប៉ុន កំពុង ពិចារណា តភ្ជាប់ ជើងហោះហើរ ត្រង់ ជាមួយ កម្ពុជា ឡើងវិញ ក្នុង ពេល ឆាប់ ៗ
( ភ្នំពេញ ) ៖ លោក ស៉ីន ចាន់ សិរី វុត្ថា អនុ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ អាកាសចរ ស៊ីវិល បាន បញ្ជាក់ ឲ្យដឹង ថា ដោយសារតែ វិបត្តិ នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ រហូតមកដល់ ពេលនេះ ការតភ្ជាប់ ជើងហោះហើរ រវាង កម្ពុជា - ជប៉ុន នៅ មិន ទាន់ ដំណើរការ ឡើងវិញ នោះ ទេ តែ ភាគី ជប៉ុន កំពុង ពិចារណា ក្នុង ការតភ្ជាប់ ជើងហោះហើរ ជាមួយ កម្ពុជា ឡើងវិញ ក្នុង ពេល ឆាប់ ៗ ។
អ្នកនាំពាក្យ រូប នេះ បន្ត ថា ការ មិន ទាន់ ចាប់ផ្តើម ហោះហើរ ឡើងវិញ នេះ ដោយសារ កត្តា ទីផ្សារ និង កត្តា តម្រូវការ នៃ ការធ្វើដំណើរ តាម ផ្លូវ អាកាស ត្រូវបាន ធ្លាក់ចុះ ស្រប ពេល ដែល វិធានការណ៍ ចត្តាឡី ស័ក នៅ ប្រទេស ជប៉ុន នៅ តឹងរ៉ឹង នៅឡើយ ដែល ធ្វើឲ្យ ប្រជាជនពិបាក ធ្វើដំណើរ ចេញ ចូល ។
លោក ថា បច្ចុប្បន្ន នេះ ប្រសិនបើ ប្រជាជន កម្ពុជា ឬ ប្រជាជន ជប៉ុន ចង់ ធ្វើដំណើរ រវាង កម្ពុជា - ជប៉ុន ត្រូវ ឆ្លងកាត់ ប្រទេស ផ្សេង ទៀត ដូចជា ប្រទេស ថៃ សឹង្ហបុរី និង កូរ៉េ ទើប ធ្វើដំណើរ ចូល ប្រទេស កម្ពុជា ឬ ជប៉ុន ។
ជើងហោះហើរ បាន ដើរ នាទី សំខាន់ ណាស់ សម្រាប់ ជំរុញ សកម្មភាព សេដ្ឋកិច្ច ការទូត ទេសចរណ៍ និង វិនិយោគ ។ ជប៉ុន ជា ប្រទេស ដែល កំពុង វិនិយោគ នៅ កម្ពុជា ដ៏ មាន សក្តានុពល មួយ ក្នុង ចំណោម ប្រទេស ផ្សេង ៗ ទៀត ។
គិត ត្រឹម ដំណាច់ ខែតុលា ឆ្នាំ ២០២១ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន ទទួលស្វាគមន៍ គម្រោង វិនិយោគ ជប៉ុន ចំនួន ១៤៦ គម្រោង ក្នុង ទុន វិនិយោគ សរុប ប្រមាណ ២. ៨៥៣លាន ដុល្លារ អាមេរិក ក្នុង នោះ មាន គម្រោង វិនិយោគ ចំនួន ៦៦ បាន បោះ ទីតាំង ក្នុង តំបន់ សេដ្ឋកិច្ច ពិសេស ដែល មាន ទុន វិនិយោគ សរុប ប្រមាណ ៣៤០ លាន ដុល្លារ អាមេរិក ៕
រុស្ស៊ី ច្រានចោល ព័ត៌មាន ដែល ថា ខ្លួន គំរាម រឹបអូស ទ្រព្យសម្បត្តិ របស់ ក្រុមហ៊ុន នៃ ប្រទេស លោក ខាងលិច (Video inside) ( ម៉ូស្គូ) ៖ ស្ថានទូត រុស្ស៊ី ប្រចាំ សហរដ្ឋ អាមេរិក បាន ច្រានចោល របាយការណ៍ ដែល ថា រដ្ឋអាជ្ញា រុស្ស៊ី បាន គំរាមកំហែង ពី ការចាប់ខ្លួន និង រឹបអូស ទ្រព្យសម្បតិ្ត របស់ ក្រុមហ៊ុន នៃ បណ្ដា ប្រទេស លោក ខាងលិច ដោយ ថា វា គឺជា រឿង មិន ពិត នោះ ទេ ។ នេះ បើ យោង តាម ការចុះផ្សាយ របស់ សារព័ត៌មាន រុស្ស៊ី RT នៅ ថ្ងៃចន្ទ ទី១៤ ខែមីនា ឆ្នាំ ២០២២ ។
ស្ថានទូត រុស្ស៊ី ប្រចាំ សហរដ្ឋ អាមេរិក បាន ច្រានចោល ការចោទប្រកាន់ នេះ ដោយ បញ្ជាក់ ថា អត្ថបទ របស់ Wall Street Journal គឺជា រូបភាព នៃ ការ ចុះផ្សាយ ព័ត៌មាន ក្លែងក្លាយ ។ ស្ថានទូត ក៏ ជំរុញ ផងដែរ ឲ្យ ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ស្រុក បញ្ឈប់ ការចុះផ្សាយ ព័ត៌មាន ក្លែងក្លាយ ដោយ អះអាង ថា « បើ ទោះបី ស្ថិត ក្នុង ស្ថានភាព លំបាក បំផុត ក៏ដោយ ក៏ ផលប្រយោជន៍ ពាណិជ្ជកម្ម របស់ អាមេរិក ក្នុង ទីផ្សារ រុស្ស៊ី មិន ត្រូវបាន រំលោភបំពាន តាម វិធី ណាមួយ ឡើយ »៕
លោក អ៉ិន ដារ៉ា អគ្គ នាយក KW បាត់ដំបង សូម ចូលរួម រំលែក ទុក្ខ ឧកញ៉ា លឹម ប៊ុន សួរ ចំពោះ មរណភាព របស់ អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន
( ភ្នំពេញ ) ៖ លោក អ៉ិន ដារ៉ា អគ្គ នាយក KW បាត់ដំបង ព្រមទាំង ក្រុមការងារ នៅ ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០២២ សូម ចូលរួម រំលែក ទុក្ខ ជាមួយ ឧកញ៉ា លឹម ប៊ុន សួរ និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ មហាសប្បុរស មង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន ដែល ជា ឪពុក របស់ ឧកញ៉ា កាលពី វេលា ទៀប ភ្លឺ ថ្ងៃអាទិត្យ ទី ១៣ ខែមីនា នេះ ក្នុង ជន្មាយុ ៩៧ ឆ្នាំ ដោយ ជរា ពាធ ។
លោក អ៉ិន ដារ៉ា អគ្គ នាយក KW បាត់ដំបង ព្រមទាំង ក្រុមការងារ មាន ក្តី រំជួល ចិត្ត ឥត ឧបមា ដោយ បាន ទទួល ដំណឹង ដ៏ ក្រៀមក្រំ ថា មហាសប្បុរស មង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន បាន ទទួលមរណភាព ។
លោក អ៉ិន ដារ៉ា អគ្គ នាយក KW បាត់ដំបង ព្រមទាំង ក្រុមការងារ សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន សូម ឆាប់ បាន ចាប់កំណើត កើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀង ឃ្លាត ឡើយ ៕
ប្រកាស ចូលកាន់ តំណែង មេបញ្ជាការ ថ្មី នៃ មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក បាធាយ ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី សោ សាវឿន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០២២ នេះ អម ដំណើរ ដោយ លោក ប្រធាន ក្រុមប្រឹក្សា ស្រុក . លោក អភិបាល ស្រុក បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស តែងតាំង ផ្លាស់ប្តូរ មុខតំណែង មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក បាធាយ ។
ក្នុង ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក មេបញ្ជាការ រង នាយ សេនាធិការ ប្រធាន មន្ទីរ នាយ ការិយាល័យ ពាក់ព័ន្ធ មេបញ្ជាការ មូលដ្ឋាន ក្រុង - ស្រុក ទាំង១០ ស្នាក់ការសន្តិសុខ ទាំង៣ អធិការ នគរបាល ស្រុក មេបញ្ជាការ ផ្នែក សឹក រង ស្រុក មេឃុំ មេ បុស្តិ៍ ព្រមទាំង មន្រ្តី រាជការ ជុំវិញ ស្រុក ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ត្រី សោ សាវឿន បាន លើកឡើង ក្នុង នាម លោក ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត សូម អបអរសាទរ និង កោតសរសើរ វាយតម្លៃ ខ្ពស់ ចំពោះ ស្នាដៃ ដែល នាយ ទាហាន នាយ ទាហាន រង នៃ កងរាជអាវុធហត្ថ ខេត្ត ទាំងអស់ ក្នុង ការបំពេញ តួនាទី ភារកិច្ច បេសកម្ម ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ និង សម្រេចបាន ជោគជ័យ ជា ទី មោទនៈ កន្លងមក ។
( ភ្នំពេញ ) ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រមុខរដ្ឋ ស្តីទី នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ភរិយា សម្តែង នូវ ការសោកស្តាយ និង ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ បំផុត ជាមួយ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន ដែល ជា ឪពុក បង្កើត កាលពី វេលា ទៀប ភ្លឺ ថ្ងៃអាទិត្យ ទី ១៣ ខែមីនា នេះ ក្នុង ជន្មាយុ ៩៧ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង សារលិខិត ចូលរួម រំលែក មរណទុក្ខ . សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ចាត់ទុក មរណភាព អគ្គ មហា ឧបាសក លឹម ឈុន គឺជា ការបាត់បង់ នូវ លោកឪពុក ឪពុក ក្មេក ស្វាមី ជីតា ជីតា ទួត ជាទីគោរព ស្រឡាញ់ ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង សង្គហធម៌ មួយ រូប ដែល បាន ចិញ្ចឹម បីបាច់ ថែរក្សា អប់រំ ទូន្មាន កូន ចៅ ប្រកបដោយ គន្លង ធម៌ និង បាន ជួយ កិច្ចសង្គម ឱ្យ មាន ការអភិវឌ្ឍ ជារៀងហូតមក ។
រូបកាយ អគ្គ មហា ឧបាសក លឹម ឈុន បាន លាចាក លោក ទៅ ក៏ ពិត មែន តែ កិត្តិយស សេចក្តីថ្លៃថ្នូរ អំពើ ជា កុសល នៅ ស្ថិត ជាប់ ក្នុង មនោសញ្ចេតនា លោក ឧកញ៉ា ភរិយា បុត្រា បុត្រី ចៅ ប្រុស ចៅ ស្រី ព្រមទាំង ញាតិមិត្ត ជិត ឆ្ងាយ ទាំង អស់ ជានិច្ច និរន្តរ៍ ។
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ និង ភរិយា ក៏ បាន បួងសួង ដល់ វត្ថុ ស័ក្តិសិទ្ធិ ក្នុង លោក និង តេជៈ បារមី នៃ ព្រះពុទ្ធ ព្រះធម៌ ព្រះសង្ឃ តាម ជួយ បីបាច់ ថែរក្សា ដល់ ដួង វិញ្ញាណ ក្ខន្ធ អគ្គ មហា ឧបាសក លឹម ឈុន បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ ឧកញ៉ា ឡូវ ហ៉ឹង ផ្ញើ សារលិខិត ចូលរួម រំលែក ទុក្ខ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ ចំពោះ មរណភាព របស់ អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន
( ភ្នំពេញ ) ៖ ឧកញ៉ា ឡូវ ហ៉ឹង ទីប្រឹក្សា សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ សម្តែង នូវ ការសោកស្តាយ និង ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ បំផុត ជាមួយ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន ដែល ជា ឪពុក បង្កើត កាលពី វេលា ទៀប ភ្លឺ ថ្ងៃអាទិត្យ ទី ១៣ ខែមីនា នេះ ក្នុង ជន្មាយុ ៩៧ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង សារលិខិត ចូលរួម រំលែក មរណទុក្ខ . ឧកញ៉ា ឡូវ ហ៉ឹង ចាត់ទុក មរណភាព មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លីម ឈុន គឺជា ការបាត់បង់ ស្វាមី ឪពុក ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជាទី ស្រលាញ់ បំផុត របស់ ក្រុមគ្រួសារ និង ជា ការបាត់ បាត់ នូវ ពុទ្ធសាសនូបត្ថម្ភ ក៍ មួយ រូប ដែល បាន រួមចំណែក ទាំង កម្លាំង កាយ ចិត្ត និង ធនធាន ជួយ កសាង សមិទ្ធផល នានា ជាច្រើន ជាពិសេស ក្នុង វិស័យ ព្រះពុទ្ធ សាសនា ។
លោក ទេសរដ្ឋមន្ត្រី សូម ឧទ្ទិស បួងសួង សុំឲ្យ ដួង វិញ្ញាណក្ខន្ធ របស់ មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លីម ឈុន បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
នាយ ឧត្តមសេនីយ៍ ចៅ ភិរុណ ផ្ញើ សារលិខិត ចូលរួម រំលែក ទុក្ខ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ ចំពោះ មរណភាព របស់ អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ចៅ ភិរុណ អគ្គ នាយក អគ្គ នាយកដ្ឋាន សម្ភារៈ បច្ចេកទេស ក្រសួង ការពារ ជាតិ ព្រមទាំង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ក្រោម ឱវាទ នៅ ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ លិខិត មួយ ចូលរួម រំលែក ទុក្ខ ជាមួយ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ មហាសប្បុរស មង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន ដែល ជា ឪពុក របស់ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ កាលពី វេលា ទៀប ភ្លឺ ថ្ងៃអាទិត្យ ទី ១៣ ខែមីនា នេះ ក្នុង ជន្មាយុ ៩៧ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង សារលិខិត នេះ នាយ ឧត្តមសេនីយ៍ ចៅ ភិរុណ មាន សេចក្តីក្រៀមក្រំ និង សោកស្តាយ ឥត ឧបមា ដោយ បាន ទទួល ដំណឹង ថា មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ លឹម ឈុន ត្រូវ ជា ឪពុក បង្កើត បាន ទទួលមរណភាព ។
លោក បាន បញ្ជាក់ ថា៖ « ក្នុង ឱកាស ដ៏ សោក សង្រេង នេះ យើងខ្ញុំ សូម ចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ជាមួយ ក្រុមគ្រួសារ នៃ សព ។ មរណភាព មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លីម ឈុន គឺជា ការបាត់បង់ ស្វាមី ឳពុក ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជាទី ស្រលាញ់ បំផុត របស់ ក្រុមគ្រួសារ និង ជា ការបាត់ បាត់ នូវ ពុទ្ធសាសនូបត្ថម្ភ ក៍ មួយ រូប ដែល បាន រួមចំណែក ទាំង កម្លាំង កាយ ចិត្ត និង ធនធាន ជួយ កសាង សមិទ្ធផល នានា ជាច្រើន ជាពិសេស ក្នុង វិស័យ ព្រះពុទ្ធ សាសនា » ។
នាយ ឧត្តមសេនីយ៍ ចៅ ភិរុណ សូម ឧទ្ទិស បួងសួង សុំឲ្យ ដួង វិញ្ញាណក្ខន្ធ របស់ មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លីម ឈុន បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
លោក បន្ថែម ថា ទីក្រុង ប៉េកាំង រក្សា ជំហរ អព្យាក្រឹត ក្នុង ជម្លោះ រវាង រុស្ស៊ី និង អ៊ុយក្រែន ដោយ អំពាវនាវ ឲ្យ បញ្ចប់ សង្រ្គាម ប៉ុន្តែ បដិសេធ មិន ចូលរួម ជាមួយ ក្រុម ប្រទេស លោក ខាងលិច ក្នុង ការថ្កោលទោស ឬ ដាក់ទណ្ឌកម្ម លើ រុស្ស៊ី ៕
សមាជិក ប្រតិភូ អ៊ុយក្រែន មួយ រូប ក៏ បាន ឱ្យដឹង ដែរ ថា កិច្ចចរចា បន្ទាប់ ទៀត រវាង ភាគី ទាំង ពីរ នឹង ត្រូវ រៀបចំឡើង តាម ប្រព័ន្ធ អនឡាញ នៅ វេលា ម៉ោង ១០៖៣០ នាទី ព្រឹក ថ្ងៃចន្ទ នេះ ( ម៉ោង ក្នុង តំបន់ ) ។
គួរ បញ្ជាក់ ថា ជំនួប ចរចា ជុំ ដំបូង រវាង ក្រុម មន្រ្តី រុស្ស៉ី និង អ៊ុយក្រែន បាន ប្រព្រឹត្តទៅ នៅ តំបន់ ហ្កោល មែល (Gomel) របស់ បេឡារុស ដែល នៅជាប់ នឹង អ៊ុយក្រែន កាលពី ថ្ងៃទី ២៨ ខែកុម្ភៈ ។ រីឯ ជំនួប ជុំ ទី២ ត្រូវបាន ធ្វើឡើង កាលពី ថ្ងៃទី ០៣ ខែមីនា នៅ បេឡា រុស ដដែល ដោយ កិច្ចចរចា នោះ សម្រេចបាន ការព្រមព្រៀង គ្នា ក្នុង ការបង្កើត ច្រក របៀប មនុស្សធម៌ ដើម្បី ជម្លៀស ជន ស៉ី វិល ចេញ ពី ទីក្រុង មួយចំនួន របស់ អ៊ុយក្រែន ។
ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ផ្ញើ សារលិខិត ចូលរួម រំលែក ទុក្ខ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ ចំពោះ មរណភាព របស់ អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន សម្តែង នូវ ការសោកស្តាយ និង ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ បំផុត ជាមួយ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន ដែល ជា ឪពុក បង្កើត កាលពី វេលា ទៀប ភ្លឺ ថ្ងៃអាទិត្យ ទី ១៣ ខែមីនា នេះ ក្នុង ជន្មាយុ ៩៧ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង សារលិខិត ចូលរួម រំលែក មរណទុក្ខ . លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ចាត់ទុក មរណភាព មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លីម ឈុន គឺជា ការបាត់បង់ ស្វាមី ឪពុក ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជាទី ស្រលាញ់ បំផុត របស់ ក្រុមគ្រួសារ និង ជា ការបាត់ បាត់ នូវ ពុទ្ធសាសនូបត្ថម្ភ ក៍ មួយ រូប ដែល បាន រួមចំណែក ទាំង កម្លាំង កាយ ចិត្ត និង ធនធាន ជួយ កសាង សមិទ្ធផល នានា ជាច្រើន ជាពិសេស ក្នុង វិស័យ ព្រះពុទ្ធ សាសនា ។
ឧប នាយក រដ្ឋមន្រ្តី ជា សុផារ៉ា ផ្ញើ សារលិខិត ចូលរួម រំលែក ទុក្ខ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ ចំពោះ មរណភាព របស់ អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន
( ភ្នំពេញ ) ៖ លោក ឧប នាយក រដ្ឋមន្រ្តី ជា សុផារ៉ា រដ្ឋមន្រ្តី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ នៅ ថ្ងៃទី ១៣ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ លិខិត មួយ ចូលរួម រំលែក ទុក្ខ ជាមួយ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ មហាសប្បុរស មង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន ដែល ជា ឪពុក របស់ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ កាលពី វេលា ទៀប ភ្លឺ ថ្ងៃអាទិត្យ ទី ១៣ ខែមីនា នេះ ក្នុង ជន្មាយុ ៩៧ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង សារលិខិត នេះ លោក ឧប នាយក រដ្ឋមន្រ្តី និង ភរិយា មាន សេចក្តីក្រៀមក្រំ និង សោកស្តាយ ឥត ឧបមា ដោយ បាន ទទួល ដំណឹង ថា មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ លឹម ឈុន ត្រូវ ជា ឪពុក បង្កើត បាន ទទួលមរណភាព ។
លោក បាន បញ្ជាក់ ថា៖ « ក្នុង ឱកាស ដ៏ សោក សង្រេង នេះ ខ្ញុំ និង ភរិយា សូម ចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ជាមួយ ក្រុមគ្រួសារ នៃ សព ។ មរណភាព មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លីម ឈុន គឺជា ការបាត់បង់ ស្វាមី ឳពុក ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជាទី ស្រលាញ់ បំផុត របស់ ក្រុមគ្រួសារ និង ជា ការបាត់ បាត់ នូវ ពុទ្ធសាសនូបត្ថម្ភ ក៍ មួយ រូប ដែល បាន រួមចំណែក ទាំង កម្លាំង កាយ ចិត្ត និង ធនធាន ជួយ កសាង សមិទ្ធផល នានា ជាច្រើន ជាពិសេស ក្នុង វិស័យ ព្រះពុទ្ធ សាសនា » ។
លោក ឧប នាយក រដ្ឋមន្រ្តី និង ភរិយា សូម ឧទ្ទិស បួងសួង សុំឲ្យ ដួង វិញ្ញាណក្ខន្ធ របស់ មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លីម ឈុន បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
( ស្វាយរៀង ) ៖ « តើ មាន ពេល លំបាក ណាមួយ ដែល គ្មាន វត្តមាន គណបក្ស ប្រជាជន កម្ពុជា ? » គឺជា សំនួរ ដែល លោក ហ៊ុន ម៉ានី សួរ ទៅកាន់ សមាជិក សមាជិកា ជា កម្មាភិបាល របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ខេត្ត ស្វាយរៀង នា ឱកាស ពិធី សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា ក្នុង រចនាសម្ព័ន្ធ គណៈ ចលនា មហាជន ខេត្ត នា រសៀល ថ្ងៃទី ១៣ ខែមីនា ឆ្នាំ ២០២២ ។
ការតាំង ជា សំណួរ នេះ ធ្វើឡើង ខណៈពេល ដែល លោក គូសបញ្ជាក់ ជូន ដល់ អង្គ ពិធី ពី សមត្ថភាព ក្នុង ការដឹកនាំ គ្រប់ ជ្រុងជ្រោយ ប្រកបដោយ ទស្សនៈ វិជ្ជា របស់ គណបក្ស ប្រជាជន កម្ពុជា ពី មួយ ដំណាក់កាល ទៅ មួយ ដំណាក់កាល ។
ទន្ទឹមនឹង ការបញ្ជាក់ យ៉ាង ច្បាស់ ពី ឆន្ទៈ និង ការប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ចំពោះ ការការពារ ផលប្រយោជន៍ ប្រជាជន និង ការបន្ត នៅ ជាប់ ជាមួយ ប្រជាជន ក្នុង គ្រប់ កាលៈទេសៈ លោក បាន យក ឱកាស នេះ ថ្លែងអំណរគុណ ដល់ សមាជិក សមាជិកា គណបក្ស ប្រជាជន គ្រប់ ៗ រូប ដែល បាន ផ្តល់ ជំនឿ ទុកចិត្ត និង បន្ត គាំទ្រ ឥត ងាក រេ ចំពោះ ការសម្រេចចិត្ត របស់ ថ្នាក់ដឹកនាំ និង ផែនការ សកម្មភាព នានា ដែល បាន ដាក់ចេញ ដើម្បី រួមគ្នា ធានា បាន នូវ ភាព ឈ្នះ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ បាន បញ្ជាក់ ថា អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ បាន ត្រៀម ខ្លួន រួច ជាស្រេច ដើម្បីឱ្យ ដំណើរ កិច្ចប្រជុំ អគ្គ មេបញ្ជាការ អាស៊ាន លើក ទី១៩ ក្រោម មូល បទ « សាមគ្គី ដើម្បី សេចក្តីសុខ ប្រកបដោយ ភាពសុខដុម » និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ កម្ពុជា ឆ្នាំ ២០២២ ដែល នឹង ប្រព្រឹត្ត ធ្វើឡើង នៅ ថ្ងៃទី ១៦ ដល់ ថ្ងៃទី ១៨ ខែមីនា ឱ្យ ទទួលបាន ភាពជោគជ័យ ។
បើ តាម នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន បញ្ជាក់ ថា ក្រសួង ការពារ ជាតិ បាន បង្កើត អនុគណៈកម្មការ មួយ ដើម្បី ទទួលខុសត្រូវ ដឹកនាំ កិច្ចប្រជុំ ថ្នាក់ អគ្គ មេបញ្ជាការ អាស៊ាន ដែល មាន លោក ជា ប្រធាន ( នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ) ព្រមទាំង មាន អនុប្រធាន សមាជិក ដែល មកពី បណ្តា អង្គភាព ចំណុះ អគ្គ មេបញ្ជាការ មួយចំនួន ដើម្បី ទទួលខុសត្រូវ លើក ភារកិច្ច ដែល ថ្នាក់ដឹកនាំ ប្រគល់ ជូន ជាដើម ។
នា ឱកាស នោះ ដែរ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន បញ្ជាក់ ថា សម្រាប់ កិច្ចប្រជុំ អគ្គ មេបញ្ជាការ អាស៊ាន លើក ទី១៩ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ គឺ បង្ហាញ ពី មោទនភាព របស់ ជាតិ កងយោធពល ខេមរភូមិន្ទ និង ជា ប្រវត្តិសាស្ត្រ របស់ ជាតិ ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ជាពិសេស នា ដំណាក់កាល ពិភពលោក កំពុងតែ រាតត្បាត នៃ ជំងឺ កូវីដ១៩ ដែល បង្ហាញ ឱ្យ អន្តរជាតិ មើលឃើញ ថា កម្ពុជា មាន លទ្ធ គ្រប់គ្រាន់ ក្នុង ទប់ស្កាត់ ជំងឺ ឆ្លង ជា សកល នេះ ។
បើ តាម នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន បន្ថែម ថា ព្រឹត្តិការណ៍ ដ៏ ប្រវត្តិសាស្រ្ត នេះ ផ្តល់ ឱកាស សម្រាប់ ក្រសួង ការពារ ជាតិ ក៏ ដូចជា កងយោធពល ខេមរភូមិន្ទ ទាំងមូល ក្នុង ការបង្ហាញ កិត្យានុភាព និង សមត្ថភាព នៃ ការត្រួសត្រាយ ផ្លូវ ដើម្បី រក្សា បាន នូវ ឯកភាព សាមគ្គីភាព ភាពធន់ និង មជ្ឈភាព អាស៊ាន ជាដើម ។
សូម ជម្រាប ថា ខ្លឹមសារ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១៦ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ឆ្នាំ ២០២២ ដែល កម្ពុជា ធ្វើជា ប្រធាន រួម មាន៖ មូល បទ អាទិភាព ពិនិត្យមើល ឯកសារ ទស្សនៈ ទាន . ឯកសារ ពិភាក្សា និង តារាង ប្រតិទិន សម្រាប់ ការប្រុងប្រៀប កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១៦ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ឆ្នាំ ២០២២ ដែល គ្រោង នឹង ប្រារព្ធ ធ្វើ ទាំង នៅ រាជធានី ភ្នំពេញ និង ខេត្ត សៀមរាប ។
កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១៦ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ឆ្នាំ ២០២២ ដែល កម្ពុជា ធ្វើជា ប្រធាន នេះ នឹង ជ្រើសរើសយក ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០២២ ជា ថ្ងៃ ប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន ៕ បញ្ញើ ប្រាក់ យ័ន ចិន ដើរ តួ ជំនួស ប្រាក់ ដុល្លារ អាមេរិក និង ប្រាក់ អឺរ៉ូ នៅក្នុង ធនាគារ រុស្ស៊ី
( មូស្គូ ) ៖ ស្រប ពេល ដែល ប្រទេស រុស្ស៊ី បាន កាត់ផ្តាច់ ជា ផ្លូវការ ពី ប្រើប្រាស់ ប្រាក់ ដុល្លារ អាមេរិក និង ប្រាក់ អឺរ៉ូ ធនាគារ រដ្ឋ រុស្ស៊ី VTB បាន ផ្តល់ ឱកាស ដល់ អតិថិជន របស់ ខ្លួន ក្នុង ការបើក គណនី សន្សំ ប្រាក់ យ័ន របស់ ចិន ដែល ផ្តល់ អត្រា ការប្រាក់ អតិបរមា៨% ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន RT នៅ ថ្ងៃអាទិត្យ ទី ១៣ ខែមីនា ឆ្នាំ ២០២២ ។
ធនាគារ បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា « ដោយ មើលឃើញ ពី ការកើនឡើង អត្រា ប្តូរ ប្រាក់ នៃ ប្រាក់ ដុល្លារ និង អឺរ៉ូ អតិថិជន ជាច្រើន កំពុង បង្ហាញ ចំណាប់អារម្មណ៍ ក្នុង ការវិនិយោគ លើ រូបិយប័ណ្ណ ផ្សេង ទៀត ហើយ ប្រាក់ យ័ន គឺជា ជម្រើស មួយ ក្នុង ចំណោម ជម្រើស ដែល អាច ទទួលយក បាន និង ជោគជ័យ បំផុត សម្រាប់ ការវិនិយោគ មូលនិធិ » ។
យោង តាម RT ធនាគារ ធំ ទី ពីរ របស់ ប្រទេស នេះ ត្រូវបាន រង ការវាយប្រហារ ដោយ ការដាក់ទណ្ឌកម្ម របស់ លោក ខាងលិច ក្នុង គោលបំណង ធ្វើឱ្យ រុស្ស៊ី ឯកោ ផ្នែក ហិរញ្ញវត្ថុ ទាំងស្រុង ជុំវិញ បញ្ហា សង្គ្រាម របស់ ខ្លួន នៅ អ៊ុយក្រែន ៕
លោក រដ្ឋមន្ត្រី ថោង ខុន បាន បន្ត ថា ចរន្ត ភ្ញៀវ ទេសចរ នា ចុង សប្តាហ៍ កន្លងមក បន្ត មាន សន្ទុះ វិជ្ជមាន គួរ កត់សម្គាល់ ។ ជាក់ស្តែង តួលេខ ខាងលើ បន្ត កើនឡើង ប្រមាណ ២៧. ៣០% ធៀប នឹង ចុង សប្តាហ៍ កន្លងមក ដែល ជា អត្រា កំណើន មួយ ខ្ពស់ និង កើនឡើង រហ័ស ។
លោក បាន បន្ត ទៀត ថា ចំនួន ភ្ញៀវ ទេសចរ ប្រមាណ ២៥ ម៉ឺន នាក់ ក្នុង សប្តាហ៍ នេះ គឺ ចាប់ផ្តើម មាន ចំនួន ប្រហាក់ប្រហែល នឹង ស្ថានភាពធម្មតា មុនពេល ការកម្រើក ឡើង នៃ ជំងឺ កូវីដ - ១៩ ប្រភេទ អូមី ក្រុង នា ដើម ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម ងី តា យី រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ លិខិត មួយ ចូលរួម រំលែក ទុក្ខ ជាមួយ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ មហាសប្បុរស មង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លឹម ឈុន ដែល ជា ឪពុក របស់ ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ កាលពី វេលា ទៀប ភ្លឺ ថ្ងៃអាទិត្យ ទី ១៣ ខែមីនា នេះ ក្នុង ជន្មាយុ ៩៧ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង សារលិខិត នេះ ឯកឧត្តម ងី តា យី មាន សេចក្តីក្រៀមក្រំ និង សោកស្តាយ ឥត ឧបមា ដោយ បាន ទទួល ដំណឹង ថា មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ លឹម ឈុន ត្រូវ ជា ឪពុក បង្កើត បាន ទទួលមរណភាព ។
ឯកឧត្តម បាន បញ្ជាក់ ថា៖ « ក្នុង ឱកាស ដ៏ សោក សង្រេង នេះ យើងខ្ញុំ សូម ចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ជាមួយ ក្រុមគ្រួសារ នៃ សព ។ មរណភាព មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លីម ឈុន គឺជា ការបាត់បង់ ស្វាមី ឳពុក ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជាទី ស្រលាញ់ បំផុត របស់ ក្រុមគ្រួសារ និង ជា ការបាត់ បាត់ នូវ ពុទ្ធសាសនូបត្ថម្ភ ក៍ មួយ រូប ដែល បាន រួមចំណែក ទាំង កម្លាំង កាយ ចិត្ត និង ធនធាន ជួយ កសាង សមិទ្ធផល នានា ជាច្រើន ជាពិសេស ក្នុង វិស័យ ព្រះពុទ្ធ សាសនា » ។
ឯកឧត្តម ងី តា យី សូម ឧទ្ទិស បួងសួង សុំឲ្យ ដួង វិញ្ញាណក្ខន្ធ របស់ មហាសប្បុរសមង្គល សិរី អគ្គ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភក៍ លីម ឈុន បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
