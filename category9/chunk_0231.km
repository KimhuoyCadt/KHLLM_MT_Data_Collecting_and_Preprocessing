( ភ្នំពេញ ) ៖ ឯកឧត្ដម ស៊ុយ សែម រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល និង លោកជំទាវ ជា ខេង បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម រដ្ឋមន្ត្រី ស៊ុយ សែម និង លោកជំទាវ ជា ខេង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម កិត្តិនីតិកោសល បណ្ឌិត ស៊ឹម កា និង លោកជំទាវ អ៊ុំ សំ បរិច្ចាគ ថវិកា ៥ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្ដម កិត្តិនីតិកោសល បណ្ឌិត ស៊ឹម កា អនុប្រធាន ទី១ ព្រឹទ្ធសភា និង លោកជំទាវ អ៊ុំ សំ បាន បរិច្ចាគ ថវិកា ចំនួន ៥.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម កិត្តិនីតិកោសល បណ្ឌិត ស៊ឹម កា និង លោកជំទាវ អ៊ុំ សំ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អភិបាល ខេត្ត កំពង់ចាម ដាក់ គោលការណ៍ ៤ ចំណុច ដល់ សាខា សមាគម សិស្ស និស្សិត បញ្ញវន្ត ក្មេង វត្ត ខេត្ត ដើម្បី អនុវត្ត បន្ត ឆ្នាំ ២០២២
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន កិត្តិយស សាខា សមាគម សិស្ស និស្សិត បញ្ញវន្ត ក្មេង វត្ត ខេត្ត នៅ ព្រឹក ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២២ បាន ដាក់ គោលការណ៍ ៤ ចំណុច ដល់ សាខា សមាគម ដើម្បី អនុវត្ត បន្ត ឆ្នាំ ២០២២ ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ របស់ សាខា សមាគម សិស្ស និស្សិត បញ្ញវន្ត ក្មេង វត្ត ខេត្ត កំពង់ចាម ឆ្នាំ ២០២១ និង ទិសដៅ ឆ្នាំ ២០២២ ។
លោក អ៊ុន ចាន់ ដា បាន យក ឱកាស នោះ ថ្លែង កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការខិតខំ ប្រឹងប្រែង របស់ បងប្អូន ដែល បាន ចូលរួម ធ្វើ សកម្មភាព មនុស្សធម៌ ជួយ ដល់ សង្គម ដោយ បាន ចំណាយ ទាំង កម្លាំង កាយ ប្រាជ្ញា ស្មារតី ធនធាន សម្ភារ ថវិកា ពេលវេលា សម្រេចបាន នូវ សកម្មភាព ជាច្រើន សម្រាប់ ឆ្នាំ ២០២១ កន្លងមក ។
ជាមួយនឹង ការដាក់ចេញ នូវ ទិសដៅ សម្រាប់ អនុវត្ត បន្ត លោក សូម លើកទឹកចិត្ត បន្ត ទៀត ដោយ សូម ធ្វើ ការ ផ្តាំផ្ញើ កិច្ចការ មួយចំនួន ចំពោះ ថ្នាក់ដឹកនាំ សាខា សមាគម ទាំងអស់ ដូច ខាងក្រោម៖
បើ តាម អនុប្រធាន សាខា សមាគម សិស្ស និស្សិត បញ្ញវន្ត ក្មេង វត្ត ខេត្ត កំពង់ចាម លោក ជា ក្រូច បាន ឲ្យដឹង ថា ក្នុង រយៈ ពេល កន្លងទៅ នេះ សាខា សមាគម បាន ជួប ជាមួយ សប្បុរស ជនជាតិ អន្តរជាតិ ចំនួន ៨លើ ក និង បាន ដឹកនាំ គ្រូពេទ្យ ស្ម័គ្រ ចិត្ត ចុះ ទៅ ពិនិត្យ ពិគ្រោះ និង ព្យាបាល ជំងឺ ប្រគេន ជូន ព្រះសង្ឃ យាយ ជី តា ជី បងប្អូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ចំនួន ៤ លើក បាន ចូលរួម សកម្មភាព មនុស្សធម៌ ចំនួន ៨៦លើ ក និង បាន ចុះ ទៅ ផ្សព្វផ្សាយ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ដល់ ប្រជាពលរដ្ឋ និង នៅ តាម វត្ត អារាម ។
( ភ្នំពេញ ) ៖ ឯកឧត្ដម គង់ សោភ័ណ្ឌ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្ដាល និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ២០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម គង់ សោភ័ណ្ឌ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល៖ កម្ពុជា គ្រប់គ្រង ស្ថានភាព កូវីដ១៩ បាន ដោយសារ ភាព ឈ្លាសវៃ និង ប៉ិនប្រសប់ យ៉ាង ខ្លាំង របស់ សម្តេច តេជោ ហ៊ុន សែន
( ព្រះវិហារ ) ៖ លោក វេជ្ជបណ្ឌិត គួង ឡូ ទីប្រឹក្សា ក្រសួង សុខាភិបាល និង ជា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ បាន ថ្លែង លើកឡើង ថា ក្រោម ការដឹកនាំ ប្រកបដោយ ភាពឈ្លាសវៃ និង គតិបណ្ឌិត របស់ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឱ្យ ស្ថានភាព ជំងឺ កូវីដ១៩ នៅ កម្ពុជា គ្រប់គ្រង បាន រហូត ឈាន ទៅ បើក នៅ វិស័យ សំខាន់ ៗ មាន វិស័យ សេដ្ឋកិច្ច វិស័យ ទេសចរណ៍ វិស័យ សង្គម ជាដើម ។
ការថ្លែង លើកឡើង បែប នេះ របស់ លោក វេជ្ជបណ្ឌិត គួង ឡូ ធ្វើឡើង ក្នុង ពិធី បើក សន្និបាត បូកសរុប ការងារ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ឆ្នាំ ២០២២ របស់ មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២២ នេះ ។
លោក ក៏ ថ្លែងអំណរគុណ ដល់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ មន្ទីរ អង្គភាព និង អង្ក ការដៃគូរ ក៏ ដូចជា បងប្អូន ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩៕ និន្នាការ ប្រើប្រាស់ រថយន្ត អគ្គិសនី នៅ កម្ពុជា ចាប់ផ្តើម មាន កើនឡើង ខណៈ រដ្ឋ បន្ធូរបន្ថយ ពន្ធ នាំចូល ៥០ %
តាម មន្រ្តី ជាន់ ខ្ពស់ រូប នេះ បច្ចុប្បន្ន ក្រុមហ៊ុន នាំចូល យានយន្ត អគ្គិសនី មាន ចំនួន ១១ ក្នុង នោះ ៥ក្រុមហ៊ុន នាំចូល រថយន្ត និង ក្រុមហ៊ុន ចំនួន ៦ទៀត នាំចូល ម៉ូតូ អគ្គិសនី ។ ជាមួយគ្នា នេះ មាន ក្រុមហ៊ុន ចំនួន ១ទៀត បាន នាំចូល គ្រឿង បន្លាស់ សម្រាប់ ស្ថានីយ បញ្ចូល អគ្គិសនី ។
របាយការណ៍ របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ឱ្យដឹង ថា ចំនួន យានយន្ត អគ្គិសនី ដែល បាន ចុះបញ្ជី កាលពី ឆ្នាំ ២០២០ មាន ចំនួន តែ ០២ គ្រឿង ប៉ុណ្ណោះ និង ឆ្នាំ ២០២១ យានយន្ត អគ្គិសនី មក ចុះបញ្ជី កើនឡើង ដល់ ៦២ គ្រឿង ។ នៅក្នុង ឆ្នាំ ២០២២នេះ រយៈពេល តែ ៣ខែ ប៉ុណ្ណោះ ពោលគឺ ពី ខែមករា ដល់ ខែមីនា ការចុះបញ្ជី យានយន្ត អគ្គិសនី មាន រហូតដល់ ៤៧ គ្រឿង កើនឡើង ៦៧១ % បើ ធៀប នឹង ក្នុង រយៈពេល ដូចគ្នា កាលពី ឆ្នាំ ២០២១ ។
កាលពី ថ្ងៃទី ២៦ ខែមីនា ឆ្នាំ ២០២២ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ ស្ថានីយ បញ្ចូល ថាមពល សម្រាប់ យានយន្ត អគ្គិសនី ដំបូង បំផុត នៅក្នុង ប្រទេស កម្ពុជា នៅ ទីស្តីការ ក្រសួង ៕
សមាជិក សភា ចំនួន ៥៥ រូប ក្នុង ចំណោម ១៣០ នាក់ នៅក្នុង សភា ប្រទេស ប៉េរូ បាន បោះឆ្នោត គាំទ្រ ការទម្លាក់ លោក កាស់ ស្ទីឡូ ខណៈ សភា ត្រូវការ សំឡេង សរុប ចនួន ៨៧ សំឡេង ទើប អាច បណ្តេញ លោក ចេញ ពី អំណាច បាន ។ លទ្ធផល នេះ នឹង អាច ជួយ បញ្ចៀស វិបត្តិ នយោបាយ ថ្មី សម្រាប់ រយៈពេល ខ្លី បើ ទោះបី រដ្ឋបាល លោក កាស់ ស្ទីឡូ កន្លងមក មាន ភាពច្របូកច្របល់ ដោយសារតែ បាន ផ្លាស់ប្តូរ គណៈ រដ្ឋមន្រ្តី ដល់ ទៅ ៤លើក នៅក្នុង ការកាន់អំណាច មិន ទាន់ ដល់ ១ ឆ្នាំ ផង ក៏ដោយ ក្តី ។
នៅក្នុង សុន្ទរកថា ទៅកាន់ សភា មុនពេល បោះឆ្នោត ប្រធានាធិបតី ប៉េរូ រូប នេះ បាន ថ្លែង ថា « វា ជា រឿង គួរឲ្យ សោកស្តាយ ដែល ការព្យាយាម បណ្តេញ លោក ចេញ ពី តំណែង តាមរយៈ ការចោទប្រកាន់ ពី អំពើពុករលួយ បាន ក្លាយ ចំណុច នៃ ការផ្តោត សំខាន់ ទាំង ផ្នែក នយោបាយ និង ប្រព័ន្ធ ផ្សព្វផ្សាយ ចាប់តាំងពី លោក ទទួលបាន ជ័យជម្នះ ក្នុង ការបោះឆ្នោត ។ វា មិន អាច បន្ត ទៅ ទៀត បែប នេះ បាន ទេ » ។
លោក បាន គូសបញ្ជាក់ ថា « ខ្ញុំ មិន ធ្លាប់ បំពាន ច្បាប់ ទេ តាំងពី ចូលកាន់ តំណែង ។ ខ្ញុំ ដឹង ថា យើង ទំាង អស់ គ្នា មាន កំហុស និង ចំណុច ខ្វះខាត ប៉ុន្តែ ខ្ញុំ មាន គោរព តាម ការបេ្តជ្ញាចិត្ត គុណ តម្លៃ និង គោលការណ៍ របស់ ខ្ញុំ » ។ ជាមួយគ្នា នេះ លោក ក៏ បាន អំពាវនាវ ឲ្យ មាន ការរួមគ្នា ដោះស្រាយ វិបត្តិ នយោបាយ និង សេដ្ឋកិច្ច ដែល កើត ចេញពី ការវាយប្រហារ របស់ រុស្ស៊ី លើ អ៊ុយក្រែន ដែល ជា បញ្ហា ប្រឈម ដ៏ ធ្ងន់ធ្ងរ សម្រាប់ ប៉េរូ ដែល ជា ប្រទេស ផលិត ទង់ដែង ធំ ជាង គេ ទី២ របស់ ពិភពលោក ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា បាន សម្តែង នូវ មរណទុក្ខ និង ការសោកស្តាយ យ៉ាង ក្រៀមក្រំ បំផុត ជាមួយ ឧកញ៉ា សុខ ស្រស់ អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង ជា ប្រធាន សភា ពាណិជ្ជកម្ម មណ្ឌល ខេត្ត កណ្តាល - កំពង់ឆ្នាំង និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ ចំពោះ ការទទួលមរណភាព របស់ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ មាន សំអាត ហៅ តែ សេង អាយ ដែល ជា ឪពុក បង្កើត ឪពុក ក្មេក និង ជា ជីតា ។
អ្នក ឧកញ៉ា បាន ចាត់ទុក មរណភាព មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ មាន សំអាត ជា ការបាត់បង់ ដ៏ គួរឱ្យ សោកស្តាយ បំផុត នូវ ឪពុក បង្កើត ឪពុក ក្មេក និង ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ជាទីគោរព ស្រលាញ់ បំផុត របស់ កូន ៗ និង ចៅ ៗ ដោយ មួយ ជីវិត មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ បាន ខិតខំ ធ្វើ អំពើ ល្អ ដែល ជា ពុទ្ធសាសនូបត្ថម្ភ ក៏ ដ៏ ថ្លៃថ្លា មួយ រូប និង បាន បូជា កម្លាំង កាយ ចិត្ត ក្នុង ការចិញ្ចឹម បីបាច់ ថែរក្សា និង ផ្ដល់ ដំបូន្មាន ល្អ ៗ ដល់ កូន ៗ និង ចៅ ៗ ឱ្យ ក្លាយជា ប្រជាពលរដ្ឋ ដ៏ ល្អ ក្នុង សង្គម ។
នៅក្នុង វេលា ប្រកបដោយ ក្តីរំជួល ចិត្ត និង សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ អ្នក ឧកញ៉ា គិត ម៉េង ព្រមទាំង ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកាសភា ពាណិជ្ជកម្ម កម្ពុជា សូម សម្ដែង នូវ សេចក្ដីសោកស្ដាយ និង ចូលរួម រំលែក ទុក្ខ ដោយ ក្តី សោក សង្រេង បំផុត ជាមួយ ឧកញ៉ា និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព និង សូម បួងសួង ជូន វិញ្ញាណក្ខន្ធ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ក៍ មាន សំអាត ហៅ តែ សេចអាយ សូម បាន អញ្ជើញ ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ទេសរដ្ឋមន្រ្តី គន់ គីម ប្រាប់ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ចាម ថា ដោយសារ សន្តិភាព ទើប ប្រទេស យើង រីកចម្រើន
( កំពង់ចាម ) ៖ លោក ទេសរដ្ឋមន្រ្តី គន់ គីម អនុប្រធាន និង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា បាន ថ្លែង ប្រាប់ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ចាម ថា ដោយសារ សន្តិភាព ទើប ប្រទេសជាតិ យើង មាន ការរីកចម្រើន ។
លោក ថ្លែង បែប នេះ នា រសៀល ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០២២ ពេល ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ចាម ជា ជនពិការ ប្រភេទ ក១ និង ក២ ។
ទេសរដ្ឋមន្រ្តី គន់ គីម បាន ថ្លែង ក្នុង ឱកាស នោះ ថា « ដោយសារ ប្រទេសជាតិ មាន សុខ សន្តិភាព ក្រមការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី បាន ធ្វើឱ្យ ប្រទេសជាតិ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ។ ទន្ទឹមនឹង នេះ បងប្អូន ដែល ជា អតីត យុទ្ធជន មាន វ័យ ចំណាស់ ទទួលបាន សុខភាព ល្អ តាមរយៈ ការពិនិត្យ ព្យាបាល ដោយ ឥត គិត ថ្លៃ នឹង មាន ឱកាស ចូល វត្ត រក្សា សីល ប្រាំ សីល ប្រាំបី រស់ នៅ ប្រកបដោយ សុខដុមរមនា ផងដែរ » ។
ជាមួយគ្នា នោះ ដែរ លោក ទេសរដ្ឋមន្ត្រី បាន សន្យា ថា នឹង ខិតខំ បង្កើន ប្រាក់ ឧបត្ថម្ភ ប្រភេទ ១ ប្រភេទ ២ បន្ត ទៅ ទៀត នៅ ពេល ដែល ប្រទេសជាតិ បាន រួច ផុត ពី ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ ៕
លោក អ៊ាង សុផល្លែត បាន បញ្ជាក់ ថា នៅក្នុង ជំនួប នេះ លោកស្រី ល្វីស មូស៊ី គីវ៉ា បូ បាន លើកឡើង ថា សេដ្ឋកិច្ច កម្ពុជា គឺ មាន ការទាក់ទាញ ខ្លាំង ហើយ អាច ជា គំរូ នៃ ការអភិវឌ្ឍ លើ វិស័យ ពាណិជ្ជកម្ម សម្រាប់ ប្រទេស និយាយ ភាសា បារាំង ។ ក្នុង ជំនួប រវាង អ្នក វិនិយោគ មកពី ២៤ ប្រទេស ជាមួយនឹង អ្នក វិនិយោគ កម្ពុជា លោកស្រី បាន ជម្រាប ជូន សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ថា គឺ បាន ទទួល លទ្ធផល ល្អ ណាស់ មាន ការចាប់អារម្មណ៍ ខ្លាំង ហើយក៏ មាន ការចុះហត្ថលេខា លើ អនុស្សរណៈ ដើម្បី បន្ត កិច្ចសហប្រតិបត្តិការ ផងដែរ ។
លោកស្រី អះអាង ថា គោលបំណង របស់ លោកស្រី និង ប្រតិភូ មកកាន់ កម្ពុជា ដែល ពេលនេះ គឺ ចង់បាន កិច្ចសហប្រតិបត្តិការ លើ វិស័យ វិនិយោគ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម ដែល មាន ដំណើរការ រីកធំធាត់ និង និរន្ដន៍ តទៅ ហើយ ដំណើរទស្សនកិច្ច របស់ លោកស្រី នា ពេលនេះ គឺជា ចំណុច ចាប់ផ្ដើម សម្រាប់ កិច្ចសហប្រតិបត្តិការ តទៅ អនាគត ។ ចំណុច នេះ លោកស្រី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ សម្តេច តេជោ ជូន ចំពោះ រាជ រដ្ឋាភិបាល ដែល បាន រៀបចំ ទទួល ដំណើរទស្សនកិច្ច របស់ ប្រតិភូ អង្គការ អន្តរជាតិ ហ្វ្រង់ កូហ្វូនី ។
ជា ការឆ្លើយតប សម្តេច តេជោ ហ៊ុន សែន បាន សម្ដែង នូវ ការអបអរសាទរ ចំពោះ ជោគជ័យ នៃ ជំនួប រវាង អ្នក វិនិយោគ មកពី បណ្ដា ប្រទេស និយាយ ភាសា បារាំង និង អ្នក វិនិយោគ កម្ពុជា ។ សម្តេច តេជោ បាន មានប្រសាសន៍ ថា សេដ្ឋកិច្ច ពាណិជ្ជកម្ម និង វិនិយោគ ជា ចំណុច ស្នូល នៃ កិច្ចសហប្រតិបត្តិការ រវាង ភាគី ទាំង ពីរ ។ សម្ដេច ថា ប្រទេស យើង និង តំបន់ យើង មាន សក្ដានុពល គ្រាន់តែ យើង មិន ទាន់ មាន ឱកាស នៅឡើយ ប៉ុណ្ណោះ ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន បន្ដ ថា ភាគី ទាំង ពីរ គប្បី ណា រួមគ្នា បង្ក ឱកាស ដើម្បី ចាប់ យក សក្ដានុពល ទាំងឡាយ ណា ដែល យើង មាន នេះ ដើម្បី មិន ត្រឹមតែ ពង្រីក ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស និង តំបន់ យើង ទាំង ពីរ ទេ តែ សម្រាប់ ជា ទំនាក់ទំនង នយោបាយ ល្អ រវាង ប្រទេស យើង ទាំង ពីរ ផង និង តំបន់ ផង ព្រោះថា ទំនាក់ទំនង ល្អ លើ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម និង វិនិយោគ និង នាំ ទៅដល់ ភាពស្ថិត ជិតស្និទ្ធ ផ្នែក នយោបាយ ។
ឆ្លៀត ក្នុង ឱកាស នោះ សម្ដេច តេជោ ក៏ បាន ជម្រាប ជូន លោកស្រី ល្វីស ថា ក្នុង នាម ជា ប្រធាន អាស៊ាន អ្វី ដែល សម្តេច តេជោ ចង់បាន គឺ ជំរុញ ការអនុវត្ត អាស្តា និង អាស៊ីម ឲ្យ ទៅ ចលនា សេដ្ឋកិច្ច ពាណិជ្ជកម្ម និង វិនិយោគ និង របៀង ដំណើរ ទេសចរណ៍ នៅ តំបន់ អាស៊ាន មាន ដំណើរការប្រក្រតី ភាព ឡើងវិញ ។
គួរ ជម្រាប ថា អង្គការ អន្តរជាតិ ហ្វ្រង់ កូហ្វូនី ជា អង្គការ នៃ ប្រទេស និយាយ ភាសា បារាំង ដែល ក្នុង នោះ ប្រទេស កម្ពុជា ជា សមាជិក ផងដែរ ។ ក្នុង ដំណើរទស្សនកិច្ច នៅ កម្ពុជា លោកស្រី ល្វីស មូស៊ី គីវ៉ា បូ បាន អញ្ជើញ ជួប មន្ត្រី រាជ រដ្ឋាភិបាល និង វិស័យ ឯកជន នៅ កម្ពុជា ផងដែរ ដើម្បី ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ នានា ៕ ទេសរដ្ឋមន្រ្តី លី ធុជ៖ ពី ប្រទេស ញាំញី ដោយសារ សង្គ្រាម តែ កម្ពុជា បាន ក្លាយជា ប្រទេស មាន កំណើន សេដ្ឋកិច្ច លឿន បំផុត លើ ពិភពលោក
( ភ្នំពេញ ) ៖ កម្ពុជា ជា ប្រទេស មួយ ដែល ធ្លាប់ ញាំញី ដោយ សង្រ្គាម ស៉ី វិល ឥឡូវនេះ បាន ក្លាយជា ប្រទេស មួយ ក្នុង ចំណោម ប្រទេស ដែល មាន កំណើន សេដ្ឋកិច្ច លឿន បំផុត នៅលើ ពិភពលោក ជាមួយនឹង អាត្រា កំណើន សេដ្ឋកិច្ច ៧.៥% និង ជា អ្នកចូលរួមចំណែក កងទ័ព យ៉ាង សកម្ម នៅក្នុង បេសកកម្ម រក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ ។
ពិធី ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ក្នុង គោលបំណង ពង្រឹង ភាពជាដៃគូរ និង កិច្ចសហប្រតិបត្តិការ គាំទ្រ ដល់ ការអភិវឌ្ឍ បច្ចេកវិទ្យា និវានុវត្តន៍ ការបណ្តុះបណ្តាល និង បច្ចេកទេស គាំទ្រ ដល់ ការបោសសម្អាត មីន ដើម្បី បង្កើន ប្រសិទ្ធភាព ក្នុង តំបន់ និង ជា សាកល នៃ សហគមន៍ សកម្មភាព មីន មនុស្សធម៌ ។
អាជ្ញាធរ មីន មាន មោទនភាព ក្នុង ការពង្រីក កិច្ចសហប្រតិបត្តិការ របស់ ខ្លួន ជាមួយ គ្រប់ តួអង្គ ចម្រុះ និង តួអង្គ សំខាន់ ៗ ក្នុង វិស័យ នេះ ដើម្បី ធ្វើ ពិពិធកម្ម បណ្តាញ គាំទ្រ ។ លោក ទេសរដ្ឋមន្រ្តី ជឿជាក់ ថា អង្គការ Platinum East ដែល ជា ស្ថាប័ន ជំនាញ ផ្នែក ដោះ មីន តាម បច្ចេកវិទ្យា ច្នៃប្រឌិត នឹង ធ្វើឲ្យ ប្រតិបត្តិការ បោសសម្អាត មីន នៅ ទីវាល កាន់តែ មាន សុវត្ថិភាព និង អាច រំដោះ ផ្ទៃដី បាន លឿន សម្រាប់ ប្រជាជន កម្ពុជា ។
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា ដោយ មាន កិច្ចសហប្រតិបត្តិការ ល្អ ជាមួយ ក្រសួង ស្ថាប័ន របស់ រដ្ឋាភិបាល ដែល ពាក់ព័ន្ធ បាន រៀបចំ វគ្គ បណ្តុះបណ្តាល ផ្សព្វផ្សាយ តាម ប្រព័ន្ធ អនឡាញ លើ ច្បាប់ ស្តីពី ការប្រឆាំង ហិរញ្ញប្បទាន ដល់ ការរីកសាយភាយ អាវុធ មហា ប្រល័យ សម្រាប់ មន្ត្រី ត្រួតពិនិត្យ និង បុគ្គល រាយការណ៍ ក្នុង វិស័យ ធនាគារ ។
* សិក្ខាសាលា ផ្សព្វផ្សាយ ដល់ មន្រ្តី ត្រួតពិនិត្យ រៀបចំឡើង ចំនួន ៣លើក រួម មាន៖
លើក ទី ១៖ នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២២ ចូលរួម ដោយ នាយកដ្ឋាន ត្រួតពិនិត្យ១ នៃ អគ្គ នាយកដ្ឋាន ត្រួតពិនិត្យ ទទួលខុសត្រូវ ត្រួតពិនិត្យ ធនាគារ ពាណិជ្ជ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ទទួល ប្រាក់ បញ្ញើ ។ វគ្គ បណ្តុះបណ្តាល នេះ មាន ការចូលរួម ពី មន្ត្រី ត្រួតពិនិត្យ ទាំងអស់ ចំនួន ៣០ រូប ។
លើក ទី ២៖ នៅ ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២២ ចូលរួម ដោយ នាយកដ្ឋាន ត្រួតពិនិត្យ ២ នៃ អគ្គ នាយកដ្ឋាន ត្រួតពិនិត្យ ទទួលខុសត្រូវ ត្រួតពិនិត្យ ធនាគារ ឯកទេស គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ក្រុមហ៊ុន ភតិសន្យា ហិរញ្ញវត្ថុ គ្រឹះស្ថាន ឥណទាន ជនបទ និង អាជីវកម្ម ប្តូរ ប្រាក់ វគ្គ បណ្តុះបណ្តាល នេះ មាន ការចូលរួម ពី មន្ត្រី ត្រួតពិនិត្យ ចំនួន ៣២ រូប ។
លើក ទី ៣៖ នៅ ថ្ងៃទី ២៤ ខែមីនា ឆ្នាំ ២០២២ ចូលរួម ដោយ នាយកដ្ឋាន គោល នយោបាយ៉ូ បទប្បញ្ញត្តិ និង វាយតម្លៃ ហានិភ័យ នាយកដ្ឋាន គ្រប់គ្រង ទិន្នន័យ និង វិភាគ ម៉ាក្រ នៃ អគ្គ នាយកដ្ឋាន ត្រួតពិនិត្យ និង នាយកដ្ឋាន ប្រព័ន្ធ ទូទាត់ សង ប្រាក់ នៃ អ៊ីគ្គ នាយកដ្ឋាន បច្ចេកទេស វគ្គ បណ្តុះបណ្តាល នេះ មាន ការចូលរួម ពី មន្ត្រី ត្រួតពិនិត្យ ទាំងអស់ ចំនួន ៦០ រូប ។
* សិក្ខាសាលា ផ្សព្វផ្សាយ ដល់ បុគ្គល រាយការណ៍ ក្នុង វិស័យ ធនាគារ ត្រូវបាន រៀបចំឡើង ចំនួន ២លើ ក៖ លើក ទី ១៖ នៅ ថ្ងៃទី ២៣ ខែមីនា ឆ្នាំ ២០២២ មាន ការចូលរួម ពី តំណាង ធនាគារ ពាណិជ្ជ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ទទួល ប្រាក់ បញ្ញើ ចំនួន ៨៥ រូប ។ លើក ទី ២៖ នៅ ថ្ងៃទី ២៤ ខែមីនា ឆ្នាំ ២០២២ មាន ការចូលរួម ពី តំណាង ធនាគារ ឯកទេស គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ និង ក្រុមហ៊ុន ភតិសន្យា ហិរញ្ញវត្ថុ ទាំងអស់ ចំនួន ១០៣ រូប ។
លើស ពី នេះ ធនាគារ ជាតិ មាន ផែនការបណ្តុះបណ្តាល ដល់ បុគ្គល រាយការណ៍ តូច ៗ ផ្សេង ទៀត រួម មាន៖ គ្រឹះស្ថាន ឥណទាន ជនបទ អាជីវកម្ម ប្តូរ ប្រាក់ និង គ្រឹះស្ថាន ផ្តល់ សេវា ទូទាត់ សង ប្រាក់ នៅ ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០២២ នេះ ៕
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២២ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៥. ៥៥២ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣១. ៥២៧ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៤ នាក់ ៕ អភិបាល ខេត្ត កែប៖ ត្រូវ ទប់ស្កាត់ ឲ្យបាន ការកែច្នៃ យានយន្ត ខុស បច្ចេកទេស ឬ ការដឹកជញ្ជូន លើស ទម្ងន់
ការណែនាំ បែប នេះ ពេល លោក សោម ពិសិដ្ឋ ចូលរួម ជា អធិបតីភាព ក្នុង ពិធី បិទ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ សម្រេចបាន រយៈពេល ១ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២២ របស់ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត កែប ដែល ប្រព្រឹត្ត ឡើង នា ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០២២ នៅ សាល ប្រជុំ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូញ ខេត្ត កែប ។
លោក ក៏ បាន ណែនាំ និង ស្នើ ដល់ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ត្រូវ បន្ត យកចិត្តទុកដាក់ ត្រួតពិនិត្យ ឲ្យបាន ហ្មត់ចត់ ពាក់ព័ន្ធ បច្ចេកទេស សាងសង់ ថែទាំ ជួសជុល ផ្លូវ ស្ពាន តាម ស្តង់ដារ ប្រកបដោយ គុណភាព និង សុវត្តិភាព ខ្ពស់ ។
ទន្ទឹម នេះ លោក សោម ពិសិដ្ឋ ក៏ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល ដែល មន្ទីរ សម្រេចបាន ក្នុង ឆ្នាំ ២០២១ ដែល បញ្ជាក់ ឲ្យ ឃើញ ពី កិច្ច ខិតខំ ប្រឹងប្រែង អនុវត្ត តួនាទី ភារកិច្ច ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។
ក្នុង ឱកាស នោះ ដែរ លោក ម៉ម ទូច ប្រធាន មន្ទីរ សាធារណៈ និង ដឹកជញ្ជូន ខេត្ត កែប បាន លើក បញ្ជាក់ ថា រយៈពេល ១ ឆ្នាំ ២០២១ នេះ មន្ទីរ សម្រេចបាន សមិទ្ធផល រូប វន្ត ធំ ៗ ចំនួន ៦គម្រោង រួម មាន៖
ក្រៅពី គម្រោង ធំ ៗ ដែល មន្ទីរ សម្រេចបាន ក្នុង ឆ្នាំ ២០២១ ទាំង៦ គម្រោង នេះ លោក ប្រធាន មន្ទីរ ក៏ បាន បង្ហាញ នៅក្នុង របាយការ នូវ ការងារ ស្នូល របស់ មន្ទីរ ដូចជា ការចុះបញ្ជី និង ផ្ទេរ កម្មសិទ្ធ យានយន្ត . ការងារ ផ្តល់ ប័ណ្ណ បើកបរ យានយន្ត . ការងារ ត្រួតពិនិត្យ យានយន្ត កែច្នៃ ខុស បច្ចេកទេស . ពិនិត្យ បច្ចេកទេស យានយន្ត រួមទាំង ការងារ ផ្សព្វផ្សាយ ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដែល សុទ្ធសឹង ទទួល លទ្ធផល ល្អ ប្រសើរ ៕
ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ ជួប សំណេះសំណាល និង ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ៣០០ គ្រួសារ នៅ ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ នៅ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២២ នេះ លោក អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា ប្រធាន អង្គការ មូលនិធិ អភិវឌ្ឍន៍ មុស្លិ ម កម្ពុជា បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី សំណេះសំណាល សួរសុខទុក្ខ និង ចែក អំណោយ ដែល បាន មក ពី អង្គការ ហាសានី អន្តរជាតិ ជូន ប្រជាពលរដ្ឋ ចំនួន ៣០០ គ្រួសារ នៅ ភូមិ តេជោ ភូមិសាឡង់ ភូមិ ស្តួច និង ភូមិ ៧មករា ឃុំ ដា ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ។
ក្នុង ឱកាស នៃ ការសំណេះសំណាល ខាងលើ ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ បាន ថ្លែងអំណរគុណ ដល់ តំណាង អង្គការ ហាសានី អន្តរជាតិ ដែល បាន ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ និង ផ្តល់ ជំនួយ ជូន ប្រជាពលរដ្ឋ កម្ពុជា ដែល មាន ភាពខ្វះខាត ដោយ មិន ប្រកាន់ ជាតិ សាសន៍ និង សាសនា នោះ ឡើយ ។ កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ធ្វើឲ្យ ប្រទេសជាតិ រួចផុត ពី សម័យ សង្គ្រាម និង ធ្វើឲ្យ កម្ពុជា មាន ការរីកចម្រើន មាន សុខ សុន្តិភាព និង មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ។
ជាមួយគ្នា នេះ លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន ក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ នាំគ្នា បន្ត ចូលរួម ថែរក្សា សន្តិភាព ដោយ បន្ត ការគាំទ្រ ដល់ រាជ រដ្ឋាភិបាល ដើម្បី ទទួលបាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ បន្ត ទៅ ទៀត ។ គួរ ជម្រាប ផងដែរ ថា អំណោយ ដែល ទទួលបាន ពី អង្គការ ខាងលើ សម្រាប់ មួយ គ្រួសារ រួម មាន៖ អង្ករ ២០ គីឡូក្រាម មី១០ កញ្ចប់ ប្រេង ឆា២លីត្រ ស្ករ ស២គីឡូក្រាម ទឹកដោះគោ ២កំប៉ុង និង អំបិល១ គីឡូក្រាម ផ្លែ ល្មើស កន្លះ គីឡូ ៕
( ភ្នំពេញ ) ៖ ឯកឧត្តម ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម ប៉ាន សូរស័ក្តិ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
រដ្ឋបាល រាជធានី ភ្នំពេញ ជូនដំណឹង ពី ការបញ្ចៀស ចរាចរ យានយន្ដ គ្រប់ ប្រភេទ នៅ ថ្ងៃ សម្ពោធ ស្ពាន អាកាស ចោម ចៅ ក្រោម អធិបតីភាព សម្ដេច តេជោ ហ៊ុន សែន
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ការបញ្ចៀស ចរាចរ យានយន្ត គ្រប់ ប្រភេទ ជា បណ្តោះអាសន្ន ក្នុង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ស្ពាន អាកាស និង ផ្លូវ ក្រោម ដី ចោម ចៅ ។
ក្នុង សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា នៅ ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២២ ចាប់ពី ម៉ោង ០៥៖០០ នាទី រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង រៀបចំ ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន អាកាស និង ផ្លូវ ក្រោម ដី ចោម ចៅ ដែល ស្ថិត នៅ សង្កាត់ ចោម ចៅ ទី៣ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ដើម្បីឲ្យ កម្មវិធី ខាងលើ ប្រព្រឹត្តទៅ ដោយ រលូន រក្សា បាន នូវ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ និង របៀបរៀបរយ សាធារណៈ រដ្ឋបាល រាជធានី ភ្នំពេញ ធ្វើ ការបញ្ចៀស ចរាចរ និង ផ្អាក ចរាចរ ជា បណ្តោះអាសន្ន ជុំវិញ ទីតាំង ប្រារព្ធ ពិធី រហូតដល់ បញ្ចប់ កម្មវិធី ដោយ មិន អនុញ្ញាតឲ្យ យានជំនិះ គ្រប់ ប្រភេទ ឆ្លងកាត់ កំណាត់ ផ្លូវ ជាតិ លេខ ៣ ចាប់ពី ផ្លូវ៣០ ម៉ែត្រ ( ផ្លូវ បុរី សន្តិភាព ) រហូតដល់ ស្ពាន អាកាស ចោម ចៅ ៕
ក្នុង លិខិត អញ្ជើញ របស់ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន បញ្ជាក់ ថា កិច្ចប្រជុំ ពេញ អង្គ នេះ ធ្វើឡើង ដើម្បី ពិនិត្យ និង ឆ្លង របៀបវារៈ ដូច ខាងក្រោម៖
* ទី ១៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី វិសោធនកម្ម មាត្រា ១៤០ នៃ ច្បាប់ ស្តីពី ការគ្រប់គ្រង រដ្ឋបាល រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ
* ទី ២៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី សុវត្ថិភាព ម្ហូប អាហារ
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ព្រឹក ថ្ងៃអង្គារ ទី ២៩ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន អនុញ្ញាតឱ្យ លោក ល្វីស មូស៊ី គីវ៉ា បូ អគ្គ លេខាធិការ អង្គការ អន្តរជាតិ ហ្វ្រង់ កូហ្វូនី ចូល ជួប សម្តែង ការសម និង ពិភាក្សា ការងារ ។
អង្គការ អន្តរជាតិ ហ្វ្រង់ កូហ្វូនី ជា អង្គការ នៃ ប្រទេស និយាយ ភាសា បារាំង ដែល ក្នុង នោះ ប្រទេស កម្ពុជា ជា សមាជិក ផងដែរ ។
ក្នុង ដំណើរទស្សនកិច្ច នៅ កម្ពុជា លោក ល្វីស មូស៊ី គីវ៉ា បូ បាន អញ្ជើញ ជួប មន្ត្រី ព្រមទាំង វិស័យ ឯកជន នៅ កម្ពុជា ផងដែរ ដើម្បី ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ នានា ៕
កំពង់ផែ ស្វយ័ត ភ្នំពេញ ចេញ សេចក្តីជូនដំណឹង ពី ការជ្រើសរើស បេក្ខជន ឈរឈ្មោះ ជា អភិបាល មិន ប្រតិបត្តិ តំណាង ភាគហ៊ុនិក ឯកជន
( ភ្នំពេញ ) ៖ កំពង់ផែ ស្វយ័ត ភ្នំពេញ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការជ្រើសរើស បេក្ខជន ឈរឈ្មោះ ជា អភិបាល មិន ប្រតិបត្តិ តំណាង ភាគហ៊ុនិក ឯកជន សម្រាប់ អាណត្តិ ទី៨ នៃ ក្រុមប្រឹក្សាភិបាល កំពង់ផែ ស្វយ័ត ភ្នំពេញ ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៥ ខែមីនា ឆ្នាំ ២០២២ នេះ ៕
ព័ត៌មាន លម្អិត ពី លក្ខខណ្ឌ នៃ ការជ្រើសរើស នេះ សូម អាន សេចក្តីជូនដំណឹង ដូច ខាងក្រោម៖ ក្រសួង ព័ត៌មាន បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី តួនាទី របស់ អ្នកសារព័ត៌មាន ក្រោម ប្រធានបទ « ទន្លេ តែ មួយ អនាគត តែ មួយ »
( ភ្នំពេញ ) ៖ ក្រសួង ព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន រៀបចំ បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី តួនាទី របស់ អ្នកសារព័ត៌មាន ក្រោម ប្រធានបទ « ទន្លេ តែ មួយ អនាគត តែ មួយ » ដែល ប្រារព្ធ ធ្វើឡើង នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
វគ្គ បណ្តុះបណ្តាល នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក គឹម គុណ វឌ្ឍន៍ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន តំណាង រដ្ឋមន្ត្រី ខៀវ កាញារីទ្ធ ដោយ មាន ការចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ ក្រសួង ព័ត៌មាន មន្ទីរព័ត៌មាន រាជធានី - ខេត្ត និង បណ្តា អ្នកសារព័ត៌មាន ជាតិ និង អន្តរជាតិ ដែល កំពុង បំពេញ ការងារ នៅក្នុង ប្រទេស កម្ពុជា និង បណ្តា ប្រទេស សមាជិក កិច្ចសហប្រតិបត្តិការ ឡាន ឆាង - មេគង្គ រួម មាន៖ ចិន . មីយ៉ាន ម៉ា. ឡាវ ថៃ និង វៀតណាម ជាដើម ។
