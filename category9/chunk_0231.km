( បន្ទាយមានជ័យ )៖ លោក ទេសរដ្ឋមន្រ្តី គន់ គីម អនុប្រធាន និង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា បាន ចុះ ត្រួតពិនិត្យ ផ្ទះ អតីត យុទ្ធជន ដែល រងគ្រោះ ដោយ ខ្យល់ កន្រ្តាក់ កាលពី ថ្ងៃទី ២៧ ខែមីនា ស្ថិត នៅ មណ្ឌល តេជោ សន្តិភាព ( ការ៉េ ពីរ ) ។
ក្នុង នោះ ក៏ មាន ការចូលរួម ពី លោក ឧត្តមសេនីយ៍ ត្រី ជឹម ប៊ុន អាន ប្រធាន អតីត យុទ្ធជន ខេត្ត បន្ទាយមានជ័យ និង អាជ្ញាធរ មូលដ្ឋាន ស្ថាប័ន ពាក់ព័ន្ធ ផងដែរ នា ថ្ងៃទី ៣០ ខែមីនា ឆ្នាំ ២០២២ ។
នា ពេល នោះ ទេសរដ្ឋមន្រ្តី គន់ គីម បាន បញ្ជា ឲ្យ ក្រុម ជាង សាងសង់ ឲ្យ បាន ឆាប់ រហ័ស ដើម្បី ធ្វើ ផ្ទះ ថ្មី ជូន អតីត យុទ្ធជន ដែល ផ្ទះ របស់ អតីត យុទ្ធជន ប៉ះពាល់ ខ្លាំង ( ខូចខាត ទាំងស្រុង ) ត្រូវ ធ្វើ ថ្មី ឲ្យ ហើយ ក្នុង រយៈពេល ១ ខែ ក្នុង ចំនួន ផ្ទះ ៣៩ ខ្នង ។
ទេសរដ្ឋមន្រ្តី គន់ គីម ក៏ បាន ផ្តាំផ្ញើ ឲ្យ បងប្អូន អតីត យុទ្ធជន ទាំងអស់ យកចិត្តទុកដាក់ ឲ្យបាន ខ្ពស់ ចំពោះ អាកាសធាតុ ដោយ នេះ ជា រដូវ ដែល មាន ភ្លៀង រួម ជាមួយនិង ខ្យល់ កន្រ្តាក់ ផងដែរ នោះ និង អាច បង្ក ជា យថាហេតុ ណាមួយ កើតឡើង ចំពោះ បងប្អូន ។
ជាមួយគ្នា នេះ ទេសរដ្ឋមន្រ្តី គន់ គីម ក៏ ប្រាប់ ឲ្យ ត្រូវតែ បន្ត នូវ ការ ការពារ ខ្លួន ឲ្យបាន ខ្ពស់ បំផុត និង ត្រូវតែ ធ្វើ តាម ការណែនាំ របស់ ក្រុម គ្រូពេទ្យ ពិសេស អនុវត្ត តាម អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ៣ការពារ និង ៣កុំ ៕
រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម ប្រទេស ហ្គា បុង ស្វែងរក កិច្ចសហប្រតិបត្តិការ ពាណិជ្ជកម្ម ពី កម្ពុជា
លោក វេជ្ជបណ្ឌិត សាន់ សិប អី ក្នុង នាម លោក ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ បាន ថ្លែងអំណរគុណ ដល់ តំណាង អង្គការ HASENE ដែល បាន ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ និង ផ្តល់ ជំនួយ ជូន ប្រជាពលរដ្ឋ កម្ពុជា ដែល មាន ភាពខ្វះខាត ដោយ មិន ប្រកាន់ ជាតិ សាសន៍ និង សាសនា នោះ ឡើយ ។
កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ធ្វើឲ្យ ប្រទេសជាតិ រួចផុត ពី សម័យ សង្គ្រាម និង ធ្វើឲ្យ កម្ពុជា មាន ការរីកចម្រើន មាន សុខ សុន្តិភាព និង មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ។ បន្ថែម ពី នេះ លោក ក៏ បាន ក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ នាំគ្នា បន្ត ចូលរួម ថែរក្សា សន្តិភាព ដោយ បន្ត ការគាំទ្រ ដល់ រាជ រដ្ឋាភិបាល ដើម្បី ទទួលបាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ បន្ត ទៅ ទៀត ។
គួរ ជម្រាប ផងដែរ ថា អំណោយ ដែល ទទួលបាន ពី អង្គការ ខាងលើ សម្រាប់ មួយ គ្រួសារ រួម មាន អង្ករ ២០ គីឡូក្រាម មី១០ កញ្ចប់ ប្រេង ឆា២លីត្រ ស្ករ ស២គីឡូក្រាម ទឹកដោះគោ ២កំប៉ុង អំបិល១ គីឡូក្រាម និង ផ្លែ ល្មើស កន្លះ គីឡូក្រាម ៕
រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះច័ន្ទ ពេញ បូរមី » ត្រូវបាន ក្រុមការងារ ផលិត ខ្សែភាពយន្ត ចុះ មក ថត នៅ តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក
( កំពង់ធំ )៖ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះច័ន្ទ ពេញ បូរមី » ត្រូវបាន ក្រុមការងារ ចុះ មក ថត ខ្សែភាពយន្ត នៅ រមណីយដ្ឋាន តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក ក្នុង ស្រុក ប្រាសាទ សំបូរ ខេត្ត កំពង់ធំ ដែល មាន ចម្ងាយ ២៨ គីឡូម៉ែត្រ ពី ទី រួម ខេត្ត កំពង់ធំ ដោយ មាន ការ ចុះ ត្រួតពិនិត្យ ទីតាំង ជាក់ស្ដែង ដោយ គណៈកម្មការ ផលិត ខ្សែភាពយន្ត ។
ការចុះ ទៅដល់ រមណីយដ្ឋាន តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក នេះ គឺ មាន ការចូលរួម ពី លោក ហ៊ុន ម៉ានី អម ដំណើរ ដោយ លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ និង សហការី នា ព្រឹក ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ នេះ ។
ឆ្លៀត នៅក្នុង ឱកាស នោះ លោក ងួន រតនៈ បាន លើកឡើង ថា រឿង កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បរមី ជា រឿង បែប ប្រវត្តិសាស្រ្ត ដែល និយាយ ពី ដំណើរ ជីវិត តស៊ូ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដោយ មាន បញ្ចូល នូវ ព្រឹត្តិការណ៍ សំខាន់ ៗ ជាច្រើន ក្នុង ការស្វែងរក សន្តិភាព ជូន ប្រជាពលរដ្ឋ ។
លោក បាន បន្ត ថា ដោយសារ ដំណើរ រឿង នៃ ខ្សែភាពយន្ត មាន លក្ខណៈ ប្រវត្តិសាស្ត្រ កម្រិត ថ្នាក់ ជាតិ ជា ប្រវត្តិ នៃ ខ្សែ ជីវិត ជាក់ស្តែង របស់ សម្តេច តេជោ ផង នោះ ទើប សម្តេច សម្រេច ឲ្យ បង្កើត គណៈកម្មការ ផលិត ខ្សែភាពយន្ត នេះ ឡើង ។
ទោះជា ខ្សែភាពយន្ត នេះ ផលិត ដោយ ក្រុមហ៊ុន ឯកជន ប៉ុន្តែ គណៈកម្មការ មាន ភារកិច្ច ដឹកនាំ ត្រួតពិនិត្យ ខ្លឹមសារ និង ទីតាំង ប្រវត្តិសាស្ត្រ ជាក់ស្តែង ។ សមាសភាព គណៈកម្មការ ទាំងអស់ សុទ្ធតែ ជា អ្នក មាន ជំនាញ ពិតប្រាកដ ក្នុង ការផលិត ខ្សែភាពយន្ត ដែល ទទួលបាន នូវ ជំនឿ ទុកចិត្ត ពី សម្តេច តេជោ ជា ម្ចាស់ ដើម នៃ ប្រវត្តិ សាច់រឿង ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ លោកស្រី ធី ណា រ៉េដ ស ឯក អគ្គ រាជ ទូត អង់គ្លេស ប្រចាំ នៅ កម្ពុជា និង លោកស្រី វេជ្ជបណ្ឌិត ដេវ្យ៉ា នី ខុប្រាហ្គឺ ដេ ឯក អគ្គ រដ្ឋទូត ឥណ្ឌា ប្រចាំ កម្ពុជា រួម ជាមួយ យុវតី ហឿង ហ្គិច លីម មាន តួនាទី ជា អ្នក ដើរ តួនាទី ជំនួស លោកស្រី ធី ណា រ៉េដ ស របស់ អង់គ្លេស ប្រចាំ នៅ កម្ពុជា និង យុវតី លេខ ការី មាន តួនាទី ជា អ្នក ដើរ តួនាទី ជំនួស លោកស្រី វេជ្ជបណ្ឌិត ដេវ្យ៉ា នី ខុប្រាហ្គឺ ដេ របស់ ឥណ្ឌា ប្រចាំ នៅ កម្ពុជា បាន ធ្វើ ទស្សនកិច្ច រួមគ្នា នៅ បណ្ណាល័យ សម្ដេច ម៉ែ ។
ស្ថានទូត ឥណ្ឌា ក៏ មាន យុវតី លេខ ការី ដែល ជា អ្នក ឈ្នះ ក្នុង ការប្រកួតប្រជែង « ឯក អគ្គ រាជ ទូត មួយ ថ្ងៃ » នេះ ដែរ ទោះបី ដំណើរការជ្រើសរើស អ្នក ឈ្នះ ខុសពី គ្នា ក៏ដោយ ។ ឯក អគ្គ រដ្ឋទូត ទាំង ពី រូប ដែល ជាប់ ក្នុង ការប្រកួតប្រជែង « ឯក អគ្គ រាជ ទូត មួយ ថ្ងៃ » បាន មក ធ្វើ ទស្សនកិច្ច រួមគ្នា នៅ បណ្ណាល័យ « សម្តេច ម៉ែ » នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ នេះ ។ វា គឺជា ព្រឹត្តិការណ៍ រួមគ្នា លើក ទី មួយ អំពី ប្រធានបទ នេះ របស់ ស្ថានទូត អង់គ្លេស និង ស្ថានទូត ឥណ្ឌា ប្រចាំ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ។
នៅក្នុង ឱកាស នៃ ដំណើរទស្សនកិច្ច នេះ អ្នកស្រី សូ ហ្វារី ណា បង្ហាញ សៀវភៅ កំណត់ហេតុ ដ៏ គួរឲ្យ អារម្មណ៍ របស់ ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ដែល មាន ចំណងជើង ថា « ព្រះរាជ ដំណើរ របស់ សម្ដេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ យាង ទៅកាន់ តំបន់ រំដោះ នៃ រណសិរ្ស រួម ជាតិ កម្ពុជា ក្នុង ឆ្នាំ ១៩៧៣ ដល់ គណៈប្រភិភូ ។
លោកស្រី ឯក អគ្គ រាជ ទូត អង់គ្លេស និង ឯក អគ្គ រដ្ឋទូត ឥណ្ឌា បាន សរសើរ អំពី តួនាទី របស់ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា ក៏ ដូចជា បណ្ណាល័យ សម្ដេច ម៉ែ ក្នុង ការថែរក្សា ឯកសារ ទុក សម្រាប់ សាធារណជន និង បាន រួមចំណែក ផ្ដល់ ឯកសារ ដល់ សាលា ក្ដី ខ្មែរ ក្រហម ដើម្បី ស្វែងរក យុត្តិធម៌ ជូន ជនរងគ្រោះ ព្រមទាំង បាន ធ្វើ ការអប់រំ អំពី របប ខ្មែរ ក្រហម ដល់ សិស្សានុសិស្ស និង យុវជន ជំនាន់ ក្រោយ ។
ជា ចុងក្រោយ គណៈប្រតិភូ បាន ចំណារ នៅលើ សៀវភៅ ក្រាំង មាស របស់ បណ្ណាល័យ « សម្តេច ម៉ែ » ដែល មាន ខ្លឹមសារ ដូចតទៅ ៖
យុវតី លេខ ការី មកពី ខេត្ត រតនគិរី៖ « នេះ គឺជា លើក ទី មួយ សម្រាប់ ខ្ញុំ ដែល បាន មក ទស្សនកិច្ច នៅ បណ្ណាល័យ « សម្ដេច ម៉ែ » ។ ខ្ញុំ ពិតជា មាន សេចក្ដីរីករាយ សោមនស្ស យ៉ាង ក្រៃលែង នៅ ពេល ដែល បាន ស្ដាប់ នូវ វីរភាព ដ៏ អង់អាច ក្លាហាន របស់ សម្ដេច ម៉ែ ។ ប៉ុន្តែ ខ្ញុំ ហាក់ដូចជា មានអារម្មណ៍ កម្សត់ នៅពេល បាន ស្ដាប់ អំពី របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ។ ខ្ញុំ នឹង ចងចាំ នូវ អនុស្សាវីយ៍ នៅ ថ្ងៃ នេះ ហើយ ចែករំលែក ឲ្យ សហគមន៍ ខ្ញុំ បាន ដឹង » ។
យុវត្តី ហឿង ហ្គិច លីម មកពី ទីក្រុង ភ្នំពេញ៖ « ខ្ញុំ ពិតជា បាន ឃើញ ផ្ទាល់ ភ្នែក របស់ ខ្ញុំ ។ វា គួរតែ ជា ទីកន្លែង ដែល អ្នក ត្រូវតែ មក ទស្សនា ម្ដង ក្នុង មួយ ជីវិត របស់ អ្នក ។ ខ្ញុំ បាន ស្ដាប់ នូវ ប្រវត្តិសាស្រ្ត របស់ ជាតិ ខ្ញុំ » ។
ឡាវ ប្រកាស រកឃើញ ករណី ឆ្លង កូវីដ - ១៩ ចំនួន ២. ៦៩៧នាក់ ក្នុង របាយការណ៍ ថ្ងៃពុធ នេះ
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ទាំងនោះ មាន ២. ៦៨១នាក់ ជា ករណី ឆ្លង ក្នុង ស្រុក ផ្ទាល់ និង ១៦ នាក់ ករណី នាំចូល ពី ក្រៅ ប្រទេស ហើយ រដ្ឋធានី វៀង ចន្ទន៍ ជា កន្លែង ដែល រាយការណ៍ ករណី ឆ្លង ក្នុង ស្រុក ច្រើន ជាង គេ គឺ ១. ២០៤ ករណី ។ ជាមួយគ្នា នេះ មនុស្ស ៣៨៤ នាក់ ក៏ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ផងដែរ ក្រោយ ជាសះស្បើយ ។
ធនាគារ ARDB ប្រកាស រក គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ មក សហការផ្ដល់ ឥណទាន គាំទ្រ ដល់ ការដាំដុះ បន្លែ ផ្លែ ឈើ . ការចិញ្ចឹម សត្វ . វារី វប្បកម្ម និង ការកែច្នៃ ផលិតផល កសិកម្ម
( ភ្នំពេញ ) ៖ ធនាគារ អភិវឌ្ឍន៍ ជនបទ និង កសិកម្ម (ARDB) នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ដោយ ប្រកាស ស្វែងរក គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ មក សហការផ្ដល់ ឥណទាន គាំទ្រ ដល់ ការដាំដុះ បន្លែ ផ្លែ ឈើ . ការចិញ្ចឹម សត្វ . វារី វប្បកម្ម និង ការកែច្នៃ ផលិតផល កសិកម្ម ព្រមទាំង ឥណទាន គាំទ្រ ដល់ តួអង្គ ក្នុង ខ្សែ ច្រវាក់ ផលិតកម្ម ក្នុង វិស័យ មៀន ប៉ៃលិន ស្វាយ និង ស្វាយចន្ទី ៕
ក្នុង របាយការណ៍ ថ្ងៃពុធ នេះ ដែរ ក្រសួង សុខាភិបាល វៀតណាម ក៏ បាន ប្រកាស ពី ករណី អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ៤១ នាក់ បន្ថែម ទៀត ផងដែរ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ ណែនាំ ជាថ្មី ដល់ ក្រុម បាតុករ កុំ ឲ្យ ប្រមូលផ្តុំ ធ្វើ បាតុកម្ម ខុស ច្បាប់ តាម ដងផ្លូវ សាធារណៈ និង ទី សាធារណៈ ផ្សេង ទៀត
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន ធ្វើ ការណែនាំ ជាថ្មី ដល់ ក្រុម បាតុករ ដែល ជា អតីត បុគ្គលិក និង បុគ្គលិក ក្រុមហ៊ុន ណាហ្គាវើលដ៍ ដើម្បី កុំ ឲ្យ ប្រមូលផ្តុំ គ្នា ធ្វើ បាតុកម្ម ខុស ច្បាប់ នៅ តាម ដងផ្លូវ សាធារណៈ តាម ចិញ្ចើមផ្លូវ សួនច្បារ សាធារណៈ និង ទី សាធារណៈ ផ្សេង ទៀត ។
ចំពោះ មុខ រដ្ឋបាល រាជធានី ភ្នំពេញ សូម ធ្វើ ការណែនាំ សារជាថ្មី ដល់ ក្រុម បាតុករ ត្រូវ អនុវត្ត តាម នីតិវិធី ដែល មាន ចែង ក្នុង មាត្រា ៥ ជំពូក ទី២ នៃ ច្បាប់ ស្តីពី ការធ្វើ បាតុកម្ម ដោយ សន្តិវិធី « ក្រុម បុគ្គល ណា ដែល មាន បំណង រៀបចំ ធ្វើ បាតុកម្ម ដោយ សន្តិវិធី នៅ ទី សាធារណៈ ណាមួយ ត្រូវ ជូនដំណឹង ជា លាយលក្ខណ៍ អក្សរ ទៅ អាជ្ញាធរដែនដី រាជធានី ឬ ខេត្ត មាន សមត្ថកិច្ច គ្រប់គ្រង ទីកន្លែង នោះ » ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ បន្ថែម ថា ករណី នេះ កន្លងមក ក្រុម បាតុករ បាន ទទួល ការបកស្រាយ ច្បាប់ ខុស ក្នុង ន័យ បំភាន់ សាធារណមតិ តាម ការ នឹកឃើញ របស់ ខ្លួន ថា សកម្មភាព របស់ ខ្លួន ជា ការធ្វើ កូដកម្ម ទៅ វិញ តែ សកម្មភាព ពិត របស់ ពួកគាត់ គឺ ធ្វើ ការប្រមូលផ្តុំ លើក បដា និង ប្រើ ឧក្បៀសនា សព្ទ ចល័ត ស្រែក ទាមទារ នៅ តាម ដងផ្លូវ សាធារណៈ ចិញ្ចើមផ្លូវ សួនច្បារ សាធារណៈ និង ទី សាធារណៈ ផ្សេង ទៀត តាំងពី ដើម រៀង មក ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ៖ ចំណេះដឹង ទូទៅ៖ ទឹក ជំនន់ វាយប្រហារ ប្រទេស ណា ខ្លះ ខ្លាំង ជាង គេ ក្នុង ប្រវត្តិសាស្ត្រ មនុស្សជាតិ ?
( បរទេស ) ៖ គ្រោះ ទឹក ជំនន់ គឺជា គ្រោះមហន្តរាយ មួយ ដ៏ កំណាច ដែល តែង ឆក់ យក ជីវិត មនុស្ស រៀងរាល់ ឆ្នាំ និង បង្ក វិនាសកម្ម យ៉ាង ធ្ងន់ធ្ងរ ដល់ ប្រជាជាតិ នានា ជុំវិញ ពិភពលោក ។ តើ អ្នក ដឹង ទេ ថា ប្រទេស ណា ខ្លះ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ខ្លាំង ជាង គេ ក្នុង ប្រវត្តិសាស្ត្រ ពិភពលោក យើង នេះ ?
នៅ ប្រទេស ចិន ទឹក ជំនន់ បាន បង្ក ការបំផ្លិចបំផ្លាញ រាប់ ពាន់ ឆ្នាំ មកហើយ តែ ប្រជាជន នៅតែ ទ្រាំ រស់ នៅ ជាមួយ ការលិចលង់ នេះ តាំងពី បុរាណ ដល់ ពេល បច្ចុប្បន្ន ហើយក៏ តែងតែ មាន មនុស្ស ស្លាប់ ជារៀងរាល់ ឆ្នាំ ដែរ ។ គ្រោះមហន្តរាយ ដ៏ កំណាច នេះ គឺ បង្កឡើង ដោយ ទន្លេ សំខាន់ ៗ ចំនួន ២ គឺ ទន្លេ ឆាង ជាំង ( យ៉ង់ សេ) និង ទន្លេ លឿង ខណៈ ប្រជាជន ប្រមាណ ៣៥០ លាន នាក់ កំពុង រស់ នៅ តាម ដងទន្លេ ឆាង ជាំង និង ប្រមាណ ១០០ លាន នាក់ ទៀត រស់ នៅ តាម ដងទន្លេ លឿង ។
យោង តាម ការកត់ត្រា នៅ ឆ្នាំ ១៨៨៧ ទន្លេ លឿង បាន ជន់ លិច លើ ផ្ទៃដី ប្រមាណ ៣០.០០០ គីឡូម៉ែត្រ ការ៉េ ធ្វើឱ្យ លិច លង់ ភូមិដ្ឋាន របស់ ប្រជាជន ចិន អស់ ប្រមាណ ១.៥០០ ភូមិ ។ រីឯ ទន្លេ ឆាង ជាំង នៅ ភាគ ខាងត្បូង នោះ វិញ ក៏ តែងតែ បង្កឱ្យ មាន ទឹក ជំនន់ គួរឱ្យ ភ័យខ្លាច ខ្លាំង ណាស់ ខណៈ ទឹក ជំនន់ ធំ បំផុត បាន កើតឡើង នៅ ឆ្នាំ ១៨៨៧ បង្កឱ្យ មាន អ្នក រងគ្រោះ ប្រមាណ ៩០០.០០០ នាក់ ។ រហូតមកដល់ ឆ្នាំ ១៩៣៨ ទឹក ជំនន់ ក៏ បាន បង្កឱ្យ មាន អ្នក រងគ្រោះ ប្រហាក់ប្រហែល នឹង ឆ្នាំ ១៨៨៧ ដែរ ។
ចាប់ពី ចុង ទសវត្សរ៍ ឆ្នាំ ១៩៩០ រហូតមក ប្រទេស ចិន តែង រងគ្រោះ ធ្ងន់ធ្ងរ ដោយសារ គ្រោះ ទឹក ជំនន់ ជា បន្តបន្ទាប់ ។ ឆ្លើយតប នឹង គ្រោះ ធម្មជាតិ នេះ រដ្ឋាភិបាល ក្រុង ប៉េកាំង បាន កសាង ទំនប់ ច្រក ភ្នំ ចំនួន ៣ ចាប់ពី ឆ្នាំ ២០០៣ ដើម្បី កាត់បន្ថយ ផល ប៉ះពាល់ ដោយសារ ទឹក ជំនន់ ទន្លេ ឆាង ជាំង ឬ ទន្លេ យ៉ង សេនេះ ។
ក្រៅពី ប្រទេស ចិន ក៏ មាន ប្រទេស មួយចំនួន ទៀត ដែល រងគ្រោះ ដោយសារ គ្រោះ ទឹក ជំនន់ នេះ ក្នុង នោះ រួម មាន ប្រទេស ឥណ្ឌា បង់ក្លាដែស វៀតណាម ប៉ាគីស្ថាន ឥណ្ឌូណេស៉ី អេហ្ស៉ី ប មីយ៉ាន់ម៉ា អាហ្វហ្កានីស្ថាន នីហ្សេរីយ៉ា ប្រេស៉ី ល ថៃ កុងហ្គោ អ៉ីរ៉ាក់ ព្រមទាំង កម្ពុជា ផងដែរ ។
ជា ការពិត ណាស់ អ្នកវិទ្យាសាស្ត្រ បាន ចែក គ្រោះ ទឹក ជំនន់ ជា បី ប្រភេទ ធំ ៗ៖
កម្មវិធី នេះ បាន រៀបចំឡើង ក្រោម អធិបតីភាព លោក បណ្ឌិត ញឹម ខេមរា រដ្ឋលេខាធិការ តំណាង របស់ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ដោយ មាន កិច្ចសម្របសម្រួល ពី ក្រុមការងារ សម្របសម្រួល ការទូត សេដ្ឋកិច្ច ។ កម្មវិធី នេះ មាន ការចូលរួម ពី តំណាង ក្រសួង ទេសចរណ៍ កម្ពុជា ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា (CDC) សភា ពាណិជ្ជកម្ម កម្ពុជា និង តំណាង វិស័យ ឯកជន របស់ កម្ពុជា និង ស៊ែប៊ី សរុប ប្រមាណ ១៥០ នាក់ ។
ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ សង្ឃឹម និង ជឿជាក់ ថា កម្មវិធី នេះ នឹង ដើរតួ ជា ចំណុច ចាប់ផ្តើម ថ្មី មួយ ទៀត ក្នុង ការជំរុញ កិច្ចសហប្រតិបត្តិការ ផ្នែក សេដ្ឋកិច្ច និង វប្បធម៌ រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ ប្រសើរឡើង តាមរយៈ ការស្តារ ឡើងវិញ នៃ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច ក្រោយ វិបត្តិ កូវីដ - ១៩៕ ប្រជាជន អ៊ុយក្រែន លើស ៤លាន នាក់ ហើយ ដែល ភៀសខ្លួន ចេញ ពី ប្រទេស ក្រោយ សង្រ្គាម ផ្ទុះឡើង . នេះ បើ តាម UN
យោង តាម របាយការណ៍ ចុងក្រោយ បំផុត របស់ ទីភ្នាក់ងារ ជនភៀសខ្លួន របស់ UN គឺ UNHCR ចំនួន ជនភៀសខ្លួន សរុប ដែល បាន រត់ គេច ពី ប្រទេស អ៊ុយក្រែន គិត ត្រឹម ថ្ងៃទី ២៩ ខែមីនា គឺ ៤. ០២លាន នាក់ ហើយ ពាក់កណ្តាល ក្នុង ចំណោម នោះ បាន ភៀសខ្លួន ចូល ទៅកាន់ ប្រទេស ប៉ូឡូញ ។
ពី ដំបូង ឡើយ ទីភ្នាក់ងារ UNHCR បាន ប៉ាន់ប្រមាណ ថា ចំនួន ជនភៀសខ្លួន អ៊ុយក្រែន ដែល នឹង រត់ ចេញ ពី ប្រទេស ដោយសារតែ សង្រ្គាម អាច កើន ដល់ ចំនួន ត្រឹម ៤លាន នាក់ ប៉ុន្តែ មក ទល់ ឥឡូវ គឺ រយៈ៥ សប្តាហ៍ ក្រោយ ការវាយប្រហារ របស់ រុស្ស៉ី គឺ តួលេខ បាន កើន ហួស ៤លាន នាក់ បាត់ ទៅ ហើយ ។ ជាមួយគ្នា នេះ មនុស្ស ជាង ៦លាន នាក់ ទៀត ក៏ បាន ព្រាត់ប្រាស់ ពី ផ្ទះសម្បែង ផងដែរ នៅក្នុង ប្រទេស អ៊ុយក្រែន ផ្ទាល់ ៕
ឧកញ៉ា វិញ ហ៊ួរ និង លោកជំទាវ លោក វិញ ខេវិន និង លោកស្រី លីវ ស៊ីវមី តំណាង ក្រុមហ៊ុន កំពត ផត បរិច្ចាគ ថវិកា ៥ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
នា កន្លងមក ឧកញ៉ា វិញ ហ៊ួរ និង លោកជំទាវ លោក វិញ ខេវិន និង លោកស្រី លីវ ស៊ីវមី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម នុត សាអាន និង លោកជំទាវ ទិត្យ ខាំ ដារ៉ា បរិច្ចាគ ថវិកា ៥លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
នា កន្លងមក ឯកឧត្ដម នុត សាអាន និង លោកជំទាវ ទិត្យ ខាំ ដារ៉ា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ចំពោះ ព័ត៌មាន លម្អិត សូម ទំនាក់ទំនង៖ * លោកជំទាវ ពុំ ចន្ទីនី លេខ ទូរស័ព្ទ៖ ០១២ ៩២១ ១០៥ * លោកជំទាវ មែន នារី សោភ័គ លេខ ទូរស័ព្ទ៖ ០១២ ៨១០ ៨៥៤ * ឯកឧត្តម ឌួង អេលីត លេខ ទូរស័ព្ទ៖ ០១៧ ២៤៨ ៨៨៨ ឯកឧត្ដម ស្រុី ថាម រុង្គ និង លោកជំទាវ ថោង សុជាតា បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ស្រុី ថាម រុង្គ និង លោកជំទាវ ថោង សុជាតា បាន បរិច្ចាគ ថវិកា ចំនួន ១.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម ស្រុី ថាម រុង្គ និង លោកជំទាវ ថោង សុជាតា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម បណ្ឌិត ជេត ជាលី បរិច្ចាគ ថវិកា ៤០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្តម បណ្ឌិត ជេត ជាលី សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ បាន បរិច្ចាគ ថវិកា ចំនួន ៤០.០០០.០០០ រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្តម បណ្ឌិត ជេត ជាលី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ថ្ងៃស្អែក គ.ជ. ប នឹង ជំនុំជម្រះ លើ បណ្ដឹង ៥ទៀត ប្រឆាំង នឹង ការដាក់ បេក្ខជន គណបក្ស ភ្លើង ទៀន នៅ រាជធានី ភ្នំពេញ
ពាក្យបណ្ដឹង ទាំង៥ ខាងលើ នេះ មាន កម្មវត្ថុ ដូច ខាងក្រោម៖
* ប្ដឹង សុំ បដិសេធ បញ្ជី បេក្ខជន ឈរឈ្មោះ របស់ គណបក្ស ភ្លើង ទៀន នៅ សង្កាត់ ព្រែក លៀប ខណ្ឌ ជ្រោយ ចង្វារ និង សង្កាត់ ផ្សារ ដើម គរ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ចំនួន ២បណ្ដឹង
* ប្ដឹង ជំទាស់ មិន ឈរឈ្មោះ ជា បេក្ខជន ក្រុមប្រឹក្សា និង បដិសេធ បញ្ជី បេក្ខជន ឈរឈ្មោះ របស់ គណបក្ស ភ្លើង ទៀន សង្កាត់ មនោរម្យ ខណ្ឌ ៧មករា រាជធានី ភ្នំពេញ ចំនួន ៣បណ្ដឹង ៕ ក្រុមហ៊ុន ឡេត ចេង ម៉ាញ និង ឌីវេឡុប ម៉ិន ឯ . ក បរិច្ចាគ ថវិកា ៥ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
នា កន្លងមក ក្រុមហ៊ុន ឡេត ចេង ម៉ាញ និង ឌីវេឡុប ម៉ិន ឯ . ក តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ក្រុមហ៊ុន យិះចៀ ធួរី ស្សឹម ឌីវេឡុប មេន ខម ភេនី បរិច្ចាគ ថវិកា ១០ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន យិះចៀ ធួរី ស្សឹម ឌីវេឡុប មេន ខម ភេនី បាន បរិច្ចាគ ថវិកា ចំនួន ១០០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ក្រុមហ៊ុន យិះចៀ ធួរី ស្សឹម ឌីវេឡុប មេន ខម ភេនី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា លី សុខ ថៃ អគ្គ នាយក ក្រុមហ៊ុន ដែល ខម កម្ពុជា និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ៣០០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក អ្នក ឧកញ៉ា លី សុខ ថៃ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្ដម បណ្ឌិត កៅ ថា ច និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ៣.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្ដម បណ្ឌិត កៅ ថា ច និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោកជំទាវ ហេង ទាន់ ដួង ហេង បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ លោកជំទាវ ហេង ទាន់ ដួង ហេង បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក លោកជំទាវ ហេង ទាន់ ដួង ហេង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ជយោសមិទ្ធផល ជាតិ ក្រោម ម្លប់ សុខ សន្តិភាព ! ព្រឹក ស្អែក សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន អាកាស និង ផ្លូវ ក្រោម ដី ចោម ចៅ
សមិទ្ធផល ថ្មី ក្នុង ដែនដី រាជធានី ភ្នំពេញ កើត ចេញ ពី ម្លប់ សុខ សន្តិភាព នេះ នឹង ត្រូវ បើក សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី៣១ ខែមីនា ឆ្នាំ ២០២២ ស្អែក នេះ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
លោក បន្ត ថា ដំណើរកម្សាន្ត របស់ ភ្ញៀវ ទេសចរ នៅតែ មាន ជាក់ស្ដែង បន្ទប់ ស្នាក់ នៅ តាម សណ្ឋាគារ ផ្ទះសំណាក់ ក្នុង ខេត្ត ធំ ៗ មាន សៀមរាប ព្រះសីហនុ និង តំបន់ ឆ្នេរ គិត ត្រឹម ពេលនេះ មាន ការកក់ ស្នាក់ នៅ ជា បន្ដ បន្ទាប់ ។ ការឲ្យដឹង របស់ លោក រដ្ឋមន្រ្ដី ថោង ខុន ធ្វើឡើង ក្នុង សន្នីសីទ សារព័ត៌មាន នៅ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ ។
លោក ថោង ខុន បាន ថ្លែង ថា « ឱកាស បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ ខាងមុខ នឹង មាន ភ្ញៀវ ទេសចរ ដើរកម្សាន្ត ច្រើន ទោះបីជា សាំង ឡើង ថ្លៃ ក៏ដោយ ប្រជាពលរដ្ឋ នឹង សន្សំ សំចៃ ដោយ ប្ដូរ ឥរិយាបទ ក្នុង ការប្រើប្រាស់ រថយន្ដ ដើរកម្សាន្ត ជា ក្រុម ដើម្បី កាត់បន្ថយ ថ្លៃ ធ្វើដំណើរ ។ ជាក់ស្ដែង គិត ត្រឹម ថ្ងៃ នេះ មាន ការកក់ សណ្ឋាគារ ជាច្រើន មាន ក្នុង ខេត្ត សៀមរាប មណ្ឌលគិរី ព្រះសីហនុ និង តំបន់ ឆ្នេរ ជាដើម » ។
( ភ្នំពេញ ) ៖ លោក ពៅ អ៉ីសាង បាន បរិច្ចាគ ថវិកា ចំនួន ៥០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក លោក ពៅ អ៉ីសាង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោកជំទាវ ប៉ែន ចន្នី ហ៊ីង ប៊ុន ហៀង បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ លោកជំទាវ ប៉ែន ចន្នី ហ៊ីង ប៊ុន ហៀង បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក លោកជំទាវ ប៉ែន ចន្នី ហ៊ីង ប៊ុន ហៀង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោកជំទាវ ហ៊ីង សុខ លាភ ណុប រ័ត្ន និមល បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ លោកជំទាវ ហ៊ីង សុខ លាភ ណុប រ័ត្ន និមល បាន បរិច្ចាគ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក លោកជំទាវ ហ៊ីង សុខ លាភ ណុប រ័ត្ន និមល តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
កម្ពុជា - កូរ៉េ ខាងត្បូង រំពឹង ថា ការចូល ជាធរមាន កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី កម្ពុជា - កូរ៉េ នឹង ជំរុញ សកម្មភាព ពាណិជ្ជកម្ម និង ការវិនិយោគ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ លោក សុខ ចិន្តា សោភា រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា លើកឡើង ថា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី រវាង កម្ពុជា និង កូរ៉េ នឹង ជួយ ត្រួសត្រាយ ផ្លូវ ក្នុង ការបង្កើន សកម្មភាព ពាណិជ្ជកម្ម និង ការវិនិយោគ រវាង ប្រទេស ទាំង ពីរ កាន់តែ កើនឡើង ថែម ទៀត ។
លោក សុខ ចិន្តា សោភា លើកឡើង បែប នេះ ធ្វើឡើង ក្នុង ជំនួប ពិភាក្សា ការងារ ជាមួយ លោក បណ្ឌិត ឃូ យុន ឆូល (Koo Yun-cheol) រដ្ឋមន្រ្តី ទទួលបន្ទុក សម្របសម្រួល គោល នយោបាយ រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ កូរ៉េ នា រសៀល ថ្ងៃ ទី ២៩ ខែមីនា ឆ្នាំ ២០២២ នៅ ទីស្តី ការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ក្នុង ឱកាស ដែល លោក មក បំពេញ ទស្សនកិច្ច នៅ ប្រទេស កម្ពុជា រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៨ ដល់ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ ។
កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី រវាង កម្ពុជា និង កូរ៉េ ត្រូវបាន ចុះហត្ថលេខា លើ កាលពី ចុង ខែតុលា ឆ្នាំ ២០២១ ដែល កិច្ចព្រមព្រៀង នេះ នឹង ចូល ជាធរមាន នា ពេល ឆាប់ ៗ ខាងមុខ ។
លោក សុខ ចិន្តា សោភា បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការវិនិយោគ ផ្ទាល់ ពី កូរ៉េ ដែល មិន ត្រឹមតែ នាំមក នូវ ដើមទុន និង បច្ចេកវិទ្យា ប៉ុណ្ណោះ ទេ ថែមទាំង នាំមក នូវ ស្មារតី តស៊ូ មិន លះបង់ ផងដែរ ។
លោក ឃូ យុន ឆូល រដ្ឋមន្រ្តី ទទួលបន្ទុក សម្របសម្រួល គោល នយោបាយ រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ កូរ៉េ បាន ថ្លែងអំណរគុណ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ជាពិសេស ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ដែល តែងតែ បាន ផ្តល់ កិច្ច គាំទ្រ គ្រប់ បែបយ៉ាង ដល់ វិនិយោគិន កូរ៉េ នៅ កម្ពុជា ។
លោក ជឿជាក់ ថា កិច្ច គាំទ្រ នេះ គួបផ្សំ ជាមួយនឹង ច្បាប់ វិនិយោគ ថ្មី របស់ កម្ពុជា និង ការចូល ជាធរមាន នៃ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី កម្ពុជា - កូរ៉េ នឹង ជំរុញ ឱ្យ មាន ការវិនិយោគ ពី កូរ៉េ មក កម្ពុជា បន្ថែម ។
ទន្ទឹម គ្នា នេះ រដ្ឋមន្រ្តី ទទួលបន្ទុក សម្របសម្រួល គោល នយោបាយ រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ កូរ៉េ រូប នេះ បាន អញ្ជើញ លោក សុខ ចិន្តា សោភា និង សហការី ទៅ បំពេញ ទស្សនកិច្ច នៅ សាធារណរដ្ឋ កូរ៉េ នៅពេលវេលា សមស្រប ណាមួយ ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ក្នុង វិស័យ វិនិយោគ និង សហ- ប្រតិបត្តិការ អភិវឌ្ឍន៍ ។
លោក សុខ ចិន្តា សោភា បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល កូរ៉េ ដែល បាន បន្ត រក្សា ឱ្យ មាន ជើងហោះហើរ ត្រង់ រវាង ទីក្រុង សេអ៊ូល និង រាជធានី ភ្នំពេញ ដោយ ពុំ មាន ការរអាក់រអួល ចាប់តាំងពី ដំណាក់កាល ដំបូង នៃ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ រហូតមក ទល់ បច្ចុប្បន្ន ដែល ប្រការ នេះ បាន ផ្តល់ លទ្ធភាព ដល់ កម្ពុជា ក្នុង ការតភ្ជាប់ ជាមួយ ពិភពលោក ។
សូម បញ្ជាក់ ថា គិត ត្រឹម ខែកុម្ភៈ ឆ្នាំ ២០២២ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន ចុះបញ្ជី គម្រោង វិនិយោគ មាន លក្ខណៈ សម្បត្តិ គ្រប់គ្រាន់ របស់ កូរ៉េ ចំនួន ២១៩ គម្រោង ក្នុង ទុន វិនិយោគ សរុប ប្រមាណ ៥ប៊ីលាន ដុល្លារ អាមេរិក ៕
របាយការណ៍៖ ចក្រភព អង់គ្លេស បាន ប្រើប្រាស់ « ស្តង់ដារ ពីរ » ចំពោះ ដំណោះស្រាយ បញ្ហា ជនភៀសខ្លួន អ៊ុយក្រែន និង ស៊ីរី
នៅក្នុង បទសម្ភាសន៍ ផ្តាច់ មុខ មួយ លោក បាន លើកឡើង ថា « ការប្រព្រឹត្តិ ដោយ អនុគ្រោះ សម្រាប់ ជនភៀសខ្លួន អ៊ុយក្រែន យើង អាច មើលឃើញ វា នឹង ភ្នែក ។ វា ជា ស្តង់ដារ ពីរ ។ ជនភៀសខ្លួន គួរ ត្រូវបាន ចាត់ទុក ដោយ ស្មើភាព គ្នា ដោយ មិន ប្រកាន់ ពូជសាសន៍ ឬ សាសនា អ្វី ឡើយ ព្រោះ ពួកគេ មាន សិទ្ធិ ស្មើគ្នា » ។
ចក្រភព អង់គ្លេស បាន ផ្តល់ ទិដ្ឋាការ ចំនួន ២២.០០០ ដល់ ជនភៀសខ្លួន អ៊ុយក្រែន ក្រោម គម្រោង ទិដ្ឋាការ លក្ខណៈ គ្រួសារ ដែល បាន ចាប់ផ្តើម កាលពី ថ្ងៃទី ០៤ ខែមីនា ខណៈ២.០០០ នាក់ បន្ថែម ទៀត ត្រូវបាន គេ រំពឹង ថា នឹង ត្រូវបាន គាំទ្រ នៅក្នុង កម្មវិធី បន្ទាប់ ។
ចំណែកឯ ជនជាតិ ស៊ីរី មាន តែ ២០.០០០ នាក់ ប៉ុណ្ណោះ ដែល បាន ភៀសខ្លួន ចេញ ពី ជម្លោះ ក្នុង រយៈពេល ៦ ឆ្នាំ ដោយ មាន ៦៦៦ នាក់ ទៀត មកដល់ អង់គ្លេស តាម គម្រោង ដាច់ដោយឡែក មួយ ៕
អាង ស្តុក ទឹក បឹងត្របែក នឹង ប្រែ មុខមាត់ ថ្មី អម ជាមួយ ផ្លូវ នៅ ជុំវិញ ដែល កំពុងតែ ស្ថាបនា សម្រេចបាន ៨០ % ហើយ
( ភ្នំពេញ ) ៖ អភិបាល ខណ្ឌ ចំការមន លោក ថេង សុថុល បាន លើកឡើង ថា ការស្ថាបនា ផ្លូវ អម ជុំវិញ ផ្ទៃ អាង ស្តុក ទឹក បឹងត្របែក ក្រុមការងារ សម្រេច ការស្ថាបនា បានជាង ៨០% ហើយ ។
លោក ថេង សុថុល បាន ថ្លែង ដូចនេះ ក្នុង ឱកាស ដឹកនាំ មន្ត្រី រដ្ឋបាល ខណ្ឌ សហការ ជាមួយ មន្ទីរ សាធាណ ការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ និង ក្រុមហ៊ុន បុក ស៊ី ផាយ បាន ចុះ ពិនិត្យ វឌ្ឍនភាព នៃ ការស្ថាបនា ផ្លូវ អម ជុំវិញ ផ្ទៃ អាង ស្តុក ទឹក បឹងត្របែក និង បើក ផ្លូវ លេខ ៤៩២ ទម្លុះ ទៅ ផ្លូវ លេខ ១០៥ ស្ថិត នៅក្នុង សង្កាត់ ផ្សារ ដើម ថ្កូវ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ នា រសៀល ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ ។
លោក ថេង សុថុល បាន ប្រាប់ ថា ការចុះ ពិនិត្យ វឌ្ឍនភាព ការងារ នា ពេលនេះ គឺ ដើម្បី រក លទ្ធភាព ស្ដារ ផ្ទៃ អាង ស្តុក ទឹក បឹងត្របែក ជាមួយនឹង ការពិនិត្យ ការស្ថាបនា ផ្លូវ ជុំវិញ អាង ស្តុក ទឹក បឹងត្របែក នេះ ។ លោក បាន បន្ត ថា ចំពោះ ការងារ ស្ថាបនា ផ្លូវ អម ជុំវិញ ផ្ទៃ អាង ស្តុក ទឹក បឹងត្របែក ក្រុមការងារ សម្រេច ការស្ថាបនា បានជាង ៨០% ខណៈ ដែល ផ្លូវ អម ជុំវិញ ផ្ទៃ អាង ស្តុក ទឹក បឹងត្របែក មាន ប្រវែង ជាង ៨០០ ម៉ែត្រ ។
លោក ថេង សុថុល បាន បញ្ជាក់ ថា គិត មកដល់ ពេលនេះ ក្រុមការងារ ក៏ នៅ មាន បញ្ហា ប្រឈម ខ្លះ ដែល ត្រូវ ធ្វើ ការដោះស្រាយ តែ នៅ ពេល ចំពោះមុខ នេះ ក្រុមការងារ ធ្វើការ មួយ ជំហាន សិន ដោយ ក្រុមការងារ កំពុង ធ្វើ ក្រវាត់ ជាមុន សិន ។
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២២ នៅ មជ្ឈមណ្ឌល ន វានុវត្តន៍ នៃ បណ្ឌិត្យ សភា បច្ចេកវិទ្យា ឌីជីថល កម្ពុជា (CADT) លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សំណេះសំណាល និង ប្រគល់ កុំព្យូទ័រ យួរ ដៃ ដល់ និស្សិត អាហារូបករណ៍ ទេពកោសល្យ ឌីជីថល តេជោ ចំនួន ១៥០ នាក់ ដែល សិក្សា នៅ បណ្ឌិត្យ សភា បច្ចេកវិទ្យា ឌីជីថល កម្ពុជា វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ និង សាកលវិទ្យាល័យ អាមេរិកកាំង ភ្នំពេញ ។
បន្ថែម លើ នោះ ដែរ លោក រដ្ឋមន្ត្រី មាន សង្ឃឹម ជឿជាក់ យ៉ាង មុតមាំង ថា និស្សិត ដែល ទទួលបាន ជ័យលាភី អាហារូបករណ៍ នៅ ពេល នេះ នឹង ចូលរួមចំណែក ដ៏ ធំធេង ទៅដល់ ការអភិវឌ្ឍ ប្រទេស ជាពិសេស គឺ វិស័យ បច្ចេកវិទ្យា ឌីជីថល នេះ ផងដែរ ព្រមទាំង អាច ក្លាយ ខ្លួន ជា អ្នកដឹកនាំ លើ វិស័យ នេះ នា ពេល អនាគត ក្នុង ខណៈ ដែល ប្រទេស យើង កំពុងតែ កសាង ខឿន សេដ្ឋកិច្ច ឌីជីថល និង ឈាន ទៅ អភិវឌ្ឍ ឧស្សាហកម្ម ជំនាន់ ទី៤។ ។
( កូឡុំ បូ) ៖ ប្រទេស ស្រីលង្កា នៅ ថ្ងៃពុធ នេះ បាន សម្រេច ការផ្ដាច់ការផ្គត់ផ្គង់ អគ្គិសនី ដល់ ទៅ ១០ ម៉ោង ក្នុង មួយ ថ្ងៃ នៅ ទូប្រទេស ខណៈ វារី អគ្គិសនី មិន អាច ដំណើរការបាន ព្រោះ ខ្វះ ប្រភព ថាមពល ទឹក បន្ថែម ពីលើ បញ្ហា ខ្វះ ឥន្ធនៈ ដែល កំពុង កើតឡើង ស្រាប់ ។ នេះ បើ យោង តាម ការចុះផ្សាយ របស់ សារព័ត៌មាន CNA នៅ ថ្ងៃពុធ ទី៣០ ខែមីនា ឆ្នាំ ២០២២ ។
អាជ្ញធរ អគ្គិសនី ស្រីលង្កា បាន និយាយ ថា « អគ្គិសនី ត្រូវបាន កាត់ផ្តាច់ រយៈពេល ១០ ម៉ោង ក្នុង មួយ ថ្ងៃ ដោយសារតែ មិន មាន ប្រេង គ្រប់គ្រាន់ សម្រាប់ ចាក់ ដំណើរការ ម៉ាស៊ីនភ្លើង ខណៈ កាលពី ដើម ខែមីនា នេះ ការកាត់ផ្តាច់ អគ្គិសនី ត្រូវ ធ្វើឡើង ត្រឹមតែ ៧ ម៉ោង ប៉ុណ្ណោះ ក្នុង មួយ ថ្ងៃ » ។ ជាង ៤០ ភាគរយ នៃ ការផលិត អគ្គិសនី របស់ សី្រលង្កា ត្រូវបាន បង្កើត ចេញ ពី វារី អគ្គិសនី ប៉ុន្តែ ភាគ ច្រើន នៃ អាង ស្តុក ទឹក កំពុង ប្រឈម នឹង ការខ្វះខាត ទឹក ដោយសារតែ គ្មាន ភ្លៀង ធ្លាក់ ។
ជាមួយគ្នា នោះ ដែរ ការផលិត អគ្គិសនី ភាគ ច្រើន គឺ ប្រើ ធ្យូងថ្ម និង ឥន្ធនៈ ប៉ុន្តែ ការនាំចូល ក៏ មាន ការខ្វះខាត ដែរ ដោយសារតែ ស្រីលង្កា មិន មាន រូបិយ បណ្ណ បរទេស គ្រប់គ្រាន់ ក្នុង ការដោះដូរ ឬ ចំណាយ លើ ការនាំចូល ។
តម្លៃ ឥន្ធនៈ បាន ហក់ ឡើង ខ្ពស់ ចាប់តាំងពី ដើម ឆ្នាំ នេះ ខណៈ ប្រទេស អាស៊ី ខាងត្បូង ដែល មាន ប្រជាជន ចំនួន ២២លាន នាក់ មួយ នេះ កំពុង ស្ថិត ក្នុង វិបត្តិ សេដ្ឋកិច្ច ដ៏ អាក្រក់ បំផុត ចាប់តាំងពី ទទួលបាន ឯករាជ្យ នៅ ឆ្នាំ ១៩៤៨ ដោយសារតែ កង្វះខាត រូបិយ បណ្ណ បរទេស ដើម្បី ទូទាត់ លើ ការនាំចូល ៕
នា កន្លងមក លោក ឧកញ៉ា វិញ ហ៊ួរ និង លោកជំទាវ ហ៊្វូ ឆេង សៀង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ លោក ប៉ុល វិបូ និង លោកស្រី ម៉ាក សែនសូនីតា បាន បរិច្ចាគ ថវិកា ចំនួន ១.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក លោក ប៉ុល វិបូ និង លោកស្រី ម៉ាក សែនសូនីតា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក កេីត ឆែ និង លោកស្រី យុត សុវណ្ណ រីដា បរិច្ចាគ ថវិកា ៥លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
នា កន្លងមក លោក កេីត ឆែ និង លោកស្រី យុត សុវណ្ណ រីដា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
បើ តាម មន្ត្រី អ៊ុយក្រែន កងទ័ព រុស្ស៊ី ក៏ នៅតែ បន្ត ផ្លោង គ្រាប់បែក នៅក្បែរ ទីក្រុង ជាច្រើន ទៀត ដែល ស្ថិត នៅ តាម បណ្ដោយ សមរភូមិ ខណ្ឌ ចែក រវាង តំបន់ គ្រប់គ្រង ដោយ រដ្ឋាភិបាល ទីក្រុង កៀវ និង តំបន់ កាន់កាប់ ដោយ ក្រុម ឧទ្ទាម ផ្ដាច់ ទឹកដី គាំទ្រ ដោយ រុស្ស៊ី ក្នុង តំបន់ ដូញ៉េត (Donetsk) ស្ថិត នៅ ភាគ ខាងកើត ប្រទេស អ៊ុយក្រែន ផងដែរ ខណៈ ការវាយប្រហារ គ្នា ទ្រង់ទ្រាយ ធំ បន្ត កើតមាន ក្នុង ទីក្រុង ម៉ារីយូ ប៉ូល (Mariupol) នៃ ភាគ ខាងត្បូង ប្រទេស ។
គួរ បញ្ជាក់ ថា រុស្ស៊ី កាលពី ថ្ងៃអង្គារ សប្ដាហ៍ នេះ បាន សន្យា កាត់បន្ថយ សកម្មភាព យោធា នៅ ជុំវិញ នៅ ជុំវិញ រដ្ឋធានី កៀវ និង ទីក្រុង ឆែរ នីហៀវ (Chernihiv) ស្ថិត នៅ ភាគ ខាងជើង នៃ ប្រទេស ។ ប៉ុន្តែ ទាំង សហរដ្ឋ អាមេរិក និង អ៊ុយក្រែន មាន ការសង្ស័យ ពី ចេតនា ពិត របស់ រុស្ស៊ី ខណៈ កិច្ចចរចា បាន ឈានចូល ដល់ ដំណាក់កាល មួយ ដ៏ សំខាន់ ៕
បញ្ឈប់ ការប្រើ គ្រឿងញៀន ជា ជម្រើស ដ៏ ឆ្លាតវៃ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែមីនា៖ បង្ក្រាប ២៤ ករណី ឃាត់ខ្លួន ៤៧ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៤ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១២ករណី . ដឹកជញ្ជូន រក្សាទុក ២ករណី និង ជួញដូរ ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៤៧ នាក់ ។
បទ អត្ថាធិប្បាយ៖ ជំនួយ វ៉ាក់សាំង ចិន នឹង ធ្វើឱ្យ ប្រជាជន កម្ពុជា ចងចាំ កាន់តែ ខ្លាំង ចំពោះ ទង្វើ ល្អ របស់ មិត្ត ចិន
លោក បណ្ឌិត ជិន សុជាតិ មន្ត្រី ស្រាវជ្រាវ ប្រវត្តិសាស្ត្រ នៃ វិទ្យាស្ថាន សិក្សា ចិន រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន បង្ហាញ ការយល់ឃើញ ថា ជំនួយ វ៉ាក់សាំង របស់ ចិន នឹង ធ្វើឱ្យ ប្រជាជន កម្ពុជា មាន ការចងចាំ និង អគុណ ចំពោះ ប្រទេស ចិន ព្រមទាំង បាន បង្ហាញ កាន់តែ ច្បាស់ ពី ទំនាក់ទំនង ដ៏ ល្អ នៃ ប្រទេស ទាំង ពីរ ។
បើ តាម ក្រសួង សុខាភិបាល វ៉ាក់សាំង បាន ដើរ តួនាទី សំខាន់ ណាស់ ក្នុង ការធ្វើឱ្យ មាន ភាពស៊ាំ ក្នុង សិរី រាង្គកាយ មនុស្ស បើ ឆ្លង កូវីដ១៩ គឺ អាច កាត់បន្ថយ ការឈឺ ធ្ងន់ធ្ងរ និង កាត់បន្ថយ ការស្លាប់ បាន កម្រិត ខ្ពស់ ។ បើ ទោះបីជា ជំងឺ កូវីដ១៩ នៅតែ បន្ត កើតមាន នៅ កម្ពុជា យ៉ាងណា ក្តី តែ ចរន្ត នៃ ដំណើរការ សេដ្ឋកិច្ច និង សកម្មភាព សង្គម ផ្សេង ៗ បាន វិល មក រក ភាព ប្រកតី ដូច មុនពេល ជួប វិបត្តិ កូវីដ - ១៩ វិញ ហើយ ។
ការគ្រប់គ្រង បាន នូវ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា នេះ គឺ ពិត ណាស់ មិន អាច កាត់ផ្តាច់ ពី ជំនួយ បរិក្ខា វេជ្ជសាស្រ្ត បច្ចេកទេស និង ជំនួយ វ៉ាក់សាំង របស់ ចិន បាន ទេ ខណៈ ដែល កន្លងមក នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ថា ចិន ជា ប្រទេស ដែល ផ្តល់ វ៉ាក់ កូវីដ១៩ មិន ចេះ រីងស្ងួត ហើយ ថែមទាំង បាន យក ប្រទេស ចិន ជា បង្អែក យុទ្ធ សម្រាប់ ផ្គត់ផ្គង់ វ៉ាក់សាំង កូវីដ១៩ ហើយ ប្រភព ផ្សេង ៗ ទៀត ជា ប្រភព គាំទ្រ ។
ចំណែកឯ កឧត្តម វ៉ាង វិន ធៀន ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ កម្ពុជា វិញ ក៏ ធ្លាប់ បាន ប្រកាស ដែរ ថា ដរាបណា កូវីដ - ១៩ នៅតែ មាន ដរាប នោះ ប្រទេស ចិន នៅតែ ផ្តល់ ជំនួយ វ៉ាក់សាំង ដល់ កម្ពុជា រហូត ។
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ខ្សាច់ ស បាន បរិច្ចាគ ថវិកា ចំនួន ៥០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ក្រុមហ៊ុន ខ្សាច់ ស តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម ប្រាជ្ញ ចន្ទ និង លោកជំទាវ ឱម សារី បរិច្ចាគ ថវិកា ២០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២២
( ភ្នំពេញ ) ៖ ឯកឧត្តម ប្រាជ្ញ ចន្ទ និង លោកជំទាវ ឱម សារី បាន បរិច្ចាគ ថវិកា ចំនួន ២០.០០០.០០០ រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ឯកឧត្តម ប្រាជ្ញ ចន្ទ និង លោកជំទាវ ឱម សារី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន យ៉ុង ឡុង អិនធើណេសិន ណល បាន បរិច្ចាគ ថវិកា ចំនួន ១០០.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២២ ។
នា កន្លងមក ក្រុមហ៊ុន យ៉ុង ឡុង អិនធើណេសិន ណល តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៩ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អ្នក ឧកញ៉ា គួច ម៉េង លី ប្រគេន ៦.០៤៥ ដុល្លារ ដល់ សមណ សិស្ស និង សមណ និស្សិត ៣២ អង្គ ជួយ សម្រួល ការសិក្សា ក្នុង ប្រទេស ស្រីលង្ការ
សេចក្តីជូនដំណឹង បាន បញ្ជាក់ ថា « មូលនិធិ ម៉េង លី ជេ. គួច ក្រោម ជំនួយ ឧបត្ថម្ភ ផ្ទាល់ ពី អ្នក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី បាន បរិច្ចាគ ថវិកា ចំនួន ៦.០៤៥ ដុល្លារ អាមេរិក ប្រគេន ជូន សមណ សិស្ស និង សមណ និស្សិត ចំនួន ៣២ អង្គ ដើម្បី ជួយ សម្រួល ដល់ ការចំណាយ លើ ការសិក្សា ក្នុង ប្រទេស ស្រីលង្ការ » ។
សូម បញ្ជាក់ ផងដែរ ថា សមណ សិស្ស ចំនួន ៦អង្គ កំពុង សិក្សា ថ្នាក់ ពុទ្ធិក មធ្យមសិក្សា ទុតិយភូមិ សមណ សិស្ស ចំនួន ៧អង្គ កំពុង សិក្សា ថ្នាក់ ពុទ្ធិក មធ្យមសិក្សា បឋម ភូមិ សមណ សិស្ស ចំនួន ១៧អង្គ កំពុង សិក្សា ពី ថ្នាក់ ទី១ ដល់ ទី៤ សមណ និស្សិត ចំនួន ១អង្គ កំពុង សិក្សា ថ្នាក់ បរិញ្ញាបត្រ ជំនាញ ទស្សនវិជ្ជា ព្រះពុទ្ធ សាសនា និង សមណ និស្សិត ចំនួន ១អង្គ កំពុង សិក្សា ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ ជំនាញ ភាសា វិទ្យា ៕
