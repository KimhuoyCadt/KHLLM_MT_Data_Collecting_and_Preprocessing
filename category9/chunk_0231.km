បើ តាម សារព័ត៌មាន CNN មន្ត្រី ខាងលើ ដដែល ក៏ បាន ព្រមាន ដែរ ថា ទីក្រុង ម៉ូស្គូ អាចនឹង បើក ការវាយប្រហារ តាម ផ្លូវ អាកាស ទ្រង់ទ្រាយ ធំ ដោយ ទម្លាក់ គ្រាប់បែក លើ ទីក្រុង ជាច្រើន របស់ អ៊ុយក្រែន ដើម្បី បង្ខំឱ្យ ទីក្រុង កៀវ ចុះចាញ់ ហើយ ការវាយប្រហារ បែប នេះ នឹង ធ្វើឱ្យ ជន ស៊ីវិល ក្នុង ចំនួន ដ៏ ច្រើន អាច នឹង បាត់បង់ជីវិត ។
ក្រុម មន្ត្រី អាមេរិក ធ្លាប់ បាន ចោទប្រកាន់ ថា ទាហាន ស៊ីឈ្នួល របស់ រុស្ស៊ី មួយចំនួន បាន ស្ថិត នៅក្នុង ប្រទេស អ៊ុយក្រែន រួចទៅហើយ ដើម្បី ចូលរួម ក្នុង ប្រតិបត្តិការ យោធា របស់ លោក ពូទីន ៕
បើ តាម យោធា កូរ៉េ ខាងត្បូង ការធ្វើតេស្ដមីស៊ីល នៅ ថ្ងៃសៅរ៍ នេះ ត្រូវបាន បាញ់ ចេញ ពី ទីតាំង មួយ កន្លែង ស្ថិត នៅក្បែរ តំបន់ Sunan ជា ទី ដែល អាកាស យានដ្ឋាន អន្តរជាតិ ទីក្រុង ព្យុងយ៉ាង ស្ថិត នៅ ។ នេះ ជា ការធ្វើតេស្ដមីស៊ីល ជា លើក ទី៩ ក្នុង ឆ្នាំ ២០២២ នេះ ហើយ ការធ្វើតេស្ដមីស៊ីល លើក ចុងក្រោយ បំផុត ធ្វើឡើង កាលពី ថ្ងៃទី ២៧ ខែកុម្ភៈ កន្លងទៅ នេះ ជា ពេល ដែល ទីក្រុង ព្យុងយ៉ាង អះអាង ថា ខ្លួន បាន បាញ់ សាកល្បង ផ្កាយ រណប ស៊ើបការណ៍ ។
ក្រុម អ្នកជំនាញ ជាច្រើន ក៏ ធ្លាប់ បាន ព្រមាន ដែរ ថា កូរ៉េ ខាងជើង អាចនឹង ប្រើប្រាស់ ឱកាស នៃ ការរៀបចំ ការបោះឆ្នោត ប្រធានាធិបតី កូរ៉េ ខាងត្បូង ដែល គ្រោង នឹង ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី ០៩ ខែមីនា នេះ រួមទាំង ថ្ងៃ បុណ្យ ជាតិ របស់ ខ្លួន គឺ ថ្ងៃទី ១៥ ខែមេសា ខាងមុខ ដើម្បី បាញ់ សាកល្បង មីស៊ីល ឬ អាវុធ ដទៃ ទៀត ៕
អភិបាល ខេត្ត កំពង់ធំ ណែនាំ ឲ្យ អាជ្ញាធរ មូលដ្ឋាន ធ្វើ បច្ចុប្បន្នភាព នៃ ការដោះស្រាយ ទំនាស់ ជូន ពលរដ្ឋ សម្ដៅ ពន្លឿន ការ ដោះស្រាយ បញ្ហា ដែល នៅ សេសសល់
( កំពង់ធំ )៖ លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ០៤ ខែមីនា ឆ្នាំ ២០២២ នេះ បាន ណែនាំ ដល់ អាជ្ញាធរ មូលដ្ឋាន និង សមត្ថកិច្ច ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ធ្វើ បច្ចុប្បន្នភាព នៃ ការដោះស្រាយ ទំនាស់ ជូន ប្រជាពលរដ្ឋ ដើម្បី កំណត់ ច្បាស់ អំពី ប្រភេទ នៃ ទំនាស់ សម្ដៅ ពន្លឿន ការ ដោះស្រាយ បញ្ហា ដែល នៅ សេសសល់ ។
ក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព ខេត្ត កំពង់ធំ លោក ងួន រតនៈ បាន ណែនាំ ទៀត ថា អាជ្ញាធរ ក្រុង ស្រុក ទាំងអស់ ត្រូវ ធ្វើ ផែនការ ឲ្យបាន ច្បាស់លាស់ ក្នុង ការដោះស្រាយ បញ្ហា ជូន ប្រជាពលរដ្ឋ ហើយ លោក និង ពិនិត្យ តាមដាន ជា បន្ដ បន្ទាប់ នៅពេល មាន កិច្ចប្រជុំ លើក ក្រោយ ដើម្បី ដឹង ច្បាស់ ថា តើ ការដោះស្រាយ បញ្ហា នៅ មូលដ្ឋាន បាន កម្រិត ណា ហើយ ពលរដ្ឋ ទទួលយក បាន ដែរ ឬ ទេ ។
ព្រម ពេល ជាមួយគ្នា នេះ លោក ងួន រតនៈ ក៏ បាន ជំរុញ ឲ្យ មន្ដ្រី នគរបាល ចរាចរណ៍ ត្រូវ បន្ដ រឹត បណ្តឹង ដល់ អ្នកបើកបរ ដែល មិន ពាក់ មួក សុវត្ថិភាព និង មិន គោរព ច្បាប់ ចរាចរណ៍ ផងដែរ ។ បន្ថែម ពី នេះ កងកម្លាំង ទាំងអស់ ត្រូវ ពិនិត្យមើល មុខ សញ្ញា និង តាមដាន ឲ្យបាន ច្បាស់លាស់ ដើម្បី ចាត់ វិធានការ ទៅ តាម ផ្លូវ ច្បាប់ ៕
ក្រសួង មហាផ្ទៃ បើក កិច្ចប្រជុំ បង្កើត ក្រុមការងារ ចុះ ត្រួតពិនិត្យ និង វាយតម្លៃ ច្រក របៀង ក្នុង ភូមិសាស្ត្រ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ
( បន្ទាយមានជ័យ )៖ ក្រសួង មហាផ្ទៃ និង រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ បាន បើក កិច្ចប្រជុំ បង្កើត ក្រុមការងារ ចុះ ត្រួតពិនិត្យ និង វាយតម្លៃ ច្រក របៀង ក្នុង ភូមិសាស្ត្រ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។ ពិធី នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ០៤ ខែមីនា ឆ្នាំ ២០២២ ដឹកនាំ ដោយ លោក សន្ដិ បណ្ឌិត សុខ ផល រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង លោក អ៊ុ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ ។
គោលបំណង នៃ កិច្ចប្រជុំ នេះ គឺ ចុះ សិក្សា ស្រាវជ្រាវ ដើម្បី បិទ ការចេញ - ចូល តាម ច្រក របៀង នានា ក្រៅពី ច្រក អន្តរជាតិ ប៉ោយប៉ែត . ចុះ ពិនិត្យ សិក្សា ស្រាវជ្រាវ ទីតាំង ភូមិសាស្ត្រ និង ស្ថានភាព ច្រក របៀង ដែល ស្ថិត នៅក្នុង ភូមិសាស្រ្ត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ដើម្បី ពង្រឹង ការចេញ - ចូល ឆ្លងកាត់ ព្រំដែន តាម ច្រក ទ្វារ ផ្លូវការ. សិក្សា ស្រាវជ្រាវ វាយតម្លៃ សក្កានុពល ។
បន្ថែម ពី នេះ ក៏ នឹង កំណត់ អាទិភាព ច្រក របៀង ក្នុង ភូមិសាស្ត្រ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ដើម្បី លើក យោប ជូន ថ្នាក់ដឹកនាំ ពិនិត្យ និង សម្រេច ក្នុង ការបង្កើត ជា ច្រក ព្រំដែន ផ្លូវការស្រប តាម ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ជាធរមាន . រៀបចំ របាយការណ៍ អំពី លទ្ធផល សម្រេចបាន វឌ្ឍនភាព ការងារ និង បញ្ហា ប្រឈម ជូន សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ . បំពេញ ភារកិច្ច ផ្សេង ៗ ទៀត តាម ការចាំបាច់ ។
សូម បញ្ជាក់ ថា ក្រោយពី ជំនួប ប្រជុំ ពិភាក្សា នេះ បាន បញ្ចប់ ក្រុមការងារ នៃ កិច្ចប្រជុំ ក៏ បាន អញ្ជើញ ចុះ ត្រួតពិនិត្យ ជាក់ស្ដែង តាម ច្រក របៀង នីមួយ ៗ នៅ បន្ទាត់ ព្រំដែន ក្នុង ភូមិសាស្រ្ត ក្រុង ប៉ោយប៉ែត ដើម្បី ពិនិត្យ វាយតម្លៃ និង ធ្វើ របាយការណ៍ ជូន ថ្នាក់ដឹកនាំ ផងដែរ ៕ កងរាជអាវុធហត្ថ ខណ្ឌ ព្រែក ព្នៅ ទទួល អំណោយ ម៉ូតូ២ គ្រឿង ពី អគ្គ នាយក ក្រុមហ៊ុន ទូ ពេជ្រ អុិន វេស មុិន ឯ . ក
ការប្រគល់ អំណោយ ជា ម៉ូតូ ជូន ដល់ កងរាជអាវុធហត្ថ ខណ្ឌ ព្រែក ព្នៅ នៅ ពេល នេះ ដើម្បី បំពេញ ភារកិច្ចការ រក្សា សុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ ជូន ប្រជាជន ឱ្យ បាន ល្អ ក្នុង មូលដ្ឋាន ជាពិសេស ក្នុង ឱកាស បុណ្យ ចូល ថ្មី ប្រពៃណី ខ្មែរ ដែល ជិត ឈានចូល មកដល់ នា ពេល ខាងមុខ នេះ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក វរសេនីយ ឯក ភួង សុភី បាន ថ្លៃអំណរគុណ ដល់ លោក អគ្គ នាយក ក្រុមហ៊ុន ទូ ពេជ្រ អុិន វេស មុិន ឯ . ក ដែល ជានិច្ចកាល ដែល តែងតែ យកចិត្តទុកដាក់ ពី សុខ ទុក្ខ កងកម្លាំង កងរាជអាវុធហត្ថ ។
មេបញ្ជាការ កងរាជអាវុធហត្ថ ខណ្ឌ ព្រែក ព្នៅ បាន បញ្ជាក់ ថា ការឧបត្ថម្ភ ម៉ូតូ នៅ ពេល នេះ អាច ជួយ សម្រួល ដល់ ការប្រចាំ ការល្បាត ការពារ ប្រជាពលរដ្ឋ ក្នុង ភូមិសាស្រ្ត ឱ្យ រឹតតែ មាន ប្រសិទ្ធភាព ខ្ពស់ បន្ថែម ទៀត ។
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ៥២ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ១៨. ៤៦២ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
ចាស់ជរា គ្មាន ទីពឹង ក្នុង ខេត្ត ប៉ៃលិន ទទួល ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែ ពី មូលនិធិ ចាស់ជរា របស់ នាយ ឧត្តមសេនីយ៍ អ៊ី ឈាន និង លោកស្រី បាន ស្រី មុំ
( ប៉ៃលិន ) ៖ លោក សៅ សារ៉ាត់ អ្នកតំណាងរាស្ត្រ មណ្ឌល ប៉ៃលិន អម ដំណើរ ដោយ ក្រុមការងារ នា ព្រឹក ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២២ បាន ជួប សំណេះសំណាល សួរសុខទុក្ខ ជាមួយ លោកយាយ លោក តាចាស់ជរា គ្មាន ទីពឹង និង មាន ជីវភាព ខ្វះខាត ទូទាំង ខេត្ត ប៉ៃលិន ដែល មក ទទួល ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែមីនា ពី ក្រុមការងារ របស់ មូលនិធិ ។
នា ឱកាស នោះ លោក បាន ផ្តាំផ្ញើ ការសួរសុខទុក្ខ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ អ៊ី ឈាន ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ប៉ៃលិន និង លោកស្រី បាន ស្រី មុំ ប្រធាន មូលនិធិ ចាស់ជរា ខេត្ត ប៉ៃលិន ជូន ដល់ លោកយាយ លោក តាចាស់ជរា ទាំងអស់ ដោយ ជានិច្ចកាល នាយ ឧត្តមសេនីយ៍ និង លោកស្រី តែងតែ គិតគូ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ គ្រប់ រូប គ្រប់ កាលៈទេសៈ និង គ្រប់ ទីកន្លែង នៅ ទូទាំង ខេត្ត ប៉ៃលិន ។
លោក ក៏ បាន អំពាវនាវ ដល់ ដល់ លោកយាយ លោក តា ក៏ ដូចជា ប្រជាពលរដ្ឋ ទាំងអស់ សូម ចូលរួម ប្រយុទ្ធ ប្រឆាំង បង្ការ ទប់ស្កាត់ ការពារ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ដោយ ត្រូវ អនុវត្តន៍ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង ចូលរួម គោរព អនុវត្តន៍ នូវ វិធាន ចាំបាច់ នានា របស់ រាជ រដ្ឋាភិបាល ។
សូម បញ្ជាក់ ថា ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ របស់ លោកយាយ លោក តា ក្រុមការងារ មូលនិធិ ត្រូវបាន បែងចែក ជា ៣ក្រុម គឺ ក្រុម ទី១ បើក ផ្តល់ ជូន លោកយាយ លោក តា នៅ ការិយាល័យ តំណាងរាស្ត្រ មណ្ឌល ប៉ៃលិន ក្រុម ទី២ នៅ សាលា ឃុំ អូរ អណ្តូង និង ក្រុម ទី៣ នៅ សាលា ឃុំ ស្ទឹងត្រង់ ដោយ មូលនិធិ បាន បើក ផ្តល់ ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែ ដល់ លោកយាយ លោក តា ចាស់ជរា ចំនួន ៦១ នាក់ ដោយ ក្នុង ម្នាក់ ៗ ទទួលបាន ថវិកា ចំនួន ១០ម៉ឺន រៀល ផងដែរ ៕
ថ្ងៃ ដំបូង៖ គ.ជ. ប ទទួល ពាក្យ សុំ ចុះបញ្ជី បេក្ខជន គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត បាន ១៦ គណបក្ស មាន បេក្ខជន ៥១. ៩៥០ រូប
( ភ្នំពេញ ) ៖ លទ្ធផល បណ្តោះអាស្ន សម្រាប់ ថ្ងៃទី មួយ នៃ ការចុះបញ្ជី បេក្ខជន នៃ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ត្រូវនឹង ថ្ងៃទី ៤ ខែមីនា ឆ្នាំ ២០២២ គិត ត្រឹម វេលា ម៉ោង ៥៖៣០ នាទី បាន ចំនួន ១៦ គណបក្ស នយោបាយ ដែល មាន បេក្ខជន សរុប ចំនួន ៥១. ៩៥០ រូប ក្នុង នោះ ស្រី សរុប ចំនួន ១៤.២២៩ រូប ។
ទី១៖ គណបក្ស ប្រជាជន កម្ពុជា ទី២៖ គណបក្ស ភ្លើង ទៀន ទី៣៖ គណបក្ស ខ្មែរ រួបរួម ជាតិ ទី៤៖ គណបក្ស ហ៊្វុនស៊ិនប៉ិច ទី ៥៖ គណបក្ស ខ្មែរ ស្រឡាញ់ ជាតិ ទី៦៖ គណបក្ស សញ្ជាតិ កម្ពុជា ទី៧៖ គណបក្ស យុវជន កម្ពុជា ទី៨៖ គណបក្ស ឆន្ទៈ ខ្មែរ ទី៩៖ គណបក្ស កម្ពុជា និយម ទី១០៖ គណបក្ស ប្រជាធិបតេយ្យ មូលដ្ឋាន ទី១១៖ គណបក្ស សំបុក ឃ្មុំ សង្គម ប្រជាធិបតេយ្យ ទី១២៖ គណបក្ស កែទម្រង់ កម្ពុជា ទី១៣៖ គណបក្ស ខ្មែរ តែ មួយ ទី១៤៖ គណបក្ស ជនជាតិ ដើម ប្រជាធិបតេយ្យ កម្ពុជា ទី១៥៖ គណបក្ស រស្មី ខេមរា ទី១៦៖ គណបក្ស ខ្មែរ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច
ការចុះបញ្ជី បេក្ខជន នៃ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ មាន រយៈពេល ៣ ថ្ងៃ គឺ ចាប់ពី ថ្ងៃទី៤ ដល់ ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២២ ៕
អភិបាល ខេត្ត កំពង់ធំ ដាក់កំហិត ដល់ សមត្ថកិច្ច ត្រូវ រឹត បណ្តឹង ដល់ អ្នកបើកបរ ដែល មិន ពាក់ មួក សុវត្ថិភាព
( កំពង់ធំ )៖ លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ បាន ជំរុញ ឱ្យ សមត្ថកិច្ច ត្រូវ រឹតបន្តឹង នឹង ដាក់កំហិត ឱ្យ បាន ម៉ឺងម៉ាត់ បំផុត ចំពោះ អ្នកបើកបរ ទាំងឡាយ ណា ដែល មិន ពាក់ មួក សុវត្ថិភាព និង មិន គោរព ច្បាប់ ចរាចរណ៍ ។ ការដាក់កំហិត បែប នេះ របស់ លោក ងួន រតនៈ បាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ គណៈ គណៈ បញ្ជាការ ឯកភាព ខេត្ត នៅ ថ្ងៃទី ៤ ខែមីនា ឆ្នាំ ២០២២ នា សាល ប្រជុំ សាលា ខេត្ត កំពង់ធំ ។
លោក បាន បន្ត ទៀត ថា អាជ្ញាធរ ទាំងអស់ ត្រូវ ពង្រឹង ឡើងវិញ ចំពោះ ការងារ ស្នូល របស់ ខ្លួន ជាពិសេស ការបង្ក្រាប ឱ្យ ខាន តែ បាន ទៅ លើ ការនេសាទ ខុស ច្បាប់ នៅ តាម មូលដ្ឋាន របស់ ខ្លួន ព្រោះ បច្ចុប្បន្ន នេះ រូបភាព លោក ផ្ទាល់ ត្រូវបាន គេ យក ទៅ ផ្សព្វផ្សាយ ក្នុង សារព័ត៌មាន រួចហើយ ដែរ ។
លោក ក៏ បាន សំណូមពរ ដល់ កងកម្លាំង ទាំងអស់ ត្រូវ ពិនិត្យមើល មុខ សញ្ញា និង តាមដាន ឱ្យ បាន ច្បាស់លាស់ ដើម្បី ចាត់ វិធានការ ទៅ តាម ផ្លូវ ច្បាប់ ។
បន្ថែម ពី នេះ លោក បាន បន្ត ថា អាជ្ញាធរ ក្រុង ស្រុក ទាំងអស់ ត្រូវ ធ្វើ បច្ចុប្បន្នភាព នៃ ការដោះស្រាយ ទំនាស់ ជូន ប្រជាពលរដ្ឋ នៅ តាម ថ្នាក់ មូលដ្ឋាន ឱ្យ បាន ទាន់ ពេលវេលា ហើយ ត្រូវ កំណត់ នៅ បញ្ហា ទំនាស់ ទាំងនោះ តើ វា ជា ប្រភេទ បញ្ហា អ្វី ខ្លះ ? ហើយ ដោះស្រាយ បាន ប៉ុន្មាន ករណី ? និង ត្រូវ មាន ផែនការ ដោះស្រាយ នៅពេល បន្ទាប់ ទៀត ហើយ ។
លោក ក៏ បាន សំណូមពរ ដល់ អាជ្ញាធរ ក្រុង ស្រុក ខណ្ឌ នៅ តាម មូលដ្ឋាន ត្រូវ បង្ក លក្ខណៈ ងាយស្រួល ដល់ គណបក្ស នយោបាយ ក្នុង ការធ្វើ កិច្ចការ របស់ ខ្លួន ដើម្បី ត្រៀម ក្នុង ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់ នា ពេល ខាងមុខ ។
លើស ពី នេះ ទៅ ទៀត អភិបាល ខេត្ត ក៏ បាន ក្រើន រំលឹក ដល់ អាជ្ញាធរ គ្រប់ ជាន់ ថ្នាក់ ត្រូវ យកចិត្តទុកដាក់ ឱ្យ បាន ខ្ពស់ បំផុត ក្នុង ការដោះស្រាយ បញ្ហា ធំ របស់ ប្រជាពលរដ្ឋ ជាពិសេស បញ្ហា ដែល នៅ សេសសល់ កន្លងមក ត្រូវតែ ចូលរួម ពិភាក្សា ដោះស្រាយ ឱ្យ បាន ទាន់ ពេលវេលា ដើម្បី ជា ការផ្ដល់ ទំនុកចិត្ត ជូន ដល់ ប្រជាពលរដ្ឋ ផងដែរ ។
ដ្រូន កសិកម្ម បាញ់ ថ្នាំ បាច ជី ការពារ សត្វ ល្អិត បាន នាំ ដល់ ទឹកដី ខេត្ត កំពង់ស្ពឺ កាត់បន្ថយ កម្លាំង ពលកម្ម មនុស្ស
( កំពង់ស្ពឺ ) ៖ ការសាកល្បង លើ ផ្ទៃដី ចំការប្រមាណ ជា ១៣៥ ហិកតា ដែល ពោរពេញ ទៅ ដោយ ដំណាំ ស្វាយ កែវ ល្មៀត និង ដំណាំ ក្រូចឆ្មារ របស់ លោក ហ៊ាន វណ្ណា រិន អាយុ ៣៩ ឆ្នាំ ជា កសិករ ស្ថិត នៅក្នុង កំប៉េះ ឃុំ តាសាល ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ធ្វើឡើង បាន យ៉ាង គាប់ ប្រសើរ ដោយ ស្រោច ជី ការពារ ផ្កា និង ផ្លែ តាមរយៈ ការប្រើប្រាស់ ដ្រូន កសិកម្ម ។
លោក ហ៊ាន វណ្ណា រិន បាន លើកឡើង ថា ជាធម្មតា កន្លងមក លោក ត្រូវ ចំណាយ កម្មករ យ៉ាងតិច ចំនួន ៥០ នាក់ ដើម្បី ថែទាំ ដំណាំ ក្នុង ចំការ នេះ ប៉ុន្តែ នៅ ពេល បច្ចុប្បន្ន នៅ ពេល ដែល វិស័យ ឧស្សាហកម្ម មាន ការរីកចម្រើន ខ្លាំង ប្រជាពលរដ្ឋ បាន ងាក ទៅ ធ្វើជា កម្មករ - កម្ម ការិនី រោងចក្រ វិញ ដោយ ធ្វើឲ្យ វិស័យ កសិកម្ម ត្រូវ ជួប វិបត្តិ ព្រោះតែ ខ្វះ កម្លាំង ពលកម្ម ហើយ នៅពេល មាន ដ្រូន កសិកម្ម នេះ នៅក្នុង ទឹកដី ខេត្ត កំពង់ស្ពឺ អាច កាត់បន្ថយ ការប្រើ មនុស្ស បាន ច្រើន ។
លោក តូច ញ៉ាវ ប្រធាន ការិយាល័យ គ្រឿង យន្ត នៃ មន្ទីរ កសិកម្ម ខេត្ត កំពង់ស្ពឺ បាន ឲ្យដឹង ថា បច្ចុប្បន្ន ផ្ទៃដី មួយ ភាគ ធំ នៃ ខេត្ត កំពង់ស្ពឺ ត្រូវបាន ដាំដុះ ដំណាំ កសិកម្ម និង មួយ ភាគ ទៀត ជា រោងចក្រ សហគ្រាស ហើយ កន្លងមក កសិករ ជា ម្ចាស់ ចំការ តែង ធ្វើ ការដាំដុះ និង ថែទាំ ទៅ តាម ប្រពៃណី ដោយ ប្រើ កម្លាំង មនុស្ស ជា មធ្យោបាយ ប៉ុន្តែ ស្រប ពេល ដែល បច្ចេកវិទ្យា កាន់តែ ទំនើប កសិករ នៅ តាម ប្រទេស ជឿនលឿន គេ បាន ប្រើប្រាស់ គ្រឿងយន្ត ជំនួស កម្លាំង មនុស្ស វិញ ។
លោក បញ្ជាក់ ថា នេះ ជា លើក ទី មួយ ហើយ ដែល កសិករ នៅក្នុង ស្រុក ឱរ៉ាល់ បាន ប្រើប្រាស់ នូវ គ្រឿងយន្ត ដ្រូន កសិកម្ម ជំនួស ឲ្យ កម្លាំង មនុស្ស ក្នុង ការបាញ់ ថ្នាំ សម្លាប់ សត្វ ល្អិត និង ថែទាំ លើ ស្លឹក ផ្កា និង បាញ់ ថ្នាំ បំប៉ន ផ្សេង ៗ ទៀត ។
លោក ប្រធាន ក្រុមហ៊ុន លើកឡើង បន្ថែម ថា ចង់ឲ្យ ប្រជាកសិករ ទាំងអស់ ងាក មក ប្រើប្រាស់ បច្ចេកវិទ្យា ទំនើប ជំនួស កម្លាំង មនុស្ស វិញ ធ្វើឲ្យ ដូច ប្រទេស ជឿនលឿន មួយចំនួន ដែល ប្រកប វិស័យ ការងារ កសិកម្ម ដូចគ្នា ដោយ ដ្រូន កសិកម្ម ពិតជា បាន ជំនួស ឲ្យ កម្លាំង មនុស្ស បាន ច្រើន លើ ការងារ បាញ់ សម្លាប់ សត្វ ល្អិត ដែល ផ្តល់ មកវិញ នូវ ការ ចំណេញ ពេលវេលា ថវិកា កម្លាំង ពលកម្ម ជាពិសេស មិន ប៉ះ ដល់ សុខភាព ។
ដ្រូន កសិកម្ម អាច ធ្វើការ ក្នុង មួយ ម៉ោង បាន រហូតដល់ទៅ ១៦ ហិកតា ដោយ មាន អ្នក ចាត់ចែង ត្រឹមតែ ២នាក់ ប៉ុណ្ណោះ ខុសពី ការបាញ់ តាម បែប ប្រពៃណី ដែល ត្រូវ ឲ្យ មនុស្ស ច្រើន នាក់ ពាក់ ធុង ដើរ បាញ់ នៅ តាម ដើម ដំណាំ ប្រឈម និង ការប៉ះពាល់ ផ្ទាល់ ជាមួយ ថ្នាំ គីមី ។ ការចំណាយ កម្លាំង ពលកម្ម តិច គឺ អាច ផ្តល់ ឱកាស ឱ្យ បងប្អូន អាច ទៅ ប្រកប កិច្ចការងារ ផ្សេង ៗ ទៀត បាន ៕
អតីត សមាជិក អតីត បក្ស សង្គ្រោះ ជាតិ ជាង ៨០០ នាក់ នៅ ឃុំ កោងកាង ស្រុក ពញា ក្រែក ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា
( ត្បូងឃ្មុំ ) ៖ នៅ ព្រឹក ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២២ មាន សមាជិក ថ្មី មកពី អតីត គណបក្ស សង្គ្រោះ ជាតិ ចំនួន ៨២៧ នាក់ បាន រួមរស់ ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ឃុំ កោងកាង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ ក្រោម អធិបតីភាព លោក វង សូត ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ និង ឃុំ ជា ច ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង ។
ក្នុង ឱកាស នោះ លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា មកពី គណបក្ស ប្រជាជន កម្ពុជា បាន ថ្លែង ទៅកាន់ សមាជិក ថ្មី ថា « យើង កុំ ភ្លេច គុណ គណបក្ស ប្រជាជន កម្ពុជា ព្រោះ ជា គណបក្ស មួយ ដែល បាន ជួយ យើង ក្នុង គ្រា លំបាក ដោយ មិន ទុកឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ ចោល ពោលគឺ នៅ ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេសៈ ទាំងអស់ ជា គ្រួសារ តែ មួយ » ។
លោក បាន លើកទឹកចិត្ត ដល់ សមាជិក ទាំងអស់ ត្រូវ បន្ត ផ្សព្វផ្សាយ ពី សមិទ្ធផល និង ស្នាដៃ របស់ រាជ រដ្ឋាភិបាល បច្ច ប្បន្ន ដែល ជា ស្នាដៃ គណបក្ស ប្រជាជន កម្ពុជា ចាប់តាំងពី បាត ទទេ មក ។ គណបក្ស ប្រជាជន កម្ពុជា គឺជា ការផ្តល់ សុខ សន្តិភាព សិទ្ធិ សេរីភាព ពេញលេញ និង តែងតែ គិតគូរ ពី សុខ មាភាព របស់ ពលរដ្ឋ ជានិច្ច ។
លោក វង សូត បាន ជំរុញ ឲ្យ មន្ត្រី គណបក្ស នៅ តាម មូលដ្ឋាន ត្រូវ ខិតខំ ប្រឹងប្រែង បម្រើ សេវា សាធារណៈ ជូន ពលរដ្ឋ ឲ្យ ល្អ ប្រសើរ ដោយ មិន មាន ការប្រកាន់ បក្សពួក ឬ និន្នាការ ណាមួយ ឡើយ ។
មន្ត្រី បក្ស ត្រូវ បន្ត កសាង សមាជិក ថ្មី ៗ បន្ថែម ទៀត ក្រោម រូបភាពស្មោះស្ម័គ្រចិត្ត មិន មាន ការបង្ខិតបង្ខំ និង បន្ត គាំទ្រ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា បន្ត ទៀត ដើម្បីឲ្យ បេក្ខភាព សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី កម្ពុជា បន្ត ដឹកនាំ ប្រទេសជាតិ ៕
កម្ពុជា រំពឹង ផ្សព្វផ្សាយ ពី ទេសចរណ៍ ជាតិ និង ទេសចរណ៍ អាស៊ាន ឱ្យ កាន់តែ ទូលំទូលាយ ក្នុង វេទិកា សេដ្ឋកិច្ច ពិភពលោក នៅ ប្រទេស ស្វីស
( ភ្នំពេញ ) ៖ នៅក្នុង វេទិកា សេដ្ឋកិច្ច ពិភពលោក (WEF) នា ពេល ខាងមុខ កម្ពុជា មាន ការរំពឹងទុក ចំពោះ ការផ្សព្វផ្សាយ ឱ្យ កាន់តែ ទូលំទូលាយ អំពី ការបើក ទេសចរណ៍ ក្នុង ប្រទេស និង ទេសចរណ៍ អាស៊ាន ឡើងវិញ ក៏ ដូចជា ផ្សព្វផ្សាយ អំពី គោលដៅ ទេសចរណ៍ សុវត្ថិភាព ក្នុង ប្រទេស ខណៈ រាជ រដ្ឋាភិបាល បាន អនុវត្ត យុទ្ធសាស្ត្រ ទេសចរណ៍ ចាក់ វ៉ាក់សាំង យ៉ាង មាន ប្រសិទ្ធភាព ។
ក្នុង នាម តំណាង វេទិកា សេដ្ឋកិច្ច ពិភពលោក លោក លី បាន អញ្ជើញ ថ្នាក់ដឹកនាំ ក្រសួង ទេសចរណ៍ ចូលរួម ក្នុង វេទិកា សេដ្ឋកិច្ច ពិភពលោក នា ពេល ខាងមុខ នេះ ដើម្បី បង្ហាញ ពី គោលដៅ ទេសចរណ៍ កម្ពុជា ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង វិបត្តិ កូវីដ - ១៩ ក៏ ដូចជា យុទ្ធសាស្ត្រ នៃ ការបើក ទេសចរណ៍ ក្នុង ប្រទេស របស់ ខ្លួន ឡើងវិញ ។ តំណាង វេទិកា សេដ្ឋកិច្ច ពិភពលោក ក៏ បាន សន្យា ដែរ ថា នឹង ជួយ ផ្សព្វផ្សាយ ពី វិស័យ ទេសចរណ៍ កម្ពុជា ក្នុង ពេល រៀបចំ ព្រឹត្តិការណ៍ វេទិកា សេដ្ឋកិច្ច ពិភពលោក នោះ ។
នា ជំនួប នោះ ដែរ លោក ប៉ាក់ សុខុម បាន លើកឡើង ពី យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការចាក់ វ៉ាក់សាំង ជូន ប្រជាជន ដែល ជា គន្លឹះ ដ៏ សំខាន់ ក្នុង ការបើក សកម្មភាព សេដ្ឋកិច្ច និង បើក ទទួល ទេសចរ អន្តរជាតិ ឡើងវិញ ។ លោក បាន ជម្រាប ដល់ តំណាង វេទិកា សេដ្ឋកិច្ច ពិភពលោក ថា « កម្ពុជា សព្វ ថ្ងៃ ត្រូវបាន វាយតម្លៃ ថា ជា គោលដៅ ទេសចរណ៍ សុវត្ថិភាព » ។
លោក រដ្ឋលេខាធិការ ក៏ បាន បង្ហាញ អំពី ចក្ខុវិស័យ ក៏ ដូចជា ការរៀបចំ ការស្ដារ និង លើកស្ទួយ វិស័យ ទេសចរណ៍ ឡើងវិញ តាមរយៈ ការអនុវត្ត ដោយ យកចិត្តទុកដាក់ លើ ផែនទី ចង្អុល ទិស ស្ដីពី ការស្ដារ និង លើកស្ទួយ វិស័យ ទេសចរណ៍ កម្ពុជា ក្នុង និង ក្រោយ វិបត្តិ កូវីដ - ១៩ ក៏ ដូចជា ស្រប ទៅតាម យុទ្ធសាស្ត្រ ទេសចរណ៍ ចាក់ វ៉ាក់សាំង ដែល រាជ រដ្ឋាភិបាល បាន អនុម័ត រួចហើយ នោះ ។
លោក លី ជូ អុក បាន ប្ដេជ្ញា ថា នឹង ខិតខំ យក ស្មារតី នៃ ការបើក ទេសចរណ៍ អាស៊ាន ក៏ ដូចជា ភាពរីកចម្រើន នៃ បើក ទេសចរណ៍ អាស៊ាន ឡើងវិញ នេះ ទៅ ផ្សព្វផ្សាយ បង្ហាញ នៅក្នុង វេទិកា សេដ្ឋកិច្ច ពិភពលោក ។
តាមរយៈ ការគាំទ្រ ពីសំណាក់ វេទិកា សេដ្ឋកិច្ច ពិភពលោក ខាងលើ នេះ អ្នកនាំពាក្យ ក្រសួង ទេសចរណ៍ លោក ទ្រី ឈីវ បាន បញ្ជាក់ ថា « កម្ពុជា នឹង អាច បង្ហាញ ទៅកាន់ ពិភពលោក បន្ថែម ទៀត អំពី ស្នាដៃ និង ភាពសកម្ម របស់ ខ្លួន ក្នុង ការដឹកនាំ ក្នុង នាម ជា ប្រធាន អាស៊ាន ឆ្នាំ ២០២២ ក៏ ដូចជា ប្រធាន ទេសចរណ៍ អាស៊ាន ២០២០ - ២០២១ ជាពិសេស គឺ នឹង បាន បង្ហាញ ទៅកាន់ ពិភពលោក អំពី ប្រសិទ្ធភាព គោលដៅ ទេសចរណ៍ សុវត្ថិភាព នៅ កម្ពុជា » ។
លោក ហ្សេ លេស្គី ធ្វើការកត់សម្គាល់ ខាងលើ នៅក្នុង សារ វីដេអូ នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ។ ប្រធានាធិបតី អ៊ុយក្រែន រូប នេះ បាន លើកឡើង ដូច្នេះ ថា « កិច្ចប្រជំកំពូល របស់ អង្គការ NATO នៅ ថ្ងៃ នេះ ( ថ្ងៃសុក្រ ) គឺជា កិច្ចប្រជុំ កំពូល ដ៏ ទន់ខ្សោយ និង ពោរពេញ ដោយ ភាពច្របូកច្របល់ ពោលគឺជា កិច្ចប្រជុំ កំពូល មួយ ដែល បង្ហាញ ថា គ្មាន នរណា ម្នាក់ ចាត់ទុក ថា ការប្រយុទ្ធ ដើម្បី សេរីភាព នៅក្នុង តំបន់ អឺរ៉ុប គឺជា គោលបំណង ទី១ » ។
លោក ហ្សេ លេស្គី ក៏ បាន ចោទប្រកាន់ ប្រទេស ជា សមាជិក NATO មួយចំនួន ផងដែរ ថា កំពុង បើក ភ្លើង បៃតង ឱ្យ រុស្ស៊ី ចាប់ផ្ដើម ទម្លាក់ គ្រាប់បែក លើ ទីក្រុង និង ភូមិ ជាច្រើន របស់ អ៊ុយក្រែន បន្ទាប់ពី បដិសេធ ការបង្កើត តំបន់ គ្មាន ការហោះហើរ ៕
មិន ត្រូវ បើកបរ លើស ល្បឿន កំណត់ ជាដាច់ខាត ! ស្លាប់ ៦នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៤ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៤ ខែមីនា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ ស្រាល ១០នាក់ ។
ក្រុមហ៊ុន រូបភាព ផ្កាយ រណប Maxar បង្ហោះ វីដេអូ នៃ ក្បួន រថយន្ត យោធា រុស្ស៊ី ប្រវែង ៦៤ គីឡូម៉ែត្រ
ស្ថានទូត បាន សរសេរ ថា « ការវាយប្រហារ លើ រោងចក្រ ថាមពល នុយក្លេអ៊ែរ គឺជា ឧក្រិដ្ឋកម្ម សង្រ្គាម ។ ការបាញ់ ផ្លោង របស់ ពូទីន ទៅ លើ រោងចក្រ ថាមពល នុយក្លេអ៊ែរ ដ៏ ធំ បំផុត របស់ អឺរ៉ុប ជា ការឈាន មួយ ជំហ៊ាន នៃ រជ្ជកាល ដ៏ ភ័យខ្លាច របស់ គាត់ ។
គួរ បញ្ជាក់ ថា បើ តាម អាជ្ញាធរ អ៊ុយក្រែន រោងចក្រ ថាមពល នុយក្លេអ៊ែរ ហ្សាប៉ូរីស ហ្ស៊ីយ៉ា (Zaporizhzhia) កំពុង ត្រូវបាន កាន់កាប់ ដោយ កងទ័ព រុស្ស៊ី ក្រោយ មាន ការប៉ះទង្គិច គ្នា ពេញ មួយ យប់ ម្សិលមិញ និង បណ្ដាលឱ្យ មាន អគិ្គភ័យ ឆាបឆេះ រោងចក្រ នេះ ។ រីឯ អគ្គិភ័យ ត្រូវបាន ពន្លត់ ហើយ ក្រុម បុគ្គលិក កំពុង បន្ត ធ្វើ ប្រតិបត្តិការ រ៉េអាក់ទ័រ និង ផ្គត់ផ្គង់ ថាមពល ស្រប ទៅតាម វិធានការ សុវត្ថិភាព ជា ប្រក្រតី ៕
តើ សហរដ្ឋ អាមេរិក និង សម្ពន្ធមិត្ត បញ្ជូន អាវុធ ឱ្យ អ៊ុយក្រែន ដោយ របៀប ណា ?
( ប៊ែរឡាំង ) ៖ សហភាព អឺរ៉ុប បាន ទម្លាក់ កញ្ចប់ ថវិកា ជាង ៥០៣ លាន ដុល្លារ ដើម្បី ផ្គត់ផ្គង់ អាវុធ ប្រយុទ្ធ ឱ្យ អ៊ុយក្រែន ក្នុង នោះ រួម មាន ទាំង ប្រព័ន្ធ ការពារ ដែន អាកាស . អាវុធ ប្រឆាំង រថក្រោះ និង សម្ភារ សង្រ្គាម ជាច្រើន ទៀត ហើយ មាន ផែនការ បន្ថែម ជាង ៥៥លាន ដុល្លារ ទៀត ក្នុង ការផ្ដល់ បរិក្ខា ដូចជា ឥន្ធនៈ ឬមួក ចម្បាំង ជាដើម ។
* បញ្ហា ដឹកជញ្ជូន
* តួនាទី របស់ ប៉ូឡូញ
