ការបរាជ័យ គឺ មាន ន័យ ថា ជិត ទទួលបាន ជោគជ័យ
អ្នកស្រី បាន និយាយ រៀបរាប់ ពី កូន ៗ
ដែល ក្រុម ចម្រៀង នេះ នឹង ធ្វើដំណើរ ឆ្លងកាត់ ទៅ លេង នៅ ទីនោះ ។
ភាពស្ងប់ស្ងាត់ នៃ ការចេញ បទចម្រៀង ធ្វើឱ្យ គ្រប់ គ្នា នៅតែ ទន្ទឹងរងចាំ បទ ថ្មី របស់ កំពូល តារា
ព្រះអង្គ ទ្រង់ ត្រាស់ ថា ម្នាល ភិក្ខុ ទាំងឡាយ តថាគត អនុញ្ញាតឱ្យ រុំ ជើង គ្រែ ជើង តាំង នោះ ដោយ កំណាត់ សំពត់ ។
តែ បែរជា កូនស្រី ពៅ ជា កូនណ សំណព្វ យក លុយ ទៅ ទិញ ផ្ទះ ធ្វើជា កម្មសិទ្ធិ ផ្ទាល់ខ្លួន និង សម្ភារនិយម ជាច្រើន ទៀត ដោយ មិន ឱ្យ ម្តាយ ដឹង ឡើយ ។
ពួកគេ ច្បាស់ជា ប៉ាន់ស្មាន ខុស ហើយ ថា តើ ទឹក មាន ចំនួន ច្រើន ប៉ុណ្ណា ៕
បុគ្គល ជោគជ័យ រំពឹង ថា សំណាង នឹង រក ពួកគេ ឃើញ ហើយ ជាធម្មតា សំណាង ពិតជា រក ពួកគេ ឃើញ មែន ។
លោក គឺជា ទាយាទ ទី៥ ដែល ទទួលវេន បន្ត ព្យាបាល ជំងឺ នេះ ។
ស្មាន ថា សប្បាយ កាយ ស្គម ចំបែង រស់ នៅ វង្វេង
ប្តី ស្រវឹង ខួប ឈ្មោះ សម្បត្តិ សុធី អាយុ ៣៧ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ។
ផ្ទុយទៅវិញ វា គឺជា ការបង្ក រោគ ឬ ប្រតិកម្ម អាឡែក ហ្ស៊ី អី វិញ ទេ ។
និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០០៩ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា បច្ចុប្បន្ន មាន សាស្ត្រាចារ្យ បរទេស ចំនួន ៧ពាន់ នាក់ នៅក្នុង ប្រទេស ថៃ ។
នោះ ឡើយ ប៉ុន្តែ វា ត្រូវ មាន ការបញ្ចេញ ដំណោះស្រាយ ថ្មី ឆ្លើយតប នឹង ការប្រឈមមុខ នឹង អ្វី ដែល ថ្មី ៗ
យប់ មិញ ខ្ញុំ អធិដ្ឋាន ម្នាក់ឯង … ខ្ញុំ អធិដ្ឋាន សុំ ឱ្យ បាន តុក្កតា សម្រាប់ អូន កាផង !
សំណង់ និង ហេដ្ឋារចនាសម្ព័ន្ធ ខ្នាត អន្តរជាតិ នឹង ប្រព្រឹត្តិ នៅ ខែកញ្ញា នេះ
កំហុស របស់ ពួក សាវក ឧ។
ប្តី កំណាច សម្លាប់ ប្រពន្ធ របស់ ខ្លួន រត់គេចខ្លួន បាន ២ ថ្ងៃ ត្រូវ ប៉ូលិស ស្រាវជ្រាវ ឃាត់ខ្លួន បាន ហើយ ។
អ្នកណា រងគ្រោះ ជាង អ្នកណា ?
ចំណែក ស្នងការ ខេត្ត កំពត លោក ថ្លាង ភីរិន្ទ មិន ធ្វើ អត្ថាធិប្បាយ ចំពោះ រឿង នេះ ទេ នៅ ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០១៣ ។
សិទ្ធិ ស្ត្រី - សិទ្ធិ កុមារ
ថ្លែង ក្នុង ខែកុម្ភៈ ឆ្នាំ ២០១៥ គាត់ បាន និយាយ ថា ត្រចៀក ខ្ញុំ ឡើង ក្រហម នៅពេល ចេញ ពី ធ្វើ ការម្តង ៗ
ទិដ្ឋភាព ទាំងនោះ ត្រូវ ជ្រើសរើស ឱ្យ ស្រប នឹង វ័យ ប្រយោជន៍ របស់ សិស្ស ស្រប តម្រូវការសង្គម ។
ដែល បើកចំហ វាំងនន ទាំងស្រុង នោះ តែម្តង ។
ដ្បិត ព្រះអង្គ ជា ព្រះដ៏ សុចរិត ។
រំលឹក រឿង ដី កោះ ពេជ្រ ឃាត
ធ្វើឱ្យ ការបើក វា ម្តង ៗ
វា នឹង យឺត បន្តិច ដោយ ផ្ទុយ ស្រឡះ ពី មិត្តភក្តិ ប៉ុន្តែ បន្ទាប់មក ចាប់ ពួកគេ យ៉ាង ឆាប់រហ័ស ។
និក ជន អង់គ្លេស ដូច្នេះ នៅក្នុង បរិបទ នេះ ពួកយើង បាន សម្រេចចិត្ត ថា មិន អនុញ្ញាតឱ្យ ពួកគេ បន្ត
ប្រសិនបើ គ្រូពេទ្យ យល់ព្រម វះកាត់ គាត់ នឹង ជួយ ធ្វើ ទិដ្ឋាការ លិខិត ឆ្លង ដែន និង សំបុត្រ យន្តហោះ ជូន វីដជា មិន ខាន ៕
អាយុ ២០ ឆ្នាំ ឡើង ទៅ
មនុស្ស គ្រប់ រូប សុទ្ធតែ ចង់ រក បាន លុយ ច្រើន ដូចនេះ គេ ក៏ សំរេចចិត្ត ចូលរួម បង្កើត មុខរបរ ជាមួយ អ្នកដទៃ ។
និង ពីរ បន្ទប់ ឯកជន ។
ពលរដ្ឋ តំបន់ អារ៉ែង បារម្ភ ពី ការបាត់ ចំណូល នៅ ថ្ងៃ ចូល ឆ្នាំ ព្រោះ គ្មាន ទេសចរ ទាក់ទង ទៅ ពួកគាត់
នេះ គឺ បុរស ១០ប្រភេទ ដែល ស្ត្រី ទាំងឡាយ គប្បី គួរ ចៀសវាង ។
ប្រសិនបើ យើង មិន មាន សាច់ញាតិ និង មិត្តភ័ក្តិ ចូលរួម ទេ វា មិន សម នឹង ការប្រារព្ធ ពិធី ដ៏ អស្ចារ្យ នោះ ទេ ។
ប្រើ សម្រាប់ ដាក់ បន្ទាត់ នៅ ពីក្រោម ពាក្យ នីមួយ ៗ
អ្នកស្រី បាន និយាយ ថា ការឃុំ ខ្លួន លោក ឈួ ផេង គឺជា រឿង អយុត្តិធម៌ ។
មេហ្គារន្ធ វីដេអូ ជាច្រើន ទៀត !
យើង ទាំងអស់ គ្នា មិន ចូលចិត្ត ទេ ។
សំភារៈ ៣យ៉ាង មិន មែន ត្បាញ ប្រឆាំង នឹង បាក់តេរី រលាយ ដោយ ក្រណាត់ មិន ត្បាញ
ប្រពន្ធ មិន មាន នាទី ក្នុង ការរក លុយកាក់ ទេ ។
ឥណ្ឌូនេស៊ី ម៉ាឡេស៊ី និង ថៃ ៕
សាលា រាជធានី ភ្នំពេញ ប្រកាស ឱ្យ អ្នកដំណើរ តាម ដងទន្ល បង្កើន ការប្រុងប្រយ័ត្ន នា រដូវ ទឹក ឡើង
នេះ ជា លើក ទី១ ហើយ ដែល ទស្សនិកជន មិត្ត អ្នកគាំទ្រ បាន ឃើញ តារា សម្តែង ស្រី ស៊ីន យូប៊ិន និយាយ ថៃ បែប នេះ ។
អ្វី ដែល កាន់តែ ពិសេស និង រីករាយ បំផុត នោះ គឺ លោក អ្នក នឹង ទទួលបាន រង្វាន់ ភ្លាម ៗ
ម្តង ឬ ញឹកញាប់ ក៏ដោយ វា សំខាន់ ណាស់ ។
ខ្ញុំ និង ក្រុម ខ្ញុំ ទន្ទឹងរងចាំ ដើម្បី ប្រែក្លាយ គោលដៅ និង បេសកកម្ម អាជីវកម្ម របស់ យើង ឱ្យ ក្លាយទៅជា ការពិត ។
ដោយឡែក ជម្រើស នៃ យន្តហោះ គឺជា រឿង សំខាន់ ។
នោះ ទេ ដែល ធ្វើឱ្យ គ្រូបង្វឹក វ័យ ក្មេង រូប នេះ ខកចិត្ត ។
មើល ទៅ លោក ដូចជា គ្មាន ក្តីបារម្ភ អ្វី អំពី ព័ត៌មាន ពី ការចាប់ខ្លួន លោក ទេ ។
៤. លំហាត់ប្រាណ ខាងក្រៅ
ម្យ៉ាង ដោយសារតែ ខែ នេះ ជា ខែ ភ្លៀង ដូច្នេះ ប្រសិនបើ ឱ្យ ពួកគាត់ រុះរើ លំនៅដ្ឋាន មិន ដឹង ថា តើ ពួកគាត់ នឹង ត្រូវ ទៅ នៅ ទីណា នោះ ទេ ?
លោក ជាមុន្នី ប្រធាន សហជីព សេរី កម្មករ ដែល ជា ប្អូន ប្រុស របស់ លោក ជា វិជ្ជា ។
តើ អ្នក នៅក្នុង ចិត្ត ប្រិយមិត្ត វិញ គិត ថា អ្នក ប្រដាល់ រូប ណា សម ជា កំពូល អ្នកប្រដាល់ សម័យ បច្ចុប្បន្ន ?
ទម្លាប់ នៃ ការចាយវាយ ខ្ពស់ របស់ បក្ស ប្រជាជន កម្ពុជា ៖
ខិតខំ រៀនសូត្រ បន្ថែម ទៅ ចាំ ប្រលង ជាប់ បាន និទ្ទេស ល្អ ធ្វើ ពិធី ជប់លៀង នៅ ស្រុក កំណើត កំពង់ចាម របស់ យើង ណា !
០៣ ប្រាស្រ័យទាក់ទង គ្នា ៖
កន្លងមក តែ ការទូទាត់ នោះ មាន ចំនួន បន្តិច ម្តង ៗ
អាជ្ញាធរ រាជធានី ភ្នំពេញ អនុញ្ញាតឱ្យ រៀបចំ ពិធី អាពាហ៍ពិពាហ៍ និង បុណ្យ ផ្សេង ៗ
ចាំ មើល ជាក់ស្តែង ។
យើង កំពុង អនុវត្ត គោលការណ៍ រក្សា គម្លាត សុវត្ថិភាព នៅ កន្លែង ធ្វើការ ដូច្នេះ យើង មាន បុគ្គលិក ចំនួន តិច ជាង ពេល យើង ធ្វើ ការធម្មតា ។
ព្រោះ អូន មាន ក្បាល ស្រួច ៗ
