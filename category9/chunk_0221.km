សម្តេច តេជោ បន្ថែម ថា « បណ្តា ប្រទេស ជាច្រើន នៅលើ ពិភពលោក បាន កោតសរសើរ ចំពោះ សុខដុម បនីយកម្ម សាសនា នៅ កម្ពុជា តាមរយៈ គោល នយោបាយ ដ៏ ត្រឹមត្រូវ របស់ រាជ រដ្ឋាភិបាល ដែល មាន កិច្ចសហប្រតិបត្តិការ ល្អ ជាមួយ ស្ថាប័ន អង្គភាព ក៏ ដូចជា ដៃគូ ពាក់ព័ន្ធ ដើម្បី ធ្វើឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ បង្ក ការងាយស្រួល ដល់ ប្រជាពលរដ្ឋ គ្រប់ សាសនា » ។
ជាមួយគ្នា នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ដល់ គ្រិស្ត បរិស័ទ ទាំងអស់ ដែល បាន ប្រឹងប្រែង រួមគ្នា ថែរក្សា សុខ សន្តិភាព ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ និង ចូលរួម អភិវឌ្ឍន៍ កម្ពុជា ។
សម្តេច តេជោ ហ៊ុន សែន បន្ត ថា រយៈពេល ១០០ ឆ្នាំ មក នេះ គ្រិស្ត សាសនា ក៏ មិន ខុសពី សាសនា ដទៃ ទៀត ទេ គឺ បាន ឆ្លងកាត់ នូវ សង្គ្រាម ផលវិបាក នៃ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង ដំណាក់កាល សង្គ្រាម ជា បន្តបន្ទាប់ ដែល ជា ការចង ភ្ជាប់ ជោគវាសនា នៃ បណ្តា សាសនា និង ជាតិ សាសន៍ ទាំងអស់ រស់ នៅ លើ ទឹកដី កម្ពុជា ជាមួយ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ។
ថ្លែង នៅ ចំពោះមុខ ថ្នាក់ដឹកនាំ គ្រិស្ត បរិស័ទ ជាង ៣ម៉ឺន នាក់ សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ ដល់ គ្រិស្ត បរិស័ទ ទាំងអស់ សូម បន្ត ចូលរួម ថែរក្សា ការពារ សុខ សន្តិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ នៅក្នុង សង្គម តាមរយៈ ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ដើម្បី ធានា ថា គ្រប់ សាសនា ទាំងអស់ រស់ នៅ ជាមួយគ្នា យ៉ាង សុខសាន្ត ក្រោម ដំបូល សុខ សន្តិភាព របស់ កម្ពុជា ៕
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ទោ អ៊ុំ ណា គ្រី សម្តែង ការអបអរសាទរ និង ជូនពរ ដោយ ស្មោះ អស់ ពី ដួងចិត្ត ជូន ចំពោះ ឧកញ៉ា ទៀ ណារ៉ា វុទ្ធ និង លោកស្រី មាស សុភារី ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា សព្វ ព្រះរាជ ហឫទ័យ ត្រាស់បង្គាប់ ផ្តល់ គោរមងារ ជា « អ្នក ឧកញ៉ា » និង « ឧកញ៉ា » ។
ឆ្លៀត ក្នុង ឱកាស ដ៏ វិសេសវិសាល ថ្លៃថ្លា នេះ ខ្ញុំ មាន សេចក្តី សោមនស្ស រីករាយ និង សូម បួងសួង ដល់ វត្ថុ ស័ក្ដិសិទ្ធិ ទាំងអស់ ក្នុង លោក សូម ជួយ ប្រោះ ព្រំ ប្រសិទ្ធ ពរ ជ័យ ជូន អ្នក ឧកញ៉ា ទៀ ណារ៉ា វុទ្ធ និង ឧកញ៉ា មាស សុភារី ព្រមទាំង ក្រុមគ្រួសារ ជា ទីស្រឡាញ់ ជួបប្រទះ តែ សេចក្ដីសុខ សុភមង្គល និង ប្រកបដោយ ពុទ្ធ ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សូម បញ្ជាក់ ថា ការត្រាស់បង្គាប់ ផ្តល់ គោរព ងារ ជា « អ្នក ឧកញ៉ា » និង ឧកញ៉ា ដោយ ព្រះករុណា ជា អម្ចាស់ តម្កល់ លើ ត្បូង យាង ទត ឃើញ ថា អ្នក ឧកញ៉ា ទៀ ណារ៉ា វុទ្ធ និង ឧកញ៉ា មាស សុភារី បាន ចូលរួម ធ្វើ សកម្មភាព ជាច្រើន ដើម្បី រួមចំណែក អភិវឌ្ឍន៍ សង្គមជាតិ បម្រើ នូវ ឧត្តម ប្រយោជន៍ សម្រាប់ ជាតិ និង ប្រជាជន ពិសេស ការងារ មនុស្សធម៌ ៕
សម្ដេច តេជោ ហ៊ុន សែន បាន អះអាង ថា រាជ រដ្ឋាភិបាល កម្ពុជា ប្រឆាំង ជាមួយ ការរើសអើង នានា ហើយ ពិតជា មិន ចង់ឲ្យ ទឹកដី មួយ នេះ ញាំញី ទៅ ដោយ ជម្លោះ សាសនា នោះ ទេ ព្រោះថា ការបែកបាក់ ជាតិ សាសន៍ និង សាសនា គឺជា មហន្ដរាយ ដ៏ ធំ មួយ ដែល មិន ត្រូវ ឲ្យ កើតមាន នៅ នោះ ឡើយ ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី . នៅលើ ពិភពលោក នេះ រាប់ ទាំង កម្ពុជា ខ្លួន សាសនា ទាំងឡាយ តែ មាន និកាយ ខុស ៗ គ្នា សូម្បីតែ ព្រះពុទ្ធ សាសនា ក៏ មាន ធម្មយុត្ត និង មហា និកាយ នៅក្នុង ឥស្លាម ក៏ មាន ខាង និកាយ ច្រើន ខុសគ្នា ហើយ នៅក្នុង គ្រិស្ដ សាសនា ដែល យើង កំពុង ជួបជុំគ្នា នៅ ទីនេះ ក៏ មាន និកាយ ខុស ៗ គ្នា ។ ប៉ុន្តែ ដូច សម្ដេច បាន បញ្ជាក់ ការខុសគ្នា ខាង ជាតិ សាសន៍ និង សាសនា មិន មែន ជា ឧបសគ្គ នៃ ការកសាង ប្រទេស នោះ ។
ផ្ទុយទៅវិញ វា កាន់តែ មាន ភាពងាយស្រួល សម្រាប់ យើង នៅក្នុង ក្របខ័ណ្ឌ គ្រិស្ដ បរិស័ទ បើ ទោះបី នៅក្នុង និកាយ ណា ក៏ដោយ តែ យើង បន្ដ រួមរស់ ជាមួយគ្នា តាមរយៈ ការធ្វើ សុខដុមនីយកម្ម ។ សម្ដេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ទៀត ថា ដោយ បង្ហាញ នូវ សុទិដ្ឋិនិយម អំពី អនាគត នៃ សាមគ្គីភាព នៅក្នុង ក្របខ័ណ្ឌ និកាយ គ្រិស្ត សាសនា នៅ ព្រះរាជាណាចក្រ កម្ពុជា ផងដែរ ។
សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំឲ្យ មាន ការរៀបចំ ដឹកនាំ ឬ តំណាង ច្បាស់លាស់ ក្នុង ជំនឿ គ្រិស្ដ បរិស័ទ ក្នុង ប្រទេស កម្ពុជា ដោយ មាន កិច្ចសហការ ជិតស្និត ជាមួយ ក្រសួង ធម្មការ និង សាសនា ៕
គួរ បញ្ជាក់ ថា អ៊ុយក្រែន កំពុង ត្រូវការ ជា ចាំបាច់ នូវ រថក្រោះ ប្រយុទ្ធ ទំនើប ៗ ពី លោក ខាងលិច រាប់ រយ គ្រឿង ដើម្បី អាច ទម្លុះ ខ្សែ ការពារ ទាហាន រុស្ស៉ី និង ដណ្ដើម យក ទឹកដី មកវិញ នៅក្នុង តំបន់ ភាគ ខាងត្បូង និង ភាគ ខាងកើត នៃ ប្រទេស ខណៈ បច្ចុប្បន្ន ទាំង រុស្ស៉ី និង អ៊ុយក្រែន កំពុង ប្រើប្រាស់ រថ ក្រោះសល់ ពី សម័យ សូវៀត T-72 ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី អបអរសាទរ ខួប ១០០ ឆ្នាំ នៃ វត្តមាន សាសនា គ្រិស្ត នៅ កម្ពុជា
ពិធី បើក ព្រឹត្តិការណ៍ នេះ ប្រព្រឹត្តទៅ នៅ ព្រឹក ថ្ងៃសុក្រ ទី ២៧ ខែមករា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ។ ពិធី បិទ ព្រឹត្តិការណ៍ ធ្វើឡើង នៅ ល្ងាច ថ្ងៃទី ២៨ ខែមករា ក្រោម អធិបតីភាព លោក បណ្ឌិត ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក ។
* ជា កិច្ច ចាប់ផ្តើម ប្រសាសន៍ ក្នុង ពិធី អបអរសាទរ ខួប ១០០ ឆ្នាំ នៃ វត្តមាន សាសនា គ្រិស្ត នៅ កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ថា សល់ តែ ៩៨ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ដល់ ពេល កម្ពុជា ធ្វើ ម្ចាស់ ផ្ទះ ប្រកួត ស៊ីហ្គេម ហើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ពិធី អបអរសាទរ ខួប ១០០ ឆ្នាំ នៃ វត្តមាន គ្រិស្ត សាសនា នៅ កម្ពុជា គឺជា ការអរគុណ ដល់ ព្រះយេស៊ូ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការជួបជុំ អបអរសាទរ នេះ ក៏ ជា ការបង្ហាញ ឱ្យ ពី ការរីកចម្រើន លើ ផ្នែក ជំនឿ សាសនា នៅ កម្ពុជា ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គ្រិស្ត បរិស័ទ បាន ចូលរួមចំណែក យ៉ាង លើ កិច្ចការ សង្គម នៅ កម្ពុជា ។
