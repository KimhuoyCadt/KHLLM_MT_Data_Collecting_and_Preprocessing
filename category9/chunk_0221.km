( ភ្នំពេញ ) ៖ កាកបាទ ក្រហម កម្ពុជា បាន ប្រជុំ លើក ទី១ ស្ដីពី ខ្លឹមសារ ខួប លើក ទី ១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភាព ២០២៣ និង ផែនការ ត្រូវ អនុវត្ដ ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទះ ក្នុង កិច្ចប្រជុំ ថ្នាក់ដឹកនាំ លើក ទី២០ និង វេទិកា យុវជន លើក ទី២ នៃ សមាគម ជាតិ កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ភូមិភាគ អាស៊ី អាគ្មេយ៍ ។
កិច្ចប្រជុំ នេះ បាន ប្រារព្ធ ទៅ ក្រោម អធិបតីភាព លោកស្រី កិត្ដិ សង្គហ បណ្ឌិត ឃួន សុដារី អនុប្រធាន កាកបាទ ក្រហម កម្ពុជា និង មាន ការអញ្ជើញ ពី លោកស្រី កិត្ដិ បណ្ឌិត អ៊ុក ម៉ាលី អគ្គ ហេរញ្ញិក កាកបាទ ក្រហម កម្ពុជា កាកបាទ ក្រហម កម្ពុជា និង លោក ពិត ចំណាន សមាជិក គណៈកម្មាធិការ កណ្ដាល កាកបាទ ក្រហម កម្ពុជា និង មន្ដ្រី ក្រុមការងារ ជាច្រើន រូប ទៀត ដែល បាន ប្រព្រឹត្ដទៅ នៅ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣នេះ នាទី ស្នាក់ការ កណ្ដាល កាកបាទ ក្រហម កម្ពុជា ។
ក្នុង កិច្ចប្រជុំ នេះ បាន លើក ពិភាក្សា ទៅ លើ របៀបវារៈ មួយចំនួន ដូច ជា៖ * ពិភាក្សា លើ ខ្លឹមសារ និង ជំហាន ត្រូវ អនុវត្ដ ក្នុង ការរៀបចំ ទិវា ៨ឧសភា * ពិភាក្សា លើ ខ្លឹមសារ និង ផែនការ ត្រូវ អនុវត្ដ ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទះ ក្នុង កិច្ចប្រជុំ ថ្នាក់ដឹកនាំ លើក ទី២០ និង វេទិកា យុវជន លើក ទី២ នៃ សមាគម ជាតិ កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ភូមិភាគ អាស៊ី អាគ្មេយ៍ និង បញ្ហា ផ្សេង ៗ ៕
មន្រ្តី ជាន់ ខ្ពស់ កម្ពុជា - ថៃ ប្រជុំ រួមគ្នា លើ ការគ្រប់គ្រង ជនរងគ្រោះ ដែល ធ្វើ មាតុភូមិ និវត្ត និង ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស
( សៀមរាប ) ៖ ភាគី កម្ពុជា - ភាគី ថៃ នា ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ កិច្ចប្រជុំ ទ្វេ ភាគី ស្តីពី បញ្ចប់ សេចក្តីព្រាង ឧបសម្ពន្ធ ផែនការ សកម្មភាព នៃ នីតិវិធី ប្រតិបត្តិ បទដ្ឋាន សម្រាប់ ការគ្រប់គ្រង ការធ្វើ មាតុភូមិ និវត្ត និង សមាហរណកម្ម ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស ។
លោក ញ៉ឹក វណ្ណារ៉ា រដ្ឋលេខាធិការ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា តំណាង លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច បាន ឱ្យដឹង ថា កិច្ចប្រជុំ នេះ ពិតជា មាន សារសំខាន់ ក្នុង ការទំនាក់ទំនង ចំណង មិត្តភាព កម្ពុជា និង ថៃ ក្នុង កិច្ចសហប្រតិបត្តិការ លុបបំបាត់ កាត់បន្ថយ ផ្តល់ សេវា ស្តានីតិសម្បទា ការសម្របសម្រួល ធ្វើ មាតុភូមិ និវត្តន៍ និង ការធ្វើ សមាហរណកម្ម ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស ពីព្រោះ ប្រទេស ទាំង ពីរ គឺជា ប្រទេស ជាប់ របង នឹង គ្នា ។
« ហេតុ ដូច្នេះហើយ ទើប ថ្ងៃ នេះ យើង ជូប គ្នា ដើម្បី ប្រជុំ បញ្ចប់ សេចក្តីព្រាង ឧបសម្ពន្ធ ផែនការ សកម្មភាព នៃ នីតិវិធី ប្រតិបត្តិ បទដ្ឋាន សម្រាប់ ការគ្រប់គ្រង ករណី នៃ ការធ្វើ មាតុភូមិ និវត្ត និង សមាហរណកម្ម ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស រវាង កម្ពុជា និង ថៃ »។ លោក ញ៉ឹក វណ្ណារ៉ា បន្ថែម ។
ជាមួយគ្នា នេះ លោក រដ្ឋលេខាធិការ សង្ឃឹម យ៉ាង មុតមាំ ថា កិច្ចប្រជុំ ថ្ងៃ នេះ នឹង ក្លាយជា យាន្ត មួយ ដ៏ មាន សារសំខាន់ ក្នុង ការអនុវត្ត ការងារ ជាក់ស្តែង ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ និង ជា ជំនួយ ស្មារតី ដល់ អ្នក ផ្តល់ សេវា ថែទាំ ជនរងគ្រោះ ពិសេស ការកំណត់ អត្តសញ្ញាណ បឋម ការផ្តល់ សេវា និង ការសម្របសម្រួល ក្នុង ការធ្វើ មាតុភូមិ និវត្ត ជនរងគ្រោះ នៃ ជនជាតិ ទាំង ពីរ ប្រទេស គឺ កម្ពុជា និង ថៃ ៕
( ឧត្តរមានជ័យ )៖ ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា នៅ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ នេះ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន បាន ដឹកនាំ គណៈប្រតិភូ នៃ គម្រោង បោសសម្អាត មីន របស់ ទីភ្នាក់ងារ ស្វីស សម្រាប់ ការអភិវឌ្ឍ និង កិច្ចសហប្រតិបត្តិការ រួម មាន អាល្លឺម៉ង់ សហរដ្ឋ អាមេរិក ចក្រភព អង់គ្លេស ស្វីស អៀរឡង់ និង HDR&D ចុះ ពិនិត្យ សកម្មភាព បោសសម្អាត មីន របស់ អង្គការ HALO Trust ប្រចាំ កម្ពុជា និង ជួប សំណេះសំណាល ជាមួយ អ្នកទទួល ផល នៅ ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ ។
លោក ទេសរដ្ឋមន្រ្តី លី ធុជ បាន នាំ គណៈប្រតិភូ ចូល ទស្សនា រមណីយដ្ឋាន ទេសចរណ៍ ប្រវត្តិសាស្រ្ត ផ្ទះ តា ម៉ុក ដើម្បី ស្វែងយល់ អំពី ប្រវត្តិសាស្រ្ត ពិត នៃ អតីត តំបន់ សមរភូមិ ប្រយុទ្ធ ចុងក្រោយ របស់ ខ្មែរ ក្រហម ដែល កំឡុង ពេល នោះ កម្ពុជា មួយ មាន តំបន់ ត្រួតត្រា ច្រើន និង មិន ទាន់ មាន សន្តិភាព ពេញលេញ នៅឡើយ ប៉ុន្តែ បច្ចុប្បន្ន នេះ គឺ កម្ពុជា មាន តែ មួយ និង ទទួលបាន សុខ សន្តិភាព ទូទាំង ប្រទេស ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី បញ្ចប់ សង្រ្គាម ចុង ឆ្នាំ ១៩៩៨ ។
ក្រសួង ការពារ ជាតិ របស់ តៃ ប៉ិបាន និយាយ ថា ចាប់ពី ត្រីមាស ទី២ នៃ ឆ្នាំ នេះ ទាហាន ស្ត្រី ប្រហែល ២០០ នាក់ នឹង ត្រូវបាន អនុញ្ញាតឱ្យ ចូលរួម ក្នុង វគ្គ បណ្តុះបណ្តាល យោធា ស្ម័គ្រចិត្ត ជា លើក ដំបូង ដែល ជា ផ្នែក មួយ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ដើម្បី ធ្វើឲ្យ ប្រសើរឡើង នូវ កម្លាំង បម្រុង ទាំងមូល ។
គួរ បញ្ជាក់ ថា តៃវ៉ាន់ ដែល អនុវត្ត លទ្ធិ ប្រជាធិបតេយ្យ រស់ នៅក្នុង ភាពភ័យខ្លាច ឥត ឈប់ឈរ ចំពោះ ការប្រើ កម្លាំង បាយ របស់ ចិន ខណៈ ដែល ទីក្រុង ប៉េកាំង បាន អះអាង ថា កោះ មួយ នេះ ជា ផ្នែក មួយ នៃ ទឹកដី របស់ ខ្លួន ។ ការឈ្លានពាន របស់ រុស្ស៊ី លើ អ៊ុយក្រែន បាន បង្កើន ការព្រួយបារម្ភ កាន់តែ ខ្លាំង ឡើង ដែល ថា ទីក្រុង ប៉េកាំង អាច ចាត់ វិធានការ ស្រដៀង គ្នា នេះ ៕
ទីលាន ផ្នូរ យុទ្ធជន ពលី និង សមិទ្ធផល ម នានា នៅ ខេត្ត កោះកុង ត្រូវ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ
( កោះកុង ) ៖ ទីលាន ផ្នូរ យុទ្ធជន ពលី និង សមិទ្ធផល នានា មាន ទំហំ ដី ជិត ១ហិកតា ស្ថិត នៅ ភូមិ ៣ សង្កាត់ ស្មាច់ មានជ័យ ក្រុង ខេមរភូមិន្ទ ដែល ចំណាយ ពេល សាងសង់ ជាង ១ ឆ្នាំ គិត ចាប់ពី ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២១ មកដល់ ចុង ឆ្នាំ ២០២២ ត្រូវបាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ហើយ នៅ រសៀល ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ នេះ ។
ពិធី សម្ពោធ បាន ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ខេត្ត កោះកុង តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ការសាងសង់ ផ្នូរ នេះ ឡើង គឺ ដើម្បី ឧទ្ទិស កុសល ជូន ដល់ ដួង វិញ្ញាណក្ខន្ធ កម្មាភិបាល យុទ្ធជន ដែល បាន ពលី ជីវិត ក្នុង សម័យ សង្គ្រាម ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ថ្លែង កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ក្រុមការងារ សាងសង់ ទីលាន ផ្នូរ យុទ្ធជន នេះ ឡើង ។ សម្តេច ពិជ័យ ចាត់ទុក ការរៀបចំ ទីលាន ផ្នូរ យុទ្ធជន នេះ ជា ការដឹងគុណ ដល់ អតីត យុទ្ធ ដែល មាន គុណ បំណាច់ ធំ ធេង សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ហើយក៏ ជា ការរៀបចំ ឱ្យ សម នឹង កិត្តិយស ដែល ពួកគេ បាន ធ្វើ ចំពោះ ជាតិ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ថ្លែងអំណរគុណ ដល់ សប្បុរសជន ទាំងអស់ ដែល បរិច្ចាគ ថវិកា សាងសង់ ទីលាន ។ សម្តេច បាន បំពាក់ គ្រឿង ឥស្សរយ ស និង ប្រគល់ បណ្ណ ថ្លែងអំណរគុណ ដល់ សប្បុរសជន ទាំងអស់ នោះ ផងដែរ ។
ក្នុង ឱកាស ស្វាគមន៍ នាយក រដ្ឋមន្ត្រី ហូឡង់ មកកាន់ សេតវិមាន លោក បៃ ដិន បាន ថ្លែងអំណរគុណ ដល់ លោក រូត តេ ដែល មាន ការប្តេជ្ញាចិត្ត យ៉ាង ខ្លាំង សម្រាប់ ការគាំទ្រ អ៊ុយក្រែន ។ លោក ក៏ ទន្ទឹងរង់ចាំ ពិភាក្សា លើ វិធី ពង្រឹង ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ បច្ចេកវិទ្យា ផលិត បន្ទះ ឈីប ឬ សឺមីកង់ ឌុច ទ័រ (semiconductor) ដែល សហរដ្ឋ អាមេរិក បាន អនុម័ត វិធានការ ដើម្បី បង្អាក់ សមត្ថភាព របស់ ចិន ក្នុង ការផលិត បន្ទះ ឈីប ហើយ មន្ត្រី ពាណិជ្ជកម្ម អាមេរិក រំពឹង ថា ហូឡង់ ជប៉ុន នឹង អនុវត្ត ច្បាប់ ស្រដៀង គ្នា នេះ ។
អ្នក ឧកញ៉ា គិត ម៉េង ចុះ កិច្ចព្រមព្រៀង ជាមួយ អាកាសចរ ស៊ីវិល លើ គម្រោង សាងសង់ ព្រលានយន្តហោះ អន្តរជាតិ កោះ រ៉ុង តម្លៃ ៣០០ លាន ដុល្លារ
ពិធី ចុះហត្ថលេខា នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្រ្តី ទទួលបន្ទុក រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល និង អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន ក្រុមហ៊ុន រ៉ូយ៉ាល់ គ្រុប កោះ រ៉ុង ឌីវេឡប មេន ខម ភេនី និង មាន ការចូលរួម ពី មន្ទីរ ស្ថាប័ន ពាក់ព័ន្ធ ព្រមទាំង មន្ត្រី ជាច្រើន រូប ទៀត ។
សូម រំលឹក ថា កាលពី ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០០៨ ក្រុមហ៊ុន រ៉ូយ៉ាល់ គ្រុប ខូអិលធីឌី បាន ចុះហត្ថលេខា ជួល កោះ រ៉ុង ជាមួយ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ដែល ជា ភាគី តំណាង ឲ្យ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី អភិវឌ្ឍ ជា តំបន់ អភិវឌ្ឍន៍ ពាណិជ្ជកម្ម រមណីយដ្ឋាន ទេសចរ ធម្មជាតិ រួមទាំង ហេដ្ឋារចនាសម្ព័ន្ធ អាកាសយានដ្ឋាន ផងដែរ ៕
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ ជឿជាក់ ថា ទីលាន ផ្នូរ យុទ្ធជន នៅ ខេត្ត កោះកុង នឹង ក្លាយជា ទីតាំង សច្ច ភាព ប្រវត្តិសាស្ត្រ យោធា ដែល បង្ហាញ ពី ការតស៊ូ លះបង់ ស្នេហាជាតិ ដើម្បី បូរណភាព ទឹកដី សម្រេចបាន នូវ ការកសាង សុខ សន្តិភាព ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ និង ភាពសម្បូរសប្បាយ របស់ ប្រជាជាតិ កម្ពុជា មកដល់ បច្ចុប្បន្ន ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន លើកឡើង បែប នេះ ខណៈ អញ្ជើញ ជា តំណាង សម្តេច តេជោ ហ៊ុន សែន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ទីលាន ផ្នូរ យុទ្ធជន ពលី និង សមិទ្ធផល នានា នៅ ខេត្ត កោះកុង កាលពី ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ដែល ជា ឥរស្ស ជន ដ៏ ឆ្នើម រូប ចូលរួម ផ្តួលរលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត បាន គូសបញ្ជាក់ ថា ទីលាន ផ្នូរ យុទ្ធជន នឹង ជួយ បណ្តុះ ស្មារតី ស្នេហាជាតិ សាមគ្គីភាព ការ ឱ្យ តម្លៃ និង ដឹងគុណ ដល់ កុលបុត្រ កុល ធីតា ខ្មែរ ជំនាន់ ក្រោយ ទៅ លើ ការលះបង់ តស៊ូ របស់ វីរ យុទ្ធជន យុទ្ធ នារី ដើម្បី ជាតិ មាតុភូមិ នៅ គ្រប់ ពេលវេលា គ្រប់ កាលៈទេសៈ ដោយ មិន គិត ពី ទុក្ខលំបាក ដើម្បី ជាតិ រហូត កម្ពុជា មាន ភាពរីកចម្រើន លើ គ្រប់ វិស័យ នា ពេល បច្ចុប្បន្ន នេះ ។
ប្រមុខ ការពារ ជាតិ បាន គូសបញ្ជាក់ បន្ថែម ថា ការសាងសង់ ទីលាន ផ្នូរ យុទ្ធជន នេះ ឡើង មិន ត្រឹមតែ ជា ទី ឋាន រំលឹក ដល់ កម្មាភិបាល យុទ្ធជន យុទ្ធ នារី ដែល បាន ពលី ជីវិត ដើម្បី ជាតិ មាតុភូមិ និង ប្រជាជន ប៉ុណ្ណោះ ទេ តែ ទីលាន នេះ នឹង ក្លាយជា សំណង់ ប្រវត្តិសាស្ត្រ បង្កប់ និង បង្ហាញ នូវ តម្លៃ រួបរួម សាមគ្គី វប្បធម៌ កតញ្ញូ និរន្តភាព នៃ សង្គមជាតិ ទៀតផង ។
សម្តេច បាន លើកឡើង ទៀត ថា ពិធី សម្ពោធ ទីលាន ផ្នូរ យុទ្ធជន ខេត្ត កោះកុង ក៏ ជា សក្ខីភាព បាន បង្ហាញ ពី តម្លៃ សន្តិភាព និង ការឯកភាព ជាតិ ពេញលេញ តាមរយៈ នយោបាយ ឈ្នះ - ឈ្នះ ដែល បាន ធ្វើឱ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល ប្រជាជន ទូទាំង ប្រទេស ប្រសិទ្ធ នាម ថា ជា ស្ថាបនិក ឯក និង ជា មគ្គុទ្ទេសក៍ ឯក ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន បង្ហាញ ជំនឿ ថា៖ « ខ្ញុំ សង្ឃឹម និង ជឿជាក់ យ៉ាង មុតមាំ ថា ទីលាន ផ្នូរ យុទ្ធជន នេះ នឹង ក្លាយជា ទីតាំង សច្ច ភាព ប្រវត្តិសាស្ត្រ យោធា បង្ហាញ ពី ការតស៊ូ លះបង់ ស្នេហាជាតិ ដើម្បី បូរណភាព ទឹកដី សម្រេចបាន នូវ ការកសាង សុខ សន្តិភាព ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ និង ភាពសម្បូរសប្បាយ របស់ ប្រជាជាតិ កម្ពុជា មកដល់ បច្ចុប្បន្ន » ។
នាយ ឧត្តមសេនីយ៍ យន្ត មីន បាន ឱ្យដឹង ថា សម្រាប់ ដំណើរការ សាងសង់ទីលាន នេះ គឺ ចំណាយ អស់ ថវិកា ៧៣៩. ៣៧៣ ដុល្លារ . ប្រាក់ រៀល អស់ ចំនួន ១៧៣.៩០០.០០០ រៀល និង លុយ បាត ចំនួន ១ម៉ឺន បាត ។ សម្រាប់ ថវិកា សាងសង់ ផ្នូរ យុទ្ធជន ពលី នេះ គឺ ទទួលបាន ពី ការចូលរួម ពីសំណាក់ សប្បុរសជន នានា ដែល មាន ចំនួន ៤១៧ នាក់ រហូត សម្រេច ជា ជោគជ័យ លើ ដំណើរការ សាងសង់ ផ្នូរ ដ៏ ស្រស់ស្អាត សម្រាប់ ជា ការឧទ្ទិស ដឹង គុណ ជូន អតីត យុទ្ធជន យុទ្ធ នារី ពលី ដើម្បី ជាតិ មាតុភូមិ នា សម័យ សង្គ្រាម ស៉ី វិល ។
សូម ជម្រាប ថា ផ្នូរ យុទ្ធជន ខេត្ត កោះកុង ត្រូវបាន បើក ការដ្ឋាន សាងសង់ កាលពី ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២១ កន្លងទៅ ក្រោម អធិបតីភាព សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ។ ផ្នូរ យុទ្ធជន នេះ មាន ទំហំ ដី ជិត ១ហិកតា ស្ថិត នៅ ភូមិ ៣ សង្កាត់ ស្មាច់ មានជ័យ ក្រុង ខេមរភូមិន្ទ ផ្នូរ យុទ្ធជន នេះ បាន បញ្ចប់ ដំណើរការ សាងសង់ នៅ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ ដែល ជា ថ្ងៃ ខួប ៤៤ ឆ្នាំ ទិវា ជ័យជម្នះ ៧ មករា ។
ក្នុង បរិវេណ ផ្នូរ មាន សព កម្មាភិបាល យុទ្ធជន យុទ្ធ នារី មកពី ១៨ រាជធានី - ខេត្ត ដែល បាន ពលី នៅក្នុង ចន្លោះ ឆ្នាំ ១៩៧៩ ដល់ ឆ្នាំ ១៩៩៨ ចំនួន ៤៤៨ស ព ដែល សព១ គឺជា មន្ត្រី សាលា ខេត្ត កោះកុង បម្រើ ការ ផ្នែក អគ្គិសនី ហើយ នៅ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០២២ ថ្មី ៗ នេះ បាន រកឃើញ នូវ សព យុទ្ធជន ចំនួន ៥នាក់ បន្ថែម ទៀត ដោយ មិន ស្គាល់ អត្ថសញ្ញាណ ដែល ធ្វើឱ្យ ចំនួន សព បញ្ចុះ នៅ ទីលាន នេះ មាន ចំនួន ៤៥៣សព ៕
គួរ បញ្ជាក់ ថា នៅក្នុង កិច្ចសន្ទនា តាម ទូរស័ព្ទ ជាមួយ លោក ប្រធានាធិបតី អ៊ុយក្រែន លោក ហ្សេលេន ស្គី កាលពី ដើម ខែមករា កន្លងទៅ នេះ លោក គីស៉ី ដា បាន បង្ហើប ថា លោក នឹង ពិចារណា លើ ការអញ្ជើញ ឱ្យ បំពេញ ដំណើរទស្សនកិច្ច ទៅកាន់ ទីក្រុង កៀវ អាស្រ័យ ទៅ លើ កាលៈទេសៈ ជាក់ស្ដែង ។ ប៉ុន្តែ មិន ទាន់ មាន ការសម្រេចចិត្ត ជា ផ្លូវការ នៅឡើយ ទេ មក ទល់នឹង ពេលនេះ ៕ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន អនុញ្ញាតឱ្យ ឯក អគ្គ រដ្ឋទូត សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី ដែល ចប់ ពី អាណត្តិ ចូល សម្តែង ការគួរសម និង ជម្រាប លា
លោក ស៊ូឌីម៉ាន់ ហាសេង បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សម្តេច ដែល បាន គាំទ្រ និង ផ្តល់ កិច្ចសហការ ល្អ នា ពេល កន្លងមក ក្នុង ការជំរុញឱ្យ បេសកកម្ម ការ ទូត របស់ លោក ទទួលបាន ជោគជ័យ ។ លោក បាន គោរព ស្នើ សូម សម្តេច ប្រធាន រដ្ឋសភា និង មន្រ្តី រាជការ ទំាង អស់ បន្ត គំាទ្រ និង ផ្តល់ កិច្ចសហប្រតិបត្តិការ ល្អ បន្ត ទៀត ដល់ ឯក អគ្គ រដ្ឋទូត ថ្មី សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី ដែល នឹង មក បន្ត បេសកកម្ម ពី លោក នា ពេល ខាងមុខ នេះ ។
លោក ឯក អគ្គ រដ្ឋទូត បាន វាយតម្លៃ ខ្ពស់ ពី ជោគជ័យ របស់ កម្ពុជា នៅក្នុង ការរៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ នានា ព្រម ទំាង មហាសន្និបាត អន្តរសភា អាស៊ាន (AIPA) នា ពេល កន្លងមក នេះ ។ លោក បញ្ជាក់ ថា ជោគជ័យ របស់ កម្ពុជា នោះ នឹង ជំរុញ ដល់ ប្រទេស ឥណ្ឌូនេស៊ី ឱ្យ ខិតខំ រៀបចំ កិច្ចប្រជុំ ខាងលើ នេះ បន្ត ពី កម្ពុជា ឱ្យ បាន ល្អ ប្រសើរ ផងដែរ ។
លោក ស៊ូឌីម៉ាន់ ហាសេង បាន លើកឡើង ថា នៅក្នុង រយៈពេល បំពេញ បេសកកម្ម នៅ កម្ពុជា ៥ឆ្នាំ កន្លងមក នេះ ឯកឧត្តម បាន សង្កេតឃើញ ថា កម្ពុជា មាន ការអភិវឌ្ឍ រីកចម្រើន នៅ ទូទំាង ប្រទេស ពិសេស នៅ រាជធានី ភ្នំពេញ ដែល ជា សញ្ញា មួយ បញ្ជាក់ ថា នៅពេល ខាងមុខ ដ៏ ខ្លី នេះ កម្ពុជា នឹង មាន ខឿន សេដ្ឋកិច្ច រឹងមាំ ជា មិន ខាន ឡើយ ។
ជាមួយគ្នា នេះ លោក ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន យក នាម របស់ អតីត ប្រធានាធិបតី ឥណ្ឌូនេស៊ី ដាក់ ឈ្មោះ ផ្លូវ ពីរ ខ្សែ នៅក្នុង រាជធានី ភ្នំពេញ ដែល បង្ហាញ ពី ចំណង មិត្តភាព ដ៏ រឹងមាំ និង ជិតស្និទ្ធ នៃ ប្រទេស ទំាង ពីរ ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង ក្នុង អាណត្តិការ ទូត របស់ លោក ស៊ូឌីម៉ាន់ ហាសេង ដែល បាន រួមចំណែក ដល់ ការបន្ត ថែរក្សា ទំនាក់ទំនង មិត្តភាព ជា ប្រពៃណី និង កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា - ឥណ្ឌូនេស៊ី ឱ្យ មាន ការរីកចម្រើន ថែម មួយ កម្រិត ទៀត ។ បេសកកម្ម ការ ទូត របស់ លោក នៅ កម្ពុជា ពិតជា បាន បង្ក លក្ខណៈ សម្បត្តិ កាន់តែ ប្រសើរ ថែម ទៀត ក្នុង ការលើកស្ទួយ វឌ្ឍនភាព នៃ ចំណង ការទូត រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ មាន សន្ទុះ ខ្លាំងក្លា មួយ កម្រិត ទៀត ។
កម្ពុជា - ឥណ្ឌូនេស៊ី មាន ទំនាក់ទំនង ការទូត ជាមួយគ្នា ជាង ៦០ ឆ្នាំ មកហើយ ហើយ ថ្នាក់ដឹកនាំ របស់ យើង តែង បាន ធ្វើ ការផ្លាស់ប្តូរ ទស្សនកិច្ច ទៅ វិញ ទៅ មក ដើម្បី ពង្រឹង ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ជាច្រើន វិស័យ ។
សម្តេច ប្រធាន រដ្ឋសភា បាន លើកឡើង ថា រដ្ឋសភា កម្ពុជា ពេញចិត្ត និង អបអរសាទរ ចំពោះ សមិទ្ធផល ទំាង ឡាយ ដែល រដ្ឋាភិបាល នៃ ប្រទេស ទំាង ពីរ សម្រេចបាន ដែល ពិតជា បាន នំាមក នូវ ផលប្រយោជន៍ ដល់ ប្រជាជាតិ ទំាង សងខាង ។ ដោយឡែក នៅក្នុង ក្របខណ្ឌ ស្ថាប័ន នីតិប្បញ្ញត្តិ ក៏ មាន កិច្ចសហប្រតិបត្តិការ ល្អ ជាមួយគ្នា តាមរយៈ ការផ្លាស់ប្តូរ ទស្សនកិច្ច សិក្សា ស្វែងយល់ លើ ការងារ នីតិកម្ម និង ការគាំទ្រ គ្នា ទៅ វិញ ទៅ មក នៅលើ វេទិកា អន្តរសភា រវាង រដ្ឋសភា នៃ ប្រទេស ទំាង ពីរ ។
ឆ្លៀត ឱកាស នេះ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន បាន ថ្លែងអំណរគុណ រដ្ឋាភិបាល ឥណ្ឌូនេស៊ី ដែល បាន រួមចំណែក ក្នុង ដំណើរការ ក សាង សន្តិភាព និង ការអភិវឌ្ឍ នៅ កម្ពុជា តាមរយៈ ជំនួយ អភិវឌ្ឍន៍ ធនធាន មនុស្ស ការលើកកម្ពស់ សមត្ថភាព កងទ័ព ជំនួយ ផ្នែក អាកាសចរណ៍ ស៊ីវិល និង ជំនួយ មនុស្សធម៌ ផ្សេង ៗ ច្រើន ទៀត នា ពេល កន្លងមក នេះ ៕ សម្ដេច ក្រឡាហោម ស ខេង ដាក់ បញ្ជា ឱ្យ ទប់ស្កាត់ - បង្ក្រាប អ្នក បំផ្លាញ និង ជួញដូរ សម្បត្តិ បេតិកភណ្ឌ និង លើកទឹកចិត្ត អ្នក ដែល ស្ម័គ្រចិត្ត ចូលរួម ទប់ស្កាត់ - ការពារ
( សៀមរាប ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បាន ដាក់ អនុសាសន៍ ណែនាំ បទបញ្ជា ទៅកាន់ អាជ្ញាធរ និង កងកម្លាំង មាន សមត្ថកិច្ច ត្រូវ បង្កើន ការ ទប់ស្កាត់ ជន ទុច្ចរិត ដែល បំផ្លិចបំផ្លាញ កាប់ កកាយ និង ជួញដូរ សម្បត្តិ បេតិកភណ្ឌ និង លើកទឹកចិត្ត អ្នក ដែល ស្ម័គ្រចិត្ត ចូលរួម ទប់ស្កាត់ ការពារ ក៏ ដូចជា ស្ម័គ្រចិត្ត ប្រគល់ វត្ថុ បុរាណ ទាំងនោះ មក ឱ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច ដើម្បី ថែរក្សា ឡើងវិញ ។
សម្ដេច ក្រឡាហោម ស ខេង ថ្លែង យ៉ាង ដូច្នេះ ក្នុង ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ អគារ អង្គភាព នគរបាល ការពារ បេតិកភណ្ឌ ប្រចាំ តំបន់ អង្គរ ស្ថិត នៅក្នុង ភូមិ គោក តា ចាន់ សង្កាត់ គោក ចក ក្រុង សៀមរាប នា ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ ។
សម្ដេច ក្រឡាហោម បាន ណែនាំ បន្ត ថា អង្គភាព នគរបាល ការពារ បេតិកភណ្ឌ ត្រូវ ពិនិត្យ និង រៀបចំ កំណត់ ទីតាំង ឈរជើង ការពារ អាទិភាព ជាថ្មី និង ការចល័ត យាម ល្បាត ជា អចិន្ត្រៃយ៍ ជាពិសេស នៅ ពេល យប់ តាម ចំណុច សំខាន់ ៗ នៃ តំបន់ រមណីយដ្ឋាន អង្គរ និង តំបន់ ពាក់ព័ន្ធ ផ្សេង ទៀត ។
ចំពោះ អង្គភាព នគរបាល ការពារ បេតិកភណ្ឌ គឺ ត្រូវ បង្កើន ការអប់រំ ពង្រឹង សីលធម៌ វិន័យ កងកម្លាំង និង មនសិការ វិជ្ជាជីវៈ ស្រលាញ់ បេតិកភណ្ឌ វប្បធម៌ ជាតិ សំដៅ បង្ការ និង កាត់បន្ថយ ឱ្យ បាន ដាច់ខាត នូវ អំពើ អនាធិបតេយ្យ នានា ក្នុង តំបន់ រមណីយដ្ឋាន អង្គរ និង តំបន់ ផ្សេង ៗ ទៀត តាមរយៈ ការអនុវត្ត នូវ វិន័យ ច្បាស់លាស់ ព្រមទាំង វិធានការ ច្បាប់ នានា ប្រកបដោយ តម្លាភាព និង យុត្តិធម៌ ជាដាច់ខាត ។ នេះ បើ តាម ការបន្ថែម របស់ សម្ដេច ក្រឡាហោម ស ខេង ។
ក្រៅពី នេះ អង្គភាព នគរបាល ការពារ បេតិកភណ្ឌ ត្រូវ បន្ត ពង្រឹង កិច្ចសហការ ជាមួយ កម្លាំង មាន សមត្ថកិច្ច និង អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ ក្នុង កិច្ចការពារ សុវត្ថិភាព សន្តិសុខ និង រក្សា របៀបរៀបរយ សណ្តាប់ធ្នាប់ សាធារណៈ ជាពិសេស កិច្ចការពារ សុវត្ថិភាព សន្តិសុខ ភ្ញៀវ ជាតិ និង អន្តរជាតិ ដែល មក បំពេញ បេសកកម្ម ធ្វើ ទស្សនកិច្ច ឬ ធ្វើ ទេសចរណ៍ ក្នុង តំបន់ រមណីយដ្ឋាន អង្គរ សៀមរាប និង តំបន់ ផ្សេង ៗ ។
សម្ដេច ក្រឡាហោម បាន បន្ថែម ទៀត ថា អាជ្ញាធរ ខេត្ត សៀមរាប អាជ្ញាធរ ជាតិ អប្សរា អង្គភាព នគរបាល ការពារ បេតិកភណ្ឌ និង ស្ថាប័ន ពាក់ព័ន្ធ ត្រូវ បន្ត ខិតខំ ថែរក្សា បរិស្ថាន ធម្មជាតិ ដែល ជា ផ្នែក មួយ នៃ ទេសភាព វប្បធម៌ របស់ រមណីយដ្ឋាន អង្គរ តាមរយៈ ការដាំ ដើមឈើ ឡើងវិញ បង្កើន ភាព បៃតង បន្ត ស្តារ ប្រព័ន្ធ ធារាសាស្រ្ត បុរាណ ដើម្បី ពង្រឹង កិច្ចការ អភិរក្ស ក៏ ដូចជា បង្កើត បាន នូវ ផាសុកភាព សម្រាប់ ប្រជាពលរដ្ឋ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ លម្ហែ និង កម្សាន្ត ។
លើស ពី នេះ សម្ដេច ក្រឡាហោម ស ខេង ក៏ បាន ផ្ដល់ អនុសាសន៍ ទៅកាន់ អាជ្ញាធរ ខេត្ត សៀមរាប និង អង្គភាព នគរបាល ការពារ បេតិកភណ្ឌ ត្រូវ បន្ត ចូលរួម និង ទំនាក់ទំនង ជាមួយ អង្គការ យូណេស្កូ និង អង្គការ អន្តរជាតិ នានា ដើម្បី ទទួល ការណែនាំ និង ការផ្សព្វផ្សាយ គោលការណ៍ ផ្សេង ៗ សំដៅ បម្រើ ឱ្យ ការងារ ការពារ បេតិកភណ្ឌ វប្បធម៌ ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៤៣ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១៧ ខែមករា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៤៣ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង៤៣ នាក់ នោះ មាន ១១នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្ន បទល្មើស ព្រហ្មទណ្ឌ ០៩ ករណី និង ជនសង្ស័យ ៣២ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ០៨ ករណី ។
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បេក្ខភាព នាយក រដ្ឋមន្ត្រី បន្ត វេន របស់ កម្ពុជា មកពី គណបក្ស ប្រជាជន កម្ពុជា បាន លើកឡើង ថា ការធ្វើឱ្យ សង្គម រីកចម្រើន ហើយ ប្រជាពលរដ្ឋ មាន ជីវភាពល្អ ប្រសើរ គឺជា កេរ ដំណែល និង ជា គោលដៅ ដ៏ ធំ បំផុត របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន គូស រំលេច បែប នេះ ក្នុង ពេល ជួប ពិសារ អាហារ សាមគ្គី ជាមួយ ថ្នាក់ដឹកនាំ សហជីព កាលពី ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២៣ ។
តាមរយៈ វីដេអូ សម្រង់ សម្តី ដែល ទើប បង្ហោះ លើ ហ្វេសប៊ុក នៅ ព្រឹក ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២៣ នេះ បេក្ខភាព នាយក រដ្ឋមន្ត្រី បន្ត វេន ដ៏ មាន ប្រជាប្រិយភាព និង ពោរពេញ ដោយ សមត្ថភាព រូប នេះ បាន រំលឹក ថា ពី ការជួប ជាមួយ បណ្តា ទូត មួយចំនួន នៃ ប្រទេស ជា មិត្ត ហើយ បាន និយាយ ដល់ ដំណើរ វិវឌ្ឍន៍ នៃ សង្គម កម្ពុជា ។
បើ តាម លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ក្នុង ជំនួប ទាំងនោះ លោក បាន លើកឡើង ថា សង្គម កម្ពុជា នា ពេល បច្ចុប្បន្ន មិន ទាន់ រីកចម្រើន ដូច អាមេរិក និង បណ្តា ប្រទេស នានា នៅ លោក ខាងលិច ។ ប៉ុន្តែ បើ មើល កម្ពុជា នា ទសវត្សរ៍ ៨០ និង ៩០ ជាមួយ ពេល បច្ចុប្បន្ន មាន ការខុសគ្នា ឆ្ងាយ ណាស់ ។
ក្រៅតែ រំលឹក ដល់ ការជជែក ជាមួយ មន្ត្រី នៃ បណ្តា ប្រទេស ជា មិត្ត ហើយ នោះ នៅ ចំពោះមុខ ថ្នាក់ដឹកនាំ សហជីព ទាំង ក្នុង និង ក្រៅ ប្រព័ន្ធ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បេក្ខភាព នាយក រដ្ឋមន្ត្រី ដែល បញ្ចប់ ការសិក្សា ផ្នែក យោធា នយោបាយ និង សេដ្ឋកិច្ច ក៏ បាន លើក បង្ហាញ ពី គោល នយោបាយ ដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក បណ្ឌិត បាន បញ្ជាក់ ថា គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា គឺ ធ្វើឱ្យ សង្គម រីកចម្រើន និង ជីវភាព របស់ ប្រជាពលរដ្ឋ មាន ភាពល្អ ប្រសើរ ។
លោក បណ្ឌិត បាន បញ្ជាក់ បែប នេះ « កេរ ដំណែល របស់ កម្ពុជា មិន មាន អ្វី ក្រៅពី ការកសាង សង្គម មួយ រីកចម្រើន ផ្អែក លើ មូលដ្ឋាន គោលដៅ ធ្វើឱ្យ ប្រជាពលរដ្ឋ គ្រប់ ក្រុម គ្រប់ រូប មាន បាន ជីវភាព កាន់តែ ធូរធារ ហ្នឹង ជា មូលដ្ឋាន និង កេរ ដំណែល របស់ គណបក្ស ប្រជាជន កម្ពុជា » ។
បេក្ខភាព នាយក រដ្ឋមន្ត្រី បន្ត វេន ពោរពេញ ដោយ ថាមពល រូប នេះ ក៏ បាន លើក បង្ហាញ ដែរ ថា គោល នយោបាយ របស់ កម្ពុជា គឺ ប្រឹងប្រែង បង្កើត ការងារ ជូន ប្រជាពលរដ្ឋ តាមរយៈ ការវិនិយោគ នានា ។ បន្ថែម ពីលើ នោះ បាន ដាក់ចេញ នយោបាយ ជាច្រើន ទៀត ដើម្បី គាំពារ ដល់ កម្មករ និយោជិត ឱ្យ ទទួលបាន ប្រាក់ ឈ្នួល កាន់តែ ខ្ពស់ ជីវភាព កាន់តែ ប្រសើរ ។
សូម បញ្ជាក់ ថា មកដល់ ឆ្នាំ ២០២៣ នេះ មាន រយៈពេល ៤៤ ឆ្នាំ ហើយ ដែល គណបក្ស ប្រជាជន កម្ពុជា បាន ដឹកនាំ ប្រទេស កម្ពុជា ក្រោយពេល រំដោះ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។ រយៈពេល ៤៤ ឆ្នាំ ក្រោម មាគ៌ា ដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី ៣៨ ឆ្នាំ បាន ធ្វើឱ្យ កម្ពុជា រក បាន សុខ សន្តិភាព ការឯកភាព ជាតិ រក្សា បាន ស្ថេរភាព សង្គម ព្រមទាំង បាន ធ្វើឱ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ។
សេដ្ឋកិច្ច ជាតិ រក្សា បាន ក្នុង កំណើន ប្រមាណ ៧ភាគ រាយ រយៈពេល ជាង ២០ ឆ្នាំ មុន ការមកដល់ នៃ ជំងឺ កូវីដ១៩ ធ្វើឱ្យ កម្ពុជា ចាក ផុត ពី ឋានៈ ប្រទេស ក្រីក្រ មក ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ទាប ។ ជីវភាព កាន់តែ ល្អ ប្រសើរ ពលរដ្ឋ កម្ពុជា ដែល រស់ នៅ ក្រោម បន្ទាត់ ភាពក្រីក្រ ១០០ ភាគរយ ក្រោយពេល រំដោះ នោះ ត្រូវបាន លុបបំបាត់ ជា បន្តបន្ទាប់ ហើយ បច្ចុប្បន្នសល់ ត្រឹម ប្រមាណ ១០ភាគរយ ប៉ុណ្ណោះ ៕
ក្រសួង ធនធាន ទឹក បាន បញ្ជាក់ ថា ទ្រនុង នៃ សម្ពាធ ខ្ពស់ ( ចិន ) និង ខ្យល់ មូសុង ឦសាន្ត បក់ ក្នុង ល្បឿន ពី មធ្យម ទៅ បង្គួរ បន្ត មាន ឥទ្ធិពល មក លើ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង អំឡុង មួយ សប្តាហ៍ ខាងមុខ នេះ ។ ស្ថានភាព បែប នេះ នឹង ធ្វើ ឲ្យ៖
ជាមួយគ្នា នេះ ក្រសួង ធនធាន ទឹក បាន អំពាវនាវ ដល់ សាធារណជន បង្កើន ការប្រុងប្រយ័ត្ន ចំពោះ ស្ថានភាពចុះ ត្រជាក់ ៕ ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃអង្គារ ទី១៧ ខែមករា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ១៖ តួកគី ប្រាប់ ស៊ុយអែត និង ហ្វាំងឡង់ ឱ្យ ប្រគល់ ខ្លួន ភេរវករ ១៣០ នាក់ បើ ចង់បាន ការអនុម័ត ចូល NATO
២៖ រដ្ឋមន្ត្រី ការបរទេស អាល្លឺម៉ង់ គាំទ្រ ឱ្យ បង្កើត « តុលាការ ពិសេស » ដើម្បី កាត់ទោស មេដឹកនាំ រុស្ស៉ី
៥៖ ប្រធាន សភា អឺរ៉ុប សន្យា ធ្វើ កំណែទម្រង់ ជាច្រើន ក្រោយ មាន ការស៉ើប អង្កេត រឿង អាស្រូវ ពុករលួយ
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្តីណែនាំ ក្រើន រំលឹក ស្តីពី ការការពារ ការចម្លង វីរុស កូវីដ - ១៩ ជំងឺ ផ្តាសាយ បក្សី និង ការបង្ការ ការ ពុល ចំណីអាហារ ឬ ពុល ស្រា ស ដែល រៀបចំ មិន ត្រឹមត្រូវ នា ឱកាស រៀបចំ សែន ដូនតា និង ឱកាស ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ខាងមុខ នេះ ៕
ខាងក្រោម នេះ ជា សេចក្តីក្រើន រំលឹក របស់ ក្រសួង សុខាភិបាល៖ វិភាគ អន្តរជាតិ៖ ការវិលត្រឡប់ នៃ « គ្រួសារ ស៉ីន ណា វ៉ាត់ » ក្នុង នយោបាយ ថៃ ?
ក្រុម យោធា នៅក្នុង ប្រទេស ថៃ បាន ប្រើប្រាស់ គ្រប់ មធ្យោបាយ ដើម្បី កម្ចាត់ ឥទ្ធិពល និង ប្រជាប្រិយភាព នៃ គ្រួសារ ស៉ីន ណា វ៉ាត់ ។ ជា ការពិត ណាស់ យោធា ថៃ មិន អាច បន្សាប ប្រជាប្រិយភាព របស់ គ្រួសារ ស៊ីន ណា វ៉ាត់ នៅក្នុង ចំណោម ប្រជាជន ថៃ ជាពិសេស ប្រជាជន រស់ នៅ តាម ទី ជនបទ បាន ឡើយ ប៉ុន្តែ យ៉ាងហោចណាស់ ពួកគេ បាន ប្រើប្រាស់ ច្បាប់ ដើម្បី រារាំង ការវិលត្រឡប់ មកកាន់អំណាច សា ជា ថ្មី របស់ គ្រួសារ ស៊ីន ណា វ៉ាត់ តាមរយៈ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ ។
ក្រសួង បរិស្ថាន ត្រួតពិនិត្យ ការងារ ឆ្នាំ ២០២២ និង លើក ទិសដៅ ឆ្នាំ ២០២៣ សម្រាប់ មន្ទីរ បរិស្ថាន ខេត្ត រតគិរី
( រតនគិរី ) ៖ ក្រសួង បរិស្ថាន នា ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ បាន រៀបចំ កិច្ចប្រជុំ ត្រួតពិនិត្យ វឌ្ឍនភាព ការងារ ឆ្នាំ ២០២២ និង លើក ទិសដៅ អនុវត្ត បន្ត ឆ្នាំ ២០២៣ សម្រាប់ មន្ទីរ បរិស្ថាន ខេត្ត រតគិរី ក្រោម អធិបតីភាព លោក ផៃ ប៊ុន ឈឿន រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង បរិស្ថាន ។
ក្នុង ឱកាស នោះ លោក ផៃ ប៊ុន ឈឿន បាន ប្រគល់ នូវ សម្ភារៈ ជូន មន្ទីរ បរិស្ថាន ខេត្ត រួម មាន អង្រឹង ម៉ុង ប៉ារ៉ា ស្បែកជើង អាវ ភ្លៀង អាវ រងារ សាក់កាដូ តង់ កៅស៊ូ កាមែល ថ្នាំ ពេទ្យ សរុប ចំនួន ១៩ ឈុត ផងដែរ ៕
កប៉ាល់ ដឹក ប្រេង ផ្ទុះ បាន ផ្តាច់ ជីវិត មនុស្ស យ៉ាងតិច ៣នាក់ ខណៈ រាប់ សិប នាក់ ទៀត រងរបួស នៅ ភាគ កណ្តាល ប្រទេស ថៃ
( បាងកក) ៖ នាយកដ្ឋាន ដែន សមុទ្រ នៃ ក្រសួង ដឹកជញ្ជូន ថៃ បាន និយាយ ថា ករណី ផ្ទះ កប៉ាល់ ដឹក ប្រេង មួយ នៅ ខេត្ត សាមុត សុង ខាំ ស្ថិត ភាគ កណ្តាល ប្រទេស ថៃ បាន ផ្តាច់ ជីវិត មនុស្ស យ៉ាងហោចណាស់ ចំនួន ០៣ នាក់ និង រាប់ សិប នាក់ ទៀត រងរបួស ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃអង្គារ ទី១៧ ខែមករា ឆ្នាំ ២០២៣ ។
អាជ្ញាធរ បាន គូសបញ្ជាក់ ថា កប៉ាល់ ដែល បាន ផ្ទុះ នេះ ផ្ទុក ប្រេង ប្រមាណ ៣០.០០០លីត្រ នៅពេល វា ជួប ហេតុការណ៍ នេះ ។
ក្នុង ហេតុការណ៍ ដ៏ គួរឲ្យ រន្ធត់ នេះ បាន ផ្តាច់ ជីវិត មនុស្ស ចំនួន ០៣ នាក់ និង រងរបួស យ៉ាងហោចណាស់ ១០នាក់ ។ ប៉ុន្តែ អគ្គិភ័យ បាន រលត់ ទាំងស្រុង ហើយ ខណៈ ដែល ក្រុម អ្នក ជួយសង្គ្រោះ កំពុង បង្កើន ការស្វែងរក អ្នករបួស និង បាត់ខ្លួន ។
មូលហេតុ នៃ ឧប្បត្តិហេតុ នេះ អាជ្ញាធរ បាន ដាក់ ការសង្ស័យ ថា ដោយសារតែ កប៉ាល់ នេះ នៅ ពេល ដែល ជួសជុល មិន ត្រូវបាន សម្អាត ឲ្យ ស្អាត ល្អ និង មិន បាន ចាក់ ប្រេង ចេញ ក្រៅ អស់ ។ ទោះជា យ៉ាង ការស៊ើបអង្កេត លើ រឿង នេះ កំពុង ដំណើរការ នៅឡើយ ហើយ លទ្ធផល បឋម នឹង ត្រូវ ប្រកាស ក្នុង រយៈពេល ១០ ថ្ងៃ ៕
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣
១៖ ក្រសួង សុខាភិបាល៖ ថ្ងៃ នេះ បន្ត រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ១នាក់ ខណៈ អ្នក ជាសះស្បើយ ៦នាក់
២៖ ប្រធាន សភា អឺរ៉ុប សន្យា ធ្វើ កំណែទម្រង់ ជាច្រើន ក្រោយ មាន ការស៉ើប អង្កេត រឿង អាស្រូវ ពុករលួយ
៣៖ សម្តេច តេជោ ហ៊ុន សែន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ដល់ កម្ពុជា វិញ ហើយ ក្រោយ បញ្ចប់ ដំណើរទស្សនកិច្ច ផ្លូវការ នៅ សាធារណរដ្ឋ ម៉ាល់ ឌីវ ប្រកបដោយ ផ្លែផ្កា ខ្ពស់
៥៖ កម្ពុជា - ម៉ាល់ ឌីវ ចេញ សេចក្តីថ្លែងការណ៍ ១៩ ចំណុច ជុំវិញ ទស្សនកិច្ច ផ្លូវការ របស់ សម្តេច តេជោ ហ៊ុន សែន
៦៖ អ្នកឃ្លាំមើល អង្គ សហ ប្រជាជាតិ មាន សុទិដ្ឋ និយម ចំពោះ ការការពារ រោងចក្រ នុយក្លេអ៊ែរ អ៊ុយក្រែន
៧៖ កម្ពុជា - ម៉ាល់ ឌីវ ប្ដេជ្ញា ពង្រឹង កិច្ចសហប្រតិបត្តិការ វិស័យ ទេសចរណ៍ ដោយ ផ្ដើម ចេញ ពី កិច្ចការ ៦ចំណុច
៨៖ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក គ្រោង នឹង បំពេញ ទស្សនកិច្ច ទៅកាន់ ទីក្រុង ប៉េកាំង នៅ ដើម ខែ ក្រោយ
៩៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់៖ បាលី ដ៏ ស័ក្តិសិទ្ធ ក្នុង ការរក្សា សន្តិភាព គឺ ពលរដ្ឋ រួមគ្នា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា
១០៖ ចំនួន ប្រជាជន ចិន ថយចុះ ខណៈ ឥណ្ឌា ត្រូវ គេ ព្យាករ ថា នឹង ក្លាយជា ប្រទេស មាន ប្រជាជន ច្រើន ជាង គេ នៅលើ ពិភពលោក ក្នុង ពេល ៣ខែ ទៀត
១១៖ សម្តេច តេជោ ហ៊ុន សែន សម្រេច ឲ្យ កសាង ផ្លូវ ២ខ្សែ នៅ ភ្នំពេញ ដាក់ ឈ្មោះ ថ្នាក់ដឹកនាំ ឥណ្ឌូនេស៊ី
១២៖ ឡេតូនី ជំរុញ ឲ្យ លោក ខាងលិច បង្កើន ជំនួយ យោធា សម្រាប់ អ៊ុយក្រែន ត្រៀម ទប់ទល់ នឹង ការវាយលុក សា ជា ថ្មី ពី រុស្ស៉ី
នាយក រដ្ឋមន្រ្តី ប៉ាគីស្ថាន បបួល សមភាគី ឥណ្ឌា អង្គុយ ពិភាក្សា ទល់ មុខ គ្នា ដើម្បី ព្យាយាម ដោះស្រាយ បញ្ហា សំខាន់ ៗ
អាវុធហត្ថ រាជធានី ភ្នំពេញ គាំទ្រ ចក្ខុវិស័យ សាលា ដូង លើ កំពូល ភ្នំ គីរីរម្យ ខេត្ត កំពង់ស្ពឺ
សាលារៀន នេះ ត្រូវបាន បង្កើតឡើង និង គ្រប់គ្រង ដោយ លោក អ៊ុក វ៉ាន់ ដេ ដែល មនុស្ស ទូទៅ បាន ស្គាល់ លោក ថា ជា អ្នក ចម្បាំង សំរាម ដែល មាន ន័យ ថា « ការយក សំរាម មក កែច្នៃ ឱ្យ ក្លាយទៅ របស់ មាន តម្លៃ និង មាន ប្រយោជន៍ » ដូច ជា៖ ដប ប្លាស្ទិក ដប ស្រាបៀរ បំពង់ បឺត គម្រប ដប ទឹក សុទ្ធ កង់ ឡាន ធុង ហ្គាស ឡាន និង សំណល់ ផ្សេង ៗ ទៀត ត្រូវបាន យកមក កែច្នៃ បង្កើត ជា បន្ទប់ សិក្សា រូប លម្អ និមិត្ត សញ្ញា និង វត្ថុអនុស្សាវរីយ៍ ជាច្រើន ។
ប្អូន ៗ កុមារ សិស្សសាលា ដូង នេះ មាន ពី ថ្នាក់ ទី១ ដល់ ថ្នាក់ ទី៣ កំពុង ទទួលបាន ការអប់រំ និង បញ្ជ្រាប ការយល់ដឹង ទាក់ទង នឹង សំរាម ដែល អាច ប្រើប្រាស់ ឡើងវិញ បាន ក្នុង គោលបំណង កាត់បន្ថយ ប្លាស្ទិក នៅ ថ្ងៃ អនាគត ។
រីឯ ដំណើរ នាំយក អំណោយ របស់ អាវុធហត្ថ រាជធានី ភ្នំពេញ ទៅកាន់ សាលា ដូង លើ កំពូល ភ្នំ គីរីរម្យ ខេត្ត កំពង់ស្ពឺ នា ពេលនេះ គឺ ដើម្បី គាំទ្រ នូវ ទស្សនៈ វិស័យ របស់ សាលា ដូង និង បង្ហាញ ពី ក្តីស្រឡាញ់ ចំពោះ វិស័យ អប់រំ ដែល ជា ដង្ហើម នៃ ការចេះដឹង របស់ កុមារ រស់ នៅ លើ ភ្នំ គីរីរម្យ នេះ ផងដែរ ៕ សម្តេច តេជោ ហ៊ុន សែន អបអរសាទរ ចៅ ស្រី ច្បង ក្រោយ ទទួល សញ្ញាបត្រ ថ្នាក់ បរិញ្ញាបត្រ និង កំណត់ គោលដៅ ខ្ពស់ បំផុត ឲ្យ ចៅ ៗ ទាំងអស់ បញ្ចប់ ថ្នាក់ បណ្ឌិត
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ យប់ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន អបអរសាទរ ចៅ ស្រី ច្បង ( កូនស្រី លោកស្រី ហ៊ុន ម៉ាណា ) ក្រោយ ទទួល សញ្ញាបត្រ ថ្នាក់ បរិញ្ញាបត្រ និង បាន កំណត់ គោល ទាប បំផុត សម្រាប់ ចៅ ៗ ទាំងអស់ ត្រូវ បញ្ចប់ ថ្នាក់ អនុបណ្ឌិត និង គោលដៅ ខ្ពស់ បំផុត គឺ ថ្នាក់ បណ្ឌិត ។
( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ១៩ ខែមករា ឆ្នាំ ២០២៣ ខាងមុខ នេះ នឹង អញ្ជើញ ពិនិត្យមើល វឌ្ឍនភាព នៃ ការសាងសង់ អគារ មន្ទីរពេទ្យ « តេជោ សន្ដិភាព » ដែល មាន ទីតាំង ស្ថិត នៅ សង្កាត់ គោក រកា ខណ្ឌ ព្រែក ព្នៅ រាជធានី ភ្នំពេញ ព្រមទាំង សំណេះសំណាល ជាមួយ កម្មករ សំណង់ នៅក្នុង ការដ្ឋាន មន្ទីរពេទ្យ នេះ ប្រមាណ ១. ២០០ នាក់ ។
ជាក់ស្ដែង នៅ ល្ងាច ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង លោកស្រី យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ដឹកនាំ មន្ត្រី ជំនាញ មន្ទីរ ពាក់ព័ន្ធ ចុះ ពិនិត្យ ការដ្ឋាន សាងសង់ មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព នៅ សង្កាត់ គោក រកា ខណ្ឌ ព្រែក ព្នៅ ដើម្បី ត្រៀម រៀបចំ កម្មវិធី ក្រោម អធិបតីភាព របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ។
លោក ឃួង ស្រេង ក្នុង ឱកាស នោះ បាន ណែនាំឲ្យ លោក សាំ ពិសិដ្ឋ ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ បើក សួនច្បារ ទ្រូង មហាវិថឺ ឈ្នះ ឈ្នះ មុខ មន្ទីរពេទ្យ នោះ ទំហំ ១២០ ម៉ែត្រ និង ដាក់ លូខ្នាត ធំ អម សងខាង អគារ មន្ទីរពេទ្យ ភ្ជាប់ ទៅ ប្រឡាយ ៧០ម៉ែត្រ ក្រោយ អគារ ដើម្បី បើក ផ្លូវ ចូល មន្ទីរពេទ្យ និង ដើម្បី រំដោះ ទឹក ចេញ ពី បរិវេណ មន្ទីរពេទ្យ នេះ ។
« មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព » នឹង ក្លាយជា មន្ទីរពេទ្យ ជាតិ ធំ ជាង គេ នៅ ប្រទេស កម្ពុជា ដែល នឹង ផ្ដល់ នូវ សេវា គ្រប់ ផ្នែក ទាំងអស់ ជូន ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ។ ក្នុង ករណី មាន ជំងឺ ឆ្លង លក្ខណៈ ទ្រង់ទ្រាយ ធំ មន្ទីរពេទ្យ ជាតិ ដ៏ ធំ មួយ នេះ អាច មាន លទ្ធភាព ទទួល អ្នកជំងឺ ដោយ មិន មាន ការព្រួយបារម្ដ នោះ ទេ ដោយ មន្ទីរពេទ្យ នេះ បំពាក់ សម្ភារៈ បរិក្ខារ វេជ្ជសាស្ត្រ ទំនើប ៗ ស្រប តាម លក្ខណៈ ស្តង់ដារ ៕
NATO នឹង ដាក់ពង្រាយ យន្តហោះ ឈ្លប យក ការណ៍ ក្នុង ប្រទេស រ៉ូម៉ានី ដើម្បី តាមដាន សកម្មភាព យោធា របស់ រុស្ស៉ី
( ប៊ូឆារ៉េស ) ៖ ហោះហើរ ឈ្លប យក ការណ៍ របស់ អង្គការ សន្ធិសញ្ញា អាត្លង់ទិក ខាងជើង ដែល ហៅ កាត់ ថា ណា តូ ចំនួន ១៤ គ្រឿង ដែល កំពុង ឈរជើង នៅ ប្រទេស អាល្លឺម៉ង់ នឹង ត្រូវ បញ្ជូន ទៅកាន់ ប្រទេស រូម៉ានី នៅ ថ្ងៃអង្គារ នេះ ដើម្បី ជួយ ពង្រឹង សម្ព័ន្ធ យោធា របស់ ខ្លួន នៅ ភាគ ខាងកើត និង ជាពិសេស ដើម្បី តាមដាន សកម្មភាព យោធា របស់ រុស្ស៉ី ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃអង្គារ ទី១៧ ខែមករា ឆ្នាំ ២០២៣ ។
អង្គការ ណា តូ បាន ប្រកាស កាលពី សប្តាហ៍ មុន ថា ខ្លួន នឹង ដាក់ពង្រាយ យន្តហោះ ស៊ើបការណ៍ និង ប្រព័ន្ធ ព្រមាន លើ អាកាស (AWACS) នៅ ទីក្រុង ប៊ូឆារ៉េ ស នៃ ប្រទេស រ៉ូម៉ានី ជា ទី ដែល ពួកគេ នឹង ចាប់ផ្តើម ធ្វើ ការហោះហើរ ឈ្លប យក ការណ៍ លើ ដែន អាកាស របស់ ប្រទេស សមាជិក របស់ ខ្លួន ។
អ្នកនាំពាក្យ អង្គការ ណា តូ លោកស្រី Oana Lungescu បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ កាលពី ថ្ងៃទី ១២ ខែមករា នេះ យ៉ាង ដូច្នេះ ថា « នៅ ពេល ដែល សង្រ្គាម ខុស ច្បាប់ របស់ រុស្ស៊ី នៅ អ៊ុយក្រែន បន្ត គំរាមកំហែង ដល់ សន្តិភាព និង សន្តិសុខ នៅ ទូទាំង ទ្វីប អឺរ៉ុប ការប្តេជ្ញាចិត្ត របស់ អង្គការ ណា តូ ដើម្បី ការពារ ទឹកដី គ្រប់ អ៊ីញ របស់ សម្ព័ន្ធមិត្ត គឺជា រឿង ដែល មិន អាច ប្រកែក បាន ទេ » ។
គួរ បញ្ជាក់ ថា ចាប់តាំងពី រុស្ស៊ី បាន ឈ្លានពាន អ៊ុយក្រែន កាលពី ខែកុម្ភៈ ឆ្នាំ មុន មក អង្គការ ណា តូ បាន ពង្រឹង កម្លាំង យោធា ផ្លូវ អាកាស របស់ ខ្លួន កាន់តែ ខ្លាំង ឡើង នៅ អឺរ៉ុប ខាងកើត និង ជាពិសេស នៅ តំបន់ បាល់ ទិក ។ សកម្មភាព ទាំងនោះ រួមទាំង ការបញ្ជូន ទៅ ទីនោះ នូវ យន្តហោះ ចម្បាំង យន្តហោះ ឈ្លប យក ការណ៍ និង នាវា ដឹក ប្រេង ជាដើម ៕ សម្តេច តេជោ ហ៊ុន សែន តែងតាំង អ្នក ឧកញ៉ា យូ សាម៉េត ជា ប្រធាន ក្រុម ចុះ ជួយ កសាង ពង្រីក សមាជិក គណបក្ស នៅ មូលដ្ឋាន ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត នានា
ក្រុម ចុះ ជួយ កសាង ពង្រីក សមាជិក គណបក្ស នៅ មូលដ្ឋាន ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត នានា មាន ភារកិច្ច ចូលរួម សហការ ជាមួយ គណៈកម្មាធិការ គណបក្ស រាជធានី ខេត្ត ដែល មាន ការពាក់ព័ន្ធ ដើម្បី ធ្វើ ការងារ ចលនា កសាង ពង្រីក សមាជិក គណបក្ស ថ្មី នៅ តាម មូលដ្ឋាន ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត នានា ។
អ្នក ឧកញ៉ា បណ្ឌិត យូ សាម៉េត បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ដែល សម្តេច បាន ផ្តល់ ទំនុកចិត្ត តែងតាំង លោក ជា ប្រធាន ក្រុម មួយ នេះ ។ លោក ប្តេជ្ញាចិត្ត ថា នឹង ខិតខំ ប្រឹងប្រែង បន្ថែម ទៀត ដើម្បី ពង្រីក សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ឲ្យបាន កាន់តែ ច្រើន ផងដែរ ដើម្បី ភាពរឹងមាំ នៃ គណបក្ស ទាំងមូល ៕
ទីក្រុង កៀវ អះអាង ថា ជន ស៉ី វិល ជាង ៩.០០០ នាក់ ស្លាប់ នៅ អ៊ុយក្រែន ចាប់តាំងពី ការឈ្លានពាន របស់ រុស្ស៉ី
( ដាវ៉ូស ) ៖ ទីប្រឹក្សា ជាន់ ខ្ពស់ ម្នាក់ របស់ ប្រធានាធិបតី អ៊ុយក្រែន បាន អះអាង នៅ ថ្ងៃអង្គារ នេះ ថា ជន ស៉ី វិល សរុប ជាង ៩.០០០ នាក់ ក្នុង នោះ រួម មាន កុមារ ៤៥៣ នាក់ ត្រូវបាន សម្លាប់ នៅ ប្រទេស អ៊ុយក្រែន គិត ចាប់តាំងពី ការឈ្លានពាន រុស្ស៉ី កាលពី ខែកុម្ភៈ ឆ្នាំ មុន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃអង្គារ ទី១៧ ខែមករា ឆ្នាំ ២០២៣ ។
លោក យើ ម៉ាក បាន បន្ត ថា អ៊ុយក្រែន នឹង មិន អត់ ទោស ចំពោះ ការធ្វើ ទារុណកម្ម ឬ ក៏ ការផ្តាច់ យក អាយុជីវិត ណាមួយ ឡើយ ហើយ ពួក ឧក្រិដ្ឋ ជន នីមួយ ៗ នឹង ត្រូវតែ ទទួល ទោស សម្រាប់ ទង្វើ របស់ ពួកគេ ខណៈ លោក នៅតែ សង្កត់ធ្ងន់ ពី គោលជំហរ ថា អ៊ុយក្រែន ចង់ឱ្យ មាន តុលាការ អន្តរជាតិ ពិសេស មួយ ដើម្បី បើក ដំណើរការ កាត់ទោស ក្រុម មេដឹកនាំ នយោបាយ រុស្ស៉ី និង ការផ្តល់ សំណង សម្រាប់ ការបំផ្លិចបំផ្លាញ ហិនហោច ដែល បង្កឡើង ដោយ ការឈ្លានពាន របស់ រុស្ស៉ី ។
គួរ បញ្ជាក់ ថា យោង តាម ទិន្នន័យ ពី ការិយាល័យ ឧត្តម ស្នងការ របស់ អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុក សិទ្ធិ មនុស្ស កាលពី ថ្ងៃចន្ទ សប្តាហ៍ នេះ គឺ ជន ស៉ី វិល ជាង ៧.០០០ នាក់ ត្រូវបាន សម្លាប់ នៅ អ៊ុយក្រែន ចាប់តាំងពី មាន ការឈ្លានពាន ដោយ រុស្ស៉ី ៕ ក្រសួង ការបរទេស ចិន ប្រកាស ស្វាគមន៍ គម្រោង ទស្សនកិច្ច របស់ រដ្ឋមន្រ្តី ការបរទេស អាមេរិក
លោក វ៉ាង បាន បន្ថែម ថា « ចិន ក៏ សង្ឃឹម ផងដែរ ថា សហរដ្ឋ អាមេរិក នឹង ប្រកាន់ យក នូវ ទស្សនៈ ត្រឹមត្រូវ មួយ ចំពោះ ចិន ហើយ ប្រកាន់ខ្ជាប់គោលការណ៍ សន្ទនា ជាជាង ប្រឈមមុខ ដាក់ គ្នា ក៏ ដូចជា គំនិត ឈ្នះ - ឈ្នះ ជាជាង គំនិត យកឈ្នះ ចាញ់ នឹង គ្នា » ។
( ប៉េកាំង ) ៖ ព្រឹក ថ្ងៃទី ១៦ ខែមករា លោក Xi Jinping អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ត ចិន ប្រធាន រដ្ឋ ចិន និង ជា ប្រធាន គណៈកម្មាធិការ យោធា មជ្ឈិម ចិន បាន ជួប សំណេះសំណាល ជាមួយ គណៈកម្មាធិការ មជ្ឈិម នៃ បណ្តា គណបក្ស ប្រជាធិបតេយ្យ នានា អ្នកទទួលខុសត្រូវ នៃ សមាគម ឧស្សាហកម្ម និង ពាណិជ្ជកម្ម ទូទាំង ប្រទេស ចិន តំណាង នៃ ឥស្សរជន មិន បាន ចូលរួម គណបក្ស ណាមួយ ព្រម និង អបអរសាទរ ថ្ងៃ បុណ្យ ចូលរួម ឆ្នាំ ថ្មី ប្រពៃណី ចិន នៅ វិមាន សភា ប្រជាជន ក្រុង ប៉េកាំង ។
លោក Xi Jinping បាន តាង នា គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ត ចិន សម្តែង ការអបអរសាទរ យ៉ាង កក់ក្តៅ ចំពោះ សមាជិក ថ្នាក់ដឹកនាំ ដែល ជាប់ ឆ្នោត ថ្មី នៃ គណៈកម្មាធិការ គណបក្ស ប្រជាធិបតេយ្យ នានា និង សមាគម ឧស្សាហកម្ម និង ពាណិជ្ជកម្ម ហើយ សួរសុខទុក្ខ យ៉ាង ស្មោះ និង ជូនពរ ឆ្នាំ ថ្មី ដល់ គណបក្ស ប្រជាធិបតេយ្យ នានា សមាគម ឧស្សាហកម្ម និង ពាណិជ្ជកម្ម ឥស្សរជន ដែល មិន បាន ចូលរួម គណបក្ស ណាមួយ និង សមាជិក នៃ រណសិរ្ស រួបរួម ។
ស្វែងរក វិជ្ជា កិត្តិយស មាន សេព គ្រឿងញៀន នាំមហន្ដរាយ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៧ ខែ មក រា៖ បង្ក្រាប ១៩ករណី ឃាត់ខ្លួន ៤៦ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៩ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៨ករណី . ជួញដូរ ៧ករណី និង ដឹកជញ្ជូន រក្សាទុក ៤ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៤៦ នាក់ ។
សន្និសីទ ព័ត៌មាន អំពី កម្មវិធី រាត្រី សមោស អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន ឆ្នាំ ២០២៣ ធ្វើ បទបង្ហាញ អំពី ការច្នៃប្រឌិត ថ្មី ខាង បច្ចេកវិទ្យា និង ចំណុច គួរឱ្យ ចាប់អារម្មណ៍ នៃ រាត្រី សមោស
ពេល ធ្វើ បទបង្ហាញ អំពី ចំណុច គួរឱ្យ ចាប់អារម្មណ៍ នៃ រាត្រី សមោស អ្នកទទួលខុសត្រូវ នៃ មជ្ឈមណ្ឌល កម្មវិធី សិល្បៈ នៃ CMG បាន ថ្លែង ថា រាត្រី សមោស អបអរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន ឆ្នាំ នេះ នឹង ប្រារព្ធ ឡើង ក្រោម បរិយាកាស សប្បាយរីករាយ និង សិរី មង្គល រំលេច ពី ប្រធានបទ ប្រទេស ចិន ក្នុង យុគសម័យ ថ្មី ដែល មាន ភាពរុងរឿង ជីវភាព រស់ នៅ ដែល ប្រសើរឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ដើម្បី បង្កើត បរិយាកាស សប្បាយរីករាយ ប្រកបដោយ ជំនឿ ចិត្ត និង ការខំប្រឹង តស៊ូ ៕
ឧត្តមសេនីយ៍ កំពូល អាមេរិក បង្ហាញ ខ្លួន នៅ ទីបញ្ជាការ យោធា ក្នុង ប្រទេស អាល្លឺម៉ង់ ដែល កំពុង ហ្វឹកហ្វឺន ដល់ កងទ័ព អ៊ុយក្រែន
លោក ឧត្តមសេនីយ៍ រូប នេះ បាន ទៅ ទស្សនកិច្ច ទី បញ្ជាការហ្រ្កាហ្វិនវៀ រយៈពេល ត្រឹមតែ ពីរ ម៉ោង ប៉ុណ្ណោះ កាលពី ថ្ងៃចន្ទ សប្តាហ៍ នេះ ដើម្បី ត្រួតពិនិត្យ ប្រតិបត្តិការ ហ្វឹកហ្វឺន ទាហាន អ៊ុយក្រែន និង គ្រូ ជនជាតិ អាមេរិក របស់ ពួកគេ ។ ក្នុង ពេល ជួប ជាមួយ មេបញ្ជាការ នៅ ទីនោះ លោក មីលលី បាន គូសបញ្ជាក់ ថា « នេះ មិន មែន គ្រាន់តែ ជា ការសាក កម្លាំង អាវុធ នោះ ទេ ។ តែ វា ជា ពេលវេលា មួយ ដែល យើង ចង់ ធ្វើឲ្យ មាន ការផ្លាស់ប្តូរ នោះ គឺ ការហ្វឹកហ្វឺន ដោយ ផ្ទាល់ » ។
ការធ្វើដំណើរ នេះ ក៏ ស្រប គ្នា នឹង ការពង្រីក កម្មវិធី ហ្វឹកហ្វឺន របស់ សហរដ្ឋ អាមេរិក សម្រាប់ កងទ័ព អ៊ុយក្រែន ខណៈ មួយ ថ្ងៃ មុន នេះ លោក មីលលី បាន និយាយ ថា មន្ទីរ បញ្ចកោណ រំពឹង ថា នឹង បញ្ចេញ ទាហាន ដែល ត្រៀម ប្រយុទ្ធ ចំនួន ៥០០ នាក់ ក្នុង រយៈពេល ៥ទៅ ៨ សប្តាហ៍ ខាងមុខ ។ កម្មវិធី នេះ នឹង ផ្តោត លើ ការហ្វឹកហ្វឺន អាវុធ រួមបញ្ចូល គ្នា ដែល សំដៅ លើ កិច្ចសហប្រតិបត្តិការ លើ សមរភូមិ រវាង កងទ័ព ថ្មើរជើង រថ ពាស ដែក កាំភ្លើង ធំ និង អង្គភាព អាកាស ។
