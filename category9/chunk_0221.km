( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ ធ្វើ ការដាំដុះ បន្លែ បន្ថែម ពីលើ ការធ្វើ ស្រែ ចម្ការ ដើម្បី ផ្គត់ផ្គង់ តម្រូវការ ទីផ្សារ ក្នុង ស្រុក ។ លោក ថា ការខិតខំ ដាំដុះ នេះ បាន ផ្តល់ នូវ ផល ចំណេញ ដោយ មិន ត្រឹមតែ សម្រាប់ បំពេញ តម្រូវការ ហូបចុក ក្នុង ក្រុមគ្រួសារ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ វា អាច លក់ ចេញ ទៅកាន់ ទីផ្សារ ដើម្បី ទទួលបាន ប្រាក់ ចំណូល បន្ថែម សម្រាប់ ផ្គត់ផ្គង់ ជីវភាព ក្រុមគ្រួសារ ជាង នេះ ទប់ទល់ បាន មួយចំណែក ក្នុង ស្ថានភាព កូវីដ១៩ រាលដាល នេះ ផង ។
ការជំរុញ បែប នេះ របស់ លោក អភិបាល ខេត្ត បាន ធ្វើឡើង គ្រា ដែល លោក ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យ ការដាំដុះ បន្លែ របស់ សហគមន៍ អម លាំង ស្ថិត ក្នុង ស្រុក ថ្ពង ខេត្ត កំពង់ស្ពឺ នា រសៀល ថ្ងៃទី ២៧ ខែមករា ឆ្នាំ ២០២៣ ។
អភិបាល ខេត្ត កំពង់ស្ពឺ បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង កសិកម្ម រួមទាំង រដ្ឋបាល ខេត្ត បាន លើកទឹកចិត្ត បងប្អូន ប្រជាកសិករ ឱ្យ ពង្រីក ការចិញ្ចឹម សត្វ ធ្វើ ស្រែ និង ដាំ ដំណាំ ផ្សេង ៗ ទៀត ដើម្បី ផ្គត់ផ្គង់ ដល់ ទីផ្សារ ពិសេស ទទួលបាន ប្រាក់ ចំណូល បន្ថែម ទៀត ។
លោក បាន លើកឡើង ថា « សព្វ ថ្ងៃ នេះ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង កសិកម្ម បាន ខិតខំ ប្រឹងប្រែង ក្នុង ការចងក្រង ឯកសារ ដើម្បី បណ្តុះបណ្តាល ដល់ សហគមន៍ កសិករ ហើយក៏ បាន ជួយ ផ្តល់ អ្នកជំនាញ ទៅ បណ្តុះបណ្តាល ដល់ មូលដ្ឋាន ផ្ទាល់ ផងដែរ ធ្វើ យ៉ាងម៉េច ឱ្យ ការដាំដុះ របស់ បងប្អូន ទទួលបាន ផល ច្រើន ចំណាយ តិច ហើយ មាន សុវត្ថិភាព ដល់ អ្នកប្រើប្រាស់ ក៏ ដូចជា អ្នក ដាំ ផ្ទាល់ និយាយ ជា រួម គឺ ឱ្យ កសិករ ធ្វើ ការដាំដុះ កាត់បន្ថយ ការប្រើប្រាស់ ជី គីមី » ។
ជុំវិញ ការលើកទឹកចិត្ត ឱ្យ មាន ការដាំដុះ នេះ លោក សួង វេង ប្រធាន សហគមន៍ ផ្សារ បន្លែ អម លាំង បាន លើកឡើង ថា លោក ក៏ ដូច សមាជិក សហគមន៍ បាន ធ្វើ ការដាំដុះ បន្លែ សុវត្ថិភាព រយៈពេល ៣ឆ្នាំ មកហើយ ។ ជីវភាព គ្រួសារ និង ការសិក្សា របស់ កូន ៗ មួយ ផ្នែក ធំ បាន ពឹងផ្អែក ទៅ លើ ការដាំដុះ នេះ ។
លោក បាន បន្ត ថា បច្ចុប្បន្ន ទីផ្សារ បន្លែ ល្អ ដាំ បាន គឺ ឈ្មួញ កណ្តាល ប្រមូល យក អស់ ៗ មាន ពេល ខ្លះ សហគមន៍ របស់ លោក សឹងតែ ផលិត មិន ទាន់ សម្រាប់ បំពេញ ទីផ្សារ ថែម ទៀត ផង ដោយ ក្នុង នោះ បន្លែ ទាំងអស់ ដែល ផលិត បាន ក្រៅតែ ពី លក់ ក្នុង មូលដ្ឋាន គឺ មួយចំនួន ធំ ត្រូវ នាំ ទៅ ផ្គត់ផ្គង់ ទីផ្សារ នៅឯ រាជធានី ភ្នំពេញ ពិសេស នៅ តាម ផ្សារ ទំនើប នានា ។
( ព្រះវិហារ ) ៖ អគារ រដ្ឋបាល និង សាល ប្រជុំ ថ្មី របស់ រដ្ឋបាល ស្រុក រវៀង ខេត្ត ព្រះវិហារ ជា គម្រោង របស់ ក្រសួង មហាផ្ទៃ ត្រូវបាន រៀបចំ ពិធី បញ្ចុះ បឋមសិលា សាងសង់ ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែមករា ឆ្នាំ ២០២៣ ដើម្បី ផ្តល់ ជា ទីកន្លែង សម្រាប់ បំពេញ ការងារ ជូន ប្រជាពលរដ្ឋ របស់ មន្ត្រី ឱ្យ កាន់តែ មាន ភាពងាយស្រួល បន្ថែម ទៀត ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក អ៊ុក គឹម សាន្ត អភិបាល រង ខេត្ត ព្រះវិហារ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ខេត្ត ចុះ មូលដ្ឋាន ស្រុក រវៀង តំណាង លោក គីម រិទ្ធី អភិបាល ខេត្ត ដោយ មាន ការចូលរួម ពី លោក ហោ ប៊ុន ហ៊ួរ អភិបាល ស្រុក រវៀង ព្រមទាំង ថ្នាក់ដឹកនាំ ស្រុក មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ជាច្រើន រូប ទៀត ។
លោក អ៊ុក គឹម សាន្ត បាន ថ្លែង ថា អគារ រដ្ឋបាល និង សាល ប្រជុំ ថ្មី របស់ រដ្ឋបាល ស្រុក រវៀង ដែល បញ្ចុះ បឋមសិលា សាងសង់ នៅ ពេល នេះ ជា គម្រោង របស់ ក្រសួង មហាផ្ទៃ ។
លោក ថា ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច ចក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ . អគារ រដ្ឋបាល តាម រាជធានី ខេត្ត និង ក្រុង ស្រុក ទូទាំង ប្រទេស ត្រូវបាន សាងសង់ ឡើង ជា បន្តបន្ទាប់ ដើម្បី សម្រួល ដល់ ការបំពេញ ភារកិច្ច របស់ មន្ត្រី ។
លោក អភិបាល រង ខេត្ត ព្រះវិហារ ក្នុង នាម ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក រវៀង បាន ថ្លែង ណែនាំ ដល់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ នៅ ស្រុក រវៀង ត្រូវ ខិតខំ បំពេញ តួនាទី ភារកិច្ច ឱ្យ កាន់តែ ខ្លាំងក្លា ថែម ទៀត ពិសេស លើ ការបំពេញ ការងារ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន លឿន ឱ្យ បាន រហ័ស តាម ដែល អាច ធ្វើ ទៅ បាន ស្រប តាម ការណែនាំ ពី លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ ក៏ ដូចជា ការណែនាំ របស់ ក្រសួង មហាផ្ទៃ និង រាជ រដ្ឋាភិបាល កម្ពុជា ។
សូម បញ្ជាក់ ថា នៅក្នុង ពិធី នេះ ក៏ មាន ការរៀបចំ សែន ព្រេន ដោយ រៀបចំ នូវ គ្រឿង សក្ការៈបូជា មាន ទៀន ធូប និង គ្រឿង បរិក្ខា ជាច្រើន មុខ ទៀត តាម ទំនៀមទំលាប់ ប្រពៃណី ដូនតា ដើម្បី សុំ សេចក្តីសុខ សប្បាយ ពី អ្នកតា ម្ចាស់ ទឹក ម្ចាស់ ដី ដល់ ក្រុម ជាង ដែល បាន នឹង កំពុង សាងសង់ អគារ រដ្ឋបាល និង សាល ប្រជុំ រដ្ឋបាល ស្រុក រវៀង នា ឱកាស នេះ ។
សហភាព អឺរ៉ុប ដែល មាន សមាជិក ចំនួន ២៧ ប្រទេស គឺជា ដៃគូ ពាណិជ្ជកម្ម ធំ ជាង គេ ទី បួន របស់ ប្រទេស ថៃ បន្ទាប់ពី ប្រទេស ចិន សហរដ្ឋ អាមេរិក និង ប្រទេស ជប៉ុន ។
ក្នុង ឆ្នាំ ២០២២ ទំហំ ពាណិជ្ជកម្ម រវាង ប្រទេស ថៃ និង សហភាព អឺរ៉ុប បាន កើនឡើង ដល់ ៤១ ពាន់ លាន ដុល្លារ អាមេរិក ដែល ស្មើនឹង ៧% នៃ ពាណិជ្ជកម្ម សរុប របស់ ប្រទេស ថៃ ។ នេះ បើ យោង តាម កាសែត បាងកក ប៉ុស្តិ៍ ៕
មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព ប្រកាស ជ្រើសរើស មន្ដ្រី ជាប់ កិច្ចសន្យា ចំនួន ៣០០ នាក់
( ភ្នំពេញ ) ៖ មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព បាន ប្រកាស ជ្រើសរើស មន្ដ្រី ជាប់ កិច្ចសន្យា ចំនួន ៣០០ នាក់ លើ មុខជំនាញ និង ឯក ចំនួន ១២ ចាប់ពី ថ្ងៃ ផ្សាយ ដំណឹង នេះ រហូតដល់ ថ្ងៃទី ១០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ។
ការប្រកាស ជ្រើសរើស មន្ដ្រី ជាប់ កិច្ចសន្យា ខាងលើ នេះ បាន ធ្វើឡើង ដោយ យោង តាម ប្រសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា កាលពី ថ្ងៃទី ១៩ ខែមករា ឆ្នាំ ២០២៣ ក្នុង ពិធី ចុះ ត្រួតពិនិត្យ វឌ្ឍនភាព គម្រោង សាងសង់ មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព ។
លក្ខខណ្ឌ ជ្រើសរើស គឺ គ្រប់ បេក្ខជន - បេក្ខ នារី ត្រូវ មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង ទៅ សញ្ជាតិ ខ្មែរ មាន សុខភាព និង កាយសម្បទា មាំ មួន ស្មោះត្រង់ រួសរាយ រាក់ទាក់ និង មាន ការតាំងចិត្ដ ខ្ពស់ ក្នុង ការធ្វើ ការងារ គោរព និង អនុវត្ដន៍ តាម ការចាត់តាំង របស់ មន្ទីរពេទ្យ ៕
សូម អាន ព័ត៌មាន លម្អិត ដែល មាន ដូច ខាងក្រោម នេះ៖ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន៖ ក្លិប អ្នកកាសែត ជា ដៃគូ ដ៏ ល្អ របស់ ក្រសួង ដែល ពោរពេញ ទៅ ដោយ អ្នកកាសែត ជើង ចាស់ ដែល យល់ដឹង ច្បាស់ ពី ច្បាប់ និង វិជ្ជាជីវៈ
( ភ្នំពេញ ) ៖ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន បាន បញ្ជាក់ ថា ក្លិប អ្នកកាសែត កម្ពុជា ( ក. អ. ក) គឺជា ដៃគូ ដ៏ ល្អ មួយ របស់ ក្រសួង ព័ត៌មាន និង ជា តំណាង របស់ ក្រសួង ព័ត៌មាន ក្នុង ពេល ដែល ត្រូវ អញ្ជើញ អ្នកសារព័ត៌មាន កម្ពុជា ឱ្យ ចូលរួម ក្នុង សិក្ខាសាលា នានា នៅឯ ក្រៅ ប្រទេស ជាពិសេស ពោរពេញ ទៅ ដោយ អ្នកកាសែត ជើង ចាស់ ប្រកបដោយ វិជ្ជាជីវៈ ។
ពិធី នេះ មាន ការចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ ក្រសួង ព័ត៌មាន តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ព្រមទាំង អ្នកកាសែត សរុប ប្រមាណ ជាង ៣០០ នាក់ នា រសៀល ថ្ងៃទី ២៧ ខែមករា ឆ្នាំ ២០២៣ ម្សិលមិញ នៅ ភោជនីយដ្ឋាន បឹង មាស ស្ថិត ក្នុង សង្កាត់ ជ្រោយ ចង្វា ខណ្ឌ ជ្រោយ ចង្វា រាជធានី ភ្នំពេញ ។
លោក រដ្ឋមន្ត្រី ខៀវ កាញារីទ្ធ បាន គូសបញ្ជាក់ ថា៖ « ជិត ៣០ ឆ្នាំ មកហើយ ក្លិប អ្នកកាសែត គឺជា ក្លិប មួយ ឬ អង្គការ មួយ ដែល ជា ដៃគូ ដ៏ ល្អ បំផុត ជាមួយ ក្រសួង ព័ត៌មាន ដូច្នេះ ជា គោលការណ៍ កាលណា គេ អញ្ជើញ សមាគម អ្នកកាសែត គេ អញ្ជើញ តែ មួយ ទេ ជា តំណាង អ៊ឹចឹង ក្រសួង ជានិច្ចកាល តែង រើស ក្លិប អ្នកកាសែត កម្ព ជា ជា តំណាង សារព័ត៌មាន កម្ពុជា ទាំងមូល » ។
លោក រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ក៏ បាន ណែនាំ ដល់ ក្លិប អ្នកកាសែត កម្ពុជា បន្ត បណ្តុះបណ្តាល អ្នកជំនាន់ ក្រោយ បន្ថែម ទៀត និង បាន កោតស សើរ ដល់ លោក ពុយ គា ប្រធាន ក្លិប អ្នកកាសែត កម្ពុជា ដែល ទើប ទទួលបាន ការតែងតាំង ថ្មី គឺ អ្នកសារព័ត៌មាន ជើង ចាស់ ពោរពេញ ទៅ ដោយ បទពិសោធន៍ និង មាន ភាពល្បីល្បាយ ក្នុង ស្រទាប់ អ្នកសារព័ត៌មាន អន្តរជាតិ ទៀត ។
ត្រង់ ចំណុច នេះ លោក រដ្ឋមន្ត្រី ខៀវ កាញារីទ្ធ បាន លើកឡើង ថា៖ « កាលណា បណ្តា ប្រទេស នានា អញ្ជើញ អ្នកកាសែត កម្ពុជា ទៅ សិក្សា គឺ ជ្រើស ក្លិប អ្នកកាសែត កម្ពុជា ពីព្រោះ ក្លិប អ្នកកាសែត មាន វិន័យ មាន ការអប់រំ ដែល នេះ ជា ចំណុច ល្អ បំផុត ដែល ពោរពេញ ទៅ ដោយ អ្នកកាសែត ជើង ចាស់ ដែល យល់ដឹង ច្បាស់ ពី ច្បាប់ ជំនាញ វិជ្ជាជីវៈ របស់ អ្នកសារព័ត៌មាន » ។
សូម បញ្ជាក់ ថា សមាជិក ដែល បាន ចូលរួម បោះឆ្នោត ជ្រើសរើស គណៈកម្មាធិការ នាយ ក្លិប អ្នកកាសែត កម្ពុជា ( ក. អ. ក) អាណត្តិ ទី៧ មាន ចំនួន សរុប ២៨១ នាក់ ជា លទ្ធផល បន្ទាប់ពី ធ្វើ ការបោះឆ្នោត មាន ការគាំទ្រ ចំនួន ២៧៧ សន្លឹក មិន បាន ការមាន ចំនួន ២សន្លឹក និង អនុប្បវាទ ចំនួន ២សន្លឹក ៕
ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ នឹង តំបន់ ឆ្នេរសមុទ្រ កម្ពុជា ប្តេជ្ញា ពង្រឹង គ្រប់គ្រង និង កាត់បន្ថយ សំណល់ សមុទ្រ
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ និង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ រួមទាំង អាជ្ញាធរ ខេត្ត តំបន់ ឆ្នេរសមុទ្រ ទាំង៤ បណ្តា អង្គការ ក៏ ដូចជា សមាគម ទេសចរណ៍ នានា ពាក់ព័ន្ធ នឹង តំបន់ ឆ្នេរសមុទ្រ កម្ពុជា ប្តេជ្ញា ពង្រឹង ការគ្រប់គ្រង និង កាត់បន្ថយ សំណល់ សមុទ្រ (Marine Debris) ពិសេស សំណល់ ប្លាស្ទិក នៅ តាម គោលដៅ ទេសចរណ៍ តំបន់ ឆ្នេរ ។
លោក រដ្ឋលេខាធិការ នី ផល្លី បាន លើកឡើង ពី ភាពចាំបាច់ ក្នុង ការគ្រប់គ្រង សំណល់ សមុទ្រ (Marine Debris) ពិសេស សំណល់ ប្លាស្ទិក នៅ តាម គោលដៅ ទេសចរណ៍ តំបន់ ឆ្នេរ គឺ តម្រូវ ឱ្យ មាន ការចូលរួម ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ សហការ គ្នា ថែរក្សា ឆ្នេរសមុទ្រ ឱ្យ មាន អនាម័យ ល្អ បរិស្ថាន ល្អ និង គុណភាព ទឹក ល្អ ដើម្បី បង្កើន ភាពទាក់ទាញ និង ភាពកក់ក្តៅ ដល់ ទេសចរ ជាតិ និង អន្តរជាតិ និង ចូលរួម លើកស្ទួយ សុខ មាលភាព សង្គម ។
លោក រដ្ឋលេខាធិការ បាន លើក ជា គំនិត ផ្តួចផ្តើម ក្នុង ការចងក្រង និង បង្កើត ជា ថ្នាល រួម មួយ ក្នុង ការសហការ រវាង បណ្តាញ ក្រសួង ស្ថាប័ន អាជ្ញាធរ មូលដ្ឋាន អង្គការ សមាគម សហគមន៍ និង សមាគម ទេសចរណ៍ នានា នៅក្នុង តំបន់ ឆ្នេរសមុទ្រ ដើម្បី បង្កើន ប្រសិទ្ធភាព ក្នុង ការបំពេញ បេសកកម្ម តាម គន្លង គោលដៅ រួម ក្នុង ការគ្រប់គ្រង និង កាត់បន្ថយ សំណល់ សមុទ្រ ។
អង្គប្រជុំ បាន ឯកភាព គ្នា ប្តេជ្ញាចិត្ត ពង្រឹង កិច្ចសហការ អនុវត្ត ការងារ ផ្លាស់ប្តូរ ទិន្នន័យ និង បច្ចេកវិទ្យា និង រួមគ្នា ទាំង ការកសាង និង អនុវត្ត ផែនការ សមាហរណកម្ម អន្តរ វិស័យ ក្នុង ការគ្រប់គ្រង និង កាត់បន្ថយ សំណល់ សមុទ្រ (Marine Debris) ពិសេស គាំទ្រ ឱ្យ មាន ការបង្កើត វេទិកា រួម ដើម្បី គាំទ្រ ដល់ ការអនុវត្ត គម្រោង និង ផែនការ ខាងលើ ៕
សមាគម ស្បែកជើង កម្ពុជា សហការរៀបចំ សិក្ខាសាលា ក្រោម ប្រធានបទ « ការបើក ប្រាក់ ឈ្នួល តាម ប្រព័ន្ធ ឌីជីថល និង សេវាកម្ម ប្រាក់ ឈ្នួល »
មាន វាគ្មិន ២រូប ដែល បាន អញ្ជើញ ចូលរួម គឺ៖
១៖ លោក នួន វិរៈ ប្រធាន គ្រប់គ្រង គម្រោង ប្រាក់ ឈ្នួល ឌីជីថល នៃ អង្គការ អន្តរជាតិ ខាង ការងារ ស្តីពី គម្រោង រោងចក្រ កាន់តែ ប្រសើរ នៅ កម្ពុជា ILO/BFC
គួរ បញ្ជាក់ ថា លោក អូមែល សិន កូ មិន បាន បញ្ជាក់ លម្អិត ថា តើ ប្រទេស នីមួយ ៗ បាន សន្យា ផ្ដល់ រថ ក្រោះ ប៉ុន្មាន គ្រឿង នោះ ទេ ខណៈ បណ្ដា ប្រទេស លោក ខាងលិច ជាច្រើន ដឹកនាំ ដោយ សហរដ្ឋ អាមេរិក និង អាល្លឺម៉ង់ បាន ប្រកាស ផ្ដល់ រថក្រោះ ធុន ធ្ងន់ ឱ្យ អ៊ុយក្រែន ជា បន្តបន្ទាប់ ៕
គួរ បញ្ជាក់ ថា បើ តាម លោក ម៉ៃក៍ មីនី ហាន់ ការបោះឆ្នោត ប្រធានាធិបតី តៃវ៉ាន់ នៅ ឆ្នាំ ២០២៤ អាចនឹង ផ្ដល់ លេស ឱ្យ លោក ប្រធានាធិបតី ចិន ស៊ី ជិន ពីង ប្រើប្រាស់ កម្លាំង យោធា ខណៈ សហរដ្ឋ អាមេរិក អាចនឹង ជាប់រវល់ នឹង កិច្ចការ ផ្ទៃក្នុង របស់ ខ្លួន ពោលគឺ ការបោះឆ្នោត ប្រធានាធិបតី អាមេរិក ៕ មូលនិធិ ជាតិ ជំនួយ សង្គម នឹង បើក ប្រាក់ ជូន អតីត មន្រ្តី រាជការ ស៊ីវិល ប្រចាំ ខែមករា សម្រាប់ ២សប្តាហ៍ លើក ទី២ ចាប់ពី ថ្ងៃទី ៣១ ខែមករាត ទៅ
( ភ្នំពេញ ) ៖ មូលនិធិ ជាតិ ជំនួយ សង្គម សម្រាប់ មន្រ្តី រាជការ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង បើក ប្រាក់ ប្រចាំ ខែមករា សម្រាប់ ២សប្តាហ៍ លើក ទី២ ជូន និវត្ត ជន និង អតីត មន្ត្រីរាជការ ស៊ីវិល ចាប់ពី ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២៣ត ទៅ តាម ប្រព័ន្ធ ធនាគារ កាណាឌីយ៉ា និង ធនាគារ អេស៊ីលីដា នៅ ២៥ រាជធានី - ខេត្ត ទូទាំង ប្រទេស ។
យោង តាម សេចក្តីជូនដំណឹង របស់ មូលនិធិ ជាតិ ជំនួយ សង្គម សម្រាប់ មន្រ្តី រាជការ ស៊ីវិល ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៨ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន បញ្ជាក់ ថា « ប្រាក់ គោល នយោបាយ របប សន្តិសុខ សង្គម ប្រចាំ ខែមករា សម្រាប់ ២សប្តាហ៍ លើក ទី២ ជូន និវត្ត ជន និង ជន បាត់បង់ សម្បទា វិជ្ជាជីវៈ និង អតីត មន្ត្រីរាជការ ស៊ីវិល នឹង ធ្វើឡើង ចាប់ពី ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២៣ត ទៅ » ។
អ្នកនាង គីម យ៉ូ ជុង បាន គូសបញ្ជាក់ ដូច្នេះ ថា « រឿង ទាំងអស់ គឺ បង្កឡើង ដោយ ចេតនា អាក្រក់ របស់ សហរដ្ឋ អាមេរិក ដើម្បី តែ អនុត្តរភាព របស់ ខ្លួន ឯង ដោយ ពង្រីក ការធ្វើ សង្រ្គាម ប្រូកស៊ី សំដៅ បំផ្លាញ រុស្ស៉ី ... ហើយ ទីក្រុង ព្យុងយ៉ាង នឹង ឈរ ប្រកៀក ស្មា ជាមួយ កងទ័ព និង ប្រជាជន រុស្ស៉ី » ។
( ភ្នំពេញ ) ៖ សមត្ថកិច្ច ជំនាញ នៃ ក្រសួង មហាផ្ទៃ បាន រកឃើញ បទល្មើស រំលោភ កម្មសិទ្ធិ បញ្ញា ដែល ប្រព្រឹត្ត ដោយ ម្ចាស់ អាជីវកម្ម ៦ទីតាំង នៅ រាជធានី ភ្នំពេញ និង ខេត្ត តាកែវ តាមរយៈ ការទិញ ផលិតផល ប្រេង ម៉ាស៊ីន ម៉ាក Mobil ពី ប្រភព មិន ច្បាស់លាស់ មក ធ្វើ អាជីវកម្ម ។ ទោះជា យ៉ាង នេះ ក្តី ម្ចាស់ អាជីវកម្ម ទាំង ៦ទីតាំង បាន ធ្វើ កិច្ចសន្យា ឈប់ ប្រព្រឹត្ត សកម្មភាព ខុស ច្បាប់ របស់ ពួកគេ តទៅទៀត លើ អ្នក មាន សិទ្ធិ ផ្តាច់ មុខ លើ ផលិតផល មួយ នេះ ។
បទល្មើស រំលោភ កម្មសិទ្ធិ បញ្ញា ត្រូវបាន រកឃើញ ដោយ គណៈកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ ដែល បង្ក គ្រោះថ្នាក់ មាន ហានិភ័យ ខ្ពស់ ដល់ សុខភាព និង សុវត្ថិភាព សង្គម ( គ. ប. ផ. ក ) ដែល ប្រព្រឹត្ត ដោយ អាជីវកម្ម ៣ទីតាំង រួម មាន៖
ជូនដំណឹង ! មូលនិធិ ជាតិ ជំនួយ សង្គម នឹង បើក ផ្តល់ ប្រាក់ របប សង្គម លើក ទី២ ជូន អតីត យុទ្ធជន និង គ្រួសារ អតីត យុទ្ធជន ប្រចាំ ខែមករា ចាប់ពី ថ្ងៃទី ៣១ ខែមករាត ទៅ
( ភ្នំពេញ ) ៖ មូលនិធិ ជាតិ ជំនួយ សង្គម នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង បើក ផ្តល់ ប្រាក់ របប សង្គម លើក ទី២ ជូន អតីត យុទ្ធជន គ្រប់ ប្រភេទ និង គ្រួសារ អតីត យុទ្ធជន ប្រចាំ ខែមករា ចាប់ពី ថ្ងៃទី ៣១ ខែមករាត ទៅ តាម ប្រព័ន្ធ ធនាគារ កាណាឌីយ៉ា និង ធនាគារ អេស៊ីលីដា នៅ ២៥ រាជធានី - ខេត្ត ទូទាំង ប្រទេស ។
ក្នុង ករណី មាន បញ្ហា ផ្សេង ៗ សូម ជូនដំណឹង មក បេឡា ជាតិ អតីត យុទ្ធជន តាម ប្រព័ន្ធ ទូរស័ព្ទ ៣ខ្សែ រួមម មាន ០៩២ ២១៩ ៨៨៨ ឬ ០៣១ ៥ ២១៩ ៨៨៨ ឬ គេហទំព័រ របស់ បេឡា ជាតិ អតីត យុទ្ធជន ៕ ស្រវឹង សូម កុំ បើកបរ ! ស្លាប់ ៣នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៧ ខែមករា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៧ ខែមករា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ១០នាក់ ។
ព្រឹក នេះ គណបក្ស ប្រជាជន កម្ពុជា ចាប់ផ្តើម មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស រយៈពេល ២ ថ្ងៃ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច ហេង សំរិន (Video inside) ( ភ្នំពេញ ) ៖ មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស រយៈពេល ២ ថ្ងៃ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល ជា គណបក្ស កាន់អំណាច ចាប់ផ្តើម នៅ ព្រឹក ថ្ងៃទី ២៨ ខែមករា ឆ្នាំ ២០២៣ នេះ នៅ វិមាន ៧មករា រាជធានី ភ្នំពេញ ។
មហាសន្និបាត ប្រារព្ធ ឡើង ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន កិត្តិយស គណបក្ស ប្រជាជន កម្ពុជា ដោយ មាន ការចូលរួម ពី សមាជិក អចិន្ត្រៃយ៍ សមាជិក គណៈកម្មាធិការ កណ្តាល ប្រធាន គណបក្ស ទូទាំង ប្រទេស រួមទាំង មន្រ្តី ជាន់ ខ្ពស់ អ្នកមុខអ្នក ការប្រមាណ ខ្ទង់ ពាន់ នាក់ ។
បើ តាម លោក សុខ ឥសាន អ្នកនាំពាក្យ គណបក្ស ប្រជាជន កម្ពុជា . គឺ រយៈពេល ២ ថ្ងៃ នេះ នឹង មាន របៀបវារៈ មួយចំនួន ។ លោក ថា នៅ ថ្ងៃ ដំបូង នឹង មាន ពិធី បើក មហាសន្និបាត វិសាមញ្ញ ដែល ថ្លែង សុន្ទរកថា បើក ដោយ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន . ការអាន របាយការណ៍ អំពី លទ្ធផល នៃ ការអនុវត្ត កម្មវិធី នយោបាយ គណបក្ស ពី ឆ្នាំ ២០១៨ - ២០២៣ និង ទិសដៅ ភារកិច្ច ឆ្នាំ ២០២៣ និង កិច្ចពិភាក្សា មួយចំនួន ។
ចំណែក របៀបវារៈ ថ្ងៃទី ២ នៃ មហាសន្និបាត វិសាមញ្ញ ត្រូវបាន អ្នកនាំពាក្យ រូប នេះ បញ្ជាក់ ថា ជា ការអនុម័ត លើ របាយការណ៍ អំពី លទ្ធផល នៃ ការអនុវត្ត កម្មវិធី នយោបាយ គណបក្ស ពី ឆ្នាំ ២០១៨ - ២០២៣ និង ទិសដៅ ភារកិច្ច ឆ្នាំ ២០២៣ . ការអនុម័ត លើ សេចក្តីព្រាង កម្មវិធី នយោបាយ របស់ គណបក្ស សម្រាប់ ការកសាង និង ការពារ មាតុភូមិ ឆ្នាំ ២០២៣ - ២០២៨ និង មាន មតិ បូកសរុប និង ការណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ជាដើម ។
គួរ បញ្ជាក់ ថា ទីក្រុង វ៉ារស្សា វ៉ា ដែល បាន ដាក់ ខ្លួន ជា សម្ព័ន្ធមិត្ត ដ៏ រឹងមាំ បំផុត មួយ របស់ ទីក្រុង កៀវ បាន បញ្ជូន រថ ក្រោះ រាប់ រយ គ្រឿង រួច មកហើយ ទៅឲ្យ ប្រទេស ជិតខាង របស់ ខ្លួន មួយ នេះ ចាប់តាំងពី រុស្ស៊ី បាន ឈ្លានពាន កាលពី ខែកុម្ភៈ ឆ្នាំ មុន ។
សមាគម សហគ្រិន ពាណិជ្ជកម្ម កម្ពុជា កំណត់ បេសកកម្ម និង ចក្ខុវិស័យ ជា អទិភាព ធំ ៗ សម្រាប់ ឆ្នាំ ២០២៣ ដើម្បី គាំទ្រ ដល់ សហគ្រាស និង ម្ចាស់ អាជីវកម្ម ធុន តូច មធ្យម នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២៧ ខែមករា ឆ្នាំ ២០២៣ នេះ លោក លី ចាន់ សុភក្ដី ប្រធាន ក្រុមប្រឹក្សាភិបាល សមាគម សហគ្រិន ពាណិជ្ជកម្ម កម្ពុជា (CBEC) បាន ដឹកនាំ កិច្ចប្រជុំ ជាមួយ ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ និង ស្ថាបនិក នៃ សមាគម សហគ្រិន ពាណិជ្ជកម្ម កម្ពុជា (CBEC) នៅ ការិយាល័យ ណ្ដាល របស់ ខ្លួន នៅ រាជធានី ភ្នំពេញ ។
ក្នុង កិច្ចប្រជុំ នោះ ដែរ ថ្នាក់ដឹកនាំ របស់ សមាគម សហគ្រិន ពាណិជ្ជកម្ម កម្ពុជា បាន សម្រេច និង កណត់ ដាក់ចេញ នូវ ទិសដៅ បេសកកម្ម និង ចក្ខុវិស័យ សម្រាប់ ឆ្នាំ ២០២៣ ក្នុង គោលបំណង ដើម្បី គាំទ្រ ដល់ សហគ្រាស និង ម្ចាស់ អាជីវកម្ម ធុន តូច មធ្យម នៅ កម្ពុជា អោយ មាន ការអភិវឌ្ឍន៍ បន្ថែម ទៀត និង រឹតតែ រឹងមាំង ដើម្បី ជួយ ជំរុញ សេដ្ឋកិច្ច ជាតិ និង ប្រជាជន ដែល កំពុង ប្រកបរបរ អាជីវកម្ម គ្រប់ ប្រភេទ នៅក្នុង ប្រទេស កម្ពុជា ។
សាកលវិទ្យាល័យ ក្រចេះ បើក វគ្គ សិក្សា ស្តីពី សហគមន៍ អាស៊ី « ឆ្ពោះ ទៅរក ការបង្កើត សហគមន៍ អាស៊ី៖ ការកសាង សមត្ថភាព យុវជន សម្រាប់ ការអភិវឌ្ឍ សហគមន៍ ប្រកបដោយ និរន្តរភាព »
គោលបំណង នៃ វគ្គ សិក្សា នេះ ដើម្បី បណ្តុះបណ្តាល ដល់ និស្សិត និង សិក្ខាកាម ពង្រឹង និង ពង្រីក នូវ ចំណេះដឹង បន្ថែម ពី ការសិក្សា តាម កម្មវិធី សិក្សា របស់ ពួកគេ តាមរយៈ បទពិសោធន៍ ល្អ ៗ របស់ គ្រូ ឧទ្ទេស ជា ជនជាតិ បរទេស និង ជនជាតិ ខ្មែរ នៅក្នុង វគ្គ សិក្សា ទៅ តាម ប្រធានបទ នីមួយ ៗ ។
កម្មវិធី វគ្គ សិក្សា នេះ មាន រយៈពេល ៤ខែ ចាប់ពី ថ្ងៃទី ១៨ ខែមករា រហូតដល់ ខែមេសា ឆ្នាំ ២០២៣ ហើយ រៀងរាល់១ សប្តាហ៍ រៀន តែ ១ ថ្ងៃ តែ ប៉ុណ្ណោះ ក្រោយ បញ្ចប់ វគ្គ សិក្សា សាកលវិទ្យាល័យ នឹង ចេញ នូវ លិខិត បញ្ជាក់ ការសិក្សា ជូន សិស្ស និស្សិត ផងដែរ ហើយ នេះ ជា សប្តាហ៍ ទី២ នៃ វគ្គ សិក្សា នេះ ។
សូម បញ្ជាក់ ថា សាកលវិទ្យាល័យ ក្រចេះ តែងតែ ទំនាក់ទំនង ជិតស្និត ជាមួយ ដៃគូ លើ កិច្ចសហប្រតិបត្តិការ នានា ពិសេស សហប្រតិបត្តិការ ដៃគូ ក្នុង វិស័យ អប់រំ ដើម្បី បញ្ជ្រាប ដល់ សិស្ស និស្សិត តាមរយៈ ការធ្វើ សិក្ខាសាលា បាឋ កថា និង វគ្គ បណ្តុះបណ្តាល នានា ដើម្បី ពង្រឹង សមត្ថភាព បន្ថែម ទៀត លើ ផ្នែក ចំណេះដឹង ជំនាញ និង បរិបទ នៃ វប្បធម៌ រស់ នៅក្នុង សង្គម ជាក់ស្តែង ក៏ ដូចជា ដំណើរ នៃ ការអភិវឌ្ឍ រីកចម្រើន របស់ ប្រទេសជាតិ និង ពិភពលោក ទាំងមូល ផងដែរ ។
តាមរយៈ ប្រធានបទ ខាងលើ នេះ គឺ សំដៅ ធ្វើ យ៉ាងណា ដើម្បីឲ្យ សហគមន៍ របស់ យើង មាន ភាពខ្លាំងក្លា មាន សុខ សន្តិភាព និង ស្ថេរភាព នយោបាន នៅក្នុង តំបន់ ។ សហគមន៍ មួយ មាន ភាពសុខដុមរមនា និង ភាពខ្លាំងក្លា ទៅ បាន ក៏ អាស្រ័យ លើ ភាពខ្លាំង របស់ ប្រជាពលរដ្ឋ នៅក្នុង សហគមន៍ តាមរយៈ ការកសាង សមត្ថភាព របស់ ពួកគេ ៕
វិភាគ អន្តរជាតិ៖ ចិន និង តៃវ៉ាន់ នៅក្នុង ឆ្នាំ ២០២៣
បរិយាកាស សន្តិសុខ នៅក្នុង តំបន់ សព្វ ថ្ងៃ ដែល កំពុង ផ្លាស់ប្ដូរ នេះ គឺ ដើរ ផ្ទុយទៅនឹង ផលប្រយោជន៍ របស់ ចិន ហើយ នេះ អាចនឹង ជំរុញ ឱ្យ ចិន កាន់តែ បង្កើន សកម្មភាព យោធា នៅក្បែរ កោះ តៃវ៉ាន់ នៅក្នុង រយៈពេល ខ្លី ។
