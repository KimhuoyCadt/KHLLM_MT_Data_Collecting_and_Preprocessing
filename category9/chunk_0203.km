គំនិត នៃ ភាព ជា ម្ចាស់ និង ការអភិវឌ្ឍ ដោយ ខ្លួន ឯង
សោកនាដកម្ម នេះ គឺ ផ្តើម ចេញ ពី បដិវត្តន៍ ពណ៌ ។
រហូតមកដល់ ពេលនេះ មាន ១៨ ករណី ឆ្លង វីរុស នេះ ត្រូវបាន បញ្ជាក់ នៅ ប្រទេស អ៊ីរ៉ង់ ដោយ រួមទាំង ៤នាក់ ដែល បាន ស្លាប់ នេះ ។
ប៉ូលិស ដេញ តាម ពីក្រោយ ដួល ម៉ូតូ ព្រូស
គំនិត ២១ ក្បាច់ របស់ អ្នក មាន ខុសពី គំនិត របស់ មនុស្ស ទូទៅ
ហេតុ អ្វី បានជា សង្គម ស៊ីវិល ខ្លាច រអារ ច្បាប់ គ្រប់គ្រង អង្គការ ?
ឬ សញ្ញា វិបត្តិ ផ្លូវ ដង្ហើម
ដៃ ជើង របស់ តុក្កតា ដូច មនុស្ស ពិត
គ្នា ព្រោះ ការចុះឈ្មោះ និង ពិនិត្យ បញ្ជី ឈ្មោះ អ្នកបោះឆ្នោត ឆ្នាំ ២០១២ នេះ គឺជា លើក ចុងក្រោយ ហើយ ដើម្បី យើង មាន សិទ្ធិ បោះឆ្នោត ទាំងអស់ គ្នា នៅ ឆ្នាំ ២០១៣ ដែល ការចុះឈ្មោះ បោះឆ្នោត និង ពិនិត្យមើល បញ្ជី ឈ្មោះ នេះ គឺ មាន រយៈ បេល ៤២ ថ្ងៃ ដែល ប្រព្រឹត្តទៅ ចាប់តាំងពី ថ្ងៃទី ១ ខែកញ្ញា និង បញ្ចប់ ទៅ វិញ នៅ ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០១២ ខាងមុខ នេះ ។
មុខរបរ តាម ដងផ្លូវ ត្រូវ បង់ប្រាក់ ទៅ ឱ្យ អាជ្ញាធរ ជា ថ្នូរ នឹង សិទ្ធិ ចត យានជំនិះ ដោយ សេរី
អ្នក ខ្លះ ការងារ នេះ មិន ធ្វើ សាញ ថា ប្រាក់ខែ តិច
ហាម អ្នកសារព័ត៌មាន មិន ឱ្យ ចូល ថត យក រូបភាព
ដៃគូ អាជីវកម្ម ជា ស្ត្រី នឹង ធ្វើឱ្យ អ្នក ទាំង ពីរ គាំទ្រ គ្នា និង បង្កើត កន្លែង ដែល គ្នា ខ្វះ ។
ខេ ខេចា៎ បង សព្វ ថ្ងៃ ខ្ញុំ ហ៊ាន ទទួល ថត គ្រប់ ឈុត ស្នេហា ទាំងអស់ លើកលែងតែ ឈុត ថត លើ គ្រែ ស្រស់ ៗ
មាន សភាព ស្គម និង ប្រឈម នឹង ជំងឺ ជាច្រើន ។
ទាមទា បាន ប្រាសាទ ព្រះវិហារ តើ អង្គ រាជា ?
ព្យាបាល ជាតិ ពុល ក្នុង អាហារ ប្រើ …
នៅក្នុង ទីក្រុង តៃ ប៊ិបាន ញ័រ រន្ថើន យ៉ាង ខ្លាំង ។
រ៉ូលីន ចេញ សម្តែង នៅ អាមេរិក ថ្ងៃ ដំបូង ទទួលបាន ជោគជ័យ
គណៈកម្មការ ការពារ ទឹក ជំនន់ បាន ជូន ដំណឹង ថា នឹង មាន ភ្លៀង ជា បន្តបន្ទាប់ ក្នុង អំឡុ ពេល ប៉ុន្មាន ថ្ងៃ ខាងមុខ នេះ ។
ដូច្នេះ ប្រសិន យើង ចង់ សង់ ស្តូប នេះ គួរតែ ស្ទាបស្ទង់ ពី គំនិត ប្រជាជន ផង ថា គេ ចង់បាន អ្វី ក្រែងលោ ធ្លាក់ ឆ្នោត ។
ស្វាយ ទាប ដែល ទើបនឹង ជាប់ ឆ្នោត ថ្មី ត្រូវបាន លោក ផង់ សាម៉ុន ចៅក្រម ជំនុំ
លោក រ៉ុង ឈុន មិន បាន ជួប ភិភាក្សា ការងារ ជាមួយ ក្រសួង មហាផ្ទៃ តាម ការគ្រោងទុក
លើស ឈាម តាំងពី អាយុ៣០ ឆ្នាំ ចាស់ ទៅ បញ្ហា ខូច ខួរក្បាល កាន់តែ ខ្ពស់
ក្រោយពី តំណាង ខុទ្ទកាល័យ សម្តេច តេជោ ទទួល ញត្តិ រួច ពួកគាត់ ត្រលប់ ទៅវិញ ម៉ោង ១០និង ០៥នាទី នៅ ថ្ងៃ ដដែល ៕
នៅ ពេល នោះ លោក សម រង្ស៊ី ហាក់ ដឹង ជាមុន អំពី ការចរចា និង មាន ការដោះលែង វិញ ព្រោះ លោក សម រង្ស៊ី អះអាង ភ្លាម ៗ
ចំណែក អ្នកជំនាញ ការត្រូវ ធ្វើ ការ៥ ឆ្នាំ និង ពលករ ឯកទេស ត្រូវ ធ្វើ ការ៧ឆ្នាំ ។
ខ្ញុំ ចង់ បកស្រាយ ច្រើន ចឹង សូម ប្រិយមិត្ត រង់ចាំ មើល ក្នុង ប្លក់ របស់ ខ្ញុំ !
នៅ ចំពោះមុខ អ្នក កាសែត ជា ច្រើន នាក់ លោក អ៊ិន សុភិន បាន ថ្លែង ថា ៖
តុលាការ ថៃ ទទួលយក បណ្តឹង ប្រឆាំង នាយក រដ្ឋមន្ត្រី ន…
ឥឡូវនេះ យើង ស្ថិត នៅ ត្រង់ ចំណុច របត់ មួយ ។
គួរអោយ ស្តាយ សៀវភៅ នោះ
អ្នក រត់ ពន្ធ មនុស្ស ឆ្លង ដែន មិន អាច រួចផុត សំណាញ់ ច្បាប់
សែន ព្រេន បាន ប៉ុន្មាន ថ្ងៃ ស្រាប់តែ ប្រពន្ធ នាយ តាក់ស៊ី ទម្លាយ អារម្ម ណ៏ មួយ នេះ ចេញមក ថា …!
ព្រោះ ព្រះពុទ្ធ សម្តែង ថា ចុតិបដិសន្ធិ ស្លាប់ ហើយ កើត គ្មាន យើង នោះ ទេ ។
ដឹង អត់ ថា របៀប អង្គុយ របស់ អ្នក បង្កប់ នូវ អត្ថន័យ ទាំងនេះ ?
យ៉ាងណា ក៏ដោយ លទ្ធផល នៃ ជំនួប ពិភាក្សា រវាង តំណាង ប្រជាពលរដ្ឋ និង អាជ្ញាធរ ខេត្ត បន្ទាយមានជ័យ មិន ទាន់ ដឹង លទ្ធផល នៅឡើយ ទេ ខណៈ ដែល ភាគី ទាំង ពីរ បាន និង កំពុង ជួបគ្នា នៅឡើយ ៕
ហើយ អ្វី ដែល ជា បំណងប្រាថ្នា នេះ តែង ត្រូវបាន ពលរដ្ឋ ម្ចាស់ ឆ្នោត ទាំងនោះ ស្រែក ឡើង ជាញឹកញាប់ ។
អ្នកស្រុក បាន និយាយ ថា មនុស្ស ប្រហែលជាង ៨០ នាក់ ត្រូវបាន សម្លាប់ នៅ តំបន់ នេះ ។
ការតវ៉ា ដ៏ ហិង្សា បាន ផ្ទុះឡើង កាលពី ថ្ងៃសុក្រ នៅ ទូទាំង ពិភពលោក នៅ ពេល ដែល ក្រុម អ្នក កាន់ សាសនា អ៊ីស្លាម ដែល …
បានជា បន្តបន្ទាប់ ក៏ដោយ ប៉ុន្តែ វិធានការសំខាន់ គឺ ត្រូវ ទប់ស្កាត់ ចរាចចរ និង ប្រើប្រាស់ គ្រឿងញៀន នៅ តាម ព្រំដែន ជាមុន ។
រដ្ឋការ របស់ ប្រធានាធិបតី សហរដ្ឋ អាមេរិក លោក ដូណាល់ ត្រាំ បាន ប្រកាស កាលពី ថ្ងៃពុធ ថា ខ្លួន នឹង ដាក់ ចេញ បម្រាម ឆាប់ ៗ
មេធាវី តំណាង សណ្ឋាគារ លោក នៅ ពិសិដ្ឋ មិន អាច ទាក់ទង ដើម្បី ធ្វើ អត្ថាធិប្បាយ បាន នោះ ទេ ។
លោក ពេជ្រ កែវ មុនី អភិបាល នៃ គណៈអភិបាល ខណ្ឌ មានជ័យ កាលពី ព្រឹក ថ្ងៃទី ១៨មិថុនា នេះ …
ចូរ ទិញ អ្វី ដែល បេះដូង អូន ពិតជា ប៉ង ប្រាថ្នា ណា៎ ។
១. ក្នុង វិស័យ សំភារៈ
ចេន សាយ ចៃ ពិរោះ
ការធ្វើ បែប នេះ ធ្វើឱ្យ លោក ប្រឈម ខាង សតិអារម្មណ៍ និង រាងកាយ ទៀតផង ។
កន្លងទៅ នេះ មាន ការផ្ទុះ ការចាប់អារម្មណ៍ ជាខ្លាំង ណិង មាន ការចែករំលែក បន្ត ៗ
ព្រះតេជគុណ មាន ថេរ ដី ការបន្ត ថា តាម អាត្មា គិត នេះ ហើយ ជា បាត ដៃ ទី បីដូច ដែល នាយក រដ្ឋមន្ត្រី ប្រកាស កាលពី មុន ។
ប្រជាពលរដ្ឋ សាទរ ចំពោះ ចំណាត់ការ ដ៏ តឹងរឹង នោះ ព្រោះ កន្លងទៅ អ្នក មាន អំណាច មិន ដែល ប្រឈម នឹង ផ្លូវ ច្បាប់ នោះ ឡើយ ៕
ទាំង៧ ដែល ធ្វើអោយ ជីវិត របស់ អ្នក កាន់តែ មាន ភាពល្អ ប្រសើរ ៖
ហេតុការណ៍ ឃាតកម្ម នេះ កើតឡើង នៅ ម៉ោង ៧ ៖
ពិភពលោក រង់ចាំ លទ្ធផល ឆ្នោត ជាង …
ថោង សារ៉ាត់ និង បក្ខពួក ៤ទៀត ត្រូវ ជាប់ ពន្ធនាគារ មួយ ជីវិត ករណី បាញ់ សម្លាប់ ឧកញ៉ា អ៊ឹង ម៉េង ជឺ
តែ ជា លទ្ធផល កិច្ចការ នេះ នៅ មិន ទាន់ ទទួលបាន ជោគជ័យ នៅឡើយ ទេ ព្រោះ មន្ត្រី ជំនាញ កំពុង សិក្សា ពី បញ្ហា នេះ ។
ម្លោះ ហើយ ខ្ញុំ ពន្លា វា អោយ មាន វគ្គ ស្រណុក ទាញយក ។
ពុំ មាន គ្រោះ គំរាមកំហែង ណាមួយ ទៅ លើ បណ្តា ប្រទេស ជាប់ មហាសមុទ្រ ឥណ្ឌា ទេ ៕
សូម ស្តាប់ប្រសាសន៍ របស់ លោក វ៉ាត់ ចំរើន ៖
ទោស ទៅតាម ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ។
សំរាប់ បង្កើត វិបសាយ អចលន ទ្រព្យ លក់ ឡាន លក់ដូរ ផ្សេង ៗ
បង្កើន ភាពស្និទ្ធស្នាល
ផ្ទះ យ៉ាងតិច ៩ ពាន់ ៧រយ ខ្នង ត្រូវបាន ឆេះ បំផ្លាញ ហើយ មនុស្ស ៧៦ នាក់ បាន ស្លាប់ ដោយសារ ភ្លើង ឆេះ ព្រៃ នេះ ។
បាតុភូត មិន គួរឱ្យ ជឿ បាន កើតឡើង ក្នុង ប្រទេស ចិន !
តាម មូលដ្ឋាន ទូទាំង ប្រទេស បាន ដឹង នូវ ទង្វើ រ កុហក បោកប្រាស់ របស់ គាត់ អស់ ហើយ !
ដែល អនុវត្ត ផែនការ នេះ រហូតដល់ ថ្ងៃទី ១៧មេសា ២០២០ ទើប បើក ឱ្យ ពលរដ្ឋ ធ្វើដំណើរ បាន វិញ ។
ម្យ៉ាងទៀត អំពើ ដែល ធ្វើឡើង ទាំងនេះ សម្តេច ក៏ មិន អត់ អោន ឱ្យ បាន ឡើយ ចំពោះ អ្នក ដែល ប្រព្រឹត្ត ក្នុង ការកាប់បំផ្លាញ ឈើ ក្នុង តំបន់ អង្គរ នេះ ។
ដល់ ពួកគេ ខណៈ រោងចក្រ ប្រកាស ក្ស័យ ធន ។
កំពុងតែ រាំ សប្បាយ ស្រាប់តែ កុដិ ព្រះគ្រូ …
សូម បញ្ជាក់ ថា រហូតមកដល់ ពេលនេះ មាន អ្នកជំងឺ មួយចំនួន កំពុង បន្ត សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ នៅឡើយ ។
ដែល រដ្ឋបាល លោក សម្រេច ក្នុង ពេល ៨ឆ្នាំ ។
ជួយ ឱ្យ ក្តឹប កាន់ ច្រើន
ខាត់ វ៉ៃ ហាំង និង យូប៊ីន
រាង វិល ប្តូរ តាម បំណង
បើ ចង់ លេង ជាមួយ ហ៊ុន សែន គឺ សុំ តែ ការស្មោះត្រង់ ប៉ុណ្ណោះ
ខាន អនឡាញ យូរ មាន អ្នក គិត ថា ប្រហែលជា ខ្ញុំ ស្លាប់ ។
ក្នុង ចំណោម អ្នកតវ៉ា ក៏ មាន តំណាងរាស្ត្រ គណបក្ស សង្គ្រោះ មួយចំនួន ដែរ ។
មនុស្ស ជាង មួយ លាន នាក់ ប្រឈម នឹង វិបត្តិ ទឹក នៅ ភាគ ខាងកើត អ៊ុយក្រែន
ដោយ ប . ជ័យ បន្ទាយមានជ័យ ស្ទឹង មង្គល បូរី ដែល ជា ស្ទឺង ធំ បង្អស់ ទី១ ក្នុង ភូមិសាស្ត្រ ខេត្ត បន្ទាយមានជ័យ បាន ចាប់ផ្តើម រីងខះ បណ្តើរ ៗ
រ៉ូណាល់ ដូរក្សា ចំណាត់ថ្នាក់ កំពូល ក្នុង …
សម្រក ទម្ងន់ និង សម្អាត ពោះវៀន ក្នុង រយៈពេល ៧ ថ្ងៃ
ប្រពន្ធ រឹតតែ ស្រែក ខ្លាំង ឡើង ៖
ប្រត្តិកម្ម នឹង ពាក្យ តើ ភាពស្រស់ស្អាត ជា ពរ ជ័យ ឬ ជា ទណ្ឌកម្ម ?
ប្រុញ និយាយ ឥត ឈប់ ។
តាមពិត មាន ប្រយោជន៍ សម្រាប់ សុខភាព អឺចឹង សោះ ការចោះ ត្រចៀក និង ច្រមុះ គឺជា ការពេញនិយម បំផុត សម្រាប់ ជនជាតិ ឥណ្ឌា ហើយ សូម្បីតែ ក្មេង ៗ
ភ្នំពេញ ថៃ កំពុងតែ ត្រៀម សម្រាប់ ការឡើង ឆ្លើយ បំភ្លឺ តបត នឹង កម្ពុជា ខណ ដែល សវនាការ នឹង ចាប់ផ្តើម ពេល បន្តិច ទៀត នេះ ។
ឃាត់ខ្លួន ម្នាក់ បន្ទាប់ពី ចូល លួច ម៉ូតូ ប៉ូលិស នៅ …
ហើយ ប្តូរ ទិន្នន័យ ពី ប្រព័ន្ធ ណែត វឺក ដែល វា ស្គាល់ ។
ភាព រឹង ភាពជាប់ បាន យូរ
៣២ នាក់ ស្លាប់ ពេល ផ្ទុះ យន្តហោះ នៅ កុងហ្គោ
តាម ពីក្រោយ ចិន គឺ សហរដ្ឋ អាមេរិច និង ឥណ្ឌា ។
ឃើញ ហើយ ប្រាកដជា ទប់ ចិត្ត មិន បាន
ទោះជា យ៉ាងណា ក៏ដោយ យើង មិន រំពឹង ថា កំណើន ការផ្គត់ផ្គង់ នឹង គ្រប់គ្រាន់ ក្នុង ការកាត់បន្ថយ កង្វះខាត ផ្ទះ សម្រាប់ លក់ នោះ ទេ ។
លោក សម រង្ស៊ី បាន ធ្វើ អត្ថាធិប្បាយ តាមរយៈ ការបង្ហោះ វីដេអូ ដែល មាន រយៈពេល ជាង មួយ នាទី នៅ ថ្ងៃទី ១៦ ខែមករា ។
១ ព្រះយេស៊ូ យាង មក ជាមួយ ពួក សិស្ស ជិត ដល់ ក្រុង យេរូសាឡឹម ហើយ ។
ប៉ុន្តែ ប្រទេស ឥណ្ឌា ក៏ មាន មហិច្ឆតា ដូចគ្នា អ៊ីចឹង ដែរ ។
សុវត្ថិភាព កម្មករ នៅ តំបន់ អាស៊ី នៅតែ ជា ក្តីកង្វល់ ដដែល !
លោក បាន បន្ត ថា ជនភៀសខ្លួន មាន ការភ័យខ្លាច យ៉ាង ខ្លាំង មិន ចង់ ប្រាប់ លោក ទេ ប៉ុន្តែ នៅ ពេល លោក ត្រួតពិនិត្យ បាវ នោះ លោក បាន ប្រាប់ ពួកគេ កុំ ឱ្យ ខ្ជះខ្ជាយ ពេល វេលា ។
សិលាចារឹក នោះ បាន ឆ្លាក់ ពី រូប មនុស្ស ២នាក់ ប្រកួត គ្នា ដណ្តើម រង្វាន់ ។
សេចក្តីប្រកាស ព័ត៌មាន មិន គ្រាន់តែ សរសេរ ព័ត៌មាន ទៀត ទេ ។
ប៉ុន្តែ អាជ្ញាធរ នៅតែ រក្សា តម្លៃ សំណង នេះ ដដែល ហើយ រង់ចាំ ទទួល ពលរដ្ឋ ដែល ស្ម័គ្រចិត្ត ទទួលយក សំណង នេះ ។
លាង សម្អាត ផ្ទៃ មុខ នឹង ទឹក បន្ទាប់មក យក ដុំ ទឹកកក ជូត ពីលើ ផ្ទៃ មុខ ។
ក្បាល ដង ខ្លួន ដៃ ជើង ក្នុង ប្រលាយ ទឹក មួយ កន្លែង ជិត សាលារៀន ។
ប៉ុន្តែ មកដល់ ខែមិថុនា ឆ្នាំ ២០១២ នេះ ប្រជាពលរដ្ឋ ទាំង ២គ្រួសារ នៅតែ មិន ទទួលបាន ដំណោះស្រាយ អ្វី ឡើយ ។
ប្អូន ហុង ជាខ្លាំង ចំប៉ី ខ្មៅ បាន ធ្វើ រឿង ភ្លាម ជូន គាត់ … មាន វីដេអូ
ស្តាប់ បន្ទូល រាជ ទាយាទ អារ៉ាប៊ី សាអូឌីត រួច គ្រប់ គ្នា ធ្លាក់ ពីលើ កៅអី និង ដួល បះ ជើង ឡើង លើ តែម្តង
ជំហាន ចូល ទៅក្នុង ពេល អនាគត ភ្លឺស្វាង របស់ អ្នក ជាមួយ ក្រុមហ៊ុន សែល កាត ។
លោក មិន ឃិន នាំ អំណោយ និង អញ្ជើញ សាកសួរ សុ
មិន តែ ប៉ុណ្ណោះ ត្រូវ មាន អេឡិចចាន់ ត្រា មួយ ទៀត ពិតជា ឈឺ ក្បាល នៅពេល ពួកគេ ជួបគ្នា ក្នុង កម្មវិធី តែ មួយ ម្តង ៗ
លោក បន្ត ថា វិទ្យាស្ថាន ពុទ្ធសាសន បណ្ឌិត្យ នឹង លេច រូបរាងកាន់តែ ច្បាស់ ឡើងវិញ នៅពេល គ្មាន អគារ មួយ នេះ ។
ទើប ទិញ ច្រើន ម្តង ស្រាប់តែ មាន រឿង
ការ ដែល យើង និយាយ ចុះ និយាយ ឡើង បែប នេះ បាន ត្រឹមតែ ការអាក់អន់ ស្រពន់ចិត្ត គ្នា ទៅ វិញ ទៅមក ប៉ុណ្នោះ ។
ថែម ទៀត បម្រើ ឱ្យ សេចក្តីត្រូវការ ពិតប្រាកដ របស់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ដែល ជា កម្មវត្ថុ ចម្បង នៃ ការរៀបចំ អង្គ វេទិកា នៅ ពេល នេះ ។
ចូល ឆ្នាំ ថ្មី ចូល វ័យ ក្រមុំ រូបរាង ខ្ញុំ ប្លែក អស្ចារ្យ ប្រុស ៗ
ខ្ញី មាន សារជាតិ ច្រើន យ៉ាង ដូចជា ៖
