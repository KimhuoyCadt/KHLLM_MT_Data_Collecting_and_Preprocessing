ថាមពល ស្រូវ ប្រាក់ រង្វាន់ ទូរស័ព្ទ ធំ !
វា អាច ផ្លាស់ប្តូរ ផ្ទៃ រូបភាព នៅ ចំណុច លេខ ស… អាន បន្ត
មនុស្សសាង គុណធម៌ ឱ្យ កើតឡើង ជាមុន ទើប គុណធម៌ សាង មនុស្ស នោះ វិញ តាម ក្រោយ ។
នាំគ្នា គាស់ យក មនុស្ស ចេញពី រថយន្ត ក្រោយ គ្រោះថ្នាក់ លើ ផ្លូវ ជាតិ លេខ ៤
មហាសេដ្ឋី រូប នេះ ត្រូវបាន លោក ពូទីន ស្នើ ធ្វើ បត្យាប័ន ជាច្រើន លើក ។
យុវវ័យ សុខភាព មនុស្ស ៥ប្រភេទ ញ៉ាំ កាហ្វេ នឹង នាំ គ្រោះថ្នាក់ ដល់ ខ្លួន
ទំនាស់ ផលប្រយោជន៍ នេះ ហើយ ដែល ជាដើម ចម នៃ ការខ្វះ តម្លាភាព និង អំពើពុករលួយ និង
ព្រះច័ន្ទ គ្មាន បរិយាកាស នោះ ទេ ហេតុ ដូច្នេះ ទើប របស់ វាទទួលរង កម្តៅ ដោយ ផ្ទាល់ ទាំងស្រុង ពី ព្រះអាទិត្យ តែម្តង ។
២ការដើរ របស់ អ្នក បង្ហាញ ថា តើ អ្នក មាន ទស្សនៈ វិជ្ជមាន ឬ អវិជ្ជមាន
ពេល ខ្លះ មិន ស្តាប់ បង្គាប់ ហើយ អាច ជា បញ្ហា ដែល ថា ឪពុក ម្តាយ បាន ជះ ឥទ្ធិពល ទាំងនេះ ដល់ កូន ៗ
ជា ការពិត មិន ត្រឹមតែ តែ កត្តា ធម្មជាតិ តែ ប៉ុណ្ណោះ ទេ ដែល ញ៉ាំង អោយ មាន គ្រោះ ធម្មជាតិ តែ ពេល ខ្លះ កត្តា មនុស្ស ក៏ បាន ចួល រួមចំណែក ដូចគ្នា ដែរ
