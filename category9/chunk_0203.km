វិធានការ នៅ ខែកក្កដា ឆ្នាំ ២០១១ កន្លងទៅ ដើម្បី ប្រយុទ្ធ ទប់ទល់ នឹង វិបត្តិ ហិរញ្ញវត្ថុ នៅក្នុង តំបន់ អឺរ៉ូ ពុំ បាន នាំមក នូវ ភាពស្ងប់ស្ងាត់ ឡើយ ។
គេ ត្រូវការ មនុស្ស ដែល មាន ជំនាញ ពិតប្រាកដមក ធ្វើ ការ ដើម្បី ធ្វើឱ្យ អាជីវកម្ម របស់ គេ មាន ភាពរីកចម្រើន ។
រដ្ឋាភិបាល ជប៉ុន ស្នើ ផែនការ ក្រុង រណប សម្រាប់ ទប់ទល់ វិបត្តិ បើ តូក្យូ រញ្ជួយ ដី
ឃើញ តែ គេ ឈ្លោះគ្នា រឿង ស្នេហា ត្រីកោណ ។
លោក អ្នក មិន ចាំបាច់ ត្រូវតែ បង្កើត អ្វី ថ្មី ដើម្បី ទទួលបាន សេរីភាព និង សមិទ្ធផល ក្នុង នាម ជា សហគ្រិន នោះ ទេ ។
តើ មួយ ណា ខុស មួយ ណា ត្រូវ កុំ អោយ អ្នក មាន អំណាច ខ្លះ ចេះតែ ដើ ធ្វើបាប រាស្ត្រ បន្ត ទៅ មុខ ទៀត ហើយក៍ ដោយសារ ប្រជាពលរដ្ឋ ម្នាក់ នោះ មាន ពាក់ព័ន្ធ និង ករណី អ្វី មួយ ។
ឯកសារ អេឡិចត្រូនិច ប៉ាន មូលដ្ឋានីយកម្ម អក្ខរ ក្រម
សម្រាល ទារក តែង ប្រឈមមុខ នឹង បញ្ហា មួយចំនួន ដែល អាច ប៉ះពាល់ ធ្ងន់ធ្ងរ ដល់ សុខភាព
អោយ គេ លាប ប្រេង សំដែង អំណរ សប្បាយ
តើ ពាក្ស បង្កើត តំបន់ អបគមន៍ ជា យុទ្ធសាស្ត្រ ផ្លន់ ដី បែប ថ្មី ជំនួស ពាក្ស អភិវឌ្ឍ ឬ ក៏ ជា ប្រផ្នូល ចាស់ កាល ឆ្នាំ ១៩៦៣ នៅ សំឡូត និង អម លាំង ?
លោកស្រី តាំង ឆេង អ៊ីម និង ស្វាមី ៥០ ដុល្លារ
ក្រុម អាជ្ញាធរ មិន ទាន់ ដឹង ភ្លាម ៗ
ក្រោយមក អង្ក ការសហប្រជា២ព្រម ស្គាល់ សេរី
ឪពុក ម្តាយ គួរ មាន កម្មវិធី ត្រួតពិនិត្យ អាជ្ញា មួយ ដើម្បី កំណត់ ពី ការអនុញ្ញាតអោយ ប្រើប្រាស់ ប្រដាប់ប្រដា ទាំងអស់ នេះ ។
ជួសជុល ផ្លូវ ជង្ហុក សម្បុក មាន់ តែ គួរតែ ការពារ ប្រសើរ ជាង ព្យាបាល !
ឃាត់ ជន ចែកចាយ គ្រឿងញៀន ម្នាក់ ដកហូត ម៉ា ទឹកកក ១៧ថង់
គេ សង្ស័យ ប៉ូលិស ចរាចរណ៍ តាម គោលដៅ ទទួល សំណូក ពី …
និង យ៉ាង ធ្ងន់ធ្ងរ បែប នេះ ។
ឯកឧត្តម កុយ ស៉ី ឌឿន និង លោកជំទាវ ហួត សុភាព ព្រមទាំង បុត្រា បុត្រី បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ
បរិវា នៃ ព្រះពុទ្ធ សក្យ មុនី ទាំង៤ពួក ក្នុង ទីប្រជុំ បាន ឃើញ ទិដ្ឋភាព ទាំងនេះ ព្រម គ្នា ក្នុង ពេល តែ មួយ ។
ក្រៅពី នេះ សិច ក៏ មាន អត្ថប្រយោជន៍ ចំពោះ សុខភាព ផងដែរ ប្រសិនបើ ប្រព្រឹត្តិ ឱ្យ បាន ត្រឹមត្រូវ ។
តើ ពួកគេ ដោះស្រាយ ទុក្ខលំបាក ដោយ របៀប ណា ?
ក្នុង ខែវិច្ឆិកា ឆ្នាំ ២០១២ នេះ ដែរ ការិយាល័យ បណ្តុះបណ្តា សម្រេច ភារកិច្ច បាន ៖
មិន អាច សម្រេច ទឹក កាម បាន មិន ត្រឹមតែ កើតឡើង ចំពោះ បុរស ៗ
តុលាការ និង នីតិរដ្ឋ បញ្ហា ការងារ
នក់ របស់ ខុំញេ ទើប ខុប
ឃ្លាញែក ឃ្លា តម្លៃ
បើក ឬ បញ្ឈប់ បទចម្រៀង ។
ត្រូវតែ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ៖
លោក ទេស ចាន់ថុន យល់ ថា ប្រហែលជា ពលរដ្ឋ ខ្លះ មិន ដឹង ថា ស្តូប នោះ ធ្វើ សម្រាប់ អ្វី ផង ។
លោក ជូសុភ័ក្រ ប្រធាន មន្ទីរ បរិស្ថាន ខេត្ត រតនគិរី បាន បដិសេធ មិន ធ្វើ សេចក្តី អត្ថាធិប្បាយ ។
សារ៉េត អរគុណ លោក សុខ ។
ខ្ញុំ អត់ មាន ទេ វិញ្ញាសា ត្រៀម ឆមាស ។
ហេតុការណ៍ នេះ បង្កឱ្យ មាន ការភ្ញាក់ផ្អើល ឡើង កាលពី វេលា ម៉ោង ៩ ៖
ការធ្វើដំណើរ ទី ជិត ឆ្ងាយ មិន សូវ មាន សុវត្តិភាព ទេ គួរ បន្ថែម ការប្រុងប្រយ័ត្ន ។
ចំនួន អ្នកស្លាប់ ដោយ គ្រោះ បាក់ ដី នៅ ឥណ្ឌូនេស៊ី កើន ដល់ ៣៨ នាក់
វេលា ដើម្បី អាច ធ្វើដំណើរ ទៅកាន់ ហុងកុង ចូលរួម ថត ខ្សែភាពយន្ត ថ្មី នៅ ទីនោះ ។
ទោះជា យ៉ាងណា អ្នក ក៏ គួរ ចម្អិន និង លាង សម្អាត បន្លែ ឱ្យ បាន ត្រឹមត្រូវ មុននឹង ទទួលទាន ដើម្បី ស្រួល រំលាយ ។
ប្រហែល ដូច្នោះហើយ ភ្ញៀវ ទេសចរណ៍ មិន ទាន់ ឃ្លាត ឆ្ងាយ ទីនេះ ផង បែរជា នឹករលឹក ដល់ ភូមិ ឡាក់ ហើយ ៕
រូបភាព ចំណុច ទី ៧បង្ហាញ ថា អ្នកបង្កើត ប្លុក វា និង ដំណើរការវា រួចរាល់ ហ្យើ
លុបបំបាត់ បទល្មើស នេសាទ
ទាំងនោះ ដូច អ្វី ដែល នាង ធ្លាប់ បាន ទទួល ។
គ្រឿងញៀន មេតំហ្វេតាមីន ៣០ គីឡូក្រាម បង្កប់ ក្នុង កញ្ចប់ តែ ចំនួន ២៩ កញ្ចប់
អូស្ត្រាលី បញ្ឈប់ ការអភិវឌ្ឍ វ៉ាក់សាំង កូវីដ ដោយសារ បញ្ហា ធំ មួយ
កីឡា ថ្ងៃអាទិត្យ វា ដូចជា ព្រះចន្ទ ពេញ បូណ៌មី អញ្ចឹង !
ចាន់ ស៊ី ជា ប្រធាន ក្រុមប្រឹក្សា រដ្ឋមន្ត្រី នាយក រដ្ឋមន្ត្រី នៃ របប សាធារណរដ្ឋ ប្រជាមានិត កម្ពុជា បាន ប្រមាណ ៣ឆ្នាំ ៖
គណបក្ស នយោបាយ ចំនួន ១២ ដែល ចូលរួម ក្នុង ការបោះឆ្នោត ឆ្នាំ នេះ សុទ្ធតែ បាន ចេញ ឃោសនា តាម មធ្យោបាយ រៀង ៗ
អ្នកស្រី សុផល បាន ត្អូញត្អែរ ថា បើ មិន លក់ បាន លុយ ឯណា ចិញ្ចឹម កូន ឱ្យ រៀនសូត្រ និង រស់ នៅ រាល់ ថ្ងៃ នោះ ។
ពេលវេលា កំណត់ បាន ផុត កំណត់ កាលពី ម្សិលមិញ ដោយ គិត ទាំង ថ្ងៃ ឈប់សម្រាក សាធារណៈ ។
មិន ទាន់ មាន សេចក្តីរាយការណ៍ ពី ផទ្ធផល នៅឡើយ តែ បើ ចុះ គគ្រឹក គ្រេង ចឹង ច្រើន តែ អត់ បាន ការ អី ឡើយ ៕
ដទៃ ទៀត ហើយ ក្រុម អ្នកវិទ្យាសាស្ត្រ អាច ប្រើប្រាស់ ឧបករណ៍ ដ៏ សម្បូរបែប និង ទំនើប ៗ
មណ្ឌលគិរី បញ្ជួន យោធា ៥០ នាក់ ទៅ តំបន់ អូរ អាឡៃ ដើម្បី កាពារ ទឹកដី
សំណង់ ខុស ច្បាប់ កាន់តែ ច្រើន នៅ តំបន់ រមណីយដ្ឋាន អង្គរ បាន ក្លាយជា កង្វល់ របស់ អាជ្ញាធរ អប្សរា ។
បន្ទាប់ពី ជនរងគ្រោះ ដឹងខ្លួន គួរ បញ្ជូន គាត់ ទៅ ពិនិត្យ បន្ត នៅ មន្ទីរពេទ្យ ដើម្បី ព្យាបាល បន្ត ។
លោក ទេព ពុំ សែន អធិការ ស្រុក ពួក បាន ឆ្លើយតប តាម ទូរស័ព្ទ ថា ដោយសារ ការងារ ច្រើន ពេក ធ្វើឱ្យ ការបង្ក្រាប បទល្មើស មិន បាន គ្រប់ ជ្រុងជ្រោយ តែ លោក នឹង ចាត់ វិធានការ ឱ្យ បាន និង សុំ ឱ្យ អ្នកសារព័ត៌មាន ជួយសហការ ដើម្បី ភូមិ ឃុំ មាន សុវត្ថិភាព ។
ប្រុស ម្នាក់ និង ស្រី ម្នាក់ ត្រូវបាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ អាការៈ ពុល អាហារ ដែល ធ្ងន់ធ្ងរ ។
នៅ ថ្នាក់ ស្រុក នៅ តាម ការរិយាល័យ ថ្នាក់ ស្រុក ជាដើម ។
នាងខ្ញុំ ក៏ ព្យាយាម ចូលទៅ ធ្វើ ទំនាក់ទំនង និង យក គេ មក ធ្វើជា របស់ នាងខ្ញុំ ឱ្យ ខាងតែ បាន ។
