អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល ១៣ ថ្ងៃ នេះ ៕
លោក កឹម សុខា កំពុង ធ្វើ សកម្មភាព បំពាន លើ ការសម្រេច របស់ តុលាការ - ស៊ីស៊ី ថា មស៍
ព្រះមិន បាន បង្កើត សាថាន ជា ទេវតា អាក្រក់ ទេ ។
នៅក្នុង ព្រឹត្តិការណ៍ តាំងពិព័រណ៍ រថយន្ត ដ៏ អស្ទារ្យ នោះ មាន ក្រុមហ៊ុន រថយន្ត ល្បី ៗ
ដូចជា បញ្ឈប់ ការប្រើប្រាស់ ឧបករណ៍ អេឡិចត្រូនិក ជាដើម ។
អ្នកស្រី បាន លើកឡើង ថា អ្នក យក ភាស៊ី ម្នាក់ ដើរ ចេញ មិន ទាន់ ផុត ពី កន្លែង លក់ ផង ស្រាប់តែ មាន ម្នាក់ ទៀត មក យក បន្ត ពីក្រោយ ។
នេះ ត្រូវ គ្នា ទៅនឹង ការព្យាករ នេះ ។
សូម លោក យក ពិធី មង្គលការរឺ ពិធី បុណ្យ សព ក្នុង
នីកូឡាស ប៉េប៉េ មកដល់ ទីក្រុង ឡុង ដើម្បី ពិនិត្យ …
អនុញាតិ ឱ្យ កូន លេង ព្រោះ វា ដើរ តួនាទី ជា លំហាត់ប្រាណ ។
វគ្គ បណ្តុះបណ្តាល ស្តីពី អភិបាលកិច្ច ល្អ ជូន ដល់ ជន បង្គោល ភូមិ - ឃុំ របស់ ឃុំ រណសិរ្ស ស្រុក សង្គម ថ្មី
អ្វី ដែល ស្តេច ដាវីឌលើកឡើង ជាបន្ទាប់ គឺជា ចំណុច ផ្លាស់ ប្រែ ដែល បង្វែរ ទ្រង់ ចេញ ពី ភាពទុក្ខសោក របស់ ទ្រង់ ៖
សូម្បី សុគន្ធ ថេរ៉ាយុ ក៏ ធ្លាប់ ជួប រឿង បែប នេះ ដែរ
អ្វី ទាំងអស់ ឃើញ អ្វី ទាំងអស់ ប៉ុន្តែ មិន ដកដង្ហើម ទេ ។
របស់ នគរ ភ្នំ ។
បុរស ម្នាក់ នោះ លុត ជង្គង់ នៅ ចំពោះ មុខ នាង ហើយ សុំ នាង រៀបការ ជា ផ្លូវការ ។
គាត់ តែង ទូរស័ព្ទ មក ខ្ញុំ រាល់ យប់ រាល់ ថ្ងៃ ។
យ៉ាង នេះ ក្តី លោក អះអាង ទៀត ថា ពលរដ្ឋ ដែល ការពារ គ្រឿងចក្រ ឱ្យ ក្រុមហ៊ុន នោះ ពិតជា ស្រវឹង ជោគជាំ មែន ។
ខ្ញុំ បាន បាត់បង់ កូនស្រី ម្នាក់ ដែល មាន វ័យ ជំទង់ ។
ព្រះយេស៊ូវ បាន ស្តីបន្ទោស ឱ្យ ពួក ផារិស៊ី ថា ជា អ្នក តឹងរ៉ឹង ខាង ក្រឹត្យ វិន័យ ប៉ុន្តែ …
លោក អះអាង ដែរ ថា រឿង នេះ ជា រឿង ដែល អន្តរជាតិ មាន ការចាប់អារម្មណ៍ ៕
ដូច្នេះ អ្នក គួរតែ ចំណាយ ពេល សម្រាក ឱ្យ បាន គ្រប់គ្រាន់ ទទួលទាន អាហារ ត្រឹមត្រូវ និង ពិសា ទឹក ឱ្យ បាន ច្រើន ។
លោក មានប្រសាសន៍ ថា បញ្ហា នានា នឹង ត្រូវ លើកឡើង នៅក្នុង កិច្ចសន្ទនា ជាមួយ អ្នក រាយ ការពិសេស ដែល នឹង ត្រូវ ឡើង ក្នុង ពេល ឆាប់ ៗ
បន្ទះ ឈីប ឧបករណ៍ ភ្ជាប់ ១៧ម ។
នេះ ធ្លាប់ រិះគន់ លោក សម រង្ស៊ី ប្រធាន គណបក្ស សង្គ្រោះ ជាតិ ថា មាន គោលជំហរ មិន ច្បាស់លាស់ ចំពោះ ជន អន្តោប្រវេសន៍ វៀតណាម នៅ កម្ពុជា ។
ទៀត ទាក់ទង ទៅ នឹង ការធ្វើ សៀវភៅ ការងារ ។
ឧទាហរណ៍ ការបញ្ចូល ទី ២ការពន្យ ល់ៈ ជម្រៅ អតិបរិមា សំរាប់ មែក ធាង ដែល បាន ផ្តល់ គឺ ២។
លោថា ច្បាប់ នេះ នឹង បញ្ចប់ នៅ ដើម ខែឧសភា នេះ ។
តុលាការ សម្រេច ឃុំ ខ្លួន លោក ស៊ុត ឌីណា បណ្តោះអាសន្ន
មិន សូវ មាន ទម្លាប់ ចូលចិត្ត ដៃគូ ប្រចែប្រចណ្ឌ ស្រាប់ ទេ ។
ទំព័រ មុខ ស្រាវជ្រាវ និង អភិវឌ្ឍន៍
វ៉ាវ៉ា ដា៦០ វិល មិន មាន ការ ដាក់ ប្រាក់ អាន ការពិនិត្យ ឡើងវិញ
ស្រាប់តែ ពេលនេះ ក៏ ពោល ពាក្យ ថា កុំ ភ្លេច រូប លោក បើ កម្មវិធី ផ្សេង ៗ
នាង ក៏ ពាក់ មួក ប្រពៃណី រុស្ស៊ី ផងដែរ ហើយ រូបភាព
លោកស្រី យីង ឡាក់ ពុល អាហារ
សូម រំលឹក ឡើងវិញ ថា បើ យោង តាម លោកស្រី យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ថា ៖
១លើ ១លាន ករណី កូន ភ្លោះ របស់ នារី ម្នាក់ មាន ឪពុក ២ផ្សេង គ្នា
បើ អ៊ីចឹង មែន ហេតុ អ្វី ខ្ញុំ អាច ធ្វើការ ជាមួយនឹង បុគ្គលិក របស់ ខ្ញុំ ទាំងអស់ លើកលែងតែ គាត់ ។
ទំលាយ ពី ចំណុច គួរ កត់សម្គាល់ នៅពេល បាន ជួប គូព្រេង ពិត របស់ អ្នក !
រៀន មិន ចប់ សាកលវិទ្យាល័យ តែ អាច ផលិត កុំព្យូទ័រ បាន
ការប្រើប្រាស់ ដីធ្លី មិន ត្រឹមត្រូវ អំពើពុករលួយ និង បំណុល
កាបង្ហោះ ប៉ោង ប៉ោង ឱ្យ មាន ការដោះលែង អ្នកស្រី ទេព វន្នី ។
ពុល អាហារ អាច ស្រាល និង ធ្ងន់ ដូច្នេះ កុំ ធ្វេសប្រហែស ឱ្យ សោះ
ទាំងអស់ ដើម្បី ចុះហត្ថលេខា យក គាត់ ឱ្យ ឆ្ងាយ ពី ក្រុម ប្រទេស បារាំង មួយ នេះ ។
ក្រុមការងារ យុវជន គណបក្ស ក្រសួង សង្គមកិច្ច ផ្តល់ អំណោយ ដល់ កុមារ កំព្រា
ផ្លិត ជូត កញ្ចក់ ៖
អាស្រ័យ តាម កិច្ចការ ពោលគឺ នីតិវិធី ត្រូវ កំណត់ ច្បាស់លាស់
កញ្ចប់ ទាំង ពីរ នេះ ត្រូវបាន ផ្ញើ ចេញ ពី ប្រទេស យ៉េមែន ។
ការលើកឡើង ដូចនេះ ធ្វើឡើង ក្រោយពេល លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន បញ្ជា ភ្លាម ៗ
អប្បមាទ ធម៌ ទាំងអស់ ។
រឿង ខ្លី ដើម្បី អូន ភរិយា និង ម្តាយ ម្នាក់
ដូចនេះ បានជា ខ្ញុំ និយាយ អំពី ពាណិជ្ជកម្ម បើកចំហ ។
កែ ខៃ បំផ្លិចបំផ្លាញ គេ ។
លោក វេជ្ជបណ្ឌិត ជាទីគោរព របស់ ខ្មែរ , នៅពេល ទទ … បន្ត ការអាន
តាមដាន ទាំងអស់ គ្នា !
ខណៈ ប្រជាពលរដ្ឋ កាន់តែ ច្រើន ឡើង ប្រើប្រាស់ ប្រព័ន្ធ អ៊ីនធឺណិត ប្រព័ន្ធ នេះ បាន ក្លាយជា សមរភូមិន យោបាយ សំខាន់ មួយ នៅ ប្រទេស កម្ពុជា ។
ប៉ុន្តែ ប្រសិនបើ និយាយ ឱ្យ ទូលំទូលាយ ជាង នេះ ប្រជាពលរដ្ឋ ខ្មែរ ដែល ខ្ញុំ បាន និយាយ ជាមួយ ហាក់ដូចជា មាន បំណង ដ៏ ពិតប្រាកដ មួយ ក្នុង ការចង់បាន យុត្តិធម៌ ។
លោកស្រី និយាយ ថា ការអនុម័ត មិន បាន រំលោភ លើ ច្បាប់ ទំនាក់ទំនង ជាមួយ តៃវ៉ាន់ ដែល រក្សា ការទាក់ទង របស់ អាមេរិក ជាមួយ កោះ នេះ ទេ ។
នេះ បើ យោង តាម ការ ឱ្យដឹង ពីសំណាក់ មន្ត្រី អាជ្ញាធរ ជាតិ អប្សរា ។
កម្មវិធី ជំនួយ អស្ចារ្យ - ត្រូវការ ខ្លាំង ណាស់ !
តើ លោក ហ៊ុន ម៉ាណែត ពិតជា ខ្នង បង្អែក នៃ ជន ប្រព្រឹត្ត អំពើពុករលួយ នៅក្នុង ក្រសួង ពាណិជ្ជកម្ម សព្វ ថ្ងៃ នេះ មែន ឬ ទេ ?
អ្នក មាន យល់ ថា ការងារ នាំមក នូវ ប្រាក់ ចំណូល ។
កុំ ឱ្យ លេង ពេល យប់ ព្រោះ រំខាន់ គេ ណាស់ ជាពិសេស ដូចជា រូប ខ្ញុំ ផ្ទាល់ ដែល ធ្លាប់ មាន បទពិសោធន៍ រំខាន គេ
