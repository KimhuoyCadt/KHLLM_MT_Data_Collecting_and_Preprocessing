ទំនាស់ ភាគ ច្រើន យើង ប្រើ យន្តការ ជា លក្ខណៈ គ្រួសារ ទាំងអស់ ដើម្បី យើង បន្សុាំ ជាមួយ ពួកគាត់ ជា លក្ខណៈ គ្រួសារ ជា បង ជា ប្អូន ទៅ យើង លើក ហេតុផល ទៅ ព្រោះ បងប្អូន យើង នៅ ទីនេះ លោក បាន យល់ ណាស់ អ្វី ដែល ល្អ អ្វី ដែល មិន ល្អ អ្វី ដែល យុត្តិធម៌ អ្វី ដែល មិន យុត្តិធម៌ និយាយ ទៅ លោក អាច ទទួលយក បាន ទាំងអស់ ដូចជា មិន មាន បញ្ហា អ្វី ទេ » ។
បញ្ហា ដីធ្លី ជា រឿង វិវាទ ដ៏ ក្តៅ មួយ ផងដែរ នៅក្នុង ប្រទេស កម្ពុជា នា ពេល បច្ចុប្បន្ន ។
ខេត្ត ពោធិ៍សាត់ មុនពេល លោក ម៉ៅ ធ និន ចូលទៅ គ្រប់គ្រង ក៏ កើតមាន វិវាទ ដីធ្លី ជាច្រើន ករណី ផងដែរ ។
រយៈពេល ប្រមាណ ជា ៥ ឆ្នាំ មក នេះ លោក ម៉ៅ ធ និន បាន ដោះស្រាយ វិវាទ ដីធ្លី រហូតដល់ទៅ ជាង ៤០០ ករណី ហើយ បច្ចុប្បន្ន ជម្លោះ ដីធ្លី នេះ មិន សូវ កើតមាន ទៀត នោះ ទេ ។
ចំណែក នៅក្នុង ខេត្ត បង រយៈពេល ៥ ឆ្នាំ នេះ ដូចជា ដោះ ជាង ៤០០ ករណី អា ហ្នឹង គ្រប់គ្រប់ ប្រភេទ ទាំងអស់ ។
ដី រដ្ឋ និង ប្រជាពលរដ្ឋ , សហគមន៍ និង ប្រជាពលរដ្ឋ , ដី ក្រុមហ៊ុន វិនិយោគ ជាមួយ ប្រជាពលរដ្ឋ ឬ ក៏ ក្រុមហ៊ុន ជាមួយ ប្រជាពលរដ្ឋ , ប្រជាពលរដ្ឋ និង ប្រជាពលរដ្ឋ ។
បញ្ហា ដី នេះ មិន មែន សម្តៅ តែ លើ ប្រជាពលរដ្ឋ ជាមួយ ក្រុមហ៊ុន ឬ រវាង ក្រុមហ៊ុន ជាមួយ ប្រជាពលរដ្ឋ ទេ » ។
ពាក់ព័ន្ធ នឹង វិវាទ ដីធ្លី ក៏ មាន ការលើកឡើង ផងដែរ ថា វិវាទ ដីធ្លី ខ្លះ ពិបាក ក្នុង ការដោះស្រាយ ព្រោះ វិវាទ ដីធ្លី នោះ ជា របស់ អ្នក មាន ឥទ្ធិពល ឬ មាន អំណាច ជាដើម ។
នេះ ជា ភាពយុត្តិធម៌ មួយ ដេល មនុស្ស ទូទៅ គេ ត្រូវការ ។
យើង បាន គិត ថា ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ជា គ្រួសារ យើង យើង ឈរ ជំហ ជា អ្នកដោះស្រាយ យើង លំអៀង ម្តេច កើត ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ភាព សុក្រឹត និង យុត្តិធម៌ » ។
ក្រៅពី បង្កើត យន្តការផ្តល់ ឱកាស ឱ្យ ប្រជាពលរដ្ឋ បាន ចូល ជួប រៀបរាប់ ពី បញ្ហា ដើម្បី ស្វែងរក ដំណោះស្រាយ ដោយ ផ្ទាល់ ហើយ នោះ ក្នុង ឋានៈ ជា អភិបាល ខេត្ត ពោធិ៍សាត់ លោក ម៉ៅ ធ និន បាន ដឹកនាំ អភិវឌ្ឍន៍ ខេត្ត ពោធិ៍សាត់ ឱ្យ លេចចេញ នូវ សមិទ្ធផល គួរឱ្យ កត់សម្គាល់ ជាច្រើន ទៀត ។
ក្នុង រយៈពេល ៥ ឆ្នាំ នៃ ការដឹកនាំ ខេត្ត ពោធិ៍សាត់ លោក ម៉ៅ ធ និន ក៏ បាន រួមចំណែក លើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ឱ្យ មាន ភាព ប្រសើរ ផងដែរ ។
សមិទ្ធផល ការងារ កើត ចេញ ពី កិច្ចប្រឹងប្រែង ក្នុង ការដឹកនាំ និង គ្រប់គ្រង ខេត្ត ពោធិ៍សាត់ នេះ បាន ធ្វើឱ្យ លោក ម៉ៅ ធ និន ទទួលបាន ការស្រឡាញ់ ពេញចិត្ត និង គាំទ្រ ពី ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ។
ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម ៖ ១ ៖ អាមេរិក អះអាង ដោយ ផ្ទាល់ ថា គ្រាប់ មីស៊ីល ផ្លោង កូរ៉េ ខាងជើង ពិតជា អាច បាញ់ ដល់ គ្រប់ ទិស ទី ទាំងអស់ ។
សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០១៩
តុលាការ ចេញ ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន បុរស ម្នាក់ ដាក់ ពន្ធនាគារ ក្រោយ បង្ក គ្រោះថ្នាក់ ចរាចរណ៍ បណ្ដាលឲ្យ មនុស្ស ៣ នាក់ រងរបួស នៅ ខណ្ឌ ទួលគោក
បុរស ដែល ត្រូវ តុលាការ បង្គាប់ ឲ្យ ឃុំ ខ្លួន ឈ្មោះ សេង វិច្ឆិកា អាយុ ៣៧ ឆ្នាំ មុខរបរ ជាង ជួសជុល រថយន្ដ ទៅ លំនៅ បច្ចុប្បន្ន ផ្ទះ លេខ ២១៨ អា អឺ អង ផ្លូវ ១៨២ សង្កាត់ ផ្សារ ដេប៉ូ ១ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ត្រូវ ដាក់ ឲ្យ ស្ថិត ក្រោម ការពិនិត្យ ពី បទ « បើកបរ ដោយ ធ្វេសប្រហែស ខ្ជីខ្ជា មិន ប្រុងប្រយ័ត្ន បណ្ដាលឲ្យ មាន របួស ដល់ អ្នក ដ៏ ទៃ » ។
សូម ជម្រាប ថា ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នេះ បាន កើតឡើង នៅ ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០១៩ ត្រង់ ចំណុច ផ្លូវ លេខ ៥៩៨ កែង ផ្លូវ លេខ ១៩៨៦ សង្កាត់ បឹងកក់ ២ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ បណ្តាលឲ្យ របួស ធ្ងន់ ម្នាក់ និង របួស ស្រាល ០២ នាក់ ៕
បន្ទាប់ពី បាន ស្តាប់ បទ បង្ហាញ ស្តីពី សមិទ្ធផល នានា បច្ចុប្បន្នភាព វិស័យ ស្រូវ អង្ករ និង គម្រោង រៀបចំ កម្មវិធី ខាងលើ របស់ លោក មូល សារិទ្ធី អគ្គ លេខាធិការ អង្គប្រជុំ ទាំងមូល បាន ពិភាក្សា គ្នា យ៉ាង ផុស ផុល និង ឯកភាព ទាំងស្រុង លើ ការរៀបចំ លើ កម្មវិធី នេះ តាម អ្វី ដែល បាន គ្រោង ទុក ។
ជាពិសេស អង្គប្រជុំ ក៏ បាន ពិភាក្សា និង បាន ឯកភាព ទាំងស្រុង លើ ការកែសម្រួល នីតិវិធី ខ្លះ និង រចនាសម្ព័ន្ធ របស់ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា អាណត្តិ ទី ៣ ដើម្បី ធ្វើអោយ កាន់តែ មាន ភាព កាន់តែ ប្រសើរឡើង សម្រាប់ ដំណើ ការសហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ក្នុង ការជួយ សម្រួល ដល់ សមាជិក សមាជិកា ភាគី ពាក់ព័ន្ធ និង វិស័យ ស្រូវ អង្ករ កម្ពុជា ទាំងមូល អោយ មាន ដំណើរ ទៅ មុខ ជា បន្តបន្ទាប់ តាម ផែនការ ដែល យើង បាន ដាក់ ចេញ នា ពេល កន្លងមក ។
នៅក្នុង ឱកាស នោះ ប្រធាន សហព័ន្ធ បាន ថ្លែងអំណរគុណ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រុមប្រឹក្សាភិបាល សមាជិក សមាជិកា លេខាធិការដ្ឋាន សហព័ន្ធ ក្រសួង ស្ថាប័ន និង ភាគី ពាក់ព័ន្ធ ដែល បាន ចូលរួម សហការ គ្នា ដើម្បី សម្រេចបាន នូវ សមិទ្ធផល សំខាន់ ៗ ទាំងនេះ សម្រាប់ ជួយ ដល់ សមាជិក ក៏ ដូចជា វិស័យ ស្រូវ អង្ករ កម្ពុជា ទាំងមូល ។
លោក ក៏ បាន សង្កត់ធ្ងន់ ដែរ ថា សហព័ន្ធ យើង ត្រូវ បន្ត នីតិវិធី និង បន្ត ធ្វើ ការពាក់ព័ន្ធ ការប្តឹង តវ៉ា របស់ យើង ទៅកាន់ តុលាការ សហភាព អឺរ៉ុប ចំពោះ ការដាក់ ពន្ធ លើ អង្ករ កម្ពុជា ដែល បាន ដាក់ ពាក្យ បណ្តឹង រួចហើយ នា ពេល កន្លងមក ។
អង្គប្រជុំ បាន បញ្ចប់ ប្រកបដោយ លទ្ធផល ល្អ និង មាន ភាពស្និទ្ធស្នាល ក្រៃលែង ៕
អ្នកវិទ្យាសាស្ត្រ នូវែលសេឡង់ ៖ សត្វ ត្រី រាប់ រយ ប្រភេទ អាច « ប្តូរ ភេទ » របស់ ពួកវា ឲ្យ ស្រប ទៅ តាម បរិស្ថាន
នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នា ថ្ងៃសុក្រ ទី ១២ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
បើ យោង តាម ការស្រាវជ្រាវ ថ្មី ខាងលើ បាន ឲ្យដឹង ថា ច្បាស់ជា មាន សញ្ញា អ្វី ម៉្យាង ដែល ជះ ឥទ្ធិពល ទៅ លើ ហ្សែន របស់ ពួក ត្រី ដែល អាច ប្រែ ភេទ ទាំងនោះ ។
ការអង្កេត លើ ប្រភេទ ត្រី ក្បាល ខៀវ ម្យ៉ាង ដែល រស់ នៅ ជា ក្រុម តាម ផ្កា ថ្ម នៃ តំបន់ សមុទ្រ ការី បៀន បាន បង្ហាញ លទ្ធផល គួរឲ្យ ចាប់អារម្មណ៍ ។
ត្រី ញី នោះ ផ្លាស់ប្តូរ អាកប្បកិរិយា ក្នុង រយៈពេល តែ ប៉ុន្មាន នាទី ប៉ុណ្ណោះ ហើយ ពណ៌ របស់ វា នឹង ប្រែ ក្នុង រយៈពេល ត្រឹម ប៉ុន្មាន ម៉ោង ។
ចំណែកឯ សរីរាង្គ បន្ត ពូជ របស់ សត្វ ត្រី ញី នោះ នឹង ប្រែក្លាយជា សរីរាង្គ បន្ត ពូជ ឈ្មោល ហើយ ក្នុង រយៈពេល ១០ ថ្ងៃ វា នឹង អាច បង្កើត មេជីវិត ឈ្មោល បាន ។
អ្នកស្រាវជ្រាវ បាន និយាយ ថា ការស្រាវជ្រាវ នេះ គឺ មាន សារៈសំខាន់ សម្រាប់ ការយល់ដឹង ពី របៀប ដែល ហ្សែន ត្រូវបាន ប្រែប្រួល ក្នុង អំឡុង ពេល នៃ ការវិវឌ្ឍន៍ របស់ សត្វ ទាំងអស់ រួមទាំង មនុស្ស ផងដែរ និង ដើម្បី យល់ដឹង ថា តើ បរិស្ថាន អាច ជះ ឥទ្ធិពល អ្វី ខ្លះ ដល់ ដំណើរការ ប្តូរ ភេទ ដ៏ មិន គួរឲ្យ ជឿ បែប នេះ ៕
លោក វេង សាខុន នាំយក ទេយ្យ ទាន ទៀន ព្រះវស្សា គ្រឿង ឧបភោគ បរិភោគ និង បច្ច័យ ប្រគេន ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា នៅ វត្ត ចំនួន បួន នៅ ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម
ឆ្លៀត យក ឱកាស នេះ លោក រដ្ឋមន្ត្រី បាន សំណេះសំណាល ជាមួយ ចៅអធិការ វត្ត ព្រះសង្ឃ តា ជី យាយ ជី និង ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ដោយ បាន សួរនាំ ពី ការងារ បង្កបង្កើន ផល បញ្ហា ជីវភាព ប្រចាំ ថ្ងៃ បញ្ហា សុខភាព ការ សិក្សារ រៀនសូត្រ របស់ បុត្រធីតា ក្រោម ដំបូល សន្តិសុខ សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ នៅ មូលដ្ឋាន បាន ល្អ ប្រសើរ ។
ក្រៅពី នេះ លោក ក៏ បាន ជម្រាប ជូន ផងដែរ ពី ការវិវឌ្ឍ រីកចម្រើន របស់ ប្រទេសជាតិ ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី ទាំង វិស័យ ពុទ្ធ ចក្រ និង អាណាចក្រ ដោយ ផ្តោត ជា សំខាន់ ពី ការរីកចម្រើន លើ វិស័យ កសិកម្ម សេដ្ឋកិច្ច ទេសចរណ៍ ហេដ្ឋារចនាសម្ព័ន្ធ គ្រប់ បែប យ៉ាង ដែល ជា ចលករ ជួយ ទ្រទ្រង់ និង ជំរុញ កំណើន សេដ្ឋកិច្ច ជាតិ ។
ហេតុ ដូច្នេះ លោក បាន ស្នើសុំ ឲ្យ ប្រជាពលរដ្ឋ មេត្តា បន្ត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា និង ចូលរួម ថែរក្សា ឲ្យបាន នូវ សុខ សន្តិភាព ស្ថិរភាព និង សមិទ្ធផល របស់ ជាតិ ឲ្យបាន គង់វង្សត រៀង ទៅ ។
លោក បាន បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ គុណ កែវ ទាំង បី និង វត្ថុ ស័ក្តិ សិទ្ធិ ក្នុង លោក សូម តាម ជួយ ថែរក្សា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី សម្តេច មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា និង ជូនពរ សម្តេច ទាំង បី ឲ្យ មាន សុខភាព ល្អ បរិបូរណ៌ កំលាំង មាំ មួន បញ្ញា ញាណ ភ្លឺ ថ្លា និង អាយុ យឺន យូរ ដើម្បី បន្ត ដឹកនាំ នាវា កម្ពុជា ឆ្ពោះទៅ មុខ ប្រកបដោយ វឌ្ឍនភាព សុខ សន្តិភាព ស្ថិរភាព សេចក្តីសុខ ចម្រើន និង ការអភិវឌ្ឍ ៕
សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ ទទួល ធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ សាកលវិទ្យាធិការ នៃ បណ្តាញ សាកលវិទ្យាល័យ អាស៊ាន លើក ទី ១១ និង កិច្ចប្រជុំ ក្រុមប្រឹក្សាភិបាល សាកលវិទ្យាល័យ លើក ទី ៣៥
កិច្ចប្រជុំ នេះ ធ្វើឡើង រយៈពេល ពីរ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១១ ដល់ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០១៩ នៅ ខេត្ដ សៀមរាប ។
លោក ក៏ បាន ជម្រុញឲ្យ មាន នូវ កិច្ចសហប្រតិបត្តិការ ក្នុង តំបន់ និង អន្តរជាតិ ធ្វើ យ៉ាងណា សិក្សា និង ចែករំលែក ផល ប៉ះពាល់ ជា សកល ក្នុង វិស័យ អប់រំ កម្រិត ឧត្តម សិក្សា និង វិធីសាស្រ្ត ថ្មី ៗ ដើម្បី អភិវឌ្ឍ យុទ្ធសាស្ត្រ ជាក់ស្តែង ធ្វើឲ្យ វិស័យ អប់រំ មាន គុណភាព កាន់តែ ល្អ ប្រសើរឡើង ថែម ទៀត ។
លោក បាន បន្ដ ថា កិច្ចប្រជុំ នេះ មាន គោលបំណង ចែករំលែក ចក្ខុវិស័យ បេសកកម្ម និង យុទ្ធសាស្រ្ត របស់ សាកលវិទ្យាល័យ ស្រប តាម គោលដៅ របស់ រាជ រដ្ឋាភិបាល ឆ្នាំ ២០៣០ និង ២០៥០ និង គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ និរន្តរភាព ( SDGs ) ។
