ជាក់ស្ដែង នៅក្នុង ឆ្នាំ ២០១៨ ក្រុមហ៊ុន របស់ លោក ឧកញ៉ា ភូ ពុយ នាំ អង្ករ ក្រអូប ទៅ ក្រៅ ប្រទេស ប្រមាណ ជា ជិត ៦ ម៉ឺន តោន ។
បន្ថែម ពីលើ ទីផ្សារ ឥណ្ឌូណេស៊ី កម្ពុជា មាន គម្រោង នាំចេញ អង្ករ ទៅកាន់ ទីផ្សារ អាហ្រ្វិក នា ពេល ខាងមុខ ដែរ ខណៈ បច្ចុប្បន្ន កម្ពុជា ក៏ បាន នាំ អង្ករ ទៅកាន់ ប្រទេស មួយចំនួន នៅក្នុង ទ្វីប អាហ្វ្រិក ដូចជា ហ្គា បុង , ហ្គាណា , តូហ្គោ , កេន យ៉ា , ណាមី បៀ ជាដើម ។
ការសម្លាប់ រង្គាល នៅ អតីត យូហ្គោស្លា វី ៖ តុលាការ កំពូល ហូឡង់ កាត់បន្ថយ ការទទួលខុសត្រូវ របស់ រដ្ឋាភិបាល
តុលាការ កំពូល ហូឡង់ នៅ ថ្ងៃសុក្រ ម្សិលមិញ បាន សម្រេច ថា រដ្ឋាភិបាល ហូឡង់ រួមចំណែក ខុស ត្រូវ មួយ ផ្នែក ក្នុង រឿង សម្លាប់ រង្គាល របស់ ទាហាន ស៊ែប ទៅ លើ ប្រជាជន អ៊ីស្លាម នៅ បូស្នី កាលពី ឆ្នាំ ១៩៩៥ ។
ជា រួម តុលាការ កំពូល ហូឡង់ បាន សម្រេច កាត់បន្ថយ ការទទួលខុសត្រូវ របស់ រដ្ឋាភិបាល ពី ៣០ ភាគរយ មក នៅ ត្រឹម ១០ ភាគរយ ប៉ុណ្ណោះ ។
សូម រំលឹក ថា នៅក្នុង បេសកកម្ម រក្សា សន្តិភាព នៅក្នុង អំឡុង សង្រ្គាម ស៊ីវិល នៅ អតីត យូហ្គោស្លាវី ក្រុម ទាហាន មួក ខៀវ មកពី ប្រទេស ហូឡង់ បាន អនុញ្ញាតឲ្យ ទាហាន ស៊ែប ចូលទៅ ជម្លៀស យក ជនភៀសខ្លួន ពី ជំរំ គ្រប់គ្រង របស់ ខ្លួន ។
តុលាការ កំពូល ហូឡង់ បាន កាត់បន្ថយ ការទទួលខុសត្រូវ របស់ រដ្ឋាភិបាល ហូឡង់ ពី ៣០ មក នៅ ត្រឹម ១០ ភាគរយ វិញ ក្នុង ហេតុផល ថា សំណាង របស់ ជនភៀសខ្លួន ដើម្បី គេចខ្លួន ផុត ពី ការតាម ប្រមាញ់ របស់ ទាហាន ស៊ែប នៅ បូស្នី គឺ មាន តិច មែនទែន នៅ ជំនាន់ នោះ ។
ក្រសួង ការពារ ជាតិ ហូឡង់ នៅ ថ្ងៃសុក្រ បាន អះអាង ថា គេ ទទួលយក ការសម្រេចចិត្ត របស់ តុលាការ កំពូល ក្នុង រឿង សង ជម្ងឺចិត្ត ដល់ ជនរងគ្រោះ ។
ស្លាប់ ២ នាក់ និង បាត់ខ្លួន ១២ នាក់ ក្នុង ហេតុការណ៍ ផ្ទុះ រោងចក្រ ហ្គាស នៅ ប្រទេស ចិន
នា ល្ងាច ថ្ងៃសុក្រ ទី ១៩ កក្កដា នេះ ការផ្ទុះ មួយ បាន កើតឡើង នៅ រោងចក្រ ហ្គាស មួយ កន្លែង ក្នុង ខេត្ត ហៃ ណាន ប្រទេស ចិន ។
វា ការផ្ទុះ ដែល មាន កម្លាំង ខ្លាំង ជះ ចំហាយ ក្នុង រង្វង់ ៣ គីឡូម៉ែត្រ ក្រឡា ។
សេចក្ដីរាយការណ៍ ពី សារព័ត៌មាន ចិន បញ្ជាក់ ថា មាន មនុស្ស ២ នាក់ ស្លាប់ និង ១២ នាក់ កំពុង បាត់ខ្លួន ។
រោងចក្រ ដែល ជួប ហេតុការណ៍ អាក្រក់ នេះ គឺ រោងចក្រ ហៃ ណាន ហ្គាស ធ្យូងថ្ម ។
ហើយ ហេតុការណ៍ ផ្ទុះ ដែល កើតឡើង នៅ វេលា ម៉ោង ៥ និង ៥០ នាទី ល្ងាច ម៉ោង នៅក្នុង ប្រទេស ចិន បាន បញ្ឈប់ សកម្មភាព នៅក្នុង រោងចក្រ នេះ ទាំងស្រុង ។
នៅក្នុង រង្វង់ បី គីឡូម៉ែត្រ ក្រឡា ចំហាយ នៃ ការផ្ទុះ ចេញ ពី រោងចក្រ បាន កម្ទេច ទ្វារ និង បង្អួច នៃ អគារ ជាច្រើន កន្លែង ។
វីដេអូ ខ្លះ ទៀត បង្ហាញ ពី ការខូចខាត នៃ អគារ និង ផ្ទះសម្បែង ដែល នៅក្បែរ ៗ រោងចក្រ នោះ ។
ទ្វារ បង្អួច ត្រូវ កម្ទេច ដោយសារ ចំហាយ នៃ ការផ្ទុះ ហើយ មនុស្ស ជាច្រើន នាក់ ត្រូវ គេ ថត ឃើញ មាន របួស ឈាម ហូរ ស្រោច ខ្លួន ។
អាជ្ញាធរ ចិន បាន បញ្ជាក់ ថា មាន មនុស្ស ច្រើន នាក់ ណាស់ ដែល រងរបួស ដោយសារ ហេតុការណ៍ នេះ ។
ក្រុម សង្គ្រោះ បាន បន្ត បញ្ជូន អ្នករបួស ឲ្យ ទៅ ព្យាបាល ខ្លួន នៅឯ មន្ទីរពេទ្យ ។
គួរ កត់សម្គាល់ ថា ឧបទ្ទវហេតុ អាក្រក់ នៅ តាម បណ្ដា រោងចក្រ នានា មិន មែន ជា រឿង ចម្លែក ទេ នៅ ប្រទេស ចិន ដោយសារតែ វិធានការ ការពារ សុវត្ថិភាព នៅ មិន ទាន់ ត្រូវបាន អនុវត្ត ពេញលេញ ត្រឹមត្រូវ ។
មាន មនុស្ស យ៉ាងហោចណាស់ ២៤ នាក់ ត្រូវ ស្លាប់ និង ២១ នាក់ ផ្សេង ទៀត របួស ដោយសារ ឧបទ្ទវហេតុ ធ្លាយ ហ្គាស ក្នុង រោច ក្រ មួយ កន្លែង នៅ ភាគ ខាងជើង ទីក្រុង សៀង ជា គូ ។
ហេតុការណ៍ ធ្ងន់ធ្ងរ មួយ ទៀត កើតឡើង នៅ ឆ្នាំ ២០១៥ ។
កាល ណោះ នៅ ភាគ ខាងជើង ទីក្រុង ធាន ជីន រោងចក្រ គីមី មួយ កន្លែង បាន ផ្ទុះ សម្លាប់ មនុស្ស អស់ ១៦៥ នាក់ ៕
របាយការណ៍ ដែល ជា ការស្រាវជ្រាវ ពី ខែកុម្ភះ រហូតដល់ ខែមេសា ឆ្នាំ ២០១៩ បង្ហាញ ឲ្យ ឃើញ ថា ក្រុម ស្ត្រី ទាំងនោះ ភាគ ច្រើន ទទួល រង អំពើហិង្សា ពី គ្រួសារ ។
របាយការណ៍ ដដែល បាន រៀបរាប់ ពី ស្ថានភាព ហិង្សា នីមួយ ៗ បន្ថែម ទៀត ថា ក្រុម ស្ត្រី ដែល ទទួល រង អំពើហិង្សា លើ ផ្លូវចិត្ត នោះ ក៏ ព្រោះតែ នៅក្នុង ស្ថានភាព គ្រួសារ ស្ត្រី ទាំងនោះ រមែង ទទួលបាន ការរើសអើង និង មិន ទទួលបាន ការរាប់ រក ពី សមាជិក គ្រួសារ ទេ នេះ គឺ កើតឡើង នៅ ពេល ដែល ពួកគាត់ បង្ហាញ ពី អត្តសញ្ញាណ យេនឌ័រ របស់ ខ្លួន ។
ឯ អំពើហិង្សា លើ ផ្លូវភេទ វិញ គឺ កើតឡើង នៅ ពេល ក្រុម ស្ត្រី LBT ត្រូវបាន សមាជិក ក្រុមគ្រួសារ របស់ ពួកគាត់ បង្ខិតបង្ខំ ឲ្យ រៀបអាពាហ៍ពិពាហ៍ ជាមួយ បុរស ដែល ពួកគាត់ មិន ស្រលាញ់ ។
ក្រៅពី អំពើហិង្សា លើ ផ្លូវចិត្ត និង ផ្លូវភេទ នោះ ក៏ មាន អំពើហិង្សា លើ ផ្លូវកាយ ដែល ក្រុម ស្ត្រី ទាំងនោះ ទទួល រង ការវាយដំ ពី សមាជិក គ្រួសារ ក៏ ដូចជា អំពើហិង្សា លើ សេដ្ឋកិច្ច ដែល ក្រុម ស្ត្រី ទាំងនោះ ត្រូវបាន ឪពុក ម្ដាយ ដកហូត ទ្រព្យសម្បត្តិ មិន ឲ្យ ប្រើប្រាស់ ឬ ចាយវាយ ជាដើម ។
ក្រោម រូបភាព នៃ ការរើសអើង មើលងាយ ស្អប់ខ្ពើម ដែល ចេញមក ពី គ្រួសារ ទាំង នេះ ការស្រាវជ្រាវ បាន បញ្ជាក់ ថា ជាទូទៅ ក្រុម ស្ត្រី LBT រមែង តែ ទទួលបាន ការបាក់ ទឹកចិត្ត ចំពោះ ខ្លួន ឯង ។
បុរស កូរ៉េ ខាងត្បូង ម្នាក់ ដុត សម្លាប់ ខ្លួន ឯង មុខ ទូត ជប៉ុន ព្រោះ ជម្លោះ ស្ដីពី ការប្រើ កម្លាំង ពលកម្ម ដោយ បង្ខំ
ជម្លោះ រវាង ជប៉ុន និង កូរ៉េ ខាងត្បូង តាំងពី ជិត មួយ សតវត្សរ៍ ទៅ ហើយ នៅតែ អូសបន្លាយ រហូតមក ទល់ បច្ចុប្បន្ន ។
បុរស ដែល ដុត ខ្លួន ឯង នៅមុខ ស្ថានទូត ជប៉ុន គឺជា ជនរងគ្រោះ ម្នាក់ នៃ អំពើ ទាសភាព ក្នុង សម័យ សង្គ្រាម លោក លើក ទី ២ ។
ក្នុង ពេល ធ្វើដំណើរ ទៅ ដុត ខ្លួន ឯង បុរស កូរ៉េ ខាងត្បូង វ័យ ៧០ ឆ្នាំ រូប នេះ ប្រាប់ អ្នក ស្គាល់ គ្នា តាម ទូរសព្ទ ថា ទង្វើ របស់ គាត់ គឺជា សក្ខីភាព នៃ ការប្រឆាំង តវ៉ា នឹង ប្រទេស ជប៉ុន ។
ប្រទេស ជប៉ុន និង កូរ៉េ ខាងត្បូង មាន ជម្លោះ នឹង គ្នា នៅក្នុង សំណុំរឿង ការប្រើប្រាស់ កម្លាំង ពលកម្ម ដោយ បង្ខំ នៅក្នុង សម័យ សង្គ្រាម លោក លើក ទី ២ ។
កូរ៉េ ខាងត្បូង ទាមទារ ឲ្យ ជប៉ុន សារភាព ទទួលស្គាល់ ពី កំហុស របស់ ខ្លួន និង ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ ដល់ ពលរដ្ឋ កូរ៉េ ខាងត្បូង ដែល បាន បម្រើ ការងារ ឲ្យ ជប៉ុន នៅក្នុង សម័យ នោះ ។
ជម្លោះ ការទូត នេះ បាន ប្រែក្លាយទៅជា ជម្លោះ ពាណិជ្ជកម្ម កាលពី ដើម ខែកក្កដា នេះ បន្ទាប់ពី ជប៉ុន បាន ប្រកាស រឹតបន្តឹង លក្ខខណ្ឌ នៃ ការនាំចេញ គ្រឿង បន្លាស់ អេឡិចត្រូនិក ទៅ កូរ៉េ ខាងត្បូង ។
ការរឹតបន្តឹង នេះ បាន ធ្វើឲ្យ ក្រុមហ៊ុន បច្ចេកវិទ្យា កូរ៉េ ខាងត្បូង រង ផល ប៉ះពាល់ យ៉ាង ខ្លាំង ។
ជា ការឆ្លើយតប វិញ និង ដើម្បី បញ្ជាក់ ពី សេចក្ដីស្នេហាជាតិ ពលរដ្ឋ កូរ៉េ ខាងត្បូង បាន ធ្វើ ពហិការ មិន ទទួលទាន ស្រាបៀរ របស់ ជប៉ុន ។
ការលក់ ស្រាបៀរ ជប៉ុន ដែល ធ្លាប់ តែ ពេញនិយម នៅ កូរ៉េ ខាងត្បូង បាន ធ្លាក់ចុះ ប្រមាណ ២៥ ភាគរយ នៅក្នុង រយៈពេល ពីរ សប្ដាហ៍ ដើម ខែកក្កដា នេះ ។
នៅក្នុង រយៈពេល ដូចគ្នា ដែរ ការលក់ ស្រាបៀរ របស់ កូរ៉េ ខាងត្បូង ខ្លួន ឯង កើនឡើង ប្រមាណ ៧ ភាគរយ ។
អ្នកជំនាញ ផ្នែក ទីផ្សារ បាន គូសបញ្ជាក់ ថា ការប្រែប្រួល ដូច្នេះ មិន ធ្លាប់ មាន ពីមុន មក ទេ ។
មិន លក់ ស្រាបៀរ ជប៉ុន គឺជា ការខាតបង់ ដ៏ ធំ មួយ សម្រាប់ ម្ចាស់ ហាង ប៉ុន្តែ ពួកគេ មិន ស្ដាយ ក្រោយ ទេ ដោយ ចាត់ទុក ការសម្រេចចិត្ត របស់ ខ្លួន ថា ជា ការលះបង់ ដើម្បី ជាតិ ៕
សាច់ ជ្រូក នៅ ចិន ឡើង ថ្លៃ ផង និង ត្រូវ បង្កើន ការនាំចូល ផង ដោយសារ ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក
ការ កម្ទេច សត្វ ជ្រូក ដោយសារ ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក បាន បង្ខំ ឲ្យ តម្លៃ សាច់ ជ្រូក នៅក្នុង ប្រទេស នេះ ឡើង ថ្លៃ យ៉ាង គំហុក ។
អ្នកជំនាញ ផ្នែក វិទ្យាស្ថាន សាច់ ជ្រូក របស់ បារាំង បាន ព្រមាន ថា ស្ថានការណ៍ នៅ ប្រទេស ចិន អាចនឹង វិវត្ត កាន់តែ អាក្រក់ ជាង នេះ ទៅ ទៀត ក្នុង អំឡុង ពេល កន្លះ ឆ្នាំ ទៅ មុខ ។
យ៉ាងណា ក៏ដោយ តួលេខ ជាក់ស្ដែង នៃ ចំនួន សត្វ ជ្រូក ដែល ឆ្លង ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក ត្រូវ គេ ជឿ ថា មាន ច្រើន លើស នេះ ឆ្ងាយ ណាស់ ។
នៅក្នុង រយៈពេល ៦ ខែ ចុងក្រោយ នេះ ចំនួន សត្វ ជ្រូក ចិញ្ចឹម របស់ ចិន ថយចុះ ពី ជិត ៣៥០ លាន ក្បាល មក នៅ ត្រឹម ប្រមាណ ២៩០ លាន ក្បាល ប៉ុណ្ណោះ ។
គ្រាន់តែ នៅក្នុង ខែមិថុនា កន្លងទៅ ថ្មី ៗ នេះ តម្លៃ សាច់ ជ្រូក នៅ ប្រទេស ចិន កើនឡើង គុណ នឹង ៥ ។
កន្លះ ឆ្នាំ ទៅ មុខ ដែល តម្លៃ សាច់ ជ្រូក អាច ហក់ ឡើង ខ្ពស់ ជាង នេះ រហូតដល់ទៅ ជាង ៤០ ភាគរយ ។
អ្នកជំនាញ រូប នេះ ពន្យល់ បន្ត ថា ឥឡូវនេះ អ្វី ដែល ធ្លាក់ចុះ គឺ ចំនួន សត្វ ជ្រូក ចិញ្ចឹម ។
និង ថា នៅ ទីបំផុត អ្វី ដែល អាក្រក់ នោះ គឺ ការបរិភោគ ធ្លាក់ចុះ ដែល អាច ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច ។
សូម ជម្រាប ថា ដើម្បី បំពេញ តម្រូវការ ក្នុង ស្រុក ចិន ដែល ជា ប្រទេស ទទួលទាន សាច់ ជ្រូក ច្រើន ជាង គេ លើ លោក បាន សម្រេច បង្កើន ការនាំចូល សាច់ ជ្រូក ពី បរទេស ។
នៅក្នុង រយៈពេល ៤ ខែ ដើម ឆ្នាំ ២០១៩ នេះ ការនាំចូល សាច់ ជ្រូក ពី សហភាព អឺរ៉ុប ទៅកាន់ ប្រទេស ចិន បាន កើនឡើង ចំនួន ៣៧ ភាគរយ ។
ក្រៅពី អឺរ៉ុប ប្រទេស ប្រេស៊ីល ក៏ បាន ក្លាយជា ប្រភព នាំចូល សាច់ ជ្រូក ដ៏ សំខាន់ មួយ របស់ ចិន ផងដែរ ៕
ការិយាល័យ ឧត្តម ស្នងការទទួលបន្ទុក សិទ្ធិ មនុស្ស នៅ កម្ពុជា ហៅ កាត់ ថា OHCHR បាន ចេញផ្សាយ របាយការណ៍ កម្រាស ជិត ៤០ ទំព័រ ក្រោម ចំណងជើង ថា តុលាការ ប្រជាជន ការបង្ការ និង ការឆ្លើយតប ចំពោះ ការកាត់ទោស ដោយ មហាជន ។
សំណុំរឿង ដែល កាត់ទោស ដោយ តុលាការ ប្រជាជន រួមមានៈ បទល្មើស លួច ករណី បង្ក គ្រោះថ្នាក់ ចរាចរណ៍ និង អំពើ អាប ធ្មប់ ជាដើម ។
ដោយឡែក ចំនួន សេសសល់ ពី នេះ ប្រមាណ ជា ១៦ ករណី ទៀត គឺជា ការរង របួស និង រង ការយាយី ។
នេះ ក៏ ដោយសារ ថា សំណុំរឿង នេះ ទទួលបាន ការចាប់អារម្មណ៍ តិចតួច នៅឡើយ ពី សាធារណៈ ជន ខណៈ និទណ្ឌភាព កើត ចេញ ពី អំពើ នេះ នៅតែ កើតមាន ។
គ្មាន ទំនុកចិត្ត ពី មន្ត្រី នគរបាល ប្រព័ន្ធ តុលាការ និង ប្រព័ន្ធ គ្រប់គ្រង ពន្ធ គារ ទើប ជា បច្ច័យ ជំរុញ ឲ្យ ការកាត់ទោស ដោយ តុលាការ មហាជន ។
កម្ពស់ ទឹក ទន្លេ មេគង្គ ក្នុង កំឡុង ពេល រដូវ ទឹក ជំនន់ នៅ ដើម ខែមិថុនា ដល់ ខែកក្កដា នេះ ស្ថិត នៅក្នុង កម្រិត ទាប បំផុត ក្នុង កំណត់ត្រា ដែល មិន ធ្លាប់ មាន នា រយៈពេល ២៧ ឆ្នាំ ចុងក្រោយ នេះ ។
មន្ត្រី ធនធាន ទឹក កម្ពុជា មិន ជឿ ថា បញ្ហា នេះ ជាប់ពាក់ព័ន្ធ ទៅនឹង ការបង្ខាំង ទឹក ទុក សម្រាប់ ដំណើរការ វារី អគ្គិសនី នោះ ទេ ។
ស្ថានភាព ទឹក ដែល មាន កម្រិត ទាប នេះ គឺ គិត ចាប់ពី ស្រុក ឆាង សែន ភាគ ខាងជើង ប្រទេស ថៃ មក ខេត្ត លួង ព្រះបាង និង ក្រុង វៀង ចន្ទន៍ របស់ ប្រទេស ឡាវ ហើយ បន្ត ចុះ មក អ្នកលឿង ប្រទេស កម្ពុជា ។
លោក ចាន់ យុត្ថា អ្នកនាំពាក្យ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ថ្លែង ប្រាប់ វិទ្យុ បារាំង អន្តរជាតិ ថា ស្ថានភាព ជាក់ស្តែង នា ពេលនេះ គឺ ទឹក ទន្លេ មេគង្គ មាន កម្រិត ទាប ជាង បណ្តា ឆ្នាំ កន្លងទៅ មិន ថា តែ នៅក្នុង ប្រទេស កម្ពុជា ទេ ។
ក្រៅពី នេះ ក៏ ដោយសារតែ បរិមាណ ទឹក ហូរ ពី ផ្នែក ខាងលើ នៃ អាង ទន្លេ មេគង្គ ដែល គេ ស្គាល់ ថា ទន្លេ ឡាន ឆាង បាន ថយចុះ ដោយសារតែ ទំនប់ វារី អគ្គិសនី ជីង ហុង ក្នុង ប្រទេស ចិន បន្ថយ បរិមាណ បង្ហូរ ទឹក ក្រោម ហេតុផល ជួសជុល វារី អគ្គិសនី ៕
របាយការណ៍ ៖ ចំនួន នៃ ការរំលោភ ទៅ លើ សេរីភាព មូលដ្ឋាន បាន កើនឡើង នៅ មុន ការបោះឆ្នោត
មជ្ឈមណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា សមាគម សិទ្ធិ មនុស្ស អាដហុក និង មជ្ឈមណ្ឌល សាមគ្គីភាព នៅ ថ្ងៃទី ១៨ កក្កដា ម្សិលមិញ នេះ បាន ចេញផ្សាយ របាយការណ៍ ឆ្នាំ ទី ៣ នៃ ការឃ្លាំមើល សេរីភាព មូលដ្ឋាន នៅ កម្ពុជា ។
នេះ គឺជា លទ្ធផល នៃ ការរកឃើញ នៅក្នុង របាយការណ៍ ការឃ្លាំមើល សេរីភាព មូលដ្ឋាន នៅ កម្ពុជា សម្រាប់ ឆ្នាំ ទី ០៣ ដែល ត្រូវបាន ផ្សព្វផ្សាយ កាលពី ថ្ងៃទី ១៨ កក្កដា ឆ្នាំ ២០១៩ ។
ក្នុង ចំនួន ករណី ដែល រឹតត្បិត សេរីភាព មូលដ្ឋាន នេះ គឺ មាន ៣៩៦ ករណី ឬ ៨២ % ដែល ការរឹតត្បិត នោះ មិន បាន គោរព តាម បទដ្ឋាន អន្តរជាតិ ឡើយ ហើយ ដែល ត្រូវបាន រាប់ ថា ជា ការរំលោភបំពាន ។
របាយការណ៍ ឆ្នាំ ទី ០៣ នៃ ការឃ្លាំមើល សេរីភាព មូលដ្ឋាន នេះ បាន សិក្សា លើ ទិដ្ឋភាព ចំនួន ៣ ទី ១. ជុំវិញ ការអនុវត្ត សេរីភាព ខាង សមាគម ទី ២. សេរីភាព ខាង ការបញ្ចេញមតិ និង ទី ៣. គឺ សេរីភាព ខាង ការជួបប្រជុំ នៅ កម្ពុជា ជាដើម ។
គម្រោង បាន កត់ត្រា នូវ ហេតុការណ៍ សរុប ទាំងអស់ ១២០ ករណី ។
ដោយឡែក លើ សេរីភាព ខាង ការជួបប្រជុំវិញ គម្រោង បាន កត់ត្រា នូវ ការជួបប្រជុំ ចំនួន ៤១១ ករណី ក្នុង នោះ មាន ករណី ចំនួន ១១៣ បាន ទទួលរង នូវ ការរារាំង ឬ រិត ត្បិត ពីសំណាក់ រដ្ឋាភិបាល កម្ពុជា ។
លោក ថា របាយការណ៍ នេះ បាន លើកឡើង តែ ក្តីបារម្ភ របស់ មនុស្ស មួយ ក្រុម តូច ដោយ មិន ឆ្លុះបញ្ចាំង ជាទូទៅ នោះ ទេ ៕
របាយការណ៍ មួយ ក្រោម ការផ្តួចផ្តើម គាំទ្រ របស់ អង្គការ សហ ប្រជាជាតិ ស្តីពី បណ្តាញ ឧក្រិដ្ឋកម្ម ថ្នាំ ញៀន ត្រូវបាន គេ ប្រកាស ផ្សាយ កាលពី ថ្ងៃព្រហស្បតិ៍ ទី ១៨ កក្កដ នៅឯ ទៅ ក្រុង បាងកក ។
ជាក់ស្តែង នៅក្នុង ឆ្នាំ ២០១៨ គេ បាន ចាប់ ឃាត់ ថ្នាំ គ្រាប់ ម៉េតំហ្វេតាមីន ចំនួន ១២០ តោន នៅ ទូទាំង អាស៊ី អាគ្នេយ៍ ។
យោង តាម របាយការណ៍ ខាងលើ ការផលិត ការជួញដូរ ចែកចាយ នៅ ទូទាំង អាស៊ី អាគ្នេយ៍ គឺជា ប្រភព នៃ លុយ ក្រ ខ្វក់ ជាច្រើន សិប ពាន់ លាន ដុល្លារ ។
ទីតាំង ផលិត ថ្នាំ គ្រាប់ ម៉េតំហ្វេតាមីន គឺ ភាគ ច្រើន ស្ថិត នៅ តំបន់ ភ្នំ ក្នុង រដ្ឋ ហ្សាន ភាគ ខាងជើង ប្រទេស ភូមា ហើយ ដែល ស្ថិត នៅក្នុង តំបន់ ត្រីកោណ មាស ជាប់ ព្រំដែន ជាមួយ ថៃ និង ឡាវ ។
ថ្នាំ ញៀន ម៉េតំហ្វេតាមីន ដែល ផលិត បាន ត្រូវ លក់ ចែកចាយ ទៅកាន់ ប្រទេស ចិន ទៅកាន់ ប្រទេស ថៃ និង ឡាវ ជាដើម ។
អ៊ីរ៉ង់ ចាប់ នាវា ដឹក ប្រេង មួយ គ្រឿង ដោយ ចោទ ពី បទ រត់ ពន្ធ ប្រេង
គ្មាន ព័ត៌មាន លម្អិត អំពី អត្តសញ្ញាណ នាវា ដឹក ប្រេង ដែល អ៊ីរ៉ង់ ឃាត់ទុក នេះ ឡើយ ។
អ៊ីរ៉ង់ គ្រាន់តែ ឲ្យដឹង ថា នាវា ដឹក ប្រេង នេះ មាន សមត្ថភាព ផ្ទុក ប្រេង ចំនួន ២ លាន បារ៉ែល និង មាន នាវិក ចំនួន ១២ នាក់ ។
សូម ជម្រាប ថា នេះ គឺជា លើក ទី មួយ ហើយ ដែល អ៊ីរ៉ង់ ប្រកាស ទទួលស្គាល់ ជា ផ្លូវការ ពី ការឃាត់ នាវា បរទេស ។
ចាប់តាំងពី ស្ថានការណ៍ នៅ ច្រក សមុទ្រ អក មូស ជួប ភាពតានតឹង មក បណ្ដា ប្រទេស មួយចំនួន បាន ចោទប្រកាន់ អ៊ីរ៉ង់ ថា ចេះតែ រក រឿង ចាប់ នាវា ដឹក ប្រេង របស់ ពួកគេ ប៉ុន្តែ អ៊ីរ៉ង់ មិន ដែល ទទួលស្គាល់ ទេ ។
អ៊ីរ៉ង់ បាន ច្រានចោល សេចក្ដីរាយការណ៍ នេះ ដោយ អះអាង ថា នាវា ល្បាត របស់ អ៊ីរ៉ង់ គ្មាន បាន ជួប នាវា បរទេស ណាមួយ ទេ នៅក្នុង អំឡុង ពេល នោះ ៕
មន្ដ្រី ប៉ូលីស ជប៉ុន កំពុងតែ ស៊ើបអង្កេត ករណី នេះ ដោយ បាន ឃាត់ខ្លួន បុរស ម្នាក់ ។
ប៉ូលីស ដាក់ ការសង្ស័យ ថា បុរស ម្នាក់ នេះ ជា អ្នក លួច ដុត ស្ទូឌីយោ គំនូរ ជីវ ចល ក្យូតូ ។
គ្រោះ អគ្គិភ័យ នៅ ស្ទូឌីយោ គំនូរ ជីវ ចលក្យូ តូ កើតឡើង នៅ វេលា ម៉ោង ប្រមាណ ១០ និង ៣៥ នាទី ម៉ោង នៅក្នុង ប្រទេស ជប៉ុន ។
នៅក្នុង ហេតុការណ៍ គ្រោះ អគ្គិភ័យ នេះ មាន មនុស្ស យ៉ាងហោចណាស់ ២៤ នាក់ បាន ស្លាប់ បាត់បង់ជីវិត ។
អាជ្ញាធរ ឲ្យដឹង ថា ចំនួន អ្នកស្លាប់ អាចនឹង កើនឡើង បន្ថែម ទៀត ដោយសារតែ មនុស្ស មួយចំនួន មិន អាច រត់ ចេញ ពី អគារ បាន ទាន់ ពេល វេលា ។
ក្រៅពី អ្នកស្លាប់ ក៏ មាន ដែរ អ្នករបួស ដែល មាន ចំនួន រហូតដល់ទៅ ជាង ៣០ នាក់ ។
គួរ ជម្រាប ថា នៅ ស្ទូឌីយោ កើត ហេតុ ប៉ូលីស ជប៉ុន បាន ឃាត់ខ្លួន បុរស ម្នាក់ ដែល សង្ស័យ ថា ជា អ្នក បង្កឲ្យ មាន គ្រោះ អគ្គិភ័យ នេះ ។
សាក្សី បាន រាយការណ៍ ប្រាប់ ប៉ូលីស ថា ជនសង្ស័យ រូប នេះ បាន ចាក់ សារធាតុ រាវ ដូច ប្រេងសាំង នៅ ជុំវិញ អគារ ក្រុមហ៊ុន គំនូរ ជីវ ចលក្យូ តូ មុនពេល បញ្ឆេះ ភ្លើង ដុត ។
