ការបណ្តុះបណ្តាល នឹង ធ្វើឡើង ជា ភាសា អារ៉ាប់ ...
មុនពេល ការរីករាលដាល នៃ សាសនា អ៊ីស្លាម ដោយ ប្រើ គណនី ធ្វើដំណើរ សហសម័យ និង របស់ គាត់ ។
ដែល ខ្ញុំ បាន ប្រព្រឹត្ត ជាញឹកញាប់ ក្រោម ការបៀតបៀន ហើយ ខ្ញុំ គិត ថា ការប្រណាំង នោះ គឺជា ការប្រកួត មួយ ក្នុង ចំណោម
ភាពរស់រវើក នៃ ការនិយាយ ។
" ខ្ញុំមានអារម្មណ៍នៃការ បាត់ បង់ដែលមិនអាចជួសជុលបាន " ។
កុំ ភ័យខ្លាចអី … ឯងជាក្បាលអាក្រក់ !
ក្លាយជា អណ្តាត ភ្លើង របស់ ព្រះ។ ជីវិត ស្ងប់ស្ងាត់ ។
ទោះ យ៉ាងណា ក៏ដោយ ការតវ៉ា នៅក្នុង ប្រទេស នេះ បាន រីកចម្រើន ជុំវិញ ការរៀបចំ នេះ ។
គ្រាន់ តែរួមជាមួយរូបភាពដែលអាចដូចជារបស់អ្នកប៉ុណ្ណោះ អ្នកគួរ តែតាម ដានបុរស ឬស្ត្រីរបស់ពួកគេ ។
ទឹកដោះគោ គឺជា អាហារ ដ៏ ល្អ បំផុត ។
បន្ទាប់មកវាត្រូវបាននាំយកទៅប្រតិបត្តិ ការ » ។
សម្រាប់ រយៈពេល លើស ពី មួយ ម៉ោង
« អ្នកដែលត្រូវបានតែងតាំងសម្រាប់ជីវិតអស់ កល្ប ជា និច្ចបានជឿ » ។
ភាព មិន ស្រួល នៅ ខាងក្រោយ អាច នៅក្នុង ករណី ភាគ ច្រើន បណ្តាល មកពី បញ្ហា ទម្ងន់ ។
ប៉ុន្តែពួកគេខ្លះនិយាយថា៖ « គាត់បានព្យាបាលភ្នែកមនុស្សខ្វាក់ពី កំណើត ។
ខ្ញុំមិនដែលជឿពួកគេទេ ប៉ុន្តែឥឡូវវាពិតជាបានកើតឡើង » ។
យើងយល់ថាការ ភ័យខ្លាច ហើយយើងចង់លុបវាចេញ ។
ទូរស័ព្ទ ទៅ ប៉ូលីស ហើយ បន្ត ទៅ មុខ ទៀត ។
ខ្ញុំ បាន និយាយ ជាមួយ បុរស ជាច្រើន ។
ព្រះដ៏ ល្អ ឥត ខ្ចោះ គឺជា ការថ្វាយបង្គំ ដោយ អស់ ពី ដួងចិត្ត ដែល រំឭក យើង អំពី លក្ខណៈ របស់ ព្រះ។
ពួកគេ ចង់ឱ្យ ខ្ញុំ ផ្តល់ ភាព មិន ច្បាស់ ។
យើងមិនយល់ពីរបៀបដែលពួកគេរៀនបានត្រឹមត្រូវ ។
ហើយគេនឹងដឹងថា យើងជាព្រះ‌ អម្ចាស់ ជាព្រះ របស់គេ ។
ហើយ បន្ទាប់មក អ្នក នឹង ឈឺចាប់ ជាមួយ វា ហើយ ហើម ជាមួយ វា ហើយ ប្រយុទ្ធ ជាមួយ វា ។
ការបង្ខិតបង្ខំ និង ការទាក់ទាញ និង ការបង្កាច់បង្ខូច ( ទាមទារ ) បី ។
ដឹងទេថាថ្ងៃបុណ្យម្ដាយនឹងប្រព្រឹត្តទៅក្នុងឆ្នាំ ២០១៨ នេះទេ ?
ខ្ញុំ ដឹង ថា វា ជា សញ្ញាបត្រ របស់ ខ្ញុំ
ការ ចេញផ្សាយក៏បានកត់សម្គាល់ផងដែរថា បេក្ខជនចំនួន ៤ នាក់បានបង្ហាញចំណាប់ អារម្មណ៍ក្នុងការ ឈរឈ្មោះរួចហើយ ។
« ពេលគេឮសំឡេងនោះ គេនិយាយទាំងអស់គ្នាថា ' អូ ខ្ញុំស្គាល់សំឡេងនោះ ។
ធ្លាប់មានបទពិសោធន៍ថាមានជនជាតិចិនច្រើនមកទីនេះដើម្បីញ៉ាំ ។
ព្រោះខ្លាចមាន ទោស ហើយអ្នក ណាដែលមិនបានគ្រប់លក្ខណ៍ក្នុងសេចក្ដី ស្រឡាញ់ » ។
មនុស្ស មួយចំនួន ច្បាស់ជា មិន គិត ពី អ្វី ដែល ពួកគេ និយាយ នោះ ទេ ។
ដង្ហើម របស់ ខ្ញុំ គាំទ្រ ខ្ញុំ ។
លេខ បី គ្មាន ជំងឺ កាមរោគ ។
ទាហាន ម៉ារីន ទាំងនេះ ស្ម័គ្រចិត្ត ជួយ ៩...
គេមិនជឿទេ ហើយគេនៅពីក្រោយ ។
យល់ ពី ខ្លួនអ្នក ពោលគឺ អ្វី ដែល ជំរុញ អ្នក និង អ្វី ដែល កំណត់ របស់ អ្នក ។
យើង ដឹង ថា មាន នរណា ម្នាក់
ខ្ញុំនឹងមកភ្លាម បន្ទាប់ពីការ ញ៉ាំអាហារ, នាយកសាលា។
អ្នកមិនឃើញរបស់ទាំងនេះរាល់ថ្ងៃទេ » ។
ប៉ុន្តែ ត្រូវសងប្រាក់ដែលត្រឹមត្រូវនៅថ្ងៃដែលប្រមូល ផល ។
សញ្ញា ថា ពួកគេ ជា ទឹកដី ។
បើអ្នក ណាមិននៅជាប់នឹងខ្ញុំ អ្នកនោះប្រៀបដូចជាមែកឈើដែលត្រូវបោះចោលក្រៀមស្វិត ។ មែក ឈើ ទាំងនោះ ត្រូវបាន រើស បោះ ចូល ទៅក្នុង ភ្លើង ហើយ ដុត ចោល ។
ស្ត្រីម្នាក់ទៀតហាក់ដូចជាទាបដែលនាងដឹង ។
យើងបានប្រគល់កិត្តិយសដល់ព្រះយេស៊ូវ ដែលបានប្រទានដល់ទ្រង់ដែលបានយកឈ្នះលើអំពើ បាប និងសេចក្តីស្លាប់សម្រាប់យើង ។
“ ឥឡូវនេះ យើងគ្រប់គ្រងជោគ វាសនារបស់យើង ។
ព្រះប្រហែលជា អាណិត គាត់ ។
គាត់ មិន បាន លុត ជង្គង់ អធិស្ឋាន ទេ ។
វា រវល់ ទាំងស្រុង ជាមួយនឹង បញ្ហា ប្រចាំ ថ្ងៃ ។
សូមយើងចាំថាលោកយេស៊ូផ្ទាល់បានប្រាប់ពួកសិស្សរបស់លោកថា៖ « ក្នុងលោកនេះ អ្នកនឹងមានបញ្ហា ។
ជីវិតមានប្រភេទជីវិតដែលបានបន្ថែមទៅគ្រប់ដំណាក់កាលផ្សេងទៀតនៃជីវិត
សណ្ឋាគារ បាន និយាយ ថា ខ្លួន កំពុង ធ្វើការ ដើម្បី ស្វែងរក ដំណោះស្រាយ ។
វា ជា សារ របស់ ខ្ញុំ
“ ខ្ញុំ សង្ឃឹម ថា ឆាប់ ៗ នេះ ពួកយើង នឹង អាច ជួប មនុស្ស ដែល យើង ស្រលាញ់ ចែករំលែក អាហារ និង និយាយ ជាមួយគ្នា ម្តង ទៀត ។
ទេវតាកាន់ទី បញ្ចុះ សពម្រាមដៃ
ហើយឥឡូវនេះ គាត់និយាយថាដល់ពេលត្រូវបំបែកវាហើយ ។
ខ្ញុំនិយាយពីយូរមកហើយ ។
អ្នក នឹង ឃើញ បង្អួច ដូច បង្ហាញ នៅលើ អេក្រង់ ខាងក្រោម ។
អ្នកមិនមែនជាប៉ូលិស អ្នកមិនអាចធ្វើដូច្នេះបានទេ » ។
បើគ្មានច្បាប់ទេក៏គ្មាន បាបដែរ ហើយបើគ្មាន បាបក៏គ្មានការ វិនិច្ឆ័យដែរ ។
ហេតុ អ្វី បានជា ផ្នែក ដែល បរិច្ចាគ នៃ តម្រងនោម ឈឺ ?
« នាងជាអ្វីជារបស់ខ្ញុំ ហើយអ្វីជានាងជារបស់ខ្ញុំ ? » គាត់ និយាយ លេង ។
ព្រះមិន អាណិត ខ្ញុំ ទេ ។
គ្រាប់អាល់ម៉ុនភាគ ច្រើនទៅប្រទេសចិន ។
ទឹកជ្រៅត្រូវបង្កាត់ បង្ខូចត្រឡប់មកវិញ ទប់មិនឲ្យហូរចេញតាម ចិត្តចង់ ។
យើង ត្រូវ ស្វែងរក មូលហេតុ ដែល យើង បាត់បង់ ចំណេះដឹង នោះ ។
ផ្ទុយ ពីការ មិនគោរព ។
“ ជន អន្តោប្រវេសន៍ របស់ យើង មាន ការអប់រំ ល្អ ណាស់ ។
15 ការឆ្លើយតប ដើម្បី ទទួលបាន វា ខណៈពេល ដែល វា ក្តៅ
ទាំងអស់និងគ្រប់គ្នាអាចប្រើដើម្បីនិយាយអំពីមនុស្សឬរឿង ទូទៅ ។
ហើយក៏មានជម្លោះមួយបានកើតឡើងក្នុងចំណោមពួកគេថា តើមួយ ណាក្នុងចំណោមពួកគេត្រូវបានគេចាត់ទុកថាធំជាងគេ ។
ថ្ងៃ នេះ យើង នឹង ស្រឡាញ់ អ្នក ច្រើន ជាង ម្សិលមិញ ។
៣៩ ពេលនោះ អ៊ីសាក ជាឪពុករបស់គាត់បានឆ្លើយទៅគាត់ ថា៖ មើលចុះ ទីលំនៅរបស់អ្នកនឹងនៅឆ្ងាយពី ភាពសម្បូរបែបនៃ ដែនដី ឆ្ងាយពីទឹក ស ន្សើមនៃផ្ទៃមេឃ ។
អ្នក ជឿជាច្រើន បាន ព្រងើយ កន្តើយ ចំពោះ តម្លៃ នៃ វត្តមាន របស់ ព្រះ ហើយ អនុញ្ញាតឱ្យ ការយកចិត្តទុកដាក់ នៃ ជីវិត ដើម្បី បង្វែរ ពួកគេ ពី ការចំណាយ ពេល ប្រកបដោយ គុណភាព ជាមួយ ព្រះ។
៣៤ ព្រះយេស៊ូមានព្រះបន្ទូលទៅគាត់ ថា៖ « ខ្ញុំប្រាប់អ្នក ជាប្រាកដថា នៅយប់នេះ មុនមាន់ រងាវ អ្នកនឹងបដិសេធខ្ញុំបីដង ។
សម័យ បុរាណ ផងដែរ ។
គាត់ និយាយ ក្នុង ន័យ ស្និទ្ធស្នាល ។
ខ្ញុំ ជា អ្នកគាំទ្រ ដ៏ អស្ចារ្យ ។
ចាំ មើល ម៉ាស៊ី ជា ឈ្មោះ ក្មេងប្រុស ?
មាន ផែនការ អ្នក ប្តេជ្ញាចិត្ត ចំពោះ កិច្ចការ ទាំង នេះ
“ នរណា ជា អ្នកបង្កើត មេរោគ អេបូឡា
22 ដូច្នេះ គាត់ក៏ចាត់អ្នកជួយគាត់ពីរនាក់ គឺធី ម៉ូថេ និងអេរ៉ាស្ទុស ទៅស្រុក ម៉ា សេដូន ខណៈគាត់ស្នាក់នៅខេត្តអាស៊ីយូរជាងនេះ ។
ប្រទេស ជប៉ុន នៅតែ ក្តៅ ដូច កោះ ត្រូពិច ទោះបីជា វា ដល់ ខែកញ្ញា រួចទៅហើយ ។
ពួកគេ នឹង នាំ អ្នក ទៅកាន់ កន្លែង ទាក់ទាញ សំខាន់ ៗ ។
បីថ្ងៃបន្ទាប់ពីពួកគេបានធ្វើ កិច្ចព្រមព្រៀងជាមួយនឹងជន ជាតិគី បៀន ជន ជាតិអ៊ីស្រាអែលបានឮថាពួកគេ ជាអ្នកជិតខាង ដោយ រស់នៅក្បែរពួកគេ ។
ព្រោះ ខ្ញុំ ជួប ការលំបាក ខ្លះ ។
ដូច្នេះ តើ មនុស្ស ស្រី ចង់បាន អ្វី ?
ពេល ខ្លះ ខ្ញុំ សង្ឃឹម ; ពេល ខ្លះ ខ្ញុំ បាក់ទឹកចិត្ត ។
លើកនេះគេប្ដូរ ចិត្តម្ដងទៀត ។
ហាក់ដូចជាតិចតួច ណាស់
" សម្រាប់ ពួកយើង វា ជា ហ្គេម ដែល អ្នក កំពុង ព្យាយាម កែលម្អ ការអនុវត្ត របស់ អ្នក ។
ព្រោះពួកគេសុទ្ធតែជាអ្នក បម្រើរបស់ លោក ។
ប៉ុន្តែជាដំបូង គាត់បាននិយាយថា « យើងត្រូវថែរក្សាដើមឈើដែលបានដួលរលំទាំងអស់ » ។
IRGC ដែល ជា កម្លាំង ដ៏ មាន ឥទ្ធិពល ដែល រាយការណ៍ ដោយ ផ្ទាល់ ទៅកាន់ មេដឹកនាំ កំពូល មាន ការសង្ស័យ យ៉ាង ខ្លាំង ចំពោះ សហរដ្ឋ អាមេរិក និង សម្ព័ន្ធមិត្ត របស់ ខ្លួន ។
តើខ្ញុំចង់មានស្នេហាជាមួយគាត់ទេ ?
គាត់ធ្លាប់ស្រែកទ្រហោយំ ហើយបែរមកលើ ។
ការភ្ញាក់ផ្អើល នឹង មិន ទុក ឱ្យ អ្នក ព្រងើយ កន្តើយ ឡើយ !
មាន ក្រុម មនុស្ស រង់ចាំ ជានិច្ច ។
នេះគឺ ជាផ្លូវចេញពីការ គ្រប់គ្រងហើយ ... អូ ខ្ញុំមិនដឹងទេ ។
ចំណែក ឯការ រំលាយពិភពលោកវិញ ពួកគេ ( ស៊ីម៉ូន ) និយាយថា គឺសម្រាប់ហេតុផលរបស់ប្រជាជនខ្លួន ។
« ទ្រង់មិនបានញែកយើងនិងគេចេញឡើយ គឺបានសម្អាត ចិត្តគេដោយសេចក្ដី ជំនឿ » ។
ដូច្នេះ គាត់ បាន រើស ដំណាំ ជិះ របស់ គាត់ ។
ឥឡូវយើងដឹងថាយើងនឹងនិយាយអ្វីហើយ .. ប៉ុន្តែតើយើងនិយាយយ៉ាង ណា ?
តើពួកគេនឹងត្រូវធ្វើព្រឹត្តិការណ៍ទាំងបីក្នុងថ្ងៃតែ មួយក្នុងព្រឹត្តិការណ៍អូឡាំពិកទេ ?
អ្នក គឺជា អ្នកដឹកនាំ ព្រោះ អ្នក គឺជា មនុស្ស ដំបូង គេ នៅក្នុង ជួរ ។
ខ្ញុំ ដឹង ថា ខ្ញុំ ចង់បាន យុត្តិធម៌ ។
បន្ទាប់មក បន្ទាប់ពីត្រូវបានរក្សាទុក — ការ អភ័យទោសយ៉ាងពិតប្រាកដ និងទទួល យក និង ប្រែក្លាយដោយព្រះវិញ្ញាណបរិសុទ្ធរបស់ព្រះជាអ្វីមួយ ។
“ អូ សម្លាញ់ មាន កម្រិត នៃ ភាពល្ងង់ខ្លៅ ។
ទុតិ យក ថា 2:13 ដ្បិតអ្នក ណាដែលគ្មានសេចក្តី មេត្តា ‌ករុណា នោះនឹងត្រូវជំនុំ ‌ជម្រះដោយគ្មានសេចក្ដី មេត្តា ‌ករុណា ប៉ុន្តែសេចក្ដី មេត្តា ‌ក រុណាមានមោទនភាពក្នុងការ ឈ្នះការ វិនិច្ឆ័យ ។
តើ អ្នក សម្លាប់ មនុស្ស ដោយ ការទទួលខុសត្រូវ ដោយ របៀប ណា ?
សម្លាប់ ឬ សម្លាប់ ការរស់រាន មាន ជីវិត នៃ អ្នក ខ្លាំង បំផុត និង គ្មាន មេត្តា បំផុត ; ល្បែង នៃ បល្ល័ង្ក ។
ដែលក្នុងសម័យអ្នក និពន្ធយើងមាន ន័យថា កន្លែងបូជា សព ។
ប៉ុន្តែ ក្នុង នាម ជា អ្នក ដើរ តាម ព្រះគ្រីស្ទ យើង មិន ចង់ មាន បញ្ហា ទាំងនេះ ទេ ។
ពេលដែលបុរសចំណាស់ចេញពីផ្លូវ
១៤ ពេលលោកទៅដល់កន្លែងនោះ លោកឃើញមនុស្សយ៉ាងច្រើនកុះករ ។
១៧ ដូច្នេះ ព្រះជាម្ចាស់មានព្រះបន្ទូលទៅលោក ណូ អេ ថា៖ « នេះហើយជាទីសំគាល់នៃការសន្យាដែលខ្ញុំកំពុងធ្វើចំពោះជីវិតទាំងអស់នៅលើផែនដី » ។
វា មិន គួរឱ្យ ភ្ញាក់ផ្អើល ទេ ដែល ការរលាក អាច បណ្តាលឱ្យ ឈឺចាប់ ។
សិស្សកំពុងមានការ រីក ចម្រើនល្អ ហើយវគ្គសិក្សារបស់យើងដំណើរការ ល្អ » ។
ផ្លូវនេះទៅផ្ទះរបស់នាង » ។
នេះជាការ ឆ្លើយ តបទៅនឹងការ ចំអកមិនឈប់របស់ Ed ។
ជាទូទៅ អាច បង្កើត ការធានារ៉ាប់រង ប្រភេទ នេះ ដល់ មនុស្ស ឬ រថយន្ត ។
យប់មិញគាត់ឡើង ៣ ដងពេលយប់ ។
ផ្លូវ របស់ ណិល សុន ម៉ាន់ ដេឡា ។
ថ្ងៃនេះជាលើកដំបូងដែលខ្ញុំបានបោះ ពុម្ពផ្សាយការ បង្ហោះដោយចៃដន្យមុនពេលដែលវាត្រូវបានគេ បញ្ចប់ ( តាមពិតវាមិនបានចាប់ផ្តើមសោះ !)
តើអ្វីដែលមានរួចហើយកំពុងត្រូវបានវាស់ ?
ពេលអ្នក បម្រើត្រឡប់មកវិញ មានអ្នក បម្រើម្នាក់ទៀតនៅជាមួយ ។
ដែល គាត់ បាន ដក ការសន្យា របស់ គាត់ ។
• ការប្រាស្រ័យទាក់ទង មិន អាច ប្រើ បាន ទេ នៅ ពេល ដែល យានជំនិះ មិន ប្រើ រយៈពេល ពីរ សប្តាហ៍ ឬ ច្រើន ជាង នេះ ។
( ឡាំសា ) ហើយព្រះវិហារបរិសុទ្ធពោរពេញដោយផ្សែងចេញពីសិរីល្អនៃព្រះ និងពីអំណាចរបស់ទ្រង់ ។ គ្មាននរណាម្នាក់អាចចូលទៅក្នុងព្រះវិហារបានឡើយ រហូតទាល់ តែគ្រោះកាចទាំងប្រាំពីរនៃទេវតាទាំងប្រាំពីរបានសម្រេច ។
ខ្ញុំ កំពុង និយាយ ជាមួយ អ្នក !
ស្វែងរក៖ អ្វី ៗ ទាំងអស់ ។
ដូច្នេះការ ជ្រើស រើសរបស់ល្អនឹងមានប្រយោជន៍សម្រាប់អ្នក ។
ពេល ខ្ញុំ និយាយ ទៅកាន់ ម៉ាកុស គាត់ មើល មក ខ្ញុំ ដោយ ភាពភ័យ រន្ធត់ ។
នឹង មកដល់ ស្ទូឌីយ៉ូ ជាមួយនឹង សំណុំ ពេញលេញ
មើល យើងនឹងឡើងទៅក្រុងយេរូសាឡិម ។
ផងដែរ ផ្នែក ទាំងអស់ នៃ អ្វី មួយ នៅក្នុង ជាច្រើន ។
ធ្វើជា ខ្លួនអ្នក៖ ការឌិកូដ អត្ថន័យ នៅ ពីក្រោយ ឃ្លា
