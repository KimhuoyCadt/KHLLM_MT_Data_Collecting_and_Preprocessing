១១ ខ្ញុំសួរគាត់ ថា៖ « តើដើមអូលីវពីរដើមនៅខាងស្ដាំ និងខាងឆ្វេងជើង ចង្កៀងមានអ្វី ? » ។
លុះបានឮដូច្នោះ ក៏ខឹង សម្បារ ជាខ្លាំង ហើយស្រែកឡើង ...
សង្ឃឹម ថា អ្នក ទាំងអស់ គ្នា នឹង មាន ថ្ងៃ ដ៏ អស្ចារ្យ ។
ខ្ញុំខ្មាសគេដែលទទួលស្គាល់ តែស្គាល់បុរសម្នាក់ដែលជិះ កង់បែបហ្នឹង !
មើល ហើយ ភ្ញាក់ផ្អើល ។
បុរស នោះ មាន សឺរាុំង ពីរ នៅក្នុង ហោប៉ៅ របស់ គាត់ ។
វា គឺជា ការហៅ នៃ ភាពអត់ឃ្លាន ។
សាវកយ៉ូហានបានមាន ប្រសាសន៍ថា៖ « កុំឲ្យអ្នក ណា នាំអ្នកឲ្យវង្វេងឡើយ ។
គាត់មិនសមនឹងទទួលបានកិត្តិយសនេះទេ » ។
វិស័យ ផ្តល់ឱ្យ យើង នូវ ភាពច្បាស់លាស់ មួយចំនួន
ហើយ វា បាន ធ្វើឱ្យ គាត់ ភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង :
ដូច្នេះ វត្ថុដែលខ្ញុំចង់នាំចូលគឺពាងកែវទឹក ។
ត្រូវបាន ប្រារព្ធ ឡើង ដោយ សិស្ស ទម្រង់ ទី ប្រាំមួយ ។
នាំខ្ញុំទៅមានជីវិតសូមឱ្យឆន្ទៈរបស់អ្នកបានសម្រេច !
ទំព័រ ដើម គួរតែ ត្រូវបាន សាងសង់ ដើម្បីឱ្យ អ្នកប្រើប្រាស់ អនុវត្ត សកម្មភាព ដែល អ្នក រំពឹងទុក ពី គាត់ ។
តោះ ជួប ជាមួយ ពួកគាត់ ខ្លះ ។
ដូច្នេះ គាត់បានហៅការ ប្រជុំជាមួយពួកគេ ។
ការសិក្សា បាន បង្ហាញ ថា សុខភាព របស់ ទឹក ទាំងនេះ
ប្រពន្ធ ពីរ នាក់ បាន ស្លាប់ ។
បើ គ្មាន ប្រព័ន្ធ ប៉ាតង់ ទេ គាត់ នឹង រក្សា ការសម្ងាត់ ចំនួន ១៥១ ។
« លោកយេស៊ូស្រឡាញ់ម៉ាថា និងប្អូនស្រីរបស់នាង និង ឡាសារ …» ។
“ មនុស្សនៅក្នុងសង្កាត់កំពុងនិយាយ ។
និក្ខម នំ 19:9 ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលទៅ កាន់លោកម៉ូសេ ថា៖ « មើលចុះ យើងនឹង មក រកអ្នកក្នុងពពកដ៏ក្រាស់ ដើម្បីឲ្យប្រជាជនបានឮពេលខ្ញុំនិយាយជាមួយនឹងអ្នក ហើយអាចនឹងជឿលើអ្នក ជារៀងរហូត » ។
បុរសទាំងពីរនាក់មិនទាន់ត្រូវបានចាប់ខ្លួននៅឡើយទេ ។
អ្នក អាច យល់ ពី ទស្សនៈ របស់ អ្នកដទៃ ដោយ មិន យល់ព្រម ។
ប៉ុន្តែគាត់ចូលផ្ទះខ្ញុំ ហើយដាស់ខ្ញុំ » ។
ថែរក្សា ខ្លួនអ្នក និង រោម សំបុក នោះ ។
នេះបើតាម សារព័ត៌មាន ក្យូ ដូ ។
តើអ្នកហៅអ្វីដែលមានច្រមុះធំ ?
នៅពេល យើង ជ្រើសរើស ធ្វើ តាម ការណែនាំ របស់ ព្រះវិញ្ញាណ បរិសុទ្ធ
សម្ព័ន្ធមិត្ត ដោយសារតែ ការពិត ដែល ថា សរសៃ ប្រសាទ
ពីព្រោះមនុស្សទាំងអស់បានប្រព្រឹត្តអំពើ បាប ហើយខ្វះសិរីរុងរឿងរបស់ព្រះ។
ខ្ញុំចង់ធ្វើវាហើយបន្តទៀត » ។
ចូរធ្វើសេចក្ដី សញ្ញាជាមួយនឹងខ្ញុំ នោះខ្ញុំនឹងជួយ នាំអ៊ីស្រាអែលទាំងមូលមកខាងអ្នក » ។
ប្រហែលជា អ្នក មិន ខ្វល់ ពី ការឈឺចាប់ នៅពេល អ្នក ឡើង ខ្ពស់ ។
ឱ ព្រះ អើយ ខ្ញុំត្រូវគេចាប់ហើយ !
ព្រះគម្ពីរ បាន ភ្ជាប់ សារៈសំខាន់ យ៉ាង ខ្លាំង ចំពោះ ការសោយទិវង្គត របស់ ព្រះយេស៊ូវ ។
យើងប្រហែលជាជឿជាក់ថាយើងដួលពេលយើងមាន
កង្វះ សម្ពាធ ប្រេង នឹង ធ្វើឱ្យ ពួកវា មាន សម្លេង រំខាន ហើយ អាច ផ្តល់ឱ្យ
« ហើយប្រសិនបើសាតាំងប្រឆាំងនឹងខ្លួនឯង ហើយបែកបាក់ នោះវាមិនអាចឈរបាន ប៉ុន្តែត្រូវបាន បញ្ចប់ ។
« ឯងធ្វើពុតជាមនុស្សល្ងង់ដោយចេតនាឬ ?
" យើង កំពុង រារាំង អារម្មណ៍ និង បំណងប្រាថ្នា ជាច្រើន ជាមួយ គាត់ ។
ដូចខ្ញុំបាននិយាយ ផលប៉ះពាល់ល្មមនឹងបញ្ជូនខ្ញុំ រត់ទៅលាក់ខ្លួនក្នុងល្អាង !
ត្បិតខ្ញុំត្រូវគេទម្លាក់ចុះ ហើយខ្មាសគេក៏ដោយ ក៏មិនមានគ្រោះថ្នាក់ដល់ខ្ញុំដែរ » ។
មធ្យោបាយ អាថ៌កំបាំង បម្រុងទុក សម្រាប់ ការប្រើប្រាស់ របស់ ឡាម៉ា ឡាម៉ា បាន មក រក គាត់ ។
“ មនុស្ស គ្រប់ គ្នា ភ័យខ្លាច គ្រប់ គ្នា មានអារម្មណ៍ អស់សង្ឃឹម ។
ពួកគេមិនបាននិយាយអំពីរដ្ឋាភិបាលអាមេរិកទេ ។
អ្នកនឹងមិនស្រកទម្ងន់ដោយការ ញ៉ាំតែពីរ បីអោនក្នុងមួយថ្ងៃទេ ។
នៃ ឆាក នៅ ចំណុច នេះ ហើយ បន្ត ការបាញ់ប្រហារ ជាមួយនឹង ទោស ប្រហារជីវិត ,
ដែល ត្រូវបាន លាក់ ឥឡូវនេះ អាច ត្រូវបាន បង្ហាញ ។
ទោះបីជា មាន ការព្យាករ នៅ ចំណុច មួយ ក៏ដោយ វា ពិតជា អស្ចារ្យ ណាស់ ។
ទោះបីជាខ្ញុំប្រើភាសាចិនដើម្បីនិយាយអំពីហុងកុងក៏ដោយ ខ្ញុំត្រូវសរសេរពាក្យច្រើន ។
អ្នក អាច រកឃើញ ស្រា ទំពាំងបាយជូរ ចំនួន 6 ដើម្បី ទស្សនា ។
គ្មាននរណាម្នាក់បានឡើងទៅស្ថាន សួគ៌ឡើយ លើកលែង តែអ្នកដែលបានមកពីស្ថាន សួគ៌ គឺបុត្រមនុស្ស ។
កន្លែង មួយ ក្នុង ចំណោម កន្លែង ទាំងនេះ គឺ ប្រទេស ចិន ។
មនុស្ស ដែល មាន មូលដ្ឋាន លើ ការពិត ?
ការគណនា សាមញ្ញ មួយ ត្រូវបាន ធ្វើ ម្តង ទៀត ច្រើន ដង ប្រហែលជា
" គាត់ បាន រក្សាទុក ស្លាបព្រា របស់ គាត់ រហូតដល់ គាត់ មាន មួយ ក្តាប់ តូច ។
ការពិនិត្យ ឡើងវិញ ថ្មី និយាយ ថា មិន មាន ភស្តុតាង ណា មួយ ដែល បង្ហាញ ថា មនុស្ស ពេញ វ័យ ដែល មាន សុខភាព បេះដូង ល្អ គួរ ប្រើ ថ្នាំ អាស្ពីរីន ក្នុង កម្រិត ទាប ប្រចាំ ថ្ងៃ នោះ ទេ ។
ប៉ុន្តែប្រសិនបើព្រះគ្រិស្ដគង់នៅក្នុងអ្នក រូបកាយអ្នកត្រូវស្លាប់ដោយសារអំពើ បាប ប៉ុន្តែព្រះវិញ្ញាណ ជាជីវិតរបស់អ្នកដោយសារសេចក្ដីសុចរិត ។
ដោយសារ ការរចនា នេះ គ្មាន ' ការឆ្លងកាត់ កណ្តាល ' ត្រូវបាន ទាមទារ សម្រាប់ បន្ទះ ដែល មាន ប្រវែង រហូតដល់ 2.6 ម៉ែត្រ ដោយសារ ស៊ុម នេះ ទ្រទ្រង់ ដោយ ខ្លួន ឯង ។
អំណាច ឬនៃព្រះសម្មាសម្ពុទ្ធ ) ។
យើងបានធ្វើដូច្នេះ ដោយមិនពឹងផ្អែកលើប្រាជ្ញារបស់លោកីយ៍ទេ គឺពឹងលើព្រះគុណរបស់ព្រះ។
បើមិនបានបង្កើតទេ នោះនឹងបានលេចមកហាក់ដូចជាព្រះ គ្រីស្ទមិនបានគ្រប់ជ្រុងជ្រោយ ។
ខ្ញុំឃើញខ្លួនឯងជាមនុស្សល្អ ហើយធ្វើអ្វីដែលខ្ញុំអាចធ្វើបានដើម្បីជួយអ្នក ដទៃ ។
មានសុភាសិតរុស្ស៊ីមួយដែល បកប្រែប្រហែលថា « កុំមានមួយ រយរូពី ប៉ុន្តែត្រូវមានមិត្តមួយ រយ » ។
មិន មែន នៅ មាត់ទ្វារ ទេ ។
បញ្ញត្តិដំបូងដែលមានការសន្យាថានឹងបានសុខ សប្បាយជាមួយនឹងអ្នក
ចិត្តយើងខូច ចិត្តពេលទទួល មរណភាពរបស់កូនស្រីដ៏ស្រស់ស្អាតរបស់យើង ។
យើងមានពេលវេលាដ៏ អស្ចារ្យក្នុងការ ស្វែង រកតំបន់ផ្សេងគ្នាទាំងអស់ ។
