បន្ទាប់មក ពី យ៉ូហាន ទី១ ៥: ១៣៖ « ខ្ញុំសរសេរសេចក្ដី ទាំងនេះទៅអ្នក រាល់គ្នាដែលជឿដល់ព្រះនាមនៃព្រះរាជបុត្រានៃព្រះ ដើម្បីឲ្យអ្នក រាល់គ្នាបានដឹងថា អ្នក រាល់គ្នាមានជីវិតអស់ កល្ប ជានិច្ច » ។
អ្នកត្រូវបង្កើតឈ្មោះសម្រាប់ក្រុម !
ហើយ បន្ទាប់មក ព្រះនឹង បង្ហាញ ឡើង គ្រប់ អំណាច និង សិរី ល្អ របស់ ទ្រង់ ហើយ ថែរក្សា អ្វី ៗ ទាំងអស់ ។
ប៉ុន្តែ នៅក្នុង បន្ទប់ របស់ នាង នាង បាន រកឃើញ ឪពុក របស់ នាង ។
បើអ្នក បារម្ភមើលអ្វីដែលអ្នកញ៉ាំ និងធ្វើលំហាត់ ប្រាណ នោះអ្នកគួរតែសុខ សប្បាយ ។
តោះ បោះចោល វិក័យប័ត្រ សិទ្ធិ !
ត្រង់នេះគឺជាប្លុកដើម្បីមើល ។
អ្នក បាន ទទួល ច្រើន នៅក្នុង ចិត្ត របស់ អ្នក ដោយ មន្ត ស្នេហ៍ នេះ ។
សម្រាប់ អ្វី ដែល វា មាន តម្លៃ៖ រៀន បន្តិច ពី ប្រវត្តិសាស្ត្រ
គាត់ឆ្លើយ ថា៖ « ខ្ញុំប្រាប់អ្នក រាល់គ្នាថា បើគេនៅស្ងៀម នោះថ្មនឹងស្រែកឡើង !» ។
ក៏មិនត្រូវបានគេបង្កើតឡើងថាអ្វីទាំងអស់ដែលពួកគេមានត្រូវបានលាត ត្រដាង ។
១៧ តើអ្នកមិនឃើញការ ដែលពួកគេកំពុងធ្វើនៅក្រុង យូដា និងតាមផ្លូវក្នុងក្រុងយេរូសាឡិមឬ ?
៥ ពេលនោះ ភ្នែករបស់មនុស្សខ្វាក់នឹងបើក ហើយត្រចៀករបស់មនុស្សថ្លង់នឹងបើក ។
តើអ្នកប្រាកដទេថាហេតុអ្វីបានជានាងចោលអ្នក ?
« ប៉ុន្តែ ឧបមា ថាអ្នក បម្រើនិយាយនឹងខ្លួនឯងថា ‹ ចៅហ្វាយខ្ញុំ មកយូរហើយ › រួចគាត់ចាប់ផ្ដើមវាយអ្នកបម្រើ ឯទៀតទាំងប្រុសទាំងស្រី ហើយ ស៊ីផឹកស្រវឹង ។
« ធ្វើដូចម្ដេចបានគេជឿលើអ្នកដែលគេមិនបានឮ ? » ។
២ ជន ជាតិអ៊ីស្រាអែលទាំងមូលបាន រអ៊ូរទាំប្រឆាំងនឹងលោកម៉ូសេ និងលោកអើរ៉ុននៅវាល រហោស្ថាន ។
មួយ ភ្លែត ខ្ញុំ នឹង បិទ ភ្នែក ហើយ ច្រៀង ហាលេលូ យ៉ា ច្រៀង ហាលេលូ យ៉ា
“ នាងបាននិយាយថា នាងមិនត្រូវបានគេជួយក្នុងគ្រួសារទេ ។
អ្នក រាល់គ្នាបានធ្វើតាម បទ បញ្ជា ។
គាត់សារភាពថា៖ « ពាក្យ លាគឺពិបាកណាស់ ប៉ុន្តែខ្ញុំរីករាយណាស់ដែលបានមកទីនេះ » ។
គ្មានអ្នក ណានិយាយប្រាប់ខ្ញុំ ឬសម្លឹងមើលទិសដៅខ្ញុំ ឬព្យាយាមជួយទេ » ។
នាង និយាយ អំពី បទពិសោធន៍ របស់ នាង ក្នុង របប ខ្មែរ ក្រហម ។
អ្វីដែលយើងទុកនៅមាត់ទ្វារគឺការ បែងចែក និងការ វិនិច្ឆ័យ » ។
សូមចងចាំផងដែរថា ពេលបើកវាត្រូវទទួលទានក្នុងរយៈពេលពីរថ្ងៃ។
ខ្ញុំដើរតាមគាត់ឃើញថាគាត់បានរកឃើញបឹងធំមួយ ។
ដូច្នេះអ្នកឆ្ងល់ពីរបៀបទទួលបានអ្នកជាវនៅលើ YouTube!
សង្គ្រាមស៊ីវិលនៅភាគខាងត្បូងថ្ងៃនេះ !
តើ អ្នក ទទួលបាន អ្វី ខ្លះ ពី ការផ្តាច់ ខ្លួន ក្នុង ស្ថានភាព បែប នេះ ?
ប៉ារ៉ាស៊ីត របស់ គាត់ ។
ខ្ញុំ សប្បាយ ចិត្ត ដែល បាន ត្រលប់មក ទីនេះ ម្តង ទៀត ដោយ ព្យាយាម តាម ទាន់ អ្វី ៗ គ្រប់ យ៉ាង ។
ពួកគេគិតថាវាជាមនុស្សបិទភ្នែក
ពួកគេ ចង់ ដឹង ថា អ្នកនាំចេញ
ព័ត៌មាន ហ្វេសប៊ុក ដែល អ្នក ចង់ ចែករំលែក ជាមួយ យើង ( លើកលែងតែ ទម្រង់ ដែល ត្រូវការ ។
គាត់មានពេលមួយថ្ងៃដើម្បីស្រស់ ស្រាយ បន្ទាប់ពីការ ប្រកួតជម្រុះទីប្រាំសម្រាប់វគ្គពាក់កណ្តាលផ្តាច់ ព្រ័ត្រ ។
ខ្ញុំត្រូវតែសារភាព ចំណេះដឹងរបស់ខ្ញុំតិចណាស់ » ។
ឥឡូវនេះ ពិធី ជប់លៀង កំពុង បន្ត
តាមពិត ទៅ ពួកគេ គួរតែ ខ្មាស គេ ចំពោះ ឌីសស្កូប ទាំងមូល ។
ក្នុងពេលនោះកូនប្រុសម្នាក់ៗធ្វើការ ដោយឧស្សាហ៍ព្យាយាម
ដូច្នេះបញ្ហាហាក់ដូចជាមានហេតុផលខ្លះ ។
ប៉ុន្តែ មិន ធ្វើ តាម ពួកគេ ។
ដ្បិត ព្រះជា ម្ចាស់ ប្រទាន ដល់ រាស្ដ្រ របស់ ព្រះជាម្ចាស់ ។
ជន ជាតិយូដានឹងត្រូវគេបិទនៅក្នុងក្រុងរបស់ខ្លួន ហើយមិនហ៊ានចេញទៅក្រៅឡើយ
ដ្បិតរង្វាន់ដ៏ធំរបស់យើងនៅស្ថាន សួគ៌ » ។
នៅ ពេលណា ដែល ពាក្យ " ច្បាប់ " ត្រូវបាន លើកឡើង មនុស្ស ភាគ ច្រើន គិត អំពី ការរឹតបន្តឹង ។
ចូរស្តាប់តាមព្រះ‌សូរ សៀងនៃព្រះ‌ អម្ចាស់ ជាព្រះ របស់អ្នក » ។
ប៉ុន្តែថ្ងៃនេះជាថ្ងៃដែលខ្ញុំធ្វើល្អតាមការសន្យា » ។
ឥឡូវនេះ ការទស្សន៍ទាយ នេះ បាន ក្លាយជា ការពិត នៅក្នុង ប្រទេស វៀតណាម ។
ហុយនៅជើងនាង ហើយឈរដើម្បី ធុំក្លិនផ្កា លីលី ។
ពេលវេលា និង ស្ថេរភាព ។
" ខ្ញុំ ត្រូវតែ ស្វែងរក វិធី ដ៏ លំបាក ដែល មាន អ្នកនិពន្ធ ជាច្រើន នៅ ទីនោះ ដែល មិន បាន ចាត់ទុក ទូរទស្សន៍ ការពិត ថា ជា សហគ្រាស ច្នៃប្រឌិត ។ "
សូម្បីតែភ្នាក់ងារអនុវត្តច្បាប់ក៏ត្រូវបានចាប់ខ្លួនដែរ ។
ខ្ញុំ ជឿ ថា នេះ គួរតែ ជា ការខិតខំ ប្រឹងប្រែង ជា ក្រុម នៃ ស្ថិតិ ហើយ មិន មែន ជា ការងារ របស់ ក្រុម តែ មួយ ឬ អ្នកប្រើប្រាស់ នោះ ទេ ។
នោះជាការ ពង្រឹងក្តីសុបិនរបស់នាង ។
នេះដោយ សារទំនាក់ ទំនងសហគមន៍ ។
ភាព មិន សំខាន់ នៃ ភាពក្រីក្រ - ដល់ ជីវិត
« បងប្អូនប្រុសស្រីរបស់ខ្ញុំអើយ ចូរពិចារណាវាទាំងអស់គ្នានូវសេចក្តី អំណរ ពេលដែលអ្នកជួបនឹងការ សាកល្បងផ្សេងៗគ្នា » ។
« បងប្អូនរបស់ខ្ញុំ ក្នុងនាមជាអ្នក ជឿលើព្រះអម្ចាស់យេស៊ូគ្រិស្ដដ៏រុងរឿងរបស់យើង កុំបង្ហាញការ ពេញ ចិត្តឡើយ ។
យើងលក់បានតិចបន្តិច ប៉ុន្តែតម្លៃគួរជា ទី ពេញចិត្ត » ។
ឯកសារ កំណត់ អត្តសញ្ញាណ ណាមួយ ត្រូវបាន ទទួលយក ។
លើសពីនេះទៅទៀត ទ្រង់មិនគ្រាន់ តែប្រទានឲ្យយើងនូវការបញ្ជាប៉ុណ្ណោះ ហើយទ្រង់ ថយក្រោយដើម្បីមើលយើងការតស៊ូនោះទេ ។
ខ្ញុំក៏ដូចគ្នាជាមួយប្អូនស្រី និងមិត្ត ភក្តិរបស់ខ្ញុំដែរ វាត្រូវបានគេចូលចិត្តខ្ញុំហើយខ្ញុំស្រលាញ់វា !
នៅ ប្រទេស ប៊ុលហ្គារី កម្មវិធី សិក្សា គឺ ខុសគ្នា បន្តិចបន្តួច នៅ សាកលវិទ្យាល័យ នីមួយ ៗ ។
បំណងប្រាថ្នា ក្លាយជា ការពិត 1
