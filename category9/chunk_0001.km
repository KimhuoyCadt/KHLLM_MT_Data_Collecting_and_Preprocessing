គណៈ កម្មាធិការ ប្រព្រឹត្តិ កម្មនៃអង្គការ - សមាគម ការពារសិទ្ធិមនុស្សកម្ពុជា (CHRAC) ជាសម្ព័ន្ធនៃសមាគម អង្គការមិនមែនរដ្ឋាភិបាលចំនួន២១ ដែលកំពុងធ្វើ ការ លើវិស័យសិទ្ធិមនុស្ស លទ្ធិប្រជាធិបតេយ្យ និង នីតិរដ្ឋ សូម ស្វាគមន៍ចំពោះ សហ ចៅក្រមស៊ើបអង្កេតអន្ត រ ជាតិ លោក ម៉ាក ហាម៉ុន នៃ អង្គជំនុំ ជម្រះវិសាម ញ្ញក្នុងតុលាការកម្ពុជា បាន ដាក់ជនសង្ស័យចំនួនពីររូបក្នុងសំណុំរឿង ០០៣ និងសំណុំរឿង០០៤ ស្ថិតក្រោមការ ពិនិត្យដោយកំបាំង មុខ ។
លោក ស្រី អ៊ឹម ចែម ជាអតីតមេ បញ្ជាការស្រុកខ្មែរក្រហម និងជា ជន សង្ស័យក្នុងសំណុំរឿង០០៤ ត្រូវបានដាក់ឲ្យស្ថិតក្រោមការ ពិនិត្យដោយកំបាំងមុខពី បទឧក្រិដ្ឋប្រឆាំងមនុស្ស ជាតិ និងមនុស្ស ឃាត ដែលបានប្រព្រឹត្តនៅមន្ទីរសន្តិសុខភ្នំទ្រ យោង និងការដ្ឋានស្ពានស្រែង ដែលទីតាំងទាំងពីរគឺ ស្ថិតក្នុងខេត្តបន្ទាយមានជ័យ ។
ផ្អែកតាមការ ពិចារ ណាទាំងនេះ គណៈកម្មាធិការ ប្រព្រឹត្តិកម្ម សូមសំដែងទស្សនៈរបស់ខ្លួនដូចខាងក្រោម៖
( ១) គណៈកម្មាធិការ ប្រព្រឹត្តិកម្ម សូមស្វាគមន៍ចំពោះការ វិវឌ្ឍទៅមុខដែល សហ ចៅក្រមស៊ើបអង្កេតអន្តរ ជាតិកំពុងធ្វើក្នុងសំណុំរឿង ០០៣ និង០០៤ និងលើក ទឹកចិត្តឲ្យ ចៅក្រម ហាម៉ុន ចាត់ការ ស៊ើបអង្កេតដោយគោរ ព សិទ្ធិរបស់ភាគីទាំងអស់ឲ្យបានពេញ លេញ ។
( ២)គណៈ កម្មាធិការ ប្រព្រឹត្តិ កម្ម សូមអំពាវនាវជា បន្ទាន់ដល់ខាងសហ ចៅក្រមស៊ើបអង្កេត ជាតិឲ្យ សហការ ជាមួយភាគីអន្តរ ជាតិ និងឲ្យផ្តល់ កា រគាំទ្រចាំបាច់ទាំង ឡាយសម្រាប់ការបញ្ចប់កិច្ចស៊ើបសួរ ។
ចៅក្រម យូ ប៊ុន ឡេង គឺស្ថិតក្រោមកាតព្វកិច្ចដើម្បីធ្វើ ការ សម្រេច ចិត្ត លើការបញ្ចប់កិច្ចស៊ើបសួរ បន្ទាប់ពី ត្រួតពិនិត្យលើភស្តុតាងអង្គហេតុដោយប្រុងប្រយ័ត្ន និងដោយផ្អែកលើ ការ ពិចារណ អង្គ ច្បាប់តែ មួយគត់ ។
( ៣) គណៈកម្មាធិការ ប្រព្រឹត្តិកម្ម សូមរម្លឹកដល់ រាជរដ្ឋាភិបាលកម្ពុជាចំពោះការ ប្តេជ្ញារបស់ខ្លួន ដែលបានធ្វើទៅកាន់គណៈ កម្មាធិការសិទិ្ធមនុស្ស ដើម្បីឲ្យ សំណុំរឿង ០០៣ និង ០០៤ ដំណើរការ បានដោយមិន មានការជ្រៀតជ្រែកណាមួយនិងសូម អំពាវនាវដល់រាជ រដ្ឋាភិបាលកម្ពុជាឲ្យ បញ្ឈប់ការប៉ុនប៉ងណាមួយដែលមាន ឥទ្ធិពលលើល ទ្ធផលនៃ កិច្ចស៊ើបសួរក្នុងសំណុំរឿង ០០៣ និង ០០៤ ។
គណៈ កម្មាធិការ ប្រព្រឹត្តិកម្ម សូមគាំ ទ្រ ទាំង ស្រុងចំពោះ កិច្ចស៊ើបសួរដែលកំពុងបន្តនៃសំណុំរឿង ០០៣ និង ០០៤ និងសូមស្វាគមន៍ចំពោះការវិវឌ្ឍថ្មី ដែលចៅក្រម ហាម៉ុនកំពុងធ្វើឆ្ពោះ ទៅការ បញ្ចប់ កិច្ចស៊ើបសួរ ។
ទោះបីយ៉ាងណា គណៈកម្មាធិការ ប្រព្រឹត្តិកម្ម នៅ តែមានក្តី បារម្ភខ្លាំងចំពោះការ មិនឯកភាពដែល បន្ត រ វាង សហ ចៅក្រមស៊ើបអង្កេត ជាតិ និង សហ ចៅក្រមស៊ើបអង្កេតអន្តរ ជាតិលើ ដំណើរការ ស៊ើបសួរ និងការ បដិសេធនៃ ភាគី ជាតិដើម្បីគាំ ទ្រដល់ កិច្ចស៊ើបសួរ ។
កិច្ចស៊ើបសួរនៃសំណុំរឿង ០០៣ និង ០០៤ បានជួប ប្រទះការ លំបាកតាំងពីលើកដំបូងនៃ ការ ចាប់ផ្តើមសំណុំរឿងក្នុងខែកញ្ញា ឆ្នាំ ២០០៩។
ផ្ទុយ ពីគោលការណ៍ ល ទិ្ធ ប្រជាធិបតេយ្យស្តីពីឯករាជ្យ ភាពតុលាការ និង ការ បែងចែកអំណាចដាច់ ពី គ្នា សម្តេចនាយករដ្ឋមន្ត្រី ហ៊ុន សែន និង មន្ត្រីជាន់ ខ្ពស់ផ្សេង ទៀត បាន ធ្វើសេចក្តី ប្រកាស ជា សាធារណៈតាំងពី ដំបូងថា សំណុំរឿងដែលក្រៅពី សំណុំរឿង ០០២ គួរកុំដំណើរ ការ ។
នៅ អ. វ.ត. ក នេះ គឺជាការ ប៉ុនប៉ង ជ្រៀតជ្រែកដល់ កិច្ចស៊ើបសួរ ដែលបាននាំឲ្យមានទំនាស់បន្តបន្ទាប់រវាងភាគី ជាតិ និងភាគីអន្តរ ជាតិ ហើយនាំឲ្យមាន ការលា លែងពី តំណែងរបស់អតីតសហចៅក្រមអន្តរ ជាតិចំនួនបី រូប និង នាំឲ្យមាន “ ការបញ្ចប់ ” កិច្ចស៊ើបសួរនៃសំណុំរឿង ០០៣ ដែលក្រោយមកត្រូវបានបើក កិច្ចស៊ើបសួរឡើងវិញដោយសហ ចៅក្រមស៊ើបអង្កេតអន្តរជាតិ ។
បន្ទាប់ពី សហ ចៅក្រមស៊ើបអង្កេតអន្តរជាតិបច្ចុប្បន្នលោក ម៉ាក ហាម៉ុន បាន កាន់ការងារស៊ើបសួរប្រហែលពីរ ឆ្នាំកន្លង មក លោក និងសមភាគី ជាតិរបស់លោក គឺលោក យូ ប៊ុន ឡេង បានចេញសេចក្តី ថ្លែង ការណ៍សំដែង ភាព មិនឯកភាពគ្នាលើ ភាព ចាំបាច់ដើម្បីធ្វើ កិច្ចស៊ើបសួរបន្ថែមក្នុងសំណុំរឿង ០០៣ ។
គណៈកម្មាធិការ ប្រព្រឹត្តិកម្ម បានលើកឡើងពី ការ ជាប់ទាក់ទិននៃ ការជំទាស់ របស់រាជរដ្ឋាភិបាលកម្ពុជាក្នុងឱកាស ផ្សេង ៗ ដែលនា ពេលថ្មី ៗក្នុង របាយកាណ៍សង្គមស៊ីវិលទៅកាន់គណៈកម្មាធិការ សិទិ្ធមនុស្ស កាលពី ខែកុម្ភៈ ឆ្នាំ ២០១៥ ។
ទោះបី ជា កិច្ចស៊ើបសួរក្នុងសំណុំរឿង ០០៣ និង ០០៤ របស់លោក ចៅក្រម ហាម៉ុន បានត្រូវបានរារាំងដោយសមភាគី ជាតិរបស់លោក និងរាជ រដ្ឋាភិបាលកម្ពុជាក៏ដោយ ក៏ វាលេច ឡើង យ៉ាងច្បាស់ដល់អ្នកអង្កេត ការណ៍ថា ចៅក្រម ហាម៉ុន មិនបានទទួលការគាំ ទ្រ ផ្នែកសម្ភារៈ ណាមួយពី សហ ចៅក្រមស៊ើបអង្កេត ជាតិលោក យូ ប៊ុនឡេងទេ ។
ដោយ សារតែ កង្វះការ គាំ ទ្រ នេះ ចៅក្រម ហាម៉ុន មិនអាចកោះហៅជនសង្ស័យ មកបង្ហាញចំពោះមុខ អ. វ.ត. ក ដែលបានធ្វើឲ្យគាត់គ្មានជម្រើស ណាផ្សេងក្រៅពី ដាក់ មាស មុត និង អ៊ឹម ចែម ឲ្យស្ថិតនៅក្រោមការ ត្រួតពិនិត្យដោយកំបាំង មុខ ។
គណៈកម្មាធិការ ប្រព្រឹត្តិកម្ម សូមសំដែងក្តី បារម្ភយ៉ាងខ្លាំងចំពោះការ ខ្វះ កិច្ច សហការដែលបន្តពី ខាងសហ ចៅក្រមស៊ើបអង្កេត ជាតិ ដែលបណ្តាលឲ្យ មាន ភាពមិន ស៊ីសង្វាក់ខាងនីតិ វិធីនឹង សំណុំរឿង ០០១ និង០០២ ដែលជន សង្ស័យបានត្រូវចាប់ខ្លួន និង ដាក់ក្នុង មន្ទី រឃុំ ឃាងបណ្តោះ អាសន្ននៅខណៈពេលដែល បទចោទបានត្រូវធ្វើឡើងប្រឆាំងនឹងពួកគាត់ ។
