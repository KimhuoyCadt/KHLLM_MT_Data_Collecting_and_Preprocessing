ថា គាត់ បាន បង្ហាញ ខ្លួន ដល់ ពេត្រុស បន្ទាប់មកដល់ ដប់ ពីរ នាក់ ។
អ្នកមិនអាចបម្រើព្រះ ហើយធ្វើជាខ្ញុំបម្រើរបស់ពិភពលោកបានទេ ។
ផ្ទះដែលបានរាប់ជាសុចរិតជាជាងផ្ទះមួយទៀត ដ្បិតអ្នក ណាដែលលើក ត ម្កើងខ្លួនឯងនឹងត្រូវគេបោះ បង់ចោល ។ ហើយ គាត់ នោះ ។
ប្រសិនបើ មាន អ្វី ខុស ជាមួយ ខ្ញុំ ខ្ញុំ ចង់ ក្លាយជា មនុស្ស ដំបូង គេ ដែល ដឹង អំពី វា ។
ដូច្នេះ បើយើងមានអាហារ និងសម្លៀក បំពាក់ យើងនឹងស្កប់ ចិត្ត ។
៤ ហើយគាត់មិនព្រមអស់មួយពេលទេ ប៉ុន្តែក្រោយមក គាត់និយាយទៅ កាន់ខ្លួនគាត់ថា ‹ ទោះបីខ្ញុំមិនកោតខ្លាចព្រះ ឬគោរពមនុស្សក៏ដោយ ។
ហើយបើមានអ្វីខុស យើងនឹងរួមទុក្ខដូចគ្នា ។
ក្នុង អំឡុង ពេល ថ្ងៃ ពួកគេ មិន ត្រូវបាន បំភ្លឺ ទេ ។
ខ្ញុំមិនចូល ចិត្តការ មើលឃើញ ឬអារម្មណ៍នៃគ្រួសារដែលត្រូវបានគេបំបែកនោះទេ » ។
មិនត្រូវបានគេបង្ហាញជាពាក្យទេ » ។
ព្រះ‌ ជា ម្ចាស់មានព្រះ‌បន្ទូល តប ថា៖ « មិនដូច្នោះទេ ខ្ញុំមានអ្នក បម្រើស្មោះត្រង់ដូចអ្នកចំនួន ៧.០០០ នាក់ផ្សេងទៀត ដែលលាក់ទុកពេញស្រុក » ។
និយាយ ថា នៃ កងកម្លាំង ប្រឆាំង ទៅនឹង សកម្មភាព របស់ ego នៅក្នុង
និយាយ នៅពេល កណ្តឹង រោទ៍ ។
ពេលយើងមានអារម្មណ៍ថាយើងអស់ សង្ឃឹម ព្រះបង្ហាញយើងថាលោកមិនមានកម្រិតទេ ។
' ត្រូវមានប្រាជ្ញាក្នុងរបៀបដែលអ្នកប្រព្រឹត្តចំពោះអ្នក ខាងក្រៅ ចូរប្រើឱកាសឱ្យបានច្រើនបំផុត ។
ពីព្រោះខ្ញុំបានស្រឡាញ់ បញ្ញត្តិរបស់ទ្រង់ ។
អាស្រ័យ ហេតុ នេះ ភាព តែ មួយ របស់ ព្រះត្រូវបាន សង្កត់ធ្ងន់ ។
ដើម្បីរក្សា កម្តៅក្នុងរយៈពេលពីរថ្ងៃចុងក្រោយនេះ » ។
តើអ្នកដឹងដោយរបៀប ណាថាអ្វីដែលមានដង់ស៊ីតេខ្លាំងបំផុត ?
នាងបានប្រៀបធៀបវាទៅនឹងការ ដាក់កង្កែបក្នុងឆ្នាំងទឹកពុះ ។
នេះជាការ ពិបាកនិយាយមួយផ្នែក ព្រោះវាជារឿងផ្ទាល់ខ្លួន ។
« គាត់ បាន មក ធ្វើជា សាក្សី ដើម្បី ថ្លែង ទី បន្ទាល់ អំពី ពន្លឺ ដើម្បីឲ្យ មនុស្ស ទាំងអស់ ជឿ តាមរយៈ ទ្រង់ » ។
គ្មានអ្វីត្រូវទិញ ព្រោះគ្មានអ្នក ណាលក់អ្វីនោះទេ ។
« ព្រះជាម្ចាស់បានចូល មកក្នុង ចិត្តខ្ញុំ ហើយជួយខ្ញុំឲ្យរីកចម្រើនខាងវិញ្ញាណ » ។
“ មាន អ្នក ដែល ព្យាយាម អនុវត្ត សង្គម និយម នៅ ទីនេះ ក្នុង សហរដ្ឋ អាមេរិក ។
" គ្មានការ ព្រួយបារម្ភឬការ ភ័យខ្លាច។
១២ យើងនឹងដើរក្នុងចំណោមអ្នក ហើយធ្វើជាព្រះ របស់អ្នក ហើយអ្នកនឹងធ្វើជា រាស្ដ្ររបស់យើង ។
ការ រកឃើញនៃដំណឹងល្អ ដោយការ អនុវត្តខុសចំពោះខ្លួនគាត់ ។
ខ្ញុំត្រូវបានគេប្រាប់ថាខ្ញុំអាចទិញបានរហូតដល់ទៅតម្លៃមួយខែក្នុងការ ទៅមួយ .
ដើម្បី ឈរ នៅលើ ភ្នំ ដែល មាន ព្រៃឈើ ក្រាស់ ទាំងនេះ ក្នុង ចំណោម ដើម ស្រល់ ស្រល់ និង ដើម ប៊ីច អាច មាន ទាំង ចលនា និង គួរឱ្យ ខ្លាច ។
ម្ភៃ ឆ្នាំ ជាមួយ ពិតប្រាកដ ឬ មិត្តភក្ដិ ។
អវិជ្ជា មិន ក្លាយជា អំពើ អាក្រក់ ក្នុង បរិបទ នៃ ភាពអាត្មានិយម ។
ពួកគេចេញទៅក្រោមការបញ្ជារបស់អ្នកគ្រប់គ្រង ។
៣ អ្នក រាល់គ្នាបានស្អាតស្អំហើយ ដោយ សារពាក្យដែលខ្ញុំបានប្រាប់អ្នក រាល់គ្នា ។
អ្នក ក៏ មិន ព្យាយាម បញ្ចូល ពួកវា ដែរ ។ ដែល បំផ្លាញ គោលបំណង ទាំងមូល ។
មកកូនប្រុសរបស់ខ្ញុំខ្ចីដៃ ។
ខ្ញុំ ចូលចិត្ត វា ជាង ដែល ខ្ញុំ ស្តាប់ វា ។
ពួកគេបានដាក់ស្ដង់ដារទាបខ្លាំងដែលដោយមានព្រះ ឬដោយគ្មានអំណាចរបស់ព្រះ ពួកគេមិនអាចប្រាប់ពី ភាពខុសគ្នានេះបានទេ ។
ពួកលេវីទាំងអស់បានមក ឯម៉ូសេ ។
បុរសនោះបានលាតដៃឡើង ហើយវាត្រូវបានស្ដារឡើងវិញដូចដៃម្ខាងទៀត ។
ទាមទារ ទៅ អ៊ីស្រាអែល ។
ខ្ញុំស្រឡាញ់អ្វីដែលមនុស្សម្នាក់បាននិយាយថា « ព្រះ មានព្រះរាជ បុត្រា តែមួយ ហើយទ្រង់បានតាំងទ្រង់ ជាអ្នកផ្សព្វផ្សាយសាសនា » ។
ដូច្នេះហើយ សេចក្តី អំណររបស់ខ្ញុំឥឡូវនេះបាន បញ្ចប់ហើយ ។ គាត់ត្រូវ តែកើន ឡើង ប៉ុន្តែខ្ញុំត្រូវតែថយចុះ » ។
បច្ចុប្បន្នខ្ញុំកំពុងរស់ នៅក្នុងប្រទេសនេប៉ាល់ ខណៈខ្ញុំកំពុងធ្វើការ ឲ្យអង្គការអន្តរជាតិ ។
“ ខ្ញុំសូមអំពាវនាវដល់អ្នកទាំងអស់គ្នា ។
ព្រោះគាត់ធ្លាប់ជាចោរ ។
នេះ មាន ន័យ ថា អ្នក បាន អនុវត្ត កូដ ត្រឹមត្រូវ ។
ខ្ញុំឆ្ងល់ថាហេតុអ្វីបានជាខ្ញុំនៅ តែឃើញពួកគេនៅគ្រប់ទីកន្លែងសព្វថ្ងៃ ?
សូមកត់សម្គាល់ថា ព្រះ ដ៏មាន មហិទ្ធិ ឫទ្ធិដែលគង់លើបល្ល័ង្ក ។
និក្ខម នំ 13:4 បុរសថ្វាយបង្គំនាគ ព្រោះវាបានប្រទានអំណាចដល់សត្វនោះ ហើយគេក៏ថ្វាយ ‌បង្គំសត្វនោះ ហើយសួរថា “ តើអ្នក ណាដូចសត្វ តិរច្ឆាន ?
មិន បញ្ចប់ នៅក្រោម ដើមឈើ ។
រហូតដល់ ថ្ងៃ ជំនុំ ជំរះ
ព្រះអង្គ បាន ឡើងសោយរាជ្យ ជាង 2 ឆ្នាំ មុន បន្ទាប់ពី ការសោយទីវង្គត របស់ ព្រះបិតា ជា ទីស្រឡាញ់ របស់ ព្រះអង្គ ប៉ុន្តែ បាន រង់ចាំ រយៈពេល កាន់ ទុក្ខ ដ៏ យូរ មួយ ដើម្បី កន្លងផុត ទៅ មុនពេល កំណត់ កាលបរិច្ឆេទ ឡើង គ្រងរាជ្យ របស់ ព្រះអង្គ ។
តាមពិត គ្មានរឿងនេះធ្វើឲ្យខ្ញុំភ្ញាក់ផ្អើលទេ ។
ខ្ញុំ គិត ថា ខ្ញុំ នឹង កាន់ ទុក្ខ កាលពី យប់ មិញ ។ បន្ទាប់ពី ខ្ញុំ បាន ឃើញ ការបោះឆ្នោត ។
ខ្ញុំនឹងធ្វើ កិច្ចការរបស់ម្ដាយ » ។
៩ អ្នកនឹងមក ឯពួកបូជាចារ្យ ពួកលេវី ហើយនឹងទៅ ឯចៅក្រមដែលនឹងនៅសម័យនោះ ។
ដូច្នេះ គ្រប់ ពេល ទាំងអស់ ត្រូវបាន រក្សាទុក ។
« ទុកក្រុមហ៊ុន ស្រីនេះមួយ រយៈ ។
ខ្ញុំបាននិយាយមុននេះថា ខ្ញុំមិនស្គាល់បុរសនោះទេ ។
ក្មេងប្រុស មិន ស្លាប់ ដោយសារ គ្រាប់ កាំភ្លើង ទេ ។
២៤ « ខ្ញុំប្រាប់អ្នក រាល់គ្នាតាមការ ពិតថា គ្មានអ្នកប្រកាសទំនាយ ណានៅស្រុក កំណើតរបស់គាត់ឡើយ ។
បន្ទាប់មកពួកគេប្រាប់ពួកគេថា ពួកគេសុខ ចិត្តស្នាក់នៅ ។
ជាការ ពិតណាស់នៃការ ស្លាប់មកនៅក្នុងសំណុំបែបបទនៃ
