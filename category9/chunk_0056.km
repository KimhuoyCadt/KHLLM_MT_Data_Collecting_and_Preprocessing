ទាញយក អត្ថប្រយោជន៍ ពី វា ខណៈពេល ដែល វា ជា រដូវកាល !
៨ គេនិយាយទៅលោកយ៉ូស្វេ ថា៖ « យើងខ្ញុំ ជាអ្នក បម្រើរបស់លោក » ។
នាង បាន និយាយ ថា “ ប៉ូលីស បាន ប្រាប់ ខ្ញុំ ថា ជនសង្ស័យ បាន សារភាព ថា ខ្លួន បាន ចូល បន្ទប់ ដើម្បី ប្លន់ ខ្ញុំ ប៉ុន្តែ ពេល ដឹង នាង ដឹងខ្លួន គាត់ បាន លាក់ នៅក្នុង បន្ទប់ របស់ ខ្ញុំ ។
ថ្ងៃ នេះ ជា ថ្ងៃអាទិត្យ ហើយ ខ្ញុំ មិន ធ្វើការ ទេ ។
យើងបានឈ្នះក្នុងពីររដូវ កាលចុងក្រោយនេះ ប៉ុន្តែពួកគេនៅទីនោះជានិច្ច » ។
ហើយ មាន តម្លៃ ចំពោះ ដំបូន្មាន ប្រាជ្ញា និង ចំណេះដឹង របស់ ពួកគេ ។
៣) « មាននរណាម្នាក់អង្គុយក្នុងម្លប់ថ្ងៃនេះ ព្រោះអ្នកខ្លះដាំដើមឈើយូរហើយ » ។
រដ្ឋបាន កន្លងផុត ទៅ ហើយ ។
លោកក៏បានពន្យល់ពួកគេថា ពួកគេត្រូវយកមួយនោះដាក់លើស្មាដោយរីករាយ ។
វា ទាំងអស់ កើត ចេញពី ចិត្ត និង ចិត្ត ។
ហេតុនេះហើយបានជានៅពេលដែលពួកគេ មក កាន់ប្រទេសឥណ្ឌូនេស៊ីជាផ្លូវ ការ ។
គាត់បានធានាថា “ ខ្ញុំមិនដែលឃើញអ្វីបែបនេះទេក្នុងមួយជីវិតរបស់ខ្ញុំ ។
កូនមនុស្សត្រូវប្រគល់ឲ្យ
« ឱ ជន ជាតិស៊ីយ៉ូនដែល រស់នៅក្រុងយេរូសាឡឹមអើយ អ្នក រាល់គ្នានឹងលែងយំទៀតហើយ ព្រះអង្គនឹងមានព្រះហឫទ័យសប្បុរសចំពោះអ្នក រាល់គ្នា នៅពេលដែលអ្នកស្រែកឡើង នោះព្រះអង្គនឹងឆ្លើយ តប មកអ្នក រាល់គ្នាភ្លាម » ។
“ ខ្ញុំបានឃើញទូកតូចពីរបើកលឿនសំដៅទៅរកវា ។
នោះមិនមានបញ្ហាច្រើនទេ ព្រោះសាលក្រមបានប្រព្រឹត្តទៅហើយ ។
កូន ចៅ របស់ ពួកគេ ; ព្រោះ កម្រ មាន ការកើនឡើង ប៉ុន្តែ ដោយ ការលាយ បញ្ចូល គ្នា នៃ សិល្បៈ ល្អ និង អាក្រក់ ។
កុំ រញ៉េរញ៉ៃ ជាមួយ ក្មេងប្រុស មកពី កាហ្សាក់ ស្ថាន !
អ្នក ពិតជា បាន ធ្វើឱ្យ ភាព ជា បងប្អូន ធ្លាក់ចុះ
គំនិត បង្កើត ក្រុម ជាមួយ បង ប្រុស ។
មិនទាន់ត្រូវបានលើក ត ម្កើង » ។
“ ព្រះអម្ចាស់ អើយ យើង គ្រាន់តែ ចង់ សរសើរ ទ្រង់
ទោះបីជា ពួកគេ ប្រញាប់ប្រញាល់ ចូល ក៏ដោយ ក៏ ពួកគេ នឹង ត្រូវ លុបចោល ឬ លុបចោល គោលដៅ ។
អ្នក គឺជាមិត្ត ភក្តិរបស់ខ្ញុំប្រសិនបើអ្នកធ្វើដូចដែលខ្ញុំបានបង្គាប់។
ម៉ារី បានលូកចូលក្នុងនោះ » ។
ប៊្លូធូស ត្រូវតែ ទុកចោល ។
ហើយ សំខាន់ បំផុត នោះ យើង នឹង ត្រូវបាន ការពារ ដោយ ព្រះ។
ពេលនោះខ្ញុំនឹងប្តូរ ចិត្តចំពោះគាត់ ។
ពិបាកគំរាមចាកចេញ ។
ខ្ញុំ បាន រងរបួស ក្នុង លក្ខណៈ អស់សង្ឃឹម ។ ហើយ ប្រសិនបើ វា មិន មាន សម្រាប់ ទន្លេ រវាង ពួកយើង ទេ នោះ គ្មាន នរណា ម្នាក់ ក្នុង ចំណោម ពួកគេ នឹង ត្រូវបាន ចាកចេញ ដើម្បី ប្រាប់ រឿង និទាន នោះ ទេ ។
កុំ ព្យួរ ; ជីវិត ពោរពេញ ដោយ ការខកចិត្ត ។
ហើយអ្នកដែលត្រូវបានគេបង្ហាញផងដែរថាអ្នកទាំងនោះនិង របួសរបស់អ្នក។
ពេលគាត់ចង់ទៅ ខ្ញុំក៏ទៅជាមួយ » ។
សូមស្វាគមន៍ មកកាន់ ផ្ទះ ដែល បាន ផ្លាស់ប្តូរ
ដូច្នេះ ខ្ញុំនិយាយជាពាក្យប្រស្នាទៅគេ ពីព្រោះពេលឃើញគេមើលមិនឃើញ ហើយពេលឮគេមិនឮក៏មិនយល់ដែរ ។ក្នុងករណីរបស់គេទំនាយរបស់អេសាយកំពុងត្រូវបានសម្រេចដែលពោលថា
« យើងមិនមានការ ខឹងសម្បារនឹងអ្នកដែលប្រព្រឹត្ត បទល្មើសនេះទេ ។
គាត់ បាន អង្វរ សុំ ការអភ័យទោស និង ការព្យាបាល ។
ពន្លឺ គឺជា ព្រះ។
អ្នក ណាមិនទទួលអ្នក ឬមិនឮពាក្យរបស់អ្នក ពេលអ្នកចេញពីផ្ទះនោះ ឬទីក្រុងនោះ ចូរអង្រួនធូលីដីចេញពីជើងអ្នក ។
ខ្ញុំកំពុងឈរនៅភ្លើង ស្តុបនៅផ្លូវ ២៤ តុលា ហើយខ្ញុំឃើញស្ត្រីម្នាក់ដេកលក់ ខ្ញុំគិតថានាងមានអាយុចន្លោះពី ២០ ទៅ ៣៥ ឆ្នាំ ។
នោះ ហើយ ជា មូលហេតុ ដែល រាងកាយ របស់ ខ្ញុំ មិន អនុញ្ញាតឱ្យ ខ្ញុំ រុញ ។
ពួកគេ បាន បង្ខំ នាង ឱ្យ ផឹក ពី បង្គន់ នៅពេល នាង ស្រេក ។
ពីក្រោយគាត់ » ។
ប៉ុន្តែអ្នក ណាដែលមិនជឿលើទ្រង់បានត្រូវវិនិច្ឆ័យរួចហើយថាមិនជឿលើព្រះរាជ បុត្រា តែមួយរបស់ព្រះ» ។
ប៉ុន្តែអ្នក ណាដែលមិនជឿលើព្រះ‌ អង្គបានត្រូវកាត់ទោសរួចហើយ ដោយ សារមិនជឿលើព្រះរាជ បុត្រា តែមួយរបស់ព្រះ» ។
ពួកគេ គ្រាន់តែ ជា ទូរស័ព្ទ ទំនើប ប៉ុណ្ណោះ ។
១៩ នាំឲ្យមានការ មិនពេញ ចិត្ត ។
“ ឪពុករបស់ខ្ញុំ សង្ឃឹមថាខ្ញុំនឹងទទួលបានចំណងមិត្តភាពជាមួយអ្នកទាំងពីរ ។
ប៉ុន្តែ ភ្លើងបានធ្លាក់មកពីស្ថាន សួគ៌ ហើយបំផ្លាញពួកគេ ។
សូមឲ្យយើងធ្វើដំណើរបីថ្ងៃទៅវាល រហោស្ថាន ដើម្បីថ្វាយ យញ្ញ បូជាដល់ព្រះ‌ អម្ចាស់ ជាព្រះ នៃយើង ។
វា ជា ទីបញ្ចប់ នៃ ពិភពលោក ។ តើ អ្នក កំពុង រង់ចាំ បន្ទាត់ កណ្តាប់ដៃ ទេ ?
ឱ ព្រះបិតានៃយើងរាល់គ្នាអើយ សូមកុំងាកចេញពីយើងឡើយ ។
កូន ពៅឥឡូវនៅជាមួយឪពុកយើង ហើយម្នាក់ទៀតបាត់ទៅ » ។
សត្វ សេក រាប់ សិប ប្រភេទ ត្រូវបាន
ហើយ ខ្ញុំ មក ទីនេះ ដើម្បី ប្រាប់ អ្នក ថា ពួកគេ ទាំងអស់ គ្នា ជា អ្នកនាំផ្លូវ ខុស ដូចគ្នា ។
ប៉ុន្តែបើអ្នក ណាមិនផ្គត់ផ្គង់សម្រាប់ខ្លួនឯង ហើយជាពិសេសសម្រាប់គ្រួសាររបស់ខ្លួន អ្នកនោះបានបដិសេធជំនឿ ហើយអាក្រក់ជាងអ្នកមិនជឿទៅទៀត ។ ~ ធី ម៉ូថេទី១ ៥: ៨
នៅ ថ្ងៃ នោះ ម្តាយ នឹង ទម្លាក់ បន្ទុក របស់ នាង ។
« តើមនុស្សនិយាយថាកូនមនុស្ស ជាអ្នក ណា ?
ជា ការពិត យើង មិន មាន ព័ត៌មាន ទាក់ទង នឹង ភេទ របស់ កុមារ ទេ
ប៉ុន្តែ វា មាន តម្លៃ ព្រួយបារម្ភ អំពី កុមារ ។
បង្ខំឱ្យ ទទួលបាន ផលប្រយោជន៍ របស់ ពួកគេ ហើយ ពួកគេ ក៏ កំពុង ផ្លាស់ប្តូរ ផងដែរ ។
តម្លៃ ល្អ និង ដំណើរការ គ្រប់ ជ្រុងជ្រោយ ។
មាន តែម្នាក់ទេដែលអាចប្រាប់រឿងនេះបាន ។
ខ្ញុំ ប្រាប់ អ្នក ថា អ្នក នឹង មិន ឃើញ ខ្ញុំ ទៀត ទេ រហូតដល់ អ្នក ។
បន្ទាប់មក វាយ លា របស់ អ្នក សម្រាប់ ការវាស់វែង ល្អ ។
គ្មានអ្វីលាក់បាំងដែលនឹងមិនត្រូវបានលាត ត្រដាងឬលាក់បាំងដែលនឹងមិនត្រូវបានគេដឹង។
ការចាប់ឆ្នោត ពិការ ភ្នែក នឹង ត្រូវ ធ្វើឡើង ។
អ្នក ណាដែលជឿលើខ្ញុំនឹងមានជីវិត ទោះបីស្លាប់ក៏ដោយ ។
