ទីនោះ ព្រះបាន ការពារ គាត់ ហើយ បាន រៀបចំ គាត់ សម្រាប់ កិច្ចការ ធំ បំផុត ក្នុង ជីវិត របស់ គាត់ និក្ខម នំ ៣១០ ។
ថា យើង ត្រូវការ អ្នក បៃដិន ។
ហើយ យើង មិន អាច ចូលក្នុង នគរ ស្ថាន សួគ៌ បាន ឡើយ លើកលែងតែ យើង បាន ទទួល អំណោយ នៃ ការលះបង់ របស់ ព្រះយេស៊ូវ នៅលើ ឈើ ឆ្កាង ប៉ុណ្ណោះ ។
ឬ បើកបរ រថយន្ត រយៈពេល យូរ អង្គុយ យូរ ពេក
១៥ អ្នក ក៏ ត្រូវ ប្រយ័ត្ន នឹង គាត់ ដែរ ដ្បិត គាត់ ប្រឆាំង យ៉ាង ខ្លាំង នឹង សេចក្តី ដែល យើង ប្រកាស ។
ត្រី មាន មុខ ដូច មនុស្ស វីដេអូ
រីឯ អ្នករបួស ស្រាល ១២នាក់ និង របួស ធ្ងន់ ៨នាក់ ពុំ ទាន់ បាន ស្គាល់ អត្តសញ្ញាណ នៅឡើយ នោះ ទេ អ្នករបួស ធ្ងន់
ត្រូវ ប្រាកដ ថា អ្នកប្រើ ទែ ម៉ូម្រែត្រ បាន ត្រឹមត្រូវ ។
ខ្ញុំ ណា ទៅ ពិបាកចិត្ត ទៅ ដើរ ប្រាប់ គេ ឯង សាធារណៈ អ៊ីចឹង បើ មាន រឿង អ៊ីចឹង មែន ។
អ្នក រាល់គ្នា ត្រូវ វេទនា ជា ពុំ ខាន ព្រោះ អ្នក រាល់គ្នា និយាយ ថា បើ អ្នកណា ស្បថ ដោយ យក ព្រះវិហារ ធ្វើជា សាក្សី ពាក្យសម្បថ នោះ យក ជា ការពុំ បាន ទេ ។
នរណា នៅជិត ឆ្នាំ ចកុរ ឆ្លូវ និង រកា អ្នក នោះ នឹង មាន ទ្រព្យ ធំ ចូល
របស់ ពួកគេ ប្រៀប បាន នឹង ភ្លើង ក្រហម ឆ្អិនឆ្អៅ
ពេល ដែល ព្រះជា ម្ចាស់ ឆ្លើយតប នឹង ការអធិស្ឋាន របស់ យើង នោះ ជា ព្រះពរ ពិត មែន ប៉ុន្តែ ការ ដែល យើង អធិស្ឋាន ក៏ ជា ព្រះពរ ផ្ទាល់ ផងដែរ ។
៤៦ ប្រសិនបើ អ្នក រាល់គ្នា ជឿ ពាក្យ លោក ម៉ូសេ អ្នក រាល់គ្នា មុខ ជាជឿ ខ្ញុំ មិន ខាន ព្រោះ លោក បាន សរសេរ ទុក ក្នុង គម្ពីរ ស្តី អំពី ខ្ញុំ ៤៧ ប៉ុន្តែ បើ អ្នក រាល់គ្នា មិន ជឿ សេចក្តី ដែល លោក បាន សរសេរ ទុក ទៅ ហើយ នោះ ធ្វើ ម្តេច នឹង អោយ អ្នក រាល់គ្នា ជឿ ពាក្យ របស់ ខ្ញុំ បាន !
អ្នក មិន ត្រូវ ប្រញាប់ប្រញាល់ វាយតម្លៃ ហេតុការណ៍ ណាមួយ នោះ ពេល អ្នក ពុំ យល់ ច្បាស់ ។
៣០ ប៉ុន្តែ ព្រះជាម្ចាស់ បាន ប្រោស ព្រះអង្គ អោយ រស់ ឡើងវិញ ។
អ្នក ត្រូវ ទៅដល់ កន្លែង ដែល មនុស្ស ៩៧% មិន បាន ទៅដល់ ប្រសិនបើ អ្នក ចង់ ធ្វើឱ្យ ក្តីសុបិន្ត ហិរញ្ញវត្ថុ កើតឡើង ។
ដោយ ថា សេចក្តីទុច្ចរិត របស់ ខ្លួន មិន ដែល មាន
ហើយ ការណ៍ ដែល ជា បក្ស ប្រឆាំង មួយ ពិតប្រាកដ ពួកគេ មុខ ជា នឹង មិន ត្រូវបាន អនុញ្ញាតឱ្យ ចូលរួម ការបោះឆ្នោត ឡើយ ។
បុត្រា តិច បុត្រី ច្រើន
២០ទ្រង់ បាន ធ្វើ អំពើ អាក្រក់ មួយ ទៀត គឺ ចាប់ លោក យ៉ូហាន ទៅ ដាក់ ក្នុង មន្ទីរឃុំឃាំង ។
គេ មាន កិច្ចពិភាក្សា នយោបាយ របស់ គេ ហើយ មិន មែន ជា ប្រធានបទ របស់ លោក ឯង ទេ ។
ដែល អ្នក ធ្លាប់ ចូលចិត្ត ខ្លាំង ពី មុន ឡើងវិញ ស្តាប់ ម្នាក់ឯង ឬ ជាមួយ សំណព្វចិត្ត ៖
ឬ ធ្វើ អ្វី ដែល ធម្មតា នោះ ពួកគេ នឹង មិន សូវ ត្រូវបាន ទទួល ការរិះគន់ ឬ សើចចំអក ពី មនុស្ស ជុំវិញ ខ្លួន នោះ ឡើយ ព្រោះ មនុស្ស ភាគ ច្រើន គឺ មាន លក្ខណៈ បែប នេះ ដែរ ។
មិន មែន មនុស្ស ម្នាក់ ទេ គឺ មនុស្ស រាប់ លាន នាក់ ដែល ផ្ទុះ បាតុកម្ម នេះ ។
សម្តេច ក្រុម ព្រះអង្គ នេះ បាន រួបរួម សេចក្តី ចេញ ពី គម្ពីរ ផ្សេង ៗ
ទូលបង្គំ នឹង ចែក ទ្រព្យសម្បត្តិ របស់ ទូលបង្គំ ចំនួន ពាក់កណ្តាល ដល់ មនុស្ស ក្រីក្រ ហើយ ប្រសិនបើ ទូលបង្គំ ទារ ពន្ធ ពី អ្នកណា ហួស កំរិត ទូលបង្គំ នឹង សង អ្នក នោះ វិញ មួយ ជា បួន ។
ការ ដែល យើង ស្តាប់ បង្គាប់ ទ្រង់ ដោយ ស្មោះត្រង់ គឺជា ការ ដែល យើង ថ្វាយ ការអរ ព្រះគុណ ដល់ ទ្រង់ ព្រោះ ទ្រង់ បាន សង្គ្រោះ យើង រួចទៅហើយ ។
ហើយ ប្រឆាំង នឹង ព្រះគ្រិស្ត របស់ ព្រះអង្គ ។
អង្គប្រជុំ បាន ពិភាក្សា គ្នា យ៉ាង ផុសផុល តាម របៀបវារៈ នីមួយ ៗ
សិស្ស ទូល ថា ខ្ញុំ ព្រះករុណា មើល មិន ឃើញ ។
ប្រសិនបើ អ្នក សរសេរ ជាប់ គ្នា ដោយ មិន បាន ផ្តាច់ ពាក្យ នីមួយ ៗ
ពិតជា កិត្តិយស មួយ សម្រាប់ ឪពុក ម្តាយ ពិត មែន ។
អណ្តូង ព្រេង អច្ឆរិយ ទម្លាក់ អ្វី ចូល ឃើញ វិញ នៅ កន្លែង ផ្សេង
អ្នកណា លើកតម្កើង ខ្លួនអ្នក នោះ នឹង ត្រូវ គេ បន្ទាប ចុះ រីឯ អ្នក ដែល បន្ទាប ខ្លួន នឹង ត្រូវ គេ លើកតម្កើង វិញ ។
ភាគ ច្រើន ប៉ុន្តែ មិន មែន ទាំងអស់ នៃ
ជឿជាក់ ស្មោះស្ម័គ្រ តាម បែប ដូនតា គង់តែ ទេ ព្តា
យើង ក៏ នឹង វិនិច្ឆ័យ ទោស ពួកគេ ព្រោះ គេ
គេ មាន ជំនឿ ថា ព្រះគឺជា អ្នកសាង ហើយក៏ ជា អ្នក បំផ្លាញ ដែរ ។
ចាប់ពី យប់ នេះ រហូតដល់ ថ្ងៃ ៣០ ឆ្នាំ ទាំង ៥រាសី ល្អ លាភ ធំ ផុស ចាំ អ្នក
ស្ត្រី ឞុ ទុឞ្តា សុវ៌្ឞ្ណោយ ជាយ តេវ៌្ណ សំករះ ៕
ដោយ ខ្លួន ឯង នៅក្នុង បន្ទប់ ដេក បិទ ទ្វារ ជិត លុះ ព្រឹក
ទ្រង់ នាំ មនុស្ស ឱ្យ ចូលមក រក ទ្រង់ ដោយសារ ទ្រង់ ស្រឡាញ់ ពួកគេ ។
ក្រោយពី នារី ដ៏ ស្រស់ស្អាត ម្នាក់ បាន រិះគន់ ចំ ៗ
របួស បាក់ ភ្លៅ ២នាក់ និង សន្លប់ ម្នាក់ ដោយ ម៉ូតូ បុក ម៉ូតូ ចំ ពេញ ទំហឹង
៤ឯ ទ្រព្យសម្បត្តិ គ្មាន ប្រយោជន៍ ក្នុង ថ្ងៃ ពិរោធ ឡើយ តែ សេចក្តីសុចរិត នឹង ជួយ ឱ្យ រួច ពី ស្លាប់ វិញ ។
មនុស្ស ដែល រស់ នៅ លើ ភព ផែនដី នេះ គឺ សុទ្ធតែ ជា អ្នក មាន សេចក្តីប្រាថ្នា ចង់បាន សុខ គ្រប់ ៗ
ុ បរិស័ទែ ខមរយ៉ង ពិតបក ដេហយក៏ ស័ក កិសម ចូល កនង
ពួកគេ មិន បាន ធ្វើឱ្យ ព្រះជាម្ចាស់ សព្វ ព្រះហឫទ័យ ទេ ហើយ ទាស់ នឹង មនុស្ស ទាំងអស់
ខ្ញុះ បាន សម្រេចចិត្ត លា លែង ពី តំណែង ពីព្រោះ ខ្ញ ដឹង ថា ខ្ញុំ ត្រូវតែ ទទួលខុសត្រូវ ផ្នែក នយោបាយ ៕
ភ្នែក អាច ប្រាប់ រឿងរ៉ាវ បាន ច្រើន ជាពិសេស តើ ស្ត្រី នោះ កំពុង កុហក ឬ និយាយ ពិត ។
្រទ ង់្របសូត្រ ទង់ ឈនេដ រើ បន ៧ជំ
គេ បាន ជួយ ខ្ញុំ ច្រើន ណាស់ ហើយ ពួក ខ្ញុំ នៅតែ ជា មិត្តភក្តិ នឹង គ្នា ។
ជាតិ ស្ករ មាន សារៈសំខាន់ ណាស់ សម្រាប់ ជីវិត ប៉ុន្តែ អ្នក ត្រូវតែ ញ៉ាំ វា ក្នុង កម្រិត មធ្យម បាន ហើយ ។
ក៏ប៉ុន្តែ ប្រសិនបើ សម្រាប់ អ្នក បាន ស្គាល់ មនុស្ស នេះ ច្បាស់ វិញ នោះ គេ នឹង ដឹង ថា គេ ជា មនុស្ស ចូលចិត្ត លេង សើច ច្រើន ពូកែ វោហារីករាយ ស្រស់ស្រាយ និង មិន ចូលចិត្ត កេង យក ប្រៀប លើ នរណា ម្នាក់ នោះ ទេ ។
ចូរ ឈរ ឱ្យ មាំ មួន ហើយ កាន់ តាម សេចក្តី ដែល យើង បាន បង្រៀន អ្នក រាល់គ្នា ចុះ ទោះបី ដោយ ពាក្យសំដី ឬ សំបុត្រ ក្តី ។
លោក បន្ត ថា ការយាង ចូល បម្រើ ឆាក នយោបាយ ជាថ្មី ជាមួយ គណបក្ស ថ្មី ព្រះអង្គ នឹង ធ្វើ ការ កៀង គរ អ្នក រាជានិយម ទាំងអស់ មក រួបរួម ជាមួយ ព្រះអង្គ ដើម្បី លើកស្ទួយ ជា របប រាជានិយម នៅ កម្ពុជា ។
ជាច្រើន ជាង ដែល ខ្ញុំ បាន គិត ។
ប្រែ ថា ហោតុ សព្វំ សុមង្គ លំសុមង្គល គឺ សេចក្តី ចម្រើន ដ៏ ល្អ គ្រប់ យ៉ាង ចូរ មាន ដល់ ខ្ញុំ រក្ខន្តុ សព្វ ទេវតា ទេវតា ទាំងពួង ទាំងឡាយ
លោក បន្ថែម ថា ដោយសារតែ ចរិត នយោបាយ តែង មាន ការឆ្លើយឆ្លង គ្នា ធ្ងន់ ៗ
សូម ប្រើប្រាស់ វិធីសាស្ត្រ មួយ នេះ ២ដង ក្នុង មួយ ថ្ងៃ ហើយ អ្នក នឹង សង្កេតឃើញ ពី ប្រសិទ្ធភាព របស់ វា ក្នុង ពេល ពីរ សប្តាហ៍ ៕
តើ ព្រះជាម្ចាស់ មាន អំណាច គ្រប់គ្រាន់ អាចនឹង ធ្វើ ការ នេះ បាន ទេ ?
ក្រៅពី ឧទ្ធម្ភាគចក្រ យើង ក៏ បាន ឃើញ រថ ពាស ដែក ចំនួន ៤គ្រឿង និង រថយន្ត ដឹក កងទ័ព ៣ គ្រឿង ផ្សេង ទៀត បាន បើក ប្រទ្រុយ ចុះ ឡើង នៅក្នុង ទឹកដី របស់ ពួកគេ ។
អត់ ប្រាប់ គ្នា ប្រាប់ អ្នក ខ្លះ ប្រាប់ អត់ ខ្លះ ។
ពិតប្រាកដ ណាស់ អល់ ឡោះ បាន ជ្រើសរើស សាសនា អ៊ីស្លាម សម្រាប់ ពួក អ្នក ។
ចូរ តយុទ្ធ ឱ្យ បាន យ៉ាង ល្អ ចូរ បញ្ចប់ ការប្រណាំង ហើយ ចូរ បន្ត រក្សា ជំនឿ ដែរ ។
ខ្ញុំ ចូលចិត្ត មនុស្ស ដែល មិន ត្រូវបាន គេ ចាប់ខ្លួន ។
ពួកគេ នឹង យល់ ថា គាត់ ជា មនុស្ស កុហក និង ជា អ្នកនយោបាយ អាក្រក់ ម្នាក់ ។
ព្រះអង្គ ទ្រង់ ត្រាស់ ថា អ្នក ទាំងឡាយ គួរ ធ្វើ នូវ កិច្ច របស់ ខ្លួន ព្រោះថា តថាគត ទាំងឡាយ គ្រាន់តែ ជា អ្នកចង្អុលបង្ហាញ ផ្លូវ ប៉ុណ្ណោះ ។
ថា ឆ្នាំ នេះ មនុស្ស ប្រុស រាប់ ពាន់ នាក់ នឹង ស្លាប់ ដោយសារ ភាព រឹង ចចេស ។
១៧ បងប្អូន បាន អរ ព្រះគុណ ដូច្នេះ ល្អ វិសេសវិសាល ហើយ តែ បងប្អូន ពុំ បាន កសាង ជំនឿ អ្នក ដែល មក ស្តាប់ នោះ ទេ ។
ទ្រង់ ធ្វើ ដូច្នេះ ដើម្បី យក ជីវិត ដែល ទ្រង់ បាន ផ្លុំ ចេញ ឱ្យ ត្រលប់ មកវិញ
អ្នក និយាយ ថា ពេលនេះ អ្នក មិន ជួប ការលំបាក បន្តិច ណា ឡើយ ។
ទេ បើ ចឹង ទៀត យ៉ាប់ ហើយ ប៉ុន្មាន ឆ្នាំ ចុងក្រោង នេះ ទឹក ទាប ឆ្ងាយ ។
អ្នក អត្ថាធិប្បាយ ប្រឆាំង … អាន បន្ត
ដោយសារ ព្រះអង្គ បាន ទទួល ទឹក អំរិត ប្រក់ ព្រំ ពី ទេវតា ស្តេច កំជិល ផេះ មាន អាយុ វែង យឺន យូរ ណាស់ ។
គណបក្ស ប្រឆាំង ថៃ ជួបជុំគ្នា ប្រឆាំង នឹង សេចក្តីស្នើ ច្បាប់ លើកលែង ទោស រួម
ខេមបូនឹង ព្យាយាម ស្វែងរក ដំណោះស្រាយ ជូន ប្រិយមិត្ត ជា មិន ខាន ។
តើ ភាពយន្ត មួយ ណា នឹង ទទួលបាន ពានរង្វាន់ អូស្ការ នៅ យប់ នេះ ?
នៅ ជាន់ ក្រោយ បង្អស់ មនុស្ស ជាច្រើន ស្រឡាញ់ តែ ខ្លួន ឯង ស្រឡាញ់ ប្រាក់ និង ការសប្បាយ តែ ពួកគេ មិន ស្រឡាញ់ ព្រះឡើយ ។
ប្រជាពលរដ្ឋ ទាំងនេះ ព្រមាន ថា បើ ពុំ មាន ដំណោះស្រាយ បញ្ចប់ តាម ការសន្យា ឱ្យ បាន ឆាប់ ៗ
ជា ថ្ងៃអន្ធការគ្មាន ពន្លឺ រស្មី អ្វី សោះ ។
មាន បុរស និង ស្ត្រី ជាច្រើន នៅក្នុង សាសនា គ្រិស្ត ដែល មាន ជំនឿ យ៉ាង មុតមាំ លើ ព្រះអម្ចាស់ យេស៊ូវ គ្រីស្ទ ហើយ យើង សូម ផ្តល់ កិត្តិយស ហើយ គោរព ពួក គាត់ ។
មុនពេល ព្រះអង្គ លើក លោក ឡើង ទៅ នោះ លោក បាន ទទួល សក្ខីភាព ថា ព្រះជាម្ចាស់ គាប់ ព្រះហឫទ័យ នឹង លោក ។
នេះ ជាបញ្ជា ដែល ខ្ញុំ បាន ទទួល ពី ព្រះជាម្ចាស់ ។
ព្រោះ នៅ ចុងបញ្ចប់ ពួកគេ ទាំងនោះ នឹង ក្លាយជា សេដ្ឋី ។
មកដល់ ពេលនេះ គឺ ជិត ដល់ រដូវកាល សន្យា របស់ ពួក គណបក្ស ប្រឆាំង ទៀត ហើយ ។
បាន សេចក្តី ថា ប្រសិនបើ អ្នកណា ប្រព្រឹត្ត ទោស ដូចជា អាបត្តិ ទុក្កដ ទុភា សិត ថុល្ល ច័យ អី ស្រាល ៗ
ដ្បិត អ្នក រាល់គ្នា បាន ទទួល ព្រះរាជ្យ របស់ ព្រះជាម្ចាស់ ។
សាវ័ក របស់ លោក បាន អះអាង ថា វីដេអូ ដែល បង្ហាញ ពី ភ័ស្តុតាង ចោទប្រកាន់ លោក ជា រឿង ប្រឌិត ។
ថ្ងៃ កំណើត គ្រាន់តែ ជា ការកំណត់ អាយុ របស់ មនុស្ស ម្នាក់ ៗ
ការធ្វើ ដូចនេះ នឹង នាំឱ្យ យើង អាច ចំណាយ ពេល ស្ងាត់ ស្ងៀម ជាមួយ ព្រះបាន កាន់តែ ប្រសើរឡើង ។
នោះ នឹង បាន រង្វាន់ តាម ការ ដែល ខ្លួន ធ្វើ ៩ដ្បិត យើង រាល់គ្នា ជា អ្នកធ្វើការ ជាមួយនឹង ព្រះឯ អ្នក រាល់គ្នា ជា ស្រែ ដែល ព្រះទ្រង់ ភ្ជួរ ហើយ ជា ផ្ទះ ដែល ព្រះទ្រង់ ធ្វើ ។
ទោះបីជា យ៉ាងណា យើង ដឹង ថា ព្រះជាម្ចាស់ ចង់ឱ្យ យើង សំរបចូល គ្នា ទៅ វិញ ទៅមក ។
ពាក្យ ជូនពរ នេះ មិន ដឹង ថា អ្នកណា ជា អ្នក សរសេរ ទេ មើល ទៅ គួរឱ្យ ចាប់អារម្មណ៍ ទើប ដាក់ វា ។
៣៣ អ្នក នោះ នឹង ទទួល ទោស បាត់បង់ កិត្តិយស ហើយ ត្រូវ ខ្មាស គេ រហូត ៣៤ដ្បិត ប្តី គេ នឹង ប្រច័ណ្ឌ ហើយ ថ្ងៃ មួយ គេ នឹង សងសឹក ឥត ត្រា ប្រណី ឡើយ ។
លោក ម៉ូរី សុន បាន និយាយ ថា ការកើនឡើង នូវ ករណី ប្រចាំ ថ្ងៃ ក្នុង ប៉ុន្មាន ថ្ងៃ ថ្មី ៗ
ព្រះបន្ទូល របស់ ព្រះជាម្ចាស់ ព្រះជាម្ចាស់ គ្រប់គ្រង លើ វាសនា របស់ មនុស្សលោក ទាំងអស់
ទឹកមុខ របស់ ពួកគេ ពោរពេញ ទៅ ដោយ អំណរ
តែ បក្ស ប្រឆាំង នៅតែ ព្រួយបារម្ភ ។
នៅ ពេល ដែល ឌុច ទ្រហោ យំ សុំទោស ជនរងគ្រោះ ជា ឆាក ល្ខន សោុទ្ធសាធ ។
ពួក មនុស្ស ឆ្លើយ ថា ក រុណា លោក ម៉ែ ម្ចាស់ យើង ចង់ឱ្យ ស្លាប់ ដែរ ។
គេ ថា ក្នុង ចំណោម យើង រាល់គ្នា អ្នក ដែល ល្អ ជាង គេ ត្រូវបាន គេ នឹក ចាំបាន ប្រហែល ១០០ ឆ្នាំ តែ បុណ្នឹង ឯង ។
ទំនៀមទម្លាប់ និង វប៌្បធម របស់ អង្គរ នៅ រស់ ស្ទើរ គ្រប់ ទីកន្លែង ។
បន្ថែម យោបល់ របស់ អ្នក យោបល់ អាន ៖
អង្គការ សហ ប្រជាជាតិ ស្អី អង្គការ ហ្នឹង ហ៊ាន ជាមួយ សម្តេច នាយក អី ជាមួយ អ្នកណា មិន ដឹង ទេ តែ បើ ជាមួយនិង សម្តេច គាត់ ខ្ញុំ ខ្លាច តា យួន ទេ ទាន រឿង ស្រុក ខ្មែរ ៗ
ចោម ថៃ បាន និយាយ ថា ថ្ងៃ កើត ហេតុ ខ្ញុំ ដេក ក្នុង អង្រឹង ក្បែរ កាសាក់ ។
តើ សេចក្តីប្រចណ្ឌ នៃ ទ្រង់ នឹង ឆេះ ដូចជា ភ្លើង ឬ
លោក ស៊ី បាន និយាយ ថា ការផ្ទុះ ថ្មី ៗ
គ្នា ដើម្បី ធានា ថា ទទួលបាន នូវ សុខុមាលភាព ដ៏ ល្អ ប្រសើរ នោះ ។
ហើយ យើង នឹង បន្ត គាំទ្រ ពួកគេ មិន មែន តែ តាម ពាក្យពេចន៍ ប៉ុណ្ណោះ ទេ នៅ ពេល ដែល ពួកគេ ធ្វើឱ្យ មាន ការផ្លាស់ប្តូរ នៅក្នុង ប្រទេស របស់ ពួកគេ ។
ព្រះអង្គ ទ្រង់ ត្រាស់ ថា ម្នាល ភិក្ខុ ទាំងឡាយ បុរស សោះ សូន្យ នោះ ទោះបី ដឹង សេចក្តីសុខ ទុក្ខ ក្តី មិន ដឹង ក្តី ក៏ ត្រូវ អាបត្តិ បារាជិក ហើយ ។
ព្រះអង្គ បាន ព្យាយាម សិក្សា កាន់តែ ខ្លាំង ។
៧បន្ទាប់មក ទៀត ព្រះអង្គ បាន បង្ហាញ ខ្លួន អោយ លោក យ៉ា កុប ឃើញ រួច អោយ សាវ័ក ទាំងអស់ ឃើញ ។
ដែល មនុស្ស ម្នាយល់ឃើញ ពិតប្រាកដ ។
បើ និយាយ តាម សាសនា អ្នក ដែល ធ្វើ អាក្រក់ ទទួលបាន ផល អាក្រក់ ។
លោក បាន លើកឡើង ថា គេ ដឹង ថា អ្នកណា ដែល ជួយ ឱ្យ គណបក្ស សង្គ្រោះ ជាតិ បាន កម្លាំង ខ្លាំង ដល់ សព្វ ថ្ងៃ នេះ ទាំង ស្មារតី ទាំង ថវិកា ។
ដូច្នេះ ចូរ ធ្វើ លំហាត់ប្រាណ ងាយ ៗ
ចេញ ហើយ ដេញ តាម សេចក្តីសុចរិត សេចក្តីជំនឿ សេចក្តីស្រឡាញ់ និង សេចក្តីមេត្រី ជាមួយនឹង អ្នកអស់ អ្នក ដែល អំពាវនាវ ដល់ ព្រះអម្ចាស់ អំពី ចិត្ត ដ៏ បរិសុទ្ធ វិញ
ផ្ទុយទៅវិញ បើ គេ មិន សម នឹង ទទួល ទេ សេចក្តីសុខសាន្ត របស់ អ្នក រាល់គ្នា នឹង វិល មក រក អ្នក រាល់គ្នា វិញ ។
មាន មនុស្ស មួយ ម៉ឺន នាក់ សំរេចចិត្ត ទៅ ជាមួយ លោក ហើយ លោកស្រី ដេបូរ៉ា ក៏ ទៅ ជាមួយ ដែរ ។
ជាក់ស្តែង រាល់ ថ្ងៃ មាន បាន ដោះស្រាយ អី ។
និង ផ្តល់ឱ្យ ពួកគេ នូវ អ្វី ដែល ត្រូវ ពង្រីក ការគិត និង ការចង់ ដឹង ចង់ ឃើញ របស់ ពួកគេ ផងដែរ ។
ដូចជា ត្រូវ អំពើ គេ ខុស កុង ម៉ាខ្មោច អាបធ្មប់ ធ្វើជាដើម ។
ព្រះជាម្ចាស់ នឹង ឱ្យ គ្រប់ គ្នា ឃើញ នូវ ថ្ងៃ ដែល ទ្រង់ យាង មក
ហើយ អ្នក អាច ប្រើ ទឹក អប់ ដែល មាន ក្លិន រាង ប្លែក បន្តិច នៅ ថ្ងៃ ដែល មាន អាកាសធាតុ ត្រជាក់ ។
ហើយ បច្ចុប្បន្ន មនុស្ស ទាំង៧ នាក់ ខាងលើ ត្រូវបាន កម្លាំង អាវុធហត្ថ ធ្វើ កិច្ចសន្យា អប់រំ ណែនាំ ដល់ អ្នក ទាំង ៧នាក់ រួច អនុញ្ញាតិ ឱ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ ជាធម្មតា ៕
ហើយ គ្មាន អ្វី ប្លែក ទេ នៅក្នុង ពិភពលោក និង ក្នុង ប្រវត្តិសាស្ត្រ គឺ ប្រព័ន្ធ គ្រប់គ្រង បែបផែន ដូច្នេះ អ្នកដឹកនាំ មាន របៀប ដឹកនាំ ដូច្នេះ កម្រ ចុះ ចេញ ណាស់ ។
នេះ បើ ផ្អែក តាម សម្តី របស់ អ្នកដឹកនាំ សម្តែង ម្នាក់ ។
អ្នកស្រុក នោះ នឹង យក ពូជពង្ស របស់ អ្នក ធ្វើជា ខ្ញុំ បំរើ ព្រមទាំង ធ្វើទុក្ខ ទោស គេ អស់ រយៈពេល បួន រយ ឆ្នាំ ។
ស្អាត ជាង នេះ កំប្លែង រឿង កំប្លែង ៖
នៅ ខាងក្រោម លោក អ្នក នឹង ឃើញ តារាង ដែល បង្ហាញ លម្អិត ពី សមាជិក គ្រួសារ ទាំងអស់ និង ទំនាក់ទំនង របស់ ពួកគេ ជាមួយនឹង មេ គ្រួសារ ។
ជួនកាល គាត់ តេមក សុំ ជួប យើង សម្រួល ជាមួយ គាត់ និយាយ ឱ្យ ចំ អ្នក តូច យើង បាន ត្រឹមតែ ថា សម្រួល ជា មនោសញ្ចេតនា វិញ យើង អ្នក តូច ប្រឆាំង ជាមួយ អ្នក ធំ ម៉េច កើត ។
ព្រះជា ម្ចាស់ ច្រើន តែ ជ្រើសរើស មនុស្ស ដែល មិន ស័ក្តិសម នឹង ឱ្យ ទ្រង់ ប្រើ ក៏ ដូចជា មនុស្ស កម្សោយ ព្រះអង្គ បាន ប្រើប្រាស់ ពួកគេ នៅក្នុង រឿង នៃ ការប្រោស លោះ របស់ ទ្រង់ ។
ម៉ូតូ និង ម៉ូតូ បុក គ្នា ស្លាប់ ២នាក់ របួស ធ្ងន់ ៣នាក់
ពេល ឃើញ ចំណុច ខ្លាំង និង ចំណុច ខ្សោយ កន្លែងណា គឺ យើង ចូលរួម ដោះស្រាយ ទាំងអស់ គ្នា ដើម្បី ប្រយោជន៍ ដល់ អ្នកប្រើប្រាស់ ។
ថ្ងៃ ផុត កំណត់ ទទួល ពាក្យ ចូលរៀន ៖
ដូច្នេះ ខ្ញុំ មិន ស្វែងរក ជំនួយ ច្រើន ពី ពួកគាត់ ទេ ។
វិធី នេះ ធានា ថា ទាំង នាង និង ស្វាមី ប្រាកដ ជា ទទួលបាន អារម្មណ៍ ស្រៀវ ស្រើប ដូចគ្នា មិន ខាន ។
វិមុត្តិ ជា បច្ច័យ ដល់ អាសវក្ខយ្យេ ញាណ ១១ ។
ទ្រង់ មាន ព្រះរាជ ឱង្ការ ថា បើ ដូច្នោះ ចូល អ្នកឯង នាំ សេនា ទាហាន ទៅជា ឆាប់ ។
គាត់ មានប្រសាសន៍ ថា គាត់ ធ្លាប់ ចម្អក ឱ្យ ព្រះតែ ទ្រង់ បាន កែប្រែ ជីវិត គាត់ ។
លោក បាន ប្តេជ្ញា ថា លោក នឹង បន្ត កាន់កាប់ អំណាច រហូតដល់ លោក មាន អាយុ ៩០ ឆ្នាំ ។
នៅ ចុងបញ្ចប់ មាន តែ ខ្ញុំ ប៉ុណ្ណោះ ៕
ខ្ញុំ ចាត់ទុក ខ្លួន ឯង ជា ជន កម្ពុជា ហើយ ខ្ញុំ រីករាយ ដែល បាន ក្លាយជា ជន កម្ពុជា មួយ រូប ៕
លោក បាន ប្រឆាំង នឹង ការពន្លូត កូន លើកលែងតែ ករណី ចាប់រំលោភ ។
យើង កំពុងតែ សង្ស័យ លើ គាត់ ថា ជា អ្នក នៅ ពីក្រោយ ខ្នង ក្រុម អ្នកតវ៉ា ប្រឆាំង ទាំងនោះ ៕
ដឹក ឈើ តាម រថយន្ត យីឌុប ចំណុះ រាប់ សិប ម៉ែត្រ គូប តែងតែ គេច ផុត ពី ការបង្ក្រាប ។
ជាពិសេស គឺ គោរព សិទ្ធិ មនុស្ស ឱ្យ បាន ជាប់ លាប់ ជៀសវាង មាន តែ ច្បាប់ ប៉ុន្តែ អត់ មាន អ្នក គោរព ។
ធ្វើអោយ គេ ស្ថិត ក្នុង ទំលាប់ ធម្មតា របស់ ពួកគេ វិញ ។
បត់ ម៉ូតូ មិន មើល មុខ ក្រោយ រថយន្ត បុក បាក់ ភ្លៅ ទាំង ពីរ នាក់
ការណ៍ នេះ នឹង ជួយ ពួកគេ ក្នុង ការសាងសង់ គម្រោង ធំ ៗ
ខ្ញុំ មិន ចង់ឱ្យ អ្នកណា ឃើញ មុខ របស់ ខ្ញុំ ទេ ។
ពួកគេ បាន ប្រើ ពាក្យ សម្តី ខ្លាំង ៗ
ក្រោយមក វា នឹង បង្ក ជា ផលវិបាក ជាការរបក ស្បែក ទៀត ។
គ្មាន អ្នកណា គេ សម្បូរ លុយ យកមក ឱ្យ យើង ស្រួល ៗ
លោក ទទួលបាន ការឆ្លើយតប ថា ថ្នាក់ លើ ជា អ្នកសម្រេច ។
ហើយ គណបក្ស កាន់អំណាច គេ ចង់ ធ្វើ ម៉េច ស្រេច គេ ធ្វើ ទៅ ។
បើ យើង ពិតជា ស្មោះត្រង់ មែន នោះ យើង ប្រហែលជា និយាយ ថា ខ្ញុំ មិន អាច រស់ នៅ ដោយ មិន ប្រព្រឹត្ត អំពើ បាប សូម្បីតែ មួយ ថ្ងៃ ។
៩ទុក្ខលំបាក ការតប់ប្រមល់ អន្ទះអន្ទែង នឹង កើតមាន ដល់ អស់ អ្នក ដែល ប្រព្រឹត្ត អំពើ អាក្រក់ ជា មិន ខាន គឺ មុនដំបូង ដល់ សាសន៍ យូដាបន្ទាប់មក សាសន៍ ក្រិក !
ខ្ញុំ មិន ចង់ ធ្វើ អ្វី ច្រើន ទេ គឺ គ្រាន់តែ ចង់ អង្គុយ ចុះ ប៉ុណ្ណោះ ។
ខ្លឹមសារ លម្អិត នៃ ផែនការ នេះ នឹង ត្រូវ អឺរ៉ុប លើក យក ទៅ ជជែកគ្នា នៅ ពេល ក្រោយ ។
របស់ ពួកគេ ឱ្យ កាន់តែ ល្អ និង ទាក់ទាញ ។
ទំនិញ របស់ ពួកគេ នឹង ត្រូវ ពិនិត្យ ឆែកឆេរ ដូច អ្នក ធ្វើដំណើរ ផ្សេង ទៀត នៅ ចំណត យន្តហោះ ៕
ពត៌មាន ប្រចាំ ថ្ងៃ ជាធម្មតា មាន ផ្ទៃពោះ ប៉ុន្មាន ថ្ងៃ ទើប អ្នក ដឹង ?
ដូច្នេះ សូម បង អញ្ជើញ ទៅ ជាមួយ ពួកយើង ទៅ ពួកយើង នឹង ផ្តល់អោយ បង មាន សុភមង្គល ដែល ព្រះអម្ចាស់ បាន សន្យា ប្រទាន អោយ ជនជាតិ អ៊ីស្រាអែល ។
ឱ្យ លោកឪពុក និង អ្នកបង ក្រាប ទូលការណ៍ នោះ ថា ជិត បាន សម្រេច ហើយ ខ្ញុំ នឹង លើក ទៅ ឆាប់ ហើយ ឱ្យ ទ្រង់ ទុក ព្រះរាជ ហឫទ័យ ចុះ ។
ជាមួយគ្នា នេះ ពួកគេ បាន បាញ់ កងទ័ព របស់ យើង ឱ្យ របួស ២នាក់ និង ចាប់ខ្លួន ២នាក់ ផ្សេង ទៀត យក ទៅ ផងដែរ ។
យា ចីធ ភរិយា វធ កាតិវុច្ចតិ, ចោរីតិ អយ្យា តិច យាប វុច្ច តិ
៧កាល ទេវតា ដែល បាន និយាយ ជាមួយ គាត់ ចេញ ផុត ទៅ លោក កូនេលាស ក៏ ហៅ អ្នកបំរើ ពីរ នាក់ និង ទាហាន ម្នាក់ ដែល នៅក្រោម បញ្ជា របស់ គាត់ ជា យូរ ហើយ ហើយ គោរព ប្រណិប័តន៍ ព្រះជាម្ចាស់ ផង នោះ អោយ ចូលមក ។
លោក ក៏ បាន និយាយ ដែរ ថា ថ្វីបើ លោក សរសើរ ព្រះតេជគុណ ពូនវ៉ាន់ អាត ក៏ដោយ ក៏ មន្ទីរ របស់ លោក មិន មាន បំណង ធ្វើ បង្ហើយ ផ្លូវ នេះ ទេ ។
ឬ ការចែក អាហារ ថ្ងៃត្រង់ ដល់ ក្មេង នៅ សាលារៀន ជាដើម ។
សុច្ចរិត ទៀង ត្រង់ ប្រៀប ជាមួយ ការឆ្លាតវៃ វា កាន់តែ លំបាក ជាង ទៀត !
នោះ គឺជា គោលដៅ របស់ ខ្ញុំ ប៉ុន្តែ ខ្ញុំ មិន អាច ធ្វើ វា តែ ម្នាក់ឯង ទេ ។
ជន៍ ផ្ទាល់ខ្លួន មាន បុណ្យ សក្តិ ទ្រព្យសម្បត្តិ ប្រពន្ធ កូន ជាដើម ។
អត្ថប្រយោជន៍ គឺ ស្តែង ឱ្យ ឃើញ ច្បាស់ ណាស់ ។
ក្រោយពី ធ្វើ ការអង្កេត និង តាមដាន ពួកគេ នឹង ចាប់ផ្តើម ព្រួយបារម្ភ ហើយ ក្រោយមក ពួកគេ នឹង ត្រូវបាន លើកទឹកចិត្ត ចូលរួម ជាមួយ កិច្ចការ ដែល យើង កំពុង ធ្វើ ។
ខ្ញុំ ដោះស្រាយ រឿង ពួកគេ ហើយ ណែនាំ ពួកគេ អោយ ស្គាល់ ច្បាប់ និង ក្រឹត្យ វិន័យ របស់ ព្រះជាម្ចាស់ ។
៣៤ បងប្អូន ជ្រាប ស្រាប់ ហើយ ថា ខ្ញុំ បាន ធ្វើ ការ ដោយ ផ្ទាល់ ដៃ ដើម្បី ផ្គត់ផ្គង់ សេចក្តីត្រូវការ របស់ ខ្ញុំ និង សេចក្តីត្រូវការ របស់ អស់ អ្នក ដែល នៅ ជាមួយ ខ្ញុំ ។
ដែល មាន ទ្រព្យសម្បត្តិ ស្តុកស្តម្ភ ជាង គេ លើ លោក ។
បាន ឡើយ ប៉ុន្តែ គេ ស្អប់ បង ព្រោះ បង បាន បញ្ជាក់ ប្រាប់ ថា អំពើ ដែល គេ ប្រព្រឹត្ត សុទ្ធតែ អាក្រក់ ។
ដែល គ្រួសារ សព អ៊ិត សេដ្ឋា ទទួលបាន គិត ត្រឹម ថ្ងៃ នេះ
ទំព័រ ដូចតទៅ នេះ តភ្ជាប់ មក បរ មាថ៌ ៖
ព្យាយាម យល់ ចិត្ត គេ ឱ្យ បាន ច្រើន ៗ
នេះ គឺជា រឿង ថ្មី បំផុត សម្រាប់ ខ្ញុំ ប៉ុន្តែ ខ្ញុំ ត្រូវតែ និយាយ ថា វា គឺជា គំនិត ដ៏ ល្អ មួយ ពី រដ្ឋាភិបាល ។
ទាំងអស់ ដែល យើងខ្ញុំ មាន សុទ្ធតែ ជា កម្មសិទ្ធិ របស់ ព្រះអង្គ ដែរ ហើយ អ្វី ៗ
នោះ ពួកគេ មុខ ជាពិចារណា ហើយ យល់ ថា
យើង ជឿ ថា ព្រះទ្រង់ រាប់ ជា សុចរិត ហើយ ញែក ជា បរិសុទ្ធ ដល់ អស់ អ្នកណា ដែល មាន ជំនឿ លើ ព្រះយេស៊ូវ ដោយសារ ព្រះគុណ ទ្រង់ ហើយក៏ ជឿ ថា នៅ ថ្ងៃ មួយ ទ្រង់ នឹង ប្រទាន សិរី ល្អ ដល់ គេ គឺ គ្រប់ ទាំងអស់ សម្រាប់ ជា ការសរសើរ ដល់ ព្រះគុណ ដ៏ មាន សិរី ល្អ នៃ ទ្រង់ ។
ដែល ព្រះអង្គ សំដែង ដើម្បី អោយ យើង ប្រតិបត្តិ តាម សេចក្តី ទាំង ប៉ុន្មាន ដែល មាន ចែង ទុក ក្នុង គម្ពីរ នៃ ក្រឹត្យ វិន័យ នេះ ។
ដ្បិត ទ្រព្យសម្បត្តិ របស់ ក្រុង នេះ
ដើម្បីឱ្យ ពលរដ្ឋ វិនិច្ឆ័យ និង សម្រេច ។
ពួកគេ នឹង សង់ ក្រុង ទាំង ប៉ុន្មាន ដែល ខូចខាត
ចូរ និយាយ ជាមួយ ព្រះជា ម្ចាស់ នៅក្នុង ការបួងសួង អោយ បានជាប្រចាំ ហើយ ព្រះជាម្ចាស់ នឹង និយាយ ជាមួយ អ្នក ។
យ៉ាង នេះ ក្តី បច្ចុប្បន្ន គេ ដឹង ថា វិស្វករ បរទេស ដែល ចូលមក ធ្វើការ ក្នុង គម្រោង ធំ ៗ
គាត់ ក៏ បាន ដឹកនាំ ពួកគេ ដោយ សេចក្តីជំនឿ ឆ្ពោះ ទៅរក ជ័យជម្នះ ដ៏ អស្ចារ្យ ។
ដូចនេះ យើង សុទ្ធតែ ថ្វាយ សិរី ល្អ ដល់ ព្រះ។
ឥឡូវនេះ សូម មេត្តា រំដោះ យើងខ្ញុំ អោយ រួចផុត ពី កណ្តាប់ដៃ របស់ ខ្មាំង សត្រូវ ផង យើងខ្ញុំ នឹង គោរព បំរើ ព្រះអង្គ វិញ ។
ទាំងអស់ ស្ថិត ក្នុង បរិការណ៍ ថវិកា ។
បាញ់ សម្លាប់ គេ ពី យប់ រសៀល ចាប់ បាន
កំណែ ប្រែ ថ្មី នេះ អនុញ្ញាតឱ្យ អ្នកប្រើប្រាស់ ទាំងអស់ ចូល ទៅកាន់ គណនី របស់ ពួកគេ ដើម្បី កែប្រែ ប្រវត្តិ រូប follow មិត្តភ័ក្តិ ថ្មី ៗ
នៅ ពេលណា ស្លៀក សំលៀកបំពាក់ ស្អាត ៗ
ការសុំ ចូលរួម ជីវភាព នយោបាយ របស់ គណបក្ស សង្គ្រោះ ជាតិ នេះ ផងដែរ បន្ទាប់ពី អស់ ជំនឿ ទៅ លើ ការស្តារ នយោបាយ គណបក្ស របស់ ខ្លួន ឡើងវិញ ។
ហើយក៏ អត់ មាន រឿង អ្វី កើតឡើង ជាមួយ ខ្ញុំ ដែរ ។
នៅ ពេល ដែល មនុស្ស កាន់តែ មាន ជីវភាព ធូរធា ពួកគេ បាន កាន់តែ មាន ការយកចិត្តទុកដាក់ សុខភាព របស់ ពួកគេ ។
ប្រសិនបើ អ្នក ធ្វើ មិន បាន ទេ សំបុក អាយ ធី នឹង សរសេរ បកស្រាយ បង្ហាញ ជូន ។
លោក ពិន ប៊ុណ្ណា រិទ្ធិ១ លាន រៀល
តែ ព្រះយេស៊ូវ បាន មានបន្ទូល ថា ទ្រង់ ជា ព្រះដ៏ ពិត ។
