បល្ល័ង្ក របស់ ព្រះជាម្ចាស់ និង បល្ល័ង្ក របស់ កូន ចៀម ស្ថិត នៅក្នុង ក្រុង នោះ ហើយ ពួក អ្នក បំរើ របស់ ព្រះអង្គ នាំគ្នា គោរព ថ្វាយបង្គំ ព្រះអង្គ ៤គេ នឹង ឃើញ ព្រះភក្ត្រ ព្រះអង្គ ហើយ នៅលើ ថ្ងាស គេ ក៏ មាន ដៅ ព្រះនាម ព្រះអង្គ ដែរ ។
វា និយាយ អំពី ប្រជាប្រិយភាព… នៅ ពេល នោះ ។
ផ្ទុយទៅវិញ ប្រាជ្ញា នៅ ជាប់ នឹង អ្នក ដែល ទទួល ការអប់រំ បាន ល្អ គឺ អ្នក ដែល បាន ស្តាប់ និង រៀនសូត្រ ដោយ បើកចិត្ត និង បន្ទាប ខ្លួន ទទួល ការបង្រៀន ។
ចំណែក ជ្រូក នោះ វិញ មុននឹង ធ្វើ
ផ្ទុយទៅវិញ អ្វី ដែល លោក បាន ផ្តល់ឱ្យ ពួកគេ គឺ ការដឹកនាំ បែប ស្តាលីន ។
ប្រហែលជា មាន ហេតុផល ដែល បណ្តាលឱ្យ លោក អ្នក មានអារម្មណ៍ ថា បាន លែងលះ គ្នា មែន ។
ថា ព្រះទ្រង់ នឹង មិន ធ្វើ ទោស ទេ
ឬ កែ គំនិត មារយាទ និង ស្មារតី មនុស្ស ពី អាក្រក់ ថោក ទាប ឱ្យ បាន មក ជា ល្អ ខ្ពង់ខ្ពស់ បាន
សុំ ប្អូន យក ភាព ជាក់លាក់ មក បង្ហាញ មក បើ មិន មាន ទេ ប្អូន នឹង ទទួលខុសត្រូវ លើ អ្វី ដែល ប្អូន និយាយ ។
ជំនាន់ ក្រោយ នៅ ស្រុក អាមេរិក កុំ ភ្លេច ប្រពៃណី វប៌្បធមជាតិ របស់ ខ្លួន ។
ខណៈ អ្នកផង ទាំងពួង ភ័យ តក់ស្លុត បន់ ដូនតា រៀង ៗ
គឺ ថ្ងៃ ដែល ពួកយើង បាន ចាប់កំណើត និង មួយ ទៀត គឺជា ថ្ងៃ ដែល ពួកយើង បាន រកឃើញ អំពី មូលហេតុ ថា ហេតុ អ្វី ។
មួយចំនួន របស់ លោកស្រី ប្រព្រឹត្ត តាម សេចក្តីពិត ស្រប តាម បញ្ញត្តិ ដែល យើង បាន ទទួល ពី ព្រះវរ បិតាមក ។
ហើយ កម្លាំង របស់ គេ ក៏ ធ្លាក់ ទន់ខ្សោយ ដែរ
លោក និយាយ ថា ការស្វែងរក គំរូ ថ្មី មួយ នៅ ទីនេះ អាច ក្លាយទៅជា គំរូ សម្រាប់ ប្រទេស ចិន ទាំងមូល នា ពេល អនាគត ។
ជាង ១០០ ឆ្នាំ ក្រោយមក ខ្មោច របស់ ពួកគេ ត្រូវបាន គេ និយាយ ថា នៅតែ វិលវល់ ក្នុង ផ្ទះ ដោយ ប្រាថ្នា ចង់បាន យុត្តិធម៌ ។
អាយុ របស់ មនុស្ស ទាំងឡាយ វែង សប្បុរស មិន គួរ ខ្ពើម ឆ្អើម អាយុ នោះ ឡើយ បុគ្គល គប្បី ប្រព្រឹត្ត ខ្លួន ឱ្យ ដូចជា កូនក្មេង ស្រវឹង ទឹកដោះ ព្រោះថា ដំណើរ មក នៃ មច្ចុ មិន មាន ទេ ។
មនុស្ស ភាគ ច្រើន នឹង នៅតែ រក្សា ជំនឿ របស់ ពួកគេ រហូតដល់ ពេល ដែល មាន អ្វី មួយ ដ៏ ពិសេស បង្ខំ គេ អោយ ផ្លាស់ប្តូរ គំនិត ទាំងនោះ ។
ព្រះអង្គ ទ្រង់ ត្រាស់ សរុប ថា ម្នាល ភិក្ខុ ទាំងឡាយ ភិក្ខុ ពិចារណា ឃើញ កាយ ក្នុង កាយ យ៉ាង នេះ ឯង ។
ចូរ មក ឯ ខ្ញុំ ចុះ ខ្ញុំ នឹង ឱ្យ អ្នក រាល់គ្នា សម្រាក
ថ្វីបើ បុរស ជាច្រើន កំពុងតែ ប្រើ វា រយៈពេល ច្រើន ឆ្នាំ ក៏ដោយ ក៏ ពួកគេ នឹង តែ មិន ទាន់ ដឹង អំពី តាក តិច ប្រើប្រាស់ អោយ បាន ត្រឹមត្រូវ ល្អ ដែរ ។
ខ្ញុំ ខ្លួន ឯង មាន តែ បទចម្រៀង មួយចំនួន ប៉ុន្តែ អ្នក ផ្សេង ទៀត ត្រូវបាន ប្រើប្រាស់ វា ផងដែរ ជាមួយនឹង ជាច្រើន នៃ បទចម្រៀង និង វិធី ទាំង យើង ទាំងអស់ គ្នា ស្រឡាញ់ វា ។
១៣ហេតុ នេះ ប្រសិនបើ ចំណីអាហារ ណាមួយ ធ្វើអោយ បងប្អូន របស់ ខ្ញុំ ធ្លាក់ ក្នុង អំពើ បាប ខ្ញុំ នឹង មិន បរិភោគ សាច់ ទៀត ជាដាច់ខាត ដើម្បី កុំ អោយ បងប្អូន ខ្ញុំ រ វាត ចិត្ត បាត់ ជំនឿ ។
ដើម្បីឱ្យ ទំនាក់ទំនង អ្នក ល្អ និង មិត្ត ដ៏ ប្រសើរ មាន ៩ចំនុច ៖
ឱ ព្រះនៃ ទូលបង្គំ អើយ សូម ស្រោចស្រង់ ទូលបង្គំ ឱ្យ រួច ពី កណ្តាប់ដៃ នៃ មនុស្ស អាក្រក់ គឺ ឱ្យ ចេញ រួច ពី កណ្តាប់ដៃ នៃ មនុស្ស ទុច្ចរិត ដ៏ សាហាវ ផង
នៅពេល មាន រឿង គួរឱ្យ ខ្លោចផ្សា កើតឡើង សាសនា ប្រាប់ ថា នេះ ជា ព្រះហឫទ័យ របស់ ព្រះ។
ប៉ុន្តែ គេ ធ្វើ អំពី ស៊ីម៉ង់ត៍ អំពី ឥដ្ឋ ប៉ុន្តែ គេ រក្សា ម៉ូដ គេ សំគាល់ ចូលក្នុង ភូមិ ហ្នឹង ជា ភូមិ ជនជាតិ ដើម មួយ ដែល ថែរក្សា ។
៨ ដូច្នេះ យើង ចុះ មក ដើម្បី រំដោះ ពួកគេ អោយ រួច ពី កណ្តាប់ដៃ របស់ ជនជាតិ អេស៊ីប ។
វា ដូចជា មាន តម្លៃ ថ្លៃ បន្តិច ហើយ សម្រាប់ សិស្ស ដូចជា រូប ខ្ញុំ ។
គាត់ មិន បាន និយាយ អំពី ខ្លួន គាត់ ទេ តែ គាត់ បាន មក សម្រាប់ ជា ទីបន្ទាល់ ដើម្បី នឹង ធ្វើ បន្ទាល់ ពី ពន្លឺ ប្រយោជន៍ ឱ្យ មនុស្ស ទាំងអស់ បាន ជឿ ដោយសារ គាត់ ១៧ ។
ដើម្បី បាន នូវ ទ្រព្យសម្បត្តិ ឬ មាស ប្រាក់ ឧបករណ៍ ប្រើប្រាស់ ក្នុង ជីវិត ប្រចាំ ថ្ងៃ គេ ត្រូវ ធ្វើ ការនឿយហក់ ទាំង យប់ ថ្ងៃ ដោយ ច្រើន អន្លើ តែ ពេល ដែល បាន មក ហើយ បែរជា មិន ស្គាល់ តំលៃ របស់ វា ។
គ្រូបង្វឹក វ័យ ក្មេង រូប នេះ បាន និយាយ ថា អ្នក ទាំងអស់ គ្នា នឹង បាន ឃើញ ការផ្លាស់ប្តូរ ខ្លះ ៗ
ពេល មេស្តីបន្ទោស មាន ការឈឺចាប់ ។
ចំពោះ អ្នក វិញ ត្រូវ និយាយ តែ សេចក្តីណា ដែល ស្រប តាម សេចក្តីបង្រៀន ដ៏ ត្រឹមត្រូវ ។
ទាំងអស់ ដែល ព្រះអង្គ បាន បង្កើត មក
ស្រាប់តែ ពេលនេះ ខ្ញុំ នៅ ទីនេះ ពីព្រោះ ខ្ញុំ អាច ទទួលបាន ការ ជ្រកកោន ៕
លោក បាន ឱ្យដឹង បន្ថែម ថា ទំហំ ដី ដែល ដក យក មកវិញ នេះ នឹង ទុក ធ្វើជា ដី សម្បទាន សង្គមកិច្ច ។
១. កុំ គោរព អាទិទេព ទេវតា ឬ ឃុំ ខ្លួន ទៅនឹង គម្ពីរ ទ្រឹស្តី ឬ មនោគម វិជ្ជា សូម្បី ពុទ្ធ សាសនិក ។
៥ព្រះបន្ទូល ទាំង ប៉ុន្មាន របស់ ព្រះជាម្ចាស់ គួរអោយ ជឿ ទុកចិត្ត ព្រះអង្គ ជា ខែល ការពារ អស់ អ្នក ដែល មក ជ្រកកោន នឹង ព្រះអង្គ ។
បើ មិន ដូច្នេះ ទេ ត្រូវ សួរ អ្នកនាំពាក្យ ។
មក ដាក់ ខ្លួន ភាគ ច្រើន កើត លើ មនុស្ស ដែល មាន គតិ ពុំ សូវ ជា វិជ្ជមាន ពូកែ តូចចិត្ត ពូកែ ឈឺចាប់ ពូកែ មាន ខ្លួន និង ពូកែ ធ្វើចរិត ត ម្អូញ តម្អែរ ។
ព្រះអង្គ ជា អ្នក ឱ្យ ចម្រើន ឡើង ព្រះអង្គ ជា អ្នក មិន ធ្វើឱ្យ ចម្រើន ឡើង នៅ ពេល ដែល យើង មិន ស្តាប់ បង្គាប់ ព្រះអង្គ ។
១៦ នៅ ពេល នោះ ពួក សិស្ស ពុំ បាន យល់ ហេតុការណ៍ ទាំងនេះ ភ្លាម ៗ
និយាយ រួម ព្រះទ្រង់ បាន ប្រើ មនុស្ស និង ថ្នាំ ពេទ្យ ដើម្បី ព្យាបាល ជម្ងឺ ទាំងពួង ។
ព្រះយេស៊ូ មាន ព្រះបន្ទូល តប ថា ដឹង ច្បាស់ ថា ខ្ញុំ ប្រាប់ អ្នក ថា ប្រសិនបើ មនុស្ស មិន កើត ពី ទឹក និង ពី ព្រះវិញ្ញាណ ទេ គេ ពុំ អាច ចូលក្នុង ព្រះរាជ្យ ព្រះជាម្ចាស់ បាន ឡើយ ។
គួរ កត់សម្គាល់ មុន នេះ ៣ ថ្ងៃ ពោលគឺ នៅ ថ្ងៃពុធ ថ្នាក់ដឹកនាំ អតីត គណបក្ស សង្គ្រោះ ជាតិ ក៏ បាន ចេញមក បញ្ជាក់ ពី ជំហរ របស់ ខ្លួន ថា នៅតែ បន្ត រួបរួម គ្នា ដដែល ។
នៅ ប្រហែល៨ ខែមិន មាន កន្លែង ទំនេរ ច្រើន នៅក្នុង ស្បូន នោះ ទេ ។
គ្មាន នរណា ម្នាក់ ចង់ឱ្យ គេ មើល ទៅ ដូចជា មនុស្ស ល្ងង់ នោះ ទេ ។
ទាំងអស់ គ្នា កន្លែង នេះ ហើយ ដែល អាច រក ក្តីសុខ ឱ្យ ខ្លួន ឯង ៕
ម្តាយ និង គ្រូ របស់ នាង ភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង ដោយ ឃើញ អ្វី ដែល នាង បាន ធ្វើ ហើយ ពួកគេ បាន ប្រាប់ នាង ថា នាង ជា វិស្វករ តូច ម្នាក់ ។
តើ មែក ដែល កោង ចុះក្រោម ទាំងនោះ អាច ទ្រាំទ្រ យូរ ប៉ុណ្ណា ទំរាំ តែ វា បាក់ ដោយសារ ទម្ងន់ នៃ ព្រឹល ទឹកកក នោះ ?
ធ្វើ យ៉ាង ច្រើន ណាស់ បី រយ គុម្ព ប្រាំរយ គុម្ព ឬមួយ ពាន់ គុម្ព ទៅ មួយ ពាន់ ប្រាំរយ គុម្ព ទេ ដូច្នេះហើយ គេ ប្រើ តែ កម្លាំង គ្រួសារ របស់ គេ ក៏ ធ្វើ បាន ដែរ ហើយ បើ ដាំ ដល់ ថ្នាក់ ពីរ ពាន់ គុម្ព ទៅ ប្រាំ ពាន់ គុម្ព ឡើង ទៅ ហើយ គឺ ត្រូវ ប្រើ កម្លាំង ពលកម្ម ដែល ជួល មកពី ខាងក្រៅ ។
១ គ្មាន ពេលវេលា គ្រប់គ្រាន់ សម្រាប់ គ្រួសារ
យើង គិត ថា ក្នុង ជីវិត យើង ជៀស មិន ផុត ពី ការប៉ះទង្គិច ឡើយ ។
ប៉ុន្តែ បើ មាន កំហុស អ្វី កើតឡើង ពួកគេ នឹង ត្រូវ ទទួល ទណ្ឌកម្ម ជា មិន ខាន ។
ខ្ញុំ បាន មើលឃើញ ការរឹតបន្តឹង និង ការហាមឃាត់ ដូច នោះ នៅ គ្រប់ ទីកន្លែង ដែល ខ្ញុំ បាន ធ្វើ ការងារ នៅលើ ពិភពលោក ។
អ្នក ដែល សំអាត ខ្លួន ពី ប្រការ ស្ហ៊ីរិក ពិតជា ទទួលបាន ជោគជ័យ ។
៣៣ ដូច្នេះ កាលណា អ្នក រាល់គ្នា ឃើញ ព្រឹត្តិការណ៍ ទាំងអស់ នោះ កើតឡើង ត្រូវ ដឹង ថា បុត្រ មនុស្ស ក៏ ជិត មកដល់ ហើយ ដែរ គឺ លោក មក ជិត បង្កើយ ហើយ ។
នៅ ឆ្នាំ ២០០៧ មាន សម័យ ប្រជុំ តាមដាន ពិសេស មួយ ទៀត នៅ អង្គការ សហ ប្រជាជាតិ ដែល មាន ឈ្មោះ ថា ពិភពលោក ល្អ សម្រាប់ កុមារ ៥។
ទូទាំង ពិភពលោក លង់ ស្នេហ៍ ហើយ មាន វីដេអូ
កញ្ញា ស្តាប់ ពាក្យពេចន៍ ប្រុស ថ្លៃ ដោយ ត្រេកត្រអាល ។
ប៉ុន្តែ ខ្ញុំ យល់ ថា ព្រះទ្រង់ ប្រាកដជា សព្វ ព្រះទ័យ នឹង ស្តាប់ តែ ពាក្យ អ្វី ដែល ចេញពី ចិត្ត របស់ កូន ទ្រង់ ប៉ុណ្ណោះ ។
លោក បាន មានប្រសាសន៍ ថា យើង សោកស្តាយ ណាស់ ដែល របប យោធា ធ្វើ ភ្លាម ៗ
អ្នក យល់ ថា ខ្លួន បាន ទូល សូម តាម បំណង ព្រះហឫទ័យ ព្រះហើយ ។
ព្រះអង្គ បញ្ជាក់ ថា គ្រប់ អាហារ សុទ្ធតែ បរិសុទ្ធ ទាំងអស់ ។
គាត់ បាន ប្រាប់ គេ ថា ពេល នោះ គាត់ បាន អធិស្ឋាន ហើយ អធិស្ឋាន ទៀត ហើយ បាន សរសើរ ដំកើង ព្រះក្នុង ពេល ដែល គាត់ ជួប ការពិបាក ទាំងអស់ នោះ ។
ក្នុង ស្ថានភាព បែប នោះ ព្រះចៅ ក្រុង សៀម បញ្ជូន ទ័ព វាយលុក ក្នុង បំណង ឱ្យ ព្រះបាទ អង្គ ឌួង ជា ឪពុក មា អង្គ ម៉ីសោយរាជ្យ ។
ក៏ មិន បាន ដឹង ពី ប្រវត្តិ ច្បាស់ ដូចគ្នា ។
ខ្លះ របស់ បក្ស កាន់អំណាច ទៅ វិញ ទេ ដែល នឹង ត្រូវ ជួប បញ្ហា ៕
គម្ពីរ មិន សូវ រៀបរាប់ ច្រើន អំពី រឿង នោះ ទេ ។
១ ព្រះប្រាជ្ញា ញាណ ជា គម្ពីរ ដែល មាន ចែង ពី ព្រះបញ្ជា របស់ ព្រះជាម្ចាស់ ជាធម្មវិន័យ ដែល ស្ថិតស្ថេរ អស់កល្ប ជានិច្ច ។
ប៉ុន្តែ បន្ទាប់មកស្រី រូប នោះ មិន បាន ទៅ រក កូន របស់ ខ្លួន វិញ នោះ ឡើយ ។
របស់ លោកស្រី ចាកចេញ ពី ប្រទេស ។
មុនពេល គេ យក ទ្រង់ ទៅ ឆ្កាង ទ្រង់ បាន មានបន្ទូល ថា ទូលបង្គំ បាន បង្ហើយ ការ ដែល ទ្រង់ បាន ប្រគល់ មក ឱ្យ ធ្វើ យ៉ូហាន ១៧៤ ។
មក ឯ ទ្រង់ ដើម្បីឱ្យ ទ្រង់ ដាក់ ព្រះហស្ត អធិស្ឋាន ឱ្យ វា តែ ពួក សិស្ស បន្ទោស ដល់ គេ
ជារៀងរាល់ ឆ្នាំ ក្នុង ឱកាស បុណ្យ ចម្លង , លោក ទេសាភិបាល តែងតែ លែង អ្នកទោស ម្នាក់ តាម សំណូមពរ របស់ បណ្តា ជន ។
កន្លែង ល្អ បំផុត សម្រាប់ ព្រះបន្ទូល របស់ ទ្រង់ គឺ ស្ថិត នៅក្នុង ជម្រៅ ដួងចិត្ត របស់ យើង ។
ប៉ុន្តែ ពួកគេ ធ្វើឡើង ដោយ ផ្អែក ទៅ លើ មធ្យម ភាគ ប៉ុណ្ណោះ ។
អ្នក រាល់គ្នា បាន សែង ខ្ទម របស់ ព្រះម៉ូឡុក
មិន គោរព បន្ទួល របស់ ព្រះដែល ពួកគេ ត្រូវបាន កាត់ ចេញ ។
សូម កុំ សន្មត ថា គំនិត របស់ លោក អ្នក តែ ម្នាក់ឯង ចំពោះ ការស្វែងរក ស្វាមី ឬ ភរិយា មាន ភាព គ្រប់គ្រាន់ នោះ ឡើយ ។
រីឯ អ្នកបើក រថភ្លើង និង បុគ្គលិក ផ្សេង ទៀត នៅលើ រថភ្លើង នោះ ក៏ មិន មាន របួស អ្វី ដែរ ។
គ្រូពេទ្យ នឹង ជួយ អ្នក រកមើល ថា អ្វី ដែល ល្អ បំផុត សម្រាប់ អ្នក ។
យើង ក៏ តែងតែ ឮ គេ និយាយ ពី ចំណុច យុត្តិធម៌ ផងដែរ ។
ការ ពីមុន ពួកគេ ក៏ ធ្លាប់ ទៅ ដើរលេង នៅ សួន កម្សាន្ត តែ ពីរ នាក់ ផងដែរ ។
នៅពេល អ្នក បើក វា ឱ្យ ទូលាយ វា នឹង មាន ការប៉ះពាល់ ។
៨លោក ប៉ូល បាន ចូលទៅ សាលាប្រជុំ ហើយ មានប្រសាសន៍ ដោយ ចិត្ត អង់អាច ក្នុង អំឡុង ពេល បី ខែ ។
ប៉ុន្តែ ក្រសួង បរិស្ថាន បាន និយាយ ថា ប្រជាជន នៅក្នុង តំបន់ ក៏ មិន បាន ត្រៀម ខ្លួន ដូចគ្នា ៕
វា ធ្វើឱ្យ ប៉ះពាល់ ដល់ អនាគត កម្ពុជា ហើយ ពុំ អាច មាន ប្រទេស ផ្សេង ទៀត ប្រាប់ កម្ពុជា ថា ត្រូវ ធ្វើ ដូចម្តេច នោះ ទេ ។
ជាច្រើន ឆ្នាំ ក្រោយមក ខ្ញុំ បាន សួរ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន អំពី ការប៉ុនប៉ង ឆក់ យក ជីវិត របស់ លោក ។
គឺ ដោយសារ ពួកគេ មិន សម្លឹង ទៅ រក ព្រះ។
ពេល នោះ មាន់ ឆ្អិន ល្អ ហើយ ដាក់ ចាន ទទួលទាន ជា ការស្រេច ។
ហ្នឹង អា ហ្នឹង ត្រូវបាត់បង់ អាសនៈ ស្អី យ៉ាងម៉េច ៗ
