« យើងនឹងប្រមូលគ្រប់ទាំង សាសន៍ និងគ្រប់ភាសា ហើយគេនឹងមកមើលសិរីល្អរបស់យើង » ។
ប៉ុន្តែ ខ្ញុំ ពិតជា មាន ការទាយ មួយចំនួន ។
ប៉ុន្តែ អ្នក រាល់គ្នានឹងរីក រាយក្នុងព្រះ‌ អម្ចាស់ ។
អ្នកដើរលេងរបស់គាត់ដែលតាមរកគាត់ពេញមួយយប់ ។
ខ្ញុំ កំពុង អង្គុយ ផឹក ស្រា ។
វាដូចជាការ សម្រាលកូន » ។
អ្នក ណាត្រូវបានគេវាយ ប្រហារ » ។
> ចំណុច សំខាន់ មួយ របស់ ឡានីណា គឺ ខ្លាំង
ហើយគាត់និយាយថា “ គ្មានស្នាមអ្វីទេ ” ។
វា គ្មាន អ្វី សម្រាប់ យើង ក្នុង ការដាក់ ឈ្មោះ របស់ យើង នៅ ពីក្រោយ គាត់ នោះ ទេ ។
អ្នកមិនអាចដាក់អ្នក ជឿទាំងអស់នៅក្នុងជំរំ មួយ ហើយនិយាយថា " អ្នក រាល់គ្នាកំពុងជឿលើព្រះក្លែងក្លាយ " ។
ការពិត ដែល ព្រះយេស៊ូវ ដេក លក់ ។
ចូរប្រគល់ខ្លួនឲ្យបានពេញ លេញក្នុង កិច្ចការ នៃព្រះ‌ អម្ចាស់ ពីព្រោះអ្នកដឹងថា ការងាររបស់អ្នកក្នុងព្រះ‌ អម្ចាស់មិនឥតប្រយោជន៍ទេ » ។
មាន នៅក្នុង៖ ពណ៌ ស ។
ព្រោះ នាង នៅ មាន ជីវិត ព្រោះ នាង ជា ស្នេហា
តាមដីការបស់តុលាការ គឺថ្ងៃទី ២ នៃថ្ងៃទី ២.
ខ្ញុំ មាន ចំណាប់អារម្មណ៍ លើ ទីផ្សារ ឌីជីថល ។
ខ្ញុំ ឃើញ នាង ស្រក់ ទឹកភ្នែក ។
វា ជា ឧបករណ៍ អភិវឌ្ឍន៍ ។
គ្មានអ្នក ណាហ៊ានទារលុយប៉ូលទេ ។
ចូរអនុវត្តនូវអ្វីដែលអ្នក អធិប្បាយ ... បោះឆ្នោតដោយ ចិត្តរបស់អ្នក » ។
ហើយ ស្រុក មិន ត្រឹមតែ មាន នៅ កម្រិត មួយ ប៉ុណ្ណោះ ទេ ។
តើអ្នកត្រៀមខ្លួនជា ស្រេចសម្រាប់ការ ប្រកួតដ៏ មហិមា ឬហ៊ាន ?
ប៉ុន្តែ មិន មែន មុនពេល ភាពងាយ រងគ្រោះ នៃ ហេដ្ឋារចនាសម្ព័ន្ធ របស់ អាមេរិក ត្រូវបាន គេ ដាក់ទទេ នោះ ទេ ។
ហ្គេម អ៊ីន ឌី កំពុង រុញ ផ្លូវ របស់ ពួកគេ ចូល ទៅក្នុង ផ្ទះ របស់ យើង កាន់តែ ច្រើន ឡើង ។
វា អនុញ្ញាតឱ្យ អ្នក រក ប្រាក់ ចំណូល ។
ទេ សម្រាប់ វគ្គ សិក្សា ទាំងមូល ។
1 នៅក្រុងអ៊ីកូនាម ពួកគេបានចូលទៅក្នុងសាលា ប្រជុំរបស់ សាសន៍យូដាជាមួយគ្នា ហើយបាននិយាយដូច្នេះថា ទាំង សាសន៍យូដា និង សាសន៍ក្រិកមួយចំនួនធំបានជឿ ។
តើអ្នក ណានឹងជឿ ហើយអ្នក ណាមិនជឿ ?
វាអាចជាមួយក្នុងចំណោមទាំងនេះ ឬប្រហែលជាមួយក្នុងចំណោមទាំងនេះ មានជម្រើស ជាច្រើនទៀតដែលអាចធ្វើទៅបាន។
នឹង ចូល ទៅក្នុង ព្រះរាជាណាចក្រ របស់ ព្រះ។
“ ដូច្នេះ ប៉ារីស គឺជា ប្អូន ស្រី បន្ទាប់ របស់ ខ្ញុំ នាង ធ្វើការ នៅក្នុង ផ្នែក នៃ សកម្មភាព លេប ដាវ ។
១៥ ដូច្នេះ ពួកគេនៅចំពោះមុខបល្ល័ង្ករបស់ព្រះ ហើយបម្រើទ្រង់ទាំងយប់ទាំងថ្ងៃក្នុងព្រះវិហាររបស់ទ្រង់ ។
ប៉ុន្តែប្រសិនបើនោះជាការ ពិត នាងនឹង បង្ខំគាត់ ។
សម្រាប់ មនុស្ស ជាច្រើន នៅ អ៊ុយក្រែន ជីវិត នៅតែ អាក្រក់ ខ្លាំង ណាស់ ។
ទុកឲ្យខ្ញុំផាត់មុខឲ្យស្អាត ។
ប៉ូលីស និង ទាហាន បាន នៅ តាម ដងផ្លូវ នៃ ទីក្រុង Harare ពេញ មួយ យប់ ប៉ុន្តែ មិន មាន ការរាយការណ៍ ពី ការតវ៉ា និង ការប្រារព្ធ ពិធី ជាសាធារណៈ មួយចំនួន នៅ ពេល ដែល លទ្ធផល ត្រូវបាន ប្រកាស បន្ទាប់ពី ពាក់កណ្តាល អធ្រាត្រ ។
ការងារគ្រោងនឹងចាប់ផ្ដើមនៅខែ មីនា ឆ្នាំ ២០១៨ ប្រហែល ១២ ខែ ។
ឆន្ទៈរបស់អ្នកក្នុងការ ធ្វើតាមព្រះហឫទ័យរបស់ព្រះ ត្រូវបានបង្ហាញដោយការ ពិតថាអ្នកកំពុងព្យាយាមជៀសវាងការ ប្រព្រឹត្តអំពើ បាបថ្មី ។
ហើយខ្ញុំបាន សន្យានឹងអ្នកថាយើងនឹងយកវាទៅធ្វើការ ដូច្នេះ :
គុណវិប ត្តិ៖ ទិដ្ឋភាព នៃ អគារ ចំណត រថយន្ត ។
អ្វីដែលពិតជាការ ពិតតាំងពីមុនសួនច្បារ ។
ត្រូវបាន ទទួលរង នូវ ស្ថានភាព ដូចគ្នា ។
ទម្លាយលិខិតមួយច្បាប់ដែលគាត់នឹងលាតត្រដាង !
2 ជីកាបៃ ក្នុង មួយ ខែ គឺ មិន សូម្បីតែ ជិត គ្រប់គ្រាន់ ដើម្បី ធ្វើ វា ដោយ យុត្តិធម៌ ។
28 ហើយការ បំផ្លិចបំផ្លាញនៃពួករំលង និងមនុស្សមាន បាបនឹងនៅ ជាមួយគ្នា ហើយអស់អ្នកដែលបោះបង់ចោលព្រះ‌ យេហូវ៉ានឹងត្រូវវិនាស ។
39 ពេលមនុស្សទាំងអស់ឃើញដូច្នេះ គេក៏ក្រាបមុខភ្លាម ថា៖ « ព្រះ យេហូវ៉ាជាព្រះ ពិត !
បើ គុណភាព មិន ពិបាក ពេក មិន ត្រឹមតែ ប្រជាពលរដ្ឋ មិន ពេញចិត្ត ប៉ុណ្ណោះ ទេ ការគ្រប់គ្រង និង ថែទាំ ភ្លើង តាម ដងផ្លូវ ក៏ ជា កិច្ចការ ធំ ផងដែរ ។
ហួស ពីការ ជឿថា ឪពុកអាចធ្វើបែបនេះលើកូនស្រីរបស់ខ្លួនបាន ។
នេះ គឺជា កន្លែង ដែល យើង ឃើញ វត្ថុ ដោយ ភ្នែក
សំណាងមិនអាចទទួលបាន !
ទាក់ទង ទៅ នឹង បទចម្រៀង ដែល នៅសល់ ក្នុង បណ្ណាល័យ របស់ អ្នក អ្នក អាច ប្រើ បទចម្រៀង នីមួយ ៗ បាន ។
ហើយ អាច ស្តាប់ និង ស្តាប់ ពួកគេ ។
ដូច្នេះហើយ វាបានបន្តអស់រយៈពេលជាច្រើនឆ្នាំ បន្ទាប់ពីសង្គ្រាមដ៏ធំទី មួយបាន បញ្ចប់។
វា មាន វត្តមាន ជាមួយ ព្រះតាំងពី ដើម ដំបូង មក ។
ម៉ូសេ បានមកទាមទារឲ្យផារ៉ោនចុះចាញ់នឹងព្រះហឫទ័យរបស់ព្រះ។
នៅជើងរបស់គាត់ ដែលត្រចៀកនោះបានស្លាប់ ហើយគាត់ត្រូវបានគេយកទៅដាក់ក្នុងពំនូក
ចូរ ធ្វើ វា តាម ដែល អាច ធ្វើ បាន នេះ ជា ការពិបាក ជាង ការរំពឹងទុក ជាមួយនឹង រាល់ ការសម្រេចចិត្ត នៅ ទីនោះ !
ទីបំផុត ប្រវត្តិសាស្ត្រ បង្ហាញ ថា ការរីកចម្រើន ដ៏ អស្ចារ្យ បំផុត នៃ ព្រះវិហារ បាន កើតឡើង នៅ ពេល ដែល ពួក គ្រីស្ទាន ពិតជា ក្រីក្រ និង តស៊ូ ។
គាត់បាននិយាយថា៖ « យប់នេះ ខ្ញុំបានទទួល ការ សួរសុខ ទុក្ខ ពីមិត្តភ័ក្ដិរបស់ខ្ញុំ ដែលបានផ្តល់ព័ត៌មានដ៏គួរឲ្យរំខានដល់ខ្ញុំ ។
ដូច្នេះគេត្រឡប់មកវិញ ?
បុរសម្នាក់នេះគឺជា ថមមី ។
ប្រឈមមុខ នឹង លទ្ធភាព នៃ សង្គ្រាម បង្ការ ។
« ប្រាកដជាអ្នក ជាព្រះរាជ បុត្រានៃព្រះ» ។
អ្នក ប្រយុទ្ធទាំងពីរនាក់នេះធ្លាប់ជួបគ្នាម្តងរួច មកហើយ ។
