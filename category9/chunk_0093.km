ពេលម៉ូសេ ចូលទៅក្នុងផ្ទះរបស់ផារ៉ោន គាត់អាច ស៊ី ហើយស្លៀកពាក់របស់ផារ៉ោន ទោះជាគាត់ជាជនជាតិហេព្រើរក៏ដោយ ។
បន្ទាប់ពី ការលុបចោល របស់ ព័រទុយហ្គាល់ ។
ខ្ញុំ ចង់ ជួយ ពួកគេ ខ្លាំង ណាស់ ។
សូមឲ្យអ្នក កាន់ ទុក្ខ មកជាមួយគាត់ » ។
“ វាជារឿងអាម៉ាស់ដែលវាហាក់ដូចជាទៅហើយ ព្រោះគាត់នឹងពិបាកជំនួសណាស់ ។
មិនមែនកើតក្នុងសម័យនោះទេ ។
ធ្វើបែបនេះ អ្នកនឹងញ៉ាំបានគ្រប់គ្រាន់ ដូច្នេះអ្នកមានអារម្មណ៍ស្កប់ ចិត្ត ។
“ ខ្ញុំអាចមើលឃើញ តែផ្នែកនៃអនាគតប៉ុណ្ណោះ ប៉ុន្តែខ្ញុំគិតថាវាជា លទ្ធផលដែលអាចធ្វើទៅបាន តែមួយគត់ ។
នោះគឺដើម្បីគ្រប់គ្រងរាជាណាចក្ររបស់ទ្រង់ ហើយផ្សះផ្សាអ្វី ៗទាំងអស់ឲ្យត្រឡប់ទៅទ្រង់វិញតាមលំដាប់នៃសេចក្ដី សុចរិតដែលចុះ មកពីស្ថាន សួគ៌ ។
បន្ទាប់មកអ្នកនឹងយកសក់ដែលនៅសេសសល់របស់អ្នក ចេញ ( ទុកក្រវិលចេញ ) ហើយបោះវាជា កន្ទុយសេះខ្ពស់។
ដូច្នេះ អ្វី ដែល អ្នក កំពុង និយាយ ហាក់ដូចជា អាច ជឿជាក់ បាន ។
ពួកគេ ទាំង ពីរ ពាក់ ក្បាល ផងដែរ ។
ហើយ ខ្ញុំ នឹង ប្រាប់ អ្នកថា ការចាក់ ម្ជុល វិទ្យាសាស្ត្រ មាន ប្រសិទ្ធភាព សម្រាប់ រឿង ទាំងនេះ ។
ហើយបើអ្នក ណាឲ្យទឹកត្រជាក់មួយកែវដល់ក្មេងតូចទាំងនេះ ដោយ សារគាត់ ជាសិស្សរបស់ខ្ញុំ ខ្ញុំប្រាប់អ្នកតាមការ ពិត នោះគាត់នឹងមិនបាត់ បង់ រង្វាន់ឡើយ » ។
នាងធ្វើបែបនេះព្រោះដើមឈើ ជ្រៀតជ្រែកដំបូលផ្ទះនាង ។
លាង ដៃ របស់ អ្នក មុន និង ក្រោយពេល ប៉ះ ភ្នែក របស់ អ្នក ។
យើង មាន សិទ្ធិ ប្រុងប្រយ័ត្ន ចំពោះ រឿង ទាំងអស់ នេះ ។
អ្នក ជាអ្នកបដិសេធដែលមិនអាចសើមបាន
សេចក្តីស្រឡាញ់ ដែល ពួកគេ បាន ចាក់ មក លើ ខ្ញុំ ។
០៤ នៅលើ ភ្នំ មេគី ដូ
ខ្ញុំ មិន ចាំបាច់ លើកទឹកចិត្ត ពួកគេ ទេ នៅ កូរ៉េ អ៊ីតាលី គឺ ធំ !
ប្រសិនបើ អ្នក ជួល ខ្ញុំ ខ្ញុំ នឹង បង្ហាញ អ្នក ពី សមត្ថភាព របស់ ខ្ញុំ ។
ក្រុមហ៊ុនក៏មានផលិតផលជាច្រើនដែលបានដាក់ លក់ក្នុងឆ្នាំ 2018 ។
ការ ប្រោសមនុស្សស្លាប់រស់ឡើងវិញគឺនៅឆ្ងាយណាស់ ។
អ្នក សង្ឃឹមពីរនាក់ត្រូវបញ្ជូនទៅផ្ទះមុនការ ផ្សាយផ្ទាល់ ។
យើង ចង់ បង្កើត ការសន្ទនា អន្តរ ជំនាន់ ។ យើង ចង់ និយាយ !
និង ច្រកផ្លូវ ពីរ បំបែក ដោយ ចង្អុល ចង្អុល
ទំនិញ ទាំងអស់ នាំចូល ពី ប្រទេស កូរ៉េ ។
ចាប់ពី ថ្ងៃ នេះ និង រយៈពេល ជាច្រើន ថ្ងៃ ទីក្រុង ទាំងមូល នឹង ទទួលបាន ទឹក ទាំងអស់ ពី កន្លែង ចាក់ សំរាម ។
ដែល បាន និយាយ ថា គ្រឿង ដែល មាន ល្បឿន លឿន គួរ ទុកឲ្យ អ្នកគាំទ្រ ។
ព័ត៌មាន ដែល អ្នក ផ្តល់ឱ្យ យើង ក្នុង លក្ខខណ្ឌ នៃ សេវាកម្ម នឹង ត្រូវបាន រក្សាទុក សម្រាប់ រយៈពេល 10 ឆ្នាំ ។
៩ឥឡូវនេះ សូមឲ្យពួកគេដកពេស្យាចារ និងសាកសពរបស់ស្ដេចរបស់ពួកគេចោលឆ្ងាយពីខ្ញុំ ។ ហើយ ខ្ញុំ នឹង រស់ នៅក្នុង កណ្តាល ពួកគេ ជារៀងរហូត ។
ព្រះយេស៊ូវបានសម្រេចកិច្ចការនេះតាមរយៈ ការសុគត និងការរស់ ឡើងវិញរបស់ទ្រង់ ។
ម៉ាកុស 11:28 គាត់សួរគាត់ ថា៖ « តើអ្នកធ្វើការ ទាំងនេះដោយអាងអំណាចអ្វី ? ហើយតើអ្នក ណាបានឲ្យអំណាចនេះធ្វើការ ទាំងនេះ ?
អគារនេះនឹងត្រូវបានកែច្នៃឡើងវិញទាំង ស្រុងនៅថ្ងៃទី ១៧ ខែ ឧសភា
បួននាក់ទៀតនឹងត្រូវផ្លាស់ទីនៅថ្ងៃនេះ ។
ខ្ញុំ មាន ការខកចិត្ត យ៉ាង ខ្លាំង ចំពោះ ព្រឹត្តិការណ៍ នៅ ព្រឹក នេះ ។
ជា ការឆ្លើយតប ហ្វារី ណា បាន ចុះ ចាញ់ គណបក្ស ប្រជាធិបតេយ្យ ។
តើមាន វិធីដើម្បីយកឈ្នះអ្នក ជានរណា ហើយប្រសិនបើដូច្នេះ តើអ្នកនៅតែជាអ្នក ជានរណា ឬអ្នកគ្រាន់តែដឹង ថាអ្នកគួរតែជានរណា?
នៅ ចំណុច ខ្លះ អ្នក អាចនឹង ឃើញ ខ្លួន ឯង ស្ថិត ក្នុង ស្ថានភាព មួយ ដែល គ្មាន ទឹក ផឹក ។
វាបានមកពីការ ធ្វើខុសដែលគាត់ប្រាកដ ។
ដូច្នេះ អ្នក នឹង ចង់ ចាប់ យក ចំណាប់អារម្មណ៍ របស់ ពួកគេ ឱ្យ បាន រហ័ស ។
យើងរីករាយណាស់ដែលបានទទួលអំណោយនេះ ។
បាន ប្តឹង ទៅ ហ្គ្រេហ្គោរី ។
3:16 ឬជាការ កើតមិនទាន់ពេលដែលបានលាក់, ខ្ញុំមិនគួរត្រូវបាន ; ឬដូចជាអ្នកដែលមានផ្ទៃពោះ មិនបានឃើញពន្លឺ ។
ហើយ រហូតមកដល់ សព្វ ថ្ងៃ នេះ នាង បាន ដើរ ទៅ មុខ
ខ្ញុំបានឮថាពួកគេជាពលរដ្ឋដែលពួកគេបានរើស ។
ដូច្នេះហើយបានជាក្រុមអ្នក ចាញ់នេះមើលងាយគាត់។
ការឈឺចាប់ ភ្លាម ៗ ហើយ មិន បាត់ ទេ ។
ភាព ល្ងង់ខ្លៅ គឺ ល្អ ឥត ខ្ចោះ សម្រាប់ មនុស្ស គ្រប់ គ្នា ក្នុង គ្រួសារ !
ជាមួយនឹង តក្កវិជ្ជា ត្រូវបាន ជួសជុល ដូចជា ផ្ទះល្វែង របស់ ស៊ុលតង់ ។
និង មិន សម្រប ទៅនឹង ក្រុម ថ្នាក់ បរិញ្ញាបត្រ ។
មាន ផាសុខភាព ណាស់ ដូច្នេះ ខ្ញុំ អាច មាន បាន ។
ខ្ញុំមានអំណាចស្កុត ឡេនក្នុងតម្លៃថេរមួយ តើខ្ញុំអាចយកវាចេញបានទេ ?
មហោស្រព របស់ ខ្ញុំ ។
បុរស ត្រជាក់ ដែល មិន មែន ទាំងអស់ អំពី ការទទួលបាន ស្ថិតិ របស់ គាត់ ។
ទ្រង់មិនដាក់ទោសអ្នកឡើយ ហើយទ្រង់មិនបានដាក់អ្នកទៅលើផ្លូវនៃការ ឈឺចាប់នោះទេ ។
នេះកំពុងមើលមុខអ្នក !
ដោយ មិន ដឹងខ្លួន ខ្ញុំ គិត ថា ខ្ញុំ កំពុង រៀបចំ សម្រាប់ ការផ្លាស់ប្តូរ ។
ចំណេញ កាន់តែ ច្រើន !
១៣ អ្នក រាល់គ្នានឹងក្រោកឡើង ហើយអាណិតដល់ក្រុង ស៊ីយ៉ូន ដ្បិតដល់ពេលវេលាសម្រាប់សេចក្ដី មេត្តា ករុណា ត្បិតដល់ពេលហើយ ។
ប៉ុន្តែប្រធានព្រះអម្ចាស់កំពុងធ្វើសេចក្តី ថ្លែងការណ៍ដែលកើតចេញពីការ សម្រេចរបស់ខ្ញុំ ហើយខ្ញុំគិតថាគាត់គួរ តែត្រូវបានអនុញ្ញាតឲ្យ បញ្ចប់ ។
វាមិនមាន ន័យថាបល្ល័ង្កត្រូវបានប្រគល់ទៅព្រះអង្គម្ចាស់តូចនោះទេ » ។
គ្រាន់ តែវាមិនដឹងវិសាលភាព ។
បន្ទាប់មក គេ ត្រូវ បម្រើ ភ្លាម ៗ ក្រែង លោដួល ។
