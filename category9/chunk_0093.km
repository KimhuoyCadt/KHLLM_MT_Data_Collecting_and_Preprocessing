43 ព្យាការីទាំងអស់ធ្វើជាសាក្សីដល់ទ្រង់ថា អស់អ្នកដែលជឿលើទ្រង់ទទួលបានការ អត់ទោស បាបតាម រយៈព្រះនាមទ្រង់ ។
ប្រសិនបើ យើង ទទួលបាន ភាព ពេញលេញ នៅក្នុង វត្តមាន របស់ ព្រះ យើង ត្រូវ ធ្វើ ការ សម្រាប់ វា ។
ម្យ៉ាងទៀត ការ ល្អគឺស្ត្រីមានកូន ។
និយាយ អំពី ការស្វែងរក ស្នេហា ម្តង ទៀត ។
ភាព មិន ច្បាស់លាស់ គាត់ បាន ប្តេជ្ញា
ប្រើនៅពេលដែលអ្នកចង់បានប្រវែងខ្សែបូ ឬអំបោះ ?
ដោយការ មិនជឿរបស់ពួកគេ ” ពួក សាសន៍យូដាបាន រអ៊ូរទាំដាក់ទ្រង់ ដោយព្រោះទ្រង់មាន បន្ទូលថា ខ្ញុំ ជាអាហារដែលចុះ មកពីស្ថាន សួគ៌ ។
ការិយាល័យ សេវាកម្ម ។
ហើយចំពោះអ្នកដែលសួរថា តើខ្ញុំពិតជាត្រូវធ្វើរឿងទាំងអស់នេះមែនទេ ?
គាត់ បាន ឃើញ ពួកគេ លិច នៅក្នុង ទី ងងឹត ។
នោះជាអំណាចច្រើន ( អាក្រក់នោះ ) ។
ក្រុមប្រឹក្សា ប្រព័ន្ធ ដូចគ្នា គ្រប់គ្រង ហិរញ្ញវត្ថុ សម្រាប់ ទាំង បី ។
អ្នក នឹង អាច មើលឃើញ វិក័យប័ត្រ ចុងក្រោយ នឹង មើល ទៅ ។
យើង កំពុង ចាត់ទុក នាង ជា ជនរងគ្រោះ ហើយ នាង ត្រូវបាន បញ្ជូន ទៅ ផ្ទះ ស្តារ នីតិសម្បទា ។
យើងដឹងថាមន្ត្រីនោះនឹងមិនត្រូវបានកាត់ទោសទេ » ។
កិច្ចព្រមព្រៀង បាន ចូល ជាធរមាន ក្នុង ខែកុម្ភៈ និង ខែមេសា ឆ្នាំ ២០១៣ ។
មិន ត្រឹមតែ តំបន់ ស្វយ័ត ប៉ុណ្ណោះ ទេ ។
គាត់ បាន ដើរ តាម ផ្លូវ របស់ គាត់ ដោយ ក្តីស្រឡាញ់ ( និង កំប្លែង ) បាន រៀបការ ជាមួយ កូនស្រី របស់ គាត់ ជាមួយ កូនកំលោះ ។
ដូច្នេះដល់វេនអ្នក ដើម្បីឃើញវេទមន្តពិតប្រាកដនៅចំពោះមុខភ្នែកអ្នក ... តើអ្នកត្រៀមខ្លួនហើយឬនៅ ?
នរណា ម្នាក់ ដែល អាច ស្តាប់ បាន ។
ពួកគេចាប់ពួកសាវ័ក ហើយដាក់ក្នុងគុករួម ។
បច្ចុប្បន្នយើងត្រូវបានចុះ កិច្ច សន្យាដើម្បីអនុវត្តការងារសម្រាប់ផ្នែកសំខាន់មួយ ។
ជីវិតគឺមិនតិច តួចនោះទេ ។
ចាំថាតើវាមានរយៈពេលប៉ុន្មានថ្ងៃ ?
ដៃគូ របស់ សហរដ្ឋ អាមេរិក កំពុង ចូល ។
បញ្ជី ឈ្មោះ អ្នក ផ្តល់ សេវា ទូរទស្សន៍ បង់ប្រាក់ !
ព្រះ បានបង្គាប់ឲ្យគេធ្វើការ ល្បង លពួកគេ ។
រក្សា មុខ របស់ អ្នក ឱ្យ ស្អាត និង គ្មាន គ្រឿង សម្អាង នៅ ថ្ងៃ ព្យាបាល ។
ឆ្នាំ ដំបូង ឬ ពីរ ឆ្នាំ នៃ អត្ថិភាព របស់ វា ហើយ ក្រោយមក បាន បង្កើត ក្រដាស ប្រចាំ សប្តាហ៍
សម្រាប់ ជា ប្រយោជន៍ នៃ ឈ្មោះ របស់ ខ្ញុំ ។
សម្រាប់ ជា ប្រយោជន៍ នៃ ឈ្មោះ របស់ ខ្ញុំ ។
ហើយបានលេងបន្តិច បន្តួចជាមួយ៖
ហើយពួកគេទទួលបានការ សរសើរ ពីភ្ញៀវ ។
ហៅគាត់ថាជាអ្នកកុហកចំពោះមុខគាត់ ព្រោះបុរសនោះជាមនុស្ស ។
របៀប ក្លាយជា មនុស្ស ពេញនិយម នៅលើ ហ្វេសប៊ុក - វិធី លាក់
ពិតជា នៅក្នុង ដំណាក់កាល ទាំង បី ។
ខ្ញុំ ចង់ ឃើញ ដើមទ្រូង ប្អូនស្រី របស់ ខ្ញុំ ។
ខ្ញុំមើលគេឆ្ងល់ថាប្រុសមួយ ណាជាស្រី ។
ដូច្នេះ នេះ គឺជា ការប្រុងប្រយ័ត្ន ទាំងអស់ ។
ការ សម្រេច ចិត្តលើកឡើងពីកម្រិតកំណត់របស់ជនជាតិកាណាដាបច្ចុប្បន្ន
នេះកើតឡើង បន្ទាប់ពីមានការ ចាប់អារម្មណ៍ ជាច្រើននៅលើបណ្ដាញសង្គមអំពី ។
ដើម្បី កុំ ឱ្យ មាន អារម្មណ៍ គំរាមកំហែង ដោយ ជន មិន ស្គាល់ ។
យើងបានកំណត់ប្រទេសម៉ាឡាវី ជាប្រទេសដែលមានសក្តានុពលបំផុតលើមូលដ្ឋាននេះ ។
អ្វីដែលចេញ មកពីយើង ពេលយើងទុក ចិត្តលើព្រះ គ្រីស្ទ
យ៉ាង ណាក៏ដោយ គាត់មក រកយើង ហើយយើងឃាត់គាត់ ។
សង្ឃឹមថានឹង រកឃើញអ្នកពិត ។
ខ្ញុំគិតថាខ្ញុំនឹងឆ្លងកាត់ការ រៀនសូត្រ ។
ខ្ញុំមិនដែលលក់អ្វីទេក្នុងជីវិតរបស់ខ្ញុំ » ។
វាអាចអានពីដើមដល់ចប់នៅពេលយប់មុន។
ព្រោះវាជា ជាតិ តែមួយ តើវាមិនមែនជាការ សម្រេច ចិត្តទេ ?
ភាពសម្បូរបែប នៃ បុរស ដោយ ឥត គិត ថ្លៃ នៅក្នុង
តើ អ្នក ចង់ ធ្វើការ ជាមួយ មនុស្ស ទាំងនេះ ទេ ?
កុំ ធ្វើ ដូច អ្នកនិពន្ធ នេះ ។
ប្រសិនបើ អ្នកណា ម្នាក់ ចង់ ធ្វើ បាន ល្អ តាម អ៊ីនធឺណិត ពួកគេ ត្រូវតែ ប្រកាន់ខ្ជាប់ នូវ បញ្ជី នេះ ចំពោះ ពាក្យ នេះ ។
វា នឹង អនុញ្ញាតឱ្យ អ្នក ស្វែងយល់ អំពី ,
ចេញ ពី ប្រអប់ ហើយ មិន ទាន់ បាន បោះត្រា ជាមួយ តម្លៃ ។
ពួកគេ មិន ស្លាប់ ទេ ( ទោះបីជា ពួកគេ មើល ទៅ ដូច្នេះ ក៏ដោយ ) ពួកគេ ស្ថិត ក្នុង ភាពតក់ស្លុត ។
នេះគឺជាដើមដ៏ អស្ចារ្យនៃទឹកដី ។
អំពី អ្វី គ្រប់ យ៉ាង ហើយ ធ្វើ តាម ពួកគេ បង្ហាញ ថា អ្នក ទៅ ជាមួយ
" ហើយពួកគេប្រហែលជាមិនអាចស្តាប់យើងបានទេ ព្រោះពួកគេនឹងបាញ់មកលើយើងបើមិនដូច្នេះទេ " ។
សម្រាប់អ្នកដែលចាប់អារម្មណ៍ ខ្ញុំបានសរសេរអត្ថបទមួយនៅថ្ងៃនេះ ។
វា និយាយ ថា " សម្រាប់ មនុស្ស នៅក្នុង ផ្ទះ នេះ ក្តីសុបិន្ត ត្រូវបាន សម្រេច ។
ការផ្សាយ ពាណិជ្ជកម្ម បាន ប្រើ ចំណងជើង ថា " ស្វែងរក ស្នេហា នៅ ប្រទេស កាណាដា !
មនុស្សមួយចំនួនរងការ គំរាម កំហែងខ្លាំងពីគំនិតដែលស្ត្រីមាន
កិច្ចការ ទី មួយ គឺ អំពី ខ្ញុំ ។
នៅពេលនោះ សូមឲ្យពួកគេជូនដំណឹងអំពីស្ថានការណ៍នៅខាងក្រៅ ។
ខ្ញុំ ចង់ ធ្វើដំណើរកម្សាន្ត
ការយល់ ច្រឡំ បាន ថយចុះ
គ្មានអ្នក ណាដែលកោតខ្លាចទ្រង់ឡើយ ។
ពួកគេបានអានខ្លឹមសារ ហើយត្រូវបានគេទម្លាក់ចោល ។
មិនថាពណ៌ ស ឬពណ៌លឿង គិតថាអ្នក ណាពាក់ស្អាតជាង ?
អ្នកត្រូវ តែស្អប់នោះមែនទេ !
១៣ ( ត្បិតនៅចំពោះមុខក្រឹត្យ វិន័យ អំពើ បាបមាននៅក្នុងលោកីយ៍ ប៉ុន្តែអំពើ បាបមិនត្រូវបានកំណត់ចំពោះអ្នកដែលគ្មានច្បាប់ទេ ។
៦ នាងទូលស្ដេច ថា៖ « នេះជាសេចក្ដី ពិតដែលខ្ញុំបានឮនៅស្រុករបស់ខ្ញុំ អំពី ការ ប្រព្រឹត្ត និងប្រាជ្ញារបស់អ្នក » ។
