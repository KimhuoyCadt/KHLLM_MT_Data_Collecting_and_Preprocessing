( ភ្នំពេញ ) ៖ កម្ពុជា មាន ការតាំងពិព័រណ៍ និង សិក្ខាសាលា អន្តរជាតិ ស្តីពី កសិកម្ម បសុសត្វ និង ជល ផល លើក ទី៤ ដែល បាន និង កំពុង ធ្វើឡើង រយៈពេល ០២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី ១៨ ខែមិថុនា ឆ្នាំ ២០១៩ នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ កោះ ពេជ្រ រាជធានី ភ្នំពេញ ដែល មាន ក្រុមហ៊ុន ជាង ៣០០ ក្រុមហ៊ុន មកពី ប្រទេស ផ្សេង ៗ គ្នា តំណាង ឱ្យ ផលិតផល ថ្មី ៗ ការច្នៃប្រឌិត និង ឧបករណ៍ ថ្មី ៗ នៃ ឧស្សាហកម្ម កសិកម្ម បសុសត្វ ជី គីមី និង ថ្នាំ សម្លាប់ សត្វ ល្អិត នៅក្នុង ប្រទេស កម្ពុជា និង ក្នុង តំបន់ ។
ក្នុង ឱកាស អញ្ជើញ បើក សម្ពោធ ពិធី ព្រឹក មិញ នេះ . លោក ចាន់ ចេស្តា រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ថ្លែង ថា វិស័យ ឯកជន ដែល មាន ជាង ៣០០ ក្រុមហ៊ុន កំពុង តាំង បង្ហាញ ផលិតផល កសិកម្ម នេះ គឺជា ការបើកចំហរ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការទាក់ទាញ វិនិយោគិន ឯកជន ដើម្បី ចូលរួម អភិវឌ្ឍន៍ ប្រទេសជាតិ ទាំងអស់ គ្នា ។
លោក ចាន់ ចេស្តា បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « នេះ ជា ការបើកចំហរ របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ការទាក់ទាញ វិនិយោគិន ឯកជន ដើម្បី ចូលរួម អភិវឌ្ឍន៍ ប្រទេស ទាំងអស់ គ្នា ។ ជា ការពិត ដៃគូ ដ៏ សំខាន់ ក្នុង ការអភិវឌ្ឍ ប្រទេស ក្នុង ការលៈទេសៈ ដែល ប្រទេស កម្ពុជា កំពុងតែ យក វិស័យ កសិកម្ម ជា ស្នូល នៃ សេដ្ឋកិច្ច ហើយ ខិតខំ ជំរុញ ឲ្យ វិស័យ ឧស្សាហកម្ម ជំនួស វិស័យ កសិកម្ម គឺ ឯកជន » ។
លោក បន្ត ថា « ដូច្នេះហើយ យើង មិន អាច ខាន បាន ទេ លើ វិស័យ ឯកជន យើង បើក ចំហរ និង គាំទ្រ លើកទឹកចិត្ត ដល់ វិស័យ ឯកជន ដែល កន្លងមក នេះ រាជ រដ្ឋាភិបាល បាន កាត់បន្ថយ នូវ ការិយាធិបតេយ្យ មាន ន័យ ថា កាត់បន្ថយ ភាពស្មុគស្មាញ ក្នុង ការបំពេញ បែបបទ ដើម្បី វិន យោគ នៅ កម្ពុជា ។ ជាមួយគ្នា នេះ រាជ រដ្ឋាភិបាល ក៏ កំពុង កាត់បន្ថយ ការដឹកជញ្ជូន ថ្លៃ អគ្គិសនី ដើម្បីឲ្យ វិនិយោគិន ឯកជន មាន លទ្ធភាព អភិវឌ្ឍន៍ នៅក្នុង ប្រទេស កម្ពុជា របស់ យើង » ។
ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ថ្មី ៗ នេះ តម្រូវការ សាច់ និង ជល ផល នៅ កម្ពុជា បាន កើនឡើង យ៉ាង ឆាប់រហ័ស ដែល បាន ជំរុញ ឱ្យ មាន ការកើនឡើង ក្នុង ការកែច្នៃ និង ផលិត ចំណី សត្វ លើ គោ គ និង ចំណី សត្វ ក្នុង ទឹក ។ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ក៏ បាន ប៉ាន់ប្រមាណ ថា តម្រូវការ សាច់ សត្វ ប្រហែល ជាង ៣០០.០០០ តោន និង កើនឡើង នៅ ឆ្នាំ ២០២០ នៅ ពេល ដែល ចំនួន ប្រជាជន កម្ពុជា ត្រូវបាន គេ ប៉ាន់ស្មាន ថា និង កើនឡើង ប្រហែល១.៥% ជារៀងរាល់ ឆ្នាំ ។
( ភ្នំពេញ ) ៖ លោក ប៉ា សុជាតិ វង្ស ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខណ្ឌ ច្បារអំពៅ អាណត្តិ ទី៣ នៅ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ ។ ក្រុមប្រឹក្សា អាណត្តិ ទី៣ របស់ ខណ្ឌ ច្បារអំពៅ មាន លោក អ៊ំ ម៉ារ៉េត ជា ប្រធាន ក្រុមប្រឹក្សា និង មាន សមាជិគ ចំនួន ២០ រូប ។
ពិធី ប្រកាស ចូលកាន់ តំណែង នៅ ព្រឹក នេះ បាន ប្រារព្ធ ធ្វើ នៅ សាលា ខណ្ឌ ច្វារ អំពៅ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក អភិបាល ខណ្ឌ អធិការ នគរបាល មេបញ្ជាការ កងរាជអាវុធហត្ថ ចៅសង្កាត់ មេភូមិ និង ប្រជាពលរដ្ឋ ផងដែរ ។
សូម បញ្ជាក់ ថា ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ អាណត្តិ ទី៣ ឆ្នាំ ២០១៩ កន្លងទៅ នេះ គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន សំឡេង គាំទ្រ លើសលុប និង គ្រប់គ្រង អាសនៈ ក្រុមប្រឹក្សា ស្ទើរតែ ទាំងស្រុង បន្ត ពី នោះ គឺ គណបក្ស ខ្មែរ រួបរួម ជាតិ និង គណបក្ស ហ៊្វុនស៊ិនប៉ិច ។
លទ្ធផល ផ្លូវការ ដែល ប្រកាដោយ គ.ជ. ប នៅ ថ្ងៃទី ០៨ ខែមិថុនា ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ខេត្ត គឺ គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន ៥៥០ អាសនៈ គណបក្ស ខ្មែរ រួបរួម ជាតិ ទទួលបាន ៦ អាសនៈ និង គណបក្ស ហ្វ៊ុន ស៊ិនប៉ិច ទទួលបាន ៣ អាសនៈ ក្នុង ចំណោម អាសនៈ សរុប ៥៥៩ អាសនៈ ៕
ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខេត្ត ក្រចេះ អាណត្តិ ទី៣. រដ្ឋមន្រ្តី ពេជ្រ ប៊ុន ធិន ជំរុញ ឲ្យ ក្រុមប្រឹក្សា និង អាជ្ញាធរ ខេត្ត ត្រូវ បំពេញ ភារកិច្ច ឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់
( ក្រចេះ ) ៖ លោក ពេជ្រ ប៊ុន ធិន រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខេត្ត ក្រចេះ អាណត្តិ ទី៣ ចំនួន ២១ រូប ព្រមទាំង បាន ក្រើន រំលឹក ឱ្យ ក្រុមប្រឹក្សា និង អាជ្ញាធរ ខេត្ត ក្រចេះ ត្រូវ បំពេញ ភារកិច្ច ប្រកបដោយ វិជ្ជាជីវៈ និង ធ្វើ យ៉ាងណា ឱ្យ មាន ការទទួលខុសត្រូវ និង មាន ប្រសិទ្ធភាព ខ្ពស់ ។
ពិធី ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខេត្ត ក្រចេះ នេះ បាន រៀបចំឡើង នៅ សាល មហោស្រប ខេត្ត ក្រចេះ ដោយ មាន ការចូលរួម ពី លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ . ប្រធាន ក្រុមប្រឹក្សា ខេត្ត អង្គភាព ពាក់ព័ន្ធ នៅក្នុង ខេត្ត ក្រចេះ ព្រមទាំង ភ្ញៀវ កិត្តិយស ជាច្រើន ទៀត ផងដែរ ។
រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ បាន បន្ថែម ថា ក្រុមប្រឹក្សា អាណត្តិ ទី៣ ត្រូវ ខិតខំ ដឹកនាំ រដ្ឋបាល របស់ ខ្លួន ឲ្យ មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ហើយ កិច្ចការ ក្រុមប្រឹក្សា ត្រូវ យកចិត្តទុកដាក់ ដោយ មាន កិច្ចការ បន្ទាន់ ចាំបាច់ បន្ទាប់ពី សេចក្តីប្រកាស កាស មុខតំណែង នេះ រួម មាន៖ មាត្រា ៤១០៦ ប្រ.ប . ក ចុះ ថ្ងៃទី ១៧ ខែឧសភា ឆ្នាំ ២០១៩ របស់ ក្រសួង មហាផ្ទៃ ដើម្បី អធិបតីភាព នៅក្នុង ការចូលកាន់ មុខតំណែង ក្រុមប្រឹក្សា ក្រុង ស្រុក ដែល ស្ថិត នៅក្នុង ការងារ រដ្ឋបាល របស់ ខ្លួន ។
លោក រដ្ឋមន្រ្តី បន្ត ថា ការងារ ក្រុមប្រឹក្សា ខេត្ត ជា អាទិភាព អាណត្តិ ទី៣ គឺ រៀបចំ ផែនការអភិវឌ្ឍន៍ រយៈពេល ៥ ឆ្នាំ តាម ការរៀបចំ វិស័យ វិនិយោគ បី ឆ្នាំ រំកិល ។ ហេតុ នេះ សូមឲ្យ អភិបាល ខេត្ត និង អភិបាល រង ខេត្ត ត្រូវ ពិគ្រោះយោបល់ បែងចែក តួនាទី ភារកិច្ច ក្នុង កិច្ចប្រជុំ នេះ ឲ្យបាន ទាន់ ពេលវេលា ស្រប តាម សេចក្តីប្រកាស របស់ គ.ជ. ប. តម្រូវ មិន ឲ្យ លើស ពី ១៤ ថ្ងៃ ក្នុង ការប្រកាស ឲ្យ កាន់ ចូលកាន់ មុខតំណែង ក្រុមប្រឹក្សា ស្រុក ខេត្ត ។
លោក ពេជ្រ ប៊ុន ធិន បាន បញ្ជាក់ ទៀត ថា ចំពោះ អភិបាល ខេត្ត ត្រូវ ចាត់ចែង ទៅដល់ នាយក រដ្ឋបាល ខេត្ត ឲ្យ មាន ការិយាល័យ ជា ប្រព័ន្ធ នៃ សេនាធិការ ដើម្បី ចាប់ផ្ដើម ធ្វើ កិច្ចការ មួយចំនួន ដែល អនុវត្ត ការងារ ក្រុមប្រឹក្សា រាជធានី ខេត្ត ដែល បាន អនុវត្ត ក្នុង រយៈពេល កន្លងមក ហើយ សមាជិក ក្រុមប្រឹក្សា ថ្មី ត្រូវ ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល របស់ ខ្លួន ឲ្យបាន ត្រឹមត្រូវ តាម ច្បាប់ កំណត់ រួច ផ្ញើ ទៅ អង្គភាព ប្រឆាំង អំពើពុករលួយ មិន ឱ្យ លើស ពី ៣០ ថ្ងៃ បន្ទាប់ពី ប្រកាស ចូលកាន់ មុខតំណែង នេះ ៕
ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ស្រុក កៀនស្វាយ . លោក គុណ ញឹម ជំរុញ រដ្ឋបាល ស្រុក កៀនស្វាយ បម្រើ ពលរដ្ឋ ឲ្យបាន ល្អ ប្រសើរ ថែម ទៀត
( កណ្ដាល ) ៖ លោក គុណ ញឹម អនុប្រធាន ទី១ ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក កៀនស្វាយ តំណាង លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុន្នី រត័្ន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ជួយ ខេត្ត កណ្តាល នា រសៀល ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ស្រុក កៀនស្វាយ អាណត្តិ ទី៣ ដោយ លោក ជា ប៊ុន ធឿន ជា ប្រធាន ក្រុមប្រឹក្សា ។
ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា លោក គុណ ញឹម បាន អបអរសាទរ កោតស សើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមាជិក ក្រុមប្រឹក្សា ដែល ត្រូវបាន តំណាង ប្រជាពលរដ្ឋ គឺ សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ផ្តល់ សេចក្តីទុកចិត្ត បោះឆ្នោត ជ្រើសរើស សមាជិក ក្រុមប្រឹក្សា ស្រុក អាណត្តិ ទី៣ ដើម្បី បន្ត ដឹកនាំ ស្រុក ឲ្យ បន្ត អភិវឌ្ឍន៍ រីកចម្រើន លើ គ្រប់ វិស័យ ជា បន្ត ទៀត រដ្ឋបាល ស្រុក កៀន មាន សមាជិក ក្រុមប្រឹក្សា ចំនួន ២១ រូប ។
លោក គុណ ញឹម បាន បញ្ជាក់ ថា ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ អាណត្តិ ទី៣ កាលពី ថ្ងៃទី ២៦ ខែឧសភា ឆ្នាំ ២០១៩ កន្លងមក ត្រូវបាន វាយតម្លៃ ថា មាន លក្ខណៈ សេរី ត្រឹមត្រូវ យុត្តិធម៌ និង គ្មាន អំពើហិង្សា ហើយ លទ្ធផល នៃ ការបោឆ្នោត ត្រូវបាន ទទូល ស្គាល់ ពី គណបក្ស នយោបាយ នានា ដែល បាន ចូលរួម ក្នុង ការបោះឆ្នោត ផងដែរ ។
សូម បញ្ជាក់ ថា លោក ជា ប៊ុន ធឿន ត្រូវបាន ជាប់ ឆ្នោត ជា ប្រធាន ក្រុមប្រឹក្សា ស្រុក កៀនស្វាយ ហើយ ពិធី នេះ ក៏ មាន ការប្រកាស តែងតាំង អភិបាល រង ស្រុក កៀនស្វាយ១ រូប ផងដែរ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី១៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ ក្រុម បាតុករ មួយចំនួន ដែល មិន ព្រម ទទួលយក ការសម្រេចចិត្ត ផ្អាក ការអនុម័ត លើ ច្បាប់ ធ្វើ បត្យាប័ន ជន សង្ស័យ ( ក្នុង ករណី ប្រព្រឹត្ត បទល្មើស ) ទៅកាន់ ចិន ដី គោក នៅតែ បន្ត គ្រប់គ្រង ផ្លូវ សំខាន់ ៗ ជាច្រើន នៅក្នុង ទីក្រុង ហុងកុង នៅ ថ្ងៃចន្ទ នេះ ដោយសារតែ ពួកគេ មួយចំនួន នៅតែ មិន ទុកចិត្ត ចំពោះ ការសម្រេចចិត្ត ខាងលើ នេះ ៕
២៖ សមាជិក ក្រុម សកម្ម ប្រយុទ្ធ ដល់ ទៅ ជាង ១០០ នាក់ បាន ស្លាប់ ក្នុង ការប្រយុទ្ធ គ្នា យ៉ាង ក្តៅ គគុក អំឡុង ពេល ០៣ ថ្ងៃ កន្លងមក នេះ ខណៈ ដែល កងកម្លាំង រដ្ឋាភិបាល អាហ្វហ្គានីស្ថាន បាន បង្កើន យុទ្ធនាការ កម្ចាត់ ក្រុម ឧទ្ទាម តាលី បង់ ៕
៣៖ សហរដ្ឋ អាមេរិក មិន ចង់ មាន សង្រ្គាម ជាមួយ អ៊ីរ៉ង់ ឡើយ ប៉ុន្តែ ទីក្រុង វ៉ាស៊ីនតោ នឹង ចាត់ វិធានការ ចាំបាច់ នានា ក្នុង នោះ រួមទាំង ការទូត ដើម្បី ធានា ការពារ សុវត្ថិភាព នៃ ការធ្វើ នាវា ចរ នៅក្នុង តំបន់ មជ្ឈិមបូព៌ា ៕
ខ្ញុំ ជឿ ថា ទណ្ឌិត សម រង្ស៉ី ពិតជា ដឹងខ្លួន ឯង ច្បាស់ ណាស់ ថា ពាក្យបណ្តឹង មួយ នេះ ទោះជា ប្តឹង នៅ តុលាការ ប្រទេស ណា ក៏ដោយ មិន ថា តែ ស្រុក ខ្មែរ ឬ ស្រុក បារាំង នោះ ទេ ក៏ សម រង្ស៉ី ដឹង តែ ពី ចាញ់ ក្តី នេះ ១០០ % ពីព្រោះ វា គឺជា ការចោទប្រកាន់ ដោយ អារម្មណ៍ តាម ការ នឹកឃើញ ស្រមើស្រមៃ ទៅ តាម ទម្លាប់ ដែល គាត់ ធ្លាប់ បាន ធ្វើ កន្លងមក តែ ប៉ុណ្ណោះ ។
តាម សារជាតិ និង ចារឹក ក្រឡិច ក្រឡុច ពី កំណើត របស់ ខ្លួន ទណ្ឌិត សម រង្ស៉ី ខិតខំ និយាយ បូរបាច់ ដើម្បី បង្វែរ សំណុំរឿង ឲ្យ ទៅជា សំណុំរឿង ផ្សេង ក្នុង បំណង ក្រែង សម្តេច នាយក រដ្ឋមន្ត្រី ឈប់ ប្តឹង វិញ ។ ប៉ុន្តែ បើ យោង តាម ប្រភព ព័ត៌មាន ដែល ខ្ញុំ ទទួលបាន ក្រុម មេធាវី និង អ្នក ច្បាប់ របស់ រដ្ឋាភិបាល កំពុង ធ្វើ ការងារ នេះ យ៉ាង សកម្ម និង យ៉ាង ល្អិតល្អន់ ហ្មត់ចត់ បំផុត មុននឹង ដាក់ បណ្តឹង ឱ្យ ស្រប តាម ច្បាប់ និង និតិវិធី របស់ តុលាការ ប្រទេស បារាំង ហើយក៏ មិន ឱ្យ ផុត អាជ្ញា យុកាល ដែល អាច ប្តឹង បាន នោះ ដែរ ។
ដូច្នេះ ប្រហែលជា ទណ្ឌិត សម រង្ស៉ី ឃើញ ថា ក្រោយពេល មាន ការផ្សាយ ព័ត៌មាន ថា សម្តេច នាយក រដ្ឋមន្ត្រី ប្តឹង ខ្លួន ទៅ តុលាការ បារាំង ហើយ ក្រោយមក បែរជា ស្ងាត់ ទៅ វិញ ទើប គាត់ ចង់ ធ្វើតេស្ត ដើម្បី បញ្ជាក់ ថា តើ សម្តេច តេជោ ហ៊ុន សែន ប្តឹង ឬ អត់ ? ត្រង់ ចំណុច នេះ ខ្ញុំ យល់ឃើញ ថា លោក សម រង្ស៉ី ពិតជា អន់ រក លេខ ដាក់ គ្មាន ព្រោះ គ្រាន់តែ មូលហេតុ ពិត នៃ ការបាត់ ដំណឹង ថា ប្តឹង ឬ មិន ប្តឹង ក៏ គាត់ វាយតំលៃ មិន ត្រូវ ផង ហើយ បែរជា បកស្រាយ ទៅជា ថា សម្តេច តេជោ ហ៊ុន សែន កំសាក មិន ហ៊ាន ប្តឹង ឯណា ឯណោះ ទៅ វិញ ។
ខ្ញុំ យល់ឃើញ ទៀត ថា ទណ្ឌិត រង្ស៉ី មិន គប្បី ចំណាយ ពេលវេលា និង ខួរក្បាល គិត ធ្វើ រឿង គ្មាន ប្រយោជន៍ ដែល ធ្វើឱ្យ ខ្លួន ឯង កាន់តែ បាត់បង់ ឥទ្ធិពល ហើយ ទឹក មាត់ កាន់តែ សាប នោះ ទៀត ទេ ។ សម រង្ស៉ី ក៏ មិន ចាំបាច់ ព្យាយាម បង្អាក់ ដំណើរការ ពាក្យបណ្តឹង នោះ ដែរ ព្រោះ ខ្ញុំ កត់សម្គាល់ ច្បាស់ ណាស់ ថា បើ សម្តេច តេជោ ហ៊ុន សែន សម្រេច ធ្វើ អ្វី មួយ ហើយ គឺ សម្តេច នឹង ធ្វើ ទោះ ដោយ តំលៃ ណា ក៏ដោយ ហើយ ជាពិសេស យុទ្ធ វិធី កម្ចាត់ សត្រូវ មួយ របស់ សម្តេច ដែល សម រង្ស៉ី គួរ ចងចាំ ទុក នោះ គឺ « ការតាម វាយ សត្រូវ ដល់ ផ្ទះ » ។
នរណា ក៏ ដឹង ដែរ ថា សម រង្ស៉ី ជា មនុស្ស ពុល ទឹកមាត់ ហើយ និយាយ ចោទ គេ ប៉ាត ណា ប៉ាតណី ដោយ គ្មាន មូលដ្ឋាន ។ សម រង្ស៉ី ជា មនុស្ស ធំធាត់ និង រៀន សូត្រ នៅ ស្រុក បារាំង ប៉ុន្តែ ទីបំផុត ច្បាប់ បារាំង ក៏ មិន ចេះ ច្បាប់ ខ្មែរ ក៏ មិន ស្គាល់ ។ នៅ ស្រុក ខ្មែរ អ្នកនយោបាយ រូប នេះ ដឹង តែ ពី ដើរ អុជ អាល ញុះញង់ បង្ក រឿង គ្រប់ បែបយ៉ាង និង ជា ជើងឯក ក្នុង ការនិយាយ ចោទ គេ ឯង ដោយ គ្មាន មូលដ្ឋាន ។ នេះ ហើយ ជា មូលហេតុ ដែល ធ្វើឲ្យ គាត់ ជាប់ បណ្តឹង រាប់ មិន អស់ នៅ តុលាការ កម្ពុជា ។
នៅ ស្រុក បារាំង ដែល ជា ប្រទេស ប្រជាធិបតេយ្យ ដ៏ ធំ មួយ សម រង្ស៉ី ភ្លេច ខ្លួន ថា ស្រុក បារាំង គេ មិន អាច និយាយ ចោទប្រកាន់ អ្នកណា ម្នាក់ ដោយ គ្មាន មូលដ្ឋាន បាន ទេ ជាពិសេស ការចោទប្រកាន់ រឿង សម្លាប់ មនុស្ស ដែល ជា រឿង ធ្ងន់ធ្ងរ បំផុត ។ ពេល ដែល គាត់ និយាយ ចោទ សម្តេច នាយក រដ្ឋមន្ត្រី ថា បាន សម្លាប់ លោក ហុក ឡង ឌី. ទណ្ឌិត សម រង្ស៉ី ប្រហែលជា ភ្លេច គិត ថា គាត់ មាន សញ្ជាតិ បារាំង ដែរ ដែល គេ អាច ប្តឹង គាត់ ទៅ តុលាការ បារាំង បាន ដូច ពាក្យ សុភាសិត ខ្មែរ ពោល ថា « កុក អាច ភ្លេច ជុង តែ ជុង មិន ដែល ភ្លេច កុក ទេ » ។
ឆ្លៀត ឱកាស នេះ រូប ខ្ញុំ ដែល គ្រាន់តែ ជា អ្នកតាមដាន នយោបាយ តុកាហ្វេ មួយ រូប តែ ខ្ញុំ អាច សន្និដ្ឋាន បាន ច្បាស់ ណាស់ ថា សម រង្ស៉ី ពិតជា នឹង ចាញ់ ក្តី មួយ នេះ ទាំងស្រុង ។ ហេតុ ដូច្នេះ គ្មាន ហេតុផល ណាមួយ ដែល សម្តេច ហ៊ុន សែន ប្តូរ ចិត្ត មិន ប្តឹង វិញ នោះ ឡើយ ។ ម៉្យាង វីញ ទៀត ពាក្យបណ្តឹង មួយ នេះ ដែល នឹង ធ្វើឲ្យ សម្តេច តេជោ ហ៊ុន សែន ឈ្នះ លើ គោក គឺ ពិតជា មាន អត្ថន័យ ធំ ធេង ចំពោះ សម្តេច នាយក រដ្ឋមន្ត្រី ហ៊ុន សែ ន៖
អត្ថន័យ ទី១៖ គឺជា ការព្រមាន ដល់ មនុស្ស មាត់ ដាច ដូច សម រង្ស៉ី ថា មាន មាត់ មិន មែន ចេះតែ និយាយ ចោទ គេ បាន តាមចិត្ត ឡើយ ទោះជា នៅក្នុង ប្រទេស បិតា ប្រជាធិបតេយ្យ ក៏ មិន អាច ធ្វើ ដូច្នេះ បាន ដែរ ពីព្រោះ វា ជា ការបំពាន សិទ្ធិ អ្នកដទៃ ។
អត្ថន័យ ទី២៖ ការសម្រេចចិត្ត របស់ តុលាការ បារាំង ដែល ឲ្យ សម រង្ស៉ី ចាញ់ ក្តី នឹង ក្លាយជា សារ ដ៏ សំខាន់ មួយ ដែល បញ្ជាក់ ប្រាប់ សាធារណៈ មតិ ជាតិ និង អន្តរជាតិ ថា សេចក្តីសម្រេច របស់ តុលាការ កម្ពុជា ដែល បាន ផ្តន្ទាទោស សម រង្ស៉ី កន្លងទៅ គឺជា សេចក្តីសម្រេច ត្រឹមត្រូវ ។
អត្ថន័យ ទី ៣៖ នៅលើ លោក នេះ យុត្តិធម៌ ពិតជា មាន ហើយ នីតិរដ្ឋ ក៏ ត្រូវតែ មាន ។ យុត្តិធម៌ និង នីតិរដ្ឋ ត្រូវ បែងចែក ដាច់ស្រឡះ ពី រឿង នយោបាយ ដោយ គ្មាន អ្នកណា អាច កាឡៃ បាន ឡើយ ។
ទាំងអស់ នេះ គឺជា សន្លឹក អាត់ ដែល សម្តេច ហ៊ុន សែន មាន នៅក្នុង ដៃ ។ ដូច្នេះ គ្មាន ការសង្ស័យ អ្វី ឡើយ អំពី សំណុំរឿង មួយ នេះ ដែល នឹង ត្រូវ ឡើង ដល់ តុលាការ បារាំង ក្នុង ពេល ដ៏ ខ្លី ខាងមុខ ដោយ គ្មាន ការប្រែប្រួល ឡើយ ។
ដូច្នេះ សូម ទណ្ឌិត សម រង្ស៉ី ឈប់ ស្រមើស្រមៃ ទៀត ចុះ ពាក់ព័ន្ធ នឹង បណ្តឹង មួយ នេះ ហើយ ម៉្យាង វីញ ទៀត បើ ម្សៀ រង្ស៉ី អាច ឈប់ និយាយ ប៉ ប៉ាច់ ប៉ប៉ោច ឥត បាន ការ ដោយសារតែ កាភ័យខ្លាច របស់ ខ្លួន បាន វា ជា ការ ល្អ ជាង ព្រោះ ការនិយាយ កាន់តែ ច្រើន កំហុស កាន់តែ ធំ ទោស កាន់តែ ធ្ងន់ ហើយ គុក ក៏ កាន់តែ នៅជិត ផ្ទះ ហើយ ដែរ ៕
ដោយ៖ អ្នកតាមដាន នយោបាយ តុកាហ្វេ អភិបាល ខេត្ត ព្រះវិហារ ជំរុញ ឲ្យ ក្រុមប្រឹក្សា ស្រុក ត្បែងមានជ័យ ដែល តែងតាំង ថ្មី ត្រូវ ខិតខំ បម្រើ ពលរដ្ឋ ដោយ ស្មើភាព យុត្តិធម៌ និង មិន ប្រកាន់ និន្នាការ នយោបាយ
( ព្រះវិហារ ) ៖ នៅក្នុង ពិធី ប្រកាស ចូលកាន់ មុខតំណែង ក្រុមប្រឹក្សា ស្រុក ត្បែងមានជ័យ ខេត្ត ព្រះវិហារ អាណត្តិ ទី៣ នៅ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ បាន ណែនាំឲ្យ ប្រធាន ក្រុមប្រឹក្សា សមាជិក ទាំងអស់ ត្រូវតែ ខិតខំ បម្រើ ផលប្រយោជន៍ ចូលរួម បំពេញ សេចក្តីត្រូវការ របស់ ប្រជាពលរដ្ឋ ដោយ ឈរ លើ ស្មារតី ស្មើភាព យុត្តិធម៌ មិន ប្រកាន់ ពូជសាសន៍ និង និន្នាការ នយោបាយ អ្វី នោះ ឡើយ ។
លោក អ៊ុន ចាន់ ដា បាន ថ្លែង ថា ក្នុង នាម ក្រុមប្រឹក្សា ខេត្ត និង គណៈ អភិបាល ខេត្ត លោក បាន សំដែង នូវ ការអបអរសាទរ កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមាជិក សមាជិកា ក្រុមប្រឹក្សា ស្រុក ត្បែងមានជ័យ ដែល ត្រូវបាន តំណាង ប្រជាពលរដ្ឋ គឺ សមាជិក ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ដែល ជា អង្គ បោះឆ្នោត បាន បោះឆ្នោត ផ្តល់ សេចក្តីទុកចិត្ត ដើម្បី បន្ត ដឹកនាំ ស្រុក ឱ្យ កាន់ រីកចម្រើន លើ គ្រប់ វិស័យ ថែម ទៀត ។
សូម បញ្ជាក់ ថា នៅ អាណត្តិ ទី៣នេះ ក្រុមប្រឹក្សា ត្បែងមានជ័យ ខេត្ត ព្រះវិហារ មាន ចំនួន ១១រូប ក្នុង នោះ លោក វ៉ា សាវ៉ាត ត្រូវបាន តែងតាំង ជា ប្រធាន ក្រុមប្រឹក្សា ស្រុក ៕
( កាប៊ុល) ៖ សមាជិក ក្រុម សកម្ម ប្រយុទ្ធ ដល់ ទៅ ជាង ១០០ នាក់ បាន ស្លាប់ ក្នុង ការប្រយុទ្ធ គ្នា យ៉ាង ក្តៅ គគុក អំឡុង ពេល ០៣ ថ្ងៃ កន្លងមក នេះ ខណៈ ដែល កងកម្លាំង រដ្ឋាភិបាល អាហ្វហ្គានីស្ថាន បាន បង្កើន យុទ្ធនាការ កម្ចាត់ ក្រុម ឧទ្ទាម តាលី បង់ ។ នេះ បើ តាម ការផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ល្ងាច ថ្ងៃចន្ទ ទី១៧ ខែមិថុនា ឆ្នាំ ២០១៩ ។
គួរ ជម្រាប ថា ទាំង ក្រុម ឧទ្ទាម តាលី បង់ និង កងកម្លាំង រដ្ឋាភិបាល សុទ្ធតែ បាន បង្កើន សកម្មភាព រៀង ៗ ក្នុង មួយ រយៈ ចុងក្រោយ នេះ នៅ ចំពោះមុខ កិច្ចប្រឹងប្រែង សំដៅ បញ្ចប់ វិបត្តិ ប្រដាប់អាវុធ ដែល នៅ អូសបន្លាយ ក្នុង ប្រទេស អាហ្វហ្គានីស្ថាន ៕ ម៉ាឡេស៉ី ចាប់អារម្មណ៍ វិនិយោគ លើ ការដាំដុះ ដំណាំ កសិកម្ម ការនាំចេញ អង្ករ និង សាងសង់ ផ្ទះ តម្លៃ សមរម្យ លើ ទឹកដី ខេត្ត ត្បូងឃ្មុំ
នា ឱកាស នោះ លោក ជា ម ច័ន្ទ សោភ័ណ បាន លើក បង្ហាញ ប្រាប់ ពី ស្ថានភាព ភូមិសាស្ត្រ ដ៏ ល្អ មាន លក្ខណៈ អំណោយផល ល្អ នូវ សក្តានុពល លើ វិស័យ នានា ពិសេស លើ វិស័យ កសិកម្ម និង កសិឧស្សាហកម្ម ដែល មាន ដំណាំ ស្រូវ កៅស៊ូ និង ម្រេច ។
លោក ថ្លែង ប្រាប់ បន្ត ថា ចំពោះ កម្រិត GDP របស់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ដែល មាន កំណើន គួរឲ្យ កត់សម្គាល់ បើ ប្រៀបធៀប ជាមួយ GDP ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ពិសេស ស្ថានភាព ទំហំ ពាណិជ្ជកម្ម ក្នុង ខេត្ត ដែល ផ្តល់ ភាពងាយស្រួល ច្រើន សម្រាប់ ការចរាចរណ៍ ព្រោះ ខេត្ត ត្បូងឃ្មុំ មាន ព្រំដែន ជាប់ ប្រទេស ជិតខាង មាន ច្រក ធំ ៗ ដល់ ទៅ ០៧ ច្រក ដែល ធ្វើឲ្យ មាន កំណើន សេដ្ឋកិច្ច យ៉ាង ឆាប់រហ័ស ។
ឆ្លើយតប នា ឱកាស នោះ លោក ជា ម ច័ន្ទ សោភ័ណ បាន ថ្លែង ទៀត ថា ខេត្ត ត្បូងឃ្មុំ សូមស្វាគមន៍ ចំពោះ ការវិនិយោគ នៅលើ ទឹកដី ខេត្ត ត្បូងឃ្មុំ ពីសំណាក់ ក្រុមហ៊ុន វិនិយោគទុន ម៉ាឡេស៉ី ពិសេស លើ ការសាងសង់ ផ្ទះ ស្នាក់ នៅ ដែល មាន តម្លៃ សមរម្យ សម្រាប់ ប្រជាពលរដ្ឋ គ្រប់ ស្រទាប់ វណ្ណៈ ក្នុង ខេត្ត ។ លោក អភិបាល ខេត្ត ក៏ បាន ជំរុញ ឲ្យ ខាង ម៉ាឡេស៉ី បង្កើន ទំនាក់ទំនង ផងដែរ ទៅ លើ វិស័យ ទេសចរណ៍ រវាង ប្រទេស កម្ពុជា និង ម៉ាឡេស៉ី ពិសេស ខេត្ត ត្បូងឃ្មុំ ។
ស្ថិត ក្នុង ឱកាស នោះ លោក ឯក អគ្គ រាជ ទូត ក៏ បាន គោរព អញ្ជើញ លោក បណ្ឌិត អភិបាល ខេត្ត និង ក្រុមការងារ ទៅ ទស្សនកិច្ច នៅ ប្រទេស ម៉ាឡេស៉ី ដើម្បី សិក្សា ស្វែងយល់ និង ផ្លាស់ប្តូរ បទពិសោធន៍ គ្នា ទៅ វិញ ទៅ មក ក្នុង គម្រោង ការអភិវឌ្ឍ លំនៅដ្ឋាន របស់ ក្រុមហ៊ុន ម៉ាឡេស៉ី នៅ ខេត្ត ត្បូងឃ្មុំ វិញ ផងដែរ ៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង កសិកម្ម៖ កម្ពុជា ពុំ ទាន់ ជួបប្រទះ បញ្ហា រហោស្ថានកម្ម នៅឡើយ នោះ ទេ មាន ត្រឹមតែ ការធ្លាក់ចុះ គុណភាព ដី មួយចំនួន
( កំពត ) ៖ លោក មាស ពិសិដ្ឋ អនុ រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខ ប្រមាញ់ និង នេសាទ និង ជា ជន បង្គោល នៃ អនុសញ្ញា សហ ប្រជាជាតិ ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង រហោស្ថានកម្ម និង ការធ្លាក់ចុះ គុណភាព ដី បាន អះអាង ថា សព្វ ថ្ងៃ នេះ កម្ពុជា ពុំ ទាន់ រងគ្រោះ ដោយសារ រហោស្ថាន នៅឡើយ នោះ ទេ តែ មាន បញ្ហា ធ្លាក់ចុះ គុណភាព ដី ដោយសារ ការប្រើប្រាស់ ដី ពុំ ត្រឹមត្រូវ និង ការបាត់បង់ ព្រៃឈើ ។
លោក មាស ពិសិដ្ឋ បាន បញ្ជាក់ បន្ថែម ថា ការធ្លាក់ចុះ គុណភាព ដី កើតឡើង ទូទាំង ប្រទេស សព្វ ថ្ងៃ ដែល ទាមទារ ឱ្យ មាន វិធានការ ដើម្បី ទប់ស្កាត់ និង ស្ដារ ឡើងវិញ នូវ គុណភាព ដី បើ ពុំ មាន វិធានការ ច្បាស់លាស់ នោះ វា នឹង បង្ករ ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ លើ ផល កសិកម្ម ។ ជា ដំណោះស្រាយ ក្រសួង កសិកម្ម ជា សេនាធិការ របស់ រដ្ឋាភិបាល កំពុង បង្កើត ក្រុមការងារ ដើម្បី បំពេញ ការងារ លើ យុទ្ធសាស្រ្ត សំខាន់ ចំនួន ២ ដើម្បី ទប់ស្កាត់ ការធ្លាក់ចុះ គុណភាព ដី ។
មន្រ្តី ជំនាញ នៃ ក្រសួង កសិកម្ម រូប នេះ បាន លើកឡើង ថា បច្ចុប្បន្នភាព កម្ពុជា ពុំ ទាន់ រងគ្រោះ ដោយសារ រហោ ស្ថាកម្ម នោះ ទេ ដោយ មាន តែ បញ្ហា ធ្លាក់ចុះ នូវ គុណភាព ដី តាម តំបន់ មួយចំនួន ប៉ុណ្ណោះ ដោយសារតែ មាន ការប្រើប្រាស់ ដី ពុំ ត្រឹមត្រូវ និង ហួស កម្រិត ។
បន្ថែម ពី នេះ លោក ម៉ម អំណត់ ក៏ បាន លើកឡើង ដែរ ថា រហោស្ថានកម្ម ឬ ការធ្លាក់ចុះ គុណភាព ដី ដែល នាំឱ្យ មាន ការថយចុះ ឬ បាត់បង់ ភាព សេដ្ឋកិច្ច នៃ ដី ស្រែ ចម្ការ វាល ស្មៅ និង ព្រៃឈើ តែងតែ កើតឡើង ដោយសារ ការ បាត់បង់ ព្រៃឈើ និង ប្រព័ន្ធ បរិស្ថាន ព្រៃឈើ ការធ្វើ សកម្មភាព លើស កំណត់ ឬ លើស សមត្ថភាព របស់ ដី ការដាំ ដំណាំ តែ មួយ មុខ ការប្រើ ជី និង ថ្នាំ កសិកម្ម លើស កម្រិត ឬ មិន ត្រឹមត្រូវ តាម បច្ចេកទេស និង កត្តា ធម្មជាតិ នានា ជាពិសេស គឺ ការប្រែប្រួល អាកាសធាតុ ។
លោក បាន បន្ត ថា បញ្ហា ទាំងនេះ បាន ទាញ នូវ ចំណាប់អារម្មណ៍ ជា សាកល ជាពិសេស របស់ សហគមន៍ ជាតិ និង អន្តរជាតិ ចំពោះ ផល ប៉ះពាល់ លើ ផ្នែក សេដ្ឋកិច្ច សង្គម និង បរិស្ថាន ដែល ធ្វើឱ្យ មនុស្សជាតិ នៅលើ ពិភពលោក ប្រមាណ ជាង ២៥០ លាន នាក់ បាន នឹង កំពុង ទទួលរង នូវ ផល ប៉ះពាល់ នេះ ។ ជាក់ស្តែង កម្ពុជា ក៏ ទទួលរងគ្រោះ ផងដែរ ពី ការប្រែប្រួល អាកាសធាតុ ដូចជា ការកើន កម្តៅ គ្រោះ រាំងស្ងួត និង ខ្យល់ព្យុះ ដែល កំពុងតែ ជួបប្រទះ កាន់តែ ច្រើន ឡើង នា ពេល បច្ចុប្បន្ន នេះ ។
លោក ម៉ម អំណត់ បាន បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ យើង ទទួលស្គាល់ ថា រហោស្ថានកម្ម ឬ ការធ្លាក់ចុះ គុណភាព ដី មិន ទាន់ ត្រូវបាន ពិភពលោក យកចិត្តទុកដាក់ ឱ្យ បាន គ្រប់គ្រាន់ នៅឡើយ ទេ ទោះបីជា អ្នកវិទ្យាសាស្ត្រ និង ប្រទេស ជាច្រើន បាន អះអាង ថា មនុស្សជាតិ អាច ទប់ ស្ងាត់ ឬ ប្រយុទ្ធ ប្រឆាំង នឹង បញ្ហា នោះ បាន ។ ជាពិសេស តាមរយៈ ការពង្រឹង ការចូលរួម របស់ សហគមន៍ និង ការធ្វើ កិច្ចសហប្រតិបត្តិការ នៅ គ្រប់ កម្រិត ក៏ដោយ ។
ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន នាំមក នូវ សន្តិភាព ស្ថេរភាព នយោបាយ សន្តិសុខ សង្គម ល្អ ប្រសើរ និយាយ ជា រួម និង និយាយ ដោយឡែក សម្រាប់ ទឹកដី ខេត្ត កំពត មាន ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ រួម មាន៖ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ រូបវ័ន្ត ស្ពាន ផ្លូវ សាលារៀន មន្ទីរពេទ្រ វត្តអារ៉ាម ពិសេស ការកែលម្អ សោភ័ណភាព ក្រុង និង ទីប្រជុំជន ។
( មណ្ឌលគិរី ) ៖ លោក ងី ចន្ទ្រ ផល រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ បាន ក្រើន រំលឹក ដល់ មន្ត្រីរាជការ ថ្នាក់ នៅក្រោម ជាតិ ឲ្យ បន្ត ខិតខំ អនុវត្ត លើ កិច្ចការ ភូមិ - ឃុំ មាន សុវត្ថិភាព បង្ក្រាប និង ទប់ស្កាត់ បទល្មើស ផ្សេង ៗ ដើម្បី រក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ ឲ្យបាន ល្អ ប្រសើរ ជូន ប្រជាពលរដ្ឋ ។
ថ្លែង បែប នេះ ក្នុង ឱកាស ដែល លោក អញ្ជើញ ជា អធិបតីភាព ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខេត្ត ចំនួន ១៥រូប ដោយ មាន ការចូលរួម ពិសំណាក់ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូល សដ្ឋាន ខេត្ត ព្រមទាំង លោក លោកស្រី ប្រធាន មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត បាន ប្រព្រឹត្តទៅ សាលា ខេត្ត មណ្ឌលគិរី នា ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ ។
ក្រុមការងារ ចុះ មូលដ្ឋាន ត្រូវ យកចិត្តទុកដាក់ សម្របសម្រួល រៀបចំ វេទិកា សាធារណៈ ដើម្បី ផ្តល់ ឱកាស ដល់ ប្រជាពលរដ្ឋ មតិ និង លើកឡើង នូវ បញ្ហា ប្រឈម នានា ដើម្បី រួមគ្នា ដោះស្រាយ បញ្ហា ទាំងនោះ ក្នុង មូលដ្ឋាន ជូន ប្រជាពលរដ្ឋ ។
លោក ស្វាយ សំអ៊ាង បាន ថ្លែង ថា ការប្រកាស ចូលកាន់ មុខ តំណែង របស់ ក្រុមប្រឹក្សា ខេត្ត សម្រាប់ អាណត្តិ ទី៣ នេះ មាន សារសំខាន់ ដើម្បី ក្រុមប្រឹក្សា បន្ត សុពលភាព និង បន្ត ដឹកនាំ ការងារ នៅក្នុង អាណត្តិ ថ្មី របស់ ខ្លួន នៅក្នុង រដ្ឋបាល ខេត្ត បន្ត ទៀត ។
អភិបាល ខេត្ត ព្រះសីហនុ ចុះ ពិនិត្យ រោងចក្រ បំលែង កាកសំណល់ ផេះ ធ្យូងថ្ម ដែល បង្ក ក្តីកង្វល់ ដល់ សុខភាព របស់ ប្រជាពលរដ្ឋ
( ព្រះសីហនុ) ៖ អភិបាល ខេត្ត ព្រះសីហនុ លោក យន្ត មីន នៅ ថ្ងៃចន្ទ ទី១៧ ខែមិថុនា នេះ បាន ដឹកនាំ មន្ត្រី ស្ថាប័ន ជំនាញ ចុះ ពិនិត្យ ទីតាំង រោងចក្រ បំលែង កាកសំណល់ ផេះ ធ្យូងថ្ម « ស៊ីម៉ាវ » មាន ទីតាំង នៅ ក្រុម ទី៤ ភូមិ ២ ឃុំ អូរ ត្រះ ស្រុក ស្ទឹង ហាវ ខេត្ត ព្រះសីហនុ ។
ការចុះ ពិនិត្យ នេះ ធ្វើឡើង បន្ទាប់ពី ប្រជាពលរដ្ឋ ៤២ គ្រួសារ មាន ផ្ទះ រស់ នៅ ជុំវិញ រោងចក្រ បំលែង កាកសំណល់ ផេះ ធ្យូងថ្ម « ស៊ីម៉ាវ » ខាងលើ នេះ រអ៊ូរទាំ និង ព្រួយបារម្ភ ពី បញ្ហា សុខភាព ដែល បង្កឡើង ដោយ ធូលី ផេះភាយ ចេញ ចេញ ពី រោងចក្រ ។
លោក យន្ត មីន បាន ឱ្យដឹង ថា រោងចក្រ ខាងលើ មាន ច្បាប់ អនុញ្ញាត ត្រឹមត្រូវ ពី ក្រសួង ក៏ប៉ុន្តែ បច្ចុប្បន្ន មាន ផល ប៉ះពាល់ ដល់ ប្រជាពលរដ្ឋ រស់ នៅ ជុំវិញ រោងចក្រ នោះ និង បង្ក ផល ប៉ះពាល់ ដល់ បរិស្ថាន និង សុខ មាលភាព ប្រជាពលរដ្ឋ រស់ នៅ ជុំវិញ ។
ទោះជា យ៉ាង នេះ ក្តី លោក យន្ត មីន អះអាង ថា បើ តាម ការចុះ ពិនិត្យ ផ្ទាល់ របស់ ក្រុមការងារ ជំនាញ ពិនិត្យ ឃើញ ថា រោងចក្រ មិន បង្ក ផល ប៉ះពាល់ អាក្រក់ ពេក ទេ ដល់ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ។ លោក អភិបាល ខេត្ត ពន្យល់ ថា ផេះ ដែល យក ចេញមក ពី រោងចក្រ អគ្គិសនី ធ្យូងថ្ម គឺ យក ចេញ ដើម្បី កែច្នៃ ជា ប្រយោជន៍ សម្រាប់ យក ទៅ ផ្គត់ផ្គង់ ឱ្យ រោងចក្រ ក្រឡុក បេតុង ឬ ក្រឡុក ស៊ីម៉ង់ត៍ ។
លោក យន្ត មីន បាន ពន្យល់ ថា ជា ដំណោះស្រាយ ក្រុមការងារ បាន ឯកភាព ឱ្យ រោងចក្រ ខាងលើ នេះ កែលម្អ លក្ខណ : បច្ចេកទេស ធ្វើ យ៉ាងណា កុំ ឱ្យ មាន ផេះ ហុយ មក លើ ផ្ទះ បងប្អូន ប្រជាពលរដ្ឋ ជា បន្ត ទៀត និង កាត់បន្ថយ ផល ប៉ះពាល់ និង ការពារ បរិស្ថាន ឱ្យ បាន ល្អ ។
« ការងារ នេះ រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន ទុក រយ: ពេល ២ ឬ ៣ខែ បន្ត ទៀត ដើម្បីឱ្យ រោងចក្រ បំលែង ធ្យូង នេះ ធ្វើ ការកែលម្អ រោងចក្រ របស់ ខ្លួន ។ តែ ប្រសិនបើ រោងចក្រ មិន អនុវត្ត តាម ការណែនាំ របស់ ក្រុមការងារ នៃ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ទេ នឹង ត្រូវ បញ្ឈប់ ដំណើរការ ឬ ក្រុមហ៊ុន រក ទីតាំង ថ្មី ដែល នៅ ឆ្ងាយ ពី ផ្ទះ របស់ ប្រជាពលរដ្ឋ កំពុង រស់ នៅ » ។ នេះ ជា ការព្រមាន របស់ អភិបាល ខេត្ត ព្រះសីហនុ ។
លោក អភិបាល ខេត្ត បន្ត ថា « បើសិនជា ម្ចាស់ រោងចក្រ បំលែង ធ្យូងថ្ម បេះ គាត់ ធ្វើ ការកែលម្អ រោងចកហរ មាន បរិស្ថាន បាន ល្អ រដ្ឋបាល ខេត្ត នឹង ឱ្យ គាត់ បន្ត អាជីវកម្ម ជា បន្ត ទៀត ។ ព្រោះ ដំណោះស្រាយ គឺ យើង ធ្វើ ដើម្បី ឈ្នះ ឈ្នះ ទាំងអស់ គ្នា ។ មាន ន័យ ថា អ្នក វិនិយោគ ក៏ ទទួលបាន ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ក៏ ទទួលបាន ការងារ ពី ការធ្វើ វិនិយោគ ។ ព្រោះថា ក្រុមហ៊ុន ក៏ បាន បង់ ពន្ធ ចូល ថវិកា រដ្ឋ ហើយ ប្រជាពលរដ្ឋ ក៏ មាន ការងារ ធ្វើ ទទួលបាន ផលប្រយោជន៍ ឱ្យ គ្នា ទៅ វិញ ទៅ មក ដែរ » ។
យ៉ាងណា ក៏ដោយ ចុះ លោក យន្ត មីន បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ សូម មាន ការយោគយល់ បើ មិន មាន ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ទេ ត្រូវ ចេះ យោគយល់ ព្រោះ ប្រជាពលរដ្ឋ ក៏ ទទួលបាន ផលប្រយោជន៍ ពី ការវិនិយោគ និង ទទួលបាន ការងារ ផងដែរ ។
ចំណែក លោក Chen Song អ្នកគ្រប់គ្រង រោងចក្រ កែច្នៃ កាកសំណល់ ធ្យូងថ្ម បាន ឲ្យដឹង ដែរ ថា បច្ចុប្បន្ន រោងចក្រ របស់ លោក ធ្វើ ការសម្ងួត កាកសំណល់ ពី រោងចក្រ ធ្យូងថ្ម ដើម្បី យក ទៅ ផ្គត់ផ្គង់ ដល់ រោងចក្រ ក្រឡុក ស៊ីម៉ង់ត៍ ដោយ ក្នុង មួយ ថ្ងៃ ៗ មាន ចំនួន ១០០តោន ។ លោក ក៏ បាន សន្យា ថា និង កែលម្អ បរិស្ថាន នៅក្នុង រោងចក្រ កុំ ឱ្យ មាន ធូលី ហុយ ចេញមក ក្រៅ រោងចក្រ បន្ត ទៀត ទេ នា ថ្ងៃ ខាងមុខ ដើម្បី កុំ ឱ្យ បង្ក ផល ប៉ះពាល់ ដល់ ប្រជាពលរដ្ឋ ។
ប្រកាស សមាស សភាព ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ស្រុក សង្កែ ខេត្ត បាត់ដំបង . មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ ណែនាំឲ្យ ក្រុមការងារ ដើម្បី ក្តាប់ រាល់ បញ្ហា ប្រឈម និង ដោះស្រាយ ជូន ពលរដ្ឋ
( បាត់ដំបង ) ៖ នា រសៀល ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ លោក កុល វីរក្ស រដ្ឋលេខាធិការ ធិកា ក្រសួង មហាផ្ទៃ ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ស្រុក សង្កែ ខេត្ត បាត់ដំបង បាន អញ្ជើញ ប្រកាស សមាស សភាព ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ក្នុង ស្រុក សង្កែ ដើម្បី ត្រួតពិនិត្យ និង គាំទ្រ ការអនុវត្ត គោល នយោបាយ និង យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៤
របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ សាលា ស្រុក សង្កែ ដោយ មាន ការចូលរួម ពី អស់ លោក ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ នានា និង មន្រ្តី រាជការ រដ្ឋបាល ក្នុង ស្រុក សង្កែ ខេត្ត បាត់ដំបង ចូលរួម ផងដែរ ។
លោក កុល វីរក្ស បាន លើកឡើង ថា ក្រុមការងារ ថ្នាក់ ជាតិ នេះ មិន មាន ពាក់ព័ន្ធ ជាមួយ ក្រុមការងារ ផ្សេង ៗ នោះ ទេ គឺ ជួយ កិច្ចការ មួយចំនួន របស់ រាជ រដ្ឋាភិបាល ដោយ អាច ចុះ ធ្វើ សកម្មភាព រាល់ ថ្ងៃ ក្នុង ម៉ោង រដ្ឋបាល រាល់ ថ្ងៃ បាន ដើម្បី ជួយ ត្រួតពិនិត្យមើល ភាព កង្វះខាត និង សំណូមពរ របស់ ពលរដ្ឋ យើង ដែល បាន ជួបប្រទះ បញ្ហា ប្រឈម នានា នៅក្នុង មូល ដ្ឋាន ពិសេស ស្រុក សង្កែ ដែល មាន ឃុំ ទាំង ១០ផង គ្រាន់តែ ខុសពី ក្រុមការងារ គណបក្ស ចុះ ជួយ មូលដ្ឋាន បាន តែ ក្នុង ថ្ងៃ សម្រាក គឺ ថ្ងៃសៅរ៍ និង ថ្ងៃអាទិត្យ ។
លោក រដ្ឋលេខាធិការ បាន បន្ត ថា តួនាទី ក្រុមការងារ នេះ ក្រៅពី បាន អនុវត្ត ការងារ របស់ ខ្លួន ហើយ ក្រុមការងារ យើង ដែល បាន បង្កើត ហើយ នេះ ត្រូវ ចុះ ធ្វើ វេទិកា សាធារណ: ជាមួយ ប្រជាពលរដ្ឋ ដើម្បី ក្តាប់ ឲ្យបាន នូវ រាល់ បញ្ហា ប្រឈម ផ្សេង ៗ ទុក្ខ កង្វល់ តម្រូវការ និង សំណូមពរ របស់ ប្រជាពលរដ្ឋ ដោយ មិន ពាក់ព័ន្ធ ជាមួយ ការងារ រដ្ឋបាល ស្រុក ឃុំ សង្កាត់ នោះ ទេ ។
លោក កុល វីរក្ស បាន បញ្ជាក់ ថា បន្ទាប់ពី បាន ចុះ ធ្វើ កិច្ចការ នេះ ហើយ ក្រុមការងារ យើង ក៏ ត្រូវ ជួបប្រជុំ ផ្ទៃក្នុង ដើម្បី ធ្វើ ការដោះស្រាយ និង ទទួល លទ្ធផល មកវិញ សម្រាប់ ជា បទពិសោធន៍ ការងារ យើង ទាំងអស់ គ្នា ដែល ជា ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ដើម្បី ឆ្លុះបញ្ចាំង ការត្រួតពិនិត្យ និង គាំទ្រ ការអនុវត្ត កម្មវិធី នយោបាយ និង យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៦ឲ្យ ការងារ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ ប្រកបដោយ អភិវឌ្ឍន៍ មូលដ្ឋាន និង ជាតិ ទាំងមូល ផងដែរ ។
លោក ប្រធាន ក្រុមការងារ បាន ផ្តាំផ្ញើ ដល់ ក្រុមការងារ ដែល ទើប ប្រកាស ថ្មី នា ពេលនេះ ក្រោយ បាន ទទួល សេចក្តីសម្រេច ហើយ ត្រូវ ត្រៀមខ្លួន ចុះ ធ្វើ សកម្មភាព ជួយ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ខ្លួន ទទួលខុសត្រូវ ដែល កំពុង ជួប ការលំបាក និង ត្រូវ បំរើ ពួកគាត់ ឲ្យបាន ល្អ គ្រប់ កាល : ទេស : និង គ្រប់ ទីកន្លែង ផងដែរ ៕ ឧកញ៉ា ម្នាក់ ប្ដឹង លោក ស៊ុន លៀង ហេង មន្ត្រី អាជ្ញា សាលា រាជធានី ទៅ ក្រសួង យុត្តិធ ម៏ និង ACU បន្ថែម បន្ទាប់ ព្យាយាម អនុវត្ត សំណុំរឿង ក្លែងក្លាយ ដែល កំពុង ជាប់ បណ្តឹង នៅ អយ្យការ
មិន តែ ប៉ុណ្ណោះ នៅ ពេល ដែល មន្ត្រី អាជ្ញា សាលា នៅតែ ព្យាយាម អនុវត្ត សំណុំរឿង ក្លែងក្លាយ បន្ត នៅ ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ជនរងគ្រោះ បាន ដាក់ ពាក្យបណ្ដឹង ទៅ ស្ថាប័ន ២ បន្ថែម ទៀត គឺ ប្ដឹង ទៅ ក្រសួង យុត្តិធម៌ និង អង្គភាព ប្រឆាំង អំពើពុករលួយ (ACU) ។
សូម រំលឹក ផងដែរ ជុំវិញ ការចុះអនុវត្ត ដោយ បង្កើត សំណុំរឿង ក្លែងក្លាយ ដើម្បី រឹបអូស ផ្ទះ ជនរងគ្រោះ ពីសំណាក់ មន្ត្រី អាជ្ញា សាលា ខាងលើ អាជ្ញា រូប នេះ ធ្លាប់ បាន រង បណ្ដឹង ពី ជនរងគ្រោះ ម្ដង រួច មកហើយ ដែល កាល ណោះ ជនរងគ្រោះ បាន ដាក់ពាក្យបណ្ដឹង កាលពី ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០១៩ ទៅ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
ខ្លឹមសារ នៃ ពាក្យបណ្ដឹង លោក យិន សុវណ្ណី បាន ប្ដឹង អាជ្ញា សាលា នៅ សាល ដំបូង រាជធានី ភ្នំពេញ ឈ្មោះ ស៊ុន លៀង ហេង ពី បទ ព្រហ្មទណ្ឌ ដោយ ចោទ ថា អាជ្ញា សាលា រូប នេះ បង្កើត សំណុំរឿង ក្លែងក្លាយ ដើម្បី រឹបអូស ផ្ទះ របស់ ខ្លួន ។
ការផ្អាក ចុះ អនុវត្តន៍ មិន បាន ប៉ុន្មាន ផង ស្រាប់តែ អាជ្ញា សាលា ឈ្មោះ ស៊ុន លៀង ហេង បាន ចេញ ផែនការជា លើក ទី២ម្ដង ទៀត ដោយ គ្រោង ចុះ អនុវត្ត នៅ ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០១៩ វេលា ម៉ោង ៨ និង ៣០នាទី ព្រឹក ខាងមុខ នេះ ម្ដង ទៀត ។ ជុំវិញ ការគ្រោង ចុះ អនុវត្ត ជា លើក ទី២នេះ លោក យិន សុវណ្ណី បាន ប្ដឹង អាជ្ញា សាលា បន្ថែម ២ស្ថាប័ន ទៀត គឺ ប្ដឹង ទៅ ក្រសួង យុត្តិធម៌ និង អង្គភាព ប្រឆាំង អំពើពុករលួយ តែម្ដង ។
ជន មិន ស្គាល់ អត្តសញ្ញាណ គាស់ ផ្ទះ ប្រជាពលរដ្ឋ យក អស់ ទ្រព្យសម្បត្តិ មួយចំនួន នៅ ក្រុង បាត់ដំបង
( បាត់ដំបង ) ៖ ជន មិន ស្គាល់ អត្តសញ្ញាណ មួយ ក្រុម បាន ធ្វើ សកម្មភាព គាស់ ផ្ទះ ប្រជាពលរដ្ឋ យក អស់ ទ្រព្យសម្បត្តិ មួយ នៅ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ ស្ថិត នៅ ចំណុច ភូមិ អង់ សង្កាត់ អូរ ចារ ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង ។
លោក ឈឿង គឹម សុង នាយ ការិយាល័យ ព្រហ្មទណ្ឌ កំរិត ស្រាល នៃ ស្នងការ នគរបាល ខេត្ត ជនសង្ស័យ មិន ស្គាល់ អត្តសញ្ញាណ បាន ធ្វើ សកម្មភាព គាស់ ទ្វារ ផ្ទះ និង ទ្វារ បន្ទប់ របស់ ជនរងគ្រោះ ឈ្មោះ រត្ន័ សុគួន ភេទ ស្រី អាយុ ៤៥ ឆ្នាំ មាន ទីលំនៅ ខាងលើ ខណៈ ដែល ជនរងគ្រោះ មិន នៅ ផ្ទះ ដោយ យក បាន សម្ភារ បាត់បង់ មួយចំនួន រួម មាន ខ្សែក ផ្លាទីន ចំនួន ០២ ខ្សែ . ជញ្ជៀន ចំនួន ០៣ វង់ . បន្តោង ខ្សែក ផ្លាទីន មួយ ខ្សែ . ប៉ុស្តិ៍ ផ្សារ ដែក មួយ . ម៉ូទ័រ កាត់ ដែក មួយ និង ម៉ូទ័រ ស្វាន ដែក មួយ ។
គួរ បញ្ជាក់ ថា ពិព័រណ៍ អាកាសចរណ៍ អន្តរជាតិ នៅ ទីក្រុង ប៉ារីស នៃ ប្រទេស បារាំង នឹង ប្រារព្ធ ឡើង រហូតដល់ ថ្ងៃទី ២៣ ខែមិថុនា នេះ ដោយ មាន បណ្តា ក្រុមហ៊ុន ធំ ៗ នៅ ទូទាំង ពិភពលោក ចូលរួម បង្ហាញ សមិទ្ធផល ថ្មី លើ វិស័យ ឧស្សាហកម្ម នេះ ។ ជុំវិញ ព្រឹត្តិការណ៍ នេះ Boeing បាន ក្លាយជា មុខ ព្រួញ សំខាន់ ជាង គេ ព្រោះ ក្រោយ ហេតុការណ៍ ធ្លាក់ យន្តហោះ 737 MAX ទាំង ពីរ ករណី បាន បង្ខំ ឲ្យ យន្តហោះ ប្រភេទ នេះ ត្រូវ ផ្អាក ការធ្វើចរាចរណ៍ នៅ ទូទាំង ពិភពលោក ។
