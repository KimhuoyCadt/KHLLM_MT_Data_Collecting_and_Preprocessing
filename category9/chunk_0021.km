( ត្បូងឃ្មុំ ) ៖ មន្ទីរ ទេសចរណ៍ ខេត្ត ក្រចេះ ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត កំពង់ចាម នា ព្រឹក ថ្ងៃទី ០៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ បាន បើក កិច្ចប្រជុំ បច្ចេកទេស ដ៏ សំខាន់ មួយ ដើម្បី ពិភាក្សា លើ ការរៀបចំ កញ្ចប់ ទស្សនកិច្ចពិសេស សម្រាប់ ភ្ញៀវ ទេសចរ សិស្ស និស្សិត មាន ឱកាស ទស្សនា សិក្សា និង ស្វែងយល់ ពី វប្បធម៌ និង ធម្មជាតិ នៅ តាម គោលដៅ ទេសចរណ៍ ក្នុង ខេត្ត ជាប់ គ្នា ទាំង៣ ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្រោម វត្តមាន លោក ជួប រតនា ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ក្រចេះ លោក អឿន រិទ្ធ ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ត្បូងឃ្មុំ និង លោក ស៊ាន សុគន្ធ ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត កំពង់ចាម នៅ មន្ទីរ ទេសចរណ៍ ខេត្ត ត្បូងឃ្មុំ ។
លោក ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ទាំង៣ បាន បញ្ជាក់ ថា ការរៀបចំ កញ្ចប់ ទស្ស កិច្ច ទេសចរណ៍ នេះ នឹង ផ្តល់ ឱកាស ឱ្យ យុវជន ជាពិសេស សិស្សានុសិស្ស តាម វិទ្យាល័យ និង មហាវិទ្យាល័យ មាន ឱកាស រៀនសូត្រ ស្វែងយល់ ពី ទឹកដី កំណេីត របស់ ខ្លួន សំដៅ បណ្តុះ គំនិត ស្នេហាជាតិ មាតុភូមិ មាន ឆន្ទៈ មោះ មុត ក្នុង ការកសាង ជាតិ មាតុភូមិ តាមរយៈ ការយល់ដឹង ពី ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ។
សូម បញ្ជាក់ ថា ការរៀបចំ កញ្ចប់ ទស្សនកិច្ច ទេសចរណ៍ នេះ គឺជា ផ្តួចផ្តើម ដំបូង ក្នុង វិស័យ ទេសចរណ៍ ដោយ រៀបចំ កម្មវិធី ទស្សនកិច្ច ថ្មី រយៈពេល ៣ ថ្ងៃ២យប់ ដោយ ទស្សនា នៅ ខេត្ត កំពង់ចាម រយៈពេល ១ ថ្ងៃ ត្បូងឃ្មុំ រយៈពេល ១ ថ្ងៃ និង ក្រចេះ រយៈពេល ១ ថ្ងៃ ដែរ ដោយ មាន ទាំង ការទស្សនា និង ការសិក្សា លើ ផ្នែក វប្បធម៌ ប្រវត្តិសាស្ត្រ ធម្មជាតិ អេកូ ទេសចរណ៍ និង ជីវភាព ប្រជាជន ក្នុង ខេត្ត ទាំង៣៕
អគ្គ នាយក ធនាគារ អភិវឌ្ឍន៍ ជនបទ ស្នើឲ្យ បញ្ចូល ការពង្រឹង សមត្ថភាព សហគមន៍ កសិកម្ម នៅ កម្ពុជា ក្នុង គម្រោង កែលម្អ ហេដ្ឋារចនាសម្ព័ន្ធ នៃ សង្វាក់ តម្លៃ កសិកម្ម
លោក កៅ ថា ច បាន ធ្វើការ ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល នានា ដែល ភាគី ADB បាន រួមចំណែក គាំទ្រ ក្នុង ការអភិវឌ្ឍ សង្គម និង សេដ្ឋកិច្ច កម្ពុជា តាមរយៈ កិច្ចសហប្រតិបត្តិការ សម្រាប់ គម្រោង នានា នៅ កម្ពុជា និង ជាពិសេស ជាមួយ ធនាគារ អភិវឌ្ឍន៍ ជនបទ ។
លោក ក៏ បាន គូស រំលេច និង ចែករំលែក បទពិសោធន៍ នៃ ការបំពេញ ការងារ របស់ ធនាគារ អភិវឌ្ឍន៍ ជនបទ ជូន ដល់ ភាគី តំណាង ធនាគារ អភិវឌ្ឍន៍ អាស៊ី អំពី ការអនុវត្ត គម្រោង រាជ រដ្ឋាភិបាល និង គម្រោង អភិវឌ្ឍន៍ នានា ក្នុង វិស័យ ស្រូវ - អង្ករ អនុ វិស័យ កសិកម្ម ផ្សេង ៗ ដូចជា ការចិញ្ចឹម សត្វ និង ការលើក កំពស់ ការ ដំណាំ បន្លែ សុវត្ថិភាព គ្មាន ជាតិ គីមី ជាដើម ជាមួយ ប្រជាកសិករ សហគមន៍ កសិកម្ម ព្រមទាំង ការអនុវត្ត ជាធនាគារ ឌីជីថល ក្នុង គោលដៅ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម នៅ ប្រទេស កម្ពុជា ។
លោក បាន លើកឡើង ថា តាមរយៈ ការអនុវត្ត គម្រោង ទាំងនេះ ធនាគារ អភិវឌ្ឍន៍ ជនបទ បាន ផ្តល់ សេវា ហិរញ្ញវត្ថុ គាំទ្រ ដល់ ខ្សែ ច្រវាក់ ផលិតកម្ម ទាំងមូល ពី ការផលិត ដល់ ការនាំចេញ ជាមួយនឹង យន្តការ គម្រោង ផ្សេង ៗ ជាច្រើន ដើម្បី បំពេញ កង្វះខាត ខាង តម្រូវការ និង ការផ្គត់ផ្គង់ ហិរញ្ញវត្ថុ ។
ទន្ទឹម នេះ លោក អគ្គ នាយក បាន ស្នើ ឱ្យ ភាគី ធនាគារ អភិវឌ្ឍន៍ អាស៊ី បញ្ចូល ការពង្រឹង សមត្ថភាព សហគមន៍ កសិកម្ម នៅ កម្ពុជា ក្នុង សមាសភាគ គម្រោង កែលម្អ ហេដ្ឋារចនាសម្ព័ន្ធ នៃ សង្វាក់ តម្លៃ កសិកម្ម -AVIP ផងដែរ ៕
ឯកសារ បើក កកាយ ការលូក ដៃ របស់ បរទេស ក្នុង ការជួយ ទាហាន ខ្មែរ ក្រហម និង ចលនា រណប ២ទៀត ឲ្យ មាន ដង្ហើម រស់ ដើម្បី អូសបន្លាយ សង្គ្រាម នៅ កម្ពុជា អស់ រយៈពេល ជាង ១០ ឆ្នាំ និង ធ្វើឲ្យ ជីវិត ពលរដ្ឋ ខ្មែរ រាប់ សែន នាក់ ត្រូវបាត់បង់ ដោយសារ សង្គ្រាម នេះ គឺ ពួក បរទេស និង បណ្ដា ប្រទេស ជា សមាជិក អាស៊ាន នា សម័យ នោះ មួយចំនួន បាន លើក យក ហេតុផល ថា ដើម្បី បណ្ដេញ កងទ័ព វៀតណាម ដែល ចូលមក ឈ្លានពាន កម្ពុជា តាមពិត គឺ ពួកគេ មាន គោលដៅ ដើម្បី សង្គ្រោះ របប ខ្មែរ ក្រហម ឲ្យ រស់ ឡើងវិញ តែ ប៉ុណ្ណោះ ។
អតីត នាយក រដ្ឋមន្រ្តី សិង្ហបុរី លី ក្វាន់ យូ បាន សង្កត់ធ្ងន់ ថា « មិន គួរ មាន អ្វី ទៅ រារាំង ការវាយប្រហារ របស់ ខ្មែរ ក្រហម ទៅ លើ ទ័ព វៀតណាម ឡើយ » ។
លោក អតីត នាយក រដ្ឋមន្រ្តី បាន ប្រាប់ អ៉ិន តាំ ទៀត ថា កិច្ចប្រជុំ នៃ រាជ រដ្ឋាភិបាល ចម្រុះ មិន គួរ ធ្វើឡើង នាទីក្រុង ប៉េកាំង ប្រទេស ចិន ទេ ព្រោះ លទ្ធផល មិន អាច ត្រូវបាន ទទួលស្គាល់ ដោយ អន្តរជាតិ ។ លោក លី ក្វាន់ យូ បាន ស្នើឲ្យ កិច្ចប្រជុំ ធ្វើឡើង នៅ ទីក្រុង អព្យា ក្រិត្យ ដូចជា នៅ ប៉ារីស ឫ បុរី ញូវយ៉ក ។ ប្រសិនបើ ទីតាំង ខាងលើ នេះ ពិបាក សម្រាប់ គូរ ភាគី ទាំងអស់ សិង្ហបុរី និង ផ្តល់ ទីតាំង ដ៏ សមរម្យ មួយ ។
ខាងក្រោម នេះ ជា ឯកសារ ប្រវត្តិសាស្រ្ត ដែល ត្រូវបាន គេ ទម្លាយ ចេញ ពាក់ព័ន្ធ បណ្ដា ប្រទេស មួយចំនួន ដែល នាំគ្នា ជួយ ប្រោស របប ខ្មែរ ក្រហម ឡើងវិញ បន្ទាប់ពី កងទ័ព វៀតណាម និង កងទ័ព រណសិរ្យ សាមគ្គី សង្គ្រោះ ជាតិ កម្ពុជា វាយ ផ្តួលរំលំនៅ ដើម ឆ្នាំ ១៩៧៩៖
មន្ត្រី សាខា កាំ កុងត្រូល ខេត្ត ព្រៃវែង ចុះ ត្រួតពិនិត្យ ផលិតផល ម្ហូប អាហារ ( នំបញ្ចុក ) នៅ ផ្សារ អ្នកលឿង ដើម្បី រក សារធាតុ គីមី ហាមឃាត់
( ព្រៃវែង ) ៖ នៅ ថ្ងៃទី ០៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត ព្រៃវែង ដឹកនាំ ដោយ លោក អ៊ុត សុភាព ដោយ មាន ការចូលរួម សហការ ពី មន្រ្តី មន្ទីរ ពាណិជ្ជកម្ម អាជ្ញាធរដែនដី និង គណៈកម្មការ ផ្សារ បាន ចុះ ត្រួតពិនិត្យ ផលិតផល ម្ហូប អាហារ ជាពិសេស ផលិតផល នំបញ្ចុក ដែល ដាក់តាំង លក់ នៅ ផ្សារ អ្នកលឿង ស្ថិត នៅ ភូមិ ០២ ឃុំ ព្រែក ខ្សាយ ខ ស្រុក ពាមរក៍ ខេត្ត ព្រៃវែង ។
ក្នុង ការត្រួតពិនិត្យ មន្រ្តី ជំនាញ បាន ធ្វើ ការវិភាគ បឋម ទៅ លើ ផលិតផល ទំនិញ ចំនួន ៧មុខ ស្មើនឹង ១៥ គំរូ មាន ដូច ជា៖ នំបញ្ចុក គុយ ទាវ បាញ់ កាញ់ ត្រី ងៀត ត្រី ប្រម៉ា ត្រី ចំហុយ ក្បាល ត្រី ប្រលាក់ ដើម្បី រក សារធាតុ គីមី ហាមឃាត់ ដែល អាច ធ្វើឲ្យ ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ ។ ជាមួយគ្នា នោះ មន្ត្រី ជំនាញ បាន ធ្វើ ការត្រួតពិនិត្យ រក ភាព មិន អនុលោម នៅលើ សំបក វេចខ្ចប់ ផលិតផល ម្ហូប អាហារ បានជាច្រើន មុខ ទៀត ផងដែរ ។
ជា លទ្ធផល មន្ត្រី ជំនាញ បាន រកឃើញ សរសៃ រគុយ ទាវ ទម្ងន់ ១គីឡូក្រាម មាន ដាក់ សារធាតុ គីមី ហាមឃាត់ ប៉ូរាក់ ចំណែក នំបញ្ចុក រក ពុំ ឃើញ មាន សារធាតុ គីមី ទេ ។ សរុប ទំនិញ ខូច គុណភាព ដែល មន្ត្រី ជំនាញ ដកហូត បាន ចំនួន ១គីឡូក្រាម ។
បន្ទាប់មក មន្ត្រី កាំ កុងត្រូល បាន ធ្វើ ការណែនាំ ដល់ អាជីវករ ហើយ ឲ្យ ម្ចាស់ ទំនិញ ធ្វើ កិច្ចសន្យា ផ្តិត មេដៃ ដើម្បី បញ្ឈប់ ការដាក់ តាំង លក់ នូវ ផលិត ផល ម្ហូប អាហារ ដែល មាន ដាក់ បន្ថែម នូវ សារធាតុ គីមី ហាមឃាត់ និង បាន ធ្វើ កំណត់ហេតុ ដកហូត ទំនិញ ទាំងនោះ យក ទៅ កម្ទេចចោល ។ ក្នុង ឱកាស នោះ មន្ត្រី កាំ កុងត្រូល ក៏ បាន ពន្យល់ ផ្សព្វផ្សាយ អប់រំ ណែនាំ ដល់ អាជីវករ ឲ្យ យល់ដឹង អំពី ច្បាប់ ស្តីពី ការគ្រប់គ្រង គុណភាព សុវត្ថិភាព លើ ផលិតផល ទំនិញ និង សេវា ផងដែរ ៕
ក្រសួង បរិស្ថាន ព្រមាន អ្នក កំពុង កាន់កាប់ ដី ដោយ ខុស ច្បាប់ ត្រូវ បញ្ឈប់ សកម្ម ជាបន្ទាន់ និង ប្រគល់ ទីតាំង ដី ដោយ ឥត លក្ខខណ្ឌ ជូន ក្រសួង វិញ បើ ពុំ នោះ ទេ នឹង ត្រូវ ប្រឈមមុខ ចំពោះ វិធានការ ច្បាប់
( ភ្នំពេញ ) ៖ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង បរិស្ថាន បាន ចេញមក ព្រមាន ធ្ងន់ ៗ ចំពោះ អ្នក ដែល កំពុង កាន់កាប់ ដី ដោយ ខុស ច្បាប់ ត្រូវ បញ្ឈប់ សកម្ម របស់ ខ្លួន ជាបន្ទាន់ និង ត្រូវ ប្រគល់ ទីតាំង ដី ទាំងនោះ ដោយ ឥត លក្ខខណ្ឌ មក ជូន ក្រសួង បរិស្ថាន គ្រប់គ្រង វិញ បើ ពុំ នោះ ទេ នឹង ត្រូវ ប្រឈមមុខ នឹង វិធានការ ច្បាប់ ។
នេះ ជា ការលើកឡើង របស់ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ និង ជា មន្ត្រី នាំ ពាក្យ ក្រសួង បរិស្ថាន បន្ទាប់ពី ក្រសួង បាន រកឃើញ ថា តំបន់ ការពារ ធម្មជាតិ មួយចំនួន ប្រឈមមុខ នឹង ការគំរាមកំហែង នៃ ការទន្ទ្រាន កាន់កាប់ ដីធ្លី ដោយ ខុស ច្បាប់ ទោះបីជា អាជ្ញាធរ មាន សមត្ថកិច្ច ចាត់ វិធានការ ច្បាប់ តឹងរឹង និង ចុះ ធ្វើ ការអប់រំ ផ្សព្វផ្សាយ យ៉ាងណា ក៏ ដោយសារតែ ទីផ្សារ ដី ឡើង ថ្លៃ ។
