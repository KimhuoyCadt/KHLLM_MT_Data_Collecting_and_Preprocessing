( ស្វាយរៀង ) ៖ នៅក្នុង ពិធី ប្រកាស ចូលកាន់ មុខតំណែង ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង អាណត្តិ ទី៣ នៅ ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បាន ជំរុញ ប្រធាន ក្រុមប្រឹក្សា សមាជិក ទាំងអស់ ត្រូវតែ ខិតខំ បម្រើ ផលប្រយោជន៍ ចូលរួម បំពេញ សេចក្តីត្រូវការ របស់ ប្រជាពលរដ្ឋ ដោយ ឈរ លើ ស្មារតី ស្មើភាព យុត្តិធម៌ មិន ប្រកាន់ ពូជសាសន៍ និង និន្នាការ នយោបាយ អ្វី នោះ ឡើយ ។
សម្តេច ក្រឡាហោ ស ខេង បាន ថ្លែង ថា ក្នុង នាម រាជ រដ្ឋាភិបាល និង ក្នុង នាម សម្តេច ផ្ទាល់ សូម សំដែង នូវ ការអបអរសាទរ កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមាជិក សមាជិកា ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង ដែល ត្រូវបាន តំណាង ប្រជាពលរដ្ឋ គឺ សមាជិក ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ដែល ជា អង្គ បោះឆ្នោត បាន បោះឆ្នោត ផ្តល់ សេចក្តីទុកចិត្ត ដើម្បី បន្ត ដឹកនាំ ខេត្ត ឱ្យ កាន់ រីកចម្រើន លើ គ្រប់ វិស័យ ថែម ទៀត ។
ជាមួយគ្នា នេះ ដែរ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន លើកឡើង នូវ ចំណុច សំខាន់ ៗ មួយចំនួន ដែល អាជ្ញាធរ ខេត្ត ស្វាយរៀង បាន បំពេញ នា ពេល កន្លងមក ជូន សម្ដេច ក្រឡាហោម ដូចជា ស្ថានភាព រដ្ឋបាល ដែនដី និង សមិទ្ធផល សំខាន់ ៗ ដែល គណៈអភិបាល និង ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង ក្នុង អាណត្តិ ទី២ សម្រេចបាន ព្រមទាំង អំពី លទ្ធផល នៃ ការបោះឆ្នោត ជ្រើសតាំង ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង និង ក្រុមប្រឹក្សា ក្រុង - ស្រុក អាណត្តិ ទី៣ ផងដែរ ។
លោក បាន បន្ត ថា សមិទ្ធផល និង ស្នាដៃ ការងារ ដែល គណៈអភិបាល និង ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង សម្រេចបាន ព្រមទាំង លទ្ធផល នៃ ការបោះឆ្នោត នា ពេលនេះ គឺជា មូលដ្ឋាន ឆ្លុះបញ្ចាំង ឱ្យ ឃើញ កាន់តែ ច្បាស់ អំពី ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ប្រកបដោយ ភាពឈ្លាសវៃ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ការចង្អុលបង្ហាញ ជាប់ ជាប្រចាំ របស់ សម្ដេច ។
សូម បញ្ជាក់ ថា នៅ អាណត្តិ ទី៣នេះ ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង មាន ចំនួន ២៣ រូប ក្នុង នោះ លោក ជុំ ហាត ត្រូវបាន តែងតាំង ជា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ៕
នគរបាល ខេត្ត រតនគីរី ឃាត់ខ្លួន ជនសង្ស័យ ប្រុស ស្រី ៣នាក់ ពាក់ព័ន្ធ ករណី ជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន
( រតនគិរី ) ៖ ដោយ មាន ការចង្អុលបង្ហាញ ពី លោក ឧត្ដមសេនីយ៍ ទោ យិន ចំណាន ស្នងការ នគរបាល ខេត្ត និង លោក ឧត្តមសេនីយ៍ ត្រី វ៉ាន់ សង្វាត ស្នងការ រង ទទួល ផែន ប្រឆាំង គ្រឿងញៀន ព្រមទាំង មាន ការសម្របសម្រួល ពី លោក លាង អ៊ូ ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត បាន កម្លាំង ជំនាញ បាន ឃាត់ខ្លួន ជនសង្ស័យ ប្រុស - ស្រី ចំនួន ៣នាក់ ពាក់ព័ន្ធ ករណី ជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន ។
លោក វរសេនីយ៍ ទោ លាង អ៊ីម នាយ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន បាន ឱ្យដឹង ថា ការចុះបង្ក្រាប ជនសង្ស័យ ទាំង ៣នាក់ ខាងលើ បាន ធ្វើឡើង នា ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០១៩ ម្សិលមិញ ស្ថិត នៅ ចំណុច ផ្ទះ ជួល របស់ ជនសង្ស័យ ស្ថិត ក្នុង ភូមិ អភិវឌ្ឍន៍ សង្កាត់ ឡា បាន សៀក ក្រុង បាន លុង ខេត្ត រតនគិរី ។
លោក វរសេនីយ៍ ទោ លាង អ៊ីម បន្ថែម ទៀត ថា បន្ទាប់ពី សួរចម្លើយ តាម ជំនាញ កម្លាំង របស់ លោក បាន ឈាន ទៅ ឆែកឆេរ ផ្ទះ ជនសង្ស័យ មួយ កន្លែង ទៀត ស្ថិត ក្នុង ភូមិ១ សង្កាត់ កាចាញ រកឃើញ ម្ស៉ៅ ក្រាម ពណ៌ ស សង្ស័យ ជា សារធាតុ ញៀន ចំនួន ២កញ្ចប់ . ជញ្ជីង ថ្លឹង គ្រឿងញៀន ចំនួន ២. ថង់ សម្រាប់ ច្រក គ្រឿងញៀន មួយចំនួន ធំ ។
បច្ចុប្បន្ន ជន សង្ស័យ ទាំង៣នាក់ ខាងលើ រួម នឹង វត្ថុតាង ត្រូវបាន ឃុំ ខ្លួន ជា បណ្តោះអាសន្ន នៅ ការិយាល័យ ជំនាញ នៃ ស្នងការ នគរបាល ខេត្ត ដើម្បី កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ សាលាដំបូង ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕
នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ ផ្តល់ អំណោយ ដល់ លោកយាយ ពិការ ជើង ក្រីក្រ ចិញ្ចឹម ចៅ កំព្រា៦ នាក់ នៅ ស្រុក វ៉ារិន ខេត្ត សៀមរាប
( សៀមរាប ) ៖ នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ អគ្គ ស្នងការ រង នគរបាល ជាតិ ក្រសួង មហាផ្ទៃ និង ជា មេបញ្ជាការ នគរបាល ជាតិ ប្រចាំ ទិស ភូមិភាគ ទី៤ និង ទី៥ និង លោកស្រី កុយ សាលីណា បាន ផ្តល់ អំណោយ មាន ដូចជា អង្ករ គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា ដល់ លោកយាយ ក្រីក្រ ដែល ពិការ ជើង និង បាន ចិញ្ចឹម ចៅ កំព្រា ចំនួន ៦នាក់ នៅ ស្រុក ស្រុក វ៉ារិន ខេត្ត សៀមរាប ។
អំណោយ នេះ ត្រូវបាន លោក ឧត្តមសេនីយ៍ ទោ ខេង រ៉ា តំណាង នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ យក ទៅ ប្រគល់ ជូន លោកយាយ ពិការ នៅក្នុង ក្រុង សៀមរាប នា ព្រឹក ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ ខណៈពេល ដែល ក្រុមការងារ យក រថយន្ត ដឹក ពួកគាត់ ពី ស្រុក វ៉ារិន មកកាន់ ក្រុង សៀមរាប ។
អំណោយ ដែល នាយ ឧត្តមសេនីយ៍ ផ្តល់ ជូន លោកយាយ ពិការ ចិញ្ចឹម ចៅ កំព្រា នោះ មាន អង្ករ ចំនួន ១០០ គីឡូក្រាម មី ទឹកស៊ីអ៊ីវ ទឹកត្រី ធុង ទឹក ឆ្នាំង ចាន ស្លាបព្រា មុង ភួយ កាំបិត ខ្ទះ វែក បំពង់ ទឹក ក្តៅ កំសៀវ និង សម្ភារ ប្រើប្រាស់ ជាច្រើន មុខ ទៀត ព្រមទាំង ថវិកា មួយ ចំនួន ធំ ទៀត និង កុមារ កំព្រា ទាំង នាក់ នោះ ទទួលបាន សម្ភារ សិក្សា និង ថវិកា ផងដែរ ។
ដោយឡែក មួយ គ្រួសារ ទៀត ដែល រស់ នៅក្នុង ក្រុង សៀមរាប ហើយ មាន ស្ថានភាពក្រីក្រ គឺ មាន ឈ្មោះ ចន ស្រី អាយុ ៣៣ ឆ្នាំ រស់ នៅ ភូមិ ស្ល ក្រាម សង្កាត់ ស្ល ក្រាម ក្រុង សៀមរាប បាន ទទួល អំណោយ ដូច ក្រុមគ្រួសារ លោកយាយ ខាងលើ ដែរ ៕
ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខេត្ត កោះកុង អាណត្តិ ទី៣ចំនួន ១៩ រូប . សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ជំរុញឱ្យ មន្ត្រី ខិតខំ បម្រើ ពលរដ្ឋ ឱ្យ អស់ ពី លទ្ធភាព
( កោះកុង ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត កោះកុង បាន អញ្ជើញ ប្រកាស ចូលកាន់ តំណែង ក្រុមប្រឹក្សា ខេត្ត កោះកុង អាណត្តិ ទី៣ ចំនួន ១៩ រូប ដោយ ជំរុញឱ្យ មន្ត្រី ខិតខំ ធ្វើការ ដើម្បី បម្រើ ប្រជាពលរដ្ឋ ឱ្យ មាន ប្រសិទ្ធិភាព ខ្ពស់ ពង្រឹង បញ្ហា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ និង ការគ្រប់គ្រង ធនធាន ធម្មជាតិ ឱ្យ អស់ ពី លទ្ធភាព ។
ពិធី នេះ បាន ធ្វើឡើង នៅ សាល មហោស្រព ខេត្ត កោះកុង នា រសៀល ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០១៩ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ប្រតិភូ ក្រសួង មហាផ្ទៃ គណៈ អភិបាល ខេត្ត ក្រុង ស្រុក ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ។
សម្តេច ពិជ័យ សេនា បាន ដាក់ តឿន ដល់ មន្ត្រី ដែល ទើប ទទួលបាន ការតែងតាំង ថ្មី ឱ្យ ត្រូវ ធ្វើ យ៉ាងណា បំពេញ ការងារ របស់ ខ្លួន ឱ្យ កាន់តែ សកម្ម បន្ថែម ទៀត ដើម្បី ចូលរួម ក្នុង ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្គម កំណែទម្រង់ វិមជ្ឈការ និង វិសហមជ្ឈការ ពិសេស ក្រុមប្រឹក្សា ដែល ទើបនឹង ជាប់ ថ្មី ត្រូវ ចូលរួម ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ឱ្យ បាន រួចរាល់ ត្រឹម ២សប្តាហ៍ បន្ទាប់ពី ចូលកាន់ តំណែង ជា ផ្លូវការ ។
សម្តេច ពិជ័យ សេនា បាន បន្ត ថា ដើម្បី សម្រេចបាន ភារកិច្ច ទាំងនេះ ត្រូវ ខិតខំ ពង្រឹង ស្មារតី សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ឱ្យ បាន ក្នុង ក្រុមប្រឹក្សា ដើម្បី លើកកម្ពស់ ការទទួលខុសត្រូវ ភាព ជា ម្ចាស់ ការ ក្នុង បំពេញ តួនាទី ភារកិច្ច លើ ការអភិវឌ្ឍន៍ គ្រប់ មូលដ្ឋាន ក្នុង ឆ្លើយតប តាម តម្រូវការ របស់ ប្រជាពលរដ្ឋ ។
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០១៩ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៤គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០១៩ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន ៤គ្រឿង ក្នុង នោះ រួម មាន៖ ម៉ូតូ ៤គ្រឿង ។
សមាគម សិល្បៈ ជប៉ុន កម្ពុជា បាន បែងចែក កម្មវិធី ខាងលើ ជា ពីរ ដោយ ល្ងាច ថ្ងៃសៅរ៍ នេះ គឺជា កម្មវិធី ច្រៀង និង សម្ដែង បើក ជំហរ ឲ្យ មហាជន ចូលរួម ទស្សនា ដោយ សេរី ។ ប៉ុន្ដែ ថ្ងៃទី ១៨ ខែមិថុនា ខាងមុខ សមាគម នឹង រៀបចំ កម្មវិធី ដ៏ ធំ ក្នុង សាល ផ្សារទំនើប អ៊ីអន សែន សុខ ដដែល ដោយ មាន តារាចម្រៀង និង ក្រុម តន្ដ្រីករ ល្បី ៗ ជាច្រើន ចូលរួម ។
អ្វី ដែល ពិសេស កម្មវិធី ទាំង ពីរ សុទ្ធតែ មាន អតីត បវរកញ្ញា ចក្កវាឡ លំដាប់ ពិភពលោក Satiomi Ogawa ចូលរួម ហើយ នាង បាន ត្រៀម ចម្រៀង អូប៉េរ៉ា ជាច្រើន សម្រាប់ បង្ហាញ ជូន ភ្ញៀវ ជាតិ និង អន្ដរជាតិ ទៀតផង ។ ចំពោះ កម្មវិធី ថ្ងៃទី ១៨ ខែមិថុនា នឹង មាន ការលក់ សំបុត្រ តម្លៃ ២០ ដុល្លារ សម្រាប់ ការចូលរួម ទស្សនា តែ ក៏ មាន តម្លៃ ពិសេស ៥ដុល្លារ សម្រាប់ សិស្ស ផងដែរ ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ដឹកនាំ សហការី ទាំងអស់ រួមទាំង យុវជន ស្ម័គ្រចិត្ដ ប្រារព្ធ ពិធី សូត្រ មន្ត ចម្រើន ព្រះបរិត្ត និង រាប់ បាត្រ ព្រះសង្ឃ ៨៤ អង្គ ថ្វាយ ព្រះពរ សម្ដេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ន រោត្ដម មុនិនា ថ សីហនុ ព្រះប្រធាន កិត្ដិយស កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស បុណ្យ ចម្រើន ព្រះជន្ម វស្សា គម្រប់ ៨៣ យាង ចូល ៨៤ ព្រះវស្សា ។
តាម ព្រះរាជ ក្រឹត្យ . លោក លី សុផាណា ព្រះរាជអាជ្ញា រង នៃ សាលាដំបូង រាជធានី ភ្នំពេញ ត្រូវបាន តែងតាំង ជា ព្រះរាជអាជ្ញា នៅ សាលាឧទ្ធរណ៍ ។ ព្រះរាជអាជ្ញា រង នៃ សាលាដំបូង រាជធានី ភ្នំពេញ ត្រូវបាន ផ្ទេរ ចេញ ចំនួន ៤រូប ហើយក៏ ផ្ទេរ ចូលមកវិញ ចំនួន ៤រូប វិញ ដែរ ។
សូម បញ្ជាក់ ថា ក្រៅពី មាន ការតែងតាំង និង ផ្ទេរ ព្រះរាជអាជ្ញា ព្រះរាជអាជ្ញា រង នា ពេល កន្លងទៅ ថ្មី ២នេះ ព្រះករុណា ព្រះបាទ ន រោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ក៏ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង និង ផ្ទេរ មុខតំណែង ប្រធាន អនុប្រធាន ចៅក្រម សាលាឧទ្ធរណ៍ និង សាលាដំបូង រាជធានី - ខេត្ត មួយចំនួន ផងដែរ ៕
កុងតឺ នឺ ទាំង៥ ដែល ផ្ទុក ទៅ ដោយ ក្រដាស អេត ចាយ នោះ គឺជា កម្មសិទ្ធ របស់ ក្រុមហ៊ុន មួយ នៃ ប្រទេស កាណាដា ត្រូវបាន ដឹក បញ្ជូន មកពី ទីក្រុង ស៊ីថល សហរដ្ឋ អាមេរិក ទៅកាន់ ទីក្រុង ស៊ូរ៉ា បាយ៉ា ជា ទីក្រុង ធំ ជាង គេ លំដាប់ ទី២ របស់ ឥណ្ឌូណេស៊ី កាលពី ចុង ខែមីនា កន្លងទៅ ។ ប៉ុន្តែ វា មិន ទាន់ ដឹង ច្បាស់ ភ្លាម ៗ នោះ ទេ ថា តើ សំរាម ទាំង នេះ មាន ប្រភព ដើម មកពី ណា ។
ឥណ្ឌូណេស៊ី ថ្មី ៗ នេះ កំពុង ត្រួតពិនិត្យ លើ កុងតឺ នឺ ចំនួន ៧គ្រឿង ផ្សេង ទៀត នៅ កំពង់ផែ រដ្ឋធានី ហ្សាការតា និង នៅ ទីក្រុង បាតាំ ស្ថិត នៅ កោះ ស៊ូម៉ាត្រា ។
ឥណ្ឌូណេស៊ី គឺជា ប្រទេស ថ្មី ចុងក្រោយ ដែល បាន បញ្ជូន ត្រឡប់ ទៅកាន់ ប្រទេស ដែល នាំចូលមក នូវ សំរាម បន្ទាប់ពី ប្រទេស ម៉ាឡេស៊ី បាន ប្តេជ្ញា ដឹក បញ្ជូន ត្រឡប់ ទៅវិញ នូវ សំរាម ប្លាស្ទិច រាប់ រយ តោន កាលពី ខែ មុន ។
ដោយឡែក ហ្វីលីពីន ក៏ បាន បញ្ជា ឲ្យដឹក សំរាម ជាច្រើន តោន ដែល បាន ចោល នៅក្នុង ប្រទេស របស់ ខ្លួន ត្រឡប់ ទៅកាន់ កាណាដា វិញ ដែរ ដោយ បញ្ហា នេះ បាន បណ្តាលឲ្យ មាន ជម្លោះ ផ្នែក ការទូត រវាង ប្រទេស ទាំង ពីរ ទៀតផង ។
គួរ បញ្ជាក់ ថា បើ តាម អង្គការ មូលនិធិ ធម្មជាតិ ពិភពលោក (WWF) បាន ឲ្យដឹង ថា ផ្លាស្ទិច ប្រមាណ ៣០០លាន តោន ត្រូវបាន ផលិត ជារៀងរាល់ ឆ្នាំ ។ ភាគ ច្រើន នៃ បា្ល ស្ទិច ដែល បាន ផលិត ឡើង នោះ ត្រូវបាន បញ្ចប់ ទៅ វិញ ដោយ កប់ នៅក្នុង ដី ឬក៏ ត្រូវបាន គេ បោះចោល ក្នុង ទឹក សមុទ្រ ៕
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កំពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ១៧ ខែមិថុនា នេះ !
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ បាន ចេញ ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
បើកបរ សូម ប្រុងប្រយ័ត្ន គ្រប់ វិនាទី ! ស្លាប់ ២នាក់ និង របួស ១១នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៦ ខែមិថុនា
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឱ្យដឹង ថា នៅ ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ២នាក់ . របួស ស្រាល ២នាក់ និង របួស ធ្ងន់ ៩នាក់ ។
( ភ្នំពេញ ) ៖ អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បញ្ជូន ជនជាតិ ស្បែក ខ្មៅ ម្នាក់ រួម ជាមួយ ស្រី ស្នេហ៍ ជា ជនជាតិ ខ្មែរ ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ផ្តន្ទាទោស តាម ច្បាប់ ពាក់ព័ន្ធ ករណី ឆបោក តាមរយៈ ការទំនាក់ទំនង ក្នុង បណ្តាញ សង្គម ហ្វេសប៊ុក កាលពី ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០១៩ ។
ដោយ មាន ការសង្ស័យ ជនរងគ្រោះ ក៏ បាន ដាក់ ពាក្យ បណ្តឹង ដល់ សមត្ថកិច្ច អាវុធហត្ថ រាជធានី ភ្នំពេញ ។ ក្រោយពេល ទទួល ពាក្យបណ្តឹង កម្លាំង ជំនាញ នៃ ការិយាល័យ បទល្មើស ព្រហ្មទណ្ឌ អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ធ្វើ ការស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ រហូត ឈាន ទៅ កំណត់ មុខ សញ្ញា និង ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ បាន ជាក់ស្តែង នៅ ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០១៩ ព្រមទាំង បាន ស្រាវជ្រាវ ឃើញ ថា ជនសង្ស័យ ខាងលើ គឺ ធ្លាប់ បាន ប្រើ ល្បិច បោកប្រាស់ ជនរងគ្រោះ អស់ ជាច្រើន រយ នាក់ ផងដែរ ។
ចង់ ជ្រាប កាន់តែ ច្បាស់ សូម ទស្សនា វីដេអូ ខាងក្រោម៖
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៦ ខែមិថុនា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៤១៩ គ្រឿង និង ផាក ពិន័យ ៣០២ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៣.៥២៩ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៤១៩ គ្រឿង ( ម៉ូតូ ៧២ %) អប់រំ១១៧ គ្រឿង និង ផាក ពិន័យ ៣០២ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ១៦ ខែមិថុនា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ១០៥២ គ្រឿង . អប់រំ ៧២ គ្រឿង និង ផាក ពិន័យ ២៣២ គ្រឿង ។
សភា ពាណិជ្ជកម្ម ចិន - កម្ពុជា បង្កើត វេទិកា សន្ទនា សម្រាប់ សម្ព័ន្ធ ពាណិជ្ជករ កម្ពុជា ដើម្បី ពិភាក្សា ជុំវិញ ស្ថានភាព បច្ចុប្បន្ន នៃ សេដ្ឋកិច្ច កម្ពុជា
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន អ & អេហ្វ កម្ពុជា សហការ ជាមួយនឹង សភា ពាណិជ្ជកម្ម ចិន - កម្ពុជា ព្រមទាំង សហគ្រាស មាន ឈ្មោះ បោះ សំឡេង នានា ដែល ប្រចាំ នៅ កម្ពុជា បង្កើតឡើង នូវ វេទិកា សន្ទនា សម្រាប់ សម្ព័ន្ធ ពាណិជ្ជករ កម្ពុជា ដើម្បី ផាសុកភាព នា ពេល បច្ចុប្បន្ន និង វឌ្ឍនភាព នា ពេល អនាគត របស់ ពាណិជ្ជករ នៅ កម្ពុជា ក្នុង កិច្ចសហប្រតិបត្តិការ ឈ្នះ - ឈ្នះ ។ វេទិកា សន្ទនា នេះ ធ្វើឡើង ក្នុង កម្មវិធី សម្ពោធ សម្ព័ន្ធ ពាណិជ្ជករ អ & អេហ្វ កម្ពុជា ។
វេទិកា ខាងលើ នេះ បាន ធ្វើ ការពិភាក្សា ជុំវិញ ស្ថានភាព បច្ចុប្បន្ន នៃ សេដ្ឋកិច្ច កម្ពុជា និង ទំនោរ សក្ដានុពល នៃ វឌ្ឍនភាព នា ថ្ងៃ អនាគត ។ ក្នុង ពិធី នេះ មាន ការអញ្ជើញ ចូលរួម យ៉ាង ច្រើន កុះករ ពីសំណាក់ នាយក គ្រប់គ្រង ពាក់ព័ន្ធ នៃ ក្រុមហ៊ុន អ & អេហ្វ កម្ពុជា ដៃ គូ សហការ ផ្នែក យុទ្ធសាស្ត្រ នៃ សម្ព័ន្ធ ពាណិជ្ជករ ម្ចាស់ អាជីវកម្ម គ្រប់ វិស័យ ប្រចាំ នៅ រាជធានី ភ្នំពេញ នា ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០១៩ ។
លោក បាន បន្ថែម ទៀត ថា ក្រុមហ៊ុន អ & អេហ្វ កម្ពុជា បាន ប្រកាន់ខ្ជាប់ ជានិច្ច នូវ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ « កៀក ស្និទ្ធ នឹង សរសៃ ជីពចរ នៃ ទីក្រុង បង្កើត នូវ ជីវភាព រស់ នៅ ដ៏ ស្រស់ បវរ » ហើយក៏ មិន បំភ្លេច ដែរ ពី បេសកកម្ម ក្នុង ការក្លាយ ខ្លួន ជា ក្រុមហ៊ុន អភិវឌ្ឍន៍ វិស័យ អចលន ទ្រព្យ ដែល ឈាន មុខ គេ នៅលើ ឆាក អន្តរជាតិ ផងដែរ ។
លោក ក៏ បាន បញ្ជាក់ ថា « អាស្រ័យ ហេតុ នេះ ហើយ ទើប ក្រុមហ៊ុន អ & អេហ្វ កម្ពុជា បាន សហការ ជាមួយនឹង សភា ពាណិជ្ជកម្ម ចិន - កម្ពុជា ព្រមទាំង សហគ្រាស មាន ឈ្មោះ បោះ សំឡេង នានា ដែល ប្រចាំ នៅ កម្ពុជា បង្កើតឡើង នូវ វេទិកា សន្ទនា សម្រាប់ សម្ព័ន្ធ ពាណិជ្ជករ កម្ពុជា ដើម្បី ផាសុកភាព នា ពេល បច្ចុប្បន្ន និង វឌ្ឍនភាព នា ពេល អនាគត របស់ ពាណិជ្ជករ នៅ កម្ពុជា ក្នុង កិច្ចសហប្រតិបត្តិការ ឈ្នះ - ឈ្នះ » ។
« នៅលើ វេទិកា ពិភាក្សា ខាងលើ នេះ អ្នកតំណាង មកពី គ្រប់ វិស័យ ក៏ បាន ចែករំលែក បទពិសោធន៍ រៀង ៗ ខ្លួន អំពី ការយល់ឃើញ និង ទស្សនវិស័យ លើ ការអភិវឌ្ឍ សេដ្ឋកិច្ច កម្ពុជា ក្នុង រយៈពេល មួយ ឆ្នាំ កន្លងមក នេះ » ។ នេះ ជា ការគូសបញ្ជាក់ បន្ថែម របស់ អគ្គ នាយក នៃ ក្រុមហ៊ុន អ & អេហ្វ កម្ពុជា ។
ជាមួយគ្នា នោះ លោក វ៉ាង ជីហាវ បាន ឲ្យដឹង ថា ក្រុមហ៊ុន អ & អេហ្វ កម្ពុជា ក៏ នឹង គ្រោង រៀបចំ វេទិកា ពិភាក្សា បញ្ហា សេដ្ឋកិច្ច និង ទីផ្សារ ជាប្រចាំ ដើម្បី ដឹកនាំ ពាណិជ្ជករ គ្រប់ អាជីវកម្ម ឲ្យ ធ្វើ ការផ្ដោះ ប្ដូរ ព័ត៌មាន គ្នា ទៅ វិញ ទៅ មក ក្នុង គោលបំណង ពង្រីក បណ្ដាញ ខ្សែរយៈ កាន់តែ ច្រើន និង ពង្រឹង កំលាំង ហិរញ្ញវត្ថុ ទីក្រុង ភ្នំពេញ ឲ្យ កាន់តែ ខ្លាំង ផងដែរ ៕
បំពេញ តាម សំណូមពរ របស់ ពលរដ្ឋ . លោក ថោង ខុន ផ្ដល់ជូន អគារ សិក្សា ១ខ្នង នៅ ស្រុក តាំង គោក ថ្ងៃ នេះ ត្រូវបាន បញ្ចុះ បឋមសិលា ជា ផ្លូវការ
( កំពង់ធំ )៖ ដើម្បី បំពេញ តាម សំណូមពរ របស់ ប្រជាពលរដ្ឋ មូលដ្ឋាន ដែល កំពុង មាន ភាព ខ្វះខាត នូវ អគារ សិក្សា រៀនសូត្រ និង ដើម្បី ចូលរួម អនុវត្ត តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ផង នោះ លោក ថោង ខុន ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក ខេត្ត កំពង់ធំ បាន ផ្ដល់ជូន នូវ អគារ សិក្សា ថ្មី មួយ ខ្នង ដល់ សាលា បឋមសិក្សា ឧទុម្ព រ ស្ថិត នៅ ភូមិ ឧទ្ទម្ពរ ឃុំ ស្រឡៅ ស្រុក តាំង គោក ។
នា ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ លោក ថោង ខុន ក៏ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បញ្ចុះ បឋមសិលា នៅ សាលា បឋមសិក្សា ឧទុម្ពរ ដោយ ផ្ទាល់ ផងដែរ ដែល មាន មន្ត្រីរាជការ កម្លាំង សមត្ថកិច្ច ក្រុមការងារ មូលដ្ឋាន ប្រជាពលរដ្ឋ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ចូលរួម ជិត ៤០០ នាក់ ។ អគារ សិក្សា ១ខ្នង មាន ៦បន្ទប់ ប្រក់ ស័ង្កសី នេះ នឹង ចំណាយ រយៈពេល សាងសង់ ប្រមាណ ៧ខែ ចាប់ពី ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ ដល់ ខែមករា ឆ្នាំ ២០២០ ។
នា ឱកាស អញ្ជើញ ក្នុង ពិធី បញ្ចុះ បឋមសិលា ខាងលើ លោក ថោង ខុន បាន លើកឡើង ថា ថវិកា ដែល ឧបត្ថម្ភ ដល់ ការសាងសង់ អគារ សិក្សា ថ្មី នេះ គឺជា ថវិកា ជំនួយ ឧបត្ថម្ភ របស់ សប្បុរសជន ។
លោក ថោង ខុន បាន ឱ្យដឹង ថា ក្រោម ពន្លឺ នៃ នយោបាយ ឈ្នះ ឈ្នះ និង ផ្លែ ផ្កា នៃ សន្តិភាព បាន ធ្វើឲ្យ កម្ពុជា មាន ការអភិវឌ្ឍ រីកចម្រើន មកដល់ សព្វ ថ្ងៃ ហើយ កម្ពុជា ក៏ បាន ធ្វើ សមាហរណកម្ម ទៅក្នុង តំបន់ និង ពិភពលោក ដោយ ស្មើ មុខ ស្មើ មាត់ ស្មើ សិទ្ធិ និង ស្មើភាព នៅលើ ឆាក អន្តរជាតិ ។
កម្ពុជា រក្សា បាន នូវ កំណើន សេដ្ឋកិច្ច ក្នុង រង្វង់ ៧% ក្នុង ២ទសវត្សរ៍ ចុងក្រោយ នេះ ។ អត្រា នៃ ភាពក្រីក្រ បាន ធ្លាក់ចុះ មក នៅ រង្វង់ ១០% នា ពេល បច្ចុប្បន្ន ។ ចំណូល មធ្យម សម្រាប់ មនុស្ស មា្នក់ បាន កើន ដល់ ១.៥៦៣ ដុល្លារ នៅ ឆ្នាំ ២០១៨ ។
លោក បាន បញ្ជាក់ ថា រចនាសម្ព័ន្ធ សេដ្ឋកិច្ច កម្ពុជា កំពុង ផ្លាស់ប្តូរ ពី ប្រទេស ដែល ពឹងផ្អែក លើ វិស័យ កសិកម្ម ទៅជា ប្រទេស ដែល ពឹងផ្អែក ជា សំខាន់ លើ វិស័យ ឧស្សាហកម្ម និង សេវាកម្ម ។ កម្ពុជា នឹង ក្លាយជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
លោក ថោង ខុន ក៏ បាន លើកឡើង ពី សភាពការណ៍ នយោបាយ ថ្មី ៗ ដែល បាន កើតឡើង ក្នុង សង្គម កម្ពុជា ផងដែរ ។ លោក ថែមទាំង អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម កុំ ឱ្យ ចាញ់បោក ពួក ជន អគតិ មួយចំនួន ដែល ព្យាយាម ប្រើ គ្រប់ ឧបាយកល បោកប្រាស់ ប្រជាពលរដ្ឋ ឱ្យ ប្រឆាំង នឹង ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ផងដែរ ។
លោក ក៏ បាន ផ្ដាំផ្ញើ ឱ្យ ប្រជាពលរដ្ឋ ខិតខំ បង្កបង្កើន ផល កសិកម្ម ដំណាំ ស្រែ ចម្ការ របស់ ខ្លួន ឱ្យ បាន កាន់តែ ច្រើន ពិសេស គឺ ដំណាំ ស្រូវ ពីព្រោះ ភាគី មិត្ត ចិន បាន ព្រមព្រៀង ទិញ អង្ករ ពី កម្ពុជា ជាច្រើន ម៉ឺន តោន ។
លោក បាន លើកទឹកចិត្ត ឱ្យ សិស្សានុសិស្ស ត្រូវ ខិតខំ សិក្សា រៀនសូត្រ ដើម្បី ចាប់ យក ឱកាស ការងារ ជាច្រើន ដែល កំពុង មាន តម្រូវការ ខ្ពស់ ក្នុង ទីផ្សារ បច្ចុប្បន្ន និង ទៅ ថ្ងៃ អនាគត ក្នុង នោះ លោក ក៏ បាន លើកឡើង ពី តម្រូវការ ការងារ ក្នុង វិស័យ ទេសចរណ៍ ដែល កំពុង មាន តម្រូវការ ខ្ពស់ ពី មួយ ទៅ មួយ ឆ្នាំ ផងដែរ ។
លោក បាន លើកឡើង ទៀត ថា ឱកាស ការងារ ទាំង នេះ កើតឡើង ដោយសារ បរិយាកាស នៃ ការដឹកនាំ របស រាជ រដ្ឋាភិបាល កម្ពុជា នា ពេល បច្ចុប្បន្ន ដែល ប្រកប តាម គន្លង ប្រជាធិបតេយ្យ មាន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ មាន ទំនាក់ទំនង ការបរទេស ល្អ ជាមួយ អន្តរជាតិ ធ្វើឱ្យ អន្តរជាតិ ទទួលស្គាល់ គាំទ្រ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
លោក ប្រធានាធិបតី តួកគី បាន បន្ត គូសបញ្ជាក់ ថា ដើម្បី បង្កើត បាន នូវ ដំណោះស្រាយ សម្រាប់ សុខ សន្តិភាព និង ស្ថិរភាព នៅលើ ពិភពលោក សព្វ ថ្ងៃ នេះ គឺ វា ច្បាស់ ណាស់ ថា មធ្យោបាយ បែប ឯកតោ ភាគី មិន អាច ទៅ រួច នោះ ទេ ហើយ លោក សង្ឃឹម ថា បណ្តា មេដឹកនាំ ប្រទេស ឯទៀត ៗ ដែល បាន ទៅ ចូលរួម សន្និសីទ CICA ក៏ មាន ទស្សនៈ ដូច រូបលោក ដែរ ។
គួរ ជម្រាប ថា សន្និសីទ CICA ត្រូវបាន បង្កើតឡើង ក្រោម គំនិត ផ្តួចផ្តើម របស់ ប្រទេស កាហ្សាក់ ស្ថាន កាលពី ឆ្នាំ ១៩៩២ ជាមួយ គោលដៅ លើកកម្ពស់ កិច្ចសន្ទនា ការសម្រេចចិត្ត និង អនុវត្តន៍ វិធានការពាក់ព័ន្ធ បញ្ហា សន្តិសុខ នៅ តំបន់ អាស៊ី ។ មក ទល់ បច្ចុប្បន្ន រដ្ឋ អាស៊ី ចំនួន ២៧ គឺជា សមាជិក CICA ហើយ ចាប់តាំងពី ឆ្នាំ ២០១៤មក ទីស្នាក់ការ កណ្តាល របស់ CICA គឺ ស្ថិត នៅ រដ្ឋធានី Nur-Sultan របស់ កាហ្សាក់ ស្ថាន ៕ អាវុធហត្ថ ខេត្ត ព្រះវិហារ ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ជាមួយ វត្ថុតាង ថ្នាំ ញៀន ៧កញ្ចប់
( ព្រះវិហារ ) ៖ ជនសង្ស យ័ម្នាក់ ត្រូវបាន កម្លាំង កងរាជអាវុធហត្ថ ស្រុក គូលែន ខេត្ត ព្រះវិហារ ឃាត់ខ្លួន ព្រមទាំង ដកហូត វត្ថុតាង ថ្នាំ ញៀន មួយចំនួន និង សម្ភារ ជាច្រើន ទៀត ។
មន្ត្រី អាវុធហត្ថ ខេត្ត ព្រះវិហារ បាន ឲ្យដឹង នៅ ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ ថា កម្លាំង កងរាជអាវុធហត្ថ ស្រុក គូលែន ដឹកនាំ ដោយ លោក អនុ សេនីយ៍ ឯក នួន ភារៈ មេបញ្ជាការ កងរាជអាវុធហត្ថ ស្រុក ដោយ មាន ការណែនាំ ពី លោក ឧត្តមសេនីយ៍ ត្រី កង សៅ គុណ មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ព្រះវិហារ បាន ដឹកនាំ កម្លាំង ចុះ បង្រ្កាប ករណី ជួញដូរ គ្រឿងញៀន ដោយ ខុស ច្បាប់ មួយ កន្លែង នៅ ភូមិ ស្រយ៉ង់ ត្បូង ឃុំ ស្រយ៉ង់ ស្រុក គូលែន ខេត្ត ព្រះវិហារ ។
ជា លទ្ធផល បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ឈ្មោះ ជួន ម៉ាប់ អាយុ ៣២ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ រស់ នៅ ភូមិ ត្រពាំង ខ្ទះ ឃុំ ស្វាយលើ ស្រុក ស្វាយលើ ខេត្ត សៀមរាប ។
ជាមួយគ្នា នោះ កម្លាំង ក៏ បាន ដកហូត វត្ថុតាង ថ្នាំ ញៀន ម៉ា ទឹកកក ចំនួន ៧កញ្ចប់ ស្មើ និង ១១. ៣១ក្រាម ម៉ូតូ១ គ្រឿង ទូរសព្ទ័១ គ្រឿង សម្ភារ ប្រើប្រាស់ គ្រឿងញៀន មួយចំនួន ។
មន្ត្រី អាវុធហត្ថ បាន ឲ្យដឹង ទៀត ថា បន្ទាប់ពី បាន សួរនាំ រួច ជនសង្ស័យ និង វត្ថុតាង ត្រូវបាន សមត្ថកិច្ច កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕
ជនសង្ស័យ មិន ត្រឹមតែ ជា មនុស្ស ឈាម ត្រជាក់ សាហាវ ឃោរឃៅ ប៉ុណ្ណោះ ទេ សូម្បីតែ ជីវិត ផ្ទាល់ខ្លួន ជនសង្ស័យ ក៏ មិន ធម្មតា ដែរ គឺ មាន ប្តី ដល់ ទៅ ៦នាក់ ( ប្តី ទី១ មាន កូន១ ទី២មាន កូន២ ទី៣ មាន កូន១ ទាំង ៣នាក់ ដំបូង នេះ ជា ប្តី ជនជាតិ ខ្មែរ ឯ ប្តី ទី៤ មាន កូន១ ប្តី ទី ៥គ្មាន កូន និង ទី៦ គ្មាន កូន ទាំង ៣នាក់ ក្រោយ នេះ គឺជា ប្តី ជនជាតិ បរទេស ) ។
កាលពី ថ្ងៃទី ០២ ខែមិថុនា ឆ្នាំ ២០១៩ វេលា ម៉ោង ២០៖៣០ យប់ ជនរងគ្រោះ និង ជនសង្ស័យ ត្រូវ ជា មិត្តភក្តិ នឹង គ្នា បាន ផឹក ស៊ី នៅ ផ្ទះ ជនសង្ស័យ ។ ក្រោយ ចប់ ការផឹក ស៊ី ជនរងគ្រោះ បាន សុំ យក កូន របស់ ជនសង្ស័យ ភេទ ស្រី អាយុ ៨ ឆ្នាំ ទៅ ដេក ជាមួយ នៅ ផ្ទះ របស់ ខ្លួន នៅឯ ទួល សង្កែ ដូច តាម ទម្លាប់ កន្លងមក ។
ព្រម ជាមួយគ្នា ផងដែរ និយាយ ពី គ្រួសារ ជនរងគ្រោះ ក្រោយពេល បាត់ ជនរងគ្រោះ មួយ ថ្ងៃ កូនស្រី ម្នាក់ បាន កាន់ រូបថត ម្តាយ ដើរ សួរ គេ ឯង តាម ផ្លូវ ទាំង យប់ ជាច្រើន កន្លែង ក្នុង រាជធានី ភ្នំពេញ និង បាន អំពាវនាវ សុំឲ្យ សារព័ត៌មាន ជួយ ផ្សព្វផ្សាយ រក ម្តាយ ខ្លួន ផង បណ្តាលឲ្យ មាន ការភ្ញាក់ផ្អើល គេ ឯង ចាប់អារម្មណ៍ អាណិតអាសូរ គ្រប់ គ្នា ។
( ភ្នំពេញ ) ៖ បុរស ម្នាក់ ត្រូវបាន កម្លាំង ប៉ុស្ដិ៍ រដ្ឋបាល ភ្នំពេញ ថ្មី នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ សែនសុខ ឃាត់ខ្លួន បន្ទាប់ពី រូប គេ បាន ប្រើ ល្បិច លួច លុយ របស់ ក្រុមហ៊ុន ដែល គេ កំពុង បម្រើ ការអស់ ជាង ២៣.០០០ ដុល្លារ នៅ ចំណុច ក្រុមហ៊ុន លក់ ថ្នាំ ពេទ្យ មេដ ហ្វាម ផ្ទះ លេខ ៦០ ផ្លុវ លេខ ១ ភូមិ ឧញ្ញ៉ា វាំង សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ ។
មន្ដ្រី នគរបាល បាន ឲ្យដឹង ថា ជនសង្ស័យ រូប នេះ ឈ្មោះ ឆេង ឌៀប អាយុ ៣២ ឆ្នាំ មុខរបរ បុគ្គលិក ក្រុមហ៊ុន ដូញ ពេញ មេដ ហ្វាម ស្លាក់ នៅ ផ្ទះ ជួល ភូមិ ផ្សារ ទឹក ថ្លា សង្កាត់ ទឹក ថ្លា ខណ្ឌ សែនសុខ បាន ឃាត់ខ្លួន នៅ ល្ងាច ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០១៩ ។ ដោយឡែក ជនរងគ្រោះ ឈ្មោះ កាំ ស ពិសិដ្ឋ ភេទ ប្រុស អាយុ ២៩ ឆ្នាំ មុខរបរ បុគ្គលិក ក្រុមហ៊ុន ដូញ ពេញ មេដ ហ្វាម ក្នុង នោះ សម្ភារ បាត់បង់ លុយ ចំនួន ២៣. ៥០៣ ដុល្លារ ។
សមត្ថកិច្ច បាន បញ្ជាក់ ថា មុនពេល កើត ហេតុ ជនសង្ស័យ បាន ចូល ធ្វើការ នៅក្នុង ក្រុមហ៊ុន ខាងលើ ទទួល ផ្នែក លក់ ថ្នាំ ពេទ្យ ចាប់ពី ឆ្នាំ ២០១៦ និង បាន ប្រមូល លុយ ពី អតិថិជន ដើម្បី ទូទាត់ ឲ្យ ក្រុមហ៊ុន សរុប ចំនួន ២៣. ៥០៣. ៣៤ ដុល្លារ តែ ជនសង្ស័យ មិន បាន យក លុយ ដែល ប្រមូល បាន មក ទូទាត់ ឲ្យ ក្រុមហ៊ុន ឡើយ ។
លុះ ដល់ ថ្ងៃទី ០៣ ខែមិថុនា ឆ្នាំ ២០១៩ ខាង ក្រុមហ៊ុន បាន ដឹក ថា ជនសង្ស័យ ប្រមូល លុយ ពី អតិថិជន បាន ហើយ មិន ប្រគល់ឲ្យ ក្រុមហ៊ុន រហូតដល់ ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០១៩ ជនរងគ្រោះ បាន នាំ ខ្លួន ជនសង្ស័យ ប្រគល់ឲ្យ សមត្ថកិច្ច ប៉ុស្តិ៍ រដ្ឋបាល ភ្នំពេញ ថ្មី ធ្វើ ការសាកសួរ រួច ជនរងគ្រោះ បាន ដាក់ ពាក្យ បណ្តឹង ចោទប្រកាន់ ជនសង្ស័យ តែម្តង ។ បច្ចុប្បន្ន ជនសង្ស័យ កំពុង ឃាត់ខ្លួន នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ សែនសុខ ដើម្បី អនុវត្ត តាម នីតិវិធី ៕
សំរាម តាម ចិញ្ចើមផ្លូវ ជាតិ លេខ ៥ សង្កាត់ គីឡូម៉ែត្រ លេខ ៦ ត្រូវបាន សម្អាត តាម ការណែនាំ ពី អភិបាល ខណ្ឌ ឫស្សីកែវ
ក្នុង ការដឹកនាំ ចង្អុលបង្ហាញ ខាង លើ នេះ លោក ជា ពិសី បាន លើកឡើង ដើម្បី ជំរុញ នៅក្នុង កិច្ចប្រជុំ ក្រុមប្រឹក្សា ខណ្ឌ ក៏ ដូចជា កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព ប្រចាំ ខែ ជាញឹកញាប់ ផងដែរ អំពី អនាម័យ នេះ មាន សារៈសំខាន់ ណាស់ សម្រាប់ សុខភាព ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ សំដៅ លើក ការបោះចោល សំរាម ឱ្យ មាន ការវេច ខ្ចប់ ដាក់ ស្បោង ប្លាស ស្ទិក ត្រឹមត្រូវ ដើម្បីឱ្យ ក្រុមហ៊ុន ស៉ិន ទ្រី មក ប្រមូល យក ក្នុង ការរក្សា សោភ័ណភាព ទីក្រុង ។
៣៖ កិច្ចព្រមព្រៀង និង អនុស្សារណៈ សំខាន់ ៗ ចំនួន ៣ ត្រូវបាន ចុះហត្ថលេខា រវាង រាជ រដ្ឋាភិបាល កម្ពុជា - ហុង គ្រី ក្នុង ដំណើរទស្សនកិច្ច របស់ សម្តេច តេជោ ហ៊ុន សែន ( ចុច អាន )
៥៖ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង និង ផ្ទេរ មុខតំណែង ប្រធាន អនុប្រធាន ចៅក្រម សាលាឧទ្ធរណ៍ និង សាលាដំបូង រាជធានី - ខេត្ត មួយចំនួន ( ចុច អាន )
៧៖ សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ឱ្យ រួមគ្នា ទប់ស្កាត់ ព័ត៌មាន ក្លែង បន្លំ និង ឧក្រិដ្ឋកម្ម ព័ត៌មានវិទ្យា ( ចុច អាន )
៨៖ សម្ដេច ក្រឡាហោម ស ខេង បញ្ជា ឲ្យ សមត្ថកិច្ច ខិតខំ បង្ក្រាប បទល្មើស លាង លុយក ខ្វក់ ខណៈ ដែល កម្ពុជា ត្រូវ ចាត់ទុក ថា ជា ប្រទេស ពណ៌ ប្រផេះ ( ចុច អាន )
៩៖ សម្តេច តេជោ ហ៊ុន សែន ចេញ សេចក្តីសម្រេច តែងតាំង ប្រធាន អនុប្រធាន និង សមាសភាព អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ( ចុច អាន )
ទីប្រឹក្សា សម្ដេច ហេង សំរិន ប្រាប់ និស្សិត សកលវិទ្យាល័យ គ្រប់គ្រង និង សេដ្ឋកិច្ច UME ថា « ភាពជោគជ័យ របស់ មនុស្ស ស្ថិត នៅលើ កម្លាំង កាយ និង ការតាំងចិត្ត »
( កំពង់ចាម ) ៖ លោក មួន វាសនា ទីប្រឹក្សា សម្ដេច ពញ្ញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង ជា ប្រធាន គណៈ គ្រប់គ្រង សកលវិទ្យាល័យ គ្រប់គ្រង និង សេដ្ឋកិច្ច UME បាន លើកឡើង ថា ភាពជោគជ័យ របស់ មនុស្ស គឺ ស្ថិត ទៅ លើ ការប្រើ កម្លាំង២ ពោលគឺ កម្លាំង កាយ និង កម្លាំងចិត្ត ។
ការលើកឡើង របស់ លោក មួន វាសនា បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ ខណៈ ដែល លោក និង លោកស្រី បាន ចូលរួម ជា គណៈអធិបតី ក្នុង ពិធី បើក ការការពារ សារ ណា របស់ និស្សិត នៃ សាកលវិទ្យាល័យ UME ខេត្ត កំពង់ចាម ជិត ២០០ នាក់ ។
ថ្លែង ទៅកាន់ និស្សិត ដែល ត្រូវ ឡើង ការពារ សារ ណា របស់ ខ្លួន ក្នុង ថ្ងៃ នេះ លោក មួន វាសនា បាន បន្ត ថា ដើម្បី ឈាន ទៅរក ការជោគជ័យ និស្សិត យើង ទាំងអស់ ត្រូវតែ មាន សុខភាព ល្អ ពោលគឺ កម្លាំង កាយ រួម នឹង ការតាំងចិត្ត ឱ្យ ក្លាហាន ប្រកបដោយ ឆន្ទៈ មោះ មុត ដើរ ឆ្ពោះ ទៅរក គោល ដៅ របស់ ខ្លួន ជាពិសេស គឺ នៅ ថ្ងៃ ដែល ត្រូវ ឡើង ការពារ សារ ណារ នេះ តែម្តង ។
លោក មួន វាសនា បាន បន្ថែម ទៀត ថា រយៈពេល ៤ ឆ្នាំ នៃ ការសិក្សា ថ្នាក់ បរិញ្ញាបត្រ របស់ និស្សិត យើង បាន ចប់ ប៉ុន្តែ វិជ្ជា ផ្សេង ៗ ទៀត យើង ត្រូវតែ សិក្សា បន្ត ពេញ មួយ ជីវិត របស់ យើង ។
សូម បញ្ជាក់ ដែរ ថា ក្នុង ថ្ងៃ ការពារ សារ ណា នេះ មាន និស្សិត ផ្នែក បរិញ្ញាបត្រ ជាន់ ខ្ពស់ ជំនាន់ ទី៧ ចំនួន ១៥ នាក់ ។ ដោយឡែក និស្សិត ថ្នាក់ បរិញ្ញាបត្រ ជំនាន់ ទី ១៤ មាន ចំនួន ១៨៥ នាក់ ។
លោក ម៉ៅ ឌុង សមាជិក គណៈ គ្រប់គ្រង សាកលវិទ្យាល័យ UME ក៏ បាន ថ្លែង ផ្ដាំ ផ្ញើ ដល់ និស្សិត ទាំងអស់ ដែល ត្រូវ ឡើង ការពារ សារ ណា ថា បន្ទាប់ពី និស្សិត យើង បាន ខិតខំ សិក្សា រៀនសូត្រ អស់ រយៈពេល ៤ ឆ្នាំ លោក សង្ឃឹម ថា ក្នុង ថ្ងៃ នេះ និស្សិត ទាំងអស់ នឹង ខិតខំ ប្រឹងប្រែង ឱ្យ អស់ ពី សមត្ថភាព ដើម្បី ឡើង ការពារ សារ ណា របស់ ខ្លួន ដែល ក្នុង កម្មវិធី នេះ មាន ចំនួន ៦មុខវិជ្ជា ដែល ត្រូវ ការពារ ដើម្បី ឆ្លង ផុត នៃ ក្របខណ្ឌ ថ្នាក់ បរិញ្ញាបត្រ ដែល ប្អូន ៗ បាន ខិតខំ សិក្សា នា ពេល កន្លងមក ៕
អភិបាល ខេត្ត ព្រះវិហារ អំពាវនាវ ឱ្យ ស្ត្រី មាន ផ្ទៃពោះ ឈប់ សម្រាល កូន តាម បែប បុរាណ នៅ ផ្ទះ ត្រូវ មក សម្រាល កូន នៅ មណ្ឌល សុខភាព ដើម្បី សុវត្ថិភាព មាតា និង ទារក
( ព្រះវិហារ ) ៖ អគារ សម្ភព និង បន្ទប់ រង់ចាំ ចំនួន ៤កន្លែង ស្ថិត ក្នុង ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ដែល មាន តម្លៃ ជាង ១០ម៉ឺន ដុល្លារ ត្រូវបាន សម្ភោធ ដាក់ ឱ្យ ប្រើប្រាស់ ក្រោម វត្តមាន លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ ហើយ ឆ្លៀត ក្នុង ឱកាស នោះ លោក អភិបាល ខេត្ត បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ត្រូវ ប្តូរ ឥរិយាបទ ពី សម្រាល កូន ដោយ ឆ្មប បុរាណ តាម ផ្ទះ មក សម្រាល កូន តាម មណ្ឌល សុខភាព វិញ ដើម្បី សុវត្ថិភាព មាតា និង ទារក ។
ពិធី នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក គួង ឡូ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ តាម មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ស្ថិត ក្នុង ភូមិ យាង ឃុំ យាង ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ។
លោក អ៊ុន ចាន់ ដា បាន ថ្លែង ថា បច្ចុប្បន្ន នេះ ក្រសួង សុខាភិបាល បាន ផ្តល់ សំណង់ ដ៏ ច្រើន ជាពិសេស តាម តំបន់ ព្រំដែន ដាច់ស្រយ៉ាល ។ ទាំងនេះ សបញ្ជាក់ ឱ្យ ឃើញ ពី ការយកចិត្តទុកដាក់ របស់ ក្រសួង សុខាភិបាល ជាពិសេស រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដែល តែងតែ គិតគូរ ដល់ សុខភាព និង ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ជាពិសេស នៅ តំបន់ ដាច់ស្រយ៉ាល ។
លោក អភិបាល ខេត្ត ព្រះវិហារ ក៏ បាន សំណូមពរ ឱ្យ មន្ត្រី សុខាភិបាល ទាំងអស់ ខិតខំ បន្ថែម ទៀត ធ្វើ យ៉ាងណា ផ្តល់ សេវា សុខភាព ប្រកបដោយ សមធម៌ សមភាព និង គុណភាព ជូន ដល់ ប្រជាពលរដ្ឋ ដោយ មិន រើសអើង ។ សូម ឱ្យ អជ្ញាធរដែនដី ស្រុក - ឃុំ ភូមិ ជួយ គាំទ្រ សហការ ឱ្យ បាន ល្អ ធ្វើ យ៉ាងណា ឱ្យ អគារ សម្ភព បន្ទប់ រង់ចាំ ថ្មី នេះ ដំណើរការ ទៅ ដោយ រលូន ដើម្បី កាត់បន្ថយ អត្រា ឈឺ របស់ មាតា និង ទារក ឱ្យ ស្រប តាម ផែនការ យុទ្ធសាស្ត្រ ចតុកោណ របស់ រាជ រដ្ឋាភិបាល ។
លោក វេជ្ជបណ្ឌិត គួង ឡូ បាន ឱ្យដឹង ថា អគារ មណ្ឌល សុខភាព និង បន្ទប់ រង់ចាំ ទាំង ៤កន្លែង ដែល សម្ភោធ ដាក់ ឱ្យ ដំណើរការ នៅ ពេល នេះ គឺ ស្ថិត ក្នុង មន្ទីរពេទ្យ បង្អែក ស្រុក ជាំ ក្សាន្ត នៅ មណ្ឌល សុខភាពរុងរឿង៤ នៅ មណ្ឌល សុខភាព យាង និង ប៉ុស្តិ៍ សុខភាព អន្ទឹល ស្ថិត ក្នុង ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ។
សមិទ្ធផល ជូន ជាតិ ជាច្រើន ដូចជា ការពង្រឹក ទំនាក់ទំនង ការទូត សេដ្ឋកិច្ច ពាណិជ្ជកម្ម ទេសចរណ៍ អប់រំ និង វិស័យ មួយចំនួន ទៀត ទាំង ក្របខណ្ឌ ទ្វេ ភាគី និង ពហុ ភាគី សម្រេចបាន ក្នុង ដំណើរទស្ស កិច្ច របស់ សម្តេច តេជោ ហ៊ុន សែន នៅ ប្រទេស ទាំង២នេះ ៕ យល់ដឹង ផ្នែក ច្បាប់៖ បទ ទារុណកម្ម និង អំពើ ឃោរឃៅ
( ភ្នំពេញ ) ៖ តាមរយៈ ការវិវត្ត ពី សម័យកាល មួយ ទៅ សម័យកាល មួយ ការគាំពារ សិទ្ធិ មនុស្ស បាន ក្លាយជា ប្រធានបទ សំខាន់ ដែល ប្រជាជាតិ នីមួយ ៗ បាន យកចិត្តទុកដាក់ និង លើកកម្ពស់ យ៉ាង មុតមាំ ។ នៅក្នុង នោះ ផងដែរ ការរំលោភ លើ សិទ្ធិ បុគ្គល ដោយ ការធ្វើ ទារុណកម្ម និង អំពើ ឃោរឃៅ ជា ទង្វើ អមនុស្សធម៌ ដែល មិន គួរ គប្បី កើតឡើង លើ ជន ណា ម្នាក់ ឡើយ ទោះ ស្ថិត ក្នុង កាល ទេស បែប ណា ក៏ដោយ ។
ដើម្បី យល់ កាន់តែ ច្បាស់ ថា តើ អំពើ ណា ខ្លះ ដែល ត្រូវបាន ចាត់ទុក ថា ជា ការធ្វើ ទារុណកម្ម និង អំពើ ឃោរឃៅ ? ហើយ ជន ដែល ប្រព្រឹត្ត អំពើ បែប នោះ នឹង ត្រូវ ប្រឈមមុខ ជាមួយនឹង ការផ្ដន្ទាទោស ដល់ កម្រិត ណា ? កម្មវិធី យល់ដឹង ផ្នែក ច្បាប់ របស់ អង្គភាព ព័ត៌មាន Fresh News សហការ ជាមួយ ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ នឹង ធ្វើ ការបង្ហាញ និង ចែករំលែក ជូន បងប្អូន ប្រជាពលរដ្ឋ សិស្ស និស្សិត ដូចត ទៅ៖
