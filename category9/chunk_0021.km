( សិង្ហបុរី ) ៖ ទីក្រុង ប៉េកាំង បាន ត្រៀម ខ្លួន រួច ជាស្រេច ក្នុង ការតស៊ូ ប្រយុទ្ធ រហូតដល់ ដង្ហើម ចុងក្រោយ ដើម្បី ការពារ ផលប្រយោជន៍ ជាតិ ហើយ នឹង មិន ស្ទាក់ស្ទើរ ឡើយ ក្នុង ការប្រើប្រាស់ កម្លាំង យោធា បើសិន ជា កងកម្លាំង បរទេស ណាមួយ ហ៊ាន បំផ្លាញ គោល នយោបាយ ចិន តែ មួយ ដោយ យក កោះ តៃវ៉ាន់ ចេញ ពី ចិន ។ នេះ គឺជា ការព្រមាន របស់ រដ្ឋមន្ត្រី ការពារ ជាតិ ចិន ដកស្រង់ ចេញផ្សាយ ដោយសារព័ត៌មាន RT នៅ ថ្ងៃអាទិត្យ ទី ០២ ខែមិថុនា ឆ្នាំ ២០១៩ ។
តែ ទោះជា យ៉ាង នេះ ក្ដី រដ្ឋមន្ត្រី ការពារ ជាតិ ចិន រូប នេះ ក៏ បាន អះអាង ដែរ ថា ចិន និង សហរដ្ឋ អាមេរិក សុទ្ធតែ ដឹង យ៉ាង ច្បាស់ ថា សង្រ្គាម នឹង បង្ក ជា គ្រោះមហន្តរាយ ធ្ងន់ធ្ងរ ហើយ ម្យ៉ាង វិញ ទៀត ទីក្រុង ប៉េកាំង បាន ប្ដេជ្ញាចិត្ត ជានិច្ច ក្នុង កិច្ចការពារ សន្តិភាព និង ស្ថេរភាព នៅក្នុង តំបន់ ។
( ភ្នំពេញ ) ៖ ថ្ងៃទី ១ មិថុនា នេះ ជា ថ្ងៃ ឈប់សម្រាក ដើម្បី អបអរសាទរ ទិវា កុមារ អន្តរជាតិ ។ ពេលព្រឹក ឡើង ខ្ញុំ បើក ហ្វេសប៊ុក ឃើញ តែ ការ បង្ហោះ សារ អបអរសាទរ ទិវា កុមារ អន្តរជាតិ អម ដោយ រូបថត ឪពុក ម្តាយ នាំ កូន ជាទីស្រឡាញ់ របស់ ខ្លួន ដើរកម្សាន្ត នៅ គ្រប់ ច្រកល្ហក ។ រមណីយដ្ឋាន ទេសចរណ៍ នានា ពោរពេញ ដោយ មនុស្ស ណែន ណាន់ តាន់ តាប់ និង លឺ តែ សំឡេង សើច សប្បាយ ជួបជុំ គ្រួសារ បងប្អូន កូន ចៅ ដើម្បី ហូប ម្ហូប អាហារ យ៉ាង សម្បូរបែប និង យ៉ាង សប្បាយរីករាយ ។
ដោយ៖ អ្នកតាមដាន នយោបាយ តុកាហ្វេ ចិន ចាប់ផ្តើម អនុវត្តន៍ ការដំឡើង ពន្ធ លើ ទំនិញ របស់ អាមេរិក ដែល គិត ជា ទំហំ ទឹកប្រាក់ ស្មើនឹង ៦០ ពាន់ លាន ដុល្លារ
( ប៉េកាំង ) ៖ បើ តាម សេចក្តីថ្លែងការណ៍ របស់ គណៈកម្មការ ពន្ធ គយ នៃ ក្រុមប្រឹក្សា រដ្ឋ ចិន រដ្ឋាភិបាល ទីក្រុង ប៉េកាំង នា ថ្ងៃសៅរ៍ នេះ បាន ចាប់ផ្តើម អនុវត្តន៍ ចំណាត់ការ ដំឡើង ពន្ធ បន្ថែម ទៅ លើ ផលិតផល មួយចំនួន ដែល នាំចូល ពី សហរដ្ឋ អាមេរិក ។ នេះ បើ តាម ការ ដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ យប់ ថ្ងៃសៅរ៍ ទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩ ។
សេចក្តីថ្លែងការណ៍ ខាង លើ បាន បញ្ជាក់ ប្រាប់ ថា ក្នុង ចំណោម មុខ ទំនិញ ទាំងនោះ របស់ អាមេរិក ដែល គិត ជា ទំហំ ទឹកប្រាក់ ស្មើនឹង ៦០ ពាន់ លាន ដុល្លារ មាន ខ្លះ ត្រូវបាន បង្កើន អត្រា នៃ ការយក ពន្ធ ដល់ ២៥ ភាគរយ ខ្លះ ដល់ ២០ ភាគរយ និង ខ្លះ ទៀត ដល់ ១០ភាគរយ ប៉ុន្តែ ពុំ មាន ការបញ្ជាក់ ជា ទំនិញ ប្រភេទ អ្វី ខ្លះ នៅឡើយ ទេ ។
គួរ ជម្រាប ថា ទីក្រុង ប៉េកាំង បាន សម្រេច ធ្វើ បែប នេះ បន្ទាប់ពី ទីក្រុង វ៉ាស៊ីនតោន បាន ដំឡើង ពន្ធ លើ ទំនិញ របស់ ចិន ទំហំ ប្រមាណ ២០០ ពាន់ លាន ដុល្លារ ពី អត្រា ១០ភាគរយ ទៅដល់ ២៥ ភាគរយ កាលពី ថ្ងៃទី ១០ ខែឧសភា ក្រោយពី កិច្ចចរចា សង្រ្គាម ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ បានជាប់គាំង ៕
នាយក រដ្ឋមន្ដ្រី ចិន ប្រកាស ជាថ្មី ថា នឹង បន្ដ ជួយ ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច កម្ពុជា ដោយ ឈរ លើ មូលដ្ឋាន គោរព គ្នា ទៅ វិញ ទៅ មក ស្មើភាព គ្នា
ក្រសួង ការបរទេស បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ឯកឧត្តម នាយក រដ្ឋមន្រ្តី លី ខឺ ឈាង បាន អះអាង ជា ថី្ម ថា ប្រទេស ចិន នឹង បន្ត ជួយ ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម របស់ កម្ពុជា ហើយ នឹង គាំទ្រ ឲ្យបាន ជោគជ័យ នូវ កិច្ចប្រជុំ កំពូល អាស៊ី - អឺរ៉ុប លើក ទី ១៣ នៅ ប្រទេស កម្ពុជា ក្នុង ឆ្នាំ ២០២០ ខាងមុខ នេះ » ។
បន្ថែម ពី នេះ នាយក រដ្ឋមន្ដ្រី លី ខឺ ឈាង បាន ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ ទស្សនកិច្ច ផ្លូវការ លើក ទី១ របស់ ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន នៅ សាធារណរដ្ឋ ប្រជាមានិត ចិន និង បាន បង្ហាញ នូវ ការពេញចិត្ត យ៉ាង ខ្លាំង ចំពោះ ការរឹតបន្តឹង ទំនាក់ទំនង ជា ប្រពៃណី យូរអង្វែង រវាង កម្ពុជា និង ចិន ឲ្យ កាន់តែ មាន ភាពរឹងមាំ ឈរ លើ មូលដ្ឋាន នៃ ការគោរព គ្នា ទៅ វិញ ទៅ មក ដោយ ស្មើភាព និង កិច្ចសហប្រតិបត្តិការ ឈ្នះ ឈ្នះ ។
ជាមួយគ្នា នេះ ឧប នាយក រដ្ឋមន្ដ្រី ប្រាក់ សុខុន បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការរួមចំណែក ដ៏ ធំធេង របស់ ចិន ដល់ វឌ្ឍនភាព ប្រទេស កម្ពុជា លើ វិស័យ ជាច្រើន ហើយ បាន អះអាង ជាថ្មី អំពី ការប្តេជ្ញាចិត្ត ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ក្នុង ក្របខ័ណ្ឌ ទ្វេ ភាគី តំបន់ និង អន្តរជាតិ ដែល មាន ជាអាទិ៍ កិច្ចសហប្រតិបត្តិការ មេគង្គ - ឡាង ឆាង អាស៊ាន និង ក្របខ័ណ្ឌ អង្គការ សហ ប្រជាជាតិ ៕
ទីប្រឹក្សា រដ្ឋ និង ជា រដ្ឋមន្រ្តី ការបរទេស ចិន៖ មហា មិត្ត ចិន នឹង ខិតខំ អស់ លទ្ធភាព លើកទឹកចិត្ត ក្រុមហ៊ុន ចិន មក បណ្តាក់ទុន វិនិយោគ កាន់តែ ច្រើន ថែម នៅ កម្ពុជា និង ពង្រីក ច្រក ទីផ្សារ ចិន សម្រាប់ ផលិតផល កម្ពុជា
( ភ្នំពេញ ) ៖ លោក វ៉ាង យី ទីប្រឹក្សា រដ្ឋ និង ជា រដ្ឋមន្រ្តី ក្រសួង ការបរទេស ចិន បាន លើកឡើង ថា ប្រទេស ចិន នឹង ខិតខំ អស់ លទ្ធភាព ក្នុង ការលើកទឹកចិត្ត ក្រុមហ៊ុន ចិន ឲ្យ មក បណ្តាក់ទុន វិនិយោគ កាន់ តែ ច្រើន ថែម ទៀត នៅ កម្ពុជា និង ពង្រីក ច្រក ទីផ្សារ ចិន សម្រាប់ ផលិតផល កម្ពុជា ហើយ ទន្ទឹម គ្នា នេះ ជួយ គាំទ្រ ដល់ កំណែទំរង់ ដែល កំពុង អនុវត្ត នៅ កម្ពុជា សំដៅ ធ្វើ ពិពិធកម្ម ឧស្សាហកម្ម និង លើកកម្ពស់ សមត្ថភាព ប្រកួតប្រជែង ផ្នែក ធុរកិច្ច ។
រដ្ឋមន្រ្តី ការបរទេស ទាំង ពីរ បាន ឯកភាព ធ្វើ ការរួមគ្នា ជិតស្និទ្ធ ដើម្បី ធានា ការ អនុវត្ត ឲ្យបាន ជោគជ័យ នូវ ផែនការ សកម្មភាព កសាង សហគមន៍ មាន អនាគត រួមគ្នា កម្ពុជា - ចិន ឆ្នាំ ២០១៩ - ២០២៣ ដែល បាន ចុះហត្ថលេខា កាលពី ខែមេសា ឆ្នាំ នេះ ក្នុង គោលបំណង នាំមក នូវ កិច្ចសហប្រតិបត្តិការ សន្តិសុខ - នយោបាយ កាន់តែ ស្អិត រមួត ពង្រីក ទំនាក់ទំនង សេដ្ឋកិច្ច ពាណិជ្ជកម្ម និង វិនិយោគ និង ជម្រុញ កំណើន ការផ្លាស់ប្តូរ ទេសចរណ៍ និង វប្បធម៌ ។
សូម ជំរាប ថា ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ កម្ពុជា បាន បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ សាធារណរដ្ឋ ប្រជាមានិត ចិន ចាប់ពី ថ្ងៃទី៣០ ខែឧសភា - ០១ ខែមិថុនា ឆ្នាំ ២០១៩៕ ក្រសួង ការបរទេស ចេញផ្សាយ លទ្ធផល នៃ ទស្សនកិច្ច ផ្លូវការ របស់ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន នៅ សាធារណរដ្ឋ ប្រជាមានិត ចិន
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ ក្រសួង ការបរទេស កម្ពុជា បាន ចេញផ្សាយ សេចក្តីប្រកាស ព័ត៌មាន អំពី លទ្ធផល នៃ ទស្សនកិច្ច ផ្លូវការ របស់ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ ម្ពុជា នៅ សាធារណរដ្ឋ ប្រជាមានិត ចិន ពី ថ្ងៃទី៣០ ខែឧសភា - ០១ ខែមិថុនា ឆ្នាំ ២០១៩ ។
សេចក្តីប្រកាស ព័ត៌មាន ទាំងស្រុង របស់ ក្រសួង ការបរទេស កម្ពុជា៖
សេចក្តីប្រកាស ព័ត៌មាន លទ្ធផល នៃ ទស្សនកិច្ច ផ្លូវការ របស់ ឯកឧត្ដម ប្រាក់ សុខុន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ ព្រះរាជាណាចក្រ កម្ពុជា នៅ សាធារណរដ្ឋ ប្រជាមានិត ចិន ថ្ងៃទី ៣០ ខែឧសភា - ០១ ខែមិថុនា ឆ្នាំ ២០១៩
ឯកឧត្តម ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ដឹកនាំ គណៈប្រតិភូ ទៅ បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ សាធារណរដ្ឋ ប្រជាមានិត ចិន ពី ថ្ងៃទី៣០ ខែឧសភា ដល់ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩ ដោយ ឱកាស នោះ ឯកឧត្តម ឧប នាយក រដ្ឋមន្រ្តី បាន ចូល ជួប សម្តែង ការគួរសម ជាមួយ ឯកឧត្តម នាយក រដ្ឋមន្រ្តី លី ខឺ ឈាង និង ជួបប្រជុំ ទ្វេ ភាគី ជាមួយ ឯកឧត្តម វ៉ាង យី ទីប្រឹក្សា រដ្ឋ និង ជា រដ្ឋមន្រ្តី ការបរទេស នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
ឯកឧត្តម ប្រាក់ សុខុន បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការរួមចំណែក ដ៏ ធំធេង របស់ ចិន ដល់ វឌ្ឍនភាព ប្រទេស កម្ពុជា លើ វិស័យ ជាច្រើន ហើយ បាន អះអាង ជាថ្មី អំពី ការប្តេជ្ញាចិត្ត ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ក្នុង ក្របខ័ណ្ឌ ទ្វេ ភាគី តំបន់ និង អន្តរជាតិ ដែល មាន ជាអាទិ៍ កិច្ចសហប្រតិបត្តិការ មេគង្គ - ឡាង ឆាង អាស៊ាន និង ក្របខ័ណ្ឌ អង្គការ សហ ប្រជាជាតិ ។
កិច្ចពិភាក្សា ទ្វេ ភាគី រវាង ឯកឧត្តម ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន និង ឯកឧត្តម ទីប្រឹក្សា រដ្ឋ វ៉ាង យី បាន ប្រព្រឹត្តទៅ ក្នុង បរិយាកាស ដ៏ ស្និទ្ធស្នាល និង គ្របដណ្តប់ ទៅ លើ វិស័យ ជាច្រើន ។ ឯកឧត្តម រដ្ឋមន្រ្តី ការបរទេស ទាំង ពីរ បាន យល់ស្រប គ្នា ថា ទំនាក់ទំនង និង ទំនុកចិត្ត ផ្នែក នយោបាយ រវាង កម្ពុជា និង ចិន ដែល បច្ចុប្បន្ន ល្អ ប្រសើរ ជាង ពេល ណា ៗ ទាំងអស់ គឺ ដោយសារតែ មាន ការផ្លាស់ប្តូរ ទស្សនកិច្ច កំរិត ខ្ពស់ ជាញឹកញាប់ ដូច្នេះ គួរតែ បន្ត រក្សា ការអនុវត្ត នេះ ។
ភាគី ទាំង ពីរ បាន ឯកភាព ធ្វើ ការរួមគ្នា ជិតស្និទ្ធ ដើម្បី ធានា ការ អនុវត្ត ឲ្យបាន ជោគជ័យ នូវ ផែនការ សកម្មភាព កសាង សហគមន៍ មាន អនាគត រួមគ្នា កម្ពុជា - ចិន ឆ្នាំ ២០១៩ - ២០២៣ ដែល បាន ចុះហត្ថលេខា កាលពី ខែមេសា ឆ្នាំ នេះ ក្នុង គោលបំណង នាំមក នូវ កិច្ចសហប្រតិបត្តិការ សន្តិសុខ - នយោបាយ កាន់តែ ស្អិត រមួត ពង្រីក ទំនាក់ទំនង សេដ្ឋកិច្ច ពាណិជ្ជកម្ម និង វិនិយោគ និង ជម្រុញ កំណើន ការផ្លាស់ប្តូរ ទេសចរណ៍ និង វប្បធម៌ ។
ចំពោះ កិច្ចសហប្រតិបត្តិការ អាស៊ាន - ចិន រដ្ឋមន្រ្តី ការបរទេស ទាំង ពីរ បាន ប្តេជ្ញាចិត្ត សហការ ជិតស្និទ្ធ ជាមួយ ប្រទេស សមាជិក អាស៊ាន ផ្សេង ទៀត ដើម្បី ពង្រឹង ភាពជាដៃគូ យុទ្ធសាស្រ្ត អាស៊ាន - ចិន និង បាន យល់ស្រប គ្នា ថា គួរ គិត ពិចារណា អំពី លទ្ធភាព ជម្រុញឲ្យ មាន ថាមពល រួមគ្នា រវាង គំនិត ផ្តួចផ្តើម ខ្សែក្រវាត់ និង ផ្លូវ និង ផែនការ មេស្តីពី ការតភ្ជាប់ អាស៊ាន ដើម្បី ផលប្រយោជន៍ សម្រាប់ ការអភិវឌ្ឍ ក្នុង តំបន់ ។
ចំពោះ បញ្ហា សមុទ្រ ចិន ខាងត្បូង ភាគី ទាំង ពីរ បាន អះអាង ជាថ្មី អំពី ការគាំទ្រ ការអនុវត្ត សេចក្តីថ្លែងការណ៍ ស្ដីពី ការប្រតិបត្តិ របស់ បណ្ដា ភាគី នៅ សមុទ្រ ចិន ខាងត្បូង (DOC) ឲ្យបាន ពេញលេញ និង មាន ប្រសិទ្ធភាព និង ភាពចាំបាច់ ត្រូវ រក្សា សន្ទុះ រីកចម្រើន នៃ កិច្ចសន្ទនា អាស៊ាន - ចិន និង កិច្ចប្រឹងប្រែង រួមគ្នា ដើម្បី សម្រេច ឲ្យបាន នូវ ក្រម ប្រតិបត្តិ នៅ សមុទ្រ ចិន ខាងត្បូត (COC) ក្នុង រយៈពេល បី ឆ្នាំ តាម សំណើ របស់ ភាគី ចិន ។
ភាគី ទាំង ពីរ ក៏ បាន ពិភាក្សា យ៉ាង ទូលំទូលាយ ពី ការវិវឌ្ឍ នៃ និម្មាប នកម្ម តំបន់ ផល ប៉ះពាល់ នៃ សង្រ្គាម ពាណិជ្ជកម្ម ចិន - អាមេរិក និង ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ថែម ទៀត នៅក្នុង វេទិកា អន្តរជាតិ ក៏ ដូចជា ការរួមចំណែក ដល់ សន្តិភាព សនិ្ត សុខ និង ការអភិវឌ្ឍ ក្នុង តំបន់ និង ពិភពលោក ។
ឯកឧត្តម ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន បាន ថ្លែងអំណរគុណ ចំពោះ ឯកឧត្តម វ៉ាង យី ដែល បាន ផ្តល់ បដិស ណ្ធារកិច្ច យ៉ាង រាក់ទាក់ ក្នុង អំឡុង ពេល ឯកឧត្តម ឧប នាយក រដ្ឋមន្រ្តី ស្នាក់ នៅ ទីក្រុង ប៉េកាំង ៕ ថ្ងៃសៅរ៍ ១៤រោច ខែពិសាខ ឆ្នាំ កុរ ឯកស័ក ព .ស ២៥៦៣ រាជធានី ភ្នំពេញ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩
គួរ បញ្ជាក់ ថា បើ តាម អ្នកជំនាញ ក្នុង រោងចក្រ ការផ្ទុះ ដ៏ កក្រើក នេះ ទំនងជា ត្រូវបាន បង្កឡើង ដោយ កត្តា ខុស បច្ចេកទេស ហើយ បើសិនជា មិន អាច ដោះស្រាយ បាន ទៀត នោះ វា នឹង អាច កើតមាន ការផ្ទុះ ជា បន្តបន្ទាប់ ទៀត ៕
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០១ ខែមិថុនា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៦១១ គ្រឿង និង ផាក ពិន័យ ៤០១ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន គ្រឿង ៣.៧១៩ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៦១១ គ្រឿង ( ម៉ូតូ ៧១ %) អប់រំ២១០ គ្រឿង និង ផាក ពិន័យ ៤០១ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ០១ ខែមិថុនា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ១. ៧៥៦ គ្រឿង . អប់រំ១២២ គ្រឿង និង ផាក ពិន័យ ៣០១ គ្រឿង ។
បន្ទាប់ពី មាន ការចាប់អារម្មណ៍ កាន់តែ ច្រើន ពី ពលរដ្ឋ ជាពិសេស យុវវ័យ ថ្នាក់ រៀន នេះ កាន់តែ មាន សិស្ស រៀន កើនឡើង ជារៀងរាល់ ថ្ងៃ ។ មិន តែ ប៉ុណ្ណោះ សម្រាប់ អ្នក ដែល បាន យល់ដឹង អំពី ការធ្វើ សមាធិ ក៏ តែងតែ ស្នើ ទៅកាន់ លោក នឹម ឈុន្នី និង ព្រះតេជគុណ គូ សុភាព ឲ្យ បង្កើត សៀវភៅ បង្រៀន អំពី ការធ្វើ សមាធិ ដើម្បី ជួយ សម្រួល ដល់ សិស្ស ដែល មិន មាន ពេល មក រៀន សមាធិ អាច មាន ឱកាស យល់ដឹង អំពី ការធ្វើ សមាធិ តាមរយៈ ការអាន និង អាច អនុវត្ត បាន នៅ គ្រប់ ទីកន្លែង ដែល មាន ពេល សម្រាប់ ធ្វើ សមាធិ ។
អស់ រយៈពេល ជិត ២ឆ្នាំ កន្លងមក ទើប ព្រះតេជគុណ គូ សុភាព និង លោក នឹម ឈុន្នី បាន សហការនិពន្ធ សៀវភៅ មួយ ក្បាល ឡើង ដែល មាន ឈ្មោះ ថា « សមាធិ ដើម្បី ថាមពល ជីវិត » ។ នៅលើ គ្រប សៀវភៅ ដែល មាន រូបថត នៃ ស្នាមញញឹម ដែល ពោ ពេញ ទៅ ដោយ ក្ដីសង្ឃឹម របស់ ព្រះតេជគុណ គូ សុភាព និង លោក នឹម ឈុន្នី ដែល សុទ្ធតែ ជា អ្នក មាន ចំណេះដឹង ខ្ពស់ ពី ការធ្វើ សមាធិ និង ព្រះធម៌ ។ សៀវភៅ ដែល ចំនួន ២៣១ ទំព័រ មាន សន្លឹក ព័ណ៍ គគី ស្រាល មួយ នេះ ត្រូវបាន លោក នឹម ឈុន្នី ថ្លែង ឲ្យដឹង ថា បង្កើត ទៅ លើ កត្តា ៣ដូចជា ...
ទី២ និយាយ អំពី ព្រះធម៌ និង មាគ៌ា ជីវិត ជា សាច់រឿងរ៉ាវ មួយចំនួន ដែល ឆ្លុះបញ្ជាំង អំពី ជីវិត ព្រះធម៌ និង ជីវិត ប្រចាំ ថ្ងៃ ថា ធ្វើ របៀប មិច ប្រកបដោយ ភាពរីករាយ ធ្វើ របៀប ម៉េច ប្រកបដោយ សុខ សន្តិភាព ហើយ រស់ នៅ ប្រកបដោយ ចិត្ត ទូលាយ ដោយ មិន ប្រកាន់ ច្រើន ។
សៀវភៅ « សមាធិ ដើម្បី ថាមពល ជីវិត » ត្រូវបាន អ្នក អាន បង្ហាញ ការចាប់អារម្មណ៍ ថា មាន ឃ្លា ដែល លើកទឹកចិត្ត និង ឃ្លា ដែល ព្យាបាល ដោយ ក្នុង នោះ មាន សមាធិ ដែល ជា វិធីសាស្រ្ត បុរាណ ក្នុង ការរំដោះ ទុក្ខ ព្រោះ អ្នក ដែល មាន សមាធិ គឺជា មនុស្ស ដែល មាន ភាព មេត្តា ធម៌ នៅក្នុង ខ្លួន ។ នេះ បើ តាម ការលើកឡើង របស់ លោក វ៉ាត គឹម នី ដែល ជា គ្រូបង្ហាត់ ធូហ្កា មួយ រូប ។
អតីត ស្ត្រី ទី មួយ នៃ ប្រទេស ឥណ្ឌូណេស៊ី ទទួលមរណភាព ហើយ ក្នុង មន្ទីរពេទ្យ សិង្ហបុរី
( ហ្សាការតា ) ៖ អតីត ស្ត្រី ទី មួយ នៃ ប្រទេស ឥណ្ឌូណេស៊ី ដែល ជា ភរិយា របស់ អតីត ប្រធានាធិបតី លោក ស៊ូស៊ីឡូបាំ បាំង យូដូយូណូ បាន ទទួលមរណៈភាព ហើយ នៅ អាយុ ៦៧ ឆ្នាំ ក្នុង មន្ទីរពេទ្យ មួយ នៃ ប្រទេស សិង្ហបុរី ខណៈ ប្រធានាធិបតី ឥណ្ឌូណេស៊ី លោក ចូកូ វីដូដូ បាន ចេញ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព នេះ ភ្លាម ៗ ពី រដ្ឋធានីហ្សាការតា ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន ហ្សាការតា ប៉ុស្តិ៍ នា រសៀល ថ្ងៃសៅរ៍ ទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩ ។
( ភ្នំពេញ ) ៖ បុរី ភ្នំពេញ ថ្មី បាន បន្ដ បើក ការដ្ឋាន សាងសង់ គម្រោង ទី១០ របស់ ខ្លួន ជា ផ្លូវការ ហើយ នៅ ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ បន្ទាប់ពី ទទួលបាន ការគាំទ្រ ច្រើន ពី អតិថិជន ។
អ្នកនាង ណាំ ម៉ារី តំណាង ផ្នែក លក់ បុរី ភ្នំពេញ ថ្មី បាន ឲ្យដឹង ថា បុរី ភ្នំពេញ ថ្មី គម្រោង ទី១០នេះ បាន សាងសង់ ឡើង លើ ទីតាំង ដែល មាន សក្ដានុពល . មាន ទីប្រជុំជន . មាន សាលារៀន . មន្ទីរពេទ្យ . ផ្សារ ទំនើប ដែល ងាយស្រួល ក្នុង ការរស់ នៅ ។
អ្នកនាង បន្ដ ថា ជាក់ស្ដែង សម្រាប់ គម្រោង បុរី ភ្នំពេញ ថ្មី នេះ នឹង ទទួលបាន ការគាំទ្រ ច្រើន ពី អតិថិជន ដូច គម្រោង ដទៃ ទៀត ដែរ ។ ជាក់ស្ដែង គម្រោង នេះ នឹង លក់ អស់ ត្រឹម រយៈពេល ៦ខែ ។
អ្នកនាង គីម ងីន ប្រធាន ក្រុម ផ្នែក លក់ បុរី ភ្នំពេញ ថ្មី ជាក់ស្ដែង សម្រោប់ គម្រោង ទី១០ នៃ បុរី ភ្នំពេញ ថ្មី នេះ មាន ប្រមូសិន ពិសេស ៗ ជូន ដល់ អតិថិជន ប្រសិនបើ ពួក គាត់ ជាវ ក្នុង ពេល បច្ចុប្បន្ន នេះ ក្រុមហ៊ុន មាន ការបញ្ចុះ តម្លៃ ចាប់ពី ៥ ពាន់ ដុល្លារ ដល់ ១ម៉ឺន ដុល្លារ ពិសេស ជាង នេះ ទៀត គឺ ក្រុមហ៊ុន បញ្ចុះ៣- ៥% ពីលើ ទឹកប្រាប់ ដែល បាន បញ្ចុះ ថែម ទៀត ។
អ្នកនាង បន្ដ ទៀត ថា បុរី ភ្នំពេញ ថ្មី ទទួលបាន ការគាំទ្រ ច្រើន នេះ ផ្អែក ទៅ លើកកត្តា ផ្សេង ៗ រួម មាន៖ បុរី ភ្នំពេញ ថ្មី ផ្ដោត លើ គុណភាព ជា ចម្បង . ទីតាំង ល្អ . បុរី មាន ភាពស្រស់ សា្អត ទាន់សម័យ និង ទាក់ទាញ ៕
ការផ្សព្វផ្សាយ ចោទប្រកាន់ មក លើ កម្ពុជា បាន ធ្វើឡើង ជា បន្តបន្ទាប់ នៅលើ សារព័ត៌មាន អនឡាញ មួយចំនួន ដែល មាន ប្រភព មិន ច្បាស់លាស់ បន្ទាប់ពី អនុប្រធានាធិបតី អាមេរិក លោក ម៉ៃ ផេន បាន បង្ហាញ ការសង្ស័យ ថា មាន មូលដ្ឋាន ទ័ព ចិន នៅលើ ទឹកដី កម្ពុជា ។
ពាក់ព័ន្ធ នឹង មូលដ្ឋាន ទ័ព បរទេស នេះ . សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ធ្លាប់ បាន បញ្ជាក់ ជំហរ យ៉ាង ច្បាស់ រួចហើយ ថា រាជ រដ្ឋាភិបាល កម្ពុជា មិន អនុញ្ញាតឲ្យ មាន មូលដ្ឋាន ទ័ព បរទេស នៅលើ ទឹកដី កម្ពុជា នោះ ឡើយ ហើយ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ក៏ បាន ប្រកាស ទៀត ថា កម្ពុជា ក៏ មិន កែប្រែ រដ្ឋធម្មនុញ្ញ ដើម្បី អនុញ្ញាតឱ្យ មាន មូលដ្ឋាន ទ័ព បរទេស ឬ បញ្ជូន យោធា កម្ពុជា ទៅ ក្រៅ ប្រទេស ក្រៅពី បេសកកម្ម ជាមួយ អង្គការ សហ ប្រជាជាតិ ផងដែរ ៕
អ៊ីរ៉ង់ ប្រាប់ អាមេរិក៖ គ្រាប់ កាំភ្លើង បាញ់ ចេញ តែ មួយ គ្រាប់ នៅ ឈូង សមុទ្រ ពែក នឹង ធ្វើឱ្យ ប្រេង ឡើង ថ្លៃ ខ្ពស់ ជាង ១០០ ដុល្លារ ( ឡុងដ៍ ) ៖ មន្ត្រី ជាន់ ខ្ពស់ អ៊ីរ៉ង់ ម្នាក់ នៅ ថ្ងៃអាទិត្យ នេះ បាន ឱ្យដឹង ថា បើសិនជា ជម្លោះ រវាង សហរដ្ឋ អាមេរិក និង អ៊ីរ៉ង់ នៅឯ តំបន់ ឈូង សមុទ្រ ពែក ផ្ទុះឡើង នោះ វា នឹង ធ្វើឱ្យ តម្លៃ ប្រេង ហក់ ឡើង ខ្ពស់ ជាង ១០០ ដុល្លារ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃអាទិត្យ ទី ០២ ខែមិថុនា ឆ្នាំ ២០១៩ ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃសៅរ៍ ប្រធានាធិបតី អ៊ីរ៉ង់ លោក ហាសាន់ រូហានី បាន អះអាង ថា ទីក្រុង តេហេរ៉ង់ នឹង បើក ទ្វារ ចរចា ជាមួយ សហរដ្ឋ អាមេរិក បើ ទីក្រុង វ៉ាស៊ីនតោន បង្ហាញ ការគោរព ដល់ អ្នកដទៃ និង អនុវត្ត តាម ច្បាប់ អន្តរជាតិ ៕ អ្នកធ្វើការ ក្នុង វិស័យ ទេសចរណ៍ នៅ សៀមរាប រួមគ្នា បង្កើត ព្រឹត្តិការណ៍ ប្រកួត បាល់ ប្រមូល ថវិកា បាន ជាង ១ម៉ឺន ដុល្លារ ជួយ មន្ទីរពេទ្យ កុមារ អង្គរ
( សៀមរាប ) ៖ ក្រុម អ្នក ធ្វើការ និង ធ្វើ អាជីវកម្ម ក្នុង វិស័យ ទេសចរណ៍ ជាច្រើន នាក់ នៅក្នុង ខេត្ត សៀមរាប នៅក្នុង ថ្ងៃ ទិវា កុមារ អន្តរជាតិ នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩ ម្សិលមិញ នេះ បាន រួមគ្នា បើក ការប្រកួត បាល់ទាត់ រៃ អង្គាស ថវិកា បាន ជាង ១ម៉ឺន ដុល្លារ សហរដ្ឋ អាមេរិក ជួយ ដល់ មន្ទីរពេទ្យ កុមារ អង្គរ ដែល ជា មន្ទីរពេទ្យ ព្យាបាល ដោយ ឥត គិត ថ្លៃ នៅក្នុង ខេត្ត សៀមរាប ។
បើ តាម លោក ឈាង ផល្លា តំណាង គណៈកម្មាការប្រកួត ពានរង្វាន់ មនុស្សធម៌ នេះ បាន ឱ្យដឹង ថា ការប្រកួត បាល់ទាត់ ដើម្បី រៃ អង្គាស ថវិកា សម្រាប់ សកម្ម មនុស្សធម៌ ត្រូវបាន បង្កើតឡើង រយៈពេល ៤ឆ្នាំ ហើយ គិត ត្រឹម ឆ្នាំ ២០១៩។ លោក ផល្លា បាន ឱ្យដឹង ថា កម្មវិធី ប្រកួត នេះ បង្កើតឡើង ដោយ អ្នកបម្រើ ការងារ និង ធ្វើ អាជីវកម្ម ទេសចរណ៍ ដែល ស្រឡាញ់ ការលេង បាល់ទាត់ នៅក្នុង ខេត្ត សៀមរាប មិន មែន ជា អ្នកលេង បាល់ អាជីព នោះ ទេ ។
ការប្រកួត បាល់ទាត់ ដើម្បី សកម្មភាព សប្បុរសធម៌ នៅ ឆ្នាំ នេះ មាន ១៤ ក្រុម ប្រកួតប្រជែង ដែល ជា ចំនួន ច្រើន ជាង បណ្តា ឆ្នាំ កន្លងទៅ ។ ការប្រកួត នេះ មាន រយៈពេល ១ ខែ ហើយ ត្រូវ បញ្ចប់ នៅ ខែកក្កដា ។
សូម បញ្ជាក់ ថា មន្ទីរពេទ្យ កុមារ អង្គរ គឺជា មន្ទីរពេទ្យ សប្បុរសធម៌ ផ្តល់ សេវា ព្យាបាល ដោយ ឥត គិត ថ្លៃ ហើយ ត្រូវបាន បង្កើតឡើង នៅ ឆ្នាំ ១៩៩៩ ។ ក្នុង រយៈពេល ប្រមាណ ២០ ឆ្នាំ នេះ មន្ទីរពេទ្យ បាន ផ្តល់ សេវា ព្យាបាល កុមារ ជាង ២លាន ករណី ។ ក្នុង មួយ ថ្ងៃ មន្ទីរពេទ្យ នេះ ព្យាបាល កុមារ ចន្លោះ ពី ៥០០ ទៅ ៦០០ នាក់ ហើយ ត្រូវ ចំណាយ ថវិកា ប្រមាណ ៦. ៥លាន ដុល្លារ អាមេរិក ។
គួរ បញ្ជាក់ ថា បច្ចុប្បន្ន ទំនាក់ទំនង រវាង សហរដ្ឋ អាមេរិក និង ចិន កំពុង មាន ភាពតានតឹង យ៉ាង ខ្លាំង ដោយសារ ជម្លោះ ពាណិជ្ជកម្ម និង បញ្ហា កោះ តៃវ៉ាន់ រួមទាំង តំបន់ សមុទ្រ ចិន ខាងត្បូង ជា ទី ដែល នាវា ចម្បាំង អាមេរិក តែងតែ បង្ហាញ ខ្លួន ធ្វើឱ្យ ចិន ក្ដៅក្រហាយ ៕ ចាប់ខ្លួន ជនជាតិ ចិន ម្នាក់ បញ្ជូន ទៅ តុលាការ ក្រោយ បោក យក រថយន្ត ឡង់ គ្រីស័រ១ គ្រឿង របស់ ជនជាតិ ចិន ដូចគ្នា ហើយ គេច ខ្លួន ៤ ឆ្នាំ (Video inside)
( ភ្នំពេញ ) ៖ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បញ្ជូន បុរស ជនជាតិ ចិន ម្នាក់ ទៅកាន់ តុលាការ ពាក់ព័ន្ធ នឹង រំលោភ លើ សេចក្តីទុកចិត្ត ដោយ ជួល រថយន្ត ម៉ាក ឡង់ គ្រីស័រ១ គ្រឿង ពី បុរស ជនជាតិ ចិន ដូចគ្នា ម្នាក់ ទៀត ហើយ យក ទៅ បាត់ អស់ រយៈពេល ៤ឆ្នាំ ។ ករណី ចាប់ខ្លួន នេះ បាន ធ្វើឡើង កាលពី ព្រឹក ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០១៩ នៅក្នុង ហាង បាយ ស្ថិត នៅក្នុង ភូមិ ក្បាល ដំរី សង្កាត់ កាកាប១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
ប្រភព ដដែល បាន បន្ត ទៀត ថា ខណៈ នោះ គាត់ មិន ដកហូត យក រថយន្ត នោះ វិញ ឡើយ និង បាន តាម ស្វែងរក ជនសង្ស័យ ជា បន្តបន្ទាប់ ប៉ុន្តែ មិន ជួប រហូតមកដល់ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០១៩ បាន ប្រទះឃើញ ជនសង្ស័យ នៅក្នុង ហាង បាន ស្ថិត នៅក្នុង ភូមិ ក្បាល ដំរី សង្កាត់ កាកាប១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ក៏ បាន ឃាត់ខ្លួន នាំ ទៅ ប្រគល់ឲ្យ សមត្ថកិច្ច នាំ ទៅ សាកសួរ និង ចាត់ការ តាម ច្បាប់ ៕
ល្ងាច នេះ សម្តេច តេជោ ហ៊ុន សែន នឹង អញ្ជើញ ចូលរួម ពិធី ស្រាយ បួស ជាមួយ បងប្អូន សហគមន៍ ខ្មែរ ឥស្លាម នៅ វិហារ បឹងកក់
( ភ្នំពេញ ) ៖ នៅ ល្ងាច ថ្ងៃទី ០២ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នឹង អញ្ជើញ ចូលរួម ពិធី ស្រាយ បួស ជាមួយ បងប្អូន សហគមន៍ ខ្មែរ ឥស្លាម នៅ វិហារ បឹងកក់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន សរសេរ នៅលើ បណ្តាញ សង្គម Facebook ថា៖ « ដូច សព្វមួយ ដង ការងារ ខ្ញុំ គឺ មាន ជារៀងរាល់ ថ្ងៃ ។ ក្រោយពី បាន ពិនិត្យ និង សម្រេច លើ ឯកសារ មួយចំនួន រួចហើយ នៅ ល្ងាច នេះ ខ្ញុំ នឹង ទៅ ចូលរួម ពិធី ស្រាយ បួស ជាមួយ បងប្អូន សហគមន៍ ខ្មែរ ឥស្លាម នៅឯ វិហារ បឹងកក់ ។ ខ្ញុំ សូម អរគុណ បងប្អូន ខ្មែ ឥស្លាម ទូទាំង ប្រទេស ដែល តែងតែ បោះឆ្នោត គាំទ្រ រូប ខ្ញុំ និង គណបក្ស ប្រជាជន កម្ពុជា ព្រមទាំង បាន ចូលរួម ថែរក្សា សុខ សន្តិភាព និង អភិវឌ្ឍន៍ សង្គម គ្រួសារ និង ប្រទេសជាតិ អោយ កាន់តែ រីកចម្រើន » ។
ឆ្លៀត ក្នុង ឱកាស នេះ សម្តេច បាន ជូនពរ បងប្អូន ខ្មែរ ឥស្លាម និង ជន រួម ជាតិ បាន សប្បាយរីករាយ ចុង សប្តាហ៍ ហើយ សូម មាន សុខ សុវត្ថិភាព ក្នុង ការបើកបរ នៅ តាម ដងផ្លូវ ទូទាំង ប្រទេស ៕
សម្តេច ស ខេង អញ្ជើញ កាត់ ខ្សែបូ និង សម្ពោធ សមិទ្ធផល នានា ក្នុង វត្ត ហ្លួង ផែង ខេត្ត បាត់ដំបង
( ភ្នំពេញ ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ នៅ ព្រឹក ថ្ងៃទី ២ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី កាត់ ខ្សែបូ និង សម្ពោធ សមិទ្ធផល នានា ក្នុង វត្ត ហ្លួង ផែង ស្ថិត នៅ ភូមិ កណ្តាល ត្បូង ឃុំ គោក ឃ្មុំ ស្រុក ថ្មគោល ខេត្ត បាត់ដំបង ៕
ជនជាតិ វៀតណាម ១២នាក់ ដែល ឆ្លង ដែន ខុស ច្បាប់ និង នាំ គ្រឿងចក្រ ធុន ធ្ងន់ ឈូសឆាយ ដី ព្រៃ ខុស ច្បាប់ នៅ ខេត្ដ រតនគិរី ត្រូវ តុលាការ ខេត្ត សម្រេច ដោះលែង
( រតនគិរី ) ៖ ជនជាតិ វៀតណាម ចំនួន ១២នាក់ ដែល ពាក់ព័ន្ធ ករណី ឆ្លង ដែន ខុស ច្បាប់ និង នាំ គ្រឿងចក្រ ធុន ធ្ងន់ ចំនួន៦ គ្រឿង សម្រាប់ ឈូសឆាយ ដី ព្រៃ ខុស ច្បាប់ នៅ ក្រុមហ៊ុន នុភាព សុភី តំបន់ អូរ តាយ៉ាក ស្ថិត ក្នុង ឧទ្យាន ជាតិ វិរៈ ជ័យ ឃុំ តា វែង លើ ស្រុក តា វែង ខេត្ត រតនគិរី ដែល តុលាការ ខេត្ត សម្រេច ឃុំ ខ្លួន បណ្ដោះអាសន្ន កាលពី ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០១៩ នោះ ត្រូវបាន ដោះលែង ឲ្យ ត្រឡប់ ទៅ មាតុ របស់ ខ្លួន វិញ ហើយ ។
មន្រ្តី ពន្ធនាគារ ភ្នំ ស្វាយ ខេត្ត រតនគិរី បាន ឲ្យដឹង ថា ជនជាតិ វៀតណាម ទាំង ១២នាក់ ត្រូវបាន ដោះលែង នៅ វេលា ម៉ោង ១៧៖ ៣០ល្ងាច ថ្ងៃទី ៣០ ខែឧសភា ឆ្នាំ ២០១៩ បន្ទាប់ពី ខាង ពន្ធនាគារ ទទួលបាន ដីការបង្គាប់ ឲ្យ ដោះលែង ។
តាម ការឲ្យដឹង ពី នគរបាល ជំនាញ អន្តោប្រវេសន៍ នៃ ស្នងការរដ្ឋាន ខេត្ត រតនគិរី ថា ការដោះលែង ជនជាតិ វៀតណាម ទាំង ១២នាក់ ខាងលើ នេះ ខាង ជំនាញ មិន បាន ដឹង ទេ ពីព្រោះ ផុត ពី ដៃ ជំនាញ ដល់ ដៃ តុលាការ ហើយ ក៏ប៉ុន្តែ បើ តាម ច្បាប់ ទោះជា តុលាការ ដោះលែង ក៏ដោយ ក៏ ត្រូវ ប្រគល់ឲ្យ ជំនាញ អន្តោប្រវេសន៍ ដើម្បី នាំ ខ្លួន ជន អន្តោប្រវេសន៍ ទាំងនោះ ទៅ ប្រគល់ឲ្យ សមត្ថកិច្ច ប្រទេស វៀតណាម វិញ ដែរ ចៀសវាង ជនជាតិ វៀតណាម ទាំងនោះ ជួប ឧបត្ដហេតុ ផ្សេង ៗ ឬ ក៏ ត្រូវបាត់ខ្លួន ដោយ ប្រការ ណាមួយ ។
សមត្ថកិច្ច ប្រចាំ ការ នៅ ព្រំដែន អូរ យ៉ាដាវ លួច បង្ហើប ប្រាប់ ភ្នាក់ងារ Fresh News នៅ ព្រឹក ថ្ងៃទី ២ ខែមិថុនា ឆ្នាំ ២០១៩ ថា ជនជាតិ វៀតណាម ទាំង ១២នាក់ នោះ បន្ទាប់ពី ចេញ ពន្ធនាគារ ភ្នំ ស្វាយ គឺ ពួកគេ ចាកចេញ ទៅ ប្រទេស វៀតណាម ទាំង យប់ តាម ច្រក របៀង ភូមិ ភិ ឃុំ សេសាន្ត ស្រុក អូរយ៉ាដាវ ដោយ គ្មាន សមត្ថកិច្ច ណា ជា អ្នកប្រគល់ ឲ្យ ភាគី ខាង វៀតណាម ទេ ៕ ភេសជ្ជៈ ប៉ូវ កម្លាំង វើក ប្រកាស ចាប់ផ្តើម កម្មវិធី កីឡា ប្រដាល់ របស់ ខ្លួន ក្រោម ចំណងជើង « វើក សង្វៀន គុន ខ្មែ » ពី ពេលនេះ តទៅ ហើយ
( ភ្នំពេញ ) ៖ កាលពី ល្ងាច ម្សិលមិញ ភេសជ្ជៈ ប៉ូវ កម្លាំង វើក រួម ជាមួយ ទូរទស្សន៍ បាយ័ន បាន រួមគ្នា ប្រកាស ចាប់ផ្តើម កម្មវិធី ប្រដាល់ មិត្តភាព រដូវកាល ថ្មី របស់ ខ្លួន ហើយ ចាប់ពី ថ្ងៃទី ១ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ តទៅ រយៈពេល ១ ឆ្នាំ ពេញ តែ ម្តង ដោយ កម្មវិធី នេះ ត្រូវបាន ហៅ ថា « វើក សង្វៀន គុន ខ្មែរ » ។
កម្មវិធី « វើក សង្វៀន គុន ខ្មែរ » នឹង នាំមក នូវ ការប្រកួត ប្រដាល់ ជារៀងរាល់ ថ្ងៃសៅរ៍ ចាប់ពី ម៉ោង ៦ល្ងាច តទៅ សរុប ៣គូរ រវាង កីឡាករ កម្ពុជា ប្រកួត ជាមួយ កីឡាករ បរទេស ចំនួន ២គូរ និង កម្ពុជា ជាមួយ កម្ពុជា ១គូរ ដោយ ការប្រកួត នេះ ក៏ នឹង ត្រូវ ចាក់ផ្សាយ បន្ត ផ្ទាល់ នៅ លើ ប៉ុស្តិ៍ ទូរទស្សន៍ បាយ័ន ថ្ងៃសៅរ៍ ហើយ ទស្សនិកជន ក៏ អាច ចូលរួម ទស្សនា ផ្ទាល់ នូវ ការប្រកួត នេះ នៅឯ ស្ថានីយ ទូរទ្សន៍ បាយ័ន ស្ទឹងមាន បាន ជ័យ ផងដែរ ។
លោក បណ្ឌិត អ៊ឹម សុធារិទ្ធ នាយក គ្រប់គ្រង់ ផ្នែក លក់ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជិស បាន អោយ ដឹង ថា « ភេសជ្ជៈ ប៉ូវ កម្លាំង វើក ចូលរួម ឧបត្ថម ផ្តាច់ មុខ នាំមក នូវ កម្មវិធី វើក សង្វៀន គុន ខ្មែរ នេះ ឡើង គឺ ក្នុង គោលបំណង លើកស្ទួយ វិស័យ កីឡា ប្រដាល់ បុរាណ ខ្មែរ អោយ កាន់តែ មាន ប្រជាប្រិយ ភាព ទាំង នៅក្នុង ស្រុក និង លើ ឆាក អន្តរជាតិ ហើយក៏ ចង់ លើកទឹកចិត្ត ដល់ យុវជន និង យុវវ័យ ចូលរួម ហាត់ លេង កីឡា នេះ ដើម្បី សុខភាព ក៏ ដូចជា ថែរក្សា នូវ សម្បត្តិ កីឡា វប្បធម៌ ជាតិ ផងដែរ » ។
លោក តែ ម ម៉ឺន ប្រធាន សហព័ន្ធ ប្រដាល់ កម្ពុជា និង តំណាង គណៈកម្មាធិការ រៀបចំ ការប្រកួត របស់ ស្ថានីយ ទូរទស្សន៍ បាយ័ន បាន អោយ ដឹង ថា « ការប្រកួត មិត្តភាព នេះ កីឡាករ នីមួយ ៗ ក៏ នឹង ទទួលបាន នូវ ការឧបត្ថម្ភ ទឹកប្រាក់ ៦០ ម៉ឺន រៀល សម្រាប់ គូរ ធម្មតា និង ១លាន រៀល សម្រាប់ គូរ ពិសេស បន្ថែម ផងដែរ ពី ភេសជ្ជៈ ប៉ូវ កម្លាំង វើក រាល់ ជ័យ ជំនះ ទៅ លើ គូរ ប្រកួត របស់ ខ្លួន »៕
( ដាម៉ាស់ ) ៖ យោធា ស៊ីរី ៣នាក់ បាន ស្លាប់ និង ៧នាក់ ផ្សេង ទៀត រងរបួស នៅក្នុង ការវាយប្រហារ ដោយ គ្រាប់ មីស៊ីល របស់ អ៊ីស្រាអែល ។ នេះ បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ស៊ីរី ដកស្រង់ ចេញផ្សាយ ដោយសារព័ត៌មាន Sputnik នៅ ថ្ងៃអាទិត្យ ទី ០២ ខែមិថុនា ឆ្នាំ ២០១៩ ។
មុនដំបូង ឡើយ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ស៊ីរី SANA នៅ ថ្ងៃអាទិត្យ នេះ ក៏ បាន ឱ្យដឹង ដែរ ថា ប្រព័ន្ធ មីស៊ីល ការពារ ដែន អាកាស របស់ កងទ័ព ស៊ីរី បាន បាញ់ កម្ទេច មីស៊ីល របស់ សត្រូវ ជាច្រើន គ្រាប់ នៅឯ ភាគ ខាងត្បូង ទីក្រុង ដាម៉ាស់ ។
( ភ្នំពេញ ) ៖ ការវិវិឌ្ឍ នៃ បច្ចេកវិទ្យា នា សម័យ ទំនើប មិន ត្រឹមតែ ត្រូវបាន ធ្វើឡើង ចំពោះ តែ ផលិតផល គ្រឿង អេឡិចត្រូនិច ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ការបំពាក់ នូវ បច្ចេកវិទ្យា ទាំងអស់ នេះ ត្រូវបាន ធ្វើឡើង ចំពោះ មធ្យោបាយ ធ្វើដំណើរ ផងដែរ មាន ជាអាទិ៍ ឡាន ម៉ូតូ ។ល ។
ដោយឡែក ការជ្រើសរើស ម៉ូតូ ជា មធ្យោបាយ ធ្វើដំណើរ នៅតែ មាន ការពេញនិយម ក្នុង ស្រទាប់ អ្នកប្រើប្រាស់ ពិសេស បណ្តា ប្រទេស ក្នុង តំបន់ អាស៊ាន (ASEAN) រួម មាន វៀតណាម ថៃ ហ្វីលីពីន កម្ពុជា ជាដើម ។
គួរ ជម្រាប ថា កិច្ចសម្ភាសន៍ របស់ លោក ដូណាល់ ត្រាំ ធ្វើឡើង តែ ប៉ុន្មាន ថ្ងៃ ប៉ុណ្ណោះ មុននឹង លោក ត្រូវ បំពេញ ដំណើរទស្សនកិច្ច ផ្លូវ រដ្ឋ ទៅកាន់ ប្រទេស អង់គ្លេស នៅ ថ្ងៃចន្ទ សប្ដាហ៍ ក្រោយ នេះ ៕
កងទ័ព ស៊ីរី បាញ់ កម្ទេច មីស៊ីល ជាច្រើន គ្រាប់ នៅឯ តំបន់ ភាគ ខាងត្បូង ទីក្រុង ដាម៉ាស់
យោង តាម SANA មីស៊ីល ទាំងនោះ គឺ មាន គោលដៅ វាយប្រហារ លើ តំបន់ មួយ កន្លែង ស្ថិត នៅ ភាគ ខាងត្បូង ទីក្រុង ដាម៉ាស់ ។ ប៉ុន្តែ ភ្លាម ៗ មិន ទាន់ មាន ការបញ្ជាក់ លម្អិត ពី ការវាយប្រហារ នេះ នៅឡើយ ទេ ខណៈ វា កើតឡើង នៅ ចំពេល មាន សេចក្ដីរាយការណ៍ ថា យោធា អ៊ីស្រាអែល បាន ដឹកនាំ ការវាយប្រហារ ដោយ គ្រាប់ មីស៊ីល ជា បន្តបន្ទាប់ លើ តំបន់ ភាគ ខាងត្បូង ប្រទេស ស៊ីរី កាលពី ខែឧសភា កន្លងទៅ ៕
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ប្រុងប្រយ័ត្ន ! ស្លាប់ ១០នាក់ និង របួស ២៧ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០១ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ២០ លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ១០នាក់ . របួស ស្រាល១០ និង របួស ធ្ងន់ ១៧នាក់ ។
អគ្គ នាយក ធនាគារ អភិវឌ្ឍន៍ ជនបទ ចុះ ពិនិត្យមើល ការដាំដុះ បន្លែ សុវត្ថិភាព របស់ សហគមន៍ កសិកម្ម សាមគ្គី មនោរម្យ លើ ផ្ទៃដី ដាំដុះ ១០ហិកតា នៅ ខេត្ត មណ្ឌលគីរី
( មណ្ឌលគីរី ) ៖ លោក កៅ ថា ច អគ្គ នាយក ធនាគារ អភិវឌ្ឍន៍ ជនបទ និង សហការី នា រសៀល ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩ បាន អញ្ជើញ ចុះ ពិនិត្យមើល ការដាំដុះ បន្លែ សុវត្ថិភាព របស់ សហគមន៍ កសិកម្ម សាមគ្គី មនោរម្យ ដែល មាន សមាជិក ដាំ ដុំ បន្លែ សុវត្ថិភាព សម្រាប់ ផ្គត ផ្គង់ ទីផ្សារ នៅ ភ្នំពេញ ចំនួន ២១ គ្រួសារ លើ ផ្ទៃដី ដាំដុះ ១០ហិកតា នៅ ភូមិ ចំការ តែ ឃុំ ស្ពាន់ មានជ័យ ក្រុង សែនមនោរម្យ ខេត្ត មណ្ឌលគីរី ។
តាម ការឲ្យដឹង ត្រួស ៗ ពី លោក ប្រធាន សហគមន៍ បាន ឲ្យដឹង ថា បន្លែ សុវត្ថិភាព របស់ សហគមន៍ លោក បាន ចុះ កិច្ចសន្យា ផ្គត់ផ្គង់ បន្លែ ឲ្យ ទៅ ក្រុមហ៊ុន ទទួល ទិញ បន្លែ ចំនួន ៣ នៅ ទីក្រុង ភ្នំពេញ ដោយ ក្នុង នោះ មាន បន្លែ ស្ពៃ ក្តោប ការ៉ុត ស្ពៃ បូក គោ ជាដើម ។ ដោយឡែក សហគមន៍ របស់ លោក កំពុង ជួប នូវ បញ្ហា ប្រឈម មួយ ចំនួន មាន៖
ដូចនេះ តំណាង សហគមន៍ បាន ស្នើសុំ ទៅ លោក កៅ ថា ច ជួយ អន្តរាគមន៍ ក្នុង ការជួយ រក ទីតាំង ដី ដាំដុះ បន្លែ ថ្មី និង ស្នើសុំ ទំលាក់ ឥណទាន ដោយ អត្រា ការប្រាក់ ទាប ដើម្បី សហគមន៍ មាន លទ្ធភាព ពង្រីក ការដាំដុះ បន្លែ និង ស្នើសុំ ឲ្យ ជួយ ធ្វើ តភ្ជាប់ ពី សហគមន៍ បន្លែ របស់ លោក ទៅកាន់ ទីផ្សារ ។
ឆ្លើយតប នឹង សំណើ សុំ នេះ លោក កៅ ថា ច បាន ជម្រាប បងប្អូន សហគមន៍ ថា ចំពោះ ទីតាំង ដី សម្រាប់ ដាំដុះ បន្លែ លោក បាន ណែនាំឲ្យ សហគមន៍ ធ្វើការពិចារណា និង ចរចារ ជាមួយ ម្ចាស់ ដី លើ ទីតាំង ដី ថ្មី មួយ កន្លែង ដែល លោក បាន រៀបចំ ជូន ។
ចំពោះ បញ្ហា កំចី ឥណទាន ដោយ អត្រា ការប្រាក់ ទាប លោក បាន ធ្វើ ការពន្យល់ នូវ គោលការណ៍ និង លក្ខខ័ណ្ឌ អនុគ្រោះ មួយចំនួន ដើម្បីឲ្យ សហគមន៍ ធ្វើការពិចារណា ហើយ ធនាគារ អភិវឌ្ឍន៍ ជនបទ នឹង ពិនិត្យ លទ្ធភាព ផ្តល់ ជូន សហគមន៍ ក្នុង ករណី សហគមន៍ បាន បំពេញ បាន តាម លក្ខខ័ណ្ឌ នោះ បាន ។
ដោយឡែក បញ្ហា ទីផ្សារ លោក នឹង ជួយ តភ្ជាប់ ជូន បងប្អូន សហគមន៍ ទៅកាន់ ក្រុមហ៊ុន ទទួល ទិញ បន្លែ មួយចំនួន នៅ ភ្នំពេញ ដែល ជា ដៃគូ របស់ ធនាគារ អភិវឌ្ឍន៍ ជនបទ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃសៅរ៍ ទី ០១ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ មាន នូវ ព្រឹត្តិការណ៍ អន្តរជាតិ ជាច្រើន រួម មាន ទាំង ព្រឹត្តិ ការណ៍ ក៏ ដូចជា ស្ថានការណ៍ នយោបាយ និង រឿង ហេតុ ផ្សេង ៗ នៅ ទូទាំង សកលលោក ដែល គួរឲ្យ ចាប់អារម្មណ៍ ។ ខាងក្រោម នេះ ជា រូបភាព ខ្លះ ៗ បង្ហាញ អំពី ព្រឹត្តិការណ៍ ដែល បាន កើត មាន ឡើង ក្នុង ថ្ងៃ នេះ៖
២៖ ទិដ្ឋភាព នៃ ការអបអរ ទិវា កុមារ អន្តរជាតិ នៅឯ ប្រទេស ចិន ។
ព្រឹត្តិការណ៍ ប្រណាំង យានយន្ត ឆ្លងកាត់ ឧបសគ្គ Khmer Rally Raid ឆ្នាំ ២០១៩ នេះ រៀបចំ ដោយ ក្រុមហ៊ុន Kara សហការ ជាមួយនឹង ក្រសួង បរិស្ថាន និង សហព័ន្ធ កីឡា យានយន្ត កម្ពុជា ក្រោម ការឧបត្ថម្ភ ពី ក្រុមហ៊ុន តូតាល់ បន្ទាប់ពី ធ្វើ ការប្រណាំង រយៈពេល ៣ ថ្ងៃ ឆ្លងកាត់ ខេត្ត ចំនួន ៣ គឺ ខេត្ត កំពង់ធំ ខេត្ត ព្រះវិហារ និង ខេត្ត សៀមរាប លើ ចំងាយ ផ្លូវ សរុប ៦២៤ គីឡូម៉ែត្រ កាលពី ពេល ថ្មី ៗ នេះ នៅលើ ទឹកដី អង្គរ ខេត្ត សៀមរាប ។
កីឡាការិនី រូប នេះ បាន អះអាង ថា ការប្រណាំង បែប ធម្មជាតិ នេះ ធ្វើឲ្យ នាង សប្បាយរីករាយ ពីព្រោះថា ជា កន្លែង មិន ធ្លាប់ បាន ទៅ ម្យ៉ាងទៀត ព្រឹត្តិការណ៍ នេះ ក៏ បាន ទាក់ទាញ និង បង្ហាញ ភ្ញៀវ ទេសចរ ពី តំបន់ អភិរក្ស ធនធាន ធម្មជាតិ ដ៏ សំបូរ បែប ដែល កម្ពុជា មាន ទៅកាន់ ពិភពលោក ផងដែរ ។
ជាមួយគ្នា នេះ លោក នេត្រ ភក្រ្តា រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន បង្ហាញ ការជឿជាក់ ថា ព្រឹត្តិការណ៍ នេះ ក៏ ជា ផ្នែក មួយ សម្រាប់ ទាញ ការចាប់អារម្មណ៍ របស់ សាធារណជន ឲ្យ ចូលរួម ថែរក្សា ការពារ បរិស្ថាន និង ធនធាន ធម្មជាតិ ពិសេស ការទប់ស្កាត់ ការកាប់បំផ្លាញ ធនធាន ធម្មជាតិ ផងដែរ ហើយ ក្រសួង នឹង បន្ត ការគាំទ្រ ព្រឹត្តការណ៍ ប្រណាំង បែប ធម្មជាតិ នេះ នៅ ឆ្នាំ ក្រោយ ៗ ទៀត ។
គួរ ជម្រាប ថា កម្មវិធី នេះ ជួយ លើកស្ទួយ កីឡា ប្រណាំង ក្នុង ស្រុក ហើយ ថែមទាំង លើកតម្កើង ការយល់ដឹង ពី ប្រធានបទ សំខាន់ ផ្សេង ៗ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ដូចជា បរិស្ថាន និង ការបើកបរ គោរព ច្បាប់ ចរាចរណ៍ ដើម្បី សុវត្ថិភាព ទាំងអស់ គ្នា ៕
លោក មេធាវី គី តិច បើក កិច្ចប្រជុំ ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន លើក ទី២ ត្រីមាស ទី១ ដើម្បី ពិភាក្សា ការងារ និង លើក ទិសដៅ សម្រាប់ អនុវត្ត បន្ត ឱ្យ មាន ប្រសិទ្ធភាព
( ភ្នំពេញ ) ៖ លោក មេធាវី គី តិច ប្រធាន ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន បាន អញ្ជើញ បើក កិច្ចប្រជុំ លើក ទី២ ត្រីមាស ទី១ នា ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០១៩ ម្សិលមិញ ក្នុង គោលបំណង បូកសរុប ការងារ របស់ ក្រុម មេធាវី ដែល បាន អនុវត្ត ន៏ អស់ រយៈពេល ១ ត្រីមាស កន្លងមក ។
