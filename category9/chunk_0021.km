( បន្ទាយមានជ័យ )៖ នៅក្នុង ឱកាស អញ្ជើញ ជា អធ បិតី ភាព ប្រកាស ចូលកាន់ មុខ ដំណែង របស់ ក្រុមប្រឹក្សា ក្រុង សិរី សោភ័ណ អាណត្តិ ទី៣ ចំនួន ១៩ រូប នៅ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ លោក អ៊ុ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ បាន ក្រឿន រំឮក ដល់ សមាជិក ក្រុមប្រឹក្សា ខេត្ត ដែល ទើប ទទួលបាន តំណែង ថ្មី ទាំងអស់ ត្រូវតែ បន្ត យកចិត្តទុកដាក់ ពង្រឹង ការងារ របស់ ខ្លួន បន្ថែម ទៀត ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ របស់ ប្រជាពលរដ្ឋ ។
គួរ បញ្ជាក់ ថា Golan Heights គឺជា តំបន់ មួយ ដែល អ៊ីស្រាអែល បាន រឹបអូស ពី ស៊ីរី នៅ អំឡុង សង្រ្គាម ០៦ ថ្ងៃ ក្នុង តំបន់ មជ្ឈិមបូព៌ា កាលពី ឆ្នាំ ១៩៦៧ ។ រីឯ សហរដ្ឋ អាមេរិក កាលពី ខែមីនា កន្លងទៅ បាន ក្លាយជា ប្រទេស ដំបូង គេ បំផុត ដែល ទទួលស្គាល់ តំបន់ នេះ ជា កម្មសិទ្ធិ របស់ អ៊ីស្រាអែល ចាប់តាំងពី ទីក្រុង តែ ល អាវីវ បញ្ចូល តំបន់ នេះ ទៅក្នុង ឧបសម្ព័ន្ធ នៃ ទឹកដី របស់ ខ្លួន កាលពី ឆ្នាំ ១៩៨១ ។
ក្នុង នាម ជា មជ្ឈមណ្ឌល ខេម ប្រ៊ីជ អន្តរជាតិ សាលា អន្តរជាតិ អាយ ស៊ី អេស មាន ដៃគូ អប់រំ ជាង ១០.០០០ ក្នុង ១៩៥ ប្រទេស ក្នុង នោះ ភាគ ច្រើន ជាសាលា និង សាកលវិទ្យាល័យ អន្តរជាតិ ល្បី ៗ ប្រចាំ ប្រទេស នីមួយ ៗ ។ សាលា អន្តរជាតិ អាយ ស៊ី អេស មាន កម្មវិធី សិក្សា ដូច ជា៖ មត្តេយ្យ សិក្សា អន្តរជាតិ . បឋមសិក្សា អន្តរជាតិ . បឋមសិក្សា ២ ភាសា . មធ្យមសិក្សា អន្តរជាតិ  មធ្យមសិក្សា ពីរ ភាសា ។
សូម ជម្រាប ថា សាលា អន្តរជាតិ អាយ ស៊ី អេស មាន បទពិសោធន៍ លើ វិស័យ អប់រំ ជាង ២៦ ឆ្នាំ និង ទទួលបាន ជ័យលាភី និង សមិទ្ធិផល យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ ៕ លោកស្រី ទាវ ធីតា ផ្តល់ អំណោយ សប្បុរសធម៌ ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ មួយ គ្រួសារ នៅក្នុង ភូមិ ត្រពាំង ត្រា វ ឃុំ គោក ខ្ចក កំពង់ត្របែក ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ លោកស្រី ទាវ ធីតា អនុប្រធាន ទី១ ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ សង្កាត់ ស្ទឹងមានជ័យ ទី២ បាន ផ្តល់ អំណោយ សប្បុរសធម៌ ជូន ដល់ ជន ក្រីក្រ ចំនួន មួយ គ្រួសារ រស់ នៅក្នុង ភូមិ ត្រពាំង ត្រា វ ឃុំ គោក ខ្ចក ស្រុក កំពង់ត្របែក ខេត្ត ព្រៃវែង នៅ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ ។
លោកស្រី ទាវ ធីតា បាន ផ្តល់ អំណោយ ជា ថវិកា ចំនួន ៣០ ម៉ឺន រៀល ប្រគល់ ជូន លោកស្រី អ៊ុន សុភួន ដែល រស់ នៅ ភូមិ ត្រពាំង ត្រា វ ឃុំ គោក ខ្ចក ស្រុក កំពង់ត្របែក ខេត្ត ព្រៃវែង និង គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ទៀត ផងដែរ ។
អំណោយ មនុស្សធម៌ នេះ លោកស្រី ទាវ ធីតា ភរិយា លោក ថោង សារ៉ាត់ បាន អនុញ្ញាតឲ្យ លោក ហម ចំរើន និង លោកស្រី សុខ ម៉ាលី ជា តំណាង នាំយក នូវ អំណោយ ទាំងនេះ ទៅ ជូន ដោយ ផ្ទាល់ លោកស្រី អ៊ុន សុភួន ដើម្បី បាន សួរសុខទុក្ខ និង បាន ឃើញ អំពី ស្ថានភាព ជាក់ស្តែង របស់ គាត់ ផងដែរ ។
តំណាង លោកស្រី ទាវ ធីតា បាន លើកឡើង ថា លោកស្រី ទាវ ធីតា និង ស្វាមី បាន ផ្តល់ អំណោយ ជូន គ្រួសារ របស់ លោកស្រី អ៊ុន សុភួន គឺ ដើម្បី ជា ការលើកទឹកចិត្ត និង ដើម្បី ជួយ សម្រួល ដល់ ការចិញ្ចឹម កូន ឲ្យ ខំ តស៊ូ ក្នុង ជីវិត និង ថែរក្សា សុខភាព ឲ្យបាន ល្អ ដើម្បី មើល ការរីកចម្រើន របស់ ប្រទេស កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ៕
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល ព្រមាន បិទ ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ណា ដែល គ្មាន អនាម័យ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ងី មាន ហេង ទីប្រឹក្សា ក្រសួង សុខាភិបាល និង ជា ប្រធាន មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ បាន ព្រមាន ដកហូត អាជ្ញាប័ណ្ណ ពី ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ណា ដែល គ្មាន អនាម័យ ក្នុង ការចម្អិន ម្ហូប អាហារ ។
ការព្រមាន របស់ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល រូប នេះ បាន ធ្វើឡើង ក្នុង សិក្ខាសាលា ការអនុវត្ត អនាម័យ ចំណីអាហារ ដល់ ប្រជាជន កម្ពុជា កាលពី រសៀល ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០១៩ ។
លោក បណ្ឌិត ងី មាន ហេង បាន ថ្លែង ថា អនាម័យ ចំណីអាហារ ជា ផ្នែក មួយ នៃ សុវត្ថិភាព ចំណីអាហារ ។ កាលណា គេ និយាយ ពី សុវត្ថិភាព ចំណីអាហារ មាន ភាព ទូលំទូលាយ ណាស់ គឺ គេ គិត តាំងពី កសិដ្ឋាន ការដាំដុះ ការចិញ្ចឹម សត្វ រហូតដល់ ការប្រមូល ផល ឬ ក៏ ការកាប់ សម្លាប់ សត្វ ការដឹកជញ្ជូន សាច់ ការដឹកជញ្ជូន បន្លែ ការដាក់ ទុក នៅ ទីផ្សារ រហូត យក ទៅ ចម្អិន នៅ ភោជនីយដ្ឋាន អាហារដ្ឋាន និង តាម ផ្ទះ ផងដែរ ។
លោក ថ្លែង ទៀត ថា ពាក់ព័ន្ធ នឹង សុវត្ថិភាព ចំណីអាហារ តាម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ក្រសួង សុខាភិបាល មាន វិធានការអនុវត្ត ត្រឹមតែ ណែនាំ និង អប់រំ សិន តែ ប៉ុណ្ណោះ គឺ គ្មាន ការដាក់ទោសទណ្ឌ ដល់ ម្ចាស់ ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ឡើយ ។ ប៉ុន្តែ បើសិនជា ម្ចាស់ ភោជនីយដ្ឋាន និង អាហារដ្ឋាណា ដែល ធ្លាប់ មាន បញ្ហា ចំណីអាហារ ហើយ មិន ព្រម កែប្រែ ក្រសួង នឹង មាន វិធានការដកហូត អាជ្ញាប័ណ្ណ ឈប់ ឲ្យ បើក អាជីវកម្ម បន្ត ទៀត តែម្តង ។
លោក បណ្ឌិត ងី មាន ហេង បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ក្រសួង សុខាភិបាល សព្វ ថ្ងៃ គឺ នៅតែ អនុវត្តន៍ ត្រឹម អប់រំ និង ណែនាំ ។ កាលណា យើង មាន ចំណុច ខ្វះខាត យើង មាន តែ ចំណុច អប់រំ និង ណែនាំ គាត់ ប៉ុន្តែ បើ គាត់ នៅតែ មិន ព្រម កែប្រែ យើង នឹង មាន វិធានការដក អាជ្ញាប័ណ្ណ និង មិន បញ្ជាក់ លិខិត អនាម័យ ជូន គាត់ ទេ ។ វា អាច ឲ្យ គាត់ មាន បញ្ហា ប្រឈម នឹង ការសុំ អាជ្ញាប័ណ្ណ ដើម្បី បើក ភោជនីយដ្ឋាន និង អាហារដ្ឋាន បន្ត ទៀត » ។
ចំពោះ អ្នក ដែល លក់ ចំណីអាហារ តាម ដងផ្លូវ វិញ ត្រូវបាន លោក បណ្ឌិត ងី មាន ហេង បញ្ជាក់ ថា ខាង ក្រសួង ក៏ មិន ដាក់ទោសទណ្ឌ អ្វី ដែរ ។ លោក ថ្លែង ថា នៅ ប្រទេស ជិតខាង ជាប់ កម្ពុជា ក៏ ពួកគេ មាន បញ្ហា ប្រឈម នឹង អនាម័យ ចំណីអាហារ តាម ដងផ្លូវ ដូចគ្នា ផងដែរ ហេតុ នេះ កម្ពុជា មិន អាច ប៉ះ ដៃ យក ដៃ ប៉ះ ជើង យក ជើង អនុវត្តន៍ ច្បាប់ លឿន ជាង ប្រទេស ផ្សេង ឡើយ ។
បើ តាម មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល . បច្ចុប្បន្ន បញ្ហា ចំណីអាហារ នៅ ប្រទេស កម្ពុជា មាន ភាពប្រសើរឡើង បើ គេ ប្រៀបធៀប ទៅនឹង ១០ឆ្នាំ មុន ។ សព្វ ថ្ងៃ មាន ភោជនីយដ្ឋាន អាហារដ្ឋាន ដែល អនុវត្តន៍ គោលការណ៍ អនាម័យ នេះ បាន ច្រើន ហើយ ប្រជាពលរដ្ឋ ដែល លក់ ចំណីអាហារ តាម ទីផ្សារ វិញ ចាប់ផ្តើម យល់ដឹង ពី អនាម័យ ចំណីអាហារ ។ ចំពោះ អាហារ ដែល គាត់ លក់ដូរ គាត់ មិន ដាក់ អាហារ លើ ដី ទេ គាត់ ចេះ ដាក់ យ៉ាងតិច ៦០សង់ទីម៉ែត្រ ពី ដី ហើយ គាត់ ចាប់ផ្តើម ចេះដឹង ពី ការគ្រប ចំណីអាហារ ផងដែរ ។
« យើង គិត ថា មាន ភាពរីកចម្រើន ។ យើង សង្ឃឹម ថា នៅ ពេល ដែល យើង បន្ត បើក វគ្គ នេះ ទៀត ការយល់ដឹង របស់ គាត់ កាត់ តែ ច្រើន ការអនុវត្ត ក៏ កាន់តែ ប្រសើរឡើង »។ នេះ ជា ការអះអាង របស់ ទីប្រឹក្សា ក្រសួង សុខាភិបាល ។
ជាមួយគ្នា នេះ លោក សមូហក បណ្ឌិត ឡី សុភាព ប្រធាន សហព័ន្ធ វិនិយោគិន និង ជា ប្រធាន សមាគម សហព័ន្ធ វេជ្ជសាស្ត្រ ឱសថសាស្ត្រ និង ទន្តសាស្ត្រ កម្ពុជា បាន ថ្លែង ថា បញ្ហា អនាម័យ ចំណីអាហារ នេះ ភាគី ពាក់ព័ន្ធ បាន សហការ គ្នា ល្អ ជាមួយ មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ ក៏ ដូចជា មន្ត្រី គ្រប់ ជាន់ ថ្នាក់ ។ លោក ថ្លែង ថា បញ្ហា នេះ គេ ត្រូវតែ សង្កត់ធ្ងន់ និង ចូលរួម ទាំងអស់ គ្នា ។
លោក បណ្ឌិត ឡី សុភាព បញ្ជាក់ ថា « ចំពោះ បុគ្គល ណាមួយ នៅ តាម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន កន្លែង នាំចូល និង ចែកចាយ ទាក់ទង ទៅនឹង ចំណីអាហារ របស់ ប្រជាពលរដ្ឋ កម្ពុជា ផ្នែក ណាមួយ ប្រការ ណាមួយ ដែល ខុស ប្រក្រតី ទាំងអង្គ ច្បាប់ និង បទដ្ឋាន គតិយុត្ត ផ្សេង ៗ យើង សហការ ជាមួយ អាជ្ញាធរដែនដី ចុះ អនុវត្តន៍ តាម ផ្លូវ ច្បាប់ ដែល រាជ រដ្ឋាភិបាល ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ បាន កំណត់ » ។
លោក បណ្ឌិត ក៏ បាន អំពាវនាវ ដល់ ភោជនីយដ្ឋាន និង អាហារដ្ឋាន កន្លែង ធ្វើ ម្ហូប បុណ្យ ការ ចុង ភៅ និង អ្នកផលិត ជា ចំណី អាហារ ទាំងអស់ ទាំង គ្រឿង កំប៉ុង គ្រប់ បែបយ៉ាង ដែល ពាក់ព័ន្ធ ចំណីអាហារ និង ទឹក គឺ ត្រូវតែ នាំគ្នា គិតគូរ ពី បញ្ហា អនាម័យ ចំណីអាហារ ។ បើសិនជា ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ណាមួយ ដែល មាន បញ្ហា លើ អនាម័យ ច្បាស់ជា ត្រូវ ប្រើ វិធានការក្តៅ មិន ខាន ៕
លោក ថោង ខុន ប្រកាស សមាសភាព ក្រុមការងារ ថ្នាក់ ជាតិ នៅ តាម ក្រុង - ស្រុក ទាំង ៩ នៃ ខេត្ត កំពង់ធំ និង ណែនាំ អនុសាសន៍ មួយចំនួន
បន្ទាប់ពី លោក គង់ សូលីដា អគ្គ នាយក រដ្ឋបាល និង ហិរញ្ញវត្ថុ នៃ ក្រសួង ទេសចរណ៍ និង ជា សមាជិក ក្រុមការងារ ថ្នាក់ ជាតិ ប្រកាស នាម និង តួនាទី សមាជិក ក្រុមការងារ រួច មក លោក រដ្ឋមន្ត្រី ថោង ខុន បាន ណែនាំ អនុសាសន៍ មួយចំនួន ទៀត ដើម្បី បន្ត ដំណើរការ អនុវត្ត ការងារ របស់ ក្រុមការងារ ថ្នាក់ ជាតិ ឲ្យបាន រលូន មាន ប្រសិទ្ធភាព និង និរន្តរភាព ។
ក្នុង នោះ លោក រដ្ឋមន្ត្រី បាន ណែនាំ ដល់ ក្រុមការងារ ថ្នាក់ ជាតិ និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ត្រូវ ខិតខំ រួមគ្នា សម្រេច ឲ្យបាន នូវ ការងារ សំខាន់ ៗ ដូច ខាងក្រោម៖
១៖ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ក្រុង - ស្រុក ទាំង៩ ដែល ទើប បាន ប្រកាស ថ្មី ៗ នេះ ត្រូវ ចុះ រៀបចំ កិច្ចប្រជុំ បន្ទាន់ នៅ មូលដ្ឋាន ក្រុង - ស្រុក របស់ ខ្លូន ដើម្បី ស្តាប់ នូវ របាយការណ៍ និង ការលើកឡើង អំពី ក្តីកង្វល់ បញ្ហា ប្រឈម តម្រូវ ការចាំបាច់ និង សំណូម នានា របស់ ប្រជាពលរដ្ឋ មូលដ្ឋាន ។
២៖ ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ក្រុង - ស្រុក នីមួយ ៗ ត្រូវ រៀបចំ បង្កើត ជា លេខាធិការដ្ឋាន មួយ ដើម្បី ជា សេនាធិការ ជួយសម្របសម្រួល ការងារ ទូទៅ និង ធ្វើ របាយការណ៍ លទ្ធផល ជូន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ ។
៣៖ ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ក្រុង - ស្រុក នីមួយ ៗ ត្រូវ រៀបចំ សេចក្តីសម្រេច ស្តីពី ការបង្កើត ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ឃុំ - សង្កាត់ របស់ ខ្លួន ឲ្យបាន សមស្រប ទៅតាម រចនាសម្ព័ន្ធ ការងារ ។
៤៖ ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ក្រុង - ស្រុក នីមួយ ៗ ត្រូវ រៀបចំ ផែនការ សកម្មភាព របៀបរបប ការងារ និង ការចុះ រៀបចំ វេទិកា សាធារណៈ នៅ តាម មូលដ្ឋាន ឃុំ - សង្កាត់ ឲ្យបាន ច្បាស់លាស់ ។
៥៖ បន្ត ជំរុញ ការពិនិត្យ និង ដោះស្រាយ នូវ ការងារ ចាំបាច់ មួយ ចំនួន ជា អាទិ៍ ភាព មាន ដូចជា ការងារ ឆ្វៀល ដី នៅ តំបន់ ៣ តំបន់ ២ ដី តំបន់ អភិរក្ស សត្វ ខ្សឹប ការងារ ឆ្វៀល ដី ចេញ ពី សារពើ ភណ្ឌ របស់ មន្ទីរ - អង្គភាព ជូន ប្រជាពលរដ្ឋ បញ្ហា ដី ប្រជាពលរដ្ឋ រស់ នៅ តំបន់ រណប នៃ តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក ។
៧៖ បន្ត ពង្រឹង សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម តាមរយៈ ការអនុវត្ត គោល នយោបាយ ភូមិ / ឃុំ មាន សុវត្ថិភាព
៨៖ បន្ត ខិតខំ ពង្រឹង ការអនុវត្ត ច្បាប់ ឲ្យបាន ម៉ឺងម៉ាត់ ដើម្បី បង្ការ ទប់ស្កាត់ បង្រ្កាប បទល្មើស ព្រៃឈើ បទល្មើស នេសាទ និង បទល្មើស ធនធាន ធម្មជាតិ គ្រប់ ប្រភេទ ។
៩៖ បន្ត ចុះ ពិនិត្យ និង ដោះស្រាយ នូវ បញ្ហា ប្រឈម និង សំណូមពរ ចាំបាច់ នានា របស់ ប្រជាពលរដ្ឋ តាមរយៈ ការជួប ប្រាស័យ ទាក់ទង តាម សហគមន៍ មូលដ្ឋាន និង ការរៀបចំ វេទិកា សាធារណៈ នៅ មូលដ្ឋាន ។
១០៖ បន្ត ខិតខំ លុបបំបាត់ នូវ អំពើ អសកម្ម និង ចំនុច ខ្វះខាត នានា ដែល ប៉ះពាល់ ដល់ សតិអារម្មណ៍ និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ មូលដ្ឋាន ។
១១៖ បន្ត ខិតខំ ធ្វើ អំពើ ល្អ បម្រើ ប្រជាពលរដ្ឋ ឱ្យ អស់ ពី ចិត្ត ពី ថ្លើម សំដៅ បង្កើន ភាពជឿជាក់ ទុកចិត្ត និង កក់ក្តៅ របស់ ប្រជាពលរដ្ឋ មក លើ រាជ រដ្ឋាភិបាល ៕
ខាងក្រោម នេះ ជា លទ្ធផល ផ្លូវការ ដែល ប្រកាស ដោយ រដ្ឋសភា៖
