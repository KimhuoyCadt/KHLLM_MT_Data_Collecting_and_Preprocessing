( កង់ បេរ៉ា) ៖ ក្រុមហ៊ុន មួយ របស់ សិង្ហបុរី បាន បង្ហាញ ពី គម្រោង សាងសង់ សួន ផ្ទាំង សូឡា ធំ បំផុត លើ លោក ដើម្បី ទាញយក ថាមពល ពន្លឺ ព្រះអាទិត្យ នៅឯ ភាគ កណ្តាល ប្រទេស អូស្រ្តាលី ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃសៅរ៍ ទី ២២ ខែមិថុនា ឆ្នាំ ២០១៩ ។
( ព្រះវិហារ ) ៖ កម្លាំង នគរបាល នៃ អធិការដ្ឋាន នគរបាល ស្រុក ជ័យ សែន ខេត្ត ព្រះវិហារ ចំនួន ៣៧នាក់ បាន ទទួល ការហ្វឹកហាត់ ជំនាញ បង្ការ និង ទប់ស្កាត់ ប្រឆាំង បាតុកម្ម រយៈពេល ២សប្តាហ៍ ដើម្បី បំប៉ន ចំណេះដឹង បន្ថែម សម្រាប់ យក ទៅ អនុវត្ត ជាក់ស្តែង ។
វគ្គ បណ្តុះបណ្តាល នេះ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី រឿន រើន ស្នងការ រង នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះវិហារ ទទួលបន្ទុក ការងារ ដឹកនាំ កម្លាំង អន្តាគមន៍ និង តម្រួត បទបញ្ជា តំណាង ឧត្តមសេនីយ៍ ទោ សួស សុខ ដារ៉ា ស្នងការ នគរបាល ខេត្ត រួម និង ក្រុមការងារ ជាច្រើន រូប ទៀត នៅ ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០១៩ ។
លោក ឧត្តមសេនីយ៍ ត្រី រឿន រើន បាន ថ្លែង ថា ដោយ បាន ការចង្អុល ដឹកនាំ របស់ លោក ឧត្តមសេនីយ៍ ទោ សួស សុខ ដារ៉ា លោក និង ក្រុមការងារ ថ្នាក់ ខេត្ត ចំនួន ៨នាក់ ស្រី ២នាក់ បាន ចូលរួម បើក វគ្គ បណ្តុះបណ្តាល ជំនាញ បង្ការ ទប់ស្កាត់ ប្រឆាំង បាតុកម្ម ដែល មាន រយៈពេល ២សប្តាហ៍ និង ប្រគល់ សម្ភារ ហ្វឹកហាត់ ដល់ សិក្ខាកាម សរុប ចំនួន ៣៧នាក់ ស្រី ២នាក់ នៅ អធិការដ្ឋាន នគរបាល ស្រុក ជ័យ សែន ។
ជាមួយគ្នា នោះ ដែរ លោក ឧត្តមសេនីយ៍ ត្រី រឿង រើន ក៏ បាន ផ្តាំផ្ញើ សួរសុខទុក្ខ របស់ លោក ឧត្តមសេនីយ៍ ទោស្នងការ នគរបាល ខេត្ត ដល់ កងកម្លាំង ទាំងអស់ ។
ក្រសួង ការងារ អះអាង ថា ព័ត៌មាន បឋម បាន ឱ្យដឹង ថា មាន ជនរងគ្រោះ ប្រមាណ ជាង ៣០ នាក់ ដែល រងគ្រោះថ្នាក់ ក្នុង ករណី នេះ ក្នុង នោះ ស្លាប់ ចំនួន ០៣ នាក់ របួស ធ្ងន់ ចំនួន ០២ នាក់ និង របួស ស្រាល ចំនួន ១៦នាក់ ។ ជនរងគ្រោះ ទាំងអស់ បាន ទទួល ការជួយសង្គ្រោះ ពីសំណាក់ អាជ្ញាធរ មាន សមត្ថកិច្ច និង មន្ត្រី បេឡា ជាតិ របប សន្តិសុខ សង្គម នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដោយ យកចិត្តទុកដាក់ បំផុត ។
បើ តាម ក្រសួង ការងារ . គិត ត្រឹម ម៉ោង ១០៖០០ នាទី ព្រឹក ថ្ងៃសៅរ៍ ទី ២២ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ ជនរងគ្រោះ ចំនួន ១៨ នាក់ បាន នឹង កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ព្រះសីហនុ ។ ដោយឡែក ជនរងគ្រោះ ដែល ជាប់ នៅក្នុង គំនរ អគារ បាក់បែក ត្រូវបាន អាជ្ញាធរ ពាក់ព័ន្ធ កំពុង ជួយ អន្តរាគមន៍ យ៉ាង យកចិត្តទុកដាក់ ។
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក៏ បាន ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ និង សោកស្តាយ ជា ទីបំផុត ជាមួយ ក្រុមគ្រួសារ និង ញាតិមិត្ត ទាំងអស់ នៃ សព និង ជនរងគ្រោះ ព្រមទាំង បាន ជូន ពរ ដល់ អ្នករងរបួស ទាំងអស់ ឆាប់ បាន ជាសះស្បើយ ។
បើ តាម ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ គឺ អគារ ដែល រលំបាក់ នេះ ពុំ មាន ច្បាប់ អនុញ្ញាត ទេ ហើយ ធ្លាប់ ត្រូវបាន អាជ្ញាធរ ហាមឃាត់ ក្នុង ការសាងសង់ ចំនួន ២លើក រួចទៅហើយ ៕
ពាក់ព័ន្ធ នឹង ករណី អគារ រលំបាក់ សង្កត់ មនុស្ស នេះ អ្នកនាំពាក្យ ក្រសួង រៀបចំ ដែនដី បាន បញ្ជាក់ ថា សំណង់ អគារ ខាងលើ នេះ អត់ មាន ច្បាប់ អនុញ្ញាត ទេ ហើយ ធ្លាប់ ត្រូវបាន អាជ្ញាធរ ជំនាញ ហាមឃាត់ មិន ឱ្យ សាងសង់ ចំនួន ២ដង រួចទៅហើយ ប៉ុន្តែ ម្ចាស់ សំណង់ មិន ចូលរួម សហការ ។ ម្ចាស់ សំណង់ ឈ្មោះ ជីង គ័ង ជា ជនជាតិ ចិន ទីតាំង សាងសង់ លើ ផ្ទៃដី ទំហំ ៥៨៣ ម៉ែត្រ ក្រឡា ។ អាគារ នេះ ជា ប្រភេទ សំណង់ ធ្វើ ពី ឆ្អឹង ដែក សង់ បាន កម្ពស់ ៧ជាន់ គ្មាន លិខិត អនុញ្ញាត សាងសង់ ។
ទោះបីជា យ៉ាង នេះ ក្តី អ្នកនាំពាក្យ ក្រសួង បាន ថ្លែង ឲ្យដឹង ថា ជាមួយ នេះ អាជ្ញាធរ ជំនាញ នឹង ចុះ ធ្វើការត្រួតពិនិត្យ សំណង់ ដែល មិន មាន គុណភាព សំណង់ សាងសង់ ខុសពី លិខិត អនុញ្ញាត និង សាងសង់ ដោយ គ្មាន លិខិត អនុញ្ញាត ដើម្បី មាន វិធានការ តាម ផ្លូវ ច្បាប់ ។ រីឯ ក្រុមហ៊ុន ទទួល ម៉ៅការសាងសង់ ត្រូវតែ ជា ក្រុមហ៊ុន ដែល បាន ចុះបញ្ជី និង មាន វិញ្ញាបនបត្រ ប្រកប អាជីវកម្ម សាងសង់ ចេញ ដោយ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ។
អញ្ជើញ អម ដំណើរ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី រួម មាន៖ លោក ប្រាក់ សុខុន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ . លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ពាណិជ្ជកម្ម . លោក បណ្ឌិត ហង់ ជួន ណារ៉ុន រដ្ឋមន្រ្តី អប់រំ យុវជន និង កីឡា ព្រមទាំង ឥស្សរជន ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល និង ថ្នាក់ដឹកនាំ ធុរកិច្ច នៃ សភា ពាណិជ្ជកម្ម កម្ពុជា ផងដែរ ។
យោង តាម សេចក្តីជូន ព័ត៌មាន របស់ ក្រសួង ការបរទេស បាន ឱ្យដឹង ថា កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ ធ្វើឡើង ក្រោម មូល បទ « ជំរុញ ភាពជាដៃគូ សម្រាប់ ចីរភាព » ។ កិច្ចប្រជុំ នេះ នឹង ផ្តោត ការយកចិត្តទុកដាក់ ដល់ ការលើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ និង ពង្រឹង កុង សង់ ស៊ុស ក្នុង ចំណោម សមាជិក អាស៊ាន ដើម្បី ដោះស្រាយ ការប្រឈម សកល ថ្មី ៗ ។
ស្រប ពេល ជាមួយ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ នឹង អញ្ជើញ ចូលរួម កិច្ចប្រជុំ និង កម្មវិធី មួយចំនួន ដូច ខាងក្រោម៖ * កិច្ចប្រជុំ កំពូល រវាង ប្រមុខរដ្ឋ / រដ្ឋាភិបាល អាស៊ាន ជាមួយ តំណាង អន្តរសភា អាស៊ាន * កិច្ចប្រជុំ កំពូល រវាង ប្រមុខរដ្ឋ / រដ្ឋាភិបាល អាស៊ាន ជាមួយ ក្រុមប្រឹក្សា ផ្តល់ យោបល់ ធុរកិច្ច អាស៊ាន និង * កិច្ចប្រជុំ កំពូល រវាង ប្រមុខរដ្ឋ / រដ្ឋាភិបាល អាស៊ាន ជាមួយ តំណាង យុវជន អាស៊ាន ។
ក្នុង ការត្រៀម រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ នេះ លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន នឹង អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន កិច្ចប្រជុំ លើក ទី១៩ របស់ ក្រុមប្រឹក្សា សហគមន៍ នយោបាយ - សន្តិសុខ អាស៊ាន និង កិច្ចប្រជុំ លើក ទី ២៣ របស់ ក្រុមប្រឹក្សា សម្របសម្រួល អាស៊ាន ដែល កិច្ចប្រជុំ ទាំង នេះ នឹង ប្រព្រឹត្តទៅ ពី ថ្ងៃទី ២១ - ២២ ខែមិថុនា ឆ្នាំ ២០១៩ ។
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដដែល . មាន ការរំពឹងទុក ថា លទ្ធផល នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ នឹង ឆ្លុះបញ្ចាំង ពី កិច្ចប្រឹងប្រែង របស់ អាស៊ាន ក្នុង ការជំរុញ ដំណើរការ កសាង សហគមន៍ និង លើកកម្ពស់ ភាពជាដៃគូ របស់ អាស៊ាន សម្រាប់ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព នៅក្នុង ចំណោម បញ្ហា ផ្សេង ៗ ទៀត ដើម្បី សម្រេច ឲ្យបាន នូវ សន្តិភាព ស្ថិរភាព និង វិបុលភាព យូរអង្វែង ក្នុង តំបន់ ដើម្បី ជា ផលប្រយោជន៍ ដល់ ប្រជាជន អាស៊ាន ៕
ដោយ យោង តាម ប្រភព ខាងលើ អ្នកនាំពាក្យ របស់ ឧត្តម ក្រុមប្រឹក្សា សន្តិសុខ ជាតិ អ៊ីរ៉ង់ លោក Keivan Khosravi បាន និយាយ ថា សហរដ្ឋ អាមេរិក មិន បាន ផ្ញើ សារលិខិត ណាមួយ មកកាន់ អ៊ីរ៉ង់ តាមរយៈ អូម៉ង់ ឡើយ ពោលគឺ រឿង នេះ មិន មែន ជា ការពិត ទេ ។ ក្នុង ថ្ងៃ ដដែល នេះ ប្រព័ន្ធ ផ្សព្វផ្សាយ ព័ត៌មាន លោក ខាងលិច ដោយ អះអាង ថា ពួកគេ ទទួលបាន ប្រភព ព័ត៌មាន ពី ក្រុម មន្រ្តី អ៊ីរ៉ង់ បាន រាយការណ៍ ថា ទីក្រុង តេហេរ៉ង់ បាន ទទួល សារ មួយ ពី លោក ត្រាំ ដែល រួម មាន ការព្រមាន វាយប្រហារ លើ អ៊ីរ៉ង់ រួម ជាមួយ ចេតនា ចង់ ចរចា គ្នា ។
សារ ខាងលើ ត្រូវ សារព័ត៌មាន ទាំងនោះ អះអាង ថា ត្រូវបាន ប្រគល់ មក ឲ្យ អ៊ីរ៉ង់ តាមរយៈ អូម៉ង់ កាលពី ថ្ងៃព្រហស្បតិ៍ ស្រប ពេល ដែល លោក ដូណាល់ ត្រាំ បាន អនុញ្ញាតឲ្យ បើក ការវាយប្រហារ លើ អ៊ីរ៉ង់ ដើម្បី ឆ្លើយតប នឹង ការបាញ់ ទម្លាក់ យន្តហោះ ដ្រូន របស់ អាមេរិក ប៉ុន្តែ ១០នាទី មុនបញ្ជា នេះ ត្រូវ អនុវត្តន៍ លោក ប្រធានាធិបតី អាមេរិក ក៏ បាន ដក ការបង្គាប់ ចេញ វិញ ៕
លោក អភិបាល ខេត្ត បន្ត ថា នៅ ពេល នេះ ក្រុម ជួយសង្គ្រោះ កំពុង ប្រើប្រាស់ អេស្កាវ៉ាទ័រ ចំនួន ២គ្រឿង និង គ្រឿងចក្រ ផ្សេង ទៀត ដើម្បី ស្វែងរក មនុស្ស ដែល នៅ ជាប់ ក្នុង គំនរ អគារ ដែល រលំ នេះ ។
បើ តាម អាជ្ញាធរ អគារ ដែល កំពុង សាងសង់ ហើយ បាន បាក់ រលំ នេះ ជា របស់ ជនជាតិ ចិន ដែល បាន ជួល ដី ទំហំ ទទឹង ១៥ម៉ែត្រ និង បណ្តោយ ៣០ ម៉ែត្រ សាងសង់ កម្ពស់ ៧ជាន់ សង់ បាន ប្រហែល ៨០ ភាគរយ ។
នៅ កន្លែង កើត ហេតុ គេ ឃើញ មាន ក្រុម សង្គ្រោះ ៧១១ ដែល ប្រចាំ ការ នៅ សាលាសង្គ្រោះ មិត្តភាព កម្ពុជា - ជប៉ុន ខេត្ត ព្រះសីហនុ ក៍ បាន ចេញ ទៅ ជួយ អន្តរគមន៍ ស្វែងរក ជនរង គ្រៅ ផងដែរ ។
សូម ជម្រាប ថា នៅ ម៉ោង ជិត ៥៖០០ នាទី ព្រឹក ព្រលឹម ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ មាន ករណី បាក់ រលំអគារ កម្ពស់ ៧ជាន់ នៅជិត កន្លែង លាង រថយន្ត យីហោ « អារុណ រះ » ក្នុង សង្កាត់ លេខ ៤ ក្រុង ព្រះសីហនុ ដោយ មនុស្ស ជាច្រើន នាក់ ត្រូវបាន គេ សន្និដ្ឋាន ថា កំពុង ស្ថិត នៅក្នុង គំនរ អគារ នេះ ៕
ក្នុង ការត្រៀម រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ នេះ លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន នឹង អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន កិច្ចប្រជុំ លើក ទី១៩ របស់ ក្រុមប្រឹក្សា សហគមន៍ នយោបាយ - សន្តិសុខ អាស៊ាន និង កិច្ចប្រជុំ លើក ទី ២៣ របស់ ក្រុមប្រឹក្សា សម្របសម្រួល អាស៊ាន ដែល កិច្ចប្រជុំ ទាំង នេះ នឹង ប្រព្រឹត្តទៅ ពី ថ្ងៃទី ២១ - ២២ ខែមិថុនា ឆ្នាំ ២០១៩ ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ . របួស ស្រាល ៩នាក់ និង របួស ធ្ងន់ ៧នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៧លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៧គ្រឿង . រថយន្ត តូច ៥គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធ . មិន ប្រកាន់ ស្ដាំ . ប្រជែង . បត់ ឆ្វេង ស្ដាំ . និង កត្ដាយាន ។
ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ នៅ ទីក្រុង បាងកក
( ភ្នំពេញ ) ៖ តប តាម ការអញ្ជើញ របស់ លោក ប្រាយុទ្ធ ច័ន្ទ អូឆា នាយក រដ្ឋមន្ត្រី ថៃ និង ជា ប្រធាន ប្តូរ វេន របស់ អាស៊ាន . នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ២២ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ទៅ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ ដែល នឹង ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ២២ ដល់ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០១៩ នៅ ទីក្រុង បាងកក ។
( វ៉ាស៊ីនតោន ) ៖ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ នា ថ្ងៃសុក្រ នេះ បាន ចេញមុខ ទទួលស្គាល់ ថា លោក ពិតជា បាន បង្គាប់ ឲ្យ មាន ការវាយប្រហារ យោធា លើ ទីតាំង ០៣ កន្លែង នៅក្នុង ទឹកដី ប្រទេស អ៊ីរ៉ង់ ប្រាកដ មែន ប៉ុន្តែ លោក បាន ដកបញ្ជា នេះ វិញ ក្រោយ ដឹង ថា មនុស្ស ១៥០ នាក់ នឹង បាត់បង់ជីវិត ដោយសារ ប្រតិបត្តិការ នេះ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន រុស្ស៊ី Sputnik នៅ យប់ ថ្ងៃសុក្រ ទី ២១ ខែមិថុនា ឆ្នាំ ២០១៩ ។
បើ តាម ការបង្ហោះ សារ នៅលើ បណ្តាញ សង្គម Twitter របស់ លោក ត្រាំ អ៊ីរ៉ង់ បាន បាញ់ ទម្លាក់ យន្តហោះ ដ្រូន របស់ អាមេរិក ដែល កំពុង ហោះហើរ លើ ដែន អាកាស អន្តរជាតិ កាលពី ថ្ងៃចន្ទ ដើម សប្តាហ៍ នេះ ។ លោក ដូណាល់ ត្រាំ បាន បញ្ជាក់ ថា អាមេរិក តាមពិត បាន ត្រៀមលក្ខណៈ រួច ជាស្រេច ដើម្បី សងសឹក ទៅ វិញ កាលពី យប់ ថ្ងៃព្រហស្បតិ៍ ( ពេលវេលា នៅ រដ្ឋធានី វ៉ាស៊ីនតោន ) តាមរយៈ ការគ្រោង វាយប្រហារ លើ ទីតាំង ចំនួន ០៣ ក្នុង ទឹកដី ប្រទេស អ៊ីរ៉ង់ ។
លោក ត្រាំ បាន បន្ត ថា នៅពេល លោក សួរ ទៅ មេទ័ព អាមេរិក ថា តើ មនុស្ស ប៉ុន្មាន នាក់ នឹង ត្រូវបាត់បង់ជីវិត មាន ការឆ្លើយតប មក វិញ ថា គឺ ១៥០ នាក់ ។ ក្រោយមក ត្រឹមតែ ១០នាទី ប៉ុណ្ណោះ មុន បញ្ជា វាយប្រហារ លើ ប្រទេស អ៊ីរ៉ង់ នឹង ត្រូវ អនុវត្តន៍ លោក ត្រាំ ក៏ បាន សម្រេច ដកបញ្ជា នេះ ចេញ វិញ ដោយ លោក បញ្ជាក់ ថា លោក មិន ប្រញាប់ នោះ ឡើយ ។
គួរ ជម្រាប ថា ទំនាក់ទំនង ដែល មាន ភាពតានតឹង ខ្លាំង ស្រាប់ រវាង ទីក្រុង តេហេរ៉ង់ និង ទីក្រុង វ៉ាស៊ីនតោន បាន ធ្លាក់ ដល់ កម្រិត គ្រោះថ្នាក់ ខ្លាំង ថែម ទៀត កាលពី ថ្ងៃព្រហស្បតិ៍ នេះ នៅពេល យោធា អ៊ីរ៉ង់ បាន អះអាង ថា ខ្លួន បាន បាញ់ ទម្លាក់ យន្តហោះ ដ្រូន ស៊ើបការណ៍ មួយ គ្រឿង របស់ អាមេរិក ដែល រំលោភ ចូល ដែន អាកាស អ៊ីរ៉ង់ ។
រោង ពុម្ព នេះ ត្រូវបាន ដាក់ សម្ពោធ ដំណើរការបោះពុម្ព ក្នុង ឆ្នាំ ២០១៧ ដែល មាន ទឹកប្រាក់ ១៥លាន ដុល្លារ ដើម្បី ចង ក្រង ប្រមូលផ្ដុំ រចនាបទ សិល្បៈ និង បោះពុម្ព គម្ពីរ អាល់ គួរ អាន តាម ភាសា នៃ បណ្តា ប្រទេស នានា ។ ក្នុង នោះ កម្ពុជា តាម គម្រោង បោះពុម្ព បកប្រែ ជា ភាសា ខ្មែរ ចំនួន ១០០.០០០ ក្បាល ដោយ បាន បញ្ជូន ជា ដំណាក់កាល ទី មួយ ៣២. ០៣៣ និង គម្ពីរ ពុំ មាន ការបកប្រែ១០. ២០០ ក្បាល ក្នុង ឆ្នាំ ២០១២ ហើយ ក្នុង ចុង ខែមិថុនា នេះ នឹង បញ្ចូន ១៧.០០០ ក្បាល ទៀត ។
ក្នុង នាម ម៉ាឡេស៊ី ជា ប្រទេស ឥស្លាម ចំពោះ ការបង្កើត រោង ពុម្ព នេះ ធ្វើឡើង ដើម្បី លើកកម្ពស់ កិត្យានុភាព វប្បធម៌ សាសនា ឥស្លាម បន្ត ចូលរួម ថែរក្សា ពង្រីក ផ្សព្វផ្សាយ នូវ គម្ពីរ ដែល ជា ព្រះបន្ទូ របស់ ព្រះអល់ ឡោះ ជា ម្ចាស់ បាន បញ្ចុះ មក ប្រជាជាតិ ឥស្លាម តាមរយៈ ព្យាការី ម មូហាំ ម៉ាត់ តាំងពី ១៤៤០ ឆ្នាំ មុន ។
គម្ពីរ អាល់ គួរ អាន ជា ព្រះធម៌ និង ច្បាប់ សម្រាប់ មនុស្សលោក ទូទៅ យក ជា ត្រី វិស័យ ឆ្លុះបញ្ជាំង អប់រំ និង ការប្រណិប័តន៍ ធម៌ ក្នុង ពេល កំណើត មនុស្ស ជាពិសេស អ្នក កាន់ សាសនា ឥស្លាម អាច កើន ដល់ ៣ពាន់ លាន នាក់ នៃ ចំនួន ប្រជាជន ពិភពលោក សរុប ៩ពាន់ លាន នាក់ ក្នុង ឆ្នាំ ២០៥០ ។
គម្ពីរ អាល់ គួរ អាន បាន ចែក ជា៣០ ភាគ ១១៤ ជំពូក ៦. ៦១៦ ធម្មខ័ណ្ឌ ៧៤. ៤៣៧ ពាក្យ ៣២៥. ៣៤៥ តួ អក្សរ ទាំងអស់ នេះ សុទ្ធតែ ជា ព្រះបន្ទូល របស់ អល់ ឡោះ ជា ម្ចាស់ តែ មួយ គត់ ឥត ក្លែងបន្លំ ឥត កែប្រែ និង ឥត មាន លាយឡំ នឹង សំដី របស់ បុគ្គល ណា ម្នាក់ ឡើយ ៕ ក្រសួង កិច្ចការ នារី ជំរុញ ឲ្យ សិល្បក - សិល្បការិនី កម្ពុជា ជួយ លើកកម្ពស់ សីលធម៌ សង្គម តម្លៃ ស្រ្ដី និង គ្រួសារ ខ្មែរ
( ភ្នំពេញ ) ៖ ក្រសួង កិច្ចការ នារី នា រសៀល ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ បាន រៀបចំ កិច្ចប្រជុំ មួយ ជាមួយ សិល្បករ - សិល្បការិនី ក្រោម ប្រធានបទ ស្ដីពី ការលើកកម្ពស់ សីលធម៌ សង្គម . តម្លៃ ស្រ្ដី និង គ្រួសារ ខ្មែរ ។
កិច្ចប្រជុំ រវាង ក្រសួង កិច្ចការ នារី និង សិល្បករ - សិល្បការិនី នេះ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី ចូលរួម ផ្សព្វផ្សាយ ការលើកកម្ពស់ សីលធម៌ សង្គម . តម្លៃ ស្រ្ដី នេះ តាមរយៈ សិល្បករ - សិល្បការិនី ផ្សព្វផ្សាយ ដល់ សាធារណជន ។
លោកស្រី បន្ដ ថា ក្នុង កិច្ចប្រជុំ នេះ មាន សិល្បករ - សិល្បការិនី បាន ប្ដេជ្ញាចិត្ត យ៉ាង ខ្ពស់ ក្នុង ការចូលរួមចំណែក ចូលរួម ផ្សព្វផ្សាយ ក៏ ដូចជា ធ្វើជា គំរូល្អ ដល់ សង្គមជាតិ ពិសេស ជា គំរូ ដ៏ ល្អ សម្រាប់ យុវវ័យ នេះ ឯង ។
លោកស្រី បញ្ជាក់ ថា ជាធម្មតា តារា ច្រើន តែ មាន អ្នក ស្គាល់ និង អ្នកទស្សនា ច្រើន ដូច្នេះហើយ បានជា ក្រសួង ត្រូវការ ការចូលរួមចំណែក ពី សិល្បករ - សិល្បការិនី ។ ជាក់ស្ដែង គំរូ ដែល នឹង ត្រូវ ចែករំលែក តាមរយៈ សិល្បករ - សិល្បការិនី នេះ មាន ដូច ជា៖ ការស្លៀកពាក់ . ការនិយាយ ស្ដី . កាយវិការ ផ្សេង ៗ ជាដើម ។
តាមរយៈ ក្រសួង កិច្ចការ នារី ក៏ បាន ស្នើឲ្យ ថ្នាក់ដឹកនាំ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ទាំងអស់ រួមទាំង អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ ត្រូវ បន្ដ យកចិត្តទុកដាក់ ឲ្យ កាន់តែ ខ្លាំងក្លា ដោយ សហការ និង គាំទ្រ ដល់ ការអប់រំ ផ្សព្វផ្សាយ ឲ្យ ទូលំទូលាយ អំពី សីលធម៌ . សុជីវធម៌ ក្នុង ការរស់នៅ និង ច្បាប់ ពាក់ព័ន្ធ ទាំងឡាយ ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ គ្រប់ ទិសទី ទាំងអស់ ទាំង ក្នុង គ្រួសារ . កន្លែង ធ្វើការ និង សហគមន៍ ជាដើម ៕
១៖ សម្តេច តេជោ ហ៊ុន សែន៖ ក្រៅពី អាស៊ាន ទាំង១០ គឺ កម្ពុជា នឹង បន្ត ពង្រីក មិត្តភាព និង សហប្រតិបត្តិការ ជាមួយ ប្រទេស ដៃ គូ ថ្មី ៗ ជាច្រើន ថែម ទៀត ( ចុច អាន )
៥៖ សហភាព អឺរ៉ុប ផ្តល់ ថវិកា ជាង ១លាន ដុល្លារ ពង្រឹង សមត្ថភាព អាជ្ញាធរ ថ្នាក់ ក្រោម ជាតិ នៅ កម្ពុជា ក្នុង ការរៀបចំ ផែនការ នគរូបនីយកម្ម និង ការគ្រប់គ្រង ដីធ្លី ( ចុច អាន )
៦៖ តុលាការ សម្រេច ឃុំ ខ្លួន នគរបាល ច្រកទ្វារ អន្ដរជាតិ ក្អម សំណរ និង បក្ខពួក ទាំង ៤នាក់ ដែល លាយ ថ្នាំ ឲ្យ នារី ខារ៉ាអូខេ ផឹក បណ្ដាលឲ្យ ស្លាប់ និង ពុល ( ចុច អាន )
៨៖ ក្រោយ ជំងឺ គ្រុន ឈាម ផ្ទុះឡើង ខ្លាំង ! ក្រសួង អប់រំ ចេញ សេចក្ដីណែនាំ វិធានការ បង្ការ និង ការពារ ជំងឺ គ្រុន ឈាម នៅ តាម គ្រឹះស្ថាន សិក្សា ចំណេះ ទូទៅ សាធារណៈ និង ឯកជន ( ចុច អាន )
១១៖ ក្រុមហ៊ុន អង្គរ ឌែរី ប្រូដាក ខូអិលធីឌី បង្ហាញ លទ្ធផល ពិសោធន៍ អង្គរ មីល ( ចុច អាន )
១៖ ទីបំផុត លោក ស៊ី ជិន ពីង ចាកចេញ ពី កូរ៉េ ខាងជើង ហើយ ដោយ បាន បន្សល់ទុក នូវ ក្តីសង្ឃឹម គួរឲ្យ កត់សម្គាល់ ( ចុច អាន )
៤៖ បាតុករ រាប់ ពាន់ នាក់ ប្រមូលផ្តុំ មុខ អគារ សភា ទីក្រុង ហុងកុង ដើម្បី ទាមទារ ឲ្យ លោកស្រី អភិបាល ចុះចេញ ពី តំណែង ( ចុច អាន )
៨៖ ការបាញ់ ទម្លាក់ ដ្រូន អាមេរិក តម្លៃ ជាង ២០០ លាន ដុល្លារ ធ្វើឲ្យ ស្ថានការណ៍ នៅ មជ្ឈិមបូព៌ា កាន់តែ ពុះកញ្ជ្រោល ! ( ចុច អាន )
១៣៖ កង រថក្រោះ អាមេរិក ច្រឡំ បើក កិន ចំការ ដំណាំ នៅរ៉ូម៉ានី កំឡុង ការធ្វើ សមយុទ្ធ យោធា អន្តរជាតិ មួយ . សំណង នឹង ត្រូវ ទូទាត់ ជូន ប្រជាជន ក្នុង តំបន់ ( ចុច អាន )
១៥៖ រុស្ស៊ី ទើប ចេញមុខ ចោទប្រកាន់ លើ អាមេរិក ថា កំពុង ដុត កំហឹង អ៊ីរ៉ង់ និង រុញ ច្រាន ឲ្យ ទៅរក សង្គ្រាម នៅ មជ្ឈិមបូព៌ា ( ចុច អាន )
ព្រឹក ស្អែក សម្តេច តេជោ ហ៊ុន សែន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ នៅ ទីក្រុង បាងកក
( ភ្នំពេញ ) ៖ តប តាម ការអញ្ជើញ របស់ លោក ប្រាយុទ្ធ ច័ន្ទ អូឆា នាយក រដ្ឋមន្ត្រី ថៃ និង ជា ប្រធាន ប្តូរ វេន របស់ អាស៊ាន . នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ២២ ខែមិថុនា ឆ្នាំ ២០១៩ស្អែក នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ទៅ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ ដែល នឹង ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ២២ ដល់ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០១៩ នៅ ទីក្រុង បាងកក ។
យោង តាម សេចក្តីជូន ព័ត៌មាន របស់ ក្រសួង ការបរទេស បាន ឱ្យដឹង ថា កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៣៤ ធ្វេី ឡេីង ក្រោម មូល បទ « ជំរុញ ភាពជាដៃគូ សម្រាប់ ចីរភាព » ។ កិច្ចប្រជុំ នេះ នឹង ផ្តោត ការយកចិត្តទុកដាក់ ដល់ ការលើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ និង ពង្រឹង កុង សង់ ស៊ុស ក្នុង ចំណោម សមាជិក អាស៊ាន ដើម្បី ដោះស្រាយ ការប្រឈម សកល ថ្មី ៗ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ រៀបចំ សិក្ខាសាលា បង្ហាញ ផែនការ មេដឹកជញ្ជូន ក្នុង រាជធានី
( ភ្នំពេញ ) ៖ រដ្ឋបាល ភ្នំពេញ នៅ ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០១៩ បាន រៀបចំ សិក្ខាសាលា ពិគ្រោះយោបល់ លើ សេចក្តីព្រាង ផែនការ មេដឹកជញ្ជូន ក្នុង រាជធានី ភ្នំពេញ ក្រោម អធិបតីភាព លោក នួន ផារត្ន័ អភិបាល រង រាជធានី និង ជា តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ដោយ មាន ការចូលរួម ពី អាជ្ញាធរ មូលដ្ឋាន រដ្ឋបាល ខ័ណ្ឌ ទាំង ១៤ និង សង្កាត់ ទាំង ១០៥ អ្នកជំនាញ ការជាតិ អន្តរជាតិ អញ្ជើញ ពី បណ្តារ សកលវិទ្យាល័យ និង ដៃគូ អភិវឌ្ឍន៍ ។
លោក ស៊ុយ សេរិទ្ធ អភិបាល រង រាជធានី ភ្នំពេញ បាន លើកឡើង ថា សិក្ខាសាលា នេះ ធ្វើឡើង ដើម្បី ប្រមូល ធាតុ ចូល ដើម្បី ធ្វើ បច្ចុប្បន្នភាព ផែនការ មេ ដែល បាន ផ្តើម រៀបចំ សិក្សា នៅ ឆ្នាំ ២០០១ និង បញ្ចប់ នៅ ឆ្នាំ ២០០៥ ដោយ មាន ជំនួយ បច្ចេកទេស ពី ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ ជប៉ុន (JICA) ប៉ុន្តែ ផែនការ នេះ រហូតដល់ បច្ចុប្បន្ន នៅ មិន ទាន់ បាន អនុម័ត ជា ផ្លូវការ នៅឡើយ ។ ផែនការ នេះ ជា ផែនការ សម្រាប់ ភ្នំពេញ នៅ ឆ្នាំ ២០៣៥ ។ បញ្ហា ចរាចរណ៍ និង គមនាគមន៍ បើ យើង មិន ដោះស្រាយ ពេលនេះ វា កាន់តែ ស្មុគស្មាញ ។
លោក បាន ឲ្យដឹង ថា ភ្នំពេញ បច្ចុប្បន្ន មាន ភ្លើង ស្តុប និង កាម៉េរា ១១៥ ដែល មាន ភ្ជាប់ នឹង ប្រព័ន្ធ គ្រប់គ្រង ឆ្លាតវៃ ដែល មាន សមត្ថភាព កំណត់ ភ្លើង ខៀវ ក្រហម ដោយ ស្វ័យប្រវត្តិ តាម ចំនួន អ្នកធ្វើដំណើរ និង វត្តមាន ប្រតិភូ ជាដើម ។ តែ ដង់ស៊ីតេ ប្រជាជន កើន ខ្លាំង ជា គំហុក ហើយ ស្ថានភាព ចរាចរណ៍ កាន់តែ ស្មុគស្មាញ ដោយសារតែ ឥរិយាបទ មិន គោរព ច្បាប់ ។ ភ្នំពេញ រីក ធំ ដោយសារ កាត់ យក ឃុំ ជាង ២០ ឃុំ ពី ខេត្ត កណ្តាល ។ ឡានក្រុង បច្ចុប្បន្ន មាន អ្នកប្រើប្រាស់ ប្រចាំ ថ្ងៃ ជិត ៣ម៉ឺន នាក់ ។
ការធ្វើ បច្ចុប្បន្នភាព និង អនុម័ត ផែនការ មេ នេះ នឹង ក្លាយជា ឯកសារ ដើម្បី កៀង គរ ហិរញ្ញប្បទាន ផ្សេង ៗ និង ការគាំទ្រ ពី ក្រសួង ពាក់ព័ន្ធ ជាដើម ដើម្បី អនុវត្ត ផែនការ មេ នេះ ឲ្យ ជោគជ័យ ។
លោក ស៊ូហ្កាណូ យូអិុ ឈី ប្រធាន ទីភ្នាក់ងារ JICA បាន បញ្ជាក់ ថា ការសិក្សា បាន បញ្ចប់ តាំងពី ឆ្នាំ ២០១៤ ដោយ កំណត់ បាន នូវ គម្រោង អាទិភាព ជាច្រើន រហូត ឈានដល់ ការផ្តល់ ឡានក្រុង ៨០ និង ការបំពាក់ ប្រពន្ធ័ គ្រប់គ្រង ចរាចរណ៍ ឆ្លាតវៃ និង មជ្ឈមណ្ឌល គ្រប់គ្រង និង ឃ្លាំមើល ចរាចរណ៍ ។ សង្ឃឹម ថា គ្រប់ ភាគី នឹង ចូលរួម អនុវត្ត ផែនការ មេ នេះ ឲ្យបាន ជោគជ័យ ។
លោក បាន បន្ត ថា យើង ជុំគ្នា ថ្ងៃ នេះ ដើម្បី ដឹង ថា ក្រោយ សិក្សា ចប់ ផែនការ មេ នេះ មិត្តភ័ក្តិ និង ជា ដៃគូ ល្អ របស់ យើង ជាពិសេស យើង បាន រួមគ្នា សិក្សា រួមគ្នា អនុវត្ត និង តាមដាន ការអនុវត្ត ទាំងអស់ គ្នា ។
លោក ម៉ាសាតុ កូតូ អ្នកជំនាញ ការ ទីភ្នាក់ងារ JICA បាន លើកឡើង ថា បើ តាម ការសិក្សា ចិញ្វើម ផ្លូវ និង ផ្លូវ ថ្មើជើង ត្រូវបាន ប្រើ ដើម្បី ចត ឡាន ឬ លក់ដូរ ហើយ ល្បឿន ធ្វើដំណើរថយចុះ ខ្លាំង ខណៈ តម្រូវការ ក្នុង ការធ្វើដំណើរ កើនឡើង លឿន ជាង កំណើន មនុស្ស ។
( ភ្នំពេញ ) ៖ « មន្ត្រី មាន តែ ឈ្មោះ មិន ដែល ឃើញ មុខ មក ធ្វើ ការ » ជា ពាក្យ រិះគន់ មួយ ដែល ឧស្សាហ៍ លើកឡើង នៅ តាម ក្រសួង ស្ថាប័ន នានា របស់ រដ្ឋ ។ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន ក្រើន រំលឹក ក្រសួង ស្ថាប័ន ឱ្យ បញ្ចូល ប្រព័ន្ធ បច្ចេកវិទ្យា ដើម្បី គ្រប់គ្រង បញ្ជី វត្តមាន និង តាមដាន មន្ត្រី ដែល មិន មក បម្រើ ការងារ នេះ ថែម ទៀត ផង ។
គោរព តាម ស្មារតី របស់ សម្តេច តេជោ ហ៊ុន សែន និង ចូលរួម លុបបំបាត់ ភាព សកម្ម របស់ មន្ត្រី « មាន តែ ឈ្មោះ មិន មក ធ្វើ ការ » ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន និង កំពុង ចាប់ផ្តើម ធ្វើ ប្រព័ន្ធ ស្វ័យប្រវត្តកម្ម ដើម្បី គ្រប់គ្រង លើ បញ្ជី វត្តមាន និង តាមដាន មន្ត្រី ដែល មិន មក បម្រើ ការងារ នេះ ។
ពេល ថ្មី ៗ នេះ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ដឹកនាំ កិច្ចប្រជុំ ដោយ ផ្ទាល់ ពិភាក្សា ទៅ លើ ការបង្កើត ប្រព័ន្ធ ស្វ័យប្រវត្តកម្ម គ្រប់គ្រង វត្តមាន មន្ត្រីរាជការ នេះ ។
លោក ហ៊ាង សុទ្ធា យុត្តិ អ្នកនាំពាក្យ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ ថា « កិច្ចប្រជុំ ធ្វើឡើង ដើម្បី ពង្រឹង យន្តការគ្រប់គ្រង និង តាមដាន វត្តមាន របស់ មន្ត្រីរាជការ ក្រោម ឱវាទ ក្រសួង ដើម្បី កំណត់ មូលដ្ឋាន ក្នុង ការផ្តល់ អត្ថប្រយោជន៍ ប្រចាំ ខែ សម្រាប់ លើកទឹកចិត្ត មន្ត្រី ដែល មក បំពេញ ការងារ ទៀងទាត់ » ។
បើ តាម លោក សុទ្ធា យុត្តិ ក្នុង កិច្ចប្រជុំ នោះ ក៏ បាន ពិភាក្សា លើ ការកំណត់ ពេលវេលា ស្កេន ម្រាម ដៃ របាយការណ៍ និង ការជូនដំណឹង តាម ប្រព័ន្ធ បច្ចេកវិទ្យា វៃ ឆ្លាត ទៅកាន់ សាមីខ្លួន ដើម្បី អាច ត្រួតពិនិត្យ ភ្លាម ៗ តាម ទូរសព្ទ ដៃ ស្មាតហ្វូន ឬ Tablet ។
តាមរយៈ កិច្ចប្រជុំ នោះ លោក ទេសរដ្ឋមន្ត្រី បាន ឯកភាព ឱ្យ នាយកដ្ឋាន ទទួលបន្ទុក រៀបចំ លិខិត បទដ្ឋាន ផ្លូវការ ពី ការអនុវត្ត ប្រព័ន្ធ គ្រប់គ្រង វត្តមាន មន្ត្រីរាជការ និង បណ្តុះបណ្តាល អំពី របៀប ប្រើប្រាស់ ប្រព័ន្ធ ដល់ គ្រប់ អង្គភាព ក្រោម ឱវាទ ក្រសួង ដើម្បីឱ្យ មាន លក្ខណៈ ល្អ ប្រសើរ ។
