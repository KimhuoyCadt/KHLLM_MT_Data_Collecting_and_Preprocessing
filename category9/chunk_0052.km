និយាយពីការ បណ្ដោយខ្លួនរបស់បុរសខ្លះ ?
2:5 ដល់ពួកគេ យើងមិនព្រមចុះចូលសូម្បីតែមួយ ភ្លែត ដើម្បីឲ្យសេចក្ដី ពិតនៃដំណឹងល្អអាចត្រូវបានរក្សាទុកសម្រាប់អ្នក ។
គាត់ចង់បានកូននោះឥឡូវ ២
អ៊ីចឹងបើគាត់និយាយត្រូវ តើគាត់គួរជាប់គុកនៅពេលនេះទេ ?
យើងបានយកកូនប្រុសរបស់យើងដែលមានការ ផ្ទុះរហូតដល់គាត់ត្រូវទឹក។
ខ្ញុំជាស្ត្រីដែលឈរក្បែរអ្នកនៅ ទីនេះ ដោយអធិស្ឋានដល់ព្រះ‌ អម្ចាស់ ។
អ្នក គោរព បូជា ។
ហើយពួកគេបាននិយាយថា៖ ' នេះគឺជា សញ្ញាទាំងអស់នៃមហារីក ក្រពេញទីរ៉ូអ៊ីត ។
ដែល រស់ នៅ លើ ផែនដី ដែល ព្រះជាម្ចាស់ បាន បង្កើត ។
ហេតុ អ្វី បានជា បុរស ម្នាក់ នេះ ត្រូវបាន គេ វាយប្រហារ ?
13 គ្រប់គ្នានឹងស្អប់អ្នក រាល់គ្នាដោយព្រោះខ្ញុំ ប៉ុន្តែអ្នក ណាដែលឈរយ៉ាងរឹងមាំរហូតដល់ចុងបំផុតនឹងបាន សង្គ្រោះ ។
ម្តាយ ខ្ញុំ អាក្រក់ ដូច្នេះ ខ្ញុំ ត្រូវតែ ធ្វើ វា សម្រាប់ នាង ។
ប្រាក់ ឧបត្ថម្ភ របស់ រដ្ឋាភិបាល មួយ ថ្ងៃ ។
ព្រះកំពុង ដើរ ក្បែរ ខ្ញុំ ។
អ្នក កំពុង ឈាន ទៅរក ភាពជោគជ័យ បន្ថែម ទៀត !
នៅទីនោះមានស្ត្រី ១០ នាក់ ។
អ្នក រាល់គ្នាជាមិត្តរបស់ខ្ញុំ បើអ្នកធ្វើតាមបង្គាប់ខ្ញុំ ។
ចែកជាដុំស្អាតនៃទម្ងន់បីទៅបួនអោន ។
ខ្ញុំដួលទៅដី ហើយយំយ៉ាងខ្លាំង ។
សន្តិភាព នៅ ពេល យប់ ។
នៅក្នុងការ ឈានដល់របស់ពួកគេ ពួកគេត្រូវបាននាំទៅ កាន់ កាន់ទុក្ខ
12 ពីព្រោះគាត់នឹក ចាំថានឹងទារឈាមគេ ហើយគាត់មិនភ្លេចការ យំរបស់អ្នកក្រ ឡើយ ។
ប៉ុន្តែ ព្រះអម្ចាស់បានឈរក្បែរខ្ញុំ ហើយប្រទានអំណាចមកខ្ញុំ ដើម្បីឱ្យខ្ញុំបានប្រកាស សារទាំងមូលសម្រាប់អ្នកមិនគោរពសាសនាទាំងអស់បាន ឮ ។ ដូច្នេះ ខ្ញុំត្រូវបានគេ សង្គ្រោះពីមាត់ តោ ។
ទីក្រុងនេះមិនត្រូវការ ព្រះអាទិត្យ ឬព្រះ ច័ន្ទដើម្បីបំភ្លឺឡើយ ដ្បិតសិរី រុងរឿងរបស់ព្រះជាម្ចាស់បំភ្លឺវា ហើយកូនចៀមជា ចង្កៀង ។
ដូច្នេះ យើងបានធ្វើដំណើរទៅផ្ទះយ៉ាង ណាក៏ដោយ ដើម្បីមើលវាពីខាងក្រៅ ។
“ អរគុណយ៉ាងខ្លាំងម្តងទៀតសម្រាប់យប់មិញ ។
ប៉ុន្តែ មុននឹង អ្វី ផ្សេង ទៀត យើង ត្រូវបាន គេ មើលឃើញ ។
ផែនការ របស់យើងគឺបញ្ជូនវាទាំងអស់ទៅប្រទេសកាណាដា » ។
អ្នក បានបញ្ជូនខ្ញុំចេញថ្ងៃនេះពីមុខនៃផែនដីនិងពីមុខមុខរបស់អ្នក ; ខ្ញុំនឹងធ្វើជាអ្នកដើរហើរលើផែនដី ហើយអ្នក ណាឃើញខ្ញុំនឹងសម្លាប់ខ្ញុំ ។
ខ្ញុំ វិនិច្ឆ័យថា ខ្ញុំមិននៅពីក្រោយមេ នៃ សាវ័កទេ ។
ព្រះយេស៊ូមានព្រះបន្ទូល តប ថា៖ « ខ្ញុំ ជាផ្លូវ ជាសេចក្ដី ពិត និងជាជីវិត » ។
មុនបញ្ហាដែលមិនចេះចប់ ។
ប្រភេទ នៃ ការភ្នាល់ ដែល ចូលចិត្ត ជាង គេ គឺ ការភ្នាល់ ។
គាត់ បាន និយាយ ថា “ នាង ហិនទ័រ គឺជា មនុស្ស ម្នាក់ ក្នុង ចំណោម អ្នក ដែល បាត់បង់ សមាជិក គ្រួសារ ច្រើន ជាង គេ ។
ស្ត្រី មិន គ្រប់គ្រាន់ សម្រាប់ ពួកគេ ទាំងអស់ ។
ខ្ញុំ ជា ម្ចាស់ ផ្ទះ នៅ ទីនេះ ។
សេរីភាព សារព័ត៌មានជុំវិញពិភពលោកនេះបើតាមអង្គការអ្នក កាសែតគ្មានព្រំដែន
ប្រតិបត្តិករ ត្រូវបាន អនុញ្ញាតឱ្យ ដំណើរការរបារ គ្រាប់ ចុច មុខងារ
ស្ត្រី ត្រូវតែ បំភ្លេច កូន របស់ គាត់ ព្រះនឹង មិន ភ្លេច ពិភពលោក ដែល ទ្រង់ បាន បង្កើត នោះ ទេ ។
បន្ទាប់មក គាត់ បាន បញ្ចូល វា ជាមួយ វត្ថុ ផ្ទាល់ខ្លួន របស់ គាត់ ។
ពួកគេនៅក្នុង ទីលាក់ខ្លួន ។
ដើម្បី កុំ ឱ្យ ខ្ញុំ ក្លាយជា មនុស្ស អួត ខ្លួន ដោយសារ វិវរណៈ ដ៏ អស្ចារ្យ ដ៏ អស្ចារ្យ ទាំង នេះ មាន បន្លា មួយ នៅក្នុង សាច់ ឈាម របស់ ខ្ញុំ គឺជា អ្នកនាំ សារ របស់ សាតាំង ដើម្បី ធ្វើ ទារុណកម្ម ខ្ញុំ ។
« មិនគិតថាជីវិតរបស់អ្នក ឥឡូវពោរពេញទៅដោយទុក្ខព្រួយ និងអស់ សង្ឃឹមឬ ?
ប៉ុន្តែ ប្រសិនបើ ( ដោយសារតែ ពពក ) ទីតាំង ពិត នៃ ព្រះច័ន្ទ ត្រូវបាន លាក់បាំង ពី អ្នក នោះ អ្នក គួរតែ បំពេញ សាមសិប ថ្ងៃ ។
នៅក្នុង សៀវភៅ នេះ អ្នក នឹង រកឃើញ ហេតុផល សម្រាប់ ពាក្យបណ្តឹង ទូទៅ ។
សូហ្វៀ មាន ន័យ ថា ប្រាជ្ញា ។
12 ចំពោះអ្នកដែលទ្រង់មាន បន្ទូលថា៖ « នេះជាអ្វីដែលនៅ សល់ដែលទ្រង់ប្រទានដល់អ្នក នឿយ ហត់ » ។ ហើយ " នេះ គឺជា ការធ្វើឱ្យ ស្រស់ " ប៉ុន្តែ ពួកគេ មិន ចង់ ឮ ទេ ។
អ្វី ៗដែលសំខាន់សម្រាប់ប្រជាជនថៃត្រូវបានបំផ្លាញ ។
ជាអធិបតេយ្យដ៏ អស្ចារ្យបំផុតក្នុងលោក ទ្រង់ជាកំពូល ។
ប៉ុន្តែនឹងគ្មានសេចក្ដី មេត្តា ក រុណាចំពោះមនុស្សអាក្រក់ឡើយ ។
តោះ ចាប់ផ្តើម ថ្ងៃ នេះ
" កិច្ចព្រមព្រៀង ថ្មី បៃតង គឺជា ដំណោះស្រាយ តម្លៃ ដែល មិន ជាប់ពាក់ព័ន្ធ ។
ហើយ គាត់ សន្មត់ ថា ជា អ្នក ផ្លាស់ប្តូរ រាង ។
ការប្រាស្រ័យទាក់ទង ជាមួយ ព្រះនៅក្នុង ការអធិស្ឋាន - នៅ ពេល ដែល យើង អធិស្ឋាន យើង ដាក់ ខ្លួន យើង នៅ ចំពោះ បល្ល័ង្ក របស់ ព្រះ។
ដូច្នេះអ្នកគិតថា “ ហេតុអ្វីបានជាខ្ញុំនៅ លីវ ?
អ្នក ប្រហែលជា ជឿ ថា អ្នក ទទួលខុសត្រូវ ចំពោះ អ្វី ដែល អ្នក ធ្វើ ប៉ុន្តែ មិន មែន សម្រាប់ អ្វី ដែល អ្នក គិត នោះ ទេ ។
ដ្បិតអ្នក រាល់គ្នាបានស្លាប់ទៅ ហើយជីវិតរបស់អ្នកត្រូវបានលាក់ទុកជាមួយព្រះគ្រិស្ដក្នុងព្រះ។
« ប្រហែលជាពេលនោះ គាត់នឹងអាចយកឈើមកដុត » ។
ប្រជាជន មិន ចង់បាន ជំនួយ បែប នេះ ទេ ។
នៅពេល អ្នក លាក់ វា ហើយ រក្សាទុក វា វា នឹង ផ្តល់ឱ្យ អ្នក នូវ កំហុស មួយ បាន កើតឡើង ។
វា ជា អំពើ បាប ដែល ព្រះស្អប់ ។
លោកបាននិយាយថា ពួកគេត្រូវបានគេរាយការណ៍ថាបាននៅទីនោះតាំងពីម៉ោង ៦ ល្ងាចនៅយប់ថ្ងៃសៅរ៍ ។
បាន ផ្តល់ ដំបូន្មាន ឬ បំណងប្រាថ្នា របស់ ពួក អភិជន ដ៏ អស្ចារ្យ ។
