ត្រឡប់មកផ្ទះវិញរហូតដល់មានគាត់ទៀត ។
« យើងត្រូវតែទទួល យកថាវាគ្មានប្រយោជន៍ការ ចាប់ខ្លួនទេ ។
បន្ទាប់ពីយប់មិញ ពួកគេលែងស្ថិតក្នុងទីតាំងដើម្បីទទួលបានឱកាសដែលមិនអាចរំលងបានទៀតហើយ ។
រកឃើញហើយមិនជឿថាមានអ្វីកើតឡើង ។
តើ អ្នក ចង់ ក្លាយជា មេបញ្ជាការ ទេ ?
គាត់ រស់ នៅក្នុង ផ្ទះ ដែល គេ បោះបង់ ចោល មួយ មុនពេល គាត់ ត្រូវបាន គេ រកឃើញ ។
គេបោកបញ្ឆោតមិនមែនតែខ្ញុំទេ តែជាមនុស្សជាច្រើននាក់ទៀត ។
ទំនុកចិត្ត គឺជា បញ្ហា ធំ សម្រាប់ គាត់ ។
ការ មិន ធ្វើ អ្វី ទាំងអស់ ហើយ សង្ឃឹម ថា ល្អ បំផុត គឺជា កំហុស មួយ ។
ជារៀងរាល់ ថ្ងៃ ខ្ញុំ ត្រូវ ប្រាកដ ថា ខ្ញុំ ព្យាយាម កត់សម្គាល់ រឿង តូចតាច ។
តើពួកគេពិតជាវិញ្ញាណនៃមនុស្សស្លាប់មែនឬ ?
ខ្ញុំត្រូវបានគេល្បួងយ៉ាងខ្លាំងឱ្យចូលរួមជាមួយកុមារ ។
គាត់ បាន ប្រញាប់ ហើយ ឡើង ទៅ លើ
ប្រពន្ធ កូន និងហ្វូងសត្វរបស់អ្នកអាចនៅ ទីនេះក្នុងស្រុកដែលលោកម៉ូសេ ប្រគល់ឲ្យអ្នកនៅត្រើយខាងកើតនៃទន្លេយ័រ ដាន់ ។
១៤ « សូមឲ្យ ពរដល់អស់អ្នកដែលបៀតបៀនអ្នក ចូរឲ្យ ពរហើយកុំដាក់បណ្ដា សា ឡើយ ។
គាត់ត្រូវបានគេសម្លាប់ក្នុងដំណើរ ការ » ។
៤ ព្រះគ្រិស្ដ ជា ទីបញ្ចប់ នៃ ក្រិត្យ វិន័យ ដើម្បី អោយ មាន សេចក្ដីសុចរិត ដល់ អស់ អ្នក ដែល ជឿ ។
ជន ជាតិយូដា និងអ្នក គោរពកោតខ្លាចព្រះ មួយចំនួននេះ ត្រូវបានដកស្រង់នៅក្នុង ខទី ១១ ដោយនិយាយថា « យើងឮពួកគេនិយាយភាសារបស់យើងផ្ទាល់អំពី ការ ប្រព្រឹត្តដ៏ អស្ចារ្យរបស់ព្រះ» ។
ពួកគេបានទៅក្រុងដែលបុរសរបស់ព្រះជាម្ចាស់នៅ ។
អព្ភូតហេតុនេះមិនយូរប៉ុន្មានបានត្រូវគេស្គាល់ទូទាំងទីក្រុង ហើយបានជំរុញឲ្យជន ជាតិជាច្រើនចូលរួមជាមួយអ្នក ស្មោះត្រង់ ។
នៅ ពេល ដែល វា កាន់កាប់ មួយ ភាគ ដប់ វា អវត្តមាន នៅក្នុង ប្រាំបួន ភាគ ដប់ ផ្សេង ទៀត ។
ដូច្នេះហើយ ចាប់ពី ពេល ចាប់ផ្តើម អ្នក ត្រូវតែ ប្រឹងប្រែង ឱ្យ អស់ ពី សមត្ថភាព ទើប អ្នក អាច សរសេរ និក្ខេប បទ បាន ល្អ ។
ពេលនោះ គេនឹងដឹងថា យើងជាព្រះ‌ អម្ចាស់ ជាព្រះ របស់គេ » ។
ចូរគោរពអ្នកផ្គត់ផ្គង់ដែលនិយាយការពិត ហើយ រត់ចេញពីអ្នកកុហក ។
លោកម៉ូសេ ត្រូវបានចិញ្ចឹមនៅក្នុងដំណាក់របស់ផារ៉ោន ។
មាន « ថ្ងៃមួយដែលទ្រង់នឹងជំនុំ ជម្រះលោកីយដោយសេចក្ដី សុចរិត » ។
បន្ទាប់មកពួកគេសម្រេច ចិត្តយកសាច់ក្រកទៅចៀនលើភ្លើង ។
« ត្រូវប្រាប់គេថា ព្រះ‌ យេហូវ៉ាទ្រង់មានព្រះ‌បន្ទូលថា បើឯងមិនព្រមស្តាប់អញ ឲ្យប្រព្រឹត្តតាមច្បាប់ អញ ដែលអញបានតាំងនៅចំពោះឯង ហើយស្តាប់តាមពាក្យរបស់ពួកហោរា ដែលអញចាត់ឲ្យមកឯងជាបន្ទាន់ អ្នក រាល់គ្នាមិនបានស្តាប់តាមទេ នោះយើងនឹងធ្វើផ្ទះនេះឲ្យដូចជាស៊ីឡូ ហើយយើងនឹងធ្វើឲ្យក្រុងនេះក្លាយជាបណ្តា សា ដល់អស់ទាំង សាសន៍នៅលើផែនដី »
នាងឆ្លើយ ថា៖ « អ្នកបានដោះលែងខ្ញុំហើយ » ។
លោក យ៉ូ អាប់ក៏វិលទៅគាល់ស្ដេចនៅក្រុងយេរូសាឡឹមវិញ ។
គណៈកម្មាធិការ សិទ្ធិ មនុស្ស ក្នុង សភា ក៏ កំពុង អនុវត្ត ដែរ ។
អ្នក ដែល ផ្តល់ ការធានា គឺ ល្អ បំផុត ។
' បុរស ទាំងនេះ មាន អំណាច បិទ មេឃ ដើម្បី កុំ ឱ្យ ភ្លៀង ធ្លាក់ ក្នុង កំឡុង ពេល ដែល ពួកគេ កំពុង ទាយ ហើយ ពួកគេ មាន អំណាច បំប្លែង ទឹក ឱ្យ ទៅជា ឈាម និង អាច វាយ ផែនដី ជាមួយនឹង បន្ទះ គ្រប់ ប្រភេទ តាម ដែល ពួកគេ ចង់បាន ។
ប៉ុន្តែតាមពិត វាជាជនជាតិអ៊ីតាលីរួចទៅហើយ ។
ម្យ៉ាងទៀត ក្រោយពេលលោករស់ឡើងវិញ លោកបានស៊ី និងផឹកជាមួយនឹងពួកគេ ដូចជាសាច់ឈាម ទោះជាលោកបានរួបរួមខាងវិញ្ញាណ ជាមួយនឹងព្រះបិតាក៏ដោយ » ។
ព្រះជាម្ចាស់នៅក្នុងការ ប្រោសប្រទាននូវព្រះគុណរបស់ព្រះអង្គ ឬការ ធ្វើឲ្យព្រះ ពិរោធរបស់ព្រះអង្គស្ថិតនៅ ជារៀងរហូត ។
ម្យ៉ាង វិញ ទៀត តើ នរណា ជា អ្នកបង្កើត ពួកគេ ពួកគេ ជា នរណា ពិតប្រាកដ ហើយ តើ មាន អ្វី កើតឡើង ចំពោះ ពួកគេ ( និង ពួកយើង ) នៅក្នុង ការស្រមើស្រមៃ បន្ទាប់ពី ការផុត ពូជ របស់ ពួកគេ ?
4:22 ហេតុនេះហើយបានជាវាត្រូវបានគេរាប់គាត់សម្រាប់សេចក្តី សុចរិត .
ហើយ នៅលើ ស្មា របស់ វីយូឡុង ។
ពួកគេបានរងនូវការរលាកបន្តិចបន្តួចនៅពេលពួកគេព្យាយាមពន្លត់ ភ្លើង ។
ទោះបីជា អ្នក មិន ព្យាយាម រក កាបូប ក៏ដោយ ។
ស្ថានភាព ដែល អ្នក ចង់ ធ្វើ ការផ្លាស់ប្តូរ
« គ្រប់គ្នាតែង តែនិយាយថា៖ ‹ ចូរស្ដាប់មនុស្ស › ។
« អ៊ីចឹងឯងគិតថាគាត់នឹងខឹង បើគាត់ដឹងថាយើងកំពុងធ្វើអី ? »
អ្នក នយោបាយល្បីម្នាក់បានប្រាប់ខ្ញុំថាមុននេះ ។
ហើយ គាត់ មិន បាន ទៅ កាលពី ថ្ងៃព្រហស្បតិ៍ ទេ ។
ហើយមួយចំនួនត្រូវបានធ្វើឱ្យប្រសើររួចហើយឬជាមួយនឹងរូបរាងថ្មី។
ទ្រង់អនុញ្ញាតឲ្យគេធ្វើ បាបអ្នកដែលគេស្អប់ ។
តើ អ្នក និង គ្រួសារ របស់ អ្នក មាន ការធានារ៉ាប់រង លើ ការទទួលខុសត្រូវ ត្រឹមត្រូវ ដែរ ឬ ទេ ?
ពីព្រោះមនុស្សទាំងអស់បានប្រព្រឹត្តអំពើ បាប ហើយធ្លាក់ចុះនូវសិរីល្អនៃព្រះ។
នេះ ត្រូវតែ ជា អ្វី ដែល ខ្ញុំ គិត ព្រោះ នេះ ជា ជីវិត មិត្ត របស់ ខ្ញុំ ។
រដ្ឋាភិបាលបានរងសម្ពាធក្នុងការ ដាក់ឈ្មោះអ្នកមាន ទោស ។
