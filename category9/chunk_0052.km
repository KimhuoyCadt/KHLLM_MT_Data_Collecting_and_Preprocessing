ព្រោះខ្ញុំមានអារម្មណ៍ថាមានសេរីភាព » ។
“ ផ្ទះនេះត្រូវបានសាងសង់ក្នុងរយៈពេលប្រហែល ៩០ ថ្ងៃ ។
ភារកិច្ច នៃ ផ្នែក ខាងមុខ នៃ ចិត្ត របស់ គាត់ បម្រើ ។
‹ មាន ពរហើយអ្នកដែលបង្កើតសន្តិភាព ដ្បិតគេនឹងបានហៅថាជាកូនរបស់ព្រះ› ។
យ៉ាង ណាក៏ដោយ ខ្ញុំកំពុងរង់ចាំការ ឆ្លើយ តបរបស់សមាជិកនៅពេលពួកគេនិយាយថាស្វាគមន៍ មក កាន់ខ្ញុំនៅទីនេះ ។
យើងមិនគ្រាន់តែបង្កើតរឿងនេះដើម្បីលក់ ស្រាទេ ។
ហេតុអ្វីបានជាខ្ញុំមិនតែងតែមានអារម្មណ៍ថាព្រះ បានឮការ យំរបស់ខ្ញុំ និងជួយ សង្គ្រោះខ្ញុំ ?
ដូច្នេះ គាត់បានក្លាយជាឪពុករបស់អ៊ីសាក ហើយបានកាត់ស្បែកគាត់នៅថ្ងៃទីប្រាំបី ហើយអ៊ីសាកជាមួយយ៉ាកុប និងយ៉ាកុបជាមួយនឹងបុព្វបុរសដប់ ពីរនាក់ ។
« អ្នក រាល់គ្នាបានសាបព្រោះនឹងខ្យល់ អ្នក រាល់គ្នានឹងច្រូតកាត់ខ្យល់កួច » ។
នាងគិតថាយើងនឹង រកមិនឃើញអត្តសញ្ញាណពិតរបស់នាង ?
ដើម្បីឱ្យថ្ងៃរបស់អ្នកត្រូវបានពិពណ៌នាជាមុនទៅតាមពេលដែលអ្នកកើតឬរាងកាយរបស់អ្នកដឹងថាពេលត្រូវស្លាប់ » ។
មិនមានការ លើកឡើងអំពី បន្ទុកអ្វីដែលវាត្រូវបានវាស់នោះទេ » ។
ពេលលោកម៉ូសេ ចុះពីភ្នំរបស់លោកមក លោកឃើញប្រជាជននៅថ្ងៃនេះកំពុងថ្វាយ បង្គំកូនគោមាស ។
ហើយ អនុវត្ត គំនិត របស់ អ្នក នៅក្នុង សរសៃ របស់ ពួកគេ ។
ថ្ងៃនោះមកដល់ហើយ ក្រុមព្រឹទ្ធាចារ្យនៃប្រជាជនបានមកជុំគ្នា
ពេលដែលគេ ប្រទះ ឃើញគេភ្លាម គេក៏ដឹងថាមានអ្វីកើតឡើង ។
ប្រសិនបើ អព្ភូតហេតុ បាន ធ្វើឡើង នៅ ទីក្រុង ទីរ៉ុស និង ក្រុង ស៊ីដូន ដែល បាន កើតឡើង នៅក្នុង អ្នក នោះ ពួកគេ នឹង ប្រែ ចិត្ត តាំងពី យូរយារ ណាស់ មកហើយ ដោយ អង្គុយ នៅក្នុង បាវ និង ផេះ ។
របៀប ដែល លោក ខាងលិច ត្រូវបាន ប្លន់
អ្នក និង វេជ្ជបណ្ឌិត អាច មើល និង និយាយ គ្នា នៅលើ កុំព្យូទ័រ ។
២៥ ស្ដេចហៅម៉ូសេ និងអើរ៉ុន ហើយមានរាជ ឱង្ការ ថា៖ « សូមថ្វាយ យញ្ញ បូជាដល់ព្រះ របស់អ្នកនៅស្រុកនេះ » ។
ដូច្នេះនេះជាដំណឹងល្អ មិនមែនចូលចិនឆ្នាំក្រោយទេ ។
គាំទ្រ ទស្សនៈ របស់ ខ្ញុំ ខ្ញុំ សូម និយាយ ។
ទាក់ទង មក ខ្ញុំ ។
នៅ ពេល ដែល មនុស្ស ស្លាប់ រស់ ឡើងវិញ៖ និទាន រឿង នៃ អ្នក ប្រែចិត្ត ពី មជ្ឈិម សម័យ រហូតដល់ បច្ចុប្បន្ន
Carol Tice អាចបង្កើតជំនួញបានច្រើនដោយការ ហៅទូរសព្ទត្រជាក់ 25 ដងក្នុងមួយថ្ងៃក្នុងមួយខែ ។
ការយាង មក របស់ គាត់ ត្រូវបាន ទាយ ម្តង ហើយ ម្តង ទៀត ដោយ ពួក ហោរា ក្នុង គម្ពីរ សញ្ញា ចាស់ ។ ហើយ ត្រូវបាន រំពឹង យ៉ាង មុតមាំ ដោយ មនុស្ស ដែល មាន ជំនឿ ។
វានឹងមានកំហុស ពួកគេនឹងត្រូវបានដកចេញ ។
ពោល ថា ម្នាល ភិក្ខុទាំងឡាយ បុគ្គលខ្វាក់ចំពោះ ចិត្ត ស្មើនឹងអ្នកដែលមានបញ្ញាយល់ឃើញឬទេ ?
« កុំឲ្យយើងស្រឡាញ់ដោយពាក្យ សម្ដីឡើយ តែដោយការ ប្រព្រឹត្ត និងសេចក្ដី ពិត » ។
ប្រសិនបើ កូន របស់ គាត់ ណា ម្នាក់ ស្លាប់ នោះ កេរ ដំណែល របស់ ពួកគេ ត្រូវបាន ចែករំលែក ក្នុង ចំណោម អ្នក នៅរស់ ។
និង មាត់ ដែល មិន ពាក់ព័ន្ធ នឹង ភាសា ។
ព្រះជា អ្នកបង្កើត អ្វី ៗ ទាំងអស់ ។
នាងបាន កាន់ សញ្ញាមួយដែលសរសេរថា « អភិវឌ្ឍមនសិការ ។
" ប្រជាជន ត្រូវតែ មានអារម្មណ៍ ថា នេះ គឺជា ប្រទេស របស់ ខ្ញុំ ។
លោកយេស៊ូមាន ប្រសាសន៍ថា៖ « គេគិតថាគេនឹងបាន ឮដោយ សារគេនិយាយច្រើន » ។
ខ្ញុំ នឹង រត់ ចូល ទៅក្នុង វាល ខ្សាច់ ។
គេមិនបានឮពីគាត់តាំងពីពេលនោះមក ។
យើងមិនដឹងថាមានអ្វីទៀតនៅខាងមុខក្នុងសតវត្សនេះ ។
ខ្ពស់អាចកាច់ កបានបើលោត ?
ប្រសិនបើ ពួកគេ បរាជ័យ ពួកគេ ត្រូវបាន លុប ( ការស្លាប់ ភ្លាម ៗ រំលង វួដមរណៈ ) ពី ការពិត ដូចជា ពួកគេ មិន ដែល មាន ។
បង្ហាញ អ្វី ដែល ខ្ញុំ ដឹង លើ ប្រធានបទ នេះ ។
យើង នឹង មាន គេហទំព័រ ផ្លូវការ ក្នុង ពេល ឆាប់ ៗ នេះ ។
ហើយក្រុមប្រឹក្សាជាអ្នក សម្រេច » ។
អេសាយមាន ប្រសាសន៍ទៅគេ ថា៖ « ចូរប្រាប់ម្ចាស់របស់អ្នកថា ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលដូច តទៅ : កុំខ្លាចអ្វីដែលអ្នកបាន ឮឡើយ - ពាក្យទាំងនោះដែលអ្នកក្រោមបង្គាប់របស់ស្ដេចស្រុកអាសស៊ើរបានប្រមាថខ្ញុំ ។
« យើងបានឃើញផ្កាយរបស់គាត់នៅទិសបូព៌ា ហើយបាន មកថ្វាយ បង្គំទ្រង់ » ។
កូនប្រុស បាន មក មុន អ្នក ។
គឺជា ការងារ ដ៏ អស្ចារ្យ នៅក្នុង ជីវិត របស់ ពួកគេ ។
អស់ ជាច្រើន ទសវត្សរ៍ មក ហើយ មនុស្ស គឺជា ស្នូល នៃ រាល់ ការផ្លាស់ប្តូរ ដែល យើង ធ្វើ ។
ប្រហែលជា វិញ្ញាណ ឬ ទេវតា បាន និយាយ ទៅកាន់ គាត់ ។
ប្រាប់ មនុស្ស ដែល អ្នក កំពុង ស្វែងរក បុគ្គលិក ។
ហើយអ្នកដែលចាត់ខ្ញុំឲ្យមកក៏នៅជាមួយខ្ញុំដែរ ។ គាត់មិនទុកខ្ញុំឲ្យនៅម្នាក់ឯងទេ ព្រោះខ្ញុំតែងតែធ្វើអ្វីដែលគាត់គាប់ ចិត្ត » ។
មាន សាខា តែ មួយ ទេ លោកគ្រូ
« ពាក្យទាំងនេះបានមាន ប្រសាសន៍ទៅលោកយេស៊ូ ហើយងើបព្រះនេត្រទៅលើមេឃ ហើយមាន ប្រសាសន៍ថា ឱ ព្រះវរ បិតា ដល់ពេលកំណត់ហើយ សូមលើក ត ម្កើងបុត្ររបស់លោក ដើម្បីឲ្យបុត្ររបស់លោកបានលើក ត ម្កើងលោក ដូចលោកបានប្រទានអំណាចដល់លោកលើគ្រប់ទាំងសាច់លោក ដើម្បីឲ្យលោកបានជីវិតអស់ កល្ប ជា និច្ច ។ តាម ដែល អ្នក បាន ផ្តល់ឱ្យ គាត់ ។
២. ខែ នេះជាខែដំបូងសម្រាប់អ្នក ជាខែដំបូងនៃឆ្នាំរបស់អ្នក ។
តម្លៃ លំនាំ ដើម ដែល ត្រូវបាន បង្ហាញ នៅ ក្បាល ខាងស្តាំ បំផុត ។
មុខវិជ្ជា ទាំងអស់ ត្រូវបាន បង្រៀន ជា ភាសា ចិន ។
ទាំង នេះ នឹង ត្រូវ ផ្ទេរ ទៅ អាវុធ ថ្មី ។
ប៉ុន្តែ គាត់ មិន បាន ស្រឡាញ់ អ្នក គ្រប់គ្រាន់ ទេ ។
« បញ្ជូននាងទៅឆ្ងាយទៅ ព្រោះនាងនៅ តែស្រែកតាមយើង » ។
២១ កូនចៅអ៊ីស្រាអែលបានធ្វើដូច្នេះ ។ លោក យ៉ូសែបក៏ប្រគល់ រទេះឲ្យពួកគេ តាម បញ្ជារបស់ព្រះចៅផារ៉ោន ហើយក៏ប្រទានស្បៀងអាហារសម្រាប់ធ្វើដំណើរ ។
