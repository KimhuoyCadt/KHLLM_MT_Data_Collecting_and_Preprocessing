36 ដូច្នេះ ប្រសិនបើ ព្រះបុត្រា នឹង ដោះលែង អ្នក នោះ អ្នក ប្រាកដជា មាន សេរីភាព ។
បង្ហាញ គាត់ ថា ប្រសិនបើ គាត់ ជា និង សេចក្តីស្រឡាញ់ របស់ ខ្ញុំ ។
ជន ជាតិយូដា តបទៅគាត់ ថា៖ « តើអ្នកអាចបង្ហាញទីសំគាល់អ្វីដល់យើង ដើម្បីឲ្យអ្នកធ្វើការ ទាំងនេះ ? » ។
ហើយ រុញ ចុង និទាឃ រដូវ ចូល ទៅក្នុង រន្ធ
នៅក្នុង ល្បឿន នៃ ពពក ដែល រសាត់ ។
ហើយនេះគាត់និយាយថាជា សញ្ញាមួយនិងភស្តុតាងនៃការ មិនជឿរបស់ពួកគេ។
ខ្ញុំ ដឹង ថា ប្រណីត ខ្ញុំ កំពុង ប្រាប់ អ្នក ។
ប្រសិនបើពួកគេចង់បង្កើតវាទៅជានគររបស់ព្រះ ពួកគេនឹងត្រូវស្តាប់បង្គាប់ព្រះ។
ប្រសិនបើអ្នកជ្រើស រើសស្នាក់នៅ ទីនេះ អ្នកនឹងក្លាយជាកម្មសិទ្ធិរបស់យើងផងដែរ » ។
ឃាតកម្ម អំពើ ផិត ក្បត់ ចោរកម្ម សាក្សី ក្លែងក្លាយ ការលោភលន់ គឺ ខុស - តែងតែ ខុស - ខុស គ្រប់ ទីកន្លែង ។
ឱ លោកម្ចាស់អើយ សូមថែរក្សាដាវីឌ ។
ធ្វើ តាម អ្នក ព្រោះ គ្មាន ការផាត់ មុខ ។
សូមស្វែង យល់ពីខ្លួនឯងនៅចំពោះមុខវា ដើម្បីឲ្យខ្ញុំអាចឲ្យអ្នកដឹងការ ពិត ។ ខ្ញុំ មិន ដែល ធ្វើ ខុស ចំពោះ អ្នកទេ ។
« តើអ្នកនោះត្រូវគេកាត់ក្បាល ឬត្រូវគេដាក់គុក ?
ឈប់ ព្យាយាម ចាប់អារម្មណ៍ !
អ្នក គឺជា អ្នកគាំទ្រ ដែល តែងតែ មើល ទៅ មុខ ។
ជន ជាតិអេស៊ីបដែលអ្នក ឃើញថ្ងៃនេះ អ្នកនឹងមិនឃើញទៀតទេ ។
... ព្រោះទង្វើរបស់គាត់អាក្រក់ ហើយប្អូនប្រុសគាត់ក៏សុចរិត ។
ប៉ុន្តែការ ផ្លាស់ ទៅស៊ីរីមិនបានសម្រេចដូចឪពុករបស់នាងបាន សង្ឃឹមទេ ។
វា នឹង មិន អនុញ្ញាតឱ្យ ខ្ញុំ ទោះបីជា ខ្ញុំ ជា អ្នកគ្រប់គ្រង ក៏ដោយ ។
ការថ្កោលទោស ខ្លួន ឯង ទាំងអស់ នៅក្នុង ពិភពលោក នឹង ធ្វើឱ្យ អ្នក មិន ល្អ ។
ហើយ មាតិកា របស់ អ្នក នឹង ត្រូវបាន បង្ហាញ ។
ភាសា អង់គ្លេស ទៅជា ភាសា កូរ៉េ ។
អាថ៌ កំបាំងត្រូវបានដោះស្រាយមិនមែនជារឿងអីទេ !
ថ្ងៃ នេះ យើង នឹង ឆ្លុះបញ្ចាំង ពី ឆ្នាំ មុន ។
ប៉ុន្តែសម្រាប់ខ្ញុំ វាមានសារៈសំខាន់តិចតួចណាស់ដែលខ្ញុំត្រូវបានអ្នកឬអ្នក ណាម្នាក់វិនិច្ឆ័យដោយ សារ តែខ្ញុំមិនវិនិច្ឆ័យខ្លួន ឯង ។
ក្នុង ករណី ដែល អ្នក ពូកែ ។
១៣ នៅ ទីនេះ ពួកគេ នាំសាក្សីក្លែងក្លាយ ដែលប្រកាស ថា៖ « អ្នកនេះនិយាយទាស់នឹងទី សក្ការៈ និងក្រឹត្យ វិន័យឥតឈប់ឈរ ។
“ ឪពុកខ្ញុំត្រូវបានគេហៅឲ្យចូលធ្វើ ការ ។
គុណធម៌ ក៏ ដូចជា ការបង្រៀន របស់ គាត់ ។
ខ្ញុំ ពិតជា បាន ឆ្លងកាត់ ដំណាក់កាល ទាំងនេះ ។
ព្រះអង្គបានសំដែងធម្មទេសនាចំនួន ៤ ប្រការដែលព្រះអង្គបដិសេធនូវនិមិត្តដ៏ប្រពៃ ។
តាំងពីថ្ងៃដែលបុព្វបុរសរបស់អ្នក រាល់គ្នាចេញពីស្រុកអេស៊ីបមកដល់សព្វថ្ងៃនេះ យើងបានបញ្ជូនព្យាការីទាំងអស់ជាអ្នក បម្រើរបស់យើងមក រកអ្នក រាល់ គ្នា ដោយចាត់គេ ជារៀងរាល់ថ្ងៃ ព្រលឹម និងយឺត ។
លោក សន្យាថានឹងណែនាំជំហានរបស់មនុស្សសុចរិត ។
តើ អ្នក ចូលចិត្ត អ្វី៖
ស្តេចមានព្រះ‌បន្ទូលដូច្នេះថា កុំឲ្យហេសេគាបញ្ឆោតឯងឡើយ ដ្បិតទ្រង់នឹងមិនអាចរំដោះឯងចេញពីកណ្ដាប់ដៃអញបានឡើយ ។
វា មាន អ្វី គ្រប់ យ៉ាង ដែល ទាក់ទង នឹង ការក្លាយជា មនុស្ស ហើយ នេះ គឺជា រដូវ ស្លឹកឈើ ជ្រុះ ។
មិនដឹងថាគាត់មានជំនឿលើបាតុករ ណាទេ ។
ការតម មិន មែន សម្រាប់ ជា ប្រយោជន៍ របស់ ព្រះទេ ប៉ុន្តែ សម្រាប់ យើង ។
ប្រាប់ មកព្រោះចង់ចេះចង់ដឹង !
បើគេសួរខ្ញុំថា គាត់ឈ្មោះអ្វី តើខ្ញុំត្រូវប្រាប់គេថាម៉េច ?
មួយ សប្តាហ៍ បន្ទាប់ពី ខ្ញុំ ជាប់ ឆ្នោត ” ។
ឥឡូវនេះ អ្នក សម នឹង ទទួលបាន ឱកាស ដើម្បី បង្ហាញ គាត់ ថា អ្នក បាន ព្យាយាម ។
ដូច្នេះដើម្បីបង្ក ភាព ងាយស្រួលសម្រាប់ខ្លួនគេ គេចូល ចិត្តទៅជិតបុរសពីក្រោយ ។
ឥឡូវនេះ មនុស្សម្នា មិនស្គាល់ខ្ញុំទេ ខ្ញុំស្រកទម្ងន់ច្រើនណាស់ » - C. L .
2 ទៀតខ្ញុំ សង្ឃឹមខ្លះ ។
បី ធំ ៗ សម្រាប់ ខ្ញុំ គឺ អ្នក ត្រូវតែ មាន ទេពកោសល្យ ដែល មិន អាច ប្រកែក បាន ។
ពួកវា មាន គ្រប់ រាង និង គ្រប់ ទំហំ ដែល ធ្វើឲ្យ ពួកគេ ក្លាយជា ជម្រើស ឈ្នះ ៗ សម្រាប់ សួនច្បារ ។
ក្នុង ចំណោម អ្នក ដែល បាន ផុស ឡើង គឺ៖
ប្រសិនបើ អ្នក ធ្វើ អ្នក នឹង បាត់បង់ អ្វី ៗ ទាំងអស់ ។
វាជាការ ធ្វើ តេស្ដងាយស្រួលគ្រប់គ្រាន់សម្រាប់អ្នក ដើម្បីសាកល្បងខ្លួនឯង Tilly ។
បើ មិន ដូច្នោះ ទេ ពួកគេ នឹង បាត់បង់ ការគាំទ្រ ទាំងអស់ ។
ដូច្នេះ វា ត្រូវតែ ចាប់ផ្តើម ជាមួយនឹង អ្វី ដែល អ្នក អាច ផ្លាស់ប្តូរ បាន ។
មាន របស់ ទាំងអស់ ដែល អ្នក បាន រាយ បញ្ជី ។
សូមពិចារណាអំពី ការ អស្ចារ្យដែលទ្រង់បានធ្វើសម្រាប់អ្នក ។
តើមានបុរស ឬស្ត្រីរស់ នៅដែលអាចធ្វើដូច្នេះបានទេ ?
ដូច ប្រទេស អៀរឡង់ ក្នុង រដូវ ក្តៅ ក្នុង រដូវ រងា ។
តើប្លង់មេ និយាយយ៉ាង ណាអំពីអ្នកដែលមិនធ្លាប់មានពិធីស្តាប់ដំណឹងល្អនៃព្រះយេស៊ូវ គ្រីស្ទពេលនៅលើផែនដី ?
ដូច្នេះ គេបានអនុញ្ញាតឲ្យប្រជាជននៃពិភពទីបួនចូលទៅក្នុងពិភព ទីប្រាំ ។
ពី ការសាកល្បង ផងដែរ ។
ឱ ព្រះជា ម្ចាស់ អើយ សូម ប្រទាន កម្លាំង មក យើង ឥឡូវនេះ ។
ចូរគោរពដល់ឪពុកម្ដាយរបស់ពួកគេ » ( អេភេសូរ ៦:២) ។
គណបក្ស បៃតង និង គណបក្ស សម្ព័ន្ធ មាន តែ មួយ ។
« ហើយពួកគេនឹងលែងធ្វើជាឈ្លើយរបស់ប្រជាជាតិនានា ហើយក៏មិនត្រូវសត្វស្រុកលេបត្របាក់ពួកគេទៀតដែរ ប៉ុន្តែពួកគេនឹងរស់ នៅដោយសុវត្ថិភាព ហើយគ្មានអ្នក ណានឹងធ្វើឲ្យ ភ័យខ្លាចឡើយ ។
១២ ឥឡូវនេះ កូនចៅរបស់លោកអេលីបានប្រព្រឹត្តអំពើពុក រលួយ ។ ពួកគេ មិន ស្គាល់ ព្រះអម្ចាស់ ទេ ។
១៤ មាត់របស់គេពោរពេញទៅដោយពាក្យជេរប្រមាថ និងជូរ ចត់ ។
នាងថានឹងប្តឹងទាស់នឹងបញ្ហានេះ ហើយមេធាវីរបស់នាងនឹងចាត់វិធានការ ។
នេះ ជាលើកទី ២ ហើយដែលប្រទេសអារ៉ាប៊ី សាអូឌីតឈ្នះពាន រង្វាន់នេះចាប់តាំងពីឆ្នាំ២០១៧ មក ។
ពត៌មាន ដែល មាន ប្រយោជន៍
ខ្ញុំ កំពុង ស្វែងរក អ្វី ដែល ខ្ញុំ ចូលចិត្ត ។
