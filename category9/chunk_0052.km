ដែលគេថ្វាយជា យញ្ញ បូជាដល់រូបព្រះ។
ដូច្នេះប្រសិនបើមានអ្វីខាងលើបានចុះឈ្មោះជាមួយអ្នក នោះអ្នកនៅកន្លែងត្រូវហើយ …
មាន ការឆ្លើយតប ជាច្រើន ចំពោះ ការបណ្តុះបណ្តាល របស់ ខ្ញុំ ។
តើ វា អាច ថា វិញ្ញាបនបត្រ របស់ អ្នក បាន ផុត កំណត់ ហើយ មិន ត្រូវបាន បន្ត ឱ្យ បាន ត្រឹមត្រូវ ទេ ?
ទោះជា យ៉ាងណា ក៏ដោយ អ្នក ក៏ ត្រូវ ចាំ ថា អ្នក ក៏ នឹង ទទួលបាន អត្ថប្រយោជន៍ មាន កំណត់ ផងដែរ ។
ហើយអ្នក ណាដែលប្រកាសពីអ្វីដែល ជារបស់ខ្លួនគឺត្រូវជឿ ។
តើវាជាអ្វីដែលបានគិតពីមុន ?
ដូច្នេះ ម្ដាយខ្ញុំប្រាប់ខ្ញុំមិនឈប់ ។
៩ ដូច្នេះ តើអ្នកបានចេញមកមើលអ្វី ?
អាច ជា ក្មេងប្រុស ឬ ក្មេងស្រី ។
ជា ការប្រសើរ ណាស់ ដែល ពួកគេ បាន ធ្វើឱ្យ ពួកគេ រង់ចាំ អស់ រយៈពេល 4 ឆ្នាំ ។
" យើងលេងឱ្យអស់ពីសមត្ថភាពនៅថ្ងៃទីពីរ " ។
៧ ហេតុនេះហើយបានជាខ្ញុំបង្គាប់អ្នកឲ្យញែកក្រុងចំនួនបី ។
គាត់និយាយថា គាត់មិនបានធ្វើអ្វីខុសទេ ។
ខ្ញុំ បាន សន្មត់ ថា ខ្ញុំ នឹង ស្លាប់ ។
ប្រសិនបើអ្វីដែលអ្នកបានឮនៅពេលចាប់ផ្ដើមស្ថិតនៅក្នុងអ្នក នោះអ្នកក៏នឹងស្ថិតនៅក្នុងព្រះបុត្រា និងក្នុងព្រះវរ បិតាដែរ » ( ១យ៉ូហាន ២: ២៤) ។
• ការស្រាវជ្រាវ ត្រូវបាន បញ្ចប់ ។
សង្ឃឹម ថា ពួកគេ នឹង ជួយ មនុស្ស ។
កូនចៅអ៊ីស្រា ‌ អែលឃើញខ្លួននៅមាត់សមុទ្រនៅមុខគេ ហើយផារ៉ោននៅពីក្រោយគេ ។
ខ្ញុំ ដឹង ថា ខ្ញុំ បាន ប្រាប់ អ្នក អំពី ។
«ឯងគិតថាវាជាការវៃឆ្លាតដែលវាយខ្ញុំ?
២៥ ឥឡូវនេះ អ្នកក្រុងយេរូសាឡិមខ្លះនិយាយថា៖ « តើអ្នកនេះមិនមែនជាអ្នកដែលគេចង់សម្លាប់ឬ ?
ខ្ញុំ ក្រោក ឡើង ដើរ ជុំវិញ ផ្ទះល្វែង ប៉ុន្តែ ខ្ញុំ មិន ឃើញ នាង ទៅ ណា ទេ ។
នាងនិយាយថា “ តើអ្នក ជឿលើអ្វី ?
ជនជាតិ អេស៊ីប បាន ធ្វើបាប ឪពុក និង យើង ។
ដោយ សារប្តីជាសេនាធិការគួរ តែប្រព្រឹត្តមុននេះ ។
ឃាតករបានត្រឡប់មកវិញ ហើយយើងជាប់នៅក្នុងផ្ទះរបស់គាត់ ។
២៥ ហាការ តំណាងភ្នំ ស៊ីណៃក្នុងប្រទេសអារ៉ាប់ ហើយត្រូវនឹងក្រុងយេរូសាឡិមបច្ចុប្បន្ន ព្រោះនាងស្ថិតក្នុងទាសភាពជាមួយនឹងកូន ។
វា ជា កាតព្វកិច្ច សម្រាប់ សិស្ស គ្រប់ រូប ក្នុង ការជូនដំណឹង ដល់ យើង អំពី ព័ត៌មាន លម្អិត អំពី ជើងហោះហើរ របស់ គាត់ ព្រោះ ប្រសិនបើ អ្នកតំណាង របស់ យើង នឹង មិន នៅ អាកាសយានដ្ឋាន ដើម្បី ទទួល សិស្ស ទេ សិស្ស នឹង ត្រូវ និរទេស ត្រឡប់ ទៅ ស្រុក កំណើត វិញ ។
នាំ ខ្ញុំ ទៅ តាម ផ្លូវ នៃ ជីវិត អស់ កល្ប ជានិច្ច ។
ប៉ុន្តែ ជន ជាតិយូដាឆ្លើយ តប ថា៖ « តើអ្នក បង្ហាញ សញ្ញាអ្វីដល់យើងខ្ញុំថា អ្នកកំពុងធ្វើការ ទាំងនេះ ? » ។
នឹងពិចារណារបស់ពួកគេ » ។
« ឯងគិតថាខ្ញុំ សប្បាយ ចិត្តជាខ្លាំងក្នុងការ សម្លាប់មនុស្សរបស់ខ្ញុំ ?
ទោះ ជាអ្នកបានចាប់ផ្ដើមដោយព្រះវិញ្ញាណក៏ដោយ តើឥឡូវនេះអ្នកកំពុងព្យាយាម បញ្ចប់ដោយការ ខិតខំរបស់មនុស្សឬ ? » ។
បិទ ភ្នែក របស់ ពួកគេ ចំពោះ អំពើ បាប របស់ អ្នកដទៃ ប៉ុន្តែ មួយ ។
ពួកគេនឹងដោះស្រាយដោយខ្លួន ឯង » ។
មិនថាអ្នក ជាបុរសឬស្ត្រីទេ កុំធ្វើ បាបអី ។
ពួកគេ ត្រូវ យកចិត្តទុកដាក់ លើ អ្វី ដែល ពួកគេ សរសេរ ។
នៅ ពេល នេះ ការបង្ហូរ ឈាម ត្រូវតែ បញ្ឈប់ ។
នៅក្នុង ពែង មាស ។
ទន្ទឹមនឹង នេះ ខាងក្រោម នេះ គឺជា ព័ត៌មាន ដែល បាន រៀបរាប់ ខាងលើ ។
អ្នក រួចផុតពីអ្នកដែលបានធ្វើជាខ្ញុំបម្រើ ។
តើអ្នកអាចរស់ នៅតាមដំណឹង ល្អក្នុងជីវិតប្រចាំ ថ្ងៃរបស់អ្នកដោយរបៀប ណា ?
ទាំងអស់ នេះ បាន កើតឡើង ដោយសារតែ មិត្ត រួម ការងារ របស់ គាត់ ។
ជា លទ្ធផល នៃ ការរំដោះ ដ៏ មាន អំណាច ដ៏ អស្ចារ្យ របស់ ព្រះ កូន ចៅ អ៊ីស្រាអែល ត្រូវបាន រំដោះ ចេញ ពី ទាសភាព របស់ ស្តេច ផារ៉ោន ហើយ បន្ទាប់មក មាន សេរីភាព ក្នុង ការថ្វាយបង្គំ ទ្រង់ ក្នុង នាម ជា ទាសករ នៃ សេចក្តីសុចរិត ។
ការគ្រប់គ្រង ចំណេះដឹង មិន ស្លាប់ ទេ ។
38 ប៉ុន្តែ ស្រាទំពាំងបាយជូរថ្មីត្រូវដាក់ចូលក្នុងស្បែកថ្មី ហើយទាំងពីរត្រូវរក្សាទុក ។
ព្រះ ធ្វើឲ្យអ្វី ៗទាំងអស់រួមគ្នាដើម្បី ភាពល្អ ដល់អ្នកដែលស្រឡាញ់ទ្រង់ ហើយត្រូវបានហៅតាមគោលបំណងរបស់ទ្រង់ ។
ខ្ញុំ បាន បាត់បង់ ការសរសើរ ទាំងអស់ របស់ បុរស ។
គាត់សរសេរថាគាត់និងគ្រួសារមិនអីទេ ។
33 លោកមាន ប្រសាសន៍ដូច្នេះ ដើម្បីបញ្ជាក់ថាលោកជិតស្លាប់បែបណា ។
36 ប៉ុន្តែ ព្រះ‌ យេស៊ូមិនបានយក ចិត្តទុកដាក់នឹងពាក្យដែលគេនិយាយទេ តែមានព្រះ‌បន្ទូលទៅមេ សាលា ប្រជុំថា៖
គាត់ ស្លូត ដូច ខ្ញុំ អញ្ចឹង ។
បន្ទាប់មកទុកវាឱ្យជ្រមុជក្នុងទឹក ដើម្បីកុំ ឱ្យងងឹត។
តន្ត្រី និង ចូលចិត្ត មាន មិត្តភក្តិ ច្រើន ។
« ដូច្នេះ វេទនា ដល់អ្នកអធិស្ឋាន ដែលមិនបាននឹកដល់ការ អធិស្ឋានរបស់ខ្លួន » ។
យើង កំពុង និយាយ អំពី បឹង ។
« ខ្ញុំបានដាក់ទ្វារចំហ នៅចំពោះមុខអ្នក ហើយគ្មានអ្នក ណាអាចបិទទ្វារបានឡើយ ដ្បិតអ្នកមាន កម្លាំងបន្តិច បន្តួច » ( វិវរណៈ ៣:៨) ។
នេះជាការ បង្កើត សាសន៍យូដា ( អ្វីដែលហៅថាអ៊ីស្រាអែលសព្វថ្ងៃ ) ។
បើគ្មានការ ច្បាំងទេ តើជនជាតិអ៊ីស្រាអែល មកពីណា ?
ប៉ុន្តែ គាត់ មាន ការខកចិត្ត ដោយសារ ល្បឿន នៃ ការផ្លាស់ប្តូរ យឺត ។
វា ត្រូវបាន តែងតាំង ឱ្យ បុរស ម្នាក់ ស្លាប់ ម្តង ហើយ បន្ទាប់មក ការវិនិច្ឆ័យ ។
នាង បាន ប្រាប់ ឪពុក ម្តាយ របស់ នាង អំពី សុបិន របស់ នាង ។
ដូច្នេះបុរសនោះបាន ប្រែក្លាយទៅជាទូ របស់ដេម។
ការ ព្រមានកន្លង មកហើយឥឡូវអ្នកស្លាប់ !
