ថ្លើម របស់ អ្នក មាន ភាពធន់ ខ្លាំង ដូច្នេះ ប្រសិនបើ អ្នកដក ផ្នែក ណាមួយ ចេញ ( សូម្បីតែ មួយ ភាគ បី ឬ ពីរ ភាគ បី ) ផ្នែក ដែល នៅសល់ នឹង ដុះ ចេញមក ជំនួស ដុំ ដែល បាត់ ក្នុង រយៈពេល ពី ប្រាំមួយ ទៅ ប្រាំបី សប្តាហ៍ ។
ដរាបណា មាន អំពើ បាប និង កំហុស
តន្ត្រី និងការ សម្ដែងមើលថែខ្លួន ឯង ។
គាត់ បាន ឃើញ ដួងចិត្ត របស់ ពួកគេ ។
ខ្ញុំមានអារម្មណ៍ថាខ្ញុំកុហកខ្លួនឯងដោយការ បង្កើតវេទិកានេះ។
នៅ ទីនេះ អ្នក អាច ពន្យល់ ពី អត្ថប្រយោជន៍ នៃ ការចុះឈ្មោះ ជាមួយ អ្នក !
ខ្ញុំ ជឿ លើ ការភ័យខ្លាច របស់ បុរស ដែល នឹង បង្កើត ការរកឃើញ នេះ ។
ប៉ូលិសបាននិយាយថា អ្នក វាយ ប្រហារបានស្លាប់ ។
១៤ លោកកៃ ផា ជាអ្នកដែលបានទូន្មានជន ជាតិយូដាថា មានប្រយោជន៍ណាស់ដែលមនុស្សម្នាក់ត្រូវស្លាប់ដើម្បីប្រជាជន ។
តើ គាត់ មាន ការគោរព ចំពោះ អារម្មណ៍ ទន់ភ្លន់ របស់ ស្ត្រី ទេ ?
ដូច្នេះ ខ្ញុំ គិត ថា អ្វី ៗ មិន ដូចគ្នា ទេ នៅ អាហ្វហ្គានីស្ថាន ។
កម្មវិធី និង សេវាកម្ម ទាំង នេះ អាច រួមបញ្ចូលៈ
នាងបាននិយាយថា៖ « ខ្ញុំគិតថាពួកគេមានអារម្មណ៍ថាមានសម្ពាធបន្តិច។
ផ្តល់ អ្វី មួយ ដល់ ពិភពលោក នេះ កុំ បរិភោគ អ្វី ទាំងអស់ ។
សុខភាព របស់ យើង នា ពេល ខាងមុខ ត្រូវបាន កំណត់ ដោយ អ្វី ដែល យើង ធ្វើ នៅ ថ្ងៃ នេះ ។
ពួកគេមិនមានទឹកប្រើប្រាស់ ឬកម្តៅក្នុងផ្ទះទេ ប៉ុន្តែពួកគេនៅតែមើល ថែគ្រួសារ និងចៅ ៗ។
លោកបានថ្លែងបែបនេះក្នុងអំឡុងសន្និសីទធំមួយនៅប្រទេសជប៉ុន ។
ខ្ញុំបានរាប់ថ្ងៃរហូតដល់បើកប្រាក់ខែ ។
ឪពុក ម្តាយ របស់ ខ្ញុំ ធ្វើការ ជាមួយគ្នា ហើយ ខ្ញុំ រស់នៅ កណ្តាល នោះ ។
ទាំង នេះ គឺ សមរម្យ ដើម្បី ប្រើ ដើម្បី បង្ហាញ ពី សារៈសំខាន់ នៃ អ្វី មួយ ។
យើងដឹងថានេះមិនពិតទេ » ។
អ្វី ដែល ត្រូវ មើល និង ធ្វើ៖
ម្យ៉ាងទៀតខ្ញុំសូមជម្រាបថា ការ ស្លាប់របស់ពួកគេពិតជា អស្ចារ្យមែន !
ដំណើរនោះត្រូវបានចង ក្រងទុកយ៉ាងល្អនៅក្នុងសិល្បៈនៃព្រះ នៃសង្គ្រាម ។
បុរសដែលនិយាយថា “ ខ្ញុំស្គាល់គាត់ ” ប៉ុន្តែមិនធ្វើតាមបង្គាប់នោះគឺ ជាអ្នកកុហក ហើយការ ពិតក៏មិននៅក្នុងខ្លួនដែរ ។
នៅក្នុង ទីតាំង ដដែល ខ្ញុំ បាន ឃើញ ការស្លាប់ ។
« ប៉ុន្តែពួកគេមិនមានតម្លៃសម្រាប់យើងទេគឺជាអ្វីគ្រប់យ៉ាងសម្រាប់យើង » ។
21 កុំ ដើរ តាម ព្រះក្លែងក្លាយ ពួកគេមិនអាចជួយអ្នក ឬជួយអ្នកបានឡើយ ព្រោះវាមិនមែនជាការពិតទេ ។
ប្រព្រឹត្ត ដោយ ចេតនា ដើម្បី ទទួលបាន ការយល់ព្រម
គាត់ បាន ថើប ពួកគេ ដោយ ភាពស្រើប ស្រាល ។
ខ្ញុំ គិត ថា ខ្ញុំ ក៏ អាច ទាញយក ប្រយោជន៍ ពី ការពិត ដែល ថា ខ្ញុំ នៅ អឺរ៉ុប ។
ការ មិន រក្សា ភ្នាក់ងារ ចុះបញ្ជី មាន ផលវិបាក ធំ ។
សំខាន់ មួយ ទៀត ដែល យើង ត្រូវ ជៀសវាង គឺ ការផឹក ស្រា ។
រដ្ឋាភិបាលគួរពិនិត្យមើលបញ្ហានេះម្ដងទៀត ។
ទោះបីជា គាត់ ស្លាប់ ប្រាំ ថ្ងៃ ក្រោយមក ក៏ដោយ ។
ជាច្រើន ឆ្នាំ ចាប់តាំងពី ព្រះមហាក្សត្រិយានី បាន ឮ ដូច្នេះ
ឥឡូវនេះ កសិដ្ឋានរបស់ខ្ញុំមានលក្ខណៈដូចក្មេងជំទង់ ។
ពួកគេ សន្យាថានឹងធ្វើឱ្យបានត្រឹមត្រូវ ហើយបន្ទាប់មកមិនដែលបង្ហាញខ្លួនតាមពេលកំណត់ ហើយក៏មិនដែលទូរស័ព្ទមកដែរ ។
អ្នក មិន កុហក ដើម្បី វាយ
ស្ងប់ស្ងាត់ទៅចុះ ។
ដោយ បាន ចំណាយ ពេលវេលា ដ៏ យូរ របស់ ខ្ញុំ ។
ថ្ងៃ មួយ ខ្ញុំ ចេញពី ទីក្រុង ទៅ ធ្វើការ ។
“ បើមានអ្នក ណាម្នាក់សុំឲ្យខ្ញុំបង្ហាញខ្លួនខ្លះ
១៥ ហើយយើងនឹងធ្វើឲ្យមានសេចក្ដី ខ្មាំង ស ត្រូវរវាងអ្នកនិងស្ត្រី និងរវាងពូជពង្សរបស់អ្នក និងនាង ។ គាត់នឹងវាយក្បាលអ្នក ហើយអ្នកនឹងវាយកែង ជើងគាត់ »
ដោយសារ ស្នេហា ពិត នោះ ។
ទន្ទឹងរង់ចាំ ការបញ្ជាទិញ ជាច្រើន ទៀត ។
ខ្លួនឯងសូម្បីតែដល់ចំណុចនៃការ ទទួលបានជីវិត ។
ដោយសារ យើង ទាំងអស់ គ្នា ជា ព្រះ។
រូបភាព នៅក្នុង បន្តិច ។
បាន ចរចាជាមួយការទូត » ។
" អ្នកធ្លាប់កត់សម្គាល់ថាសំណួរខ្លះមិនសមនឹងឆ្លើយទេ ? "
មតិ សាធារណៈ នឹង ត្រូវបាន ពិចារណា ។
សម្រាប់ការ ប្រកួតដំបូងរបស់ខ្ញុំ នោះគឺជាការ ឈ្នះដ៏ធំមួយសម្រាប់ខ្ញុំ ។
គាត់ ជា មនុស្ស ដូច អ្នក និង ខ្ញុំ ។
ការបំភ្លឺ ជីវិត របស់ ព្រះពុទ្ធ៖ អាន
ដោយខ្មាស់អៀនពីរឿងនោះ គាត់បាន នាំខ្លួនគាត់ទៅរកការពិត ។
ខទី ៨ បុរសដែលដើរផ្លូវគឺជាមនុស្សប្រុសស្រីទាំងនោះដែលដើរលើវិថីជីវិត ( ក្នុង ភាពបរិសុទ្ធ ) ។
“ វា មាន អារម្មណ៍ ល្អ ណាស់ ក្នុង ការស៊ុត បញ្ចូល ទី នៅ ទីនេះ នៅក្នុង ផ្ទះ ថ្មី របស់ ខ្ញុំ នៅ ចំពោះមុខ អ្នកគាំទ្រ របស់ យើង ។
ក្នុង នាម ហូលីវូដ៖
ក្មេងស្រី តូច ទាំង បី មាន មន្តស្នេហ៍ ។
ខ្ញុំតែងតែលង់ស្នេហ៍នឹងនារីអ្នកផ្សេង៖ បទភ្លេងដោយ Geo .
យើង ភ្ជាប់ សារៈសំខាន់ យ៉ាង ខ្លាំង ទៅនឹង ដំណាក់កាល មុន ផលិតកម្ម ។
ស្ថានភាព នៅលើ វិគី ភីឌា ។
៥ អ្នក ណាដែលមានជ័យ ជម្នះនឹងត្រូវស្លៀកសម្លៀក បំពាក់ពណ៌ ស ហើយខ្ញុំនឹងលុបឈ្មោះអ្នកនោះចេញពីសៀវភៅជីវិតដោយគ្មាន ន័យអ្វីឡើយ ។ ប៉ុន្តែ ខ្ញុំនឹងសារភាពព្រះនាមរបស់ព្រះអង្គនៅចំពោះព្រះភក្ត្របិតារបស់ខ្ញុំ និងចំពោះមុខទេវតារបស់ព្រះអង្គ ។
រក្សា គំនិត របស់ អ្នក ជានិច្ច លើ មនុស្ស និង អ្វី ដែល ធ្វើឱ្យ អ្នកសប្បាយ ចិត្ត បំផុស គំនិត និង ផ្តល់ កម្លាំងចិត្ត ។
សូមព្រះអម្ចាស់គង់ជាមួយនឹងអ្នក ដូចព្រះអង្គបានគង់នៅ ជាមួយនឹងបិតារបស់ខ្ញុំដែរ ។
កាលព្រះយេស៊ូយាងចេញពីទីនោះ មានមនុស្សខ្វាក់ពីរនាក់ដើរតាមព្រះអង្គ ទាំងស្រែក ថា៖ « ព្រះអង្គជាបុត្ររបស់ព្រះបាទដាវីឌ អើយ សូមអាណិតមេត្តាយើងខ្ញុំផង ។
បច្ចុប្បន្ន ម្ចាស់ បំណុល ជាង 75% បាន ទទួលយក លក្ខខណ្ឌ ដែល បាន ស្នើ ឡើង និង បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ពាក់ព័ន្ធ ។
សង្ឃឹមថានឹង រកឃើញអ្នកដែលគួរឲ្យទុក ចិត្ត ។
ខ្ញុំ បាន ក្រឡេក មើល ទៅ ប៉ូល ។
វា ល្អ មុន ដំណាក់កាល ជ្រើសរើស បុគ្គលិក ។
អ្នក នឹង យក ពួកគេ សម្រាប់ ជីវិត ។
ពួកគេ កំពុង ព្យាយាម សង្កត់ធ្ងន់ លើ គ្រាប់ ធញ្ញជាតិ
« ហើយខ្ញុំ ប្រសិនបើខ្ញុំត្រូវបានលើកឡើងពីផែនដី នោះនឹងទាញមនុស្សទាំងអស់មករកខ្ញុំ » ។
ប៉ុន្តែខ្ញុំគិតថា ព្រះអម្ចាស់បានរំឭកខ្ញុំ ។
កុំ ធ្វើជា មនុស្ស អាក្រក់ ដូចគ្នា ដោយ នៅ ស្ងៀម !
ខ្ញុំនៅតែស្តាប់ កិច្ច ប្រជុំដែលនៅ សល់ ហើយ កាន់តែភ័យខ្លាច ។
ឬ អ្នក អាច ស្វែងរក វា នៅលើ អ៊ីនធឺណិត ។
ជា ចុងក្រោយ សូម ពិចារណា កន្លែង ដែល រូបភាព ត្រូវបាន គេ មើលឃើញ ។
បើមែននេះធ្វើឱ្យពិបាកក្នុងពោះ កាន់ តែខ្លាំង ។
បន្ទាប់មក អ្នក នឹង ឃើញ អ្វី មួយ ដូចនេះ ដោយ ពន្យល់ ពី មូលហេតុ ដែល វា ត្រូវបាន រារាំ ង៖
ផ្តល់ ដោយ សញ្ញា សម្ងាត់ បែប នេះ ។
ចូរ អរ ព្រះគុណ ដល់ ព្រះនាម ទ្រង់
« ហើយគេបានប្រគល់ផ្នូររបស់ទ្រង់ជាមួយនឹងមនុស្សអាក្រក់ និងជាមួយនឹងផ្នូររបស់ទ្រង់ជាបរិបូរ ... » ។
តើសហរដ្ឋអាមេរិកចង់ឃើញគាត់ទៅ កាន់ ICC លើកក្រោយទេ ?
មុខងារ និយម នៅក្នុង បរិបទ ភាសា វិទ្យា សំដៅ លើ គំនិត នោះ ។
ដូច្នេះ ចាប់ពី ពេលនេះ តទៅ ខ្ញុំ នឹង ក្លាយជា ម្ចាស់ ការលាតត្រដាង ។
បន្ទាប់មក ដោយ វារ នៅលើ ដៃ និង ជង្គង់ របស់ ពួកគេ ពួកគេ បាន ចាប់ផ្តើម យឺត ៗ ចុះក្រោម រូង ក្រោម ដី ។
តើសេចក្តីថ្លែងការណ៍ពីរក្នុងចំណោមពាក្យទាំងបីមួយ ណាជាការពិត ?
ចេញ ពី ប្រាក់ ឈ្នួល ។
ដែលមិនមានច្បាប់ធ្វើនៅថ្ងៃ ស ប្ប័ទ » ។
« អ្នក រាល់គ្នាបាន ស៊ូទ្រាំ ហើយ ស៊ូ ទ្រាំនឹងការ លំបាកសម្រាប់នាមយើង ហើយមិនបាន នឿយ ណាយឡើយ » ( វិវរណៈ ២: ៣) ។
9 មនុស្សអាក្រក់នឹងត្រូវកាត់ចោល រីឯអ្នកដែលរង់ ‌ ចាំព្រះ‌ អម្ចាស់នឹងទទួល យកទឹកដីទុកជា ម ត៌ក ។
ប៉ុន្តែ វាប្រាកដជានឹងធ្វើបានច្រើនដើម្បីដោះស្រាយការ ប្រើ ប្រាស់លើសចំណុះរបស់វាឥឡូវនេះ » ។
លក់ទិញម៉ូតូស្ព័រ ...
ដើម្បី ចាប់ផ្តើម យើង នឹង ត្រូវ៖
12 គេមិនឃើញខ្ញុំឈ្លោះប្រកែកជាមួយអ្នក ណានៅក្នុងព្រះ‌វិហារ ឬក៏ញុះញង់ហ្វូងមនុស្ស ទោះជានៅក្នុងសាលា ប្រជុំ ឬកន្លែង ណាផ្សេងទៀតក្នុងក្រុងក៏ដោយ ។
ជា មនុស្ស តស៊ូ និង ជោគជ័យ ។
អំណាចរបស់ព្រះ យេស៊ូមិនបានមកពីអ្នក ដទៃឡើយ ( ១៤) ។
ម៉ាកុស 3:20-22 បន្ទាប់មក ព្រះអង្គយាងត្រឡប់ទៅផ្ទះវិញ ហើយបណ្ដា ជនក៏មកប្រមូលផ្ដុំគ្នាម្ដងទៀត រហូតដល់មិនអាចបរិភោគបាន ។
ដូច ដែល ពួកគេ ពឹងផ្អែក លើ ម៉ាស៊ីន មេ នៅក្នុង សំណួរ ។
ខ្ញុំមិនអាចទទួលខុសត្រូវខ្ពស់បែបនេះទេ ។
ខ្ញុំ បាន រៀបការ ជាមួយ ប្តី និង កូនស្រី របស់ ខ្ញុំ ។
ប្រសិនបើ អ្នកប្រើ ហ្រ្វាំង ម្តង ៗ នោះ ពួកវា នឹង ឡើង កំដៅ ខ្លាំង ជាង ប្រសិនបើ អ្នក រាលដាល វា លើស ពី ពីរ ដង ។
ប៉ុលសរសេរអំពីខ្លួនគាត់ថា៖ « ខ្ញុំអរព្រះគុណព្រះ ដែលខ្ញុំនិយាយភាសា ដទៃច្រើនជាងអ្នក រាល់គ្នា ទោះជាយ៉ាង ណាក្នុងក្រុមជំនុំ ខ្ញុំចង់និយាយប្រាំពាក្យដោយគំនិតរបស់ខ្ញុំ ដើម្បីបង្រៀនអ្នក ឯទៀត ជាងមួយម៉ឺនពាក្យ ជាភាសាមួយ » ។
លាង ដៃ ឱ្យ បាន ទៀងទាត់ និង មាន ប្រសិទ្ធភាព ។
គឺជា កត្តាកកិត ។២. ម៉ាស៊ីន ។
គាត់ ប្រហែលជា ល្អ ណាស់ ក្នុង មិត្តភាព ។
តើអ្នក រកឃើញលទ្ធភាពជួបគាត់ដោយរបៀបណា ?
ខ្ញុំមិនដឹងថាប្រតិបត្តិការនេះអាច សង្គ្រោះជីវិតពួកគេបានទេ » ។
ឆ្កែ សម នឹង ទទួលបាន ហើយ គួរតែ ព្យួរ ។
ទាំងនេះត្រូវបាន រចនា ជាកន្លែងដែលពួកគេអាចផ្លាស់ទីបានប្រសិនបើចង់បាន ។
ដូច្នេះហើយ ការសន្យា នៃ ថ្ងៃ ខាងមុខ ត្រូវបាន រកឃើញ នៅក្នុង ពេល ព្រលប់ នៃ អ្នកកាន់ តំណែង មុន របស់ វា ។
ការរួបរួម របស់ កម្មករ !
ដែលធ្វើឲ្យពួកគេស្ថិតក្នុងគ្រោះថ្នាក់កាន់តែខ្លាំងក្នុងការ ធ្វើជាអ្នកទទួលនូវអំពើអាក្រក់ដែលពួកគេថ្កោល ទោសមនុស្សជាតិឯទៀត ៗ ។
គាត់នឹងមិនត្រូវបានគេចាប់បានសួរថាតើអ្នក ណានឹងចំណាយសម្រាប់នេះ ?
នៅក្នុង អត្ថបទ នេះ អ្នកនិពន្ធ បាន ព្យាយាម បញ្ចេញមតិ នីមួយ ៗ
គោះ ទ្វារ ខាងមុខ ឬ អត្ថបទ ។
ជំនួស ឱ្យ របៀប ដែល ខ្ញុំ ។
គិតត្រឹមថ្ងៃនេះ ព្រឹត្តិការណ៍នេះបានកើតឡើងមនុស្ស ៨ នាក់ត្រូវបានគេបញ្ជាក់ថាបានស្លាប់ក្នុងការ វាយ ប្រហារនេះ ។
មានមួយ កាលពីឆ្នាំមុននៅអូស្ត្រាលី ។
ទៅ សួរសុខទុក្ខ កូនស្រី របស់ គាត់ នៅ ពេលព្រឹក ។
ហើយនាងបាននិយាយថា ស៊ីម៉ូនមិនបានកត់សម្គាល់ឡើយ ។
ដ្បិតសាវ័ក យ៉ូហានមាន ប្រសាសន៍ថា៖ « គេបានចេញពីយើង ប៉ុន្តែគេមិនមែនជាយើងទេ ដ្បិតបើគេបានជាពីយើង នោះគេនឹងបន្តនៅ ជាមួយនឹងយើង » ( ១យ៉ូហាន ២: ១៩) ។
មន្ត្រីមូលដ្ឋានធ្វើការងារទាំង អស់ » ។
គ្មានអ្វីត្រូវធ្វើក្រៅពីប្រញាប់ដើម្បីបំបាត់ ភាពធុញទ្រាន់ ។
មនុស្ស នឹង ស្លាប់ ។
ពេត្រុសបានស្នាក់នៅក្រុង យ៉ុប ប៉េ មួយ រយៈ ជាមួយអ្នក កែស្បែកម្នាក់ឈ្មោះស៊ីម៉ូន ។
