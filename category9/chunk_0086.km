ថា វា ត្រូវបាន ពង្រឹង យ៉ាង រឹងមាំ ។
• ជំពូក នេះ និយាយ អំពី ការប្រគល់ បន្ទាយ
“ ខ្ញុំបានរងទុក្ខយ៉ាងខ្លាំងពីនាងក្នុង ភាពស្ងៀមស្ងាត់ កាលពីអតីតកាល ។
ពួកគេមិនអាចមើលឃើញថា ព្រះ នឹងលើក ត ម្កើងអស់អ្នកដែលបែរចេញពីអំពើ បាប ហើយមក រកទ្រង់ឡើយ ។
ដោយព្រះនាមនៃព្រះ យេហូវ៉ា ពួកគេជា រាស្ដ្ររបស់ទ្រង់ ។
ព្រះ‌ភក្ត្ររបស់ព្រះ‌ អម្ចាស់ប្រឆាំងនឹងអស់អ្នកដែលប្រព្រឹត្តអំពើអាក្រក់ ដើម្បីកាត់ បន្ថយការ ចងចាំពីផែនដី ។
ហើយ ខ្ញុំ នឹង រស់ នៅក្នុង ដំណាក់ របស់ ព្រះយេហូវ៉ា ។
ជាជំហានដំបូងគេហៅគាត់ មកសួរ ចម្លើយ ។
ខ្ញុំ គិត ថា មាន ការច្របូកច្របល់ មួយចំនួន ជាមួយនឹង កម្រិត បទ ។
នាង ត្រូវបាន គេ រកឃើញ មួយ ថ្ងៃ មុន ។
ពួកគេ ព្យាយាម ចាប់ ខ្ញុំ ។
ពួកគេ គឺជា ផ្នែក ដ៏ សំខាន់ នៃ ចំនួន ប្រជាជន របស់ យើង ឥឡូវនេះ ហើយ ពួកគេ កាន់តែ ក្លាយជា ជនរងគ្រោះ ។
ប៉ុន្តែសព្វថ្ងៃនេះវាមាន ន័យថា « វាជាអំណោយ » ។
រាល់ ពេល ដែល ខ្ញុំ តម្រង់ ជួរ ។
ផ្តល់ឱ្យ យើង នូវ កម្លាំង ដើម្បី រស់ នៅ !
ក្នុងលក្ខណៈដ៏វិសេសវិសាល : ដើម្បីជាប្រយោជន៍នៃការ ពន្លឿន ។
ក្នុងការ បំផ្ទុះគ្រាប់បែក ម្នាក់ ៗបានបាត់ បង់ជើង ។
តើការ បណ្ដោយខ្លួនហួសហេតុក្នុងការ បំផ្លាញខាងវិញ្ញាណនេះឬ ?
ការផុត ពូជ នេះ គឺ មាន ជម្រើស ច្រើន ជាង ការកម្ចាត់ ដាយណូស័រ ទៅ ទៀត ។
សព្វ ថ្ងៃ នេះ អនាគត នៃ ប្រទេស របស់ យើង គឺ អាស្រ័យ លើ ការរួមចំណែក ផ្ទាល់ខ្លួន របស់ យើង ម្នាក់ ៗ ។
ដល់ពួកគាត់ ; ពួកគេត្រូវបានគេវាយដោយសំណាងអាក្រក់ ដែលយើងមានសំណាង
ស្អាតស្អំ តើ មាន អ្វី សម្រាប់ អ្នក ?
ម៉ៃ ដា មើលទៅគួរឲ្យភ័យខ្លាច ហើយសួរដោយខ្យល់ បក់បោកថា៖
V 33 កាលគេ ឮដូច្នេះ ពួកគេខឹង ជាខ្លាំង ហើយរៀបគម្រោងសម្លាប់គេ ។
ជាង ធម្មតា នៅ ពេល ដែល បាន ភ្ជាប់ ជាមួយនឹង ការពិត ដែល ថា នាវិក របស់ ខ្លួន មិន ដែល ឈប់ ធ្វើ ការ ។
ព្រះយេស៊ូមានព្រះបន្ទូលថា៖ « ដូចគ្នាដែរ ចូរឲ្យពន្លឺរបស់អ្នកភ្លឺនៅចំពោះមុខមនុស្ស ដើម្បីឲ្យគេអាចឃើញការ ល្អដែលអ្នកធ្វើ ហើយសរសើរ ត ម្កើងព្រះបិតារបស់អ្នកដែលគង់នៅស្ថាន សួគ៌ » ។
គួរ កត់សំគាល់ បំផុត គឺ មិន ចាំបាច់ មាន ។
អ្នកនឹងមិនអើពើនឹងអាកប្បកិរិយាអាក្រក់ ហើយផ្តល់ រង្វាន់ ដល់អំពើល្អ។
13 ប៉ុន្តែ ចូរលើកទឹក ចិត្តគ្នាទៅវិញទៅមក ជារៀងរាល់ថ្ងៃ ដរាប ណាគេហៅនៅថ្ងៃនេះ ដើម្បីកុំឲ្យអ្នក រាល់គ្នា ណាម្នាក់រឹងរូសដោយការ បោកបញ្ឆោតរបស់អំពើ បាប ។
ហើយធ្វើឱ្យពួកគេឆ្លើយថា ពួកគេត្រូវបានបង្កើតឡើងយ៉ាង អស្ចារ្យ ។
ជូនពរ បុរស ដែល ហ៊ាន ដំបូង ។
ប៉ុន្តែ អ្នក បាន ធ្វើ រឿង អាក្រក់ ជាច្រើន មក លើ នាង ។
ពាក់កណ្តាល ប្រយោគ នាង ឈប់ និយាយ ។
ពួកគេបានស្រែកឡើង ថា៖ « ព្រះ យេស៊ូ ជាគ្រូអើយ សូមអាណិតមេត្តាយើងខ្ញុំផង » ។
យើងមិនអាចត្អូញត្អែរថា គ្មានអ្នក ណាស្តាប់យើងទេ បើយើងមិននិយាយ ។
ទ្វារនៃព្រះដំណាក់របស់ព្រះ‌ អម្ចាស់ ហើយលោកធ្វើអាសនៈនៅគ្រប់ជ្រុងនៃក្រុងយេរូ‌ សាឡឹម ។
គាត់ បាន អនុវត្ត ការកាត់ទោស របស់ គាត់ រួចហើយ លើ ការរាប់ ទាំងនោះ ។
ខ្ញុំប្រាប់គេថា វាមិនមែនជារឿងរបស់ខ្ញុំទេ ។
ខ្មាន់ កាំភ្លើងកំពុងតម្រង់ មក រកអ្នកមើល !
ហេតុ អ្វី បានជា កូនស្រី របស់ អ្នកនិពន្ធ ឈឺ ?
នាង និយាយ អំពី គ្រួសារ របស់ នា ង៖
“ ប្រសិនបើ បញ្ហា កើតឡើង នោះ យើង ត្រូវ កែតម្រូវ វា ដូច យើង ធ្លាប់ ធ្វើ ក្នុង ការប្រកួត កាលពី ថ្ងៃ មុន ដែរ ។
« តើអ្វីនឹងជាអំណោយល្អដើម្បីផ្តល់ឱ្យ?
ប្រសិនបើយើងអាចឲ្យគាត់ ប្រែក្លាយការ ស្ទាក់ចាប់ទាំងនោះដែលគាត់ធ្វើទៅជាការ ទទួលភ្ញៀវនោះជាការ ល្អ » ។
វា ត្រូវបាន គេ ហៅ ថា សន្ធិសញ្ញា មិត្តភាព ។
ស្តាប់ ទៅ ងាយស្រួល ណាស់ សម្រាប់ ជនជាតិ អាមេរិក ក្នុង ការទៅ គុយ បា ។
នេះគឺជា លទ្ធិម៉ាក្ស និយម ” ។
អ្វីដែលសំខាន់គឺថាតើហោរាម្នាក់ឈរនៅចំពោះព្រះភក្ត្រព្រះអម្ចាស់ឬក៏អត់ ។
បាន រំលោភ លើ កិច្ចប្រជុំ បើក ចំហ របស់ រដ្ឋ
ស្ទើរតែ ទាំងអស់ ដែល យើង ផ្តល់ឱ្យ អ្នក ញ៉ាំ អ្នក ចូលចិត្ត ( រហូតមកដល់ ពេលនេះ ) ។
ប្រសិនបើ អ្នក មិន អាច ស្វែងរក សន្តិភាព នៅក្នុង ខ្លួនអ្នកទេ អ្នក នឹង ខកចិត្ត ក្នុង ការស្វែងរក វា នៅ កន្លែង ផ្សេង ។
នោះជាឈ្មោះដែលនិស្សិតបានផ្តល់ឲ្យរដ្ឋបាលបច្ចុប្បន្ន ។
យើង មាន ប្រព័ន្ធ កែច្នៃ ថ្មី មួយ ។
ការរួមចំណែក របស់ អ្នក នឹង មិន ត្រូវបាន បំភ្លេច ឡើយ ។
និង ធ្វើ ពី កៅស៊ូ ធម្មជាតិ ។
ខ្ទេចខ្ទាំ ដោយ ការមើលឃើញ ដែល នាង បាន ឃើញ និង ដោយ កន្លែង លេចធ្លោ
« ឥឡូវនេះ មានអ្នកញៀនថ្នាំ បីលាននាក់ ... ខ្ញុំ សប្បាយ ចិត្តនឹងសម្លាប់ពួកគេ » ។
ខ្ញុំស្មានថាជាការ បូមខ្សាច់?
យ៉ាង ណាក៏ដោយ ខ្ញុំនឹងធ្វើយុទ្ធនាការឲ្យ NDC ព្រោះខ្ញុំស្រឡាញ់គណបក្ស » ។
ពួកគេទទួលបាន ពរ ជ័យយ៉ាងបរិបូរណ៍ ។
នេះ ជា ការពិភាក្សា ដ៏ អស្ចារ្យ នៅក្នុង ផត ខាស សម្រាប់ អ្នក
យើង ទាំងអស់ គ្នា ត្រូវតែ ធ្វើឱ្យ ចក្រភព អង់គ្លេស ដ៏ អស្ចារ្យ ម្តង ទៀត ។
យើង គ្រាន់តែ បើក គាត់ ប៉ុណ្ណោះ ប្រសិនបើ គាត់ ចង់ ជួយ យើង ។
ដើម្បី មើល ជម្រើស កន្លែង ស្នាក់ នៅ ទាំងអស់ នៅលើ ទំព័រ តែ មួយ សូម ចូល ទៅកាន់ ទីនេះ ។
នៅ ពេល ដែល កូនប្រុស របស់ គាត់ បាន កន្លងផុត ទៅ ។
ដូចដែល បទ ចម្រៀងបាននិយាយ នោះជាអ្វីដែលកើតឡើង បន្ទាប់ ។
ដូច្នេះ គាត់បានសម្រេច ចិត្តយកឈ្នះលើអ្នកឡោមព័ទ្ធ ។
កម្មវិធីនេះល្អណាស់ចំពោះព័ត៌មាននិង កិច្ច សម្ភាសន៍ ។
ខ្ញុំ ពិតជា ចង់ រវល់ ប៉ុន្តែ ខ្ញុំ ត្រូវតែ រៀបចំ ។
ម្យ៉ាងទៀត គាត់ប្រឆាំងនឹងសង្គម ។
ក្នុង ចំណាប់អារម្មណ៍ នៃ ការបញ្ចេញ ព័ត៌មាន ពេញលេញ យើង មិន បាន ធ្វើដំណើរកម្សាន្ត នោះ ទេ ។
ដូច្នេះ សូម រីករាយ ជាមួយ វា ។
ពួកគេ នឹង ត្រូវ បោះ ចូល ទៅក្នុង ភ្លើង ដូចជា ស្មៅ ។
សំណាងហើយដែលការ ចងចាំរបស់ខ្ញុំមិនចេះចប់ ...
កុំ លក់ ខ្លួនអ្នក ឱ្យ ខ្លី លើ អ្វី ដែល អ្នក បាន សាងសង់ តាំងពី ដំបូង ។
ព្រះគ្រីស្ទ បាន បំពេញ ក្តីសង្ឃឹម ។
ភ្ជាប់ ជាមួយ គេហទំព័រ មួយចំនួន ?
ព្រះអង្គនឹង នាំអ្នក ទស្សនាដល់ជើង !
វាជា លទ្ធផលដោយអចេតនានៃ ការ ស្វែងរកគ្រឿងអលង្ការ ។
ធ្វើ បច្ចុប្បន្នភាព៖ នៅក្នុង រូបភាព នេះ អ្នក អាច មើលឃើញ ការផ្លាស់ប្តូរ ទាំងអស់ ដែល ត្រូវបាន ធ្វើឡើង នៅក្នុង កំណែទី ពីរ នៃ អត្ថបទ ។
ការបដិសេធ ការកាត់ទោស កាន់កាប់ របស់ គាត់ ក្នុង ខែវិច្ឆិកា ឆ្នាំ 1993 ប៉ុន្តែ
« ថាពួកគេបែកគ្នាពេក ហើយពេលពួកគេអស់អំណាច ( ដូចឥឡូវ ) មានទំនោរបន្ទោសវាលើការ ឈ្លោះប្រកែកគ្នាក្នុងបក្ស » ។
ជីតា របស់ ខ្ញុំ បាន គាំទ្រ ខ្ញុំ គ្រប់ វេន ។
រដ្ឋាភិបាលថ្មីបាន សន្យាចាត់វិធានការ ដើម្បីដោះស្រាយបញ្ហានេះ ប៉ុន្តែផ្លូវនឹងវែងឆ្ងាយ ។
អ្នក មិន អាច ធ្វើជាមួយ ពួកគេ បាន ទេ ។
អស់អ្នកដែលជឿលើខ្ញុំ ទោះបីស្លាប់ក៏ដោយ ក៏គេនឹង រស់ដែរ ។ ហើយអស់អ្នកដែលរស់ ហើយជឿលើខ្ញុំនឹងមិនស្លាប់ឡើយ » ។
ប៉ុន្តែបើនិយាយពីអាកប្បកិរិយារបស់ពួកគេ តើយើងដឹងយ៉ាង ណាអំពីពួកគេ ?
កាតព្វកិច្ច របស់ យើង គឺ គ្រាន់តែ គោរព តាម ការណែនាំ ។
នេះគឺពិតជាមួយខែកន្លង ទៅជាពេលវេលាដ៏ល្អបំផុតសម្រាប់ពួកគេ ។
ត្រៀមខ្លួន ដើម្បី ចែករំលែក ជាមួយ ពួកគេ ពី របៀប ដែល អ្នក ស្គាល់ ទ្រង់ ។
មុនពេល គាត់ ត្រូវបាន ល្បួង ឱ្យ ធ្វើ ច្រើន ជាង នេះ ។
ព្រះអង្គជាអ្នកដែលយើងប្រកាស ដាស់តឿន និងបង្រៀនមនុស្សគ្រប់រូបដោយប្រាជ្ញា ដើម្បីឲ្យយើងរាល់គ្នាបង្ហាញខ្លួនអ្នក រាល់គ្នាឲ្យពេញវ័យក្នុងព្រះ‌គ្រិស្ដ ។ — កូល៉ុ ស ១: ២៧- ២៨ (NIV) ខែ មេសា ឆ្នាំ២០១៧
ម៉េចក៏ខ្វាក់ភ្នែកម៉្លេះបានជាផ្តល់ ក្តីស្រឡាញ់ជាលើកដំបូង
ដូច្នេះនៅថ្ងៃបន្ទាប់បុរសចំណាស់ទៅជាមួយគាត់ដូចដែលគាត់បានធ្វើជាមួយបុរសដំបូង។
លោកបាន បង្ហើបថា៖ « លោកប្រធាន គីម និងខ្ញុំនឹងជួបគ្នាម្តងទៀតនៅថ្ងៃទី ២៧ និង ២៨ ខែ កុម្ភៈ នៅប្រទេសវៀតណាម ។
« អ្នក ជាកូនរបស់ខ្ញុំ ដែលខ្ញុំស្រឡាញ់ ខ្ញុំពេញ ចិត្តជាមួយនឹងអ្នក » ។
២៧ ដ្បិតព្រះបិតាទ្រង់ស្រឡាញ់អ្នក រាល់គ្នា ពីព្រោះអ្នកបានស្រឡាញ់ខ្ញុំ ហើយបានជឿថាខ្ញុំចេញពីព្រះ។
ហើយ ប្រសិនបើ ខ្ញុំ មិន ពឹងផ្អែក លើ ម្តាយ របស់ ខ្ញុំ
អ្នក ណាដែលអំពើទុច្ចរិតត្រូវបានអត់ទោស អ្នកនោះមានសុភមង្គល ហើយអំពើ បាបត្រូវបានបិទបាំង ។
ខ្ញុំ ចង់បាត់បង់ ព្រហ្មចារីយ៍ របស់ ខ្ញុំ ប៉ុន្តែ ខ្ញុំ ខ្លាច
ខ្ញុំចេញទៅ ហើយគាត់មករកខ្ញុំភ្លាម ។
ក្នុង នាម តម្លាភាព ?
ដោយ វិធី នេះ អ្នកឧបត្ថម្ភ
សូមស្ដាប់សំឡេងនៃព្រះវិញ្ញាណ ។
និយាយ ភាសា ជប៉ុន គ្នា ទៅ វិញ ទៅមក ។
“ ខ្ញុំ បាន ពិនិត្យ ពី មន្ត្រី ព័ត៌មាន របស់ រដ្ឋាភិបាល ក្នុង តំបន់ ។
ហើយ មាន ពន្លឺ ថ្ងៃ ដំបូង ។
មាន អារម្មណ៍ ថា មាន កំដៅ ។ កិរិយា សព្ទ មាន អារម្មណ៍ ថា មាន សម្ពាធ ។
• ចំណេះដឹង ថ្មី ៗ អំពី ការគំរាមកំហែង តាម អ៊ីនធឺណិត បច្ចុប្បន្ន
ប៉ុន្តែមិន មែនទេប្រសិនបើគោលបំណងរបស់ គាត់គឺដើម្បីលើកកម្ពស់អំណាច និងឋានៈរបស់ គាត់។
ទោះ ជាយ៉ាង ណាក៏ដោយ ស្មៀនបានសម្រេច ចិត្តវាយ បកវិញ ។
សរសេរ អត្ថបទ ស្តីពី ផល ប៉ះពាល់ នៃ មេរោគ អេដស៍ / ជំនួយ លើ សង្គម
គាត់ ទន់ខ្សោយ ហើយ ញាប់ញ័រ ។
គាត់កំពុងព្យាយាមធ្វើការ លេង គាត់បានទិញពេលវេលាមួយចំនួន។
សូមឲ្យប្រជាជននៃ ជាតិ សាសន៍ ដទៃធ្វើការងារ ។
តាមអ្វីដែលខ្ញុំបានឮ មនុស្សក៏អាចធ្វើវាបានដែរ » ។
អ្វី ក៏ដោយ ដែល អ្នក មាន នៅក្នុង ចិត្ត ចូរ និយាយ វា ។
បោះចោល មេទ័ព របស់ អារក្ស ។
ដែល ជា កន្លែង ដែល ប្រជាជន បាន បិទ ភ្នែក របស់ ពួកគេ ។ យើង ត្រូវបាន ព្រមាន ជាមុន ។
២៥ ព្រះអង្គដែលប្រទានអាហារដល់មនុស្សទាំង អស់ ដ្បិតព្រះហឫទ័យមេត្តា ក រុណារបស់ព្រះអង្គស្ថិតស្ថេររហូត តទៅ ។
វា ពង្រីក អំណាច ដល់ អ្នក ។
ត្រគាក របស់ អ្នក និង ធ្វើ ដូច ស្ត្រី៖
ស្គាល់ លក្ខណៈ ទាំងអស់ របស់ វា ។
ក្នុង ការរៀបចំ សម្រាប់ ពិភពលោក ទាំងនេះ វា គឺជា ប្រទេស កូរ៉េ ។
« ពន្យល់សេចក្ដី ជំនឿនេះដល់ខ្ញុំ » ។
ហើយ នេះ គ្រាន់តែ ជា ផ្នែក នៃ រូបភាព នៃ សេចក្តីជំនឿ ប៉ុណ្ណោះ ។
ហើយ អ្នក ត្រូវ ដឹង ថា កូន របស់ អ្នក នឹង ត្រូវបាន យកចិត្តទុកដាក់ ។
ថ្ងៃ នេះ ខ្ញុំ ក្រោក ឡើង ដើម្បី ឧទ្ទិស កុសល ជូន ដល់ មន្ត្រីរាជការ ដែល លះបង់
ខ្ញុំ ចង់ រាយ ឈ្មោះ របស់ ខ្ញុំ ។
រដូវ ក្តៅ នេះ ខ្ញុំ អាច ដោះស្រាយ បាន ។
ស្រែកដោយ អំណរ ។
ដូចជា ការចោល គ្រាប់បែក ដៃ ។
« ព្រះ អម្ចាស់អើយ ហេតុអ្វីបានជាទ្រង់ នាំទុក្ខ ដល់ប្រជាជន ?
ឪពុករបស់ខ្ញុំមានជំងឺធ្ងន់ធ្ងរ ហើយខ្ញុំកំពុងមើលថែគាត់ ។
ឬ ប្រហែលជា វា និយាយ អ្វី មួយ អំពី ចំណង់ចំណូលចិត្ត របស់ ចៅក្រម នៃ ឆ្នាំ នោះ ។
លក់ របស់របរ របស់ អ្នក ចែក ដល់ អ្នកក្រ ហើយ មក តាម ខ្ញុំ ។
ហើយខ្ញុំបានសួរថា តើមានអ្វីនៅក្នុងខ្ទះ ?
ទោះជា យ៉ាងណា ក៏ដោយ មនុស្ស ភាគ ច្រើន មិន ចង់ ចំណាយ ប្រាក់ លើ ការទិញ ខ្សែ ពីរ សម្រាប់ ឱកាស ផ្សេង ៗ នោះ ទេ ។
វិធី នេះ ពួកគេ នឹង ក្លាយជា គ្រឿងទេស និង វិសាលភាព ។
ស្របតាមព្រះហឫទ័យរបស់ព្រះ ដែលពួកគេនឹងធ្វើ នៅពេលចុះ បញ្ជីក្នុងគ្រប់កិច្ចការរបស់ទ្រង់
ជា លទ្ធផល នៃ ទំនាក់ទំនង អាជីវកម្ម របស់ គាត់ គាត់ អាច ទិញ ឧបករណ៍ បន្ថែម ទៀត បន្តិច ម្តង ៗ ។
អនុសញ្ញា ក្រុមប្រឹក្សា អឺរ៉ុប ស្តីពី សកម្មភាព ប្រឆាំង នឹង ការជួញដូរ មនុស្ស ដែល បាន អនុម័ត ក្នុង ឆ្នាំ 2005 និង បាន ផ្តល់ សច្ចាប័ន ដោយ ប្រទេស បែលហ្ស៊ិក ក្នុង ខែមេសា ឆ្នាំ 2009 ។
ទ្រង់បានមកដើម្បី សង្គ្រោះអ៊ីស្រាអែល ជាប្រជារាស្ត្ររបស់ទ្រង់ ដើម្បីបំពេញសេចក្តី សញ្ញារបស់ទ្រង់ជាមួយនឹង អ័ ប្រាហាំ អ៊ីសាក និងយ៉ាកុប ដើម្បីនាំ មកនូវការសន្យារបស់ទ្រង់អំពី យូដា និង វង្សរបស់ដាវីឌ ។
ខ្ញុំមានអារម្មណ៍ដឹងគុណយ៉ាងខ្លាំងចំពោះសេរីភាពដែលយើងមានសព្វថ្ងៃ » ។
ទុក វា នៅ ខាងក្រោយ យចន នៅពេល មិន ប្រើ ដើម្បី សន្សំ ពេល វេលា ។
“ ក្នុងករណីនោះ ពែងដែលគាត់បាន បង្រួញគឺមានអ្វីប្លែកពីគេ ។
“ ដោយទឹកចុះ វានេសាទបានតិច ។
៦ យើងបានប្រគល់ដៃយើងទៅជន ជាតិអេស៊ីប និងជន ជាតិអាសស៊ើរ ដើម្បីទទួលបាននំបុ័ង ។
ចុះឈ្មោះ កូន របស់ អ្នក ដើម្បី ពួកគេ អាច ក្លាយជា ពន្លឺ នៃ ដំណឹង ល្អ ។
ហើយ ខ្ញុំ បាន ដឹង ថា កូនប្រុស របស់ ខ្ញុំ
« ហើយដោយសាររដ្ឋាភិបាលបិទ យើងកំពុងរង់ចាំ » ។
«ប្រយ័ត្នខ្លួនឯង !
រដ្ឋមន្ត្រីមួយរូបបានបាត់មុខតំណែង ហើយរហូតមកដល់ពេលនេះការ ចាប់ខ្លួន៩ នាក់ត្រូវបានធ្វើឡើង ។
ខ្ញុំបានគិតថាកូនប្រុសរបស់ខ្ញុំនឹងមិនអាច រស់នៅដោយឯករាជ្យ ។
ចង្អុល ទៅ គេហទំព័រ ណាមួយ ។
មាន អារម្មណ៍ ថា ខ្ញុំ ទើបតែ ត្រូវបាន ឡោមព័ទ្ធ ដោយ ចោរ !
វាគ្មានសំឡេងទេ ព្រោះវាស្ថិតនៅក្នុងផ្លូវធំ ។
វា ដូចជា ការបរបាញ់ ។
មាន គ្រោះមហន្តរាយ ជាច្រើន នៅក្នុង ប្រទេស ជប៉ុន ក្នុង ឆ្នាំ នេះ ។
ចង់បាន អ្វី ដែល ប្លែក ។
និយាយ ដោយ ការបកស្រាយ និង និយាយ ឡើងវិញ នូវ អ្វី ដែល អ្នក បាន ឮ ។
នោះ គឺជា អ្នក បំរើ ។
ខ្ញុំបានសួរគាត់ថា “ តើគាត់ជាសាច់ញាតិឬ ?
ដើម្បី ផ្តល់ ការពន្យល់ អំពី មូលហេតុ ដែល អ្នក ឬ សមាជិក គ្រួសារ របស់ អ្នក កើត ជំងឺ មហារីក
• តើ អ្នក ចូលចិត្ត ទទួលរង្វាន់ យ៉ាងដូចម្តេច ?
ហើយ លើស ពី នេះ បងប្អូន ជីដូនមួយ ត្រូវការ ការផ្លាស់ប្តូរ ទេសភាព សម្រាប់ ជា ប្រយោជន៍ ផ្ទាល់ខ្លួន របស់ គាត់ ក្នុង នាម ជា អ្នកលេង ។
ហើយ គាត់ បាន ជួយ មនុស្ស ជាច្រើន ។
ហើយព្រះវិហារបរិសុទ្ធពោរពេញដោយផ្សែងចេញពីសិរី ល្អនៃព្រះ និងពីព្រះចេស្ដារបស់ទ្រង់ ។ ហើយ គ្មាន នរណា ម្នាក់ អាច ចូល ទៅក្នុង ព្រះវិហារ បាន ទេ រហូតដល់ គ្រោះ កាច ទាំង ប្រាំពីរ នៃ ទេវតា ទាំង ប្រាំពីរ បាន បញ្ចប់ ។
ប៉ុន្តែមនុស្សមួយចំនួនគិតថាវានឹងមិនដំណើរការ ។
ខ្ញុំ ដឹង ថា ខ្ញុំ ស្រវឹង ( អរគុណ អ្នក ពិនិត្យ អក្ខរាវិរុទ្ធ )
នឹងគ្មានបល្ល័ង្កសម្រាប់មនុស្សខ្វាក់ឡើយ ។
យើងក៏អាស្រ័យលើសមត្ថភាពរបស់យើងដែរ ។
« តើអ្នក យល់ថាខ្ញុំបានធ្វើអ្វីសម្រាប់អ្នកទេ ?
" មាន វិធី ពីរ យ៉ាង ដែល ឈ្មោះ ហាក់ដូចជា មាន តម្លៃ សម្រាប់ ស្ថាប័ន ។
៥៤ ) អ្នក ណាដែល ស៊ីសាច់ខ្ញុំ ហើយផឹកឈាមរបស់ខ្ញុំ អ្នកនោះមានជីវិតអស់ កល្ប ជានិច្ច ហើយខ្ញុំនឹងប្រោសគាត់ឲ្យ រស់ឡើងវិញនៅថ្ងៃចុងក្រោយ ។
ខ្ញុំ អាច ស្លៀក រ៉ូប ។
ប្រសិនបើ អ្នក ពិតជា បាន ស្គាល់ ខ្ញុំ អ្នក នឹង ស្គាល់ ព្រះបិតា របស់ ខ្ញុំ ផងដែរ ។
ផ្តល់ កម្លាំង ឱ្យ ខ្ញុំ ដើម្បី ធ្វើ អ្វី មួយ ។
នេះគឺជាសិរីល្អរបស់ព្រះវរ បិតាខ្ញុំ ដែលអ្នក រាល់គ្នាបង្កើត ផលជាច្រើន ដោយបង្ហាញខ្លួនថាជាសិស្សរបស់ខ្ញុំ ។
« កុំធ្វើ បាបដី ឬសមុទ្រ ឬដើមឈើឡើយ ទាល់ តែយើងដាក់ ត្រានៅលើថ្ងាសពួកអ្នក បម្រើព្រះ នៃយើង » ។
« កុំធ្វើ បាបដី ឬសមុទ្រ ឬដើមឈើឡើយ ទាល់ តែយើងដាក់ ត្រានៅលើថ្ងាសអ្នក បម្រើនៃព្រះ នៃយើង » ។
សម្រាប់ មនុស្ស ពីរ នាក់ ដើម្បី យកឈ្នះ ។
ខ្ញុំ នឹង មិន ប្រកែក ជាមួយ អ្នក ឬ ឆ្លើយតប សារ របស់ អ្នកទេ ។
ដូច្នេះ វាគឺជាការ ល្អឥតខ្ចោះសម្រាប់អ្នក។
ម្នាលគហបតី តថាគតក្នុង អវិជ្ជា ។
ទាំងអស់ ដែល ខ្ញុំ ស្រឡាញ់
ឮដូច្នេះ មេ កងឆ្មាំព្រះវិហារ និងពួកបូជាចារ្យមានការ ងឿង ឆ្ងល់ ហើយឆ្ងល់ថាមានអ្វីកើតឡើង ។
រំលឹក ខ្ញុំ ពី ការណាត់ជួប របស់ ខ្ញុំ ។
ប្រាប់ គ្រូពេទ្យ របស់ អ្នក ឱ្យ បញ្ជូន អ្នកជំងឺ សម្រាប់ ប្រជាជន ទាំងអស់ (4) ។
ទាំង នេះ គឺជា ក្មេងស្រី កខ្វក់
អ្នក ស្ថិត នៅក្នុង ចន្លោះ ដ៏ ល្អ ឥត ខ្ចោះ ដើម្បី ចាប់ផ្តើម ធ្វើ ការ
« តើនឹងមានអ្វីកើតឡើងប្រសិនបើក្រិកចេញពីប្រាក់អឺរ៉ូ ?
តើ អ្នក មិន ដឹង ទេ ថា នៅ ពេល ដែល អ្នក ថ្វាយ ខ្លួន ដល់ នរណា ម្នាក់ ដើម្បី ស្តាប់ បង្គាប់ គាត់ នោះ អ្នក គឺជា ខ្ញុំ បម្រើ របស់ អ្នក ដែល អ្នកស្តាប់ បង្គាប់ មិន ថា អ្នក ជា ទាសករ នៃ អំពើ បាប ដែល នាំ ទៅ រក សេចក្តីស្លាប់ ឬ ការគោរព ប្រតិបត្តិ ដែល នាំ ទៅ រក សេចក្តីសុចរិត ទេ ?
ស្ត្រីជាច្រើនបាត់បង់ការងារ ឬត្រូវគេទម្លាក់ចេញ ពីតំណែង ដោយសារពួកគេមានផ្ទៃពោះ។
សិរី រុងរឿង របស់ ព្រះជាម្ចាស់ ត្រូវបាន បង្ហាញ តាមរយៈ អ្នក ជឿ
យើងស្ថិតនៅក្នុងពេលដែល កម្លាំងនៃការ គាបសង្កត់នៅក្នុងការ ឡើងចុះ ។
អ្វី ដែល ត្រូវ ធ្វើ ប្រសិនបើ អ្នក គិត ថា អ្នក ជា ជនរងគ្រោះ ?
ម្យ៉ាង វិញ ទៀត នាង នឹង ត្រូវបាន គេ មើលឃើញ ថា ជា ជន ផ្តាច់ការ ។
គាត់ធ្វើម៉េចមិនចូល ?
កិច្ចប្រជុំ ទូទៅ លើក ទី៣ របស់ ក្រុមប្រឹក្សា តស៊ូ មតិ ជន ពិការ ។
ពួកគេ បាន រកឃើញ ទឹក ហើយ កងទ័ព ត្រូវបាន សង្គ្រោះ ។
អ្នក ណាដែលត្រូវគេខាំ ពេល ណាមើលទៅ អ្នក នោះនឹងមានជីវិត » ។
៣ នេះជាការ ល្អ និងគួរឲ្យពេញ ចិត្តនៅចំពោះព្រះភក្ត្រនៃព្រះជាព្រះសង្គ្រោះនៃយើង ...
ហើយមានរឿងមួយទៀតដែលធ្វើឲ្យរឿងនេះស្មុគស្មាញ ។
អ្នកមើលអ្វីដែលគាត់បានធ្វើ ហើយយូរមកហើយ » ។
ក្រោយមក ធ្វើ ដូច្នេះ ដោយ ក្ដីស្រឡាញ់ ដោយ ដឹង ថា ខ្ញុំ ត្រូវបាន តែងតាំង សម្រាប់ ការពារ ដំណឹង ល្អ ។
ហើយកុំប្រញាប់ប្រាប់កូនថា បើគាត់មិនប្រញាប់ទេ កូននឹងទុកគាត់នៅ ផ្ទះ។
ប៉ុន្តែដោយ សារពួកគេមិនអាចរៀបការ ដោយស្របច្បាប់ នេះមិនអាចទៅរួចទេ ។
នៅលើផ្លូវនេះ មនុស្ស ម្នាដើរដោយសុខសាន្ត ។
អ្នក បានមើលខ្ញុំក្នុងសុបិនរបស់ខ្ញុំ ហើយខ្ញុំចូល ចិត្តអារម្មណ៍របស់ខ្ញុំ » ។
ស្ត្រីម្នាក់យល់ព្រមទៅណាត់ជួបមនុស្សពិការភ្នែក
ខ្ញុំនឹងឆ្លៀតឱកាសរបស់ខ្ញុំជាមួយនឹងសង្គមលោកិយ » ។
តើគួរសម្អាតម្តងក្នុងមួយថ្ងៃទេ ?
សមុទ្រ កំពុង ហូរ ។
យើងត្រូវធ្វើបែបនេះ --- ធ្វើឱ្យការ ប្រណាំងនីមួយ ៗរាប់។
១១ ហើយនៅពេល ណាដែលមនុស្សដែលមានវិញ្ញាណអាក្រក់នៅក្នុងពួកគេបានឃើញគាត់ នោះពួកគេនឹងដួលនៅចំពោះមុខគាត់ ហើយស្រែក ថា៖ « អ្នក រាល់គ្នាជាបុត្ររបស់ព្រះ!
ប៉ុន្តែប្រសិនបើគាត់ត្រូវបានគេបង្ហាញថាមានកំហុស វាប្រាកដជាមិនមានការសង្ស័យថាគាត់នឹងត្រូវបានបណ្តេញចេញ ។
ព្រះអង្គមានព្រះបន្ទូលទៅគេ ថា៖ « ខ្ញុំប្រាប់អ្នក រាល់គ្នាតាមពិតថា បើអ្នកទាំងនេះនៅស្ងៀម នោះថ្មនឹងស្រែកឡើង » ។
ពួកគេមិនអន់ជាងអ្នក ដទៃក្នុងប្រទេសនេះទេ ។
សន្តិសុខ នៅ ផ្ទះ ជាមួយ ខ្ញុំ ព្រោះ គេ គិត ថា ខ្ញុំ ជា ប្រជ្រុយ ។
« យើងគោរពអាណត្តិដែលផ្តល់ដោយអ្នកបោះឆ្នោត ។
ប៉ុន្តែ ប្អូន ប្រុស របស់ អ្នក ប្រហែលជា មិន ឃើញ បែប នេះ ទេ ពីព្រោះ ប្រសិនបើ អ្នក និយាយ អ្វី ដែល គាត់ មិន ចង់ ឮ គាត់ ប្រហែលជា ជ្រើសរើស បន្ទោស អ្នកនាំ សារ ជាជាង ទទួលស្គាល់ ការពិត ។
យើង ដើរលេង យ៉ាងហោច ម្តង ក្នុង មួយ សប្តាហ៍ ហើយ ផ្តល់ ភាពអៀនខ្មាស គ្នា ទៅ វិញ ទៅ មក ប្រសិនបើ យើង មិន រីកចម្រើន ។
ដោយការ ចាប់ កប៉ាល់របស់គាត់ ?
ស្វែងយល់ ពី មូលហេតុ ដែល វា ប្រារព្ធ ពិធី របស់ ខ្លួន ។
ដល់ផ្ទះពេលថ្ងៃត្រង់ សម្រេចហើយហាត់ ប្រាណ ។
គេ ជឿ ថា គាត់ ត្រូវបាន ជម្រុញ ឱ្យ សម្លាប់
ម៉ារី មាន ត្រី បាឡែន តូច មួយ ។
ស្នេហា បុរស មាន ប្រសិទ្ធភាព ជាង ?
ការអនុវត្ត របស់ ខ្ញុំ គឺ ក្រៅ ម៉ោង ។
សិស្សត្រូវត្រៀមខ្លួនក្នុងពេលមួយម៉ោងក្នុងមួយ...
គាត់បានអង្វរ គាត់បានអង្វរ ហើយគាត់បានអធិស្ឋាន ។
" ខ្ញុំហាក់ដូចជាត្រូវគិតពីការ រក្សារូប មន្តសម្ងាត់ !"
" ដើមឈើនោះលែងមានស្លឹកបៃតងទៀតហើយ " ។
បញ្ហា របស់ អ្នកលក់ សៀវភៅ គឺ គាត់ ត្រូវតែ មាន សុជីវធម៌ ។
វា ពិតជា សំណាង ណាស់ ដែល អ្វី ដែល បាន កើតឡើង មិន ធ្ងន់ធ្ងរ ពេក ។
ស្លាប ខាងលិច នឹង ត្រូវ បំផ្លាញ
នៃ ការភ្ជួរ រាស់ ត្រូវបាន ឈានដល់ ។
ហើយមានសំឡេងពីលើមេឃ បន្លឺឡើងថា៖ « នេះជាបុត្ររបស់ខ្ញុំដែលខ្ញុំស្រឡាញ់ ខ្ញុំពេញ ចិត្តជាមួយនឹងគាត់ » ។
អេភេសូរ 2:8 ប្រាប់យើងថា « ដ្បិតគឺដោយព្រះគុណរបស់ព្រះ ដែលអ្នកបានត្រូវ សង្គ្រោះដោយ សារសេចក្ដី ជំនឿ ។
ខ្ញុំត្រូវដឹងលម្អិត ពីរបៀបដែលអ្នកត្រូវបានគេ បណ្តេញចេញពី រ បារ !
រួចគាត់បង្រៀនតាមហ្នឹង » ។
ត្រង់ ចំណុច នេះ ខ្ញុំ សុខចិត្ត ចែក ឈាម របស់ ខ្ញុំ ប្រសិនបើ វា នឹង នាំ ខ្ញុំ ឱ្យ ខិត ទៅ ជិត ចម្លើយ មួយចំនួន ។
ដ្បិតកូនប្រុសស្រីបម្រើនឹងមិនទទួល មរតកជាមួយនឹងកូនអ្នក សេរីឡើយ » ។
គាត់ បាន លះបង់ ទាំងអស់ សម្រាប់ យើង ។
ខ្ញុំខិតខំ គោរពពេលវេលារបស់មនុស្ស » ។
តែ ទឹកដោះគោ ថៃ ។
ប្រើ សម្រាប់ ស្ងោរ ទឹក ដើម្បីឱ្យ វា មាន សុវត្ថិភាព ក្នុង ការផឹក ( ទឹក ពី អណ្តូង មិន ទាមទារ ឱ្យ ឆ្អិន ទេ លុះត្រាតែ តំបន់ ជុំវិញ នោះ មិន ស្អាត ។
ហើយ បាន បន្ថែម ថា « ឯកភាព បូរណភាព ទឹកដី និង បូរណភាព ទឹកដី របស់ អ៊ុយក្រែន ត្រូវតែ គោរព គ្រប់ ពេលវេលា និង ដោយ ភាគី ទាំងអស់ ។
ខណៈដែលគ្រាប់ ធញ្ញជាតិដែលមានគ្រាប់មិនសាបសូន្យត្រូវបានគោ ក្របីពេញ ចិត្តមិនសមាមាត្រ ។
ហើយ ស្នើសុំ ទម្រង់ សមាជិកភាព ដែល ត្រូវ ផ្ញើ ទៅ អ្នក ។
23 ផារ៉ោនបែរក្រោយ ចូលទៅក្នុងវាំង ទាំងមិនបានគិតដល់រឿងនេះទេ ។
តើ មនុស្ស នៅក្នុង ផ្នែក នៃ ពិភពលោក នោះ មាន វិធី ពន្យារ កំណើត ទេ ?
ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ត្រូវបាន សហភាព អាហ្រ្វិក ធ្វើ បទបង្ហាញ កាលពី យប់ មិញ ស្តីពី កិច្ចព្រមព្រៀង សន្តិភាព ។
48 ម៉ោង នៅ ទីក្រុង អូតា វ៉ា ប្រទេស កាណាដា៖ ការធ្វើដំណើរ ដ៏ ល្អ ឥត ខ្ចោះ
តើអ្នក យល់ស្របនឹងចំណុច ណាមួយក្នុងចំណោម ៥ ចំណុចនេះទេ ?
ដំបូង អ្នក អាច មើល រូបភាព ដំបូង ។
ការរៃ អង្គាស ប្រាក់ មិន មែន ជា ទំនួល ខុសត្រូវតែ មួយ គត់ របស់ បុគ្គលិក អភិវឌ្ឍន៍ ទេ ។ មនុស្ស គ្រប់ រូប ត្រូវតែ តម្រង់ ជុំវិញ គោលដៅ រួម មួយ ។
ខ្ញុំ គួរតែ ដឹង ថា ខ្ញុំ ជា បុរស នោះ ហើយ ខ្ញុំ នឹង ស្រលាញ់ នាង រហូតដល់ ថ្ងៃ ឈប់សំរាក ។
ចំណងជើង ផ្លូវការ របស់ វិក័យប័ត្រ ។
១៤ មាន ពរហើយអស់អ្នក ណាដែលបោកសម្លៀក បំពាក់របស់ខ្លួន ដើម្បីឲ្យពួកគេមានសិទ្ធិចូលទៅ ឯដើមជីវិត ហើយអាចចូលតាមទ្វារក្រុង ។
អស្ថិរភាព នឹង មាន ស្ថេរភាព ក្នុង ពេល ឆាប់ ៗ នេះ ។
អ្នកត្រូវ តែធ្វើអ្វីដែលចាំបាច់ដើម្បីនៅលើទីលាន » ។
យ៉ូសែប ជា កូនរបស់ព្រះបាទដាវីឌ កុំខ្លាចនឹងយកនាងម៉ារី ជាភរិយាទៅអ្នកឡើយ ដ្បិតការ ដែលមានគភ៌ក្នុងនាង គឺ មកពីព្រះវិញ្ញាណបរិសុទ្ធ ។
១៤ « ឥឡូវនេះ មើលចុះ បើសិនជាគាត់បង្កើតកូនប្រុសម្នាក់ ដែលឃើញអំពើ បាបទាំងអស់របស់ឪពុកខ្លួន ដែលគាត់បានធ្វើ ហើយខ្លាច ហើយមិនដូចនោះ
ខ្ញុំព្យាយាម រត់ចេញពីគេ ហើយគេមិនឈប់ » ។
លូកា 18:36 ពេលគាត់ឮហ្វូងមនុស្សដើរកាត់ គាត់សួរថាមានអ្វីកើតឡើង ។
ស្ត្រីម្នាក់នេះបានរស់នៅក្នុងសហគមន៍ និងញុះញង់អារក្សអស់រយៈពេលជាងហុកសិបឆ្នាំ មកហើយ ហើយមិនមាន សញ្ញានៃការ ថយចុះឡើយ ។
តែងតែ ពេញចិត្ត ចំពោះ ម្ចាស់ របស់ វា ។
ទទួល ស៊ីស៊ី អត្ថន័យ នៃ ឈ្មោះ .
ខ្ញុំប្រាកដថាអ្នក ប្រឡងនឹងមិនដាក់ពិន័យអ្នកទេ ។
រហូតមកដល់ពេលនេះ នាងស្រឡាញ់ការ ពិតដែលគ្មានប្រុស ណាមកតាមនាងឡើយ ។
ដូច្នេះ យើងនៅ តែអាចទុកចិត្តគាត់ទាំង ស្រុង ។
យើងនឹងបង្ហាញបុរសទាំងអស់នេះថា តើនរណានៅថ្ងៃនេះ ។
យក វា ចូល ក្នុង ផ្ទះ ប៉ុន្តែ ជាធម្មតា គេ មិន អាច ។
ខ្ញុំដឹងថាអ្នក ចាំហេតុអ្វីបានជាអ្នកត្អូញត្អែរ។
តើ មាន មនុស្ស ប៉ុន្មាន នាក់ ដែល ស្ម័គ្រចិត្ត ពេលវេលា របស់ ពួកគេ ?
ម្នាល ភិក្ខុទាំង ឡាយ មិនប្រព្រឹត្តអំពើអាក្រក់ឡើយ ។
« បន្ទាប់ពីនេះ ព្រះ អម្ចាស់បានចាត់តាំងចិត សិបពីរនាក់ទៀត ហើយចាត់គេពីរនាក់ជាពីរមុនលោកទៅគ្រប់ក្រុងទាំង ឡាយ ... » ។
ដ្បិតទ្រង់ត្រូវគេឆ្កាងនៅមុនថ្ងៃសៅរ៍ ( សៅរ៍ ) ។
ដ្បិត ផលនៃ វិញ្ញាណគឺនៅក្នុងគ្រប់ទាំងសេចក្ដី ល្អ សេចក្ដី សុចរិត និងសេចក្ដី ពិត ។
ការរួមភេទ របស់ ខ្ញុំ ជាមួយ គាត់ ។
ជាវ ដើម្បី ទទួលបាន លេខ កូដ ។
ឈាម របស់ មនុស្ស ម្នាក់ ៗ ។
