( ឧត្តរមានជ័យ )៖ លោក គន់ គីម សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត ឧត្តរមានជ័យ បាន រំលឹក ដល់ សមាជិក សមាជិកា ក្រុមការងារ ថា បេសកកម្ម ចុះ មូលដ្ឋាន ដើម្បី ជួយ ដោះស្រាយ រាល់ បញ្ហា របស់ ប្រជាពលរដ្ឋ ដូច្នេះ ត្រូវតែ ប្រឹងប្រែង ឱ្យ អស់ លទ្ធភាព ដោះស្រាយ បញ្ហា ដែល កើតមាន ចំពោះ ប្រជាពលរដ្ឋ ។
លោក គន់ គីម បាន ក្រើន រំលឹក បែប នេះ ក្នុង កិច្ចប្រជុំ បូកសរុប ការងារ របស់ ក្រុមការងារ បក្ស ប្រចាំ ខែឧសភា និង លើក ទិសដៅ ការងារ ថ្មី នៅ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២០ នេះ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ឧត្តរមានជ័យ ។
ក្នុង កិច្ចប្រជុំ នេះ លោក ប៉ែន កុសល្យ ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ឧត្តរមានជ័យ និង លោក ស៊ី ប្រាសិទ្ធ អនុប្រធាន គណបក្ស បាន លើក បង្ហាញ នូវ សមិទ្ធផល ការងារ ដែល សម្រេចបាន ក្នុង ខែឧសភា និង លើក បញ្ហា មួយចំនួន ដែល ត្រូវ រក ដំណោះស្រាយ ផងដែរ ។
ការងារ ដែល សម្រេចបាន មាន ដូចជា ការងារ ចុះអប់រំ ផ្សព្វផ្សាយ ពី ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ រួម នឹង ការចុះ ផ្តល់ ស្បៀងអាហារ ជូន ប្រជាពលរដ្ឋ ជួប ការខ្វះខាត ក្នុង កំលុង ពេល នៃ ការរាត ត្បាត ជំងឺ កូវីដ១៩ នេះ ។ ក្រៅពី នោះ ក្រុមការងារ បាន ធ្វើ សកម្មភាព យ៉ាង សស្រាក់សស្រាំ ផ្តល់ ជា ស្បៀងអាហារ ជួយ ជួសជុល ផ្ទះ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ និង បាន ផ្តល់ ស័ង្កសី សម្រាប់ ជួសជុល ផ្ទះ សរុប បាន ៧២ ខ្នង ផ្ទះ ផ្តល់ ស័ង្កសី ចំនួន ៥២៧ សន្លឹក និង ហ្វីប្រូស៊ីម៉ង់ ចំនួន ៥៧៨ សន្លឹក ។
លោក គន់ គីម បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចប្រឹងប្រែង របស់ ក្រុមការងារ ដើម្បី ឆ្លើយតប ការលំបាក របស់ ប្រជាពលរដ្ឋ បាន ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព ។
បើ ទោះបីជា យ៉ាងណា លោក គន់ គីម ប្រធាន ក្រុមការងារ បាន ជំរុញ ក្រុមការងារ និង អាជ្ញាធរ មូលដ្ឋាន បន្ត អនុវត្ត សេចក្តីណែនាំ របស់ រាជ រដ្ឋាភិបាល ស្តីពី ការកំណត់ អត្តសញ្ញាណកម្ម គ្រួសារ ក្រីក្រ ឱ្យ បាន ច្បាស់លាស់ និង សុក្រិតភាព ដើម្បី រាជ រដ្ឋាភិបាល ជួយ ដល់ ការលំបាក របស់ ពួកគេ ។
លោក គន់ គីម ក៏ បាន រំលឹក ក្រុមការងារ បន្ត ត្រួតពិនិត្យ ពលករ ដែល ត្រឡប់ មកវិញ តាម ច្រក ព្រំដែន ទាំង ពីរ ( ជាំ និង អូរ ស្មាច់ ) និង ធ្វេី ចត្តាឡី ស័ក តាម ការណែនាំ របស់ ក្រសួង ខិតខំ ផ្សព្វផ្សាយ ឱ្យ ប្រជាពលរដ្ឋ បន្ត ប្រុងប្រយ័ត្ន បង្ការ ការពារ ខ្លួន ពី កូវីត - ១៩ ។ បន្ថែម ពីលើ នោះ បន្ត ចុះ តាម ខ្នង ផ្ទះ ជួយ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព លំបាក ម្ចាស់ ការជួយ ឧបត្ថម្ភ ពួក គាត់ បន្ត ទៀត ដោយ មិន រង់ចាំ ជំនួយ ពី ថ្នាក់ លេី ។
លោក ប្រធាន ក្រុមការងារ ក៏ បាន ណែនាំ ដល់ ក្រុមការងារ សហការ ជាមួយ អាជ្ញាធរ ស្រុក ខេត្ត និង ស្ថាប័ន ជំនាញ ត្រូវ ខិតខំ ដោះស្រាយ បញ្ហា ប្រឈម ដែល នៅ សេសសល់ ផ្សេង ៗ ទៀត ។
លោក ប្រធាន ក្រុមការងារ បន្ថែម ថា ទោះ ក្នុង កាលៈទេសៈ ណា ក៏ដោយ ការចូលរួម ដោះស្រាយ បញ្ហា របស់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន គឺ ត្រូវតែ អនុវត្ត ឱ្យ ខាន តែ បាន ដូច ពាក្យស្លោក ដែល បាន ពោល ថា គណបក្ស ប្រជាជន កម្ពុជា មាន ប្រភព ពី ប្រជាជន ជា របស់ ប្រជាជន និង ដើម្បី ប្រជាជន ។
យោង តាម ក្រុម អ្នកជំនាញ ផ្នែក សុខាភិបាល ចម្លើយ សម្រាប់ ភាពជោគជ័យ របស់ វៀតណាម គឺ អាស្រ័យ លើ កត្តា រួម ជាច្រើន មាន ចាប់តាំងពី ការចាត់ វិធានការឆ្លើយតប យ៉ាង ឆាប់រហ័ស និង ទាន់ ពេលវេលា របស់ រដ្ឋាភិបាល វៀតណាម រហូតដល់ ប្រព័ន្ធ នៃ ការស្វែងរក អ្នក ជាប់ពាក់ព័ន្ធ ជាមួយ អ្នក ឆ្លង ជំងឺ និង ការធ្វើចត្តាឡី ស័ក ( ការដាក់ ឲ្យ នៅ ដាច់ដោយឡែក ) ដែល ប្រកបដោយ ភាពហ្មត់ចត់ និង រឹងរ៉ឹង ព្រមទាំង ការជូនដំណឹង ផ្នែក ទំនាក់ទំនង ជាមួយ មហាជន ដែល មាន ប្រសិទ្ធភាព ខ្ពស់ ។
( ភ្នំពេញ ) ៖ ព្រោះតែ ការប្រជែង ឥទ្ធិពល របស់ មហា អំណាច ក្នុង សម័យ សង្គ្រាម ត្រជាក់ បាន ធ្វើឱ្យ កម្ពុជា ត្រូវ រអិល ខ្លួន ក្លាយជា សាច់ ដែល ត្រូវ គេ កាប់ ចិញ្ច្រាំ រហូត រអិល ជើង ធ្លាក់ ក្នុង វិបត្តិ នៃ ភ្លើង សង្គ្រាម យ៉ាង ខ្លោចផ្សារ ជា ទីបំផុត ។
មកដល់ ពេល បច្ចុប្បន្ន កម្ពុជា បាន ក្លាយទៅជា ភូមិសាស្ត្រ ថ្មី មួយ ដែល ចិន និង អាមេរិក យក ធ្វើជា ទីកន្លែង ប្រជែង ឥទ្ធិពល របស់ ពួកគេ ទៀត ហើយ ។ តើ កម្ពុជា ត្រូវ រៀបចំ ខ្លួន របៀប ណា ដើម្បី កុំ ឱ្យ ការប្រជែង ឥទ្ធិពល របស់ មហា អំណាច ទាំង ពីរ នេះ ក្លាយទៅជា គ្រោះ សម្រាប់ កម្ពុជា ? នេះ ជា សំណួរ មួយ ដែល ត្រូវបាន ប្រជាពលរដ្ឋ អ្នកសិក្សា បញ្ញា វ័ន្ត ខ្មែរ បាន លើកឡើង នា ពេល បច្ចុប្បន្ន ។
អ្នកជំនាញ ប្រវត្តិសាស្ត្រ និង ភូមិសាស្ត្រ នយោបាយ របស់ កម្ពុជា ចំនួន ៤រូប បាន រួមគ្នា បកស្រាយ លើ សំណួរ នេះ ក្នុង កិច្ចពិភាក្សា តុ មូល មួយ ដែល បាន រៀបចំឡើង ដោយ រាជ បណ្ឌិត្យ សភា កម្ពុជា កាលពី ថ្ងៃទី ២៩ ខែឧសភា កន្លងទៅ នេះ ។
ដើម្បី បាន ជ្រាប ពី វិធីសាស្ត្រ ដែល កម្ពុជា ត្រូវ រំដោះ ខ្លួន ចេញ ពី ការប្រជែង ឥទ្ធិពល របស់ ចិន និង អាមេរិក សូម ទស្សនា វីដេអូ ខាងក្រោម នេះ៖
គួរ បញ្ជាក់ ថា នៅសល់ តែ មួយ ថ្ងៃ ទៀត ប៉ុណ្ណោះ គឺ នៅ ថ្ងៃអាទិត្យ ស្អែក នេះ ឥណ្ឌា នឹង ឈានដល់ ពេល កំណត់ នៃ ការបិទ ប្រទេស ហើយ ប៉ុន្តែ គេ នៅ មិន ទាន់ ដឹង ថា តើ រដ្ឋាភិបាល នឹង អូសបន្លាយ ពេល បន្ត ទៀត ដែរ ឬមួយ ក៏ យ៉ាងណា នោះ ឡើយ ខណៈ ស្ថានការណ៍ នៅ ចំពោះមុខ គឺ ការរាត ត្បាត ជំងឺ COVID-19 គ្មាន សភាព ធូរស្រាយ បន្តិច សោះ ៕ កម្លាំង អាវុធហត្ថ បង្ក្រាប រថយន្ដ កែច្នៃ ១គ្រឿង នៅ ស្រុក ស្នួល ខេត្ត ក្រចេះ លួច ដឹក ឈើ គ្មាន ច្បាប់ អនុញ្ញាត បម្រុង ចេញ ទៅ វៀតណាម
( ក្រចេះ ) ៖ កម្លាំង អាវុធហត្ថ ខេត្ត ក្រចេះ សហការ ជាមួយ ជំនាញ រដ្ឋបាល ព្រៃឈើ សង្កាត់ ស្នួល នៅ ព្រឹក ថ្ងៃទី ៣០ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន បង្រ្កាប រថយន្ដ កែច្នៃ ១គ្រឿង ដឹក ឈើ ពេញ ព្រៀប គ្មាន ច្បាប់ អនុញ្ញាត នៅ ភូមិ ចរចារ ឃុំ ក្រញូង សែន ជ័យ ស្រុក ស្នួល ខេត្ត ក្រចេះ ។
មន្រ្តី អាវុធហត្ថ បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ថា រថយន្ដ កែច្នៃ ១គ្រឿង នេះ បាន ដឹក ឈើ ពេញ ព្រៀប ពេញ ពី ស្រុក កែវសីម៉ា ខេត្ត មណ្ឌលគីរី ឆ្លងកាត់ ខាងក្រោយ ក្រុមហ៊ុន ឡាយ ព្រហស្បតិ៍ បម្រុង យក ទៅ លក់ នៅ ប្រទេស វៀតណាម តែ មកដល់ ចំណុច ចំការ កៅស៊ូ ភូមិ ឃុំ កើត ហេតុ ខាង លើ ត្រូវបាន សមត្ថកិច្ច ធ្វើ ការ បង្រ្កាប តែម្ដង ។
លោក ផូង ឃុនឡាយ នាយ សង្កាត់ រដ្ឋបាល ព្រៃឈើ ស្នួល បាន បញ្ជាក់ ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ប្រចាំ ខេត្ត ក្រចេះ នៅ រលៀល ថ្ងៃ នេះ ថា រថយន្ដ កែច្នៃ ១គ្រឿង នេះ ដឹក ឈើ ប្រភេទ សុក្រំ ឈើ ឃ្លុំ ពេញ រថយន្ដ តែម្ដង ហើយ គ្មាន ច្បាប់ អនុញ្ញាត្ត នោះ ទេ ក៏ ត្រូវ កម្លាំង សមត្ថកិច្ច កំពុង នាំយក រថយន្ដ ១គ្រឿង នេះ មក ទុក នៅ សួន អាពាពិពាហ៍ ដើម្បី ធ្វើ ការវាស់វែង និង ចាត់ការ ទៅ តាម ផ្លូវ ច្បាប់ របស់ រដ្ឋបាល ព្រៃឈើ ៕
ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ និង រដ្ឋមន្ត្រី បរិស្ថាន ចុះ ដោះស្រាយ បញ្ហា ដី ធ្វើ ស្រែ ជូន ពលរដ្ឋ ស្រុក តាំង គោក ក្នុង តំបន់ អភិរក្ស សត្វ ខ្សឹប និង តំបន់ ៣
( កំពង់ធំ )៖ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ ដែល មាន លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ ជា ប្រធាន ក្រុមការងារ ព្រមទាំង លោក សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន និង លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ នា ថ្ងៃទី ៣០ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ចុះ សំណេះសំណាល និង ដោះស្រាយ បញ្ហា ដី អាស្រ័យ ផល នៅ « តំបន់ អួលួ » ជូន ប្រជាពលរដ្ឋ នៅ ស្រុក តាំង គោក ខណៈ ទីតាំង ដី មាន បញ្ហា នេះ គឺ ស្ថិត ក្នុង តំបន់ អភិរក្ស សត្វ ខ្សឹប ផង និង តំបន់ ៣ផង នៃ ភូមិសាស្ត្រ ឃុំ ទ្រៀល ស្រុក តាំង គោក ។
នា ឱកាស នោះ លោក រដ្ឋមន្ត្រី សាយ សំអាល់ បាន បើក បេះដូង ក្នុង ការដោះស្រាយ បញ្ហា នេះ ដោយ លោក ណែនាំ ឱ្យ ប្រជាពលរដ្ឋ បង្កើត សហគមន៍ អួលួ ក្នុង នោះ ប្រជាពលរដ្ឋ ត្រូវ ធ្វើការ ជាមួយ មន្ទីរ បរិស្ថាន ខេត្ត ដែល មាន មន្ត្រី ជំនាញ ចាំ ជួយ ប្រឹក្សា យោបល់ និង អាជ្ញាធរដែនដី ដើម្បីឱ្យ ត្រូវ នឹង នីតិវិធី នៃ ការបង្កើត សហគមន៍ ។ នៅពេល ប្រជាពលរដ្ឋ បង្កើត បាន សហគមន៍ មួយ ហើយ លោក រដ្ឋមន្ត្រី នឹង បើក ការដោះស្រាយ ជូន និង ទទួលយក បាន ទាំងអស់ គ្នា ។
លោក រដ្ឋមន្ត្រី ថោង ខុន ក៏ បាន ពន្យល់ ប្រាប់ ប្រជាពលរដ្ឋ ថា ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ ក្រសួង បរិស្ថាន និង អាជ្ញាធរ មិន ទុក ឱ្យ ប្រជាពលរដ្ឋ លំបាក វេទនា នោះ ឡើយ គឺ ដឹង តែ ដោះស្រាយ ប្រកបដោយ ភាពត្រឹមត្រូវ ហើយ សុទ្ធតែ ដើម្បី ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ប៉ុន្តែ ដើម្បីឱ្យ ការដោះស្រាយ នេះ មាន ប្រសិទ្ធភាព ក្រសួង និង មន្ទីរ បរិស្ថាន ព្រមទាំង អាជ្ញាធរដែនដី ចាំបាច់ ត្រូវ ធ្វើឱ្យ ត្រឹមត្រូវ តាម នីតិវិធី ច្បាប់ ជៀសវាង បង្ក បញ្ហា ដល់ ប្រជាពលរដ្ឋ នា ពេល ក្រោយ ។
ជាមួយគ្នា នោះ លោក អភិបាល ខេត្ត សុខ លូ ក្នុង នាម ជា អាជ្ញាធរដែនដី ក៏ បាន ប្ដេជ្ញាចិត្ត ចាំ ជួយ ដោះស្រាយ និង ចុះ ជាប់ ជាមួយ ប្រជាពលរដ្ឋ ក្នុង ការសម្របសម្រួល នៅ ពេលណា ដែល ប្រជាពលរដ្ឋ ត្រូវការ ឱ្យ អាជ្ញាធរ ជួយ និង មាន សំណូមពរ ផ្សេង ៗ ដែល អាជ្ញាធរដែនដី អាច ជួយ បាន ។
លោក រដ្ឋមន្ត្រី ថោង ខុន និង លោក រដ្ឋមន្ត្រី សាយ សំអាល់ បាន សន្យា ចំពោះ ប្រជាពលរដ្ឋ ថា នឹង ត្រលប់មក ជួបប្រជាពលរដ្ឋ ម្ដង ទៀត នា អំឡុង ពេល ២ ខែ ក្រោយ ដើម្បី សម្ពោធ សហគមន៍ ក្រោយ ប្រជាពលរដ្ឋ បង្កើត រួចរាល់ និង ពាំនាំ ដំណោះស្រាយ មក ដោះស្រាយ ជូន ប្រជាពលរដ្ឋ បន្ថែម ទៀត ។
នៅពេល ទទួលបាន ការណែនាំ និង សំណើ ពី ថ្នាក់ដឹកនាំ ខាងលើ រួច មក ប្រជាពលរដ្ឋ មាន ការពេញចិត្ត យ៉ាង ខ្លាំង និង បាន ទទួលយក នូវ ការណែនាំ អំពី យន្តការបង្កើត សហគមន៍ និង រង់ចាំ ដំណោះស្រាយ បន្ត ទៀត ពី ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ ក្រសួង បរិស្ថាន និង អាជ្ញាធរ មូលដ្ឋាន ៕ គ្រាប់ ត្នោត ១០ម៉ឺន គ្រាប់ ត្រូវ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង យក ទៅ ដាំ អម សង្ខាង ផ្លូវ ក្នុង ស្រុក ចំនួន ២ ឆ្ពោះទៅ បន្ទាត់ ព្រំដែន កម្ពុជា - ឡាវ
( ស្ទឹងត្រែ ) ៖ លោក ម៉ុម សារឿន អភិបាល ខេត្ត ស្ទឹងត្រែង នៅ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ មន្ត្រីរាជការ និង ចៅហ្វាយ ស្រុក បុរី អូរ ស្វាយ និង ចៅហ្វាយ ស្រុក សៀម ប៉ាង ចុះ ដាំ គ្រាប់ ពូជ ត្នោត នៅ តាម ដងផ្លូវ បំបែក ពី ទី រួម ស្រុក សៀម ប៉ាង ឆ្ពោះទៅ ផ្លូវ បន្ទាត់ ព្រំដែន កម្ពុជា - ឡាវ ចំនួន ១០ម៉ឺន គ្រាប់ ត្រង់ ចំណុច « អូរ គុ» ។
អភិបាល ខេត្ត បាន បន្ត ថា បច្ចុប្បន្ន នេះ ប្រទេស កម្ពុជា ទទួលបាន សុខ សន្តិភាព ពេញលេញ ដូច្នេះ ត្រូវ កែច្នៃ សោភ័ណភាព នៅ ទីនេះ ឱ្យ មាន សម្រស់ ស្រស់បំព្រង ទើប រដ្ឋបាល ខេត្ត បាន យក គ្រាប់ ពូជ ត្នោត នេះ មក ដាំ តាម បណ្តោយ សង្ខាង ផ្លូវ ទាំង នេះ ពេល វា ធំ ឡើង អាច ចូលរួម ទាក់ទាញ ភ្ញៀវ ទេសចរណ៍ មក កម្សាន្ត នៅ ទីនេះ នេះ ជា មោទនភាព ខ្ពស់ របស់ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ និង មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ទាំងអស់ ដែល បាន រួបរួម គ្នា កសាង ការពារ និង អភិវឌ្ឍន៍ នៅក្នុង តំបន់ នេះ ។
លោក ផាន់ យុត អភិបាល ស្រុក សៀម ប៉ាង បាន បង្ហាញ ក្ដីសប្បាយរីករាយ ដែល រដ្ឋបាល ខេត្ត ដឹកនាំ ដោយ លោក អភិបាល ខេត្ត ស្ទឹងត្រែង ដែល បាន នាំយក គ្រាប់ ពូជ ត្នោត មក ដាំ នៅ មូលដ្ឋាន ស្រុក សៀម ប៉ាង ហើយ លោក ក៏ បាន ដឹកនាំ មន្ត្រីរាជការ ក្នុង រដ្ឋបាល សាលា ស្រុក ទាំងអស់ ចូលរួម យ៉ាង ក្ដីរីករាយ ។
លោក អ៊ុក ធាវី ប្រធាន មន្ទីរព័ត៌មាន ខេត្ត ស្ទឹងត្រែង បាន ថ្លែង ថា លោក ក៏ បាន ដឹកនាំ មន្ត្រីរាជការ ក្នុង មន្ទីរព័ត៌មាន ទាំងអស់ មក ចូលរួម ក្នុង កម្មវិធី នេះ ដែរ ហើយ លោក បន្ត ទៀត ថា នេះ ជា លើក ទី៣ ហើយ ដែល លោក អភិបាល ខេត្ត បាន នាំ គ្រាប់ ពូជ ត្នោត មក ដាំ នៅ តាម បន្ទាត់ ព្រំដែន នេះ ។
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ប្រកាស ហើយ ពី ភាពអព្យាក្រិត្យ ចំពោះ ទំនាក់ទំនង អន្តរជាតិ របស់ ខ្លួន និង ធ្វើ ទំនាក់ទំនង ដោយ ស្មើភាព សម្រាប់ ប្រទេស ជា មិត្ត ទាំងអស់ ។
បើ ទោះបី រាជ រដ្ឋាភិបាល បង្ហាញ ពី នយោបាយ ទំនាក់ទំនង អន្តរជាតិ របស់ ខ្លួន យ៉ាង នេះ ក្តី តែ គេ បាន មើលឃើញ ថា ការធ្វើ ទំនាក់ទំនង ជាមួយ ប្រទេស មហា អំណាច ផ្នែក សេដ្ឋកិច្ច លើក លោក អាមេរិក និង ចិន គឺ កម្ពុជា មាន ទំនាក់ទំនង ស្អិត ល្មួត ជាមួយ ចិន ជាង សហរដ្ឋ អាមេរិក ។ ព្រោះតែ បែប នេះ នាំឱ្យ មាន ទស្សនៈ មួយចំនួន ថា ការ ដែល កម្ពុជា ស្និទ្ធស្នាល ជាមួយ ចិន មិន មាន ផលចំណេញ ដូច ការធ្វើ ទំនាក់ទំនង ជាមួយ សហរដ្ឋ អាមេរិក នោះ ឡើយ ។
ក្នុង កិច្ចពិភាក្សា ស្តី ការប្រឈម ដាក់ គ្នា ផ្នែក ភូមិសាស្ត្រ នយោបាយ រវាង ចិន និង អាមេរិក ដែល រៀបចំ ដោយ រាជ បណ្ឌិត្យ សភា កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២០ ក្រុម អ្នកជំនាញ ផ្នែក ប្រវត្តិសាស្ត្រ និង ភូមិសាស្ត្រ នយោបាយ ផងដែរ បាន រួមគ្នា ឆ្លើយតប ចំពោះ ទស្សនៈ ខាងលើ នេះ ។
ក្រុម អ្នកជំនាញ ជាប្រវត្តិសាស្ត្រ និង ភូមិសាស្ត្រ នយោបាយ គេ បាន មើលឃើញ ថា រាជ រដ្ឋាភិបាល កម្ពុជា មិន បាន មាន ទំនោរ ខ្លាំង ទៅ ប្រទេស ណាមួយ នោះ ឡើយ តែ កម្ពុជា ក៏ ត្រូវ មើលឃើញ ពី ភាពចំណេញ ផ្នែក សេដ្ឋកិច្ច របស់ ខ្លួន ផងដែរ ។ មាន ន័យ ថា ប្រទេស ណា ដែល ផ្តល់ ប្រយោជន៍ សម្រាប់ កម្ពុជា កម្ពុជា ក៏ ផ្តល់ ទំនាក់ទំនង ល្អ ជាមួយ ប្រទេស ជា មិត្ត ដូចគ្នា ។
ក្រុម អ្នកជំនាញ ដែល មាន លោក បណ្ឌិត សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា . លោក បណ្ឌិត គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា . លោក ពុយ គា អ្នកឆ្លើយឆ្លង ព័ត៌មាន ឱ្យ ទីភ្នាក់ងារ ព័ត៌មាន Kyodo និង លោក បណ្ឌិត ឌៀប សុផល សាស្ត្រាចារ្យ ប្រវត្តិសាស្ត្រ និង ទំនាក់ទំនង អន្តរជាតិ បាន មើលឃើញ ថា ចិន បាន ផ្តល់ ប្រយោជន៍ ច្រើន សម្រាប់ ផ្នែក សេដ្ឋកិច្ច នៅ កម្ពុជា ទើប ធ្វើឱ្យ កម្ពុជា និង ចិន មាន ទំនាក់ទំនង ។
អ្នកជំនាញ ទាំងនេះ ក៏ បាន លើកឡើង ដែរ ថា ប្រសិនបើ អាមេរិក ចង់ មាន ទំនាក់ទំនង ល្អ ជាមួយ កម្ពុជា ក៏ ត្រូវតែ ពិនិត្យ ឡើងវិញ នូវ ការធ្វើ ទំនាក់ទំនង របស់ ខ្លួន ជាមួយ ផងដែរ ។ ក្រុម អ្នកជំនាញ បាន លើកឡើង ថា ចង់បាន ទំនាក់ទំនង ល្អ មិន ត្រូវ និយាយ តែ រឿង លទ្ធិ ប្រជាធិបតេយ្យ សិទ្ធិ មនុស្ស ដោយ មិន គិត ពី ការធ្វើ នយោបាយ ផ្នែក សេដ្ឋកិច្ច នោះ ឡើយ ។
យោង តាម ទិន្នន័យ ពី ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា (CDC) ការវិនិយោគ រវាង ចិន និង អាមេរិក នៅ កម្ពុជា មាន ទំហំ ទឹកប្រាក់ ខុសគ្នា ច្រើន ពោល ចិន ឈរ នៅ លំដាប់ កំពូល សម្រាប់ ការវិនិយោគ នៅ កម្ពុជា ។
របាយការណ៍ បង្ហាញ ថា គិត ចាប់ពី ឆ្នាំ ១៩៩៤ ដល់ ខែមករា ឆ្នាំ ២០១៩ ការវិនិយោគ ចិន នៅ កម្ពុជា មាន ចំនួន ២៣ ពាន់ លាន ដុល្លារ អាមេរិក ។ រីឯ ការនិយោគ អាមេរិក នៅ កម្ពុជា វិញ មាន ត្រឹមតែ ជាង ៩៣៦ លាន ដុល្លារ អាមេរិក ប៉ុណ្ណោះ ។
ខាងក្រោម ជា វីដេអូ បង្ហាញ ទស្សនៈ របស់ អ្នកជំនាញ ទំនាក់ទំនង រវាង កម្ពុជា ជាមួយ ចិន និង អាមេរិក៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន សូម ចូលរួម រំលែក ទុក្ខ ជាមួយ ក្រុមគ្រួសារ ទាំងអស់ នៃ សព ឧត្ដមសេនីយ៍ ទោ ស សាវី កងទ័ព មួក ខៀវ កម្ពុជា ដែល បាន ស្លាប់ បាត់បង់ជីវិត នៅ ប្រទេស ម៉ាលី
( ភ្នំពេញ ) ៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា និង សហការី ទាំងអស់ នៃ កាកបាទ ក្រហម កម្ពុជា សូម សម្ដែង នូវ ការសោកស្ដាយ និង សូម ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ ជាមួយនឹង ក្រុមគ្រួសារ ទាំងអស់ នៃ សព លោក ឧត្ដមសេនីយ៍ ទោ ស សាវី កងទ័ព មួក ខៀវ កម្ពុជា ដែល បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ ជំងឺ កូវីដ១៩ កាលពី ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ក្នុង ពេល ដែល កំពុង បំពេញ បេសកកម្ម មនុស្សធម៌ ក្រោម ស្លាក អង្គការ សហ ប្រជាជាតិ នៅ ប្រទេស ម៉ាលី ។
ស្ថិត ក្នុង សមាន ទុក្ខ ដ៏ សែន ក្រៀមក្រំ បំផុត នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ សព លោក ឧត្ដមសេនីយ៍ ទោ ស សាវី សូម បាន ទៅ ចាប់កំណើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
លោក ប៉ាន សូរស័ក្តិ៖ រាជ រដ្ឋាភិបាល នឹង ធ្វើឱ្យ សូត្រ ខ្មែរ មាន ភាពរស់រវើក ឡើងវិញ
( សៀមរាប ) ៖ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន អះអាង ថា រាជ រដ្ឋាភិបាល កម្ពុជា នឹង ធ្វើឱ្យ វិស័យ សូត្រ ខ្មែរ មាន ភាពរស់រវើក ឡើងវិញ និង មាន គោលបំណង ធ្វើឱ្យ ការចិញ្ចឹម កូន នាង ស្រាវ យក សូត្រ មាន ភាពទំនើប ទាន់សម័យ និង ប្រកបដោយ ចីរភាព ផងដែរ ។
លោក រដ្ឋមន្ត្រី បាន បន្ថែម ទៀត ថា ដើម្បី លើកកម្ពស់ និង អភិវឌ្ឍន៍ វិស័យ សូត្រ ខ្មែរ គម្រោង ជំរុញ ទីផ្សារ សម្រាប់ កសិកម្ម ខ្នាត តូច គឺជា ចំណុច ចាប់ផ្ដើម ដំបូង នៃ ភាពជាដៃគូរ វាង វិស័យ ឯកជន និង សាធារណៈ ទៅ លើ អាជីវកម្ម សូត្រ ឈាន មុខ ក្នុង ការបង្កើត គ្រោងការណ៍ កសិកម្ម តាម កិច្ចសន្យា ដើម្បី ផលិត សូត្រ ឆៅ សម្រាប់ ប្រតិបត្តិការ របស់ ពួកគាត់ ។
ភាព ជាដៃគូរ វាង វិស័យ ឯកជន - សាធារណៈ ទាំងនេះ ក៏ មាន ការរៀបចំ ការផ្គត់ផ្គង់ សំបុក កូន នាង ដែល មាន គុណភាពល្អ ប្រសើរ ជាង មុន និង ជំរុញ ការដាំ ដើម មន មាន គុណភាព តាមរយៈ ការដាំដុះ ដោយ ឯកជន ។ តាមរយៈ សកម្មភាព ទាំងនេះ គម្រោង ត្រូវបាន រំពឹង ថា កសិករ នឹង មាន ការកើនឡើង នូវ ប្រាក់ ចំណេញ ពី ការផលិត សូត្រ ឆៅ ខ្នាត តូច និង ផ្គត់ផ្គង់ សូត្រ ឆៅ សម្រាប់ ត្បាញ និង រចនា ជា ផលិតផល សូត្រ សម្រេច ។
សូម បញ្ជាក់ ថា គម្រោង ជំរុញ ទីផ្សារ សម្រាប់ កសិកម្ម ខ្នាត តូច គឺជា គម្រោង រួមគ្នា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង មូលនិធិ អន្តរជាតិ សម្រាប់ អភិវឌ្ឍន៍ កសិកម្ម (IFAD) ។ គម្រោង ដឹកនាំ ប្រតិបត្តិ ដោយ ក្រសួង ពាណិជ្ជកម្ម និង មាន គោលដៅ លើកស្ទួយ វិបុលភាព កសិករ ខ្នាត តូច កម្ពុជា តាមរយៈ បង្កើន ផលចំណេញ កាន់តែ ច្រើន ដោយ តភ្ជាប់ កសិ- ពាណិជ្ជកម្ម និង ទីផ្សារ ៕
កម្លាំង នគរបាល បង្រ្កាប ជនសង្ស័យ និង ដកហូត ថ្នាំ ញៀន ជិត កន្លះ គីឡូ នៅ ខណ្ឌ មានជ័យ
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល ខណ្ឌ មានជ័យ បាន បង្រ្កាប ជនសង្ស័យ ម្នាក់ និង ដកហូត គ្រឿងញៀន បាន ជិត កន្លះ គីឡូ នា ព្រឹក ថ្ងៃទី ៣០ ខែឧសភា ឆ្នាំ ២០២០ នៅ ផ្ទះ គ្មាន លេខ ផ្លូវ លំ ស្ថិត នៅ ភូមិ ព្រែក តា គង់២ សង្កាត់ ចាក់អង្រែលើ ខណ្ឌ មានជ័យ ។
លោក អ៊ុ រតនា នាយ ប៉ុស្តិ៍ នគរបាល ចាក់អង្រែលើ ខណ្ឌ មានជ័យ បាន ឲ្យដឹង ថា នៅ វេលា ម៉ោង ១៖៣០ នាទី រំ លង អាធ្រាត្រ ឈានចូល ថ្ងៃទី ៣០ ខែឧសភា ឆ្នាំ ២០២០ កម្លាំង នគរបាល ប៉ុស្តិ៍ ល្បាត ដើម្បី បង្ការ បទល្មើស ក្នុង មូលដ្ឋាន ក្រោយមក ប្រទះឃើញ ស្រ្តី ជនសង្ស័យ ឈ្មោះ ផែង សុខ ខី ភេទ ស្រី អាយុ ២៤ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ អ្នក បោស សំអាត ផ្ទះ ស្នាក់ នៅ ផ្ទះ ជួល ភូមិ ព្រែក តា គង់៣ សង្កាត់ ចាក់អង្រែលើ ខណ្ឌ មានជ័យ និង ជា មុខសញ្ញា ជួញដូរ ។
ក្រោយ ការចាប់ខ្លួន កម្លាំង នគរបាល ប៉ុស្តិ៍ បាន រកឃើញ ថ្នាំញៀន ៣កញ្ចប់ ធំ នៅលើ ដៃ ស្រ្តី ជនសង្ស័យ រួចហើយ នាំមក នគរបាល ប៉ុស្តិ៍ ដើម្បី សាកសួរ នាំ ។
នគរបាល បន្ត ថា នៅ ថ្ងៃ ដដែល នេះ លោក ម៉េង វិមាន តារា អធិការ នគរបាល ខណ្ឌ មានជ័យ បាន ដឹកនាំ ចុះ ទៅ ឆែកឆេរ ផ្ទះ ស្រ្តី ជនសង្ស័យ បន្ត ទៀត សហការ ជាមួយ មេភូមិ និង លោក ចៅសង្កាត់ ដោយ បាន ដកហូត វត្ថុតាង មួយចំនួន ផងដែរ ។
នគរបាល ស្រុក ដង ទង់ បាន ឱ្យដឹង ថា កម្មករ ២នាក់ ដែល ធ្វើការ ក្នុង ក្រុមហ៊ុន ផលិត ស៊ីម៉ងត៍ ភ្នំ ល្អាង ( រោងចក្រ ថៃ ប៊ុន រុង ) បាន ស្លាប់ ក្រោម បំណែក ថ្ម យ៉ាង អាណោច អាធ័ម ខណៈ កម្មករ ជា ជនរងគ្រោះ ទាំង ពីរ នាក់ បាន ឡើង ទៅ បំផ្ទុះ យក ថ្ម ភ្នំ សម្រាប់ ផលិត ស៊ីម៉ងត៍ ក្នុង រោងចក្រ ។
សមត្ថកិច្ច ដដែល បាន បញ្ជាក់ ថា ជនរងគ្រោះ ដែល ស្លាប់ ទាំង ពីរ នាក់ រួម មាន៖
ជនរងគ្រោះ ទាំង ពីរ នាក់ រស់ នៅក្នុង ភូមិ ដំណាក់ ត្រា ច ឃុំ កណ្តោល ស្រុក ទឹក ឈូ ខេត្ត កំពត ។ ជនរងគ្រោះ ទាំង ពីរ នាក់ នេះ ធ្វើការ នៅ ក្រុមហ៊ុន ផលិត សុី ម៉ងត៍ ថៃ ប៊ុន រុង ដែល មាន ទីតាំង ស្ថិត ក្នុង ភូមិ ល្អាង ឃុំ ល្អាង ស្រុក ដង ទង់ ខេត្ត កំពត ។ បច្ចុប្បន្ន សាកសព ជនរងគ្រោះ ទាំង ពីរ នាក់ ត្រូវបាន កាយ រកឃើញ ហើយ ប្រគល់ ជូន ក្រុមគ្រួសារ ដើម្បី ចាត់ចែង ធ្វើ បុណ្យ តាម ប្រពៃណី ។
ដោយឡែក ក្រុមហ៊ុន ថៃ ប៊ុន រុង បាន សង សំណង ទៅ លើ សាកសព ក្នុង ម្នាក់ ៣៥.០០០ ដុល្លារ និង ថវិកា ចូលរួម បុណ្យ សព ម្នាក់ ៤.០០០.០០០ រៀល ផងដែរ ៕ GMAC អំពាវនាវ ឲ្យ បណ្ដាល រោងចក្រ កាត់ដេរ អនុវត្ដ ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ គោលការណ៍ បង្ការ ការពារ ជំងឺ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា (GMAC) បាន ចេញ លិខិត អំពាវនាវ ជូន ចំពោះ អ្នកគ្រប់គ្រង រោងចក្រ ទាំងអស់ ដែល កំពុង បើក ដំណើរការ នៅក្នុង ប្រទេស កម្ពុជា អនុវត្ដ ឲ្យបាន ខ្ជាប់ខ្ជាន នូវ គោលការណ៍ ណែនាំ របស់ ក្រសួង សុខាភិបាល អំពី ការបង្ការ ការពារ ជំងឺ កូវ ដី - ១៩ ។
ខាងក្រោម នេះ ជា លិខិត របស់ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖
អគ្គ លេខាធិការ របស់ អង្គការ សហ ប្រជាជាតិ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ជា អកុសល . ខ្ញុំ សូម ជម្រាប ថា សហសេវិក យោធា របស់ យើង ពីរ នាក់ បាន ទទួលមរណភាព ដោយសារតែ ជំងឺ កូវីដ១៩ ( ម្នាក់ មកពី ប្រទេស កម្ពុជា និង ម្នាក់ ទៀត មកពី ប្រទេស អេល សាវ៉ាឌ័រ ) ។ ឥលូវនេះ . ដើម្បី គោរព ដល់ ការលះបង់ ដែល ជា មហា កិត្តិយស របស់ អ្នក ទាំងនោះ ពេល បំពេញ កាតព្វកិច្ច រក្សា សន្តិភាព ខ្ញុំ សូម ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ចំពោះ ក្រុមគ្រួសារ របស់ ពួកគេ » ។
លោក បន្ថែម ថា គិត មកដល់ ពេលនេះ យ៉ាងហោចណាស់ មាន ស្ត្រី និង បុរស ជាង ៣. ៩០០ នាក់ ដែល បាន បាត់បង់ជីវិត តាំងពី ឆ្នាំ ១៩៤៨ ពេល កំពុង បម្រើ ការងារ រក្សា សន្តិភាព នៅក្រោម ឆ័ត្រ របស់ អង្គការ សហ ប្រជាជាតិ ។ យោង តាម នាយកដ្ឋាន រក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ មាន កងទ័ព មួក ខៀវ ចំនួន ១៧៣ នាក់ បាន ឆ្លង ជំងឺ កូវីដ១៩ ។
សូម បញ្ជាក់ ថា លោក ឧត្តមសេនីយ៍ ទោ ស សាវី ជា ទាហាន មួក ខៀវ កម្ពុជា ដែល បាន ទៅ បំពេញ បេសកកម្ម មនុស្សធម៌ ក្រោម ឆ័ត្រ អង្គការ សហ ប្រជាជាតិ បាន ស្លាប់ នៅក្នុង មន្ទីរពេទ្យ ក្នុង ប្រទេស ម៉ាលី កាលពី ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២០ ម្សិលមិញ បន្ទាប់ពី ឆ្លង ជំងឺ កូវីដ១៩ ៕
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន រំលែក ទុក្ខ ចំពោះ ការស្លាប់ របស់ កងទ័ព មួក ខៀវ របស់ ខ្មែរ នៅ ប្រទេស ម៉ាលី ដោយសារ ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ នៅ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ចូលរួម រំលែក និង សោកស្តាយ ចំពោះ កងទ័ព មួក ខៀវ កម្ពុជា ដែល បាន ទទួលមរណភាព នៅ ប្រទេស ម៉ាលី ដោយសារ ជំងឺ កូវីដ១៩ ។
កងទ័ព មួក ខៀវ កម្ពុជា មួយ រូប គឺ លោក ឧត្តមសេនីយ៍ ទោ ស សាវី បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ ជំងឺ កូវីដ១៩ ពេល លោក កំពុង បំពេញ បេសកកម្ម មនុស្សធម៌ ក្រោម ស្លាក អង្គការ សហ ប្រជាជាតិ នៅ ប្រទេស ម៉ាលី កាលពី ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២០ ម្សិលមិញ ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន ចាត់ទុក ការបាត់បង់ជីវិត របស់ យុទ្ធជន ខ្មែរ នៅ បរទេស នេះ ជា ការលះបង់ ដ៏ ធំធេង មិន អាច កាត់ថ្លៃ បាន ចំពោះ ជាតិ មាតុភូមិ ជាពិសេស កិច្ច មនុស្សធម៌ ក្រោម ឆត្រ អង្គការ សហ ប្រជាជាតិ ។
កាលពី ពេល ថ្មី ៗ នេះ មាន កងកម្លាំង យោធា មួក ខៀវ កម្ពុជា ៧នាក់ ដែល បំពេញ បេសកកម្ម នៅ ប្រទេស ម៉ាលី បាន ឆ្លង ជំងឺ កូវីដ១៩ ។ ក្នុង នោះ ស្លាប់ ១នាក់ ជាសះស្បើយ ២នាក់ និង ៤នាក់ ផ្សេង ទៀត កំពុង ព្យាបាល ៕
ដោយ សង្កេតឃើញ បែប នេះ លេខាធិការដ្ឋាន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា បាន ធ្វើ ការផ្សព្វផ្សាយ ឡើងវិញ នូវ សេចក្ដីសម្រេច ស្ដីពី ក្រមសីលធម៌ សម្រាប់ បុគ្គល កៀរ គរ និង ប្រមូល ឬ ទទួល វិភាគទាន បរិច្ចាគ សប្បុរសធម៌ សម្រាប់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដែល កំណត់ អំពី យន្តការ និង វិធានការ ចំពោះ បុគ្គល កៀរ គរ និង ប្រមូល អំណោយ ឬ បុគ្គល ទទួល វិភាគទាន សប្បុរស ធម៌ ទាំងនោះ ។
ជាមួយគ្នា នេះ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា សូម លើកទឹកចិត្ត ដល់ បុគ្គល ឬ ក្រុម បុគ្គល ទាំងអស់ ដែល មាន បំណង ចូលរួម កៀរគរ មូលនិធិ សប្បុរសធម៌ សូម ធ្វើ ការទំនាក់ទំនង មក លេខាធិការដ្ឋាន របស់ មូលនិធិ ដែល មាន ទីតាំង នៅ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដើម្បី ពិភាក្សា និង ទទួលបាន សម្បទា ក្នុង ការកៀរគរ នូវ មូលនិធិ សប្បុរសធម៌ ដើម្បី គាំទ្រ ដល់ កិច្ច ដំណើរការ របស់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ។
លេខាធិការដ្ឋាន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា សូម បញ្ជាក់ ជូន ថា រហូតមកដល់ ពេលនេះ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា មិន ទាន់ បាន អនុញ្ញាត ជា ផ្លូវការ ដល់ បុគ្គល ឬ ក្រុម ណា មួយ ដែល មាន បំណង ចូលរួម កៀរគរ នូវ មូលនិធិ សប្បុរសធម៌ សម្រាប់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា នៅឡើយ ទេ ក្រៅពី ធនាគារ និង គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ចំនួន ៧ ដែល ជា ដៃគូ ៕ ព្រះអាទិត្យ ទើប ជះ អណ្តាត ភ្លើង ដ៏ ធំ ចេញ ពី ស្រទាប់ កូរ៉ូណា ដែល មិន ធ្លាប់ មាន តាំងពី ឆ្នាំ ២០១៧
( កំពង់ស្ពឺ ) ៖ ក្រោម បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស បន្ថែម លើ កិច្ចការងារ ស្នូល បង្ការ បង្ក្រាប សង្គ្រោះ និង ដោយសារតែ បញ្ហា វិបត្តិ ជា សកល នៃ ជំងឺ រាតត្បាត កូវីដ - ១៩ អង្គភាព រាជធានី / ខេត្ត ត្រូវតែ បង្កើន ការងារ ដាំដុះ និង ចញ្ចឹម សត្វ គ្រប់ ប្រភេទ ក្នុង នោះ រាប់ ទាំង បុគ្គល ផ្ទាល់ ម្នាក់ ៗ តាម ផ្ទះ ផងដែរ ។
ជាក់ស្តែង អនុវត្ត នៅ បទបញ្ជា របស់ លោក នាយ ឧត្តមសេនីយ៍ សៅ សុខា អង្គភាព កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ និង អង្គភាព ចំណុះ បាន នាំគ្នា ស ស្រាក់សស្រាំង លើ ការងារ បង្កបង្កើន ផល និង ដាំដុះ ចញ្ចឹម សត្វ គ្រប ៗ អង្គភាព ។
លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ បាន ឱ្យដឹង ថា ក្រៅពី ការងារ ស្នូល បំពេញ តួនាទី ការពារ ថែរក្សា សណ្តាប់ធ្នាប់ សន្តិសុខ សាធារណៈ ជូន ពលរដ្ឋ អង្គភាព និង អង្គភាព ចំណុះ បាន ខិតខំ នាំគ្នា ដាំដុះ ចញ្ចឹម សត្វ ដើម្បី តម្រូវ ការចាំបាច់ ក្នុង ការរស់នៅ ប្រចាំ ថ្ងៃ ហើយ អង្គភាព បាន ជំរុញ បន្ថែម ដល់ បុគ្គល ជា សមាជិក អាវុធហត្ថ ឱ្យ ខិតខំ ការងារ ដាំ បន្លែ បង្កា នៅ តាម ផ្ទះ រៀង ៗ ខ្លួន ដើម្បី ផ្គត់ផ្គង់ ដល់ គ្រួសារ ។
លោក ឧត្តមសេនីយ៍ ត្រី មេបញ្ជាការ បាន បញ្ជាក់ ថា មិន ត្រឹមតែ ដាំ ដំណាំ បង្កបង្កើន ផល ចញ្ចឹម សត្វ ដើម្បី ជីវភាព របស់ អង្គភាព និង បុគ្គល នោះ ទេ អង្គភាព និង ចាត់ បញ្ជូន ក្រុមការងារ ត្រួតពិនិត្យ វាយតម្លៃ សម្រាប់ កិច្ចការងារ ខាងលើ ដោយ ផ្តល់ នៅ លិខិត ស សើរ ទាំង បុគ្គល និង អង្គភាព នីមួយ ៗ ផងដែរ ។
នៅ ថ្ងៃ នេះ ដែរ អង្គភាព បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ នា ថ្ងៃទី ៣០ ខែឧសភា ឆ្នាំ ២០២០ បាន ដឹកនាំ កម្លាំង ប្រមូល ផល ជាក់ស្តែង ក្នុង នោះ ដក ត្រកួន ចំនួន ៤រង ស្មើនឹង ៧០ គីឡូក្រាម ស្ពៃ ចំនួន ៤រង ស្មើនឹង ១០គីឡូក្រាម ចញ្ចឹម មាន់ ទាំង ថ្មី និង ចាស់ បាន ៥៤ ក្បាល ក្នុង នោះ ត្រៀម ដាំ បន្លែ គ្រប់ ប្រភេទ ចំនួន ១០ រង បន្ថែម ទៀង ផងដែរ ៕
អំណោយ សម្តេច ស ខេង ត្រូវ ចែកជូន ពលរដ្ឋ ក្រីក្រ ៨៦ គ្រួសារ នៅ ស្រុក ឯក ភ្នំ . អភិបាល ខេត្ត អំពាវនាវ ពលរដ្ឋ កុំ ដាក់ មង បណរ៉ាវ ក្រឡាញឹក ក្នុង ទន្លេ សាប ដើម្បី រក្សា ពូជ ត្រី កុំ ឱ្យ ផុត ពូជ
( បាត់ដំបង ) ៖ លោក សេង យូអ៊ាន់ សមាជិក គណៈកម្មាធិការ កណ្តាល បក្ស និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ ជួយ ស្រុក ឯក ភ្នំ និង លោក ងួន រតនៈ សមាជិក គណៈកម្មាធិការ កណ្តាល បក្ស ជា ប្រធាន ប្រធាន គណបក្ស ខេត្ត នា ព្រឹក ថ្ងៃទី ៣០ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន នាំ អំណោយ សម្តេច ក្រឡាហោម ស ខេង យក ទៅ ចែកជូន ពលរដ្ឋ ក្រីក្រ ៨៦ គ្រួសារ នៅ ភូមិ អន្លង់ តា អួរ ឃុំ កោះ ជីវាំង ស្រុក ឯក ភ្នំ ខេត្ត បាត់ដំបង ។
លោក ងួន រតនៈ បាន ពាំនាំ ប្រសាសន៍ ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ របស់ សម្តេច ក្រឡាហោម ស ខេង ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង ឃុំ លើ បឹង ទន្លេ សាប ទាំងអស់ ថា លោក សូម ថ្លែងអំណរគុណ ដល់ បងប្អូន ដែល បាន គាំទ្រ គណបក្ស ប្រជាជន កន្លងមក ដើម្បី ទុក ឱកាស ឱ្យ គណបក្ស បន្ត ដឹកនាំ កសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ត ទៅ ។
លោក ងួន រតនៈ ក៏ បាន អំពាវនាវ ដល់ បងប្អូន ដែល រស់ នៅ លើកទឹក ប្រកបរបរ នេសាទ លក្ខណៈ គ្រួសារ ដើម្បី ចិញ្ចឹម ជីវិត នោះ សូម កុំ ឱ្យ មាន ដាក់ មង បណរ៉ាវ ក្រឡាញឹក ដាក់ ញឹក ឱ្យ សោះ ព្រោះ វា ធ្វើឱ្យ រី ផុត ពូជ នា រដូវ ត្រី ពង ចំរដូវ ខែ បិទ នេសាទ ផងដែរ ។
លោក សេង យូអ៊ាន់ បាន ថ្លែង ថា រាល់ បញ្ហា សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ លោក នឹង ក្រុមការងារ តែងតែ បាន ដោះស្រាយ តាម សំណូមពរ ជូន ជាប្រចាំ កន្លងមក ជាក់ស្តែង ថ្ងៃ នេះ ក្រុមការងារ រួម ប្រធានបក្ស ខេត្ត បាន នាំ អំណោយ របស់ សម្តេច ក្រឡាហោម ស ខេង យកមក ចែកជូន ក្នុង ១គ្រួសារ បាន ទទួល អង្ករ ២៥ គីឡូក្រាម . ភេសជ្ជៈ ២កេស . សូឡា ១ឈុត . មី ១កែស. ទឹកត្រី ស៊ីវ អ៊ីវ ៤យួរ . សៀង ផ្អែម ៥គីឡូក្រាម . ត្រីខ១យួ និង ជូន បន្ថែម ដល់ ប្រជាការពារ ចំនួន ១០នាក់ បាន ដូចគ្នា ផងដែរ ៕
ក្រុមប្រឹក្សា ខណ្ឌ ឫស្សីកែវ សម្រេច ពិនិត្យ និង អនុម័ត របៀបវារៈ ចំនួន ៩ សំខាន់ ៗ ដើម្បី បន្ត ជំរុញ អនុវត្ត ឲ្យ មាន ប្រសិទ្ធភាព
( ភ្នំពេញ ) ៖ នៅក្នុង កិច្ចប្រជុំ សាមញ្ញ លើក ទី ១២ អាណត្តិ ទី៣ របស់ ក្រុមប្រឹក្សា ខណ្ឌ ឫស្សីកែវ នា ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២០ បាន សម្រេច ពិនិត្យ និង អនុម័ត នូវ វិធានការ សំខាន់ ៗ ដែល ផ្ដោត ជា របៀវារៈ ចំនួន ៩ ដើម្បី បន្ត ជម្រុញ អនុវត្ត ឲ្យ មាន ប្រសិទ្ធភាព ។
កិច្ចប្រជុំ សាមញ្ញ លើក ទី ១២ អាណត្តិ ទី៣ របស់ ក្រុមប្រឹក្សា ខណ្ឌ ឫស្សីកែវ ដែល ផ្តោត លើ របៀបវារៈសំខាន់ ៗ ចំនួន ៩មាន ដូច ជា៖
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង អនុ រដ្ឋលេខាធិការ និង ទីប្រឹក្សា ក្រសួង មុខងារ សាធារណៈ ចំនួន ៣រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តម្លើង និង តែងតាំង មុខ ដំណែង លោក ហង្ស ឆាំ ឆាន ពី អនុ រដ្ឋលេខាធិការ មក ជា រដ្ឋលេខាធិការ នៃ ក្រសួង មុខងារ សាធារណៈ និង តែងតាំង មុខ តំណែង លោក ពេជ្រ វិជ្ជា គន្ធី ជា អនុ រដ្ឋលេខាធិការ ។
គួរ ជម្រាប ថា រដ្ឋាភិបាល អាមេរិក របស់ លោក ប្រធានាធិបតី ដូណាល់ ត្រាំ កាលពី ថ្ងៃទី ២៧ ខែឧសភា កន្លងទៅ នេះ បាន សម្រេច ដកហូត « ឋានៈ ពិសេស » របស់ ទីក្រុង ហុងកុង ចេញ ពី បញ្ជី ក្រោម ច្បាប់ របស់ ខ្លួន ។ ការសម្រេច នេះ មាន ន័យ ថា ទីក្រុង ហុងកុង លែង បន្ត ទទួលបាន ប្រព្រឹត្តកម្ម ពិសេស ក្រោម ច្បាប់ សហរដ្ឋ អាមេរិក តទៅទៀត ហើយ ដោយ ទីក្រុង មួយ នេះ អាចនឹង បាត់បង់ សិទ្ធិ ពិសេស ក្នុង ការធ្វើ ពាណិជ្ជកម្ម ជាមួយ សហរដ្ឋ អាមេរិក ដែល ជា ប្រទេស សេដ្ឋកិច្ច លេខ ១ លើ ពិភពលោក ។
ការដកហូត ឋានៈ ខាងលើ ធ្វើឡើង ក្រោយ សហរដ្ឋ អាមេរិក បាន ចោទ ទីក្រុង ប៉េកាំង ថា បាន ជាន់ ឈ្លី ស្វយ័ត ភាព របស់ ទីក្រុង មជ្ឈមណ្ឌល ហិរញ្ញវត្ថុ ពិភពលោក មួយ នេះ បន្ទាប់ ទីក្រុង ប៉េកាំង បោះជំហាន ទៅ រក ការអនុម័ត ច្បាប់ សន្តិសុខ ជាតិ ថ្មី ដើម្បី អនុវត្ត លើ ទីក្រុង ហុងកុង ដែល ត្រូវបាន លោក រដ្ឋាភិបាល ដូណាល់ ត្រាំ មើលឃើញ ថា ជា ការសម្លាប់ សិទ្ធិ សេរីភាព របស់ ហុងកុង ៕
ប្រតិភូ ក្រសួង ផែនការ អញ្ជើញ ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ជូន ដល់ កងកម្លាំង នគរបាល ជាតិ ដែល កំពុង ឈរជើង ការពារ ព្រំដែន កម្ពុជា - ថៃ នៅ ស្រុក សំឡូត ខេត្ត បាត់ដំបង
( បាត់ដំបង )៖ គណៈប្រតិភូ ក្រសួង ផែនការ ដឹកនាំ ដោយ លោក ហ៊ូ តាំង អេង រដ្ឋលេខាធិការ តំណាង លោក កិត្តិ សេដ្ឋា បណ្ឌិត ឆាយ ថន ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ផែនការ នៅ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ជូន ដល់ កងកម្លាំង នគរបាល ជាតិ សម្ព័ន្ធ មេត្រីភាព វរៈ សេនា តូច លេខ ៣១០ និង លេខ ៨២៣ ដែល កំពុង ឈរជើង ការពារ ព្រំដែន កម្ពុជា - ថៃ ស្ថិត នៅ ស្រុក សំឡូត ខេត្ត បាត់ដំបង ។
ក្នុង ឱកាស សំណេះសំណាល លោក រដ្ឋលេខាធិការ បាន នាំ ជូន នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ លោក កិត្តិ សេដ្ឋា បណ្ឌិត ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ផែនការ ជូន ចំពោះ បងប្អូន កងកម្លាំង កំពុង ឈរជើង ទាំងអស់ ។ ជំនួស មុខ លោក កិត្តិ សេដ្ឋា បណ្ឌិត ទេសរដ្ឋមន្ត្រី . លោក ហ៊ូ តាំង អេង ក៏ បាន ជម្រាប ជូន ពី សភាពការណ៍ បច្ចុប្បន្ន ទាំង ក្នុង ប្រទេស និង លើ សកលលោក ផងដែរ ។
គណៈប្រតិភូ បាន នាំមក ជូន នូវ អំណោយ មាន ដូចជា សាច់ក្រក ម៉ី និង ថវិកា មួយ ចំនួន ដែល ជា ទឹកចិត្ត ដ៏ ថ្លៃថ្លា របស់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ក្រសួង ផែនការ ទាំងមូល ជូន ដល់ កងកម្លាំង យើង សម្រាប់ ប្រើប្រាស់ ក្នុង គ្រា ដែល កំពុង ទទួលរង នូវ ផល ប៉ះពាល់ នៃ ការរីករាលដាល ជា សកល ជំងឺ កូវីដ - ១៩ ។
លោក ហ៊ូ តាំង អេង រដ្ឋលេខាធិការ ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ និង បាន ជូន ពរ ចំពោះ បងប្អូន កងកម្លាំង រួម និង ក្រុមគ្រួសារ ទាំងអស់ សូម មាន សុខភាព ល្អ និង ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល យើង ការពារ ឲ្យបាន នូវ សន្តិភាព ដើម្បី ភាពរុងរឿង ការអភិវឌ្ឍ និង ភាពសុខសាន្ត របស់ ប្រជាពលរដ្ឋ និង សង្គមជាតិ យើង ទាំងមូល ៕ UNDP ថ្លែង សារ រំលែក ទុក្ខ ចំពោះ ការស្លាប់ របស់ កងទ័ព មួក ខៀវ របស់ ខ្មែរ នៅ ប្រទេស ម៉ាលី ដោយសារ ជំងឺ កូវីដ១៩
សូម បញ្ជាក់ ថា លោក ឧត្តមសេនីយ៍ ទោ ស សាវី បាន ទៅ បំពេញ បេសកកម្ម មនុស្សធម៌ ក្រោម ស្លាក អង្គការ សហ ប្រជាជាតិ បាន ស្លាប់ នៅក្នុង មន្ទីរពេទ្យ ក្នុង ប្រទេស ម៉ាលី កាលពី ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២០ ម្សិលមិញ បន្ទាប់ពី ឆ្លង ជំងឺ កូវីដ១៩ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន បង្ហាញ អារម្មណ៍ សោកស្តាយ យ៉ាង ជ្រាលជ្រៅ ចំពោះ មរណភាព របស់ លោក ស សាវី ។ សម្តេច ពិជ័យ សេនា បាន ចាត់ទុក ការបាត់បង់ជីវិត របស់ យុទ្ធជន ខ្មែរ នៅ បរទេស នេះ ជា ការលះបង់ ដ៏ ធំធេង មិន អាច កាត់ថ្លៃ បាន ចំពោះ ជាតិ មាតុភូមិ ជាពិសេស កិច្ច មនុស្សធម៌ ក្រោម ឆត្រ អង្គការ សហ ប្រជាជាតិ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន បញ្ជាក់ ដែរ ថា ស ព យុទ្ធជន ពលី រូប នេះ ភាគី កម្ពុជា បាន សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ អង្គការ សហ ប្រជាជាតិ ដើម្បី រៀបចំ សព យុទ្ធជន របស់ កម្ពុជា ឱ្យ សាកសម នឹង ការលះបង់ ដើម្បី បុព្វហេតុ មនុស្សធម៌ ។
កាលពី ពេល ថ្មី ៗ នេះ មាន កងកម្លាំង យោធា មួក ខៀវ កម្ពុជា ៧នាក់ ដែល បំពេញ បេសកកម្ម នៅ ប្រទេស ម៉ាលី បាន ឆ្លង ជំងឺ កូវីដ១៩ ។ ក្នុង នោះ ស្លាប់ ១នាក់ ជាសះស្បើយ ២នាក់ និង ៤នាក់ ផ្សេង ទៀត កំពុង ព្យាបាល ។
លោក ឧត្តមសេនីយ៍ ឯក ផល សាម៉ន អ្នកនាំពាក្យ មជ្ឈមណ្ឌល ជាតិ គ្រប់គ្រង កងកម្លាំង រក្សា សន្តិភាព បោសសម្អាត មីន និង កាកសំណល់ សង្គ្រាម បាន ឱ្យដឹង ថា បច្ចុប្បន្ន កម្ពុជា មាន កងកម្លាំង កំពុង បំពេញ ការងារ នៅ ប្រទេស ម៉ាលី ២៩៨ នាក់ នារី ៣០ នាក់ ។
លោក ឧត្តមសេនីយ៍ ឯក ផល សាម៉ន បាន ឱ្យដឹង ដែរ ថា បច្ចុប្បន្ន នៅ ប្រទេស ម៉ាលី មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ១. ១៩៤ នាក់ ក្នុង នោះ មន្ត្រី របស់ អង្គការ សហ ប្រជាជាតិ ដែល ឆ្លង មាន ចំនួន ៧៣ នាក់ រាប់ ទាំង កម្ពុជា ៧នាក់ ផងដែរ ៕
ផលិតផល របស់ សិប្បកម្ម រ៉ារី បាន ពង្រីក ខ្លួន ដល់ ពីរ ខេត្ត កំពង់ស្ពឺ និង កំពង់ចាម
យ៉ាងណាមិញ សម្រាប់ អ្នក នៅ ភ្នំពេញ វិញ គឺ មាន ភាពងាយស្រួល បំផុត ក្នុង ការស្វែងរក ជាវ ផលិតផល សិប្បកម្ម រ៉ារី ពោល គឺ មាន គ្រប់ ម៉ាត តេលា ទូទាំង ប្រទេស ។
៥. តេលា ពោធិ៍សែនជ័យ ផ្លូវ សហព័ន្ធ រុស្សី ទល់មុខ ក្រុមហ៊ុន អេដ វ៉ូត
៧. តេលា អូឡាំពិច
១១. ម៉ាត សួន ធម្មជាតិ ទាំង ៨ សាខា ក្នុង រាជធានី ភ្នំពេញ
១៤. តាម ទីផ្សារ ក្នុង ខេត្ត ស្វាយរៀង ព្រះសីហនុ ព្រៃវែង និង តាម ផ្សារ មួយចំនួន ធំ ក្នុង រាជធានី ភ្នំពេញ ផងដែរ ។
ចូលរួម គាំទ្រ ផលិតផល ខ្មែរ គាំទ្រ ផលិតផល របស់ សិប្បកម្ម រ៉ារី គឺ គាំទ្រ ផលិតផល ខ្មែរ ។ ទំនាក់ទំនងជា វ តាមរយៈ លេខ ទូរស័ព្ទ ០៧៨៥២២២២៨ . ០៨៨២៩៩២៩៩២ ៕ អំណោយ របស់ លោក ហ៊ុន ម៉ានិត ត្រូវបាន យក ទៅ ចែកជូន ពលរដ្ឋ តាម ខ្នង ផ្ទះ ក្នុង មូលដ្ឋាន ឃុំ បុស ខ្នុរ ស្រុក ចំការ លើ ខេត្ដ កំពង់ចាម
( កំពង់ចាម ) ៖ អំណោយ របស់ លោក ហ៊ុន ម៉ានិត សមាជិក គណៈកម្មាធិការ គណបក្ស ប្រជាជន និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម ត្រូវបាន យក ទៅ ចែកជូន សមាជិក បក្ស ប្រជាជន និង ប្រជាពលរដ្ឋ ដែល ចាស់ជរា ពិការ គ្មាន ទីពឹង និង ចុះ ពិនិត្យ អណ្ដូង ទឹក នៅក្នុង មូលដ្ឋាន ឃុំ បុស ខ្នុរ ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ៣០ ខែឧសភា ឆ្នាំ ២០២០ ។
ការយក អំណោយ របស់ លោក ហ៊ុន ម៉ានិត ចែកជូន ពលរដ្ឋ នេះ ធ្វើឡើង តាមរយៈ លោក ងួន វិទូ អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ឃុំ បុស ខ្នុរ ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម តំណាង លោក ឌួង ឧត្តម អនុប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក និង ជា ប្រធាន ក្រុមការងារ ឃុំ ព្រមទាំង មាន ការចូលរួម ពី អាជ្ញាធរ មូលដ្ឋាន ផងដែរ ។
ពលរដ្ឋ ដែល ទទួលបាន អំណោយ ទាំងអស់ នោះ រួម មាន៖ ភរិយា របស់ ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ឃុំ បុស ខ្នុរ ដែល មាន ជំងឺ ឈឺ ជើង ដើរ មិន រួច និង ប្រជាពលរដ្ឋ ចាស់ជរា ពិការ គ្មាន ទីពឹង ។ ក្នុង នោះ លោក ក៏ បាន ចុះ ពិនិត្យមើល អណ្ដូង ទឹក ដែល ជា អំណោយ របស់ លោក ហ៊ុន ម៉ានិត ដែល ប្រជាពលរដ្ឋ កំពុង ប្រើប្រាស់ ផងដែរ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ងួន វិទូ បាន ផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពី ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រធាន . លោក ហ៊ុន ម៉ានិត ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ចំការលើ និង លោក ឌួង ឧត្តម ប្រធាន ក្រុមការងារ ឃុំ ជូន ប្រជាពលរដ្ឋ ទាំងអស់ នោះ ផងដែរ ដោយ ក្ដី នឹករលឹក គ្រប់ ៗ គ្នា ។
បន្ថែម ពី នេះ លោក ងួន វិទូ បាន បញ្ជាក់ ថា ការយក អំណោយ មក ចែកជូន នេះ គឺជា ការចែករំលែក ក្ដី អាណិត ស្រលាញ់ របស់ ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ដែល តែងតែ នៅក្បែរ និង មើលថែ ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ដោយ មិន គិត ពី ពណ៌ សម្បុរស ឬ និន្នាការ នយោបាយ អ្វី នោះ ឡើយ ពោល នៅ ទីណា មាន ការលំបាក គឺ តែង មាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ជានិច្ច ។
លោក ងួន វិទូ បាន ជម្រាប ឲ្យ ប្រជាពលរដ្ឋ ត្រូវ ខិតខំ ថែរក្សា សុខភាព និង ត្រូវ អនុវត្ត វិធាន អនាម័យ តាម សេចក្ដីណែនាំ របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង សុខាភិបាល ដើម្បី ជៀស ឆ្ងាយ ពី ជំងឺ កូវីដ១៩ និង ជំងឺ ឆ្លង ផ្សេង ៗ ដែល អាច កើតឡើង គ្រប់ ពេលវេលា ។ លើស ពី នេះ លោក បាន បញ្ជាក់ ថា ទោះបី កម្ពុជា ស្ងប់ស្ងាត់ ជំងឺ កូវីដ១៩ បន្ដិច មែន ប៉ុន្ដែ ប្រជាពលរដ្ឋ មិន ត្រូវ ធ្វេសប្រហែស នោះ ទេ គឺ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ វិធាន អនាម័យ ជានិច្ច ។
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ ដែល ទទួលបាន អំណោយ នេះ ក៏ បាន ផ្ដាំផ្ញើ នូវ ការថ្លែងអំណរគុណ តាមរយៈ លោក ងួន វិទូ ជូន លោក ហ៊ុន ម៉ានិត និង ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ដែល តែង យកចិត្តទុកដាក់ អំពី សុខ ទុក្ខ របស់ ពួកគាត់ និង ជូន ឲ្យ គណបក្ស ប្រជាជន កម្ពុជា កាន់តែ ទទួលបាន ជ័យជម្នះ ជា បន្ដ បន្ទាប់ រហូត ៕
យោង តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ អាមេរិក កំឡុង ពេល បិទ នោះ បន្ទប់ សន្និសីទ សារព័ត៌មាន របស់ សេតវិមាន ក៏ ត្រូវបាន បិទ ទ្វារ ចាក់សោ ហើយ កង អង្គរក្ស ទទួលបន្ទុក ការពារ សុវត្ថិភាព ប្រធានាធិបតី អាមេរិក មិន អនុញ្ញាតឲ្យ អ្នកណា ម្នាក់ ចាកចេញ ពី បរិវេណ សេតវិមាន ផងដែរ ។ យ៉ាងណាមិញ មួយ សន្ទុះ ក្រោយមក ច្រក ចេញ ចូល សេតវិមាន ត្រូវបាន បើក ទ្វារ ធម្មតា ឡើងវិញ ក្រោយ ក្បួន បាតុកម្ម បាន ហែ ផុត ឆ្ពោះទៅ កាន់ វិមាន សភា ជាតិ អាមេរិក Capitol Hill ។
