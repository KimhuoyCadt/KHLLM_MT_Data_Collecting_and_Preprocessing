( កំពង់ចាម ) ៖ ប្រជាពលរដ្ឋ នៅ តាម តំបន់ ដង ទន្លេ បាន សម្ដែង ការអបអរសាទរ រីករាយ ដោយ អាជ្ញាធរ ខេត្ត បាន សាងសង់ ច្រាំង ទន្លេ ដើម្បី ការពារ ការបាក់ ស្រុក ចូល ទន្លេ នៅក្នុង រដូវ ទឹក ជំនន់ ។
ភាពរីករាយ របស់ ប្រជាពលរដ្ឋ បាន សម្តែង ឱ្យ ឃើញ ខណៈពេល លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម អម ដំណើរ ដោយ អភិបាល រង ខេត្ត ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព ពាក់ព័ន្ធ និង អាជ្ញាធរ មូលដ្ឋាន នា ព្រឹក ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២០ នេះ ចុះ ពិនិត្យ ការដ្ឋាន សាងសង់ ច្រាំង ទន្លេ នៅ ក្រោយ សាលា សង្កាត់ កំពង់ចាម ក្រុង កំពង់ចាម និង ចុះ ពិនិត្យ ការរដ្ឋាន សាងសង់ ច្រាំង ទន្លេ នៅ ភូមិ ពង្រ លិច ឃុំ ពង្រ ស្រុក កោះ សូទិន ផងដែរ ។
តាម មន្ត្រី រដ្ឋបាល ខេត្ត កំពង់ចាម បាន បញ្ជាក់ ឱ្យដឹង ថា ការសាងសង់ ខឿន ច្រាំង ទន្លេ នៅជាប់ ខាងក្រោយ សាលា សង្កាត់ កំពង់ចាម ប្រវែង ១៨៥ ម៉ែត្រ ស្ថិត នៅក្នុង ក្រុង កំពង់ចាម ដោយ ចំណាយ កញ្ចប់ ថវិកា របស់ រដ្ឋបាល ខេត្ត កំពង់ចាម ត្រូវបាន បើក ការដ្ឋាន សាងសង់ កាលពី ថ្ងៃទី ២៣ ខែមីនា ឆ្នាំ ២០២០ កន្លងទៅ ថ្មី ៗ នេះ ។ ដោយឡែក ច្រាំង ទន្លេ នៅក្នុង ភូមិ ពង្រ លិច ឃុំ ពង្រ ស្រុក កោះ សូទិន បាន រង ការបាក់ ស្រុត កាលពី ពេល ថ្មី ៗ នេះ បណ្តាលឱ្យ ប៉ះពាល់ ហេដ្ឋ រចនាសម័្ពន្ធ ផ្លូវ កៅស៊ូ នៅ ចំណុច នោះ ។
ដោយ មើលឃើញ ពី ផល ប៉ះពាល់ និង ការគំរាមកំហែង នៅ តំបន់ នោះ ទើប អភិបាល ខេត្ត បាន ឱ្យ ក្រុមការងារ បច្ចេកទេស មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ចុះ សិក្សា លក្ខណៈ បច្ចេកទេស យ៉ាង ម៉ត់ចត់ និង បាន អនុញ្ញាតឱ្យ វិស័យ ឯកជន ដែល មាន បទពិសោធន៍ លើ ការងារ សាងសង់ ច្រាំង ទន្លេ ធ្វើ ការសាងសង់ ខឿន ការពារ ច្រាំង ទន្លេ នៅ ទីតាំង ខាងលើ នេះ ដោយ ប្រើប្រាស់ កញ្ចប់ ថវិកា ប្រចាំ ឆ្នាំ របស់ រដ្ឋបាល ខេត្ត តែម្តង ៕
កិច្ចប្រជុំ នេះ ដើម្បី ត្រួតពិនិត្យ ការអនុវត្ដ ភាព ជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ និង ផែនការ សកម្មភាព ៥ ឆ្នាំ ក្នុង ការកសាង សហគន៍ វាសនា រួម ព្រមទាំង ការដាក់ ទិសដៅ និង វិធានការពាក់ព័ន្ធ ថ្មី ៗ បន្ថែម ទៀត ពិសេស ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ និង ការស្តារ សេដ្ឋកិច្ច ឡើងវិញ នៅពេល ស្ថានភាព ជំងឺ កូវីដ - ១៩ បាន ធូរស្រាល ឬ បញ្ចប់ ។
កិច្ចប្រជុំ នេះ នឹង មាន សមាជិក មក ពី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ចំនួន ១៦ ស្ថាប័ន ខាង កម្ពុជា និង ចំនួន ១៥ ស្ថាប័ន ខាង ចិន ចូលរួម ដើម្បី អនុវត្ដន៍ ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ និង ផែនការ សកម្មភាព ៥ឆ្នាំ ក្នុង ការកសាង សហគន៍ វាសនា រួម ។
លោក ឧកញ៉ា នួន ឫទ្ធី ថ្លែង ឲ្យដឹង ថា « ខ្ញុំ សូម ផ្ដាំផ្ញើ ដល់ អ្នក វិនិយោគ លើ វិស័យ ដីធ្លី ទាំងអស់ ថា ក្នុង កំឡុង ពេល នេះ ប្រសិនបើ មាន លទ្ធភាព អ្នក គួរតែ វិនិយោគ លើ វិស័យ ដីធ្លី បន្ដ ដោយសារតែ តម្លៃ អចលន ទ្រព្យ នៅ ល្អ ប្រសើរ មួយ វិញទៀត ពេលនេះ អ្នកលក់ កំពុងតែ ចង់ លក់ រីឯ អ្នកទិញ កំពុងតែ ចង់ ទិញ ហើយ បើ ទិញ ពេលនេះ អ្នក អាច មាន ឱកាស ចំណេញ ចន្លោះ ពី ៣០ - ៤០ ភាគរយ » ។
លោក ឧកញ៉ា ថ្លែង បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ វិស័យ អចលន ទ្រព្យ កម្ពុជា ក្នុង កំឡុង ពេល កើតឡើង នៃ ជំងឺ កូវីដ១៩ នេះ គឺ មាន ផ្នែក មួយចំនួន នៅ មាន ដំណើរការ ល្អ ប្រសើរ ចំណែក ផ្នែក ខ្លះ មាន ផល ប៉ះពាល់ មួយចំនួន ប៉ុន្ដែ មិន មាន ភាព ធ្ងន់ធ្ងរ ពេក នោះ ទេ ។
លោក បាន បន្ថែម ថា ក្នុង កំឡុង ពេល នៃ ជំងឺ កូវីដ នេះ ក៏ មាន ឱកាស ជាច្រើន ផងដែរ ចំពោះ អ្នក វិនិយោគ ដីធ្លី វិញ គឺ អ្នកទិញ និង អ្នកប្រើប្រាស់ ទទួលបាន តម្លៃ ទាប ចំណែក អ្នក អភិវឌ្ឍន៍ និង អ្នកសាងសង់ ក៏ បាន ក្នុង តម្លៃ ទាប ដោយសារតែ កត្តា ជាច្រើន ដូចជា មាន កំលាំង ពលកម្ម ច្រើន . វត្ថុធាតុ ដើម ធូរ ថ្លៃ ជាង មុន ៕ ក្លាយជា ម្ចាស់ កម្មសិទ្ធិ ផ្ទះ យ៉ាង ងាយស្រួល និង សមស្រប តាម សមត្ថភាព ជាមួយនឹង កម្ចី ផ្ទះ ពី ធនាគារ ឯកទេស ម៉ារី ថាម ម . ក
ការថ្លែង បែប នេះ លោកស្រី យក់ សម្បតិ្ដ ក្នុង កិច្ចប្រជុំ ស្តីពី វិធានការ ការពារ ទប់ស្កាត់ ការរាត ត្បាត ជំងឺ កូវីដ១៩ ដែល ប្រព្រឹត្ដទៅ នៅ ទីស្ដីការ ក្រសួង សុខាភិបាល នា ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២០ នេះ មាន ការចូលរួម ពី ស្ថាប័ន ពាក់ព័ន្ធ រួម ជាមួយ ឯក អគ្គ រាជ ទូត ឯក អគ្គ រដ្ឋទូត ចំនួន ១០ប្រទេស និង តំណាង ស្ថាន បេសកកម្ម ការ ទូត បរទេស ចំនួន ២១ ប្រទេស ព្រមទាំង ប្រធាន អង្គការ សុខភាព ពិភពលោក ប្រចាំ កម្ពុជា និង ប្រធាន វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា ។
លោកស្រី ថ្លែង បន្ដ ថា សម្រាប់ អ្នកដំណើរ ធម្មតា ជា ជន បទ រទេស គឺ នៅតែ អនុវត្ដ វិធានការ របស់ ក្រសួង សុខាភិបាល ដដែល ចូលមក ត្រូវ ឆ្លង ចត្ដាឡី ស័ក និង តម្កល់ ថវិកា ជាមួយ ឯកសារធានារ៉ាប់រង សុខភាព ៥ម៉ឺន ដុល្លារ ផងដែរ ។
លោកស្រី យក់ សម្បត្ដិ បាន បញ្ជា កថា ក្រសួង សុខាភិបាល ក្រោម ការដឹកនាំ របស់ រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង បាន ដាក់ចេញ នូវ វិធានការ នេះ ឡើង ដើម្បី ផ្ដល់ ភាពងាយស្រួល ដល់ មន្ដ្រី ការទូត ទាំងអស់ ចូលមក កម្ពុជា ៕
យុវជន ម្នាក់ លួច ថត វីដេអូ គេ កំពុង ងូតទឹក ត្រូវ នគរបាល ស្រុក ស្អាង ខេត្ត កណ្តាល ចាប់ វាយ ខ្នោះ
( កណ្ដាល ) ៖ យុវជន ម្នាក់ ត្រូវបាន នគរបាល ស្រុក ស្អាង ឃាត់ខ្លួន ក្រោយ ទទួល ពាក្យបណ្ដឹង ករណី ប្រើប្រាស់ ទូរស័ព្ទ ដៃ លួច ថត នារី ម្នាក់ កំពុង ងូតទឹក ក្នុង បន្ទប់ទឹក តាម ប្រឡោះ ស័ង្កសី នា ព្រឹក ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២០ នេះ នៅ ចំណុច បន្ទប់ទឹក រួមគ្នា ស្ថិត ក្នុង ភូមិ ក្បាល ជ្រោយ ឃុំ ព្រែក គយ ស្រុក ស្អាង ខេត្ត កណ្តាល ។
ប្រភព ពី កម្លាំង នគរ បាន ឱ្យដឹង ថា ជនរងគ្រោះ មាន អាយុ ១៤ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ សិស្ស មាន ទីលំនៅ ភូមិ ក្បាល ជ្រោយ ឃុំ ព្រែក គយ ស្រុក ស្អាង ខេត្ត កណ្តាល ។ រីឯ ជនសង្ស័យ ឈ្មោះ អេន ធារ៉ា ភេទ ប្រុស អាយុ ២៦ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ ជាង ឡាន មាន ទីលំនៅ ស្នាក់ នៅ ភូមិ ក្បាល ជ្រោយ ឃុំ ព្រែក គយ ស្រុក ស្អាង ខេត្ត កណ្តាល ។
ប្រភព ដដែល បាន ឱ្យដឹង ទៀត ថា នៅ ពេល ដែល ជនរងគ្រោះ កំពុងតែ ងូតទឹក នៅក្នុង បន្ទប់ទឹក ពេល នោះ ស្រាប់តែ ជនសង្ស័យ ដែល ស្នាក់ នៅ យានដ្ឋាន ជួសជុល រថយន្ត ដែល នៅក្បែរ គ្នា បាន យក ទូរស័ព្ទ លួច ថត វីដេអូ តាម ប្រហោង ដំបូល ស័ង្កសី ធ្លុះធ្លាយ ហើយ ពេល នោះ ដែរ ត្រូវបាន ជនរងគ្រោះ ឃើញ ក៏ ស្រែក ឆោឡោ ឡើង បង្ក ការភ្ញាក់ផ្អើល ដល់ ក្រុមគ្រួសារ ។
បន្ទាប់មក ម្ដាយ របស់ ជនរងគ្រោះ បាន មក សួរ រក ទូរស័ព្ទ ពី ជនសង្ស័យ តែ ជនសង្ស័យ មិន ព្រម ប្រគល់ឲ្យ ហើយ ម្ដាយ ជនរងគ្រោះ ក៏ បាន រាយការណ៍ ទៅ សមត្ថកិច្ច ប៉ុស្ដិ៍ នគរបាល ព្រែក គយ តែម្តង ។
នគរបាល បន្ត ថា បន្ទាប់ពី ទទួលបាន ព័ត៌មាន ភ្លាម កម្លាំង ប៉ុស្ដិ៍ នគរបាល ព្រែក គយ បាន ទៅដល់ ធ្វើ ការសាកសួរ ហើយ បាន ដកហូត ទូរស័ព្ទ ពី ជនសង្ស័យ រួច ពិនិត្យ ឃើញ រូបភាព វីដេអូ អាក្រាត កាយ របស់ ជនរងគ្រោះ ក៏ បាន បញ្ជូន ជនសង្ស័យ ព្រមទាំង វត្ថុតាង មកកាន់ អធិការដ្ឋាន នគរបាល ស្រុក ស្អាង ដើម្បី ចាត់ការ តាម នីតិវិធី ៕
ជាមួយនឹង សារ អបអរ តាម Facebook សម្តេច តេជោ បាន ថ្លែង ថា « សម្តេច ព្រះមហា វីរក្សត្រ ខ្មែរ ព្រះបរម រតន កោដ្ឋ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ នរោត្តម សីហនុ បាន បំពេញ ព្រះរាជ បូជនីយកិច្ច យ៉ាង ស្វិតស្វាញ បំផុត ដើម្បី ទាមទារ ប្រាសាទ ព្រះវិហារ រហូតដល់ យើង បាន ចុះបញ្ជី ប្រាសាទ ព្រះវិហារ ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក ថ្ងៃ ៧កក្កដា ឆ្នាំ ២០០៨ » ។
សម្តេច ព្រះមហា វីរក្សត្រ ខ្មែរ ព្រះបរម រតន កោដ្ឋ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ នរោត្តម សីហនុ បាន បំពេញ ព្រះរាជ បូជនីយកិច្ច យ៉ាង ស្វិតស្វាញ បំផុត ដើម្បី ទាមទារ ប្រាសាទ ព្រះវិហារ និង ដេញ កងកម្លាំងប្រដាប់អាវុធ របស់ ថៃ ឱ្យ ចាកចេញ ពី ប្រាសាទ ព្រះវិហារ ។
ក្រោយពី ដំណើរការ តាម ផ្លូវ ទូត ត្រូវ ទទួលបរាជ័យ កម្ពុជា បាន ដាក់ ពាក្យ បណ្តឹង ទៅ តុលាការ យុត្តិធម៌ អន្តរជាតិ ក្រុង ឡាអេ នៅ ថ្ងៃទី៦ តុលា ឆ្នាំ ១៩៥៩ ដើម្បី ស្នើសុំ ឱ្យ តុលាការ ប្រគល់ អធិបតេយ្យ ដែនដី លើ ប្រាសាទ ព្រះវិហារ មក ឱ្យ កម្ពុជា និង ទាមទារ ឱ្យ ថៃ ដក កងកម្លាំងប្រដាប់អាវុធ ទាំងអស់ ចេញ ពី ប្រាសាទ ព្រះវិហារ ។
នៅក្នុង ការជំនុំជម្រះ លើ អង្គសេចក្ដី នោះ កម្ពុជា និង ថៃ បាន លើក បង្ហាញ ទឡ្ហីករ រៀង ៗ ខ្លួន ដើម្បី ទាមទារ ជា ម្ចាស់ កម្មសិទ្ធិ លើ ប្រាសាទ ព្រះវិហារ ។ កម្ពុជា បាន លើក យក ផែនទី ដង រែក ( ផែនទី ឧបសម្ព័ន្ធ ទី១ ) ដែល ជា ផែនទី កើត ចេញ ពី សន្ធិសញ្ញា បារាំង - សៀម ឆ្នាំ ១៩០៤ មក ធ្វើជា មូលដ្ឋាន ច្បាប់ ។ តាមរយៈ បន្ទាត់ ព្រំដែន នៅក្នុង ផែនទី ឧបសម្ព័ន្ធ ទី១ នេះ បង្ហាញ ថា ប្រាសាទ ព្រះវិហារ ស្ថិត នៅក្នុង ទឹកដី របស់ កម្ពុជា ។
ទោះបី ភាគី ថៃ បាន តវ៉ា យ៉ាង នេះ ក្តី ទីបំផុត ទៅក្នុង សាល ដីកា ឆ្នាំ ១៩៦២ តុលាការ យុត្តិធម៌ អន្តរជាតិ ទីក្រុង ឡាអេ បាន ច្រានចោល ការលើកឡើង របស់ ភាគី ថៃ ។ បើ តាម តុល ការ ក្រុង ឡាអេ មាត្រា១ នៃ សន្ធិសញ្ញា ឆ្នាំ ១៩០៤ បាន ចែង កំណត់ យក ខ្សែ បែងចែក ផ្លូវ ទឹក ធ្វើជា ព្រំដែន ពិត មែន ក៏ប៉ុន្តែ នៅក្នុង មាត្រា ៣ នៃ សន្ធិសញ្ញា ដដែល នេះ ចែង ថា ការកំណត់ ខ្សែ បន្ទាត់ ព្រំដែន ពិតប្រាកដ នឹង ត្រូវ ធ្វើឡើង ដោយ គណៈកម្មការ ចម្រុះ បារាំង - សៀម ។
បើ និយាយ ពី តំបន់ ដង រែក ខ្សែ បន្ទាត់ ព្រំដែន ដែល កើត ចេញពី ការងារ របស់ គណៈកម្មការ ចម្រុះ បារាំង - សៀម គឺ មាន តែ មួយ គត់ គឺ ខ្សែ បន្ទាត់ ព្រំដែន នៅក្នុង ផែនទី ឧបសម្ព័ន្ធទី១ ដែល កម្ពុជា បាន លើក យកមក ធ្វើជា សំអាង ។ ដូច្នេះ គេ មិន ចាំបាច់ ស្វែងរក ទីតាំង ខ្សែ បែងចែក ផ្លូវ ទឹក អ្វី នោះ ទេ ។
អភិបាល ស្រុក កំពង់រោទិ៍ ខេត្ត ស្វាយរៀង ផ្តាំផ្ញើ ប្រជាពលរដ្ឋ កុំ ភ្លេច ធ្វើ អនាម័យ ជាប្រចាំ និង បន្ត ប្រយុទ្ធ ប្រឆាំង នឹង ជម្ងឺ COVID-19
( ស្វាយរៀង ) ៖ លោក សុច ពិសី អភិបាល ស្រុក កំពង់រោទិ៍ ខេត្ត ស្វាយរៀង បាន ថ្លែង ផ្តាំផ្ញើ ប្រជាពលរដ្ឋ ទាំងអស់ កុំ ភ្លេច ធ្វើ អនាម័យ ជាប្រចាំ និង បន្ត ប្រយុទ្ធ ប្រឆាំង នឹង ជម្ងឺ កូវីដ១៩ ដែល កំពុង រាតត្បាត ពាសពេញ ពិភពលោក ខណៈ ស្ថានភាព ជំងឺ កូវីដ១៩ នៅ កម្ពុជា នៅតែ មាន អ្នក ឆ្លង ថ្មី នៅឡើយ ។
លោក សុច ពិសី បាន លើកឡើង បែប នេះ នា រសៀល ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២០ នៅក្នុង ពិធី ចែក អំណោយ របស់ សមាគម មនុស្សចាស់ ជរា និង អភិវឌ្ឍន៍ កុមារ វត្ត កោះ អណ្តែត និង ក្រុមហ៊ុន ឡាក់ គីរ៉ូប៊ី ឡាក់ គី៨៩ ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ៨៩គ្រូ សារ ព្រមទាំង ដាំ កូន ឈើ ក្រញូង ១០០ ដើម ក្នុង វត្ត កោះ អណ្តែត ឃុំ ថ្មី ស្រុក កំពង់រោទិ៍ ខេត្ត ស្វាយរៀង ។
លោក សុច ពិសី បាន ថ្លែងអំណរគុណ ចំពោះ ព្រះគ្រូ អ៊ុ សុវណ្ណ រិទ្ធ ចៅអធិការ វត្ត កោះ អណ្តែត ដែល តែងតែ យកចិត្តទុកដាក់ អំពី សុខ ទុក ប្រជាពលរដ្ឋ ទី ទាល់ ក្រ នៅក្នុង មូលដ្ឋាន ហើយ បាន កៀង គរ សប្បុរសជន មក ចែក អំណោយ បានជា បន្តបន្ទាប់ ។ ជាក់ស្តែង នៅ ថ្ងៃ នេះ ប្រជាពលរដ្ឋ ៨៩ គ្រួសារ បាន ទទួល អំណោយ ពី សមាគម មនុស្ស ចាស់ជរា និង អភិវឌ្ឍន៍ កុមាវត្ត កោះ អណ្តែត និង ក្រុមហ៊ុន ឡាក់ គីរ៉ូប៊ី ឡាក់ គី៨៩ ដែល ជា ការផ្តួចផ្តើម ឡើង ដោយ ព្រះគ្រូ ចៅអធិការ ដោយ ផ្ទាល់ ។
លោក បាន បន្ត ថា អំណោយ ទាំងនេះ ទោះបី មិន អាច ដោះស្រាយ បាន ទាំងស្រុង តែ ក៏ អាច ជួយ សម្រួល ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ បាន មួយ គ្រា ដែរ ខណៈ ដែល ប្រទេស កម្ពុជា កំពុង មាន ការរាតត្បាត ដោយសារ ជំងឺ កូវីដ១៩ ធ្វើឲ្យ ពលរដ្ឋ មិន សូវ បាន ចាកចេញ ពី លំនៅដ្ឋាន ទៅ រក ការងារ ធ្វើ ដូច្នេះ នាំឲ្យ មាន ការខ្វះខាត ។
លោក សុច ពិសី ក៏ បាន អំពាវនាវ ដល់ ពលរដ្ឋ ត្រូវ ចូលរួម គោរព ច្បាប់ ចរចរណ៍ ឲ្យបាន ខ្ជាប់ខ្ជួន ចៀស ឆ្ងាយ ពី គ្រឿងញៀន គ្រប់ ប្រភេទ និង ប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ ចំពោះ គ្រោះ ធម្មជាតិ ផ្សេង ៗ ជាពិសេស ខ្យល់ កន្ត្រាក់ និង ត្រូវ ត្រៀម ឧបករណ៍ ធ្វើ ស្រែ ឲ្យបាន គ្រប់គ្រាន់ ដើម្បី បង្ករ បង្កើន ស្រូវ រដូវ វស្សា ឲ្យ ទាន់ ពេលវេលា និង ត្រូវ ដាំ ដំណាំ រួមផ្សំ ចិញ្ចឹម សត្វ បន្ថែម ដើម្បី សម្រួល ដល់ ជីវភាព ប្រចាំ ថ្ងៃ ផងដែរ ។
ព្រះគ្រូ អ៊ុ សុវណ្ណ រិទ្ធ មាន សង្ឃ ដីការ ថា សមាគម មនុស្ស ចាស់ និង អភិវឌ្ឍន៍ កុមារ ដែល មាន រូប ព្រះអង្គ ជា ប្រធាន គឺ បង្កើតឡើង ដើម្បី ជួយ មនុស្សចាស់ ជរា នៅក្នុង ឃុំ ដែល សភាព ខ្វះខាត ជា ចាំបាច់ និង បាន ចាត់ ឲ្យ លោកគ្រូអាចារ្យ ព្រះសង្ឃ តែងតែ នាំ ថវិការ សម្ភារៈ គ្រឿង ឧបភោគ បរិភោគ ជូន ដល់ ចាស់ជរា មាន ជំងឺ និង បណ្តា សព ដែល នៅក្នុង ឃុំ ថ្មី ផងដែរ ។
វត្ត កោះ អណ្តែត ឃុំ ថ្មី ស្រុក កំពង់រោទិ៍ គឺជា វត្ត គំរូ មួយ នៅ ទូទាំង ខេត្ត ដែល មាន សមិទ្ធផល ជាច្រើន ព្រមទាំង មាន កន្លែង ផ្តល់ ចំណេះដឹង ដល់ សិក្សានុសិស្ស ទៀតផង ហើយ ព្រះសង្ឃ ក្នុង វត្ត បាន ដាំ បន្លែ ដាំ ដើមឈើ ហូប ផ្លែ ដើម្បី ផ្គត់ផ្គង់ ចង្ហាន់ ព្រះសង្ឃ ចែកជូន ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត យក ទៅ ស្ល រស្លុក ផងដែរ ។
ការខិតខំ ប្រឹងប្រែង រក ប្រាក់ របស់ តា យាយ ទាំង ពីរ នាក់ ដែល មិន ពឹង លើ កម្លាំង អ្នកដទៃ ខាងលើ នេះ ក៏ អាស្រ័យ ទៅ លើ សុខភាព របស់ ពួកគាត់ បច្ចុប្បន្ន ដែល នៅ មាន ភាព រឹងមាំ អាច ធ្វើ ការងារ រកស៊ី បាន បើ ទោះជា ពួកគាត់ មាន វ័យ ចាស់ ណាស់ ទៅ ហើយក៏ ដោយ ពួកគាត់ នៅតែ មាន ភាពអត់ធ្មត់ តស៊ូ ក្នុង ការប្រកប មុខរបរ ចិញ្ចឹម ជីវិត ដោយ មិន ទាន់ ពឹង ទៅ លើ ការជួយ ឧបត្ថម្ភ ពី កូន ចៅ របស់ គាត់ ទាំងស្រុង នៅឡើយ នោះ ទេ នេះ គឺជា គំរូ ដ៏ ល្អ មួយ ដែល គួរឲ្យ ស្ងប់ ស្ងែង និង កោតសរសើរ ផងដែរ ។
ដោយឡែក បច្ចុប្បន្ន គឺ នៅសល់ តែ ប្រាំ ដើម ទេ បើ គិត ជា បំពង់ មាន តែ ២០ បំពង់ ដោយ មួយ ថ្ងៃ បាន ស្ក តែ មួយ គីឡូក្រាម ប៉ុណ្ណោះ ត្នោត ទាំងនេះ លោក តា មិន ទាន់ ចោល វា ទេ ព្រោះ ស្ដាយ វា នៅ មាន ទឹក ចេញ នៅឡើយ រីឯ តម្លៃ ស្ក វិញ លក់ បាន ក្នុង មួយ គីឡូក្រាម ៥ពាន់ រៀល ពាក់ព័ន្ធ ទៅនឹង សុខភាព របស់ លោក តា បច្ចុប្បន្ន ។
ចំណែក លោកយាយ ឯណា វិញ ក៏ បាន ប្រាប់ ឲ្យដឹង ដែរ ថា លោកយាយ ឆ្នាំ នេះ លោកយាយ មាន ព្រះជន្ម ៧៦ ឆ្នាំ ហើយ សព្វ ថ្ងៃ នេះ លោកយាយ ក៏ មមាញឹក ក្នុង ការធ្វើ ក្អម ឆ្នាំង ផងដែរ គឺ ការងារ ក្អម ឆ្នាំង នេះ លោកយាយ ជា អ្នកទទួល ភារៈ ដោយ ខ្លួន ឯង ទាំងស្រុង ទាំង ការដុត ចម្អិន ក្អម ឆ្នាំង ឲ្យ ឆ្អិន បុក ដី ឆ្នាំង រែង ដី ជាដើម គឺជា កិច្ចការ របស់ លោកយាយ ។
លោកយាយ ក៏ បាន ឱ្យដឹង ដែរ ថា លោក យាយ ចេះ ធ្វើ ក្អម ឆ្នាំង តាំងពី លោកយាយ នៅ អាយុ ១២ឆ្នាំ មក ម្ល៉េះ សព្វ ថ្ងៃ នេះ គាត់ ធ្វើ ឆ្នាំង បាន មួយ ថ្ងៃ១០ នៅពេល ដុត ឆ្អិន លក់ បាន មួយ តម្លៃ ១០០០ រៀល បាន ប្រាក់ នេះ ផ្សំ ជាមួយ តា ដើម្បី ទុក សម្រាប់ ធ្វើ បុណ្យ ទាន នឹង គេ ។
ក្រុមគ្រួសារ រដ្ឋមន្ដ្រី ព្រុំ សុខា ថ្លែងអំណរគុណ ថ្នាក់ដឹកនាំ និង ញាតិមិត្ត ដែល ចូលរួម បុណ្យ សព លោក ចាន់ ស៉ីរ៉ាន់ ថា អនុ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល
លោក ព្រុំ សុខា រួម ជាមួយ ក្រុមគ្រួសារ សូម បួងសួង គុណ ព្រះរតន ត្រៃ និង វត្ថុ ស័ក្កសិទ្ធិ ក្នុង លោក ជួយ បីបាច់ ថែរក្សា ព្រះថេរានុ ថេរៈ សម្តេច ឯកឧត្តម លោកជំទាវ អ្នក ឧកញ៉ា លោក ឧកញ៉ា លោក លោកស្រី បងប្អូន ពុទ្ធ បរិស័ទ និង ញាតិមិត្ត ជិត ឆ្ងាយ ទាំងអស់ សូម ប្រកបដោយ សេចក្តីសុខ សេចក្តី ចម្រើន គ្រប់ ប្រការ និង ទទួលបាន នូវ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
អាកាសធាតុ លើ ផ្ទៃ សមុទ្រ មាន ភាព អាប់ អ៊ួរ ភ្លៀង ស្ទើរ គ្រប់ កន្លែង . ស្នងការ ខេត្ត ព្រះសីហនុ ជំរុញ កម្លាំង នគរបាល ទេសចរណ៍ និង ចរាចរណ៍ ផ្លូវ ទឹក បង្កើន ការយកចិត្តទុកដាក់
លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន បញ្ជាក់ ថា លោក បាន ដាក់ បទបញ្ជា ដល់ កម្លាំង នគរបាល ទេចរណ៍ និង នគរបាល ចរាចរ ផ្លូវ ទឹក ឲ្យ ជានិច្ច ត្រូវ ពង្រឹង គោលដៅ និង ណែនាំ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ដែល ចុះ លេង ទឹក សមុទ្រ នៅ តាម ឆ្នេរ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ កុំ ចុះ លេង ឃ្លាត ឆ្ងាយ ពី មាត់ ឆ្នេរ ត្រឹម រយៈ ចម្ងាយ ០៥ ម៉ែត្រ ចុះ និង បាន ហាម មិន ឲ្យ ក្មេង តូច ៗ ( អាយុ ប្រហែល ៧ឆ្នាំ ចុះ ) ចុះ លេង ទឹក ដោយ ហេតុ ថា នេះ ជា រដូវ ភ្លៀង អាច មាន រលក ធំ ៗ ខ្យល់ បក់ ខ្លាំង ជា យថាហេតុ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ទាំងអស់ សូម យកចិត្តទុកដាក់ ស្តាប់ ការណែនាំ ពី មន្ត្រី ជំនាញ ទាំងអស់ ដើម្បី ជា សផុត ពី ឧបទ្ទវហេតុ ផ្សេង ៗ ៕
( តៃវ៉ាន់ ) ៖ ជំងឺ រាតត្បាត សកល COVID-19 បាន បង្កឱ្យ សកម្មភាព សេដ្ឋកិច្ច ពិភពលោក ធ្លាក់ចុះ យ៉ាង គំហុក និង បង្ក ការខូចខាត យ៉ាង ធ្ងន់ធ្ងរ ដល់ ឧស្សាហកម្ម ជាច្រើន ។ ប៉ុន្តែ ឧស្សាហកម្ម ផលិត កង់ ជាពិសេស នៅ កោះ តៃវ៉ាន់ ដែល ជា អ្នកផលិត កង់ ឈាន មុខ គេ មួយ នៅលើ ពិភពលោក បែរជា ទទួលបាន ការបញ្ជាទិញ ច្រើន លើសលប់ ទៅវិញ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA នៅ រសៀល ថ្ងៃចន្ទ ទី១៥ ខែមិថុនា ឆ្នាំ ២០២០ ។
ឧស្សាហកម្ម ផលិត កង់ នៅ កោះ តៃវ៉ាន់ ទទួលបាន ការបញ្ជាទិញ ខ្ពស់ ពី អតិថិជន នៅក្នុង សហរដ្ឋ អាមេរិក និង សហភាព អឺរ៉ុប ដែល នេះ បាន ចូលរួមចំណែក រក ចំណូល ឱ្យ សេដ្ឋកិច្ច ដែន កោះ មួយ នេះ បាន មួយ ផ្នែក ខណៈ ពិភពលោក ទាំងមូល កំពុង ប្រឈមមុខ នឹង ការធ្លាក់ចុះ សកម្មភាព សេដ្ឋកិច្ច យ៉ាង គំហុគ ដោយសារ ជំងឺ ឆ្លង រាត តត្បាត សកល COVID-19 ។
ឱកាស សិក្សា ពិសេស ពី សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប ចុះឈ្មោះ ឥឡូវនេះ នឹង ទទួលបាន ការបញ្ចុះ តម្លៃ ៣០០ ដុល្លារ
ក្រសួង មហាផ្ទៃ ណែនាំ ដល់ អភិបាល រាជធានី - ខេត្ត ឱ្យ បន្ត រៀបចំ វេទិកា ពិគ្រោះយោបល់ តាម មូលដ្ឋាន ឡើងវិញ ដោយ ជួបជុំ មិន ឱ្យ លើស ពី ៥០ នាក់
សម្តេច បាន បន្ត ថា ក្នុង បរិបទ ខាងលើ នេះ ដើម្បី បន្ត ជំរុញ ឱ្យ ការរៀបចំ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ដំណើរការ ដោយ រលូន មាន ការចូលរួម ពី គ្រប់ ភាគី ពាក់ព័ន្ធ និង សម្រេចបាន លទ្ធផល តាម ការរំពឹងទុក ព្រមទាំង រួមចំណែក ក្នុង ការបង្ការ ទប់ស្កាត់ ការរោតត្បាត នៃ ជំងឺ កូវីដ - ១៩ ក្រសួង មហាផ្ទៃ សូម ធ្វើ ការណែនាំ ដល់ រដ្ឋបាល រាជធានី ខេត្ត ត្រូវ យកចិត្តទុកដាក់ អនុវត្ត នូវ កិច្ចការ មួយចំនួន ដូច ខាងក្រោម ៖
* ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ត្រូវ បន្ត រៀបចំ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ នៅ តាម មូលដ្ឋាន នីមួយ ៗ ជាធម្មតា ស្រប តាម ច្បាប់ ស្ដីពី ការគ្រប់គ្រង រដ្ឋបាល រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ និង លិខិត បទដ្ឋាន គតិយុត្ត ជាធរមាន ។
* ចំពោះ សមាសភាព ចូលរួម វេទិកា នេះ ត្រូវ រៀបចំ តាម រូបភាព តូច ៗ ដោយ កំណត់ តំណាង អ្នកចូលរួម មួយ លើក ៗ មិន លើស ពី ៥០ នាក់ និង ត្រូវ អនុវត្ត វិធានការ បង្ការ ទប់ស្កាត់ ការរោត ត្បាត នៃ ជំងឺ កូវីដ - ១៩ ស្រប តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន ហ្មត់ចត់ ដូច ជា៖ មាន ការត្រួតពិនិត្យ កំដៅ មាន ទឹក អាល់កុង ឬ ជែល សម្រាប់ លាង ដៃ ត្រូវ ពាក់ ម៉ាស ឬ ប្រើ ក្រមា កន្សែង រក្សា គម្លាត សុវត្តិភាព សង្គម និង គម្លាត សុវត្ថិភាព បុគ្គល ។
* រដ្ឋបាល រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ត្រូវ អញ្ជើញ សមាសភាព តំណាង ប្រជាពលរដ្ឋ ពី គ្រប់ មជ្ឈដ្ឋាន និង តំណាង ក្រុមការងា រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ដើម្បី ចូលរួម ក្នុង វេទិកា នេះ ។
* ទន្ទឹម នេះ រដ្ឋបាល រាជធានី ខេត្ត ត្រូវ ធ្វើ ការណែនាំ ដល់ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ឃុំ សង្កាត់ ឱ្យ អនុវត្ត វិធានការអប់រំ ផ្សព្វផ្សាយ ដល់ ប្រជាពលរដ្ឋ ដើម្បី ធ្វើ អនាម័យ ជាប់ ជាប្រចាំ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ក្នុង ការបង្ការ ទប់ស្កាត់ កាត ត្បាត នៃ ជំងឺ កូវីដ - ១៩ ៕
ខាងក្រោម នេះ ជា សេចក្តីណែនាំ របស់ សម្តេច ក្រឡាហោម ស ខេង៖ អាវុធហត្ថ ខេត្ត ស្វាយរៀង បង្ក្រាប សៃ វៀន បញ្ជល់ មាន់ ឃាត់ខ្លួន មនុស្ស ៩នាក់ មាន់ ជល់ ១៧ក្បាល ដកហូត ប្រាក់ ដុល្លារ ក្លាយ ក្លែង ជាង ៥ ពាន់ ដុល្លារ នៅ ស្រុក ស្វាយ ជ្រំ
( ស្វាយរៀង ) ៖ កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ស្វាយរៀង ចុះបង្ក្រាប ករណី លេង ល្បែងស៊ីសង បញ្ជល់ មាន់ និង ឃាត់ខ្លួន ជនសង្ស័យ ប្រុស ស្រី ៩នាក់ ដកហូត មាន់ ជល់ ១៧ក្បាល ប្រាក់ ដុល្លារ ក្លែងក្លាយ ចំនួន ៥. ៦០០ ដុល្លារ ព្រមទាំង ម៉ូតូ ៤គ្រឿង រថយន្ត១ គ្រឿង និង លុយ ខ្មែរ ជិត ៥លាន រៀល ។
ការចុះបង្ក្រាប នេះ បាន ធ្វើឡើង នា វេលា ម៉ោង ១២៖ ២០ នាទី ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២០ ស្ថិត នៅ ភូមិ ស្វាយ ក្ងោ ឃុំ ស្វាយ ជ្រំ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង ។
ព្រឹក ស្អែក អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល រៀបចំ សន្និសីទ សារព័ត៌មាន ស្ដីពី « វឌ្ឍនភាព ទិសដៅ ការងារ បន្ដ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ »
សន្និសីទ នេះ មាន គោលបំណង បង្ហាញ ជូន សាធារណៈ ឲ្យបាន យល់ ច្បាស់ ពី សកម្មភាព សមិទ្ធផល និង ទិសដៅ ការងារ បន្ដ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ក្នុង ទិសដៅ ស្នួល ជំរុញ គោល នយោបាយ អភិបាលកិច្ច ល្អ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ឆ្លើយតប ទៅ នឹង យុទ្ធសាស្ដ្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល ។
ក្នុង សេចក្ដីជូនដំណឹង បាន ឲ្យដឹង ថា សន្និសីទ សារព័ត៌មាន នេះ មាន ការសម្របសម្រួល ពី លោក ផៃ ស៉ី ផាន រដ្ឋមន្ដ្រី ប្រតិភូ អម នាយក រដ្ឋមន្ដ្រី និង ជា ប្រធាន អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល និង មាន ការអញ្ជើញ ចូលរួម ជា វាគ្មិន ពី លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ៕
គួរ បញ្ជាក់ តាម រដ្ឋមន្ត្រី ការបរទេស ជប៉ុន ខាងលើ នេះ ទៀត ថា ប្រទេស ជប៉ុន ក៏ បាន ព្រមព្រៀង ជាមួយ សមភាគី វៀតណាម អូស្ត្រាលី និង នូវែលសេឡង់ រួចហើយ ដែរ ដើម្បី ពិភាក្សា អំពី ការអនុញ្ញាតឲ្យ អ្នក ដែល ត្រូវការ ការធ្វើដំណើរ នោះ អាច ចាប់ផ្តើម ឡើងវិញ ជាមួយ ជប៉ុន ។ បច្ចុប្បន្ន ជប៉ុន មាន ករណី ឆ្លង COVID-19 សរុប ១៧. ១០៩ ករណី ក្នុង នោះ ស្លាប់ ៩២៥ នាក់ និង ជាសះស្បើយ វិញ ១៥. ៦៤៣ នាក់ ខណៈ អត្រា នៃ ការរាតត្បាត ជំង នេះ ត្រូវបាន គេ មើលឃើញ ថា បាន ធ្លាក់ចុះ វិញ គួរឲ្យ កត់សម្គាល់ ៕
សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ស្វាយរៀង រៀបចំ ព្រះរាជ ពិធី ចម្រើន ព្រះជន្ម សម្ដេច ម៉ែ គម្រប់ ខួប ៨៤ យាង ចូល ៨៥ ព្រះវស្សា
ព្រះរាជ ពិធី នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២០ ដោយ មាន ការចូលរួម ពី គណៈកិត្តិយស សាខា គណៈកម្មាធិការ សាខា ថ្នាក់ដឹកនាំ មន្ត្រី បុគ្គលិក យុវជន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង យាយ ជី តា ជី ជាច្រើន នាក់ នៅ ទីស្នាក់ការសាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ស្វាយរៀង ។
ក្នុង ឱកាស ដ៏ វិសេសវិសាល នេះ លោក ម៉ែន វិបុល ប្រធាន គណៈកម្មាធិការ សាខា បាន អាន សារលិខិត ថ្វាយ ព្រះពរ សម្តេច ព្រះមហាក្សត្រី ដែល មាន ខ្លឹមសារ ទាំងស្រុង ថា៖
បន្ទាប់មក លោកស្រី ម៉ែន សំអន ព្រមទាំង លោក លោកស្រី គណៈ កិត្តិយស គណៈកម្មាធិការ សាខា មន្ត្រី ក្រុម ប្រតិបត្តិ សាខា បាន និមន្ត ព្រះមេ គណ ខេត្ត ព្រះមន្រ្តី សង្ឃ ខេត្ត ចំនួន ៩អង្គ ចម្រើន ព្រះបរិត្ត ថ្វាយ ព្រះពរ ជ័យ រួច រាប់ បាត្រជា កិច្ច បញ្ចប់ កម្មវិធី បុណ្យ ៕
អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ ចុះ ពិនិត្យ សកម្មភាព ស្តារ ប្រឡាយ ទួល ពង្រ និង អំពាវនាវ ប្រជាពលរដ្ឋ កុំ បោះ សំរាម ឬ សំណល់ ផ្សេង ៗ ចូល ប្រឡាយ
( ភ្នំពេញ ) ៖ លោក ហែម ដារិទ្ធ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ រួម និង មន្រ្តី ខណ្ឌ ជាច្រើន រូប ទៀត នា ព្រឹក ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២០ នេះ បាន ចុះ ទៅ ពិនិត្យមើល សកម្មភាព ស្តារ ប្រឡាយ ទួល ពង្រ ស្ថិត នៅ ទីតាំង ដីការដ្ឋាន សំណង់ បុរី ជីប ម៉ុង ជាប់ និង រោងចក្រ អគ្គីសនី កម្ពុជា ខាងកើត ភូមិ ទួល ពង្រ សង្កាត់ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ ដែល នៅ ទីនោះ ស្ថានភាពប្រឡាយ តូច ចង្អៀត និង គោក រាក់ ដោយ ដី ស្មៅ និង កំប្លោក ដែល ចាំបាច់ ត្រូវតែ ដាក់ សាឡង់ ទើប ដំណើរការ បាន ។
លោក កង វង ចៅសង្កាត់ ចោម ចៅ ទី១ បាន ឲ្យដឹង ថា ប្រឡាយ ទួល ពង្រ ទាំង ២ខ្សែ នេះ មាន ព្រំប្រទល់ ខាងលិច ទល់ និង ភូមិ ព្រៃ ល្វា សង្កាត់ ចោម ចៅ ទី២ ខាងកើត ទល់ នឹង ព្រំប្រទល់ ខណ្ឌ ដង្កោ និង ខណ្ឌ មានជ័យ មាន ប្រវែង ជាង ២.០០០ម៉ែត្រ បាន ចាប់ផ្តើម ដំណើរការស្តារ ៣សប្តាហ៍ មក ហើយ ដោយ សំរេច បានជាង ៩០% គឺ នៅសល់ តែ តំបន់ ចុង ប្រឡាយ នេះ តែ ប៉ុណ្ណោះ ។
ប្រឡាយ ទួល ពង្រ ទាំង ២ខ្សែ នេះ មាន សារសំខាន់ ណាស់ ក្នុង ការរំដោះ ទឹក ទាំង ជំនន់ ទឹកភ្លៀង និង ទឹក ប្រើប្រាស់ ប្រចាំ ថ្ងៃ នៃ តំបន់ ភាគ ខាងត្បូង ភូមិសាស្រ្ត ខណ្ឌ កំបូល និង ខណ្ឌ ពោធិ៍សែនជ័យ ។ ជាច្រើន ឆ្នាំ ហើយ ប្រឡាយ ទួល ពង្រ ទាំង ២ខ្សែ នេះ មិន ដែល បាន ស្តារ ម្តង ណា ឡើយ ធ្វើឲ្យ តួ ប្រឡាយ ទាំងមូល ត្រូវ គោក រាក់ ដោយ ភក់ ល្បប់ ស្មៅ និង កំប្លោក ។
ជាង នេះ ទៀត កន្លែង ខ្លះ ត្រូវបាន ប្រជាពលរដ្ឋ លួច ចាក់ ដី លប់ ប្រឡាយ យក ធ្វើជា កម្មសិទ្ធ . ចាក់ ផ្លូវ ចូល ផ្ទះ ដោយ ដាក់ លូ តូច ៗ ជំនួស និង កន្លែង ខ្លះ ពលរដ្ឋ ចាក់ សំរាម ឬ កំទេចកំទី គ្រឿង សំណង់ ចូល ផងដែរ ដែល ក្នុង ស្ថានភាព នេះ បាន ធ្វើឲ្យ តួ ប្រឡាយ កាន់តែ រួម តូច និង គោក រាក់ ស្ទះ ចរន្ត ទឹក ហូរ បណ្តាលឲ្យ មាន ការលិចលង់ លំនៅដ្ឋាន ប្រជាពលរដ្ឋ ប៉ែង ខាងលើ ជារៀងរាល់ ឆ្នាំ ។
ក្នុង ការចុះ ពិនិត្យ សកម្មភាព ស្តារ ប្រឡាយ នេះ លោក ហែម ដារិទ្ធ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ សូម មេត្តា កុំ រំលោភ លូ ប្រឡាយ និង កុំ បោះ សំរាម ឬ សំណល់ ផ្សេង ៗ ចូល ប្រឡាយ នាំ ប្រឡាយ គោក រាក់ ស្ទះ ចរន្ត ទឹក បង្ករ ការលិចលង់ លំនៅដ្ឋាន ។
ឆ្លៀត ក្នុង ឱកាស នេះ ដែរ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម បន្ត ប្រុងប្រយ័ត្ន ចំពោះ ការឆ្លង ជំងឺ កូវីដ១៩ ជា បន្ត ទៀត ដោយ អនុវត្ត ឲ្យបាន ល្អ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ទើប ជា ការប្រសើរ ៕
គួរ បញ្ជាក់ ថា បើ តាម វិទ្យា សា្ថន ស្រាវជ្រាវ សន្តិភាព អន្តរជាតិ Stockholm រុស្ស៊ី មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ ៦.៧៣៥ គ្រាប់ ក្នុង នោះ ១. ៥៧០ គ្រាប់ ត្រូវបាន ដាក់ពង្រាយ ជាស្រេច ហើយ សហរដ្ឋ អាមេរិក មាន ៥.៨០០ គ្រាប់ ក្នុង នោះ ១. ៧៥០ គ្រាប់ ត្រូវបាន ដាក់ពង្រាយ ។ រុស្ស៊ី និង សហរដ្ឋ អាមេរិក តំណាង ឱ្យ ៩០ ភាគរយ នៃ ក្បាល គ្រាប់ នុយក្លេអ៊ែរ សរុប នៅ ទូទាំង ពិភពលោក ។
ខាងក្រោម នេះ គឺជា បញ្ជី ឈ្មោះ ប្រទេស ដែល មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ ក្រៅពី អាមេរិក និង រុស្ស៊ី៖
* ចក្រភព អង់គ្លេស មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ សរុប ២៥០ គ្រាប់ ក្នុង នោះ មាន ១២០ គ្រាប់ ត្រូវបាន ដាក់ពង្រាយ ។
* ប្រទេស បារាំង មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ សរុប ២៩០ គ្រាប់ ក្នុង នោះ មាន ២៨០ គ្រាប់ ត្រូវបាន ដាក់ពង្រាយ
* ប្រទេស ចិន មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ សរុប ៣២០ គ្រាប់
* ប្រទេស ឥណ្ឌា មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ សរុប ១៥០ គ្រាប់
* ប្រទេស ប៉ាគីស្ថាន មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ សរុប ១៦០ គ្រាប់
* ប្រទេស អ៉ី ស្រាអែល មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ សរុប ៩០ គ្រាប់
* កូរ៉េ ខាងជើង មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ សរុប ពី ៣០ - ៤០ គ្រាប់ ៕ ADB: ការអប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ ប្រកបដោយ គុណភាព ជា សសរ ស្តម្ភ នៃ ជីវភាព ថ្លៃថ្នូរ និង កំណើន សេដ្ឋកិច្ច
ដើម្បី ជំរុញ និង លើកកម្ពស់ ការយល់ដឹង បន្ថែម អំពី សារៈសំខាន់ នៃ TVET ធនាគារ អភិវឌ្ឍន៍ អាស៊ី រួម សហការ ជាមួយ ភ្នាក់ងារ ពាក់ព័ន្ធ ផ្សេង ៗ បាន និង កំពុង គាំទ្រ រាជ រដ្ឋ ភិបាល កម្ពុជា ប្រារព្ធ ទិវា ជាតិ អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ លើក ទី៣ ឆ្នាំ ២០២០ នៅ ថ្ងៃទី ១៥ ខែមិថុនា ក្រោម ប្រធានបទ «TVET ធ្វើឲ្យ ជីវិត កាន់តែ ប្រសើរ » ។
ចាប់តាំងពី ឆ្នាំ ២០១៤មក ធនាគារ អភិវឌ្ឍន៍ អាស៊ី (ADB) បាន សហការ ជាមួយ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដើម្បី ធ្វើ កំណែទម្រង់ លើកស្ទួយ ប្រព័ន្ធ និង កម្មវិធី TVET នៅ កម្ពុជា ឲ្យ ដល់ កម្រិត ថ្មី មួយ ទៀត ដោយ បាន វិនិយោគ ថវិកា ជិត ១៧៥ លាន ដុល្លារ ។
ការងារ នេះ រួម មាន ការសម្រួច ជំនាញ និង សមត្ថភាព ប្រកួតប្រជែង កម្លាំង ពលកម្ម ផ្នែក ឧស្សាហកម្ម របស់ ប្រទេស កម្ពុជា ព្រមទាំង អភិវឌ្ឍ ធនធាន មនុស្ស សម្រាប់ វិស័យ អាទិភាព ទាំង បួន រួម មាន ផលិតកម្ម សំណង់ អគ្គិសនី និង អេឡិចត្រូនិច ។
វិទ្យាស្ថាន បណ្តុះបណ្តាល បច្ចេកទេស ដែល បាន ជ្រើសរើស ត្រូវបាន ប្រែក្លាយទៅជា វិទ្យាស្ថាន អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ នាំមុខ គេ ទូទាំង ប្រទេស ដើម្បី អភិវឌ្ឍ អ្នក បច្ចេកទេស ប្រកបដោយ គុណភាព ខ្ពស់ សម្រាប់ វិស័យ អាទិភាព ហើយ ឆ្លើយតប ទៅនឹង បន្លាស់ ប្តូរ តម្រូវការ ផ្នែក ឧស្សាហកម្ម និង បច្ចេកទេស ។
បន្ទាប់ពី បាន រៀន ចប់ ចូល ធ្វើជា គ្រូបង្រៀន ភាសា អង់គ្លេស អស់ រយៈពេល ៥ ឆ្នាំ លោក ទទួលបាន ប្រាក់ខែ ទាប បំផុត ប្រមាណ ១០០ យ័ន ឬ ប្រហែល ១៦ ដុល្លារ តែ ប៉ុណ្ណោះ ប៉ុន្តែ ការវិវត្ត នៃ ជីវិត បាន ផ្លាស់ប្តូរ យ៉ាង សម្បើម ដោយ ថ្ងៃ មួយ នៅក្នុង ឆ្នាំ ១៩៩៥ ជេក ម៉ា ក៏ បាន ធ្វើដំណើរ ទៅ ធ្វើការ នៅ សហរដ្ឋ អាមេរិក ។
ជេក ម៉ា បាន សរុប ជីវិត ធ្វើការ របស់ ខ្លួន ជា ៣ ដំណាក់កាល សំខាន់ ៗ៖
* ដំណាក់កាល ទី មួយ៖ នៅ ឆ្នាំ ១៩៩៥ គាត់ នៅ ជា គ្រូបង្រៀន ភាសា អង់គ្លេស នៅ មហាវិទ្យាល័យ ហាង ចូវ ហើយ អាច ទាយ ទុក ថា អនាគត គាត់ ក្លាយជា ប្រធាន ប៉ាតឺ ម៉ង់ ភាសា បរទេស ។
* ដំណាក់កាល ទី ពី រ៖ ឆ្នាំ ១៩៩៥ - ១៩៩៩ គាត់ បាន ចាប់ផ្តើម ធ្វើ វេបសាយ សៀវភៅ ទំព័រ លឿង រួម ជាមួយ មន្ទីរ សារ គមនាគមន៍ ទីក្រុង ហាង ចូវ ហើយ ក្រៅពី នោះ ក៏ បាន ស្វែងរក ផ្លូវ ចេញ ពី ប៉េកាំង តែ ក្នុង ឆ្នាំ ១៩៩៩ ដដែល នោះ នា រដូវ ព្រិល ធ្លាក់ ជេក ម៉ា និង មិត្តភក្ដិ ដែល ទៅ ជាមួយគ្នា ត្រូវ ធ្វើដំណើរ ត្រលប់ ទៅ ផ្ទះ វិញ ដោយ ភាពសោកសៅ ។
ចំការល្មើ មួយ ក្នុង ស្រុក ស្ទោង កំពុង ទាក់ទាញ អារម្មណ៍ ពលរដ្ឋ មក ទិញ ទទួលទាន និង ថត រូប លេង កម្សាន្ត
( កំពង់ធំ )៖ បច្ចុប្បន្ន នេះ ការធ្វើ កសិកម្ម មួយ ចំនួន ប្រកបដោយ សោភ័ណភាព បាន ក្លាយទៅជា ផលិតផល ទេសចរណ៍ ដ៏ ទាក់ទាញ សម្រាប់ ពលរដ្ឋ ខ្មែរ ។ ជាក់ស្តែង ចំការ ផ្លែ ល្មើ ស្រស់ មួយ កន្លែង នៅក្នុង ស្រុក ស្ទោង ខេត្ត កំពង់ធំ កំពុងតែ ទាក់ទាញ អារម្មណ៍ ប្រជាពលរដ្ឋ មក ទិញ ទទួលទាន និង ថត រូប លេង កម្សាន្ត ជា ហូរហែ ។
លោក វី រ៉ែ ន ប្រធាន គ្រប់គ្រង ទូទៅ របស់ ក្រុមហ៊ុន លឹម ប៊ុណ្ណា ដែល ជា ក្រុមហ៊ុន វិនិយោគ លើ ចម្ការ នេះ បាន ឱ្យដឹង ថា តំបន់ នេះ ឱ្យ ឈ្មោះ ថា តំបន់ រមណីយដ្ឋាន កែង គោល ស្ទោង ហើយ តំបន់ រមណីយដ្ឋាន នេះ គឺជា បណ្ដុំ អាជីវកម្ម ចម្រុះ មាន ការ៉ាស សាំង ម៉ាត ហាង កាហ្វេ ភោជនីយដ្ឋាន ឃ្លាំង ស្តុក ស្រូវ លក់ ចេញ និង ចំការ ដែល មាន ផ្ទៃដី ១. ៣៥០ ហិកតា ។
រមណីយដ្ឋាន « កែង គោល ស្ទោង » នេះ គឺ ទៅ ថ្ងៃ អនាគត ក្រុមហ៊ុន នឹង ធ្វើ ការបើក រីសត ដែល មាន ដាក់ ម្ហូប អាហារ បែប ធម្មជាតិ ឲ្យ ប្រជាពលរដ្ឋ សម្រាក នៅពេល ចុង សប្តាហ៍ ដើម្បី ទទួលទាន ដែល មាន បន្លែ ធម្មជាតិ ពិត ក្នុង ការផ្គត់ផ្គង់ ហើយ ក្នុង នោះ ក៏ មាន អាង ចិញ្ចឹម ត្រី សម្រាប់ ឱ្យ ភ្ញៀវ មក ស្ទូច ត្រីល ម្ហែ កាយ និង មាន ដំណាំ ហូប ផ្លែ ផ្សេង ទៀត ក្នុង នោះ ដែរ ក៏ យើង មាន ផ្ទះ ធ្វើ បែប បុរាណ ដើម្បី ទុក ជា មរតក សម្រាប់ ឱ្យ ក្មេង ជំនាន់ ក្រោយ បាន ឃើញ ដែល មាន បណ្ដោយ ៥៥ម៉ែត្រ ទទឹង ៥២ ម៉ែត្រ ។
ផ្ទះ បុរាណ គឺ មាន លក្ខណៈ ចម្រុះ ជាមួយនឹង ឈើ ធ្វើ ពី ឥដ្ឋ តាម បែប លក្ខណៈ កែច្នៃ ដែល មាន សួនច្បារ និង ដំណាំ ហូប ផ្លែ ព័ទ្ធ ជុំវិញ និង មាន ម្លប់ ឈើ ត្រជាក់ ហើយ ផ្ទះ នេះ អាច អញ្ជើញ មក ថតរូប លេង កម្សាន្ត បាន ហើយ នៅ តំបន់ នេះ កំពុងតែ ផ្ដល់ ការងារ ដល់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ដែល ជា បុគ្គលិក ផ្ទាល់ ប៉ុន្មាន ជាង ១០០ នាក់ ហើយ នឹង ត្រូវការ ជ្រើសរើស កម្លាំង ពលកម្ម បន្ថែម ទៀត ប្រមាណ ៣០០ ទៅ ៤០០ នាក់ ដែល នឹង បង្កើត ជារី សត ភោជនីយដ្ឋាន ដែល ធ្វើឱ្យ ប្រជាពលរដ្ឋ អាច រក ប្រាក់ កម្រៃ ចិញ្ចឹម គ្រួសារ ។
ជាមួយគ្នា នេះ ដែរ លោក ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ អាច មក រក ការងារ ធ្វើ នៅ ទីនេះ បាន ព្រោះ ទីនេះ ត្រូវការកម្លាំង ពលកម្ម ច្រើន ហើយ ដើម្បី កុំ ឱ្យ ពួកគាត់ ធ្វើ ចំណាកស្រុក ឆ្ងាយ នាំឱ្យ មាន ហានិភ័យ ។
ជុំវិញ ការមក ទស្សនា កំសាន្ត នៅ ចំការល្មើ នេះ ប្រជាពលរដ្ឋ មាន ការសប្បាយ ចិត្ត គាំទ្រ នូវ ដំណាំ បែប ធម្មជាតិ មិន ប្រើប្រាស់ ជី គីមី ដើម្បី ចូលរួម ជួយ ដល់ សុខភាព របស់ យើង ទាំងអស់ គ្នា ៕ ព្រឹទ្ធសភា នឹង បន្ត សម័យ ប្រជុំ របស់ ខ្លួន នៅ ថ្ងៃស្អែក នេះ ដើម្បី ពិនិត្យ និង ឱ្យ យោបល់ លើ សេចក្តីព្រាង ច្បាប់ ចំនួន ៤
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ប្រជុំ គណៈ អចិន្ត្រៃយ៍ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២០ នេះ ព្រឹទ្ធសភា បាន សម្រេច បន្ត សម័យ ប្រជុំ លើក ទី៥ របស់ ខ្លួន នៅ ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០២០ ស្អែក នេះ ដើម្បី ពិនិត្យ និង ឱ្យ យោបល់ លើ សេចក្តីព្រាង ច្បាប់ ចំនួន ៤ ដែល អនុម័ត ដោយ រដ្ឋសភា ។
កិច្ចប្រជុំ គណៈកម្មាធិការ ព្រឹទ្ធសភា នៅ ថ្ងៃ នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព របស់ សម្តេច សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា ដោយ មាន ការចូលរួម ពី ប្រធាន និង តំណាង គណៈកម្មការ ទាំង១០ របស់ ព្រឹទ្ធសភា ផងដែរ ។
បាន បើក កិច្ចប្រជុំ ពិភាក្សា និង អនុម័ត លើ ច្បាប់ ចំនួន ៤ ដើម្បី ដាក់ ក្នុង របៀបវារៈ ក្នុង សម័យ ប្រជុំ ពេញ អង្គ លើក ទី ៥ព្រឹទ្ធ នីតិកាល ទី៤ ។
របៀបវារៈ ដែល ព្រឹទ្ធសភា នឹង លើក ទៅ ពិភាក្សា និង ឱ្យ យោបល់ ក្នុង សម័យ ប្រជុំ នៅ ថ្ងៃស្អែក នេះ រួម មាន ដូច ជា៖
១៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការប្រឆាំង ហិរញ្ញប្បទាន ដល់ ការរីកសាយភាយ អាវុធ មហា ប្រល័យ ។ ២៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការប្រឆាំង ការសម្អាត ប្រាក់ និង ហិរញ្ញប្បទាន ភេរវកម្ម ។ ៣៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការជួយគ្នា ទៅ វិញ ទៅ មក ផ្នែក ច្បាប់ ក្នុង វិស័យ ព្រហ្មទណ្ឌ ។ ៤៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម ឱ្យ ព្រះរាជាណាចក្រ កម្ពុជា ចូល ជា ភាគី នៃ អនុសញ្ញា ទីក្រុង ប៊ែន ស្តីពី កិច្ចការពារ ស្នាដៃ អក្សរសាស្រ្ត និង សិល្បៈ ឆ្នាំ ១៨៨៦ និង វិសោធនកម្ម ឆ្នាំ ១៩៧៩ ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ទាំងស្រុង អំពី លទ្ធផល នៃ កិច្ចប្រជុំ គណៈកម្មាធិការ អចិន្រ្តៃយ៍ ព្រឹទ្ធសភា៖
រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល ដែល បាន ដឹកនាំ ការអប់រំ សាធារណៈ ស្តីពី វិធីសាស្ត្រ នៃ ការពារ ជំងឺ ឆ្លង បាន ក្លាយជា មន្ត្រី រដ្ឋាភិបាល ប្រទេស ហ្គាណា ចុងក្រោយ គេ ដែល បាន ធ្វើតេស្ត ឃើញ វិជ្ជមាន ចំពោះ ជំងឺ ឆ្លង ដ៏ កាច សាហាវ មួយ នេះ ។ នៅក្នុង សេចក្តីប្រកាស ខាងលើ ប្រធានាធិបតី ហ្គាណា ក៏ បាន ប្រកាស ពី មរណភាព របស់ អភិបាល ក្រុង ម្នាក់ ផងដែរ ដោយសារ ជំងឺ COVID-19 ។
ជម្លោះ ទាក់ទង នឹង ប្រាសាទ ព្រះវិហារ បាន ចាប់ ផ្ទុះឡើង ខ្លាំង នៅ ឆ្នាំ ១៩៥៤ បន្ទាប់ពី កម្ពុជា បាន ទទួល ឯករាជ្យ ពី បារាំង ។ ថៃ បាន បញ្ជូន កងកម្លាំងប្រដាប់អាវុធ ជាច្រើន ចូលមកកាន់កាប់ ប្រាសាទ ព្រះវិហារ ។
បើ ទោះបី តុលាការ ទីក្រុង ឡាអេ បាន សម្រេច បែប នេះ ។ តែ ភាគី ថៃ គោរព តែ មួយ ចំណុច ប៉ុណ្ណោះ គឺ ចំណុច ទី១ ដែល កំណត់ ថា ប្រាសាទ ព្រះវិហារ ស្ថិត នៅក្នុង ដែន អធិបតេយ្យ របស់ កម្ពុជា ។
ដោយឡែក ចំណុច ទី២ ដែល តុលាការ បង្គាប់ ឲ្យ ថៃ ដក កងកម្លាំង ចេញ ពី ប្រាសាទ និង បរិវេណ ជុំវិញ ប្រាសាទ ក្នុង ដែនដី កម្ពុជា នោះ មិន ត្រូវបាន ភាគី ថៃ អនុវត្ត ទេ ។ សម្រាប់ ថៃ អ្វី ដែល តុលាការ អន្ដរជាតិ កាត់សេចក្ដី នោះ គឺ តួ ប្រាសាទ ព្រះវិហារ ។ ដោយឡែក បរិវេណ ជុំវិញ ប្រាសាទ ដែល មាន ទំហំ ៤.៦គីឡូម៉ែត្រ ការ៉េ នោះ គឺជា កម្មសិទ្ធិ របស់ ថៃ ហើយ ថៃ មាន សិទ្ធិ ដាក់ កងកម្លាំង របស់ ខ្លួន នៅ ទីនោះ ។
ព្រោះតែ ប្រកាន់ ជំហ បែប នេះ នៅ ខែកក្កដា ឆ្នាំ ២០០៨ ថៃ បាន លើក ទ័ព ចូល លុកលុយ វត្ត កែវ សិក្ខាគិរី ស្វារៈ ជាប់ ប្រាសាទ ព្រះវិហារ ជាថ្មី ម្ដង ទៀត ។ ការចេញមក ប៉ុនប៉ង ដណ្តើម ទឹកដី នៅ តំបន់ ប្រាសាទ ព្រះវិហារ នេះ បាន កើត មាន ឡើង បន្ទាប់ពី ប្រាសាទ ព្រះវិហារ ត្រូវបាន ដាក់បញ្ចូល ក្នុង បញ្ជី បេតិកភណ្ឌ មនុស្សជាតិ ពិភពលោក នា ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០០៨ នោះ ។
ជម្លោះ ព្រំដែន រវាង កម្ពុជា និង ថៃ បាន ផ្ទុះឡើង ម្ដង ទៀត យ៉ាង ស្រួច ស្រាវ ឈានដល់ ការផ្ទុះ អាវុធ ដាក់ គ្នា ។ តួ ប្រាសាទ ព្រះវិហារ ជាច្រើន បាន រង នូវ អំបែង គ្រាប់ របស់ ទាហាន ថៃ ។ បន្ទាប់ពី ការស្វះស្វែងរក វិធី ដើម្បី បញ្ចប់ ជម្លោះ ទាំង យន្តការ ទ្វេ ភាគី និង យន្តការ អាស៊ាន មិន មាន លទ្ធផល នោះ កម្ពុជា បាន ប្ដឹង ទៅ តុលាការ យុត្តិធម៌ អន្ដរជាតិ ទីក្រុង ឡាអេជាថ្មី ឱ្យ បកស្រាយ សាល ដីកា ឆ្នាំ ១៩៦២ ឡើងវិញ ។
ទីបំផុត ទៅ នៅ ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០១៣ តុលាការ យុត្តិធម៌ អន្ដរជាតិ បាន បកស្រាយ សាល ដីកា ឆ្នាំ ១៩៦២ ឡើងវិញ និង បាន សម្រេច ថា កម្ពុជា មាន អធិបតេយ្យភាព លើ ដែនដី ទាំងមូល នៃ តំបន់ ប្រាសាទ ព្រះវិហារ និង សម្រេច ឱ្យ ភាគី ថៃ ដក កងកម្លាំងប្រដាប់អាវុធ និង ឆ្មាំ ប្រាសាទ ទាំងអស់ ចេញ ពី បរិវេណ ជុំវិញ ប្រាសាទ ។
ក្រសួង កសិកម្ម ស្នើឲ្យ ក្រុមហ៊ុន វិនិយោគ បង្វែរ មក បង្កើត រោងចក្រ កែច្នៃ និង ផលិត ក្រដាស នៅ កម្ពុជា ប្រសើរ ជាង ដឹកជញ្ជូន វត្ថុធាតុ ដើម ទៅ ប្រទេស ថៃ
( បន្ទាយមានជ័យ )៖ លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ស្នើឲ្យ ក្រុមហ៊ុន វិនិយោគ បង្កើត កសិដ្ឋាន បណ្តុះ កូន ឈើ និង ដាំ ឈើ ឧស្សាហកម្ម ( ដើម ប្រេង ខ្យល់ ) ដែល មាន ទីតាំង ស្ថិត ក្នុង ខេត្ត បន្ទាយមានជ័យ បង្វែរ មក បង្កើត រោងចក្រ កែច្នៃ និង ផលិត ក្រដាស នៅ កម្ពុជា ប្រសើរ ជាង ដឹកជញ្ជូន វត្ថុធាតុ ដើម ទៅ ប្រទេស ថៃ ។
បើ តាម តំណាង ក្រុមហ៊ុន នេះ បញ្ជាក់ ថា ក្រុមហ៊ុន បាន វិនិយោគ បង្កើត កសិដ្ឋាន បណ្តុះ កូន ឈើ និង ដាំ ឈើ ឧស្សាហកម្ម ( ដើម ប្រេង ខ្យល់ ) និង សាងសង់ រោងចក្រ កែច្នៃ ឈើ ពាក់កណ្តាល សម្រេច ដើម្បី យក ចំណិត ឈើ ទៅ ផលិត ជា ក្រដាស និង ជា ថាមពល នៅ ប្រទេស ថៃ ។
រដ្ឋមន្ត្រី បាន លើកទឹកចិត្ត និង គាំទ្រ ក្រុមហ៊ុន ឱ្យ ពង្រីក ការដាំ ឈើ លើ ផ្ទៃដី ដែល មាន ស្រាប់ និង ធ្វើ កិច្ចសន្យា ដាំ ជាមួយ ក្រុមហ៊ុន ក្នុង ស្រុក ជាមួយ កសិករ ដើម្បី ចូលរួមចំណែក លើកស្ទួយ ជីវភាព ប្រជាពលរដ្ឋ មូលដ្ឋាន និង គាំទ្រ និង លើកទឹកចិត្ត ក្នុង ការប្រើប្រាស់ កែច្នៃ វត្ថុធាតុ ដើម ជា ឈើ ដាំ ក្នុង ស្រុក ព្រមទាំង លើកទឹកចិត្ត ដល់ ការដាំ ឈើ ជា ចម្ការ លក្ខណៈ គ្រួសារ តាមរយៈ ផលិតកម្ម តាម កិច្ចសន្យា ( រវាង ក្រុមហ៊ុន និង ប្រជាពលរដ្ឋ មូលដ្ឋាន ) ។
បច្ចុប្បន្ន ក្រុមហ៊ុន បាន កាប់ ប្រមូល ពី ចម្ការ ឈើ ដាំ ខាងលើ មួយចំនួន និង ទទួល ទិញ ពី ប្រជាពលរដ្ឋ ពី បណ្តា ខេត្ត នានា ( ខេត្ត បន្ទាយមានជ័យ បាត់ដំបង ប៉ៃលិន សៀមរាប ឧត្តរមានជ័យ កំពង់ធំ ព្រះវិហារ តាកែវ និង ខេត្ត កំពត ) ដឹក មកកាន់ រោង ម៉ាស៊ីន កែច្នៃ ឈើ របស់ ខ្លួន នូវ បរិមាណ សរុប ចំនួន ៩ ៧៦៥តោន ភាគ ច្រើន ដើមឈើ ប្រេង ខ្យល់ K7 ។
ក្រុមហ៊ុន មាន ដើម ប្រេង ខ្យល់ សម្រាប់ ផ្គត់ផ្គង់ រោងចក្រ កែច្នៃ នេះ បាន មកពី ចម្ការ ឈើ ដាំ ( ផលិតកម្ម តាម កិច្ចសន្យា ជាមួយ ប្រជាពលរដ្ឋ និង អង្គភាព នៃ កងយោធពល ខេមរភូមិន្ទ ) ក្នុង ខេត្ត បន្ទាយមានជ័យ បាត់ដំបង ប៉ៃលិន សៀមរាប និង ខេត្ត ឧត្តរមានជ័យ ។
ក្រុមហ៊ុន ទទួលបាន គោលការណ៍ អនុញ្ញាតឲ្យ នាំចេញ ពី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នូវ ផលិតផល ឈើ ចិញ្រ្ចាំ ឬ កម្ទេច ឈើ កែច្នៃ ពី ឈើ ដើម ប្រេង ខ្យល់ ចំនួន ៥០.០០០ តោន ឆ្នាំ ២០២០ - ២០២១ ហើយ ក្រុមហ៊ុន កំពុង បំពេញ បែបបទ ស្នើសុំ អាជ្ញាប័ណ្ណ នាំចេញ ផលិតផល ឈើ ចិញ្រ្ចាំ ឬ កម្ទេច ឈើ កែច្នៃ ពី ឈើ ដើម ប្រេង ខ្យល់ ចំនួន ៤.០០០តោន ទៅកាន់ ប្រទេស ថៃ តាម ច្រក ភ្នំ ដី ស្រុក សំពៅលូន ខេត្ត បាត់ដំបង ផងដែរ ៕
សូម កុំ បើកបរ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ ស្រាល ១៦ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៤ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មាន មនុស្ស ៤នាក់ ស្លាប់ និង របួស ធ្ងន់ ស្រាល ១៦ នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន ប្រកាន់ ស្តាំ . ង ងុយ និង មិន គោរព សិទ្ធិ ៕
សមត្ថកិច្ច ខេត្ត កំពង់ធំ បញ្ជូន ខ្លួន ស្ត្រី ម្នាក់ តាម បណ្តឹង ជនរងគ្រោះ ករណី រកស៊ី បន្លំ ភ្នែក ជញ្ជីង បញ្ជូន មក តុលាការ
( កំពង់ធំ )៖ នគរបាល ស្រុក សណ្ដាន់ នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២០ នេះ បាន បញ្ជូន ខ្លួន ស្ត្រី ម្នាក់ តាម បណ្តឹង របស់ ជនរងគ្រោះ ករណី រកស៊ី បន្លំ ភ្នែក ជញ្ជីង ដោយ យក កៅស៊ូ ស្បែកជើង មក កល នៅ ម៉ាស័រ នៅក្នុង ជញ្ជីង ដើម្បី គេង ចំណេញ ក្នុង ការទិញ លក់ ទំនិញ ជួញដូរ ដើម្បី បំបាត់ ភ្នែក ជញ្ជីង ក្នុង ១០០ គីឡូក្រាម បាត់ ២០ គីឡូ មកកាន់ សលា ដំបូង ខេត្ត ចាត់ការ តាម ច្បាប់ ។
ជនសង្ស័យ ដែល សមត្ថកិច្ច ឃាត់ខ្លួន តាម បណ្តឹង មាន ឈ្មោះ យ ន បុប្ផា ភេទ ស្រី ដែល ជា អ្នកទិញ កៅស៊ូ ស្ថិត នៅ តំបន់ អូស្រែ ស្តៅ ភូមិ លែង ឃុំ ទំរីង ស្រុក សណ្ដាន់ ខេត្ត កំពង់ធំ ។ ចំណែក ម្ចាស់ បណ្តឹង មាន ឈ្មោះ ស្រួយ ម៉េង គង់ ។
សូម បញ្ជាក់ ថា ចំពោះ កាបូប លុយ ដែល លោក វរសេនីយ៍ ទោ អ៉ីវ ឈុន ផេង អធិការ រង នគរបាល ខណ្ឌ ឫស្សីកែវ បាន ជ្រុះ បាត់ ក្នុង ពេល បំពេញ ភារកិច្ច មាន ឯកសារ សំខាន់ ៗ មួយចំនួន ដូច ជា៖
លោក សាយ សំអាល់ សំណេះសំណាល និង ផ្សព្វផ្សាយ គោលការណ៍ ចាត់តាំង មុខ តំណែង មន្ត្រី គណបក្ស នៅ ថ្នាក់ ក្រោម ជាតិ និង របៀបរបប ការងារ ដល់ ក្រុមការងារ CPP ខេត្ត ព្រះសីហនុ
លោក សាយ សំអាល់ ក៏ បាន កើត សរសើរ ផងដែរ ចំពោះ ខេត្ត ព្រះសីហនុ ដែល បាន ចូលរួម ទប់ស្កាត់ និង បង្ការ មិន ឱ្យ មាន ការចម្លង ជំងឺ កូវីដ ១៩ ក្នុង សហគមន៍ និង បាន ផ្តល់ នូវ ការព្យាយាម យ៉ាង យកចិត្តទុកដាក់ លើ អ្នកជំងឺ ដែល បាន ឆ្លង ជំងឺ កូវីដ ១៩ រហូត បាន ជាសះស្បើយ អស់ ។
ជាមួយគ្នា នេះ លោក សាយ សំអាល់ មានប្រសាសន៍ ថា គណបក្ស ប្រជាជន កម្ពុជា បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការសង្គ្រោះ ជាតិ និង ប្រជាជន រំលាយ អង្គការ ចាត់តាំង នយោបាយ និង យោធា របស់ ខ្មែរ ក្រហម នាំយក សុខ សន្តិភាព ពេញលេញ មាន ការឯកភាព ជាតិ ឯកភាព ទឹកដី និង នាំឱ្យ មាន ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ មាន កំណើន សេដ្ឋកិច្ច និង បាន ផ្តល់ ឱកាស ពេញលេញ ដល់ កម្ពុជា ក្នុង ការអភិវឌ្ឍ និង គិតគូរ លើ បញ្ហា ផ្សេង ៗ ។
លើស ពី នេះ លោក សាយ សំអាល់ ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ខេត្ត ព្រះសីហនុ បាន ណែនាំ ក្រុមការងារ ត្រូវ ខិតខំ អនុវត្ត តាម ការណែនាំ របស់ គណៈ អចិន្ត្រៃយ៍ កុំ ធ្វើ សេចក្តីសម្រេចចិត្ត ជំនួស គណបក្ស មូលដ្ឋាន ប៉ុន្តែ ត្រូវ ជួយ សម្របសម្រួល បន្ថែម ដើម្បី ប្រសិទ្ធភាព ក្នុង ការបម្រើ ជាតិ និង ប្រជាជន ៕
ចូរ ប្រាប់ មនុស្ស ជា ទី ស្រលាញ់ ពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៤ ខែមិថុនា៖ បង្ក្រាប ៣៥ ករណី ឃាត់ខ្លួន ៦០ នាក់
