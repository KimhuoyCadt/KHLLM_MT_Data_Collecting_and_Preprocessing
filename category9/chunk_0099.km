និង សម្លាប់ រង្គាល ប្រជាជាតិ ជា ច្រើន ឥត គណនា ។
ទេរី វចនានុក្រម អេឡិចត្រូនិច នេះ របស់ អ្នកណា ?
២២ អ្នក ដែល ទទួល គ្រាប់ ពូជ ក្នុង ដី មាន បន្លា គឺ អ្នក ដែល បាន ឮ ព្រះបន្ទូល ប៉ុន្តែ ការ ខ្វល់ ខ្វាយ អំពី ជីវិត ក្នុង លោកីយ៍ ចិត្ត លោភលន់ ចង់ បាន ទ្រព្យ សម្បត្តិ រួប រឹត ព្រះបន្ទូល មិន អោយ បង្កើត ផល បាន ឡើយ ។
ធម្មតា ការយល់ព្រមព្រៀង ត្រូវ មាន ឯកសារ ជាបន្ទាល់ អាច ជា លក្ខណៈ លំអិត ឬ ជា គោលការណ៏ ។
ភ្នែក របស់ អ្នក ត្រូវ សំឡឹង មើល តែ គោលដៅ បាន ហើយ ។
" បង ប្អូន ជ្រាប ស្រាប់ ហើយ អំពី អាកប្បកិរិយា ដែល ខ្ញុំ មាន ចំពោះ បង ប្អូន រាល់ ពេល វេលា តាំង ពី ថ្ងៃ ដំបូង ដែល ខ្ញុំ បាន ទៅ ដល់ ស្រុក អាស៊ី ម៉្លេះ ១៩ គឺ ខ្ញុំ បាន បំរើ ព្រះអម្ចាស់ ដោយ ចិត្ត សុភាព រាបសា ទាំង ទឹក ភ្នែក ទាំង លំបាក ដោយ ជន ជាតិ យូដា បាន ឃុបឃិត គ្នា ប៉ុនប៉ង ធ្វើ បាប ខ្ញុំ ។
ខណៈពេលនេះ កម្មករ រោងចក្រ ជាច្រើន នាក់ ...
" ខ្ញុំ ជា សេដ្ឋវិទូ មិន មែន ជា អ្នក ជំនាញ កសិកម្ម ទេ ប៉ុន្តែ ខ្ញុំ យល់ ថា វិស័យ កសិកម្ម គឺ ជា បញ្ហា ស្មុគស្មាញ ។
ជា រៀងរាល់ ឆ្នាំ បន្ថែម ទៀត ។
អ្នក ត្រូវ ពិចារណា ថា ហេតុ អ្វី បាន ក្រុមហ៊ុន ឬ ស្ថាប័ន នេះ មិន អាច រក្សា បុគ្គលិក ដែល ល្អ ឲ្យបាន យូរអង្វែង ?
ត្រសក់ អាច កំចាត់ មុន នៅ លើ ផ្ទៃ មុខ
រដ្ឋាភិបាល សហរដ្ឋ អាមេរិក នឹង ចែកចាយ ភ្លាម ៗ
មិន មែន ត្រឹម អ្នក នៅក្នុង បក្ស ប្រឆាំង ទេ សូម្បី តែ អ្នក សាធារណរដ្ឋ ដូច គ្នា ក៏ លែង អាច ទប់ ចិត្ត បាន ។
រីឯ អ្នក រាល់ គ្នា វិញ មាន តម្លៃ លើស បក្សា បក្សី ច្រើន ណាស់ ។
មិត្តភក្ដិ ក៏ មិន អាច ផ្ដល់ អារម្មណ ដ៏ រ៉ូមែនទិក មួយ សម្រាប់ អ្នក បាន ដែរ ។
ហើយ អាច អនុញ្ញាត អោយ បន្ត ការងារ បើ មាន ការ ចាំបាច់ ។
ក្មេង អកត្ត ញ្ញូ ទាំង នោះ ច្រើន តែ ធ្វើ ឲ្យ គាត់ ព្រួយ ចិត្ត ។
របស់ អ្នក គឺ ច្បាស់ ថា មាន មួយ ចំណែក តូច ប៉ុណ្ណោះ ។
ក៏ប៉ុន្តែ សំណួរ បែប ហ្នឹង មិន ត្រូវ បាន សួរ ទៅកាន់ បុរស ទេ ។
២៦ បើ ព្រះអង្គ បូជា ព្រះជន្ម ច្រើន ដង ព្រះអង្គ មុខ ជា ត្រូវ រង ទុក្ខ លំបាក ច្រើន លើក ច្រើន សា តាំង ពី កំណើត ពិភព លោក មក ។
វេយ្យាករណ៍ បាលី - អង់គ្លេស ឬ ទាញយក
អត្ថបទ មុន ក្រោយ លោក សម រង្ស៊ី ចង់ឲ្យ អតីត សកម្មជន ខ្លួន ជាប់ គុក
៤ មកដល់ ត្រឹមណេះ យើង មិន ទាន បាន ថ្លែង
ហើយ ក៏ កាត់ តាម មហាវិថី ព្រះ នរោត្ដម ហ្នឹង ដែរ ។
(1) មុនពេល សណ្ដំ ពេល ចាប់ផ្ដើម សណ្ដំ កំពុង សណ្ដំ ក្រោយពេល វះកាត់
មនុស្ស ចំនួន ១០ ផងដែរ បាន បាត់ ខ្លួន នៅក្នុង ហេតុការណ៍ ដ៍ រន្ធត់ នេះ ។
លោក ប្រកាស ដូច្នេះ ស្រប តាម សេចក្ដី ដែល មាន ចែង ទុក ក្នុង គម្ពីរ ព្យាការី អេសាយ ថា៖
វា ភ័យ ណាស់ ទាំង គេ ទាំង យើង ប្រជាជន អ្នក រក ស៊ី សុទ្ធតែ អ្នក ភ័យ ព្រួយ ទាំងអស់ គ្នា ហ្នឹង ។
បរិមាណ មនុស្ស ៖
២៣ អ្នក រាល់ គ្នា មិន ត្រូវ យក មាស ឬ ប្រាក់ មក ធ្វើ ជា រូប ព្រះ សំរាប់ ថ្វាយបង្គំ ដូច ថ្វាយបង្គំ យើង ឡើយ ។
ក្រោយ ពេល លទ្ធផល ចុង ក្រោយ ត្រូវ បាន សម្រេច ។
របស់ សម្តេច ឲ្យ ស្អប់ លោក ដូណាល់ ត្រា ។
យើង នឹង សិក្សា រឿង នេះ នៅ ក្នុង ព្រះ គម្ពីរ ។
អ្វី ដែល យើង ទាំងអស់ គ្នា ធ្វើ នៅ ប៉ុន្មា ន ថ្ងៃ និង សប្តាហ៍ ខាងមុខ នេះ នឹង កំណត់ អនាគត របស់ យើង ។
ហើយ ចាស ត្រឹមត្រូវ ណាស់ ខ្ញុំ រវល់ ជាមួយ កិច្ចការ សាលា ផង និង ការងារ របស់ ខ្ញុំ ផង ។
- ចូរ គូ ផែនទី ផ្លូវ ដែល អ្នក ធ្លាប់ ធ្វើដំណើរ ជា ញឹកញាប់
គម្រោង ពីរ ក្នុង ចំណោម នេះ ក៏ មាន វិនិយោគិន ក្នុង ស្រុក ចូល រួម ផង ដែរ ៕
ថ្ងៃ ភ្ជុំ គេ នាំ គ្នា ខំ ធ្វើ បុណ្យ បុរស ម្នាក់ បែរជា លួច រថយន្ត គេ ទៅ វិញ
ក្ខនារ មាន ចំណាប់អារម្មណ៍ សូម យក ពាក សុំ
បើ អ្នក ចង់ ក្លាយ ជា មហាសេដ្ឋី ទាល់តែ អ្នក ត្រូវ មាន ការ គិត ឲ្យ ដូច មហាសេដ្ឋី ។
មក ពី ខ្ញុំ អង្គុយ ធ្វើ ការ រហូត ហើយ កន្លែង អង្គុយ មិន ស្រួល ។
ធ្វើ ឬ មិន ធ្វើ
វា គ្រាន់តែ ការ ស្រមៃ របស់ គាត់ តែ ប៉ុណ្ណោះ នៅពេល នោះ ប៉ុន្តែ គាត់ បាន សន្សំ ប្រាក់ បន្តិច ម្តង ៗ
ដូច្នេះ ព្រះអម្ចាស់ ក៏ ពុំ អាច រំដោះ ក្រុង យេរូសាឡឹម អោយ រួច ពី កណ្ដាប់ ដៃ របស់ យើង បាន ដែរ !
អា ហ្នឹង ជា គ្រោះថ្នាក់ សម្រាប់ សង្គម ជាតិ យើង នា ពេល ខាង មុខ ។
សរុប សេចក្តី កិច្ចការ ផ្ទះ គឺ សំខាន់ ណាស់ សម្រាប់ កូន របស់ អ្នក ។
ខ្ញុំ បាន ចាក់ អតីត ប្តី របស់ ខ្ញុំ ដោយ កាំបិត ។
សំខាន់ និង លេចធ្លោ ជាង គេ សម្រាប់ ឆ្នាំ ២០១១ ។
លំដាប់ នោះ មារ មាន ចិត្ត បាប ដឹង ថា វិជយាភិក្ខុ នី ស្គាល់ អញ ហើយ ក៏ មាន សេចក្តី ទុក្ខ តូច ចិត្ត បាត់ អំពី ទីនោះ ឯង ។
នោះ បុរស នេះ បាន ដួល ដោយ ខ្លួន ឯង ក្រោយ ចំណាយ ពេល ជិត ១០ ម៉ោង នៅលើ ដំបូល ហើយ ប៉ូលិស បាន ឃាត់ខ្លួន គាត់ ភ្លាម ៗ
បូរ៉ា បាន រំឭក ពី មូលហេតុ ដែល នាំ ឲ្យ ខ្លួន រសាត់ អណ្ដែត មក ទីក្រុង ថា៖
លើក ដំបូង នៅ កម្ពុជា
លោក បាន ចែករំលែក បទ ពិសោធន៍ ជា ច្រើន ដែល លោក ធ្លាប់ ទទួល បាន រង្វាន់ ណូបែល សន្តិភាព ពី អង្គការ សហ ប្រជាជាតិ ក្នុង ឆ្នាំ ២០០១ ។
បទ ឈប់ បាញ់ នឹង អស់ សុពលភាព ពី យប់ ថ្ងៃទី ១៧ មិថុនា ហើយ បណ្ដា យុទ្ធនាការ នឹង បន្ត ទៅ ទៀត ។
ព្រោះ តែ វា មាន កម្លាំង ដ៏ ខ្លាំងក្លា
ក្រោយ ពី ធ្វើ ការ ស្រាវជ្រាវ បន្តិច លោក បាន រក ឃើញ បុរស ឥណ្ឌូនេស៊ី ម្នាក់ ធ្លាប់ បង្កើត ឯតទគ្គកម្ម អង្គុយ លើ ដើម ឈើ រយៈពេល ២៨ ថ្ងៃ ។
គ្រប់ គ្នា ប្រាថ្នា ចង់ បាន យ៉ាង ខ្លាំង ផង ដែរ ។
