នៅ ចំពោះ មុខ ពេល នេះ ប្រហែល ជា គ្មាន ទេ ដំណោះស្រាយ ល្អ ឥត ខ្ចោះ សម្រាប់ ខេត្ត អ៊ីដឡិប ។
លោក ប្រធានា ធិបតី ត្រូវ គោរព សេច ក្តី សម្រេច អំពី អំណាច នៃ សង្គ្រាម ។
ហើយ កូនស្រី ដែល មាន អាយុ ១០ ឆ្នាំ ឡើង ត្រូវ ជួយ ធ្វើ កិច្ចការ ផ្ទះ ។
តារាចម្រៀង រៀមច្បង ក្នុង សិល្បៈ រូប នេះ និយាយ ថា៖
ការស៊ើបអង្កេត ផ្លូវការ មួយ ត្រូវបាន ប្រកាស នៅ ខែ កក្កដា ឆ្នាំ ២០១៤ ក្រោយ លេច ឮ ពាក្យ ចចាមអារ៉ាម រាប់ ខែ និង ចាប់ តាំងពី ពេល នោះ លោក ត្រូវបាន បណ្តេញ ចេញ ពី គណបក្ស កុំ ម្មុយនីស្ត ។
ចំពោះ គម្រោង ទី៣ កំពុង អនុវត្ត និង ទី ៤ នឹង ចាប់ផ្តើម អនុវត្ត នៅ ឆ្នាំ ២០២០ ខាងមុខ នេះ ៕
ដូច្នេះ វា នឹង ធ្វើអោយ អ្នក មាន ជំនឿ ចិត្ត និង កម្លាំង ដើម្បី បន្ត ការងា រត ទៀត មុន ពេល សម្រាក ពេល ល្ងាច ។
ឪពុក ម្តាយ របស់ កុមារា គីម ហុង សព្វ ថ្ងៃ គឺ កំពុង រស់ នៅ ទីតាំង ខាងលើ នេះ ផងដែរ ៕
តើ អ្នក រាល់ គ្នា រង់ចាំ អ្វី នៅ ថ្ងៃ របស់ ព្រះអម្ចាស់ ?
ពិបាក ណាស់ ធ្វើ ម៉េច បើ យើង ជា អ្នកក្រ ។
ប៉ុន្តែ នាង គ្មាន ថ្ងៃ អាច ឱ្យ គេ គ្រប់គ្រង បាន ទេ ។
បន្ទាប់មក គេ មិន ត្រូវ ផឹក អ្វី ឬ ទទួលទាន អ្វី ទេ ក្នុង ចន្លោះ ពេល ៤៥ នាទី ក្រោយ មក ។
សិច អស្ចារ្យ បង ស្រី
គ្រប់ បែបយ៉ាង មិន ចេះ ឆ្អែត មិន ចេះ ចប់ ។
ទៅ រួច ម៉ា អាណត្តិ ៗ
ការគំរាម នេះ ហាក់ បាន ក្លាយ ជា ទម្លាប់ មួយ ទៅ ហើយ ៕
យប់ ស្អែក ជា យប់ កាត់ សេចក្ដី បើ ក្រុម ឈ្នះ បន្ត ឈ្នះ ទៀត ប្រទេស ទាំង ២ នេះ នឹង ជាប់ ដោយ ស្វ័យ ប្រវត្តិ ។
ដូចនេះ អ្នក គួរតែ ប្រយ័ត្ន ពី របប អាហារ របស់ អ្នក ។
នៅ មាន ព្រះពុទ្ធ ផ្ទំ នៅ ចំ ពីមុខ ផងដែរ ។
ប៉ុន្តែ យ៉ាងណា ក៏ដោយ លោក ហ៊ួ ត រ័ត្ន ក៏ ត្រូវ
ខ្ញុំ អត់ ដឹង ថា អាច ដំណើរការ យ៉ាងណា ទេ ។
ថា គេ គ្រោង នឹង អភិវឌ្ឍន៍ វាល ស្មៅ មុខ អង្គរ ឡើងវិញ ហើយ ការលក់ដូរ ក៏ នឹង លែង មាន តទៅទៀត ដែរ ។
បរិសុទ្ធ ដែល សង្ឃឹម ដល់ ព្រះ ក៏ បាន តែង ខ្លួន យ៉ាង ដូច្នោះ ទាំង ចុះ ចូល ចំពោះ ប្ដី ខ្លួន ដែរ
ខ្ញុំ បាន និពន្ធ ច្រើន លើក ច្រើន សារ ណាស់ ។
យុវជន ចាប់ ផ្ដើម ស្គាល់ តម្លៃ នៃ សន្លឹក ឆ្នោត របស់ ខ្លួន ។
ខ្ញុំ ហាក់ ដូច ជា ភ្លឺ ភ្នែក ថា លោក គ្រូ ខ្ញុំ ហ្នឹង គ្រាន់ តែ បោក ខ្ញុំ ប្រើ ប៉ុណ្ណោះ ។
មនុស្ស ខ្លះ និយាយ ថា វា ក៏ អាច ជួយ ជម្រុញ ដល់ សមត្ថភាព ទារក ប្រឆាំង នឹង មេរោគ ។
គ្រោះថ្នាក់ បំផុត - សូម ជៀសវាង
សង្ស័យ អា ព្រះអង្គម្ចាស់ ស្អី គេ នោះ មកដល់ ទៀត ហើយ !
ចាប់តាំងពី មាន ចៅ ស្រី មក លោក អ៊ិន សុភិន ដូច ប្លែក ជាង មុន
ខ្លាំង ណាស់ ខ្ញុំ ចូលចិត្ត ស្ដាប់ ណាស់ ?
មនុស្ស ប្រុស មិន ខូច ស្រី មិន ស្រទ្បាញ់ - អាន គុណ កូទ្បា
យក ច្រៀង សម្រាប់ ខ្លួន ឯង ។
និង សហការ ជាមួយ ដៃគូរ របស់ យើង មាន អង្ក
តែ សំរាប់ លោកគ្រូ ចិត្រ អត់ ដឹង ថា គាត់ ដាក់ នរណា ទេ
វេវចនៈ មនុស្ស ឃាត ។
អ្នក អាច ចេញ ក្រៅ ជាមួយ អ្នកណា ម្នាក់ បាន ដោយ គ្មាន ក្តី ព្រួយ បារម្ភ ។
ដូច្នេះ គាត់ ទៅ ថៃ ដើម្បី រក ការងារ មួយ ទៀត ។
ប្រទេស អភិវឌ្ឍន៍ ត្រូវ តែ ពង្រឹង ការ ផ្តល់ ហិរញ្ញប្បទាន ប៉ុន្តែ ត្រូវ តម្រូវ ឲ្យ មាន ការ ប្តេជ្ញា ច្បាស់លាស់ ដើម្បី ផ្លាស់ប្តូរ សកម្មភាព ផ្សេង ៗ
ការងារ ក៏ ដូចជា ការសម្តែង ដូច្នេះ នាងខ្ញុំ គ្មាន ពេល គិតគូរ ទៅ លើ រឿង នេះ នោះ ទេ ។
អរគុណ ដល់ បងប្អូន ទាំងអស់ គ្នា ពេលនេះ បង ប្រុស ខ្ញុំ មានអាការះ ធូរស្រាល បន្តិច ហេីយ ។
ពួក ចាស់ ទុំ របស់ អ្នក រាល់ គ្នា នឹង យល់ សុបិន និមិត្ត
ខ្ញុំ គិត ថា នេះ គឺ ជា អ្វី ដែល រដ្ឋាភិបាល ទី ក្រុង អង់ការ៉ា កំពុង ពឹង ផ្អែក លើ ។
អ្នកនាំពាក្យ រូប នេះ បាន បន្ត ថា នៅពេល ឆាប់ ៗ
ព្រោះ ភាគ ច្រើន ខ្ញុំ អាន សៀវភៅ ទាំង អស់ ដែល ខ្ញុំ មើល ហើយ ចាប់ អារម្មណ៍ ចង់ អាន ។
ប៉ុន្តែ មាន ពេល ខ្លះ វា ជា ការចាំបាច់ ។
អ្នក គាំទ្រ ឡៅ ចន្រ្ទា ម្នាក់ នេះ ឡូយ កប់
ក្រោយពី ត្រួតពិនិត្យ រួចហើយ ពិតជា ធ្វើ អត្តឃាត ខ្លួន ឯង ប្រាកដ មែន ៕
ទោះ យ៉ាងណា សុវត្ថិភាព និង ប្រសិទ្ធភាព នៃ ផលិតផល ទាំងនេះ មិន អាច ត្រូវបាន ធានា នោះ ទេ ។
លោក សុខ សំអឿន បាន និយាយ ថា លោក សង្ឃឹម ថា ក្រោយពី ពេល សវនាការ
ធ្វើអោយ ប្រជាពលរដ្ឋ ក្តៅក្រហាយ ត្រូវ ចាប់ អោយ ប្រជាពលរដ្ឋ កាត់ទោស ភ្លាម !
" ប្រសិនបើ ពួកគេ មិន យល់ស្រប ទេ យើង ច្បាស់ ជា ចេញ ពី អឺរ៉ុប ទាំង គ្មាន កិច្ចព្រមព្រៀង មិន ខាន ។
ក្នុង ការ គ្រប់គ្រង រយៈពេល ៨ឆ្នំា កន្លង ទៅ នេះ គ្មាន ទាហាន បែលហ្ស៊ិក ណា ម្នាក់ បាន បាត់បង់ ជីវិត ទេ ។
៦. នាង កំពុង បំផ្លាញ កិត្តិយស ខ្លួន ឯង គ្រួសារ និង អនាគត នាង ទាំង មូល
នាងខ្ញុំ ស្រៀវ ខ្លួន ណាស់ ពេល ឮ ជម្ងឺ នេះ ។
នៅ ចំ កណ្តាល រាជធានី ព្រះ អង្គ បាន កសាង ប្រាសាទ បាយ័ន ដើម្បី ទុក គោរព ដល់ ព្រះពុទ្ធ សាសនា ។
ក្នុង កាលៈទេសៈ ខ្លះ ពួកគេ អាច ជា មធ្យោ បាយ មួយ ដើម្បី បង្ហាញ ឧបករណ៍ យោធា ថ្មី និង មី ស៊ី ល ផ្លោង ទៅកាន់ ពិភពលោក ក្នុង ការ ប្រឆាំង នឹង ទណ្ឌកម្ម អន្តរជាតិ ។
ហើយ ខ្ញុំ ចង់ ប្រាប់ ឲ្យ នារី ៗ
ម្យ៉ាង វិញ ទៀត អ្នក ត្រូវ ដឹង ឲ្យ ច្បាស់ ពី អ្វី ដែល អ្នក កំពុងតែ អាន ។
និយាយ = ទ្រង មាន ព្រះបន្ទូល , ទ្រង់ មាន ព្រះតម្រាស់ , ព្រះសវនីយ ព្រះអគ្គមហេសី
សូម ព្រះអង្គ ប្រទាន អោយ បង ប្អូន អាច បំពេញ បំណង ដ៏ ល្អ គ្រប់ យ៉ាង និង អោយ ជំនឿ របស់ បង ប្អូន បង្កើត ផល បាន បរិបូណ៌ ដោយសារ ឫ ទ្ធានុភាព របស់ ព្រះអង្គ ។
ដែល ប្រព្រឹត្តិ ខាង ញុះញង់ ។
បន្ថែម នេះ លោក វុំ វណ្ណេ បាន ថ្លែង ថា ចំពោះ ប្អូន ៗ
ប៉ុន្មាន ថ្ងៃ ដើរ កាត់ ទីនេះ ខ្ញុំ ខំតែ ជឿ ថា ឯង ជា មនុស្ស ខ្វាក់ ។
មនុស្សម្នា គេ មិន ដេក ដល់ ស្លាប់ ទេ ។
