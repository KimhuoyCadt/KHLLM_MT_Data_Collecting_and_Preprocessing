ព្រះ យេស៊ូវនឹង « ត្រូវសងសឹកដល់អ្នកដែលមិនស្គាល់ព្រះ និងអ្នកដែលមិនស្តាប់តាមដំណឹងល្អនៃព្រះ យេស៊ូវជាអម្ចាស់នៃយើង ។
ប្រារព្ធ ជារៀងរាល់ ឆ្នាំ នៅ បុណ្យ ណូអែល ។
ប្រាកដ ណាស់ ថា ពួកគេ នឹង ទទួលបាន សេវា ថោក ទាប ឬ បញ្ជូន ទៅកាន់ សេវា
៤៥ - ទ្រង់ក្រោកឡើងពីការ អធិស្ឋាន ទ្រង់យាងត្រឡប់ទៅ ឯពួកសិស្ស ហើយឃើញគេដេក លក់អស់ទៅ ដោយសេចក្តី ទុក្ខព្រួយ ។
អ្នក ដាក់ បន្ទុក លើ ភាគី ម្ខាង ទៀត ដើម្បី បញ្ជាក់ មិន មែន អ្នកបដិសេធ ទេ ។
ហើយអ្វីដែលខ្ញុំបានឃើញធ្វើឲ្យខ្ញុំភ័យខ្លាច » ។
ម៉េចមិនទៅប្រាប់ស្ត្រីនោះ ?
អ្នកនឹងត្រូវញែកចេញពីគ្នាចំពោះព្រះអម្ចាស់ ។
"IDF និង ការបង្កើត សន្តិសុខ ត្រូវតែ ត្រៀមខ្លួន សម្រាប់ គ្រប់ លទ្ធភាព ទាំងអស់ " ។
៤៣ កាលពួកគេបានចប់សព្វគ្រប់ហើយ ពេលត្រឡប់មកវិញ ក្មេងប្រុសយេស៊ូក៏នៅ តែនៅក្រុងយេរូសាឡិម ប៉ុន្តែឪពុកម្ដាយមិនបានដឹងទេ ។
ប៉ុន្តែ ខ្ញុំ ពិតជា មាន មោទនៈ ភាព ណាស់ ដែល មនុស្ស ជាច្រើន បាន នៅ ទីនោះ យូរ មកហើយ ។
ភស្តុតាង បន្ថែម ទៀត ថា វា ត្រូវបាន កំណត់ នៅក្នុង ពិភពលោក ផ្សេង ទៀត ។
បពិត្រ ព្រះអង្គ ដ៏ ចំរើន ថ្ងៃ នេះ ព្រះបុត្រា របស់ ព្រះអង្គ បាន យាង ឡើង ទៅ ស្ថាន សួគ៌ ដូច ពួក សាវ័ក ទត មើល សូម ប្រោសប្រទាន ទូលបង្គំ ទូលបង្គំ ទូល អង្វរ ថា ស្រប តាម ការសន្យា របស់ ព្រះអង្គ ទូលបង្គំ យើងខ្ញុំ នឹង បាន សក្តិសម នឹង ព្រះអង្គ គង់ នៅ ជាមួយ យើង ជានិច្ច នៅលើ ផែនដី ហើយ យើងខ្ញុំ នៅ ជាមួយ ព្រះអង្គ នៅ ស្ថាន បរម សុខ ។
ខែ ទី ប្រាំបួន បាន មកដល់ ហើយ ។
គាត់ បាន ប្រាប់ នាង ថា រថភ្លើង មកដល់ នៅ ម៉ោង ប្រាំបី ។
អ្នក នឹង ឃើញ មូលហេតុ នៅ ទីនេះ ។
មូលហេតុនៃការ បំផ្លាញដល់គ្រួសារទាំងមូល ហើយថាអ្នកនឹងមិនទទួល ទោសសម្រាប់វា ?
៣៨ រួចលោកមាន ប្រសាសន៍ទៅពួកគាត់ ថា៖ « ព្រលឹងខ្ញុំព្រួយ ចិត្តជាខ្លាំងរហូតដល់ស្លាប់ សូមស្នាក់នៅ ទីនេះ ហើយចាំយាមជាមួយខ្ញុំ » ។
ពេលនេះ គាត់ និង ជំនួយការ របស់ គាត់ ជាច្រើន នាក់ កំពុង ជាប់ ពន្ធនាគារ រង់ចាំ ការកាត់ក្តី ។
ឥឡូវគេមើលឃើញថាជា ស ត្រូវរបស់ប្រជាជន ។
ទទួលបានការ គោរពខ្ពស់ដោយអ្នក ស្រឡាញ់កាហ្វេពីជុំវិញពិភពលោកតាំងពីឆ្នាំ ២០០៩ ។
រឿង មួយ ទៀត - ប្តី របស់ នាង បាន និយាយ អំពី ការចាប់ខ្លួន ជាច្រើន ។
ចេញ តាម ទីប្រជុំជន ៦.
ទី ពីរ ហានិភ័យ នឹង នៅតែ ខ្ពស់ មិន សម ហេតុផល ។
អ្វី ក៏ដោយ ដែល ដាស់ គាត់ ចេញ ពី ឋានសួគ៌ នៅលើ ផែនដី ប្រាកដ ជាជា អ្នក មើលថែ នៅលើ ឋាននរក ។
ដី នៅលើ អ្វី មួយ វា ប្រកាស វត្តមាន របស់ វា ដល់ មនុស្ស ។
" អ្នកបានដាក់បណ្តា សា អ្នក និពន្ធ ហើយបាន សន្យាថាមិនត្រឡប់មកវិញ " ។
គ្មាននរណាម្នាក់អាចធ្វើបានឡើយ » ។
ប៉ុន្តែប៉ា ខ្ញុំថាគ្រាន់ តែនិយាយប៉ុណ្ណោះ ។
ខ្ញុំ រីករាយ ដែល អ្នក បាន សរសេរ មក យើង អំពី កង្វល់ របស់ អ្នក ។
នាង ជា មេផ្ទះ ដែល ចូលចិត្ត ឱប ។
តាំងពីចេញលក់មក មានការ យល់ច្រឡំខ្លះៗអំពីរបៀបបញ្ចេញឈ្មោះម៉ូដែល !
ចង្កៀង នេះ នៅលើ ច្រាំង សមុទ្រ មើល ទៅ ដូចជា ព្រះអាទិត្យ ។
ពួកគេ មក ដោយសារតែ ពួកគេ ចង់ មើល
នៅ ពេល ដែល គាត់ បាន ពិភាក្សា អំពី រង្វាស់ នៃ ការពិត ដែល អនុញ្ញាត ដល់ អ្នក ជីវប្រវត្តិ ។
១០ ព្រះអម្ចាស់មានព្រះបន្ទូលមក កាន់ម៉ាណា សេ និងប្រជាជនរបស់ព្រះអង្គ ប៉ុន្តែគេមិនបានយក ចិត្តទុកដាក់ឡើយ ។
“ មនុស្សមួយចំនួនបាននិយាយថា នេះអាចអនុវត្តចំពោះជនមូស្លីម ។
ដឹកនាំ វា ដោយ ខ្លួន ឯង ខ្ញុំ មិន មាន បំណង ឆ្លើយ អ្នកទេ ។
ជាថ្មី ម្តង ទៀត កសិដ្ឋាន មាន ឆ្មា ។
ព្រី៖ គ្រាន់ តែឲ្យនាងដឹងថាអ្នក ជា Phoebe ល្អ មិនមែនជាមនុស្សអាក្រក់នោះទេ ។
នាងមិនប្រាប់អ្នក ណាថានាងទៅ ណាទេ គ្មានអ្នក ណាឃើញនាងចាកចេញទេ ។
បូជា សព ដែល អ្នក ទាំងអស់ គ្នា បាន ផ្លាស់ប្តូរ គឺជា ម្តាយ របស់ ខ្ញុំ ។
នៅពេល បន្ថែម អង្កាំ ពួកគេ នឹង ទៅ ខាងក្រោយ នៃ ការងារ ។
អតីត ជនល្មើស បាន ទទួល ពន្ធ
ខ្ញុំមិនមែនជាមនុស្សម្នាក់ក្នុងចំណោមមនុស្សទាំងនោះដែលមើលអ្វីគ្រប់យ៉ាង ហើយនិយាយថា " ជីវិតគឺ អស្ចារ្យ " ។
ម៉្យាង វិញ ទៀត ខ្ញុំ ដឹង គ្រប់គ្រាន់ អំពី ខ្លួនខ្ញុំ ដើម្បី ដឹង ថា ខ្ញុំ មាន ទំនោរ ប្រឆាំង នឹង សេចក្តីមេត្តា ករុណា ខ្លះ ។
អ្នក ដែល ឈ្នះ នឹង ទទួលបាន រង្វាន់ ជាច្រើន ប្រភេទ ។
ទោះបីជា ចំនួន នៅ ខាងក្រៅ ប្រទេស ចិន នៅតែ មាន ចំនួន តិចតួច ក៏ដោយ ប៉ុន្តែ ពួកគេ រក្សា សក្តានុពល សម្រាប់ ការផ្ទុះឡើង កាន់តែ ធំ » ។
ហើយខ្ញុំបានផ្តល់យោបល់ថា ចាប់តាំងពីនេះជាការ ចាប់អារម្មណ៍របស់អ្នកទៅធ្វើការ ស្រាវជ្រាវ។
ហេតុផល ណាដែលការ ស្ដារឡើងវិញនឹងយឺតខ្លាំង ?
នៅក្នុង ទំនាក់ទំនង របស់ យើង ទាំងអស់ ក្នុង នាម ជា អ្នក ដើរ តាម ព្រះយេស៊ូវ យើង អាច ជ្រើសរើស គិត ថា យើង ពូកែ ឬ យើង អាច បម្រើ ផលប្រយោជន៍ អ្នកដទៃ ដោយ រាប ទាប ។
ទោះ យ៉ាងណា ក៏ដោយ ផ្កាយ គឺជា មេធ្មប់ ។
ដូច ដែល អ្នក បាន ដឹង ហើយ ថា ជា រឿង អាស្រូវ ទាំងស្រុង ប្រសិនបើ អ្នក ដឹង ពី ប្រវត្តិ របស់ អ្នក ។
អ្នកបញ្ឈប់អ្នកផ្សេងពីការ ប្រើវា។
អ្នក នឹង រកឃើញ រឿង ភ័យ រន្ធត់ នេះ ។
ហ្សីម បាន សួរ ឱ្យ ប្រាកដ ។
អ្នក នៅពេលដែលខ្ញុំបានចាក់ គ្រឹះនៃផែនដី !
ខ្ញុំបានប្រយុទ្ធដ៏ល្អ ខ្ញុំបាន បញ្ចប់ការ ប្រណាំង ខ្ញុំបានរក្សាជំនឿ ។
