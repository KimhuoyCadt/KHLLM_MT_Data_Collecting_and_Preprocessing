62 ចុះបើអ្នក ឃើញកូនមនុស្សឡើងទៅ ឯកន្លែងដែលទ្រង់នៅពីមុន ?
តើខ្ញុំត្រូវមើលរឿងនេះមួយពាន់ដងទេ ?
ខ្ញុំ បាន មើល វា កើតឡើង នៅក្នុង គ្រួសារ របស់ ខ្ញុំ ។
ហើយកុលសម្ព័ន្ធ គ្រិស្តសាសនិកដែលហៅតាមគាត់នោះ ក៏នៅ តែមិនបាត់រហូតដល់សព្វថ្ងៃ »
ប្រសិនបើអ្នកត្រឡប់មកវិញដោយសុខសាន្ត ព្រះអម្ចាស់មិនមានព្រះបន្ទូលមកខ្ញុំទេ ។
៦ ចូរបង្ហូរសេចក្ដី ក្រោធរបស់ទ្រង់ទៅលើប្រជាជាតិដែលមិនស្គាល់ទ្រង់ និងលើនគរដែលមិនហៅនាមទ្រង់ ។
មាន តែ កូនស្រី អាយុ ប្រាំមួយ ឆ្នាំ របស់ ខ្ញុំ ទេ ដែល អាច រស់ នៅ ជាមួយ ខ្ញុំ បាន ។
នាងដាក់ដៃលើកៅអីរបស់ អើរ៉ុន ហើយផ្អៀងទៅទី នោះ ។
ខ្ញុំបន្តនិយាយដដែល ៗថា “ នេះមិនល្អសម្រាប់ក្មេងទេ ។
ពេល គេ ធ្វើ ខុស គេ ចង់បាន យុត្តិធម៌ ។
ដោយមហាបូជាចារ្យនៅក្នុងទី សក្ការៈបំផុត នៅថ្ងៃរំដោះ បាប ។
បង្កើត អារេ ថ្មី ដោយ ផ្អែក លើ វា បន្ទាប់មក ត្រឡប់ វា ដោយ ភ្ជាប់ លេខ ថ្មី ដែល អាច រាប់ បាន ។
ប៉ុន្តែ ដូចដែល បទគម្ពីរបានចែងថា អ្នក ណាដែលនៅ ស្មោះត្រង់រហូតដល់ ទីបំផុតនឹងទទួល រង្វាន់ ។
អ្នក នឹង មាន ភាពសប្បាយរីករាយ និង រីករាយ ។ ហើយ មនុស្ស ជាច្រើន នឹង អរសប្បាយ នៅពេល កំណើត របស់ គាត់ ។
នាងបាននិយាយថា « ចូរប្រយ័ត្ននឹងពាក្យដែលអ្នកប្រើ ។
« បើអ្នកស្អប់ប្រទេសយើង បើអ្នកមិនសប្បាយ ចិត្តនៅទីនេះអាចចាកចេញបាន។
68 ព្រះ‌ អម្ចាស់នឹងចាត់អ្នកទៅស្រុកអេស៊ីបវិញតាមសំពៅ ។
ប្រាប់ កូន របស់ អ្នក ថា គ្មាន អ្នកណា សម នឹង ទទួល ការបៀតបៀន ឡើយ ។
ដូច្នេះ សូម គោរព អ្នក ។
ទឹក ផ្លែឈើ ដែល អ្នក បាន ធ្វើ មាន ប្រយោជន៍ សម្រាប់ អ្នក !
ត្រូវយកពន្ធ វាយតម្លៃ និងប្រមូលរាល់ការ លក់ ការ ដោះដូរ
៦ កុំគោរពខ្លួននៅចំពោះមុខស្ដេច ហើយកុំឈរជំនួសអ្នកធំឡើយ ។
ប្រសិនបើ មិន មែន សម្រាប់ ព្រះរបស់ អ្នក ដែល បង្កើត នរក តាំងពី ដំបូង ទេ គាត់ នឹង មិន មាន អ្វី គំរាមកំហែង ខ្ញុំ ទេ ។
ពីរ ត្រូវបាន បំពាក់ ដោយ ក្បាល ពីរ និង ពីរ ផ្សេង ទៀត មាន ក្បាល តែ មួយ ។
ហើយតើយើងត្រូវធ្វើយ៉ាង ណាចំពោះការ ពិតដែលព្រះអម្ចាស់ទ្រង់រងទុក្ខលើឈើ ឆ្កាង ដោយដង្ហើមផុតដង្ហើមរបស់ទ្រង់បានចោទជាសំណួរបែបនេះទៅ កាន់ព្រះវរ បិតាថា ៖ « ហេតុអ្វីបានជាអ្នក បោះ បង់ចោលខ្ញុំ ?
៩ ហេតុដូច្នេះហើយបានជានៅ សល់កន្លែងសម្រាកសម្រាប់ រាស្ដ្រនៃព្រះ។
ដឹងទេថានៅទីនេះមានអ្នកស្អប់អ្នក?
មួយ ទៀត ខ្ញុំ ដាក់ ប្រាំមួយ និង ពីរ បី ដុល្លារ ទៀត ។
គ្មានកូននៅក្រៅសាលាទេ ។
មាន ពរហើយអ្នក ណាដែល មកក្នុងនាមព្រះ» ។
ហើយពេលដែលប្រជាជន លី បេរីយ៉ាទៅបោះឆ្នោតនៅថ្ងៃ ទី ១០ ខែតុលា ខ្ញុំសុំឲ្យអ្នក រក្សាការ ពិតទាំងពីរនោះក្នុង ចិត្ត » ។
តើវាមិនមែនជាលោកអូបាម៉ា ទេដែលបានធ្វើវា ?
ដេវ និង ខ្ញុំ ពិតជា រីករាយ ណាស់ ។
ហើយអ្វីដែលពួកគេបានផ្តល់គឺច្បាស់ជាទទួលបានយ៉ាងល្អ។
ឬមួយអ្នកនឹងសម្លាប់ខ្ញុំដូចជាអ្នកបានសម្លាប់ជនជាតិអេហ្ស៊ីបពីម្សិល មិញ ? » ។
គាត់បានបន្ថែមថា " ខ្ញុំបាននិយាយ លា ហើយ គ្មានអ្វីធ្វើទៀតទេ !"
អេក្រង់ ប៉ះ ផងដែរ ។
« ចង់និយាយមក ស្គាល់ខ្ញុំយូរប៉ុណ្ណាហើយ ?
« ត្រូវបង្គាប់ជន ជាតិអ៊ីស្រាអែលឲ្យយកប្រេងអូលីវសុទ្ធមកអ្នក ។
ទាំងនោះ ឬទាំងអស់ការ ចាត់ចែងនៃសេចក្តី សុចរិតរបស់គម្ពីរ សញ្ញាចាស់ គឺមិនត្រឹមត្រូវ ) ។
ពេលនោះ ជន ជាតិអ៊ីស្រាអែលស្រែកអង្វរព្រះអម្ចាស់ ។
« សម្រាប់មនុស្សម្នាក់ចាត់ទុកថ្ងៃមួយសំខាន់ជាងថ្ងៃមួយទៀត ខណៈពេលដែលមនុស្សម្នាក់ទៀតចាត់ទុកថ្ងៃទាំងអស់ដូចគ្នា ។
បន្ទាប់មក មុខរបស់នាងបានក្លាយដូចជាមុខទេវតា ។
គ្មានពោតដុះច្រើនខែទៀតទេ ហើយអ្នកដែល រត់រួចត្រូវទុកឲ្យអត់ឃ្លាន ។
កាលនាយទាហានឃើញហេតុ ការណ៍កើតឡើង ក៏លើក ត ម្កើងព្រះ ដោយពោលថា៖ « ប្រាកដជាអ្នកនេះជាមនុស្សសុចរិត !» ។
ខ្លួនគាត់បានជំរុញក្នុងទិស ដៅមួយដែលគាត់មិនបានដឹង។
ហើយពួកសិស្សសួរគាត់ថា៖ « លោកគ្រូដែលធ្វើ បាបបុរសនេះឬឪពុកម្ដាយគាត់ថាគាត់កើតមកខ្វាក់?
គ្មាននរណាដូចទ្រង់ឡើយ ។
គាត់បានឆ្លើយ ថា៖ « ហេតុអ្វីបានជាព្យាយាមស្វែង រកពួកគេ ?
ថម បាននិយាយភ្លាត់អណ្តាតក្នុងការ ប្រជុំ កាលពីម្សិល មិញ ។
ពួកគេធ្លាប់ចេញ មកទាំងយប់ ហើយលេបត្របាក់មនុស្ស និងពួកបរិសុទ្ធ ។
អ្នកស្រីស្ថិតក្នុងចំណោមពលរដ្ឋចំនួន ១០០គ្រួសារ ដែលត្រូវបានបណ្តេញចេញពីដីជម្លោះក្នុងខែ មេសា ឆ្នាំ ២០០៧ ។
អ្វី ដែល អ្នក អាច ធ្វើ បាន ដើម្បី ជួយ ជនរង គ្រោះ៖
ត្រជាក់ ដល់ អ្នក ដែល ចូល ទីនោះ ។
ការផ្លាស់ទី ជុំវិញ ច្រើន គឺជា មធ្យោបាយ ដ៏ ល្អ ក្នុង ការពន្យារ ពេល ថ្ងៃ នៃ ការគិត ឡើងវិញ ។
ត្រូវបានគេចោទប្រកាន់ហើយគាត់បានទទួល ទោស !
ស្ត្រី សាសន៍សាម៉ារី ផឹកពីខ្ញុំឬ ? នាងបានសួរថា ។
អ្នក ណាដែលជឿលើខ្ញុំ ទោះជាអ្នកនោះបានស្លាប់ហើយក៏ដោយ ក៏អ្នកនោះនឹងមានជីវិតដែរ ។ ហើយ អ្នកណា ដែល រស់ នៅ ហើយ ជឿ លើ ខ្ញុំ នឹង មិន ស្លាប់ ឡើយ » ។
ភរិយាដែលគោរពព្រះ គឺដើរតាមស្វាមីទៅក្នុងមាគ៌ានៃសេចក្ដី សុចរិត ហើយត្រូវចុះចូលចំពោះគាត់ដូច ជា សមនឹងព្រះ អម្ចាស់ ។
ពួកអ្នកដែលគេសម្លាប់ ប៉ុន្តែចំពោះអ្នកដែលគេល្បួងឲ្យថ្វាយ បង្គំរូបព្រះ។
ហើយអ្នកបង្កើតសន្តិភាពមាន ពរហើយ ដ្បិតគេនឹងត្រូវបានហៅថាជាកូនរបស់ព្រះ។
៧ ( ក) កុំធ្វើដូចដូនតា និងបងប្អូនរបស់អ្នក ដែលមិន ស្មោះត្រង់ចំពោះព្រះ‌ អម្ចាស់ ជាព្រះ នៃបុព្វបុរសរបស់ពួកគេ ដើម្បីឲ្យព្រះអង្គធ្វើឲ្យគេវិនាសអន្តរាយ ដូចអ្នក ឃើញស្រាប់ ។
ហើយពួកគេមកអាមេរិកហើយបង្ហាញជំនាញ។
ថវិកា ដែល អាច បត់បែន បាន ។
គាត់ នឹង ពេញ ដោយ ព្រះវិញ្ញាណ បរិសុទ្ធ តាំងពី កំណើត ។
( ១ពេត្រុស ១: ១៤) ព្រោះខ្ញុំដឹងថាមិនយូរប៉ុន្មានខ្ញុំនឹងទុកវាមួយ ឡែក ដូចជាព្រះ យេស៊ូគ្រិស្ដដែលជាព្រះ អម្ចាស់នៃយើងបានប្រាប់ខ្ញុំ ។
« តើមិនមែនជាមនុស្សបីនាក់ដែលយើងបោះក្នុងភ្លើងនោះទេ ? » ។
ខ្ញុំ នឹង ឃើញ សេចក្តីសុចរិត របស់ គាត់ ។
នេះពិតជាទុក្ខ វេទនាដ៏ មហិមា នៅពេលគេដាក់ព្រះសពព្រះ អង្គដែលបានយាងទៅលើគំនរ សព ។
អ្នក ណាដែលជឿលើខ្ញុំ ទោះជាស្លាប់ក៏ដោយ ក៏អ្នកនោះនឹងមានជីវិត ។ ហើយ អ្នកណា ដែល រស់ នៅ ហើយ ជឿ លើ ខ្ញុំ នឹង មិន ស្លាប់ ឡើយ » ។
ដូច្នេះ យើងនៅក្នុងរបៀបនោះជាកូនរបស់ព្រះ។
អ្នក នឹង ឃើញ បញ្ជី ប៉ម ជួង ហើយ អ្នក អាច ជ្រើសរើស មួយ ក្នុង ចំណោម ពួកគេ ។
ដំបូង យើង ពិនិត្យមើល អ្វី ដែល យើង បាន ធ្វើ
វាមិនប៉ះពាល់ត្រូវទេ ?
ដៃរបស់អ្នកបានផ្ដល់ឱ្យ : ភ្នែករបស់អ្នកមើល
ជា លទ្ធផល ព្រះ យេស៊ូមិនអាចចូលទៅក្នុងទីក្រុងដោយចំហ ទៀតទេ ប៉ុន្តែទ្រង់គង់នៅខាងក្រៅក្នុងទី រហោស្ថាន ។
ព្រះបាន ធ្វើ ចំពោះ យើង នូវ អ្វី ដែល យើង មិន សម នឹង ទទួលបាន ។
គាត់បាននិយាយថា៖ « វាជារឿងខុស ច្បាប់ដែល បណ្តេញខ្ញុំចេញពី បទផ្លុំ កញ្ចែក្នុងកាលៈទេសៈទាំងនេះ។
ដូច្នេះអ្នកគិតថាអ្នកចង់ថើបខ្ញុំ?
នាង នឹង លង អ្នក ដរាបណា អ្នក នៅរស់ ។
អ្វីដែលអាចហៅថាជាការ ឈឺចាប់នៃការ រីករាយ » ។
ដោយសារតែ អ្នក មិន ដឹង ពី ពួកគេ ។
និង រួមបញ្ចូល ធ្នឹម តូច មួយ ដូចជា សម្រាប់ ទ្វារ មួយ ។
វាជាបញ្ហានៃការ យល់ដឹងដោយអធិដ្ឋានសម្រាប់មាតាបិតា » ។
« ទ្រង់ជាបិតារបស់យើងនៅចំពោះព្រះភក្ត្រនៃព្រះ ដែលទ្រង់បានជឿ គឺជាព្រះ ដែលប្រទានជីវិតដល់មនុស្សស្លាប់ ហើយត្រាស់ហៅឲ្យក្លាយជារបស់ដែលមិនមែនជា » ។
តើអាទិទេព ច្រើនជាងមួយបានគោរពបូជានៅ ទីនោះទេ ?
គាត់ បាន ចាប់ផ្តើម ការងារ របស់ គាត់ នៅ ទីនោះ កាលពី ពីរ ទសវត្សរ៍ មុន ។
វា ដោយសារតែ ជំនឿ របស់ នាង លើ ព្រះ។ នាង ជឿ ថា ព្រះនឹង ធ្វើ តាម ការសន្យា របស់ គាត់ ។
យើងនឹងពិនិត្យមើលអំពើទុច្ចរិតរបស់គេ មកលើគាត់ និងលើពូជគាត់ និងលើអ្នក បម្រើរបស់គាត់ ។ ហើយ ខ្ញុំ
ហើយបន្ទាប់ពីថ្ងៃនៃនំបុ័ងឥតមេ យើងបានធ្វើដំណើរពីក្រុង ភីលីព ។
ទ្រង់ស្វែងរកផែនដីសម្រាប់អ្នកដែលនឹងស្វែង រកទ្រង់ ដែលនឹងស្រឡាញ់ទ្រង់លើសជាងការ ស្វែងរកនៅផែនដី ។
បងប្អូន ប្រុស ស្រី របស់ ខ្ញុំ ការសាកល្បង ដ៏ អស្ចារ្យ នៃ ជីវិត នេះ គឺ ការស្តាប់ បង្គាប់ ។
18 ប៉ុន្តែពេលត្រឡប់មកទីក្រុងវិញ គាត់ឃ្លាន ។
ចេញមក ឥឡូវនេះ ក្នុង ព្រះនាម ព្រះយេស៊ូវ !
នៅក្នុង វិធី មួយចំនួន ពួកគេ បាន ប្រសើរឡើង បន្តិច ហើយ មាន ការកើនឡើង ខ្លះ ( ជារឿយ ៗ តាម ពីក្រោយ ដោយ ការខាតបង់ ដែល អាច ប្រៀបធៀប បាន ) ។
មាន ពរហើយ អ្នក ណាដែលមិនអន់ ចិត្តនឹងខ្ញុំ » ។
គ្មានអ្នក ណាដែលពឹងលើក្រិត្យវិន័យនោះបានរាប់ជាសុចរិតនៅចំពោះព្រះ ឡើយ ពីព្រោះ « មនុស្សសុចរិតនឹង រស់ដោយសេចក្ដី ជំនឿ » ។
ឋាននរក គឺជា ការវិនិច្ឆ័យ របស់ ទ្រង់ លើ អ្នក ដែល បដិសេធ មិន ធ្វើ ដូច្នេះ នៅលើ ផែនដី ។
ព្រះ‌បន្ទូលរបស់ព្រះ‌ អម្ចាស់បានសាយភាយពេញតំបន់ ។
13 គាត់ រត់គេចពីព្រោះគាត់ ជាអ្នកជួល ហើយមិនខ្វល់ពីហ្វូងចៀមទេ ។
បើអ្នកមានចំណុចខ្សោយ គេនឹងលាតត្រដាង ។
50 ប្រជាជនអ៊ីស្រា ‌ អែលទាំងអស់បានធ្វើដូចព្រះ‌ អម្ចាស់បានបង្គាប់មកលោកម៉ូសេ និងលោកអើរ៉ុន ។
Q. ប្រពន្ធខ្ញុំខំយកកូនព្រោះយើងមានកូនហើយ …
ហើយ ផ្តល់ ដៃ ដល់ មនុស្ស គ្រប់ គ្នា ក្នុង សមត្ថភាព របស់ យើង ។
ពេលគាត់សុំមើលសិរីល្អរបស់ព្រះ នោះព្រះ បានឆ្លើយ ត ប ថា “ គ្មានអ្នក ណាអាចមើលមុខខ្ញុំ ហើយរស់បានឡើយ ។
8:12 អ្នកដែលនៅតាមផ្លូវគឺ ជាអ្នកដែលបាន ឮ , បន្ទាប់មកអារក្សចូល មក , ហើយយកចេញពី ចិត្តរបស់ពួកគេ , ដើម្បីឱ្យពួកគេអាចនឹងមិនជឿនិងបាន សង្គ្រោះ .
ប៉ុន្តែបុរសដែលស្រឡាញ់ព្រះ គឺត្រូវស្គាល់ដោយព្រះ។
ម៉ាកុស 9:43 « បើដៃឯងធ្វើឲ្យអ្នកជំពប់ដួល ចូរកាត់វាចេញ នោះល្អជាងឲ្យអ្នកចូលទៅក្នុងជីវិតពិការ ជាជាងមានដៃពីរចូលទៅក្នុង ន រក ក្នុងភ្លើងដែលមិនចេះ រលត់ » ។
ប្រាប់ ពួកគេ ថា អ្នក ចង់ ក្លាយជា មិត្ត ល្អ ជាង ។
មនុស្ស មាន បាប ដែល ជា សត្រូវ របស់ ព្រះត្រូវបាន ផ្សះផ្សា ជាមួយ ព្រះ ( បាន បង្កើត មិត្ត របស់ ព្រះម្តង ទៀត ) តាមរយៈ មរណភាព របស់ ព្រះគ្រីស្ទ ។
ទៅ កោះ សុបិន្ត របស់ អ្នក រាល់គ្នា ។
អ្នកអាចផឹកបានប្រសិនបើអ្នកចង់ ។
មិនអាចធ្វើបានទេ ប៉ុន្តែធ្វើតាមកូដ ។
១៤ ទោះជាយ៉ាង ណាក៏ដោយ វាជាការ ល្អណាស់ដែលអ្នកបានចែករំលែកទុក្ខព្រួយរបស់ខ្ញុំ ។
លោកបាន សន្យាថានឹងបំផ្លាញមនុស្សអាក្រក់ ហើយការពារមនុស្សសុចរិត ។
ខ្ញុំ បាន អង្វរ គាត់ ថា គាត់ សុខ សប្បាយ ជា ទេ
ហើយក្នុងនាមរបស់សាតាំង ខ្ញុំដាក់បណ្តា សា អ្នក រាល់គ្នា .. . អ្នកនឹងមិនរួចផុតពីការ ស្រេកឃ្លានរបស់ខ្ញុំ ឬពីសាតាំងឡើយ !» ។
៤៧ ដូច្នេះ ពួកខាងគណៈ ផារី ស៊ីឆ្លើយទៅគេ ថា៖ « តើអ្នក រាល់គ្នាបានចាញ់បោកដែរឬ ?
« ដ្បិតយើងខ្ញុំមិនបានបង្ហាញការ អង្វររបស់យើងនៅចំពោះមុខអ្នកដោយ សារ តែសេចក្ដី សុចរិតរបស់យើងទេគឺដោយ សារ តែសេចក្ដី មេត្តា ក រុណាដ៏ អស្ចារ្យរបស់អ្នក» ។
កូន របស់ អ្នក ហើយ អ្នក អាច សង្កេត និង វាស់វែង បាន ។
ព្រះរាជ បុត្រា នៃ ព្រះមាន ការភ្ញាក់ផ្អើល ចំពោះ ភាពតូចតាច និង កង្វះ ជំនឿ របស់ ពួកគេ ។
តើអ្នកប្រព្រឹត្តខុសដោយចេតនាត្រូវបានរង្វាន់ដោយឧត្តមភាព ឬ ?
អូ វាត្រូវហើយ អ្នកមិនអាចទេ ព្រោះគាត់ស្លាប់ហើយ !
« ពេលវេលាបានមកដល់ហើយ រាជាណាចក្ររបស់ព្រះ ជិត មកដល់ហើយ ។
ឥឡូវនេះជាមួយឪពុកយើង ហើយម្នាក់ទៀតបានស្លាប់ហើយ » ។
ជនល្មើសដែលត្រូវនាំមកចំពោះមុខគាត់ » ។
ពេលវេលា បាន មកដល់ ហើយ បងប្អូន
បន្ទាប់មកទាំងនេះត្រូវបានរៀបចំជា ស្រេចដើម្បីវាស់វែង ។
