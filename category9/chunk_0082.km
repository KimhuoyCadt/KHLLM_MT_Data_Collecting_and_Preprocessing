90 ហើយយើងបាននាំកូនចៅអ៊ីស្រាអែលឆ្លងកាត់សមុទ្រ ; ពេលនោះ ព្រះចៅផារ៉ោន និងពួក ពលបរិវា របានដេញតាមពួកគេដោយកំហឹង និងការ ជិះ ជាន់យ៉ាងខ្លាំង រហូតដល់ទឹកសមុទ្រគ្របសង្កត់ ។
មក ចែករំលែក ជីវិត របស់ ខ្ញុំ ជាមួយ ខ្ញុំ
អ្នកជំងឺ ត្រូវបាន ព្យាបាល ជាសះស្បើយ ពី ជំងឺ នៅ ទីបំផុត ។
នៅ ពេល ដែល ចិត្ត និង គំនិត របស់ យើង ត្រូវបាន ផ្លាស់ប្តូរ ដោយ ព្រះបន្ទូល និង សាក្រាម៉ង់ នោះ យើង ដឹង ពី រឿង នេះ ។
រូបរាង របស់ ថេប្លេត ។
១៣ អ្នក រាល់គ្នានឹងស្អប់អ្នក រាល់គ្នាដោយព្រោះខ្ញុំ ប៉ុន្តែអ្នក ណាដែលប្រកាន់ ខ្ជាប់រហូតដល់ចុងបំផុតនឹងបាន សង្គ្រោះ ។
ខ្ញុំគិតថាគាត់ចាប់ពស់ !
ប្រសិនបើ អ្នក ចូលចិត្ត ចំអិន និង ញ៉ាំ de
រហូតមកដល់ពេលនេះ ច្បាប់ចម្លងរាប់ រយច្បាប់ត្រូវបានគេចែកចាយនៅទូទាំងប្រទេសម៉ាឡេស៊ី ។
យើងបានធ្វើឲ្យនាងក្លាយជាស្ត្រីមានបំផុតទី ៤៧ក្នុងពិភពលោក ។
ពេលយើងជួយអ្នក ដទៃ ដោយជួយគេ យើងជួយខ្លួន ឯង ។
៣០ ហើយ កូនេលាសមាន ប្រសាសន៍ថា ៖ « ឥឡូវនេះជាថ្ងៃទីបួន ហើយដល់ម៉ោងនេះ តាំងពីខ្ញុំកំពុងអធិស្ឋាននៅផ្ទះនៅម៉ោងទីប្រាំបួន ហើយមើលចុះ មានបុរសម្នាក់បានឈរនៅចំពោះមុខខ្ញុំក្នុងអាវពណ៌ ស ហើយគាត់បាននិយាយថា ៖
ការញ៉ាំ ភ្នែក របស់ អ្នក មិន គួរ ពិបាក ទេ ។
ដូច្នេះហើយបានជំរុញព្រះរាជបុត្រានៃព្រះ។
៤៥ ពេលប្រជាជនទាំងអស់កំពុងស្ដាប់ ព្រះអង្គមានព្រះបន្ទូលទៅ កាន់សិស្សថា៖
១៩ ហើយមីកាយ៉ា មាន ប្រសាសន៍ ថា៖ « ដូច្នេះ ចូរស្តាប់ព្រះ‌បន្ទូលនៃព្រះ‌ អម្ចាស់ ខ្ញុំបានឃើញព្រះ‌ អម្ចាស់គង់លើបល្ល័ង្ករបស់ព្រះអង្គ ហើយ ពលបរិវារនៃ ស្ថាន បរម សុខទាំងមូលឈរក្បែរព្រះអង្គ នៅខាងស្ដាំ និងខាងឆ្វេង ។
២០ អ្នកដែលធ្វើបន្ទាល់អំពី ការ ទាំងនេះពោលថា៖ « បាទ ខ្ញុំនឹង មកឆាប់ ៗ » ។
ហើយពួកគេទាំងអស់គ្នាក្នុងសម្ព័ន្ធ ភាពដើម្បីជួសជុលបរិស្ថាន ?
ហើយ គាត់ អង្គុយ នៅលើ មេឃ ដែល ពោរពេញ ដោយ ផ្កាយ ដែល ប្រហែលជា អ្នក ផ្សេង ទៀត ដូចជា គាត់ កាន់ ពន្លឺ របស់ ពួកគេ នៅក្នុង ទី ងងឹត ។
ភាគ ច្រើន អាច រក បាន៖
គ្មាន ជម្រើស ដើម្បី ការពារ រាងកាយ របស់ ពួកគេ ពី ជំងឺ ។
• ត្រូវ មាន សមត្ថភាព ក្នុង ការអាន និង សរសេរ ភាសា ជប៉ុន
ក្មេងស្រី អាយុ ប្រាំពីរ ឆ្នាំ ម្នាក់ បាន លង់ទឹក ស្លាប់ ។
ហើយធ្វើដូច្នេះ ដោយយល់ពីពេលបច្ចុប្បន្ន នេះ៖ ម៉ោងបានមកដល់ហើយសម្រាប់អ្នក រាល់គ្នាដើម្បីភ្ញាក់ពីដំណេករបស់អ្នក ពីព្រោះសេចក្ដីសង្គ្រោះរបស់យើងគឺនៅជិតឥឡូវនេះជាងពេលដែលយើងបានជឿដំបូង ។
សូម្បីតែព្រលឹងដែលត្រូវបានកំណត់សម្រាប់ ភាព អស្ចារ្យ ហើយពួកគេបានដឹកនាំមនុស្សជាច្រើននាក់ទៀតក៏មានគ្រោះថ្នាក់យ៉ាងខ្លាំង ប្រសិនបើពួកគេបែកចេញពីសហគមន៍នៃ រាស្ដ្ររបស់ព្រះ។
ម្ចាស់ ផ្ទះ បាន រំលោភ លើ ការជួល ។
នៅក្នុងក្រុងទាំងអស់នៃដី ។
“ ប៉ុន្តែ ការផ្តោត សំខាន់ របស់ យើង គឺ យោធា របស់ ឥណ្ឌា ។
ក្នុងនេះ យើងរួបរួមគ្នា » ។
តើពិតជាមានអំពើ បាបដែរឬទេដែលប្រាប់កូនថាអ្នកមានមោទនភាព ចំពោះពួកគេ ?
អរគុណអ្នកនឹងមិនចង់បានសិទ្ធិនៅឆ្នាំ !
ឥឡូវនេះ ក្រុមហ៊ុន ទាំងអស់ គឺជា ក្រុមហ៊ុន បច្ចេកវិទ្យា ។
អ្នក ត្រូវ រក វិធី ដើម្បី ទិញ អាវុធ ។
« សហរដ្ឋ អាមេរិកបានដាក់ទណ្ឌកម្មលើបុគ្គល និងអង្គភាពមួយចំនួនដែលកំពុងគាំទ្រកម្មវិធីមីស៊ីលរបស់អ៊ីរ៉ង់ ។
« ជំហានដំបូងគឺការ រួបរួមពីព្រឹទ្ធសភាគណបក្សប្រជាធិបតេយ្យ ។
ប្រសិនបើ វា មិន មាន ផែនការស្រោចស្រព ។
“ មនុស្សមានការ ព្រួយបារម្ភអំពី វិសាលភាពនៃឥទ្ធិពលរបស់ធម្មការ ។
ប្រធាន៖ ... ហើយអ្នកស្លាប់ត្រូវបានខ្នោះខ្នោះនឹងបង្គោល ។
បញ្ជី នៃ យូនីក ។
សូម ចងចាំ ថា អ្វី គ្រប់ យ៉ាង ដែល អ្នក ធ្វើ គួរតែ ជា ផលប្រយោជន៍ របស់ ក្រុមហ៊ុន អ្នក ។
