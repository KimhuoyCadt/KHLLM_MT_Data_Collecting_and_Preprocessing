( ភ្នំពេញ ) ៖ រដ្ឋបាល រាធានី ភ្នំពេញ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការបញ្ចៀស ចរាចរណ៍ យានយន្ដ គ្រប់ ប្រភេទ ជា បណ្ដោះអាសន្ន ក្នុង កិច្ចប្រជុំ កំពូល អាស៊ាន លេីក ទី ៤០ និង លេីក ទី ៤១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នានា នៅ រាជធានី ភ្នំពេញ ។ នេះ បេី តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ឆ្នាំង បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ ផែនការរួម ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ ឆ្នាំ ២០២៣
( កំពង់ឆ្នាំង ) ៖ នា ព្រឹក ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ឆ្នាំង បាន បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ សេចក្តីសម្រេច របស់ គណៈ កម្មាធិការ កណ្ដាល ស្ដីពី ផែនការរួម ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព លោក បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន សមាជិក គណៈ អចិន្រ្តៃយ៍ គណៈកម្មា ធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា អនុ ប្រធាន ទី១ ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ឆ្នាំង ។
ខេត្ត ត្បូងឃ្មុំ នឹង រៀបចំ ការប្រណាំង ទូក តាំងពិព័រណ៍ ប្រគុំតន្ត្រី ខ្នាត ធំ នៅ ថ្ងៃ ពិធី បុណ្យ អុំ ទូក ៣ ថ្ងៃ នៅ ទីតាំង កស្សិណ ទឹក តំបន់ ទេសចរណ៍ ប្រវត្តិសាស្រ្ត ហ្លួង ព្រះស្តេច កន និង មុខ សាលា ខេត្ត
( ត្បូងឃ្មុំ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន ដឹកនាំ កិច្ចប្រជុំ ត្រៀម រៀបចំ យ៉ាង អធិកអធម អឺង កង ពិធី បុណ្យ អុំ ទូក សំពះ ព្រះខែ និង អក អំបុក ឆ្នាំ ២០២២ នេះ អម ជាមួយ ការប្រណាំង ទូក ង ការតាំង លក់ ទំនិញ ពិព័រណ៍ ពាណិជ្ជកម្ម ការប្រគុំត ន្រ្តី ខ្នាត ធំ អក អំបុក សន្តិភាព ការបណ្តែត ប្រទី ប ការដុត កាំ ជ្រួច នា ពេល រាត្រី និង កម្មវិធី ជាច្រើន ទៀត ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង នៅ សាលា ខេត្ត ត្បូងឃ្មុំ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ អភិបាល រង ខេត្ត នាយក - នាយក រង រដ្ឋបាល សាលា ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ ប្រធាន - អនុប្រធាន មន្ទីរ នានា ជុំវិញ ខេត្ត នាយក - នាយក រង ទី ចាត់ការសាលា ខេត្ត អភិបាល ក្រុង / ស្រុក ទាំង៧ និង អ្នក ពាក់ព័ន្ធ ។
សូម ជម្រាប ថា ក្នុង កិច្ចប្រជុំ បាន សម្រេច ប្រារព្ធ ពិធី នេះ ចំនួន ០៣ ថ្ងៃ ធ្វើឡើង នៅ ទីតាំង ចំនួន ០២ ផ្សេង គ្នា ក្នុង នោះ ទីតាំង ទី១ ធ្វើឡើង នៅ ថ្ងៃទី ០៨ ខែវិច្ឆិកា នៅ កស្សិណ ទឹក តំបន់ ទេសចរណ៍ ប្រវត្តិសាស្រ្ត ហ្លួង ព្រះស្តេច កន ស្ថិត នៅ ភូមិ អង្គរ ក្នុង ឃុំ ដូនតី ស្រុក ពញា ក្រែក ។
ដោយឡែក ទីតាំង ទី២ ធ្វើឡើង ចំនួន ០៣ ថ្ងៃ ពេញ នា ថ្ងៃទី ០៧ - ០៨ និង ទី ០៩ ខែវិច្ឆិកា នៅ បរិវេណ មុខ សាលា ខេត្ត ត្បូងឃ្មុំ មាន ការតាំងពិពរណ៍ ពាណិជ្ជកម្ម ស្តង់ ជាច្រើន នូវ ផលិតផល - ម្ហូប អាហារ ចម្រុះ ការប្រគុំតន្ត្រី ខ្នាត យក្ស មាន តារា ចំរៀង ល្បី ៗ ជួរ មុខ ប្រមាណ ១៦ នាក់ ដើម្បីឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ទស្សនា រាំ លេង កម្សាន្ត សប្បាយ និង ការដុត កាំ ជ្រួច យ៉ាង ស្រស់ស្អាត ផងដែរ ។
លោក បណ្ឌិត អភិបាល ខេត្ត បាន បន្ត ថា ដោយសារ ពេលវេលា កាន់តែ ខិត ជិត មកដល់ ហើយ នោះ សូម ឱ្យ អនុគណៈកម្មាកា ដែល បាន បែងចែក រួច ទទួលបន្ទុក រៀបចំ ធ្វើ ការបែងចែក ទៅ តាម ក្រុមការងារ ជំនាញ រៀង ៗ ខ្លួន ពិសេស ការរៀបចំ សម្អាត សោភ័ណភាព ទីតាំង ប្រារព្ធ ពិធី មាន ដូចជា អនាម័យ បរិស្ថាន ការទុកដាក់ សម្រាម ពង្រឹង សន្តិសុខ សណ្តាប់ធ្នាប់ ទាំង នៅ ទីតាំង ប្រណាំង ទូក និង ទីតាំង តាំងពិព័រណ៍ ការប្រគុំត ន្រ្តី កម្សាន្ត ។
លោក សុវណ្ណ ពិសេដ្ឋ បាន បន្ត ថា ឆ្នាំ នេះ ផល ស្រូវ កសិករ ទទួលបាន ទិន្នផល ល្អ ជាង ឆ្នាំ កន្លងមក ដោយសារតែ ទឹកភ្លៀង អំណោយផល តាំងពី ដើម រដូវ រហូតមកដល់ ចុង រដូវ ថ្វីត្បិតតែ នៅ ស្រុក សេសាន នេះ ស្រូវ ស្រែ មួយចំនួន បាន រង ការលិចលង់ ដោយសារ ជំនន់ ទឹកភ្លៀង កន្លងមក ក៏ដោយ ។
លោក អភិបាល ស្រុក បាន បញ្ជាក់ ថា ផល ប៉ះពាល់ នេះ មិន ខូចខាត ធ្ងន់ធ្ងរ នោះ ទេ ដូចនេះ នៅពេល ប្រមូល ផល សូម ឱ្យ បងប្អូន កសិករ យើង រួសរាន់ ក្នុង ការច្រូត កាត់ ហើយ បើ បងប្អូន កសិករ មាន លទ្ធភាព អាច ប្រែក្លាយ ផ្ទៃដី ដែល មាន ប្រភព ទឹក ត្រូវ នាំគ្នា បន្ត ដាំ ដំណាំ រួមផ្សំ ផ្សេង ៗ ទៀត ដើម្បី ស្ដារ សេដ្ឋកិច្ច ស្បៀង ប្រចាំ គ្រួសារ ឱ្យ មាន ភាពរីកចម្រើន ឡើង ។
បន្ថែម ពី នេះ លោក សុវណ្ណ ពិសេដ្ឋ បាន លើកឡើង ថា សិករ ម្ចាស់ ស្រែ នៅ ភូមិ បាន បុង ឃុំ ភ្លុក បាន សំដែង ការសាទរ ដល់ ថ្នាក់ដឹកនាំ ស្រុក កងកម្លាំង ប្រាប់ អាវុធ រួម នឹង កម្លាំង មន្ត្រីរាជការ បាន មក ជួយ ច្រូត កាត់ ប្រមូល ផល ស្រូវ កសិករ បាន សម្រាល ដល់ ការចំណាយ ថវិកា ក្នុង ការជួល កម្លាំង មក ច្រូត កាត់ ។ សកម្មភាព នេះ បាន បង្ហាញ ពី ការលះបង់ របស់ ថ្នាក់ដឹកនាំ ស្រុក ក៏ ដូចជា មន្ត្រីរាជការ របស់ យើង ទាំងអស់ គ្នា នៅ ថ្ងៃ ឈប់សម្រាក ពី ការងារ បាន មក ជួយ ការងារ កសិករ យើង ដោយ មិន រើសអើង ។
សូម បញ្ជាក់ ថា នៅ ស្រុក សេសាន ខេត្ត ស្ទឹងត្រែង កសិករ ប្រមាណ ៨០ % ធ្វើ ការងារ បង្ករបង្កើន ផល ស្រូវ ១៥% ទៀត ធ្វើដំណាំ ចំការ និង ៥% ពួកគាត់ ប្រកបរបរ លក់ដូរ ហើយ នៅ ឆ្នាំ ២០២២ នេះ កសិករ យើង អនុវត្ត ការងារ បង្កបង្កើន ផល បាន ជាង ៥០០០ ហិកតា បច្ចុប្បន្ន ប្រមូល ផល ស្រូវ បាន ជាង ១.០០០ ហិកតា ស្មើនឹង ១៤% នៅ សេសសល់ កំពុងតែ ធ្វើ ការប្រមូល ផល បន្ត ៕
អធិការដ្ឋាន ខណ្ឌ បឹងកេងកង ប្រមូល កម្លាំងប្រជុំ ជួរ ដើម្បី ផ្សព្វផ្សាយ ផែនការ ការពារ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សាធារណៈ សម្រាប់ កិច្ចប្រជុំ អាស៊ាន នា ពេល ខាងមុខ
( ភ្នំពេញ ) ៖ យោង អនុវត្ត តាម ប្រសាសន៍ ដឹកនាំ របស់ ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ អធិការដ្ឋាន នគរបាល ខណ្ឌ បឹងកេងកង ដឹកនាំ ដោយ លោក វរសេនីយ៍ ឯក ស៊ឹម ពិសិដ្ឋ អធិការ នគរបាល ខណ្ឌ បឹងកេងកង បាន ប្រមូល កម្លាំងប្រជុំ ជួរ ដើម្បី ផ្សព្វផ្សាយ ផែនការ ការពារ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សាធារណៈ ជូន ថ្នាក់ដឹកនាំ គណៈប្រតិភូ ជាតិ និង អន្តរជាតិ សម្រាប់ កិច្ចប្រជុំ អាស៊ាន នា ពេល ខាងមុខ ។
ក្នុង ឱកាស នោះ លោក វរសេនីយ៍ ឯក ស៊ឹម ពិសិដ្ឋ ក៏ បាន ប្រាប់ ដល់ កងកម្លាំង ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ កម្លាំង ត្រូវបាន ប្រមូលផ្តុំ ១០០ % ដើម្បី អនុវត្ត ការងារ ឲ្យបាន ល្អ ធានា ឲ្យបាន នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ ក្នុង ឱកាស កិច្ចប្រជុំ អាស៊ាន ជាពិសេស កម្លាំង ផ្នែក ចរាចរណ៍ ត្រូវតែ ជួយ សម្រួល ចរាចរណ៍ កុំ ឲ្យ មាន ការកកស្ទះ រួម និង ការ ស្លៀកពាក់ ឯកសណ្ឋាន ការងារ ឲ្យបាន ត្រឹមត្រូវ ។
សូម ជម្រាប ថា កម្ពុជា នឹង ធ្វើជា ម្ចាស់ ផ្ទះ ក្នុង កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ចាប់ផ្ដើម ថ្ងៃទី ០៨ ដល់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ហើយ ដោយ កិច្ចប្រជុំ នេះ នឹង មាន ថ្នាក់ដឹកនាំ កំពូល ពិភពលោក និង ស្ថាប័ន អន្តរជាតិ ជាច្រើន ចូលរួម ។
សម្រាប់ កងកម្លាំង ដែល ត្រៀមខ្លួន ការពារ វិញ មាន ចំនួន ប្រមាណ ជាង ១.២ម៉ឺន នាក់ ក្នុង នោះ មាន ទាំង កងកម្លាំង នគរបាល ជាតិ . កងរាជអាវុធហត្ថ និង កងយោធពល ខេមរភូមិន្ទ ផងដែរ ហើយ កងកម្លាំង ទាំងអស់ នេះ គឺ មកពី បណ្ដា អង្គភាព និង ស្ថាប័ន ចំនួន ១៤ ។ ចំពោះ មុខ នេះ គឺ កងកម្លាំង កម្ពុជា មាន សមត្ថភាព គ្រប់គ្រង ក្នុង ការរក្សា សន្ដិសុខ សុវត្ថិភាព និង សណ្ដាប់ធ្នាប់ ក្នុង ព្រឹត្តិការណ៍ ដ៏ សំខាន់ មួយ នេះ ។
គូសបញ្ជាក់ ថា កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ទី៤១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ឆ្នាំ ២០២២ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នេះ គឺជា លើក ទី បី ហើយ ដែល លើក ទី១ បាន ប្រព្រឹត្តទៅ កាលពី ឆ្នាំ ២០០២ និង លើក ទី២ នៅ ឆ្នាំ ២០១២ ។ នេះ ជា មោទនភាព ជាតិ ដ៏ ធំធេង ដោយសារ វា នឹង ឆ្លុះបញ្ចាំង ឲ្យ តំបន់ និង សកលលោក ទទួលស្គាល់ និង ដឹង អំពី សក្តានុពល របស់ កម្ពុជា ហើយ នេះ ក៏ ជា វេទិកា មួយ ដែល ផ្តល់ កិត្តិយស ដល់ កម្ពុជា ឆ្លុះបញ្ចាំង អំពី សមត្ថភាព ឧត្តមភាព ស្មើ មុខមាត់ នៅក្នុង តំបន់ និង អន្តរជាតិ ផងដែរ ៕
សហរដ្ឋ អាមេរិក ចក្រភព អង់គ្លេស បារាំង អាល់ បានី អៀរឡង់ និង ន័រវែស បាន ស្នើ កោះ ប្រជុំ ក្រុមប្រឹក្សា សន្តិសុខ UN កាលពី ថ្ងៃសុក្រ បន្ទាប់ពី ទីក្រុង ព្យុងយ៉ាង បាន បាញ់ តេស្ត មីស៉ីល ជាច្រើន គ្រាប់ នៅក្នុង សប្តាហ៍ នេះ ក្នុង នោះ រួម មាន ទាំង មីស៉ីល បាលិស្ទី គ ឆ្លង ទ្វីប ICBM ដែល ត្រូវ យោធា កូរ៉េ ខាងត្បូង អះអាង ថា ទទួលបរាជ័យ ផងដែរ ។
គួរ បញ្ជាក់ ថា ជំនួស មកវិញ ទីក្រុង ប៉េកាំង និង ទីក្រុង មូស្គូ បាន ព្យាយាម ជំរុញ ឱ្យ មាន ការបន្ធូរបន្ថយ ទណ្ឌកម្ម លើ ទីក្រុង ព្យុងយ៉ាង ក្រោម ហេតុផល មនុស្សធម៌ និង ក្រោម ក្តីសង្ឃឹម ថា កូរ៉េ ខាងជើង អាច ត្រូវ បញ្ចុះបញ្ចូល ឱ្យ វិលត្រឡប់មក រក ការចរចា ដោយ សន្តិវិធី បាន ៕
ចាស់ជរា គ្មាន ទីពឹង ទូទាំង ខេត្ត ប៉ៃលិន ទទួលបាន អំណោយ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត តាមរយៈ មូលនិធិ ចាស់ជរា ខេត្ត
( ខេត្ត ប៉ៃលិន) ៖ នៅ ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ លោក ហុក សុផល អភិបាល រង ខេត្ត លោកស្រី ពៅ សុខ ក្នុង នាម លោកស្រី បាន ស្រី មុំ អភិបាល ខេត្ត ប៉ៃលិន អម ដំណើរ ដោយ ក្រុមការងារ បាន អញ្ជើញ ជួប សំណេះសំណាល សួរសុខទុក្ខ លោក តា លោកយាយ ចាស់ជរា គ្មាន ទីពឹង និង មាន ជីវភាព ខ្វះខាត ដែល មក ទទួល អំណោយ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត និង ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែកញ្ញា ឆ្នាំ ២០២២ ពី ក្រុមការងារ របស់ មូលនិធិ ។
លោក ហុក សុផល បាន ថ្លែង ថា មូលនិធិ នេះ បាន បង្កើតឡើង ក្នុង គោលបំណង ជួយ ដល់ លោកយាយ លោក តាចាស់ជរា គ្មាន ទីពឹង មាន ជីវភាព ខ្សត់ខ្សោយ និង មាន អាយុ ចាប់ពី ៧០ ឆ្នាំ ឡើង ទៅ ដែល ពុំ មាន លទ្ធភាព អាច ចេញ ទៅ ប្រកប មុខរបរ ចិញ្ចឹម ជីវិត បាន ក៏ ដូចជា ការជួយ លើក កំពស់ កម្រិត ជីវភាព និង បំប៉ន ថែទាំ សុខភាព លោកយាយ លោក តា ដោយ មិន ប្រកាន់ បក្សពួក និង និន្នាការ នយោបាយ ឡើយ ព្រោះ មនុស្ស ចាស់ គឺ មាន គុណ បំណាច់ ធំ ធេង ណាស់ ក្នុង ការជួយ អប់រំ ប្រៀន ប្រដៅ ដល់ កូន ចៅ ជំនាន់ ក្រោយ ៗ ឲ្យ ប្រព្រឹត្តិ តែ អំពើ ល្អ ។
ក្នុង នាម លោកស្រី បាន ស្រី មុំ លោក ក៏ បាន អំពាវនាវ ដល់ លោកយាយ លោក តា ទាំងអស់ សូម ចូលរួម ប្រយុទ្ធ ប្រឆាំង បង្ការ ទប់ស្កាត់ ការពារ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ដោយ ត្រូវ អនុវត្តន៍ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង ចូលរួម គោរព អនុវត្តន៍ វិធាន ចាំបាច់ នានា របស់ រាជ រដ្ឋាភិបាល ។
លោកយាយ លោក តា ដែល បាន ទទួល ប្រាក់ ឧបត្ថម្ភ ពី មូលនិធិ ចាស់ជរា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ និង បាន ជូន ពរ ស័ព្ទ សារ ធុការ ចំពោះ លោក និង លោកស្រី ប្រធាន មូលនិធិ ចាស់ជរា ដែល តែងតែ ជួយ ឧបត្ថម្ភ ថវិកា ដល់ ពួកគាត់ ជារៀងរាល់ ខែ ដើម្បី ដោះស្រាយ បញ្ហា ជីវភាព ប្រចាំ ថ្ងៃ បាន ធូរស្រាល មួយ កម្រឹត ធំ ផងដែរ ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នៅ ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន អំពី លទ្ធផល បណ្ដោះអាសន្ន ថ្ងៃទី ១៦ នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត នៅ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
លទ្ធផល បណ្ដោះអាសន្ន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ សម្រាប់ ថ្ងៃទី ៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នៅ ទូទាំង ប្រទេស មាន ដូច ខាងក្រោម៖
គិត ត្រឹម ថ្ងៃទី ៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ លទ្ធផល បណ្ដោះអាសន្ន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ទទួលបាន ដូច ខាងក្រោម៖
ពិធី ប្រគល់ អំណោយ នៃ ក្តីស្រឡាញ់ នេះ បាន ប្រព្រឹត្ត ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្រោម វត្តមាន លោក ចេង ឌីណា អភិបាល ស្រុក ខ្សាច់ កណ្តាល និង ជា ប្រធាន ស .ស .យ . ក ស្រុក . លោក អ៊ុំ ចន ប្រធាន ក្រុមប្រឹក្សា ស្រុក និង មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ ស្រុក មេបញ្ជាការ កងរាជអាវុធហត្ថ ស្រុក ព្រមទាំង មន្ត្រីរាជការ ក្នុង ស្រុក មួយចំនួន ផងដែរ ។
នា ឱកាស នោះ ដែរ លោក ចេង ឌីណា បាន គូសបញ្ជាក់ ថា ដោយ មើលឃើញ ពី ស្ថានភាព ជួប ការលំបាក ជាក់ស្តែង ពី ភាពខ្វះខាត និង តម្រូវ ការចាំបាច់ ផ្គត់ផ្គង់ ប្រចាំ ថ្ងៃ អាជ្ញាធរដែនដី ដែល តែងតែ យកចិត្តទុកដាក់ គិតគូរ ពី សុខុមាលភាព របស់ ប្រជាពលរដ្ឋ ដោយ មិន ទុក ឱ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយ អត់ អាហារ នោះ ទេ ជាពិសេស ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ចាស់ជរា ជន ពិការ ស្ត្រី មេមាយ កុមារ កំព្រា ឬ ជន ងាយ រងគ្រោះ ដោយ ប្រការ ផ្សេង ៗ ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ អ្វី ឡើយ ។
សូម ជម្រាប ថា អំណោយ នៃ ក្តីស្រឡាញ់ ស .ស .យ . ក គឺជា គំនិត ផ្តួចផ្តើម ដោយ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត កណ្តាល ដែល បាន ចង្អុលបង្ហាញ និង ណែនាំ ឱ្យ ស .ស .យ . ក ស្រុក បង្កើត អំណោយ នៃ ក្តីស្រឡាញ់ ចែកជូន ប្រជាពលរដ្ឋ ចាស់ជរា ទីទ័ល ក្រីក្រ គ្មាន ទីពឹង នៅ តាម មូលដ្ឋាន ។
សម្រាប់ គោលបំណង គឺ ចង់ឱ្យ សមាជិក សមាជិកា ស.ស .យ . ក នៅ តាម ភូមិ ឃុំ មាន ការចូលរួម ការងារ សង្គម ការងារ មនុស្សធម៌ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ទោះបីជា សកម្មភាព ណាមួយ ក៏ដោយ មិន ថា តិច ក្តី ច្រើន ក្តី ពោលគឺ ធ្វើឡើង ដោយ ស្ម័គ្រចិត្ត ពេញចិត្ត និង ប្រកបដោយ ក្តីស្រឡាញ់ ៕ រដ្ឋបាល ខេត្ត កំពង់ធំ ប្រារព្ធ អបអរសាទរ ទិវា ខួប អនុស្សាវរីយ៍ លើក ទី ៦៩ បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា និង ទិវា កំណើត កងយោធពល ខេមរភូមិន្ទ
( កំពង់ធំ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ធំ បាន រៀបចំ ធ្វើ មិ ទ្ទិញ អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៦៩ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ២០២២ និង ថ្ងៃ កំណើត កងយោធពល ខេមរភូមិន្ទ ។
ពិធី នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្រោម អធិបតីភាព លោក ឈុន ឈន់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក ងួន រតនៈ អភិបាល ខេត្ត និង មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ កងកម្លាំងប្រដាប់អាវុធ មន្រ្តី រាជការ សិស្សានុសិស្ស យុវជន ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ទិវា នេះ បាន ធ្វើឡើង នៅ ចំណុច ស្តូប វិមាន ឯករាជ្យ ខេត្ត កំពង់ធំ សង្កាត់ កំពង់ធំ ក្រុង ស្ទឹង សែន ។
ក្នុង ឱកាស នោះ ដែរ លោក ងួន រតនៈ បាន បញ្ជាក់ ថា ថ្ងៃ នេះ ជា ថ្ងៃ ដ៏ មហាន ក្ខត្ត ឫក្ស ឧត្តុង្គឧត្តម ដែល ខេត្ត កំពង់ធំ យើង បាន ប្រារព្ធ ទិវា អបអរ ខួប អនុស្សាវរីយ៍ បុណ្យ ឯករាជ ជាតិ ៩វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ឆ្នាំ ២០២២ ខួប លើក ទី ៦៩ និង ទិវា រំលឹក ខួបកំណើត កងយោធពល ខេមរភូមិន្ទ និង បាន រៀបចំ ពិធី ប្រណាំង ទូក «ង » ផងដែរ ។
ការចរចា នៅ ប៉ារីស បាន ឈាន ទៅដល់ សំណើ មួយ ដែល ធ្វើឡើង ដោយ មាន ប្រទេស បារាំង យល់ព្រម ផ្ដល់ សម្បទាន ដ៏ សំខាន់ ខ្លះ ដល់ កម្ពុជា ។ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ នរោត្តម សីហនុ បាន យាង មកកាន់ រាជធានី ភ្នំពេញ វិញ នៅ ថ្ងៃទី ១៤ ខែឧសភា ឆ្នាំ ១៩៥៣ ដើម្បី ជួប ជាមួយ សហសេវិក និង នាយក រដ្ឋមន្ត្រី របស់ ព្រះអង្គ ។
ក្រោយមក ព្រះអង្គ ទ្រង់ បាន ភៀស ព្រះកាយ ទៅ ប្រទេស ថៃ ក្រោយពី មាន សេចក្ដីប្រកាស មួយ ដែល ទាក់ទាញ ពិភពលោក ស្តីពី ការ មិន ពេញចិត្ត នឹង បំណងប្រាថ្នា ស្រប ច្បាប់ របស់ ប្រជាជន ខ្មែរ ។ ការ មិន ពេញចិត្ត នេះ អាច នាំមក នូវ ផលវិបាក យ៉ាង ធ្ងន់ធ្ងរ ទាំង សម្រាប់ ប្រទេស កម្ពុជា និង ពិភពលោក ទាំងមូល ។
លោក បាន បន្ត ថា សម្តេច ព្រះបរម រតន កោដ្ឋ ទ្រង់ មាន ព្រះតម្រិះ រិះរក គន្លឹះ ដើម្បី ដោះស្រាយ បញ្ហា មាតុភូមិ កម្ពុជា ប្រកបដោយ គតិបណ្ឌិត ទេពកោសល្យ ធ្វើឱ្យ មាតុភូមិ មាន សុខ សន្តិភាព រស់ ក្រោម ដំបូល ឆ័ត្រ តែ មួយ ។
ក្នុង ទិវា រំលឹក ខួប អនុស្សាវរីយ៍ បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ឆ្នាំ ២០២២ ក្នុង ឱកាស ដ៏ អធិកអធម្ម នោះ គឺ សង្កេតឃើញ ថ្នាក់ដឹកនាំ ខេត្ត ព្រមទាំង បណ្ដា មន្ទីរ អង្គភាព បាន អញ្ជើញ ឡើង ដាក់ កម្រង ផ្កា ក្នុង ស្តូប វិមាន ឯករាជ្យ ប្រកបដោយ ទឹកមុខ រីករាយ និង បាន បង្ហោះ ប៉ោង ៗ ដោយ ចង ពាក្យស្លោក ដ៏ មាន អត្ថន័យ ផងដែរ ៕
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ឱ្យដឹង ថា សិស្ស ឆ្នើម កម្រិត អន្តរជាតិ នៃ សាលា អន្តរជាតិ ស៊ី អាយ អេ ហ្វឺសត៍ ដែល នឹង ត្រូវ ចូលរួម ប្រកួត វគ្គ ផ្តាច់ព្រ័ត្រ ពានរង្វាន់ បញ្ញា វន្ត ពិភពលោក នេះ រួម មាន៖ យុវសិស្ស ធន់ សុគន្ធ ក្លីន ដឺ . យុវសិស្ស ជួរ គឹម លី. យុវសិស្ស ទីវ សុភ័ក្រ្ត នីកា និង យុវសិស្ស ឡុង ស៊ីង ហួ ។
លទ្ធផល ជា ផ្លែ ផ្កា ដ៏ ត្រចះត្រចង់ ដែល ពួកគេ ទទួលបាន នៅ ថ្ងៃ នេះ គឺ ឆ្លុះបញ្ចាំង ពី ភាពជាដៃគូ ដែល មិន អាច ខ្វះ បាន រវាង សាលា និង មាតាបិតា ឬ អ្នកអាណាព្យាបាល ហើយ គឺជា រង្វាស់ នៃ គុណភាព ការអប់រំ នៅ សាលា អន្តរជាតិ ស៊ី អាយ អេ ហ្វឺសត៍ ដូច មាន ចែង ក្នុង ទស្សនវិស័យ របស់ សាលា តាំងពី ដើម រៀង មក គឺ ផ្ដល់ បរិយាកាស នៃ ការបង្រៀន លើកកម្ពស់ ដល់ ការអប់រំ កម្រិត ខ្ពស់ ជា លក្ខណៈ អន្តរជាតិ ទាំង កម្មវិធី សិក្សា ជាតិ និង កម្មវិធី សិក្សា អន្តរជាតិ ។
យុវសិស្ស ឆ្នើម របស់ យើង នឹង ចេញដំណើរ ទៅ សហរដ្ឋ អាមេរិក នៅ ថ្ងៃទី ០៦ និង ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ហើយ សាលា សូម ជូនពរ ប្អូន ៗ ទាំង ០៤ រូប ព្រមទាំង ក្រុមគ្រួសារ ទទួលបាន សេចក្តីសុខ សុវត្ថិភាព ក្នុង ការធ្វើដំណើរ និង ទទួលបាន ជ័យលាភី ជើងឯក ក្នុង ការប្រកួត ៕
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការរក ឃើញ អ្នក ឆ្លង កូវីដ១៩ ចំនួន ១នាក់ ខណៈ អ្នក ជាសះស្បើយ គ្មាន ។
ការ ឱ្យដឹង បែប នេះ របស់ លោក នេត្រ ភក្ត្រា បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក បាន ដឹកនាំ កិច្ចប្រជុំ បូក សរុប លទ្ធផល យុទ្ធនាការ អន្ទាក់ សូន្យ នា ថ្ងៃទី ៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នៅ ទីស្តីការ ក្រសួង បរិស្ថាន ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ អគ្គ នាយកដ្ឋាន តំបន់ ការពារ ធម្មជាតិ និង តំណាង អង្គការ ក្រៅ រដ្ឋាភិបាល ជាតិ និង អន្តរជាតិ ដែល ជា ដៃគូ រៀបចំ យុទ្ធ នារ អន្ទាក់ សូន្យ ។
ជាមួយគ្នា នេះ ដែរ រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន ថ្លែងអំណរគុណ ដល់ អង្គការ ដៃគូ ដែល បាន ចូលរួម ជាមួយ ក្រសួង បរិស្ថាន រៀបចំ យុទ្ធនាការ ដ៏ មាន សារៈសំខាន់ ដើម្បី ផ្លាស់ប្តូរ ឥរិយាបថ ប្រជាពលរដ្ឋ ចំពោះ ការហូប សាច់ សត្វ ព្រៃ និង ការផ្សព្វផ្សាយ ពី ផល លំបាក នៃ អន្ទាក់ ទៅ លើ សុវត្ថិភាព សត្វ ព្រៃ និង មនុស្ស ។
ក្រសួង បរិស្ថាន ព្រមទាំង ដៃគូ អភិរក្ស និង ដៃគូ អភិវឌ្ឍន៍ ធ្វើ ការរួមគ្នា ដើម្បី ផ្តល់ ជម្រើស មុខរបរ រួមទាំង គំនិត ផ្តួចផ្តើម កសិកម្ម និង អេកូ ទេសចរណ៍ ដល់ សមាជិក សហគមន៍ ដែល រស់ នៅក្នុង និង ជុំវិញ តំបន់ ការពារ ធម្មជាតិ ដែល មាន ទំនៀមទម្លាប់ ពឹងផ្អែក លើ ការប្រមូល អនុផល ព្រៃឈើ និង ការបរបាញ់ សត្វ ព្រៃ តាម បែប ប្រពៃណី ដើម្បី យក សាច់ បរិភោគ និង ជួញដូរ ផ្សេង ៗ ។
យោង តាម លទ្ធផល ៦ខែ នៃ យុទ្ធនាការ យុទ្ធនាការ អន្ទាក់ សូន្យ ទាំង ៦ ខេត្ត មាន អ្នកចូលរួម ដោយ ផ្ទាល់ ជាង ៣ពាន់ នាក់ មាន អត្ថបទ ព័ត៌មាន ជាង ៦០០ ចំណងជើង ត្រូវបាន សរសេរ និង ចុះផ្សាយ លើ បណ្តាញ ព័ត៌មាន ជាតិ និង អន្តរជាតិ និង បាន ផ្សព្វផ្សាយ ទៅដល់ ប្រជាពលរដ្ឋ ជាង ៣លាន នាក់ ។
ជាមួយគ្នា នេះ ភោជនីយដ្ឋាន ចំនួន ៥២ ក្នុង ខេត្ត ៦ នៃ ខេត្ត គោលដៅ យុទ្ធនាការ អន្ទាក់ សូន្យ បាន ប្រកាស ជា កន្លែង មិន លក់ មុខ ម្ហូប ដែល ធ្វើ ពី សាច់ សត្វ ព្រៃ ហើយ ភោជនីយដ្ឋាន ទាំងនេះ ទទួលបាន នូវ បណ្ណ សរសើរ មេត្រី បរិស្ថាន ពី ក្រសួង បរិស្ថាន ចំពោះ ការតាំងចិត្ត និង ចូលរួម ក្នុង ការទប់ស្កាត់ ការជួញដូរ សត្វ ព្រៃ ខុស ច្បាប់ ។
លោក នេត្រ ភក្ត្រា បាន គូសបញ្ជាក់ ថា យុទ្ធនាការ អន្ទាក់ សូន្យ នេះ បាន ផ្តល់ អត្ថប្រយោជន៍ ជាច្រើន សម្រាប់ បរិស្ថាន និង ធនធាន ធម្មជាតិ ជាពិសេស ជា ផ្នែក មួយ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ផ្តល់ ជម្រក សុវត្ថិភាព ដល់ សត្វ ព្រៃ ដោយ « រក្សា ព្រៃឈើ បាន នឹង សម្បូណ៌ សត្វ ព្រៃ » ។ សាធារណជនជា រួម បាន ដឹង ពី យុទ្ធនាការ អន្ទាក់ សូន្យ និង បាន ទទួល ព័ត៌មាន យ៉ាង ទូលំទូលាយ ពី អ្វី ដែល បាន ផ្សព្វផ្សាយ ចេញ ពី យុទ្ធនាការ អន្ទាក់ សូន្យ ។
ទាំង មន្ត្រី ក្រសួង បរិស្ថាន និង អង្គការ សង្គម ស៊ីវិល ដែល ធ្វើ ការងារ អភិរក្ស បាន បង្ហាញ ការពេញចិត្ត ចំពោះ លទ្ធផល ដែល ទទួលបាន ពី យុទ្ធនាការ អន្ទាក់ សូន្យ រយៈពេល ៦ខែ មក នេះ ដោយ បាន គូសបញ្ជាក់ ថា វា ជា កិច្ចការងារ ចាំបាច់ បំផុត ដែល ក្រសួង បរិស្ថាន និង អង្គការ ដៃ រួមគ្នា ធ្វើ យុទ្ធនាការ រួមគ្នា ដើម្បី លុបបំបាត់ អម្ទាក់ ដែល ជា ឃាតក លាក់ មុខ សម្លាប់ សត្វ ព្រៃ កម្ពុជា ជារៀងរាល់ ថ្ងៃ ។
គេ មិន ដឹង ថា ក្នុង មួយ ឆ្នាំ មាន អន្ទាក់ ប៉ុន្មាន នោះ ទេ ដែល ត្រូវបាន ដាក់ ក្នុង តំបន់ ការពារ ធម្មជាតិ កម្ពុជា តែ យោង តាម ទិន្នន័យ នៃ ក្រសួង បរិស្ថាន អន្ទាក់ ជាង ៦ម៉ឺន ត្រូវបាន ដោះ នៅ ឆ្នាំ ២០២១ កន្លងទៅ ។ តាម ការសិក្សា កន្លងទៅ បរិមាណ អន្ទាក់ ត្រឹមតែ ២០% ប៉ុណ្ណោះ ដែល ដោះ ចេញ ពី តំបន់ ការពារ ធម្មជាតិ ក្នុង មួយ ឆ្នាំ ។
លោក នេត្រ ភក្ត្រា បាន ថ្លែង ថា យុទ្ធនាការ អន្ទាក់ សូន្យ នឹង មិន បញ្ឈប់ ត្រឹម នេះ ទេ ប៉ុន្តែ នឹង បន្ត ធ្វើជា លក្ខណៈ ភ្លៀង រលឹម ហើយ នឹង ត្រូវ ពង្រីក ទៅកាន់ តំបន់ ជួរ ភ្នំ ក្រវ៉ាញ ដូចជា ខេត្ត កំពង់ស្ពឺ ខេត្ត កោះកុង ខេត្ត ពោធិ៍សាត់ ជាដើម ដែល ជា តំបន់ មាន តំបន់ ការពារ ធម្មជាតិ និង មាន ការលួច បរបាញ់ និង លក់ដូរ សាច់ សត្វ ព្រៃ ខុស ច្បាប់ ៕
គួរ បញ្ជាក់ ថា គិត ចាប់តាំងពី រុស្ស៉ី បាន បើក ការឈ្លានពាន លើ អ៊ុយក្រែន កាលពី ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ សហរដ្ឋ អាមេរិក បាន ផ្តល់ ជំនួយ យោធា គិត ជា ទឹកប្រាក់ សរុប យ៉ាងហោច ១៨ ពាន់ លាន ដុល្លារ ហើយ ដល់ ទីក្រុង កៀវ ៕
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ ប្រទេស កម្ពុជា ចេញផ្សាយ នៅ ថ្ងៃទី ៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ឱ្យដឹង ថា ¬ តប តាម ការអញ្ជើញ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ឯកឧត្តម លី ខឺ ឈាង (LI Keqiang) នាយក រដ្ឋមន្រ្ដី នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន និង លោកជំទាវ នឹង អញ្ជើញ មក បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ពី ថ្ងៃទី ០៨ - ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
លោក បណ្ឌិត ជា មុនី ឫទ្ធិ បាន ប្រាប់ វិទ្យុ មិត្តភាព កម្ពុជា ចិន នៅ ថ្ងៃទី ៥ ខែវិច្ឆិកា នេះ ថា ដំណើរទស្សនកិច្ច នេះ មិន ត្រឹមតែ គាំទ្រ បេសកម្ម ការងារ របស់ កម្ពុជា ក្នុង នាម ជា ប្រធាន អាស៊ាន ប្តូរ វេន ឆ្នាំ ២០២២ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ បាន ចូលរួម ក្នុង ការពង្រឹង ពង្រីក ចំណង ទាក់ទង ទ្វេ ភាគី ដើម្បី បង្កើន នូវ កិច្ចសហប្រតិបត្តិការ នានា ជាពិសេស ទាក់ទង ទៅ នឹង ផែនការ សកម្មភាព ការងារ ៥ ឆ្នាំ កន្លងមក ស្តីពី ការកសាង សហគមន៍ ចិន កម្ពុជា អនាគត រួមគ្នា ។
បើ យោង តាម ក្រសួង ការបរទេស បាន បញ្ជាក់ ថា ក្នុង អំឡុង ពេល នៃ ទស្សនកិច្ច នេះ ឯកឧត្តម លី ខឺ ឈាង នឹង ថ្វាយបង្គំ គាល់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ព្រះបរម រាជ វាំង ។
សូម បញ្ជាក់ ថា កម្ពុជា ចិន ជា តែងតែ គាំទ្រ ជួយ គ្នា ទៅ វិញ ទៅ មក គ្រប់ កាលៈទេសៈ ទាំង ថ្នាក់ តំបន់ និង ឆាក អន្តរជាតិ ជាតិ ។ ប្រទេស ចិន បាន រួមចំណែក យ៉ាង សំខាន់ ក្នុង អភិវឌ្ឍន៍ នៅ កម្ពុជា ។ ហើយ កម្ពុជា បាន ប្រកាន់ ជំហរ យ៉ាង ច្បាស់ គឺ គាំទ្រ គោល នយោបាយ ចិន តែ មួយ ៕
ពិព័រណ៌ នាំចូល ចិន អន្តរជាតិ បញ្ចេញ ពី សូរ សៀង ខ្លាំង បំផុត នៃ ការបន្ត បើក ទូលាយ របស់ ប្រទេស ចិន ខណៈ មេដឹកនាំ ប្រទេស ចិន បញ្ជាក់ ពី គំនិត ផ្តួចផ្តើម អំពី ការបើក ទូលាយ
( ប៉េកាំង ) ៖ ចាប់ពី ថ្ងៃទី ៥ ដល់ ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ លើក ទី៥ នឹង ប្រារព្ធ ឡើង នៅ ក្រុង សៀងហៃ ប្រទេស ចិន ។ ក្នុង នាម ជាពិព័រណ៍ ថ្នាក់ ជាតិ ទី មួយ លើ ពិភពលោក ដែល ផ្តោត សំខាន់ លើ ការនាំចូល តាំងពី ត្រូវបាន រៀបចំ ធ្វើឡើង ជា លើក ដំបូង នៅ ឆ្នាំ ២០១៨មក ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ （ ហៅ កាត់ CIIE） បាន ក្លាយទៅជា វេទិកា សំខាន់ ៤ ដូចជា ការបញ្ជាទិញ អន្តរជាតិ ការជំរុញ បណ្តាក់ទុន វិនិយោគ ការផ្លាស់ប្តូរ វប្បធម៌ មនុស្សជាតិ និង កិច្ចសហប្រតិបត្តិការ បើក ទូលាយ ។
លោក បាន ប្រកាស ថា៖ ប្រទេស ចិន នឹង ជំរុញ ឱ្យ គ្រប់ ប្រទេស និង គ្រប់ ភាគី រួមគ្នា ចែករំលែក កាលានុវត្តភាព នៃ ទីផ្សារ ធំ របស់ ប្រទេស ចិន ។ ប្រទេស ចិន នឹង ជំរុញ ឱ្យ គ្រប់ ប្រទេស និង គ្រប់ ភាគី រួមគ្នា ចែករំលែក កាលានុវត្តភាព នៃ ការបើក ទូលាយ ខាង ប្រព័ន្ធ ។
ប្រទេស ចិន នឹង ជំរុញ ឱ្យ គ្រប់ ប្រទេស និង គ្រប់ ភាគី រួមគ្នា ចែករំលែក កានា លុវត្តភាព នៃ ការធ្វើ កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ដ៏ កាន់តែ ស៊ីជម្រៅ ចិន នឹង ជំរុញ សេរីភាព និង ភាពងាយស្រួល នៃ ការធ្វើ ពាណិជ្ជកម្ម និង វិនិយោគ ពង្រីក ធំ នូវ បណ្តាញ នៃ តំបន់ ពាណិជ្ជកម្ម សេរី ស្តង់ដារ ខ្ពស់ ដែល បើក ចំពោះ សកលលោក គាំទ្រ និង ជួយ ប្រទេស កំពុង អភិវឌ្ឍន៍ ដោយ ម៉ឺងម៉ាត់ ដើម្បី ពន្លឿន ការវិវឌ្ឍ រីកចម្រើន ដើម្បី ជំរុញ ការបង្កើត សហគមន៍ រួម វាសនា នៃ មនុស្សជាតិ ។
នេះ គឺ ដោយសារ ខ្យល់ រដូវ ផ្កា រីក ដោយ បើក ទូលាយ ពេញ ពិភពលោក នៅក្នុង ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ ទាំង៤ លើក កន្លងមក ផលិតផល ថ្មី បច្ចេកទេស ថ្មី ឬ សេវាកម្ម ថ្មី សរុប ជាង ១៥០០ បាន បង្ហាញ ជា លើក ដំបូង នៅក្នុង ពិភពលោក ឬ នៅក្នុង មហា ដី គោក ចិន ជាមួយនឹង ទំហំ ប្រាក់ចុះ កង់ត្រា កើនឡើង ដល់ ២៧២៣រយ លាន ដុល្លារ អាមេរិក ដែល ក្លាយជា ម៉ាស៊ីន ជំរុញ សម្រាប់ កំណើន ពាណិជ្ជកម្ម អន្តរជាតិ និង ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច សកល ៕
វិទ្យុ មិត្តភាព កម្ពុជា ចិន ម៉ោង ៩ យប់ នេះ FRESH TALK ប្រធានបទ ទី១៖ កិច្ចប្រជុំ កំពូល អាស៊ាន និង ការសម្របសម្រួល សន្តិភាព សម្រាប់ សង្គ្រាម នៅ អ៊ុយក្រែន និង ទី២៖ ភាពតានតឹង ជាថ្មី នៅ ឧបទ្វីប កូរ៉េ ក្រោយ ការបាញ់ មីស៊ីល កាន់តែ ច្រើន របស់ កូរ៉េ ខាងជើង
បទ អត្ថាធិប្បាយ៖ កិច្ចសហប្រតិបត្តិការ រវាង ចិន និង អាហ្រ្វិក មាន សារសំខាន់ ចំពោះ ការអភិវឌ្ឍ ប្រកបដោយ និរន្តរភាព នៃ ពិភពលោក ទាំងមូល
( ប៉េកាំង ) ៖ « ក្នុង បរិបទ ថ្មី ការអភិវឌ្ឍ ទំនាក់ទំនង រវាង ចិន និង តង់ ហ្សានី ឱ្យ បាន ល្អ វា មិន ត្រឹមតែ សមស្រប នឹង ផលប្រយោជន៍ រួម និង វែងឆ្ងាយ របស់ ប្រទេស ទាំង ពីរ ប៉ុណ្ណោះ ទេ ថែមទាំង ក៏ មាន សារសំខាន់ ណាំស់ ចំពោះ ការជំរុញ ការបង្កើត សហគមន៍ រួម វាសនា រវាង ចិន និង អាហ្រ្វិក ក្នុង យុគសម័យ ផងដែរ » ។ នៅ ថ្ងៃទី ៣ ខែវិច្ឆិកា នៅ ក្រុង ប៉េកាំង លោក ស៊ី ជីន ភីង ប្រធាន រដ្ឋ ចិន បាន ជួប ពិភាក្សា ការងារ ជាមួយ លោក Hassan ប្រធានាធិបតី តង់ ហ្សានី ដែល អញ្ជើញ ទៅ បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ ប្រទេស ចិន ។
ក្នុង ពេល ជាមួយគ្នា នេះ ប្រទេស ចិន ក៏ ជា ដៃគូ ល្អ តាម ផ្លូវ អភិវឌ្ឍន៍ របស់ ប្រទេស តង់ ហ្សានី ផងដែរ ជា យូរ ណាស់ មកហើយ ប្រទេស ចិន បាន រួមចំណែក ជាច្រើន ដូចជា ការវិនិយោគ និង គម្រោង ជំនួយ ឧបត្ថម្ភ ដល់ ប្រទេស អាហ្រ្វិក ខាងកើត នេះ ។ លោក Hassan ប្រធានាធិបតី តង់ ហ្សានី បាន ថ្លែង ថា ភាគី តង់ ហ្សនី ចាត់ទុក ប្រទេស ចិន ជា មិត្តភក្តិ ដ៏ ពិតប្រាកដ បំផុត និង សំខាន់ បំផុត ហើយ រីករាយ ធ្វើជា ដៃគូ របស់ ចិន ដែល អាច ជឿ ទុកចិត្ត បានជារៀងរហូត ។
ទ្វីប អាហ្រ្វិក មាន សុភាសិត មួយ ដែល ថា « ម្នាក់ឯង ដើរ លឿន ទាំងអស់ គ្នា ដើរ ឆ្ងាយ » ។ ឱ្យ តែ ប្រជាជន នៃ ប្រទេស ចិន និង អាហ្រ្វិក ចំនួន ២ពាន់ ៧រយ លាន នាក់ អាច ចាប់ ដៃ គ្នា និង សាមគ្គី គ្នា ជា ធ្លុង មួយ នោះ ក៏ នឹង បង្កើត ថ្ងៃស្អែក ដែល មាន ភាព កាន់តែ ល្អ បវរ ។ លើស ពី នេះ ទៅ ទៀត សហគមន៍ រួម វាសនា រវាង ចិន និង អាហ្រ្វិក ក្នុង យុគសម័យ ថ្មី ដែល ត្រូវបាន ពង្រឹង ជា បន្តបន្ទាប់ ក៏ នឹង រួមចំណែក ថាមពល វិជ្ជមាន កាន់តែ ច្រើន ដល់ សន្តិភាព និង ការអភិវឌ្ឍ របស់ ពិភពលោក ផងដែរ ៕
រដ្ឋបាល រាជធានី ក្រើន រំលឹក ឱ្យ អតីត បុគ្គលិក ណាហ្គាវើលដ៍ បញ្ឈប់ ការប្រមូលផ្ដុំ តវ៉ា អំឡុង បុណ្យ អុំ ទូក និង កិច្ចប្រជុំ កំពូល អាស៊ាន ចាប់ពី ថ្ងៃទី ០៦ - ១៣ ខែវិច្ឆិកា (Video inside) ( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ក្រើន រំលឹក ដល់ អតីត បុគ្គលិក ណាហ្គាវើលដ៍ ឱ្យ បញ្ឈប់ ការប្រមូលផ្ដុំ តវ៉ា នៅ អំឡុង បុណ្យ អុំ ទូក និង កិច្ចប្រជុំ កំពូល អាស៊ាន ចាប់ពី ថ្ងៃទី ០៦ ដល់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ខាងមុខ នេះ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ព្រមាន ថា ក្នុង ករណី ក្រុម អ្នកតវ៉ា នៅតែ បន្ត សកម្មភាព ប្រមូលផ្ដុំ ជួបជុំ តវ៉ា ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ និង របៀបរៀបរយ សាធារណៈ ក្នុង អំឡុង ពេល កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នានា នោះ ត្រូវ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ជាធរមាន ៕
ថ្លែង ក្នុង កម្មវិធី ជំនួប ជាមួយ អ្នកសារព័ត៌មាន ជាន់ ខ្ពស់ ជិត ១០០ នាក់ ស្តីពី « ការត្រៀមយក ព័ត៌មាន ស្តីពី កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ » ដែល រៀបចំ ដោយ ក្លិប អ្នកកាសែត កម្ពុជា ( ក. អ. ក) លោក ពុយ គា បាន ចែករំលែក បទពិសោធ ពី កិច្ចប្រជុំ អន្តរជាតិ សំខាន់ ៗ ដោយ លើក ឧទាហរណ៍ ចំ ៗ ទៅ លើ ប្រទេស មួយចំនួន ដូចជា ប៊ែលហ្សិក សិង្ហបុរី ហ្វីលីពីន និង ឡាវ ជាដើម ។
ផ្ទុយទៅវិញ លោក ពុយ គា បាន សរសើរ ប្រទេស ថៃ ដែល បាន ផ្តល់ សេវា បន្ថែម ទៀត ដូចជា ម៉ាស្សា ដល់ អ្នកសារព័ត៌មាន និង គណប្រតិភូ ។ លោក ក៏ សរសើរ ប្រទេស ឡាវ និង ហ្វីលីពីន ដែល មិន មែន ជា ប្រទេស អ្នក មាន ទេ ប៉ុន្តែ មាន ចិត្ត ទូលាយ ដែល បាន រៀបចំ ម្ហូប អាហារ ច្រើន ពេញ ៗ តុ ល្អ ៗ រួមទាំង គ្រឿង សមុទ្រ ផង សម្រាប់ អ្នកសារព័ត៌មាន និង ប្រតិភូ ។ ប៉ុន្តែ ប្រទេស សិង្ហបុរី ដែល ជា ប្រទេស អ្នក មាន ជាង គេ នៅ អាស៊ាន បែរជា កំណាញ់ ស្វិត ទៅ វិញ ។
ការចែករំលែក បទពិសោធ និង ចំណាប់អារម្មណ៍ របស់ អ្នកសារព័ត៌មាន ធ្វើឡើង ចំ ពេល ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ សម្រាប់ កិច្ចប្រជុំ កំពូល អាស៊ាន ដែល នឹង ចាប់ផ្តើម នៅ រាជធានី ភ្នំពេញ នា សប្តាហ៍ ក្រោយ នេះ ។
កម្ពុជា ត្រូវបាន គេ អបអរសាទរ និង កោតសរសើរ ចំពោះ ភាពជោគជ័យ នៅឯ កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ កាលពី ខែសីហា ឆ្នាំ ២០២២ កន្លងទៅ នេះ ៕
ថ្នាក់ដឹកនាំ ក្រុមការងារ ឃុំ បឹង ព្រះ ខេត្ត ព្រៃវែង ចុះ ជួប ផ្ទាល់ ជាមួយ តំណាង ប្រជាពលរដ្ឋ ស្រង់ មតិ និង បញ្ហា ប្រឈម
( ព្រៃវែង ) ៖ លោក អ៉ីវ លាង ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ជាតិ ចុះ ជួយ ឃុំ បឹង ព្រះ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ តំណាង ជា ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ ក្បាល ដំរី ឃុំ បឹង ព្រះ ស្រុក បាភ្នំ ខេត្ត ព្រៃវែង នៅ ថ្ងៃទី ៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ។
ការជួប សំណេះសំណាល នេះ មាន ការអញ្ជើញ ចូលរួម ពី ប្រធាន ក្រុមការងារ ចុះ ជួយ ភូមិ ក្បាល ដំរី ប្រធាន ក្រុមការងារ ចុះ ជួយ ភូមិ សមាជិក មេឃុំ សមាជិក ក្រុមប្រឹក្សា ឃុំ មេភូមិ និង អ្នក ពាក់ព័ន្ធ មួយ ចំនួន ។
លោក ប្រធាន ក្រុមការងារ ឃុំ បាន លើកឡើង ពី សមិទ្ធផល ធំ ៗ របស់ រាជ រដ្ឋាភិបាល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ . សម្តេច ក្រឡាហោម ប្រធាន ក្រុមការងារ ចុះ ជួយ ខេត្ត ព្រៃវែង និង លោក ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក បាភ្នំ ជូន ប្រជាពលរដ្ឋ បាន ជ្រាប បន្ថែម ទៀត ។
លោក បាន បន្ត ថា ការធ្វើ នយោបាយ របស់ ពួក អគតិ មួយ ក្តាប់ តូច តែង ចិញ្ចឹម ចិត្ត ធ្វើ នយោបាយ ប្រជាភិថុត បំផ្លើស វាយប្រហារ មក លើ សមិទ្ធផល របស់ រាជ រដ្ឋាភិបាល ពេលនេះ ឈានដល់ ប្រមាថ បំពាន ដល់ អង្គ ព្រះមហាក្សត្រ ទៀត ចាំបាច់ ណាស់ យើង ត្រូវ ប្រឆាំង ដាច់ខាត នូវ ការបំពាន គ្រប់ រូបភាព និង ចូលរួម ការពារ អង្គ ព្រះមហាក្សត្រ ការពារ សន្តិភាព សណ្តាប់ធ្នាប់ សាធារណៈ ក្នុង សង្គម ។
លោក បាន លើកឡើង ពី ផែនការអភិវឌ្ឍ ឃុំ គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព និង សារៈសំខាន់ នៃ ការចូលរួម ផ្តល់ កិច្ចសហការ និង រាយការណ៍ ហេតុការណ៍ នានា ពី បងប្អូន ប្រជាជន មក អាជ្ញាធរ ។
ឆ្លៀត ឱកាស នោះ លោក បាន លើកទឹកចិត្ត ដល់ ពលរដ្ឋ ករណី ដែល បាន រាយការណ៍ ឱ្យដឹង ពី ការឆក់ ត្រី លួច មាន់ ក្មេង ទំនើង វ៉ៃ គ្នា ក្នុង ពេល លោក ជួប សំណេះសំណាល កន្លងមក ។
ទន្ទឹមនឹង នេះ លោក ក៏ បាន ស្នើសុំ ចូលរួម រាយការណ៍ ពី អ្នក ទី ទាល់ ជួប ការលំបាក មក ក្រុមការងារ ដើម្បី ជួយ សម្រួល ជូន គាត់ តាម ភាព ជាក់ស្តែង ផងដែរ ។
ក្នុង ឱកាស នោះ ដែរ លោក អ៉ីវ លាង បាន អនុញ្ញាត ជូន ប្រជាពលរដ្ឋ លើកឡើង ពី សំណូមពរ នានា ក្នុង នោះ មាន ស្នើសុំ ចាក់ ដី បំពេញ ជង្ហុក តាម ដងផ្លូវ កាយ ប្រឡាយ ទឹក ប្រមាណ ៨០០ ម៉ែត្រ និង ដាក់ លូរំដោះ ទឹក ឆ្លើយតប ចំពោះ បញ្ហា នេះ លោក បាន ទទួលយក ទាំងអស់ ដោយឡែក សម្រាប់ ការកាយ ប្រឡាយ ទឹក និង ដាក់ លូ លោក បាន ប្រគល់ ជូន ក្រុមការងារ ភូមិ ជាមួយ ឃុំ សិក្សា ពិនិត្យ ដើម្បី ទទួលយក បាន ទាំងអស់ គ្នា ជៀសវាង អ្នក ខាងលើ សប្បាយ តែ អ្នក ខាងក្រោម បែរជា មិន សប្បាយ ទៅ វិញ ៕
ក្នុង ពិធី នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ចាន់ ចេស្តា រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ . លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ និង មន្ត្រី ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
ជា ការឆ្លើយតប ចំពោះ ផល ប៉ះពាល់ ដោយ ទឹក ជំនន់ ខាងលើ អាជ្ញាធរ ខេត្ត ក្រុង ស្រុក មន្ទីរ ជំនាញ កងកម្លាំងប្រដាប់អាវុធ កាកបាទ ក្រហម ខេត្ត និង អង្គការ ដៃគូ បាន នាំយក អំណោយ មនុស្សធម៌ ផ្តល់ ជូន គ្រោះសារ រងគ្រោះ ជា បន្តបន្ទាប់ ផងដែរ ។
ជា កិច្ច ចាប់ផ្តើម សំណេះសំណាល នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម បាន នាំយក នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន បងប្អូន ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ព្រះវិហារ ដែល សម្តេច ទាំង ទ្វេ តែងតែ យកចិត្តទុកដាក់ ចំពោះ ពលរដ្ឋ កម្ពុជា គ្រប់ ៗ រូប ។
លោក ទេសរដ្ឋមន្ត្រី បាន ថ្លែង ទៅកាន់ ប្រជាពលរដ្ឋ ពី កិច្ចអន្តរាគមន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន ជួយ ពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ដោយ សម្តេច តេជោ បាន អញ្ជើញ ទៅកាន់ ខេត្ត ជុំវិញ បឹង ទន្លេ សាប និង ខេត្ត ព្រៃវែង ដើម្បី ផ្តល់ ពូជ ស្រូវ និង ស្បៀងអាហារ ផ្សេង ៗ ។
លោក ទេសរដ្ឋមន្ត្រី បាន គូស រំលេច ថា បើ ទោះបី សម្តេច មមាញឹក នឹង ការងារ ធំ ៗ របស់ ជាតិ តែ សម្តេច នៅតែ ឆ្លៀត ពេល ពី ការងារ ដ៏ មមាញឹក ដើម្បី ដោះស្រាយ បញ្ហា របស់ ប្រជាពលរដ្ឋ ជួប គ្រោះ ទឹក ជំនន់ ។ តាមរយៈ សកម្មភាព ទាំងនេះ បាន ស្តែង ឱ្យ ឃើញ ពី ការយកចិត្តទុកដាក់ ខ្ពស់ របស់ សម្តេច តេជោ ទៅ លើ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ជាពិសេស ពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ។
លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ចូលរួម សោកស្តាយ ជាមួយ ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់ ដោយសារតែ គ្រោះ ទឹក ជំនន់ ។ បើ ទោះបីជា យ៉ាងណា លោក ទេសរដ្ឋមន្ត្រី បាន លើកទឹកចិត្ត ដល់ ប្រជាពលរដ្ឋ ឱ្យ ប្រឹងប្រែង ធ្វើ ស្រែ ឡើងវិញ សម្រាប់ កន្លែង មាន ប្រភព ទឹក ហើយ កន្លែង គ្មាន ប្រភព ទឹក ត្រូវ យកចិត្តទុកដាក់ ដាំដុះ បន្លែ និង ចិញ្ចឹម សត្វ ដើម្បី ទ្រទ្រង់ ជីវភាព ។
ទេសរដ្ឋមន្ត្រី ដែល ទើប ទទួលគោរមងារ « កិត្តិសង្គហ បណ្ឌិត » ពី ព្រះមហាក្សត្រ ក៏ បាន ជំរុញ ឱ្យ អាជ្ញាធរ តាមដាន និង ជួយ ដល់ ប្រជាពលរដ្ឋ ក្នុង ការធ្វើ ស្រែ ដាំដុះ បន្លែ ក៏ ដូចជា ចិញ្ចឹម សត្វ ក្រោយពេល ទឹក ជំនន់ ដើម្បី ធានា ដល់ ការស្តារ ឡើងវិញ នូវ ជីវភាព របស់ ពួកគាត់ ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត ក៏ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ អាជ្ញាធរ ពាក់ព័ន្ធ ដែល បាន រួមគ្នា ដោះស្រាយ បញ្ហា របស់ ប្រជាពលរដ្ឋ ពេល ទឹក ជំនន់ ។ លោក ទេសរដ្ឋមន្ត្រី បាន លើកឡើង ថា មន្ត្រី របស់ គណបក្ស ប្រជាជន កម្ពុជា តែងតែ នៅ ជាប់ ជាមួយ ប្រជាពលរដ្ឋ ជានិច្ច ជាពិសេស រាល់ ពេល ពលរដ្ឋ មាន ទុក្ខលំបាក ។ ជាមួយគ្នា នោះ លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ព្រះវិហារ ទាំងអស់ ដែល បាន រួមគ្នា ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ឱ្យ ទទួលបាន នូវ ភាពជោគជ័យ ។
លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន អំពាវនាវ ប្រជាពលរដ្ឋ បន្ត ចូលរួម ប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការរាត ត្បាត ជំងឺ កូវីដ១៩ ដោយ នាំគ្នា ទៅ ទទួលយក វ៉ាក់សាំង តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៕ លោក ផេង គីម ស្រ៊ុន ជំរុញ សមាគម ថ្នាល យុវជន កម្ពុជា កៀរ គរ យុវជន គាំទ្រ បក្ស ប្រជាជន កម្ពុជា
( ភ្នំពេញ ) ៖ លោក ផេង គីម ស្រ៊ុន ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន កិត្តិយស សមាគម ថ្នាល យុវជន កម្ពុជា ( ស.យ .ក ) ឱ្យ ប្រឹងប្រែង កសាង កម្លាំង ឱ្យ កាន់តែ ធំ ដើម្បី ចូលរួម ធ្វើ សកម្មភាព បម្រើ សង្គម ។ ក្នុង នោះ ត្រូវ ប្រឹងប្រែង កៀរគរ កម្លាំង យុវជន ឱ្យ បាន កាន់តែ ច្រើន ជា កម្លាំង គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក ផេង គីម ស្រ៊ុន បាន ថ្លែង បែប នេះ ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធិផល ការងារ ឆ្នាំ ២០២២ និង ដាក់ ទិសដៅ សម្រាប់ ឆ្នាំ ២០២៣ របស់ សមាគម ថ្នាល យុវជន កម្ពុជា នៅ វិមាន ៧មករា ទីស្នាក់ការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា នា ព្រឹក ថ្ងៃសៅរ៍ ទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ។ កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពី ក្រុមប្រឹក្សាភិបាល ទីប្រឹក្សា និង សមាជិក សមាជិកា សមាគម គ្រប់ ជាន់ ថ្នាក់ មកពី តាម បណ្តា រាជធានី - ខេត្ត ក្រុង - ស្រុក នៅ ទូទាំង ប្រទេស កម្ពុជា ។
នៅក្នុង កិច្ចប្រជុំ នេះ ប្រធាន សមាគម បាន ឡើង បង្ហាញ នូវ សមិទ្ធផល ការងារ និង សកម្មភាព មួយចំនួន ដែល សមាគម បាន ធ្វើជា ការរួមចំណែក ក្នុង ការកសាង សង្គម និង លើក បង្ហាញ នូវ ផែនការ មួយចំនួន ទៀត ដើម្បី កសាង កម្លាំង និង សកម្មភាព របស់ សមាគម ឱ្យ កាន់តែ សកម្ម ថែម ទៀត នៅក្នុង សង្គម ។
ក្នុង នាម ជា ប្រធាន កិត្តិយស របស់ សមាគម លោក ផេង គីម ស្រ៊ុន បាន បង្ហាញ ការរីករាយ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សកម្មភាព របស់ សមាគម ថ្នាល យុវជន កម្ពុជា ។ លោក បាន គូសបញ្ជាក់ ថា បើ ទោះបី សមាគម ទើបនឹង បង្កើត តែ បាន ធ្វើ សកម្មភាព យ៉ាង សកម្ម នៅក្នុង សង្គម ហើយ បង្កើត បាន រចនាសម្ព័ន្ធ នៅ គ្រប់ រាជធានី - ខេត្ត និង ក្រុង - ស្រុក ។ ជាពិសេស បាន កៀរគរ កម្លាំង យុវជន បាន កាន់តែ ចូលរួម ដើម្បី ចូលរួម ធ្វើ សកម្មភាព ជាមួយ សមាគម ។
ជំនួយការ របស់ សម្តេច តេជោ ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក៏ បាន ថ្លែងអំណរគុណ ដល់ សមាគម ដែល បាន ដាក់ចេញ នូវ ផែនការ សកម្មភាព និង ជំហរ យ៉ាង ច្បាស់លាស់ គាំទ្រ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន និង គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ដឹកនាំ ប្រទេស ។ ជាពិសេស បាន ប្តេជ្ញា គាំទ្រ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី នា ពេល អនាគត ។
ក្នុង កិច្ចប្រជុំ នេះ លោក ផេង គីម ស្រ៊ុន ក៏ បាន ជំរុញ ឱ្យ សមាគម ប្រឹងប្រែង កៀរគរ សមាជិក ឱ្យ បាន កាន់តែ ច្រើន ថែម ទៀត ដើម្បី ធ្វើ សកម្មភាព ឱ្យ បាន កាន់តែ ខ្លាំងក្លា ។
លោក គីម ស្រ៊ុន ក៏ បាន ណែនាំ ឱ្យ សមាគម ប្រឹងប្រែង ធ្វើ សកម្មភាព ពន្យល់ ដល់ យុវជន អំពី គោល នយោបាយ ដឹកនាំ និង សមិទ្ធផល ទាំងឡាយ របស់ ជាតិ កើត ចេញពី ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។ សម្រាប់ លោក គីម ស្រ៊ុន ការពន្យល់ ឱ្យ យុវជន បាន ជ្រូត ជ្រាប ពី គោល នយោបាយ និង ការដឹកនាំ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នឹង នាំឱ្យ មាន ការគាំទ្រ មួយ ដ៏ ច្បាស់លាស់ និង រឹងមាំ ៕
ក្រសួង សុខាភិបាល ប្រកាស ជូនដំណឹង ជាថ្មី ពី ការប្រឡង ចូល ក្របខណ្ឌ សុខាភិបាល ឆ្នាំ ២០២២
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល បាន ប្រកាស សេចក្តីជូនដំណឹង ជាថ្មី ដើម្បី បញ្ជាក់ បន្ថែម ទាក់ទង កាលបរិច្ឆេទ មណ្ឌល ប្រឡង និង នាម ត្រកូល បេក្ខជន ដែល ពេញ សិទ្ធ សម្រាប់ ចូលរួម ប្រឡង ប្រជែង ជ្រើសរើស ក្របខណ្ឌ សុខាភិបាល ឆ្នាំ ២០២២ ។
មណ្ឌល ប្រឡង ប្រជែង ចំនួន ០៤ ត្រូវបាន បង្ហាញ ដូច ខាងក្រោម៖ អភិបាល ខណ្ឌ ៧មករា ចុះ សួរសុខទុក្ខ និង នាំ អំណោយ ប្រគល់ ជូន អភិបាល រង ខណ្ឌ ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ
( ភ្នំពេញ ) ៖ លោក ថេង សុថុល អភិបាល ខណ្ឌ ៧ មករា រាជធានី ភ្នំពេញ រួម ជាមួយ ក្រុមការងារ នៅ ព្រឹក ថ្ងៃទី ៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ សួរសុខទុក្ខ លោក ណុប ផា អភិបាល រង ខណ្ឌ ៧ មករា ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ ។
ជាមួយគ្នា នោះ លោក អភិបាល ខណ្ឌ បាន លើកទឹកចិត្ត ដល់ លោក ណុប ផា និង ភរិយា ឱ្យ ខិតខំ យកចិត្តទុកដាក់ មើល ថែរក្សា សុខភាព ឱ្យ បាន ល្អ និង គោរព ទៅ តាម ការណែនាំ របស់ គ្រូពេទ្យ ។
លោក ថេង សុថុល ព្រមទាំង ក្រុមការងារ ខណ្ឌ បាន ជូន ពរ ឱ្យ លោក អភិបាល រង ឆាប់ ជាសះស្បើយ ពី ជំងឺ និង បាន ឧបត្ថម្ភ នូវ ថវិកា ចំនួន ២.០០០.០០០ រៀល សម្រាប់ ដោះស្រាយ ការព្យាបាល ជំងឺ ផងដែរ ៕
កងទ័ព អាកាស កូរ៉េ ខាងត្បូង បាន ប្រាប់ ឱ្យដឹង ថា យន្តហោះ ទម្លាក់ គ្រាប់បែក អាមេរិក B-1B ចំនួន១ គ្រឿង នឹង ចូលរួម ហ្វឹកហាត់ ក្នុង សមយុទ្ធ យោធា វីជី លែន ស្តូម (Vigilant Storm) ។ សមយុទ្ធ នេះ បាន ចាប់ផ្តើម ឡើង កាលពី ថ្ងៃចន្ទ ហើយ ត្រូវបាន គ្រោង បញ្ចប់ ទៅ វិញ នៅ ត្រឹម ថ្ងៃសុក្រ ប៉ុន្តែ ត្រូវបាន អូសបន្លាយ បន្ថែម ១ ថ្ងៃ គឺ មកដល់ ថ្ងៃសៅរ៍ នេះ ដើម្បី ជា ការឆ្លើយតប ចំពោះ សកម្មភាព បាញ់ សាកល្បង មី ស៉ីល បន្តបន្ទាប់ ដោយ កូរ៉េ ខាងជើង កាលពី ប៉ុន្មាន ថ្ងៃ កន្លងទៅ ។
ថ្នាក់ដឹកនាំ យុវជន និង កងកម្លាំង ទាំង៣ ប្រភេទ ក្នុង ខេត្ត កំពង់ស្ពឺ ជាង ៥០០ នាក់ សម្អាត បរិស្ថាន នៅ តាម ទី សាធារណៈ មុន ពិធី ប្រណាំង ទូក «ង » ចូលមកដល់
ការ អនាម័យ សម្អាត បរិស្ថាន នេះ ធ្វើឡើង នៅ តាម ដងផ្លូវ សំខាន់ ៗ ទីធ្លា សាធារណៈ សួនច្បារ កន្លែង ប្រារព្ធ ពិធិ ដែល ប្រព្រឹត្តទៅ នៅ ព្រឹក ថ្ងៃទី ៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្រោម ការដឹកនាំ ដោយ ផ្ទាល់ ពី លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ ។
