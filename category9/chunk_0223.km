( ភ្នំពេញ ) ៖ លោក គង់ វិបុល រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន ថ្លែង ថា ការកែតម្រូវ លិខិត ប្រកាស ពន្ធ ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ តាម ប្រព័ន្ធ អនឡាញ នឹង ជួយ សម្រួល កាន់តែ ច្រើន ដល់ សហគ្រាស ជាប់ ពន្ធ ។
លោក បន្ត ថា សហគ្រាស ងាយស្រួល ក្នុង ការគណនា ដោយ ស្វ័យប្រវត្តិ នូវ ទឹកប្រាក់ លម្អៀង ត្រូវ បង់ ឬ យោង ជា ឥណទាន និង មាន រក្សាទុក នៅ ប្រវត្តិ នៃ ការស្នើសុំ កែតម្រូវ ហើយ អ្នក ជាប់ ពន្ធ អាច តាមដាន ស្ថានភាព នៃ ការស្នើសុំ និង មិន ចាំបាច់ មក អគ្គ នាយកដ្ឋាន ពន្ធដារ ដើម្បី តាមដាន នោះ ទេ ។
ការលើកឡើង របស់ លោក អគ្គ នាយក ធ្វើឡើង ក្នុង កិច្ចប្រជុំ ពិនិត្យ ពិភាក្សា និង ផ្តល់ ធាតុ ចូល លើ សេចក្តីព្រាង នីតិវិធី និង រំហូរ ការងារ នៃ ការកែតម្រូវ លិខិត ប្រកាស ពន្ធ ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ ដែល រៀបចំឡើង នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
កិច្ចប្រជុំ នេះ រៀបចំឡើង ក្នុង គោលបំណង ដើម្បី ពិនិត្យ ពិភាក្សា និង ផ្តល់ ធាតុ ចូល លើ សេចក្តីព្រាង នៃ ការកែតម្រូវ លិខិត ប្រកាស ពន្ធ ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ ដែល នឹង ដាក់ ឱ្យ អនុវត្ត សម្រាប់ អង្គភាព គ្រប់គ្រង អ្នក ជាប់ ពន្ធ ក្នុង ការអនុវត្ត លើ ការងារ កែតម្រូវ លិខិត ប្រកាស នេះ ប្រកបដោយ ប្រសិទ្ធភាព អាច គ្រប់គ្រង បាន និង ធានា បាន នូវ ការ ប្រមូល ចំណូល ពន្ធ ប្រកបដោយ ចីរភាព ។
គួរ បញ្ជាក់ ផងដែរ ថា ការអនុវត្ត ការងារ កែតម្រូវ លិខិត ប្រកាស ពន្ធ ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ បច្ចុប្បន្ន ធ្វើឡើង តាមរយៈ ការស្នើសុំ ដោយ ផ្ទាល់ នៅ រដ្ឋបាល សារពើពន្ធ និង ត្រូវ បំពេញ ទម្រង់ លិខិត ប្រកាស ពន្ធ ថ្មី ជំនួស ឱ្យ លិខិត ប្រកាស ពន្ធ ចាស់ ដែល ខុស ។ ការអនុវត្ត ការងារ បច្ចុប្បន្ន ធ្វើឱ្យ ការកែតម្រូវ លិខិត ប្រកាស ពន្ធ នៅ មិន ទាន់ គ្រប់គ្រង បាន ល្អ ដែល បង្ក ជា ហានិភ័យ ដល់ ការបាត់បង់ ប្រាក់ ពន្ធ - អាករ ផ្សេង ៗ និង ការកាត់ កង ឥណទាន អាករ លើ តម្លៃ បន្ថែម ។
លើស ពី នេះ ការអនុវត្ត តាម រំហូរ ការងារ កែតម្រូវ លិខិត ប្រកាស ពន្ធ បច្ចុប្បន្ន ផ្តល់ ផលលំបាក ដល់ អ្នក ជាប់ ពន្ធ ក្នុង ការរៀបចំ ឯកសារ ស្នើសុំ និង តាមដាន ការឆ្លើយតប ពី រដ្ឋបាល សារពើពន្ធ ។ ម្យ៉ាងទៀត សម្រាប់ មន្រ្តី ពន្ធដារ ក៏ មាន ផលលំបាក ផងដែរ ក្នុង ការគ្រប់គ្រង និង តាមដាន ការកែតម្រូវ លិខិត ប្រកាស របស់ សហគ្រាស ។
ដោយឡែក សម្រាប់ រំហូរ ការងារ ថ្មី នេះ អនុញ្ញាតឱ្យ អ្នក ជាប់ ពន្ធ អាច ស្នើសុំ ធ្វើ ការកែតម្រូវ លិខិត ប្រកាស ពន្ធ ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ តាម ប្រព័ន្ធ អនឡាញ ដោយ មិន ចាំបាច់ បំពេញ សំណើ សុំ និង ភ្ជាប់ ឯកសារ ពាក់ព័ន្ធ នៅ រដ្ឋបាល សារពើពន្ធ នោះ ឡើយ ដោយ គ្រាន់តែ បំពេញ ទិន្នន័យ នៅក្នុង ប្រព័ន្ធ និង តាមដាន ស្ថានភាព សំណើ សុំ នៅក្នុង ប្រព័ន្ធ អនឡាញ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ។
លោក រដ្ឋមន្ត្រី ប្រតិភូ បាន ស្នើ ឱ្យ មាន កិច្ចពិភាក្សា ស៊ីជម្រៅ ដើម្បី ពិនិត្យ ឱ្យ បាន ល្អិតល្អន់ និង ផ្តល់ ធាតុ ចូល ឱ្យ បាន គ្រប់ ជ្រុងជ្រោយ លើ នីតិវិធី រំហូរ ការងារ នៃ ការកែតម្រូវ លិខិត ប្រកាស ពន្ធ ប្រចាំ ខែ ប្រចាំ ឆ្នាំ ឱ្យ ក្នុង ន័យ ជំរុញ ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង ការងារ ចាត់ចែង លិខិត ប្រកាស ពន្ធ របស់ សហគ្រាស និង ជួយ សម្រួល ដល់ អ្នក ជាប់ ពន្ធ ក្នុង ការបំពេញ កាតព្វកិច្ច សារពើពន្ធ របស់ សហគ្រាស ផងដែរ ។
ក្នុង ឱកាស នោះ ដែរ លោក រដ្ឋមន្ត្រី គង់ វិបុល បាន បញ្ជាក់ ថា តាម ការរំពឹងទុក ថា ចំណូល ពន្ធ សម្រាប់ ឆ្នាំ ២០២២ អាចនឹង សម្រេចបាន ក្នុង រង្វង់ ១១៥ % ឬ លើស ពី នេះ ធៀប នឹង ផែនការ ច្បាប់ ស្តីពី ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០២២ ។
ក្នុង នាម ជា ថ្នាក់ដឹកនាំ អគ្គ នាយកដ្ឋាន ពន្ធដារ លោក នៅតែ បន្ត ប្តេជ្ញា យ៉ាង មុតមាំ ខិតខំ ប្រឹងប្រែង អស់ ពី កម្លាំង កាយ ចិត្ត ធ្វើ យ៉ាងណា ធានា នូវ ប្រសិទ្ធភាព បន្ថែម ទៀត ក្នុង ការអនុវត្ត ការងារ គ្រប់គ្រង ប្រមូល ចំណូល ពន្ធ សម្រាប់ ឆ្នាំ ២០២២ សម្រាប់ ជា គុណ ប្រយោជន៍ នៃ ថវិកា ជាតិ និង ដើម្បី ជា មូលដ្ឋាន សម្រាប់ អនុវត្ត ឆ្នាំ ២០២៣ ។
លោក បាន លើកឡើង ថា ការគ្រប់គ្រង ការកែតម្រូវ លិខិត ប្រកាស ពន្ធ មិន បាន ល្អ នឹង ក្លាយជា ហានិភ័យ ដល់ ការបាត់បង់ ប្រាក់ ពន្ធ ការកាត់ កង ឥណទាន អាករ លើ តម្លៃ បន្ថែម ។ ដូច្នេះ តាមរយៈ យន្តការ Cross Check អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន រកឃើញ និង បាន ចាត់ វិធានការ ពន្ធដារ ជា បន្តបន្ទាប់ ចំពោះ សហគ្រាស មួយចំនួន ដែល បាន កាត់ កង ឥណទាន អាករ លើ តម្លៃ បន្ថែម មិន បាន ត្រឹមត្រូវ ។
លោក លើកឡើង ថា E-Tax Service បាន ផ្តល់ សេវា គាំទ្រ និង ជួយ ដោះស្រាយ រាល់ បញ្ហា ប្រឈម ក្នុង ការប្រើប្រាស់ ប្រព័ន្ធ និង កម្មវិធី នានា តាម ប្រព័ន្ធ អនឡាញ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ៕ អភិបាល ខេត្ត បាត់ដំបង ចាត់ ក្រុមការងារ យក អំណោយ របស់ កាកបាទ ក្រហម ប្រគល់ ជូន ស្ដ្រី ម្នាក់ ដែល មាន ជំងឹមហារីក សុដន់ នៅ ក្រុង បាត់ដំបង
ក្នុង ឱកាស នោះ លោក សួស សុភ័ក្រ បាន នាំ នូវ ការផ្ដាំផ្ញើ សាកសួរ ទុក្ខ របស់ លោក សុខ លូ ប្រធាន គណ:កម្មាធិការ សាខា ខេត្ត ជាពិសេស សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ ក្តីអាណិតអាសូរ និង ការគិតគូរ ពី ជីវភាព រស់ នៅ របស់ លោកស្រី ហេង សុគន្ធា ។
លោក បាន បញ្ជាក់ ថា លោក សុខ លូ បន្ទាប់ពី បាន ឃើញ ព័ត៌មាន អំពី ករណី ដ៏ លំបាក របស់ លោកស្រី បេង សុគន្ធា លោក បាន សម្តែង នូវ ក្តី អាណិតអាសូរ ហើយ បាន ចាត់ ឲ្យ ក្រុមការងារ ចុះ ភ្លាម ៗ ដើម្បី ពិនិត្យ ពី ស្ថានភាព រស់ នៅ ជាក់ស្តែង និង នាំយក អំណោយ ជួយ សម្រាល ការលំបាក ក្នុង ការរស់ នៅ ។
បន្ទាប់ពី ទទួលបាន ការឧបត្ថម្ភ ខាង លើ នេះ លោកស្រី បេង សុគន្ធា បាន សម្តែង នូវ ក្តីរំភើប និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង ដែល មាន លោក សុខ លូ ប្រធាន គណ:កម្មាធិការ សាខា ដែល បាន គិតគូរ ពី ជីវភាព រស់ នៅ រួម ជាមួយ អំណោយ មនុស្សធម៌ ។
ក្រសួង សេដ្ឋកិច្ច បើក សិក្ខាសាលា ពិគ្រោះយោបល់ លើ សេចក្តីព្រាង យុទ្ធសាស្រ្ត ស្តីពី ការកែទម្រង់ ការគ្រប់គ្រង សហគ្រាស សាធារណៈ
( សៀមរាប ) ៖ លោក បណ្ឌិត អៀង ស៊ុន លី រដ្ឋលេខាធិការ និង ជា ប្រធាន ក្រុមការងារ កែទម្រង់ ការគ្រប់គ្រង សហគ្រាស សាធារណៈ បាន រៀបចំ សិក្ខាសាលា ពិគ្រោះយោបល់ លើ សេចក្តី - ព្រាង យុទ្ធសាស្រ្ត ស្តីពី ការកែទម្រង់ ការគ្រប់គ្រង សហគ្រាស សាធារណៈ ក្រោម កម្មវិធី កំណែទម្រង់ ហិរញ្ញវត្ថុ សាធារណៈ (PFM) នា ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
លោក បាន បន្ត ថា ការកែទម្រង់ សហគ្រាស សាធារណៈ សំដៅ ធានា បាន នូវ កិច្ច ដំណើរការ នៃ ការប្រព្រឹត្តទៅ របស់ សហគ្រា សសាធារណៈ ប្រកបដោយ និរន្តរភាព . សម្រេចបាន គោលដៅ អាជីវកម្ម និង ទទួលបាន ប្រាក់ ចំណេញ នៅក្នុង ទីផ្សារ ប្រកបដោយ ការប្រកួតប្រជែង ព្រមទាំង ការអនុវត្ត គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល សម្រាប់ ផ្តល់ ប្រយោជន៍ និង បម្រើ សេចក្តីត្រូវ ការចាំបាច់ ប្រចាំ ថ្ងៃ ចំពោះ សាធារណជន ។
លោក អៀង ស៊ុន លី បាន បន្ថែម ថា សហគ្រាស សាធារណៈ គឺជា សហគ្រាស ដែល មាន ដើមទុន ទាំងអស់ ឬ ភាគ ច្រើន ជា របស់ រដ្ឋ មាន តួនាទី ចូលរួមចំណែក គាំទ្រ គោល នយោបាយ ជា យុទ្ធសាស្រ្ត របស់ រាជ រដ្ឋាភិបាល និង ចូលរួម ជំរុញ ការ អភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច ។ ការរៀបចំ ឯកសារ យុទ្ធសាស្រ្ត នេះ ផ្អែក លើ បទពិសោធន៍ និង បញ្ហា ប្រឈម ប្រមាណ ២៦ ឆ្នាំ និង ស្រប ទៅតាម ការវិវិឌ្ឍ ទៅ នៃ ការរីកចម្រើន របស់ កម្ពុជា ព្រមទាំង ឧត្តមានុវត្តន៍ ជា អន្តរជាតិ លើ ការគ្រប់គ្រង សហគ្រាស សាធារណៈ ។
( ភ្នំពេញ ) ៖ រដ្ឋបាល ខណ្ឌ ចំការមន បាន អំពាវនាវ ដល់ តំណាង មន្ទីរ អង្គការ សប្បុរសជន និង ដៃគូ អភិវឌ្ឍន៍ ទាំងអស់ បន្ត ជួយ គាំទ្រ ដល់ គម្រោង កម្មវិធី វិនិយោគ ៣ឆ្នាំ រំកិល របស់ ខណ្ឌ - សង្កាត់ ដើម្បី ឆ្លើយតប នឹង តម្រូវការ របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ការចូលរួម អនុវត្ត គោល នយោបាយ វិមជ្ឈការ វិសហមជ្ឈការ និង ការអភិវឌ្ឍ តាម បែប ប្រជាធិបតេយ្យ នៅ ថ្នាក់ ក្រោម ជាតិ ឲ្យ កាន់តែ ប្រសើរឡើង ។
ការអំពាវនាវ របស់ លោក ហ៊ត វ៉ាន់ធី អភិបាល រង ក្នុង នាម តំណាង លោក កៀង ល័ក្ស អភិបាល ខណ្ឌ ចំការមន ធ្វើឡើង ក្នុង សិក្ខាសាលា សមាហរណកម្ម វិនិយោគ ៣ឆ្នាំ រំកិល ( ២០២៣ - ២០២៥ ) របស់ រដ្ឋបាល សង្កាត់ និង ខណ្ឌ នា រសៀល ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ក្រោម អធិបតីភាព លោក សាំង សុផាត អនុប្រធាន មន្ទីរ ផែនការ រាជធានី តំណាង ឲ្យ សាលា រាជធានី ភ្នំពេញ និង មាន ការចូលរួម ពី មន្ដ្រី ពាក់ព័ន្ធ និង អង្គការ ដៃគូ ផងដែរ ។
ជាមួយគ្នា នេះ លោក សាំង សុផាត បាន បង្ហាញ ការចាប់អារម្មណ៍ និង វាយតម្លៃ ខ្ពស់ ពី សិក្ខាសាលា មួយ នេះ ដោយ លើកឡើង ថា និង ជួយ តម្រង់ ទិស រាល់ សកម្មភាព របស់ រដ្ឋបាល ខណ្ឌ ចំការមន ឲ្យ ដំណើរ ស្រប ទៅតាម គោល នយោបាយ អភិវឌ្ឍន៍ របស់ ជាតិ ។
សូម ជម្រាប ថា គម្រោង ដែល មាន ការគាំទ្រ ពី មន្ទីរ - អង្គភាព ជំនាញ ជុំវិញ រដ្ឋបាល រាជធានី ភ្នំពេញ និង អង្គការ នានា សម្រាប់ អនុវត្ត ឆ្នាំ ២០២៣ រួម មាន៖ ទី ១៖ គម្រោង របស់ រដ្ឋបាល ខណ្ឌ ដែល មាន ការគាំទ្រ ចំនួន ១២៤ គម្រោង និង ទី២៖ គម្រោង សកម្មភាព អាទិភាព របស់ សង្កាត់ ទាំង ០៥ មាន ការគាំទ្រ ចំនួន ១៩៥ គម្រោង ៕ លោក ឃួង ស្រេង ចាត់ទុក ជំនួយ របស់ កូរ៉េ ដល់ មន្ទីរពេទ្យ បង្អែក ដង្កោ ជា ជំនួយ ដែល រាជធានី ភ្នំពេញ ចង់បាន បំផុត
លោក ឃួង ស្រេង បាន បញ្ជាក់ ថា ជំនួយ នេះ ដើម្បី លើកកម្ពស់ សុខ មាលភាព ប្រជាពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ ក៏ ដូច ប្រជាពលរដ្ឋ មកពី តាម បណ្តា ខេត្ត នានា មក រក សេវា សុខាភិបាល នៅ រាជធានី ភ្នំពេញ មាន ការកើនឡើង ស្រប តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
លោក អភិបាល រាជធានី បាន បង្ហាញ ពី ការគាំទ្រ ពេញ ទំហឹង នឹង ផ្តល់ កិច្ចសហការ ដល់ ដំណើរការ គម្រោង កែលំអរ មន្ទីរពេទ្យ បង្អែក ជើងឯក នេះ ទៅ តាម ស្តង់ដារ បច្ចេកទេស និង គាំទ្រ ទៅ លើ ការសាងសង់ អាគារ មន្ទីរពេទ្យ ថ្មី និង គាំទ្រ ឲ្យ មាន ការសាងសង់ កម្ពស់ លើស ពី ៤ជាន់ ទៅ តាម តម្រូវការ ជាក់ស្តែង និង ត្រៀមលក្ខណៈ សិក្សា ទៅ លើ ការឈាន ទៅ ដាក់ មន្ទីរពេទ្យ នេះ ដល់ កម្រិត ទី៣ ។
លោក Ro Hyun Jun បាន ឲ្យដឹង ទៀត ថា គម្រោង នេះ គ្រោង នឹង ចំណាយ ថវិកា ចំនួន ១១លាន ដុល្លារ ។ ភាគី KOICA បាន ចាប់ អារម្មណ៍ លើ ភាពទាក់ទាញ សម្រាប់ អ្នកជំងឺ មិន ចង់ឲ្យ ពួកគាត់ ទៅ ហួស មក ហួស ឬ ទៅ រក តែ មន្ទីរពេទ្យ ធំ ៗ នៅ កណ្តាល ក្រុង ។ ដូច្នេះ ការបំពាក់ បរិក្ខា ពេទ្យ ការរៀបចំ ហេដ្ឋារចនាសម្ព័ន្ធ រួម នឹង ក្រុម គ្រូពេទ្យ ជំនាញ គឺជា រឿង ចាំបាច់ ៕ រដ្ឋបាល រាជធានី ភ្នំពេញ បើក កិច្ចប្រជុំ ត្រៀម រៀបចំ កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន
តាម ការបញ្ជាក់ របស់ លេខាធិការដ្ឋាន នៃ កិច្ចប្រជុំ ខាងលើ នេះ មាន តំណាង ទីក្រុង និង ខេត្ត ចូលរួម ប្រមាណ ៨០ ទីក្រុង ក្នុង តំបន់ អាស៊ាន និង ក្រៅ អាស៊ាន មាន ជាង ៣០ ទីក្រុង ធំ ៗ ចូលរួម ។
លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង ជា ប្រធាន គណៈកម្មការ រៀបចំ កិច្ចប្រជុំ បាន គូសបញ្ជាក់ ថា កិច្ចប្រជុំ នេះ យើង រៀបចំ ក្នុង កម្រិត តូច ជាង កិច្ចប្រជុំ អន្តរសភា អាស៊ាន (AIPA) តែ យក ទម្រង់ ដូច កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន ដែល ទើប បញ្ចប់ ទៅ ថ្មី ៗ នេះ នៅ ខេត្ត សៀមរាប ។
លោក បញ្ជាក់ ថា ទោះបី យ៉ាងណា ការពង្រឹង សន្តិសុខ សណ្តាប់ធ្នាប់ របៀបរៀបរយ សាធារណៈ គឺ នៅ ដដែល ដូច កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ ក៏ ដូច កិច្ចប្រជុំ កំពូល ពាក់ពន្ធ័ ដែរ ព្រោះ យើង មាន បទពិសោធន៍ ធ្វើ បាន ល្អ រួច មកហើយ ។ វេទិកា អភិបាល ក្រុង អាស៊ាន ឆ្នាំ ២០២២ នេះ មាន គោលបំណង ពង្រឹង កិច្ចសហការ តាមរយៈ ការជំរុញ ការកសាង ទីក្រុង វៃ ឆ្លាត មាន ភាពធន់ និង មាន ចីរភាព ប្រកបដោយ បវិវត្តកម្ម និង បរិយាប័ន្ន តាម គន្លង ប្រក្រតី ភាព ថ្មី តាម គោលការណ៍ អាស៊ាន រួមគ្នា ធ្វើ ការដោះស្រាយ បញ្ហា ប្រឈម ទាំងអស់ គ្នា ។
ចំពោះ កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន (MGMAC 2022) ផ្តោត លើ ការជំរុញ កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ ដើម្បី ទីក្រុង ឆ្លាត មាន ភាពធន់ និង មាន ចីរភាព ។ វេទិកា នេះ គឺ សម្រាប់ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន ទាំង១០ លើកឡើង និង ពិភាក្សា អំពី បញ្ហា ប្រឈម ក្នុង ទីក្រុង នា ពេល បច្ចុប្បន្ន និង អាច កើត មាន ឡើង ព្រមទាំង ចែករំលែក ការអនុវត្តន៍ ល្អ ៗ ក៏ ដូចជា ទស្សនៈ របស់ ពួកគាត់ សម្រាប់ ការកសាង សហគមន៍ អាស៊ាន ៕
គ.ជ. ប បង្ហាញ វីដេអូ កិច្ចសម្ភាស ក្រោម ប្រធានបទ « ការប្រើប្រាស់ បច្ចេកវិទ្យា ព័ត៌មានវិទ្យា ក្នុង ការងារ គ្រប់គ្រង និង ការងារ បច្ចេកទេស បោះឆ្នោត »
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន ផ្សព្វផ្សាយ នូវ វីដេអូ មួយ នៃ កិច្ចសម្ភាស តាម ប្រព័ន្ធ អនឡាញ ក្រោម ប្រធានបទ « ការប្រើប្រាស់ បច្ចេកវិទ្យា ព័ត៌មានវិទ្យា ក្នុង ការងារ គ្រប់គ្រង និង ការងារ បច្ចេកទេស បោះឆ្នោត » ដោយ មាន ការចូលរួម ពី លោក តុ ប ឫទ្ធី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន សេវាកម្ម ច្បាប់ និង បច្ចេកទេស ។
ទោះជា យ៉ាងណា ក្នុង របាយការណ៍ ថ្ងៃសុក្រ នេះ វៀតណាម ក៏ បាន រកឃើញ ករណី អ្នកស្លាប់ ថ្មី បន្ថែម ទៀត ទេ ។
អង្គការ ណា តូ ប្តេជ្ញា ថា នឹង បន្ត ជួយ អ៊ុយក្រែន ឲ្យបាន យូរ បំផុត តាម ដែល អាច ធ្វើ ទៅ បាន
អតីត នាយក រដ្ឋមន្ត្រី ន័រវេសរូប នេះ បាន និយាយ ថា « ណា តូ នឹង បន្ត ឈរ ជាមួយ អ៊ុយក្រែន ឱ្យ បាន យូរ តាម ដែល អាច ធ្វើ ទៅ បាន ដោយ មិន ថយ ក្រោយ ទេ ។ សម្ព័ន្ធមិត្តកំពុង ផ្តល់ ការគាំទ្រ ផ្នែក យោធា ដែល មិន ធ្លាប់ មាន ពីមុន មក ហើយ ខ្ញុំ រំពឹង ថា រដ្ឋមន្ត្រី ការបរទេស ក៏ នឹង យល់ព្រម បង្កើន ការគាំទ្រ រហូត តទៅទៀត » ។
លោក Stoltenberg បាន និយាយ ថា សមាជិក នៃ អង្គការ សន្តិសុខ ជាតិ ចំនួន ៣០ បាន និង កំពុង ផ្តល់ ប្រេងឥន្ធនៈ ម៉ាស៊ីនភ្លើង ការផ្គត់ផ្គង់ វេជ្ជសាស្រ្ត បរិក្ខារ សម្រាប់ រដូវ រងា និង យន្តហោះ គ្មាន មនុស្ស បើក ប៉ុន្តែ នឹង ត្រូវការ ច្រើន ទៀត នៅពេល រដូវ រងា ចូល មកដល់ ៕ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង និង ផ្ទេរ មុខតំណែង អគ្គ ព្រះរាជអាជ្ញា រង ព្រះរាជអាជ្ញា និង ព្រះរាជអាជ្ញា រង ២៧ រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ចេញ ព្រះរាជ ក្រឹត្យ មួយ តែងតាំង និង ផ្ទេរ មុខតំណែង អគ្គ ព្រះរាជអាជ្ញា រង ព្រះរាជអាជ្ញា និង ព្រះរាជអាជ្ញា រង ២៧ រូប ។ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
ខាងក្រោម នេះ ជា ព្រះរាជ ក្រឹត្យ ព្រះមហាក្ស ត្រ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ផ្ញើ សារ ជូន លោក សួន លន់ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ឧបាសិកា ផន យ៉ុន
( ភ្នំពេញ ) ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ជូន លោក សួន លន់ សមាជិក គណៈកម្មការ អង្កេត បោសសម្អាត និង ប្រឆាំង អំពើពុករលួយ នៃ ព្រឹទ្ធសភា ចំពោះ មរណភាព របស់ ឧបាសិកា ផន យ៉ុន ត្រូវ ជា បង ស្រី បង្កើត របស់ លោក កាលពី ល្ងាច ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ដោយ ជរា ពាធ ៕
ខាងក្រោម នេះ ជា សារលិខិត របស់ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ៖ មន្រ្តី អ្នកស្ម័គ្រចិត្ត និង យុវជន នៃ កាកបាទ ក្រហម កម្ពុជា ផ្ញើ លិខិត អបអរសាទរ និង គោរព ជូនពរ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី ក្នុង ឱកាស ទទួលបាន ប័ណ្ណ សរសើរ និង ពានរង្វាន់ កិត្តិយស ឥស្សរជន ឆ្នើម របស់ អន្តរសភា អាស៊ាន
ក្នុង ឱកាស ដ៏ ប្រសើរ ថ្លៃថ្លា នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម បួងសួង ដល់ តេជះ បារមី នៃ វត្ថុ ស័ក្ដិសិទ្ធិ ទាំងអស់ ក្នុង លោក ទេវតា ថែរក្សា ទឹកដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា សូម អភិបាល ប្រោះ ព្រំ ប្រសិទ្ធ ពរជ័យ គ្រប់ ប្រការ ជូន លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ព្រមទាំង ក្រុមគ្រួសារ សូម បាន សម ប្រកបដោយ ព្រះពុទ្ធ ពរ ទាំង៤ ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ស្វែងរក វិជ្ជា កិត្តិយស មាន សេព គ្រឿងញៀន នាំមហន្ដរាយ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៥ ខែវិច្ឆិកា៖ បង្ក្រាប ១២ករណី ឃាត់ខ្លួន ៣១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ២ករណី . ដឹកជញ្ជូន រក្សាទុក ២ករណី . ជួញដូរ ៨ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ៣១ នាក់ ។
ពិធី នេះ មាន ការអញ្ជើញ ចូលរួម ពី លោក លោកស្រី អភិបាល រង នៃ គណៈអភិបាល ខេត្ត នាយក នាយ រង រដ្ឋបាល សាលា ខេត្ត ប្រធាន មន្ទីរ ពាក់ព័ន្ធ អភិបាល អភិបាល រង ស្រុក អាជ្ញាធរ មូលដ្ឋាន ព្រមទាំង ថ្នាក់ដឹកនាំ និង បុគ្គលិក ក្រុមហ៊ុន អ អឹម អេ ខេមបូឌា យ៉ាង ច្រើន កុះករ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ខូយ រីដា បាន លើកឡើង អំពី សារសំខាន់ និង តម្លៃ សន្តិភាព សម្រាប់ ជីវភាព រស់ នៅ របស់ ប្រជាជន និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព នៃ កម្ពុជា និង បាន ស្នើ ឱ្យ គ្រប់ គ្នា ត្រូវ រួមគ្នា ថែរក្សា ឱ្យ បាន នូវ សុខ សន្តិភាព ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត និង ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល មជ្ឈដ្ឋាន ជាតិ និង អន្តរជាតិ តែងតែ បាន សាទ រ និង កោតសរសើរ ខ្ពស់ មក លើ ការដឹកនាំ របស់ សម្តេច « មាន សន្តិភាព ទើប មាន ការអភិវឌ្ឍ » ។
លោក បាន សម្តែង ការយកចិត្តទុកដាក់ លើ ជីវភាព របស់ កម្មករ និយោជិក គឺជា គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល ជា មហា វីរៈ បុរស ខ្មែរ និង ជា ស្ថាបនិក សន្តិភាព នៃ ប្រទេស កម្ពុជា ។
ជាក់ស្តែង វត្តមាន របស់ ក្រុមហ៊ុន អ អឹម អេ ខេមបូឌា នៅក្នុង ទឹកដី ស្រុក ក្រគរ នៃ ខេត្ត ពោធិ៍សាត់ គឺជា ផ្នែក មួយ ដ៏ សំខាន់ ក្នុង ការផ្ដល់ ឱកាស ការងារ ជាច្រើន ជូន ប្រជាពលរដ្ឋ ទទួល ឱ្យ បាន ប្រាក់ ចំណូល ដើម្បី លើកកម្ពស់ ជីវភាព គ្រួសារ ព្រមទាំង លើកកម្ពស់ វិស័យ សេដ្ឋកិច្ច របស់ ប្រទេស កម្ពុជា យើង ឱ្យ មាន ការីកចម្រើន សំបូរ រុងរឿង និង ជាពិសេស គឺ ជួយ លើកកម្ពស់ សេដ្ឋកិច្ច របស់ បងប្អូន ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស និយាយ ជា រួម និង និយាយ ដោយឡែក ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ពោធិ៍សាត់ យើង ផ្ទាល់ តែម្ដង ។
បណ្ឌិត ច្បាប់ ទាំង ៤រូប រួម មាន៖ ទី ១៖ លោក អេន សុភាព មេធាវី រាជ រដ្ឋាភិបាល ទី ២៖ លោក បួន សុមុនី អគ្គ លេខាធិការ រង ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ទី ៣៖ លោក ជុន ថា វៀត ប្រធាន នាយកដ្ឋាន រដ្ឋបាល និង ហិរញ្ញវត្ថុ នៃ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿង ញឿន ទី៤៖ លោក ឆាយ ហុង ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង នៃ រាជធានី ភ្នំពេញ
