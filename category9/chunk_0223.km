( សិង្ហបុរី ) ៖ សិង្ហបុរី បាន រាយការណ៍ ពី ករណី ឆ្លង កូវីដ ១៩ ថ្មី ចំនួន ១.៦៦៦ ក្នុង របាយការណ៍ ថ្ងៃសៅរ៍ នេះ ដែល នាំឱ្យ ចំនួន អ្នក ឆ្លង សរុប កើន ដល់ ២. ១៥២. ៣៦៨ នាក់ ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយសារព័ត៌មាន ស៉ិន ហួ នៅ ថ្ងៃសៅរ៍ ទី១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
ស្ថិតិ ដែល ចេញផ្សាយ ដោយ ក្រសួង សុខាភិបាល សិង្ហបុរី បាន ឱ្យដឹង ថា ក្នុង ចំណោម ករណី ថ្មី ខាងលើ មាន សរុប ចំនួន ១៩៧ ត្រូវបាន បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ ។
( ហាណូយ ) ៖ វៀតណាម បាន កត់ត្រា ករណី ឆ្លង នៃ ជំងឺ កូវីដ១៩ ចំនួន ២៥៩ នាក់ ក្នុង របាយការណ៍ ថ្ងៃសៅរ៍ នេះ ពោលគឺ ធ្លាក់ចុះ ចំនួន ១៧៦ នាក់ កាលពី ថ្ងៃសុក្រ ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ស៊ិន ហួ នៅ ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
ក្រសួង សុខាភិបាល វៀតណាម បាន ឲ្យដឹង ថា ក្នុង ចំណោម ករណី ថ្មី ខាងលើ នេះ គឺ សុទ្ធតែ ជា ករណី ចម្លង ក្នុង ស្រុក ។ ការឆ្លង ថ្មី នេះ បាន ធ្វើឱ្យ ចំនួន សរុប ទូទាំង ប្រទេស កើនឡើង ដល់ ១១. ៥១១. ១៧៨ នាក់ ។
គួរ បញ្ជាក់ ថា អ្នកជំងឺ កូវីដ ១៩ ទូទាំង ប្រទេស វៀតណាម ចំនួន ១០. ៦០៦.៧៤៦ នាក់ ឬ ជាង ៩២ ភាគរយ នៃ អ្នក ឆ្លង សរុប បាន ជាសះស្បើយ ៕ កូន សត្វ ខ្លា ឃុំ តូច មួយ ក្បាល ត្រូវបាន ជួយសង្គ្រោះ និង បញ្ជូន ទៅកាន់ មជ្ឈមណ្ឌល សង្គ្រោះ សត្វ ព្រៃ នៃ ឧទ្យាន សួន សត្វ ព្រៃ ការពារ និង សួន សត្វ ភូត គាម ភ្នំ តាម៉ៅ
( មណ្ឌលគិរី ) ៖ នៅ ល្ងាច ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ កូន សត្វ ខ្លាឃ្ម៉ំ តូច មួយ ក្បាល ដែល ជួយសង្គ្រោះ ដោយ ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត មណ្ឌលគិរី ត្រូវបាន មន្ត្រី នៃ មន្ទីរ បរិស្ថាន ខេត្ត មណ្ឌលគិរី បញ្ជូន មកកាន់ រាជធានី ភ្នំពេញ ដើម្បី ប្រគល់ ជូន ដល់ មន្ត្រី សង្គ្រោះ សត្វ ព្រៃ (WRRT team) ដើម្បី ថែទាំ ចិញ្ចឹម បន្ត នៅ មជ្ឈមណ្ឌល សង្គ្រោះ សត្វ ព្រៃ នៃ ឧទ្យាន សួន សត្វ ព្រៃ ការពារ និង សួន សត្វ ភូត គាម ភ្នំ តាម៉ៅ ។
សូម បញ្ជាក់ ថា នៅ ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ មន្រ្តី ឧទ្យានុរក្ស ប្រចាំ ស្នាក់ការ មេម៉ង និង ស្នាក់ការខ្ទង់ អន្រ្ទង នៃ ដែន ជម្រក សត្វ ព្រៃ ភ្នំ ព្រេច បាន ទទួល កូន សត្វ ខ្លាឃ្មុំ តូច ចំនួន ០១ ក្បាល មាន ទម្ងន់ ៧គីឡូក្រាម ពី ប្រជា សហគមន៍ តំបន់ ការពារ ធម្មជាតិ រ ដែល រូប លោក បាន ចូលក្នុង ព្រៃ តាម ឃ្វាល សត្វ ក្របី ហើយ បាន ប្រទះឃើញ កូន សត្វ ខ្លាឃ្មុំ ស្រែក យំ មិន ឃើញ មេ របស់ វា ដោយ រូប លោក ខ្លាច កូន ខ្លាឃ្មុំ ងាប់ លោក ក៏ បាន ចាប់ យកមក ភូមិ ដើម្បី ប្រគល់ឲ្យ មន្រ្តី ជំនាញ ថែរក្សា ។
ក្រសួង បរិស្ថាន សូម ថ្លែងអំណរគុណ ចំពោះ ប្រជា សហគមន៍ ដែល មាន ការយល់ដឹង ខ្ពស់ ពី សារៈសំខាន់ នៃ ការថែរក្សា អភិរក្ស សត្វ ព្រៃ និង បាន ចូលរួម ក្នុង ការសង្គ្រោះ កូន សត្វ ខ្លាឃ្មុំ តូច នេះ មិន ឱ្យ មាន គ្រោះថ្នាក់ ។
ក្រសួង បរិស្ថាន សូម សម្តែង នូវ ការកោតសរសើរ ចំពោះ មន្ត្រី ឧទ្យានុរក្ស នៃ មន្ទីរ បរិស្ថាន ខេត្ត មណ្ឌលគិរី ដែល បាន យកចិត្តទុកដាក់ ខ្ពស់ លើ កិច្ច ការអភិរក្ស សត្វ ព្រៃ និង បាន ដឹកនាំ យក កូន សត្វ ខ្លាឃ្មុំ តូច នេះ មក ថែរក្សា អភិរក្ស នៅ មជ្ឈមណ្ឌល សង្គ្រោះ សត្វ ព្រៃ ប្រកបដោយ សុវត្ថិភាព ។
ជាមួយគ្នា នេះ ក្រសួង បរិស្ថាន ក៏ សូម ថ្លែងអំណរគុណ ចំពោះ អង្គការ WCS ដែល បាន គាំទ្រ លើ បច្ចេកទេស ក្នុង ការដឹក កូន សត្វ ខ្លាឃ្មុំ មកកាន់ ទីតាំង អភិរក្ស ៕ មន្ត្រី ជាន់ ខ្ពស់ គណបក្ស ប្រជាជន កម្ពុជា អំពាវនាវ ដល់ ពលរដ្ឋ គ្រប់ អាយុ អញ្ជើញ ទៅ ធ្វើ អត្តសញ្ញាណ បណ្ណ និង ចុះឈ្មោះ ឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា
( ព្រៃវែង ) ៖ លោក អ៉ីវ លាង សមាជិក គណៈកម្មការ កណ្តាល និង ជា អនុប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក បាភ្នំ ខេត្ត ព្រៃវែង បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល គ្រប់ អាយុ សូមអញ្ជើញ ទៅ ធ្វើ អត្តសញ្ញាណ បណ្ណ និមិន ទាន់ ចុះឈ្មោះ សូមអញ្ជើញ ទៅ ចុះឈ្មោះ បោះឆ្នោត តាម កាលបរិច្ឆេទ កំណត់ ដើម្បី បាន ឱកាស ចូលរួម បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រី នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ខាងមុខ នេះ ឱ្យ បាន គ្រប់ ៗ គ្នា ។
ការអំពាវនាវ បែប នេះ របស់ លោក អ៉ីវ លាង បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្នុង ឱកាស ដែល លោក បាន ដឹកនាំ ក្រុមការងារ ចុះ ស្តាប់ និង ប្រមូល យក នូវ មតិ យោបល់ ទទួល ដោះស្រាយ បញ្ហា ប្រឈម សំណូមពរ ទាំងឡាយ ពី ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ អង្ក្រង ឃុំ បឹង ព្រះ ស្រុក បាភ្នំ ខេត្ត ព្រៃវែង ។
ក្នុង ពេល នោះ ដែរ លោក ក៏ បាន ជំរុញ ដល់ អាជ្ញាធរ នៅក្នុង ឃុំ គ្រប់ លំដាប់ថ្នាក់ ត្រួតពិនិត្យមើល ពី បញ្ហា ប្រឈម នានា និង យកមក ដោះស្រាយ ឱ្យ បាន ទាន់ ពេល វេលា ។
លោក អ៉ី លាង បាន បន្ថែម ទៀត ថា ចំណែកឯ ប្រជាពលរដ្ឋ វិញ កាន់តែ ដើរ តួនាទី សំខាន់ ទៀត ដោយសារ ជា អ្នក ជួប និង នៅ ផ្ទាល់ ជាមួយ បញ្ហា ប្រឈម ទាំងអស់ នោះ ហេតុ នេះ លោក បាន ស្នើសុំ ប្រជាពលរដ្ឋ ចូលរួម រាយការណ៍ មក អាជ្ញាធរ មូលដ្ឋាន លើស ពី នេះ ទៅ ទៀត គឺ ហេតុការ បាតុភាព ទាំងឡាយ ដែល កើតមាន នៅក្នុង មូលដ្ឋាន រស់ នៅ ។
នៅក្នុង ឱកាស នោះ ប្រជាពលរដ្ឋ បាន លើកឡើង ពី សំណូមពរ ស្នើសុំ ប្រធាន ក្រុមការងារ និង អាជ្ញាធរ ឃុំ ពិនិត្យ ជួយ ធ្វើ ប្រឡាយ ទឹក មួយ ខ្សែ និង មាន ផ្លូវ អម ទាំង សងខាង ដោយ ប្រជាពលរដ្ឋ ថា ដើម្បី ងាយស្រួល ក្នុង ការធ្វើដំណើរ ។
ពាក់ព័ន្ធ សំណើ សុំ នេះ លោក មេឃុំ បាន បញ្ជាក់ ថា ប្រឡាយ ទឹក នឹង គឺ ស្ថិត ក្នុង គម្រោង ផែនការអភិវឌ្ឍ របស់ ឃុំ តាម គម្រោង មាន ផ្លូវ តែ មួយ ខ្សែ ទេ ដែល អម ជាមួយ នោះ ។ ប៉ុន្តែ ចំពោះ សំណើ សុំ ផ្លូវ អម សងខាង នេះ រដ្ឋបាល ឃុំ បាន ទទួលយក និង ចុះ សិក្សា នឹង ផ្តល់ ជូន តាម ភាព ជាក់ស្តែង ។
បើ តាម អ្នកនាំពាក្យ . គិត ត្រឹម ថ្ងៃទី ១៩ ខែវិច្ឆិកា ក្នុង ឆ្នាំ ២០២២ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១៣៧ .៤៣៨ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១១០ .៤៧២ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២៦. ៩៦៦ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ល្មើស សញ្ញា ស្រវឹង ទូរស័ព្ទ និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ល្មើស ល្បឿន ខ្សែក្រវាត់ ឆៀក លើស ចំណុះ អត់ បណ្ណ បើកបរ បត់ ជែង ស្រវឹង និង សញ្ញា ជាដើម ។
ចំណេះដឹង ទូទៅ៖ តើ ចំនួន ផ្កាយ លើ និមិត្ត សញ្ញា ក្រុម បាល់ទាត់ ជម្រើសជាតិ ល្បី ៗ មួយចំនួន តំណាង ឱ្យ អ្វី ?
គួរ បញ្ជាក់ ថា មាន ក្រុម បាល់ទាត់ ជម្រើសជាតិ របស់ ប្រទេស សរុប ចំនួន ៨ ដែល មាន រូប ផ្កាយ បែប នេះ នៅលើ និមិត្ត សញ្ញា របស់ ខ្លួន៖
លើកឡើង នា ឱកាស នាំយក មក នូវ ភាពជោគជ័យ ដែល បាន ទទួល មេដាយ ចំនួន ១៥ ដើម្បី ជូន មាតាបិតា ក៏ ដូចជា ជូន ជាតិ មាតុភូមិ នា ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ យុវជន ឈាង សុខី វុឌ្ឍ ជា សិស្ស មកពី សាលា ផារ៉ាហ្គន បាន ឱ្យដឹង ថា ក្នុង ចំណោម មេដាយ ទាំង ១៥ ដែល ខ្លួន ទទួលបាន នោះ មាន មេដាយ មាន ៨ និង មេដាយ ប្រាក់ ៧ ជាមួយ ការប្រកួត ដែល មាន ច្រើន មុខវិទ្យា ហើយនិង ទទួលបាន ពិន្ទុ ល្អ សម្រាប់ មុខវិទ្យា ទាំងនោះ ផងដែរ ។
យុវជន ឈាង សុខី វុឌ្ឍ បាន បន្ថែម ដែរ ថា សម្រាប់ កូន ខ្មែរ យើង គឺ ពិតជា មាន សមត្ថភាព ខ្លាំង ៗ មិន ចាញ់ បរទេស នោះ ឡើយ តាមរយៈ ការប្រកួតប្រជែង ៗ ផ្សេង ៗ កន្លងមក ហើយ បើសិនជា កូន ខ្មែរ ប្រឹងប្រែង ត ស៊ូ ឱ្យ កាន់តែ ខ្លាំង បន្ថែម ទៀត នឹង មាន សមត្ថភាព ខ្លាំង ដូចជា ប្រទេស គេ ផងដែរ ។ យុវជន រូប នេះ ក៏ បាន អះអាង ដែរ ថា ការប្រឡង លើក នេះ ក៏ មាន ភាព លំបាក មួយចំនួន ផងដែរ ដោយសារ ទាមទារ ឱ្យ មាន ការប្រើប្រាស់ ភាសា អង់គ្លេស ច្រើន ។
យុវតី រូប នេះ បាន បញ្ជាក់ ដែរ ថា សម្រាប់ ការប្រកួត នៅ សហរដ្ឋ អាមេរិក នេះ មាន សិស្ស ពូកែ ៗ ជាច្រើន បាន មក ចូល តែ អ្វី ដែល សំខាន់ គឺ នាង មាន ជំនឿ ជាក់ លើ ខ្លួន ឯង ជាមួយនឹង ការខិតខំ ប្រឹងប្រែង បន្ថែម តាមរយៈ ការប្រឹងប្រែង មើល មេរៀន ជាមួយនឹង ការប្រឹងប្រែង ស្រាវជ្រាវ រក បទពិសោធន៍ ឱ្យ បាន ច្រើន លើ ការប្រឡង ដោយ ហេតុ ថា ការប្រកួតប្រជែង មួយ នេះ គឺ មាន សិស្ស ពូកែ ជាច្រើន មកពី ប្រទេស ជាច្រើន នៅ ជុំវិញ ពិភពលោក បាន ចូលរួម ផងដែរ ។
បន្ថែម ពី នេះ សម្រាប់ អាណាព្យាបាល សិស្ស ដែល បាន ទៅ លើកទឹកចិត្ដ ដល់ សហរដ្ឋ អាមេរិក និង ជា តំណាង ឱ្យ អាណាព្យាបាល ទាំងអស់ លោក កើត សេកាណូ បាន ឱ្យដឹង ថា ក្រោយ បាន ទៅ លើកទឹកចិត្ន ដោយ ផ្ទាល់ នៅ សហរដ្ឋ អាមេរិក ឃើញ ថា កូន ខ្មែរ យើង គឺ ពិតជា មាន សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការចូលរួម ប្រកួតប្រជែង កម្រិត ពិភពលោក ជាមួយ បណ្តា ប្រទេស ធំ ៗ ជាច្រើន លើ សកលលោក ហើយក៏ បាន ឃើញ យ៉ាង ច្បាស់ ថា សមត្ថភាព របស់ កូន ខ្មែរ ពិតជា មាន ភាពរីក ដុះដាល ខ្លាំង គួរឱ្យ គត់ សម្គាល់ ផង ផងដែរ ។
ជាមួយគ្នា នោះ លោក កើត សេកាណូ ក៏ បាន អំពាវនាវ ឱ្យ អាណាព្យាបាល ទាំងអស់ ត្រូវ ជួយ ជំរុញ និង លើកទឹកចិត្ត កូន ឱ្យ ទៅ ធ្វើ ការប្រកួតប្រជែង នៅ ក្រៅ ប្រទេស ឱ្យ បាន គ្រប់ ៗ គ្នា ដើម្បីឱ្យ កូន របស់ ខ្លួន បាន បង្ហាញ ពី សមត្ថភាព លើ ឆាក អន្តរជាតិ ក៏ ដូចជា ជួយ លើកស្ទួយ មុខមាត់ របស់ ប្រទេសជាតិ ផងដែរ ។
តាមរយៈ បណ្តាញ សង្គម ហ្វេសប៊ុក សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ដូច្នេះ ថា៖ « បងប្អូន ជន រួម ជាតិ ជាទីគោរព ស្រឡាញ់ ! មកដល់ ពេលនេះ មេរោគ កូវីដ.១៩ ត្រូវបាន ធ្វើតេស្ត អវិជ្ជមាន ទាំងស្រុង ហើយ ។ គ្រូពេទ្យ ដែល ព្យាបាល ខ្ញុំ ចេញ លិខិត បញ្ជាក់ ដូច មាន ភ្ជាប់ ជាមួយ » ។
សម្តេច បាន ថ្លែងអំណរគុណ បងប្អូន ជន រួម ជាតិ ដែល បារម្ភ សុខ ទុក្ខ សម្តេច និង បាន ជូន ពរ ដល់ សម្តេច កន្លងមក ៕ គណៈកម្មការ អន្តរ រដ្ឋាភិបាល អាស៊ាន ទទួលបន្ទុក សិទ្ធិ មនុស្ស ( អាយ ឆា ) ចេញ សេចក្តីប្រកាស ព័ត៌មាន ពី លទ្ធផល នៃ កិច្ចសន្ទនា សិទ្ធិ មនុស្ស អាស៊ាន
( សៀមរាប )៖ គណៈកម្មការ អន្តរ រដ្ឋាភិបាល អាស៊ាន ទទួលបន្ទុក សិទ្ធិ មនុស្ស ( អាយ ឆា ) បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ កិច្ចសន្ទនា សិទ្ធិ មនុស្ស អាស៊ាន របស់ គណៈកម្មការ អន្តរ រដ្ឋាភិបាល អាស៊ាន ទទួលបន្ទុក សិទ្ធិ មនុស្ស ។ នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ។
បន្ទាប់ពី បាន រៀបចំ កិច្ចសន្ទនា សិទ្ធិ មនុស្ស អាស៊ាន ដោយ ជោគជ័យ ក្នុង ឆ្នាំ ២០១៣ ឆ្នាំ ២០១៤ និង ឆ្នាំ ២០២១មក គណៈកម្មការ អន្តរ រដ្ឋាភិបាល អាស៊ាន ទទួលបន្ទុក សិទ្ធិ មនុស្ស ( អាយ ឆា ) បាន រៀបចំ កិច្ចសន្ទនា មួយ ទៀត នៅ ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នៅ ខេត្ត សៀមរាប ដោយ សហការ ជាមួយ ក្រសួង ការបរទេស ឥណ្ឌូណេស៊ី ។
ការ រៀបចំ កិច្ចសន្ទនា សិទ្ធិ មនុស្ស អាស៊ាន ឆ្នាំ នេះ គឺ ស្រប នឹង ការប្រារព្ធ កម្មវិធី អបអរសាទរ ខួប១០ ឆ្នាំ នៃ សេចក្ដីប្រកាស សិទ្ធិ មនុស្ស អាស៊ាន (AHRD) និង សេចក្តីថ្លែងការណ៍ ភ្នំពេញ ស្តីពី ការអនុម័ត សេចក្តីប្រកាស សិទ្ធិ មនុស្ស អាស៊ាន ដែល បាន អនុម័ត នៅ ឆ្នាំ ២០១២ ។
កិច្ចសន្ទនា នេះ មាន ការចូលរួម ពី រដ្ឋ សមាជិក អាស៊ាន ទាំង១០ និង ស្ថាប័ន ជាតិ សិទ្ធិ មនុស្ស មួយចំនួន ក្នុង តំបន់ អាស៊ាន ក្នុង គោលបំណង ផ្តល់ ជា វេទិកា ថ្នាក់ តំបន់ មួយ ដើម្បី ធ្វើ ការផ្លាស់ប្តូរ ទស្សនក្នុង ចំណោម ប្រទេស សមាជិក អាស៊ាន និង ចែករំលែក នូវ ឧត្តមានុវត្តន៍ និង បទពិសោធន៍ ក្នុង ការលើកកម្ពស់ និង ការពារ សិទ្ធិ មនុស្ស នៅក្នុង ប្រទេស សមាជិក នីមួយ ៗ ។
សង្កត់ធ្ងន់ លើ សារៈសំខាន់ នៃ កិច្ចសហប្រតិបត្តិការ និង កិច្ចសន្ទនា ដោយ ស្មោះត្រង់ តំណាង រង កម្ពុជា និង ជា ប្រធាន អាយ ឆា លោក ជិន ម៉ាលី ន បាន គូសបញ្ជាក់ ថា « អាយ ឆា អាច កសាង ទំនុកចិត្ត ទៅ វិញ ទៅមក និង ចែករំលែក បទពិសោធន៍ ក្នុង ដំណើរ ឆ្ពោះទៅ មុខ នៃ ការលើកកម្ពស់ និង ការការពារ សិទ្ធិ មនុស្ស នៅក្នុង អាស៊ាន » ។
គណៈប្រតិភូ ក៏ បាន ពិភាក្សា អំពី វឌ្ឍនភាព នៃ ការផ្តល់ សច្ចាប័ន របស់ ប្រទេស ជា សមាជិក អាស៊ាន លើ អនុសញ្ញា សិទ្ធិ មនុស្ស អន្តរជាតិ កិច្ចសហប្រតិបត្តិការ ជាមួយ អង្គការ សហ ប្រជាជាតិ និង យុទ្ធសាស្ត ក្នុង ការអនុវត្ត អនុសាសន៍ន យន្ត ការពិនិត្យ ជា សកល តាម កាល កំណត់ (UPR) ។
តំណាង អាយ ឆា បាន បញ្ជាក់ ជាថ្មី នូវ ការប្តេជ្ញាចិត្ត របស់ ខ្លួន ក្នុង ការលើកកម្ពស់ និង ការពារ សិទ្ធិ មនុស្ស និង សេរីភាព ជា មូលដ្ឋាន តំណាង អោយ ឆា ក៏ បាន កត់សម្គាល់ ចំពោះ សំណើ ក្នុង ការបន្ត កិច្ចសន្ទនា នេះ នា ពេល អនាគត ។
កិច្ចសន្ទនា ស្តីពី សិទ្ធិ មនុស្ស អាស៊ាន ឆ្នាំ ២០២២ ត្រូវបាន សហការ ដឹកនាំ ដោយ អាយ ឆា - ឥណ្ឌ ណេស៊ី និង អាយ ឆា - កម្ពុជា ដោយ បាន រៀបចំឡើង ក្នុង ទម្រង់ ដោយ ផ្ទាល់ និង អនឡាញ ៕ លោក ណុប រ័ត្ន និមល៖ ដោយសារ កត្តា សុខ សន្តិភាព ទើប យើង មាន ឱកាស ជួបជុំ លេង កីឡា បាន ដូច ថ្ងៃ នេះ
( កណ្តាល ) ៖ លោក ណុប រ័ត្ន និមល ជំនួយការ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កណ្តាល ស្ទឹង បាន ថ្លែង ថា ដោយសារ កត្តា ប្រទេសជាតិ មាន សុខ សន្តិភាព ទើប យើង មាន ឱកាស ជួបជុំ លេង កីឡា បាន ដូច ថ្ងៃ នេះ ។
លោក ថ្លែង បែប នេះ ពេល តំណាង នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង ក្នុង ពិធី បើក ការប្រកួត កីឡា បាល់ទាត់ (FUTSAL) ដណ្តើម ពានរង្វាន់ « នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង លោកជំទាវ ប៉ែន ចន្នី » ដើម្បី អបអរសាទរ សាទរ ទិវា ជ័យជម្នៈ ៧មក រា ១៩៧៩ - ២០២៣ ប្រចាំ ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្ដាល ព្រឹក ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
លោក ណុប រ័ត្ន និមល បាន លើកឡើង ថា កន្លងមក ថ្មី ៗ នេះ កម្ពុជា ទទួលបាន នូវ មោទកភាព ជាតិ ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទៈ រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ប្រមុខរដ្ឋ និង ថ្នាក់ដឹកនាំ កំពូល ៗ ពិភពលោក ទទួលបាន លទ្ធផល ជោគជ័យ ជូន ជាតិ និង ប្រជាជន ។ លោក បាន ផ្ដាំផ្ញើ យុវជន ក្រៅពី ការសិក្សា នាំគ្នា លេង កីឡា ពីព្រោះ កីឡា នាំមក នូវ សុខភាព ល្អ មាន ការសាមគ្គីភាព ជា កាទូត គោរច ពិភពលោក ជាពិសេស យុវជន ជៀស ឱ្យ ឆ្ងាយ ពី គ្រឿងញៀន ។
លោក ឆែម រតនៈ វិសាល ប្រធាន គណៈកម្មការរៀបចំ ការប្រកួត កីឡា បាល់ទាត់ បាន ឲ្យដឹង ថា ការប្រកួត កីឡា បាល់ទាត់ (FUTSAL) ដណ្តើម ពានរង្វាន់ « នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង លោកជំទាវ ប៉ែន ចន្នី » មាន ២២ ក្រុម បាន បែងចែក ជា ៤ពូល កីឡាករ មកពី ១៨ ឃុំ និង ៣វិទ្យាល័យ នៅក្នុង ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្ដាល ការប្រកួត នៅ រៀងរាល់ ថ្ងៃអាទិត្យ ដែល ចាប់ផ្ដើម ពី ថ្ងៃ នេះ រហូតដល់ ថ្ងៃទី១ ខែមករា ឆ្នាំ ២០២៣ ។
ក្នុង ឱកាស បើក នៃ ការប្រកួត លោក ណុប រ័ត្ន និមល បាន ឧបត្ថម្ភ ថវិការ ជូន ដល់ ក្រុម កីឡាករ ទាំង ២២ ក្រុម សិស្ស វិទ្យាល័យ គណៈកម្មការ គណៈ អភិបាល ស្រុក ព្រមទាំង ក្រុមការងារ យ វជន បក្ស ចុះ ជួយ ស្រុក កណ្ដាល ស្ទឹង សរុប ថវិកា ជាង ១០លាន រៀល ៕
ក្រសួង ការពារ ជាតិ តួកគី បាន ប្រកាស ពី ប្រតិបត្តិការ យោធា ខាងលើ ក្នុង សេចក្ដីថ្លែងការណ៍ ចេញផ្សាយ លើ Twitter នៅ ថ្ងៃអាទិត្យ នេះ ។ ទីក្រុង អង់ការ៉ា បាន ចោទ ថា ការវាយប្រហារ បំផ្ទុះ គ្រាប់បែក កាលពី ថ្ងៃទី ១៣ ខែវិច្ឆិកា កន្លងទៅ គឺជា ស្នាដៃ របស់ គណបក្ស ពលករ ឃើដ (PKK) និង ក្រុម អ្នក យុទ្ធ ឃើដ ស៊ីរី បើ ទោះជា ក្រុម ទាំង ២ នេះ បដិសេធ ថា ខ្លួន មិន មាន ជាប់ពាក់ ក៏ដោយ ។
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការរក ឃើញ អ្នក ឆ្លង កូវីដ១៩ ចំនួន ៤នាក់ ខណៈ ជា អ្នក ជាសះស្បើយ គ្មាន ។
យល់ដឹង ពី ជំនួញ៖ មន្ត្រី ជំនាញ ណែនាំ លក្ខខណ្ឌ ដល់ អ្នក ប្រកបរបរ កសិកម្ម ឱ្យ ទទួល ផល ចំណេញ ពី ៨% ទៅ ១២% ពី ការប្រើប្រាស់ អគ្គិសនី ថ្លៃ អនុគ្រោះ
( ភ្នំពេញ ) ៖ ប្រធាន អាជ្ញាធរ អគ្គិសនី កម្ពុជា បាន បង្ហាញ ពី របៀប ឬ លក្ខខណ្ឌ ដល់ អ្នក ប្រកបរបរ ក្នុង វិស័យ កសិកម្ម ដូចជា កសិករ អ្នក ចិញ្ចឹម សត្វ អ្នកផលិត និង អ្នក កែច្នៃ ក្នុង ការប្រើប្រាស់ អគ្គិសនី ឱ្យ ទទួលបាន ផលចំណេញ យ៉ាងណាស់ ពី ៨ ដល់ ១២% ពី ការអនុវត្ត គោល នយោបាយ អនុគ្រោះ ថ្លៃ អគ្គិសនី ដើម្បី កាត់បន្ថយ ការចំណាយ ថ្លៃ ដើម និង បង្កើន ផលចំណេញ ។
លោក កត់សម្គាល់ ថា សម្រាប់ អ្នកប្រើប្រាស់ ប្រភេទ តង់ ស្យុង មធ្យម អាច ប្រើ ជា មធ្យម ប្រមាណ ៥ម៉ឺន គីឡូវ៉ាត់ ក្នុង មួយ ខែ ។ អ្នកប្រើប្រាស់ ប្រភេទ តង់ស្យុង ទាប ជា មធ្យម ប្រមាណ ២ម៉ឺន គីឡូវ៉ាត់ និង អ្នក ដែល ទិញ ពី ខ្សែ បណ្តាញ សាធារណៈ អាច ប្រើប្រាស់ ក្នុង រង្វង់ ៥ពាន់ គីឡូវ៉ាត់ ក្នុង មួយ ខែ ។
លោក បាន បញ្ជាក់ ថា តាម ការគណនី សាកល្បង អ្នកប្រើប្រាស់ ទាំង៤ ប្រភេទ នេះ ទទួលបាន ផលចំណេញ ពី អត្រា ថ្លៃ លក់ នេះ ពី ៨% ទៅ ១២% ប្រសិនបើ គាត់ ប្រើប្រាស់ ពេល ថ្ងៃ ៥០% និង ពេល យប់ ៥០% ។ ហើយ សម្រាប់ អ្នកប្រើប្រាស់ កាន់តែ ច្រើន នឹង ទទួលបាន ផលចំណេញ កាន់តែ ច្រើន ។
ចាប់ពី ឆ្នាំ ២០២១ មក ការអនុគ្រោះ ថ្លៃ អគ្គិសនី នេះ ត្រូវបាន ក្រសួង ពង្រីក វិសាលភាព កាន់តែ ទូលាយ ជាង មុន ពោលគឺ គ្រប់ ដណ្តប់ លើ អតិថិជន ទាំងអស់ ដែល ប្រើប្រាស់ សម្រាប់ វិស័យ កសិកម្ម គ្រប់ ប្រភេ ទាំងអស់ រាប់ ចាប់ពី អ្នក ចិញ្ចឹម សត្វ អ្នក ដាំដុះ ក សិ- ឧស្សាហកម្ម និង វារី ប្បករ ដែល ប្រើប្រាស់ ចំពោះ សកម្មភាព ទាំងឡាយ ណា ដែល បម្រើ ដល់ វិស័យ កសិកម្ម ដូចជា ការបូម ទឹក ការសម្ងួត ការផលិត ជី កសិកម្ម ម៉ាស៊ីកិន ស្រូវ រោងចក្រ កែច្នៃ ម្ហូប អាហារ ភេសជ្ជៈ និង រោងចក្រ ផលិត ចំណី សត្វ ជាដើម ។
ក្នុង វេទិកា សន្ទនា ស្តីពី ការប្រើប្រាស់ ថាមពល អគ្គិសនី សម្រាប់ វិស័យ កសិកម្ម ដែល បាន រៀបចំឡើង កាលពី ដើម សប្តាហ៍ លោក ស៊ុយ សែម រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល បាន ថ្លែង ថា បន្ទាប់ពី បាន ដាក់ចេញ នូវ គោល នយោបាយ អនុគ្រោះ ថ្លៃ លក់ ជាង ១ ឆ្នាំ មក នេះ សម្រាប់ វិស័យ កសិកម្ម ដែល ប្រើ នៅ ពេល យប់ នៅ មិន ទាន់ មាន ការអនុវត្ត ជាទូទៅ នោះ ឡើយ ដោយសារ អ្នកប្រើប្រាស់ ក្នុង វិស័យ នេះ មិន ទាន់ យល់ដឹង អំពី ការអនុគ្រោះ ថ្លៃ នេះ ។
លោក ឌិត ទីណា រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម បាន បង្ហាញ នូវ ការជឿជាក់ ថា ប្រសិនបើ បងប្អូន កសិករ អ្នក ចិញ្ចឹម សត្វ និង អ្នកផលិត អនុវត្តន៍ បាន ពេញលេញ នូវ គោល នយោយ បាយ អនុគ្រោះ ថ្លៃ អគ្គិសនី សម្រាប់ វិស័យ កសិកម្ម របស់ រាជ រដ្ឋាភិបាល នោះ ការចំណាយ ថ្លៃ ដើម នឹង ត្រូវកាត់បន្ថយ ហើយ ផល ចំណេញ នឹង មាន កាន់តែ ច្រើន ជាង មុន ៕
ខាងក្រោម នេះ ជា របាយការណ៍ នៃ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ប្រទេស អាស៊ាន គិត ត្រឹម ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២៖
គួរ បញ្ជាក់ ថា គណនី Twitter របស់ លោក ដូណាល់ ត្រាំ ត្រូវបាន បិទ កាលពី ដើម ឆ្នាំ ២០២១ បន្ទាប់ពី លោក ត្រូវបាន គេ ចោទប្រកាន់ ថា បាន ញុះញង់ ឱ្យ អ្នកគាំទ្រ រូប លោក វាយប្រហារ លើ វិមាន Capitol កាលពី ថ្ងៃទី ៦ ខែមករា ឆ្នាំ ដដែល ដើម្បី រារាំង ការប្រកាស ជ័យជម្នះ របស់ លោក ចូ បៃ ដិន ។ រីឯ ការសម្រេចចិត្ត បើ គណនី លោក ត្រាំ ឡើងវិញ កើត មាន ឡើង តែ ប៉ុន្មាន ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី អតីត ប្រធានាធិបតី អាមេរិក រូប នេះ ប្រកាស ចូលរួម ក្នុង ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី នៅ ឆ្នាំ ២០២៤ ៕
( ភ្នំពេញ ) ៖ គិត ត្រឹម ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៥. ២២៣. ៣៦៨ នាក់ ។ ក្នុង នោះ រួម មាន៖
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ !
ដោយឡែក អ្នកនាំពាក្យ របស់ លោក នាយក រដ្ឋមន្រ្តី បាន និយាយ ថា ទស្សនកិច្ច លើក ដំបូង របស់ លោក ស៊ូណាក់ ទៅកាន់ ទីក្រុង កៀវ នា ពេលនេះ ដើម្បី បញ្ជាក់ ពី ការបន្ត គាំទ្រ របស់ ចក្រភព អង់គ្លេស ចំពោះ អ៊ុយក្រែន ។
គួរ បញ្ជាក់ ថា ទោះជា ទទួលបាន ការអញ្ជើញ ពី លោក ហ្សេលេន ស្គី ក៏ អ្នកកាន់ តំណែង មុន គឺ លោកស្រី លីស ត្រាស់ មិន បាន ធ្វើដំណើរ ទៅ អ៊ុយក្រែន ឡើយ ។ ហើយ កន្លងមក ក្នុង អាណត្តិ របស់ លោក បូរី ស ចន សុន បាន ចែករំលែក ទំនាក់ទំនង មិត្តភាព ជាច្រើន ក្នុង នាម ជា នាយក រដ្ឋមន្ត្រី ជាមួយ អ៊ុយក្រែន ៕
អ្នកជំនាញ បង្ហាញ ពី អត្ថប្រយោជន៍ នៃ ការប្រើប្រាស់ ប្រេង ស្លឹក គ្រៃ និង តែ ស្លឹក គ្រៃ
ការបង្ហាញ ពី អត្ថប្រយោជន៍ នេះ ដែរ ក៏ មាន ការម៉ាស្សា ដោយ ប្រើ ប្រេង ស្លឹក គ្រៃ ដល់ ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ អន្តរជាតិ ដោយ ឥត គិត ថ្លៃ ដែល ពួកគាត់ ទៅ ទិញ បន្លែ ត្រី សាច់ នៅ ផ្សារ ចុង សប្តាហ៍ ខេត្ត សៀមរាប ។
ជាមួយ នេះ ដែរ កញ្ញា តាន់ ឌីណារី ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ងាក មក គាំទ្រ ផលិត ដែល ផលិត ដោយ ប្រជាកសិករ ខ្មែរ ដើម្បី លើកស្ទួយ វិស័យ កសិកម្ម នៅ កម្ពុជា ឱ្យ មាន ការរីកចម្រើន ទៅ មុខ និង ជួយ ស្ទួយ ជីវភាព ប្រជាកសិករ ផងដែរ ៕ លោកស្រី ពេជ ចន្ទ មុន្នី ចែករំលែក បទពិសោធន៍ ល្អ ៗ ដល់ យុវជន ក្នុង កម្មវិធី « ជួប នឹង បង ស្រី ឆ្នើម » នៅ ខេត្ត កំពត
( កំពត ) ៖ លោកស្រី ពេជ ចន្ទ មុន្នី អគ្គ ស្នងការ នៃ សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា បាន ចែករំលែក ចំណេះដឹង បទពិសោធន៍ ចំនួន ៣ចំណុច ជូន ដល់ សមាជិកា និង យុវតី ក្នុង កម្មវិធី « ជួប នឹង បង ស្រី ឆ្នើម » ដែល រៀបចំឡើង នៅ ខេត្ត កំពត នា ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ដោយ មាន អ្នកចូលរួម ប្រមាណ ជាង ៤០០ នាក់ ។
ចំណុច ទាំង បី នោះ រួម មាន៖១. ចាប់ផ្តើម ជួយសង្គម របស់ អ្នក ពី ចំណុច តូច ៗ ទៅ ។២. រៀន ពី អ្នកដទៃ ដើម្បី ជួយ ខ្លួន ឯង និង សង្គម ។៣. ធ្វើ ការ អ្វី មួយ ធ្វើ ដោយ ស្ម័គ្រចិត្ត ទឹកចិត្ត និង ដោយ បេះដូង ដែល ចំណុច ទាំង ៣នេះ គឺ ពិតជា អនុសាសន៍ ដ៏ ល្អ និង ការលើកទឹកចិត្ត ដ៏ មាន ឥទ្ធិពល សម្រាប់ កុមារី យុវតី និង ស្ត្រី អាច យក ទៅ អនុវត្ត សម្រាប់ ជីវិត ការសិក្សា ការងារ និង ការរស់នៅ ប្រចាំ ថ្ងៃ ។
លោកស្រី ពេជ ចន្ទ មុន្នី បាន បើក ឱកាស ឱ្យ សមាជិកា និង អ្នកចូលរួម ជាពិសេស សមាជិកា សកម្ម របស់ សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា បាន ចូលរួម ទទួលយក បទពិសោធន៍ នៃ ការចូលរួម កម្មវិធី បាន បង្កើន បណ្ដាញ ទំនាក់ទំនង បាន មាន ឱកាស បញ្ចេញ ភាពក្លាហាន តាមរយៈ ការសាកសួរ សំណួរ និង ទទួល នូវ សារ សំខាន់ ៗ ដែល លោកស្រី បាន ចែករំលែក ដល់ ពួកគាត់ ដែល ជា គន្លឹះ អាច ឱ្យ ពួកគាត់ យក ទៅ អនុវត្ត ដើម្បី កសាង អនាគត និង ទិសដៅ ជីវិត ប្រសើរ ។
លើស ពី នេះ គឺ កាន់តែ ជំរុញ ទឹកចិត្ត ការចូលរួម ស្ម័គ្រចិត្ត ចែករំលែក របស់ សមាជិក គាំទ្រ កាន់តែ ខ្លាំង ទៀត ព្រោះ សកម្មភាព ពិត ប្រាកដ របស់ សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា គឺ ពិតជា ទទួលបាន ផលប្រយោជន៍ ពី ការកម្មវិធី របស់ សមាគម ហើយ បាន អភិវឌ្ឍ ចំណេះដឹង សមត្ថភាព ជំនាញ សីលធម៌ គុណធម៌ ដើម្បី ដឹកនាំ ជីវិត របស់ ពួកគេ ៕ មនុស្ស ៩នាក់ ស្លាប់ និង ម្នាក់ បាត់ខ្លួន ក្នុង ហេតុការណ៍ បាក់ រលំអគារ នៅ ភាគ ខាងកើត ប្រទេស រុស្ស៉ី
( មូស្គូ) ៖ អភិបាល តំបន់ បាន និយាយ នៅ ថ្ងៃសៅរ៍ នេះ ថា មនុស្ស ចំនួន ៩នាក់ ត្រូវបាន គេ រកឃើញ ស្លាប់ នៅក្នុង គំនរ បាក់បែក នៃ អគារ ផ្ទះល្វែង កម្ពស់ ៥ជាន់ ដែល បាន ដួលរលំ ដោយ ផ្នែក នៅលើ តំបន់ កោះ សាខា លីន (Sakhalin) ប៉ាស៊ីហ្វិក របស់ រុស្ស៊ី ហើយ ក្រុម សង្គ្រោះ បន្ទាន់ កំពុង ស្វែងរក អ្នក បាត់ខ្លួន ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយសារព័ត៌មាន រុស្ស៉ី RT នៅ ថ្ងៃសៅរ៍ ទី១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
ការបាក់ នេះ ទំនងជា បណ្តាល មកពី ការផ្ទុះ ឧស្ម័ន ។ ដោយ ដកស្រង់ ប្រភព ពី មន្រ្តី នៃ ក្រុម សង្រ្គោះ បន្ទាន់ សារព័ត៌មាន RT បាន រាយការណ៍ ថា ស៊ីឡាំង ឧស្ម័ន ចំណុះ ២០លីត្រ ដែល ភ្ជាប់ ទៅនឹង ចង្ក្រាន ចម្អិន អាហារ បាន ផ្ទុះ ឆេះ ។
បច្ចុប្បន្ន គណៈកម្មាធិការ ស៊ើបអង្កេត របស់ រុស្ស៊ី កំពុង ស៊ើបអង្កេត មូលហេតុ នៃ គ្រោះមហន្តរាយ នេះ ៕ ទីក្រុង កៀវ និង ខេត្ត ផ្សេង ទៀត របស់ អ៊ុយក្រែន រង នូវ ការដាច់ ភ្លើង និង ខូចខាត ហេដ្ឋារចនាសម្ព័ន្ធ ក្រោម ការវាយប្រហារ ថ្មី ៗ របស់ រុស្ស៉ី (Video inside)
( កៀវ ) ៖ មន្ត្រី ក្នុង ទីក្រុង កៀវ បាន និយាយ នៅ ថ្ងៃសុក្រ សប្តាហ៍ នេះ ថា ប្រជាជន អ៊ុយក្រែន រាប់ លាន នាក់ នៅក្នុង ខេត្ត ប្រមាណ ១១ កំពុង ជួបប្រទះ នឹង ការរំខាន ផ្នែក ថាមពល ធ្ងន់ធ្ងរ ខណៈ អាកាសធាតុ ចុះ ត្រជាក់ ហើយ ស្ទើរតែ ពាក់កណ្តាល នៃ ហេដ្ឋារចនាសម្ព័ន្ធ ថាមពល របស់ ប្រទេស កំពុង ត្រូវការ ការ ជួសជុល ឡើងវិញ ក្រោយ ការវាយប្រហារ ជាច្រើន សប្តាហ៍ ពីសំណាក់ រុស្ស៊ី ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសៅរ៍ ទី១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
ប្រធានាធិបតី អ៊ុយក្រែន លោក វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី បាន ឲ្យដឹង ថា ខេត្ត ចំនួន ១៧ និង រដ្ឋធានី កៀវ កំពុង ជួប បញ្ហា ដាច់ចរន្ត អគ្គិសនី ប៉ុន្តែ វិស្វករ កំពុង ធ្វើ ការជួសជុល ខ្សែ បណ្តាញ ឡើងវិញ ហើយ ការដាច់ចរន្ត អគ្គិសនី គឺ កាន់តែ តិច ទៅ ៗ ។
គួរ បញ្ជាក់ ថា រយៈពេល ជិត ប្រាំបួន ខែ នៃ ការប្រយុទ្ធ គ្នា រវាង អ៊ុយក្រែន និង រុស្ស៊ី បាន ជំរុញ ឱ្យ មាន ការចោទប្រកាន់ ទៅ វិញ ទៅ មក លើ ការប្រព្រឹឹត្ត ឧក្រិដ្ឋកម្ម សង្រ្គាម រវាង ភាគី ទាំង ពីរ ៕ លោក គីម ជុង អ៊ុន ប្រកាស ប្តេជ្ញា ឆ្លើយតប ដោយ អាវុធ នុយក្លេអ៊ែរ ចំពោះ ការគំរាមកំហែង នុយក្លេអ៊ែរ ពី សហរដ្ឋ អាមេរិក (Video inside)
( សេអ៊ូល ) ៖ ប្រមុខ ដឹកនាំ កំពូល កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន បាន ប្តេជ្ញា ថា នឹង តតាំង ចំពោះ ការគំរាមកំហែង នៃ អាវុធ នុយក្លេអ៊ែរ របស់ អាមេរិក តាមរយៈ អាវុធ នុយក្លេអ៊ែរ ដូចគ្នា ខណៈ ដែល លោក បាន ចុះ ត្រួតពិនិត្យ ការធ្វើតេស្ត មួយ កាលពី ថ្ងៃសុក្រ សប្តាហ៍ នេះ នៃ មីស៉ីល បាលិស្ទី គ ICBM ដែល ក្រុម អ្នកជំនាញ ជឿ ថា មាន សមត្ថភាព បាញ់ ដល់ សហរដ្ឋ អាមេរិក ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃសៅរ៍ ទី១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
កាលពី ថ្ងៃសុក្រ កូរ៉េ ខាងជើង បាន បាញ់ តេស្ត មីស៉ីល ICBM ប្រភេទ Hwasong-17 បន្ទាប់ពី ចេញមុខ ប្រកាស ព្រមាន ឆ្លើយតប ផ្នែក យោធា ឱ្យ កាន់តែ ខ្លាំងក្លា ជាង មុន ថែម ទៀត ចំពោះ ការ ដែល ទីក្រុង វ៉ាស៉ីនតោន បង្កើន វត្តមាន យោធា របស់ ខ្លួន នៅក្នុង តំបន់ ជាពិសេស ការចល័ត សព្វាវុធយុទ្ធសាស្រ្ត សំខាន់ ដូចជា នាវា ផ្ទុក យន្តហោះ ចម្បាំង និង យន្តហោះ ទម្លាក់ គ្រាប់បែក ជាដើម ។
យោង តាម សេចក្តីរាយការណ៍ របស់ ទីភ្នាក់ងារ ព័ត៌មាន រដ្ឋ កូរ៉េ ខាងជើង KCNA នា ឱកាស ចុះ ត្រួតពិនិត្យ ដំណើរ ការធ្វើតេស្ត ICBM នោះ លោក គីម ជុង អ៊ុន បាន និយាយ ថា ការគំរាមកំហែង ពី សហរដ្ឋ អាមេរិក និង សម្ពន្ធមិត្ត ដែល ប្រកាន់ គោល នយោបាយ បង្ក ភាពជា សត្រូវ បាន បង្ខំឱ្យ ប្រទេស លោក ខិតខំ ពន្លឿន ជាខ្លាំង នូវ ការ ពង្រឹង សមត្ថភាព ការពារ ខ្លួន ដើម្បី ទប់ស្កាត់ ការវាយប្រហារ មក លើ កូរ៉េ ខាងជើង ។
KCNA បាន អះអាង ក្នុង សេចក្តីរាយការណ៍ របស់ ខ្លួន យ៉ាង ដូច្នេះ ថា « លោក គីម ជុន អ៊ុន បាន ប្រកាស យ៉ាង ម៉ឺងម៉ាត់ ថា ប្រសិនបើ ស ត្រូវ នៅតែ បន្ត បង្ក ការគំរាមកំហែង នោះ គណបក្ស ក៏ ដូចជា រដ្ឋាភិបាល យើង នឹង ឆ្លើយតប ចំពោះ អាវុធ នុយក្លេអ៊ែរ ដោយ អាវុធ នុយក្លេអ៊ែរ ដូចគ្នា ហើយ នឹង ឆ្លើយតប ចំពោះ ការប្រឈមមុខ ដោយ ការប្រឈមមុខ ពេញ ទំហឹង ដូចគ្នា ផងដែរ ។
រដ្ឋមន្ដ្រី ម៉ម ប៊ុនហេង អញ្ជើញ បើក វិញ្ញាណ សា ប្រឡង ប្រជែង ជ្រើសរើស ក្របខណ្ឌ សុខាភិបាល ឆ្នាំ ២០២២
( ភ្នំពេញ ) ៖ លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល នៅ រសៀល ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ បើក វិញ្ញាសា ប្រឡង ប្រជែង ជ្រើសរើស ក្របខណ្ឌ សុខាភិបាល ឆ្នាំ ២០២២ ដែល ប្រព្រឹត្ដទៅ នៅ វិទ្យាល័យ បាក់ទូក រាជធានី ភ្នំពេញ ។
រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង បាន ថ្លែង ថា « ថ្ងៃ នេះ យើង បើក វគ្គ ប្រឡង ក្របខណ្ឌ មន្ដ្រី សុខាភិបាល ទូទាំង ប្រទេស ដែល មាន បេក្ខជន ចំនួន ១១. ៨៩៨ នាក់ ហើយ យើង ត្រូវការ ជ្រើសរើស ៣. ៣២៤ នាក់ សម្រាប់ នៅ ថ្នាក់ កណ្ដាល ( អង្គភាព ថ្នាក់ មជ្ឈឹម ) ចំនួន ៩១៣ នាក់ អង្គភាព រាជធានី ខេត្ដ ចំនួន ២. ៤១១នាក់ ដែល ជ្រើសរើស ចំនួន ២០មុខវិជ្ជា » ។
លោក រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន គូសបញ្ជាក់ ថា « ការអញ្ជើញ មក បើក វិញ្ញាសារ ប្រឡង នេះ ក៏ មាន ការចូលរួម ពី ក្រសួង មុខងារ សាធារណៈ ឧបការី តំណាង អង្គភាព ប្រឆាំង អំពើពុករលួយ ដើម្បី ជា សាក្សី ក្នុង ការពិនិត្យ ការងារ ប្រឡង យើង ដើម្បី ប្រាកដ ថា យើង ផ្ដល់ ភាពយុត្ដិធម៌ ដល់ សិស្សានុសិស្ស ក៏ ដូចជា ប្រជាពលរដ្ឋ របស់ យើង ពិសេស ឱ្យ ប្រាកដប្រជា ថា យើង ធ្វើ បាន ត្រឹមត្រូវ ទៅ តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ហើយ ធ្វើឱ្យ ប្រជាជន មាន ជំនឿ ទុកចិត្ដ លើ ប្រព័ន្ធ ប្រឡង ជ្រើសរើស ក្របខណ្ឌ របស់ រាជ រដ្ឋាភិបាល » ។ ៧១៣
លោក រដ្ឋមន្ដ្រី បាន បន្ដ ថា ចំពោះ អ្នកគ្រប់គ្រង និង អនុ រក្ស មាន ចំនួន ៧១៣ នាក់ ក្នុង នោះ មាន អ្នក សង្គេតការណ៍ របស់ អង្គភាព ប្រឆាំង អំពើពុករលួយ ចំនួន ២០០ នាក់ ផងដែរ ។ ចំណែក ចំពោះ ការធ្វើ កំណែការប្រឡង ប្រជែង ជ្រើសរើស ក្របខណ្ឌ សុខាភិបាល ឆ្នាំ ២០២២ នេះ អាច កែ ហើយ បាន ឆាប់ ៗ ព្រោះ ប្រើ ប្រព័ន្ធ អេឡិចត្រូនិច ។
បទ អត្ថាធិប្បាយ៖ ប្រទេស ចិន នឹង បន្ត ចាក់ គ្រឹះ កសាង និង ផ្តល់ ផលប្រយោជន៍ ដល់ អាស៊ី ប៉ាស៊ីហ្វិក ត ទៅទៀត
« ត្រូវតែ គាំពារ យុត្តិធម៌ និង សច្ច ភាព អន្តរជាតិ ដើម្បី កសាង អាស៊ី ប៉ាស៊ីហ្វិក ប្រកបដោយ សន្តិភាព និង ស្ថិរភាព » « ប្រកាន់ខ្ជាប់ នូវ ការ បើក ទូលាយ និង បរិយាប័ន្ន ដើម្បី កសាង អាស៊ី ប៉ាស៊ីហ្វិក ដែល មាន ភាព សម្បូរសប្បាយ រួម » « ប្រកាន់ខ្ជាប់ ការអភិវឌ្ឍ ដោយ កាបូន ទាប និង បៃតង ដើម្បី កសាង អាស៊ី ប៉ាស៊ីហ្វិក ដ៏ ស្រស់ស្អាត » « ប្រកាន់ខ្ជាប់ ជោគវាសនា រួម ដើម្បី កសាង អាស៊ី ប៉ាស៊ីហ្វិក ដែល គាំទ្រ និង ជួយ គ្នា ទៅ វិញ ទៅមក » សំណើ បួន ចំណុច ដែល លោក Xi Jinping ផ្តួចផ្តើម បាន ផ្តល់ ចម្លើយ យ៉ាង ច្បាស់លាស់ ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា៖
ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក កំពង់ស្វាយ ជំរុញ ពលរដ្ឋ ដែល គ្រប់ អាយុ បោះឆ្នោត ត្រូវ ទៅ ចុះឈ្មោះ និង ពិនិត្យ បញ្ជី ឈ្មោះ ឲ្យបាន គ្រប់ ៗ គ្នា
( កំពង់ធំ )៖ លោកស្រី ឃួន ឃុន ឌី ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ណែនាំ ក្រុមការងារ ជំរុញ យុវជន ដែល គ្រប់ អាយុ បោះឆ្នោត និង ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ទៅ ពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា និង ធ្វើ បច្ចុប្បន្នភាព ក្រុមការងារ គណបក្ស ឲ្យបាន ល្អ ប្រសើរ ថែម ទៀត ព្រមទាំង បំពេញ រចនាសម្ព័ន្ធ ដែល នៅ ខ្វះ ចន្លោះ ឲ្យ បាន ឆាប់ រួមគ្នា ធ្វើ រួមគ្នា ទទួលខុសត្រូវ ដោយ បំពេញ បន្ថែម នូវ ចំណុច ខ្វះខាត មួយចំនួន ឡើងវិញ ។
ក្នុង កិច្ចប្រជុំ ប្រចាំ ខែ ដើម្បី ពង្រឹង ក្រុមការងារ ចុះ មូលដ្ឋាន តាម បណ្ដា ឃុំ ក្នុង ស្រុក កំពង់ស្វាយ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ លោកស្រី ឃួន ឃុនឌី ក៏ បាន រំលឹក ដល់ ក្រុមការងារ ត្រូវ ចុះ ដល់ មូលដ្ឋាន និង ធ្វើ ជំរឿន សមាជិក បក្ស ឲ្យបាន ពិតប្រាកដ ដើម្បី យកឈ្នះ ការបោះឆ្នោត នៅ ឆ្នាំ ២០២៣ ខាងមុខ ។
លោកស្រី បន្ដ ថា ក្រុមការងារ ត្រូវ ចូលរួម រក្សា បាន លទ្ធផល ឆ្នោត ឲ្យបាន ហើយ ត្រូវ បន្ត ការកសាង បក្ស រក្សា ចាស់ កសាង ថ្មី និង ខិតខំ បន្ត ចុះ ជួយ បក្ស តាម មូលដ្ឋាន ខិតខំ ធ្វើ អំពើ ល្អ និង បម្រើ ប្រជាពលរដ្ឋ ដោយ មិន មាន ការរើសអើង ហើយ កងកម្លាំង មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ត្រូវ បន្ត ថែរក្សា ពង្រឹង សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម ឲ្យបាន ល្អ ប្រសើរ ក្នុង ការចូលរួម អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ ឲ្យ មាន សុវត្ថិភាព ។
លោកស្រី ឃួន ឃុន ឌី បាន កោតសរសើរ ក្រុមការងារ និង អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ដែល បាន ខិតខំ រួមគ្នា សម្រេចបាន នូវ សមិទ្ធផល ល្អ ៗ ជាច្រើន លើ គ្រប់ វិស័យ រក្សា បាន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម និង ខិតខំ ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម បាន ល្អ ប្រសើ ឆ្ពោះទៅ មុខ តែ នៅ មាន មន្ត្រី មួយចំនួន ហាក់ មើល ស្រាល ការងារ របស់ ខ្លួន ពិសេស ត្រូវ ពង្រឹង ការងារ នៅ មូលដ្ឋាន ឡើងវិញ ។
ក្នុង នោះ លោកស្រី បាន ផ្តល់ នូវ កុំព្យូទ័រ យួរ ដៃ មួយ គ្រឿង ដល់ គណបក្ស ឃុំ កំពង់ស្វាយ សម្រាប់ បញ្ចូល ទិន្នន័យ សមាជិក និង បម្រើ ការងារ ផ្សេង ៗ ផងដែរ ៕
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្រុមការងារ និង កម្លាំង ស្ម័គ្រចិត្ត នៃ សមាគម TYDA ចំនួន ៨៧ នាក់ បាន ចុះ ពិនិត្យ ព្យាបាល ជំងឺ មាត់ ធ្មេញ ជំងឺ ទូទៅ និង អប់រំ សុខភាព មាត់ ធ្មេញ - សុខភាព ទូទៅ ជូន សិស្សានុសិស្ស និង លោកគ្រូ អ្នកគ្រូ និង អាណាព្យាបាល សិស្ស នៅ អនុវិទ្យាល័យ គោក បញ្ជាន់ ស្ថិត ក្នុង សង្កាត់ ចោម ចៅ២ ខណ្ឌ ពោធិ៍សែនជ័យ បាន ចំនួន ៥៨៩ នាក់ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក វេជ្ជបណ្ឌិត ស៊ឹម ស៊ូ យេង អនុប្រធាន ប្រតិបត្តិ សមាគម TYDA បាន បញ្ជាក់ ថា លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ប្រធាន អនុប្រធាន ក្រុមប្រឹក្សាភិបាល តែងតែ យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ក្នុង ការសុខ មាលភាព របស់ ប្រជាពលរដ្ឋ និយាយ ជា រួម និង និយាយ ដោយឡែក លោក ទាំង ពីរ បាន យកចិត្តទុកដាក់ ខ្លាំង ចំពោះ សុខ មាលភាព ក្មួយ ៗ សិស្សានុសិស្ស ដែល ជា ទំពាំង ស្នង ឬស្សី ។
លោក វេជ្ជបណ្ឌិត ស៊ឹម ស៊ូ យេង បាន បន្ថែម ទៀត ថា សុខភាព មាត់ ធ្មេញ មាន សារៈសំខាន់ ណាស់ សម្រាប់ ក្មួយ ៗ សិស្សានុសិស្ស ព្រោះ នៅ ពេល ដែល សុខភាព មាត់ ធ្មេញ រឹងមាំ សុខភាព ទូទៅ កាន់តែ ល្អ ប្រសើរ ហើយ រាង្គកាយ រឹងមាំ នោះ ក្មួយ ៗ មក រៀនសូត្រ បាន ទៀងទាត់ ដែល នឹង ឲ្យ ក្មួយ រៀន ពូកែ និង លទ្ធផល សិក្សា បាន ល្អ ។
លោក វេជ្ជបណ្ឌិត បាន បញ្ជាក់ ថា រហូតមកដល់ សព្វ ថ្ងៃ នេះ TYDA មាន អាយុ ១០ឆ្នាំ ហើយ ដោយ មាន សមាជិក ជាង ៨ ពាន់ នាក់ ។ ក្នុង រយៈពេល ១០ឆ្នាំ នេះ TYDA បាន ព្យាបាល ជំងឺ ទូទាំង ប្រទេស បាន ជាង ៣៥ម៉ឺន នាក់ ហើយ អ្នកជំងឺ ធ្ងន់ធ្ងរ ចំនួន ជាង ៦ពាន់ នាក់ ត្រូវបាន សមាគម បញ្ចូន មក ព្យាបាល បន្ត នៅ រាជធានី ភ្នំពេញ និង ជាមួយ ដៃគូ សហការ នានា ក្នុង នោះ អ្នកជំងឺ បេះដូង ធ្ងន់ធ្ងរ ចំនួន ៥៨ នាក់ បាន បញ្ចូន មក និង វះកាត់ ដោយ ជោគជ័យ ផងដែរ ។
លោកស្រី ឈុន ស៊ុន នី អភិបាល រង ខណ្ឌ ពោធិ៍សែនជ័យ បាន ថ្លែងអំណរគុណ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល ខិតខំ ស្វះស្វែងរក វ៉ាក់សាំង មក ចាក់ ជូន ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ។ ដោយសារ បាន ចាក់ វ៉ាក់សាំង គ្រប់ គ្នា ៗ នេះ ហើយ ទើប កម្ពុជា បាន ជៀស ផុត ពី ជំងឺ កូវីដ១៩ ដែល ផ្តល់ ឱកាស ឲ្យ គ្រប់ គ្នា បាន ជួបជុំ ដោយ ផ្ទាល់ ឡើងវិញ ក៏ ដូចជា ក្មួយ ៗ បាន ត្រលប់ មក សិស្សា វិញ ។
លោកស្រី អភិបាល រង ខណ្ឌ ក៏ បាន ផ្ដល់ ដំបូន្មាន ឲ្យ សិស្សា នុសិ្ស យកចិត្តទុកដាក់ ថែទាំ សុខភាព ផ្ទាល់ខ្លួន និង ខិតខំ រៀនសូត្រ ឲ្យបាន ពូកែ ជា ឆ្ងាយ ពី អំពើ អបាយ មុខ ផ្សេង ៗ ដើម្បី ក្លាយ ខ្លួន ជា កូន ល្អ សិស្ស ល្អ និង ប្រជាពលរដ្ឋ ល្អ ដើម្បី ចូលរួម អភិវឌ្ឍន៍ សង្គមជាតិ ។
លោកស្រី ឈុន ស៊ុន នី បាន ថ្លែងអំណរគុណ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ដែល បាន បញ្ជូន ក្រុមការងារ និង កម្លាំង ស្ម័គ្រចិត្ត នៃ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ «TYDA» ចុះ ព្យាបាល និង អប់រំ សុខភាព មាត់ ធ្មេញ សិស្សានុសិស្ស អនុវិទ្យាល័យ គោក បញ្ជាន់ និង ថ្លែងអំណរគុណ យុវជន សមាគម អ. ម. ត យុវជនសសយក សប្បុរស ជន លោក លោកស្រី មន្ត្រី សាលា ខណ្ឌ លោក នាយក សាលា លោកគ្រូ អ្នកគ្រូ និង ផ្នែក ដែល ពាក់ព័ន្ធ ដែល បាន ចូលរួម សហការ រៀបចំ កម្មវិធី ពិនិត្យ ជំងឺ នា ថ្ងៃ នេះ ។
នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ៖ កម្ពុជា ត្រៀម រួចរាល់ សម្រាប់ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន ចាប់ពី ថ្ងៃទី ២២ - ២៣ ខែវិច្ឆិកា
នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ បាន ថ្លែង ថា សម្រាប់ កិច្ចប្រជុំ នេះ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន មាន ការយកចិត្ត ទុក យ៉ាង ខ្លាំង ពីសំណាក់ ក្រសួង ការពារ ជាតិ ក្រោម ការចង្អុលបង្ហាញ ពីសំណាក់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧបនាយ រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ កម្ពុជា និង ជា ប្រធាន កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន និង ប្រជុំ ពាក់ព័ន្ធ ឆ្នាំ ២០២២ ព្រមទាំង មាន សហការ យ៉ាង ម៉ត ចត់ ពីសំណាក់ អ្នក ពាក់ព័ន្ធ ដើម្បីឱ្យ ដំណើរការ នៃ កិច្ចប្រជុំ នេះ ប្រព្រឹត្តទៅ ដោយ រលូន ។
នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ បាន បញ្ជាក់ ថា៖ « កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក ក្នុង ឱកាស ព្រឹត្តិការណ៍ ដែល យើង ធ្វើជា ម្ចាស់ ផ្ទះ ដែល នឹង ប្រារព្ធ នៅ ខេត្ត សៀមរាប កម្ពុជា បាន រៀបចំ ឱ្យ មាន ទស្សនកិច្ច ទ្វេរ ភាគី ដែល ក្នុង ពេល តែ មួយ នេះ យើង ទទួល ដំណើរទស្សនកិច្ច ផ្លូវការ រដ្ឋមន្ត្រី ការពារ ជាតិ ប្រទេស ចំនួន ៥ ដែល មិន ធ្លាប់ មាន គឺ សហរដ្ឋ អាមេរិក . អូស្ត្រាលី . ឥណ្ឌា . កូរ៉េ ខាងត្បូង និង ចិន » ។
ជាមួយគ្នា នេះ បើ តាម នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ បន្ទាប់ពី កិច្ចប្រជុំ ចង្អៀត ក៏ មាន កិច្ចប្រជុំ ក្រៅ ផ្លូវការ ចំនួន ពីរ ដែល សម្តេច ពិជ័យ សេនា ទៀ បាញ់ នឹង ធ្វើជា សហ ប្រធាន រួម មាន កិច្ចប្រជុំ ក្រៅ ផ្លូវការ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន - សហរដ្ឋ អាមេរិក និង កិច្ចប្រជុំ ក្រៅ ផ្លូវការ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន - ឥណ្ឌា ដែល នឹង ត្រូវបាន រៀបចំ ជា បន្តបន្ទាប់ គ្នា ។
យោង តាម សេចក្ដីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការពារ ជាតិ នៅក្នុង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន - បូក សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នឹង អញ្ជើញ ជា អធិបតី ដើម្បី ថ្លែង សុន្ទរកថា គន្លឹះ ក្នុង ពិធី បើក ជា ផ្លូវការ នៃ កិច្ចប្រជុំ និង ទទួល ជួប សម្ដែង ការគួរសម រួមគ្នា ពីសំណាក់ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក និង អគ្គ លេខាធិការ អាស៊ាន ផងដែរ ។
សម្រាប់ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ រដ្ឋមន្ត្រី ការពារ ជាតិ មកពី ប្រទេស ចំនួន ៨រួម មាន៖ សហរដ្ឋ អាមេរិក . ចិន . រុស្សី . ជប៉ុន . ឥណ្ឌា . កូរ៉េ ខាងត្បូង . នូវែលស៉ីឡង់ និង អូស្ត្រាលី ៕
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ផ្តល់ កូន ត្រី ពូជ ធម្មជាតិ ចំនួន ៦៥.០០០ ក្បាល ជូន សហគមន៍ កសិករ សែន ជ័យ នៅ ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម តាមរយៈ សមាគម យុវជន ក្រុម ៨
កម្មវិធី លែង កូន ត្រី នេះ គឺជា ផ្នែក មួយ នៅក្នុង អនុវិស័យ ទាំង បី នៃ វិស័យ កសិកម្ម របស់ សហគមន៍ កសិករ សែន ជ័យ ដែល ផ្តោត ជា ចំបង ដូច ជា៖ វារី វប្បកម្ម ស្រូវ និង បន្លែ សុវត្ថិភាព ។
គម្រោង « សហគមន៍ កសិករ សែន ជ័យ » បង្កើតឡើង ក្នុង គោលបំណង ជួយ ជំរុញ វិស័យ កសិកម្ម ក្នុង ស្រុក ជើង ព្រៃ ឱ្យ កាន់តែ មាន សក្ដានុពល និង កាលានុវត្តភាព នៃ ការធ្វើ ពាណិជ្ជការ នីយកម្ម កសិកម្ម ដើម្បី ធានា បាន នូវ សន្តិសុខ ស្បៀង បង្កើន ប្រាក់ ចំណូល និង លើកស្ទួយ ជីវភាព សេដ្ឋកិច្ច គ្រួសារ ប្រជាពលរដ្ឋ ឲ្យ កាន់តែ ប្រសើ ឡើង ។
គួរ បញ្ជាក់ ថា សព្វ ថ្ងៃ ប្រទេស ថៃ ពុំ មាន រោងចក្រ ផលិត ថាមពល ដោយ ប្រើ បច្ចេកវិទ្យា នុយក្លេអ៊ែរ នោះ ទេ ។ សេតវិមាន មិន បាន ប្រាប់ ឱ្យ ច្បាស់ ឡើយ ថា នឹង ជួយ ថៃ អភិវឌ្ឍ ថាមពល នុយក្លេអ៊ែរ ឱ្យ បាន នៅ ពេលណា ឡើយ ប៉ុន្តែ បាន អះអាង ថា ខ្លួន គាំទ្រ ការកំណត់ គោលដៅ របស់ ថៃ ក្នុង ការឈានទៅ សម្រេច ឱ្យ បាន នូវ ស្ថានភាពអព្យាក្រឹត កាបូន នៅ ត្រឹម ឆ្នាំ ២០៦៥ ។ លោកស្រី ហារីស បាន បំពេញ ទស្សនកិច្ច ទៅកាន់ ប្រទេស ថៃ ដើម្បី ចូលរួម កិច្ចប្រជុំ កំពូល APEC ដែល ត្រូវ បិទ បញ្ចប់ នៅ ថ្ងៃសៅរ៍ នេះ ៕
លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុន្នី បង្ហាញ មោទកភាព កុមារី - យុវតី ដែល មាន ឱកាស ទទួល ការបណ្ដុះបណ្ដាល ចំណេះដឹង សីលធម៌ និង ចូលរួម កិច្ចការ សង្គម ទាំង ក្នុង និង ក្រៅ ប្រទេស
( កំពត ) ៖ លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុន្នី អគ្គ ស្នងការ នៃ សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា បង្ហាញ មោទនភាព កុមារី យុវតី ដែល មាន ឱកាស ទទួលបាន ការបណ្ដុះបណ្ដាល ចំណេះដឹង សីលធម៌ និង ការចូលរួម កិច្ចការ សង្គម ទាំង ក្នុង និង ក្រៅ ប្រទេស ។
លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុន្នី អគ្គ ស្នងការ នៃ សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា បាន កោតសរសើរ និង ថ្លែងអំណរគុណ ចំពោះ ថ្នាក់ដឹកនាំ សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា សាខា ខេត្ត កំពត ដែល បាន ដឹកនាំ សកម្មភាព កុមារី យុវតី ឲ្យ ទទួលបាន ការបណ្ដុះបណ្ដាល ចំណេះដឹង ជំនាញ សីលធម៌ សង្គម និង ចូលរួម សកម្មភាព សង្គម ជាច្រើន នា ពេល កន្លងមក ។
លោកស្រី អគ្គ ស្នងការ នៃ សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា បាន គាំទ្រ និង លើក លើកទឹកចិត្ត ឲ្យ ថ្នាក់ដឹកនាំ សមាគម សាខា ខេត្ត កំពត បន្ត សកម្មភាព បណ្ដុះបណ្ដាល សកម្មភាព សិល្ប: វប្បធម៌ ប្រពៃណី ទំនៀមទម្លាប់ ការងារ បរិស្ថាន និង សកម្ម សកម្មភាព សង្គម ជាច្រើន ទៀត ដើម្បី ចូលរួម អភិវឌ្ឍន៍ កុមារី យុវតី ឲ្យ កាន់តែ សកម្ម ថែម ទៀត ។
លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុន្នី បាន ថ្លែង បែប នេះ នៅក្នុង ពិធី សំណេះសំណាល ជាមួយ សមាជិកា សមាជិក គាំទ្រ សាខា ខេត្ត កំពត នៅ ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ដោយ មាន ការចូលរួម ពី លោកស្រី សហ ស្ថាបនិក លោកជំទាវ ក្រុមប្រឹក្សាភិបាល សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា សាខា ខេត្ត កំពត និង ថ្នាក់ដឹកនាំ សមាជិកា សមាជិក គាំទ្រ សមាគម ជាច្រើន រូប ៕
លោក សេរី កុសល ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ២០០០ នាក់ នៅ ឃុំ ពន្លៃ ខេត្ត បន្ទាយមានជ័យ
( បន្ទាយមានជ័យ )៖ អាជ្ញាធរ រៀបចំ ពិធី ពិសារ អាហារ សាមគ្គី និង សំណេះសំណាល ដោយ មាន ការចូលរួម ពី បងប្អូន ប្រជាពលរដ្ឋ ប្រម៉ាណ ជាង ២ពាន់ នាក់ ដែល បាន អញ្ជើញ មក ចំនួន ៦ ភូមិ ក្នុង ឃុំ ពន្លៃ ស្រុក ភ្នំស្រុក ។
ពិធី បាន ប្រព្រឹត្តទៅ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្នុង បរិវេន វត្ត តាវង ភូមិ តា វង ឃុំ ពន្លៃ ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ។
ក្រោម អធិបតីភាព លោក សេរី កុសល តំណាងរាស្ត្រ មណ្ឌល ខេត្ត បន្ទាយមានជ័យ ដោយ មាន ការអញ្ជើញ ចូលរួម គណៈប្រតិភូ អម ដំណើរ ដោយ ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក ភ្នំស្រុក បាន ចូលរួម ជាច្រើ នាក់ ផងដែរ ។
ក្រោយពី ពិធី សំណេះសំណាល ចប់ លោក តា ជី យាយ ជី ចំនួន ១៣៣ នាក់ តា ជី ទទួលបាន អាវ សរ ខោ ចែវ ១កំប្លេរ និង ថវិការ ១០០០០ រៀល យាយ ជី ទទួលបាន សារ៉ុង១ ថវិកា ១០០០០ រៀល ប្រជាពលរដ្ឋ ដែល បាន មក ចូលរួម ក្នុង ម្នាក់ ទទួលបាន សារ៉ុង ១ ។
( ស្វាយរៀង ) ៖ លោកស្រី ភឿង ស កុណា អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ពង្រឹង ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល មាន អាយុ គ្រប់ បោះឆ្នោត សូម ទៅ ចុះឈ្មោះ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា និង ត្រូវ ពិនិត្យ បញ្ជី ឈ្មោះ បោះឆ្នោត ខ្លួន ឯង ឲ្យបាន ត្រឹមត្រូវ ដើម្បី ត្រៀមលក្ខណៈ ក្នុង ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ នីតិកាល ទី៧ នា ពេល ខាងមុខ នេះ ។
ក្នុង ឱកាស ជួប សំណេះសំណាល និង ចែក ចង្ក្រាន សន្សំ សំចៃ ថាមពល ដល់ ប្រជាពលរដ្ឋ ជាង ៥០០ នាក់ នៅក្នុង ឃុំ គគី សោម ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ លោកស្រី ភឿង ស កុណា បាន លើកឡើង ថា សមាជិក បក្ស ប្រជាជន កម្ពុជា ត្រូវ ធានា ថា សមាជិក ម្នាក់ ត្រូវ មាន សម្លេង ឆ្នោត មួយ សន្លឹក តាម គោលជំហរ របស់ គណបក្ស គឺ ពង្រឹង ចាស់ ពង្រីក ថ្មី ដើម្បី ឈានយក ជោគជ័យ គ្រប់ ការបោះឆ្នោត ។
លោកស្រី ភឿង ស កុណា ថ្លែង ផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដល់ ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ គគី សោម ដែល ជានិច្ចការ សម្ដេច តែងតែ នឹករលឹក ដល់ ប្រជាពលរដ្ឋ ហើយ ទីណា មាន ទុក្ខលំបាក ទីនោះ ពិតជា មាន វត្តមាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ជានិច្ច ។
លោកស្រី បាន បង្ហាញ អំពី ភាពជោគជ័យ ក្នុង កិច្ចប្រជុំ អា កំពូល អាស៊ាន ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន . កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ដែល ធ្វើឡើង ដោយ ទម្រង់ ផ្ទាល់ ជា លើក ទី៣ នៅ កម្ពុជា ពី ថ្ងៃទី ១០ ដល់ ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ពិតជា បាន ដំណើរការ ទៅ យ៉ាង រលូន ប្រកបដោយ សន្តិសុខ សុវត្ថិភាព កិច្ចសហប្រតិបត្តិការ និង សមិទ្ធផល ផ្លែ ផ្កា ជា ប្រវត្តិសាស្ត្រ ។
ភាព ជា ម្ចាស់ ផ្ទះ ក្នុង ការរៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ជា ប្រធាន អាស៊ាន បាន ទទួល នូវ ការកោតសរសើរ និង គាំទ្រ យ៉ាង ខ្លាំង ពីសំណាក់ មេដឹកនាំ នានា នៅក្នុង តំបន់ និង លើ ពិភពលោក ។ ជោគជ័យ ដ៏ ត្រចេះ ត្រចង់ ក្នុង ការដឹកនាំ កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ទាំង នេះ ពិតជា បាន បង្កើត ជា កិត្តិយស ជាតិ មោទនភាព ជាតិ និង កិត្យានុភាព ជាតិ ដ៏ សម្បើម មួយ សម្រាប់ ប្រជាជាតិ និង ប្រជាជន កម្ពុជា ទាំងមូល ។
លោកស្រី ក៏ បាន ស្នើ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ នាំ កូន ៗ ទៅ ចូលរៀន នៅ សាលាម តេយ្យ សិក្សា ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី ពង្រឹង ធនធាន មនុស្ស ឲ្យ កាន់តែ ល្អ ប្រសើរ ពី ទីក្រុង រហូតដល់ ជនបទ ។ មាន តែ ចំណេះ វិជ្ជា ទេ ដែល ធ្វើឲ្យ ខ្លួន យើង ជា ស្ពាន ចម្លង ឲ្យ មាន អនាគត ល្អ ប្រសើរ ។
ជាមួយគ្នា នេះ លោកស្រី ភឿង ស កុណា ក៏ បាន ជំរុញ ដល់ ប្រជាពលរដ្ឋ ត្រូវ ថែរក្សា សុខភាព ឲ្យបាន ល្អ បើ ឈឺ ត្រូវតែ ទៅ មន្ទីរពេទ្យ ដើម្បី ពិនិត្យ និង ព្យាបាល ឲ្យបាន ទាន់ ពេលវេលា ជាពិសេស ស្ត្រី មាន ផ្ទៃពោះ ត្រូវ ពិនិត្យ ផ្ទៃពោះ ឲ្យបាន ទៀងទាត់ ព្រោះ កត្តា សុខភាព គឺ មាន សារៈសំខាន់ ណាស់ ក្នុង ការចូលរួមចំណែក កាត់បន្ថយ ភាពក្រីក្រ ជូន ប្រជាពលរដ្ឋ ដែល ប្រមុខ រាជ រដ្ឋាភិបាល បាន ចាត់ទុក វិស័យ សុខាភិបាល គឺជា វិស័យ អទិភាព មួយ ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ ផងដែរ ។
បន្ថែម លើស ពី នេះ លោកស្រី ភឿង ស កុណា បាន ថ្លែងអំណរគុណ ដល់ ម្ចាស់ អំណោយ ដែល បាន ផ្ដល់ ចង្ក្រាន ព្រៃ មាន់ សន្សំ សំចៃ ថាមពល ដែល មាន ទីតាំង ផលិត នៅ ខេត្ត កំពង់ឆ្នាំង ចូលរួមចំណែក ជាមួយ ប្រជាពលរដ្ឋ កម្ពុជា ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ តាមរយៈ ការប្រើប្រាស់ ចង្ក្រាន ដែល សន្សំ ចៃ ថាមពល នេះ ផងដែរ ។
សូម បញ្ជាក់ ថា លោកស្រី ភឿង ស កុណា និង ក្រុមការងារ បាន ចុះ ពិនិត្យ មណ្ឌល សុខភាព ឃុំ គគី សោម ដែល កំពុង សាងសង់ និង បាន ប្រគល់ ម៉ាស៊ីន ព្រីនធ័រ១ គ្រឿង ដល់ រដ្ឋបាល ឃុំ គគី សោម យក ទៅ ប្រើប្រាស់ ក្នុង ការបម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ព្រមទាំង ចុះ ពិនិត្យមើល សាលា មតេយ្យ ឃុំ ស្វាយ រំពារ ស្រុក ស្វាយទាប កំពុង សាងសង់ ផងដែរ ៕ លោក ហ៊ុន ម៉ានី អញ្ជើញ ប្រកាស ទទួលស្គាល់ សមាសភាព សមាជិក សមាជិកា ស.ស .យ .ក . ប្រចាំ គ្រឹះស្ថាន ឧត្តម សិក្សា ឯកជន នៅ វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល និង ទទួលស្គាល់ សមាសភាព សមាជិក សមាជិកាស .ស .យ .ក . ប្រចាំ គ្រឹះស្ថាន ឧត្តម សិក្សា ឯកជន ដែល ជា សមាជិក សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា ដែល បាន កម្មវិធី នេះ ប្រព្រឹត្តទៅ នៅ វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា ។
បន្ទាប់ពី ការធ្វើ របាយការណ៍ សង្ខេប អំពី ប្រវត្តិ និង សមិទ្ធផល សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា រួច មក លោក ហេង វ៉ាន់ ដា ប្រធាន ក្រុមប្រឹក្សា គ្រឹះស្ថាន ឧត្តម សិក្សា បាន លើកឡើង ថា ការខិតខំ ប្រឹងប្រែង របស់ ក្រុមប្រឹក្សា គ្រឹះស្ថាន ឧត្តម សិក្សា ដែល ជា ស្ថាប័ន ដ៏ មាន សក្តានុពល ក្នុង ការប្រមូលផ្តុំ យុវជន បាន ផ្តល់ ឱកាស ឲ្យ យុវជន ចូលរួម ក្នុង សកម្មភាព នានា ដោយ ចូលរួម អភិវឌ្ឍន៍ ជាតិ រក្សា អត្តសញ្ញាណ ជាតិ និង សកម្មភាព ភាពស័្ម គ្រចិត្ត ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ហ៊ុន ម៉ានី បាន កោតសរសើរ អំពី ការរីកលូតលាស់ និង អភិវឌ្ឍន៍ ជា បន្តបន្ទាប់ របស់ គ្រឹះស្ថាន ឧត្តម សិក្សា ដែល តែងតែ ចូលរួម ជាមួយ រដ្ឋាភិបាល ក្នុង ការបណ្តុះបណ្តាល ធនធាន មនុស្ស និង លើកស្ទួយ វិស័យ អប់រំ នៅ ប្រទេស កម្ពុជា ។
ទន្ទឹមនឹង នេះ លោក បាន សម្តែង នូវ សេចក្តី សោមនស្ស រីករាយ និង ស្វាគមន៍ យ៉ាង កត់ ក្តៅ ចំពោះ ប្អូន ៗ ដែល ជា សមាជិក សមាជិកា គ្រឹះស្ថាន ឧត្តម សិក្សា ឯកជន នៃ ក្រុមប្រឹក្សា យុវជន គ្រឹះស្ថាន ឧត្តម សិក្សា ដែល សម្រេចចិត្ត ចូលរួម ជាមួយ ស .ស .យ .ក . ក្នុង ការបំពេញ បេស សកម្ម ធ្វើ កិច្ចការងារ សង្គម និង កាងារ ស័្ម គ្រចិត្ត ផងដែរ ។
សមាសភាព សមាជិក សមាជិកាស .ស .យ .ក . ប្រចាំ គ្រឹះស្ថាន ឧត្តម សិក្សា ដែល ត្រូវបាន ប្រកាស បញ្ចូល នា ព្រឹក នេះ រួម មាន សាស្រ្តាចារ្យ និង និស្សិត ដែល មកពី សាកលវិទ្យាល័យ និង វិទ្យាស្ថាន ចំនួន ៣៤ សរុប ២. ៣៧៤នាក់ ។
គួរ បញ្ជាក់ ថា ដោយ ពុំ មាន អ្នក ឈ្នះ ដាច់ ពិតប្រាកដ បែប នេះ ភាព មិន ច្បាស់លាស់ ផ្នែក នយោបាយ អាចនឹង នៅតែ បន្ត ខណៈ ម៉ាឡេស៉ី ប្រឈមមុខ នឹង កំណើន សេដ្ឋកិច្ច ដ៏ យឺត ព្រមទាំង ការកើនឡើង នៃ អតិផរណា ។ តាំងពី ឆ្នាំ ២០១៨ មក ទល់ បច្ចុប្បន្ន ប្រទេស អាស៊ាន មួយ នេះ មាន នាយក រដ្ឋមន្រ្តី សរុប ៣នាក់ ។ លោក អ៉ីស្មែល បាន រំលាយ សភា ហើយ ស្នើ ឱ្យ រៀបចំ ការបោះឆ្នោត សកល មុន អាណត្តិ កាលពី ខែតុលា កន្លងទៅ ។
សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ ការចូលរួម សន្និសីទ ស្រូវ អង្ករ ពិភពលោក ឆ្នាំ ២០២២ និង ការទទួល ពានរង្វាន់ « អង្ករ ល្អ បំផុត ពិភពលោក »
( ភ្នំពេញ ) ៖ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ ការចូលរួម សន្និសីទ ស្រូវ អង្ករ ពិភពលោក ឆ្នាំ ២០២២ និង ការទទួល ពានរង្វាន់ « អង្ករ ល្អ បំផុត ពិភពលោក » ។
នៅក្នុង វេទិកា ពិភពលោក នេះ លោកស្រី គីម ស្រី រ័ត្ន បាន ធ្វើ បទ អន្តរាគមន៍ ដោយ លើក អំពី វឌ្ឍនៈភាព នៃ ការរីកចម្រើន របស់ វិស័យ ស្រូវ អង្ករ ជាពិសេស គឺ វឌ្ឍនភាព លើ ការដឹកជញ្ជូន ដែល ជា កត្តា ស្នូល នៃ ថ្លៃ ដើម សម្រាប់ ការនាំចេញ អង្ករ ដែល ក្នុង នោះ ការបើក ដំណើរការ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ក្រុង ព្រះសីហនុ ជា ការប្រសើរឡើង នៃ ការដឹកជញ្ជូន តាម ផ្លូវ ដែក ដែល ក្រុមហ៊ុន នាំចេញ អង្ករ ជាច្រើន ចាប់ផ្តើម ប្រើប្រាស់ ។
ការស្តារ ឡើងវិញ នូវ កំពង់ផែ ទាំងអស់ រួម មាន កំពង់ផែ ក្រុង ព្រះសីហនុ លើ ទី ចំណត ពហុ បំណង កំពង់ផែ ភ្នំពេញ និង កំពង់ផែ ខេត្ត កំពត ដែល កំពុង ដំណើរការ សាងសង់ និង ជា មូលដ្ឋាន យូរអង្វែង សម្រាប់ ភាពប្រកួតប្រជែង លើ ការនាំចេញ អង្ករ កម្ពុជា ទៅកាន់ ទីផ្សារ អន្តរជាតិ ។
លោកស្រី អនុប្រធាន ក៏ បាន អំពាវនាវ និង អញ្ជើញ ភ្ញៀវ ទាំងអស់ មក ទស្សនា និង ទស្សនៈកិច្ច អាជីវកម្ម រួមទាំង មក វិនិយោគ លើ វិស័យ ស្រូវ អង្ករ នៅ កម្ពុជា ផងដែរ ។
ជា លទ្ធផល អង្ករ ពូជ ស្រូវ ផ្ការ រំដួល ដែល ស្ថិត ក្រោម ម៉ាក វិញ្ញាតកម្ម « ម្លិះ អង្គរ » ត្រូវបាន ជាប់ ជា អង្ករ ល្អ បំផុត ពិភពលោក ដែល ជ្រើសរើស ចេញ ពី វត្ថុ សំណាក អង្ករ គម្រូ ចំនួន ជាង ៤០ សំណាក អង្ករ ដែល ផ្តល់ ដោយ ប្រទេស ចំនួន ៨។ ការផ្តល់ ពិន្ទុ និង ជ័យលាភី អង្ករ ល្អ បំផុត ពិភពលោក ដោយ គណៈកម្មាធិការ ជំនាញ របស់ វិទ្យាស្ថាន អន្តរជាតិ ICI របស់ សហរដ្ឋ អាមេរិក ដោយ ឈរ លើ មូលដ្ឋាន ចម្បង ដូច ជា៖
ពានរង្វាន់ អង្ករ ល្អ បំផុត ឆ្នាំ ២០២២ ជា ការទទួលបាន ជា លើក ទី៥ ដែល លើក ទី១ នៅ ឆ្នាំ ២០១២ លើក ទី២ នៅ ឆ្នាំ ២០១៣ លើក ទី៣ នៅ ឆ្នាំ ២០១៤ និង លើក ទី៤ នៅ ឆ្នាំ ២០១៨ ។ ការទទួលបាន ជ័យលាភី ដ៏ វិសេសវិសាល នះ គឺ កើត ចេញពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ បងប្អូន ប្រជាកសិក កម្ពុជា ក្នុង ការថែទាំ ដាំដុះ លើ ដែនដី ដ៏ ល្អ និង ដ៏ មាន ជីវជាតិ នៃ បឹង ទន្លេ សាប របស់ យើង ។
សូម បញ្ជាក់ ផងដែរ ថា ពូជ ស្រូវ ផ្កា រំដួល ជា ប្រភេទ ពូជ ស្រូវ វស្សា ប្រកាន់ រដូវ ដែល បាន ខិតខំ ស្រាវជ្រាវ ដោយ អ្នកវិទ្យាសាស្ត្រ ស្រូវ នៃ វិទ្យាស្ថាន ស្រាវជ្រាវ និង អភិវឌ្ឍន៍ កសិកម្ម កម្ពុជា របស់ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ តាំងពី ឆ្នាំ ១៩៩០ ហើយ បាន បញ្ចេញ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ឆ្នាំ ១៩៩៧ ដែល ជា ប្រភេទ ពូជ ស្រូវ ដែល មាន ខ្សែ ស្រឡាយ មេបា ដើម ពូជ ស្រូវ ខ្មែរ ឈ្មោះ « សូម៉ាលី - ១៧៧១ » ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៤៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១៨ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៤៨ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ១៩ ខែវិច្ឆិកា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤៨ នាក់ នោះ មាន ១៦នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្ន បទល្មើស ព្រហ្មទណ្ឌ ០៨ ករណី និង ជនសង្ស័យ ៣២ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៤ករណី ។
ជាមួយគ្នា នេះ លោក បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ អនុវត្ត នូវ ពាក្យស្លោក « ៣កុំ ១រាយការណ៍ » ដែល មាន ន័យ ថា « កុំ ពាក់ព័ន្ធ កុំ អន្តរាគមន៍ កុំ លើកលែង ក្នុង បទល្មើស នានា និង ជួយ រាយការណ៍ ពី បទល្មើស គ្រឿងញៀន និង បទល្មើស ផ្សេង ៗ ទៀត » ដែល កើតមាន នៅ មូលដ្ឋាន របស់ ខ្លួន ជូន ដល់ សមត្ថកិច្ច ៕ រដ្ឋមន្ត្រី វប្បធម៌ អបអរសាទរ ក្រុម សៀក អង្គការ ហ្វារ ពន្លឺ សិល្បៈ បំបែក ឯកទគ្គកម្ម ពិភពលោក លើ ការសម្តែង សៀក មាន រយៈពេល យូរ ជាង គេ
( ភ្នំពេញ ) ៖ លោកស្រី បណ្ឌិត សភាចារ្យ ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នៅ ថ្ងៃសៅរ៍ ទី១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ បាន ផ្ញើ សារ សម្តែង ការអបអរសាទរ ដល់ ក្រុម សៀក អង្គការ ហ្វារ ពន្លឺ សិល្បៈ ដែល បាន បំបែក ឯកទគ្គកម្ម ពិភពលោក លើ ការសម្តែង សៀក មាន រយៈពេល យូរ ជាង គេ គឺ ចំនួន ២៤ ម៉ោង ១០នាទី និង ៣០ វិនាទី ។
អង្គការ ហ្វារ ពន្លឺ សិល្បៈ បាន ឱ្យដឹង ថា ការសម្តែង សៀក របស់ ខ្លួន បាន ធ្វើឡើង នៅ ក្រុង បាត់ដំបង ដែល មាន រយៈពេល សរុប ២៤ ម៉ោង ១០នាទី ៣០វិនាទី គឺជា កិច្ច ខិតខំ ប្រឹងប្រែង ចុងក្រោយ ដើម្បី កៀរគរ ថវិកា ដើម្បី រស់រាន មាន ជីវិត ពី ជំងឺ រាតត្បាត ។
អង្គការ ហ្វាពន្លឺ សិល្បៈ ត្រូវបាន បង្កើតឡើង ដោយ ជនភៀសខ្លួន កម្ពុជា និង ជនរងគ្រោះ ពី អំពើ ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ដើម្បី ជួយ គ្រួសារ កម្ពុជា ឱ្យ ចេញ ពី ភាពក្រីក្រ និង ដើម្បី ថែរក្សា វប្បធម៌ កម្ពុជា ។
កំណត់ ត្រា ពិភពលោក « ការសម្តែង សៀក វែង បំផុត » នេះ ត្រូវបាន បញ្ចូល ទៅក្នុង បញ្ជី កំណត់ ត្រា ពិភពលោក ផ្សេង ទៀត របស់ កម្ពុជា រួម មាន ក្រមា វែង ជាង គេ បំផុត នំ អន្សម ធំ ជាង គេ បំផុត អក្ខរ ក្រម ច្រើន ជាង គេ បំផុត និង អគារ សាសនា ធំ ជា គេ បំផុត គឺ ប្រាសាទ អង្គរវត្ត ៕
ព័ត៌មាន លម្អិត សូម អាន សេចក្តីជូនដំណឹង ដូច ខាងក្រោម៖ បើកបរ កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ៣នាក់ និង របួស ៨នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៨ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ៨នាក់ ។
សម្តេច ប្រធាន ព្រឹទ្ធសភា កម្ពុជា ទទួល ជួប ប្រធាន រដ្ឋសភា វៀតណាម និង អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ចុះ MoU រវាង អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា កម្ពុជា ជាមួយ ខុទ្ទកាល័យ រដ្ឋសភា វៀតណាម
សម្តេច វិបុល សេនា ភក្តី បាន លើកឡើង ថា តាមរយៈ ដំណើរទស្សនកិច្ច របស់ លោក វឿង ឌិញ ហ្វេ នា ឱកាស នេះ ពិតជា បញ្ជាក់ ឱ្យ ឃើញ ច្បាស់ អំពី ការយកចិត្តទុកដាក់ ខ្ពស់ ដល់ ការថែរក្សា ពូន ជ្រំ ចំណង មិត្តភាព សាមគ្គីភាព និង សហប្រតិបត្តិការ រវាង ប្រទេស សភា និង ប្រជាជន ទាំង ពីរ ដែល មាន ជា យូរ លង់ មកហើយ ឱ្យ កាន់តែ រឹងមាំ ស្ថិតស្ថេរ យូរអង្វែង ។
បន្ទាប់មកពី កិច្ចពិភាក្សា ទ្វេរ ភាគី រួច មក សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ និង លោក វឿង ឌិញ ហ្វេ ប្រធាន រដ្ឋសភា វៀតណាម បាន អញ្ជើញ ជា ធិបតីភាព ក្នុង ពិធី ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា រវាង អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា កម្ពុជា ជាមួយនឹង ខុទ្ធ កាល័យ រដ្ឋសភា វៀតណាម ដែល ចុះហត្ថលេខា ដោយ លោក អ៊ុំ សារឹទ្ធ អគ្គ លេខាធិការ ព្រឹទ្ធសភា កម្ពុជា និង លោក Bui Van Cuong ខុទ្ទកាល័យ រដ្ឋសភា វៀតណាម ។
ជាមួយគ្នា នេះ លោក សាយ រួមទាំង ក្រុមការងារ បាន ថ្លែងអំណរគុណ ដល់ លោក ឧកញ៉ា ទៀ វិចិត្រ ដែល បាន បរិច្ចាគ នូវ ថវិកា ផ្ទាល់ខ្លួន ដល់ មន្ទីរពេទ្យ កុមារ អង្គរ និង ក្រុមការងារ ទាំងអស់ របស់ ផងដែរ ។ លោក សាយ និង ក្រុមការងារ បាន ចងចាំ ទុក ក្នុង ចិត្ត នា ពេលនេះ គឺ ពិតជា អនុស្សាវរីយ៍ ដល់ សប្បាយរីករាយ ទាំង បទពិសោធន៍ ថ្មី នៃ ការស្នាក់ នៅ កោះ រ៉ុង ឆ្នេរ ឋានសួគ៌ ការច្រមុជទឹក មើល ផ្កា ថ្ម ទទួលទាន គ្រឿង សមុទ្រ ឆ្ងាញ់ ៗ ពី Resort Mafiya ។
ជា ចុងក្រោយ លោក ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ដល់ ការផ្ដល់ឲ្យ នូវ បទពិសោធន៍ ថ្មី មួយ នេះ ហើយ លោក និង ក្រុមការងារ នឹង ត្រឡប់មក កម្សាន្ដ នៅ ទីនោះ ម្ដង ទៀត នៅពេល ខាងមុខ ៕
សិស្ស ១៨ វិទ្យាល័យ ក្នុង ខេត្ត កំពង់ឆ្នាំង ចូលរួម ពិធី ប្រកួត ជជែក ដេញដោល ក្រោម ប្រធានបទ « ទឹក ស្អាត អនាម័យ និង ពិធី បង្ការ រោគ » នៅ វិទ្យាស្ថាន បូលីណូ ស្រុក កំពង់ត្រឡាច
( កំពង់ឆ្នាំង ) ៖ សិស្ស មធ្យមសិក្សា ជាង ១០០ នាក់ មកពី ១៨ វិទ្យាល័យ ក្នុង ខេត្ត កំពង់ឆ្នាំង បាន មក ចូលរួម ជជែក ដេញដោល គ្នា ក្រោម វិធាន បទ « ទឹក ស្អាត អនាម័យ និង វិធី បង្ការ រោគ » ដែល ប្រព្រឹត្តទៅ កាលពី ថ្ងៃទី ១៨ ខែវិច្ឆិ កា ឆ្នាំ ២០២២ នៅ វិទ្យាស្ថាន បូលីណូ នៃ សាកលវិទ្យាល័យ អន្តរជាតិ ស្ថិត ក្នុង ភូមិ អូរ រូង ឃុំ ឈូក ស ស្រុក កំពង់ត្រឡាច ខេត្ត កំពង់ឆ្នាំង ដែល មាន សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ និង គណៈកម្មការ ចូលរួម សរុប ជិត ២០០ នាក់ ។
ក្នុង ពិធី ជជែក ដេញដោល ពាក់ព័ន្ធ នឹង ប្រធានបទ « ទឹក ស្អាត អនាម័យ និង វិធី បង្ការ រោគ » ខាងលើ នេះ សិស្សានុសិស្ស ដែល បាន មក ចូលរួមទាំង ១៨ វិទ្យាល័យ ក្នុង ខេត្ត កំពង់ឆ្នាំង ត្រូវបាន ចែកចេញ ជា ក្រុម ដែល មាន ជាង ៣០ ក្រុម ក្នុង មួយ ក្រុម មាន គ្នា ៣នាក់ និង ដោយ មាន ការរៀបចំ ជជែក ដេញដោល ជម្រុះ នៅ ចំពោះ មុខ គណៈកម្មាការ ដោយ ចម្រាញ់ យក តែ ៤ក្រុម សម្រាប់ ទទួល ពាន រង្វាន់ តែ ប៉ុណ្ណោះ ។
ក្នុង នោះ សិស្ស ដែល ទទួលបាន ជ័យលាភី លេខ ១គឺ បាន ទៅ លើ សិស្ស ដែល មកពី វិទ្យាល័យ ស្រុក កំពង់លែង លេខ ២ បាន ទៅ លើ សិស្ស វិទ្យាល័យ រលាប្អៀរ លេខ ៣ស្ទួន បាន ទៅ លើ សិស្ស មកពី វិទ្យាល័យ ទឹក ហូត និង វិទ្យាល័យ កំពង់ត្រឡាច ។ ចំណែក សិស្ស ជាប់ ចំណាត់ថ្នាក់ ជ័យលា ភីលេខ ១ ទទួលបាន ប្រាក់ លើកទឹកចិត្ត ៣លាន រៀល . លេខ ២ ទទួលបាន ប្រាក់ ២លាន រៀល . លេខ ៣ស្ទួន ទទួល បាន ប្រាក់ ១លាន រៀល ដោយឡែក សិស្ស ចំនួន ៣៣ ក្រុម ផ្សេង ទៀត ដែល ពុំ ជាប់ ចំណាត់ថ្នាក់ ក្នុង ១ ក្រុម ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ចំនួន ៦០ ម៉ឺន រៀល ផងដែរ ។
លោក ក៏ បាន បញ្ជាក់ ថា ចំពោះ វិស័យ ផ្គត់ផ្គង់ ទឹក ការសំអាត និង អនាម័យ ជនបទ រាជ រដ្ឋាភិបាល បាន កំណត់ ចក្ខុវិស័យ ថា នៅ ឆ្នាំ ២០២៥ ប្រជាពលរដ្ឋ គ្រប់ រូប នៅ សហគមន៍ ជនបទ ត្រូវ មាន សេវា ផ្គត់ផ្គង់ ទឹក ស្អាត និង អនាម័យ គ្រប់គ្រាន់ ព្រមទាំង រស់ នៅក្នុង បរិស្ថាន ដែល មាន អនាម័យ ស្អាត ប្រកបដោយ និរន្តរភាព ។ ជាមួយគ្នា នេះ រាជ រដ្ឋាភិបាល ក៏ បាន អនុម័ត ផែនការ យុទ្ធសាស្ត្រ ជាតិ ស្ដីពី ការផ្គត់ផ្គង់ ទឹក ស្អាត និង ការលើកកម្ពស់ អនាម័យ ជនបទ សម្រាប់ ឆ្នាំ ២០១៤ - ២០២៥ ផងដែរ ។
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក លន់ សុផាត អគ្គ ស្នងការ រង នគរបាល ជាតិ តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ កាលពី ល្ងាច ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ បាន បន្ត ជួប ជួប សំណេះសំណាល ជាមួយ កងកម្លាំង នាយកដ្ឋាន នគរបាល អន្តរាគមន៍ បន្ទាប់ពី បាន ចួល រួម ការពារ កិច្ចប្រជុំ អាស៊ាន កំពូល លើក ទី៤០ - ៤១ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ទទួលបាន ជោ គេ ជ័យ ។
លោក ឧត្តមសេនីយ៍ ឯក លន់ សុផាត ក៏ បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន ចំពោះ កងកម្លាំង របស់ យើង និង ក្រើន រំលឹក ឲ្យ កម្លាំង របស់ ត្រៀមលក្ខណៈ ចូលរួម ការពារ ព្រឹត្តិការណ៍ សំខាន់ ៗ បន្ត ទៀត ដែល ជាក់ស្តែង បាន ការពារ កិច្ចប្រជុំ អាស៊ាន កំពូល លើក ទី៤០ - ៤១ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ទទួលបាន ជោគជ័យ កន្លងទៅ ថ្មី ៗ នេះ ជា ស្នាដៃ ធំ ធេង ណាស់ ជាពិសេស ទទួលបាន ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ អំពី ថ្នាក់ដឹកនាំ ចំពោះ អង្គភាព ។
លោក ក៏ បាន សង្កត់ធ្ងន់ ឲ្យ កងកម្លាំង នាយកដ្ឋាន នគរបាល ការពារ ត្រៀមលក្ខណៈ ដើម្បី ចូលរួម ការពារ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត ការពារ ព្រឹត្តិការណ៍ ប្រកួត កីឡា ស៊ីហ្គេម និង ព្រឹត្តិការណ៍ ការ ផ្សេង ៗ នា ពេល ខាងមុខ ។ ដើម្បីឲ្យ កិច្ចការពារ ព្រឹត្ត ការសំខាន់ នា ពេល ខាងមុខ ទទួលបាន ជោគជ័យ លោក ស្នើឲ្យ ប្រធាន អង្គភាព ក៏ ដូចជា កងកម្លាំង ទាំងអស់ ធ្វើ ការហ្វឹកហាត់ បំប៉ន ជំនាញ ដើម្បី បង្កើន សមត្ថភាព បន្ថែម ទៀត តប តាម ផែនការ បទបញ្ជា និង ការចង្អុលបង្ហាញ របស់ ថ្នាក់ដឹកនាំ ។
ទន្ទឹម នោះ លោក ក៏ សូម ស្នើឲ្យ ប្រធាន អង្គភាព វាយតម្លៃ អំពី ស្នាដៃ របស់ នាយ នាយ រង និង មន្រ្តី របស់ ខ្លួន គោរព ជូន នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត អគ្គ ស្នងការ នគរបាល ជាតិ ដើម្បី ស្នើសុំ ប័ណ្ណ សរសើរ ឬមួយ តំឡើង ឋានន្តរស័ក្តិ តាម ជំនាញ និង បទពិសោធន៍ ដើម្បី ជា ការលើកទឹក ចំពោះ ការខិតខំ បំពេញ ភារកិច្ច បាន ល្អ នា ពេល កន្លងមក ។
លោក ឧត្តមសេនីយ៍ ឯក លន់ សុផាត បាន ក្រើន រំលឹក ដល់ ថ្នាក់ដឹកនាំ និង មន្រ្តី ទាំងអស់ នៃ នាយកដ្ឋាន ប្រុងប្រយ័ត្ន ខ្ពស់ និង បន្ត ចូលរួម ការពារ ជំងឺ កូវីដ - ១៩ ពិសេស អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត សមាជិក គណៈកម្មាធិការ អចិន្ត្រៃយ៍ គណបក្ស ប្រជាជន កម្ពុជា បាន ដឹកនាំ កិច្ចប្រជុំ គណៈ អចិន្រ្តៃយ៍ នៃ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល ជាមួយ ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន កម្ពុជា រាជធានី - ខេត្ត និង សមាជិក យុវជន គណបក្ស ថ្នាក់ កណ្ដាល ជា ប្រធាន គណបក្ស ខេត្ត ។
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង នៅ ទីស្នាក់ការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ( វិមាន ៧ មករា ) សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ដោយ មាន សមាជិក សមាជិការចូលរួម ចំនួន ៥៣ នាក់ ៕
សមាគម សម្ព័ន្ធ យុវជន មុស្លិ ម កម្ពុជា បើក កម្មវិធី អប់រំ សុខភាព មូលដ្ឋាន នៅ ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល
( កណ្តាល ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ លោក រ៉ូហ្វី អូស្មាន សមាជិក រដ្ឋសភា និង ជា អនុប្រធាន សមាគម សម្ព័ន្ធ យុវជន មុស្លិ ម កម្ពុជា . លោក លី ស៊ុគ្រី សមាជិក រដ្ឋសភា និង លោក ឌឹម បូរ៉ា អភិបាល រង ខេត្ត កណ្តាល បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក កម្មវិធី អប់រំ សុខភាព មូលដ្ឋាន និង ខតាន់ ក្មេងប្រុស ចំនួន ២០០ នាក់ នៅ ភូមិ ព្រែក តា ពៅ១ សង្កាត់ ដើម មៀន ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោកស្រី ថា ន អាស៊ីម៉ា អភិបាល រង ក្រុង តាខ្មៅ . រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ ទីប្រឹក្សា រាជ រដ្ឋាភិបាល យុវជន CMYA និង អាជ្ញាធរ មូលដ្ឋាន ជាច្រើន រូប ទៀត ។
ក្នុង ឱកាស នោះ លោក រ៉ហ្វី អូស្មាន បាន នាំ សេចក្តីនឹករលឹក និង សាកសួរ សុខទុក្ខ ពី សំណាក លោក បណ្ឌិត អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ជា ទីនឹករលឹក ផងដែរ ។
លោក បាន បន្ត ថា យើង ទាំងអស់ គ្នា ទទួលបាន សិទ្ធិ ពេញលេញ ក្នុង ការរស់នៅ ប្រកបដោយ សន្តិភាព សុខដុមនីយកម្ម ជាតិ សាសន៍ និង ការអភិវឌ្ឍ ដូច សព្វ ថ្ងៃ នេះ ដោយសារ ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ។ លោក បាន បន្ត ទៀត ថា ដោយ មាន ការដឹកនាំ ដ៏ ត្រឹមត្រូវ និង ប្រកបដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា មាន ការរីកចម្រើន លើ វិស័យ ដូចជា វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ សាលារៀន មន្ទីរពេទ្យ និង វិស័យ ផ្សេង ៗ ជាច្រើន ទៀត ។
ជាពិសេស ទៀត នោះ សម្ដេច តេជោ ហ៊ុន សែន បាន ប្រឹងប្រែង ជា ទីបំផុត ដើម្បី ធ្វើឲ្យ ប្រទេស កម្ពុជា រួចផុត ពី ជំងឺ កូវីដ១៩ ដែល រីករាលដាល ទូទាំង សាកលលោក ដោយ សម្ដេច បាន ស្វះស្វែងរក មធ្យោបាយ ដើម្បី ទទួលបាន វ៉ាក់សាំង សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។ កត្តា ទាំងនេះ ហើយ ទើប ធ្វើឲ្យ ប្រទេស កម្ពុជា ជាប់ ចំណាត់ថ្នាក់ លេខ ២ ទូទាំង ពិភពលោក ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីត១៩ ។
លោក ក៏ បាន លើក ពី ភាពជោគជ័យ របស់ កម្ពុជា ដ៏ ត្រចះត្រចង់ ក្នុង ការដឹកនាំ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ - ៤១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នា ពេល កន្លងទៅ ថ្មី ៗ នេះ ដែល ទទួលបាន ការកោតសរសើរ ពី អន្តរជាតិ ។ ជាមួយគ្នា នោះ លោក រ៉ូហ្វី អូស្មាន សូម គោរព ជូនពរ ដល់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា សូមឲ្យ មាន សុខភាព ល្អ បរិបូរណ៍ អាយុ យឺន យូរ និង ទទួលបាន ជោគជ័យ គ្រប់ ភារកិច្ច ដើម្បី បន្ត ដឹកនាំ និង តម្រង់ ទិស កម្ពុជា ឲ្យកាន់តែ មាន ភាពជឿនលឿន ។
( ភ្នំពេញ ) ៖ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ គណៈកម្មការ ទន្លេ មេគង្គ ហៅ កាត់ ថា MRC នឹង រៀបចំ វេទិកា ជាមួយ ភាគី ពាក់ព័ន្ធ ប្រចាំ តំបន់ លើក ទី ១៣ ដើម្បី ផ្តល់ ព័ត៌មាន បច្ចុប្បន្នភាព ពី គម្រោង ទំនប់ វារី អគ្គិសនី តាម ដងទន្លេ ធំ បំផុត ប្រចាំ តំបន់ អាស៊ី អាគ្នេយ៍ និង បង្ហាញ ជាពិសេស ពី កិច្ចសហប្រតិបត្តិការ ដ៏ ស៊ីជម្រៅ ជាមួយ សកម្មជន តំណាង ឱ្យ ប្រយោជន៍ នៃ ក្រុមគ្រួសារ នេសាទ និង កសិករ រាប់ លាន នាក់ ក្នុង តំបន់ ទន្លេ មេគង្គ ។
បណ្ឌិត ខិធិ ឃួន ថ្លែង ថា « អ្នក មិន អាច ធ្វើ អ្វី មួយ ឲ្យបាន ល្អ ប្រសើរ តែ ម្នាក់ឯង បាន ទេ ប៉ុន្តែ យើង អាច ប្រសិនបើ យើង ធ្វើ រួមគ្នា ។ ទន្លេ មេគង្គ ជា កម្មសិទ្ធ របស់ ពលរដ្ឋ គ្រប់ គ្នា ដូច្នេះ យើង មាន ទំនួល ខុសត្រូវ រួម មិន ត្រឹមតែ លើ ការអភិវឌ្ឍ ទន្លេ នេះ ទេ ប៉ុន្តែ ថែមទាំង គាំពារ វា ទៀតផង » ។
ក្រៅពី មន្ត្រី MRC និង តំណាង រដ្ឋាភិបាល ដែល នឹង ចូលរួម វេទិកា លើក ទី ១៣ នេះ អ្នកចូលរួម ផ្សេង ទៀត រួម មាន អ្នក អភិវឌ្ឍន៍ គម្រោង ទំនប់ វារី អគ្គិសនី ដៃគូ អន្តរជាតិ អ្នកស្រាវជ្រាវ សកម្មជន មិន មែន រដ្ឋាភិបាល និង តំណាង សហគមន៍ តាម ដងទន្លេ មេគង្គ ។
បណ្ឌិត ខិធិ ឃួន បន្ត ទៀត ថា « ខ្ញុំ រីករាយ នឹង បង្កើត ឲ្យបាន កាន់តែ ច្រើន នូវ លំហ សម្រាប់ ការចូលរួម កាន់តែ ស៊ីជម្រៅ ។ យើង ទទួលស្គាល់ ពី តម្រូវការ ក្នុង ការកសាង ភាពជឿជាក់ និង ទំនុកចិត្ត ព្រោះថា អ្នក មិន អាច ធ្វើ ការរួមគ្នា ដោយ គ្មាន ទំនុកចិត្ត និង ការយល់ដឹង ពី បញ្ហា ប្រឈម នានា ដែល ភាគី នីមួយ ៗ ជួបប្រទះ នោះ ទេ ។ ដូច្នេះ យើង ត្រូវ ធ្វើ ការរួមគ្នា ស្វែងរក ដំណោះស្រាយ សម្រាប់ បញ្ហា ប្រឈម ទាំង នេះ ដើម្បី ទន្លេ តែ មួយ គត់ របស់ យើង » ។
តប តាម ការអញ្ជើញ របស់ សម្តេច ប្រធាន រដ្ឋសភា លោក វឿង ឌីញ ហ្វេ បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ រដ្ឋសភា វៀតណាម មក បំពេញ ទស្សនកិច្ច ជា ផ្លូវការ និង មិត្តភាព នៅ ព្រះរាជាណាចក្រ កម្ពុជា ពី ថ្ងៃទី ១៩ ដល់ ថ្ងៃទី ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។ បន្ទាប់មក លោក នឹង អញ្ជើញ ចូលរួម មហាសន្និបាត អន្តរសភា អាស៊ាន (AIPA) លើក ទី ៤៣ ដែល រដ្ឋ សភា កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ បន្ត ទៀត ។
រដ្ឋសភា កម្ពុជា បាន រៀបចំ ទទួល បដិសណ្ឋារកិច្ច ជា ផ្លូវការ ចំពោះ គណៈប្រតិភូ ជាន់ ខ្ពស់ រដ្ឋសភា វៀតណាម ដឹកនាំ ដោយ លោក វឿង ឌីញ ហ្វេ នា ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នៅ វិមាន រដ្ឋសភា មុន ពេល ដែល ថ្នាក់ដឹកនាំ រដ្ឋសភា ប្រទេស ទាំង ពីរ បាន ជួប ពិភាក្សា ការងារ ទ្វេ ភាគី ។
សម្តេច ប្រធាន រដ្ឋសភា បាន លើកឡើង បន្ថែម ថា រដ្ឋសភា កម្ពុជា ពេញចិត្ត និង គាំទ្រ ចំពោះ វឌ្ឍនភាព នៃ កិច្ចសហប្រតិបត្តិការ រវាង រដ្ឋាភិបាល នៃ ប្រទេស ទាំង ពីរ នា ពេល កន្លងមក ។
លោក វឿង ឌីញ ហ្វេ បាន សម្តែង ក្តីរីករាយ យ៉ាង ក្រៃលែង ចំពោះ ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ប្រទេស ទាំង ពីរ ពិសេស រដ្ឋសភា ប្រទេស ទាំង ពីរ មាន ការរីកចម្រើន ជាលំដាប់ ទាំង នៅក្នុង កម្រិត ទ្វេ ភាគី និង អន្តរជាតិ ។
លោក បាន ស្នើ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ជួយ ជំរុញ និង បង្ក លក្ខណៈ កាន់តែ ងាយស្រួល នៅក្នុង លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ នេះ ឱ្យ បាន នៅ គ្រប់ កម្រិត ទាំង កម្រិត ថ្នាក់ដឹកនាំ គណៈកម្មការ សមាជិក សភា ស្រ្តី សមាជិក សភា វ័យ ក្មេង និង កម្រិត មន្រ្តី បច្ចេកទេស ។
លោក វឿង ឌីញ ហ្វេ បាន ជូន ពរ ដល់ រដ្ឋសភា កម្ពុជា រៀបចំ មហាសន្និបាត AIPA លើក ទី ៤៣ ទទួលបាន ជោគជ័យ ។ ជាមួយគ្នា នេះ លោក ក៏ បាន អបអរសាទរ ចំពោះ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ទទួលបាន ជោគជ័យ យ៉ាង ត្រចះត្រចង់ ដែល ធ្វើឱ្យ កិត្យានុភាព និង តួនាទី របស់ កម្ពុជា នៅលើ ឆាក អន្តរជាតិ កាន់តែ សំខាន់ ឡើង ។
សូម ជម្រាប ថា ដំណើ ទស្សនកិច្ច របស់ លោក វឿង ឌីញ ហ្វេ នៅ កម្ពុជា នា ពេលនេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ រដ្ឋសភា កម្ពុជា បំពេញ ទស្សនកិច្ច ជា ផ្លូវការ នៅ សាធារណរដ្ឋ សង្គម និយម វៀតណាម កាលពី ខែកញ្ញា កន្លងមក នេះ ៕
ការអំពាវនាវ បែប នេះ របស់ លោក នេត្រ ភក្ត្រា បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្រោយពី មន្ត្រី នៃ មន្ទីរ បរិស្ថាន ខេត្ត កំពត បាន ទប់ស្កាត់ បាន សម្រេច លើ ក្រុម ជន ខិលខូច បង្កើត ទំព័រ ហ្វេសប៊ុក និង បាន ដាក់ ផ្ទៃដី នៃ ឧទ្យាន ជាតិ ព្រះមុនីវង្ស បូក គោ ក្នុង តំបន់ អន្លង់ ក្មេង លេង ស្ថិត ក្នុង ភូមិសាស្ត្រ ឃុំ តេជោ អភិវឌ្ឍន៍ ស្រុក ឈូក ខេត្ត កំពត លក់ លើ បណ្តាញ ទំនាក់ទំនង សង្គម ហ្វេសប៊ុក ។
រដ្ឋលេខាធិការ និង ជា មន្ត្រី នាំ ពាក្យ នៃ ក្រសួង បរិស្ថាន បាន គូសបញ្ជាក់ ថា ផ្ទៃដី ដែល មាន ទំហំ ១. ៨០០ ហិកតា ដែល ជន ខិលខូច រៀបចំ ផែនទី ដាក់ លក់ នោះ ជា ផ្ទៃដី ព្រៃ ស្ថិត ក្នុង ឧទ្យាន ជាតិ ព្រះមុនីវង្ស បូកគោ ។
លោក បាន ថ្លែង ថា ផ្ទៃដី មួយចំនួន ត្រូវបាន ជន ទុច្ចរិត លួច ចូល ឈូសឆាយ ទន្ទ្រាន កាន់កាប់ ដោយ ខុស ច្បាប់ ដើម្បី លក់ដូរ ហើយ ត្រូវបាន កសាង សំណុំរឿង នៅ តុលាការ ដើម្បី ចាត់ការ តាម ផ្លូវ ច្បាប់ រួចរាល់ ហើយ ដែរ ។
មន្ត្រី នៃ មន្ទីរ បរិស្ថាន ខេត្ត កំពត បាន បន្ត ថា ជាមួយ ភស្តុតាង និង សាក្សី ថ្មី នេះ មន្ទីរ បរិស្ថាន ខេត្ត កំពត នឹង រៀបចំ សំណុំ ឯកសារ ភស្តុតាង បន្ថែម ដាក់ ជូន ទៅ តុលាការ ដើម្បី បន្ត នីតិវិធី ច្បាប់ ដើម្បី ចាត់ការលើ ជន ទុច្ចរិត រួម នឹង បក្ខពួក នៅ ពីក្រោយ ដែល ឃុបឃិត គ្នា ចូល រុករាន ទន្ទ្រាន ដី ព្រៃ រដ្ឋ ដោយ ខុស ច្បាប់ ។
ទាក់ទង នឹង បញ្ហា នេះ លោក នេត្រ ភក្ត្រា បាន បន្ត ថា មន្ត្រី នៃ មន្ទីរ បរិស្ថាន ខេត្ត កំពត បាន និង កំពុង សហការ ជាមួយ ភាគី ពាក់ព័ន្ធ ដើម្បី បន្ត ដាក់ ភស្តុតាង បន្ថែម លើ សំណុំរឿង និង បាន អំពាវនាវ ដល់ ពលរដ្ឋ ដែល បាន ចាញ់បោក ក្រុម ជន ខិលខូច ទិញ ដី នៅ តំបន់ នោះ ត្រូវ ទាមទារ លុយ របស់ ខ្លួន មកវិញ ព្រោះ ទីតាំង នោះ ជា ដី របស់ ឧទ្យាន ជាតិ បូក គោ ដែល ត្រូវ ការពារ និង អភិរក្ស ។
លោក នេត្រ ភក្ត្រា បាន រំឭក ឡើង ថា មាន ប្រជាពក រដ្ឋ ជាច្រើន បន្ត ការចាញ់បោក ក្រុម ជន ខិលខូច ដែល លក់ ដី ខ្យល់ គ្មាន ដី ពិត ប្រាកដ និង គ្មាន ការកាន់កាប់ ស្រប ច្បាប់ ។ ក្រុម ជន ខិលខូច មួយ ចំនួន បាន ដើរ ចង្អុល ដី ព្រៃ ដើម្បី លក់ និង ខ្លះ ទៀត បង្កើត ឯកសារ ក្លែងក្លាយ ដើម្បី យក ដី ព្រៃ របស់ រដ្ឋ ដោយ ប្រឌិត ថា ជា ដី ដែល ប្រជាពលរដ្ឋ បាន កាន់កាប់ អាស្រ័យ ផល ជា យូរ មក ហើយ ដើម្បី ស្នើសុំ កាត់ ឆ្វៀល ។
លោក ក៏ បាន លើកឡើង ផង ដែរ ថា ក្រុម ជន ខិលខូច មួយចំនួន បនន ត យុទ្ធសាស្ត្រ ឈ្នះ បាន ដី ចាញ់ បាន លុយ ក្នុង ជម្លោះ ដណ្តើម ដី រដ្ឋ និង មាន ក្រុម ជន ខិលខូច ខ្លះ បាន ជួល ប្រជាពលរដ្ឋ ដើម្បី តវ៉ា និង ទាមទារ ដី ជាមួយ អាជ្ញាធរ ពេល ចុះ អនុវត្ត ច្បាប់ ។
លោក រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន គូសបញ្ជាក់ ថា សូម កុំ ជឿលើ ជន ខិលខូច ដែល អះអាង ថា ទិញ ដី រដ្ឋ ហើយ អាច ធ្វើ ប្លង់ រឹង ជា កម្មសិទ្ធិ បាន នោះ នេះ គឺជា ការបោកប្រាស់ សុទ្ធសាធ ។
លោក នេត្រ ភក្ត្រា បាន បន្ថែម ថា កាល ដែល បងប្អូន ប្រជាពលរដ្ឋ មួយចំនួន បន្ត ចាញ់បោក មេខ្យល់ ក្នុង ការទិញ លក់ដូរ ដី ខុស ច្បាប់ ន នឹង ត្រូវ ប្រឈមមុខ នឹង បញ្ហា ២ គឺ ទី ១៖ ការខាតបង់ ប្រាក់ និង ទ្រព សម្បត្តិ របស់ ខ្លួន និង ទី២៖ ប្រឈមមុខ នឹង ច្បាប់ ជាមួយនឹង ជនល្មើស ដោយសារតែ ការរុករាន ទន្ទ្រាន កាន់កាប់ ដី ព្រៃ រដ្ឋ និង ទិញ លក់ដូរ ដី ព្រៃ រដ្ឋ ជា ទង្វើ ខុស ច្បាប់ ៕
( កណ្ដាល ) ៖ លោក លឹម គាន ហោ ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក ពញា ឮ ខេត្ត កណ្ដាល បាន ប្រាប់ ក្រុមការងារ ទាំងអស់ ត្រូវ បន្ត ធ្វើ សកម្មភាព ឥត ថមថយ ប្រកបដោយ ប្រសិទ្ធភាព ទាំង ក្នុង ការអនុវត្ត កម្មវិធី នយោបាយ ទាំង ក្នុង ការកសាង ពង្រឹង គណបក្ស ទាំង ការផ្សាភ្ជាប់ បម្រើ ប្រជាជន ហើយ បន្ត ដោះស្រាយ និង ព្យាយាម លុបបំបាត់ កាត់បន្ថយ ភាពអសកម្ម ដែល ធ្វើឲ្យ ប្រជាពលរដ្ឋ មាន ការថ្នាំង ថ្នាក់ ។
ក្នុង កិច្ចប្រជុំ ផ្សព្វផ្សាយ សេចក្តីសម្រេច ស្តីពី ផែនការរួម ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ ឆ្នាំ ២០២៣ នា ស្នាក់ការ គណបក្ស ស្រុក ពញា ឮ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ លោក លឹម គាន ហោ បាន ណែនាំឲ្យ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ បំផុត ចំពោះ ការរក្សា កម្លាំង ចាស់ និង ពង្រីក កម្លាំង ថ្មី ឈាម ថ្មី ដែល គ្រប់ អាយុ បោះឆ្នោត ដើម្បី ធានា បាន មូលដ្ឋាន ដ៏ រឹងមាំ សម្រាប់ ជ័យជម្នះ របស់ គណបក្ស ប្រជាជន ។
លោក បាន បន្ដ ទៀត ថា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការដោះស្រាយ និង ទប់ស្កាត់ បាន ទាន់ ពេលវេលា ការ រីករាលដាល នៃ ជំងឺ កូវីត១៩ និង ពេល ថ្មី ៗ នេះ ទទួលបាន ជោគជ័យ យ៉ាង ត្រចះត្រចង់ ក្នុង ការរៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ៕
ក្នុង កិច្ចពិភាក្សា នេះ ម្ចាស់ រោង ម៉ាស៊ីន កិន ស្រូវ បាន ធ្វើ បច្ចុប្បន្នភាព នៃ ស្ថានភាពប្រមូល ទិញ ស្រូវ និង តម្លៃ ស្រូវ នៅ តាម តំបន់ គោលដៅ និង ម្ចាស់ ក្រុម នាំចេញ អង្ករ បាន ធ្វើ បច្ចុប្បន្នភាព នៃ ទីផ្សារ អង្ករ អន្តរជាតិ និង ការបញ្ជាទិញ ពី ប្រទេស ចិន និង សហភាព អឺរ៉ុប ជាដើម ។
បណ្ឌិត កៅ ថា ច បាន ស្នើ ឱ្យ បណ្តា រោង ម៉ាស៊ីន កិន ស្រូវ និង ក្រុមហ៊ុន នាំចេញ អង្ករ បន្ត ជួយ ទិញ ស្រូវ ប្រជាកសិករ ក្នុង តម្លៃ សមរម្យ និង ជុំ រុញ ការនាំចេញ អង្ករ កម្ពុជា ព្រមទាំង កំណត់ នូវ តំបន់ នៃ ការប្រមូល ទិញ ស្រូវ ពី ប្រជាកសិករ ។
សូម ជម្រាប ថា ប៉ុន្មាន ថ្ងៃ មុន នេះ ប្រជាកសិករ នៅ ខេត្ត បាត់ដំបង និង បន្ទាយមានជ័យ បាន ជួប បញ្ហា ស្រូវ ផ្កា រំដួល ធ្លាក់ ថ្លៃ តែ ពេលនេះ ដោយសារ មាន ការ ពី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ជាមួយ រោង ម៉ាស៊ីន កិន ស្រូវ បញ្ហា ថ្លៃ ស្រូវ នេះ ត្រូវបាន ដោះស្រាយ ។
រោង ម៉ាស៊ីន កិន ស្រូវ បៃតង របស់ ឧកញ៉ា ភូ ពុយ បាន ស្ម គ្រចិត្ត ចូលរួម សហការ ជាមួយ រាជ រដ្ឋាភិបាល ដោយ ក្នុង ការដាក់ចេញ នូវ គោលការណ៍ រក្សា ស្ថេរភាព ថ្លៃ ស្រូវ ដោយ បាន កំណត់ នូវ ថ្លៃ ធានា ទិញ គោល សម្រាប់ ស្រូវ ផ្កា រំដួល ប្រភេទ លេខ ១ មិន ឱ្យ ក្រោម ៩បាត / គីឡូក្រាម ឬ ១០៤០ រៀល / គីឡូក្រាម នោះ ទេ ៕
អាថ៌កំបាំង ក្រៅ ឆាក ពី កិច្ចប្រជុំ G20: រដ្ឋមន្ត្រី សាធារណការ ឥណ្ឌូនេស៊ី ក្លាយជា អ្នកថតរូប ដ៏ ស្វិតស្វាញ មួយ រូប នៅឯ កិច្ចប្រជុំ G20 ទោះ ត្រូវ គេ ដេញ ឬ ឱ្យ ថត ឆ្ងាយ ពី មេដឹកនាំ ក្តី
( ភ្នំពេញ ) ៖ លោក ពុយ គា អ្នកយកព័ត៌មាន ទីភ្នាក់ងារ ព័ត៌មាន ក្យូដូ របស់ ជប៉ុន និង ជា អ្នក តែង តាមដាន រឿង ក្រៅ ឆាក ក្នុង កិច្ចប្រជុំ អាស៊ាន នៅ ពេល ថ្មី ៗ នេះ លោក ក៏ បាន ចូលរួម កិច្ចប្រជុំ កំពូល G20 ដែល រៀបចំឡើង នៅ កោះ បាលី ប្រទេស ឥណ្ឌូនេស៊ី ផងដែរ ។ ក្នុង កិច្ចប្រជុំ នេះ លោក ពុយ គា ក៏ បន្ត តាម ប្រមាញ់ ព្រឹត្តិការណ៍ នានា ដែល កើតឡើង នៅ ក្រៅ ឆាក នៃ វេទិកា នោះ ផងដែរ ។
ក្នុង ចំណោម រឿង ក្រៅ ឆាក ជាច្រើន នៅក្នុង វេទិកា នោះ លោក ពុយ គា ក៏ បាន ចាប់អារម្មណ៍ នឹង រឿង រដ្ឋមន្ត្រី សាធារណការ ឥណ្ឌូនេស៊ី ក្លាយជា អ្នកថតរូប ដ៏ ស្វិតស្វាញ មួយ រូប នៅក្នុង កិច្ចប្រជុំ G20 ទោះជា ត្រូវ គេ ដេញ ឬ ឱ្យ ថត ឆ្ងាយ ពី មេដឹកនាំក្តី ។
ខាងក្រោម នេះ គឺ សំណេរ ដើម ទាំងស្រុង ដែល ត្រូវបាន គូស រំលេច ដោយ លោក ពុយ គា៖
លោក រដ្ឋមន្ត្រី បាន ស្លៀកពាក់ ដូច អ្នក ថត រូប ដទៃ ទៀត ដែរ រួមទាំង ស្ទីល ពាក់ មួក បញ្រ្ចាស ទៅ ក្រោយ ហើយ មាន មនុស្ស តិច ណាស់ បាន ដឹង លើកលែង តែ ជនជាតិ ឥណ្ឌូនេស៊ី មួយចំនួន ដែល តាមដាន ព័ត៌មាន ប៉ុណ្ណោះ ។
កាលពី ដើម ខែសីហា ក្នុង ឆ្នាំ នេះ ក្រោយពី កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន ចប់ ដោយ ជោគជ័យ លោក ប្រាក់ សុខុន ដែល មាន ឋានៈ ជា ឧប នាយក រដ្ឋមន្រ្តី ផង នោះ បាន រៀបចំ ពិធី ជប់លៀង មួយ ហើយក៏ ដើម្បី រំលឹក ខួប ៥៥ ឆ្នាំ ថ្ងៃ កំណើត អាស៊ាន ផង បាន ឡើង លើ វេទិកា « ទាញ ហ្គីតាមក ដេញ ហើយ ច្រៀង យ៉ាង ឡូយ » ធ្វើឱ្យ អ្នកចូលរួម ទះដៃ និង រំភើប ជំនួស ។
នៅ ថ្ងៃ បន្តបន្ទាប់ ទៀត សម្តេច តេជោ ហ៊ុន សែន នឹង អញ្ជើញ ជា អធិបតី ក្នុង កម្មវិធី មួយចំនួន ទៀត រួម មាន៖ ថ្លែង សុន្ទរកថា គន្លឹះ បើក មហាសន្និបាត អន្តរសភា អាស៊ាន លើក ទី៤៣ . ពិធី បើក ព្រឹត្តិការណ៍ កីឡា ជាតិ លើក ទី៣. បិទ សន្និបាត ខួប៣០ ឆ្នាំ វិស័យ សកម្មភាព មីន មនុស្សធម៌ . បើក កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន ... ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ផ្អាក ជំនួប ការងារ និង អញ្ជើញ ជា អធិបតី ក្នុង កម្មវិធី ផ្សេង ៗ អស់ រយៈពេល ប្រមាណ ៥ ថ្ងៃ ហើយ បន្ទាប់ពី រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ កាលពី ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ពេល អញ្ជើញ ទៅ ចូលរួម កិច្ចប្រជុំ កំពូល G20 នៅ កោះ បាលី ប្រទេស ឥណ្ឌូនេស៊ី ។
ការរកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ ពី សំណាក មន្ត្រី សុខាភិបាល ឥណ្ឌូនេស៊ី បាន ធ្វើឱ្យ សម្តេច តេជោ ហ៊ុន សែន ខកខាន ការអញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល G20 និង កិច្ចសន្ទនា ក្រៅ ផ្លូវការ APEC នៅ ក្រុង បាងកក ប្រទេស ថៃ ដែល ជា កិច្ចប្រជុំ ដ៏ មាន សារៈសំខាន់ ។ ជាពិសេស បាន ធ្វើឱ្យ សម្តេច តេជោ ខកខាន ជំនួប ពិភាក្សា ការងារ ជាមួយ ប្រធានាធិបតី ចិន និង ប្រធានាធិបតី បារាំង ផងដែរ ។
ចាប់តាំងពី ពេល រកឃើញ វិជ្ជមាន កូវិដ១៩ នោះ មក សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា សុខភាព របស់ សម្តេច គឺ ល្អ ជាធម្មតា មិន មាន បញ្ហា អ្វី ដែល ជា សញ្ញា បង្កឡើង ដោយ មេរោគ នោះ ឡើយ ៕
ថ្ងៃ នេះ ជា ថ្ងៃទី ៣១ នៃ ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ សូម ប្រជាពលរដ្ឋ អញ្ជើញ ទៅ ពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ !
( វ៉ាស៊ីនតោន ) ៖ ជោគជ័យ ជា បន្តបន្ទាប់ នៅក្នុង « ប្រតិបត្តិការ វាយលុក ដណ្ដើម យក ទឹកដី មកវិញ » ប្រឆាំង នឹង កងទ័ព រុស្ស៉ី បាន និង កំពុង ជំរុញ ឱ្យ មាន ការសន្និដ្ឋាន មួយចំនួន ថា កងទ័ព អ៊ុយក្រែន អាច បន្ត ដំណើរ ទៅ មុខ ដើម្បី វាយ ដណ្ដើម យក « តំបន់ គ្រី មៀ » មកវិញ ។ ក៏ប៉ុន្តែ ក្រុម អ្នកជំនាញ ជាច្រើន យល់ស្រប ដូចគ្នា ថា ប្រតិបត្តិការ វាយលុក លើ តំបន់ គ្រី មៀ នឹង ត្រូវ ជួប ផលលំបាក ជាង ការវាយណ្ដើម យក ទីក្រុង ខា កៀវ និង ទីក្រុង ខឺ សុន ឆ្ងាយ ណាស់ ។
នៅលើ ទំនាក់ទំនង ចិន - ប្រ៊ុយណេ លោក ស៊ី បាន និយាយ ថា ប្រទេស ទាំង ពីរ គឺជា អ្នកជិតខាង ដ៏ ជិតស្និទ្ធ មិត្ត ដ៏ គួរឱ្យ ទុកចិត្ត និង ជា ដៃគូ នៃ ការអភិវឌ្ឍន៍ រួម ដែល បាន ធ្វើជា គំរូ នៃ ការរួមរស់ ជាមួយគ្នា ប្រកបដោយ សុខដុមរមនា ៕
អ្នកនាំពាក្យ៖ ចិន អំពាវនាវ ឲ្យ មាន ដំណោះស្រាយ នយោបាយ នៃ បញ្ហា ឧបទ្វីប កូរ៉េ
( ប៉េកាំង ) ៖ អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន បាន និយាយ នៅ ថ្ងៃសុក្រ ថា ប្រទេស ចិន សង្ឃឹម ថា គ្រប់ ភាគី នៃ បញ្ហា ឧបទ្វីប កូរ៉េ នឹង បន្ត ប្តេជ្ញា ស្វែងរក ដំណោះស្រាយ នយោបាយ និង ដោះស្រាយ កង្វល់ របស់ គ្នា ទៅ វិញ ទៅ មក ក្នុង មធ្យោបាយ ប្រកបដោយ តុល្យភាព តាមរយៈ ការសន្ទនា ប្រកបដោយ អត្ថន័យ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃសុក្រ ទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
អ្នកនាំពាក្យ លោក Mao Ning បាន ធ្វើការកត់សម្គាល់ បែប នេះ នៅក្នុង សន្និសីទ សារព័ត៌មាន មួយ នៅ ពេល ដែល ត្រូវបាន ស្នើសុំ ឱ្យ ធ្វើ អត្ថាធិប្បាយ លើ របាយការណ៍ ដែល ថា កូរ៉េ ខាងជើង នៅ ថ្ងៃសុក្រ នេះ បាន បាញ់ សាកល្បង មីស៊ីល បាលិស្ទី គ មួយ គ្រាប់ ទៀត ដែល នេះ ជា ការបាញ់ តេស្ដ លើក ទី២ នៅក្នុង រយៈពេល ២ ថ្ងៃ នៅ ចំពោះមុខ ការព្រួយបារម្ភ កាន់តែ ខ្លាំង ថា ទីក្រុង ព្យុងយ៉ាង អាច ធ្វើ អាវុធ អាវុធ នុយក្លេអ៊ែរ ឡើងវិញ ឆាប់ ៗ នេះ ៕ មនុស្ស ១១នាក់ បាន ស្លាប់ នៅក្នុង ហេតុការណ៍ ផ្ទុះ ធុង ហ្គាស នៅ អ៊ីរ៉ាក់
( អ៊ីរ៉ាក់ ) ៖ មន្ត្រី អាជ្ញាធរ ខេត្ត បាន ឲ្យដឹង នៅ ថ្ងៃសុក្រ នេះ ថា មនុស្ស រហូតដល់ ១១នាក់ បាន ស្លាប់ និង ១៣ នាក់ ផ្សេង ទៀត បាន រងរបួស នៅក្នុង ហេតុការណ៍ ផ្ទុះ ធុង ហ្គាស កាលពី ថ្ងៃព្រហស្បតិ៍ នៅក្នុង តំបន់ ពាក់កណ្តាល ស្វយ័ត Kurdistan របស់ ប្រទេស អ៊ីរ៉ាក់ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសុក្រ ទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
លោក បាន និយាយ ថា ក្រុម អ្នក ជួយសង្គ្រោះ កំពុង បន្ត ស្វែងរក អ្នក បាត់ខ្លួន ចំនួន បួន នាក់ ផ្សេង ទៀត ដែល ត្រូវបាន គេ ជឿ ថា ត្រូវបាន កប់ នៅក្រោម គំនរ បាក់បែក នៃ អគារ បី ជាន់ ដែល ដួលរលំ ដោយសារ ការផ្ទុះ នេះ ។
អភិបាល ខេត្ត កំពង់ចាម ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ សម្រាប់ សាងសង់ ដង ទង់ មួយ គូ នៅ វត្តភ្នំ ព្រះវិហារ
( កំពង់ចាម ) ៖ ឆ្លើយតប ទៅនឹង ការនិមន្ត បិណ្ឌ បាត របស់ ព្រះគ្រូ ចៅអធិការ ក៏ ដូចជា គណៈកម្មការ អាចារ្យ វត្តភ្នំ ព្រះវិហារ ដើម្បី សាងសង់ ដង ទង់ មួយ គូ នៅ ព្រឹក ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ លោក ផេន សុផល អភិបាល ស្រុក បាធាយ និង សហការី បាន នាំយក ថវិកា ចំនួន ១ម៉ឺន ដុល្លារ ដែល ជា ថវិកា ផ្ទាល់ របស់ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង លោកស្រី ទៅ ប្រគេន ព្រះចៅ អធិការ វត្តភ្នំ ព្រះវិហារ ស្ថិត ក្នុង ភូមិ បឹងវែង ឃុំ តាំង ក្រសាំង ស្រុក បាធាយ ។
បច្ចុប្បន្ន សកលលោក បាន ឈរ លើ មាត់ ផ្លូវ បំបែក នៃ ប្រវត្តិសាស្ត្រ ម្តង ទៀត ឋានៈ នៃ អាស៊ី ប៉ាស៊ីហ្វិក កាន់តែ សំខាន់ ឡើង តួនាទី នៃ អាស៊ី ប៉ាស៊ីហ្វិក ក៏ កាន់តែ លេចធ្លោ ដែរ ។ ក្នុង បរិបទ ថ្មី យើង គួរ ពួត ដៃ គ្នា បង្កើត សហគមន៍ រួម វាសនា អាស៊ី ប៉ាស៊ីហ្វិក ដើម្បី បង្កើត ភាពរុងរឿង ថ្មី នៃ កិច្ចសហប្រតិបត្តិការ អាស៊ី ប៉ាស៊ីហ្វិក ។
លោក Xi Jinping បាន បន្ត ថា យើង គួរ ប្រកាន់ខ្ជាប់ ការរួម ជោគវាសនា ដើម្បី កសាង អាស៊ី ប៉ាស៊ីហ្វិក ដែល គាំទ្រ គ្នា និង ជួយ គ្នា ទៅ វិញ ទៅមក ។ គាំពារ ឋានៈ សំខាន់ នៃ អង្គការ APEC ក្នុង កិច្ចសហប្រតិបត្តិការ តំបន់ បន្ត ជំរុញ ឱ្យ ទំនាក់ទំនង ភាពជាដៃគូ អាស៊ី ប៉ាស៊ីហ្វិក កាន់តែ មាន ទំនុកចិត្ត ចំពោះ គ្នា បរិយាប័ន្ន សហប្រតិបត្តិការ និង ឈ្នះ - ឈ្នះ ៕
អនុប្រធានាធិបតី អាមេរិក បញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត របស់ សហរដ្ឋ អាមេរិក ចំពោះ តំបន់ អាស៉ី
ថ្លែង នៅ ចំពោះ មុខ វត្តមាន របស់ ប្រធានាធិបតី ចិន លោក ស៉ី ជិន ពីង ក្នុង កិច្ចប្រជុំ កំពូល នាទីក្រុង បាងកក នៃ ប្រទេស ថៃ លោកស្រី ហារីស បាន ហៅ សហរដ្ឋ អាមេរិក ថា ជា « មហា អំណាច ប៉ាស៊ីហ្វិក ប្រកបដោយ មោទនភាព » ហើយ បាន និយាយ ថា បណ្តាញ សម្ព័ន្ធ ភាព សន្តិសុខ របស់ អាមេរិក រយៈពេល យូរ បាន អនុញ្ញាតឲ្យ តំបន់ អាស៊ី មាន ការរីកចម្រើន ។
លោកស្រី ហារីស បាន ប្រាប់ មេដឹកនាំ ធុរកិច្ច នៅ ខាងក្រៅ កិច្ចប្រជុំ កំពូល កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច អាស៊ី ប៉ាស៊ីហ្វិក ហៅ កាត់ ថា APEC យ៉ាង ដូច្នេះ ថា « សហរដ្ឋ អាមេរិក ស្ថិត នៅ ទីនេះ ជាមួយ ពួកគេ ។ សារ របស់ យើង នា ពេលនេះ គឺ ច្បាស់ ណាស់ ថា សហរដ្ឋ អាមេរិក មាន ការប្តេជ្ញាចិត្ត ខាង សេដ្ឋកិច្ច យូរអង្វែង ចំពោះ តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក ដែល ជា ការវាស់វែង មិន គិត ជា ឆ្នាំ ប៉ុន្តែ ក្នុង ប៉ុន្មាន ទសវត្សរ៍ និង ច្រើន ជំនាន់ » ។
គួរ បញ្ជាក់ ថា ភាពជាដៃគូ សេដ្ឋកិច្ច នៅ តំបន់ អាស៊ី គឺ ស្ថិត ក្នុង អាទិភាព កំពូល សម្រាប់ រដ្ឋបាល របស់ លោក ចូ បៃ ដិន ខណៈ វិស័យ ឯកជន អាមេរិក បាន វិនិយោគ ប្រហែល ១ពាន់ ពាន់ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ៗ នៅ តំបន់ នេះ ៕ តុលាការ ចេញ ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន បុគ្គល យោធា ២នាក់ ដាក់ ពន្ធនាគារ ពី បទ ក្លែង បន្លំ ឯកសារ សាធារណៈ ប្រើប្រាស់ ឯកសារ សាធារណៈ ក្លែង និង រំលោភ សេចក្តីទុកចិត្ត
( ភ្នំពេញ ) ៖ ចៅក្រម ស៊ើបសួរ សាលាដំបូង រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ចេញ ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន មន្រ្តី យោធា ២នាក់ ដាក់ ពន្ធនាគារ ក្រោម បទ ចោទប្រកាន់ ពី បទ ក្លែងបន្លំ ឯកសារ សាធារណៈ ប្រើប្រាស់ ឯកសារ សាធារណៈ ក្លែង និង រំលោភ សេចក្តីទុកចិត្ត ។
យោង តាម តាម ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន ដាក់ ពន្ធនាគារ របស់ លោក យី សុខ វួច ចៅក្រម ស៊ើបសួរ សាលាដំបូង រាជធានី ភ្នំពេញ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃ នេះ បាន បញ្ជាក់ ថា ជន ត្រូវ ចោទ ទាំង ២នាក់ ដែល ត្រូវបាន កម្លាំង នគរបាល នាយកដ្ឋាន ព្រហ្មទណ្ឌ ចាប់ខ្លួន និង ត្រូវ ឃុំ ខ្លួន ដាក់ ពន្ធនាគារ នេះ រួម មាន៖
* ទី១៖ ឈ្មោះ ហៃ ច័ន្ន ភារិទ្ធ អាយុ ៤៥ ឆ្នាំ មាន មុខរបរ ជា មន្រ្តី យោធា ឋានន្តរស័ក្តិ ឧត្តមសេនីយ៍ ទោ មាន ស្រុក កំណើត ភូមិ ទ្រា ឃុំ ស្ទោង ស្រុក ស្ទោង ខេត្ត កំពង់ធំ និង មាន ទីលំនៅ បច្ចុប្បន្ន ផ្ទះ លេខ ៥៤ ផ្លូវ លេខ ៦៤០ សង្កាត់ ច្បារអំពៅ២ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ។
មន្រ្តី យោធា រូប នេះ ត្រូវបាន តំណាង អយ្យការ ចោទប្រកាន់ ពី បទ « ក្លែង បន្លំ ឯកសារ សាធារណៈ ប្រើប្រាស់ ឯកសារ សាធារណៈ ក្លែង » ដែល ប្រព្រឹត្តទៅ នៅ រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០១៩ បទល្មើស ៦២៨ និង មាត្រា ៦៣០ នៃ ក្រម ព្រហ្មទណ្ឌ ។
* ទី២៖ ឈ្មោះ លឹម មាន សុខ អាយុ ៥៤ ឆ្នាំ មុខរបរ ជា យោធា ឋានន្តរស័ក្តិ វរសេនីយ៍ ទោ ស្នាក់ នៅ ផ្ទះ លេខ ៦ ផ្លូវ លេខ ៧ គំរោង ទី៨ បុរី ប៉េង ហួត បឹង ស្នោរ សង្កាត់ និរោធ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ។
មន្រ្តី យោធា រូប នេះ ត្រូវបាន ចោទប្រកាន់ ពី បទ « រំលោភ លើ ទំនុកចិត្ត » ដែល ប្រព្រឹត្ត នៅ រាជធានី ភ្នំពេញ កាលពី អំឡុង ឆ្នាំ ២០១៤ រហូតដល់ បច្ចុប្បន្ន បទល្មើស ព្រហ្មទណ្ឌ ដែល មាន ចែង ឱ្យ ផ្តន្ទាទោស តាម បញ្ញត្តិ មាត្រា ៣៨១ និង មាត្រា ៣៩២ នៃ ក្រម ព្រហ្មទណ្ឌ ។
របាយការណ៍ របស់ នគរបាល ព្រហ្មទណ្ឌ បាន បញ្ជាក់ ថា មន្រ្តី យោធា ទាំង២នាក់ នេះ ត្រូវបាន ចាប់ខ្លួន កាលពី ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។ បើ តាម របាយការណ៍ របស់ សមត្ថកិច្ច បាន បញ្ជាក់ ថា បុគ្គល ទាំង ២នាក់ នេះ ត្រូវបាន កម្លាំង នគរបាល ចាប់ខ្លួន ដោយសារ មាន ពាក្យបណ្តឹង របស់ ជនរងគ្រោះ រឿង ប្រគល់ លុយ ឲ្យ ពួកគេ ទាំង ២នាក់ រៀបចំ ទិញ ដី ប៉ុន្តែ ទីបំផុត ក្រោយ ទទួលបាន លុយ ហើយ គឺ គ្មាន ដី ឲ្យ ម្ចាស់ លុយ នោះ ឡើយ ។
ក្រោយ មាន ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន របស់ ចៅក្រម ស៊ើបសួរ សាលាដំបូង រាជធានី ភ្នំពេញ រួច មក ជន ត្រូវ ចោទ ទាំង ២នាក់ ត្រូវបាន សមត្ថកិច្ច បញ្ជូន ទៅកាន់ ពន្ធនាគារ ព្រៃសរ នៅ ថ្ងៃ នេះ តែម្តង ៕
កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ សន្និសីទ ថ្នាក់ តំបន់ ស្ដី អំពី ការចែករំលែក ព័ត៌មាន ឥណទាន ក្នុង តំបន់ អាស៊ី សម្រាប់ ប្រព័ន្ធ រាយការណ៍ ឥណទាន ឆ្លង ព្រំដែន និង សន្តិសុខ តាម ប្រព័ន្ធ អ៊ីនធឺណិត
សន្និសីទ នេះ ផ្តល់ ជូន នូវ វេទិកា សាធារណៈ និង ឯកជន កម្រិត អាស៊ី ដើម្បីឱ្យ ស្ថាប័ន ក្នុង តំបន់ ឈាន ឆ្ពោះ ទៅរក ប្រព័ន្ធ រាយការណ៍ ឥណទាន ឆ្លង ព្រំដែន និង ការគ្រប់គ្រង ហានិភ័យ ក្នុង យុគសម័យ នៃ ឌីជីថល នីយកម្ម យ៉ាង ឆាប់រហ័ស ។
ជាមួយនឹង កំណើន យ៉ាង ឆាប់រហ័ស នៃ និន្នាការ សំខាន់ ៗ ដែល ឈាន ទៅរក ការចែករំលែក ព័ត៌មាន ឥណទាន ឆ្លង ប្រទេស ភាព បើក ចំហ នៃ ពាណិជ្ជកម្ម អន្តរជាតិ និង វិនិយោគ ទន ភាព ច្នៃប្រឌិត ក្នុង ប្រព័ន្ធ ហិរញ្ញវត្ថុ ឌីជីថល និង បទប្បញ្ញត្តិ លើស ហិគ្រិន ភាព លោកស្រី បណ្ឌិត ជា សិរី ឧបការី ទេសាភិបាល និង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ក្រុមហ៊ុន ក្រេឌីត ប្យួរ៉ូ ( ខេមបូឌា ) បាន បន្ថែម ថា ភូមិសាស្ត្រ នយោបាយ ក៏ បាន ដើរ តួយ៉ាង សំខាន់ ក្នុង ការជំរុញ លើ ការចែករំលែក ព័ត៌មាន ឥណទាន ។
លោក អឿ សុធារ័ត្ន ប្រធាន នាយក ប្រតិបត្តិ ក្រុមហ៊ុន ក្រេឌីត ប្យួរ៉ូ ( ខេមបូឌា ) បាន បញ្ជាក់ ថា « នៅ ពេល ដែល យើង ឈានជើង ចូល ទៅក្នុង ទសវត្សរ៍ ទី ពីរ នៃ របាយការណ៍ ឥណទាន នៅក្នុង ប្រទេស កម្ពុជា ផែនទី បង្ហាញ ផ្លូវ របស់ យើង ផ្តោត លើ ការទាញយក ទិន្នន័យ ជំនួស ដើម្បីឱ្យ លទ្ធភាព ទទួលបាន ហិរញ្ញប្បទាន ដល់ សហគ្រាស ធុន តូច និង មធ្យម និង អ្នក ខ្ចី ឥណទាន ថ្មី ក៏ ដូចជា ការប្រើប្រាស់ ប្រព័ន្ធ ចែករំលែក ព័ត៌មាន ឥណទាន ឆ្លង ព្រំដែន ដោយ សហការ ជាមួយ ក្រុមហ៊ុន ឥណទាន ក្នុង តំបន់ » ។
( ភ្នំពេញ ) ៖ ក្រុម គ្រូពេទ្យ ចិន - កម្ពុជា មាន ជំនាញ ផ្នែក ផ្លូវ ដង្ហើម បេះដូង សរសៃ ឈាម ឆ្អឹង កង ចាក់ ម្ជុល វិទ្យាសាស្ត្រ លំពែង និង ក្រពះ នា ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ បាន ចុះ ព្យាបាល ជំងឺ សម្រាប់ អាជីវករ ក្នុង ផ្សារ គ្រឿង សំណង់ Defa កម្ពុជា ដោយ ឥត គិត ថ្លៃ តាមរយៈ វិធីសាស្ត្រ វិនិច្ឆ័យ នៃ ការពិនិត្យ ការស្តាប់ ការសួរ និង ការព្យាបាល ដោយ មិន ប្រើប្រាស់ ថ្នាំ ដូចជា ការចាក់ ម្ជុល វិទ្យាសាស្ត្រ និង ការព្យាបាល ដោយ ចលនា ។
ក្នុង ចំណោម អ្នកជំងឺ ដែល បាន ជួប ក្រុម គ្រូពេទ្យ នោះ មិន ត្រឹមតែ មាន អាជីវករ ចិ ន នៅក្នុង ស្រុក ខ្មែរ ប៉ុណ្ណោះ ទេ តែ ក៏ មាន អាជីវករ ក្នុង ស្រុក ជាច្រើន នាក់ ផងដែរ ដែល បាន មក ទទួល ការព្យាបាល នេះ ។
កម្មវិធី នេះ បាន កើត ចេញ ពី មន្ទីរពេទ្យ មិត្តភាព កម្ពុជា - ចិន ព្រះកុសុមៈ ដែល ត្រូវបាន សាងសង់ ឡើង ដោយ មាន ជំនួយ ពី ប្រទេស ចិន នៅក្នុង ខែមីនា ឆ្នាំ ២០២២ នេះ ។ ក្រោយ ការមកដល់ របស់ អ្នកជំនាញ ចិន ក្នុង ប្រទេស កម្ពុជា គ្លីនិក ឱសថ ចិន មួយ ត្រូវបាន បើក ក្នុង មន្ទីរពេទ្យ និង បាន ពាក្យ សរសើរ ថា មាន ប្រសិទ្ធភាព ការព្យាបាល ពិតជា ល្អ ហើយ វិធីសាស្រ្ត នេះ បាន រីករាលដាល បន្តិច ម្តង ៗ ក្នុង ចំណោម ប្រជាជន ខ្មែរ ។
លើកឡើង នា ឱកាស នោះ លោក Zhang Dawu បាន ឱ្យដឹង ថា នៅក្នុង គ្លីនិក ឥត គិត ថ្លៃ នា ពេល បច្ចុប្បន្ន នេះ អ្នកជំងឺ លើស ឈាម ជាច្រើន ត្រូវបាន រកឃើញ ថា មាន វ័យ ក្មេង ។ លោក សង្ឃឹម ថា អ្នកជំងឺ អាច ការពារ និង គ្រប់គ្រង ការវិវត្ត នៃ ជំងឺ តាមរយៈ ការអនុវត្ត ដំបូង ដូចជា របប អាហារ ការធ្វើ លំហាត់ប្រាណ ការឈប់ ជក់ បារី និង ការឈប់ ប្រើប្រាស់ គ្រឿងស្រវឹង ពិសេស យកចិត្តទុកដាក់ លើ សុខភាព ផ្លូវកាយ និង ផ្លូវចិត្ត ។
ជាមួយគ្នា នោះ អាជីវករ ចិន ម្នាក់ ក៏ បាន ចែករំលែក នូវ អារម្មណ៍ រីករាយ ម្រាប់ ការពិគ្រោះ ជំងឺ នៅ កម្ពុជា ថា គាត់ តែងតែ ទទួលស្គាល់ ថ្នាំ ចិន ព្រោះ តាំងពី លោក បាន ត្រឡប់ ទៅ ប្រទេស ចិន ដើម្បី ពិនិត្យ សុខភាព យូរ ហើយ ចាប់តាំងពី ជំងឺ កូវីដ១៩ មក ។
លោក បន្ត ថា « នេះ ជា ដំណឹង ដ៏ ល្អ ដែល ការនាំចេញ ផ្លែ មៀន ស្រស់ ជា លើក ដំបូង របស់ កម្ពុជា ទៅកាន់ ប្រទេស ចិន ទទួលបាន ជៅគជ័យ ។ បច្ចុប្បន្ន មាន ក្រុមហ៊ុន តែ ប៉ុណ្ណោះ បាន បញ្ជាទិញ ផ្លែ មៀន ស្រស់ ពី កម្ពុជា នាំចេញ ទៅកាន់ ប្រទេស ចិន ហើយ ចាប់ពី ពេលនេះ តទៅជា រដូវកាល ប្រមូល ផល ផ្លែ មៀន ស្រស់ ដូច្នេះ រំពឹង ថា នឹង មាន កំណើន ក្នុង ការនាំចេញ » ។
លោក បាន បន្ដ ថា ចំពោះ តម្លៃ វិញ គឺ អាច ទទួលយក បាន ក្រុមហ៊ុន ទទួល ទិញ ដោយ តម្លៃ សមរម្យ ប្រមាណ ជាង ៣ពាន់ រៀល ក្នុង មួយ គីឡូក្រាម ក្រុមហ៊ុន បាន ប្រមូល ទិញ ផ្លែ មៀន ពី ខេត្ត បាត ដំបង និង ខេត្ត ប៉ែលិន ។
លោក ប្រធាន មន្ទីរ កសិកម្ម បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាកសិករ យកចិត្តទុកដាក់ តាមដាន អំពី ទីផ្សារ នៃ តម្លៃ មៀន ឲ្យ ជាប់ លាប់ ប្រើប្រាស់ បច្ចេកទេស ឲ្យបាន ត្រឹមត្រូវ ត្រូវ ស្ដង់ដារ ទីផ្សារ យកចិត្តទុកដាក់ ឲ្យបាន ខ្ពស់ លើ ការថែទាំង ផ្លែ មៀន ជៀសវាង ការប្រើប្រាស់ ថ្នាំ គីមី លើស កម្រិត ដែល ជា ហេតុ បង្ក ផលលំបាក ដល់ ការនាំចេញ ។
សូម ជម្រាប ថា ចំការមៀន ទទួលបាន ការអនុម័ត ចុះបញ្ជី ជា ផ្លូវការ ឱ្យ នាំចេញ ផ្លែ មៀន ទៅកាន់ ទីផ្សារ ចិន មាន ចំនួន ៧៤ ក្នុង នៅ នៅ ខេត្ត ប៉ៃលិន ចំនួន ៤០ ចំការ បាត់ដំបង ចំនួន ២៨ ចំការ និង បន្ទាយមានជ័យ ចំនួន ៦ចំការ ។
សហគមន៍ ជនជាតិ ដើម ភាគ តិច ចារ៉ាយ ភូមិ ប៉ាតាង ស្រុក អូរយ៉ាដាវ ខេត្ត រតនគិរី ទទួលបាន បណ្ណ កម្មសិទ្ធិ ដីធ្លី សមូហភាព
( រតនគិរី ) ៖ លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ប្រគល់ វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ កម្មសិទ្ធិ ដីធ្លី សមូហភាព ជូន សហគមន៍ ជនជាតិ ដើម ភាគ តិច ចារ៉ាយ ចំនួន ១ភូមិ គឺ ភូមិ ប៉ាតាង ស្ថិត ក្នុង ឃុំ សេសាន្ត ស្រុក អូរយ៉ាដាវ ។
ពិធី ប្រគល់ ទទួល វិញ្ញាបនបត្រ សម្គាល់ អចលន វត្ថុ ខាងលើ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ថុល ឌីណា អនុប្រធាន នាយកដ្ឋាន អភិរក្ស សុរិយោដី និង ជា នាយក រង គម្រោង កម្មវិអនុវិស័យ រដ្ឋបាល ដីធ្លី ព្រមទាំង ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព និង កងកម្លាំងប្រដាប់អាវុធ ទាំង ៣ប្រភេទ ផងដែរ ។
មានប្រសាសន៍ សំណេះសំណាល ជាមួយ បងប្អូន សហគមន៍ ជនជាតិ ដើម ភាគ តិច ចារ៉ាយ ដែល បាន អញ្ជើញ មក ទទួល បណ្ណ កម្មសិទ្ធិ ដីធ្លី នា ពេលនេះ លោក ញ៉ែ ម សំអឿន បាន ចាត់ទុក បណ្ណ កម្មសិទ្ធិ ដីធ្លី សមូហភាព គឺជា ឯកសារ មួយ សំខាន់ និង ជា ឯកសារ តំណាង ឱ្យ ទ្រព្យ សហគមន៍ ទាំងមូល ជា ឯកសារ តំណាង ឱ្យ សិទ្ធិ នៃ កម្មសិទ្ធ ផ្ដាច់ មុខ របស់ កម្មសិទ្ធិ ករ លើ ដីធ្លី របស់ ខ្លួន ក្នុង ការប្រើប្រាស់ និង អាស្រ័យ ផល ជាក់ស្តែង រៀង ៗ ខ្លួន ។
ជាមួយគ្នា នោះ លោក ញ៉ែ ម សំអឿន ក៏ បាន កោតសរសើរ ចំពោះ ក្រុមការងារ ចុះបញ្ជី ដីធ្លី និង អ្នក ពាក់ព័ន្ធ ទាំងអស់ ដែល ខិតខំ សម្រេច កិច្ចការ នេះ ដោយ ការទទួលខុសត្រូវ និង តម្លាភាព និង ផ្តាំផ្ញើ ឱ្យ ប្រជាពលរដ្ឋ សហគមន៍ ជនជាតិ ដើម ភាគ តិច ភូមិ ប៉ាតាង ត្រូវ ថែរក្សា ឱ្យ បាន គង់វង្ស នូវ បណ្ណ កម្មសិទ្ធិ សមូហភាព នេះ ហើយ ត្រូវ មាន សាមគ្គីភាព នៅក្នុង សហគមន៍ ថែរក្សា ដី ទាំងអស់ ដែល បាន ចុះបញ្ជី និង ប្រើប្រាស់ ឱ្យ មាន និរន្តរភាព សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ ៕
គួរ បញ្ជាក់ ថា សេចក្តីសម្រេច លើ កម្មវិធី នុយក្លេអ៊ែរ អ៉ីរ៉ង់ ដែល ត្រូវបាន ព្រាង កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ ដោយ សហរដ្ឋ អាមេរិក អង់គ្លេស បារាំង និង អាល្លឺម៉ង់ បាន គូសបញ្ជាក់ ពី « ភាពចាំបាច់ និង បន្ទាន់ » ឲ្យ អ៊ីរ៉ង់ ពន្យល់ ពី ប្រភព ដើម នៃ ភាគ ល្អិត អ៊ុយរ៉ាញ៉ូម ហើយ ផ្តល់ ទៅឲ្យ ទីភ្នាក់ងារ ថាមពល អាតូ មិក អន្តរជាតិ នូវ ចម្លើយ ទាំងអស់ តាម ការស្នើសុំ ៕
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក បាន សម្តែង ការអបអរសាទរ ដល់ ក្រុម សៀក អង្គការ ហ្វារ ពន្លឺ សិល្បៈ ដែល បាន បំបែក ឯកទគ្គកម្ម ពិភពលោក លើ ការសម្តែង សៀក មាន រយៈពេល យូរ ជាង គេ ។
ចំពោះ បរិមាណ នៃ ការនាំចេញ គិត ត្រឹម ខែតុលា ឆ្នាំ ២០២២ កម្ពុជា បាន នាំចេញ ជ័រ កៅស៊ូ ចំនួន ២៦៤.៩១៨ តោន ថយចុះ ចំនួន ១.៥៥២ តោន ស្មើនឹង ១% ធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ មុន ។ រីឯ ការនាំចេញ ឈើ កៅស៊ូ វិញ សម្រេចបាន ចំនួន ១.៦៨៣ ម៉ែត្រ គូប ។
សូម បញ្ជាក់ ថា នា ពេល ថ្មី ៗ នេះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ចេញ សារាចរ ថ្មី មួយ ស្តីពី និរាករណ៍ សារាចរ ណែនាំ របស់ រាជ រដ្ឋាភិបាល លេខ ១០ សរណន ចុះ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០០៣ ស្ដីពី វិធានការ ទប់ស្កាត់ ការនាំចេញ ជ័រ កៅស៊ូ និង ឈើ កៅស៊ូ មិន ទាន់ កែច្នៃ ទៅ បរទស ។
ជុំវិញ ការនិរាករណ៍ សារាចរ ស្ដីពី វិធានការ ទប់ស្កាត់ ការនាំចេញ ជ័រ កៅស៊ូ និង ឈើ កៅស៊ូ មិន ទាន់ កែច្នៃ ទៅ បរទេស នេះ ត្រូវបាន លោក ឌិត ទីណា រដ្ឋមន្ដ្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បញ្ជាក់ ថា ការលុប នេះ ជា ការគិតគូរ ដ៏ ម៉ត់ចត់ របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ដើម្បី ផ្ដល់ ជម្រើស ដល់ កសិករ ដែល ដាំ កៅស៊ូ ជា លក្ខណៈ គ្រួសារ អាច លក់ ទៅ ទីផ្សា ដែល មាន តម្លៃ ខ្ពស់ ។
អ្នកនាំពាក្យ ដដែល បាន បញ្ជាក់ ថា ឈ្មោះ សុខ សុផា ត្រូវបាន ចោទប្រកាន់ តាម មាត្រា ៥៩៧ . មាត្រា ៥៩៨ នៃ ក្រម ព្រហ្មទណ្ឌ ។
