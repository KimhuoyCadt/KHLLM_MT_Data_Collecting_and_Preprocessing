( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ាណែត អនាគត បេក្ខជន នាយក រដ្ឋមន្ត្រី របស់ គណបក្ស ប្រជាជន កម្ពុជា បាន ប្រកាស ថ្លែងអំណរគុណ ដល់ អង្គ មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស របស់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ដែល បាន បោះឆ្នោត ជ្រេីស តាំង លោក ជា ប្រធាន កិត្តិយស សហភាព សហព័ន្ធ យុវជន កម្ពុជា ។
តាម បណ្តាញ សង្គម ហ្វេសប៊ុក លោក ហ៊ុន ម៉ាណែត បាន លើកឡើង ដូច្នេះ ថា៖ « សូម អរគុណ ដល់ អង្គ មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស របស់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន បោះឆ្នោត ជ្រេីស តាំង ឯកឧត្តម បណ្ឌិត ហ៊ុន ម៉ាណែត ជា ប្រធាន កិត្តិយស សហភាព សហព័ន្ធ យុវជន កម្ពុជា » ។
សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន រៀបចំ មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស របស់ ខ្លួន នៅ ថ្ងៃទី ២៦ - ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ដើម្បី បូកសរុប លទ្ធផល ការងារ ដែល សម្រេចបាន នា ពេល កន្លងមក និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៣ - ២០២៨ ។
មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស របស់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ធ្វើឡើង ក្រោម អធិបតីភាព លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ៕ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ញើ សារ ចូលរួម រំលែក មរណទុក្ខ ជូន ឯកឧត្តម ឌួង អេលីត ចំពោះ មរណភាព មហា ឧបាសិកា ឌួង គីម លីន
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ផ្ញើ សារលិខិត ចូលរួម រំលែក ទុក្ខ ជូន ឯកឧត្តម ឌួង អេលីត ប្រធាន ពិធីការ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចំពោះ មរណភាព មហា ឧបាសិកា ឌួង គីម លីន ត្រូវ ជា ម្ដាយ បង្កើត ឯកឧត្តម ឌួង អេលីត ។
តាមរយៈ សារ រំលែក មរណទុក្ខ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « ក្នុង នាម កាកបាទ ក្រហម កម្ពុជា និង ក្នុង នាម ខ្ញុំ ផ្ទាល់ ខ្ញុំ សូម ចូលរួម រំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ជា ទីបំផុត ប្រកបដោយ ក្តីអាឡោះអាល័យ ចំពោះ មរណភាព មហា ឧបាសិកា ឌួង គីម លីន ត្រូវ ជា មាតា បង្កើត ឯកឧត្តម កាលពី ថ្ងៃសៅរ៍ ៣កើត ខែមិគសិរ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស .២៤៦៦ ត្រូវនឹង ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ វេលា ម៉ោង ១៣៖ ៥៩ នាទី ក្នុង ជន្មាយុ ៨២ ឆ្នាំ ដោយ ជរា ពាធ » ។
« ខ្ញុំ សូម ឧទ្ទិស បួងសួង សុំ ដួង វិញ្ញាណក្ខន្ធ មហា ឧបាសិកា ឌួង គីម លីន បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។ សូម ឯកឧត្តម និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ ទទួល នូវ ការចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ នេះ ដោយ ក្តីស្រឡាញ់ រាប់អាន អំពី ខ្ញុំ »៕
នាយ ចំណង់ ហួត រិទ្ធ អតីត យុទ្ធជន សោធន និវត្តន៍ ទទួល ផ្ទះ ថ្មី ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត
លោក អ៊ុត វណ្ណរ៉ា អភិបាល ស្រុក និង ជា ប្រធាន កិត្តិយស មាគម អតីត យុទ្ធជន កម្ពុជា ស្រុក កំពង់ស្វាយ បាន ឡើង ថ្លែងអំណរគុណ ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន គិតគូរ យកចិត្តទុកដាក់ សុខ ទុក្ខ និង សាងសង់ ផ្ទះ ជូន អតីត យុទ្ធជន ដែល មាន ជីវភាព លំបាក ខ្វះខាត ។
ក្នុង ពិធី ប្រគល់ ផ្ទះ ថ្មី នៅ ពេល នេះ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន នាំយក នូវ អំណោយ របស់ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ផ្ដល់ជូន គាត់ បន្ថែម ទៀត មាន៖ អង្ករ ចំនួន ៥០ គីឡូក្រាម មី ចំនួន ២កេស ត្រីខ និង សម្ភារ សម្រាប់ ប្រើប្រាស់ ក្នុង ផ្ទះ បាយ ព្រមទាំង ថវិកា មួយ ចំនួន ផងដែរ ។
( កំពង់ធំ )៖ លោក ឃឹង នុភាព អ្នកតំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ និង ជា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក ប្រាសាទ សំបូរ បាន ថ្លែង ថា គោល នយោបាយ ច្បាស់លាស់ ប្រាកដប្រជា របស់ គណបក្ស ប្រជាជន កម្ពុជា ជា ចក្ខុវិស័យ វែងឆ្ងាយ ដែល ធ្វើឱ្យ កម្ពុជា កាន់តែ ឈាន ឆ្ពោះ រីកចម្រើន ទៅ មុខ ។
ការថ្លែង បែប នេះ របស់ លោក ឃឹង នុភាព បាន ធ្វើឡើង ក្នុង ពិធី ប្រកាស កែសម្រួល និង បំពេញ បន្ថែម ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ គោល ស្រុក ប្រាសាទ សំបូរ នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ។
លោក ឃឹង នុភាព បន្ត ទៀត ថា គោល នយោបាយ ជា អាទិភាព សំខាន់ ៗ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការបម្រើ ឧត្តម ប្រយោជន៍ ជាតិ និង ប្រជាពលរដ្ឋ ក៏ ដូចជា ការអភិវឌ្ឍ ប្រទេសជាតិ យ៉ាង ឆាប់រហ័ស ជាមួយនឹង កិត្យានុភាព កិត្តិយស រដ្ឋ ឯករាជ្យ អធិបតេយ្យ មួយ នៅក្នុង តំបន់ និង អន្តរជាតិ ។
ក្រុមហ៊ុន ប្រតិបត្តិករ បណ្តាញ ថាមពល អគ្គិសនី អ៊ុយ ក្រេណឺហ្កូ (Ukrenergo) បាន ឱ្យដឹង កាលពី ថ្ងៃសៅរ៍ ថា ការផលិត ថាមពល អគ្គិសនី គឺ អាច ផ្គត់ផ្គង់ សម្រាប់ តែ ជាង ៥០ ភាគរយ ប៉ុណ្ណោះ នៃ តម្រូវការ ដែល ចាំបាច់ ឱ្យ មាន ការរឹតត្បិត លើ ការប្រើប្រាស់ និង បញ្ហា ដាច់ចរន្ត អគ្គិសនី នៅ ពាសពេញ ផ្ទៃ ប្រទេស ។
ប្រធានាធិបតី អ៊ុយក្រែន លោក វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី បាន និយាយ ថា បច្ចុប្បន្ន មាន ការរឹតត្បិត ទៅ លើ ការប្រើប្រាស់ ថាមពល អគ្គិសនី នៅ តំបន់ ចំនួន ១៤ ក្នុង ចំណោម តំបន់ ទាំង ២៧ របស់ អ៊ុយក្រែន និង នៅ រដ្ឋធានី កៀវ សម្រាប់ ប្រជាជន ជាង ១០០.០០០ នាក់ ក្នុង តំបន់ នីមួយ ៗ ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក និង ទូរស័ព្ទ ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ល្មើស ល្បឿន ខ្សែក្រវាត់ ឆៀក អត់ បណ្ណ បើកបរ និង សញ្ញា ជាដើម ។
ទីប្រឹក្សា សម្តេច ពញា ចក្រី ហេង សំរិន ជួប សំណេះសំណាល និង ឧបត្ថម្ភ ថវិកា ដល់ សិស្សានុសិស្ស ដែល ត្រៀម ប្រឡង បាក់ឌុប ឆ្នាំ សិក្សា ២០២២ នៅ ឃុំ វាល ម្លូរ ស្រុក ពញា ក្រែក
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ប៉ា ម៉េង ហុក ទីប្រឹក្សា សម្ដេច អគ្គ ពញាច ក្រក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ វាល ម្លូរ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ លោកគ្រូ អ្នកគ្រូ មាតា បិតា និង សិស្សានុសិស្ស ដែល ត្រៀម ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ក្នុង ឆ្នាំ សិក្សា ២០២២ នេះ នៅ ឃុំ វាល ម្លូរ ស្រុក ពញា ក្រែក ។
ក្នុង ឱកាស ជួប សំណេះសំណាល នេះ ក៏ មាន អញ្ជើញ ចូលរួម ពី ក្រុមការងារ ចុះ ជួយ ឃុំ លោកគ្រូ អ្នកគ្រូ មាតា បិតា សិស្ស និង សិស្សានុសិស្ស យ៉ាង ច្រើន កុះករ ។
លោក បណ្ឌិត ប៉ា ម៉េង ហុក បាន ផ្ដាំផ្ញើ ដល់ សិស្សានុសិស្ស ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ខិតខំ សិក្សា រៀនសូត្រ ដើម្បី ត្រៀមលក្ខណៈ ក្នុង ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ០៥ - ០៦ ខែធ្នូ ឆ្នាំ ២០២២ ខាងមុខ នេះ ឲ្យ ទទួលបាន លទ្ធផល ជោគជ័យ ទាំងអស់ គ្នា ។
លោក បណ្ឌិត ប៉ា ម៉េង ហុក បាន បញ្ជាក់ ថា អ្វី ដែល សំខាន់ បំផុត គឺ សិស្សានុសិស្ស ត្រូវតែ ខិតខំ បន្ថែម ទៀត ដើម្បី ក្រេប យក ចំណេះដឹង ពី លោកគ្រូ អ្នកគ្រូ មាន ចម្ងល់ ត្រូវ សាកសួរ ត្រូវ សិក្សា ស្រាវជ្រាវ ជំរុញ ការរៀនសូត្រ ឱ្យ បាន ច្រើន ព្រោះ ជា ឆ្នាំ ត្រូប្រឡង ។
លោក បណ្ឌិត ប៉ា ម៉េង ហុក បាន ថ្លែង ថា ក្មួយ ៗ ជំនាន់ នេះ មាន សំណាង ណាស់ ដែល មាន ឱកាស អង្គុយ រៀន ក្រោម ម្លប់ សន្តិភាព គ្រូបង្រៀន ល្អ ៗ មាន បន្ទប់ រៀន មាន សាលារៀន ល្អ ៗ មាន សៀវភៅ សិក្សា រៀនសូត្រ សមរម្យ មាន ប្រព័ន្ធ អីនធឺរណែត សម្រាប់ សិក្សា ស្រាវជ្រាវ និង មាន អ្នក អ្នក ជួយ គាំទ្រ សព្វ បែប យ៉ាង ដូចនេះ ក្មួយ ៗ ត្រូវ ក្តាប់ ឱកាស ឱ្យ ជាប់ ហើយ ប្រែក្លាយ សម្រាប់ ខ្លួន ឯង និង សង្គមជាតិ ។
ប្រធាន ក្រុមការងារ ក៏ បាន ឧបត្ថម្ភ ជា ថវិកា ជូន ដល់ សិស្សានុសិស្ស ថ្នាក់ ទី១២ ដែល ត្រៀម ប្រឡង បាក់ឌុប រស់ នៅក្នុង ឃុំ វាល ម្លូរ ក្នុង ម្នាក់ ៗ ទទួលបាន ប៊ិច បន្ទាត់ និង ថវិកា ចំនួន ៥ម៉ឺន រៀល និង សិស្ស ដែល ជួប ការលំបាក ចំនួន ២គ្រួសារ ទៀត ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន ថវិកា ៨០០.០០០ រៀល ផងដែរ ៕ ពលរដ្ឋ ក្នុង ស្រុក កំពង់លែង ស្នើសុំ អាជ្ញាធរ និង មន្ត្រី ពាក់ព័ន្ធ ទប់ស្កាត់ ករណី លួច កាប់ ទន្ទ្រាន ដី ព្រៃ ជើង ភ្នំ នាង កង្រី ពីសំណាក់ ជន ខិលខូច
« ខ្ញុំបាទ មាន ទំនុកចិត្ត ថា ការដាក់ចេញ នូវ គោល នយោបាយ ប្រាកដ និយម ថ្មី នេះ គឺ ដូចគ្នា ទៅនឹង ចំណេះដឹង និង ជំនាញ ឆន្ទៈ និង បទពិសោធន៍ ការងារ លើ វិស័យ កសិកម្ម របស់ ខ្ញុំ » ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក យ៉ង សាំង កុមារ នៅក្នុង ស្នើសុំ ចូលរួម ជីវភាព នយោបាយ នោះ ។
ក្រៅតែ ពី ការធ្វើ លិខិត ស្នើសុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ហើយ នោះ លោក យ៉ង សាំង កុមារ ក៏ បាន ធ្វើ លិខិត គោរព ជូន សម្តេច តេជោ ដាច់ដោយឡែក មួយ ទៀត ស្នើសុំ ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍ វិស័យ កសិកម្ម ជាពិសេស វិស័យ ស្រូវ អង្ករ ។
សូម បញ្ជាក់ ថា លោក យ៉ង សាំង កុមារ គឺជា អ្នកជំនាញ កសិកម្ម មួយ រូប ដែល បាន បញ្ចប់ ការសិក្សា ពី ប្រទេស អាល្លឺម៉ង់ ។ តាមរយៈ តួនាទី ជា ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាធិបតេយ្យ មូលដ្ឋាន នា ពេល កន្លងមក លោក តែង ចូលរួម បញ្ចេញ ទស្សនៈ នានា លើ វិស័យ កសិកម្ម ហើយ លោក ផ្ទាល់ ក៏ មាន បង្កើត សមាគម ចែករំលែក ចំណេះ ជំនាញ និង អភិវឌ្ឍន៍ លើ វិស័យ កសិកម្ម នេះ ផងដែរ ។
ការស្នើសុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ពីសំណាក់ លោក យ៉ង សាំង កុមារ គឺជា ព្រឹត្តិការណ៍ ដ៏ គួរឱ្យ ចាប់អារម្មណ៍ ក្នុង ឆាក នយោបាយ ។ ការស្នើសុំ នេះ បាន ស្តែង ឱ្យ ឃើញ ថា គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ជា ប្រមុខ គឺ តែងតែ ផ្តល់ ឱកាស ដល់ អ្នកនយោបាយ និង អ្នក មាន ចំណេះ ជំនាញ នៅ កម្ពុជា ចូលរួម ធ្វើ សកម្មភាព ដើម្បី ជា ឧត្តម ប្រយោជន៍ ជាតិ និង ប្រជាជន តាម ចំណេះ ជំនាញ របស់ ពួកគេ ៕
ក្រុមការងារ ក្រសួង កសិកម្ម និង អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង ចុះ ពិនិត្យ ផ្ទៃដី ដំណាំ ស្រូវ ស្ដារ ឡើងវិញ ដោយ ទឹក ជំនន់ ទន្លេ ដោយ ប្រើប្រាស់ ពូជ ស្រូវ របស់ សម្តេច តេជោ ហ៊ុន សែន នៅក្នុង ស្រុក ចំនួន ៥
( កំពង់ឆ្នាំង ) ៖ ក្រុមការងារ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន សហការ ជាមួយ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត រួម ជាមួយ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំ បាន ចុះ ពិនិត្យ ផ្ទៃដី ដំណាំ ស្រូវ ស្តារ ឡើង បន្ទាប់ពី រង ការខូចខាត ដោយសារ ទឹក ជំនន់ នៅ ស្រុក ចំនួន ៥ ដោយ ប្រើប្រាស់ ពូជ ស្រូវ ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ចំនួន ២. ៦១០ហិកតា ស្នើ នឹង ១០០ % នៃ ផ្ទៃដី ខូចខាត សរុប ។
ក្រុមការងារ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ដឹកនាំ ដោយ លោក ឱ ម គឹម ស៊ា រដ្ឋលេខាធិការ និង មាន ការចូលរួម ផ្ទាល់ ពី លោក ងិន ហ៊ុន ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត រួមទាំង អាជ្ញាធរ មូលដ្ឋាន កាលពី ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
ដំណាំ ស្រូវ ដែល ត្រូវ ស្តារ ឡើងវិញ នុរួម មាន៖ ស្រុក បរិបូណ៌ បាន អនុវត្ត ការស្តារ ឡើងវិញ បាន ចំនួន ៣៨៩ ហិកតា . ស្រុក ជល គីរី បាន ចំនួន ៧. ៨៧ ហិកតា ស្រុក កំពង់លែង បាន ចំនួន ៧០៩ ហិកតា . ស្រុក កំពង់ត្រឡាច បាន ចំនួន ២៣៦ ហិកតា និង ស្រុក រលាប្អៀរ បាន ចំនួន ៤៨៩ ហិកតា ហើយ ចំពោះ ស្ថានភាព ដំណាំ ស្រូវ មាន ការដុះ លូតលាស់ ល្អ គ្មាន ការបំផ្លាញ ពី សត្វ ល្អិត និង ជំងឺ ឡើយ ។
ក្នុង នោះ ដែរ ប្រជាកសិករ ដែល ទទួលរង នូវ ផល ប៉ះពាល់ ខូចខាត ដំណាំ ស្រូវ និង ផល ដំណាំ កសិកម្ម ផ្សេង ៗ ពី ទឹក ជំនន់ ទន្លេ កន្លងទៅ នេះ បាន ថ្លែងអំណរគុណ ដល់ ក្រុមការងារ និង ថ្នាក់ដឹកនាំ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង មន្ទីរ កសិកម្ម ខេត្ត ជា សេនាធិការ របស់ ក្រសួង ដែល បាន អញ្ជើញ មក ពិនិត្យ និង ស្រង់ ស្ថិតិ ផល ដំណាំ ស្រូវ របស់ ប្រជាពលរដ្ឋ ដែល រង ការខូចខាត ដោយ ទឹក ជំនន់ ទន្លេ និង បាន ផ្ដល់ ពូជ ស្រូវ ពូជ ដំណាំ កសិកម្ម ផ្សេង ៗ ដើម្បី បង្កបង្កើន ផល ស្ដារ ឡើងវិញ បាន ទាន់ ពេល វេលា ។
ប្រជាកសិករ ក៏ បាន ថ្លែងអំណរគុណ ដល់ សម្ដេច តេជោ ហ៊ុន សែន ដែល សម្ដេច បាន យកចិត្តទុកដាក់ គិត គូ ដល់ ប្រជាកសិករ ជួប ការលំបាក រង ផល ប៉ះពាល់ ដោយ ទឹក ជំនន់ បណ្ដាលឱ្យ ខូចខាត ដំណាំ ស្រូវ និង ដំណាំ កសិកម្ម ផ្សេង ៗ ដោយ សម្ដេច បាន ចំណាយ នូវ ពេលវេលា ដ៏ មាន តម្លៃ របស់ សម្ដេច បាន ចុះ សួរសុខទុក្ខ និង ចែក ពូជ ស្រូវ ដល់ ប្រជាកសិករ ដោយ ផ្ទាល់ នៅ តាម បណ្ដា ខេត្ត ជាច្រើន ក្នុង ប្រទេស កម្ពុជា ដែល ជា ការផ្ដល់ កម្លាំងចិត្ត និង លើកទឹកចិត្ត ដល់ ប្រជាកសិករ ផងដែរ ៕
លោក ហ៊ុន ម៉ាណែត រំលឹក អនុស្សាវរីយ៍ ក្នុង វ័យ សិក្សា កាលពី ជាង ៣០ ឆ្នាំ មុន តាមរយៈ ការបង្ហាញ ប័ណ្ណ សរសើរ ដែល ធ្លាប់ ទទួលបាន
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ដែល បច្ចុប្បន្ន មាន តួនាទី ជា អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន រំលឹក នូវ អនុស្សាវរីយ៍ មួយចំនួន ក្នុង អំឡុង ពេល ដែល លោក សិក្សា ថ្នាក់ បឋមសិក្សា រហូតដល់ ថ្នាក់ វិទ្យាល័យ តាមរយៈ ការបង្ហាញ នូវ ប័ណ្ណ សរសើរ ជាច្រើន សន្លឹក ដែល ធ្លាប់ ទទួលបាន ។
ជាមួយនឹង រូបភាព ប័ណ្ណ សរសើរ ដែល បង្ហាញ អំពី ចំណាត់ថ្នាក់ ល្អ និង ជា សិស្ស គំរូ នោះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា ប័ណ្ណ សរសើរ ទាំងអស់ នេះ លោក ទើប ទទួលបាន ពី សហការី ដែល ពួកគាត់ រក្សាទុក ជា១០ ឆ្នាំ កន្លងមក ប៉ុន្ដែ ទើប ផ្ញើ ឲ្យ លោក បាន ឃើញ ឡើងវិញ ម្ដង ទៀត បន្ទាប់ពី ការសិក្សា នោះ កន្លងផុត ជាង ៣០ ឆ្នាំ ទៅ ហើយ ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន អះអាង ទៀត ថា កាលពី ជាង ៣០ ឆ្នាំ មុន សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន មាន ក្ដីរំភើប សប្បាយរីករាយ ខ្លាំង ណាស់ នៅពេល ទទួលបាន ម្ដង ៗ ហើយ លោក រំពឹង ថា នៅ ថ្ងៃ ខាងមុខ លោក នឹង បង្ហាញ ឯកសារ ទាំងអស់ នេះ ទៅកាន់ ចៅ ៗ របស់ ខ្លួន គ្រា ដែល ថ្ងៃ នេះ បាន បង្ហាញ ទៅ កូន ៗ របស់ លោក រួចហើយ នោះ ។
លោក ហ៊ុន ម៉ាណែត ក៏ បាន ផ្ដាំផ្ញើ ទៅ មិត្តភ័ក្រ របស់ លោក ដែល មាន ឯកសារ ទាំងអស់ នេះ សូម ជួយ ផ្ញើ ឲ្យ លោក បន្ថែម ទៀត ផង ព្រោះ ឯកសារ នៅ រៀន ពី ថ្នាក់ បឋម រហូតដល់ ថ្នាក់ វិទ្យាល័យ មួយចំនួន ធំ មិន ត្រូវបាន រក្សាទុក ហើយ ខ្លះ បាត់ នៅ ពេល ដែល លោក ចេញ ទៅ រៀន នៅ ក្រៅ ប្រទេស និង ពេល ផ្លាស់ប្ដូរ ទីលំនៅ ច្រើន ដង ។
« កាដូ ពិសេស ដែល សហការី ខ្ញុំ ទើប ផ្ញើ មក ឲ្យ ។ ក្រដាស់ ប៉ុន្មាន សន្លឹក នេះ គឺ ស្ថិត ក្នុង ចំណោម ឯកសារ មួយចំនួន ដែល កាលពី ជាង សាមសិប ឆ្នាំ មុន បាន ធ្វើឲ្យ រូប ខ្ញុំ ក៏ ដូចជា ឪពុក ម្តាយ របស់ ខ្ញុំ មាន សេចក្តីរំភើប រីករាយ ជាខ្លាំង ពេល បាន ទទួល វា ម្តង ៗ ។ ថ្ងៃ នេះ ខ្ញុំ អាច បង្ហាញ វា ទៅ កូន ៗ របស់ ខ្ញុំ ហើយ សង្ឃឹម ថា សាមសិប ឆ្នាំ ខាងមុខ ខ្ញុំ នឹង អាច បង្ហាញ វា ទៅ ចៅ ៗ របស់ ខ្ញុំ ដែរ ។
( ភ្នំពេញ ) ៖ និយ័តករ គណនេយ្យ និង សវនកម្ម បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន សិក្ខាសាលា ផ្សព្វផ្សាយ ស្តីពី « កាតព្វកិច្ច គណនេយ្យ និង សវនកម្ម និង បទប្បញ្ញត្តិ ពាក់ព័ន្ធ » សម្រាប់ សហគ្រាស នៅ ខេត្ត បាត់ដំបង ។ នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ៕
សូម អាន សេចក្ដីប្រកាស ព័ត៌មាន ខាងក្រោម៖
លោក បាន បន្ថែម ទថា ក្នុង ករណី ដែល ក្រុមហ៊ុន ដាក់ពាក្យ តវ៉ា លើ ការកំណត់ ពន្ធ ឡើងវិញ ក្នុង រយៈពេល ៣០ ថ្ងៃ នោះ ប្រាក់ ពន្ធ ដែល ត្រូវបាន កំណត់ ឡើងវិញ ពុំ ទាន់ បាន ត្រូវ កត់ត្រា ជា បំណុល ពន្ធ ឡើយ ។
លោក បន្ថែម ទៀត ថា អ្នក ជាប់ ពន្ធ ខ្លះ បាន ដាក់ លិខិត តវ៉ា តែ មួយ សន្លឹក មក ដោយ មិន ភ្ជាប់ សក្ខីកម្ម ( ភស្ដុតាង ) ឬ បញ្ជាក់ មូលហេតុ ច្បាស់លាស់ ដើម្បី ដោះបន្ទុក អ្វី នោះ ឡើយ គឺ គ្រាន់តែ ដាក់ពាក្យ មកតវ៉ា ដើម្បី ពន្យារ ពេល ដែល ខ្លះ ពន្យារ ពេល បង់ ពន្ធ ពី ៦ខែ ទៅ១ ឆ្នាំ ឬ លើស ពី នេះ ដោយ មិន បាន មក ដោះស្រាយ អ្វី ទាំងអស់ ។ អគ្គ នាយកដ្ឋាន ពន្ធដារ មិន អាច ទុក កិច្ចការងារ ចោល យូរ ដូច្នេះ ទេ ។
លោក បាន ថ្លែង ថា « សូម ចូលរួម គោរព ច្បាប់ ទាំងអស់ គ្នា ។ ច្បាប់ កំណត់ ឱ្យ អ្នក ជាប់ ពន្ធ មាន ពេល ៣០ ថ្ងៃ ដើម្បី ដាក់ពាក្យ ស្នើសុំ តវ៉ា មក និង ដាក់ សក្ខីកម្ម ហើយ បើ ដាក់ តែ ក្រដាស មួយ សន្លឹក ទេ យើងខ្ញុំ អាច មិន ទទួលស្គាល់ ថា ការតវ៉ា នេះ គ្រប់ លក្ខណៈ នៃ ការតវ៉ា នោះ ទេ » ។
ជាមួយគ្នា នេះ ប្រសិនបើ ក្រុមហ៊ុន គិត ថា មន្ត្រី សវនករ ធ្វើ ខុស លោក ប្រាប់ ថា អាច ប្ដឹង មក អង្គភាព គ្រប់គ្រង អ្នក ជាប់ ពន្ធ ឬ មក អគ្គ នាយក ផ្ទាល់ ក៏ បាន ។ លោក នឹង ពិនិត្យមើល និង មាន គណៈកម្មការ វិន័យ បើសិនជា រកឃើញ ថា មាន កំហុស នឹង មាន ការដាក់ ពិន័យ និង ទោសទណ្ឌ តាម ច្បាប់ ជាធរមាន ។
លោក សង្កត់ធ្ងន់ ថា ប្រសិនជា សវនករ ធ្វើ ខុស ប្ដឹង មក អង្គភាព និង ប្ដឹង មក អគ្គ នាយកដ្ឋាន ពន្ធដារ អត់ មាន អ្នកដោះស្រាយ គឺ អាច ប្ដឹង ទៅ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ឬ ទៅកាន់ ស្ថាប័ន មាន សមត្ថកិច្ច ផ្សេង ទៀត តាម ករណី ជាក់ស្ដែង ដូចជា អង្គភាព ប្រឆាំង អំពើពុករលួយ ជាដើម ។ អគ្គ នាយកដ្ឋាន ពន្ធដារ បើកចំហរ ជូន អ្នក ជាប់ ពន្ធ និង សាធារណជន ជានិច្ច ៕
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន អំពី លទ្ធផល បណ្ដោះអាសន្ន ថ្ងៃទី ៣៣ នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត នៅ ទូទាំង ប្រទេស ។
លទ្ធផល បណ្ដោះអាសន្ន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ សម្រាប់ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នៅ ទូទាំង ប្រទេស មាន ដូច ខាងក្រោម៖
គិត ត្រឹម ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ លទ្ធផល បណ្ដោះអាសន្ន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ទទួលបាន ដូច ខាងក្រោម៖
តាមរយៈ គណនី បណ្តាញ សង្គម ទាំង នេះ បាន ក្លាយជាមួយ មធ្យោបាយ មួយ សម្រាប់ ចែកចាយ សកម្មភាព ថ្មី ៗ របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ក៏ ដូចជា ព័ត៌មាន ផ្សេង ពាក់ព័ន្ធ នឹង ការវិវឌ្ឍ របស់ សង្គម កម្ពុជា ជូន ដល់ សាធារណជន បាន ជ្រាប ។
គណនី បណ្តាញ សង្គម ទាំង ៦បន្ថែម របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ដែល ត្រូវបាន ប្រកាស មាន ឈ្មោះ និង តំណ ភ្ជាប់ ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ លោក សាស្ដ្រាចារ្យ វេជ្ជបណ្ឌិត សែម មន្ទីរ ដែល បម្រើ ការងារ នៅ មន្ទីរពេទ្យ រុស្ស៊ី បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ០៦៖ ១៦ នាទី ព្រឹក ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ដោយ រោគា ពាធ ក្នុង ជន្មាយុ ៦០ ឆ្នាំ ។ បច្ចុប្បន្ន សព លោក វេជ្ជបណ្ឌិត សែម មន្ទីរ កំពុង តម្កល់ ធ្វើ បុណ្យ តាម ប្រពៃណី សាសនា នៅ វត្ត វាល ស្បូវ សង្កាត់ វាល ស្បូវ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ។
យោង តាម កម្មវិធី បុណ្យ សព បាន ឲ្យដឹង ថា សព លោក វេជ្ជបណ្ឌិត សែម មន្ទីរ នឹង ត្រូវ តម្កល់ ធ្វើ បុណ្យ រហូតដល់ ថ្ងៃទី ០១ ខែធ្នូ ឆ្នាំ ២០២២ ទើប បូជា តាម គន្លង ប្រពៃណី សាសនា នៅលើ ព្រះមេរុ ( មេន ) ដោយ សម្ដេច ព្រះពោធិ៍វង្ស កិត្តិបណ្ឌិត អំ លីមហេង ជា អ្នក ផ្ដល់ ព្រះអគ្គី៕
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ក្រៅតែ ពី បង្ហាញ ឈុត សម្តែង ត្រង់ វគ្គ មេបញ្ជាការ « សំរេច » ត្រូវបាន អ្នកគ្រូពេទ្យ រ៉ានី កុហក ហើយ នោះ ក៏ បាន បង្ហាញ ឈុត សម្តែង ត្រង់ វគ្គ មេបញ្ជាការនាំ ភរិយា ទៅ ជួប លោកឪពុក អ្នកម្តាយ ជា លើក ដំបូង ផងដែរ ។
ឈុត នេះ គឺជា ព្រឹត្តិការណ៍ នៅក្នុង ឆ្នាំ ១៩៩៦ ។ ក្នុង ឈុត នេះ លោកឪពុក អ្នកម្តាយ របស់ មេបញ្ជាការសំរេច រីករាយ ដែល បាន ឃើញ ប្រុស ត្រឡប់មក ផ្ទះ ហើយ កាន់តែ រីករាយ គឺ ទទួលបាន កូនប្រសារ មួយ រូប ដ៏ ស្រស់ សោភា ។
ទន្ទឹមនឹង ការរីករាយ ក្តី សង្វេគ ចិត្ត ក៏ កើតមាន ផងដែរ ។ លោកឪពុក អ្នកម្តាយ របស់ លោក មេបញ្ជាការសំរេច បាន រំជួល ចិត្ត ភ្លាម ៗ ពេល ឮ ថា កូន ដំបូង របស់ លោក មេបញ្ជាការ និង អ្នកគ្រូពេទ្យ រ៉ានី ត្រូវបាន ស្លាប់ បាត់បង់ជីវិត ពេល ទើបនឹង កើត ។
សូម បញ្ជាក់ ថា ឈុត សម្តែង នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌ មី ចំនួន ៨ឃ្លីប ហើយ ត្រូវបាន សម្តេច តេជោ បង្ហាញ ជាសាធារណៈ ។ ឈុត សម្តែង ដែល សម្តេច តេជោ ទម្លាយ ទទួលបាន ការចាប់អារម្មណ៍ ជាខ្លាំង ពី សាធារណជន ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន បញ្ជាក់ ថា ភាពយន្ត ដែល ទាក់ទង ទៅ នឹង ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ ជាតិ នេះ គ្រោង ចំណាយ ថវិកា សម្រាប់ ផលិត ប្រមាណ ជា ៦លាន ដុល្លារ អាមេរិក ។ បច្ចុប្បន្ន ថត បាន ប្រមាណ ជា ៣០ ភាគរយ ហើយ ។ ថវិកា ដែល ចំណាយ ថត ភាពយន្ត នេះ មិន មែន ជា ថវិកា ជាតិ នោះ ឡើយ ៕ បើកបរ សូម កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ៦នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៦ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើ ក បណ្តាលឲ្យ មនុស្ស ៦នាក់ ស្លាប់ និង ១០នាក់ របួស ។
មហាសន្និបាត វិសាមញ្ញ សហភាព សហព័ន្ធ យុវជន កម្ពុជា បោះឆ្នោត ជ្រើសតាំង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា ប្រធាន កិត្តិយស
( ភ្នំពេញ ) ៖ មហាសន្និបាត វិសាមញ្ញ សហភាព សហព័ន្ធ យុវជន កម្ពុជា នៅ រសៀល ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន បោះឆ្នោត ជ្រើសតាំង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា ប្រធាន កិត្តិយស ។
ក្នុង ការបោះឆ្នោត នោះ មហាសន្និបាត ក៏ បាន បោះឆ្នោត ជ្រើសតាំង លោក ទៀ សីហា ជា អនុប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង សមាជិក គណៈ អចិន្ដ្រៃយ៍ បន្ថែម ចំនួន ០៩ រូប ព្រមទាំង សមាជិក សមាជិកា គណៈកម្មាធិការ កណ្ដាល ថ្មី ចំនួន ២០៣ រូប បន្ថែម ទៀត ផងដែរ ។
អង្គ មហាសន្និបាត វិសាមញ្ញ ស .ស .យ .ក . នៅ ថ្ងៃ នេះ បាន អនុម័ត វិសោធនកម្ម លក្ខន្តិកៈ និង បទបញ្ជា ផ្ទៃក្នុង របស់ ខ្លួន ដើម្បីឲ្យ ស្រប តាម ការវិវត្ត ជាក់ស្តែង របស់ សង្គម និង ស្រប តាម តួនាទី ភារកិច្ច របស់ ស .ស .យ .ក . ។ មហាសន្និបាត វិសាមញ្ញ បាន ពិភាក្សា លើ សកម្មភាព និង ការសម្រេចបាន កន្លងមក ក៏ ដូចជា ការពិនិត្យ និង អនុម័ត វិសោធនកម្ម លក្ខន្តិកៈ និង បទបញ្ជា ផ្ទៃក្នុង ។
ក្នុង វគ្គ ពិភាក្សា រសៀល នេះ មាន ការឡើង ធ្វើជា របាយការណ៍ និង បទ អន្តរាគមន៍ យ៉ាង ផុសផុល ពីសំណាក់ សមាជិក សមាជិកា នៃ អង្គ មហាសន្និបាត ដើម្បី ផ្តល់ ជា ធាតុ ចូល មតិ យោបល់ ទាំង លើ របាយការណ៍ ទិសដៅ ការងារ និង កិច្ចពិភាក្សា ផ្សេង ៗ ទៀត ដែល បាន កំណត់ ក្នុង របៀបវារៈ ។
ជាមួយគ្នា នេះ ដែរ ក្រោយ បញ្ចប់ វគ្គ ពិភាក្សា លោក ឌី វិជ្ជា អនុប្រធាន សសយក និង ជា ប្រធាន អនុគណៈកម្មការ ដឹកនាំ វិសោធនកម្ម លក្ខន្តិកៈ បាន ធ្វើ របាយការណ៍ ស្តីពី សំណើរ វិសោធនកម្ម លក្ខន្តិកៈស .ស .យ .ក . ជូន ដល់ អង្គ ពិធី ។
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ !
ក្នុង ឆ្នាំ ១៨៤០ សមាគម បាល់ទាត់ របស់ អង់គ្លេស បាន បង្កើត បទប្បញ្ញត្តិ បាល់ទាត់ ហើយ កីឡា បាល់ទាត់ សម័យ ទំនើប ក៏ បាន បង្កើតឡើង ។ សព្វ ថ្ងៃ នេះ មាន មនុស្ស លើស ពី ២០០ លាន នាក់ ជុំវិញ ពិភ លោក បាន ចូលរួម លេង កីឡា បាល់ទាត់ ដែល ធ្វើឱ្យ កីឡា នេះ ក្លាយជា កីឡា របស់ ពិភពលោក ទាំងមូល ។
នៅពេល មាន សំណួរ ថា ហេតុ អ្វី បានជា កីឡា បាល់ទាត់ មាន ប្រជាប្រិយភាព ? នេះ ប្រហែល មកពី វា បង្កើត មិត្តភាព ។ នៅពេល លេង កីឡា បាល់ទាត់ អ្នកលេង មាន អារម្មណ៍ ថា ក្រុម ដែល នៅលើ ទីលាន គឺជា ក្រុម របស់ អ្នក ជ័យជម្នះ របស់ ពួកគេ គឺជា ជ័យជម្នះ របស់ អ្នក ហើយ បរាជ័យ របស់ ពួកគេ គឺជា បរាជ័យ របស់ អ្នក ។
* កីឡា បាល់ទាត់ ជា និមិត្ត សញ្ញា នៃ ការរួបរួម នៅ ទ្វីប អាហ្វ្រិក
( ពោធិ៍សាត់ )៖ លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត បាន ប្រកាស ពី យន្តការដឹកនាំ រដ្ឋបាល ខេត្ត លោក នឹង បន្ត ខិតខំ ប្រឹងប្រែង សំដៅ ធ្វើ យ៉ាងណា ឲ្យ ខេត្ត ពោធិ៍សាត់ ប្រែ មុខ ប្រែ មាត់ ជា បណ្តើរ ៗ ហើយក៏ មិន ទុកឲ្យ ជនល្មើស ឡើង គីឡូ នោះ ដែរ ជាពិសេស សកម្មជន ដីធ្លី នៅ ស្រុក វាលវែង ស្រុក ភ្នំ ក្រវាញ ត្រូវតែ បង្ក្រាប ទប់ស្កាត់ និង អនុវត្ត ទៅ តាម វិធានការ ច្បាប់ ឲ្យបាន ម៉ឹង ម៉ាត់ ដើម្បី ថែរក្សា ការពារ ធនធាន ធម្មជាតិ ទាំងនោះ ឲ្យ នៅ គង់វង្ស សម្រាប់ មនុស្ស ជំនាន់ ក្រោយ ៗ ។
ការលើកឡើង របស់ លោក ខូយ រីដា ធ្វើឡើង ក្នុង ឱកាស ដឹកនាំ កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព ខេត្ត ប្រចាំ ខែវិច្ឆិកា និង លើក ទិសដៅ ប្រចាំ ខែធ្នូ ឆ្នាំ ២០២២ នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ដោយ មាន ការចូលរួម ពី លោក លោកស្រី អភិបាល រង ខេត្ត តំណាង អយ្យការ អម សាលាដំបូង ខេត្ត នាយក នាយក រង រដ្ឋបាល សាលា ខេត្ត ប្រធាន អនុប្រធាន មន្ទីរ នានា ជុំវិញ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ និង អង្គភាព ដែល មាន ការពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
លោក ខូយ រីដា បាន អះអាង ថា ដើម្បីឲ្យ ស្រប ទៅតាម យន្តការដឹកនាំ និង បម្រើ ប្រជាពលរដ្ឋ នោះ លោក បន្ត ការខិតខំ ប្រឹងប្រែង ដោយ សហការ ជាមួយ គ្រប់ ភាគី ពាក់ព័ន្ធ ធ្វើ ការអភិវឌ្ឍន៍ ខេត្ត ពោធិ៍សាត់ ឲ្យ កាន់តែ ប្រែ មុខ ប្រែ មាត់ ជា បណ្តើរ ៗ ហើយ ក្នុង នោះ ក៏ មិន ទុកឲ្យ ជនល្មើស ប្រែ មុខមាត់ ឬ ឡើង គីឡូ នោះ ដែរ ។ ជនល្មើស ត្រូវតែ ត្រៀមខ្លួន ឲ្យ ហើយ ទៅ ជាពិសេស សកម្មជន ដីធ្លី នៅ ស្រុក វាលវែង ស្រុក ភ្នំ ក្រវាញ ។
លោក បាន សង្កត់ធ្ងន់ ថា រដ្ឋបាល ខេត្ត ត្រូវ ប្រើប្រាស់ កម្លាំង សរុប វិធានការ សរុប និង មធ្យោបាយ សរុប ទៅ តាម ផ្លូវ ច្បាប់ ក្នុង ការបង្ការ បង្ក្រាប ទប់ស្កាត់ នូវ រាល់ បទល្មើស គ្រប់ ប្រភេទ សំដៅ ថែរក្សា ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ និង ធនធាន ធម្មជាតិ ឲ្យបាន គង់វង្ស សម្រាប់ មនុស្ស ជំនាន់ ក្រោយ ៗ ។
លោក អភិបាល ខេត្ត បាន លើកឡើង ទៀត ថា គោលដៅ ចម្បង និង មាន សារៈសំខាន់ ចំពោះ មុខ នោះ ក្នុង នាម រដ្ឋបាល ខេត្ត កែលំអរ សោភណ្ឌភាព នៅក្នុង ទីប្រជុំជន ក្រុង ដែល ជា បេះដូង ខេត្ត ដូចជា រៀបចំ ដាក់ ឧបករណ៍ ហាត់ប្រាណ នៅលើ កោះ សំពៅ មាស សួនច្បារ ដាក់ ភ្លើង បំភ្លឺ នៅ តាម ដងផ្លូវ និង ទី សាធារណៈ បាន ស្អាត ល្អ ។ គ្រប់ មន្ទីរ អង្គភាព លំនៅដ្ឋាន និង តាម ដងផ្លូវ មិន ឲ្យ មាន សំរាម បើ មាន ត្រូវ វិចខ្ចប់ និង ដឹកជញ្ជូន ឲ្យបាន ទាន់ ពេល វេលា ។ ចំពោះ សំណង់ អណាធិបតេយ្យ នៅ តាម ដងស្ទឹង សូមឲ្យ រដ្ឋបាល ស្រុក ក្រុង ជា អ្នក អនុវត្ត ។
( សេអ៊ូល ) ៖ មន្ត្រី ក្រសួង ដឹកជញ្ជូន កូរ៉េ ខាងត្បូង បាន និយាយ នៅ ថ្ងៃសៅរ៍ នេះ ថា ក្រសួង ដឹកជញ្ជូន គ្រោង នឹង រៀបចំ ជំនួប ជាមួយ ក្រុម សហជីព ដឹក ទំនិញ ដែល កំពុង ធ្វើ កូដកម្ម ដើម្បី ចរចា គ្នា នៅ ថ្ងៃចន្ទ សប្តាហ៍ ក្រោយ ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសៅរ៍ ទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
មន្ត្រី ក្រសួង ដឹកជញ្ជូន បាន គូសបញ្ជាក់ ថា យើង បាន ស្នើសុំ ជជែក ពិភាក្សា ជាមួយ សហជីព ហើយ សហជីព ដឹក ទំនិញ បាន ឆ្លើយតប ថា ពួកគេ នឹង ជួប ជាមួយ យើង នៅ ថ្ងៃចន្ទ ។ ដោយឡែក មន្ត្រី សហជីព បាន លើកឡើង ថា កិច្ចប្រជុំ ដែល គ្រោង នឹង ធ្វើឡើង នេះ នឹង ក្លាយជា កិច្ចសន្ទនា ផ្លូវការ លើក ដំបូង រវាង ភាគី ទាំង ពីរ ។
គួរ បញ្ជាក់ ថា កម្មករ ដឹក ទំនិញ រាប់ ពាន់ នាក់ បាន កូដកម្ម ដ៏ ធំ ជា លើក ទី២ ក្នុង រយៈពេល តិច ជាង ៦ខែ កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ ដើម្បី ទាមទារ ប្រាក់ខែ និង លក្ខខណ្ឌ ការងារ ប្រសើរ ជាង មុន ខណៈ សកម្មភាព នេះ កំពុង រំខាន ដល់ ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ នៅ ទូទាំង ប្រទេស ដែល មាន សេដ្ឋកិច្ច ធំ បំផុត ទី ១០ របស់ ពិភពលោក មួយ នេះ ។
ក្រសួង ដឹកជញ្ជូន កូរ៉េ បាន ឲ្យដឹង ថា មនុស្ស ប្រហែល ៥.០០០ នាក់ បាន ចូលរួម កូដកម្ម នៅ ថ្ងៃសៅរ៍ នេះ ក្នុង ១៣៦ ទីតាំង ទូទាំង ប្រទេស ដែល ធ្លាក់ចុះ ពី ចំនួន ៩. ៦០០ នាក់ នៅ ថ្ងៃ ដំបូង នៃ កូដកម្ម ៕ ម្តាយ បង្កើត របស់ លោក ឌួង អេលីត ទទួលមរណភាព
( ភ្នំពេញ ) ៖ លោក ឌួង អេលីត ប្រធាន ពិធីការ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង ក្រុមគ្រួសារ កំពុង មាន ទុក្ខ យ៉ាង ក្រៀមក្រំ ដោយសារ មហា ឧបាសិកា ឌួង គីម លីន ដែល ជា ម្តាយ បង្កើត បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ១៣៖ ៥៩ នាទី ថ្ងៃសៅរ៍ ទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្នុង ជន្មាយុ ៨២ ឆ្នាំ ដោយ ជរា ពាធ ។
មរណភាព មហា ឧបាសិកា ឌួង គីម លីន គឺជា ការបាត់បង់ ម្តាយ បង្កើត ម្តាយ ក្មេក និង ជីដូនមួយ រូប ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ យ៉ាង ជ្រាលជ្រៅ ចំពោះ កូន ៗ និង ចៅ ៗ ។ ពេញ មួយ ជន្មាយុ មហា ឧបាសិកា ឌួង គីម លីន បាន ប្រឹងប្រែង អស់ កម្លាំង កាយ ចិត្ត ក្នុង ការចិញ្ចឹម បីបាច់ ទំនុកបម្រុង កូន ៗ ឱ្យ ទទួលបាន ការសិក្សា រៀនសូត្រ ខ្ពង់ខ្ពស់ ក្លាយជា ធនធាន ដ៏ ល្អ នៅក្នុង សង្គម ។
បច្ចុប្បន្ន សព មហា ឧបាសិកា ឌួង គីម លីន ត្រូវបាន តម្កល់ រៀបចំ ពិធី បុណ្យ ទក្ខិណា នុប្បទាន ឧទ្ទិស កុសល ផល បុណ្យ ជូន វិញ្ញាណក្ខន្ធ សព នៅ ផ្ទះ តាម ផ្លូវ ជាតិ លេខ ៦២ កំពង់ធំ _ ព្រៈ វិហារ ភូមិ ឥន្ទ កុមារ ឃុំ កំពង់ស្វាយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ។
ដំណឹង មរណភាព នេះ ជា ការជូន ព័ត៌មាន ដល់ សាច់ញាតិ ជិត ឆ្ងាយ ក៏ ដូចជា រាប់អាន ក្រុមគ្រួសារ សព បាន ជ្រាប ជា ព័ត៌មាន និង អញ្ជើញ ចូលរួម បុណ្យ សព ដោយ ក្តី អនុគ្រោះ ៕ មន្រ្តី ជាន់ ខ្ពស់ អ៊ុយក្រែន អះអាង ថា ថាមពល ត្រូវបាន ស្តារ ឡើងវិញ នៅក្នុង ទីក្រុង Kherson
ទីក្រុង ខឺ សុន ភាគ ខាងត្បូង គ្មាន ភ្លើង អគ្គិសនី កំដៅ និង ទឹក ប្រើប្រាស់ ឡើយ នៅពេល កងកម្លាំង អ៊ុយក្រែន ដណ្តើមយក បាន វិញ កាលពី ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
គួរ បញ្ជាក់ ថា កងទ័ព រុស្ស៊ី បាន វាយ ដណ្តើមយក ទីក្រុង ខឺ សុន បាន ភ្លាម ៗ បន្ទាប់ពី ការលុកលុយ របស់ ទីក្រុង មូស្គូ កាលពី ថ្ងៃទី ២៤ ខែកុម្ភៈ ហើយ ជា រដ្ឋធានី ក្នុង តំបន់ តែ មួយ គត់ ដែល ពួកគេ បាន គ្រប់គ្រង ។ ទោះជា រុស្ស៉ី បាន ដកថយ ប៉ុន្តែ ក្រុម មន្ត្រី អ៊ុយក្រែន បាន និយាយ ថា កងកម្លាំង រុស្ស៊ី នៅតែ បន្ត វាយលុក ទីក្រុង នេះ ឆ្លងកាត់ ទន្លេឌីនី ប្រូ (Dnipro) ៕ ខេត្ត បន្ទាយមានជ័យ មាន បេក្ខជន ប្រឡង បាក់ឌុប ចំនួន ៥. ៨០២ នាក់ នៅ ៧ មណ្ឌល ទូទាំង ខេត្ត
( បន្ទាយមានជ័យ )៖ លោក ឈូ ប៊ុន រឿង ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត បន្ទាយមានជ័យ បាន ឲ្យដឹង ថា ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ សម័យ ប្រឡង ថ្ងៃទី ០៥ ខែធ្នូ ឆ្នាំ ២០២២ នេះ នៅ ខេត្ត បន្ទាយមានជ័យ មាន មណ្ឌល ប្រឡង ចំនួន ៧ និង បេក្ខជន ចូលរួម ប្រឡង ចំនួន ៥. ៨០២ នាក់ ។
សូម ជម្រាប ថា ខេត្ត បន្ទាយមានជ័យ ការផ្ញើ យានជំនិះ របស់ បេក្ខជន ប្រឡង ទាំងអស់ មិន ត្រូវបាន គិត ថ្លៃ នោះ ទេ ៕
ការសម្រេច រឹបអូស ជា បណ្តោះអាសន្ន នេះ ធ្វើឡើង បន្ទាប់ពី មាន ពាក្យបណ្តឹង របស់ លោក គី តិច មេធាវី ដើម បណ្តឹង រដ្ឋប្បវេណី តំណាង គណបក្ស ប្រជាជន កម្ពុជា ដែល ស្នើ ឱ្យ មាន ការចេញ ដីកា រ ក្សា ការពារ លើ ទ្រព្យសម្បត្តិ លោក សុន ឆ័យ ។
១៖ រឹបអូស ជា បណ្តោះអាសន្ន លើ អចលន វត្ថុ ចំនួន ០២ កន្លែង ជា ទ្រព្យសម្បត្តិ របស់ កូន បំណុល ឈ្មោះ សុន ឆ័យ មាន
ក . អចលន វត្ថុ ( ថ្មី អគារ ) មាន លេខ ក្បាល ១៦០ មាន ផ្ទៃដី ទំហំ ៣៥៩ ម៉ែត្រ ការ៉េ ស្ថិត នៅ ភូមិ សង្កាត់ បឹងកក់ទី១ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ដែល មាន វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថុ លេខ ១២០៤០៧០៩ - ០១៦០ ) ចុះ ថ្ងៃទី ១៥ ខែធ្នូ ឆ្នាំ ២០១១ ចេញ ដោយ ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី រាជធានី ភ្នំពេញ ។
ខ. អចលន វត្ថុ ( ដី អគារ ) មាន លេខ ក្បាល ៦១១ មាន ផ្ទៃដី ទំហំ ៧៥ ម៉ែត្រ ការ៉េ ស្ថិត នៅ មណ្ឌល១ សង្កាត់ ស្វាយ ដង្គំ ក្រុង សៀមរាប ខេត្ត សៀមរាប ដែល មាន វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថុ លេខ ១៧១០០២១២ - ០២១១ ចុះ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០១៦ ចេញ ដោយ ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ត សៀមរាប ។
២៖ ដើម្បី ទទួលបាន នូវ ការលុបចោល ការអនុវត្ត ការរឹបអូស ជា បណ្ដោះអាសន្ន នេះ លោក សុន ឆ័យ ត្រូវ ដាក់ ប្រាក់ តម្កល់ ទៅ តុលាការ ចំនួន ៣.០០០.០០០.០០០ រៀល ( បី ពាន់ លាន រៀល ) ជា ប្រាក់ រំដោះ ។
៣៖ រឹបអូស ប្រាក់ ប្រដាប់ ក្តី ដែល ម្ចាស់ បំណុល បាន បង់ រួច ។
ក្នុង ដីកា នេះ ក៏ បាន បញ្ជាក់ ដែរ ថា ភាគី ដែល មិន សុខចិត្ត នឹង ដីកា សម្រេច នេះ អាច ដាក់ពាក្យ សុំត វា ( សុំ លុបចោល ដីកា សម្រេច រក្សា ការពារ ) តាម បញ្ញត្តិ មាត្រា ៥៥០ និង មាត្រា ៥៥៧ នៃ ក្រម នីតិវិធី រដ្ឋប្បវេណី ។
សាលាដំបូង រាជធានី ភ្នំពេញ កាលពី រសៀល ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០២២ បាន ប្រកាស សាលក្រម លើ សំណុំរឿង បរិហារ កេរ្តិ៍ ជាសាធារណៈ ទាំង២ របស់ លោក សុន ឆ័យ ដែល ត្រូវបាន ប្តឹង ដោយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត និង គណបក្ស ប្រជាជន កម្ពុជា ។
សំណុំរឿង ប្តឹង ដោយ គ.ជ. ប ចៅក្រម បាន ផ្ដន្ទាទោស លោក សុន ឆ័យ ពិន័យ ជា ប្រាក់ ចំនួន ៩លាន រៀល ។ ចំណែក ក្នុង សំណុំរឿង ប្តឹង ដោយ គណបក្ស ប្រជាជន កម្ពុជា ចៅក្រម បាន សម្រេច ផ្ដន្ទាទោស លោក សុន ឆ័យ ពិន័យ ជា ប្រាក់ ចំនួន ៨លាន រៀល ព្រមទាំង បង្គាប់ ឲ្យ សង សំណង ជម្ងឺចិត្ត ឲ្យ ដើម បណ្តឹង រដ្ឋប្បវេណី ចំនួន ៣០០០ លាន រៀល ផងដែរ ។
ការដាក់ ពាក្យ បណ្តឹង របស់ គ.ជ. ប និង គណបក្ស ប្រជាជន កម្ពុជា ធ្វើឡើង បន្ទាប់ពី លោក សុន ឆ័យ បាន ចោទប្រកាន់ ថា ការបោះឆ្នោត បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ កន្លងទៅ មាន ការទិញ និង លួច បន្លំ សន្លឹក ឆ្នោត ៕
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ស្ម័គ្រចិត្ត រើ លំនៅឋាន ចេញ ពី តំបន់ រមណីយដ្ឋាន អង្គរ និង តំបន់ គ្រប់គ្រង ដោយ អាជ្ញាធរ ជាតិ អប្សរា នោះ ចាប់ផ្តើម ចូល សាងសង់ លំនៅឋាន នៅ តំបន់ អភិវឌ្ឍន៍ រុន តា ឯក ហើយ បន្ទាប់ពី អាជ្ញាធរ បាន រៀបចំ ឈូសឆាយ ព្រៃ និង ចាក់ ដី តាម ដីឡូតិ៍ របស់ ពួកគាត់ រួចរាល់ នោះ ។
ប្រជាពលរដ្ឋ ស្ម័គ្រចិត្ត រើ លំនៅឋាន ចេញ ពី តំបន់ រមណីយដ្ឋាន អង្គរ និង តំបន់ គ្រប់គ្រង ដោយ អាជ្ញាធរ ជាតិ អប្សរា ត្រូវបាន រាជ រដ្ឋាភិបាល ប្រគល់ ដី មួយឡូតិ៍ ទំហំ ២០ម៉ែត្រ គុណ នឹង ៣០ម៉ែត្រ នៅ តំបន់ អភិវឌ្ឍន៍ រុន តា ឯក ស្ថិត ក្នុង ឃុំ រុន តា ឯក ស្រុក បន្ទាយស្រី ខេត្ត សៀមរាប ចម្ងាយ ជាង ២០ គីឡូម៉ែត្រ ពី ក្រុង សៀមរាប ។
បន្ទាប់ពី ការសម្រុក ឈូសឆាយ ព្រៃ រៀបចំ ដី លំនៅឋាន និង ហេដ្ឋារចនាសម្ព័ន្ធ នានា ពីសំណាក់ កង វិស្វកម្ម សម្តេច តេជោ ខេត្ត សៀមរាប ដឹកនាំ ដោយ នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ នោះ ដីឡូតិ៍ ជាច្រើន ទីតាំង ត្រូវបាន ឈូសឆាយ និង ចាក ដី បំពេញ ជូន រួចរាល់ ហើយ ។
ទន្ទឹមនឹង ការរៀបចំ ដី លំនៅឋាន រួចរាល់ នេះ ក្រុមការងារ ក៏ បាន បើក ឱ្យ ប្រជាពលរដ្ឋ ចូល សង់ លំនៅ ផងដែរ ។ ប្រជាពលរដ្ឋ ជាច្រើន គ្រួសារ កំពុង រូតរះ សង់ លំនៅឋាន របស់ ពួកគេ នៅ តំបន់ អភិវឌ្ឍន៍ រុន តា ឯក ។ ផ្ទះ ត្រូវបាន សាងសង់ ឡើង ទៅតាម លទ្ធភាព នៃ គ្រួសារ នីមួយ ៗ ។ គ្រួសារ ខ្លះ មាន លទ្ធភាព ក៏ សង់ ផ្ទះ ថ្ម គ្រួសារ មិន សូវ មាន លទ្ធភាព ក៏ សង់ ជា ផ្ទះ ឈើ ជាមួយ ស័ង្កសី ដែល រាជ រដ្ឋាភិបាល ផ្តល់ ជូន ។
អ្នកស្រី សូរ ពៅ ប្រជាពលរដ្ឋ ស្ម័គ្រចិត្ត ចេញ ពី រមណីយដ្ឋាន អង្គរ បាន ឱ្យដឹង ថា គ្រួសារ របស់ អ្នកស្រី ចាប់ផ្តើម សង់ បង្គន់ និង ធ្វើ របង ផ្ទះ ហើយ នឹង ចាប់ផ្តើម រុះរើ ផ្ទះ ចេញ រមណីយដ្ឋាន អង្គរ នៅ ខែធ្នូ ខាងមុខ នេះ ។
អ្នកស្រី សូរ ពៅ បាន បង្ហាញ ការកត់សម្គាល់ ថា អាជ្ញាធរ ពាក់ព័ន្ធ បាន ប្រឹងប្រែង រៀបចំ ដី លំនៅឋាន និង កសាង ហេដ្ឋារចនាសម្ព័ន្ធ នានា ជូន ប្រជាពលរដ្ឋ ដើម្បីឱ្យ ការរស់នៅ បាន ល្អ ប្រសើរ ។ អ្នកស្រី សូរ ពៅ បាន គូសបញ្ជាក់ ដូច្នេះ « គេ ធ្វើ ពិតប្រាកដ មែន មិន មែន យក ប្រជាពលរដ្ឋ មក ទុកចោល នោះ ទេ » ។
ប្រជាពលរដ្ឋ មួយ រូប ទៀត ដែល កំពុង ចូលមក សង់ លំនៅឋាន ក្នុង តំបន់ អភិវឌ្ឍន៍ រុន តា ឯក ដែរ នោះ ក៏ បាន បង្ហាញ ការពេញចិត្ត ចំពោះ ការរៀបចំ ហេដ្ឋារចនាសម្ព័ន្ធ នានា ដើម្បី គាំទ្រ ដល់ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ផងដែរ ។
លោកយាយ ខៃ ឃួន បាន គូសបញ្ជាក់ ថា អាជ្ញាធរ បាន ធ្វើ ពិតប្រាកដ លើ ការរៀបចំ ដី លំនៅឋាន និង ហេដ្ឋារចនាសម្ព័ន្ធ នានា ។
ទាំង អ្នកស្រី សូរ ពៅ និង លោកយាយ ខៃ ឃួន សុទ្ធតែ បាន បង្ហាញ ការពេញចិត្ត ក្នុង ការមក រស់ នៅ តំបន់ រុន តា ឯក ។ ជាពិសេស មាន ដី ជា កម្មសិទ្ធិ របស់ ខ្លួន ហើយ អាច ធ្វើ អ្វី តាម ខ្លួន ចង់ ធ្វើ នៅលើ ដី នោះ មិន ដូច នៅ រមណីយដ្ឋាន អង្គរ មិន អាច ធ្វើ អ្វី បាន នោះ ឡើយ ។
សូម បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ដែល ត្រូវ រៀបចំ មក ឱ្យ រស់ នៅ តំបន់ អភិវឌ្ឍន៍ រុន តា ឯក នេះ មាន ចំនួន ជាង ៥ ពាន់ គ្រួសារ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ណែនាំ ឱ្យ ឈូសឆាយ ព្រៃ រៀបចំ ដី និង មាន កងកម្លាំង ជួយ ដឹកជញ្ជូន នៅពេល រុះរើ ផ្ទះ ចេញ ពី រមណីយដ្ឋាន អង្គរ ថែម ទៀត ។
បន្ថែម ពីលើ នោះ សម្តេច តេជោ បាន ចាត់ចែង រៀបចំ សាងសង់ ហេដ្ឋាន រចនាសម្ព័ន្ធ ផ្លូវថ្នល់ ត បណ្តាញ អគ្គិសនី ត បណ្តាញ ទឹក ស្អាត ដំឡើង អង់តែន ទូរស័ព្ទ សាងសង់ ផ្សារ សាលារៀន មណ្ឌល សុខភាព និង វត្ត ផងដែរ ដើម្បី គាំទ្រ ដល់ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ នៅ តំបន់ រុន តា ឯក នេះ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ផ្តល់ បណ្ណ សមធម៌ ក្រីក្រ កម្រិត ១ និង ផ្តល់ ប្រាក់ អត្រា ទីប្រជុំជនរយៈពេល ១០ ឆ្នាំ ជូន ពលរដ្ឋ ដែល រស់ នៅ តំបន់ នេះ ផងដែរ ។ ការធ្វើ បែប នេះ ដើម្បី ជួយ សម្រាល ការលំបាក ប្រចាំ ខែ របស់ ពួកគេ ៕
មន្ទីរ សាធារណការ ខេត្ត កំពង់ធំ ស្ថាបនា ផ្លូវ ចាក់ កៅស៊ូ ប្រភេទ DBST ប្រវែង ៥គីឡូម៉ែត្រ ជូន ពលរដ្ឋ រស់ នៅ ឃុំ កំពង់ចិន ត្បូង ស្រុក ស្ទោង
( កំពង់ធំ )៖ ដោយ មាន ការយកចិត្ត ទុក ពី ប្រមុខ រាជ រដ្ឋ ភិបាល និង ក្រោម ការដឹកនាំ ពី លោក ងួន រតនៈ អភិបា ខេត្ត កំពង់ធំ និង ឃើញ ពី ការលំបាក របស់ ប្រជាពរដ្ឋ ដែល រស់ នៅ តាម ដងស្ទឹង ស្ទោង លោក បាន ជំរុញ ឱ្យ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត សហការណ៍ ជា រដ្ឋបាល ស្រុក ស្ទោង រៀបចំ ស្ថាបនា ផ្លូវ កៅ មួយ ខ្សែ DBST នៅក្នុង ឃុំ កំពង់ចិន ត្បូង ។
លោក បាន បញ្ជាក់ ថា៖ « កន្លែង ខ្លះ មាន ទំហំ ចាប់ពី ១១ម៉ែត្រ រហូត ទៅដល់ ១៥ម៉ែត្រ ដោយសារ ទីកន្លែង ខ្លះ ត្រូវ ចាក់ ដី បំពេញ ច្រើន ទើប មិន មាន ភាពស្មើគ្នា ដូច្នេះ ហើយ សូម ឱ្យ ប្រជាពលរដ្ឋ មាន ការយោគយល់ អធ្យាស្រ័យ ដើម្បី ធ្វើឱ្យ ផ្លូវ របស់ យើង មាន ទំហំ ធំ និង មាន ភាពរឹងមាំ » ។
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ទាំង ពីរ ឃុំ ខាងលើ ស្វាគមន៍ និង សាទ រ យ៉ាង ក្រៃលែង បំផុត ចំពោះ ថ្នាក់ដឹកនាំ ដែល តែងតែ គិតគូរ ពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ បើ ទោះបី ត្រូវ ខាតបង់ សម្ភារ មួយចំនួន ក៏ដោយ ពិសេស លោក អភិបាល ស្រុក ដែល យកចិត្តទុកដាក់ ក្នុង ការសហការណ៍ ជាមួយ ជំនាញ ពាក់ព័ន្ធ ដើម្បី ស្ថាបនា កសាង ផ្លូវ នេះ ឱ្យ បាន ចេញ រូបរាង ក្នុង ពេល ឆាប់ ៗ ដើម្បីឱ្យ ប្រជាពលរដ្ឋ បាន ប្រើប្រាស់ និង ដឹកជញ្ជូន កសិផល បាន ទាន់ ពេវេលា ៕
អង្គការ ទំពាំង ស្នង ឫស្សី សហការ ជាមួយ អាជ្ញាធរ ខេត្ត សៀមរាប បើក យុទ្ធនាការ ប្រមូល សំរាម រដូវ ទឹក ស្រក បឹង ទន្លេ សាប នៅ តំបន់ ចុង ឃ្នៀស
( សៀមរាប ) ៖ អង្គការ ទំពាំង ស្នង ឫស្សី សហការ ជាមួយ អាជ្ញាធរ ខេត្ត សៀមរាប នា ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ម្សិលមិញ បាន បើក យុទ្ធនាការ ប្រមូល សំរាម ប្លាស្ទិក រដូវ ទឹក ស្រក បឹង ទន្លេ សាប នៅ តំបន់ ចុង ឃ្នៀស ស្ថិត ក្នុង សង្កាត់ ចុង ឃ្នៀស ក្រុង សៀមរាប ខេត្ត សៀមរាប ។
ទន្ទឹមនឹង នេះ ដែរ លោក ពិន ប្រាកដ អភិបាល រង ខេត្ត សៀមរាប លើកឡើង ថា បឹង ទន្លេ សាប មាន ទំហំ ធំ ល្វឹងល្វើយ មាន សារៈសំខាន់ ខ្លាំង ណាស់ សម្រាប់ ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ មនុស្ស សត្វ និង ជីវៈ ចម្រុះ នានា ។
លោក បន្ត ថា ខេត្ត សៀមរាប ក្រៅពី ការចូលមក ទស្សនា កម្សាន្ត ប្រាសាទ អង្គរវត្ត និង ប្រាសាទ បុរាណ ជាច្រើន ហើយ នោះ ភ្ញៀវ ទេសចរ មិន ភ្លេច ឡើយ ចូលមក ទស្សនា បឹង ទន្លេ សាប ដែល ទីតាំង ដ៏ ទាក់ទាញ មួយ ។
លោក ពិន ប្រាកដ ក៏ បាន រំលឹក ដែរ ថា ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ មក កម្សាន្ត មិន ចេះ ដាច់ នោះ ទេ សូម ប្រជា សហគមន៍ ត្រូវ រួមគ្នា ថែរក្សា អនាម័យ បរិស្ថាន ទុកដាក់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ ជាពិសេស សំរាម ប្លាស្ទិក ដើម្បី រក្សា សហគមន៍ មួយ នេះ ឱ្យ ស្រស់ស្អាត គ្មាន ការបំពុល ដោយ ប្លាស្ទិក នោះ ជីវភាព ប្រជា សហគមន៍ នឹង កាន់តែ ល្អ ប្រសើ និង ទទួលបាន ចំណូល ពី វិស័យ ទេសចរ ទៀតផង ៕
ពាក់ព័ន្ធ ការបោះឆ្នោត ថ្នាក់ តំបន់ នៅ តៃវ៉ាន់ ខាង ទីក្រុង ប៉េកាំង បាន លើកឡើង ថា លទ្ធផល ដែល ចេញមក បាន បង្ហាញ ថា ការយល់ឃើញ របស់ ប្រជាន តៃវ៉ាន់ ទូទៅ គឺ ពួកគេ ចង់បាន សុខ សន្តិភាព ស្ថិរភាព និង ការរស់នៅ ល្អ ប្រសើរ ហើយ ទីក្រុង ប៉េកាំង នឹង បន្ត ធ្វើការ ជាមួយ ប្រជាជន តៃវ៉ាន់ ដើម្បី លើកកម្ពស់ ទំនាក់ទំនង សន្តិភាព ព្រមទាំង ប្រឆាំង នឹង ចលនា ឯករាជ្យ តៃវ៉ាន់ ក៏ ដូចជា ការជ្រៀត ជ្រែក ពី បរទេស ។
គួរ បញ្ជាក់ ថា នា ពេលនេះ ការផ្តោត សំខាន់ នឹង ត្រូវ បង្វែរ ទៅ រក ការបោះឆ្នោត សភា និង ការបោះឆ្នោត ប្រធានាធិបតី ឆ្នាំ ២០២៤ ដែល លោកស្រី សៃ និង បក្ស DPP បាន ទទួល ជ័យជម្នះ ក្នុង សំឡេង ភ្លូក ទឹក ភ្លូក ដី កាលពី ឆ្នាំ ២០២០ តាមរយៈ ការសន្យា ក្រោកឈរ តតាំង ជាមួយ ចិន ហើយ ប្តេជ្ញា ការពារ សិទ្ធិ សេរីភាព របស់ តៃវ៉ាន់ ។ បច្ចុប្បន្ន លោកស្រី សៃ កំពុង ស្ថិត ក្នុង ការកាន់អំណាច នៅ អាណត្តិ ទី២ ដូច្នេះហើយ លោកស្រី នឹង មិន អាច ឈរឈ្មោះ ជា ប្រធានាធិបតី ម្តង ទៀត ឡើយ ដោយសារ ការ កំណត់ អាណត្តិ ប្រធានាធិបតី ត្រឹម ២អាណត្តិ ៕
( ភ្នំពេញ ) ៖ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ចេញមក បំភ្លឺ មុខ មក បំភ្លឺ ជំរុញ ការរិះគន់ មួយចំនួន ដែល លើកឡើង ថា រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម មិន បាន យកចិត្តទុកដាក់ លើ បញ្ហា តម្លៃ ស្រូវ ធ្លាក់ ថ្លៃ ដោយ បាន បង្ហាញ នូវ យុទ្ធសាស្ត្រ ចំនួន ដែល ក្រសួង កំពុង ការងារ ដើម្បី ដោះស្រាយ បញ្ហា តម្លៃ ស្រូវ ។
កញ្ញា អ៊ឹម រចនា អនុ រដ្ឋលេខាធិការ នៃ ក្រសួង កសិកម្ម បាន ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ថា នា ពេល ខាងមុន ក្រសួង កសិកម្ម នឹង ជួយ ជ្រោមជ្រែង ដល់ គ្រប់ ភាគី ទាំងអស់ ដើម្បីឱ្យ វិស័យ កសិកម្ម ដំណាំ ស្រូវ ដើរ ទៅ មុខ និង ឈាន ទៅ កាត់បន្ថយ បញ្ហា ធ្លាក់ ថ្លៃ ក្នុង រដូវ ប្រមូល រៀងរាល់ ឆ្នាំ តាមរយៈ យុទ្ធសាស្រ្ត ៤ចំណុច ដែល ក្រសួង នឹង អនុវត្ត រួម មាន៖
១៖ វិធានការផលិត ពូជ សុទ្ធ ល្អ ដែល សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី បាន ប្រគល់ ឱ្យ ក្រសួង អនុវត្ត ខណៈ ក្រសួង បាន នឹង កំពុង ធ្វើការ យ៉ាង សស្រាក់សស្រាំ ជាមួយ វិស័យ ឯកជន ។ ២៖ វិធានការលក់ ចែកចាយ ពូជ ក្នុង ថ្លៃ សមរម្យ ដែល នៅក្រោម ថ្លៃ ទីផ្សារ ធម្មតា ។ ៣៖ វិធានការ អ្នកទិញ ពូជ នឹង ទទួលបាន កិច្ចសន្យា ផលិតកម្ម ។ ៤៖ វិធានការ កម្មវិធី ដាំដុះ ដើម្បី ធានា ការប្រើប្រាស់ ទឹក និង ការទិញ មកវិញ មិន ឱ្យ ចាល់ ដូច ការផលិត ដែល គ្មាន ផែនការរួម ។
ឆ្លើយតប នឹង ការរិះគន់ ចំពោះ ការធ្លាក់ ស្រូវ នា ពេល ថ្មី ៗ នេះ អនុ រដ្ឋលេខាធិការ នៃ ក្រសួង កសិកម្ម រូប នេះ បាន លើកឡើង យ៉ាង ដូច្នេះ ថា ចំពោះ បញ្ហា ធ្លាក់ចុះ នៃ ថ្លៃ ស្រូវ នៅ តាម បណ្ដា ខេត្ត មួយចំនួន នា ពេល ថ្មី ៗ នេះ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន កត់សម្គាល់ ឃើញ ថា មាន អ្នកប្រើប្រាស់ បណ្ដាញ សង្គម មួយ ចំនួន ដែល បាន អាន ព័ត៌មាន នានា ត្រឹមតែ ចំណងជើង ហើយ ចោទប្រកាន់ ក្រសួង កសិកម្ម ថា បន្ទោស ប្រជាកសិករ ដែល ប្រមូល ផល ស្រូវ ស្រប ពេល គ្នា ជា ហេតុ ធ្វើឱ្យ ស្រូវ ធ្លាក់ ថ្លៃ ។
កញ្ញា បន្ត ថា នៅក្នុង សេចក្ដីប្រកាស ព័ត៌មាន របស់ ក្រសួង ចុះ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ក្រសួង បាន បញ្ជាក់ ច្បាស់លាស់ ណាស់ ថា ការធ្លាក់ចុះ នៃ ថ្លៃ ស្រូវ កើតឡើង ជារៀងរាល់ ឆ្នាំ ចាប់ពី ដើម ខែវិច្ឆិកា រហូតដល់ ពាក់កណ្ដាល ខែធ្នូ ព្រោះ វា ជា រដូវ ប្រមូល ផល របស់ បងប្អូន ប្រជាកសិករ ។ នេះ ជា កត្តា សត្យានុម័ត ដែល មិន អាច ប្រកែក បាន ហើយ វា ពុំ មែន ជា កំហុស របស់ ប្រជាកសិករ ទាល់តែសោះ នៅ ពេល ដែល ដំណាំ ស្រូវ របស់ លោក ដល់ ពេល ប្រមូល ផល និង ត្រូវតែ ប្រមូល ផល ឱ្យ ទាន់ សភាពការណ៍ ។
យ៉ាងណា ក៏ដោយ នៅក្នុង ឆ្នាំ នេះ ចាប់តាំងពី ថ្ងៃទី ១៥ ខែវិច្ឆិកា មក ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ចុះ ដោះស្រាយ បញ្ហា នេះ ជូន ដល់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ផ្ទាល់ តាមរយៈ ការសម្របសម្រួល ការទិញ ដូរ ស្រូវ រវាង រោង ម៉ាស៊ីន កិន ស្រូវ និង ប្រជាកសិករ ក្នុង តម្លៃ សមស្រប មួយ ដែល អាច ទទួលយក បាន ពី គ្រប់ ភាគី ។
បើ តាម កញ្ញា អ៉ឹម រចនា គិត ត្រឹម ថ្ងៃសុក្រ ទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ រោង ម៉ាស៊ីន កិន ស្រូវ នៅ ខេត្ត បាត់ដំបង និង បន្ទាយមានជ័យ បាន ប្រមូល ទិញ ស្រូវ ពី ប្រជាកសិករ បាន ជាង ១៥ម៉ឺន តោន រួច មកហើយ ខណៈ ទិន្នផល ស្រូវ ដែល នៅសស់ មិន ទាន់ ដល់ ពេល ប្រមូល ផល មាន ចំនួន ប្រមាណ ២០ ភាគរយ នៅ ខេត្ត បាត់ដំបង និង ជាង ៥០ ភាគរយ នៅ ខេត្ត បន្ទាយមានជ័យ ។
កញ្ញា បន្ត ថា កន្លងមក រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ លោក ឌិត ទីណា ធ្លាប់ បាន ពន្យល់ អំពី បញ្ហា នេះ រួច មកហើយ ថា ដំណោះស្រាយ ចំពោះ វិស័យ កសិកម្ម គឺ ទាមទារ ឱ្យ សម្លឹងមើល ទាំងមូល និង ឱ្យ បាន គ្រប់ ជ្រុងជ្រោយ មិន មែន មើល ត្រឹមតែ ផ្នែក ណាមួយ នោះ ទេ ។ ចំពោះ ដំណោះស្រាយ ទៀតសោត គឺ ត្រូវតែ ជា ដំណោះស្រាយ ដែល មាន ការចូលរួម ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ។
គួរ បញ្ជាក់ ថា មុន ការបោះឆ្នោត ប្រធានាធិបតី និង ការធ្វើ បាតុកម្ម ប្រឆាំង រដ្ឋាភិបាល ទ្រង់ទ្រាយ ធំ នៅ បេឡារុស កាលពី ឆ្នាំ ២០២០ លោក ម៉ាកី បាន ស្ថិត ក្នុង ចំណោម ក្រុម អ្នកផ្តួចផ្តើម កិច្ចប្រឹងប្រែង ដើម្បី ធ្វើឱ្យ ប្រសើរឡើង នូវ ទំនាក់ទំនង របស់ បេឡារុស ជាមួយ លោក ខាងលិច ហើយក៏ ធ្លាប់ បាន រិះគន់ លើ រុស្ស៉ី ផងដែរ ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បន្ត បង្ហាញ ឈុត សម្តែង ថ្មី មួយ ទៀត ក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺឺ ព្រះចន្ទ ពេញ បូណ៌មី ។ ឃ្លីប ទី៩ ដែល សម្តេច តេជោ បាន បង្ហាញ នេះ មេបញ្ជាការ « សំរេច » បាន ចាប់ មេ មាន់ កំពុង ក្រាប ពង ស្ងោ ជូន មេបញ្ជាការ ។
ក្នុង ឈុត នេះ បាន បង្ហាញ ពី ទិដ្ឋភាព នៃ ការអង្គុយ រៀប ផែនការ នានា សម្រាប់ សមរភូមិ សង្គ្រាម រវាង មេបញ្ជាការ « សំរេច » និង បញ្ជាការ របស់ ខ្លួន ក៏ ដូចជា យុទ្ធ មិត្ត ដទៃ ទៀត ។
សូម បញ្ជាក់ ថា ឈុត សម្តែង នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌ មី ចំនួន ៩ឃ្លីប ហើយ ត្រូវបាន សម្តេច តេជោ បង្ហាញ ជាសាធារណៈ ។ ឈុត សម្តែង ដែល សម្តេច តេជោ ទម្លាយ ទទួលបាន ការចាប់អារម្មណ៍ ជាខ្លាំង ពី សាធារណជន ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន បញ្ជាក់ ថា ភាពយន្ត ដែល ទាក់ទង ទៅ នឹង ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ ជាតិ នេះ គ្រោង ចំណាយ ថវិកា សម្រាប់ ផលិត ប្រមាណ ជា ៦លាន ដុល្លារ អាមេរិក ។ បច្ចុប្បន្ន ថត បាន ប្រមាណ ជា ៣០ ភាគរយ ហើយ ។ ថវិកា ដែល ចំណាយ ថត ភាពយន្ត នេះ មិន មែន ជា ថវិកា ជាតិ នោះ ឡើយ ៕ សម្តេច តេជោ ហ៊ុន សែន បង្ហាញ ឈុត សម្តែង ក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី ត្រង់ ចំណុច អ្នកគ្រូពេទ្យ រ៉ានី កុហក មេបញ្ជាការសំរេច (Video inside)
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បន្ត បង្ហាញ ឈុត សម្តែង នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី ។ ឈុត សម្តែង ដែល បាន បង្ហាញ នេះ គឺ នៅ ត្រង់ វគ្គ មេបញ្ជាការ « សំរេច » ត្រូវបាន អ្នកគ្រូពេទ្យ រ៉ានី កុហក ។
ត្រង់ វគ្គ នេះ ជា រាត្រី មួយ ដែល មេបញ្ជាការ « សំរេច » បាន ទៅ ជួប អ្នកគ្រូពេទ្យ រ៉ានី កំពុង អង្គុយ លើ ផ្ទះ ធ្វើការ ក្រោម ពន្លឺ ចង្កៀង ផ្លុង ៗ មុខ បែរ ទៅ ជញ្ជាំង ផ្ទះ ហើយ ខ្នង បែរ មក ខាងក្រៅ ។
ក្នុង ស្ថានភាព បែប នេះ លោក មេបញ្ជា រូប សង្ហា មិន បាន ឃើញ សម្រស់ អ្នកគ្រូពេទ្យ ក្រមុំ ដ៏ ស្រស់ សោភា នោះ ឡើយ ។ ពេល នោះ លោក មេបញ្ជាការ វ័យ ក្មេង បាន សួរ រក មេបញ្ជាការសារឿន ព្រម ជាមួយគ្នា លោក មេបញ្ជាការ ក៏ បាន សួរ រក អ្នកគ្រូពេទ្យ រ៉ានី ផងដែរ ។
សួរ រក អ្នកគ្រូពេទ្យ រ៉ានី ព្រោះ លោក មេបញ្ជាការ ចង់ ស្គាល់ អ្នកគ្រូពេទ្យ ដែល គេ តែងតែ ចំអន់ និង ផ្គូរ ផ្គង ដាក់ នោះ ។ ពេល ឮ លោក មេបញ្ជាការសួរ រក ឈ្មោះ អ្នកគ្រូពេទ្យ រ៉ានី . អ្នកគ្រូពេទ្យ ក្រមុំ ដ៏ ស្រស់ សោភា មិន បាន ឆ្លើយ ប្រាប់ ត្រង់ នោះ ទេ ។ បែរជា កុហក លោក មេបញ្ជាការ ថា អ្នកគ្រូពេទ្យ រ៉ានី ចុះ ទៅ កំពង់ទឹក ទៅ វិញ ។
សូម បញ្ជាក់ ថា ឈុត សម្តែង នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌ មី ចំនួន ៧ឃ្លីប ហើយ ត្រូវបាន សម្តេច តេជោ បង្ហាញ ជាសាធារណៈ ។ ឈុត សម្តែង ដែល សម្តេច តេជោ ទម្លាយ ទទួលបាន ការចាប់អារម្មណ៍ ជាខ្លាំង ពី សាធារណជន ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន បញ្ជាក់ ថា ភាពយន្ត ដែល ទាក់ទង ទៅ នឹង ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ ជាតិ នេះ គ្រោង ចំណាយ ថវិកា សម្រាប់ ផលិត ប្រមាណ ជា ៦លាន ដុល្លារ អាមេរិក ។ បច្ចុប្បន្ន ថត បាន ប្រមាណ ជា ៣០ ភាគរយ ហើយ ។ ថវិកា ដែល ចំណាយ ថត ភាពយន្ត នេះ មិន មែន ជា ថវិកា ជាតិ នោះ ឡើយ ៕ នៅសល់ ១២ ថ្ងៃ ទៀត ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ នឹង ត្រូវ បញ្ចប់ សូម ប្រជាពលរដ្ឋ ប្រញាប់ អញ្ជើញ ទៅ ពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ !
បើ តាម ក្រសួង សុខាភិបាល ក្នុង ចំណោម ករណី ថ្មី ខាងលើ នេះ មាន សរុប ចំនួន ១៤៤ ត្រូវបាន បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ ដែល ក្នុង នោះ ១៣ ករណី ធ្ងន់ធ្ងរ ។
ប៉ុន្តែ គ្មាន ការស្លាប់ ថ្មី ដោយសារ កូវីដ - ១៩ ត្រូវបាន គេ រាយការណ៍ នោះ ទេ នៅ ថ្ងៃសៅរ៍ នេះ ដែល ធ្វើឲ្យ ចំនួន អ្នកស្លាប់ សរុប មិន ផ្លាស់ប្តូរ គឺ នៅ ត្រឹម ចំនួន ១. ៧០២ នាក់ ៕
ក្រសួង សុខាភិបាល វៀតណាម បាន ឲ្យដឹង ថា ករណី ថ្មី ទាំងអស់ ត្រូវបាន ចម្លង ក្នុង ស្រុក ។ បូក បន្ថែម ការឆ្លង ថ្មី បាន ធ្វើឱ្យ ចំនួន សរុប កើនឡើង ដល់ ១១. ៥១៤. ១៧៤ នាក់ ។ ដោយឡែក មិន មាន អ្នកស្លាប់ នោះ ទេ ក្នុង របាយការណ៍ នៅ ថ្ងៃសៅរ៍ នេះ ទេ ដោយ ចំនួន អ្នកស្លាប់ សរុប មាន ចំនួន ៤៣. ១៧០ នាក់ ។
ខេត្ត ស្វាយរៀង ប្រារព្ធ ទិវា ពិភពលោក ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ក្រោម ប្រធានបទ « មិន ទាន់ បញ្ចប់ ទេ »
ថ្លែង ក្នុង ឱកាស នោះ លោក សុខា រ៉ាម បាន ឲ្យដឹង ថា យោង តាម ស្ថិតិ ចុងក្រោយ របស់ UNAIDS មនុស្ស ជាង ៣៨លាន នាក់ កំពុង រស់ នៅ ជាមួយ មេរោគ អេដស៍ និង ជំងឺ អេដស៍ នៅ ទូទាំង ពិភពលោក ហើយ មនុស្ស ជាង ៤០លាន នាក់ បាន ស្លាប់ ដោយសារ ជំងឺ ដែល ទាក់ទង នឹង ជំងឺ អេដស៍ ចាប់តាំងពី ការចាប់ផ្តើម ការរីករាលដាល មេរោគ អេដស៍ ។ ខណៈ មនុស្ស រាប់ លាន នាក់ សព្វ ថ្ងៃ នេះ កំពុង ទទួលបាន ការព្យាបាល ដោយ ថ្នាំ ប្រឆាំង មេរោគេ អដស៍ ។
លោក បាន អំពាវនាវ ឲ្យ ភាគី ពាក់ព័ន្ធ និង អ្នកតស៊ូ មតិ ក្នុង ប្រទេស ទាំងអស់ បង្កើន កិច្ច ខិតខំ ប្រឹងប្រែង ការពារ ការធ្វើតេស្ត និង ការព្យាបាល មេរោគ អេដស៍ នៅ ទូទាំង ពិភពលោក ដើម្បី ពន្យឺត អត្រា ឆ្លង មេរោគ អេដស៍ ថ្មី ដែល កំពុង កើន ឡើង យ៉ាង ឆាប់រហ័ស និង ការពារ សមិទ្ធផល ដ៏ មាន តម្លៃ ដែល បាន ធ្វើ កន្លងមក ។ យើង បាន ជោគជ័យ ជាយូរ មកហើយ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ យើង ត្រូវតែ ថែរក្សា សមិទ្ធផល ពី ពេលនេះ តទៅទៀត ។
សូម បញ្ជាក់ ថា អង្គការ មូលនិធិ ថែទាំ សុខភាព អ្នកជំងឺ អេដស៍ (AHF) ជា អង្គការ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ធំ ជាង គេ បំផុត នៅលើ ពិភពលោក ។ បច្ចុប្បន្ន អង្គការ កំពុង ផ្តល់ ការព្យាបាល ថែទាំ និង សេវាកម្ម ដល់ មនុស្ស ជាង ១. ៤៧លាន នាក់ នៅក្នុង ៤៥ ប្រទេស ទូទាំង ពិភពលោក ដូចជា នៅ សហរដ្ឋ អាមេរិក អាហ្វ្រិក អាមេរិក ឡាទីន ការា បៀន តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក និង អឺរ៉ុប ខាងកើត ជាដើម ៕
អង្គការ មូលនិធិ ថែទាំ សុខភាព អ្នកជំងឺ អេដស៍ រៀបចំ ទិវា ពិភពលោក ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ឆ្នាំ ២០២២ ក្រោម ប្រធានបទ « មិន ទាន់ បញ្ចប់ ទេ » នៅ ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ អង្គការ មូលនិធិ ថែទាំ សុខភាព អ្នកជំងឺ អេដស៍ (AHF) នា ព្រឹក ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ប្រារព្ធ ទិវា ពិភពលោក អេដស៍ ឆ្នាំ ២០២២ ក្រោម ប្រធានបទ « វា មិន ទាន់ បញ្ចប់ ទេ » ដើម្បី រំលឹក ដល់ មេដឹកនាំ ពិភពលោក ស្ថាប័ន សុខភាព សាធារណៈ ពិភពលោក និង សង្គម ស៊ីវិល ថា ការងារ ជាច្រើន ទៀត នៅតែ មាន ប្រសិនបើ យើង ចង់ បញ្ចប់ ការរីករាលដាល នៃ ជំងឺ អេដស៍ នៅ ថ្ងៃ ណាមួយ ។
លើកឡើង នា ឱកាស នោះ លោក វេជ្ជបណ្ឌិត ឈឹម សារ៉ាត់ បាន បញ្ជាក់ ថា យើង រីករាយ ដែល បាន ឃើញ ភាពធន់ នៃ កម្មវិធី ទប់ស្កាត់ មេរោគ អេដស៍ នៅ ទូទាំង ពិភពលោក ក្នុង អំឡុង ពេល និង ក្រោយ ជំងឺ រាតត្បាត នេះ ។ ទោះជា យ៉ាងណា ក៏ដោយ ទិន្នន័យ ចុងក្រោយ របស់ UNAIDS បង្ហាញ ថា ការឆ្លើយតប នឹង មេរោគ អេដស៍ / ជំងឺ អេដស៍ ជា សកល ត្រូវការ ការពង្រឹង ឡើងវិញ ដែល ធ្វើឱ្យ ប្រធានបទ « មិន ទាន់ បញ្ចប់ ទេ » របស់ យើង កាន់តែ ពាក់ព័ន្ធ សម្រាប់ ទិវា ជំងឺ អេដស៍ ពិភពលោក ឆ្នាំ នេះ ។
លោក វេជ្ជបណ្ឌិត បាន បន្ថែម ថា យើង កំពុង អំពាវនាវ ឱ្យ ភាគី ពាក់ព័ន្ធ និង អ្នកតស៊ូ មតិ ក្នុង ប្រទេស ទាំងអស់ បង្កើន កិច្ច ខិតខំ ប្រឹងប្រែង ការពារ ការធ្វើតេស្ត និង ការព្យាបាល មេរោគ អេដស៍ នៅ ទូទាំង ពិភពលោក ដើម្បី កាត់បន្ថយ អត្រា ឆ្លង មេរោគ អេដស៍ ថ្មី ដែល កំពុង កើនឡើង យ៉ាង ឆាប់រហ័ស និង ការពារ ផលប្រយោជន៍ ដ៏ មាន តម្លៃ ដែល យើង បាន ធ្វើ កន្លងមក ។ យើង បាន ធ្វើដំណើរ ឆ្ងាយ ណាស់ មកហើយ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ ។
សូម បញ្ជាក់ ដែរ ថា យោង តាម ស្ថិតិ ថ្មី បំផុត របស់ UNAIDS មនុស្ស ជាង ៣៨ លាន នាក់ កំពុង រស់ នៅ ជាមួយ មេរោគ អេដស៍ / ជំងឺ អេដស៍ នៅ ទូទាំង ពិភពលោក ហើយ មនុស្ស ជាង ៤០ លាន នាក់ បាន ស្លាប់ ដោយសារ ជំងឺ ដែល ទាក់ទង នឹង ជំងឺ អេដស៍ ចាប់តាំងពី ការចាប់ផ្តើម នៃ ការរីករាលដាល នៃ មេរោគ អេដស៍ ។ ខណៈពេល ដែល មនុស្ស រាប់ លាន នាក់ សព្វ ថ្ងៃ នេះ កំពុង ទទួលបាន ការព្យាបាល ដោយ ថ្នាំ ប្រឆាំង មេរោគ អេដស៍ មនុស្ស រាប់ លាន នាក់ ទៀត នៅតែ ត្រូវការវា យ៉ាង ខ្លាំង ៕
ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ចាត់ ក្រុមការងារ ៣២៥ រូប ចុះ ត្រួតពិនិត្យ ការងារ ពង្រឹង គុណភាព សេវា ទូរគមនាគមន៍ នៅ បុរី ប៉េង ហួត និង ស្វែងយល់ ពី មតិ យោបល់ ប្រជាពលរដ្ឋ
( ភ្នំពេញ ) ៖ ក្រុមការងារ របស់ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ និង និយ័តករ ទូរគមនាគមន៍ កម្ពុជា ចំនួន ៣២៥ រូប ក្រោម ការចង្អុលបង្ហាញ ពី លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នា ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ចុះ ត្រួតពិនិត្យ វឌ្ឍនភាព ការងារ ពង្រឹង គុណភាព សេវា ទូរគមនាគមន៍ នៅ បុរី ប៉េង ហួត ស្ថិត នៅ សង្កាត់ និរោធ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ និង បន្ត ស្វែងយល់ ពី មតិ យោបល់ ប្រជាពលរដ្ឋ ដែល ប្រតិបត្តិការ នេះ នឹង ធ្វើឡើង នៅ ថ្ងៃទី ២៧ មួយ ថ្ងៃ ទៀត ផងដែរ ។
សមាជិក ក្រុមការងារ ទាំង ៣២៥ រូប បាន ស្ទង់ មតិ និង ប្រមូល ព័ត៌មាន ពី ប្រជាពលរដ្ឋ ដោយ ផ្ទាល់ នៅ តាម ផ្ទះ នៅ គ្រប់ គម្រោង សំដៅ ជំរុញ ការដោះស្រាយ បញ្ហា សេវា ជូន ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ប្រសើរ ។
នា ឱកាស នោះ ដែរ ក្រុមហ៊ុន បុរី ប៉េង ហួត ក៏ បាន សហការបញ្ជូន បុគ្គលិក ទទួលបន្ទុក តាម គម្រោង នីមួយ ៗ សម្របសម្រួល ការចុះ សម្ភាសន៍ តាម ផ្ទះ ក្នុង សិក្សា ស្វែងយល់ អំពី ស្ថានភាព និង កត្តា កំពុង ប្រឈម នានា ជុំវិញ ការប្រើប្រាស់ សេវា ទូរសព្ទ និង អ៊ីនធឺណិត ដើម្បី ជា ធាតុ ចូលក្នុង ការរៀបចំ ជា ដំណោះស្រាយ នៅ តាម បុរី នានា ផងដែរ ៕
ទេសរដ្ឋមន្ត្រី គន់ គីម អបអរសាទរ នាយ ឧត្តមសេនីយ៍ ជា តារា អតីត សហការី លើ សមរភូមិ ជាយ ដែន ក្នុង ឱកាស ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សង្គហ បណ្ឌិត គន់ គីម ទេសរដ្ឋមន្ត្រី អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន សម្តែង នូវ សេចក្តី សោមនស្ស រីករាយ និង អបអរសាទរ យ៉ាង ស្មោះ អស់ ពី ដួងចិត្ត ជូន ចំពោះ នាយ ឧត្តមសេនីយ៍ ជា តារា សាកលវិទ្យាធិការ សាកលវិទ្យាល័យ ការពារ ជាតិ ក្នុង ឱកាស នាយ ឧត្តមសេនីយ៍ ត្រូវបាន ព្រះមហាក្សត្រ ខ្មែរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី សព្វ ព្រះរាជ ហឫទ័យ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី ។
នាយ ឧត្តមសេនីយ៍ ជា តារា ត្រូវបាន គេ ដឹង ថា ជា អ្នក ដែល មាន ចំណេះ ជំនាញ លើ វិស័យ ការពារ ជាតិ ដ៏ ប៉ិនប្រសប់ មួយ រូប ដោយ បាន បញ្ចប់ ការសិក្សា លើ វិស័យ ការពារ ជាតិ នៅក្នុង ប្រទេស បារាំង មិន តែ ប៉ុណ្ណោះ នាយ ទាហាន ដែល ពោរពេញ ទៅ ដោយ យុទ្ធសាស្ដ្រ និង កល យុទ្ធ លើ សមរភូមិ រូប នេះ បាន ចូលរួមចំណែក យ៉ាង ច្រើន ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ ដែល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន មេបញ្ជាការផុត លេខ ផ្កាយ មាស ៥។
ជាពិសេស នៅក្នុង សង្គ្រាម ទល់ ដែន ជាមួយ ប្រទេស ថៃ កាលពី ឆ្នាំ ២០០៨ នាយ ឧត្តមសេនីយ៍ ជា តារា គឺជា មេបញ្ជាការ សមរភូមិ មុខ មួយ រូប ដែល នៅ ប្រចាំ ការជាប់ ជានិច្ច ក្នុង សមរភូមិ ក្ដៅ ទិស ប្រាសាទ ព្រះវិហារ ដោយ រង់ចាំ គោរព និង អនុវត្ត នូវ បទបញ្ជា របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការវាយ កម្ចាត់ សត្រូវ ការពារ ទឹកដី ការពារ ជាតិ និង ប្រាង្គ ប្រាសាទ ខ្មែរ ។
ភាព អង់អាច ក្លាហាន និង គំរូវីរភាព របស់ នាយ ឧត្តមសេនីយ៍ ជា តារា បាន បន្សល់ នៅ ការគោរព ស្រលាញ់ និង នឹករលឹក ពីសំណាក់ មេទ័ព នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ដែល បាន រូម សមរភូមិ ដើម្បី ការពារ ជាតិ មាតុភូមិ ។ ឈរ លើ គុណ បំណាច់ ជា ច្រើន ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាជន នេះ នាយ ឧត្តមសេនីយ៍ ជា តារា ទទួលបាន សេចក្តី ពេញចិត្ត ទុកចិត្ត ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន ទូល ថ្វាយ ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង និង ផ្តល់ ឋានន្តរស័ក្តិ ជា បន្តបន្ទាប់ ។
មុននឹង ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី នេះ នាយ ឧត្តមសេនីយ៍ ជា តារា ក៏ ទទួលបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា ទីប្រឹក្សា សម្តេច តេជោ ឋានៈ ស្មើ ទេសរដ្ឋមន្ត្រី ផងដែរ ។
នាយ ឧត្តមសេនីយ៍ សង្គហ បណ្ឌិត គន់ គីម ដែល ជា មេកើយ របស់ នាយ ឧត្តមសេនីយ៍ ជា តារា បាន រំលឹក នូវ អនុស្សាវរីយ៍ និង លើក បង្ហាញ គំរូវីរភាព ជាច្រើន របស់ នាយ ឧត្តមសេនីយ៍ ជា តារា ។
នាយ ឧត្តមសេនីយ៍ គន់ គីម បាន លើកឡើង ទៀត ថា ក្រៅពី ការរួម ប្រយុទ្ធ បណ្ដេញ ខ្មាំង សត្រូវ ហើយ នោះ នាយ ឧត្ដមសេនីយ៍ ជា តារា ក៏ បាន រួមចំណែក ជាច្រើន ក្នុង ការងារ កសាង និង អភិវឌ្ឍន៍ តំបន់ ព្រំដែន នៅ តំបន់ ប្រាសាទ ព្រះវិហារ និង ខេត្ត ឧត្តរមានជ័យ ជាដើម នោះ ។
យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៦ ខែវិច្ឆិកា៖ បង្ក្រាប ២២ករណី ឃាត់ខ្លួន ៣៥ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៤ករណី . ដាំដុះ ១ករណី . បេីក បរ ក្រោម ឥទ្ធិពល ២ករណី និង ជួញដូរ ១៤ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣៥ នាក់ ។
ប្រជាពលរដ្ឋ ជិត ៧០០ នាក់ ចូលរួម យុទ្ធនាការ « មួយ ជំហាន គ្មាន ផ្លាស្ទិក » ដោយ រើស សំរាម បាន ជិត១០តោន នៅ រាជធានី ភ្នំពេញ
ក្នុង យុទ្ធនាការ នេះ ដោយ រើស បាន សំរាម ជិត១០តោន ក្នុង នោះ មាន សំរាម ដែល អាច យក ទៅ កែច្នៃ ប្រើប្រាស់ បាន និង សំរាម ខ្លះ ទៀត យក ទៅ ចាក់ នៅ គំនរ សំរាម ។
យុទ្ធនាការ « មួយ ជំហាន គ្មាន ផ្លាស្ទិក » នេះ បាន ធ្វើឡើង អស់ រយៈពេល ជិត កន្លះ ឆ្នាំ មកហើយ ដោយ បាន រើស សំរាម នៅ តាម បណ្ដា ខេត្ត នៃ តំបន់ ទេសចរណ៍ សំខាន់ ៗ រួម មាន៖ ខេត្ត កែប ខេត្ត សៀមរាប និង បណ្ដា ខេត្ត ដែល ជា គោលដៅ ទេសចរណ៍ ជាច្រើន ទៀត ។
បើ តាម អ្នករៀបចំ យុទ្ធនាការ នេះ ត្រឹមតែ មួយ ព្រឹក ប៉ុណ្ណោះ អ្នកចូលរួម យុទ្ធនាការរើស សំរាម បាន ជិត១តោន ក្នុង នោះ សំរាម ផ្លាស្ទិក ដែល អាច យក ទៅ កែច្នៃ បាន មាន ចំនួន ៣៦៨ គីឡូក្រាម និង សំរាម ទូទៅ មាន ប្រមាណ ៨៩៥០ គីឡូក្រាម ។ សំរាម ដែល អាច កែច្នៃ បាន ត្រូវបាន ប្រគល់ ជូន ក្រុមហ៊ុន ជីប ម៉ុង យក ទៅ កែច្នៃ និង សំរាម ទូទៅ ត្រូវ រថយន្ត ប្រមូល សំរាម មក ទទួលយក ទៅ ទុកដាក់ ឲ្យបាន ត្រឹមត្រូវ ៕
សូម ជំរាប ថា កាលពី រសៀល ថ្ងៃទី ៤ ខែមករា ឆ្នាំ ២០២២ ឈ្មោះ ឈឹម ស៊ី ថរ មេក្លោង ដឹកនាំ បាតុកម្ម ខុស ច្បាប់ នៅមុខ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន ខណៈ ដែល កំពុងតែ ដឹកនាំ បាតុកម្ម ខុស ច្បាប់ នៅមុខ ស្ថានទូត អូស្ត្រាលី ។ ការចាប់ខ្លួន ពាក់ព័ន្ធ នឹង ការញុះញង់ ឱ្យ មាន ការប្រមូលផ្តុំ តវ៉ា ដោយ ខុស ច្បាប់ នៅមុខ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ ។
បន្ទាប់មក កាលពី ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២២ ឈ្មោះ ឈឹម ស៊ី ថរ បាន យល់ព្រម ធ្វើ កិច្ចសន្យា មួយ ដោយ គោរព ជូន រដ្ឋមន្រ្តី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដើម្បី ដោះស្រាយ បញ្ចប់ បញ្ហា វិវាទ ជាមួយ ក្រុមហ៊ុន ណាហ្គាល វើល ដ៏ ក៏ ដូចជា ផលប្រយោជន៍ ស្រប ច្បាប់ គ្រប់ ភាគី ឈ្មោះ ឈឹម ស៊ី ថរ សូម អំពាវនាវ ដល់ បុគ្គលិក និង អតីត បុគ្គលិក របស់ ក្រុមហ៊ុន ណាហ្គាវើស ទាំងអស់ ដូច ខាងក្រោម៖
១៖ ចំពោះ បុគ្គលិក និង កម្មករ កំពុង ធ្វើ កូដកម្ម មិន ទាន់ បាន ចូល ធ្វើ ការវិញ សូម ចូល ធ្វើ ការ ទាំងអស់ គ្ន ដើម្បី ការពារ ផលប្រយោជន៍ នៅ កន្លែង ការងារ និង បង្ក បរិយាកាស សម្រាប់ ដោះស្រាយ វិវាទ តាម ផ្លូវ ច្បាប់ ។
២៖ ចំពោះ បុគ្គលិក ដែល ក្រុមហ៊ុន ណាហ្គាល វើល ដ៏ បញ្ឈប់ ពី ការងារ សូម សម្រាក នៅ ផ្ទះ ឬ រក្សា ភាពស្ងប់ស្ងាត់ ដើម្បី បង្កបរិយកាស សម្រាប់ យើងខ្ញុំ ចរចា ជាមួយ ក្រុមហ៊ុន ណាហ្គាល វើល ដ៏ និង ក្រសួង ការងារ ដើម្បី ស្វែងរក ដំណោះស្រាយ និង ទូរទាត់ សំណង តាម ផ្លូវ ច្បាប់ ជូន ដល់ បងប្អូន ។
បន្ទាប់មក នៅ ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០២២ សាលាដំបូង រាជធានី ភ្នំពេញ បាន ចេញ ដីកា សម្រេច មួយ ដោយ ដាក់ ជន ត្រូវ ចោទ ឲ្យ ស្ថិត ក្រោម ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ ដែល ត្រូវបាន ដាក់ ឱ្យ ស្ថិត ក្រោម ការពិនិត្យ ពី បទ « ញុះញង់ បង្កឱ្យ មាន ភាពវឹកវរ ធ្ងន់ធ្ងរ ដល់ សន្តិសុខ សង្គម ពី ប្រព្រឹត្ត នៅ ប្រទេស កម្ពុជា កាលពី អំឡុង ឆ្នាំ ២០២១ និង ពេល បន្តបន្ទាប់ តាម បញ្ញត្តិ មាត្រា ៤៩៤ និង មាត្រា ៤៩៥ នៃ ក្រម ព្រហ្មទណ្ឌ » ។
២ - លោក នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល សង្កាត់ ផ្សារ ថ្មី ទី៣ ត្រូវ អនុវត្ត ដីកា សម្រេច នេះ និង រាយការណ៍ ជូន ចៅក្រម ស៊ើបសួរ ឱ្យ បាន ទៀងទាត់ ក្នុង ករណី ជន ត្រូវ ចោទ គេចវេះ ដោយ ចេតនា មិន អនុវត្ត តាម ដីកា នេះ ។
៣- ក្នុង ករណី ដែល ជន ត្រូវ ចោទ គេចវេះ ដោយ ចេតនា មិន អនុវត្ត តាម ចំណុច ទី១ ត្រូវ ចាប់ ឃុំ ខ្លួន ជន ត្រូវ ចោទ ឡើងវិញ ដោយ អនុវត្ត តាម មាត្រា ២៣០ នៃ ក្រម នីតិវិធី ព្រហ្មទណ្ឌ ។៤ - ដីកា សម្រេច នេះ មាន ប្រសិទ្ធភាព អនុវត្ត ភ្លាម ។
គួរ បញ្ជាក់ ថា សមត្ថកិច្ច កម្ពុជា បាន រកឃើញ មេដឹកនាំ បាតុករ ធ្វើ បាតុកម្ម តវ៉ា ខុស ច្បាប់ នៅមុខ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ គឺ មាន រចនាសម្ព័ន្ធ អង្គការ ចាត់តាំង ច្បាស់លាស់ ដើម្បី បង្ក ភាពវឹកវរ ដល់ សង្គម កម្ពុជា និង ទទួលបាន ថវិកា ពី អង្គការ ក្នុង ស្រុក និង ក្រៅ ប្រទេស ដើម្បី ធ្វើ សកម្មភាព ៕
ការវាយប្រហារ បែប នេះ អាច បង្ក ការបំផ្លិចបំផ្លាញ តាមរយៈ ថាមពល ឃី នេទិក (kinetic energy) និង ឥន្ធនៈ នៅក្នុង មីស៊ីល ហើយ ព្រម ពេល ជាមួយគ្នា វា ទំនងជា មិន បង្ក ការបំផ្លិចបំផ្លាញ ធ្ងន់ធ្ងរ លើ គោលដៅ ដែល រង ការវាយប្រហារ នោះ ទេ ។ ប៉ុន្តែ គួរឱ្យ កត់សម្គាល់ ក្រសួង ការពារ ជាតិ អង់គ្លេស បាន អះអាង ថា ការប្រើប្រាស់ មីស៊ីល គ្រូស ស៊េរី ចាស់ ដោយ ដក ក្បាល គ្រាប់ ចេញ គឺ បង្ហាញ ពី ការថយចុះ នូវ ចំនួន មីស៊ីល រយៈ ចម្ងាយ ឆ្ងាយ នៅក្នុង ស្ដុក របស់ រុស្ស៉ី ៕
ដូច្នេះ សូម រង់ចាំ ទស្សនា កម្មវិធី Fresh Talk ដែល ផ្សាយ ផ្ទាល់ ពី ម៉ោង ៩៖ យប់ នេះ ៕កម្លាំង ការពារ ព្រំដែន កម្ពុជា - ថៃ នៅ ស្រុក ម៉ាឡៃ និង ស្រុក អារញ្ញ ជួប ពិភាក្សា គ្នា ពង្រឹង កិច្ចសហប្រតិបត្តិការ សំដៅ ទប់ស្កាត់ បទល្មើស ខុស ច្បាប់ គ្រប់ ប្រភេទ
( បន្ទាយមានជ័យ )៖ នគរបាល ការពារ ព្រំដែន គោក ប៉ុស្តិ៍ ក្បាល ទំនប់ នៃ វរៈ សេនា តូច លេខ ៨១៥ សហការ ជាមួយ កម្លាំង យោធា ផ្នែក សឹក រង ម៉ាឡៃ បាន ជួប ពិភាក្សា ទ្វេ ភាគី ជាមួយ ទាហាន ( ព្រាន ) ឈុត ខ្មៅ ថៃ អនុ សេនា ធំ លេខ ( ១៣. ០១ ) ដែល ឈរ ជើង ទល់មុខ ភូមិសាស្ត្រ ប៉ុស្តិ៍ ក្បាល សំដៅ ពង្រឹង កិច្ចសហប្រតិបត្តិការ ទប់ស្កាត់ បទល្មើស ខុស ច្បាប់ គ្រប់ ប្រភេទ នៅ តាម បន្ទាត់ ព្រំដែន ។
ជំនួប នៅ ព្រឹក ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ធ្វើឡើង ដោយ អនុវត្ត តាម ការចង្អុលបង្ហាញ ណែនាំ និង ការយកចិត្តទុកដាក់ ពី លោក ឧត្តមសេនីយ៍ ទោ សិទ្ធិ ឡោះ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ និង អនុវត្ត តាម បទបញ្ជា ផ្ទាល់ ពី លោក វរសេនីយ៍ ឯក សួង សៅ មេបញ្ជាការវរៈ សេនា តូច នគរបាល ការពារ ព្រំដែន គោក លេខ ៨១៥ ។
ការជួប ពិភាក្សា គ្នា នេះ ក្នុង គោលបំណង ដើម្បី រឹត ចំណង សាមគ្គីភាព កិច្ចសហប្រតិបត្តិការ និង រួមគ្នា ទប់ស្កាត់ រាល់ បទល្មើស លួច ឆ្លង ដែន ខុស ច្បាប់ គ្រប់ ប្រភេទ និង ជួយ សម្របសម្រួល ដោយ មាន ការយោគយល់ ពី ប្រជាពលរដ្ឋ ទាំង ពីរ ប្រទេស ដែល ចេញ ចូល និង ទៅ ធ្វើការ ទៅ ព្រឹក មក ល្ងាច ៕ វិវាទ របស់ ប្រជាពលរដ្ឋ ប្រើប្រាស់ ទឹក ប្រឡាយ អូរ វ៉ាយ និង ក្រុមហ៊ុន « កំពង់ធំ អ៉ិន វេស មិន ឌី វើឡុប មិន គ្រុប » ត្រូវបាន ដោះស្រាយ បញ្ចប់
( កំពង់ធំ )៖ ក្រោម ការសម្របសម្រួល និង ណែនាំ របស់ លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ លោក សុក ហៃ អភិបាល រង ខេត្ត បាន បន្ដ ដឹកនាំ កិច្ចប្រជុំ ដោះស្រាយ វិវាទ រវាង ប្រជាពលរដ្ឋ ប្រើប្រាស់ ទឹក ប្រឡាយ អូរ វ៉ាយ និង ក្រុមហ៊ុន « កំពង់ធំ អ៉ិន វេស មិន ឌី វើឡុប មិន គ្រុប » ។
ជា លទ្ធផល ប្រជាពលរដ្ឋ អ្នកប្រើប្រាស់ ទឹក ប្រឡាយ អូវ៉ាយ បាន សម្រេច ផ្តល់ សិទ្ធិ ដល់ លោក ជុំ វាសនា ជា សេវាករ ផ្គត់ផ្គង់ ទឹក ជូន ប្រជាពលរដ្ឋ ដោយសារ ក្រុមហ៊ុន « កំពង់ធំ អ៉ិន វេស មិន ឌី វើឡុប មិន គ្រុប » របស់ លោក គិត សៀប ត្រូវបាន ប្រជាពលរដ្ឋ បដិសេធ មិន ទទួលយក ក្រោយពី ការចរចារ តម្លៃ បូម ទឹក មិន ត្រូវ គ្នា និង ផ្តល់ ទឹក មិន គ្រប់គ្រាន់ ធ្វើឲ្យ ស្រូវ របស់ ប្រជាពលរដ្ឋ មួយចំនួន ត្រូវបាន ខូចខាត ។
កន្លងទៅ មាន ការ កំណត់ លក្ខខណ្ឌ ថា « ប្រសិនបើ កសិករ មាន ដៃគូរ ផ្គត់ផ្គង់ ទឹក ថ្មី ក្រុមហ៊ុន ឯកភាព ព្រម ប្រគល់ អូរ ធម្មជាតិ និង ប្រឡាយ ពលរដ្ឋ តែ សុំឲ្យ ប្រជាកសិករ ដែល ជំពាក់ ថ្លៃ ទឹក សង ប្រាក់ ឲ្យបាន គ្រប់ ចំនួន និង ជួយ ទិញ សម្ភារៈ តាម តម្លៃ កិច្ចព្រមព្រៀង » ។ យោង តាម លក្ខខណ្ឌ នេះ លោក ជុំ វាសនា មាន លទ្ធភាព ទទួលយក សម្ភារ និង គោលការណ៍ ធ្វើឲ្យ ប្រជាពលរដ្ឋ ព្រមព្រៀង ទទួលយក លោក ជុំ វាសនា ជា សេវាករ ផ្គត់ផ្គង់ ទឹក ប្រឡាយ អូរ វ៉ាយ ។
ក្នុង ការអនុវត្ត កិច្ចការងារ ជូន ប្រជាពលរដ្ឋ នេះ លោក ជុំ វាសនា ត្រូវបាន អនុញ្ញាតឲ្យ ផ្គត់ផ្គង់ ដល់ កសិករ ឲ្យបាន គ្រប់គ្រាន់ ដល់ កសិករ ក្នុង តម្លៃ ១០៥ ដុល្លារ ក្នុង មួយ ហិកតា ។ លោក បញ្ជាក់ ថា កិច្ចព្រមព្រៀង របស់ លោក ជុំ វាសនា និង លោក គិត សៀប ត្រូវ អនុវត្តន៍ តួនាទី និង ភាកិច្ច របស់ ខ្លួន រួម មាន៖
* ទី២៖ នៅ ថ្ងៃ ប្រគល់ទី១ លោក ជុំ វាសនា មាន សិទ្ធិ គ្រប់គ្រាន់ ក្នុង ការគ្រប់គ្រង និង ផ្គត់ផ្គង់ ទឹក ប្រឡាយ អូរ វ៉ាយ ជូន ប្រជាពលរដ្ឋ អាស្រ័យ ផល ដោយ គ្មាន ការំខាន ណាមួយ ពី លោក គិត សៀប ។
* ទី ៣៖ អាជ្ញាធរ សង្កាត់ ក្រុង ស្ទឹង សែន លោក ជុំ វាសនា និង លោក គិត សៀប ត្រូវតែ រួមគ្នា ដោះស្រាយ បំណុល ដែល ប្រជាពលរដ្ឋ ចំនួន ៧៧ គ្រួសារ ជំពាក់ បំណុល លោក គិត សៀប កន្លងមក ។ ដោយ ក្នុង នោះ លោក គិត សៀប ត្រូវ ចូលរួម ឬ ចាត់ តំណាង រាល់ ការដោះស្រាយ របស់ អាជ្ញាធរ ៕
អភិបាល រង ខេត្ត កំពត ស្នើ ដល់ ពលរដ្ឋ ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ទឹកនោម ផ្អែម ខណ : មន្ត្រី ជំនាញ ព្រួយបារម្ភ អំពី កំណើន នៃ អ្នក កើត ជំងឺ
( កំពត ) ៖ លោកស្រី វេជ្ជបណ្ឌិត យូ សុគន្ធ អភិបាល រង ខេត្ត បាន ស្នើ ដល់ ប្រជាពលរដ្ឋ ឱ្យ ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ទឹកនោម ផ្អែម ខណៈ មន្ទីរ ជំនាញ ពាក់ព័ន្ធ ព្រួយបារម្ភ អំពី កំណើន នៃ អ្នក កើត ជំងឺ ទឹកនោម ផ្អែម ។
លោកស្រី វេជ្ជបណ្ឌិត យូ សុគន្ធ បាន បន្ត ថា ជំងឺ ទឹកនោម ផ្អែម បណ្តាល មកពី ការបរិភោក អាហារ មិន មាន សុខភាព និង កង្វះ ការហាត់ប្រាណ ផលវិបាក នៃ ជំងឺ នេះ គឺ ធ្វើឲ្យ ខូច បេះដូង ខូច ភ្នែក ខូច តម្រង់ នោម ដំបៅ ជើង រហូត អាច បណ្តាលឲ្យ កាត់ ជើង ។ ការព្យាបាល ជំងឺ ទឹកនោម ផ្អែម ត្រូវ ធ្វើឡើង មួយ ជីវិត មិន មាន ថ្នាំ ព្យាបាល ឲ្យ ជាដាច់ ទេ ។ ប៉ុន្តែ ជំងឺ នេះ អាច ការពារ បាន តាមរយៈ ការបរិភោគ អាហារ មាន សុខភាព និង ហាត់ប្រាណ ឲ្យបាន ត្រឹមត្រូវ និង ទៀត ទាត់ ។
ក្នុង ឱកាស នោះ ដែរ លោក វេជ្ជបណ្ឌិត ញា ប៊ុន ថន ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត កំពត បាន លើក បញ្ជាក់ ថា ជំងឺ ទឹកនោម ផ្អែម បាន ក្លាយជា បញ្ហា សុខភាព សាកល តាម របាយការណ៍ នៅ ឆ្នាំ ២០១៧ ពិភពលោក មាន អ្នកជំងឺ ទឹកនោម ផ្អែម ចំនួន ៤២៥ លាន នាក់ ហើយ អ្នកជំនាញ ព្យាករណ៍ ថា នៅ ឆ្នាំ ២០៣០ អាចនឹង កើន ដល់ ៩៤២លាន់ នាក់ ។
លោក វេជ្ជបណ្ឌិត ញា ប៊ុន ថន បន្ត ថា ពិធី អបអរ ទិវា ទឹកនោម ផ្អែម ពិភពលោក ដែល បាន ធ្វើឡើង នា ថ្ងៃ នេះ ទើប ធ្វើឡើង ជា លើក ទី១ ដើម្បី លើកកម្ពស់ ការយល់ដឹង អំពី ផល ប៉ះពាល់ ដែល បង្កឡើង ដោយ ជំងឺ ទឹកនោម ផ្អែម មក លើ ក្រុមគ្រួសារ លើកកម្ពស់ ការអប់រំ ការការពារ និង ការគ្រប់គ្រង ជំងឺ ទឹកនោម ផ្អែម និង ជំរុញ ចលនា ពិភពលោក រួមគ្នា ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ទឹកនោម ផ្អែម ដែល ជា បញ្ហា សុខភាព សាកល ដ៏ សំខាន់ មួយ ។
លោក ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត បាន បញ្ជាក់ ថា តាម របាយការណ៍ កំណើន នៃ អ្នក កើ ជំងឺ ទឹកនោម ផ្អែម មាន ការកើនឡើង គួរឲ្យ ព្រួយបារម្ភ ហើយ រៀងរាល់ ៨វិនាទី មាន អ្នកជំងឺ ទឹកនោម ផ្អែម ស្លាប់ ១ ម្នាក់ ៕
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃសៅរ៍ ទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន បង្ហាញ ឈុត សម្តែង ថ្មី មួយ ទៀត នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី ។
ឈុត សម្តែង ដែល សម្តេច តេជោ បាន បង្ហាញ នេះ គឺ នៅ ត្រង់ វគ្គ មេបញ្ជាការ « សំរេច » រងរបួស ភ្នែក លើ សមរភូមិ ក្នុង ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ១៩៧៥ ពោល មួយ ថ្ងៃ មុន កងទ័ព រំដោះ វាយ ផ្តួល របប សាធារណរដ្ឋ របស់ លន់ នល់ ។
របួស ពេល នោះ បាន ធ្វើឱ្យ សម្តេច តេជោ ពិការ ភ្នែក ខាងឆ្វេង រហូតមកដល់ បច្ចុប្បន្ន ។
សូម បញ្ជាក់ ថា ឈុត សម្តែង នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌ មី ចំនួន ៤ឃ្លីប ហើយ ត្រូវបាន សម្តេច តេជោ បង្ហាញ ជាសាធារណៈ ។ ឈុត សម្តែង ដែល សម្តេច តេជោ ទម្លាយ ទទួលបាន ការចាប់អារម្មណ៍ ជាខ្លាំង ពី សាធារណជន ។
នាយ ឧត្តមសេនីយ៍ នេត សាវឿន ថ្លែងអំណរគុណ កម្លាំង នគរបាល ទូទាំង រាជធានី ភ្នំពេញ ដែល ខិតខំ ការពារ សុវត្ថិភាព ដំណើរការ រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ - ៤១ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ
« កិច្ច ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ របស់ ឯកឧត្តម និង មន្ត្រី នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ គឺជា សក្ខីកម្ម ឆ្លុះបញ្ចាំង ឱ្យ ឃើញ អំពី សុឆន្ទៈ និង មនសិការ ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ធ្វើឱ្យ បេសកកម្ម ជា ប្រវត្តិសាស្ត្រ ប្រកបដោយ មោទនភាព ជាតិ នេះ សម្រេចបាន ជោគជ័យ យ៉ាង ត្រចះត្រចង់ ដែល សកម្មភាព ដ៏ ឧត្តុង្គឧត្តម នេះ បាន ចូលរួម លើកស្ទួយ កិត្តិយស និង កិត្យានុភាព ជាតិ នៅលើ ឆាក អន្តរជាតិ » ។
( ភ្នំពេញ ) ៖ សមាគម យុវជន សេដ្ឋកិច្ច កម្ពុជា បាន ចេញ សារលិខិត អបអរសាទរ ជូន ចំពោះ លោក ខូយ រីដា ដែល ទើប ត្រូវបាន ព្រះករុណា ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង លោក ជា អភិបាល ខេត្ត ពោធិ៍សាត់ ។
គួរ ជម្រាប ថា នា ពាក់កណ្ដាល ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ត្រាស់បង្គាប់ តែងតាំង លោក ខូយ រីដា ជា អភិបាល ខេត្ត ពោធិ៍សាត់ ។ លោក ត្រូវបាន ប្រកាស ចូលកាន់ មុខតំណែង ជា ផ្លូវការ ក្រោម អធិបតីភាព សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ កាលពី ថ្ងៃទី ២១ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ៕
ខាងក្រោម នេះ ជា សារលិខិត អបអរសាទរ របស់ សមាគម យុវជន សេដ្ឋកិច្ច កម្ពុជា ជូន ចំពោះ លោក ខូយ រី ដា៖ មូលដ្ឋាន ល្បាត របស់ យោធា អាមេរិក ក្នុង ប្រទេស ស៊ីរី រង ការវាយប្រហារ ដោយ គ្រាប់ រ៉ុក្កែត
( វ៉ាស៊ីនតោន ) ៖ យោធា អាមេរិក បាន រាយការណ៍ ថា មូលដ្ឋាន ល្បាត របស់ ខ្លួន ក្នុង តំបន់ ភាគ ឦសាន នៃ ប្រទេស ស៉ីរី បាន រង ការវាយប្រហារ ដោយ រ៉ុក្កែត ២គ្រាប់ ប៉ុន្តែ មិន មាន កងកម្លាំង ណា ម្នាក់ រងរបួស នោះ ទេ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសៅរ៍ ទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
គួរ បញ្ជាក់ ថា បើ តាម លោក ប្រធានាធិបតី ហ្សេលេន ស្គី ប្រជាជន អ៊ុយក្រែន ច្រើន ជាង ៦លាន នាក់ នៅតែ បន្ត គ្មាន អគ្គិសនី ប្រើប្រាស់ ចំពេល រដូវ រងា បាន ចូលមក ហើយ បន្ទាប់ពី រុស្ស៉ី វាយប្រហារ បំផ្លាញ ហេដ្ឋារចនាសម្ព័ន្ធ ថាមពល នៅ ទូទាំង ប្រទេស អ៊ុយក្រែន ក្នុង រយៈពេល ២ ថ្ងៃ ចុងក្រោយ នេះ ៕
ក្រសួង វប្បធម៌ នឹង រៀបចំ ព្រឹត្តិការណ៍ រាត្រី សមោស រសប្បុរសធម៌ នៅ បរិវេណ ប្រាសាទ បាយ័ន ស្វែងរក ថវិកា ជួយ មន្ទីរពេទ្យ គន្ធ បុប្ផា (Video inside) ( ភ្នំពេញ ) ៖ ដើម្បី អបអរសាទរ ខួប លើក ទី ៣០ ឆ្នាំ នៃ ការដាក់បញ្ចូល រមណីយដ្ឋាន អង្គរវត្ត ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក របស់ អង្គការ យូណេស្កូ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ សហការ ជាមួយ អាជ្ញាធរ ជាតិ អប្សរា នឹង រៀបចំ ព្រឹត្តិការណ៍ រាត្រី សមោស រ សប្បុរសធម៌ នៅ បរិវេណ ប្រាសាទ បាយ័ន ដើម្បី ស្វែងរក ថវិកា ជួយ ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ។
កម្មវិធី នេះ នឹង ប្រារព្ធ រៀបចំឡើង នៅ ថ្ងៃសុក្រ ទី ១៦ ខែធ្នូ ឆ្នាំ ២០២២ វេលា ម៉ោង ៦៖៣០ នាទី យប់ ។ នេះ បើ តាម លោក បណ្ឌិត ហ៉ី វីរៈ រដ្ឋលេខាធិការ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ។
លោក បន្ថែម ថា កម្មវិធី នេះ ក៏ ឲ្យ លោក អ្នក ទទួលបាន សុខ ទាំង កាយ សប្បាយ អារម្មណ៍ សន្សំ បុណ្យ ជាមួយ កុមារ កម្ពុជា ! សូម កុំ បណ្តោយ ឱ្យ ឱកាស ដ៏ កម្រ នេះ ក្លាយជា វេលា ដែល រសាត់ បាត់ ទៅ ប្រៀប ដូចជា ផ្សែង រសាត់ តាម ខ្យល់ គ្មាន អ្នក ខ្វល់ គ្មាន អ្នក នឹក នា ៕
គួរ បញ្ជាក់ ថា បើ តាម សហរដ្ឋ អាមេរិក សង្រ្គាម ឈ្លានពាន របស់ រុស្ស៉ី លើ អ៊ុយក្រែន បាន ធ្វើឱ្យ កងទ័ព ទាំង សងខាង ស្លាប់ និង របួស រាប់ ម៉ឺន នាក់ ហើយ ជម្លោះ នេះ បាន បង្កឱ្យ មាន ការប្រឈមមុខ គ្នា ខ្លាំងក្លា បំផុត រវាង រុស្ស៉ី និង ក្រុម លោក ខាងលិច ចាប់តាំងពី វិបត្តិ មីស៉ីល គុយ បា ឆ្នាំ ១៩៦២មក ។
ទាហាន រុស្ស៉ី រាប់ សែន នាក់ ត្រូវបាន បញ្ជូន ឱ្យ ទៅ ប្រយុទ្ធ ក្នុង សង្រ្គាម របស់ លោក ពូទីន នៅ អ៊ុយក្រែន ក្នុង នោះ រួម មាន ទាំង មួយចំនួន នៃ ទាហានបម្រុង ជាង ៣០០.០០០ នាក់ ដែល ត្រូវបាន កោះហៅ នៅក្រោម ចំណាត់ការកេណ្ឌ ទ័ព បន្ថែម ដែល ប្រកាស ដោយ លោក ប្រធានាធិបតី រុស្ស៉ី កាលពី ខែកញ្ញា ។
លោក ពូទីន ធ្លាប់ បាន អះអាង ថា លោក មិន ស្តាយក្រោយ បន្តិច សោះឡើយ អំពី ការចាប់ផ្តើម នូវ អ្វី ដែល លោក ហៅ ថា « ប្រតិបត្តិការ យោធា ពិសេស » ប្រឆាំង លើ អ៊ុយក្រែន ហើយ បាន ប្រកាស អះអាង ថា សង្រ្គាម នេះ គឺជា ពេល ដែល រុស្ស៉ី ត្រូវ ងើប ឈរ ឡើង ប្រឆាំង នឹង អនុត្តរភាព របស់ លោក ខាងលិច ដ៏ ក្រអឺត ក្រទម ក្រោយ រង ការមើលងាយ ធ្វើបាប ក្រោម ក្តី អាម៉ាស់ អស់ រយៈពេល ជាច្រើន ឆ្នាំ ចាប់តាំងពី ការដួលរលំ នៃ សហភាព សូវៀត នៅ ឆ្នាំ ១៩៩១ ។
ប៉ុន្តែ អ៊ុយក្រែន និង ក្រុម លោក ខាងលិច វិញ បាន លើកឡើង ថា លោក ពូទីន ពុំ មាន ហេតុផល ត្រឹមត្រូវ អ្វី នោះ ឡើយ សម្រាប់ ទង្វើ ដែល ពួកគេ ហៅ ថា ជា ការធ្វើ សង្រ្គាម បែប ចក្រពត្តិ ដើម្បី ត្រួតត្រា ប្រទេស ដទៃ ។ ទីក្រុង កៀវ បាន ប្តេជ្ញា ថា ខ្លួន នឹង ប្រយុទ្ធ ដល់ ចុងបញ្ចប់ គឺ ទាល់តែ ទាហាន រុស្ស៉ី ចុងក្រោយ ត្រូវបាន វាយ បណ្តេញ ឱ្យ ចេញ ផុត ពី ទឹកដី អ៊ុយក្រែន ។
ក្រសួង ដាក់ ផែនការបណ្តុះបណ្តាល អ្នកបម្រើការ ទេសចរណ៍ នៅ ខេត្ត ប៉ៃលិន ជាង ១០០ នាក់ ក្នុង ឆ្នាំ ២០២៣
( ប៉ៃលិន ) ៖ ក្រសួង ទេសចរណ៍ បាន ដាក់ គោលដៅ ជំរុញ ការបណ្តុះបណ្តាល បដិសណ្ឋារកិច្ច ហូកា (HoKa) នៅ ខេត្ត ប៉ៃលិន ក្នុង នោះ នឹង ផ្តល់ ការបណ្តុះបណ្តាល ដល់ គ្រូ បង្គោល ចំនួន ១៣នាក់ និង អ្នកជំនាញ ទេសចរណ៍ ចំនួន ១០០ នាក់ នៅ ឆ្នាំ ២០២៣ ខាងមុខ ដើម្បី លើកកម្ពស់ សេវាកម្ម ទេសចរណ៍ ក្រោយ វិបត្តិ ជំងឺ កូវីដ - ១៩ ។
លោក ជួប រតនា ប្រធាន នាយកដ្ឋាន ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ និង ជា ប្រធាន លេខាធិការដ្ឋាន គ. គ.ហ. បាន ឱ្យដឹង ថា ដោយ ទទួលបាន ការចង្អុលបង្ហាញ ពី លោក រដ្ឋមន្ត្រី ថោង ខុន គណៈកម្មការគ្រប់គ្រង គម្រោង ហូកា បាន ពង្រីក វិសាលភាព ការបណ្តុះបណ្តាល បដិសណ្ឋារកិច្ច ទៅ ខេត្ត គោលដៅ ថ្មី ចំនួន ៥ទៀត នៅ ជុំវិញ បឹង ទន្លេ សាប រួម មាន ខេត្ត ពោធិ៍សាត់ បាត់ដំបង ប៉ៃលិន បន្ទាយមានជ័យ និង ឧត្តរមានជ័យ ។
លោក បន្ត ថា « សម្រាប់ ខេត្ត ប៉ៃលិន នៅ ឆ្នាំ ២០២៣ ខាងមុខ នេះ គម្រោង នឹង ផ្តល់ ការបណ្តុះបណ្តាល ដល់ គ្រូ បង្គោល ចំនួន ១៣នាក់ និង អ្នកជំនាញ ទេសចរណ៍ ចំនួន ១០០ នាក់ លើ ជំនាញ សេវាកម្ម ម្ហូប អាហារ និង ភេសជ្ជៈ ការិយាល័យ ជួរ មុខ និង ជំនាញ គេហកិច្ច » ។
លោក ប៉ាក់ សុខុម បាន ស្នើ ដល់ ប្រតិបត្តិករ ទេសចរណ៍ ទាំងអស់ នៅក្នុង ខេត្ត ប៉ៃលិន ដែល បាន សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ រដ្ឋបាល ខេត្ត និង មន្ទីរ ទេសចរណ៍ ដើម្បី អនុវត្ត នូវ ច្បាប់ និង វិធាន នានា របស់ ក្រសួង ទេសចរណ៍ ដែល ធ្វើឱ្យ ខេត្ត ប៉ៃលិន រីក មុខ រីក មាត់ យ៉ាង ខ្លាំង ក្នុង ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ។
ប្រជាការពារ នៅ ទូទាំង ស្រុក ពញា ឮ ខេត្ត កណ្តាល ជាង ២ពាន់ នាក់ ទទួលបាន អង្ករ ៥០ គីឡូក្រាម និង ថវិកា ៥ម៉ឺន រៀល ពី លោក លឹម គាន ហោ
( កណ្តាល ) ៖ ដោយ មើលឃើញ ពី តួនាទី យ៉ាង សំខាន់ របស់ ប្រជាការពារ នៅ តាម បណ្តាល ឃុំ នៅ ទូទាំង ស្រុក ពញា ឮ ដែល បាន ចូលរួមចំណែក យ៉ាង ច្រើន លើកកិច្ច រក្សា សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ ជាមួយ អាជ្ញាធរ ក៏ ដូចជា មន្ត្រី នគរបាល នោះ . លោក លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ជា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក ពញា ឮ ខេត្ត កណ្តាល បាន ចាត់ ឱ្យ ក្រុមការងារ បាន នាំយក អង្ករ និង ថវិកា ចែកជូន ដល់ ក្រុម ប្រជាការពារ ទាំងនោះ ដោយ ក្នុង ម្នាក់ ៗ ទទួលបាន អង្ករ ៥០ គីឡូក្រាម និង ថវិកា ៥០.០០០ រៀល ។
នៅ ស្រុក ពញា ឮ ខេត្ត កណ្តាល មាន ឃុំ ចំនួន ១១ និង មាន កម្លាំង ប្រជាការពារ ចំនួន ២. ០៩២នាក់ ហើយ គិត ត្រឹម ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ អំណោយ និង ថវិកា របស់ លោក លឹម គាន ហោ ត្រូវបាន នាំ ទៅ ប្រគល់ ជូន ដល់ ប្រជាការពារ បាន ចំនួន ៥ឃុំ ហេីយ នៅសល់ ៦ឃុំ ទៀត ក្រុមការងារ នឹង នាំទៅ ប្រគល់ ជូន ជា បន្តបន្ទាប់ ។
ជាក់ស្តែង កាលពី ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ក្រុមការងារ ចុះ មូលដ្ឋាន ទទួលបន្ទុក ប្រជាការពារ ស្រុក ពញា ឮ រួម ជាមួយ គណៈកម្មាធិការ គណបក្ស ស្រុក ពញា ឮ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ វិហារ ហ្លួង និង ឃុំ កំពង់ អុស បាន ធ្វើ ការជួប សំណេះសំណាល ជាមួយ បងប្អូន ប្រជាការពារ ក្នុង ឃុំ វិហារ ហ្លួង មាន ចំនួន ១១៤នាក់ និង ឃុំ កំពង់ អុស មាន ចំនួន ១៤០ នាក់ ។
នា ឱកាស នេះ ដែរ ប្រធាន ក្រុមការងារ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ ឯកឧត្តម លឹម គាន ហោ ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក ពញា ឮ ជូន ចំពោះ បងប្អូន ប្រជាការពារ ទាំងអស់ និង បាន ជម្រាប ជូន អំពី តួនាទី និង ភារកិច្ច របស់ ប្រជាការពារ តាម ភូមិ ឃុំ ដើម្បី ភូមិ ឃុំ យើង មាន សុវត្ថិភាព សន្តិសុខ និង បរិស្ថាន ល្អ ក្នុង មូលដ្ឋាន នីមួយ ៗ ។
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បាន សព្វ ព្រះរាជ ហឫទ័យ ត្រាស់បង្គាប់ ដំឡើង ឋានន្តរស័ក្តិ និង ថ្នាក់ ជូន ដល់ ចៅក្រម ចំនួន ១៧០ រូប ។
ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ ដំឡើង ឋានន្តរស័ក្តិ និង ថ្នាក់ ដល់ ព្រះរាជអាជ្ញា ១១១ រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បាន សព្វ ព្រះរាជ ហឫទ័យ ត្រាស់បង្គាប់ ដំឡើង ឋានន្តរស័ក្តិ និង ថ្នាក់ ជូន ដល់ ព្រះរាជអាជ្ញា ចំនួន ១១១ រូប ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ២៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ២៩ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ២៩ នាក់ នោះ មាន ១២នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្ន បទល្មើស ព្រហ្មទណ្ឌ ០៩ ករណី និង ជនសង្ស័យ ១៧នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ០៩ ករណី ។
ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សមាជិក បក្ស ក្នុង រាជធានី ភ្នំពេញ ជាង ៣ពាន់ នាក់
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឋានៈ ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ក្នុង រាជធានី ភ្នំពេញ សរុប ជាង ៣ពាន់ នាក់ ។
ឈុត សម្តែង ដែល សម្តេច តេជោ បាន បង្ហាញ នេះ គឺ នៅ ត្រង់ វគ្គ មេបញ្ជាការ « សំរេច » បាន ដឹកនាំ កងទ័ព នៅក្នុង អង្គភាព ចុះ ទៅ ជួយ ប្រមូល ផល ពោត របស់ ប្រជាពលរដ្ឋ ។ ឈុត នេះ គឺជា ឈុត មួយ ស្ថិត ក្នុង ដំណាក់កាល ដែល កងទ័ព រំដោះ កំពុង ធ្វើ ការតស៊ូ ដើម្បី វាយ ផ្តួលរំលំ របប សាធារណរដ្ឋ ដើម្បី អំណាច ថ្វាយ សម្តេច ព្រះបរម រតន កោដ្ឋ នរោត្តម សីហនុ ។
សម្តេច តេជោ ហ៊ុន សែន បាន គូស រំលេច ថា ឈុត សម្តែង នេះ គឺជា ការបង្ហាញ ពី ទិដ្ឋភាព ទំនាក់ទំនង រវាង កងទ័ព និង ប្រជាជន កាលពី សម័យ នោះ ។
សូម បញ្ជាក់ ថា នៅ ថ្ងៃសុក្រ ទី ២៥ ខែវិច្ឆិកា សម្តេច តេជោ ក៏ បាន បង្ហាញ ឈុត សម្តែង ពីរ ឃ្លីប ផងដែរ ។ ឈុត សម្តែង ដែល សម្តេច តេជោ បាន បង្ហាញ កាលពី ម្សិលមិញ នៅ ត្រង់ វគ្គ ដែល សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ទៅ លេង លោកឪពុក អ្នកម្តាយ ហើយ ប្រាប់ ពី ការពិការ ភ្នែក និង ប្រកាស ពី ការវាយ ផ្តួលរំលំ របប អាវ ខ្មៅ ប៉ុល ពត ។
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃសៅរ៍ ទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន បង្ហាញ ឈុត សម្តែង ថ្មី មួយ ទៀត នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី ។ ឈុត សម្តែង ដែល សម្តេច តេជោ បាន បង្ហាញ នេះ គឺ នៅ ត្រង់ វគ្គ មេបញ្ជាការ « សំរេច » បាន ស្គាល់ មុខ អ្នកគ្រូពេទ្យ រ៉ានី ជា លើក ដំបូង ។
មេបញ្ជាការ « សំរេច » និង អ្នកគ្រូពេទ្យ រ៉ានី ត្រូវបាន គេ ចំអន់ និង ផ្គូផ្គង់ ជា គូ ស្នេហ៍ ទាំង មិន ដែល បាន ជួបគ្នា ។ ដើម្បី ជម្រះ មន្ទិល និង ការពារ កិត្តិយស អ្នកគ្រូពេទ្យ រ៉ានី ផង នោះ ទើប មេបញ្ជាការ « សំរេច » ស្នើ ឱ្យ មាន ការជួបគ្នា ដើម្បី ដោះស្រាយ លើ ការយល់ ច្រឡំ មួយ នេះ ។
ការជួប នេះ មិន បាន ដោះស្រាយ បញ្ហា យល់ ច្រឡំ នេះ តែ បែរជា ធ្វើឱ្យ មេបញ្ជាការស្រស់ សង្ហា បាក់ចិត្ត លង់ ស្នេហ៍ ជំពាក់ បេះដូង ស្រាយ មិន រួច ពី អ្នគ្រូពេទ្យ ដ៏ ស្រស់ សភា ។ ដោយ អំណាច ស្នេហ៍ ដ៏ ជ្រាលជ្រៅ ចំពោះ អ្នកគ្រូពេទ្យ ក្រមុំ ហើយ មិន ចង់ ចាកចេញ ទៅ នោះ លោក មេបញ្ជាការ « សំរេច » ក៏ បាន រក ល្បិច ធ្វើឱ្យ ម៉ូតូ មិន ឆេះ ហើយ បង្អាក់ ដំណើរ បាន ស្នាក់ នៅ មួយ យប់ នៅ កន្លែង អ្នកគ្រូពេទ្យ រ៉ានី បំពេញ ការងារ ។
ឥទ្ធិពល ស្នេហ៍ បាន ធ្វើឱ្យ លោក មេបញ្ជាការ « សំរេច » ចាកចេញ ពី កន្លែង អ្នកគ្រូពេទ្យ រ៉ានី បំពេញ ការងារ ទាំង មិន អស់ អាល័យ ។
ជាមួយ ការបង្ហាញ ឈុត សម្តែង នេះ សម្តេច តេជោ ហ៊ុន សែន បាន គូស រំលេច ថា ជា ឈុត ដែល ឃើញ ភ្លាម ស្រឡាញ់ ភ្លាម និង ចេះ កុហក់ ព្រោះ ស្រឡាញ់ ។ សម្តេច តេជោ បាន គូស រំលេច ទៀត ថា សម្តេច និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជា គូរ ព្រេង មិន ព្រាត់ ។
សូម បញ្ជាក់ ថា ឈុត សម្តែង នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌ មី ចំនួន ៦ឃ្លីប ហើយ ត្រូវបាន សម្តេច តេជោ បង្ហាញ ជាសាធារណៈ ។ ឈុត សម្តែង ដែល សម្តេច តេជោ ទម្លាយ ទទួលបាន ការចាប់អារម្មណ៍ ជាខ្លាំង ពី សាធារណជន ។
នាយ ឧត្តមសេនីយ៍ សៅ សុខា ទៅ ទទួល អដ្ឋិធាតុ យុទ្ធជន កម្ពុជា ៤៩ នាក់ ពី វៀតណាម នាំ ត្រឡប់មក កម្ពុជា វិញ
( វៀតណាម ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា ប្រធាន ក្រុមការងារ បច្ចេកទេស បាន ដឹកនាំ ប្រតិភូ និង ក្រុមការងារ បច្ចេកទេស កម្ពុជា ទៅ ទទួល អដ្ឋិធាតុ យុទ្ធជន កងកម្លាំងប្រដាប់អាវុធ សាមគ្គី សង្រ្គោះ ជាតិ កម្ពុជា សរុប ចំនួន ៤៩ នាក់ / កោដ្ឋិ ពី ប្រទេស វៀតណាម នាំយក មក ប្រទេស កម្ពុជា វិញ ។
គួរ ជម្រាប ថា អដ្ឋិធាតុ យុទ្ធជន កម្ពុជា ទាំងនោះ ត្រូវបាន រក្សាទុក នៅ បូជនីយដ្ឋាន យុទ្ធជន ពលី កម្ពុជា ស្ថិត នៅ ភូមិ សួស រ៉ាំ ឃុំ ឡុង យ៉ាវ ស្រុក កាំមី ខេត្ត ដុងណាយ ( ដូន ណៃ ) ប្រទេស វៀតណាម ។ ខេត្ត ដុងណាយ នេះ គឺជាប់ ខាងកើត ទីក្រុង ហូជីមិញ ( ព្រៃ នគរ ) ។
គេ ហៅ ពិធី នេះ ថា « ពិធី បើក ផ្នូរ យុទ្ធជន កងកម្លាំងប្រដាប់អាវុធ សាមគ្គី សង្រ្គោះ ជាតិ កម្ពុជា » ដែល បាន ធ្វើឡើង ព្រឹក ថ្ងៃទី ២៦ ខែវិចិ្ឆកា ឆ្នាំ ២០២២ ។
នា ពិធី នោះ នាយ ឧត្តមសេនីយ៍ សៅ សុខា ក្នុង នាម ក្រុមការងារ បច្ចេកទេស មាតុភូមិ និវត្តន៍ អដ្ឋិធាតុ យុទ្ធជន កងកម្លាំងប្រដាប់អាវុធ សាមគ្គី សង្រ្គោះ ជាតិ កម្ពុជា គណៈកម្មការ អន្តរ ក្រសួង នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ថ្លែងអំណរគុណ ជូន ចំពោះ បក្ស រដ្ឋាភិបាល កងទ័ព និង ប្រជាជន វៀតណាម ដែល បាន ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ ចលនា ឆ្ពោះទៅ ផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ និង ដោយ ផ្ទាល់ ។
លោក ថា យោធ ភូមិភាគ ទី៧ អាជ្ញាធរ និង ប្រជាជន វៀតណាម ខេត្ត ដុងណាយ បាន ផ្តល់ ការគាំទ្រ ជួយ ឧបត្ថម្ភ ចែករំលែក ក្នុង ស្ថានភាព ដែល ប្រទេស នេះ ទើប រំដោះ ខ្លួន ឯកភាព ជាតិ និង ទឹកដី ដល់ ការបង្កើត កងកម្លាំងប្រដាប់អាវុធ សាមគ្គី សង្រ្គោះ ជាតិ កម្ពុជា តាម សំណូមពរ របស់ សម្ដេច តេជោ ហ៊ុន សែន កាល នៅ ជា យុទ្ធជន ដូចគ្នា ។
លោក នាយ ឧត្តមសេនីយ៍ បាន បន្ត ថា ជាង ៤៤ ឆ្នាំ បាន កន្លងផុត ទៅ យុទ្ធ មិត្ត ចំនួន ៤៩ នាក់ ដែល បាន ពលី និង មរណៈ ក្នុង កាលៈទេសៈ ដ៏ លំបាក នោះ គឺ បាន បញ្ចុះ នៅក្នុង ខេត្ត ដុងណាយ នេះ ហើយ មិត្ត វៀតណាម បាន ប្រមូលផ្តុំ រៀបចំ ជា បូជនីយដ្ឋាន យុទ្ធជន ពលី កម្ពុជា ដោយ បាន ការយកចិត្តទុកដាក់ ផ្តល់ ដី ផ្តល់ ប័ណ្ណ ទទួលស្គាល់ ពី ក្រសួង វប្បធម៌ ដោយ ទុក តំបន់ នោះ ជា តំបន់ ប្រវត្តិសាស្ត្រ ។
ទោះបី អដ្ឋិធាតុ យុទ្ធជន ទាំង ៤៩ នាក់ បាន ធ្វើ មាតុភូមិ និវត្តន៍ តែ ដើម្បី ថែរក្សា តំបន់ ប្រវត្តិសាស្ត្រ និង គុណ តម្លៃ មិត្តភាព វៀតណាម - កម្ពុជា តាម សំណូមពរ របស់ ភាគី កម្ពុជា មិត្ត វៀតណាម នឹង បន្ត រៀបចំ សិលា ចារិក ដោយ រក្សាទុក តំបន់ នេះ ជា កេរ ដំណែល ប្រវត្តិសាស្ត្រ ជា ភស្ភុតាង នៃ សច្ចធម៌ ប្រវត្តិសាស្ត្រ សម្រាប់ អ្នកសិក្សា ស្រាវជ្រាវ ទេសចរណ៍ និង ជា ការរំលឹក ចងចាំ អំពី មិត្តភាព កម្ពុជា - វៀតណាម ។
លទ្ធផល បណ្ដោះអាសន្ន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ សម្រាប់ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នៅ ទូទាំង ប្រទេស មាន ដូច ខាងក្រោម៖
គិត ត្រឹម ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ លទ្ធផល បណ្ដោះអាសន្ន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ទទួលបាន ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃសៅរ៍ ទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន បង្ហាញ ឈុត សម្តែង ថ្មី មួយ ទៀត នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី ។ ឈុត សម្តែង ដែល សម្តេច តេជោ បាន បង្ហាញ នេះ គឺ នៅ ត្រង់ វគ្គ មេបញ្ជាការ « សំរេច » បាន ដឹង ថា យុទ្ធ មិត្ត ម្នាក់ បាន ស្លាប់ លើ សមរភូមិ ក្នុង ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ១៩៧៥ ។
យុទ្ធ មិត្ត ដែល ពលី ជីវិត នេះ មាន ឈ្មោះ សាន់ ។ ក្រោយ ទទួល ដំណឹង នេះ មេបញ្ជាការ « សំរេច » ដែល កំពុង ព្យាបាល របួស ភ្នែក កើត ក្តី សង្វេគ ចិត្ត និង តក់ស្លុត ជាខ្លាំង ។
សូម បញ្ជាក់ ថា ឈុត សម្តែង នៅក្នុង ភាពយន្ត កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌ មី ចំនួន ៥ឃ្លីប ហើយ ត្រូវបាន សម្តេច តេជោ បង្ហាញ ជាសាធារណៈ ។ ឈុត សម្តែង ដែល សម្តេច តេជោ ទម្លាយ ទទួលបាន ការចាប់អារម្មណ៍ ជាខ្លាំង ពី សាធារណជន ។
អនុប្រធាន ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ជាតិ អំពាវនាវ ដល់ គ្រូពេទ្យ ទាំងអស់ ទៅ ចុះបញ្ជី នៅ គណៈ គ្រូពេទ្យ កម្ពុជា ដើម្បី ប្រកប វិជ្ជាជីវៈ វេជ្ជសាស្ដ្រ
( ភ្នំពេញ ) ៖ លោក សាស្ដ្រចារ្យ ឡាំ អេង ហួរ អនុប្រធាន ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ជាតិ នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន អំពាវនាវ ដល់ គ្រូពេទ្យ ទាំងអស់ ទៅ ចុះបញ្ជី នៅ គណៈ គ្រូពេទ្យ កម្ពុជា ដើម្បី ប្រកប វិជ្ជាជីវៈ វេជ្ជសាស្ដ្រ នៅក្នុង ប្រទេស កម្ពុជា ។
ការអំពាវនាវ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក សាស្ដ្រចារ្យ ឡាំ អេង ហួរ តំណាង លោក សាស្ដ្រាចារ្យ ធា គ្រុយ ប្រធាន ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ជាតិ អញ្ជើញ ចូលរួម ក្នុង វេទិកា វេជ្ជសាស្ដ្រ ឆ្នាំ ២០២២ នៅ សាកលវិទ្យាល័យ អន្ដរជាតិ នា ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
លោក សាស្ដ្រចារ្យ ឡាំ អេង ហួរ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ក្នុង នាម គណៈ គ្រូពេទ្យ ជាតិ និង ក្នុង នាម ខ្លួនខ្ញុំ ផ្ទាល់ សូមអញ្ជើញ គ្រូពេទ្យ ទាំងអស់ សូម ទៅ ចុះបញ្ជី នៅ គណៈ គ្រូពេទ្យ កម្ពុជា សម្រាប់ បំពេញ លក្ខខណ្ឌ ដើម្បី ប្រកប វិជ្ជាជីវៈ វេជ្ជសាស្ដ្រ នៅក្នុង ប្រទេស កម្ពុជា » ។
បើ តាម អនុប្រធាន ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ជាតិ បាន ធ្វើ ការបញ្ជាក់ ផងដែរ ការផ្ដល់ សេវា សុខាភិបាល គឺជា ការបំពេញ តួនាទី ដែល ជា ករណី កិច្ច ប្រកក ដោយ វិជ្ជាជីវៈ ខ្ពស់ ក្រមសីលធម៌ ជា គ្រូពេទ្យ ជូន ដល់ អ្នកជំងឺ ។
លោក សាស្ដ្រចារ្យ ឡាំ អេង ហួរ បាន បញ្ជាក់ ថា គ្រូពេទ្យ ទាំងអស់ ដែល មិន ទាន់ បាន ចុះបញ្ជី គណៈ គ្រូពេទ្យ ហាម ដាច ខាត មិន ឲ្យ ធ្វើ ការពិនិត្យ និង ព្យាបាល ជំងឺ ឡើយ ។ ហើយ ចំពោះ គ្រូពេទ្យ ត្រូវតែ មក ចុះបញ្ជី គណៈ គ្រូពេទ្យ និង បន្ដ អាជ្ញា បណ្ណ នៃ ការអភិវឌ្ឍន៍ វិជ្ជាជីវៈ វេជ្ជសាស្ដ្រ ទើប អាច ធានា បាន ថា ជា គ្រូពេទ្យ ពេញលេញ និង មាន សមត្ថភាព គ្រប់គ្រាន់ ។
លោក សាស្ដ្រចារ្យ ឡាំ អេង ហួរ បន្ដ ថា គ្រូពេទ្យ ពេញលេញ មាន ន័យ ថា គ្រូពេទ្យ ដែល មាន វិជ្ជា មាំ ទាំ ថ្លៃថ្នូវ និង ទាន់ សម័យកាល ជឿនលឿន សុច្ចរិត ភាពត្រឹមត្រូវ មាន ក្រមសីលធម៌ ខ្ពស់ ខ្ពស់ ដោយ មិន ធ្វើ អ្វី ដែល មិន គួរ ធ្វើ មិន ត្រូវ ធ្វើ បំពេញ ការងារ ម៉ត់ចត់ ម៉ឺងម៉ាត់ ប្រយ័ត្នប្រយែង ខ្ពស់ មិន ត្រូវ ប្រហែលជា ដាច់ខាត និង ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បែប នេះ នៅក្នុង ជំនួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ក្នុង រាជធានី ភ្នំពេញ ជាង ៣ពាន់ នាក់ នៅ វិមាន ៧មករា នា ព្រឹក ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ។
សង្គ្រាម រវាង រុស្ស៉ី និង អ៊ុយក្រែន គឺជា បញ្ហា មួយ ដ៏ ក្តៅ សម្រាប់ ពិភពលោក ។ បញ្ហា នេះ បាន ធ្វើឱ្យ អង្គការ សហ ប្រជាជាតិ ធ្វើ ការបោះឆ្នោត មួយ ក្នុង ចំណោម សមាជិក អង្គការ សហ ប្រជាជាតិ ដោយ ចាត់ទុក សង្គ្រាម នេះ គឺជា ការឈ្លានពាន របស់ រុស្ស៉ី ទៅ លើ អ៊ុយក្រែន ។ ការបោះឆ្នោត នេះ មាន ប្រទេស ជាច្រើន បាន គាំទ្រ តែ ក៏ មាន ប្រទេស មួយចំនួន តូច រួមទាំង ប្រទេស សមាជិក អាស៊ាន ផងដែរ បាន ជ្រើសយក មិន គាំទ្រ និង ឈរ នៅ កណ្តាល ( អនុប្បវាទ ) ។
កម្ពុជា គឺជា មិត្ត ដ៏ ស្និទ្ធស្នាល មួយ របស់ អតីត សហភាព សូវៀត ក៏ ដូចជា ប្រទេស រុស្ស៉ី នា ពេល បច្ចុប្បន្ន ។ មាន ការសន្និដ្ឋាន ច្រើន ពី ការសម្រេច របស់ ចិត្ត របស់ កម្ពុជា លើ រឿង នេះ អាចនឹង គាំទ្រ រុស្ស៉ី ឬ ជ្រើសយក អនុប្បវាទ ដូច បណ្តា ប្រទេស មួយចំនួន ដែល ជា សមាជិក អាស៊ាន ដែរ ។
ប៉ុន្តែ ជា រឿង មួយ ដ៏ ភ្ញាក់ផ្អើល ពេល គេ បាន ឮ ការសម្រេច របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ។ សម្តេច តេជោ ហ៊ុន សែន ក្នុង នាម ជា ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ប្រកាស ជំហរ ឥត អល់ ឯក គាំទ្រ អង្គការ សហ ប្រជាជាតិ ដោយ ចាត់ទុក សង្គ្រាម នេះ គឺជា ការឈ្លានពាន របស់ រុស្ស៉ី ទៅ លើ ប្រទេស អ៊ុយក្រែន ។
នៅក្នុង ជំនួប សំណេះសំណាល ជាមួយ សមាជិក របស់ គណបក្ស ប្រជាជន កម្ពុជា នា ព្រឹក មិញ សម្តេច តេជោ ហ៊ុន សែន បាន ហៅ ការសម្រេចចិត្ត នេះ គឺជា ធាតុ ដ៏ សំខាន់ នាំឱ្យ កម្ពុជា ទទួលបាន ជោគជ័យ ក្នុង នាម ជា ប្រធាន អាស៊ាន ប្តូរ វេន នៅ ឆ្នាំ នេះ ។
សូម បញ្ជាក់ ថា កម្ពុជា ត្រូវបាន មើលឃើញ ថា ទទួលបាន ជោគជ័យ យ៉ាង ត្រចះត្រចង់ លើ ការងារ ជា ប្រធាន អាស៊ាន នៅ ឆ្នាំ ២០២២ នេះ ។ ជាពិសេស ព្រឹត្តិការណ៍ កិច្ចប្រជុំ កំពូល អាស៊ាន កាលពី ថ្ងៃទី ១០ ដល់ ១៣ ខែវិច្ឆិកា គេ បាន ឃើញ ថា មាន មេដឹកនាំ ប្រទេស ដៃ គូ សន្ទនា ជាច្រើន រួមទាំង ប្រទេស មហា អំណាច ធំ ៗ លើ ពិភពលោក ផង បាន ចូលរួម ។
កម្ពុជា បាន ក្លាយទៅជា អ្នកដឹកនាំ ផ្តល់ ទីតាំង ផ្តល់ នូវ គំនិត ផ្តួចផ្តើម ជាច្រើន ដើម្បី ដោះស្រាយ បញ្ហា ដ៏ ស្មុគស្មាញ មិន ធ្លាប់ មាន ក្នុង ប្រវត្តិសាស្ត្រ របស់ អាស៊ាន ។ កិច្ចប្រជុំ ដ៏ ច្រើន នៅ កម្ពុជា មាន បាន ជួប ការរាំងស្ទះ ណាមួយ នោះ ឡើយ ប្រទេស ជា មិត្ត សុទ្ធតែ ផ្តល់ តម្លៃ ដល់ កម្ពុជា ។ ភាពជោគជ័យ នោះ បាន លើកតម្កើង កិត្តិយស និង មុខមាត់ កម្ពុជា យ៉ាង ធំធេង ៕
សម្ដេច តេជោ ហ៊ុន សែន បន្ត ជំរុញ ឱ្យ យកចិត្តទុកដាក់ ផ្តល់ សេវា ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន លឿន មាន ប្រសិទ្ធភាព និង លុបបំបាត់ រាល់ ភាពអសកម្ម (Video inside) ( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី កម្ពុជា បាន ថ្លែង ក្រើន រំលឹក និង ជំរុញ ឱ្យ មន្ដ្រី យកចិត្តទុកដាក់ ផ្តល់ សេវា សាធារណៈ ទាំង សេវា តម្រូវការ សេវា ចាំបាច់ ទាំងឡាយ និង សេវា សំណូមពរ នានា ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន លឿន រហ័ស និង មាន ប្រសិទ្ធិភាព ហើយ ត្រូវ ខិតខំ លុបបំបាត់ ឱ្យ អស់ នូវ ភាព អសកម្ម នានា ។
ជំនួប សំណេះសំណាល ដើម្បី ពង្រឹង ស្មារតី ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ឆ្នាំ ២០២៣ សម្តេច តេជោ ហ៊ុន សែន បាន គូស រំលេច ការងារ លេចធ្លោ របស់ រាជ រដ្ឋាភិបាល ដែល សម្រេចបាន ។ ការងារ ដែល លេចធ្លោ នោះ មាន ដូចជា ការប្រឹងប្រែង រក្សា បាន នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ និង ស្ថេរភាព នយោបាយ ដែល ធាតុ ដ៏ ចាំបាច់ សម្រាប់ កិច្ច កសាង សង្គមជាតិ និង ការរស់នៅ ដោយ សុខសាន្ត របស់ ប្រជាពលរដ្ឋ ។
បន្ថែម ពីលើ នោះ ការប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការរាត ត្បាត ជំងឺ កូវីដ១៩ ជាពិសេស ដាក់ចេញ នូវ យុទ្ធសាស្ត្រ វ៉ាក់សាំង ស្រោច ជូន ប្រជាពលរដ្ឋ បង្កើត ភាពស៊ាំ បាន យ៉ាង ល្អ ក៏ ជា ជោគជ័យ នៃ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កើត ចេញពី គណបក្ស ប្រជាជន កម្ពុជា ផងដែរ ។
