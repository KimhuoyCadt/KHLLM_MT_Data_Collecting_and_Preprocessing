( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ថា ការប្រឡង ប្រជែង ចូល ក្របខណ្ឌ សុខាភិបាល ឆ្នាំ ២០២២ ដែល ទើប ប្រកាស លទ្ធផល នា ថ្ងៃទី ២២ ខែវិច្ឆិកា ឆ្នាំ ២០២២ គឺ បាន ប្រព្រឹត្តទៅ ប្រកបដោយ តម្លាភាព យុត្តិធម៌ សុចរិតភាព សុក្រឹតភាព និង ជំនឿ ទុកចិត្ត ដោយ ពុំ មាន ភាពលម្អៀង ។
ការចេញមក បញ្ជាក់ បែប នេះ បន្ទាប់ពី មាន មតិ មួយចំនួន តូច បាន លើកឡើង ពី ភាព មិន ប្រក្រតី នៃ ការប្រឡង ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា ក្រោម ការយកចិត្តទុកដាក់ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ចំពោះ សុខុមាលភាព របស់ ប្រជាជន កម្ពុជា ក្រសួង សុខាភិបាល បាន ទទួល ក្របខណ្ឌ ជា អាទិភាព សម្រាប់ ជ្រើសរើស មន្ត្រីរាជការ ចូល បម្រើ ការងារ ក្នុង ក្របខណ្ឌ សុខាភិបាល ឆ្នាំ ២០២២ ដើម្បី ជំរុញ និង លើកកម្ពស់ ការផ្ដល់ សេវា សុខភាព សាធារណៈ ឲ្យ កាន់តែ ប្រសើរឡើង ។
ការប្រឡង ប្រជែង ចូល ក្របខណ្ឌ សុខាភិបាល ឆ្នាំ ២០២២ នេះ បាន ប្រព្រឹត្តទៅ ប្រកបដោយ តម្លាភាព យុត្តិធម៌ សុចរិតភាព សុក្រឹតភាព និង ជំនឿ ទុកចិត្ត ដោយ ពុំ មាន ភាពលម្អៀង ដូច ការយល់ ច្រឡំ របស់ មតិ មួយចំនួន តូច នោះ ទេ ដោយ ហេតុ ថា ការប្រឡង ប្រជែង នេះ គឺ មាន ការ បង្កើត គណៈកម្មការ និង អនុគណៈកម្មការ ជាច្រើន ដែល មាន ការចូលរួម ពី ក្រសួង មុខងារ សាធារណៈ និង មាន ការចូលរួម សង្កេតការណ៍ ពី អង្គភាព ប្រឆាំង អំពើពុករលួយ តាំងពី ចាប់ផ្តើម ដំបូង នៃ ដំណើរការប្រឡង ។
គ្រប់ គណៈកម្មការ និង អនុគណៈកម្មការ អន្តរ ក្រសួង សុទ្ធតែ បាន បំពេញ ភារកិច្ច របស់ ខ្លួន យ៉ាង ហ្មត់ចត់ ដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ប្រកបដោយ វិជ្ជាជីវៈ គន្លង ច្បាប់ និង នីតិវិធី ត្រឹមត្រូវ បម្រើ បាន ថែម ទៀត នូវ អភិក្រមទាំង ៥ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា គឺ ឆ្លុះ កញ្ចក់ ងូតទឹក ដុស ក្អែល ព្យាបាល និង វះកាត់ ដែល ជា គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៦ នៃ រដ្ឋសភា ។
ក្នុង កិច្ច ដំណើរការ នៃ ការប្រឡង ប្រជែង នេះ ត្រូវបាន រៀបចំឡើង ដោយ ប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ជា ជំនួយ ដោយ បាន កែប្រែ ពី ការធ្វើ កំណែវិញ្ញាសា ដោយ ដៃ មក ជា កំណែវិញ្ញាសា ដោយ កម្មវិធី កុំព្យូរ ទ័រ ធ្វើឱ្យ ការចេញ លទ្ធផល បាន ឆាប់ រហ័ស ។
( ក្រចេះ ) ៖ គ្រូពេទ្យ ឯកទេស នៃ មន្ទីរពេទ្យ កុមារ ជាតិ សហការ ជាមួយ សម្ព័ន្ធ គ្រូពេទ្យ សម្ព័ន្ធ គ្រូពេទ្យ សហភាព សហព័ន្ធ យុវជន កម្ពុជា នឹង ចុះ ពិនិត្យ ព្យាបាល និង វះកាត់ ជំងឺ ជូន កុមារ ដោយ ឥត គិត ថ្លៃ នៅ ខេត្ត ក្រចេះ ចាប់ពី ថ្ងៃទី ៣០ ខែវិច្ឆិកា ដល់ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ក្រចេះ ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ក្រចេះ៖ ក្រុមប្រឹក្សា ខេត្ត រតនគិរី បើក វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ នៅ ស្រុក អូរយ៉ាដាវ
( រតនគិរី ) ៖ ក្រុមប្រឹក្សា ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន រៀបចំ ធ្វើ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ នៅ ស្រុក អូរយ៉ាដាវ ។ ពិធី នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក សុខ ហម សមាជិក ក្រុមប្រឹក្សា ខេត្ត និង លោក លន់ សុភាព អភិបាល រង ខេត្ត ។
ថ្លែង ក្នុង ឱកាស នោះ លោក សុខ ហម បាន លើកឡើង អំពី សារៈសំខាន់ នៃ ការរៀបចំ វេទិកា ផ្សព្វផ្សយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា ខេត្ត គឺ ដើម្បី បង្កើត វប្បធម៌ ពិភាក្សា និង លើកកម្ពស់ គណនេយ្យភាព តម្លាភាព និង ការចូលរួម របស់ ប្រជាពលរដ្ឋ តាម បែប ប្រជាធិបតេយ្យ តាមរយៈ ការផ្តល់ ព័ត៌មាន អំពី សមិទ្ធផល និង បញ្ហា ប្រឈម អនុសាសន៍ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ដើម្បី ពិភាក្សា និង ឆ្លើយតប ទៅកាន់ ប្រជាពលរដ្ឋ នូវ តម្រូវការ នានា នៅ មូលដ្ឋាន ទាំង ប្រសិទ្ធភាព សេវា សាធារណៈ និង សេវា រដ្ឋបាល ជូន ប្រជាពលរដ្ឋ ។
ការលើកឡើង របស់ រដ្ឋមន្ត្រី បាន ធ្វើឡើង បន្ទាប់ពី រយៈពេល ចុងក្រោយ នេះ វិស័យ កសិកម្ម បាន ជួបប្រទះ នូវ បញ្ហា ប្រឈម មួយ ចំនួន ពិសេស ប៉ុន្មាន ថ្ងៃ ចុងក្រោយ នេះ គឺ ការធ្លាក់ចុះ នៃ តម្លៃ ស្រូវ ដែល ធ្វើឲ្យ មាន ការរិះគន់ មក លើ រូបលោក ។
លោក ឌិត ទីណា បាន បញ្ជាក់ យ៉ាង ច្បាស់ ៗ ថា ទោះបីជា មាន អ្នក ជេរ និង មាន អ្នករិះគន់ យ៉ាងណា ក៏ដោយ ក្ដី ក៏ លោក នៅតែ បន្ដ ធ្វើ ការងារ និង បន្ដ និយាយ ដើម្បី កំណែទម្រង់ ក្នុង វិស័យ ទាំងមូល នៃ វិស័យ កសិកម្ម កម្ពុជា ។
បន្ថែម ពី នោះ ទៀត លោក ឌិត ទីណា បាន គូសបញ្ជាក់ ថា កំណែទម្រង់ ក្នុង វិស័យ ទាំងមូល នៃ វិស័យ កសិកម្ម ត្រូវ ធ្វើ រួមគ្នា ដោយ មាន យុទ្ធសាស្ដ្រ រួម ហើយ បំបែក ទៅជា ការទទួលខុសត្រូវ ផ្សេង ៗ ។ ចំពោះ ប្រជាកសិករ នឹង មាន ផែនការ មួយចំនួន សម្រាប់ ធ្វើ ហើយ នឹង មិន មែន ការបង្ខិតបង្ខំ អ្វី នោះ ទេ ។ កសិករ ណា អាច ធ្វើ តាម ផែនការ នឹង មាន ការធានា មួយចំនួន ហើយ ប្រជាពលរដ្ឋ ណា ចង់ នៅក្នុង ទម្លាប់ ចាស់ អាច នៅរក្សា ទម្លាប់ ដដែល បាន ប៉ុន្ដែ អាចនឹង ប្រឈម ទៅនឹង បញ្ហា ទីផ្សារ និង បញ្ហា ផ្សេង ៗ ដែល ធ្លាប់ កើតមាន ។
រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម បាន ពន្យល់ ថា « ពេលណា យើង ធ្វើ រួមគ្នា យើង អាច មាន ការចំណាយ តិច ជាង មុន ក៏ប៉ុន្ដែ យើង ក៏ មាន ហានិភ័យ ទាប ជាង ផងដែរ » ។
លោក ឌិត ទីណា បាន លើកឡើង ថា « ចង់ ដើរ លឿន ដើរ ម្នាក់ឯង ប៉ុន្ដែ ដួល ម្នាក់ឯង ដែរ ប៉ុន្ដែ បើសិនជា ចង់ ដើរ បាន ឆ្ងាយ គឺ យើង ដើរ រួមគ្នា ដែល ត្រូវ រួមគ្នា ទាំងអស់ ទាំង មន្ដ្រី ទាំង កសិករ ទាំង អ្នកទិញ ទាំង អ្នក យក ទៅ លក់ បន្ដ ទាំង អ្នកផ្គត់ផ្គង់ ផ្សេង ៗ ទាំង ដៃគូ អភិវឌ្ឍន៍ » ។
លើស ពី នោះ ទៀត លោក ឌិត ទីណា បាន សង្កត់ធ្ងន់ ថា លោក មិន អាច មិន និយាយ បាន ទេ ពីព្រោះថា ការងារ ដែល ធ្វើ គឺជា ការងារ ដែល ប្រមូល កម្លាំង សរុប បើសិនជា លោក មិន ពន្យល់ ទៅ គ្រប់ ទីកន្លែង គ្រប់ ចង្វាក់ ផលិតកម្ម នៃ កសិកម្ម ទាំងមូល តើ មាន ថ្ងៃ ណា ដែល បងប្អូន បាន យល់ ហើយ ចូលរួម ធ្វើ ការកែទម្រង់ និង កែទម្លាប់ ចាស់ នោះ ?
លោក ឌិត ទីណា ក៏ បាន លើកឡើង ផងដែរ ថា អ្នករិះគន់ គាត់ រិះគន់ ទៅ លោក មិន បារម្ភ ទេ ហើយក៏ មិន ធ្វើឲ្យ ប៉ះពាល់ ទៅដល់ ដំណើរការ នៃ ការព្យាយាម ជួយ ប្រជាពលរដ្ឋ នោះ ដែរ ។ លោក នឹង បន្ដ ធ្វើ បន្ដ ទៅ ទៀត តាម សមត្ថភាព ដែល អាច ធ្វើ ទៅ បាន ៕ ស្វែងយល់ ពី ការផ្សាយ ពាណិជ្ជកម្ម របស់ បរធន បាល
នៅ ពេល នេះ និយ័តករបរ ធន បាលកិច្ច បាន រៀបចំ អត្ថបទ ថ្មី មួយ ទៀត ស្តីពី ការផ្សាយ ពាណិជ្ជកម្ម របស់ បរធន បាល ។
មូលនិធិ គន្ធ បុប្ផា កម្ពុជា បាន ទទួល ថវិកា បរិច្ចាគ ចំនួន ២០ម៉ឺន ដុល្លារ អាមេរិក
( ភ្នំពេញ ) ៖ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា បាន ទទួល ថវិកា បរិច្ចាគ ចំនួន ២០ម៉ឺន ដុល្លារ អាមេរិក ពី មូលនិធិ ព្រីនស៍ ដើម្បី ជួយ ដល់ កម្ពុជា កម្ពុជា ។
ក្នុង ឱកាស នោះ លោក រស់ សីល វ៉ា បាន លើកឡើង ថា ការបន្ត គាំទ្រ ពីសំណាក់ សប្បុរសជន នានា បាន រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការជួយសង្គ្រោះ ជីវិត កុមារ រាប់ លាន នាក់ នៅ កម្ពុជា តាមរយៈ ការរួមគ្នា រក្សា និរន្តរភាព នៃ កិច្ច ដំណើរការ របស់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ទាំង ៥ទីតាំង នៅ ព្រះរាជាណាចក្រ កម្ពុជា ដើម្បី បន្ត បេសកកម្ម ពិនិត្យ និង ព្យាបាល ជំងឺ ដល់ ទារក និង កុមារ ដោយ ឥត គិត ថ្លៃ ប្រកបដោយ គុណភាព និង មិន មាន ការរើសអើង ។
លោក Cliff Koh បាន លើកឡើង ថា គណៈ គ្រប់គ្រង និង បុគ្គលិក ទាំងអស់ របស់ ព្រីន ហូល ឌីង គ្រុប និង មូលនិធិ ព្រីនស៍ រីករាយ យ៉ាង ខ្លាំង ដែល ទទួលបាន ឱកាស ក្នុង ការជួយគាំទ្រ ផ្នែក ហិរញ្ញវត្ថុ ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ដែល ជា មន្ទីរពេទ្យ មួយ តែងតែ ជួយសង្គ្រោះ ជីវិត កុមារ ជាច្រើន និង ធ្វើឱ្យ ពួកគេ ទទួលបាន ភាពញញឹម ជាថ្មី ចាប់តាំងពី ការបើក ឱ្យ ដំណើរការ ឡើងវិញ នៅក្នុង ឆ្នាំ ១៩៩២ ។
មូលនិធិ គន្ធ បុប្ផា កម្ពុជា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ទឹកចិត្ត សប្បុរសធម៌ នេះ ។
សូម ជម្រាប ថា នេះ ជា លើក ទី៤ ហើយ ដែល ព្រីន ហូល ឌីង គ្រុប តាមរយៈ មូលនិធិ ព្រីនស៍ បាន ចូលរួម ក្នុង សកម្មភាព សប្បុរសធម៌ ជាមួយ គន្ធ បុប្ផា ចាប់តាំងពី ឆ្នាំ ២០១៥ មក ដែល បាន ឧបត្ថម្ភ សរុប ជា សាច់ប្រាក់ ជិត ១លាន ដុល្លារ អាមេរិក ដើម្បី រួមចំណែក លើកកម្ពស់ សុខុមាលភាព ទារក និង កុមារ នៅ កម្ពុជា ៕
រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម៖ រាជ រដ្ឋាភិបាល បន្ត លើកលែង ពន្ធ លើ ប្រាក់ ចំណូល ៥ឆ្នាំ បន្ថែម ដល់ វិស័យ ស្រូវ អង្ករ (Video inside) ( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នឹង បន្ត លើកលែង ពន្ធ លើ ប្រាក់ ចំណូល ដល់ ក្រុមហ៊ុន ក្នុង វិស័យ ស្រូវ អង្ករ ចំនួន ៥ឆ្នាំ បន្ថែម ទៀត ដើម្បី ជួយ សម្រួល បន្ទុក ចំណាយ របស់ រោង ម៉ាស៊ីន និង ក្រុមហ៊ុន នាំចេញ អង្ករ ។
លោក បាន គូសបញ្ជាក់ បន្ថែម ថា បច្ចុប្បន្ន នេះ ក្រសួង ពាណិជ្ជកម្ម បាន និង កំពុង ចរចា កិច្ចព្រមព្រៀង ថ្មី បន្ថែម ទៀត សម្រាប់ ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ កម្ពុជា - អេមីរ៉ាត អារ៉ាប់ រួម ដែល អង្ករ ស្ថិត នៅក្នុង ទំនិញ អាទិភាព មួយ ដែល កម្ពុជា រំពឹង ថា នឹង ពង្រីក នូវ សក្តានុពល ទីផ្សារ ថ្មី នៅក្នុង តំបន់ មជ្ឈឹម បូព៌ា ដែល បច្ចុប្បន្ន ទីផ្សារ តំបន់ នេះ នៅ មាន កម្រិត តិចតួច បំផុត ដែល សង្ឈឹម ថា នឹង ជួយ បង្កើន ការនាំចេញ អង្ករ កម្ពុជា កាន់តែ ច្រើន ឡើង ថែម ទៀត ។
ឧកញ៉ា ហ៊ុន ឡាក់ ប្រធាន ក្រុមប្រឹក្សាភិបាល សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បាន ថ្លែង ថា ដំណើរការងារ នាំចេញ របស់ សមាជិក សមាជិការ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ត្រូវបាន ជួយ ជ្រោមជ្រែង យ៉ាង ខ្លាំង ពី រាជ រដ្ឋាភិបាល ស្រប ពេល ដែល សហព័ន្ធ បាន ខិតខំ យកចិត្តទុកដាក់ ក្នុង ការជួយសម្របសម្រួល និង ផ្តល់ កិច្ចសហប្រតិបត្តិការ ដើម្បីឱ្យ ការងារ អាច ប្រព្រឹត្តិ ទៅ ដោយ រលូន ។
ជាមួយគ្នា នេះ លោក បាន ថ្លែង បានអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ក្រសួង ពាណិជ្ជកម្ម ដែល បាន ផ្តល់ នូវ អទិភាព ខ្ពស់ ដល់ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ក្នុង ការជំរុញ ការនាំចេញ និង ក្រសួង កសិកម្ម និង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ចំពោះ ការងារ ជួយ ដល់ ការបន្ត លើ ការលើកលែង ពន្ធ ចំនួន ៥ ឆ្នាំ ដល់ ក្រុម ជា សមាជិក សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បន្ត ទៀត ៕
លោក ហ៊ុន ម៉ានី ពិភាក្សា ជាមួយ គណៈប្រតិភូ អូស្ត្រាលី លើ ប្រធានបទ ការវិនិយោគ ក្នុង សន្តិភាព ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព និង ការស្តារ ឡើងវិញ ក្រោយ វិបត្តិ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី សមាជិក រដ្ឋសភា និង ជា ប្រធាន គណៈកម្មការ អប់រំ យុវជន កីឡា ធម្មការ កិច្ចការ សាសនា វប្បធម៌ និង ទេសចរណ៍ រដ្ឋសភា កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន បន្ត ដឹកនាំ កិច្ចពិភាក្សា ជាមួយ គណៈប្រតិភូ ប្រទេស អូស្ត្រាលី ដែល ជា ប្រទេស ដៃ គូ សង្កេតការណ៍ មហាសន្និបាត អាយ ប៉ា លើ ប្រធានបទ៖ « ការវិនិយោគ ក្នុង សន្តិភាព ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព និង ការស្តារ ឡើងវិញ ក្រោយ វិបត្តិ កូវីដ១៩ » ។
សមាសភាព ដែល ចូលរួម ក្នុង កិច្ចពិភាក្សា នេះ រួម មាន៖ លោកស្រី Deborah O’Neill សមាជិក ព្រឹទ្ធសភា និង ជា ប្រធាន គណៈប្រតិភូ ប្រទេស អូស្ត្រាលី ព្រមទាំង គណៈប្រតិភូ សមាជិក សភា វ័យ ក្មេង មកពី ប្រទេស ព្រុយណេ ឥណ្ឌូនេស៊ី ឡាវ ហ្វីលីពីន សិង្ហបុរី ថៃ ឡង់ដ៍ វៀតណាម និង កម្ពុជា ។
ថ្លែង ក្នុង ឱកាស ដឹកនាំ កិច្ចពិភាក្សា លោក ហ៊ុន ម៉ានី បាន គូសបញ្ជាក់ ភាព សំខាន់ នៃ ប្រធានបទ និង កិច្ចពិភាក្សា ថ្ងៃ នេះ ដែល អនុញ្ញាតឱ្យ សមាជិក សភា មកពី ប្រទេស សមាជិក AIPA និង សភា អូស្ត្រាលី បាន បញ្ជាក់ សារ ថ្មី អំពី សារៈសំខាន់ នៃ កិច្ចសហប្រតិបត្តិការ រវាង គ្នា តាមរយៈ ការថ្លែង សារ របស់ ប្រទេស នីមួយ ៗ ទាក់ទង នឹង ចំណង ជាមួយ ប្រទេស អូស្រា្តលី ។
ជាមួយគ្នា នេះ លោក ហ៊ុន ម៉ានី បង្ហាញ ការជឿជាក់ ថា កិច្ចពិភាក្សា ដ៏ មាន តម្លៃ នេះ នឹង ក្លាយជា វេទិកា ដ៏ សំខាន់ មួយ ទៀត ដែល នឹង ធ្វើឱ្យ កិច្ចសហប្រតិបត្តិការ អាស៊ាន - អូស្ត្រាលី កាន់តែ ស៊ីជម្រៅ ជាពិសេស ក្នុង ការរក្សា និង លើកកម្ពស់ សន្តិភាព ស្ថិរភាព និង វិបុលភាព ក្នុង តំបន់ ក៏ ដូចជា បន្ត ស្វែងរក ផ្នែក នៃ សហប្រតិបត្តិការ ថ្មី ៗ ដើម្បី ពន្លឿន ការស្តារ សេដ្ឋកិច្ច សង្គម ក្រោយ វិបត្តិ កូវីដ១៩ និង ការអភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ។
នា ឱកាស នេះ ដែរ លោក ក៏ បាន រំលឹក ពី ភាពជាដៃគូ យ៉ាង ជិតស្និត ប្រកបដោយ ការគោរព គ្នា ការយោគយល់ គ្នា និង ផ្តល់ ផលប្រយោជន៍ ទៅ វិញ ទៅ មក រវាង អាស៊ាន និង អូស្ត្រាលី ចាប់តាំងពី ឆ្នាំ ១៩៧៤ ម កម្លេះ ។
ក្រសួង ទេសចរណ៍ ដឹកនាំ និស្សិត ជំនាញ ទេសចរណ៍ ចុះ ស្វែងយល់ ពី សក្តានុពល ទេសចរណ៍ ក្នុង ស្រុក បន្ទាយស្រី ដើម្បី ត្រៀម ប្រកួតប្រជែង រៀបចំ ផែនការអភិវឌ្ឍន៍ គោលដៅ ទេសចរណ៍ គំរូ
( សៀមរាប ) ៖ លោក ជួន ជ័យ សត្យា អគ្គ លេខាធិការ រង គណៈកម្មាធិកា ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត និង ជា ប្រធាន នាយកដ្ឋាន ជំរុញ ទេសចរណ៍ ក្នុង ស្រុក និង អប់រំ ការយល់ដឹង ជាសាធារណៈ បាន ដឹកនាំ ក្រុម និស្សិត ជំនាញ ទេសចរណ៍ ចុះ សិក្សា ស្វែងយល់ អំពី សក្តានុពល និង បញ្ហា ប្រឈម នានា នៅក្នុង គោលដៅ ទេសចរណ៍ ក្នុង ស្រុក បន្ទាយស្រី ខេត្ត សៀមរាប រយៈពេល ៥ ថ្ងៃ ដើម្បី ជា មូលដ្ឋាន នៅក្នុង កម្មវិធី ប្រកួតប្រជែង រៀបចំ ផែនការអភិវឌ្ឍន៍ គោលដៅ ទេសចរណ៍ គំរូ ។
លោក ជួន ជ័យ សត្យា បាន ឱ្យដឹង ថា ដំណើរកម្មសិក្សា ខាងលើ នេះ គឺជា ផ្នែក មួយ នៃ ដំណើរ ការប្រកួតប្រជែង ការរៀបចំ ផែនការអភិវឌ្ឍន៍ គោលដៅ ទេសចរណ៍ គំរូ ដែល ធ្វើឡើង ក្នុង គោលបំណង ផ្តល់ ជា ពុទ្ធិ និង ធាតុ ចូល ក៏ដូចជា ចំណេះដឹង អំពី ដំណើរការ គ្រប់គ្រង គោលដៅ ទេសចរណ៍ គំរូ នៅក្នុង ស្រុក បន្ទាយស្រី សម្រាប់ យក ទៅ រៀបចំ ផែនការអភិវឌ្ឍន៍ គោលដៅ ទេសចរណ៍ ដើម្បី ដណ្តើមយក ជ័យលាភី ។
លោក បាន បន្ថែម ថា ដំណើរកម្មសិក្សា នេះ ក៏ ជា ឱកាស មួយ ដែល ក្រុម និស្សិត អាច ស្វែងយល់ កាន់តែ ច្បាស់ អពី ការគ្រប់គ្រង សហគមន៍ ទេសចរណ៍ ពិសេស ផ្សារ ភ្ជាប់ ទ្រឹស្តី ទៅនឹង ការអនុវត្ត ជាក់ស្តែង តាមរយៈ ដំណើរទស្សនកិច្ច និង ការចែករំលែក បទពិសោធន៍ ជាក់ស្តែង របស់ ប្រធាន សហគមន៍ និង ម្ចាស់ អាជីវកម្ម ផ្ទះ ស្នាក់ និង សម្បទា ទេសចរណ៍ នានា ដែល មាន សក្តានុពល នៅក្នុង ស្រុក បន្ទាយស្រី ។
នៅសល់ ៣ ថ្ងៃ ទៀត អង្គការ មូលនិធិ ថែទាំ សុខភាព អ្នកជំងឺ អេដស៍ នឹង រៀបចំ ទិវា ពិភពលោក ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ឆ្នាំ ២០២២ ក្នុង ទឹកដី ខេត្ត ស្វាយរៀង
សូម ជម្រាប ថា យោង តាម ស្ថិតិ ចុងក្រោយ របស់ UNAIDS មនុស្ស ជាង ៣៨លាន នាក់ កំពុង រស់ នៅ ជាមួយ មេរោគ អេដស៍ / ជំងឺ អេដស៍ នៅ ទូទាំង ពិភពលោក ហើយ មនុស្ស ជាង ៤០លាន នាក់ បាន ស្លាប់ ដោយសារ ជំងឺ ដែល ទាក់ទង នឹង ជំងឺ អេដស៍ ចាប់តាំងពី ការចាប់ផ្តើម នៃ ការរីករាលដាល នៃ មេរោគ អេដស៍ ។ ខណៈពេល ដែល មនុស្ស រាប់ លាន នាក់ សព្វ ថ្ងៃ នេះ កំពុង ទទួលបាន ការព្យាបាល ដោយ ថ្នាំ ប្រឆាំង មេរោគ អេដស៍ ។
លោកស្រី Terri Ford ប្រធាន AHF នៃ ផ្នែក តស៊ូ មតិ និង គោល នយោបាយ សកល បាន បញ្ជាក់ ឱ្យដឹង ដែរ យើង កំពុង អំពាវនាវ ឱ្យ ភាគី ពាក់ព័ន្ធ និង អ្នកតស៊ូ មតិ ក្នុង ប្រទេស ទាំងអស់ បង្កើន កិច្ច ខិតខំ ប្រឹងប្រែង ការពារ ការធ្វើតេស្ត និង ការព្យាបាល មេរោគ អេដស៍ នៅ ទូទាំង ពិភពលោក ដើម្បី ពន្យា អត្រា ឆ្លង មេរោគ អេដស៍ ថ្មី ដែល កំពុង កើនឡើង យ៉ាង ឆាប់រហ័ស និង ការពារ ផលប្រយោជន៍ ដ៏ មាន តម្លៃ ដែល យើង បាន ធ្វើ យើង បាន មក ឆ្ងាយ ពេក ហើយ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា កម្ពុជា និង ជា ប្រធាន អន្តរសភា អាស៊ាន លើក ទី ៤៣ បាន អញ្ជើញ ដឹកនាំ សម័យ ប្រជុំ ពេញ អង្គ លើក ទី២ នៃ មហាសន្និបាត អាយ ប៉ា លើក ទី ៤៣ នេះ ជាមួយនឹង វត្តមាន ចូលរួម របស់ គណៈប្រតិភូសភា នៃ ប្រទេស សមាជិក អាស៊ាន ចំនួន ៨ប្រទេស រួម មាន៖ សភា ព្រុយណេដា រូស្សា ឡាម កម្ពុជា ឥណ្ឌូនេស៊ី ឡាវ ហ្វីលីពីន សិង្ហបុរី ថៃ និង វៀតណាម ។
