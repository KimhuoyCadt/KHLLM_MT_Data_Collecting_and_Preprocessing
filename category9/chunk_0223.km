( កំពង់ឆ្នាំង ) ៖ ក្នុង ពិធី បុណ្យ កំសាន្ត ដែល រៀបចំឡើង ដោយ រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង ថ្ងៃទី ៣ ខែធ្នូ ឆ្នាំ ២០២២ មាន កីឡា កីឡាករ កីឡាការ នី ដែល ភាគ ច្រើន ជា ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ក្នុង ខេត្ត និង ប្រជាពលរដ្ឋ ជាង១ ០០ នាក់ បាន ចូលរួម ជិះ កង់ កម្សាន្ត ក្នុង ផ្លូវ ចម្ងាយ ជា១០គីឡូម៉ែត្រ នៅក្នុង ក្រុង កំពង់ឆ្នាំង ដែល បាន ដឹកនាំ ជិះ កង់ ដោយ លោក ស៊ុន សុវណ្ណា រិទ្ធិ អភិបាល ខេត្ត និង លោកស្រី ដើម្បី ជា ការអបអរសាទរ ពិធី បុណ្យ អុំ ទូក ដែល បាន ប្រព្រឹត្ត ធ្វើ ក្នុង ក្រុង កំពង់ឆ្នាំង រយៈពេល ២ ថ្ងៃ ។
ការជិះ កង់ នេះ ដែរ បាន ចេញដំណើរ ពី គោលដៅ សា លា ខេត្ត កំពង់ឆ្នាំង ឆ្ពោះទៅ សាលាកាណាន កាត់ ទៅ លើ ភូមិ អណ្ដូង ឬ ស្សី ឃុំ ស្រែ ថ្មី និង ត្រឡប់ មកវិញ ឆ្ពោះ ទៅកាន់ តំបន់ ត្រជាក់ និង វេទិកា បុណ្យ អុំ ទូក នៅ មាត់ ទន្លេ ផ្សារ ក្រោម ក្នុង សង្កាត់ ផ្សារ ឆ្នាំង ក្រុង កំពង់ឆ្នាំង ដែល មាន ចម្ងាយ ផ្លូវ ប្រមាណ ជាង ១០គីឡូម៉ែត្រ ។
លោក នួន ផារ័ត្ន បាន ឲ្យដឹង ថា តាមរយៈ កិច្ចប្រជុំ រដ្ឋបាល រាជធានី និង រដ្ឋធានី ប្រទេស អាស៊ាន ទាំង១០ និង តំណាង បាន ជជែកគ្នា ចែករំលែក នូវ បទពិសោធន៍ ទស្សនៈ និង ចក្ខុវិស័យ ក្នុង ការអភិ ឌ្ឍ រដ្ឋបាល រាជធានី រដ្ឋធានី របស់ ប្រទេស រៀង ៗ ខ្លួន ។ ជាពិសេស បាន រំលេចចេញ នូវ សមិទ្ធផល នៃ ស្នាដៃ ការងារ នៅក្នុង ការអភិវឌ្ឍ ទីក្រុង របស់ ខ្លួន និង បាន បង្ហាញ ពី ការប្តេជ្ញាចិត្ត ដែល ជា ចក្ខុវិស័យ ទៅ មុខ ក្នុង ការអភិឌ្ឍ រាជធានី រដ្ឋធានី របស់ ខ្លួន ។
លោក បាន បន្ត ថា តាមរយៈ កិច្ចប្រជុំ « គឺ បាន សង្កេតឃើញ ថា រាជធានី និង រដ្ឋធានី ទាំង១០ សម្រាប់ បញ្ហា ប្រឈម គឺ មិន ខុសគ្នា នោះ ទេ ដែល កើត ចេញ ពី បញ្ហា អភិវឌ្ឍន៍ របស់ ទីក្រុង រួម មាន បញ្ហា ចរាចរណ៍ បញ្ហា ពង្រីក គម្រប់ បៃតង បញ្ហា នៃ ការគំរាមកំហែង ដោយ គ្រោះ ធម្មជាតិ ជាពិសេស ជំនន់ ទឹកភ្លៀង និង បញ្ហា នៃ ការអនុវត្ត ផ្សេង ៗ ទៀត រួមទាំង ការរៀបចំ លំនៅដ្ឋាន សមរម្យ សម្រាប់ អ្នក ចំ ណូល ទាប ផងដែរ » ។
ដោយឡែក សម្រាប់ វេទិកា អភិបាល ក្រុង អាស៊ាន លោក បាន អះអាង ថា ក៏ មាន ការចែករំលែក ទស្សនៈ ដូចគ្នា ផងដែរ ។ ដោយ មាន ការចែក ជា ក្រុម ពិភាក្សា ៣ក្រុម ធំ ៗ ហើយ ក្រុម នីមួយ ៗ បាន ជជែក លម្អិត នូវ បញ្ហា ផ្សេង ៗ រួមទាំង បញ្ហា ការស្វែងរក នូវ ប្រភព ហិរញ្ញប្បទាន ប្រកបដោយ និរន្តរភាព អភិវឌ្ឍន៍ ទីក្រុង ការកសាង ទីក្រុង ឆ្លាត ការរួមគ្នា អភិវឌ្ឍន៍ គោលដៅ អភិវឌ្ឍន៍ របស់ អង្គការ សហ ប្រជាជាតិ សម្រាប់ ទីក្រុង និង បញ្ហា ផ្សេង ៗ ទៀត ដែល អភិបាល ទីក្រុង ទាំងអស់ បាន រួមចំណែក នូវ បទពិសោធន៍ ជាមួយគ្នា ។
លោក នួន ផារ័ត្ន បាន បញ្ជាក់ ថា ភាគី ពាក់ព័ន្ធ ទាំងអស់ គិត ថា វា ជា វេទិកា មួយ ដ៏ ល្អ សម្រាប់ អភិបាល រាជធានី រដ្ឋធានី អភិបាល ទីក្រុង ទាំងអស់ ជុំគ្នា ជជែក ទល់ មុខ គ្នា និង រួមគ្នា ដោះស្រាយ បញ្ហា ប្រឈម ទាំងអស់ គ្នា ពីព្រោះថា បញ្ហា ប្រឈម របស់ រាជធានី រដ្ឋធានី និង ទីក្រុង មិន មាន អ្វី ខុសគ្នា នោះ ទេ ។
សូម ជម្រាប ថា នៅ ថ្ងៃទី ០២ និង ទី០៣ ខែធ្នូ ឆ្នាំ ២០២២ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ត្រូវ ធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ អភិបាល រាជធានី - រដ្ឋធានី អាស៊ាន និង វេទិការកិច្ចប្រជុំ អភិបាល ក្រុង អាស៊ាន ។
កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន គឺជា វេទិកា មួយ សម្រាប់ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន ទាំង១០ ដើម្បី លើកឡើង និង ពិភាក្សា អំពី បញ្ហា ប្រឈម ក្នុង ទីក្រុង នា ពេល បច្ចុប្បន្ន និង ដែល អាច កើត មាន ឡើង ព្រមទាំង ចែករំលែក ការអនុវត្ត ល្អ ៗ ក៏ ដូចជា ទស្សនៈ ល្អ ៗ សម្រាប់ ការកសាង សហគមន៍ អាស៊ាន ៕
អាជ្ញាធរ ខេត្ត ព្រះសីហនុ បើក ប្រតិបត្តិការ ចុះ ឆែកឆេរ អគារ ក្រុមហ៊ុន មួយ កន្លែង រកឃើញ ជន បរទេស ជាង ២០០ នាក់
( ព្រះសីហនុ) ៖ ចាប់ពី ថ្ងៃទី ៣០ ខែវិច្ឆិកា ដល់ ថ្ងៃទី២ ខែធ្នូ ឆ្នាំ ២០២២ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ដឹកនាំ ដោយ លោក ម៉ាង ស៊ីណេត អភិបាល រង ខេត្ត ព្រះសីហនុ ក្រោម ការសម្របសម្រួល នីតិវិធី ពី លោក ពេញ ពិសិដ្ឋ ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង ខេត្ត បាន ចុះ ប្រតិបត្តិការ និង ឆែកឆេរ អគារ ក្រុមហ៊ុន មួយ កន្លែង ស្ថិត នៅ ក្រុម ៩ ភូមិ១ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ តាម ពាក្យបណ្តឹង លេខ ៦២៧ តាមរយៈ ហត ឡាញ របស់ អគ្គ ស្នងការ នគរបាល ជាតិ កាលពី ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
បន្ទាប់ពី ក្រុម ប្រតិបត្តិការ ធ្វើ ការឆែកឆេរ និង ត្រួតពិនិត្យ លើ ទីតាំង អាគារ ក្រុមហ៊ុន នេះ បាន រកឃើញ អ្នក ប្តឹង ចំនួន ៥នាក់ ជា ជនជាតិ ចិន ដែល មាន ដូច នៅក្នុង បណ្តឹង លេខ ៦២៧ នៅក្នុង បន្ទប់ លេខ ៣១៦ ជាន់ ទី៣ ។
ចំពោះ ការពិនិត្យ លើ ស្ថានភាព ជនជាតិ ចិន ទាំង ០៥ នាក់ ក្នុង បណ្តឹង នៅក្នុង បន្ទប់ លេខ ៣១៦ ពុំ មាន ការធ្វើ ទារុណកម្ម និង មិន មាន វត្ថុតាង ណា មួយ ពាក់ព័ន្ធ និង បទល្មើស ព្រហ្មទណ្ឌ ឡើយ ។
បន្ទាប់ពី ពិនិត្យ និង ធ្វើ ការឆែកឆេរ ទីតាំង ខាងលើ នេះ គឺ បាន រកឃើញ មាន ជន បរទេស ចំនួន ២២៣ នាក់ ក្នុង នោះ ស្រី ចំនួន ៣៥ នាក់ ព្រមទាំង វត្ថុតាង មួយចំនួន ទៀត ។ សូម បញ្ជាក់ ថា ករណី កំពុង ស្ថិត ក្នុង នីតិវិធី របស់ សមត្ថកិច្ច ដោយឡែក ព័ត៌មាន លម្អិត នឹង ផ្តល់ ជូន នៅពេល បន្ទាប់ ៕
អភិបាល រាជធានី ភ្នំពេញ ទទួល អាហារ សាមគ្គី ដើម្បី រឹត ចំណង មិត្តភាព សាមគ្គីភាព ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ ឲ្យ កាន់តែ ស៊ីជម្រៅ ជាមួយ AIMF
លោក ឃួង ស្រេង បាន លើកឡើង ថា ក្នុង នាម រដ្ឋបាល រាជធានី ភ្នំពេញ និង ក្នុង នាម ជា សមាជិក អចិន្ត្រៃយ៍ នៃ សមាគម អន្តរជាតិ នៃ អភិបាល ក្រុង ប្រើប្រាស់ ភាសា បារាំង បាន សម្តែង នូវ ការស្វាគមន៍ យ៉ាង កក់ក្តៅ និង រីករាយ ចំពោះ វត្តមាន របស់ គណៈប្រតិភូ នៃ បណ្តា ទីក្រុង និង សមាគមន៍ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ជា សមាជិក នៃ សមាគម អា. ស៊ី . អឹម . អេហ្វ (AIMF) ដែល បាន អញ្ជើញ មក ចូលរួម វេទិកា អភិបាល ក្រុង អាស៊ាន និង កិច្ចប្រជុំ អភិបាល រាជធានី - រដ្ឋធានី អាស៊ាន ឆ្នាំ ២០២២ នៅ រាជធានី ភ្នំពេញ នា ពេលនេះ ។
សម្តេច តេជោ ហ៊ុន សែន ប្រាប់ អាជ្ញាធរ ខេត្ត កណ្តាល យកចិត្ត ដោះស្រាយ ជម្លោះ ដីធ្លី ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន រហ័ស (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន ប្រាប់ អាជ្ញាធរ ខេត្ត កណ្តាល យកចិត្ត ដោះស្រាយ ជម្លោះ ដីធ្លី ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន រហ័ស រហួន ដោយ ឈរ លើ ភាព ត្រឹមត្រូវ និង តម្លាភាព ។ ជាពិសេស ជ្រើស យក យន្តការដោះស្រាយ បញ្ហា ក្រៅ ប្រព័ន្ធ តុលាការ ប្រកាន់ យក នយោបាយ ឈ្នះ - ឈ្នះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ណែនាំ បែប នេះ ក្នុង ជំនួប សំណេះសំណាល ជាមួយ ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ក្រុង ស្រុក ខេត្ត មន្ត្រីរាជការ និង កម្លាំងប្រដាប់អាវុធ ខេត្ត កណ្តាល ដែល ជា សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ប្រមាណ ៣. ៤៥៧ នាក់ នៅ វិមាន ៧មករា នា ព្រឹក ថ្ងៃសៅរ៍ ទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ។
នៅក្នុង ជំនួប សំណេះសំណាល នេះ សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហាញ ក្តីរីករាយ ដែល បាន ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ថ្នាក់ ភូមិ ឃុំ សង្កាត់ ចំណុះ ឱ្យ ខេត្ត កណ្ដាល នៅក្នុង ថ្ងៃ នេះ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង អបអរសាទរ ចំពោះ ក្រុមប្រឹក្សា ឃុំ / សង្កាត់ ក្នុង ខេត្ត កណ្ដាល ទាំងអស់ ដែល ទទួលបាន ការគាំទ្រ ពី ប្រជាពលរដ្ឋ តាមរយៈ ការបោះឆ្នោត ឃុំ សង្កាត់ កន្លងទៅ នេះ ។
ទី១៖ ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ ត្រូវ បន្ត ជំរុញ ការអនុវត្ត ផែនការ យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ពិការភាព ២០១៩ - ២០២៣ ច្បាប់ ស្តីពី កិច្ចការពារ និង លើកកម្ពស់ សិទ្ធិ ជន ពិការ អនុសញ្ញា ស្តីពី សិទ្ធិ ជន ពិការ គោល នយោបាយ ជាតិ និង អន្តរជាតិ នានា ដើម្បី ជា ឧត្តម ប្រយោជន៍ សុខុមាលភាព ដល់ បងប្អូន មាន ពិការភាព គ្រប់ ប្រភេទ និង គ្រប់ កម្រិត ។
ទី២៖ គ្រប់ ក្រសួង ស្ថាប័ន ព្រមទាំង អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ត្រូវ យក រាល់ លិខិត បទដ្ឋាន គតិយុត្ត ជាតិ និង អន្តរជាតិ ពាក់ព័ន្ធ នឹង វិស័យ ពិការភាព ទៅ អនុវត្ត ប្រកបដោយ ប្រសិទ្ធភាព និង ស័ក្ដិសិទ្ធភាព ដោយ រៀបចំ ជា ផែនការ សកម្មភាព និង កញ្ចប់ ថវិកា ប្រចាំ ឆ្នាំ តាម វិស័យ របស់ ក្រសួង ស្ថាប័ន អង្គភាព នីមួយ ៗ ។
ទី៣៖ សូម ជន មាន ពិការភាព កម្ពុជា គ្រប់ រូប ដែល មាន លទ្ធភាព ចូលរួម ប្រកួតប្រជែង កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ដែល ព្រះរាជាណាចក្រ កម្ពុជា យើង ធ្វើជា ម្ចាស់ ផ្ទះ នា ពេល ខាងមុខ ឱ្យ ទទួលបាន នូវ ជោគជ័យ ។
ទី៤៖ ត្រូវ បន្ត រៀបចំ ការបង្ក លក្ខណៈ ងាយស្រួល ចេញ ចូល ទីកន្លែង សាធារណៈ សម្រាប់ ជន មាន ពិការភាព គ្រប់ ប្រភេទ ដូចជា ការរៀបចំ ចំណត យានយន្ត ពិសេស សម្រាប់ ជន មាន ពិការភាព ការធ្វើ ជម្រាល ការបំពាក់ ឧបករណ៍ ធ្នាក់ ដៃ ទ្វារ បន្ទប់ទឹក ជន មាន ពិការភាព ការដាក់ ស្លាកសញ្ញា នានា នៅ តាម ក្រសួង ស្ថាប័ន មន្ទីរ ផ្លូវថ្នល់ ទីកន្លែង លំហែ កាយ មជ្ឈមណ្ឌល វប្បធម៌ កន្លែង លេង កីឡា កន្លែង កម្សាន្ត គ្រឹះស្ថាន អប់រំ សណ្ឋាគារ មន្ទីរពេទ្យ មណ្ឌល សុខភាព និង មធ្យោបាយ ដឹកជញ្ជូន ។ល ។
ទី៥៖ គ្រប់ ក្រសួង ស្ថាប័ន រដ្ឋ ត្រូវ លើកទឹកចិត្ត ជន មាន ពិការ ភាព ដែល មាន លក្ខណសម្បត្តិ និង សមត្ថភាព ឱ្យ បំពេញ មុខងារ តួនាទី ទទួលខុសត្រូវ ក្នុង មុខ តំណែង ឱ្យ មាន សិទ្ធិ ចូល បម្រើ ការងារ ដោយ គ្មាន ការរើសអើង រាប់ ទាំង ការបម្រើ ការងារ ជា មន្ត្រីរាជការ កម្មករ និយោជិត កូន ជាង ឬ កម្មសិក្សា ការី ជាដើម ។
ទី៦៖ ត្រូវ លើកទឹកចិត្ត ឱ្យ មាន ការចូលរួម ពី ផ្នែក ឯកជន សង្គម ស៊ីវិល រោងចក្រ សហគ្រាស និង គ្រឹះស្ថាន ទាំងអស់ ត្រូវ អនុវត្ត ប្រកបដោយ ការទទួលខុសត្រូវ និង ដោយ ភ្ញាក់ រលឹក នូវ កាតព្វកិច្ច ជ្រើសរើស ជន មាន ពិការ ភាព ឱ្យ ចូល បម្រើ ការងារ បន្ត និរន្តរភាព ការងារ ដូច អ្នកដទៃ ដែល មាន ចែង ក្នុង ច្បាប់ ស្ដីពី កិច្ចការពារ និង លើកកម្ពស់ សិទ្ធិ ជន ពិការ ។
ទី៧៖ ក្រសួង ព័ត៌មាន ត្រូវ ធ្វើ ការណែនាំ ដល់ គ្រប់ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ របស់ រដ្ឋ និង ឯកជន ព្រមទាំង គ្រប់ ប្រព័ន្ធ សារព័ត៌មាន បង្កើន ម៉ោង ផ្សព្វផ្សាយ ឱ្យ បាន ទូលំទូលាយ ដោយ មាន ការបកប្រែ ភាសា សញ្ញា ជាពិសេស ព័ត៌មាន ស្តីពី ការរាតត្បាត និង ពិធីសាស្ត្រ ការពារ ជំងឺ កូវីដ១៩ ដើម្បី មនុស្ស គថ្លង់ អាច ទទួល ព័ត៌មាន បាន ទាន់ ពេល វេលា ។
ទី៨៖ សូម ជន មាន ពិការភាព ទាំងអស់ បន្ត អនុវត្ត វិធានការ ការពារ និង ទៅ ទទួល វ៉ាក់សាំង ការពារ កូវី ដ១៩ ដូស ជំរុញ ឱ្យ បាន គ្រប់ ៗ គ្នា ដើម្បី រក្សា ភាព សុំ បុគ្គល និង សហគមន៍ ដែល ជា ការធានា នូវ និរន្តភាព នៃ ការរស់នៅ ប្រចាំ ថ្ងៃ ក្នុង ប្រក្រតី ភាព ថ្មី ។
ទី៩៖ សូម ជន មាន ពិការភាព គ្រប់ រូប ដែល គ្រប់ អាយុ បោះឆ្នោត អញ្ជើញ ទៅ ចុះឈ្មោះ និង បោះឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា តាម ឆន្ទៈ រៀង ៗ ខ្លួន ៕ កុំ ឲ្យ ថ្ងៃ សប្បាយ ក្លាយជា ទុក្ខ ដោយសារ ការបើកបរ របស់ អ្នក ! គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៣ ខែធ្នូ ម្សិលមិញ គ្មាន អ្នកស្លាប់ ទេ មាន តែ អ្នករបួស ១៣នាក់
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក មិន បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ទេ មាន តែ របួស ធ្ងន់ ស្រាល ១៣នាក់ ។
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ !
ក្រសួង សុខាភិបាល ណែនាំ អ្នក ធ្វើ អាជីវកម្ម ផ្តល់ សេវា សុខាភិបាល យកចិត្តទុកដាក់ គ្រប់គ្រង និង អនុវត្ត អាជីវកម្ម ឱ្យ ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស សុខាភិបាល (Video inside) ( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល បាន ចេញ សេចក្តីណែនាំ ថ្មី មួយ ឱ្យ អ្នក ធ្វើ អាជីវកម្ម ផ្តល់ សេវា សុខាភិបាល យកចិត្តទុកដាក់ គ្រប់គ្រង និង អនុវត្ត អាជីវកម្ម ឱ្យ បាន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស សុខាភិបាល ។
សេចក្តីណែនាំ របស់ ក្រសួង សុខាភិបាល ធ្វើឡើង បន្ទាប់ពី ផ្ទុះ បាតុភាព ដ៏ ភ្ញាក់ផ្អើល និង សង្វេ គ មួយ ដោយ ពេទ្យ ឆ្មប នៅ មន្ទីរ ព្យាបាល អង្ក្រង ក្នុង ខេត្ត កំពង់ស្ពឺ បាន រំលូត កូន នាំឱ្យ ដាច់ ពោះវៀន ស្ត្រី ជា ម្តាយ ។
ក្រសួង បាន សង្កត់ធ្ងន់ ថា អ្នក ដែល ប្រព្រឹត្ត ខុសឆ្គង ពី វិជ្ជាជីវៈ ឬ មាន ការរធ្វេសប្រហែស លើ ការងារ គ្រប់គ្រង មូលដ្ឋាន សុខាភិបាល ឯកជន របស់ ខ្លួន ឬ ធ្វើឱ្យ មាន កំហុស បច្ចេកទេស ធ្ងន់ធ្ងរ ណាមួយ បន្ថែម លើ ការដាក់ វិន័យ នៃ គណៈវិជ្ជាជីវៈ នីមួយ ៗ នឹង ត្រូវ ប្រឈម ទៅនឹង ច្បាប់ ទៅ តាម សណ្ឋាន ទម្ងន់ ទោស ដែល មាន ចែង នៅក្នុង ច្បាប់ ទាំងនោះ ។
ជាមួយនឹង ការចេញ សេចក្តីណែនាំ ហើយ នោះ ក្រសួង បាន ភ្ជាប់ មក ជាមួយ នូវ ច្បាប់ ចំនួន ពីរ ផងដែរ ដើម្បី ក្រើន រំលឹក ពី ការទទួលខុសត្រូវ របស់ អ្នក ផ្តល់ សេវាកម្ម សុខាភិបាល ។ ច្បាប់ ទាំង ពីរ នោះ រួម មាន៖ ច្បាប់ ស្តីពី ការរំលូត កូន និង ច្បាប់ ស្តីពី ការគ្រប់គ្រង អ្នក ប្រកប វិជ្ជាជីវៈ វិស័យ សុខាភិបាល ៕ អគ្គ លេខាធិការ សមាគម ទីក្រុង ប្រចាំ តំបន់ អាស៊ី ប៉ាហ្វិក៖ បើ គ្មាន ការដឹកនាំ ត្រឹមត្រូវ មិន អាច រៀបចំ កិច្ចប្រជុំ ធំ២ ក្នុង ពេល តែ មួយ នៅ រាជធានី ភ្នំពេញ បាន ល្អ ប្រសើរ នោះ ទេ
( ភ្នំពេញ ) ៖ លោកស្រី បណ្ឌិត អ៉ីរ៉ាវ៉ា ទី ជិន ដ្រា ដេវី អគ្គ លេខាធិការ សមាគម ទីក្រុង និង រដ្ឋបាល មូលដ្ឋាន ប្រចាំ តំបន់ អាស៊ី ប៉ាស៊ីហ្វីក និង វេទិកា អភិបាល ក្រុង អាស៊ាន (AMF) បាន ថ្លែង ថា ក្រោម ការដឹកនាំ របស់ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ធ្វើឲ្យ រាជធានី ភ្នំពេញ រៀបចំ កិច្ចប្រជុំ ធំ២ ក្នុង ពេល តែ មួយ បាន ដោយ ជោគជ័យ បំផុត ហើយ លោកស្រី បាន សម្ដែង នូវ ការកោតសរសើរ ដោយ ស្មោះ អស់ ពី ចិត្ត ។
លោកស្រី អ៉ីរ៉ាវ៉ា ទី ជិន ដ្រា ដេវី បាន គូសបញ្ជាក់ ថា ទោះបី កិច្ចប្រជុំ ទាំង២ ខាងលើ មាន រយៈពេល ខ្លី តែ អភិបាល ក្រុង ឬ តំណាង ទីក្រុង នានា មកពី តំបន់ អាស៊ាន បាន ចូលរួម ពិភាក្សា និង ផ្តល់ បទពិសោធន៍ ដ៏ មាន តំលៃ សម្រាប់ ការអភិវឌ្ឍន៍ ទីក្រុង និង ជំរុញ កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ ដើម្បី ទីក្រុង ឆ្លាត មាន ភាពធន់ និង មាន ចីរភាព ។
លោកស្រី បាន បន្ថែម ថា ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក៏ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ឱកាស បើក កិច្ចប្រជុំ និង បាន ផ្តល់ អនុសាសន៍ ដ៏ មាន តំលៃ ដែល មាន ខ្លឹមសារ យ៉ាង ជ្រាលជ្រៅ ក្នុង ការពង្រឹង កិច្ចសហការ អាស៊ាន តាមរយៈ ការជំរុញ ការកសាង ទីក្រុង ឆ្លាត មាន ភាពធន់ និង មាន ចីរភាព ប្រកបដោយ បរិវត្តកម្ម និង បរិយាបន្ន័ តាម គន្លង ប្រក្រតី ភាព ថ្មី ។
បើ តាម លោកស្រី អគ្គ លេខាធិការ នៅពេល ខាងមុខ អភិបាល ក្រុង របស់ អាស៊ាន អាច ពិភាក្សា ការងារ ជាមួយ ចិន បូក ឥណ្ឌា បូក កូរ៉េ បូក ជប៉ុន ឬ ក៏ អាច បូក អូស្ត្រាលី ទាំង ពហុ ភាគី និង ទ្វេ ភាគី ថែម ទៀត ។
បន្ថែម ពី នេះ លោក ឃួង ស្រេង បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការយកចិត្តទុកដាក់ របស់ លោកស្រី អ៉ីរ៉ាវា ទី ជិន ដ្រា ដេវី និង បាន ផ្តល់ ការគាំទ្រ ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ លោក ក្នុង ការអភិវឌ្ឍន៍ ទីក្រុង ពី បទពិសោធន៍ ល្អ ៗ ដែល លោកស្រី មាន ក៏ដូច អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន ដទៃ ទៀត ដែរ ៕
រាជធានី ភ្នំពេញ និង រដ្ឋធានី វៀង ចន្ទ ជំរុញ ទំនាក់ទំនង ទីក្រុង ទាំង ពីរ ឲ្យ កាន់តែ ល្អ ប្រសើរ មួយ កម្រិត ថែម ទៀត
( ភ្នំពេញ ) ៖ អភិបាល រាជធានី ភ្នំពេញ និង អភិបាល រដ្ឋធានី វៀង ចន្ទ បាន ជំរុញ ទំនាក់ទំនង ការទូត រវាង ទីក្រុង ទាំង ពីរ ឲ្យ កាន់តែ ល្អ ប្រសើរ មួយ កម្រិត ថែម ទៀត ដើម្បី បម្រើ ផលប្រយោជន៍ ឲ្យ ប្រជាពលរដ្ឋ នៃ ប្រទេស ទាំង ពីរ ។
ការជំរុញ នេះ ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ ក្នុង ជំនួប ពិភាក្សា ទ្វេ ភាគី រវាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង លោក អាត់ សាផាន ថង ស៊ី ផាន ជូន អភិបាល រដ្ឋធានី វៀង ចន្ទ នៅ សណ្ឋាគារ រ៉េស៊ី ដង់ សុខា ភ្នំពេញ ។
ក្នុង ឱកាស នោះ ភាគី ទាំង២ បាន ផ្លាស់ប្ដូរ មតិ យោបល់ និង ពិភាក្សា លើ កិច្ចការ ផ្សេង ៗ ទៀត ដូចជា ត្រួតពិនិត្យ លើ កិច្ចសហប្រតិបត្តិការ រវាង រដ្ឋធានី វៀង ចន្ទ និង រាជធានី ភ្នំពេញ ការគ្រប់គ្រង ទេសចរណ៍ រដ្ឋបាល ទីក្រុង និង ពង្រឹង ការគ្រប់គ្រង ហិរញ្ញវត្ថុ ផងដែរ ។
លោក ឃួង ស្រេង បាន រំលឹក ថា កាលពី ៤០ ឆ្នាំ មុន រាជធាន ភ្នំពេញ ជា ទីក្រុង ខ្មោច តែ ក្រោយពេល រំដោះ ប្រទេសជាតិ ដោយ សម្ដេច តេជោ ហ៊ុន សែន បាន ធ្វើឲ្យ ទីក្រុង មួយ នេះ មាន ការអភិវឌ្ឍ រីកចម្រើន ដែល យើង បាន ឃើញ ស្រាប់ នៅ ពេល នេះ ។ ក្រោម សន្តិភាព ជាង ២០ ឆ្នាំ រាជធានី ភ្នំពេញ មាន រចនាសម្ព័ន្ធ មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ដែល នេះ បង្ហាញ ឲ្យ ឃើញ ពី តម្លៃ នៃ សន្តិភាព ។
ជាមួយគ្នា នេះ លោក អាត់ សាផាន ថង ស៊ី ផាន ជូន បាន សម្ដែង នូវ ការកោតសរសើរ ចំពោះ អាជ្ញាធរ រាជធានី ភ្នំពេញ ដែល បាន រៀបចំ កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន និង វេទិការ អភិបាល ក្រុង អាស៊ាន នេះ ទទួលបាន ជោគជ័យ ។ បន្ថែម ពី នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន គ្រប់គ្រង ការទប់ស្កាត់ នូវ ការរីករាល ជំងឺ កូវីដ១៩ បាន យ៉ាង ល្អ រហូត ទទួលបាន ការកោតសរសើរ ពី ឆាក អន្តរជាតិ ។
បន្ថែម ពី នេះ លោក អភិបាល រដ្ឋធានី វៀង ចន្ទ ក៏ បាន អញ្ជើញ អភិបាល រាជធានី ភ្នំពេញ ទៅ បំពេញ ទស្សនកិច្ច នៅ រដ្ឋធានី វៀង ចន្ទ នៅពេល ខាងមុខ នេះ ។
ចំពោះ ការស្នើ ឡើង ជុំវិញ ការផ្លាស់ប្ដូរ អាហារូបករណ៍ និស្សិត ទៅ សិក្សា នៅ ប្រទេស ឡាវ និង និស្សិត ឡាវ មក សិក្សា នៅ រាជធានី ភ្នំពេញ អភិបាល រាជធានី ភ្នំពេញ បាន ឯកភាព ។ ចំណែក អញ្ជើញ លោក ឲ្យដឹកនាំ ប្រតិភូ រាជធានី ភ្នំពេញ ទៅ បំពេញ ទស្សនកិច្ច នៅ រដ្ឋធានី វៀង ចន្ទ លោក បាន បញ្ជាក់ ថា នឹង រៀបចំ ប្រតិភូ ទៅ បំពេញ ទស្សនកិច្ច នៅ រដ្ឋធានី វៀង ចន្ទ នៅក្នុង ពេលវេលា សមស្រប មួយ ៕
យោង តាម ស្ថិតិ ដែល ចេញផ្សាយ ដោយ ក្រសួង សុខាភិបាល សិង្ហបុរី បាន ឲ្យដឹង ថា ក្នុង ចំណោម ករណី សរុប ខាងលើ នេះ មាន ចំនួន ១១៦ នាក់ កំពុង សម្រាក ព្យាបាល នៅក្នុង មន្ទីរពេទ្យ ។
ប៉ុន្តែ មិន មាន ករណី គ្មាន ការស្លាប់ ត្រូវបាន គេ រាយការណ៍ នោះ ទេ នៅ ថ្ងៃសៅរ៍ នេះ ដែល ធ្វើឲ្យ ចំនួន អ្នកស្លាប់ សរុប មិន ផ្លាស់ប្តូរ គឺ នៅ ១. ៧០៥ នាក់ ៕
ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង លោក ដាំ សិទ្ធិ ជា ទីប្រឹក្សា រាជ រដ្ឋាភិបាល
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ត្រាស់បង្គាប់ តែងតាំង លោក ដាំ សិទ្ធិ ជា ទីប្រឹក្សា រាជ រដ្ឋាភិបាល ឋានៈ ស្មើ រដ្ឋលេខាធិការ ។
សូម បញ្ជាក់ ថា លោក ដាំ សិទ្ធិ ជា អតីត តំណាងរាស្ត្រ អតីត គណបក្ស សង្គ្រោះ ជាតិ ។ លោក ដាំ សិទ្ធិ ទើបនឹង ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា នា ពេល ថ្មី ៗ នេះ ៕
ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង លោក ប៉ែន បូណា ជា រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ត្រាស់បង្គាប់ តែងតាំង លោក ប៉ែន បូណា ជា រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន ។
សូម បញ្ជាក់ ថា លោក ប៉ែន បូណា គឺជា អ្នកសារព័ត៌មានវិជ្ជាជីវៈ ដែល បាន ប្រឡូក ក្នុង វិស័យ នេះ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។ បច្ចុប្បន្ន លោក មាន តួនាទី ជា ប្រធាន ក្លឹប អ្នកកាសែត កម្ពុជា ផងដែរ ៕ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ ២រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ មួយ តែងតាំង មុខ តំណែង អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ ចំនួន ២នាក់ ។
យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៣ ខែ ធ្នូ៖ បង្ក្រាប ២១ករណី ឃាត់ខ្លួន ៥៧ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២១ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី . ដឹកជញ្ជូន រក្សាទុក ៥ករណី និង ជួញដូរ ១១ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥៧ នាក់ ។
ឆ្លងកាត់ ការសរសេរ សៀវភៅ ទាំង នេះ ខាង ថា យ និង ជូ អ៉ីង បាន រៀបរាប់ អំពី ស្ថានភាព នៅ កម្ពុជា នា សម័យ នគរ ភ្នំ ដល់ ប្រជាជន ចិន ធ្វើឱ្យ ជនជាតិ ចិន យល់ដឹង និង ស្គាល់ ពី កម្ពុជា បាន កាន់ ច្រើន រួមចំណែក ដល់ ការផ្សព្វផ្សាយ ប្រវត្តិសាស្ត្រ ទំនាក់ទំនង វប្បធម៌ កម្ពុជា និង ចិន ។ ស្រប ពេល នោះ ដែរ ស្នាដៃ លោក ពីរ ក៏ ជា ឯកសារ ប្រវត្តិសាស្ត្រ ដែល បាន រៀបរាប់ ពី កម្ពុជា នា សម័យ នោះ ផងដែរ ៕
ក្រសួង ធនធាន ទឹក ជូនដំណឹង ពី មរណភាព លោក ម៉ី លី ហួត អនុ រដ្ឋលេខាធិការ ក្នុង ជន ន្មាយុ ៦៦ ឆ្នាំ ដោយ រោគា ពាធ
ក្រសួង ធនធាន ទឹក បាន បញ្ជាក់ ថា សព លោក ម៉ី លី ហួត តម្កល់ ធ្វើ បុណ្យ ទក្ខិណា នុប្បទាន តាម ប្រពៃណី ជាតិ នៅ ផ្ទះ លេខ ៨៩A ផ្លូវ លេខ១ បុរី ហុង ឡាយ ( លូ៥ ) ភូមិ ទ្រា៤ សង្កាត់ ស្ទឹងមានជ័យ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។
ពិធី គោរព វិញ្ញាណក្ខន្ធ ចាប់ផ្តើម នៅ ថ្ងៃអាទិត្យ ទី ០៤ ខែធ្នូ ឆ្នាំ ២០២២ ។ នៅ ថ្ងៃទី ០៥ ខែធ្នូ ឆ្នាំ ២០២២ វេលា ម៉ោង ០២៖០០ នាទី រសៀល សព នឹង ត្រូវ រំកិល ចេញ ពី គេហដ្ឋាន ដង្ហែ ឆ្ពោះ ទៅកាន់ ឈាប នដ្ឋាន វត្ត ពោធិ៍ ចិន តុង ។
ព័ត៌មាន នេះ ចាត់ទុក ជា សេចក្ដីអញ្ជើញ សម្តេច ឯកឧត្តម លោកជំទាវ លោក លោកស្រី ព្រមទាំង ញាតិមិត្ត ជិត ឆ្ងាយ នៃ សព មេត្តា ជ្រាប និង ជ្រាប ជា ព័ត៌មាន និង សូម មេត្តា អញ្ជើញ ចូលរួម ពិធី បុណ្យ សព ៕ រដ្ឋបាល ខណ្ឌ បឹងកេងកង ណែនាំ ដល់ អាជីវករ លក់ និង កន្លែង ហ្វូតូ កូពី មាន ទីតាំង ជាប់ បរិវេណ មណ្ឌល ប្រឡង បាក់ឌុប ឱ្យ ផ្អាក អាជីវកម្ម បណ្ដោះអាសន្ន ចាប់ពី ថ្ងៃទី៤ ដល់ ថ្ងៃទី ៦ ខែធ្នូ
រដ្ឋបាល ខណ្ឌ បឹងកេងកង « សង្ឃឹម ថា បងប្អូន អាជីវករ ប្រកបរបរ លក់ និង កន្លែង ហ្វូតូ កូពី ដែល មាន ទីតាំង ជាប់ បរិវេណ មណ្ឌល ប្រឡង ទាំងអស់ ផ្អាក អាជីវកម្ម បណ្ដោះអាសន្ន ដោយ គិត ចាប់ពី ថ្ងៃទី ០៤ ខែធ្នូ ឆ្នាំ ២០២២ វេលា ម៉ោង ២៤: ០០នាទី ដល់ ថ្ងៃទី ០៦ ខែធ្នូ ឆ្នាំ ២០២២ » ។
រដ្ឋបាល ខណ្ឌ បឹងកេងកង សង្ឃឹម និង ជឿជាក់ លើ ស្មារតី ចូលរួម សហការ របស់ បងប្អូន អាជីវករ ក្នុង ការផ្អាក បណ្តោះអាសន្ន ការលក់ដូរ ម្ហូប អាហារ សំលៀកបំពាក់ និង កន្លែង ហ្វូតូ កូពី ដែល ស្ថិត នៅ ជុំវិញ និង ជាប់ មណ្ឌល ប្រឡង ទាំងអស់ ក្នុង មូលដ្ឋាន ខណ្ឌ បឹងកេងកង ៕
ខាងក្រោម ជា សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ខណ្ឌ៖ អភិបាល ខេត្ត បន្ទាយមានជ័យ ចុះ ដោះស្រាយ បញ្ហា ប្រឈម មួយ ចំនួន ក្នុង ស្រុក ថ្ម ពួក
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃទី ៣ ខែធ្នូ ឆ្នាំ ២០២២ លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ស្រុក ថ្ម ពួក បាន អញ្ជើញ ចុះ ត្រួតពិនិត្យ និង ដោះស្រាយ បញ្ហា ប្រឈម
នានា ក្នុង ស្រុក ថ្ម ពួក ដោយ ធ្វើ ការកសាង និង ជួសជុល ផ្លូវ ដែល មាន ការលំបាក ឬ ខូចខាត ក្នុង ភូមិ ក្នុង ឃុំ ថ្ម ពួក និង ឃុំ គំរូ ស្រុក ថ្ម ពួក ស្រុក ថ្ម ពួក ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ក្នុង ការធ្វើដំណើរ ងាយស្រួល ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ ។
ក្នុង ឱកាស ចុះ ពិនិត្យមើល លោក អ៊ុំ រាត្រី បាន ជំរុញ ឲ្យ មន្ត្រី ជំនាញ ខេត្ត និង អ្នកបច្ចេកទេស ពន្លឿន ការសិក្សា រួច ត្រូវ ប្រញាប់ប្រញាល់ ដាក់ គ្រឿងចក្រ ធ្វើ ផ្លូវ ដែល ជា កន្លែង អទិភាព មុន ព្រោះ រដូវ នេះ ជា រដូវ ប្រមូល ផល កសិកម្ម របស់ ប្រជាពលរដ្ឋ ត្រូវការដឹកជញ្ជូន ភោគផល ធ្វើដំណើរ ទៅ មក ។
លោក បាន គូសបញ្ជាក់ ថា ក្នុង នាម ក្រុមការងារ ទទួល ស្រុក ថ្ម ពួក នឹង បន្ត ខិតខំ រួមគ្នា ទាំងអស់ ដើម្បី សិក្សា ដោះស្រាយ បញ្ហា ប្រឈម នានា ឲ្យ អស់ លទ្ធភាព ដើម្បី រួម សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ប្រជាពលរដ្ឋ អភិវឌ្ឍន៍ ភូមិ ឃុំ ។
ជាមួយគ្នា នោះ លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បាន ក្រើន រំលឹក ដាស់តឿន បន្ថែម ដល់ ក្រុមការងារ ទទួល ឃុំ ភូមិ ទាំងអស់ ក្នុង ស្រុក ថ្ម ពួក សូម ចុះ មូលដ្ឋាន ជាប់ ជាប្រចាំ ដល់ ភូមិ ខ្នង ផ្ទះ ផ្ទះ ដើម្បី ក្តាប់ បញ្ហា ដោះស្រាយ ឲ្យបាន បើ ករណី ដោះស្រាយ មិន បាន សូម ធ្វើ របាយការណ៍ ច្បាស់លាស់ មក ខេត្ត ដើម្បី លើក គម្រោង និង ប្រជុំ ដោះស្រាយ ជា បន្តបន្ទាប់ ទៀត ៕
គណៈ គ្រូពេទ្យ ខេត្ត សៀមរាប អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ បើ មាន សមាជិក ក្រុមគ្រួសារ ឈឺ សូម ទៅ រក សេវា ព្យាបាល ដែល មាន វិជ្ជាជីវៈ ត្រឹមត្រូវ និង ស្រប ច្បាប់
ការអំពាវនាវ នេះ បន្ទាប់ពី មាន ករណី បុគ្គល មួយ រូប ដែល មិន មែន ជា ពេទ្យ បាន ចាក់ ថ្នាំ ព្យ បាល ទៅ លើ កុមារី ម្នាក់ ឈ្មោះ ប៊ាន ស្រី ឡុន អាយុ ៥ ឆ្នាំ រហូតដល់ ស្លាប់ ដែល ម្តាយ ឈ្មោះ ឡាន់ គិម ឡុន និង ឪពុក ឈ្មោះ បឿង ប៊ាន ដែល រស់ នៅ ភូមិ ពង្រ ឃុំ នគរ ភាស ស្រុក នគរ ជុំ ខេត្ត សៀមរាប ។ ហេតុការណ៍ នេះ កើតឡើង នៅ វេលា ម៉ោង ៨៖៣០ នាទី យប់ ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
លោក វេជ្ជបណ្ឌិត អ៊ុយ ចាន់ថុល ប្រធាន ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ខេត្យ សៀមរាប បាន ប្រាប់ Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ៣ ខែធ្នូ ឆ្នាំ ២០២២ ថា គណៈ គ្រូពេទ្យ ខេត្យ សៀមរាប បាន សហការ ជាមួយ សមត្ថកិច្ច ឃាត់ខ្លួន ពេទ្យ ក្លែងក្លាយ ដែល បាន ចាក់ ថ្នាំ ព្យ បាល ទៅ លើ កុមារី ម្នាក់ រហូតដល់ ស្លាប់ ធ្វើឡើង នៅ ថ្ងៃទី១ ខែធ្នូ ឆ្នាំ ២០២២ ។
គ្រូពេទ្យ ក្លែងក្លាយ ដែល សមត្ថកិច្ច ឃាត់ខ្លួន មាន ឈ្មោះ វេ វី រស់ នៅ ភូមិ ទន្លេ ស ឃុំ នគរ ភាស ស្រុក នគរ ជុំ ខេត្ត សៀមរាប ដែល អតីត ជាង ១០ ឆ្នាំ មុន ជា កម្មករ នៅ មណ្ឌល សុខភាព បន្ទាប់មក គាត់ បាន ឈប់ ធ្វើ កម្មករ បាន ទៅ រស់ នៅក្នុង ភូមិ ហើយ បាន ដើរ ចាក់ ថ្នាំ ឱ្យ ប្រជាពលរដ្ឋ នៅ តាម ភូមិ ហើយក៏ ធ្លាប់ មាន បញ្ហា ជាច្រើន ដង រួច មកហើយ ដែរ អាជ្ញាធរ ក៏ បាន ហៅ គាត់ មក ធ្វើ កិច្ចសន្យា ០៣ ដង រួច មកហើយ ដើម្បីឱ្យ គាត់ ឈប់ ប្រកប របរ នេះ តទៅទៀត តែ គាត់ នៅតែ លួច ដើរ ចាក់ ថ្នាំ ឱ្យ បករជា ពលរដ្ឋ ។
ទន្ទឹមនឹង នេះ ដែរ លោក វេជ្ជបណ្ឌិត អ៊ុយ ចាន់ថុល លោក បាន សំណូមពរ ដល់ អ្នក ដែល មិន មែន ពេទ្យ ទាំងអស់ ឱ្យ បញ្ឈប់ ប្រកប មុខរបរ នឹង តទៅទៀត ដោយ ងាក ទៅ ប្រកប មុខរបរ ឬ ក៏ វិជ្ជាជីវៈ ផ្សេង ៗ ដែល ខ្លួន ចេះ ទៅ សូម កុំ ប្រកបរបរ ពេទ្យ តទៅទៀត ព្រោះ អី យើង មិន មែន ពេទ្យ ផង ដែល នាំឲ្យ មាន ទោស និង ជាប់ ពន្ធនាគារ ជាដើម ។
ជាមួយ នេះ ដែរ គណៈ គ្រូពេទ្យ ខេត្ត សៀមរាប ក៏ សូម ថ្លែងអំណរគុណ ដល់ សមត្ថកិច្ច មន្ទីរ សុខាភិបាល ខេត្ត និង ស្រុក ប្រតិបត្តិ ដែល ជានិច្ចកាល តែងតែ ជួយ ដល់ គណៈ គ្រូពេទ្យ ខេត្ត សម្រេចបាន គោលដៅ ព្រមទាំង ដើម្បី សុខភាព ជូន ប្រជាពលរដ្ឋ ផងដែរ ។ សូម បញ្ជាក់ ផងដែរ បច្ចុប្បន្ន នេះ ជនល្មើស ឈ្មោះ វេ វី ត្រូវបាន សមត្ថកិច្ច កំពុង រៀបចំ សំណុំរឿង ដើម្បី ចាត់ការ បន្ត ទៅ តាម នីតិវិធី ច្បាប់ ៕ រដ្ឋបាល ខេត្ត ព្រៃវែង ប្រកាស មិន យក ថ្លៃ ផ្ញើ មធ្យោបាយ ធ្វើដំណើរ របស់ សិស្ស ដែល ប្រឡង បាក់ឌុប
( ព្រៃវែង ) ៖ ដើម្បី ជួយ សម្រួល ដល់ ការចំណាយ របស់ មាតា បិតា អាណាព្យាបាល និង សិស្សានុសិស្ស ជា បេក្ខជន ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិន្ទ នៅ ថ្ងៃទី ៥ - ៦ ខែធ្នូ ឆ្នាំ ២០២២ រាល់ ការផ្ញើ មធ្យោបាយ ធ្វើ ដំណើរ ទាំងអស់ ( កង់ ម៉ូតូ រថយន្ត ) របស់ សិស្ស ជា បេក្ខជន នៅ តាម មណ្ឌល ប្រឡង ក្នុង ខេត្ត ព្រៃវែង ពុំ តម្រូវឲ្យ មាន ការបង់ប្រាក់ ឡើយ ហើយ រាល់ ការចំណាយ ជាបន្ទុក របស់ រដ្ឋបាល ខេត្ត ព្រៃវែង ។
នេះ ជា សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ព្រៃវែង៖ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង ក្រចេះ បើក កិច្ចប្រជុំ ជីវភាព នយោបាយ និង បូកសរុប ការងារ ប្រចាំ ខែវិច្ឆិកា ឆ្នាំ ២០២២ និង ឧបត្ថម្ភ ថវិកា ដល់ សមាជិក បក្ស ១៥០ នាក់
( ក្រចេះ ) ៖ លោក ឈឿន ប៊ុណ្ណា រ័ត្ន សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង ក្រចេះ និង លោកស្រី សៅ សុគន្ធារី អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង ក្រចេះ នា ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០២២ បាន អញ្ជើញ បើក កិច្ចប្រជុំ ជីវភាព នយោបាយ និង បូកសរុប ការងារ ប្រចាំ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នៅ ទីស្នាក់ការ គណបក្ស ខេត្ត ក្រចេះ ។
នា ឱកាស នោះ លោក ឈឿន ប៊ុណ្ណា រ័ត្ន បាន ដាក់ ទិសដៅ បន្ត ចំនួន ១០ ចំណុច ដែល មាន ខ្លឹមសារ សំខាន់ ៗ ដូច ខាងក្រោម៖
* ទី ១៖ ជា សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ត្រូវ ប្រកាន់ ជំហរ ថ្កោល ទោស ចំពោះ ជន ក្បត់ ជាតិ ៣ជំនាន់ សម រង្សី ដែល ប្រមាថ យ៉ាង ធ្ងន់ធ្ងរ បំផុត ដល់ ព្រះចេស្តា ព្រះមហាក្សត្រ ខ្មែរ ។
* ទី ២៖ ទោះបី ការគ្រប់គ្រង ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ បាន ល្អ ប្រសើ ហើយក៏ ដោយ ក៏ ត្រូវ បន្ត ខិតខំ ផ្សព្វផ្សាយ និង ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ទទួល ចាក់ វ៉ាក់សាំង ដូស ជំរុញ បន្ថែម ឱ្យ បាន គ្រប់ គ្នា ព្រោះ ស្ថានភាព នៃ ការរាលដាល ជំងឺ កូវីដ១៩ នៅតែ បន្ត និង គំរាមកំហែង ដល់ សុខភាព ប្រជាជន ។
* ទី៣៖ ត្រូវ ចេះ ផ្សព្វផ្សាយ សមិទ្ធិផល ធំ ៗ ដែល រាជ រដ្ឋាភិបាល សម្រេចបាន ដូចជា កម្ពុជា ទទួលបាន ជោគជ័យ យ៉ាង ធំធេង និង ទទួលបាន លទ្ធផល យ៉ាង ត្រចះត្រចង់ ជា ប្រវត្តិសាស្រ្ត ក្នុង នាម ជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ ។
* ទី៥៖ ត្រូវ ចេះ ទាញយក ផលប្រយោជន៍ តាមរយៈ ការផ្សព្វផ្សាយ ពី ការឧបត្ថម្ភ សាច់ប្រាក់ របស់ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ដល់ ប្រជាពលរដ្ឋ ជួប ការលំបាក ក្នុង កំឡុង ពេល ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
* ទី៦៖ ព្យាយាម ដោះស្រាយ ទំនាស់ ក្រៅ ប្រព័ន្ធ តុលាការ ឱ្យ បានជា អតិបរិមា ។
* ទី៧៖ ត្រូវ រៀបចំ ចង ក្រង កម្លាំង សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ។
* ទី៨៖ បន្តរ ពង្រីក និង ពង្រឹង សមាជិក បក្ស ហើយ កំណត់ ឱ្យ បាន ច្បាស់ ពី សមាជិក ចំណាកស្រុក ។
* ទី៩៖ ក្រុមប្រឹក្សា សង្កាត់ ទាំងអស់ ត្រូវ រួមគ្នា បម្រេី ប្រជាពលរដ្ឋ អោយ អស់ លទ្ធភាព តាមរយៈ ការប្រេី ប្រាស់ កញ្ចប់ ថវិកា អភិវឌ្ឍ សង្កាត់ អោយ មាន តម្លាភាព ប្រសិទ្ធភាព និង ស័ក្តិសិទ្ធិភាព ។
* ទី១០៖ ត្រូវ រៀបចំ លើក គម្រោង ផែនការចំណាយ សម្រាប់ ពេល យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ឱ្យ ហើយ ចាប់ពី ពេលនេះ តទៅ ។
ក្នុង ឱកាស នោះ លោក ក៏ បាន នាំយក អំពូល សូឡា និង ជើង អំពូល ដែលេជា អំដោយ របស់ ឧកញ៉ា ធាង ទ្រី ជូន គណបក្ស ក្រុង ក្រចេះ ចំនួន ១០ ឈុត . មន្ទីរ អប់រំ យុវជន និង កីឡា ចំនួន ១០ ឈុត . វត្ត ក្រគរ ចំនួន ១០ ឈុត និង ប៉ុស្តន៍ រដ្ឋបាល សង្កាត់ ទាំង៥ ចំនួន ៤ឈុត ក្នុង មួយ ប៉ុស្តន៍ រដ្ឋបាល សរុប រួម ចំនួន ៥០ ឈុត ។ ដោយឡែក លោកស្រី សៅ សុគន្ធារី បាន ឧបត្ថម្ភ ថវិកា ដល់ សមាជិ សមាជិកា ដែល បាន ចូលរួម ចំនួន ១៥០ នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ២០.០០០ រៀល សរុប រួម អស់ ចំនួន ៣.០០០.០០០ រៀល ៕
អភិបាល ខេត្ត ព្រះសីហនុ ចុះ ពិនិត្យ វត្ថុតាង និង នាំយក ថវិកា មួយ ចំនួន ជូន កងកម្លាំង នគរបាល ខេត្ត សម្រាប់ ចុះ បង្រ្កាប គ្រឿងញៀន រយៈពេល ៣ ថ្ងៃ
( ព្រះសីហនុ) ៖ នា ល្ងាច ថ្ងៃទី ២ ខែធ្នូ ឆ្នាំ ២០២២ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន អញ្ជើញ ចុះ ពិនិត្យ វត្ថុតាង និង នាំយក ថវិកា ដើម្បី លើកទឹកចិត្ត ដល់ កងកម្លាំង នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ក្នុង ការបង្ក្រាប ករណី គ្រឿងញៀន ចាប់ពី ថ្ងៃទី ៣០ ខែវិច្ឆិកា រហូតដល់ ថ្ងៃទី២ ខែធ្នូ ឆ្នាំ ២០២២ ។
ក្នុង ប្រតិបត្តិការ នេះ ក៏ មាន ការដឹកនាំ បញ្ជារ ផ្ទាល់ ពីសំណាក់ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ . កម្លាំង ជំនាញ ការិយាល័យ នគរបាល ប្រឆាំង គ្រឿងញៀន បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៥នាក់ ជា បន្តបន្ទាប់ ( ខ្មែរ ២នាក់ វៀតណាម ៣នាក់ ) ។ ជនជាតិ វៀតណាម ៣នាក់ ដែល បាន ឃាត់ខ្លួន នៅ សណ្ឋាគារ លិជឺ ខា អឺ ទួន ស្ថិត នៅ ក្រុម ទី៩ ភូមិ ៣ សង្កាត់ ៤ ក្រុង - ខេត្ត ព្រះសីហនុ សមត្ថកិច្ច បាន ដកហូត ថ្នាំ ញៀន ជាង ៣គីឡូក្រាម ។
ក្នុង ឱកាស នោះ លោក គួច ចំរើន បាន ថ្លែង ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ដល់ កងកម្លាំង និង មន្ត្រី នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ បាន យកចិត្តទុកដាក់ ខិតខំ បំពេញ ការងារ ក្នុង ការថែរក្សា សន្តិសុខ សុវត្ថិភាព ជូន បងប្អូន ប្រជាពលរដ្ឋ ក៏ ដូចជា ភ្ញៀវ ទេសចរណ៍ ជាតិ និង អ្នក វិនិយោគ ក្នុង ខេត្ត ព្រះសីហនុ ពិសេស ក្នុង ការបង្ការ បង្ក្រាប នូវ រាល់ បទល្មើស បាន ទាន់ ពេលវេលា ៕
ថ្លែង ក្នុង ពិធី បិទ វេទិកា អភិបាល ក្រុង អាស៊ាន (AMF) ឆ្នាំ ២០២២ នៅ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការចូលរួម យ៉ាង សកម្ម ប្រកបដោយ ចក្ខុវិស័យ ជាក់ស្តែង និយម និង ការគិតគូរ យកចិត្តទុកដាក់ ក្នុង ន័យ ស្ថាបនា ជួយ គ្នា ទៅ វិញ ទៅ មក ដើម្បី រួមចំណែក ធ្វើឲ្យ ប្រសើរឡើង នូវ ការពិភាក្សា លើ គ្រប់ ទិដ្ឋភាព ដែល សុទ្ធសឹងតែ ជា អនុសាសន៍ សម្រាប់ ទិសដៅ រួមគ្នា នៃ ការអភិវឌ្ឍ ទីក្រុង អាស៊ាន នៅ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ។
លោក ឃួង ស្រេង បាន បញ្ជាក់ ថា បញ្ហា ប្រឈមមុខ ទៅ និង កាលៈទេសៈ និង ទស្សនវិស័យ សកល នា ពេល បច្ចុប្បន្ន និង ទៅ អនាគត ថ្នាក់ដឹកនាំ ទីក្រុង អាស៊ាន បាន យល់ស្រប គ្នា អំពី សារៈសំខាន់ នៃ ភាពជាដៃគូ និង កិច្ចសហប្រតិបត្តិការ សម្រាប់ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ក្នុង ការឆ្លើយតប ទៅនឹង បញ្ហា ប្រឈម រួម ដោយ ឈរ លើ ស្មារតី សាមគ្គីភាព និង ការទទួលខុសត្រូវ ខ្ពស់ ដែល ជា មូលដ្ឋាន ដ៏ ចាំបាច់ ក្នុង ការលើកកម្ពស់ ការស្តារ ឡើងវិញ នូវ សេដ្ឋកិច្ច និង សង្គមកិច្ច ក្រោយ វិបត្តិ នៃ ជំងឺ កូវីដ១៩ ។
បន្ថែម ពី នេះ ទៀត បាន ជំរុញ សន្ទុះ នៃ ការកសាង ទីក្រុង ឆ្លាត មាន ភាពធន់ និង មាន ចីរភាព ប្រកបដោយ បរិវត្តកម្ម និង បរិយាប័ន្ន តាម គន្លង ប្រក្រតី ភាព ថ្មី ដូច អ្វី ដែល យើង បាន កំណត់ ជា ប្រធានបទ នៃ អង្គ វេទិកា អភិបាល ក្រុង អាស៊ាន ក្នុង ឆ្នាំ នេះ ។
លោក បាន បន្ត ថា អង្គ វេទិកា បាន ដំណើរការ បាន ពិភាក្សា យ៉ាង ស៊ីជម្រៅ អំពី សារៈសំខាន់ និង ភាពចាំបាច់ នៃ កិច្ចសហប្រតិបត្តិការ ល្អ ក្នុង ចំណោម រាជធានី - រដ្ឋធានី អាស៊ាន រដ្ឋបាល ខេត្ត ទីក្រុង សម្ព័ន្ធ មេត្រី និង បណ្តា ទីក្រុង អាស៊ាន ក្នុង ន័យ ជំរុញ ឲ្យ សម្រេចបាន ទីក្រុង ដែល ឆ្លាត មាន ភាពធន់ និង ចីរភាព ជាពិសេស នៅ ចំពោះមុខ បរិបទ នៃ ទំនើបកម្ម បច្ចេកវិទ្យា ឌីជីថល ក៏ ដូចជា វិបត្តិ ជា សកល បង្កឡើង ដោយ ជំងឺ កូវីដ១៩ ។
បើ តាម លោក ឃួង ស្រេង តាមរយៈ វេទិកា និង កិច្ចប្រជុំ នេះ សម្រេចបាន ឯកសារ ជា ប្រវត្តិសាស្ត្រ ចំនួន ២ច្បាប់ រួម មាន ទី ១៖ សេចក្តីប្រកាស រួម កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន ដែល មាន ខ្លឹមសារ ចំនួន ៦ ចំណុច និង ទី ២៖ សេចក្តីថ្លែងការណ៍ វេទិកា អភិបាល ក្រុង អាស៊ាន (AMF) ឬ ហៅ ថា សេចក្ដីថ្លែងការណ៍ រាជធានី ភ្នំពេញ ឆ្នាំ ២០២២ ដែល មាន ខ្លឹមសារ ចំនួន ១២ ចំណុច ពោលគឺ សមស្រប ទៅនឹង ប្រធានបទ ដែល បាន កំណត់ ។
ឯកសារ ជា ប្រវត្តិសាស្ត្រ ទាំង ពីរ នេះ ពិតជា បាន ឆ្លុះបញ្ចាំង ឲ្យ ឃើញ កាន់តែ ច្បាស់ អំពី ឆន្ទៈ និង ការប្តេជ្ញាចិត្ត រួម របស់ អភិបាល / អភិបាល រង រាជធានី រដ្ឋធានី ខេត្ត និង ក្រុង នៃ ប្រទេស ជា សមាជិក អាស៊ាន ក្នុង ការពួត ដៃ គ្ន បន្ត ដំណើរ ទៅ មុខ រួមគ្នា និង ជំរុញ កិច្ចសហប្រតិបត្តិការ កាន់តែ ជិតស្និទ្ធ បន្ថែម ទៀត ដើម្បី កសាង ទីក្រុង ឆ្លាត មាន ភាពធន់ និង មាន ចីរភាព សម្រាប់ បម្រើ ឲ្យ កំណើន សេដ្ឋកិច្ច និង វិបុលភាព រួម ស្រប តាម ចក្ខុវិស័យ របស់ សហគមន៍ អាស៊ាន ឆ្នាំ ២០២៥ និង ក្រោយ ឆ្នាំ ២០២៥ ផងដែរ ។
សូម បញ្ជាក់ ថា រដ្ឋបាល ក្រុង នៃ ប្រទេស ឥណ្ឌូណេស៊ី បាន ក្លាយជា ប្រធាន ប្តូរ វេន នៃ កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន MGMAC និង វេទិកា អភិបាល ក្រុង អាស៊ាន AMF នៅ ឆ្នាំ ២០២៣ ខាងមុខ ដោយ បាន ប្តេជ្ញា បន្ត បម្រើ ជា យន្តការប្រើប្រាស់ ជា វេទិកា ជជែក ពិភាក្សា ចែករំលែក បទពិសោធន៍ ក៏ ដូចជា គំនិត ផ្តួចផ្តើម និង ន វានុវត្តន៍ ថ្មី ៗ បន្ថែម ទៀត សម្រាប់ ភាពរីកចម្រើន នៃ បណ្ដាញ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ អាស៊ាន ៕
កម្មវិធី ជំនួយ សង្គមជា សាច់ប្រាក់ ជូន គ្រួសារ ងាយ រង ហានិភ័យ ដែល រង ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ពី គ្រោះ ទឹក ជំនន់ ត្រូវ អនុវត្ត ការបើក ផ្ដល់ជូន មួយ ខែ ម្ដង សម្រាប់ រយៈពេល ៣ខែ ចាប់ពី ខែធ្នូ ឆ្នាំ ២០២២ត ទៅ ៕
មាត្រា១ នៃ អនុក្រឹត្យ បាន សម្រេច៖ ត្រូវបាន បង្កើត មូលនិធិ កម្ពុជា គ្មាន មីន ឆ្នាំ ២០២៥ សរសេរ ជា អក្សរ កាត់ « ម .ក . គ.ម - ២០២៥ » សម្រាប់ គ្រប់គ្រង ថវិកា ក្នុង ការបោសសម្អាត មីន និង គ្រាប់ មិន ទាន់ ផ្ទុះ ព្រមទាំង រំដោះ ផ្ទៃដី សង្ស័យ មាន មីន និង គ្រាប់ មិន ទាន់ ផ្ទុះ ដើម្បី ចូលរួម គាំទ្រ គោលដៅ កម្ពុជា អស់ មីន ឆ្នាំ ២០២៥ ។
មាត្រា២ នៃ អនុក្រឹត្យ បាន គូសបញ្ជាក់ ថា ប្រភព ធនធាន សម្រាប់ មូលនិធិ មាន ប្រភព ពី៖ * ដំណាក់កាល ដំបូង ជា ថវិកា រដ្ឋ មាន ទំហំ ១២៣. ១៨០ លាន រៀល ស្មើនឹង ប្រមាណ ៣០លាន ដុល្លារ ។
* វីភាគ ទាន ថវិកា រដ្ឋ សម្រាប់ ឆ្នាំ ២០២៣. ២០២៤ និង ២០២៥ តាម ការចាំបាច់ ជាក់ស្តែង និង វិភាគទាន ពី ប្រភព ស្រប ច្បាប់ ផ្សេង ទៀត ។
បន្ទាប់ពី ទទួលបាន ការអនុម័ត ពី នាយក រដ្ឋមន្ត្រី អាជ្ញាធរ កម្ពុជា គ្រប់គ្រង សកម្មភាព កម្ចាត់ មីន និង សង្គ្រោះ ជន ពិការ ដោយសារ មីន ត្រូវ រៀបចំ គម្រោង ស្នើសុំ ថវិកា ទៅ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដើម្បី ពិនិត្យ និង ផ្តល់ ជូន តាម ការជាក់ស្តែង ។
ភ្លើង សង្គ្រាម ចាប់ពី ចុង ទសវត្សរ៍ ៦០ រហូតដល់ ចុង ទសវត្សរ៍ ៩០ បាន ធ្វើឱ្យ គ្រាប់ មីន និង គ្រាប់ យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ រាប់ លាន គ្រាប់ បន្សល់ នៅ ពាសពេញ ផ្ទៃដី កម្ពុជា ។ រយៈពេល ៣០ ឆ្នាំ ហើយ ដែល កម្ពុជា បាន ប្រឹងប្រែង បោស សំអាត មីន និង គ្រាប់ យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ ចេញ ពី ផ្ទៃដី ដើម្បី ផ្តល់ ដី សុវត្ថិភាព និង ស្នាមញញឹម ជូន ប្រជាពលរដ្ឋ កម្ពុជា ។ ប៉ុន្តែ ការបោសសំអាត នេះ មិន ទាន់ បាន រួចរាល់ ទាំងស្រុង នៅឡើយ នៅឡើយ ទេ កម្ពុជា កំណត់ យក ឆ្នាំ ២០២៥ បោស សំអាត មីន ឱ្យ បាន អស់ ពី ផ្ទៃដី កម្ពុជា ។
ការចេញ អនុក្រឹត្យ ស្តីពី ការបង្កើត មូលនិធិ កម្ពុជា គ្មាន មីន ឆ្នាំ ២០២៥ គឺជា ការប្តេជ្ញាចិត្ត ដ៏ មុតមាំ មួយ បន្ថែម ទៀត របស់ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ការបោសសំអាត មីន នាំយក ផ្ទៃដី សុវត្ថិភាព និង ស្នាមញញឹម ជូន ប្រជាពលរដ្ឋ កម្ពុជា ។
រាជធានី - ខេត្ត របស់ កម្ពុជា ចំនួន ៥ ត្រូវបាន ប្រកាស អស់ មីន រួម មាន៖ ខេត្ត ស្ទឹងត្រែង កែប ព្រៃវែង ភ្នំពេញ និង ព្រះសីហនុ ។ ខេត្ត បន្តបន្ទាប់ ទៀត ដែល នឹង ត្រូវ ប្រកាស ជា ខេត្ត អស់ មីន ក្រោម គម្រោង សម្តេច តេជោ សម្រាប់ សកម្មភាព មីន « ផ្តល់ ដី សុវត្ថិភាព បង្កើត ស្នាមញញឹម » រួម មាន ខេត្ត ត្បូងឃ្មុំ កំពង់ចាម កំពង់ឆ្នាំង តាកែវ កំពត ស្វាយរៀង កំពង់ស្ពឺ និង ក្រចេះ ៕ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម កម្ពុជា ចុះ ស្វែងយល់ អំពី ខ្សែ ច្រវាក់ ផលិតកម្ម ទឹកត្រី « ង៉ូវ ហេង កំពត » ដើម្បី ជំរុញ ការនាំចេញ ទៅ កូរ៉េ ខាងត្បូង
លើស ពី នេះ លោក រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម បាន ផ្ដល់ អនុសាសន៍ ណែនាំ ដល់ ក្រុមហ៊ុន ទឹកត្រី ង៉ូវ ហេង សិក្សា រ ស្វែងយល់ និង ទាញយក បច្ចេកទេស បទពិសោធន៍ ថ្មី ៗ បន្ថែម ទៀត ពី ខាង ភាគី កូរ៉េ ដើម្បី បង្កើន គុណភាព ផលិតភាព និង ស្ដង់ដារ ផលិតផល របស់ ខ្លួន ទៅកាន់ ទីផ្សារ អន្តរជាតិ ។
ប៉ុន្តែ អ្នកនាំពាក្យ ម្នាក់ នៃ របប យោធា មីយ៉ាន់ម៉ា មិន បាន ធ្វើ អត្ថាធិប្បាយ អ្វី នោះ ទេ នៅពេល ត្រូវបាន សាកសួរ ដោយ អ្នកសារព័ត៌មាន ខណៈ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ មីយ៉ាន់ម៉ា រាយការណ៍ ថា ក្រុម និស្សិត ខាងលើ ត្រូវបាន ចាប់ខ្លួន កាលពី ខែមេសា ឆ្នាំ ២០២២ ពី បទ មាន ជាប់ពាក់ព័ន្ធ នឹង ករណី បាញ់ប្រហារ នៅ ធនាគារ មួយ កន្លែង ។
មីយ៉ាន់ម៉ា បាន ធ្លាប់ ចូល ក្នុង ភាពចលាច ល និង អំពើហិង្សា ចាប់តាំងពី រដ្ឋាភិបាល ស៊ីវិល របស់ លោកស្រី អោង សាន ស៊ូជី ត្រូវបាន បណ្ដេញចេញ ពី អំណាច ដោយ ការធ្វើ រដ្ឋប្រហារ យោធា កាលពី ខែកុម្ភៈ ឆ្នាំ ២០២១ ដែល បាន បិទ បញ្ចប់ ប្រជាធិបតេយ្យ អន្តរកាល នៅក្នុង ប្រទេស អាស៊ី អាគ្នេយ៍ មួយ នេះ ៕
( ភ្នំពេញ ) ៖ បន្ទាប់ពី បញ្ចប់ កិច្ចប្រជុំ អភិបាល រាជធានី - រដ្ឋធានី អាស៊ាន និង វេទិកា ប្រជុំ អភិបាល ក្រុង អាស៊ាន នៅ វេលា ថ្ងៃត្រង់ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ នេះ លោក នួន ផារ័ត្ន អភិបាល រង រាជធានី ភ្នំពេញ បាន រៀបចំ សន្និសីទ សារព័ត៌មាន ដើម្បី បង្ហាញ អំពី លទ្ធផល នៃ កិច្ចប្រជុំ ។
សម្តេច តេជោ ហ៊ុន សែន ប្ដេជ្ញាចិត្ត លើកកម្ពស់ សិទ្ធិ ជន មាន ពិការភាព ឱ្យ កាន់តែ ប្រសើ ឡើង (Video inside) ( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ប្រធាន កិត្តិយស ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ បាន ប្ដេជ្ញាចិត្ត ខ្ពស់ ក្នុង ការលើកកម្ពស់ សិទ្ធិ ជន មាន ពិការភាព និង សូម លើកទឹកចិត្ត ឱ្យ ជន រួម ជាតិ រួមគ្នា បន្ត លើកស្ទួយ សុខុមាលភាព ជន មាន ពិការ ភាព ឱ្យ កាន់តែ ប្រសើ ឡើង ដើម្បី ជា ឧត្តម ប្រយោជន៍ របស់ វិស័យ ពិការភាព នៅ កម្ពុជា ។
ការបង្ហាញ ការប្តេជ្ញាចិត្ត នេះ បាន ធ្វើឡើង តាមរយៈ សារលិខិត អបអរសាទរ ក្នុង ឱកាស ទិវា ជន មាន ពិការភាព កម្ពុជា លើក ទី២៤ និង ទិវា ជន មាន ពិការ ភាព អន្តរជាតិ លើក ទី ៤០ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ ។
សម្តេច តេជោ ហ៊ុន សែន សុំ ការយោគយល់ អធ្យាស្រ័យ ពីសំណាក់ ជន មាន ពិការភាព កម្ពុជា ចំពោះ ការអាក់ខាន មិន បាន រៀបចំ នូវ ការជួបជុំ ជូន បងប្អូន មាន ពិការភាព ព្រោះ ជា ការចាំបាច់ ដែល ប្រជាជន យើង ទាំងអស់ គ្នា ត្រូវតែ ចូលរួម អនុវត្ត « ៣កុំ ៣ការពារ » ដែល ជា លទ្ធផល អាច ធ្វើឱ្យ យើង ទាំងអស់ គ្នា រស់រាន មាន ជីវិត និង បាន ជួបជុំ សប្បាយរីករាយ ឡើងវិញ ក្រោយ វិបត្តិ កូវីដ១៩ ។
សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង យ៉ាង ដូច្នេះ ថា៖ « រាជ រដ្ឋាភិបាល នឹង បន្ត យកចិត្តទុកដាក់ និង ប្ដេជ្ញាចិត្ត ខ្ពស់ ក្នុង ការលើកកម្ពស់ សិទ្ធិ ជន មាន ពិការភាព និង សូម លើកទឹកចិត្ត ឱ្យ បងប្អូន ជន រួម ជាតិ យើង ទាំងអស់ រួមគ្នា បន្ត លើកស្ទួយ សុខុមាលភាព ជន មាន ពិការ ភាព ឱ្យ កាន់តែ ប្រសើ ឡើង ដើម្បី ជា ឧត្តម ប្រយោជន៍ របស់ វិស័យ ពិការភាព នៅ កម្ពុជា » ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា បច្ចុប្បន្ន ជន មាន ពិការភាព ត្រូវបាន យកចិត្តទុកដាក់ ពី គ្រប់ មជ្ឈដ្ឋាន ។ ក្នុង ឆ្នាំ ២០២២ ជន មាន ពិការ ភាព ចូល បម្រើ ការងារ ក្នុង ក្រសួង ស្ថាប័ន រដ្ឋ ចំនួន ៣៧ មាន ចំនួន ៣. ៧៤៨ នាក់ ក្នុង នោះ ស្រ្តី មាន ពិការភាព ចំនួន ៨៦២ នាក់ ជន មាន ពិការភាព កម្រិត ធ្ងន់ ចំនួន ២. ២៦០នាក់ បើ គិត ជា ភាគរយ ២. ០១% កើន លើស ឆ្នាំ ២០២១ ។
( ភ្នំពេញ ) ៖ លោក ម៉ី លី ហួត អនុ រដ្ឋលេខាធិការ ក្រសួង ធនធាន ទឹក និង ឧត្តុនិយម បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ១០និង ៥៦ នាទី ព្រឹក ថ្ងៃសៅរ៍ ១០កើត ខែមិគសិរ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស ២៥៦៦ ត្រូវនឹង ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ ក្នុង ជន្មាយុ ៦៦ ឆ្នាំ ដោយ រោគា ពាធ ។
សព លោក ម៉ី លី ហួត ត្រូវបាន តម្កល់ ទុក ធ្វើ បុណ្យ តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា នៅ ផ្ទះ លេខ ៨៩A ផ្លូវ លេខ១ បុរី ហុង ឡាយ លូ៥ ភូមិ ទ្រា៤ សង្កាត់ ស្ទឹងមានជ័យ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។ នេះ ចាត់ ជា ការជូនដំណឹង ដល់ ញាតិ មិត្ត ជិត ឆ្ងាយ ដើម្បី ចូលរួម ក្នុង កម្មវិធី បុណ្យ សព ទៅ តាម សន្ធា ជ្រះថ្លា ៕
សភា ពាណិជ្ជកម្ម មណ្ឌល ខេត្ត សៀមរាប - ឧត្តរមានជ័យ រៀបចំ កិច្ចប្រជុំ ត្រៀម ជ្រើសតាំង បង្រ្គប់ កូរ៉ុម ប្រធាន អនុប្រធាន សម្រាប់ អាណត្តិ ទី៣ លើក ទី១
( សៀមរាប ) ៖ សភា ពាណិជ្ជកម្ម មណ្ឌល ខេត្ត សៀមរាប - ឧត្តរមានជ័យ បាន រៀបចំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ បើក ការិយាល័យ ចុះឈ្មោះ បោះឆ្នោត ជ្រើសរើស សមាជិក ជ្រើសតាំង សភា ពាណិជ្ជកម្ម មណ្ឌល ខេត្ត សៀមរាប - ឧត្តរមានជ័យ អាណត្តិ ទី៣ លើក ទី១ ។
កិច្ចប្រជុំ បាន ធ្វើឡើង នៅ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត សៀមរាប នា ព្រឹក ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០២២ ក្រោម អធិបតីភាព របស់ លោក ម៉ៅ ថូរ៉ា រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម លោក នាក់ ណេរ៉ុន អភិបាល រង ខេត្ត សៀមរាប ព្រមទាំង លោក លោកស្រី សមាជិក សមាជិកាសភា ពាណិជ្ជកម្ម មណ្ឌល ខេត្ត សៀមរាប - ឧត្ដរ មានជ័យ ជាច្រើន រូប ទៀត ។
ឧកញ៉ា បណ្ឌិត ហ៊ុយ ភៀវ អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង ជា ប្រធាន សភា ពាណិជ្ជកម្ម មណ្ឌល ខេត្ត សៀមរាប - ឧត្តរមានជ័យ បាន ថ្លែង ថា នៅ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ ខាងមុខ នេះ ជា ថ្ងៃ ចាប់ លេខរៀង បោះឆ្នោត ហើយ នៅ ថ្ងៃទី ២២ ខែមករា ឆ្នាំ ២០២៣ ខាងមុខ ជា ថ្ងៃ បោះឆ្នោត ជ្រើសរើស សមាជិក ជ្រើសតាំង បង្រ្គប់ កូរ៉ុម ប្រធាន អនុប្រធាន សម្រាប់ អាណត្តិ ទី៣ លើក ទី១ ៕
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ នេះ វេទិកា អភិបាល ក្រុង អាស៊ាន (AMF) ដែល រដ្ឋបាល រាជធានី ភ្នំពេញ ធ្វើជា ម្ចាស់ ផ្ទះ បាន ចាប់ផ្ដើម ប្រជុំ បូកសរុប លទ្ធផល នៃ កិច្ចពិភាក្សា ចំនួន ៥ ចំណុច ដែល បាន បែងចែក ក្រុម ពិភាក្សា កាលពី ម្សិលមិញ ។
កិច្ចពិភាក្សា ជា ក្រុម នៅ រសៀល ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០២២ ម្សិលមិញ រួម មាន៖
* ទី១៖ ការធ្វើ ហិរញ្ញប្បទាន គម្រោង ដែល មាន ចីរភាព ដើម្បី ការអភិវឌ្ឍ ទីក្រុង
* ទី២៖ ការអនុវត្ត គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព នៅ កម្រិត មូលដ្ឋាន . ការស្វែងយល់ ពី កិច្ចសហប្រតិបត្តិការ និង ការអនុវត្ត គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ដើម្បី បន្ស៉ី គ្នា រវាង ផែនការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ក្នុង ទីក្រុង នៅ កម្រិត ប្រទេស នីមួយ ៗ និង កម្រិត តំបន់ ក៏ ដូចជា នៅ រដ្ឋបាល មូលដ្ឋាន អាស៊ាន
* ទី៣៖ អភិបាលកិច្ច ឌីជីថល ការជំរុញ បរិវត្តកម្ម ក្នុង ទីក្រុង សម្រាប់ ការចូលរួម របស់ រដ្ឋាភិបាល និង ប្រជាពលរដ្ឋ សំដៅ សម្រេចបាន ឌីជីថលូបនីយកម្ម ក្នុង អាស៊ាន
* ទី៤៖ នគរូបនីយកម្ម អាស៊ាន ប្រកបដោយ ចីរភាព ការបង្ហាញ របាយការណ៍ នគរូបនីយកម្ម អាស៊ាន ប្រកបដោយ ចីរភាព
* ទី៥៖ ភាពធន់ នឹង អាកាសធាតុ ក្នុង ទីក្រុង និង ការកាត់បន្ថយ ហានិភ័យ គ្រោះ មហន្ដរាយ នៅក្នុង តំបន់ អាស៊ាន ។
កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន គឺជា វេទិកា មួយ សម្រាប់ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន ទាំង១០ ដើម្បី លើកឡើង និង ពិភាក្សា អំពី បញ្ហា ប្រឈម ក្នុង ទីក្រុង នា ពេល បច្ចុប្បន្ន និង ដែល អាច កើត មាន ឡើង ព្រមទាំង ចែករំលែក ការអនុវត្ត ល្អ ៗ ក៏ ដូចជា ទស្សនៈ ល្អ ៗ សម្រាប់ ការកសាង សហគមន៍ អាស៊ាន ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ខកខាន មិន បាន រៀបចំ រយៈពេល ២ឆ្នាំ ជាប់ គ្នា គឺ គ្រាន់តែ ចេញ សេចក្តីថ្លែងការណ៍ ពី ចំងាយ ដោយសារ មូលហេតុ នៃ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។ នៅ ឆ្នាំ ២០២២ នេះ កម្ពុជា គឺជា ប្រធាន ប្តូរ វេន របស់ អាស៊ាន ដោយ រដ្ឋបាល រាជធានី ភ្នំពេញ ជា អ្នក រៀបចំ កិច្ចប្រជុំ នេះ ដោយ ផ្ទាល់ ឡើងវិញ នា ថ្ងៃទី ០២ - ០៣ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ៕
ធនាគារ ជាតិ នៃ កម្ពុជា នឹង រៀបចំ សន្និសីទ ថ្នាក់ ទេសាភិបាល ស៊ាសិន លើក ទី ៥៨ និង កិច្ចប្រជុំ ក្រុមប្រឹក្សា នៃ ទេសាភិបាល ស៊ាសិន លើក ទី ៤២ រយ : ពេល ៣ថ្ង ក្នុង ក្រុង សៀមរាប
សន្និសីទ នា ឆ្នាំ នេះ ត្រូវបាន រៀបចំឡើង ក្រោម មូល បទ៖ « បញ្ហា ប្រឈម នៃ គោល នយោបាយ បច្ចុប្បន្ន៖ បរិបទ សេដ្ឋកិច្ច សកល និង អាស៊ី បញ្ហា ប្រឈម នៃ ការផ្លាស់ប្តូរ និង ការពង្រីក ការផ្តល់ ហិរញ្ញប្បទាន អាកាសធាតុ » ។
ទន្ទឹម នេះ លោក ជា ចាន់តូ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា ក្នុង នាម ជា ប្រធាន ប្តូរ វេន នឹង ដឹកនាំ កិច្ចប្រជុំ ក្រុមប្រឹក្សា នៃ ទេសាភិបាល ស៊ាសិន លើក ទី ៤២ ដើម្បី ពិនិត្យ និង ពិភាក្សា លើ វឌ្ឍនភាព ការងារ របស់ មជ្ឈមណ្ឌល ស៊ាសិន ដែល សម្រេចបាន ក្នុង រយៈពេល ១ឆ្នាំ កន្លងទៅ នេះ និង កំណត់ ទិសដៅ ការងារ ចម្បង ៗ ដែល នឹង គាំទ្រ ដល់ មុខងារ - ភារកិច្ច របស់ មជ្ឈមណ្ឌល ស៊ា សិន ដែល ក្នុង នោះ រួម មាន៖
* ការបណ្តុះបណ្តាល ជំនាញ ការងារ . ធនាគារ កណ្តាល ភាព ជា អ្នកដឹកនាំ ការពង្រឹង ការស្រាវជ្រាវ ក្នុង តំបន់ និង ការលើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ជា សមាជិក ។
គណៈប្រតិភូ ដែល ចូលរួម សន្និសីទ និង កិច្ចប្រជុំ ខាងលើ ក៏ នឹង អញ្ជើញ ទស្សនា ស្វែងយល់ . ពី សក្តានុពល ទេសចរណ៍ ប្រវត្តិសាស្រ្ត កម្ពុជា ក៏ ដូចជា វប្បធម៌ និង ប្រពៃណី ខ្មែរ ដែល មាន លើ ទឹកដី នៃ ខេត្ត សៀមរាប ផងដែរ ។
គួរ រំលេច ថា មជ្ឈមណ្ឌល ស៊ាសិន ត្រូវបាន បង្កើតឡើង តាំងពី ឆ្នាំ ១៩៨២ ដោយ មាន បេសកកម្ម ចម្បង ផ្តោត លើ ការពង្រឹង សមត្ថភាព ជំនាញ របស់ មន្រ្តី - បុគ្គលិក ធនាគារ កណ្តាល និង អាជ្ញាធរ រូបិយវត្ថុ ជា សមាជិក តាមរយៈ ការបណ្តុះបណ្តាល និង ស្រាវជ្រាវ ។
បច្ចុប្បន្ន មជ្ឈមណ្ឌល ស៊ាសិន មាន សមាជិក ដែល ជា ធនាគារ កណ្តាល និង អាជ្ញាធរ រូបិយវត្ថុ ចំនួន ១៩ ដូច ជា៖ ព្រុយណេ កម្ពុជា ចិន ឥណ្ឌា ឥណ្ឌូណេស៊ី ហុងកុង កូរ៉េ ខាងត្បូង ឡាវ ម៉ាឡេស៊ី ម៉ុងហ្គោលី មីយ៉ាន់ម៉ា នេប៉ាល់ ប៉ាពូ អាស៊ី នូវែល - ហ្គីណេ ហ្វីលីពីន សិង្ហបុរី ស្រីលង្កា តៃវ៉ាន់ ថៃ និង វៀតណាម ៕
ប្រធាន ស្ថាប័ន ហិរញ្ញវត្ថុ អន្តរជាតិ ដ៏ ធំ ៗ នៅក្នុង ពិភពលោក ជាច្រើន បាន លើកឡើង ជាយូរ មកហើយ អំពី កម្រិត បំណុល ពិភពលោក ដែល មាន ចំនួន ច្រើន បំផុត ជាពិសេស នៅ ពេល ដែល អាជ្ញាធរ រូបិយវត្ថុ នានា ត្រូវ ដំឡើង អត្រា ការប្រាក់ ដើម្បី ទប់ស្កាត់ ការកើនឡើង អតិផរណា ។
( ប៉េកាំង ) ៖ ទីភ្នាក់ងារ វាយតម្លៃ ចំណាត់ថ្នាក់ ឥណទាន Moody's បាន ឱ្យដឹង កាលពី ថ្ងៃសុក្រ ថា ហានិភ័យ ចំពោះ ស្ថិរភាព នៃ ប្រព័ន្ធ ហិរញ្ញវត្ថុ របស់ ចិន កំពុង កើនឡើង ដោយសារ ការបន្ត ធ្លាក់ចុះ នៃ វិស័យ អចលន ទ្រព្យ របស់ ប្រទេស នេះ និង ការថមថយ សេដ្ឋកិច្ច ដែល ធ្វើឱ្យ ធនាគារ តូច ៗ កាន់តែ ងាយ រងគ្រោះ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ។
វិស័យ អចលន ទ្រព្យ របស់ ប្រទេស ចិន បាន ធ្លាក់ចុះ យ៉ាង ខ្លាំង ក្នុង ឆ្នាំ នេះ បន្ទាប់ពី មាន ការ ដាក់ចេញ វិធានការ ដោយ ទីក្រុង ប៉េកាំង ក្នុង រារាំង ការខ្ចី ប្រាក់ ច្រើន ហួស ហេតុ ពីសំណាក់ ក្រុមហ៊ុន អភិវឌ្ឍន៍ ។ កិច្ចប្រឹងប្រែង នេះ បាន បង្កឱ្យ មាន ការធ្លាក់ចុះ ការវិនិយោគ លើ អចលន ទ្រព្យ ការលក់ និង តម្លៃ និង ការកើនឡើង ការបរាជ័យ សង បំណុល សម្រាប់ មូលបត្រ បំណុល ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ដោយ ដកស្រង់ របាយការណ៍ មួយ ដែល ចេញផ្សាយ ដោយ ក្រុមហ៊ុន Moody's ថា៖ « ទ្រនាប់ ការពារ ប្រព័ន្ធ ហិរញ្ញវត្ថុ មួយចំនួន កំពុង ធ្លាក់ចុះ ដែល នឹង បង្ក ហានិភ័យ ប្រសិនបើ ការធ្លាក់ចុះ នៃ អចលន ទ្រព្យ កាន់តែ អូសបន្លាយ ពេល » ។ ក្រុមហ៊ុន នេះ បាន បន្ថែម ថា តម្រូវការ ដែល ថយចុះ បាន រក្សា ចក្ខុវិស័យ អវិជ្ជមាន សម្រាប់ វិស័យ អចលន ទ្រព្យ ។
របាយការណ៍ ដដែល នេះ បាន បន្ត ថា៖ « ហានិភ័យ ចំពោះ ស្ថិរភាព នៃ ប្រព័ន្ធ ហិរញ្ញវត្ថុ របស់ ប្រទេស ចិន កំពុង កើនឡើង ក្នុង គ្រា ដែល មាន ការធ្លាក់ចុះ នៅក្នុង វិស័យ អចលន ទ្រព្យ និង ការការថម សេដ្ឋកិច្ច របស់ ប្រទេស ចិន » ។ ក្នុង រយៈពេល ប៉ុន្មាន សប្តាហ៍ ថ្មី ៗ នេះ ទីក្រុង ប៉េកាំង បាន បង្កើន ការគាំទ្រ ដល់ ការបង្កើន សាច់ប្រាក់ងាយស្រួល ក្នុង ឧស្សាហកម្ម នេះ ដែល ស្មើនឹង មួយ ភាគ បួន នៃ សេដ្ឋកិច្ច ចិន ដែល ជា សេដ្ឋកិច្ច ធំ ទី ពីរ របស់ ពិភពលោក និង ជា កត្តា ជំរុញ ដ៏ សំខាន់ នៃ កំណើន សេដ្ឋកិច្ច ។
ធនាគារ ពាណិជ្ជ ធំ ៗ របស់ ប្រទេស នេះ ក៏ បាន ផ្តល់ ឥណទាន ថ្មី យ៉ាងហោចណាស់ ១៦២ ពាន់ លាន ដុល្លារ ដល់ ក្រុមហ៊ុន អភិវឌ្ឍន៍ អចលន ទ្រព្យ ផងដែរ ។
របាយការណ៍ ដដែល នេះ បាន ឱ្យដឹង ទៀត ថា ខណៈពេល ដែល គោល នយោបាយ ថ្មី របស់ រដ្ឋាភិបាល ចិន អាច បន្ធូរបន្ថយ ឧបសគ្គ ផ្នែក ថវិកា ក៏ដោយ ក៏ វា នឹង ត្រូវការ ពេលវេលា ដើម្បី ទទួលបាន លទ្ធផល ផង ដេរ ។
យោង តាម ក្រុមហ៊ុន Moody's ទោះបីជា ប្រព័ន្ធ ធនាគារ ជាទូទៅ មាន ភាពរឹងមាំ ក៏ដោយ ក៏ ធនាគារ តូច ៗ មាន ភាពងាយ រងគ្រោះ បំផុត និង ប្រឈមមុខ នឹង ហានិភ័យ ជាច្រើន ពី វិស័យ អចលន ទ្រព្យ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ៕
ក៏ប៉ុន្តែ ភ្លាម ៗ ខាង ក្រសួង ការបរទេស អូស្ត្រាលី មិន ទាន់ ធ្វើ អត្ថាធិប្បាយ ឆ្លើយតប ទៅនឹង សេចក្ដីរាយការណ៍ ខាង លើ ឡើយ ហើយ គម្រោង នៃ ដំណើរទស្សនកិច្ច នេះ ទៀតសោត ត្រូវបាន រាយការណ៍ ក្រោយ គណបក្ស កាន់អំណាច ប្រកាស ពី បំណង ស្ដារ ទំនាក ទំនង ជាមួយ ចិន ឡើងវិញ ៕
សម្តេច តេជោ ហ៊ុន សែន ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា បក្ស មកពី ខេត្ត កណ្តាល
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ខេត្ត កណ្តាល ។ ពិធី សំណេះសំណាល ធ្វើឡើង នៅ វិមាន ៧មករា ក្នុង រាជធានី ភ្នំពេញ ។
ជំនួប សំណេះសំណាល នេះ ធ្វើឡើង ដើម្បី ពិនិត្យ ឡើងវិញ នូវ សមិទ្ធផល ការងារ ដែល បាន បំពេញ នៅ អាណត្តិ ទី៦។ បន្ថែម ពីលើ នោះ គឺជា ឱកាស ដើម្បី សម្តេច តេជោ បាន ណែនាំ និង ផ្តល់ នូវ អនុសាសន៍ ការងារ មួយចំនួន សម្រាប់ ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នៅ ឆ្នាំ ២០២៣ ៕
គួរ បញ្ជាក់ ថា លោក ប្រធានាធិបតី វ៉្លាឌីមៀ ពូទីន កាលពី ខែកញ្ញា កន្លងទៅ បាន ផ្ដល់ សញ្ជាតិ រុស្ស៉ី ឱ្យ លោក ស្នូដិន ដែល បាន រត់គេចខ្លួន ចេញ ពី សហរដ្ឋ អាមេរិក បន្ទាប់ពី បាន ទម្លាយ ការសម្ងាត់ របស់ ទីភ្នាក់ងារ សន្តិសុខ ជាតិ អាមេរិក NSA ជុំវិញ ការលួច ស្ដាប់ កិច្ចសន្ទនា នៃ សម្ព័ន្ធមិត្ត របស់ ទីក្រុង វ៉ាស៊ីនតោន ៕
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៤៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០២ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៤៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០២ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ០៣ ខែធ្នូ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤៧ នាក់ នោះ មាន ១៦នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្ន បទល្មើស ព្រហ្មទណ្ឌ ១៥ករណី និង ជនសង្ស័យ ៣១ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១០ករណី ។
បើកបរ កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ២នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០២ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ស្រាល ១០នាក់ ។
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០២២ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ០២ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖ ១៖ លោក បៃ ដិន និង លោក ម៉ាក្រុង ប្តេជ្ញា រួមគ្នា ជួយ ដល់ អ៊ុយក្រែន ហើយ ឈាន ទៅ បញ្ចប់ ភាពតានតឹង ផ្នែក ឧបត្ថម្ភ ធន
៥៖ វិមាន ក្រឹមឡាំង បដិសេធ លក្ខខណ្ឌ របស់ លោក បៃ ដិន សម្រាប់ កិច្ចពិភាក្សា សង្រ្គាម អ៊ុយក្រែន
៦៖ ក្រសួង ការបរទេស ចិន៖ ភាគី ចិន នឹង បន្ត ប្រកាន់ខ្ជាប់ នូវ ការ បង្ការ និង គ្រប់គ្រង ដោយ វិទ្យាសាស្ត្រ និង ចំ គោលដៅ ដើម្បី ធានា ឱ្យ សេដ្ឋកិច្ច និង សង្គម បន្ត អភិវឌ្ឍ ប្រកបដោយ ភាពរឹងមាំ និង ស្ថិរភាព
លោក ឃួង ស្រេង៖ ការផ្លាស់ប្ដូរ ទស្សនទាន របស់ តំណាង រាជធានី - រដ្ឋធានី អាស៊ាន បញ្ជាក់ ពី ការប្ដេជ្ញាចិត្ត ដ៏ រឹងមាំ រួមគ្នា ឆ្ពោះទៅ សម្រេច ការកសាង សហគមន៍ អាស៊ាន ឲ្យ កាន់តែ ស្អិត រមួត លើ គ្រប់ វិស័យ
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន លើកឡើង ថា ការផ្លាស់ប្ដូរ ទស្សនទាន តាមរយៈ ការធ្វើ បទបង្ហាញ របស់ តំណាង រាជធានី - រដ្ឋធានី អាស៊ាន និង ការចូលរួម មតិ យោបល់ ពិភាក្សា គ្នា បាន គូសបញ្ជាក់ យ៉ាង ច្បាស់ អំពី ការប្ដេជ្ញាចិត្ត ដ៏ រឹងមាំ របស់ យើង ទាំងអស់ គ្នា ក្នុង ការរួមគ្នា ឆ្ពោះទៅ សម្រេច ការកសាង សហគមន៍ អាស៊ាន មួយ ដែល កាន់តែ មាន ភាព ស្អិត រមួត លើ គ្រប់ វិស័យ ។
ការថ្លែង របស់ លោក ឃួង ស្រេង ត្រូវបាន ធ្វើឡើង ក្នុង ឱកាស បិទ កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន ឆ្នាំ ២០២២ ក្រោម ប្រធានបទ « ការជំរុញ កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ ដើម្បី ទីក្រុង ស្អាត មាន ភាពធន់ និង មាន ចីរភាព » នា ល្ងាច ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ដែល រដ្ឋបាល រាជធានី ភ្នំពេញ ធ្វើជា ម្ចាស់ ផ្ទះ ។ កិច្ចប្រជុំ នេះ ធ្វើឡើង នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
លោក ឃួង ស្រេង បាន អះអាង ទៀត ថា ភាព ស្អិត រមួត លើ ទំនាក់ទំនង របស់ សហគមន៍ អាស៊ាន មិន ថា នៅ កម្រិត ថ្នាក់ ជាតិ ឬ កម្រិត ថ្នាក់ ក្រោម ជាតិ ដើម្បី ប្រជាជាតិ អាស៊ាន ប្រជាជន នៃ បណ្ដា រាជធានី - រដ្ឋធានី តាមរយៈ ការកសាង ទីក្រុង ឆ្លាត មាន ភាពធន់ និង មាន ចីរភាព ពោលគឺ សមស្រប ទៅនឹង មូល បទ នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ - ៤១ ដែល ទើប កន្លងផុត ទៅ ថ្មី ៗ នេះ គឺ « អាស៊ាន រួមគ្នា ធ្វើ៖ ដោះស្រាយ បញ្ហា ប្រឈម ទាំងអស់ គ្នា » ។
បើ តាម លោក ឃួង ស្រេង . ក្នុង កិច្ចប្រជុំ ពិភាក្សា នេះ អភិបាល រាជធានី - រដ្ឋធានី អាស៊ាន បាន សម្រេច នូវ ការពិភាក្សា ផ្លាស់ប្ដូរ យោបល់ និង អនុសាសន៍ ដ៏ គាប់ ប្រសើរ ប្រកបដោយ ផ្លែផ្កា ហើយ អាច និយាយ បាន ថា កិច្ចប្រជុំ នេះ បាន ក្លាយជា វេទិកា ដ៏ មាន ខ្លឹមសារ ដែល អនុញ្ញាតឲ្យ ភាគី ទាំងអស់ ចែករំលែក ចំណេះដឹង បទពិសោធន៍ និង ឧត្តមានុវត្តន៍ ជុំវិញ ការអភិវឌ្ឍ រាជធានី រដ្ឋធានី និង ទីក្រុង និង ជំរុញ កិច្ចសហប្រតិបត្តិការ កាន់តែ ជិតស្និទ្ធ រវាង ភាគី ពាក់ព័ន្ធ ដើម្បី កំណើន សេដ្ឋកិច្ច និង វិបុលភាព រួម របស់ អាស៊ាន ។
ជាក់ស្តែង ក្នុង កិច្ចប្រជុំ បាន អនុម័ត និង ចុះហត្ថលេខា រួមគ្នា លើ សេចក្តីប្រកាស ដែល មាន ខ្លឹមសារ ចំនួន ៦ ចំណុច ដោយ បាន ឆ្លុះបញ្ចាំង ឲ្យ ឃើញ កាន់តែ ច្បាស់ អំពី សារៈសំខាន់ នៃ កិច្ចសហប្រតិបត្តិការ នៃ បណ្ដា រាជធានី - រដ្ឋធានី ទាំង១០ នៃ ប្រទេស ជា សមាជិក អាស៊ាន ពោលគឺ មជ្ឈភាព រាជធានី - រដ្ឋធានី អាស៊ាន គឺជា កម្លាំង ចលករ ដ៏ ចម្បង ដើម្បី ឈានទៅ សម្រេចបាន កំណើន និង វិបុលភាព រួម នៃ ប្រទេស ក្នុង តំបន់ ។
អភិបាល រាជធានី ភ្នំពេញ បាន សង្កត់ធ្ងន់ ថា ទោះបី ស្ថិត ក្នុង ស្ថានភាព ណា ក៏ដោយ ប្រសិនបើ យើង រក្សា បាន ស្មារតី សាមគ្គីភាព ឯកភាព និង កិច្ចសហប្រតិបត្តិការ ល្អ នោះ យើង ក៏ អាច រួមគ្នា ដោះស្រាយ និង ទប់ស្កាត់ បញ្ហា ប្រឈម នានា សម្រាប់ គ្រួសារ រាជធានី - រដ្ឋធានី អាស៊ាន យើង ប្រកបដោយ ប្រសិទ្ធភាព និង ប្រសិទ្ធផល ខ្ពស់ ។
រាជធានី ភ្នំពេញ មាន ជំនឿ ជឿជាក់ យ៉ាង មុតមាំ ថា រដ្ឋធានីហ្សាការតា នៃ សាធារណៈ រដ្ឋ ឥណ្ឌូនេស៊ី ដែល ត្រូវ ទទួល តំណែង ជា ម្ចាស់ ផ្ទះ រៀបចំ « កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន ឆ្នាំ ២០២៣ » ខាងមុខ នេះ នឹង បន្ត ដឹកនាំ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ នៃ ប្រទេស ជា សមាជិក អាស៊ាន ដើម្បី សម្រេចបាន នូវ សមិទ្ធផល ថ្មី ៗ បន្ថែម ទៀត ដូច អ្វី ដែល យើង កំពុង ខិតខំ រួមគ្នា សម្រេចបាន ក្នុង ថ្ងៃ នេះ ។
សូម ជម្រាប ថា នៅ ថ្ងៃទី ០២ និង ទី០៣ ខែធ្នូ ឆ្នាំ ២០២២ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ត្រូវ ធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ អភិបាល រាជធានី - រដ្ឋធានី អាស៊ាន និង វេទិការកិច្ចប្រជុំ អភិបាល ក្រុង អាស៊ាន ។ កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន គឺជា វេទិកា មួយ សម្រាប់ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន ទាំង១០ ដើម្បី លើកឡើង និង ពិភាក្សា អំពី បញ្ហា ប្រឈម ក្នុង ទីក្រុង នា ពេល បច្ចុប្បន្ន និង ដែល អាច កើត មាន ឡើង ព្រមទាំង ចែករំលែក ការអនុវត្ត ល្អ ៗ ក៏ ដូចជា ទស្សនៈ ល្អ ៗ សម្រាប់ ការកសាង សហគមន៍ អាស៊ាន ៕
អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន ពិភាក្សា ជា ក្រុម ផ្តោត លើ ការបន្ស៉ី រវាង ផែនការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព នៅក្នុង ទីក្រុង និង រដ្ឋបាល មូលដ្ឋាន អាស៊ាន
( ភ្នំពេញ ) ៖ ការអនុវត្ត គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព នៅ កម្រិត មូលដ្ឋាន ជា ប្រធានបទ សំខាន់ ក្នុង កិច្ចពិភាក្សា នៃ វេទិកា អភិបាល ក្រុង អាស៊ាន AMF និង កិច្ចប្រជុំ អភិបាល រាជធានី និង រដ្ឋធានី អាស៊ាន MGMAC ឆ្នាំ ២០២២ ដើម្បី ស្វែងយល់ ពី កិច្ចសហប្រតិបត្តិការ និង ការអនុវត្ត គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ដែល បន្ស៉ី គ្នា រវាង ផែនការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ក្នុង ទីក្រុង នៅ កម្រិត នីមួយ ៗ និង កម្រិត តំបន់ ក៏ ដូចជា នៅ រដ្ឋបាល មូលដ្ឋាន អាស៊ាន ។
ជា កិច្ច ចាប់ផ្តើម នៃ កិច្ចពិភាក្សា នេះ លោក ឡុង ឌីម៉ង់ បាន លើកឡើង អំពី សក្តានុពល ដែល ខេត្ត ព្រះសីហនុ មាន ស្រាប់ ហើយ ខេត្ត ព្រះសីហនុ គឺជា ខេត្ត មួយ ដែល មាន ការយកចិត្តទុកដាក់ ច្រើន ដូច បណ្តា រាជធានី ខេត្ត ដទៃ ទៀត ពីសំណាក់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
លោក បន្ត ថា ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន ពង្រីក មុខមាត់ ខ្លួន ឯង ឲ្យ កាន់តែ ទំនើប កាន់តែ ឆ្លាតវៃ តាមរយៈ ការដាក់ចេញ នូវ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ ថ្នាក់ ក្រោម ជាតិ ឥត ឈប់ឈរ លើ គ្រប់ វិស័យ ជាពិសេស វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ និង ការផ្តល់ ឱកាស លើ វិនិយោគិន បរទេស មក បណ្តាក់ទុន ដើម្បី ស្តារ សេដ្ឋកិច្ច ឡើងវិញ ក្រោយ វិបត្តិ ជំងឺ កូវីដ១៩ ដែល បាន ពន្យា ពេល នៃ វឌ្ឍនភាព របស់ ខ្លួន ដើម្បី សម្រេច SDGs ឬ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ។
លោក បាន ឲ្យដឹង ថា កិច្ចពិភាក្សា មាន ការផ្លាស់ប្តូរ បទពិសោធន៍ គ្នា ទៅ វិញ ទៅ មក លើក ការបន្ស៉ី គ្នាង រវាង ផែនការ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ ទីក្រុង នីមួយ ៗ រួមទាំង បញ្ហា ប្រឈម ដែល បាន កើតឡើង ហើយ ធ្វើ ការប្រៀបធៀប ទៅនឹង អ្វី ដែល បាន ដាក់ចេញ ដោយ អង្គការ សហ ប្រជាជាតិ ដែល ឆ្លើយតប ទៅនឹង កម្រិត ណាមួយ ដើម្បី ដោះស្រាយ ឆ្ពោះ ទៅ ការសម្រេច គោលដៅ អភិវឌ្ឍន៍ ទីក្រុង ប្រកបដោយ ចីរភាព ។
បើ តាម លោក ឡុង ឌីម៉ង់ ការអនុវត្ត ផែនការអភិវឌ្ឍ ប្រប ដោយ ចីរភាព របស់ អង្គការ សហ ប្រជាជាតិ នេះ មាន សារៈសំខាន់ ណាស់ ដើម្បី ធ្វើ យ៉ាងណា ឆ្លើយតប ឲ្យ ចំ គោលដៅ ដែល បម្រើ ផលប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ជាក់ស្តែង ។ ចំពោះ មតិ យោបល់ និង បទពិសោធន៍ ដែល បាន លើកឡើង នៅក្នុង កិច្ចពិភាក្សា នេះ និង ត្រូវ យក ទៅ បញ្ជូល ក្នុង សេចក្តីថ្លែងការរួម នៅក្នុង វេទិកា អភិបាល ក្រុង អាស៊ាន និង កិច្ចប្រជុំ អភិបាល រាជធានី - រដ្ឋធានី អាស៊ាន ២០២២ នៅ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ ។
សូម បញ្ជាក់ ថា វេទិកា AMF និង កិច្ចប្រជុំ MGMAC ឆ្នាំ ២០២២ នេះ បាន រៀបចំ ឲ្យ មាន ក្រុម ពិភាក្សា ចំនួន ៥ក្រុម ដែល កិច្ចពិភាក្សា ទី ១៖ ផ្តោត លើ ការធ្វើ ហិរញ្ញប្បទាន គម្រោង ដែល មាន ចីរភាព ដើម្បី ការអភិវឌ្ឍ ទីក្រុង . កិច្ចពិភាក្សា ទី២៖ ការអនុវត្ត គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព នៅ កម្រិត មូលដ្ឋាន . កិច្ចពិភាក្សា ទី៣៖ អភិបាលកិច្ច ឌីជីថល . ទី ៤៖នគរូបនីយកម្ម អាស៊ាន ប្រកបដោយ ចីរភាព និង ទី៥៖ ភាពធន់ និង អាកាសធាតុ ក្នុង ទីក្រុង និង ការកាត់បន្ថយ ហានិភ័យ គ្រោះមហន្តរាយ នៅក្នុង តំបន់ អាស៊ាន ៕
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០២២ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៥. ២២៩. ២៤១ នាក់ ។ ក្នុង នោះ រួម មាន៖
កម្ពុជា - ស្លូវ៉ាគី បើក កិច្ចប្រជុំ ពិគ្រោះយោបល់ ទ្វេ ភាគី លើក ទី២
ចំពោះ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ភាគី ទាំង ពីរ បាន ប្តេជ្ញាចិត្ត ជំរុញ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ប្រកបដោយ សក្តានុពល តាមរយៈ ការផ្លាស់ប្តូរ គណៈប្រតិភូ ធុរកិច្ច រួមទាំង សភា ពាណិជ្ជកម្ម នៃ ប្រទេស ទាំង ពីរ និង បន្ត ពង្រីក ការគាំទ្រ គ្នា ទៅ វិញ ទៅ មក នៅក្នុង ក្របខណ្ឌ អង្គការ អន្តរជាតិ ។
រដ្ឋលេខាធិការ ទាំង ពីរ ក៏ បាន ផ្លាស់ប្តូរ ទស្សនៈ គ្នា លើ បញ្ហា តំបន់ និង អន្តរជាតិ ដែល ជា ផលប្រយោជន៍ និង កង្វល់ រួម ។ ភាគី ទាំង ពីរ បាន ជជែកគ្នា យ៉ាង ស៊ីជម្រៅ លើ សង្គ្រាម នៅ អ៊ុយក្រែន និង វិបត្តិ នៅ មីយ៉ាន់ម៉ា ។ លោកស្រី អ៊ីន ហ្គ្រីត ប្រូក ខូវ៉ា បាន លើកឡើង ថា បច្ចុប្បន្ន ស្លូវ៉ាគី កំពុង ប្រឈមមុខ នឹង បញ្ហា ប្រឈម នៃ ការផ្គត់ផ្គង់ ប្រេង និង ឧស្ម័ន និង លំហូរ ជនភៀសខ្លួន ជា បន្តបន្ទាប់ ។ លោកស្រី បាន សម្តែង នូវ ការថ្លែងអំណរគុណ យ៉ាង ស្មោះស្ម័គ្រ ចំពោះ ជំហរ ដ៏ រឹងមាំ របស់ កម្ពុជា នៅ អង្គការ សហ ប្រជាជាតិ ។
ក្រៅពី នេះ រដ្ឋលេខាធិការ ទាំង ពីរ ក៏ បាន យល់ស្រប គ្នា ថា ការប្រកួតប្រជែង អំណាច បាន បញ្ចេញ ឥទ្ធិពល អវិជ្ជមាន មក លើ ប្រទេស តូច ៗ ដូចជា កម្ពុជា និង ស្លូវ៉ាគី ។ ក្នុង ន័យ នេះ ភាគី ទាំង ពីរ ជឿជាក់ ថា វា ចំបាច់ ណាស់ ក្នុង ការគោរព ច្បាប់ អន្តរជាតិ និង ពហុ ភាគី និយម ក្រោម ឆ័ត្រ របស់ ស្ថាប័ន អន្តរជាតិ ដូចជា អង្គការ សហ ប្រជាជាតិ អាស៊ាន និង សហភាព អឺរ៉ុប ។
ភាគី ទាំង ពីរ បាន ឯកភាព គ្នា ថា កិច្ចពិគ្រោះយោបល់ ទ្វេ ភាគី លើក ទី៣ នឹង ធ្វើឡើង នៅ រាជធានី ភ្នំពេញ ៕
ខាងក្រោម នេះ ជា របាយការណ៍ នៃ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ប្រទេស អាស៊ាន គិត ត្រឹម ព្រឹក ថ្ងៃទី ០២ ខែ ឆ្នូ ឆ្នាំ ២០២២៖
គួរ បញ្ជាក់ ថា បើ តាម អង្គការ WHO ក្នុង ពេល បច្ចុប្បន្ន ប្រហែលជា ៩០ ភាគរយ នៃ ប្រជាជន ពិភពលោក មាន ភាពសុំា ទៅនឹង កូវីដ១៩ នៅ កម្រិត ខ្លះ ទាំង ដោយសារតែ ការចាក់ វ៉ាក់សាំង បង្ការ និង ធ្លាប់ បាន ឆ្លង ជំងឺ នេះ ៕
លោក ស ថេត ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ដល់ ពលរដ្ឋ ទីទ័ល ក្រ ១៣ គ្រួសារ នៅ សង្កាត់ បឹង ទំពុន ១
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២២ លោក ស ថេត ប្រធាន ក្រុមការងារ ចុះ ជួយ គណបក្ស ប្រជាជន កម្ពុជា សង្កាត់ បឹង ទំពុន១ ខណ្ឌ មានជ័យ បាន អញ្ជេីញ ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ដល់ ប្រជាពលរដ្ឋ ទីទ័ល ក្រ ចាស់ជរា គ្មាន ទីពឹង ជន ពិការ ដែល កំពុង មាន ការខ្វះខាត ផ្នែក ជីវភាព ខ្លាំង ចំនួន ១៣គ្រួសារ ដែល រស់ នៅ សង្កាត់ បឹង ទំពុន១ ។
សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ គឺជា ក្តីកង្វល់ របស់ លោក ស ថេត ដោយ លោក តែងតែ ឆ្លៀត ពេល ដេីម្បី ចុះ សួរសុខទុក្ខ និង ផ្តល់ អំណោយ ជា ប្រចាំ ដល់ ពលរដ្ឋ ទី ទាល់ ក្រ ខ្លាំង ។
ក្រៅពី នោះ លោក ស ថេត ក៏ បាន ឆ្លៀត ពេល ជួប សំណេះសំណាល និង ផ្តល់ មតិ ណែនាំ ល្អ ៗ ដល់ ប្រធាន គណបក្ស សង្កាត់ សមាជិក ក្រុមប្រឹក្សា សង្កាត់ របស់ គណបក្ស ប្រជាជន នៅ ទីស្នាក់ការសង្កាត់ បឹង ទំពុន១ ។
( សៀមរាប ) ៖ ក្រោយពី កម្ពុជា បើក ប្រទេស ទទួល ទេសចរ អន្តរជាតិ ឡើងវិញ ពិសេស នៅ រយៈពេល ១០ខែ ឆ្នាំ ២០២២ ខេត្ត សៀមរាប ចាប់ផ្ដើម មាន កំណើន ភ្ញៀវ ទេសចរ អន្តរជាតិ ច្រើន ឡើងវិញ រួម ជាមួយ ការហោះហើរ ពី បរទេស ចូលក្នុង ខេត្ត នេះ មាន ចាប់ពី ១៦ - ១៦ជើង ក្នុង ១ ថ្ងៃ ដែល បាន ដឹកជញ្ជូន ភ្ញៀវ ទេសចរ មក ជាមួយ ចាប់ពី ១. ៣០០ នាក់ ទៅ១. ៤០០ នាក់ ក្នុង ១ ថ្ងៃ ។
លោក ប្រធាន មន្ទីរ ទេសចរណ៍ បាន បន្ត ថា ចំពោះ ការធ្វើដំណើ តាម ផ្លូវគោក ចូលមក ខេត្ត សៀមរាប មាន ប្រមាណ ៦០០ - ៧០០ នាក់ ក្នុង មួយ ថ្ងៃ ។
