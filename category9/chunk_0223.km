( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ថ្លែង ថា រដ្ឋបាល ខេត្ត បាន ទាក់ទាញ អ្នក វិនិយោគ ធំ តូច និង បាន សាងសង់ រោងចក្រ មាន ចំនួន ២៤ មូលដ្ឋាន អាច ស្រូបយក កម្លាំង ពលកម្ម កម្មករ កម្មការ នី សរុប ៣៦. ០៤៧ នាក់ ដែល ជា ចំណែក មួយ ចូលរួម ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ ។
លោក អភិបាល ខេត្ត បាន លើកឡើង ដូច្នេះ នៅ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្នុង កិច្ចប្រជុំ ប្រកាស ផ្សព្វផ្សាយ លទ្ធផល បឋម ផលិតផល ក្នុង ស្រុក សរុប GDP និង សន្ទស្សន៍ ថ្លៃ ទំនិញ ប្រើប្រាស់ CPI ខេត្ត កំពង់ចាម នៅ មន្ទីរ ផែនការ ខេត្ត ។
លោក បាន បញ្ជាក់ ថា ក្នុង រយៈពេល ប្រមាណ ពីរ ទស្សវត្ស កន្លងមក នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ខិតខំ អភិវឌ្ឍ ប្រទេស ឲ្យ មាន ការរីកចម្រើន ជាលំដាប់ ។ ជាក់ស្ដែង ខេត្ត កំពង់ចាម មាន ហេដ្ឋារចនាសម្ព័ន្ធ រូវ័ន្ត មាន ការរីកចម្រើន ដូចជា ផ្លូវ ស្ពាន សាលារៀន មន្ទីរពេទ្យ សួនច្បារ សាធារណៈ វត្ត អារាម និង វិស័យ ឯកជន ជាពិសេស រង្វង់ មូល វិមាន ឯករាជ្យ ដែល ជា តំបន់ ទេសចរ ដ៏ សំខាន់ សម្រាប់ ហាត់ប្រាណ និង ធ្វើដំណើកម្សាន្ត ទាំង ភ្ញៀវ ជាតិ និង អន្តរជាតិ ។
លោក អ៊ុន ចាន់ ដា បាន បញ្ជាក់ ទៀត ថា រដ្ឋបាល ខេត្ត កំពង់ចាម បាន ទាក់ទាញ អ្នក វិនិយោគ ធំ តូច បាន សាងសង់ រោងចក្រ មាន ចំនួន ២៤ មូលដ្ឋាន ស្ថិត ក្នុង ស្រុក បាធាយ ស្រុក ជើង ព្រៃ ស្រុក ព្រៃឈរ ស្រុក កំពង់សៀម និង ស្រុក ស្ទឹងត្រង់ អាច ស្រូបយក កម្លាំង ពលកម្ម កម្មករ កម្មការ នី សរុប ៣៦. ០៤៧ នាក់ ដែល ជា ចំណែក មួយ ចូលរួម ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ចូលរួម ក្នុង កំណើន សេដ្ឋកិច្ច របស់ ខេត្ត ផងដែរ ។
លទ្ធផល គណនេយ្យ ជាតិ សម្រាប់ ថ្នាក់ ខេត្ត គឺជា ឯកសារ គន្លឹះ ដែល ជា មូលដ្ឋាន សម្រាប់ អនុវត្ត សកម្មភាព អាទិភាព សំខាន់ ៗ ស្រប តាម គោល នយោបាយ ដែល មាន សន្តិភាព ជាមួយនឹង គោលដៅ អភិវឌ្ឍន៍ របស់ រដ្ឋបាល ខេត្ត និង ជាពិសេស ជាង នេះ ទៅ ទៀត គឺ ដើម្បី ចូលរួម សម្រេចបាន នូវ យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ៕
លោក សាយ សំអាល់ ដឹកនាំ កិច្ចប្រជុំ ពិភាក្សា ការគ្រប់គ្រង ប្រើប្រាស់ ដីធ្លី ក្នុង តំបន់ ការពារ ធម្មជាតិ និង របៀង ជីវៈ ចម្រុះ ភូមិសាស្ត្រ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ លោក សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន បាន គូសបញ្ជាក់ ថា ការកំណត់ ទស្សនវិស័យ ច្បាស់លាស់ ដើម្បី អភិវឌ្ឍន៍ ភូមិសាស្ត្រ ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ គឺជា កត្តា ចាំបាច់ ប្រកបដោយ ប្រសិទ្ធភាព ។
នាកាស នោះ លោក រដ្ឋមន្ត្រី សាយ សំអាល់ បាន អបអរសាទរ ចំពោះ លោក ខូយ រីដា ដែល ត្រូវបាន ប្រមុខ រាជ រដ្ឋាភិបាល ផ្តល់ សេចក្តីទុកចិត្ត តែងតាំង ជា អភិបាល ខេត្ត ពោធិ៍សាត់ ក៏ ដូចជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ។ ដោយឡែក ក្រសួង បរិស្ថាន បាន ត្រៀមលក្ខណៈ ជានិច្ច ដើម្បី សហការ ធ្វើការ ជាមួយ ថ្នាក់ ខេត្ត ស្រុក ឃុំ ទាំងអស់ ទាក់ទិន នឹង វិស័យ បរិស្ថាន ។
ជាង នេះ ទៅ ទៀត ក្រៅពី វិស័យ បរិស្ថាន មន្ទីរ បរិស្ថាន ដែល ជា សេនាធិការ ក៏ ដូចជា មន្ត្រី ឧទ្យានុរក្ស បាន ត្រៀម ជាមួយ ខេត្ត ក៏ ដូចជា អាជ្ញាធរ ពាក់ព័ន្ធ ចូលរួម សហការធ្វើ ការងារ ផ្សេង ៗ គ្រប់ កាលៈទេសៈ ដូច ជា៖ ការងារ គ្រោះមហន្តរាយ ការទប់ស្កាត់ ការរីករាតត្បាត នៃ ជំងឺ កូវីដ១៩ ជាដើម ។
លោក សាយ សំអាល់ បាន ឱ្យដឹង ថា កិច្ចប្រជុំ នៅ សាលា ស្រុក វាលវែង នៅ ថ្ងៃ នេះ គឺ ដើម្បី ពិនិត្យមើល របៀបវារៈ ទី៣ ទាក់ទិន ទៅនឹង វិស័យ បរិស្ថាន ជាពិសេស យក ឱកាស នេះ ដើម្បី ផ្សព្វផ្សាយ ការងារ ឱ្យ បាន ជ្រួតជ្រាប ដល់ មូលដ្ឋាន ក៏ ដូចជា មន្ត្រី ដែល កំពុង អនុវត្ត ការងារ នៅ មូលដ្ឋាន តែម្តង ។ លោក បាន លើកឡើង នូវ ទិដ្ឋភាព រួម ដើម្បី ជា ធាតុ ចូល ក៏ ដូចជា មូលដ្ឋាន ទាក់ទិន នឹង ការងារ វិស័យ បរិស្ថាន និង ការងារ អភិវឌ្ឍន៍ ក្នុង មូលដ្ឋាន ។
បន្ថែម ពី នេះ លោក សាយ សំអាល់ បាន ឱ្យដឹង ថា ការកំណត់ នូវ ទស្សនវិស័យ ច្បាស់លាស់ ដើម្បី អភិវឌ្ឍន៍ ភូមិសាស្ត្រ ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ គឺជា កត្តា ចាំបាច់ ប្រកបដោយ ប្រសិទ្ធភាព ។
ថ្លែង ក្នុង ពិធី បិទ មហាសន្និបាត នា ព្រឹក ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ នា សណ្ឋាគារ សុខា ភ្នំពេញ សម្តេច ពញា ចក្រី ហេង សំរិន បាន បញ្ជាក់ ថា លទ្ធផល សំខាន់ ៗ រួម មាន៖
សម្តេច ពញា ចក្រី ហេង សំរិន បាន បន្ត ថា នេះ ជា ភាពជោគជ័យ នៃ មហាសន្និបាត អាយប៉ា លើក ទី ៤៣ ដែល សភា កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៅក្នុង ការពង្រឹង យន្តការសភា ក្នុង ការចូលរួមចំណែក ដល់ ការអភិវឌ្ឍ លើកកម្ពស់ ជីវភាព ប្រជាពលរដ្ឋ ប្រកបដោយ ចីរភាព និង ដោះស្រាយ បញ្ហា នានា ជូន ប្រជាពលរដ្ឋ ទាំង នៅក្នុង តំបន់ និង សកលលោក ខណៈ អាយ ប៉ា ដែល ជា ស្ថាប័ន នីតិប្បញ្ញត្តិ នៃ បណ្តា ប្រទេស សមាជិក អាស៊ាន តំណាង ឱ្យ ប្រជាពលរដ្ឋ នៃ តំបន់ អាស៊ី អាគ្នេយ៍ ៦៥០ លាន នាក់ ។
ជាមួយគ្នា នេះ ដែរ សម្តេច ប្រធាន អាយ ប៉ា លើក ទី ៤៣ មាន ក្តីសង្ឃឹម ថា មហា គ្រួសារ អាយប៉ា ទាំងអស់ គ្នា នឹង ខិតខំ ឱ្យ អស់ ពី សមត្ថភាព ដើម្បី បម្រើ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ក្នុង តំបន់ និង សកលលោក ។
ពិធី បិទ មហាសន្និបាត លើក ទី ៤៣ ប្រកបដោយ អត្ថន័យ បង្ហាញ ពី សាមគ្គីភាព និង ភាពស្និទ្ធស្នាល បំផុត ។ ឥណ្ឌូនេស៊ី ដែល ជា សហ ស្ថាបនិក អាស៊ាន បាន ក្លាយទៅជា ប្រធាន អន្តរសភា អាស៊ាន - អាយ ប៉ា ប្តូរ វេន ជាថ្មី បន្ត ពី ប្រទេស កម្ពុជា នៅ ឆ្នាំ ២០២៣ ខាងមុខ នេះ ៕
ធនាគារ ជាតិ នៃ កម្ពុជា រៀបចំ សន្និសីទ ម៉ាក្រូ សេដ្ឋកិច្ច លើក ទី៩ ស្វែងរក វិធីសាស្រ្ដ បន្ថែម ក្នុង ការស្ដារ សេដ្ឋកិច្ច កម្ពុជា ឡើងវិញ ក្រោយ វិបត្តិ កូវីដ១៩
ប្រធានបទ នេះ នឹង បន្ដ ពិភាក្សា ដើម្បី ស្វែងរក វិធីសាស្រ្ដ ដ៏ ល្អ បំផុត ក្នុង ការស្ដារ សេដ្ឋកិច្ច កម្ពុជា ឡើងវិញ ក្រោយ វិបត្តិ កូវីដ១៩ ។
លោកស្រី ជា សិរី បាន ឲ្យដឹង ថា សន្និសីទ ម៉ាក្រូ សេដ្ឋកិច្ច រៀបចំឡើង ក្នុង គោលបំណង ពង្រឹង និង កសាង វប្បធម៌ នៃ ការស្រាវជ្រាវ នៅ កម្ពុជា និង ផ្តល់ ជា វេទិកា សម្រាប់ កិច្ចពិភាក្សា រវាង អ្នកស្រាវជ្រាវ អ្នករៀបចំ គោល នយោបាយ អ្នកជំនាញ និង ភាគី ពាក់ព័ន្ធ នានា លើ ប្រធានបទ សំខាន់ ៗ ទាក់ទង ទៅ នឹង ការអភិវឌ្ឍ សេដ្ឋកិច្ច កម្ពុជា ប្រកបដោយ ចីរភាព និង បរិយា បន្ន ។
លោកស្រី បន្ដ ថា បច្ចុប្បន្ន នេះ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា មាន កម្រិត តិចតួច បំផុត និង មិន មាន អ្វី គួរឱ្យ ព្រួយបារម្ភ ទៀត នោះ ទេ ដែល ការណ៍ នេះ បាន អនុញ្ញាតឱ្យ សកម្មភាព សេដ្ឋកិច្ច ក្នុង វិស័យ ចម្បង ៗ បន្ត ងើប ឡើងវិញ ជាលំដាប់ ។ ក្នុង ន័យ នេះ ផែនការ នៃ ការស្ដារ សេដ្ឋកិច្ច ឡើងវិញ និង គោល នយោបាយ ពាក់ព័ន្ធ គួរ ត្រូវបាន សិក្សា និង ពិភាក្សា ឱ្យ បាន ស៊ីជម្រៅ ។
លោកស្រី បញ្ជាក់ ថា ដើម្បី ប្រមូល ធាតុ ចូល សម្រាប់ ពិចារណា ក្នុង ការដាក់ចេញ គោល នយោបាយ ថ្មី ៗ បន្ថែម ទៀត នៅក្នុង បរិការណ៍ សេដ្ឋកិច្ច កម្ពុជា កំពុង បន្ត ងើបឡើង និង បន្ត សាប ព្រោះ វប្បធម៌ ស្រាវជ្រាវ ឱ្យ កាន់តែ ទូលំទូលាយ បន្ថែម ទៀត ធនាគារ ជាតិ នៃ កម្ពុជា បាន ជ្រើសរើស យក ប្រធានបទ ស្រាវជ្រាវ ស្តីពី « ដំណើរ ឆ្ពោះ ទៅកាន់ ការស្ដារ ឡើងវិញ និង ភាពធន់ ក្រោយ កូវីដ - ១៩ » សម្រាប់ ឆ្នាំ ២០២២ នេះ ។
ក្នុង នោះ ផងដែរ លោកស្រី ជា សិរី បាន ចូលរួម ចែករំលែក មតិ មួយចំនួន ជា ធាតុ ចូល បន្ថែម សម្រាប់ ការពិភាក្សា រួម មាន៖
១៖ ឌីជីថលូបនីយក ម្ម៖ កន្លងមក សង្កេតឃើញ ថា របៀបរបប រស់ នៅក្នុង សង្គម និង ការបម្រើ ការងារ នៅ តាម ស្ថាប័ន នានា មាន ការផ្លាស់ប្ដូរ យ៉ាង ខ្លាំង ដោយ បាន ប្ដូរ ទៅ រក ការប្រើប្រាស់ ប្រព័ន្ធ អនឡាញ កាន់តែ ច្រើន មិន ថា ក្នុង អាជីវកម្ម ការងារ ឬ ការអប់រំ ដែល នឹង នាំមក នូវ គុណ ប្រយោជន៍ ជាច្រើន ដល់ សេដ្ឋកិច្ច ជាតិ តាមរយៈ ការបង្កើន ផលិតភាព និង អាច រួមចំណែក កាត់បន្ថយ ថ្លៃ ដើម និង បញ្ហា អតិផរណា ដែល បាន និង កំពុង ជួបប្រទះ នា ពេល បច្ចុប្បន្ន ។
សូម គូសបញ្ជាក់ ថា ការធ្វើ ទំនើបកម្ម ប្រព័ន្ធ ធនាគារ នា រយៈពេល កន្លងមក នេះ ជាពិសេស ប្រព័ន្ធ ទូទាត់ បាន រួមចំណែក ដល់ ការទ្រទ្រង់ សកម្មភាព អាជីវកម្ម ខ្នាត តូច និង មធ្យម ក្នុង អំឡុង វិបត្តិ កូវីដ១៩ និង បាន ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ ដោយ បាន ជួយ កាត់បន្ថយ ការប៉ះពាល់ ផ្ទាល់ កាត់បន្ថយ ការធ្វើដំណើរ មិន ចាំបាច់ និង រក្សា គម្លាត សង្គម ជាដើម ស្រប ពេល ទំនើបកម្ម សេវា ហិរញ្ញវត្ថុ បាន លើកកម្ពស់ បរិយា បន្ន ហិរញ្ញវត្ថុ ឬ ការប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ផ្លូវការ តាម តំបន់ ជនបទ កាន់តែ ប្រសើរឡើង ។
លោកស្រី បន្ថែម ថា ជា ការពិត ឌីជីថលូបនីយកម្ម បាន ផ្ដល់ លទ្ធភាព ដល់ ប្រជាជន រស់ នៅ តាម តំបន់ ដាច់ស្រយាល អាច ទទួលបាន សេវាកម្ម ចាំបាច់ ផ្សេង ៗ រួមទាំង សេវា ហិរញ្ញវត្ថុ ដែល ពួកគាត់ អាចនឹង មិន ទទួលបាន ប្រសិនបើ គ្មាន ទំនើបកម្ម ផ្នែក បច្ចេកវិទ្យា នោះ ទេ ប៉ុន្តែ ឌីជីថលូបនីយកម្ម ក៏ ទាមទារ នូវ កត្តា ជា មូលដ្ឋាន មួយចំនួន ផងដែរ គឺ លទ្ធភាព ក្នុង ការប្រើប្រាស់ ឧបករណ៍ អេឡិចត្រូនិក និង សេវា អ៊ីនធឺណែត ដែល មាន តម្លៃ សមរម្យ បើ ពុំ នោះ សោត ឌីជីថលូបនីយកម្ម អាច បង្ក ការកើនឡើង នៃ វិសមភាពសង្គម ។
២៖ ការអភិវឌ្ឍ ជំនាញ និង ធនធាន មនុស្ស៖ ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ ឌីជីថល មាន តម្លៃ សមរម្យ មិន គ្រប់គ្រាន់ ទេ ក្នុង ការបង្កើន ការប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ប្រសិនបើ អក្ខរកម្ម ឌីជីថល ក្នុង ចំណោម ប្រជាជន មាន កម្រិត ទាប ។ លើស ពី នេះ អ្នក ដែល មាន ជំនាញ ឌីជីថល ទាប តែង ប្រឈម នឹង ហានិភ័យ ខ្ពស់ ដោយ ងាយ ត្រូវបាន គេ លួងលោម បោក បញ្ឆោត តាម ប្រព័ន្ធ អនឡាញ ដែល ធ្វើឱ្យ មាន ការខាតបង់ ។
ក្នុង ន័យ នេះ កម្ពុជា ត្រូវ ខិតខំ បន្ថែម ទៀត ដើម្បី បញ្ជ្រាប ចំណេះដឹង ឌីជីថល ដោយ ធានា ថា ប្រជាពលរដ្ឋ គ្រប់ រូប និង គ្រប់ វ័យ ត្រូវ ទទួលបាន ការអភិវឌ្ឍ ដោយ ស្មើភាព និង មិន មាន បុគ្គល ណាមួយ ត្រូវបាន បោះបង់ នៅក្នុង យុគសម័យ ឌីជីថល គួបផ្សំ នឹង ជំនាញ បច្ចេកទេស ផ្សេង ៗ ដល់ ប្រជាពលរដ្ឋ គ្រប់ វ័យ ដើម្បី សម្រេច ឱ្យ បាន ចក្ខុវិស័យ នៃ កាភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ឌីជីថល ប្រកបដោយ ផ្លែផ្កា ។
ហេតុ នេះ សេវាកម្ម មាន ស្រាប់ និង មិន បាន ប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ដែល កំពុង ត្រូវបាន ដាក់ ឱ្យ ប្រើប្រាស់ ដោយ សា្ថប័ន ឯកជន និង សាធារណៈ នា ពេល កន្លងមក គួរ ត្រូវបាន បន្ត ប្រើប្រាស់ ទន្ទឹម គ្នា នឹង សេវាកម្ម តាម បែប ឌីជីថល ដើម្បី ធានា ថា ប្រជាពលរដ្ឋ គ្រប់ រូប ជាពិសេស ប្រជាពលរដ្ឋ វ័យ ចំណាស់ នៅតែ មាន លទ្ធភាព ទទួលបាន សេវាកម្ម នានា ប្រកបដោយ ភាពងាយស្រួល ។
៣៖ ការគាំពារ សង្គ ម៖ វិបត្តិ កូវីដ - ១៩ បាន បង្ក ផល ប៉ះពាល់ ដល់ ប្រជាពលរដ្ឋ ក្នុង ទំហំ មិន ដូចគ្នា នោះ ទេ ដោយ ប្រជាពលរដ្ឋ ក្រីក្រ និង ងាយ រងគ្រោះ ទទួលរង ការប៉ះទង្គិច ខ្លាំង ជាង ដូចគ្នា នេះ បញ្ហា កំណើន អតិផរណា នា ពេល បច្ចុប្បន្ន បាន ប៉ះពាល់ ដល់ ប្រជាជន ក្រីក្រ ខ្លាំង ជាង គេ ផងដែរ ។
នៅ កម្ពុជា ក្រុម ម្ហូប អាហារ និង ថាមពល មាន សមាមាត ប្រមាណ ៦០ % នៃ សន្ទស្សន៍ ថ្លៃ ទំនិញ ប្រើប្រាស់ សរុប ដូចនេះ ការឡើង ថ្លៃ នៃ ក្រុម ម្ហូប អាហារ និង ថាមពល បណ្តាល ឱ្យ ក្រុមគ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ដែល មាន ប្រាក់ សន្សំ ទាប ឬ គ្មាន ប្រាក់ សន្សំ ទាល់តែសោះ ជួប ការលំបាក ក្នុង ការរក្សា អំណាច នៃ ការទិញ ទំនិញ ប្រើប្រាស់ ចាំបាច់ ផ្សេង ៗ ប្រចាំ ថ្ងៃ ។
ហេតុ ដូច្នេះ ការពង្រីក ការគាំពារ សង្គម ពិតជា មាន សារៈសំខាន់ ណាស់ សម្រាប់ ក្រុមគ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ស្រប ពេល ដែល ការជំរុញ ក្រុមហ៊ុន សហគ្រាស និង និយោជិត ដែល ស្ថិត នៅក្នុង សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ មក ក្នុង សេដ្ឋកិច្ច ក្នុង ប្រព័ន្ធ មាន ភាពចាំបាច់ ដើម្បី អាច ទទួលបាន ការគាំពារ កាន់តែ ប្រសើរ ជាង មុន ។
កន្លងមក ធនាគារ ជាតិ នៃ កម្ពុជា ក៏ បាន ខិតខំ សម្រាល បន្ទុក ប្រជាពលរដ្ឋ ក្រីក្រ តាមរយៈ ការរក្សា ស្ថិរភាព អត្រា ប្ដូរ ប្រាក់ ដែល បាន រួមចំណែក កាត់បន្ថយ សម្ពាធ អតិផរណា ហើយ ថ្មី ៗ នេះ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ក៏ ត្រូវបាន លើកទឹកចិត្ត ឱ្យ មាន ការរៀបចំ ឥណទាន ឡើងវិញ សម្រាប់ អ្នក ដែល ទទួលរង ផល ប៉ះពាល់ ពី គ្រោះ ទឹក ជំនន់ ។
ក្រៅពី ចំណុច ទាំង៣ ខាងលើ នេះ ការអភិវឌ្ឍ សហគ្រាស ធុន តូច និង មធ្យម ដែល ត្រូវបាន ចាត់ទុក ជា ឆ្អឹង ខ្នង នៃ ការអភិវឌ្ឍ សេដ្ឋកិច្ច កម្ពុជា តាមរយៈ ការរួមចំណែក បង្កើត ការងារ ប្រមាណ ៧០ % នៃ ការងារ សរុប ជូន ប្រជាពលរដ្ឋ កម្ពុជា និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច ឱ្យ មាន លក្ខណៈ បៃតង ដែល បច្ចុប្បន្ន ជា ប្រធានបទ កំពុង ទទួលបាន ការជជែក វែកញែក ជា សកល ក៏ គួរ ត្រូវបាន លើក យកមក ពិភាក្សា ផងដែរ ដោយសារ ប្រទេស កម្ពុជា ជា ប្រទេស កសិកម្ម ដែល ងាយ រងគ្រោះ ខ្លាំង ពី ហានិភ័យ អាកាសធាតុ ៕
( ភ្នំពេញ )៖ គណៈកម្មាធិការ សមាជិក សភា ស្ត្រី អាយប៉ា . គណៈកម្មាធិការ សមាជិក សភា វ័យ ក្មេង អាយប៉ា . គណៈកម្មាធិការ នយោបាយ អាយប៉ា . គណៈកម្មាធិការ សេដ្ឋកិច្ច អាយប៉ា . គណៈកម្មាធិការ សង្គមកិច្ច អាយ ប៉ា និង គណៈកម្មាធិការ រៀបចំ អាយ ប៉ា នៃ មហាសន្និបាត អន្តរសភា អាស៊ាន - អាយ ប៉ា (AIPA) លើក ទី ៤៣ បាន រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី លទ្ធផល នៃ មហាសន្និបាត រយៈពេល ៥ ថ្ងៃ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ។
មហាសន្និបាត អន្តរសភា អាស៊ាន - អាយ ប៉ា បាន ធ្វើឡើង ក្រោម មូល បទ « បោះជំហាន ជាមួយគ្នា ដើម្បី ចីរភាព បរិយា បន្ន និង ភាពធន់ របស់ អាស៊ាន » ដែល សភា កម្ពុជា ទទួល ធ្វើជា ម្ចាស់ ផ្ទះ ចាប់ពី ថ្ងៃទី ២០ ដល់ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ បាន បិទ បញ្ចប់ ដោយ ជោគជ័យ ជាមួយនឹង លទ្ធផល ដ៏ ត្រចេះ ត្រចង់ ។
ក្នុង នាម សភា កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៃ មហាសន្និបាត អន្តរសភា អាស៊ាន លើក ទី ៤៣ បាន អនុម័ត លើ របាយការណ៍ នៃ គណៈកម្មាធិការ ជំនាញ របស់ អាយ ប៉ា ចំនួន ៦ និង បាន ប្រគល់ ទង់ កិត្តិយស ជា សភា សង្កេតការណ៍ ដល់ សភា នៃ ប្រទេសជា ដៃគូ ចំនួន ៣ គឺ សភា នេប៉ាល់ សភា អាស៊ែ បៃហ្សង់ និង សភា សហរដ្ឋ អាមេរិក ដែល បាន ក្លាយជា សភា សង្កេតការណ៍ របស់ អាយ ប៉ា ចាប់តាំងពី មហាសន្និបាត អន្តរសភា អាស៊ាន (AIPA) លើក ទី ៤៣ នេះ តទៅ ។
នៅក្នុង សម័យ ប្រជុំ នា ពេលនេះ មាន ការធ្វើ បទបង្ហាញ ពី របាយការណ៍ កិច្ចប្រជុំ ដោយ គណៈកម្មាធិការ សមាជិក សភា ស្ត្រី អាយប៉ា គណៈកម្មាធិការ សមាជិក សភា វ័យ ក្មេង អាយប៉ា គណៈកម្មាធិការ នយោបាយ អាយប៉ា គណៈកម្មាធិការ សេដ្ឋកិច្ច អាយ ប៉ា គណៈកម្មាធិការ សង្គមកិច្ច អាយ ប៉ា និង គណៈកម្មាធិការ រៀបចំ អាយ ប៉ា ដោយ សម័យ ប្រជុំ ពេញ អង្គ លើក ទី២នេះ បាន ធ្វើ ការអនុម័ត លើ របាយការណ៍ របស់ គណៈកម្មាធិការ ជំនាញ ទាំង៦នេះ ផងដែរ ៕
ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា៖ សាលា ជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ ជា សាលា រដ្ឋ ជំនាញ ទេសចរណ៍ ដំបូង គេ និង ជា មជ្ឈមណ្ឌល ឧត្តមភាព ដោយ ប្រើ ស្តង់ដា ជាតិ និង អន្តរជាតិ
លើកឡើង នា ឱកាស តំណាង ដ៏ ខ្ពង់ខ្ពស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ក្នុង ពិធី បើក ការដ្ឋាន សាងសង់ សាលា ជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ នៅ រាជធានី ភ្នំពេញ និង ខេត្ត ព្រះសីហនុ នា ព្រឹក ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា បាន អះអាង ថា សាលា នេះ ក៏ នឹង ក្លាយ មជ្ឈមណ្ឌល បណ្តុះបណ្តាល វិជ្ជាជីវៈ ទេសចរណ៍ និង បដិសណ្ឋារកិច្ច ប្រកបដោយ គុណភាព កម្រិត ខ្ពស់ ឆ្លើយតប នឹង តម្រូវការ នៃ ការបណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ ក្រោយ វិបត្តិ ជំងឺ កូវីដ - ១៩ ។
ពិធី បើក ការដ្ឋាន សាងសង់ សាលា ជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ បាន ធ្វើឡើង នៅ ទីតាំង ជិត ផ្សារទំនើប អ៉ី អន ២ រាជធានី ភ្នំពេញ និង ដោយ មាន ការចូលរួម ពី លោក ហ្សាក់ ប៉ឺ ឡេ ឯក អគ្គ រដ្ឋទូត បារាំង ប្រចាំ កម្ពុជា លោក បណ្ឌិត ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ លោកស្រី សង់ឌ្រីន ប៊ូស្សេ នាយិកា នៃ ទីភ្នាក់ងារ បារាំង សម្រាប់ ការអភិវឌ្ឍ (AFD) ប្រចាំ កម្ពុជា រួមទាំង មាន ភ្ញៀវ កិត្តិយស ជាតិ និង អន្តរជាតិ ជាច្រើន រូប ទៀត ផងដែរ ។
ជាមួយគ្នា នោះ លោក ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា ក៏ បាន បង្ហាញ ជំនឿ ជាក់ ថា សាលា ជាតិ ទាំង ពីរ ទីតាំង នេះ នឹង ក្លាយជា មជ្ឈមណ្ឌល បណ្តុះបណ្តាល ទេសចរណ៍ ស្រប តាម ស្តង់ដារ ជាតិ និង អន្តរជាតិ ដែល ជា តម្រូវការ និង វាយតម្លៃ ជំនាញ វិជ្ជាជីវៈ ចាំបាច់ សម្រាប់ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ កម្ពុជា ទាំង ក្នុង ពេល បច្ចុប្បន្ន និង ទៅ អនាគត ចូលរួម អនុវត្ត តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ដែល បាន កំណត់ យក ធនធាន មនុស្ស ជា អាទិភាព ទី១ សម្រាប់ ការអភិវឌ្ឍ ប្រទេសជាតិ ។
ជាមួយគ្នា នោះ ដែរ លោក ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា ក៏ បាន ស្នើ ឯក អគ្គ រដ្ឋទូត បារាំង និង ទីភ្នាក់ងារ បារាំង សម្រាប់ ការអភិវឌ្ឍ (AFD) ផ្តល់ កិច្ចសហការ និង សម្របសម្រួល ឱ្យ សាលា បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ បារាំង ធ្វើជា ដៃគូ ជាមួយ សាលា ជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ របស់ កម្ពុជា ដើម្បី បន្ត គាំទ សាលា ជាតិ ក្នុង ការបណ្តុះបណ្តាល និង ពង្រឹង សមត្ថភាព មន្រ្តី និង គ្រូបង្រៀន ផងដែរ ។
ក្នុង ឱកាស នោះ ដែរ លោក ហ្សាក់ ប៉ឺឡេ ក៏ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ជោគជ័យ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវិដ - ១៩ និង ការដាក់ចេញ និង អនុវត្ត បាន ប្រកបដោយ ប្រសិទ្ធភាព នូវ ផែនទី ចង្អុល ផ្លូវ សម្រាប់ ការស្តារ និង លើកស្ទួយ វិស័យ ទេសចរណ៍ កម្ពុជា ក្នុង និង ក្រោយ វិបត្តិ កូវិដ - ១៩ ទាន់ ពេល វេលា ។
លោក ក៏ បាន សំដែង សេចក្តី សោម ន្សរីករាយ និង សំដែង ការអបអរសាទរ ចំពោះ ការសាងសង់ សាលា ជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ ទាំង ពីរ ដែល និង ចូលរួមចំណែក ក្នុង ការពង្រឹង គុណភាព និង ភាពប្រកួតប្រជែង នៃ វិស័យ ទេសចរណ៍ កម្ពុជា ។
សំណង់ អគារ សាលា ជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ នៅ រាជធានី ភ្នំពេញ នេះ គ្រោង សាងសង់ កម្ពស់ ៤ជាន់ មាន ផ្ទៃក្រឡា សំណង់ សរុប ៧៣២៦ម៉ែត្រ ការ៉េ លើ ផ្ទៃដី ចំនួន ៤០០០ម៉ែត្រ ការ៉េ គ្រោង ចំណាយ ថវិកា ៣ ៤៥១ ៩៧២. ១១ដុល្លារ និង នៅ ខេត្ត ព្រះសីហនុ គ្រោង សាងសង់ កម្ពស់ ៤ជាន់ ដូចគ្នា មាន ផ្ទៃក្រឡា សំណង់ សរុប ៦៧១៣ម៉ែត្រ ការ៉េ លើ ទីតាំង មន្ទីរ ទេសចរណ៍ ខេត្ត បច្ចុប្បន្ន គ្រោង ចំណាយ ថវិកា ៣ ០៨៨ ១៨៣.១៧ ដុល្លារ ។
ស្ថាបត្យកម្ម សំណង់ អគារ សាលា ទាំង ពីរ ត្រូវបាន រចនា ឡើង យ៉ាង ល្អ ប្រសើរ ស្រប តាម លក្ខណៈ ស្តង់ដា និង ដោយ ផ្អែក តាម ប្លង់ ដែល បាន កំណត់ រួម មាន៖
ទីតាំង ទី ១៖ សាលា ជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ នៅ រាជធានី ភ្នំពេញ៖ សំណង់ មាន ០២ អាគារ ខាងមុខ មាន កំពស់ ២ជាន់ ខាងក្រោយ កំពស់ ៤ជាន់ ក្នុង នោះ រួម មាន បន្ទប់ រៀន បន្ទប់ ធ្វើ ការ បន្ទប់ សាស្ត្រាចារ្យ បន្ទប់ កុំព្យូទ័រ បន្ទប់ ប្រជុំ បន្ទប់ អនុវត្ត គំរូ សម្រាប់ សេវាកម្ម សណ្ឋាគារ សេវាកម្ម ម្ហូប អាហារ និង ភេសជ្ជៈ សេវាកម្ម ធ្វើដំណើរ និង ទេសចរណ៍ មាន បណ្ណាល័យ ភោជនីយដ្ឋាន និង បន្ទប់ សង្គ្រោះ បថម បន្ទប់ ដាក់ សម្ភារ ចំណត រថយន្ត ប្រព័ន្ធ ការពារ ហានិភ័យ និង លំហ បៃតង ជាដើម ។
ទីតាំង ទី ២៖ សាលា ជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ នៅ ខេត្ត ព្រះសីហនុ៖ សំណង់ អគារ មាន ចំនួន ០១ ផ្នែក ខាងមុខ មាន កម្ពស់ ១ជាន់ និង ខាងក្រោយ មាន ៤ជាន់ ក្នុង នោះ រួម មាន ការិយាល័យ មន្ទីរ ទេសចរណ៍ បន្ទប់ រៀន បន្ទប់ ធ្វើ ការ បន្ទប់ សាស្ត្រាចារ្យ បន្ទប់ កុំព្យូទ័រ បន្ទប់ ប្រជុំ បន្ទប់ អនុវត្ត គំរូ សម្រាប់ សេវាកម្ម សណ្ឋាគារ សេវាកម្ម ម្ហូប អាហារ និង ភេសជ្ជៈ សេវាកម្ម ធ្វើដំណើរ និង ទេសចរណ៍ មាន បណ្ណាល័យ ភោជនីយដ្ឋាន បន្ទប់ សង្គ្រោះ បថម បន្ទប់ ដាក់ សម្ភារ ចំណត រថយន្ត និង ប្រព័ន្ធ ការពារ ហានិភ័យ ជាដើម ។
លោក យូន បាន គូសបញ្ជាក់ ថា « ឧស្សាហកម្ម ការពារ ជាតិ នឹង រីកចម្រើន នា ពេល អនាគត ហើយ ជា ស្នូល នៃ ឧស្សាហកម្ម បច្ចេកវិទ្យា ខ្ពស់ ។ ជាមួយនិង ការប្រកួតប្រជែង កាន់តែ ខ្លាំង ឡើង នៃ ឧត្តមភាព ខាង បច្ចេកវិទ្យា យើង ត្រូវ ធានា ឲ្យបាន នូវ សមត្ថភាព ផ្នែក បច្ចេកវិទ្យា នេះ ដើម្បី អភិវឌ្ឍ ប្រព័ន្ធ អាវុធ ដ៏ មាន ឥទ្ធិពល សម្រាប់ ការធ្វើ សង្គ្រាម ដែល អាច កើតមាន នា ពេល អនាគត » ។
នៅក្នុង ការព្យាករ របស់ ខ្លួន សម្រាប់ ឆ្នាំ ២០២៣ ក្រសួង MTI បាន ឱ្យដឹង ថា អត្រា កំណើន ផលិតផល ក្នុង ស្រុក សរុប (GDP) នៅក្នុង ប្រទេស សេដ្ឋកិច្ច សំខាន់ ៗ ភាគ ច្រើន ត្រូវបាន រំពឹង ថា នឹង ថមថយ បន្ថែម ទៀត ពី អត្រា កំណើន ក្នុង ឆ្នាំ ២០២២ ជាមួយនឹង ការធ្លាក់ចុះ យ៉ាង ខ្លាំង ដែល ត្រូវបាន ព្យាករ ថា នឹង កើតមាន នៅ សហរដ្ឋ អាមេរិក និង តំបន់ អឺរ៉ូ ។
ការរំខាន ខាង ផ្នែក ផ្គត់ផ្គង់ សកល ទំនងជា នឹង បន្ត កើតមាន បន្ត ទៅ ឆ្នាំ ក្រោយ ដោយសារ សង្រ្គាម នៅ អ៊ុយក្រែន នៅតែ បន្ត បើ ទោះបីជា វិសាលភាព និង ភាពញឹកញាប់ នៃ ការរំខាន ត្រូវបាន រំពឹង ថា នឹង ថមថយក្តី ។
ក្រសួង ធម្មការ រៀបចំ សិក្ខាសាលា ស្ដីពី កិច្ចសន្ទនា អន្ដរ ជំនឿ សាសនា ដើម្បី សុខដុមនីយកម្ម សាសនា នៅ កម្ពុជា ឆ្នាំ ២០២២
( ភ្នំពេញ ) ៖ លោក ឈិត សុខុន រដ្ឋមន្រ្តី ក្រសួង ធម្មការ និង សាសនា នៅ ព្រឹក ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក អង្គ សិក្ខាសាលា ស្តីពី កិច្ចសន្ទនា អន្តរ ជំនឿ សាសនា ដើម្បី សុខដុមនីយកម្ម សាសនា នៅ កម្ពុជា ឆ្នាំ ២០២២ ក្រោម ប្រធានបទ « សាសនិក ចូលរួម ប្រឆាំង ការជូញ ដូរ មនុស្ស និង ទាសភាព សម័យ ទំនើប » ។
ក្នុង ឱកាស នោះ រដ្ឋមន្ដ្រី ក្រសួង ធម្មការ និង សាសនា បាន ជូន នូវ វិភាគទាន គន្លឹះ ចំនួន ៤ ដល់ អង្គ សិក្ខាសាលា ដូច ខាងក្រោម៖
* ទី១៖ សូមឲ្យ មេដឹកនាំ និង បរិស័ទ គ្រប់ សាសនា ទាំងអស់ គោរព ដឹងគុណ ដ៏ ជ្រាលជ្រៅ និង គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន ដឹកនាំ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន ប្រកបដោយ សុខ សន្តិភាព និង ជំរុញ ឲ្យ មាន សុខដុមនីយកម្ម សាសនា នៅ កម្ពុជា ។
* ទី២៖ សូមឲ្យ បន្ត ចូលរួម ថែរក្សា ការពារ សន្តិភាព ស្ថេរភាព និង អភិវឌ្ឍ ជាតិ លើ គ្រប់ វិស័យ ដែល កំពុង មាន ពេញ បរិបូរណ៍ ឲ្យ គង់វង្ស ។
* ទី៤៖ សូមឲ្យ ស្ថាប័ន ពាក់ព័ន្ធ និង មេដឹកនាំ សាសនា បន្ត អនុវត្ត មុខងារ តួនាទី ភារកិច្ច របស់ ខ្លួន ក្នុង ការអប់រំ ទូន្មាន និង ផ្សព្វផ្សាយ ឲ្យបាន ជ្រួតជ្រាប គ្រប់ មជ្ឈដ្ឋាន ជាពិសេស បរិស័ទ ជា យុវជន គម្បី ខិតខំ កែច្នៃ ចំណេះដឹង ជំនាញ ដែល ខ្លួន មាន ទៅជា ផលប្រយោជន៍ ដែល សុចរិត ប្រកបដោយ ភាពរីកចម្រើន ជា ទីស្រឡាញ់ រាប់អាន នៃ អ្នកផង ទាំងពួង និង មិន ធ្វើឲ្យ ខ្លួន ធ្លាក់ ក្នុង ក្តី វិនាស ដោយ អំពើ ឧក្រិដ្ឋ ដែល អូសទាញ ដោយ ជនល្មើស ៕
ការបង្ហាញ អំពី បំណង នេះ បាន ធ្វើឡើង ក្នុង ជំនួប ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ។
លោក អ៊ាង សុផល្លែត ជំនួយការផ្ទាល់ សម្ដេច តេជោ បាន ឲ្យដឹង អំពី លទ្ធផល ក្រោយ ជំនួប ថា លោកស្រី ហ្កាហ្វា រ៉ូវ៉ា បាន គោរព ថ្លែងអំណរគុណ ជូន ចំពោះ សម្ដេច តេជោ សម្ដេច ប្រធាន ព្រឹទ្ធសភា សម្ដេច ប្រធាន រដ្ឋសភា ដែល បាន គាំទ្រ អាហ្សែរ បៃហ្សង់ ឲ្យបាន ក្លាយជា អ្នកសង្កេតការណ៍ របស់ អាយប៉ា ។
លោកស្រី ហ្កាហ្វា រ៉ូវ៉ា បាន គោរព ជំរាប ជូន សម្ដេច តេជោ ថា រយៈពេល ៣ ថ្ងៃ នៅ ព្រះរាជាណាចក្រ កម្ពុជា លោកស្រី បាន ជួប ពិភាក្សា ការងារ និង បាន សង្កេតឃើញ សក្ដានុពល កិច្ចសហប្រតិបត្តិការ រវាង ស្ថាប័ន នីតិបញ្ញត្តិ ជាពិសេស រវាង យុវជន ។
ជាមួយគ្នា នោះ ដែរ លោកស្រី ហ្កាហ្វា រ៉ូវ៉ា ក៏ បាន ជំរាប ជូន សម្ដេច តេជោ នូវ បំណង ជំរុញ ទំនាក់ទំនង រវាង នីតិប្រតិបត្តិ ជំរុញ ការអនុវត្ត អនុស្សរណៈ ដែល បាន ចុះហត្ថលេខា រួចហើយ និង ស្វែងរក សក្ដានុពល បន្ថែម ទៀត ជាមួយ ការជំរុញ ការតភ្ជាប់ ទំនាក់ទំនង រវាង អាយ ប៉ា និង បណ្ដាញ សភា នៃ បណ្ដា ប្រទេស មិន ចូល បក្ស សម្ព័ន្ធ ។
ជា ការឆ្លើយតប សម្ដេច តេជោ ហ៊ុន សែន បាន យល់ស្រប ជាមួយនឹង ការវាយតម្លៃ របស់ លោកស្រី ហ្កាហ្វា រ៉ូវ៉ា និង បាន សម្ដែង នូវ ការគាំទ្រ ចំពោះ ការលើកឡើង របស់ លោកស្រី ប្រធាន រដ្ឋសភា នៃ សាធារណរដ្ឋ អាស៊ែ បៃហ្សង់ ៕
កាក់ មាស ខាងលើ ត្រូវបាន រកឃើញ កំលុង ការធ្វើ កំណាយ បុរាណវិទ្យា មួយ កាលពី ឆ្នាំ ១៩៩៩ នៅក្បែរ ទីក្រុង ម៉ាន ឈីង ហើយ ត្រូវបាន ចាត់ទុក ជា របកគំហើញ ធំ ជាង គេ បង្អស់ នៃ កាក់ មាស អរិយធម៌ សែល ទិច ប្រចាំ សតវត្សរ៍ ទី២០ ។ រដ្ឋមន្រ្តី វិទ្យាសាស្រ្ត និង សិល្បៈ នៃ រដ្ឋ បាវ៉ា រៀ របស់ អាល្លឺម៉ង់ បាន និយាយ ថា កាក់ មាស ទាំងនោះ ជួយ ផ្តល់ ការយល់ដឹង មួយចំណែក ដល់ មនុស្ស សម័យ ឥឡូវ អំពី ការរស់នៅ ប្រចាំ ថ្ងៃ របស់ ប្រជាជន ក្នុង តំបន់ បាវ៉ា រៀ កាលពី ជាង ២.០០០ ឆ្នាំ មុន ។
សេចក្តីប្រកាស ពី ដំណឹង នេះ ត្រូវបាន ធ្វើឡើង កាលពី ថ្ងៃពុធ ដោយ ប្រធានាធិបតី កូឡុំប៊ី លោក ហ្គូស្តា វ៉ូ ផេត្រូ (Gustavo Petro) ដែល បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការជួយសម្រេចបាន នូវ ការវិវត្ត ខាងលើ ។ លោក ផេត្រូ បាន និយាយ ដូច្នេះ ថា « នៅ ថ្ងៃទី ២៥ និង ទី ២៦ ខែវិច្ឆិកា កិច្ចពិភាក្សា រវាង រដ្ឋាភិបាល លោក ម៉ាឌូរ៉ូ ហើយនិង ក្រុម ប្រឆាំង របស់ វេណេស៊ុយអេឡា នឹង បន្ត សា ឡើងវិញ » ។
ការបន្ត កិច្ចសន្ទនា ឡើងវិញ ខាងលើ នឹង ប្រព្រឹត្តទៅ នៅ ម៉ិក ស៉ិក ក្រោម ការសម្របសម្រួល របស់ ន័រវែស ហើយ ត្រូវ គេ រំពឹង ថា ក៏ នឹង មាន ការជជែក អំពី ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី វេណេស៊ុយអេឡា ឆ្នាំ ២០២៤ ដែល ក្រុម ប្រឆាំង អះអាង ថា ខ្លួន មិន ទុកចិត្ត ផងដែរ ដ្បិត លោក ម៉ាឌូរ៉ូ បាន ប្រកាស រួចស្រេច ហើយ ថា រូប លោក គ្រោង នៅ បន្ត កាន់អំណាច រហូតដល់ ឆ្នាំ ២០៣០ ឯណោះ ។
គួរ បញ្ជាក់ ថា លោក ម៉ាឌូរ៉ូ បាន ឡើង កាន់អំណាច កាលពី ឆ្នាំ ២០១៣ បន្ទាប់ពី មរណភាព របស់ អតីត ប្រធានាធិបតី លោក ហ៊ូហ្កោ ឆាវេស (Hugo Chavez) ដោយ លោក ម៉ាឌូរ៉ូ ធ្លាប់ កាន់ តំណែង ជា អនុប្រធានាធិបតី របស់ លោក ឆាវេស ។ លោក ម៉ាឌូរ៉ូ ក៏ បាន ក្លាយជា បេក្ខជន ប្រធានាធិបតី ម្តង ទៀត នៅ ឆ្នាំ ២០១៨ ក្នុង ការបោះឆ្នោត ដែល ក្រុម ប្រឆាំង ក៏ ដូចជា សហរដ្ឋ អាមេរិក ហៅ ថា ការបោះឆ្នោត ក្លែងក្លាយ ដោយសារតែ ភាព មិន ប្រក្រតី មួយចំនួន ហើយ លោក ម៉ាឌូរ៉ូ បាន ទទួល ជ័យជម្នះ ម្តង ទៀត ៕
សម្តេច តេជោ ចង់ បង្កើត កិច្ចព្រមព្រៀង មិន យក ពន្ធ ត្រួត គ្នា ជាមួយ ម៉ារ៉ុក (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ចង់ បង្កើត កិច្ចព្រមព្រៀង មិន យក ពន្ធ ត្រួត គ្នា លើ ការធ្វើ ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ ។ សម្រាប់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី កិច្ចព្រមព្រៀង នេះ នឹង ជួយ សម្រួល ដល់ វិនិយោគិន និង ទាក់ទាញ ការវិនិយោគ រវាង ប្រទេស ទាំង ពីរ ផងដែរ ។
សូម បញ្ជាក់ ថា ក្នុង ជំនួប នោះ លោក Rachid បាន សម្ដែង នូវ ការគោរព វាយតម្លៃ ខ្ពស់ និង អបអរសាទរ ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន ដឹកនាំ អភិវឌ្ឍន៍ កម្ពុជា ឱ្យ មាន ហេដ្ឋារចនាសម្ព័ន្ធ ល្អ ទីក្រុង ស្រស់បំព្រង និង បាន ធ្វើ ការទទួលបាន ជោគជ័យ យ៉ាង ច្រើន សម្រាប់ តំបន់ ។
លោក Rachid ក៏ បាន សម្ដែង សេចក្ដីរីករាយ ដែល បាន ចូលរួម ក្នុង កិច្ចប្រជុំ អាយ ប៉ា ក្នុង ឋានៈ ជា អ្នកសង្កេតការណ៍ ហើយ បាន បង្ហាញ នូវ បំណង ចង់ ពង្រីក ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ជាមួយ កម្ពុជា និង ទាំង ជាមួយ តំបន់ ផងដែរ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន សម្ដែង នូវ ការស្វាគមន៍ និង បាន មានប្រសាសន៍ ថា ជា ជំហាន បន្ត ម៉ារ៉ុក អាច ប្រឹងប្រែង ធ្វើ យ៉ាងណា ដើម្បី ក្លាយ ខ្លួន ទៅជា ដៃគូ សន្ទនា តាម វិស័យ ជាមួយ អាស៊ាន ។
ដោយឡែក ជាមួយ កម្ពុជា វិញ សម្តេច តេជោ លើកទឹកចិត្ត ម៉ារ៉ុក ជំរុញ ទំនាក់ទំនង សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម ដែល ជា មូលដ្ឋាន នាំ ទៅ ដល់ ដំណើ ការ ទំនាក់ទំនង ល្អ ទាំង វិស័យ នយោបាយ និង វិស័យ ដទៃ ទៀត ៕
មូលនិធិ ជាតិ ជំនួយ សង្គម បាន ទទួល ពានរង្វាន់ ឧត្តម មានុវត្តន៍ នៃ ការអនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ ក្រីក្រ អំឡុង ពេល កូវីដ - ១៩ ពី ក្រុមប្រឹក្សាភិបាល នៃ សមាគម សន្តិសុខ សង្គម អាស៊ាន
ពានរង្វាន់ ឧត្តម មានុវត្តន៍ គឺជា ពានរង្វាន់ របស់ សមាគម សន្តិសុខ សង្គម អាស៊ាន ដែល ផ្តល់ជូន ដោយ ប្រធាន ក្រុមប្រឹក្សាភិបាល ជូន ចំពោះ បណ្តា ប្រទេស ដែល ជា សមាជិក អាស៊ាន ទាំងអស់ ដែល បាន បំពេញ ការងារ ប្រកបដោយ ភាពជោគជ័យ លើ ឧត្តមភាព នៃ ការផ្តល់ សេវា គាំពារ សង្គម ជូន ដល់ ប្រជាពលរដ្ឋ តាម ប្រទេស នីមួយ ៗ ។
គណ:កម្មការ បាន វាយតម្លៃ សម្រាប់ ការផ្តល់ ពាន់ រង្វាន់ ដោយ ផ្តោត លើ៖១. យន្តការអនុវត្ត ២. ប្រព័ន្ធ បើក ផ្តល់ ៣. លទ្ធផល អនុវត្ត ៤. ការសហការ របស់ ស្ថាប័ន ពាក់ព័ន្ធ ។
អភិបាល ខេត្ត កំពង់ចាម ចែក ស្បៀងអាហារ របស់ រាជ រដ្ឋាភិបាល ជូន ប្រជាពលរដ្ឋ ក្នុង ក្រុង កំពង់ចាម និង ស្រុក កំពង់សៀម ចំនួន ៨០០ គ្រួសារ
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា រួម ជាមួយ ថ្នាក់ដឹកនាំ ខេត្ត ជាច្រើន រូប ទៀត នៅ ព្រឹក ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន ជួប សំណេះសំណាល និង ចែក អំណោយ ដល់ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត ចំនួន សរុប ៨០០ គ្រួសារ ក្នុង នោះ មកពី ក្រុង កំពង់ចាម ចំនួន ៤០០ គ្រួសារ និង ស្រុក កំពង់សៀម ចំនួន ៤០០ គ្រួសារ ។
លោក អ៊ុន ចាន់ ដា បាន លើកឡើង ថា ការចែក ស្បៀងអាហារ របស់ រដ្ឋាភិបាល ដល់ ប្រជាពលរដ្ឋ នា ពេលនេះ គឺជា ការចូលរួម សុខ ទុក្ខ ជាមួយគ្នា ពោលគឺ បើ ទោះបីជា ស្ថិត ក្នុង កាលៈទេសៈ ណា ក៏ដោយ គឺ យើង មិន រត់ចោល គ្នា ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ចំពោះ ប្រជាពលរដ្ឋ ប្រភេទ ក្រ១ ក្រ២ ត្រូវបាន ទទួល ការឧបត្ថម្ភ ជា ថវិកា ពី រាជ រដ្ឋាភិបាល ជា ប្រចាំ ខែ ផងដែរ ដោយ កិច្ចការ នេះ រដ្ឋាភិបាល មិន ទាន់ បញ្ចប់ នៅឡើយ ទេ បើ ទោះបីជា ជំងឺ កូវីដ១៩ បាន ធូស្រាល ទៅ ហើយក្តី ។ ទន្ទឹមនឹង នេះ រាជ រដ្ឋាភិបាល បាន គិតគូរ បន្ត លើ កម្មវិធី គាំពារ សង្គម ដោយ ថ្មី ៗ នេះ មាន កម្មវិធី ថ្មី ២បន្ថែម ទៀត នៃ ផ្នែក សង្គមកិច្ច និង ផែនការគឺ៖
* ទី ១៖ ដោះស្រាយ ដល់ ប្រជាពលរដ្ឋ ក្រ១ ក្រ២ ដោយ ទឹក ជំនន់ * ទី ២៖ ដោះស្រាយ ដល់ ប្រជាពលរដ្ឋ ដែល ទទួលរង នូវ អតិផរណា ដោយសារ មាន សង្គ្រាម នៅ ក្រៅ ប្រទេស ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច ពិភពលោក ក៏ ដូចជា ប៉ះពាល់ ដល់ ជីវភាព របស់ ប្រជាពលរដ្ឋ ៕
ការប្តេជ្ញា នេះ បាន ធ្វើឡើង នៅក្នុង ជំនួប ពិភាក្សា ការងារ នា ថ្ងៃទី ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នៅ វិមាន សន្តិភាព ក្នុង ឱកាស ដែល លោក តំណាងរាស្រ្ត មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ដើម្បី ចូលរួម មហាសន្និបាត អន្តរសភា អាស៊ាន លើក ទី ៤៣ (AIPA) ។
លោក តំណាងរាស្ត្រ ហ្គ្រឺហ្គូរី មីក បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កម្ពុជា ដែល បាន ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ កិច្ចប្រជុំ ទាំង បី ខាងលើ ប្រកបដោយ ជោគជ័យ ខណៈ ដែល តំបន់ និង ពិភពលោក កំពុង ប្រឈម នឹង បញ្ហា ជាច្រើន ហើយ លោក ក៏ បាន កោតសរសើរ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ចំពោះ ភាព ជា អ្នកដឹកនាំ របស់ សម្តេច ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី នៃ ប្រទេស កម្ពុជា និង ជា ប្រធាន អាស៊ាន ឆ្នាំ ២០២២ ផងដែរ ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន ជម្រាប លោក តំណាងរាស្ត្រ ហ្គ្រឺហ្គូរី មីក អំពី ដំណើរការ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ជាពិសេស ការរៀបចំ ការបោះឆ្នោត ឃុំ - សង្កាត់ ដោយ សេរី និង យុត្តិធម៌ នៅ ខែមិថុនា កន្លងមក នេះ និង ការត្រៀម រៀបចំ របស់ កម្ពុជា និង គណបក្ស នយោបាយ នានា សម្រាប់ ការបោះឆ្នោត ជាតិ នា ពេល ខាងមុខ ។
ឆ្លើយតប នឹង កង្វល់ របស់ សហរដ្ឋ អាមេរិក ទាក់ទង នឹង មូលដ្ឋាន កងទ័ព ជើងទឹក រាម សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន អះអាង បញ្ជាក់ ជាថ្មី ពី ជំហរ ម៉ឺងម៉ាត់ របស់ កម្ពុជា មិន អនុញ្ញាតឱ្យ មាន វត្តមាន មូលដ្ឋាន យោធា បរទេស ណាមួយ នៅលើ ទឹកដី កម្ពុជា ដូច ដែល ត្រូវបាន ហាមឃាត់ ដោយ រដ្ឋធម្មនុញ្ញ និង បាន ធានា អំពី តម្លាភាព ក្នុង ការប្រើប្រាស់ កំពង់ផែ នេះ ផងដែរ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន និង លោក តំណាងរាស្ត្រ ហ្គ្រឺហ្គូរី មីក ក៏ បាន ផ្លាស់ប្តូរ ទស្សនៈ លើ ការវិវឌ្ឍ សំខាន់ ៗ ក្នុង តំបន់ និង សកលលោក ផងដែរ រួមទាំង ស្ថានការណ៍ នៅ ប្រទេស មីយ៉ាន់ម៉ា និង សង្រ្គាម នៅ ប្រទេស អ៊ុយក្រែន ហើយ ដែល ក្នុង ឱកាស នោះ លោក តំណាងរាស្ត្រ បាន កោតសរសើរ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី សម្រាប់ គោលជំហរ របស់ កម្ពុជា ចំពោះ សង្គ្រាម នៅ អ៊ុយក្រែន និង កិច្ច ខិតខំ ប្រឹងប្រែង ដើម្បី ជួយ ដោះស្រាយ វិបត្តិ នៅ មីយ៉ាន់ម៉ា ។
មក ទល់នឹង ពេលនេះ ចំនួន អ្នកស្លាប់ ក្នុង ហេតុការណ៍ នេះ មាន ចំនួន ២៧១ នាក់ ប៉ុន្តែ អាជ្ញាធរ រំពឹង ថា ចំនួន នឹង កើនឡើង បន្ថែម ទៀត ដោយសារតែ កន្លែង កើត ហេតុ ជា តំបន់ ដាច់ស្រយាល មួយ ហើយ ភ្លៀង ធ្លាក់ ខ្លាំង បាន រារាំង ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង ជួយសង្គ្រោះ ។ មនុស្ស ប្រហែល ៤០ នាក់ នៅតែ បាត់ខ្លួន និង ជាង ២.០០០ នាក់ ផ្សេង ទៀត រងរបួស ។
យោធ ភូមិភាគ ទី២ បំពាក់ ឋានន្តរស័ក្តិ គ្រឿង ឥស្សរយ ស ជូន យោធិន ចូលនិវត្តន៍ និង យោធិន ពិការ
( កំពង់ចាម ) ៖ លោក ឧត្តមសេនី ត្រី ថុល សុធី មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ យោធ ភូមិភាគ ទី២ នា ថ្ងៃទី ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សំណេះសំណាល បំពាក់ ឋានន្តរស័ក្តិ គ្រឿង ឥស្សរយ ស ជូន យោធិន ចូលនិវត្តន៍ និង យោធិន ពិការ ត្រូវ ផ្ទេរ ចេញ ពី ក្របខណ្ឌ ក្រសួង ការពារ ជាតិ ឆ្នាំ ២០២២ របស់ អង្គភាព ចំណុះ យោធ ភូមិភាគ ២។ ពិធី នេះ ធ្វើឡើង នៅ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ចាម ។
លោក ឧត្តមសេនី ត្រី ថុល សុធី ក្នុង នាម មេបញ្ជាការ កងទ័ព ជើងគោក មេបញ្ជាការ យោធ ភូមិភាគ ទី២ បាន សម្ដែង នូវ មនោសញ្ចេតនា ដឹងគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ កង យោពល ខេមរភូមិន្ទ ដែល បាន ធ្វើ ពលីកម្ម យ៉ាង ធំធេង ទាំង ក្នុង ចលនា រំដោះ ប្រទេសជាតិ ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង ទប់ស្កាត់ ការប៉ុនប៉ង ត្រឡប់ មកវិញ ។
បន្ថែម ពី នេះ បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ចលនា បង្រួបបង្រួម ជាតិ ផ្សះផ្សា ជាតិ និង ជា កម្លាំង ស្នូល ក្នុង ការអនុវត្តន៍ នយោបាយ ឈ្នះ ឈ្នះ នាំមក នូវ សន្តិភាព ពេញលេញ នៅ កម្ពុជា ក៏ ដូចជា បាន ចូលរួមចំណែក ថែរក្សា ការពារ សន្តិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម និង រួមចំណែក អភិវឌ្ឍន៍ ប្រទេសជាតិ ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ និង ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ធ្វើឲ្យ ប្រទេស កម្ពុជា ទទួលបាន ជោគជ័យ ដ៏ ត្រចះត្រចង់ ជា ប្រវត្តិសាស្ត្រ ។
លោក ឧត្តមសេនី ត្រី ថុល សុធី ក៏ បាន ផ្តាំផ្ញើ យោធិន ចូលនិវត្តន៍ និង យោធិន ពិការរលត្រូវ ផ្ទេរ ចេញ ពី ក្របខ័ណ្ឌ ក្រសួង ការពារ ជាតិ ឆ្នាំ ២០២២ នេះ ថា ទោះបី បាន ផ្ទេរ ភារកិច្ច ទៅជា ជន ស៊ីវិល ក្តី តែ ត្រូវ បន្ត ថែរក្សា ប្រពៃណី របស់ កងទ័ព ថែរក្សា សុខភាព ថែរក្សា តម្លៃ កិត្តិយស ស្នាដៃ និង ពលីកម្ម របស់ បងប្អូន កន្លងមក ឲ្យ ក្លាយជា គំរូ ដ៏ ល្អ សម្រាប់ លើកទឹកចិត្ត ដល់ អ្នកជំនាន់ ក្រោយ ៕ សម្តេច ប្រធាន ព្រឹទ្ធសភា កម្ពុជា ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ ប្រធាន រដ្ឋសភា អាស៊ែ បៃហ្សង់
លោក ហ្សេលេន ស្គី ប្រាប់ UN ៖ ការវាយប្រហារ របស់ រុស្ស៉ី លើ ហេដ្ឋារចនាសម្ព័ន្ធ ថាមពល អ៊ុយក្រែន ជា ឧក្រិដ្ឋកម្ម ប្រឆាំង មនុស្សជាតិ (Video inside) ( កៀវ ) ៖ ប្រធានាធិបតី អ៊ុយក្រែន លោក វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី បាន ចោទប្រកាន់ រុស្ស៉ី ថា បាន ប្រព្រឹត្ត ឧក្រិដ្ឋកម្ម ប្រឆាំង មនុស្សជាតិ ក្រោយ បាញ់ ស្រោច មីស៊ីល ជាថ្មី លើ ហេដ្ឋារចនាសម្ព័ន្ធ ថាមពល ដោយ បណ្ដាលឱ្យ ដាច់ ចរន្ត អគ្គិសនី នៅ ទូទាំង ប្រទេស អ៊ុយក្រែន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
