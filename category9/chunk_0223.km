( ភ្នំពេញ ) ៖ នៅ វេលា ម៉ោង ប្រមាណ ១១ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក ប្រាយុទ្ធ ច័ន្ទ អូចា នាយក រដ្ឋមន្ត្រី បាន ជួប សម្តែង ការគួរសម និង ពិភាក្ស ការងារ ។
សូម បញ្ជាក់ ថា លោក នាយក រដ្ឋមន្ត្រី ថៃ បាន អញ្ជើញ មកដល់ ប្រទេស កម្ពុជា នៅ ព្រឹក ថ្ងៃ នេះ ដើម្បី ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ ព្រមទាំង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ដែ ចាប់ផ្តើម ពី ថ្ងៃទី ១០ រហូតដល់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា នេះ ៕
នៅពេល ត្រូវបាន សួរ អំពី ការដក ថយ របស់ កងទ័ព រុស្ស៉ី លោក ស្តូល ធិន បឺ គ បាន ប្រាប់ អ្នកសារព័ត៌មាន ក្នុង ទីក្រុង ឡុងដ៏ នៃ ចក្រភព អង់គ្លេស យ៉ាង ដូច្នេះ ថា « កងកម្លាំង របស់ ទីក្រុង កៀវ ចាំបាច់ ត្រូវ ពងឹ្រង សមត្ថភាព ដើម្បី រំដោះ ទឹកដី អ៊ុយក្រែន បន្ថែម ទៀត ហើយ យើង ត្រូវតែ ធ្វើឲ្យ ប្រាកដ ថា ការគាំទ្រ ដែល ពួកគេ ទទួលបាន ពី ចក្រភព អង់គ្លេស ពី សម្ព័ន្ធមិត្ត និង ដៃគូ ណា តូ គឺ មិន អាច ខ្វះ បាន » ។
រយៈពេល ៣ ថ្ងៃ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ខេត្ត ព្រះសីហនុ ទទួលបាន ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ មក លេង កម្សាន្ត ជិត ៥០ម៉ឺន នាក់
បន្ថែម ពី នេះ បើ យោង តាម របាយការណ៍ របស់ អាកាសចរណ៍ ស៉ី វិល បាន ឱ្យដឹង ថា ភ្ញៀវ ទេសចរ ដែល មក កម្សាន្ដ នៅ ខេត្ត ព្រះសីហនុ ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប អក អំបុក សំពះ ព្រះខែ ថ្ងៃទី ០៣ ត្រូវនឹង ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២ បើ ធៀប នឹង ឆ្នាំ ២០២១ មាន ដូច ខាងក្រោម៖
ទី៣៖ ភ្ញៀវ ទេសចរ ទៅ កម្សាន្ត តាម កោះ នានា មាន៖
ទី៣៖ ភ្ញៀវ ទៅ កម្សាន្ត តាម បណ្តា ឆ្នេរ និង រមណីយដ្ឋាន នានា ក្នុង ខេត្ត៖
នាយក រដ្ឋមន្ត្រី ចិន ទស្សនា ប្រាសាទ បុរាណ ខ្មែរ នៅលើ ទឹកដី ខេត្ត សៀមរាប និង អញ្ជើញ ចូលរួម ពិធី ប្រគល់ - ទទួល គម្រោង ស្ថាបនា ឡើងវិញ ប្រាសាទ តាកែវ
( ភ្នំពេញ ) ៖ លោក លី ខឺ ឈាង នាយក រដ្ឋមន្ត្រី ចិន នៅ ព្រឹក ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ចូលរួម ពិធី ប្រគល់ ទទួល គម្រោង ស្ថាបនា ឡើងវិញ ប្រាសាទ តាកែវ និង ទស្សនា ប្រាសាទ បុរាណ ខ្មែរ ។
លោក នាយក រដ្ឋមន្ត្រី ចិន និង ប្រតិភូ នៅ ថ្ងៃ នេះ បាន និង កំពុង អញ្ជើញ ទស្សនា ប្រាសាទ តាកែវ . ប្រាសាទ តា ព្រហ្ម ប្រាសាទ អង្គរវត្ត និង ប្រាសាទ បាយ័ន ផងដែរ ។
គួរ បញ្ជាក់ ថា កាលពី ខែឧសភា កន្លងទៅ នៅ ពេល ដែល លោក បៃ ដិន បាន ធ្វើ ទស្សនកិច្ច លើក ចុងក្រោយ នៅ អាស៊ី មន្ត្រី រដ្ឋបាល របស់ លោក បាន និយាយ ថា ពួកគេ កំពុង ស្ថិត ក្នុង ដំណាក់កាល ចុងក្រោយ នៃ ការពិនិត្យ ឡើងវិញ នូវ គោល នយោបាយ របស់ ខ្លួន ចំពោះ កូរ៉េ ខាងជើង ហើយ មាន បំណង លើកទឹកចិត្ត ឲ្យ មាន កិច្ចសហប្រតិបត្តិការ ត្រី ភាគី កាន់តែ ច្រើន ជាមួយ ទីក្រុង សេអ៊ូល និង តូក្យូ លើ បញ្ហា នេះ ៕
ខាងក្រោម នេះ ជា របាយការណ៍ នៃ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ប្រទេស អាស៊ាន គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០២២៖
( ភ្នំពេញ ) ៖ កម្លាំង កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ដែល ត្រៀម រួច ជាស្រេច តាម បណ្តា គោលដៅ ឈរ ជើង ដើម្បី ចូលរួម ការពារ សន្តិសុខ សុវត្ថិភាព រក្សា សណ្តាប់ធ្នាប់ ជូន ថ្នាក់ដឹកនាំ ជាតិ - អន្តរាជាតិ ដែល អញ្ជើញ ចូលរួម ក្នុង កិច្ច ប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នានា ប្រកបដោយ ស្មារតី ម្ចាស់ ការទទួលខុសត្រូវ ខ្ពស់ បំផុត នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
សូម រំលឹក ថា សម្រាប់ កងកម្លាំង ដែល ត្រៀមខ្លួន ការពារ សរុប មាន ចំនួន ប្រមាណ ជាង ១ម៉ឺន នាក់ ក្នុង នោះ មាន ទាំង កងកម្លាំង នគរបាល ជាតិ . កងរាជអាវុធហត្ថ និង កងយោធពល ខេមរភូមិន្ទ ផងដែរ ហើយ កងកម្លាំង ទាំងអស់ នេះ គឺ មកពី បណ្ដា អង្គភាព និង ស្ថាប័ន ចំនួន ១៤ ។
ចំពោះ មុខ នេះ គឺ កងកម្លាំង កម្ពុជា មាន សមត្ថភាព គ្រប់គ្រង ក្នុង ការរក្សា សន្ដិសុខ សុវត្ថិភាព និង សណ្ដាប់ធ្នាប់ ក្នុង ព្រឹត្តិការណ៍ ដ៏ សំខាន់ មួយ នេះ ៕
អាស៊ាន ចាប់ផ្តើម កិច្ចប្រជុំ ក្រុមប្រឹក្សា សម្របសម្រួល អាស៊ាន (ACC) លើក ទី ៣១
( ភ្នំពេញ ) ៖ កិច្ចប្រជុំ ក្រុមប្រឹក្សា សម្របសម្រួល អាស៊ាន (ACC) លើក ទី ៣១ បាន រៀបចំឡើង នៅ វេលា ម៉ោង ០៩៖៤៥ ព្រឹក ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ដោយ មាន កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។ កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពី រដ្ឋមន្ត្រី ACC និង អគ្គ លេខាធិការ អាស៊ាន ។
ACC មាន ទំនួល ខុសត្រូវ ក្នុង ការត្រួតពិនិត្យ ការអភិវឌ្ឍ និង ការអនុវត្ត ឯកសារ តាម ការចាត់តាំង ដោយ មេដឹកនាំ អាស៊ាន ។ ឯកសារ ត្រូវ ស្វែងរក ធាតុ ចូល និង ការឯកភាព ពី ក្រុមប្រឹក្សា សហគមន៍ អាស៊ាន ទាំង បី គឺ ក្រុមប្រឹក្សា សហគមន៍ នយោបាយ - សន្តិសុខ អាស៊ាន (APSC) ក្រុមប្រឹក្សា សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន (AEC) និង ក្រុមប្រឹក្សា សហគមន៍ សង្គម វប្បធម៌ អាស៊ាន (ASCC) មុនពេល ដាក់ ជូន មេដឹកនាំ អាស៊ាន ដើម្បី អនុម័ត ក្នុង កិច្ចប្រជុំ កំពូល អាស៊ាន ។
ថ្លែង នៅក្នុង សន្និសីទ សារព័ត៌មាន នៅឯ សេតវិមាន នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ លោក បៃ ដិន បាន គូសបញ្ជាក់ ដូច្នេះ ថា « ខ្ញុំ គិត ថា ប្រជាជន អាមេរិក បាន បញ្ជាក់ យ៉ាង ច្បាស់ ថា ពួកគេ រំពឹង ថា គណបក្ស សាធារណរដ្ឋ នឹង ត្រូវ រៀបចំ ខ្លួន ដើម្បី ធ្វើការ ជាមួយ ខ្ញុំ » ។ លោក បៃ ដិន ក៏ បាន រំលឹក ឡើងវិញ នូវ បំណង របស់ លោក ក្នុង ការឈរឈ្មោះ សម្រាប់ ការបោះឆ្នោត ឆ្នាំ ២០២៤ ដោយ និយាយ ថា លោក នឹង ធ្វើ ការសម្រេចចិត្ត ចុងក្រោយ នៅ ដើម ឆ្នាំ ២០២៣ ។
លទ្ធផល បណ្តោះអាសន្ន នៃ ការប្រកួតប្រជែង ក្នុង រដ្ឋ ណេវ៉ា ដា (Nevada) និង រដ្ឋ អារីហ្សូណា (Arizona) គឺ គណបក្ស សាធារណរដ្ឋ តាម ប្រកៀកប្រកិត ជាមួយ គណបក្ស ប្រជាធិបតេយ្យ ប៉ុន្តែ នៅ មិន ទាន់ មាន ការសម្រេច ឡើយ ដោយ ការរាប់ សន្លឹក ឆ្នោត រាប់ ពាន់ សន្លឹក អាច ចំណាយ ពេល ច្រើន ថ្ងៃ ។ តែ គណបក្ស សាធារណរដ្ឋ កំពុង ខិត កាន់តែ ជិត ទៅ រក កៅអី ចំនួន ២១៨ ដែល ជា សំឡេង ភាគ ច្រើន ដើម្បី ដណ្តើម ការគ្រប់គ្រង សភា តំណាងរាស្ត្រ ពី គណបក្ស ប្រជាធិបតេយ្យ ។
គួរ បញ្ជាក់ ថា លោក ចូ បៃ ដិន នៅក្នុង សប្ដាហ៍ នេះ ក៏ បាន ព្រមាន ដែរ ពី គ្រោះថ្នាក់ ដល់ លទ្ធិ ប្រជាធិបតេយ្យ ប្រសិនបើ គណបក្ស សាធារណរដ្ឋ ទទួលបាន ជ័យជម្នះ នៅក្នុង ការបោះឆ្នោត ពាក់កណ្ដាល អាណត្តិ ខណៈ មាន ការព្រួយបារម្ភ កាន់តែ ខ្លាំង ថា ការគ្រប់គ្រង សភា ណាមួយ ក្នុង ចំណោម សភា ទាំង២ អាចនឹង ធ្វើឱ្យ ប៉ះពាល់ ដល់ ការគាំទ្រ របស់ សហរដ្ឋ អាមេរិក ចំពោះ អ៊ុយក្រែន ៕
បើ យោង តាម កាលវិភាគ នៃ ប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ រដ្ឋមន្រ្តី ការបរទេស និង អគ្គ លេខាធិការ អាស៊ាន នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ត្រូវបាន រំពឹង ថា អញ្ជើញ ធ្វើជា សាក្សី ក្នុង ការចុះហត្ថលេខា លើ លិខិតុបករណ៍ នៃ ការចូល ជា សមាជិក TAC ដោយ អ៊ុយក្រែន និង អេស្ប៉ាញ ។
ដំណឹង នេះ ក៏ ត្រូវ បាន បញ្ជាក់ ដោយ លោក បណ្ឌិត គង់ ភោគ រដ្ឋលេខាធិការ នៃ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ និង ជា អ្នកនាំពាក្យ ផ្លូវការ នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ពេល ធ្វើ សន្និសីទ សារព័ត៌មាន ប្រចាំ ថ្ងៃ សម្រាប់ ព្រឹក ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
លោក បណ្ឌិត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា «( អាស៊ាន ) យើង បើក ទ្វារ ទទួល ទាំងអស់ ណា ដែល ចង់ សហការ ក៏ ដូចជា ចង់ មក តំបន់ ដើម្បី កសាង ទំនាក់ទំនង ឬមួយ ក៏ ស្វែងរក ឱកាស រីកចម្រើន រួមគ្នា ។ ខ្ញុំ គិត ថា នេះ ជា ចំណុច ខ្លាំង របស់ យើង ដែល ធ្វើឲ្យ អាស៊ាន ក្លាយជា ទីប្រជុំ ទម្ងន់ នៅក្នុង ការរីកចម្រើន នៅក្នុង សាកលលោក បច្ចុប្បន្ន » ។
សន្ធិសញ្ញា មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ នៅ អាស៉ី អាគ្នេយ៍ ហៅ កាត់ ថា TAC ត្រូវបាន បង្កើតឡើង ក្នុង ឆ្នាំ ១៩៧៦ និង បង្កប់ នូវ គោលការណ៍ ជា សកល នៃ ការរួមរស់ ដោយ សន្តិភាព និង កិច្ចសហប្រតិបត្តិការ មិត្តភាព ក្នុង ចំណោម រដ្ឋ នៅក្នុង តំបន់ អាស៉ី អាគ្នេយ៍ ។ វា គឺជា វិធាន គតិយុត្តិ សម្រាប់ ទំនាក់ទំនង អន្តរ រដ្ឋ នៅក្នុង តំបន់ និង សកលលោក ។
បើ លោក បណ្ឌិត គង់ ភោគ បាន ឲ្យដឹង ថា ក្រោម ភាព ជា ហត្ថលេខី នៃ TAC ដែល ជា ជំហាន ដំបូង នៅពេល ខាងមុខ រដ្ឋ ទាំងនោះ ក៏ អាចនឹង ក្លាយជា ដៃគូ សន្ទនា តាម វិស័យ របស់ អាស៊ាន និង រហូតដល់ ក្លាយជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ជាមួយ អាស៊ាន ផងដែរ ។
សូម ជម្រាប ថា អំឡុង ពេល កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ កន្លងទៅ ព្រះរាជាណាចក្រ ដាណឺម៉ាក . សាធារណរដ្ឋ ក្រិក . ព្រះរាជាណាចក្រ ហូឡង់ . ប្រទេស អូម៉ង់ . រដ្ឋ កាតា និង អារ៉ាប់ រួម អេមីរ៉ាត់ ក៏ បាន ក្លាយជា សមាជិក TAC ផងដែរ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៥៤ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ល្មើស ល្បឿន និង អត់ ស្លាកលេខ ជាដើម ។
ថ្មី ៗ នេះ ប្រធានាធិបតី សហរដ្ឋ អាមេរិក លោក ចូ បៃ ដិន បាន បង្ហើប ឲ្យដឹង ថា លោក មិន ទាន់ ត្រៀមខ្លួន រួចរាល់ ក្នុង ការផ្តល់ សម្បទាន ជា មូលដ្ឋាន ណាមួយ ដល់ ប្រទេស ចិន នោះ ទេ ហើយ ក្នុង អំឡុង ពេល នៃ កិច្ចប្រជុំ កំពូល G20 ខាងមុខ នេះ លោក ចង់ គូសបញ្ជាក់ អំពី បន្ទាត់ ក្រហម របស់ ទីក្រុង ប៉េកាំង និង ទីក្រុង វ៉ាស៉ីន តោន ផងដែរ ។
យុវជន ត្រូវបាន ចាត់ទុក ថា ជា កម្លាំង ចលករ ដ៏ សំខាន់ សម្រាប់ ជំរុញ កំណើន សេដ្ឋកិច្ច និង ជា កម្លាំង ផលិតកម្ម ដ៏ មាន សក្តានុពល ។ យុវជន ក្នុង តំបន់ អាស៊ាន អាយុ ចន្លោះ ពី ១៥ ទៅ ៣៤ ឆ្នាំ មាន ចំនួន ប្រមាណ ២១៣ លាន នាក់ ហើយ មាន ការរំពឹង ថា ចំនួន យុវជន អាច កើន ដល់ ២២០ លាន នាក់ នៅ ឆ្នាំ ២០៣៨ ។
អាស៊ាន បាន និង កំពុង យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការលើកកម្ពស់ សមត្ថភាព របស់់ យុវជន តាមរយៈ ការដាក់ចេញ នូវ គោល នយោបាយ នានា គាំទ្រ ដល់ ការអប់រំ និង ផ្តល់ បណ្តុះបណ្តាល ជំនាញ ផ្សេង ៗ ជាពិសេស ការអប់រំ ផ្នែក ឌីជិថល ដើម្បី ឆ្លើយតប ការវិវឌ្ឍន៍ នៃ សង្គម ៕ អភិបាល ខេត្ត បាត់ដំបង នាំ អំណោយ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប្រគល់ ជូន ពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់ ជាង ១ពាន់ គ្រួសារ នៅ ស្រុក បវេល
( បាត់ដំបង ) ៖ លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង និង ជា ប្រធាន គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត នៅ ព្រឹក ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ បាន បន្ត ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ និង នាំយក អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ទៅ ចែកជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់ ចំនួន ១. ១២១ គ្រួសារ នៅ ស្រុក បវេល ។
លោក ក៏ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ កងកម្លាំងប្រដាប់អាវុធ ទាំងអស់ ដែល បាន ខិតខំ ជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ ពី គ្រោះ ទឹក ជំនន់ បាន ទាន់ ពេលវេលា ដែល ចំណុច នេះ បាន បង្ហាញ ពី កម្លាំង សាមគ្គីភាព គ្នា និង បង្ហាញ ពី ភាពរឹងមាំ ក្នុង ការចុះ សង្រ្គោះ ប្រជាពលរដ្ឋ ។
អំណោយ ដែល នាំយក មក ជូន នា ពេលនេះ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម ទឹក សុទ្ធ ១កេស ទឹកត្រី ១យួរ ទឹកស៊ី អីវ ១យួរ ត្រីខ ១យួរ មី ១កេស ធុង ចម្រុះ ទឹក ស្អាត ចំនួន ០១ ឈុត ៕
កម្ពុជា - ចិន រៀបចំ ពិធី ប្រគល់ ទទួល គម្រោង ជួសជុល និង អភិរក្ស ប្រាសាទ តាកែវ
( សៀមរាប ) ៖ ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរបនីយកម្ម និង សំណង់ និង ជា តំណាង ដ៏ ខ្ពង់ខ្ពស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោក លី ខឺ ឈាង នាយក រដ្ឋមន្ត្រី នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន បាន អញ្ជើញ ប្រគល់ និង ទទួល គម្រោង ជួសជុល និង អភិរក្ស ប្រាសាទ តាកែវ នៃ រមណីយដ្ឋាន ប្រវត្តិសាស្ត្រ អង្គរ ។
ពិធី នេះ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ដោយ មាន ការចូលរួម ពី លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន និង អភិបាល ខេត្ត សៀមរាប អគ្គ នាយក អាជ្ញាធរ ជាតិ អប្សរា ព្រមទាំង ភ្ញៀវ ជាតិ និង អន្តរជាតិ ជាច្រើន រូប ទៀត ដែល ប្រព្រឹត្ត ធ្វើឡើង នៅ ក្រុង សៀមរាប ។
ក្នុង ឱកាស នេះ ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា បាន បញ្ជាក់ ថា ការរីកចម្រើន និង ការវិវត្តន៍ ឈានឡើង របស់ កម្ពុជា ពិតជា មិន អាច កាត់ផ្ដាច់ ពី ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ កម្ពុជា ចិន ដ៏ ស្អិត រមួត ជាពិសេស ជំនួយ ហិរញ្ញប្បទាន ឥត សំណង ឥណទាន ឥត ការប្រាក់ និង ឥណទាន សម្បទាន ក្នុង វិស័យ សំខាន់ ៗ ជាច្រើន រួម នឹង ការផ្ដល់ វ៉ាក់សាំង ប្រឆាំង ជំងឺ កូវីដ១៩ ផងដែរ ។
ក្រៅពី កិច្ចការ អភិរក្ស ទាំងអស់ នេះ ស្ថាប័ន សាធារណៈ និង ឯកជន ចិន ផ្សេង ទៀត ក៏ បាន រួមចំណែក ក្នុង ការងារ អភិរក្ស ផ្សព្វផ្សាយ និង លើក តម្លៃ បេតិកភណ្ឌ វប្បធម៌ កម្ពុជា ផងដែរ ។ ដោយឡែក ពិធី ប្រគល់ ទទួល គម្រោង ជួសជុល និង អភិរក្ស ប្រាសាទ តាកែវ នា ពេលនេះ គឺជា សក្ខីភាព ដ៏ ជាក់ស្ដែង និង ជា លទ្ធផល នៃ កិច្ចសហប្រតិបត្តិការ អមតៈ រវាង ប្រជាជាតិ នៃ ប្រទេស ទាំង ពីរ កម្ពុជា - ចិន ។
ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា បាន បង្ហាញ ពី គោលជំហរ ថា រាជ រដ្ឋាភិបាល កម្ពុជា នៅតែ បន្ត ប្រកាន់ខ្ជាប់ ដោយ ឥត លក្ខខណ្ឌ និង គ្មាន ភាពស្រពេចស្រពិល នូវ « នយោបាយ ចិន តែ មួយ » ក៏ ដូចជា គាំទ្រ យ៉ាង ពេញ ទំហឹង នូវ « គំនិត ផ្ដួច ផ្ដើម ខ្សែក្រវ៉ាត់ និង ផ្លូវ » របស់ រដ្ឋាភិបាល ចិន នៅលើ គ្រប់ វេទិកា តំបន់ និង អន្តរជាតិ ពិសេស រួមគ្នា កសាង « សហគមន៍ តែ មួយ ជោគវាសនា តែ មួយ ដើម្បី មនុស្សជាតិ » ។
លោក លី ខឺ ឈាង បាន បញ្ជាក់ ថា ដោយ មើលឃើញ ថា រមណីយដ្ឋាន ប្រវត្តិសាស្រ្ត អង្គរ បង្ហាញ ឱ្យ ឃើញ ពី ភាពរុងរឿង ដ៏ អស្ចារ្យ ក៏ ដូចជា មោទនភាព របស់ ប្រជាជាតិ កម្ពុជា នោះ ដូច្នេះ ហើយ ទើប ពេលនេះ ប្រទេស ចិន ក៏ បាន ជួយ ជួសជុល ប្រាសាទ តាកែវ នៃ រមណីយដ្ឋាន ប្រវត្តិសាស្ត្រ អង្គរ ដែល នេះ ជា លើក ទី២ ក្រោម ក្របខណ្ឌ UNESCO បាន ជួយ ដល់ ប្រទេស កម្ពុជា ។
លោក លី ខឺ ឈាង យល់ឃើញ ថា គម្រោង ជួសជុល និង អភិរក្ស ប្រាសាទ តាកែវ នឹង ផ្ដល់ ផលប្រយោជន៍ ដល់ កម្ពុជា ក៏ ដូចជា ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ចិន និង កម្ពុជា ព្រមទាំង ការផ្លាស់ប្ដូរ វប្បធម៌ អរិយធម៌ រវាង បណ្ដា ប្រទេស នីមួយ ៗ នៅលើ ពិភពលោក ផងដែរ ។
នាយក រដ្ឋមន្ត្រី ចិន សង្ឃឹម ថា កិច្ចសហប្រតិបត្តិការ រវាង ចិន និង កម្ពុជា នឹង រួមចំណែក ធ្វើឱ្យ រមណីយដ្ឋាន ប្រវត្តិសាស្ត្រ អង្គរ ក៏ ដូចជា ជួយ ជំរុញ ដល់ ប្រជាជន នៃ ប្រទេស ទាំង ពីរ បាន ស្វែងយល់ កាន់តែ ស៊ីជម្រៅ បន្ថែម ទៀត អំពី វប្បធម៌ នៃ ប្រទេស ទាំង ពីរ កម្ពុជា - ចិន ៕
កិច្ចប្រជុំ នេះ សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា អញ្ជើញ ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ សភា នៃ បណ្តា ប្រទេស សមាជិក អាយ ប៉ា ចូលរួម កិច្ចប្រជុំ ទល់ មុខ ជាមួយ មេដឹកនាំ អាស៊ាន ។
នៅ មុនពេល ឈានដល់ កិច្ចប្រជុំ ទល់ មុខ គ្នា រវាង មេដឹកនាំ កំពូល របស់ អាស៊ាន និង អាយប៉ា នេះ នៅ ព្រឹក មិញ នេះ លោក កិត្តិ សេដ្ឋ បណ្ឌិត ជា ម យៀប អនុប្រធាន ទី១ នៃ រដ្ឋសភា និង ជា ប្រធាន គណៈប្រតិភូសភា កម្ពុជា បាន ចូលរួម ផ្តល់ នូវ អនុសាសន៍ មួយចំនួន ដោយ ផ្តោត សំខាន់ លើ បញ្ហា គន្លឹះ ដែល ជា ការប្រឈម រួម របស់ ប្រទេស ជា សមាជិក អាយ ប៉ា និង អាស៊ាន នៅក្នុង កិច្ចប្រជុំ រៀបចំ សេចក្តីព្រាង សារ អាយ ប៉ា នៅ សណ្ឋាគារ កាំបូឌីយ៉ា ណា ។
គណៈប្រតិភូសភា នៃ បណ្តា ប្រទេស ជា សមាជិក អាយ ប៉ា នឹង នាំយក នូវ ធាតុ ចូល ដែល ជា ទស្សនៈ រួម ក្នុង នាម ប្រទេស ជា សមាជិក អាយ ប៉ា ដាក់បញ្ចូល ទៅក្នុង សារ ដែល នឹង ត្រូវ ថ្លែង ដោយ សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង ជា ប្រធាន ប្តូរ វេន អាយ ប៉ា លើក ទី ៤៣ នៅ ចំពោះមុខ ថ្នាក់ដឹកនាំ អាស៊ាន ។
សូម បញ្ជាក់ ថា កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ដែល រៀបចំ នៅ រាជធានី ភ្នំពេញ បាន ចាប់ផ្តើម ហើយ នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា នេះ ។ ជា កិច្ច ចាប់ផ្តើម ដំណើរការ នៃ កិច្ចប្រជុំ ប្រចាំ ឆ្នាំ ដ៏ មាន សារៈសំខាន់ នេះ នៅ ព្រឹក ថ្ងៃទី ១០ ខែវិច្ឆិកា សម្តេច តេជោ ហ៊ុន សែន ប្រធាន អាស៊ាន បាន ដឹកនាំ មេដឹកនាំ សមាជិក អាស៊ាន ដទៃ ទៀត ចូល ក្រាប បង្គំ គាល់ ព្រះមហាក្សត្រ ។
នៅ រសៀល ថ្ងៃ ដដែល នេះ ក្រៅតែ ពី ការប្រជុំ ត ទល់ មុខ ជាមួយ អន្តរសភា អាស៊ាន ហើយ នោះ មេដឹកនាំ អាស៊ាន ក៏ នឹង ជួបប្រជុំ ជាមួយ តំណាង យុវជន អាស៊ាន និង ក្រុមប្រឹក្សា ធុរកិច្ច អាស៊ាន ផងដែរ ។
នៅ ព្រឹក ថ្ងៃទី ១១ ខែវិច្ឆិកា កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ នឹង បើក ជា ផ្លូវការ ៕
សម្រាប់ បញ្ហា ទ្វេ ភាគី នាយក រដ្ឋមន្ត្រី ប្រទេស ទាំង ពីរ បាន ពិភាក្សា លើ ការអភិវឌ្ឍ ធនធាន មនុស្ស និង អប់រំ . ទេសចរណ៍ . ពាណិជ្ជកម្ម . សន្តិសុខ . ការប្រែប្រួល អាកាសធាតុ និង សំណល់ រឹង ក្នុង សមុទ្រ . ការតភ្ជាប់ និង ការដោះ មីន ។
លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ឱ្យដឹង ថា សម្រាប់ ក្របខណ្ឌ អាស៊ាន សម្តេច តេជោ ហ៊ុន សែន និង លោក ប្រាយុទ្ធ ចន្ទ អូចា បាន ឯកភាព គ្នា បន្ត រក្សា តួនាទី ស្នូល និង មជ្ឈភាព អាស៊ាន ។
ដោយឡែក ក្របខណ្ឌ ទ្វេ ភាគី វិញ នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ថៃ បាន សន្យា បន្ត ជំរុញ កិច្ចសហប្រតិបត្តិការ លើ ការងារ សំខាន់ ៗ ចំនួន ៨រួម មាន៖
ទោះបី កាន់ មុខតំណែង នៅ ទីក្រុង សៀងហៃ បាន តែ ៧ខែ និង ៤ ថ្ងៃ ប៉ុណ្ណោះ តែ លោក Xi Jinping នៅតែ បន្ត រក្សា ទម្លាប់ ដែល ចុះ ត្រួតពិនិត្យ ការងារ នៅ មូលដ្ឋាន ក្នុង ពេល កាន់ មុខតំណែង លោក បាន ធ្វើដំណើរ ទៅ សង្កាត់ និង ស្រុក ទាំងអស់ ចំនួន ១៩ នៅ ទីក្រុង សៀងហៃ ហើយ ជួប សំណេះសំណាល ជាមួយ ប្រជាជន នៅ ទីក្រុង ជនបទ រោងចក្រ និង សហគមន៍ ដើម្បី ស្វែងយល់ ពី សភាពការណ៍ ផ្សេង ៗ និង លើកទឹកចិត្ត ពួកគេ ។
បញ្ជូន ជនសង្ស័យ ម្នាក់ ទៅ សាលាដំបូង ខេត្ត រតនគិរី ករណី ហិង្សា
( រតនគិរី ) ៖ កម្លាំង នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ បាន បញ្ជូន ជនសង្ស័យ ម្នាក់ ករណី ហិង្សា ដោយ ចេតនា ទៅ សាលាដំបូង ខេត្ត រតនគិរី ។
មន្ត្រី នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល បាន ប្រាប់ ថា ជនសង្ស័យ ដែល ឃាត់ខ្លួន មាន ឈ្មោះ ខុន ស៊ាង ឃុន អាយុ ៤០ ឆ្នាំ មុខរបរ ធ្វើ ចំការ មាន ទីលំនៅ ភូមិ អុល ឃុំ ប៉ាតាង ស្រុក លំផាត់ ។
ការឃាត់ខ្លួន ជនសង្ស័យ ក្រោយពី ទទួល ពាក្យបណ្តឹង ករណី ហិង្សា ដោយ ចេតនា លើ ស្ត្រី ម្នាក់ ឈ្មោះ ជឹម សុនីតា ស្ថិត ក្នុង ភូមិ អុល ឃុំ ប៉ាតាង កាលពី ថ្ងៃទី ៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ កន្លងទៅ ។
ក្រោយ មាន អំពើហិង្សា រួច ការិយាល័យ ជំនាញ ព្រហ្មទណ្ឌ កម្រិត ស្រាល បាន សហការ ជាមួយ កម្លាំង អធិការដ្ឋាន ស្រុក លំផាត់ បាន ចុះ ទៅដល់ កន្លែង កើត ហេតុ ដើម្បី ធ្វើ ការស្រាវជ្រាវ ។
ប្រតិបត្តិការ នេះ ដឹកនាំ ដោយ លោក ហាង សម្បត្តិ ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត រហូតដល់ ថ្ងៃទី ៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ទោះ បាន ឃាត់ខ្លួន ជនសង្ស័យ នាំ មក ឃុំ ខ្លួន បណ្តោះអាសន្ន នៅ ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការ នគរបាល ខេត្ត រតនគិរី ។
បើ តាម មន្រ្តី នគរបាល នៅ វេលា ម៉ោង ១៧៖០០ នាទី ថ្ងៃទី ៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ កន្លងទៅ ជនរងគ្រោះ ឈ្មោះ ជឹម សុនីតា បាន អូស ទុយោ ទឹក ដើម្បី ដាក់ ទឹក ឲ្យ គេ ដែល កាត់ ព្រំ ដី ជនសង្ស័យ ក្រោយមក ទុយោ ទឹក នោះ បាន ធ្លាយ នៅ ចំណុច ព្រំ ដី នោះ ជនរងគ្រោះ បាន ស្រែក ជេ ខ្លាំង ៗ មក ប្អូន របស់ ខ្លួន ថា ហេតុ អ្វី បានជា មិន ចេះ មើល ធ្វើឲ្យ ទឹក ពាសពេញ នឹង អស់ ។
លោក កែវ ភក្តី ព្រះរាជអាជ្ញា រង និង ជា អ្នកនាំពាក្យ អយ្យការ អម សាលាដំបូង ខេត្ត រតនគិរី នៅ វេលា ម៉ោង ១០៖ ៥០នាទី ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ បាន ប្រាប់ ភ្នាក់ងារ Fresh News ថា មន្ត្រី នគរបាល យុត្តិធម៌ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី បាន បញ្ជូន ខ្លួន ជនសង្ស័យ ខាងលើ មកដល់ តុលាការ ហើយ ប៉ុន្តែ មិន ចោទប្រកាន់ ពី បទ អ្វី នៅឡើយ ទេ ពោលគឺ កំពុង បន្ត នីតិវិធី ៕
( ព្រះសីហនុ) ៖ លោក ស្បោង សារ៉ាត ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ព្រៃវែង បាន ថ្លែង ថា កត្តា សន្តិភាព បាន ជំរុញ ឲ្យ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ រីកចម្រើន ទទួលបាន នូវ សុភមង្គល គ្រប់ ក្រុមគ្រួសារ និង មាន សិទ្ធិ សេរីភាព ពេញលេញ ក្នុង ការចូលរួម ប្រារព្ធ ពិធី បុណ្យ ប្រពៃណី ជាតិ និង បុណ្យ សាសនា ផ្សេង ៗ យ៉ាង សប្បាយរីករាយ ហើយ កម្ពុជា ទទួលបាន ឱកាស ការងារ យ៉ាង ច្រើន នៅ ទូទាំង ប្រទេស ។
ជាមួយគ្នា នេះ លោក ស្បោង សារ៉ាត បាន លើកឡើង ថា ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន ធ្វើឲ្យ កម្ពុជា ទទួលបាន នូវ សុខ សន្ដិភាព និង មាន ការអភិវឌ្ឍ រីកចម្រើន ហេដ្ឋារចនាសម្ព័ន្ធ លើ គ្រប់ វិស័យ នៅ ទូទាំង កម្ពុជា ធ្វើឲ្យ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ កាន់តែ ល្អ ប្រសើរឡើង ។
( ភ្នំពេញ ) ៖ នៅ វេលា ម៉ោង ២រសៀល ថ្ងៃព្រហស្បតិ៍ ទី១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា ប្រធាន អាស៊ាន ព្រមទាំង មេដឹកនាំ កំពូល ប្រទេស សមាជិក អាស៊ាន បាន អញ្ជើញ ចូលរួម ប្រជុំ ជាមួយ អន្តរសភា អាស៊ាន ( អាយ ប៉ា-AIPA) ដែល រៀបចំឡើង នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ថ្លែង យ៉ាង ដូចនេះ នា ព្រឹក ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២២ នេះ ក្នុង ឱកាស ដែល លោក អញ្ជើញ ជា អធិបតី ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ក្របខណ្ឌ (FA) សម្រាប់ គម្រោង សាងសង់ ផ្លូវ ល្បឿន លឿន តភ្ជាប់ ពី ភ្នំពេញ ទៅ ក្រុង បាវិត រវាង រាជ រដ្ឋាភិបាល កម្ពុជា និង ក្រុមហ៊ុន សាជីវកម្ម ស្ពាន និង ថ្នល់ ចិន (CRBC) នៅ ទីស្តីការ ក្រសួង ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ថ្លែង ដូចនេះ ថា « ផ្លូវ ល្បឿន លឿន នេះ មាន ចំងាយ ១៣៨ គីឡូម៉ែត្រ និង ត្រូវ ធ្វើ ស្ពាន ឆ្លង ទន្លេ មេគង្គ ដ៏ វែង មួយ ដែល គិត ទាំង ស្ពាន និង ផ្លូវ ប្រហែលជា ៥គីឡូម៉ែត្រ ហើយ ថវិកា ដែល គ្រោង បណ្តាក់ទុក ប្រមាណ ១ ៦៣៨ លាន ដុល្លារ ដែល មាន ទំហំ តិច ជាង ក្រុង ព្រះសីហនុ តែ ប្រវែង ផ្លូវ ក៏ ខ្លី ជា ផ្លូវ ល្បឿន លឿន ក្រុង ព្រះសីហនុ ផងដែរ ផ្លូវ នេះ គ្រោង នឹង បើក ការដ្ឋាន នៅ ឆ្នាំ ២០២៣ និង បញ្ចប់ នៅ ចុង ឆ្នាំ ២០២៦ ឬ ដើម ឆ្នាំ ២០២៧» ។
ប្រធាន គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី ជំរុញ ដំណើរការ អនុវត្ត គម្រោង ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ ល្បឿន លឿន ពី ភ្នំពេញ ទៅ ក្រុង បាវិត នេះ បាន បន្ថែម ទៀត ថា ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត និង ធ្វើឱ្យ បាន រួចរាល់ ដំណាល នឹង ផ្លូវ ល្បឿន លឿន ពី ក្រុង ហូជីមិញ មក ម៉ុក បៃ ដើម្បី ធ្វើ ការតភ្ជាប់ ជាមួយ ផ្លូវ ល្បឿន លឿន របស់ កម្ពុជា ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ផ្លូវ ល្បឿន លឿន នេះ មាន សារៈសំខាន់ ណាស់ ក្នុង ការតភ្ជាប់ ពី ប្រទេស ចិន មក ភូមា មក ថៃ មក កម្ពុជា និង តទៅ ប្រទេស វៀតណាម តាមរយៈ ផ្លូវ អាស៊ាន លេខ ១ ដែល កម្ពុជា កំពុងតែ ចាប់ផ្តើម ពង្រីក ពី ២គន្លង ទៅ ៤គន្លង ពី ក្រុង ប៉ោយប៉ែត មក ភ្នំពេញ និង តភ្ជាប់ ពី ភ្នំពេញ ទៅ បាវិត តាម ផ្លូវ ល្បឿន លឿន ខ្សែ ទី២នេះ ដើម្បី ធ្វើឱ្យ ទំនាក់ទំនង ទំនិញ និង អ្នកដំណើរ តាំងពី ចិន រហូតដល់ វៀតណាម អាច ឆ្លងកាត់ បាន ។
