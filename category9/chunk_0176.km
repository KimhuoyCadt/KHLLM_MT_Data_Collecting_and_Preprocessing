( ភ្នំពេញ ) ៖ លោក ផាន សុភ័ក្រ ម្ចាស់ មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម កសិកម្ម កម្ពុជា ( ផ្សារ សុភ័ក្រមិត្ត ) បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
លោក ផាន សុភ័ក្រ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ លោកស្រី អ៊ុច សុខា អគ្គ នាយក ក្រុមហ៊ុន អិល អេស ខន ស្ត្រាក់ សិន បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
លោកស្រី អ៊ុច សុខា ដូម៉ានេត្រ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ថ្ងៃស្អែក នេះ ពេញ មួយ ថ្ងៃ ក្រុមហ៊ុន ធំ ៗ ចំនួន ៨ នឹង ផ្តល់ ឱកាស ការងារ សរុប ចំនួន ៧១៧ កន្លែង ដល់ យុវជន សិស្ស / និស្សិត និង អ្នក កំពុង ស្វែងរក ការងារ ធ្វើ ក្នុង វេទិកា ការងារ ដែល រៀបចំ ដោយ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ (NEA) នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ សហការ ជាមួយ សហភាព សហព័ន្ធ យុវជន កម្ពុជា វិស័យ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
ចំពោះ សិស្ស / និស្សិត និង អ្នក កំពុងតែ ស្វែងរក ការងារ ធ្វើ ឬ ចង់ ផ្លាស់ប្តូរ ការងារ អាច យក ប្រវត្តិ រូប សង្ខេប (CV) ដើម្បី ចូលរួម ដាក់ពាក្យ និង សម្ភាស ផ្ទាល់ ភ្លាម ៗ ជាមួយ តំណាង ក្រុមហ៊ុន ទាំងនោះ បាន ចាប់ពី ម៉ោង ៨:០០ ព្រឹក ដល់ ម៉ោង ០៥ :០០ ល្ងាច នៅក្នុង បរិវេណ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
លោកស្រី វង វណ្ណារី មន្ត្រី ជ្រើសរើស បុគ្គលិក ជាន់ ខ្ពស់ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ AMK លើកឡើង ថា កន្លងមក AMK បាន សហការ ជាមួយ NEA ជាច្រើន លើក មក ហើយ ក្នុង ការជ្រើសរើស បុគ្គលិក ហើយក៏ បាន ចូលរួម ពិព័រណ៌ ការងារ ថ្នាក់ ជាតិ កន្លងមក ផងដែរ ។ កញ្ញា ចាត់ទុក NEA ជា ស្ថានប័ន រដ្ឋ មួយ ដ៏ សំខាន់ សម្រាប់ ជួយ ដល់ និយោជក និង និយោជិត ជួបគ្នា ហើយក៏ ជា កន្លែង សម្រាប់ អ្នក មាន បំណង ផ្លាស់ប្តូរ ការងារ អាច ផ្លាស់ប្តូរ ការងារ ផងដែរ ។
វេទិកា ការងារ នេះ ក៏ នឹង ត្រូវបាន អនុវត្ត យ៉ាង ម៉ត់ចត់ នូវ វិធានការណ៍ បង្ការ អនាម័យ ស្រប តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៣ការពារ ៣កុំ ដើម្បី ទប់ស្កាត់ ការឆ្លង និង រីករាល នៃ ជំងឺ កូវីដ - ១៩ ដើម្បី អាច ធានា បាន នូវ សុវត្ថិភាព និង ទំនុកចិត្ត ក្នុង ការជ្រើសរើស កម្លាំង ពលកម្ម និង ទទួលបាន ឱកាស ការងារ សម្រាប់ ភាគី និយោជក និង អ្នក ស្វែងរក ការងារ ។
លោក តូមីតា បាន គូសបញ្ជាក់ ថា « ចំណុច ដែល អ្នក បាន លើកឡើង គឺជា រឿង មួយ ដែល យើង កំពុង ធ្វើ ការ លើ ការពង្រឹង ភាពជាដៃគូ របស់ យើង ។ ខ្ញុំ ពិតជា មិន ទាន់ បាន ឮ ការបញ្ជាក់ ចុងក្រោយ ណាមួយ ទេ ប៉ុន្តែ យើង កំពុង ធ្វើ ការងារ ដើម្បី ឆ្ពោះ ទៅរក ទិសដៅ នោះ ហើយ » ។ ជុំវិញ របាយការណ៍ នេះ អង្គការ ណា តូ ក៏ មិន បាន បញ្ជាក់ ពី ព័ត៌មាន ណាមួយ ដែរ ដោយ គ្រាន់តែ និយាយ ថា មិន អាច លម្អិត នូវ ការពិភាក្សា ដែល កំពុង បន្ត របស់ សម្ព័ន្ធមិត្ត នោះ ទេ ។
គួរ បញ្ជាក់ ថា លោក តូមី តា ដែល កំពុង ធ្វើ សន្និសីទ សង្ខេប អំពី កិច្ចប្រជុំ កំពូល G7 នៅ ទីក្រុង ហ៊ីរ៉ូស៊ីម៉ា ចាប់ពី ថ្ងៃទី ១៩ ដល់ ថ្ងៃទី ២១ ខែឧសភា បាន អះអាង ថា កិច្ចប្រជុំ ដែល កំពុង ប្រព្រឹត្តិ ទៅ នេះ គឺ ស្វែងរក កិច្ចសហប្រតិបត្តិការ កាន់តែ ជិតស្និទ្ធ លើ វិធីសាស្រ្ត ខ្ទប់ ឥទ្ធិពល ចិន ៕
ក្រុមប្រឹក្សា សវនកម្ម សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី វាយតម្លៃ ខ្ពស់ ចំពោះ ការរៀបចំ ព្រឹត្តិការណ៍ ប្រកួត កីឡា ស៊ីហ្គេម ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ បាន យ៉ាង ល្អ ឥត ខ្ចោះ និង ផ្ដល់ ភាពទាក់ទាញ ខាង ទេសចរណ៍
( ភ្នំពេញ ) ៖ លោកស្រី បណ្ឌិត អ៊ីស្មា យ៉ាទុន ប្រធាន ក្រុមប្រឹក្សា សវនកម្ម សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការរៀបចំ ព្រឹត្ដិការណ៍ ប្រកួត អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ ឆ្នាំ ២០២៣ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ បាន រៀបចំ យ៉ាង ល្អ ឥត ខ្ចោះ ដែល ផ្ដល់ ភាពទាក់ទាញ ខាង ទេសចរណ៍ ដើម្បី ដើម្បី រួមចំណែក អភិវឌ្ឍ កម្ពុជា ។
ការថ្លែង បែប នេះ របស់ លោកស្រី ក្នុង ឱកាស តប តាម ការអញ្ជើញ របស់ លោកស្រី បណ្ឌិត សោម គីម សួគ៌ អគ្គ សវនករ នៃ អាជ្ញាធរ សវនកម្ម ជាតិ កម្ពុជា ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ មក បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ កម្ពុជា ចាប់ពី ថ្ងៃទី៥ ដល់ ថ្ងៃទី ៩ ខែឧសភា ឆ្នាំ ២០២៣ ។
ក្នុង ឱកាស នៃ ដំណើរទស្សនកិច្ច ផ្លូវការ នេះ លោកស្រី បណ្ឌិត អ៊ីស្មា យ៉ាទុន និង គណៈប្រតិភូ បាន ចូលរួម ពិធី បើក ផ្លូវការ ព្រឹត្តិការណ៍ ប្រកួត កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ ឆ្នាំ ២០២៣ នៅ វិមាន កីឡាដ្ឋាន ពហុកីឡដ្ឋាន ជាតិ មរតក តេជោ និង បាន ទស្សនា កម្មវិធី ប្រកួត កីឡា នៅ វិមាន កីឡដ្ឋាន ពហុកី ទ្បដ្ឋាន ជាតិ មរតក តេជោ និង ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក ព្រមទាំង ទស្សនា ទីកន្លែង សំខាន់ ៗ របស់ រាជធានី ភ្នំពេញ ផងដែរ ។
នៅក្នុង កិច្ចប្រជុំ ទ្វេ ភាគី អគ្គ សវនករ និង ប្រធាន ក្រុមប្រឹក្សា នៃ ស្ថាប័ន ទាំង ពីរ បាន ពិភាក្សា ផ្លាស់ប្តូរ និង ចែករំលែក ព័ត៌មាន ស្តីពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម នៃ ប្រទេស ទាំង ពីរ ជាពិសេស យុទ្ធសាស្រ្ត និង វិធានការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ។ ជាមួយគ្នា នេះ ភាគី ទាំង ពីរ ក៏ បាន ជម្រាប ជូន គ្នា ទៅ វិញ ទៅ មក អំពី វឌ្ឍនភាព ការងារ របស់ ស្ថាប័ន សវនកម្ម កំពូល នៃ ប្រទេស ទាំង ពីរ ។
ជាមួយគ្នា នេះ ស្ថាប័ន ទាំង ពីរ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការរួមចំណែក របស់ ស្ថាប័ន ទាំង ពីរ ចំពោះ ស្ថាប័ន សវនកម្ម កំពូល អាស៊ាន (ASEANSAI) ដែល អាជ្ញាធរ សវនកម្ម ជាតិ បាន ទទួល ធ្វើជា ប្រធាន កាលពី ឆ្នាំ ២០១៦ ដល់ ឆ្នាំ ២០១៧ និង ក្រុមប្រឹក្សា សវនកម្ម សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី បាន ដឹកនាំ និង ទទួលបន្ទុក លេខាធិការដ្ឋាន ASEANSAI ចាប់តាំងពី ឆ្នាំ ២០១១ រហូតដល់ បច្ចុប្បន្ន ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា សុះ កុំ រី ចាងហ្វាង គណៈ ដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា អ៉ី ស្លាម កម្ពុជា នៅ ថ្ងៃទី ១០ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការរៀបចំ ពិធី សូត្រ គម្ពីរ អាល់ គួរ អានុល ការីម លើក ទី៣០ និង ការសូត្រ ចាំ មាត់ លើក ទី៤ ថ្នាក់ ជាតិ ឆ្នាំ ២០២៣ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃសៅរ៍ - អាទិត្យ ថ្ងៃទី ២០ - ២១ ខែឧសភា ឆ្នាំ ២០២៣ នៅ វិហារ ធំ ឥស្លាម គីឡូ មែ៉ត្រ លេខ ៩ អាសយដ្ឋាន៖ ភូមិ ៣ សង្កាត់ ច្រាំង ចំរេះទី១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។
លោក ឈិន បាន បន្ថែម ទៀត ថា « ចិន មាន ឆន្ទៈ រក្សា ទំនាក់ទំនង ជាមួយ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ក្នុង នោះ រួម មាន ទាំង អាល្លឺម៉ង់ ដើម្បី ស្វែងរក បទ ឈប់ បាញ់ » ។
គួរ បញ្ជាក់ ថា នៅក្នុង សនិ្នសីទ សារព័ត៌មាន រួមគ្នា នោះ លោកស្រី បែរ បុក ក៏ បាន បង្ហាញ ការស្វាគមន៍ ផងដែរ ចំពោះ កិច្ចសន្ទនា តាម ទូរស័ព្ទ រវាង លោក ប្រធានាធិបតី ចិន ស៊ី ជិន ពីង និង លោក ប្រធានាធិបតី អ៊ុយក្រែន វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី កាលពី ពេល ថ្មី ៗ នេះ ។ ប៉ុន្តែ ក្នុង ពេល ដំណាល គ្នា លោកស្រី យល់ ថា ទីក្រុង ប៉េកាំង គួរតែ បង្ហាញ ការគាំទ្រ ត្រង់ ៗ ដល់ អធិបតេយ្យ និង បូរណភាព ទឹកដី របស់ អ៊ុយក្រែន ៕
ភាពចលាច ល និង អំពើហិង្សា ដ៏ បង្ហូរ ឈាម នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា បាន ក្លាយជា ប្រធានបទ ក្ដៅ មួយ នៅឯ កិច្ចប្រជុំ កំពូល អាស៊ាន ក្នុង ប្រទេស ឥណ្ឌូណេស៊ី នៅក្នុង សប្ដាហ៍ នេះ ស្រប ពេល ប្លុក មួយ នេះ កំពុង ប្រឈមមុខ នឹង ការរិះគន់ ជុំវិញ ការដោះស្រាយ វិបត្តិ នៅ មីយ៉ាន់ម៉ា ។ អាស៊ាន បាន ដឹកនាំ កិច្ច ខិតខំ ប្រឹងប្រែង ស្វែងរក ដំណោះស្រាយ នយោបាយ បញ្ចប់ ជម្លោះ ប៉ុន្តែ ការប្រឹងប្រែង មិន ទាន់ សម្រេចបាន នូវ លទ្ធផល ផ្លែ ផ្កា នៅឡើយ ទេ ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ មេដឹកនាំ អាស៊ាន បាន គូសបញ្ជាក់ ដូច្នេះ ថា « យើង មាន ការព្រួយបារម្ភ ជាខ្លាំង ចំពោះ អំពើហិង្សា កំពុង កើតឡើង នៅ មីយ៉ាន់ម៉ា ហើយ ជំរុញ ឱ្យ បញ្ឈប់ អំពើ ហិង្សា គ្រប់ ទម្រង់ ទាំងអស់ រួមទាំង ការប្រើប្រាស់ កម្លាំង បាយ ដើម្បី បង្កើត បរិយាកាស អំណោយផល មួយ សម្រាប់ សុវត្ថិភាព និង សម្រួល ដល់ ការផ្ដល់ ជំនួយ មនុស្សធម៌ ក៏ ដូចជា កិច្ចសន្ទនា ប្រកបដោយ បរិយា បន្ន » ។
គួរ បញ្ជាក់ ថា ការដាក់ សម្ពាធ លើ របប សឹក មីយ៉ាន់ម៉ា ពីសំណាក់ អាស៊ាន បាន កើនឡើង ជាថ្មី កាលពី ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ នៅ ក្រោយ ក្បួន រថយន្ដ ដឹក មន្ត្រី ទូត និង ក្រុម មន្ត្រី អាស៊ាន ដឹកនាំ ការសម្របសម្រួល ផ្ដល់ ជំនួយ មនុស្សធម៌ ក្នុង ប្រទេស មីយ៉ាន់ម៉ា ។ នៅក្នុង សេចក្ដីថ្លែងការណ៍ ខាង លើ អាស៊ាន ក៏ បាន ថ្កោលទោស ការវាយប្រហារ នេះ ដែរ ហើយ ថា អ្នក ដែល នៅ ពី ក្រោយ ការវាយប្រហារ នេះ នឹង ត្រូវតែ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង និង ផ្តល់ ឋានៈ ទីប្រឹក្សា ក្រសួង ព្រះបរម រាជ វាំង ៣រូប មាន ឋានៈ ស្មើ អគ្គ នាយក
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង និង ផ្តល់ ឋានៈ ទីប្រឹក្សា ក្រសួង ព្រះបរម រាជ វាំង ៣រូប មាន ឋានៈ ស្មើ អគ្គ នាយក ។ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១០ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ៕
គ.ជ. ប ចេញ សេចក្ដីណែនាំ ពី កិច្ចសហការ ការងារ សន្តិសុខ សុវត្ថិភាព និង សណ្ដាប់ធ្នាប់ សាធារណៈ សម្រាប់ ដំណើរការបោះឆ្នោត
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន ចេញ សេចក្ដីណែនាំ ស្ដីពី កិច្ចសហការ ការងារ សន្តិសុខ សុវត្ថិភាព និង សណ្ដាប់ធ្នាប់ សាធារណៈ សម្រាប់ ដំណើរការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ៕
គួរ បញ្ជាក់ ថា ចក្រភព អង់គ្លេស កាលពី ពេល ថ្មី ៗ នេះ បាន ព្រមាន ចិន ប្រឆាំង នឹង ការប្រើប្រាស់ កម្លាំង យោធា លើ តៃវ៉ាន់ ។ ប៉ុន្តែ ខាង ក្រសួង ការបរទេស ចិន ក៏ បាន ក្រើន រំឮក ទៅ វិញ ដែរ ថា ការគំរាមកំហែង ធំ បំផុត ដល់ សន្តិភាព ក្នុង តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ គឺជា សកម្មភាព ផ្ដាច់ ខ្លួន របស់ ចលនា ទាមទារ ឯករាជ្យ ឱ្យ តៃវ៉ាន់ និង បរទេស មួយចំនួន ដែល គាំទ្រ ចលនា នេះ ៕
ក្រសួង ធនធាន ទឹក ជូនដំណឹង ពី ស្ថានភាពធាតុអាកាស ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៦ ខែឧសភា . អាច មាន ភ្លៀង ពី តិច ទៅ បង្គួរ លាយឡំ ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ស្ដីពី ស្ថានភាពធាតុអាកាស ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២៣ ។
ក្រសួង បញ្ជាក់ ថា អំឡុង សប្តាហ៍ នេះ ព្រះរាជាណាចក្រ កម្ពុជា នឹង ទទួល នូវ ឥទ្ធិពល ជ្រលង សម្ពាធ ទាប ពី ភាគ ខាងជើង ប្រទេស និង ខ្យល់ មូសុង និរតី ក្នុង កម្រិត ខ្សោយ ។ លក្ខណ បែប នេះ នឹង ធ្វើ ឲ្យ៖
