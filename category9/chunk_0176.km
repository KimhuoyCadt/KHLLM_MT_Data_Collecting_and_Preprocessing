( ភ្នំពេញ ) ៖ នា ព្រឹក ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ ក្រុមហ៊ុន វៀត ធេល កម្ពុជា ( មិត្តហ្វូន ) បាន បរិច្ចាគ ថវិកា ចំនួន ១០ម៉ឺន ដុល្លារ ជូន កាកបាទ ក្រហម កម្ពុជា ។ នេះ ជា សកម្មភាព ប្រចាំ ឆ្នាំ របស់ មិត្តហ្វូន ដែល មាន បំណង ចែករំលែក អម ដំណើរ និង នាំមក នូវ គុណ តម្លៃ ល្អ ដល់ ប្រជាជន និង ប្រទេស កម្ពុជា ។
វត្តមាន ចូលរួម នៃ ពិធី ប្រគល់ ប្រាក់ ឧបត្ថម្ភ នេះ មាន តំណាង ក្រុមហ៊ុន មិត្តហ្វូន និង តំណាង កាកបាទ ក្រហម កម្ពុជា ។ នេះ ជា សកម្មភាព ប្រចាំ ឆ្នាំ នៃ ដំណើរការ អាជីវកម្ម ហើយ យើង និង បន្ត ឧបត្ថម្ភ និង អម ដំណើរ សកម្មភាព សហគមន៍ ជាច្រើន ទៀត ក្នុង ប្រទេស កម្ពុជា ។
ឆ្លើយតប នឹង មនោសញ្ចេតនា របស់ ក្រុមហ៊ុន មិត្តហ្វូន ភាគី កាកបាទ ក្រហម បាន ទទួលស្គាល់ និង កោតសរសើរ ចំពោះ ការគាំទ្រ របស់ មិត្តហ្វូន ចំពោះ កាកបាទ ក្រហម ។ ការគាំទ្រ របស់ មិត្តហ្វូន ក្នុង រយៈពេល ជាច្រើន ឆ្នាំ បាន រួមចំណែក យ៉ាង សំខាន់ ដល់ ការងារ សប្បុរសធម៌ និង សកម្មភាព សហគមន៍ ដើម្បី ជា ប្រយោជន៍ ដល់ មនុស្សជាតិ ។ ទន្ទឹម នឹង នោះ ក៏ បង្កើត លក្ខខណ្ឌ ឲ្យ កាកបាទ ក្រហម មាន ថវិកា បន្ថែម ទៀត ដើម្បី រៀបចំ កម្មវិធី ជាច្រើន ដើម្បី បម្រើ ប្រយោជន៍ សម្រាប់ ប្រជាជន និង ប្រទេស កម្ពុជា ។
មិត្តហ្វូន គឺជា អាជីវកម្ម មួយ ក្នុង ចំណោម អាជីវកម្ម ដែល បាន ចូលរួមចំណែក ច្រើន ជាង គេ របស់ រដ្ឋាភិបាល កម្ពុជា ជាមួយនឹង ចំនួន ទឹកប្រាក់ ជិត ១ ពាន់ លាន ដុល្លារ អាមេរិក ។ ក្រៅពី ការរួមចំណែក ដល់ កាកបាទ ក្រហម មិត្តហ្វូន ក៏ បាន ចូលរួម សកម្មភាព សង្គម ជាច្រើន ទៀត ផងដែរ ដូចជា ការជួយ ឧស្សាហ៍កម្ម ផ្នែក បច្ចេកវិទ្យា ឧបត្ថម្ភ កីឡា សហគមន៍ និង សកម្មភាព ជួយ សង្គម ជាមួយនឹង តួលេខ ច្រើន ជាង ១០០ លាន ដុល្លារ ។
ជាពិសេស មិត្តហ្វូន តែងតែ បង្ហាញ តួនាទី ត្រួសត្រាយ របស់ ខ្លួន ក្នុង បម្លាស់ ប្តូរ ឌីជីថល សម្រាប់ រដ្ឋាភិបាល សហគមន៍ ធុរកិច្ច និង សង្គម កម្ពុជា តាមរយៈ ការប្រឹក្សា គាំទ្រ និង អម ដំណើរ រដ្ឋាភិបាល ធុរកិច្ច និង ប្រជាជន កម្ពុជា ដើម្បី អនុវត្ត ការប្រើប្រាស់ បច្ចេកវិទ្យា ឌីជីថល និង ដំណោះស្រាយ ឌីជីថល ដើម្បី បម្រើ គ្រប់ សកម្មភាព របស់ សង្គម ៕
( ភ្នំពេញ ) ៖ ក្រុម យុវជន ដែល ធ្លាប់ តែ គាំទ្រ សកម្មភាព របស់ បក្ស ប្រឆាំង នោះ បាន ចេញមុខ អំពាវនាវ ប្រជាពលរដ្ឋ ខ្មែរ ជាពិសេស យុវជន ឱ្យ ឈប់ ជឿ តាម កល នយោបាយ របស់ ជន ក្បត់ ជាតិត ជំនាន់ សម រង្ស៉ី នាំ គ្រោះថ្នាក់ ដល់ ខ្លួន និង ជាតិ ទាំងមូល ។
លោក ម៉ៅ ស៊ី ថា ប្រធាន បណ្តាញ យុវជន ខ្មែរ មហានគរ និង លោក ធូវី សុវណ្ណារ៉ា អនុប្រធាន បណ្តាញ យុវជន ខ្មែរ មហានគរ និង ជា ក្មួយ បង្កើត របស់ លោក កែម ឡី គឺជា យុវជន ដែល ធ្លាប់ តែ ធ្វើ សកម្មភាព គាំទ្រ បក្ស ប្រឆាំង ជាពិសេស អតីត គណបក្ស សង្គ្រោះ ជាតិ ។
នៅ ពេល នេះ ពួកគេ បាន ផ្លាស់ប្តូរ ទស្សនៈ ពី ការគាំទ្រ បក្ស ប្រឆាំង មក គាំទ្រ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា វិញ ។ ជាមួយនឹង ការផ្លាស់ប្តូរ ទស្សនៈ មក គាំទ្រ រាជ រដ្ឋាភិបាល ពួកគេ បាន ធ្វើ វីដេអូ រួមគ្នា ដោយ លើក បង្ហាញ ពី មូលហេតុ ដែល នាំឱ្យ ពួកគេ គាំទ្រ បក្ស ប្រឆាំង នា ពេល កន្លងមក ។
លោក ម៉ៅ ស៊ី ថា បាន អះអាង ថា ការ ដែល ពួកគេ គាំទ្រ បក្ស ប្រឆាំង នា ពេល កន្លងទៅ ដោយសារ ចាញ់ កល នយោបាយ និង មនោគម វិជ្ជា របស់ ជន ក្បត់ ជាតិត ជំនាន់ សម រង្ស៉ី ។
លោក ម៉ៅ ស៊ី ថា ក៏ បាន លើក ពី មូលហេតុ នាំឱ្យ ពួកគេ ប្តូរ មក គាំទ្រ រាជ រដ្ឋាភិបាល ផងដែរ ។ បើ តាម លោក ម៉ៅ ស៊ី ថា ការណ៍ ដែល ពួក គមក គាំទ្រ រាជ រដ្ឋាភិបាល ដោយសារតែ ពួកគេ មើលឃើញ ច្បាស់ ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ប៉ុណ្ណោះ អាច ធានា បាន នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ នៅ កម្ពុជា ។
ទន្ទឹម គ្នា នេះ ក្រុម យុវជន ដែល ធ្លាប់ គាំទ្រ បក្ស ប្រឆាំង ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ជាពិសេស យុវជន ឈប់ ចាញ់ កល នយោបាយ របស់ ជន ក្បត់ ជាតិត ជំនាន់ សម រង្ស៉ី ដែល អាច នាំឱ្យ ជាតិ ជួប វិនាសកម្ម ៕
តើ អាមេរិក និង វៀតណាម មាន ប្រវត្តិ ទំនាក់ទំនង ដូចម្តេច ? តើ ហេតុ អ្វី អាមេរិក សេរី និង វៀតណាម កុម្មុយនីស្ត ដែល ធ្លាប់ ជា សត្រូវ នឹង គ្នា បាន ក្លាយទៅជា មិត្ត នឹង គ្នា និង ព្យាយាម បង្កើន ភាព ស្អិត រមួត ?
១៖ លោក បណ្ឌិត យង់ ពៅ អគ្គ លេខាធិការ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា និង ជា អ្នកជំនាញ វិទ្យាសាស្ត្រ នយោបាយ
២៖ លោក ម៉ារ យ៉ារិទ្ធ អ្នកជំនាញ សារព័ត៌មាន ជើង ចាស់ និង ជា អ្នកតាមដាន ព្រឹត្តិការណ៍ អន្តរជាតិ
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា បណ្ឌិត ទ្រី ភាព និង លោកជំទាវ អ្នក ឧកញ៉ា គៀន ស្រី នាង បាន បរិច្ចាគ ថវិកា ចំនួន ៣០ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
អ្នក ឧកញ៉ា បណ្ឌិត ទ្រី ភាព និង លោកជំទាវ អ្នក ឧកញ៉ា គៀន ស្រី នាង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោកជំទាវ ឧកញ៉ា តាំង ឈុន នី អគ្គ នាយិកា ក្រុមហ៊ុន លី ឃី ហ៊ួត បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ លោកជំទាវ ឧកញ៉ា តាំង ឈុន នី អគ្គ នាយិកា ក្រុមហ៊ុន លី ឃី ហ៊ួត បាន បរិច្ចាគ ថវិកា ចំនួន ២ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
លោកជំទាវ ឧកញ៉ា តាំង ឈុន នី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម សារ៉ាក់ ខាន់ រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្តម សារ៉ាក់ ខាន់ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សូម កុំ ធ្វើឱ្យ សាច់ញាតិ ជនរងគ្រោះ ស្រក់ ទឹកភ្នែក ដោយសារ ការបើកបរ របស់ អ្នក ! ស្លាប់ ៣នាក់ និង របួស ៧នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២១ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ៧នាក់ ។
គួរ បញ្ជាក់ ថា ចាប់ពី ថ្ងៃសៅរ៍ ស្អែក នេះ តទៅ ជន មូស្លីម ទំាង អស់ អាច បរិភោគ បាន ធម្មតា ឡើងវិញ ៕
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ១៖ របាយការណ៍៖ ឥទ្ធិពល របស់ ចិន ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ វ៉ា ដាច់ សហរដ្ឋ អាមេរិក
៣៖ កូរ៉េ ខាងជើង ប្រាប់ G7 ថា នឹង បន្ត ពង្រឹង សមត្ថភាព យោធា រហូត ទាល់តែ ការគំរាមកំហែង ពី អាមេរិក ត្រូវបាន លុបបំបាត់
៤៖ យន្តហោះ ចម្បាំង រុស្ស៉ី បាញ់ ទម្លាក់ គ្រាប់ ដោយ ចៃដន្យ ចូលក្នុង តំបន់ ក្បែរ ព្រំដែន អ៊ុយក្រែន
២៖ ប្រេង ឆៅ ធ្លាក់ ថ្លៃ ដោយសារ ការភ័យខ្លាច នៃ ការដើរ ថយ ក្រោយ សេដ្ឋកិច្ច និង តម្រូវការ ទាប
៣៖ លោក យឹម ស៊ីណន បង្ហាញ ការឈឺចាប់ ជា ទីបំផុត ចំពោះ ទង្វើ របស់ ក្រុម ប្រឆាំង និង គោរព ស្នើសុំ សម្តេច តេជោ ហ៊ុន សែន ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា
៤៖ ម៉ាឡេស៊ី រិះគន់ ច្បាប់ ស្តីពី ការកាប់បំផ្លាញ ព្រៃឈើ របស់ សហភាព អឺរ៉ុប ថា « អយុត្តិធម៌ »
៥៖ សម្តេច តេជោ ហ៊ុន សែន ស្វាគមន៍ ចំពោះ លោក យឹម ស៊ីណន ដែល ស្នើសុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន ហើយ សង្ឃឹម ថា នឹង ក្លាយជា ធនធាន មនុស្ស របស់ គណបក្ស ដ៏ មាន តម្លៃ
៦៖ របាយការណ៍៖ លោក ចូ បៃ ដិន គ្រោង ប្រកាស ជា ផ្លូវការ អំពី ការបន្ត ឈ្មោះ សម្រាប់ ការបោះឆ្នោត ឆ្នាំ ២០២៤ នៅ សប្តាហ៍ ក្រោយ
៧៖ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត នឹង បើក ការដ្ឋាន សាងសង់ នៅ ថ្ងៃទី ៧ ខែមិថុនា
៨៖ រដ្ឋមន្រ្តី ការបរទេស ចិន៖ ត្រើយ ទាំង សងខាង នៃ ច្រក សមុទ្រ តៃវ៉ាន់ គឺជា កម្មសិទ្ធិ របស់ ប្រទេស ចិន
៩៖ ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ ថុល៖ នៅ មាន យានយន្ត ជាង ១៥ម៉ឺន គ្រឿង មិន ទាន់ បាន មក ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស ( ឆៀក )
១០៖ លោក ហ្សេលេន ស្គី ស្នើ ម៉ិក ស៉ិក ដាក់បញ្ចូល ផែនការ សន្តិភាព របស់ អ៊ុយក្រែន ទៅក្នុង កិច្ចប្រជុំ មេដឹកនាំ អាមេរិក ឡាទីន
១១៖ សម្ដេច តេជោ នឹង ទទួលគោរមងារ ជា « ពុទ្ធ មាម កាភិបាល នៃ អង្គការ ពុទ្ធ សាសនិក ពិភពលោក » ពី អង្គការ ពុទ្ធ សាសនិក ពិភពលោក និង « បណ្ឌិត កិត្តិយស ផ្នែក មនុស្សសាស្ត្រ » ពី សាកលវិទ្យាល័យ ណេហ្គរី ប៉ាដាន នៅ ដើម ខែ ក្រោយ
១៣៖ កូរ៉េ ខាងជើង ប្រាប់ G7 ថា នឹង បន្ត ពង្រឹង សមត្ថភាព យោធា រហូត ទាល់តែ ការគំរាមកំហែង ពី អាមេរិក ត្រូវបាន លុបបំបាត់ ឮ
១៤៖ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ឧបត្ថម្ភ ថវិកា ៣ម៉ឺន ដុល្លារ អាមេរិក ដល់ តារា សម្តែង បញ្ញា សិទ្ធ ដើម្បី ព្យាបាល ម្តាយ
១៥៖ របាយការណ៍៖ ឥទ្ធិពល របស់ ចិន ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ វ៉ា ដាច់ សហរដ្ឋ អាមេរិក
១៦៖ រដ្ឋមន្ត្រី ក្រសួង រតនាគារ អាមេរិក ថា សហរដ្ឋ អាមេរិក ស្វែងរក « ការប្រកួតប្រជែង ល្អ » ជាមួយ ប្រទេស ចិន
១៧៖ កូឡុំប៊ី នៅតែ បដិសេធ បញ្ជូន អាវុធ ទៅ អ៊ុយក្រែន ក្រោយ ជួប លោក បៃ ដិន
២០៖ វិភាគ អន្តរជាតិ៖ ឈ្នះ ឬ ចាញ់ ! ប្រតិបត្តិការ វាយ បក របស់ អ៊ុយក្រែន នឹង ធ្វើឱ្យ សហរដ្ឋ អាមេរិក ឈឺ ក្បាល
២៖ ក្រុម ផលិត ករ ភាពយន្ត រុស្ស៉ី ផ្តួល គម្រោង របស់ ហូលីវូដ ក្រោយ បញ្ចេញ ភាពយន្ត ដំបូង គេ ថត នៅ ទី អវកាស
រដ្ឋមន្ត្រី ការងារ៖ កម្ពុជា កំពុង រៀបចំ គោល នយោបាយ ជាតិ គាំពារ សង្គម ឆ្នាំ ២០៣០ ( ជំហាន ទី២)
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម ដែល មាន ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ចំនួន ១២ ជា សមាជិក កំពុង រៀបចំ គោល នយោបាយ ជាតិ គាំពារ សង្គម ឆ្នាំ ២០៣០ ដែល នឹង ក្លាយជា ជំហាន ទី២ នៃ គោល នយោបាយ នេះ ក្នុង ការអនុវត្ត កម្មវិធី ជាតិ ជំនួយ សង្គម និង របប សន្តិសុខ សង្គម ។
គួរ ជម្រាប ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ រួច មកហើយ នូវ ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ២០១៦ - ២០២៥ ( ជំហាន ទី១ ) ដោយ បាន ជួយ លើកស្ទួយ សន្តិសុខ ប្រាក់ ចំណូល របស់ ប្រជាពលរដ្ឋ តាមរយៈ ការអនុវត្ត កម្មវិធី ជាតិ ជំនួយ សង្គម និង របប សន្តិសុខ សង្គម ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ។
ការណ៍ នេះ ត្រូវបាន ឱ្យដឹង ក្នុង ជំនួប ទទួល ជួប សម្តែង ការគួរសម ផ្តល់ ធាតុ ចូល និង អនុសាសន៍ សំខាន់ ៗ ដល់ ក្រុមការងារ បច្ចេកទេស រៀបចំ ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ២០៣០ នា រសៀល ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព លោក អ៉ិត សំហេង រដ្ឋមន្រ្តី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
នា ជំនួប នោះ លោក ចន ណារិទ្ធ អនុ រដ្ឋលេខាធិការ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម បាន ឱ្យដឹង ថា ការអភិវឌ្ឍ ប្រព័ន្ធ គាំពារ សង្គម ជា កក្តា ដ៏ សំខាន់ ដើម្បី សម្រេចបាន នូវ កំណើន សេដ្ឋកិច្ច ប្រកបដោយ សមធម៌ និង បរិយា បន្ន ។
លោក អនុ រដ្ឋលេខាធិការ បាន បន្ត ថា ឈរ លើ មូលដ្ឋាន នៃ ស្ថិរភាព នយោបាយ ម៉ាក្រូ សេដ្ឋកិច្ច និង វឌ្ឍនភាព ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ នូវ ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ២០១៦ - ២០២៥ ដោយ បាន ជួយ លើកស្ទួយ សន្តិសុខ ប្រាក់ ចំណូល របស់ ប្រជាពលរដ្ឋ តាមរយៈ ការអនុវត្ត កម្មវិធី ជាតិ ជំនួយ សង្គម និង របប សន្តិសុខ សង្គម ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ។
លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង បាន វាយតម្លៃ ថា ប្រព័ន្ធ គាំពារ សង្គម នេះ គឺ មាន សារសំខាន់ ណាស់ សម្រាប់ ប្រជាពលរដ្ឋ និង ប្រទេសជាតិ ទាំងមូល និង បាន ស្នើ ឱ្យ ក្រុមការងារ បច្ចេកទេស រៀបចំ ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ២០៣០ គិតគូរ ធ្វើឱ្យ ប្រព័ន្ធ សន្តិសុខ សង្គម និង ប្រព័ន្ធ ជំនួយ សង្គម មាន ភាព ឆ្លើយឆ្លង គ្នា តាម តម្រូវការ របស់ ប្រជាពលរដ្ឋ ដើម្បី គាំពារ ប្រជាពលរដ្ឋ តាម វដ្ត ជីវិត ចាប់តាំងពី ចាប់កំណើត រហូតដល់ មរណភាព ។
លោក រដ្ឋមន្រ្តី ក៏ បាន បង្ហាញ ការគាំទ្រ និង បន្ត សហការ ផ្ដល់ ធាតុ ចូល ចាំបាច់ នានា ដើម្បីឱ្យ ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ជំហាន ទី២ ឱ្យ មាន ភាព គ្រប់ ជ្រុងជ្រោយ និង ពេញលេញ ពាក់ព័ន្ធ នឹង ប្រព័ន្ធ សន្តិសុខ សង្គម ដែល ក្រសួង ការងារ និង បណ្តុះបណ្តាល កំពុង អនុវត្ត ។
ក្រៅពី ផ្តល់ ធាតុ ចូល និង អនុសាសន៍ សំខាន់ ៗ ហើយ លោក អ៉ិត សំហេង ក៏ បាន កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម ដែល កន្លងមក បាន ចូលរួម ជួយ លើ ស្ទួយ ជីវភាព ប្រជាពលរដ្ឋ រក្សា ភាពធន់ របស់ ប្រជាពលរដ្ឋ កាន់ រឹងមាំ ទោះ ក្នុង កាលៈទេសៈ ណា ក៏ដោយ ។
ជំនួប នេះ បាន ធ្វើឡើង រយៈពេល ជាង ២ ម៉ោង នៅ គេហដ្ឋាន របស់ សម្តេច តេជោ នា ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ។
នៅក្នុង ជំនួប សម្តេច តេជោ បាន ណែនាំ និង ផ្តល់ អនុសាសន៍ ជាច្រើន សម្រាប់ លោក យឹម ស៊ីណន ដែល ជា អ្នកនយោបាយ វ័យ ក្មេង ។
ជំនួប នេះ បាន ធ្វើឡើង បន្ទាប់ពី លោក យឹម ស៊ីណន នៅ ព្រឹក ថ្ងៃទី ២១ ខែមេសា បាន បង្ហាញ សំណេរ នៅលើ បណ្តាញ សង្គម Facebook ជាមួយនឹង ពាក្យ ពេជន៍ ឈឺចាប់ ជា ទីបំផុត រក អ្វី ប្រៀបផ្ទឹម ពុំ បាន ដោយសារ ទង្វើ និង សកម្មភាព មិន ខ្វាយខ្វល់ របស់ ក្រុម ប្រឆាំង ទៅ លើ រូបលោក នៅពេល លោក ជាប់ ពន្ធនាគារ ។ ក្រៅពី បង្ហាញ ការឈឺចាប់ ឥត ឧបមា លោក យឹម ស៊ីណន បាន ប្រកាស គោរព ស្នើសុំ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា នាយក រដ្ឋមន្រ្តី ដើម្បី សូម ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក យឹម ស៊ីណន ធ្លាប់ ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន កាលពី ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ បន្ទាប់ពី បាន បង្ហោះ សារ បែប ញុះញង់ តាម បណ្តាញ សង្គម ពាក់ព័ន្ធ នឹង រូបភាព ព្រះមហាក្សត្រ ព្រះរាជ ទាន ព្រះអគ្គីជ័យ កីឡា សម្រាប់ ព្រឹត្តិការណ៍ ប្រកួត កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ឆ្នាំ ២០២៣ នៅ ខេត្ត សៀមរាប និង ត្រូវបាន តុលាការ ឃុំ ខ្លួន ផងដែរ ។
ក្រោយមក នៅ ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០២៣ លោក ត្រូវបាន ចៅក្រម ស៊ើបសួរ សាលាដំបូង រាជធានី ភ្នំពេញ បង្គាប់ ឲ្យ ដោះលែង បន្ទាប់ពី លោក បាន ចេញ វីដេអូ និង សរសេរ លិខិត មួយ សូម ព្រះរាជ ទាន ទោស ពី ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា និង សូម ទោស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ពាក់ព័ន្ធ នឹង សំណេរ ប្រមាថ លើ ហ្វេសប៊ុក ៕
អធិការដ្ឋាន នគរបាល ខណ្ឌ ទួលគោក ប្រគល់ ម៉ូតូ ៣ គ្រឿង ជូន ម្ចាស់ ដើម វិញ ក្រោយ រកឃើញ នៅ បន្ទប់ ជនសង្ស័យ ពេល ចុះ រដ្ឋបាល
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ ដោយ មាន ការអនុញ្ញាត ពី លោក វរសេនីយ៍ ឯក ស៊ឹម ពិសិដ្ឋ អធិការ នគរបាល ខណ្ឌ ទួលគោក កម្លាំង នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ទួលគោក បាន ធ្វើ ការប្រគល់ ម៉ូតូ ចំនួន ០៣ គ្រឿង ពាក់ព័ន្ធ ករណី លួច ដែល រកឃើញ នៅ ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២៣ ជូន ជនរងគ្រោះ ចំនួន ០៣ នាក់ វិញ ។
បច្ចុប្បន្ន ម៉ូតូ ចំនួន ០៣ គ្រឿង សមត្ថកិច្ច បាន ប្រគល់ជូន ជនរងគ្រោះ ទាំង ៣នាក់ ដើម្បី យក ទៅ ប្រើប្រាស់ ជា ប្រចាំ ថ្ងៃ វិញ ៕
( ស្ទឹងត្រែង ) ៖ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង នៅ ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការត្រៀម រៀបចំ ទទួល ព្រះអគ្គិជ័យ កីឡា នៅ ច្រកទ្វារ ព្រំដែន អន្តរជាតិ ត្រពាំង ក្រៀល និង ការរក្សាទុក ព្រះអគ្គិជ័យ កីឡា នៅ វត្ត ស្រះ កែវ មុនី វណ្ណ ( ហៅ វត្ត លើ ) សម្រាប់ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២៣ ។
រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង បាន គូសបញ្ជាក់ ថា ខេត្ត នឹង រៀបចំ ពិធី ទទួលស្វាគមន៍ អបអរសាទរ ព្រះអគ្គិជ័យ កីឡា ដែល នឹង ដង្ហែ ចូលមក តាម ច្រក ទ្វារ ព្រំដែន អន្តរជាតិ ត្រពាំង ក្រៀល ប្រព្រឹត្តទៅ នៅ ថ្ងៃព្រហស្បតិ៍ ៨កើត ខែពិសាខ ឆ្នាំ ថោះ បញ្ចស័ក ពុទ្ធ សករាជ ២៥៦៦ ត្រូវនឹង ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២៣ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ឆ្នាំ ២០២៣ នូវ ព្រឹត្តិការណ៍ ស៊ីហ្គេម លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ។
រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង សូម គោរព និមន្ត និង អញ្ជើញ មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ លោកគ្រូ អ្នកគ្រូ និស្សិត សិស្សានុសិស្ស ព្រះសង្ឃ និង ពុទ្ធ បរិស័ទ ប្រជាពលរដ្ឋ គ្រប់ ជនជាតិ ទូទាំង ខេត្ត ស្ទឹងត្រែង ចូលរួម ក្នុង ថ្ងៃ ពិធី ទទួលស្វាគមន៍ អបអរសាទរ ព្រះអគ្គិជ័យ កីឡា ឲ្យបាន ច្រើន កុះករ ដើម្បី ជា ការទទួលស្វាគមន៍ យ៉ាង កក់ក្ត នូវ ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ លើក ដំបូង របស់ ព្រះរាជាណាចក្រ កម្ពុជា ក្រោយ រយៈពេល ៦៤ ឆ្នាំ មក ហើយ ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែ ង៖ ចូរ ប្រាប់ មនុស្ស ជា ទី ស្រលាញ់ ពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២១ ខែ មេសា៖ បង្ក្រាប ១៤ករណី ឃាត់ខ្លួន ៤៧ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៤ករណី ក្នុង នោះ ករណី ដឹកជញ្ជូន រក្សាទុក ២ករណី . ជួញដូរ ៧ករណី . ចាត់ចែង សម្រួល ១ករណី និង ប្រេី ប្រាស់ ៤ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៤៧ នាក់ ។
ចំណេះដឹង ទូទៅ៖ សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក ក្នុង តំបន់ អាស៉ី អាគ្នេយ៍ ( វៀតណាម )
( ភ្នំពេញ ) ៖ យើងខ្ញុំ បាន លើក បង្ហាញ អំពី សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក នៅ ប្រទេស កម្ពុជា ឥណ្ឌូណេស៉ី ឡាវ ម៉ាឡេស៉ី មីយ៉ាន់ម៉ា ហ្វីលីពីន សិង្ហបុរី និង ថៃ ហើយ នៅ ថ្ងៃ នេះ យើងខ្ញុំ ចង់ លើក បង្ហាញ បន្ត អំពី សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក នៅ ប្រទេស វៀតណាម វិញ ម្ដង ។
គួរ ជម្រាប ថា ភូមិសាស្ត្រ តំបន់ បេតិកភណ្ឌ ពិភពលោក គឺ មិន ដូច ភូមិសាស្ត្រ ដែនដី ភូមិសាស្ត្រ នយោបាយ ឬ ភូមិសាស្ត្រ សេដ្ឋកិច្ច នោះ ឡើយ ដូច្នេះហើយ គណៈកម្មាធិការ បេតិកភណ្ឌ ពិភពលោក ក៏ បាន បែងចែក ភូមិសាស្ត្រ បេតិកភណ្ឌ ពិភពលោក ជា៥ តំបន់ ធំ ៗ រួម មាន៖ តំបន់ បេតិកភណ្ឌ អាហ្រ្វិក តំបន់ បេតិកភណ្ឌ អារ៉ាប់ តំបន់ បេតិកភណ្ឌ អាស៊ី និង ប៉ាស៊ីហ្វិក តំបន់ បេតិកភណ្ឌ អឺរ៉ុប និង អាមេរិក ខាងជើង និង តំបន់ បេតិកភណ្ឌ អាមេរិក ឡាទីន និង ការា អ៉ីប ៕
នៅ រសៀល ថ្ងៃទី ២១ ខែមេសា . លោក ហ៊ុន ម៉ានី កូនប្រុស របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី រៀបចំ ឫស សីមា និង ពិធី ក្រុង ពាលី និង បង្ហូត ទង់ នៅក្នុង ទី អារាម វត្ត នេះ ។
ពិធី នៅ រសៀល នេះ ក៏ មាន ការនិមន្ត និង អញ្ជើញ ចូលរួម បុណ្យ ពី ព្រះសង្ឃ គណៈកម្មការ អាចារ្យ ក្រុមគ្រួសារ ត្រកូល ហ៊ុន ជាច្រើន រូប និង មន្ត្រី រដ្ឋបាល រាជធានី ភ្នំពេញ ផងដែរ ។
សូម បញ្ជាក់ ថា វត្ត ព្រះបារមីវង្គត បុរី ជា ទី អារាម មួយ បាន តំកល់ ធាតុ មាតា បិតា របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ។ ក្រោម គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ទី វត្ត នេះ ត្រូវ ធ្វើ ពិធី បុណ្យ កាត់ ឬ សសីមា ព្រះវិហារ ដ៏ ធំ មួយ ដោយ ចាប់ផ្តើម ពី ថ្ងៃទី ២១ ដល់ ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៣ ក្នុង នោះ នៅ ថ្ងៃទី ២៤ ខែមេសា សម្ដេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត នឹង អញ្ជើញ ជា អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ កាត់ ប្ញស សីមា ។
ព្រះវិហារ វត្ត ព្រះបារមីវង្គត បុរី បាន កសាងឡើងវិញ នៅ ថ្ងៃទី ៧ ខែធ្នូ ឆ្នាំ ២០១៦ និង បាន បញ្ចប់ ការសាងសង់ នៅក្នុង ឆ្នាំ ២០២២ ដោយ ចំណាយ ថវិកា ជាង ១លាន ដុល្លារ ។ នេះ មិន បាន គិត បញ្ចូល ពី ការចំណាយ លើ ការកសាង សមិទ្ធផល នានា នៅក្នុង បរិវេណ វត្ត នេះ នោះ ទេ ។
ពិធី បុណ្យ ៣យប់ ៤ ថ្ងៃ នេះ ក៏ មាន ការរៀបចំ ក្រុម សិល្បៈ កំសាន្ត ជាច្រើន ក្រុម ដើម្បី សម្តែង ជូន ទស្សនជន បាន មើល កំសាន្ត ផងដែរ ដែល មាន ទាំង ក្រុម ល្ខោន បាសាក់ ចាប៉ី ដង វែង អាយ៉ៃ ឆ្លើយឆ្លង និង ការប្រគុំតន្ត្រី ថែម ទៀត ។
( សៀមរាប ) ៖ នៅ ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ លោក ទៀ សីហា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាន ចាត់តាំង លោក ចៅ ម៉ៅ មុន្នី សមាជិក គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម ខេត្ត ជា តំណាង នាំយក អំណោយ មនុស្សធម៌ របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ចែកជូន ដល់ គ្រួសារ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ ចំនួន ៣៥ គ្រួសារ មកពី ៣ឃុំ ស្មើ ៧ភូមិ ក្នុង ស្រុក ស្វាយលើ ខេត្ត សៀមរាប ។
លោក ស៊ុំ សំអន នាយក ប្រតិបត្តិ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាន ឲ្យដឹង ថា នៅ ដើម ឆ្នាំ ២០២៣ នេះ មាន ប្រជាពលរដ្ឋ បាន រងគ្រោះ ដោយ គ្រោះ ធម្មជាតិ ទូទាំង ខេត្ត សៀមរាប មាន ចំនួន សរុប ៥៤៨ គ្រួសារ ហើយក៏ ត្រូវបាន សាខា នាំយក អំណោយ ផ្តល់ ជូន ជា បន្តបន្ទាប់ ផងដែរ ។
តាម របាយការណ៍ របស់ លោក អៀង ពិសិដ្ឋ ប្រធាន អនុសាខា កាកបាទ ក្រហម កម្ពុជា ស្រុក ស្វាយលើ បាន ឲ្យដឹង ថា ក្នុង ឱកាស ដែល ប្រជាពលរដ្ឋ ទទួល សាទ រ បុណ្យ ចូល ឆ្នាំ ថ្មី នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២៣ មាន គ្រោះ ធម្មជាតិ ខ្យល់ កន្ត្រាក់ លាយឡំ នឹង ភ្លៀង ផ្គរ រន្ទះ បក់ បោក មក ប៉ះពាល់ លើ ភូមិ ចំនួន ៧ ក្នុង ឃុំ ទាំង៣ របស់ ស្រុក ស្វាយលើ មាន ឃុំ កន្ទួ ត ឃុំ តា សៀម និង ឃុំ ស្វាយលើ បាន បណ្តាលឲ្យ ( រលំ ផ្ទះ ៥ខ្នង និង របើក ដំបូល ៣០ ខ្នង ) និង មាន អ្នក រងរបួស ម្នាក់ ផងដែរ ។
អគ្គ នាយក រង នៃ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល ដែល ដក កាំភ្លើង បើក ឡាន តាម ភ្ជង់ យុវជន ម្នាក់ ត្រូវ តុលាការ ចេញ ដីកា ឃុំ ខ្លួន ដាក់ ពន្ធនាគារ
( ភ្នំពេញ ) ៖ បុគ្គល ឈ្មោះ បែល វ៉ាន់ ដែត អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន រដ្ឋបាល និង កិច្ចការ ទូទៅ នៃ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល ដែល បាន ដក កាំភ្លើង ភ្ជង់ អ្នកដទៃ នោះ ត្រូវបាន តុលាការ ចេញ ដីកា ឃុំ ខ្លួន ដាក់ ពន្ធនាគារ ហើយ នៅ រសៀល ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ ក្រោយ កម្លាំង នគរបាល តាម ចាប់ និង បញ្ជូន ទៅកាន់ តុលាការ ។
សូម បញ្ជាក់ ថា ប្រតិបត្តិការ ចាប់ខ្លួន បុគ្គល រូប នេះ បាន ធ្វើឡើង ដោយ កម្លាំង នាយកដ្ឋាន កណ្ដាល សន្ដិសុខ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ . ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ និង អធិការដ្ឋាន នគរបាល ខណ្ឌ ឫស្សីកែវ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ទោ ប៊ុន សុសិក្ខា ស្នងការ រង ទទួល ផែន សន្តិសុខ ។
សូម រំលឹក ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន សម្រេច បញ្ចប់ តំណែង មន្ត្រី អាកាសចរ ស៊ីវិល ម្នាក់ នេះ ព្រោះតែ ការដក កាំភ្លើង ភ្ជង់ អ្នកដទៃ រឿង ស៊ី ប្លេរថយន្ត ។ មន្ត្រី អាកាសចរណ៍ ស៊ីវិល ដែល សម្តេច តេជោ បាន បញ្ចប់ តំណែង នេះ ឈ្មោះ បែល វ៉ាន់ ដែត ជា អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន រដ្ឋបាល និង កិច្ចការ ទូទៅ នៃ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន បង្ហោះ អនុក្រឹត្យបញ្ចប់ មុខតំណែង ជាមួយ ការបញ្ជាក់ បែប នេះ « បើ តុលាការ មិន ចាត់ការ តាម ផ្លូវ ច្បាប់ ទេ ទុក ឱ្យ ខ្ញុំ ដាក់ វិន័យ តាម ផ្លូវ រដ្ឋ សិន ។ អាង មាន អំណាច ប្រើប្រាស់ អាវុធ គំរាម អ្នក ទន់ខ្សោយ » ។ សម្តេច តេជោ បន្ថែម ថា « នេះ ជា សារ ព្រមាន ចំពោះ មន្ត្រី ទាំងអស់ សូម កុំ អាង អំណាច ធ្វើបាប អ្នកទន់ខ្សោយ ជាពិសេស សូម កុំ ប្រើប្រាស់ អាវុធ ខុស ច្បាប់ » ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំឲ្យ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ធ្វើការ ជាមួយ តុលាការ កុំ ឲ្យ ជនល្មើស ប្រើប្រាស់ អាវុធ ខុស ច្បាប់ បាន នៅ ក្រៅ ឃុំ មុនពេល កាត់ទោស ដែល ជន នោះ អាច តាម គំរាមកំហែង ដល់ អ្នក ផ្សេង ទៀត ។
ពេល នោះ លោក បែល វ៉ាន់ ដែត បាន បើក ដេញ តាម ពីក្រោយ រថយន្ត ជនរងគ្រោះ ដល់ ចំណុច កើត ហេតុ រួច ជនសង្ស័យ បាន ដក កាំភ្លើង ខ្លី ភ្ជង់ ទៅ លើ ជនរងគ្រោះ ពី ក្នុង រថយន្ត ដោយ សួរ ថា « មុន ហ្នឹង ស៊ីប្លេ ដាក់ នរណា ? រួច ក៏ បើកថយន្ត គេចខ្លួន បាត់ »៕ សម្តេច ម៉ែន សំអន ផ្តល់ អនុសាសន៍ ៤ ចំណុច ដល់ គ្រូបង្វឹក គ្រូ ជំនួយ ជា នារី និង កីឡាការិនី ដើម្បី យក ជ័យជម្នះ ក្នុង ការប្រកួត កីឡា ស៊ីហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ គ្រូបង្វឹក គ្រូ ជំនួយ ជា នារី និង កីឡាការិនី ជម្រើសជាតិ កម្ពុជា ចំនួន ៣៦៨ នាក់ ដែល នឹង ត្រូវ ចូលរួម ក្នុង ការប្រកួត កីឡា ស៊ីហ្គេម លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ឆ្នាំ ២០២៣ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ។
ពិធី សំណេះសំណាល នេះ បាន ធ្វើឡើង នា រសៀល ថ្ងៃសុក្រ ទី ២១ ខែមេសា ឆ្នាំ ២០២៣ ។
ឆ្លៀត ក្នុង ឱកាស ដ៏ វិសេសវិសាល នេះ សម្តេច កិត្តិសង្គហ បណ្ឌិត បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន ដល់ សមាជិក សមាជិកា អង្គ ពិធី ទាំងមូល ដោយ ក្តី នឹករលឹក និង ការគិតគូរ សុខទុក្ខ គ្រប់ បែបយ៉ាង ។
សម្តេច បាន ថ្លែង ថា « ក្រោម ការដឹកនាំ ប្រកបដោយ កិត្តិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រែក្លាយ ប្រទេស ដែល រាំ រ៉ៃ ដោយសារ សង្គ្រាម មក ជា ប្រទេស មាន ការរីកចម្រើន និង មាន ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ក្រោម ម្លប់ នៃ សុខ សន្តិភាព ។ ទន្ទឹម នឹង នោះ ផងដែរ វិស័យ កីឡា ក៏ មាន ការរីកចម្រើន គួរឲ្យ កត់សម្គាល់ កន្លងមក កីឡាករ - កីឡាការរិនី យើង បាន ដណ្តើម យក នូវ មេដាយ ជាច្រើន ជូន ជាតិ មាតុ ប្រទេស វិញ និង បាន ធ្វើឱ្យ យើង មាន ឈ្មោះ បោះ សម្លេង នៅក្នុង តំបន់ និង ពិភពលោក » ។
ចំណែកឯ គោលបំណង នៃ ការរៀបចំ ពិធី នេះ គឺ ដើម្បី លើកទឹកចិត្ត បន្ថែម ទៀត ដល់ កីឡាការិនី ឱ្យ ខិតខំ ប្រឹងប្រែង ហ្វឹកហាត់ ក សាង ឆន្ទៈ មោះ មុត និង ការប្តេជ្ញាចិត្ត ខ្ពស់ ក្នុង ការប្រកួត ដោយ ឈរ លើ ស្មារតី សាមគ្គី ភាពជាតិ និង អន្តរជាតិ ដើម្បី ដណ្តើម ជោគជ័យ និង កិត្តិយស ជូន ប្រទេសជាតិ ។
ព្រឹត្តិការណ៍ នៃ ការប្រកួត កីឡា ស៊ីហ្គេម លើក ទី ៣២ នឹង ត្រូវ ប្រារព្ធ ពិធី បើក នា ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២៣ ខាងមុខ និង កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម ដែល នឹង ចាប់ផ្តើម ពី ថ្ងៃទី ៣ ដល់ ថ្ងៃទី ៩ ខែមិថុនា ឆ្នាំ ២០២៣ ។ ការធ្វើជា ម្ចាស់ ផ្ទះ នៃ ព្រឹត្តិការណ៍ ការប្រកួត កីឡា ស៊ីហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម គឺជា មោទនភាព និង ជា មុខមាត់ សម្រាប់ ប្រទេស និង ប្រជាជន កម្ពុជា ទាំងមូល ដែល បាន ទន្ទឹងរង់ចាំ អស់ រយៈពេល ៦៤ ឆ្នាំ មកហើយ ។
សម្តេច កិត្តិសង្គហ បណ្ឌិត បាន ផ្តាំផ្ញើ លោក លោកស្រី ជា គ្រូបង្វឹក គ្រូ ជំនួយ ជា នារី និង ក្មួយ ៗ កីឡាការិនី ជម្រើសជាតិ ទាំងអស់ នូវ ចំណុច មួយចំនួន ដូច ខាងក្រោម៖
លោក បន្ត ថា ពិធី ប្រគល់ - ទទួលគោរមងារ និង បណ្ឌិត កិត្តិយស ខាងលើ នេះ នឹង ប្រារព្ធ រៀបចំ នៅ ថ្ងៃទី ២ ខែឧសភា ឆ្នាំ ២០២៣ នៅ រមណីយដ្ឋាន វត្តភ្នំ មណ្ឌលដ្ឋាន ប្រវត្តិសាស្ត្រ នៃ ការកកើត រាជធានី ភ្នំពេញ ផ្សារភ្ជាប់ នឹង ព្រះពុទ្ធ សាសនា ៕
គួរ បញ្ជាក់ ការលា លែង ពី តំណែង របស់ លោក រ៉ាប គឺជា ការចាកចេញ របស់ មន្ត្រី ជាន់ ខ្ពស់ របស់ អង់គ្លេស ទី បី ហើយ ជុំវិញ ការប្រព្រឹត្ត ផ្ទាល់ខ្លួន របស់ ពួកគេ ចាប់តាំងពី លោក ស៊ូណាក់ ឡើង កាន់ តំណែង នៅក្នុង ខែតុលា ឆ្នាំ ២០២២ ព្រម ជាមួយ ការសន្យា ថា នឹង បង្កើត រដ្ឋាភិបាល សុចរិត ៕
កាលពី ថ្ងៃពុធ សភា អ៊ឺរ៉ុប បាន អនុម័ត ច្បាប់ សំខាន់ មួយ ដែល នឹង តម្រូវ ឱ្យ ក្រុមហ៊ុន ដែល លក់ ទំនិញ ទៅកាន់ សហភាព អឺរ៉ុប ផលិត ព័ត៌មាន « ដែល អាច ផ្ទៀងផ្ទាត់ បាន » ដែល បង្ហាញ ថា ទំនិញ របស់ ពួកគេ មិន ដាំដុះ នៅលើ ដី ដែល ត្រូវបាន កាប់បំផ្លាញ ព្រៃឈើ ក្រោយ ឆ្នាំ ២០២០ បើ មិន ដូច្នេះ ទេ នឹង ប្រឈម ការផាកពិន័យ យ៉ាង ធ្ងន់ធ្ងរ ។
ច្បាប់ នេះ នឹង អនុវត្ត ចំពោះ សណ្តែក សៀង សាច់ គោ ប្រេង ដូង ឈើ កាកាវ កាហ្វេ កៅស៊ូ ធ្យូង និង ផលិតផល បំប្លែង នានា រួមទាំង ស្បែក សូកូឡា និង គ្រឿងសង្ហារឹម ។
រដ្ឋាភិបាល ម៉ាឡេស៊ី បាន ឱ្យដឹង ថា ច្បាប់ នេះ គឺជា « កិច្ច ខិតខំ ប្រឹងប្រែង ដោយ ចេតនា » ដើម្បី បង្កើន ការចំណាយ និង ឧបសគ្គ សម្រាប់ វិស័យ ប្រេង ដូង របស់ ខ្លួន ដែល ជា ប្រភព សំខាន់ នៃ ប្រាក់ ចំណូល នាំចេញ របស់ ម៉ាឡេស៊ី ។
ម៉ាឡេស៊ី គឺជា ប្រទេស នាំចេញ ប្រេង ធំ ជាង គេ ទី ពីរ ក្នុង ពិភពលោក បន្ទាប់ពី ឥណ្ឌូណេស៊ី ។
លោក មានប្រសាសន៍ ថា ម៉ាឡេស៊ី កំពុង ធ្វើការ ជាមួយ ប្រទេស ឥណ្ឌូណេស៊ី ដើម្បី ពិចារណា លើ ការឆ្លើយតប ដ៏ សមស្រប មួយ ទៅនឹង ច្បាប់ នេះ ដោយ លោក បាន បន្ថែម ថា ម៉ាឡេស៊ី នៅតែ បើក ចំហរ ក្នុង ការពិភាក្សា ជាមួយ សហភាព អឺរ៉ុប ដើម្បី ដោះស្រាយ កង្វល់ ជុំវិញ បទប្បញ្ញត្តិ នេះ ។
ប្រទេស ម៉ាឡេស៊ី បាន ឱ្យដឹង ថា ច្បាប់ នេះ នឹង ប៉ះពាល់ ដល់ កសិករ តូច ៗ ដោយសារ ពួកគេ នឹង មិន អាច ឆ្លើយតប បាន ទៅនឹង ការចំណាយ លើ អនុលោម តាម ច្បាប់ នេះ បាន ទេ ។ នេះ បើ យោង តាម កាសែត បាងកក ប៉ុស្តិ៍ ៕
លិខិត មិត្ត អ្នកអាន៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព មេដឹកនាំ គំរូ មាន សមត្ថភាព និង បេះដូង ដែល អាច ផ្តល់ ម្លប់ ត្រជាក់ ជូន ជាតិ យូរ លង់ ទៅ មុខ
( ភ្នំពេញ ) ៖ ព្រះរាជាណាចក្រ កម្ពុជា ដែល ជា ដែនដី ដ៏ ពិសិដ្ឋ និង មាន អរិយធម៌ ដ៏ ផូផង់ បាន ឆ្លងកាត់ នូវ សោក នាថកម្ម សង្គ្រាម និង ការបែកបាក់ ជា បន្តបន្ទាប់ ទម្រាំ ស្គាល់ នូវ សន្តិភាព ពេញលេញ មិន ដែល មាន ក្នុង ប្រវត្តិសាស្ត្រ រយៈពេល ៥០០ ឆ្នាំ ។
ដូច្នេះ ក្នុង សា្ថនភាព ពិភពលោក មាន វិបត្តិ គ្មាន ដែន កំណត់ និង ដើម្បី ការអភិវឌ្ឍ ជាមួយ តម្លៃ សន្តិភាព ត្រូវ រក្សា ការពារ មាន តែ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព ពលរដ្ឋ ខ្មែរ គំរូល្អ មាន សមត្ថភាព ពិតជា យុវជន កុលបុត្រ ឆ្នើម បំផុត ប្រៀប បាន សុរិយារះ ថ្មី ភ្លឺ ច្បាស់ ត្រចះក្រៃ មាន បេះដូង ស្មោះ ពិត ជូន ជាតិ កំណើត ជា ទេព និស្ស័យ ផ្តល់ ម្លប់ ត្រជាក់ បន្ថែម ប្រសើរ ថ្លា ថ្លៃ ជូន ដែនដី ពិសិដ្ឋ គឺ ព្រះរាជាណាចក្រ កម្ពុជា ពិតប្រាកដ មែន យូរ លង់ ទៅ មុខ ទៀត ៕
អរគុណ សន្តិភាព !
របាយការណ៍៖ លោក ចូ បៃ ដិន គ្រោង ប្រកាស ជា ផ្លូវការ អំពី ការបន្ត ឈ្មោះ សម្រាប់ ការបោះឆ្នោត ឆ្នាំ ២០២៤ នៅ សប្តាហ៍ ក្រោយ
( វ៉ាស៉ីន តោន ) ៖ បណ្តា ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ស្រុក របស់ សហរដ្ឋ អាមេរិក កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ បាន នាំគ្នា រាយការណ៍ ថា ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន កំពុង ពិចារណា ប្រកាស ពី ការសម្រេចចិត្ត របស់ លោក ជា ផ្លូវការ ក្នុង សប្តាហ៍ ក្រោយ នេះ ជុំវិញ ការបន្ត ឈ្មោះ សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី នៅ ឆ្នាំ ២០២៤ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃសុក្រ ទី ២១ ខែមេសា ឆ្នាំ ២០២៣ ។
លោក បៃ ដិន ត្រូវ គេ រាយការណ៍ ថា កំពុង ពិចារណា ប្រកាស ពី ការសម្រេចចិត្ត នៅ ថ្ងៃទី ២៥ ខែមេសា ពោលគឺ ថ្ងៃអង្គារ សប្តាហ៍ ក្រោយ ហើយ សេចក្តីប្រកាស នោះ នឹង ធ្វើឡើង ក្នុង ទម្រង់ ជា វីដេអូ ចេញផ្សាយ ទៅកាន់ ក្រុម អ្នកគាំទ្រ របស់ លោក ។ កន្លងមក លោក បៃ ដិន ធ្លាប់ បាន បង្ហើប អំពី ចេតនា បន្ត ឈរឈ្មោះ ជា ប្រធានាធិបតី ហើយ កាលពី សប្តាហ៍ មុន លោក បាន និយាយ ថា រូប លោក នឹង ប្រកាស ពី ផែនការ ជុំវិញ ការបន្ត ឈរឈ្មោះ បោះឆ្នោត ក្នុង ពេល ឆាប់ ៗ ។
លោក ចូ បៃ ដិន គឺជា បុគ្គល ចំណាស់ ជាង គេ បង្អស់ ដែល បាន កាន់ តំណែង ជា ប្រធានាធិបតី អាមេរិក ហើយ លោក នឹង មាន អាយុ ដល់ ៨៦ ឆ្នាំ នៅ ចុងបញ្ចប់ អាណត្តិ ទី២ របស់ លោក ។ ស្រប ពេល ដែល លោក ប្រឈម នឹង ការប្រកួតប្រជែង តិចតួច ក្នុង ការក្លាយជា បេក្ខជន ប្រធានាធិបតី តំណាង ឱ្យ ប្រជាធិបតេយ្យ ក៏ដោយ ៤៥ ភាគរយ នៃ អ្នកគាំទ្រ របស់ គណបក្ស នេះ បាន បង្ហាញ ការយល់ឃើញ របស់ ពួកគេ ក្នុង ការស្ទង់ មតិ មួយ កាលពី ខែមីនា ថា លោក បៃ ដិន មិន គួរ ឈរឈ្មោះ ជាថ្មី ទេ នៅ ឆ្នាំ ២០២៤ ខណៈ សំឡេង ៤៨ ភាគរយ គាំទ្រ ឱ្យ លោក បន្ត ឈរឈ្មោះ ។
គួរ បញ្ជាក់ ថា ចំណែក ខាង គណបក្ស សាធារណរដ្ឋ វិញ គឺ អតីត ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ដែល បាន ចាញ់ ក្រោម ស្នាដៃ លោក បៃ ដិន កាលពី ក្នុង ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី ឆ្នាំ ២០២០ គឺ កំពុងតែ នាំមុខ ក្នុង ចំណោម បេក្ខជន ប្រធានាធិបតី ដែល មាន ប្រជាប្រិយភាព ខ្ពស់ ជាង គេ របស់ គណបក្ស នេះ បើ យោង តាម ការស្ទង់ មតិ ។ ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី អាមេរិក អាណត្តិ ថ្មី នឹង ប្រព្រឹត្តទៅ នា ថ្ងៃទី ៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៤ ៕
ថ្នាក់ដឹកនាំ មន្រ្តី បេឡា ជាតិ សន្តិសុខ សង្គម បរិច្ចាគ ថវិកា ១ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ មន្រ្តី បេឡា ជាតិ សន្តិសុខ សង្គម បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ថ្នាក់ដឹកនាំ មន្រ្តី បេឡា ជាតិ សន្តិសុខ សង្គម តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គ្រោះ ធម្មជាតិ ខ្យល់ កន្រ្តាក់ វាយប្រហារ ផ្ទះ ពលរដ្ឋ នៅ ស្រុក រុក្ខគីរី . ថ្ងៃ នេះ ពលរដ្ឋ រងគ្រោះ ៣១៩ គ្រួសារ ទទួល អំណោយ មនុស្សធម៌ ពី សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ លោក សុខ លូ អភិបាល ខេត្ត និង ជា ប្រធាន ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង និង សហការី នៅ ព្រឹក ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ចុះ ជួប សំណេះ សំណាល សួរសុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ រលំ ទាំងស្រុង និង ប៉ើង ដំបូល ធ្ងន់ធ្ងរ កាលពី ថ្ងៃទី ១២ - ១៥ ខែមេសា ឆ្នាំ ២០២៣ ចំនួន ៣១៩ គ្រួសារ មកពី ភូមិ ចំនួន ១៦ លើ ឃុំ ចំនួន ៥ នៃ ស្រុក រុក្ខគីរី ( រលំ ទាំងស្រុង ១៣៤ ខ្នង និង របើក ដំបូល ១៨៥ ខ្នង ) ។
ពិធី សំណេះសំណាល និង ផ្ដល់ អំណោយ មនុស្សធម៌ នេះ ប្រារព្ធ នៅ ២ទីតាំង ផ្សេង គ្នា ទីតាំង ទី១ នៅ បរិវេណ សាលា បឋមសិក្សា ព្រែក ជីក ឃុំ ព្រែក ជីក និង ទីតាំង ទី២ ស្ថិត នៅ ផ្សារ ដំបូល ខៀវ ឃុំ ស្តុកប្រវឹក ស្រុក រុក្ខគីរី ។
ថ្លែង ក្នុង ឱកាស នោះ លោក សុខ លូ ប្រធាន គណៈកម្មាធិការ សាខា បាន នាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពី សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល តែងតែ យកចិត្តទុកដាក់ គិត គូរ ខ្ពស់ ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ រូប មិន ប្រកាន់ វណ្ណៈ ពណ៌ សម្បុរ ជំនឿ សាសនា ឬ និន្នាការ នយោបាយ ណាមួយ ឡើយ ។
លោក សុខ លូ បាន អំពាវនាវ លោក តា លោកយាយ អ៊ំ ពូមីង និង បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ សូម មេត្តា អញ្ជើញ ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឲ្យបាន គ្រប់ ៗ គ្នា នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ និង ចូលរួម គោរព ច្បាប់ ចរាចណ៍ ផ្លូវគោក ទាំងអស់ គ្នា ។
ឃាតកម្ម ! កូន វាយ សម្លាប់ ឪពុក បង្កើត នៅ ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង ដោយសារ ឥទ្ធិពល គ្រឿងញៀន
( ព្រៃវែង ) ៖ បុរស ម្នាក់ វ័យ ៥២ ឆ្នាំ ត្រូវបាន កូន ទាញ ធុង ហ្គាស វាយ បណ្ដាលឲ្យ ស្លាប់ ភ្លាម ៗ ក្នុង ថ្លុក ឈាម ដោយសារ ឥទ្ធិពល គ្រឿងញៀន ។ ហេតុការណ៍ នេះ បាន កើតឡើង នៅ យប់ ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២៣ ស្ថិត ក្នុង ភូមិ ថ្លុក កណ្ដោល ឃុំ ក្រញូង ស្រុក កំចាយ មា ខេត្ត ព្រៃវែង ។
របាយការណ៍ របស់ សមត្ថកិច្ច មូលដ្ឋាន បាន ឲ្យដឹង ថា ជនរងគ្រោះ ឈ្មោះ យ៉ុន ឆៃឡេង អាយុ ៥២ ឆ្នាំ រស់ នៅ ភូមិ ឃុំ កើត ហេតុ ។ ចំណែក ជន បង្ក ជា កូន ឈ្មោះ ឡេង បារាំង អាយុ ២៧ ឆ្នាំ ជា មនុស្ស បែក ថ្នាំ ។
សមត្ថកិច្ច បាន បន្ត ថា នៅ មុនពេល កើត ហេតុ កូន ចិត្ត ឃោរឃៅ បាន បែក ថ្នាំ បាត់បង់ ស្មារតី ទាញយក ធុង ហ្គាស វាយ បោក ខ្ទប់ ទៅ លើ ឪពុក បណ្ដាលឲ្យ ស្លាប់ ក្នុង ថ្លុក ឈាម នៅក្នុង បន្ទប់ ដេក ក្នុង ផ្ទះ តែម្តង ។ ខណៈ នោះ ត្រូវបាន សាច់ញាតិ ក្រុមគ្រួសារ រាយការណ៍ ទៅ សមត្ថកិច្ច ចុះ ឃាត់ខ្លួន ជនសង្ស័យ បាន ភ្លាម ៗ និង កសាង សំណុំរឿង ទៅ តាម នីតិវិធី ផងដែរ ។
ចំណែក សាកសព ត្រូវបាន ក្រុមគ្រួសារ និង បងប្អូន រៀបចំ ចាត់ចែង ធ្វើ បុណ្យ នៅ តាម ប្រពៃណី ៕
រដ្ឋធានី ធានី ខាទុំ ត្រូវ រញ្ជួយ ដោយ ការទម្លាក់ គ្រាប់បែក និង ការបាញ់ ផ្លោង មុនពេល មាន ការប្រកាស បទ ឈប់ បាញ់ ហើយ បើ តាម សាក្សី នៅ ឮ ស្នូកាំភ្លើង ខណៈ បទ ឈប់ បាញ់ និង ការអធិស្ឋាន ក្នុង ពិធី បុណ្យ Eid បាន ចាប់ផ្តើម កាលពី ព្រឹក ថ្ងៃសុក្រ នេះ ។ ដោយឡែក អ្នកស្រុក ក្នុង ទីក្រុង បាហ៍ រី ដែល ស្ថិត នៅ ផ្នែក ម្ខាង ទៀត នៃ ទន្លេ នីល (Nile) និយាយ ថា កងទ័ព បាន ដាក់ពង្រាយ ទាហាន ជាច្រើន នាក់ ហើយ បាន ឮ ការប្រយុទ្ធ គ្នា ដោយ កាំភ្លើង រវាង ភាគី ទាំង ពីរ ។
គួរ បញ្ជាក់ ថា កន្លងមក នេះ លោក អាល់ បានីស ធ្លាប់ បាន និយាយ ថា រូប លោក កំពុង ពិចារណា ថា គួរ ឬ គួរ ធ្វើដំណើរ ទៅ ចូលរួម កិច្ចប្រជុំ កំពូល NATO ខាងលើ ។ អូស្រ្តាលី គឺជា ប្រទេស មិន មែន សមាជិក NATO ដែល បាន ចូលរួមចំណែក យ៉ាង ធំ ទៅក្នុង កិច្ចប្រឹងប្រែង គាំទ្រ របស់ បក្ស សម្ព័ន្ធ យោធា នេះ សម្រាប់ អ៊ុយក្រែន ប្រឆាំង នឹង សង្រ្គាម ឈ្លានពាន របស់ រុស្ស៉ី ៕
គួរ បញ្ជាក់ ថា កងកម្លាំង អ៉ីរ៉ង់ និង អាមេរិក ធ្លាប់ បាន ប្រឈមមុខ គ្នា ជាច្រើន លើក កាលពី ពេល កន្លងមក ។ តួយ៉ាង កាលពី ដើម ខែមេសា នេះ យោធា ជើងទឹក អ៉ីរ៉ង់ បាន អះអាង ថា ខ្លួន បាន ប្រទះឃើញ និង ព្រមាន យន្តហោះ ឈ្លប ការណ៍ អាមេរិក១ គ្រឿង នៅក្បែរ ឈូង សមុទ្រ ពែរ្ស ។ ចំណែក កាលពី ឆ្នាំ ២០១៩ អ៉ីរ៉ង់ បាន បាញ់ ទម្លាក់ យន្តហោះ ដ្រូន អាមេរិក១ គ្រឿង ដែល ខ្លួន ទីក្រុង តេហេរ៉ង់ អះអាង ថា បាន ហោះហើរ នៅលើ ភាគ ខាងត្បូង ប្រទេស អ៉ីរ៉ង់ ៕
ក្នុង បរិយាកាស ដ៏ ស្និទ្ធស្នាល នៅ ភោជនីយដ្ឋាន ចិន មួយ នៅ កណ្តាល រាជធានី ភ្នំពេញ លោក អគ្គ នាយក លឹម ជា វុត្ថា និង លោក អគ្គ លេខាធិការ Shi បាន ពិភាក្សា អំពី កិច្ចសហប្រតិបត្តិការ ដែល គ្របដណ្តប់ លើ វិស័យ ប្រព័ន្ធ ផ្សព្វផ្សាយ បច្ចេកវិទ្យា និង ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន ។
ជា ការឆ្លើយតប លោក អគ្គ នាយក លឹម ជា វុត្ថា បាន ថ្លែងអំណរគុណ លោក Shi ចំពោះ ការវាយតម្លៃ ខ្ពស់ ចំពោះ ការអភិវឌ្ឍ របស់ កម្ពុជា ក្រោម ដំបូល សន្តិភាព ។
លោក អគ្គ នាយក លឹម ជា វុត្ថា បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « វ៉ាក់សាំង របស់ ចិន បាន អនុញ្ញាតឱ្យ កម្ពុជា ទទួលបាន ភាពស៊ាំ ហើយ ជា លទ្ធផល ព្រះរាជាណាចក្រ កម្ពុជា អាច បើក ដំណើរការ ឡើងវិញ នូវ រាល់ សកម្មភាព សេដ្ឋកិច្ច សង្គម និង ស្តារ សេដ្ឋកិច្ច ឡើងវិញ ក្នុង ល្បឿន លឿន ជាង ប្រទេស ដទៃ ទៀត ក្នុង កម្រិត សកល » ។
ទន្ទឹមនឹង នេះ លោក អគ្គ នាយក ក៏ បាន លើកឡើង ពី វិស័យ ផ្សេង ៗ ទៀត នៃ កិច្ចសហប្រតិបត្តិការ កម្ពុជា - ចិន រួម មាន ភាគី ចិន នាំចូល កសិផល ពី កម្ពុជា ការវិនិយោគ របស់ ចិន នៅ ប្រទេស កម្ពុជា និង ភ្ញៀវ ទេសចរ ចិន ដែល មក ទស្សនា កម្ពុជា ដែល បាន បង្កើត ការងារ ជាច្រើន កន្លែង និង រុញ ច្រាន សេដ្ឋកិច្ច កម្ពុជា ឱ្យ កាន់តែ លឿន ថែម មួយ កម្រិត ទៀត ។
កំឡុង កម្មវិធី អាហារ ការងារ ពេលល្ងាច នេះ លោក អគ្គ នាយក លឹម ជា វុត្ថា និង លោក អគ្គ លេខាធិការ Shi បាន សន្យា ជំរុញ ទំនាក់ទំនង កម្ពុជា - ចិន - អាស៊ាន តាមរយៈ ការផ្សព្វផ្សាយ ព័ត៌មាន បន្ថែម ទៀត ដែល នឹង ធ្វើឱ្យ អាស៊ាន និង ចិន បន្ត ជា តំបន់ ដែល មាន សន្តិភាព និង វិបុលភាព ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ ថុល បាន ថ្លែង ដូចនេះ ថា « យើង បាន ពិភាក្សា គ្នា ជាមួយនឹង ក្រសួង បរិស្ថាន ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នឹង រៀបចំ ពិនិត្យមើល ថា តើ ឡាន មួយ ទឹក អាយុ ប៉ុន្មាន ចាស់ ពេក យើង មិន អនុញ្ញាតឱ្យ ចូល ទៀត ទេ ឥលូវ យើង កំពុង ពិភាក្សា គ្នា ថា តើ ១០ ឆ្នាំ ឫ ១៥ ឆ្នាំ ឫ៧ ឆ្នាំ អា នេះ យើង កំពុង ពិភាក្សា គ្នា » ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល មកដល់ ពេលនេះ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ក៏ កំពុងតែ ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ ចូលរួម ប្រើប្រាស់ ឡាន ថ្មី ឫ ឡាន ដែល ប្រើប្រាស់ ដោយ ថាមពល អគ្គីសនី ដែល ជា ឡាន ថ្មី ហើយ មាន តម្លៃ ថោក ជាង ឡាន ១ទឹក ពី ស្រុក ក្រៅ ទៀតផង ។
លោក ទេសរដ្ឋមន្ត្រី បាន បន្ថែម ទៀត ថា សម្រាប់ ការនាំចូល រថយន្ត អគ្គិសនី ចូលក្នុង ប្រទេស កម្ពុជា ក្នុង មួយ ឆ្នាំ ៗ មាន ការកើនឡើង ច្រើន ហើយ ក្រសួង ក៏ បាន ខិតខំ ប្រឹងប្រែង ឱ្យ អ្នក វិនិយោគ ដាក់ កន្លែង បញ្ជូល ថាមពល អគ្គិសនី ឱ្យ បាន កាន់តែ ច្រើន នៅ ទូទាំង ប្រទេស កម្ពុជា ផងដែរ ។ ហើយ មកដល់ ពេល បច្ចុប្បន្ន នេះ កម្ពុជា មាន អ្នក កន្លែង បញ្ជូល ថាមពល អគ្គិសនី ១៣កន្លែង រួចហើយ និង នៅ មាន ដៃគូរ វិនិយោគ កំពុង រៀបចំ ដាក់ កន្លែង បញ្ជូន ថាមពល អគ្គិសនី នេះ ជាច្រើន កន្លែង ទៀត ផងដែរ ៕
លោកជំទាវ ជា លាង និង ឯកឧត្ដម បរិច្ចាគ ថវិកា ៦លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ លោកជំទាវ ជា លាង និង ឯកឧត្ដម បាន បរិច្ចាគ ថវិកា ចំនួន ៦លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
លោកជំទាវ ជា លាង និង ឯកឧត្ដម តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា បាន បរិច្ចាគ ថវិកា ចំនួន ២ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
វិទ្យាស្ថាន បច្ចេកវិ៥ទ្យា កម្ពុជា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម ឈិត សុខុន និង លោកជំទាវ បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ឈិត សុខុន និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ២ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម ឈិត សុខុន និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក យូ ម៉ាយ និង លោកស្រី ម៉ែន ឌីម៉ង់ ចំរុង និរន្តរ៍ បរិច្ចាគ ថវិកា ១ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ លោក យូ ម៉ាយ និង លោកស្រី ម៉ែន ឌីម៉ង់ ចំរុង និរន្តរ៍ បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
លោក យូ ម៉ាយ និង លោកស្រី ម៉ែន ឌីម៉ង់ ចំរុង និរន្តរ៍ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោកជំទាវ អ៉ឹង កន្ថា ផាវី និង ថ្នាក់ដឹកនាំ មន្ត្រី ក្រសួង កិច្ចការ នារី បរិច្ចាគ ថវិកា ៥ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
