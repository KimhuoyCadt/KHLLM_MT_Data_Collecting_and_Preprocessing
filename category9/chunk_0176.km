( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៦លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ស្រាល ៦នាក់ ។
( ភ្នំពេញ ) ៖ ឯកឧត្ដម សាយ សំអាល់ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម សាយ សំអាល់ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម ឡាវ ម៉េង ឃីន និង លោកជំទាវ ជឹង សុភាព បរិច្ចាគ ថវិកា ១០ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ឡាវ ម៉េង ឃីន និង លោកជំទាវ ជឹង សុភាព បាន បរិច្ចាគ ថវិកា ចំនួន ១០ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម ឡាវ ម៉េង ឃីន និង លោកជំទាវ ជឹង សុភាព តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន ចំពោះ មរណភាព មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភក៍ ម៉ែន សាអ៊ុន
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ យប់ ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន ចំពោះ មរណភាព មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភក៍ ម៉ែន សាអ៊ុន ម្តាយ បង្កើត របស់ លោក ហង់ ជួន ណារ៉ុន ។
ក្នុង វេលា ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ ខ្ញុំ និង ភរិយា សូម សម្តែង នូវ ការសោកស្តាយ ដោយ ក្តីអាឡោះអាល័យ ជាមួយ ឯកឧត្តម និង ក្រុមគ្រួសារ ចំពោះ ការបាត់បង់ ម្តាយ ម្តាយ ក្មេក ជីដូន ជាទីគោរព ស្រឡាញ់ ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ដ៏ ជ្រាលជ្រៅ ចំពោះ កូន ៗ ចៅ ៗ ទាំងអស់ ដែល កន្លងមក ក្នុង ឆាក ជីវិត របស់ មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភក៍ ម៉ែន សាអ៊ុន បាន ខិតខំ ចិញ្ចឹម បីបាច់ ថែរក្សា និង អប់រំ ទូន្មាន បុត្រធីតា រហូត ក្លាយជា បញ្ញា វ័ន្ដ និង ជា ធនធាន មនុស្ស ដ៏ មាន តម្លៃ សម្រាប់ សង្គមជាតិ ។
ខ្ញុំ និង ភរិយា សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភក៍ ម៉ែន សាអ៊ុន សូម ឆាប់ បាន ចាប់កំណើត កើត ក្នុង សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ »៕
ក្នុង ពិធី លាគ្នា ជាមួយ អត្តពលិក លោក Marcos បាន និយាយ ថា ហ្វីលីពីន មាន ក្តីសង្ឃឹម ខ្ពស់ ចំពោះ អត្តពលិក ហ្វីលីពីន ដែល ចូលរួម ក្នុង ព្រឹត្តិការណ៍ កីឡា ក្នុង តំបន់ នៅ ខែ ក្រោយ នេះ ហើយ រំពឹង ថា ពួកគេ នឹង នាំយក មេដាយ រង្វាន់ និង កិត្តិយស ដល់ មាតុភូមិ បន្ទាប់ពី ព្រឹត្តិការណ៍ នេះ ។
លោក បាន មានប្រសាសន៍ ថា « ប្រសិនបើ រដ្ឋបាល នេះ រដ្ឋាភិបាល នេះ អាច ធ្វើ អ្វី បាន បន្ថែម ទៀត ដើម្បី គាំទ្រ ដល់ កីឡាករ របស់ យើង នោះ ខ្ញុំ នឹង ធ្វើ វា ភ្លាម » ។
របាយការណ៍ បាន និយាយ ថា ការកើនឡើង នៃ ការចំណាយ ដែល ភាគ ច្រើន បណ្តាល មកពី វិបត្តិ សង្គ្រាម អ៊ុយក្រែន គឺជា ការកើនឡើង ខ្ពស់ បំផុត ក្នុង រយៈពេល មួយ ឆ្នាំ នៃ ការចំណាយ យោធា របស់ ប្រទេស នេះ ដែល មិន ធ្លាប់ ក្នុង ទិន្នន័យ របស់ SIPRI ។
របាយការណ៍ បាន បន្ថែម ថា ការចំណាយ លើ វិស័យ ការពារ ជាតិ កាលពី ឆ្នាំ មុន មាន ចំនួន ៣៤ ភាគរយ នៃ ផលិតផល ក្នុង ស្រុក សរុប របស់ អ៊ុយក្រែន បើ ធៀប នឹង ៣.២ ភាគរយ ក្នុង ឆ្នាំ ២០២១ ។
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៣
១៖ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង លោក ហ៊ុន កុសល ជា អនុ រដ្ឋលេខាធិការ ក្រសួង រៀបចំ ដែនដី
២៖ លោក ហ៊ុន កុសល៖ សម្តេច តេជោ ហ៊ុន សែន ជា បុរស មាន បេះដូង គ្មាន ចិត្ត ព្យាបាទ និង គំនុំ យ៉ាង ពិតប្រាកដ
៣៖ សម្តេច តេជោ ហ៊ុន សែន៖ « សេរីភាព របស់ ខ្ញុំ ជាច្រើន ត្រូវបាន បាត់បង់ ព្រោះ កម្លាំង ការពារ »
៤៖ សម្ដេច តេជោ ហ៊ុន សែន កំពុង តាមដាន និង ពិចារណា ជម្លៀស និស្សិត ខ្មែរ - ឥស្លាម ៦នាក់ ចេញ ពី ប្រទេស ស៊ូ ដង់ ខាងត្បូង ដែល កំពុង ជួប វិបត្តិ
៥៖ សម្តេច តេជោ ហ៊ុន សែន បង្កើន ខ្ទង់ ចំណាយ ៧លាន ដុល្លារ ទៀត លើ ការស្នាក់ នៅ និង ហូបចុក របស់ គណៈប្រតិភូ ចូលរួម ព្រឹត្តិការណ៍ ស៉ី ហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម
៦៖ ចិន គ្រោង បញ្ជូន យានអវកាស ទៅ ប្រមូល គំរូតាង ពី អាចម៍ផ្កាយ ប្រភេទ នៅក្បែរ ផែនដី ក្នុង ខ្ទង់ ឆ្នាំ ២០២៥
៨៖ អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន ចេញមុខ បកស្រាយ ថា ចិន គោរព ឋានៈ ជា រដ្ឋ អធិបតេយ្យ របស់ បណ្តា អតីត ប្រទេស សូវៀត ទាំងអស់
៩៖ ស្វីស បិទ ស្ថានទូត ក្នុង ប្រទេស ស៊ូ ដង់ ក្រោម ហេតុផល សន្តិសុខ
១១៖ លោក បណ្ឌិត យង់ ពៅ៖ វៀតណាម ត្រូវការ បី ចំណុច ពី សហរដ្ឋ អាមេរិក ខណៈ អាមេរិក ត្រូវការ តែ មួយ ប៉ុណ្ណោះ ក្នុង ទំនាក់ទំនង ទ្វេ ភាគី
១២៖ លោក ម៉ារ យ៉ារិទ្ធ៖ វៀតណាម មាន ការប្រុងប្រយ័ត្ន ចំពោះ ទំនាក់ទំនង ជាមួយ សហរដ្ឋ អាមេរិក
១៣៖ មន្ដ្រី៖ ត្រីប បែល យក្ស ដែល រកឃើញ នៅ ខេត្ត ស្ទឹងត្រែង ត្រូវបាន បំពាក់ ឧបករណ៍ តាមដាន ជាប់ ខ្លួន ដើម្បីឲ្យ អ្នកជំនាញ ងាយស្រួល ស្វែងយល់ ពី ការរស់នៅ របស់ វា
លោក ប៉ាន សូរស័ក្តិ ឡើង ការពារ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ កិច្ចព្រមព្រៀង ស្តីពី ពាណិជ្ជកម្ម តាម ព្រំដែន រវាង កម្ពុជា និង វៀតណាម
( ភ្នំពេញ ) ៖ នា រសៀល ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៣ នេះ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម បាន ដឹកនាំ គណៈប្រតិភូ ឡើង ការពារ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ កិច្ចព្រមព្រៀង ស្តីពី ពាណិជ្ជកម្ម តាម ព្រំដែន រវាង កម្ពុជា និង វៀតណាម ជាមួយ គណៈកម្មការ ទី៩ នៃ ព្រឹទ្ធសភា ។
ក្នុង កិច្ចប្រជុំ ពិភាក្សា លើ សេចក្តីព្រាង ច្បាប់ នេះ លោក គង់ សារាជ សមាជិក គណៈកម្មាធិការ អចិន្ត្រៃយ៍ និង ជា ប្រធាន គណៈកម្មការ ទី៩ នៃ ព្រឹទ្ធសភា បាន ជម្រាប អង្គប្រជុំ ថា គណៈកម្មការ ទី៩ នៃ ព្រឹទ្ធសភា បាន ពិនិត្យ យ៉ាង ល្អិតល្អន់ លើ អត្ថបទ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ កិច្ចព្រមព្រៀង ស្តីពី ពាណិជ្ជកម្ម តាម ព្រំដែន រវាង កម្ពុជា និង វៀតណាម ។
លោក បន្ត ថា សេចក្តីព្រាង ច្បាប់ នេះ បាន រៀបចំឡើង ត្រឹមត្រូវ តាម បទប្បញ្ញត្តិ នៃ រដ្ឋធម្មនុញ្ញ ច្បាប់ និង បទដ្ឋាន គតិយុត្តិ ពាក់ព័ន្ធ នានា ។ គណៈកម្មការ ទី៩ បាន ឯកភាព ទាំងស្រុង ទៅ លើ បែបបទ និង នីតិវិធី នៃ ការស្នើសុំ សច្ចាប័ន លើ សេចក្តីព្រាង ច្បាប់ ខាងលើ ។
ជា ការឆ្លើយតប លោក ប៉ាន សូរស័ក្តិ បាន បំភ្លឺ និង ជម្រាប ជូន អង្គប្រជុំ នូវ គោលបំណង ខ្លឹមសារ ក៏ ដូចជា អត្ថប្រយោជន៍ ដែល កម្ពុជា នឹង ទទួលបាន ពី កិច្ចព្រមព្រៀង ស្តីពី ពាណិជ្ជកម្ម តាម ព្រំដែន រវាង កម្ពុជា និង វៀតណាម នៅពេល កិច្ចព្រមព្រៀង នេះ ចូល ជាធរមាន ។
លោក រដ្ឋមន្ត្រី ក៏ បាន ឆ្លើយ បំភ្លឺ ចំពោះ សំណួរ នានា របស់ សមាជិក សមាជិកា គណៈកម្មការ ទី៩ នៃ ព្រឹទ្ធសភា ពាក់ព័ន្ធ សេចក្តីព្រាង ច្បាប់ នេះ ។
លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន រំពឹងទុក ថា សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ កិច្ចព្រមព្រៀង នេះ នឹង ចូលរួមចំណែក ក្នុង ការអនុវត្ត នូវ យុទ្ធសាស្រ្ត ក្នុង ការបន្ត ពង្រឹង ការតភ្ជាប់ ផ្នែក ធុរកិច្ច សំដៅ លើកកម្ពស់ ការចាប់ ដៃគូ ពាណិជ្ជកម្ម ការផ្តល់ ឱកាស ការងារ ឱកាស ធុរកិច្ច ជំរុញ ផលិតកម្ម និង អាជីវកម្ម គ្រួសារ ដែល នឹង ជួយ ជំរុញ លើកកម្ពស់ និង ធ្វើឱ្យ ប្រសើរឡើង នូវ ជីវភាព របស់ ប្រជាជន កម្ពុជា រស់ នៅ តាម ព្រំដែន កម្ពុជា - វៀតណាម ។
( ភ្នំពេញ ) ៖ ការរក្សា បាន សមាជិក ចាស់ បូក បញ្ចូល ការកសាង សមាជិក បក្ស ថ្មី បន្ថែម គឺជា កម្លាំង សាមគ្គី យ៉ាង រឹងមាំ មួយ សម្រាប់ គណបក្ស ដើម្បី បន្ត ដឹកនាំ ប្រទេសជាតិ ឱ្យ កាន់តែ រីកចម្រើន ថែម ទៀត ក៏ ដូចជា ធ្វើឱ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព ស្ថេរភាព សង្គម និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ។
លោក បណ្ឌិត អ៉ិត សំហេង សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ខណ្ឌ ចំការមន និង ខណ្ឌ បឹងកេងកង លើកឡើង បែប នេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស បញ្ចូល សមាជិក ថ្មី គណបក្ស ប្រជាជន កម្ពុជា ចំនួន ១៨០ នាក់ របស់ គណៈកម្មាធិការ គណបក្ស សង្កាត់ ផ្សារ ដើម ថ្កូវ ក្នុង ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ដែល រៀបចំ ធ្វើឡើង នៅ ស្នាក់ការ គណបក្ស ខណ្ឌ ចំការមន ។
លោក បណ្ឌិត អ៉ិត សំហេង បញ្ជាក់ ថា សមាជិក បក្ស ចាស់ ថ្មី មាន តួនាទី យ៉ាង សំខាន់ ក្នុង ការខិតខំ អនុវត្ត ឱ្យ បាន ត្រឹមត្រូវ តាម កម្មវិធី គោល នយោបាយ និង លក្ខន្តិកៈ របស់ គណបក្ស សំដៅ ការកសាង ទំនាក់ទំនង ល្អ ជាមួយ ប្រជាជន និង ខិតខំ ឃោសនា ផ្សព្វផ្សាយ អំពី កម្មវីធី នយោបាយ របស់ គណបក្ស និង ច្បាប់ របស់ រដ្ឋ នានា ដោយ ត្រូវ ថែរក្សា ធ្លុង សាមគ្គី ឯកភាព ផ្ទៃក្នុង ការជួយគ្នា ទៅ វិញ ទៅមក និង ត្រូវ ខិតខំ រៀនសូត្រ លើកកម្ពស់ សមត្ថភាព ទាំង គុណធម៌ សីលធម៌ ដើម្បី សម្រេច ភារកិច្ច ជូន សង្គមជាតិ របស់ យើង ។
បន្ថែម ពី នេះ លោក បណ្ឌិត ក៏ បាន លើកឡើង អំពី ប្រវត្តិ និង ស្នាដៃ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល ជា គណបក្ស មាន វ័យ ចំណាស់ មាន ភាព ចាស់ទុំ បាន ដាក់ចេញ នូវ កម្មវិធី នយោបាយ ដ៏ ត្រឹមត្រូវ និង មាន គុណ បំណាច់ បាន កសាង សមិទ្ធផល ជាច្រើន ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ ព្រមទាំង បាន ឆ្លងកាត់ ការលំបាក គ្រប់ បែបយ៉ាង ជាមួយ ប្រជាពលរដ្ឋ រហូត នាំឲ្យ ប្រទេស មាន សុខ សន្តិភាព ពេញលេញ និង មាន ការអភិវឌ្ឍ ដូច សព្វ ថ្ងៃ ។
លោក យឹម ស៊ីណន តំណាង សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ដែល ត្រូវ ប្រកាស ចូល ជា សមាជិក ថ្មី មាន ជំនឿ ជឿជាក់ ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល អាច ថែរក្សា បាន នូវ សុខ សន្តិភាព នាំ នាវា កម្ពុជា ឆ្ពោះទៅ ភាព ជឿនលឿន ដូច ប្រទេស អភិវឌ្ឍ នានា ។ យើងខ្ញុំ ពិតជា មាន មោទកភាព ដែល បាន ចូលរួមចំណែក ក្នុង នាម ជា សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ។
ដើម្បី ឆ្លើយតប ទៅនឹង សេចក្តីទុកចិត្ត របស់ គណបក្ស និង ចូលរួម រក្សា ប្រៀប ឈ្នះ របស់ គណបក្ស ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម ធ្វើ ការប្តេជ្ញាចិត្ត ដូចត ទៅ៖
១. ប្តេជ្ញា គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ សេចក្តីសម្រេច របស់ សន្និបាត គណៈកម្មាធិការ កណ្តាល នៃ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន សម្រេច ជា ឯកច្ឆន្ទ បន្ត គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី និង ជ្រើសតាំង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី សម្រាប់ ពេល អនាគត ។
២. ប្តេជ្ញា ការពារ ឱ្យ បាន ជាដាច់ខាត នូវ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម និង ទប់ស្កាត់ រាល់ ការប៉ុនប៉ង បង្ក ចលា ចល នានា របស់ ក្រុម ប្រឆាំង និង មជ្ឈដ្ឋាន អគតិ ដើម្បី ធានា ការ រស់នៅ ដោយ សុខសាន្ត របស់ ប្រជាពលរដ្ឋ ។
៣. ប្តេជ្ញា ស្មោះត្រង់ បម្រើ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ឥត ងាក រេ ។
៤. ប្តេជ្ញា កៀរគរ បងប្អូន ក្រុមគ្រួសារ និង មិត្តភ័ក្ត្រ ឱ្យ ទៅ គាំទ្រ បោះឆ្នោត និង បោះ ជូន គណបក្ស ប្រជាជន កម្ពុជា គ្រប់ ៗ អាណត្តិ ជាពិសេស ដណ្តើម ជ័យ ជំនះ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ៕UPDATE ៖ បាក់ ច្រាំង ទន្លេ បាសាក់ ជាង ២០០ ម៉ែត្រ ត្រង់ ចំណុច មុខ ផ្សារ ស្អាង ព្រែក តូច ស្រុក ស្អាង ខេត្ត កណ្ដាល ខូចខាត ផ្ទះ ពលរដ្ឋ កើនឡើង ៤០ ខ្នង
( កណ្ដាល ) ៖ ករណី បាក់ ច្រាំង ទន្លេ បាសាក់ ត្រង់ ចំណុច ត្រពាំង ឈូក ឃុំ ព្រែក គយ ស្រុក ស្អាង មុខ ផ្សារ ស្អាង ព្រែក តូច ក្នុង ស្រុក ស្អាង បណ្ដាលឲ្យ ផ្ទះ ពលរដ្ឋ កើនឡើង ចំនួន ៤០ ខ្នង រង ការខូចខាត ផ្ទះ ខ្លះ បាក់ ចូល ទន្លេ ។ ហេតុការណ៍ នេះ បាន កើតឡើង នៅ រសៀល ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
ក្រោយ កើត ហេតុ ភ្លាម អភិបាល ខេត្ត កណ្ដាល លោក គង់ សោភ័ណ្ឌ បាន ចេញ បញ្ជា ភ្លាម ៗ ដល់ អាជ្ញា មូលដ្ឋាន កងកម្លាំង ទាំង៣ចេញ អន្តាគមន៍ ជួយ សង្រ្គោះ ពលរដ្ឋ បន្ទាន់ ផងដែរ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម បណ្ឌិត ណុប នរិន្ទ នាយក វិទ្យាស្ថាន ខ្មែរ ជំនាន់ ថ្មី និង ជា ប្រធាន កិត្តិយស ក្លឹប យុវជន កាកបាទ ក្រហម កម្ពុជា បាន បរិច្ចាគ ថវិកា ចំនួន ៤លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្តម បណ្ឌិត ណុប ន រិន្ទ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក ទុំ នីរ៉ូ ថ្លែង បែប នេះ ធ្វើឡើង ក្នុង សន្និសីទ សារព័ត៌មាន ស្តីពី « ភាពជោគជ័យ រយៈពេល ៥ឆ្នាំ កន្លងមក របស់ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង » រៀបចំឡើង ដោយ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី នា ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៣ ។
លោក បាន គូសបញ្ជាក់ ថា បើ ទោះបីជា ខេត្ត ស្ទឹងត្រែង មិន មែន ជា ខេត្ត ដែល មាន សក្តានុពល លើ ការដាំដុះ ដំណាំ ស្រូវ ប៉ុន្តែ ខេត្ត នេះ ជា តំបន់ ដែល មាន សក្តានុពល ទៅ លើ ដំណាំ កសិឧស្សាហកម្ម ដូចជា ស្វាយចន្ទី ដំឡូង មី កៅស៊ូ និង ស្វាយ ជាដើម ។
លោក មានប្រសាសន៍ ថា ក្នុង រយៈពេល ៥ឆ្នាំ ចុងក្រោយ នេះ ស្វាយចន្ទី បាន ផ្តល់ ទិន្នផល ប្រមាណ ៩០ ពាន់ ទៅ ១០០ ពាន់ តោន និង ផ្តល់ ចំណូល បាន ជាង ១០០ លាន ដុល្លារ ។ ចំណែក ដំណាំ ដំឡូង មី មាន កំណើន គួរឱ្យ កត់សម្គាល់ គិត ត្រឹម ឆ្នាំ ២០២២ ផ្ទៃដី ដំណាំ ដំឡូង មី មាន ប្រមាណ ជាង ២ម៉ឺន ៥ពាន់ ហិកតា និង ផលិត បាន ជាង ១លាន ៦សែន តោន ដែល ផ្តល់ ថវិកា ប្រមាណ ជាង ២០០ លាន ដុល្លារ ក្នុង រយៈពេល ៥ឆ្នាំ នេះ ដែល បាន ចាក់បញ្ចូល ទៅក្នុង សេដ្ឋកិច្ច របស់ ខេត្ត ស្ទឹងត្រែង ។
ទន្ទឹម គ្នា នេះ ដំណាំ កៅស៊ូ ក៏ មាន កំណើន គួរឱ្យ កត់សម្គាល់ ផងដែរ ដោយ ក្នុង មួយ ឆ្នាំ ៗ ដំណាំ កៅស៊ូ បាន ផ្តល់ ផល ជាង ២ម៉ឺន តោន និង ទទួលបាន ចំណូល ប្រមាណ ជាង ២០លាន ដុល្លារ ខណៈ ស្វាយ ផលិត បាន ជាង ១០០ ពាន់ តោន ដែល ផ្តល់ ចំណូល ជាង ៣០លាន ដុល្លារ ក្នុង រយៈពេល ៥ឆ្នាំ នេះ ។
រីឯ ការចិញ្ចឹម សត្វ វិញ ទទួលបាន ចំណូល ប្រមាណ ២០០ លាន ដុល្លារ និង វិស័យ ជល ផល ផ្តល់ ទិន្នផលប្រមាណ ៤ពាន់ តោន ក្នុង មួយ ឆ្នាំ ៗ និង ទទួលបាន ចំណូល ប្រមាណ ១៥០ លាន ដុល្លារ ក្នុង រយៈពេល ៥ឆ្នាំ នេះ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៧ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១០ករណី . ដឹកជញ្ជូន រក្សាទុក ៦ករណី . ដាំដុះ ១ករណី និង ជួញដូរ ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៦៥ នាក់ ។
លោក កែវ រតនៈ៖ « ការអភិវឌ្ឍន៍ ប្រទេស ជាតិ ត្រូវការ ការចូលរួម ពី ក្មួយ ៗ កម្មករ កម្ម ការិនី . ដោយឡែក និវត្តន៍ ជន គឺជា តួអង្គ យ៉ាង សំខាន់ ដែល បាន ខិតខំ ត្រួសត្រាយ ផ្លូវ នាំមក នូវ សុខ សន្តិភាព »
លោក បាន លើកឡើង បែប នេះ ក្នុង ឱកាស ជួប សំណេះសំណាល ជាមួយ កម្មករ កម្មការ នី ក្នុង ស្រុក បាកាន ចំនួន ១២០០ នាក់ នៅ ស្នាក់ការ គណបក្ស ស្រុក និង ក្នុង ឱកាស ជួប សំណេះសំណាល ជាមួយនិវត្តន៍ ជន អតីត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ និង មន្ត្រីរាជការ មកពី ១១ឃុំ ក្នុង ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ ចំនួន ៤២០ នាក់ នៅ ស្នាក់ការ គណបក្ស ស្រុក ដោយ បាន ការចូលរួម ពី លោក អភិបាល រង ខេត្ត ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត និង ក្រុមការងារ មួយចំនួន ទៀត ។
