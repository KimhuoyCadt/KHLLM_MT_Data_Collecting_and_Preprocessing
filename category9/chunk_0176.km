( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី ១១ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ១៖ ប្រធានាធិបតី ឥណ្ឌូណេស៊ី៖ អាស៊ាន ត្រូវតែ បង្ហាញ សាមគ្គីភាព លើ ការដោះស្រាយ វិបត្តិ នៅ មីយ៉ាន់ម៉ា
៤៖ ប្រទេស នៅ អាមេរិក ខាងត្បូង មួយ ទៀត គ្រោង ប្រើប្រាស់ ប្រាក់ យ៉ន់ របស់ ចិន សម្រាប់ ការធ្វើ ពាណិជ្ជកម្ម អន្តរជាតិ
៦៖ មន្ទីរ បញ្ចកោណ ទទួលស្គាល់ ថា អ៊ុយក្រែន ពិតជា បាញ់ ទម្លាក់ មីស៊ីល ល្បឿន លឿន ជាង សំឡេង របស់ រុស្ស៉ី ចិន និង ឡាវ កំពុង ធ្វើ សមយុទ្ធ យោធា រួមគ្នា នៅ ប្រទេស ឡាវ ដើម្បី ពង្រឹង សមត្ថភាព និង បង្កើន ចំណង មិត្តភាព រវាង កងទ័ព ទាំង ពីរ
ឧត្តមសេនីយ ទោ Yang Wenlin មេបញ្ជាការ រង នៃ ក្រុម ទី៧៥ នៃ បញ្ជាការ ភាគ ខាងត្បូង នៃ កងទ័ព រំដោះ ប្រជាជន ចិន បាន និយាយ ថា សមយុទ្ធ រួម ចិន - ឡាវ ២០២៣ បម្រើ ជា វេទិកា សម្រាប់ ការផ្លាស់ប្តូរ បទពិសោធន៍ រវាង កងទ័ព ទាំង ពីរ ក៏ ដូចជា វិធានការ ជាក់ស្តែង ព្រមទាំង ពង្រឹង ទំនាក់ទំនង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ។
សមយុទ្ធ រួមគ្នា ត្រូវបាន ធ្វើឡើង លើ សេណារីយ៉ូ នៃ ការវាយប្រហារ រួមគ្នា លើ ក្រុម ឧក្រិដ្ឋ ជន ប្រដាប់អាវុធ ឆ្លង ដែន ដែល ឈរ ជើង នៅ តំបន់ ភ្នំ នៃ ព្រៃ ។
ក្នុង អំឡុង ពេល សមយុទ្ធ នេះ ក៏ មាន ការរៀបចំ ព្រឹត្តិការណ៍ ដូចជា ការប្រកួត កីឡា បាល់បោះ ទាញ ព្រាត់ និង ការសម្តែង វប្បធម៌ ដើម្បី បង្កើន ចំណង មិត្តភាព រវាង កងទ័ព ទាំង ពីរ ផងដែរ ៕
១៖ សម្តេច តេជោ ហ៊ុន សែន៖ ការពង្រឹង សហគមន៍ អាស៊ាន មិន ត្រូវ ធ្វើឲ្យ ប៉ះពាល់ ដល់ គោលការណ៍ គ្រឹះ ទាំងឡាយ ដែល មាន ចែង ក្នុង ធម្មនុញ្ញ អាស៊ាន ឡើយ
២៖ ធនាគារ ពិភពលោក អនុម័ត គម្រោង តម្លៃ ៦០ លាន ដុល្លារ គាំទ្រ ដល់ ការកែលម្អ ការគ្រប់គ្រង សំរាម សំណល់ រឹង និង ប្លាស្ទិក នៅ កម្ពុជា
៣៖ លោក ហ្សេលេន ស្គី ចង់ ប្រើ ពេល រង់ចាំ រថក្រោះ និង រថ ពាស ដែក បន្ថែម ទៀត មុន បើក ប្រតិបត្តិការ វាយ បក ដើម្បី កាត់បន្ថយ ការពលី ជីវិត របស់ កងទ័ព
៥៖ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន នឹង ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ការពារ ជាតិ ពេល ទៅដល់ ប៉ា ពូអាស៉ី នូវែលហ្គីណេ ក្នុង ខែ នេះ
៦៖ ទំហំ ពាណិជ្ជកម្ម រវាង កម្ពុជា និង ទីផ្សារ អន្តរជាតិ សម្រេចបាន ជាង ១៥ ពាន់ លាន ដុល្លារ នៅ ៤ខែ ដើម ឆ្នាំ នេះ . កម្ពុជា នាំចេញ បាន ជាង ៧ ពាន់ លាន ដុល្លារ
៧៖ ម៉ិក ស៉ិក ថា អាមេរិក បាន បណ្តេញ ជន ចំណាកស្រុក ជិត ៣លាន នាក់ នៅក្រោម ចំណាត់ការរឹតត្បិត កូវីដ១៩
១០៖ នាយក រដ្ឋមន្ត្រី ឥណ្ឌា លោក ម៉ូឌី គ្រោង ធ្វើ ទស្សនកិច្ច ទៅ ជួប លោក ចូ បៃ ដិន ដល់ សេតវិមាន នៅ ខែមិថុនា
១១៖ ទាហាន រុស្ស៉ី ២នាក់ ត្រូវបាន ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ដោយសារ មិន ព្រម ទៅ ប្រយុទ្ធ ក្នុង សង្រ្គាម នៅ អ៊ុយក្រែន
១២៖ អាមេនី និង អាស៊ែ បៃហ្សង់ ចោទ គ្នា ទៅ វិញ ទៅ មក អំពី ការវាយប្រហារ ឆ្លង ព្រំដែន ខណៈ កំពុង ស្ថិត ក្នុង ការចរចា គ្នា ដើម្បី បញ្ចប់ ជម្លោះ
១៣៖ ប្រធានាធិបតី ឥណ្ឌូណេស៊ី៖ អាស៊ាន ត្រូវតែ បង្ហាញ សាមគ្គីភាព លើ ការដោះស្រាយ វិបត្តិ នៅ មីយ៉ាន់ម៉ា
១៤៖ នាយក រដ្ឋមន្ត្រី ហ្វាំងឡង់ លោកស្រី សាន់ ណា ម៉ារីន ប្រកាស លែងលះ ជាមួយ ស្វាមី
១៥៖ មន្ទីរ បញ្ចកោណ ទទួលស្គាល់ ថា អ៊ុយក្រែន ពិតជា បាញ់ ទម្លាក់ មីស៊ីល ល្បឿន លឿន ជាង សំឡេង របស់ រុស្ស៉ី
១៦៖ សហរដ្ឋ អាមេរិក យល់ព្រម ផ្ទេរ ជា លើក ដំបូង នូវ ទ្រព្យសម្បត្តិ រឹបអូស ពី មហាសេដ្ឋី រុស្ស៉ី ទៅ ឱ្យ អ៊ុយក្រែន
១៧៖ លទ្ធផល កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤២ នៅ ទីក្រុង ឡាប៊ូន បាចូ ប្រទេស ឥណ្ឌូនេស៊ី
១៖ កំពូល តារា សម្ដែង ឈិន ឡុង ទម្លាយ ថា លោក ពិបាក ក្នុង ការនិយាយ ជាមួយ ក្មេង ៗ បច្ចុប្បន្ន ពេល ថត ភាពយន្ត ព្រោះ មិន យល់ ពី ភាសា របស់ ពួកគេ
២៖ ឥណ្ឌា ផ្តល់ ជំនួយ ១០ពាន់ លាន ដុល្លារ ដល់ ក្រុមហ៊ុន ផលិត ឈីប ក្នុង ស្រុក ដើម្បី ពង្រីក និង បង្កើន លទ្ធភាព ផលិត
មន្ត្រី សាលាក្រុង បាន និយាយ ថា អ្នក រងរបួស ភាគ ច្រើន គឺជា ក្មេង ដែល មាន អាយុ ចន្លោះ ពី ១៤ ទៅ ១៥ ឆ្នាំ ដែល កំពុង ធ្វើដំណើរ ទៅ សាលារៀន ។ គ្រូ របស់ ពួកគេ ក៏ ស្ថិត ក្នុង ចំណោម អ្នករបួស ដែរ ។
ប៉ូលិស បាន និយាយ ថា បុគ្គលិក សន្តិសុខ បាន ឃាត់ខ្លួន ជនសង្ស័យ ហើយ ប្រគល់ ឱ្យ សមត្ថកិច្ច ដោយ មិន មាន ការប្រឆាំង ត ដៃ ឡើយ ។
អាជ្ញាធរ ក៏ បាន គូសបញ្ជាក់ ផងដែរ ថា ឧបទ្ទវហេតុ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ប្រហែល ០៧: ៤៥ នាទី ម៉ោង ក្នុង តំបន់ ។
ទោះជា យ៉ាងណា ពាក់ព័ន្ធ នឹង ហេតុផល នៃ ការវាយប្រហារ នេះ កំពុង ស្ថិត ក្រោម ការស៊ើបអង្កេត នៅឡើយ ៕
បង្ក្រាប គ្រឿងញៀន ឃាត់ខ្លួន ជនសង្ស័យ ៤នាក់ រឹបអូស ថ្នាំ ញៀន និង សារធាតុ គីមី ផ្សំ ជិត ៨០ គីឡូក្រាម នៅ ខេត្ត តាកែវ
( តាកែវ )៖ កម្លាំង ជំនាញ ការិយាល័យ ប្រឆាំង ការប្រើប្រាស់ គ្រឿងញៀន ខុស ច្បាប់ ( ក៤ ) នៃ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន សហការ ជាមួយ ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ និង ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន បើក ប្រតិបត្តិការ បង្ក្រាប បទល្មើស គ្រឿងញៀន ដោយ ចាប់ខ្លួន ជនសង្ស័យ ចំនួន ៤នាក់ រឹបអូស ថ្នាំ ញៀន ព្រមទាំង សារធាតុ គីមី ផ្សំ ជិត ៨០ គីឡូក្រាម នៅ ភូមិ តា សូ ឃុំ ឧត្តម សូរិយា ស្រុក ត្រាំ កក់ ខេត្ត តាកែវ ។
ការបង្ក្រាប នេះ អនុវត្ត តាម បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការ រង ទទួល ផែន ប្រឆាំង បទល្មើស គ្រឿងញៀន និង ឧត្តមសេនីយ៍ ឯក ឃឹង សារ៉ាត់ នាយក មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ។
របាយការណ៍ របស់ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន ឲ្យដឹង ថា ប្រតិបត្តិការ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ០៩ ខែឧសភា ឆ្នាំ ២០២៣ ដោយ មាន ការសម្របសម្រួល ពី លោក ឯក ឆេង ហ៊ួត ព្រះរាជអាជ្ញា នៃ អយ្យការ អម ស សាលាដំបូង ខេត្ត តាកែវ ។
បើ តាម របាយការណ៍ របស់ គណៈកម្មការ ទី៣ នៃ យុទ្ធនាការ ប្រឆាំង បទល្មើស គ្រឿងញៀន រយៈពេល ៤ខែ ឆ្នាំ ២០២៣ នេះ កម្លាំង សមត្ថកិច្ច បង្ក្រាប បទល្មើស គ្រឿងញៀន បាន ចំនួន ២៣៤៥ ករណី ឃាត់ខ្លួន មនុស្ស ៥៥៧២ នាក់ រឹបអូស ថ្នាំ ញៀន បាន ជាង ៣៦១ គីឡូក្រាម ៕ សមត្ថកិច្ច ចម្រុះ ខេត្ត ព្រះវិហារ ចុះបង្ក្រាប ឈើ សន្និធិ ខុស ច្បាប់ ២ទីតាំង រឹបអូស បាន ជិត១០ម៉ែត្រ គូប នៅ ជាប់ ព្រំដែន ឡាវ
( ព្រះវិហារ ) ៖ កម្លាំង សមត្ថកិច្ច ចម្រុះ ខេត្ត ព្រះវិហារ រួម មាន កម្លាំង មន្ត្រី ឧទ្យាន នុរក្ស ស្នាក់ការ កំពង់ សង្កែ កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ព្រះវិហារ និង ផ្នែក សឹក រង ឆែប បាន ចុះបង្ក្រាប ការធ្វើ សន្និធិឈើ ខុស ច្បាប់ ចំនួន ២ទីតាំង ដោយ ធ្វើ ការរឹបអូស ឈើ បាន ជិត១០ម៉ែត្រ គូប ។
បច្ចុប្បន្ន ឈើ ខុស ច្បាប់ ទាំង ២ទីតាំង ខាងលើ ត្រូវបាន កម្លាំង សមត្ថកិច្ច ចម្រុះ ប្រើប្រាស់ គោយន្ត កន្ត្រៃយ៍ ចំនួន ៤គ្រឿង ដឹក យកមក រក្សាទុក នៅ ស្នាក់ការអូកា ប៉ុក និង ស្នាក់ការភ្នំ សង្កែ ។
ពាក់ព័ន្ធ នឹង ការឈាន ទៅ បង្រ្កាប បាន ឈើ ខុស ច្បាប់ ទាំង ២ទីតាំង ខាងលើ នេះ មន្ត្រី មួយ រូប និយាយ ថា គឺ ដោយសារ ប្រជាពលរដ្ឋ រក សុី ដង ជ័រ ទឹក ជា អ្នក ប្រាប់ ហើយ ប្រជាពលរដ្ឋ និយាយ ថា ក្នុង មួយ សប្តាហ៍ ៗ ឈើ ដឹក ចេញ តាម រថយន្ត ដឹក ដំឡូង ប្រមាណ ៥គ្រឿង ។ ជាមួយនឹង ការបង្កាប ឈើ ដែល រក្សាទុក ក្រោយ ប៉ុស្តិ៍ នគរបាល ព្រំដែន គោក ណាំ សាម ប្រហែល១០០ ម៉ែត្រ នេះ លោក មេ ប៉ុស្តិ៍ ណាំ សាម និយាយ ថា ឈើ ទាំង នេះ ទុក ធ្វើ ផ្ទះ ជូន កងកម្លាំង ៕
នាវា ចម្បាំង ឥណ្ឌា ពីរ គ្រឿង ចូល ចត កំពង់ផែ ក្រុង ព្រះសីហនុ ដេីម្បី ធ្វើ ទស្សនកិច្ច ពង្រឹង មិត្ដភាព និង កិច្ចសហប្រតិបត្ដិការ យោធា កម្ពុជា - ឥណ្ឌា
ក្រោយពី មាន ការពិភាក្សា រវាង បុគ្គលិក កងទ័ព ជើងទឹក ឥណ្ឌា និង កងទ័ព ជើងទឹក កម្ពុជា (RCN) មក ក៏ មាន កម្មវិធី ចូល ជួប សម្តែង ការគួរសម ជា ផ្លូវការ និង ការប្រាស្រ័យទាក់ទង ជាមួយ ឥស្សរជន របស់ រដ្ឋាភិបាល កម្ពុជា និង ការរៀបចំ ដំណើរ ទេសចរណ៍ សម្រាប់ បុគ្គលិក កងទ័ព ជើងទឹក ឥណ្ឌា និង ព្រឹត្តិការណ៍ កីឡា ជាមួយ កងទ័ព ជើងទឹក កម្ពុជា ។
នាវា នេះ ក៏ នឹង បើក ឱ្យ ចូល ទស្សនា ពីសំណាក់ មន្ត្រី និង ទាហាន ជើង ទឹក នៃ កងទ័ព ជើងទឹក កម្ពុជា សេនានុព័ន្ធ ការពារ បរទេស និង មន្ត្រី កងរាជអាវុធហត្ថ និង កំពង់ផែ ផងដែរ ។ ទំនាក់ទំនង ទ្វេ ភាគី រវាង ឥណ្ឌា និង កម្ពុជា មាន ភាពរឹងមាំ តាមរយៈ ទំនាក់ទំនង វប្បធម៌ ទំនាក់ទំនង ឥណ្ឌា - កម្ពុជា ត្រូវបាន ពង្រឹង ក្នុង ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ទាំង សាសនា និង សេដ្ឋកិច្ច ដោយសារ ការកើនឡើង នៃ ការចូលរួម របស់ ភាគី ទាំង ពីរ លើ គ្រប់ វិស័យ ។
ក្នុង ឱកាស នោះ លោក សួន សេរី រដ្ឋា ប្រធាន ក្រុមប្រឹក្សាភិបាល វេទិកា សន្តិភាព កម្ពុជា បាន លើក រំលឹក ឡើង អំពី ប្រវត្តិ នៃ ការកសាង សន្តិភាព អំពី គុណ តម្លៃ នៃ សន្តិភាព ព្រម ជាមួយ នូវ កាតព្វកិច្ច របស់ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង ការចូលរួម ការពារ សន្តិភាព ដែល ជា មរតក នយោបាយ ប្រវត្តិសាស្ត្រ របស់ សម្តេច តេជោ ហ៊ុន សែន អគ្គ មគ្គុទ្ទេស សន្តិភាព នៃ កម្ពុជា ។
ខ្លឹមសារជា រួម នៃ វេទិកា សាធារណៈ នេះ គឺ វេទិកា សន្តិភាព កម្ពុជា បាន ដាក់ចេញ នូវ ពាក្យស្លោក ចំនួន ៣ឃ្លា គឺ ៖ ១. សូម បងប្អូន ចេញ ទៅ បោះឆ្នោត ដើម្បី សន្តិភាព . ២. ប្រើ សន្លឹក ឆ្នោត បងប្អូន ការពារ សន្តិភាព និង ៣. ការពារ សន្តិភាព ដើម្បី បន្ត ការអភិវឌ្ឍ ។
នា ចុងបញ្ចប់ កម្មវិធី មុន ទទួលទាន អាហារ សាមគ្គី បងប្អូន លោក តា លោកយាយ ប្រជាពលរដ្ឋ ព្រមទាំង យុវជន អ្នកគ្រប់ អាយុ បោះឆ្នោត ទាំងអស់ ដែល បាន អញ្ជើញ ចូលរួម បាន លើក ដៃ ប្តេជ្ញា ថា៖ ពួកគាត់ ទាំងអស់ គ្នា នឹង ចេញ ទៅ បោះឆ្នោត ទាំងអស់ គ្នា ! ហើយ បោះឆ្នោត ដើម្បី ការពារ សន្តិភាព … ៕
សម្តេច តេជោ ហ៊ុន សែន៖ អាយុ គ្រាន់តែ ជា តួរ លេខ ប៉ុណ្ណោះ . អាយុ ច្រើន កម្លាំង មាន ធ្វើ ការ បាន ច្រើន ត្រូវ ឆ្លៀត ហាត់ប្រាណ ដោយ លេង កីឡា
សម្តេច បាន លើកឡើង ថា៖ « មុន នេះ ឮ គេ និយាយ ថា អាយុ គ្រាន់តែ ជា តួរ លេខ ប៉ុណ្ណោះ ។ ប្រាកដ មែន ម្សិលមិញ សម្រាប់ ខ្ញុំ ប្រើ ពេល ១៥ ម៉ោង ពី ពេល ស្លៀកពាក់ ពេលព្រឹក រហូត ពេល ដោះ សម្លៀកបំពាក់ ពេល យប់ ។ ថ្ងៃ នេះ ព្រឹក ប្រជុំ នៅ ក្រុង ឡាប៊ួន បាចូ ប្រទេស ឥណ្ឌូនេសុី ល្ងាច វាយ កូនគោល នៅ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល កម្ពុជា » ។
សម្តេច បាន បន្ត ទៀត ថា៖ « អាយុ ច្រើន កម្លាំង មាន ធ្វើ ការ បាន ច្រើន ត្រូវ ឆ្លៀត ហាត់ប្រាណ ដោយ លេង កីឡា ។ ប្រទេស យើង កំពុង ប្រកួត កីឡា សុី ហ្គេម លើក ទី ៣២ ដែល កំពុង ប្រព្រឹត្តទៅ យ៉ាង រលូន ។ កីឡា រស់ ក្នុង សន្តិភាព . សន្តិភាព សម្រាប់ ទាំងអស់ គ្នា . ទាំងអស់ គ្នា ដើម្បី សន្តិភាព »៕
ពិធី នេះ មាន សភាព ឱឡារិក ហើយ ត្រូវ ចំណាយ ទ្រព្យធន ច្រើន គេ តែង រៀបចំ ចូល គ្នា ដោយ មាន ក្មេងស្រី ប្រុស ច្រើន នាក់ ដោយ គ្រាន់តែ មាន លក្ខខណ្ឌ ប្រសិនបើ ធ្វើ ចូល គ្នា គឺ ចំនួន ក្មេង ដែល កោរ ជុក ត្រូវតែ ជា ចំនួន សេស ។ ពិធី កោរ ជុក នេះ គេ ធ្វើឡើង មាន រយៈពេល ២ថ្ងៃ ១យប់ ដោយ មាន កិច្ច សំខាន់ ៗ ជាច្រើន ។
បុរាណវិទូ និង ជា ប្រធាន នាយកដ្ឋាន ស្រាវជ្រាវ បណ្ដុះបណ្ដាល ផ្សព្វផ្សាយ នៃ អាជ្ញាធរ ជាតិ អប្សរា លោក អ៉ឹ ម សុខ រិទ្ធី បាន ឱ្យដឹង ថា ពិធី កោរ ជុក គឺជា ពិធី ឆ្លង វ័យ ពោលគឺជា ពិធី ដែល បញ្ជាក់ ពី ដំណាក់កាល សំខាន់ ៗ នៃ ជីវិត មនុស្ស ម្នាក់ ៗ ដែល ខ្មែរ បុរាណ ធ្វើឡើង សម្រាប់ ក្មេងស្រី ប្រុស ឬ ជំទង់ ពុំ ទាន់ ពេញ វ័យ ដើម្បី ឈានចូល ពេញ វ័យ ។
លោក អ៉ឹ ម សុខ រិទ្ធី បាន បន្ត ថា ពិធី កោរ ជុក នេះ ជា ពិធី ដែល ខ្មែរ បុរាណ រៀបចំឡើង បង្ហាញ ពី ដំណើរ ជីវិត មនុស្ស ដែល បាន វិវត្តន៍ ពី ដំណាក់កាល នីមួយ ៗ នៃ វដ្ត របស់ មនុស្ស ។ ជា កិច្ច បង្ហាញ ពី ការឆ្លង វ័យ ដែល ប្រពៃណី ខ្មែរ កំណត់បញ្ចូល កុលបុត្រ កុល ធីតា របស់ ខ្លួន ឱ្យ ក្លាយទៅជា សមាជិក គ្រួសារ ខ្លួន ដែល ពេញ វ័យ ទៅក្នុង សង្គម ស្រប តាម ច្បាប់ ប្រពៃណី យ៉ាង ពេញលេញ ។
គោលបំណង ចម្បង នៃ ពិធី កោរ ជក់ នេះ គឺ ដើម្បី ញែក ភេទ របស់ ក្មេងស្រី និង ក្មេងប្រុស ឱ្យ ដាច់ ពី គ្នា ហើយ បន្ទាប់មក ក្មេងប្រុស នឹង ចេញ ទៅ រៀនសូត្រ ស្វែងរក ចំណេះ វិជ្ជា រីឯ ក្មេងស្រី នឹង ចូល ទៅ រក ចំណេះ ខាង សេដ្ឋកិច្ច របៀប គ្រប់គ្រង គ្រួសារ ជាដើម ៕ រដ្ឋមន្ដ្រី សុខាភិបាល ទទួល ជួប សម្ដែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ ប្រធាន ប្រតិភូ សាធារណរដ្ឋ ឆែក មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន អនុញ្ញាតឱ្យ លោក Petr Gandalovic ប្រធាន នាយកដ្ឋាន សហប្រតិបត្តិការ អភិវឌ្ឍន៍ និង ជំនួយ មនុស្សធម៌ នៃ ក្រសួង ការបរទេស សាធារណរដ្ឋ ឆែក ចូល ជួប សវនាការ និង ពិភាក្សា ការងារ ក្នុង ឱកាស លោក និង គណៈប្រតិភូ អញ្ជើញ មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ។
ជំនួប ពិភាក្សា ការងារ នេះ បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០២៣ នៅ ទីស្តីការ ក្រសួង សុខាភិបាល ។ជា កិច្ច ចាប់ផ្តើម លោក រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន សម្ដែង មនោសញ្ចេតនា ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ ប្រធាន ប្រតិភូ និង ថ្លែងអំណរគុណ ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន ឆែក ដែល បាន ចូលរួមចំណែក គាំទ្រ វិស័យ សុខាភិបាល តាមរយៈ គម្រោង មួយចំនួន ជាច្រើ នៅ កម្ពុជា ។
គម្រោង ទាំងនោះ រួម មាន៖ * អនុស្សរណៈ យោគយល់ គ្នា រវាង ក្រសួង សុខាភិបាល កម្ពុជា និង ស្ថានទូត នៃ សាធារណ រដ្ឋ ឆែក ស្តីពី ការគាំពារ សុខភាព ទារក នៃ មន្ទីរពេទ្យ កុមារ ជាតិ ។
* គម្រោង សាងសង់ មណ្ឌល សុខភាព ចំនួន ០៣ គឺ មណ្ឌល សុខភាព រាម អណ្តើក មណ្ឌល សុខភាព ធ្លាប្រជុំ និង មណ្ឌល សុខភាព ត្រពាំងក្រញូង និង អគារ សម្ភព ក្នុង មន្ទីរពេទ្យ បង្អែក កោះ អណ្តែត និង ការបណ្ដុះបណ្ដាល មន្ត្រី សុខាភិបាល ខេត្ត តាកែវ ដោយ ការប្រើប្រាស់ ថវិកា បង្វែរ ពី បំណុល របស់ កម្ពុជា ទៅជា ជំនួយ ឥត សំណង ។
* គម្រោង ផ្តល់ សម្ភារៈ បរិក្ខារ ឧបករណ៍ វេជ្ជសាស្ត្រ សម្រាប់ ជួយសង្គ្រោះ ជីវិត ទារក ទើបនឹង កើត រួមទាំង ការបណ្តុះបណ្តាល ជូន មន្ទីរពេទ្យ កុមារ ជាតិ ។
* គម្រោង ផ្តល់ សម្ភារៈ បរិក្ខារ ឧបករណ៍ វេជ្ជសាស្ត្រ សម្រាប់ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ នៅ តាម មូលដ្ឋាន សុខាភិបាល សាធារណៈ មួយចំនួន នៅក្នុង ខេត្ត កំពង់ឆ្នាំង ។
លោក រដ្ឋមន្ត្រី សុខាភិបាល ក៏ បាន សម្តែង នូអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជាថ្មី ម្តង ទៀត ចំពោះ ការជួយ ឧបត្ថម្ភ គាំទ្រ របស់ រដ្ឋាភិបាល និង ប្រជាជន ឆែក ដែល បាន ចូលរួមចំណែក អភិវឌ្ឍន៍ វិស័យ សុខាភិបាល ឱ្យ មាន ការរីកចម្រើន រហូតមកដល់ បច្ចុប្បន្ន ក្នុង ស្មារតី សាមគ្គីភាព មិត្តភាព ជា ប្រពៃណី និង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ។
អភិបាល ខេត្ត កែប៖ កំពង់ផែ សេះ ស សម្រេចបាន ប្រមាណ ៧០ ភាគរយ គ្រោង បញ្ចប់ នៅពេល ឆាប់ ៗ ខាងមុខ . ខណៈ កំពង់ផែ ថ្មី មួយ ទៀត កំពុង ស្នើសុំ វិនិយោគ
ក្នុង សន្និសីទ សារព័ត៌មាន របស់ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ស្ដីពី « ភាពជោគជ័យ រយៈពេល ៥ ឆ្នាំ របស់ រដ្ឋបាល ខេត្ត កែប » លោក សោម ពិសិដ្ឋ បាន អះអាង ថា ទន្ទឹង នឹង កំពង់ផែ សេះ ស ដែល កំពុង ដំណើរការ សាងសង់ នេះ ក៏ មាន កំពង់ផែ ថ្មី មួយ ទៀត ក៏ កំពុង ស្នើសុំ ធ្វើ ការ វិនិយោគ ដោយ វិស័យ ឯកជន ផងដែរ ។
អភិបាល ខេត្ត កែប បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « កំពង់ផែ សេះ ស យើង បាន សាងសង់ ប្រមាណ ៦០ ទៅ ៧០ ភាគរយ ហើយ នៅសល់ បន្ដ នឹង បញ្ចប់ ១០០ ភាគរយ នៅពេល ឆាប់ ខាងមុខ ។ ទន្ទឹមនឹង ផែ ដែល កំពុង ដំណើរការ កសាង កំពង់ផែ មួយ ទៀត កំពុង ស្នើសុំ វិនិយោគ ដី សាធារណៈ របស់ រដ្ឋ ផងដែរ ក្នុង ការកសាង កំពង់ផែ ដឹក ទំនិញ មួយ ទៀត » ។
បើ តាម លោក សោម ពិសិដ្ឋ ទំហំ នៃ ការវិនិយោគ កំពង់ផែ ថ្មី បន្ថែម មួយ ទៀត នេះ មាន តម្លៃ ប្រហែលជាង ១លាន ដុល្លារ ។ ក្នុង នាម រដ្ឋបាល ខេត្ដ លោក បាន អះអាង ថា នឹង ខិតខំ គៀរ គរ អ្នក វិនិយោគ ពិតប្រាកដ ដើម្បីឲ្យ ចរន្ដ នៃ ការផ្លាស់ប្ដូរ ទំនិញ ផ្លូវ ទឹក ឲ្យបាន ល្អ ប្រសើរ ជាង មុន ជៀសវាង ការប្រើប្រាស់ ផ្លូវគោក ដែល អាច មាន ផល ប៉ះពាល់ ច្រើន ។
គួរ ជម្រាប ថា ទីតាំង សាងសង់ កំពង់ផែ សេះ ស ស្ថិត ក្នុង សង្កាត់ អូរ ក្រសារ ក្រុង កែប ខេត្ត កែប នៅលើ ផ្ទៃដី ៨ហិកតា ។ គម្រោង នេះ ស្ថិត ក្នុង គម្រោង សាងសង់ ប្រតិបត្តិការ និង ផ្ទេរ (BOT) រយៈពេល ១៥ ឆ្នាំ វិនិយោគ ដោយ វិស័យ ឯកជន ។ កំពង់ផែ នេះ នឹង ជួយ សម្រួល ដល់ ការដឹកជញ្ជូន ទំនិញ និង កសិផល រវាង ខេត្ត កែប និង កំពត ពិសេស ដឹក វត្ថុធាតុ ដើម បម្រើ ឲ្យ រោងចក្រ នានា នៅក្នុង ខេត្ត កំពត ។
បើ តាម លិខិត របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ចុះ ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២១ គម្រោង នេះ ត្រូវ ចំណាយ ទុន វិនិយោគ ជិត ២លាន ដុល្លារ ហើយ អនុញ្ញាតឲ្យ រំលស់ ទុន មកវិញ តាមរយៈ ការធ្វើ អាជីវកម្មភាស៊ី ចំណត ជល យាន ( កំពង់ផែ សេះ ស ) ក្នុង រយៈពេល ១៥ ឆ្នាំ ចប់ នឹង បន្ត ១៥ ឆ្នាំ ទៀត គិត ចាប់ពី ចំណត ជល យាន បាន សាងសង់ រួច និង សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ឆ្នាំ ២០២៣ ។
ទាក់ទិន គម្រោង សាងសង់ ជាក់ស្ដែង តំណាង លោក អ៉ឹង កូវ ហៃ ដែល ជា ម្ចាស់ ក្រុមហ៊ុន វិនិយោគ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News បន្ថែម ថា ជា ការពិត គម្រោង សាងសង់ កំពង់ផែ សេះ ស នេះ គ្រោង នឹង បញ្ចប់ នៅ ឆ្នាំ ២០២៣ នេះ ប៉ុន្ដែ គម្រោង ទាំងមូល ត្រូវបាន ពន្យា ពេល ដោយសារ ឧបសគ្គ មួយចំនួន ដូចជា វិបត្តិ ជំងឺ កូវីដ១៩ . វិបត្តិ សេដ្ឋកិច្ច សកល និង កត្តា ធម្មជាតិ ដោយសារ ភ្លៀង ធ្លាក់ ប៉ះពាល់ ដល់ ដំណើរការ សាងសង់ ។
តំណាង ក្រុមហ៊ុន វិនិយោគ កំពង់ផែ សេះ ស បាន បន្ដ ទៀត ថា ដោយសារ ផល ប៉ះពាល់ មួយចំនួន នោះ ការសាងសង់ ដែល ត្រូវ បញ្ចប់ ទាំងស្រុង នោះ នឹង ត្រូវ ពន្យា ពេល ទៅដល់ អំឡុង ឆ្នាំ ២០២៤ ខណៈ បច្ចុប្បន្ន សំណង់ ភាគ ច្រើន ត្រូវបាន សាងសង់ រួចរាល់ ។ សំណង់ កំពង់ផែ សេះ ស ដែល បាន សាងសង់ រួច នោះ រួម មាន៖ ការឈូសឆាយ សម្អាត ការដ្ឋាន . ចាក់ បំពេញ ទីលាន កំពង់ផែ . សាងសង់ ផែ បេតុង ជញ្ជាំង ទប់ ដី គ្រឹះ . ផ្លូវ ទឹក . អគារ ស្នាក់ការ ជាដើម ។
យ៉ាងណាមិញ បើ ទោះបី ជួប នូវ ផល ប៉ះពាល់ មួយចំនួន ក្ដី តែ តំណាង ក្រុមហ៊ុន វិនិយោគ កំពង់ផែ សេះ ស នៅតែ បង្ហាញ ពី ការប្ដេជ្ញាចិត្ត ខ្ពស់ ក្នុង ការខិតខំ ប្រឹងប្រែង បំពេញ ការងារ ដែល នៅ សេសសល់ ឲ្យបាន កាន់តែ ឆាប់ តាម ដែល អាច ធ្វើ ទៅ បាន ៕
ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ធំ ឧបត្ថម្ភ អង្ករ ចំនួន ៣តោន ជូន បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ សម្រាប់ សកម្មភាព មនុស្សធម៌
( កំពង់ធំ )៖ នៅ ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០២៣ លោក ស៊ិន វីរៈ ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ធំ បាន ដឹកនាំ សហការី នាំយក អង្ករ ចំនួន ៣តោន មក ប្រគល់ ជូន បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ សម្រាប់ បន្ត សកម្មភាព មនុស្សធម៌ ជួយ ដល់ អតីត យុទ្ធជន និង ប្រជាជន ដែល មាន ជីវភាព លំបាក ខ្វះខាត នៅក្នុង ខេត្ត កំពង់ធំ ។
