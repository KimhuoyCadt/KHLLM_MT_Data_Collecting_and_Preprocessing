( ភ្នំពេញ ) ៖ លោក ថា យ៉ាវ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ចុះ ស្រុក ស្ទោង លើកឡើង ថា គណបក្ស ប្រជាជន កម្ពុជា នៅតែ ទទួលស្វាគមន៍ ជានិច្ច ចំពោះ បងប្អូន ដែល ស្ម័គ្រចិត្ត ដោយ ស្មោះ ចូលមក រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
ការបញ្ជាក់ របស់ លោក ថា យ៉ាវ ធ្វើឡើង ក្នុង ពិធី ប្រកាស ទទួលស្គាល់ សមាជិក ថ្មី ចំនួន ៩០៤ នាក់ មកពី ឃុំ ២ របស់ ស្រុក ស្ទោង គឺ ឃុំ ចំណារ ក្រោម និង ឃុំ សំព្រោ ជ ជា សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ស្រុក ស្ទោង ធ្វើ នៅ ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២៣ ។
លោក ថា យ៉ាវ បាន លើកឡើង ថា ក្នុង នាម ប្រធាន ក្រុមការងារ ចុះ ជួយ ខេត្ត កំពង់ធំ និង ក្រុមការងារ ចុះ ជួយ ស្រុក ស្ទោង សូម ការស្វាគមន៍ ចំពោះ សមាជិក ថ្មី ទាំង ៩០៤ រូប និង បាន ចាត់ទុក ការចូលមក រួមរស់ ក្នុង ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា របស់ បងប្អូន ទាំង ៩០៤ នាក់ ជា ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ បំផុត ព្រោះ បច្ចុប្បន្ន នេះ មិន មាន គណបក្ស នយោបាយ ណាមួយ មាន គោល នយោបាយ ច្បាស់លាស់ ក្នុង ការដឹកនាំ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន ដូច គណបក្ស ប្រជាជន កម្ពុជា នោះ ទេ ។
លោក ប្រធាន ក្រុមការងារ រូប នេះ នូវ បាន ចាត់ទុក ការចូលរួម របស់ សមាជិក សមាជិកា ថ្មី ទាំង ៩០៤ នាក់ នា ពេលនេះ គឺជា បង្ហាញ ឲ្យ ឃើញ យ៉ាង ច្បាស់ ការជឿជាក់ និង ការគាំទ្រ ចំពោះ ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
តាម រយ : សមាជិក ថ្មី នេះ ក៏ បាន បង្កើន កម្លាំង គណបក្ស ប្រជាជន កម្ពុជា កាន់តែ មាន កម្លាំង កាន់តែ ខ្លាំងក្លា ថែម ទៀត ក្នុង ការបំពេញ ភារកិច្ច បម្រើ ជាតិ ប្រជាជន និង ការអភិវឌ្ឍ ប្រទេស ។
លោក ថា យ៉ាវ បាន បង្ហាញ ឲ្យ សមាជិក យើង បាន ដឹង ពី ភាពរីកចម្រើន របស់ ប្រទេស នា រយ: ពេល ៥ឆ្នាំ ចុងក្រោយ ផងដែរ ក្រោម ការដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ពិសេស តម្លៃ នៃ សន្តិភាព ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្ដេច តេជោ ហ៊ុន សែន ៕
គ.ជ. ប៖ ១៣ ថ្ងៃ បក្ស នយោបាយ ចំនួន ៨ ត្រូវ ប្រកាស ទទួលស្គាល់ ជា ផ្លូវការ ខណៈ គណបក្ស ៦ផ្សេង ទៀត កំពុង ស្ថិត ក្នុង ការត្រួតពិនិត្យ សម្រាប់ ការចូលរួម បោះឆ្នោត
( ភ្នំពេញ ) ៖ លទ្ធផល បណ្ដោះអាសន្ន នៃ ការចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត និង បញ្ជី បេក្ខជន ឈរឈ្មោះ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ គិត ត្រឹម ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២៣ វេលា ម៉ោង ៥៖៣០ នាទី ល្ងាច មាន គណបក្ស នយោបាយ ចំនួន ១៤ បាន ដាក់ពាក្យ សុំ ចុះបញ្ជី ក្នុង នោះ គណបក្ស ចំនួន ៨ ត្រូវបាន គ.ជ. ប សម្រេច ទទួលស្គាល់ ជា ផ្លូវការ និង គណបក្ស ចំនួន ៦ ផ្សេង ទៀត កំពុង ស្ថិត ក្នុង ការពិនិត្យ ។
គណបក្ស នយោបាយ ទាំង៨ ដែល ត្រូវបាន ប្រកាស ទទួលស្គាល់ ជា ផ្លូវការ រួម មាន៖
ទី១៖ គណបក្ស ប្រជាជន កម្ពុជា ទី២៖ គណបក្ស យុវជន កម្ពុជា ទី៣៖ គណបក្ស ខ្មែរ រួបរួម ជាតិ ទី៤៖ គណបក្ស ធម្មាធិបតេយ្យ ទី៥៖ គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ ទី៦៖ គណបក្ស សញ្ជាតិ កម្ពុជា ទី៧៖ គណបក្ស ខ្មែរ តែ មួយ ទី៨៖ គណបក្ស ខ្មែរ អភិរក្ស
ខណៈ គណបក្ស នយោបាយ ចំនួន ០៦ ផ្សេង ទៀត កំពុងតែ ពិនិត្យ រួម មាន៖
ទី១៖ គណបក្ស ហ៊្វុនស៊ិនប៉ិច ទី ២៖ គណបក្ស សំបុក ឃ្មុំ សង្គម ប្រជាធិបតេយ្យ ទី៣៖ គណបក្ស ឯកភាព ជាតិ ខ្មែរ ទី៤៖ គណបក្ស បំណង ពលរដ្ឋ ទី៥៖ គណបក្ស ស្ត្រី ដើម្បី ស្ត្រី និង ទី៦៖ គណបក្ស ខ្មែរ ឈប់ ក្រ
ការចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត និង បញ្ជី បេក្ខជន ឈរឈ្មោះ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ ឆ្នាំ ២០២៣ មាន រយៈពេល ១៥ ថ្ងៃ គឺ ចាប់ពី ថ្ងៃទី ២៤ ខែមេសា រហូតដល់ ថ្ងៃទី ៨ ខែឧសភា ឆ្នាំ ២០២៣៕ ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន ទទួល សញ្ញាបត្រ ដាន់ កម្រិត ៩ដាន់ ពី សហព័ន្ធ ការ៉ាតេ ពិភពលោក
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន សហព័ន្ធ កីឡាការ៉ាតេកម្ពុជា នៅ ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន ទទួល សញ្ញាបត្រ ដាន់ កម្រិត ៩ ដាន់ ពី សហព័ន្ធ ការ៉ាតេ ពិភពលោក ។
លោក ឧប នាយក រដ្ឋមន្រ្តី បាន ថ្លែង ថា លោក ពិតជា មាន កិត្តិយស និង សេចក្តីរំភើប យ៉ាង ក្រៃលែង ដោយ បាន ទទួល នូវ សញ្ញាបត្រ ដាន់ កម្រិត ៩ ដាន់ ពី សហព័ន្ធ ការ៉ាតេ ពិភពលោក ។ ការផ្តល់ នូវ សញ្ញាបត្រ ដាន់ . កម្រិត ៩ ដាន់ នេះ បង្ហាញ ពី ការជឿទុកចិត្ត របស់ សហព័ន្ធ ការ៉ាតេ ពិភពលោក ចំពោះ រូប លោក ក៏ ដូចជា ឆ្លុះបញ្ចាំង ពី ទំនាក់ទំនង ដ៏ ល្អ រវាង សហព័ន្ធ ការ៉ាតេ ពិភពលោក និង សហព័ន្ធ កីឡាការ៉ាតេកម្ពុជា ។
ជាមួយនឹង ការទទួលបាន នូវ សញ្ញាបត្រ ដាន់ . កម្រិត ៩ដាន់ ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន សូម សម្តែង នូវ អំណរគុណ និង ការដឹង គុណ ចំពោះ លោកគ្រូបង្វឹក . បងប្អូន កីឡាករ ការ៉ាតេ និង ក្រុមគ្រួសារ របស់ លោក ដែល តែងតែ បាន ជំរុញ និង លើកទឹកចិត្ត ដល់ រូបលោក រហូត ទទួលបាន នូវ សមិទ្ធផល គួរ ជា ទី មោទនៈ នា ថ្ងៃ នេះ ៕
ថ្នាំ ញៀន ជាង ១គីឡូក្រាម និង ជនសង្ស័យ ៩នាក់ ត្រូវបាន បង្ក្រាប បាន នៅ ខណ្ឌ ជ្រោយ ចង្វារ
( ភ្នំពេញ ) ៖ ថ្នាំ ញៀន ជាង ១គីឡូក្រាម និង ជនសង្ស័យ ជា ជនជាតិ ខ្មែរ និង វៀតណាម ចំនួន ៩នាក់ ត្រូវ មន្ទីរ ប្រឆាំង គ្រឿងញៀន ចុះបង្ក្រាប បាន នៅ ២ទីតាំង ផ្សេង គ្នា ក្នុង ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ។
មន្ត្រី ជាន់ ខ្ពស់ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន បាន ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ៦ ខែឧសភា នេះ ថា ការចុះបង្ក្រាប ខាងលើ នេះ ធ្វើឡើង កាលពី ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២៣ វេលា ម៉ោង ១៤៖ ២០នាទី ដោយ កម្លាំង ជំនាញ ការិយាល័យ ប្រឆាំង បទល្មើស គ្រឿងញៀន ឆ្លង ដែន ( ក៥ ) នៃ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង ត្រូវ សមត្ថកិច្ច ជំនាញ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន បាន កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ តាម នីតិវិធី ៕ អំណោយ របស់ នាយ ឧត្ដមសេនីយ៍ នេត សាវឿន ត្រូវបាន ប្រគល់ ជូន ប្រជាពលរដ្ឋ ទីទ័ល ក្រ ៥០ គ្រួសារ . សិស្សានុសិស្ស ១០០ នាក់ និង ឧបត្ថម្ភ កៅអី ប្រជុំ ចំនួន ៥០ ជូន អធិការដ្ឋាន នគរបាល ស្រុក កញ្ជ្រៀច
ក្នុង ឱកាស នេះ អំណោយ របស់ នាយ ឧត្ដមសេនីយ៍ នេត សាវឿន ក៏ ត្រូវបាន ចែកជូន ប្រជាជន ទ័ល ក្រ ៥០ គ្រួសារ ក្នុង ១គ្រួសារ ទទួលបាន អង្ករ ១០គីឡូក្រាម ថវិកា ០៥ ម៉ឺន រៀល មី១ កេស និង ទឹកត្រី ទឹកស៊ីអ៊ីវ ត្រីខ ១យួរ . សិស្សានុ សិស្ស បថម ១០០ នាក់ ក្នុង ១នាក់ ទទួលបាន ថវិកា ៥ពាន់ រៀល កាតាប១ និង សម្ភារៈ សិក្សា ជាច្រើន មុខ និង ប្រគល់ កៅអី ប្រជុំ ចំនួន ៥០ ដល់ អធិការដ្ឋាន នគរបាល ស្រុក កញ្ជ្រៀច ( ធ្វើ នៅ សាល ប្រជុំ នគរបាល ស្រុក ) ។
ពិធី ប្រគល់ សញ្ញាបត្រ ត្រូវបាន ធ្វើឡើង នៅ ទី៦ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ទៅដល់ និស្សិត ដែល បាន បញ្ចប់ ការសិក្សា ថ្នាក់ បរិញ្ញាបត្រ និង បរិញ្ញាបត្រ ជាន់ ខ្ពស់ ទាំង កម្មវិធី ទទួលបាន សញ្ញាបត្រ មួយ និង សញ្ញាបត្រ ពីរ លើ ជំនាញ ផ្សេង ៗ គ្នា ដូចជា ស្ថាបត្យកម្ម ពាណិជ្ជកម្ម វិស្វកម្ម សំណង់ ស៊ីវិល កិច្ចការ សកល ការគ្រប់គ្រង ព័ត៌មានវិទ្យា និង ច្បាប់ ។
លោក បាន បន្ថែម ថា៖ « ភាពច្នៃប្រឌិត អាច ជា ការបង្កើត នូវ កម្មវិធី កំព្យូទ័រ ថ្មី បង្កើត កម្មវិធី ទូរស័ព្ទ ថ្មី បង្កើត ប្រភេទ អាជីវកម្ម ថ្មី បង្កើត វិធី ថ្មី ក្នុង ការស្វែងរក ទីផ្សារ សម្រាប់ ផលិតផល ឬ សេវាកម្ម ការផ្តល់ វិធី ថ្មី ក្នុង ការដោះស្រាយ បញ្ហា ឬ ផ្តល់ វិធី ថ្មី ដើម្បី បង្កើត និង ចែករំលែក ភាពរីកចម្រើន … វា អាច ជួយ ឱ្យ យើង បង្កើត ពិភពលោក ដ៏ ល្អ ប្រសើរ មួយ សម្រាប់ ខ្លួន យើង និង អ្នកដទៃ » ។
លោក បណ្ឌិត Leos បាន បន្ថែម ទៀត ថា លោក មាន ទំនុកចិត្ត ទៅ លើ និស្សិត បញ្ចប់ ការសិក្សា នា ពេលនេះ ដែល បាន រៀបចំ និង ត្រៀមខ្លួន ជាស្រេច ដើម្បី ប្រឈមមុខ នឹង ការប្រកួតប្រជែង នៃ ភាពច្នៃប្រឌិត និង ការបង្កើត ថ្មី ដែល ជា ផ្នែក មួយ សម្រាប់ ការសម្រប ខ្លួន និង ការរីកចម្រើន នៅក្នុង ពិភពលោក ដែល កំពុង ផ្លាស់ប្តូរ យ៉ាង ឆាប់រហ័ស ។
ជាមួយនឹង ចក្ខុវិស័យ ក្នុង ការក្លាយជា សាកលវិទ្យាល័យ គំរូ ដើម្បី ជួយ ដល់ ប្រទេស កម្ពុជា ក្នុង ការអភិវឌ្ឍន៍ ធនធាន មនុស្ស ក៏ ដូចជា បណ្តុះបណ្តាល យុវជន ជំនាន់ ថ្មី ដែល ជា អ្នក ចេះ ត្រិះរិះ ពិចារណា អ្នកច្នៃប្រឌិត និង អ្នកដឹកនាំ ប្រកបដោយ ក្រមសីលធម៌ ដើម្បី បម្រើ ប្រទេស កម្ពុជា និង ពិភពលោក សាកលវិទ្យាល័យ AUPP បាន ផ្តល់ ជូន កម្មវិធី សិក្សា បែប អាមេរិក ស្រប តាម ស្តង់ដារ អន្តរជាតិ ចាប់តាំងពី ឆ្នាំ ២០១៣ ។
គ្រូបង្រៀន ផ្នែក ប្រវត្តិ វិទ្យា នៅ ខេត្ត តាកែវ លោក គៀន ពន្លក បាន ចូលរួម សកម្មភាព នយោបាយ ជាមួយ គណបក្ស សង្គ្រោះ ជាតិ នៅ ឆ្នាំ ២០១២ ។ លោក ត្រូវបាន អតីត បក្ស សង្គ្រោះ ចាត់តាំង ឱ្យ ធ្វើជា ប្រធាន ការិយាល័យ បណ្តុះបណ្តាល របស់ក្ស ។ នៅ ក្រោយពេល បក្ស សង្គ្រោះ ជាតិ ត្រូវបាន តុលាការ កំពូល រំលាយ នៅ ឆ្នាំ ២០១៧ លោក គៀន ពន្លក តាមរយៈ តួនាទី ក្នុង អង្គការ សង្គម ស៊ីវិល ក៏ នៅតែ បន្ត ជួយ បក្ស ប្រឆាំង ដោយ ប្រយោល ថែម ទៀត ។
នៅ ពេល នេះ លោក គៀន ពន្លក បាន សម្រេចចិត្ត ដើរ ចេញ ពី ក្រុម បក្ស ប្រឆាំង ដែល ដឹកនាំ ដោយ លោក សម រង្ស៉ី ហើយ ។ ហេតុផល របស់ លោក ពន្លក ក៏ មិន ខុសពី សមាជិក ឬ សកម្មជន របស់ បក្ស ប្រឆាំង ដទៃ ទៀត នោះ ដែរ ។ ការដើរ ចេញ របស់ លោក គឺ ការបាត់បង់ ជំនឿ ចំពោះ ការដឹកនាំ របស់ លោក សម រង្ស៉ី ជាពិសេសន យោ បាយ ខ្វះ ការទទួលខុសត្រូវ ចំពោះ ជោគវាសនា ជាតិ ក៏ ដូចជា ការខ្វះ ការទទួលខុសត្រូវ លើ សុខ ទុក្ខ របស់ អ្នកគាំទ្រ ក៏ ដូចជា សកម្មជន ។
មកដល់ ពេលនេះ មាន អ្នកគាំទ្រ សកម្មជន ដែល ធ្លាប់ តែ គាំទ្រ ជន ក្បត់ ជាតិ កាន់តែ ច្រើន ហើយ បាន សម្រេចចិត្ត ដើរ ចេញ ពី ទណ្ឌិត សម រង្ស៉ី និង បក្ខពួក ។ មិន ត្រឹមតែ អ្នក ក្នុង ស្រុក នោះ ទេ សូម្បីតែ អ្នកគាំទ្រ នៅ អឺរ៉ុប និង សហរដ្ឋ អាមេរិក ក៏ បាន ដើរ ចេញ ពី ទណ្ឌិត សម រង្ស៉ី និង បក្ខពួក កាន់តែ ច្រើន ផងដែរ ។
សម្រាប់ លោក ពន្លក បាន មើលឃើញ ថា ចរន្ត នេះ កំពុងតែ ធ្វើឱ្យ ត្រកូល ក្បត់ ជាតិ ៣ជំនាន់ សម រង្ស៉ី កាន់តែ ឯកោ ប្រៀប ដូចជា ចង្កៀង ជិត អស់ ប្រេង ឬ ភ្លើង ទៀន ជិត រលត់ ។
រដ្ឋមន្រ្តី វង សូត៖ សាសនា រស់ នៅក្នុង សន្តិភាព ពិតជា មាន តម្លៃ មិន អាច កាត់ថ្លៃ បាន និង នាំមក នូវ ការរីកចម្រើន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ
( ត្បូងឃ្មុំ ) ៖ លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន លើកឡើង ថា សាសនា រស់ នៅក្នុង សន្តិភាព ពិតជា មាន តម្លៃ មិន អាច កាត់ថ្លៃ បាន ក្នុង ការជួយ ផ្សព្វផ្សាយ អប់រំ ប្រជាពលរដ្ឋ នាំមក នូវ ការរីកចម្រើន និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ជា បន្តបន្ទាប់ ដូច្នេះ យើង ត្រូវ រួមគ្នា ថែរក្សា និង បន្ត ការអភិវឌ្ឍ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា បច្ច ប្បន្ន បន្ត ទៀត ។
ការថ្លែង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែរ លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ និង លោកជំទាវ បាន អញ្ជើញ ក្នុង ពិធី សម្ពោធ ឆ្លង សាឡុំ និង សមិទ្ធផល នានា តម្លៃ ជិត ៤ម៉ឺន ដុល្លារ នៅ វត្ត ន ទី ជ័យ មង្គល ( ហៅ វត្ត ស្ទឹង ជ័យ ) ស្ថិត ក្នុង ឃុំ ពពេល ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២៣ ។
រដ្ឋមន្ត្រី វង សូត មានប្រសាសន៍ បន្ត ថា យើង ទាំងអស់ គ្នា អាច ប្រារព្ធ ពិធី ដ៏ វិសេសវិសាល នេះ បាន ដោយសារ កត្តា ប្រទេស កម្ពុជា យើង មាន សុខ សន្តិភាព ដោយ ប្រទេស កម្ពុជា យើង អាច និយាយ ពាក្យ ថា សន្តិភាព នេះ បាន ពោលគឺ ស្ថានភាព ប្រទេសជាតិ មាន សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ល្អ មាន ស្ថិរភាព នយោបាយ មាន ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ទាំង វិស័យ ពុទ្ធ ចក្រ និង អាណាចក្រ ។
លោក បាន បន្ត ថា ដូច្នេះ យើង ទាំងអស់ គ្នា ត្រូវ ចងចាំ ពាក្យ ថា សន្តិភាព ដោយ ពាក្យ ថា សន្តិភាព នេះ ហើយ ធ្វើឱ្យ កម្ពុជា របស់ យើង មាន ឱកាស បង្កើត នូវ ព្រឹត្តិការណ៍ ឬ ពិធី បុណ្យ ផ្សេង ៗ ដោយ ភាពសប្បាយរីករាយ នៅ គ្រប់ មូលដ្ឋាន ក្នុង ខេត្ត ក្រុង ស្រុក ទាំងអស់ នេះ ហើយ ដោយឡែក នៅក្នុង ខេត្ត ត្បូងឃ្មុំ របស់ យើង នេះ អាច ប្រារព្ធ ពិធី នានា ជាក់ស្តែង ការប្រារព្ធ ពិធី វិសាខ បូជា នា ពេលនេះ បាន គឺ ដោយសារ ពាក្យ ថា សន្តិភាព ។
ម្យ៉ាងទៀត សាសនា រស់ នៅ សន្តិភាព ពិតជា មាន តម្លៃ មិន អាច កាត់ថ្លៃ បាន ប្រទេស មាន សុខ សន្តិភាព ទើប ធ្វើអោយ មាន ការអភិវឌ្ឍន៍ ទាំង វិស័យ ពុទ្ធ ចក្រ និង អាណាចក្រ មាន ការរីកចម្រើន មកដល់ ពេល បច្ច ប្បន្ន នេះ អរគុណ សន្តិភាព និង សូម ទៅ បោះឆ្នោត ជូន សម្ដេច តេជោ ឲ្យបាន គ្រប់ ៗ គ្នា នា ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ជូន សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នៅ អាណត្តិ បន្តបន្ទាប់ និង សូម គាំទ្រ ឯកឧត្តម ហ៊ុន ម៉ាណែត ជា បេក្ខជន បន្ត វេណ ដើម្បី បន្ត ការអភិវឌ្ឍ ប្រទេសជាតិ បន្ថែម ទៀត ។
ជាមួយគ្នា នោះ រដ្ឋមន្ត្រី វង សូត បាន បញ្ជាក់ ថា នៅ ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២៣ ដោយ ប្រទេស កម្ពុជា យើង បាន បើក នូវ កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ និង កីឡា ប៉ារ៉ាហ្គេម លើក ទី ១២ ដែល នេះ ជា ព្រឹត្តិការណ៍ ដ៏ អស្ចារ្យ ខ្លាំង ណាស់ សម្រាប់ ព្រះរាជាណាចក្រ កម្ពុជា យើង ដោយ រងចាំ រយៈពេល ប្រមាណ ៦៤ ឆ្នាំ សម្រាប់ កម្ពុជា យើង ធ្វើជា ម្ចាស់ ផ្ទះ កីឡា ស៊ីហ្គេម និង កីឡា ប៉ារ៉ាហ្គេម នេះ ។
រដ្ឋមន្ត្រី បាន បន្ថែម ថា ព្រឹត្តិការណ៍ ស៊ីហ្គេម និង ប៉ារ៉ាហ្គេម សម្រាប់ កម្ពុជា យើង ធ្វើជា ម្ចាស់ ផ្ទះ គឺ ពិតជា បាន លើកតម្កើង នូវ កិត្តិយស និង កេរ្តិ៍ឈ្មោះ ប្រទេសជាតិ យើង ខ្លាំងក្លា ណាស់ ដែល កម្ពុជា យើង ឈានដល់ ចំណុច នេះ គឺ ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដែល សម្តេច តែងតែ គិតគូរ ខ្លាំង ណាស់ ដល់ ប្រទេស កម្ពុជា យើង ក៏ ដូចជា យកចិត្តទុកដាក់ ដល់ ប្រជាពលរដ្ឋ យើង នៅ គ្រប់ កាលៈទេសៈ ទាំងអស់ ។
សម្លៀកបំពាក់ គឺជា ទំនិញ នាំចេញ ឧស្សាហកម្ម ធំ បំផុត របស់ ប្រទេស ស្រីលង្កា និង ទទួលបាន ប្រាក់ ចំណូល ៥. ៩៥ ពាន់ លាន ដុល្លារ ក្នុង ឆ្នាំ ២០២២ ដោយ បាន ជួយ ប្រទេស នេះ ក្នុង ពេល ដែល កំពុង ទទួលរង នូវ វិបត្តិ ហិរញ្ញវត្ថុ ដ៏ អាក្រក់ បំផុត ចាប់តាំងពី ទទួលបាន ឯករាជ្យ នៅ ឆ្នាំ ១៩៤៨ មក ដែល បង្កឡើង ដោយ ការថយចុះ ប្រាក់ បម្រុង រូបិយប័ណ្ណ បរទេស ខ្លាំង ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ដោយ ដកស្រង់ ទិន្នន័យ ពី ធនាគារ កណ្តាល របស់ ប្រទេស ស្រីលង្កា ថា លទ្ធផល ឧស្សាហកម្ម កាត់ដេរ នៅ ត្រីមាស ទី១ នៅ ឆ្នាំ ២០២៣ បាន ជួប ការលំបាក ដោយ ការនាំចេញ វាយន ភណ្ឌ និង សម្លៀកបំពាក់ ធ្លាក់ចុះ ១៣. ៨ភាគរយ មក នៅ ត្រឹម ១.៣ ពាន់ លាន ដុល្លារ ។
លោក បាន ប្រាប់ ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ថា៖ « ដោយសារ ការធ្លាក់ចុះ តម្រូវការ ដែល យើង កំពុង មើលឃើញ នៅ ពេល នេះ ការធ្លាក់ចុះ ការនាំចេញ ១ពាន់ លាន ដុល្លារ នៅ ឆ្នាំ នេះ សម ហេតុផល » ។
ទិន្នន័យ ចុងក្រោយ របស់ JAAF បាន បង្ហាញ ថា ការនាំចេញ ទៅកាន់ សហរដ្ឋ អាមេរិក ដែល ជា អ្នកទិញ ដ៏ ធំ បំផុត របស់ ប្រទេស ស្រីលង្កា បាន ធ្លាក់ចុះ ២២ ភាគរយ មក នៅ ត្រឹម ៤៧០ លាន ដុល្លារ នៅក្នុង ត្រីមាស ទី មួយ ។ ការនាំចេញ ទៅកាន់ សហភាព អឺរ៉ុប បាន ធ្លាក់ចុះ ១៣ភាគរយ មក នៅ ត្រឹម ៣៤៤ លាន ដុល្លារ ខណៈ ដែល ការនាំចេញ ទៅកាន់ ចក្រភព អង់គ្លេស បាន ធ្លាក់ចុះ ១០ ភាគរយ មក ត្រឹម ១៦៧. ៧លាន ដុល្លារ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ៕
