( កំពង់ឆ្នាំង ) ៖ ពិធី អបអរសាទរ ទិវា សេរីភាព អ្នកសារព័ត៌មាន សាកលលោក លើក ទី៣០ ក្រោម អធិបតីភាព លោកស្រី កែ ច័ន្ន មុន្នី អ្នកតំណាងរាស្ត្រ មណ្ឌល កំពង់ឆ្នាំង លោក ហ៉ឹង ចូច អនុប្រធាន មន្ទីរព័ត៌មាន ខេត្ត កំពង់ឆ្នាំង លោក ទូច លី ហួត អភិបាល រង ក្រុង កំពង់ឆ្នាំង ដែល មាន ការចូលរួម ពី មន្ត្រីរាជការ និង អ្នកសារព័ត៌មាន ក្នុង ខេត្ត សរុប ជា ១០០ នាក់ ដែល ពិធី នេះ បាន ប្រារព្ធ ធ្វើឡើង នៅ អាហារដ្ឋាន ចំការលាភ ស្ថិត ក្នុង ភូមិ ទី៧ សង្កាត់ ខ្សាម ក្រុង កំពង់ឆ្នាំង ។
ទិវា សេរីភាព អ្នកសារព័ត៌មាន ពិភពលោក អ្នកសារព័ត៌មាន ខេត្ត កំពង់ឆ្នាំង តែងតែ បាន ប្រារព្ធ ធ្វើជា រៀងរាល់ ឆ្នាំ ដោយ មាន ការគាំទ្រ និង ចូលរួម ពី ថ្នាក់ដឹកនាំ ខេត្ត មន្ទីរ អង្គភាព មួយចំនួន នៅ ជុំវិញ ខេត្ត រួម និង អ្នកសារព័ត៌មាន ក្នុង ខេត្ត ជាច្រើន ។
ដោយឡែក លោក ហ៉ឹង ចូច អនុប្រធាន មន្ទីរព័ត៌មាន ខេត្ត កំពង់ឆ្នាំង បាន ឲ្យដឹង ថា ឆ្នាំ នេះ ជា ខួប លើក ទី៣០ នៃ ទិវា សេរីភាព សារព័ត៌មាន ពិភពលោក ទិវា នេះ ប្រារព្ធ ធ្វើឡើង ដើម្បី រំលឹក ពី វីរភាព របស់ អ្នកសារព័ត៌មាន ដែល បាន លះបង់ នូវ កម្លាំង កាយ ចិត្ត ក្នុង ការផ្សព្វផ្សាយ ព័ត៌មាន ជូន ប្រជាពលរដ្ឋ គ្រប់ ជាតិ សាសន៍ នៅលើ ពិភពលោក ។
លោក បន្ត ទៀត ថា អ្នកសារព័ត៌មាន ត្រូវ ចងចាំ និង អនុវត្ត ឲ្យបាន នៅ ក្រមសីលធម៌ វិជ្ជាជីវៈ ក្នុង ពេល បំពេញ បេសកកម្ម លើ អាជីព សារព័ត៌មាន ដើម្បី ចៀស ផុត ពី បញ្ហា ប្រឈម នានា ដូច ប្រសាសន៍ របស់ លោក ខៀវ កាញារិទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ដែល បាន លើកឡើង ថា ក្រមសីលធម៌ និង វិជ្ជាជីវៈ ជា អាវ ក្រោះ ដ៏ រឹងមាំ សម្រាប់ អ្នកសារព័ត៌មាន នៅ ពេល ដែល យើង គោរព និង អនុវត្ត ឲ្យបាន ត្រឹមត្រូវ ។
លោកស្រី អ្នកតំណាងរាស្ត្រ ក៏ បាន ផ្ដាំផ្ញើ ដល់ អ្នកសារព័ត៌ មាន ក្នុង ខេត្ត ទាំងអស់ សូម មេត្តា បន្ត យកចិត្តទុកដាក់ ក្នុង ការផ្សព្វផ្សាយ ព័ត៌មាន ប្រកបដោយ វិជ្ជាជីវៈ ដើម្បី រួមចំណែក ជាមួយនឹង រាជ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍន៍ ខេត្ត របស់ យើង ឱ្យ មាន ភាពរីកចម្រើន និង សូម អនុវត្ត តាម ពាក្យស្លោក របស់ សម្ដេច តេជោ ហ៊ុន សែន មួយ ឃ្លា ថា « អ្នកសារព័ត៌មាន ត្រូវ ផ្សព្វផ្សាយ ព័ត៌មាន ពិត កុំ ប្រឌិត កំហុស ដាក់ អ្នកដទៃ » ។
សូម បញ្ជាក់ ថា នៅក្នុង ពិធី អបអរសាទរ ទិវា សេរីភាព អ្នកសារព័ត៌មាន ខាងលើ នេះ ក៏ មាន ចែក អំណោយ និង ថវិកា មួយ ចំនួន ដល់ គ្រួសារ អ្នកសារព័ត៌មាន ដែល បាន ស្លាប់ និង មាន ជីវភាព ក្រីក្រ ចំនួន ៤គ្រួសារ ដោយឡែក នៅ ពេលល្ងាច ក៏ មាន ការទទួលទាន អាហារ សាមគ្គី ប្រកបដោយ ភាពរីករាល រីករាយ ផងដែរ ៕
សម្តេច ម៉ែន សំអន៖ វិស័យ ឯកជន បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការជំរុញ កំណើន សេដ្ឋកិច្ច កម្ពុជា
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច ក្នុង ឱកាស អញ្ជើញ ពិធី សម្ពោធ ជា ផ្លូវការ ផ្ទះ គំរូ គម្រោង ទី៣ បុរី មេគង្គ លែន ស្ថិត តាម បណ្តោយ ផ្លូវ ជាតិ ៦អា សង្កាត់ ព្រែក លៀប រាជធានី ភ្នំពេញ នា ថ្ងៃទី ៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ថ្លែង ថា វិស័យ ឯកជន បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការជំរុញ កំណើន សេដ្ឋកិច្ច កម្ពុជា ។
សម្តេច កិត្តិសង្គហ បណ្ឌិត សង្ឃឹម យ៉ាង ម៉ុត មាំ ថា គម្រោង នេះ ពិតជា រួមចំណែក អភិវឌ្ឍ រាជធានី ភ្នំពេញ និង ជម្រុញ នូវ ល្បឿន នៃ កំណើន សេដ្ឋកិច្ច តាមរយៈ នៃ ការផ្ដល់ បទពិសោធន៍ ល្អ ៗ ផ្នែក ខាង វិស្វកម្ម និង ស្ថាបត្យកម្ម ដល់ កម្ពុជា ព្រមទាំង ជួយ ផ្តល់ ការងារ និង ចំណូល ដល់ កម្មករ និង បុគ្គលិក កម្ពុជា ជាច្រើន ផងដែរ ។ គំរោង ដែល ជា ការវិនិយោគទុន នេះ ពិតជា កើតឡើង ចំ ពេល ដែល កម្ពុជា កំពុង មាន ស្ថានភាព សេដ្ឋកិច្ច និង ស្ថេរភាព នយោបាយ ល្អ និង គោល នយោបាយ គាំទ្រ ដល់ អាជីវកម្ម ។
សម្តេច បាន បន្ត ទៀត ថា រាជធានី ភ្នំពេញ បាន នឹង កំពុង ក្លាយទៅជា មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម មួយ ដ៏ ទាក់ទាញ និង រស់រវើក ដែល មាន សកម្ម ភាព អាជីវកម្ម ម មាញឹក មាន ហាង លក់ ទំនិញ និង សំណង់ ធំ ៗ ស្ពាន អាកាស ជាពិសេស អគារ ខ្ពស់ ៗ ជាច្រើន កំពុងតែ សាងសង់ និង រីក ដុះដាល យ៉ាង ឆាប់រហ័ស បម្រើ ដល់ ការប្រកប អាជីវកម្ម ស្នាក់ នៅ ។
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ប្រធាន គណៈកម្មាធិការ គណបក្ស រាជធានី ភ្នំពេញ និង ជា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ខណ្ឌ ព្រែក ព្នៅ បាន ជំរុញឱ្យ មន្ត្រី បក្ស ប្រជាជន ទាំងអស់ យកចិត្តទុកដាក់ មើល ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ សមាជិក បក្ស និង ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន មាន ន័យ ថា ពេល ពួកគាត់ ជួប បញ្ហា ខ្វះខាត យើង ត្រូវ ជួយ ពួកគាត់ ភ្លាម ៗ ។
ការជំរុញ បែប នេះ របស់ លោក ឃួង ស្រេង បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ០៧ ឧសភា ឆ្នាំ ២០២៣ នេះ កិច្ចប្រជុំ ជីវភាព គណបក្ស ខណ្ឌ និង ក្រុមការងារ ចុះ ជួយ ខណ្ឌ ព្រែក ព្នៅ ប្រចាំ ខែឧសភា និង ទិសដៅ ខែមិថុនា ឆ្នាំ ២០២៣ នៅ ទីស្នាក់ការ មន្ទីរ គណបក្ស ខណ្ឌ ព្រែក ព្នៅ ដោយ មាន ការចូលរួម ពី មន្ត្រី និង សមាជិក បក្ស ជាង ២០០ នាក់ ។
លោកបាបញ្ជាក់ ថា កម្ពុជា មាន អនាម័យ បរិស្ថាន ល្អ នោះ សុខភាព ប្រជាពលរដ្ឋ ក៏ បាន ល្អ រឹងមាំ មាន កម្លាំង កំហែង ខ្លាំ ក្លា ក្នុង ការដឹកនាំ កម្ពុជា ឆ្ពោះ ទៅរក ភាពរីកចម្រើន រុងរឿង ។
សម្ដេច វិបុល សេនា ភក្តី សាយ ឈុំ ផ្ញើ សារលិខិត អបអរសាទរ ជូន សម្តេច តេជោ ហ៊ុន សែន ដែល ទទួលបាន មេដាយ មរតក អូឡាំពិក អន្តរជាតិ
( ភ្នំពេញ ) ៖ សម្ដេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា កម្ពុជា ក្នុង នាម ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ព្រឹទ្ធសភា ទាំងអស់ បាន ផ្ញើ សារលិខិត ចូលរួម អបអរសាទរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល ទទួលបាន មេដាយ មរតក អូឡាំពិក អន្តរជាតិ ពី គណៈកម្មាធិការ អូឡាំពិក អន្តរជាតិ (IOC) ក្នុង ពិធី បើក ព្រឹត្តិការណ៍ ស៊ីហ្គេម លើក ទី ៣២ ឆ្នាំ ២០២៣ នៅ ពហុកីឡាដ្ឋាន ជាតិ មរតក តេជោ នា ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២៣ ។
នៅក្នុង សាលិខិត សម្ដេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន លើកឡើង ថា ប្រជាជាតិ កម្ពុជា ពិតជា មាន មោទនភាព ខ្ពស់ ណាស់ ដែល សម្តេច អគ្គ មហា សេនា បតី តេជោ ទទួលបាន មេដាយ មរតក អូឡាំពិក អន្តរជាតិ ដ៏ មាន គុណ តម្លៃ ជា ប្រវត្តិសាស្ត្រ របស់ កម្ពុជា និង ស័ក្តិសម បំផុត
ចំពោះ សម្តេច អគ្គ មហា សេនា បតី តេជោ ដែល ផ្តើម ចេញ ពី ស្នាដៃ នៃ ការដឹកនាំ របស់ សម្តេច ក្នុង ការ ដឹកនាំ កសាង ការអភិវឌ្ឍន៍ សង្គម កម្ពុជា ទាំងមូល ដោយ មិន ខ្លាច នឿយហត់ រហូត ទទួលបាន នូវ សិទ្ធិ សេរីភាព យ៉ាង ពេញលេញ និង ការអភិវឌ្ឍ ប្រទេសជាតិ ប្រកបដោយ កំណើន សេដ្ឋកិច្ច រឹងមាំ ។
សម្តេច មាន ជំនឿ យ៉ាង មុតមាំ ថា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ព្រះរាជាណាចក្រ កម្ពុជា និង បន្ត រីកចម្រើន ឥត ឈប់ឈរ តាម គន្លង នៃ លទ្ធិ ប្រជាធិបតេយ្យ និង មាន ភាពល្បីរន្ទឺ នៅលើ ឆាក អន្តរជាតិ ។
ក្នុង ឱកាស ដ៏ មហា ប្រសើរ ថ្លៃថ្លា នេះ សម្តេច សូម គោរព ជូនពរ សម្តេច អគ្គ មហា សេនា បតី តេជោ និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង បុត្រា បុត្រី ចៅ ប្រុស ចៅ ស្រី ទាំងអស់ របស់ សម្តេច នូវ ព្រះពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត៖ បំណងប្រាថ្នា ធំ បំផុត របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត សម្រាប់ និស្សិត អាហារូបករណ៍ អ. ម. ត គ្រប់ រូប គឺ បញ្ចប់ ការសិក្សា ដោយ ជោគជ័យ ដើម្បី កសាង អនាគត មួយ ច្បាស់លាស់ រឹងមាំ និង ត្រចះត្រចង់
ថ្លែង ក្នុង ឱកាស ដ៏ អធិកអធម នោះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន សម្តែង នូវ ការកោតសរសើរ ចំពោះ វឌ្ឍនភាព ការងារ របស់ ក្រុមការងារ គ្រប់គ្រង សិស្ស - និស្សិត អ. ម. ត ខេត្ត ព្រះសីហនុ រួម ជាមួយនឹង ការអបអរសាទរ ចំពោះ ការប្រកាស បញ្ចូល សមាជិក - សមាជិកា ថ្មី បន្ថែម ទៀត ចំនួន ៣៥៩ នាក់ នា ឱកាស នោះ ។
ទន្ទឹមនឹង នេះ លោក បណ្ឌិត ក៏ បាន ថ្លែងអំណរគុណ ដល់ គ្រឹះស្ថាន ឧត្តម សិក្សា នៅ ខេត្ត ព្រះសីហនុ រួម មាន សាកលវិទ្យាល័យ គ្រប់គ្រង និង សេដ្ឋកិច្ច (UME) . វិទ្យាស្ថាន ពហុ បច្ចេកទេស ខេត្ត ព្រះសីហនុ (PIP) និង វិទ្យាស្ថាន ពហុ បច្ចេកទេស មិត្តភាព កម្ពុជា - ចិន (PCCFPI) ដែល តែង បាន ផ្តល់ អាហារូបករណ៍ ថ្នាក់ បរិញ្ញាបត្រ រង . បរិញ្ញាបត្រ . និង បរិញ្ញាបត្រ ជាន់ ខ្ពស់ ជូន សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដើម្បី ចែកជូនសិស្ស - និស្សិត ខ្វះ លទ្ធភាព ។
លោក បន្ដ ថា កាយវិការ និង ទឹកចិត្ត ដ៏ ប្រពៃ ថ្លៃថ្លា នេះ គឺជា ការចូលរួម ចំណែក មួយ យ៉ាង សំខាន់ ក្នុង ការកសាង នូវ ពន្លក អនាគត ច្បាស់លាស់ រឹងមាំ និង ត្រចះត្រចង់ មួយ សម្រាប់ ពួកគេ តាមរយៈ ការទទួលបាន ឱកាស ចាប់ យក អាជីព ការងារ ល្អ ប្រសើរ នៅពេល បញ្ចប់ ការសិក្សា ដោយ នេះ គឺជា បំណងប្រាថ្នា ធំ បំផុត របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត សម្រាប់ និស្សិត អាហារូបករណ៍ អ. ម. ត គ្រប់ រូប ។
ជា ចុងក្រោយ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ចែករំលែក និង ផ្តាំផ្ញើ នូវ ទស្សនា ទាន អំពី ផ្នត់គំនិត និង ទម្លាប់ នៃ ការកសាង អភិវឌ្ឍ ខ្លួន ដែល និស្សិត ម្នាក់ ៗ គួរ ប្រកាន់ខ្ជាប់ ដើម្បី ទទួលបាន ជោគជ័យ នៅក្នុង ការសិក្សា និង អាជីព ការងារ ៕
អ៊ុយក្រែន អះអាង ថា ខ្លួន បាន បាញ់ ស្កាត់ មីស៉ីល ល្បឿន លឿន ជាង សំឡេង របស់ រុស្ស៉ី ដោយ ប្រើ ប្រព័ន្ធ ការពារ ដែន អាកាស របស់ អាមេរិក
គណបក្ស ប្រជាជន កម្ពុជា ប្រកាស សមាសភាព ក្រុមការងារ ចុះ ជួយ ឃុំ ភ្នំ សំពៅ ស្រុក បាណន់ និង ភូមិ ទាំង១០ ដើម្បី ពង្រឹង មូលដ្ឋាន មុន ការបោះឆ្នោត
( បាត់ដំបង ) ៖ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក បាណន់ ខេត្ត បាត់ដំបង បាន កែសម្រួល ប្រកាស សមាសភាព ក្រុមការងារ គណបក្ស ចុះ ជួយ ឃុំ និង សមាសភាព ក្រុមការងារ ចុះ តាម ភូមិ ទាំង១០ ក្នុង ឃុំ ភ្នំ សំពៅ ស្រុក បាណន់ ខេត្ត បាត់ដំបង ដើម្បី រៀបចំ រចនាសម្ព័ន្ធ មុនដំណើរការបោះឆ្នោត ជ្រើង រើស តំណាងរាស្ត្រ នីតិកាទី៧ ឆ្នាំ ២០២៣ ខាងមុខ ។
ពិធី នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ០៧ ខែឧសភា ឆ្នាំ ២០២៣ ក្រោម វត្តមាន លោក ហែម ថេង សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក បាណន់ ជា ប្រធាន ក្រុមការងារ បក្ស ចុះ ជួយ ឃុំ ភ្នំ សំពៅ . អនុប្រធាន . សមាជិក ថ្នាក់ កណ្តាល ចុះ ជួយ តាម ភូមិ ទាំង១០ នៃ ឃុំ និង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា ក្រុមការងារ បក្ស មូលដ្ឋាន មួយចំនួន ចូលរួម ផងដែរ ។
បន្ទាប់ អំណាន របាយការណ៍ សេចក្តីសម្រេច របស់ ប្រធាន គណបក្ស ឃុំ ភ្នំ សំពៅ និង អាន សេចក្តីសម្រេច កែសម្រួល បំពេញ បន្ថែម និង ចាត់តាំង ថ្មី ដោយ លោក អនុប្រធាន គណបក្ស ឃុំ រួច មក ។
លោក ហែម ថេង មានប្រសាសន៍ សំណេះសំណាល ជាមួយ សមាជិក ក្នុង ពិធី ប្រកាស កែសម្រួល សមាសភាព ក្រុមការងារ ចុះ ជួយ ឃុំ ភ្នំ សំពៅ ស្រុក បាណន់ ខេត្ត បាត់ដំបង និង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រុមការងារ ចុះ ជួយ ភូមិ ទាំង១០ នៃ ឃុំ ភ្នំ សំពៅ ដែល ទើប ប្រកាស កែសម្រួល ចាត់តាំង បំពេញ បន្ថែម ថ្មី ទាំងអស់ ដោយ ក្តី សោមនស្ស រីករាយ ។
លោក ហែម ថេង ក្នុង នាម ថ្នាក់ដឹកនាំ ចុះ ជួយ មូលដ្ឋាន ទាំងអស់ សូម មេត្តា ខិតខំ ធ្វើការ នៅ មូលដ្ឋាន ឲ្យ សកម្ម បំផុត កុំ ធ្វើ ការងារ អ្វី អាង ខ្នង ត្រូវ ធ្វើ ដោយ ចេញ ដោយ បេះដូង និង កម្លាំង កាយ ចិត្ត ទាំងអស់ គ្នា ត្រូវ ធ្វើ ការងារ បក្ស ឲ្យបាន សកម្ម ខ្លាំងក្លា ជា មូលដ្ឋាន ពិសេស ចុះ ជួប សមាជិក បក្ស និង ប្រជាពលរដ្ឋ នៅ តាម ខ្នង ផ្ទះ ដើម្បី ក្តាប់ សំណូមពរ របស់ ពួកគាត់ ព្រមទាំង ជួយ ពួកគាត់ ឲ្យបាន ទាន់ ពេលវេលា ផងដែរ ។
លោក ហែម ថេង ក៏ បាន ផ្តាំផ្ញើ ដល់ អស់ ដែល មាន ឈ្មោះ ក្នុង សេចក្តីសម្រេច នេះ សូម យកចិត្តទុកដាក់ អនុវត្ត ការងារ ដែល គណបក្ស បាន ប្រគល់ ជូន ដើម្បី បម្រើ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន របស់ ខ្លួន ទទួលខុសត្រូវ និង ត្រូវ សហការ គ្នា ជាមួយ ប្រធានបក្ស ឃុំ បក្ស ភូមិ សកម្មជន បក្ស សមាជិក បក្ស ឱ្យ បាន ល្អ ប្រសើ នា មុនពេល និង ក្រោយពេល បោះឆ្នោត ។
លោក បាន ថ្លែង ថា ការប្រគល់ ភារកិច្ច ជូន ក្រុមការងារ នា ពេលនេះ គឺ ដើម្បី ពង្រឹង ការងារ បក្ស ពិសេស ចុះ ត្រួតពិនិត្យមើល ប្រជាពលរដ្ឋ នៅ តាម ខ្នង ផ្ទះ ដែល ជា សមាជិក បក្ស នូវ ជីវភាព រស់ នៅ របស់ ពួកគាត់ និង សមាជិក បក្ស ចាស់ ណា ដែល កំពុង ជួប ការលំបាក ត្រូវ ជួយ គាត់ ឱ្យ បាន ទាន់ ពេលវេលា និង ឆ្លើយតប តាម សំណូមពរ របស់ ពួកគាត់ ។
សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស សភា តំណាងរាស្រ្ត នីតិកាល ទី កាល ទី៧ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ដើម្បី ទទួលបាន ជ័យជំនះ ជូន គណបក្ស ប្រជាជន សូម បងប្អូន ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា គាំទ្រ បក្ស ប្រជាជន បាន ឈ្នះ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី បន្ត ដឹកនាំ ប្រទេស ឆ្ពោះ ទៅការកសាង និង អភិវឌ្ឍ ជាតិ កាន់តែ រីកចម្រើន ខ្លាំង និង ជឿនលឿន បាន រក្សា មរតក នេះ ទុក ជូន សម្រាប់ យុវជន បន្ត វេណ និង ប្រជាជន ជំនាន់ ក្រោយ ផងដែរ ៕
លោក ហ៊ុន ម៉ានិត អញ្ជើញ សម្ភោធ សមិទ្ធិផល នានា នៅ វត្ត និរោធ រង្សី ស្រុក កង មាស
( កំពង់ចាម ) ៖ លោក ហ៊ុន ម៉ានិត នាយក រង ខុទ្ទកាល័យ សម្តេច តេជោ តំណាង សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា រួម ជាមួយ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ៧ ខែឧសភា ឆ្នាំ ២០២៣ បាន អញ្ជើញ សម្ភោធ សមិទ្ធិផល នានា នៅ វរត្ត ពោធ រង្សី ហៅ វត្ត កន្លែង រុន ស្ថិត ក្នុង ឃុំ រាយប៉ាយ ស្រុក កង មាស ខេត្ត កំពង់ចាម ។
អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន មានប្រសាសន៍ ថា តាំងពី បុរាណ មក ទល់ បច្ចុប្បន្ន វត្ត អារាម ពុទ្ធសាសនា បាន ក្លាយជា ទីជម្រក ស្នាក់ អាស្រ័យ របស់ ក្មេង កំព្រា ជន គ្មាន ទីពឹង និង សិស្សសាលា ក្រៅពី នេះ វិស័យ ព្រះពុទ្ធ សាសនា ក៏ តែងតែ បាន ចូលរួម ជាមួយ ការងារ សង្គម កម្មវិធី មនុស្សធម៌ ទាំង ចូលរួម ដោយ ផ្ទាល់ ក៏ ដូចជា ចូលរួម តាមរយៈ អាជ្ញាធរ ខេត្ត ស្រុក និង កាកបាទ ក្រហម ជាដើម ។ល ។
តាមរយៈ ការតួនាទី ដ៏ សំខាន់ នៃ ព្រះពុទ្ធ សាសនា នៅក្នុង សង្គម ខ្មែរ ទើប ញ៉ាំង ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ ចូលរួម ប្រតិបត្តិ តាម ជំនឿ ប្រពៃណី ទំនៀមទំលាប់ និង ចូលរួម ជាមួយ ព្រះសង្ឃ គណៈកម្មការ វត្ត ដើម្បី ទ្រទ្រង់ ព្រះពុទ្ធ សាសនា បន្ត ការអភិវឌ្ឍន៍ វិស័យ ពុទ្ធសាសនា ឱ្យ បាន រីកចំរើន ទន្ទឹមនឹង ការរីកចំរើន របស់ សង្គមជាតិ ជាក់ស្តែង សំណង់ ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត បាន រីកដុះដាល នៅ តាម ទី វត្តអារាម នៅ ទូទាំង ប្រទេស ។
ក្នុង ឱកាស នោះ ផងដែរ លោក ហ៊ុន ម៉ានិត បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត មកដល់ ព្រះសង្ឃ គ្រប់ ព្រះអង្គ និង ប្រជាពលរដ្ឋ សមត្ថកិច្ច និង ថ្នាក់ដឹកនាំ ទាំងអស់ ដែល មាន វត្តមាន នៅ ទីនេះ ។
លោក ហ៊ុន ម៉ានិត បាន បន្ត ថា សមិទ្ធផល ថ្មី ៗ នៅក្នុង វត្ត និរោធ រង្សី ដែល នឹង ត្រូវកាត់ ខ្សែបូល សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នា ពេល បន្តិច ទៀត នេះ គឺជា សមិទ្ធផល ដែល បាន មកពី ការរួមគ្នា ពី សប្បុរសជន និង ការខិតខំ ប្រឹងប្រែង គៀង គរ ពីសំណាក់ ព្រះសង្ឃ គ្រប់ ព្រះអង្គ ផងដែរ ។
លោក ហ៊ុន ម៉ានិត បាន យក ឱកាស នោះ វាយតម្លៃ ខ្ពស់ និង កោតសរសើរ ចំពោះ ព្រះចៅ អធិការ វត្ត គ្រប់ ជំនាន់ ពោលគឺ ចាប់ផ្ដើម ពី ការកសាង វត្ត អារាម នេះ ប្រើ រយៈពេល ៣០ ឆ្នាំ រហូត ទទួលបាន សមិទ្ធផល យ៉ាង ច្រើន ដូច ពេល បច្ចុប្បន្ន នេះ ។
លោក ហ៊ុន ម៉ានិត បាន បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ វិស័យ អាណាចក្រ និង វិស័យ ពុទ្ធ ចក្រ បាន អភិវឌ្ឍន៍ ទន្ទឹម គ្នា ។
ប៉ុន្តែ ទន្ទឹមនឹង នេះ ប្រសិនបើ វិស័យ អាណាចក្រ មិន មាន ការអភិវឌ្ឍ ទេ នោះ ឬ ក៏ ជីវភាព បងប្អូន ប្រជាពលរដ្ឋ មិន មាន ការរីកចម្រើន ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ នោះ ទេ ក៏ គ្មាន ការចូលរួម ចែករំលែក ពីរ សប្បុរសជន ដើម្បី អភិវឌ្ឍន៍ លើ វិស័យ ពុទ្ធ ចក្រ នេះ ផងដែរ ។
ប៉ុន្តែ ដោយសារ មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ នេះ ហើយ ធ្វើឱ្យ ជីវភាព បងប្អូន ប្រជាពលរដ្ឋ យើង បាន ល្អ ប្រសើរ ទើប មាន ការចែករំលែក ពី សប្បុរសជន និង មាន ការ ជំរុញ ឲ្យ សាងសង់ នូវ សមិទ្ធផល ថ្មី ៗ តាម បណ្ដា វត្ត ផ្សេង ៗ ទៀត នៅក្នុង ភូមិសាស្ត្រ ស្រុក កង មាស ក៏ដូចជា នៅ ទូទាំង ប្រទេស កម្ពុជា យើង ៕
ព្រឹក ស្អែក ! គណៈប្រតិភូ ខេត្ត ពោធិ៍សាត់ ប្រទេស កម្ពុជា នឹង អញ្ជើញ ទស្សនកិច្ច សិក្សា នៅ ខេត្ត ត្រាត ប្រទេស ថៃ
( ពោធិ៍សាត់ )៖ តាម កម្មវិធី ដែល បាន គ្រោង ទុក បើ ពុំ មាន ការប្រែប្រួល ទេ នោះ នា ព្រឹក ថ្ងៃទី ០៨ ខែឧសភា ឆ្នាំ ២០២៣ ស្អែក នេះ គណៈប្រតិភូ ខេត្ត ពោធិ៍សាត់ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល ដឹកនាំ ដោយ ឯកឧត្តម ខូយ រីដា អភិបាល នៃ គណៈអភិបាល ខេត្ត នឹង អញ្ជើញ ធ្វើ ទស្សនកិច្ច សិក្សា រយៈពេល ២ ថ្ងៃ នៅ ខេត្ត ត្រាត នៃ ព្រះរាជាណាចក្រ ថៃ ។
ក្នុង ដំណើរទស្សនកិច្ច រយៈពេល ២ ថ្ងៃ គណៈប្រតិភូ នឹង អញ្ជើញ ចូល ជួប សម្តែង ការគួរសម រវាង ថ្នាក់ដឹកនាំ ខេត្ត ទាំង២ នៅ សាល ប្រជុំ សាលា ខេត្ត ត្រាត ។
បណ្ឌិត ហ៊ុន ម៉ាណែត អបអរសាទរ កីឡាករ ទ្រី យ៉ា ត្លុង កម្ពុជា ទើប ឈ្នះ មេដាយ ប្រាក់ ១ គ្រឿង ថែម ទៀត នៅ ព្រឹក នេះ
សូម ជម្រាប ថា កម្ពុជា កំពុង នាំមុខ គេ លើ កំពូល តារាង ដែល ទទួលបាន មេដាយ ច្រើន ជាង គេ ក្នុង ព្រឹត្តិការណ៍ ប្រកួត កីឡា ស៉ី ហ្គេម ក្នុង នាម ជា ម្ចាស់ ផ្ទះ ប្រវត្តិសាស្ត្រ របស់ ខ្លួន ៕ គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ប្រុងប្រយ័ត្ន ! ស្លាប់ ៣នាក់ និង របួស ៧នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៦ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៦លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ៧នាក់ ។
លោក ហ៊ុន ម៉ាណែត អញ្ជើញ បញ្ចុះ ខណ្ឌ សីមា និង សម្ពោធ សមិទ្ធផល នានា ក្នុង វត្ត បទុម វង្សា ហៅ វត្ត កំពង់ភ្នំ ក្រៅ ស្រុក លើក ដែក ខេត្ត កណ្តាល
( កណ្ដាល ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត តំណាង សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន អញ្ជើញ ក្នុង ពិធី បញ្ចុះ ខណ្ឌ សីមា និង សម្ពោធ សមិទ្ធផល នានា ក្នុង វត្ត បទុម វង្សា ហៅ វត្ត កំពង់ភ្នំ ក្រៅ ស្ថិត ក្នុង ភូមិ ក្បាល ជ្រោយ ឃុំ កំពង់ភ្នំ ស្រុក លើក ដែក ខេត្ត កណ្តាល ។
ពិធី បញ្ចុះ ខណ្ឌ សីមា នេះ ធ្វើឡើង នា ថ្ងៃទី ៣ ខែឧសភា ឆ្នាំ ២០២៣ ។
នា ឱកាស នោះ លោក ហ៊ុន ម៉ាណែត បាន ចូលរួម អបអរសាទរ ជាមួយ ប្រជាពលរដ្ឋ ក្នុង ឃុំ កំពង់ភ្នំ ស្រុក លើក ដែក ក៏ ដូចជា នៅ ទូទាំង ខេត្ត កណ្តាល ចំពោះ សមិទ្ធផល ថ្មី ៗ ជាច្រើន ដែល បាន និង កំពុង រីកលូតលាស់ បន្ថែម ទៀត ក្នុង វត្ត បទុម វង្សា ហៅ វត្ត កំពង់ភ្នំ ក្រៅ ក្រោម ស្មារតី រួបរួម គ្នា ប្រកបដោយ សទ្ធា ជ្រះថ្លា និង សប្បុរស របស់ ពុទ្ធ បរិស័ទ ជិត ឆ្ងាយ ព្រម ជាមួយនឹង ការគាំទ្រ បង្ក លក្ខណៈ គ្រប់ បែបយ៉ាង ពីសំណាក់ រាជ រដ្ឋាភិបាល និង អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ ។
ព្រះអង្គម្ចាស់ ឆាលស៍ (Charles) បាន ក្លាយជា ព្រះមហាក្សត្រ អង់គ្លេស ដោយ មាន គោរមងារ ថា « ព្រះមហាក្សត្រ ឆាល ទី៣» និង ជា ព្រះមហាក្សត្រ ដែល មាន វ័យ ចំណាស់ ជាង គេ ដែល បាន ឡើងគ្រងរាជ្យ ក្នុង ប្រវត្តិសាស្ត្រ អង់គ្លេស នា រយៈពេល ជាង ១០០០ ឆ្នាំ មក នេះ ។
អង្គប្រជុំ បាន ធ្វើ ការបូកសរុប ត្រួតពិនិត្យ ការអនុវត្ត សេចក្តីសម្រេចចិត្ត នៃ មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស របស់ គណបក្ស ប្រជាជន កម្ពុជា កាលពី ថ្ងៃទី ២៨ - ២៩ ខែមករា ឆ្នាំ ២០២៣ នៅក្នុង ក្របខណ្ឌ នៃ មូលដ្ឋាន ស្រុក មុខ កំពូល ដើម្បី ការពារ សន្តិភាព និង រួមគ្នា កសាង សង្គម - សេដ្ឋកិច្ច កម្ពុជា ឆ្ពោះ ទៅរក អនាគត មួយ ដ៏ ត្រះចះត្រចង់ រុងឿង ។
ជា រួម អង្គប្រជុំ បាន ធ្វើ ការវាយតម្លៃ ថា គណបក្ស ប្រជាជន កម្ពុជា នៅតែ នាំមុខ និង មាន ប្រៀប ដោយសារ គុណ បំណាច់ និង ស្នាដៃ ជា ប្រវត្តិសាស្រ្ត ជាច្រើន រាប់ មិន អស់ រហូតដល់ ហ៊ាន ប្រថុយ ជីវិត ផ្ទាល់ខ្លួន របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល ជា ប្រធាន គណបក្ស និង ជា ប្រមុខ នៃ រាជ រដ្ឋ ភិបាល ដើម្បី បុព្វហេតុ រំដោះ ប្រទេសជាតិ និង សន្តិភាព នៅ កម្ពុជា ព្រមទាំង ការស្តារ និង ការកសាង - អភិវឌ្ឍន៍ ប្រទេសជាតិ ពី បាត ដៃ ទទេ រហូតដល់ សម្រេចបាន នូវ វិបុលភាព និង វឌ្ឍនភាព លើ គ្រប់ វិស័យ ដូច បច្ចុប្បន្ន ។
ទន្ទឹម នេះ ជោគជ័យ ដ៏ ធំធេង របស់ កម្ពុជា នៅក្នុង ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ និង ការដោះស្រាយ ផល ប៉ះពាល់ នៃ ជំងឺ នេះ មក លើ អាជីវកម្ម និង ជីវភាព ប្រជាជន ក៏ ដូចជា ការយកចិត្តទុកដាក់ ដោះស្រាយ ជីវភាព ប្រជាជន ដែល ទទួលរង ផល ប៉ះពាល់ ដោយសារ កក្តា ផ្សេង ៗ គឺ បាន ឆ្លុះបញ្ចាំង យ៉ាង ច្បាស់ ថា សម្តេច តេជោ ហ៊ុន សែន គឺជា អគ្គ មហា បុរស រដ្ឋ ដ៏ ឆ្នើម គ្មាន ពីរ របស់ កម្ពុជា ។
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម និង លោកជំទាវ គឹង ចាន់ ឌី បរិច្ចាគ ថវិកា ១០លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម អនុប្រធាន និង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា និង លោកជំទាវ គឹង ចាន់ ឌី បាន បរិច្ចាគ ថវិកា ចំនួន ១០លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
រដ្ឋមន្ត្រី លឹម គាន ហោ ចុះ ពិនិត្យ វឌ្ឍនភាព ការសាងសង់ សាលារៀន អនុវិទ្យាល័យ ១ខ្នង នៅ ភូមិ ឃ្លាំង ស្បែក ឃុំ កំពង់ លួង ស្រុក ពញា ឮ ដែល គ្រោង បញ្ចប់ ការសាងសង់ នៅ ចុង ខែឧសភា
( កណ្តាល ) ៖ លោក លឹម គាន ហោ រដ្ឋមន្រ្តី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ពញ ឮ ខេត្ត កណ្តាល រួម ជាមួយ លោក អភិបាល ស្រុក ពញា ឮ នៅ ថ្ងៃទី ០៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជេីញ ចុះ ពិនិត្យ វឌ្ឍនភាព នៃ ការសាងសង់ សាលារៀន អនុវិទ្យាល័យ ១ខ្នង មាន៨ បន្ទប់ តម្លៃ ១៤២. ៧០០ ដុល្លារ ស្ថិត ក្នុង វិហារ ឃ្លាំង ស្បែក ភូមិ ឃ្លាំង ស្បែក ឃុំ កំពង់ លួង ស្រុក ពញា ឮ ដែល ជា អំណោយ សប្បុរស ធម៌ ដ៏ ថ្លៃថ្លា របស់ លោក រដ្ឋមន្រ្តី ។
ក្នុង ឱកាស អញ្ជេីញ ចុះ ពិនិត្យ ជាក់ស្តែង នេះ លោក រដ្ឋមន្ត្រី បាន ទទួលយក នូវ សំណូមពរ របស់ លោកគ្រូ អ្នកគ្រូ និង គណៈកម្មការ សាលា ដោយ បាន ឧបត្ថម្ភ នូវ តុ កៅអី សម្រាប់ សិស្សានុសិស្ស សិក្សា ដល់ សាលា អនុវិទ្យាល័យ ទាំង ៨ បន្ទប់ ផងដែរ ។
ឆ្លៀត ក្នុង ឱកាស នេះ លោក រដ្ឋមន្រ្តី ក៏ បាន អញ្ជើញ ចូលរួម ជួប សំណេះសំណាល ជាមួយ គណៈ ចលនា កម្មករ - កម្ម ការិនី ស្រុក ពញា ឮ បងប្អូន កម្មករ - កម្ម ការិនី ប្រចាំ ឃុំ ទាំង ១១នាក់ និង តំណាង មណ្ឌល តាម បណ្តា ភូមិ ទាំង ១៥៩ នាក់ នៃ ស្រុក ពញា ឮ ៕ ក្រុមការងារ ខេត្ត ក្រចេះ ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ នៅ ឃុំ ហាន់ ជ័យ រំលឹក ពី ករណី យកិច្ច របស់ ម្ចាស់ ឆ្នោត សម្រាប់ ការបោះឆ្នោត ជាតិ នា ពេល ដ៏ ខ្លី ខាងមុខ នេះ
( ឆ្លូង - ក្រចេះ ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ខេត្ត ក្រចេះ រួម ជាមួយ សហការី ជា មន្ត្រី គណបក្ស នៅ ថ្នាក់ ជាតិ ខេត្ត និង មូលដ្ឋាន បាន ជួប សំណេះសំណាល ជាមួយ តំណាង ប្រជាពលរដ្ឋ ដែល ជា ប្រធាន និង អនុប្រធាន ក្រុម បក្ស គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ភូមិ ទាំង៤ នៅ ឃុំ ហាន់ ជ័យ ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។
ជ័យ ជំនះ ធំ ធេង ថ្មី ៗ នេះ នឹង ក្លាយជា ឈ្នួន ជំរុញ សន្ទុះ វាយ សំរុក កាន់តែ ខ្លាំងក្លា របស់ គណបក្ស យើង ដើម្បី ដណ្តើម ជ័យ ជំនះ ទាំងស្រុង សម្រាប់ ការបោះឆ្នោត ជាតិ នា ពេល ដ៏ ខ្លី ខាងមុខ ជាក់ ជា មិន ខាន ៕
គួរ បញ្ជាក់ ថា ក្នុង សប្តាហ៍ នេះ ប៉ូលិស នៅ រដ្ឋ Texas ទើបតែ បាន ចាប់ខ្លួន បុរស ម្នាក់ ដែល ជាប់សង្ស័យ ពី បទ បាញ់ សម្លាប់ អ្នកជិតខាង របស់ ខ្លួន ចំនួន ៥នាក់ ក្នុង នោះ រួម មាន ទាំង ក្មេង អាយុ ៩ ឆ្នាំ ម្នាក់ ផងដែរ ក្រោយ ប្រតិបត្តិការ តាម ប្រមាញ់ រុករក របស់ អាជ្ញាធរ អស់ រយៈពេល ៤ ថ្ងៃ ៕ លោក ហ៊ុន ម៉ានី ចូលរួម បុណ្យ សព មេឃុំ ព្រៃ វិហារ ក្រោយ បញ្ចប់ កិច្ចប្រជុំ នៅ គណបក្ស ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ ក្រោយពី បញ្ចប់ កិច្ចប្រជុំ ជាមួយ ក្រុមការងារ គណបក្ស ចុះ ជួយ ស្រុក និង ឃុំ និង គណៈកម្មាធិការ បក្ស ស្រុក គងពិសី ដោយ ទទួល ដំណឹង ពី មរណភាព របស់ ឧបាសក ឌួង សយ ប្រធាន គណៈកម្មាធិការ គណបក្ស ឃុំ ព្រៃ វិហារ និង មេឃុំ ព្រៃ វិហារ រួច មក លោក ហ៊ុន ម៉ានី បាន អញ្ជើញ ចូលរួម បុណ្យ សព និង គោរព វិញ្ញាណក្ខន្ធ នៅ គេហដ្ឋាន នៃ សព ដែល ស្ថិត ក្នុង ឃុំ ព្រៃ វិហារ ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ ។
សូម ជម្រាប ជូន ថា លោក ហ៊ុន ម៉ានី សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា អនុប្រធាន ទី១ ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ បាន ដឹកនាំ កិច្ចប្រជុំ ជាមួយ ក្រុមការងារ គណបក្ស ចុះ ជួយ ស្រុក និង ឃុំ និង គណៈកម្មាធិការ បក្ស ស្រុក បរសេដ្ឋ និង ស្រុក គងពិសី ពេញ មួយ ថ្ងៃ កាលពី ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២៣៕ អគ្គ លេខាធិការ អាស៊ាន បន្ដ ជួបប្រតិភូ ក្រុមប្រឹក្សា សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន ក្រោយ បញ្ចប់ ការចូលរួម ពិធី បើក ស៉ឺហ្គេម នៅ កម្ពុជា
ការចូលរួម នេះ បន្ទាប់ពី វិលត្រឡប់ ពី ការចូលរួម ពិធី បើក ជា ផ្លូវការ ព្រឹត្តិការណ៍ កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ ឆ្នាំ ២០២៣ ដែល បាន ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២៣ នៅ វិមាន ពហុកីឡដ្ឋាន ជាតិ មរតក តេជោ នៅ រាជធានី ភ្នំពេញ ព្រះរាជាណាចក្រ កម្ពុជា ៕ កងរាជអាវុធហត្ថ ខេត្ត ព្រះសីហនុ ចាប់ និង បញ្ជូន ជនសង្ស័យ ១៩ នាក់ ទៅកាន់ តុលាការ ពាក់ព័ន្ធ គ្រឿងញៀន
( ព្រះសីហនុ) ៖ កងរាជអាវុធហត្ថ ខេត្ត ព្រះសីហនុ បាន កសាង សំណុំរឿង បញ្ជូន ជនសង្ស័យ ប្រុស ស្រី ចំនួន ១៩ នាក់ រួម នឹង វត្ថុតាង មួយចំនួន ទៅ អយ្យការ អម សាលាដំបូង ខេត្ត ពាក់ព័ន្ធ នឹង ករណី ជួញដូរ គ្រឿងញៀន ដែល បង្រ្កាប បាន ចំនួន ៣លើក ក្នុង ភូមិសាស្រ្ត ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
ការបញ្ជូន នេះ ធ្វើឡើង នា ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២៣ ដោយ អនុវត្ត តាម បទបញ្ជា ដ៏ ម៉ឹង ម៉ាត់ លោក ឧត្តមសេនីយ៍ ត្រី ហេង ប៊ុន ទី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ព្រះសីហនុ និង មាន ការសហការ ជាមួយ កម្លាំង ជំនាញ នៃ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន មន្ទីរ ស្រាវជ្រាវ និង បង្រ្កាប បទល្មើស ។
៤៖ នាយក រដ្ឋមន្ត្រី ទីម័រ ខាងកើត ស្នើ សម្តេច តេជោ ហ៊ុន សែន ជួយ ជំរុញ វិស័យ កសិកម្ម ក្នុង ប្រទេស ខ្លួន
៥៖ អូស្ត្រាលី៖ មនុស្ស រាប់ ពាន់ នាក់ ធ្វើ បាតុកម្ម ប្រឆាំង នឹង មូលដ្ឋាន សម្រាប់ នាវា មុជទឹក ដើរ ដោយ ថាមពល នុយក្លេអ៊ែរ
៦៖ កម្ពុជា - វៀតណាម ចុះ អនុស្សរណៈ ជំរុញ ទេសចរណ៍ ឆ្ពោះ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព បរិយាប័ន្ន និង មាន ភាពធន់ កាន់តែ ប្រសើរ ក្រោយ វិបត្ត កូវីដ១៩
៧៖ សហរដ្ឋ អាមេរិក ថា នឹង មិន ភ្ជាប់ ទំនាក់ទំនងជា ប្រក្រតី ឡើងវិញ ជាមួយ រដ្ឋាភិបាល ស៊ីរី របស់ លោក អាសាដ នោះ ទេ
១០៖ សកម្មជន ក្រុម ប្រឆាំង ១០នាក់ ដែល កំពុង ជាប់ ពន្ធនាគារ ចេញ វិដេអូ និង ធ្វើ លិខិត សុំទោស សម្តេច តេជោ ហ៊ុន សែន និង ស្នើ អន្តរាគមន៍ ជួយ នៅ ក្រៅ ឃុំ
១១៖ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ លើកលែង ទោស ឱ្យ លោក គង់ ម៉ាស់ អតីត សកម្មជន គណបក្ស ប្រឆាំង បន្ទាប់ពី សរសេរ លិខិត សុំទោស និង សុំ អន្តរាគមន៍ ពី សម្តេច តេជោ ហ៊ុន សែន
១២៖ អាមេរិក និង អារ៉ាប៊ី សាអូឌីត ទទួលស្គាល់ ថា ភាគី សង្គ្រាម នៅ ស៊ូ ដង់ យល់ព្រម ជួប ចរចា គ្នា
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២៣ !
( ព្រះសីហនុ) ៖ លោក ហ៊ុន ម៉ាណែត តំណាង សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន អញ្ជើញ ក្នុង ពិធី សម្ពោធ ឆ្លង បណ្ណាល័យ និង សមិទ្ធផល នានា នៅក្នុង វត្ត ឥន្ទញ្ញាណ ហៅ វត្ត ក្រោម ស្ថិត ក្នុង ភូមិ លេខ ១ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ
ពិធី សម្ពោធ ឆ្លង បណ្ណាល័យ និង សមិទ្ធផល នានា នៅក្នុង វត្ត ឥន្ទញ្ញាណ នេះ ធ្វើឡើង នា ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២៣ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ រុស្ស៉ី បាន និយាយ ថា ជនសង្ស័យ ម្នាក់ ត្រូវបាន ចាប់ខ្លួន ។ បើ តាម ទីភ្នាក់ងារ ព័ត៌មាន TASS បាន រាយការណ៍ ថា មន្រ្តី សន្តិសុខ បាន រកឃើញ ផ្ទះល្វែង មួយ ក្នុង តំបន់ នៃ ទីក្រុង មូស្គូ ដែល ពួកគេ ជឿ ថា លាក់ ទុក គ្រាប់បែក ។
គួរ បញ្ជាក់ ថា លោក ព្រីឡេ ពី ន ដែល ជា អ្នកនិពន្ធ ប្រលោមលោក គាំទ្រ សង្គ្រាម របស់ រុស្ស៉ី នៅ អ៊ុយក្រែន ហើយ ធ្លាប់ អួត ពី ការចូលរួម ក្នុង សមរភូមិ យោធា នៅ ទីនោះ គឺជា បុគ្គល ដ៏ លេចធ្លោ ទី ៣ហើយ ដែល ត្រូវបាន គេ កំណត់ គោលដៅ វាយប្រហារ ដោយ គ្រាប់បែក គិត ចាប់តាំងពី សង្រ្គាម ផ្ទុះឡើង កាលពី ខែកុម្ភៈ ឆ្នាំ ២០២២ ៕
សម្ដេច តេជោ ហ៊ុន សែន ចេញ សារ អរ ព្រះគុណ ព្រះមហាក្សត្រ ដែល ទ្រង់ សព្វ ព្រះរាជ ហឫទ័យ ប្រោស ព្រះរាជ ទាន នូវ ការអបអរសាទរ ក្នុង ឱកាស ដែល សម្ដេច តេជោ ទទួលបាន គ្រឿង ឥស្សរិយយស ខ្ពស់ បំផុត « មរតក អូឡាំពិក អន្តរជាតិ »
ធនាគារ វឌ្ឍនៈ អាស៊ី ចំកាត់ ( ធនាគារ ABA) តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
