( ព្រះសីហនុ) ៖ ក្រោយពី កម្ពុជា បាន រៀបចំ វេទិកា ទេសចរណ៍ មេគង្គ ឆ្នាំ ២០២៣ និង បាន បញ្ចប់ ដោយ ទទួលបាន ជោគជ័យ យ៉ាង ត្រចះត្រង់ ប្រកបដោយ ផ្លែផ្កា ជាមួយនឹង ការពិភាក្សា ជា ក្រុម ជា បន្តបន្ទាប់ នៅក្នុង បរិយាកាស ស្និទ្ធស្នាល ជាមួយនឹង ស្មារតី នៃ សាមគ្គីភាព ឯកភាព មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ដ៏ រឹងមាំ កម្ពុជា បាន ប្រគល់ ទង់ ប្តូរ វេន នៃ វេទិកា ទេសចរណ៍ មេគង្គ នេះ ជូន ទៅ សាធាររណរដ្ឋ ប្រជាមានិត ចិន ដើម្បី បាន រៀបចំ វេទិកា ទេសចរណ៍ មេគង្គ សម្រាប់ ឆ្នាំ ២០២៤ ខាងមុខ ។
លោក ទិត ចន្ថា បាន បន្ថែម ថា វេទិកា ទេសចរណ៍ មេគង្គ ឆ្នាំ ២០២៣ ក្រោម ប្រធានបទ៖ « ការគិត ឡើងវិញ សម្រាប់ ភាពធន់ និង ឌីជីថល នីយកម្ម » នេះ គឺ ដើម្បី ស្វែងរក ឱកាស ដើម្បី បង្កើន ភាពធន់ នៃ វិស័យ ទេសចរណ៍ តាមរយៈ ការកសាង ប្រព័ន្ធ ចំនី អាហារ ប្រកបដោយ និរន្តរភាព ជំរុញ ការផ្តល់ សិទ្ធិ អំណាច ដល់ ស្ត្រី ការពន្លឿន ឌីជីថល ភាវូបនីយកម្ម និង ការលើកកម្ពស់ ជំនាញ នៃ កម្លាំង ពលកម្ម ក្នុង វិស័យ ទេសចរណ៍ ។
វេទិកា នេះ ក៏ បាន លើកឡើង ពី ផលប្រយោជន៍ និង កង្វល់ រួមគ្នា លើ ជីវភាព រស់ នៅ ការងារ និង ការបង្កើត ជំនាញ របស់ មនុស្ស រាប់ លាន នាក់ ដែល រង ផល ប៉ះពាល់ ដោយ ជំងឺ រាតត្បាត សកល ហើយ ពិភាក្សា អំពី វិធី ដើម្បី គិត ឡើងវិញ នូវ យុទ្ធសាស្ត្រ និង គំនិត ផ្តួចផ្តើម នៃ ការស្តារ ឡើងវិញ នៃ វិស័យ ទេសចរណ៍ ក្រោយ វិបត្តិ ជំងឺ កូវីដ - ១៩ នៅក្នុង ប្រទេស សមាជិក GMS ដែល រួម មាន ចិន កម្ពុជា ឡាវ មីយ៉ាន់ម៉ា ថៃ និង វៀតណាម ឲ្យ ក្លាយជឫ ជា អនុ តំបន់ សមូហភាព និង ថាមពល ។
លោក ទិត ចន្ថា បាន ឱ្យដឹង ដែរ ថា វេទិកា នេះ បាន ពិភាក្សា យ៉ាង សកម្ម អំពី បញ្ហា និង និន្នាការ នៃ ការស្តារ វិស័យ ទេសចរណ៍ ជាមួយ អ្នកជំនាញ ទេសចរណ៍ ក្នុង ស្រុក និង អន្តរជាតិ ដូច ជា៖ ការអភិវឌ្ឍ បណ្តាញ ផលិតកម្ម អាហារ ក្នុង ស្រុក និង ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ ដោយ ផ្តោត លើ សុវត្ថិភាព និង អនាម័យ ខណៈ ដែល គោលដៅ ទេសចរណ៍ ឆ្លាតវៃ ការជំរុញ ធនធាន មនុស្ស និង សមភាព យេនឌ័រ ក្នុង វិស័យ ទេសចរណ៍ បាន ដើរ តួនាទី សំខាន់ ក្នុង ការត្រួសត្រាយ ផ្លូវ សម្រាប់ ភាពធន់ ។
លោក បាន អះអាង ដែរ ថា វេទិកា នេះ គឺ ចំពេលវេលា ក្នុង ការលើកឡើង បញ្ហា ក្នុង តំបន់ និង ដំណោះស្រាយ សម្រាប់ កិច្ចសហប្រតិបត្តិការ នៃ ការអភិវឌ្ឍ ទេសចរណ៍ ប្រកបដោយ និរន្តរភាព និង បរិយាប័ន្ន តាមរយៈ ការលើកកម្ពស់ និង ការផ្សព្វផ្សាយ គោលដៅ ទេសចរណ៍ ដែល មាន សក្តានុពល ខ្ពស់ ក្នុង ចំណោម ប្រទេស ទាំង ប្រាំមួយ ក្នុង តំបន់ (GMS) ជា គោលដៅ ទេសចរណ៍ លំដាប់ ពិភពលោក ឆ្ពោះ ទៅរក អនាគត ដ៏ រុងរឿង រឹងមាំ និង វិបុលភាព សម្រាប់ ប្រជាជន ។
លោក បាន បន្ថែម ថា ហុង គ្រី មិន អាច ប្រៀបធៀប ទៅនឹង បណ្តា ប្រទេស នៅ អឺរ៉ុប ខាងកើត ផ្សេង ទៀត ដែល បាន ផ្តាច់ ខ្លួន ដោយ ជោគជ័យ ពី ប្រភព ថាមពល របស់ រុស្ស៊ី នោះ ទេ ដោយសារតែ ទីតាំង ភូមិសាស្រ្ត និង ហេដ្ឋារចនាសម្ព័ន្ធ តែ មួយ គត់ របស់ ខ្លួន ។
យោង តាម ការបញ្ជាក់ របស់ លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ របស់ សម្តេច តេជោ បាន ឱ្យដឹង ថា នៅក្នុង ជំនួប នោះ លោក តា កាហាស៊ី បាន ជម្រាប សម្ដេច តេជោ អំពី ការងារ មួយចំនួន របស់ សមាគម ជប៉ុន - កម្ពុជា ក្នុង ឱកាស ខួប ៧០ ឆ្នាំ នៃ ទំនាក់ទំនង រវាង កម្ពុជា និង ជប៉ុន ។ ការងារ ដែល សមាគម កំពុង ធ្វើ នោះ រួម មាន៖
ទី ១៖ កំពុង រៀបចំ វេទិកា ព័ត៌មាន អំពី សក្ដានុពល វិនិយោគ នៅ កម្ពុជា ដើម្បី ផ្សព្វផ្សាយ ដល់ ប្រជាជន ជប៉ុន ជាពិសេស សហគ្រាស ខ្នាត តូច និង មធ្យម ជប៉ុន ដែល កំពុង ស្វែងរក ការវិនិយោគ នៅ ក្រៅ ប្រទេស ។
ទី ២៖ កំពុង ជំរុញ ការអភិវឌ្ឍ ធនធាន មនុស្ស លើ វិស័យ កែ សម្ផស្ស . វិស័យ ជួសជុល យានយន្ត និង វិស័យ បដិសណ្ឋារកិច្ច ។
ទី ៣៖ កំពុង រៀបចំ ការប្រារព្ធ ពិធី អបអរសាទរ ខួប ៧០ ឆ្នាំ នៃ ទំនាក់ទំនង ការទូត រវាង ប្រទេស ទាំង ពីរ ដែល នឹង មាន ដុត កាំ ជ្រួច ជប៉ុន ផងដែរ នៅក្នុង រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០២៣ ។
ទី ៤៖ ជំរុញ ការនាំចេញ ផលិតផល ពី កម្ពុជា ទៅ ជប៉ុន និង កែច្នៃ ផលិតផល កម្ពុជា សម្រាប់ ដាក់ លក់ លើ ទីផ្សារ ។
ក្នុង ជំនួប នេះ លោក តា កាហាស៊ី សម្ដែង ការអបអរសាទរ ជូន ចំពោះ សម្ដេច តេជោ ដែល បាន រៀបចំ និង ដឹកនាំ កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ កាលពី ឆ្នាំ ២០២២ ទទួលបាន ជោគជ័យ យ៉ាង ត្រចះត្រចង់ ។
ជា ការឆ្លើយតប សម្ដេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ជូន ចំពោះ លោក តា កាហាស៊ី ដែល បាន លើក បង្ហាញ ពី ការងារ មួយចំនួន របស់ សមាគម ។ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន លើកទឹកចិត្ត ឱ្យ សមាគម ជប៉ុន - កម្ពុជា បន្ត ខិតខំ ចលនា នាំ អ្នកវិនិយោគ ជប៉ុន ចូលមក កម្ពុជា ។ ការកៀរគរ អ្នក វិនិយោគ បរទេស ជាពិសេស ជប៉ុន គឺជា អាទិភាព មួយ របស់ កម្ពុជា ។ បន្ថែម ពីលើ នោះ កម្ពុជា ក៏ មាន ច្បាប់ វិនិយោគ ថ្មី ដែល ផ្ដល់ ភាពអនុគ្រោះ ច្រើន សម្រាប់ ការវិនិយោគ នៅ កម្ពុជា ។
លោក អ៊ាង សុផល្លែត បាន ឱ្យដឹង ដែរ ថា ក្នុង ជំនួប នេះ សម្ដេច តេជោ ក៏ បាន ស្នើសុំ លោក តា កាហាស៊ី បន្ត ជួយ កម្ពុជា លើ ការអភិវឌ្ឍ ធនធាន មនុស្ស ។ សម្តេច តេជោ ក៏ បាន ជម្រាប លោក តា កាហាស៊ី អំពី គម្រោង បណ្ដុះបណ្ដាល ផ្នែក វិជ្ជាជីវៈ ជន ក្រីក្រ ប្រមាណ ១លាន ៥សែន នាក់ ដើម្បីឱ្យ ពួកគាត់ ងាយ រក ការងារ ធ្វើ ។
ជាមួយគ្នា នោះ សម្ដេច តេជោ បាន ស្នើ លោក តា កាហាស៊ី ជំរុញ ការនាំ ផលិតផល កម្ពុជា ទៅកាន់ ប្រទេស ជប៉ុន ។ សម្ដេច បាន មានប្រសាសន៍ ថា ផលិតផល កម្ពុជា នៅ ពេល នេះ មាន គុណភាព ល្អ ហើយ មិន ប្រើ គីមី ច្រើន នោះ ទេ ។
លោកស្រី បាន បន្ត ថា អង្គការ ទឹក ស្អាត ១០០១ បាន ផ្ដល់ ទឹក ស្ងាត ជូន ប្រជាពលរដ្ឋ ប្រមាណ ១ លាន នាក់ ក្នុង ខេត្ត គោលដៅ ទាំង ១៨ ខេត្ត ជាមួយ នេះ អង្គការ គ្រោង នឹង សាងសង់ ស្ថានីយ៍ ផលិត ទឹក ស្អាត ឲ្យបាន ៩០ កន្លែង ដើម្បី រំដោះ ប្រជាពលរដ្ឋ ដែល ខ្វះ ទឹក ស្អាត ប្រើប្រាស់ ប្រមាណ ជាង ១លាន នាក់ ។
ភាគី ទាំង ពីរ បាន ប្ដេជ្ញាចិត្ត ថា នឹង បន្ត កិច្ចសហប្រតិបត្តិការ ជាមួយគ្នា ជាបន្ត ទៀត ដើម្បី ពង្រីក វិសាលភាព វិស័យ ផ្គត់ផ្គង់ ទឹក ស្អាត នៅ កម្ពុជា ៕ នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត៖ កិច្ចការពារ ជាតិ ត្រូវតែ បន្ត ពង្រឹង តាមរយៈ ការធ្វើ ការកែទម្រង់ និង ធ្វើ ទំនើបកម្ម ជាប់ ជាប្រចាំ
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ បណ្ឌិត ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក តំណាង របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បិទ វគ្គ បណ្តុះបណ្តាល - ហ្វឹកហ្វឺន ឆ្នាំ ២០២២ និង បើក វគ្គ បន្ត ឆ្នាំ ២០២៣ និង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ អគារ បដិសណ្ឋារកិច្ច ថ្នាក់ដឹកនាំ និង បណ្ណាល័យ នៃ សាកលវិទ្យាល័យ ការពារ ជាតិ ។
នាយ ឧត្តមសេនីយ៍ បាន ណែនាំ ដល់ និស្សិត - សិក្ខាកាម ទាំងអស់ ប្រើប្រាស់ ចំណេះដឹង និង ចំណេះ ធ្វើ ដែល ទទួលបាន ពី វគ្គ បណ្តុះបណ្តាល - ហ្វឹកហ្វឺន សម្រាប់ យក ទៅ អនុវត្ត បំពេញ រាល់ ភារកិច្ច នៅ តាម បណ្តា ស្ថាប័ន - កង ឯកភាព ក្នុង បុព្វហេតុ បម្រើ ជាតិ មាតុភូមិ និង ប្រជាជន របស់ យើង ឲ្យ ទទួលបាន ជោគជ័យ និង កាន់តែ មាន ប្រសិទ្ធភាព ។
ចំពោះ និស្សិត - សិក្ខាកាម វគ្គ ថ្មី និង វគ្គ បន្ត . សូម ព្យាយាម បន្ត នូវ សកម្មភាព និង ស្មារតី របស់ និស្សិត - សិក្ខាកាម ជំនាន់ មុន ៗ ដែល បាន ទទួល ជោគជ័យ រួច មកហើយ ដោយ ត្រូវ យកចិត្តទុកដាក់ រៀនសូត្រ ក្រេប ជញ្ជក់ យក ទាំង ចំណេះដឹង និង បទពិសោធន៍ ជាក់ស្តែង ល្អ ៗ ពី សាស្ត្រាចារ្យ យោធាចារ្យ សម្រាប់ ការអភិវឌ្ឍ ខ្លួន ឯង ឲ្យ មាន សមត្ថភាព និង គុណ វុឌ្ឍិគ្រប់គ្រាន់ ដើម្បី ទទួល រ៉ាប់រង រាល់ ភារកិច្ច របស់ កងយោធពល ខេមរភូមិន្ទ ក្នុង ពេល ចំពោះ មុខ និង តទៅ អនាគត ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ បណ្ឌិត ហ៊ុន ម៉ាណែត បាន លើកឡើង នូវ ទស្សនៈ ផ្ទាល់ខ្លួន ថា កិច្ចការពារ ជាតិ ត្រូវតែ បន្ត ពង្រឹង តាមរយៈ ការធ្វើ ការកែទម្រង់ និង ធ្វើ ទំនើបកម្ម ជាប់ ជាប្រចាំ ដើម្បី ឆ្លើយតប ប្រកបដោយ ប្រសិទ្ធភាព ទៅនឹង សំណូមពរ ភារកិច្ច ចាំបាច់ ជាក់ស្តែង ចំពោះ មុខ និង សម្រាប់ ពេល អនាគត ហើយ ការធ្វើ ទំនើបកម្ម នោះ ទៀតសោត ត្រូវ ផ្តោត លើ កត្តា ចម្បង ចំនួន ៣គឺ៖
* ទី១៖ ទំនើបកម្ម រចនាសម្ព័ន្ធ សំដៅ លើ ការរៀបរយ ក្របខ័ណ្ឌ ចាត់តាំង កម្លាំង ដើម្បី ត្រៀម ឆ្លើយតប ទៅនឹង ហានិភ័យ ចំពោះ មុខ មាន ជាអាទិ៍៖ អំពើ ភេរវកម្ម និង គ្រោះមហន្តរាយ ធម្មជាតិ ជាដើម
* ទី២៖ ទំនើបកម្ម គ្រឿង បំពាក់ សំដៅ ទៅ លើ សមត្ថភាព ម្ចាស់ការលើ ការធានា សម្ភារ បច្ចេកទេស និង បរិក្ខារ ផ្សេង ៗ
* ទី៣៖ ទំនើបកម្ម ធនធាន មនុស្ស ដោយ ផ្តោត លើ ការធ្វើ ទំនើបកម្ម ប្រព័ន្ធ ហ្វឹកហ្វឺន ដែល រួម មាន៖ សាលា ហ្វឹកហ្វឺន . យោធាចារ្យ . កម្មវិធី សិក្សា និង ការស្រាវជ្រាវ ចង ក្រង ខ្លឹមសារ មេរៀន សំដៅ ធានា ការ លើកកម្ពស់ គុណភាព ហ្វឹកហ្វឺន ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ៕
អ្នកការទូត ពិភពលោក ចំអក ឱ្យ រុស្ស៊ី ដែល ធ្វើជា ប្រធាន ប្តូរ វេន ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ
លោក គង់ វិបុល បញ្ជាក់ ថា ចំណូល ពន្ធ ប្រចាំ ខែមីនា ឆ្នាំ ២០២៣ និង ជា រួម សម្រាប់ រយៈពេល ៣ខែ ដើម ឆ្នាំ ២០២៣ បាន ហក់ ឡើង ខ្ពស់ ដោយសារតែ ជារៀងរាល់ ឆ្នាំ ខែមករា ដល់ ខែមីនា គឺជា រដូវកាល នៃ ការប្រកាស និង បង់ប្រាក់ ពន្ធ លើ ប្រាក់ ចំណូល ប្រចាំ ឆ្នាំ ដែល ឆ្លុះបញ្ចាំង អំពី សកម្មភាព អាជីវកម្ម ថា រក បាន ចំណេញ ឬ ខាត របស់ សហគ្រាស នា ឆ្នាំ កន្លងមក ។
លោក បន្ត ថា កន្លងមក អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន និង កំពុង អនុវត្ត កាតព្វកិច្ច ដំឡើង ឧបករណ៍ វាស់ ចំណុះ ស្រាបៀរ និង ភេសជ្ជៈ គ្មាន ជាតិ អាល់កុល របស់ សហគ្រាស ផលិត ក្នុង ស្រុក (Flowmeter) សំដៅ ធានា បាន នូវ តម្លាភាព និង ការប្រកួត ប្រជែង ស្មើភាព ហើយ ដើម្បី ធានា បាន នូវ និរន្តរភាព នៃ វិធានការ នេះ អគ្គ នាយកដ្ឋាន ពន្ធដារ ត្រូវ រៀបចំ យន្តការ ចុះ ត្រួតពិនិត្យ ជាក់ស្តែង តាមដាន និង ធ្វើការថែទាំ ឧបករណ៍ និង បណ្តាញ ដែល បាន រៀបចំ តាម រោងចក្រ ។
លោក គង់ វិបុល បាន ជំរុញ ឲ្យ បន្ត អនុវត្ត វិធានការ ដូច ភ្លៀង រលឹម ចំពោះ ក្លឹប កម្សាន្ត ធំ ៗ មួយចំនួន ដែល មិន បាន ចុះបញ្ជី ពន្ធដារ ឬ ចុះបញ្ជី មិន បាន ត្រឹមត្រូវ តាម កម្រិត ផល របរ និង រំលឹក ឱ្យ ម្ចាស់ អាជីវកម្ម ដែល មិន ទាន់ បាន ចុះបញ្ជី ពន្ធដារ ឱ្យ មក បំពេញ កាតព្វកិច្ច ចុះបញ្ជី ពន្ធដារ និង សហគ្រាស ដែល បាន ចុះបញ្ជី រួចរាល់ មក ធ្វើ បច្ចុប្បន្នភាព ព័ត៌មាន សហគ្រាស ( ប្រសិនបើ មាន ) ចៀសវាង នូវ ការ ផាកពិន័យ ទោសទណ្ឌ នានា ៕ បទ អត្ថាធិប្បាយ៖ តើ បញ្ហា តៃវ៉ាន់ ជា បញ្ហា ផ្ទៃក្នុង របស់ ចិន ឬ ជា បញ្ហា សកល ?
( ប៉េកាំង ) ៖ ដូច ដែល យើង ទាំងអស់ គ្នា បាន ដឹង ស្រាប់ ហើយ ថា សហគមន៍ អន្តរជាតិ បាន ទទួលស្គាល់ ជាទូទៅ ពី គោលការណ៍ ចិន តែ មួយ ពោលគឺ លើ ពិភពលោក នេះ គឺ មាន ប្រទេស ចិន តែ មួយ គត់ ឯ តៃវ៉ាន់ គ្រាន់តែ ជា ដែន កោះ មួយ របស់ ប្រទេស ចិន តែ ប៉ុណ្ណោះ ។ ជាពិសេស តៃវ៉ាន់ គ្មាន អាសនៈ ក្នុង អង្គការ សហ ប្រជាជាតិ នោះ ទេ ដែល មាន ន័យ ថា តៃវ៉ាន់ មិន មែន ជា រដ្ឋ អធិបតេយ្យ ហើយ រដ្ឋាភិបាល សាធារណរដ្ឋ ប្រជាមានិត ចិន គឺ តំណាង ឱ្យ ប្រទេស ចិន ទាំងមូល ក្នុង នោះ បូករួម ទាំង តំបន់ តៃវ៉ាន់ ផងដែរ ។
អាស្រ័យ ហេតុ នេះ មិន ថា ប្រទេស ណា ក្តី ឱ្យ តែ បាន បង្កើត ទំនាក់ទំនង ការទូត ជាមួយ ប្រទេស ចិន គឺ សុទ្ធតែ បាន ប្រកាស ពី ការគោរព តាម គោលការណ៍ ចិន តែ មួយ ដែល ជា ក្រម មូលដ្ឋាន នៃ ការបង្កើត ទំនាក់ទំនង ផ្លូវ ទូត របស់ ចិន ពោល គឺ ប្រទេស មាន ចំណង ការទូត ជាមួយ ចិន មិន អាច មាន ទំនាក់ទំនង ផ្លូវ ការ ណាមួយ ជាមួយ តំបន់ តៃវ៉ាន់ នោះ ឡើយ ។
ជាធម្មតា ការដោះស្រាយ បញ្ហា ក្នុង គ្រួសារ គឺជា រឿង ផ្ទាល់ខ្លួន របស់ សាមី គ្រួសារ យើង មិន អាច លូកលាន់ ឬ បង្គាប់បញ្ជា គ្រួសារ អ្នកដទៃ នោះ ទេ ហើយ កាន់តែ មិន អាច សម្រេច ជោគវាសនា របស់ អ្នកដទៃ ទៅ ទៀត ។ នេះ ជា សីលធម៌ និង ជា ច្បាប់ ដែល យើង ត្រូវ គោរព ពោល មិន អាច បំពាន បន្ទាត់ ក្រហម របស់ អ្នកដទៃ ឡើយ ។
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ធំ ៗ ចំនួន ១៣ ប្រកាស ផ្តល់ ឱកាស ការងារ ចំនួន ១៩៨៨ កន្លែង ដល់ យុវជន សិស្ស / និស្សិត និង អ្នក ស្វែងរក ការងារ ធ្វើ ក្នុង វេទិកា ការងារ ដែល សហការរៀបចំ ដោយ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ (NEA) នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង សហភាព សហព័ន្ធ យុវជន កម្ពុជា វិស័យ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
ចំពោះ សិស្ស / និស្សិត និង អ្នក កំពុងតែ ស្វែងរក ការងារ ធ្វើ ឬ ចង់ ផ្លាស់ប្តូរ ការងារ អាច យក ប្រវត្តិ រូប សង្ខេប (CV) ដើម្បី ចូលរួម ដាក់ពាក្យ និង សម្ភាស ផ្ទាល់ ជាមួយ អ្នកតំណាង ក្រុមហ៊ុន ទាំងនោះ បាន ចាប់ពី ម៉ោង ៨៖០០ ព្រឹក ដល់ ម៉ោង ០៥៖០០ ល្ងាច នៅក្នុង បរិវេណ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៧ ខែមេសា ស្អែក នេះ ។
ចំណេះដឹង ទូទៅ៖ រឿង ពិត៨ យ៉ាង ដែល អ្នក គួរ ស្វែងយល់ ពី អ្នកប្រាជ្ញ ចិន ខុង ជឺ
បើ ទោះបីជា គំនិត របស់ គាត់ តែងតែ ឆ្លុះបញ្ចាំង ពី ក្រមសីលធម៌ . គ្រួសារ . និង ការដឹកនាំ រដ្ឋ ដែល ជា មូលដ្ឋាន សម្រាប់ សង្គម ចិន ក៏ដោយ មនុស្ស ភាគ ច្រើន ដែល ជា មិន មែន ប្រជាជន ចិន ស្គាល់ តិចតួច បំផុត អំពី ជីវិត និង ការងារ ប្រចាំ ថ្ងៃ របស់ គាត់ ។ ចុះបងប្អូន ដែល ជា ប្រជាជន ខ្មែរ យើង វិញ បាន ស្គាល់ ពី ជីវិត និង ការងារ របស់ អ្នកប្រាជ្ញ ចិន រូប នេះ កម្រិត ណា ដែរ ?
* ១៖ ចាប់កំណើត អំឡុង ពេល ចិន ស្ថិត ក្នុង ភាពចលាចល ផ្នែក នយោបាយ យ៉ាង ខ្លាំង
តាម ការពិត ជាតិ ទាំងមូល ត្រូវបាន ពុះ ជ្រៀក ជា ចំណែក ៗ ហែក ចែក គ្នា ត្រួតត្រា ដោយ ពួក មាន ឥទ្ធិពល នានា នៅក្នុង តំបន់ ផ្សេង ៗ ។ នេះ ជា មូលហេតុ ដែល គេ ហៅ ថា ខុង ជឺ បាន ចាប់កំណើត អំឡុង ពេល ដែល ប្រទេស ចិន ស្ថិត ក្នុង ភាពចលាចល ផ្នែក នយោបាយ យ៉ាង ខ្លាំង ។
ឪពុក របស់ ខុង ជឺ បាន ស្លាប់ នៅពេល ខុង ជឺ អាយុ ទើបតែ បាន ៣ឆ្នាំ ប៉ុណ្ណោះ ហើយ លោក ត្រូវបាន ចិញ្ចឹម បីបាច់ ដោយ ម្តាយ បង្កើត និង សាច់ញាតិ គាត់ ដែល ជា អ្នកក្រីក្រ ក្នុង តំបន់ ។ សាច់ញាតិ របស់ ខុស ជឺ គឺជា ជន សាមញ្ញ ហើយ កាល នោះ ជីវភាព ពួកគាត់ មាន ភាព លំបាក ជាខ្លាំង ។ បន្ថែម លើ នេះ ម្តាយ របស់ គាត់ បាន ស្លាប់ មុន គាត់ មាន អាយុ បាន ៤០ ឆ្នាំ ហើយ ពេល នោះ ខុង ជឺ មាន អាយុ ១៧ឆ្នាំ ប៉ុណ្ណោះ ។
* ៣៖ ការបង្រៀន របស់ ខុង ជឺ គ្មាន ឥទ្ធិពល អ្វី ឡើយ ទាល់តែ គាត់ ស្លាប់ ទើប មាន អ្នក ចាប់អារម្មណ៍
អំឡុង ពេល ខុង ជឺ នៅ មាន ជីវិត គាត់ គឺជា បញ្ញវ័ន មួយ រូប ដែល ត្រាច់ចរ ពី កន្លែង មួយ ទៅ កន្លែង មួយ និង ជា អ្នក ដែល ផ្តល់ ដំបូន្មាន ផ្នែក នយោបាយ ទៅ រដ្ឋាភិបាល ណែនាំ ប្រៀន ប្រដៅ គំនិត របស់ គាត់ ទៅកាន់ មនុស្ស ម្នា ក្នុង សង្គម ។ ពេល ចាស់ ទៅ គាត់ ត្រឡប់មក ផ្ទះ វិញ ហើយ ទទួលបាន មុខងារ ជា រដ្ឋ បុរស លំដាប់ ទាប មួយ រូប ។
ទស្សនៈ របស ខុង ជឺ មិន បាន ក្លាយជា ទ្រឹស្តី ដែល ផ្សាយ ឲ្យបាន ទូលំទូលាយ ឡើយ ទាល់តែ សាវ័ក របស់ គាត់ ( ៣០០០ នាក់ ) ចាប់ផ្តើម សាប ព្រួស គំនិត ទាំងនោះ យ៉ាង ចាស់ ដៃ តាមរយៈ សំណេរ របស់ ពួកគេ ទើប មាន មនុស្ស ចាប់អារម្មណ៍ ។
* ៥៖ ការបង្រៀន របស់ ខុង ជឺ ផ្តោត លើ សារៈសំខាន់ នៃ គ្រួសារ
ខុង ជឺ បាន ជឿ ថា មាន តែ ក្នុង រង្វង់ គ្រួសារ ទេ ដែល ភាព ឯកជន ត្រូវបាន កំណត់ ព្រំដែន និង អភិវឌ្ឍន៍ យ៉ាង ពេញទី ។ ដូច្នេះ កាតព្វកិច្ច គ្រួសារ និង ទំនាក់ទំនង ក្នុង គ្រួសារ គឺជា កូនសោ នៃ ទស្សនវិជ្ជា របស់ គាត់ ។ ឧបមាដូចជា ស្វាមី មាន កាតព្វកិច្ច ត្រូវតែ ស្រឡាញ់ និង ផ្តល់ ក្តីសង្ឃឹម ដល់ ភរិយា ខណៈ ដែល ភរិយា ត្រូវតែ គោរព ស្វាមី ។ ដូចគ្នា ដែរ បង ត្រូវ ទទួលបាន ការគោរព ពី ប្អូន កូន ត្រូវ គោរព ឪពុក ម្តាយ ជាដើម ។
លើស ពី នេះ ទៅ ទៀត ខុង ជឺ បាន គិត ថា ការគ្រប់គ្រង រដ្ឋ មួយ ដូចជា ការគ្រប់គ្រង គ្រួសារ ដែរ ព្រោះថា ឯកជន ភាព គ្រួសារ មាន មែក ធាង សម្រាប់ ជីវិត សាធារណៈ ពោល ការគ្រប់គ្រង គ្រួសារ ឲ្យបាន ល្អ បង្កើត ឲ្យ មាន ការគ្រប់គ្រង រដ្ឋ ក៏ ល្អ ដែរ ។
* ៧៖ គំនិត ខុង ជឺ ស្ថិត ក្នុង ភាពល្បីល្បាញ និង អន់ថយ ទៅ តាម សម័យកាល ចិន
ទស្សនវិជ្ជា ទាំង ៦ នោះ រួម មាន៖
* គម្ពីរ ឈ្មោះ យី៖ ចែង ពី ការផ្ទេរ កម្មសិទ្ធិ និង ផ្ទេរ មរតក * គម្ពីរ ឈ្មោះ ចេ៖ ជា កំណាព្យ និទាន សម្រាប់ បម្រើ សោភ័ណ្ឌ ធម្មជាតិ * គម្ពីរ ឈ្មោះ លី៖ ជា ការប្រារព្ធ ធ្វើ ពិធី សែន ព្រេន ផ្សេង ៗ * គម្ពីរ ឈ្មោះ យ៉ូ៖ ចែង ពី បទភ្លេង និង ចម្រៀង បណ្តែត អារម្មណ៍ * គម្ពីរ ឈ្មោះ ជូ៖ ចែង ពី ប្រវត្តិសាស្ត្រ និង ពង្សាវតារ នៃ ប្រទេស ចិន * គម្ពីរ ឈ្មោះ ឈូស៊ាវ ឬ គម្ពីរ និទាឃ រដូវ៖ និទាឃ ជា ប្រវត្តិសាស្ត្រ ជាក់ស្តែង របស់ កុលសម្ព័ន្ធ លូ ។
សូម បញ្ជាក់ ថា បើ តាម ឯកសារ ខ្លះ ទៀត បង្ហាញ ថា អ្នកប្រាជ្ញ ខុង ជឺ មិន មែន ជា បុគ្គល ដែល កើត ក្នុង សែស្រឡាញ សាមញ្ញ ឡើយ គឺ ខុង ជឺ បាន កើត ក្នុង រាជ វង្ស លូ ក៏ប៉ុន្តែ ដោយសារ សង្គ្រាម រាជ វង្ស នេះ ក៏ បាន បាត់ បន្តិច ម្ដង ៗ នៅក្នុង ប្រវត្តិសាស្ត្រ ចិន ទៅ ។ ចំពោះ គម្ពីរ ឈ្មោះ ថា ឈូស៊ាវ ឬ គម្ពីរ និទាឃ រដូវ នោះ គឺជា តម្រាសាស្ត្រ ដែល ខុង ជឺ បាន កត់ត្រា និង រៀបរាប់ អំពី ដំណើរ គ្រួសារ របស់ លោក ពោល គឺ រាជ វង្ស លូ នោះ នេះ ឯង ៕
សូម ជម្រាប ថា នៅ ថ្ងៃ នេះ នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន បញ្ជា ឲ្យ កម្លាំង អាវុធហត្ថ ចេញ ប្រតិបត្តិការ បង្ក្រាប បទល្មើស ព្រៃឈើ រហូត ប្រើ អាវុធ បើសិន ក្រុម ជនល្មើស ប្រឆាំង និង បាញ់ តបត មក កងកម្លាំង ៕
លុបបំបាត់ គ្រឿងញៀន ត្រូវ ផ្តើម ចេញ ពី យើង ទាំងអស់ គ្នា ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៦ ខែ មេសា៖ បង្ក្រាប ២៣ករណី ឃាត់ខ្លួន ៥៤ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៣ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៩១ ករណី ជួញដូរ រក្សាទុក ៦ករណី និង ចាត់ចែង សម្រួល ១ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥៤ នាក់ ។
ដោយឡែក អ្នកនាំពាក្យ ក្រសួង ការបរទេស ន័រវែស បាន និយាយ ថា អាជ្ញាធរ ន័រវែស យកចិត្តទុកដាក់ ជាខ្លាំង ចំពោះ សកម្មភាព មិន មាន ការអនុញ្ញាត ណាមួយ នៅក្នុង ព្រំប្រទល់ របស់ ប្រទេស ន័រវែស ។ ក្នុង ករណី មាន ការបំពាន ព្រំដែន អ្នក ដែល ទទួលខុសត្រូវ គួរ ជូនដំណឹង ភ្លាម ៗ មកកាន់ អាជ្ញាធរ ន័រវែស រួម មាន ទាំង ក្រសួង ការបរទេស ហើយ តាមរយៈ ច្រក ទាក់ទង ត្រឹមត្រូវ ។ ក្រសួង ការបរទេស ន័រវែស មិន ទាន់ ទទួលបាន ការជូនដំណឹង ជា ផ្លូវការ ណាមួយ អំពី ឧប្បត្តិហេតុ ខាង លើ ពី អាជ្ញាធរ ស៊ុយអែត នៅឡើយ ទេ ។
គួរ បញ្ជាក់ ថា យោង តាម អ្នកនាំពាក្យ ខាងលើ ការងារ នៅក្នុង ទឹកដី ន័រវែស ដើម្បី ប្រមូល យក វត្ថុ ដែល ធ្លាក់ ណាមួយ ចាំបាច់ ត្រូវ មាន ការយល់ព្រម ជាមុន ពី ខាង ស៊ុយអែត ។ ក្រសួង ការបរទេស ន័រវែស ថា ខ្លួន មិន ទាន់ ដឹង ថា មាន ការខូចខាត ដែល បង្កឡើង ពី ការធ្លាក់ រ៉ុក្កែត របស់ ស៊ុយអែត ដែរ ឬ យ៉ាងណា ទេ ៕ អភិបាល ខណ្ឌ ៧មករា ចែក អាវ ចំណាំងផ្លាត និង បំពាក់ មួក សុវត្ថិភាព ជូន ប្រជាការពារ ខណ្ឌ ចំនួន ៥០ នាក់
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃពុធ ទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ លោក ថេង សុថុល អភិបាល ខណ្ឌ ៧មករា រួម ជាមួយ លោក ឌី រ័ត្ន ខេមរុណ អភិបាល រង ខណ្ឌ ៧មករា អញ្ជើញ ទទួល អាវ ចំណាំងផ្លាត និង មួក សុវត្ថិភាព ពី លោក សេង វណ្ណារ៉ា អគ្គ នាយក រង ក្រុមហ៊ុន កម្ពុជា តេលា ។
បន្ទាប់ពី ទទួល អាវ ចំណាំងផ្លាត និង មួក សុវត្ថិភាព រួច មក លោក ថេង សុថុល បាន អញ្ជើញ ជួប សំណេះសំណាល សួរសុខទុក្ខ ចែក អាវ ចំណាំងផ្លាត និង បំពាក់ មួក សុវត្ថិភាព ជូន ប្រជាការពារ ខណ្ឌ ចំនួន ៥០ នាក់ ដោយ មាន ការចូលរួម ពី លោក ឌី រ័ត្ន ខេមរុណ លោក គ្រួច សុធន នាយក រង រដ្ឋបាល ខណ្ឌ លោក ងួន សត្យា ប្រធាន ការិ- សេដ្ឋកិច្ច និង ភិវឌ្ឍ សហគមន៍ ខណ្ឌ ៧មករា ។
នា ឱកាស សំណេះសំណាល នេះ ដែរ លោក ថេង សុថុល បាន លើកឡើង ថា កម្លាំង ប្រជាការពារ គឺជា កម្លាំង ស្នូល ដ៏ សំខាន់ សម្រាប់ អាជ្ញាធរ ក្នុង មូលដ្ឋាន ក្នុង ការដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការចូលរួម សហការ គ្រប់ សកម្មភាព របស់ អាជ្ញាធរ មិន ថា កិច្ចការងារ សន្តិសុខ មនុស្សធម៌ ឬ ការងារ រដ្ឋបាល ផ្សេង ៗ ដូចជា ការជួយ សម្រួល ចរាចរណ៍ កកស្ទះ រៀបចំ សណ្តាប់ធ្នាប់ ក្នុង មូលដ្ឋាន ជាដើម គឺ តែងតែ មាន វត្តមាន របស់ ពួកគាត់ នៅ ជាមួយ សកម្មភាព ទាំងនេះ ជានិច្ច ។
លោក អភិបាល បាន សម្ដែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ បងប្អូន ជា ប្រជាការពារ ទាំងអស់ ដែល បាន លះបង់ ពេលវេលា កម្លាំង កាយ កម្លាំងចិត្ត និង ប្រាជ្ញា ស្មារតី ចូលរួម សហការ ជាមួយ អាជ្ញាធរដែនដី ធ្វើឲ្យ ភូមិ - សង្កាត់ របស់ យើង មាន សន្តិសុខ សណ្តាប់ធ្នាប់ ល្អ ជា ភូមិ - សង្កាត់ ប្រកបដោយ សុវត្ថិភាព ពិសេស គឺ ចូលរួម ការពារ សមិទ្ធផល នានា ដែល ជា សម្បត្តិ រួម របស់ យើង ឲ្យបាន គង់ វង់ យូរអង្វែង ដើម្បី ជា ប្រយោជន៍ របស់ យើង ទាំងអស់ គ្នា និង កូនចៅ ជំនាន់ ក្រោយ ។
លោក អភិបាល បាន បន្ត ថា ដោយ មាន ការគាំទ្រ រាជ រដ្ឋាភិបាល តាមរយៈ ការអនុវត្តន៍ គោល នយោបាយ ភូមិ - សង្កាត់ មាន សុវត្ថិភាព រក្សា បាន សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ បាន ល្អ បង្ក្រាប បាន បទល្មើស គ្រប់ ប្រភេទ ធ្វើអោយ ប្រជាពលរដ្ឋ រស់ នៅ ដោយ សុខដុមរម្យ នា ដោយ មាន ការអភិវឌ្ឍន៍ រីកចំរើន លើ គ្រប់ វិស័យ និង ធ្វើអោយ ភាពក្រីក្រ ក្នុង មូលដ្ឋាន បាន ថយចុះ មួយ កម្រិត ផងដែរ ។
ម្យ៉ាង វិញ ទៀត Sea Game យើង នឹង ខិត ជិត មកដល់ នា ពេល ខាងមុខ កម្លាំង យើង ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការរៀបចំ សណ្តាប់ធ្នាប់ សាធារណៈ ក្នុង មូលដ្ឋាន ខណ្ឌ បញ្ជៀស ចរាចរ នានា ដើម្បី ងាយស្រួល ក្នុង ការធ្វើដំណើរ ។
លោក អភិបាល បាន បំពាក់ អាវ ចំណាំងផ្លាត និង មួក សុវត្ថិភាព ជា និមិត្តរូប ជូន ដល់ កម្លាំង សណ្តាប់ធ្នាប់ យើង ហើយក៍ បាន ផ្តាំផ្ញើ ដល់ កម្លាំង យើង ធ្វើ យ៉ាងណា កំលាំង ប្រជាការពារ យើង ត្រូវ ប្រកាន់ អោយ បាន ខ្ជាប់ខ្ជួន នូវ៖
ក្នុង ការសំណេះសំណាល នេះ ម្នាក់ ៗ ទទួលបាន មួក សុវត្ថិភាព១ អាវ ចំណាំងផ្លាត១ រួមទាំង ថវិកា ២ម៉ឺន រៀល ផងដែរ ៕ បង្ក្រាប ករណី គ្រឿងញៀន ឃាត់ខ្លួន ជនជាតិ ចិន ២នាក់ និង ថ្នាំ ញៀន ជាង ៣គីឡូក្រាម
( ភ្នំពេញ ) ៖ កម្លាំង ជំនាញ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿញៀន បាន បង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀន ពីរ គោលដៅ ផ្សេង គ្នា នៅ រាជធានី ភ្នំពេញ និង ខេត្ត ព្រះសីហនុ ដោយ ឃាត់ខ្លួន ជនជាតិ ចិន ២នាក់ និង ថ្នាំ ញៀន ជាង ៣គីឡូក្រាម ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង បាន កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភំ្ន ពេញ ចាត់ការ តាម នីតិវិធី ។
អភិបាល ខេត្ត ស្វាយរៀង ប្រាប់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ ពង្រឹង ការទប់ស្កាត់ ការជួញដូរ ចែកចាយ និង ប្រើប្រាស់ គ្រឿងញៀន នៅ តាម មូលដ្ឋាន
( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន ណែនាំ ដល់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ ពង្រឹង ការទប់ស្កាត់ ការជួញដូរ ចែកចាយ និង ប្រើប្រាស់ គ្រឿងញៀន នៅ តាម មូលដ្ឋាន ។
ការថ្លែង បែប នេះ របស់ អភិបាល ខេត្ត ស្វាយរៀង បាន ធ្វើឡើង នៅ ព្រឹ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ខែមេសា និង ទិសដៅ ការងារ ខែឧសភា ឆ្នាំ ២០២៣ របស់ រដ្ឋបាល ខេត្ត ។
លោក ម៉ែន វិបុល បាន កោតសរសើរ និង អរគុណ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ដែល ខិតខំ ចូលរួម ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ ជូន បងប្អូន ប្រជាពលរដ្ឋ បាន ល្អ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ជា កម្មវិធី សង្ក្រាន្ត ស្វាយរៀង ។
ជាមួយគ្នា នេះ អភិបាល ខេត្ត បាន ដាក់ចេញ នៅ ទិសដៅ សំខាន់ ៗ មួយចំនួន ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ប្រធាន គណៈកម្មការ ជាតិ ដើម្បី ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ បាន បញ្ជា ឲ្យ កម្លាំង អាវុធហត្ថ ចេញ ប្រតិបត្តិការ បង្ក្រាប បទល្មើស ព្រៃឈើ រហូត ប្រើ អាវុធ បើសិន ក្រុម ជនល្មើស ប្រឆាំង និង បាញ់ តបត មក កងកម្លាំង ។
លោក ព្រី ហ្គូហ្ស៉ី ន បាន ប្រាប់ គេហទំព័ត៌ ផ្សាយ ជា ភាសា អង់គ្លេស មួយ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ ពិតជា ជាប់ពាក់ព័ន្ធ នឹង ទ្វីប នេះ ។ យើង នៅ អាហ្វ្រិក ដើម្បី ការពារ អ្នក ដែល ស្នើសុំ ជំនួយ ពី យើង ដើម្បី ការពារ ជន ស៊ីវិល និង ផលប្រយោជន៍ ជាតិ របស់ ពួកគេ ពី ក្រុម ភេរវករ និង ចោ ព្រៃ ដែល ខ្លះ មិន មាន ដើមកំណើត ពី ទ្វីប អាហ្រ្វិក ទាល់តែសោះ ។ នេះ ធ្វើឡើង តាមរយៈ មូលនិធិ ដែល ខ្ញុំ រក បាន ក្នុង នាមជា អ្នកជំនួញ » ។
លោក ព្រី ហ្គូហ្ស៉ី ន បាន ចោទប្រកាន់ ថា អ្វី ទាំងអស់ នេះ កើត ចេញ ពី បារាំង និង សហរដ្ឋ អាមេរិក ដែល បរាជ័យ ក្នុង ការកម្ចាត់ ក្រុម សកម្ម ប្រយុទ្ធ និង ភេរវករ ទូទាំង ពិភពលោក ដោយសារតែ ខ្វះ ឆន្ទៈ ។
គួរ បញ្ជាក់ ថា ជុំវិញ ការអះអាង អំពី ការស្លាប់ ជន ស៊ីវិល ដែល បង្កឡើង ក្រុម Wagner នៅ សាធារណរដ្ឋ អាហ្វ្រិក កណ្តាល និង ប្រទេស ម៉ាលី ប្រធាន ក្រុមហ៊ុន ទាហាន ស៉ី ឈ្នួល រូប នេះ បាន ច្រានចោល ដោយ ចាត់ទុក ថា វា ជា រឿង ក្លែងក្លាយ មួយ រយ ភាគរយ ៕
អភិបាល ក្រុង សិរី សោភ័ណ ប្រកាស ផ្តល់ ២០ ម៉ឺន រៀល ដល់ អ្នក ថត បាន អ្នក ចោល សំរាម ផ្តេសផ្តាស
( បន្ទាយមានជ័យ )៖ លោក ស្រេង សុផល ប្រាប់ អភិបាល ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ បាន ប្រកាស ផ្តល់ រង្វាន់ ជា លុយ ២០ ម៉ឺន រៀល ដល់ បងប្អូន ណា ក៏ដោយ ដែល ថត បាន រូប អ្នក ចោល សំរាម ផ្តេសផ្តាស ពាស វាលពាសកាល ។
លោក បន្ត ថា ឱសានវាទ នៃ វិធានការ ខាងលើ នឹង ផុត កំណត់ នៅ ថ្ងៃទី ០៣ ខែឧសភា ឆ្នាំ ២០២៣ ប៉ុន្តែ ពី ពេល ប្រកាស ឲ្យ រង្វាន់ នេះ កាលពី សប្តាហ៍ មក ទល់ ថ្ងៃ នេះ ឃើញ ថា សំរាម ចោល ផ្តេសផ្តាស បាន ថយចុះ ខ្លះ ទីក្រុង ក៏ គ្រាន់ ស្អាត ដែរ ប៉ុន្តែ ក៏ នៅ មិន ទាន់ ថត បាន អ្នក ចោល សំរាម ដែរ ។
ជំហាន នេះ គឺ អាជ្ញាធរ និង ជំនាញ ចង់ឲ្យ ក្រុង និង តាម កន្លែង ធ្វើការ តាម ទី សាធារណ: តាម លំនៅឋាន បាន ស្អាត មាន អនាម័យ បរិស្ថាន ល្អ ដែល ជា ផ្នែក មួយ នៃ ការចូលរួម អបអរសាទរ ដ៏ ក្លៀវក្លា នូវ ដំណើរ ដង្ហែ ព្រះអគ្គីកីឡា ឬ ភ្លើង គប់ ដែល ឆ្កង កាត់ ខេត្ត បន្ទាយមានជ័យ នា ថ្ងៃទី ០២ ខែ សភា និង ព្រឹត្តិការណ៍ ជា ប្រវត្តិសាស្ត្រ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ កីឡា អាស៊ី ភាគ អាគ្នេយ៍ ។
លោក បាន បន្ត ថា នៅពេល ខាងមុខ ក្រោយ បោះឆ្នោត ជ្រើសរើស អ្នកតំណាងរាស្ត្រ នា ខែកក្កដា ឆ្នាំ ២០២៣ រដ្ឋបាល ក្រុង នឹង អនុវត្ត តាម អនុក្រឹត្យ លេខ ១៣ របស់ រាជ រដ្ឋាភិបាល ដូច ដែល បាន ផ្សព្វផ្សាយ រហូតមក ដែល តម្រូវឲ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច ត្រូវ ចាត់ វិធានការ ឲ្យ ពលរដ្ឋ បង់ សេវា សំរាម ហើយ យក ក្រុមហ៊ុន ឯកជនជា ដៃគូ ចូលរួម អនុវត្ត ៕
អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស បញ្ចេញ ផ្សាយ វីដេអូ ថ្មី៖ « ការពង្រឹង វប្បធម៌ និង គុណ តម្លៃ ប្រជាធិបតេយ្យ គឺ ដើម្បី ផល ប្រយោជន៍ ជាតិ និង ប្រជាជន កម្ពុជា »
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី បាន បញ្ចេញ ផ្សាយ វីដេអូ ថ្មី មួយ ទៀត ក្រោម ចំណងជើង ថា « ការពង្រឹង វប្បធម៌ និង គុណ តម្លៃ ប្រជាធិបតេយ្យ គឺ ដើម្បី ផល ប្រយោជន៍ ជាតិ និង ប្រជាជន កម្ពុជា » ដែល វីដេអូ នេះ មាន រយៈពេល ១៣នាទី ។
សង្គម ប្រជាធិបតេយ្យ ទាមទារ ឱ្យ មាន ការចូលរួម ប្រកួតប្រជែង ពី គណបក្ស នយោបាយ នៅក្នុង យុទ្ធនាការ ឃោសនា រក សម្លេង ឆ្នោត ក៏ប៉ុន្តែ គណបក្ស ដែល ចូលរួម ប្រកួតប្រជែង ត្រូវតែ មាន របៀបវារៈ នយោបាយ របស់ ខ្លួន ច្បាស់លាស់ ជាពិសេស ដាច់ខាត ត្រូវតែ បម្រើ ផលប្រយោជន៍ ជាតិ និង ប្រជាជន ស្រប តាម ការកំណត់ របស់ ច្បាប់ ស្តីពី គណបក្ស នយោបាយ និង ច្បាប់ ក៍ ដូចជា បទប្បញ្ញត្តិ ស្តីពី ការបោះឆ្នោត ។
ដើម្បី ពង្រឹង គុណ តម្លៃ និង វប្បធម៌ ប្រជាធិបតេយ្យ នៅ កម្ពុជា គណបក្ស នយោបាយ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ គ្រឹះ មួយចំនួន ដូច មាន ខ្លឹមសារ អធិប្បាយ ដូច ខាងក្រោម នេៈ ។
លោក បន្ថែម ថា ការកើនឡើង នេះ គឺ ដោយសារតែ ការបន្ត មាន តម្រូវការអង្ករ ថៃ ក្នុង បណ្តា ប្រទេស ក្នុង តំបន់ អាស៊ី និង អាហ្រ្វិក ដូចជា ឥណ្ឌូនេស៊ី បង់ក្លាដែស អ៊ីរ៉ាក់ អាហ្វ្រិក ខាងត្បូង និង សេណេហ្គាល់ ជាដើម ។ អ្នក បញ្ជាទិញ ទាំងនោះ បាន បន្ត នាំចូល អង្ករ ដើម្បី បំពេញ តម្រូវការ ក្នុង ស្រុក និង រក្សា សន្តិសុខ ស្បៀង ។
ក្រសួង កសិកម្ម និង សហករណ៍ ថៃ បាន ព្យាករ ថា ទិន្នផល ស្រូវ នឹង កើនឡើង នៅ ឆ្នាំ នេះ ដោយ ផ្អែក លើ ទឹក គ្រប់គ្រាន់ សម្រាប់ ការដាំដុះ ។ ទិន្នផល ស្រូវ ដែល ប្រមូល ពី រដូវ ច្រូត កាត់ ខុស រដូវ គ្រោង នឹង ចូល ទៅក្នុង ទីផ្សារ ក្នុង ខែមីនា និង មេសា ដែល គួរតែ នាំឲ្យ តម្លៃ អង្ករ ថៃ មាន ការប្រកួតប្រជែង ។
ការធ្លាក់ចុះ ថ្លៃ ប្រាក់ បាត ការកើនឡើង ស្តុក សម្រាប់ ការប្រើប្រាស់ ក្នុង ស្រុក នៅក្នុង ប្រទេស ឥណ្ឌា និង វៀតណាម និង ការកើនឡើង តម្រូវការ នៅ មជ្ឈិមបូព៌ា គឺជា កត្តា សំខាន់ ដែល ត្រូវបាន ព្យាករ ថា នឹង ជួយ លើកកម្ពស់ ចក្ខុវិស័យ នាំចេញ អង្ករ ថៃ នៅ ឆ្នាំ នេះ ។
ក្រសួង ការងារ រៀបចំ វគ្គ បណ្តុះបណ្តាល ស្តីពី យន្តការដោះស្រាយ បណ្តឹង ពលករ ទេសន្តរប្រវេស ក៏ ដោយ ផ្តោត លើ វិស័យ នេសាទ និង កែច្នៃ អាហារ សមុទ្រ ក្នុង ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ លោក ហ៊ូ វុឌ្ឍី រដ្ឋលេខាធិការ និង ជា ប្រធាន គណៈកម្មការ ប្រឹក្សា យោបល់ ក្នុង ការអនុវត្ត កម្មវិធី សិទ្ធិ ពលករ នេសាទ នៅ អាស៊ី អាគ្នេយ៍ តំណាង លោក បណ្ឌិត អ៊ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នា ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ បាន អញ្ជើញ បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី យន្តការ ក្នុង ការដោះស្រាយ បណ្តឹង ពលករ ទេសន្តរប្រវេស ក៏ ដោយ ផ្តោត លើ វិស័យ នេសាទ និង កែច្នៃ អាហារ សមុទ្រ ក្នុង ខេត្ត ពោធិ៍សាត់ ។
វគ្គ បណ្តុះបណ្តាល នេះ ត្រូវបាន ធ្វើឡើង នៅ សាល ប្រជុំ សណ្ឋាគារ ពោធិ៍សាត់ សេន ជូរី ដែល មាន រយៈពេល ២ ថ្ងៃ គឺ ថ្ងៃទី ២៦ - ២៧ ខែមេសា ឆ្នាំ ២០២៣ ដោយ បាន ការចូលរួម ពី លោក ឡាយ វិសិដ្ឋ អភិបាល រង នៃ គណៈអភិបាល ខេត្ត . លោក ទុន សុភ័ណ អ្នកសម្របសម្រួល ថ្នាក់ ជាតិ នៃ អង្គការ អន្តរជាតិ ខាង ការងារ ប្រចាំ ប្រទេស កម្ពុជា ព្រមទាំង សិក្ខាកាម ដែល អញ្ជើញ មក ពី ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ មេ ប៉ុស្តិ៍ គោលដៅ ទាំង៦ និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន ទៀត ។
លោក បន្ថែម ថា វគ្គ បណ្តុះបណ្តាល នេះ ធ្វើឡើង ក្នុង គោលបំណង ជួយ រាជ រដ្ឋាភិបាល - ក្រសួង និង អាជ្ញាធរ គ្រប់ ជាន់ ថ្នាក់ លើ ការពង្រឹង ការអនុវត្តន៍ ច្បាប់ គោល នយោបាយ និង បទបញ្ជា នានា ឱ្យ បាន ស្រប ទៅតាម បទដ្ឋាន ការងារ អន្តរជាតិ - តំបន់ និង ច្បាប់ ព្រមទាំង បទបញ្ជា ជាតិ ជាធរមាន ជាប់ទាក់ទង នឹង ទេសន្តរប្រវេស ការងារ ដោយ សុវត្ថិភាព និង ការការពារ និង លើកកម្ពស់ សិទ្ធិពលករ ក៏ ដូចជា ការបង្ការ និង ការទប់ស្កាត់ ការជួញដូរ មនុស្ស ក្រោម រូបភាព ប្លែក ៗ ជាច្រើន ។
ដើម្បីឱ្យ ជាក់ច្បាប់ សម្រាប់ ថ្ងៃ នេះ យើង ត្រូវ ធ្វើ ការងារ មួយ ក្នុង ចំណោម ការងារ នានា គឺ ការដោះស្រាយ វិវាទ ការងារ របស់ ពលករ ទេសន្តរប្រវេសន៍ ស្រប តាម យន្តការ និង នីតិវិធី ជាធរមាន ដែល មន្រ្តី របស់ ក្រសួង មន្រ្តី របស់ អង្គការ ILO មន្រ្តី ជំនាញ ទទួលបន្ទុក ការងារ នេះ និង ភាគី ពាក់ព័ន្ធ នានា នឹង ជម្រាប ជូន ជា លម្អិត តាម លំដាប់លំដោយ ទៅ តាម កម្មវិធី របស់ សិក្ខាសាលា ដែល បាន គ្រោង ទុក ។
កំពង់ផែ អន្តរជាតិ ព្រះសីហនុ នឹង អាច ឱ្យ នាវា ដឹក ទំនិញ គ្រប់ ធុន មកពី ជុំវិញ ពិភពលោក ចូល ចត បាន ចាប់ពី ឆ្នាំ ២០២៩ត ទៅ
( ព្រះសីហនុ) ៖ កម្ពុជា មាន មហិច្ឆតា អភិវឌ្ឍ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ ឱ្យ មាន សមត្ថភាព ឈានឡើង ដោយ រាជ រដ្ឋាភិបាល កំពុង អភិវឌ្ឍ កំពង់ផែ អន្តរជាតិ មួយ នេះ ជា បន្តបន្ទាប់ ដើម្បី សម្រេច ផែនការ ចាប់ពី ឆ្នាំ ២០២៩ត ទៅ នាវា ដឹក ទំនិញ គ្រប់ ធុន មកពី ជុំវិញ ពិភពលោក អាច ចូល ចត នៅ កំពង់ផែ អន្តរជាតិ នេះ បាន ដោយ គ្មាន ឧបសគ្គ ជម្រៅ ទឹក ទីតាំង ផ្ទុក កុងទីន័រ ឬ បញ្ហ ចំណត នោះ ឡើយ ។
នេះ ជា ការបញ្ជាក់ របស់ លោក លូ គឹម ឈុន ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក អគ្គ នាយក កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ ក្នុង សន្និសីទ សារព័ត៌មាន ជាមួយ ក្រុម អ្នកសារព័ត៌មាន នា ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៣ នៅ ទីតាំង កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ តាមរយៈ ដំណើរទស្សនកិច្ច របស់ ក្រុម អ្នកសារព័ត៌មាន ដឹកនាំ ដោយ ក្លិប អ្នកកាសែត កម្ពុជា ។
លោក អគ្គ នាយក លូ គឹម ឈុន បាន ឱ្យដឹង ថា ទន្ទឹមនឹង សកម្មភាព ពាណិជ្ជកម្ម ដឹក ទំនិញ ចេញ ចូលរៀងរាល ថ្ងៃ នោះ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ ក៏ មមាញឹក ក្នុង ការអភិវឌ្ឍ ទីតាំង ចំណត ទីតាំង ផ្ទុក កុងទីន័រ បង្កើន ជម្រៅ ផ្លូវ ទឹក ឱ្យ កាន់តែ ជ្រៅ ដើម្បី ឆ្លើយតប នឹង ការរីកចម្រើន ផ្នែក ពាណិជ្ជកម្ម អន្តរជាតិ ការដឹកជញ្ជូន និង ការសម្រេច ឱ្យ បាន តាម ផែនការ អនុញ្ញាតឱ្យ នាវា ដឹក ទំនិញ គ្រប់ ធុន ចូល ចត បាន ។ លោក បញ្ជាក់ ថា មហិច្ឆតា នេះ នឹង សម្រេចបាន នៅ ឆ្នាំ ២០២៩ត ទៅ ។
លោក បាន រៀបចំ ថា នៅ ឆ្នាំ ២០២៤ ខាងមុខ រាជ រដ្ឋាភិបាល នឹង អនុវត្ត ការធ្វើ ផែ ចំណត ថ្មី មួយ ទៀត ដែល ធ្វើឱ្យ សមត្ថភាព ផ្ទុក កុងទីន័រ កើនឡើង ៣៥ ភាគរយ បន្ថែម ទៀត បើ ធៀប នឹង ពេល បច្ចុប្បន្ន ។ បច្ចុប្បន្ន នាវា ដឹក ទំនិញ ធុន ធំ ចូល ចត នៅ កំពង់ផែ ព្រះសីហនុ បាន តែ ប្រមាណ ១៨ ភាគរយ ប៉ុណ្ណោះ ។
លោក បាន បន្ត ថា នៅ ឆ្នាំ ២០២៦ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ នឹង មាន សមត្ថកិច្ច ប្រហាក់ប្រហែល ជាមួយ កំពង់ផែ ប្រទេស ដទៃ ក្នុង តំបន់ និង អាច ឱ្យ នាវា ដឹក ទំនិញ ក្នុង តំបន់ ប្រមាណ ៩៣ ភាគរយ អាច ចូល ចត បាន ដែល ធ្វើឱ្យ ថ្លៃ ដឹកជញ្ជូន ថយចុះ ប្រមាណ ២០០ ដុល្លារ ក្នុង មួយ កុងទីន័រ ព្រមទាំង ធ្វើឱ្យ ភាព ប្រកួតប្រជែង ពាណិជ្ជកម្ម ជាតិ មាន ការកើនឡើង បន្ថែម ទៀត ហើយក៏ អាច ទាក់ទាញ វិនិយោគ មក ប្រទេស កម្ពុជា ច្រើន បន្ថែម ទៀត ដែរ ។
លោក បន្ត ទៀត ថា នៅ ឆ្នាំ ២០២៨ កម្ពុជា នឹង ធ្វើ ផែ ចំណត មួយ ថ្មី ទៀត ដែល មាន ជម្រៅ ទឹក ១៦.៥ម៉ែត្រ ដល់ ពេល នោះ ទំនិញ ដែល ដឹក ទៅ មក ជុំវិញ ពិភពលោក ពិសេស សហរដ្ឋ អាមេរិក មួយចំណែក នៃ ទ្វីប អឺរ៉ុប ក៏ ដូចជា ទ្វីប អាស៉ី នឹង អាច ចូល ចតទៅ មក កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ បាន ដោយ ពុំ មាន ឧបសគ្គ ជម្រៅ ទឹក ឡើយ ។
លោក អគ្គ នាយក លូ គឹម ឈុន បាន សង្កត់ធ្ងន់ ដែរ ថា នៅ ឆ្នាំ ២០២៩ ខាងមុខ ន រាជ រដ្ឋាភិបាល នឹង សាងសង់ ចំណត កំពង់ផែ ថ្មី មួយ ទៀត ដែល មាន ជម្រៅ ទឹក ដល់ ទៅ ១៧.៥ម៉ែត្រ ដើម្បី ធានា ថា នាវា ដឹក ទំនិញ គ្រប់ ធុន មកពី ជុំវិញ ពិភពលោក អាច ចូល ចត នៅ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ បាន ទាំងអស់ ដោយ ពុំ មាន ឧបសគ្គ អ្វី ទាំងអស់ រាប់ ទាំង ជម្រៅ ទឹក ការចូល ចត និង ចំណត ផ្ទុក កុងទីន័រ ។
អគ្គ នាយក កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ មាន សុទិដ្ឋិនិយម ថា នៅពេល នាវា ដឹក ទំនិញ គ្រប់ ធុន អាច ចូល ចត នៅ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ បាន ហើយ នោះ នឹង ធ្វើឱ្យ ថ្លៃ ដឹកជញ្ជូន តាម ផ្លូវ សមុទ្រ ធ្លាក់ចុះ ជាង បច្ចុប្បន្ន ដែល ជា ហេតុ នាំ ទៅដល់ ការបង្កើន ភាពប្រកួតប្រជែង ធំ មួយ សម្រាប់ វិស័យ ពាណិជ្ជកម្ម ជាតិ បង្កើន ផលចំណេញ ដល់ ផ្នែក សេដ្ឋកិច្ច រាប់ រយ លាន ដុល្លារ . លោក ថា បើ តាម ការសិក្សា គឺ រហូតដល់ ជាង ៣៥០ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ។
ម្យ៉ាងទៀត វា ក៏ នឹង ជួយ ទាក់ទាញ អ្នក វិនិយោគ មកពី ក្រៅ ប្រទេស ឱ្យ ចូលមក បណ្ដាក់ វិនិយោគ នៅក្នុង ប្រទេស កម្ពុជា ថែម ទៀត ដែរ ពីព្រោះ ក្រុមហ៊ុន របស់ ពួកគេ នឹង ងាយស្រួល ក្នុង ការដឹក វត្ថុធាតុ ដើម ចូល និង ដឹក ផលិតផល សម្រេច ចេញ ទៅ វិញ ដោយ មិន ចាំបាច់ ឆ្លងកាត់បណ្ដាក់ ជាមួយ កំពង់ផែ ប្រទេស ផ្សេង ឡើយ . នេះ គឺជា ផល ចំណេញ សម្រាប់ ជាតិ យ៉ាង ធំ ៕
កម្ពុជា ប្រារព្ធ ទិវា កម្ម សិទ្ធិ បញ្ញា ពិភពលោក ឆ្នាំ ២០២៣ ក្រោម មូល បទ « ស្រ្តី និង កម្មសិទ្ធិ បញ្ញ៖ ពន្លឿន ការបង្កើត ថ្មី និង ភាពច្នៃប្រតិដ្ឋ » លើកកម្ពស់ ស្រ្តី ក្នុង ការបង្កើត ថ្មី
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ប្រារព្ធ ទិវា កម្ម សិទ្ធិ បញ្ញា ពិភពលោក ឆ្នាំ ២០២៣ ក្រោម មូល បទ « ស្រ្តី និង កម្មសិទ្ធិ បញ្ញ៖ ពន្លឿន ការបង្កើត ថ្មី និង ភាពច្នៃប្រតិដ្ឋ » ដើម្បី ពង្រីក សក្តានុពល របស់ ស្រ្តី តាមរយៈ ការប្រើប្រាស់ ចំណេះដឹង គំនិត ច្នៃប្រតិដ្ឋ និង ជំនាញ ក្នុង ការបង្កើត ម៉ាក និង ផលិតផល និង ការអភិវឌ្ឍ អាជីវកម្ម ។
លោក មានប្រសាសន៍ ថា ការចូលរួម របស់ ស្រ្តី ក្នុង ការបង្កើត ថ្មី នៅតែ មាន កម្រិត នៅឡើយ ជាក់ស្តែង នៅ ឆ្នាំ ២០២០ ភាគរយ ស្រី្ត នៅលើ ពិភពលោក ដែល បាន ដាក់ពាក្យ ចុះបញ្ជី ការពារ តក្កកម្ម តាម ប្រព័ន្ធ ចុះបញ្ជី ប្រកាស នីយបត្រ តក្កកម្ម អន្តរជាតិ មាន តែ ចំនួន ១៦. ៥% ប៉ុណ្ណោះ ដែល ឆ្លុះបញ្ចាំង ឱ្យ ឃើញ ពី គម្លាត រវាង ស្រ្តី និង បុរស នៅក្នុង ជ្រុង មួយ នៃ ការប្រើប្រាស់ កម្មសិទ្ធិ បញ្ញា ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ មៀច សុផាន់ ណា រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន គណៈកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ ( គ. ប. ផ. ក) បាន ឲ្យដឹង ថា ឆ្នាំ ២០២២ កន្លងទៅ សមត្ថកិច្ច បាន ចាប់ខ្លួន ជនសង្ស័យ ជាង ២០ នាក់ ទាក់ទង នឹង ការផលិត និង ការជួញដូរ ផលិតផល ក្លែងក្លាយ បញ្ជូន ទៅកាន់ តុលាការ ខណៈ ផលិតផល ក្លែងក្លាយជាង ៣០តោន ត្រូវបាន រឹបអូស និង ដុត កម្ទេចចោល ជា បន្តបន្ទាប់ ។
ក្រោយ បញ្ចប់ កិច្ចប្រជុំ ត្រួតពិនិត្យ លទ្ធផល ការងារ ឆ្នាំ ២០២២ និង លើក ទិសដៅ ឆ្នាំ ២០២៣ របស់ គ. ប. ផ. ក នា ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ នាយ ឧត្តមសេនីយ៍ មៀច សុផាន់ ណា បាន បញ្ជាក់ ថា « សមត្ថកិច្ច បាន ចុះបង្ក្រាប ឱសថ ខុស ច្បាប់ ផលិតផល វេជ្ជសាស្ដ្រ ផលិតផល គ្រឿង សម្អាង ផលិតផល ឧបភោគ បរិភោគ និង ផលិតផល ក្លែងក្លាយ ខុស ច្បាប់ ទូទៅ បាន ជាង ៣០តោន ដោយ ក្នុង នោះ ផលិតផល ឧបភោគ បរិភោគ ចំនួន ១៣តោន និង ប៊ី ចេង ចំនួន ១៨តោន » ។
លោក រដ្ឋលេខាធិការ បាន បន្ដ ថា ផលិតផល ដែល ត្រូវ រឹបអូស បាន កាលពី កន្លងទៅជា បន្តបន្ទាប់ នេះ គឺ សុទ្ធតែ មាន ហានិភ័យ ខ្ពស់ ចំពោះ អ្នក បរិភោគ និង អ្នកប្រើប្រាស់ ដោយ វា អាច បង្ក គ្រោះថ្នាក់ ដល់ សុខភាព យ៉ាង ធ្ងន់ធ្ងរ ដោយសារតែ ការធ្វើ របស់ ពួកគេ ខុសពី ស្តង់ដា និង ខ្លះ ទៀត ហួស កាលបរិច្ឆេទ ដូចជា ប្រហិត និង សាច់ ចម្រុះ ជាដើម ។
ជាមួយគ្នា នេះ ក្រសួង បាន បង្ហាញ ពី វិធានការ ក្នុង ត្រៀម និង ឆ្លើយតប ទៅ លើ បញ្ហា ដែល នឹង កើតមាន នា ពេល ខាងមុខ ផងដែរ ៕
យុវតី ម្នាក់ ទៀត ក៏ បាន ថ្លែង ថា លោក ស៊ន តារា ធ្លាប់ និយាយ ថា គាត់ ជា មនុស្ស ស្នេហាជាតិ ប៉ុន្តែ នេះ ជា ការកុហក របស់ គាត់ ទេ ។ មនុស្ស ដែល មិន ស្រលាញ់ គ្រួសារ ផង តើ ឲ្យ ស្រលាញ់ អ្នកដទៃ យ៉ាងម៉េច ទៅ ?
ស្ត្រី ម្នាក់ ទៀត បាន សម្តែង ការហួសចិត្ត ចំពោះ ទង្វើ លោក ស៊ន តារា ដោយសារតែ លង់ ខ្លួន នឹង ការប្រឆាំង មិន ឈប់ ។ លោកស្រី បន្ត ទៀត ថា ឪពុក ម្តាយ ជា អ្នកមាន គុណ ខិតខំ ចិញ្ចឹម កូន ឲ្យ ធំ ដឹង ក្តី សូម្បី ស្រមោច មួយ មិន ឲ្យ វា រ កាត់ តែ លោក ស៊ន តារា មិន សម ជា មនុស្ស នោះ ទេ ។
សូម ជម្រាប ថា នៅ ថ្ងៃអង្គារ ទី២៥ ខែមេសា ឆ្នាំ ២០២៣ កូនរ មិល គុណ ចិត្ត ជាតិ រច្ឆាន ស៊ន តារា ប្រកាស កាត់ កាល ម៉ែ ឪ និង ក្រុមគ្រួសារ របស់ ខ្លួន ។ ការប្រកាស កាត់កាល បាន ធ្វើឡើង តាមរយៈ ទំព័រ ហ្វេសប៊ុក របស់ ស៊ន តារា ផ្ទាល់ តែម្តង ។
លោក សុខ ស៊ុន ណារ៉េត ជា មន្ត្រី យោធា និង លោកស្រី ពិល វ៉ាន់ ថុន ដែល ជា ឪពុក ម្តាយ របស់ ស៊ន តារា ធ្លាប់ បាន សម្តែង ការខកចិត្ត និង ខូចចិត្ត ជាខ្លាំង ចំពោះ ភាពរមិល គុណ និង អកតញ្ញូ របស់ ស៊ន តារា ធ្វើ ចំពោះ ពួកគាត់ ។ ក្នុង នោះ លោកស្រី ពិល វ៉ាន់ ថុន បាន កើត វិបត្តិ ផ្លូវចិត្ត រហូតដល់ ពេល បច្ចុប្បន្ន ថែម ទៀត ផង ។
ភាពរមិល គុណ និង ការប្រកាស កាត់ កាល ឪពុក ម្តាយ និង ក្រុមគ្រួសារ របស់ ស៊ន តារា នៅ ថ្ងៃ នេះ គឺជា ការបង្ហាញ ពី សណ្តាន ជា សត្វ តិរច្ឆាន របស់ ស៊ន តារា ។ ទង្វើ របស់ ស៊ន តារា ជា ទង្វើ ថោក ទាប និង ស្អប់ខ្ពើម បំផុត នៅក្នុង សង្គម ខ្មែរ ជា សង្គម តម្កល់ ខ្ពស់ នូវ ការគោរព ដឹងគុណ ចំពោះ អ្នកមាន គុណ ជាពិសេស លោកឪពុក អ្នកម្តាយ ដែល ត្រូវបាន ចាត់ទុក ជា ព្រះរស់ នៅក្នុង ផ្ទះ ។
បើ តាម ធម៌ របស់ ព្រះសម្មាសម្ពុទ្ធ ព្រះបរម គ្រូ វិញ កូន ចិត្ត ជា សត្វ តិរច្ឆាន អន្យតិ រ្ថិយ មិន ដឹង បាប បុណ្យ គុណ ទោស ដូច ស៊ន តារា នា ពេលនេះ នឹង ធ្លាក់ ទៅ ឋាន នរក រាប់ សិប ជាន់ ។
ទង្វើ របស់ ស៊ន តារា ជា ការបង្ហាញ នូវ គំរូ ដ៏ អាក្រក់ ជូរ ជាតិ ដែល ប្រវត្តិ មនុស្សជាតិ នៅលើ ពិភពលោក នេះ ជាពិសេស ក្នុង សង្គម កម្ពុជា តែម្តង កម្រ នឹង កើតមាន ៕
ខេត្ត រតនគិរី អគារ សម្ភព មណ្ឌល សុខភាព អូរ ជុំ តា វែង និង អណ្តូង មាស នៃ ខេត្ត រតនគិរី ព្រមទាំង អគារ សម្ភព នៃ មន្ទីរពេទ្យ បង្អែក ស្រុក កោះ ញែក ខេត្ត មណ្ឌលគីរី បាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ព្រម គ្នា នៅ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
លោក រដ្ឋមន្ដ្រី សុខាភិបាល បាន ថ្លែង ថា ក្នុង នាម ក្រសួង សុខាភិបាល សម្ដែង នូវ ការអបអរសាទរ ជាមួយ ប្រជាពលរដ្ឋ ខេត្ត រតនគិរី និង ខេត្ត មណ្ឌលគីរី ដែល បាន ទទួល អគារ ដ៏ ថ្មី ស្រឡាង ចំនួន ៥ខ្នង នា ថ្ងៃ នេះ ។
សមិទ្ធផល ថ្មី នា ថ្ងៃ នេះ គឺជា ចំណង ដៃ ដ៏ ថ្លៃថ្លា មួយ សបញ្ជាក់ ពី ចំណង មិត្តភាព សាមគ្គីភាព ជា ប្រពៃណី រវាង កម្ពុជា - កូរ៉េ ដែល នឹង ចូលរួមចំណែក យ៉ាង សំខាន់ ដល់ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការគ្រប ដណ្តប់ សេវា សុខភាព ជា សកល ជាពិសេស ជូន ដល់ ប្រជាជន គ្រប់ រូប ពោលគឺ មិន ទុក ឱ្យ ប្រជាជន ណា ម្នាក់ មិន បាន ទទួល ការថែទាំ សុខភាព នោះ ឡើយ ។
ឆ្លៀត ក្នុង ឱកាស នេះ លោក រដ្ឋមន្ដ្រី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន រដ្ឋាភិបាល និង ប្រជាជន កូរ៉េ និង ជាពិសេស ស្ថានទូត នៃ សាធារណរដ្ឋ កូរ៉េ ប្រចាំ កម្ពុជា និង អង្គការ KOICA ដែល បាន សម្របសម្រួល ឱ្យ កម្ពុជា ទទួល នូវ ជំនួយ ដ៏ ថ្លៃថ្លា នេះ ជូន ប្រជាជន ខេត្ត រតនគិរី និង ខេត្ត មណ្ឌលគីរី ។
ជាមួយគ្នា នោះ លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង ក៏ បាន ថ្លែងអំណរគុណ ដល់ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ដែល បាន ជួយ ឧបត្ថម្ភ សហការ គាំទ្រ ការអនុវត្ត គម្រោង សាងសង់ អគារ សម្ភព និង ទារក បាន សម្រេច ដោយ ជោគជ័យ ។
ទន្ទឹម នឹង នោះ លោក រដ្ឋមន្ដ្រី សុខាភិបាល ក៏ បាន ស្នើ ឯក អគ្គ រដ្ឋទូត និង លោក ប្រធាន អង្គការ KOICA បន្ត ផ្តល់ គម្រោង ថ្មី ៗ បន្ថែម ទៀត ដើម្បី ពង្រឹង ផ្នែក គាំពារ មាតា និង ទារក នៅក្នុង ខេត្ត ភូមិភាគ ឥសាន ទាំង ពីរ នេះ ក្នុង ការធានា បាន នូវ ការផ្តល់ សេវា ទាន់ ពេលវេលា ក៏ ដូចជា កាត់បន្ថយ ការបញ្ជូន អ្នកជំងឺ ទៅកាន់ មន្ទីរពេទ្យ នៅ រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ថា បន្ទាប់ពី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ អគារ ខាងលើ នេះ លោក រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង និង ភាគី កូរ៉េ ក៏ បាន ដើរ ទស្សនកិច្ច ក្នុង អគារ សម្ភព ថ្មី នេះ និង ពិភាក្សា គ្នា បន្ថែម ទៀត លើ ការពង្រឹង ធនធាន មនុស្ស និង សម្ភារៈ បរិក្ខារ ពេទ្យ ដែល បាន បំពាក់ នៅក្នុង មន្ទីរពេទ្យ ៕
អ្នកជំនា ញ៖ អ្នកសារព័ត៌មាន មាន សារៈសំខាន់ ដើម្បី ធ្វើឱ្យ តំបន់ ទន្លេគង្គ មាន សន្តិភាព ស្ថិរភាព និង វិបុលភាព
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា បាន លើកឡើង ថា អ្នកសារព័ត៌មាន ពិតជា មាន សារៈសំខាន់ ខ្លាំង ណាស់ ដើម្បី នាំមក នូវ ព័ត៌មាន ពិត ពី តំបន់ ទន្លេគង្គ ដែល រួមចំណែក មិន អាច ខ្លះ បាន ក្នុង ការធ្វើឱ្យ តំបន់ មេគង្គ របស់ យើង មាន សន្តិភាព ស្ថិរភាព និង វិបុលភាព ។
ការលើកឡើង បែប នេះ របស់ លោក បណ្ឌិត គិន ភា បាន ធ្វើឡើង នៅក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ចូលរួម ថ្លែង សន្ទរកថា ពិធី បើក សិក្ខាសាលា បណ្តុះបណ្តាល សារព័ត៌មាន តំបន់ ទន្លេ មេគង្គ លើក ទី២ ក្រោម ប្រធានបទ « ការចូលរួម របស់ ប្រព័ន្ធ ផ្សព្វផ្សាយ ដើម្បី តំបន់ ទន្លេ មេគង្គ សន្តិភាព ស្ថិរភាព និង វិបុលភាព » នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ នៅ រាជ បណ្ឌិត្យ សភា កម្ពុជា ។ ពិធី បើក សិក្ខាសាលា បាន ប្រព្រឹត្ត ធ្វើឡើង ក្រោម អធិបតីភាព លោក បណ្ឌិត សភាចារ្យ សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា ។
ត្រង់ ចំណុច នេះ លោក បណ្ឌិត គិន ភាព បាន ថ្លែង ថា រដ្ឋាភិបាល នៃ ប្រទេស ទាំង៦ តាម ដងទន្លេ មេគង្គ បាន មើលឃើញ ពី អត្ថប្រយោជន៍ សេដ្ឋកិច្ច នៃ ការអភិវឌ្ឍ ធនធាន មេគង្គ ដូច្នេះ ប្រទេស ទាំង៦ នៃ តំបន់ មេគង្គ តែងតែ បន្ត ពិភាក្សា ពិគ្រោះយោបល់ គ្នា ចាប់ យក បទពិសោធន៍ ទៅ វិញ ទៅ មក ពង្រឹង កិច្ចសហប្របត្តិការ គ្នា ចៀស ជាង ការជជែក ដេញដោល គ្នា ឥត ន័យ ដែល បង្កឡើង ដោយ ប្រទេស ក្រៅ តំបន់ មួយចំនួន ដើម្បី បំភាន់ មតិ សាធារណៈ ។
លោក បណ្ឌិត គិន ភា បាន លើកឡើង យ៉ាង ដូច្នេះ ថា៖ « អ្នកសារព័ត៌មាន ពិតជា មាន សារៈសំខាន់ ខ្លាំង ណាស់ ដើម្បី នាំមក នូវ ព័ត៌មាន ពិត ពី តំបន់ ទន្លេគង្គ ដែល រួមចំណែក មិន អាច ខ្លះ បាន ក្នុង ការធ្វើឱ្យ តំបន់ មេគង្គ របស់ យើង មាន សន្តិភាព ស្ថិរភាព និង វិបុលភាព » ។
បន្ថែម ពី នេះ អ្នកជំនាញ រូប នេះ បាន គូសបញ្ជាក់ ថា បើសិនជា អ្នកសារព័ត៌មាន នៅ តំបន់ មេគង្គ មិន យកចិត្តទុកដាក់ ទេ អាច មាន នាំ តំបន់ ទន្លេ មេគង្គ ឱ្យ បញ្ហា ធំ ទៅក្នុង បញ្ហា នយោបាយ នៅក្នុង ប្រទេស តាម ដងទន្លេ មេគង្គ ។
បើ តាម លោក គី សុខ លីម ទីប្រឹក្សា ក្លឹប អ្នកាសែត កម្ពុជា បាន លើកឡើង ថា ទន្លេ ម គង្គ គឺជា ទន្លេ មួយ ដ៏ អស្ចារ្យ ដូច្នេះ អ្នកសារព័ត៌មាន នៅ តាម បបណ្តា ប្រទេស ដង ទន្លេ មេគង្គ នីមួយ ៗ គួរតែ ធ្វើ សេចក្តីរាយការណ៍ ឱ្យ បាន ច្រើន ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម តំបន់ ទន្លេ មេគង្គ អាច យល់ គ្នា បាន អាច ស្រឡាញ់ គ្នា បាន តាមរយៈ ការផ្សព្វផ្សាយ ពី វប្បធម៌ ជាដើម ។
លោក គី សុខ លីម បាន បន្ត ថា៖ « អ្នកសារព័ត៌មាន អាច ធ្វើ អ្វី បាន ខ្លះ សម្រាប់ តំបន់ ទន្លេ មេគង្គ របស់ យើង ទាំងមូល អ៊ឹចឹង ដើម្បីឱ្យ សន្តិភាព ស្ថិរភាព ឬ វិបុលភាព ខ្ញុំ គិត ថា តួនាទី របស់ អ្នកសារព័ត៌មាន មាន សារៈសំខាន់ ខ្លាំង មែនទែន យើង អាច ធ្វើ សេចក្តីរាយការណ៍ ពី សក្តានុភាព របស់ តំបន់ ទន្លេ មេគង្គ ពី វប្បធម៌ ពី ម្ហូប អាហារ ... !» ។
តំបន់ មេគង្គ មាន ភាពងាយ រងគ្រោះ ចំពោះ ឧបាយកល នៃ ការនិទាន កថា ទាក់ទង នឹង លទ្ធិ ប្រជាធិបតេយ្យ សិទ្ធិ មនុស្ស និង នីតិរដ្ឋ ដែល ធ្វើឱ្យ ការបែងចែក ភូមិសាស្ត្រ នយោបាយ កាន់តែ ធ្ងន់ធ្ងរ រំខាន ដល់ សមាហរណកម្ម និង កិច្ចសហប្រតិបត្តិការ និង ការព្យាយាម បំបែក ពិភពលោក ទៅជា ប្លុក មនោគម វិជ្ជា និង អំណាច ។
លទ្ធិ ប្រជាធិបតេយ្យ កំពុង ត្រូវបាន ចាប់ ពង្រត់ ដើម្បី គ្រប់គ្រង ពិភពលោក ការប្រឌិត « ការបារម្ភ អំពី លទ្ធិ ប្រជាធិបតេយ្យ » និង អ្នកគាំទ្រ ប្លុក នយោបាយ និង ការប្រឆាំង បក្សពួក ដែល ជា ចិត្ត គំនិត នៃ សង្គ្រាម ត្រជាក់ មួយ បែប ។
ប្រទេស មួយចំនួន កំពុង បន្លឺ សំឡេង នៃ « លទ្ធិ ប្រជាធិបតេយ្យ » និង « សិទ្ធិ មនុស្ស » ម្ដង ហើយ ម្តង ទៀត ហើយ បាន ប្រើ អំណាច ទាំងអស់ របស់ ពួកគេ លើ ការទប់ស្កាត់ ប្រទេស ដែល មិន ធ្វើ តាម គំរូ របស់ ពួកគេ ។ ពួកគេ តែងតែ ព្យាយាម បិទបាំង នូវ ភាព បរាជ័យ និង ភាពវឹកវរ ក្នុង ស្រុក របស់ ពួកគេ ដោយ បង្វែរ ការ ស្តីបន្ទោស ទៅកាន់ ប្រទេស ផ្សេង ទៀត ដូចជា ប្រទេស មេគង្គ ទាំង៦ ជាដើម ។
លទ្ធិ ប្រជាធិបតេយ្យ មិន មាន សំណុំ សា្ថប័ន តែ មួយ គត់ និង លក្ខណៈ ពិសេស តែ មួយ គត់ ដែល អាច អនុវត្ត បាន ជា សកល នោះ ទេ ។ ទម្រង់ ជាក់លាក់ ដែល លទ្ធិ ប្រជាធិបតេយ្យ កើតឡើង ក្នុង ប្រទេស មួយ ត្រូវ មាន ការជាប់ពាក់ព័ន្ធ យ៉ាង ទូលំទូលាយ ជាមួយនឹង ស្ថានការណ៍ នយោបាយ សង្គម និង សេដ្ឋកិច្ច ដែល មាន ស្រាប់ នៅក្នុង ប្រទេស នោះ ។
គេ មិន ត្រូវ សម្លឹងមើល លទ្ធិ ប្រជាធិបតេយ្យ តែ ទៅ លើ មូលដ្ឋាន នៃ ប្រព័ន្ធ នយោបាយ របស់ ប្រទេស ដោយ ព្រងើយ កន្តើយ នឹង ពិពិធភាព ឬ ភាពចម្រុះ នៃ អរិយធម៌ នៃ ប្រទេស នោះ បាន ឡើយ ។
សូម ជម្រាប ថា សិក្ខាសាលា នេះ រៀចំឡើយ ដោយ វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា និង ក្លិប អ្នកកាសែត កម្ពុជា ។ សិក្ខាសាលា នេះ ប្រព្រឹត្តទៅ រយៈពេល ៣ ថ្ងៃ គឺ ចាប់ ថ្ងៃទី ២៦ ដល់ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២៣ នៅ រាជ បណ្ឌិត្យ សភា កម្ពុជា ដែល មាន អ្នកសារព័ត៌មាន ប្រមាណ ៥០ នាក់ មកពី ប្រទេស កម្ពុជា ឡាវ មីយ៉ាន់ម៉ា ថៃ និង វៀតណាម និង អ្នកជំនាញ មកពី អូស្ត្រាលី ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ ព្រឹទ្ធសភា អំពី របៀបវារៈ នៃ កិច្ច ប្រជុំ៖
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង វប្បធម៌ កម្ពុជា ជាប់ ជា អគ្គ លេខាធិការ សម្រាប់ អាណត្តិ ដំបូង របស់ សម្ព័ន្ធភាព សម្រាប់ បេតិកភណ្ឌ វប្បធម៌ អាស៉ី
( ភ្នំពេញ ) ៖ ដោយ មាន ប្រទេស ចំនួន ២២ និង អង្គការ អន្តរជាតិ ចំនួន ៣ ចូលរួម សន្និបាត សម្ព័ន្ធភាព សម្រាប់ បេតិកភណ្ឌ ត្រូវបាន រៀបចំឡើង នៅ ថ្ងៃទី ២៤ - ២៥ ខែមេសា ឆ្នាំ ២០២៣ នៅ ទីក្រុង ស៉ី អាន ខេត្ត សាន ស៉ី សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
លោក គង់ វីរៈ អនុ រដ្ឋលេខាធិការ បាន ចូលរួម សន្និបាត ខាងលើ ក្នុង នាម ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ជា តំណាង លោកស្រី បណ្ឌិត សភាចារ្យ រដ្ឋមន្ត្រី ។ សន្និបាត នេះ មាន របៀបវារៈសំខាន់ ៗ ចំនួន ៤គឺ៖
* ១៖ ការអនុម័ត លើ សេចក្តីព្រាង លក្ខន្តិកៈ * ២៖ គ្រោង ការងារ សម្រាប់ ឆ្នាំ ២០២៣ - ២០២៤ * ៣៖ ការបោះឆ្នោត ជ្រើសរើស អគ្គ លេខាធិការ * និង ៤. ការអនុម័ត សេចក្តីប្រកាស ទីក្រុង ស៉ី អាន នៃ សម្ព័ន្ធភាព សម្រាប់ បេតិកភណ្ឌ វប្បធម៌ អាស៉ី ។
ជា មោទកភាព សម្រាប់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ លោក គង់ វីរៈ ត្រូវបាន អង្គ សន្និបាត បោះឆ្នោត ឱ្យ ធ្វើជា អគ្គ លេខាធិការ សម្រាប់ អាណត្តិ ដំបូង របស់ សម្ព័ន្ធភាព សម្រាប់ បេតិកភណ្ឌ វប្បធម៌ អាស៉ី នា អាណត្តិ ឆ្នាំ ២០២៣ - ២០២៤ ដោយ សម្លេង ភាគ ច្រើន ។
សូម បញ្ជាក់ ថា កម្ពុជា គឺជា ប្រទេស មួយ ក្នុង ចំណោម ប្រទេស ចំនួន ១០ ដែល ជា ស្ថាបនិក របស់ សម្ព័ន្ធ ភាព សម្រាប់ បេតិកភណ្ឌ វប្បធម៌ អាស៉ី ។ សម្ព័ន្ធភាព នេះ បង្កើតឡើង ក្នុង គោលបំណង រៀបចំ យន្តការអន្តរ រដ្ឋាភិបាល សម្រាប់ កិច្ចសហប្រតិបត្តិការ បេតិកភណ្ឌ វប្បធម៌ ក្នុង ចំណោម ប្រទេស អាស៉ី ៕
រដ្ឋមន្ត្រី ថោង ខុន បើក វេទិកា ទេសចរណ៍ មេគង្គ ឆ្នាំ ២០២៣ ក្រោម ប្រធានបទ « ការគិត ឡើងវិញ សម្រាប់ ភាពធន់ និង ឌីជីថល នីយកម្ម »
ជា កិច្ច ចាប់ផ្តើម នា ឱកាស នោះ លោក រដ្ឋមន្ត្រី ថោង ខុន ក៏ បាន បង្ហាញ សេចក្តី សោមនស្ស រីករាយ និង កិត្តិយស ដែល បាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ វត្តមាន របស់ គណៈប្រតិភូ និង ភ្ញៀវ កិត្តិយស មកពី ប្រទេស ចំនួន ១៩ មកកាន់ វេទិកា ទេសចរណ៍ មេគង្គ ឆ្នាំ ២០២៣ ដែល កម្ពុជា បាន ធ្វើជា ម្ចាស់ ផ្ទះ និង បាន អះអាង ថា នេះ ជា លើក ទី៣ ហើយ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៃ វេទិកា ទេសចរណ៍ មេគង្គ នេះ ។
លោក ថោង ខុន អះអាង ដែរ ថា វេទិកា នេះ គឺជា វេទិកា កិច្ចសហប្រតិបត្តិការ ដ៏ ទូលំទូលាយ មួយ របស់ GMS រវាង រដ្ឋាភិបាល អ្នករៀបចំ គោល នយោបាយ វិទ្យាស្ថាន អ្នកជំនាញ អាជ្ញាធរ ពាក់ព័ន្ធ អ្នក ពាក់ព័ន្ធ វិស័យ ឯកជន និង សាធារណៈ ក្នុង ឧស្សាហកម្ម ទេសចរណ៍ ដើម្បី ពិភាក្សា និង ចែករំលែក ការអនុវត្ត ល្អ ៗ បទពិសោធន៍ ស្ថានភាព បច្ចុប្បន្ន នៃ ការអភិវឌ្ឍន៍ ទេសចរណ៍ ការសិក្សា ទីផ្សារ និង ការផ្សព្វផ្សាយ ទេសចរណ៍ ក្នុង តំបន់ GMS ។
ជាមួយគ្នា នោះ លោក ថោង ខុន ក៏ បាន បង្ហាញ ក្តី រំពឹង ដែរ ថា ភាគី ពាក់ព័ន្ធ សំខាន់ ៗ ពី វិស័យ សាធារណៈ និង ឯកជន នឹង បង្កើត ឱកាស ពិសេស មួយ ដើម្បី ជម្រុញ ក្របខ័ណ្ឌ ប្រកបដោយ ការច្នៃប្រឌិត និង កិច្ចសហការ សម្រាប់ ការងើប ឡើងវិញ នៃ វិស័យ ទេសចរណ៍ ឆ្ពោះ ទៅរក ភាពធន់ នៅក្នុង យុគសម័យ ក្រោយ វិបត្តិ ជំងឺ កូវីដ - ១៩ និង នាំយក មកវិញ នូវ អ្វី ដែល បាន បាត់បង់ ក្នុង វិស័យ ទេសចរណ៍ ជាពិសេស អាជីវកម្ម និង ចំណូល ទេសចរណ៍ ។
* យុទ្ធសាស្ត្រ ទេសចរណ៍ មេគង្គ ២០១៦ - ២០២៥. បង្កើន ការចូលរួម សកម្មភាព ភាព ជាដៃគូ សាធារណៈ និង ឯកជន
* បន្ត សហការ ជាមួយ ដៃគូ អភិវឌ្ឍន៍ អង្គការ អន្តរជាតិ វិស័យ ឯកជន និង ប្រព័ន្ធ ផ្សព្វផ្សាយ ដើម្បី ជំរុញ ការងើប ឡើងវិញ ប្រកបដោយ ភាពធន់ ។
លោក ថោង ខុន ក៏ បាន បង្ហាញ ជំនឿ យ៉ាង មុតមាំ ថា តាមរយៈ ការពិភាក្សា នៅក្នុង វេទិកា ទេសចរណ៍ មេគង្គ ឆ្នាំ ២០២៣ នេះ នឹង ទទួលបាន ការយល់ដឹង បន្ថែម ជា មូលដ្ឋានគ្រឹះ សម្រាប់ ការអភិវឌ្ឍ ក្របខ័ណ្ឌ ច្បាប់ ចាំបាច់ ដើម្បី លើកកម្ពស់ និង ជម្រុញ ការអភិវឌ្ឍ ទេសចរណ៍ សម្រាប់ តំបន់ GMS ទាំងមូល ផងដែរ ៕
ក្រសួង ការពារ ជាតិ តៃវ៉ាន់ បាន និយាយ ថា សមយុទ្ធ យោធា ហាន គ័ង នឹង ត្រូវ បែងចែកចេញ ពី ២ ផ្នែក ធំ ៗ គឺ សមយុទ្ធ ដោយ ប្រើប្រាស់ ទ្រឹស្តី ចាប់ពី ថ្ងៃទី ១៥ - ១៩ ខែឧសភា ហើយនិង សមយុទ្ធ ដោយ ចល័ត កម្លាំង ទ័ព ចាប់ពី ថ្ងៃទី ២៤ - ២៨ ខែកក្កដា ដែល នឹង រួម មាន ការធ្វើ លំហាត់ បាញ់ គ្រាប់ ពិត ផងដែរ ។ សម្រាប់ ការផ្តោត សំខាន់ នៃ សមយុទ្ធ យោធា នេះ គឺ នឹង ផ្តោត លើ ការរក្សា កម្លាំង ទ័ព និង ការវាយ បំបែក សកម្មភាព ឡោមព័ទ្ធ ។
គួរ បញ្ជាក់ ថា ចិន ដែល ចាត់ទុក តៃវ៉ាន់ ជា ផ្នែក មិន អាច កាត់ផ្តាច់ បាន នៃ ទឹកដី របស់ ខ្លួន គឺ មិន ដែល ធ្លាប់ បោះបង់ ចោល ជម្រើស ប្រើប្រាស់ យោធា ដើម្បី បង្រួបបង្រួមគ្នា វិញ ជាមួយ ដែន កោះ នេះ ឡើយ ហើយ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ទីក្រុង ប៉េកាំង បាន បង្កើន ការដាក់ សម្ពាធ ផ្នែក យោធា ជាខ្លាំង ទៅ លើ កោះ តៃវ៉ាន់ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ១៦១ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣១
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២.៤៤៤ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១.៧៩១ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៦៥៣ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក អត់ ផ្លាកលេខ ស្រវឹង និង ល្មើស សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ទូរស័ព្ទ អត់ បណ្ណ បើកបរ ខ្សែក្រវាត់ ស្រវឹង ឆៀក ល្មើស ល្បឿន និង ល្មើស សញ្ញា ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៨ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៥ នាក់ របួស ចំនួន ១២នាក់ ( របួស ធ្ងន់ ចំនួន ១០នាក់ ) ។ រយៈពេល ២៦ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ២៤១ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១១៤ នាក់ របួស ៣៧១ នាក់ ( របួស ធ្ងន់ ២៥៣ នាក់ )៕
រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង ផ្សាយ បន្ត ផ្ទាល់ ការប្រកួត បាល់ទាត់ របស់ ក្រុម ជម្រើសជាតិ កម្ពុជា នៅ តាម ទីតាំង ៧កន្លែង
ទីតាំង ទាំង ៧រួម មាន៖
* ទី១៖ សួនច្បារ មុខ វត្ត បទុមវតី ស្ថិត នៅក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ
* ទី២៖ សួនច្បារ មាត់ ទន្លេ ទល់ មុខ ភោជនីយដ្ឋាន មេត្រូ ស្ថិត នៅក្នុង សង្កាត់ ផ្សារ កណ្តាល ទី១ ខណ្ឌ ដូនពេញ
* ទី៣៖ ក្នុង បុរី ប៉េង ហួត បឹង ស្ងោរ ស្ថិត នៅក្នុង សង្កាត៍ និរោធ ខណ្ឌ ច្បារអំពៅ
* ទី៤៖ សួនច្បារ មិត្តភាព ក្បែរ ក្រសួង ការពារ ជាតិ ស្ថិត នៅក្នុង សង្កាត់ មិត្តភាព ខណ្ឌ ៧មករា
* ទី៥៖ សួនច្បារ ទល់ វិទ្យាស្ថាន ស្រាវជ្រាវ និង អភិវឌ្ឍន៍ ព្រៃឈើ - សត្វ ព្រៃ ស្ថិត នៅក្នុង សង្កាត់ គោក ឃ្លាង ខណ្ឌ សែនសុខ
* ទី៦៖ សួនច្បារ ព្រះនាង ប្រាជ្ញា បារមី ស្ថិត នៅក្នុង សង្កាត់ ជ្រោយចង្វារ ខណ្ឌ ជ្រោយ ចង្វារ
* ទី ៧៖ ទីលាន ប្រជាធិបតេយ្យ ក្បែរ ស្ពាន អាកាស ឫស្សីកែវ ស្ថិត នៅក្នុង សង្កាត់ ឫស្សីកែវ ខណ្ឌ ឫស្សីកែវ ។
អំបិល កំពត កែប ទឹកត្រី កំពត កែប បង្កង តាកែវ ត្រូវបាន ក្រសួង ពាណិជ្ជកម្ម ចុះបញ្ជី ជា ម៉ាក សម្គាល់ ភូមិសាស្រ្ត ទំនិញ (GI) ខណៈ ដូង ខ្ទិះ បាត់ដំបង នំបញ្ចុក សៀមរាប ក្រូច ថ្លុង កោះ ពីរ និង អំបុក កំពង់ធំ ត្រូវបាន ចុះបញ្ជី ជា ម៉ាក សមូហភាព ។
លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម និង ជា ប្រធាន គណៈកម្មធិការ ជាតិ គ្រប់គ្រង កម្មសិទ្ធិ បញ្ញា បាន ថ្លែង ថា ការចុះបញ្ជី ម៉ាក់ សម្គាល់ ភូមិសាស្រ្ត ទំនិញ និង ម៉ាក សមូហភាព ដល់ ផលិតផល ទាំងនេះ គឺជា ទិសដៅ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ក្នុង ការបង្កើន តម្លៃ បន្ថែម ដល់ ផលិតផល ក្នុង ស្រុក និង ពង្រឹង ភាពប្រកួតប្រជែង ផលិតផល ខ្មែរ នៅក្នុង ទីផ្សារ ក្នុង ស្រុក និង នាំចេញ ។
លោក មានប្រសាសន៍ ថា « ការចុះបញ្ជ ផលិតផល ទាំងនេះ គឺជា សមិទ្ធផល ដ៏ សំខាន់ ដោយ យើង បាន ខិតខំ រួមគ្នា បង្កើត ចង ក្រង អភិរក្ស ថែរក្សា អភិវឌ្ឍ ផលិតផល ក្នុង ស្រុក ឱ្យ មាន តម្លៃ បន្ថែម ខ្ពស់ និង ផ្សព្វផ្សាយ ពី វប្បធម៌ របស់ ខ្មែរ យើង ។ ខ្ញុំ ជឿជាក់ យ៉ាង មុតមាំ ថា ម៉ាក សម្គាល់ ភូមិសាស្រ្ត ទំនិញ និង ម៉ាក សមូហភាព នឹង ជំរុញឱ្យ មាន កំណើន តម្រូវការ ផលិតផល លើ ទីផ្សារ ជាតិ និង អន្តរជាតិ កាន់តែ ច្រើន និង ជា ផ្នែក មួយ នៃ គោលដៅ ទេសចរណ៍ ផងដែរ » ។
លោក សួន វិជ្ជា ប្រធាន នាយកដ្ឋាន កម្មសិទ្ធិ បញ្ញា នៃ ក្រសួង ពាណិជ្ជកម្ម ការចុះ ម៉ាក សម្គាល់ ភូមិសាស្រ្ត ទំនិញ និង ម៉ាក សមូហភាព នឹង ជំរុញ ការផ្សព្វផ្សាយ ផលិតផល ខ្មែរ ដែល ទើប ទទួលបាន ការចុះបញ្ជី ការពារ កម្មសិទ្ធិ បញ្ញា ឱ្យ បាន ទូលំទូលាយ និង លើកទឹកចិត្ត ដល់ កសិករ ដែល សម្រេចបាន នូវ សមិទ្ធផល ជា ទីមោទកៈ សម្រាប់ ការអភិវឌ្ឍ ផលិតផល និង អាជីវកម្ម របស់ ខ្លួន ។
លោក បន្ត ថា ភាពជោគជ័យ នៅក្នុង ការកសាង ម៉ាក សម្គាល ភូមិសាស្រ្ត ទំនិញ ម៉ាក សមូហភាព នា ពេល កន្លងមក បាន ធ្វើឱ្យ ផលិតផល កម្ពុជា ជាច្រើន បាន ឈានចូល ទៅក្នុង ទីផ្សារ បរទេស និង មាន ឈ្មោះ ល្បី ជាខ្លាំង ដូចជា ម្រេច កំពត គុយ ទាវ ភ្នំពេញ និង ស្ករ ត្នោត កំពង់ស្ពឺ ។ ផលិតផល ទាំងនេះ មិន ត្រឹមតែ ទទួលបាន តម្លៃ ខ្ពស់ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ បាន ក្លាយជា ផលិតផល ដែល រួមចំណែក ផ្សព្វផ្សាយ នូវ សក្តានុពល ទេសចរណ៍ របស់ ខេត្ត វប្បធម៌ ប្រពៃណី ទំនៀមទម្លាប់ ប្រវត្តិសាស្រ្ត របស់ ប្រជាពលរដ្ឋ កម្ពុជា នៅលើ ឆាក អន្តរជាតិ ផងដែរ ។
លោក លូង ហ៊ុន ប្រធាន សមាគម អ្នកផលិត និង អាជីវករ ក្រូច ថ្លុង កោះ ពីរ បាន លើកឡើង ថា បន្ទាប់ពី ក្រូច ថ្លុង កោះ ពីរ ចុះបញ្ជី ជា ម៉ាក សមូហភាព នឹង ជំរុញ ឱ្យ កេរ្តិ៍ឈ្មោះ របស់ ក្រូច កោះ ពីរ ខេត្ត ត្បូងឃ្មុំ នឹង កាន់តែ ល្បី មាន ទីផ្សារ ល្អ និង មាន ការគាំទ្រ ពី អ្នកបរិភោគ ច្រើន ជាង មុន ខណៈ បច្ចុប្បន្ន នេះ ក្រូច ថ្លុង កោះ ពីរ ផ្គត់ផ្គង់ ត្រឹមតែ ទីផ្សារ ក្នុង ខេត្ត ត្បូងឃ្មុំ កំពង់ចាម និង ភ្នំពេញ ប៉ុណ្ណោះ ដោយសារ មិន មាន ម៉ាក សញ្ញា ដែល គេ ទទួលស្គាល់ ។
លោក បាន ឱ្យដឹង ថា អ្វី ដែល ជំរុញ ឱ្យ ក្រូច ថ្លុង កោះ ពីរ ចុះបញ្ជី ម៉ាក សមូហភាព ដោយសារ ក្រូច របស់ តំបន់ នេះ មាន រសជាតិ ឆ្ងាញ់ ផ្អែម កំពឹស ទន់ មួយ បែប ពី ក្រូច ថ្លុង កោះ ទ្រុង ខេត្ត ក្រចេះ ។ លោក សង្ឃឹម ថា បន្ទាប់ពី ក្រូច ថ្លុង កោះ ពីរ ចុះបញ្ជី ជា ម៉ាក សមូហភាព ការផ្គត់ផ្គង់ កាន់តែ ធំ ទូលាយ ព្រម ទទួលបាន តម្លៃ បន្ថែម ខ្ពស់ ជាង បច្ចុប្បន្ន នេះ ដែល ធ្វើឱ្យ សហគមន៍ មាន ជីវភាព ល្អ ស្រប ពេល ប្រជា សហគម បាន និង កំពុង ពង្រីក ផ្ទៃដី ដាំដុះ ផងដែរ ។
លោក សាប់ សារុន ប្រធាន សមាគម បង្កង ខេត្ត តាកែវ បាន ឱ្យដឹង ថា ខណៈពេល ដែល បង្កង តាកែវ បាន ចុះបញ្ជី ម៉ាក សម្គាល់ ភូមិសាស្រ្ត ទំនិញ សមាគម បាន និង កំពុង រៀបចំ ពង្រីក ទីផ្សារ និង បង្កើន ការផលិត បន្ថែម ពោលគឺ ក្នុង កសិដ្ឋាន នីមួយ ៗ ដែល ធ្លាប់ ទទួលបាន ទិន្នផល ១តោន ក្នុង មួយ ឆ្នាំ នឹង បង្កើន ការផលិត ឱ្យ បាន ២តោន ក្នុង មួយ ឆ្នាំ ដើម្បី បង្កើន ការផ្គត់ផ្គង់ ទីផ្សារ ឱ្យ បាន យ៉ាងហោចណាស់ ១០០ គីឡូ ក្នុង មួយ ថ្ងៃ ៕
រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ក្រើន រំឮ ក អ្នកសារព័ត៌មាន ទាំងអស់ ត្រូវ ផ្សព្វផ្សាយ ព័ត៌មាន ប្រកបដោយ វិជ្ជាជីវៈ ក្រមសីលធម៌ និង មាន ប្រភព ច្បាស់លាស់
( សៀមរាប ) ៖ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បាន ក្រើន រំឮ ក អ្នកសារព័ត៌មាន ទាំងអស់ ត្រូវ ផ្សព្វផ្សាយ ព័ត៌មាន ប្រកបដោយ វិជ្ជាជីវៈ ក្រមសីលធម៌ និង ឲ្យ មាន ប្រភព ច្បាស់លាស់ ដែល ការក្រើន នេះ បាន ធ្វើឡើង នៅក្នុង សិក្ខាសាលា ស្តីពី តួនាទី ភារកិច្ច និង សីលធម៌ វិជ្ជាជីវៈ អ្នកសារព័ត៌មាន នៅ សាល ប្រជុំ សាលា ខេត្ត សៀមរាប នា ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
ថ្លែង ក្នុង ពិធី បើក សិក្ខាសាលា ពី តួនាទី ភារកិច្ច និង សីលធម៌ វិជ្ជាជីវៈ អ្នកសារព័ត៌មាន លោក លីវ សុខុន ប្រធាន មន្ទីរព័ត៌មាន ខេត្ត សៀមរាប បាន លើកឡើង អំពី លទ្ធផល ការងារ ដែល មន្ទីរ បាន អនុវត្ត កន្លងមក និង ការគ្រប់គ្រង ស្ថាប័ន អង្គភាព សារព័ត៌មាន ដែល បាន ចុះបញ្ជី ស្រប ច្បាប់ បាន កំពុង ធ្វើ សកម្មភាព ក្នុង ខេត្ត សៀមរាប ព្រមទាំង បាន លើកឡើង ពី បញ្ហា ប្រឈម និង សំណូមពរ មួយចំនួន ផងដែរ ។
លោក ខៀវ កាញារីទ្ធ បាន ធ្វើ ការក្រើន រំឮក ដល់ អ្នកសារព័ត៌មាន ទាំងអស់ ត្រូវ ផ្សព្វផ្សាយ ព័ត៌មាន របស់ ខ្លួន ប្រកបដោយ វិជ្ជាជីវៈ ក្រមសីលធម៌ និង ឲ្យ មាន ប្រភព ច្បាស់លាស់ ដែល ការផ្សាយ ព័ត៌មាន ពិត វា នឹង ក្លាយជា អាវ ក្រោះ ការពារ អ្នកសារព័ត៌មាន ពី ទណ្ឌកម្ម ផ្លូវ ច្បាប់ ។
លោក បាន បន្ត ថា « ក្រមសីលធម៌ មាន សារសំខាន់ វា មិន មែន មាន លក្ខណៈ បង្ខំ ត្រូវ មាន ទោស ឬ ឧក្រិដ្ឋកម្ម បទល្មើស ទេ ប៉ុន្តែ ក្រមសីលធម៌ ដូចជា ខ្យល់ នៅក្នុង បាឡុង ទី១ រក្សា តម្លៃ ថ្លៃថ្នូរ របស់ យើង អ្នកកាសែត ដែល បង្ហាញ ថា យើង មាន វិជ្ជាជីវៈ ត្រឹមត្រូវ ពិតប្រាកដ យើង បាន ឆ្លងកាត់ ការរៀនសូត្រ ទី២ វា បាន បង្ហាញ ពី ការផ្តល់ តម្លៃ ទៅ លើ មនុស្ស នៅក្នុង សង្គម ទាំងអស់ គ្នា » ។
សូម បញ្ជាក់ ថា អ្នកសារព័ត៌មាន ទាំងឡាយ ណា ដែល សរសេរ ព័ត៌មាន ដោយ គោរព តាម ក្រមសីលធម៌ វិជ្ជាជីវៈ ប៉ុន្តែ ពេល ផ្សព្វផ្សាយ ចេញ ទៅ ត្រូវ គេ ប្តឹង ទៅ វិញ នោះ នឹង ទទួលបាន សិទ្ធិ ការពារ ក្តី ពី ក្រុម មេធាវី ស្ម័គ្រចិត្ត របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន មាន តួនាទី ទទួលខុសត្រូវ បញ្ហា ការពារ ក្តី ដល់ អ្នកសារព័ត៌មាន ដែល ធ្វើ ការគោរព តាម ក្រមសីលធម៌ វិជ្ជាជីវៈ ទាំងនោះ ។
ជាមួយ នេះ ដែរ លោក អ៊ឹង គឹម លាង អភិបាល រង ខេត្ត សៀមរាប បាន លើកឡើង ថា សារព័ត៌មាន គឺជា កញ្ចក់ ឆ្លុះបញ្ចាំង សង្គម តែ សារព័ត៌មាន មួយចំនួន ក៏ បាន ធ្វើ ការបំពុល សង្គម ផងដែរ ។ លោក បាន បន្ត ទៀត ថា សិក្ខាសាលា នេះ គឺ បាន បង្ក លក្ខណៈ ដល់ ប អ្នកសារព័ត៌មាន បាន ស្វែងយល់ អំពី តួនាទី ភារកិច្ច និង សីលធម៌ វិជ្ជាជីវៈ របស់ អ្នកសារព័ត៌មាន ក្នុង ការបញ្ជៀស រាល់ កំហុសឆ្គង ក្នុង ការសរសេរ ព័ត៌មាន ដើមី្ប ធ្វើ ការផ្សព្វផ្សាយ ជាសាធារណៈ នៅក្នុង សង្គម ផងដែរ ៕
រដ្ឋបាល ស្រុក ឆ្លូង ដឹកនាំ មន្រ្តី យុវជន និង កងកម្លាំង សម្អាត អនាម័យ បរិស្ថាន តាម ផ្លូវ ចូលរួម ទទួលស្វាគមន៍ ក្បួន ដង្ហែ ព្រះអគ្គិជ័យ កីឡា
( ក្រចេះ ) ៖ រដ្ឋបាល ស្រុក ឆ្លូង ដឹកនាំ ដោយ លោក ធីម ស៊ាង ឡេង អភិបាល រង ស្រុក នៅ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ បាន ដឹកនាំ មន្រ្តី ក្រោម ឱវាទ ចុះ សម្លាត អនាម័យ បរិស្ថាន តាម ដងផ្លូវ ពី គល់ ស្ពាន ឆ្លូង ដល់ គល់ ស្ពាន កំពង់រាំង ព្រំប្រទល់ ខេត្ត ក្រចេះ និង ខេត្ត ត្បូងឃ្មុំ ។
លោក ធីម ស៊ាង ឡេង បាន ឲ្យដឹង ថា ដោយ មាន ការចង្អុលបង្ហាញ ពី លោកស្រី អភិបាល ស្រុក លោក បាន ដឹកនាំ មន្រ្តី រាជកា នៃ រដ្ឋបាល ស្រុក យុវជន គណបក្ស ប្រជាជន កម្ពុជា យុវជន កាកបាទ ក្រហម យុវជន សសកយ និង កម្លាំង ទាំង៣ ប្រភេទ ចុះ សម្អាត អនាម័យ បរិស្ថាន តាម ដងផ្លូវ ក្នុង ស្រុក ឆ្លូង ដើម្បី ចូលរួម ពិធី ទទួលស្វាគមន៍ ក្បួន ដង្ហែ ព្រះអគ្គិជ័យ កីឡា នៃ ព្រឹត្តការណ៍ កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ដែល ត្រូវ ធ្វើដំណើរ ឆ្លងកាត់ ស្រុក ឆ្លូង នៅ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
លោក បញ្ជាក់ ថា ការចូលរួម សម្អាត បរិស្ថាន បែប នេះ ធ្វើឡើង ស្រប ពេល ដែល ប្រទេស កម្ពុជា កំពុង ធ្វើ ម្ចាស់ ផ្ទះ នៃ ព្រឹត្តិការណ៍ កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ឆ្នាំ ២០២៣ នេះ ដើម្បី ជា ការលើក មុខ មាត់ ប្រទេសជាតិ ហើយ នៅ តាម បណ្ដា គ្រប់ ខេត្ត ក្រុង ទាំងអស់ បាន នាំគ្នា សម្អាត បរិស្ថាន គ្រប់ ទីកន្លែង ។ ការសម្អាត បរិស្ថាន មិន ត្រឹមតែ នាំឲ្យ ទីកន្លែង មាន សោភ័ណភាព ស្រស់ស្អាត នោះ ទេ ក៏ នាំឲ្យ មាន ខ្យល់ ឱកាស ល្អ ផ្ដល់ សុខភាព សាធារណជន ដែល បាន មក លេង កម្សាន្ដ ផងដែរ ។
ដើម្បី ចូលរួម សម្អាត បរិស្ថាន ឲ្យបាន ស្អាត ល្អ ក្នុង នាម លោក តំណាង ឲ្យ អាជ្ញាធរ ស្រុក សូម អំពាវនាវ បងប្អូន ប្រជាពលរដ្ឋ មេត្តា ចូលរួម សម្អាត បរិស្ថាន ទីធ្លា នានា ៗ ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី លើក មុខមាត់ ប្រទេសជាតិ យើង ៕ វេទិកា ការងារ នៅ ខេត្ត ព្រះសីហនុ ចាប់ផ្តើម ហើយ នា ថ្ងៃ នេះ ដោយ ផ្តល់ ឱកាស ការងារ ១ ពាន់ កន្លែង ដល់ យុវជន
យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ តម្លៃ មាន នៅលើ ទីផ្សារ ពិភពលោក បាន ធ្លាក់ចុះ ថ្លៃ កាលពី ថ្ងៃចន្ទ ក្នុង ការជួញដូរ ពីរ វគ្គ ជាប់ ៗ គ្នា នៅក្នុង ទីផ្សារ ខណៈ ដែល ការផ្តោត អារម្មណ៍ របស់ វិនិយោគិន បាន ប្តូរ ទៅ រក កិច្ចប្រជុំ របស់ ធនាគារ កណ្តាល នានា ស្តីពី យុទ្ធសាស្រ្ត ដំឡើង អត្រា ការប្រាក់ របស់ ពួកគេ ដែល អាច បង្ហាញ ឱ្យ ឃើញ ច្បាស់ ថា តើ មាន វឌ្ឍនភាព ដែរ ឬ យ៉ាងណា ក្នុង យុទ្ធនាការ ទប់ទល់ អតិផរណា ។
ខណៈ ដែល ចំនួន ប្រជាជន ឥណ្ឌា រំពឹង ថា នឹង កើនឡើង ក្នុង រយៈពេល ប៉ុន្មាន ទសវត្សរ៍ នេះ ចំនួន ប្រជាជន របស់ ប្រទេស ចិន បាន ចាប់ផ្តើម ធ្លាក់ចុះ នា ពេល ថ្មី ៗ នេះ ។ ចំនួន ប្រជាជន បាន ធ្លាក់ចុះ ជា លើក ដំបូង ចាប់តាំងពី ទសវត្សរ៍ ឆ្នាំ ១៩៦០មក បន្ទាប់ពី ធ្លាក់ចុះ ការផ្តល់ កំណើត រយៈពេល ប្រាំមួយ ឆ្នាំ ជាប់ គ្នា ។ ក្នុង រយៈពេល បី ឆ្នាំ ចុងក្រោយ នេះ ចំនួន ប្រជាជន ធ្វើការ របស់ ចិន បាន ធ្លាក់ចុះ ជាង ៤១លាន នាក់ ឬ ស្មើនឹង ទំហំ កម្លាំង ពលកម្ម សរុប របស់ ប្រទេស អាល្លឺម៉ង់ ។
ល្បឿន នៃ ការកើនឡើង ប្រជាជន វ័យ ចំណាស់ ត្រូវបាន រំពឹង ថា នឹង មាន យឺត ជាង នៅក្នុង ប្រទេស ឥណ្ឌា ។ បច្ចុប្បន្ន នេះ ប្រជាជាតិ អាស៊ី ខាងត្បូង មួយ នេះ ជា ប្រទេស មួយ ក្នុង ចំណោម ប្រទេស ដែល មាន ប្រជាជន វ័យ ក្មេង ជាង គេ បំផុត ពោលគឺ ជាង ពាក់កណ្តាល នៃ ប្រជាជន របស់ ខ្លួន មាន អាយុ ក្រោម ៣០ ឆ្នាំ និង មាន អាយុ ជា មធ្យម ២៨ ឆ្នាំ ។
របាយការណ៍ របស់ អង្គការ សហ ប្រជាជាតិ បាន ឱ្យដឹង ថា៖ « ប្រទេស ទាំង ពីរ គួរតែ ប្តេជ្ញា ចំពោះ ការការពារ សង្គម និង វិធានការ ផ្សេង ទៀត ដើម្បី ធានា សុខភាព និង សុខុមាលភាព របស់ មនុស្ស វ័យ ចំណាស់ ដែល កើនឡើង នេះ » ។
ប្រទេស ទាំង ពីរ រួមគ្នា មាន ប្រជាជន ច្រើន ជាង មួយ ភាគ បី នៃ ចំនួន ប្រជាជន ពិភពលោក ។ ការផ្លាស់ប្តូរ ប្រជាសាស្រ្ត នេះ នឹង មិន ត្រឹមតែ បង្ក បញ្ហា ប្រឈម ផ្នែក សេដ្ឋកិច្ច និង សង្គម សំខាន់ ៗ សម្រាប់ ប្រទេស ទាំង ពីរ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ក៏ នឹង ប៉ះពាល់ ដល់ របៀប ដែល ពិភពលោក សម្រេចបាន នូវ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព របស់ ខ្លួន ផងដែរ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន Bloomberg ៕
ស្អែក នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នឹង ធ្វើ សន្និសីទ សារព័ត៌មាន « ភាពជោគជ័យ រយៈពេល ៥ឆ្នាំ កន្លងមក របស់ រដ្ឋបាល ខេត្ត ស្វាយរៀង »
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២៣ ស្អែក នេះ នឹង រៀបចំ សន្និសីទ សារព័ត៌មាន ស្ដីពី « ភាពជោគជ័យ រយៈពេល ៥ឆ្នាំ កន្លងមក របស់ រដ្ឋបាល ខេត្ត ស្វាយរៀង » នៅ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី សាល សេរីភាព ជាន់ ផ្ទាល់ ដី ។
សន្និសីទ សារព័ត៌មាន នេះ មាន គោលដៅ បំផុស និង បង្ហាញ ជាសាធារណៈ នូវ យន្ដ ការអភិវឌ្ឍ តាម បែប ប្រជាធិបតេយ្យ នៅ ថ្នាក់ ក្រោម ជាតិ និង ផ្សព្វផ្សាយ ពី ភាពជោគជ័យ ដែល ថ្នាក់ មូលដ្ឋាន ខិតខំ ប្រឹងប្រែង អនុវត្ត និង សម្រេចបាន សមិទ្ធផល ជា វិជ្ជមាន ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
វា គ្មិន ដែល ចូលរួម ក្នុង សន្និសីទ សារព័ត៌មាន នេះ គឺ តំណាង របស់ រដ្ឋបាល ខេត្ដ ស្វាយរៀង ៕ ក្រសួង សុខាភិបាល កែសម្រួល ទីតាំង ថ្មី សម្រាប់ ផ្ដល់ សេវា សុខភាព ក្នុង ព្រឹត្ដិការណ៍ ស៊ីហ្គេម (Video inside) ( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល បាន បង្ហាញ ទីតាំង រថយន្ត គិលាន សង្រ្គោះ និង រថយន្ត គ្លីនិក ចល័ត ដែល បាន កែសម្រួល ថ្មី តាម ទីតាំង ប្រចាំ ការតាម គោលដៅ កំណត់ ក្នុង ពិធី ប្រកួត កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ ឆ្នាំ ២០២៣ នេះ ។
តាម ប្រសាសន៍ របស់ លោក សាស្រ្ដាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល អំឡុង ចុះ ទៅ ពិនិត្យ ទីតាំង ផ្ដល់ សេវា សុខភាព និង សង្គ្រោះ បន្ទាន់ នៅ ទីតាំង ពហុកីឡដ្ឋាន ជាតិ មរតក តេជោ កាលពី ដើម សប្ដាហ៍ នេះ បាន ឱ្យដឹង ថា ទីតាំង ទាំង ២២ នេះ គឺ បាន តៀម រៀបចំ ក្រុម គ្រូពេទ្យ និង សម្ភារ បរិក្ខារ ជាស្រេច ដើម្បី ផ្ដល់ សេវា សុខភាព ជូន កីឡាករ កីឡាការិនី ទាំងអស់ រួមទាំង អ្នក មក ចូល ទស្សនា ផងដែរ ។
( កណ្ដាល ) ៖ រាជ រដ្ឋាភិបាល តាម រយ : ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន សម្រេច ផ្ដល់ សំណង ដល់ ពលរដ្ឋ ចំនួន ៧១ គ្រួសារ ស្មើនឹង ៦៥ ផ្ទះ ដែល បាន រុះរើ ក្រោយ ហេតុការណ៍ គ្រោះ ធម្មជាតិ ជំនន់ ទឹកភ្លៀង បាន វាយប្រហារ បណ្ដាលឲ្យ បាក់ ដី ធ្លាក់ ផ្ទះ ចូល ព្រែក ថី ស្ថិត នៅ សង្កាត់ រការ ខ្ពស់ ក្រុង តាខ្មៅ នា ពេល កន្លងទៅ នេះ ។
នៅ ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ ក្រុមគ្រួសារ ដែល រងគ្រោះ សរុប ៦៥ ផ្ទះ ស្មើនឹង ៧១ គ្រួសារ បាន មក បើក កញ្ចប់ ថវិកា នៅ សាលា សង្កាត់ រការ ខ្ពស់ ដោយ គ្រួសារ ខ្លះ បើក បាន ច្រើន ខ្លះ បើក បាន តិច អាស្រ័យ លើ ទំហំ ផ្ទះ និង ស្ថានភាព ផ្ទះ របស់ ពួកគាត់ ជាមួយ លិខិតស្នាម ត្រឹមត្រូវ ដែល វាស់វែង ដោយ មន្ត្រី ជំនាញ ។
ក្រុម ប្រជាពលរដ្ឋ ដែល មក ទទួលយក ថវិកា សំណង នេះ បាន សំដែង ពី ភាពសប្បាយរីករាយ ឥត ឧបមា និង ថ្លែងអំណរគុណ ប្រមុខ រាជ រដ្ឋាភិបាល សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន យកចិត្តទុកដាក់ ជួយ គិតគូរ និង សង្រ្គោះ ពលរដ្ឋ ដែល ជួប បញ្ហា លំបាក លំបិន និង ប្ដេជ្ញា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា នា ពេល ខាងមុខ នេះ ។
ពួកគាត់ ស្នើរ សុំ សម្ដេច តេជោ មេត្តា ជួយ ពិនិត្យមើល ចំណុច មិន ប្រក្រតី បន្តិច ចំពោះ តម្លៃ នៃ សំណង ក្រោយ សំណង់ ពួកគាត់ មាន ការផ្ដល់ សំណង មិន ស្មើភាព ដោយ ក្នុង មួយ ការ៉េ ខ្លះ បាន ជាង ១៤០ ដុល្លារ . ខ្លះ បាន ជាង ១៦០ ដុល្លារ . ខ្លះ បាន ជាង ១៩០ ដុល្លារ ជាដើម ដែល ពួកគាត់ ហាក់ មិន ទាន់ អស់ចិត្ត ឡើយ ក្រោយ សំណង់ ប្រភេទ ថ្ម ដូចគ្នា និង សាសង សង់ ជិត ៗ គ្នា តែ បែរជា ទទួលបាន សំណង ខុសគ្នា ។
សូម ជម្រាប ថា ជំនន់ ទឹកភ្លៀង បាន ហូរ បុក ខ្លាំង ពី ខេត្ត កំពង់ស្ពឺ ហូរ បុក តាម ព្រែក ថី ចូល ទន្លេ បាសាក់ យ៉ាង គំហុក បណ្ដាលឲ្យ ផ្ទះ ប្រជាពលរដ្ឋ បាក់ ចូល ព្រែក ជា បន្តបន្ទាប់ កាលពី ថ្ងៃទី ១៦ ខែមករា ឆ្នាំ ២០២៣ កន្លងទៅ ។
អាជ្ញាធរ ខេត្ត សម្រេចចិត្ត រុះរើ ចេញ ទាំងអស់ ការពារ ហានិភ័យ ផ្សេង ៗ ទៀត កើតឡើង ដោយ កម្លាំង រុះរើ ផ្ទះ យក ពី ទ័ព ចំនួន ៣ស្ថាប័ណ សរុប ៦០០ នាក់ រុះរើ ផ្ទះ ៦៥ ខ្នង ស្មើនឹង ៧១ គ្រួសារ មាន ផ្ទះ ថ្ម ផ្ទះ ឈើ ផ្ទះ ស័ង្កសី ជាដើម ។
ពលរដ្ឋ ទាំងអស់ នោះ ទទួលបាន ការយកចិត្ត ជួយ ខ្នះ ខ្នែង ទំនុកបម្រុង ផ្គត់ផ្គង់ កន្លែង ស្នាក់ នៅ បណ្ដោះអាសន្ត អាហារ ហូក ចុក សម្ភារ មួយចំនួន ពី អាជ្ញាធរ ខេត្ត កណ្ដាល ដឹកនាំ ដោយ លោក គង់ សោភ័ណ្ឌ ជា អភិបាល ខេត្ត ។ ពួកគាត់ ក៏ នឹង ទទួលបាន ដីឡូត៍ ផងដែរ នៅ ចំណុច បឹង ទទា តូច ខណ : អាជ្ញាធរ កំពុង រៀបចំ ជូន ពួកគាត់ ។
បាន សេចក្ដី ថា ក្រោម ការចង្អុលបង្ហាញ និង ក្ដី មេត្តា ពីសំណាក់ សម្ដេច តេជោ ពលរដ្ឋ ដែរ រងគ្រោះ ទាំងនោះ ទទួលបាន ទាំង ថវិកា សំណង អចលទ្រព្យ ផង និង ដីឡូត៍ ថែម ទៀត ផង ។ នេះ ជា ទឹកចិត្ត ដ៏ ធំធេង របស់ សម្ដេច តេជោ ដែល ប្រជាពលរដ្ឋ រងគ្រោះ ទាំងនោះ មិន អាច បំភ្លេច បាន ៕
អភិបាល រង ក្រុង បូក គោ ដែល ប្រើ អំពើហិង្សា លើ ប្រពន្ធ នឹង ត្រូវ បញ្ជូន ទៅ តុលាការ ចាត់ការ តាម ច្បាប់
( កំពត ) ៖ អភិបាល រង ក្រុង បូក គោ ឈ្មោះ គឹម បញ្ញា ដែល ប្រើប្រាស់ អំពើហិង្សា លើ ប្រពន្ធ របស់ ខ្លួន នឹង ត្រូវ បញ្ជូន ទៅ សាលាដំបូង ខេត្ត កំពត នៅ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២៣ ស្អែក នេះ ដើម្បី ចាត់ការ តាម នីតិវិធី ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ រសៀល ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ បាន បញ្ជាក់ ថា ក្រោយ បញ្ចប់ ការសួរនាំ អធិការដ្ឋាន នគរបាល ក្រុង កំពត នឹង បញ្ជូន ខ្លួន ឈ្មោះ គឹម បញ្ញា ដែល មាន តួនាទី ជា អភិបាល រង ក្រុង បូក គោ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី អំពើហិង្សា លើ ប្រពន្ធ កន្លងមក ។
សូម រំលឹក ថា លោក គឹម បញ្ញា អភិបាល រង ក្រុង បូក គោ ម្នាក់ ត្រូវបាន កោះហៅ ឲ្យ ចូល បំភ្លឺ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពត ពាក់ព័ន្ធ ករណី ប្រើប្រាស់ អំពើហិង្សា លើ ប្រពន្ធ របស់ ខ្លួន ។ ស្នងការ នគរបាល ខេត្ត កំពត លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា សមត្ថកិច្ច ជំនាញ បាន កោះហៅ លោក គឹម បញ្ញា ពាក់ព័ន្ធ ករណី ប្រើប្រាស់ អំពើហិង្សា លើ ប្រពន្ធ ។
ក្រោយ ការកោះហៅ លោក គឹម បញ្ញា បាន ស្ម័គ្រចិត្ត ចូល ខ្លួន ទៅ បំភ្លឺ នៅ ចំពោះមុខ សមត្ថកិច្ច នៅ អធិការដ្ឋាន នគរបាល ក្រុង កំពត ពាក់ព័ន្ធ ទង្វើ ដែល ខ្លួន បាន ប្រព្រឹត្ត កន្លងមក ទៅ លើ ប្រពន្ធ ។
អំលុង ទស្សនកិច្ច ផ្លូវ រដ្ឋមកកាន់ ទីក្រុង មូស្គូ កាលពី ខែមីនា ប្រធានាធិបតី ចិន លោក ស៉ី ជិន ពីង បាន ប្រាប់ លោក ពូទីន ថា រូប លោក ជឿ ថា ប្រជាជន រុស្ស៉ី នឹង បន្ត គាំទ្រ លោក ពូទីន ជាថ្មី ម្តង ទៀត ក្នុង ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី រុស្ស៉ី ដែល ត្រូវ ធ្វើឡើង នៅ ឆ្នាំ ២០២៤ ។ យ៉ាងណាមិញ លោក ពូទីន ផ្ទាល់ មិន ទាន់ បាន និយាយ នៅឡើយ ទេ ថា តើ លោក នឹង ស្វែងរក ការកាន់អំណាច បន្ត ទៀត ឬ យ៉ាងណា ។
សម្តេច តេជោ អំពាវនាវ អ្នក ចូល ទស្សនា ការប្រកួត ស៊ីហ្គេម រក្សា សណ្តាប់ធ្នាប់ ដើម្បី បញ្ចៀស ហានិភ័យ នានា (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា អំពាវនាវ ប្រជាពលរដ្ឋ ដែល ចូលរួម ទស្សនា ការប្រកួត នានា ក្នុង ព្រឹត្តិការណ៍ ប្រកួត ស៊ីហ្គេម ត្រូវ រក្សា សណ្តាប់ធ្នាប់ និង របៀបរៀបរយ ដើម្បី បញ្ចៀស ហានិភ័យ នានា ។
សម្តេច តេជោ បាន អំពាវនាវ បែប នេះ ក្នុង ជំនួប សំណេះសំណាល ជាមួយ គណៈ ចលនា សាសនិក ឥស្លាម គ្រប់ ថ្នាក់ របស់ គណបក្ស ប្រជាជន កម្ពុជា សរុប ៣. ៥៤០ នាក់ នា ព្រឹក ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នៅ វិមាន ៧មករា ។
ក្រៅតែ ពី ការអំពាវនាវ បែប នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន ណែនាំ បន្ថែម ដល់ អភិបាល រាជធានី - ខេត្ត រៀបចំ ដាក់ ផ្ទាំង ស្លាយ ឱ្យ ប្រជាពលរដ្ឋ បាន ទស្សនា ការ ផ្សាយ ផ្ទាល់ នូវ ព្រឹត្តិការណ៍ នៃ ការប្រកួត នានា ។
សូម បញ្ជាក់ ថា នៅសល់ រយៈពេល តែ ៩ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ព្រឹត្តិការណ៍ ប្រកួត ស៊ីហ្គេម លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ នឹង ឈាន មកដល់ ហើយ ។ នេះ គឺជា ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ ថ្មី មួយ ទៀត សម្រាប់ កម្ពុជា ។ កម្ពុជា បាន ខកខាន និង រង់ចាំ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ ការប្រកួត កីឡា តំបន់ អាស៊ី អាគ្នេយ៍ មួយ នេះ អស់ រយៈពេល ៦៤ ឆ្នាំ មកហើយ ។
បើ ទោះបី កម្ពុជា ទើប ធ្វើជា ម្ចាស់ ផ្ទះ នៃ ការប្រកួត លើក ដំបូង តែ កម្ពុជា បាន បង្កើត ឱ្យ មាន ការចាប់អារម្មណ៍ ជា ប្រវត្តិសាស្ត្រ នៃ ការប្រកួត ស៊ីហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម នេះ ផងដែរ ។ រឿង ជាប្រវត្តិសាស្ត្រ នោះ គឺ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន បាន អនុញ្ញាតឱ្យ ការទស្សនា ការផ្សាយ ផ្ទាល់ និង ការចូលរួម ប្រកួត របស់ គណៈប្រតិភូ កីឡា នៃ ប្រទេស ជា សមាជិក កីឡា នេះ មិន បង់លុយ នោះ ឡើយ ៕
ការប្រើប្រាស់ បច្ចេកវិទ្យា ក្នុង ប្រតិបត្តិការ រាវ រក គ្រាប់ មីន និង យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ បាន ចូលរួម ជា ផ្នែក មួយ យ៉ាង សំខាន់ ឈានទៅ សម្រេច នូវ ទស្សនវិស័យ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី កម្ពុជា គ្មាន មីន ឆ្នាំ ២០២៥
ក្នុង ពិធី បើក សិក្ខាសាលា ថ្នាក់ តំបន់ នេះ ទេសរដ្ឋមន្រ្តី លី ធុជ បាន លើកឡើង អំពី សមិទ្ធផល សម្រេចបាន ជា ប្រវត្តិសាស្រ្ត សម្រាប់ វិស័យ សកម្មភាព មីន នៅ កម្ពុជា រយៈពេល ជាង ៣០ ឆ្នាំ ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ព្រមទាំង បាន ដាក់ចេញ នូវ គោលដៅ ច្បាស់លាស់ ក្នុង ការដោះស្រាយ បញ្ហា មីន ឲ្យ អស់ ក្នុង ឆ្នាំ ២០២៥ ។
ការប្រើប្រាស់ ឧបករណ៍ បច្ចេកវិទ្យា ទំនើប ក្នុង ប្រតិបត្តិការ រាវ រក គ្រាប់ មីន និង យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង វឌ្ឍនភាព នេះ និង បាន ចូលរួម ជា ផ្នែក មួយ ចាំបាច់ ឈានទៅ សម្រេច នូវ ទស្សនវិស័យ របស់ សម្តេច តេជោ ។ ជាមួយគ្នា នេះ ការធ្វើ ការរួមគ្នា និង ការប្រើប្រាស់ ភាពជឿនលឿន នៃ បច្ចេកវិទ្យា ចុងក្រោយ ក៏ នឹង អាច ជួយ ពន្លឿន ដល់ វឌ្ឍនភាព ឆ្ពោះទៅ សម្រេច គោលដៅ និង អនាគត ដែល គ្មាន ការគំរាមកំហែង ពី គ្រាប់ មីន និង យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ ឲ្យ កាន់តែ ឆាប់ ។
ជាង នេះ ទៅ ទៀត ទេសរដ្ឋមន្រ្តី បាន ចាត់ទុក ក្រុមហ៊ុន Vallon GmbH គឺជា ដៃគូ ដ៏ ចាំបាច់ មួយ ក្នុង កិច្ច ប្រតិបត្តិការ បោសសម្អាត មីន នៅ កម្ពុជា ហើយ ក្រុមហ៊ុន Vallon គឹជា ក្រុមហ៊ុន ឈាន មុខ គេ នៅលើ ពិភពលោក ក្នុង ការផលិត និង ការអភិវឌ្ឍ បច្ចេកវិទ្យា ទំនើប កម្រិត ខ្ពស់ ក្នុង ប្រតិបត្តិការ រាវ រក គ្រាប់ មីន និង យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ សម្រាប់ គោលបំណង មនុស្សធម៌ ។
លោក Markus Vallon បាន បន្ត ទៀត ថា ក្រុមហ៊ុន VALLON GmbH បាន ផលិត នូវ ឧបករណ៍ រាវ រក គ្រាប់ មីន ជាច្រើន ប្រភេទ ប្រកបដោយ ប្រសិទ្ធភាព និង សុវត្ថិភាព ខ្ពស់ ព្រមទាំង បាន ទទួលបាន ការកែលម្អ ជាច្រើន ពី កម្ពុជា ក្នុង ការធ្វើ ទំនើបកម្ម បច្ចេកវិទ្យា ឲ្យ កាន់តែ ប្រសើរឡើង ហើយ បច្ចុប្បន្ន ក្រុមហ៊ុន បាន ដាក់បញ្ចូល ភាសា ខ្មែរ ក្នុង ឧបករណ៍ នេះ ដើម្បី ផ្តល់ ភាពកាន់តែ ងាយស្រួល ដល់ អ្នកដោះ មីន កម្ពុជា ក្នុង ការប្រើប្រាស់ ៕
ក្នុង កិច្ច សំណេះសំណាល នោះ លោក អូស្មាន ហាហ្សាន់ ប្រធាន គណៈ ចលនា សាសនិក ឥស្លាម របស់ គណបក្ស ប្រជាជន កម្ពុជា បាន លើកឡើង ពី ប្រវត្តិ នៃ ការបង្កើត គណៈកម្មការ គណៈ ចលនា សាសនិក ឥស្លាម របស់ គណបក្ស ប្រជាជន កម្ពុជា ។ ក្នុង ឆ្នាំ ១៩៩៨ គណៈ ចលនា នេះ ត្រូវបាន បង្កើតឡើង ដោយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ។
លោក បាន បន្ត ថា គណៈ ចលនា សាសនិក ឥស្លាម បាន អនុវត្ត បាន យ៉ាង ខ្ជាប់ខ្ជួន នូវ អនុសាសន៍ ដឹកនាំ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ សម្តេច តេជោ ប្រធាន គណបក្ស ហើយ ជា លទ្ធផល នៅ គ្រប់ អាណត្តិ នៃ ការបោះឆ្នោត ទាំង បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ និង បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ កត់សម្គាល់ ឃើញ ថា ខ្មែរ ឥស្លាម បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា មាន ភាគរយ ខ្ពស់ ។
សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន បង្ហាញ នូវ ក្តីរីករាយ ក្នុង ជំនួប ជាមួយ បងប្អូន ខ្មែរ - ឥស្លាម ជាង ៣ពាន់ នាក់ នា ថ្ងៃ នេះ ។ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន មានប្រសាសន៍ អបអរសាទរ ចំពោះ ការបញ្ចប់ ដោយ ជោគជ័យ នៃ ខែរ៉ាម៉ាដន របស់ បងប្អូន ខ្មែ - ឥស្លាម កន្លងទៅ ថ្មី ៗ នេះ ។
សម្តេច តេជោ បាន ថ្លែង នូវ ការកោតសរសើរ ចំពោះ ការចូលរួម របស់ ខ្មែរ - ឥស្លាម ក្នុង ការអភិវឌ្ឍ របស់ ប្រទេសជាតិ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ។ សម្តេច តេជោ ក៏ បាន អរគុណ ដល់ ខ្មែរ - ឥស្លាម ដែល កន្លងមក បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន ភាគរយ ច្រើន លើសលប់ ហើយ ការបោះឆ្នោត ឱ្យ គណបក្ស ប្រជាជន កម្ពុជា នេះ គឺជា ការចូលរួម រក្សា បាន នូវ សេចក្តីសុខ និង សុខ សន្តិភាព របស់ ជាតិ យើង ទាំងមូល ។
សម្តេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ ថ្លែង ថា ដោយ ក្តី មោទនភាព ចំពោះ ភាពជោគជ័យ នៃ ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ របស់ ប្រទេស កម្ពុជា ។ សម្តេច បន្ត ថា វិធានការ នៃ ការចាក់ ស្រោច វ៉ាក់សាំង គឺជា កត្តា សំខាន់ បំផុត ក្នុង ការទប់ស្កាត់ ប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ រួម ជាមួយ ការចូលរួម សហការ របស់ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ។ ជាពិសេស សម្តេច តេជោ ក៏ បាន អរគុណ ដល់ ប្រទេស ដៃគូរ ទាំងអស់ ដែល បាន ផ្តល់ វ៉ាក់សាំង មក កម្ពុជា ជាពិសេស ប្រទេស ចិន ដែល ផ្តល់ ច្រើន ជាង គេ ទាំង ការផ្តល់ ជំនួយ និង ការបញ្ជាទិញ របស់ កម្ពុជា ។
សម្តេច តេជោ បាន មានប្រសាសន៍ បន្ត ទៀត ថា ការយកឈ្នះ លើ កូវីដ១៩ គឺ បាន ផ្តល់ ឱកាស ឱ្យ គ្រប់ គ្នា បាន ជួបជុំគ្នា ឡើងវិញ ជាពិសេស ក្នុង ពិធី ស្រាយ បួស កន្លងទៅ នេះ បាន ជួបជុំគ្នា រហូតដល់ ជាង ៦ ពាន់ នាក់ ហើយក៏ អនុញ្ញាតឱ្យ បើក ដំណើរការ ប្រទេសជាតិ ជា ប្រក្រតី ភាព ឡើងវិញ ផងដែរ ។
សម្តេច តេជោ ប្រមុខ បក្ស កាន់អំណាច បាន បាន មានប្រសាសន៍ ផងដែរ ពី ការងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច កម្ពុជា ក្រោយ វិបត្តិ កូវីដ១៩ ក្នុង នោះ ទាំង វិស័យ ទេសចរណ៍ សេវាកម្ម ជាដើម ចាប់ផ្តើម ងើប ឡើងវិញ ហើយ ។
សម្តេច តេជោ បាន លើកឡើង ដែរ ថា កម្ពុជា នឹង ក្លាយ អធិរាជ ស្វាយចន្ទី នា ពេល ខាងមុខ ហើយ រាជ រដ្ឋាភិបាល កំពុង ជំរុញ ក្នុង ការនាំចេញ ស្វាយចន្ទី ឱ្យ បាន ច្រើន នា ពេល ខាងមុខ ផងដែរ ។
សម្តេច តេជោ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល ទៅ មើល ផ្ទាល់ សូម រក្សា សណ្តាប់ធ្នាប់ របៀបរៀបរយ ជៀសវាង ការប្រជ្រៀត គ្នា ដែល បង្កឱ្យ បាត់ សណ្ដាប់ធ្នាប់ និង ប្រឈម នូវ ហានិភ័យ ផ្សេង ៗ ។
សម្តេច តេជោ នាយក យក រដ្ឋមន្ត្រី នៅតែ បន្ត អំពាវនាវ ប្រជាពលរដ្ឋ ចូលរួម ថែរក្សា សន្តិភាព ឱ្យ បាន គង់ វង់ បន្ត ទៀត មាន សន្តិភាព ទើប មាន ការអភិវឌ្ឍ ។ ជាមួយគ្នា នោះ សម្តេច តេជោ ក៏ សុំ ឱ្យ ចូលរួម រក្សា ស្ថិរភាព ម៉ាក្រូ សេដ្ឋកិច្ច និង ត្រូវ ចូលរួម ទប់ស្កាត់ អតិផណា អោយ បាន ។ គ្រប់ ស្ថាប័ន ទាំងអស់ ត្រូវ ចេះ សន្សំ សំចៃ ក្នុង ការចំណាយ ផ្សេង ៗ និង ត្រូវ ចូលរួម លុបបំបាត់ ការរកស៊ី គេច ពន្ធ ព្រមទាំង ត្រូវ ខិតខំ រក ចំណូល សម្រាប់ ជាតិ ឲ្យបាន ច្រើន ។
សម្តេច តេជោ ក៏ អំពាវនាវ ឱ្យ មាន ការចូលរួម រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម បន្ត ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព អោយ បាន ខ្ចាប់ខ្ជួន ដូចជា ទប់ស្កាត់ ការការជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន ទប់ស្កាត់ ល្បែងស៊ីសង គ្រប់ ប្រភេទ និង រួមគ្នា ទប់ស្កាត់ បញ្ហា គ្រោះថ្នាក់ ចរាចរណ៍ ទាំងអស់ គ្នា ៕
( កំពង់ស្ពឺ ) ៖ កាលពី ព្រលប់ ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៣ នៅលើ ផ្លូវ ជាតិ លេខ ៤ ចន្លោះ គីទ្បូម៉ែត្រ លេខ ៤៦ - ៤៧ ត្រង់ ចំណុច មុខ មន្ទីរ សារធារណការ និង ដឹកជញ្ជូន ខេត្ត កំពង់ស្ពឺ សង្កាត់ រការ ធំ ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ មាន ករណី គ្រោះថ្នាក់ ដោយ ខ្សល់ កន្ត្រាក់ បោក ផ្លាក ប៉ាណូ ទទឹង ផ្លូវ រលំ សង្កត់ លើ រថយន្ត ០១ គ្រឿង តែ មិន បណ្តាលឲ្យ មាន អ្នក រងរបួស ទេ ។
ក្រោយ កើត ហេតុ ភ្លាម ៗ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ដឹកនាំ ផ្ទាល់ ចុះ ពិនិត្យ ការខូចខាត និង រៀបចំ បញ្ជៀស ចរាចរណ៍ បន្ទាន់ ចៀសវាង ការកកស្ទះ ចរាចរណ៍ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៤។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត ក៏ បាន ក្រើនរលឹក ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ ឲ្យ មាន ប្រុងប្រយ័ត្ន ខ្ពស់ បើ ទោះបី រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ បាន ចេញ សេចក្តីជូនដំណឹង ចំពោះ ផ្ទាំង ប៉ាណូ ចាស់ ៗ ឬ ហួស សុពលភាព ត្រូវ រុះរើ ចេញ ក៏ដោយ ៕
សាលា ពុទ្ធិក បឋមសិក្សា ១ខ្នង កម្ពស់ ២ជាន់ នៅ វត្ត ទេព និមិត្ត ក្នុង ក្រុង ស្ទឹង សែន បាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ
អភិបាល ខេត្ត កំពង់ធំ បាន ថ្លែង ថា តែ ទោះជា យ៉ាង នេះ ក្តី វត្ត អារាម នៅតែ ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង វិស័យ អប់រំ ដោយ វត្ត ខ្លះ បាន សាងសង់ សាលា ពុទ្ធិក សិក្សា សម្រាប់ បង្ហាត់ បង្រៀន ព្រះសង្ឃ ផង និង បង្ហាត់ បង្រៀន ក្មេង ដែល គ្មាន លទ្ធភាព សិក្សា រៀនសូត្រ នៅ សាលា ខាងក្រៅ ផង ។ ជាក់ស្តែង សាលា ពុទ្ធិក បឋមសិក្សា បាន សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ នា ពេលនេះ នឹង ក្លាយជា ទី ដ៏ មាន ប្រយោជន៍ សម្រាប់ បម្រើ ទាំង វិស័យ សាសនា និង វិស័យ អប់រំ ក្នុង ខេត្ត កំពង់ធំ ។
សូម បញ្ជាក់ ថា នៅ ឆ្នាំ ២០២០ ដល់ ឆ្នាំ ២០២២ ក សាង សាលា ពុទ្ធិក បឋមសិក្សា ១ ខ្នង កំពស់ ២ជាន់ បណ្តោយ ២០ ម៉ែត្រ និង ទទឹង ៨.៥ម៉ែត្រ ចំណាយ ថវិកា សរុប ៧៧. ១៥០ ដុល្លារ សហរដ្ឋ អាមេរិក ៕ អាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ ចាប់ និង បញ្ជូន ជនសង្ស័យ ជនជាតិ ថៃ ម្នាក់ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី ជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន
( បន្ទាយមានជ័យ )៖ នៅ វេលា ម៉ោង ៣និង ៣០នាទី ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០២៣ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ប៉ោយប៉ែត ដឹកនាំ ដោយ លោក វរសេនីយ៍ ត្រី នួន នីណារ៉ូ មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង បាន បើក ប្រតិបត្តិការ បង្ក្រាប ករណី ជួញដូរ និង ប្រើប្រាស់ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ឃាត់ខ្លួន ជនសង្ស័យ ជនជាតិ ថៃ ម្នាក់ ព្រមទាំង ចាប់ យក វត្ថុតាង គ្រឿងញៀន មួយចំនួន ធំ នៅ ចំណុច មុខ ក្លឹប MEXCLUB ស្ថិត ក្នុង ភូមិ ក្បាល ស្ពាន ១ សង្កាត់ អូរ ជ្រៅ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
ក្រោយ ឃាត់ខ្លួន និង សួរចម្លើយ ជនសង្ស័យ បាន សារភាព ថា រូប ខ្លួន ពិតជា បាន ជួញដូរ និង ប្រើប្រាស់ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ពិតប្រាកដ មែន ។ លោក វរសេនីយ៍ ឯក ជា តារា មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខេត្ត ទទួល ការងារ ប្រឆាំង គ្រឿងញៀន បាន ឱ្យដឹង ថា ការបង្ក្រាប ករណី ខាងលើ នេះ ក៏ ទទួលបាន ការអនុញ្ញាត ពី លោក ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត និង មាន ការសម្របសម្រួល នីតិវិធី ពី លោក កើត វណ្ណារ៉េត ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ផងដែរ ។
បច្ចុប្បន្ន ជនសង្ស័យ រួមទាំង វត្ថុតាង ត្រូវបាន កម្លាំង ការិយាល័យ ប្រឆាំង គ្រឿងញៀន កងរាជអាវុធហត្ថ ខេត្ត បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ហើយ នៅ ព្រឹក ថ្ងៃពុធ ទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ អនុវត្ត តាម នីតិវិធី ៕
ពលករ ខ្មែរ ១២៣ នាក់ ដោយ មាន ទាហាន ថៃ ២នាក់ នាំផ្លូវ លួច ឆ្លង ដែន ទៅ ប្រទេស ថៃ ត្រូវ សមត្ថកិច្ច ឃាត់ខ្លួន
តាម ការសាកសួ របស់ សមត្ថកិច្ច ថៃ . ទើប ដឹង ថា ពលករ ខ្មែរ ទាំងនោះ បាន ព្យាយាម ចូលទៅ ប្រទេស ថៃ ដោយ ឲ្យ មេ ខ្យល់ ថៃ នាំ ពួក ខ្លួន ចូលទៅ បាងកក ទាំង ប្រថុយប្រថាន តាម ច្រក របៀង ដើម្បី ទៅ រក ការងារ ធ្វើ នៅ ប្រទេស ថៃ ប៉ុន្តែ ក៏ ត្រូវបាន ទាហាន ថៃ ចាប់ ឃាត់ខ្លួន តែម្តង ។
ក្នុង កិច្ចប្រជុំ ជាមួយ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ នៃ បញ្ជាការដ្ឋាន អង្គរក្ស និង នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន បាន អះអាង ថា ការធានា សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ឲ្យបាន ជាដាច់ខាត នេះ គឺ ដើម្បី លើក ស្ទូយ កិត្តិយស និង កិត្យានុភាព ជាតិ កម្ពុជា ទាំងមូល ។
ក្នុង នោះ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង និង នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន ឯកភាព ទាំងស្រុង ចំពោះ ផែនការ ដែល បាន គូសបញ្ជាក់ ដោយ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន ហើយក៏ បាន លើកឡើង នូវ យោបល់ មួយចំនួន បន្ថែម ទៀត ផងដែរ ដែល នាយ ឧត្តមសេនីយ៍ ទាំង ពីរ ចាត់ទុក ថា ជា ចំណុច សំខាន់ ដើម្បី ចូលរួមចំណែក រក្សា ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ក្នុង ព្រឹត្តិការណ៍ ដ៏ ធំ ជា ប្រវត្តិសាស្ដ្រ មួយ នេះ ។
នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន បន្ទាប់ពី ទទួលយក នូវ យោបល់ បន្ថែម របស់ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង និង នាយ ឧត្តមសេនីយ៍ សៅ សុខា រួចហើយ នោះ បាន គូសបញ្ជាក់ ថា « យើង ខិតខំ ទាំងអស់ គ្នា ដើម្បី សម្រេច ភារកិច្ច ដ៏ មោទនភាពជាតិ យើង នេះ ហើយ ខ្ញុំ សង្ឃឹម ថា គណៈ បញ្ជាការប្រចាំ ការ ដើម្បី ចាត់ការគ្រប់ រឿង ហេតុ គ្រប់ ពេលវេលា » ។
យោង តាម ការគូសបញ្ជាក់ បន្ថែម របស់ លោក ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន . ក្នុង កិច្ចប្រជុំ ដ៏ មាន សារៈសំខាន់ នេះ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន ក៏ បាន ពិនិត្យ ឡើងវិញ នូវ បញ្ហា ប្រឈម ដែល កើតឡើង និង ដាក់ ចេញ វិធានការដោះស្រាយ ក្នុង នោះ គ្រប់ កងកម្លាំង ទាំងអស់ ដែល ពាក់ព័ន្ធ កិច្ចការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ សុវត្ថិភាព ត្រូវ អាទិភាព ដើម្បី ការពារ រួមទាំង តម្រាយ ផ្លូវ កន្លែង ស្នាក់ នៅ ទីកន្លែង ប្រកួត និង ត្រៀមលក្ខណៈ សម្បត្តិ ដើម្បី បង្ការ ហេតុការណ៍ ដែល កើតឡើង ដោយ ចៃដន្យ ។
លោក ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បន្ដ ទៀត ថា កិច្ចប្រជុំ ក៏ បាន ពិគ្រោះយោបល់ គ្នា យ៉ាង យកចិត្តទុកដាក់ ត្រៀម កម្លាំង អន្ដរាគមន៍ ការដាក់ បន្ថែម កម្លាំង នូវ គោលដៅ ដែល បារម្ភ ។ អង្គប្រជុំ បាន ឯកភាព គ្នា ចំពោះ គោលការណ៍ ទាំងអស់ ដោយ ត្រូវ ពង្រឹង ឲ្យបាន ជាដាច់ខាត នូវ សន្ដិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម ពិសេស រាជធានី ភ្នំពេញ ត្រូវ ទប់ស្កាត់ អំពើ ល្មើស ផ្សេង ៗ រួមទាំង ការរៀបចំ របៀបរៀបរយ សណ្ដាប់ធ្នាប់ ចរាចរណ៍ ជៀសវាង ការកកស្ទះ ធ្វើឲ្យ ប៉ះពាល់ ដល់ សតិអារម្មណ៍ របស់ ប្រជាពលរដ្ឋ ។
សូម ជម្រាប ថា គិត ត្រឹម ថ្ងៃទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ សល់ រយៈពេល តែ ៩ ថ្ងៃ ទៀត ប៉ុណ្ណោះ នៃ ដំណើរ ឆ្ពោះទៅ ធ្វើ ម្ចាស់ ផ្ទះ នៃ ការប្រកួត កីឡា ស៊ីហ្គេម លើក ទី ៣២ ដែល ត្រូវ ប្រារព្ធ ពិធី បើក ការប្រកួត នា ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២៣ ខាងមុខ ។ ការធ្វើជា ម្ចាស់ ផ្ទះ នៃ ព្រឹត្តិការណ៍ កីឡា ស៉ី ហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម គឺជា មោទនភាព និង មុខមាត់ សម្រាប់ ប្រទេស និង ប្រជាជន កម្ពុជា ទាំងមូល ដែល បាន រង់ចាំ អស់ រយៈពេល ៦៤ ឆ្នាំ មកហើយ ។
នា ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ ព្រះរាជ ពិធី សុំ ព្រះអគ្គីកីឡា សម្រាប់ ព្រឹត្តិការណ៍ ប្រកួត កីឡា អាស៊ី អាគ្នយ៍ លើក ទី ៣២ និង កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ឆ្នាំ ២០២៣ បាន ចាប់ផ្តើម ជា ផ្លូវការ ហើយ នឹង បន្ត រត់ តាម បណ្តា ប្រទេស តំបន់ អាស៊ី អាគ្នេយ៍ ទាំង ១០ប្រទេស មុន វិលត្រលប់មក ប្រទេស កម្ពុជា ដើម្បី ប្រារព្ធ ពិធី បើក ការប្រកួត កីឡា ស៊ីហ្គេម លើក ទី ៣២ ជា ផ្លូវការ តែម្ដង ៕
ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ កម្ពុជា អង្គរ អ៊ែរ បាន ដឹកជញ្ជូន ក្រុម បាល់ទាត់ ជម្រើសជាតិ វៀតណាម មកដល់ កម្ពុជា ហើយ
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ កម្ពុជា អង្គរ អ៊ែរ មាន កិត្តិយស ក្នុង ការដឹកជញ្ជូន ភ្ញៀវ ពិសេស ដែល ជា ក្រុម បាល់ទាត់ ជម្រើសជាតិ វៀតណាម ដើម្បី ចូលរួម ប្រកួតប្រជែង ក្នុង ព្រឹត្តិការណ៍ កីឡា អាស៊ាន « ស៊ីហ្គេម លើក ទី៣២ « ដែល ជា ព្រឹត្តិការណ៍ កីឡា ដ៏ មហាអស្ចារ្យ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ។ ជើងហោះហើរ លេខ K6 813 ចេញដំណើរ ពី អាកាសយានដ្ឋាន អន្តរ ជាតិ តាន សួន ញា ទីក្រុង ហូជីមិញ នៃ ប្រទេស វៀតណាម នៅ ម៉ោង ០៨៖៣០ ព្រឹក និង ត្រូវ ចុះចត នៅ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ នៅ ម៉ោង ០៩៖ ១៥ព្រឹក ។
ក្នុង នាម ជា ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ ក្រុមហ៊ុន ពិតជា មាន កិត្តិយស ក្នុង ការដើរ តួនាទី យ៉ាង សំខាន់ ដោយ បាន ដឹកជញ្ជូន ក្រុម បាល់ទាត់ ជម្រើសជាតិ វៀតណាម អត្តពលិក និង អ្នកគាំទ្រ ផ្សេង ៗ ទៀត មក ពី គ្រប់ បណ្តា ប្រទេស ដែល មក ចូលរួម ព្រឹត្តិការណ៍ នេះ ។ ដោយ មាន ការយកចិត្តទុកដាក់ ចាប់ពី កនែ្លង ទទួល អ្នកដំណើរ នៅ ទីក្រុង ហូជីមិញ រហូតមកដល់ ប្រទេស កម្ពុជា ក្រុម កីឡាករ ទាំងអស់ បាន មកដល់ គោលដៅ ដោយ សុវត្ថិភាព ផាសុកភាព និង ទាន់ ពេលវេលា តាម ការគ្រោងទុក របស់ ពួកគេ ។
ជា ការពិត ណាស់ កម្ពុជា អង្គរ អ៊ែ ជា ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ ដំបូង គេ និង តែ មួយ គត់ របស់ ប្រទេស កម្ពុជា ដែល ទទួលបាន វិញ្ញាបនប័ត្រ សុវត្ថិភាព IOS ពី សមាគម ដឹកជញ្ចូន ផ្លូវ អាកាស អន្តរជាតិ IATA ។ អ្នកដំណើរ ទាំងអស់ អាច ហោះហើរ ប្រកបដោយ ទំនុកចិត្ត ពីព្រោះ ក្រុមហ៊ុន អនុវត្ត តាម ស្តង់ដារ សុវត្ថិភាព ជាតិ និង អន្តរជាតិ ខ្ពស់ បំផុត ហើយ នៅតែ បន្ត ផ្តល់ ជូន នូវ បទពិសោធន៍ ហោះហើរ ប្រកបដោយ សុវត្ថិភាព និង ផាសុកភាព នូវ រាល់ ជើងហោះហើរ របស់ ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ កម្ពុជា អង្គរ អ៊ែរ ។
សូម អរគុណ ចំពោះ ការជ្រើសរើស ហោះហើរ ជាមួយ កម្ពុជា អង្គរ អ៊ែរ ក្រុមហ៊ុន យើងខ្ញុំ សូម ជូនពរ ដល់ កីឡាករ - កីឡាការិនី ទាំងអស់ ដែល បាន មក ចូលរួម ប្រកួត ក្នុង ព្រឹត្តិការណ៍ កីឡា ដ៏ ធំ នេះ ឲ្យ ជួប តែ សំណាង ល្អ និង ទទួលបាន ភាពជោគជ័យ ។ សូម ចូលរួម អបអរសាទរ ព្រឹត្តិការណ៍ កីឡា ស៊ីហ្គេម លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ទាំងអស់ គា្ន ហើយ ធ្វើដំណើរ តាម កម្ពុជា អង្គរ អ៊ែរ ដើម្បី ទទួលបាន បទពិសោធន៍ ដ៏ មាន ផាសុកភាព និង ភាព កក់ក្ដៅ ក្នុង ការស្នាក់ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ៕
ដើម្បី ទិញ សំបុត្រ សូម ទំនាក់ទំនង ទៅ កាន់៖
កាលពី ដំបូង ឡើយ លោក រ៉ាម៉ាហ្វូសា បាន និយាយ ថា គណបក្ស កាន់អំណាច អាហ្វ្រិក ខាងត្បូង បាន សម្រេចចិត្ត ដក ខ្លួន ចេញ ពី តុលាការ ICC ដែល បាន ចេញ ដីកា ចាប់ខ្លួន លោក ប្រធានាធិបតី រុស្ស៉ី វ្ល៉ាឌីមៀ ពូទីន កាលពី ខែមីនា កន្លងទៅ ។ ប៉ុន្តែ ការិយាល័យ របស់ លោក បាន ចេញមក បញ្ជាក់ យ៉ាង ច្បាស់ ឡើងវិញ តាម សេចក្តីថ្លែងការណ៍ មួយ ថា « អាហ្វ្រិក ខាងត្បូង នៅតែ ជា ប្រទេស ហត្ថលេខី របស់ ICC ។
សាលា គណរាជធានី ភ្នំពេញ ស្នើ គ្រប់ វត្ត អារាម វាយ ជួង រ គាំង និង ទូង ស្គរ ឱ្យ បាន កង រំពង ដើម្បី ចូលរួម អបអរសាទរ ក្នុង ពិធី ទទួល និង ដង្ហែ ព្រះអគ្គិជ័យ កីឡា
សេចក្តីជូនដំណឹង បាន ឲ្យដឹង ថា សាលា គណរាជធានី ភ្នំពេញ និង ជំនាញ ពាក់ព័ន្ធ សូម ប្រគេន ព្រះអនុគណខណ្ឌ ទាំង ១៤ ព្រះចៅ អធិការ គ្រប់ វត្ត ព្រះមេត្តា ជ្រាប ថា រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង រៀបចំ ពិធី ដង្ហែ ព្រះអគ្គិជ័យ កីឡា ពី តំបន់ អាស៊ាន ចូលមក ព្រះរាជាណាចក្រ កម្ពុជា តាម ច្រក ទ្វារ ព្រំដែន អន្តរជាតិ ត្រពាំង គៀល - ណង ណុក ស្មៀន ខេត្ត ស្ទឹងត្រែង និង ដង្ហែ បន្ត ឆ្ពោះទៅ តាម បណ្តា ខេត្ត ជុំវិញ បឹង ទន្លេ សាប ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ដោយ ដកស្រង់ សេចក្តីថ្លែងការណ៍ មួយ ដែល ចេញផ្សាយ ដោយ ធនាគារ រដ្ឋ វៀតណាម (SBV) ដែល ជា ធនាគារ កណ្តាល របស់ ប្រទេស វៀតណាម ថា វិធានការរៀបចំ កម្ចី ឡើងវិញ នេះ នឹង ត្រូវបាន អនុវត្ត រហូតដល់ ខែមិថុនា ឆ្នាំ ២០២៤ ។
រដ្ឋាភិបាល វៀតណាម បាន ឱ្យដឹង នៅក្នុង សេចក្តីថ្លែងការណ៍ ដាច់ដោយឡែក មួយ ថា នាយក រដ្ឋមន្ត្រី វៀតណាម លោក Pham Minh Chinh នៅ ចុង សប្តាហ៍ មុន បាន ស្នើ ឱ្យ ធនាគារ កណ្តាល វៀតណាម រៀបចំ ផែនការកំណត់ គោលដៅ ក្រុមហ៊ុន បន្ថែម ទៀត សម្រាប់ ការរៀបចំ ប្រាក់ កម្ចី ឡើងវិញ និង បង្កើន ពេលវេលា សង ។
ក្រុមហ៊ុន ជាច្រើន នៅក្នុង ប្រទេស វៀតណាម ដែល ជា មជ្ឈមណ្ឌល ផលិតកម្ម ក្នុង តំបន់ បាន និង កំពុង តស៊ូ ជាមួយនឹង ការធ្លាក់ចុះ តម្រូវការសកល ។ ការនាំចេញ បាន ធ្លាក់ចុះ ១១. ៩ភាគរយ នៅក្នុង ត្រីមាស ទី មួយ នៃ ឆ្នាំ នេះ ។
( ភ្នំពេញ ) ៖ លោក មួង សុភ័ក្រ ប្រធាន ក្រុម អ្នកស្រាវជ្រាវ វ័យ ក្មេង និង ជា សមាជិក សហព័ន្ធ សង្គម ស៉ីវិល បាន ចេញមុខ រិះគន់ លោក ស៊ន តារា សកម្មជន របស់ ក្រុម ប្រឆាំង ដែល លង់ នឹង មនោគមន៍វិជ្ជា ជ្រុលនិយម រ មិល គុណ រហូតដល់ កាត់ កាល ឪពុក ម្តាយ របស់ ខ្លួន ចោល ។
លោក មួង សុភ័ក្រ បាន លើកឡើង ថា សម្រាប់ ពុទ្ធសាសនា ឪពុក ម្តាយ ជា ព្រះរស់ ហើយ អ្នក ដែល ប្រតិបត្តិ តាម ព្រះពុទ្ធ សាសនា តែ តម្កល់ គុណ ឪពុក ម្តាយ ធំ ធេង មិន អាច កាត់ថ្លៃ បាន ប៉ុន្តែ លោក ស៊ន តារា ដើម្បី តែ ផ្គាប់ ចិត្ត នយោបាយ ក្រុម ប្រឆាំង បាន សម្រេច កាត់ កាល ឪពុក ម្តាយ និង បងប្អូន របស់ ខ្លួន ដែល នេះ ក៏ មិន ខុស អ្វី ពី ក្រុម ខ្មែរ ក្រហម ដែល លង់ នឹង មនោគមន៍វិជ្ជា ឆ្វេង និយម លែង ស្គាល់ ឪពុក ម្តាយ ដូចគ្នា ។
សូម ស្តាប់ និង ទស្សនា ការលើកឡើង របស់ លោក មួង សុភ័ក្រ ប្រធាន ក្រុម អ្នកស្រាវជ្រាវ វ័យ ក្មេង និង ជា សមាជិក សហព័ន្ធ សង្គម ស៉ី វិល ដូចត ទៅ៖
ក្រុម យុវជន អង្គការ សង្គម ស៊ីវិល ធ្វើ សន្និសីទ ព័ត៌មាន បង្ហាញ យុទ្ធនាការ កម្ចាត់ ចោល នយោបាយ ខ្មៅ កខ្វក់ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ បណ្តាញ ក្រុម យុវជន អង្គការ សង្គម ស៊ីវិល ដែល ធ្លាប់ ធ្វើ សកម្មភាព ប្រឆាំង រាជ រដ្ឋាភិបាល កម្ពុជា នោះ នៅ ព្រឹក ថ្ងៃពុធ ទី ២៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន ធ្វើ សន្និសីទ ព័ត៌មាន រួមគ្នា បង្ហាញ ពី យុទ្ធនាការ កម្ចាត់ ចោល នូវ នយោបាយ ខ្មៅ កខ្វក់ របស់ ក្រុម ប្រឆាំង ជាពិសេស ក្រុម ប្រឆាំង ដឹកនាំ ដោយ ជន ក្បត់ ជាតិ សម រង្ស៊ី ។
ក្រុម យុវជន ដែល ធ្លាប់ ចូលរួម គាំទ្រ សកម្មភាព នយោបាយ ដឹកនាំ ដោយ សម រង្ស៊ី នោះ បាន លើកឡើង ថា ពួកគេ បាន តាមដាន យ៉ាង យកចិត្តទុកដាក់ លើ បញ្ហា សង្គម នយោបាយ កន្លងមក និង ពេល បច្ចុប្បន្ន ។ ពួកគេ សង្កេតឃើញ ថា អ្នកនយោបាយ ប្រឆាំង មួយចំនួន តូច តែងតែ រិះរក យុទ្ធសាស្ត្រ ធ្វើឱ្យ ខុស សីលធម៌ សង្គម សីលធម៌ នយោបាយ ខុស ច្បាប់ ជាតិ - អន្តរជាតិ ប៉ះពាល់ កិត្តិយស ប្រទេសជាតិ ក្នុង ឆាក អន្តរជាតិ ដើម្បី ផលប្រយោជន៍ នយោបាយ ផ្ទាល់ខ្លួន ។
ក្រុម យុវជន ទាំងនេះ បន្ត ថា « ជាក់ស្តែង មាន មេដឹកនាំ ប្រឆាំង ម្នាក់ ដែល ជា អតីត មេដឹកនាំ អតីត បក្ស ប្រឆាំង ដែល កំពុង ភៀសខ្លួន នៅ ក្រៅ ប្រទេស តែងតែ ញុះញង់ បំបែកបំបាក់ ជាតិ សាសន៍ លាប ពណ៌ ប្រជាជន ខ្មែរ ទាំង ក្នុង នឹង ក្រៅ ប្រទេស ឲ្យ វាយតម្លៃ ជាតិ សាសន៍ ប្រើ ភាសា រើស អើង ពូជសាសន៍ បង្កើត គោល នយោបាយ ភូតភរ កុហក ប្រជា ភិថុត បោក បញ្ឆោត បំភ័ន្តភ្នែក មហាជន ជាតិ - អន្តរជាតិ ឲ្យ វ មើលងាយ ជាតិ សាសន៍ ខ្លួន ឯង បង្កើត បញ្ហា ផ្សេង ៗ រាប់ មិន អស់ » ។
ពួកគេ បាន លើកឡើង ទៀត ថា នយោបាយ មេដឹកនាំ អតីត បក្ស ប្រឆាំង រូប នេះ គឺ រាប់ សិប ឆ្នាំ មក នេះ មិន ដែល បាន ផ្តល់ ផល ចំណេញ ជូន ជាតិ នោះ ទេ មាន តែ រាំង ខ្ទប់ ការអភិវឌ្ឍ ជាតិ បំផ្លាញ វប្បធម៌ នយោបាយ ល្អ ៗ ហើយ បង្កើត នូវ វប្បធម៌ នយោបាយ អាក្រក់ ដែល មិន អាច ជួយ បង្រួបបង្រួម ជាតិ និង សង្គម កម្ពុជា ឡើយ ។
« មាន កត្តា ជាច្រើន ដែល យើង បាន ដឹង ពី នយោបាយ ពុត ត្បុត ហើយ ប្រជាជន ខ្មែរ ដែល បាន រងគ្រោះ បាន ធ្វើ សកម្មភាព ខុស ច្បាប់ ដោយសារតែ មនោគម វិជ្ជា ខ្មៅ កខ្វក់ ជ្រុលនិយម ។ តែ ជា សំណាង ល្អ ដោយសារ ប្រជាជន ខ្មែរ ទាំង ក្នុង នឹង ក្រៅ ប្រទេស បាន ដឹងខ្លួន និង ដក ខ្លួន ចេញ ក្រោយពី បាន ដឹង អំពី គោល នយោបាយ ខ្មៅ កខ្វក់ របស់ មេដឹកនាំ ឧទ្ទាម ក្រៅ ប្រទេស ម្នាក់ នោះ » ។ នេះ ជា ការរំលឹក ពី ពិសោធន៍ ដែល ពួកគេ ធ្លាប់ ហែល ឆ្លង ជាមួយ បក្ស ប្រឆាំង ។
ក្រុម យុវជន ទាំងនេះ បាន បង្ហាញ ការប្តេជ្ញាចិត្ត ថា នឹង រួមគ្នា ទប់ស្កាត់ និង លុបបំបាត់ ចោល គោល នយោបាយ ខ្មៅ កខ្វក់ នេះ ចេញ ពី កម្ពុជា ដែល ជា នយោបាយ ដ៏ គ្រោះថ្នាក់ សម្រាប់ ជាតិ ៕
( ភ្នំពេញ ) ៖ ធនាគារ សហពាណិជ្ជ ក . អ បាន បរិច្ចាគ ថវិកា ចំនួន ២ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ធនាគារ សហពាណិជ្ជ ក . អ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ក្រចេះ បិទ សន្និបាត ការងារ ជំរុញ ផែនការ សកម្មភាព ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជាតិ ៣ខែ ខាងមុខ
( ក្រចេះ ) ៖ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ក្រចេះ បាន ប្រារព្ធ បិទ សន្និបាត ការងារ ជំរុញ ផែនការ សកម្មភាព ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ដែល នឹង ប្រព្រឹត្តទៅ នា ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ ។
ពិធី នេះ បាន ប្រព្រឹត្តទៅ កាលពី ព្រឹក ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នៅ សាល មហោស្រព ខេត្ត ដោយ មាន វត្តមាន របស់ ក្រុមការងារ ថ្នាក់ ជាតិ និង ការចូលរួម ពី លោក ប្រធាន អនុប្រធាន គណបក្ស ខេត្ត លោក លោកស្រី ប្រធាន អនុប្រធាន ក្រុមការងារ គណបក្ស ថ្នាក់ កណ្តាល ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក ក្រុង ឃុំ សង្កាត់ ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ និង មេឃុំ ចៅសង្កាត់ ព្រមទាំង មន្ត្រី មូលដ្ឋាន សរុប មាន អ្នកចូលរួម ប្រមាណ ជិត ៥០០ នាក់ ។
បន្ទាប់ពី លោក វ៉ា ថន ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ខេត្ត និង ជា អភិបាល ខេត្ត ក្រចេះ បាន ថ្លែង បូកសរុប ពី លទ្ធផល នៃ សន្និបាត ដែល ប្រព្រឹត្តទៅ អស់ រយៈពេល មួយ ថ្ងៃ កន្លះ រួច មក លោក ធុន គ្រី អនុប្រធាន ប្រចាំ ការ គណបក្ស ខេត្ត ក្រចេះ បាន ធ្វើ ការប្រកាស សេចក្តីសម្រេច របស់ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ គណបក្ស ប្រជាជន កម្ពុជា ស្តីពី ការតែងតាំង បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ សម្រាប់ មណ្ឌល ខេត្ត ក្រចេះ រួម មាន៖
ចុងបញ្ចប់ នៃ កម្មវិធី លោក រដ្ឋមន្ត្រី ព្រុំ សុខា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ខេត្ត ក្រចេះ តំណាង អង្គ ពិធី ទាំងមូល បាន ថ្លែង មតិ បូកសរុប សន្និបាត និង ធ្វើ ការ ផ្តាំផ្ញើ ឱ្យ ក្រុមការងារ និង គណបក្ស ខេត្ត បន្ត សហការ គ្នា ចុះ ពង្រឹង មូលដ្ឋាន យ៉ាង សកម្ម ផុស ផុល សំដៅ ច្បាម ជាប់ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ អ្នកបោះឆ្នោត ដើម្បី ជំរុញ អនុវត្ត ផែនការ សកម្មភាព ជាក់ស្តែង របស់ គណបក្ស ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ។
ជាបន្ទាន់ និង ចាំបាច់ ត្រូវ យកចិត្តទុកដាក់ ជាពិសេស ការគ្រប់គ្រង សមាជិក បក្ស និង ពង្រីក សមាជិក ថ្មី បន្ត ធ្វើ អំពើ ល្អ នៅ មូលដ្ឋាន និង ដោះស្រាយ រាល់ ការថ្នាំង ថ្នាក់ របស់ ប្រជាពលរដ្ឋ ជួយ យកអាសារ ទំនុកបំរុង ជីវភាព ប្រជាជន រងគ្រោះ ដោយ ផល ប៉ះពាល់ ពី វិបត្តិ ផ្សេង ៗ ឱ្យ បាន ជាប់ ជាប្រចាំ និង ត្រូវ ពុះពារ រក្សា ឧត្តមភាព ប្រៀប ឈ្នះ របស់ គណបក្ស វាយ សម្រុក ផ្តាច់ព្រ័ត្រ ដើម្បី យក ជ័យ ជំនះ ទាំងស្រុង ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧៕
មួយ ថ្ងៃ មុន កិច្ចប្រជុំ កំពូល នៅ ទីក្រុង វ៉ាស៊ីនតោន ជាមួយ លោក ចូ បៃ ដិន ប្រធានាធិបតី អាមេរិក លោក យូន បាន ថ្លែង ក្នុង ព្រឹត្តិការណ៍ មួយ ដែល រៀបចំ ដោយ សភា ពាណិជ្ជកម្ម សហរដ្ឋ អាមេរិក ថា សម្ព័ន្ធ ភាព សន្តិសុខ ទ្វេ ភាគី គួរតែ « វិវត្ត ទៅជា ខ្សែ ចង្វាក់ ផ្គត់ផ្គង់ និង សម្ព័ន្ធភាព បច្ចេកវិទ្យា ប្រកបដោយ ភាពច្នៃប្រឌិត នា ពេល អនាគត » ។
លោក យូន បាន បន្ថែម ថា សេដ្ឋកិច្ច របស់ ប្រទេស ទាំង ពីរ បាន និង កំពុង ជួប បញ្ហា ប្រឈម ថ្មី ៗ រួមទាំង កំណើន សេដ្ឋកិច្ច យឺតយ៉ាវ ក៏ ធ្វើឲ្យ បរិយាកាស វិនិយោគ មិន មាន ស្ថិរភាព ផងដែរ ។ ជាមួយគ្នា នេះ ការប្រកួតប្រជែង ផ្នែក បច្ចេកវិទ្យា ថាមពល និង វិបត្តិ អាកាសធាតុ បាន បន្ថែម ភាព មិន ច្បាស់លាស់ សម្រាប់ សកម្មភាព អាជីវកម្ម ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។
គួរ បញ្ជាក់ ថា បើ តាម លោក យូន តាមរយៈ ការបណ្តាក់ទុន រួមគ្នា រវាង ក្រុមហ៊ុន កូរ៉េ ខាងត្បូង និង ក្រុមហ៊ុន អាមេរិក គិត ចាប់តាំងពី ឆ្នាំ ១៩៦៥ កូរ៉េ ខាងត្បូង បាន ងើប ស្ទុះ ឡើង ក្លាយជា ប្រទេស ឈាន មុខ គេ លើ ការផលិត បន្ទះ memory ដែល រួមចំណែក ៦០ ភាគរយ នៃ ទីផ្សារ ពិភពលោក ៕
( ភ្នំពេញ ) ៖ លោក ម៉ៅ ស៊ី ថា ប្រធាន បណ្តាញ យុវជន ខ្មែរ មហានគរ បាន សម្តែង ការហួសចិត្ត ចំពោះ ទង្វើ របស់ លោក ស៊ន តារា សកម្មជន របស់ ក្រុម ប្រឆាំង ដោយ ហ៊ាន កាត់ កាល ឪពុក ម្តាយ របស់ ខ្លួន ចោល ដែល ទង្វើ នេះ មិន ខុសពី កូន តិរច្ឆាន ឡើយ និង បុគ្គល ពាល ឡើយ ។
គួរ បញ្ជាក់ ថា អ្នកទោស ឈ្មោះ តាន់ ហ្ការ៉ា ជូ ស៊ូប ពីយ៉ាស់ (Tangaraju Suppiah) ត្រូវបាន តុលាការ សិង្ហបុរី ផ្តន្ទាទោស កាលពី ឆ្នាំ ២០១៧ ពី សម គំនិត ជួញដូរ កញ្ឆា មាន ទម្ងន់ ជាង ១គីឡូក្រាម ហើយ ទម្ងន់ នេះ គ្រប់គ្រាន់ សម្រាប់ ការផ្តន្ទាទោស ប្រហារជីវិត ក្រោម ច្បាប់ សិង្ហបុរី ។ រហូតដល់ ឆ្នាំ ២០១៨ ទើប បុរស ម្នាក់ នេះ ត្រូវបាន ផ្តន្ទាទោស ប្រហារជីវិត ហើយ តុលាការ ឧទ្ធរណ៍ នៅតែ តម្កល់ ទុក សាលក្រម នេះ ដដែល ៕
ខួប ៧០ ឆ្នាំ ទំនាក់ទំនង ការទូត រវាង កម្ពុជា - ជប៉ុន . ប្រធាន សមាគម ជប៉ុន - កម្ពុជា ស្នើសុំ រដ្ឋបាល រាជធានី ភ្នំពេញ រៀបចំ ព្រឹត្តិការណ៍ ដ៏ ធំ មួយ ដើម្បី បង្ហាញ ពី វប្បធម៌ អរិយធម៌
( ភ្នំពេញ ) ៖ ខួប ៧០ ឆ្នាំ នៃ ទំនាក់ទំនង ការទូត រវាង ប្រទេស កម្ពុជា និង ប្រទេស ជប៉ុន គ្រោង នឹង រៀបចំ ឱ្យ មាន ព្រឹត្តិការណ៍ ធំ ៗ ជាច្រើន ដោយ មាន ទាំង ការសម្ដែង សិល្បៈ បង្ហាញ ពី វប្បធម៌ របស់ ប្រទេស ជប៉ុន ផងដែរ ។
ក្នុង ឱកាស នោះ លោក ហ៊ូមី អាគិ តា កាហាស្សី បាន សុំ ការសហការ ជាមួយនឹង អាជ្ញាធរ រាជធានី ភ្នំពេញ ក្នុង ការរៀបចំ ខួប៧០ ឆ្នាំ នៃ ទំនាក់ទំនង ការទូត កម្ពុជា - ជប៉ុន ហើយ សម្រាប់ ខួប ៧០ នេះ សមាគមន៍ ជប៉ុន - កម្ពុជា ក៏ ដូចជា ស្ថានទូត ជប៉ុន គ្រោង នឹង រៀបចំ ជា ព្រឹត្តិការណ៍ ដ៏ ធំ មួយ ដោយ មាន ទាំង ការបាញ់ កាំជ្រួច ការសម្ដែង សិល្បៈ ដែល បង្ហាញ ពី វប្បធម៌ អរិយធម៌ របស់ ប្រទេស ជប៉ុន និង កម្មវិធី ផ្សេង ៗ ទៀត ដោយ នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ខាងមុខ ។
ចំពោះ ការស្នើសុំ សហការ ជុំវិញ ការបាញ់ កាំជ្រួច ក្នុង ព្រឹត្តិការណ៍ ខួប ទំនាក់ទំនង ការទូត រយៈពេល ៧០ ឆ្នាំ នេះ លោក ឃួង ស្រេង សូម ឱ្យ ប្រធាន សមាគម ធ្វើ ទំនាក់ទំនង ទៅ ក្រសួង ការបរទេស ក៏ ដូចជា ក្រសួង ការពារ ជាតិ និង ក្រសួង មហាផ្ទៃ ដើម្បី សូម ការអនុញ្ញាត សិន ។ ក្រោយពី មាន ការឯកភាព ពី រាជ រដ្ឋាភិបាល រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង សហការ យ៉ាង ពេញ ទំហឹង ក្នុង ការរក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ សម្រាប់ ពិធី ដ៏ ធំ នេះ ។
លោក ឃួង ស្រេង បាន បន្ត ថា រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ ដូចជា រាជ រដ្ឋាភិបាល កម្ពុជា គឺ បាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ចំពោះ អ្នក វិនិយោគ របស់ ជប៉ុន ក៏ ដូចជា អ្នកទេសចរ និង ប្រជាពលរដ្ឋ ជប៉ុន ដែល មក ស្នាក់ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ដែល ធ្វើឱ្យ គាត់ មាន ភាព កក់ក្តៅ ក្នុង ចិត្ត ។
នៅក្នុង ជំនួប ពិភាក្សា ការងារ នេះ ដែរ លោក ឃួង ស្រេង ក៏ បាន ស្នើសុំ ឱ្យ ប្រទេស ជប៉ុន ពិនិត្យ លទ្ធភាព ក្នុង ការជួយ ផ្ដល់ ជា រថយន្ត ពន្លត់ អគ្គីភ័យ បន្ថែម ទៀត ជូន មក រដ្ឋបាល រាជធានី ភ្នំពេញ ពិសេស រថយន្ត ពន្លត់ អគ្គីភ័យ សម្រាប់ ពន្លត់ អគ្គីភ័យ នៅ អគារ ខ្ពស់ ដោយសារ ថា រាជធានី ភ្នំពេញ សព្វ ថ្ងៃ នេះ មាន អគារ ខ្ពស់ ខ្ពស់ កាន់តែ ច្រើន ដែល ទាមទារ ឱ្យ រដ្ឋបាល រាជធានី ភ្នំពេញ ខិតខំ បង្កា ទប់ស្កាត់ គ្រោះ អគ្គីភ័យ អោយ បាន ល្អ បន្ថែម ទៀត ស្រប ទៅតាម ការរីកចម្រើន ឥត ឈប់ឈរ របស់ រាជធានី ភ្នំពេញ ។
គួរ បញ្ជាក់ ថា លោក ចូ បៃ ដិន ក៏ នឹង ត្រូវ ចូលរួម ផងដែរ ក្នុង កិច្ចប្រជុំ កំពូល នៃ ក្រុម ប្រទេស ក្វា ដ នៅក្នុង ទីក្រុង ស៉ីដនី ប្រទេស អូស្រ្តាលី នៅ ថ្ងៃទី ២៤ ខែឧសភា ក្រោយ នេះ ។ ក្វា ដ មាន សមាជិក ដូចជា អូស្ត្រាលី សហរដ្ឋ អាមេរិក ជប៉ុន និង ឥណ្ឌា ៕
បើ តាម លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ ចំនួន ភ្ញៀវ ច្រើន នេះ គឺ ដោយសារ ភ្ញៀវ ទេសចរ និង ប្រជាពលរដ្ឋ នៅ បន្ត ដើរលេង នៅ តាម គោលដៅ ទេសចរណ៍ នានា ក៏ ដូចជា បន្ត លេង កម្សាន្ត កម្មវិធី ផ្សេង ៗ បន្ទាប់ពី បញ្ចប់ កម្មវិធី ចូល ឆ្នាំ ។
គោលដៅ ទេសចរណ៍ សំខាន់ ៗ រួម មាន៖
លោក រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា ចំនួន ភ្ញៀវ ជិត ៨០ម៉ឺន នាក់ ក្នុង រយៈពេល សប្តាហ៍ កន្លងមក ជា ចំនួន ច្រើន មួយ ធៀប នឹង សប្តាហ៍ ធម្មតា ដែល ភ្ញៀវ ទេសចរ មាន ចំនួន ជា មធ្យម ចន្លោះ ពី ២៥ - ៣០ម៉ឺន នាក់ ក្នុង មួយ សប្តាហ៍ ខណៈ ដែល រយៈពេល ចូល ឆ្នាំ ៣ ថ្ងៃ កម្ពុជា ទទួលបាន ភ្ញៀវ សរុប ប្រមាណ ជាង ១៣លាន នាក់ ។
អ្វី ដែល ជា ការកត់សម្គាល់ សំខាន់ នោះ គឺជា ការប្រារព្ធ ពិធី បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ ដែល មាន ចំនួន ភ្ញៀវ ទេសចរ និង ប្រជាពលរដ្ឋ ដើរកម្សាន្ត ច្រើន បំផុត ពិសេស បន្ទាប់ពី ការគ្រប់គ្រង ស្ថានភាព ជំងឺ កូវីដ - ១៩ បាន យ៉ាង ល្អ ស្រប ជាមួយ ការរៀបចំ កម្មវិធី កម្សាន្ត សប្បាយ ជាច្រើន នៅ គ្រប់ បណ្តា រាជធានី - ខេត្ត ពិសេស ព្រឹត្តិការណ៍ អង្គរ សង្រ្កាន្ត ៕
តើ អ្នកជំនាញ មើលឃើញ កម្ពុជា ចំណេញ ផ្នែក សេដ្ឋកិច្ច អ្វី ខ្លះ ពី ការធ្វើជា ម្ចាស់ ផ្ទះ ព្រឹត្តិការណ៍ ស៊ីហ្គេម ២០២៣ ?
ក្នុង នាម ជា ម្ចាស់ ផ្ទះ កម្ពុជា បាន ត្រៀម ខ្លួន និង ខិតខំ រៀបចំ ព្រឹត្តិការណ៍ បាន យ៉ាង ល្អ ហើយ អ្វី ដែល កាន់តែ ពិសេស ទៀត នោះ ប្រមុខ រាជ រដ្ឋាភិបាល បាន អនុញ្ញាតឱ្យ ភ្ញៀវ ជាតិ និង អន្តរជាតិ ទាំងអស់ ចូល ទស្សនា ដោយ ឥត គិត ថ្លៃ និង មិន គិត ថ្លៃ ចំពោះ ផ្សាយ បន្ដ ផ្ទាល់ ទៅ តាម បណ្តា ប្រទេស នានា រួម ជាមួយ ការ មិន តម្រូវឲ្យ ប្រតិភូ កីឡា ទាំងអស់ មិន បង់ប្រាក់ ផងដែរ ។
អ្នកជំនាញ សេដ្ឋកិច្ច មើលឃើញ ថា ព្រឹត្តិការណ៍ ក្រកួត កីឡា ស៊ីហ្គេម ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នេះ នឹង ធ្វើឱ្យ អន្តរជាតិ ស្គាល់ កម្ពុជា កាន់តែ ច្រើន ជាង មុន ដែល អាច ទាញ បាន នូវ ផលប្រយោជន៍ សេដ្ឋកិច្ច ទាំង ផ្ទាល់ និង ប្រយោល បាន នា ពេល ខាងមុខ ។
លោក បន្ត ថា « ខ្ញុំ ជឿជាក់ ថា ព្រឹត្តិការណ៍ កីឡា ស៊ីហ្គេម នេះ នឹង ត្រូវបាន ផ្សាយ ជា ឱឡារិក ទៅដល់ ទូទាំង សកលលោក ដែល អាច ធ្វើឱ្យ កម្ពុជា យើង ត្រូវបាន គេ ស្គាល់ ពាសពេញ ពិភពលោក បន្ថែម ពីលើ អ្វី ដែល គេ ធ្លាប់ ស្គាល់ ពី មុន ទាំង នៅក្នុង ទិដ្ឋភាព ល្អ និង មិន ល្អ ផង » ។
លោក លើកឡើង ថា បន្ទាប់ពី ព្រឹត្តិការណ៍ នេះ បាន បញ្ចប់ ទៅ នឹង ធ្វើឱ្យ កម្ពុជា កាន់តែ លេចធ្លោ ល្បី នៅលើ ឆាក អន្តរជាតិ មាន ការទទួលស្គាល់ កោតសរសើរ និង មាន ការចាប់អារម្មណ៍ ពី បណ្តា ប្រទេស ជា មិត្ត ឬ ប្រទេស ផ្សេង ៗ នៅ បស្ចឹម លោក ក្នុង ការធ្វើ កិច្ចសហប្រតិបត្តិការ ទៅ លើ វិស័យ ផ្សេង ៗ ជាមួយ រាជ រដ្ឋាភិបាល ។
លោក បញ្ជាក់ ថា ផល ចំណេញ ដែល កម្ពុជា នឹង ទទួលបាន គឺ កំណើន ភ្ញៀវ ទេសចរ នៅ ឆ្នាំ នេះ និង នៅ ឆ្នាំ បន្តបន្ទាប់ ខាងមុខ ទៀត ។ លើស ពី នេះ ទៅ ទៀត នឹង អាច ទាក់ទាញ ក៏ ដូចជា ទទួលបាន នូវ គម្រោង វិនិយោគ ថ្មី ៗ បន្ថែម ទៀត ប្រកបដោយ ទំនុកចិត្ត ពី វិនិយោគិន បរទេស ទាំងនោះ ស្រប ជាមួយនឹង សក្តានុពល របស់ កម្ពុជា ។
អ្នកជំនាញ សេដ្ឋកិច្ច រូប នេះ បន្ត ទៀត ថា ព្រឹត្តិការណ៍ នេះ ក៏ ជា ឱកាស ដែល ម្ចាស់ សហគ្រាស ធុន តូច និង មធ្យម ដាក់ លក់ ឬ បង្ហាញ ផលិតផល របស់ ខ្លួន ដល់ ប្រតិភូ ឬ ភ្ញៀវ បរទេស ដែល ចូលមក ទស្សនា ផងដែរ ។
លោក បន្ថែម ថា « ក្នុង ពេលនេះ គឺជា ពេលវេលា ដ៏ អស្ចារ្យ ហើយ មាន រយៈពេល វែង ដែល គួរតែ មាន ការរៀបចំ ជា ស្តង់ សម្រាប់ តាំង បង្ហាញ ផលិតផល ផ្សេង ៗ ដែល ផលិត ដោយ សិប្បកម្ម ឧស្សាហកម្ម ក្នុង ស្រុក ដែល ជា ស្នាដៃ កូន ខ្មែរ ឱ្យ បរទេស បាន ឃើញ ដែល ពួកគេ អាចនឹង ទិញ ទុក ជា អនុស្សាវរីយ៍ ដើម្បី អាច ផ្តល់ ចំណូល ដល់ សេដ្ឋកិច្ច ។ ហើយ ប្រសិនបើ ផលិតផល ទាំងនោះ មាន ការទាក់ទាញ ពួកគេ នឹង នៅតែ ធ្វើ ការបញ្ជាទិញ ពី សិប្បករ របស់ កម្ពុជា » ។
លោក បាន ពន្យល់ យ៉ាង ដូច្នេះ ថា កម្ពុជា នឹង ទទួលបាន ផលចំណេញ ផ្ទាល់ តាមរយៈ ការចំណាយ របស់ ភ្ញៀវ ដែល មក ទស្សនា ការប្រកួត ដោយ ផ្ទាល់ ទៅ លើ ថ្លៃ ម្ហូប អាហារ កន្លែង ស្នាក់ នៅ ការធ្វើដំណើរ និង ការទិញ វត្ថុអនុវស្សា វរីយ៍ ជាដើម ។
លើស ពី នេះ ទៅ ទៀត កម្ពុជា ក៏ អាច ទទួលបាន ផលចំណេញ ដោយ ប្រយោល ផងដែរ ។ តាមរយៈ ការរៀបចំ ព្រឹត្តិការណ៍ នេះ គឺជា មុខមាត់ របស់ កម្ពុជា ធ្វើឱ្យ សាធារណៈ មតិ នៅលើ ឆាក អន្តរជាតិ កាន់តែ មាន ភាពវិជ្ជមាន ចំពោះ កម្ពុជា ដែល នាំឱ្យ វិនិយោគិន អាច កាន់តែ មាន ជំនឿចិត្ត លើ កម្ពុជា ថា ជា ប្រទេស ដែល មាន សមត្ថភាព អាច ធ្វើ ការងារ ធំ ៗ មាន ស្ថិរភាព និង សន្តិភាព ។ កត្តា នេះ នឹង ជំរុញឱ្យ កម្ពុជា ទទួលបាន នូវ ការ បណ្តាក់ទុន រកស៊ី និង ការធ្វើ ពាណិជ្ជកម្ម ផ្សេង ៗ ។
លោក សម្លឹង ឃើញ ថា តាមរយៈ ព្រឹត្តិការណ៍ នេះ នឹង ជួយ ជំរុញ ចលនា ទេសចរណ៍ នា ពេល ខាងមុខ ឱ្យ កាន់តែ ប្រសើរឡើង ផងដែរ ។
លោក ធួន ស៊ីណាន ប្រធាន សមាគម ទេសចរណ៍ អាស៊ី ប៉ាស៊ីហ្វិក កម្ពុជា បាន ឱ្យដឹង ថា សម្រាប់ ព្រឹត្តិការណ៍ ប្រកួត កីឡា ស៊ីហ្គេម នេះ កន្លងមក ក្រុមហ៊ុន ទេសចរណ៍ មួយចំនួន បាន រៀបចំ កញ្ចប់ ទេសចរណ៍ សម្រាប់ ភ្ញៀវ ពី បណ្តា ប្រទេស ក្នុង តំបន់ អាស៊ាន ដែល មាន បំណង មក ទស្សនា ឬ គាំទ្រ កីឡាករ ប្រទេស របស់ ខ្លួន ។
