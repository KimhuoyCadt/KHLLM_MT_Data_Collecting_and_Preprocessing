( ភ្នំពេញ ) ៖ ឯកឧត្ដម ត្រាក់ ថៃ សៀង និង លោកជំទាវ អ៊ឹង កន្ថា ផាវី រដ្ឋមន្ត្រី ក្រសួង កិច្ចការ នារី បាន បរិច្ចាគ ថវិកា ចំនួន ២ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម ត្រាក់ ថៃ សៀង និង លោកជំទាវ អ៊ឹង កន្ថា ផាវី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា ពុង ឃាវ សែ ប្រធាន ក្រុមប្រឹក្សាភិបាល ធនាគារ កាណាឌីយ៉ា ភី អិល ស៊ី និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ២០ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
អ្នក ឧកញ៉ា ពុង ឃាវ សែ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម ខៀវ កាញារីទ្ធ និង លោកជំទាវ ទេព រង្ស៊ី បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ខៀវ កាញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន និង លោកជំទាវ ទេព រង្ស៊ី បាន បរិច្ចាគ ថវិកា ចំនួន ១ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម ខៀវ កាញារីទ្ធ និង លោកជំទាវ ទេព រង្ស៊ី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គណៈកម្មាធិការ តំបន់ សេដ្ឋកិច្ច ពិសេស កម្ពុជា បរិច្ចាគ ថវិកា ៣ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ )៖ គណៈកម្មាធិការ តំបន់ សេដ្ឋកិច្ច ពិសេស កម្ពុជា បាន បរិច្ចាគ ថវិកា ចំនួន ៣ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
គណៈកម្មាធិការ តំបន់ សេដ្ឋកិច្ច ពិសេស កម្ពុជា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម ហេង ស៊ីនឿន និង លោកជំទាវ បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្តម ហេង ស៊ីនឿន និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ២ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្តម ហេង ស៊ីនឿន និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ លោកជំទាវ គូ គឹម ឡុង បាន បរិច្ចាគ ថវិកា ចំនួន ៥ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
លោកជំទាវ គូ គឹម ឡុង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម វង្សី វិស្សុត និង លោកជំទាវ បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្តម វង្សី វិស្សុត រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្តម វង្សី វិស្សុត និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ប្រេង ឆៅ ធ្លាក់ ថ្លៃ ដោយសារ ការភ័យខ្លាច នៃ ការដើរ ថយ ក្រោយ សេដ្ឋកិច្ច និង តម្រូវការ ទាប (Video inside) ( សិង្ហបុរី ) ៖ តម្លៃ ប្រេង ឆៅ បាន ធ្លាក់ចុះ ថ្លៃ រយៈពេល បី ថ្ងៃ ជាប់ ៗ គ្នា គិត ត្រឹម ថ្ងៃសុក្រ ហើយ អាច ធ្លាក់ចុះ បន្ថែម ទៀត ខណៈ ការធ្លាក់ចុះ ទិន្នន័យ សេដ្ឋកិច្ច និង ការកើនឡើង ស្តុក ប្រេង នៅ អាមេរិក បាន បង្កើន ក្តីបារម្ភ អំពី ការដើរ ថយ ក្រោយ នៃ សេដ្ឋកិច្ច និង ថយចុះ តម្រូវការ ប្រេង ពិភពលោក ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ។
កាលពី ថ្ងៃព្រហស្បតិ៍ ប្រេង ទាំង ពីរ ប្រភេទ នេះ បាន ធ្លាក់ចុះ ថ្លៃ ជាង ២ភាគរយ ដល់ កម្រិត ទាប បំផុត គិត ចាប់តាំងពី ចុង ខែមីនា មក ក្នុង គ្រា ដែល មាន ការភ័យខ្លាច ថា មាន ការដើរ ថយ ក្រោយ នៃ សេដ្ឋកិច្ច ។
ព្រឹក ស្អែក បណ្ឌិត ហ៊ុន ម៉ាណែត នឹង អញ្ជើញ សម្ពោធ បើក ឲ្យ ដំណើរការ ជា ផ្លូវការ សណ្ឋាគារ ផ្កាយ៥ « សាន់ & មូន រី វើសាយ » នៅជិត ស្ពាន ព្រះមុនីវង្ស
លក្ខណៈ ពិសេស « សាន់ & មូន រី វើសាយ » គឺ បាន សាងសង់ ជាប់ មាត់ ទន្លេបាសាក់ អគារ បែប មុខ ទៅ ទិស ខាងកើត ទទួលបាន ខ្យល់អាកាស និង បរិយាយ កាស ធម្មជាតិ បរិសុទ្ធ ហើយ អតិថិជន ស្នាក់ នៅ សណ្ឋាគារ នេះ អាច ជិះ ទូក កំសាន្ដ គយ គន់ ជាមួយ ព្រះអាទិត្យ រះ និង អស្តង្គត់ ដ៏ រ៉ូមែនទិច ជាមួយ ដៃគូ ជីវិត គ្រួសារ និង ក្រុមការងារ បង្កើត អនុស្សាវរីយ៍ ដ៏ មាន ន័យ ។
កាន់តែ ពិសេស សណ្ឋាគារ លំដាប់ ផ្កាយ៥ « សាន់ & មូន រី វើសាយ » បាន រចនា ឡើង ដ៏ ល្អ ឯក មាន ជា ប្រព័ន្ធ អេកូឡូស៊ី នៃ ការរស់នៅ ដែល មាន ការរចនា តែ មួយ គត់ ដែល រួម បញ្ជូល បច្ចេកវិទ្យា ដ៏ ជឿនលឿន សម្រាប់ សុខុមាលភាព និង កន្លែង ហាត់ប្រាណ ជាមួយនឹង ការរៀបចំ ព្រឹត្ដិការណ៍ ទ្រង់ទ្រាយ ធំ បន្ទប់ ប្រជុំ និង បរិវេណ ការិយាល័យ រួម និង បទពិសោធន៍ ទទួលទាន អាហារ ចម្រុះ ជាតិ សាសន៍ ប្រកបដោយ ប្រភព នៃ រសជាតិ ដ៏ ឈ្ងុយ ឆ្ងាញ់ ពិសា គ្មាន ពីរ ជាមួយ ចុងភៅ ឆ្នើម ប្រចាំ សណ្ឋាគារ ។
ដោយសារតែ ការច្នៃប្រឌិត ខ្ពស់ ប្រកបដោយ ស្ដង់ដា របស់ កូន ខ្មែរ ដ៏ ឆ្នើម នេះ ទើប ក្នុង រយៈពេល បើក សាង ល្បង កន្លងមក នេះ បាន ឆ្លើយតប ទៅនឹង តម្រូវការ និង ក្ដី ប្រាថ្នា របស់ អតិថិជន យ៉ាង ខ្លាំង ទាំង ជាតិ និង អន្ដរជាតិ ព្រោះ បាន ស្គាល់ នូវ បទពិសោធន៍ នៃ ការកេ្រប រសជាតិ ជីវិត តាម យុគសម័យ ថ្មី ពិសេស សណ្ឋាគារ លំដាប់ ផ្កាយ ៥នេះ បាន ចូលរួមចំណែក ក្នុង ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ជំរុញ សេដ្ឋកិច្ច ក្នុង មូលដ្ឋាន និង បង្កើត ការងារ ធ្វើ សម្រាប់ ពលរដ្ឋ កម្ពុជា ផងដែរ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម អ៊ុក សម វិទ្យា និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្តម អ៊ុក សម វិទ្យា និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម នាយ ឧត្តមសេនីយ៍ ម៉ៅ ហាវណ្ណាល់ និង លោកជំទាវ ខាន់ ម៉ានី ដា បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្ដម នាយ ឧត្តមសេនីយ៍ ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្ត្រី ទទួលបន្ទុក រដ្ធ លេខាធិការ ដ្ធាន អាកាសចរ ស៊ីវិល និង លោកជំទាវ ខាន់ ម៉ានី ដា បាន បរិច្ចាគ ថវិកា ចំនួន ២ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម នាយ ឧត្តមសេនីយ៍ ម៉ៅ ហាវណ្ណាល់ និង លោកជំទាវ ខាន់ ម៉ានីដា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
រដ្ឋមន្រ្តី ការបរទេស ចិន៖ ត្រើយ ទាំង សងខាង នៃ ច្រក សមុទ្រ តៃវ៉ាន់ គឺជា កម្មសិទ្ធិ របស់ ប្រទេស ចិន
លោក ឈិន បាន ធ្វើ ការអត្ថាធិប្បាយ ដូច ខាងលើ កំឡុង វេទិកា មួយ នៅ ទីក្រុង សៀងហៃ ជា ទី ដែល លោក បាន លើកឡើង អំពី បញ្ហា ជាច្រើន មាន ចាប់តាំងពី បំណុល សេដ្ឋកិច្ច សកល ហើយនិង តៃវ៉ាន់ ។ លោក រដ្ឋមន្រ្តី ការបរទេស ចិន បាន បន្ថែម យ៉ាង ដូច្នេះ ថា « នា ពេល ថ្មី ៗ នេះ មាន ការចោទប្រកាន់ ជ្រុល ហួសហេតុ ថា ចិន កំពុង ព្យាយាម ផ្លាស់ប្តូរ ស្ថានភាព ដើម និង បង្ក ការប៉ះពាល់ ដល់ សុខ សន្តិភាព ក៏ ដូចជា ស្ថិរភាព នៅ ច្រក សមុទ្រ តៃវ៉ាន់ ។ ការយល់ឃើញ បែប នេះ គឺ មិន សម ហេតុផល និង គ្រោះថ្នាក់ ជា ទីបំផុត » ។
លោក ឈិន បាន បន្ត ទៀត ថា « មិន មែន ចិន នោះ ទេ ប៉ុន្តែ ចលនា បំបែក រដ្ឋ ចង់បាន ឯករាជ្យ នៅ តៃវ៉ាន់ រួម ជាមួយនិង ប្រទេស មួយចំនួន តូច ដែល កំពុង ប៉ុនប៉ង បំផ្លាញ ស្ថានភាព ដើម ។ អ្នក ទាំងឡាយ ដែល ប្រលែង លេង ជាមួយ បញ្ហា តៃវ៉ាន់ ទីបំផុត នឹង ត្រូវ រលាក ខ្លួន ឯង មិន ខាន ឡើយ » ។ បើ តាម លោក ឈិន អ្នក ដែល ប្រកាន់ សច្ចធម៌ អាច មើលឃើញ យ៉ាង ច្បាស់ ថា តើ អ្នកណា ដែល កំពុង បង្កហេតុ រក រឿង ដាក់ អ្នកណា មុន នោះ ។
( កោះកុង) ៖ ដោយ ទទួលបាន ការណែនាំ ពី លោក ឧត្តមសេនីយ៍ ត្រី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កោះកុង នៅ រសៀល ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២៣. លោក វរសេនីយ៍ ទោ ម៉ាន់ ដាវីត នាយ សេនាធិការ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត កោះកុង បាន ប្រជុំ ផ្សព្វផ្សាយ ជា ផ្លូវការ នូវ ការអនុវត្ត ការស្រង់ វត្តមាន តាមរយៈ ប្រព័ន្ធ ឌីជីថល ទំនើប គ្រប់ អង្គភាព ចំណុះ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត កោះកុង ។
កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពីសំណាក់ លោក នាយ រង សេនាធិការ លោក ប្រធាន អនុប្រធាន មន្ទីរ លោក នាយ នាយ រង ការិយាល័យ លោក មេបញ្ជការ មូលដ្ឋាន ក្រុង ស្រុក ស្នាក់ការសន្តិសុខ និង ក្រុម ជំនួយការ ។
ការស្រង់ វត្តមាន យោធិន មក ធ្វើការ តាមរយៈ ប្រព័ន្ធ ឌីជីថល ទំនើប នេះ គឺ សបញ្ជាក់ ឲ្យ ឃើញ ពី កំរិត សមត្ថភាព ផ្នែក បច្ចេកវិទ្យា របស់ យោធិន នៃ កងរាជអាវុធហត្ថ ខេត្ត កោះកុង គឺ ដើរ ទៅ ទាន់ សម័យកាល សង្គម ដែល ជា សម័យកាល បច្ចេកវិទ្យា ។
( ភ្នំពេញ ) ៖ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ នឹង ចាប់ផ្តើម ដាក់ ដំណើរការ សាកល្បង រោងចក្រ ផលិតកម្ម ទឹក ស្អាត បាក់ ខែង ជំហាន ទី១ នៅ យប់ ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។ នេះ យើង យោង តាម សេចក្តី ជូនដំណឹង របស់ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ នៅ ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ បាន បញ្ជាក់ ថា ក្នុង ការដាក់ ដំណើរការ សាកល្បង នេះ រដ្ឋាករ ទឹក នឹង បញ្ជូន ទឹក ស្អាត ទៅ ផ្គត់ផ្គង់ នៅ តំបន់ ខណ្ឌ ជ្រោយ ចង្វារ ហើយ ការណ៍ នេះ អាច នាំឱ្យ គុណភាព ទឹក មាន ភាពល្អក់កករ កើតឡើង មួយ រយៈពេល ខ្លី ។
លោក សោម សុវណ្ណ ប្រធាន នាយកដ្ឋាន អាជីវកម្ម នៃ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ បាន ឱ្យដឹង ថា នេះ គឺជា ការធ្វើតេស្ត សាកល្បង ដើម្បី បញ្ចូល ទឹក ទៅក្នុង បំពង់ នៅ តំបន់ ជុំវិញ ព្រែក លាប ហើយ នៅ អំឡុង ថ្ងៃទី ២៨ ដល់ ថ្ងៃទី ២៩ ខែមេសា រដ្ឋាករ ទឹក នឹង ចាប់ផ្តើម ធ្វើតេស្ត សាកល្បង បញ្ជូន ទឹក ឆ្លង ទៅ តំបន់ ត្រើយ ខាងលិច នៃ ទន្លេ មុននឹង ឈាន ដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ នៅ ដើម ខែឧសភា ឆ្នាំ ២០២៣ ។
លោក ឡុង ណារ៉ូ អគ្គ នាយក រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ ធ្លាប់ បាន ឱ្យដឹង ថា បន្ទាប់ពី ការដាក់ ដំណើរការ នូវ រោងចក្រ ផលិតកម្ម ទឹក ស្អាត បាក់ ខែង ជំហាន ទី១ នឹង អាច ផ្គត់ផ្គង់ ទឹក បាន គ្រប់គ្រាន់ ចំពោះ បណ្តាញ ដែល បាន ភ្ជាប់ រួច ។
សូម ជម្រាប ថា គម្រោង រោងចក្រ ប្រព្រឹត្តិកម្ម ទឹក ស្អាត បាក់ ខែង ជំហ៊ាន ទី១ មាន សមត្ថភាព ផលិត ទឹក ស្អាត បាន មួយ ថ្ងៃ ១៩៥០០០ ម៉ែត្រ គូប ។
អគ្គ នាយក រង នៃ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល ដែល ដក កាំភ្លើង បើក ឡាន តាម ភ្ជង់ យុវជន ម្នាក់ ត្រូវ កម្លាំង នគរបាល ចាប់ខ្លួន បាន ហើយ
( ភ្នំពេញ ) ៖ បុគ្គល ឈ្មោះ បែល វ៉ាន់ ដែត អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន រដ្ឋបាល និង កិច្ចការ ទូទៅ នៃ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល ដែល បាន ដក កាំភ្លើង ភ្ជង់ អ្នកដទៃ នោះ ត្រូវបាន កម្លាំង នគរបាល រួម ដៃ គ្នា ស្រាវជ្រាវ ឈានដល់ ការចាប់ខ្លួន បាន ហើយ នៅ ព្រឹក ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
ប្រតិបត្តិការ ចាប់ខ្លួន នេះ ធ្វើឡើង ដោយ កម្លាំង នាយកដ្ឋាន កណ្ដាល សន្ដិសុខ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ . ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ និង អធិការដ្ឋាន នគរបាល ខណ្ឌ ឫស្សីកែវ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ទោ ប៊ុន សុសិក្ខា ស្នងការ រង ទទួល ផែន សន្តិសុខ ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ វិនិយោគ កម្ពុជា បាន បរិច្ចាគ ថវិកា ចំនួន ៤ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
គណៈកម្មាធិការ វិនិយោគ កម្ពុជា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ គ្រប់ លំដាប់ថ្នាក់ នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បរិច្ចាគ ថវិកា ៥ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ គ្រប់ លំដាប់ថ្នាក់ នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន បរិច្ចាគ ថវិកា ចំនួន ៥ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ គ្រប់ លំដាប់ថ្នាក់ នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង បាន បរិច្ចាគ ថវិកា ចំនួន ២ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ សាកលវិទ្យាល័យ ភូមិន្ទ នីតិសាស្ត្រ និង វិទ្យាសាស្ត្រ សេដ្ឋកិច្ច បាន បរិច្ចាគ ថវិកា ចំនួន ២៥.០០០ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
សាកលវិទ្យាល័យ ភូមិន្ទ នីតិសាស្ត្រ និង វិទ្យាសាស្ត្រ សេដ្ឋកិច្ច តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ និង លោកជំទាវ បរិច្ចាគ ថវិកា ៥ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
លោក ឧកញ៉ា អ៉ឹង ប៊ុន ហូវ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម នូវ សុខសម្បត្តិ និង លោកជំទាវ អ៊ុយ ស្រី ល័ក្ខ បរិច្ចាគ ថវិកា ៤លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្ដម នូវ សុខសម្បត្តិ និង លោកជំទាវ អ៊ុយ ស្រី ល័ក្ខ បាន បរិច្ចាគ ថវិកា ចំនួន ៤លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម នូវ សុខសម្បត្តិ និង លោកជំទាវ អ៊ុយ ស្រី ល័ក្ខ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម កិត្តិនីតិកោសល បណ្ឌិត ឌិត មុន្ទី បរិច្ចាគ ថវិកា ១០លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្ដម កិត្តិនីតិកោសល បណ្ឌិត ឌិត មុន្ទី ប្រធាន តុលាការ កំពូល បាន បរិច្ចាគ ថវិកា ចំនួន ១០លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម កិត្តិនីតិកោសល បណ្ឌិត តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឧកញ៉ា ង៉ូវ សារិន ហាង លក់ មាស គួង ហុង និង លោកជំទាវ បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឧកញ៉ា ង៉ូវ សារិន ហាង លក់ មាស គួង ហុង និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឧកញ៉ា ង៉ូវ សារិន ហាង លក់ មាស គួង ហុង និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ស្ថាប័ន សេនធ័រ អហ្វហ្វ្រេន ស៊ីប គ្លីនីក បរិច្ចាគ ថវិកា ២០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ស្ថាប័ន សេនធ័រ អហ្វហ្វ្រេន ស៊ីប គ្លីនីក បាន បរិច្ចាគ ថវិកា ចំនួន ២០ លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ស្ថាប័ន សេនធ័រ អហ្វហ្វ្រេន ស៊ីប គ្លីនីក តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្ដម យឹម ណុល ឡា ទេសរដ្ឋមន្ត្រី ប្រធាន ក្រុមប្រឹក្សា សេដ្ឋកិច្ច សង្គមកិច្ច និង វប្បធម៌ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម យឹម ណុល ឡា និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សាកលវិទ្យាល័យ វិទ្យាសាស្ត្រ សុខាភិបាល បរិច្ចាគ ថវិកា ២០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ សាកលវិទ្យាល័យ វិទ្យាសាស្ត្រ សុខាភិបាល បាន បរិច្ចាគ ថវិកា ចំនួន ២០ លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
សាកលវិទ្យាល័យ វិទ្យាសាស្ត្រ សុខាភិបាល តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ បរិច្ចាគ ថវិកា ៤០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ បាន បរិច្ចាគ ថវិកា ចំនួន ៤០ លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អភិបាល ខេត្ត បន្ទាយមានជ័យ ជូនដំណើរ អាវុធហត្ថ ទើប ជ្រើសរើស ថ្មី ចំនួន ៥៣ នាក់ ចូលទៅ ហ្វឹកហ្វឺន នៅ មជ្ឈមណ្ឌល ហ្វឹកហ្វឺន កងរាជអាវុធហត្ថ ភ្នំ ជុំ រីករាយ
( បន្ទាយមានជ័យ )៖ លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ នៅ ព្រឹក ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សំណេះសំណាល និង ជូន ដំណើរ យោធិន នៃ កងរាជអាវុធហត្ថ ទើប ជ្រើសរើស ថ្មី ដែល ជាប់ ជាស្ថាពរ ចំនួន ៥៣ នាក់ ចូល ហ្វឹកហ្វឺន នៅ មជ្ឈមណ្ឌល ហ្វឹកហ្វឺន កងរាជអាវុធហត្ថ ភ្នំ ជុំ រីករាយ ស្ថិត ក្នុង ភូមិសាស្រ្ត ខេត្ត កំពង់ឆ្នាំង ។
លោក ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត បាន ឧបត្ថម្ភ យោធិន នៃ កងរាជអាវុធហត្ថ ដែល ទើប ជ្រើសរើស ថ្មី ( ជាប់ ជាស្ថាពរ ) ទាំង ៥៣ នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន មី ២កេស . ត្រីខ ២យួរ . ខោអាវ កីឡា ២ឈុត . កន្សែង មួយ និង ថវិកា ចំនួន ៣០ ម៉ឺន រៀល ៕
( ភ្នំពេញ ) ៖ ឯកឧត្ដម សុខ ផេង រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម សុខ ផេង និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
រុស្ស៉ី បាន និយាយ ម្តង ហើយ ម្តង ទៀត ថា នឹង មិន បន្ត កិច្ចព្រមព្រៀង នេះ ឲ្យ លើស ពី ថ្ងៃទី ១៨ ខែឧសភា នោះ ទេ លុះត្រាតែ លោក ខាងលិច យល់ព្រម ដក ការរឹតបន្តឹង មួយចំនួន លើ ការទូទាត់ ការដឹកជញ្ជូន និង ការធានារ៉ាប់រង ដែល កំពុង រារាំង ដល់ ការនាំចេញ កសិផល របស់ ខ្លួន ។ អំឡុង ពេល បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ ប្រទេស គុយ បា លោក ឡារ៉ូវ បាន ប្រាប់ ក្រុម អ្នកយកព័ត៌មាន ក្នុង ទីក្រុង ឡាហា វ៉ាន យ៉ាង ដូច្នេះ ថា « តាមពិត ទៅ គ្មាន អ្វី ដែល ត្រូវបាន ធ្វើឡើង នោះ ទេ » ។
គួរ បញ្ជាក់ ថា ការត្រួតពិនិត្យ កប៉ាល់ ដឹក គ្រាប់ ធញ្ញជាតិ អ៊ុយក្រែន ចេញ ពី សមុទ្រ ខ្មៅ បាន ចាប់ផ្តើម ឡើងវិញ នៅ ថ្ងៃពុធ សប្តាហ៍ នេះ ក្រោម កិច្ចព្រមព្រៀង គ្រាប់ ធញ្ញជាតិ ដែល សម្របសម្រួល ដោយ អង្គការ សហ ប្រជាជាតិ កាលពី ខែកក្កដា ឆ្នាំ មុន ៥ខែ បន្ទាប់ពី មាន ការឈ្លានពាន របស់ រុស្ស៉ី លើ អ៊ុយក្រែន ៕
សម្តេច តេជោ ហ៊ុន សែន ផ្តល់ កិច្ចសម្ភាសន៍ ជាមួយ លោក លឹម ជា វុត្ថា អគ្គ នាយក បណ្តាញ ព័ត៌មាន Fresh News ដោយ មានប្រសាសន៍ ថា « សូមស្វាគមន៍ ចំពោះ លោក យឹម ស៊ីណន សម្រាប់ ការចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា តាម ការស្នើសុំ របស់ លោក ហើយ សង្ឃឹម ថា លោក ស៊ីណន នឹង ក្លាយជា ធនធាន មនុស្ស របស់ គណបក្ស ប្រជាជន កម្ពុជា ដ៏ មាន តម្លៃ » ។
ការប្រកាស ស្វាគមន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន ធ្វើឡើង បន្ទាប់ពី លោក យឹម សុណន នៅ ព្រឹក ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន សរសេរ រៀបរាប់ អំពី ការឈឺចាប់ ជា ទីបំផុត ចំពោះ ទង្វើ របស់ ក្រុម ប្រឆាំង និង គោរព ស្នើសុំ សម្តេច តេជោ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
សំណេរ ដ៏ ឈឺចាប់ របស់ លោក យឹម ស៊ីណន បាន រៀបរាប់ ជាមួយ ខ្លឹមសារ យ៉ាង ដូច្នេះ ថា៖
« ប្រសិន និយាយ ពី ការចូលរួម ក្នុង នយោបាយ បក្ស ប្រឆាំង របស់ ខ្ញុំ អស់ រយៈពេល ជាង ១២ ឆ្នាំ មក នេះ ក្នុង នាម ជា មេដឹកនាំ ម្នាក់ ក្នុង ចលនា យុវជន នៅ កូរ៉េ ខាងត្បូង ខ្ញុំ អាច ជា មនុស្ស ម្នាក់ ក្នុង ចំណោម មនុស្ស រាប់ ពាន់ ឬ រាប់ ម៉ឺន នាក់ ឯទៀត ដែល តែងតែ កាន់ រូបថត បដា និង ស្រែក ថ្កោល ទោស ឬ ទាមទារ ឲ្យ ដោះលែង នូវ ជនរងគ្រោះ មាន ដូចជា អ្នកសារព័ត៌មាន សហជីព សង្គម ស៉ីវិល នានា និង ជាពិសេស គឺ ក្រុម អ្នកនយោបាយ នៃ បក្ស ប្រឆាំង ក្នុង នោះ គឺ មេដឹកនាំ និង សមាជិក នៃ បក្ស ភ្លើង ទៀន បច្ចុប្បន្ន នេះ ឯង ។
ក្រៅពី បង្ហាញ ការឈឺចាប់ ឥត ឧបមា លោក យឹម ស៊ីណន បាន ប្រកាស គោរព ស្នើសុំ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា នាយក រដ្ឋមន្រ្តី ដើម្បី សូម ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក យឹម ស៊ីណន បាន រៀបរាប់ តាមរយៈ សំណេរ របស់ លោក មាន ខ្លឹមសារ ទាំង ស្រុង៖
សម្តេច តេជោ ហ៊ុន សែន ជាទីគោរព រូប ខ្ញុំ ពិតជា ស្រឡាញ់ និង ចង់ ឃើញ កម្ពុជា មាន ប្រពន្ធ័ ប្រជាធិបតេយ្យ រឹងមាំ ពិត មួយ តាម បែបផែន កម្ពុជា ស្រប តាម រដ្ឋធម្មនុញ្ញ ដែល បាន កំណត់ ។ ប៉ុន្តែ ខ្ញុំ ពិតជា មិន ចង់ ឃើញ ឡើយ បក្ស ឬ ក្រុម អ្នកនយោបាយ ប្រជាធិបតេយ្យ ក្លែងក្លាយ មាន ឱកាស មក ដឹកនាំ កម្ពុជា នោះ ទេ ។ ដូច្នេះ ខ្ញុំ យល់ឃើញ ថា ការប្តេជ្ញាចិត្ត ចូលរួម ការពារ សន្តិភាព ស្ថេរភាព និង ទប់ស្កាត់ នូវ ការ ប៉ុនប៉ង បំផ្លាញ នូវ សន្តិភាព គឺជា កាតព្វកិច្ច របស់ ខ្ញុំ ក៏ ដូចជា ពលរដ្ឋ ខ្មែរ គ្រប់ រូប ។
លោក យឹម ស៊ីណន បង្ហាញ ការឈឺចាប់ ជា ទីបំផុត ចំពោះ ទង្វើ របស់ ក្រុម ប្រឆាំង និង គោរព ស្នើសុំ សម្តេច តេជោ ហ៊ុន សែន ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា សូម ជូនពរ ឆ្នាំ ថ្មី និង សូមឲ្យ មាន សិរី សួស្តី ដល់ ជន រួម ជាតិ ទាំង ក្នុង និង ក្រៅ ប្រទេស ។ សូម អរគុណ !
យឹម ស៉ីណន សិស្ស និង និស្សិត នៅ ខេត្ត ត្បូងឃ្មុំ ៥៤ នាក់ ចូលរួម វេទិកា ថ្នាក់រៀន ស្តីពី ប្រវត្តិសាស្ត្រ ខ្មែរ ក្រហម និង ធ្វើ ទស្សនកិច្ច សិក្សា ទៅកាន់ តំបន់ ប្រវត្តិសាស្រ្ត យោធា កោះ ថ្ម អ៊ិច - ១៦
( ត្បូងឃ្មុំ ) ៖ មាន សិស្សានុសិស្ស ចំនួន ៥៤ នាក់ មកពី វិទ្យាល័យ ប៊ុន រ៉ានី ហ៊ុន សែន ខ្នារ និង វិទ្យាល័យ ប៊ុន រ៉ានី ហ៊ុន សែន ក្រែក ព្រមទាំង និស្សិត ក្នុង ខេត្ត ត្បូងឃ្មុំ បាន មក ចូលរួម វេទិកា ថ្នាក់រៀន ស្តីពី ប្រវត្តិសាស្ត្រ ខ្មែរ ក្រហម និង បាន ធ្វើ ទស្សនកិច្ច ទៅកាន់ តំបន់ ប្រវត្តិសាស្រ្ត យោធា កោះ ថ្ម អ៊ិច - ១៦ ដែល រៀបចំ ដោយ ក្រុមការងារ មជ្ឈមណ្ឌល ឯកសារ កោះ ថ្ម ។
វេទិកា ថ្នាក់រៀន នេះ ធ្វើឡើង នា ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២៣ ដោយ ផ្តោត សំខាន់ ទៅ លើ ប្រធានបទ « ការជម្លៀស ប្រជាជន ដោយ បង្ខំ និង ការសម្លាប់ យ៉ាង រង្គាល នៅ ទួល ពោធិ៍ ជ្រៃ » ។
លោក ឡុង ដានី បាន ធ្វើ បទបង្ហាញ អំពី ប្រវត្តិសាស្ត្រ ខ្មែរ ក្រហម ( ១៩៧៥ - ១៩៧៩ ) លើ ប្រធានបទ ការជម្លៀស ប្រជាជន ចេញ ពី ទីក្រុង . ការជម្លៀស ដោយ បង្ខំ និង ការសម្លាប់ រង្គាល នៅ ទួល ពោធិ៍ ជ្រៃ ។
( ភ្នំពេញ ) ៖ ឃាតក ដៃ ឆៅ សម្លាប់ កាត់ ក្បាល នារី ម្នាក់ ក្នុង បន្ទប់ ជួល នៅ ក្រុង បាវិត ខេត្ត ស្វាយរៀង ត្រូវបាន កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ សហការ ជាមួយ កម្លាំង នគរបាល ខេត្ត ព្រះវិហារ ស្រាវជ្រាវ ឈានដល់ ការឃាត់ខ្លួន បាន នៅ យប់ ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២៣ ។
ប្រភព ព័ត៌មាន ដដែល បាន បញ្ជាក់ ទៀត ថា មុនពេល សមត្ថកិច្ច ចាប់ខ្លួន ជន ដៃ ដល់ កំពុង សំងំ នៅក្នុង ផ្ទះសំណាក់ មួយ កន្លែង ហើយ បាន លេប ថ្នាំ សម្លាប់ ខ្លួន ។ ក្រោយ ឃាត់ខ្លួន សមត្ថកិច្ច បាន បញ្ជូន ទៅ សង្គ្រោះ នៅ មន្ទីរពេទ្យ បង្អែក ១៦មករា ខេត្ត ព្រះវិហារ ហើយ មិន ទាន់ អាច សួរនាំ បាន ឡើយ ដោយ ស្ថិត ក្នុង ស្ថានភាពសង្គ្រោះ បន្ទាន់ ។
ករណី ឃាតកម្ម នេះ បាន កើតឡើង នៅ ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២៣ នេះ ស្ថ្ថិត ចំណុច បន្ទប់ ជួល ផ្លូវ កំពង់ស្ពាន ក្នុង ភូមិ បាវិត កណ្តាល សង្កាត់ បាវិត ក្រុង បាវិត ខេត្ត ស្វាយរៀង ។
បើ តាម របាយការណ៍ របស់ សមត្ថកិច្ច បាន ឱ្យដឹង ថា សាកសព ជនរងគ្រោះ មាន ឈ្មោះ ម៉ន ស្រី ម៉ី អាយុ ២៤ ឆ្នាំ មុខរបរ បុគ្គលិក កាស៊ីណូ DYNASTY មាន ស្រុក កំណើត នៅ ភូមិ កណ្តាល ក្រោម ឃុំ បន្ទាយ ដែក ស្រុក កៀនស្វាយ ខេត្ត កណ្តាល ទីលំនៅ បច្ចុប្បន្ន ស្នាក់ នៅ បន្ទប់ ជួល ភូមិ បាវិត កណ្តាល សង្កាត់ បាវិត ក្រុង បាវិត ខេត្ត ស្វាយរៀង ៕
( ភ្នំពេញ ) ៖ ឯកឧត្ដម អ៊ុក ដាមរី និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ១ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម អ៊ុក ដាមរី និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
យោង តាម ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ឱ្យដឹង ថា ពិធី បើក ការដ្ឋាន សាងសង់ ផ្លូវ លឿន ទី២ នៅ កម្ពុជា នឹង ធ្វើឡើង ក្រោម អធិបតីភាព របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ឱ្យដឹង ថា ផ្លូវ ល្បឿន លឿន នេះ មាន ចម្ងាយ ប្រមាណ ១៣៨ គីឡូម៉ែត្រ និង ត្រូវ ធ្វើ ស្ពាន ឆ្លង ទន្លេ មេគង្គ ដ៏ វែង មួយ ឆ្លង ទន្លេ មេគង្គ ។ គិត ទាំង ស្ពាន និង ផ្លូវ តភ្ជាប់ មាន ប្រវែង ប្រហែល ៥គីឡូម៉ែត្រ ។
លោក ទេសរដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា ថវិកា ដែល គ្រោង បណ្តាក់ទុក ប្រមាណ ១.៦៣៨ លាន ដុល្លារ ដែល មាន ទំហំ តិច ជាង ក្រុង ព្រះសីហនុ តែ ប្រវែង ផ្លូវ ក៏ ខ្លី ជាង ផ្លូវ ល្បឿន លឿន ក្រុង ព្រះសីហនុ ផងដែរ ។ បើ តាម លោក ទេសរដ្ឋមន្ត្រី ផ្លូវ នេះ គ្រោង បញ្ចប់ នៅ ចុង ឆ្នាំ ២០២៦ ឬ ដើម ឆ្នាំ ២០២៧ ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ផ្លូវ ល្បឿន លឿន នេះ មាន សារៈសំខាន់ ណាស់ ក្នុង ការតភ្ជាប់ ពី ប្រទេស ចិន មក ភូមា មក ថៃ មក កម្ពុជា និង ភ្ជាប់ ទៅ ប្រទេស វៀតណាម ៕
ឯកឧត្ដម សុខុម ភគ វន្ត មុនី បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្ដម សុខុម ភគ វន្ត មុនី រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ២ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម សុខុម ភគ វន្ត មុនី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
