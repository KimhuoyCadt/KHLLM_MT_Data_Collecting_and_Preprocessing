( ភ្នំពេញ ) ៖ ឧកញ៉ា ថៃ ជា ហួត បាន បរិច្ចាគ ថវិកា ចំនួន ១៥ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឧកញ៉ា ថៃ ជា ហួត តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ៥០ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា លី ហួរ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ៣ម៉ឺន ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
អ្នក ឧកញ៉ា លី ហួរ និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គ្រួសារ ក្រីក្រ ៤គ្រួសារ ដែល ជា និវត្ត ជន នៃ មន្ទីរ សាធារណការ ខេត្ត ព្រៃវែង ទទួល អំណោយ ពី ថ្នាក់ដឹកនាំ ខេត្ត
( ព្រៃវែង ) ៖ គ្រួសារ ក្រីក្រ ចំនួន ៤គ្រួសារ ដែល ជា និវត្ត ជន នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រៃវែង ទទួល អំណោយ មនុស្សធម៌ មាន ជា គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា មួយ ចំនួន ពី ថ្នាក់ដឹកនាំ ខេត្ត តាមរយៈ លោក ឈាង សុវណ្ណារ៉ា អភិបាល រង ខេត្ត ព្រៃវែង រួម ជាមួយនឹង លោក ម៉មនី បណ្ឌិត អភិបាល ក្រុង ព្រៃវែង ។
លោក ឈាង សុវណ្ណារ៉ា បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ និង សេចក្តីនឹករលឹក ពី ថ្នាក់ដឹកនាំ ខេត្ត ដែល មាន លោក ជា សុមេធី អភិបាល ខេត្ត ព្រៃវែង ដែល លោក តែងតែ គិតគូរ យកចិត្តទុកដាក់ ដល់ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេសៈ ទោះ ស្ថិត នៅក្នុង ស្ថានភាព បែប ណា ក៏ដោយ ។
លោក អភិបាល រង ខេត្ត ក៏ បាន បន្ថែម ទៀត ថា សម្ភារៈ និង ថវិកា ទាំងអស់ នេះ ទោះបីជា មិន អាច បំពេញ តម្រូវការ ដល់ ប្រជាពលរដ្ឋ យូរអង្វែង ក៏ ពិត មែន ក៏ប៉ុន្តែ វា អាច ជួយ សម្រាល ទុក្ខលំបាក ដល់ ពលរដ្ឋ បាន មួយ គ្រា នោះ ផងដែរ ។
ជាមួយគ្នា នេះ លោក អភិបាល រង ខេត្ត ក៏ បាន ផ្តាំផ្ញើ ដល់ គ្រួសារ ចូលនិវត្តន៍ នៃ មន្ទីរ សាធារណការ ត្រូវ ខិតខំ យកចិត្តទុកដាក់ ថែទាំ សុខភាព ដោយ ខ្លួន ឯង និង ត្រូវ រស់ នៅ ស្អាត ហូប ស្អាត ផឹក ស្អាត ឲ្យបាន ជាប់ ជាប្រចាំ ដើម្បី សុខភាព របស់ ខ្លួន ឲ្យ រឹងមាំ ។
គួរ បញ្ជាក់ ថា កាលពី ល្ងាច ថ្ងៃចន្ទ សប្តាហ៍ នេះ លោក ព្រីហ្គោ ហ្ស៉ីន បាន អះអាង ពី ទិន្នន័យ បឋម បង្ហាញ ថា មាន ការអនុញ្ញាតឲ្យ កងទ័ព របស់ លោក ទទួលបាន គ្រាប់ រំសេវ ហើយ ប៉ុន្តែ ព្រមាន ថា ពួកគេ មិន « ឃើញ មាន ការអនុវត្ត តាម បទបញ្ជា » នៅឡើយ ទេ ៕
លោក Chiu Kuo-cheng បាន ឲ្យដឹង ថា ទីក្រុង វ៉ាស៊ីនតោន បាន និង កំពុង ពិភាក្សា អំពី កញ្ចប់ អាវុធ ជាមួយ ទីក្រុង តៃ ប៉ិ។ រដ្ឋមន្ត្រី ការពារ ជាតិ រូប នេះ បាន គូសបញ្ជាក់ ប្រាប់ សមាជិក សភា តៃវ៉ាន់ នៅពេល ត្រូវបាន សាកសួរ អំពី កញ្ចប់ ជំនួយ យោធា យ៉ាង ដូច្នេះ ថា « ការប្រើប្រាស់ កញ្ចប់ ថវិកា ចំនួន ៥០០ លាន ដុល្លារ អាមេរិក ខាងលើ នេះ គឺ សំដៅ ផ្តល់ឲ្យ យើង នូវ អាទិភាព ក្នុង ការទទួលបាន ទំនិញ ភ្លាម ៗ ករណី មាន ការពន្យារ ពេល ឬ ការដឹកជញ្ជូន មាន ភាពយឺតយ៉ាវ ណាមួយ ក្នុង ដំណើរការទិញ អាវុធ » ។
លោក បាន បន្ថែម ថា « វា គួរតែ ត្រូវបាន អនុវត្ត នៅ ឆ្នាំ ២០២៣ ដោយ កញ្ចប់ ថវិកា ៥០០ លាន ដុល្លារ នេះ មិន ត្រូវបាន រាប់បញ្ចូល ក្នុង ការលក់ អាវុធ ពីមុន នោះ ទេ ហើយ ថា តៃវ៉ាន់ នឹង ស្នើសុំ សភា ជាមុន ក្នុង គោលដៅ អាទិភាព របស់ ខ្លួន » ។ យ៉ាង នេះ ក្តី លោក ឈូ មិន បាន បញ្ជាក់ លម្អិត អំពី ប្រភេទ អាវុធ ក្នុង កញ្ចប់ យោធា ថ្មី នេះ ទេ ដោយ គ្រាន់តែ និយាយ ថា ព័ត៌មាន លម្អិត នឹង ត្រូវ បញ្ជាក់ ដោយ ភាគី ទាំង ពីរ ក្នុង ពេល ឆាប់ ៗ នេះ ។
គួរ បញ្ជាក់ ថា សហរដ្ឋ អាមេរិក គឺ អ្នកផ្គត់ផ្គង់ អាវុធ ដ៏ ចម្បង របស់ តៃវ៉ាន់ ប៉ុន្តែ ការសម្រេច នៅក្នុង ខែកញ្ញា ឆ្នាំ ២០២២ បាន ឈាន ទៅ មុខ មួយ ជំហាន ទៀត ពោលគឺ ធ្វើឲ្យ ការផ្តល់ ជំនួយ ផ្នែក សន្តិសុខ របស់ សហរដ្ឋ អាមេរិក សម្រាប់ តៃវ៉ាន់ កើនឡើង ដល់ ៤.៥ពាន់ លាន ដុល្លារ ត្រឹម ក្នុង រយៈពេល ៤ឆ្នាំ ៕ អភិបាល រង ខេត្ត ស្វាយរៀង៖ ព្រះវិហារ និង សមិទ្ធផល នានា នៅ វត្ត ក្រសាំង ជ្រំ ក្រុង ស្វាយរៀង បញ្ចុះ ខណ្ឌ សីមា និង ឆ្លង នា ពេលនេះ កើត ចេញពី តម្លៃ នៃ សុខ សន្តិភាព
ការថ្លែង បែប នេះ របស់ អភិបាល រង ខេត្ត ស្វាយរៀង ខណៈ ដែល លោក តំណាង លោក ម៉ែន វិបុល អភិបាល ខេត្ត ចូលរួម កាត់ ឫស សីមា និង ឆ្លង សមិទ្ធផល នានា នៅ វត្ត ក្រសាំង ជ្រំ ស្ថិត នៅក្នុង សង្កាត់ សង្ឃ័ រ ក្រុង ស្វាយរៀង ខេត្ត ស្វាយរៀង នា ព្រឹក ថ្ងៃទី ៩ ខែឧសភា ឆ្នាំ ២០២៣ ។
លោក ប៉េង ពោធិ៍សា បាន ផ្តាំផ្ញើ ការសួរសុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ខេត្ត ស្វាយរៀង និង លោក ម៉ែន វិបុល អភិបាល ខេត្ត ដែល ជានិច្ចកាល តែងតែ គិតគូរ អំពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ នៅ ខេត្ត ស្វាយរៀង ហើយ បាន ដោះស្រាយ នូវ ទុក្ខលំបាក នានា ជូន ប្រជាពលរដ្ឋ បាន ទាន់ ពេលវេលា ផងដែរ ។
លោក អភិបាល រង ខេត្ត ក៏ បាន ថ្លែងអំណរគុណ ដល់ សប្បុរ ជន ជិត ឆ្ងាយ ដែល បាន ចូលរួម ដោយ ទឹកចិត្ត កសាង ព្រះវិហារ និង សមិទ្ធផល នានា នៅ វត្ត ក្រសាំង ជ្រំ ក្រុង ស្វាយរៀង ឱ្យ លេច ជា សមិទ្ធផល រួច រាល់ ជា ស្ថាពរ ហើយ រៀបចំ ពិធី បញ្ចុះ ខណ្ឌ សីមា និង ឆ្លង ដែល មាន ការចូលរួម ពី អាជ្ញាធរ ប្រជាពលរដ្ឋ ជាច្រើន កុះករ ផងដែរ ។
ទីភ្នាក់ងារ សារព័ត៌មាន AP ដោយ ផ្អែក លើ ប្រភព ដែល ខ្លួន ទទួលបាន ពី មន្ត្រី អាមេរិក ម្នាក់ ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ បាន ឱ្យដឹង ទៀត ថា នៅក្រោម កញ្ចប់ ជំនួយ យោធា ថ្មី ខាងលើ អ៊ុយក្រែន នឹង ទទួលបាន គ្រាប់ កាំភ្លើង ធំ ១៥៥ មីលីម៉ែត្រ សម្រាប់ កាំភ្លើង ធំ Howitzer មីស៊ីល ប្រឆាំង យន្ដហោះ ដ្រូន និង មូលនិធិ សម្រាប់ ប្រព័ន្ធ ផ្កាយ រណប រួមទាំង ការបណ្ដុះបណ្ដាល ផងដែរ ។
គួរ បញ្ជាក់ ថា កញ្ចប់ ជំនួយ យោធា ខាងលើ ដែល ត្រូវបាន គេ រំពឹង ថា អាចនឹង ប្រកាស នៅ ថ្ងៃអង្គារ សប្ដាហ៍ នេះ នឹង ត្រូវ យក ចេញ ពី មូលនិធិ ជំនួយ សន្តិសុខ សម្រាប់ អ៊ុយក្រែន ដែល អនុញ្ញាតឱ្យ រដ្ឋបាល លោក ប្រធានាធិបតី ចូ បៃ ដិន ទិញ អាវុធ ពី ឧស្សាហកម្ម អាវុធ អាមេរិក ជាជាង ដក អាវុធ ចេញ ពី ឃ្លាំង ស្ដុក អាវុធ ៕
សម្តេច តេជោ បន្ត ថា នៅពេល សម្តេច គិត អំពី ទ្វីប អឺរ៉ុប សម្តេច មិន ត្រឹមតែ មើលឃើញ អំពី សហគមន៍ នៃ ប្រទេស រដ្ឋ សមាជិក ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ជា ការប្រមូលផ្តុំ នៃ ប្រទេស ជាច្រើន ទៀត ដែល ជា មិត្ត និង ដៃគូ របស់ សហភាព អឺរ៉ុប ផងដែរ ។ ស្ថិត ក្នុង ស្មារតី នេះ ពួកយើង គួរតែ ចងចាំ ផងដែរ ថា ឆ្នាំ ក្រោយ គឺជា ខួប គម្រប់ ៣០ ឆ្នាំ នៃ ការ បង្កើត ទំនាក់ទំនង កម្ពុជា - សហភាព អឺរ៉ុប ។ មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ដ៏ ជិតស្និទ្ធ របស់ យើង ពិតជា ធន់នឹង ការសាកល្បង នៃ ពេលវេលា ក្នុង អំឡុង រយៈពេល បី ទសវត្ស កន្លងទៅ ។
សម្តេច តេជោ សូម ឆ្លៀត យក ឱកាស នេះ សម្តែង នូវ អំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ គណៈកម្មការ អឺរ៉ុប រួម ជាមួយ បណ្តា រដ្ឋ សមាជិក ទាំងអស់ នៃ សហភាព អឺរ៉ុប ចំពោះ ការប្តេជ្ញាចិត្ត ដ៏ យូរអង្វែង ក្នុង ការនាំមក នូវ សន្តិភាព ការបង្រួប បង្រួម ជាតិ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម ប្រកបដោយ ចីរភាព ដល់ ប្រទេស កម្ពុជា ។
នៅ ចុង ឆ្នាំ នេះ កម្ពុជា ទន្ទឹងរង់ ចំា ដល់ ការរៀបចំ កិច្ចប្រជុំ គណៈកម្មាធិការ ចម្រុះ កម្ពុជា - អឺរ៉ុប លើក ទី ១២ ហើយ សម្តេច តេជោ ជឿជាក់ យ៉ាង មុតមាំ ថា ភាគី ទាំង ពីរ នឹង នៅតែ បន្ត ប្តេជ្ញាចិត្ត ដើម្បី ពង្រឹង បន្ថែម ទៀត នូវ ទំនាក់ទំនង ល្អ របស់ យើង ដើម្បី ជា ប្រយោជន៍ ទៅ វិញ ទៅ មក របស់ ប្រជាជន និង ប្រជាជាតិ យើង ។
ជាថ្មី ម្តង ទៀត សម្តេច តេជោ សូម ប្រសិទ្ធព របវរ មហា ប្រសើរ ជូន ចំពោះ លោកជំទាវ ក្នុង ការដឹកនាំ សហភាព អឺរ៉ុប ឆ្ពោះ ទៅកាន់ វិបុលភាព កាន់តែ ប្រសើរឡើង ៕
ឃាត់ខ្លួន ជនសង្ស័យ ជា ជន បទេស និង ជនជាតិ ខ្មែរ សរុប ចំនួន ៦នាក់ ពាក់ព័ន្ធ ករណី ជួញដូរ គ្រឿងញៀន នៅ ខេត្ត កណ្តាល
( ភ្នំពេញ ) ៖ កម្លាំង ជំនាញ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន បាន បើក ប្រតិបត្តិការ បង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀន នៅ ចំណុច ហាង ខារ៉ាអូខេ មួយ កន្លែង ក្នុង ភូមិ ព្រែក ស៉ឹង ឃុំ សំពៅ ពូន ស្រុក កោះ ធំ ខេត្ត កណ្តាល ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ជា ជនជាតិ ខ្មែរ . ម៉ាឡេស៉ី . ឥណ្ឌូនេស៉ី និង វៀតណាម សរុប ចំនួន ៦នាក់ ដកហូត ថ្នាំ ញៀន មួយចំនួន ។
បើ តាម របាយការណ៍ របស់ គណៈកម្មការ ទី៣ នៃ យុទ្ធនាការ ប្រឆាំង បទល្មើស គ្រឿងញៀន រយៈពេល ៤ខែ ឆ្នាំ ២០២៣ នេះ កម្លាំង សមត្ថកិច្ច បង្ក្រាប បទល្មើស គ្រឿងញៀន បាន ចំនួន ២៣៤៥ ករណី ឃាត់ខ្លួន មនុស្ស ៥៥៧២ នាក់ រឹបអូស ថ្នាំ ញៀន បាន ជាង ៣៦១ គីឡូក្រាម ៕
បណ្ឌិត ហ៊ុន ម៉ាណែត ជួប សំណេះសំណាល ជាមួយ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ និង សង្កាត់ ក្នុង រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត សមាជិក គណៈ អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា . ប្រធាន យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្ដាល និង ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន រាជធានី ភ្នំពេញ នា រសៀល ថ្ងៃទី ៨ ខែឧសភា ឆ្នាំ ២០២៣ បាន អញ្ជើញ សំណេះសំណាល ជាមួយ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ ទាំង ១៤ និង គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា សង្កាត់ ទាំង ១០៥ ក្នុង រាជធានី ភ្នំពេញ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន រាជធានី ភ្នំពេញ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក បណ្ឌិត បាន ធ្វើ ការវាយតម្លៃ ខ្ពស់ និង ការអរគុណ ជូន ចំពោះ ថ្នាក់ដឹកនាំ សមាជិក - សមាជិកា គណៈកម្មាធិការ គណបក្ស ខណ្ឌ និង សង្កាត់ ទាំងអស់ ក្នុង រាជធានី ភ្នំពេញ ដែល បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការបម្រើ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ជាប់ ជាប្រចាំ ជាពិសេស ក្នុង អំទ្បុង ពេល ដែល រាជធានី ភ្នំពេញ រង នូវ ការរាតត្បាត ដោយ ជំងឺ កូវីដ - ១៩ ដែល នេះ គឺជា ការផ្សារ ភ្ជាប់ យ៉ាង ជាក់ស្តែង មួយ រវាង ប្រជាពលរដ្ឋ ជា ម្ចាស់ ប្រទេស និង មន្ត្រី ជា អ្នកបម្រើ ប្រជាជន ។
ទន្ទឹម គ្នា នេះ លោក បណ្ឌិត ក៏ បាន សម្តែង នូវ ការកោតស សើរ ចំពោះ ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា គណៈកម្មាធិការ គណបក្ស រាជធានី និង អង្គការ ចាត់តាំង ចំណុះ គ្រប់ លំដាប់ថ្នាក់ ដែល បាន ចូលរួមចំណែក បំពេញ ភារកិច្ច យ៉ាង សស្រាក់សស្រាំ ក្នុង ការរៀបចំ ព្រឹត្តិការណ៍ ស៊ីហ្គេម លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ រហូត ព្រឹត្តិការណ៍ ជា ប្រវត្តិសាស្ត្រ នេះ បាន ដំណើរការ កម្មវិធី បើក ដោយ ជោគជ័យ និង កំពុង បន្ត ដំណើរការ ទៅ មុខ ដោយ រលូន តាម ការគ្រោងទុក ។
( ឥណ្ឌូណេស៊ី ) ៖ លោក បណ្ឌិត កៅ គឹម ហួន អគ្គ លេខាធិការ អាស៊ាន នៅ ថ្ងៃទី ៩ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន ចូលរួម ក្នុង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន នៅ ទីក្រុង ឡាប៊ួន បាចូ សាធារណរដ្ឋ ឥណ្ឌូណេស៊ី ។
កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន នេះ ជា កិច្ចប្រជុំ មួយ នៃ កិច្ចប្រជុំ ជា បន្តបន្ទាប់ ឆ្ពោះទៅ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤២ បាន ពិភាក្សា អំពី វឌ្ឍនភាព នៅក្នុង ដំណើរការ កសាង សហគមន៍ អាស៊ាន ក៏ ដូចជា ការវិវត្តន៍ ថ្មី ៗ នៅក្នុង អាស៊ាន ៕
លោក បាន លើកឡើង ថា នៅក្នុង កិច្ចប្រជុំ កំពូល នេះ អាស៊ាន នឹង ពិនិត្យ ជុំវិញ សមិទ្ធផល ដែល អាស៊ាន សម្រេចបាន នា ពេល កន្លងមក និង ការងារ ទំនាក់ទំនង ជាមួយនឹង ប្រទេស ខាងក្រៅ ក្នុង ពេល ដែល សភាពការណ៍ ក្នុង តំបន់ និង ពិភពលោក មាន ការប្រែប្រួល ច្រើន ការប្រកួតប្រជែង ភូមិសាស្ត្រ នយោបាយ ជម្លោះ សមុទ្រ ចិន ខាងត្បូង បញ្ហា មីយ៉ាន់ម៉ា ជាពិសេស សង្គ្រាម រុស្ស៉ី - អ៊ុយក្រែន ដែល ធ្វើឱ្យ ប៉ះពាល់ សេដ្ឋកិច្ច ជា សកល ។
បន្ទាប់ពី កិច្ចប្រជុំ ពេញ អង្គ សម្តេច នឹង ដឹកនាំ គណៈប្រតិភូ ចូលរួម កិច្ចប្រជុំ នានា មាន ដូចជា កិច្ចប្រជុំ ជាមួយ អន្តរសភា អាស៊ាន ( អាយ ប៉ា ) ជាមួយ យុវជន អាស៊ាន និង កិច្ចប្រជុំ ជាមួយនឹង ស្ថាប័ន មួយចំនួន ទៀត ។
ថ្នាក់ដឹកនាំ អាស៊ាន ក៏ នឹង ពិភាក្សា លើ បញ្ហា ក្នុង តំបន់ និង អន្តរជាតិ ដែល ជា ក្តីបារម្ភ និង ផល ប្រយោជន៍ រួម រួមទាំង ការអនុវត្ត លើ ការព្រមព្រៀង ជា ឯកច្ឆន្ទ ប្រាំ ចំណុច ស្តីពី មីយ៉ាន់ម៉ា និង សេចក្តី សម្រេច របស់ មេដឹកនាំ អាស៊ាន និង ការអនុវត្ត លើ ទស្សនវិស័យ របស់ អាស៊ាន ស្តីពី ឥណ្ឌូ - ប៉ាស៊ីហ្វិក ផងដែរ ។
គម្រោង នេះ ទទួលបាន មូលនិធិ ពី កម្មវិធី កសិកម្ម និង សន្តិសុខ ស្បៀង សកល ចំនួន ១. ៧៩ លាន ដុល្លារ និង ពី CACC ចំនួន ១.១លាន ដុល្លារ ក្នុង គោលបំណង លើកកម្ពស់ ភាពធន់ និង ជីវភាព របស់ កសិករ ខ្នាត តូច តាមរយៈ កសិកម្ម សរីរាង្គ និង លទ្ធភាព ចូល ទៅកាន់ ទីផ្សារ ។
គម្រោង នេះ ក៏ មាន បំណង លើកកម្ពស់ អាហារូបត្ថម្ភ និង សមភាព យេនឌ័រ ផងដែរ តាមរយៈ វិធីសាស្រ្ត ផ្លាស់ប្តូរ ឥរិយាបថ សង្គម ដែល ត្រូវបាន រៀបចំឡើង ដើម្បី ជំរុញ ឲ្យ មាន តម្រូវការ របប អាហារ សុខភាព និង ទប់ទល់ ជាមួយ ទម្លាប់ សង្គម ដែល បង្ក គ្រោះថ្នាក់ ។
លោកស្រី គ្លែរ កូណាន់ អ្នកតំណាង របស់ WFP ប្រចាំ នៅ កម្ពុជា បាន ថ្លែង ថា « គម្រោង នេះ ត្រូវបាន គ្រោង រៀបចំឡើង ក្នុង បរិបទ កូវីដ - ១៩ ដោយ ប្រើ វិធីសាស្រ្ត ច្នៃប្រឌិត ដែល កសាង ភាពជាដៃគូរ វាង វិស័យ សាធារណៈ វិស័យ ឯកជន និង អ្នកផលិត ដោយ ផ្ដោត ជា សំខាន់ន លើ ភាពចាំបាច់ ក្នុង ការទាញ ប្រយោជន៍ ពី ការបណ្ដាក់ទុន លើ វិស័យ ឯកជន ពង្រឹង កិច្ចសន្ទនា ផ្នែក គោល នយោបាយ ធានា នូវ ចំណេះដឹង ចាំបាច់ និង គាំទ្រ ដល់ ការអភិវឌ្ឍ ដែល គិតគូរ ដល់ បរិស្ថាន សមធម៌ សង្គម និង សេដ្ឋកិច្ច » ។
នាយក ប្រតិបត្តិ CACC លោក កាន់ គន្ធី បាន ថ្លែង ថា CACC នឹង បង្កើត ខ្សែ ច្រវ៉ាក់ តម្លៃ អាហារ សរីរាង្គ មួយ ដែល ប្រកបដោយ បរិយាប័ន្ន និង លើកទឹកចិត្ត កសិករ ខ្នាត តូច រួមទាំង ស្ត្រី និង ជនជាតិ ដើម ភាគ តិច ឲ្យ ប្តូរ មក អនុវត្ដ កសិកម្ម សរីរាង្គ ដោយ ប្រើ តែ ជី និង ថ្នាំ កម្ចាត់ សត្វ ល្អិត ធម្មជាតិ និង ការអនុវត្ត ដទៃ ទៀត ដែល ឆ្លើយតប នឹង ការប្រែប្រួល អាកាសធាតុ ។
លោក បាន បន្ត ថា « អាហារ សរីរាង្គ មាន តម្លៃ ល្អ និង មាន ស្ថិរភាព ជាង តម្លៃ ទំនិញ ដែល ផលិត ទៅ តាម ទម្លាប់ ។ វា មាន ឱកាស ចំណេញ ខ្ពស់ និង មាន ស្ថិរភាព ចំណូល » ។ លោក កត់សម្គាល់ ថា កសិករ ខ្នាត តូច ក្នុង ខេត្ត មណ្ឌលគិរី ច្រើន ដាំដុះ តែ ស្រូវ ហើយ ភាគ ច្រើន ធ្វើសិកម្ម វិល ជុំ បែប ប្រពៃណី ដែល ងាយ រងគ្រោះ ដោយសារ អាកាសធាតុ និង វិបត្តិ ផ្សេង ៗ ។
លោក គន្ធី បាន បន្ថែម ថា « គោលដៅ របស់ យើង គឺ ដើម្បី បង្កើន ប្រាក់ ចំណូល របស់ កសិករ ដែល ចូលរួម ឲ្យបាន រហូតដល់ ២០ ភាគរយ ធៀប នឹង ប្រាក់ ចំណេញ របស់ កសិកម្ម ធម្មតា » ។ លោក ក៏ បញ្ជាក់ ថា CACC នឹង ជួយ សម្របសម្រួល ទំនាក់ទំនង ទីផ្សារ ហើយ កសិករ នឹង អាច ប្រើប្រាស់ ចំណូល របស់ ខ្លួន ក្នុង ការទប់ទល់ ជាមួយនឹង វិបត្តិ ផ្សេង ៗ ដែល អាច កើតមាន នា ពេល អនាគត ។
លោកស្រី កូណាន់ បាន ថ្លែង ថា « កំណើន ប្រាក់ ចំណូល នឹង ដើរ តួយ៉ាង សំខាន់ ក្នុង ការសម្រួល ឲ្យ មាន អាហារូបត្ថម្ភ កាន់តែ ប្រសើរ នៅ ពេល ដែល ក្រុមគ្រួសារ ពួកគាត់ អាច ទទួលបាន អាហារ សុខភាព ចម្រុះ អាច ទប់ទល់ នឹង ផល អវិជ្ជមាន ផ្នែក អាហារូបត្ថម្ភ ដែល កើតមាន លើ ក្រុមគ្រួសារ ពួកគាត់ » ។
លោកស្រី ក៏ សម្គាល់ ផងដែរ ថា ជីវភាព និង អាហារូបត្ថម្ភ មាន សារៈសំខាន់ ណាស់ ដោយសារ តំបន់ គោលដៅ នេះ មាន កម្រិត នៃ ភាពក្រីក្រ និង កង្វះ អាហារូបត្ថម្ភ ខ្ពស់ ៕
រដ្ឋមន្ត្រី អ៉ិត សំហេង ទៅ ចូលរួម វេទិកា អប់រំ ពិភពលោក នៅ ចក្រភព អង់គ្លេស និង ឆ្លៀត ឱកាស កសាង ទំនាក់ទំនង ជាមួយ អ្នកចូលរួម មកពី ជុំវិញ ពិភពលោក
( អង់គ្លេស ) ៖ លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ដឹកនាំ គណៈប្រតិភូ អញ្ជើញ ចូលរួម វេទិកា អប់រំ ពិភពលោក លើក ទី១៩ ក្រោម ប្រធានបទ៖ ការបណ្តុះ វប្បធម៌ សិក្សា ការកសាង ភាពធន និង ការលើកកម្ពស់ ចីរភាព សម្រាប់ ការអប់រំ កាន់តែ ប្រសើរឡើង ប្រកបដោយ ភាពច្នៃប្រឌិត ភាពរឹងមាំ និង ភាពក្លាហាន ។
វេទិកា ពិភពលោក លើក ទី១៩ នេះ ប្រព្រឹត្តទៅ ពី ថ្ងៃទី ៧ - ១០ ខែឧសភា ឆ្នាំ ២០២៣ នៅ មជ្ឈមណ្ឌល អេលីហ្សា ប៊ែត ទី២ ទីក្រុង ឡុងដ៍ ចក្រភព អង់គ្លេស ។
វេទិកា នេះ រៀបចំឡើង ក្នុង គោលបំណង ចែករំលែក បទពិសោធន៍ ពាក់ព័ន្ធ នឹង ការអប់រំ ដើម្បី ទទួលបាន ធាតុ ចូល សម្រាប់ ការអភិវឌ្ឍ គោល នយោបាយ ពាក់ព័ន្ធ នឹង ការអប់រំ បណ្តុះបណ្តាលឱ្យ មាន ភាពធន់ រួមទាំងមូលដ្ឋាន នៃ ការសិក្សា កម្រិត ដំបូង ការអភិវឌ្ឍ ជំនាញ និង ការអភិវឌ្ឍ បច្ចេកវិទ្យា ថ្មី ៗ ដោយ មាន ការចូលរួម ពី តំណាង រាជ រដ្ឋាភិបាល វិស័យ ឯកជន អ្នកជំនាញ ខាង អប់រំ និង បណ្តុះបណ្តាល ជំនាញ និង ដៃគូ អភិវឌ្ឍន៍ មកពី បណ្តា ប្រទេស ជុំវិញ ពិភពលោក ចំនួន ១១៨ ប្រទេស ។
វេទិកា អប់រំ ពិភពលោក គឺជា វេទិកា នៃ ការប្រមូលផ្តុំ រដ្ឋមន្ត្រី អប់រំ និង បណ្តុះបណ្តាល ជំនាញ បច្ចេកទេស ដ៏ ធំ បំផុត ក្នុង ពិភពលោក ដើម្បី ជជែក វែកញែក ពី គោល នយោបាយ អប់រំ ទៅ ថ្ងៃ អនាគត ចែករំលែក បទពិសោធន៍ និង ឧត្តមានុវត្តន៍ ក៏ ដូចជា ដើម្បី វាយតម្លៃ និង ស្វែងរក ដំណោះស្រាយ ចំពោះ បញ្ហា ប្រឈម ទូទៅ របស់ វិស័យ អប់រំ និង បណ្តុះបណ្តាល ជំនាញ បច្ចេកទេស ។
ក្នុង កម្មវិធី នៃ វេទិកា អប់រំ នេះ ក៏ មាន ការថ្លែង សុន្ទរកថា របស់ វា គ្មិន សំខាន់ ៗ ព្រមទាំង មាន ការពិភាក្សា និង ផ្លាស់ប្តូរ គំនិត ថ្នាក់ រដ្ឋមន្ត្រី ។ ក្រៅពី នេះ ក៏ មាន ការរៀបចំ ឱ្យ មាន ការពិភាក្សា ក្រៅ ផ្លូវការ និង ឱកាស ដើម្បី កសាង ទំនាក់ទំនង (Networking) រវាង អ្នកចូលរួម ទាំងអស់ ផងដែរ ៕
ឧកញ៉ា លឹម ហេង លើកឡើង បែប នេះ ស្រប ពេល ដែល លោក បាន ដឹកនាំ ប្រតិភូ នៃ សភា ពាណិជ្ជកម្ម កម្ពុជា ទៅ បង្កើត ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា នៅ ទីក្រុង មែល ប៊ន និង ទីក្រុង ស៊ីដនី ប្រទេស អូស្ត្រាលី កាលពី ថ្ងៃទី ៦ និង ទី៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ និង បាន ជួប ពិភាក្សា ការងារ ពាណិជ្ជកម្ម មួយ ចំនួន ជាមួយ ប្រធាន តំបន់ អាស៊ីយ អាគ្នេយ៍ នៃ រដ្ឋាភិបាល វីចតូរីយ៉ា និង ពាណិជ្ជករ អូស្រ្តាលី ។
ឧកញ៉ា លឹម ហេង បាន ឱ្យដឹង ថា ការបង្កើត ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា នៅ ទីក្រុង ចំនួន ២ នៅ ប្រទេស អូស្រ្តាលី នឹង ចាប់ផ្តើម ពង្រីក ទំនាក់ទំនង ទ្វេ ភាគី រវាង ពាណិជ្ជករ និង ពាណិជ្ជករ ឬ រវាង វិស័យ ឯកជន និង វិស័យ ឯកជន (B2B) ដែល នឹង ធ្វើឱ្យ ការទំនាក់ទំនង កាន់តែ ឆាប់រហ័ស នឹង ងាយស្រួល ស្រប ពេល ដែល កម្ពុជា និង អូស្រ្តាលី កំពុង អនុវត្ត នូវ កិច្ចព្រមព្រៀង RCEP ។
លោក សង្ឃឹម ថា បន្ទាប់ពី បង្កើត ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា នៅ អូស្រ្តាលី នឹង ធ្វើឱ្យ មាន ទំនាក់ទំនង កាន់តែ ល្អ ប្រសើរ រវាង ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា ជាមួយនឹង សភា ពាណិជ្ជកម្ម អូស្រ្តាលី ។
ក្នុង ដំណើរ ទៅ បង្កើត ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា នៅ អូស្រ្តាលី អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា ក៏ បាន ចុះ ទស្សនកិច្ច ទៅកាន់ តំបន់ ឧស្សាហកម្ម កសិដ្ឋាន មួយចំនួន នៅ អូស្រ្តាលី និង មាន ជំនួប ពាណិជ្ជ មួយចំនួន ដែល រំពឹង ថា ការនាំចេញ នាំចូល រវាង កម្ពុជា និង អូស្រ្តាលី នឹង កាន់តែ ល្អ ប្រសើរឡើង ។
បើ តាម ឧកញ៉ា លឹម ហេង អូស្រ្តាលី បាន ចាប់អារម្មណ៍ ក្នុង ការនាំចូល សម្ភារៈ និង ម្ហូប អាហារ ផ្សេង ៗ មក កម្ពុជា ខណៈ អូស្រ្តាលី មាន តម្រូវការលើ ផលិតផល ច្រើន ប្រភេទ ដូចជា វាយណ ភណ្ឌ ឧបករណ៍ អគ្គិសនី គ្រឿង បង្គុំ ផ្សេង ៗ ជាពិសេស ផលិតផល កសិកម្ម ចំនួន ៩ ប្រភេទ ដូចជា ផ្លែ ប័រ ម្ទេស ល្ង ដំឡូង ជ្វា មៀន ស្វាយ ស្វាយចន្ទី ស្ករ ត្នោត និង ចំណិត ចេក ក្រៀម ដែល បាន សិក្សា ដោយ កម្មវិធី ចង្វាក់ តម្លៃ កសិកម្ម កម្ពុជា - អូស្ដ្រាលី (CAVAC) ដែល ជា ឱកាស សម្រាប់ ពាណិជ្ជករ កម្ពុជា នាំចេញ ទៅ អូស្រ្តាលី ។
ក្នុង ដំណើរទស្សនកិច្ច ទៅ ប្រទេស អូស្រ្តាលី នេះ ឧកញ៉ា លឹម ហេង ថែមទាំង បាន ជួប ពិភាក្សា ការងារ ជាមួយ លោកស្រី ឡូរ៉ា បឺក ប្រធាន តំបន់ អាស៊ីយ អាគ្នេយ៍ នៃ រដ្ឋាភិបាល វីចតូរីយ៉ា នៅ ការិយាល័យ វិនិយោគ វីចតូរីយ៉ា ទីក្រុង មែល ប៊ន ប្រទេស អូស្ត្រាលី ដើម្បី ស្វែងយល់ ពី ស្ថានភាព សេដ្ឋកិច្ច វិស័យ សក្តានុពល ទីក្រុង មែល ប៊ន និង ពិនិត្យ លទ្ធភាព សហប្រតិបត្តិការ រវាង ធុរ ជន កម្ពុជា និង អូស្ត្រាលី ។
លោកស្រី បាន លើកឡើង ថា ការិយាល័យ វិនិយោគ វីចតូរីយ៉ា នឹង ធ្វើការ យ៉ាង ជិតស្និត ជាមួយ ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា និង ស្វែងរក វិស័យ ឯកជន ដើម្បី ពិភាក្សា ក្នុង ការពង្រីក ការធ្វើ ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ តាមរយៈ កិច្ចព្រមព្រៀង RCEP ។
យោង តាម ទិន្នន័យ ពី អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា រយៈពេល ៣ខែ ដើម ឆ្នាំ ២០២៣ នេះ ទំហំ ពាណិជ្ជកម្ម រវាង កម្ពុជា និង អូស្រ្តាលី សម្រេចបាន ជាង ១៣៥ លាន ដុល្លារ អាមេរិក កើនឡើង ៧. ៥% ក្នុង នោះ ក្នុង កម្ពុជា នាំចេញ ទៅ អូស្រ្តាលី តម្លៃ ៩៨ លាន ដុល្លារ កើនឡើង ៦.៧% ។ ចំណែក អូស្រ្តាលី នាំចូល កម្ពុជា វិញ ក្នុង តម្លៃ ៣៧លាន ដុល្លារ អាមេរិក កើនឡើង ៩.៤% ៕
ក្រសួង ការបរទេស កម្ពុជា បាន ឱ្យដឹង ថា ដំណើរ របស់ សម្តេច តេជោ និង គណៈប្រតិភូ ទៅកាន់ ប្រទេស ឥណ្ឌូនេស៊ី នា ពេលនេះ តប តាម ការអញ្ជើញ របស់ លោក ចូកូ វីដូដូ ប្រធានាធិបតី ឥណ្ឌូនេស៊ី និង ជា ប្រធាន ប្តូរ វេន ឆ្នាំ ២០២៣ នៃ សមាគម ប្រជាជាតិ អាស៊ី អាគ្នេយ៍ ( អាស៊ាន ) ។ កិច្ចប្រជុំ កំពូល អាស៊ាន នៅ ឆ្នាំ នេះ ធ្វើឡើង ក្រោម មូល បទ « សារៈសំខាន់ អាស៊ាន៖ ស្នូល នៃ កំណើន » ដែល នឹង ប្រព្រឹត្តទៅ ពី ថ្ងៃទី ១០ ដល់ ទី ១១ ខែឧសភា ឆ្នាំ ២០២៣ នៅ ទីក្រុង ឡាប៊ូន បាចូ សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី ។
អញ្ជើញ អម ដំណើរ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី រួម មាន លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ និង លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម ព្រមទាំង មន្ត្រី ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា និង ធុរ ជន មួយចំនួន នៃ សភា ពាណិជ្ជកម្ម កម្ពុជា ។
នៅក្នុង អំឡុង ពេល ស្នាក់ នៅ ទីក្រុង ឡាប៊ូន បាចូ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ក៏ នឹង មាន ជំនួប ទ្វេ ភាគី ជាមួយ សមភាគី អាស៊ាន របស់ សម្តេច និង ឥស្សរជន អាស៊ាន មួយចំនួន ផងដែរ ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៨ ខែឧសភា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ស្រាល ៦នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ . បត់ / គ្រោះថ្នាក់ និង កត្តា យាន ៕ ម្ចាស់ មេដាយ មាស ស្រួង ភាវី៖ សូម គោរព ឧទ្ទិស លទ្ធផល នេះ ជូន ចំពោះ មហា បុព្វបុរស ខ្មែរ គ្រប់ ជំនាន់ គោរព ជូន ថ្នាក់ដឹកនាំ និង ប្រជាជន ខ្មែរ គ្រប់ រូប
ព្រឹក ស្អែក សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤២ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ នៅ ប្រទេស ឥណ្ឌូនេស៊ី
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអង្គារ ទី ០៩ ខែឧសភា ឆ្នាំ ២០២៣ ស្អែក នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤២ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ក្នុង ក្របខ័ណ្ឌ អាស៊ាន ។
នៅ មុន កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤២ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ក្នុង ក្របខ័ណ្ឌ អាស៊ាន នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន នឹង អញ្ជើញ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន (AMM) កិច្ចប្រជុំ ក្រុមប្រឹក្សា សហគមន៍ សន្តិសុខ - នយោបាយ អាស៊ាន (APSC) លើក ទី ២៦ និង កិច្ចប្រជុំ ក្រុមប្រឹក្សា សម្របសម្រួល អាស៊ាន លើក ទី ៣៣ (ACC) ដើម្បី ត្រៀម រៀបចំ សម្រាប់ កិច្ចប្រជុំ កំពូល អាស៊ាន ខាងលើ នេះ ផងដែរ ៕
យុទ្ធសាស្ត្រ អូសបន្លាយ ពេលវេលា នេះ ធ្លាប់ ត្រូវបាន លោក ពូទីន ប្រើប្រាស់ នា ពេល កន្លងមក ដែរ ។ នៅក្នុង ប្រទេស ស៊ីរី និង លីប៊ី លោក ពូទីន បាន រង់ចាំ អស់ រយៈពេល ជាច្រើន ឆ្នាំ ដើម្បី ចាប់ យក ឱកាស និង ផលប្រយោជន៍ នៅពេល បណ្ដា រដ្ឋាភិបាល លោក ខាងលិច បាត់បង់ ការផ្តោត ឬ ផ្លាស់ប្ដូរ អាទិភាព របស់ ខ្លួន នៅពេល ទាក់ទង គោល នយោបាយ ការបរទេស ។
១៖ សម្តេច តេជោ ហ៊ុន សែន កោតសរសើរ កីឡាការិនី ខាន់ ចេសា ដែល ឈ្នះ មេដាយ មាស ស៊ីហ្គេម ជាមួយ កាយវិការ ប្រកបដោយ សីលធម៌ និង គុណធម៌ ចំពោះ គូ ប្រកួត
២៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា គោរព តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដោយ បន្ដ ធ្វើជា ប្រធាន សហព័ន្ធ កីឡា បាល់ទាត់ កម្ពុជា
៣៖ ទេសរដ្ឋមន្ដ្រី សិង្ហបុរី៖ សម្តេច តេជោ រៀបចំ ព្រឹត្តិការណ៍ ស៊ីហ្គេម យ៉ាង អស្ចារ្យ
៤៖ នាយក រដ្ឋមន្ត្រី ជប៉ុន ប្រាប់ ប្រជាជន កូរ៉េ ខាងត្បូង ថា បេះដូង របស់ លោក ឈឺចាប់ ពេល នឹក ដល់ សម័យ អាណានិគម
៥៖ សីតុណ្ហភាព ក្នុង ខេត្ត មួយ ស្ថិត ភាគ ខាងជើង ប្រទេស វៀតណាម ឡើង ដល់ ៤៤. ១អង្សា សេ
៦៖ លោក គៀន ពន្លក បកស្រាយ អំពី មូលហេតុ ដែល សមាជិក ក្រុម ប្រឆាំង ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ដូច ទឹក បាក់ ទំនប់
៧៖ រដ្ឋមន្រ្តី ការបរទេស ចិន ប៉ាគីស្ថាន និង អាហ្វហ្កានីស្ថាន ឯកភាព គ្នា ពង្រឹង កិច្ចសហប្រតិបត្តិការ សន្តិសុខ
៨៖ ប្រធាន សមាគម សប្បុរសធម៌ ខ្មែរ ក្រោម៖ ការចាកចេញ របស់ សមាជិក បក្ស ប្រឆាំង ហើយ ចូលរួម ជាមួយ បក្ស ប្រជាជន គឺជា ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ . ទោះ ៥អាណត្តិ ឬ ១០អាណត្តិ ទៀត បក្ស ប្រឆាំង គ្មាន វាសនា ដឹកនាំ ប្រទេស ទេ
៩៖ រដ្ឋមន្រ្តី អប់រំ ប្រទេស ស៊ែប៊ី សុខចិត្ត លា លែង ពី តំណែង ក្រោយ កើតមាន ករណី បាញ់ប្រហារ នៅ សាលារៀន
១០៖ យានអវកាស អាថ៌កំបាំង មួយ របស់ ចិន ទើប ត្រឡប់ ចុះ មកដល់ ផ្ទៃ ផែនដី វិញ ក្រោយ ចំណាយ ពេល ២៧៦ ថ្ងៃ ក្នុង ទី អវកាស
១១៖ រដ្ឋមន្រ្តី ការបរទេស ចិន៖ វា ជា រឿង ចាំបាច់ ក្នុង ការធ្វើឱ្យ ទំនាក់ទំនង ចិន - អាមេរិក មាន ស្ថិរភាព ឡើងវិញ
១២៖ លោក ស៉ី ជិន ពីង នឹង ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល ចិន - អាស៉ី កណ្តាល ដំបូង បំផុត នៅ សប្តាហ៍ ក្រោយ
១៣៖ ការចំណាយ លើ វិស័យ ការពារ ជាតិ របស់ នូវែលសេឡង់ នឹង កើនឡើង ប្រហែល ៤៧២ លាន ដុល្លារ
១៤៖ លោក គីស៉ិ ដា ជួប ក្រុម សមាជិក សភា និង មេដឹកនាំ ធុរកិច្ច នៅ ចុងបញ្ចប់ នៃ ដំណើរទស្សនកិច្ច ក្នុង ប្រទេស កូរ៉េ ខាងត្បូង
១៦៖ ប្រធានាធិបតី ឥណ្ឌូណេស៉ី ថ្កោល ទោស ការវាយប្រហារ លើ ក្រុម មន្រ្តី អាស៊ាន ដែល ស្ថិត ក្នុង បេសកកម្ម ផ្តល់ ជំនួយ នៅ ប្រទេស មីយ៉ាន់ម៉ា
១៧៖ ប្រតិបត្តិការ ល្បាត រួមគ្នា រវាង ហ្វីលីពីន និង អាមេរិក នៅ តំបន់ សមុទ្រ ចិន ខាងត្បូង អាចនឹង ចាប់ផ្តើម នៅ ប៉ុន្មាន ខែ ខាងមុខ
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត៖ ការវិនិយោគ លើ វិស័យ អប់រំ គឺជា ការចូលរួមចំណែក ក្នុង ការបណ្តុះ ចំណេះដឹង សមត្ថភាព គុណធម៌ និង សីលធម៌
( ព្រះសីហនុ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ប្រធាន គណៈកម្មាធិការ អាហារូបករណ៍ សិស្ស - និស្សិត ក្រីក្រ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន លើកឡើង ថា ការវិនិយោគ លើ វិស័យ អប់រំ គឺជា ការចូលរួមចំណែក ក្នុង ការបណ្តុះ ចំណេះដឹង សមត្ថភាព គុណធម៌ និង សីលធម៌ ជា គុណ វុឌ្ឍិ ផ្នែក ខាងក្នុង របស់ មនុស្ស ដែល ជា ទ្រព្យធន ដ៏ មាន សារៈសំខាន់ ចំបាច់ បំផុត សម្រាប់ ប្រទេសជាតិ នីមួយ ៗ ។
ការលើកឡើង របស់ លោក បណ្ឌិត ហ៊ុន ម៉ានី បាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជេីញ ជា អធិបតីភាព ក្នុង ពិធី ប្រគល់ សញ្ញាបត្រ ជូន និស្សិត ជ័យលាភី នៃ សាខា សាកលវិទ្យាល័យ គ្រប់គ្រង និង សេដ្ឋកិច្ច (UME) ខេត្ត ព្រះសីហនុ នៅ ព្រឹក ថ្ងៃទី ០៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ នៅ សណ្ឋាគារ ឯករាជ្យ ក្រុង ព្រះសីហនុ ។
លោក សូម កោតសរសើរ ដល់ សាកលវិទ្យាល័យ UME ដែល បាន វិនិយោគ លើ វិស័យ អប់រំ ក្នុង រយៈកាល ២៥ ឆ្នាំ កន្លងមក នេះ ដោយ បាន អភិវឌ្ឍន៍ ខ្លួន ឈានឡើង ជា បន្តបន្ទាប់ រហូត មាន វត្តមាន នៅក្នុង ខេត្ត ចំនួន ៦ នៅ ទូទាំង ប្រទេស ដែល នេះ គឺជា ការចូលរួមចំណែក មិន អាច ខ្វះ បាន ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី រួមគ្នា សម្រេច ទិសដៅ នៃ ការអភិវឌ្ឍ វិស័យ អប់រំ ដែល ជា មូលដ្ឋានគ្រឹះ នៃ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច ក៏ ដូចជា ការរីកចម្រើន លើ គ្រប់ វិស័យ នៅ កម្ពុជា ។
ជា ចំណាប់អារម្មណ៍ ផ្ទាល់ខ្លួន . ព្រឹត្តិការណ៍ ជា ប្រវត្តិសាស្រ្ត នេះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បង្ហាញ នូវ ភាព លេចធ្លោ លើ ទិដ្ឋភាព ២សំខាន់ ៗ៖ ទី១៖ គឺ ការដឹកនាំ និង ការរៀបចំ គ្រប់ សកម្មភាព ពាក់ព័ន្ធ នឹង បដិសណ្ឋារកិច្ច និង ការប្រកួត ប្រកបដោយ ភាពរលូន ត្រឹមត្រូវ យុត្តិធម៌ និង ទំនុកចិត្ត ស្រប តាម កម្រិត ស្តង់ដារ កំណត់ របស់ ក្រុមប្រឹក្សា សហព័ន្ធ កី ទ្បា អាស៊ី អាគ្នេយ៍ និង ទី២៖ គឺ សមត្ថភាព ធនធាន មនុស្ស របស់ កម្ពុជា នៅក្នុង វិស័យ កីឡា ត្រូវបាន លើកកម្ពស់ ជាលំដាប់ គួរឲ្យ កត់សម្គាល់ ។
ជាក់ស្តែង នៅក្នុង ព្រឹត្តិការណ៍ កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី៣២ នេះ គឺ ចំនួន មេដាយ ដែល កម្ពុជា ទទួលបាន មាន ចំនួន ច្រើន រហូត អាច បំបែក ឯតទគ្គកម្ម របស់ ខ្លួន នៅក្នុង ប្រវត្តិសាស្ត្រ ហើយក៏ នឹង កំពុង បន្ត កើនឡើង ជាប់ ទៅ មុខ រហូត ។ វឌ្ឍនភាព នេះ មិន មែន ជា ការចៃដន្យ នោះ ទេ ប៉ុន្តែ ជា ផ្លែ ផ្កា ដែល កើតឡើង ក្រោម បរិស្ថាន អំណោយផល នៃ សុខ សន្តិភាព - ស្ថិរភាព និង គោល នយោបាយ ដ៏ ត្រឹមត្រូវ និង គ្រប់ ជ្រុងជ្រោយ របស់ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ។
ដូចគ្នា នេះ គឺ វិនិយោគិន បរទេស ក៏ មាន ការរំពឹងទុក តែ មួយ ផងដែរ ចំពោះ ការសម្រេចចិត្ត បណ្តាក់ទុន វិនិយោគ នៅ កម្ពុជា ដោយ ទី ១៖ ត្រូវ ពិនិត្យមើល លើ កត្តា សន្តិភាព - ស្ថិរភាព និង ទី ២៖ កម្រិត សមត្ថភាព ធនធាន មនុស្ស របស់ កម្ពុជា ដែល ត្រូវ មាន ជំនាញ បម្រើ ឲ្យ ដំណើរការ ផលិតកម្ម ក្នុង គម្រោង វិនិយោគ របស់ ពួកគេ ។
ប៉ុន្តែ ដោយសារ ស្ថានភាព ទឹកភ្លៀង បច្ចុប្បន្ន បាន ធូរស្រាល ទីស្នាក់ការ កណ្តាល បាន សម្រេចចិត្ត បញ្ចប់ ការឆ្លើយតប ជាបន្ទាន់ កម្រិត ៤ សម្រាប់ ការគ្រប់គ្រង ទឹក ជំនន់ ចាប់ពី ម៉ោង៨ យប់ ថ្ងៃចន្ទ នេះ តទៅ ។ ទោះបីជា យ៉ាងណា ក៏ដោយ នាយកដ្ឋាន ពាក់ព័ន្ធ ត្រូវបាន ជំរុញ ឱ្យ តាមដាន យ៉ាង ដិតដល់ នូវ ការប្រែប្រួល អាកាសធាតុ បន្ត ទៀត ខណៈ ដែល ខេត្ត Jiangxi នៅតែ ស្ថិត ក្នុង រដូវ ទឹក ជំនន់ ដ៏ ច្រើន នៅឡើយ ៕
ក្រសួង បរិស្ថាន រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ និង ដៃគូ ធ្វើ សន្និសីទ រួមគ្នា មុន ថ្ងៃ បើក យុទ្ធនាការ អន្ទាក់ សូន្យ លើក ទី២
( ភ្នំពេញ ) ៖ ក្រសួង បរិស្ថាន រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ និង អង្គការ ដៃគូ នៅ រសៀល ថ្ងៃទី ០៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ ធ្វើ សន្និសីទ សារព័ត៌មាន រួមគ្នា មុន ថ្ងៃ បើក យុទ្ធនាការ អន្ទាក់ សូន្យ លើក ទី២ នៅ តំបន់ ការពារ ធនធាន ធម្មជាតិ ក្នុង ខេត្ត កំពង់ស្ពឺ ។
ការបើក យុទ្ធនាការសូន្យ គឺ ធ្វើឡើង ក្នុង គោលបំណង សំខាន់ កាត់បន្ថយ និង ទប់ស្កាត់ ចំនួន អន្ទាក់ នៅក្នុង តំបន់ ការពារ ធម្មជាតិ ក្នុង កំពង់ស្ពឺ ក៏ ដូចជា នៅក្នុង តំបន់ ការពារ ធម្មជាតិ នានា នៅក្នុង ប្រទេស កម្ពុជា និង បណ្តុះ ស្មារតី ស្រឡាញ់ សត្វ ព្រៃ កាន់តែ ខ្លាំង ឡើង ក្នុង ចំណោម សាធារណជន ។
ប្រធាន យុទ្ធនាការ អន្ទាក់ សូន្យ រូប នេះ បាន បញ្ជាក់ ថា យុទ្ធនាការ អន្ទាក់ សូន្យ គឺជា កិច្ច ខិតខំ ប្រឹងប្រែង រវាង រាជ រដ្ឋាភិបាល អង្គការ ដៃគូ វិស័យ ឯកជន ដើម្បី រួមគ្នា ទប់ស្កាត់ ការដាក់ អន្ទាក់ សត្វ ព្រៃ និង រួមគ្នា អភិរក្ស សត្វ ព្រៃ ដ៏ មាន តម្លៃ សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ ឱ្យ បាន គង់វង្ស យូរអង្វែង ។
កប៉ាល់ FSO Safer ដែល បច្ចុប្បន្ន មាន បរិមាណ ប្រេង ចំនួន ៤ដង ដែល គ្រប់គ្រាន់ ដើម្បី ធ្វើឱ្យ វា ក្លាយជា ការធ្លាយ ប្រេង ដ៏ ធំ បំផុត ទី ប្រាំ ក្នុង ប្រវត្តិសាស្ត្រ ត្រូវបាន គេ រំពឹង ថា នឹង ផ្ទុះ ធ្លាយ ប្រសិនបើ មិន ត្រូវបាន ដោះស្រាយ ភ្លាម ៗ នេះ បើ យោង តាម អង្គការ សហ ប្រជាជាតិ ។
ក្នុង អំឡុង សន្និសីទ លោក Yamada បាន លើកឡើង ពី សារៈសំខាន់ នៃ គម្រោង ប្រតិបត្តិការ ជួយសង្គ្រោះ ប្រកបដោយ សុវត្ថិភាព ដែល សម្របសម្រួល ដោយ អង្គការ សហ ប្រជាជាតិ ដើម្បី កាត់បន្ថយ ហានិភ័យ នៃ គ្រោះមហន្តរាយ ។
ទន្ទឹន នឹង នោះ លោក Yamada ក៏ បាន គូសបញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត របស់ ប្រទេស ជប៉ុន ក្នុង ការដោះស្រាយ វិបត្តិ មនុស្សធម៌ នៅ យេម៉ែន ដោយ ផ្តល់ ជំនួយ មនុស្សធម៌ ជិត ៤៣០ លាន ដុល្លារ ចាប់តាំងពី ឆ្នាំ ២០១៥ ។ លោក បាន ប្រកាស ថា ប្រទេស ជប៉ុន នឹង ផ្តល់ ជំនួយ មនុស្សធម៌ បន្ថែម យ៉ាងហោចណាស់ ២៤ លាន ដុល្លារ នៅ ឆ្នាំ ២០២៣ នេះ ៕
រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ប្រាប់ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង តាមដាន ជំងឺ ស្ត្រី មេម៉ាយ មាន កូនស្រី ៣នាក់ ដែល ជីវភាព ក្រីក្រ មាន កើត មហារីក ឬ អត់ . បើ កើត មហារីក ត្រូវ ព្យាបាល នៅ ភ្នំពេញ
( កំពង់ឆ្នាំង ) ៖ រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល លោក ម៉ម ប៊ុន ហេង បាន ប្រាប់ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង តាមដាន ជំងឺ ស្ត្រី មេម៉ាយ មាន កូនស្រី ៣នាក់ ដែល ជីវភាព ក្រីក្រ ថា តើ មាន កើត ជំងឺ មហារីក ឬ អត់ ។
ស្ត្រី មេម៉ាយ កូន ៣នាក់ មាន ជីវភាព ក្រីក្រ ដែល ស្រ្តី ជា ម្ដាយ មាន ជំងឺ រ៉ាំរ៉ៃ ប្រចាំ កាយ ហើយ មិន មាន ប្រាក់ ព្យាបាល ម្យ៉ាង កូនស្រី ៣នាក់ របស់ គាត់ បាន ឈប់ រៀន ដើម្បី នៅ មើល ថែ ម្ដាយ ហើយ ពួកគេ ក៏ មិន ទាន់ គ្រប់ អាយុ ក្នុង ការចូល បម្រើ ការងារ ម្យ៉ាងទៀត នោះ មិន មាន ផ្ទះសម្បែង ឬ ដីធ្លី សម្រាប់ ធ្វើ ស្រែ ចំការ ទៀតផង បច្ចុប្បន្ន ពួកគេ បាន សុំ ផ្ទះ របស់ គេ ស្នាក់ នៅជា បណ្ដោះអាសន្ន ដែល ស្ថិត នៅក្នុង ភូមិ អូរ កណ្ដាល ឃុំ ជ្រៃ បាក់ ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង ។
នៅ ព្រឹក ថ្ងៃទី ០៨ ខែឧសភា ឆ្នាំ ២០២៣ កូនស្រី ៣នាក់ និង ម្ដាយ បាន លើក ដៃ សំពះ គោរព ស្នើសុំ ដល់ សប្បុរសជន នានា និង ថ្នាក់ដឹកនាំ ជួយ ផ្ដល់ លទ្ធភាព ក្នុង ការព្យាបាល ជំងឺ ម្ដាយ របស់ ពួកគេ ដែល ត្រូវ វះកាត់ ជា ចាំបាច់ ដើម្បី សង្គ្រោះ ជីវិត ក្រែង បាន រស់ នៅ មើល ថែរក្សា កូនស្រី ទាំង ៣នាក់ បន្ត ទៅ មុខ ទៀត ។
ទាក់ទង នឹង គ្រួសារ ស្ត្រី ខាងលើ នេះ លោក ស្រង់ ហ៊ឺន មេភូ មិអូរ កណ្ដោល បាន ប្រាប់ អ្នកសារព័ត៌មាន ឲ្យដឹង ថា ស្ត្រី មេ ម៉ាយ ឈ្មោះ ម៉ោល ម៉ៅ ខាងលើ នេះ ពិតជា គ្រួសារ ក្រីក្រ លំ បាក ពិតប្រាកដ មែន សព្វ ថ្ងៃ គាត់ គ្មាន ផ្ទះ សំបែង ស្រែ ចម្ការ និង គេ ទេ គឺ សុំ ផ្ទះ គេ ស្នាក់ នៅក្នុង ភូមិ ជា បណ្ដោះ អាសន្ន តែ ប៉ុណ្ណោះ ។ កន្លងមក អាជ្ញាធរ ភូមិ បម្រុង ធ្វើ ប័ណ្ណ សមធម៌ ជូន គាត់ ដែរ ប៉ុន្តែ គាត់ បាន ចំណាកស្រុក ទៅ ធ្វើជា កម្មករ នៅ ខេត្ត ឆ្ងាយ ដែល អាជ្ញាធរ មិន អាច កោះ ហៅ គាត់ មក ធ្វើ ប័ណ្ណ សមធម៌ ជូន បាន ។
ការប្រារព្ធ ទិវា ជ័យជម្នះ ៩ ឧសភា គឺជា បុណ្យ ជាតិ ដ៏ សំខាន់ បំផុត មួយ នៅក្នុង ប្រទេស រុស្ស៉ី ដើម្បី រំឮ ក និង ឧទ្ទិស ដល់ ការពលី របស់ ទាហាន សូវៀត ដែល បាន យកឈ្នះ លើកងទ័ព របស់ ហ៊ីត្លែរ ក្នុង សង្រ្គាម លោក លើក ទី២។ ពិធី បុណ្យ ជាតិ មួយ នេះ នឹង ត្រូវ ប្រព្រឹត្តទៅ ក្រោម ការរឹតបន្តឹង សន្តិសុខ យ៉ាង ខ្លាំង បន្ទាប់ពី ការវាយប្រហារ ដោយ យន្ដហោះ ដ្រូន ជា បន្តបន្ទាប់ ក្នុង ទឹកដី រុស្ស៉ី ក្នុង នោះ មាន ការវាយប្រហារ ដោយ យន្ដហោះ ដ្រូន លើ វិមាន ក្រឹមឡាំង ដែល អាជ្ញាធរ រុស្ស៉ី ចោទ ថា ជា ស្នាដៃ របស់ អ៊ុយក្រែន ។
លោក ពូទីន រួមទាំង រដ្ឋមន្ត្រី ការពារ ជាតិ របស់ លោក និង មន្ត្រី ជាន់ ខ្ពស់ រុស្ស៉ី ត្រូវបាន គេ រំពឹង ថា នឹង ចូលរួម ទស្សនា ការ ធ្វើ ព្យុហយាត្រា យោធា នៅឯ ទីលាន ក្រហម ដែល ជារឿយ ៗ មាន ការសម្ញែង រថក្រោះ មីស៊ីល បាលិស្ទីគ អន្តរ ទ្វីប និង ក្បួន ព្យុយោត្រា របស់ កងទ័ព រុស្ស៉ី ។
មីយ៉ាន់ម៉ា បាន ធ្លាក់ ចូល ក្នុង ភាពចលាច ល និង អំពើហិង្សា ចាប់តាំងពី មាន រដ្ឋប្រហារ យោធា ទម្លាក់ រដ្ឋាភិបាល ស៊ីវិល របស់ លោកស្រី អោង សាន ស៊ូជី ពី អំណាច កាលពី ជាង ២ឆ្នាំ មុន មក ហើយ អាស៊ាន កំពុង ប្រឹងប្រែង ស្វែងរក ដំណោះស្រាយ នយោបាយ បញ្ចប់ ជម្លោះ នេះ ។ ប៉ុន្តែ កិច្ច ខិតខំ ប្រឹងប្រែង កន្លងមក មិន បាន ទទួល លទ្ធផល ផ្លែ ផ្កា អ្វី នោះ ទេ រីឯ ភាគី ជម្លោះ នៅ មីយ៉ាន់ម៉ា នៅតែ មិន ព្រម ជួប ចរចា គ្នា ឡើយ ។
គួរ បញ្ជាក់ ថា សិង្ហបុរី បាន ថ្កោលទោស យ៉ាង ខ្លាំង ចំពោះ ការវាយប្រហារ ក្បួន រថយន្ដមន្ត្រី អាស៊ាន ខណៈ ឥណ្ឌូណេស៊ី ដែល ឆ្នាំ នេះ ជា ប្រធាន អាស៊ាន មិន បាន ឱ្យដឹង ថា តើ មន្ត្រី របស់ ខ្លួន ស្ថិត នៅក្នុង ក្បួន រថយន្ដ នោះ ដែរ ឬ ក៏ យ៉ាងណា នោះ ទេ ។ កិច្ចប្រជុំ កំពូល អាស៊ាន នឹង ត្រូវ ប្រព្រឹត្តទៅ ពី ថ្ងៃទី ៩ ដល់ ថ្ងៃទី ១១ ខែឧសភា នេះ នៅលើ កោះ Flores របស់ ឥណ្ឌូណេស៊ី ហើយ បណ្ដា មេដឹកនាំ អាស៊ាន ត្រូវបាន គេ រំពឹង ថា បន្ត ជំរុញ ផែនការ សន្តិភាព ៥ចំណុច ៕
គួរ បញ្ជាក់ ថា រដ្ឋាភិបាល ចិន បាន ច្រានចោល ការចោទប្រកាន់ ដែល ថា ទីក្រុង ប៉េកាំង បាន លូកលាន់ កិច្ចការ ផ្ទៃក្នុង របស់ កាណាដា ហើយ ស្ថានទូត ចិន ក្នុង ទីក្រុង អូតា វ៉ា ក៏ បាន ដាក់ កំណត់ ទូត តវ៉ា ទៅកាន់ រដ្ឋាភិបាល កាណាដា ផងដែរ ជាមួយ ការព្រមាន ចាត់ វិធានការឆ្លើយតប យ៉ាង ម៉ឺងម៉ាត់ ៕
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៥៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០៨ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៥៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៨ ខែឧសភា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ០៩ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៥៧ នាក់ នោះ មាន ១៨នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ០៨ ករណី និង ជនសង្ស័យ ៣៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ១៥ករណី ។
ក្រសួង បញ្ជាក់ ថា អំឡុង សប្តាហ៍ ខាងមុខ នេះ ព្រះរាជាណាចក្រ កម្ពុជា នឹង ទទួល នូវ ឥទ្ធិពល ជ្រលង សម្ពាធ ទាប ពី ភាគ ខាងជើង ប្រទេស និង ខ្យល់ មូសុង និរតី ក្នុង កម្រិត ខ្សោយ ។
ក្រសួង ធនធាន ទឹក បាន អំពាវនាវ ឲ្យ បង្កើន ការប្រុងប្រយ័ត្ន ចំពោះ បាតុភូត ធម្មជាតិ ដែល អាច កើត មាន ឡើង ជា យថាហេតុ ៕ ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤២ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ នៅ ប្រទេស ឥណ្ឌូនេស៊ី
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអង្គារ ទី ០៩ ខែឧសភា ឆ្នាំ ២០២៣ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤២ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ក្នុង ក្របខ័ណ្ឌ អាស៊ាន ។
ឈ្វេងយល់ ពី សាធារណរដ្ឋ ឥណ្ឌូណេស៊ី ទី ដែល សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤២ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ក្នុង ក្របខ័ណ្ឌ អាស៊ាន
( ហ្សាការតា ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤២ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ក្នុង ក្របខ័ណ្ឌ អាស៊ាន ក្រោម មូល បទ « សារៈសំខាន់ អាស៊ាន៖ ស្នូល នៃ កំណើន » ដែល នឹង ប្រព្រឹត្តទៅ ពី ថ្ងៃទី ១០ ដល់ ទី ១១ ខែឧសភា ឆ្នាំ ២០២៣ នៅ ទីក្រុង ឡាប៊ូន បាចូ សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី ។
ថ្នាក់ដឹកនាំ អាស៊ាន ក៏ នឹង ពិភាក្សា លើ បញ្ហា ក្នុង តំបន់ និង អន្តរជាតិ ដែល ជា ក្តីបារម្ភ និង ផល ប្រយោជន៍ រួមទាំង ការអនុវត្ត លើ ការព្រមព្រៀង ជា ឯកច្ឆន្ទ ប្រាំ ចំណុច ស្តីពី មីយ៉ាន់ម៉ា និង សេចក្តី សម្រេច របស់ មេដឹកនាំ អាស៊ាន និង ការអនុវត្ត លើ ទស្សនវិស័យ របស់ អាស៊ាន ស្តីពី ឥណ្ឌូ - ប៉ាស៊ីហ្វិក ផងដែរ ។
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ៨ ខែឧសភា ឆ្នាំ ២០២៣ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖ ១៖ សម្ព័ន្ធ អារ៉ាប់ ទទួលយក ស៊ីរី ជា សមាជិក ឡើងវិញ ក្រោយ អវត្តមាន ជាង ១២ ឆ្នាំ
២៖ នាយក រដ្ឋមន្ត្រី ជប៉ុន ប្រាប់ ប្រជាជន កូរ៉េ ខាងត្បូង ថា បេះដូង របស់ លោក ឈឺចាប់ ពេល នឹក ដល់ សម័យ អាណានិគម
៣៖ រុស្ស៉ី វាយប្រហារ តាម ផ្លូវ អាកាស ទ្រង់ទ្រាយ ធំ លើ អ៊ុយក្រែន មុន ថ្ងៃ ទិវា ជ័យជម្នះ ៩ ឧសភា
៤៖ រដ្ឋមន្រ្តី ការបរទេស ចិន៖ វា ជា រឿង ចាំបាច់ ក្នុង ការធ្វើឱ្យ ទំនាក់ទំនង ចិន - អាមេរិក មាន ស្ថិរភាព ឡើងវិញ
៥៖ ប្រធានាធិបតី ឥណ្ឌូណេស៉ី ថ្កោល ទោស ការវាយប្រហារ លើ ក្រុម មន្រ្តី អាស៊ាន ដែល ស្ថិត ក្នុង បេសកកម្ម ផ្តល់ ជំនួយ នៅ ប្រទេស មីយ៉ាន់ម៉ា
លោក ឌឹម សារឿន មេដឹកនាំ គណបក្ស ភ្លើង ទៀន នៅ ខេត្ត បាត់ដំបង ថ្លែងអំណរគុណ សម្តេច តេជោ ហ៊ុន សែន ដែល អនុញ្ញាតឱ្យ ខ្លួន ចូលរួម ជីវភាព នយោបាយ
( ភ្នំពេញ ) ៖ លោក ឌឹម សារឿន ជា ថ្នាក់ដឹកនាំ គណបក្ស ភ្លើង ទៀន នៅ ខេត្ត បាត់ដំបង បាន ចេញ វីដេអូ ថ្លែងអំណរគុណ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន អនុញ្ញាតឱ្យ រូប លោក ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។ លោក សារឿន បាន បង្ហាញ ការឈឺចាប់ ដែល រង ភាពអយុត្តិធម៌ នៅក្នុង គណបក្ស ភ្លើង ទៀន ដោយ លោក ជា អ្នកតស៊ូ ជាមួយ បក្ស នេះ អស់ រយៈពេល ច្រើន ឆ្នាំ មកហើយ ។
ខាងក្រោម នេះ ជា វីដេអូ របស់ លោក ឌឹម សារឿន៖ សហភាព អឺរ៉ុប កំណត់ គោលដៅ លើ ក្រុមហ៊ុន ចិន ក្នុង ការដាក់ទណ្ឌកម្ម ថ្មី ប្រឆាំង នឹង សង្គ្រាម នៅ អ៊ុយក្រែន
( ប្រ៊ុច សែល) ៖ នាយក ប្រតិបត្តិ សហភាព អឺរ៉ុប បាន ស្នើ ឱ្យ ដាក់ ក្នុង បញ្ជីខ្មៅ លើ ក្រុមហ៊ុន ចិន មួយចំនួន និង ទប់ស្កាត់ ការនាំចេញ ទៅកាន់ ប្រទេស នានា ដែល ត្រូវបាន គេ មើលឃើញ ថា មាន ជាប់ពាក់ព័ន្ធ ក្នុង ការបំពាន លើ ការរឹតបន្តឹង ពាណិជ្ជកម្ម របស់ រុស្ស៊ី ក្រោម ការដាក់ទណ្ឌកម្ម ថ្មី ប្រឆាំង នឹង ទីក្រុង មូស្គូ សម្រាប់ សង្គ្រាម ប្រឆាំង នឹង អ៊ុយក្រែន ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃចន្ទ ទី ០៨ ខែឧសភា ឆ្នាំ ២០២៣ ។
ប្រភព ការទូត ជាច្រើន បាន និយាយ ថា ប្រទេស ជា សមាជិក សហភាព អឺរ៉ុប ទាំង ២៧ នឹង មាន ការពិភាក្សា ជា លើក ដំបូង នៅ ថ្ងៃពុធ លើ សំណើ របស់ អង្គភាព គោល នយោបាយ ការបរទេស របស់ គណៈកម្មការ អឺរ៉ុប លើ រឿង នេះ ។
ប្រភព បាន និយាយ ថា សំណើ នេះ ផ្តោត លើ ការប្រយុទ្ធ ប្រឆាំង នឹង ការគេចវេស ពី ការរឹតបន្តឹង ពាណិជ្ជកម្ម ដែល មាន ស្រាប់ តាមរយៈ ប្រទេស ទី បី បន្ទាប់ពី សហភាព អឺរ៉ុប បាន កំណត់ ប្រទេស ចិន តួកគី អារ៉ាប់ រួម ក៏ ដូចជា បណ្តា ប្រទេស នៅ អាស៊ី កណ្តាល និកូកាស៊ីស ជា ប្រទេស ជាប់ ការសង្ស័យ ដ៏ មាន សក្តានុពល ។
ក្រុម អ្នកការទូត ដែល ដឹង អំពី សំណើ នេះ បាន និយាយ ថា ក្រុមហ៊ុន ចិន ចំនួន ប្រាំពីរ នឹង ទទួលរង ការបង្កក ទ្រព្យសម្បត្តិ នៅក្នុង សហភាព អឺរ៉ុប ដែល ជា អ្វី ដែល នឹង ក្លាយជា ដំបូង សម្រាប់ ប្លុក នេះ ក្នុង ការដាក់ទណ្ឌកម្ម លើ ប្រទេស ចិន ចំពោះ ការចោទប្រកាន់ ពី តួនាទី របស់ ទីក្រុង ប៉េកាំង នៅក្នុង សង្គ្រាម របស់ រុស្ស៊ី នៅ អ៊ុយក្រែន ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជួប សំណេះសំណាល ជាមួយ រដ្ឋមន្ត្រី ទទួលបន្ទុក សម្របសម្រួល សន្តិសុខ ជាតិ សិង្ហបុរី
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ទទួល ជួប សំណេះសំណាល ជាមួយ លោក Teo Chee Hean ទេសរដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ទទួលបន្ទុក សម្របសម្រួល សន្តិសុខ ជាតិ នៃ សាធារណរដ្ឋ សិង្ហបុរី ដែល បាន ដឹកនាំ គណៈប្រតិភូ មក បំពេញ ទស្សនកិច្ច ទ្វេ ភាគី នៅ កម្ពុជា និង ដើម្បី ចូលរួម ទស្សនា ព្រឹត្តិការណ៍ កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ ឆ្នាំ ២០២៣ ។
ក្នុង ជំនួប នេះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន រំឭក អំពី ចំណង មិត្តភាព ជិតស្និទ្ធ និង យូរអង្វែង រវាង កម្ពុជា - សិង្ហបុរី រាប់ ពី ការចាប់ផ្តើម នៃ ទំនាក់ទំនង ការទូត ដំបូង ក្នុង ឆ្នាំ ១៩៦៥ ក្រោយពេល ដែល សិង្ហបុរី ក្លាយជា រដ្ឋ ឯករាជ្យ ដែល នៅ ពេល នោះ កម្ពុជា ស្ថិត នៅក្នុង ចំណោម ប្រទេស ដំបូង បង្អស់ ដែល បាន ទទួលស្គាល់ ឯករាជ្យ របស់ សិង្ហបុរី ។
ជា ការឆ្លើយតប លោក Teo Chee Hean បាន សម្តែង នូវ ការពេញចិត្ត ចំពោះ លទ្ធផល កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី កម្ពុជា - សិង្ហបុរី ដែល កំពុង មាន វឌ្ឍនភាពរីកចម្រើន ទៅ មុខ គួរឲ្យ កត់សម្គាល់ និង បាន ថ្លែង នូវ ការកោតសរសើរ ចំពោះ ជោគជ័យ របស់ កម្ពុជា ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ ព្រឹត្តិការណ៍ ធំ ៗ ជា លក្ខណៈ តំបន់ ជាច្រើន ជាពិសេស ភាព ជា ប្រធាន អាស៊ាន ឆ្នាំ ២០២២ និង ព្រឹត្តិការណ៍ កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ឆ្នាំ ២០២៣ ។
ក្នុង នេះ លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន ថ្លែងអំណរគុណ ផងដែរ ចំពោះ ការទទួល បដិសណ្ឋារកិច្ច ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ អត្តពលិក និង គណៈប្រតិភូ កីឡា របស់ សាធារណរដ្ឋ សិង្ហបុរី ដែល កំពុង ចូលរួម ការប្រកួត នៅ កម្ពុជា ៕
លោក បាន បន្ថែម ថា អ៊ីរ៉ង់ នឹង មិន អនុញ្ញាតឱ្យ ប្រព័ន្ធ ផ្សព្វផ្សាយ ដែល គ្មាន មូលដ្ឋាន អះអាង ប្រឆាំង នឹង សកម្មភាព នុយក្លេអ៊ែរ ដោយ សន្តិវិធី របស់ ប្រទេស នេះ ក្លាយជា ឧបសគ្គ ចំពោះ កិច្ចសហប្រតិបត្តិការ របស់ ខ្លួន ជាមួយ IAEA ឡើយ ។
គួរ បញ្ជាក់ ថា ទីភ្នាក់ងារ IAEA កាលពី ថ្ងៃពុធ សប្តាហ៍ មុន បាន ប្រកាស ថា ខ្លួន កំពុង ដំឡើង កាមេរ៉ា ឃ្លាំមើល របស់ ខ្លួន ឡើងវិញ នៅ កន្លែង នុយក្លេអ៊ែរ អ៊ីរ៉ង់ ។
ក្រុមប្រឹក្សាភិបាល របស់ IAEA បាន អនុម័ត កាលពី ខែវិច្ឆិកា នូវ ដំណោះស្រាយ មួយ ដោយ ជំរុញ ឱ្យ ប្រទេស អ៊ីរ៉ង់ សហការ ជាមួយ អ្នក ស៊ើបអង្កេត របស់ ទីភ្នាក់ងារ នេះ ទាក់ទង នឹង ដាន អ៊ុយរ៉ាញ៉ូម ដែល បាន រកឃើញ នៅ ទីតាំង មិន បាន បញ្ជាក់ ចំនួន បី របស់ អ៊ីរ៉ង់ ។
ក្នុង អំឡុង ពេល ដំណើរទស្សនកិច្ច របស់ លោក Grossi ទៅកាន់ ទីក្រុង តេហេរ៉ង់ ក្នុង ខែមីនា ភាគី ទាំង ពីរ បាន ឈានដល់ កិច្ចព្រមព្រៀង មួយ ស្តីពី អន្តរកម្ម បន្ថែម ទៀត ដោយ ផ្អែក លើ កិច្ចសហប្រតិបត្តិការ របស់ អ៊ីរ៉ង់ និង ការបើកចំហ កាន់តែ ខ្លាំង ចំពោះ ការត្រួតពិនិត្យ របស់ ទីភ្នាក់ងារ IAEA ៕ ចំណេះដឹង ទូទៅ៖ សត្វ សំខាន់ ៗ ក្នុង វប្បធម៌ ប្រជាជាតិ អាស៉ី អាគ្នេយ៍ ទាំង ១១ប្រទេស
