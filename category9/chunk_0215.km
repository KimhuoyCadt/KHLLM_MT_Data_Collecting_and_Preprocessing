លោក សុខ មីន មេបញ្ជាការ កងរាជអាវុធហត្ថ ស្រុក អូរយ៉ាដាវ មានប្រសាសន៍ ថា កាលពី ដើម ខែមីនា មន្ត្រី កងរាជអាវុធហត្ថ ស្រុក និង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស បាន ចុះល្បាត ព្រៃ ពេល ឃើញ មនុស្ស ៥នាក់ ដឹកជញ្ជូន ឈើ តាម ម៉ូតូ ៣ គ្រឿង ។
ក្រោយពេល កើត ហេតុ កម្លាំង អាវុធហត្ថ បាន ធ្វើ ការស៊ើបអង្កេត រយៈពេល មួយ សប្តាហ៍ មុននឹង សុំ អន្តរាគមន៍ ពី តុលាការ ។ បន្ទាប់មក តុលាការ បាន ចាត់ ព្រះរាជអាជ្ញា រង លាង អ៊ូ ឲ្យ ធ្វើ ការ លើ ករណី នេះ ។
ដោយ មាន ការឯកភាព ពី លោក លាង អ៊ូ កងរាជអាវុធហត្ថ បាន ចាប់ខ្លួន ជនសង្ស័យ កាលពី ថ្ងៃទី ១៥ ខែមីនា ហើយក៏ ត្រូវបាន គេ និយាយ ថា បាន ធ្វើតេស្ត រកឃើញ សារធាតុ ញៀន បន្ទាប់ពី ចាប់ខ្លួន ។ លោក បាន មានប្រសាសន៍ ថា៖ ករណី នេះ ទាក់ទង នឹង ការប៉ុនប៉ង ធ្វើឃាត មន្ត្រី កងរាជអាវុធហត្ថ ជាតិ ។
លោក ថា ពួកគេ ក៏ កំពុង តាម ស្វែងរក ជនសង្ស័យ ៤នាក់ ទៀត ពាក់ព័ន្ធ នឹង ករណី នេះ ហើយ ក្រោយពេល កើត ហេតុ ជន ដៃ ដល់ មួយចំនួន ត្រូវបាន សង្ស័យ ថា បាន រត់គេចខ្លួន ទៅ ប្រទេស វៀតណាម ជិតខាង ។
អាជ្ញាធរ ខណ្ឌ ឬស្សីកែវ បាន បិទ ទីតាំង ហ្គេម បាញ់ ត្រី ខុស ច្បាប់ ស្ថិត ក្នុង ភូមិ ស្វាយប៉ាក សង្កាត់ ស្វាយប៉ាក បន្ទាប់ពី មាន ប្រតិកម្ម ពី អ្នកស្រុក ដែល ទីបំផុត ឃើញ អ្នកភូមិ ប្រមាណ ១០០ នាក់ ចុះ មក លេង ក្នុង បរិវេណ នោះ បណ្តាលឲ្យ ខូចខាត ម៉ាស៊ីន ។
អ្នកស្រុក បាន និយាយ ថា រហូតមកដល់ ពេលនេះ អាជ្ញាធរ បាន បដិសេធ មិន ចាត់ វិធានការប្រឆាំង នឹង ល្បែង ខុស ច្បាប់ ដែល ល្បី ថា ជា ការលើកទឹកចិត្ត ល្បែងស៊ីសង និង អាកប្បកិរិយា ប្រឆាំង សង្គម ដូច្នេះ អ្នកភូមិ បាន យក បញ្ហា មក ដាក់ ក្នុង ដៃ របស់ ពួកគេ នៅ ថ្ងៃអាទិត្យ ។
យើង បាន ដាក់ពាក្យបណ្ដឹង ទៅ អាជ្ញាធរ មូលដ្ឋាន សុំ ឱ្យ ពួកគេ បង្ក្រាប ទីតាំង ដែល មាន ម៉ាស៊ីន អា ខេត ខុស ច្បាប់ ។ ប៉ុន្តែ គ្មាន អ្នកណា ម្នាក់ ពី ប៉ូលិស ឆ្លើយតប ទេ ។
ហ្គេម បាន ធ្វើឲ្យ ក្មេង ៗ នៅក្នុង ភូមិ គេច ពី ការសិក្សា ហើយ ថែមទាំង លួច ពី ក្រុមគ្រួសារ របស់ ពួកគេ ដើម្បី បន្ត ការភ្នាល់ ហ្គេម ។
នៅ យប់ ថ្ងៃទី ១៣ ខែមីនា មនុស្ស មួយ ក្រុម មាន គ្នា ៦នាក់ បាន ចេញមក ក្រៅ ផ្ទះ ហើយ បាន លួច ទូរសព្ទ័ ដៃ ២គ្រឿង ពី ភូមិ ហើយ បំផ្លាញ ម៉ូតូ ។
លោក បាន មានប្រសាសន៍ ថា៖ ដោយ មាន អាកប្បកិរិយា នេះ អ្នកស្រុក មាន គ្រប់គ្រាន់ ហើយ នៅ ព្រឹក ថ្ងៃអាទិត្យ អ្នកភូមិ បាន សម្រុក ទៅ កន្លែង ដើម្បី បំផ្លាញ ហ្គេម នេះ ។
លោក បន្ត ថា បន្ទាប់ពី អ្នកភូមិ ខូច ទូហ្គេម រួច កម្លាំង នគរបាល ខណ្ឌ ឬស្សីកែវ បាន មកដល់ នៅ ថ្ងៃ ដដែល ប្រមូល យក វត្ថុតាង ទាំងអស់ មកកាន់ អធិការដ្ឋាន នគរបាល ខណ្ឌ ។ ពួកគេ ក៏ បាន បញ្ជា ឱ្យ ម្ចាស់ ហ្គេម ចុះ កិច្ចសន្យា យល់ព្រម បញ្ឈប់ ដំណើរការហ្គេម បាញ់ប្រហារ គ្រប់ ប្រភេទ ។
យុវជន ងី យ៉ាំង ទឹង អាយុ ១៧ ឆ្នាំ អះអាង ថា ខ្លួន ជា ជន រងគ្រោះ ក្នុង អំពើ ប្លន់ ដោយ ជន មិន ស្គាល់ អត្តសញ្ញាណ ចំនួន ៦ នាក់ ដែល ចេញ ពី កន្លែង លេង ល្បែង កាលពី យប់ ថ្ងៃទី ១៣ ខែមីនា ។
ខ្ញុំ បារម្ភ ថា ខ្ញុំ នឹង ត្រូវ គេ ប្ដឹង ព្រោះ ខ្ញុំ នៅក្នុង ហ្វូង មនុស្ស នៅ ថ្ងៃ នោះ ពេល អ្នកភូមិ ចុះ ទៅ កន្លែង នោះ ។ ខ្ញុំ មិន ចង់ ប្តឹង ទេ ។
អធិការ នគរបាល ខណ្ឌ ឬស្សីកែវ លោក ហ៊ាង ថា រ៉េត បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃចន្ទ ថា លោក បាន បញ្ជា ឲ្យ មន្ត្រី របស់ លោក បិទ ទីតាំង និង បាន រឹបអូស ទូហ្គេម ទាំងអស់ ដែល បំផ្លាញ ដោយ អ្នកភូមិ ។
លោក បាន មានប្រសាសន៍ ថា ទោះបីជា សកម្មភាព របស់ អ្នកភូមិ ហួស ពី ដែន កំណត់ នៃ ច្បាប់ ក៏ដោយ វា ក៏ បាន បង្ហាញ ពី ការគាំទ្រ និង ការចូលរួម របស់ ពួកគេ នៅក្នុង គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព របស់ រដ្ឋាភិបាល ផងដែរ ។
តុលាការ ខេត្ត ក្រចេះ នៅ ថ្ងៃចន្ទ នេះ បាន ដោះលែង សកម្មជន ព្រៃឈើ បួន នាក់ បន្ទាប់ពី អ្នកតវ៉ា នៅ ខាងក្រៅ តុលាការ ទាមទារ ឱ្យ ដោះលែង ពួកគេ ។
លោក ហេង ស្រស់ ក៏ ជា សកម្មជន ការពារ ព្រៃឈើ បាន ស្វាគមន៍ ចំពោះ ការសម្រេច នេះ ។
នេះ ជា ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ ប៉ុន្តែ ខ្ញុំ ក៏ សោកស្ដាយ ដែរ ដែល ពួកគេ ត្រូវបាន ឃុំ ខ្លួន រយៈពេល ៣ ថ្ងៃ ដោយ គ្មាន ភស្តុតាង ពី ដំបូង ។
លោក ថ្លែង ថា៖ នេះ បង្ហាញ ថា អ្វី ដែល ប៉ូលិស ចង់បាន គឺ បំបាក់ ស្មារតី សកម្មជន ព្រៃឈើ ដើម្បី កុំ ឲ្យ ប្រជាពលរដ្ឋ ហ៊ាន ប្រយុទ្ធ ដើម្បី ព្រៃឈើ ។
លោក ស រស់ បាន និយាយ ទៅកាន់ កាសែត ភ្នំពេញ ប៉ុស្តិ៍ ខណៈ លោក កាន់ សញ្ញា ថា អ្នក កាប់ ឈើ ត្រូវបាន អនុញ្ញាតឱ្យ ដើរ ដោយ សេរី ប៉ុន្តែ អ្នក ដែល ការពារ ព្រៃឈើ ត្រូវបាន ចាប់ខ្លួន ។ សញ្ញា បង្ហាញ រូបភាព សកម្មជន ទាំង បួន នាក់ ដែល បាន ចេញផ្សាយ កាលពី ថ្ងៃចន្ទ ។
លោក ស រស់ កត់សម្គាល់ ថា៖ ចៅក្រម ស៊ើបសួរ និង ព្រះរាជអាជ្ញា ខេត្ត ក្រចេះ សម្រេច ដោះលែង សកម្មជន ប៉ុន្តែ តុលាការ បាន ដាក់ ឲ្យ ស្ថិត ក្រោម ការត្រួតពិនិត្យ ។
ទាំង អ្នកនាំពាក្យ តុលាការ ខេត្ត ក្រចេះ លោក ទីវ វុធ នោះ និង លោក ជា សុភ័ក្រ ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត មិន អាច ទាក់ទង សុំ ការអត្ថាធិប្បាយ បាន ទេ កាលពី ថ្ងៃចន្ទ ។
លោក Sros បាន និយាយ ថា សកម្មជន ទាំង បួន នាក់ ត្រូវបាន ចាប់ខ្លួន អំឡុង ពេល ដើរល្បាត ព្រៃ ។ ពួកគេ បាន ទៅ ហាង មួយ ដែល ស្ថិត នៅលើ អចលន ទ្រព្យ របស់ ក្រុមហ៊ុន ដើម្បី ទិញ ទឹក នៅពេល សន្តិសុខ ក្រុមហ៊ុន ចាប់ ពួកគេ ដោយ ប្រើ អំពើហិង្សា លើ ពួកគេ យ៉ាងតិច ម្នាក់ ។
អ្នកនាំពាក្យ សមាគម ការពារ សិទ្ធិ មនុស្ស អាដហុក លោក ស៊ឹង សែន ករុណា បាន និយាយ នៅ ថ្ងៃចន្ទ នេះ ថា តុលាការ កំពុង ស៊ើបអង្កេត លើ អ្នកយាម ដែល បាន ប្រើ អំពើហិង្សា លើ សកម្មជន នេះ ។
