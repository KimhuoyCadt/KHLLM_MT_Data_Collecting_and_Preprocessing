ប៉ុន្តែ ក្រុមហ៊ុន លក់ និង ជួល គ្រឿងចក្រ នៅ កម្ពុជា ។ ហេតុ អ្វី បានជា ក្រុមហ៊ុន មិន ជួល ពួកគេ ? ចាន់ថុល សួរ ។
លិខិត ព្រមាន កាលពី ថ្ងៃទី ៥ ឧសភា ត្រូវបាន លោក រដ្ឋមន្ត្រី ផ្ញើ មក បន្ទាប់ពី លោក រកឃើញ ថា ក្រុមហ៊ុន គ្មាន បទពិសោធន៍ សាងសង់ ផ្លូវ និង ខុស បច្ចេកទេស ។
លោក ហ៊ាង សុធាយុទ្ធ អ្នកនាំពាក្យ ក្រសួង បាន និយាយ កាលពី ថ្ងៃព្រហស្បតិ៍ ថា គម្រោង កែលម្អ ផ្លូវ ជាតិ លេខ ២ និង ២២ នឹង ត្រូវ ចំណាយ ថវិកា ជាង ៥៦ លាន ដុល្លារ ដែល ចំណាយ សម្រាប់ ជំនួយ ពី សាធារណរដ្ឋ កូរ៉េ និង រដ្ឋាភិបាល កម្ពុជា ។
ពិធី បើក ការដ្ឋាន សាងសង់ ផ្លូវ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ១១ ខែកុម្ភៈ ក្រោម អធិបតីភាព លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ។
លោក រដ្ឋមន្ត្រី បាន ផ្តល់ ឱសានវាទ ដល់ ក្រុមហ៊ុន ។ លោក ក៏ បាន ណែនាំឲ្យ ពន្លឿន កិច្ច ខិតខំ ប្រឹងប្រែង ក្នុង ការសាងសង់ ។
សាលាដំបូង រាជធានី ភ្នំពេញ នៅ ថ្ងៃសៅរ៍ នេះ បាន បញ្ជូន បុរស ពីរ នាក់ ទៅ ពន្ធនាគារ ព្រៃស ក្នុង ឃុំ ខ្លួន បណ្តោះអាសន្ន ពី បទ ជួញដូរ មេតំហ្វេតាមីន ជិត ៤គីឡូក្រាម ។ ពួកគេ ត្រូវបាន ឃុំ ខ្លួន កាលពី ថ្ងៃសុក្រ ក្នុង រាជធានី ភ្នំពេញ ។
លោក អ៊ិន សុង អនុប្រធាន នាយកដ្ឋាន ប្រឆាំង គ្រឿងញៀន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃអាទិត្យ ថា ជនសង្ស័យ មាន ឈ្មោះ ហេង សុថានិត អាយុ ២៨ ឆ្នាំ និង ឈ្មោះ សេង ជេមមី អាយុ ២៤ ឆ្នាំ ។
លោក ថ្លែង ថា៖ អ្នក ទាំង ពីរ ត្រូវ តុលាការ ចោទប្រកាន់ ពី បទ ជួញដូរ គ្រឿងញៀន តាម មាត្រា ៤០ នៃ ច្បាប់ ស្ដីពី ការត្រួតពិនិត្យ គ្រឿងញៀន ។
លោក សុង បន្ត ថា អាជ្ញាធរ បាន ធ្វើ ប្រតិបត្តិការ នៅ បី ទីតាំង ផ្សេង គ្នា ដើម្បី ចាប់ ជនសង្ស័យ ។
ការចុះបង្ក្រាប លើក ទី១ បាន ធ្វើឡើង នៅលើ ផ្លូវ ជាតិ លេខ ៤ ក្នុង ឃុំ វសា ស្រុក សំរោងទង ខេត្ត កំពង់ស្ពឺ កាលពី ថ្ងៃទី ១៨ ឧសភា ។
ក្នុង ការបង្ក្រាប នេះ សមត្ថកិច្ច រឹបអូស បាន មេតំហ្វេតាមីន ៤១១. ៥៦ ក្រាម ។
ប្រតិបត្តិការ ចាក់ សាំង លើក ទី២ បាន កើតឡើង នៅ ថ្ងៃទី ២០ ឧសភា នៅ ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ ។
ប្រតិបត្តិការ ចុងក្រោយ បាន ធ្វើឡើង កាលពី ថ្ងៃសុក្រ ក្នុង រដ្ឋធានី ហើយ អាជ្ញាធរ បាន ដកហូត ថ្នាំ ញៀន ប្រភេទ មេតំហ្វេតាមីន ២៥១. ៦៨ ក្រាម ។
សរុប សមត្ថកិច្ច រឹបអូស បាន ថ្នាំ ញៀន ៣. ៥៤ គីឡូក្រាម បន្ថែម ពីលើ ការឃាត់ខ្លួន ជនសង្ស័យ ទាំង ពីរ នាក់ ។ គេ ក៏ បាន រកឃើញ ស្លាកលេខ រថយន្ត ចំនួន ពីរ ដែល ពួកគេ យកមក រក្សាទុក ជា ភស្តុតាង ។
នៅក្នុង ករណី ដាច់ដោយឡែក មួយ អនុប្រធាន មន្ទីរ ប្រឆាំង គ្រឿងញៀន ខេត្ត កំពង់ឆ្នាំង លោក ឃឹម សុជាតិ បាន និយាយ កាលពី ថ្ងៃអាទិត្យ ថា ជនសង្ស័យ ចំនួន ២០ នាក់ ដែល សមត្ថកិច្ច ឃាត់ខ្លួន កាលពី ថ្ងៃសុក្រ ត្រូវបាន បញ្ជូន ទៅ ពន្ធនាគារ ខេត្ត កាលពី ថ្ងៃសៅរ៍ ។
លោក បន្ត ថា ពួកគេ ក៏ ត្រូវ ចោទប្រកាន់ ពី បទ ប្រើប្រាស់ និង ជួញដូរ គ្រឿងញៀន តាម មាត្រា ៤០ នៃ ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ គ្រឿងញៀន ។
ខ្ញុំ មិន ដឹង ថា តើ ពួកគេ ប៉ុន្មាន នាក់ ត្រូវបាន ចោទប្រកាន់ ពី បទ ជួញដូរ មនុស្ស ហើយ ប៉ុន្មាន នាក់ ត្រូវបាន ចោទប្រកាន់ ពី បទ ប្រើប្រាស់ ។ ខ្ញុំ គ្រាន់តែ ដឹង ថា ពួកគេ ត្រូវបាន តុលាការ បញ្ជូន ទៅ ឃុំ ខ្លួន ។
លោក បាន បន្ថែម ថា ក្នុង ប្រតិបត្តិការ ចុង សប្តាហ៍ នេះ សមត្ថកិច្ច បាន ដកហូត ថ្នាំ ញៀន មេតំហ្វេតាមីន ៣ កញ្ចប់ តូច ។
នាយក កម្មវិធី ប្រចាំ ប្រទេស របស់ ខ្លួន លោក ខេន សេរី មានប្រសាសន៍ ថា ដោយ មាន ការគាំទ្រ ជា បន្តបន្ទាប់ពី ម្ចាស់ ជំនួយ របស់ យើង និង កិច្ចសហប្រតិបត្តិការ ល្អ ពី រដ្ឋបាល ជលផល បូករួម ទាំង ការប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ របស់ បុគ្គលិក វាល របស់ យើង និង ក្រុមការពារ សំបុក សហគមន៍ WCS មាន ការរីកចម្រើន គួរឱ្យ កត់សម្គាល់ ក្នុង ការអនុវត្ត គម្រោង របស់ ខ្លួន ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ កន្លងមក នេះ ។ រដ្ឋា ។
លោក បាន មានប្រសាសន៍ ថា ការកើនឡើង នៃ ចំនួន សំបុក និង ពង របស់ អណ្តើក មាន សំបក ទន់ បាន ជំរុញ យើង ឱ្យ ខិតខំ ប្រឹងប្រែង បន្ថែម ទៀត លើ ការអភិរក្ស ប្រភេទ សត្វ ជិត ផុត ពូជ នេះ ។
ប្រធាន នាយកដ្ឋាន អភិរក្ស ជល ផល នៃ រដ្ឋបាល ជលផល លោក អ៊ុក វិបុល មានប្រសាសន៍ ថា លោក កោតសរសើរ ចំពោះ កិច្ចសហប្រតិបត្តិការ រវាង អាជ្ញាធរ មូលដ្ឋាន សហគមន៍ និង អង្គការ WCS ហើយ បាន ជំរុញឱ្យ ភាគី ទាំងអស់ បន្ត ការពារ អណ្តើក និង អនុញ្ញាតឱ្យ ពួកវា រស់ នៅក្នុង ជម្រក ធម្មជាតិ របស់ ពួកគេ ។
លោក សង្កត់ធ្ងន់ ថា អ្នកណា ដែល ជួញដូរ សត្វ ការពារ នឹង ត្រូវ ប្រឈមមុខ នឹង ច្បាប់ ។
ក្នុង នាម ជា អង្គការ អភិរក្ស សត្វ ព្រៃ លើស ពី ការថែទាំ សត្វ នៅក្នុង សួន សត្វ របស់ យើង ទំនួល ខុសត្រូវ របស់ យើង ក៏ ពង្រីក ដល់ ការការពារ ប្រភេទ សត្វ ដែល រង ការគំរាមកំហែង នៅក្នុង ព្រៃ ផងដែរ ។
អណ្តើក ជិត ផុត ពូជ បាន បង្ហាញ ខ្លួន ក្នុង រយៈពេល ខ្លី នៅក្នុង ប្រទេស ឡាវ ប៉ុន្តែ ពួកវា ត្រូវបាន រុញ ចេញ ពី អតីត ផ្ទះ របស់ ពួកគេ ក្នុង ប្រទេស វៀតណាម និង ប្រទេស ថៃ ភាគ ច្រើន ដោយសារតែ អ្នក ប្រមាញ់ និង ឈ្មួញ ដែល ឱ្យ តម្លៃ សត្វ អណ្តើក ពេញ វ័យ និង ពង របស់ វា ។
សត្វ អណ្តើក នេះ មិន ត្រូវបាន គេ ប្រទះឃើញ នៅ គ្រប់ ទីកន្លែង ក្នុង ពិភពលោក ចន្លោះ ពី ឆ្នាំ ២០០៣ ដល់ ២០០៧ នោះ ទេ ប៉ុន្តែ វា បាន លេចឡើង ម្តង ទៀត នៅលើ ដង ទន្លេ មេគង្គ រវាង ខេត្ត ក្រចេះ និង ខេត្ត ស្ទឹងត្រែង ។
WCS និង រដ្ឋបាល ជលផល បាន ចាប់ផ្តើម អភិរក្ស ប្រភេទ សត្វ ក្នុង ឆ្នាំ 2017 ដោយ ការប្រយុទ្ធ ប្រឆាំង នឹង ការចាប់ យក ខុស ច្បាប់ របស់ ពួកគេ ការការពារ សំបុក របស់ ពួកគេ និង គាំទ្រ សហគមន៍ ជុំវិញ ជម្រក សត្វ អណ្តើក ។
ព្រះតេជគុណ ឡុង ចន្ថា ចេញ លិខិត មួយ ច្បាប់ កាលពី ថ្ងៃទី ១៨ ខែឧសភា បង្គាប់ ឲ្យ គ្រប់ វត្ត ទាំងអស់ ក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ឃាត់ ព្រះអង្គ បន្ទាប់ពី ព្រះអង្គ បាន ជជែក ជាមួយ នារី ម្នាក់ តាម ហ្វេសប៊ុក ។
ព្រះតេជគុណ កែវ សាវន ខេត្ត តាកែវ បាន បញ្ជាក់ ថា ចន្ថា បាន ចុះ កិច្ចសន្យា លា លែង ពី ព្រះសង្ឃ តាំងពី ព្រះអង្គ បាន រត់ ចេញ ពី វត្ត យ៉ាង សំខាន់ ។
លិខិត នោះ អាន ថា ព្រះតេជគុណ ហ៊ូ ឈីវ សមាជិក លេខាធិការដ្ឋាន ព្រះចៅ អធិការ វត្ត នៃ ព្រះរាជាណាចក្រ កម្ពុជា មាន សង្ឃ ដីកា ថា សម្តេច នង ង៉ែត បាន ចេញ លិខិត មួយ ច្បាប់ ដល់ គ្រប់ វត្ត ទាំងអស់ ក្នុង ព្រះរាជាណាចក្រ ដើម្បី ហាម ចន្ថា ។
ព្រះអង្គ បាន មាន សង្ឃ ដីកា ថា៖ ដោយសារ គាត់ មិន បាន ចាកចេញ ពី ព្រះសង្ឃ ដូច ក្នុង កិច្ចសន្យា បើ វត្ត ណា ឃើញ គាត់ ធ្វើ តាម កិច្ចសន្យា ដែល គាត់ សន្យា ថា នឹង ចាកចេញ ពី ព្រះសង្ឃ ។
ព្រះតេជគុណ កែវ សាវន ខេត្ត តាកែវ មាន សង្ឃ ដីកា នៅ ថ្ងៃអង្គារ នេះ ថា ចន្ថា បាន ទៅ ចុះ កិច្ចសន្យា ជាមួយ ព្រះអង្គ នៅ ថ្ងៃទី ១៤ ខែឧសភា ។ ព្រះអង្គ មានបន្ទូល ថា ព្រះអង្គ បាន សរសេរ កិច្ចសន្យា ថា ចន្ថា នឹង ចាកចេញ ពី ព្រះសង្ឃ ដោយ ខ្លួន ឯង ប៉ុន្តែ ចន្ថា មក គង់ នៅ វត្តភ្នំ បូរី ព្រែក ព្នៅ ។ ឃុំ ស្រុក អង្គរ បូរី ខេត្ត តាកែវ ទោះបី លោក ជា ព្រះសង្ឃ ដែល រត់គេចខ្លួន តាម បច្ចេកទេស ក៏ដោយ ។
កិច្ចសន្យា គឺ អំពី ការចាកចេញ ពី ព្រះសង្ឃ ហើយ លោក បាន ស្ម័គ្រចិត្ត ។ គ្មាន នរណា បង្ខំ គាត់ ទេ ។
ព្រះចៅ អធិការ ខេត្ត កំពង់ចាម លោក ប៊ត តាំង ឆេង មានប្រសាសន៍ ថា លោក បាន ទទួល លិខិត ពី ព្រះចៅ អធិការ នៃ ប្រទេស កម្ពុជា កាលពី ថ្ងៃអង្គារ ។ លោក ថា ខ្លួន ហាម មិន ឲ្យ ចៅអធិការ វត្ត ក្នុង ព្រះរាជាណាចក្រ អនុញ្ញាតឲ្យ ចន្ថា ស្នាក់ នៅ ។
យោង តាម លិខិត នោះ សម្តេច ព្រះមហា សុមេធាធិបតី នន្ទ ង៉ែត បាន សរសេរ ថា គណៈកម្មាធិការ ព្រះសង្ឃ ប្រគេន ដល់ ព្រះចៅ អធិការ ទាំង ២៥ រាជធានី - ខេត្ត ដែល គណៈកម្មាធិការ កំពុង អនុវត្ត តាម លទ្ធផល នៃ អង្គ សវនាការ និង ដំណោះស្រាយ របស់ តុលាការ ខេត្ត តាកែវ ក្នុង ទាក់ទង នឹង ចន្ថា ។
លោក បាន សរសេរ ថា ព្រះសង្ឃ ចាត់ទុក ថា ចន្ថា ជា មនុស្ស រឹងរូស មិន ប្រៀន ប្រដៅ ឬ អប់រំ ហើយ ការលះបង់ ចំពោះ ការគ្រប់គ្រង ព្រះសង្ឃ លែង មាន នៅក្នុង បព្វជិត ព្រះពុទ្ធ សាសនា ទៀត ហើយ ។
ច្បាប់ ចម្លង នៃ កិច្ចសន្យា មិន មាន ទេ ។
ទាហាន ថៃ នៅ តាម ព្រំដែន កម្ពុជា - ថៃ បាន ចាប់ខ្លួន ពលរដ្ឋ ខ្មែរ ៨២ នាក់ កាលពី ព្រឹក ថ្ងៃពុធ ខណៈ ពួកគេ ព្យាយាម ចូល ប្រទេស ថៃ ដោយ ខុស ច្បាប់ តាម ច្រក ព្រំដែន តូច ក្នុង ខេត្ត បន្ទាយមានជ័យ និង ស្រុក អារញ្ញ ក្នុង ប្រទេស ថៃ ។
នាយ ឧត្តមសេនីយ៍ ឈុន ម៉ៅ មេបញ្ជាការ រង យោធភូមិភាគ ទី៥ ខេត្ត បន្ទាយមានជ័យ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ក្នុង ចំណោម ក្រុម ទាំងនោះ មាន ស្ត្រី ចំនួន ៣៣ នាក់ និង កុមារ ៥ នាក់ ។
ពួកគេ ត្រូវបាន ឃុំ ខ្លួន ពី បទ ព្យាយាម ឆ្លងកាត់ ក្បែរ ច្រក អូរ បី ជាន់ ក្នុង ស្រុក អូរ ជ្រៅ ។ ប៉ុស្តិ៍ តាកែល ស្រុក ស្វាយ ចេក ; ច្រក បន្ទាយរិទ្ធ នៅ ស្រុក ថ្ម ពួក និង ច្រក ប៉ោយប៉ែត ស្រុក ប៉ោយប៉ែត ។
លោក បាន មានប្រសាសន៍ ថា៖ បន្ទាប់ពី ធ្វើតេស្ត រក ជំងឺ កូវីដ - ១៩ ពួកគេ បាន ទទួល ការអប់រំ ហើយ ត្រឡប់ មកវិញ ឆ្លង ព្រំដែន វិញ ។
ពួកគេ ត្រូវបាន បញ្ជូន ទៅ មណ្ឌល ឆ្លងកាត់ ស្រុក អូរ ជ្រៅ និង ស្រុក ស្វាយ ចេក ដើម្បី អនុវត្ត តាម វិធានការ របស់ ក្រសួង សុខាភិបាល លើកលែងតែ បុរស ម្នាក់ ដែល គេ ជឿ ថា ជា មេដឹកនាំ ។
បុរស នោះ ត្រូវបាន គេ ស្គាល់ ឈ្មោះ ឃៀន ភាន អាយុ៣០ ឆ្នាំ រស់ នៅ ឃុំ ស្រែ ស្តុក ស្រុក កណ្តៀង ខេត្ត ពោធិ៍សាត់ ។ ជនសង្ស័យ ត្រូវបាន បញ្ជូន ទៅ ប៉ុស្តិ៍ នគរបាល អូរ ជ្រៅ ។
ប៉ុន្មាន ខែ ចុងក្រោយ នេះ នគរបាល ព្រំដែន កម្ពុជា និង ថៃ បាន សហការ គ្នា ទប់ស្កាត់ ពលរដ្ឋ មិន ឲ្យ ព្យាយាម ស្វែងរក ការងារ ខុស ច្បាប់ នៅ ប្រទេស ថៃ ។
មន្ត្រី និយាយ ថា វា ទទួលបាន ជោគជ័យ គួរឲ្យ កត់សម្គាល់ ប៉ុន្តែ នៅ មាន ពលរដ្ឋ មួយចំនួន ដែល លួច ចូល ប្រទេស ថៃ ។
យើង សោកស្ដាយ ដែល ពលរដ្ឋ ខ្មែរ ១៦ នាក់ បាន លួច ចូល ប្រទេស ថៃ ដោយ ខុស ច្បាប់ កាលពី ថ្ងៃចន្ទ ហើយ ពួកគេ ត្រូវបាន ចាប់ខ្លួន នៅ ឃុំ បារាយណ៍ ស្រុក អារញ្ញ ។ មាន មនុស្ស ម្នាក់ ដែល រងរបួស ជើង ខណៈ ព្យាយាម រត់គេចខ្លួន ។
លោក ថា បុរស រងគ្រោះ ឈ្មោះ ផាត់ ថៃ អាយុ ៣៦ ឆ្នាំ រស់ នៅ ក្រុង ប៉ោយប៉ែត ។ ក្រោយពី ឃាត់ខ្លួន បាន បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ ក្នុង ប្រទេស ថៃ ។
លោក បាន បន្ត ថា ជន ទាំង ១៦ នាក់ ត្រូវបាន បញ្ជូន ត្រឡប់ ទៅ មណ្ឌល ឆ្លងកាត់ កម្ពុជា ដើម្បី ដាក់ ឱ្យ នៅ ដាច់ដោយឡែក រយៈពេល ១៤ ថ្ងៃ លើកលែងតែ ជនជាតិ ថៃ ម្នាក់ ដែល ត្រូវបាន បញ្ជូន មកកាន់ អធិការដ្ឋាន នគរបាល ក្រុង ប៉ោយប៉ែត ។
កាលពី ថ្ងៃទី ១៣ ខែឧសភា រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ លោក ស ខេង បាន បញ្ជា ឱ្យ អភិបាល ខេត្ត ជាប់ ព្រំដែន ប្រទេស ផ្សេង ទៀត ទប់ស្កាត់ ពលរដ្ឋ ឆ្លង ដែន ដោយ ខុស ច្បាប់ ខណៈ ដែល ប្រទេស ទាំងនោះ ស្ថិត ក្នុង ភាពអាសន្ន ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
