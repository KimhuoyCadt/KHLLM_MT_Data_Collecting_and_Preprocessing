លោក Muntarbhorn បាន លើក យក ប្រធានបទ ជាក់លាក់ នៃ ក្តីកង្វល់ សម្រាប់ ពិភាក្សា ជាមួយ លោក ស ខេង រួមទាំង ពន្ធនាគារ និង មណ្ឌល ឃុំឃាំង ដ៏ ចង្អៀត របស់ កម្ពុជា ការសម្រេចបាន នូវ កន្លែង បើក ចំហ បន្ថែម ទៀត សម្រាប់ លទ្ធិ ប្រជាធិបតេយ្យ និង សង្គម ស៊ីវិល វិសោធនកម្ម ច្បាប់ ស្តីពី សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល (LANGO) និង របស់ រដ្ឋាភិបាល ។ ការឆ្លើយតប បន្ទាន់ ក្រោយ ជំងឺ រាតត្បាត ។
ពាក់ព័ន្ធ នឹង វិធានការណ៍ ដែល រដ្ឋាភិបាល បាន ដាក់ចេញ ដើម្បី ឆ្លើយតប នឹង ជំងឺ រាតត្បាត នេះ លោក ស ខេង មានប្រសាសន៍ ថា រដ្ឋាភិបាល បាន បង្ហាញ ការប្រុងប្រយ័ត្ន ច្រើន ដោយ ដាក់ចេញ នូវ វិធានការ បង្ការ ចាប់ពី ការលើកកម្ពស់ ការយល់ដឹង ជាសាធារណៈ រហូតដល់ ការបិទ ទ្វារ រហូតដល់ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ។ រដ្ឋាភិបាល ក៏ បាន ដាក់ចេញ នូវ កម្មវិធី ជំនួយ សង្គម សម្រាប់ ប្រជាជន ដែល រងគ្រោះ ដោយ ជំងឺ កូវីដ - ១៩ ។
ពាក់ព័ន្ធ នឹង បញ្ហា ចង្អៀត ណែន ក្នុង ពន្ធនាគារ លោក ស ខេង មានប្រសាសន៍ ថា ក្រសួង កំពុង ខិតខំ ប្រឹងប្រែង ពង្រីក កន្លែង ពន្ធនាគារ ដើម្បី ដោះស្រាយ បញ្ហា ជាពិសេស ចំពោះ បរិបទ នៃ កូវីដ - ១៩ ។
បច្ចុប្បន្ន ក្រសួង មហាផ្ទៃ កំពុង អនុវត្ត វិធានការណ៍ មួយចំនួន ទៀត ដើម្បី បន្ធូរបន្ថយ លក្ខខណ្ឌ ដូចជា ធ្វើការ ជាមួយ ក្រសួង យុត្តិធម៌ លើ លទ្ធភាព នៃ ការដោះលែង ឱ្យ ឆាប់ ឬ ការដោះលែង ឱ្យ នៅ ក្រៅ ឃុំ សម្រាប់ ជន ជាប់ ឃុំ ដែល បាន ប្រព្រឹត្ត បទឧក្រិដ្ឋ មិន សូវ ធ្ងន់ធ្ងរ ឬ អ្នក ដែល ស្ទើរតែ បាន អនុវត្ត ទោស ទាំងស្រុង ។ ឧក្រិដ្ឋកម្ម តិច ជាង នេះ ដោយ ដាក់ នៅក្រោម ការដោះលែង ក្រោម ការត្រួតពិនិត្យ របស់ តុលាការ ។
ភាគី ទាំង ពីរ បាន សម្តែង ការប្តេជ្ញាចិត្ត ក្នុង ការបន្ត កិច្ចសហប្រតិបត្តិការ និង ការសន្ទនា នេះ ស្តីពី សិទ្ធិ មនុស្ស ។ ប្រធាន CHRC លោក កែវ រ៉េមី បាន ស្នើសុំ ឱ្យ អ្នក រាយការណ៍ ពិសេស សរសេរ របាយការណ៍ សម្រាប់ CHRC និង ផ្តល់ អនុសាសន៍ របស់ គាត់ ក្នុង លក្ខណៈ តុល្យភាព ដែល ឆ្លុះបញ្ចាំង ពី បញ្ហា ប្រឈម និង ការខិតខំ ប្រឹងប្រែង របស់ រដ្ឋាភិបាល ក្នុង បរិបទ កម្ពុជា " CHRC បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា " ។
ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ធំ បាន កោះហៅ សមាជិក សហគមន៍ ចំនួន ៤នាក់ មក បំភ្លឺ បន្ទាប់ពី ដើម បណ្តឹង ចំនួន ៣នាក់ បាន ចោទប្រកាន់ ពួកគេ ពី បទ រំលោភ យក ដី ប្រជាពលរដ្ឋ ដើម្បី ដាក់បញ្ចូល ទៅក្នុង ទ្រព្យសម្បត្តិ សហគមន៍ ។ ជន ជាប់ ចោទ បាន បដិសេធ ការចោទប្រកាន់ ។
ព្រះរាជអាជ្ញា ស៊ិន វីរៈ បាន កោះហៅ ឃួន ផេត អឿ សួរ ម៉ៃ ម៉ម និង ខៀវ ខូយ មក ផ្តល់ សក្ខីកម្ម នៅ ថ្ងៃទី ២៥ និង ២៨ ខែមិថុនា ។
សូម បង្ហាញ ខ្លួន ដើម្បី សាកសួរ ទាក់ទង នឹង បណ្តឹង របស់ សួន ជា . ធ្លក ប៊ុន ថា ន និង ម៉េង ហ៊ុយ អំពី ការលួច ដី នៅ ភូមិ ដូន ឈូក ឃុំ និពេច ក្នុង ឃុំ នី ពេជ្រ ស្រុក កំពង់ស្វាយ កាលពី ខែមិថុនា ឆ្នាំ ២០១៤ ។
កាលពី ដើម ខែមិថុនា ឆ្នាំ នេះ សមាជិក សហគមន៍ ព្រៃ អូរ ពាឡក់ ក្នុង ឃុំ និពេច ស្រុក កំពង់ស្វាយ ចំនួន ១១នាក់ ត្រូវបាន តុលាការ ខេត្ត សម្រេច ចោទប្រកាន់ ហើយ ខ្លះ ទៀត ត្រូវ ជាប់ ពន្ធនាគារ ៩ ថ្ងៃ មុននឹង ត្រូវ ដោះលែង នៅ ថ្ងៃទី ១៨ ខែមិថុនា ។
លោក ខៀវ ខូយ ប្រធាន សហគមន៍ ព្រៃឈើ ត្រពាំង លាប និង ជា សមាជិក បណ្ដាញ សហគមន៍ ព្រៃឈើ អូរ ផ្លាក ដែល ត្រូវបាន កោះហៅ និង ឃុំ ខ្លួន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ២៣ ខែមិថុនា ថា ជម្លោះ បាន កើតឡើង កាលពី ចុង ខែមករា នៅពេល សមាជិក សហគមន៍ បញ្ឈប់ គ្រឿងចក្រ ដើម្បី ឈូសឆាយ ។ ដី សហគមន៍ ជាង ៧២ ហិកតា ។
លោក បន្ថែម ថា សហគមន៍ របស់ លោក ត្រូវបាន ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ទទួលស្គាល់ ដោយ មាន កិច្ចព្រមព្រៀង របស់ រដ្ឋបាល ព្រៃឈើ ក្នុង ឆ្នាំ ២០០៤ ហើយក៏ ត្រូវបាន អាជ្ញាធរ មូលដ្ឋាន ទទួលស្គាល់ ផងដែរ ក្នុង ការការពារ សហគមន៍ ។ លោក សង្ឃឹម ថា តុលាការ នឹង ដោះស្រាយ ជម្លោះ ដោយ យុត្តិធម៌ និង ប្រគល់ ដី ជូន សហគមន៍ វិញ ។
វា អយុត្តិធម៌ ណាស់ សម្រាប់ ខ្ញុំ និង សហគមន៍ ដោយសារ យើង ស្ម័គ្រចិត្ត បម្រើ ផលប្រយោជន៍ រួម និង ការពារ ដី ព្រៃ ឲ្យ រដ្ឋ ស្រប តាម កិច្ចព្រមព្រៀង និង ប្រកាស របស់ ក្រសួង និង ច្បាប់ ព្រៃឈើ ។ យើង បាន ផ្តល់ សក្ខីកម្ម និង បដិសេធ ការចោទប្រកាន់ ពីរ ទៅ បី ដង ហើយ ប៉ុន្តែ តុលាការ ខេត្ត នៅតែ បញ្ជូន ខ្ញុំ ទៅ ពន្ធនាគារ ។
លោក ខូយ បន្ត ថា៖ នៅ ពេល ដែល ខ្ញុំ ចេញពី ពន្ធនាគារ មាន ការកោះហៅ ថ្មី ពាក់ព័ន្ធ នឹង ករណី ដូចគ្នា នេះ .. . ខ្ញុំ ដឹង ច្បាស់ ថា បណ្តឹង នេះ មាន គោលបំណង ចាប់ខ្លួន សមាជិក សហគមន៍ ទាំងអស់ ហើយ បញ្ជូន ពួកគេ ទៅ ពន្ធនាគារ និង រារាំង ពួកគេ ពី ការទាមទារ យក ដី ព្រៃ សហគមន៍ មកវិញ ។ .
ប្រធាន មន្ទីរ កសិកម្ម ខេត្ត លោក ប៉ែន វណ្ណ រិទ្ធ និង ប្រធាន រដ្ឋបាល ព្រៃឈើ លោក កែវ អូម៉ាលី ស មិន អាច ទាក់ទង សុំ ការបំភ្លឺ បាន ទេ នៅ ថ្ងៃទី ២៣ ខែមិថុនា ។
ភ្នំពេញ ប៉ុស្តិ៍ មិន អាច ទាក់ទង ដើម បណ្តឹង ដើម្បី សុំ ការអត្ថាធិប្បាយ បាន ទេ ។
អ្នកនាំពាក្យ សាលាដំបូង ខេត្ត លោក សាយ វាសនា ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ២៣ ខែមិថុនា ថា ភាគី ទាំង ពីរ បាន ប្តឹង គ្នា ទៅ វិញ ទៅមក ។
លោក បាន ជំរុញ ឲ្យ ភាគី ទាំង ពីរ ចូល ខ្លួន ទៅ តុលាការ ដើម្បី ផ្តល់ សក្ខីកម្ម ដោយ លោក ថា ព្រះរាជអាជ្ញា នឹង សិក្សា ករណី នេះ ឲ្យបាន ហ្មត់ចត់ ។
បន្ថែម ពីលើ ដីកា កោះហៅ សមាជិក សហគមន៍ ទាំង បួន នាក់ នោះ លោក វាសនា បាន និយាយ ថា តុលាការ ក៏ បាន កោះហៅ ដើម បណ្តឹង ទាំង បី នាក់ ដែល អះអាង ថា ជា ម្ចាស់ ដី នោះ ចូល ខ្លួន មក តុលាការ ដើម្បី បំភ្លឺ តាម បណ្តឹង របស់ សហគមន៍ ។
លោក ថា ប្រសិនបើ រឿង នេះ ស្រប គ្នា តុលាការ នឹង បញ្ចូល ពាក្យបណ្តឹង ទៅជា សំណុំរឿង តែ មួយ ដើម្បី ងាយស្រួល ក្នុង ការដោះស្រាយ តុលាការ ។
អាជ្ញាធរ ជាតិ អប្សរា (ANA) បាន ឲ្យដឹង ថា ក្នុង ឆមាស ទី១ ឆ្នាំ នេះ ក្រុម សហគមន៍ របស់ ពួកគេ បាន អនុញ្ញាតឲ្យ ប្រជាពលរដ្ឋ នៅ តំបន់ ឧទ្យាន បុរាណវិទ្យា អង្គរ ជួសជុល ផ្ទះ និង សាងសង់ សំណង់ បាន ជាង ៨០០ ខ្នង ខណៈ សំណើ ជិត ១៤០០ ទៀត កំពុង ស្ថិត ក្រោម ការពិនិត្យ ។
លើស ពី នេះ ក្រុមការងារ បាន ចូលរួម ការងារ មនុស្សធម៌ និង សាសនា មួយចំនួន ដើម្បី ជួយ ដល់ ចាស់ជរា ជន ពិការ កុមារ ឈឺ និង គ្រួសារ ក្រីក្រ ដោយ ផ្តល់ ថវិកា និង សម្ភារៈ ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ដល់ ពួកគាត់ ។
ក្រុមការងារ នឹង បន្ត គោលដៅ របស់ ខ្លួន ក្នុង ការផ្សព្វផ្សាយ ព័ត៌មាន និង អប់រំ ប្រជាពលរដ្ឋ ឱ្យ យល់ដឹង អំពី តួនាទី របស់ ANA និង កាតព្វកិច្ច នៃ ថែទាំ ដី នៅក្នុង តំបន់ ការពារ នៃ ឧទ្យាន អង្គរ និង នីតិវិធី សម្រាប់ ការស្នើសុំ ជួសជុល ផ្ទះ និង អគារ នៅក្នុង ឧទ្យាន នេះ កាន់តែ មាន ប្រសិទ្ធភាព និង ទាន់ ពេល វេលា ។
