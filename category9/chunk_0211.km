លោក កឹម សុខា មានប្រសាសន៍ ថា ការជ្រើសរើស មន្ត្រី ជាប់ កិច្ចសន្យា នឹង ត្រូវ ប្រកាស ជាសាធារណៈ យ៉ាងហោចណាស់ មួយ សប្តាហ៍ មុនពេល ការប្រឡង ចូល បម្រើ ការងារ ស៊ីវិល រួម មាន ការប្រឡង សរសេរ និង សម្ភាសន៍ ផ្ទាល់ មាត់ ហើយ បេក្ខជន ត្រូវ មាន សញ្ជាតិ ខ្មែរ និង មាន អាយុ យ៉ាងតិច ១៨ ឆ្នាំ ។
បេក្ខជន នឹង ចុះហត្ថលេខា លើ កិច្ចសន្យា ការងារ យ៉ាងតិច 3 ខែ និង អតិបរមា 12 ខែ គិត ចាប់ពី ថ្ងៃ ចុះហត្ថលេខា ។ ការបន្ត កិច្ចសន្យា របស់ ពួកគេ បន្ទាប់ពី នោះ នឹង ក្លាយជា ការសម្រេចចិត្ត របស់ រដ្ឋាភិបាល ដូច ដែល នឹង អាច ធ្វើ ទៅ បាន ដើម្បី នាំយក អ្នក ជ្រើសរើស ចូលក្នុង ក្របខណ្ឌ ការងារ រដ្ឋ ។
លោក យ៉ាង ពៅ អគ្គ លេខាធិការ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃទី ២៩ ខែមីនា ថា កន្លងមក រដ្ឋាភិបាល តែងតែ អនុញ្ញាតឱ្យ ជ្រើសរើស មន្ត្រីរាជការ ថ្មី ចូលក្នុង ក្របខណ្ឌ ការងារ រដ្ឋ ជំនួស អ្នកចូលនិវត្តន៍ ជារៀងរាល់ ឆ្នាំ ។
លោក បាន មានប្រសាសន៍ ថា កង្វះ ប្រាក់ ចំណូល នេះ ជា មូលហេតុ ដែល រដ្ឋាភិបាល មិន អាច អនុញ្ញាតឱ្យ ជ្រើសរើស មន្ត្រីរាជការ ថ្មី បន្ថែម ទៀត ចូលក្នុង ក្របខ័ណ្ឌ ដើម្បី ជំនួស អ្នកចូលនិវត្តន៍ បាន ទេ ដោយ បន្ថែម ថា ការប្រើប្រាស់ មន្ត្រី កិច្ចសន្យា នឹង ផ្តល់ឱ្យ រដ្ឋាភិបាល មាន ភាពបត់បែន បន្ថែម ទៀត នៅក្នុង ពេលវេលា មិន ច្បាស់លាស់ នា ពេល ខាងមុខ ក៏ ដូចជា ការសន្សំ ប្រាក់ ផងដែរ ។ ថវិកា ជាតិ ក្នុង ថវិកា ជាតិ ។
ប្រសិនបើ រដ្ឋាភិបាល សម្រេច ថា វា ថ្លៃ ពេក ក្នុង ការបន្តបង់ប្រាក់ ឱ្យ ពួកគេ ឬ គម្រោង ដែល ពួកគេ កំពុង ធ្វើ ត្រូវបាន បញ្ចប់ ពួកគេ អាច ត្រូវបាន គេ បោះបង់ ចោល ហើយ ការងារ របស់ ពួកគេ នឹង បញ្ចប់ ដោយ ស្វ័យប្រវត្តិ នៅ ចុងបញ្ចប់ នៃ កិច្ចសន្យា ប្រចាំ ឆ្នាំ របស់ ពួកគេ ។ ចំណែក បើ ពួកគេ ជា មន្ត្រីរាជការ ក្នុង ក្របខណ្ឌ ពួកគេ ត្រូវ រក្សាទុក រហូតដល់ ពួកគេ ចូលនិវត្តន៍ ។
ប្រធាន វិទ្យាស្ថាន កម្ពុជា ដើម្បី ប្រជាធិបតេយ្យ លោក ប៉ា ច័ន្ទ រឿន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ការជ្រើសរើស មន្ត្រី ជាប់ កិច្ចសន្យា ដើម្បី បំពេញ តម្រូវការ កម្មករ នៅ តាម គ្រឹះស្ថាន សាធារណៈ និង ជំនួស មន្ត្រី ចូល និវត្តន៍ គឺជា គំនិត ល្អ ព្រោះ វា អាច ជួយ សន្សំ ប្រាក់ ចូល ថវិកា ជាតិ ហើយក៏ អាច បំពេញ តម្រូវការ ការងារ ជាក់លាក់ របស់ រដ្ឋាភិបាល បាន ល្អ ប្រសើរ ផងដែរ ។ ពួកគេ ក្រោក ឡើង ។
ទោះជា យ៉ាង នេះ ក្តី ខ្ញុំ ចង់ អំពាវនាវ ឱ្យ មាន ការជ្រើសរើស ដោយ យុត្តិធម៌ និង យុត្តិធម៌ សម្រាប់ គ្រប់ មុខតំណែង ផ្លូវការ ក្នុង ក្របខណ្ឌ និង សម្រាប់ គ្រប់ មុខតំណែង កិច្ចសន្យា ។ មន្ត្រី ទទួលបន្ទុក ការងារ ត្រូវ ចៀសវាង ការរើសអើង នយោបាយ ឬ អំពើពុករលួយ ណាមួយ ដើម្បី ធានា ថា មន្ត្រី ទាំងអស់ ដែល បម្រើ ការងារ ក្នុង ស្ថាប័ន សាធារណៈ មាន សមត្ថភាព ខ្ពស់ និង មាន ចំណេះដឹង គ្រប់គ្រាន់ ដើម្បី បម្រើ ជាតិ យើង ។
យើង ខ្លាច ថា នាង នឹង ឆេវឆាវ ចំពោះ ទារក ឬ ភ័យខ្លាច ហើយ រត់ ចេញ ប៉ុន្តែ នាង បង្ហាញ សេចក្តីស្រឡាញ់ ការយកចិត្តទុកដាក់ និង សភាវ គតិ ការពារ សម្រាប់ ទារក ។ ទារក គឺ រឹងមាំ មាន សុខភាព ល្អ និង ថែទាំ បាន ល្អ ។
យើង នឹង តាមដាន ពួកគេ ទាំង ពីរ យ៉ាង ដិតដល់ ក្នុង រយៈពេល ពីរ បី សប្តាហ៍ ខាងមុខ ខណៈពេល ដែល ពួកគេ ត្រូវបាន រក្សាទុក ដោយឡែក ដើម្បី ការពារ ការរីករាលដាល នៃ ជំងឺ និង ទុក ពេល សម្រាប់ ហ្វូង សត្វ ដើម្បី ភ្ជាប់ ជាមួយគ្នា ។ បន្ទាប់ពី ពេលនេះ - និង ពិធី ប្រពៃណី ដោយ សហគមន៍ ជនជាតិ ដើម ភាគ តិច ព្នង - យើង នឹង ស្វាគមន៍ ភ្ញៀវ មក ជួប ពេជ្រ តូច របស់ យើង ។
មន្ទីរ បរិស្ថាន បាន និយាយ នៅ ថ្ងៃទី ២៩ ខែមីនា ថា យើង តែងតែ គាំទ្រ ដល់ ការអភិរក្ស ធនធាន ធម្មជាតិ និង វប្បធម៌ ប្រពៃណី និង ទំនៀមទម្លាប់ របស់ ជនជាតិ ព្នង ក្នុង ខេត្ត មណ្ឌលគិរី ។
លោក នេត្រ ភក្ត្រា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ពេជ្រ គឺជា កូនគោ ដំរី ក្នុង ស្រុក ទី ពីរ ដែល បាន កើត ក្នុង រយៈពេល បី ខែ ចុងក្រោយ នេះ បន្ទាប់ពី កើត ខែធ្នូ នៅ ខេត្ត រតនគិរី ។
នេះ ជា ដំណឹង ល្អ ណាស់ ។ រូបភាព ដែល ថត ដោយ ក្រុម អ្នកស្រាវជ្រាវ ជាមួយនឹង កាមេរ៉ា ស្វ័យប្រវត្តិ បាន បង្ហាញ ថា កូន ដំរី តូច ៗ ជាច្រើន មាន វត្តមាន នៅក្នុង ហ្វូង ដែល រស់ នៅក្នុង ព្រៃ ។
លោក បាន មានប្រសាសន៍ ថា វត្តមាន ដំរី ព្រៃ និង ក្នុង ស្រុក ផ្តល់ ក្តីសង្ឃឹម សម្រាប់ ការអភិរក្ស ដំរី អាស៊ី នៅ កម្ពុជា លោក បន្ថែម ថា បច្ចុប្បន្ន មាន ដំរី ព្រៃ ចន្លោះ ពី ៤០០ ទៅ ៦០០ ក្បាល នៅក្នុង ព្រះរាជាណាចក្រ ខណៈ ចំនួន សត្វ ក្នុង ស្រុក មាន ប្រហែល ៧០ ក្បាល ។
សម្ព័ន្ធ របស់ ឥណ្ឌូនេស៊ី ដែល មាន សាកលវិទ្យាល័យ ចំនួន ប្រាំមួយ កំពុង ផ្តល់ អាហារូបករណ៍ ដល់ និស្សិត បញ្ចប់ ការសិក្សា នៅ កម្ពុជា ដើម្បី បន្ត ការសិក្សា របស់ ពួកគេ នៅ សាកលវិទ្យាល័យ នានា ក្នុង ប្រទេស ឥណ្ឌូនេស៊ី ។ វិស័យ សហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ រួម មាន នយោបាយ សង្គម - វប្បធម៌ និង ការអប់រំ សេដ្ឋកិច្ច និង ការពារ ជាតិ ។
ការផ្តល់ អាហារូបករណ៍ នេះ បាន កើតឡើង ជាមួយនឹង ការអភិវឌ្ឍ ឡើងវិញ នៃ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ដែល បាន បង្កើត ទំនាក់ទំនង ការទូត តាំងពី ឆ្នាំ 1957 ។ ប្រទេស ទាំង ពីរ បាន ចុះហត្ថលេខា លើ សន្ធិសញ្ញា មិត្តភាព នៅ ខែកុម្ភៈ ឆ្នាំ 1959 ។
ស្ថានទូត ឥណ្ឌូនេស៊ី បាន និយាយ នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន កាលពី ថ្ងៃទី ២៨ ខែមីនា ថា គ្រឹះស្ថាន ឧត្តម សិក្សា ឥណ្ឌូណេស៊ី កំពុង សហការ ជាមួយ កម្ពុជា ក្នុង វិស័យ អប់រំ ក្នុង គោលបំណង កែលម្អ សក្តានុពលធនធាន មនុស្ស របស់ ខ្លួន ។
សាកលវិទ្យាល័យ ជាច្រើន នៅក្នុង ប្រទេស ឥណ្ឌូនេស៊ី សហការ ជាមួយ សាកលវិទ្យាល័យ ក្នុង ប្រទេស កម្ពុជា ។ ថ្មី ៗ នេះ សាកលវិទ្យាល័យ ចំនួន ប្រាំមួយ បាន លើកកម្ពស់ ឧត្តម សិក្សា ដោយ ផ្តល់ អាហារូបករណ៍ ពេញលេញ ដល់ និស្សិត កម្ពុជា ។
សាកលវិទ្យាល័យ BINUS ក្នុង នាម ជា អ្នកសម្របសម្រួល នៃ សម្ព័ន្ធ នេះ បាន រៀបចំ ព្រឹត្តិការណ៍ អនឡាញ មួយ កាលពី ថ្ងៃទី 12 ខែមីនា ដើម្បី លើកកម្ពស់ ការអប់រំ ឧត្តម សិក្សា ឥណ្ឌូនេស៊ី ដល់ និស្សិត កម្ពុជា ក្រោម ប្រធានបទ រៀន ឌីជីថល និង សហគ្រិន ភាព សង្គម ។
តាមរយៈ កិច្ចប្រជុំ នេះ ដែល មាន អ្នកចូលរួម ប្រហែល 150 នាក់ និស្សិត បាន មើលឃើញ ពី ភាព ជា សហគ្រិន ឌីជីថល និង សង្គម ពី អ្នកសិក្សា និង តួរ លេខ ក្នុង ឧស្សាហកម្ម ឥណ្ឌូនេស៊ី ក៏ ដូចជា អ្នកនាំពាក្យ របស់ រដ្ឋាភិបាល ខណៈ ដែល ការស្វែងរក ថា តើ សាកលវិទ្យាល័យ ណា ខ្លះ អាច ត្រូវ នឹង ចំណាប់អារម្មណ៍ របស់ ពួកគេ ផ្ទាល់ ។
ដើម្បី ផ្សព្វផ្សាយ ព្រឹត្តិការណ៍ នេះ ស្ថានទូត បាន អញ្ជើញ វិទ្យាល័យ និង សាកលវិទ្យាល័យ ល្បី ៗ មួយចំនួន នៅក្នុង ប្រទេស កម្ពុជា ឱ្យ ចូលរួម ។
វា បាន បន្ថែម ថា " ការចូលរួម របស់ ពួកគេ បង្ហាញ ពី ចំណាប់អារម្មណ៍ ដែល ពួកគេ មាន នៅក្នុង អាហារូបករណ៍ ដែល សម្ព័ន្ធ កំពុង ផ្តល់ ជូន " ។
លោក រស់ សុវាចា អ្នកនាំពាក្យ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃទី ២៩ ខែមីនា ថា ប្រទេស ជា មិត្ត ដូចជា ប្រទេស ឥណ្ឌូនេស៊ី ដើរ តួយ៉ាង សំខាន់ ក្នុង ការលើកកម្ពស់ គុណភាព នៃ ធនធាន មនុស្ស របស់ ព្រះរាជាណាចក្រ កម្ពុជា តាមរយៈ ការផ្តល់ ឱកាស អាហារូបករណ៍ ។
លោក បាន និយាយ ថា ឱកាស ទាំងនេះ ស្រប តាម គោលការណ៍ នៃ ការអប់រំ អំពី ភាពជា ពលរដ្ឋ សកល ដែល មាន គោលបំណង ធ្វើឱ្យ សិស្សានុសិស្ស នៅ គ្រប់ កម្រិត ទាំងអស់ ក្លាយជា ពលរដ្ឋ ពិភពលោក ដែល នឹង អភិវឌ្ឍ ចំណេះដឹង ជំនាញ និង គុណ តម្លៃ ដើម្បី ឆ្លើយតប ទៅនឹង បរិបទ ជាតិ តំបន់ និង ពិភពលោក ។
ក្រសួង ស្វាគមន៍ និង កោតសរសើរ ចំពោះ កិច្ចសហប្រតិបត្តិការ ជា វិជ្ជមាន ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ។ ការផ្តល់ ឱកាស អាហារូបករណ៍ បែប នេះ រួមចំណែក ដល់ កំណែទម្រង់ ការអប់រំ ។
អគ្គ ស្នងការ នគរបាល ជាតិ លោក នេត សាវឿន ដែល ជា ប្រធាន លេខាធិការដ្ឋាន សន្តិសុខ អចិន្ត្រៃយ៍ សម្រាប់ ការបោះឆ្នោត បាន ណែនាំ ដល់ កងកម្លាំង ទាំងអស់ ក្នុង រាជធានី - ខេត្ត ត្រូវ ពង្រឹង សន្តិសុខ ដើម្បី ត្រៀម រៀបចំ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ នា ពេល ខាងមុខ ។ លោក បាន ថ្លែង ថា ពួកគេ មាន ផែនការ ច្បាស់លាស់ ក្នុង ការទប់ស្កាត់ ការប៉ុនប៉ង ណាមួយ ដើម្បី បំផ្លិចបំផ្លាញ ការបោះឆ្នោត ថ្ងៃទី ៥ ខែមិថុនា ។
ថ្លែង ក្នុង កិច្ចប្រជុំ លេខាធិការដ្ឋាន កាលពី ថ្ងៃទី ២៨ ខែមីនា លោក សាវឿន មានប្រសាសន៍ ថា ប៉ូលីស មាន ទំនួល ខុសត្រូវ លើ សន្តិសុខ នៅក្នុង តំបន់ ដែល ស្ថិត នៅក្រោម យុត្តាធិការ របស់ ពួកគេ ត្រូវបាន គេ រំពឹង ថា នឹង ប្រើប្រាស់ ជំនាញ របស់ ពួកគេ ទាំងអស់ ដើម្បី ធានា សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ សាធារណៈ ខណៈ ដែល សន្លឹក ឆ្នោត ត្រូវបាន បោះចោល ។
ពួកគេ នឹង ធ្វើការ ជាមួយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) កងរាជអាវុធហត្ថ និង កងកម្លាំងប្រដាប់អាវុធ ដទៃ ទៀត ដើម្បី ធានា ដំណើរការ ប្រព្រឹត្តទៅ ដោយ រលូន ។
លោក បាន មានប្រសាសន៍ ថា ភារកិច្ច របស់ បញ្ជាការ សន្តិសុខ ការបោះឆ្នោត គឺ ធានា សន្តិសុខ សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ សាធារណៈ នៅ គ្រប់ ដំណាក់កាល ដោយ ធានា ថា ការបោះឆ្នោត គ្មាន ការគំរាមកំហែង គ្មាន អំពើហិង្សា អព្យាក្រឹត សេរី និង យុត្តិធម៌ ។
អ្នកនាំពាក្យ អគ្គ ស្នងការ នគរបាល ជាតិ លោក ឆាយ គឹម ឃឿន មានប្រសាសន៍ នៅ ថ្ងៃទី ២៩ ខែមីនា ថា លោក មិន ទាន់ អាច បង្ហើប ថា តើ ត្រូវ ដាក់ពង្រាយ មន្ត្រី ប៉ុន្មាន នាក់ ក្នុង អំឡុង ការបោះឆ្នោត ថ្ងៃទី ៥ ខែមិថុនា ។ លោក ថា កម្លាំង ប៉ូលិស នឹង ផ្តល់ សន្តិសុខ ទាំង មុន អំឡុង ពេល និង ក្រោយ ការបោះឆ្នោត ។ ភារកិច្ច របស់ ពួកគេ រួម មាន ការពិនិត្យ បញ្ជី ឈ្មោះ អ្នកបោះឆ្នោត ដឹកជញ្ជូន សន្លឹក ឆ្នោត និង កន្លែង យាម កន្លែង ដែល ឯកសារ ត្រូវបាន រក្សាទុក ។
ពួកគេ ក៏ នឹង ផ្តល់ សន្តិសុខ ដល់ អ្នកបោះឆ្នោត បេក្ខជន មន្ត្រី គ.ជ. ប និង អ្នកសង្កេតការណ៍ បោះឆ្នោត ជាតិ និង អន្តរជាតិ ផងដែរ ។
លោក បាន ថ្លែង ថា៖ វា គ្រាន់តែ ឆ្លងកាត់ សន្តិសុខ ល្អ ប៉ុណ្ណោះ ដែល ការបោះឆ្នោត នឹង ប្រព្រឹត្តទៅ ដោយ រលូន ។
អ្នកនាំពាក្យ គ.ជ. ប លោក សោម សូរីដា មានប្រសាសន៍ ថា គណៈកម្មាធិការ បាន ស្នើសុំ រក្សា សន្តិសុខ នៅ តាម ការិយាល័យ បោះឆ្នោត ជាង ២៣.៦០០ ការិយាល័យ ។ លោក បាន បន្ត ថា គួរ មាន មន្ត្រី ម្នាក់ ដាក់ នៅ ស្ថានីយ នីមួយ ៗ ដោយ មាន ការល្បាត ពីរ នាក់ នៅ ខាងក្រៅ ។
ឆ្មាំ ក៏ នឹង ត្រូវ បិទ ផ្សាយ នៅ ទីស្នាក់ការ គ.ជ. ប ក្នុង រាជធានី ភ្នំពេញ ទីស្នាក់ការ គណៈកម្មាធិការ រៀបចំ ការបោះឆ្នោត ទាំង ២៥ រាជធានី និង ខេត្ត និង នៅ សាលា ឃុំ សង្កាត់ ចំនួន ១.៦៥២ ក្នុង ប្រទេស ។
មន្ត្រី តំបន់ បាន ឲ្យដឹង ថា សត្វ ស្លាប ជាង ៣០០ ក្បាល បាន ងាប់ នៅ តំបន់ អភិរក្ស ទួល ពោធិ៍ តាឡី បឹង ស្នែ ក្នុង ខេត្ត ព្រៃវែង តាំងពី ដើម ខែមីនា ដោយសារ អាកាសធាតុ ក្តៅ ។ ជំងឺ ដល់ សត្វ ដទៃ ទៀត ។
ប្រធាន មន្ទីរ បរិស្ថាន ខេត្ត ព្រះសីហនុ លោក តុច វ៉ារត្ថា ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ២៩ ខែមីនា ថា សត្វ ស្លាប ចាប់ផ្ដើម ងាប់ ចាប់ពី ដើម ខែ នេះ ។ លោក បាន កត់សម្គាល់ ថា សត្វ ស្លាប ពី ២០ ទៅ ៣០ ក្បាល បាន ងាប់ ជារៀងរាល់ ថ្ងៃ ប៉ុន្តែ វា បាន កើតឡើង ពីមុន មក ។
វា មិន ធម្មតា ទេ ។ កាលពី ឆ្នាំ មុន វា បាន កើតឡើង ដូចគ្នា ក្នុង ខែមីនា និង ខែមេសា ព្រោះ អាកាសធាតុ ក្ដៅ ក្នុង អំឡុង ខែ នេះ ដែល ធ្វើឲ្យ សត្វ ឈឺ និង ងាប់ ។
លោក បាន បន្ថែម ថា មន្ត្រី ជំនាញ និង សហគមន៍ បាន នឹង កំពុង ប្រមូល សត្វ ងាប់ មក កប់ ជារៀងរាល់ ថ្ងៃ ហើយ សំណាក របស់ ពួកវា ត្រូវបាន យក ទៅ មន្ទីរពិសោធន៍ ដើម្បី ធ្វើតេស្ត ។
លោក នួន សារ៉េត អនុប្រធាន សហគមន៍ អភិរក្ស តំបន់ នេះ បាន និយាយ ថា ក្នុង អំឡុង ពេល ដើរល្បាត លោក បាន កត់សម្គាល់ ឃើញ ថា សត្វ ស្លាប ឈឺ និង ចាស់ អាច បំពុល សត្វ ស្លាប នៅក្បែរ នោះ ដោយ អចេតនា តាមរយៈ លាមក របស់ វា ។
គាត់ បាន និយាយ ថា រហូតមកដល់ ពេលនេះ សត្វ ស្លាប ជាង 300 ក្បាល បាន ងាប់ រួមទាំង សត្វ ស្លាប អាស៊ី សត្វ ក្អែក សត្វ ត្រយ៉ង សត្វ ក្រៀល ខ្មៅ សត្វ ត្រយ៉ង ក្បាល ខ្មៅ និង សត្វ ត្រយ៉ង រលោង ។
លោក សារ៉េត បន្ត ថា សហគមន៍ អភិរក្ស បាន បន្ត ការដើរល្បាត ជារៀងរាល់ ថ្ងៃ ដើម្បី ប្រមូល សត្វ ស្លាប ងាប់ ទៅ កប់ និង ការពារ សត្វ ផ្សេង ទៀត បើ ទោះបីជា សត្វ ស្លាប ងាប់ មាន ចំនួន ច្រើន ក៏ដោយ ។ លោក បាន កត់សម្គាល់ ថា សត្វ ដែល ងាប់ មិន បាន ប៉ះពាល់ ដល់ លំហូរ ភ្ញៀវ ទេសចរ ទេ ដោយ ចំនួន អ្នក ចូល ទស្សនា នៅសល់ ធម្មតា ប្រហែល ពី ៥០ ទៅ ១០០ ក្បាល ជារៀងរាល់ ថ្ងៃ ។
វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ចំនួន ៣. ៥លាន ដូស ទៀត ដែល ផ្តល់ ដោយ ប្រទេស ចិន បាន ចុះ នៅ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ កាលពី ថ្ងៃទី ៣០ ខែមីនា មួយ ថ្ងៃ បន្ទាប់ពី ការដឹកជញ្ជូន លើក ដំបូង ចំនួន ១.៥ លាន ដូស បាន មកដល់ ។
លោក សម្បត្តិ បាន ប្រាប់ អ្នកសារព័ត៌មាន នៅ អាកាសយានដ្ឋាន ខណៈ ទទួល ថ្នាំ ចំនួន ១. ៥លាន ដូស នៅ ថ្ងៃទី ២៩ ខែមីនា ថា កម្ពុជា មានអំណរគុណ ចំពោះ ប្រទេស ចិន ដែល បាន ផ្ដល់ ជំនួយ វ៉ាក់សាំង ដ៏ ច្រើន បែប នេះ ដល់ កម្ពុជា ។
លោកស្រី បាន មានប្រសាសន៍ ថា មន្ត្រី ធនាគារ ពិភពលោក កាលពី ពេល ថ្មី ៗ នេះ បាន សរសើរ កម្ពុជា ចំពោះ ជោគជ័យ របស់ ខ្លួន លើ ការចាក់ វ៉ាក់សាំង ហើយ មន្ត្រី រូប នេះ បាន ស្នើ ឱ្យ កម្ពុជា ចែករំលែក បទពិសោធន៍ និង មេរៀន ជាមួយ ប្រទេស ជិតខាង ដើម្បី ជួយ ពួកគេ ក្នុង យុទ្ធនាការ ចាក់ វ៉ាក់សាំង របស់ ពួកគេ ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ។
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ថ្លែង កាលពី ថ្ងៃទី ២៨ ខែមីនា ថា ស្ថានភាព ជំងឺ កូវីដ - ១៩ នៅ កម្ពុជា មាន ភាពប្រសើរឡើង ច្រើន ដោយសារ ការចាក់ វ៉ាក់សាំង ប៉ុន្តែ លោក បាន អំពាវនាវ ជាថ្មី ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ដោយ អនុវត្ត ៣ ធ្វើ និង ៣ កុំ ។
ក្រសួង បន្ត ថា កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្នុង គោលបំណង ចែករំលែក ព័ត៌មាន អំពី ប្រព័ន្ធ សុខាភិបាល កម្ពុជា និង ពិភាក្សា អំពី កិច្ចសហប្រតិបត្តិការ ក្នុង ការពង្រឹង ការថែទាំ សុខភាព កម្ពុជា ។
វ៉ាន់ ឌីន ប្រាប់ មន្ត្រី អាមេរិក ថា កម្ពុជា បាន នាំ កូវីដ - ១៩ ឱ្យ ស្ថិត ក្រោម ការគ្រប់គ្រង និង បើក ប្រទេស ឡើងវិញ ជាធម្មតា ។
