ឪពុកខ្ញុំស្អី ៗធ្ងន់ទៅលើបងប្រុសខ្ញុំ ។
ចំណាយនេះធ្ងន់ទៅ លើគ្រឿងសំអាង កាយ ។
ផ្សោតងើបធ្ងោលពីក្នុងទឹក ។
ដំរីធ្វើស្លឹកត្រចៀកធ្មាំង ។
អ្នក នោះម្ដេចនៅឈរធ្មាំងមិន ងាកសោះ?
រោគផ្នែកបុរសភេទដូចជាទឹក កាមធ្លាក់ រហ័ស ។
ឆ គាត់ទាល់តែធ្លាក់អស់នូវអាថ៌កំបាំងទាំងប៉ុន្មាន ។
ខ្ញុំធ្លាក់ខ្លួនទៅជាឈឺគ្រុនចាញ់ ស្រមៃ ឃើញ តែព្រំដែនស្អី ៗនោះយ៉ាងម៉េច ។
កុំចូលចិត្តរិះគន់អ្នក ដទៃ វាធ្លាប់មាត់ !
រឿងនោះធ្លាយចេញហើយ ។
ទ្វារ ច្រហ ធ្លុង ។
មានគំនិតជាធ្លុងមួយ
រឿងសំងាត់នេះត្រូវលោកប្រធានធ្វើឲ្យបែកហើយ ។
គាត់ធ្វើជាគ្រូ ។
គាត់ធ្វើ ជាឈឺ ។
ធ្វើម៉េចឥឡូវឲ្យខ្ញុំស្គមម្ដេចកើត បើវាចេះ តែឃ្លាន ?
កាលពីក្មេងមិនគិតរៀន ធ្វើម៉េចឥឡូវខ្ញុំចាស់ទៅហើយ ខ្ញុំរៀនមិនចាំទេ វាចេះ តែភ្លេច ។
មហា សន្និបាតដែលនឹងធ្វើឡើងនៅក្នុងសាលារៀន
បុណ្យនេះធ្វើឡើង ដើម្បី
សន្និសីទបានធ្វើឡើងក្រោម អធិបតីភាពនៃលោកនាយករដ្ឋមន្ត្រី ផាំ យ៉ាំង ដុង។
ការ ច្រូត កាត់ដោយដៃ តែងធ្វើឡើងដោយប្រើប្រាស់ ក ណ្ដៀវ
កញ្ចាស់នេះធ្វើឡើងអំពី បន្ទោះឫស្សីតូច ។
នាងរៀនធ្វើអ្វី?
ខ្ញុំចង់ធ្វើឲ្យលោកទៅជាអ្នកមាន ។
នរណានៅមាត់ទ្វារ?
ន រូ អ្នកណានឹងស្វែង ប្រាជ្ញា ជា រស្មី ប្រាណ ឲ្យគិតជញ្ជឹង រំពឹងលែងបាន កុំធ្វើបំពានប្រទូស្តវឹងស្នង ។
នាក្រុងប៉ារីសមានជនជាតិខ្មែរនិងជនជាតិនានាជាច្រើនមក រស់នៅ ទីនោះ ឯ នាក្រុង នីសក៏ដូច្នោះដែរ ។
នាងខ្ញុំមិនស្រួលខ្លួន ។
ចា៎ះ នេះជារបស់នាងខ្ញុំ ។
ខ្លះជាស្រី ក្រមុំ រត់ចេញពីផ្ទះ ខ្លះទៀតជានាងបង្ហាញម៉ូត
២ ជានានត្តនៃ៧ ដែលដក យក៥ ចេញ។
នៅផ្សារខ្មែរខ្ញុំឃើញមាន លក់ម្ហូបនិងគ្រឿងកំប៉ុងហើយ និងរបស់នានា ឯទៀតដូចជាសំពត់ខោអាវរូបបដិមាករជាដើម ។
សព្វ ថ្ងៃនៅប្រទេស ខ្មែរក្រៅពីប្រជាជនខ្មែរមានជនជាតិនានា ទៀត ។
បើខ្ញុំមានប្រាក់គ្រប់គ្រាន់ខ្ញុំ នឹងដើរលេង កម្សាន្តនៅនានាប្រទេស ក្នុងពិភពលោក ។
នានាជនជាតិមានថៃជាដើមតែង តែតិះដៀលប្រជាជនខ្មែរថាជាជនជាតិ ល្ងង់ ។
នានា ភាពសេនេទិច
នាបីគេមានឬក្រ កូនមិនត្រូវប្រមាថ កាត ទានមនុស្សឡើយ ។
កូនត្រូវខំសង្វាតរៀនសូធ្យ នា បីកូនគិតថាកូនមានប្រាជ្ញាយ៉ាង ណាក៏ដោយ ក៏កូនមិនត្រូវប្រមាទពេលវេលាឡើយ ។
គាត់ចេញពីធ្វើ ការ គាត់មិនទៅផ្ទះភ្លាមទេ គាត់នៅចូលនាយអាយសិន។
កុំ មកធ្វើជានាយកលើខ្ញុំ !
សីល ៥ ហៅ ថា និច្ច សីលព្រោះជាសីលដែលគួររក្សាជា និរន្តរ៍រាល់ថ្ងៃ តទៅ ។
ឬនិមន្តលោកមកប្រគេនចង្ហាន់ ប្រគេនទេយ្យ វត្ថុផ្សេង ៗនៅ ឯគេហដ្ឋានរបស់ខ្លួន ។
លោក សង្ឃនិមន្តទៅបិណ្ឌ បាត ។
ល្បែងប្រជាប្រិយដែលគេនិយមលេង មានអ្វីខ្លះ?
ពិធីចូល ឆ្នាំធ្វើតាមការ គន់ គូរក្បួនហោរាសាស្ត្របែបបុរាណគឺក្បួនមហាសង្ក្រាន្តទើបខ្មែរនិយមចូល ឆ្នាំក្នុងខែចេត្រឬជួនកាលក្នុងខែពិសាខ
ពាណិជ្ជកម្មយើង អត់និយាយពីរឿង នយោបាយទេ ។
ខ្ញុំខុសពីមុនបន្តិចបន្តួច គេចេះ តែនិយាយបូកឲ្យកើតជារឿងធំ ។
នែ! ខ្ញុំមិនបានជិះឡានជាមួយលោកទេ កុំនិយាយបូកខ្ញុំចូល ណ៎ះ !
គេមិននិយាយរកគ្នាទេ ។
ដំរី៧០០សឹងប្រដាប់ នីទៅនូវកម្រាលខ្នង ... ព្រមទាំងទ្រមាក់ពាក់ នីទៅនូវមួកមាស ... មានដៃ កាន់ នីទៅនូវកង្វេរនិងលំពែងស្នែង ក្របី ។
ឥតដែលមានភ្នកនឹក នាដល់ ជរា ព្យាធិ មរណៈ នឹងសេចក្ដី ព្រាត់ប្រាស
ជំនោររំភើយបាន បក់មកពីភ្នំស្វាយ ធ្វើឲ្យខ្ញុំត្រជាក់ ចិត្ត នឹក ភ្នកចង់ដើរលេងផ្សារស្វាយ
មិនងាយនឹងចោរលួចបានឡើយ ។
ចាំនៅគល់នោះ ចុំ ! ខ្ញុំនឹងឡើងទៅចាប់វា ឯលើ ។
យើងរៀនឲ្យចប់ នឹងអាលដើរលេងបន្តិច។
ស្លៀកពាក់ឲ្យឆាប់ឡើងនឹងអាលទៅមើលកុន ។
ធ្វើឡានខ្ញុំឲ្យបានរួចឆាប់ខ្ញុំនឹងអាលចេញដំណើរ ទៅ ។
លោកនឹងអាលទៅ ណាហ្នឹង ចាំខ្ញុំ បង្ហើយកិច្ចការនេះសិន ។
ញ៉ាំ រហ័សឡើងន្អាលនឹងទៅជាមួយគ្នា ។
ភ្នែកមាន ច ក្ខុប្បសាទសម្រាប់មៀង មើលនូវរូបារម្មណ៍ដូចកែវយឹត ។
អ្នក ណាធ្វើនូវអំពើល្អដោយកាយ វា ចា ចិត្តនឹងបាននូវ ផលល្អ ។
ប្រាសាទដ៏ពេញនូវមាស
លោកប្រធានាធិបតីមន្ត្រីតូចធំនូវអស់ប្រជាជនទាំងឡាយនាំគ្នាមើល ពិធី ហែក្បួន ។
ក្រៅពីមានស្រី ពេស្យា វៀតណាមឡាវខ្មែរភូមិភាគ កណ្ដាលប្រកបនូវមានស្រី ពេស្យាខ្មែរលើដែល រស់នៅតាមតំបន់ព្រៃភ្នំមួយចំនួនតូចទៀត ។
ដូច្នោះ មក ទល់នឹងថ្ងៃនេះហាក់ដូចជាមិនទាន់ ឃើញមាន អីជាដុំ កំភួនទេ ក្រៅតែអំពីពួកនែ៎ ៗ ... អ្ហ៊េ ... ពួកប៉ រ៉េ ពណ៌ ខៀវ
នៅចុះ ! សឹមអញជួយឯងឲ្យរួចពីស្លាប់ ។
យើងអស់នំហើយឬនៅ? នៅ !
បន្ទប់នេះឃើញនៅ តែកខ្វក់ដដែល ។
បើមិនខំធ្វើ ការ ទេ វានៅ តែក្រ រហូត ។
បញ្ហានោះនៅតែមិន ទាន់ដោះស្រាយនៅឡើយទេ ។
ចំពោះគ្រោះថ្នាក់នោះ គេពុំទាន់ដឹងខុស ត្រូវនៅឡើយទេ ។
តា ជរាក៏នាំ ប្រពន្ធក្រមុំទៅនៅលំនៅឋានគាត់ ។
បានសួរនាំពីមូលហេតុនៃ ការ ផ្ទុះអាវុធនេះ ។
គាត់លែងសួរ នាំខ្ញុំ ហើយ បង្ខំឲ្យខ្ញុំដោះ អាវទ្រនាប់
ចំណាប់ និងមិត្ត ភក្តិនារី ៗ ទាំងអស់គេ នាំគ្នាជួយសម្រួល ចិត្តដាលីន ។
គេ នាំគ្នាសំអាតតុបតែងលំអគេហដ្ឋាននិងកាត់សំលៀកបំពាក់ថ្មីសម្រាប់គ្រួសារ ។
ការ ដែល នាំឲ្យមាន កិច្ច ប្រជុំបន្ថែមមួយថ្ងៃទៀតនេះពីព្រោះមានបញ្ហាដែលត្រូវ ជជែកគ្នាច្រើនស្ដីពីការ ដែលត្រូវកាត់បន្ថយ កងទ័ពរបស់ភាគីនិមួយ ៗ ។
នុ៎ះ ហ្ន៎ផ្ទះយើង !
ចូរបំពេញ ឃ្លាខាងក្រោមនេះ ។
បងជាបុរិល ឯងចាំនៅគល់នេះចុះ ។
សៀវភៅនេះ ឯងដែលខ្ញុំកំពុងរក ។
ឯគីង្គក់និងអណ្ដើកខំ តាមដានទៅ បាត់ ដានត្រង់ដើមឈើនោះ ។
ម្យ៉ាងទៀតគេចាក់ស្ករខាប់នោះទៅក្នុងពាងឬក្អម
អញ ចាំខាំ កន្ទុយវា កាលមុនវានឹងលោតទៅនោះ ។
ស្រួលដូច បកចេក។
ស្រួលដូច បកចេក។
ខ្ញុំមានអាយុបងគាត់ប្រាំបីឆ្នាំ ។
ខ្លះទៀតបំផ្លាញជីវិត បង់
ប៉ុន្តែក្នុង ចិត្តរបស់នាងហាក់ដូចជាបង្កប់នូវអាថ៌កំបាំងអ្វីម៉្យាង
ពួកយួនបង្កប់និងអាយ៉ង
ខ្ញុំមិនអាច ត្រឡប់ទៅផ្ទះទាន់ពេលពីព្រោះឡានឈ្នួល វាខូច កណ្ដាលផ្លូវ ប ង្ខកដំណើរខ្ញុំ ។
នាងក៏ដើរទៅក្បែរមាត់បង្អួច ទាញស្លាប ព្រិល បង្ហើបឡើងឈរគយគន់ដួង ច ន្ទ្រ ព្រមទាំងវា ចា តែម្នាក់ឯង ។
ព្រះទិន ករបានបង្អួតខ្លួនក្នុង ន ភាល័យ ជាថ្មី ។
ដែលសូមមិនបញ្ចេញឈ្មោះ ។
អត្ថបទនេះ បញ្ចាំងឡើងពីការ ប្ដេជ្ញា ចិត្តរបស់ប្រជាជន ។
ហើយ ប ញ្ឆេះម៉ូតូចេញបាត់មួយរំពេច ។
ឲ្យកម្មករចេះ បញ្ជាម៉ាស៊ីន ។
ក្នុងរបាយការណ៍របស់លោកបានបញ្ជាក់ថានៅខេត្តបាត់ដំបងមានមន្ទីរឃុំឃាំងសំងាត់ចំនួន ២ ។
ក្រសួងការពារ ជាតិបានបញ្ជាក់ទៅយោធ ភូមិភាគ ទី៥ ... ឲ្យធ្វើ ការ រំសាយមន្ទីរឃុំឃាំងសំងាត់នោះ
ដឹកគោ ប ញ្ជ្រកក្នុងម្លប់ឈើ
បានធ្វើសេចក្ដី អំពាវនាវដល់ពួកខ្មែរ ក្រហមឲ្យបញ្ឈប់ការ ដាក់មីនសម្លាប់ ប្រជាពលរដ្ឋស្លូតត្រង់
លោកលេខាបក្សក្រុង ភ្នំពេញត្រូវ បញ្ឈរជើង ។
