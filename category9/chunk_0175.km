( ភ្នំពេញ ) ៖ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២៣ ស្អែក នេះ គឺជា រយៈពេល ៤៦ ឆ្នាំ ហើយ ដែល សម្តេច តេជោ ហ៊ុន សែន និង យុទ្ធ មិត្ត រួម អាវុធ ដ៏ ស្មោះស្ម័គ្រ ៤រូប បាន រួមគ្នា យក ជីវិត ធ្វើជា ដើមទុន ចេញ ទៅកាន់ ប្រទេស វៀតណាម ស្វែងរក ការគាំទ្រ ដើម្បី តស៊ូ រំដោះ ជាតិ និង ប្រជាជន កម្ពុជា ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ដ៏ ឃោរឃៅ របស់ ខ្មែរ ប៉ុល ពត និង បក្ខពួក ។
សម្តេច តេជោ ហ៊ុន សែន នឹង អញ្ជើញ ជា អធិបតី ក្នុង ពិធី រំលឹក ដល់ ថ្ងៃ នៃ ដំណើរ ចេញ តស៊ូ កាលពី ៤៦ ឆ្នាំ មុនោះ ។ ពិធី នៅ ឆ្នាំ នេះ នឹង រៀបចំឡើង នៅ ក្រសួង ការពារ ជាតិ មិន មាន រៀបចំ នៅ ទីតាំង នៃ ការផ្តើម ដំណើរតស៊ូ តំបន់ X16 ក្នុង ឃុំ ទន្លូង ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ដូច ឆ្នាំ កន្លងទៅ នោះ ឡើយ ។
ឯក អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ កម្ពុជា អះអាង ប្រាប់ រដ្ឋមន្ត្រី វង្សី វិស្សុត ថា កម្ពុជា នឹង ទទួលបាន នូវ ហិរញ្ញប្បទាន អភិវឌ្ឍន៍ ផ្លូវការ បន្ថែម ទៀត ពី ជប៉ុន
ការអះអាង នេះ ធ្វើឡើង ក្នុង ឱកាស ជួប សំដែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ លោក វង្សី វិស្សុត រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២៣ ដើម្បី ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី រវាង កម្ពុជា - ជប៉ុន ដើម្បី ផលប្រយោជន៍ នៃ ប្រទេស ទាំង ពីរ ។
លោក បាន បន្ត ថា ជប៉ុន ជា មិត្ត ដ៏ ល្អ . ជិតស្និត និង ស្មោះត្រង់ របស់ កម្ពុជា ក្នុង គ្រប់ កាលៈទេសៈ ។ កម្ពុជា - ជប៉ុន មាន ចំណង ទាក់ទង ដ៏ យូរ លុង ហើយ ឆ្នាំ ២០២៣ នេះ គឺជា ខួប លើក ទី៧០ ឆ្នាំ នៃ ចំណង ការទូត រវាង ប្រទេស យើង ទាំង ពីរ ។ បច្ចុប្បន្ន . ទំនាក់ទំនង និង ចំណង មិត្តភាព ព្រមទាំង កិច្ចសហប្រតិបត្តិការ នៃ ប្រទេស ទាំង ពីរ ត្រូវបាន ពង្រឹង និង ពង្រីក ឥត ឈប់ឈរ ហើយ ត្រូវបាន ដំឡើង កម្រិត ជា ដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ ។
លោក វង្សី វិស្សុត បាន ថ្លែង នូវ អំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ រដ្ឋាភិបាល ជប៉ុន និង ប្រជាជន ជប៉ុន ដែល បាន ចូលរួមចំណែក កសាង និង អភិវឌ្ឍន៍ សង្គម - សេដ្ឋកិច្ច ចាប់តាំងពី ដំណាក់កាល ស្វែងរក សន្តិភាព រហូតដល់ ដំណាក់កាល នៃ ការស្តារ និង អភិវឌ្ឍន៍ កម្ពុជា តាមរយៈ ការផ្តល់ ជំនួយ អភិវឌ្ឍន៍ ដែល មាន ទាំង ផ្នែក ហិរញ្ញប្បទាន និង ទាំង ផ្នែក បច្ចេកទេស ក៏ ដូចជា ការវិនិយោគ ផ្ទាល់ (FDI) ។
លោក វង្សី វិស្សុត ក៏ បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល ជប៉ុន ដែល បាន ជួយ បង្កើត រ មជ្ឈមណ្ឌល ផលិតកម្ម ឌីជីថល កម្ពុជា - ជប៉ុន ស្រប តាម យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ ធនធាន មនុស្ស របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល កំពុង យកចិត្តទុកដាក់ និង ជំរុញ លើ វិស័យ នេះ យ៉ាង ខ្លាំង ។
លោក ក៏ បាន ស្នើ ដល់ ភាគី ជប៉ុន បន្ត ជួយ អភិវឌ្ឍន៍ មូលធន មនុស្ស នៅ កម្ពុជា ពិសេស ការបណ្តុះបណ្តាល ជំនាញ ប្រកប ដោយ គុណភាព និង ឆ្លើយតប ទៅនឹង តម្រូវការ នៃ ឧស្សាហកម្ម កម្ពុជា និង ការកសាង និង អភិវឌ្ឍ សមត្ថភាព ក្នុង វិស័យ សាធារណៈ ដើម្បីឱ្យ វិស័យ សាធារណៈ កម្ពុជា កាន់តែ មាន សមត្ថភាព ខ្លាំង ពូកែ . កាន់តែ ឆ្លាតវៃ និង ស្អាតស្អំ ។
ក្នុង ឱកាស នោះ ដែរ លោក វង្សី វិស្សុត និង ឯក អគ្គ រាជ ទូត ជប៉ុន UENO Atsushi ក៏ បាន ធ្វើ ការពិភាក្សា ផងដែរ អំពី ការវិនិយោគ របស់ ធុរ ជន និង វិនិយោគិន ជប៉ុន នៅ កម្ពុជា ។ ភាគី ទាំង ពីរ បាន ធ្វើ ការផ្លាស់ប្តូរ នូវ ទស្សនៈ មួយចំនួន ផងដែរ ពាក់ព័ន្ធ នឹង ការចូលរួម កែលំអរ បរិស្ថាន វិនិយោគ និង ធុរកិច្ច នៅ កម្ពុជា ក៏ ដូចជា តម្រូវការ ចង់បាន របស់ វិនិយោគិន និង ធុរ ជន ជប៉ុន ដើម្បី ទាក់ទាញ និង លើកទឹកចិត្ត ឱ្យ មក វិនិយោគ នៅ កម្ពុជា ឱ្យ កាន់តែ ច្រើន ថែម ទៀត ។
ទោះជា យ៉ាងណា គេ នៅ តាមដាន មើល ថា តើ ប្រទេស ទាំង ពីរ អាច ដោះស្រាយ ភាពខុសគ្នា ដ៏ ចម្រោង ចម្រះ របស់ ពួកគេ ដែល ភាគ ច្រើន មាន ផល ប៉ះពាល់ ដល់ ហិរញ្ញវត្ថុ អន្តរជាតិ សន្តិសុខ និង ស្ថិរភាព ដែរ ឬ យ៉ាងណា នោះ ទេ ។
ក្រៅពី ឆន្ទៈ ក្នុង ការពិភាក្សា មាន សញ្ញា តិចតួច ដែល ថា ពួកគេ កំពុង រៀបចំ ផ្លាស់ប្តូរ ជំហរ រឹងរូស របស់ ខ្លួន លើ បញ្ហា ជាច្រើន ចាប់ពី ពាណិជ្ជកម្ម រហូតដល់ តៃវ៉ាន់ និង ស្ថានភាព សិទ្ធិ មនុស្ស នៅក្នុង ប្រទេស ចិន និង ហុងកុង និង បញ្ហា សមុទ្រ ចិន ខាងត្បូង ព្រមទាំង សង្គ្រាម របស់ រុស្ស៊ី នៅ អ៊ុយក្រែន ជាដើម ។
កាលពី ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក និង រដ្ឋមន្ត្រី ការបរទេស ចិន បាន បើក កិច្ចពិភាក្សា ប្រកបដោយ ភាពស្មោះត្រង់ និង លក្ខណៈ ស្ថាបនា លើ ការខ្វែងគំនិត រវាង ប្រទេស ទាំង២ រាប់ ចាប់ពី បញ្ហា តៃវ៉ាន់ រហូតដល់ ពាណិជ្ជកម្ម ។ ហើយ នៅ ថ្ងៃចន្ទ នេះ មុននឹង ជួប ជាមួយ លោក Xi Jinping អ្នកកាទូត កំពូល អាមេរិក រូប នេះ ក៏ ជួប ពិភាក្សា ជាមួយ មន្រ្តី ការទូត កំពូល របស់ ចិន លោក វ៉ាង យី (Wang Yi) ផងដែរ ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បន្ត ជួប សំណេះសំណាល ជាមួយ ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត សមាជិក គណៈ អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន យុវជន គណបក្ស ថ្នាក់ កណ្តាល បាន ជួប សំណេះសំណាល ជាមួយ ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ពោធិ៍សាត់ នៅ ថ្ងៃចន្ទ ទី១៩ ខែមិថុនា ឆ្នាំ ២០២៣ ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ក្នុង នាម ជា ប្រជាជន កម្ពុជា និង ជា សកម្មជន យុវជន បក្ស . យើង ត្រូវ មាន ភក្តីភាព ចំពោះ ជាតិ សាសនា ព្រះមហាក្សត្រ របស់ យើង ហើយ នេះ គឺជា ឆន្ទៈ ដ៏ ស្មោះត្រង់ របស់ សមាជិក - សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា គ្រប់ ៗ រូប ។
ទន្ទឹម គ្នា នេះ យើង ក៏ ត្រូវ គោរព ផ្តល់ តម្លៃ ចំពោះ គំរូវីរភាព និង ពលិកម្ម របស់ អ្នកជំនាន់ មុន ហើយ ថែរក្សា ឱ្យ បាន ដាច់ខាត នូវ ស្មារតី នៃ ការស្រឡាញ់ សន្តិភាព និង ការបង្រួបបង្រួម ជាតិ ។ ពិត ណាស់ . ពាក្យ ស្រឡាញ់ សន្តិភាព អាច ត្រូវបាន ឮ ជាញឹកញាប់ រហូតដល់ អ្នក ខ្លះ អាច មើលស្រាល ចំពោះ តម្លៃ នៃ សន្តិភាព ។
យ៉ាងណា ក៏ដោយ សូម ចងចាំ ថា សន្តិភាព ដែល យើង ទាំងអស់ គ្នា កំពុង ទទួលបាន ដូច បច្ចុប្បន្ន នេះ គឺ បាន កើតឡើង ដោយ លំបាក បំផុត ប៉ុន្តែ អាចនឹង បាត់បង់ ទៅ វិញ យ៉ាង ផុយ ស្រួយ គ្រប់ ពេលវេលា តួយ៉ាង ដូចជា ព្រឹតិ្តការណ៍ ១៨ មីនា ១៩៧០ ដែល បាន អូស ទម្លាក់ កម្ពុជា ទៅក្នុង ភ្នក់ភ្លើង សង្គ្រាម ស៊ីវិល ហើយ ដែល បាន បន្ត អូសបន្លាយ រាប់ ទសវត្សរ៍ នៅលើ មាតុភូមិ ដ៏ កំសត់ មួយ នេះ ។
សម្តេច តេជោ ថ្លែង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស សម្តេច អញ្ជើញ ប្រារព្ធ ខួប ៤៦ ឆ្នាំ នៃ ដំណើរ ឆ្ពោះ ទៅរក ការតស៊ូ រំដោះ ជាតិ នា ព្រឹក ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ ។
សម្តេច មានប្រសាសន៍ បន្ត ថា រឿង ដែល បាន តភ្ជាប់ ពី ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ១៩៩៧ រហូតមកដល់ បច្ចុប្បន្ន នេះ មិន គ្រាន់ ត្រឹមតែ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ទេ ស្ថានភាពវា បាន តភ្ជាប់ មកដល់ បច្ចុប្ប នេះ តែម្តង សម្រាប់ ប្រទេស កម្ពុជា ដែល ពី ប្រទេស ជួប អំពើ ប្រល័យ ពូជសាសន៍ មកដល់ ប្រទេស មួយ ដែល កំពុង ឈាន ឆ្ពោះ ទៅរក ប្រទេស ចាកចេញ ផុត ពី ប្រទេស អភិវឌ្ឍន៍ តិចតួច ក្លាយជា ប្រទេស ដែល មាន ប្រាក់ ចំណូល មធ្យម កម្រិត ខ្ពស់ និង ឈាន ឆ្ពោះ ទៅរក ប្រទេស មួយ ដែល មាន ប្រាក់ ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
សម្តេច លើកឡើង ថា អ្វី ដែល សម្តេច បាន លះបង់ មិន មែន ជា ផលប្រយោជន៍ របស់ សម្តេច ទេ គឺជា ផលប្រយោជន៍ សម្រាប់ មនុស្ស ទាំងអស់ ។
សូម បញ្ជាក់ ថា នៅ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២៣ គឺជា រយៈពេល គម្រប់ ៤៦ ឆ្នាំ ហើយ ( ២០ មិថុនា ១៩៧៧ - ២០ មិថុនា ២០២៣ ) ដែល យុទ្ធជន ហ៊ុន សែន ក្នុង វ័យ ២៥ ឆ្នាំ រួម នឹង យុទ្ធ មិត្ត ដ៏ ស្ម័គ្រស្មោះ ៤រូប ផ្សេង បាន សម្រេចចិត្ត ក្នុង ស្ថានភាព ដ៏ តានតឹង បំផុត លាចាក ទឹកដី លា ចាក ឧត្តម ភរិយា និង កូន ក្នុង ផ្ទៃ ជា ទីស្រឡាញ់ ឆ្លងកាត់ ព្រំដែន ទាំង គ្រោះថ្នាក់ បំផុត ឆ្ពោះ ទៅកាន់ ប្រទេស វៀតណាម ដើម្បី ស្វែងរក គាំទ្រ ក្នុង ការរំដោះ ជាតិ និង ប្រជាជន កម្ពុជា ចេញ ពី ក្រញាំ បិសាច ដ៏ សែន ឃោរឃៅ ប៉ុល ពត ។
ក្រុម អ្នកប្រវត្តិសាស្ត្រ ខ្មែរ បាន មើលឃើញ ប្រសិនបើ គ្មាន ការចាប់ផ្តើម ចេញ តស៊ូ របស់ សម្តេច តេជោ ហ៊ុន សែន និង ឥស្សរជន ខ្មែរ ស្នេហាជាតិ នាំគ្នា ងើប ប៉ះ បោរ រំដោះ ជាតិ ឡើង ទេ នោះ ជាតិ និង ប្រជាជន កម្ពុជា គ្មាន ឱកាស រួចផុត ពី របប ដ៏ ប្រល័យ របស់ ប៉ុល ពត នោះ ឡើយ ៕
កម្លាំង នគរបាល រាជធានី ភ្នំពេញ តាម បង្ក្រាប មុខ សញ្ញា ឆក់ យ៉ាង សកម្ម ចំនួន ៣នាក់ ជា បន្តបន្ទាប់
( ភ្នំពេញ ) ៖ ដោយ អនុវត្ត តាម បទបញ្ជា របស់ ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០២៣ វេលា ម៉ោង ១៤៖ ២០នាទី កម្លាំង ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កំរិត ស្រាល រាជធានី ភ្នំពេញ បាន ស្រាវជ្រាវ ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៣នាក់ ជា បន្តបន្ទាប់ នៅ ចំណុច មុខ ស្ថាននីយ៍ ប្រេងឥន្ធនៈ តូតាល់ ផ្លូវ លេខ ២៧១ សង្កាត់ បឹងសាឡាង ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ពាក់ព័ន្ធ ករណី ឆក់ ទ្រព្យសម្បត្តិ របស់ ប្រជាពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ ចំនួន ០៦ ករណី ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង ខាងលើ កម្លាំង ការិយាល័យ កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ បន្ត តាម នីតិវិធី ៕ សម្តេច តេជោ ហ៊ុន សែន ចាប់ផ្តើម សង្ស័យ លើ សកម្មភាព របស់ ខ្មែរ ក្រហម តាំងពី ខែកញ្ញា ឆ្នាំ ១៩៧៤ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២៣ បាន ថ្លែង ថា សម្តេច ចាប់ផ្តើម សង្ស័យ លើ សកម្មភាព របស់ ខ្មែរ ក្រហម តាំងពី ខែកញ្ញា ឆ្នាំ ១៩៧៤ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « សំឡឹង មើល ទៅ អតីតកាល ។ ថ្ងៃ នេះ ជា ថ្ងៃ ខ្ញុំ លំបាក បំផុត កាលពី ៤៦ ឆ្នាំ មុន ។ មិន មែន យើង សម្រេច ភ្លាម ធ្វើ ភ្លាម ទេ ។ ខ្ញុំ ចាប់ផ្តើម មាន ការសង្ស័យ ទៅ លើ ពួក ខ្មែរ ក្រហម តាំងពី ខែកញ្ញា ឆ្នាំ ១៩៧៤ ឯណោះ ។ នេះ ជា ការចាប់ផ្តើម ការសង្ស័យ នៅ ពេល ដែល គេ បញ្ជូន កម្លាំង របស់ ខ្ញុំ ទៅ ការពារ កោះ សំរោង នៅ ខាងលើ ខេត្ត កំពង់ចាម » ។
សូម ជម្រាប ថា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២៣ គឺជា រយៈពេល ៤៦ ឆ្នាំ ហើយ ដែល សម្តេច តេជោ ហ៊ុន សែន និង យុទ្ធ មិត្ត រួម អាវុធ ដ៏ ស្មោះស្ម័គ្រ ៤រូប បាន រួមគ្នា យក ជីវិត ធ្វើជា ដើមទុន ចេញ ទៅកាន់ ប្រទេស វៀតណាម ស្វែងរក ការគាំទ្រ ដើម្បី តស៊ូ រំដោះ ជាតិ និង ប្រជាជន កម្ពុជា ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ដ៏ ឃោរឃៅ របស់ ខ្មែរ ប៉ុល ពត និង បក្ខពួក ។
