( ភ្នំពេញ ) ៖ ថ្នាំជក់ ផ្តល់ ផល ប៉ះពាល់ ជាច្រើន ដល់ សុខភាព សាធារណៈ ដែល បង្ក ជា ជំងឺ មិន ឆ្លង នានា ដូចជា ជំងឺ មហារីក ជំងឺ សរសៃ ឈាម និង បេះដូង ជំងឺ សួត និង ប៉ះពាល់ ដល់ សរីរាង្គ ទាំងអស់ រួមទាំង សេដ្ឋកិច្ច បរិស្ថាន និង សង្គម . លោក សាស្រ្តាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មាធិការ ត្រួតពិនិត្យ ផលិតផល ថ្នាំជក់ បាន អំពាវនាវ ឱ្យ បញ្ឈប់ ការជក់ បារី ដើម្បី ធ្វើឱ្យ ប្រជាពលរដ្ឋ មាន អាយុ វែង ។
ការថ្លែង ដូច្នេះ របស់ លោក សាស្ដ្រាចារ្យ ក្នុង ឱកាស ប្រារព្ធ ពិធី អបអរសាទរ ទិវា ពិភពលោក គ្មាន ថ្នាំជក់ ឆ្នាំ ២០២៣ នេះ ក្រោម ប្រធានបទ « យើង ត្រូវការ អាហារ មិន មែន ថ្នាំជក់ » ដោយ ផ្តោត លើ ការជំរុញ ការដាំដុះ ដំណាំ អាហារ ប្រកបដោយ និរន្តរភាព ជំនួស ឲ្យ ដំណាំ ថ្នាំជក់ ដែល ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង សុខាភិបាល នា ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ។
ទិវា ពិភពលោក គ្មាន ថ្នាំជក់ ជា ព្រឹត្តិការណ៍ ដ៏ សំខាន់ មួយ ដែល កំណត់ ឡើង ដោយ អង្គការ សុខភាព ពិភពលោក ចាប់តាំងពី ឆ្នាំ ១៩៨៧ បាន ប្រារព្ឋ ឡើង ជារៀងរាល់ ឆ្នាំ នៅ ថ្ងៃទី ៣១ ខែឧសភា ដើម្បី រំលឹក អំពី ផល ប៉ះពាល់ ដ៏ ធ្ងន់ធ្ងរ របស់ ផលិតផល ថ្នាំជក់ មក លើ សុខភាព សេដ្ឋកិច្ច បរិស្ថាន និង សង្គម និង សូម អំពាវនាវ ដល់ រដ្ឋ ភាគី ទាំងអស់ ព្រមទាំង ដៃគូ ពាក់ព័ន្ធ រួមគ្នា ជំរុញ ការលះបង់ ទម្លាប់ ប្រើប្រាស់ ថ្នាំជក់ និង ទប់ស្កាត់ មនុស្ស បច្ចុប្បន្ន និង ជំនាន់ ក្រោយពី ការប្រើប្រាស់ ផលិតផល ថ្នាំជក់ ។
លោក រដ្ឋមន្ដ្រី បាន ថ្លែង បន្ដ ថា « ថ្នាំជក់ ធ្វើឱ្យ យើង កើត ជំងឺ មហារីក សួត ក្រពេញ ធ្វើឱ្យ កូន កើត មក មិន គ្រប់ ខែ ខាតបង់ ទាំង សុខភាព និង សេដ្ឋកិច្ច គ្រួសារ ពិសេស ត្រូវ យល់ដឹង ថា ថ្នាំជក់ មិន មែន ចំណី អាហារ ទេ ហើយក៏ មិន អាច ជំនួស អាហារ បាន ផងដែរ ដូច្នេះ ត្រូវតែ ទុក លុយ ទិញ ចំណីអាហារ កាន់តែ ពិសេស នោះ គឺ គ្មាន ផ្សែង បារី ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ អ្នកដទៃ » ។
លោក សាស្ដ្រាចារ្យ សង្ឃឹម ថា យ៉ាង មុតមាំ ថា ប្រជាពលដ្ឋ យើង នឹង ចូលរួម ប្រតិបត្ដិ ឱ្យ បាន ច្រើន យើង ត្រូវ យល់ ថា ថ្នាំជក់ មិន អាច ជំនួស ចំណីអាហារ បាន ទេ អស់ លុយ ហើយ ប៉ះពាល់ ដល់ សុខភាព ទៀត ទាំង ខ្លួន ឯង យើង និង គ្រួសារ ដែល ស្រប ផ្សែង បារី ពី យើង ពិសេស ស្ដ្រី ដែល កំពុង មាន កគ៌ អាច បណ្ដាលឱ្យ កូន មិន គ្រប់ ខែ ។
ចិន បាន សាងសង់ ស្ថានីយ អវកាស ខាងលើ របស់ ខ្លួន ចប់ រួចរាល់ ជា ស្ថាពរ កាលពី ចុង ឆ្នាំ មុន ហើយ វា ត្រូវ គេ រំពឹង ថា នឹង ស្ថិត នៅ គន្លង កម្រិត ទាប ក្បែរ ផែនដី ដែល មាន កម្ពស់ ចន្លោះ ៤០០ - ៤៥០ គីឡូម៉ែត្រ ពី ផ្ទៃ នៃ ភព របស់ យើង សម្រាប់ រយៈពេល យ៉ាងហោច១០ឆ្នាំ ។ ទីក្រុង ប៉េកាំង នឹង បន្ត បញ្ជូន ក្រុម អវកាសយានិក ឱ្យ ផ្លាស់ វេន គ្នា ស្នាក់ នៅក្នុង ស្ថានីយ នោះ ជាប់ រហូត ។
សម្តេច កិត្ដិ សង្គហ បណ្ឌិត ម៉ែន សំអន៖ បន្ត បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន គឺ ជំរុញ ល្បឿន អភិវឌ្ឍ ទាំង ពុទ្ធ ចក្រ និង អាណាចក្រ
( ក្រចេះ ) ៖ សម្តេច កិត្ដិ សង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្រ្ដី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច នៅ ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន ថ្លែង ថា បន្ត បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន គឺ ជំរុញ ល្បឿន អភិវឌ្ឍ ទាំង ពុទ្ធ ចក្រ និង អាណាចក្រ ។
ការថ្លែង បែប នេះ របស់ សម្តេច កិត្ដិ សង្គហ បណ្ឌិត ម៉ែន សំអន ធ្វើឡើង ក្នុង ពិធី បញ្ចុះ ខណ្ឌ សីមា និង សម្ពោធ សមិទ្ធិផល នានា នៅ វត្ត មហា កំពែង រាជ កំពូល ពេជ្រ ស្ថិត នៅ ឃុំ ព្រែក ប្រសព្វ ស្រុក ព្រែក ប្រសព្វ ខេត្ត ក្រចេះ នា ព្រឹក ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២៣ ។
សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ក៏ បាន ថ្លែង ផងដែរ ថា រាល់ សមិទ្ធផល ទាំងឡាយ ដែល បាន អភិវឌ្ឍន៍ គឺ ដោយសារ ប្រទេស មាន សុខ សន្តិភាព ដែល យើង ទាំងអស់ គ្នា ទទួលបាន ដោយសារ ការខិតខំ ប្រឹងប្រែង របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន អនុវត្ត ទៅ លើ នយោបាយ ឈ្នះ - ឈ្នះ ។
សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន បន្ត ទៀត ថា ប្រសិនបើ គ្មាន ការឯកភាព ជាតិ គ្មាន សុខ សន្តិភាព ទេ នោះ ការអភិវឌ្ឍន៍ ផ្សេង ៗ ក៏ យើង មិន អាច ជំរុញ ទៅ មុខ បាន ដែរ ទាំង វិស័យ ពុទ្ធ ចក្រ និង វិស័យ អាណាចក្រ ពោលគឺ ពុទ្ធ បរិស័ទ គ្រប់ រូប ក៏ គ្មាន លទ្ធភាព បង្ករ បង្កើន ចំណូល យកមក ចូល បច្ច័យ ដើម្បី កសាង សមិទ្ធផល ក្នុង វត្ត មហា កំពែង រាជ កំពូល ពេជ្រ នេះ ។
គួរ បញ្ជាក់ ថា កន្លងមក ទីក្រុង កៀវ និង សម្ព័ន្ធមិត្ត របស់ ខ្លួន និយាយ ថា អ៉ីរ៉ង់ បាន និង កំពុង ផ្គត់ផ្គង់ សព្វាវុធ ដល់ រុស្ស៉ី ដែល រួម មាន ទាំង យន្តហោះ ដ្រូន រាប់ រយ គ្រឿង ចាប់តាំងពី ក្រុង មូស្គូ ចូល ឈ្លានពាន អ៊ុយក្រែន កាលពី ឆ្នាំ ២០២២ ៕
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២៣ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៨. ៧៧១ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៥. ៦៨៥ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ រដ្ឋបាល រាជធានី ភ្នំពេញ ជូនដំណឹង ស្ដីពី ការបញ្ចៀស ចរាចរ យានយន្ដ គ្រប់ ប្រភេទ ជា បណ្ដោះអាសន្ន ក្នុង ពិធី បើក និង ពិធី បិទ ព្រឹត្ដិការណ៍ ប្រកួត កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការបញ្ចៀស ចរាចរ យានយន្ដ គ្រប់ ប្រភេទ ជា បណ្ដោះអាសន្ន ក្នុង ពិធី បើក និង ពិធី បិទ ព្រឹត្ដិការណ៍ ប្រកួត កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ឆ្នាំ ២០២៣ នៅ ពហុកីឡាដ្ឋាន ជាតិ មរតក តេជោ ។
ក្រៅពី លោក បៃ ដិន ប្រធានាធិបតី រុស្ស៉ី លោក វ្ល៉ាឌីមៀ ពូទីន ដែល កំពុង ជាប់ ដៃ នឹង សង្រ្គាម នៅ អ៊ុយក្រែន រួមទាំង ប្រធានាធិបតី អ៊ុយក្រែន លោក ហ្សេលេន ស្គី មេដឹកនាំ អង់គ្លេស បារាំង អារ៉ាប៊ី សាអូឌីត និង មេដឹកនាំ ដទៃ ទៀត ក៏ បាន ផ្ញើរ អបអរសាទរ ជ័យជម្នះ របស់ លោក អឺ ដូហ្កាន់ ផងដែរ ។
គួរ បញ្ជាក់ ថា បើ តាម លទ្ធផល បោះឆ្នោត លោក អឺ ដូហ្កាន់ ទទួលបាន សំឡេង គាំទ្រ ៥២.១ ភាគរយ ខណៈ លោក កេម៉ាល គីលីក ដារ៉ូគ្លូ ទទួលបាន សំឡេង គាំទ្រ ៤៧. ៩ភាគរយ ។ លោក គីលីក ដារ៉ូ គ្លូ បាន ចាត់ទុក ការបោះឆ្នោត កាលពី ថ្ងៃអាទិត្យ ជា ការបោះឆ្នោត មួយ គ្មាន តម្លារ ភាព ប៉ុន្តែ លោក ក៏ មិន បាន ជំទាស់ នឹង លទ្ធផល បោះឆ្នោត អ្វី នោះ ដែរ ៕
ឈ្វេងយល់ ពី ប្រទេស ឥណ្ឌា ទី ដែល ព្រះមហាក្សត្រ យាង បំពេញ ព្រះរាជ ទស្សនកិច្ច ផ្លូវ រដ្ឋ (Video inside) ( ញូវ ដេលី) ៖ នៅ ព្រឹក ថ្ងៃចន្ទ ១០កើត ខែ ជេស្ឋ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា សព្វ ព្រះរាជ ហឫទ័យ យាង បំពេញ ព្រះរាជ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ ប្រទេស ឥណ្ឌា ។
យោង តាម ក្រសួង ការបរទេស បាន ឱ្យដឹង ថា ព្រះរាជ ដំណើរ បំពេញ ព្រះរាជ ទស្សនកិច្ច របស់ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង នៅ ប្រទេស ឥណ្ឌា នា ពេលនេះ មាន រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៩ ដល់ ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០២៣ តប តាម ការអញ្ជើញ របស់ លោកស្រី ដ្រៅ ផាឌី មួរ មូ ប្រធានាធិបតី ឥណ្ឌា ។
បើ តាម ក្រសួង ការបរទេស កម្ពុជា បាន ឱ្យដឹង ថា ក្នុង កំលុង ពេល នៃ ព្រះរាជ ទស្សនកិច្ច នេះ លោកស្រី ដ្រៅ ផាឌី មួរ មូ ប្រធានាធិបតី ឥណ្ឌា និង លោក ណារិន ដ្រា ម៉ូឌី (Narendra Modi) នាយក រដ្ឋមន្ត្រី ឥណ្ឌា នឹង ទទួល រៀបចំ ព្រះរាជ ពិធី សវនាការ ថ្វាយ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ដែល ក្នុង ឱកាស នោះ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី និង ពហុ ភាគី នឹង ត្រូវ លើក យកមក ពិភាក្សា ។ ខាងក្រោម គឺជា ចំណុច សំខាន់ ៗ គួរ ឈ្វេងយល់ ពី ប្រទេស ឥណ្ឌា៖
១. ប្រវត្តិ រូប សង្ខេប
២. កាលបរិច្ឆេទ សំខាន់ ៗ ក្នុង ប្រវត្តិសាស្ត្រ ឥណ្ឌា
វប្បធម៌ ប្រទេស ឥណ្ឌា បាន អូសបន្លាយ អស់ រយៈពេល ៤៥០០ ឆ្នាំ មកហើយ ។ សង្គម ឥណ្ឌា ត្រូវបាន កំណត់ ទៅ តាម វណ្ណៈ ក្នុង សង្គម ដែល មាន ភាពរឹតបន្តឹង ជាខ្លាំង ។ តម្លៃ គ្រួសារ មាន សារៈសំខាន់ ជាខ្លាំង ក្នុង ប្រពៃណី ឥណ្ឌា ។
អាពាហ៍ពិពាហ៍ ត្រូវបាន គេ គិត ថា ជា រឿង ជីវិត ដ៏ សំខាន់ មួយ ហេតុ នេះ អត្រា នៃ ការលែងលះ គឺ ទាប បំផុត ។ គិត ត្រឹម ឆ្នាំ ២០០១ ស្ត្រី ឥណ្ឌា តែ ១.៦ ភាគរយ ប៉ុណ្ណោះ ដែល បាន លែងលះ គ្នា ប៉ុន្តែ តួលេខ នេះ បាន កើនឡើង ដោយសារតែ ការអប់រំ និង ឯករាជ្យ នៃ សេដ្ឋកិច្ច របស់ ស្ត្រី ។ អាពាហ៍ពិពាហ៍ កុមារ បាន ក្លាយជា រឿង ធម្មតា ទៅ ហើយ ជាពិសេស នៅ តាម តំបន់ ជនបទ ។ ស្ត្រី ជាច្រើន បាន រៀបអាពាហ៍ពិពាហ៍ មុន អាយុ ១៨ ឆ្នាំ ដែល ជា អាយុ រៀបការស្រប ច្បាប់ របស់ ពួកគេ ។
៤. ទំនាក់ទំនង អន្តរជាតិ និង យោធា
ចាប់តាំងពី ទទួលបាន ឯករាជ្យ នៅ ឆ្នាំ ១៩៤៧ មក ឥណ្ឌា បាន ថែរក្សា ចំណង មិត្តភាព ជាមួយ ប្រជាជាតិ ជាច្រើន ។ នៅ ទសវត្សរ៍ ឆ្នាំ ១៩៥០ ឥណ្ឌា បាន ចាប់ យក តួនាទី ជា អ្នកគាំទ្រ ដឹកនាំ ការទាមទារ ឯករាជ្យ របស់ បណ្ដា ប្រទេស នៅ ទ្វីប អាស៊ី និង អាហ្វ្រិក ក្រោម អាណានិគម អឺរ៉ុប ។
ប៉ុន្មាន ចុងក្រោយ នេះ ឥណ្ឌា បាន ដើរ តួនាទី ដ៏ មាន ឥទ្ធិពល ក្នុង សមាគម អាស៊ាន អង្គការ SAARC និង អង្គការ WTO ។ ឥណ្ឌា គឺជា សមាជិក និង ជា អ្នកគាំទ្រ អង្គការ សហ ប្រជាជាតិ ជា យូរ ណាស់ មកហើយ ។ នៅក្នុង ប្រតិបត្តិការ ថែរក្សា សន្តិសុខ ចំនួន ៣៥ ទូទាំង ទ្វីប ទាំង ៤ មាន កងទ័ព និង កម្លាំង នគរបាល ឥណ្ឌា ជាង ៥៥.០០០ នាក់ ផងដែរ ។
ចាប់តាំងតែពី បាន ទទួល ឯករាជ្យ មក ឥណ្ឌា បាន ប្រកាន់ភ្ជាប់ នូវ ទិសដៅ សង្គម និយម ជាមួយនឹង ការគ្រប់គ្រង យ៉ាង តឹងរឹង ទៅ លើ ផ្នែក ឯកជន ដូចជា ពាណិជ្ជកម្ម ក្រៅ ប្រទេស និង ការវិនិយោគ ផ្ទាល់ ពី បរទេស ។ ទោះជា យ៉ាងណា ក្ដី ចាប់ពី ឆ្នាំ ១៩៩១ មក ឥណ្ឌា បាន បើក ចំហ ទីផ្សារ របស់ ខ្លួន ដោយ ធ្វើ កំណែទម្រង់ សេដ្ឋកិច្ច និង បន្ធូរបន្ថយ ការគ្រប់គ្រង របស់ រដ្ឋ ទៅ លើ ការធ្វើ ពាណិជ្ជកម្ម និង ការវិនិយោគទុន បរទេស ។
ក្រុម អ្នកវិភាគ បាន និយាយ ថា ផ្កាយ រណប យោធា ដែល កូរ៉េ ខាងជើង គ្រោង បាញ់ បង្ហោះ គឺជា ផ្នែក មួយ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង អភិវឌ្ឍន៍ បច្ចេកវិទ្យា ផ្កាយ រណប ស៊ើបការណ៍ ក្នុង នោះ រួម មាន ទាំង យន្ដហោះ ដ្រូន ដើម្បី ពង្រឹង សមត្ថភាព វាយប្រហារ ឱ្យ ចំ គោលដៅ ជាក់លាក់ ក្នុង ករណី មាន ជម្លោះ ផ្ទុះឡើង ។ កូរ៉េ ខាងជើង ក៏ បាន និង កំពុង ធ្វើតេស្ដ ផងដែរ នូវ មីស៊ីល ជា បន្តបន្ទាប់ និង អាវុធ នុយក្លេអ៊ែរ តាក់ទិក ជាពិសេស គឺ បច្ចេកវិទ្យា មីស៊ីល បាលិស្ទីគ អន្តរ ទ្វីប ICBM ឥន្ធនៈ រឹង ។
បើ តាម ទូរទស្សន៍ ជប៉ុន NHK ខាង កូរ៉េ ខាងជើង បាន ជូន ដំណឹង មកកាន់ ឆ្មាំ សមុទ្រ ជប៉ុន ពី ផែនការបាញ់ បង្ហោះ ផ្កាយ រណប ហើយ ការិយាល័យ នាយក រដ្ឋមន្ត្រី ជប៉ុន បាន ជំរុញ ឱ្យ កូរ៉េ ខាងជើង បញ្ឈប់ ការធ្វើតេស្ដ អាវុធ របស់ ខ្លួន ហើយ ថា ទីក្រុង តូក្យូ នឹង ធ្វើការ យ៉ាង ជិតស្និទ្ធ ជាមួយ សម្ព័ន្ធមិត្ត ដូចជា សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងត្បូង ។
បើ តាម លទ្ធផល បោះឆ្នោត លោក អឺ ដូហ្កាន់ ទទួលបាន សំឡេង គាំទ្រ ៥២.១ ភាគរយ ខណៈ លោក កេម៉ាល គីលីក ដារ៉ូគ្លូ ទទួលបាន សំឡេង គាំទ្រ ៤៧. ៩ភាគរយ ។ លោក គីលីក ដារ៉ូ គ្លូ បាន ចាត់ទុក ការបោះឆ្នោត កាលពី ថ្ងៃអាទិត្យ ជា ការបោះឆ្នោត មួយ គ្មាន តម្លារ ភាព ប៉ុន្តែ លោក ក៏ មិន បាន ជំទាស់ នឹង លទ្ធផល បោះឆ្នោត អ្វី នោះ ដែរ ។
នៅ ក្រោយ ប្រកាស ពី ជ័យជម្នះ លោក អឺ ដូហ្កាន់ បាន សន្យា ថា នឹង ទុក ជម្លោះ ទាំងឡាយ មួយ ឡែក ហើយ នឹង ស្វែងរក ការឯកភាព ជាតិ ដោយ តម្កល់ គុណ តម្លៃ ជាតិ ជា ធំ ៕ ព្រឹក នេះ គ.ជ. ប ចាប់ ឆ្នោត កំណត់ លំដាប់ លេខរៀង ឈ្មោះ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត លើ សន្លឹក ឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២៣ នេះ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) រៀបចំ ចាប់ ឆ្នោត ដើម្បី កំណត់ លំដាប់ លេខរៀង ឈ្មោះ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត លើ សន្លឹក ឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ។
សម្រាប់ ការចាប់ សន្លឹក ឆ្នោត បាន ប្រព្រឹត្តិ ធ្វើឡើង ក្រោម ព្រះវត្តមាន សម្តេច សង្ឃរាជ ទាំង ពីរ គណៈ ព្រមទាំង មាន ការចូលរួម ពីសំណាក់ តំណាង គណបក្ស នយោបាយ ទាំង ១៨ ដែល បាន ចុះបញ្ជី នៅ គ.ជ. ប រួចរាល់ ។
ការរៀបចំ បោះឆ្នោត អាណត្តិ ទី៧ នឹង ចាប់ផ្តើម នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ៕ ព្រឹក នេះ ព្រះមហាក្សត្រ យាង បំពេញ ព្រះរាជ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ ប្រទេស ឥណ្ឌា
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃចន្ទ ១០កើត ខែ ជេស្ឋ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា សព្វ ព្រះរាជ ហឫទ័យ យាង បំពេញ ព្រះរាជ ទស្សនកិច្ច ផ្លូវ រដ្ឋ នៅ ប្រទេស ឥណ្ឌា ។
យោង តាម ក្រសួង ការបរទេស បាន ឱ្យដឹង ថា ព្រះរាជ ដំណើរ បំពេញ ព្រះរាជ ទស្សនកិច្ច របស់ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង នៅ ប្រទេស ឥណ្ឌា នា ពេលនេះ មាន រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៩ ដល់ ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០២៣ តប តាម ការ របស់ លោកស្រី ដ្រៅ ផាឌី មួរ មូ ប្រធានាធិបតី ឥណ្ឌា ។
លោក បណ្ឌិត ម៉ឹង មករា ជួប សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ សកម្មជន និង យុវជន គណបក្ស ប្រជាជន កម្ពុជា ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម ជាង ៣០០០ នាក់
( កំពង់ចាម ) ៖ នា ថ្ងៃអាទិត្យ ទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ លោក បណ្ឌិត ម៉ឹង មករា ប្រធាន ក្រុមការងារ ជន បង្គោល ចុះ ជួយ ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម តំណាង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត សមាជិក អចិន្ត្រៃយ៍ គណបក្ស និង ជា ប្រធាន យុវជន គណបក្ស ប្រជាជន កម្ពុជា បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ សកម្មជន នឹង យុវជន គណបក្ស ប្រជាជន កម្ពុជា ស្រុក ជើង ព្រៃ ជាង ៣០០០ នាក់ ។
លោក បណ្ឌិត ម៉ឹង មករា ក៏ បាន សង្កត់ធ្ងន់ ថា គណបក្ស ប្រជាជន កម្ពុជា គឺជា គណបក្ស តែ មួយ គត់ ដែល មាន ភាព ចាស់ទុំ ជាង គេ ក្នុង ការដឹកនាំ ប្រទេសជាតិ ឲ្យ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ ជា គណបក្ស ធំ ជាង គេ មាន សមាជិក ច្រើន ជាង គេ មាន គោល នយោបាយ ច្បាស់លាស់ និង មាន សក្តានុពលភាព ជាង គេ ក្នុង ការគ្រប់គ្រង និង បន្ត ដឹកនាំ ក សាង ប្រទេសជាតិ ឱ្យ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ ជា និរន្តរ៍ ។
( កណ្ដាល ) ៖ ក្រុមការងារ ចម្រុះ របស់ អាជ្ញាធរ ខេត្ត កណ្ដាល ដឹកនាំ ដោយ លោក ណុប ដារ៉ា អភិបាល រង ខេត្ត នៅ ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន ចុះ ពិនិត្យ ទីតាំង រណ្ដៅ ដី មួយ កន្លែង របស់ ឧកញ៉ា អ៊ុក រដ្ឋា ហៅ ឧកញ៉ា មហា រដ្ឋា ស្ថិត នៅ ភូមិ ពុក ឫស្សី កណ្ដាល ឃុំ ពុក ឫស្សី ស្រុក ខ្សាច់ កណ្ដាល ។
មន្ដ្រី សាលា ខេត្ត បាន ឲ្យដឹង ថា ក្រុមការងារ ចម្រុះ ដែល មាន កងកម្លាំង មន្ទីរ ជំនាញ ពាក់ព័ន្ធ និង អាជ្ញាធរ ស្រុក ដោយ មាន ការសម្របសម្រួល ពី លោក ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត លោក ហោ លីណា ចុះ ពិនិត្យ ដល់ ទីតាំង ជាក់ស្ដែង នៃ រណ្តៅ ដី មួយ កន្លែង ដែល ម្ចាស់ ទីតាំង ឈ្មោះ អ៊ុក រដ្ឋា ដើម្បី ត្រួតពិនិត្យ លើ លក្ខណៈ បច្ចេកទេស ការអនុវត្ត តាម វិធានការ ច្បាប់ និង អាជ្ញាប័ណ្ណ ។
ក្រុមការងារ បាន រកឃើញ ថា ទីតាំង រណ្តៅ ដី កំពុង ធ្វើ សកម្មភាព ដឹកជញ្ជូន យ៉ាង សកម្ម ហើយ ទីតាំង នេះ មិន មាន អាជ្ញាប័ណ្ណ ឡើយ ។ ក្រុមការងារ ចម្រុះ ខេត្ត បាន តម្រូវឲ្យ ការដ្ឋាន នេះ ត្រូវ ផ្អាក អាជីវកម្ម និង ប្រគល់ ជូន មន្ទីរ រ៉ែ និង ថាមពល ខេត្ត ធ្វើ តាម នីតិវិធី ។ ក្នុង ករណី ម្ចាស់ អាជីវកម្ម នៅ បន្ត ធ្វើ សកម្មភាព ក្រុមការងារ នឹង កសាង សំណុំរឿង និង អនុវត្ត តាម នីតិវិធី ច្បាប់ ហើយ ម្ចាស់ អាជីវកម្ម ត្រូវ ធ្វើ ការបង់ សួយ សារ ទៅ តាម បរិមាណ អាច ម៌ ដី ដែល បាន ធ្វើ អាជីវកម្ម កន្លងមក ។
