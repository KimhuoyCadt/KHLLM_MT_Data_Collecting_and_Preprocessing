( ស្វាយរៀង ) ៖ គុណ តម្លៃ នៃ ការដឹកនាំ របស់ បក្ស ប្រជាជន កម្ពុជា បាន ធ្វើឱ្យ ប្រជាពលរដ្ឋ ជឿជាក់ ហើយ ចូលរួម បម្រើ សង្គម ក្រោម មាគ៌ា ដឹកនាំ របស់ បក្ស ជា បន្តបន្ទាប់ ។ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ គណបក្ស ប្រជាជន កម្ពុជា ឃុំ ក ណ្ដៀង រាយ ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង បាន រៀបចំ ពិធី ប្រកាស បញ្ចូល សមាជិក បក្ស ថ្មី ចំនួន ៣៣២ នាក់ ទៀត ។
ពិធី ប្រកាស បញ្ចូល សមាជិក ថ្មី របស់ បក្ស ប្រជាជន កម្ពុជា ក្នុង ឃុំ ក ណ្តៀង រាយ បាន ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព លោក មុឹង ពន្លក អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ស្រុក ស្វាយទាប និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ឃុំ ក ណ្ដៀង រាយ ។
ក្នុង ពិធី នោះ លោក ម៉ឹង ពន្លក បាន សម្តែង នូវ ការស្វាគមន៍ យ៉ាង កក់ក្តៅ បំផុត ចំពោះ សមាជិក សមាជិកា ថ្មី ដែល បាន ជឿជាក់ លើ ការដឹកនាំ របស់ បក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ហើយ ចូលរួម បម្រើ សង្គម ក្រោម មាគ៌ា ដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ បក្ស ប្រជាជន កម្ពុជា ។
ក្រៅតែ ពី ការថ្លែង ស្វាគមន៍ ហើយ នោះ លោក ម៉ឹង ពន្លក បាន គូស រំលេច ពី សមិទ្ធផល ជាច្រើន ដែល កើតមាន ក្នុង សង្គម ក្រោម ការដឹកនាំ របស់ ប្រជាជន កម្ពុជា រួម មាន ការប្រឹងប្រែង ស្វែងរក សុខ សន្តិភាព ហើយ រក្សា បាន សុខ សន្តិភាព ជា មូលដ្ឋានគ្រឹះ ផ្តល់ ការរស់នៅ ដ៏ សុខសាន្ត ដល់ ប្រជាពលរដ្ឋ និង ការកសាង សង្គមជាតិ ឱ្យ រីកចម្រើន ។
លោក ម៉ឹង ពន្លក ក៏ បាន គូស រំលេច ពី ការរីកចម្រើន លើ វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ ក្នុង ក្របខណ្ឌ ទូទាំង ប្រទេស ក៏ ដូចជា នៅក្នុង ខេត្ត ស្វាយរៀង មាន ដូចជា ការលើកកម្ពស់ គុណភាព ផ្លូវ ជាតិ លេខ ១ ស្ពាន ហ្សឹបាសា និង គម្រោង សាងសង់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត ជាដើម ។ លោក បាន លើកឡើង ថា សមិទ្ធផល ទាំងអស់ នេះ លេចចេញ ជា រូប គឺ ដោយសារ តែ មាគ៌ា ដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ បក្ស ប្រជាជន កម្ពុជា ។
បន្ទាប់ពី សំណេះសំណាល លោក ម៉ឹង ពន្លក បាន ឧបត្ថម្ភ ជូន សមាជិក បក្ស ថ្មី ក្នុង ១នាក់ ទទួលបាន ថវិកា ១០.០០០ រៀល អាវ បក្ស មួួយ និង មួក មួយ ផងដែរ ។
បន្ទាប់ពី ចប់ ពិធី ស្វាគមន៍ សមាជិក បក្ស ថ្មី ហើយ នោះ លោក ម៉ឹង ពន្លក ក៏ បាន ដឹកនាំ ក្រុមការងារ ចុះ ត្រួតពិនិត្យមើល ទីតាំង មន្ទីរ គណបក្ស ឃុំ ដើម្បី ត្រៀម ពង្រីក អគារ គណបក្ស ឃុំ និង បាន ចុះ ពិនិត្យ មន្ទីរពេទ្យ បង្អែក ស្រុក ស្វាយទាប ដែល ក្រុមការងារ ធ្លាប់ បាន ជួយ កសាង នា ពេល កន្លងមក ៕
ផ្លូវ លំ ក្រាល គ្រួស ក្រហម ប្រវែង ជាង ៤គីឡូម៉ែត្រ នៅ ឃុំ សូយោង ត្រូវ ជួល ជុល និង កែលំអរ ឡើងវិញ ក្រោម ការឧបត្ថម្ភ ពី លោក អ៉ឹង ចាន់ ឡា និង លោកស្រី ឆាយ សុគង់
លោក ហាក់ ម៉ុង ហួត អភិបាល ស្រុក តាំង គោក ក៏ បាន ថ្លែងអំណរគុណ ដល់ លោក អ៉ឹង ចាន់ ឡា ( ហៅ ម៉ិច ) និង ភរិយា ដែល បាន ចូលរួមចំណែក អភិវឌ្ឍន៍ ជាមួយ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
លោក អភិបាល ស្រុក តាំង គោក បាន បញ្ជាក់ ថា ក្រោម ដំបូល នៃ សុខ សន្តិភាព ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ តែងតែ ជំរុញឱ្យ មន្ត្រី អាជ្ញាធរ មូលដ្ឋាន ចុះ ជាប់ ជាមួយ ប្រជាពលរដ្ឋ បម្រើ ប្រជាពលរដ្ឋ ជួយ សម្រួល ទុក្ខលំបាក ប្រជាពលរដ្ឋ ដោយ រៀបចំ កសាង នូវ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ ថ្នល់ ជាដើម ដោយ ក្នុង នោះ បាន ប្រែក្លាយ ពី ផ្លូវ លំ ទៅ ផ្លូវ ក្រាល គ្រួស ក្រហម ពី ផ្លូវ ក្រាល គ្រួស ក្រហម ទៅជា ផ្លូវ កៅស៊ូ ដើម្បី បម្រើ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ងាយស្រួល ក្នុង ដឹកជញ្ជូន កសិផល កសិកម្ម របស់ ពួកគាត់ ទៅកាន់ ទីផ្សារ ។
ក្នុង ឱកាស នោះ លោក អភិបាល ស្រុក ក៏ សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម ថែទាំ ផ្លូវ នេះ ឱ្យ បាន គង់វង្ស យូរអង្វែង ដោយ មិន ត្រូវ ដឹក លើស ទម្ងន់ ដែល បង្កឱ្យ ខូច ផ្លូវ នោះ ទេ និង ត្រូវ គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា ដោយ ត្រូវ ពាក់ មួក សុវត្ថិភាព ឱ្យ បាន ជាប់ ជាប្រចាំ រាល់ ពេល ធ្វើដំណើរ ម្តង ៗ ផងដែរ ៕
បណ្ឌិត ហ៊ុន ម៉ាណែត ជួប សំណេះសំណាល ជាមួយ សកម្មជន យុវជន ផែន សហគ្រិន វ័យ ក្មេង នៃ ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត នៅ ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន ជួប សំណេះសំណាល ជាមួយ សកម្មជន យុវជន ផែន សហគ្រិន វ័យ ក្មេង នៃ ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ នៅ ទីស្នាក់ការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បន្ត ថា ដូច្នេះ ក្នុង នាម ជា យុវជន ដែល កំពុង រស់ ក្នុង សម័យ តេជោ សន្តិភាព . យើង ទាំងអស់ គ្នា ចាំបាច់ ត្រូវ មើល គំរូវីរភាព របស់ យុវជន ជំនាន់ មុន ដោយ ផ្សារភ្ជាប់ នឹង តថភាព បច្ចុប្បន្ន និង គោលដៅ ទៅ អនាគត និង មិន ភ្លេច សោះឡើយ នូវ អតីតកាល ដ៏ សែន ជូរ ចត់ វេទនា ដោយសារ សង្គ្រាម និង ជម្លោះ បែកបាក់ ។ ក្នុង ន័យ នេះ . យើង ទាំងអស់ គ្នា ចងចាំ ជានិច្ច នូវ គុណ បំណាច់ នៃ ពលិកម្ម ដ៏ ធំធេង របស់ យុវជន ជំនាន់ មុន ហើយ ប្តេជ្ញា បន្ត ស្មារតី និង សកម្មភាព ដ៏ ពិសិដ្ឋ នេះ ជារៀងដរាប ។
( ភ្នំពេញ ) ៖ នា ព្រឹក ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ (TYDA) ដឹកនាំ ដោយ លោក វេជ្ជបណ្ឌិត ស៊ីម ស៊ូ យេង អនុប្រធាន ប្រត្តិបត្តិ និង ជា ប្រធាន បេសកកម្ម បាន នាំ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត ចំនួន ២៦៥ នាក់ ចុះ ពិនិត្យ និង ព្យាបាល ជំងឺ ទូទៅ ជូន ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង សង្កាត់ ក្បាល កោះ ខណ្ឌ ច្បារអំពៅ បាន ចំនួន ១. ៥៨៧ នាក់ សរុប ជំងឺ បាន ចំនួន ៣. ០៩៤ ករណី ។
លោក វេជ្ជបណ្ឌិត ស៊ីម ស៊ូ យេង អនុប្រធាន ប្រត្តិបត្តិ និង ជា ប្រធាន បេសកកម្ម TYDA បាន ថ្លែង ថា តាង នាម ឱ្យ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ដែល ជា ប្រធាន និង អនុប្រធាន ក្រុមប្រឹក្សាភិបាល សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ ពិតជា សប្បាយរីករាយ ដែល បាន ចុះ មក ពិនិត្យ ព្យាបាល ជំងឺ ដោយ ឥត គិត ថ្លៃ ជូន ដល់ ប្រជាពលរដ្ឋ លោក តា លោកយាយ បងប្អូន និង ក្មួយ ៗ កុមារា កុមារី នា ឱកាស នេះ ។
លោក វេជ្ជបណ្ឌិត បាន បន្ត ទៀត ថា លោក បណ្ឌិត ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី លោក តែងតែ យកចិត្តទុកដាក់ គិត គូរ ខ្ពស់ ចំពោះ សុខ ទុក្ខ និង សុខភាព របស់ បងប្អូន ប្រជាពលរដ្ឋ ។ ដោយ មាន ការមមាញឹក និង កិច្ចការងារ ច្រើន លោក បណ្ឌិត និង លោកស្រី បាន ផ្តាំផ្ញើ តាមរយៈ លោក ឱ្យ ក្រុមការងារ ជួយ យកចិត្តទុកដាក់ នៅក្នុង ការពិនិត្យ ព្យាបាល ជំងឺ ជូន ដល់ លោកតា លោកយាយ បងប្អូន ទាំងអស់ គ្នា ដោយ ការទទួលខុសត្រូវ ប្រកបដោយ ប្រសិទ្ធិភាព ខ្ពស់ ។
តាម របាយការណ៍ បាន ឱ្យដឹង ថា ប្រជាពលរដ្ឋ ដែល បាន មក ទទួល ការព្យាបាល ជំងឺ ទាំងអស់ មាន ចំនួន ១. ៥៨៧ នាក់ ស្មើនឹង ៣. ០៩៤ ករណី ដោយ ក្នុង នោះ មាន ជំងឺ បញ្ជូន ទៅ ព្យាបាល បន្ត មាន ៣៧ករណី ។ សូម កុំ ចង់ សាកល្បង ប្រើ គ្រឿងញៀន សូម្បី ម្តង ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៨ ខែឧសភា៖ បង្ក្រាប ១៦ករណី ឃាត់ខ្លួន ២៣ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៦ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី . ដឹកជញ្ជូន រក្សាទុក ៧ករណី និង ជួញដូរ ៤ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ២៣ នាក់ ។
ជាមួយគ្នា នេះ ពួកគាត់ ទាំងអស់ គ្នា បាន សុំ រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដោយសារតែ គាត់ បាន ឃើញ ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ ប៉ុណ្ណោះ ដែល បាន បន្ត ការកសាង និង អភិវឌ្ឍ ប្រទេសជាតិ មាន រីកចម្រើន យ៉ាង ឆាប់រហ័ស ។
អតីត សកម្មជន គណបក្ស ភ្លើង ទៀត បាន បញ្ជាក់ ថា ដោយសារ មើលឃើញ ពី គុណ តម្លៃ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ដឹកនាំ ប្រទេស មាន ការអភិវឌ្ឍ រីកចម្រើន និង ល្បីរន្ទឺ លើ ឆាក អន្ដរជាតិ នេះ ហើយ ទើប ខ្លួន ផ្លាស់ប្ដូរ ផ្នត់គំនិត ងាក មក គាំទ្រ រាជ រដ្ឋាភិបាល កម្ពុជា និង សុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា វិញ ។
ដើម្បី សម្រេច នូវ មហិច្ឆា ភូមិសាស្ត្រ នយោបាយ របស់ ចៅហ្វាយ នាយ បរទេស របស់ ពួកគេ ពួកគេ តែងតែ ប្រើប្រាស់ ខ្លឹមសារ ដែល មាន ចរិត បំផុស បំផុល ស្អប់ខ្ពើម ចង អាឃាដ ព្យាបាទ ដោយ មិន បាន ឈរ នៅលើ គោលការណ៍ កណ្តាល នោះ ឡើយ ហើយ ពួកគេ តែងតែ លាប ពណ៌ ដល់ រដ្ឋាភិបាល និង លាប ពណ៌ អង្គការ និង គ្រប់ មជ្ឈដ្ឋាន គាំទ្រ រដ្ឋាភិបាល ឱ្យ មើលឃើញ ខ្មៅ ងងឹត និង ជា សត្រូវ រហូតមក ។
ដោយ ចៅ ចាក់ ស្មុក រាជធានី ភ្នំពេញ . ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ សម្តេច ម៉ែន សំអន៖ រួមគ្នា ថែរក្សា សន្តិភាព ដើម្បី ជំរុញ ការអភិវឌ្ឍ ប្រទេសជាតិ សូម ពលរដ្ឋ បន្ត បោះឆ្នោត ជូន គណបក្ស ប្រជាជន ឱ្យ បាន គ្រប់ ៗ គ្នា នៅ ថ្ងៃទី ២៣ ខែកក្កដា ខាងមុខ
( ព្រៃវែង ) ៖ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ រួមគ្នា ថែរក្សា សន្តិភាព ដើម្បី ជំរុញ ការអភិវឌ្ឍ របស់ ប្រទេសជាតិ ដូចនេះ សូម ប្រជាពលរដ្ឋ អញ្ជើញ ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ជាពិសេស បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ព្រោះ មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ទេ ដែល តែងតែ រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន និង មិន ដែល រត់ ចោល ប្រជាជន ម្តង ណា ឡើយ ។
ការថ្លែង បែប នេះ របស់ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បញ្ចុះ ឧបដ្ឋាន សាលា និង សមិទ្ធិផល នានា នៅក្នុង វត្ត កំពង់សិសា ស្ថិត នៅ ឃុំ រំចេក ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង នា ព្រឹក ថ្ងៃអាទិត្យ ៩កើត ខែ ជេស្ឋ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស . ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ ។
សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា រួមគ្នា ថែរក្សា សុខ សន្តិភាព ថែរក្សា នូវ សមិទ្ធិផល ដែល សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ នៅក្នុង វត្ត កំពង់សិលា ឱ្យ បាន គង់វង្ស យូរអង្វែង ។
សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន លើកឡើង ថា សមិទ្ធផល នៅក្នុង វត្ត កំពង់ សាលា នេះ ចំណាយ ថវិកា សាងសង់ អស់ ៩៤ ម៉ឺន ដុល្លារ ក្រោម ទឹកចិត្ត សទ្ធា ដ៏ ជ្រះថ្លា របស់ ព្រះគ្រូ សោភ័ណ មុនី ឃឿន រ៉ាន ចៅអធិការ វត្ត កំពង់ សាលា ឧកញ៉ា អ៊ុល ចំណាន និង លោកជំទាវ ម៉ៅ ថា រី ឧកញ៉ា លោក លោកស្រី និង ពុទ្ធ បរិស័ទ្ធ ជិត ឆ្ងាយ ទើប កើត នូវ សមិទ្ធផល ព្រះពុទ្ធ សាសនា ថ្មី មួយ ក្នុង ចំណោម សមិទ្ធផល ជាច្រើន ក្នុង ខេត្ត ព្រៃវែង ។
សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន គូសបញ្ជាក់ ថា ក្រោម ការដឹកនាំ ប្រកបដោយ កិត្តិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ដឹកនាំ ប្រទេស ឆ្ពោះ ទៅរក ការអភិវឌ្ឍ សុខ សន្ដិភាព ស្ថិរភាព នយោបាយ និង ភាពរុងរឿង មាន មោទនភាព ជាតិ និង កិត្យានុភាព ទាំង ក្នុង តំបន់ និង អន្ដរជាតិ ។
សមិទ្ធផល ជាច្រើន បាន កសាង នៅក្នុង ប្រទេស កម្ពុជា គឺ កើតឡើង ចាប់តាំងពី ក្រោយ ថ្ងៃ រំដោះ ៧ មក រា ១៩៧៩ ដែល ជា ថ្ងៃ កំណើត ទី២ របស់ យើង ទាំងអស់ គ្នា បាន ន័យ ថា បើ គ្មាន ថ្ងៃ ៧មករា ទេ យើង គ្មាន ថ្ងៃ នេះ ហើយក៏ មិន អាច មក ចួប ជុំគ្នា ធ្វើ បុណ្យ ទាន នា ថ្ងៃ នេះ ដែរ ។ ការរស់ ឡើងវិញ នេះ គឺ ប្រាកដ ណាស់ ដោយ តែ គុណ បំណាច់ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន លះបង់ អាយុជីវិត ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាពលរដ្ឋ ៕
សហគ្រិន ខ្មែរ និង អង្គការ ស្វីស ខន់ ថាក់ ប្រជុំគ្នា ដើម្បី ពង្រឹង ប្រព័ន្ធ អេកូឡូស៊ី សហគ្រិន ភាព និង ការវិនិយោគ (3Ei) ឆ្ពោះ ទៅកាន់ ការីកចម្រើន សេដ្ឋកិច្ច កម្ពុជា
( ភំ្ន ពេញ ) ៖ កម្មវិធី 3Ei នេះ ធ្វើឡើង ដោយ សហគ្រិន ខ្មែរ និង អង្គការ ស្វីស ខន់ ថាក់ ក្នុង គោលបំណង កៀរគរ ធនធាន វិនិយោគ ដែល ចូលរួម ក្នុង ការអភិវឌ្ឍ សង្គម តាមរយៈ ការគាំទ្រ អាជីវកម្ម ធុន តូច និង មធ្យម (SME) ឲ្យ មាន លទ្ធភាព ទទួលបាន ការគាំទ្រ ទាំង ផ្នែក ហិរញ្ញវត្ថុ និង មិន មែន ហិរញ្ញវត្ថុ ដែល នាំឲ្យ អាជីវកម្ម មាន ភាពលូតលាស់ និង បង្កើន ផល វិជ្ជមាន ដល់ សង្គម និង បរិស្ថាន ។
ជំនួប នេះ ធ្វើឡើង នៅ ចុង សប្ដាហ៍ នេះ ក៏ មាន គោលដៅ ពង្រឹង និង បង្កើន កិច្ចសហប្រតិបត្តិការ រវាង ដៃគូរ ពាក់ព័ន្ធ នៅក្នុង ប្រព័ន្ធ អេកូឡូស៊ី សហគ្រិន ភាព ។
( បាត់ដំបង ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ព្រៃវែង និង បាត់ដំបង នា ព្រឹក ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតី ពិធី សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ មន្រ្តី កិច្ចសន្យា កងកម្លាំងប្រដាប់អាវុធ និវត្ត ជន និង យោធិន ក្នុង ស្រុក មោង ឫស្សី ខេត្ត បាត់ដំបង ។
សម្តេច ក្រឡាហោម ស ខេង បាន បញ្ជាក់ អំពី គុណ បំណាច់ នៃ ការរួមចំណែក ដ៏ ធំធេង របស់ និវត្ត ជន និង យោធិន ទាំងអស់ ក្នុង ស្រុក មោង ឫស្សី ដែល បាន តស៊ូ ធ្វើ ពលិកម្ម យ៉ាង លំបាក លំបិន ដើម្បី បុព្វហេតុ សន្តិភាព ការបង្រួបង្រួម និង អភិវឌ្ឍន៍ ជាតិ លើ គ្រប់ វិស័យ ។
សម្ដេច ក្រឡាហោម ស ខេង បាន បន្ត ថា ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ ជំនាន់ ក្រោយ បាន ចងចាំ និង កត់ត្រា ទុក ជា ប្រវត្តិសាស្រ្ត នូវ ការចូលរួមចំណែក របស់ អតីត ថ្នាក់ដឹកនាំ អតីត មន្រ្តី រាជការ និង អតីត កងកម្លាំងប្រដាប់ វុធ ទាំងអស់ ព្រមទាំង ប្ដេជ្ញា បន្ត ពូន ជ្រំ ការអភិវឌ្ឍ ជាតិ ឱ្យ កាន់តែ រីកចម្រើន សម្រាប់ អ្នកជំនាន់ ក្រោយ ៗ ទៀត ។
សម្ដេច ក្រឡាហោម ស ខេង ក៏ បាន ផ្ដល់ ទស្សនទាន អំពី សភាពការណ៍ សាកល ដែល កំពុង មាន ការប្រឈម នឹង បញ្ហា ស្មុគស្មាញ ដូចជា ជំងឺ ឆ្លង កូវីដ១៩ ដែល នៅតែ មិន ទាន់ បញ្ចប់ ការប្រកួតប្រជែង ភូមិសាស្រ្ត នយោបាយ វិបត្តិ សង្គ្រាម រុស្សី និង អ៊ុយក្រែន ការប្រែប្រួល អាកាសធាតុ កាន់តែ អាក្រក់ និង បទល្មើស មិន ប្រពៃណី ជា អន្តរជាតិ ផ្សេង ៗ ទៀត ។ សម្រាប់ កម្ពុជា សម្ដេច ក្រឡាហោម ក៏ បាន បន្ថែម ថា ទន្ទឹមនឹង ការប្រឈម បញ្ហា សាកល នេះ ក្រុម ប្រឆាំង ជ្រុលនិយម ក៏ នៅតែ មិន បោះបង់ ផែនការបំផ្លាញ សុខ សន្តិភាព និង ស្ថេរភាព សង្គម នោះ ដែរ ។
ភ្ជាប់ នឹង ការប្រឈម ដូច បាន បញ្ជាក់ មក នេះ សម្ដេច ក្រឡាហោម បាន ទាញ ចំណាប់ អង្គ ពិធី ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ គោល នយោបាយ និង យុទ្ធសាស្រ្ត ដឹកនាំ ប្រកបដោយ ភាពត្រឹមត្រូវ និង ត្រូវបាន ចូលរួម គាំទ្រ យ៉ាង សម្ម ពី មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ និង អាជ្ញាធរ គ្រប់ ថ្នាក់ រួមទាំង ខេត្ត បាត់ដំបង ធ្វើឱ្យ ប្រទេសជាតិ បន្ត រក្សា បាន សុខ សន្តិភាព ស្ថេរភាព នយោបាយ ធានា ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ។
សម្ដេចក៏ បាន គូសបញ្ជាក់ បន្ថែម អំពី ទិសដៅ របស់ រាជ រដ្ឋាភិបាល សម្រាប់ ឆ្នាំ ២០២៣ និង រយៈពេល ៥ឆ្នាំ បន្ត ទៀត ក្នុង ក្របខណ្ឌ រាជ រដ្ឋាភិបាល នៃ គណបក្ស ប្រជាជន កម្ពុជា ។
ក្នុង ចំណោម ទិសដៅ ការងារ សំខាន់ ៗ សម្ដេច ក្រឡាហោម បាន សង្កត់ធ្ងន់ ជាថ្មី ទៀត អំពី សារៈសំខាន់ នៃ ការរក្សា សុខ សន្តិភាព ដែល ជា មូលដ្ឋានគ្រឹះ នៃ ការអភិវឌ្ឍ គ្រប់ វិស័យ ព្រមទាំង ការរៀបចំ ការបោះឆ្នោត តាម គន្លង ប្រជាធិបតេយ្យ ជា ទៀងទាត់ និង ត្រឹមត្រូវ ក្នុង នោះ រួមទាំង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ដែល សម្ដេច អះអាង គ្រប់ តួអង្គ ត្រូវតែ បន្ត រួមគ្នា ធ្វើឱ្យ ការបោះឆ្នោត នេះ ប្រព្រឹត្តទៅ ដោយ ជោគជ័យ ។
ចុងបញ្ចប់ ពិធី សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ មន្រ្តី កិច្ចសន្យា កងកម្លាំងប្រដាប់អាវុធ និវត្ត ជន និង យោធិន ក្នុង ស្រុក មោង ឫស្សី នោះ ដែរ សម្ដេច ក្រឡាហោម ស ខេង ក៏ បាន អញ្ជើញ បំពាក់ មេដាយ ជូន អតីត មន្រ្តី រាជការ អតីត កងកម្លាំងប្រដាប់អាវុធ ដែល មាន ស្នាដៃ ឆ្នើម ក្នុង ការចូលរួមចំណែក បម្រើ បុព្វហេតុ ជាតិ និង ប្រជាជន និង មន្រ្តី មាន ស្នាដៃ ខិតខំ បំពេញ ភារកិច្ច បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ព្រមទាំង ប្រគល់ ជូន ថវិកា ដល់ អង្គ ពិធី ទាំងមូល ផងដែរ ៕
អង្គការ ធ្វើការ ផ្នែក កសិកម្ម ចង់ឱ្យ ពលរដ្ឋ ជួយ គាំទ្រ ដល់ ប្រជាកសិករ ដាំ បន្លែ សរីរាង្គ ដើម្បី លើកកម្ពស់ សុខុមាលភាព និង ជីវភាព
( សៀមរាប ) ៖ អង្គការ ហ្គ្រេត (GRET) បាន រៀបចំ ដំណើរទស្សនកិច្ច របស់ សិស្សសាលា បាយ និង អតិថិជន គាំទ្រ បន្លែ សរីរាង្គ នៅ ផ្សារ កសិករ សៀមរាប ផ្សារ ចុង សប្តាហ៍ និង នៅ សហគមន៍ កសិកម្ម ដាន រុន សាមគ្គី ក្នុង ភូមិ សន្ទៃ ឃុំ ដាន រុន និង សហគមន៍ កសិកម្ម សុវត្តភាព ធម្មជាតិ ក្នុង ភូមិ ជ្រៃ ខាងជើង ឃុំ កៀន សង្កែ ស្រុក សូទ្រនិគម ខេត្ត សៀមរាប នា ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ ។
នា ឱកាស នោះ ដែរ លោក តាន់ តុលា បុគ្គលិក ផ្នែក ទីផ្សារ នៃ អង្គការ ហ្គ្រេត (GRET) បាន ឱ្យដឹង ថា ដំណើរទស្សនកិច្ច នេះ ក្នុង គោលបំណង លើកកម្ពស់ ការយល់ដឹង របស់ ឱ្យ ប្រើប្រាស់ នូវ បន្លែ សុវត្ថិភាព ដើម្បីឱ្យ គាត់ បាន ឃើញ ថា ផលិតផល ដែល ដាក់ លក់ នៅ ផ្សារ ចុង សប្តាហ៍ និង ផ្សារ កសិករ សៀមរាប គឺជា ផលិតផស ធម្មជាតិ ដែល នាំចេញ ពី សហគមន៍ ទាំងអស់ ។
លោក បាន បន្ត ថា ជាទូទៅ អង្គការ តែងតែ ផ្សព្វផ្សាយ ដល់ ពលរដ្ឋ ដើម្បីឱ្យ គាត់ ប្រើប្រាស់ បន្លែ សុវត្ថិភាព ដែល ជា ផលិតផល ដែល គ្មាន ជាតិ គីមី ។ ហើយ អង្គការ ក៏ កំពុង ពង្រីក ទៅ សហគមន៍ ដើម្បី យក ប្រពន្ធ ធានា សុវត្ថភាព ដល់ ពួកគាត់ ដើម្បីឱ្យ គាត់ យក បន្លែ ទៅ លក់ នៅក្នុង ទីផ្សារ ។
មន្ត្រី អង្គការ រូប នេះ បាន ឱ្យដឹង ថា សព្វ ថ្ងៃ នេះ កំណើន នៃ ការប្រើប្រាស់ បន្លែ សរីរាង្គ មាន ការកើនឡើង ឱ្យ កត់សម្គាល់ នេះ បើ យោង តាម របាយការណ៍ ពី ចុង សប្តាហ៍ ពីមុន គាត់ លក់ បាន ក្រោម កន្លះ តោន ក្នុង មួយ ខែ តែ អី ឡូវនេះ ឡើង រហូតដល់ ជិត ១តោន ក្នុង មួយ ខែ ក្រោយពី ការផ្សព្វផ្សាយ ឥរិយាបទ នៃ ការបរិភោគ របស់ គាត់ មាន ការកែប្រែ ច្រើន ដោយ គាត់ គិត ពី សុខភាព របស់ គាត់ ច្រើន ជាង ហើយ បើ ធៀប ពី តំលៃ បន្លែ សរីរាង្គ និង បន្លែ ដែល នាំចូល គឺ មិន ខុសគ្នា នោះ ដែរ ។
អ្នកស្រី បាន បន្ត ថា សហគមន៍ កសិកម្ម សុវត្ថិភាព ធម្មជាតិ ហៅ កាត់ ថា (Eco-farm) ក៏ បាន សិក្សា ស្វែងយល់ ពី បន្លែ សុវត្ថិភាព និង ការអនុវត្ត ការដាំដុះ តាម បែប ស្តង់ដារ សុវត្ថិភាព ក្រោម ការត្រួតពិនិត្យ ស្តង់ដា ដោយ ប្រព័ន្ធ ធានា ដែល ហៅ កាត់ ថា (PGS) និង ស្វែងរក ការគាំទ្រ ផ្នែក ទីផ្សារ ដល់ សហគមន៍ ក៏ ដូចជា ស្វែងរក ការគាំទ្រ ដល់ ផលិតផល កសិកម្ម របស់ ប្រជាកសិករ ក្នុង សហគមន៍ ផងដែរ ។
ជាមួយ នេះ ដែរ អ្នកស្រី សុខ សុផាណា អតិថិជន គាំទ្រ បន្លែ សរីរាង្គ បាន លើកឡើង ថា ដោយ គិតគូរ ពី សុខភាព អ្នកស្រី បាន ហូប បន្លែ សរីរាង្គ នេះ តាំងពី យូរ មកហើយ ហើយ បន្ទាប់ ហូប បន្លែ សរីរាង្គ និង ហាត់ប្រាណ ជាប្រចាំ នៅពេល ទៅ ពិនិត្យ សុខភាព គឺ មិន មាន បញ្ហា លើស ឈាម និង ទឹកនោម ផ្អែម នោះ ឡើយ ។
ដោយឡែក យុវជន ដូច ទោម៉ម ដែល ជា សិស្ស រៀន នៅ សាលា បាយ ខាង ផ្នែក ចុង ភៅ បាន លើកឡើង ថា បច្ចុប្បន្ន នេះ មាន ប្រជាកសិករ ជាច្រើន បាន ងាក មក ដាំ បន្លែ សរីរាង្គ ដែល ធ្វើឱ្យ រូប គេ មាន ទំនុកចិត្ត ខ្ពស់ នៅពេល ធ្វើ ម្ហូប ជូន ភ្ញៀវ និង កំពុង មាន ការគាំទ្រ ជាច្រើន ពី អតិថិជន ព្រមទាំង ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ផងដែរ ៕ ក្រុមការងារ CPP ចុះ មូលដ្ឋាន ក្រុង ក្រចេះ ជួប សំណេះសំណាល ជាមួយ យុវជន គណបក្ស ក្រុង និង សង្កាត់ ជាង ៤០០ នាក់
( ក្រចេះ ) ៖ លោក វ៉ា ថន សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន គណបក្ស ខេត្ត ក្រចេះ និង លោក ឈឿន ប៊ុណ្ណា រ័ត្ន សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង ក្រចេះ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ក្រុង សង្កាត់ ក្នុង ក្រុង ក្រចេះ ។
ក្នុង នោះ ក៏ មាន ការចូលរួម ពី លោក លោកស្រី អនុប្រធាន ក្រុមការងារ គណបក្ស គ្រប់ លំដាប់ថ្នាក់ចុះ មូលដ្ឋាន ក្រុង ក្រចេះ គណៈកម្មាធិការ គណបក្ស ក្រុង គណៈកម្មាធិការ គណបក្ស សង្កាត់ ដែល មាន សមាសភាព ចូលរួម សរុប ចំនួន ៤៣២ នាក់ ។
ផ្អែក តាម ការប្ដេជ្ញាចិត្ត ខាងលើ និង យោង តាម ការបោះឆ្នោត កន្លងមក ក្រុមការងារ យុវជន គណបក្ស ក្រុង សង្កាត់ និង ក្រិម សកម្មជន យុវជន ចំណុះ ទាំងអស់ ដែល ជា ជំនួយការ ឱ្យ គណបក្ស គ្រប់ ថ្នាក់ លើ ការងារ បំផុស យុវជន ឱ្យ គាំទ្រ បុព្វហេតុ ដ៏ ត្រឹមត្រូវ របស់ គណបក្ស និង បោះឆ្នោត ជូន គណបក្ស ។
ក្នុង ឱកាស សំណេះសំណាល លោក វ៉ា ថន បាន សូម អរគុណ ចំពោះ ក្រុមការងារ យុវជន គ្រប់ ជាន់ ថ្នាក់ នៅ ក្រុង ក្រចេះ ទាំង បណ្ដា ផ្នែក ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន ចូលរួម នៅ ថ្ងៃ នេះ លើកទឹកចិត្ត ជានិច្ច ដល់ យុវជន ក្នុង ការខិតខំ បំពេញ ការងារ និង បម្រើ ប្រជាជន នៅ តាម មូលដ្ឋាន បាន យ៉ាង ល្អ ប្រសើរ នា ពេល កន្លងមក ហើយ ត្រូវ ខិតខំ បម្រើ ប្រជាជន បន្ត ទៅ ទៀត ។
លោក បាន គូសបញ្ជាក់ ថា រាល់ សកម្មភាព បក្ស ទាំងអស់ គឺ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ស្មារតី ដើម្បី ផលប្រយោជន៍ គណបក្ស និង ប្រជាជន ដើម្បី កសាង កម្លាំង ឱ្យ កាន់តែ មុតមាំ ក្នុង ការប្រជែង យក ជ័យជម្នះ ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ដែល នឹង ឈាន មកដល់ នា ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ឱ្យ ទទួលបាន ជោគជ័យ ។ សូម លោក បងប្អូន ដែល ជា សមាជិក សមាជិកា គណបក្ស ប្រជាជន ទាំងអស់ ពិសេស ប្រធាន ក្រុម សាខា បក្ស នៅ តាម មូលដ្ឋាន ជួយ ប្រមូល គ្នា ទៅ ចូលរួម បោះឆ្នោត ទាំងអស់ គ្នា ។
សូម បញ្ជាក់ ក្នុង ពិធី សំណេះណាល នោះ លោក វ៉ា ថន និង លោក ឈឿន ប៊ុន រ័ត្ន ព្រមទាំង ក្រុមការងារ គណបក្ស ក្រុង ក្រុមការងារ ចុះ ជួយ មូល ក្រុង បាន រួមគ្នា ផ្ដល់ ថវិកា ដល់ យុវជន គណបក្ស ក្រុង សង្កាត់ ចំនួន ៤៣២ នាក់ ក្នុង ១នាក់ ចំនួន ២០.០០០ រៀល ផងដែរ ៕
លោក វង្ស ពិសេន៖ « កិច្ចប្រជុំ កំពូល អាស៊ាន ព្រឹត្តិការណ៍ កីឡា ស៊ីហ្គេម លើក ទី ៣២ និង ប៉ារ៉ាហ្គេម លើក ទី ១២ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ បាន បង្ហាញ ពី កិត្យានុភាព កម្ពុជា ឱ្យ កាន់តែ រះ ត្រដែត នៅលើ ឆាក អន្តរជាតិ »
( ព្រៃវែង ) ៖ លោក វង្ស ពិសេន សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក ពារាំង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ចុះ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា បក្ស នៅក្នុង ឃុំ រាប ស្រុក ពារាំង ខេត្ត ព្រៃវែង ។
ក្នុង ឱកាស នោះ លោក វង្ស ពិសេន បាន អរគុណ ដល់ សមាជិក សមាជិកា របស់ បក្ស ទាំងអស់ ដែល បាន បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ឱ្យ ឈ្នះ លើសលុប នា ឆ្នាំ ២០២២ ។
ជា ទីបញ្ចប់ លោក វង្ស ពិសេន បាន អំពាវនាវ ឱ្យ សមាជិក សមាជិកា របស់ គណបក្ស ប្រជាជន ទាំងអស់ អញ្ជើញ ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ។ មាន តែ គណបក្ស ប្រជាជន ទេ ដែល អាច ការពារ បាន នូវ សន្តិភាព មាន សន្តិភាព ក៏ដោយសារ គណបក្ស ប្រជាជន មាន គណបក្ស ប្រជាជន ទើប មាន សន្តិភាព ៕
បើ តាម អាជ្ញាធរ គ្រប់គ្រង គ្រោះមហន្តរាយ នៃ ប្រទេស ប៉ាគីស្ថាន មនុស្ស ១៣នាក់ ផ្សេង ទៀត ក៏ បាន រងរបួស ផងដែរ បន្ទាប់ ការបាក់ ផ្ទាំង ទឹកកក វាយប្រហារ លើ ក្រុមគ្រួសារ មួយ នៅ តំបន់ ភ្នំ Shounter Pass កាលពី ថ្ងៃសុក្រ កន្លងទៅ នេះ ។ សាកសព ជនរងគ្រោះ ទាំងអស់ ត្រូវបាន អាជ្ញាធរ រកឃើញ ខណៈ អ្នក រងរបួស ក្នុង នោះ មាន ទាំង កុមារ ម្នាក់ ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ក្នុង តំបន់ ។
គួរ បញ្ជាក់ ថា នាយក រដ្ឋមន្ត្រី ប៉ាគីស្ថាន ក៏ បាន សម្ដែង មរណទុក្ខ ដល់ អ្នក ដែល បាន បាត់បង់ជីវិត ផងដែរ ហើយ ថា ការកើនឡើង នៃ គ្រោះថ្នាក់ បាក់ ផ្ទាំង ទឹកកក បែប នេះ គឺ ដោយសារតែ ការប្រែប្រួល អាកាសធាតុ ៕
ឯកឧត្តម គួច ចំរើន និង លោកជំទាវ ផ្ញើ សារ អបអរសាទរ ឧកញ៉ា ទៀ វិចិត្រ ដែល ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ ផ្តល់ គោរម ងា ជា « អ្នក ឧកញ៉ា »
( ខេត្ត ព្រះសីហនុ) ៖ ឯកឧត្តម គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ និង លោកជំទាវ សូម សម្តែង ការអបអរសាទរ យ៉ាង ស្មោះ អស់ ពី ដួងចិត្ត ជូន ចំពោះ ឧកញ៉ា ទៀ វិចិត្រ ដែល ត្រូវបាន ព្រះករុណ ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រាស់បង្គាប់ ផ្ដល់ គោរមងារ ជា « អ្នក ឧកញ៉ា » ។
ការ ព្រះរាជ ទាន ផ្តល់ គោរមងារ ជា « អ្នក ឧកញ៉ា » ដល់ ឧកញ៉ា ទៀ វិចិត្រ ជា សក្ខីភាព ឆ្លុះបង្ហាញ អំពី កិច្ច ខិតខំ ប្រឹងប្រែង ទាំង កម្លាំង កាយ និង ចិត្ត ដោយ មិន ខ្លាច នឿយហត់ របស់ អ្នក ឧកញ៉ា ក្នុង បុព្វហេតុ ដើម្បី ជួយ សង្គមជាតិ ការចូលរួមចំណែក ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ប្រទេសជាតិ ជា ទី ស្នេហា នៃ យើង ឱ្យ កាន់តែ រីកចម្រើន ។ ទន្ទឹមនឹង នេះ ការប្រទាន គោរមងារ នេះ ពិតជា ស័ក្តិសម និង ផ្ដល់ កិត្តិយស ដ៏ ឧត្តុង្គឧត្តម សម្រាប់ អ្នក ឧកញ៉ា និង ក្រុមគ្រួសារ ។
ឆ្លៀត នៅក្នុង ឱកាស ដ៏ វិសេសវិសាល នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម បួងសួង ដល់ វត្ថុ ស័ក្ដិសិទ្ធិ ក្នុង លោក សូម ជួយ តាម ថែរក្សា និង ប្រោះ ព្រំ ប្រសិទ្ធ ពរ ជ័យ ជូន ចំពោះ អ្នក ឧកញ៉ា និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ ជា ទីស្រឡាញ់ ឱ្យ សូម ជួបប្រទះ នូវ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ ជានិច្ច និរន្តរ៍ ៕ ការបោះឆ្នោត ប្រធានាធិបតី តួកគី ជុំ ទី២ ចាប់ផ្ដើម ហើយ
ការិយាល័យ បោះឆ្នោត បាន បើក ទ្វារ នៅ ម៉ោង ៨៖០០ នាទី ព្រឹក ហើយ នឹង ត្រូវ បិទ ទ្វារ នៅ ម៉ោង ៥៖០០ នាទី ល្ងាច ថ្ងៃអាទិត្យ នេះ ។ ការបោះឆ្នោត ជុំ ទី២នេះ ត្រូវ ធ្វើឡើង បន្ទាប់ពី គ្មាន បេក្ខជន ប្រធានាធិបតី តួកគី ណាមួយ ម្នាក់ អាច រក បាន សំឡេង គាំទ្រ លើ ស ៥០ ភាគ នៅក្នុង ការបោះឆ្នោត កាលពី ថ្ងៃទី ១៤ ខែឧសភា កន្លងទៅ នេះ ។
គួរ បញ្ជាក់ ថា នៅក្នុង ការបោះឆ្នោត ជុំទី១ លោក អឺ ដូហ្កាន់ ទទួលបាន សំឡេង គាំទ្រ ៤៩. ៣៩ ភាគរយ ខណៈ លោក ខេម៉ាល់ ខីលី គដារ៉ូគ្លូ ទទួលបាន សំឡេង គាំទ្រ ៤៤. ៩២ ភាគរយ ។ លោក អឺ ដូហ្កាន់ និង គូ ប្រជែង របស់ លោក បាន ប្រកាស រៀង ៗ ខ្លួន ថា បាន ត្រៀម ខ្លួន ជាស្រេច និង ប្ដេជ្ញា យក ជ័យជម្នះ ឱ្យ បាន ក្នុង ការបោះឆ្នោត ជុំ ទី២៕
ព្រឹក ស្អែក គ.ជ. ប នឹង ចាប់ ឆ្នោត ដើម្បី កំណត់ លំដាប់ លេខរៀង ឈ្មោះ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត លើ សន្លឹក ឆ្នោត
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែឧសភា ឆ្នាំ ២០២៣ ស្អែក នេះ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នឹង ចាប់ ឆ្នោត ដើម្បី កំណត់ លំដាប់ លេខរៀង ឈ្មោះ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត លើ សន្លឹក ឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ។
សម្រាប់ ការចាប់ សន្លឹក ឆ្នោត នឹង ធ្វើឡើង ក្រោម ព្រះវត្តមាន សម្តេច សង្ឃរាជ ទាំង ពីរ គណៈ ។
( ភ្នំពេញ ) ៖ សាកលវិទ្យាល័យ ជនជាតិ តំបន់ ពាយព្យ នៃ ចិន សមាគម សម្ព័ន្ធ ខ្មែរ ចិន នៅ កម្ពុជា ដែល គាំទ្រ ដោយ ស្ថានទូត ចិន ប្រចាំ កម្ពុជា . គណៈកម្មាធិការ កិច្ចការ ជនជាតិ នៃ ប្រទេស ចិន និង ក្រសួង វប្បធម៌ និង សិល្បៈ នៃ ប្រទេស កម្ពុជា នៅ ថ្ងៃទី ២៧ ខែឧសភា បាន រៀបចំ កម្មវិធី សម្ដែង សិល្បៈ « ភាពសម្បូរបែប នៃ ចិន សម្រាប់ ឆ្នាំ មិត្តភាព ចិន - កម្ពុជា » ឆ្នាំ ២០២៣ នៅ សាល មហោស្រព ចេនឡា រាជធានី ភ្នំពេញ ដើម្បី អបអរសាទរ ខួប អនុវស្សា វរីយ៍ លើក ទី ៦៥ នៃ ការបង្កើត ទំនាក់ទំនង កាទូត រវាង ចិន និង កម្ពុជា ។
កម្មវិធី សម្តែង ខាងលើ នេះ បាន បង្ហាញ ពី វប្បធម៌ និង ការរស់នៅ របស់ បងប្អូន ជនជាតិ ភាគ តិច នៅ ចិន ដោយ តាមរយៈ របាំ និង ចម្រៀង ហើយក៏ មាន ការអញ្ជើញ សិល្បករ សិល្បការិនី មកពី សាកលវិទ្យាល័យ ភូមិន្ទ វិចិត្រ សិល្បៈ និង សាលា មធ្យម វិចិត្រ សិល្បៈ ដោយ បាន ពាំនាំ នូវ ការសម្តែង របាំ ប្រពៃណី និង សៀក ។
លោក ឯក ស៊ី ដេ ដែល ជា តារាចម្រៀង មាន កេរ្តិ៍ឈ្មោះ ក្នុង ប្រទេស កម្ពុជា និង លោកស្រី Cao Xi នៃ សាកលវិទ្យាល័យ ជនជាតិ តំបន់ ពាយព្យ នៃ ចិន បាន រួមគ្នា បកស្រាយ បទចម្រៀង ដែល មាន ចំណងជើង ថា « ពាក្យ សច្ចា ពណ៌ មាស » សម្រាប់ អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៦៥ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត រវាង ចិន និង កម្ពុជា ក៏ ទទួលបាន ការពេញចិត្ត និង សាទ រ យ៉ាង ខ្លាំង ពី អង្គ ពិធី ។
លោកស្រី បណ្ឌិត សភាចារ្យ ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន សម្តែង ការស្វាគមន៍ ចំពោះ គណៈប្រតិភូ នៃ សាកលវិទ្យាល័យ ជនជាតិ តំបន់ ពាយព្យ នៃ ចិន ដែល បាន មក ទស្សនកិច្ច និង សម្តែង សិល្បៈ នៅលើ ទឹកដី ប្រទេស កម្ពុជា ដែល ជា ការសម្តែង លើក ដំបូង របស់ ក្រុម សីល្បៈ ករ ចិន ចាប់ពី មាន ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
លោកស្រី បន្ត ថា កម្ពុជា និង ចិន គឺជា ប្រទេស ដែល មាន ទំនាក់ទំនង ល្អ ជា គ្នា តាំងពី យូរ ណាស់ មកហើយ មិន មែន ត្រឹមតែ ៦៥ ឆ្នាំ នេះ នោះ ទេ ។
សូម ជម្រាប ថា « ភាពសម្បូរបែប នៃ ចិន » គឺជា ក្រុម សិល្បៈ ដែល បាន រួមបញ្ចូល គ្នា រវាង របាំ ជនជាតិ ភាគ តិច និង តន្ត្រី ដើម្បី បង្ហាញ យ៉ាង ទូលំទូលាយ ពី វប្បធម៌ សម្លៀកបំពាក់ ជនជាតិ ដ៏ ច្រើន បែប និង ចម្រុះ ពណ៌ នៅក្នុង ប្រទេស ចិន ។ ក្នុង រយៈពេល ២៥ ឆ្នាំ កន្លងមក នេះ ក្រុម សម្ដែង ខាងលើ បាន ធ្វើដំណើរ ទៅកាន់ ជាង ៤០ ប្រទេស និង តំបន់ នៅ ជុំវិញ ពិភពលោក បាន ទាក់ទាញ ទស្សនិកជន ជាង មួយ លាន នាក់ ៕ លោក ណុប រ័ត្ន និមល៖ គណបក្ស ប្រជាជន កម្ពុជា ជា ស្នូល នៃ ការបង្រួបបង្រួម ជាតិ ឯកភាព ជាតិ
( កណ្តាល ) ៖ លោក ណុប រ័ត្ន និមល ប្រធាន គណអចិន្រ្តៃយ៍ ក្រុមការងារ យុវជន គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កណ្ដាល ស្ទឹង តំណាង លោក កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង ប្រធាន ក្រុមការងារ គណបក្ស គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្ដាល បាន ថ្លែង ថា គណបក្ស ប្រជាជន កម្ពុជា ជា ស្នូល នៃ ការបង្រួបបង្រួម ជាតិ ឯកភាព ជាតិ ឯកភាព ទឹកដី សាមគ្គីភាព រវាង ខ្មែរ និង ខ្មែរ មិន យក ខ្មែរ ធ្វើជា សត្រូវ នាំមក នូវ សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ រហូត មាន អ្វី ៗ គ្រប់ បែបយ៉ាង មកដល់ សព្វ ថ្ងៃ នេះ ។
ការថ្លែង បែប នេះ របស់ លោក ណុប រ័ត្ន និមល បាន ធ្វើឡើង នៅក្នុង ពិធី សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា ថ្មី ចំនួន ២. ៥៣០នាក់ នៅក្នុង ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្ដាល ដែល ត្រូវបាន បញ្ចូល ជា សមាជិក គណបក្ស ប្រជាជន កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ។
នៅ ចំពោះមុខ សមាជិក ថ្មី លោក បាន លើកឡើង ពី ប្រវត្តិ ការ តស៊ូ ពលីកម្ម ជាច្រើន ដំណាក់កាល របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ បាន តស៊ូ ឆ្លងកាត់ គ្រប់ ឧបសគ្គ យក ជីវិត ធ្វើជា ដើមទុន ដើម្បី រំដោះ ប្រទេសជាតិ និង ប្រជាជន កម្ពុជា ទាំងមូល ចេញ ពី ភ្លើង សង្រ្គាម របប ប្រល័យ ពូសាសន៍ ប៉ុល ពត ដឹកនាំ ប្រទេស ឈាន ទៅរក សុខ សន្តិភាព ពេញលេញ ស្ថិរភាព នយោបាយ និង ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ដូច សព្វ ថ្ងៃ នេះ ។
បន្ថែម ពី នេះ លោក ណុប រ័ត្ន និមល បាន សម្ដែង នូវ ការស្វាគមន៍ ចំពោះ សមាជិក សមាជិកា ថ្មី ដែល បាន សម្រេចចិត្ត យ៉ាង ត្រឹមត្រូវ មក ចូលរួម ក្នុង ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា និង បាន ជឿជាក់ ផ្ដល់ យុត្តិធម៌ ដល់ ការដឹកនាំ ដ៏ ត្រឹមត្រូវ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក បាន លើកឡើង ថា នៅ គ្រប់ កាលៈទេសៈ មេដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា តែងតែ ជំរុញ ឱ្យ ក្រុមការងារ ចុះ តាម មូលដ្ឋាន ត្រូវ ចុះ ពិនិត្យមើល ពី សុខ ទុក្ខ និង ជីវភាព ប្រជាពលរដ្ឋ ជាប្រចាំ នៅ តាម មូលដ្ឋាន ដើម្បី ដោះស្រាយ រាល់ បញ្ហា ប្រឈម និង ការលំបាក របស់ ប្រជាពលរដ្ឋ ឱ្យ បាន ទាន់ ពេលវេលា មិន ទុកចោល ឱ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ អត់ អាហារ ដោយ មិន បាន ទទួល ព័ត៌មាន នោះ ទេ ។
លោក ណុប រ័ត្ន និមល បាន អំពាវនាវ សមាជិក សមាជិក បក្ស អញ្ជើញ ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី៧ ជូន គណបក្ស ប្រជាជន កម្ពុជា ឱ្យ បាន គ្រប់ ៗ គ្នា នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ និង បន្ត ការគាំទ្រ សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី និង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខជន នាយក រដ្ឋមន្រ្តី នា ពេល អនាគត ដើម្បី ការពារ ថែរក្សា សុខ សន្តិភាព និង បន្ត ការអភិវឌ្ឍ ប្រទេស ឱ្យ បាន រីកចម្រើន ជា និរន្ត ។
ក្នុង ឱកាស នោះ ដែរ លោក ណុប រ័ត្ន និមល បាន ឧបត្ថម្ភ ថវិការ មួយចំនួន ជូន ដល់ សមាជិក សមាជិក ថ្មី អាជ្ញាធរ កម្លាំងប្រដាប់អាវុធ ក្រុមប្រឹក្សា ឃុំ ស្រុក ក្រុម យុវជន ផងដែរ ៕
ប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ រកា ធំ ក្រើន រំលឹក កម្មករ កម្ម ការិនី ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ ឱ្យ បាន គ្រប់ ៗ គ្នា
( កំពង់ស្ពឺ ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន ប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ រកា ធំ ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ បាន ក្រើន រំលឹក ដល់ កម្មករ កម្ម ការិនី អញ្ជើញ ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រី នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ខាងមុខ នេះ ឱ្យ បាន គ្រប់ ៗ គ្នា ។
ការក្រើន រំលឹក បែប នេះ របស់ ប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ រកា ធំ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ នៅក្នុង ឱកាស លោក រួម ជាមួយ លោក ចឹក បូរិន ប្រធាន មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត កំពង់ស្ពឺ ព្រមទាំង ក្រុមការងារ បាន ចុះ ជូប សំណេះសំណាល ជាមួយ កម្មករ - កម្មារិនី ចំនួន ១.៣០០ នាក់ ដែល មាន ទីលំនៅ ក្នុង សង្កាត់ រកា ធំ ។
នា ឱកាស នោះ ដែរ ប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ រកា ធំ បាន លើកឡើង ថា បច្ចុប្បន្ន ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា សម្តេច បាន យកចិត្តទុកដាក់ បំផុត ចំពោះ បង កូនក្មួយ ជា កម្មករ - កម្មារិនី តាម បណ្តា រោងចក្រ ទូទាំង ប្រទេស ។ ដោយឡែក ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពង់ស្ពឺ ក៏ ទទួលបាន ការយកចិត្តទុកដាក់ ស្មើ ៗ គ្នា ។
លោក បាន រំលឹក ថា រាជ រដ្ឋាភិបាល បាន កំណត់ ប្រាក់ ស្នួល អប្បរមា ឆ្នាំ ២០២៣ ប្រាក់ អត្ថប្រយោជន៍ ផ្សេង ៗ និង ប្រាក់ អតីតភាព ការងារ ដែល ទាំងនេះ បាន ធ្វើឱ្យ បងប្អូន កូនក្មួយ ទទួលបាន ឧត្តម ប្រយោជន៍ ដ៏ ធំធេង សម្រាប់ ប្រាក់ ចំណូល ជីវភាព ប្រចាំ ថ្ងៃ ក្នុង ការរស់នៅ របស់ គ្រួសារ ។
លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន បាន សង្កត់ធ្ងន់ ថា ទោះបីជា កម្មករ - កម្មារិនី រវល់ យ៉ាងណា គឺ ត្រូវ នាំគ្នា ទៅ បោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ នីតិកាល ទី៧ ដើម្បីឱ្យ មាន ការដឹកនាំ រាជ រដ្ឋាភិបាល ដ៏ មាន សន្តិភាព និង មាន សក្តានុពល សេដ្ឋកិច្ច រុងរឿង ជឿនលឿន ដូច សព្វ ថ្ងៃ និង សេដ្ឋកិច្ច បន្ត កើនឡើង ស្មើ មុខ ស្មើ មាត់ ជា អន្តរជាតិ ។
លោក ចឹក បូរិន បាន លើកឡើង ថា សម្រាប់ កម្មករ និយោជិក ផ្នែក វាយ ភណ្ឌ កាត់ដេរ និង ផលិត ស្បែកជើង ផលិតផល ធ្វើដំណើរ ការបូប សម្រាប់ ឆ្នាំ ២០២៣ ដែល ប្រាក់ ឈ្នួល អប្បរមា ថ្មី ២០០ ដុល្លារ ក្នុង មួយ ខែ សម្រាប់ កម្មករ ពេញ សិទ្ធិ និង ១៩៨ ដុល្លារ សម្រាប់ កម្មករ សាកល្បង ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៤៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ២៧ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៤៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤៧ នាក់ នោះ មាន ១៦នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១១ករណី និង ជនសង្ស័យ ៣១ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ១៨ករណី ។
សម្តេច ម៉ែន សំអន ដឹកនាំ គណៈប្រតិភូ ត្រឡប់ មកដល់ កម្ពុជា វិញ បន្ទាប់ពី បំពេញ ទស្សនកិច្ចការងារ រយៈពេល ៣ ថ្ងៃ នៅ វៀតណាម ប្រកបដោយ ផ្លែផ្កា
( ភ្នំពេញ )៖ គណៈប្រតិភូ ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច ដឹកនាំ ដោយ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី បាន ដឹកនាំ គណៈប្រតិភូ ត្រឡប់ មកពី ទស្សនកិច្ច ជា ផ្លូវការវិញ ហើយ នៅ ល្ងាច ថ្ងៃសៅរ៍ ទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ បន្ទាប់ពី បាន ស្នាក់ នៅ សាធារណៈ រដ្ឋ សង្គម និយម វៀតណាម អស់ រយៈពេល ៣ ថ្ងៃ រួច មក ។
លោក ណុប ចាន់ ណារិន្ទ បន្ត ថា ពិធី ចុះហត្ថលេខា លើ ឯកសារ នៃ អនុស្សារណៈ នេះ បាន ធ្វើឡើង រវាង សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច ជាមួយ លោក ឌ័ន ហុង ហ្វុង (Doan Hong Phong) សមាជិក មជ្ឈិម បក្ស និង ជា អគ្គាធិការ នៃ អធិការកិច្ច រដ្ឋាភិបាល វៀតណាម កាលពី រសៀល ថ្ងៃទី ២៦ ខែឧសភា នៅ ទីស្តីការអធិការកិច្ច រដ្ឋាភិបាល វៀតណាម ។
អ្នកនាំពាក្យ រូប នេះ បាន រំលឹក ថា នៅក្នុង អនុស្សារណៈ កាលពី ឆ្នាំ ២០០៦ - ២០១៨ វិស័យ អធិការកិច្ច នៃ ប្រទេស ទាំង ពីរ មាន វឌ្ឍនភាព គួរឲ្យ កត់សំគាល់ ពិសេស លើ ការបណ្តេះ បណ្តាល ធនធាន មនុស្ស ក្នុង នោះ មន្ត្រីរាជការ ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន ទទួល រួចហើយ នូវ ការ បណ្តុះបណ្តាល ដែល មាន រយៈពេល ៦ខែ ៣ខែ និង ១ ខែ មាន ចំនួន សរុប ២២៥ នាក់ ។
ទន្ទឹមនឹង ពិធី ចុះហត្ថលេខា លើ អនុស្សារណៈ ដ៏ មាន សារៈសំខាន់ នេះ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន ដឹកនាំ គណៈប្រតិភូ ចូល ជួប សម្តែង ការគួរសម ជាមួយ លោក ផាម មិញ ជិញ នាយក រដ្ឋមន្ត្រី វៀតណាម ដោយ ភាគី ទាំង ពីរ បាន សម្តែង នូវ មោទនភាព នៃ កិច្ចសហប្រតិបត្ត ការ ល្អ លើ គ្រប់ វិស័យ ដើម្បី ប្រយោជន៍ នៃ សន្តិភាព មិត្តភាព ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម នៃ ប្រជាជន និង ប្រជាជាតិ ទាំង ពីរ ។
ជាមួយគ្នា នេះ នាយក រដ្ឋមន្ត្រី វៀតណាម បាន ថ្លែង នូវ ការកោតសរសើរ ការ រីកចំរើន របស់ កម្ពុជា និង ជោគជ័យ ធំ នៃ ការធ្វើជា ម្ចាស់ ផ្ទះ កីឡា ស៊ីហ្គេម លើក ទី ៣២ និង សូម ជូនពរ ឲ្យ ការបោះឆ្នោត នា ថ្ងៃ ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ ទទួលបាន ជោគជ័យ ។
ជា ការឆ្លើយតប នៅក្នុង ជំនួប នេះ សម្តេច កិត្តិសង្គហ បណ្ឌិត បាន នាំមក នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ផ្ញើ ជូន ថ្នាក់ដឹកនាំ បក្ស - រដ្ឋ និង ប្រជាជន វៀតណាម ប្រកបដោយ ការនឹករលឹក និង បាន បញ្ជាក់ ពី ការខិតខំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី លើកកម្ពស់ ទំនាក់ទំនង អ្នកជិតខាង ល្អ និង ពង្រឹង ពង្រីក កិច្ចសហប្រតិបត្តិការ ដ៏ ជិតស្និទ្ធ រវាង គណបក្ស រដ្ឋាភិបាល និង ប្រជាជន នៃ ប្រទេស ទាំង ពីរ ។
ក្នុង ឱកាស ស្នាក់ នៅ ទីក្រុង ហាណូយ ប្រទេស វៀតណាម សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី បាន អញ្ជើញ ទស្សនកិច្ច នៅ ក្រុមហ៊ុន Viettel ដែល ជា ក្រុមហ៊ុន វិនិយោគ បណ្តាញ ទូរគមនាគមន៍ នាំមុខ គេ នៅ ប្រទេស វៀតណាម និង បាន ពង្រីក ទៅ តាម បណ្តា ប្រទេស អាស៊ាន ក្នុង នោះ ក៏ មាន កម្ពុជា ផងដែរ ហើយ បាន នឹង កំពុង ទទួល ការគាំទ្រ និង ទទួលបាន ជោគជ័យ ក្នុង វិស័យ នេះ ។
នៅ ថ្ងៃទី ២៧ ខែឧសភា មុនពេល ចាកចេញ ពី ទីក្រុង ហាណូយ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន ដឹកនាំ គណៈប្រតិភូ ទស្សនកិច្ច នៅ ធនាគារ ពាណិជ្ជកម្ម ភាគហ៊ុន វិនិយោគ និង អភិវឌ្ឍន៍ វៀតណាម (BIDV) និង បាន បន្ត មកដល់ កម្ពុជា វិញ ដោយ នាំមក នូវ ផ្លែ ផ្កា និង សុវត្ថិភាព ៕
ក្រុមការងារ ចុះ មូលដ្ឋាន ខណ្ឌ ទួលគោក សហការ ជាមួយ មន្ទីរពេទ្យ អង្គ ឌួង ដឹកនាំ ក្រុម គ្រូពេទ្យ ចុះ ពិនិត្យ ព្យាបាល ជំងឺ ភ្នែក ជូន ពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ
ពិធី នេះ បាន ធ្វើឡើង នៅ សាលា ជា ស៊ីម សន្ធរ មុខ និង ដោយ មាន ការចូលរួម ពី លោក លូ លី ឃាង នាយក មន្ទីរពេទ្យ អង្គ ឌួង លោក ចាន់ បណ្ឌិត អភិបាល រង ខណ្ឌ ទួលគោល និង មាន ការចូលរួម ពី លោក ចៅសង្កាត់ ផ្សារ ដេប៉ូទី១ ផ្សារ ដេប៉ូទី២ និង ផ្សារ ដេប៉ូទី៣ ក្រុម គ្រូពេទ្យ និង អ្នក ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក ឃាង សេង បាន បន្ថែម ទៀត ថា សម្រាប់ ការចុះ ព្យាបាល នេះ ដែរ ក្រុមការងារ នឹង នៅតែ បន្ត ចុះ ព្យាបាល ជា បន្តបន្ទាប់ ទៀត ផងដែរ ជាមួយគ្នា នោះ ដែរ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន តែងតែ ចាត់ ឱ្យ ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ចុះ ជួួយ សម្រាក ការលំបាក ជូន ប្រជាពលរដ្ឋ តាមរយៈ ការចុះ ជួយ ព្យាបាល ជំងឺ ដោយ ឥត គិត ថ្លៃ និង សកម្មភាព ផ្សេង ៗ ជាច្រើន ទៀត ដោយ មិន ទុក ឱ្យ មាន ប្រជាពលរដ្ឋ ណា ដែល ជួប ការលំបាក ដោយ មិន មាន ការយកចិត្តទុកដាក់ ពី ប្រមុខ ថ្នាក់ដឹកនាំ នោះ ឡើយ ។
តាមរយៈ ការចុះ ជួយ ជា បន្តបន្ទាប់ នេះ លោក ឃាង សេង ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ បន្ត គាំទ្រ ថ្នាក់ដឹកនាំ ដែល តែងតែ នាំ កម្ពុជា ឆ្ពោះ ទៅរក ការអភិវឌ្ឍ និង ផ្តល់ នូវ កត្តា សុខ សន្តិភាព ជូន ដល់ ប្រជាពលរដ្ឋ និង បន្ត ជ្រើសរើស ថ្នាក់ដឹកនាំ ពិតប្រាកដ ដែល នាំ នាវា កម្ពុជា ឆ្ពោះ ទៅរក សុខ សន្តិភាព ជារៀងរហូត ។
បន្ថែម ពី នេះ តាង នាម លោក កិត្តិនីតិកោសល បណ្ឌិត ឱម យ៉ិនទៀង លោក ក៏ បាន ថ្លែង អរគុណ ដល់ ក្រុម កាងារ គ្រូពេទ្យ ទាំង ពេទ្យ រដ្ឋ ទាំងអស់ ជាពិសេស មន្ទីរពេទ្យ អង្គ ឌួង ដែល តែងតែ បាន ចូលរួម ឈឺឆ្អាល គ្រប់ ពេល ដោយ ស្ម គ្រ័ចិត្ត ក្នុង ការពិនិត្យ ព្យាបាល ជំងឺ ជូន ដល់ ប្រជាពលរដ្ឋ នៅក្នុង ខណ្ឌ ទួលគោក ទាំងមូល ៕
យល់ដឹល់ ពី ជំនួញ៖ អ្នកជំនាញ ផលិត ចំណីអាហារ កែច្នែ ប្រាប់ ពី ចំណុច ខ្លះ ៗ ដើម្បី ធ្វើឱ្យ ផលិតផល កែច្នែ របស់ កម្ពុជា នាំចេញ ទៅ ចិន បាន
( ភ្នំពេញ ) ៖ បច្ចុប្បន្ន នេះ ផលិតផល កសិកម្ម កែច្នៃ របស់ កម្ពុជា មាន តិចតួច បំផុត ដែល អាច នាំចេញ ទៅ ប្រទេស ចិន បាន បើ ទោះបីជា ប្រទេស ទាំង ពីរ បាន និង កំពុង អនុវត្ត នូវ កិច្ចព្រមព្រៀង សេរី ពាណិជ្ជកម្ម កម្ពុជា - ចិន និង កិច្ចព្រមព្រៀង RCEP ក៏ដោយ ។
លោក មៀវ សុខ ទ្រី ប្រធាន សមាគម អ្នកផលិត ចំណីអាហារ កម្ពុជា បាន ឱ្យដឹង ថា ផលិតផល កសិកម្ម កែច្នៃ របស់ កម្ពុជា មាន តិចតួច បំផុត ដែល បាន នាំចេញ ទៅ ក្រៅ ប្រទេស ដោយសារ ស្តង់ដារ របស់ ផលិតផល កម្ពុជា នៅ មាន កម្រិត មិន ទាន់ ធ្វើ បាន តាម អ្វី ដែល ប្រទេស គេ កំណត់ ខណៈ ដែល ក្រុមហ៊ុន សហគ្រាស និង សិប្បកម្ម កែច្នៃ ភាគ ច្រើន នៅ មាន លក្ខណៈ តូច ៗ ពេក ដែល ធ្វើឱ្យ ការអនុវត្ត ស្តង់ដារ នៅ មាន កម្រិត ដោយ កត្តា ទីតាំង ផលិត និង ថវិកា ។
លោក បន្ថែម ថា « ដើម្បី នាំចេញ ផលិតផល អាហារ កែច្នៃ នៅ ប្រទេស នេះ ក្រសួង ពាក់ព័ន្ធ ត្រូវ ស្វែងរក ព័ត៌មាន ឱ្យ បាន ច្រើន ពី មជ្ឈមណ្ឌល ស្តង់ដារ របស់ គេ ដើម្បី យកមក បង្រៀន ដល់ អាជីវករ យើង » ។
តែ យ៉ាងណា លោក សង្កេតឃើញ ថា បច្ចុប្បន្ន នេះ រាជ រដ្ឋាភិបាល បាន យកចិត្តទុកដាក់ ច្រើន ទៅ លើ ស្តង់ដារ ថ្នាក់ ជាតិ ដើម្បីឱ្យ បណ្តា សិប្បករ ទាំងអស់ គោរព តាម ស្តង់ដារ នេះ និង ឈាន ទៅ អនុវត្ត ស្តង់ដារ អន្តរជាតិ ដើម្បី នាំចេញ ទៅ ប្រទេស នានា បាន ស្រួល ។
លោក ចូវ ឃុន អនុប្រធាន គណៈកម្មការគ្រប់គ្រង តំបន់ សេដ្ឋកិច្ច ភូវ៉ាន់ តាលៀន ដែល បាន មក សិក្សា ពី ផលិតផល កសិម្ម កែច្នៃ កម្ពុជា បាន លើកឡើង ថា ផលិតផល កសិកម្ម កែច្នៃ របស់ កម្ពុជា សុទ្ធតែ មាន សក្តានុពល ខ្ពស់ ក្នុង ការនាំចេញ ទៅ ប្រទេស ចិន ដោយ ភាគ ច្រើន នៃ ផលិតផល ទាំងនេះ មិន មាន លាយ ញ្ចូល នូវ សារធាតុ គីមី អ្វី ផ្សេង នោះ ទេ ដូច្នេះហើយ ផលិតផល ចំណីអាហារ កែច្នៃ របស់ កម្ពុជា អាច មាន ឱកាស ច្រើន ក្នុង ការនាំចូល ទៅ ទីផ្សារ ប្រទេស ចិន ។
លោក បាន ពន្យល់ ថា ចំពោះ ផលិតផល ដែល នាំចូល ទៅ ប្រទេស ចិន តម្រូវ ឱ្យ ធ្វើ ការអភិវឌ្ឍ បន្ថែម ដើម្បី ផលិតផល ទាំងនោះ ស្រប ទៅតាម ស្តង់ដារ អន្តរជាតិ និង ស្តង់ដារ ដែល បាន កំណត់ ដោយ ប្រទេស ចិន ។ ជាមួយគ្នា នេះ កម្ពុជា ចាំបាច់ ត្រូវ មាន រោងចក្រ ដើម្បី កែច្នៃ ផលិតផល ទាំងនេះ ។
លោក គូសបញ្ជាក់ បន្ត ថា « ដើម្បី អាច នាំចេញ ទៅ ប្រទេស ចិន បាន ចាំបាច់ ត្រូវ ធ្វើឱ្យ ផលិតផល ទាំងនេះ មាន ការទទួលស្គាល់ ជា លក្ខណៈ អន្តរជាតិ និង គោរព តាម ស្តង់ដារ សុវត្ថិភាព របស់ ប្រទេស ចិន ទើប ផលិតផល ទាំងនេះ នាំចូល ទៅ ទីផ្សារ ប្រទេស ចិន បាន ។ ក្នុង នោះ ដែរ ទាម ឱ្យ ស្ថាប័ន ពាក់ព័ន្ធ របស់ ប្រទេស ទាំង ពីរ ទទួលស្គាល់ នូវ ស្តង់ដារ ចំណីអាហារ និង គោរព ទៅ តាម បទបញ្ញត្តិ ព្រមទាំង គោលការណ៍ ភូត គាម អនាម័យ របស់ ចិន » ។
លោក បន្ថែម ថា លោក នឹង សហការ ជាមួយ សមាគម អ្នកផលិត ចំណីអាហារ កម្ពុជា ដើម្បី ជំរុញ ឱ្យ ផលិតផល កសិកម្ម ទាំង នេះ ចូល ទីផ្សារ ប្រទេស ចិន ឱ្យ បាន ឆាប់ នា ពេល ខាងមុខ ។ ប្រសិនបើ ផលិតផល ទាំងនេះ បាន នាំចូល ទៅ ប្រទេស ចិន លោក នឹង ធ្វើ ការផ្សព្វផ្សាយ ឱ្យ បាន ទូលំទូលាយ ទៅដល់ អ្នកប្រើប្រាស់ នៅ ប្រទេស ចិន ដើម្បី ពង្រីក ទីផ្សារ នៅ ប្រទេស ចិន និង ធ្វើឱ្យ អ្នកប្រើប្រាស់ ទទួលស្គាល់ ផលិតផល របស់ កម្ពុជា ។
លោក បន្ត ថា « ខ្ញុំ ជឿជាក់ ថា ប្រសិនបើ ផលិតផល កម្ពុជា មាន ស្តង់ដារ និង មាន ផលិតកម្ម ច្បាស់លាស់ ផលិតផល ទាំងនេះ នឹង អាច មាន ទីផ្សារ កាន់តែ ធំ នៅ ប្រទេស ចិន » ។
លោក មៀវ សុខ ទ្រី បាន ឱ្យដឹង ដែរ សមាគម អ្នកផលិត ចំណីអាហារ កម្ពុជា នឹង សហការ ជាមួយ សហគមន៍ អាស៊ាន បូក ៦ ក្នុង ការសិក្សា លទ្ធភាព ក្នុង នាំចេញ ផលិតផល ទៅកាន់ បណ្តា ប្រទេស អាស៊ាន បូក៦ រួមទាំង ប្រទេស ចិន ក៏ ដូចជា ពិនិត្យ លទ្ធ ជួយ ពង្រីក ការផលិត ឱ្យ កាន់តែ ធំ ដើម្បីឱ្យ តម្លៃ ផលិតផល កាន់តែ ធូរ ថ្លៃ មាន ប្រព័ន្ធ គ្រប់គ្រង កាន់តែ ល្អ ៕ គ្រោះ ធម្មជាតិ ! បុរស វ័យ ចំណាស់ ម្នាក់ ត្រូវ រន្ទះ បាញ់ ស្លាប់ ខណៈ ទៅ យក គោ ពី វាល ស្រែ នៅ ស្រុក ពារាំង ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ ភ្លៀង ខ្យល់ លាយឡំ និង បង្កឱ្យ មាន រន្ទះ បាញ់ បុរស វ័យ សំណាស់ ម្នាក់ ឱ្យ ស្លាប់ ខណៈ ដែល ជនរងគ្រោះ ទៅ យក គោ ចង នៅ វាល ស្រែ ក្បែរ ភូមិ ។ ករណី នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ១៧និង ៣០ នាទី ល្ងាច ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នៅ ចំណុច ខាងកើត ភូមិ មេលប់ ប្រហែល៤០០ ម៉ែត្រ ឃុំ រកា ស្រុក ពារាំង ខេត្ត ព្រៃវែង ។
សមត្ថកិច្ច បាន ឱ្យដឹង ថា ជនរងគ្រោះ ឈ្មោះ ម៉ៅ ពៅ ភេទ ប្រុស អាយុ ៤៨ ឆ្នាំ ។ នៅ មុនពេល កើត ហេតុ មាន ភ្លៀង ផ្គរ ខ្យល់ កន្ត្រាក់ បក់ បោក យ៉ាង ខ្លាំង ខណៈ នោះ ជនរងគ្រោះ បាន ទៅ យក គោ នៅឯ វាល ស្រែ ក្បែរ ភូមិ ស្រាប់តែ ត្រូវ រន្ទះ បាញ់ ស្លាប់ នៅ កណ្ដាល វាល ស្រែ តែម្ដង ធ្វើឱ្យ មាន ការភ្ញាក់ផ្អើល ដល់ ប្រជាពលរដ្ឋ ក្នុង ភូមិ មក ចោមរោម មើល និង ជួយសង្គ្រោះ ដែរ តែ ជា អកុសល បាន ដាច់ខ្យល់ស្លាប់ ទៅ ហើយ ។
ប ច្បន្ន សាកសព ត្រូវបាន ក្រុមគ្រួសារ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី នៅឯ គេហដ្ឋាន ។ អាជ្ញាធរ ស្រុក ពារាំង បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន នៅពេល មាន ភ្លៀង ផ្គរ រន្ទះ កុំ ចេញ ទៅ វាល ស្រែ ឬ ជ្រក ក្រោម ដើមឈើ និង មួយ ទៀត បិទ គ្រឿង អេឡិចត្រូនិក ដែល មាន ជាតិ វិទ្យុសកម្ម ដើម្បី ការពារ រាល់ ហានិភ័យ ណាមួយ ដែល អាច កើតឡើង ជា យថាហេតុ ៕
លោក អ៊ាង សុផល្លែ ត៖ ខ្មែរ សាគ្គី ខ្មែរ ខ្លាំង ខ្មែរ សាមគ្គី ខ្មែរ ឈ្នះ ខ្មែរ មាន ឱកាស ខ្មែរ អាច ធ្វើ បាន និង ទទួលបាន ជោគជ័យ
( ត្បូងឃ្មុំ ) ៖ លោក អ៊ាង សុផល្លែត បេក្ខជន តំណាងរាស្រ្ត គណបក្ស ប្រជាជន កម្ពុជា មណ្ឌល ត្បូងឃ្មុំ និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក អូរ រាំង ឪ នា ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ បាន ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ នៅ ឃុំ ចក និង ឃុំ ដំរិល ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ ដើម្បី សួរសុខទុក្ខ ពិនិត្យ វឌ្ឍនភាព ការងារ ក៏ ដូចជា សមិទ្ធផល នានា ដែល ក្រុមការងារ បាន បំពេញ និង ផ្តល់ ជូន ប្រជាពលរដ្ឋ និង ដោះស្រាយ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ដែល ជា តម្រូវ ការចាំបាច់ និង បន្ទាន់ របស់ ពួកគាត់ ។
លោក អ៊ាង សុផល្លែត ក៏ បាន សំណូមពរ ឱ្យ ប្រជាពលរដ្ឋ បន្ត ផ្តល់ ឱកាស ខ្លួន ឯង និង ក្មេង ៗ ជំនាន់ ក្រោយ តាមរយៈ ការចូលរួម ការពារ រក្សា សន្តិភាព អនុវត្ត លទ្ធិ ប្រជាធិបតេយ្យ ចូលរួម បោះឆ្នោត ទាំងអស់ គ្នា នា ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ និង ផ្តល់ ឱកាស ឱ្យ គណបក្ស ប្រជាជន កម្ពុជា បាន បន្ត អនុវត្ត គោល យោបាយ របស់ ខ្លួន ក្នុង រក្សា សុខ សន្តិភាព ការអភិវឌ្ឍ ដែល ដឹកនាំ នាវា កម្ពុជា ឆ្ពោះ ទៅកាន់ ភាពរុងរឿង ។
គួរ បញ្ជាក់ ថា ក្នុង ថ្ងៃសៅរ៍ ដដែល នោះ ដែរ មាន សេចក្ដីរាយការណ៍ ពី ការវាយប្រហារ ដោយ យន្ដហោះ ដ្រូន ចូល យ៉ាង ជ្រៅ ក្នុង ទឹកដី រុស្ស៉ី ដោយ មាន គោលដៅ លើ បំពង់ បង្ហូរ ប្រេង ។ រុស្ស៉ី តែងតែ ចោទ ថា អ៊ុយក្រែន គឺជា អ្នក នៅ ពីក្រោយ ការវាយប្រហារ របៀប នេះ តែ អ៊ុយក្រែន មិន ដែល ទទួលស្គាល់ ជាសាធារណៈ ឡើយ ចំពោះ ការវាយប្រហារ ចូល ជ្រៅ ក្នុង ទឹកដី រុស្ស៉ី ៕
លោក វង្ស ពិសេន បាន លើកឡើង ថា សម្ដេច តេជោ ហ៊ុន សែន បាន យក អាយុជីវិត ទៅ រំដោះ ប្រជាជន ឲ្យ រួចផុត ពី សេចក្តីស្លាប់ និង ប្ដូរ អាយុជីវិត ដើម្បី យកមក នូវ សន្តិភាព
( ព្រៃវែង ) ៖ កាលពី ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ លោក វង្ស ពិសេន បាន អញ្ជើញ ចុះ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា បក្ស នៅក្នុង ឃុំ កំពង់ព ពិល ស្រុក ពារាំង ខេត្ត ព្រៃវែង ។
ជា ទីបញ្ចប់ លោក បាន អំពាវនាវ ឱ្យ សមាជិក សមាជិកា របស់ គណបក្ស ប្រជាជន ទាំងអស់ អញ្ជើញ ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ។ មាន តែ គណបក្ស ប្រជាជន ទេ ដែល អាច ការពារ បាន នូវ សន្តិភាព មាន សន្តិភាព ក៏ដោយសារ គណបក្ស ប្រជាជន មាន គណបក្ស ប្រជាជន ទើប មាន សន្តិភាព ៕
លោក បណ្ឌិត បាន ថ្លែង ថា កាលពី ពេល ថ្មី ៗ កន្លងមក នេះ ក្នុង ពេល សម្តេច តេជោ ហ៊ុន សែន ចុះ សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី សម្តេច បាន រំលឹក រឿង ដែល លោក បណ្ឌិត ធ្លាប់ លើកឡើង ពី ភាពខុសគ្នា នៃ ស្នាម ថើប ជាប់ ថ្ពាល់ ដោយ សម្តេច ចុះ ជួបកម្ម ការិនី ទទួល ស្នាម ក្រែម ជាប់ ថ្ពាល់ តែ ចំណែក រូបលោក វិញ ចុះ ជួប លោកយាយ លោក តា មាន ស្នាម ស្លា ជាប់ ថ្ពាល់ ។
សម្រាប់ ស្នាម ថើប របស់ លោកយាយ ៗ និង បងប្អូន ប្រជាពលរដ្ឋ នេះ លោក បណ្ឌិត ចាត់ទុក ជា សេចក្តីស្រឡាញ់ និង ថាមពល បំបាត់ ការនឿយហត់ សម្រាប់ រូបលោក ។
ប្រើ គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គមជាតិ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៧ ខែឧសភា៖ បង្ក្រាប ២២ករណី ឃាត់ខ្លួន ៧០ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៨ករណី . ដឹកជញ្ជូន រក្សាទុក ៧ករណី និង ជួញដូរ ៧ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៧០ នាក់ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៥. ២៨៨. ៧៨៧ នាក់ ។ ក្នុង នោះ រួម មាន៖
( កំពង់ធំ )៖ លោក ងួន រតនៈ ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ធំ តំណាង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត សមាជិក គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា នៅ រសៀល ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន នាំ អង្ករ ៨១តោន និង មី២.៥០០ កេស ជូន ដល់ គណបក្ស ឃុំ សង្កាត់ ចំនួន ៨១ ដើម្បី បន្ត ចែកជូន ទៅដល់ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត នៅ តាម បណ្ដា ឃុំ សង្កាត់ របស់ ខ្លួន ។
លោក បាន បញ្ជាក់ ដឹង ថា ចំពោះ អង្ករ និង មី ទាំងអស់ នេះ ត្រូវបាន បណ្ឌិត ហ៊ុន ម៉ាណែត ផ្តល់ ជូន ជា លើក ទី៣ ហើយ ដើម្បី ចែក បន្ត ជូន ទៅដល់ គណបក្ស ក្រុង ស្រុក ឃុំ សង្កាត់ ក្នុង ខេត្ត បាត់ដំបង ។
លោក ងួន រតនៈ បាន ផ្ដាំផ្ញើ ទៅដល់ គណៈកម្មាធិការ គណបក្ស ឃុំ សង្កាត់ ទាំងអស់ ត្រូវ បន្ត ចែកជូន ដល់ ប្រជាពលរដ្ឋ ដែល ងាយ រងគ្រោះ បំផុត ដោយ មិន មាន ការរើសអើង និន្នាការ នយោបាយ អ្វី ឡើយ នេះ ជា ការយកចិត្តទុកដាក់ ជា ចម្បង ទៅ លើ សុខ ទុ ក្ខ របស់ ប្រជាពលរដ្ឋ ទីណា មាន ប្រជាពលរដ្ឋ រង ទុក្ខ រងគ្រោះ អត់ឃ្លាន ទីនោះ មាន មុខ ថ្នាក់ដឹកនាំ និង មន្ត្រី គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ជានិច្ច ៕
សម្ដេច ក្រឡាហោម ស ខេង អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ មន្រ្តី ជាប់ កិច្ចសន្យា សាលា ខេត្ត បាត់ដំបង និង មន្ត្រី សុខាភិបាល ជាង ២០០០ នាក់
( បាត់ដំបង ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត បាត់ដំបង និង ព្រៃវែង នា រសៀល ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ បន្ត ជួប សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ មន្រ្តី ជាប់ កិច្ចសន្យា សាលា ខេត្ត និង មន្រ្តី មន្ទីរ សុខាភិបាល នៃ រដ្ឋបាល ខេត្ត បាត់ដំបង ចំនួន ២. ០៨៨នាក់ នៅ សាល មហោស្រព ស្ទឹង សង្កែ ក្រុង បាត់ដំបង ។
សម្ដច ក្រឡាហោម ស ខេង ក៏ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ថ្នាក់ដឹកនាំ ខេត្ត ដែល បាន សហការ គ្នា ជាមួយ ក្រុម ពេទ្យ នៃ រដ្ឋ បាន ខេត្ត និង រដ្ឋបាល មូលដ្ឋាន ក្នុង អំឡុង ឆ្លង រីករាល ជម្ងឺ កូវីដ១៩ កន្លងមក និង ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច ជោ បាន ស្រោច វ៉ាក់សាំង ដល់ ប្រជាពលរដ្ឋ យើង ទូទាំង ប្រទេស បាន រហ័ស ទាន់ ពេលវេលា ទប់ស្កាត់ និង ព្យាបាល ជំងឺ ដ៏ កាច សាហាវ នេះ ប្រកបដោយ ជោគជ័យ ។
សម្ដេច ក្រឡាហោម ស ខេង បាន បញ្ជាក់ អំពី សមិទ្ធផល រយៈពេល ៥ ឆ្នាំ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៦ កន្លងទៅ ដែល នឹង បញ្ចប់ ក្នុង ២០២៣ នេះ ដោយ បាន សម្រេច មាន សមិទ្ធផល មាន ការរីកចម្រើន ខ្លាំង លើ គ្រប់ វិស័យ ហើយ យើង នឹង ខិតខំ ធ្វើ ការងារ នេះ ៥ ឆ្នាំ គឺ ពី ឆ្នាំ ២០២៣ ដល់ ឆ្នាំ ២០២៨ នីតិកាល ទី៧ ដែល នឹង ត្រូវ ចំពេល បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នា ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
សម្ដេច ក្រឡាហោម បាន បញ្ជាក់ ថា ទន្ទឹមនឹង ការវិវត្ត ប្រែប្រួល ស្មុគស្មាញ នៃ សភាពការណ៍ តំបន់ និង អន្តរជាតិ នោះ នៅ កម្ពុជា ក្រុម ប្រឆាំង ជ្រុលនិយម និង មជ្ឈដ្ឋាន អគតិ មួយចំនួន នៅតែ បន្ត រិះរក គ្រប់ វិធី ប៉ុនប៉ង បង្កឱ្យ មាន ភាពចលាចល វឹកវរ ក្នុង សង្គម ដើម្បី ឈាន ទៅ ផ្ដួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល កើត ចេញពី ការបោះឆ្នោត និង ប្រើប្រាស់ គ្រប់ ល្បិច កល ដើម្បី រារាំង ដល់ ដំណើរការ នៃ ការអភិវឌ្ឍ សង្គមជាតិ ។
សម្ដេច ក្រឡាហោម ស ខេង បាន បន្ត ថា ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត សម្ដេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ គោល នយោបាយ និង វិធានការ នានា ដោយ មាន ការគាំទ្រ និង ការចូលរួម យ៉ាង សកម្ម ពី មន្រ្តី រាជការ កងកម្លាំង មាន សមត្ថកិច្ច អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ និង ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ផងដែរ ។ សម្ដេចក៏ បាន ជម្រាប ជូន អំពី ទិសដៅ ការងារ រួម របស់ រាជ រដ្ឋាភិបាល រួម មាន ទិសដៅ ការងារ ឆ្នាំ ២០២៣ និង ទិសដៅ រយៈពេល ៥ឆ្នាំ ទៅ មុខ បន្ត ទៀត ។
សម្ដេច បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ត្រៀម ទៅ បោះឆ្នោត ជ្រើសរើស សភា តំណាងរាស្រ្ត នីតិកាល ទី៧ នា ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ឱ្យ បាន គ្រប់ ៗ គ្នា ដើម្បី គាំទ្រ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា បាន បន្ត ដឹកនាំ ប្រទេសជាតិ ឆ្ពោះ ទៅរក ការរីកចម្រើន កាន់តែ ប្រសើរ ជាង មុន បន្ថែម ទៀត ប្រកបដោយ សុខ សុវត្តិភាព មាន សន្តិភាព ទើប មាន អ្វី ៗ ទាំងអស់ ដល់ សព្វ ថ្ងៃ ។
( បែរ ឡាំង ) ៖ ប្រភព ពី ក្រសួង ការបរទេស អាល្លឺម៉ង់ បាន ឲ្យដឹង នៅ ថ្ងៃសៅរ៍ នេះ ថា អាល្លឺម៉ង់ នឹង ដក បុគ្គលិក រដ្ឋាភិបាល ជាង ១០០ នាក់ ដែល កំពុង ធ្វើការ នៅ រុស្ស៉ី ឲ្យ ត្រលប់ មកវិញ បន្ទាប់ពី ទីក្រុង មូស្គូ បាន ដាក់ កម្រិត លើ ចំនួន អ្នកបម្រើ បេសកកម្ម ការ ទូត អាល្លឺម៉ង់ នៅក្នុង ប្រទេស របស់ ខ្លួន ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសៅរ៍ ទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ ។
ប្រភព ដដែល បាន បញ្ជាក់ ថា « ដែន កំណត់ នេះ ចំនួន បុគ្គលិក ដោយ រុស្ស៉ី នឹង ចូល ជាធរមាន នៅ ដើម ខែមិថុនា ខាងមុខ ដោយ ទាមទារ ឲ្យ មាន ការ កាត់បន្ថយ ដ៏ ធំ នៅ គ្រប់ ផ្នែក ទាំងអស់ នៃ វត្តមាន របស់ យើង ក្នុង ប្រទេស រុស្ស៉ី » ។
អ្នក ដែល រង ផល ប៉ះពាល់ រួម មាន គ្រូបង្រៀន ក៏ ដូចជា បុគ្គលិក ផ្សេង ទៀត នៃ សាលារៀន និង វិទ្យាស្ថាន Goethe ហើយ ចាំបាច់ ត្រូវ រក្សា តុល្យភាព ត្រឹមត្រូវ សម្រាប់ វត្តមាន អ្នកការទូត អាល្លឺម៉ង់ ។ ក្នុង ចំណោម បុគ្គល ដែល បាន រៀបរាប់ នេះ គឺ មាន ចំនួន ១០០ នាក់ ។
គួរ បញ្ជាក់ ថា ទំនាក់ទំនង រវាង រុស្ស៉ី និង អាល្លឺម៉ង់ ដែល ធ្លាប់ ជា អ្នកទិញ ប្រេង និង ឧស្ម័ន ដ៏ ធំ បំផុត របស់ រុស្ស៉ី បាន បែកបាក់ ចាប់តាំងពី ទីក្រុង មូស្គូ បាន បើក ការឈ្លានពាន លើ អ៊ុយក្រែន ក្នុង ខែកុម្ភៈ ឆ្នាំ ២០២២ ហើយ ដែល លោក ខាងលិច បាន ឆ្លើយតប ដោយ ការដាក់ទណ្ឌកម្ម និង ការផ្គត់ផ្គង់ អាវុធ ទៅឲ្យ ទីក្រុង កៀវ ៕ លោក ថេង សាវឿន ប្រធាន សមាគម កសិករ នៅ ខេត្ត រតនគិរី ទទួលស្គាល់ រាល់ កំហុស ដែល ធ្លាប់ បាន ប្រព្រឹត្ត កន្លងមក និង សុំទោស ចំពោះ អ្វី ដែល បាន ខុសឆ្គង (Video inside)
( រតនគិរី ) ៖ លោក ថេង សាវឿន ប្រធាន សមាគម កសិករ នៅ ខេត្ត រតនគិរី បាន សរសេរ លិខិត និង វីដេអូ សុំទោស ចេញ ពី ពន្ធនាគារ ចំពោះ អ្វី ដែល ខ្លួន ធ្លាប់ បាន ប្រព្រឹត្ត នា ពេល កន្លងមក ដោយ ជឿ តាម ការញុះញង់ របស់ គណបក្ស ប្រឆាំង និង បរទេស មួយចំនួន ។
ក្រោយពី ទទួលស្គាល់ កំហុស ដែល ប្រព្រឹត្ត កន្លងមក លោក ថេង សាវឿន សន្យា ចំពោះ មុខ ច្បាប់ និង អាជ្ញាធរ មាន សមត្ថកិច្ច ថា នឹង មិន ប្រព្រឹត្ត សកម្មភាព ទាំងឡាយ ដែល ខុសពី លក្ខន្ដិកៈ តម្កល់ នៅ ក្រសួង មហាផ្ទៃ ច្បាប់ សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ព្រមទាំង លិខិត បទដ្ឋាន គតិយុត្ត នានា ជាធរមាន ។ មួយ វិញទៀត លោក សន្យា ដក ខ្លួន ចេញ ពី សកម្មភាព នយោបាយ ដែល មាន គោលដៅ ផ្ដួលរលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ។
ខាងក្រោម នេះ ជា វីដេអូ សារភាព កំហុស និង សុំទោស រាល់ អ្វី ដែល ខ្លួន បាន ប្រព្រឹត្ត៖ ចំណេះដឹង ទូទៅ៖ បដិវត្តន៍ ធំ ៗ ទាំង ៥ក្នុង ប្រវត្តិសាស្ត្រ ពិភពលោក
( ភ្នំពេញ ) ៖ បដិវត្តន៍ ធំ ៗ ទាំង ៥ក្នុង ប្រវត្តិសាស្ត្រ បាន នាំ ទៅ រក ការផ្លាស់ប្ដូរ របប នយោបាយ ពិភពលោក ប៉ុន្តែ ក៏ បាន បង្កឱ្យ មនុស្ស ស្លាប់ អស់ មិន តិច នោះ ដែរ ។
ខាងក្រោម នេះ ជា បដិវត្តន៍ ធំ ៗ ទាំង ៥ក្នុង ប្រវត្តិសាស្ត្រ ពិភពលោក៖
លើស ពី នេះ ទៅ ទៀត ប្រទេស លោក ខាងលិច មួយចំនួន ជាពិសេស សហរដ្ឋ អាមេរិក នៅ ក្រោយ ការបោះឆ្នោត ប្រធានាធិបតី ឆ្នាំ ២០២៤ អាចនឹង បញ្ឈប់ ឬ កាត់បន្ថយ ការផ្ដល់ ជំនួយ គាំទ្រ អ៊ុយក្រែន ប្រសិនបើ ទីក្រុង កៀវ ប្រើប្រាស់ យុទ្ធសាស្ត្រ ធ្វើ សង្រ្គាម ចូល ទឹកដី រុស្ស៉ី ស្រប ពេល បណ្ដា ប្រទេស ដទៃ ទៀត នៅ ជុំវិញ ពិភពលោក ដែល រក្សា ជំហរ អព្យាក្រឹត ក្នុង សង្រ្គាម អ៊ុយក្រែន ក៏ អាច ងាក ទៅ ប្រឆាំង នឹង ទីក្រុង កៀវ ផងដែរ ។
ជាមួយនឹង ការដាក់ចេញ នៅ បទ វិភាគ នេះ ក្រុម យុវជន ក៏ សូម អំពាវនាវ ដល់ អ្នកនយោបាយ ប្រឆាំង ទាំងអស់ ឲ្យ យក ផលប្រយោជន៍ ជាតិ ធំ បញ្ឈប់ នយោបាយ អំពាវនាវ ដល់ អន្តរជាតិ ដាក់ទណ្ឌ លើ កម្ពុជា និង បញ្ឈប់ នយោបាយ បំបែកបំបាក់ ជាតិ ខ្មែរ ៕
ខាងក្រោម នេះ ជា បទ វិភាគ ស្តីពី មូលហេតុ នៃ ការ មិន បាន ចូលរួម បេាះ ឆ្នោត របស់ គណបក្ស ភ្លើង ទៀន៖ ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ អបអរសាទរ ឧកញ៉ា ទៀ វិចិត្រ ត្រូវបាន ព្រះមហាក្សត្រ ត្រាប់ បង្គាប់ ផ្តល់ គោរម ងា « អ្នក ឧកញ៉ា »
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ស្នងការ នគរបាល ខេត្ត កំពត សូម សម្តែង នូវ ការអបអរសាទរ យ៉ាង ស្មោះ អស់ ពី ដួងចិត្ត ជូន ចំពោះ ឧកញ៉ា ទៀ វិចិត្រ ដែល ត្រូវបាន ព្រះករុណ ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រាស់បង្គាប់ ផ្ដល់ គោរមងារ ជា « អ្នក ឧកញ៉ា » ។
ព្រះរាជ ទាន ត្រាស់បង្គាប់ ផ្តល់ គោរមងារ អ្នក ឧកញ៉ា នេះ ជា សក្ខីភាព ឆ្លុះបង្ហាញ អំពី កិច្ច ខិតខំ ប្រឹងប្រែង ទាំង កម្លាំង កាយ និង ចិត្ត ដោយ មិន ខ្លាច នឿយហត់ របស់ អ្នក ឧកញ៉ា ក្នុង បុព្វហេតុ ដើម្បី ជួយ សង្គមជាតិ និង ចូលរួមចំណែក ដល់ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ប្រទេសជាតិ ជា ទី ស្នេហា នៃ យើង ឱ្យ កាន់តែ រីកចម្រើន ។ ទន្ទឹមនឹង នេះ ការប្រទាន នេះ ពិតជា ស័ក្តិសម និង ផ្ដល់ កិត្តិយស ដ៏ ឧត្តុង្គឧត្តម សម្រាប់ អ្នក ឧកញ៉ា និង ក្រុមគ្រួសារ ។
ឆ្លៀត នៅក្នុង ឱកាស ដ៏ វិសេសវិសាល នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម បួងសួង ដល់ វត្ថុ ស័ក្ដិសិទ្ធិ ក្នុង លោក សូម ជួយ តាម ថ រក្សា និង ប្រោះ ព្រំ ប្រសិទ្ធ ពរ ជ័យ ជូន ចំពោះ អ្នក ឧកញ៉ា និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ ជា ទីស្រលាញ់ សូម ជួប ប្រទះ នូវ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ ជានិច្ច និរន្តរ៍ ៕
លោក ពិន ប្រកដ បាន ថ្លែងអំណរគុណ លោក ហ៊ុន ម៉ានី ប្រធាន កិត្តិយស ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត ឯកឧត្តម ហ៊ុន ម៉ានី បាន ចាត់តាំង បញ្ជូន ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត ឯកឧត្តម ហ៊ុន ម៉ានី ជាច្រើន លើក មក ខេត្ត សៀមរាប ក្នុង ការពិនិត្យ និង ព្យាបាល ចែក ថ្នាំ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ព្រមទាំង ចុះ យុទ្ធា ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ក្នុង ក្របខណ្ឌ ទូទាំង ប្រទេស ដោយ ឥត គិត ថ្លៃ និង ឥត គិត ថវិកា បេសកកម្ម ។
បទ ឈប់ បាញ់ មួយ ដែល បាន ចុះហត្ថលេខា កាលពី ថ្ងៃច័ន្ទ ដោយ ភាគី ជម្លោះ គឺ កងទ័ព ស៊ូ ដង់ និង ក្រុម ទាហាន ប៉ារ៉ា (RSF) មាន គោលបំណង ធានា បាន នូវ ការឆ្លងកាត់ ប្រកបដោយ សុវត្ថិភាព សម្រាប់ ការផ្តល់ ជំនួយ មនុស្សធម៌ និង នាំ ទៅ រក កិច្ចចរចា កាន់តែ ទូលំទូលាយ នោះ គាំទ្រ ដោយ សហរដ្ឋ អាមេរិក និង អារ៉ាប៊ី សាអូឌីត ។
គួរ បញ្ជាក់ ថា ជម្លោះ ដែល បាន ផ្ទុះ កាលពី ថ្ងៃទី ១៥ ខែមេសា បាន សម្លាប់ ជន ស៊ីវិល កើនឡើង ៧៣០ នាក់ និង បណ្តាលឲ្យ ជនជាតិ ស៊ូ ដង់ ១.៣លាន នាក់ ចាកចេញ ពី ផ្ទះ របស់ ពួកគេ ដោយ ភៀសខ្លួន ទៅ ក្រៅ ប្រទេស ឬ ទៅ កាន់ ផ្នែក ដែល មាន សុវត្ថិភាព ជាង នេះ ៕
ស្ថាប័ន រដ្ឋ និង ដៃគូ ពាក់ព័ន្ធ ប្រជុំ រៀបចំ លិខិត បទដ្ឋាន គតិយុត្ត មួយ កំណត់ អាយុ អប្បរបរមា ក្នុង ការទិញ គ្រឿងស្រវឹង នៅ កម្ពុជា
ជា ផ្នែក នៃ វគ្គ សន្ទនាទី ពីរ លទ្ធផល ការស្រាវជ្រាវ រួមគ្នា ដែល ធ្វើឡើង ដោយ AVI និង MM4A ស្តីពី ការយល់ឃើញ ទស្សនៈ របស់ យុវជន ក្នុង ប្រទេស កម្ពុជា លើ ការកំណត់ អាយុ ទិញ គ្រឿងស្រវឹង ស្រប ច្បាប់ អប្បបរមា LPA ត្រូវបាន ដាក់ បង្ហាញ និង ចែករំលែក ។ ឯកសារ ស្រាវជ្រាវ បង្ហាញ ថា ៨៥ ភាគរយ នៃ អ្នក ដែល បាន ស្ទង់ មតិ មាន គាំទ្រ ដល់ កិច្ច ចាប់ផ្តើម កំណត់ ច្បាប់ អាយុ ទិញ គ្រឿងស្រវឹង ស្រប ច្បាប់ LPA នៅក្នុង ប្រទេស កម្ពុជា និង ៧៣ ភាគរយ បញ្ជាក់ ថា អាយុ ស្រប ច្បាប់ គួរតែ ត្រូវបាន កំណត់ ចាប់ពី អាយុ ១៨ ឆ្នាំ ឡើង ។
ការឯកភាព គ្នា ក្នុង ចំណោម យុវជន កម្ពុជា ដែល ត្រូវបាន ស្ទង់ មតិ បាន ឆ្លុះបញ្ចាំង ពី ការព្រួយបារម្ភ លើ បញ្ហា នៃ ការសេព គ្រឿងស្រវឹង មិន ទាន់ គ្រប់ អាយុ ដោយ ប្រមាណ ៣៣ ភាគរយ បង្ហាញ ថា ពួកគេ សេព គ្រឿងស្រវឹង ឬ ភេសជ្ជៈ មាន ជាតិ អាកុល ក្រោម អាយុ ១៨ ឆ្នាំ និង មាន ករណី ខ្លះ ក្មេង ដល់ អាយុ ៦ឆ្នាំ ។ លើស ពី នេះ អត្រា ៦៣ ភាគរយ បង្ហាញ ថា ពួកគេ បាន ទិញ ភេសជ្ជៈ មាន ជាតិ អាកុល ក្នុង ដេប៉ូតូច ៗ និង កន្លែង លក់ រាយ ក្រៅ ពាណិជ្ជកម្ម ( ហាង លក់ ទំនិញ តូច និង ចាប់ មួយ ហួយ ) ។
ក្នុង ឱកាស នោះ លោក ផាន អូន បាន សង្កត់ធ្ងន់ ថា « ថ្ងៃ នេះ ជា សិក្ខាសាលា សិក្ខាសាលា ថ្ងៃ នេះ គឺជា ការ ចែករំលែក និង ពិភាក្សា ដ៏ អស្ចារ្យ នាំឲ្យ មាន ការពង្រឹង និង ឯកភាព យ៉ាង មុតមាំ ក្នុង ច្បាប់ អនុក្រឹត្យ អាយុ ទិញ គ្រឿ ស្រវឹង ស្រប ច្បាប់ អប្បបរមា LPA សម្រាប់ ប្រទេស កម្ពុជា ជាមួយ អាយុ ដ៏ សមស្រប មួយ ក្នុង ទម្រង់ ជា ឯកសារ ច្បាប់ » ។
អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្រ្កាប ការក្លែងបន្លំ « ក. ប. ប. » គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ យុទ្ធសាស្រ្ត នេះ ហើយ មាន ក្តី សោមនស្ស រីករាយ ក្នុង ការដឹកនាំ លើ សេចក្តីព្រាង អនុក្រឹត្យ រៀបចំ កិច្ចប្រជុំ ន ក្រសួង ដែល មាន ពាក់ព័ន្ធ និង សម្រេចបាន នូវ ព្រឹត្តិការណ៍ ដ៏ សំខាន់ នេះ ក្នុង ការការពារ អនីតិជន ពី ការសេព គ្រឿងស្រវឹង និង ភេសជ្ជៈ ដែល មាន ជាតិ អាកុល ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៦០ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៨២១ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៥៣៣ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២៨៨ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក អត់ ស្លាកលេខ និង ល្មើស សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ល្មើស ល្បឿន ខ្សែក្រវាត់ លើស ចំណុះ អត់ បណ្ណ បើកបរ និង ល្មើស សញ្ញា ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១៤លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៧ នាក់ របួស ចំនួន ១៦នាក់ ( របួស ធ្ងន់ ចំនួន ០៨ នាក់ ) ។ រយៈពេល ២៧ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ២១១ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១០៨ នាក់ របួស ២៦៦ នាក់ ( របួស ធ្ងន់ ១៦៣ នាក់ )៕
អាល្លឺម៉ង់ ទទួលបាន សំណើ ពី អ៊ុយក្រែន សុំ ឱ្យ ផ្គត់ផ្គង់ មីស៉ីល រយៈ ចម្ងាយ ឆ្ងាយ ដែល អាច បាញ់ បាន ដល់ ៥០០ គីឡូម៉ែត្រ
( ស្ទឹងត្រែង ) ៖ លោក ឡូយ សុផាត អ្នកតំណាងរាស្ដ្រ មណ្ឌល ស្ទឹងត្រែង នៅ ព្រឹក ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតីភាព បើក ការដ្ឋាន ជួសជុល ផ្លូវ ១ ខ្សែ មាន ប្រវែង ៤. ៦៨០ម៉ែត្រ ស្ថិត នៅក្នុង ភូមិ បាចុង សង្កាត់ ព្រះបាទ ក្រុង ស្ទឹងត្រែង ។
លោក សាយ កុសល អភិបាល ក្រុង ស្ទឹងត្រែង បាន លើកឡើង ថា ផ្លូវ មួយ ខ្សែ នេះ ជា មូលនិធិ របស់ សង្កាត់ ព្រះបាទ ហើយ ការជួសជុល ផ្អែក ទៅ លើ កត្តា ភូមិសាស្ត្រ សក្តានុពល ភាព ជាក់ស្តែង និង តម្រូវការបស់ ប្រជាពលរដ្ឋ សម្រាប់ ប្រើប្រាស់ ឆ្លងកាត់ ។ លោក បន្ដ ថា អាជ្ញាធរ ក្រុង និង ថ្នាក់ដឹកនាំ តែងតែ យកចិត្តទុកដាក់ គិត គូរ ចង្អុលបង្ហាញ គំនិត ទស្សនៈ វិស័យ ដើម្បីឲ្យ មូលដ្ឋាន មាន គោល គំនិត មើលឃើញ ពី សក្តានុពល ក្នុង មូលដ្ឋាន សម្រាប់ ការអភិវឌ្ឍ ។
លោក ឡូយ សុផាត ប្រធាន គណៈកម្មាការ ទី៣ នៃ រដ្ឋសភា និង ជា អ្នកតំណាងរាស្ត្រ មណ្ឌល ស្ទឹងត្រែង បាន ថ្លែង ថា ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន នាំមក នូវ សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ពិសេស សេដ្ឋកិច្ច កម្ពុជា មាន ការលូតលាស់ រីកចម្រើន ឥត ឈប់ឈរ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ ស្ពាន បាន លេច ជា រូបរាង ឡើង ស្ទើ គ្រប់ មូលដ្ឋាន ទាំងអស់ មាន ទាំង ផ្លូវ បេតុង ផ្លូវ កៅស៊ូ និង ផ្លូវ ក្រាល គ្រួស ក្រហម ។
លោក បាន អះអាង ថា ភាពរីកចម្រើន របស់ ប្រទេស កម្ពុជា នា ពេល បច្ចុប្បន្ន គឺ កើតឡើង ដោយ ការដឹកនាំ ប្រកបដោយ ភាពឈ្លាសវៃ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ជា អគ្គ មគ្គុទេសដ៍ ឆ្នើម បំផុត ដែល បាន នាំមក ជូន ជាតិ មាតុភូមិ នូវ សុខ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម ។
( ភ្នំពេញ ) ៖ សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា និង និយ័តករបរ ធន បាលកិច្ច បាន រៀបចំ ពិធី ចុះ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ស្តីពី « កិច្ចសហប្រតិបត្តិការ លើ ការលើកកម្ពស់ ការយល់ដឹង ជាសាធារណៈ និង ជំរុញ ការចូលរួម ក្នុង វិស័យ បរធន បាលកិច្ច នៅ កម្ពុជា » ដែល ប្រព្រឹត្ដទៅ នៅ ថ្ងៃទី ២៦ ខែឧសភា ឆ្នាំ ២០២៣ ។
ពិធី ចុះ អនុស្សរណៈ នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព អ្នក ឧកញ៉ា លី ហួរ ប្រធាន សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា លោក ម៉ី វ៉ាន់ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា អគ្គ លេខាធិការ នៃ អាជ្ញាធរ សេវា ហិរញ្ញវត្ថុ មិន មែន ធនាគារ លោក សុខ ដារ៉ា អគ្គ នាយក នៃ និយ័តករបរ ធន បាលកិច្ច ថ្នាក់ដឹកនាំ និង សមាជិក - សមាជិកា សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា ។
អ្នក ឧកញ៉ា លី ហួរ បាន គូសបញ្ជាក់ ថា ដោយ ហេតុ ថា ការអភិវឌ្ឍ វិស័យ បរធន បាលកិច្ច នៅ កម្ពុជា ជា របត់ ថ្មី មួយ នៃ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច កម្ពុជា និង កំពុង បោះជំហាន ជាលំដាប់ ដែល ធ្វើឲ្យ សាធារណៈ ជន និង វិស័យ ឯកជន មាន ការចាប់អារម្មណ៍ និង យកចិត្តទុកដាក់ ខ្លាំង ក្នុង ការស្វែងយល់ ក៏ ដូចជា ការចូលរួម ក្នុង វិស័យ បរធន បាលកិច្ច នេះ ផងដែរ ។ ក្នុង ក្រម ខណ្ឌ នៃ កិច្ចសហប្រតិបត្តិការ នេះ សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា នឹង សូម ចូលរួម ជាមួយនិយ័តករបរ ធន បាលកិច្ច ដូចត ទៅ៖
អ្នក ឧកញ៉ា លី ហួរ សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា បាន មាន វត្តមាន និង បំពេញ បេសកកម្ម របស់ ខ្លួន ជាង ៨ ឆ្នាំ មកហើយ និង បច្ចុប្បន្ន មាន សមាជិក សរុប ចំនួន ៧៤ ក្រុមហ៊ុន ដែល ជា អ្នក វិនិយោគ លើ វិស័យ អភិវឌ្ឍន៍ សំណង់ បុរី លំនៅឋាន និង ខុនដូរ ។
« យើង សង្ឃឹម ថា វិស័យ បរធន បាលកិច្ច នេះ គឺជា វិស័យ មួយ ដែល មាន សារៈសំខាន់ និង ជា តួអង្គ មួយ ដ៏ សំខាន់ សម្រាប់ ការអភិវឌ្ឍ វិស័យ អចលន ទ្រព្យ នៅ កម្ពុជា និង ជួយ ជំរុញ គាំទ្រ ដល់ វិស័យ អចលន ទ្រព្យ និង សេដ្ឋកិច្ច កម្ពុជា ឲ្យកាន់តែ រីកចម្រើន » ។ អ្នក ឧកញ៉ា លី ហួរ បាន បញ្ជាក់ ។
ក្នុង ឱកាស នោះ ក្នុង នាម ប្រធាន សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា អ្នក ឧកញ៉ា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ ថ្នាក់ គ្រប់គ្រង សមាជិក - សមាជិកា សមាគម ទាំងអស់ ដែល បាន ជឿជាក់ គាំទ្រ សមាគម កន្លងមក ហើយ អ្នកឧញ៉ា ក៏ សង្ឃឹម ថា សមាជិក - សមាជិកា ទាំងអស់ នៅតែ បន្ត គាំទ្រ សមាគម ជារៀងរហូត ៕ ទស្សនកិច្ច សិក្សា ក្រុមការងារ គម្រោង ថ្នាល ប្រព័ន្ធ ពាណិជ្ជកម្ម អេឡិចត្រូនិក (eWTP-Alibaba) នៅ ក្រុមហ៊ុន Alibaba ដើម្បី សម្របសម្រួល ភាព ជាដៃគូ និង ជំរុញ ការនាំចេញ ផលិតផល កម្ពុជា ទៅកាន់ ទីផ្សារ ចិន
បេសកកម្ម នេះ រួម ដំណើរ ដោយ លោក ឈរ ស៊ុន ហុង អនុ រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម . លោក ហុង ណារិត អនុ រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង បណ្ឌិត ហ៊ន ធារ៉ា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ប្រៃសណីយ៍ នៃ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ និង លោក ជា កុក ហុង ប្រធាន លេខាធិការដ្ឋាន មូលនិធិ អភិវឌ្ឍន៍ សហគ្រិន ភាព នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
ដំណើរទស្សនកិច្ច សិក្សា នេះ មាន គោលបំណង២ សំខាន់ គឺ៖ ( ១) ដើម្បី សិក្សា ឈ្វេងយល់ បន្ថែម អំពី ករណី ជាក់ស្តែង នៃ ប្រព័ន្ធ អេកូឡូស៊ី ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក របស់ ក្រុមហ៊ុន Alibaba និង ( ២) ពិភាក្សា បញ្ចប់ សេចក្តីព្រាង ឯកសារ អនុស្សារណៈ នៃ ការយោគយល់ គ្នា (MOU) រវាង ក្រសួង ពាណិជ្ជកម្ម និង ក្រុមហ៊ុន Alibaba ដើម្បី ជំរុញ កាលានុវត្តភាព នៃ ការនាំចេញ ផលិតផល កម្ពុជា . ការបណ្តុះបណ្តាល ជំនាញ . ការលើកកម្ពស់ វិស័យ ទេសចរណ៍ . និង កិច្ចសហប្រតិបត្តិការ នានា តាមរយៈ គម្រោង ភាពជាដៃគូ នៃ គម្រោង eWTP ។
ជា លទ្ធផល . ភាគី ទាំង ពីរ បាន ពិភាក្សា លម្អិត និង ឯកភាព លើ ខ្លឹមសារ សំខាន់ ៗ នៃ អនុស្សារណៈ នៃ ការយោគយល់ គ្នា ដែល នឹង ឈាន ទៅ ការចុះហត្ថលេខា នា ពេល ខ្លី ខាងមុខ ។
ចិន ថា នឹង ប្រឹងប្រែង ស្វែងរក ដំណោះស្រាយ នយោបាយ សម្រាប់ ជម្លោះ អ៊ុយក្រែន
( កៀវ ) ៖ អាជ្ញាធរ នៅក្នុង ប្រទេស អ៊ុយក្រែន បាន ឱ្យដឹង ថា ជន ស៊ីវិល ម្នាក់ បាន ស្លាប់ នៅក្នុង ការវាយប្រហារ ដោយ យន្ដហោះ ដ្រូន ទ្រង់ទ្រាយ ធំ មួយ របស់ រុស្ស៉ី លើ រដ្ឋធានី កៀវ នៅ ថ្ងៃអាទិត្យ ទី ២៨ ខែឧសភា នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP ។
គួរ បញ្ជាក់ ថា រុស្ស៉ី បាន បង្កើន ការវាយប្រហារ តាម ផ្លូវ អាកាស លើ បណ្ដា ទីក្រុង ជាច្រើន នៅ ទូទាំង ប្រទេស អ៊ុយក្រែន ក្នុង នោះ រួម មាន ទាំង ទីក្រុង កៀវ ចាប់តាំងពី ដើម ខែឧសភា មក ម្ល៉េះ ស្រប ពេល អ៊ុយក្រែន កំពុង ត្រៀមលក្ខណៈ បើក ប្រតិបត្តិការ វាយ បក ដណ្ដើម យក ទឹក របស់ ខ្លួន ដែល ទាហាន រុស្ស៉ី កំពុង កាន់កាប់ មកវិញ ៕
ប្រធាន សមាគម អ្នកលក់ ឱសថ កម្ពុជា នឹង ស្នើសុំ កិច្ចសហការ ជាមួយ អាជ្ញាធរ ចុះ ពិនិត្យ តាម ឱសថស្ថាន លុបបំបាត់ ផលិតផល ក្លែងក្លាយ និង ខូច គុណភាព
( ភ្នំពេញ ) ៖ លោក ឡី សុភាព ប្រធាន សមាគម សហព័ន្ធ វេជ្ជសាស្ត្រ ឱសថសាស្ត្រ និង ទន្តសាស្ត្រ កម្ពុជា និង ជា ប្រធាន សមាគម អ្នកលក់ ឱសថ កម្ពុជា បាន ប្រកាស ចូលរួម ជាមួយ អាជ្ញាធរ មាន សមត្ថកិច្ច ទាំងអស់ ចុះ ពិនិត្យ ធ្វើ យ៉ាងណា លុបបំបាត់ ឱសថ ក្លែងក្លាយ គ្មាន ច្បាប់ ទម្លាប់ និង ខូច គុណភាព លើ ទីផ្សារ ដើម្បី សុខ មាភាព សាធារណៈ ជូន អ្នកប្រើប្រាស់ ។
ការលើកឡើង របស់ លោក បណ្ឌិត ឡី សុភាព បែប នេះ ធ្វើឡើង ក្នុង ពិធី សំណេះសំណាល ជាមួយ វិនិយោគិន ពាណិជ្ជករ អាជីវករ ភ្នាក់ងារ ទីផ្សារ អ្នកជំនាញ វិជ្ជាជីវៈ គ្រប់គ្រង ទូទៅ វេជ្ជបណ្ឌិត ទន្ត ពេទ្យ គ្រូ ឱសថ បុរាណ ឱសថការី គិលានុបដ្ឋាក ឆ្មប អ្នកលក់ ឱសថ អ្នក បច្ចេកទេស មន្ទីរពិសោធន៍ អ្នកលក់ គ្រឿង សម្អាង ប្រតិបត្តិករ អាជីវកម្ម ម្ហូប អាហារ នា ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នៅ វិមាន ដឺព្រេ មៀ សេនធ័រ សែន សុខ ។
លោក ឡី សុភាព បាន លើកឡើ ថា « ខ្ញុំ នឹង ស្នើ ទៅ ក្រសួង ជំនាញ និង អង្គភាព មាន សមត្ថកិច្ច និង គណៈកម្មការ នានា ដើម្បី ចុះ ត្រួតពិនិត្យ និង ចាត់ វិធានការ ផ្លូវ ច្បាប់ ចំពោះ ក្រុមហ៊ុន ទាំងឡាយ ណា ផលិតផល ទាំងឡាយ ណា ដែល ខុស ច្បាប់ នឹង ចុះ ធ្វើការត្រួតពិនិត្យ ដោយ មិន បង្អង់ ដៃ ចាប់ពី ពេលនេះ ទៅ » ។
ជាមួយគ្នា នេះ ក្នុង នាម ជា ប្រធាន សមាគម អ្នកលក់ ឱសថ លោក ឡី សុភាព ចង់ ជំរុញ ដល់ កិច្ចការពារ សុខ មាភាព សាធារណៈ ជូន ប្រជាពលរដ្ឋ បង្ការ កុំ ឲ្យ មាន ប៉ះពាល់ អវិជ្ជមាន ទាំងឡាយ ដល់ អ្នកប្រើប្រាស់ ជាពិសេស កត្តា ដែល បង្ករ ឡើង ពី ឱសថ ក្លែងក្លាយ គ្មាន ច្បាប់ អនុញ្ញាត ខូស គុណភាព ជាដើម នេះ ពិតជា បាន បង្ករឲ្យ មាន ការប៉ះពាល់ ធ្ងន់ធ្ងរ ដល់ អាយុជីវិត ផងដែរ ។
ប្រធាន សមាគម អ្នកលក់ ឱសថ កម្ពុជា បាន បន្ត លើកឡើង ថា អ្នក ដែល នាំចូល ផលិតផល ខុស ច្បាប់ ឬ ផលិតផល ក្លែងក្លាយ ខូច គុណភាព នឹង ទទួលបាន ផលចំណេញ តែ សម្រាប់ បុគ្គល ទាំងនោះ ប៉ុណ្ណោះ ក៏ប៉ុន្តែ វា ពិតជា គ្រោះថ្នាក់ ដល់ អ្នកប្រើប្រាស់ ។
ក្នុង ន័យ នេះ លោក បាន បញ្ចាក់ ជាថ្មី ថា « ខ្ញុំ នឹង ធ្វើការ ជាមួយ អាជ្ញាធរដែនដី គ្រប់ ជាន់ ថ្នាក់ ត្រួតពិនិត្យ លើ កិច្ចការងារ នេះ ហើយ ខ្ញុំ នឹង ដាក់ ស្នើ ទៅ អង្គភាព ដែល ពាក់ព័ន្ធ ដោយ ធ្វើ ការត្រួតពិនិត្យ គ្រប់ មុខ ទំនិញ ដែល ខុស ច្បាប់ អនុឡោម ទៅតាម ច្បាប់ គ្រប់គ្រង់ ឱសថ និង កិច្ចការពារ អ្នកប្រើប្រាស់ ផ្សេង ៗ » ។
លោក ឡី សុភាព ក៏ បាន បញ្ជាក់ ថា មិន គួរ បន្ត ឲ្យ មាន ផលិតផល ក្លែងក្លាយ ហើយ ត្រូវតែ បោសសម្អាត ។ គួរតែ ចូលរួម ទាំងអស់ គ្នា ផ្ទៀងផ្ទាត់ ទាំងអស់ គ្នា ។
លោក ក៏ បាន ប្រៀបធៀប ថា កាលណា មាន ផលិតផល ក្លែងក្លាយ ខូច គុណភាព ចរាចរ លើ ទីផ្សារ ហើយ ធ្លាក់ ដល់ ដៃ អ្នកប្រើប្រាស់ ប្រៀប បាន យក លុយ ១ ដុល្លារ ទៅ ទិញ ថ្នាំ ពេទ្យ ហើយ អ្នកប្រើប្រាស់ ត្រូវ ត្រៀម លុយ ១ ដុល្លារ ទៀត សម្រាប់ មើល ជំងឺ អ៉ី ចឹង ដែរ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ប្រធាន សមាគម អ្នកលក់ ឱសថ កម្ពុជា បាន អំពាវនាវ ដល់ សមាជិក សមាជិកា ដែល ជា អ្នកលក់ ឱសថ គ្រឿង សម្អាង អាហារ បំប៉ន ទាំងអស់ គួរ បន្ត ការសិក្សា រៀនសូត្រ អំពី ច្បាប់ ទម្លាប់ របៀប របប អំពី ការទុកដាក់ ឬ អាច និយាយ បាន ថា ជា យន្តការអប់រំ បណ្តុះបណ្តា វិជ្ជាជីវៈ ទៅ លើ ជំនាញ ទុកដាក់ ឱសថ និង ការប្រើប្រាស់ ឱសថ នៅ តាម ឱសថស្ថាន ជាពិសេស អ្នកលក់ អាហារ បំប៉ន បន្ត នាំគ្នា រៀនសូត្រ ដោយ អាច ទាក់ទង ជាមួយ សមាគម អ្នកលក់ ឱសថ កម្ពុជា ដើម្បី ធ្វើ ការបណ្តុះបណ្តា ៕
ប៉ូលិស ហូឡង់ ឃាត់ខ្លួន សកម្មជន ការពារ បរិស្ថាន ច្រើន ជាង ១.៥០០ នាក់ ក្នុង បាតុកម្ម តវ៉ា
ក្រុម សកម្មជន ខាងលើ បាន តវ៉ា បិទ ផ្លូវ មួយ កន្លែង នៅ ចំ កណ្ដាល ទីក្រុង ឡាអេ កាលពី ថ្ងៃសៅរ៍ ទី ២៧ ខែឧសភា ដើម្បី បង្ហាញ ការតវ៉ា ចំពោះ ផែនការឧបត្ថម្ភ ធន របស់ រដ្ឋាភិបាល ហូឡង់ លើ វិស័យ ឥន្ធនៈ ផូស៊ីល ។ ប៉ូលិស ហូឡង់ ក៏ បាន ប្រើប្រាស់ កាណុង បាញ់ ទឹក បំបែក ហ្វូង បាតុករ ផងដែរ និង ឃាត់ខ្លួន មនុស្ស ១. ៥៧៩ នាក់ ហើយ ក្នុង ចំណោម ពួកគេ មាន ៤០ នាក់ នឹង ប្រឈមមុខ នឹង ការកាត់ទោស តាម ផ្លូវ ច្បាប់ ក្នុង នោះ រួម មាន ទាំង បទ ចោទប្រកាន់ បំផ្លិចបំផ្លាញ ទ្រព្យសម្បត្តិ សាធារណៈ ។
មិន ត្រូវ បើកបរ ក្រោម ឥទ្ធិពល នៃ គ្រឿងស្រវឹង ជាដាច់ខាត ! ស្លាប់ ៧នាក់ និង របួស ១៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៧ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ និង របួស ធ្ងន់ ស្រាល ១៦ នាក់ ។
កំណាត់ ផ្លូវ ជាតិ លេខ ៩៥ ប្រវែង ជាង ៣០ គីឡូម៉ែត្រ នៅ ស្រុក រវៀង ខេត្ត ព្រះវិហារ ត្រូវ ជួសជុល ឡើងវិញ សម្រួល ការធ្វើដំណើរ របស់ ពលរដ្ឋ
( ព្រះវិហារ ) ៖ កំណាត់ ផ្លូវ ជាតិ លេខ ៩៥ ប្រវែង ជាង ៣០ គីឡូម៉ែត្រ ចន្លោះ ពី គ.ម៤៩+០០០ ដល់ គ.ម ៧៩+ ៥០០ ( រ វៀង - ភ្នំ ដែក ) ដែល រង ការខូចខាត ចំនួន ៦០កន្លែង នា ពេល កន្លងមក ពេលនេះ ត្រូវបាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ ចាប់ផ្តើម ធ្វើ ការជួសជុល ឡើងវិញ ជាបន្ទាប់ ហើយ ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ និង ដឹកជញ្ជូន កសិផល ប្រជាពលរដ្ឋ មាន ភាពងាយស្រួល ។
លោក សំ លាង ទ្រី ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ បាន ឱ្យដឹង នៅ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ថា៖ « កំណាត់ ផ្លុវ ជាតិ លេខ ៩៥ នេះ បាន កសាងឡើង ក្នុង អំឡុង ឆ្នាំ ២០០៥ ជា កម្រោង ទ្រីប ដែល មាន ទទឹង ជាង ៥ម៉ែត្រ គិត មកដល់ ថ្ងៃ នេះ អាយុកាល ផ្លូវ នេះ គឺ ជិត ២០ ឆ្នាំ ហើយ » ។
លោក សំ លាង ទ្រី លើកឡើង ថា ក្រោម ការណែនាំ ពី លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សារធារណការ និង ដឹកជញ្ជូន និង លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ មន្ទីរ បាន យកចិត្តទុកដាក់ ជួសជុល ថែទាំ ផ្លូវ ដែល គ្រប់គ្រង ដោយ មន្ទីរ មិន ឱ្យ មាន គ្រលុក សំបុក មាន់ ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ។
លោក អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម ថែរក្សា ផ្លូវថ្នល់ ដែល ជា ប្រយោជន៍ ឱ្យ ការប្រើប្រាស់ បាន យូរអង្វែង ដោយ បញ្ឈប់ ការដឹកជញ្ជូន ទំនិញ គ្រប់ ប្រភេទ លើស ទម្ងន់ កំណត់ ៕ ប្រធាន CPP ខេត្ត កំពង់ធំ៖ យើង ត្រូវ ខិតខំ ប្រឹងប្រែង ទាំងអស់ គ្នា ដើម្បី ទទួលបាន ជ័យជំនះ ក្នុង ពេល បោះឆ្នោត ខាងមុខ
( កំពង់ធំ )៖ លោក ងួន រតនៈ ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ធំ បាន គូសបញ្ជាក់ នៅ ចំពោះ សមាជិក សមាជិកា ទាំងអស់ យើង មិន ត្រូវ ធ្វេសប្រហែស ទេ ត្រូវ ខិតខំ ប្រឹងប្រែង បន្ថែម ទៀត ដើម្បី ទទួលបាន ជ័យជំនះ ក្នុង ពេល បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ខាងមុខ ។
ការថ្លែង បែប នេះ របស់ លោក ងួន រតនៈ បាន ធ្វើឡើង នៅក្នុង ពិធី បិទ វគ្គ បណ្ដុះបណ្ដាល គ្រូ បង្គោល តាម បណ្ដា ក្រុង ស្រុក ទូទាំង ខេត្ត កំពង់ធំ រសៀល ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នៅ ស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ធំ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ប្រធាន គណៈកម្មាធិការ គណបក្ស កម្ពុជា ក្រុង ស្រុក និង គ្រូបង្គោល ព្រមទាំង យុវជន ឃុំ សង្កាត់ ទាំង ៨១ ។
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម បាន ច្រានចោល ចំពោះ ការផ្សព្វផ្សាយ ព័ត៌មាន ថា សមត្ថកិច្ច បាន ឃាត់ខ្លួន បុរស ឈ្មោះ ឌុច ភាស់ រស់ នៅ ភូមិ ព្រែក រំដេង ( គ) ឃុំ ព្រែក រំដេង ស្រុក ស្រីសន្ធ រ បញ្ជូន មក តុលាការ ខេត្ត កំពង់ចាម បន្ទាប់ពី បុរស នេះ បាន ចោទប្រកាន់ មក លើ អាជ្ញាធរ ពាក់ព័ន្ធ នឹង ការឈូសឆាយ ដី បឹង ចារ ស្ថិត នៅ ឃុំ ព្រែក រំដេង ស្រុក ស្រីសន្ធរ ។ នៅ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ ។
រដ្ឋបាល ខេត្ត កំពង់ចាម បាន គូសបញ្ជាក់ ថា៖ « ពាក់ព័ន្ធ នឹង ករណី នេះ រដ្ឋបាល ខេត្ត កំពង់ចាម សូម ធ្វើ ការបញ្ជាក់ ជូន សាធារណជន ជ្រាប ថា មក ទល់ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បុរស ឈ្មោះ ឌុច ភាស់ មិន មាន ការឃាត់ខ្លួន បញ្ជូន មក តុលាការ ខេត្ត កំពង់ចាម ដូច ការចោទប្រកាន់ ផ្សព្វផ្សាយ ព័ត៌មាន តាម បណ្តាញ សង្គម នានា នោះ ឡើយ ។ សមត្ថកិច្ច មិន បាន ធ្វើ ការចោទប្រកាន់ បុរស ឈ្មោះ ឌុច ភាស់ នោះ ទេ ដោយសារ បុរស រូប នេះ បាន ទទួលស្គាល់ កំហុស របស់ ខ្លួន និង បាន ធ្វើ ការសុំទោស ជា សាធារណ រួចហើយ » ។
( រតនគិរី ) ៖ លោក ថេង សាវឿន ប្រធាន សមាគម កសិករ នៅ ខេត្ត រតនគិរី និង មន្ដ្រី សម្របសម្រួល របស់ ខ្លួន ពីរ រូប ទៀត ឈ្មោះ ញ៉ឺល ភាព និង ឈ្មោះ ថាញ់ ហាច បាន សរសេរ លិខិត និង សារជា វីដេអូ ចេញ ពី ពន្ធនាគារ ដោយ អំពាវនាវ ដល់ សមាជិក សមាជិកា របស់ សមាគម ដែល កំពុង ប្រមូលផ្ដុំ គ្នា នៅ រាជធានី ភ្នំពេញ ក្នុង គោលដៅ ស្នើសុំ ឲ្យ មាន ការដោះលែង ពួកគេ នោះ សូម រំសាយ សកម្មភាព ហើយ ត្រូវ វិលត្រឡប់ ទៅ ផ្ទះ វិញ ។
លោក ថេង សាវឿន និង មន្ដ្រី សម្របសម្រួល ដែល កំពុង ជាប់ ពន្ធនាគារ បាន បញ្ជាក់ ដូច ៗ គ្នា ថា « ពួក ខ្ញុំ ទាំង ៣នាក់ សូម ធ្វើ ការអំពាវនាវ ដល់ សមាជិក សមាជិកា ដែល កំពុង ប្រមូលផ្ដុំ តវ៉ា នៅ រាជធានី ភ្នំពេញ សូម រំសាយ គ្នា និង វិលត្រឡប់ ទៅ ផ្ទះ នៅ តាម សហគមន៍ រៀង ខ្លួន វិញ ដើម្បី ចូលរួមចំណែក ថែរក្សា សណ្ដាប់ធ្នាប់ សាធារណៈ និង សន្ដិសុខ សង្គម ជាមួយ ការថែរក្សា សុខភាព បងប្អូន ផងដែរ » ។
លោក ថេង សាវឿន បាន លើកឡើង ទៀត ថា ពួកគេ ទាំង ៣នាក់ កំពុង ធ្វើ ការសហការ ដោះស្រាយ បញ្ហា ដែល កំពុង កើត មាន ឡើង ដោយ សន្ដិវិធី និង ផ្លូវ ច្បាប់ ជាមួយ ស្ថាប័ន តុលាការ ។ ផ្ទុយទៅវិញ ប្រសិនបើ សមាជិក សមាជិកា នៅ បន្ដ ប្រមូលផ្ដុំ គ្នា តវ៉ា ដែល ជា សកម្មភាព ខុស ច្បាប់ រឹតតែ ជា ការដាក់ បន្ទុក បន្ថែម ដល់ ពួកគេ ៕
ខាងក្រោម នេះ ជា វីដេអូ អំពាវនាវ របស់ ពួកគេ ទាំង ៣នា ក់៖
លោកស្រី យក់ សម្បត្តិ និង លោក ឃួង ស្រេង ចុះ ពិនិត្យ វឌ្ឍនភាព មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព ដែល ត្រៀម សម្ពោធ នៅ ខែ ក្រោយ នេះ ក្រោម អធិបតីភាព សម្ដេច តេជោ ហ៊ុន សែន
( ភ្នំពេញ ) ៖ លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្ដិ រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព និង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ចុះ ពិនិត្យ វឌ្ឍនភាព មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព ដែល គ្រោង នឹង សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ខែមិថុនា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី កម្ពុជា ។
បន្ទាប់ពី ចុះ ពិនិត្យ វឌ្ឍនភាព នៃ មន្ទីរពេទ្យ ហើយ លោកស្រី វេជ្ជបណ្ឌិត ក៏ បាន ដឹកនាំ កិច្ចប្រជុំ ដែល មាន ការចូលរួម ពី មន្ត្រី អាជ្ញាធរ និង ភាគី ពាក់ព័ន្ធ រួមទាំង តំណាង ពី ក្រសួង ប្រៃណីយ៍ និង ទូរគមនាគមន៍ ដើម្បី ពិភាក្សា ការងារ បន្ថែម ទៀត ឈាន ទៅ សម្រេច ការងារ សាង សាង់ និង រៀបចំ មន្ទីរពេទ្យ ឲ្យបាន រួចរាល់ ជា ស្ថាពរ ដើម្បី បើក ទទួល និង ផ្តល់ សេវា សុខភាព ជូន ប្រជាពលរដ្ឋ ជា ផ្លូវការ ។
ក្នុង កិច្ចពិភាក្សា ការងារ នេះ លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្ដិ បាន វាយតម្លៃ ថា មន្ទីរពេទ្យ បាន សាងសង់ រួចរាល់ ស្ទើរតែ ១០០ % ហើយ នៅតែ ការងារ បន្ទាប់បន្សំ ដូចជា ការសម្អាត ជាដើម ដែល ក្រុមហ៊ុន សាងសង់ ត្រូវ បន្ដ សហការ គ្នា ជាមួយ គណៈ គ្រូពេទ្យ ក៏ ដូចជា ក្រសួង សុខាភិបាល និង សាលា រាជធានី ភ្នំពេញ ដើម្បី ខិតខំ ប្រឹងប្រែង រួមគ្នា ឈាន ទៅ បញ្ចប់ ការសាងសង់ ជា ស្ថាពរ តាម ការគ្រោងទុក ។
ទន្ទឹម នឹង នោះ ដើម្បី ត្រៀម រាល់ បញ្ហា អ្វី មួយ កើត ជា យថាហេតុ ដូចជា បញ្ហា សុខភាព រាតត្បាត សកល ដែល ត្រូវ ទាមទារ មាន តែ ធនធាន មនុស្ស និង ឧបករណ៍ ប្រើប្រាស់ គ្រប់គ្រាន់ រួមទាំង អគ្គិសនី ផង នោះ ក្រែង មាន ករណី ដាច់ចន្ដរ អគ្គិសនី ឬ ភ្លើង រត់ មិន គ្រប់ លោកស្រី រដ្ឋលេខាធិការ ប្រចាំ ការ ក៏ បាន ពិភាក្សា នឹង ដាក់ បន្ថែម នូវ អគ្គិសនី ឱ្យ គ្រប់ ចំនួន សម្រាប់ ប្រើប្រាស់ ពិសេស នឹង ដាក់ បន្ថែម នូវ ថាមពល ពន្លឺ ព្រះអាទិត្យ ( ថាមពល សូឡា ) នៅក្នុង បរិមាណ មន្ទីរពេទ្យ ផងដែរ ។
ជាង នេះ ទៅ ទៀត លោកស្រី បាន ជំរុញ លើកទឹកចិត្ដ ដល់ ក្រុម គ្រូពេទ្យ ត្រូវតែ ខិតខំ បំពេញ កាតព្វកិច្ច របស់ ខ្លួន ប្រកបដោយ ទំនួល ខុសត្រូវ ខ្ពស់ ដើម្បី បម្រើ សេវា សុខភាព ជូន ប្រជាពលរដ្ឋ ឱ្យ ទាន់ ពេលវេលា និង ប្រសិទ្ធភាព ខ្ពស់ ។ លើស ពី នោះ ក្នុង ការត្រៀមលក្ខណៈ សម្រាប់ ផ្ដល់ សេវា សុខភាព ជូន កីឡាករ កីឡាការិនី ជម្រើសជាតិ ក្នុង ការប្រកួត កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ដែល រៀបចំឡើង ជា លើក ដំបូង នៅ កម្ពុជា នឹង មកដល់ នា សប្ដាហ៍ ក្រោយ នេះ ។
លោកស្រី វេជ្ជបណ្ឌិត ក៏ ធ្លាប់ បាន បញ្ជាក់ ផងដែរ ថា ក្នុង ឱកាស ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ព្រឹត្ដិការណ៍ កីឡា ស៊ីហ្គេម កន្លងទៅ ថ្មី ៗ នេះ មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព ក៏ បាន ពិនិត្យ ពិគ្រោះ និង ព្យាបាល សុខភាព ជូន កីឡាករ កីឡាការិនី ភ្ញៀវ ទេសចរណ៍ ជាតិ និង អន្ដរជាតិ រួមទាំង ប្រជាពលរដ្ឋ យើង តាម បណ្ដាល ខេត្ដ ដែល មក ទស្សនា នូវ ព្រឹត្ដិការណ៍ កីឡា ស៊ីហ្គេម នេះ ។
ឆ្លៀត ក្នុង ឳកាស នោះ លោកស្រី វេជ្ជបណ្ឌិត ក៏ បាន គូស រម្លឹក ថា មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព នេះ បាន សាងសង់ ឡើង ក្រោម គំនិត ផ្តួចផ្តើម របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដែល មាន ចំណុះ ជិត ១ម៉ឺន គ្រែ ដើម្បី ត្រៀមលក្ខណៈ ជាស្រេច ក្នុង ការទ្រទ្រង់ សភាពការណ៍ ការរាត ត្បាត ជំងឺ សកល ណាមួយ ដែល នឹង មាន កន្លែង សម្រាប់ បម្រើ សេវា ពិនិត្យ ព្យាបាល ជូន ប្រជាពលរដ្ឋ យើង ដោយ មិន ឱ្យ មាន ការព្រួយបារ ម្ដ ឡើយ ។
ក្នុង នាម លោកស្រី តំណាង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ក្រុមការងារ ប្រធាន ក្រុមប្រឹក្សាភិបាល និង សមាជិក ក្រុមប្រឹក្សាភិបាល គណៈ នាយក គ្រប់គ្រង មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព រួម ជាមួយ សាលា រាជធានី ភ្នំពេញ សូម គោរព ថ្លែងអំណរគុណ ដល់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី កម្ពុជា ដែល សម្ដេច តែងតែ យកចិត្ដទុកដាក់ ខ្ពស់ លើ សុខភាព ប្រជាពលរដ្ឋ ជា ចម្បង ពិសេស បាន គិតគូរ ខ្ពស់ ទៅដល់ កម្មករ - កម្ម ការិនី ដូចជា កីឡាករ កីឡាការិនី និង ប្រជាពលរដ្ឋ យើង ទូទាំង ប្រទេស ។
សូម ជម្រាប ថា មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព ត្រូវបាន ធ្វើ ពិធី ក្រុង ពាលី តាម បែប សាសនា សុំ ម្ចាស់ ទឹក ម្ចាស់ ដី ដើម្បី សាងសង់ កាលពី រសៀល ថ្ងៃទី ១៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ និង គ្រោង បញ្ចប់ ការសាងសង់ ជា ស្ថាពរ នៅ ចុង ខែឧសភា នឹង សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ខែមិថុនា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ។
( កំពង់ធំ )៖ លោក ស៊ុន ធន់ សមាជិក គណៈកម្មាធិការ ប្រតិបត្តិ អតីត គណបក្ស សង្គ្រោះ ជាតិ ខេត្ត កំពង់ធំ និង ជា អតីត សមាជិក ក្រុមប្រឹក្សា ខេត្ត បាន សុំ ចូលមក រួមរស់ ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
ក្រោយ ទទួលបាន ការស្នើសុំ ចូលរួម ជីវភាព នយោបាយ នៅ រសៀល ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ លោក ងួន រតនៈ ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ធំ បាន ប្រកាស ទទួលស្គាល់ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ធំ ។
លោក ស៊ុន ធន់ បាន អះអាង ថា ការសុំ ចូលរួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា គឺ មិន មាន អ្នកណា បង្ខិតបង្ខំ គាបសង្កត់ នោះ ទេ ជា សិទ្ធិ សេរីភាព របស់ បុគ្គល ម្នាក់ ៗ ។ លោក សូម អំពាវនាវ ដល់ សមាជិក សមាជិកា អតីត គណបក្ស សង្គ្រោះ ជាតិ ដទៃ ទៀត សូម មក ចូលរួម រស់ ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាប្រជាជន កម្ពុជា ព្រោះ មាន តែ គណបក្ស ប្រជាជន មួយ ទេ ដែល បាន អភិវឌ្ឍន៍ សង្គមជាតិ ឲ្យ មាន ការរីកចម្រើន និង មាន សុខ សន្តិភាព ៕
អ៉ីរ៉ាក់ ដាក់ចេញ នូវ គម្រោង សាងសង់ ផ្លូវ គោ គ និង ផ្លូវ ដែក តម្លៃ ១៧ពាន់ លាន ដុល្លារ ដើម្បី តភ្ជាប់ ជាមួយ តំបន់ អាស៉ី និង អឺរ៉ុប
( បាដាដ) ៖ អ៉ីរ៉ាក់ នៅ ថ្ងៃសៅរ៍ នេះ បាន ប្រកាស ពី ការចាប់ផ្តើម គម្រោង តម្លៃ ១៧ពាន់ លាន ដុល្លារ ដើម្បី តភ្ជាប់ កំពង់ផែ ទំនិញ សំខាន់ មួយ នៅឯ ឆ្នេរសមុទ្រ ភាគ ខាងត្បូង ប្រទេស ដោយ ការសាងសង់ ផ្លូវ ដែក និង ផ្លូវគោក ទៅកាន់ ព្រំដែន ជាមួយ ប្រទេស តួកគី ដែល ជា ចំណាត់ការ ថ្មី មួយ ដើម្បី ផ្លាស់ប្តូរ សេដ្ឋកិច្ច របស់ ប្រទេស បន្ទាប់ពី សង្គ្រាម និង វិបត្តិ ជាច្រើន ទសវត្សរ៍ មក នេះ ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសៅរ៍ ទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ ។
ការអភិវឌ្ឍ នេះ មាន គោលបំណង ភ្ជាប់ កំពង់ផែ ហ្រ្គេន ហ្វាវ (Grand Faw) ស្ថិត នៅ ភាគ ខាងត្បូង ប្រទេស អ៉ីរ៉ាក់ ដែល សម្បូរ ដោយ ប្រេង ទៅកាន់ តួកគី សំដៅ ប្រែក្លាយ អ៉ីរ៉ាក់ ទៅជា មជ្ឈមណ្ឌល ដឹកជញ្ជូន កាត់បន្ថយ ពេលវេលា ធ្វើដំណើរ រវាង តំបន់ អាស៊ី និង អឺរ៉ុប ។
រដ្ឋាភិបាល អ៉ីរ៉ាក់ បាន ប្រមើមើល ថា រថភ្លើង ល្បឿន លឿន នឹង អាច ដឹកជញ្ជូន ទំនិញ និង អ្នកដំណើរ ក្នុង ល្បឿន រហូតដល់ ៣០០ គីឡូម៉ែត្រ ក្នុង មួយ ម៉ោង ភ្ជាប់ ទៅ មជ្ឈមណ្ឌល ឧស្សាហកម្ម ក្នុង ស្រុក និង ថាមពល ដែល អាច រួមបញ្ចូល នូវ បំពង់ បង្ហូរ ប្រេង និង ឧស្ម័ន ។ ប្រសិនបើ ការងារ ចាប់ផ្តើម នៅ ដើម ឆ្នាំ ២០២៤ នោះ គម្រោង នេះ នឹង បញ្ចប់ នៅ ឆ្នាំ ២០២៩ ។
លោក ឧត្តមសេនីយ៍ ត្រី សាន សុខ សីហា អ្នកនាំពាក្យ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ឱ្យដឹង ថា ទាក់ទង ទៅ រថយន្ត ម៉ាក Prius ពាក់ ផ្លាកលេខ 2AA. 8891 ដែល បាន បើកបរ កៀម៉ូតូ ស្ត្រី ម្នាក់ បណ្ដាលឱ្យ ដួលរង របួស កាលពី វេលា ម៉ោង ៨: ១៩នាទី ថ្ងៃទី ២១ ខែឧសភា ឆ្នាំ ២០២៣ នៅ ចំណុច គល់ ស្ពាន ព្រះមុនីវង្ស ចាស់ ត្រើយ ខាងលិច សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន
ជាមួយគ្នា នោះ ដែរ សមត្ថកិច្ច បាន ធ្វើ ការណែនាំ អប់រំ ធ្វើ កិច្ចសន្យា ជាមួយ ម្ចាស់ រថយន្ត ដោយ បាន ណែនាំ ដល់ ជន បង្កឱ្យ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ និង បេីកបរ ដោយ ប្រុងប្រយ័ត្ន ចៀសវាង បង្ក គ្រោះថ្នាក់ ដល់ អ្នក ដ៏ទៃ ជា លេីក ទី២ទៀត ៕ ក្រុមការងារ CPP ចុះ មូលដ្ឋាន ក្រុង បាត់ដំបង បន្ត រួមគ្នា ចុះ សម្របសម្រួល ដោះស្រាយ និង សំណូមពរ ពលរដ្ឋ នៅ សង្កាត់ វត្ត គរ
( បាត់ដំបង ) ៖ នៅ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ ក្រុមការងារ លោក មាស វិរិទ្ធ អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ មូលដ្ឋាន ក្រុង បាត់ដំបង ប្រធាន ក្រុមការងារ ភូមិ វត្ត គរ និង ភូមិ ច្រាប ក្រសាំង សង្កាត់ វត្ត គរ ក្រុង បាត់ដំបង បាន អញ្ជេីញ ចុះ ពិនិត្យ សម្របសម្រួល ដោះស្រាយ សំណេី សំណូមពរ ជូន ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន សង្កាត់ វត្ត គរ ក្រុង បាត់ដំបង ។
ក្រុមការងារ នេះ ដឹកនាំ ដោយ លោក លឹម តុង ហួត អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង និង មាន កាអញ្ជើញ ចូលរួម ពី លោក សុខ ឈឿក មេភូមិ ផុន លោក លឹម ឆាង លោក គឹម សុមនៈ លោក ចែម សាកល លោក ហ៊ាន គឹម លុន និង អស់ លោក ក្រុមការងារ នៅ មូលដ្ឋាន ភូមិ នៃ សង្កាត់ វត្ត គរ ។
នា ឱកាស នោះ លោក លឹម តុង ហួត បាន ឱ្យដឹង ថា ក្នុង មូលដ្ឋាន សង្កាត់ វត្ត គរ ក្រុមការងារ ពី ថ្នាក់ ជាតិ ថ្នាក់ ក្រោម ជាតិ និង មូលដ្ឋាន បាន សហការ គ្នា ដើម្បី រួមគ្នា ពិនិត្យ គាំទ្រ ជំរុញ រាល់ សំណេី សំណូមពរ តម្រូវ ការចាំបាច់ របស់ មូលដ្ឋាន សំដៅ បម្រើ ឧត្តម ប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ។
លោក លឹម តុង ហួត បាន បន្ត ថា ការអភិវឌ្ឍ « មនុស្ស ទឹក ផ្លូវ ភ្លើង » របស់ រាជ រដ្ឋាភិបាល គឺជា គោលដៅ រួម ដែល ក្រុមការងារ យើង ទាំងអស់ គ្នា ត្រូវ រួមគ្នា កាន់ ដៃ គ្នា ឆ្ពោះទៅ ដើម្បី ភាពរីកចម្រើន នៅ មូលដ្ឋាន ។
ថ្លែង ក្នុង នាម លោក មាស វិរិទ្ធ . លោក លឹម តុង ហួត តំណាង ក្រុមការងារ បាន ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ អាជ្ញាធរ គ្រប់ ថ្នាក់ នៃ ខេត្ត បាត់ដំបង ក្រុមការងារ គ្រប់ ថ្នាក់ នៃ សង្កាត់ វត្ត គរ ដែល បាន សហការ ជួយ ដោះស្រាយ បញ្ហា សំណើ សំណូមពរ បម្រើ ដល់ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ស្តារ ប្រឡាយ បង្ហូរ ទឹក ដាក់ លូ កសាង ផ្លូវ ដាំ បង្គោល អគ្គិសនី ជា ដេីម និង អរគុណ ដល់ ប្រជាពលរដ្ឋ ដែល បាន ផ្តល់ កិច្ចសហការ ៕ លោក វង្ស ពិសេន បាន លើកឡើង ថា បើ គ្មាន សន្តិភាព គឺ គ្មាន អ្វី ៗ ទាំងអស់ ។
( ព្រៃវែង ) ៖ លោក វង្ស ពិសេន នា ព្រឹក ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ចុះ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា បក្ស នៅក្នុង ឃុំ កំពង់ ប្រាំង ស្រុក ពារាំង ខេត្ត ព្រៃវែង ។
ក្នុង ឱកាស នោះ លោក បាន អរគុណ ដល់ សមាជិក សមាជិកា របស់ បក្ស ទាំងអស់ ដែល បាន បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ឱ្យ ឈ្នះ លើសលុប នា ឆ្នាំ ២០២២ ។ លោក ក៏ បាន លើកឡើង ពី វីរភាព និង ការលះបង់ អាយុជីវិត របស់ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី បុព្វហេតុ រំដោះ ជាតិ ឱ្យ រួចផុត ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង បន្ត ស្វែងរក សន្តិភាព ជូន ប្រទេសជាតិ តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ ។
សម្តេច តេជោ បាន នាំ យើង ឱ្យ រួចផុត ពី ជ្រោះ មរណៈ នៃ ជំងឺ រាតត្បាត កូវីឌ - ១៩ ហើយ សម្តេច បាន ដឹកនាំ ប្រទេសជាតិ ឱ្យ មាន ការអភិវឌ្ឍ និង រីកចម្រើន រហូតដល់ សព្វ ថ្ងៃ ។ ជាពិសេស សម្តេច បាន លើក មុខមាត់ ប្រទេស កម្ពុជា ឱ្យ ពិភពលោក បាន កោតសរសើរ និង ស្ងប់ ស្ងែង តាមរយៈ ភាពជោគជ័យ ដ៏ ត្រចះត្រចង់ នៃ ការធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន ព្រឹត្តិការណ៍ កីឡា ស៊ីហ្គេម លើក ទី ៣២ កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ។
ចំពោះ គណបក្ស ភ្លើង ទៀន និង គណបក្ស មហាសាមគ្គី ជាតិ ខ្មែរ ដែល ត្រូវបាន គ.ជ. ប និង ក្រុមប្រឹក្សា ធម្មនុញ្ញ បដិសេដ មិន ចុះបញ្ជី ឈ្មោះ ចូលរួម បោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ មិន មែន ជា កំហុស របស់ គណបក្ស ប្រជាជន ទេ គឺជា កំហុស ផ្នែក រដ្ឋបាល របស់ គណបក្ស របស់ ខ្លួន ឯង ពិតប្រាកដ ដូច្នេះ ពួកគេ ត្រូវ ទទួល កំហុស ចំពោះ គណបក្ស ដោយ ខ្លួន ឯង ហើយ មិន ត្រូវ ទំលាក់ កំហុស មក លើ គណបក្ស ប្រជាជន កម្ពុជា ទេ ។
ទិវា សុខភាព ពេល មក រដូវ ! អង្គការ មូលនិធិ ថែទាំ សុខភាព អ្នកជំងឺ អេដស៍ បន្ត អំពាវនាវ ឱ្យ បញ្ឈប់ ការរើសអើង ការមក រដូវ
លោក វេជ្ជបណ្ឌិត ឈឹម សារ៉ាត់ បាន បន្ថែម ថា ការអប់រំ អំពី ការមក រដូវ ពិតជា អាច ផ្លាស់ប្តូរ អ្វី ៗ បាន គ្រប់ យ៉ាង វា គឺជា រឿង មិន អាច ទទួលយក បាន ទេ ប្រសិនបើ មនុស្ស ទទួលរង ការមើលងាយ មិន រាប់ រក និង រើសអើង ដោយ គ្រាន់តែ ពួកគេ មាន ការមក រដូវ ដែល ជាមុខងារ នៃ រាងកាយ ពី ធម្មជាតិ តែ ប៉ុណ្ណោះ ។
លោក បាន បន្ថែម ទៀត ថា ប្រហែល មួយ ភាគ បួន នៃ ចំនួន ប្រជាជន ពិភពលោក គឺ មាន ការមក រដូវ ប៉ុន្តែ ប្រជាជន ចំនួន ៥០០ លាន នាក់ នឹង អាច ប្រឈមមុខ នឹង កង្វះ លទ្ធភាព ក្នុង ការទទួលបាន នូវ ផលិតផល សុខភាព និង សម្ភារ : សុវត្ថិភាព ប្រកបដោយ អនាម័យ ពេល មក រដូវ ក៏ ដូចជា ការទទួលស្គាល់ ពី សហគមន៍ ។ ឧបសគ្គ ទាំងនេះ ហើយ ដែល ជា មូលហេតុ នាំឱ្យ ពួកគេ មាន សុខភាព ទ្រុឌទ្រោម រួច បោះបង់ ចោល សាលារៀន ឬ ការងារ រហូតដល់ 20% និង មាន ផល ប៉ះពាល់ អវិជ្ជមាន លើ សុខភាព ផ្លូវចិត្ត ទៀតផង ។
លោកស្រី បាន បន្ថែម ថា អ្នក មក រដូវ នៅ ប្រទេស ទាំងនេះ ភាគ ច្រើន ប្រឈមមុខ នឹង ហានិភ័យ ក្នុង ការទុកចោល មិន អើពើ ដោយសារ កង្វះខាត ផ្នែក សុខភាព និង សុវត្ថិភាព អំឡុង ពេល មក រដូវ របស់ ខ្លួន ។ ដូច្នេះ គឺ ដល់ ពេល ហើយ ដើម្បី បញ្ឈប់ ការរើសអើង លើ ការមក រដូវ ព្រមទាំង ធានា បាន ថា ផលិតផល និង សម្ភារ : សុវត្ថិភាព សម្រាប់ ប្រើប្រាស់ ពេល មក រដូវ អាច ងាយស្រួល រក បាន សម្រាប់ មនុស្ស គ្រប់ គ្នា ដោយ មិន មាន ភាព ខ្មាស អៀន ឬ ការរើសអើង ឡើយ ។
អង្គការ មូលនិធិ ថែទាំ សុខភាព អ្នកជំងឺ អេដស៍ (AHF) ជា អង្គការ ធ្វើការលើ ជំងឺ អេដស៍ កម្រិត ពិភពលោក ដ៏ ធំ បំផុត ។ បច្ចុប្បន្ន អង្គការ នេះ បាន ផ្តល់ សេវា ថែទាំ វេជ្ជសាស្រ្ត និង / ឬ សេវាកម្ម ដល់ អតិថិជន ជាង ១.៧ លាន នាក់ នៅក្នុង ៤៥ ប្រទេស ទូទាំង ពិភពលោក ដូចជា នៅ សហរដ្ឋ អាមេរិក អាហ្វ្រិក អាមេរិក ឡាទីន / ការា បៀន តំបន់ អាស៊ី / ប៉ាស៊ីហ្វិក និង អឺរ៉ុប ៕
រាជ រដ្ឋាភិបាល ចេញ អនុក្រឹត្យ ស្ដីពី ការប្រមូល និង បែងចែក ផលប្រយោជន៍ ពី ការប្រើប្រាស់ ធនធាន ពន្ធុ
អនុក្រឹត្យ នេះ កំណត់ អំពី បែបបទ នីតិវិធី និង លក្ខខណ្ឌ នៃ ការបែងចែក ផលប្រយោជន៍ ដោយ សមភាព និង សមធម៌ ពី ការប្រមូលធនធាន ពន្ធុ និស្សន្ទ វត្ថុ របស់ ធនធាន ពន្ធុ ឬ ចំណេះដឹង ជា ប្រពៃណី ពាក់ព័ន្ធ ក្នុង គោលបំណង បង្កើត នូវ យន្តការ ជាក់លាក់ ដើម្បី អនុវត្ត ពិធីសារ ណា ហ្គូយ៉ា នៃ អនុសញ្ញា សហ ប្រជាជាតិ ស្តីពី ជីវៈ ចម្រុះ សំដៅ រួមចំណែក ដល់ ការអភិរក្ស ជីវៈ ចម្រុះ និង ការប្រើប្រាស់ សមាស ភាគ ជីវៈ ចម្រុះ ដោយ និរន្តរភាព ។
អនុក្រឹត្យ នេះ មាន វិសាលភាព អនុវត្ត លើ ការប្រមូលធនធាន ពន្ធុ និស្សន្ទ វត្ថុ របស់ ធនធាន ពន្ធុ និង ចំណេះដឹង ជា ប្រពៃណី ពាក់ព័ន្ធ ដែល មាន ប្រភព ដើម ឬ កំពុង មាន វត្តមាន នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ឬ បាន ទទួលយក ដោយ ព្រះរាជាណាចក្រ កម្ពុជា ឬ ដោយ បុគ្គល ណា ម្នាក់ ដែល ស្ថិត ក្រោម យុត្តាធិការ របស់ ខ្លួន សម្រាប់ គោលបំណង នៃ ការប្រើប្រាស់ ធនធាន ពន្ធុ និង ចំណេះដឹង ជា ប្រពៃណី ពាក់ព័ន្ធ ។
អនុក្រឹត្យ នេះ មិន មាន វិសាលភាព អនុវត្ត លើ ការប្រមូលធនធាន ពន្ធុ និង និស្សន្ទ វត្ថុ របស់ ធនធាន ពន្ធុ ក្នុង គោលបំណង ប្រើប្រាស់ សម្រាប់ ការធ្វើជា ទំនិញ ដោយ ផ្ទាល់ ប៉ុន្តែ ការធ្វើជា ទំនិញ ដោយ ផ្ទាល់ នោះ មិន ត្រូវបាន ប្រើប្រាស់ ក្នុង គោលបំណង សិក្សា ស្រាវជ្រាវ ឬ អភិវឌ្ឍ ធនធាន ពន្ធុ ឡើយ ៕
បទ អត្ថាធិប្បាយ៖ ទីផ្សារ ធំ របស់ ចិន ដែល ទទួល ការអភិវឌ្ឍ ប្រកបដោយ គុណភាព ខ្ពស់ មិន គួរ ខកខាន បាន ឡើយ
ប្រការ នេះ ក៏ បាន បកស្រាយ ដែរ ថា ហេតុ អ្វី បានជា ទិន្នន័យ អំពី ការប្រើប្រាស់ ទុន បរទេស របស់ ប្រទេស ចិន បាន កើនឡើង ជា បន្តបន្ទាប់ ។ ពី ខែមករា ដល់ ខែមេសា ឆ្នាំ នេះ ទុន បរទេស ដែល ចិន បាន ប្រើប្រាស់ ដោយ ជាក់ស្តែង មាន ចំនួន ជិត ៥សែន លាន យាន់ ប្រាក់ ចិន ដែល បាន កើនឡើង ២.២ភាគរយ បើ ប្រៀបធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ មុន ក្នុង នោះ ការវិនិយោគ នៅ ប្រទេស ចិន របស់ ប្រទេស បារាំង អង់គ្លេស និង កូរ៉េ ខាងត្បូង ជាដើម បាន កើនឡើង ឆាប់ បង្គួរ ។
អ្វី ដែល គួរឱ្យ កត់សម្គាល់ នោះ គឺ ការវិនិយោគ របស់ សហគ្រាស បរទេស មិន ត្រឹមតែ បាន បង្កើត ហាង លក់ ទំនិញ ឬ បង្កើត រោងចក្រ ប៉ុណ្ណោះ ទេ សហគ្រាស បរទេស កាន់តែ ច្រើន ឡើង ៗ បាន បង្កើត មជ្ឈមណ្ឌល សិក្សា ស្រាវជ្រាវ និង អភិវឌ្ឍ នៅ ប្រទេស ចិន ។ អ្នកវិភាគ ខ្លះ បាន វែកញែក ថា អនាគត នៃ ទីផ្សារ ប្រាក់ ចំណេញ បរិយាកាស ច្នៃប្រឌិត ថ្មី និង និរន្តរភាព របស់ គោល នយោបាយ គឺជា ការគិតគូរ ដ៏ សំខាន់ របស់ សហគ្រាស ខណៈពេល ធ្វើ ការ វិនិយោគ ។
ក្រិត្យ ក្រម ទីផ្សារ បាន បញ្ជាក់ ថា តំបន់ ដែល អាច នាំមក នូវ ប្រាក់ ចំណេញ គឺជា ជម្រើស ដ៏ ល្អ របស់ សហគ្រាស ។ អ្នកផង ទាំងពួង ជឿជាក់ ថា ប្រទេស ចិន នឹង បន្ត ក្លាយជា ជម្រើសជា អាទិភាព របស់ ពាណិជ្ជករ បរទេស សម្រាប់ បណ្តាក់ទុន និង ប្រកប អាជីវកម្ម ៕
លោក ឃ្លាំង ហួត និង ភរិយា អញ្ជើញ សម្ពោធ ឆ្លង មហា កុដិ និង សមិទ្ធផល នានា ក្នុង វត្ត សាមគ្គី ក្បាល កោះ ខណ្ឌ ជ្រោយ ចង្វារ
( ភ្នំពេញ ) ៖ លោក ឃ្លាំង ហួត អភិបាល រង រាជធានី ភ្នំពេញ និង ភរិយា នៅ ព្រឹក ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៣ នេះ បាន ចូលរួម ជា អធិបតី ក្នុង ពិធី សម្ពោធ ឆ្លង មហា កុដិ និង សមិទ្ធផល នានា ក្នុង វត្ត សាមគ្គី ក្បាល កោះ ( ហៅ វត្ត យក្ស ) ស្ថិត នៅក្នុង ភូមិ ក្បាល កោះ សង្កាត់ កោះដាច់ ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឃ្លាំង ហួត បាន ចូលរួម ត្រេកអរ និង អបអរសាទរ ចំពោះ សមិទ្ធផល ជាច្រើន ដែល កំពុង កើតឡើង នៅ ពេល នេះ ក្នុង មូលដ្ឋាន ខណ្ឌ ជ្រោយ ចង្វារ ។ ដូច្នេះ សូម បន្ត ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី ធានា បាន នូវ សមិទ្ធផល ថ្មី ៗ បន្ថែម ទៀត ពិសេស ការធានា បាន នូវ សុខ សន្តិភាព ស្ថិរភាព និង សណ្តាប់ធ្នាប់ សាធារណៈ ល្អ ប្រសើរ បម្រើ ដល់ ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ ប្រជាពលរដ្ឋ ។
លោក ឃ្លាំង ហួត អះអាង ថា យើង ទាំងអស់ គ្នា មាន សំណាង ពីព្រោះ មាន សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល តែង គិតគូរ អំពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ក្នុង គ្រប់ ដំណាក់កាល ទាំងអស់ គិត តាំងពី សម័យ ស្រុក ទេស មាន សង្គ្រាម និង ធ្លាក់ ក្នុង ជម្លោះ បែកបាក់ ហើយ បាន បន្ត កសាង ស្តារ ប្រទេសជាតិ ពី បាត ដៃ ទទេ រហូត ឈាន ឆ្ពោះ មកដល់ ការអភិវឌ្ឍ ដូច សព្វ ថ្ងៃ ហើយ សម្តេច តេជោ តែង បាន ប្តេជ្ញាចិត្ត ថា ត្រូវ ខិតខំ ធ្វើ យ៉ាងណា ដើម្បី មិន ឲ្យ កូន ខ្មែរ ធ្លាក់ ទៅក្នុង រណ្តៅ នៃ ទុក្ខវេទនា ដូច កាល ជំនាន់ មុន ឡើយ ។
ជាមួយគ្នា នោះ លោក បាន ចូល ជា បច្ច័យ មួយចំនួន រួម មាន៖ ចូល បច្ច័យ សម្រាប់ កសាង ៨លាន រៀល . ប្រគេន ព្រះសង្ឃ ៨អង្គ សរុប ៤លាន រៀល . ឧបត្ថម្ភ ទូង ឈ្មោះ មហាសាមគ្គី សែន ជ័យ ២លាន រៀល . ពិធី រាប់ បាត្រ និង ចំណាយ ផ្សេង ៣លាន ២សែន រៀល និង សារុង ចំនួន ៤០០ ស្មើ ៣លាន ៦សែន ៤មុឺន រៀល ៕ អាជ្ញាធរ ខេត្ត កំពង់ចាម ចុះ ហ៊ុព័ទ្ធ កំណត់ ដី បឹង ចារ និង ដី រដ្ឋ បន្ទាប់ពី មន្ត្រី ជំនាញ ចុះ ស្រាវជ្រាវ រកឃើញ មាន ការឈូសឆាយ ប៉ះពាល់ ដី បឹង ខុស ច្បាប់
