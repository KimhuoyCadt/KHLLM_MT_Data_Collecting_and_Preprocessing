( ភ្នំពេញ ) ៖ សុខ សន្តិភាព ដែល រក បាន មក ដោយ លំបាក ក្រោម បាត ដៃ និង បញ្ញា ញាណ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង រយៈពេល ជាង ២០ ឆ្នាំ មក នេះ កំពុង នាំមក នូវ ការរីកចម្រើន លូតលាស់ យ៉ាង លឿន លយ សម្រាប់ ជាតិ កម្ពុជា ។ សមិទ្ធផល ហេដ្ឋារចនាសម្ព័ន្ធ ផ្នែក ដឹកជញ្ជូន ជាច្រើន ក៏ ត្រូវបាន លេចចេញ ជា រូបរាង ឡើង បន្ត បន្ទាប់បម្រើ ជា ឧត្តម ប្រយោជន៍ ដ៏ ថ្លៃថ្លា សម្រាប់ ប្រជាជាតិ កម្ពុជា ដែល ធ្លាប់ តែ កម្សត់ វេទនា កាលពី អតីតកាល នោះ ។
សមិទ្ធផល ជា ប្រវត្តិសាស្ត្រ ថ្មី មួយ ទៀត នៅលើ ទឹកដី កម្ពុជា គឺ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត នឹង ត្រូវ ចាប់ផ្តើម ដំណើរការ សាងសង់ នា ព្រឹក ថ្ងៃពុធ ៤រោច ខែ ជេស្ឋ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ០៧ ខែមិថុនា ឆ្នាំ ២០២៣ ។ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត ជា ផ្លូវ ល្បឿន លឿន ខ្សែ ទី២ ក្នុង ប្រទេស កម្ពុជា បន្ទាប់ពី ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ព្រះសីហនុ ដែល ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ កាលពី ឆ្នាំ ២០២២ នោះ ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ឱកាស បើក ការដ្ឋាន សាងសង់ ល្បឿន លឿន ភ្នំពេញ - បាវិត៖
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការអភិវឌ្ឍន៍ របស់ ជាតិ បាន ធ្វើឱ្យ សម្តេច វង្វេង ភូមិសាស្ត្រ មិន ត្រឹមតែ ក្នុង រាជធានី ភ្នំពេញ ប៉ុណ្ណោះ ទេ រួមទាំង នៅ តាម ទី ជនបទ ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ផ្លូវ ល្បឿន លឿន មាន អត្ថប្រយោជន៍ ខ្លាំង ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែអថា ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត គឺជា ការតភ្ជាប់ មួយ ដ៏ សំខាន់ រវាង កម្ពុជា និង វៀតណាម ព្រមទាំង អាស៊ាន ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន រំលឹក ថា គម្រោង ដើម ការសាងសង់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត ក៏ ភ្ជាប់ ជាមួយ ការសាងសង់ ស្ពាន ឆ្លង ទន្លេ មេគង្គ ក្រោម ផងដែរ ហើយ តម្រូវ ឱ្យ ពលរដ្ឋ បង់លុយ ពេល ឆ្លងកាត់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ដោយ មិន ចង់ឱ្យ ប្រជាពលរដ្ឋ ចំណាយ លុយ លើ ការឆ្លង ស្ពាន នោះ សម្តេច ក៏ សម្រេច បញ្ចេញ កញ្ចប់ ថវិកា ជាតិ សាងសង់ ស្ពាន ឱ្យ ពលរដ្ឋ ឆ្លង ដោយ មិន គិត ប្រាក់ តែម្តង ។
* សម្តេច តេជោ ហ៊ុន សែន ប្រាប់ ទូត ចិន ថា កុំ ឈប់ ផ្តល់ ជំនួយ ព្រោះ ឃើញ កម្ពុជា មាន លទ្ធភាព សាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ ច្រើន ។ សម្តេច តេជោ ក៏ ចង់ ឃើញ ចិន ផ្តល់ ជំនួយ ខ្លះ សម្រាប់ គម្រោង ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត ។
* សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ថា ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - សៀមរាប និង ប៉ោយប៉ែត នឹង ចុះហត្ថលេខា សិក្សា សាងសង់ នៅ ល្ងាច ថ្ងៃ នេះ ហើយ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កិច្ចសហប្រតិបត្តិការ គំនិត ផ្តួចផ្តើម ខ្សែក្រវាត់ និង ផ្លូវ របស់ ចិន បាន ផ្តល់ អត្ថប្រយោជន៍ ជាច្រើន ដល់ ប្រទេស កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គំនិត ផ្តួចផ្តើម ខ្សែក្រវាត់ និង ផ្លូវ មិន បាន រារាំង ដល់ កិច្ចអភិវឌ្ឍន៍ របស់ ប្រទេស ណាមួយ នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការសាងសង់ ផ្លូវ ល្បឿន លឿន មិន បាន ប្រើប្រាស់ លុយ កម្ចី នោះ ទេ គឺជា ការសាងសង់ ដោយ ប្រើ លុយ របស់ អ្នក វិនិយោគ ចិន ទាំងអស់ ។
* សម្តេច តេជោ ហ៊ុន សែន ប្រកាស យក ថ្ងៃទី៣០ ខែមិថុនា សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ផ្លូវ ក្រវាត់ ក្រុង ទី៣ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ធ្វើ ឯក អគ្គ រដ្ឋទូត ចិន នៅ កម្ពុជា គ្មាន ពេល ទំនេរ នោះ ទេ គឺ នឹង មាន ការ កម្មវិធី សម្រាប់ ការអភិវឌ្ឍន៍ ជាប់ ជានិច្ច ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រដ្ឋាភិបាល ចិន តែង គោរព ការសម្រេចចិត្ត របស់ កម្ពុជា លើ ការសាងសង់ សមិទ្ធផល ដែល ប្រើ កម្ចី ចិន ។ ចិន មិន ដែល បង្គាប់បញ្ជា ឱ្យ កម្ពុជា ធ្វើ តាម ខ្លួន នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច មាន សំណាង ដែល មាន រដ្ឋមន្ត្រី សេដ្ឋកិច្ច ពីរ រូប ហើយ មិន មែន ជា រដ្ឋមន្ត្រី ខ្ជិល ធ្លុះ នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន អរគុណ រដ្ឋាភិបាល ចិន ដែល បាន ជួយ សាងសង់ ពហុកីឡដ្ឋាន ជាតិ មរតក តេជោ ធ្វើឱ្យ កម្ពុជា មាន លទ្ធភាព រៀបចំ កម្មវិធី ប្រកួត ស៊ីហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម ។
* សម្តេច តេជោ ហ៊ុន សែន រំពឹង ថា មេដឹកនាំ ប្រទេស សមាជិក អាស៊ាន នឹង គាំទ្រ ទស្សនៈ សម្តេច ក្នុង ការធ្វើឱ្យ ព្រឹត្តិការណ៍ កីឡា របស់ អាស៊ាន កាន់តែ ល្បីល្បាញ ។
* សម្តេច តេជោ ហ៊ុន សែន ស្នើ វៀតណាម ចាប់ខ្លួន សម រង្ស៉ី ប្រសិនបើ ចូល ដល់ ដី វៀតណាម ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បើ ទណ្ឌិត សម រង្ស៉ី ចូល វៀតណាម ហើយ វៀតណាម មិន ចាប់ខ្លួន គឺ នឹង មាន បញ្ហា ជាមួយ កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ប្រជាពលរដ្ឋ ទៅ ចូលរួម បោះឆ្នោត នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ហើយ បោះឆ្នោត ជូន បក្ស ប្រជាជន កម្ពុជា ដើម្បី ជ្រើសយក ការរក្សា បាន សន្តិភាព និង ការអភិវឌ្ឍន៍ ។
ក្រសួង បញ្ជាក់ ថា ព្រះរាជាណាចក្រ កម្ពុជា នឹង ទទួល នូវ ឥទ្ធិពល ពី ប្រព័ន្ធ សម្ពាធ ទាប (ITCZ) ដែល អូសបន្លាយ លើ ប្រទេស ថៃ ឡាវ និង វៀតណាម គួបផ្សំ និង ខ្យល់ មូសុង និរតី ក្នុង កម្រិត ពី មធ្យម ទៅ បង្គួរ ។ លក្ខណៈ បែប នេះ នឹង ធ្វើ ឲ្យ៖
( ភ្នំពេញ ) ៖ សុខ សន្តិភាព ដែល រក បាន មក ដោយ លំបាក ក្រោម បាត ដៃ និង បញ្ញា ញាណ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង រយៈពេល ជាង ២០ ឆ្នាំ មក នេះ កំពុង នាំមក នូវ ការរីកចម្រើន លូតលាស់ យ៉ាង លឿន លយ សម្រាប់ ជាតិ កម្ពុជា ។ សមិទ្ធផល ហេដ្ឋារចនាសម្ព័ន្ធ ផ្នែក ដឹកជញ្ជូន ជាច្រើន ក៏ ត្រូវបាន លេចចេញ ជា រូបរាង ឡើង បន្ត បន្ទាប់បម្រើ ជា ឧត្តម ប្រយោជន៍ ដ៏ ថ្លៃថ្លា សម្រាប់ ប្រជាជាតិ កម្ពុជា ដែល ធ្លាប់ តែ កម្សត់ វេទនា កាលពី អតីតកាល នោះ ។
សមិទ្ធផល ជា ប្រវត្តិសាស្ត្រ ថ្មី មួយ ទៀត នៅលើ ទឹកដី កម្ពុជា គឺ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត នឹង ត្រូវ ចាប់ផ្តើម ដំណើរការ សាងសង់ នា ព្រឹក ថ្ងៃពុធ ៤រោច ខែ ជេស្ឋ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ០៧ ខែមិថុនា ឆ្នាំ ២០២៣ ស្អែក នេះ ហើយ ។ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត ជា ផ្លូវ ល្បឿន លឿន ខ្សែ ទី២ ក្នុង ប្រទេស កម្ពុជា បន្ទាប់ពី ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ព្រះសីហនុ ដែល ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ កាលពី ឆ្នាំ ២០២២ នោះ ។
ពិធី បើក ការដ្ឋាន សាងសង់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត នឹង ត្រូវ ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក វ៉ាង វិន ធៀន ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ នៅ កម្ពុជា ។ ក្រៅតែ ពី ការបើក ការដ្ឋាន សាងសង់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត ហើយ នោះ ក៏ ភ្ជាប់ ជាមួយ នូវ ការ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លងកាត់ ទន្លេ មេគង្គ និង ផ្លូវ តភ្ជាប់ ក្បាល ស្ពាន ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន គូស រំលេច ថា ពិធី បើក ការដ្ឋាន សាងសង់ សមិទ្ធផល ធំ សម្បើម នេះ ជា សក្ខីភាព បង្ហាញ ឱ្យ ឃើញ ថា កម្ពុជា កំពុងតែ មាន ការរីកចម្រើន លើ ការអភិវឌ្ឍ វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ ហើយ ជាក់ស្តែង ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ក្រុង បាវិត នេះ គឺជា ផ្លូវ ល្បឿន លឿន ទី២ របស់ កម្ពុជា បន្ទាប់ពី ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ក្រុង ព្រះសីហនុ ទើបតែ ត្រូវបាន បើក ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ក្នុង រយៈពេល ប្រមាណ ជាង កន្លះ ឆ្នាំ មក នេះ ។
រដ្ឋមន្ត្រី ដែល ជា សេនាធិការ ដ៏ ចំណាន របស់ សម្តេច តេជោ លើ វិស័យ ដឹកជញ្ជូន រូប នេះ បាន បន្ត ថា ផ្លូវ ល្បឿន លឿន នេះ គឺជា សមិទ្ធផល ថ្មី មួយ បន្ថែម ទៀត នៅក្នុង ចំណោម សមិទ្ធផល ជាតិ សំខាន់ ៗ ជាច្រើន នៅ ទូទាំង ប្រទេស ដែល បាន កើត ចេញពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ អគ្គ មគ្គុទ្ទេសក៍ ដ៏ ឆ្នើម របស់ កម្ពុជា គឺ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង ការចូលរួមចំណែក មិន អាច ខ្វះ បាន ពី បណ្តា ប្រទេស ជា មិត្ត របស់ កម្ពុជា និង ដៃគូ អភិវឌ្ឍន៍ នានា ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ឱ្យដឹង ថា គម្រោង សាងសង់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ក្រុង បាវិត មាន ប្រវែង សរុប ១៣៥.១០គីឡូម៉ែត្រ មាន ចំណុច ចាប់ផ្តើម ពី ឃុំ ថ្ម គរ ស្រុក ល្វាឯ ម ខេត្ត កណ្តាល ទៅដល់ សង្កាត់ ច្រក ម្ទេស ក្រុង បាវិត ខេត្ត ស្វាយរៀង ។ ផ្លូវ នេះ មាន ខ្សែ ផ្លូវ ឆ្លងកាត់ ខេត្ត កណ្តាល ប្រវែង ៤.១គីឡូម៉ែត្រ ខេត្ត ព្រៃវែង ប្រវែង ៧០. ៩គីឡូម៉ែត្រ និង ខេត្ត ស្វាយរៀង ប្រវែង ៦០.១ គីឡូម៉ែត្រ ។
គម្រោង នេះ នឹង ត្រូវ អនុវត្ត ការងារ បច្ចេកទេស សាងសង់ ដូច ខាងក្រោម៖
ពាក់ព័ន្ធ គម្រោង ចំណាយ លើ ការសាងសង់ វិញ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ឱ្យដឹង ថា ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ក្រុង បាវិត គ្រោង ចំណាយ ថវិកា វិនិយោគ សរុប ប្រមាណ ១. ៣៥ប៊ីលាន ដុល្លារ អាមេរិក ក្រោម ទម្រង់ វិនិយោគ សាងសង់ - ប្រតិបត្តិការ - ផ្ទេរ (BOT) ដែល មាន រយៈពេល ប្រតិបត្តិការ ចំនួន ៥០ ឆ្នាំ ក្នុង នោះ ២០ ភាគរយ ជា ទុន វិនិយោគ របស់ ក្រុមហ៊ុន សាជីវកម្ម ស្ពាន និង ថ្នល់ ចិន និង ៨០ ភាគរយ ជា ប្រាក់ កម្ចី របស់ ក្រុមហ៊ុន ។
ដោយឡែក ស្ពាន ឆ្លងកាត់ ទន្លេ មេគង្គ គ្រោង ចំណាយ ថវិកា សរុប ប្រមាណ ២៣២. ៥៨ លាន ដុល្លារ អាមេរិក ដែល ជា ថវិកា វិនិយោគ របស់ រាជ រដ្ឋាភិបាល រួម ជាមួយនឹង ថវិកា បដិភាគ សម្រាប់ ការបោសសម្អាត គ្រាប់ មីន យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ និង ពន្ធ អាករ ផ្សេង ៗ ។ គម្រោង ទាំង ពីរ នេះ នឹង អនុវត្ត ការសាងសង់ ដោយ ក្រុមហ៊ុន សាជីវកម្ម ស្ពាន និង ថ្នល់ ចិន (CRBC) ប្រើប្រាស់ រយៈពេល សាងសង់ ចំនួន ៤៨ ខែ គ្រោង នឹង បញ្ចប់ នៅក្នុង អំឡុង ឆ្នាំ ២០២៧ ។
លោក ស៊ុន ចាន់ថុល ចាត់ទុក ការសម្រេចបាន នូវ សមិទ្ធផល ជាតិ ធំ ៗ និង សំខាន់ ៗ ជា ប្រវត្តិសាស្រ្ត នៅ ទូទាំង ប្រទេស នា ពេល បច្ចុប្បន្ន នេះ កើតឡើង ដោយសារ ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត ឈ្លាសវៃ និង ប៉ិនប្រសប់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល ជា អគ្គ មគ្គុទ្ទេសក៍ ដ៏ ឆ្នើម បំផុត និង ជា បិតា ស្ថាបនិក សន្តិភាព របស់ កម្ពុជា ៕
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ៦ ខែមិថុនា ឆ្នាំ ២០២៣ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃអង្គារ ទី៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ ក្រុម យុវជន គណបក្ស ភ្លើង ទៀន នៅ ស្រុក កំរៀង ខេត្ត បាត់ដំបង នៅ ថ្ងៃទី ០៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ បាន ចេញ វីដេអូ ស្នើសុំ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ជា ប្រធាន ដែល អាច ដឹកនាំ ប្រទេស ឱ្យ រីកចម្រើន គ្រប់ វិស័យ ។
( ស្ទឹងត្រែង ) ៖ ផ្លូវ បេតុង អាមេ១ ខ្សែ ស្ថិត នៅ ភូមិ ហាង ខូសួ សង្កាត់ សាមគ្គី ក្រុង ស្ទឹងត្រែង ទើប សាងសង់ រួច នា ពេល ថ្មី ៗ នេះ បាន ដាក់ សម្ពោធ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ថ្ងៃទី ០៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ ។
ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ផ្លូវ បេតុង នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ឡូយ សុផាត អ្នកតំណាងរាស្រ្ត មណ្ឌល ស្ទឹងត្រែង . លោក ឈាង ឡាក់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ស្ទឹងត្រែង និង មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ គណៈ អភិបាល ក្រុង ក្រុមប្រឹក្សា សង្កាត់ សាមគ្គី និង ប្រជាពលរដ្ឋ ប្រមាណ ៨០០ នាក់ ។
នា ឱកាស នោះ ដែរ លោក ឡួយ សុផាត បាន ពាំនាំ បណ្តាំ សាកសួរ សុខទុក្ខ ពី សម្តេច ហេង សំរិន . សម្តេច តេជោ ហ៊ុន សែន ដែល សម្តេច តែង មាន ការនឹក រឭក ពី សុខ ទុក្ខ របស់ បងប្អូន ប្រជាពលរដ្ឋ របស់ លោក គ្រប់ ទីកន្លែង ទាំង ទីក្រុង និង ជន បទ ដូច ៗ គ្នា ដែល ធ្លាប់ កម្សត់ កម្រ ជួប ការលំបាក វេទនា យ៉ាង ធ្ងន់ធ្ងរ ជាមួយគ្នា ក្នុង ពេល កន្លងមក ។
លោក ឡូយ សុផាត បាន បន្ត ថា ផ្លូវ បេតុង ១ ខ្សែ នេះ ពិតជា បាន ផ្តល់ នូវ សារៈប្រយោជន៍ ជាច្រើន សម្រាប់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ ភូមិ ហាង ខូសួន ក៏ដូចជា ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន សង្កាត់ ទាំងមូល ដូច ជា៖ សិស្សានុសិស្ស ងាយស្រួល ធ្វើដំណើរ ទៅ រៀនសូត្រ កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ការរអិល ដួល ដោយ យថាហេតុ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ប្រកប អាជីវកម្ម ផ្សេង ៗ និង ការដឹក ផលិតផល កសិកម្ម នានា ទៅ លក់ នៅ ទីផ្សារ ។ល ។
សូម ស្តាប់ ការវិភាគ របស់ ក្រុម អ្នកស្រាវជ្រាវ វ័យ ក្មេង ដូចត ទៅ៖
ទីក្រុង មូស្គូ និង កៀវ បាន ស្តីបន្ទោស គ្នា ទៅ វិញ ទៅ មក ចំពោះ ការខូចខាត ទំនប់ វារី អគ្គិសនី Kakhovka ហើយ បាន ផ្តល់ ទស្សនៈ ផ្ទុយ គ្នា អំពី ស្ថានភាព សុវត្ថិភាព នៅ រោងចក្រ នុយក្លេអ៊ែរ ដែល កាន់កាប់ ដោយ រុស្ស៊ី ដែល មាន ចម្ងាយ ប្រហែល ១៥០ គីឡូម៉ែត្រ ។
ប្រធាន ទីភ្នាក់ងារ នេះ លោក Rafael Grossi បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ទៅកាន់ ក្រុមប្រឹក្សា អភិបាល ដែល មាន សមាជិក ៣៥ រូប របស់ ទីភ្នាក់ងារ ខ្លួន ថា ការខូចខាត ទំនប់ បាន នាំឱ្យ មាន ការថយចុះ កម្ពស់ នៃ អាង ស្តុក ទឹក ប្រហែល ៥សង់ទីម៉ែត្រ ក្នុង មួយ ម៉ោង ។
លោក បាន បន្ថែម ថា កម្មករ រោងចក្រ កំពុង « ព្យាយាម អស់ ពី សមត្ថភាព ដើម្បី បូម ទឹក ឱ្យ បាន ច្រើន តាម តែ អាច ធ្វើ ទៅ បាន ចូល ទៅក្នុង បំពង់ ទឹក ត្រជាក់ និង ប្រព័ន្ធ ពាក់ព័ន្ធ » ខណៈ ដែល ការផ្គត់ផ្គង់ ដល់ « អ្នកប្រើប្រាស់ ទឹក ដែល មិន សំខាន់ » នៅ រោងចក្រ ត្រូវបាន ផ្អាក ។
សមាគម មូលនិធិ សម្ដេច តេជោ ដើម្បី អភិវឌ្ឍន៍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា ចេញ លិខិត ថ្លែងអំណរគុណ ឧកញ៉ា ស៉ីន ឃីម និង លោកជំទាវ ដែល ចូលរួម បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ដើម្បី រួមចំណែក អភិវឌ្ឍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ សមាគម មូលនិធិ សម្ដេច តេជោ ដើម្បី អភិវឌ្ឍន៍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា បាន ចេញ លិខិត ថ្លែងអំណរគុណ ជូន ចំពោះ លោក ឧកញ៉ា ស៉ីន ឃីម និង លោកជំទាវ ដែល ចូលរួម បរិច្ចាគ ថវិកា ចំនួន ១ម៉ឺន ដុល្លារ ជូន សមាគម ដើម្បី រួមចំណែក ក្នុង ការអភិវឌ្ឍ សហគ្រាស ធុន តូច និង មធ្យម នៅ កម្ពុជា ស្រប តាម គោល នយោបាយ និង យុទ្ធសាស្ត្រ ចតុកោណ របស់ រាជ រដ្ឋាភិបាល ៕
ខាងក្រោម នេះ ជា លិខិត ថ្លែងអំណរគុណ ជូន ចំពោះ លោក ឧកញ៉ា ស៉ីន ឃីម និង លោកជំទា វ៖
លោក ឃួង ស្រេង អំពាវនាវ ប្រជាពលរដ្ឋ រៀបចំ ផែនការ គ្រួសារ ឱ្យ បាន ច្បាស់លាស់ និង ពិចារណា ឱ្យ បាន ល្អិតល្អន់ មុននឹង យក ប្លង់ ដី ទៅ ដាក់ បញ្ចាំ នៅ ធនាគារ
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ រៀបចំ ផែនការ គ្រួសារ ឱ្យ បាន ច្បាស់លាស់ ពោលគឺ ត្រូវ គិត ពិចារណា ឱ្យ បាន ល្អិតល្អន់ មុននឹង យក វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថុ ( ប្លង់ ដី ) ទៅ ដាក់ នៅ ធនាគារ ។ បើ មិន ដូច្នេះ ទេ បងប្អូន នឹង ជួប បញ្ហា ធ្ងន់ធ្ងរ ក្នុង ជីវភាព រស់ នៅ ជាមួយនឹង បំណុល ធនាគារ ។
ការអំពាវ បែប នេះ របស់ លោក ឃួង ស្រេង បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ០៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ ខណៈ ដែល លោក បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពី ធី ចែក វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថុ ជូន ប្រជាពលរដ្ឋ រស់ សង្កាត់ ពន្សាំង ខណ្ឌ ព្រែក ព្នៅ ជាង ១០០០ប័ណ្ណ នៅក្នុង បរិវេណ សាលា សង្កាត់ ពន្សាំង ខណ្ឌ ព្រែក ព្នៅ ។
លោក ឃួង ស្រេង បាន លើកឡើង ថា ការចែក វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថុ ជូន ប្រជាពលរដ្ឋ នៅ នា ពេលនេះ គឺជា សមិទ្ធផល ថ្មី មួយ ទៀត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ និង ជា អគ្គ មគ្គុទ្ទេស៍ ដ៏ ឆ្នើម របស់ យើង សំដៅ ផ្តល់ កម្មសិទ្ធិ ស្រប ច្បាប់ ជូន ប្រជាពលរដ្ឋ និង កាត់ បាន នូវ ភាព ក្រីក្រ ។
ជនរងគ្រោះ ជា ជនជាតិ កូរ៉េ កំពុង ដើរ តាម ផ្លូវ ស្រាប់តែ ត្រូវបាន ជនសង្ស័យ ម្នាក់ ដើរ មក ជិត ហើយ ធ្វើ សកម្មភាព ឆក់ យក ទូរស័ព្ទដៃ មួយ គ្រឿង ហើយ រត់ ឡើង ម៉ូតូ ដែល មាន គ្នា ០២ នាក់ ( ប្រុស ០១ ស្រី ០១) ជិះ គេចខ្លួន តែ ម្តង តែ ដោយ កម្លាំង មូលដ្ឋាន អាវុធហត្ថ ខណ្ឌ ដូនពេញ កំពុង ល្បាត ក្បែរ នោះ ដែរ បាន ឃើញ ក៏ បាន ធ្វើ ការប្រដេញ រហូតដល់ ចំណុច ផ្លូវ ២២២ កែង ផ្លូវ ៥៥ សង្កាត់ បឹង រាំង ខណ្ឌ ដូនពេញ ក៏ ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ទាំង ០៣ នាក់ តែម្តង ។
ក្រោយពេល ស្តាប់ ចម្លើយ ជនសង្ស័យ សាន រីដា ( ហៅ ដឺ ) បាន សារភាព ឲ្យដឹង ថា ខ្លួន គេ ពិតជា បាន ធ្វើ សកម្មភាព ឆក់ ទូរស័ព្ទ ដៃ ពី ជនរងគ្រោះ ជា បរទេស ដែល កំពុង ដើរ លើ ចិញ្ចើម ពិត មែន ដោយ ខ្លួន បាន ប្រើប្រាស់ ថ្នាំ ញៀន អស់ រយៈពេល ០៥ ឆ្នាំ មកហើយ ។ រីឯ ជនសង្ស័យ ឈ្មោះ ទក ពិសិដ្ឋ បាន សារភាព ឲ្យដឹង ដែរ ថា កន្លងមក ខ្លួន ក៏ ធ្លាប់ ជាប់ ពន្ធនាគារ ព្រៃសរយៈពេល ០៥ ឆ្នាំ ពី បទ វាយ ប្លន់ ជន បរទេស ផងដែរ ។
ជនសង្ស័យ ទាំង ០៣ នាក់ ត្រូវបាន កម្លាំង មូលដ្ឋាន អាវុធហត្ថ ខណ្ឌ ដូនពេញ ប្រគល់ឲ្យ ជំនាញ ការិយាល័យ ប្រឆាំង បទល្មើស ព្រហ្មទណ្ឌ នៃ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕
ជាមួយគ្នា នេះ បុរស ជនជាតិ ជប៉ុន ក៏ បាន ដាក់ ពាក្យ បណ្តឹង ទៅកាន់ ការិយាល័យ ព្រហ្មទណ្ឌ នៃ ស្នងការដ្ឋាន ស្រាវជ្រាវ និង បង្ក្រាប បទល្មើស កងរាជអាវុធហត្ថ លើ ផ្ទៃ ហើយ ត្រូវបាន មន្រ្តី ជំនាញ អាវុធហត្ថ ចេញ លិខិត កោះ អញ្ជើញ ឈ្មោះ ថោង សុខ ខេង និង បក្ខពួក ចូលទៅ បំភ្លឺ នៅ ថ្ងៃទី ៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ ផងដែរ ។
លោក ជូអេ ហ្កូតូ បាន ប្រាប់ អ្នកសារព័ត៌មាន ថា ពី ដើម លោក មក លេង ប្រទេស កម្ពុជា ធម្មតា ទេ តែ ដោយ ការស្រលាញ់ ចូលចិត្ត ទឹកដី កម្ពុជា លោក ក៏ សម្រេចចិត្ត ដាក់ ទុន រកស៊ី លើ មុខរបរ ជាច្រើន ក្នុង នោះ មាន គំរោង កសិឧស្សាហកម្ម នៅ ខេត្ត កំពង់ស្ពឺ មួយ នេះ ផងដែរ ប៉ុន្តែ ត្រូវ ចាញ់បោក ក្រុម លោកស្រី ថោង សុខ ខេង បែប នេះ ។
ក្រោយពី លក់ ដី ឲ្យ ជនជាតិ ជប៉ុន រួច . លោកស្រី ថោង សុខ ខេង និង បក្ខពួក រួម មាន លោក ប៉ែន សេរី មុន្នី . លោក ស៊ឺ សុងហ៊ី ជា អ្នកបកប្រែ ភាសា ជប៉ុន និង លោក អ៊ុន សុផល ជា សាក្សី បាន បញ្ចុះបញ្ចូល ឲ្យ លោក ជូអេ ហ្កូតូ ជួល ដី ឲ្យ ខ្លួន វិញ ក្នុង គោលបំណង ធ្វើ ចំការដាំដុះ អំពៅ ជា លក្ខណៈ ឧស្សាហកម្ម រយៈពេល ៥ឆ្នាំ គិត ចាប់ពី ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០១៤ ដល់ ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០១៩ ជា ថ្ងៃ បញ្ចប់ កិច្ចសន្យា ដាំ អំពៅ ។
លោកស្រី ថោង សុខ ខេង លោក ប៉ែន សេរី មុន្នី ជា មន្រ្តី យោធា លោក ស៊ឺ សុងហ៊ី ជា អ្នកបកប្រែ ភាសា ជប៉ុន លោក អ៊ុន សុផល ជា សាក្សី កិច្ចព្រមព្រៀង សន្តិសុខ នៃ ប្រទេស ដែន កោះ ប៉ាស៉ី ហ្វិក វ៉ា នូអា ទូ និង អូស្ត្រាលី អាច សម្រេចបាន នៅ ចុង ឆ្នាំ ២០២៣ នេះ
( ស៉ីដនី ) ៖ វ៉ា នូអា ទូ (Vanuatu) ដែល ជា ប្រទេស ដី កោះ មួយ ក្នុង តំបន់ ប៉ាស៊ីហ្វិក បាន ឲ្យដឹង នៅ ថ្ងៃអង្គារ នេះ ថា កិច្ចព្រមព្រៀង សន្តិសុខ ជាមួយ អូស្ត្រាលី នឹង ត្រូវ ដាក់ ទៅកាន់ សភា មុន ដំណាច់ ឆ្នាំ ២០២៣ នេះ ខណៈ ដែល ការព្រួយបារម្ភ អំពី ឥទ្ធិពល ចិន នៅក្នុង តំបន់ កំពុង លេចឡើង ក្នុង ប្រទេស ជិតខាង គឺ ប្រទេស ប៉ា ពូអាស៉ី នូវែលហ្គីណេ បាន ពន្យារ ពេល ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ស្រដៀង គ្នា នេះ ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃអង្គារ ទី៦ ខែមិថុនា ឆ្នាំ ២០២៣ ។
ក្រសួង អប់រំ ប្រគល់ រង្វាន់ ដល់ ក្រុម ជយលាភី ៣ក្រុម ដែល បាន ចូលរួម ប្រកួត វីដេអូ ខ្លី ស្ដីពី « ការអប់រំ ឌីជីថល នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ក្រុមការងារ នៃ មជ្ឈមណ្ឌល សម្រាប់ ការអប់រំ ឌីជីថល និង ការអប់រំ ពី ចម្ងាយ និង មូលនិធិ ស្រាវជ្រាវ គំនិត ច្នៃប្រឌិត និង ន វានុវត្តន៍ នៃ ក្រសួង អប់រំ យុវជន និង កីឡា នា ថ្ងៃទី ០៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ បាន ប្រគល់ រង្វាន់ ដល់ ក្រុម ជយលាភី ទាំង ៣ក្រុម ដែល បាន ចូលរួម ការប្រកួត វីដេអូ ខ្លី ស្ដីពី « ការអប់រំ ឌីជីថល នៅ កម្ពុជា » ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក បណ្ឌិត សាន វឌ្ឍនា អនុ រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា និង ជា ប្រធាន លេខាធិការដ្ឋាន មជ្ឈមណ្ឌល សម្រាប់ ការអប់រំ ឌីជីថល និង ការអប់រំ ពី ចម្ងាយ និង មាន អ្នកចូលរួម ជាច្រើន រូប ទៀត ផងដែរ ។
លើកឡើង នា ឱកាស នោះ បណ្ឌិត សាន វឌ្ឍនា ក៏ បាន ចូលរួម អបអរសាទរ ក្រុម ជ័យលាភី និង កោតសរសើរ ចំពោះ ការចូលរួមចំណែក ចូលរួម ពីសំណាក់ ក្រុម ដែល បាន ទទួល ជ័យលាភី និង បាន លើកទឹកចិត្ត ប្អូន ៗ សិស្សានុសិស្ស ទាំងអស់ ឱ្យ បណ្ដុះ ក្ដី ស្រឡាញ់ ចំពោះ ការអប់រំ ឌីជីថល និង ចេះ ទាញយក អត្ថប្រយោជន៍ នៃ ការអប់ ឌីជីថល ដើម្បី ទទួលបាន នូវ ភាពជោគជ័យ ក្នុង ការសិក្សា ការស្រាវជ្រាវ និង សកម្មភាព សង្គម ។
សូម បញ្ជាក់ ដែរ ថា ការប្រកួត វីដេអូ ខ្លី នេះ មាន ការចូលរួម ប្រកួតប្រជែង ពីសំណាក់ សិស្សានុសិស្ស មកពី គ្រឹះស្ថាន សិក្សា រដ្ឋ និង ឯកជន ទូទាំង ប្រទេស ចំនួន ២៥ ក្រុម ដោយ ក្នុង នោះ មាន ៣ក្រុម ដែល ជា ក្រុម ទទួលបាន ជ័យលាភី តាមរយៈ ការដាក់ ពិន្ទុ ពី គណៈកម្មការ វាយតម្លៃ និង ការបោះឆ្នោត គាំទ្រ ពី សាធារណៈ ជន ផងដែរ ៕
( កែប )៖ លោក បណ្ឌិត សោម ពិសិដ្ឋ អភិបាល ខេត្ត កែប បាន អំពាវនាវ ដល់ ពលរដ្ឋ ត្រូវ រក្សា ការអភិវឌ្ឍ សុខ សន្តិភាព ជា អមតៈ និង ទៅ ចូលរួម បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា នា ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
ការអំពាវនា នេះ ខណ: លោក អធិបាល ខេត្ត បាន ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ អាជ្ញាធរ និង អ្នក ពាក់ព័ន្ធ ក្រោម ឱវាទ ជាច្រើន នាក់ ចូលរួម ក្នុង កម្មវិធី សំណេះសំណាល ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ប្រមាណ ១០០ គ្រួសារ នា ថ្ងៃទី ០៦ ខែមិថុនា ឆ្នាំ ២០២៣ នៅ បរិវេណ វត្ត ចរិយា វង្ស ស្ថិត នៅ សង្កាត់ អូរ ក្រសារ ក្រុង កែប ខេត្ត កែប ។
នា ឱកាស សំណេះសំណាល នោះ លោក សោម ពិសិដ្ឋ បាន ពាំនាំ ការសួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ជូន ដល់ លោកតា លោកយាយ អ៊ំ ពូ មីង បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ជា ទីស្រឡាញ់ ។
លោក អភិបាល ខេត្ត ក៏ បាន ស្វែងយល់ ជុំវិញ ជីវភាព រស់ នៅ និង ការបង្កបង្កើន ផល ស្រូវ ការដាំដុះ ដំណាំ រួមផ្សំ ផ្សេង ៗ និង ការចិញ្ចឹម សត្វ របស់ បងប្អូន ។ លោក អភិបាល ខេត្ត ក៏ បាន ក្រើន រំលឹក ណែនាំ ពី ការបង្ការ ជំងឺ កូវីដ១៩ ការធ្វើ អនាម័យ ដោយ រស់ នៅ ស្អាត ហូប ស្អាត ផឹក ស្អាត និង បន្ត ចូលរួម ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ឲ្យបាន គ្រប់ ដូស គ្រប់ ៗ គ្នា ។
ក្នុង ឱកាស នោះ ដែរ លោក អភិបាល ខេត្ត ក៏ បាន ចែកជូន អំណោយ រួម មាន៖ អង្ករ អម ដោយ ថវិកា មួយ ចំនួន ដល់ អ្នកចូលរួម នៅ ទីនោះ ផងដែរ ៕ លោក ព្រាប កុល បង្ហាញ ពី បរិយាកាស អំណោយផល របស់ កម្ពុជា សម្រាប់ ធ្វើ ពាណិជ្ជកម្ម ដល់ សហគ្រាស ចិន
ក្នុង ជំនួប នោះ លោក ព្រាប កុល រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី បាន នាំ នូវ ការស្វាគមន យ៉ាង កក់ក្តៅ និង ការថ្លែងអំណរគុណ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ជូន ចំពោះ គណ: ប្រតិភូសហគ្រាស ចិន ដែល បាន មក សិក្សា ពី ឱកាស ធ្វើ ការ វិនិយោគ នៅក្នុង កម្ពុជា ។
គណ: ប្រតិភូសហគ្រាស ចិន បាន ថ្លែងអំណរគុណ ដល់ លោក ព្រាប កុល រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី ដែល បាន ផ្តល់ កិត្តិយស និង ឱកាស សម្រាប់ ការជួប ពិភាក្សា នៅ ថ្ងៃ នេះ ហើយ សង្ឃឹម ថា លោក រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី បន្ត ជួយ គាំទ្រ និង សហការ ជាមួយ ក្រុមហ៊ុន ដើម្បី ធ្វើ ការសិក្សា ពី ឱកាស វិនិយោគ នៅ កម្ពុជា រហូតដល់ ក្រុមហ៊ុន អាច បោះ ទុន វិនិយោគ ដ៏ ធំ នៅពេល ខាងមុខ ដើម្បី ចូលរួមចំណែក ជួយ ដល់ កំណើន សេដ្ឋកិច្ច នៅ កម្ពុជា នា ពេល អនាគត ៕
( កណ្ដាល ) ៖ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ណ្ដាល លោក គង់ សោភ័ណ្ឌ បាន ជំរុញ សមាជិក សមាជិកា សាខា អនុសាខា ក្រុង - ស្រុក និង អនុសាខា មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត បន្ត កៀរគរ រក សប្បុរសជន នានា ក្នុង ការចូលរួម ឧបត្ថម្ភ ការងារ មនុស្សធម៌ សម្រាប់ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក និង រងគ្រោះ ដោយ គ្រោះ មហន្តរាយ នានា ដែល កើត មាន ឡើង ក្នុង ភូមិសាស្ត្រ ខេត្ត កណ្ដាល ។
លោក គង់ សោភ័ណ្ឌ បាន ជំរុញ បែប នេះ នា ថ្ងៃទី ៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ ក្នុង ពិធី អបអរ ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ក្រោម ប្រធានបទ « រួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដើម្បី បរិយា បន្ន សង្គម » នៅ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្ដាល ។
លោកសង្ឃឹម យ៉ាង មុតមាំ ថា សមាជិក សមាជិកា សាខា អនុសាខា ក្រុង - ស្រុក និង អនុសាខា មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត បន្ត កៀរគរ រក សប្បុរសជន នានា ជួយ ឧបត្ថម្ភ និង គាំទ្រ ដល់ សកម្មភាព របស់ សាខា លើ ការងារ មនុស្សធម៌ បន្ថែម ទៀត ដើម្បី អបអរ ខួប ទី ១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ក្រោម ប្រធានបទ « រួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដើម្បី បរិយា បន្ន សង្គម »៕ អគ្គ នាយកដ្ឋាន ពន្ធដារ កោះ អញ្ជើញ អគ្គ នាយក ក្រុមហ៊ុន ចំនួន ២ ឲ្យ ចូលមក ទូទាត់ បំណុល ពន្ធ
ទន្ទឹមនឹង ការផ្តល់ ជូន នេះ ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស ត្រូវ រក្សា ប្រាក់ ឈ្នួល និង អត្ថប្រយោជន៍ ផ្សេង ៗ ស្រប តាម បទប្បញ្ញត្តិ នៃ ច្បាប់ ស្ដីពី ការងារ ជូន ដល់ បងប្អូន កម្មករ និយោជិត ជា ជន មាន ពិការ ភាព ដែល ទទួល បាន សិទ្ធិ អនុញ្ញាតឱ្យ ចេញ មុន ម៉ោង ការងារ នេះ ។
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ សង្ឃឹម យ៉ាង មុតមាំ ថា ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស ទាំងអស់ នឹង អនុវត្ត តាម សេចក្តីជូនដំណឹង នេះ ប្រកបដោយ ប្រសិទ្ធភាព ៕ ៥ខែ ឆ្នាំ ២០២៣ ខេត្ត បាត់ដំបង បាន រង ផល ប៉ះពាល់ ដោយ ខ្យល់ កន្រ្តាក់ បណ្តាលឲ្យ ខូចខាត ផ្ទះ ជាង ២ពាន់ គ្រួសារ
( បាត់ដំបង ) ៖ តាម របាយការណ៍ របស់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង បាន បង្ហាញ ថា គិត ត្រឹម រយៈពេល ៥ខែ ដើម ឆ្នាំ ២០២៣ ខេត្ត បាត់ដំបង បាន រង ផល ប៉ះពាល់ ដោយ ខ្យល់ កន្រ្តាក់ បណ្តាលឲ្យ ខូចខាត ផ្ទះ សំបែង របស់ ប្រជាពលរដ្ឋ សរុប ២. ២០៨ខ្នង ក្នុង នោះ រន្ទះ បាញ់ ស្លាប់ មនុស្ស ៦នាក់ របួស ១១នាក់ និង ងាប់ គោ មួយចំនួន ព្រមទាំង ខូចខាត ទ្រព្យសម្បត្តិ មួយចំនួន ទៀត ។
ខ្យល់ កន្រ្តាក់ នេះ បាន ធ្វើឲ្យ ប៉ះពាល់ ក្នុង ឃុំ សង្កាត់ ចំនួន ៩៦ និង ៤១១ ភូមិ លើក ក្រុង ស្រុក ទាំង ១៤ នៃ ខេត្ត បាត់ដំបង ។ គ្រួសារ រងគ្រោះ នីមួយ ៗ បាន ទទួល អំណោយ មនុស្សធម៌ ពី សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ចំនួន ៩៥២ គ្រួសារ និង ជ្ញាធរ មូលដ្ឋាន ក្រុមការងារ ចុះ មូលដ្ឋាន ក្រុង ស្រុក ទាំង ១៤ ចំនួន ៩៧៤ គ្រួសារ ទៀត ផងដែរ ។
គួរ បញ្ជាក់ ថា ក្នុង ឆ្នាំ ២០២៣ នេះ កូរ៉េ ខាងជើង បាន បាញ់ តេស្ត មីស៉ីល បាលិស្ទីគ អន្តរ ទ្វីប (ICBM) ធំ បំផុត របស់ ខ្លួន ហើយ កាលពី សប្តាហ៍ កន្លងទៅ ក៏ បាន ព្យាយាម បាញ់ បង្ហោះ ផ្កាយ រណប ស៉ើបការណ៍ លើក ដំបូង យក ឡើង ទៅកាន់ ទី អវកាស ផងដែរ ក៏ប៉ុន្តែ ការបាញ់ បង្ហោះ នោះ បាន ទទួលបរាជ័យ ដោយសារ គ្រាប់ រ៉ុក្កែត និង ផ្កាយ រណប បាន ធ្លាក់ ចូល ទៅក្នុង សមុទ្រ ៕
អង្គភាព ប្រតិកម្ម រហ័ស បញ្ចេញ ផ្សាយ វីដេអូ ថ្មី៖ « កម្ពុជា ត្រូវការ ប្រជាធិបតេយ្យ ដែល ផ្អែក លើ មូលដ្ឋាន សន្តិភាព និង នីតិរដ្ឋ »
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី បាន បញ្ចេញផ្សាយ នូវ វីដេអូ ថ្មី មួយ ទៀត ដែល មាន រយៈពេល ជាង ១១នាទី ក្រោម ចំណងជើង ថា « កម្ពុជា ត្រូវការ ប្រជាធិបតេយ្យ ដែល ផ្អែក លើ មូលដ្ឋាន សន្តិភាព និង នីតិរដ្ឋ » ។
ទោះបីជា មាន ការរំខាន ដោយ វិបត្តិ កូវីដ - ១៩ និង ចំហាយ នៃ សង្គ្រាម នៅ អ៊ុយក្រែន ក្តី ក៏ ស្ថានភាព នៅ កម្ពុជា មាន លក្ខណៈ ល្អ ប្រសើរ ហើយ សម្រាប់ ដំណើរការបោះឆ្នោត នៅ ថ្ងៃទី ២៣ កក្កដា ខាងមុខ នេះ ក៏ ប្រាកដ ជា ទទួលបាន ជោគជ័យ យ៉ាង ត្រចេះ ត្រង់ ក្រោម ម្លប់ សុខ សន្តិភាព និង ការគោរព យ៉ាង ល្អ នូវ គោលការណ៍ នីតិរដ្ឋ ៕
សូម ទស្សនា វីដេអូ ដូចតទៅ៖ មជ្ឈមណ្ឌល មណ្ឌល ថែទាំ មនុស្ស ចាស់ ជប៉ុន ស្នើសុំ ការគាំទ្រ ការបង្កើត មណ្ឌល ថែទាំ មនុស្ស ចាស់ ពី ក្រសួង សង្គមកិច្ច តាម ស្តង់ដា របស់ ជប៉ុន
ប៉ុន្តែ យ៉ាងណាមិញ លោក លើកឡើង ថា សម្រាប់ អ្នកអភិវឌ្ឍន៍ លំនៅដ្ឋាន ឬ បុរី ដែល ផ្តោត លើ គុណភាព សំណង់ មាន ទីធ្លា ទូលាយ និង សេវាកម្ម ល្អ ហាក់ មិន សូវ រង ផល ប៉ះពាល់ ខ្លាំង នោះ ទេ ដោយ ពួកគេ នៅតែ អាច ទាក់ទាញ អ្នក ទិញ បាន ក៏ ទោះបីជា លក់ ក្នុង តម្លៃ មធ្យម ឬ តម្លៃ ខ្ពស់ ក៏ដោយ ។ ចំណែក អ្នក ដែល រងគ្រោះ ខ្លាំង គឺ អ្នក អភិវឌ្ឍន៍ មក ក្រោយ គេ ឬ អ្នក ដែល ផ្គត់ផ្គង់ អចលន ទ្រព្យ ដែល មិន បាន ផ្តោត ទៅ លើ គុណភាព តែ ផ្តោត លើ តម្លៃ ទាប ជា គោល ។
មាន បទពិសោធ ប្រមាណ ជាង ២០ លើ វិស័យ អចលទ្រព្យ អ្នកជំនាញ អចលន ទ្រព្យ រូប នេះ បាន លើកឡើង ថា ស្រប ពេល ដែល សេដ្ឋកិច្ច កម្ពុជា ចាប់ផ្តើម ងើប ឡើងវិញ នឹង ជំរុញ ឱ្យ វិស័យ អចលន ទ្រព្យ នៅ កម្ពុជា ចាប់ផ្តើម ងើប ឡើងវិញ ដែរ ព្រោះ ជាទូទៅ វិស័យ អចលន ទ្រព្យ តែ ដើរ ពីក្រោយ សេដ្ឋកិច្ច ពី ៦ខែ ទៅ១ ឆ្នាំ ។
តែ យ៉ាង នេះ ក្តី លោក លើកឡើង ថា នៅ ឆ្នាំ ២០២៣ នេះ ស្ថានភាព ហាក់ មាន ភាពល្អ ប្រសើរ ជាង ឆ្នាំ ២០២២ ព្រោះ យ៉ាងហោចណាស់ ក៏ មាន អតិថិជន មក សួរ នាំ ព័ត៌មាន និង មាន អ្នកទិញ ខ្លះ ដែរ បើ ទោះបីជា ចំនួន តិច ក៏ដោយ ។
លោក សន សៀប បាន លើកឡើង ថា វិធានការ ទាំង នេះ ជួយ ដល់ អភិវឌ្ឍន៍ បាន យ៉ាង ច្រើន ដើម្បីឱ្យ ពួកគេ ទប់ លំនឹង របស់ ខ្លួន ទម្រាំតែ ស្ថានភាព លំបាក នេះ បាន បញ្ចប់ ។
( ភ្នំពេញ ) ៖ សុខ សន្តិភាព ដែល រក បាន មក ដោយ លំបាក ក្រោម បាត ដៃ និង បញ្ញា ញាណ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង រយៈពេល ជាង ២០ ឆ្នាំ មក នេះ កំពុង នាំមក នូវ ការរីកចម្រើន លូតលាស់ យ៉ាង លឿន លយ សម្រាប់ ជាតិ កម្ពុជា ។ សមិទ្ធផល ហេដ្ឋារចនាសម្ព័ន្ធ ផ្នែក ដឹកជញ្ជូន ជាច្រើន ក៏ ត្រូវបាន លេចចេញ ជា រូបរាង ឡើង បន្តបន្ទាប់បម្រើ ជា ឧត្តម ប្រយោជន៍ ដ៏ ថ្លៃថ្លា សម្រាប់ ប្រជាជាតិ កម្ពុជា ដែល ធ្លាប់ តែ កម្សត់ វេទនា កាលពី អតីតកាល នោះ ។
ពិធី បើក ការដ្ឋាន សាងសង់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត នឹង ត្រូវ ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក វ៉ាង វិន ធៀន ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ នៅ កម្ពុជា ។ ពិធី ថ្ងៃស្អែក នេះ ក្រៅតែ ពី ការបើក ការដ្ឋាន សាងសង់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត ហើយ នោះ ក៏ ភ្ជាប់ ជាមួយ នូវ ការ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លងកាត់ ទន្លេ មេគង្គ និង ផ្លូវ តភ្ជាប់ ក្បាល ស្ពាន ផងដែរ ។
លោក ស៊ុន ចាន់ថុល ចាត់ទុក ការសម្រេចបាន នូវ សមិទ្ធផល ជាតិ ធំ ៗ និង សំខាន់ ៗ ជា ប្រវត្តិសាស្រ្ត នៅ ទូទាំង ប្រទេស នា ពេល បច្ចុប្បន្ន នេះ កើតឡើង ដោយសារ ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត ឈ្លាសវៃ និង ប៉ិនប្រសប់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល ជា អគ្គ មគ្គុទ្ទេសក៍ ដ៏ ឆ្នើម បំផុត និង ជា បិតា ស្ថាបនិក សន្តិភាព របស់ កម្ពុជា ៕ កម្ពុជា - ថៃ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ ការទូទាត់ ឆ្លង ដែន តាមរយៈ QR Code ដំណាក់កាល ទី២ ដែល អនុញ្ញាតឱ្យ ពលរដ្ឋ ថៃ ងាយស្រួល ទូទាត់ នៅ កម្ពុជា
កិច្ចប្រជុំ ទ្វេ ភាគី នេះ ប្រារព្ធ ឡើង ក្នុង គោលបំណង ពង្រឹង សាមគ្គីភាព មិត្តភាព ពង្រឹង ទំនាក់ទំនង សេដ្ឋកិច្ច និង ជំរុញ ការរីកចម្រើន នៃ ម៉ាក្រូ សេដ្ឋកិច្ច វិស័យ ធនាគារ និង បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ (FinTech) ក្នុង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ ប្រសើរ ថែម ទៀត ។
ធនាគារ ជាតិ នៃ កម្ពុជា បាន ឲ្យដឹង ថា « ការដាក់ ឱ្យ ដំណើរការ គម្រោង ការទូទាត់ ឆ្លង ដែន តាមរយៈ ឃ្យូ អរ កូត (QR Code) រវាង កម្ពុជា និង ថៃ ដំណាក់កាល ទី២ មាន អត្ថប្រយោជន៍ ណាស់ សម្រាប់ លើក កម្ពស់ ការទូទាត់ រូបិយវត្ថុ ជាតិ ហើយ បាន រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការជំរុញ បរិយា បន្ន ហិរញ្ញវត្ថុ សម្រួល ការធ្វើ ពាណិជ្ជកម្ម ឆ្លង ដែន និង កំណើន ភ្ញៀវ ទេសចរ ទៀតផង » ។
សូម ជម្រាប ថា គម្រោង នេះ មាន ពីរ ដំណាក់កាល ដោយ ដំណាក់កាល ទី១ ប្រជាជន កម្ពុជា អាច ស្កេន ឃ្យូ អរ កូត នៅ ប្រទេស ថៃ ដែល ដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ ក្នុង កិច្ចប្រជុំ ទ្វេ ភាគី រវាង ធនាគារ គណ្តាល នៃ ប្រទេស ទាំង ពីរ កាលពី ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២០ . នៅ ប្រទេស ថៃ ។
ចំណែក ដំណាក់កាល ទី២នេះ គឺ ប្រជាជន ថៃ អាច ស្កេន ឃ្យូ អរ កូត នៅ ប្រទេស កម្ពុជា គម្រោង នេះ ចាប់ ដាក់ ឱ្យ ប្រើប្រាស់ ចាប់ពី ទី៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ តទៅ ដោយ ប្រជាពលរដ្ឋ ថៃ អាច ប្រើប្រាស់ កម្មវិធី ធនាគារ ចល័ត របស់ ប្រទេស ថៃ ដើម្បី ស្កេន ឃ្យូ អរ កូត ទៅកាន់ ពាណិជ្ជករ ប្រមាណ ១.៥ លាន ពាណិជ្ជករ ក្នុង ប្រទេស កម្ពុជា ៕
លុបបំបាត់ គ្រឿងញៀន ត្រូវ ផ្តើម ចេញ ពី យើង ទាំងអស់ គ្នា ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៦ ខែមិថុនា៖ បង្ក្រាប ១៧ករណី ឃាត់ខ្លួន ៥០ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៦ ខែមិថុនា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៧ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៣ករណី . ជួញដូរ ៨ករណី និង ដឹកជញ្ជូន រក្សាទុក ៦ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥០ នាក់ ។
លើកឡើង នា ឱកាស ទទួលបាន មេដាយ នា ថ្ងៃទី ០៤ ខែមិថុនា ឆ្នាំ ២០២៣ យុវជន ហ៊ាង សុវណ្ណ ធារ៉ា ដែល បាន ទទួល មេដាយ ប្រាក់ ក្នុង កម្មវិធី នេះ បាន ឱ្យដឹង ថា ការប្រកួតប្រជែង គណិតវិទ្យា កង់ ហ្ការ៉ូ នេះ ជា ឱកាស ល្អ មួយ ដើម្បីឱ្យ សិស្សានុសិស្ស មាន ឱកាស អាច បញ្ចេញ សមត្ថភាព របស់ ខ្លួន និង ពង្រឹង សមត្ថភាព របស់ ខ្លួន បន្ថែម ។ ការប្រឡង មួយ នេះ គឺ មាន លំបាក មួយចំនួន សម្រាប់ គាត់ តែ វា ក៏ ជា ការតេស្ត នូវ សមត្ថភាព របស់ គាត់ ផងដែរ ។
លោកស្រី ជួន សារ័ត្ន ម្តាយ របស់ យុវជន ហ៊ាង សុវណ្ណ ធារ៉ា បាន លើកឡើង ដែរ ថា សម្រាប់ ការប្រកួតប្រជែង គណិតវិទ្យា កង់ ហ្ការ៉ូ នេះ វា គឺជា ឱកាស ល្អ មួយ សម្រាប់ ឱ្យ សិស្សានុសិស្ស បាន បញ្ចេញ សមត្ថភាព របស់ គាត់ តាមរយៈ ការប្រកួតប្រជែង និង ធ្វើឱ្យ ក្មេង ៗ គាត់ មាន ការខិតខំ ប្រឹងប្រែង រៀន ដើម្បីឱ្យ ខ្លួន ទទួលបាន ជោគជ័យ លើ ការប្រឡង ហើយ សម្រាប់ ក្មេង ៗ ឥលូវនេះ ការរៀនសូត្រ របស់ គាត់ គឺ មាន ការឯករាជ ខ្លួន គាត់ ។
បើ តាម លោកស្រី ជួន សារ័ត្ន សម្រាប់ វិស័យ អប់រំ នៅ កម្ពុជា នា ពេល បច្ចុប្បន្ន នេះ គឺ មាន ការអភិវឌ្ឍន៍ បាន យ៉ាង ល្អ ប្រសើរ តាមរយៈ ការជួយ បណ្តុះ ក្មេង ៗ ឱ្យ មាន បំណិន ជីវិត បាន កាន់តែ ច្រើន និង មាន ការបណ្តុះ ពុទ្ធិ របស់ ក្មេង ៗ បាន តែ ល្អ ប្រសើរ ជាង ជំនាន់ មុន ៗ ។ លោកស្រី ក៏ បាន ថ្លែង អរគុណ ដល់ ប្រមុខ រាជ រាដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន ធ្វើឱ្យ ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ពេញ ផ្ទៃ ប្រទេស និង ជួយ ឱ្យ ក្មេង ៗ មាន ឱកាស បាន រៀនសូត្រ កាន់តែ ល្អ ប្រសើរឡើង ផងដែរ ។
បើ តាម លោក អ៊ែល ណូរី ការប្រឡង គណិតវិទ្យា កង់ ហ្ការ៉ូ នេះ មាន កូនសិស្ស ទូទាំង សកលលោក បាន ចូលរួម ប្រឡង ប្រមាណ ៤លាន ទៅ ៦លាន នាក់ នៅលើ ភពលោក ហើយ ការប្រឡង នេះ មាន ប្រភព មកពី ប្រទេស អូស្ត្រាលី ។ នេះ ក៏ ជា លើក ទី៣ ហើយ ដែល មាន ការប្រឡង ដូចនេះ នៅក្នុង ប្រទេស កម្ពុជា និង មាន សិស្ស ចូលរួម ប្រឡង ប្រមាណ ២ ៥០០ នាក់ ដែល រួម មាន ទាំង កូនសិស្ស ក្នុង រាជធានី ភ្នំពេញ និង មកពី តាម បណ្តា ខេត្ត នានា ផងដែរ ទាំង សាលា រដ្ឋ និង ឯកជន ។
