( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ជាមុនី ឫទ្ធិ ប្រធាន សមាគម អ្នកស្រាវជ្រាវ វឌ្ឍនភាព កម្ពុជា - ចិន បាន លើកឡើង ថា គោលការណ៍ សន្តិភាព ទាំង៥ របស់ ចិន បាន ដើរ ស្រប ជាមួយនឹង សេចក្តីប្រាថ្នា ដែល ត្រូវបាន បង្កើតឡើង ដោយ មនុស្សជាតិ គ្រប់ គ្នា នោះ គឺ សន្តិភាព និង ការអភិវឌ្ឍ ។
ប្រាប់ វិទ្យុ មិត្តភាព កម្ពុជា ចិន នា ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២៤ នេះ លោក បណ្ឌិត ជាមុនី ឫទ្ធិ ប្រធាន សមាគម អ្នកស្រាវជ្រាវ វឌ្ឍនភាព កម្ពុជា - ចិន បាន មានប្រសាសន៍ ថា គោលការណ៍ សន្តិភាព ទាំង ៥៖ ១. ការគោរព គ្នា ទៅ វិញ ទៅ មក ចំពោះ បូរណភាព ទឹកដី និង អធិបតេយ្យភាព ២. ការ មិន ឈ្លានពាន ៣. ការ មិន ជ្រៀត ជ្រែក ក្នុង កិច្ចការ ផ្ទៃក្នុង របស់ គ្នា ទៅ វិញ ទៅ មក ៤. ការគោរព និង ផ្តល់ តម្លៃ ចំពោះ សមភាព និង ផលប្រយោជន៍ ទៅ វិញ ទៅមក និង ទី៥. ការរួមរស់ ដោយ សន្តិភាព និង សុខដុមនីយកម្ម ។
លោក ឧត្តមសេនីយ៍ ឯក ទូច ពលៈ ដឹកនាំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល អនុវត្ត ផែនការ សកម្មភាព ប្រចាំ ឆមាស ទី១ ឆ្នាំ ២០២៤ របស់ នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន ទឹក
( ភ្នំពេញ ) ៖ នា ព្រឹក ថ្ងៃសុក្រ ទី ១២ ខែកក្កដា ឆ្នាំ ២០២៤ លោក ឧត្តមសេនីយ៍ ឯក ទូច ពលៈ ប្រធាន នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន ទឹក និង ជា អគ្គ លេខាធិការ រង នៃ គ.ជ.ស. ស បាន ដឹកនាំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល អនុវត្ត ផែនការ សកម្មភាព ប្រចាំ ឆមាស ទី១ ឆ្នាំ ២០២៤ របស់ នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន ទឹក នៅ សាល ប្រជុំ នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន ទឹក ។
ក្នុង កិច្ចប្រជុំ នេះ ដែរ មាន ការអញ្ជើញ ចូលរួម ពី លោក - លោកស្រី អនុប្រធាន នាយកដ្ឋាន នាយ - នាយ រង ការិយាល័យ ប្រធាន ( ស្តីទី )- អនុប្រធាន អង្គភាព បង្ក្រាប បទល្មើស លើ ផ្ទៃ សមុទ្រ និង មេបញ្ជាការ - មេបញ្ជាការ ( ស្តីទី ) មេបញ្ជាការ រង ផ្នែក រដ្ឋបាល - សរុប ព្រមទាំង នាយ ផ្នែក សេនាធិការ អង្គភាព និង វរសេនា តូច ទាំងអស់ ចំណុះ នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន ទឹក ចំនួន ៧០ រូប ៕
( កំពង់ឆ្នាំង ) ៖ កម្លាំង នគរបាល ស្រុក រលាក ប្អៀរ នៅ យប់ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២៤ បាន ឃាត់ រថយន្ត ដឹក កម្ទេច លៀស ចម្រុះ ខុស ច្បាប់ មួយ គ្រឿង ដែល កំពុង ធ្វើ សកម្មភាព លើក ការ៉ុង កម្ទេច លៀស ដាក់ លើ រថយន្ត នៅ ចំណុច ថ្នល់ តា សែង ស្ថិត ក្នុង ភូមិ វត្ត ថ្នល់ ឃុំ ភ្នំ ក្រាំង ដី មាស ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង ។
លោក លី ហុង ស្រេង នាយ រង ខណ្ឌ រដ្ឋបាល ជលផល កំពង់ឆ្នាំង បាន បញ្ជាក់ ថា រថយន្ត ដឹក លៀស ខាងលើ នេះ កម្លាំង ខណ្ឌ រដ្ឋបាល ជលផល របស់ លោក សហការ ជាមួយ កម្លាំង នគរបាល ស្រុក រលាប្អៀរ ចាប់ ឃាត់ កាល ពី វេលា ចន្លោះ ពី ម៉ោង ១១៖០០ នាទី ទៅ ម៉ោង ១២៖០០ នាទី យប់ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២៤ ខណៈ ដែល រថយន្ត នេះ កំពុង ធ្វើ សកម្មភាព លើក ការ៉ុង លៀស ដាក់ លើ រថយន្ត ចំណែក វត្ថុតាង នៃ បទល្មើស លោក នឹង យក មក កសាង សំណុំរឿង បញ្ជូន តាម នីតិវិធី ស្ដីពី ជល ផល ។
ដោយឡែក វត្ថុតាង លៀសកម្លាំង របស់ លោក និង សមត្ថកិច្ច នគរបាល នឹង យក ទៅ ចាក់ លែង នៅ ស្ទឹង មួយ កន្លែង ស្ថិត នៅក្នុង ឃុំ បន្ទាយ ព្រាល ស្រុក រលាប្អៀរ ។ លោក បាន បញ្ជាក់ ថា ចំពោះ រថយន្ត ដឹក លៀស ដែល ត្រូវ បាន សមត្ថកិច្ច ចាប់ ឃាត់ បាន កាលពី យប់ មិញ នេះ គឺជា រថយន្ត ថ្មី ដែល ទើបតែ ចាប់ បាន ជា លើក ទី មួយ នោះ ទេ ដោយសារតែ លោក សង្កេតឃើញ ផ្លាកលេខ រថយន្ត គឺជា ផ្លាកលេខ ថ្មី ។
( ភ្នំពេញ ) ៖ កម្ពុជា - រុស្ស៊ី បាន គូសបញ្ជាក់ ជា ថ្មី នូវ ការបេ្តជ្ញាចិត្ត ដើម្បី លើកស្ទួយ ឧត្តមានុភាព នៃ ទំនាក់ទំនង សេដ្ឋកិច្ច តាមរយៈ យន្តការ គន្លឹះ ផ្សេង ៗ រាប់បញ្ចូល ទាំង កិច្ចប្រជុំ គណៈកម្មការ អន្តរ រដ្ឋាភិបាល ។
( ភ្នំពេញ ) ៖ បណ្ឌិត ផុន ណារិន សាកលវិទ្យាធិការ សាកលវិទ្យាល័យ ពាណិជ្ជសាស្រ្ត អេស៊ីលីដា បាន លើកឡើង ថា ជំនាញ ឥណទាន គឺជា មុខជំនាញ ដែល មាន ឱកាស ឡើង តំណែង និង ទទួលបាន ប្រាក់ ខែ ខ្ពស់ ដែល និស្សិត មិន គួរ មើល រំលង ប្រសិនបើ ស្រលាញ់ ការងារ ខាង វិស័យ ធនាគារ ។
លោក បាន កត់សម្គាល់ ថា ឥណទាន គឺជា ផលិតផល នាំមុខ នៅក្នុង វិស័យ ធនាគារ ព្រោះ បន្ទាប់ ធនាគារ ទទួលបាន ប្រាក់ បញ្ញើ ពី អតិថិជន ហើយ នឹង បញ្ចេញ ទៅ ឱ្យ អ្នក ខ្ចី ។ នៅ ពេល ដែល មន្រ្តី ឥណទាន សម្រេចបាន តាម គោលដៅ នៃ ទឹកប្រាក់ ដែល ត្រូវ ផ្តល់ កម្ចី តាម ផែនការ នោះ នឹង ទទួលបាន ការវាយតម្លៃ ល្អ ដែល ធ្វើឱ្យ ភ្នាក់ងារ ឥណទាន នោះ ងាយ ក្នុង ការឡើង តំណែង និង ប្រាក់ បៀវត្ស ច្រើន ។
តែ យ៉ាង នេះ ក្តី នេះ ពួកគេ ក៏ ត្រូវតែ បន្ត ខិតខំ ប្រឹងប្រែង រៀន ពង្រឹង សមត្ថភាព ខ្លួន ឯង ជា បន្តបន្ទាប់ ផងដែរ ៕
សូម ស្តាប់ ការពន្យល់ បន្ថែម របស់ បណ្ឌិត ផុន ណារិន ៖
កាលពី ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២៤ លោក កើត រិទ្ធ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ និង ជា ប្រធាន គណៈ បញ្ជាការដឹកនាំ យុទ្ធនាការ បាន ដឹកនាំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ក្នុង ការអនុវត្ត យុទ្ធនាការ រយៈពេល ៦ខែ ដោយ មាន ការចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ នៃ សាលា ជម្រះ ក្តី និង អង្គការ អយ្យការ អម សាលា ជម្រះ ក្តី ទូទាំង ប្រទេស ។
លោក ជិន ម៉ាលី ន បាន បញ្ជាក់ ថា « ពាក់ព័ន្ធ នឹង ករណី សំណុំរឿង អត្រានុកូលដ្ឋាន . សំណុំរឿង ដែល នៅសល់ មុនពេល ប្រកាស បើក យុទ្ធនាការ ចំនួន ៤ ៩៨៣ ត្រូវបាន តុលាការ ដោះស្រាយ ចប់ សព្វគ្រប់ ១០០ % តាំងពី ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០២៤ ។ ចំណែក សំណុំរឿង អត្រានុកូលដ្ឋាន ដែល ចូល ថ្មី ចំនួន ២១ ៨៣៥ ត្រូវបាន តុលាការ ដោះស្រាយ ចប់ សព្វគ្រប់ ចំនួន ១៩ ៧៩៨ ស្មើនឹង ៩០ % នៃ សំណុំរឿង សរុប » ។
គណៈ បញ្ជាការដឹកនាំ យុទ្ធនាការ បន្ត លើកទឹកចិត្ត ដល់ ប្រជាពលរដ្ឋ ដែល យល់ឃើញ ថា ចំណាត់ការ របស់ តុលាការ លើ សំណុំរឿង របស់ ខ្លួន មាន ភាព យឺតយ៉ាវ ឬ មាន ភាព មិន ប្រក្រតី សូម ដាក់ ពាក្យ បណ្តឹង មក យន្តការ ផ្លូវការ នៃ យុទ្ធនាការ ទាំង ២ របស់ ក្រសួង យុត្តិធម៌ តាមរយៈ លេខ ទូរស័ព្ទ 099 444 181 ៕ ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ចិត្រ បុរី ដឹកនាំ បើក វេទិកា សាធារណៈ ដើម្បី ត្រួតពិនិត្យ និង គាំទ្រ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល នៅ ឃុំ សំបុក ខេត្ត ក្រចេះ
( ក្រចេះ ) ៖ លោក សុខ ចាន់ ភក្តី ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ នា ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២៤ បាន អញ្ចើញ បើក វេទិកា សាធារណៈ ដើម្បី ត្រួតពិនិត្យ និង គាំទ្រ ការអនុវត្ត កម្មវិធី នយោបាយ និង យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នៅក្នុង បរិវេណ វត្ត សំបុក ឃុំ សំបុក ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ។
នា ឱកាស នោះ លោក យិន វណ្ណៈ អភិបាល ស្រុក ចិត្រ បុរី បាន ឱ្យដឹង ថា ក្រុមការងារ របស់ ថ្នាក់ ជាតិ ថ្នាក់ ខេត្ត និង ថ្នាក់ ស្រុក ចុះ មក នា ពេលនេះ ដើម្បី សួរសុខទុក្ខ តំណាង ឲ្យ ថ្នាក់ដឹកនាំ ប្រទេស អញ្ចឹង ប្រសិនបើ បញ្ហា ណា ដែល បងប្អូន ជួប បញ្ហា លំបាក អាច លើកឡើង នៅ ពេល នេះ ហើយ សំណូមពរ ណា ដែល ថ្នាក់ដឹកនាំ អាច ដោះស្រាយ ភ្លាម ៗ នៅ ទីនេះ តែម្ដង ។ ចំពោះ រឿងរ៉ាវ ណា ដែល មិន អាច ដោះស្រាយ បាន ក្រុមការងារ និង កត់ត្រា ទុក ដើម្បី រាយការណ៍ ជូន ថ្នាក់ដឹកនាំ ខាងលើ រក ដំណោះស្រាយ ជូន បន្តរ ទៀត នៅ ពេល ក្រោយ ។
