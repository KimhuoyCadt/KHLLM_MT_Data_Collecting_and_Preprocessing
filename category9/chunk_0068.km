( ភ្នំពេញ ) ៖ លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត នឹង អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បិទ វគ្គ និង ចែក វិញ្ញាបនបត្រ ដល់ សិក្ខាកាម កម្មវិធី អប់រំ សីលធម៌ ព្រះពុទ្ធ សាសនា បំបួស កុលបុត្រ កុល ធីតា ចំនួន ៦៣០ អង្គ / នាក់ វគ្គ ទី ១១ ឆ្នាំ ទី១១ នៅ វត្ត ភ្នៀត សិម្ព លី សង្កាត់ ស្នោរ ខណ្ឌ កំបូល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០២៤ ព្រឹក ស្អែក នេះ ។
ដូច្នេះ ថា តើ អ្វី ទៅ ដែល នៅ ពីក្រោយ វាំងនន នៃ សកម្មភាព របស់ ក្រុម មាតា ធម្មតា ជាតិ ? តើ យុវជន បរិស្ថាន ចៀសវាង ដូចម្តេច ដើម្បី កុំ ឱ្យ ធ្លាក់ ក្នុង មនោគមន៍វិជ្ជា ជ្រុលនិយម ?
នៅ សប្តាហ៍ នេះ Fresh Talk រៀបចំ កិច្ចពិភាក្សា មួយ ក្រោម ប្រធានបទ៖ តើ យុវជន គួរ ចូលរួម ដូចម្តេច ក្នុង សកម្មភាព បរិស្ថាន និង ចៀសវាង ធ្លាក់ ក្នុង មនោគមន៍វិជ្ជា ជ្រុលនិយម ? កិច្ច ពី ភាក្សា នេះ មាន វាគ្មិន ចូលរួម ចំនួន ២រូប ក្នុង នោះ រួម មាន៖
• ឯកឧត្តម ខ្វៃ អាទិត្យា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន • លោក ហេង សំណាង អតីត សកម្មជន បរិស្ថាន និង ជា ប្រធានបណ្ដុំ អង្គការ សង្គម ស៊ីវិល
( សៀមរាប ) ៖ លោក លី សំរិទ្ធ សមាជិក គណៈ អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន សង្កាត់ គោក ចក នៅ ថ្ងៃទី ៦ ខែកក្កដា ឆ្នាំ ២០២៤ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស កែសម្រួល និង តែងតាំង សមាសភាព ក្រុមការងារ គណបក្ស ខេត្ត នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត សៀមរាប ។
លោក បាន បញ្ជាក់ ថា ការរៀបចំ កែសម្រួល និង តែងតាំង សមាភាព ក្រុមការងារ ចុះ មូលដ្ឋាន សង្កាត់ គោក ចក នា ពេលនេះ សំដៅ ក្នុង ការ ពង្រីក ពង្រឹង នូវ អង្គការ ចាត់តាំង គណបក្ស ថ្នាក់ មូលដ្ឋាន ឲ្យ កាន់តែ រឹងមាំ ក្នុង ការរក្សា ចាស់ បង្កើន ថ្មី ។
ជាមួយ នេះ ដែរ ក៏ បាន ក្រើន រំលឹក ដល់ គណបក្ស គ្រប់ លំដាប់ថ្នាក់ សំខាន់ គណបក្ស សង្កាត់ ត្រូវ រៀបចំ ចង ក្រង និង ធ្វើ ផែនការប្រចាំ ឆ្នាំ របស់ ខ្លួន និង ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ ខ្ពស់ ក្នុង គោលដៅ ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ នា ឆ្នាំ ២០២៧ ៕
ស្រុក កំពង់លែង រៀបចំ ពិធី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៧៣ ថ្ងៃ បង្កើត គណបក្ស ប្រជាជន កម្ពុជា
លោក បន្ត ទៀត ថា ការពិត ជាក់ស្តែង ទាំងអស់ នេះ បាន ឆ្លុះបញ្ចាំង ច្បាស់ នូវ ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការប្រគល់ ភារកិច្ច ដឹកនាំ ដល់ ជួរ អ្នក បន្ត វេន ក្នុង ការបន្ត ថែរក្សា សុខ សន្តិភាព និង បន្ត ការអភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ៕ លោក ជា ម ច័ន្ទ សោភ័ណ ក្រើន រំលឹក ដល់ មន្ត្រីរាជការ ក្នុង សាលាខេត្ត កំពង់ស្ពឺ ត្រូវ ពង្រឹង បម្រើ សេវា សាធារណៈ ជូន ពលរដ្ឋ
( កំពង់ស្ពឺ ) ៖ លោក ជា ម ចន្ទ័ សោភ័ណ អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ក្រើន រំលឹក ដល់ មន្ត្រីរាជការ ទាំងអស់ ជាពិសេស មន្ត្រី ក្នុង សាលាខេត្ត ផ្ទាល់ ត្រូវ រួម គិត រួម ធ្វើ ហើយ បន្ត ពង្រឹង សមត្ថភាព ការងារ ចំពោះ ការងារ បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឱ្យ អស់ ពី កម្លាំង កាយ ចិត្ត ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ កាន់តែ មាន ទំនុកចិត្ត និង ជា ក្តីសង្ឃឹម របស់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ខេត្ត កំពង់ស្ពឺ ។
ការក្រើន រំលឹក នេះ ធ្វើឡើង គ្រា ដែល ជួប សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ ក្នុង សាលាខេត្ត កំពង់ស្ពឺ នា ថ្ងៃទី ៦ ខែកក្កដា ឆ្នាំ ២០២៤ ។
លោក បាន បញ្ជាក់ ថា ស្ថាប័ន រដ្ឋបាល ខេត្ត គឺជា ចំណុច ស្នូល ដែល ដាក់ចេញ ជា ទិសដៅ ដល់ គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ព្រមទាំង មន្ត្រីរាជការ គ្រប់ ក្រុង ស្រុក ឃុំ សង្កាត់ ទទួលបាន គោលការណ៍ យក ទៅ អនុវត្ត ធ្វើ យ៉ាងណា ក សាង នូវ ជំនឿ ទុកចិត្ត ពី ប្រជាពលរដ្ឋ ឱ្យ បាន ខ្លាំងក្លា ក្នុង ការបំពេញ ភារកិច្ច របស់ ខ្លួន ហើយ ត្រូវ ចៀសវាង ឱ្យ ផុត ពី ការសាង នូវ កំហុស បង្ក ភាពឈឺចាប់ និង ប្រព្រឹត្ត អំពើពុករលួយ ក្នុង ស្ថាប័ន រដ្ឋ ។
ទន្ទឹមនឹង នេះ ដែរ ដើម្បីឱ្យ ការដឹកនាំ ការផ្តល់ សេវា រដ្ឋបាល សាធារណៈ ប្រព្រឹត្តទៅ ដោយ រលូន និង ទទួលបាន ការជឿទុកចិត្ត ក៏ ទាមទារ ឱ្យ ថ្នាក់ដឹកនាំ ទាំងអស់ ទាំង ក្រុមប្រឹក្សា ខេត្ត ថ្នាក់ដឹកនាំ រដ្ឋបាល ខេត្ត ការិយាល័យ គ្រប់ ផ្នែក និង រដ្ឋបាល ក្រុង ស្រុក រហូតដល់ ឃុំ សង្កាត់ ត្រូវតែ រួម គិត រួម ធ្វើ និង ធ្វើឱ្យ កាន់តែ សកម្ម ថែម ទៀត ៕
ក្នុង ឱកាស ជំនួប នេះ លោកស្រី រដ្ឋមន្ត្រី ការបរទេស ជប៉ុន បាន ជម្រាប ជូន សម្តេច ធិបតី អំពី ភាពរីកចម្រើន នៃ ទំនាក់ទំនង រវាង កម្ពុជា និង ជប៉ុន ដែល ប្រកបដោយ ភាពជឿ ទុកចិត្ត គ្នា ទៅ វិញ ទៅ មក ចាប់តាំងពី ដំណើរការស្វែងរក សន្តិភាព និង ការចូលរួមចំណែក អភិវឌ្ឍ កម្ពុជា រហូតដល់ ពេល បច្ចុប្បន្ន ។ សម្រាប់ អនាគតកាល រាជ រដ្ឋាភិបាល ជប៉ុន នឹង បន្ត ពង្រឹង និង ពង្រីក ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ទាំង ក្នុង ក្របខ័ណ្ឌ ទ្វេ ភាគី និង ពហុ ភាគី ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ស្វាគមន៍ ចំពោះ ដំណើរទស្សនកិច្ច របស់ លោកស្រី រដ្ឋមន្ត្រី ការបរទេស ជប៉ុន និង គណៈប្រតិភូ នៅ កម្ពុជា ។ សម្តេច ធិបតី បាន ថ្លែងអំណរគុណ រាជ រដ្ឋាភិបាល និង ប្រជាជន ជប៉ុន ដែល តែងតែ បាន ចូលរួម គាំទ្រ កិច្ចអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច កម្ពុជា ។
សម្តេច ធិបតី ក៏ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា - ជប៉ុន ដែល ជា ទំនាក់ទំនង ស្ថិត ក្នុង កម្រិត ល្អ ប្រសើរ បំផុត ក្នុង ប្រវត្តិ នៃ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ បន្ទាប់ពី ការដំឡើង កម្រិត ទំនាក់ទំនង ទៅជា « ភាពជាដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ » ក្នុង ឆ្នាំ ២០២៣ ព្រមទាំង ការដាក់ចេញ នូវ គំនិត ផ្តួចផ្តើម ថ្មី ៗ ក្នុង ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ ឱ្យ កាន់តែ រឹងមាំ បន្ថែម ទៀត ។
ក្នុង ជំនួប នេះ សម្ដេច ធិបតី និង លោកស្រី រដ្ឋមន្ត្រី ក៏ បាន ពិភាក្សា គ្នា ក្នុង ការបន្ត ជំរុញ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី តាម អភិក្រម ថ្មី លើ វិស័យ ជាច្រើន រួម មាន៖
សម្ដេច ធិបតី ក៏ បាន គូសបញ្ជាក់ ថា កម្ពុជា បាន ត្រៀម ខ្លួន រួច ជាស្រេច ក្នុង ការរៀបចំ កិច្ចប្រជុំ នៃ អនុសញ្ញា អូតាវ៉ា នេះ និង បាន ថ្លែងអំណរគុណ ដល់ ភាគី ជប៉ុន ដែល បាន ចូលរួមចំណែក និង គាំទ្រ ដល់ កិច្ច ដំណើរការ នៃ ការរៀបចំ ។
បន្ថែម លើ នេះ សម្តេច ធិបតី និង លោកស្រី រដ្ឋមន្រ្តី ក៏ បាន ពិភាក្សា គ្នា បន្ត ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ លើ វិស័យ សេដ្ឋកិច្ច និង ការទាក់ទាញ វិនិយោគ ពី ប្រទេស ជប៉ុន ផងដែរ ។
សម្ដេច ធិបតី និង លោកស្រី រដ្ឋមន្ត្រី ក៏ បាន ស្វាគមន៍ និង អបអរសាទរ ចំពោះ ការដំឡើង កម្រិត នៃ កិច្ចសន្ទនា រវាង វិស័យ ការពារ ជាតិ និង វិស័យ ការបរទេស និង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ដល់ កម្រិត នៃ ថ្នាក់ អនុ រដ្ឋមន្ត្រី នៃ ប្រទេស ទាំង ពីរ ផងដែរ ។
ព្រម ជាមួយគ្នា នេះ សម្ដេច ធិបតី និង លោកស្រី រដ្ឋមន្ត្រី ក៏ បាន ពិភាក្សា គ្នា អំពី ការបន្ត កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី និង ពហុ ភាគី ដើម្បី សន្ដិភាព ស្ថិរភាព សាមគ្គីភាព និង វិបុលភាព ក្នុង តំបន់ និង អន្តរជាតិ សំដៅ ផ្ដល់ នូវ អត្ថប្រយោជន៍ ទៅ វិញ ដល់ ប្រជាជន និង ប្រទេស ទាំង ពីរ ៕ លោក នេត្រ ភក្ត្រា ចាត់ទុក និស្សិត ដែល បន្ត ការសិក្សា នៅ ក្រៅ ប្រទេស ជា ធនធាន មនុស្ស ដ៏ សំខាន់ ជា អ្នក បន្ត វេន ក្នុង ការដឹកនាំ ក្រសួង ស្ថាប័ន ពិសេស បន្ត រក្សា និង ការពារ សុខ សន្តិភាព ឲ្យបាន ល្អ រឹងមាំ ជារៀងរហូត
នេះ ជា ការថ្លែង របស់ លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ក្នុង ឱកាស អនុញ្ញាតអោយ បេក្ខជន បេក្ខ នារី ចំនួន ៥រូប ជា ជ័យលាភី អាហារូបករណ៍ របស់ សាលា គោល នយោបាយ សាធារណៈ លី ក្វាន់ យូ នៃ សកលវិទ្យាល័យ ជាតិ សឹង្ហបុរី ចូល ជួប សម្តែង ការគួរសម នៅ រសៀល ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២៤ ដើម្បី ទទួល អនុសាសន៍ ណែនាំ មុននឹង ចេញ ទៅ បន្ត ការសិក្សា ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ នៅ ប្រទេស សឹង្ហបុរី នា ដំណាច់ ខែកក្កដា ឆ្នាំ ២០២៤ ខាងមុខ នេះ ។
នៅក្នុង ឱកាស នេះ ដែរ រដ្ឋមន្ត្រី នេត្រ ភក្ត្រា បាន ចែករំលែក បទពិសោធន៍ ខ្លះ ៗ ពាក់ ពន្ធ័ ការសិក្សា ស្រាវជ្រាវ និង បរិបទ បែប ណា ខ្លះ ថា តើ ត្រូវ ធ្វើ អ្វី នៅពេល បញ្ចប់ ការសិក្សា ដើម្បី ចូលរួម កសាង ប្រទេសជាតិ ឲ្យបាន កាន់តែ រីកចំរើន ។ ជាមួយគ្នា នេះ ដែរ ត្រូវ ថែរក្សា សុខភាព អោយ បាន ល្អ ពង្រឹង សាមគ្គីភាព ក្នុង នាម ជាតិ សាសន៍ តែ មួយ រក្សា ក្តេរ៍ ឈ្មោះ និង កិត្យានុភាព ជាតិ នៅលើ ឆាក អន្តរជាតិ ។
លោក ស៊ីវ វិសេស តំណាង ជ័យលាភី អាហារូបករណ៍ ទៅ សិក្សា ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ បាន ជម្រាប ជូន ថា បេក្ខជន បេក្ខ នារី ចំនួន ៥រូប ទទួលបាន ការផ្តល់ អាហារូបករណ៍ ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ សិក្សា លើ មុខ ជំនាញ រដ្ឋបាល សាធារណៈ និង គោល នយោបាយ សាធារណៈ សម្រាប់ ឆ្នាំ សិក្សា ២០២៤ - ២០២៦ សិក្សា នៅ សាលា គោល នយោបាយ សាធារណៈ លី ក្វាន់ យូ ប្រទេស សឹង្ហបុរី ។
ស្ពាន ឆ្លងកាត់ ទន្លេ មេគង្គ ( ដី ឥដ្ឋ - ថ្ម គរ ) ប្រើប្រាស់ ថវិកា ក្រោម ក្របខណ្ឌ មូលនិធិ ទ្រទ្រង់ ថវិកា ហិរញ្ញប្បទាន ដោយ ដៃគូ អភិវធ្ឍន៍ ដោយ បាន បើក ការដ្ឋាន សាងសង់ នៅ ថ្ងៃទី ០៧ ខែមិថុនា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ប្រើប្រាស់ រយៈពេល សាងសង់ ៤៨ ខែ គ្រោង បញ្ចប់ ចុង ឆ្នាំ ២០២៧ ។
បច្ចុប្បន្ន នេះ ក្រុមហ៊ុន សាជីវកម្ម ស្ពាន ថ្នល់ ចិន (CRBC)ជា អ្នកទទួល សាងសង់ ដោយ បាន រៀបចំ ទីតាំង សម្រាប់ ការស្នាក់ នៅ ការិយាល័យ ឃ្លាំង និង កន្លែង រោង ជាង ផលិត គ្រឿង សំណង់ រួចរាល់ ។ ទន្ទឹម នឹង នោះ CRBC កំពុង សាងសង់ ផែ បណ្តោះអាសន្ន មួយ កន្លែង សម្រាប់ ដឹកជញ្ជូន សម្ភារៈ សំណង់ ដោយ សម្រេចបាន ៨០% ហើយ និង បាន រៀបចំ ផ្លូវ ចូល ការដ្ឋាន បាន រួចរាល់ ។
ឧបករណ៍ ខួង និង ឧបករណ៍ គ្រឿងចក្រ ផ្សេង ៗ និង សម្ភារៈ សំណង់ មួយចំនួន ទៀត សម្រាប់ បម្រើ ឱ្យ ការសាងសង់ បាន ត្រៀម រួចរាល់ សម្រាប់ នាំចូល ពី ប្រទេស ចិន អាចនឹង មកដល់ កម្ពុជា ក្នុង ពេល ឆាប់ ៗ ខាងមុខ ដើម្បី ដំណើរការចាប់ផ្ដើម សាងសង់ ។
ស្រប ពេល ជាមួយគ្នា នៃ ការបញ្ចប់ ការសាងសង់ ផ្លូវ ក្រវាត់ ក្រុង ទី៣ ដែល ត្រូវ ប្រសិទ្ធិ នាម ជា មហាវិថី ស៊ី ជីន ពីង ស្ពាន នេះ មាន សារសំខាន់ ដោយ តភ្ជាប់ ចរាចរណ៍ ភូមិសាស្រ្ត ភាគ ខាងលិច ទៅ ខាងកើត នៃ ទន្លេ មេគង្គ និង ភ្ជាប់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ បាវិត ដែល ជា ច្រក ដ៏ មាន សក្តានុពល សេដ្ឋកិច្ច ទេសចរណ៍ និង ភស្តុភាកម្ម ៕ តំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ ជំរុញ ដល់ ពុទ្ធ បរិស័ទ បន្ត ចូលរួម សហការ គ្នា បន្ថែម ទៀត ក្នុង ការកសាង សមិទ្ធផល ក្នុង វិស័យ ព្រះពុទ្ធ សាសនា
( កំពង់ធំ )៖ លោក ឃឹង នុភាព តំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ បាន ជំរុញ ដល់ ពុទ្ធ បរិស័ទ បន្ត សហការ គ្នា បន្ថែម ទៀត ដើម្បី ចូលរួមចំណែក កសាង សមិទ្ធផល នានា ក្នុង ទី វត្តអារាម ដើម្បី គាំទ្រ ដល់ វិស័យ ព្រះពុទ្ធ សាសនា ។
លោក បាន ថ្លែង ដូចនេះ នៅក្នុង ពិធី ឆ្លង សមិទ្ធផល នានា និង ពុទ្ធាភិសេក ព្រះពុទ្ធ បដិមា ចូល បរិនិព្វាន ១អង្គ នៅ វត្ត ពុទ្ធ និវេដ្ឋាន អ៊ុន នឹង ភ្នំ បារៀង នា ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២៤ ស្ថិត នៅ ភូមិ បាក់ ស្រី ឃុំ គោល ស្រុក ប្រាសាទ សំបូរ ។
លោក ឃឹង នុភាព បាន រំលេចឡើង នៅ ចំណុច សំខាន់ ៗ ចំនួន ៤៖
១. កោតសរសើរ ចំពោះ គណៈកម្មការ ចៅអធិការ ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ទាំងអស់ ដែល បាន ចូលរួម កសាង ហេដ្ឋារចនាសម្ព័ន្ធ ទី វត្តអារាម នេះ បង្ហាញ ឲ្យ ឃើញ ពី ការចូលរួម និង ការសហការ គ្នា បាន ល្អ ក្នុង ការគាំទ្រ វិស័យ ព្រះពុទ្ធ សាសនា ។
៤. គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការគិតគូរ ទៅ លើ យុវជន ចំនួន ១ លាន ៥ សែន នាក់ ដែល ត្រូវ បណ្ដុះបណ្ដាលឲ្យ មាន ជំនាញ ច្បាស់លាស់ ដោយ រាជ រដ្ឋាភិបាល ព្យាយាម បង្កើត វិទ្យាស្ថាន យ៉ាង ច្រើន នៅ ទូទាំង ប្រទេស ដើម្បីឲ្យ ពួកគេ មាន ជំនាញ មួយ ច្បាស់លាស់ ទី១ គឺ ជំនាញ សម្រាប់ ខ្លួន ឯង ទី ២ គឺ ជំនាញ សម្រាប់ ក្រុមហ៊ុន វិនិយោគ មាន ន័យ ថា ក្រុមហ៊ុន ត្រូវ មាន តម្រូវការសំខាន់ បំផុត គឺ កម្មករ ជំនាញ ដូច្នេះហើយ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ខិតខំ ផលិត ធនធាន មនុស្ស ស្រប តាម តម្រូវការ និង និង ទីផ្សារ ការងារ ។
( ភ្នំពេញ ) ៖ លោក ជិន ប៊ុន ធឿន សមាជិក គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ ត្រូវបាន តែងតាំង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ ឫស្សីកែវ ជំនួស លោក ឯក ឃុន ដឿន ដែល ត្រូវបាន តែងតាំង ជា សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ ។
ពិធី នេះ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២៤ នេះ ក្រោម អធិបតីភាព លោក ឃួង ស្រេង សមាជិក គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ និង លោក បណ្ឌិត អូស្មាន ហាស្សាន់ សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ មូលដ្ឋាន ខណ្ឌ ប្ញស្សីកែវ នៅ មជ្ឈមណ្ឌល ម៉ូឌែន៥ សង្កាត់ ឫស្សីកែវ ខណ្ឌ ឫស្សីកែវ ។
លោក ឃួង ស្រេង ក្នុង ឱកាស នោះ បាន ថ្លែង នូវ ការអរគុណ ចំពោះ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ ដែល បាន លះបង់ អស់ កម្លាំង កាយ ចិត្ត ដើម្បី គណបក្ស ប្រជាជន កម្ពុជា និង បាន បោះឆ្នោត ម ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល ធ្វើឲ្យ គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន ជ័យជំនះ ក្នុង ការដឹកនាំ ប្រទេស ជាតិ រហូតមកដល់ ពេលនេះ ។
លោក ឃួង ស្រេង ស្នើឲ្យ ប្រធាន គណៈកម្មការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ ប្ញស្សីកែវ ក្នុង នាម ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ បន្ត យកចិត្តទុកដាក់ ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ពិសេស ធ្វើ យ៉ាងណា ឲ្យ ភូមិ សង្កាត់ មាន សុវត្ថិភាព ។ បន្ត រឹតបន្តឹង ច្បាប់ ចរាចរណ៍ បង្រ្កាប គ្រឿងញៀន និង ល្បែងស៊ីសង ខុស ច្បាប់ គ្រប់ ប្រភេទ ទៅ តាម អនុសាសន៍ ណែនាំ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី ។
បន្ថែម ពី នេះ លោក ឃួង ស្រេង បាន ជំរុញ គណបក្ស ខណ្ឌ សង្កាត់ ត្រូវ ផ្ដល់ សេវា ជូន ប្រជាពលរដ្ឋ ឲ្យបាន លឿន និង មាន តម្លាភាព ដើម្បីឲ្យ ប្រជាពលរដ្ឋ គោរព ស្រលាញ់ ហើយ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បីឲ្យ គណបក្ស ប្រជាជន កម្ពុជា មាន ឱកាស អភិវឌ្ឍន៍ ប្រទេស សម្រេចបាន នូវ ចក្ខុវិស័យ ឲ្យ ក្លាយជា ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ក្លាយជា ប្រទេស មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
គួរ បញ្ជាក់ ថា ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី អ៉ីរ៉ង់ ខាងលើ នេះ ដំបូង ឡើយ គឺ ត្រូវ ធ្វើឡើង នៅ ឆ្នាំ ២០២៥ ឯណោះ ទេ ប៉ុន្តែ វា បាន ប្រព្រឹត្តទៅ មុនពេល កំណត់ បែប នេះ ដោយសារ ប្រធានាធិបតី លោក Ebrahim Raisi បាន ទទួលមរណភាព នៅក្នុង គ្រោះថ្នាក់ ធ្លាក់ ឧទ្ធម្ភាគចក្រ កាលពី ខែឧសភា ៕
( ភ្នំពេញ ) ៖ ផែនដី គឺជា ភព លំដាប់ ទី៣ក្នុង ប្រព័ន្ធ ព្រះអាទិត្យ ហើយ ចម្ងាយ ជា មធ្យម ពី ផែនដី ទៅ ព្រះអាទិត្យ ១៥០ លាន គីឡូម៉ែត្រ ។ បើ គេ និយាយ ចម្ងាយ ឆ្ងាយ បំផុត ១៥២ លាន គីឡូម៉ែត្រ និង ចម្ងាយ ជិត បំផុត ១៤៧ លាន គីឡូម៉ែត្រ ។
អង្កត់ផ្ចិត របស់ ព្រះអាទិត្យ មាន ប្រហែល១. ៣៩លាន គីឡូម៉ែត្រ ពោលគឺ ធំ ជាង ១០៩ ដង នៃ ផែនដី ហើយ ម៉ាស់ របស់ វា មាន ប្រហែលជា ៣៣០.០០០ ដង នៃ ផែនដី យើង មាន ន័យ ថា ប្រសិនបើ អ្នក ដាក់ ព្រះអាទិត្យ នៅលើ ជញ្ជីង នោះ អ្នក នឹង ត្រូវការវត្ថុ ៣៣០.០០០ ដង ដែល មាន ទម្ងន់ ស្មើនឹង ផែនដី ដើម្បីឲ្យ វា មាន សមាមាត្រ នឹង គ្នា ។
ប្រសិនបើ គ្មាន ព្រះអាទិត្យ ទេ ផែនដី ក៏ មិន អាច មាន ជីវិត ដែល រស់ នៅ នោះ ដែរ ព្រោះ ព្រះអាទិត្យ បាន បញ្ចេញ ពន្លឺ និង កម្ដៅ ដែល ផែនដី ត្រូវការ ដើម្បីឲ្យ មាន ជីវិត រស់ នៅ ។ ព្រះអាទិត្យ វិល មួយ ជុំ ម្ដង មាន រយៈពេល ២៧ ថ្ងៃ ។ ផែនដី យើង បាន វិល ជុំវិញ ព្រះអាទិត្យ ដោយ ប្រើ រយៈពេល ៣៦៥ ថ្ងៃ នៅក្នុង លម្ហ ។
គួរ បញ្ជាក់ ថា ក្រុម មេដឹកនាំ NATO នឹង ត្រូវ បើក កិច្ចប្រជុំ កំពូល នៅ រដ្ឋធានី វ៉ាស៉ីនតោន របស់ សហរដ្ឋ អាមេរិក រយៈពេល សរុប ៣ ថ្ងៃ ដោយ ចាប់ផ្តើម ពី ថ្ងៃអង្គារ សប្តាហ៍ ក្រោយ នា ឱកាស ខួប ទី៧៥ នៃ ការបង្កើត បក្ស សម្ព័ន្ធ យោធា នេះ ឡើង និង ស្រប ពេល ដែល កងកម្លាំង របស់ រុស្ស៉ី កំពុងតែ បន្ត ព្យាយាម វាយលុក រុល ទៅ មុខ នៅ តាម ខ្សែ បន្ទាត់ សមរភូមិ មុខ នៃ តំបន់ ភាគ ខាងកើត អ៊ុយក្រែន ក្នុង ឆ្នាំ ទី៣ នៃ សង្រ្គាម ៕
និយ័តករបរ ធន បាលកិច្ច រៀបចំ វេទិកា ស្ដីពី ការផ្សព្វផ្សាយ ផលិតផល ឥណទាន ( កម្ចី ) ដល់ សមាគម ស្វាយចន្ទី កម្ពុជា និង កសិករ ចិញ្ចឹម មាន់ ស្រុក នៅ ខេត្ត កំពង់ធំ
លោក ណី សាកល អគ្គ នាយក រង នៃ និយ័តករបរ ធន បាលកិច្ច ចូលរួម កាត់ កញ្ចប់ វិញ្ញាសារ ប្រឡង និង ប្រកាស បើក កម្មវិធី ប្រឡង គុណ វុឌ្ឍិក្នុង វិស័យ បរធន បាលកិច្ច លើក ទី៥
ក្រសួង សុខាភិបាល បាន ឲ្យដឹង ថា មាន អ្នកជំងឺ ផ្តាសាយ បក្សី ចំនួន ០១ករណី កើត លើ ក្មេងប្រុស អាយុ៣ ឆ្នាំ និង ត្រូវ បាន បញ្ជាក់ ថា វិជ្ជមាន វីរុស ផ្តាសាយ បក្សី ប្រភេទ ហាស់៥ អ៊ុន១ (H5N1) ពី វិទ្យាស្ថាន ជាតិ សុខភាព សាធារណៈ និង វិទ្យាស្ថាន ប៉ាស្ទ័រ នៅ ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២៤ ដែល មាន ទីលំនៅ ក្នុង ភូមិ ពោធិ៍ ឃុំ ប្រាសាទ ជាន់ ជុំ ស្រុក គីរីវង្ស ខេត្ត តាកែវ ។ ក្មេងប្រុស នេះ មាន គ្រុន ក្តៅ ក្អក ហត់ និង ពិបាក ដកដង្ហើម ។
បច្ចុប្បន្ន ស្ថានភាព អ្នកជំងឺ បាន ធូរស្រាល និង កំពុង ទទួលបាន ការថែទាំ យ៉ាង យកចិត្តទុកដាក់ ពីសំណាក់ ក្រុម គ្រូពេទ្យ ។ តាម ការសាកសួរ បង្ហាញ ថា ប្រហែល១០ ថ្ងៃ មុន ចាប់ផ្តើម ឈឺ នៅ ភូមិ មាន មាន់ ទា ងាប់ ហើយ នៅ ផ្ទះ អ្នកជំងឺ បាន យកមក ធ្វើ ម្ហូប បរិភោគ ក្មេងប្រុស បាន ប៉ះពាល់ និង កាន់ មាន់ ងាប់ ។
វិធានការ បង្កា រ៖ សូម លាង ដៃ ឲ្យ បាន ញឹកញាប់ ជាមួយ សាប៊ូ និង ទឹក មុនពេល បរិភោគ និង បន្ទាប់ពី ប៉ះពាល់ ជាមួយ បក្សី ដាក់ កុមារ នៅ ឆ្ងាយ ពី សត្វ បក្សី និង ដាក់ សត្វ បក្សី នៅ ឱ្យ ឆ្ងាយ ពី កន្លែង រស់ នៅ កុំ បរិភោគ សត្វ បក្សី ឈឺ ឬ ងាប់ និង រាល់ សត្វ បក្សី ដែល ធ្វើ សម្រាប់ បរិភោគ ត្រូវ ចំអិន ឲ្យ ឆ្អិន ល្អ ។
សម្រាប់ ព័ត៌មាន បន្ថែម សូម ទាក់ទង លេខ ទូរស័ព្ទ ទាន់ ហេតុការណ៍ របស់ ក្រសួង សុខាភិបាល លេខ ១១៥ ដោយ ឥត គិត ថ្លៃ ៕
នៅ ថ្ងៃទី ៦ ខែកក្កដា ឆ្នាំ ២០២៤ នេះ ក្បាល ម៉ាស៊ីន គណបក្ស ភ្លើង ទៀន និង ឆន្ទៈ ខ្មែរ ក្នុង ស្រុក កូនមុំ ខេត្ត រតនគិរី ចំនួន ៦រូប ទៀត បាន ប្រកាស ផ្តាច់ ខ្លួន ពី បក្ស ប្រឆាំង និង ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ធ្លាប់ រួមរស់ និង ធ្វើ សកម្មភាព នយោបាយ បម្រើ អស់ ជាច្រើន ឆ្នាំ មកហើយ ។
ពួកគេ ក៏ បាន អំពាវនាវ ដល់ អ្នកបម្រើ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក និង ឈប់ ចាញ់បោក បក្ស ប្រឆាំង បន្ត ទៅ ទៀត ហើយ ចូលរួម សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រជាជន កម្ពុជា ដើម្បី កសាង ជាតិ មាតុភូមិ ឱ្យ រុងរឿង ៕ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អនុញ្ញាតឱ្យ រដ្ឋមន្ត្រី ការបរទេស ជប៉ុន ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ
សូម បញ្ជាក់ ថា លោកស្រី រដ្ឋមន្ត្រី ការបរទេស ជប៉ុន កំពុង បំពេញ ទស្សនកិច្ច នៅក្នុង ប្រទេស កម្ពុជា ដើម្បី ជំរុញ នូវ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា និង ជប៉ុន ៕
រាជ រដ្ឋាភិបាល ចេញ សារាចរ ស្តីពី ការរៀបចំ ក្រុមការងារ តាមដាន ត្រួតពិនិត្យ និង វាយតម្លៃ ការអនុវត្ត យុទ្ធសាស្ត្រ ផែនការអភិវឌ្ឍន៍ និង គោល នយោបាយ នានា នៅ តាម ក្រសួង ស្ថាប័ន
( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ចេញ សារាចរ ស្តីពី ការរៀបចំ ក្រុមការងារ តាមដាន ត្រួតពិនិត្យ និង វាយតម្លៃ ការអនុវត្ត យុទ្ធសាស្ត្រ ផែនការអភិវឌ្ឍន៍ និង គោល នយោបាយ នានា នៅ តាម ក្រសួង ស្ថាប័ន ៕
ខាងក្រោម នេះ ជា សារាចរ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា៖
អគ្គ លេខាធិការ រង UN កោតសរសើរ ភាពជោគជ័យ របស់ កម្ពុជា ដែល ប្រែក្លាយ ពី ប្រទេស ទទួល កម្លាំង ពី អង្គការ UN មក ជា ប្រទេស បញ្ជូន កម្លាំង ចូលរួម យ៉ាង សកម្ម ក្នុង បេសកកម្ម រក្សា សន្តិភាព
ការកើត សរសើរ បែប នេះ របស់ អគ្គ លេខាធិការ រង អង្គការ សហ ប្រជាជាតិ នៅក្នុង ជំនួប ពិភាក្សា ការងារ រវាង នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ និង ជា អគ្គ នាយក មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព នា ព្រឹក ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២៤ ។
នាយ ឧត្តមសេនីយ៍ បាន លើកឡើង ថា ក្នុង ឆ្នាំ ២០០៦ កម្ពុជា ចាប់ផ្តើម បោះជំហាន ទៅ មុខ ដោយ ការបញ្ជូន កងកម្លាំង ទៅកាន់ សាធារណរដ្ឋ ស៊ូ ដង់ លើក ដំបូង ហើយ ឆ្នាំ ២០២៤ នេះ មាន រយៈពេល ១៨ ឆ្នាំ ក្នុង បេសកកម្ម រក្សា សន្តិភាព របស់ អសប កម្ពុជា បាន បញ្ជូន កងកម្លាំង សរុប ៩៥៧៩ នាក់ ក្នុង នោះ នារី ៨១៨ នាក់ ទៅកាន់ ប្រទេស ចំនួន ១០ និង ១២បេសកកម្ម ។
នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន បន្ថែម ថា បច្ចុប្បន្ន កម្ពុជា កំពុង មាន ភាពលេចធ្លោ ក្នុង ការបញ្ជូន មេ កង ជា នារី ចំនួន ៣នាក់ ទៅកាន់ តំបន់ បេសកកម្ម រួម មាន សាធារណរដ្ឋ អាហ្រ្វិក កណ្តាល លី បង់ និង ស៊ូ ដង់ ខាងត្បូង ។
ទន្ទឹម នោះ អាត្រា ក្នុង ការបញ្ជូន កងកម្លាំង ជា នារី របស់ កម្ពុជា ទៅ តំបន់ បេសកកម្ម មាន ប្រមាណ ១៧.២ភាគរយ ដោយ នាយ ឧត្តមសេនីយ៍ ក៏ បាន ប្តេជ្ញា បន្ត បង្កើន ចំនួន យោធិន នារី បន្ថែម ផងដែរ ។
លោក បាន ថ្លែងអំណរគុណ ជាថ្មី ម្តង ទៀត ចំពោះ កម្ពុជា ដែល បាន បរិច្ចាគ កម្លាំង ក្នុង បេសកកម្ម រក្សា សន្តិភាព ក្រោម ឆ័ត្រ អសប ជាពិសេស ក៏ បាន ឃើញ ពី ការចូលរួម មិន ត្រឹមតែ ពីសំណាក់ បុរស ទេ គឺ ពីសំណាក់ យោធិន នារី ក្នុង បេសកកម្ម របស់ អង្គការ សហ ប្រជាជាតិ ទៅកាន់ ប្រទេស មួយចំនួន ផងដែរ ។
មិន ត្រូវ បើកបរ លើស ល្បឿន កំណត់ ជាដាច់ខាត ! ស្លាប់ ៥នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៥ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ធ្ងន់ ស្រាល ១០នាក់ ។
សាធារណរដ្ឋ កូរ៉េ ផ្តល់ ជូន គ្រឿងចក្រ វិស្វកម្ម ជា លើក ទី២ ដល់ កម្ពុជា សម្រាប់ គម្រោង ហ្វឹកហ្វឺន ត្រី ភាគី កម្ពុជា - កូរ៉េ - អសប
( កំពង់ស្ពឺ ) ៖ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ និង ជា អគ្គ នាយក មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព នា ព្រឹក ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០២៤ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ផ្ទេរ និង ប្រគល់ គ្រឿងចក្រ វិស្វកម្ម ជា លើក ទី២ ដែល ជា ជំនួយ ឥត សំណង របស់ សាធារណរដ្ឋ កូរ៉េ ផ្តល់ ជូន កម្ពុជា សម្រាប់ គម្រោង ហ្វឹកហ្វឺន ត្រី ភាគី កម្ពុជា - កូរ៉េ - អសប ខាងមុខ នេះ ។
នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន ថ្លែង ថា ការផ្តល់ ជំនួយ គ្រឿងចក្រ វិស្វកម្ម នា ពេលនេះ គឺជា សក្ខីភាព នៃ ការស្តា ចំណង មិត្តភាព ការទូត កម្ពុជា - កូរ៉េ តាមរយៈ ការអញ្ជើញ ទស្សនកិច្ច សាធារណរដ្ឋ កូរ៉េ ជា លើក ដំបូង របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។ ក្នុង ដំណើរទស្សនកិច្ច នេះ ដែរ ភាគី គូរ៉េ បាន ផ្តល់ ជំនួយ ឥត តំណង ដល់ កម្ពុជា ក្នុង ទំហំ ទឹកប្រាក់ សរុប ១លាន ដុល្លារ ហើយ ជំនួយ នេះ សម្តេច តេជោ ត្រូវបាន ស្នើ ប្តូរ ជា គ្រឿងចក្រ ជំនួស វិញ ។
ទន្ទឹមនឹង ការផ្តល់ ជូន គ្រឿងចក្រ ជា លើក ទី២ កម្ពុជា - កូរ៉េ ក៏ បាន បន្ត ចុះ អនុស្សរណ នៃ ការយោគយល់ ស្ដីពី ប្រតិបត្តិការ រក្សា សន្តិភាព រវាង កម្ពុជា - កូរ៉េ និង ផ្តល់ គ្រឿងចក្រ ជា លើក ទី៣ សម្រាប់ ប្រើប្រាស់ ក្នុង គម្រោង ហ្វឹកហ្វឺន ត្រី ភាគី នា ចុង ឆ្នាំ ២០២៤ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី។ គ្រឿងចក្រ ដែល ផ្តល់ ជូន ជា លើក ទី៣ នេះ នឹង មកដល់ កម្ពុជា នា ខែតុលា ខាងមុខ នេះ ។
នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន ថ្លែងអំណរគុណ ចំពោះ រដ្ឋាភិបាល កងទ័ព និង ប្រជាជន នៃ សាធារណរដ្ឋ កូរ៉េ ក្នុង ការជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព ដើម្បី បន្ត រួមចំណែក ក្នុង កិច្ចការ រក្សា សន្តិភាព ដើម្បី បុព្វហេតុ សន្តិភាព និង សន្តិសុខ ក្នុង លោក ៕ ជនជាតិ ប៉ាឡេស្ទីន ៧នាក់ បាន ស្លាប់ នៅក្នុង ការវាយប្រហារ របស់ អ៊ីស្រាអែល ទៅ លើ ទីក្រុង Jenin ភាគ ខាងជើង តំបន់ West Bank
ប្រភព សន្តិសុខ ប៉ាឡេស្ទីន បាន ប្រាប់ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ ថា យន្តហោះ គ្មាន មនុស្ស បើក របស់ អ៊ីស្រាអែល បាន កំណត់ គោលដៅ លើ ក្រុម យុវជន នៅក្នុង ជំរុំ Jenin ហើយ កងកម្លាំង អ៊ីស្រាអែល បាន ឡោមព័ទ្ធ ផ្ទះ មួយ នៅ ខាងលិច ទីក្រុង Jenin ចំពេល មាន ការបាញ់ប្រហារ គ្នា ជាមួយ ពួក សកម្ម ប្រយុទ្ធ ប៉ាឡេ ស្ទីន ។
ក្រសួង ការពារ ជាតិ អ៊ីស្រាអែល បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ កាលពី ថ្ងៃសុក្រ ថា ទាហាន របស់ ខ្លួន បាន អនុវត្ត សកម្មភាព « ប្រឆាំង ភេរវកម្ម » នៅក្នុង តំបន់ Jenin ។
សេចក្តីថ្លែងការណ៍ បាន និយាយ ថា « ទាហាន បាន ឡោមព័ទ្ធ អគារ មួយ ដែល ពួក ភេរវករ ត្រូវបាន លាក់ ទុក ហើយ ទាហាន អ៊ីស្រាអែល បាន បាញ់ តបត ជាមួយ ភេរវករ ។ ក្នុង អំឡុង ពេល នៃ ការបាញ់ប្រហារ នោះ យន្តហោះ របស់ កងទ័ព អ៊ីស្រាអែល បាន ទម្លាក់ គ្រាប់បែក ទៅ លើ ភេរវករប្រដាប់អាវុធ ជាច្រើន នាក់ នៅក្នុង តំបន់ » ។
គួរ បញ្ជាក់ ថា ទីក្រុង Jenin និង ជំរំជនភៀសខ្លួន បាន និង កំពុង មើលឃើញ ភាពតានតឹង ខ្លាំង អស់ រយៈពេល ជាង ២ឆ្នាំ មកហើយ ដោយ ភាពតានតឹង នេះ កាន់តែ ខ្លាំង ឡើង ចាប់តាំងពី ការផ្ទុះឡើង នៃ ជម្លោះ ប៉ាឡេ ស្ទីន - អ៊ីស្រាអែល នៅ ដើម ខែតុលា ឆ្នាំ ២០២៣ ។
