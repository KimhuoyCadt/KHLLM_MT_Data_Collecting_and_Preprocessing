( បាត់ដំបង ) ៖ ខេត្ត បាត់ដំបង នឹង អនុវត្ត យុទ្ធនាការ « ផ្ទះ មួយ ខ្នង ដើមឈើ មួយ ដើម » ចាប់ពី សប្តាហ៍ ក្រោយ ។ នេះ បើ តាម កិច្ចប្រជុំ អំពី យុទ្ធនាការ ផ្ទះ មួយ ខ្នង ដើមឈើ មួយ ដើម ដែល ធ្វើឡើង ក្រោម អធិបតីភាព លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង នា ថ្ងៃទី ៥ ខែកក្កដា ។
លោក សុខ លូ បាន លើកឡើង ថា សម្រាប់ យុទ្ធនាការ ផ្ទះ មួយ ខ្នង ដើមឈើ មួយ ដើម នេះ គឺ ដាំ សំដៅ បម្រើ ដល់ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ និង សូម ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម ថែរក្សា ដើមឈើ ដែល បាន ដាំ ដើម្បី ជា ផលប្រយោជន៍ របស់ ពួកគាត់ នៅពេល ខាងមុខ នេះ ។
ការថ្លែង របស់ លោក អ៊ុក គឹម សាន ក្នុង ឱកាស ដែល លោក តំណាង លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ ដោយ មាន ការចូលរួម ពី ក្រុមការងារ នៅ ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២៤ បាន ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ និង នាំ អំណោយ មួយចំនួន របស់ លោក គីម រិទ្ធី ប្រគល់ ជូន ក្រុមការងារ យុវជន ស្ម័គ្រចិត្ត វាស់វែង ដីធ្លី របស់ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ដែល កំពុង បំពេញ ភារកិច្ច វាស់វែង ដីធ្លី នៅក្នុង ស្រុក រវៀង ។
លោក អ៊ុក គឹម សាន ក៏ បាន ថ្លែង ណែនាំ ដល់ លោក មេភូមិ មេឃុំ និង ប្រជាពលរដ្ឋ ទូទាំង ស្រុក រវៀង ត្រូវ ជួយសហការ និង យកចិត្តទុកដាក់ ជាមួយ ក្រុមការងារ យុវជន ស្ម័គ្រចិត្ត ដែល ចុះ មក វាស់វែង ដីធ្លី ជូន ប្រជាពលរដ្ឋ ត្រូវ ចាត់ទុក ពួកគាត់ ដូច បងប្អូន កូន ចៅ ជា ក្រុមគ្រួសារ តែ មួយ ដោយសារតែ ពួកគាត់ ជា អ្នក មកពី ឆ្ងាយ តាម បណ្តាល ខេត្ត និង រាជធានី ភ្នំពេញ បាន ខិតខំ វាស់វែង ដីធ្លី ជូន បងប្អូន ដើម្បី បងប្អូន ទទួលបាន កម្មសិទ្ធ ដីធ្លី ដោយ ស្រប ច្បាប់ ។
បើ តាម របាយការណ៍ របស់ លោក សីន ម៉េង ឡាំ ប្រធាន ក្រុមការងារ យុវជន ស្ម័គ្រចិត្ត បាន ថ្លែង ថា៖ ក្រុមការងារ យុវជន ស្ម័គ្រចិត្ត របស់ លោក បាន មកដល់ ស្រុក រវៀង នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៤ ហើយ បាន បំពេញ ការងារ នៅ តាម ឃុំ ចំនួន ៣ និង ភូមិ ចំនួន ៩។ គិត ត្រឹម ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០២៤ នេះ ក្រុមការងារ របស់ លោក បាន វាស់វែង ក្បាល ដី ជូន ប្រជាពលរដ្ឋ សរុប ចំនួន ២៦៤៦ ក្បាល ដី ។
សូម បញ្ជាក់ ថា អំណោយ របស់ លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ ដែល នាំយក ទៅ ប្រគល់ ជូន ក្រុមការងារ យុវជន ស្ម័គ្រចិត្ត វាស់វែង ដីធ្លី របស់ ក្រសួង រៀបចំ ដែនដី នគរ រូបនីយកម្ម និង សំណង់ នា ពេលនេះ រួម មាន៖ ថវិកា ចំនួន ៥លាន រៀល អង្ករ ចំនួន ៣០០ គីឡូក្រាម ត្រីខ ចំនួន ៣០យួរ មី ចំនួន ៣០ កេស ទឹក បរិសុទ្ធ ដប ធំ ចំនួន ៣០យួរ និង មុង ចំនួន ៣០ ផងដែរ ៕ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ ផ្ដល់ គោរមងារ ឧកញ៉ា ជូន លោក លុក ស៉ី ដូរ៉េ
សូម ជម្រាប ថា លោក ឧកញ៉ា លុក ស៉ី ដូរ៉េ ជា ពាណិជ្ជករ ជោគជ័យ ម្នាក់ និង ជា អគ្គ នាយក ក្រុមហ៊ុន ចំនួន ៣រួម មាន៖
ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក រវៀង ខេត្ត ព្រះវិហារ ជំរុញ ក្រុមការងារ និង អាជ្ញាធរ មូលដ្ឋាន រួមគ្នា ដោះស្រាយ បញ្ហា ប្រឈម នានា នៅ តាម មូលដ្ឋាន ឱ្យ មាន ប្រសិទ្ធភាព តម្លាភាព
( ព្រះវិហារ ) ៖ លោក អ៊ុក គឹម សាន អភិបាល រង ខេត្ត ព្រះវិហារ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក រវៀង និង ឃុំ ទាំង ១២ បាន ថ្លែង ណែនាំ ដល់ ក្រុមការងារ ក៏ ដូចជា អាជ្ញាធរ មូលដ្ឋាន ភូមិ ឃុំ ស្រុក និង សមត្ថកិច្ច ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ រួម សហការ គ្នា ដោះស្រាយ បញ្ហា ប្រឈម នានា របស់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ឱ្យ មាន ប្រសិទ្ធិភាព តម្លាភាព និង អាច ទទួលយក បាន ។
ការថ្លែង របស់ លោក អ៊ុក គឹម សាន ក្នុង ឱកាស ដែល លោក ដឹកនាំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆមាស ទី១ និង ទិសដៅ ភារកិច្ច បន្ត ឆមាស ទី២ របស់ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក រវៀង និង ឃុំ ទាំង ១២ ដោយ មាន ការចូលរួម ពី លោក លោកស្រី ជា ក្រុមការងារ អាជ្ញាធរ ស្រុក ឃុំ ភូមិ សមត្ថកិច្ច ពាក់ព័ន្ធ ក៏ ដូចជា ដៃគូរ អភិវឌ្ឍ និង វិស័យ ឯកជន ជាច្រើន រូប ទៀត នៅ រសៀល ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២៤ ។
នៅក្នុង ឱកាស នេះ ដែរ លោក អ៊ុក គឹម សាន បាន ថ្លែង នាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី លោក នាយ ឧត្តមសេនីយ៍ ម៉ៅ សុផាន់ ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ ផ្ញើ ជូន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក រៀង ថ្នាក់ដឹកនាំ ស្រុក ឃុំ ភូមិ និង សមត្ថកិច្ច ពាក់ព័ន្ធ ទាំងអស់ នៅ ស្រុក រវៀង ក៏ ដូចជា ជូនពរ ឱ្យ ក្រុមការងារ បន្ត បេសកកម្ម របស់ ខ្លួន នៅក្នុង ស្រុក រវៀង ឱ្យ ទទួលបាន ជោគជ័យ ។
នៅក្នុង កិច្ចប្រជុំ របស់ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូល នាដ្ឋាន ស្រុក រវៀង ដែល ដឹកនាំ ដោយ លោក អ៊ុក គឹម សាន នា ពេលនេះ គឺ លោក យកចិត្តទុកដាក់ ស្តាប់ នូវ របាយការណ៍ ស្តីពី លទ្ធផល ការងារ ប្រចាំ ឆមាស ទី១ និង ទិសដៅ ភារកិច្ច បន្ត ឆមាស ទី២ ឆ្នាំ ២០២៤ ក៏ ដូចជា បទ អន្តរាគមន៍ របស់ ឃុំ ចំនួន ៦ និង ការិយាល័យ អប់រំ ស្រុក ការិយាល័យ កសិកម្ម ស្រុក មេបញ្ជាការ កងរាជអាវុធហត្ថ ស្រុក ដើម្បី ស្តាប់ ពិភាក្សា ដោះស្រាយ បញ្ហា ប្រឈម ដែល បាន លើកឡើង ខាងលើ នេះ ឱ្យ មាន ប្រសិទ្ធិភាព ។
