រឿង មាន សភាព កាន់តែ ធ្ងន់ធ្ងរ នៅ ពេល ដែល ដើម កោងកាង បាន បដិសេធ ។
លោក នាយក រដ្ឋមន្ត្រី បន្ត ថា ករណី ទាំង នេះ កើតឡើង ដោយសារតែ មិន មាន ច្បាប់ អង្គការ សម្រាប់ គ្រប់គ្រង ។
មាន គន្លឺះ ច្រើន ណាស់ ក្នុង ការជួញដូរ ភាគហ៊ុន !
ឃើញ ទេ កម្មករ រោងចក្រ ពួកគេ វេទនា យ៉ាងណា ធ្វើ ការចង់ ងាប់ បាន ប្រាក់ខែ មិន ដល់ ១០០ ដុល្លា ហើយ ត្រូវ មក រង អំពើ អយុត្តិធម៌ ទៀត ។
បច្ចុប្បន្ន យើង មាន អតីត និស្សិត មួយចំនួន កំពុង បម្រើ ការងារ នៅ ក្រុមហ៊ុន សំណង់ អន្តរជាតិ នៅក្នុង ប្រទេស កម្ពុជា ។
ទុន វិនិយោគ កំលាំង ពលកម្ម តម្លៃ ពលកម្ម ក្នុង វិស័យ សំណង់ ឆ្នាំ …
ពី ថ្ងៃចន្ទ ថា ហេតុការណ៍ នោះ
តាម ច្បាប់ របស់ អាហ្វហ្គានីស្ថាន កំណត់ អាយុ រៀបការ ដោយ ស្រប ច្បាប់ របស់ នារី គឺ ១៦ ឆ្នាំ ប៉ុន្តែ តាម ទិន្ន័យ របស់ អង្គការ ជួយសង្គ្រោះ កុមារ ឃើញ ថា មាន ប្រហែល ១៥% នៃ ស្ត្រី អាហ្វហ្គានីស្ថាន អាយុ ក្រោម ៥០ ឆ្នាំ បាន ទទួលស្គាល់ ថា រៀបការ មុន អាយុ ១៥ ឆ្នាំ និង ជិត ពាក់កណ្តាល ប្រាប់ ថា រៀបការ មុន អាយុ ១៨ ឆ្នាំ ។
រងចាំ ទស្សនា ទាំងអស់ គ្នា តើ ថា អ៊ែល ច័ន្ទ ដារ៉ា អាច ស្តា កិត្តិយស ខ្លួន វិញ បាន ឬ យ៉ាងណា ។
អត់ មាន បំណង អាក្រក់ ឯណា សុទ្ធតែ បំណង ល្អ ទាំងអស់ ហ្នឹង !
តើ អ្នក ធ្លាប់ បារម្ភ ថា ចំណេះដឹង អំពី ការព្យាបាល របួស របស់ អ្នក ជា ជំនឿ ដែល មិន ត្រឹមត្រូវ ទេ ?
ឡុងដ៍ ចក្រភព អង់គ្លេស
នៃ ស្រុក យើង ដែល ក្រុមការងារ កំពុងតែ រិះរក កន្លែង ថត ថ្មី ប្លែក ៗ
ពួក អ្នកដំណើរ បាន ត្រូវ ជម្លៀស ទៅកាន់ កន្លែង មាន សុវត្ថិភាព ហើយ គ្មាន នរណា ម្នាក់ បាន រងរបួស ទេ ។
ការចេញ អាជ្ញាប័ណ្ណ សាងសង់ នឹង ត្រូវបាន កាត់បន្ថយ ពី ៣០ ថ្ងៃ មក នៅ ត្រឹម ២២២៥ ថ្ងៃ ដែល ជា ផ្នែក មួយ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ដើម្បី សម្រេចបាន នូវ ដំណោះស្រាយ របស់ រដ្ឋាភិបាល លើ ការធ្វើឱ្យ ប្រសើរឡើង នៃ បរិយាកាស អាជីវកម្ម និង ការប្រកួតប្រជែង ថ្នាក់ ជាតិ ព្រមទាំង ដំណោះស្រាយ គាំទ្រ ការអភិវឌ្ឍ ពាណិជ្ជកម្ម ៕
ករណី គ្រោះថ្នាក់ ចរាចរ ណ៏ លើ សម្តេច ក្រុម ព្រះនិង អ្នក ម្នាង អ៊ុក ផល្លា កើតឡើង ដោយសារ អ្នកបើក
ពេក កន្លងចរចា ម្នាក់ឯង គ្មាន ឮ សំឡេង ឆ្លើយឆ្លង ដួងចិត្ត អាណិត បង ផង ព្រោះតែ បង នៅ ស្នេហា ។
ប៉ុន្តែ ករណី អ្នក មាន ហើយ ថែមទាំង ជា ដៃគូរកស៊ី ជាមួយគ្នា ក្លែង ឯកសារ យក ដី គ្នា ឯង ជា រឿង ដែល គេ កម្រ ឮ ណាស់ ។
បទ គម្ពីរ រៀបរាប់ អំពី របៀប ដែល មនុស្ស ដំបូង បាន បាត់បង់ ឯក សិទ្ធិ រស់ ជារៀងរហូត នៅ ផែនដី ដែល ជា សួន ឧទ្យាន និង អំពី របៀប ដែល ផែនដី នឹង ក្លាយទៅជា សួន ឧទ្យាន ម្តង ទៀត ។
គាត់ និង ក្រុមគ្រួសារ ក៏ ដូចជា បងប្អូន ក្នុង ភូមិ និង បន្ត បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជនជា បន្ត ទៀត ៕
បើ នារី ណា អនុវត្ត ប្រស ចាាក សីលធម៌ នារី នោះ ត្រូវ ទទួល ទណ្ឌកម្ម ពី គ្រួសារ និង ពី សង្គម ។
សម្ភារៈ សរសៃ សំយោគ
ិវ្ល ចូិត្ត ហើយ នាង គិត ថា នាង កំពង
ការមាន ទំនួល ខុសត្រូវ ចំពោះ បរិស្ថាន សហគមន៍ និង បុគ្គលិក របស់ យើង បាន ក្លាយជា កត្តា ដែល មាន សារៈសំខាន់ កាន់តែ ខ្លាំង ឡើង សម្រាប់ អាជីវកម្ម នា ពេល បច្ចុប្បន្ន ។
ការអភិវឌ្ឍ មូលធន មនុស្ស គឺជា កត្តា ចាំបាច់ ។
សង្ខេប ការវិភាគ មិន ទំនង ។
មនោសោចេយ្យ ប្រែ ថា ស្អាត ចិត្ត ។
លោក បាន ឱ្យដឹង ថា រាល់ ឆ្នាំ សហគមន៍ លោក បាន ប្រើប្រាស់ ទឹក ពី ទន្លេ ស្រែ ពក ។
តំណាង ស្ថាប័ន កីឡា កំពូល រូប នេះ បន្ត ថា ៖
អថា បិវិហរិស្សន្តិឯ សាពុទ្ធាន ធម្មតា
ចាប់ បាន ក្រុម ចែកចាយ គ្រឿងញៀន នៅ ផ្ទះសំណាក់ ដាលី ន
កាហ្វេ រសជាតិ ដើម ដ៏ ឈ្ងុយ ឆ្ងាញ់ នេះ និង មុខ ម្ហូប ពិសេស ៗ
៨ បន្តិច ក្រោយមក លោក ដាវីឌ ក្រោក ឡើង ចេញ ពីរ អាង ភ្នំ ហើយ ស្រែក ពីក្រោយ ព្រះបាទ សូល ថា ៖
ប្រជាពលរដ្ឋ ឆ្លង ឆ្នាំ ចាស់ ចូល ឆ្នាំ សប្បាយរីករាយ ដោយសារ មាន សន្តិភាព
រុះរើ គណៈ រដ្ឋមន្ត្រី ព្រម ជាមួយនឹង ការបំបែក ក្រសួង ថ្មី ទៀត ឱ្យ សំពីង សំពោង ?
ប្រជាពលរដ្ឋ គាត់ សុំ ថត រូប អោប ស្អី ៗ
អ្វី ដែល សំខាន់ គឺ ការចំអន់ គ្នា ក៏ ត្រូវ មាន កម្រិត ។
តារា សម្តែង អ្នកនាង គឹម លីហ្សា ។
នគរបាល កំពុង សួរនាំ អ្នក ដែល ពាក់ព័ន្ធ ។
ដើម្បី ពិចារណា រឿង នេះ មិត្ត អ្នកអាន គប្បី អាន កូន រឿង នេះ បន្តិច ។
នេះ បើ យោង ទៅតាម លោក ស្រ៊ិន សុខ មាន ម្ចាស់ ស្នាដៃ នៅក្នុង ពិព័រណ៍ រូបថត នេះ ។
ទៀត នៃ ប្រទេស ជប៉ុន ។
១ មិន ឱ្យ និយាយ ទាក់ទង គ្នា ដាច់ខាត ទោះជា ស្គាល់ ឫ មិន ស្គាល់ ។
កញ្ញា ពេជ្រ ថា វរ៉ា បាន បន្ថែម ថា ៖
មាន ទទួល រៀបចំ និង តម្លើង កាមេរ៉ា សុវត្តិភាព តាម ផ្ទះ បុរី សដ្ឋាគារ ក្រុមហ៊ុន ។
សុទ្ធតែ ប្រើ កម្មវិធី លើ ទូរស័ព្ទ ។
រដ្ឋបាល ព្រៃឈើ ស្រុក សណ្តាន់ ដេក លក់ អស់ ហើយ
ជា ប្រត្យក្ស បុគ្គល គ្រប់ រូប មាន រយៈពេល ២៤ ម៉ោង ក្នុង មួយ ថ្ងៃ ដូចគ្នា ។
ឯកសារ នានា ទាក់ទង នឹង ការសាក់ បង្ហាញ ថា ការសាក់ មាន អាយុកាល ជាង ប្រាំ ពាន់ ឆ្នាំ មកហើយ ។
ចុងបញ្ជប់ លោក បាន បញ្ជាក់ ថា កុំ សប្បាយ លេង កម្មវិធី តែ បង្កើត ថ្មី ផង ។
ជ្រោយ ណុតុ វិគី ភីឌា
កុំ សៀវ សែ ភ្លើង ថៃ ម៉ាក្បាល ដំរី ចំណុះ 2លីត្រ
ខ្សែ ដេរ នៃ ស្នាម វះ ត្រូវ បាន ធ្វើ ក្នុង រន្ធ ច្រមុះ ហេតុ ដូចនេះ វា មិន បន្សល់ទុក ស្នាម វះ ណាមួយ នោះ ឡើយ ។
ការលេងសើច របស់ ខ្ញុំ សង្ឃឹម ថា ឆាយ៉ា មិន ប្រកាន់ រ៉េហនុ មាន ខ្ញុំ តែ ប៉ណ្ណឹង ទៅ ហើយ !
ចំពោះ ខ្ញុំ តឹត ថា អ្វី ដែល សំខាន់ បំផុត គឺ ត្រូវ រស់ នៅ ដោយ សុភមង្គល និង មាន សុខភាពល្អ ។
ចម្ងាយ ពី ទីផ្សារ ចាស់ ៖
ចំណែកឯ អ្នក ប្រណាំង ដទៃ គឺ គ្រាន់តែ ជា បេក្ខជន ដែល ស្រឡាញ់ កីឡា ប្រណាំង កង់ ប៉ុណ្ណោះ ។
គេហទំព័រ របស់ យើង អាច មាន តំណ ភ្ជាប់ ទៅ បណ្តា គេហទំព័រ ផ្សេង ៗ
៤សំយោគ សញ្ញា រឺ ផាត់ លើ័
ដី លក់ មាន ទីតាំង ល្អ តម្លៃ ក្រោម ទីផ្សារ
២ វិស័យ នេះ មាន សក្តានុពល ក្នុង ការបង្កើត ការងារ ថ្មី ជាពិសេស យុវជន ។
ទាំងអស់ ហើយក៏ មិន មាន លទ្ធភាព ដើម្បី ធ្វើ សង្គ្រាម ពេញ ទំហឹង ជាមួយនឹង សហរដ្ឋ អាមេរិក បាន ដែរ ៕
គួរ បញ្ជាក់ ឱ្យដឹង ផងដែរ ថា បច្ចុប្បន្ន នេះ កញ្ញា ពៅ បញ្ញា ពេជ្រ កំពុង សម្រាក ព្យាបាល ជម្ងឺ នៅឯ ប្រទេស ថៃ ៕
បាតុភូត នេះ វា បាន កើតមាន បន្ទាប់ពី អាកាសធាតុ ដ៏ ត្រជាក់ ទើប បាន កន្លងផុត ទៅ ។
កាល ស្ពាន យោល នៅ ដំណើរការឆ្លងកាត់ ស្ទឹង ទៅ មក បាន គឺ មនុស្ស ធំ ក្នុង
អាច មើល ការប្រកួត កីឡា ពី ថ្នាក់រៀន ផ្ទាល់ របស់ ពួកគេ ។
ឆប នឹង មនុស្ស ឆ្នាំ មមែ ពពែ និង មនុស្ស ឆ្នាំ កុរ ជ្រូក
អ្វី ដែល ធ្វើឱ្យ មាន ការចាប់អារម្មណ៍ ភាគី រថយន្ត របស់ លោក ឧត្តមសេនីយ៍ ហាក់ដូចជា មិន ទទួល នូវ កំហុស ឡើយ ។
មាន ចំពោះ ប្រជាជន របស់ លោក ទៅ អនាគត ដ្បិត មាន និមិត្ត ហេតុ អស្ចារ្យ មួយ សំរាប់ គ្រា នោះ ដែរ ។
មីង ខ្ញុំ ទ្រាំង លែង ចង់បាន ហើយ មីង អាស ។
លោក ត្រូវបាន រដ្ឋាភិបាល បណ្តេញ ចេញ ពី ប្រទេស កម្ពុជា ក្នុង ឆ្នាំ ២០១៥ ។
កាមេរ៉ា ក្រោយ ៤គ្រាប់
ឆ្នាំ នេះ នាង អាយុ ៣១ ឆ្នាំ គត់ ហើយ ពេលនេះ នាង បាន ជាប់ ជា សមាជិក វ័យ ក្មេង បំផុត ទីក្រុង ហាជី ណូហ៊ី ខេត្ត អាម៉ូរី ។
ចង់ឱ្យ កូន សុខភាព ល្អ ម៉ាក់ ប៉ា ត្រូវ ដឹង របៀប បង្រៀន កូន ឱ្យ ចេះ ញ៉ាំ អាហារ
ដំបូង ប្រព្រឹត្តទៅ ក្នុង ភាពស្ងប់ស្ងាត់ ក្បួន ដង្ហែរ ដើម្បី បរិយាកាស ភ្លាម ៗ
តើ អ្នក ត្រូវការ លុយ ប៉ុន្មាន ?
ជម្រះ ការសន្ទនា ទាំងអស់ ។
ទៀត ព្រមទាំង ទស្សនិកជន សរុប ចំនួន ជិត មួយ ពាន់ នាក់ បាន ចូលរួម ។
រីឯ រូប ខាងក្រោម វិញ ពិតជា ធ្វើអោយ អ្នក ដែល បាន ឆ្លងកាត់ ប្លែក ចិត្ត មិន សរសើរ មិន បាន ៖
លោក ឧកញ៉ា ឌួង ឆាយ ឡាយ វីដេអូ ប្រកាស លើកលែង ទោស នាង អ៊ុំ សុផាន់ ណា
ទាំងអស់ ជាមួយនឹង សកម្មភាព ពិសេស ៗ
ប៉ុន្តែ មិន មាន នរណា ម្នាក់ ហ៊ាន អះអាង ថា ប្រព័ន្ធ ការពារ រាងកាយ ផ្សេង ទៀត មិន ត្រូវបាន ស្លាប់ ទៅ ជាមួយ នោះ ទេ ។
ប្រភេទ នៃ ផលិតផល កម្ចី អចលន ទ្រព្យ ធានា ផ្តល់ ជូន តែ អតិថិជន ហ្វឺស ហ្វាយ នែន ប៉ុណ្ណោះ
របស់ យើង ពាក់ព័ន្ធ នឹង វិបស្សនា ។
ពួកជំទាវ នៅ ក្រុង ស៊ីយ៉ូន អួត អាង ណាស់
គ្នា ពី ដំណាក់កាល ដំបូង គឺ ធ្វើ ប្រព្រឹត្ត កម្មវត្ថុធាតុ ដើម រហូតដល់ ដំណាក់កាល ចុងក្រោយ គឺ ដុត ផលិតផល ។
រដ្ឋមន្ត្រី ការបរទេស ទាំង ៥ប្រទេស បាន ចុះហត្ថលេខា រួមគ្នា លើ សេចក្តីប្រកាស បង្កើត អាស៊ាន នេះ ក្នុង ទីក្រុង បាងកក ។
បំណង ចាកចេញ របស់ កីឡាករ វ័យ វ័យ ២៨ ឆ្នាំ អាចនឹង កើតឡើង ឆាប់ ៗ
ទាំងនោះ ដើម្បី បង្ហាញ អំពី អារម្មណ៍ បាន កាន់តែ ច្រើន និង ប្លែក ជាង មុន ទៀតផង ។
នៅលើ លោក នេះ មាន មនុស្ស ប្លែក ៗ
ចំណែក បុរស ពីរ នាក់ ត្រូវបាន បញ្ជូន ទៅកាន់ ស្នងការដ្ឋាន ខេត្ត ។
តើ កម្ពុជា នឹង ទៅជា យ៉ាងណា ប្រសិនបើ …
គេ ជឿ ថា មាន អ្នកស្ម័គ្រចិត្ត ពន្លត់ អគ្គិភ័យ ប្រមាណ ជា ៥រូប បាន ស្លាប់ ។
ឬ បច្ចេកវិជ្ជា ថ្មី ៗ
សារ សម្តេច តេជោ ផ្ញើ ជូន អ្នកគាំទ្រ តាមដាន និង ចែករំលែក ព័ត៌មាន ហ្វេសប៊ុក កម្ពុជា ទស្សនៈ ថ្មី
ឯកឧត្តម ខាន់ វណ្ណៈ និង លោកជំទាវ ២០០ ដុល្លារ
តើ ជម្លោះ បែប នេះ អាច ដោះស្រាយ បាន នៅ តុលាការ អន្តរជាតិ ឬ អង្គការ សហ ប្រជាជាតិ ដែរ ឬ យ៉ាងណា ?
គាត់ បាន ចាប់ យក កូនស្រី នោះ មក ធ្វើជា របស់ ខ្លួន ៕
ការបង្ហាញ ខ្លួន របស់ លោក នៅ តុលាការ កើតមាន ពីរ ឆ្នាំ ក្រោយ ការចាប់ ឃុំ ខ្លួន លោក កាលពី ឆ្នាំ ២០១៧ ។
សង្ឃឹម ថា គ្មាន ការដោះលែង ក្រៅ ប្រព័ន្ធ ច្បាប់ ករណី បង្ក្រាប ល្បែង កន្ទុយ លេខ …
ប្រសិនបើ កិច្ចប្រឹងប្រែង ជាតិ និង អន្តរជាតិ ទទួលបរាជ័យ ពលរដ្ឋ កុងហ្គោ នឹង ទទួលរងគ្រោះ បន្ត ទៀត ៕
កត្តា ទាំងអស់ នោះ អាច បណ្តោល មកពី ទម្លាប់ នៃ ការរស់នៅ និង ភាពអវ…
ចំណែក ម៉ាស៊ីន យន្តហោះ មាន កម្លាំង ៣៥សេស ។
បាន សេចក្តី ថា ចលនា សាងគ្រោះ ជាតិ ហ្នឹង ជា ចលនា ខុស ច្បាប់ ។
ហើយ អ្វី ដែល នៅ សេសសល់ នោះ គឺ ប្រព័ន្ធ យុត្តិធម៌ សង្គម ។
សន្ទស្សន៍ ដង្កូវ ទឹក ឆ្នាំ ២០១២ នេះ មិន កើន តាម រដូវ វស្សា នោះ ទេ ។
ពេល នឹកឃើញ អតីតកាល នាង តែង មាន អារម្មណ៍ ថា ដូចជា បាន ទៅ ភព ផ្សេង ៖
ប្រតិចារិក ដីកា សន្និដ្ឋាន បញ្ជូន រឿង
ដូចជា ការសំដែង ជាមួយ ពស់ វែក យ៉ាង ដូច្នេះ ដែរ !
ថ្ងៃអាទិត្យ សប្តាហ៍ នេះ ក្រុម ខ្លាំង ទាំង ពីរ បាត់ដំបង និង កំពង់ឆ្នាំង ប៉ះ គ្នា ។
មន្ត្រី នគរបាល បាន ឱ្យដឹង ថា ជនសង្ស័យ ដែល ឃាត់ខ្លួន បាន មាន …
ការវាយប្រហារ ចាប់ ជម្រិត ចំណាប់ខ្មាំង លើក នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ១ ថ្ងៃច័ន្ទ កន្លងទៅ នេះ ។
ដោយៈ សាវរក្ស ភ្នំពេញៈ អភិបាល ខណ្ឌ ឬស្សីកែវ បាន ដាក់ បទបញ្ជា ភ្លាម ៗ
ស្វែងរក បុគ្គលិក ដែល ជា និមិត្តរូប សម្រាប់ ខ្លួន ឯង ជា ប្រការ មួយ សំខាន់ ណាស់ ។
រហូតដល់ ជិត ពាក់កណ្តាល យប់ ។
បញ្ហា នេះ អ្នក គួរតែ ទៅ រក អ្នកជំនាញ ដើម្បី ធ្វើ ការព្យាបាល ជាបន្ទាន់ ។
សំណួរ ចន្លោះ ពេល មាន សិច នាងខ្ញុំ មានអារម្មណ៍ ដូចជា លេច នោម ចេញមក តើ នាងខ្ញុំ ខុស ប្រក្រតី ឬ ទេ ?
