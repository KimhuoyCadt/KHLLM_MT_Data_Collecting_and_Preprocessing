ក្រុម វិនិយោគិន ហាក់ដូចជា នៅតែ មាន សុទិដ្ឋិនិយម លើ តម្លៃ ភាគហ៊ុន ដោយសារតែ ភាគហ៊ុន ភាគ ច្រើន នៅតែ មាន ស្ថិរភាព និង ភាគហ៊ុន ដូចជា រដ្ឋាករ ទឹក ស្វយ័ត ភ្នំពេញ PWSA បាន ស្ទុះ ងើប ឡើងវិញ យ៉ាង រហ័ស ដល់ កម្រិត លើស ពី តម្លៃ IPO របស់ ខ្លួន ក្នុង អំឡុង ពេល ១ សប្តាហ៍ កន្លងមក បន្ទាប់ពី សេចក្តីប្រកាស ប្រាក់ ចំណូល សុទ្ធ វិជ្ជមាន នៃ ត្រីមាស ទី១ ឆ្នាំ ២០២១ ៕
ការបែងចែក ភាគលាភ សម្រាប់ ភាគ ទុនិក គឺ មាន ចំនួន ១,៨៨សេន ដុល្លារ ក្នុង ១ភាគហ៊ុន ដែល តំណាង ឱ្យ អនុបាត ការបែងចែក ១០០ ភាគរយ ដោយ ពឹងផ្អែក លើ ប្រាក់ ចំណេញ សុទ្ធ ដែល រក បាន អំឡុង ឆមាស ទី២ឆ្នាំ ២០២០ ។
ក្រុមហ៊ុន បាន ឱ្យដឹង នៅក្នុង របាយការណ៍ ហិរញ្ញវត្ថុ ដែល ចេញផ្សាយ កាលពី ថ្ងៃទី ៨ ខែមីនា ថា ៖
ក្រុមហ៊ុន បន្ត ថា ខ្លួន នឹង រៀបចំ កិច្ចប្រជុំ រៀងរាល់៦ ខែម្តង ដើម្បី ត្រួតពិនិត្យ វាយតម្លៃ និង ពេលវេលា ដ៏ សមរម្យ សម្រាប់ កែតម្រូវ គោល នយោបាយ ភាគលាភ របស់ ខ្លួន ស្រប ជាមួយ ប្រាក់ ចំណូល ក្រុមហ៊ុន សេដ្ឋកិច្ច ពិភពលោក ស្ថានភាព ជំងឺ កូវីដ១៩ ។
ដោយសារតែ ការរីករាលដាល ជំងឺ កូវីដ១៩ បាន កំពុង ប៉ះពាល់ ខ្លាំង លើ សេដ្ឋកិច្ច ក្នុង តំបន់ និង ពិភពលោក រួមទាំង កម្ពុជា បាន បណ្តាលឱ្យ ក្រុមហ៊ុន Naga បិទ ទ្វារ បណ្តោះអាសន្ន រយៈពេល ៣ខែ កាលពី ឆ្នាំ មុន តែ ក្រុមហ៊ុន បាន អះអាង ថា ចំនួន ករណី ឆ្លង កូវីដ១៩ ត្រូវបាន ទប់ស្កាត់ បាន ល្អ ប្រសើរ នៅ កម្ពុជា ។
ក្រុមហ៊ុន Naga បាន ឱ្យដឹង ថា ចាប់តាំងពី ការចាប់ផ្តើម បើក ដំណើរការជាថ្មី នៃ អាជីវកម្ម កាស៊ីណូ កាលពី ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០២០ ក្រុមហ៊ុន មួយ នេះ បាន កត់ត្រា អត្រា ការស្ទុះ ងើប ឡើងវិញ លើក ដំបូង បើ ធៀប នឹង អំឡុង ពេល មុន ការបិទ ដំណើរការ កាលពី ត្រីមាស ទី១ ឆ្នាំ ២០២០ ប្រហែលជា ៩៥ ភាគរយ នៃ ផ្នែក អតិថិជន លេង ល្បែង ទូទៅ និង ប្រហែល ៦៩ ភាគរយ នៃ អ្នកលេង ល្បែង វីអាយ ភី ។
ចាប់តាំងពី ការចាប់ផ្តើម បើក ដំណើរការជាថ្មី នៃ អាជីវកម្ម កាស៊ីណូ កាលពី ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០២០ រហូតដល់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ ក្រុមហ៊ុន នេះ បាន កត់ត្រា កម្រិត ប្រកបដោយ ចីរភាព នៃ ការស្ទុះ ងើប ឡើងវិញ ទំហំ អាជីវកម្ម ៕
នេះ បើ តាម ព័ត៌មាន ខាងលើ ។
តំបន់ សេដ្ឋកិច្ច ពិសេស នេះ ស្ថិត នៅក្នុង ខេត្ត ស្វាយរៀង ។
លោក រស់ ផារិទ្ធ អ្នកនាំពាក្យ រដ្ឋបាល ខេត្ត ស្វាយរៀង បាន ស្វាគមន៍ ចំពោះ គម្រោង បង្កើត រោងចក្រ ផលិត សម្បក កង់ រថយន្ត នេះ ។
លោក និយាយ ថា រដ្ឋបាល ខេត្ត គាំទ្រ រាល់ គម្រោង វិនិយោគ ទាំងអស់ ដើម្បី ជួយ បង្កើត ការងារ និង បង្កើន ប្រាក់ ចំណូល ដល់ ប្រជាជន ។
លោក ប៉ុល សុផា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន កៅស៊ូ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថ្មី ៗ នេះ ថា កម្ពុជា ស្វាគមន៍ គម្រោង នេះ ដោយ លើកឡើង ថា វា នឹង ស្រូបយក កិច្ចព្រមព្រៀង ដ៏ ធំ នៃ ដំណាំ កៅស៊ូ មិន ទាន់ កែច្នៃ នៅ កម្ពុជា ដែល ពេលនេះ ភាគ ច្រើន ត្រូវបាន នាំចេញ ទៅ ក្រៅ ប្រទេស ។
ទិន្នន័យ ពី អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ឱ្យដឹង ថា កម្ពុជា បាន នាំចូល រថយន្ត ចំនួន ១១២៤២១០ គ្រឿង មាន តម្លៃ ១,៨៨២ ពាន់ លាន ដុល្លារ ក្នុង ឆ្នាំ ២០១៩ ។
គយ ចិន កំពុង ពិនិត្យ លក្ខណសម្បត្តិ កសិដ្ឋាន និង ក្រុមហ៊ុន ស្វាយ
ការវាយតម្លៃ នេះ ត្រូវបាន ធ្វើឡើង បន្ទាប់ពី ក្រសួង កសិកម្ម បាន ផ្ញើ បញ្ជី ឈ្មោះ កសិដ្ឋាន ចម្ការស្វាយ ចំនួន ៣០ និង រោងចក្រ ប្រព្រឹត្តិកម្ម សម្លាប់ ពង រុយ ចោះ ផ្លែ ស្វាយ ចំនួន ៤ទៅ ភាគី ចិន កាលពី ខែ មុន ។
លោក រដ្ឋមន្ត្រី បាន បន្ថែម ថា រដ្ឋបាល គយ ចិន ក្រុង ណាន នីង ខេត្ត ក្វាង ស៊ី បាន ធ្វើ ការវាយតម្លៃ ជាក់ស្តែង នៅ ទីតាំង កសិដ្ឋាន ស្វាយ និង រោងចក្រ នីមួយ ៗ តាម ប្រព័ន្ធ បច្ចេកវិទ្យា ពី ចម្ងាយ ZOOM ។
