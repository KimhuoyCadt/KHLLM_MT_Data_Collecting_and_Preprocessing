នឹង ផ្តល់ឱ្យ អ្នក នូវ អាហារ ច្រើន ។
៦ លាននាក់ផ្សេងទៀតត្រូវភៀសខ្លួនក្នុងប្រទេសស៊ីរី ។
ប៉ុន្តែពួកគេចង់រុញ ច្រានព្រំដែននៃអ្វី ដែលពួកគេអាចសម្រេចបាន ដូច្នេះពួកគេបានបោះខ្លួនប្រឆាំងនឹង ភាព ខ្លាំងរបស់ ពួកគេ ។
ប្រាប់ យើង អំពី គំនិត របស់ អ្នក ពួកយើង នឹង ធ្វើឱ្យ បាន ច្រើន បំផុត ពី ព្រឹត្តិការណ៍ របស់ អ្នក ។
បន្ទប់ គឺជា របស់ អ្នក សម្រាប់ រយៈពេល នៃ ការមក លេង របស់ អ្នក ។
អេក្រង់ ប៉ះ មិន ឆ្លើយតប ទេ ។
អ្នក នឹង ទៅ បាប៊ីឡូន ។
ជា ទ្រព្យសម្បត្តិ ព្រោះ មាន នៅក្នុង ដៃ ។
“ យើង គ្រាន់តែ ចង់ ការពារ មេដឹកនាំ របស់ យើង ។
... មើល ប៉ុន្តែដល់ពេលនោះ អ្នកបំបួសទាំងអស់ត្រូវបានធានា ។
ហើយពួកគេមិនមានលទ្ធភាពធ្វើឱ្យមូលដ្ឋានរបស់ពួកគេត្រូវបានរំខាននោះទេ ។
ដូច្នេះ ពេលអ្នកតែងទំនុកតម្កើងនិយាយបន្ត
កំណត់ ចំណាំ មួយចំនួន ក្នុង ការឆ្លើយតប ទៅនឹង មតិ យោប ល់៖
ជឿជាក់ ថា សាធារណជន នឹង រីករាយ ជាមួយនឹង ការផ្តល់ ។
២១ ព្រះយេស៊ូមានព្រះបន្ទូលទៅគេ ថា៖ « តើចង្កៀងត្រូវយកទៅដាក់ក្រោម កន្ត្រក ឬនៅក្រោមសាឡុង ជាជាងដាក់លើជើង ចង្កៀងឬ ?
តើ អ្នក ទទួលបាន រូបថត អេក្រង់ ចាក់សោ អេក្រង់ ដោយ របៀប ណា ?
នៅក្នុង សកម្មភាព ចុងក្រោយ របស់ សហរដ្ឋ អាមេរិក មន្ទីរ បញ្ចកោណ បាន និយាយ ថា ខ្លួន កំពុង បញ្ជូន យន្តហោះ B-52 ដ៏ ធំ និង មាន សមត្ថភាព នុយក្លេអ៊ែរ ជាច្រើន ទៅកាន់ តំបន់ ។
តើ អ្វី ទៅ ជា អត្ថន័យ ផ្ទុយ នៃ ពាក្យ
ហេតុអ្វីបានជាអ្នកចង់ទុកឱ្យនាងនូវ ផល វិបាកនៃអាកប្បកិរិយាអាក្រក់របស់នាង ?
ព្រោះយើងជាភ័ស្តុតាងថាវាអាចឆ្លងកាត់ ។
ដ្បិតគាត់ប្រាថ្នាចង់បានអ្នក រាល់គ្នា ហើយព្រួយ ចិត្តដោយ សារអ្នក រាល់គ្នាបានឮថាគាត់ឈឺ ។
និក្ខម នំ 20:10 ដូច្នេះ យើងបាននាំគេចេញពីស្រុកអេស៊ីប ហើយនាំគេចូលទៅក្នុងទី រហោស្ថាន ។
ដោយ សារការ សោយទិវង្គតរបស់ឪពុកគាត់បានធ្លាក់ចូលទៅក្នុងទុក្ខព្រួយ
ការលក់ ផ្ទាល់ រយៈពេល 4 ឆ្នាំ ។
ត្រង់ទៅរកសាលក្រមទោស...
« គឺម្នាក់ក្នុងចំណោមដប់ ពីរនាក់ដែលជ្រលក់ជាមួយខ្ញុំក្នុងចាន ។
« មានបុរសពីរនាក់ ម៉ូសេ និងអេលីយ៉ា កំពុងនិយាយជាមួយគាត់ ។
សង់ វា នៅ ជាប់ សាលាក្រុង របស់ អ្នក ។
តើអ្នកមិនចាំទេថា ពេលខ្ញុំនៅជាមួយអ្នក ខ្ញុំបានប្រាប់អ្នកពីរឿងទាំងនេះ ?
គាត់បានប្រកែកថា ទោះជានាងធ្វើយ៉ាង ណាក៏ដោយ ។
បន្ទាប់មកគាត់បានចាប់ផ្ដើមការ អធិស្ឋានជាមួយនឹងតាកប៊ី ។
មិន មែន គ្រប់ សេវាកម្ម ទាំងអស់ គិត ដល់ រូបភាព ធំ នោះ ទេ ។
សិល្បៈ នៃ កិច្ចព្រមព្រៀ ង៖ ស្គាល់ ទស្សនិកជន របស់ អ្នក ។
របស់ កូនក្រមុំ និង សហគមន៍ ទាំងមូល ។
៧ ដូច្នេះ ដូច ជាព្រះវិញ្ញាណបរិសុទ្ធមាន បន្ទូលថា ថ្ងៃ នេះ បើអ្នក ឮសំឡេងទ្រង់
ស្ថានភាព នៃ អ្នក ពាក់ព័ន្ធ ទាំងអស់ ។
« ដ្បិតព្រះ អម្ចាស់ ជាព្រះ របស់អ្នក ទ្រង់ជាព្រះ ដែលមាន ចិត្តមេត្តា ទ្រង់នឹងមិនធ្វើឲ្យអ្នកបាត់ បង់ ឬបំផ្លាញអ្នក ឬបំភ្លេចសេចក្ដី សញ្ញាជាមួយនឹងបុព្វបុរសរបស់អ្នក ដែលទ្រង់បានស្បថនឹងពួកគេឡើយ » ។ ~ ចោទិយក ថា 4:31 (NASB)
២២ នេះហើយជាមូលហេតុដែលខ្ញុំត្រូវបានរារាំងជាញឹក ញាប់មិនឲ្យមក រកអ្នក រាល់គ្នាឡើយ ។
តើ ពួកគេ ពិតជា ចង់ឱ្យ អ្នក ប្រកួតប្រជែង ជាមួយ ពួកគេ និង ញ៉ាំ អាហារ ថ្ងៃត្រង់ របស់ ពួកគេ មែន ទេ ?
លោកបានធ្វើដើម្បីពួកគេនូវអ្វីដែលលោកបាន សន្យា ។
ពាក់ អាវស្នេហ៍នាយក រដ្ឋមន្ត្រីលើក្បាល !
អ្នក ច្រណែន នាង ។
ព្រះអង្គក៏យាងចុះទៅភូមិ ណា សា រ៉ែតជាមួយនឹងគេ ហើយក៏ស្ដាប់បង្គាប់គេ ហើយម្ដាយក៏ទុករបស់ទាំងនេះទុកក្នុង ចិត្ត ។
ខ្ញុំអាចស្លៀកសំពត់ ប៉ុន្តែវាមិនគួរធ្វើដូច្នេះទេ ។
ខ្ញុំធ្លាប់ឮថាកម្មវិធីនេះនឹងមានលក្ខណៈសូរស័ព្ទ ។
ព្រះមហាក្សត្រិយានី ដើម្បី ចាប់ផ្តើម ការរាប់ ថយ ក្រោយ ទៅ សមរភូមិ ទី ពីរ ។
ធ្វើ ឬ លុបចោល ដើម្បី ធ្វើ អ្វី មួយ ។
តើយើងគួរសួរខ្លួនឯងជាមុនថា តើយើងកំពុងរងការ គំរាម កំហែងដោយនរណា ?
តាមពិត វាបានធ្វើឲ្យខ្ញុំ កាន់ តែខ្លាំង ។
និយាយ ឱ្យ ខ្លី យើង នឹង ឈប់ គ្មាន អ្វី សោះ
វិវរណៈ 11:17 ឱ ព្រះ‌ អម្ចាស់នៃពិភពទាំងមូលអើយ យើងខ្ញុំសូមអរព្រះ‌គុណដល់អ្នក រាល់គ្នា ឱ ព្រះ‌ អម្ចាស់នៃពិភពទាំងមូល ជាព្រះ ដែលគង់នៅ និង ជាអ្នកដែលនឹង មកដល់ ព្រោះព្រះអង្គបានយកឫ ទ្ធានុភាពដ៏ អស្ចារ្យរបស់ព្រះអង្គឡើងសោយរាជ្យ ។
មេបញ្ជាការ រង ថ្លែង សុន្ទរកថា ដ៏ សំខាន់ មួយ ។
ពួកគេ ភ័យខ្លាចពេកក្នុងការ ចាកចេញពីខ្ទមនៅមុនថ្ងៃ រះ » ។
ចំណងជើង៖ តាំងពី ព្រឹក ព្រលឹម
ម្យ៉ាងទៀត សេចក្ដី ពិតបច្ចុប្បន្នរបស់ព្រះអម្ចាស់ ។
សង្ឃឹម ថា ជាតិ កាហ្វេអ៊ីន មិន លេចឡើង ទេ ។
ប្រសិនបើ អ្នក មិន បាន ( ទោះបីជា អ្នក បាន ជួយសង្គ្រោះ ជីវិត រាប់ មិន អស់ ) អ្នក នឹង ត្រូវ ថ្កោល ទោស ជារៀងរហូត ចំពោះ ការរងទុក្ខ នៅក្នុង បឹង ភ្លើង ។
ប៉ុន្តែដោយសារពួកគេជាប្រវត្តិសាស្ត្រ ពួកគេត្រូវបានអនុញ្ញាត ។
យើងត្រូវ តែធ្វើការ ប្រហែលជាក្នុង រយៈពេលមួយឆ្នាំ យើងនឹងស្ថិតនៅកម្រិតដូចគ្នានឹង Liverpool» ។
មិនថាណាត់ជួបទេ ឥឡូវនាងមិនទៅមុខទេ ។
ពីឡានបីលើកដំបូង » ។
មាន វត្តមាន ក្នុង ចំនួន ដ៏ ច្រើន ហើយ មនុស្ស ស្រូប ចូល ពួកគេ ។
រៀបរៀង ដោយ លូកា ។
គាត់បាននិយាយថា៖ « ខ្ញុំបានទៅរើសក្មេងប្រុស បីនាក់។
នៅ ទីនេះ បុរស វ័យ ចំណាស់ នៃ ជនជាតិ យូដា បាន មក រក គាត់ ជាមួយនឹង ការស្នើសុំ មួយ ។
ហើយ កូនក្រមុំ វ័យ ក្មេង របស់ គាត់ បាន លង់ទឹក សមុទ្រ ។
ខ្ញុំប្រាប់អ្នក រាល់គ្នាថា អ្នក ណាទទួលស្គាល់ខ្ញុំនៅមុខមនុស្សលោក កូនមនុស្សក៏នឹងទទួលស្គាល់អ្នកនោះនៅចំពោះមុខពួកទេវតារបស់ព្រះជាម្ចាស់ដែរ ។
មិត្តភ័ក្តិរបស់អ្នកអាច នាំអ្នកចេញពីទំពក់ ។
¶à 3:12 ពេលដែលខ្ញុំចាត់អាតេម៉ាស ឬទី ឈី កុស ទៅរកអ្នក រាល់គ្នា ចូរខំ ប្រឹង មករកខ្ញុំនៅ នី កូ ប៉ូលី ចុះ ព្រោះខ្ញុំសម្រេច ចិត្តទៅទីនោះនៅរដូវ រងា ។
ហើយពួកគេត្រូវបរិភោគយ៉ាងប្រញាប់ ។
ទោះជា យ៉ាងណា ក៏ដោយ ប្រសិនបើ អ្នក មិន មាន ចំណេះដឹង អំពី កំហុស ឬ កំហុស ណាមួយ ទេ វា មាន ការ ការពារ នៅ កន្លែង ដើម្បី កុំ ឱ្យ អ្នក ចេញ ពី ទឹក ក្តៅ ។
ហេតុផល មួយ ក្នុង ចំណោម ហេតុផល ភាគ ច្រើន ដែល និស្សិត មហាវិទ្យាល័យ មិន ចង់ ត្រឡប់ មកវិញ
៩ ហេតុនេះហើយបានជាបុព្វបុរសរបស់យើងត្រូវគេសម្លាប់ ហើយនេះជាមូលហេតុដែលប្រពន្ធកូនប្រុសកូនស្រីរបស់យើងត្រូវបានចាប់ដាក់គុក ហើយធ្វើជាទាសករ ។
ដំបូង ថា ស ត្រូវតែ បែងចែក ។
រាងកាយ ឬ ផ្នែក ណាមួយ ។
ជា ការប្រសើរ ណាស់ , ពួកគេ នឹង ប្រែ ទៅជា ស្រស់ស្អាត ។
ប៉ុន្តែការពិតនៅ តែថាពួកគេបានទៅហើយ ហើយយើងទាំងអស់គ្នាត្រូវតែបន្តទៅមុខទៀត » ។
ដូច្នេះ ទោះបីអ្នកបរិភោគ ឬផឹក ឬធ្វើអ្វីក៏ដោយ ចូរធ្វើទាំងអស់ដើម្បីលើក ត ម្កើងព្រះ។
ដូច្នេះ ទោះបីអ្នកបរិភោគ ឬផឹក ឬធ្វើអ្វីក៏ដោយ ចូរធ្វើទាំងអស់ដើម្បីលើក ត ម្កើងព្រះ។
« តើអ្នកនឹងមិនឆ្លើយ តបនឹងទី បន្ទាល់ដែលមនុស្សទាំងនេះបានចោទប្រកាន់អ្នកទេឬ ? » ។
« អនាគតនៃមនុស្សជាតិស្ថិតនៅលើជោគជ័យនៃការតវ៉ានេះ ។
យ៉ូហានបានប្រគល់ពួកគេទៅតាម បញ្ជា ។
ដូចមានចែងទុកមកថា “ តែមនុស្សសុចរិតនឹង រស់ដោយ សារសេចក្តី ជំនឿ ” ។
ខ្ញុំ អំពាវនាវ ដល់ បុព្វបុរស ។
វា ប្រហែលជា យើង មិន ដឹង ពី របៀប ធ្វើ វា ឱ្យ ត្រឹមត្រូវ ។
