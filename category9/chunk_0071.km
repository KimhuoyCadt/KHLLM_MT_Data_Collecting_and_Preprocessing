ដើម្បី ជ្រើសរើស ឯកសារភ្ជាប់ ទាំងអស់ ។
ហើយ ពួកវា ទាំងអស់ អាច រក បាន នៅលើ អ៊ីនធឺណិត ។
ទ្រង់ ជា ព្រះរាជ បុត្រា នៃ ព្រះ។
គាត់ ជា កូន របស់ ព្រះ។
រដូវ រងា បន្ទាប់ ទ្វារ ត្រូវបាន ចាក់សោ ។
*"ហេតុ អ្វី បានជា ខ្ញុំ មានអារម្មណ៍ ថា ការស៊ើបអង្កេត របស់ អេស្ប៉ាញ ហៀប នឹង ត្រូវបាន អនុម័ត ឡើងវិញ ? "*
ព្រះយេស៊ូវបានមាន បន្ទូលថា « ប្រសិនបើបងប្អូនអ្នក ធ្វើខុស ចូរបន្ទោសគាត់ ហើយប្រសិនបើគាត់ ប្រែ ចិត្ត ចូរអត់ទោសឲ្យគាត់ចុះ » ( លូកា ១៧:៣ ) ។
ដូច្នេះ ពួកគេ នឹង អាច ស៊ូទ្រាំ នឹង ការប្រើប្រាស់ ខ្លាំង ។
ក្នុង ចំណោម វេទិកា ទាំងអស់ ។
ពេលនោះ ប្រជាជាតិនានានឹងដឹងថា យើងជាព្រះអម្ចាស់ ជាព្រះ ដ៏ វិសុទ្ធរបស់ជន ជាតិអ៊ីស្រាអែល ។
ឆ្លងកាត់ ដើមឈើ ដែល ខ្ញុំ ដាក់ ។
ជោគវាសនា នៅ ទីនោះ ។
18 ប្រសិនបើវាអាចទៅរួច អាស្រ័យលើអ្នក ចូររស់ នៅដោយសុខសាន្តជាមួយមនុស្សគ្រប់រូប ។
កុំ ប្រាប់ សេវា កុមារ និង គ្រួសារ !
“ យើងគិតថាតើអ្នកបានចាក់វ៉ាក់សាំងមួយឬពីរហើយ ។
‹ ប្រសិនបើអ្នកស្គាល់ខ្ញុំ អ្នកនឹងស្គាល់ព្រះបិតារបស់ខ្ញុំដែរ › ។
ខ្ញុំបានព្យាយាមលុបវា ប៉ុន្តែពួកគេមិនព្រម ។
ពេលរុំដោយស្នេហា យើងមិន ឯ កា ទេ ។
ខ្ញុំមានអារម្មណ៍ក្នុងជីវិតរបស់ខ្ញុំថា ខ្ញុំនៅក្នុងដៃនៃព្រះ ដ៏ ជាទី ស្រឡាញ់ ។
ជាមួយនឹង ផ្ទះ បែប នេះ អ្នក មិន ចង់ ចាកចេញ ទេ ។
ខ្ញុំគិតថាឪពុកម្តាយខ្ញុំជាមនុស្ស អស្ចារ្យ ពួកគេជាមនុស្សណាស់ ។
បុរសដែលស្រឡាញ់ប្រពន្ធខ្លួនស្រឡាញ់ខ្លួន។
« នៅក្នុង ទ្រង់ យើង មាន សេចក្តីប្រោស លោះ ការអត់ទោស បាប ។
ឪពុក ម្តាយ ទាំងឡាយ ចូរ ស្តាប់ កូន របស់ អ្នក ។
ផ្នែក ខាងមុខ បួន ត្រូវបាន បង្កើតឡើង ជាច្រើន ប៉ុន្តែ តើ អ្នក ឃើញ អ្វី ខ្លះ ពី ពួកគេ ?
យើង ជឿជាក់ ថា អ្នកណា ក៏ដោយ ដែល រស់ នៅ ស្រប តាម
ប៉ោល មាន ភាពត្រឹមត្រូវ ដូច អ្នក ដែរ ។
នាងលោតឡើងដោយ ភាព រីករាយ ហើយច្រៀងចេញ ។
ពួកគេ បាន និយាយ ថា ពួកគេ ខ្លាច លោក ដូណាល់ ត្រាំ ។
ផ្ញើទៅកូន ប្រសា របស់គាត់ថាពួកគេគួរតែបន្ត
អ្នក ណាដែលជឿលើខ្ញុំនឹងមានជីវិត ទោះបីគាត់ស្លាប់ក៏ដោយ ។
និង ជូន ដំណឹង ដល់ អ្នក អំពី ព្រឹត្តិការណ៍ នា ពេល ខាងមុខ ។
ពួកគេព្រួយ ចិត្តដោយព្រោះលោកម៉ូសេ បាន រត់ចេញពីព្រះចៅផារ៉ោន ហើយមក រស់នៅក្នុងស្រុក ។
ច្រៀង តាម ឬ គ្រាន់តែ ស្តាប់ និង រំលឹក ។
សម្រាប់ ព្រះវិហារ គ្រិស្ត សាសនា ទាំងមូល ។
ដូច្នេះហើយមិនបានធ្វើការ សូត្របានល្អទេ » ។
គ្មាន ការសង្ស័យ ទេ ពួកគេ នឹង ទទួលបាន បន្ទះ ផងដែរ ។
ឬ អ្នក អាច ទៅ ត្រង់ ពី ទឹក ទៅ ក្រមួន ប្រសិនបើ ក្រមួន ត្រូវបាន កំដៅ ពីលើ ចំណុច រំពុះ នៃ ទឹក ។
ហើយ ព្រះមហាក្សត្រ និង ព្រះមហាក្សត្រិយានី ដើម្បីឲ្យ ពួកគេ នៅជិត នោះ បាន យក របស់ ពួកគេ ។
ទោះយើងទៅ ណាក៏ដោយទៅ ណាក៏ដោយព្រោះយើងដឹក
៣៧ នៅ គ្រានោះ នាងឈឺ ហើយស្លាប់ ។
ផ្តល់ឱ្យ យើង នូវ ផ្ទះ របស់ អ្នក ដើម្បី សម្អាត ហើយ យើង នឹង ធ្វើឱ្យ វា ក្លាយជា ឋានសួគ៌ ។
ការគោរព គឺជា ច្បាប់ ។
ប្រសិនបើ អ្នក ធ្លាប់ ស្វែងរក មនុស្ស មក ខាំ ចូរ ទុក ពួកគេ ធ្វើជា ឪពុក ម្តាយ របស់ អ្នក ដ្បិតគេសមជាងអ្នក ណាដែលយករង្វាន់នៃអំពើល្អរបស់អ្នកទៅទៀត ។
ចុះពេលខ្ញុំនៅជាមួយប្រពន្ធខ្ញុំយ៉ាងម៉េចដែរ ?
ខ្ញុំនឹងព្យាយាមជួយអ្នកមើលរឿងដោយការ សួរសំណួរ ។
នៅក្នុង ប្រទេស អេហ្ស៊ីប បុរាណ សុបិន ត្រូវបាន គេ គោរព ។
... ជនជាតិ អារ៉ាប់ គាត់ បាន ស្ងើចសរសើរ ចំពោះ ពួកគេ នូវ ប្រាជ្ញា និង ភាពអស្ចារ្យ នៃ ការអត់ឱន ចំពោះ អ្នក ឈ្នះ ។
គ្មាន អ្វី មាន តម្លៃ ជាង ការយល់ ចិត្ត ខ្លួន ឯង នោះ ទេ ។
ពីមុន គឺជា ការសម្រេចចិត្ត ដើម្បី សាកល្បង ។
ប៊ុល ហ្គារី៖ តាំងពីដើមឆ្នាំ២០១៤ មក ។
ខ្ញុំខូច ចិត្តចំពោះ ភាព ឯ កា របស់បុរសម្នាក់នេះ និងទូករបស់គាត់ ។
ប្រទេស ហូឡង់ បាន ប្រកាស លក្ខខណ្ឌ សំខាន់ សម្រាប់ កិច្ចព្រមព្រៀង ជៀសវាង ការយក ពន្ធ ទ្វេរ ដង (DTAA) ជាមួយ សហព័ន្ធ រុស្ស៊ី ។
បន្ទាប់មក អ្នកទទួល ដោយ ការបង្រៀន នៃ ព្រះបន្ទូល របស់ ព្រះ។
ប៉ុន្តែ យើង អាច បង្ហាញ ខ្លួន ជារៀងរាល់ ថ្ងៃ ។
ឡូស អេន ជឺ លេស គឺ ធំ ល្មម នឹង ប្រជាជន ពិភពលោក ទាំងមូល ។
ផលិត ផលពីសួនច្បាររបស់អ្នក ឬកសិករក្នុងតំបន់ត្រូវបានជ្រើស រើសនៅរដូវ កាលខ្ពស់បំផុត ដូច្នេះវាមានរសជាតិឆ្ងាញ់ជាងបន្លែ និងផ្លែឈើដែលទិញពីហាង ។
ចូរប្រាប់សេចក្ដី ទាំងនេះដល់យ៉ាកុប និងបងប្អូនផង ។
គាត់បានសម្លឹងមើលដី ប៉ុន្តែឥឡូវគាត់
ចូរអធិស្ឋានដល់ព្រះ យេហូវ៉ាឲ្យទ្រង់ដកពស់ចេញពីយើង » ។
ខ្ញុំចង់មក ហើយខ្ញុំចង់ មក » ។
ខ្ញុំមិនមានថ្ងៃឈប់សម្រាករហូតដល់ពាក់កណ្តាលខែ មករា » ។
មិនដល់មួយឆ្នាំក្រោយមក បារាំងនឹងក្លាយជា
បើកល្មមឱ្យអ្នករៀន !
ពេលខ្ញុំដាក់ដាវរបស់ខ្ញុំនៅដៃស្ដេចបាប៊ីឡូន ហើយយកវាទៅវាយស្រុកអេស៊ីប នោះអេស៊ីបនឹងដឹងថាយើងជាព្រះ យេហូវ៉ា ។
បន្ទាប់មក អ្នក នឹង បាន បង្កើត ទម្លាប់ មួយ ។
បី ឆ្នាំ ក្រោយមក គាត់ ត្រូវបាន ជួល ជា អ្នក រាយការណ៍ ពេញ ម៉ោង ។
ឪពុក ខ្ញុំ ជំពាក់ ម្តាយ ខ្ញុំ ។
ហើយ សម្រាប់ ម៉ោង ។
កុំឲ្យវាត្រួតត្រាជីវិតរបស់អ្នកឡើយ » ។
សម្រាប់ រឿង មួយ ពួកគេ នឹង បង់ ពន្ធ តិច ។
ឬវាមាន ន័យដើម្បីបញ្ជាក់ប្រភេទនៃការ វិនិច្ឆ័យតម្លៃមួយចំនួនអំពី ការ គោរពបូជា ?
មនុស្ស មួយចំនួន និយាយ ថា ពួកគេ មិន អាច ។
ជាច្រើន ឆ្នាំ មុន ម៉ូសេ គឺជា កូនប្រុស របស់ ផារ៉ោន ។
