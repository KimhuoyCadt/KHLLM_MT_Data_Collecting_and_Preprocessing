គ្រប់គ្នាល្អក្នុងការងាររបស់ខ្លួន ។
“ សម្រាប់ ខ្ញុំ ចង្កៀង ជាតិ គឺជា ការបញ្ចប់ ។
ប៉ុន្តែមនុស្សភាគច្រើនមិនយល់ស្របនឹងគម្រោងនេះទេ …
អូ ខ្ញុំ នឹង ប្រាកដ ថា នឹង បង្ហាញ ការបង្ហោះ នេះ ដល់ កូនប្រុស របស់ ខ្ញុំ ។
នាង គ្មាន គោលបំណង អ្វី ក្រៅពី ការផ្គាប់ ចិត្ត បុរស នោះ ទេ ហើយ នាង ទទួលបាន រង្វាន់ សម្រាប់ ការស្តាប់ បង្គាប់ របស់ នាង តាមរយៈ ការបំពេញ សេចក្តីស្រឡាញ់ ។
ប្រអប់ អាហារ ថ្ងៃត្រង់ កំពុង ចុះចត ។
ហើយគាត់ដឹងថានេះគឺជាអំពើល្អរបស់គាត់ ។
តើព្រះ អង្គទ្រង់មាន បន្ទូលថា អាពាហ៍ពិពាហ៍គឺរវាងបុរសនិងស្ត្រីឬ ?
មនុស្សដែលនៅឆ្ងាយពីចម្ងាយ ៤៥ ម៉ាយ បានអះអាងថា ពួកគេអាចឮសំឡេងផ្ទុះ ។
អត្ថប្រយោជន៍ មួយចំនួន នឹង ត្រូវបាន ទទួល ដោយ កង្ហារ តូច ជាង ។
ហើយពួកគេនិយាយថា “ នាងនឹងត្រូវបានគេស្រឡាញ់ ” ។
លុះក្រុមគ្រួសារបានឮដូច្នោះ ក៏ នាំគ្នាចេញទៅចាប់លោក ព្រោះពួកគេនិយាយថា « គាត់ចេញហើយ ...
គាត់ មកទីនេះពេកក៏ដាក់គាត់ទៅ …»
ការគ្រប់គ្រង ប្រព័ន្ធ ធារាសាស្ត្រ ។
នេះ គឺជា ច្រកទ្វារ ដែល នឹង បើ ក៖
អ្នក ត្រូវបាន ទិញ ក្នុង តម្លៃ មួយ ដូច្នេះ សូម លើក តម្កើង ព្រះនៅក្នុង រូបកាយ របស់ អ្នក ។
តើ អ្នក ពិតជា គិត ថា វា ជា រឿង ចៃដន្យ ទេ ដែល អ្នក បាន បញ្ចប់ ការបង្រៀន នៅ សកលវិទ្យាល័យ ដូចគ្នា នឹង ឪពុក របស់ អ្នក ?
កាល ណាយុត្តិធម៌បានកើតឡើង អ្នកដែលប្រព្រឹត្តត្រឹមត្រូវក៏ប្រារព្ធ តែអ្នកដែលបង្កបញ្ហាភ័យខ្លាច ។
ចូរកាត់របស់ដែលនៅក្នុងដៃរបស់អ្នក ។
ស្ថាន សួគ៌គឺជាក្រុមគ្រួសារប្រមូលផ្តុំអ្នក ជឿពីគ្រប់កុលសម្ព័ន្ធ និងគ្រប់ជាតិ សាសន៍ ប៉ុន្តែវាក៏ជាដំណាក់របស់ព្រះវរ បិតាយើងដែរ ហើយនៅក្នុងផ្ទះនោះទ្រង់កំពុងរៀបចំបន្ទប់សម្រាប់ តែអ្នក រាល់គ្នា។
មួយ រយៈក្រោយមក ពួកអាំម៉ូនបានច្បាំងនឹងអ៊ីស្រាអែល ។
អ្នក ប្រហែលជាឃើញខ្លួនឯងនៅក្នុងក្រុមភាគតិច ប៉ុន្តែត្រូវមានទំនុក ចិត្ត
កិច្ចការ 4:24 GNB ពេលអ្នក ជឿបានឮដូច្នេះ ពួកគេទាំងអស់គ្នាបានរួមគ្នាអធិស្ឋានដល់ព្រះថា៖ « លោកម្ចាស់ និង ជាអ្នកបង្កើតផ្ទៃមេឃ ផែនដី និងសមុទ្រ និងអ្វី ៗដែលនៅក្នុងពួកគេ !
ទ្រង់ ( ព្រះយេស៊ូវ ) នឹង ថ្លែង ព្រះបន្ទូល ទៅកាន់ ពួកគេ ដោយ ពាក្យ ប្រស្នា ជាច្រើន ដូច ដែល ពួកគេ អាច យល់ បាន ។
បន្ទាប់មកពួកគេឈរស្ងៀមមួយ រយៈក្រោយមកពួកគេបញ្ច្រាស់គ្នាសម្រាករួចក៏បែក ខ្ញែកគ្នា។
ដើម្បី អោយ អ្នកណា ដែល ជឿ លើ ទ្រង់ នឹង មាន ជីវិត អស់ កល្ប ជានិច្ច ។
ចក្ខុវិស័យ របស់ អង្គការ យូនី សេហ្វ គឺជា ពិភពលោក មួយ ដែល សិទ្ធិ របស់ កុមារ គ្រប់ រូប ត្រូវបាន បំពេញ ។
ការរៀបចំ ទាំង ប្រាំ ដែល នៅសល់ គឺ អំណោយផល ។
ពីព្រោះហោរាជាអ្នកដែលបានឮព្រះបន្ទូលរបស់ព្រះ ហើយបាននិយាយដល់មនុស្ស ។
គាត់ និយាយ ថា " នៅ ទីនោះ គឺជា ចរិត លក្ខណៈ របស់ អ្នក៖ អ្នក បាន ប្រព្រឹត្ត អំពើ បាប ប្រឆាំង នឹង ព្រះវិញ្ញាណ បរិសុទ្ធ ហើយ អ្នក នឹង មិន ត្រូវបាន គេ លើកលែង ទោស ឡើយ " ។
ចំណែក លាដែលបាត់ កាលពីបីថ្ងៃមុន កុំបារម្ភអី ព្រោះរកឃើញហើយ ។
ម៉ាកុស 14:17 ហើយនៅពេលល្ងាច គាត់ មកជាមួយនឹងសិស្សទាំងដប់ ពីរនាក់ ។
ការរស់រាន មាន ជីវិត ពី ភាពវឹកវរ៖ ប្រាប់ ខ្ញុំ ពី អ្វី ដែល អ្នក ពិតជា គិត
ខ្ញុំ នឹង ស្លាប់ ដើម្បី អ៊ីស្រាអែល
#៦ ព្រះបាន សន្យា ថា នឹង ស្មោះត្រង់
លាក់ អាហារ មិន ល្អ ។
ទោះ ជាយ៉ាង ណា ពេលពួកគេបន្តជីវិតនៅប្រទេសជប៉ុនជាមួយគ្នា ម្នាក់ ៗសុខ ចិត្ត
វាខុសពីពេលដែលខ្ញុំចូលរួមដំបូងក្នុងខែ កក្កដា ឆ្នាំ ២០០៩ ។
ដូច្នេះ លោកយេស៊ូក៏ចាប់ចុះទូកចេញទៅ ។
មាន សញ្ញាថាឃាតករបានប្រើស្រោម អនាម័យ ។
នៅ ពេល ដែល សេចក្តីរាយការណ៍ អំពី ការរស់ ឡើងវិញ របស់ ព្រះយេស៊ូវ បាន រីករាលដាល ថូម៉ាស ដែល សង្ស័យ អំពី ការរស់ ឡើងវិញ របស់ ព្រះគ្រីស្ទ បាន និយាយ ថា “ ប្រសិនបើ ខ្ញុំ មិន បាន ឃើញ ស្នាម ដែក គោល នៅក្នុង ព្រះហស្ត របស់ ទ្រង់ ហើយ ដាក់ ម្រាម ដៃ របស់ ខ្ញុំ ទៅក្នុង កន្លែង ក្រចក ហើយ ដាក់ របស់ ខ្ញុំ ។ ប្រគល់ខ្លួនទៅខាងទ្រង់ ខ្ញុំនឹងមិនជឿទេ » ។
សូម អរគុណ ចំពោះ ការខិតខំ ប្រឹងប្រែង របស់ អ្នក ក្នុង រយៈពេល 5 ឆ្នាំ ចុងក្រោយ នេះ ពួកគេ ត្រូវបាន កោតសរសើរ យ៉ាង ខ្លាំង ដោយ មនុស្ស ជាច្រើន ។
តើអ្នកមិនមែនជាគ្រួសាររួមតូច !
ធ្វើ វា ឱ្យ ត្រូវ ហើយ ពួកគេ នឹង ចំណាយ ប្រាក់ រាប់ ពាន់ ។
គ្មាន នរណា ម្នាក់ ត្រូវ ទៅ ដោយ គ្មាន អាហារ ពេលល្ងាច ឬ ក្រុមហ៊ុន នៅ ថ្ងៃ បុណ្យ ណូអែល នោះ ទេ ។
គិត ត្រឹម ថ្ងៃទី ០២ ខែវិច្ឆិកា ឆ្នាំ ២០១០ ឈ្មោះ សមាជិក ក្រុមប្រឹក្សា គឺ៖
សូម្បីតែមិត្តជិតស្និទ្ធនឹងស្លាប់ក៏មិនសួរព្រះ ថាហេតុអ្វី ?
លោកយេស៊ូបានមាន ប្រសាសន៍ថា៖ «ហេតុនេះហើយបានជាបុរសនឹងចាកចេញពីឪពុកម្ដាយទៅជាមួយនឹងប្រពន្ធ ហើយអ្នកទាំងពីរនឹងក្លាយជាសាច់ឈាម តែមួយ ។
អ្នក ផ្សេង ទៀត បាន សរសើរ ពួកគេ ។
ចំពោះ ការផ្តន្ទាទោស ជន ណា ម្នាក់
« សន្យានឹងខ្ញុំថាអ្នកនឹងមិនព្យាយាមចេញឆ្ងាយ » ។
វា ជា ចម្រៀង ពិសេស សម្រាប់ ខ្ញុំ និង គ្រួសារ របស់ ខ្ញុំ ។
ដំណឹង អាក្រក់ គឺ ថា ពួកយើង ភាគ ច្រើន មាន ការយល់ ខុស ច្រើន អំពី អ្វី ដែល យើង ញ៉ាំ ហើយ យើង អាច បណ្តាលឱ្យ ខ្លួន យើង ឈឺ និង ធាត់ ។
បទ ចម្រៀងទាំងនេះប្រហែលជាត្រូវបានចេញនៅប្រហែលឆ្នាំ ១៩៨៧ ។
ពួកគេបានព្រមានអ៊ីស្រាអែលឲ្យរក្សាស្ថានភាពប៉ាឡេ ស្ទីនដូចមុនឆ្នាំ ១៩៦៧ ។
ដែល បាន រកឃើញ ខ្លួន ឯង ផងដែរ ។
