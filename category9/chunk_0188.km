ភ្នំពេញៈ មន្ត្រី និង វិស័យ ឯកជន បាន ឱ្យដឹង ថា ទោះបី មាន ភាព មិន ប្រាកដប្រជា ផ្នែក នយោបាយ បាន បង្អាក់ ដល់ បរិយាកាស អាជីវកម្ម នៅ តាម កន្លែង មួយចំនួន ក៏ដោយ ក៏ ចំនួន នៃ ការចុះឈ្មោះ អាជីវកម្ម ថ្មី បាន កើនឡើង យ៉ាង ខ្លាំង ក្នុង ឆមាស ទី មួយ ឆ្នាំ នេះ ធៀប នឹង រយៈពេល ដូចគ្នា កាលពី ឆ្នាំ មុន ។
បើ តាម មន្ត្រី កំណើន នេះ ដោយសារតែ កំណែទម្រង់ ស៊ីជម្រៅ របស់ រដ្ឋាភិបាល និង ស្ថានភាពល្អ ប្រសើរ នៃ ស្ថិរភាព ម៉ាក្រូ សេដ្ឋកិច្ច ។
ទិន្នន័យ ពី ក្រសួង ពាណិជ្ជកម្ម បង្ហាញ ថា អាជីវកម្ម ថ្មី ប្រហែល ត្រូវបាន ១០៦៦ បាន ចុះបញ្ជី គិត មក ត្រឹម ខែមីនា គឺ កើនឡើង ៧៦ ភាគរយ ពី ចំនួន ៦០៦ ។
ក្នុង នោះ ការចុះបញ្ជី អាជីវកម្ម បរទេស កើន ៦៦ ភាគរយ ពី ២៩៤ ដល់ ៤៨៨ ខណៈ ការចុះបញ្ជី អាជីវកម្ម ក្នុង ស្រុក កើនឡើង ៨៥ ភាគរយ ពី ៣១៤ ដល់ ៥៧៨ ។
លោក កែន រដ្ឋា អ្នកនាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម បាន ថ្លែង ថា ទោះបីជា នៅ មាន បញ្ហា នយោបាយ ក៏ដោយ ក៏ វា មិន រារាំង ដល់ ពាណិជ្ជករ បរទេស និង ក្នុង ស្រុក នោះ ទេ ។
ការកើនឡើង នេះ បញ្ជាក់ ថា កម្ពុជា កំពុង ដំណើរការ បាន យ៉ាង ល្អ ប្រសើរ ។
លោក បន្ត ថា ការកើនឡើង នៃ អាជីវកម្ម ថ្មី បណ្តាល មកពី ការកែទម្រង់ មួយចំនួន ក្នុង ក្រសួង ដូចជា ដំណើរការ នៃ ការចុះបញ្ជី ដែល បទប្បញ្ញត្តិ មួយចំនួន ត្រូវបាន ផ្លាស់ប្តូរ ដើម្បីឱ្យ ការចុះបញ្ជី កាន់តែ រហ័ស ។
លោក ងួន ម៉េង តិច អគ្គ នាយក សភា ពាណិជ្ជកម្ម កម្ពុជា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ដើម ខែមេសា នេះ ថា បរិយាកាស អាជីវកម្ម របស់ កម្ពុជា នៅតែ បន្ត មាន ស្ថិរភាព មកដល់ ឆ្នាំ នេះ ។
របាយការណ៍ ថ្មី ពី ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ADB ចេញផ្សាយ កាលពី ដើម ខែមេសា បង្ហាញ ថា ការកែទម្រង់ របស់ រដ្ឋាភិបាល ដែល បាន ដាក់ចេញ កាលពី ខែមីនា ឆ្នាំ ២០១៤ ដើម្បី ជួយ សម្រួល ដល់ ពាណិជ្ជកម្ម ក្នុង ស្រុក និង ពាណិជ្ជកម្ម ក្រៅ ប្រទេស និង នីតិវិធី នៃ ការចុះបញ្ជី ពាណិជ្ជកម្ម បាន បន្ថែម ដល់ គោល នយោបាយ អភិវឌ្ឍន៍ របស់ រដ្ឋាភិបាល ក្នុង ការកំណត់ ការអភិវឌ្ឍ វិស័យ ឯកជន ជា គោលដៅ ដ៏ សំខាន់ មួយ ។
លោក កែន រដ្ឋា បញ្ជាក់ ថា ក្រសួង កំពុង ព្យាយាម បន្ថែម ទៀត ក្នុង ការជំរុញ ឱ្យ មាន អន្តរ ទំនាក់ទំនង រវាង ឯកជន និង រដ្ឋាភិបាល ដើម្បី រក ឱ្យ ឃើញ បញ្ហា ពិតប្រាកដ សម្រាប់ ការផ្លាស់ប្តូរ ។
តាម របាយការណ៍ ក្រុមហ៊ុន ចុះបញ្ជី ភាគ ច្រើន មកពី ជប៉ុន ចិន កូរ៉េ ខាងត្បូង ម៉ាឡេស៊ី និង វៀតណាម ភាគ ច្រើន ខាង ផលិតកម្ម រោងចក្រ កាត់ដេរ ស្បែកជើង កសិកម្ម ក សិ- ឧស្សាហកម្ម ទេសចរណ៍ និង ការកែច្នៃ អាហារ ៕
ឡាវ គ្រោង បង្កើត អគ្គកុងស៊ុល នៅ សៀមរាប
ភ្នំពេញៈ ប្រទេស ឡាវ គ្រោង បើក អគ្គ កុងស៊ុល ប្រចាំ នៅ ខេត្ត សៀមរាប ក្នុង បំណង ជំរុញ សហប្រតិបត្តិការ ជាមួយ កម្ពុជា តាមរយៈ វិស័យ ទេសចរណ៍ និង ពាណិជ្ជកម្ម ។
នេះ បើ តាម មន្ត្រី ជាន់ ខ្ពស់ ពី ក្រសួង ការបរទេស កម្ពុជា ។
លោក កុយ គួង អ្នកនាំពាក្យ ក្រសួង ការបរទេស កម្ពុជា បាន ប្រាប់ កាសែត ក្នុង ស្រុក កាលពី ថ្ងៃពុធ សប្តាហ៍ នេះ ថា ប្រទេស ឡាវ គ្រោង នឹង បើក អគ្គ កុងស៊ុល នៅ ខេត្ត សៀមរាប ខណៈ ភ្ញៀវ ទេសចរ ឡាវ ចូលមក កម្ពុជា កាន់តែ កើន ។
លោក បន្ថែម ថា ឡាវ ក៏ មាន គម្រោង ពង្រីក ជើងហោះហើរ របស់ ខ្លួន មក កម្ពុជា ផងដែរ ។
មន្ត្រី ពី ស្ថានទូត ឡាវ ប្រចាំ នៅ កម្ពុជា កាលពី ម្សិលមិញ បាន ឱ្យ ភ្នំពេញ ប៉ុស្តិ៍ ដឹង ថា អ្នកជំនាញ កំពុង សិក្សា រក ទីតាំង សមស្រប នៅ ខេត្ត សៀមរាប សម្រាប់ ដំណើរការ អគ្គ កុងស៊ុល ។
ក្នុង ពេល បច្ចុប្បន្ន នេះ យើង កំពុង សិក្សា មើល ទីតាំង ។
ខាង បច្ចេកទេស គេ ចុះ ពិនិត្យ ហើយ គេ បញ្ជូន ឱ្យ ថ្នាក់ដឹកនាំ នៅឡាវ ថា នឹង យក កន្លែងណា ហើយ យើង កំពុង រៀបចំ លិខិតស្នាម បញ្ជូន ទៅ ក្រសួង ការបរទេស ដែរ ដើម្បី ក្រសួង អនុញ្ញាត ។
លោក បញ្ជាក់ ដែរ ថា គោលបំណង នៃ ការបើក អគ្គ កុងស៊ុល នៅ សៀមរាប គឺ ដើម្បី ជំរុញ ការងារ ខាង ទេសចរ និង ការងារ ផ្សេង ៗ ដើម្បី រឹត ចំណង សាមគ្គីភាព ឡាវ - កម្ពុជា ។
លោក ផៃ ស៊ីផាន អ្នកនាំពាក្យ នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី មានប្រសាសន៍ ថា ការបង្កើត អគ្គកុងស៊ុល ឡាវ នៅ ខេត្ត សៀមរាប នឹង ជួយ សម្រួល ដល់ ការទទួលបាន ទិដ្ឋាការ របស់ ភ្ញៀវ ទេសចរ ដែល ធ្វើដំណើរ ដោយ ការហោះហើរ ។
លោក បន្ថែម ថា ប្រទេស ក្នុង តំបន់ កាន់តែ ចូល កៀក នឹង ភាព គ្មាន ព្រំដែន រវាង គ្នា ដូច្នេះ ការបន្ថែម អគ្គ កុងស៊ុល ដែល គ្រោង នឹង ធ្វើឡើង នេះ ជា រឿង ល្អ សម្រាប់ កម្ពុជា ។
