តម្លៃ ដំឡូង មី កើនឡើង បន្តិច ខណៈ ដែល ទិន្នផល ធ្លាក់ចុះ
ប៉ៃលិនៈ តម្លៃ ដំឡូង មី នៅ ខេត្ត ប៉ៃលិន នៅ រដូវ ប្រមូល ផល នេះ មាន ការកើនឡើង បន្តិច ខណៈ ទិន្នផល ធ្លាក់ចុះ ដោយសារ បញ្ហា អាកាសធាតុ ។
នេះ បើ តាម ការ ឱ្យដឹង ពី មន្ត្រី មន្ទីរ កសិកម្ម ខេត្ត ប៉ៃលិន ។
លោក ឆេន ឆិន អនុប្រធាន មន្ទីរ កសិកម្ម ខេត្ត ប៉ៃលិន មានប្រសាសន៍ កាលពី ម្សិលមិញ ថា ដោយសារតែ ភ្លៀង ធ្លាក់ និង ទឹក ជំនន់ ក្នុង ខែកញ្ញា រហូតដល់ តុលាកាលពី ឆ្នាំ ២០១៣ បាន ធ្វើឱ្យ ទិន្នផល ដំឡូង មី នៅ រដូវ នេះ ធ្លាក់ចុះ ។
លោក បន្ថែម ថា ថ្លៃ ដែល កើនឡើង បន្តិច នេះ គឺ ដោយសារ ការកើនឡើង នៃ អ្នកទិញ ក្នុង ស្រុក ស្តុក ទុក ដើម្បី នាំចេញ និង ក្រុមហ៊ុន ប្រមូល ទិញ ដំឡូង មី ធំ ពីរ ដែល ទើបតែ មាន វត្តមាន ក្នុង ខេត្ត ប៉ៃលិន ដែល កាត់បន្ថយ ការពឹងផ្អែក របស់ កសិករ លើ ទីផ្សារ របស់ ថៃ ។
កសិករ ខេត្ត ប៉ៃលិន ភាគ ច្រើន បាន ផ្លាស់ប្តូរ ពី ការដាំ ពោត មក ដាំ ដំឡូង មី វិញ ។
តួលេខ ពី មន្ទីរ កសិកម្ម ខេត្ត ប៉ៃលិន បង្ហាញ ថា ផ្ទៃដី ដាំដុះ សរុប ក្នុង ខេត្ត មាន ចំនួន ៣៧០០០ ហិកតា ក្នុង នោះ ៨០ ភាគរយ ជា ផ្ទៃដី ដាំដុះ ដំឡូង មី ។
ជា មធ្យម ក្នុង ដី មួយ ហិកតា កសិករ ទទួលបាន ទិន្នផល ដំឡូង មី ពី ៣០ ទៅ៤០ តោន ។
លោក មាស ម៉ុល កសិករ ដែល ដាំ ដំឡូង មី លើ ដី ៥០ ហិកតា ឱ្យដឹង ថា កាលពី ៥ឆ្នាំ មុន តម្លៃ ដំឡូង មី ស្រស់ ធ្លាក់ នៅ ត្រឹម ១២០ រៀល ដោយសារ តម្រូវការ ទីផ្សារ នៅ ថៃ ធ្លាក់ចុះ ដែល បង្ខំឱ្យ កសិករ លក់ កសិផល របស់ ខ្លួន បើ ទោះជា មិន ចំណេញ ក៏ដោយ ព្រោះ ត្រូវការ ទុន បង្វិល ។
លោក សង្ឃឹម ថា តម្លៃ នឹង រក្សា លំនឹង សម្រាប់ រដូវ ប្រមូល ផល ឆ្នាំ ក្រោយ ។
លោក បន្ត ថា តម្លៃ ល្អ ក្នុង រដូវ ប្រមូល ផល នេះ បាន ស្រោចស្រង់ ពី ការខាតបង់ ។
រដូវ ប្រមូល ផល ដំឡូង មី នៅ ខេត្ត ប៉ៃលិន ចាប់ផ្តើម ពី ខែធ្នូ ដល់ ខែមេសា ។
ដំឡូង មី ស្រស់ និង ស្ងួត ត្រូវបាន លក់ ទៅ ឱ្យ អ្នក ប្រមូល ទិញ ក្នុង ស្រុក ដែល ក្រោយមក នឹង ត្រូវ នាំចេញ ទៅ ថៃ ម៉ាឡេស៊ី និង ចិន ។
លោក មូល សម គណនេយ្យក រ នៅ ក្រុមហ៊ុន ចម្រើន ជ័យ ឱ្យដឹង ថា ក្រុមហ៊ុន លោក ទិញ ដំឡូង មី ពី ២ម៉ឺន ទៅ ៦ម៉ឺន តោន ពី កសិករ ។
លោក ស្វាគមន៍ វត្តមាន ក្រុមហ៊ុន ប្រមូល ទិញ របស់ ម៉ាឡេស៊ី និង ចិន ទោះជា វា បន្ថែម ការប្រកួតប្រជែង ក៏ដោយ ។
ទិន្នផល ឆ្នាំ នេះ ធ្លាក់ចុះ តែ តម្លៃ ល្អ ។
នេះ ជា រឿង ល្អ សម្រាប់ កសិករ ៕
សេវា បង់ ពន្ធ គ្រប់ ប្រភេទ អាច ធ្វើ តាមរយៈ អេស៊ីលីដា
ភ្នំពេញៈ ធនាគារ អេស៊ីលីដា បាន ការអនុញ្ញាត កាន់តែ ទូលាយ លើ សេវា ទទួល បង់ ពន្ធ របស់ សាធារណជន និង ក្រុមហ៊ុន ពាណិជ្ជកម្ម នានា ដែល ជាប់ កាតព្វកិច្ច បង់ ពន្ធ ជូន រដ្ឋ ។
ពី ពេលនេះ ទៅ រាល់ ការបង់ ពន្ធ គ្រប់ ប្រភេទ ប្រជាពលរដ្ឋ និង ពាណិជ្ជករ អាច មាន ជម្រើស បង់ ពន្ធ តាម ធនាគារ អេស៊ីលីដា ឬ ទៅ ស្ថាប័ន រដ្ឋ ផ្ទាល់ បន្ទាប់ពី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន អនុញ្ញាតឱ្យ មាន ដំណើរការ បង់ ពន្ធ តាម ធនាគារ នេះ ដើម្បី បង្ក ភាពងាយស្រួល និង ពង្រឹង តម្លាភាព ។
សេវា បង់ ពន្ធ តាម ធនាគារ អេស៊ីលីដា នេះ ដំបូង ឡើយ មាន តែ ពន្ធ លើ មធ្យោបាយ ធ្វើដំណើរ ដូចជា ម៉ូតូ ប៉ុណ្ណោះ ។
ធនាគារ អេស៊ីលីដា កាលពី ម្សិលមិញ បាន ប្រកាស ផ្តើម ដំណើរការ សេវា ប្រមូល ប្រាក់ បង់ ពន្ធ គ្រប់ ប្រភេទ សម្រាប់ សាធារណជន ដែល ជាប់ កាតព្វកិច្ច បង់ ពន្ធ ជូន រដ្ឋ អាច បង់ ពន្ធ តាម សាខា ធនាគារ អេស៊ីលីដា ទាំង ២៥១ នៅ ទូទាំង ប្រទេស ដោយ ពុំ ចាំបាច់ កាន់ សាច់ប្រាក់ ផ្ទាល់ ទៅកាន់ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ ឬ អគ្គ នាយកដ្ឋាន ពន្ធដារ ដូច មុន ទៀត ឡើយ ។
កាលពី មុន អតិថិជន ក៏ អាច ធ្វើ ការបង់ ពន្ធ តាមរយៈ ធនាគារ អេស៊ីលីដា ដែរ តែ កាល នោះ មាន តែ ការបង់ ពន្ធ លើ ការចរាចរ យានយន្ត ប៉ុណ្ណោះ ។
លោក អ៊ិន ចាន់ នី ប្រធាន នាយក ប្រតិបត្តិ ធនាគារ អេស៊ីលីដា បាន បញ្ជាក់ ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ម្សិលមិញ ថា សេវា បង់ ពន្ធ តាម ធនាគារ នេះ នឹង ជួយ សម្រួល ឱ្យ គុណភាព ការផ្តល់ សេវា សាធារណៈ មាន ភាពប្រសើរ ជាង មុន ហើយ សាធារណជន អាច បង់ ពន្ធ គ្រប់ ប្រភេទ ដែល ពួកគេ ជាប់ កាតព្វកិច្ច ដោយ មិន ចាំបាច់ បង់ តម្លៃ សេវា ជូន ធនាគារ ។
លោក បន្ត ថា វា ក៏ នឹង ជួយ ដល់ វិស័យ ហិរញ្ញវត្ថុ ផងដែរ ដែល នឹង ធ្វើឱ្យ លុយ ចរាចរ ក្នុង ទីផ្សារ ហិរញ្ញវត្ថុ កាន់តែ ច្រើន ដើម្បី កំណើន សេដ្ឋកិច្ច ។
ការបង់ ពន្ធ ជូន រដ្ឋ ធ្វើឡើង ដោយ ប្រើ រូបិយប័ណ្ណ ប្រាក់ រៀល តែ ក្នុង ករណី ដែល អតិថិជន បង់ ជា រូបិយប័ណ្ណ ផ្សេង ធនាគារ នឹង ធ្វើ ការទូទាត់ ដោយ អាស្រ័យ តាម អត្រា ប្តូរ ប្រាក់ ជាក់ស្តែង ។
យោង តាម តួលេខ ប្រាក់ ចំណូល ពី ការប្រមូល ពន្ធ ពី អគ្គ នាយកដ្ឋាន ពន្ធដារ រដ្ឋាភិបាល កម្ពុជា ប្រមូល បាន ប្រាក់ ចំណូល ពន្ធ សរុប ប្រមាណ ៨៨១ លាន ដុល្លារ កាលពី ឆ្នាំ ២០១៣ ។
គិត ត្រឹម រយៈពេល បី ខែ ដំបូង ឆ្នាំ នេះ កម្ពុជា បាន ប្រមូល ពន្ធ ចំនួន ១៩២ លាន ដុល្លារ ។
លោក ម៉ីវ៉ាន់ ប្រធាន នាយកដ្ឋាន ឧស្សាហកម្ម ហិរញ្ញវត្ថុ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ថ្លែង ថា ការសម្រេច អនុញ្ញាតឱ្យ មាន ការ បង់ ពន្ធ តាមរយៈ សេវា ធនាគារ គឺជា ផ្នែក មួយ នៃ កំណែទម្រង់ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី បង្កើន តម្លាភាព និង ប្រសិទ្ធភាព នៅក្នុង ការប្រមូល ប្រាក់ ចំណូល ពី ពន្ធ សម្រាប់ ថវិកា ជាតិ ។
លោក បាន បន្ថែម ថា វា គឺជា វិធានការ ដ៏ ល្អ មួយ ក្នុង ការជួយ សម្រួល ដំណើរ ការ ពាណិជ្ជកម្ម សម្រាប់ ពាណិជ្ជករ ហើយក៏ ដើម្បី កាត់បន្ថយ ភាពស្មុគស្មាញ ក្នុង ការផ្ទៀងផ្ទាត់ ឯកសារ នានា ដែល ធ្លាប់ មាន កន្លងមក ផងដែរ ។
