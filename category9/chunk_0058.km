អ្នកស្រក់ទឹកភ្នែក ព្រោះអ្នកមិនធ្លាប់នៅកន្លែងបែបនេះទេ ។
គ្រោះថ្នាក់ ដល់ អាយុជីវិត ក្មេងប្រុស តូច ពីរ នាក់ ។
តើនាងស្លៀកពាក់បែប ណាក្នុងដំណើរ កម្សាន្តចុងក្រោយទៅកាន់ ចក្រភពអង់គ្លេសក្នុងសមត្ថភាពផ្លូវការ?
ពេត្រុសអាចយកឈ្នះការ ភ័យខ្លាចរបស់គាត់ ហើយចុះទៅទឹកដោយ សារគាត់ដឹងថាព្រះ យេស៊ូមានវត្តមាន ។
23 មិនត្រង់នឹងអ្នកទេ គេមិនត្រង់ជាមួយទេ ។
ពិសេសខ្ញុំឆ្លៀតពេលខ្លះដើម្បីជួបអ្នក » ។
ដែល បន្ទាប់មក ប៉ះពាល់ ដល់ រសជាតិ នៃ អាហារ សម្រាប់ អ្នក ដែល ចង់បាន រសជាតិ ជក់ បារី ពិតប្រាកដ ។
ខ្ញុំ មានអារម្មណ៍ ភ័យខ្លាច ជារៀងរាល់ ថ្ងៃ ។
ចុះ ទៅជាន់ ទល់ នឹង ជង្គង់ របស់ គាត់ ។
លោកុប្បត្តិ 27:13 នៅខែទី ដប់ គឺម៉ារ៉ៃ ហើយគាត់ជាជន ‌ជាតិនេតូ ផាត ដែល មកពីពួកសេរ៉ាហ៊ីត ។ ហើយ នៅក្នុង ក្រុមហ៊ុន របស់ គាត់ មាន ពីរ ម៉ឺន បួន ពាន់ នាក់ ។
