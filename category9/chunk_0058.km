ខ្ញុំជឿលើត្រកូលរបស់ខ្ញុំ និងប្រជាជនរបស់ខ្ញុំ » ។
ដល់ មនុស្ស ស្លាប់ ក្នុង ចំណោម អ្នក រស់ ។
នេះ គឺជា វិធី មួយ ដើម្បី ធ្វើឱ្យ i/o ដែល ត្រូវការ សម្រាប់ ការតភ្ជាប់ ។
រូប កាយមិនមែនសម្រាប់អំពើអសីលធម៌ទេ គឺសម្រាប់ព្រះ‌ អម្ចាស់ ហើយព្រះ‌ អម្ចាស់គឺសម្រាប់រូប កាយ ។
អ្នក ប្រហែលជា មិន ស្គាល់ តំបន់ ដែល ខ្ញុំ រស់នៅ ទេ ។
អ្នក ជឿ ដែល ជា ចៅហ្វាយ នាយ នៃ ការត្អូញត្អែរ គឺ មិន បាន ឃើញ របស់ ថ្មី ដូច្នេះហើយ ប្រកាន់ខ្ជាប់ នូវ ជីវិត ជា មធ្យម ដែល មិន មែន សម្រាប់ ពួកគេ ។
នេះមិនគួរត្រូវបានធ្វើជាផ្លូវការ នៅក្នុង 504 មួយ ?
យើងមិនដូចគ្នានឹងរៀបការ ទេ ?
ឥឡូវនេះ ផ្នែក មួយ គឺ ថា វា ពិបាក ក្នុង ការជួល អ្នក អភិវឌ្ឍន៍ ល្អ ។
៣៧ នៅក្រុងនោះ មានស្ត្រីមាន បាបម្នាក់ ។
អ្នក តែង ទំនុកតម្កើង ដឹង ពី អ្វី ដែល ត្រូវ ឆ្លងកាត់ ការបៀតបៀន និង ការរងទុក្ខ ហើយ នៅ ពេល ដែល គាត់ បាន ធ្វើ គាត់ បាន អធិស្ឋាន ដល់ ព្រះ។
អ្នក និយាយទៅ កាន់កូនចៅអ៊ីស្រា ‌ អែលថា យើងនឹងត្រូវចាត់ខ្ញុំឲ្យមក រកអ្នក » ។
គាត់ណែនាំ ពល ទាហានទាំងពីរឲ្យចាប់កាំភ្លើងតាមគាត់ ។
ខ្ញុំ បាន ទិញ ផលិតផល នេះ ហើយ សប្បាយ ចិត្ត ខ្លាំង ណាស់ ។
វាត្រូវបានកត់ត្រាផងដែរថាយើងនឹង « នៅ ជាមួយនឹងព្រះអម្ចាស់ ជារៀងរហូត » ។
គាត់ ថា គាត់ ចង់ឱ្យ មនុស្ស ដឹង ថា គាត់ មិន មែន ជា មនុស្ស អាក្រក់
នេះ ជា អាហារ សម្រន់ ធម្មតា សម្រាប់ ប្រជាជន កម្ពុជា ។
អ្នក នឹង មិន ចាំបាច់ ចំណាយ ពេល ច្រើន ក្នុង ការស្វែងរក វត្ថុ ដែល អ្នក កំពុង ស្វែងរក នោះ ទេ ។
ហើយ ខ្ញុំ នឹង លើក គាត់ ឡើង នៅ ថ្ងៃ ចុងក្រោយ ។
ទ្រង់មិនរើសអើងរវាងយើងនិងគេឡើយ ដ្បិតទ្រង់បាន ប ន្សុទ្ធ ចិត្តគេដោយសេចក្ដី ជំនឿ » ។
ខ្ញុំ បាន ប្រាប់ គាត់ ថា កូនប្រុស របស់ ខ្ញុំ គឺជា នាយក ប្រតិបត្តិ នៃ ធនាគារ ពិភពលោក ។
ខ្ញុំប្រាកដថាតុលាការអេស្ប៉ាញចង់ឱ្យរឿងនោះកើតឡើងចំពោះ Letizia ។
ពួក សេរី និយម បាន ធ្វើ ដូចគ្នា ចំពោះ ប្រធានាធិបតី ប៊ូស ។
ពណ៌ បៃតង ដែល ស្ថិត នៅ ខាងក្រោម ប្រាសាទ ។
ពពែ ពីរ ក្បាល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃ ដង្វាយ ធួន ។
2 ពេលដែលអ្នករៀបចំ ធ្វើសង្គ្រាម បូជា ‌ចារ្យចេញមុខទៅប្រាប់កងទ័ព ។
ប៉ុន្តែពួកគេបានរក្សានាឡិកាស្ងៀមដោយមិនព្រិច ភ្នែក ។
សំណួរ ទី 8; យើងខ្ញុំ សូម ថ្លែងអំណរគុណ ចំពោះ ឯកឧត្តម ។
« រួចគាត់យកនំប៉័ង មកអរព្រះគុណ ហើយកាច់ឲ្យគេទាំងនិយាយ ។
គាត់និយាយថា៖ « លោកម្ចាស់អើយ ត្បិតខ្ញុំមិនដែលបានបរិភោគអ្វីដែលធម្មតា ឬមិនស្អាតនោះទេ » ។
ខ្ញុំ មិន និយាយ អំពី អ្នក ទាំងអស់ គ្នា ទេ ។ ខ្ញុំ ស្គាល់ អ្នក ដែល ខ្ញុំ បាន ជ្រើសរើស ។ វាគឺថា បទគម្ពីរអាចនឹងត្រូវបានសម្រេចថា : « អ្នក ណាដែលបានបរិភោគអាហាររបស់ខ្ញុំបានលើកកែងជើងរបស់គាត់ប្រឆាំងនឹងខ្ញុំ » ។
ការផ្អាក ចរាចរណ៍ ទាំងអស់ ។
វាទៅគ្រប់កន្លែងដែលខ្ញុំទៅ » ។
ពួកគេបានប្រសូតបានកូនប្រុសពីរនាក់ ដែលអ្នកទាំងពីរកំពុង រស់នៅ ។
នេហេមា 17:22 លោកមាន ប្រសាសន៍ទៅ កាន់សិស្ស ថា៖ « ពេលវេលាមកដល់ហើយ ដែលអ្នក រាល់គ្នាចង់ឃើញថ្ងៃមួយរបស់បុត្រមនុស្ស ប៉ុន្តែអ្នក រាល់គ្នានឹងមិនឃើញទេ ។
ហ្វូង មនុស្ស នៅ ពេល នោះ ហាក់ដូចជា ណាមួយ ។
វា ត្រូវបាន គេ ដាក់ នៅក្នុង រោងចក្រ ។
យប់ឡើងលើគ្រែខ្ញុំស្វែង រកអ្នកដែលខ្ញុំស្រលាញ់ ខ្ញុំ រកគាត់ តែរកមិនឃើញ ។
នៅលើក្មួយប្រុសរបស់គាត់មានសាកសពបុរសម្នាក់នៅតាមផ្លូវរថភ្លើង ។
ពេលដែលអ្នករៀប ការ គេចង់ឱ្យអ្នកមានកូន ។
ចន គឺជា អ្នក ជួសជុល ចុងក្រោយ ។
នេះ មាន ន័យ ថា ការខិតខំ ប្រឹងប្រែង និង អ្វី ក៏ដោយ ។
ហើយវាជាការ រំលឹកថា យើងត្រូវ តែប្រុងប្រយ័ត្នចំពោះការ ខ្សឹបខ្សៀវរបស់សាតាំង ។
ដូច្នេះអ្នកកំពុងនិយាយថាគ្មានជនជាតិដើមភាគ តិចនៅអឺរ៉ុបទេ ?
ព្រះចៅ អធិរាជ បាន បញ្ជូន ម្តាយ របស់ គាត់
បន្ទាប់មក គាត់បានទៅប្រទេសក្រិក 3 ហើយស្នាក់នៅ ទីនោះអស់ រយៈពេលបីខែ ។
នេះ មិន មែន ជា ប៉ម ដ៏ អស្ចារ្យ បំផុត នៅលើ ពិភពលោក ទេ នេះ គ្រាន់តែ ជា ការសរសើរ
ប៉ុន្តែតើពួកគេបានយកវាទៅកម្រិតខ្លាំងក្នុងហ្គេមនេះទេ ?
យើងបានឮរឿងផ្សេង ៗ ។
និង រីករាយ នឹង ភាពអស្ចារ្យ របស់ ពួកគេ ។
អ្នក ថែមទាំងបានចូលរួមក្នុងទុក្ខវេទនារបស់អ្នកដែលជាប់គុក ហើយរីករាយនឹងការ រឹបអូសរបស់អ្នក ដោយដឹងថាអ្នកមានទ្រព្យ សម្បត្តិ កាន់ តែប្រសើរ និងជាអចិន្ត្រៃយ៍ ។
ទ្រព្យសម្បត្តិ សំខាន់ ៗ របស់ ព្រះមហាក្សត្រ ។
ឥឡូវនេះ ទ្រង់ គង់ នៅ ខាងស្ដាំ ដៃ នៃ ព្រះវរ បិតា ហើយ ថ្ងៃ ណាមួយ ទ្រង់ នឹង យាង មកវិញ មិន មែន ជា អ្នកបម្រើ ដ៏ រាប ទាប នោះ ទេ ប៉ុន្តែ ទ្រង់ ជា អ្នក ឈ្នះ នៃ ស្តេច និង ជា ព្រះអម្ចាស់ នៃ ព្រះអម្ចាស់ !
ពួកគេ ខ្លះ ត្រូវ គ្រប់គ្រង ជីវិត ជាមួយ កូន ។
ពេលឪពុកម្ដាយរកឃើញគាត់ធ្វើអ្វីក៏ភ្ញាក់ផ្អើល ។
ចូរនៅចំពោះព្រះ‌ អម្ចាស់ ជាព្រះ នៃយើង !
ខ្ញុំ ពិតជា ណែនាំ ឱ្យ ស្នាក់ នៅ ទីនេះ ប្រសិនបើ អ្នក នឹង នៅក្នុង ទីក្រុង យូរ ជាង មួយ សប្តាហ៍ !
ព្រះអម្ចាស់មានព្រះបន្ទូល ថា៖ ‹ យើងនឹងបំផ្លាញមោទនភាពរបស់ជន ជាតិយូដា និងមោទនភាព ដ៏ មហិមារបស់ក្រុងយេរូសាឡឹមដូចគ្នា ។
ប្រយ័ត្ន៖ មាន បុរស អត់ អាវ ។
ដើម្បី បញ្ឈប់ សង្រ្គាម នៅលើ ផែនដី !
“ ដោយ សារសេចក្តី សប្បុរសរបស់ទ្រង់ប្រសើរជាងជីវិត
