លោកម៉ូសេ បានត្រូវចាត់ទុកថាជាបុត្រីរបស់ផារ៉ោន
ប្រាប់ ការពិត ហើយ មានអារម្មណ៍ ឈឺចាប់ ។
នេះ គឺជា អ្វី ដែល ធ្វើឱ្យ វា សម្រេចបាន សម្រាប់ អ្នក ក្នុង ការសម្រក ទម្ងន់ ។
៥០ឆ្នាំក្រោយមក ខ្ញុំបានត្រឡប់ទៅស្រុក កំណើតវិញ ។
ដោយសារ កាលៈទេសៈ បច្ចុប្បន្ន ព្រឹត្តិការណ៍ នេះ នឹង ប្រព្រឹត្តទៅ លើ អ៊ីនធឺណិត ទាំងស្រុង នៅ ឆ្នាំ នេះ ។
អ្នកដែលនៅជាមួយទ្រង់មានជីវិតនៅថ្ងៃនេះ ។
យក ខ្ញុំ ចេញពី ដៃ របស់ មនុស្ស
ខ្ញុំគិតថាស្ត្រីទាំងនោះមិនត្រូវបានអនុញ្ញាតឱ្យធ្វើការ ទេ ។
វា ពិបាក ក្នុង ការដាក់ ខ្លួន ឯង ជា អ្នកអាន ។
អត្ថន័យ៖ ស្នាម ថើប ដំបូង សម្រាប់ អ្នក ដែល ស្រលាញ់ គ្នា ពិតប្រាកដ
ជា អកុសល នេះ គឺជា ជំងឺ ដែល មិន មាន ការព្យាបាល ពេញលេញ ។
ប៉ុន្តែពួកគេបួននាក់បានដាច់ចេញ ហើយកំពុងតម្រង់ មករកខ្ញុំ ។
ម្ជុល ដេរ នឹង ត្រូវការ ខ្សែ ស្រឡាយ ដើម្បីឱ្យ អ្នក អាច ប្រើ វា បាន ។
ដើម្បី បំបែក កញ្ចក់ ខ្លាំង ។
ភ្នាក់ងារ ដែល ធ្វើការ ជាមួយ យើង ។
ឲ្យ តែមានកូន កំលោះនៅជាមួយគេមិនអាចទៅរួច
នៅក្នុងព្រឹត្តិការណ៍មួយក្នុងទីក្រុង Miami យប់មិញ ។
បើ ខ្ញុំ ញ៉ាំ សាឡាដ ព្រោះ វា ល្អ សម្រាប់ សុខភាព
អ្នកដែល រស់នៅអាមេរិក » ។
នៅពេល អ្នក ធ្វើ តាម ពួកគេ អ្នក នឹង ទទួលបាន លទ្ធផល ល្អ ពី សកលលោក ។
ពួកគេ នៅ ជាមួយ ព្រះ។
« បន្ទាប់ពីទ្រង់មាន បន្ទូលដូច្នេះ ទ្រង់ត្រូវបានយកទៅនៅចំពោះភ្នែកគេ ហើយពពកបានលាក់ទ្រង់ពីភ្នែកគេ ។
គ្មាន នរណា ម្នាក់ បាត់បង់ ឡើយ ប៉ុន្តែ កប៉ាល់ នឹង ត្រូវ បំផ្លាញ ។
សម្រែក របស់ មនុស្ស ;
យ៉ាងណាមិញ តើនរណាខ្លះចង់ធ្វើឲ្យម្ដាយខក ចិត្ត ?
ប៉ុន្តែពួកគេមិន មែន ជាមនុស្សដំបូងដែលបម្រើអភិបូជានៅ ទីនេះទេ ។
ម៉ាក់ ខ្ញុំ ទើបតែ ស្លាប់ គាត់ មិន និយាយ ជាមួយ ខ្ញុំ ទេ ។
អ្នកបង្កើតសន្តិភាពមានសុភមង្គលហើយ ដ្បិតគេនឹងត្រូវបានហៅថាជាកូនរបស់ព្រះ។
ដោយ គិត ពី ភាពសម្បូរបែប នៃ ទឹក នៅលើ ផែនដី ។
នាង គឺជា អ្នក និយាយ ការពិត ។
លោកមាន ប្រសាសន៍ ថា៖ « តើអ្នក ណាបានព្រមានអ្នកឲ្យ រត់ចេញពីសេចក្ដី ក្រោធដែលនឹង មកដល់ ? » ។
នៅក្នុង សកម្មភាព ការងារ ។ តម្រូវការ ។
ប្រសិនបើ អ្នក ចង់ ចូលរួម របប អាហារ ក្រុម របស់ យើង សូម ធ្វើ ។
បាទ ឈ្មោះ កម្មវិធី វេទមន្ត គឺ វេយ្យាករណ៍ ។
និងភូមិរបស់វា » ។
ប៉ុន្តែខ្ញុំចង់ដឹងថាអ្វីដែលសំខាន់គួរតែជា។
អ្នក មិន អាច ជ្រើសរើស ប្រអប់ សំបុត្រ របស់ អ្នក បាន ទេ ។
មិនថាយើងជានរណា ឬរស់ នៅកន្លែង ណាទេ យើងទទួល រង ផលប៉ះពាល់ពីវា ។
បន្ទាប់មក ពេលគាត់ត្រឡប់មកវិញ ពួកគេដណ្តើមបានជ័យ ជម្នះ ៤ លើកជាប់ៗគ្នា មុននឹងធ្លាក់ក្នុងម៉ោងបន្ថែមនៅពេលនោះ។
ហើយបានភ្លក់ព្រះបន្ទូលដ៏ល្អរបស់ព្រះ និងអំណាចនៃអាយុខាងមុខ
ដើម្បី ទទួលយក អាណាព្យាបាល របស់ នាង ។
តើអ្នកនឹងមិនសប្បាយ ចិត្ត និង តស៊ូដល់ពេលណា ?
ប្រទេស ឥណ្ឌា ជា សមាជិក ។
៣៤ ព្រះយេស៊ូមានព្រះបន្ទូល តប ថា៖ « តើអ្នក និយាយរឿងនេះដោយខ្លួនឯង ឬមានអ្នក ឯទៀតប្រាប់អ្នកអំពីខ្ញុំ ? » ។
តើធ្វើ ដូចម្តេចដើម្បីឱ្យមានអារម្មណ៍ ស្រេកឃ្លានសម្រាប់ការ នៅ សល់នៃល្ងាច?
« អ្នក ណាដែលស្អប់បងប្អូនខ្លួន នោះជាឃាត ក ហើយអ្នក រាល់គ្នាដឹងថា គ្មានឃាតកណាមានជីវិតអស់ កល្ប នៅក្នុងខ្លួននោះឡើយ » ។
ទំហំ និងកម្មវិធីដែលងាយនឹងទម្ងន់ ។
ជើង នឹង ការពារ គាត់ ពី ខាងក្រៅ
គាត់ នឹង ឈប់ ធ្វើជា បុរស ។
ឥឡូវនេះ ខ្ញុំនឹងឲ្យអ្នកត្រឡប់ទៅស្តាប់តន្ត្រីរបស់ស្វាមីខ្ញុំ វិញ » ។
ការពិត គឺ ថា ការបកស្រាយ របស់ ម៉ាថា យ ២៣:៩ ប្រឆាំង នឹង ភស្តុតាង ដ៏ លើសលប់ នៃ បទ គម្ពីរ ។
ទាំង នេះ គឺជា ស្បែកជើង ដែល ខ្ញុំ បាន ឃើញ ។
ពួកគេងឿង ឆ្ងល់ ហើយសួរទាំងងឿង ឆ្ងល់ ថា៖ « អ្នកទាំងនេះមិនមែនជាអ្នក និយាយស្រុកកាលីឡេទេ ?
ព្រះជាម្ចាស់ ទ្រង់ គង់ នៅក្នុង ព្រះគ្រីស្ទ ផ្សះផ្សា ពិភពលោក ជាមួយនឹង ទ្រង់ ផ្ទាល់ ដោយ មិន រាប់បញ្ចូល ការបំពាន របស់ ពួកគេ ប្រឆាំង នឹង ពួកគេ ហើយ ទ្រង់ បាន ប្តេជ្ញាចិត្ត ចំពោះ យើង នូវ កិច្ចការ នៃ ការផ្សះផ្សា ។
ពេត្រុស និង យ៉ូហាន បានបង្ហាញ ចិត្តសប្បុរស ដ៏ រីករាយដូចគ្នានោះ នៅពេលពួកគេបានព្យាបាលបុរសខ្វិនម្នាក់ ដែលកំពុងសុំ ទាននៅខាងក្រៅព្រះវិហារបរិសុទ្ធក្នុងក្រុងយេរូសាឡិម ( កិច្ចការ 3:1-10) ។
រក្សាការ សង្កត់សំឡេងគាត់សមនឹងការ ព្យួរ (1) .
« ដូច្នេះ ខ្ញុំបានប្រាប់អ្នក ថា អ្នកនឹងត្រូវស្លាប់ក្នុងអំពើ បាបរបស់អ្នក ដ្បិតប្រសិនបើអ្នកមិនជឿថាខ្ញុំ ជា អ្នកនឹងត្រូវស្លាប់ក្នុងអំពើ បាបរបស់អ្នក » ។
ហើយ វាយ អ្នកសាងសង់ ។
ប៉ុន្តែ នេះ គឺជា ពេលវេលា របស់ អ្នក ឥឡូវនេះ គឺជា ពេលវេលា នៃ អំណាច នៃ ភាពងងឹត ។
កុំ ចុះចាញ់ ដោយ ភាពអស់សង្ឃឹម ។
បើអ្នកទទូច អ្នកត្រូវបានគេយកទៅកន្លែងមួយដែលហៅថាខាងលិច
ឥឡូវគាត់មានគម្រោងពាក់មួកសុវត្ថិភាពម្ដងទៀត ។
« មានដំណោះស្រាយចំពោះបញ្ហានេះ ហើយនោះគឺត្រូវប្រើផ្លូវឆ្លាស់គ្នា ។
គាត់ត្រូវបានជាប់គាំងនៅទីនោះជាច្រើនថ្ងៃ ។
ខ្ញុំបាននិយាយថា " តើអ្នកពិតជានៅទីនេះមែនទេ ?
ពិតហើយ ការ ព្រួយបារម្ភអំពី វាគឺការ ធ្វើទោះបីជាមានតម្លៃគ្មានដែនកំណត់នៃការ សុគតរបស់ព្រះរាជ បុត្រានៃព្រះ។
បន្ទាប់មកគេដាក់ភ្លើងនៅកណ្តាលវា ហើយវាភ្លឺរាល់យប់ ។
« ក្នុងនាមជាជនស្លូតត្រង់ម្នាក់ដែលត្រូវបានឃុំខ្លួនដោយមិនបានប្រព្រឹត្តខុសអស់រយៈពេលពីរឆ្នាំ មកហើយនោះ ខ្ញុំនៅ តែទាមទារឲ្យទម្លាក់ បទចោទ មកលើរូបខ្ញុំ » ។
១០ - ចំពោះអ្នក ណាដែល កាន់ច្បាប់ទាំងអស់ ប៉ុន្តែធ្វើឲ្យភ្លាត់ក្នុងមួយចំណុច ត្រូវបានគេវិនិច្ឆ័យថាបានប្រឆាំងទាំងអស់ ។
