« ហើយយើងមានទំនិញច្រើនជាងទំនិញផ្សេងទៀត » ។
តើអ្នកអាចប្រាប់ថានរណាជាម្តាយ និងនរណាជាកូនស្រី ?
យើង ប្រមូលផ្តុំ គ្នា ដើម្បី ថ្វាយបង្គំ និង អធិស្ឋាន ។
នោះ មាន ន័យ ថា ពួកគេ រស់ នៅក្នុង ស្ថានភាព នៃ ការថប់បារម្ភ និង ការឈឺចាប់ ។
ពួកគេ ជាអ្នកដែលងាក មក រកយើង យើងបានឈរក្បែរពួកគេ ។
គាត់បាន ពរខ្លួនគាត់ដោយពាក់ ក ណ្តា លពីរ បន្ទាប់មកយ៉ាងប្រុងប្រយ័ត្នរុញវាចូលទៅក្នុងមាត់របស់គាត់។
រៀបចំ សម្រាប់ ថ្ងៃ បន្ទាប់ កុំ ចូល ម្តង ទៀត ។
ដូច្នេះ រហូតមកដល់សព្វថ្ងៃនេះ ជន ជាតិអ៊ីស្រាអែលមិនបរិភោគសាច់ឆ្អឹងត្រគាកដែលនៅត្រង់ប្រហោងភ្លៅទេ ព្រោះគាត់បានពាល់ភ្លៅរបស់យ៉ាកុបនៅត្រង់ប្រហោងត្រគាក ។
ស្ត្រីទាំងបីនាក់នេះបានទម្លាយរឿងថ្មីសម្រាប់ស្ត្រីដែលនៅពីក្រោយពួកគេ ប៉ុន្តែពួកគេមិនពិតចំពោះខ្លួនឡើយ ។ ពួកគេ មិន មែន ជា អ្នកណែនាំ ដែល មាន ទំនុកចិត្ត ទេ ។
ដរាបណា ខ្ញុំ នៅ រស់ ខ្ញុំ នឹង
ខ្ញុំអាចទិញពីគេ ហើយដឹងថាខ្ញុំមិនចាំយូរទេ ។
តើអ្នកចាក់ឫសឱ្យគេដូចយើងដែរឬទេ ?
សំឡេងរំខានចេញ មកពីកាតវីដេអូរបស់ខ្ញុំ មិនមែនជាករណីផ្ទាល់ខ្លួនទេ ។
ពួកគេ ចង់ឱ្យ ពិភពលោក បាន ឃើញ ពួកគេ ។
• ឈ្មោះដើមរបស់ម្តាយ
វា ជាពិភពមួយនៅឆ្ងាយ, ជិតដូច្នេះ :
គាត់បាននិយាយថា៖ « មនុស្សមានសិទ្ធិនិយាយថាពួកគេត្រូវបានគេប្រព្រឹត្តដោយអយុត្តិធម៌ ។
យើង បាន ឮ ច្រើន អំពី ការិយាល័យ ប្រៃសណីយ៍ នេះ ។
សម្រាប់ អ្នក ចិញ្ចឹម សត្វ ដោយសារ មាន ឆ្មា ( ម្ចាស់ ) នៅក្នុង សួនច្បារ ។
ខ្ញុំនឹងពិនិត្យមើលលទ្ធភាពនេះឱ្យកាន់តែប្រយ័ត្នប្រយែង ។
ត្រូវបាន នាំយក មក លើ យន្តហោះ ។
3 នៅក្នុងក្រុងនោះ មានស្ត្រីមេម៉ាយម្នាក់មករកគាត់ ដោយពោលថា៖ ‹ សូមរកយុត្តិធម៌ឲ្យខ្ញុំប្រឆាំងនឹងអ្នកប្រឆាំងផង › ។
នៅក្នុង ភាសា និង សមត្ថភាព ក្នុង ការបកប្រែ ភាសា ។
វា ជា គេហទំព័រ រីករាយ ។
អនុញ្ញាតឱ្យ ខ្ញុំ ចាកចេញ ។
22 ប៉ុន្តែបើខ្ញុំ រស់នៅក្នុងសាច់ឈាម នោះនឹងបង្កើត ផលពីការងាររបស់ខ្ញុំ ។ ប៉ុន្តែ ខ្ញុំ មិន ដឹង ថា ខ្ញុំ នឹង ជ្រើសរើស អ្វី ទេ ។
ញ៉ាំយប់ជ្រៅ ខ្ញុំដឹងថាវាមិនល្អ និងអាក្រក់ ។
ឥឡូវនេះ គាត់ បាន និយាយ ថា " រុស្ស៊ី ត្រូវតែ សម្រេចចិត្ត ថា តើ ខ្លួន នឹង បន្ត ដើរ លើ ផ្លូវ ងងឹត នេះ ឬ ប្រសិនបើ វា នឹង ចូលរួម ជាមួយ ប្រទេស ស៊ីវិល័យ ជា កម្លាំង សម្រាប់ ស្ថិរភាព និង សន្តិភាព " ។
35 ប្រជាជនចេញទៅមើលហេតុការណ៍ ។
ជាមួយគ្នា នេះ ស៊ីស .
តើអ្នក យល់ថាពួកគេមាន ប្រដាប់អាវុធល្អប៉ុណ្ណាហើយតើពួកគេមានមូលនិធិ ល្អប៉ុណ្ណា ?
ដំណើរការ កម្មវិធី ប្រឆាំង មេរោគ ដើម្បី ការពារ កុំព្យូទ័រ របស់ អ្នក ពី មេរោគ និង មេរោគ ។
ប៉ះ ស្លាបព្រា ដែក ដែល កំពុង អង្គុយ ក្នុង ទឹក ពុះ
យើង ត្រូវ ធ្វើ អ្វី មួយ ដើម្បី ការពារ យើង ។
ត្រូវតែ មាន ក្តីសង្ឃឹម ពិតប្រាកដ ។
ដូច្នេះហើយ គាត់ បាន ជ្រើសរើស និយាយ ថ្មី
អ្នក ណាដែលបានឃើញខ្ញុំបានឃើញព្រះបិតា ។
ជ្រើសរើស ទីតាំង ដែល អ្នក ចូលចិត្ត អង្គុយ ហើយ យើង នឹង ប្រាប់ អ្នក អំពី ចរិត របស់ អ្នក ។
ទ្រង់ចាត់សិស្សពីរនាក់ឲ្យទៅ ហើយមានព្រះ‌បន្ទូលទៅគេ ថា៖ « ចូរចូលទៅក្នុងទីក្រុង នោះមានបុរសម្នាក់នឹង មកជួបអ្នក ដោយ កាន់ក្អមទឹក ។
គាត់បាននិយាយថា វាទើប តែចាប់ផ្តើមធ្វើការ ម្តងទៀត។
ដើម្បី ធ្វើ រឿង នេះ ។ ត្រូវបាន បង្ហាញ ។ ឧទាហរណ៍ ។
ដូច្នេះ ពួកគេ នៅ ម្នាក់ឯង ។
កុំ ស្ទាក់ស្ទើរ ព្រោះ មួយ នេះ នឹង បាត់ !
គួរអោយ ស្រលាញ់ ហើយ រៀបការ ?
ដូច្នេះហើយអ្នកទាំងពីរមិនទាន់បញ្ជាក់ពីទំនាក់ ទំនងរបស់ពួកគេនៅឡើយទេ ។
« ព្រះយេស៊ូវត្រូវបានគេ រកឃើញថាសក្តិសមជាងលោកម៉ូសេ ទៅទៀត » ( ៣:៣) ។
‹ ហើយទ្រង់នឹង សោយរាជ្យលើ វង្សយ៉ាកុបជារៀងរហូត ហើយនគររបស់ទ្រង់នឹងគ្មាន ទី បញ្ចប់ឡើយ › ។
ហើយព្រះ នឹងទទួលស្គាល់ ភាព ស្មោះត្រង់របស់ខ្ញុំ ។
« ហើយហេតុអ្វីបានជាបានប្រទានដល់ខ្ញុំថា មាតានៃព្រះ អម្ចាស់របស់ខ្ញុំគួរមក ឯខ្ញុំ ? » ។
មាន ពរហើយអ្នក ណាដែល កាន់តាមពាក្យទំនាយក្នុងសៀវភៅនេះ ...
ហៅកន្លែងនេះថា ជាផ្ទាំងថ្មទទេ ។
ខ្ញុំ មិន ស្តាប់ ឪពុក ម្តាយ របស់ ខ្ញុំ ទេ ។
គ្មានអ្នក ណានៅ ទីនោះ កាន់ដៃអ្នកទេ ។
អ្វី ដែល អ្នក ត្រូវ ដឹង អំពី អាកាសយានដ្ឋាន ទាំង បី របស់ តំបន់ វ៉ាស៊ីនតោន ។
ការបោះបង់ ចោល ឬ ការស្លាប់ របស់ មនុស្ស ជា ទីស្រឡាញ់ ។
« ម្យ៉ាងវិញទៀត នគរស្ថាន សួគ៌ប្រៀបដូចជាអ្នក លក់ រកគុជខ្យង ។
តើ មាន អ្វី ថ្មី នៅក្នុង កំណែនេះ៖ កំណែ ដែល បាន ណែនាំ ។
« មាន ពរហើយអ្នកដែលមាន ចិត្តបរិសុទ្ធ ដ្បិតគេនឹងឃើញព្រះ»(ម៉ាថ .
កុំ ដេញ តាម មនុស្ស ផ្សេង ទៀត ។
យើងចង់និយាយថា កុំយកវាចេញពីប៉ា ឯង ។
សុំ ព្រះបិតា ក្នុង នាម ខ្ញុំ ព្រះអង្គ នឹង ប្រទាន ឱ្យ អ្នក ។
ភាពតានតឹង នៃ ការ នៅពេទ្យ សត្វ ។
ខ្ញុំ កំពុង ព្យាយាម ឆ្លង ឆ្នាំ ដំបូង ។
ខ្ញុំ គិត ថា យើង ទាំងអស់ គ្នា ចង់បាន វា ។
ប៉ុន្តែ ព្រះជាម្ចាស់ បាន ប្រោស ទ្រង់ ឱ្យ រស់ ឡើងវិញ នៅ ថ្ងៃទី បី ហើយ បង្ហាញ ទ្រង់ ដោយ ចំហ មិន មែន ដល់ មនុស្ស ទាំងអស់ នោះ ទេ គឺ ដល់ សាក្សី ដែល ព្រះបាន រើស ដោយ ដៃ ពីមុន មក សូម្បីតែ ចំពោះ ពួកយើង ដែល បាន បរិភោគ និង ផឹក ជាមួយនឹង ទ្រង់ បន្ទាប់ពី ទ្រង់ បាន រស់ ពី សុគត ឡើងវិញ ។
« អ្នក ណាដែលប្រព្រឹត្តល្មើសនឹងអ្នក រាល់គ្នា អ្នកក៏បំពាននឹងអ្នកនោះដែរ » ។
ដាវីឌមកពីកុលសម្ព័ន្ធយូដា ។
