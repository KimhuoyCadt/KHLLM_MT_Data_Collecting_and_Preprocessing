ព្រះទ្រង់ត្រាស់ហៅយើងឲ្យ តស៊ូក្នុងការ ប្រណាំងជីវិត ។
មានភ្លើងច្រើនដែលមិនអាច ពន្យល់បាន » ។
យើងមាននំបុ័ង តែប្រាំដុំ និងត្រីតូចពីរប៉ុណ្ណោះ » ។
ខ្ញុំ ដឹង ថា អ្វី ដែល ជំរុញ ឱ្យ ពួកគេ ស្វែងរក ចម្លើយ ទាំងនេះ ។
ក្នុងការ អួតដោយជឿជាក់លើខ្លួនឯងនេះ ខ្ញុំមិននិយាយដូចព្រះ អម្ចាស់ទេ ប៉ុន្តែជាមនុស្សល្ងង់ .. .
តាំងពីថ្ងៃនោះមក ពួកគេជាមិត្តនឹងគ្នា ។
សត្វ ស្លាប ទាំងនេះ នៅលើ គែម ព្រៃ រាល់ ពេល ។
ផ្នែក ខាងស្តាំ នៃ សញ្ញា =
យើងចង់ឲ្យវាហូរចេញពីកំពូល » ។
២០ បន្ទាប់មក ក្រុមជំនុំរបស់កូនចៅអ៊ីស្រា ‌ អែលទាំងអស់បានចាកចេញពីវត្តមានរបស់លោកម៉ូសេ ។
វាជាសិទ្ធិរបស់យើង និងការ ទទួលខុសត្រូវរបស់ពួកគេ » ។
វា ហាក់បីដូចជា វា ត្រូវការ ការងារ មួយចំនួន ទៀត ។
ហើយ នៅ ថ្ងៃទី 25 ខែកក្កដា កងកម្លាំង អរិភាព បាន ប្រឈមមុខ ដាក់ គ្នា និង បង្កើត
ខ្ញុំ តែងតែ ឃើញ វា ថា ជា ការស្អប់ ។
អ្នក បានទុក ចិត្តក្នុងរឿងមួយចំនួន ខ្ញុំ នឹងដាក់អ្នកឲ្យទទួលខុសត្រូវលើកិច្ចការ ជាច្រើន ។
ត្រូវ ប្រាកដ ថា លាង វា ទាំងអស់ ជាមួយនឹង ស្រា ព័រទុយហ្គាល់ ។
អ្នក ណាដែលឃើញពន្លឺនៃព្រះអាទិត្យឥឡូវនេះ ទ្រង់នឹងមិនលាក់បាំងពន្លឺនៃសេចក្ដី ពិតពីអ្នក ដទៃដោយទុច្ចរិត និងដោយអយុត្តិធម៌ឡើយ ។
ខ្ញុំមិនគិតថាមាននរណាម្នាក់ចង់ឲ្យរឿងនេះកើតឡើងទៀតទេ » ។
" វាជាការ ពិតដែលនិយាយថាសិល្បៈបានធ្វើឱ្យខ្ញុំបន្ត។
ឥឡូវ នេះ គឺជា ពេលវេលា សម្រាប់ ការព្យាបាល ដើម្បី ក្លាយជា ការពិត សម្រាប់ មនុស្ស ជាច្រើន ។
« បើគ្មានអ្នក បង្រៀនទេ ។
អ្នកបង្កើតសន្តិភាពមានសុភមង្គលហើយ ដ្បិតគេនឹងហៅថាជាកូនរបស់ព្រះ» ។
មិនមានថ្លៃចូលទេ ហើយអ្នកចូលក៏មិនត្រូវដកចេញដែរ ។
ដើម្បី ស្វែងរក ប្រធាន ថ្មី ។
ដូច្នេះទាំងអស់ត្រូវបានដេរឡើងនិងធ្វើយ៉ាងស្អាត ។
ពួកគេ ប្រាកដជា នឹង បត់ ឬ ហ្វ្រាំង ក្នុង មួយ ថ្ងៃ ជាមួយនឹង ខ្យល់ បក់ ខ្លាំង ។
នឹង ចាំ ថា ខ្ញុំ បាន បញ្ឈប់ ខ្ញុំ ។
ដូច្នេះនៅពេលដែលកំណត់ ត្រាបានចេញមក វាជាចំណុចប្រមាថ ។
គ្រប់ ម៉ូឌែល ទាំងអស់ នឹង ដាក់ លក់ ក្នុង ប្រទេស ចិន ចាប់ពី ថ្ងៃទី 16 ខែសីហា ។
ខ្ញុំ មានអារម្មណ៍ ល្អ ព្រោះ ខ្ញុំ មាន គម្រោង ។
នៅក្នុង ពាក្យ ផ្សេង ទៀត វា អាច ត្រូវបាន គេ មើលឃើញ ថា តំបន់ មូលដ្ឋាន ត្រូវបាន គ្រប់គ្រង ដោយ សមាមាត្រ នៃ តំបន់ នៃ បេតុង ទៅ
ការសម្រេចចិត្ត ស៊ើបអង្កេត សំណុំរឿង ០០៣ និង ០០៤ បានជាប់គាំង នៅក្នុង ភាពចម្រូងចម្រាស តាំងពី ដើម ដំបូង មក ។
« ចិត្តរបស់កូនមនុស្សពោរពេញទៅដោយអំពើអាក្រក់ ហើយ ចិត្តឆ្កួតក៏នៅក្នុង ចិត្តពេញមួយជីវិត ។
ដូច្នេះតើអ្នក ធ្វើបែបនេះដោយរបៀបណា ?
ពេល ទៅ លេង ខែមករា ឆ្នាំ មុន ខ្ញុំ បាន សម្រេចចិត្ត ផ្លាស់ មក ទីនេះ ។
អ្នក ណាដែលជឿលើអ្នក នោះ អ្នកនោះបានរាប់ជាសុចរិតរួចពី បាបទាំងអស់ ។
ត្រូវបាន ផ្សព្វផ្សាយ ពេញ ប្រទេស រួចហើយ ។
ក្នុងការ ការពារជន ជាតិអ៊ីស្រាអែល ស្វែង រកសេចក្ដី មេត្តា ក រុណាពីព្រះ ដ៏ វិសុទ្ធ សូមប្រទាន ពរដល់ទ្រង់ ។
តើអ្នកបានកត់សម្គាល់ថាខ្ញុំបានបិទវាទេ ?
វាក៏ស្រទន់ដែរ ។
បន្ទាប់ពីឆ្លាក់ឆ្អឹងឬដុំគុជខ្យងរួចហើយនោះត្រូវបានគេដាក់ ជាកន្លែងយ៉ាង ខ្ជាប់ខ្ជួន ។
កូនប្រុស របស់ នាង មិន បាន ទៅ សាលារៀន ទេ ។
ជីវិត ត្រូវបាន សង្គ្រោះ ទំនាក់ទំនង ត្រូវបាន ព្យាបាល ហើយ ទេវតា ត្រូវបាន កម្សាន្ត ។
នៅតែ មិន សប្បាយ ចិត្ត នឹង ការងារ សិល្បៈ ។
បង្រៀនខ្លួនឯងឱ្យដឹងអំពីរឿងនេះ -- ឱ្យប្រាកដអំពី វា ។
« ហើយពេលពួកគេទៅ មាន អារម្មណ៍ ថាគេមិនត្រូវបានអនុញ្ញាតឱ្យផ្តល់ ចម្លើយទេ យើងហៀប នឹងកោះហៅពួកគេ ។
បន្ទាប់ពីបានធ្វើរួច ពួកគេនឹងបានលើសពីប្រយោជន៍របស់ខ្លួន ។
វា មិន ត្រូវបាន រកឃើញ នៅក្នុង ប្រទេស ឥណ្ឌា នៅលើ កុំព្យូទ័រ ទេ ។
ពួកគេ គឺ ដូចជា គ្រួសារ សម្រាប់ អ្នក ។
« ចាប់គាត់ទុកជាអ្នក ទោសសង្គ្រាម » ។
សំណួរ បន្ទាប់ពី អ្នក បាន បញ្ចប់ ការសិក្សា ពី សាកលវិទ្យាល័យ កាលីហ្វ័រញ៉ា តើ អ្នក បាន ធ្វើ ការងារ អ្វី ?
ចៅក្រមបានយល់ព្រមជួបអ្នកនៅយប់នេះ ។
ប៉ុន្តែបើក្រឡេកមើលពួកគេដោយផ្អែកលើអ្វីដែលពួកគេមាននោះ ពួកគេឈរលើគុណសម្បត្តិរបស់ពួកគេផ្ទាល់ ។
ដៃ របស់ ព្យាការី និង ស្បៃ បាំង ពីលើ ក្បាល របស់ ព្រះ
ពួកគេ កំពុង និយាយ អំពី យើង ។
" វាមាន ន័យច្រើនចំពោះសហគមន៍នៅពេលដែលអ្នកទិញទំនិញក្នុងស្រុក " ។
ដូច្នេះហើយបានជាពួកគេស្បថថាជាភក្ដី ភាព
គាត់ មិន ស្គាល់ ពាក្យស្លោក ទេ កិត្តិយស របស់ អ្នក ។
បន្ទាប់មក យើង នឹង បង្កើត សេវាកម្ម ថ្មី មួយ ។
ដើម្បីកុំឱ្យពួកគេព្រិចភ្នែក ហើយនិយាយរឿងរបស់ខ្លួនឯង » ។
នាងបានបន្ថែមថា៖ « ខ្ញុំមិនអាចជឿបានទេ។
តើយើងដឹងអ្វីខ្លះអំពីអ្វីដែលកំពុងកើតឡើង ជាពិសេសនៅក្នុងការ អភិវឌ្ឍឧស្ម័នថ្ម ដាលថ្មី ?
“ ខ្ញុំពិតជាចូលចិត្តអ្នកគ្រប់គ្រងណាស់ ខ្ញុំគិតថាគាត់ធ្វើបានល្អក្នុង រយៈពេលបី ឬបួនឆ្នាំដែលគាត់នៅទីនោះ ។
ប្រភេទទាំងនេះមិនមាន ផលចំណេញអ្វីដល់អ្នកដែល កាន់ កាប់ជាមួយពួកគេឡើយ ។
ប្រាប់ខ្ញុំមួយម៉ាត់មក តើខ្ញុំត្រូវទៅជាយ៉ាង ណាបន្ទាប់ពីស្លាប់ ?
ដោយ ផ្ទាល់ ទៅកាត មេម៉ូរី ។
ហើយនឹងមិនក្លាយទៅជាការ រារាំងក្នុងការ ប្រព្រឹត្តឧក្រិដ្ឋកម្មឡើយ ។
ខ្ញុំ បាន ប្រាប់ គាត់ ពីរ ខែ ។
