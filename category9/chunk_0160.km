ឧបទ្ទហេតុ នេះ បាន កើតឡើង តាំងពី ថ្ងៃទី ០១ ខែធ្នូ រហូតមកដល់ ពេលនេះ ។
ពេល មនុស្ស ពាល ឈ្លោះប្រកែកគ្នា កុំ ជ្រៀត ជ្រែក ចូលក្នុង រឿង របស់ គេ ឱ្យ សោះ ។
រយៈពេល ៤ទៅ ៥ឆ្នាំ ខាងមុខ ទៀត យើង នឹង ឃើញ មាន អគារ ជាច្រើន ផុស ឡើង ដែល ចូលរួមចំណែក ដោយ និស្សិត ជំនាន់ ក្រោយ ៕
ឬ ខុស លឿន ពេក ទេ ព្រោះថា បើ មើល ត្រឹមតែ ភ្នែក ក៏ មិន អាច សន្និដ្ឋាន បាន
សូម លោក អ្នក បញ្ជូន សារបួងសួង ភ្លាម ស៊យ ៗ
មេទ័ព ជើងគោក ថៃ ថ្កោល ទោស ក្រុម បះបោរ ដែល វាយប្រហារ ខេត្ត ភាគ ខាងត្បូង
អង្កាញ់ ស្វាយលើ ស្វាយលើ សៀមរាប
ពេលណា កាត ជំនួស មកដល់ ស៊ី អាយ អិមប៊ី ខេ
ជាក់ស្តែង គេ បាន ស្គាល់ មក ហើយ ថា បង ស្រី បង្កើត របស់ ទូច ស្រី លក្ខណ៍ គឺជា អ្នកនាង ទូច ស្រី នាង ដែល ជា តារា សម្តែង ដ៏ មាន ប្រជាប្រិយភាព មួយ រូប កាលពី ប្រមាណ ជាង ១០ឆ្នាំ មុន ។
បើ ខ្ញុំ យំ អ្នកណា ជូត ទឹកភ្នែក - នីរតនា
ជាពិសេស កុំ សួរ អោយ សោះ ប្រយ័ត្ន ងាប់ ។
អង្គការ មួយ សហការ ជាមួយ ក្រសួង អប់រំ ជួយ ជំរុញ ការអាន ថ្នាក់ ដំបូង
មិន ចូលចិត្ត ទទួលទាន របស់ ត្រជាក់ មែន តែ ?
លោក ច្រឹង គី កំពុង ស្ថិត នៅក្នុង ចម្ការ ពោត និង ដំឡូង មី ។
ប្រសិនបើ អ្នក ដឹងខ្លួន ឯង ថា ពិតជា ផ្លូវភេទ ចុះខ្សោយ មែន វា ច្រើន តែ កែសម្រួល វិញ ដោយ ខ្លួន ឯង ជា មិន ខាន ទេ ។
សូម បញ្ជាក់ ថា នេះ ជា កីឡាករ បរទេស ចុងក្រោយ របស់ ក្រុម ស្វាយរៀង ហើយ ។
អូស្ត្រាលី អំពាវនាវ ឱ្យ ថៃ ដោះលែង ជនភៀសខ្លួន មួយ រូប ដែល បាន កើត នៅ ប្រទេស បារ៉ែ ន
អាយុ ទើបតែ ១៤ ឆ្នាំ សោះ ចាន់ សុបញ្ញា ច្រៀង បាន ពិរោះ ណាស់
អ្នក ជា មនុស្ស ចម្លែក មិន ខ្វល់ ពី សង្គម និង ខ្សែភ្នែក របស់ អ្នកដទៃ ។
សូមស្វាគម ន៏ សង្ឃឹម ថា កុំ គ្រាន់តែ និយាយ អោយ អស់ ទឹក មាត់ ហើយ ការពិត មិន ហ៊ាន វើយ អាវ៉ា ។
ស្ពាន សេកុង ជា ការទាក់ទាញ និង បម្រើ ជា ការដឹង ជញ្ជូន
មាន រដ្ឋធម្មនុញ្ញ អាយុ ១៥១ ឆ្នាំ ។
គេ ធ្វើ បែប នេះ ជារៀងរាល់ ថ្ងៃ ហើយ ទទួលបាន ប្រាក់ យ៉ាង ច្រើន ។
ដូច គេ វី ដើរ វក់ វីច្រើន សាច្រើន ត្រឡប់ ។
ប៉ុន្តែ ទោះបីជា យ៉ាងណា ក៏ដោយ ពេល ឈ្លោះគ្នា សូម កុំ ប្រើ ហឹង្សា ដាក់ នារី ជាទី ស្រលាញ់ របស់ អ្នក ឱ្យ សោះ ។
អ្នក អាច ទទួលទាន ១ស្លាបព្រា បាយ នៅ រៀងរាល់ ២ទៅ៣ ម៉ោងម្តង ។
ទៀត មិន មែន លើក យកមក និយាយ នៅ ថ្ងៃអង្គារ ស្អែក នេះ ទេ ។
បង្ហោះ រូបថត ពី ជីវិត រស់ នៅ ប្រចាំ ថ្ងៃ របស់ ពួកគេ ហើយ ទោះបីជា អ្នកគាំទ្រ ចូលចិត្ត មើល ព័ត៌មាន ថ្មី ៗ
រថយន្ត ទំនើប ៥គ្រឿង សម្រាប់ លក់
ព្រះជាម្ចាស់ មាន ព្រះជន្ម គង់ នៅ សព្វ ថ្ងៃ ហេព្រើរ ៣១២ ហើយ ដោយសារ ព្រះបន្ទូល ជា ខ្យល់ ដង្ហើម របស់ ព្រះជា ម្ចាស់ ២ធិម៉ូថេ ៣១៦ នោះ មាន ន័យ ថា ព្រះបន្ទូល ក៏ មាន លក្ខណ មាន ជីវិត គង់ នៅ ដូច នឹង ព្រះជា ម្ចាស់ ដែរ ។
វា គ្មិន ដំណាក់កាល ១៨អ៊ីញ ។
គេ ថែមទាំង ប្រកាស កាត់បន្ថយ ម៉ោង ធ្វើការ និង ភាគលាភ នៃ បុគ្គលិក គ្រប់ ថ្នាក់ របស់ ខ្លួន ទៀត ។
ទំនុកចិត្ត របស់ ក្មេង ៗ
តើ ឧសថ៣តោន នេះ មាន តម្លៃ ប៉ុន្មាន ?
ប្រភព ដដែល បាន បន្ថែម ថា ក្រៅពី តម្លៃ ខ្លួន យល់ព្រម នេះ អាច មាន លក្ខខ័ណ្ឌ បន្ថែម ផ្សេង ៗ
បើ តាម ការអោយ ដឹង ពី អ្នក រស់ នៅក្បែរ ព្រះវិហារ បាន ប្រាប់ ខ្ញុំ ថា ៖
សមយុទ្ធ ទ័ព ជើងទឹក នេះ មាន រយៈពេល ៦ ថ្ងៃ ហើយ ស្ថិត នៅក្រោម ការឃ្លាំមើល ពី យន្តហោះ អាមេរិក ។
សេចក្តិថ្លែង ការរួមស្តី អំពី ទំនាក់ទំនង ដៃគូ យុទ្ធសាស្ត្រ រវាង ប្រទេស ទាំង ពីរ ដែល
នឹង ហ៊ាន ចាត់ការ ពួកម៉ាក ឫដក តំណែង លោក គុណ ញឹម នោះ ទេ ។
មើល ពី ទីវត្ត ទៅ ខ្លោងទ្វារ ចូល ខាងលិច វិញ
បន្ថយ ស្នាម ខ្នៅ ៖
ហើយ អ្នក រាយការណ៍ ឱ្យ ក្រុម ជនល្មើស អាច ជា មនុស្ស ក្នុង ចំណោម សមត្ថកិច្ច ដែល ចុះបង្ក្រាប បទល្មើស ផងដែរ ។
ថៃ និយាយ ថា ការវាយប្រហារ នៅ ទី សក្ការ បូជា មិន ទាក់ទង នឹង ភេរវកម្ម បរទេស ទេ
ប្រចណ្ឌ ព្រោះ ស្នេហ៍ បែរ ខឹង នួន ល្អង បែរ ខឹង នួន ល្អង
ចំណែក ការចាប់ បាន សំរាម ថង់ ប្លាស្ទិក ចំនួន ៨៣ កុងតឺ
អ្នកនាង អម្ពរ ទេវី បាន ថត ភាពយន្ត ខ្នាត ធំ មួយ រឿង ឱ្យ អ្នកស្រី ពាន់ ភួង បុប្ផា កាលពី ពេល កន្លងទៅ ។
វី អេរ៉ា បាន បន្ថែម ថា ខ្ញុំ ពិតជា មិន ដឹង ថា អនាគត នឹង ទៅជា យ៉ាងណា នោះ ទេ ប៉ុន្តែ ធ្វើ ការងារ នេះ គឺ ដូចជា កីឡាករ ដែរ ។
នឹង កើតឡើង នៅ បណ្តា ឆ្នាំ ខាងមុខ ។
ច្រើន ណាស់ ស្នើរ ខ្លួន មក ឱ្យ ខ្ញុំ ពិចារណា ។
ជា ប្រព័ន្ធ យ៉ាងម៉េច ?
ធម្មំ សរណំ គច្ឆា មិ ។
បែប នេះ ប៉ុន្តែ ពិសី មិន ធ្លាប់ លេច ឮ រឿង ពាក់ព័ន្ធ ស្នេហា ទេ ។
ប៉ុន្តែ មិន ត្រឹមតែ នៅក្នុង បរិវេណ នៃ ឡេរ៉ាបង្កើត កងទ័ព លើស ពី នេះ ទៀត ។
លោក ឈូក បណ្ឌិត ពិតជា បាន បាញ់ កម្ម ការិនី ទាំង បី នាក់ នេះ ដោយ អចេតនា មែន ។
ការងារ ប្រព្រឹត្តទៅ ជា ធម្មតា គួរ ប្រឹងប្រែង ជាង នេះ ទៀត ដើម្បី ឈាន ទៅ ជោគជ័យ ខ្លាំង ។
ក្រុង តាខ្មៅ គម្រោង
លោក រិទ្ធី បាន និយាយ ថា កម្មករ បាន ទាមទារ ឱ្យ ម្ចាស់ ក្រុមហ៊ុន ទទួលខុសត្រូវ ចំពោះ ការខូចខាត ទ្រព្យ របស់ កម្មករ ពីព្រោះ សន្តិសុខ មក ពី ក្រុមហ៊ុន នេះ បាន បំផ្លាញ ទ្រព្យ ទាំងនោះ ក្នុង ពេល វាយប្រហារ កាលពី ម្សិលមិញ ។
លោកស្រី អះអាង ថា លោកស្រី នឹង ជជែកគ្នា ជាមួយ ប្រជាពលរដ្ឋ ផ្សេង ទៀត អំពី គម្រោង ឡើង ទៅ ចូលរួម តាមដាន សវនាការ ក្តី នេះ ។
នៅ កម្ពុជា ការបោះឆ្នោត តំណាងរាស្ត្រ គឺជា ការបោះឆ្នោត តាម ប្រព័ន្ធ សមាមាត្រ ។
នៅ ថ្ងៃទី ៥ ខែឧសភា ឆ្នាំ ២០២០ នេះ ក្រសួង សុខាភិបាល បាន ប្រកាស ថា មិន មាន ករណី ឆ្លង កូវីដ១៩ ថ្មី ហើយក៏ មិន មាន ករណី ជាសះស្បើយ បន្ថែម ទៀត ដែរ ។
ឥឡូវ ៤ខែ ហើយ ខ្ញុំ មិន ត្រូវបាន ហៅ បន្តិច សោះ ។
នៅ មិន ទាន់ មាន ការបញ្ជាក់ ពី ពេលវេលា ច្បាស់លាស់ ទេ ប៉ុន្តែ បញ្ហា នេះ កំពុង ត្រូវបាន ពិចារណា ។
ការហាត់ប្រាណ អាច ជួយ កាត់បន្ថយ ស្ត្រេស បាន
ដូចជា មិន ទាន់ បាន បង្ហាញ សញ្ញាណ វិជ្ជមាន ណាមួយ ត្រេកអរ នឹង ការលើកឡើង ឬ យ៉ាង ទេ ។
នេះ ជា ស្ថានភាព នៃ ជំងឺ ផ្លូវចិត្ត រ៉ាំរ៉ៃ ដែល ធ្វើអោយ កុមារ បាត់បង់ នូវ អារម្មណ៍ នៃ ភាព ពិតជាក់ស្តែង ។
បាត់ខ្លួន ព្រោះ ល្បឿន នៃ ការទិញ របស់ យើង នៅ មាន កម្រិត ទាប នៅ ទ្បើយ ។
បុរស ៣នាក់ ជិះ ម៉ូតូ ឌុប គ្នា ដោយ ល្បឿន លឿន បាន បើក វ៉ាយានយន្ត ផ្សេង ៗ
ប្រការ ដែល ពលរដ្ឋ ម្នាក់ ៗ
វា បាន បង្កើត មុខងារ ថ្មី ៗ
អ៊ីចឹង ប្រហែលជា ថ្ងៃ ហ្នឹង ឬ ថ្ងៃស្អែក ប្រហែលជា បើក ជូន គាត់ ហើយ ៗ
នាង ផាត់ បាន នាំ កូនប្រុស អាយុ ៦ខែ របស់ នាង មក តុលាការ កាលពី ថ្ងៃចន្ទ ហើយ គ្រួសារ នេះ មាន ឱកាស ជួបគ្នា នៅ ទីនោះ ។
ក្រៅពី សំណង់ ដ៏ ទាក់ទាញ នៅ ទីនេះ អ្នក អាច ទិញ ឥវ៉ាន់ ប្រេន ៗ
២៧ដ្បិត ព្រះយេហូវ៉ា ទ្រង់ មាន ព្រះបន្ទូល ដូច្នេះ ថា ស្រុក ទាំងមូល នឹង ត្រូវ ខូច បង់ ប៉ុន្តែ អញ មិន បំផ្លាញ អស់ រលីង ទេ ២៨ ដោយ ហេតុការ ទាំង នេះ ផែនដី នឹង យំសោក ហើយ មេឃ ខាងលើ នឹង ទៅជា ខ្មៅ ពីព្រោះ អញ បាន ចេញ វា ចាអញ បាន គិត សំរេច ការ នេះ ហើយ អញ នឹង មិន ប្រែចិត្ត ឬ បែរ ចេញ ពី ការ នេះ ឡើយ
ពិត ណាស់ ទេព បូព្រឹក្ស រៀបចំ ខ្លួន ស្លៀកពាក់ ស៊ិចស៊ី ខ្លាំង ជាង មុន ដែល ធ្វើឱ្យ ទស្សនិកជន ស្ទើរតែ ទប់ អារម្មណ៍ មិន ជាប់
ក៏ ដូចជា រឿង ហូលីវូដ បែប បាញ់ប្រហារ ដ៏ទៃ ទៀត ដែរ ។
ដំណោះស្រាយ ចំពោះ មិត្ត រួម អាជីព មិន ចុះ សំរុង នឹង អ្នក វឌ្ឍនៈ ខ្មែរ
មុខ ទំនិញ ទាំងនេះ គឺ នៅក្នុង វិស័យ កាត់ដេរ ផលិតផល ធ្វើដំណើរ និង ស្ករ ។
មនោសញ្ចេតនា គួរ មាន ការចែករំលែក ក្នុង មនោសញ្ចេតនា ។
