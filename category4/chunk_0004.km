ខ្ញុំចង់ដូរសំបុត្រទៅថ្នាក់លេខមួយ ។
ខ្ញុំចង់កក់សម្រាប់មនុស្សបីនាក់នៅម៉ោងប្រាំពីរ ។
តើអ្នកអាចរៀបចំគ្រែក្នុងឡានរបស់ខ្ញុំបានទេ ?
ខ្ញុំចង់ទៅគ្រីនអាយឡេន ។
តើទូកបន្ទាប់ដែលទៅថ្រេសឺអាយឡេនចេញនៅម៉ោងប៉ុន្មានដែរ ?
វាចេញនៅម៉ោងដប់មួយ ។
តើអ្នកមានទូកដំណើរកំសាន្តប្រភេទណា ?
តើបន្ទប់នៅលើទូករបស់អ្នកដូចម្តេចដែរ ?
តើសាឡាងនេះទៅអាល់កាត្រាសឬ ?
តើអ្នកមានដំណើរតាមទឹកប៉ុន្មានដងក្នុងមួយថ្ងៃ ?
សំបុត្រដំណើរកំសាន្តបីតាមដងទន្លេឃ្វីនរីវវើ ។
តើសាឡាងនេះទៅណា ?
តើខ្ញុំគួរជិះសាឡាងមួយណា ?
តើបន្ទប់របស់ខ្ញុំនៅកន្លែងណា ?
តើអ្នកមានរៀបចំកម្មវិធីអ្វីទេល្ងាចនេះ ?
តើទៅដល់ម៉ោងប៉ុន្មាន ?
ខ្ញុំកក់រថយន្តសម្រាប់ពីរថ្ងៃនៅជប៉ុន ។
សូមសំបុត្ររបស់អ្នក ។
សូមបង្ហាញលិខិតឆ្លងដែន និងប័ណ្ណបើកបរអន្តរជាតិរបស់អ្នក ។
អ្នកមិនអាចជួលវាដោយមិនមានកាតឥណទានបានទេ ។
តើអ្នកអាចបង្ហាញខ្ញុំតារាងអត្រាបានទេ ?
តើវាថ្លៃប៉ុន្មានក្នុងមួយថ្ងៃ ?
តម្លៃមិនរួមបញ្ចូលថ្លៃហ្គាសទេ ។
ខ្ញុំត្រូវការការធានារ៉ាប់រង ។
តើចង្ងាយផ្លូវមិនមានកំណត់ទេមែនទេ ?
តើខ្ញុំអាចទុកឡាននៅអាកាសយានដ្ឋានបានទេ ?
តើខ្ញុំអាចបើកវាមុនពេលជួលវាបានទេ ?
ខ្ញុំត្រូវការកៅអីសម្រាប់កុមារ ។
តើខ្ញុំត្រូវទូរស័ព្ទទៅលេខប៉ុន្មានក្នុងករណីបន្ទាន់ ?
តើអ្នកអាចប្រាប់ផ្លូវទៅសារមន្ទីរ ម៉ារីថាមបានទេ ?
តើផ្លូវនេះទៅនីអាហ្គារ៉ាហ្វលមែនទេ ?
តើពីនេះទៅកាមែលមានចំងាយប៉ុន្មានម៉ាយ ?
តើចំណាយរយៈពេលប៉ុន្មានទៅផ្លូវលេខប្រាំ ?
តើនេះជាផ្លូវឯកទិសឬ ?
តើអ្នកអាចប្រាប់ខ្ញុំបានទេថាខ្ញុំកំពុងនៅទីណាបើមើលក្នុងផែនទី ?
តើមានកន្លែងសំរាប់ចតទេនៅក្បែរនេះ ?
តើខ្ញុំអាចចតឡាននៅលើផ្លូវបានទេ ?
ខ្ញុំចង់ទូរស័ព្ទទៅនគរបាល ។
សូមចាក់សាំងធម្មតា ។
ខ្ញុំបែកកង់ ។ តើអ្នកអាចដូរកង់បានទេ ?
តើអ្នកអាចបង្ហាញខ្ញុំរបៀបដំណើរការបំពង់នេះបានទេ ?
តើអ្នកអាចសាកថ្មបានទេ ?
ខ្ញុំចង់ទៅទីក្រុងប៊ូស្តុង ។
នៅថ្ងៃទីប្រាំមួយ ខែកក្កដា ។ វាជាថ្ងៃអង្គារ៍អាទិត្យក្រោយ ។
ខ្ញុំចង់កក់ជើងហោះហើរណសវេសអ៊ែរឡាញលេខសូន្យប្រាំបីប្រាំមួយ សម្រាប់ថ្ងៃទីប្រាំ
តើអ្នកមានកន្លែងទំនេរសំរាប់ទៅដឺត្រយនៅថ្ងៃពុធទេ ?
តើអ្នកអាចរៀបចំជើងហោះហើរមួយទៀតបានទេ ?
តើអ្នកមានជើងហោះហើរត្រង់ទៅទុកសុនដែរទេ ?
ខ្ញុំសុំទោស ប៉ុន្តែអ្នកត្រូវដូរជើងហោះហើរនៅឡសអាន់ចឺឡេស ។
តើអ្នកមានជើងហោះហើរដែលទៅដល់មីអាមីត្រឹមថ្ងៃត្រង់ស្អែកទេ ?
តើអ្នកអាចដូរជើងហោះហើរខ្ញុំទៅថ្ងៃទីដប់បានទេ ?
មួយណាល្អជាង ជើងហោះហើរពេលព្រឹកឬក៏ពេលថ្ងៃរសៀល ?
តើជើងហោះហើរពេលព្រឹកចេញដំនើរនៅម៉ោងប៉ុន្មាន ?
តើមានជើងហោះហើរមួយជើង ឬទៅមក ?
តើចេញដំនើរនៅម៉ោងប៉ុន្មាន ?
ខ្ញុំឈ្មោះមីគីអូដាហើយជើងហោះហើរគឺចាល់លេខសូន្យមួយពីរឆ្ពោះទៅវ៉ានខូវើ ។
សុំកាលបរិច្ឆេទចេញដំនើរ ?
ថ្ងៃទីដប់ពីរខែមេសា ។
ខ្ញុំសុំទោស ខ្ញុំរកឈ្មោះអ្នកមិនឃើញទេ ។
តើអ្នកអាចពិនិត្យម្តងទៀតបានទេ ? តើខ្ញុំអាចកក់ជាថ្មីបានទេ ?
តើតុចុះឈ្មោះចូលសម្រាប់យូណាយធីតអ៊ែរឡាញនៅឯណា ?
សុំលិខិតឆ្លងដែន និងសំបុត្ររបស់អ្នក ។
តើមានកៅអីសម្រាប់អ្នកជក់បារីទេ ?
យើងមិនមានកៅអីសម្រាប់អ្នកជក់បារីទេ ។
តើខ្ញុំអាចយកកាបូបនេះឡើងយន្តហោះបានទេ ?
ខ្ញុំចង់ផ្ញើរកាបូបពីរ ។
ខ្ញុំចង់ផ្ញើរវាទៅដល់ទិសដៅចុងក្រោយតែម្តង ។
តើអ្នកអាចកាន់វាឲ្យប្រយ័ត្នបានទេ ? វាអាចបែក ។
វាលើសទំងន់ប្រាំគីឡូក្រាម ។ អ្នកត្រូវបង់ថ្លៃលើស ។
ខ្ញុំចង់បានកៅអីជាប់ផ្លូវដើរ ?
នេះជាផ្លាកសំគាល់ឥវ៉ាន់របស់អ្នក ។
តើយន្តហោះហោះឡើងនៅម៉ោងប៉ុន្មានដែរ ?
យន្តហោះនឹងចាកចេញតាមពេលកំនត់ ។
តើយន្តហោះនឹងទៅដល់ហុសស្តុននៅម៉ោងប៉ុន្មាន ?
វាទៅតាមពេលដែលបានគ្រោងទុក ។
តើខ្ញុំអាចនិយាយភាសាជប៉ុនបានទេ ?
នេះជាច្រកសម្រាប់ជើងហោះហើរទៅបុសស្តុនមែនទេ ?
តើច្រកលេខប្រាំនៅឯណា ?
តើអ្នកដំនើរចាប់ផ្តើមចូលក្នុងយន្តហោះនៅម៉ោងប៉ុន្មាន ?
តើអ្នកដំនើរចាប់ផ្តើមចូលក្នុងយន្តហោះហើយឬនៅ ?
តើអ្នកអាចរៀបចំជើងហោះហើរផ្សេងមួយទៀតអោយខ្ញុំបានទេ ?
ពិតមែនឬ ? តម្លៃខុសពីឧបករណ៍រាស់ ។
អ្នកប្រាប់ខ្ញុំថាតម្លៃគឺដប់ដុល្លារនៅអាកាសយានដ្ឋាន ។
ខ្ញុំមិនប្រាកដអំពីវាទេ ។ សូមនិយាយជាមួយអ្នកណាម្នាក់នៅសណ្ឋាគាររបស់ខ្ញុំ
សុំទោស ។ ខ្ញុំគិតថានេះជាកន្លែងរបស់ខ្ញុំ ។
តើខ្ញុំគួរតែទិញសំបុត្រថ្មីទេ ?
តើខ្ញុំគួរទូរស័ព្ទទៅលេខប៉ុន្មានពេលអាសន្ន ?
តើអ្នកអាចទូរស័ព្ទទៅរថយន្តសង្គ្រោះបន្ទាន់បានទេ ?
ខ្ញុំចង់ទូរស័ព្ទទៅអ្នកជួសជុលរថយន្ត ។
មានការកក់លើសចំនួន ។
នេះជាកំហុសរបស់ក្រុមហ៊ុនអាកាសចរណ៍ ។
តើអ្នកអាចរៀបចំជើងហោះហើរផ្សេងទៀតឲ្យខ្ញុំបានទេ ?
ខ្ញុំច្បាស់ថាខ្ញុំបានបញ្ជាក់ជើងហោះហើរនេះរួចហើយ ។
តើអ្នកអាចបង់ថ្លៃសណ្ឋាគារបានទេ ?
ខ្ញុំមកដល់ប្រហែលម៉ោងប្រាំមួយ ។
ខ្ញុំនឹងពិនិត្យនៅយប់នេះ ប៉ុន្តែសូមរក្សាការកក់របស់ខ្ញុំ ។
ខ្ញុំចង់លុបចោលការកក់របស់ខ្ញុំសម្រាប់ថ្ងៃទីម្ភៃខែមេសា ។
តើអ្នកអាចដូរការកក់ខ្ញុំទៅថ្ងៃទីប្រាំខែឧសភាបានទេ ?
តើខ្ញុំអាចមានការណែនាំពីសណ្ឋាគារបានទេ ?
តើមានផ្ទះសំណាក់យុវវ័យនៅជិតនេះទេ ?
តើសណ្ឋាគារប្រភេទណាអ្នកចង់បាន ?
ខ្ញុំចង់បានបន្ទប់គ្រែពីរមានបន្ទប់ទឹក ។
តើសណ្ឋាគារអ្នកមានអាងហែលទឹកទេ ?
តើមានសណ្ឋាគារនៅឆ្នេរសមុទ្រទេ ?
ខ្ញុំចង់ស្នាក់នៅសណ្ឋាគារជិតនេះ ។
តើអ្នកអាចណែនាំសណ្ឋាគារនៅទីប្រជុំជនបានទេ ?
ខ្ញុំចង់បានបន្ទប់ថ្លៃចិតសិបដុល្លារមួយយប់ ។
ខ្ញុំចង់បានបន្ទប់គ្រែពីរមានបន្ទប់ទឹក ។
តើមានសណ្ឋាគារនៅបឹងទេ ?
ខ្ញុំចង់បានសណ្ឋាគារសុវត្ថិភាព និងថោក ម្តុំស្ថានីយ៍ St. Mary
តើអ្នកមានសណ្ឋាគារផ្សេងទេ ?
តើអ្នកមានសណ្ឋាគារថោកជាងនេះទេ ?
តើអ្នកអាចកក់សណ្ឋាគារនេះបានទេ ?
តើខ្ញុំអាចមានផែនទីដែលមានសណ្ឋាគារនៅក្នុងនេះបានទេ ?
តើពេលណាខ្ញុំអាចចុះឈ្មោះចូលបាន ?
តើត្រូវបង់លុយទេ ?
តើបន្ទប់ប្រភេទណាអ្នកចូលចិត្ត ?
យើងមានបន្ទប់គ្រែមួយដប់ គ្រែពីរប្រាំបី និងគ្រែតូចពីរប្រាំបួន ។
តើមានបន្ទប់មានបន្ទប់ទឹកទេ ?
តើយើងអាចប្រើគ្រែថែមទេ ?
តើខ្ញុំអាចប្រើផ្ទះបាយបានទេ ?
វាថ្លៃសម្រាប់ខ្ញុំ ។
តើអ្នកមានបន្ទប់ក្រោមហាសិបដុល្លារមួយយប់ទេ ?
តើមានអត្រាពិសេសសម្រាប់ស្នាក់នៅយូរទេ ?
តើមានអត្រាថោកសម្រាប់ស្នាក់នៅយូរទេ ?
ប្រសិនបើខ្ញុំស្នាក់នៅមួយសប្ដាហ៍ តើអ្នកអាចចុះថ្លៃបានទេ ?
បាទ ។ បន្ទប់ប្រភេទណាអ្នកចង់មើល ?
បន្ទប់នេះតូចពេកសម្រាប់ខ្ញុំ ។
តើអ្នកអាចរកបន្ទប់ធំជាងនេះបានទេ ?
ខ្ញុំត្រូវការទូរទស្សន៍នៅក្នុងបន្ទប់ខ្ញុំ ។
ខ្ញុំនឹងយកបន្ទប់នេះ ។
ខ្ញុំសូមទោស ខ្ញុំនឹងមើលកន្លែងផ្សេង ។
បាទ នេះជាការកក់របស់ខ្ញុំ ។ តើខ្ញុំអាចយកបន្ទប់គ្រែតូចពីរដែលមានទេសភាពល្អបានទេ ?
បាទ យើមានមួយដែលមានទេសភាពសមុទ្រ ។
សូមបំពេញកាតចុះឈ្មោះនេះ ។ ហើយចុះហត្ថលេខាទីនេះ ។
តើខ្ញុំអាចចុះឈ្មោះចូលឥឡូវបានទេ ?
ខ្ញុំយល់ ។ តើអ្នកអាចទុកវ៉ាលីនេះបានទេ ?
ខ្ញុំមានការកក់នៅទីក្រុង Tokyo៕
តើអ្នកប្រើកាតអ្វី ?
តើខ្ញុំអាចទៅបន្ទប់ខ្ញុំឥឡូវបានទេ ?
តើអ្នកអាចយកវ៉ាលីខ្ញុំទៅបន្ទប់ខ្ញុំបានទេ ?
ខ្ញុំនឹងកាន់កាបូបដោយខ្លួនខ្ញុំ ។
នេះមិនមែនជាបន្ទប់ខ្ញុំរើសទេ ។
ខ្ញុំកក់បន្ទប់មានទេសភាពបឹង ។
ខ្ញុំខ្លាចអ្នកធ្វើខុស ។
ប្រសិនបើអ្នកមិនមានបន្ទប់សម្រាប់ខ្ញុំ តើអ្នកអាចរៀបចំសណ្ឋាគារផ្សេងទេ ?
សូមដូរវាទៅបន្ទប់គ្រែតូចពីរ ។
តើអ្នកអាចប្រាប់ខ្ញុំរបៀបប្រើសោរនេះទេ ?
ទ្វារបន្ទប់ខ្ញុំមិនអាចចាក់បាន ។
ខ្ញុំមិនអាចចាក់សោរទ្វារបានទេ ។
តើខ្ញុំអាចបិទកង្ហារខ្យល់ចេញនៅឯណា ?
បន្ទប់ខ្ញុំក្តៅពេក ។
បន្ទប់យើងមានក្លិនបារី ។
មិនមានសាប៊ូនៅបន្ទប់យើង ។
ទូរទស្សន៍បន្ទប់ខ្ញុំមិនដំណើរការ ។
តើអ្នកអាចជួសជុលវាបានទេ ?
មនុស្សនៅជាប់នេះរំខានខ្ញុំពេលដេក ។
តើអ្នកអាចឲ្យបន្ទប់ស្ងាត់ដល់ខ្ញុំទេ ?
ទឹកក្តៅធ្លាយពីអាងទឹក ។
ខ្ញុំកំពុងរង់ចាំអ្នកណាម្នាក់ជួសជុលទូរទស្សន៍របស់យើងក្នុងមួយម៉ោង ។
កាបូបខ្ញុំត្រូវបានគេយកពីបន្ទប់ខ្ញុំ ។
