តើនាឡិកាដៃនេះអាចជួសជុលបានដែរឬទេ ?
តើសំលៀកបំពាក់នេះសម្រាប់ក្មេងស្រីអាយុប្រាំមួយឆ្នាំឬ ?
ស្បែកជើងនេះតូចណាស់មិនអាចពាក់បានទេ ។
តើហាងបើកនៅពេលណា ?
តើនេះរាប់បញ្ចូលទាំងពន្ធឬ ?
សូមអ្នកបញ្ចុះថ្លៃបានទេ ?
ខ្ញុំចង់បានភេសជ្ជៈគ្មានជាតិអាល់កុលមួយកែវ ។
តើអ្នកអាចឆ្លាក់ឈ្មោះរបស់ខ្ញុំនៅលើពែងនេះបានទេ ?
សូមអ្នកបញ្ចុះថ្លៃវាបន្តិចទៀតបានទេ ?
តើអ្នកអាចធ្វើមួយនេះឱ្យរួចរាល់នៅមុនថ្ងៃស្អែកបានទេ ?
សូមអ្នកបង្ហាញខ្ញុំមួយនោះបានទេ ?
តើអ្នកអាចបញ្ចុះថ្លៃបានប៉ុន្មាន ?
តើអ្នកអាចបញ្ចុះបន្តិចទៀតបានទេ ?
តើអ្នកអាចបញ្ចុះថ្លៃបានទេ ?
តើខ្ញុំអាចផ្លែប៉ោមប៉ុន្មានសម្រាប់ប្រាក់ប្រាំដុល្លារ ?
តើមានចំនួនប៉ុន្មាននៅក្នុងប្រអប់ ?
តើហាងនេះបើកនៅថ្ងៃអាទិត្យទេ ?
វាច្រើនខ្លាំងណាស់ ។
តើអ្នកមានមួយដូចគ្នាទេ ?
ខ្ញុំនឹងទិញមួយនោះជំនួសមួយនេះ ។
មួយនេះតឹងណាស់សម្រាប់ខ្ញុំ ។
ខ្ញុំបានទិញវាមុននឹងបន្តិច ។
សូមបង់តម្លៃសរុបដែលបាននិយាយភ្លាមមក ។
សូមឱ្យខ្ញុំទាំងអស់មក ។
សូមឱ្យខ្ញុំពីរសម្រាប់នីមួយៗ ។
មានទំហំបីគឺ ធំ មធ្យម និងតូច ។
វាមិនថោកណាស់ទេ ។
ពួកវាស្ទើរតែបាក់បែក ។
ខ្ញុំបានទិញវាតាមចំនួន ។
ខ្ញុំចំណាយលុយច្រើនពេកហើយ ។
តើអ្នកមានកូនកន្សែងដៃថែមទៀតដែរទេ ?
ខ្ញុំប្រាកដចិត្តណាស់ថាបានទិញរបស់នោះ ។
តើមានហាងលក់ស្រានៅក្បែរនេះដែរទេ ?
តើមួយណាដែលសក្តិសមនឹងខ្ញុំ ?
តើចំណាយពេលយូរប៉ុណ្ណាដើម្បីជួសជុលវា ?
ខ្ញុំចង់បានអាមួយដែលនៅក្បែរនោះ ។
តើក្នុងចំណោមពួកវាមួយណាដែលថោកជាងគេបំផុត ?
ខ្ញុំចូលចិត្តពួកវាទាំងអស់ ។
ខ្ញុំមិនចូលចិត្តមួយណាសោះឡើយ ។
ដៃអាវនេះវែងពេកសម្រាប់រូបខ្ញុំ ។
សូមខ្ចប់វាពីរជាន់ ។
សូមបង្ហាញអាមួយផ្សេងទៀតអោយខ្ញុំមើលផង ។
តើពួកវាមួយៗថ្លៃម្ភៃដុល្លារ មែនដែរទេ ?
តើខ្ញុំសូមមើលរបាយការណ៍ស្តីពីចោរកម្មបានទេ ?
តើអ្នកអាចសរសេរលិខិតបញ្ជាក់អំពីហេតុការណ៍គ្រោះថ្នាក់នោះបានទេ ?
តើខ្ញុំអាចសុំលិខិតបញ្ជាក់អំពីហេតុការណ៍គ្រោះថ្នាក់បានទេ ?
ស្ថានភាពរបស់គាត់កាន់តែអាក្រក់ឡើងហើយ ។
គាត់ស្រវឹងហើយប្រព្រឹត្តអំពើហិង្សា ។
ទឹកហៀរកំពប់ចេញពីអាងងូតទឹក ។
ខ្ញុំឈ្លោះប្រកែកនឹងអ្នកបើកបរអំពីបញ្ហាតម្លៃ ។
ខ្ញុំអន្ទះសារចង់ដឹងពីស្ថានភាពរបស់ប្រពន្ធខ្ញុំ ។
ខ្ញុំឈឺប្រអប់ជើងឆ្វេង ។
ខ្ញុំបានដួលហើយធ្វើអោយកជើងខ្ញុំឈឺ ។
សូមបណ្តេញសត្វឆ្កែទាំងអស់នោះចេញអោយឆ្ងាយទៅ ។
តើអ្នកបំពេញការខាតបង់ទាំងនោះដោយរបៀបណាទៅ ?
ប្រអប់ជើងឆ្វេងខ្ញុំឈឺ ។
បុរសមួយក្រុមមានគ្នាបីនាក់វាយប្រហារខ្ញុំ ។
ខ្ញុំខ្លាចមានគ្រោះថ្នាក់ ។
បុរសពីរនាក់បានគម្រាមកំហែងខ្ញុំដោយប្រើកាំភ្លើង ។
សូមមកតាមខ្ញុំ ។ ក្មេងប្រុសម្នាក់កំពុងតែលង់ទឹក ។
ខ្ញុំចង់ដោះស្រាយវាក្រៅតុលាការ ។
កម្លាំងស្មារតីរបស់ខ្ញុំបានវិលត្រលប់ដូចដើមវិញហើយ ។
សូមយកម៉ាស៊ីនថតមកអោយខ្ញុំវិញផង ។
ខ្ញុំមិនបានពាក់ព័ន្ធនៅក្នុងរឿងនេះទេ ។
ខ្ញុំមិនអាចទ្រាំទ្រនឹងការឈឺចាប់បានទេ ។
កុំយកខ្ញុំមកលេងសើច ។
ខ្ញុំមានជម្ងឺអាសន្នរោគ ។
តើថ្នាំនេះត្រូវនឹងអាការៈក្អកមែនដែរទេ ?
ពួកគេព្រួយបារម្ភអំពីសុវត្ថិភាពរបស់កូនប្រុសពួកគេ ។
ខ្ញុំបានដឹងខ្លួនថាខ្ញុំបានបាត់កាបូបលុយរបស់ខ្ញុំហើយ ។
ខ្ញុំមុតដៃនឹងកាំបិត ។
ជម្ងឺហឺតកំពុងធ្វើទុក្ខខ្ញុំ ។
អ្នកយល់ច្រលំលើអ្វីដែលខ្ញុំបាននិយាយហើយ ។
ខ្ញុំកំពុងលំបាកខ្លាំងនៅក្នុងបញ្ហានេះ ។
គេបានគម្រាមសម្លាប់ខ្ញុំ ។
តើ់អ្នកអាចធ្វើមូលប្បទានប័ត្រសម្រាប់អ្នកដំណើរសារជាថ្មីអោយខ្ញុំបានទេ ?
ខោរបស់ខ្ញុំរហែកហើយ ។
ប៉ូលីសកំពុងស្រែកអោយឈប់ ។
ខ្ញុំត្រូវមូសខាំ ។
ខ្ញុំទៅមិនទាន់រថភ្លើង ។
ជើងរបស់ខ្ញុំលែងមានកម្លាំងធ្វើការហើយ ។
មិត្តម្នាក់របស់ខ្ញុំបានស្លាប់នៅក្នុងគ្រោះថ្នាក់នោះ ។
ឡេនោះបានធ្វើអោយភ្នែកខ្ញុំឡើងផ្សារ ។
សូមកុំរំខានខ្ញុំ ។
តើអ្នកអាចជួសជុលរបស់នេះបានដែរទេ ?
ខ្ញុំព្រួយបារម្ភអំពីសុវត្ថិភាពរបស់គេណាស់ ។
ខ្ញុំរអិលនៅលើផ្លូវមានព្រិលទឹកកកហើយក៏ដួល ។
ខ្ញុំនឹងទាមទារអោយសងនូវការខូចខាត ។
ខ្ញុំបន្ទោសគាត់សម្រាប់ការខ្ជីខ្ជានៅក្នុងការបំពេញភារកិច្ច ។
ខ្ញុំចង់តាមស្វែងរកកូនប្រុសខ្ញុំដែលបាត់ខ្លួនទៅ ។
ខ្ញុំបានលឺមកថាកប៉ាល់ត្រូវបានខ្យល់ព្យុះវាយអោយបែកបាក់ ។
ហេតុការណ៍នេះនឹងធ្វើអោយការធ្វើដំណើររបស់ខ្ញុំខូចអស់ ។
តើចោរប្លន់ត្រូវបានគេចាប់ខ្លួនហើយឬនៅ ?
ប្ដីរបស់ខ្ញុំបានដួលហើយប៉ះត្រូវក្បាល ។
ខ្ញុំបានរួចខ្លួនដោយសារតែអ្នក ។
តើខ្ញុំអាចសួរតម្លៃបានទេ ?
រថភ្លើងបានធ្លាក់ចេញពីគន្លងផ្លូវដែក ។
ខ្ញុំត្រូវបានគេបោកយកលុយអស់ពីខ្លួនរលីង ។
ខ្ញុំចង់ព្យាបាលភ្នែករបស់ខ្ញុំ ។
ខ្ញុំបានតស៊ូទប់ទល់នឹងបុរសនោះយ៉ាងខ្លាំងក្លា ។
សូមកែតំរូវចំណុចខុសផង ។
ចោរលូកហោប៉ៅត្រូវបានចាប់ខ្លួនហើយ ។
កាបូបខ្ញុំបានបាត់ហើយ ។
បុរសនោះបានវាយខ្ញុំចំត្រង់មុខ ។
ខ្ញុំឧស្សាហ៍ឈឺក្រពះញឹកញាប់ណាស់ ។
តើខ្ញុំត្រូវតែទៅមន្ទីរពេទ្យភ្លាមឬ ?
មានមនុស្សកំពុងតែលបអើតមើលនៅត្រង់បង្អួច ។
ក្រុមហ៊ុនអ្នកគួរតែសងជម្ងឺចិត្តដល់ខ្ញុំសម្រាប់ការបាត់បង់របស់ខ្ញុំ ។
ហាមស្តោះទឹកមាត់ ។
ខ្ញុំបានលឺសំលេងផ្ទុះអ្វីម៉្យាង ។
កាបូបគាត់ទាក់ជាប់នៅនឹងទ្វារជណ្តើរយន្ត ។
ខ្ញុំគាបជាប់ម្រាមដៃនៅនឹងទ្វារឡាន ។
ស្មាររបស់ខ្ញុំបានភ្លាត់ខុសសន្លាក់
ឡានបានជាប់នៅក្នុងភក់ ។
បំពង់ទុយោទឹកបានបែកធ្លាយ ។
ទន្លេបានជន់ទឹកហៀរហូរ ។
ពេលខ្ញុំដួលខ្ញុំបានក្រឡាច់កជើង ។
ខ្ញុំចង់ស្អំកំទេចទឹកកកត្រង់កន្លែងរបួស ។
ផ្លូវត្រូវបានបិទស្ទះដោយដុំថ្មដែលបានធ្លាក់ ។
ខ្ញុំបានបើកឡានបុកបង្កាន់ដៃផ្លូវ ។
ខ្ញុំមានការពាក់ព័ន្ធនៅក្នុងការវាយតប់គ្នា ។
ខ្ញុំស្ពឹកកម្រើកមិនបាននៅដៃខាងស្តាំ ។
សូមទូរស័ព្ទមកខ្ញុំប្រសិនបើអ្នករកឃើញកាបូបខ្ញុំ ។
អាវរបស់ខ្ញុំរហែកដោយសារដែកគោល ។
ថ្នាំពេទ្យបានធ្វើអោយការឈឺចាប់ខ្ញុំស្រាកស្រាន្ត ។
ស្ថានភាពមិនអនុញ្ញាតអោយមានការអូសបន្លាយទេ ។
ខ្ញុំពិតជាស្ថិតក្នុងស្ថានភាពមិនល្អមែន ។
ខ្ញុំមិនដឹងថាត្រូវសូមអភ័យទោសយ៉ាងម៉េចទេ ។
ម្រាមដៃរបស់ខ្ញុំនៅឈឺចាប់នៅឡើយ ។
សូមមកកាន់មន្ទីរពេទ្យមួយសប្ដាហ៍ម្តងក្នុងរយៈពេលមួយខែ ។
ភ្នែករបស់ខ្ញុំមានអារម្មណ៍ថារមាស់ ។
ខ្ញុំមានអារម្មណ៍ថាមានការឈឺចាប់ពើតខ្មួល ។
ក្រពះរបស់ខ្ញុំនៅសុខៗស្រាប់តែចាប់ផ្តើមឈឺភ្លាមៗតែម្តង ។
ខ្ញុំមានអារម្មណ៍ថាមានការឈឺចាប់ឆៀបៗ ។
ខ្ញុំមានអារម្មណ៍ឈឺចាប់ខ្មួល
ខ្ញុំមានអារម្មណ៍ឈឺចាប់ពើតខ្ទោកៗ ។
តើខ្ញុំគួរតែស្នាក់នៅមន្ទីរពេទ្យភ្លាមៗមែនទេ ?
ភ្នែករបស់ខ្ញុំមានអារម្មណ៍ថារោលក្រហាយ ។
ភ្នែកខ្ញុំមានការឈឺចាប់ដូចគេចាក់ដោត ។
ខ្ញុំចង់អោយវេជ្ជបណ្ឌិតពិនិត្យអោយបានលឿនតាមដែលអាចធ្វើបាន ។
វាមានសភាពបែបនេះអស់រយៈពេលប៉ុន្មានថ្ងៃមកហើយ ។
តើខ្ញុំគួរសម្រាកនៅមន្ទីរពេទ្យភ្លាមៗដែរទេ ?
ភ្នែកខ្ញុំមានការឈឺចាប់ដូចម្ជុលចាក់ ។
ខ្ញុំអាចនិយាយភាសាបារាំងបានខ្លះៗ ។
ប្រទេសជប៉ុនសម្បូរភ្នំពោរពាស ។
ព្រលានយន្តហោះងាយស្រួលចេញចូល ។
តើជនបរទេសអាចចូលប្រើប្រាស់សៀវភៅនៅក្នុងបណ្ណាល័យនេះដែរទេ ?
ខ្ញុំនឹងអមដំណើរជាមួយអ្នកទៅកាន់ស្ថានីយ៍ ។
តើសរុបវាមានចំនួនប៉ុន្មាន ?
ខ្ញុំស្ងើចសរសើរ ខេវីន ខូសស្ន៊ើរ ។
សំបុត្រនេះអាចអោយមនុស្សបីនាក់ចូលបាន ។
តើអ្វីទៅជាអត្ថប្រយោជន៍របស់វា ?
សូមផ្តល់ឱវាទដល់ខ្ញុំផងថាតើត្រូវធ្វើអ្វី ។
ខ្ញុំអាចមានប្រាក់គ្រប់គ្រាន់ដើម្បីបានឡានថ្មីបានទើបតែពេលថ្មីៗនេះប៉ុណ្ណោះ ។
ខ្ញុំមិនអាចមានលទ្ធភាពបង់ថ្លៃសំបុត្រយន្តហោះបានឡើយ ។
ខ្ញុំខ្លាចតែខកជើងរថភ្លើងទេ ។
ខ្ញុំជំទាស់នឹងអ្នក ។
ខ្ញុំជាស្ត្រីតែម្នាក់ប៉ុណ្ណោះនៅក្នុងចំណោមសមាជិកទាំងអស់ ។
នរណាក៏ដោយសុទ្ធតែអាចចូលរួមបាន ។
អ្នកអាចយកអ្វីក៏ដោយដែលអ្នកពេញចិត្តបាន ។
តើខ្ញុំអាចមើលគ្រប់ទីកន្លែងណាក៏បាននៅក្នុងផ្ទះបានទេ ?
មានការធ្វើដំណើរជាច្រើនសំដៅចូលមកទីក្រុង ។
ខ្ញុំបានសុំគាត់អោយរៀបចំការធ្វើដំណើរទស្សនកិច្ចរបស់ខ្ញុំ ។
តើអ្នកអាចងាកចៀសបន្តិចបានទេ ?
តើអ្នកមានបន្ទប់ទំនេរដែរទេយប់នេះ ?
យើងផ្លាស់ប្ដូរផែនការរបស់យើងព្រោះមេឃភ្លៀង ។
ជើងហោះហើរខ្លះនឹងទំនងជាត្រូវបានលុបចោលដោយសារតែអ័ព្ទ ។
ខ្ញុំកំពុងសិក្សាដើម្បីក្លាយជាទន្តបណ្ឌិតម្នាក់ ។
សូមយើងបញ្ចប់មុនពេលមេឃចាប់ផ្តើមភ្លៀង ។
វាជារបស់ខ្ញុំ ។
សូមឈរនៅក្បែរខាងខ្ញុំ ។
អាមួយនេះត្រូវម៉ាច់នឹងខ្ញុំបំផុត ។
តើខ្ញុំអាចសុំខ្ចីអ្វីម៉្យាងដើម្បីយកមកសរសេរបានទេ ?
យើងទាំងពីរសុទ្ធតែជានិសិ្សត ។
ខ្ញុំនឹងទៅដល់នៅមិនអោយលើសពីម៉ោងប្រាំបី ។
តើអ្វីដែលបង្កនូវការអូសបន្លាយពេលវេលា ?
តើខ្ញុំអាចទៅក្នុងពិធីជប់លៀងអ្នកបានទេ ?
អ្នកគួរតែមើលផែនទីមួយនេះ ។
តើអ្នកអាចជួយប្ដូរលុយយេនរបស់ខ្ញុំទៅជាដុល្លារបានទេ ?
គាត់មានអំណាចច្នៃប្រឌិត ។
គាត់បដិសេធមិនបានធ្វើបែបនោះឡើយ ។
សូមធ្វើការពិពណ៌នានូវវ៉ាលីសអីវ៉ាន់អ្នកដែលបានបាត់ ។
គាត់បានទៅពិធីជប់លៀងទោះបីគាត់មានជម្ងឺក៏ដោយ ។
ម៉ាស៊ីនបានរលត់ឈឹង ។
ខ្ញុំបានធ្វើធ្លាក់កូនសោរនៅកន្លែងមួយមិនដឹងនៅក្នុងសណ្ឋាគារនេះ ។
ខ្ញុំស្ទើរតែលង់ទឹកទៅហើយ ។
ម្នាក់ៗគួរតែមានសំបុត្រមួយ ។
អ្នកអាចទៅកាន់ព្រះវិហារដោយវិធីណាមួយក៏បានក្នុងចំណោមវិធីទាំងពីរ ។
ខ្ញុំមានពេលវេលាគ្រប់គ្រាន់ដើម្បីទៅកាន់ទីនោះ ។
ខ្ញុំចូលចិត្តសណ្ឋាគារនេះលើកលែងតែអាហារ ។
ខ្ញុំរំពឹងទុកថានឹងទៅតាមជើងហោះហើរពេលព្រឹក ។
តើអ្នកនឹងជួយពន្យល់រឿងនេះអោយកាន់តែងាយស្រួលជាងនេះបានទេ ?
តើការនាំចេញសំខាន់ជាងគេនៃប្រទេសនេះគឺអ្វី ?
សណ្ឋាគារបែរមុខទល់នឹងសួនឧទ្យាន ។
សូមកុំខកខានមិនបានយកលិខិតឆ្លងដែនមកតាមខ្លួនអ្នកអោយសោះ ។
វាជាកំហុសអ្នក ។
ខ្ញុំនឹងកែកុនវា ។
តើបន្ទប់ខ្ញុំនៅជាន់ទីប៉ុន្មានដែរ ?
ខ្ញុំមិនធ្វើតាមអ្នកឡើយ ។
ខ្ញុំចូលចិត្តអាហារសមុទ្រ ។
មានមនុស្សគាស់ហិបរបស់ខ្ញុំអោយរបើក ។
ខ្ញុំភ្លេចអ្វីម៉្យាងនៅក្នុងបន្ទប់ខ្ញុំ ។
ខ្ញុំសប្បាយខ្លាំងណាស់នៅឯពិធីប្រគំតន្ត្រី ។
តើពួកយើងគួរជួបប្រជុំគ្នានៅម៉ោងប៉ុន្មាននៅយប់នេះ ?
គាត់ដៃទូលាយណាស់ជាមួយនិងលុយរបស់គាត់ ។
គាត់ស្លូតស្រួលជាមួយនិងក្មេងៗណាស់ ។
សូមអោយសំបុត្រទៅគាត់ទៅ ។
ខ្ញុំរីករាយណាស់ដែលបានជួបអ្នក ។
ខ្ញុំបាត់ដានមើលលែងឃើញក្រុមរបស់ខ្ញុំហើយ ។
ខ្ញុំចង់កាត់សក់ខ្ញុំ ។
រីករាយថ្ងៃខួបកំណើត ។
ខ្ញុំពិបាកនឹងយល់ពីគាត់ណាស់ ។
សណ្ឋាគារនេះមានអាងហែលទឹក ។
ខ្ញុំយកម្ហូបនេះចុះ ។
ខ្ញុំមានសុខភាពល្អ ។
តើអ្នកបានលឺដំណឹងនោះពីពេលណាមក ?
តើអាគារប៉មនោះមានកំពស់ប៉ុន្មាន ?
មិនថាខ្ញុំហត់នឿយយ៉ាងណាទេ ខ្ញុំនឹងទៅទីនោះ ។
តើអ្វីដែលខ្ញុំនិយាយបានធ្វើអោយអ្នកឈឺចាប់មែនទេ ?
ខ្ញុំមិនមានយោបល់អីទេ ។
ខ្ញុំមិនអាចបំភ្លេចអ្នកបានឡើយ ។
ចំនួនភ្ញៀវទេសចរណ៍បានកើនឡើង ។
វាមិនគួរអោយជឿបានថាគាត់ធ្វើវាបានសោះ ។
ខ្ញុំមិនមានទោសពៃរ៍នៅក្នុងបទល្មើសនោះឡើយ ។
ខ្ញុំមានបំណងនឹងចាកចេញថ្ងៃស្អែកនេះ ។
ខ្ញុំយល់ថាភាពយន្តនេះគួរអោយចាប់អារម្មណ៍ខ្លាំងណាស់ ។
ខ្ញុំចង់អញ្ជើញអ្នកទៅហូបអាហារពេលល្ងាច ។
គាត់ម៉ួរម៉ៅនឹងអ្នក ។
យើងនឹងចូលរួមនឹងអ្នកដែរនៅសណ្ឋាគារ ។
ខ្ញុំស្គាល់គាត់ត្រឹមតែឈ្មោះប៉ុណ្ណោះ ។
តើអ្នកនិយាយប៉ុន្មានភាសា ?
កុំសើចចំអកខ្ញុំ ។
ឈីកាហ្គោនាថ្ងៃស្អែក ។
រថភ្លើងទំនងជានឹងលើកពេលចេញដំណើរ ។
ខ្ញុំខ្លាចតែខ្ញុំបាត់សំបុត្រទេ ។
ខ្ញុំចាត់ចែងរកអោយឃើញហាងនោះ ។
ខ្ញុំមិនចូលចិត្តឬកពារនាងទេ ។
តើអ្នកនឹងជួបខ្ញុំនៅទីណា ?
រីករាយថ្ងៃបុណ្យណូអែល ។
តើអ្នកមិនយល់ទាស់ទេបើជួយបិទភ្លើងអោយផង ?
កញ្ញា តើនាងអាចជួយខ្ញុំបានទេ ?
តើខ្ញុំត្រូវតែទៅភ្លាមមែនទេ ?
ពេលនេះខ្ញុំដើរក៏មិនកើតអង្គុយក៏មិនកើត ។
ខ្ញុំមិនដែលបានឃើញទស្សនីយភាពស្អាតបែបនេះឡើយ ។
អីក៏រំខានម៉្លេះ ។
យើងមិនជំទាស់ទេ ។
ការកក់ទុកមុនគឺជាការចាំបាច់ខានមិនបាន ។
ខ្ញុំធ្លាប់ទៅទីនោះបានម្តង ។
តើភាពយន្តចប់ហើយ ?
អ្នកមើលទៅស្លេកស្លាំង ។
ខ្ញុំអន់ក្នុងផ្នែកភាសាបារាំង ។
ខ្ញុំចូលចិត្តនៅទីនេះជាង ។
ខ្ញុំមិនបានត្រៀមរៀបចំចាកចេញនៅឡើយ ។
ខ្ញុំមានសំណួរមួយចំនួន ។
ខ្ញុំចង់អានកាសែតជប៉ុន ។
តើនរណាជាអ្នកធានារបស់អ្នក ?
ខ្ញុំសោកស្តាយដែលមកយឺត ។
តើអ្នកអាចថាឡើងវិញនូវអ្វីដែលបាននិយាយបានទេ ?
គាត់ដូចឳពុករបស់លោកនៅត្រង់អត្តចរិត ។
ខ្ញុំពេញចិត្តនឹងការផ្តល់សេវាកម្មរបស់អ្នកហើយ ។
គ្រប់គ្នានៅទីនេះជួយសង្គ្រោះគាត់ ។
ស្រីម្នាក់នោះហាក់ដូចជាឈឺ ។
ខ្ញុំអាយុពីរឆ្នាំចាស់ជាងអ្នក ។
ប្រយ័ត្នផង ប្អូនស្រី ។
ខ្ញុំសោកស្តាយណាស់ចំពោះកំហុសរបស់ខ្ញុំ ។
សូមសំបុត្រទៅទីក្រុងវ៉ាស៊ីងតោនមួយមក ។
យើងនឹងនៅខាងក្រៅលើកលែងតែមេឃភ្លៀង ។
សួស្តី ផ្នែការិយាល័យជួរមុខ ។
នេះគឺខ្ញុំអ្នកនាងអាបេ ។ ខ្ញុំបានកក់ទុកមុននៅថ្ងៃនេះ ប៉ុន្តែខ្ញុំនឹងទៅដល់យឺតខ្លាំងណាស់ ។
ខ្ញុំយល់ហើយ ។ តើពេលនេះអ្នកនាងនៅឯណាដែរ ?
តាមពិតទៅ ខ្ញុំក៏មិនដឹងដែរ ។
សូមបន្ទប់មួយសម្រាប់ខ្ញុំផង ។ ខ្ញុំនឹងបង់ជាសាច់ប្រាក់ ។
សូមទោស ។ សូមចាំមួយភ្លែតណា ។
បន្ទប់លោកលេខ បីសូន្យប្រាំ ។
ប្រហែលរបស់នេះត្រូវតែបានប្រើប្រាស់សម្រាប់ជាអត្តសញ្ញាណហើយ ។
ខ្ញុំឈ្មោះ ម៉ារៀ អាបេ ។ ខ្ញុំបានកក់បន្ទប់ទុកជាមុននៅទីក្រុងតូក្យូ ។
មិនអាចបែបនោះឡើយ ។ នេះគឺសន្លឹកប័ណ្ណដែលបង្ហាញនូវការបញ្ជាក់អះអាងបន្ថែម
យើងមានលិខិតឆ្លងដែនអ្នកនៅក្នុងប្រអប់ទុកដាក់សុវត្ថិភាពរបស់យើងកាលពីម្សិលមិញ ។
កូនសោរសម្រាប់បន្ទប់បីសូន្យមួយ ។
អញ្ចឹង មានតែមានមនុស្សអាចនឹងធាក់ទម្លាយចូលបន្ទប់ហើយទើបបាន ។
កុំបារម្ភអី ។ គ្រប់បន្ទប់ភ្ញៀវទាំងអស់មានប្រព័ន្ធចាក់សោរស្វ័យប្រវត្តិ ។
ខ្ញុំចង់ផ្ញើសំបុត្រមួយច្បាប់ ។
យើងអាចផ្ញើវាទៅកាន់ការិយាល័យប្រៃសណីយ៍ជូនអ្នកបាន ។
តើមានអ្វីខុសមិនធម្មតាមែនទេ ?
ខ្ញុំសុខចិត្តយកវាទៅដោយខ្លួនឯងវិញប្រសិនបើខ្ញុំត្រូវអោយទឹកតែអ្នកនោះ ។
អ្នកគួរតែបង់ថ្លៃអ្វីខ្លះហើយ ។
ខ្ញុំសុខចិត្តទៅប្រទេសជប៉ុនវិញ ។
អ្ហា ។ ខ្ញុំមានអារម្មណ៍ថាក្តៅខ្លួន ។
សួស្តី តើនេះគឺជាផ្នែកការិយាល័យជួរមុខមែនទេ ? មិត្តភក្តិខ្ញុំផ្តាសាយ ។ តើអ្នកអាចលៃតម្រូវសីតុណ្ហភាពបន្ទប់បានទេ ?
អញ្ចឹងមិនល្អទេ ។ ពិតណាស់ ពិតជាបានភ្លាមៗ ។
ហេតុអីបានវាកាន់តែត្រជាក់ទៅៗទៅវិញ ?
អូ ថ្ងៃនេះមិនល្អដូចគ្នា ។
មានបញ្ហាបន្ទាន់នៅក្នុងបន្ទប់មួយសូន្យបី ។
អូស ខ្ញុំទល់លាមកហើយ ។
តើយើងគួរតែហៅឡានពេទ្យដែរទេ ?
ខ្ញុំមិនដឹងទេ ខ្ញុំនៅការិយាល័យជួរមុខគ្រប់ពេលរហូតមក ។
ខ្ញុំបានឃើញកំណត់ហេតុជូនដំណឹង ប៉ុន្តែខ្ញុំបានខ្ញុំបានទុកវាចោលព្រោះវាមិនមែនការងារខ្ញុំទេ ។
ឧបករណ៍ងូតទឹកផ្កាឈូកមិនដំណើរការហើយបង្គន់ក៏ស្ទះទៀត ។
សូមទោស សូមចាំមួយភ្លែតណា ។
ប្រហែលបន្ទប់ក្រាលព្រំទំហំបួនម៉ែត្រកន្លះរបស់ខ្ញុំនៅទីក្រុងតូក្យូមិនសូវអន់ពេកទេនៅទីបំផុត ។
សូមជួយហៅទូរស័ព្ទដាស់ខ្ញុំនៅម៉ោងប្រាំពីរផង ។
សូមជូយធ្វើអោយបន្ទប់ខ្ញុំក្តៅជាងនេះផង ។
តើខ្ញុំអាចសុំខ្ចីម៉ាស៊ីនផ្លុំសម្ងួតសក់បានទេ ?
តើអ្នកនឹងប្រាប់ខ្ញុំពីរបៀបប្រើប្រាស់ទូរទស្សន៍ដែរទេ ?
សូមជួយធ្វើបន្ទប់ខ្ញុំអោយត្រជាក់ជាងនេះផង ។
សូមយក ប៊ី មកអោយខ្ញុំផង ។
ខ្ញុំបានទុកទ្វារអោយចំហរ ។
ពួកគេទុកការងារចោលអោយនៅមិនទាន់ចប់សព្វគ្រប់ ។
តើអ្នកនឹងពិនិត្យលើរឿងនេះឥឡូវនេះទេ ?
សោរត្រូវបានចាក់ជាប់ហើយខ្ញុំមិនអាចចូលក្នុងបន្ទប់បានឡើយ ។
នៅតាមច្រករបៀងមានសម្លេងថ្លង់រំខាន ។
តើអ្នកកំពុងធ្វើអីហ្នឹង ?
ខ្ញុំទាយថាសហការីទូរស័ព្ទបានប្រាប់ខ្ញុំអោយរង់ចាំកុំដាក់ទូរស័ព្ទចុះ ។
សូមកុំទាន់ដាក់ចុះ ។
តើពិធីជប់លៀងមានលេខប៉ុន្មាននិងឈ្មោះអីដែរ ?
សូមដាក់ទូរស័ព្ទចុះបាន ហើយសូមរង់ចាំ ។ ខ្ញុំនឹងទូរស័ព្ទត្រលប់ទៅវិញ ។
ខ្ញុំនឹងបរិភោគអាហារពេលព្រឹកយ៉ាងច្រើនដែលផ្តល់ជូនពីសេវាកម្មបន្ទប់ ។
អូ នេះគឺកន្សែងជូត ។
ពួកយើងនឹងរៀបការនៅសប្ដាហ៍ក្រោយហើយ ។
រថភ្លើងរបស់យើងទើបតែចាប់ផ្តើមចេញដំណើរប៉ុណ្ណោះ ។
ខ្ញុំខ្លាចតែអ្នកកំពុងអង្គុយលើកន្លែងអង្គុយខ្ញុំទេ ។
ខ្ញុំខ្លាចតែខ្ញុំមិនអាចទទួលយកការផ្តល់ជូនរបស់អ្នកទេ ។
សូមយកកាសែតមកអោយខ្ញុំផង ។
តើខ្ញុំនៅអាចកុម្ម៉ង់សេវាកម្មបន្ទប់បាននៅឡើយមែនទេ ?
ខ្ញុំបានកុម៉្មង់មួយម៉ោងមកហើយ ។ តើវានៅមិនទាន់ហើយទៀតមែនទេ ?
តើអ្នកប្រាប់ខ្ញុំបានទេថាតើច្រកចេញសម្រាប់ពេលអាសន្ននៅត្រង់ណា ?
សូមរង់ចាំតែមួយភ្លែតទេ ។ ខ្ញុំនឹងទៅយកកូនសោរមេមក ។
ខ្ញុំចង់ផ្លាស់ប្ដូរសណ្ឋាគារ ។
យើងកំពុងតែចេញក្រៅ ។
វាគ្រោះថ្នាក់ណាស់ដែលចេញទៅខាងក្រៅនៅពេលយប់ ។
ជាពិសេសប្រសិនបើអ្នកដើរនៅជិតអាគារ អ្នកអាចនឹងត្រូវបានគេបំពារបំពានហើយ ។
នោះគួរអោយខ្លាចណាស់ ។ អ្នកស្នាក់នៅសណ្ឋាគារចុះ ។
យោបល់ល្អ ។ ខ្ញុំនឹងជួយមើលប្រពន្ធអោយលោកចុះ ។
នោះរឹតតែគ្រោះថ្នាក់ទៅទៀត ។
សូមមើលមកអានេះទៅមើល ។
តើអ្នកមានការដើរទស្សនកិច្ចពេលយប់ដែលយើងអាចឃើញការសំដែងទេ ?
មិនមានការសំដែងពេលល្ងាចទេ ។ ប៉ុន្តែមានការសំដែងនៅពេលថ្ងៃ ។
ពិតមែនឬ ? តើការសំដែងប្រភេទអីទៅ ?
ប្រាប់ខ្ញុំមកថាគាត់នៅឯណា ។
ប្រាប់ខ្ញុំមកថាត្រូវធ្វើអីខ្លះ ។
ប្រាប់ខ្ញុំផងថាត្រូវបំពេញទម្រង់បែបបទនេះដោយរបៀបណា ។
ប្រាប់ខ្ញុំមកថាខ្ញុំគួរត្រលប់មកកាន់ទីនេះវិញនៅម៉ោងប៉ុន្មាន ?
តើអ្នកមានរបស់អ្វីដូចគ្នានឹងរបស់នេះដែរទេ ?
មានមនុស្សប្រាំនាក់រួមទាំងរូបខ្ញុំផងដែរ ។
តើអ្នកមានសេវាកម្មទូរសារដែរទេ ?
តើមានហាងកាហ្វេមួយទៀតដែរទេ ?
សូមត្រៀមរៀបចំមគ្គទ្ទេសក៍ទេសចរណ៍ដែលនិយាយភាសាជប៉ុនផង ។
សូមស៊ុតស្ងោរ ។
តើអ្នកចង់អោយស្ងោរវាប៉ុន្មាននាទីដែរ ?
ខ្ញុំទាយថាគាត់សួរថាចំនួនប៉ុន្មាន ?
តើមានកន្លែងអង្គុយប៉ុន្មានកន្លែងដែលនៅទំនេរនៅឡើយ ?
តើស៊ុតប៉ុន្មានគ្រាប់ ?
ខ្ញុំហូបអាហារពេលព្រឹកបែបអង់គ្លេស ។
តើអ្នកចង់បានស៊ុតប៉ុន្មានគ្រាប់ដែរ ?
ខ្ញុំចង់បានស៊ុតចៀនជាមួយសាច់ជ្រូកបីជាន់ ។
តើនោះគឺជាលោក ស្ហ៊ីរ៉ូសាវ៉ាមែនទេ ?
គឺខ្ញុំហ្នឹងហើយ ។
លោកមានទូរស័ព្ទហៅចូលមកពីរដ្ឋមន្ត្រីការបរទេសណាលោក ។
អ្នកពិតជាចូលចិត្តល្បែងតូចៗប្រភេទនេះណាស់ មែនទេ ?
អ្នកនិយាយអញ្ចឹង តើមែនទេ ?
អ្នកអាចទៅដោយខ្លួនឯងបាន តើមែនទេ ?
អ្នកមិនចូលចិត្តអាវធំកំប្លេនេះទេ មែនទេ ?
សូមផ្ញើសារតាមម៉ាស៊ីនទៅកាន់លោក ម៉ាកឃើលលី ។
តើយើងគួរអោយគេសំអាតអានោះជូនអ្នកដែរទេ ?
ពុទ្ធោ វាថ្លៃណាស់ ។
រឿងនេះបានធ្វើអោយខ្ញុំនឹកឃើញដល់ការងារក្រៅម៉ោងរបស់ខ្ញុំដែលខ្ញុំលាងចាន ។
ខ្ញុំចង់អោយអ៊ុតខោរបស់ខ្ញុំ ។
តើអ្នកចង់អោយគេសំអាតបន្ទប់មែនទេ ?
តើអ្នកអាចសំអាតអាវធំនេះបានរួចរាល់ត្រឹមព្រឹកស្អែកបានទេ ?
ខ្ញុំចង់អោយអ៊ុតវា ។
វានឹងរួចរាល់នៅត្រឹមថ្ងៃខានស្អែក ។
សូមធ្វើសក់ខ្ញុំនៅចំហៀង ។
ហ៊ឺម កំពុងមើលកីឡា តើមែនទេ ?
ទេ នេះគឺកិច្ចការសំខាន់ ។
ខ្ញុំនឹងជួយអ្នកលាងចាន ។
តើខ្ញុំអាចសុំធ្វើការណាត់ជួបនៅម៉ោងបីរសៀលបានទេ ?
កក់សក់និងធ្វើម៉ូតសក់ ។
តើអ្នកចង់កាត់សក់អ្នករបៀបម៉េចដែរ ?
សូមកាត់បន្តិចថែមទៀត ។
តើមានហាងតុបតែងសម្ផស្សនៅក្នុងសណ្ឋាគារដែរឬទេ ?
តើអ្នកមានកូនសោរដែរទេ ?
ខ្ញុំបានទំលាក់វានៅក្នុងប្រអប់ដាក់កូនសោរ ។
បីសូន្យប្រាំមួយ ។
លោក ស្ហ៊ីរ៉ូសាវ៉ា ។ នេះគឺវិក្កយបត្រចំណាយរបស់លោក ។
តើអ្នកបានដាក់ចូលប្រាក់កក់របស់ខ្ញុំទៅក្នុងចំនួនសរុបដែរទេ ?
វាជាពន្ធអាករប្រចាំរដ្ឋ ។ វាមានចំនួនប្រាំភាគរយ ។
វាទាបជាងនៅក្នុងទីក្រុងញូយ៉ក ។
អស្ចារ្យណាស់ ។ សូមសំដែងការគោរពដ៏ប្រសើរបំផុតរបស់ខ្ញុំដល់អភិបាលរដ្ឋលោកផង ។
យ៉ាងណាក្តី យើងមានវ៉ាលីសច្រើនថែមទៀត ។
រថភ្លើងប្រើចំហាយទឹក
ខ្ញុំនឹងកាន់វាអោយលោកទៅចុះ ណាលោក ។
តើអ្នកយល់ស្របមិនយកប្រាក់ទឹកតែដែរទេ ?
ជនជាតិជប៉ុនរិះណាស់សូម្បីតែពួកគេមានក៏ដោយ ។
តើខ្សែនេះសម្រាប់អ្វីដែរ ?
សូមផ្ញើក្តីគោរពដ៏ប្រសើរបំផុតរបស់ខ្ញុំជូនចំពោះលោកឳពុកលោកផង ។
ខ្ញុំនឹងចាកចេញនៅព្រឹកស្អែក ។ សូមរៀបចំវិក្កយបត្រចំណាយរបស់ខ្ញុំអោយរួចរាល់ ។
ហាក់ដូចជាមានការគិតលុយខុសនៅក្នុងវិក្កយបត្រ ។
ចុះចំណែកភោជនីយដ្ឋានចិនវិញយ៉ាងម៉េចដែរ ?
អញ្ចឹង ប្រាប់ខ្ញុំនូវភោជនីយដ្ឋានអាហារសមុទ្រដ៏ឆ្ងាញ់មួយមក ។
អាចនឹងមានមួយនៅក្នុងអាគារ ហ្វ្រាស់កូ ។
កន្លែងនេះជាចំណុចកណ្តាលរបស់រដ្ឋតិចសាស់ ។ សាច់គោឆ្ងាញ់បំផុត ។
ខ្ញុំបានហូបសាច់គោអស់ពេលបីថ្ងៃនេះមកហើយ ។ ខ្ញុំចង់ហូបគុយទាវធម្មតា ។
ចុះចំណែកចេញលុយរៀងខ្លួនវិញយ៉ាងម៉េចដែរ ?
តើវាងាយស្រួលសម្រាប់អ្នកដែរទេ ?
សូមណែនាំនូវភោជនីយដ្ឋានឆ្ងាញ់មួយផង ។
ខ្ញុំចង់បានភោជនីយដ្ឋានដែលមានតម្លៃសមល្មម ។
តើអ្នកគិតថាចង់ចំណាយចំនួនប៉ុន្មានដែរ ?
ប្រហែលហាសិបដុល្លារក្នុងមួយនាក់ ។
សូមតុមួយសម្រាប់មនុស្សពីរនាក់នៅម៉ោងប្រាំបីយប់នេះដោយយកកន្លែងមានទេសភាពមហាសមុទ្រ ។
លោក អូហ្ស៊ឺ សូមអញ្ជើញតាមផ្លូវនេះមក ។
ហ្អេ ។ នេះមិនមែនជាតុមានទេសភាពមហាសមុទ្រទេ ។
តើនេះជាស្អីដែរ ? ខ្ញុំត្រូវការជួបនឹងប្រធានចាត់ចែង ។
អា ។ នេះគឺជាភោជនីយដ្ឋានវិលណាលោក ។
ខ្ញុំទាមទារអោយសងជម្ងឺចិត្ត ។
សូមទោស យើងមានភ្ញៀវច្រើនណាស់ ។
ចុះចំណែកនៅម៉ោងប្រាំបីវិញយ៉ាងម៉េចដែរ ?
តើខ្ញុំគួរពាក់អាវធំនិងក្រវ៉ាត់កដែរទេ ?
ត្រូវហើយ បែបនោះនឹងកាន់តែប្រសើរ ។
ខ្ញុំនឹងព្យាយាមពេលក្រោយទៀតចុះ ។
ខ្ញុំអាចយកអាវក្រៅលោកបាន ណាលោក ។
ប៉ុន្តែយើងមានភ្ញៀវដទៃទៀត ។
អ្នកឃើញទេ ខ្ញុំមានបញ្ហានៅខាងក្រោមអាវក្រៅខ្ញុំ ។
ខ្ញុំយល់ពីន័យរបស់លោកហើយ ។
លោកនិយាយក៏ចំចំណុចម៉្យាងដែរ ។
ខ្ញុំបានកក់ទុកមុនសម្រាប់ម៉ោងប្រាំពីរ ។ ខ្ញុំឈ្មោះ ស៊ូហ្ស៊ូគិ ។
យើងមិនមានការកក់ទុកមុនទេ ។ តើអ្នកមានតុសម្រាប់មនុស្សពីរនាក់ដែរទេ ?
សូមទោស ពេលនេះតុរបស់យើងពេញអស់ហើយ ។
យើងនឹងរង់ចាំនៅក្នុងបារទៅចុះ ។
សូមផ្ញើសារតាមម៉ាស៊ីនមកយើងផងបើសិនមានតុមួយទំនេរ ។
សូមស្វាគមន៍ ។ តើប៉ុន្មាននាក់ដែរ អ្នកស្រី ?
ខ្ញុំចូលចិត្តតុដែលនៅក្បែរបង្អូចជាង ។
ពួកយើងត្រូវបានគេទុកចោលមិនអើពើហើយ ។ ខ្ញុំទាយថានោះជាកំហុសរបស់អ្នក ។
ខ្ញុំចូលចិត្តតុដែលនៅកាច់ជ្រុងជាង ។
ខ្ញុំចង់រីករាយនឹងទេសភាពនៃសួនច្បារ ។
ខ្ញុំចង់បានតុដែលអាចជក់បារីបាន ។
ខ្ញុំចូលចិត្តតុដែលមានទេសភាពល្អស្អាតជាង ។
ខ្ញុំចង់រីករាយនឹងទេសភាពពេលរាត្រីនៃទីក្រុង ។
សូមដាក់ខ្ញុំអោយអង្គុយនៅតុស្ងៀមស្ងាត់ ។
តើមានភោជនីយដ្ឋានដែលមានបរិយាកាសស្ងប់ស្ងៀមដែរទេ ?
អ្នកស្គាល់កន្លែងល្អៗទាំងអស់ ដូចជានិច្ចកាលសព្វមួយដងអញ្ចឹង ។
ខ្ញុំមកទីនេះព្រោះខ្ញុំលឺមកថាភោជនីយដ្ឋាននេះស្ងប់ស្ងៀម ។
សូមទោស តាមធម្មតាវាជាបរិយាកាសស្ងប់ស្ងៀម ។
តើអ្នកមានអ្វីដូចជារបស់ពិសេសប្រចាំថ្ងៃដែរទេ ?
សាច់គោអាំងជាមួយទឹកជ្រលក់ ។
ទឹកជ្រលក់ប្រភេទណា ?
តើខ្ញុំគួរហៅចុងភៅមកដើម្បីពន្យល់ដែរទេ ?
មិនចាំបាច់ធ្វើអញ្ចឹងទេ អរគុណហើយ ។ ខ្ញុំយកអាហ្នឹងទៅចុះ ។
សូមកាហ្វេពីរ ។
ការបញ្ចេញសម្លេងភាសារបស់ខ្ញុំច្បាស់ជាមិនល្អហើយ ។
ប្រាកដជាអញ្ចឹងច្បាស់ណាស់ ។
សូមអត់ទោស ។ សូមទឹកមួយកែវមក ។
អ្ហេ ។ នេះគឺស្រាវ៉ូតកាទេ ភ្លើមែន ។
សូមចាំមួយភ្លែត ។
ការធ្វើកាបូនិចកម្មគឺជាស្រាទឹកផ្លែឈើ តើមែនទេ ?
អឺ តើយើងអាចសុំយកទឹករ៉ែមិនមែនជាទឹកផ្លែឈើគាបបានទេ ?
តើអ្នកនិយាយពាក្យ ថានស្ហាន ណាស៊ិ ដូចម្តេចដែរ ?
ខ្ញុំចង់បានអានេះ ។
សូមទុកអោយខ្ញុំគិតបន្តិចសិន ។
តើអ្នកណែនាំម្ហូបអីដែរ ?
ខ្ញុំចង់បានម្ហូបដូចគ្នានឹងអានោះដែរ ។
តើអ្នកអាចរៀបចំវាភ្លាមៗបានទេ ?
តើអ្នកមានអ្វីដែលអាចធ្វើឆ្អិនបានរហ័សទេ ?
ព្រោះខ្ញុំនឹងរៀបចំស្ទីលត្រីសាល់ម៉ុងជ្រលក់ម្សៅបំពង់ខ្លាញ់នេះ ។
អា ។ ចំជាខ្ជះខ្ជាយពងត្រីមែន ។
ថាម៉េច ។ អ្នកចង់បានន័យថាជនជាតិជប៉ុនញ៉ាំរបស់នេះអញ្ចឹងឬ ?
ពិតណាស់ យើងចូលចិត្តវា ។
មិនអីទេ គ្រាន់តែរីករាយនឹងត្រីជ្រលក់ម្សៅបំពងរបស់ខ្ញុំទៅចុះ ។
ខ្ញុំពិតជាមិនប្រាកដទេថាជាមួយណាទេ ។
នៅទីបំផុត វាជាកូនចានចង្កឹះសម្រាប់ជ្រលក់លាងម្រាមដៃ ។
អ្នកកំពុងតែកាន់ចង្កឹះអ្នកខុសហើយ ។
ខ្ញុំរៀនរបៀបប្រើប្រាស់ចង្កឹះនៅឯបារបម្រើអាហារស៊ូស៊ិ
អ្នកមិនមែនកំពុងប្រើកាំបិតនោះបានត្រឹមត្រូវទេ ។
អ្នកពិតជាពូកែក្នុងរឿងនោះមែន ។
ត្រូវហើយ ខ្ញុំរៀនសូត្រពីភោជនីយដ្ឋានប្រចាំគ្រួសារមួយ ។
ចំជាខ្ជះខ្ជាយពងត្រីមែន ។
ចំជាខ្ជះខ្ជាយពេលវេលាមែន ។
ចំជាប្រទេសធំមែន ។
តើអ្នកចង់អោយចំណិតសាច់របស់អ្នកត្រូវបានចំអិនយ៉ាងដូចម្តេច ?
តើទឹកស្រូបលើអាហារមួយណាដែលអ្នកត្រូវការ ?
តើអ្នកមានទឹកស្រូបលើអាហារបារាំងទេ ?
សូមយកនំប៉័ងថែមទៀតមកអោយខ្ញុំផង ។
អ្ហេ អ្នកមានសមពីរដើម ខ្ញុំមានសមតែមួយដើមទេ ។
អញ្ចឹងនិយាយអ្វីខ្លះទៅ ។
សូមអត់ទោស ខ្ញុំនៅខ្វះសមមួយដើមទៀត ។
ខ្ញុំសូមទោស ។ ខ្ញុំបានអោយទៅគាត់នូវសមយ៉ាងច្រើនហើយ ។
សាច់នេះស្វិតណាស់ ។
អ្ហេអ្នក សាច់នេះស្វិតណាស់ហូបមិនកើតទេ ។
ខ្ញុំគិតថាកាំបិតនេះនឹងកាត់បានមុតល្អជាង ។
នោះមិនមែនអ្វីដែលខ្ញុំចង់បានន័យនោះឡើយ ។
តើចំនួននេះគឺពន្ធអាករលើទំនិញនិងសេវាកម្មមែនទេ ?
វាថ្លៃណាស់សម្រាប់ពន្ធអាករ ។ តោះពួកយើងសាកសួរទៅមើល ។
សូមអត់ទោស តើចំនួននេះសម្រាប់ថ្លៃអីដែរ ?
គឺថា ទុកអោយខ្ញុំមើលសិន ។ នោះគឺការគិតថ្លៃសេវាកម្ម ។
តើមានន័យថាយើងមិនចាំបាច់ត្រូវអោយប្រាក់ទឹកតែតើមែនទេ ?
ខ្ញុំមិនគិតថាវាតែងតែប្រព្រឹត្តទៅបែបនោះជាស្វ័យប្រវត្តិនោះឡើយ ។
តាមធម្មតាតែងតែមានការគិតលុយខុសនៅក្នុងវិក្កយបត្រសូម្បីតែនៅភោជនីយដ្ឋានប្រភេទនេះក៏ដោយ ។
យើងនឹងត្រូវតែពិនិត្យមើលវា ។
សូមរង់ចាំមួយភ្លែត ។ ទុកអោយខ្ញុំពិនិត្យវាមើលសិន ។
តើអ្នកមានបានពិនិត្យវិក្កយបត្រហើយនៅ ?
សូមទុកអោយខ្ញុំមើលអានោះសិន ។
សូមទុកអោយខ្ញុំគិតមួយសន្ទុះសិន ។
អា មួយនោះឆ្ងាញ់ណាស់ ។
តើខ្ញុំគួរហៅរថយន្តតាក់ស៊ីមកទេ ?
ទេ អរគុណហើយ ។ វានៅក្នុងចម្ងាយជិតដើរបានទេ ។
តើអ្នកអាចដើរមកវិញបានទេ ?
វានៅត្រង់នោះតែប៉ុណ្ណោះ ។
អ្នកអាចនឹងបាត់បង់លើសពីថ្លៃរថយន្តតាក់ស៊ីទៅទៀត ។
តើខ្ញុំអាចសុំនាមប័ណ្ណសម្រាប់អាជីវកម្មនេះបានទេ ?
តើអ្នកចង់បានភេសជ្ជៈអ្វីបន្ទាប់ពីអាហារពេលល្ងាចរួច ?
យើងនឹងយកតែអង់គ្លេសសុទ្ធសាធពិតប្រាកដទៅចុះ ។
តើស្លឹកតែនេះគឺស្លឹកតែមកពីក្រុងដាជីលីងឬក៏រដ្ឋអាសាម ?
សូមយកតែទឹកកក ។
អ៊ឺម ខ្ញុំចង់បានទឹកស្ករខ្លះដែលមិនផ្អែម ។
តែទឹកកកខ្ញុំអត់ផ្អែមទេ ។
អឺ ខ្ញុំនឹងយកស្ករខ្លះមកអោយអ្នក ។
អ៊ឺម វានឹងមិនរលាយឡើយ ។
អ្នកផឹកទឹកសូដាច្រើនណាស់ ។
សូមចាំមួយភ្លែត ។ មិនមែនទឹកផ្លែឈើ ហើយក៏មិនមែនកាហ្វេដែរ ។
ទឹកគឺបានហើយ ។ សូមទឹកមួយមក ។
ប្រសិនបើអ្នកគ្រាន់តែនិយាយថា "ទឹក" តើពួកគេនឹងមិនយកទឹកមានជាតិឧស្ម័នកាបូនិចមកអោយអ្នកទេឬ ?
អោយភេសជ្ជៈអីដែលមានជាតិឧស្ម័នកាបូនិចមក
តើអ្នកមានទឹកផ្លែឈើប្រភេទយ៉ាងម៉េចខ្លះ ?
ខ្ញុំចង់បានអ្វីម៉្យាងសម្រាប់ផឹកក្រៅពីស្រា ។
អោយអីដែលគ្មានជាតិឧស្ម័នកាបូនិចមក
អោយភេសជ្ជៈអីគ្មានជាតិហ្គាសមក ។
អោយអីដែលមានជាតិឧស្ម័នកាបូនិចមក
ខ្ញុំធ្វើទុក្ខតិចតួចកើតគ្រុនផ្តាសាយ ។ ខ្ញុំចង់ដឹងថាតើនេះព្រោះតែខ្ញុំរងារមែនឬអត់ ?
វាជាស្រាឡើងមេធ្វើពីអំពៅក្តៅៗ ។ វាល្អប្រសើរសម្រាប់ជម្ងឺផ្តាសាយរបស់អ្នក ។
ខ្ញុំគិតថាកាលពីម្សិលមិញខ្ញុំផឹកច្រើនពេក ។ ថ្លើមរបស់ខ្ញុំឈឺហើយ ។
ខ្ញុំអត់ចេះផឹកទេ ។
តើអ្នកកុម៉្មង់យកអីខ្លះដែរ ?
សូមអោយស្រាល្វីងនិងស្រាឡើងមេអង់គ្លេសកន្លះភីនមក ។
តើអ្នកមកពីប្រទេសជប៉ុនមែនទេ ?
មិត្តភក្តិខ្ញុំម៉ូរីវ៉ាគិប្រាប់ខ្ញុំអំពីទីកន្លែងនេះ ។
សូមនំហេមប៊ើហ្គើរនិងដំឡូងបារាំងបំពងមួយមក ។
វានឹងស៊ីពេលមួយចំនួនដើម្បីធ្វើដំឡូងបារាំងបំពង ។
តើខ្ញុំគួរដាក់នំហេមប៊ើហ្គើរអ្នកនៅក្រោមម៉ាស៊ីនកំដៅដែរទេទើបវាមិនត្រជាក់ ?
ហេតុអីបានជនជាតិជប៉ុនតែងតែចងចិញ្ចើមជានិច្ចកាលពេលខ្ញុំព្យាយាមធ្វើចិត្តល្អអញ្ចឹង ?
វាពិតជាថ្ងៃដ៏ល្អមែន ។ សូមពួកយើងញ៉ាំសាំងវិចឬអ្វីម៉្យាងនៅខាងក្រៅទៅ ។
នំសាំងវិចមួយមក ។
តើនំប៉័ងមួយណា ? តើអ្នកត្រូវការសាច់ភ្លៅជ្រូកទេ ? ជ្រក់ទេ ? ចុះចំណែកម៉ាញ៉ូណែតវិញ ?
អ៊ូស ។ តើខ្ញុំគួរធ្វើយ៉ាងម៉េច ?
សូមជាមួយសូដា ។
សូមយកស្រាវីសស្គីដាក់ទឹកកដុំ ។
អោយខ្ញុំប្រាកដចិត្តថាគ្មានការយល់ច្រលំអីសិន ។
ខ្ញុំនឹងហូបវានៅទីនេះ ។
ខ្ញុំនឹងយកហាំប៊ើហ្គើរតូចមួយនិងដំឡូងបារាំងបំពងចានតូចមួយមក ។
អោយខ្ញុំសូមសាឡាត់និងទឹកជ្រលក់ខាប់បន្ថែមរសជាតិមក ។
សូមអោយទឹកក្រឡុកវ៉ានីឡាកែវធំមួយមក ។
អោយខ្ញុំប្រាកដចិត្តថាគ្មានការយល់ច្រលំអីសិន ។
ពួកយើងមានគ្នាពីរនាក់ ហេតុនេះយើងគួរយកចានធំឬទេ ?
ខ្ញុំមិនគិតថាវាជាគំនិតល្អទេ ។ វានឹងច្រើនពេកសម្រាប់ជនជាតិជប៉ុនដូចរូបអ្នក ។
ឃើញទេ ? វាធំណាស់ មែនទេ ? ខ្ញុំនឹងយកស្បោងដាក់អាហារផ្ញើឆ្កែមកអោយអ្នកពេលក្រោយ ។
អ្នកញ៉ាំវាអស់ទាំងអស់ហើយឬ ?
សូមរៀបចំចំណែកតូចមួយបានហើយ ។
យើងនឹងហូបវាទាំងអស់គ្នា ហេតុនេះសូមយកសមក្រៅបន្ថែមមួយដើមមកផង ?
វាច្រើនជាងអ្វីដែលខ្ញុំអាចញ៉ាំអស់ទៅទៀត ។
សូមយកស្បោងដាក់អាហារសម្រាប់អោយឆ្កែមកអោយខ្ញុំផង ។
តើខ្ញុំអាចទិញក្រែមការពារកំដៅថ្ងៃនៅទីណាបាន ?
ខ្ញុំគិតថាអ្នកអាចរកទិញវាបាននៅឯផ្សារទំនើប ។
ខ្ញុំភ្នាល់ថាមានជម្រើសច្រើនជាងនៅឯហាងលក់ថ្នាំពេទ្យ ។
ខ្ញុំបានឃើញក្រែមការពារកំដៅថ្ងៃខ្លះនៅហាងលក់គ្រឿងសំអាងនៅកាច់ជ្រុង ។ វានៅជិតបំផុត ។
ការបញ្ជាទិញតាមសារអេឡិចត្រូនិចគឺប្រសើរជាង ។ វាមានតម្លៃថោក ។
សូមអត់ទោស តើអ្នកសន្និដ្ឋានយ៉ាងម៉េចដែរ ?
តើផ្នែកលក់គ្រឿងបរិក្ខារសម្រាប់បរិភោគនៅតុអាហារនៅឯណា ?
តើអ្នកអាចណែនាំហាងសម្លៀកបំពាក់ដ៏មានប្រជាប្រិយមួយក្នុងចំណោមនារីក្មេងៗបានទេ ?
តើបើកធ្វើការនៅម៉ោងប៉ុន្មានដែរ ?
តើអ្នកបើកនៅថ្ងៃឈប់សម្រាកបុណ្យទានដែរទេ ?
តើផ្នែកលក់គ្រឿងបរិក្ខារសម្រាប់បរិភោគនៅតុអាហារនៅឯណា ?
តើអ្នកកំពុងតែស្វែងរកទឹកអប់ប្រភេទយ៉ាងម៉េចដែរ ?
ខ្ញុំចង់បានក្លិនផ្កា ។
អឺគឺថា ខ្ញុំចូលចិត្តក្លិនដែលមិនសូវផ្អែមខ្លាំងជាង ។
អាមួយនេះក្លិនខ្លាំងណាស់ ។
អាមួយនេះមានក្លិនដូចសាច់ជ្រូកផ្អែមនិងជូរអញ្ចឹង ។
ខ្ញុំគិតថាអ្នកបានបាត់បង់ញាណទទួលក្លិនរបស់អ្នកហើយ ។
ចំជាដបទឹកអប់ស្អាតមែន ។ បង្ហាញអានោះអោយខ្ញុំមើលផង ។
ស្អាត តើមែនទេ ? វាត្រូវបានធ្វើនៅក្នុងប្រទេសអេហ្ស៊ីប ។
អូ ខ្ញុំមានអារម្មណ៍ដូចជាព្រះនាងក្លេអូប៉ាត្រាអញ្ចឹង ។ ខ្ញុំយកវាទៅចុះ ។
ប្រហែលច្រមុះអ្នកនឹងកាន់តែខ្ពស់ជាងនេះទៀតហើយ ។
តើអ្នកមានក្រវិលដែរទេ ?
យើងមានតែក្រវិលសម្រាប់ត្រចៀកចោះតែប៉ុណ្ណោះ ។
យើងមានមួយចំនួន ប៉ុន្តែយើងមានតែប៉ុន្មានប្រភេទតែប៉ុណ្ណោះ ។
នោះគឺកន្លាស់ខ្ទាស់ក្រដាស់ ។
តើអ្នកមានសៀវភៅណាដែលបង្ហាញរូបភាពស្ត្រីអាក្រាតដែរទេ ?
អត់ទេ ។ ខ្ញុំចូលចិត្តសៀវភៅដែលបង្ហាញគ្រប់យ៉ាងទាំងអស់ជាង ។
អញ្ចឹង ខ្ញុំសូមណែនាំអាមួយនេះទៅចុះ ។
ស្បែកជើងកវែងក៏ស្អាតដូចគ្នាដែរ ។
ស្បែកជើងមួយនេះមើលទៅមានលក្ខណៈជាមនុស្សពេញវ័យខ្លាំងដល់ហើយ ។
ខ្ញុំគិតថាអ្វីបែបនេះនឹងមើលទៅល្អបំផុតពេលនៅលើខ្លួនអ្នក ។
ខ្ញុំនឹងទះកំភ្លៀងអ្នក ។
ក្រែមលាបបបូរមាត់តូចមួយនេះគួរអោយស្រឡាញ់ណាស់ ។ អោយខ្ញុំយកអាមួយនេះចុះ ។
នេះគឺជាអំណោយសម្រាប់អតិថិជនដែលបានទិញលើសពីមួយរយហាសិបដុល្លារអាមេរិក ។
វាមិនមែនសម្រាប់ដាក់លក់ទេ ហេតុនេះកុំបាច់គិតរឿងនេះធ្វើអី ។
អ្នកមិនចាំបាច់ត្រូវតែទិញក្រែមលាបមាត់ដើម្បីទទួលបានក្រែមលាបមាត់នោះឡើយ ។
បង្ហាញអោយខ្ញុំមើលនាឡិកាដៃប្រាក់នេះទៅមើល ។
អ្នកប្រាកដជាលេងសើចហើយ ។ ពួកយើងមិនធ្វើជំនួញនាឡិកាប្រាក់ទេ
នេះគឺធ្វើពីជាតិលោហៈប្លាទីនៀម ។
ខ្ញុំចង់បានន័យថាលាបពណ៌ប្រាក់ ។
តើអ្នកមានម៉ូតដូចគ្នាដែលមានក្បាច់ខុសគ្នាទេ ?
តើនេះជាឡែនមួយរយភាគរយមែនទេ ?
តើអ្នកមានម៉ូតដូចគ្នាតែមានពណ៌ខុសគ្នាដែរទេ ?
វាហាក់ដូចជាលេចខ្លាំងណាស់ ។
ខ្ញុំយកស្រោមដៃទាំងនេះចុះ ។
ខ្ញុំមិនមែនអ្នកទទួលបន្ទុករឿងស្រោមដៃទេ ហេតុនេះសូមជូបនឹងគាត់វិញចុះ ។
នេះគឺបង្កាន់ដៃទទួលប្រាក់ ។ សូមបង់ប្រាក់នឹងបេឡាករ ។
តើខ្ញុំត្រូវទៅកាន់បេឡាករមែនទេ ?
វាត្រូវជាហាសិបដុល្លារ ។ សូមយកទំនិញរបស់អ្នកពីអ្នកទទួលបន្ទុកទៅចុះ ។
ត្រលប់ទៅវិញទៀតហើយ ?
ខ្ញុំគ្រាន់តែទទួលបន្ទុករឿងបង្កាន់ដៃទទួលប្រាក់ទេ ។ សូមអញ្ជើញទៅកាន់បញ្ជរដឹកជញ្ជូនទំនិញ ។
វាត្រូវជាចិតសិបប្រាំបួនដុល្លារ ។
នេះគឺក្រដាស់ប្រាក់មួយរយដុល្លារ ។
នេះគឺប្រាក់អាប់របស់អ្នក ។ ចិតសិបប្រាំបួនដុល្លារ ប៉ែតសិបប្រាំបួនដុល្លារ កៅសិបប្រាំបួនដុល្លារ មួយរយដុល្លារ ។
ចាំយើងមើលសិន ។ ដកចិតសិបប្រាំបួនពីមួយរយដុល្លារត្រូវជាម្ភៃមួយដុល្លារ ។ គាត់គិតត្រូវហើយ ។
ពិតហើយគាត់គិតត្រូវ ។
ប្រហែលខ្ញុំនឹងទិញអាវវែងមួយនេះហើយ ។
ប្រាំពីររយដុល្លារ ។ នោះជាការទិញក្នុងតម្លៃដ៏ល្អហើយ ។
តើអ្នកអត់មានអីដែលមានតម្លៃប្រហែលៗហាសិបដុល្លារទេឬ ?
ចុះចំណែកសាប៊ូនិងរបស់របរបែបៗហ្នឹងវិញ ?
ខ្ញុំកំពុងតែរកចិញ្ចៀន ។
អឺ ទុកអោយខ្ញុំមើលសិន ។ វាលើសពីថវិការរបស់ខ្ញុំហើយ ។
អរគុណអ្នកហើយដែលបានអញ្ជើញមក ។
តើខ្ទង់តម្លៃគឺប៉ុន្មានដែរ ?
តើអ្នកមានកាបូបណាដែលមានតម្លៃក្រោមកៅសិបដុល្លារដែរទេ ?
