ជំរាបសួរ ។ តើអ្នកអាចអោយកាតបង់ប្រាក់រួច ចំនួនដប់មកខ្ញុំបានទេ ?
សូមជំរាបសួរ ។ សូមអោយវិទ្យុទូរលេខចំនួនប្រាំ ។
ខ្ញុំកំពុងប្រមូលតែម ដូច្នេះតើអ្នកអាចអោយតែមផ្សេងៗខុសៗគ្នាមកខ្ញុំបានទេ ?
តើអ្នកមានតែមចាស់ៗទេ ? តើខ្ញុំអាចមើលវាបានទេ ?
សួស្តី ។ ខ្ញុំត្រូវការបើកគណនេយ្យសន្សំជាមួយអ្នក ។
ខ្ញុំមានបំណងបើកគណនេយ្យបញ្ញើរមួយនៅធនាគារនេះ ។
ប្រពន្ធរបស់ខ្ញុំហើយនិងខ្ញុំត្រូវការបើកគណនេយ្យសន្សំរួមមួយ ។
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបបើកគណនេយ្យសន្សំមួយបានទេ ?
តើអ្នកបំពេញទំរង់បែបបទទាំងនេះបានទេ ?
ខ្ញុំត្រូវការបើកគណនេយ្យសែកមួយជាមួយអ្នក ។
ខ្ញុំចង់បើកគណនេយ្យសែកមួយនៅធនាគារនេះ ។
ប្រពន្ធរបស់ខ្ញុំហើយនិងខ្ញុំត្រូវការបើកគណនេយ្យសន្សំរួមមួយ ។
តើអ្នកបំពេញទំរង់បែបបទទាំងនេះបានទេ ?
ប្រាកដថា ។ នេះសំរាប់អ្នក ។ តើនេះត្រឹមត្រូវទេ ?
តើអ្នកបានភ្ជាប់នូវប័ណ្ណសំគាល់ខ្លួនណាមកជាមួយទេ ? ប័ណ្ណបើកបរ ឬលិខិតឆ្លងដែន ឬប័ណ្ណឥណទាន ជាមួយរូបថតនិងហត្ថលេខាទេ ?
តើចំនួនលុយប៉ុន្មានអ្នកចង់ផ្ញើនៅក្នុងគណនេយ្យរបស់អ្នកថ្ងៃនេះ ? មួយរយដុល្លារគឺជាចំនួនកក់ទាបបំផុត សំរាប់បើកគណនេយ្យសន្សំមួយ ។
យើងរីករាយនឹងធ្វើការងារជាមួយអ្នក ទោះបីជាអ្នកត្រូវការសេកវាកម្មរបស់ពួកយើងនៅពេលណាក៏ដោយ ។ យើងក៏មានផ្នែកកម្ចីបុគ្គល សម្រាប់ផ្តល់សេវាកម្មអោយអ្នកដែរ ។
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបសរសេរសែកមួយបានទេ ?
ប័ណ្ណបើកបរ ឬលិខិតឆ្លងដែន ឬកាតឥណទាន ភ្ជាប់ជាមួយរូបថតរបស់អ្នកនិងហត្ថលេខា ?
តើចំនួនលុយប៉ុន្មានដែលអ្នកចង់ដាក់នៅក្នុងគណនេយ្យរបស់អ្នកថ្ងៃនេះ ?
មួយរយផោនគឺជាចំនួនកក់ដែលអប្បរមា ដើម្បីបើកគណនេយ្យបញ្ញើរមួយ ។
តើខ្ញុំអាចទទួលសៀវភៅសែកផ្ទាល់ខ្លួននៅពេលណា ?
ហេតុអ្វីបានជាអ្នកមិនអាចរៀបការបញ្ជាប្រាក់នេះបាន ?
សូមអភ័យទោស ប៉ុន្តែនោះគឺជាគោលនយោបាយរបស់យើង ។ ពួកយើងមិនអាចយកសែកអ្នកទីបីបានទេ ។
ខ្ញុំខ្លាចថាគណនេយ្យសែករបស់អ្នកប្រើហួសកំនត់ ។
ខ្ញុំសុំអភ័យទោស ប៉ុន្តែសែករបស់អ្នកត្រូវបានបញ្ជូនត្រលប់មកវិញ ។
ខ្ញុំត្រូវការផ្ញើសែកនេះក្នុងគណនេយ្យរបស់ខ្ញុំ ។
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបបង្កើតសែកមួយបានទេ ?
តើខ្ញុំអាចបានសៀវភៅប្រាក់សន្សំនៅពេលណា ?
ហេតុអ្វីអ្នកមិនអាចបើកលុយតាមការបញ្ជាប្រាក់នេះបាន ?
ខ្ញុំខ្លាចថាគណនេយ្យសែករបស់អ្នកអត់មានលុយគ្រប់គ្រាន់ ។
ខ្ញុំរំពឹងថាមានប្រាក់ខ្លះផ្ញើពីទីក្រុងតូក្យូ ។ តើវាបានមកដល់ហើយឬនៅ ? វាគួរតែថាគេបានកាត់លុយពីគណនេយ្យរបស់ខ្ញុំរួចហើយ ។
តើអ្នកអាចបង្កើតមូលប្បទានប័ត្រធនាគារមួយទៅប្រទេសជប៉ុនបានទេ ?
ខ្ញុំត្រូវការដកពីររយផោនចេញពីគណនេយ្យរបស់ខ្ញុំ ។
សូមបំពេញប័ណ្ណប្រាក់កក់ ហើយយកវាទៅអោយបុគ្គលិកធនាគារ ជាមួយលុយរបស់អ្នក ។
តើនេះបានធ្វើមកត្រឹមត្រូវទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីចំនួនទឹកប្រាក់សរុបនៅក្នុងគណនេយ្យរបស់ខ្ញុំបានទេ ?
ខ្ញុំរំពឹងថាមានសារទូរលេខមួយផ្ទេរពីទីក្រុងតូក្យូ ។
តើអ្នកអាចធ្វើមូលប្បទានប័ត្រធនាគារមួយទៅប្រទេសជប៉ុនបានទេ ?
សូមបំពេញប័ណ្ណដកលុយ ហើយយកវាទៅអោយបុគ្គលិកធនាគារ ជាមួយលុយរបស់អ្នក ។
តើអ្នកអាចអាប់ដេតសៀវភៅធនាគាររបស់ខ្ញុំបានទេ ?
ខ្ញុំត្រូវការបិទគណនេយ្យរបស់ខ្ញុំ ។
តើអ្នកអាចជួយដកលុយដោយប្រើសែកអ្នកទេសចរណ៍នេះ ចំនួនបីរយដុល្លារបានទេ ?
តើអ្នកអាចយកលុយតាមបញ្ជាប្រាក់នេះបានទេ ?
ពួកយើងត្រូវការប័ណ្ណសំគាល់ខ្លួនទាំងបីនេះ ។
តើអ្នកមានប័ណ្ណសំគាល់ខ្លួនខ្លះ ភ្ជាប់ជាមួយរូបថតរបស់អ្នកទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំរបាយការណ៍គណនេយ្យរបស់ខ្ញុំបានទេ ?
ខ្ញុំត្រូវតែបិទគណនេយ្យរបស់ខ្ញុំ ។
តើអ្នកអាចជួយដកលុយពីសែកអ្នកទេសចរណ៍ ចំនួនបីរយដុល្លារបានទេ ?
តើអ្នកមានប័ណ្ណសំគាល់ខ្លួនដែលមានរូបថតទេ ?
តើអ្នកចង់ដកលុយយ៉ាងដូចម្តេច ?
សូមអោយ ក្រដាសដប់ ហើយនៅសល់ជាលុយរាយ ។
សូមអោយ ក្រដាសហាសិបចំនួនមួយសន្លឹក ក្រដាសម្ភៃចំនួនប្រាំសន្លឹក ក្រដាសដប់ចំនួនដប់សន្លឹក ។
តើអ្នកអាចប្ដូរលុយយេនជប៉ុនទៅលុយដុល្លារអាមេរិកបានទេ ?
តើអ្នកអាចដូរលុយប្រាំរយដុល្លារ ទៅជាលុយហ្វ្រង់បារាំង បានទេ ?
តើអាត្រាដូរលុយដុល្លារអាមេរិកទៅលុយយ៉េនជប៉ុនថ្ងៃនេះប៉ុន្មានដែរ ?
តើអ្នកដូរលុយប្រាំរយដុល្លារ ទៅលុយហ្វ្រង់បារាំងអោយខ្ញុំបានទេ ?
តើលុយផោនថ្លៃប៉ុន្មានដែរថ្ងៃនេះ ?
តើលុយផោនល្អប៉ុណ្ណាដែរថ្ងៃនេះ ?
ខ្ញុំចង់អោយអ្នកមកដោយប្រើគ្រប់មធ្យោបាយទាំងអស់ ។
ខ្ញុំចង់ជួបតួសំដែងប្រុសនោះណាស់ ។
ខ្ញុំកំពុងស្រវឹងស្រាជោគជាំហើយ ។
ខ្ញុំមានអារម្មណ៍ថាទៅវិញជិះតាក់ស៊ី ជាជាងឡានក្រុង ។
ខ្ញុំពេញចិត្តទៅជាមួយអ្នក ។
ខ្ញុំត្រូវការព័ត៌មានខ្លះអំពីរឿងនេះ ។
ខ្ញុំចង់ជួបតួប្រុសនោះខ្លាំងណាស់ ។
ខ្ញុំរំជើបរំជួលចង់ជួបតួប្រុសនោះខ្លាំងណាស់ ។
អរុណសួស្តី ។ ភ្នាក់ងារធានារ៉ាប់រង់អាយុជីវិត ឡ៉ាវសេវឺ ។
អរុណសួស្តី ។ ខ្ញុំត្រូវការព័ត៌មានខ្លះៗ អំពីការសេវាធានារ៉ាប់រងរបស់អ្នក ។ តើអ្នកអាចផ្ញើកូនសៀវភៅបង្ហាញពីសេវាធានាវ៉ាប់រងដែលអ្នកផ្តល់ បានទេ ?
សូមអោយឈ្មោះនិងអាសយដ្ឋានរបស់អ្នក បានទេ ?
ខ្ញុំចាប់អារម្មណ៍ក្នុងការធានារ៉ាប់រងឧប្បទ្ទវហេតុ ។ តើអ្នកអាចផ្ញើព័ត៌មានអោយបានច្បាស់អំពីវាមកខ្ញុំបានទេ ?
ខ្ញុំគិតថាខ្ញុំត្រូវការយកការធានារ៉ាប់រងលើគ្រឿងសង្ហារឹម ហើយនិងការខូចខាតដែលអាចកើតមាន ។ តើអ្នកអាចផ្តល់ការធានារ៉ាប់រងដូចនេះអោយខ្ញុំបានទេ ?
បាទ ខ្ញុំត្រូវការធានាវា ។
ខ្ញុំបានឃើញការផ្សាយឃោសនារបស់អ្នកក្នុង សាន់ហ្វ្រាន់ស៊ីស្កូ ក្រូនីខល នៅថ្ងៃអង្គារ ទីម្ភៃបី ។
ខ្ញុំត្រូវការកាតាឡុកបញ្ចុះតម្លៃស៊ីឌីរបស់អ្នក ។
ខ្ញុំបានឃើញការផ្សាយឃោសនារបស់អ្នកនៅលើទូរទស្សន៍ ក្នុងពាណិជ្ជកម្មស៊ីប៊ីអេសមួយ ។
តើនៅក្នុងពិភពលោកមានអ្វីកើតឡើង ?
តើខ្ញុំអាចមើលប័ណ្ណបើកបរនិងការចុះបញ្ជីរឡានរបស់អ្នកបានទេ ?
សូមប្រាប់ខ្ញុំពីអ្វីដែលបានកើតឡើងពិតប្រាកដ ?
ខ្ញុំទើបតែមានគ្រោះថ្នាក់មួយ ។
ខ្ញុំគឺបាននៅក្នុងគ្រោះថ្នាក់ឡានមួយ ។
តើនៅលើផែនដីមានអ្វីបានកើតឡើង ?
តើមានបញ្ហាអ្វី ?
តើមានរឿងរ៉ាវអ្វី ?
មានមនុស្សម្នាក់វាយឡានរបស់ខ្ញុំ កំឡុងពេលដែលខ្ញុំចតឡាន ។
តើមានសាក្សីដែរទេ ?
ស្ត្រីម្នាក់បានរត់ចូលទៅឡានរបស់ខ្ញុំ ហើយបានបើកចេញទៅហាក់ដូចគ្មានអ្វីបានកើតឡើង ។
អ្នកគួរតែរាយការណ៍ទៅប៉ូលីស ហើយនិងក្រុមហ៊ុនធានារ៉ាប់រងរបស់អ្នក ។
តើឡានរបស់អ្នកមានធានារ៉ាប់រងដែរទេ ? អ្នកគួរតែដឹងច្បាស់ពីឆ្នាំផលិតនិងម៉ូដរបស់ឡាន ដូចជាហុងដា អាខ្ចួរ៉ា កៅសិបពីរ ហើយនិងលេខប័ណ្ណបើកបររបស់អ្នក ។
អ្នកឃើញទេ ខ្ញុំកំពុងមកតាមផ្លូវប្រសព្វគ្នា នៅពេលសុភាពបុរសរូបនេះបានញុលចេញមកខាងមុខខ្ញុំ ហើយពួកយើងក៏បានប៉ះគ្នា ។
អ្នកគួរតែរាយការណ៍វាទៅប៉ូលីស ហើយនិងក្រុមហ៊ុនធានារ៉ាប់រងរបស់អ្នក ។
អ្នកឃើញទេ ខ្ញុំកំពុងមកតាមផ្លូវប្រសព្វគ្នា នៅពេលនារីម្នាក់នេះបានញុលចេញមកខាងមុខខ្ញុំ ហើយពួកយើងក៏បានប៉ះគ្នា ។
ខ្ញុំប្រាកដថា សុភាពបុរសម្នាក់នេះមកលឿនពេក ធ្វើអោយមិនអាចឈប់ទាន់ពេល ។
ខ្ញុំនៅលើផ្លូវត្រូវ ។
តើអ្នកមិនឈប់នៅត្រង់ផ្លូវកាត់គ្នាទេ ?
ខ្ញុំជឿជាក់សុភាពបុរសនេះគួរតែឈប់ពេលនោះ ។
តើខ្ញុំពិតជាបើកលឿនហួសកំណត់ឫ ?
តើខ្ញុំអាចជួយខ្លះបានទេ ?
ខ្ញុំគឺច្បាស់ថាមានបុរស សុភាពម្នាក់គឺនិងទៅលឿនបំផុតសំដៅទៅឈប់នៅពេលនោះ ។
ខ្ញុំគឺច្បាស់ថាស្ត្រីម្នាក់និងទៅលឿនបំផុតសំដៅទៅឈប់នៅពេលនោះ ។
ខ្ញុំគឺច្បាស់ថាស្ត្រីម្នាក់និងទៅលឿនបំផុតសំដៅទៅឈប់នៅពេលនោះ ។
តើអ្នកមិនឈប់នៅផ្លូវបែកជាបួនទេឫ ?
តើអ្នកមិនឈប់នៅឯផ្លូវបំបែកនោះទេឫ ?
ខ្ញុំជឿជាក់ស្ត្រីនោះគួរតែបានឈប់ ។
តើអ្នកជួយខ្ញុំបានទេ ? ខ្ញុំមានគ្រោះថ្នាក់មួយ ។
តើអ្នកនិងហៅប៉ូលីសឫ ?
ខ្ញុំនិងទៅហៅប៉ូលីសម្នាក់ ។
ប្រហែលជាខ្ញុំហៅឡានពេទ្យប្រសើរជាង ។
តើអ្នកនិងហៅឡានពេទ្យមួយឫ ?
តើអ្នកនិងហៅស្ថានីយអគ្គិភ័យ ឫ ?
ខ្ញុំនិងហៅជំនួយ ។
ទេ សូមកុំធ្វើប្អូនប្រុស ។ ខ្ញុំគឺយល់ព្រមហើយ ។
មិនមានអ្វីច្រើនធ្វើទេរហូតទៅដល់កន្លែងសង្រោះបន្ទាន់ ។
តើអ្នកមិនឈឺចាប់ទេឫចុះតើអ្នកវិញ ?
ខ្ញុំគិតថាខ្ញុំគឺគ្មានបញ្ហាទេ ។
ខ្ញុំគ្មានបញ្ហាទេប៉ុន្តែមានអ្នកផ្សេងឈឺចាប់តិចតួច ។
អ្នកគ្រាន់តែអង្គុយទីនេះខណៈពេលខ្ញុំប្រើទូរស័ព្ទ ។
មានតិចតួចសម្រាប់ធ្វើរហូតដល់កន្លែងសង្រោះបន្ទាន់ ។
ខ្ញុំគិតថាខ្ញុំសុខសប្យាយទេ ។
ខ្ញុំគិតថាខ្ញុំសុខសប្យាយទេ ។
ខ្ញុំគិតថាខ្ញុំមិនឈឺចាប់ទេ ។
ខ្ញុំគឺមិនអ៊ីទេប៉ុន្តែមានអ្នកផ្សេងដែលមានឈឺតិចតួច ។
ខ្ញុំគឺមិនអ៊ីទេប៉ុន្តែមានអ្នកផ្សេងដែលមានរបួសតិចតួច ។
ខ្ញុំគឺមិនអ៊ីទេប៉ុន្តែមានអ្នកផ្សេងដែលមានឈាមតិចតួច ។
អ្នកគ្រាន់តែអង្គុយទីនេះខណៈពេលខ្ញុំនិយាយទូរស័ព្ទ ។
អ្នកគ្រាន់តែអង្គុយទីនេះខណៈពេលខ្ញុំទៅប្រើទូរស័ព្ទ ។
អ្នកគឺចិត្តល្អណាស់ ។ ខ្ញុំមិនដឹងថាត្រូវធ្វើអ្វីទេ ។
អរគុណអ្នកហើយ ។ ខ្ញុំពឹតជាអស្ចារ្យ ។
ខ្ញុំសូមអភ័យទោស ។ វាជាកំហុសរបស់ខ្ញុំ ។
វាគឺជាកំហុសរបស់ខ្ញុំទាំងអស់ ។
សុំទោសខ្ញុំបានវាយអ្នក ។
តើពួកយើងមិនអាចស្ងៀមចំពោះរឿងនេះដោយខ្លួនយើងទេឫ ?
ខ្ញុំមិនគិតថាខ្ញុំគួរតែនិយាយគ្មានអ្វីទាំងអស់ឥលូវនេះ ។
ខ្ញុំកំពុងហៅមេធាវីរបស់ខ្ញុំ ។
ខ្ញុំនិងបានយកអ្នកទៅ ។
ខ្ញុំនិងអានពីកម្មសិទ្ធិរបស់អ្នក ។ តើអ្នកយល់ភាសាអង់គ្លេសទេ ?
មិនសូវល្អទេភ្នាក់ងារ ។ ខ្ញុំមិនឆ្លើយតបជាភាសារអង់គ្លេសបានទេ ។
ខ្ញុំនិងអោយសំបុត្រអ្នកមួយសន្លឹក ។
តើខ្ញុំគួរសរសេរអ្វីនៅក្នុងសំបុត្រ ?
សូមជួយនណារម្នាក់ ។
តើអ្នកនិងទៅរាយការណ៍នៅគយឫ ?
តើវានៅក្បែរកន្លែងប៉ូលីសឫ ?
តើអ្នកអាចទំនាក់ទំនងស្ថានកុងស៊ុលជប៉ុនបានទេ ?
ជាងភ្លើងសូមយកខ្ញុំទៅជួបប៉ូលីស ។ នេះគឺជាការសង្រោះបន្ទាន់មួយ ។
នរណាម្នាក់បានធ្វើអោយបែកបាក់ផ្ទះរបស់ខ្ញុំ ។
នរណាម្នាក់បានយកកាបូបរបស់ខ្ញុំហើយ ។
នរណាម្នាក់បានយកកាបូបរបស់ខ្ញុំទៅបាត់ហើយ ។
នរណាម្នាក់បានឆក់កាបូបរបស់ខ្ញុំ ។
ការត្រួតពិនិត្យផ្ទាល់របស់ខ្ញុំគឺត្រូវលួចបាត់ហើយ ។
ប័ណ្ណកាតរបស់ខ្ញុំគឺត្រូវបានគេលួច ។
នរណាបានទម្លុះចូលទៅក្នុងផ្ទះល្វែងរបស់យើង ។
នរណាបានទម្លុះចូលទៅក្នុងសណ្ឋាគាររបស់យើង ។
នរណាម្នាក់បានទម្លុះចូលឡានរបស់ខ្ញុំហើយម៉ាស៊ីនថតវីដេអូ ។
ខ្ញុំត្រូវការរាយការណ៍ចោរលួចកាបូប ។
វាបានកើតឡើងនៅឯសណ្ឋាគារមួយ ។
វាមើលទៅដូចជានៅក្នុងការងារមួយខ្ញុំគឺភ័យខ្លាច ។
អ្នកមិនបានប៉ៈអ្វីសោះអ្នកអញ្ជឹងឫ ?
តើអ្វីផ្សេងទៀតគឺបាត់ឫ ?
តើពួកគេបានធានាឫទេ ?
តើអ្នកអាចអោយខ្ញុំសុំថតចំលងរបាយការណ៍ឥលូវបានទេ ?
លិខិតឆ្លងដែនរបស់ខ្ញុំត្រូវបានគេលួចហើយដូច្នេះខ្ញុំត្រូវតែធ្វើសារជាថ្មី ។
ខ្ញុំត្រូវការរាយការណ៍ចោរលួចកាបូប ។
ខ្ញុំត្រូវការរាយការណ៍ពីការត្រួតពិនិត្យត្រូវបានគេលួចទៅ ។
តើខ្ញុំអាចថតចំលងរបាយការណ៍ឥលូវបានទេ ?
តើខ្ញុំអាចថតចំលងរបាយការណ៍ទីនេះឥលូវបានទេ ?
តើអ្នកអាចបញ្ឈប់ការឆែកឆេរខ្ញុំបានទេ ?
ខ្ញុំត្រូវទាក់ទងក្រុមហ៊ុនធានារបស់ខ្ញុំ ។
គំនិតអ្វីមួយ ។
តើអ្នកបានឃើញកូនសៀវភៅតូចរបស់ខ្ញុំទេ ?
តើអ្នកបានឃើញសៀវភៅកត់ត្រារបស់ខ្ញុំទេ ?
ខ្ញុំហាក់ដូចជាមិនអាចរកវាឃើញវាទេ ។
ខ្ញុំភ័យខ្លាច ខ្ញុំបានបាត់បញ្ជីអ្នកដំណើររបស់ខ្ញុំ ។
ខ្ញុំច្បាស់ថាបានទុកវានៅក្នុងហិបយួរ ។
កាបូបរបស់ខ្ញុំគឺបាត់ ។
ហិបយួររបស់ខ្ញុំគឺបាត់ ។
ហិបប្រាក់របស់ខ្ញុំគឺបាត់ ។
តើផ្ទះល្វែងដែលបាត់ហើយរកឃើញនៅឯណា ?
ខ្ញុំត្រូវការរាយលការណ៍បាត់សំបុត្រយន្តហោះរបស់ខ្ញុំ ។
ខ្ញុំត្រូវការរាយការណ៍បាត់ឯកសារសំខាន់ ។
តើអ្នកមានសំបុត្រថ្មីទេ ?
តើអ្នកគិតថាមានវិធីរកឃើញលុយរបស់ខ្ញុំមកវិញទេ ?
ខ្ញុំបានបាត់លិខិតឆ្លងដែន ។ ខ្ញុំត្រូវតែមានវាសារជាថ្មី ។
ខ្ញុំភ្លេចកាំមេរ៉ានៅលើប្រដាប់យួរទី៣ពេលល្ងាចពីរថភ្លើងប្រទេស Boston ។
អ្នកឃើញទេខ្ញុំបានចាកចេញពីបន្ទប់នៅពេលរសៀលហើយនោះពេលខ្ញុំត្រលប់មកវិញវ៉ាលីរបស់ខ្ញុំត្រូវបានបាត់ ។
ខ្ញុំបានភ្លេចក្រដាសនៅក្នុងស្រោមសំបុត្រប្រទេសភីលីពីននៅម៉ោង៧លើឡានក្រុងព្រឹកនេះ ។ ខ្ញុំឆ្ងល់ប្រសិនជាពួកគេដេក ។
តើ់អ្នកអាចឃើញទេប្រសិនជាវាបានដេក ?
វាមានតម្លៃខ្លាំណាស់សម្រាប់ខ្ញុំ ។
អ្នកឃើញទេខ្ញុំបានចាកចេញពីសណ្ឋាគារនៅពេលរសៀលហើយនោះពេលខ្ញុំត្រលប់មកវិញវ៉ាលីរបស់ខ្ញុំត្រូវបានបាត់ ។
តើមានអ្វីបានកើតឡើងចំពោះឡានរបស់អ្នក ?
តើអ្នកលឺសំលេងអ្វីមួយទេ ?
បាទនៅពេលខ្ញុំបើកបរខ្ញុំលឺសំលេងមួយ ។
ខ្ញុំគឺលំបាកតិចតួចជាមួយនិងឡាន ។
ឡានរបស់ខ្ញុំមិនឆេះទេ ។
បាទ នោពេលខ្ញុំបើកឡានខ្ញុំលឺសំលេងមួយ ។
បាទនៅពេលខ្ញុំប្ដូរលីបខ្ញុំលឺសំលេងមួយ ។
បាទនៅពេលខ្ញុំប្ដូរលីបខ្ញុំលឺសំលេងមួយ ។
បាទនៅពេលខ្ញុំបើកគ្រឿងកំដៅខ្ញុំលឺសំលេងមួយ ។
បាទនៅពេលខ្ញុំប្រើខ្យល់វាខ្ញុំលឺសំលេងមួយ ។
ខ្ញុំមានគ្រោះថ្នាក់ឡានមួយ ។
វាហាក់ដូចជាម៉ាស៊ីនមិនធ្វើការ ។
ខ្ញុំមិនងាចបញ្ជារម៉ាស៊ីនបានទេ ។
ម៉ាស៊ីនមិនដំណើរការណ៍ ។
មានបញ្ហាខូចនៅត្រង់ម៉ាស៊ីនរបស់ខ្ញុំ ។
ម៉ាស៊ីនរបស់ខ្ញុំហាក់ដូចជាមិនក្តៅ ។
ការខូចរបស់ខ្ញុំគឺមិនធ្វើការត្រឹមត្រូវ ។
ខ្ញុំអាចធ្វើឌុយភ្លើង ។
តើអ្នកត្រូវយកវាមកមើលឫ ?
វាហាក់ដូចជាប៉ូមមិនធ្វើការ ។
វាហាក់ដូចខ្សែពានកង្ហាមិនធ្វើការ ។
វាហាក់ដូចជាទ្វាបិទមិនធ្វើការ ។
វាហាក់ដូចជាបំពង់ផ្សែងមិនធ្វើការ ។
វាហាក់ដូចជាគ្រឿងយន្តមិនធ្វើការ ។
វាហាក់ដូចជារ៉ាឌីហ្សាទ័រមិនធ្វើការ ។
វាហាក់ដូចជាហ្វ្រាំងមិនធ្វើការ ។
វាហាក់ដូចជាលីបមិនធ្វើការ ។
តើអ្នកបានជួសជុលវាទេ ?
កន្សែរុំគឺខូច ។
អ្នកនិងបានដូរវា ។
ឡាននេះពិតជាត្រូវការជាងការរៀបចំពីបីទៅទៀត ។
វាត្រូវការជួសជុលឡើងវិញ ។
តើចម្ងាយប៉ុន្មានអ្នកបើកបរ ?
វាបើកបានប្រហែល៥០០០ម៉ាល ។
តើ់អ្នកមានឡាននេះរយៈពេលពេលប៉ុន្មាន ?
ឡាននេះប្រហែល៣ឆ្នាំហើយ ។
តើអ្នកទិញថ្មីឫ ?
ខ្ញុំបានទិញវាមួយទឹកពីអ្នកឈ្មួញ ។
ខ្ញុំប្រើឡាននេះជារៀងរាល់ថ្ងៃក្នុងជំនួញរបស់ខ្ញុំ ។
តើអ្នកអាចទុកពីបីថ្ងៃបានទេ ?
តើអ្នកអាចទុកឫជួសជុលឥលូវបានទេ ?
តើអ្នកមានឥណទានទេ ?
តើអ្នកអាចបញ្ជូនឡានដឹកទំនិញមកជួសជុលបានទេ ?
តើអ្នកមានឡានអោយខ្ជីទេ ?
តើអ្នកអាចអោយខ្ញុំប្រដាប់ទាញទៅស្ថានីយហ្គាសបន្ទាប់បានទេ ?
ខ្ញុំនឹងត្រួតពិនិត្យវាឥលូវនេះ ។
ខ្ញុំនឹងជួសជុលវាអោយលឿន ។
ល្អ ។ ខ្ញុំនិងត្រលប់មកម្តងទៀត ។
តើអ្នកអាចអោយខ្ញុំស្មានបានទេ ?
តើតម្លៃប៉ុន្មានសម្រាប់ការជួសជុល ?
តើអ្នកអាចស្មានតម្លៃមុននិងធ្វើបានទេ ?
ខ្ញុំនឹងត្រលប់មកវិញ ។
វាតម្លៃប្រហែល៣០០ដុល្លារសម្រាប់ការជួសជុល ។
អូរសំលាញ់ថ្លៃណាស់ ? តើអ្នកគិតថាមួយណាល្អទិញឡានថ្មីឫឡានមួយទឹក ?
សួស្តីតើអ្នកអាចបញ្ជូនមនុស្សជួសជុលម្នាក់បានទេ ?
តើអ្នកអាចជួសជុសឡាននេះបានទេ ?
តើអ្នកមានវារយៈពេលប៉ុន្មាន ?
ប្រដាប់កោរបុកមាត់របស់ខ្ញុំគឺខូច ។
ម៉ាស៊ីនបូមធូលីគឺខូច ។
ម៉ាស៊ីនដេរគឺខូច ។
មេដែកអគ្គិសនីគឺខូច ។
ការសែតចម្រៀងគឺខូច ។
តើអ្នកប្រើវារយៈពេលប៉ុន្មាន ?
ខ្ញុំបានប្រើវាតាំងតែរដូវរងារមកម្លះ ។
ល្អ ។ វាស្ថិតនៅក្រាមការធានា ។ នោះមានន័យថាវានិងមិនកំណត់តម្លៃផ្សេងលើកលែងតែការទូរសព្ទ ។
វាគឺរួចរាល់ហើយ ។
អរគុណអ្នកច្រើនហើយ ។ ខ្ញុំគឺជួយរំលែកច្រើនណាស់ ។ តើខ្ញុំជំពាក់អ្នកប៉ុន្មាន ?
នោះគឺជាការបន្ធូរបន្ថយមួយ ។
ចូរនិយាយអំពីកិច្ចសន្យាតើពួកយើងនិងធ្វើឫ ?
តើខ្ញុំអាចមើលកិច្ចសន្យារបស់អ្នកបានទេ ?
ដោយប្រាកដថា ។ តើមានរឿងអ្វីខុសជាមួយវា ?
ខ្ញុំត្រូវការពេលខ្លះអានវាបង្ហើយ ។
តើការរំលោភបំពានមានន័យអ្វីនៅទីនេះយ៉ាងពឹតប្រាកដទៅ ?
ខ្ញុំមិនមែនជាអ្នកសន្ទរកថាភាសារអង់គ្លេសទេហើយខ្ញុំមិនយល់ថាតើពាក្យនេះមានអត្តន័យអ្វីទេប្រសិនជានៅពេលវិនិឆ្ឆ័យនោះ ។
តើអ្នកគួរតែពន្យល់ផ្នែកនេះឫ ?
ខ្ញុំមានសំណួរមួយអំពីអត្តបទទីប្រាំបី ។
មានបញ្ហាមួយជាមួយអនុប្រយោគទី៣ ។
មុនពេលអ្នកចុះហត្ថលេខាលើកិច្ចសន្យានេះតើខ្ញុំអាចអះអាងរឿងពីបីបានទេ ?
តើអ្នកគួរតែប្រាប់ខ្ញុំពីរបៀបកបកស្រាយអត្តបទនេះជាភាសាអង់គ្លេសជាក់ស្តែងបានទេ ?
តើអត្តបទនេះមានន័យថាសំបុត្រអនុញ្ញាតិគឺគ្មានសុភាពបន្ទាប់ពីរយៈពេល២ឆ្នាំឫ ?
តើអ្នកត្រូវពន្យល់ត្រង់ៗមានន័យថាពាក្យនេះនៅទីនេះជាភាសាអង់គ្លេសឫ ?
តើអ្នកអាចផ្លាស់ប្ដូរពាក្យនៅអ្វីដែលអ្នកបាននិយាយទេ ?
នេះជាចំណុចសំខាន់មួយតោះរៀនម្តងទៀត ។
តោះពិភាក្សាជាពិស្តារនៃអត្តបទនេះម្តងទៀតដើម្បីជៀសវាងយល់ខុស ។
នៅមានចំណុចពីបីទៀតដែលខ្ញុំមិនយល់ច្បាស់លាស់ ។
តើចំណុចណាមួយអ្នកចង់សួរ ?
ខ្ញុំត្រូវតែគិតធ្វើពីរដងមុននិងធ្វើកិច្ចសន្យា ។
មេធាវីរបស់ខ្ញុំនិងសរសេរកិច្ចសន្យាមួយ ។
ខ្ញុំមិនអាចផ្តល់ចំលើយនៅពេលនេះបានទេ ។
នេះគឺជារឿងរ៉ាវដែលខ្ញុំត្រូវពិចារណា ។
តើអ្នកអោយខ្ញុំគិតវាល្អិតល្អន់ទេ ?
ខ្ញុំត្រូវគិតវាយ៉ាងល្អិតល្អន់ ។
មានចំណុចពីរបីដែលខ្ញុំមិនអាចទទួល ។
ខ្ញុំស្វែងរកកិច្ចព្រមព្រៀងនៃសំណងពិបាកណាស់ ។
តើអ្នកនិងមិនពិចារណាការសងនេះទេ ?
តើរយៈពេលប៉ុន្មានទើបកិច្ចសន្យាអស់សុពលភាព ?
ខ្ញុំមិនអាចផ្តល់ចំលើយនៅទីនេះហើយពេលនេះបានទេ ។
តើរយៈពេលប៉ុន្មានទើបយើងបង្កើតកិច្ចសន្យា ?
តើអ្នកយល់ព្រមទេប្រសិនបើពួកយើងធ្វើកិច្ចសន្យាមួយឆ្នាំទៅពីរឆ្នាំ ?
តើអ្នកអាចធ្វើវាសាជាថ្មីសម្រាប់ឆ្នាំផ្សេងទៀតបានទេ ?
កិច្ចសន្យានិងត្រូវធ្វើសារជាថ្មីជារៀងរាល់ឆ្នាំ ។
តើអ្នកគិតយ៉ាងម៉េចចំពោះកិច្ចសន្យានេះ ?
ខ្ញុំគឺភ័យខ្លាចខ្ញុំត្រូវតែយកកិច្ចសន្យានេះហើយរកមេធាវីសម្រាប់ឃ្លាំមើល ។
ពួកយើងត្រូវការពេលបន្តិចទៀតដើម្បីធ្វើកិច្ចសន្យា ។
មានចំណុចខ្លះខ្ញុំត្រូវការគិត ។
ទេ គ្មានដំណោះស្រាយទេខ្ញុំខ្លាចណាស់ ។
ខ្ញុំយល់ស្របគ្រប់គ្រាន់ចំណុចទាំងអស់ ។
ខ្ញុំគឺលះបង់ជាមួយឯកសារកិច្ចសន្យានេះ ។
តើនៅពេលណាពួកយើងអាចចុះហត្ថលេខាលើកិច្ចសន្យានេះ ?
ខ្ញុំអាចចុះហត្ថលេខាលើកិច្ចសន្យានេះបាន ។
ពួកយើងត្រូវការជាចាំបាច់ដើម្បីផ្លាស់ប្ដូរកិច្ចសន្យានេះទីនេះនៅទំព័រទី៥ ។
ចូរគ្រវីដៃនៅលើវា ។
ខ្ញុំបានស្វែងរកអគារមួយហើយ ។
បាទវានៅតែមានតម្លៃ ។ ប្រសិនបើអ្នកមកពួកយើងនិងបង្ហាញបន្ទប់ ។
ខ្ញុំកំពុងមើ់លស្វែងរកបន្ទប់គ្មានសេនាសនភ័ណ្ឌ ។
ខ្ញុំយល់ថាអ្នកមានផ្ទះល្វែងសម្រាប់ជួល ។
មិត្តរបស់ខ្ញុំម្នាក់បានប្រាប់ថាអ្នកមានបន្ទប់ទូលាយ ។
ខ្ញុំគឺបានប្រាប់អ្នកថាខ្ញុំនិងអ្នកណាម្នាក់យកចិត្តទុកដាក់នៅទីនេះ ។
តើផ្ទះល្វែងនេះសម្រាប់ចួលឫ ?
បាទ ខ្ញុំនិងមានបន្ទប់មួយទំនេរនៅ២សប្ដាហ៍ ។
តើខ្ញុំមើលបន្ទប់នោះបានទេ ?
តើបន្ទប់នេះល្អគ្រប់គ្រាន់ហើយឫនៅ ?
ខ្ញុំគិតថាវាល្អណាស់ ។
តើជួលថ្លៃប៉ុន្មាន ?
វាគឺ១០០ដុល្លារមួយខែបូកមួយខែហើយខែផ្សេងទៀតគឺមុខជំនួញកណ្តាល ។
១០០ផោនមួយសប្ដាហ៍សម្រាប់ការស្នាក់នៅនិងអាហារពេលព្រឹក ។
វាច្រើនណាស់សម្រាប់ខ្ញុំ ។
តើបន្ទប់នេះគួរអោយសប្បាយចិត្តទេ ?
តើបន្ទប់នេះរៀបរយឫ ?
តើបន្ទប់នេះយល់ព្រមទេ ?
អូរ វាគឺធំណាស់ ។
ខ្ញុំគិតថាវាស្អាតណាស់ ។
ខ្ញុំគិតថាវាស្អាតណាស់ ។
ខ្ញុំគិតថាវាស្អាតខ្លាំងណាស់ ។
ខ្ញុំគិតថាវាចង្អៀតណាស់ ។
ខ្ញុំគិតថាវាធំណាស់ ។
ខ្ញុំគិតថាវាធំណាស់ ។
ខ្ញុំគិតថាវាទំនើបណាស់ ។
ខ្ញុំគិតថាវាគ្រាន់តែល្អប៉ុណ្ណោះ ។
តើវារាប់ទាំងទឹក ភ្លើងមែនទេ ?
តើមានការសងជំងឺចិត្តផ្សេងទៀតទេ ?
តើការសម្រួលអ្វីនៃការសាងសង់គួរមាន ? តើមានបន្ទប់បោកគក់ដែរឫទេ ?
តើការតុបតែងអំពីអ្វី ? តើអ្នកលាបពណ៌បន្ទប់នៅពេលផ្លាស់ប្ដូរបន្ទប់ឫ ?
កិច្ចសន្យាពីរឆ្នាំពួកយើងផាត់ពណ៌ផ្ទះល្វែងទាំមូលនៅពណ៌ដែលអ្នកចង់បាន ។ ទោះបីជាយ៉ាងណាក៏ដោយកិច្ចសន្យាមួយឆ្នាំមិនមានការតុបតែងអ្វីឡើយ ។
១០០ផោនសម្រាប់ការស្នាក់នៅនិងការសិក្សា ។
តើរាប់បញ្ចូលទាំងពន្លឺនិងកំដៅឫ ?
តើមានម៉ាស៊ីនបោកខោអាវឫទេ ?
តើនោះមានប្រដាប់សំអាតនិងគ្រែឈើដែរឫទេ ? ។
តើមានអគ្គិសនី ហ្គាស និងទឹកដែរឫទេ ?
តើមានកន្លែងផ្ញើរឥវ៉ាន់មួយទេ ?
តើមានចន្លោះចតមួយទេ ?
តើមានអាងហែលទឹកទេ ?
តើពួកយើងធ្វើអ្វីនៅពេលមានបញ្ហា ?
ចូរទំនាក់ទំនងម្ចាស់ផ្ទះរបស់អ្នកមានបញ្ហាផ្សេងៗ ។
តើខ្ញុំអាចចំណាយថ្លៃផ្ទះជារៀងរាល់ខែតាមរបៀបណា ? តើថ្ងៃណាត្រូវបង់ ?
តើអ្នកមិនកូនទេឫចុះអ្នកវិញ ?
ពួកយើងបានអនុញ្ញាតិអោយក្មេងមួយចំនួន ។ ហើយពួកយើងពេញចិត្តមិនជក់បារី ។
តើខ្ញុំនិងធ្វើអ្វីនៅពេលមានបញ្ហា ?
អ្នកទៅជួបម្ចាស់ផ្ទះនៅពេលអ្នកមានបញ្ហាផ្សេងៗ ។
ចូរទំនាក់ទំនងប្រធានគ្រប់គ្រងរបស់អ្នកមានបញ្ហាផ្សេងៗ ។
ចូរទំនាក់នៅក្នុងបន្ទប់៥០១ ។
ចូរទំនាក់ទំនងប្រធានគ្រប់គ្រងរបស់អ្នកមានបញ្ហាផ្សេងៗ ។
ប្រសិនជាខ្ញុំសម្រេចចិត្តយកបន្ទប់តើភ្លាមៗខ្ញុំអាចផ្លាស់ប្ដូរបានទេ ?
ខ្ញុំត្រូវជជែក វាគឺប្រពន្ធដំបូងរបស់ខ្ញុំ ។
តើអ្នកចង់បានអ្វី ?
ប្រសិនបើអ្នកសម្រេចចិត្តយកបន្ទប់ តើភ្លាមៗនោះពួកយើងផ្លាស់ប្ដូរយ៉ាងដូចម្តេច ?
តើអ្នកចង់ធ្វើការប្រភេទអ្វីប្រសិនបើខ្ញុំស្នើអោយ ?
តើអាជីពរបស់អ្នកគឺអ្វីប្រសិនបើអ្នកមិនមានការស្នើររបស់ខ្ញុំ ?
តើអ្នកកំពុងធ្វើអ្វីនៅក្នុងរដ្ឋ ?
តើអ្នកបង្រៀននៅទីនេះឫ ?
តើអ្នកនៅទីនេះធ្វើជំនួញឫស្រាវជ្រាវ ?
ទេ ខ្ញុំសិក្សាពីរបៀបបង្រៀន ។
ខ្ញុំមិនធ្វើការទេ ។
ខ្ញុំមិនធ្វើការអ្វីទាំងអស់ ។
ខ្ញុំមិនត្រឹមតែនៅទីនេះសម្រាប់ការងារប៉ុណ្ណោះហើយបន្ទាប់ខ្ញុំនិងត្រលប់ទៅប្រទេសជប៉ុនវិញ ។
ខ្ញុំលឺថាអ្នកគឺជាអ្នកឆ្នៃម៉ូដ ។ វាគឺជាការងារគួរអោយចាប់អារម្មណ៍ ។
អូរ វាអាចពិបាកពេលខ្លះ ។
ទេ ខ្ញុំគ្រាន់តែជជែកពីវិសមកាលប៉ុណ្ណោះ ។
ទេខ្ញុំគឺដើរទស្សនាកំសាន្ត ។
អូរ វាអាចពិបាកពេលខ្លះ ។
ខ្ញុំគឺជាស្ត្រីជំនួញម្នាក់ ។
ខ្ញុំជាអ្នកលក់នៅហាង ។
ខ្ញុំជាអ្នកលក់មាស៊ីនរាយ ។
ខ្ញុំគឺជាអ្នកលក់ដូរ ។
ខ្ញុំគឺជានិយោជិកម្នាក់នៅធនាគារ ។
ខ្ញុំជា អ្នក សេដ្ឋកិច្ច ។
ខ្ញុំជាអ្នកបច្ចេកទេស ។
ខ្ញុំជាអ្នកបច្ចេកទេសអគ្គិសនី ។
ខ្ញុំជាអ្នកវិទ្យាសាស្ត្រ ។
ខ្ញុំជាស្ថាបត្យករ ។
ខ្ញុំជាមន្ត្រីរដ្ឋាភិបាល ។
ខ្ញុំជាអ្នក ការទូត ។
ខ្ញុំជាអ្នកអប់រំ ។
ខ្ញុំជាគ្រូបង្រៀន ។
ខ្ញុំជាសាស្ត្រាចារ្យ ។
ខ្ញុំជាអ្នកបកប្រែឯកសារ ។
ខ្ញុំជាអ្នកបកប្រែផ្ទាល់មាត់ ។
