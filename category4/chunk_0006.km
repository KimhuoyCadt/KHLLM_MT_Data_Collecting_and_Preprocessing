អ្នកមានន័យថាអ្នកមិនចង់សន្យាជាមួយពួកគេ ?
និយាយតាមត្រង់ទៅ ។
តើខ្ញុំអាចសុំលេខទូរស័ព្ទរបស់អ្នកបានទេ ?
ជាការពិតណាស់ ជាចំនួនបួន ប្រាំពីរ មួយ ប្រាំបួន បួន សូន្យ បី ។
សូមអនុញ្ញាតឱ្យខ្ញុំធ្វើឱ្យខ្ញុំច្បាស់ ។
ខ្ញុំជឿជាក់អ្នក ។
ត្រូវប្រាកដថាមក ។
កុំលាក់បំាងការអនុញ្ញាតឱ្យខ្ញុំដឹង ។
ខ្ញុំនឹងឱ្យអ្នកដឹងដោយគ្មានការធ្លាក់ ។
ខ្ញុំនឹងចូលមកគ្រប់មធ្យោបាយ ។
តើកន្លែងណាខ្លះដែលអ្នកបានទៅ ?
តើមានអ្វីនៅក្នុងពិភពលោកនេះតើគាត់ថាមានន័យ ?
គ្រប់រឿងទំាងអស់ដែលខ្ញុំកំពុងស្វែងរក ។
ម្សិលមិញខ្ញុំមកទីនេះពីព្រោះតែនាង ។
តើអ្នកនឹងមកមើលយើងម្តងទៀត ។
ខ្ញុំនឹងមកម្តងទៀតគ្រប់មធ្យោបាយទាំងអស់ ។
តើអ្នកបានមើលនូវខ្សែភាពយន្តហើយឬនៅ ?
មិនទាន់ទេ ។ ប៉ុន្តែវាជាខ្សែភាពយន្តដែលខ្ញុំចង់ឃើញណាស់ ។
តើនរណាដែលបានរកឃើញរាឌីយូម ?
អ្នកស្រីគុយរី ។
ខ្ញុំព្យាយាម ប៉ុន្តែខ្ញុំមិនអាចសម្រេចក្តីសុបិនរបស់ខ្ញុំបាន ។
អូ មិនដែលបោះបង់ ។ ខ្ញុំព្យាយាមម្តងហើងម្តងទៀត ។
តើជាញឹកញាប់អ្នកទៅទីនោះប៉ុន្មានដង ?
ខ្ញុំជារឿយទៅទីនោះ ។
ខ្ញុំទៅទីនោះស្ទើគ្រប់ពេលទំាងអស់ ។
ខ្ញុំទៅទីនោះបីថ្ងៃ ។
ខ្ញុំទៅទីនោះស្ទើរពេញមួយអាទិត្យ ។
ខ្ញុំទៅទីនេះមួយឆ្នំា ។
ខ្ញុំមិនសូវទៅទីនោះ ។
ខ្ញុំមិនដែលទៅសោះ ។
ខ្ញុំទៅពីរដង ។
ខ្ញុំទៅទីនោះពីរពេល ។
ខ្ញុំទៅទីនោះបីពេល ។
ខ្ញុំទៅទីនោះបួនពេល ។
តើអ្នកមកទីនេះគ្រប់ពេលវេលា ?
បាទ ស្ទើតែរាល់ថ្ងៃ ។
តើប៉ុន្មានអ្នកទៅធ្វើអាជីវកម្មនៅអ៊ឺរ៉ុប ?
ស្ទើតែគ្រប់គ្រាន់រាល់ខែ ។
បាទ ខ្ញុំសរសេរសំបុត្រទៅពួកគេគ្រប់គ្នារាល់អាទិត្យ ។
ល្អណាស់ ជាធម្មតារាល់ខែ ។
រាល់ថ្ងៃបីម្តង មិនជារឿយៗទេ ។
ខ្ញុំចូលចិត្តកាហ្វេជាងទឹកតែ ។
ខ្ញុំចូលចិត្តទឹកតែជាងកាហ្វេ ។
ខ្ញុំចូលទឹកដោះគោ ។
ហ្វ្រាំងគឺចាស់ជាងជេន ។
ជេនគឺចាស់ដូចជាម៉ារី ។
ម៉ារីមិនចាស់ដូចជាហេនរី ។
អ្នកមានពេលបីដងសៀវភៅដូចជាខ្ញុំ ។
ស្ពាននេះគឺអំពីចំនួនពីរដងជាយូរមកហើយជាមួយនោះ ។
វាជាច្រើនផងដែរដោយពាក់កណ្តាល ។
ទីក្រុងអូសាកាគឺជាទីក្រុងធំបំផុតទីពីរក្នុងប្រទេសជប៉ុន ។
តើមួយណាដែលល្អបំផុតក្នុងរដូវកាលដែលអ្នកចូលចិត្ត ?
ខ្ញុំចូលចិត្តនិទាឃរដូវដ៏ល្អបំផុត ។
លោក ថមគឺខ្ពស់ជាងហ្វ្រេ ។
គោលនយោបាយដ៏ល្អបំផុតទីពីរគឺជាអ្វី ?
ខ្ញុំសុំទោស ។ ខ្ញុំមិនមានគំនិតតិចតួច ។
ខ្ញុំពិតជាចាស់ជាងឪពុករបស់អ្នកប្រាំពីរឆ្នាំ ។
អូ ពិតជា ? អ្នកមើលទៅវ័យក្មេងខ្លាំងណាស់សម្រាប់អាយុរបស់អ្នក ។
តើមួយណាដែលអ្នកចូលចិត្តចង្វាក់ហ្សាសឬតន្ត្រីបុរាណ ?
ខ្ញុំចូលចិត្តតន្ត្រីបុរាណប្រសើរ ។
ខ្ញុំជាន់ទីប្រំាពីរពុករបស់អ្នក ។
តើវាជានិមិត្តរូបជាអ្វី ?
តើអ្នកប្រកាសពាក្យនេះដោយរបៀបណា ?
តើខ្ញុំអាចមានប្រកបបានដែរឬទេ ?
ខ្ញុំមិនអាចទទួលនូវចំនុចរបស់អ្នក ។
ពេលណាបានជាខ្ញុំនិយាយ ?
អ្វីក៏ដោយដែលអ្នកព្យាយាមនិយាយ ?
អ្នកមានសៀវភៅអ្វីដែលអ្នកចូលចិត្ត ។
ខ្ញុំតែងតែតម្លៃមិនគិតលុយនៅថ្ងៃអាទិត្យ ។
ខ្ញុំមិនបានចាប់អ្នក ។
អ្នកនិយាយបន្តិចបន្ថែមទៀតដោយយឺតៗ ?
តើអ្នកអាចនិយាយឱ្យខ្លាំងជាងមុន ?
តើនេះជាដំណើរទស្សនកិច្ចលើកដំបូងរបស់អ្នកទៅកាន់ប្រទេសកាណាដា ?
ខ្ញុំពិតជាសោកស្តាយ ខ្ញុំមិនបានចាប់អ្នក ។
ខ្ញុំខ្លាច ខ្ញុំមិនទទួលអ្នកបាន ។ សូមនិយាយបន្តិចបន្ថែមទៀតដោយយឺត ?
បាទ ជាការពិត ។ ខ្ញុំនឹងព្យាយាមនិយាយយឺតតាមដែលអាចធ្វើទៅបាន ។
ត្រឡប់ទៅខាងស្ដាំនៅឯជ្រុងទីពីរ ។
សុំទោស ខ្ញុំមិនបានឮអ្នកច្បាស់ ។ សូមអ្នកនិយាយខ្លាំងបន្តិច ?
សូមបត់ស្តាំនៅហើយនៅកាច់ជ្រុងទីពីរ ។
ត្រឡប់ទៅខាងស្តាំ នៅកាច់ជ្រុងទីពីរ ។
តើខ្ញុំអាចឱ្យអ្នកនិយាយម្តងទៀតបានទេ ?
តើអ្នកប្រកបជាថ្មីម្តងទៀតបានទេ ?
បើអ្នកគ្មានបញ្ហាទេសូមជួយប្រកបម្តងទៀតបានទេ ?
អ្នកអាចធ្វើប្រកបឱ្យបានច្រើនដងបានដែរទេ ?
តើអ្វីទៅគឺជាថ្មីម្តងទៀត ?
សុំអ្នកដើរសុំការលើកលែងទោស ។
ឈ្មោះរបស់ខ្ញុំចន ប្រោន ។
តើអ្នកធ្វើការឱ្យធនាគារ ?
ពិតណាស់ ។ ខ្ញុំនិយាយ តើអ្នកស្គាល់លោក វ៉ាយ ?
មិនអីទេ ។ ខ្ញុំនឹងម្តងទៀត ។
សូមអ្នកស្តាប់្ញខ្ញុំពីរបីនាទិ ។
តើខ្ញុំអាចនិយាយយជាមួយអ្នកបានទេ ?
ខ្ញុំមិនចង់និយាយជាមួយអ្នកទេ ។
ពិតជាមានប្រសើរហើយនិងស្មោះត្រង់ ។
ពេលណាមកនិងដើម្បីនិយាយ អ្នកគឺជាអ្នកដែលពូកែនិយាយ ។
អូ ព្រះ ។ ខ្ញុំស្ទើតែសរសៃប្រសាទនៅឈរនៅទីនេះ និយាយទៅកាន់អ្នកចូលរួម ។
ហើយម្យ៉ាងទៀត នៅថ្ងៃសៅរ៍នេះអ្នកទំនេរ ?
និយាយអំពីផ្ទះ លោក ចេក ទើបនឹងទិញមួយថ្មីៗ ។
ប្រសើរណាស់ តើអ្នកគិតយ៉ាងម៉េចដែរ ? ខ្ញុំមានអារម្មណ៍រីករាយបានឭ ។
សុំទោសដែលរំខាន ។
សុំទោសសម្រាប់ការរំខាន ។
សុំទោសសម្រាប់ការរំខានអ្នក ។
ខ្ញុំមិនចង់រំខានអ្នក ប៉ុន្តែ ។
ខ្ញុំមិនងចង់ប្ដូរប្រធានបទបទទេ ប៉ុន្តែ ។
តើខ្ញុំអាចនិយាយបានទេ ?
ខ្ញុំសុំទោសរំខានអ្នក ប៉ុន្តែខ្ញុំខ្លាចខ្ញុំត្រូវតែធ្វើវា ។
តើអ្នកចាកចេញហើយឬ ? សូមស្នាក់នៅឱ្យបានយូរបន្តិច ។
ខ្ញុំថ្នាក់នៃការប្រគំដូរតន្ត្រីដែលគួរឱ្យល្អប្រសើរ ។
អូ នៅសល់ខ្ញុំ នៅទីនោះមានហាងកាហ្វេឆ្ងាញ់ និងមានការប្រគំតន្ត្រីក៏ពិរោះនៅជិតនេះ ។
ខ្ញុំមិនដូរប្រធានបទ ប៉ុន្តែយើងគួរពិភាក្សាដើម្បីដោះស្រាយបញ្ហានេះ ?
ប្រហែលម៉ោងបី ។
ម៉ោងបី ដប់នាទី ។
ម៉ោងដប់ លើលសាបសិបនាទី ។
ម៉ោងបី ដប់ប្រាំនាទី ។
ម៉ោងបីដប់ប្រាំនាទី ។
ជាការពិតម្ភៃនាទី និងម៉ោងបី លើសដប់នាទី ។
ជិតម៉ោងបីហើយ ។
ពេលណាយើងជួបគ្នាបាន ?
ចុះនៅម៉ោងប្រាំមួយ សាមសិបនាទី ។
ពេលណាលោកគ្រូបញ្ចប់ ?
បញ្ចប់នៅម៉ោងប្រំាបួន ។
តើសុំម៉ោងត្រឹមត្រូវបានទេ ?
ប្រហែលជាម្ភៃនាទីលើសបន្តិច ។
តើម៉ោងប៉ុន្មានដែលយើងទទួល ?
ចាប់ផ្តើមទទួលនៅម៉ោងមួយសាមសិបនាទី ។
តើអ្នកនៅផ្ទះទេថ្ងៃស្អែក ?
បាទ ខ្ញុំនៅផ្ទះរហូតដល់ពេលរសៀល ។
តើម៉ោងប៉ុន្មានដែលនាឡិកាបានប្រាប់ ?
សូមប្រាប់ខ្ញុំពីពេលវេលា ។
សុំទោស តើម៉ោងប៉ុន្មាននាឡិការបស់អ្នក ?
នាឡិការបស់ខ្ញុំម៉ោងបី សាមសិបនាទី ។ ប៉ុន្តែខ្ញុំខ្លាចថាប្រហែលជាលើសបីនាទី ។
វាជិតម៉ោងប្រាំហើយ ។
តើអ្នកម៉ោងដើរត្រឹមត្រូវទេ ?
ខ្ញុំសុំទោស នាឡិការបស់ខ្ញុំដើរទៀងណាស់ ។ ប៉ុន្តែខ្ញុំជឿវាខូចហើយ ។
ទើបតែម៉ោងប្រំាពីរ ។
ខ្លាចតែដើរយឺតបីនាទីប៉ុណ្ណោះ ។
ខ្ញុំបញ្ចប់នៅសាកលវិទ្យាល័យគូឡាំបៀរ៍នៅក្នុងឆ្នាំប្រាំបួនរយកៅសិបបួន ។
អូ ពិតឬ ? គួរឱ្យសរសើរណាស់ ។ ខ្ញុំក៏ចប់ពីសាកលវិទ្យាល័យគូឡាំបៀរ៍ដែរ ។
តើអ្នកដឹងទេលោកណាបូឡេអុងកើតថ្ងៃណា ?
ប្រសើរណាស់ ។ ខ្ញុំសុំឆ្លើយថាគាត់កើតខែសីហាថ្ងៃទីដប់ប្រំា ប្រំាពីររយហុកសិបប្រំាបួន ។
តើសង្រ្គាមលោកលើកទីពីរបញ្ចប់ ?
នៅឆ្នំាមួយពាន់បីរយសាបសិបប្រាំបី ។
តើថ្ងៃទីប៉ុន្មាន ?
តើខែនេះខែអ្វី ?
តើឆ្នំានេះឆ្នំាអ្វី ?
ថ្ងៃនេះថ្ងៃទីប្រំាពីរខែមិថុនា ។
នៅពេលដែលសន្និសិទអន្ដរជាតិដែលនឹងត្រូវបានប្រារព្វឡើង ?
ត្រូវបានប្រារព្វធ្វើនៅថ្ងៃសុក្រនេះបានម្ភៃបី ។
នៅពេលណាអ្នកនឹងចាកចេញទៅប្រទេសស្វ៊ីស ?
ថ្ងៃទីមួយខែក្រោយ ។
ថ្ងៃណានៅក្នុងអាទិត្យដែលនឹងចេញទៅ ?
ជាការប្រសើរណាស់ ខ្ញុំនឹងចេញនៅថ្ងៃពុធ ។ ជាសប្ដាហ៍ពីថ្ងៃពុធខាងមុខនេះ ។
ម៉ារីយ៉ានិងខ្ញុំនឹងទៅយកអ្នកនៅព្រលានយន្តនៅថ្ងៃនោះ ។
តើប្រជាជននៅទីក្រុងតូក្យូប៉ុន្មាននាក់ ?
ប្រហែលដប់លាននាក់ ។
តើហេរីអាយុប៉ុន្មាន ?
គាត់អាយុ ប្រំាពីឆ្នាំហើយ ។
ខ្ញុំមិនជឿទេ ។ ប៉ុន្តែទាយថាគាត់ប្រហែជាម្ភៃពីរឆ្នំា ។
តើភ្នំនេះកម្ពស់ប៉ុន្មានដែរ ?
ខ្ញុំខ្ពស់ប្រាំមួយហ្វីត ។
ខ្ញុំមានមួយពាន់យេន ។
ខ្ញុំគិតថាមិនត្រឹមត្រូវទេ ។
ខ្ញុំមិនគិតថាត្រឹមត្រូវ ។
តើក្រដាសយ៉ាងណាអ្នកយក ?
តើឡានប្រភេទអ្វីដែលអ្នកមាន ?
តើអ្នកគិតយ៉ាងម៉េចចំពោះសំណេរនេះ ?
ក្នុងចំណោមអ្នកនិពន្ធសម័យនោះតើអ្នកចូលចិត្តបានល្អបំផុត ?
តើអ្នកចូលចិត្តម្ហូបជប៉ុនទេ ?
តើអ្នកមានតើអ្វីដែលផែនការសម្រាប់ពេលអនាគតរបស់អ្នក ?
តើអ្នកទទួលយកនូវអ្វីដែលកាសែត ?
តើអ្នកជាវជាប្រចាំទៅនឹងអ្វីដែលក្រដាស ?
តើអ្នកជាវជាប្រចាំទៅនឹងអ្វីដែលកាសែត ?
តើអ្នកគិតពីអ្វីដែលអត្ថបទនេះ ?
ខ្ញុំគិតថាវាជាការគួរឱ្យចាប់អារម្មណ៍ខ្លាំងណាស់ ។
វាជារឿងដ៏អស្ចារ្យ ។
តើសៀវភៅប្រភេទណាដែលអ្នកអានជារឿយៗ ?
អូ សៀវភៅប្រភេទផ្សេងគ្នា ។ ប៉ុន្តែឥឡូវនេះខ្ញុំបានអានសៀវភៅប្រវត្តិសាស្ត្រ ។ តើធ្វើដូចម្តេច ?
ខ្ញុំពិតជាចូលទៅក្នុងផែនការដ៏កំបាំង ។
នាងនិយាយភាសាអង់គ្លេសបានយ៉ាងល្អ មិនអីចឹង ?
នាងមិនចេះនិយាយភាសាអង់គ្លេសបានល្អ មិនអីចឹង ?
ភាសាអង់គ្លេសរបស់នាងគឺមិនមែនល្អខ្លាំងណាស់ គឺមែនទេ ?
នាងជាអ្នកការទូតម្នាក់ មិនអីចឹង ?
គាត់បានបញ្ចប់វា មិនអីចឹង ?
ពួកគេបានបញ្ចប់វា ពួកគេអីចឹង ?
យើងចង់បញ្ចប់ឱ្យបានល្អជាងមុន អីចឹង ?
វាត្រជាក់ខ្លាំងណាស់នាពេលបច្ចុប្បន្ននេះ ត្រជាក់អឹមែន ?
អ្នកបានស្គាល់នាង អ្នកមែនទេ ?
បាទ ខ្ញុំស្គាល់នាងច្បាស់ណាស់ ។ នាងជាលេងវាយអូលីនដ៏ពូកែ ។
នៅទីនោះហាក់ដូចជាមិនសូវមានពេលច្រើនសោះ ទីនេះអីចឹង ?
យើងចង់បានឡានតាក់ស៊ីមួយ ។
នាងពូកែណាស់ នាងអីចឹង ?
បាទ នាងជាមនុស្សបរិសុទ្ធ ។
នាងជាមនុស្សល្អណាស់ នាងអីចឹង ?
គ្មាននរណាម្នាក់ដឹង ។
នៅពេលដែលខ្ញុំបាននិយាយថាដូច្នេះ ?
តើអ្នកណាដែលមិនបានស្គាល់គាត់ ?
អ្នករាល់គ្នាដឹងថាគាត់ ។
តើអ្នកណាដែលមិនអាចឆ្លើយនូវសំណួរមានភាពងាយស្រួលបាន ?
ពិតណាស់ ។ សូម្បីតែក្មេងតូចមួយក៏គ្មានបញ្ហាផង ។
នៅពេលដែលខ្ញុំបានធ្វើឱ្យសន្យា ?
ខ្ញុំពិតជាសោកស្តាយខ្លាំង ។ ដែលមានការយល់ច្រឡំលើផ្នែកមួយរបស់ខ្ញុំ ។
តើនរណាជាអ្នកនិយាយជំងឺរបស់នាង ? នាងនៅធម្មតាទេ ។
អូនាង ? ខ្ញុំជួបនាង នាងជាស្ត្រីដ៏អស្ចារ្យ ។
មនុស្សគ្រប់គ្នាអាចឆ្លើយនូវសំណួរងាយស្រួល ។
តើអាយុប៉ុន្មានហើយ ?
តើអ្នកចូលទៅដូចម្តេច ?
អរុណសួស្តី កញ្ញា ក្លើក ។ តើអ្នកសុខសប្បាយទេ ?
សាយ័ណ្ណសួស្តី ជេន ។ សុខសប្បាយទេ ?
ខ្ញុំមិនសូវមានអារម្មណ៍ល្អទេ ។ ខ្ញុំផ្តាសាយ ។
មិនល្អទេ ។ សូមបើកឡានឱ្យល្អដោយខ្លួនឯង ។
ខ្ញុំមិនបានឃើញអ្នកសម្រាប់ការមានអាយុ ។
វាមានអាយុពីចាប់តាំងពីយើងបានជួបគ្នាចុងក្រោយនេះ ។
តើអ្នកសុខសប្បាយជាទេ ?
ប្រសើរណាស់ដែលបានជួយអ្នកម្តងទៀត ។
ពិតជាចៃដន្យមែនដែលជួបអ្នកនៅទីនេះ ។
ជាការប្រសើរ មិនមែនជាប៊ីល ។ តើអ្វីជាការជួបប្រជុំចៃដន្យអ្នកនៅទីនេះ ។
អូ សួស្តី ចច ។ ខានជួបមុខគ្នាយូរហើយ មិនអីចឹង ? តើសុខសប្បាយទេ ?
ខ្ញុំសុខសប្បាយទេ អរគុណ ។ អ្នកមើលទៅស្រស់ស្រាយណាស់ ។
បាទ ខ្ញុំជាធម្មតាហើយទៅហើយ អរគុណ ។
រីករាយបានជួយអ្នកម្តងទៀត ។ អស់ពេលបីហើយមិនជួបគ្នាពេលចុងក្រោយ ។ តើគ្រួសាររបស់អ្នកសុខសប្បាយទេ ?
ពួកគេសុខាភាពមាំមួន អរគុណណាស់ ។
រីករាយបានជួបគ្នាម្តងទៀត ។
ខ្ញុំពិតជាបានល្អប្រសើរនៅតាមផ្លូវខ្ញុំ ។
ខ្ញុំគួរតែចាកចេញ ។
ខ្ញុំត្រូវតែចូលអោយចុះសំរុងពេលនេះ ។
ខ្ញុំសុំទោស ខ្ញុំត្រូវទៅហើយឥឡូវនេះ ។
បាន វាប្រហែលដល់ពេលដែលត្រូវចេញហើយ ខ្ញុំគិតដូចនេះ ។
ខ្ញុំសង្ឃឹមថាអ្នកនឹងមកលេងដល់កន្លែងរបស់ខ្ញុំ ។
ខ្ញុំសប្បាយចិត្តដែលអ្នករីករាយនឹងវា ។
ខ្ញុំរីករាយដែលអ្នកអាចមក ។
ខ្ញុំទាយថាខ្ញុំគួរចេញឥឡូវនេះហើយ ។
ខ្ញុំគិតថាខ្ញុំគួរចេញឥឡូវនេះហើយ ។
ខ្ញុំគិតថាខ្ញុំគួរចេញឥឡូវនេះហើយ ។
វាកាន់តែយឺតហើយ ។ ខ្ញុំគិតថាខ្ញុំត្រូវតែចាកចេញឥឡូវនេះ ។ សូមអរគុណសម្រាប់វេលាពេលល្ងាចដ៏អស្ចារ្យ ។
បាន ខ្ញុំសុំទោស ខ្ញុំត្រូវនិយាយជម្រាបលាពេលនេះហើយ ។
តើអ្នកមិនអាចស្នាក់នៅអោយបានយូរបន្តិចទៀតបានទេ ?
ខ្ញុំចង់ដែរ ប៉ុន្តែខ្ញុំសុំទោសខ្ញុំពិតជាត្រូវទៅហើយ ។ ខ្ញុំប្រហែលជាអាចខកជើងរថភ្លើងចុងក្រោយ ។ ខ្ញុំរីករាយដែលបាននិយាយជាមួយអ្នក ។
ខ្ញុំក៏អញ្ចឹងដែរ ។ សូមមកលេងខ្ញុំម្តងទៀតនាពេលឆាប់ៗផង ។
បាទ ខ្ញុំសប្បាយចិត្តនឹងមកម្តងទៀត ។
សូមមកលេងខ្ញុំម្តងទៀតឆាប់ៗនេះ ។
រាត្រីសួស្តី ហេឡេន ។
ខ្ញុំនឹងជួបអ្នកម្តងទៀត ។
ខ្ញុំរីករាយដែលបានជួបអ្នក ។
រីករាយដែលបានជួបអ្នកទៀត ។
រាត្រីសួស្តី ខេន ។ ខ្ញុំមានពេលដ៏អស្ចារ្យ ។
រាត្រីសួស្តី ហេឡេន ។ ជួបគ្នានៅថ្ងៃអាទិត្យ ។
រីករាយបានជួបអ្នកដែរ លោកផាខឺ ។
ឌីក ខ្ញុំរីករាយបានជួបអ្នក ។
ខ្ញុំសង្ឃឹមថាខ្ញុំនឹងបានជួបអ្នកម្តងទៀតឆាប់ៗ ។
មែនហើយ ចាំជួបឆាប់ៗ ។ ខ្ញុំនឹងទូរស័ព្ទទៅអ្នក អាទិត្យក្រោយ ។ យូរណាស់ ចន ។
សូមប្រាប់អោយគាត់ចំាខ្ញុំផង ។
សូមជួយនាំពាក្យជូនពររបស់ខ្ញុំដល់នាងផង ។
សូមជួយនាំពាក្យជូនពររបស់ខ្ញុំដល់ពួកគេផង ។
ម្តាយរបស់ខ្ញុំបានសុំអោយខ្ញុំនាំពាក្យជូនពរយ៉ាងកក់ក្តៅរបស់គាត់ ជូនទៅអ្នក ។
ខ្ញុំរីករាយ បើអ្នកអាចផ្តល់ការពិចារណាដ៏ល្អបំផុតរបស់អ្នក ទៅអោយនាង ។
ខ្ញុំរីករាយ បើអ្នកអាចមើលថែរក្សានាង ។
ខ្ញុំពិតជាមានពេលវេលារីករាយមួយនៅយប់នេះ ។
ខ្ញុំរីករាយដែលអ្នកបានធ្វើ ។ សូមជូនពរនូវភាពកក់ក្តៅដល់គ្រួសាររបស់អ្នក ។
អរគុណ ខ្ញុំនឹងប្រាប់ទៅពួកគាត់ ។ យើងសង្ឃឹមថាអ្នកនឹងមកកន្លែងរបស់យើងម្តងទៀតនៅពេលក្រោយ ។
បាទ ដោយគ្រប់មធ្យោបាយទំាងអស់ ។
ខ្ញុំរង់ចំាជួបអ្នកម្តងទៀត ។ ជម្រាបលោក កាវ៉ាកាមី ?
បាន ខ្ញុំនឹងប្រាប់គាត់ ។ សូមជួយជូនពរទៅលោកស្រី កាវ៉ាកាមី អោយខ្ញុំផង ។
ខ្ញុំរីករាយបានជួបអ្នកដែរ ។
ខ្ញុំពិតជារីករាយណាស់ ។
ខ្ញុំទន្ទឹមរង់ចំាអ្នកអស់ពេលជាយូរហើយ ។
ខ្ញុំធ្លាប់បានឮអំពីអ្នក ពីកញ្ញា អូកាវ៉ា ។
ខ្ញុំធ្លាប់បានឮអំពីអ្នកច្រើនណាស ពីកញ្ញា អូកាវ៉ា ។
ខ្ញុំធ្លាប់បានលឺរឿងដ៏អស្ចារ្យមួយអំពីអ្នក ពីកញ្ញា អូកាវ៉ា ។
ខ្ញុំរីករាយណាស់ លោកគ្រីន ។ ខ្ញុំបានឮអំពីអ្នកច្រើនណាស់ ពីលោកស្មីត ។
ខ្ញុំសង្ឃឹមវាជារឿងល្អ ។
បាទ ។ តើវាអាចទៅជាបែបណាទៅ ? អញ្ចឹង ខ្ញុំបានកំពុងរង់ចាំជួបអ្នកអស់រយៈពេលយូរមកហើយ ។ ខ្ញុំសង្ឃឹមថាអ្នកនឹងចាត់ទុកខ្ញុំជាមិត្តភ័ក្ត្រ ។
ខ្ញុំក៏សង្ឃឹមថាអ្នកចាត់ទុកខ្ញុំជាមិត្តភ័ក្ត្ររបស់ ។
តោះនាំគ្នាញុំាអាហារពេលល្ងាចនៅពេលណាមួយជាមួយគ្នា បានទេ ?
សូមអនុញ្ញាតិ្តអោយខ្ញុំណែនាំខ្លួនបន្តិច ។
តើអ្នកមិនថាអ្វីទេប្រសិនបើខ្ញុំណែនាំខ្លួនឯង ?
តើអ្នកអាចជួយណែនំាខ្ញុំអោយស្ត្រីម្នាក់នោះបានទេ ?
អ្នកមិនបានជួបលោកហ្ស៊ីមសុន ពីមុនទេ ។
ខ្ញុំចង់ណែនាំលោកហ្ស៊ីមសុន ទៅអ្នក ។
ខ្ញុំចង់អោយអ្នកជួបមិត្តរួមការងាររបស់ខ្ញុំ លោកសាតូ ។
លោកម៉ាសុន អនុញ្ញាតអោយខ្ញុំណែនំាមិត្តចាស់របស់ខ្ញុំ លោកអូស៊ីម៉ា ។ គាត់និងខ្ញុំបានរៀននៅសាកលវិទ្យាល័យជាមួយគ្នា ។ លោកអូស៊ីម៉ា នេះគឺលោកម៉ាសុន ។
ខ្ញុំរីករាយណាស់ដែលបានជួបអ្នក ។ លោកអូស៊ីម៉ា ។
ពិតជាសប្បាយរីករាយណាស់ដែលបានជួបអ្នក លោកម៉ាសុន ។
ខ្ញុំបានឮពីអ្នកជារឿយៗពីលោកសឹហ្សឹគី ។
ខ្ញុំស្គាល់អ្នកតាមរយៈឈ្មោះ ។ ខ្ញុំសង្ឃឹមថាយើងអាចក្លាយជាមិត្តភ័ក្ត្រ ។ សូមទទួលយកនាមប័ណ្ណរបស់ខ្ញុំ ។
ខ្ញុំសប្បាយចិត្តណាស់ដែលបានក្លាយជាអ្នកស្គាល់គ្នាជាមួយអ្នក លោកអូស៊ីម៉ា ។
ឈ្មោះរបស់ខ្ញុំស៊ីហ្សឹកា កូបាយ៉ាស៊ី ។
ខ្ញុំកើតនៅអូសាកា និងលូតធំធាត់នៅទីក្រុងតូក្យូ ។
ខ្ញុំជាកូនទោល ។
សាលារបស់ខ្ញុំគឺស្ថាប័នឯកជន ។
ជំនាញរបស់ខ្ញុំគឺផ្នែកសេដ្ឋកិច្ច ។
ខ្ញុំមានសញ្ញាប័ត្រថ្នាក់អនុបណ្ឌិតផ្នែកចិត្តវិទ្យា មកពីសាកលវិទ្យាល័យស៊ី នៅអាមេរិក ។
ខ្ញុំធ្វើការនៅក្នុងក្រុមហ៊ុនប៊ី ។
ចំណង់ចំណូលចិត្តរបស់ខ្ញុំគឺឡើងភ្នំ និងលេងព្យាណូ ។
ខ្ញុំរស់នៅជាយទីក្រុងតូក្យូ ។
សាលារៀនរបស់ខ្ញុំគឺជាស្ថាប័នរដ្ឋ ។
សាលារៀនរបស់ខ្ញុំគឺជាស្ថាប័នរដ្ឋាភិបាល ។
សាលារៀនខ្ញុំគឺជាស្ថាប័នខេត្ត ។
សាលារៀនខ្ញុំគឺជាស្ថាប័នក្រុង ។
តើអ្នកមានបងប្អូនប្រុសនិងស្រីដែរឬទេ ?
បាទ ខ្ញុំមា នបងប្អូនប្រុសម្នាក់ និងបងប្អូនស្រីពីរនាក់ ។ បងស្រីទំាងពីររបស់ខ្ញុំរៀបការរួចហើយ ។ ម្នាក់ជាគ្រូពេទ្យ និងម្នាក់ទៀតជាជាមេធាវី ។ ប្អូនប្រុសរបស់ខ្ញុំជានិស្សិតនៅសាកលវិទ្យាល័យខេ ។
តើអ្នកធ្វើការអោយក្រុមហ៊ុនប្រភេទអ្វីដែរ ?
ខ្ញុំធ្វើការអោយក្រុមហ៊ុនបោះពុម្ភ អិន ។
តើអ្វីដែលជាជំនាញរបស់អ្នក ?
បាទ ខ្ញុំចូលចិត្តគូរគំនូរប្រេង និងលេងតិន្នីស ។
រាល់ថ្ងៃកាន់តែកក់ក្តៅទៅៗហើយ ។
វាត្រជាក់ខ្លាំងណាស់នៅពេលនេះនៃឆ្នាំ មែនទេ ?
យើងឃើញមានភ្លៀងធ្លាក់ច្រើនណាស់សព្វថ្ងៃនេះ ។
អាកាសធាតុអាក្រក់ ។
ថ្ងៃអាក្រក់ណាស់ ។
វាក្តៅខ្លំាងណាស់ និងមានសំណើម មែនទេ ?
វាគឺជាថ្ងៃដ៏ល្អមែន មែនទេ ?
តើអ្នកគិតថាវានឹងប្រសើរទេនៅថ្ងៃស្អែក ?
បាទ ។ តាមការព្យាករណ៍អាកាសធាតុប្រចំាសប្ដាហ៍ វានឹងល្អប្រសើរក្នុងសប្ដាហ៍នេះ ។
តើថ្ងៃស្អែកអាកាសធាតុមិនដឹងយ៉ាងដែរ ?
តាមឧតុនិយមបានប្រាប់ថាថ្ងៃស្អែកមេឃពពកច្រើន និងមានពណ៌ផ្កាឈូក ។
តើអ្នកព្យាករណបុរសបាននិយាយអ្វីដែរ ?
គាត់និយាយថាល្ងាចនេះនឹងមានមេឃស្រឡះល្អ ។
សុំទោសអ្នកលោក អីវាន ?
អ្នកជួបលោក អីវាន នៅក្នុងឱកាសណាមួយឬ ?
ខ្ញុំឈ្មោះ តារូ តាណាកា មកពីក្រុមហ៊ុនទេសចរណ៍អេ ។
ខ្ញុំឈ្មោះ តារូ តាណាកា នៃក្រុមហ៊ុនទេសចរណ៍អេ ។
សូមស្វាគមន៍មកកាន់ប្រទេសជប៉ុន ។
រីករាយអ្នកនៅទីនេះ ។
ខ្ញុំនឹងអមដំណើរអ្នកទៅសណ្ឋាគារ ។
ខ្ញុំនឹងនាំអ្នកទៅសណ្ឋាគារ ។
ខ្ញុំត្រូវរង់ចាំរថយន្តមួយសម្រាប់យើង ។
ខ្ញុំនឹងរៀបចំសម្រាប់រថយន្តមួយ ។
សូមឱ្យខ្ញុំកាន់ថង់ទាំងនោះសម្រាប់អ្នក ។
សូមសម្រាកដោយភាពរីករាយនៅល្ងាចនេះ ។
សុំទោសលោក ។ អ្នកធ្លាប់លោក អីវ៉ាន់ នៅក្នុងឱកាសផ្សេងៗទេ ?
បាទខ្ញុំ ចន អីវ៉ាន់ មកពីវ៉ាស៊ីនតោន ។
សូមស្វាគមន៍មកជប៉ុនលោក អីវ៉ាន់ ។ ខ្ញុំឈ្មោះខេនជិ ណាកាណូ មកពីក្រុមកាត់ដេរ ។
អូអរគុណសម្រាប់ការមកជួបខ្ញុំ ។
សូមស្វាគមន៍ ។ ខ្ញុំជូនដំណើរអ្នកទៅសណ្ឋាគារ ។
អ្នកប្រហែលជាអស់កម្លំាងណាស់ហើយក្នុងការជិះយន្តហោះខ្ញុំទាញមើល ។
បាទខ្ញុំមិនសូវប៉ុន្មានទេ ។
សូមសម្រាកឱ្យបានសប្បាយនៅល្ងាចនេះ ។ ខ្ញុំសុំជួយកាន់មួយសម្រាប់អ្នក ។
ខ្ញុំចង់ឱ្យអ្នកធ្វើដំណើររីករាយ ។
ខ្ញុំជូនពរអ្នកធ្វើដំណើរសុវត្ថិភាព ។
ខ្ញុំសង្ឃឹមថាអ្នកធ្វើដំណើរដោយរីករាយ ។
អរគុណច្រើនណាស់សម្រាប់មកមើលខ្ញុំ ។
ខ្ញុំទន្ទឹងរង់ចំាជួបអ្នកម្តងទៀត ។
សូមកុំភ្លេចខ្ញុំសូមកត់ឈ្មោះខ្ញុំទុក ។
ជម្រាលានិងសំណាងទំាងអស់ ។
ជម្រាលានិងសំណាងល្អ ។
មិនអីទេ ។ នេះជាសំពាធខ្ញុំ ។
យើងអាចជួយគ្នាម្តងទៀតនៅថ្ងៃណាមួយ ។
អូខ្ញុំដូចគ្នា ។ ជាធម្មតាខ្ញុំមកទស្សនាទីក្រុងញូវយ៉កនៅឆ្នាំក្រោយអំពីការធ្វើជំនួញ ។
ប្រសិនបើអ្នកមកទីក្រុងញូវយ៉កសូមទូរសព្ទមកលេងខ្ញុំផង ។ ខ្ញុំនឹងរង់ចំាអ្នក ។
ពិតណាស់ ។ ខ្ញុំភ្ជាប់រកអ្នកនៅពេលខ្ញុំមកដល់ផ្ទះ ។ ជម្រាបលាលោក ណាហ្គាណូ ។
ជម្រាបលាលោកចន ។ សូមសំណាងល្អ ។
ខ្ញុំជូនពរមានសុភមង្គល ។
អបអរសាទរចំពោះការទទួលបានភាពជោគជ័យ ។
អនុញ្ញាតឱ្យខ្ញុំផ្តល់ជូនសូមអបអរសាទរ ។
សំណាងល្អមានដល់អ្នកទាំងពីរ ។
ភាពសប្យាយរីរាយនឹងមាននៅថ្ងៃនេះ ។
ជូនពរឆ្នាំថ្មី ។
ជូនពរសូមមានសុភមង្គល ។
រីករាយបុណ្យគ្រីស្តស្មាសអេមីល ។
អបអរសាទរដែលមានបុត្រ ។ តើគាត់ឈ្មោះអ្វីដែរ ?
គេឈ្មោះ ម៉ារិកូ ។
ជូនពរដល់ម៉ារិកូសូមអនាគតល្អ ។
អបអរសាទហេរី ។ ខ្ញុំបានឮថាអ្នកភ្ចាប់ពាក្យជាមួយចន ។
អរគុណ ។ តើអ្នកអញ្ជើញចូលរួមនូវមង្គលការបស់យើង ?
តើលក្ខខណ្ឌម្តាយរបស់អ្នកយ៉ាងម៉េចដែរ ?
សូមឱ្យអ្នកចាប់ជាសះស្បើយពីជម្ងឺឆាប់ៗ ។
ខ្ញុំជឿថាអ្នកនឹងស្វែងរកឃើញនៅក្នុងម៉ោងនេះ ។
ខ្ញុំសង្ឃឹមថាអ្នកបានធូស្បើយឆាប់ៗ ។
អ្នកមើលទៅដូរស្រស់បោះណាស់ ។
សូមជិះឡានដែលល្អសម្រាប់សុខភាព ។
ខ្ញុំសង្ឃឹមថាគ្មានអ្វីអាក្រក់ចំពោះជំងឺនេះទេ ។
ខ្ញុំមានការរន្ធត់ចិត្តណាស់ពេលឮអ្នកមានជំងឺ ។
អ្នកចិត្តណាស់ បានទូរសព្ទមកសួរសុខភាពរបស់ខ្ញុំ ។
មិនអីទេ ។ តើអ្នកមានអារម្មណ៍យ៉ាងណា ?
ខ្ញុំមានអារម្មណ៍ថានៅក្តៅបន្តិចប៉ុន្តែខ្ញុំមារម្មណ៍ធូរស្បើយជាងមុនបន្តិច ហើយដូចជាខឃ្លានបាយបនិ្តច ។
អូប្រសើរណាស់ ។ អ្នកមើលទៅដូចជាស្រស់ស្រាយណាស់ ។ ខ្ញុំសង្ឃឹមថាអ្នកឆាប់ជាលឿន ។
អរគុណខ្ញុំនឹងឆាប់ធូរស្បើយ ។
ខ្ញុំរីករាយបានឮដូច្នេះ ។ សូមថែរក្សាសុខភាពខ្លួនឯង ។
ខ្ញុំគោរពអ្នកស្រឡាញ់អ្នកយ៉ាងជ្រាលជ្រៅបំផុត ។
ខ្ញុំអាណិតអ្នកយ៉ាងក្រៃលេង ។
ខ្ញុំសង្ឃឹមថាអ្នកទទួលយកសមានចិត្តស្មោះនេះ ។
សូមទទួលយកនូវការអាណិតអាសូរដ៏ស្មោះរបស់ខ្ញុំ ។
សូមចូលរួមរំលែកទុក្ខយ៉ាងជ្រាលជ្រៅរបស់ខ្ញុំទៅម៉ារី ។
ខ្ញុំមានការសោកស្តាយបានឮថាអ្នកមានគ្រោះកាច ។
ខ្ញុំមានការរន្ធត់ចិត្តយ៉ាងខ្លាំងពេលឮថាឪពុករបស់អ្នកបានចែកឋានទៅ ។
ខ្ញុំពិតជានិយាយជាមួយនិងទុក្ខព្រួយ ។
សូមកុំធ្វើឱ្យបាក់ទឹកចិត្ត ។
ខ្ញុំមានការសោកស្តាយណាស់ឮថាបាត់បងឪពុក ។ សូមទទួលយកនូវភាពក្រៀមក្រំអំពីខ្ញុំ ។
អ្នកឯងចិត្តល្អណាស់លោក ផាកើ ។
វាធ្វើឱ្យអ្នកមានការតក់ស្លត់យ៉ាងខ្លំាង ។
ខ្ញុំមានការភ្ញាក់ផ្អើលយ៉ាងខ្លាំងពីការស្លាប់របស់លោកផងដែរ ។ ឪពុករបស់អ្នកជាមនុស្សដ៏អស្ចារ្យ ។ យើងបាត់បង់គាត់ហើយ ។ សូមកុំបាក់ទឹកចិត្តណា ។ ប្រសិនបើមានគឺជាអ្វីដែលយើងអាចធ្វើបានសម្រាប់អ្នក សូមប្រាប់ពួកខ្ញុំផង ។
អរគុណសម្រាប់សន្តានចិត្តរបស់អ្នក ។
សូមទទួលយកនូវការអាណិតរាប់អានអំពីខ្ញុំ ។
ខ្ញុំពិតមានចិត្តដក់ជាប់យ៉ាងជ្រៅទៅលើអ្នក ។
អរគុណជាអនេក ជីម ។
អ្នកអស្ចារ្យណាស់ក្នុងលសម្លៀកបំពាក់ ។
អរគុណ ។ ខ្ញុំពេញចិត្តយ៉ាងខ្លំាងពីរគំនិតរបស់អ្នកដោយស្មោះ ។
ខ្ញុំដក់ចិត្តយ៉ាងជ្រៅចំពោះអ្នកបានធ្វើគ្រប់យ៉ាងសម្រាប់ខ្ញុំ ។ ខ្ញុំមិនភ្លេចសន្តានចិត្តរបស់អ្នកជដូចជាការរស់នៅរបស់ខ្ញុំ ។
ខ្ញុំសង្ឃឹមថាអ្នកលើកលែងទោសឱ្យខ្ញុំ ។
ខ្ញុំពិតសូមទោសចំពោះអ្នកអំពីទង្វើរបស់ខ្ញុំ ។
សូមទទួលយកនូវការសុំទោសរបស់ខ្ញុំ ។
គ្មានអ្វីនឹងសុំទោសទំាងអស់ ។
អូ ខ្ញុំសូមទោសជាខ្លាំង ។
សុំទោសសម្រាប់អំមិញនេះ ។
ខ្ញុំគ្មានការបម្រុងប្រយ័ត្នសោះ ។ ខ្ញុំសង្ឃឹមថាអ្នកលើកលែងទោសឱ្យខ្ញុំ ។
ពិតណាស់ ។ គ្មានអ្វីទេ ។ ខ្ញុំមិនព្រួយបារម្ភអ្វីសោះ ។ ខ្ញុំសង្ឃឹមថាអ្នកមានបម្រុងប្រយ័ត្ននៅពេលក្រោយ ។
ខ្ញុំឱ្យសុំទោសនូវអ្វីដែលខ្ញុំបាននិយាយ ។ ខ្ញុំមិនមានន័យថាធ្វើឱ្យអ្នកឈឺចាប់នោះទេ ។
ខ្ញុំយល់ ។ សូមកុំសុំទោសអី ។ សូមគិតថាគ្មានអ្វីកើតឡើងចុះ ។
ខ្ញុំចង់អញ្ជើញអ្នកមកផ្ទះរបស់ខ្ញុំ ។
ខ្ញុំចង់អញ្ជើអ្នកមកញ៉ាំបាយល្ងាចនៅផ្ទះខ្ញុំ ។
តើអ្នកអាចមកពិសាបាយល្ងាចបានទេ ?
ខ្ញុំសង្ឃឹមប្រសិនបើអ្នក និងហើយគ្រួសារអ្នកមកចូលរួមពិធីជប់លៀង ។
ហេតុអ្វីអ្នកមិនមកជប់លៀងនៅកន្លែងរបស់ខ្ញុំ ?
តើមានពេលទំនេរចូលរួមពិសាអាហារពេលល្ងាចនៅថ្ងៃសុក្រពេលល្ងាចទេ ?
តើអ្នកអាចចូលរួមពិសាបាយថ្ងៃត្រង់ជាមួយយើង ?
សូមអញ្ជើញជាភ្ញៀវរបស់ខ្ញុំ ។
តើអ្នកអាចចេញទៅក្រៅសម្រាប់អាហារពេលល្ងាចនៅល្ងាចនេះ ?
យើងអញ្ជើញអ្នកសម្រាប់អាហារពេលល្ងាចសម្រាប់ស្អែកពេលល្ងាច ។
ហេតុអ្វីអ្នកមិនមកចូលរួមក្នុងពិធីជប់លៀងនៅផ្ទះខ្ញុំនៅថ្ងៃសុក្រអាទិត្យក្រោយ ?
ល្អណាស់ ។ ខ្ញុំក៏សោកស្តាយ ។
ពួកយើងមានពិធីជប់លៀងតូចមួយនៅផ្ទះរបស់ខ្ញុំនៅអាទិត្យក្រោយ ។ ខ្ញុំសង្ឃឹមថាអ្នកអាចមកជាមួយនិងគ្រួសាររបស់អ្នក ។
អូពួកយើងរីករាយណាស់ ។ អរគុណណាស់ដែលអញ្ជើញពួកខ្ញុំ ។
ខ្ញុំក៏អញ្ចឹងដែរប៉ុន្តែខ្ញុំខ្លាចមិនមានពេល ។
ខ្ញុំសង្ឃឹមអញ្ចឹងចុះប៉ុន្តែខ្ញុំមានរឿងត្រូវធ្វើនៅថ្ងៃនេះ ។
ខ្ញុំមានពិធីភ្ជាប់ពាក្យនៅថ្ងៃនេះ ។
ខ្ញុំអាចធ្វើវាពេលខ្លះនៅខែក្រោយ ។
តើយើងអាចផ្លាស់ប្ដូរទៅថ្ងៃផ្សេងៗបានទេ ?
ខ្ញុំឱ្យខ្ញុំនៅពេលផ្សេងៗ ។
សុំសួរខ្ញុំម្តងទៀតនៅពេលផ្សេងៗ ។
យើងមានពិធីជប់លៀងនៅថ្ងៃសៅរ៍ថ្ងៃទី១៥ ។ ប្រសិនបើអ្នកទំនេរយើងចង់ឱ្យអ្នកចូលរួមដែរ ។
ខ្ញុំសង្ឃឹមថាមានវត្តមានប៉ុន្តែខ្ញុំត្រូវទៅកូបេសម្រាប់ធ្វើអាជីវកម្មនៅថ្ងៃនោះ ។
តើអ្នកអាចមកចូលរួមពិធីជប់លៀងនៅថ្ងៃអាទិត្យនេះពេលល្ងាចបានទេ ?
ពិតណាស់ ។ ខ្ញុំសង្ឃឹមថាខ្ញុំនឹងចូលរួមនៅពេលក្រោយ ។
បាទយ៉ាងណាខ្ញុំនិងទៅ ។
រីករាយណាស់ដែលអ្នកមក ។
រីករាយណាស់ដែលអ្នកមកលេងពួកយើង ។
ខ្ញុំរីករាយដែលមានវត្តមានអ្នក ។
សូមមកខាងក្នុង ។
សូមដាក់ស្បែកជើងអ្នកនៅកន្លែងនេះ ។
ពួកយើងសូមគារវអ្នក ។
ខ្ញុំរីករាយចំពោះវត្តមានអ្នក ។
យើងរីករាយនិងក្រុមហ៊ុនរបស់អ្នក ។
សូមអញ្ជើញមកទីនេះម្តងទៀត ។
សូមប្រយ័ត្ននៅពេលធ្វើដំណើរទៅផ្ទះ ។
អូសាយណ្ណសួស្តី ។ រីករាយណាស់ដែលអ្នកមក ។ សូមអញ្ជើញមកខាងក្នុង ។
ខ្ញុំមានការធ្វេសប្រហែសហៅអ្នកអស់ពេលជាយូរ ។
នេះជាកំហុសខ្ញុំ ។ ខ្ញុំពិបាកនឹងរកអ្នកផ្សេងណាស់ ។
ខ្ញុំសង្ឃឹមថាខ្ញុំមិនរំខានអ្នក ។
អូអត់ទេ ។ យើងសប្បាយចិត្តណាស់ដែលអ្នកមក ។ សូមអញ្ជើញមកក្នុងបន្ទប់ទទួលភ្ញៀវ ។
សូមអញ្ជើញអង្គុយ និងទុកដូចជាផ្ទះរបស់អ្នក ។
សូមគិតថារំខានខ្លួនឯង ។
សូមកុំគិតទាស់ទែងចិត្តអ្វីណា ។
សូមពិសាតែខៀវ ។
តើខ្ញុំអាចសុំតែជាមួយក្រូចឆ្មាបានទេ ?
ខ្ញុំចង់បា នទឹកផ្លែឈើ ។
សុំស្ករមិនយកគ្មានគ្រីម ។
ខ្ញុំទឹកគ្មានគ្រីម ។
តើអ្នកមានពែងតែផ្សេងៗទេ ?
មួយណាដែលអ្នកពេញចិត្តទឹកតែខ្មៅ ឬកាហ្វេ ?
តើអ្នកចង់បានដែលនៅស្រស់ៗទេ ?
យើងញ៉ាំកូកាកូឡាទឹកខ្ញី និងទឹកទំពាំងបាយជូរ ។ តើអ្នកចូលចិត្តទេ ?
តើខ្ញុំអាចសុំទឹកទំពាំងបាយជូរបានទេ ?
ចុះកែវផ្សេងៗអំពីទឹកទំពាំងបាយជូរ ?
សូមជួយយកខ្លួនឯង ។
តើអ្នកចង់បាននូវសាច់ខ្លះទេ ?
នេះគឺមានរស់ជាតិឆ្ងាញ់ណាស់ ។
តើខ្ញុំអាចសុំបន្ថែមបន្តិចទៀតបានទេ ?
ខ្ញុំរំខានអ្នកជួយយកពែងកាហ្វេបន្តិច ?
ខ្ញុំរីករាយនឹងអាហារពេលល្ងាចណាស់ ។
នេះគឺប្រសើរណាស់ ។
តើអ្នកចូលចិត្តសាច់គោអាំងម្រេចទេ ?
បាទនេះជាចំណង់ចិត្តខ្ញុំ ។
អូប្រសើរណាស់ ។
ខ្ញុំចូលចិត្តដូចអ្នក ។ សូមបន្ថែមទៀត ។
បាទពិតណាស់ ។ ពិតជាឆ្ងាញ់ណាស់ ខ្ញុំហូបច្រើនណាស់ ។ ខ្ញុំពេញចិត្តអាហារពេលល្ងាចនេះណាស់ ។
នេះមកពីខ្ញុំ ។
តើអ្នកទទួលយកនូវការកោរសរសើរ និងអំណរគុណរបស់ខ្ញុំផង ?
ខ្ញុំមានកាដូខួបកំណើតសម្រាប់អ្នក ។
នេះគឺជាអ្វីដែលខ្ញុំចង់បាន ។
រីករាយថ្ងៃខួបកំណើត សាន់ត្រា ។
តើនេះជាអ្វី ខ្ញុំឆ្ងល់ណាស់ ?
អូអ្នកចិត្តល្អណាស់ និងមានគំនិតជ្រៅ ។ ខ្ញុំអាចបើកផ្លូវបានទេ ?
បាទសូមដើរទៅមុខ ។ ខ្ញុំសង្ឃឹមថា្នកធ្វើវា ។
របស់ខ្ញុំ ។ នាឡិកានេះស្អាត ។ ខ្ញុំចិត្តណាស់ ។ នេះគឺជាអ្វីដែលខ្ញុំចូលចិត្ត ។
អរគុណច្រើនជេន ។
នេះគឺជារបស់ដែលខ្ញុំចូលចិត្ត ។ ខ្ញុំសង្ឃឹមថាអ្នករីករាយ ។
នេះគឺទឹកតែដែលខ្ញុំចូលចិត្ត ។ ខ្ញុំនឹងព្យាយាម ។
អ្នកមិនទាន់បានធ្វើរួចទេ ។
សូមយកខ្លួនឯងនៅពេលក្រោយ ។
នេះជារបស់បន្តិចបន្តួច ។
សូមអញ្ជើញមកដោយគ្មានអ្វីមកជាមួយពេលក្រោយ ។
តើអ្នកអាចថតរូបជាមួយកាមេរ៉ានេះ ?
យើងអាចថតរូបជាមួយភ្នំហ្វូជី សម្រាប់ផ្ទៃខាងក្រោយ ?
សូមមេត្តាបើកចុច ។
តើអ្នកចង់បានទំហំពេញឬ ?
ភ្ជាប់មួយពីរបីនាទី ។
តើអ្នកអាចគេចទៅខាងស្តំាបន្តិចបានទេ ?
តើអ្នកដើរទៅមុខបន្តិចបានទេ ?
សូមងាកទៅខាងឆ្វេងបន្តិចបានទេ ?
តើអ្នកដើរទៅក្រោយបន្តិចបានទេ ?
ខ្ញុំសុំទោសរំខានអ្នកប៉ុន្តែសូមជួយថតរូបជាមួយកាមេរ៉ានេះបានទេ ?
សូមអ្នកបញ្ជូនទៅក្នុងរូបភាពបានទេ ?
មិនអីទេ ។ សូមជួយប្រាប់ខ្ញុំកាមេរ៉ានេះប្រើយ៉ាងណា ។
ពិតណាស់វាដោយស្វ័យប្រវត្ត ។ ដូច្នេះអ្វីទាំងអស់ដែលអ្នកត្រូវធ្វើគឺត្រូវចុចឱ្យលឿន ។
សូមស្វាគមន៍ ។ ខ្ញុំសង្ឃឹមថានឹងត្រឡប់វិញដោយសុវតិ្ថភាព ។
ខ្ញុំចង់ជួបលោក វីលស៊ុន ។
ខ្ញុំមានណាត់ជាមួយលោក វីលស៊ុន នៅម៉ោងបី ។
ខ្ញុំសង្ឃឹមថានិងបានជួបលោក វីលស៊ុន ។
តើខ្ញុំអាចជួបលោក ចន បន្តិចទៀតបានទេ ?
ខ្ញុំបានទូរសព្ទសម្រាប់ការណាត់ជួប ។
ខ្ញុំមិនមានការណាត់ប៉ុន្តែនេះប្រញាប់ណាស់ ។
ខ្ញុំចង់ណាត់ពេលឥឡូវនេះ ។
តើអ្នកអាចជួយខ្ញុំតែបន្តិចបានទេ ?
ខ្ញុំអាចនិយាយពីរបីនាទីជាមួយអ្នកបានទេ ?
ខ្ញុំ ហីដេអូ ណាកាម៉ុរ់ា នៃក្រុមហ៊ុនណីផនមកពីតូក្យូ ។ ខ្ញុំជួបលោក ប្រ៊ូវើ ។
បាទខ្ញុំទូរសព្ទនៅម៉ោងមួយសម្រាប់ការណាត់ ។
ចំាមួយភ្លេច ។ ខ្ញុំរំឭកលោក ប្រ៊ូវើ នៃការមកដល់របស់លោក ។ សុំទោសសូមចាំមួយភ្លេត ។ គាត់កំពុងជាប់ប្រជុំ ។ ប៉ុន្តែនឹងមកបន្តិចទៀតនេះ ។ សូមអញ្ជើញអង្គុយលោក ណាកាម៉ុរ៉ា ។
តើពេលណាអ្នកអាចមានភាពងាយស្រួលសម្រាប់អ្នក ?
នៅម៉ោងបីអ្នកអាចមានពេលដែរទេ ?
តើម៉ោងពីរ សាមសិបនាទីបានទេ ?
ចុះសម្រាប់ថ្ងៃពុធក្រោយនៅម៉ោងពីរយ៉ាងណាដែរ ?
តើពេលណាអ្នកមានពេលមកលេងខ្ញុំ ?
តើម៉ោងប៉ុន្មានខ្ញុំមក និងជួបលោក ?
ពេលផ្សេងៗទៀតអូខេ ។
ពេលផេ្សងទៀតនឹងធ្វើ ។
ចុះនៅថ្ងៃពុធក្រោយពេលរសៀលម៉ោងពីរយ៉ាងណាដែរ ?
កន្លែងណាដែលអ្នកធ្វើវា ?
នៅម៉ោងប្រំាមួយបានដែរទេ ?
ខ្ញុំនឹងមកយកអ្នកនៅម៉ោងប្រំាមួយពេលព្រឹក ។
ខ្ញុំសង្ឃឹមថានិងមានពេលជួបលោកអ្នកនៅថ្ងៃអង្គារ ។
បាទ ។ កន្លែងណាដែលអ្នកធ្វើវា ?
ពេលផ្សេងៗទៀតស្រួលសម្រាប់អ្នក ។
ខ្ញុំជួបលោកនៅម៉ោងប្រំានៅបន្ទប់ទទួលភ្ញៀវនៅសណ្ឋាគារអធិរាជប្រសិនបើស្រួល ។
ពេលផ្សេង បន្ទប់ពីរម៉ោងអាចជួបជាមួយខ្ញុំ ។
ម៉ោងផ្សេងៗទៀតរវាងម៉ោងពីរម៉ោងប្រាំខ្ញុំអាចមានពេល ។
សូមអញ្ជើញចូលមក ។
តើអ្នកច្បាស់ថានិងមកទេ ?
មកដោយគ្មានហេតុផល ។
សូមប្រាប់យើងផងពេលដែលអ្នកមិនបានមក ។
សូមទូរសព្ទយើងពេលអ្នកមិនមក ។
ខ្ញុំប្រហែលជាយឺតសាមសិបនាទី ។
ប្រហែលជាយឺតបន្តិច ។
តើយើងអាចពន្យារការណាត់យឺតបន្តិចបានទេ ?
យើងអាចធ្វើវានៅពេលផ្សេងទៀតបានទេ ?
ខ្ញុំសុំទោសផងប៉ុន្តែខ្ញុំមិនអាចមកបានទេ ។
អ្វីដែលប្រញាប់និងមកជាញឹកញាប់ ។
សេដ្ឋកិច្ចខ្លះមិនអាចកើតមានឡើង ។
ខ្ញុំធ្វើឱ្យល្អប្រសិនមកដល់ប៉ុន្តែខ្ញុំសុំទោសប្រសិនខ្ញុំមិនអាច ។
នៅជាន់ណា មន្ទីរពេទ្យធ្មេញ លោក យូអេណូ ?
តើផ្លូវមួយណាទៅការិយាល័យលោក ម៉ាស៊ុន ?
តើផ្លូវមួយណាខ្ញុំគួរទៅកន្លែងបោះពុម្ភផ្សាយ ?
តើអ្នកអាចប្រាប់ខ្ញុំបានទេតើបន្ទប់ទឹកនៅកន្លែងណា ?
តើអ្នកប្រាប់ខ្ញុំដោយផ្ទាល់ទៅហាងនាឡិការបានទេ ?
តើកន្លែងចេញទីណា ?
តើអ្នកអាចបង្ហាញខ្ញុំពីការិយាល័យ លោក យ៉ាម៉ាដា ?
តើផ្លូវចូលនៅកន្លែងណា ?
តើជាន់ទីប៉ុន្មានធ្វើការប្រជុំ ?
នៅតាមបញ្ចប់ថែវនេះនៅជាន់ទីប្រាំពីរ ។ សូមជិះជណ្តើរយន្តនៅខាងស្តាំ ។
តើខ្ញុំអាចរកកន្លែងបុគ្គលិកផ្ទាល់បាន ?
ពិតណាស់នៅទា្វរទីបីខាងឆ្វេង ។
តើផ្លូវមួយណាទៅការិយាល័យលោក ចនស៊ុន ?
នៅជាន់ទីបី ។ តើខ្ញុំអាចដើរផ្លូវបានទេ ?
ខ្ញុំជូនលោកទៅទីនោះ ។
តើឡាននោះទៅហ្សីបូយ៉ា ?
តើឡានមួយណាដែលលឿនចេញទៅក្យូតូ ?
តើរថភ្លើងមួយណាខ្ញុំអាចជិះទៅកាម៉ាគូរ៉ា ?
កន្លែងណាដែលរថភ្លើងទៅ ?
ប្ដូរទៅហ្សិនជូគុ ទៅយ៉ាម៉ាតេ ។
តើចតប៉ុន្មានពីនេះទៅយូត្យូយ៉ា ?
តើជារឿយៗឡាននៅចំណតតូក្យូរត់ ?
តើមានផ្លូវផ្សេងទៀតទេក្រៅពីតាក់ស៊ី ?
តើឡានដឹងជញ្ជូនឆាប់រហ័សមួយណាចេញទៅទីក្រុងក្យូតូ ?
ផ្ទេរពីហ្សិជូគុ ទៅយ៉ាម៉ាតេ ។
តើអ្នកអាចប្រាប់ខ្ញុំបានទេទៅវិចិត្រសារមន្ទីរដូចម្តេច ?
នៅទីនេះគ្មានចំណតឡានឈប់ទេ ។ ជិះឡានលេខដប់ និងឈប់នៅយូអេណូ ។
តើឡានពិសេសមួយណាដែលលឿនចេញទៅតូក្យូ ?
តើរថភ្លើងនេះឈប់នៅយូយូហ្គីទេ ?
អត់ទេមិនមានទេ ។ អ្នកចង់ដូររថភ្លើងប្រចំាតំបន់នៅចំណតបន្ទាប់ ។
សូមប្រាប់ខ្ញុំតើទៅសៃអីយូយ៉ាងណា ។
ជិះរថភ្លើងក្រោមដីទៅហ្សីនជូគុ បន្ទប់មកប្ដូរទៅអូដាក្យូ ។
តើផ្លូវហ្នឹងឈ្មោះអ្វី ?
ហារ៉ាជូគុឆ្ងាយពីនេះទេ ?
នៅជិតហីប៊ីយ៉ាផាត ?
ទៅដោយផ្ទាល់ទេ ?
បាទ, ខ្ញុំអាចជួយអ្នកបានទេ ?
អ្នកនៅលើផ្លូវបីរយប្រាំពីរ ។ តើកន្លែងណាដែលអ្នកចង់ទៅ ?
ខ្ញុំចង់ទៅសាលក្រុង ។ ទៅតាមផ្លូវនេះនំាខ្ញុំទៅបាន ?
អត់ទេអ្នកទៅតាមផ្លូវផ្ទុយនេះ ។ អ្នកប្រហែលត្រឡប់ទៅវិញ ។
ខ្ញុំហាក់ដូចជាបានបាត់បង់សត្វខ្លាឃ្មុំរបស់ខ្ញុំ ។ សូមបង្ហាញខ្ញុំដែលជាកន្លែងដែលខ្ញុំមាននៅលើផែនទីនេះ ។
ខ្ញុំយល់ ។ អរគុណសម្រាប់ជំនួយការរបស់អ្នក ។
ខ្ញុំចង់ទៅសាលាក្រុង ។ តើផ្លូវមួយណាដែលនំាខ្ញុំទៅបាន ។
តើផ្លូវនេះទៅណា ?
តើផ្លូវមួយណាទៅហ្សីនប៊ូយ៉ា ?
តើអ្នកអាចប្រាប់ដែលនៅជិតចំណតឡាន ?
តើខ្ញុំទៅសារមន្ទីយ៉ាងណា ?
តើផ្លូវនត្រឹមត្រូវទេទៅចំណតតូក្យូ ?
ខ្ញុំកំពុងរកមើលស្ថានជប៉ុន ។
តើមានផ្លូវកាត់ទៅចំណតឡានទេ ?
សុំទោសតើផ្លូវមួយណាទៅ អាកាសាកា ?
ខ្ញុំសុំទោសរំខានអ្នកប៉ុន្តែនេះផ្លូវទៅចំណតតូក្យមែនទេ ?
បាទមែនហើយ ។ ចំណតឡានតូក្យូប្រមាណពីរយម៉ែត្រចុះទៅតាមផ្លូវនេះ ។
ខ្ញុំសុំទោសរំខានអ្នកតើមានហាងទំទិញនៅជិតនេះទេ ?
បាទទីនេះ ។ អ្នកឃើញអគារពណ៌សនៃជាន់ទីប្រាំនៅទីនោះ ។ មិនអីចឹង ។
ខ្ញុំអរគុណច្រើនសម្រាប់សន្តានចិត្តរបស់អ្នក ។
នៅទីនោះជាទីស្នាក់ការឡានក្រុងមែនទេ ?
តើអ្នកអាចជួយគូរផែនទីចំណតរថភ្លើងក្រោមដីបានទេ ?
តើអ្នកអាចជូនខ្ញុំទៅហ្ស៊ីនជូគូ ហ្យូអេន ?
តើអ្នកអាចគូរផែនទីមួយទៅរថភ្លើងក្រោមដីអោយបានទេ ?
ខ្ញុំចង់ទៅសារមន្ទីរជាតិ ។ តើវាឆ្ងាយខ្លាំងទេពីទីនេះ ?
ទេ វាមិនចម្ងាយខ្លាំងទេ ។ វាអាចដើរទៅបាន ។
ខ្ញុំគិតថាដើរប្រហែលដប់នាទី ។
អ្នកអាចធ្វើបាន ប៉ុន្តែខ្ញុំគិតថាវានឹងត្រូវការពេលច្រើនជាងសែសិបនាទី ។ អ្នកគួរទៅដោយជិះរថយន្ដក្រុង ។
តើខ្ញុំអាចរកកន្លែងជិះឡានក្រុងបាននៅឯណា ?
វាគឺនៅម្តុំកាច់ជ្រុង ។ អ្នកមិនអាចឃើញវាទេ ។
ចូលទៅត្រង់តាមបណ្តោយផ្លូវនេះ ប្រហែលជាបីរយម៉ែត្រ ។
វាគឺប្រហែលជាបីប្លុកចុះតាមផ្លូវនេះ ។
វានៅបន្ទាប់នឹងធនាគារ ខាងឆ្វេង ។
វាគឺជាអាគារទីប្រាំរាប់ពីកាច់ជ្រុង ។
វាគឺនៅកន្លែងដែលឆ្លងផ្លូវ ពីផ្សារទំនើបមួយ ។
អ្នកបានចូលមកឆ្ងាយពេក ។
អ្នកវិលត្រឡប់ទៅវិញរហូតដល់ស្ពាន ។
អ្នកមកខុសផ្លូវហើយ ។
សុំទោស ប៉ុន្តែតើអ្នកអាចប្រាប់ខ្ញុំពីផ្លូវទីរោងសិល្បៈរ៉ូយ៉ាល់ទេ ?
ត្រូវហើយ ។ ទៅត្រង់តាមបណ្តោយផ្លូវនេះ និងបត់ស្តាំនៅឯកាច់ជ្រុងទីបី ។ វានៅប្លុកទីប្រាំពីរ ខាងឆ្វេងដៃរបស់អ្នក ។
អត់ទោស តែខ្ញុំកំពុងតែរកសណ្ឋាគារខេ ។
តើអ្នកឃើញភ្លើងចរាចរណ៍នៅខាងនោះទេ ?
ឆ្លងតាមផ្លូវទីនោះ ហើយទៅត្រង់រហូតដល់អ្នកជួបចំនុចប្រសព្វទីពីរ ។ សណ្ឋាគារខេ គឺនៅពីក្រោយចំនុចប្រសព្វហ្នឹង ។
ខ្ញុំសុំទោស ប៉ុន្តែខ្ញុំដូចជាមនុស្សចំលែកសំរាប់ម្តុំនេះអញ្ចឹង ។
ខ្ញុំសូមសួរគាត់នៅទីនោះ ។
ខ្ញុំនឹងនាំអ្នកទៅការិយាល័យប៉ូលីស ។
ខ្ញុំនឹងនាំផ្លូវអ្នកខ្លះ ។
សូមទោស ប៉ុន្តែតើអ្នកអាចប្រាប់ខ្ញុំពីវិធីទៅភោជនីយដ្ឋានប៉ារីសបានទេ ?
ខ្ញុំសុំទោស ។ ខ្ញុំជាអ្នកចំលែកហើយនៅម្តុំនេះ ប៉ុន្តែមានការិយាល័យប៉ូលីសមួយនៅខាងកាច់ជ្រុងបន្ទាប់នោះ ។ ខ្ញុំនឹងជូនអ្នកទៅទីនោះ បើអ្នកចង់ ។
តើវាមិនរំខានខ្លាំងទេអី ?
មិនអីទេ ។ ខ្ញុំក៏កំពុងដើរទៅក្នុងទិសនឹងដែរ ។
ខ្ញុំមិនចូលចិត្តបង្កការរំខានដល់អ្នកទេ ។
តើនេះជាគេហដ្ឋានណាកានីស៊ីឬ ?
សួរស្ដី នេះគឺហ្វឹមីកុ ហ្វឹជីតា កំពុងនិយាយ ។
តើខ្ញុំអាចនិយាយទៅ ហេលេន បានទេ ?
សូមចាំមួយភ្លេច ។
តើអ្នកអាចចាំបន្តិចបានទេ ?
មានការហៅទូរស័ព្ទមួយសំរាប់អ្នក ពីលោកកាតឺ ។
មានគេចង់ជួបអ្នកតាមទូរស័ព្ទ ។
តើអ្នកអាចជួយភ្ជាប់លោកជីម បានទេ ?
តើខ្ញុំកំពុងនិយាយទៅកាន់អ្នកណាគេ ?
តើនេះជាផ្ទះរបស់លោកណាកានីស៊ីឬ ?
តើខ្ញុំអាចនិយាយទៅកាន់ហេលេន បានទេ ?
នេះគឺគាត់ កំពុងនិយាយ ។
សួស្តី ។ តើនេះជាគេហដ្ឋានស្ពេនដឺ ឬ ?
បាទ ។ តើអ្នកណាកំពុងទូរស័ព្ទមក ?
នេះគឺផលមឺ កំពុងនិយាយ ។ តើលោកស្ពេនដឺ នៅដែរទេ ?
ជំរាបសួរ ។ នេះគឺគាត់ កំពុងនិយាយ ។
សាយ័នសួស្ដី លោកស្ពេនដឺ ។ ខ្ញុំហៅទូរស័ព្ទមកអ្នក ដើម្បីសួរថាតើខ្ញុំមកជួបអ្នក នៅការិយាល័យរបស់អ្នក នៅថ្ងៃស្អែកបានទេ ។
អញ្ចឹង ខ្ញុំនឹងហៅទូរស័ព្ទមកអ្នក នៅម៉ោងបី ។
គាត់មិននៅតុធ្វើការរបស់គាត់ទេ នៅពេលនេះ ។
តើអ្នកអាចប្រាប់គាត់ថាខ្ញុំបានហៅទូរស័ព្ទមកបានទេ ?
តើអ្នកអាចប្រាប់អោយគាត់ទូរស័ព្ទមករកខ្ញុំ តាមលេខ បួន ប្រាំបី ពីរ មួយ បួន ប្រាំមួយ ?
តើខ្ញុំទាក់ទងគាត់ដោយប្រើទូរស័ព្ទបានទេ ?
ខ្ញុំកំពុងទូរសព័្ទទៅអ្នកវិញហើយ ។
គាត់មានភ្ញៀវ ។
គាត់មកធ្វើដំណើរដើម្បីជំនួញ ។
គាត់កំពុងលំហែកាយ ។
ខ្ញុំសុំទោស ។ គាត់ចេញក្រៅបាត់ហើយឥឡូវនេះ ។
តើអ្នកគិតថាគាត់ត្រឡប់វិញនៅពេលណា ?
ខ្ញុំគិតថាគាត់នឹងត្រឡប់មកវិញប្រហែលមួយម៉ោងទៀត យ៉ាងយូរ ។
អញ្ចឹង តើខ្ញុំអាចផ្ញើសារមួយបានទេ ?
តើអ្នកអាចប្រាប់គាត់អោយហៅទូរស័ព្ទទៅ ចនខ្លាក នៅពេលគាត់ត្រឡប់មកវិញបានទេ ?
បាន ។ តើខ្ញុំអាចសុំលេខទូរស័ព្ទរបស់អ្នកបានទេ ?
លេខទូរស័ព្ទរបស់ខ្ញុំគឺ មួយ ពីរ ពីរ បី មួយ ប្រាំពីរ ប្រាំពីរ ។
សូមដាក់លេខបន្ថែម ពីរ ប្រាំពីរ ប្រាំពីរ ។
តើអ្នកអាចភ្ជាប់ខ្ញុំទៅលោកប្រ៉ោន បានទេ ?
តើអ្នកអាចផ្ទេរទូរស័ព្ទនេះទៅផ្នែកកិច្ចការទូទៅបានទេ ?
តើអ្នកអាចភ្ជាប់ខ្ញុំទៅកាន់នាយកដ្ឋានផលិតកម្មបានទេ ?
តើអ្នកអាចហៅទូរស័ព្ទទៅលោកថេលឺ បានទេ ?
ខ្ញុំចង់និយាយទៅកាន់លោកថេលឺ ។
គាត់នៅជាប់ទូរស័ព្ទហើយពេលនេះ ។
លេខត្រូវដាក់ភ្ជាប់ហើយ ។
តើអ្នកចង់និយាយជាមួយអ្នកណាដែរ ?
ក្រុមហ៊ុនចនសុន ។ តើខ្ញុំអាចជួយអ្វីអ្នកបានទេ ?
លោកម៉ូហ្គាន នៅផ្នែកលេខាធិការ ?
យើងមានឈ្មោះម៉ូហ្គានពីរ នៅក្នុងផ្នែកហ្នឹង ។ តើឈ្មោះដំបូងរបស់គាត់អ្វីដែរ ?
ខ្ញុំគិតថា បីល ម៉ូហ្គាន ។
ខ្ញុំចង់និយាយជាមួយលោកហ្វត ។
ខ្ញុំសុំទោស ប៉ុន្តែគាត់នៅជាប់ទូរស័ព្ទផ្សេងទៀតនៅពេលនេះ ។ តើអ្នកចង់រង់ចាំទេ ?
អញ្ចឹង មិនអីទេ ។ ខ្ញុំនឹងហៅគាត់ឡើងវិញម្តងទៀតនៅក្នុងម្ភៃនាទីទៀត ។ សូមអរគុណ ។
តើគាត់មានឈ្មោះត្រកូលអ្វីដែរ ?
តើគាត់មានឈ្មោះត្រកូលអ្វីដែរ ?
ខ្ញុំសុំទោស ។ ខ្ញុំហៅទៅលេខខុស ។
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបហៅទូរស័ព្ទទៅខាងក្រៅបានទេ ?
ពួកយើងត្រូវកាត់ផ្តាច់ ។
ខ្សែដូចជាត្រូវបានឆ្លងកាត់ ។
តើអ្នកអាចហៅទូរស័ព្ទទៅរកលោកសាំមូអែល រ៉ូបឺតសុន បានទេ ?
លោកសាំមូអែល រ៉ូបឺតសុន ? មិនមានអ្នកណាឈ្មោះអញ្ចឹងទេ ។ ខ្ញុំគិតថាអ្នកទូរស័ព្ទខុសលេខហើយ ។
អូ ខ្ញុំសូមអភ័យទោសដែលរំខានអ្នក ។
ជំរាបសួរ ។ តើនេះជាគេហដ្ឋានវ៉ាត់សុន មែនទេ ?
ត្រូវហើយ ។ ចុចលេខ សូន្យ ដំបូង ហើយបន្ទាប់មកលេខដែលអ្នកចង់ ។
តើបន្ទប់ទឹកនៅឯណា ?
សុំទោស តើខ្ញុំអាចលាងដៃរបស់ខ្ញុំ បាននៅឯណា ?
តើម៉ោងប៉ុន្មានទៅដល់ទីក្រុងស៊ីអាថល ?
តើជើងហោះហើរតាមកាលវិភាគដែរទេ ?
តើយើងនឹងចុះចតនៅទីក្រុងតូក្យូទាន់ពេលវេលាទេ ?
តើជើងហោះហើរបន្ទាប់ទៅទីក្រុងតូក្យូ ចាកចេញនៅពេលណា ?
តើយន្តហោះតភ្ជាប់ចេញពីទីក្រុងតូក្យូ ?
តើខ្ញុំអាចពិនិត្យមើលការហោះហើទៅក្រុងតូក្យូ ?
ពេលវេលាសម្រាប់ការហោះម៉ោងប្រាំបីទៅទីក្រុងតូក្យូ ?
ទ្វារលេខដប់ប្រាំពីរ ?
ខ្ញុំត្រូវការឡើងក្នុងយន្តហោះលឿតិច ។
តើខ្ញុំអាចទៅទទួលអ្នកអន្តរជាតិ ?
សម្ភារៈខ្ញុំអាចចេញពីទីនេះ ?
តើខ្ញុំអាចទៅង្គុយចាំធ្វើដំណើរទៅអន្តរជាតិ ?
ខ្ញុំអាចទៅង្គុយចាំត្រឡប់ស្រុក ?
ខ្ញុំអាចទៅង្គុយចាំត្រឡប់ស្រុក ?
តើមានហាងលក់វត្ថុអនុស្សាវរីយ៍ទេ ?
ខ្ញុំអាចចេញពីព្រលានយន្តហោះពេលខ្លីមួយ ?
នៅពេលនឹងធ្វើការដំណើចាកចេញហើយខ្ញុំនិងមានរតភ្ជាប់ហោះ ?
ខ្ញុំចង់កក់បន្ទប់សម្រាប់ការហោះហើរទៅហនឡូឡូប្រាំពីរអ្នកនៅខែកក្កដានេះ ។
ខ្ញុំចង់កក់ពីរកៅអីថ្នាក់សេដ្ឋកិច្ច ។
