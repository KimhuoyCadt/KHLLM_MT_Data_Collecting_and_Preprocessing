អរគុណអ្នក ។ ខ្ញុំមានការហោះហើរដ៏ល្អ ។
ខ្ញុំសុំទោស ។ ខ្ញុំមិនមានអារម្មណ៍ល្អទេ ។
តើអ្នកទទួលបានថង់ពុលយន្តហោះដែលខ្ញុំអោយ ?
តើអ្នកមានថ្នាំពុលយន្តហោះខ្លះទេ ?
ខ្ញុំប្រហែលផឹកទឹកក្តៅ ?
តើអាចខ្ញុំដឹកកាបូបសម្រាប់ជេអេជេ៥ទៅណា ?
តើខ្ញុំអាចរករទេះរុញនៅឯណា ?
នេះគឺវេជ្ជបញ្ជាថ្នាំរបស់ខ្ញុំ ។
តើខ្ញុំអាចចំណាយតាមកាតឥណនទានបានទេ ?
ខ្ញុំសុំទោសប៉ុន្តែខ្ញុំមិនយល់ភាសាអង់គ្លេសច្រើនទេ ។
ខ្ញុំនិងស្នាក់នៅសណ្ឋាគារប៉ុន្តែខ្ញុំមិនបានកក់ទុកមុនទេ ។
ខ្ញុំទើបតែទាក់ទងជើងហោះហើរ ។
វាជាវ៉ាលីពណ៌ខៀវមានស្លាកឈ្មោះខ្ញុំ ។
ខ្ញុំនិងទៅស្នាក់នៅសណ្ឋាគារសេរាតុនដល់ថ្ងៃសុក្រ ។
បើរកឃើញកញ្ចប់ឥវ៉ាន់សូមហៅខ្ញុំភ្លាមៗ ។
តើខ្ញុំត្រូវសងអ្វីខ្លះបើអ្នកវ៉ាលីរបស់ខ្ញុំមិនឃើញ ?
តើត្រូវចំណាលនៅព្រលានយន្តហោះ ?
សួស្តី ។ សម្រាកនៅសណ្ឋាគារ ។ ខ្ញុំអាចជួយអ្នកបានទេ ?
ខ្ញុំឈ្មោះនាងតាណាកា ។ ខ្ញុំចង់កក់បន្ទប់មុន ។
ត្រូវការគ្រែតែមួយឫពីរក្នុងបន្ទប់ ?
ចាប់ពីទី១០ដល់ទី១២ខែកក្កដា ។
ខ្ញុំកំពុងស្វែងរក១បន្ទប់តម្លៃក្រោម១០០ដុល្លារក្នុង១យប់ ។
ខ្ញុំចង់បានសណ្ឋាគារនៅជិតស្ថានីយ៍កណ្តាល ។
តើអ្នកអាចណែនាំសណ្ឋាគារមិនថ្លៃនៅជាយក្រុង ?
ខ្ញុំត្រូវការ២សម្រាប់២យប់ពីយប់នេះ ។
ខ្ញុំត្រូវការបន្ទប់គ្រែ១យក២បន្ទប់ចាប់ពីថ្ងៃទី៣ដល់ទី៥ខែឧសភា ។
ខ្ញុំត្រូវការបន្ទប់គ្រែ១ជាគ្រែទំហំធំ ។
ខ្ញុំត្រូវការបន្ទប់ដែលមានអាងទឹក ។
តើអ្នកមានបន្ទប់ទល់មុខផ្លូវទេ ?
តើខ្ញុំអាចបន្ថែមគ្រែ១បានទេ ?
តើខ្ញុំទៅសណ្ឋាគាររបស់អ្នកពីព្រលានយន្តហោះដោយរបៀបណា ?
ខ្ញុំនិងត្រួតពិនិត្យនៅពេលយប់ ។
តើអត្រាក្នុងមួយយប់សម្រាប់បន្ទប់២មានប៉ុន្មាន ?
តើមួយបន្ទប់យកពន្ធប៉ុន្មាន ?
តើមួយយប់បញ្ចុះថ្លៃប៉ុន្មាន ?
តើខ្ញុំអាចមើលបន្ទប់សិនបានទេ ?
ខ្ញុំយកបន្ទប់មួយនេះ ?
តើអ្នកយកវ៉ាលីនេះទៅបន្ទប់ទេ ?
តើខ្ញុំបិទម៉ាស៊ីនត្រជាក់របៀបណា ?
តើខ្ញុំបើកម៉ាស៊ីនត្រជាក់របៀបណា ?
តើខ្ញុំជួសជុលនូវសីតុណ្ហភាពបន្ទប់ដូចម្តេច ?
តើខ្ញុំអាចមើលតារាងកម្មវិធីទូរទស្សន៍បានទេ ?
តើខ្ញុំអាចទូរសព្ទខាងក្រៅសណ្ឋាគារដោយរបៀបណា ?
តើខ្ញុំបិទទ្វារដោយរបៀបណា ?
នេះបន្ទប់លេខ២១០ ។
តើខ្ញុំមានដបស្រាក្រហមទេ ?
សុំយកសេនវិចទួគីនិងកាហ្វេ២កែវ ។
តើអ្នកត្រូវការយកកន្សែងងូចទឹក២ ឬ ?
តើអ្នកត្រូវការអោយខ្ញុំភ្ញាក់ហៅនៅម៉ោង៧ឬ ?
ខ្ញុំមានបញ្ហាមួយនៅក្នុងបន្ទប់របស់ខ្ញុំ ។
សោរនៅបង្អួចគឺខូចហើយ ។
ខ្ញុំមិនអាចបិទសោរមាត់ទ្វាបានទេ ។
គ្មានទឹកក្តៅនៅបន្ទប់របស់ខ្ញុំទេ ។
ខ្ញុំត្រូវការសម្រួលអារម្មណ៍នៅព្រឹកស្អែក ។
ខ្ញុំត្រូវការអុតអាវក្រៅនេះ ។
ខ្ញុំត្រូវការជម្រះស្នាមប្រឡាក់នេះ ។
តើខ្ញុំត្រូវការបង្កើតប្រព័ន្ធហៅអន្តរជាតិមួយឆ្ពោះទៅបន្ទប់របស់ខ្ញុំបានទេ ?
តើអ្នកត្រូវការចំលងនេះ៥ដងឬ ?
តើខ្ញុំអាចវាយអក្សរនេះឡើងបានទេ ?
ខ្ញុំគឺស្នាក់នៅបន្ទប់លេខ២១០ ។ តើមានសារខ្លះសម្រាប់ខ្ញុំទេ ?
ខ្ញុំត្រូវផ្លាស់ប្ដូរការកក់របស់ខ្ញុំ ។
តើខ្ញុំអាចពន្យាពេលស្នាក់នៅរហូតដល់ថ្ងៃអាទិត្យបានទេ ?
តើខ្ញុំអាចផ្លាស់ប្ដូរការកក់ថ្ងៃទី៣ទៅថ្ងៃទី៤ខែឧសភាបានទេ ?
ខ្ញុំត្រូវការស្នាក់នៅ២យប់បន្ថែមទៀត ។
ខ្ញុំត្រូវត្រួតពិនិត្យតាំងពីព្រលឹម ។
តើខ្ញុំត្រូវមិនចំណាយថ្លៃសេវាឬ ?
ខ្ញុំត្រូវការបម្រុងបន្ទប់២ដូចគ្នាជំនួសបន្ទប់២ទំនេរ ។
ខ្ញុំត្រូវលុបចោលការកក់ថ្ងៃទី១០ ខែឧសភា ។
តើអ្នកអាចផ្ញើរអោយអ្នកយាមទ្វារម្នាក់ទៀតទេ ?
តើវាអាចទៅរួចទេបើប្រើប្រាស់បន្ទប់រហូតដល់ទៅ៣បន្ទប់ ?
ខ្ញុំនិងមកដល់យឺតនៅយប់នេះ ។
ខ្ញុំនិងមកដល់ទីនោះប្រហែលម៉ោង៩ ។
ទីនេះគឺជាសណ្ឋាគារទំនើបរបស់ខ្ញុំ ។
លោកស្មីតនៅក្នុងសណ្ឋាគាររបស់អ្នកបានយល់ព្រមការកក់របស់ខ្ញុំ ។
តើអ្នកអាចត្រួតពិនិត្យការថតរបស់អ្នកម្តងទៀតបានទេ ?
ទោះជាយ៉ាងណាក៏ដោយតើខ្ញុំអាចធ្វើការកក់មួយឥលូវនេះបានទេ ?
តើអ្នកអាចយកបន្ទប់មួយទៀតនៅឯសណ្ឋាគារផ្សេងបានទេ ?
ខ្ញុំបានកក់បន្ទប់ពីរ ។ មិនមែនតែមួយទេ ។
ខ្ញុំបានកក់បន្ទប់មួយមានអាងងូតទឹក ។
ខ្ញុំបានស្នើរបន្ទប់មួយមានទិដ្ឋភាពសមុទ្រ ។
ខ្ញុំបានស្នើរបន្ទប់មួយមានទិដ្ឋភាពទីក្រុង ។
ខ្ញុំគឺបានបិទខ្លួនឯងហើយ ។
ខ្ញុំគឺខ្លាចបាត់សោរបន្ទប់របស់ខ្ញុំ ។
ខ្ញុំភ្លេចលេខកូដប្រអប់សំងាត់នៅក្នុងបន្ទប់របស់ខ្ញុំ ។
នាឡិកាដៃរបស់ខ្ញុំបានបាត់ខណៈខ្ញុំចេញក្រៅ ។
ការថតវីដេអូត្រូវបានបាត់នៅបន្ទប់របស់ខ្ញុំ ។
តើអ្នកណាដោះស្រាយបញ្ហាទាំងនេះបាន ?
ដោះស្រាយត្រង់វិក័យប័ត្រកុំបន្ថែមទៀត ។
ខ្ញុំមិនអាចហៅបានទេនៅរយៈចម្ងាយឆ្ងាយខ្លះ ។
ខ្ញុំមិនផឹកស្រាបៀផ្សេងចេញពីទូទឹកកកទេ ។
ខ្ញុំទុកអាវក្រៅនៅក្នុងបន្ទប់ ។
ខ្ញុំភ្លេចកាំមេរ៉ានៅបន្ទប់លេខ១០ កាលពីម្សិលមិញ ។
ខ្ញុំនិងត្រលប់មកវិញហើយយកវាឡើងយប់នេះ ។
តើអ្នកអាចផ្ញើរវាទៅសណ្ឋានគារ ហូរលីដេនៅក្នុងប្រទេសឆីកាហ្គូរទឬទេ ?
ខ្ញុំនិងចំណាយតាមផ្លូវ ។
ផ្នែកទំនាក់ទំនង ។ តើមានអ្វីឱ្យខ្ញុំជួយទេ ?
ខ្ញុំត្រូវការយល់ព្រមទៅ ទីក្រុង តូក្យូ ។
លេខជើងហោះហើរនិងថ្ងៃខែ ។
ជើងហោះហើរ៥ ទីស្តីការនៅខែមេសាទី១០ចេញពីញ៉ូវយ៉ក ។
ហ៊ីរូហ្សី លីជីម៉ា ។ ខ្ញុំនិងប្រកបឈ្មោះចុងក្រោយរបស់អ្នក ។ អាយ អាយ ជេ អាយ អេម អេ ។
អរគុណអ្នក លោកលីជីម៉ា ។ ដំណើរហោះហើររបស់អ្នកត្រូវបានយល់ព្រម ។ សូមអញ្ជើញទៅព្រលានយន្តហោះ ។
ខ្ញុំត្រូវការកក់កៅអីពីរទៅ ញ៉ូវយ៉ក នៅថ្ងៃទី៣ ឧសភា ។
ខ្ញុំត្រូវការសំបុត្រទៅមកពី រីម៉ូនទៅ ម៉ៃមី ។
តើកាលវិភាគធ្វើដំណើរពីឡូអាន់ជឺឡេស ទៅប៊ូឡែន ?
ខ្ញុំនិងយកជើងហោះហើរនៅម៉ោង១០ ។
ខ្ញុំចូលចិត្តដំណើរពេលព្រឹក ។
តើអ្នកមានសំបុត្រតម្លៃថោកផ្សេងទៀតទេ ?
ខ្ញុំត្រូវការបើកសំបុត្រមួយ ។
តើខ្ញុំអាចឈប់ហួសទៅឡុនដុនបានទេ ?
តើម៉ោងប៉ុន្មានយន្តហោះទៅដល់ប៊ូស្តុន ?
ខ្ញុំបានកត់ត្រាចំនួនដំណើរ៥ដងសម្រាប់កៅអីនៅថ្ងៃស្ងែក ។
ខ្ញុំត្រូវការប្ដូរវាទៅថ្ងៃទី៧វិញ ។
តើខ្ញុំអាចផ្លាស់ប្ដូរជើងហោះហើរទៅពេលព្រឹកព្រលឹមថ្ងៃទី៥បានទេ ?
ខ្ញុំត្រូវការលុបចោលការកក់ថ្ងៃទី៣តុលារបស់ខ្ញុំនៅជើងទី៥ ។
ជើងហោះហើរភីអេ ជើងទី៥ នៅអេឡានតានៅខែមីនា ថ្ងៃទី១០ ។
តើម៉ោងប៉ុន្មានអ្នកចាប់ផ្តើមត្រួតពិនិត្យ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីរបងនិងលេខស្ថានីយបានទេ ?
តើខ្ញុំអាចមានតុកិច្ចការទេឥលូវនេះ ?
តើខ្ញុំអាចមានកៅអីមួយដែលគ្មានផ្សែងបារីទេ ?
តើខ្ញុំអាចមានកៅអីបង្គួចមួយនៅក្នុងកន្លែងគ្មានការជក់បារីទេ ?
តើខ្ញុំអាចមានកៅអីកណ្តាលមួយនៅក្នុងកន្លែងគ្មានការជក់បារីទេ ?
ខ្ញុំមានជើងហោះហើរទាក់ទងមួយនៅឯសាន់ប្រាន់ស៊ីស្កូ ។
តើកន្លែងផ្លាស់ប្ដូរម៉ាស៊ីកាន់អ៊ែឡាញគឺនៅឯណា ?
គោលដៅចុងក្រោយរបស់ខ្ញុំគឺនៅទីក្រុងម៉ិចសិកូ ។
តើពួកយើងមានពេលទៅហាងទេនៅឯអាកាសយានដ្ឋាន ?
ខ្ញុំនឹកជើងហោះហើរដប់សម្រាប់ដេត្រូ ។
តើខ្ញុំអាចយកលេខកៅអីមួយនៅដំណើរពេលក្រោយបានទេ ?
តើអ្នកមានដំណើរហោះហើរពេលព្រឹកព្រលឹមមួយទេ ?
ខ្ញុំបានអះអាងការហោះហើររបស់អ្នកយ៉ាងពិតប្រាកដ ។
តើអ្នកដាក់ខ្ញុំនៅអាកាសយានដ្ឋានផ្សេងទៀតបានទេ ?
ខ្ញុំមិនអាចធ្វើវាដើម្បីទាក់ទងការហោះហើររបស់ខ្ញុំទេ ។
អ្នកត្រូវតែរៀបចំកៅអីមួយសម្រាប់ខ្ញុំនៅការហោះហើរនេះ ។
សំបុត្រត្រលប់ទៅមកពីរសម្រាប់ឡាវីហ្កាសប ។
តើមានការភ្ជាប់ពីដែឡាសទៅម៉ៃមីទេ ?
តើមានអាហារទេនៅក្នុងរថភ្លើងនេះទេ ?
មានសំបុត្រដំណើរមួយទៅឡាសវិហ្គាសបាទ ។
ខ្ញុំត្រូវការត្រយតពិនិត្យកាតាបរបស់ខ្ញុំ ។
តើកន្លែងណាដែលខ្ញុំចំណាយលើសេវារថភ្លើង ?
តើអ្វីដែលជាតម្លៃទៅវិថីទីប្រាំ ?
តើរថយន្តមួយណាដែលខ្ញុំយកទៅស្តតូស ?
តើរថយន្តនេះទៅភាគខាងជើងត្បូង ?
ខ្ញុំមានត្រឹមតែវិក័យប័ត្រមួយដុល្លារប៉ុណ្ណោះ ។ សូមទុកដូរ ។
តើខ្ញុំអាចយកផែនទីក្រោមដីនៅឯណា ?
