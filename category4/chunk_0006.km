វាពណ៌ផ្កាឈូក ។
វាពណ៌ខៀវងងឹត ។
វាពណ៌ទឹកក្រូច ។
នៅក្នុងកាបូបមានកាតឥណទានរបស់ខ្ញុំផង ។
តើអ្នកមានលុយនៅក្នុងកាបូបលុយប៉ុន្មាន ?
តើក្រុមហ៊ុនឥណទានរបស់អ្នកឈ្មោះអ្វី ?
វាគឺអាមេរិចខេនអិចប្រេស ។
តើវាជាចិញ្ចៀនប្រភេទអ្វី ?
វាជាចិញ្ចៀនមាស ។
តើវាជាខ្សែកប្រភេទអ្វី ?
វាជាខ្សែកមាស ។
វាជាបន្តោងពេជ្រ ។
វាជាកាតម៉ាស្ទើរ ។
វាជាក្លឹបឌីណឺរ ។
វាគឺចេស៊ីប៊ី ។
វាគឺវ៉ាយអ៊ីអេស ។
វាជាដាយអាមុន ក្រេឌីត ។
វាជាចិញ្ចៀនប្រាក់ ។
វាជាចិញ្ចៀនផ្លាទីន ។
វាជាចិញ្ចៀនពេជ្រ ។
វាជាចិញ្ចៀនត្បូងកណ្តៀង ។
វាជាចិញ្ចៀនត្បូងទទឹម ។
វាជាចិញ្ចៀនត្បូងមរកត ។
វាជាចិញ្ចៀនពេជ្រពណ៌ ។
វាជាខ្សែកប្រាក់ ។
វាជាខ្សែកគ្រាប់គុជខ្យង ។
វាជាខ្សែកគ្រីស្តាល់ ។
មានកាបូបលុយនៅក្នុងកាបូបរបស់ខ្ញុំ ។
យប់នេះអ្នកនឹងស្នាក់នៅឯណា ?
តើលេខទូរស័ព្ទប៉ុន្មាន ?
វាគឺលេខប្រាំបួន ប្រាំបួន ប្រាំបួន ប្រាំបួន ប្រាំបួន ប្រាំបួន ប្រាំបួន ។
តើអ្នកបាននៅក្នុងប្រទេសនេះប៉ុន្មានថ្ងៃហើយ ?
ខ្ញុំបាននៅទីនេះកៅសិបប្រាំបួនថ្ងៃហើយ ។
តើគំរោងរបស់អ្នកអ្វីដែរ ?
ខ្ញុំនឹងស្នាក់នៅទីនេះកៅសិបប្រាំបួនថ្ងៃទៀត ។
ខ្ញុំនឹងត្រឡប់វិញនៅថ្ងៃទីប្រាំបួននេះ ។
តើអាសយដ្ឋានរបស់អ្នកអ្វីដែរនៅប្រទេសជប៉ុន ?
អាសយដ្ឋានរបស់ខ្ញុំនៅក្នុងប្រទេសជប៉ុនគឺ ប្រាំបី ម្ភៃប្រាំពីរ ម្ភៃ មីណាមី ជឺអូ មឹសាស៊ីណុ ទីក្រុងតូក្យូ ។
នៅក្នុងកាបូបដៃរបស់ខ្ញុំមានសំបុត្រយន្តហោះ ។
នៅក្នុងកាបូបដៃរបស់ខ្ញុំមានផែនទី ។
នៅក្នុងកាបូបដៃរបស់ខ្ញុំមានសៀវភៅកត់ត្រាមួយក្បាល ។
មានគ្រឿងប្រើប្រាស់ក្នុងបន្ទប់ទឹកនៅក្នុងកាបូបដៃរបស់ខ្ញុំ ។
មានឥវ៉ាន់តិចតូចមួយចំនួននៅក្នុងកាបូបដៃរបស់ខ្ញុំ ។
ដៃគូរបស់ខ្ញុំមិនស្រួលខ្លួន ។ តើអ្នកអាចហៅគ្រូពេទ្យប្រចាំកន្លែងរបស់អ្នកអោយមកជួយពិនិត្យមើលនៅបន្ទប់របស់ពួកយើងបានទេ ?
ប្រាកដណាស់ ។ យើងនឹងហៅគ្រូពេទ្យរបស់ពួកយើងអោយទៅបន្ទប់របស់អ្នកឥឡូវនេះ ។
យើងសុំទោស ។ ប៉ុន្តែយើងមិនមានគ្រូពេទ្យប្រចាំកន្លែងទេ ។ តើយើងអាចហៅឡានពេទ្យអោយអ្នកបានទេ ?
ដៃគូរបស់ខ្ញុំទទួលរងនូវជំងឺគ្រុនក្តៅខ្លាំង ។
ដៃគូរបស់ខ្ញុំទទួលរងនូវការគាំងបេះដូង ។
ដៃគូរបស់ខ្ញុំមានជំងឺរាគរុសខ្លាំង ។
ដៃគូរបស់ខ្ញុំទទួលរងនូវជម្ងឺហឺត ។
ដៃគូរបស់ខ្ញុំត្រូវប៉ះទង្គិចនឹងក្បាលយ៉ាងខ្លាំង ពេលដែលគាត់ដួលក្នុងបន្ទប់ទឹក ។
កូនរបស់ខ្ញុំមានជំងឺគ្រុនក្តៅខ្លាំង ។
ខ្ញុំឈឺធ្មេញខ្លាំងរហូតដល់ទ្រាំមិនបាន ។
ខ្ញុំមានជំងឺរាគរុសខ្លាំង ។
ដៃគូរបស់ខ្ញុំត្រូវប៉ះទង្គិចនឹងឆ្អឹងខ្នងរបស់គាត់យ៉ាងខ្លាំង ។
ដៃគូរបស់ខ្ញុំត្រូវប៉ះទង្គិចនឹងក្បាលរបស់នាងយ៉ាងខ្លាំង ។
ដៃគូរបស់ខ្ញុំត្រូវប៉ះទង្គិចនឹងឆ្អឹងខ្នងរបស់នាងយ៉ាងខ្លាំង ។
កូនរបស់ខ្ញុំមានជំងឺគ្រុនក្តៅខ្លាំង ។
តើមានបញ្ហាអ្វី ?
ដៃគូរបស់ខ្ញុំទទួលរងនូវការឈឺចាប់យ៉ាងខ្លាំងក្នុងក្រពះ ។
ដៃគូរបស់ខ្ញុំក្អកចេញឈាម ។
ដៃគូរបស់ខ្ញុំមិនអាចធ្វើចលនាបានត្រង់ខ្នងខាងក្រោមដែលឈឺ ។
ដៃគូរបស់ខ្ញុំភ្លាត់និងគ្រេចកជើងរបស់គាត់ ។
ដៃគូរបស់ខ្ញុំឈឺខ្លាំង ។
តើអ្នកអាចហៅឡានពេទ្យបានទេ ?
តើអ្នកអាចទូរស័ព្ទហៅឡានតាក់ស៊ីបានទេ ?
តើអ្នកអាចសរសេរឈ្មោះនិងអាសយដ្ឋានរបស់មន្ទីរពេទ្យនឹងបានទេ ?
ខ្ញុំមានអារម្មណ៍អាក្រក់ណាស់ ។ តើមានមន្ទីរពេទ្យណានៅក្បែរនេះដែរទេ ? បើមាន តើអ្នកអាចសរសេរឈ្មោះវា និងទីតាំងអោយខ្ញុំបានទេ ?
ខ្ញុំជាអ្នកចំណូលថ្មីនៅទីនេះ ។ អ្នកគួរតែសួរអ្នកផ្សេង ។
តើអ្នកអាចគូសផែនទីផ្លួវទៅមន្ទីរពេទ្យនោះបានទេ ?
តើអ្នកអាចជួយទូរស័ព្ទហៅឡានពេទ្យអោយខ្ញុំបានទេ ? ខ្ញុំមានអារម្មណ៍មិនល្អសោះ ។
ឥឡូវនេះខ្ញុំប្រញាប់ ។ តើអ្នកអាចសួរអ្នកផ្សេងបានទេ ?
សូមនាំខ្ញុំទៅមន្ទីរពេទ្យនេះ ។
សូមឆាប់ឡើង ។ ខ្ញុំឈឺខ្លាំងណាស់ ។
ខ្ញុំជាអ្នកធ្វើដំណើរ ហើយនេះគឺជាការមកលេងដំបូងរបស់ខ្ញុំ ។ ខ្ញុំចង់ទៅជួបគ្រូពេទ្យឱសថព្យាបាលផ្នែកខាងក្នុង ។
តើអាសយដ្ឋានរបស់អ្នកអ្វីដែរ ?
អ្នកមានបញ្ហាទេ ?
សូមរង់ចាំមួយសន្ទុះសិន រហូតដល់យើងហៅអ្នក ។
ខ្ញុំចង់ទៅជួបគ្រូពេទ្យផ្នែកវះកាត់ ។
ខ្ញុំចង់ទៅជួបទន្ដពេទ្យ ។
ខ្ញុំខ្លាចតែខ្ញុំផ្តាសាយទេ ។
ខ្ញុំកណ្តាស់ពេញមួយថ្ងៃ ។
ខ្ញុំមានអារម្មណ៍អស់កំលាំង ហើយល្ហិតល្ហៃ ។
ខ្ញុំឈឺសាច់ដុំដៃនិងជើង ។
ខ្ញុំឈឺក្រពះភ្លាមៗ ។
ខ្ញុំមានការប្រាំថ្នេនៅចំហៀងខាងនេះ ។
ខ្ញុំឈឺក្រពះភ្លាមៗ ។
ខ្ញុំបោះចោលបានកៅសិបប្រាំបួនដង ។
ខ្ញុំទល់លាមបានកៅសិបប្រាំបួនថ្ងៃ ។
ខ្ញុំមានកន្ទួលនៅលើរាងកាយ ។
ខ្ញុំមានកន្ទួលកហម ។
ខ្ញុំខ្សាយបេះដូង ។
ខ្ញុំបានទទួលរងពីការគេងមិនលក់ ។
ធ្មេញប្រាជ្ញារបស់ខ្ញុំឈឺណាស់ ។
ខ្ញុំមានអាការៈឈឺខ្នង ។
ខ្ញុំឈឺខ្នងខ្លាំងណាស់ ។
ខ្ញុំខ្លាចដៃខ្ញុំបាក់ ។
ខ្ញុំកាត់ម្រាមដៃរបស់ខ្លួនឯង ។
ខ្ញុំកាត់ដៃរបស់ខ្លួនឯង ។
ខ្ញុំប្រហែលជាកប់សន្លាក់ដៃហើយមើលទៅ ។
កែងដៃរបស់ខ្ញុំគ្រេច ។
អ្នកជំងឺយូរហើយនៅ ?
សីតុណ្ហភាពរបស់អ្នកប៉ុន្មាន ?
សីតុណ្ហភាពរបស់ខ្ញុំមុនមកនៅទីនេះកៅសិបប្រាំបួនអង្សាសេ ។
សីតុណ្ហភាពរបស់ខ្ញុំយប់មុនកៅសិបប្រាំបួន ។
តើអ្នកមានចំណង់អាហារដ៏ល្អ ?
ទេ ខ្ញុំមិនមានចំណង់អាហារទេ ។
ទេ ។ ខ្ញុំព្យាយាមបរិភោគប៉ុន្តែមានអារម្មណ៍ថានិងក្អួត ។
តើអ្នកមានឈឺយូរហើយឬនៅ ?
បាទ វាឈឺចាប់ ។
ឈឺយ៉ាងខ្លាំង ។
វាគឺជាការឈឺរំញ័រ ។
ឈឺចាប់ដោយដុត ។
តោះ ថតកាំរស្មីអិច ។
ធ្វើពិនិត្យឈាម ។
ធ្វើឱ្យពិនិត្យហ្មត់ចត់ ។
បាទ ខ្ញុំបានទទួលការព្យាបាលជំងឺទឹកនោមផ្អែមក្នុងប្រទេសជប៉ុន ។
ពិតជាធម្មតាខ្ញុំមានសុខភាពល្អ ។
បាទ ខ្ញុំត្រូវបានគេព្យាបាលជំងឺលើសឈាមនៅប្រទេសជប៉ុន ។
បាទ ខ្ញុំបានទទួលការព្យាបាលជំងឺបេះដូងនៅក្នុងប្រទេសជប៉ុន ។
បាទ ខ្ញុំត្រូវបានគេព្យាបាលបញ្ហាតម្រងនោមនៅក្នុងប្រទេសជប៉ុន ។
បាទ ខ្ញុំត្រូវបានគេព្យាបាលដំបៅក្រពះមួយនៅក្នុងប្រទេសជប៉ុន ។
បាទ ខ្ញុំត្រូវបានគេព្យាបាលដំបៅនៅក្នុងប្រទេសជប៉ុន ។
បាទ ខ្ញុំត្រូវបានគេព្យាបាលរោគសរសៃប្រាសាទនៅប្រទេសជប៉ុន ។
បាទ ខ្ញុំត្រូវបានគេព្យាបាលជំងឺហឺតក្នុងប្រទេសជប៉ុន ។
តើអ្នកធ្លាប់មានជំងឺធ្ងន់ធ្ងរទេ ?
ខ្ញុំធ្លាប់បានទទួលរងពីជំងឺរលាកសួត ។
ខ្ញុំមានអាយុកៅសិបប្រាំបួនឆ្នាំ ។
វាជាកៅសិបប្រាំបួនឆ្នាំមុន ។
ខ្ញុំកាត់ខ្នែងពោះវៀនមួយកៅសិបប្រាំបួនឆ្នាំមុន ។
ខ្ញុំមានការវះកាត់មួយកៅសិបប្រាំបួនឆ្នាំមុន ។
ខ្ញុំជាមហារីកកៅសិបប្រាំបួនឆ្នាំមុន ។
ខ្ញុំបានទទួលការវះកាត់ទ្វារមាសកៅសិបប្រាំបួនឆ្នាំមុន ។
ខ្ញុំធ្លាប់បានទទួលរងពីជំងឺរបេង ។
ខ្ញុំធ្លាប់បានទទួលរងពីជំងឺរលាកមះ ។
ខ្ញុំធ្លាប់បានទទួលរងពីជំងឺក្លន ។
ខ្ញុំធ្លាប់បានទទួលរងពីជំងឺរលាកថ្លើម ។
ខ្ញុំធ្លាប់បានទទួលរងពីជំងឺរលាកទងសួតស្រួចស្រាវ ។
ខ្ញុំធ្លាប់បានទទួលរងពីការដំបៅក្រពះ ។
ខ្ញុំធ្លាប់បានទទួលរងពីជំងឺក្រិនថ្លើម ។
ខ្ញុំធ្លាប់បានទទួលរងពីជំងឺគ្រួសក្នុងតម្រងនោម ។
ខ្ញុំធ្លាប់បានទទួលរងពីមហារីកប្រមាត់ ។
ខ្ញុំធ្លាប់បានទទួលរងពីការស្ទះពោះវៀន ។
ខ្ញុំធ្លាប់បានទទួលរងពីការពោះវៀន ។
តើអ្នកប្រើថ្នាំទេ ?
បាទខ្ញុំប្រើថ្នាំគ្រូពេទ្យរបស់ខ្ញុំបានចេញវេជ្ជបញ្ជាសម្រាប់ខ្ញុំ ។
ខ្ញុំបានប្រើថ្នាំផ្ដាសាយ ។
ខ្ញុំបានប្រើថ្នាំក្អក ។
ខ្ញុំបានទទួលគ្រុន ។
ខ្ញុំកុំពុងររាយអាហារ ។
បាទ ខ្ញុំចាញ់ថ្នាំ ។
ទេខ្ញុំមិនគិតថាខ្ញុំមានអាឡែរហ្សីណាមួយទេ ។
ជាពិតខ្ញុំមានជំងឺហឺត ។
សម្ពាធឈាមធម្មតារបស់អ្នកគឺជាអ្វី ?
គ្រូពេទ្យវិនិច្ឆ័យថាជំងឺអ្វី ?
យើងនឹងត្រូវចាំលទ្ធផលនៃការពិនិច្យនេះ ។
ជារលាកក្រពះស្រួចស្រាវ ។
ជាការរលាកខ្នែងពោះវៀន ។
ជាជំងឺរលាកមះ ។
ជាការរលាកថ្លើមស្រួចស្រាវ ។
គាត់ឱ្យអ្នកធ្វើអ្វីខ្លះ ?
អ្នកត្រូវតែសម្រាកសម្រាប់ពីរបីថ្ងៃ ។
អ្នកត្រូវតែស្នាក់កៅសិបប្រាំបួនថ្ងៃ ។
អ្នកនឹងត្រូវតែស្នាក់នៅក្នុងមន្ទីរពេទ្យប្រហែលកៅសិបប្រាំបួនថ្ងៃ ។
អ្នកគួរតែពិនិត្យហ្មត់ចត់បានឆាប់តាមដែលអាចធ្វើទៅបាន ។
អ្នកត្រូវការអាក្រក់ការវះកាត់ជាបន្ទាន់ ។
អ្នកបានប្រសើរជាងមុនមិនបរិភោគអ្វីនោះទេនៅថ្ងៃនេះ ។
អ្នកគួរតែយកអាហាររាវប៉ុណ្ណោះ ។
អ្នកអាចមានអាហារពន្លឺ ។
អ្នកមិនគួរជក់បារី ។
អ្នកមិនគួរតែយកគ្រឿងស្រវឹងណាមួយទេ ។
កុំបរិភោគអ្វីដែលក្តៅពេកឬត្រជាក់ពេក ។
អ្នកគួរតែជៀសវាងអាហារយ៉ាងធ្ងន់ ។
ខ្ញុំនឹងចេញវេជ្ជបញ្ជាថ្នាំមួយចំនួនសម្រាប់អ្នក ។
យកបានតែថ្នាំដែលយើងបានចេញវេជ្ជបញ្ជានោះ ។
អនុវត្តការបង្ហាប់ត្រជាក់មួយដើម្បីបំបាត់ការឈឺចាប់នោះទេ ។
នៅពេលដែលការឈឺចាប់នេះបានលោកអ្នកបានល្អប្រសើរជាងមុនអនុវត្តបង្ហាប់ក្តៅមួយ ។
អ្នកបានល្អជាងមុនមិនបានញាក់តំបន់ដែលរងរបួសនោះទេ ។
កុំព្យាយាមធ្វើឱ្យផ្លាស់ទីផ្នែកដែលរងរបួស ។
លាបថ្នាំនេះនៅពេលអ្នកមានគ្រុនក្តៅមួយ ។
លាបថ្នាំនេះនៅពេលអ្នកមានអាការៈឈឺ ។
លាបថ្នាំនេះបីដងក្នុងមួយថ្ងៃមុនពេលអាហារ ។
លាបថ្នាំនេះពីរដងក្នុងមួយថ្ងៃនៅពេលព្រឹកនិងពេលល្ងាច ។
លាបថ្នាំនេះម្តងក្នុងមួយថ្ងៃនៅពេលព្រឹក ។
លាបថ្នាំនេះជារៀងរាល់កៅសិបប្រាំបួនម៉ោង ។
ខ្ញុំកំពុងអារម្មណ៍ល្អ ។
ខ្ញុំគួរតែមកថ្មីម្តងទៀត ?
អ្នកត្រូវបានប្រសើរជាងនេះ ។
សូមត្រឡប់វិញម្តងទៀតនៅថ្ងៃស្អែក ។
លាបថ្នាំនេះបីដងក្នុងមួយថ្ងៃ ។
លាបថ្នាំនេះពីរដងពេលព្រឹកនិងពេលល្ងាចបន្ទាប់ពីអាហារ ។
លាបថ្នាំនេះម្តងមួយថ្ងៃនៅពេលល្ងាច ។
លាបថ្នាំនេះម្តងក្នុងមួយថ្ងៃ ។
ថ្នាំម្តងក្នុងមួយថ្ងៃនៅពេលច្បាស់លាស់ណា ។
សូមត្រឡប់វិញម្តងទៀតនៅថ្ងៃស្អែក ។
សូមត្រឡប់វិញម្តងទៀតរយៈពេលកៅសិបប្រាំបួនថ្ងៃ ។
ខ្ញុំមានសិទ្ធិក្នុងទស្សនកិច្ចនេះទេ ?
សិទ្ធិរបស់ខ្ញុំ ។ មិនបានប៉ះពាល់ដោយខ្លួនឯង ។
អ្នកត្រូវកាវបានល្អជាងនេះ ។
ខ្ញុំនឹងចេញបន្ទាប់ពីថ្ងៃស្អែកនេះ ។ ខ្ញុំត្រូវធ្វើម្ដេច ?
ខ្ញុំសូមថ្នាំសម្រាប់កៅសិបប្រាំបួនថ្ងៃ ។ ដើម្បីទៅលាប ។
ថែរក្សាខ្លួនឱ្យល្អដល់ពេលអ្នកត្រឡប់ផ្ទះ ។
សូមមើលគ្រូពេទ្យរបស់អ្នកនៅពេលដែលអ្នកមានត្រឡប់មកផ្ទះវិញ ។
នៅពេលដែលអ្នកត្រឡប់ផ្ទះ អ្នកគ្រូវតែថែរ្សាខ្លួនឱ្យល្អ ។
កុំខ្មាស ។ គាត់នឹងឆាប់នេះ ។
បាទវាជាការត្រឹមត្រូវទាំងអស់ ។
ទេ ងូតទឹកមួយជាល្អ ។
សូមគិតលុយព្យាបាល ?
កៅសិបប្រាំបួន ។
តើអ្នកអាវប្រាប់ចំនួនគ្រូពេទ្យចូលរួមបានទេ ?
ខ្ញុំទៅថ្ងៃស្អែក ។ គ្រូរធ្វើម្ដេច ?
ជាគ្រោះថ្នាក់រថយន្ត ។ សូមហៅប៉ូលីស ។
ត្រូវបានរបួសកន្លែងណា ?
ខ្ញុំទទួលរបួសស្នាម ។ សូមហៅឡានពេទ្យឱ្យខ្ញុំ ។
ដៃគូរបស់ខ្ញុំទទួលរបួសស្នាម ។ សូមហៅឡានពេទ្យឱ្យបានទេ ។
ដៃគូរបស់ខ្ញុំត្រូវបានទទួលរបួសស្នាមយ៉ាងខ្លាំងនិងហូរឈាម ។ សូមតេហៅឡានពេទ្យឱ្យបានទេ ។
ដៃគូរបស់ខ្ញុំគឺមានរបួសស្នាមនិងសន្លប់ ។ សូមទូរស័ព្ទទៅឡានពេទ្យ ។
អ្នកបើកបរបានទទួលរបួសស្នាម ។ សូមតេហៅឡានពេទ្យឱ្យបានទេ ។
កៅសិបប្រាំបួននាក់បានរបួសស្នាម ។ សូមតេហៅឡានពេទ្យឱ្យបានទេ ។
ដៃគូរបស់ខ្ញុំនៅក្នុងរថយន្ត ។ សូមជួយគាត់ផង ។
សូមជួយគាត់ចេញជាមួយខ្ញុំ ។
អ្នកមានភស្ដុតាងទេ ?
អូខេសម្រាប់ខ្ញុំ ។
ខ្ញុំសូមលេខទូរសព្ទនិងឈ្មោះអ្នកបានទេ ?
បាទ នេះភស្ដុតាងរបស់អ្នក ។
មែនសំប្រុតអនុញាតិបើកឡានអ្នកទេ ។
រថយន្តបុកខ្ញុំ ។
រថយន្តបុកដៃគូរបស់ខ្ញុំ ។
ដៃគូរបស់ខ្ញុំគឺគ្រាន់តែត្រឡប់ទៅជ្រុងនេះ ។
ដៃគូរបស់ខ្ញុំកំពុងឆ្លងផ្លូវ ។
ដៃគូរបស់ខ្ញុំបានឆ្លងកាត់ផ្លូវនៅលើពន្លឺពណ៌បៃតង ។
រថយន្តនេះមិនបានកាត់បន្ថយល្បឿនរបស់វា ។
រថយន្តនេះមិនបានបញ្ឈប់មុនពេលដែលការឆ្លងកាត់ ។
ខ្ញុំគ្រាន់តែត្រឡប់ទៅជ្រុងនេះ ។
យើងគ្រាន់តែត្រឡប់ទៅជ្រុងនេះ ។
ខ្ញុំកំពុងឆ្លងផ្លូវ ។
ខ្ញុំឆ្លងកាត់ផ្លូវនៅលើពន្លឺពណ៌បៃតង ។
យើងឆ្លងកាត់តាមផ្លូវនៅលើពន្លឺពណ៌បៃតង ។
រថយន្តនេះមិនបានបញ្ឈប់នៅជ្រុងនោះ ។
រថយន្តនេះមិនបានបន្ថយចុះ ។
រថយន្តនេះមិនបានបើកពន្លឺទិស ។
រថយន្តខាងមុខមកល្បឿនកៅសិបប្រាំបួនគីឡូម៉ែត្រក្នុងមួយម៉ោង ។
ខ្ញុំមានពេលវេលាដើម្បីជៀសវាងឱ្យគាត់ចេញពីផ្លូវម្ខាង ។
គាត់ព្យាយាមឆ្លងកាត់ផ្លូវបន្ទាប់ពីពន្លឺចរាចរណ៍បានងាកពីពណ៌បៃតងទៅជាពណ៌ក្រហម ។
គាត់មិនបានអើពើពន្លឺពណ៌ក្រហមនិងបានឆ្លងផ្លូវ ។
គាត់បត់ចេញមកពីក្រោយរថយន្តចតមួយ ។
គាត់បានប្រញាប់ចេញទៅក្នុងកណ្តាលផ្លូវដែលមិនមានការឆ្លងកាត់ ។
ខ្ញុំបានបញ្ឈប់នៅលើពន្លឺពណ៌ក្រហមប៉ុន្តែមានរថយន្តមួយបុកនៅពីក្រោយរថយន្តខ្ញុំ ។
រថយន្តនោះបានបង្ខំធ្វើឱ្យវេនចាកចេញមួយ ។
ខ្ញុំមានពេលវេលាដើម្បីជៀសវាងឱ្យគាត់ចេញពីផ្លូវម្ខាង ។
គាត់ព្យាយាមឆ្លងកាត់ផ្លូវបន្ទាប់ពីពន្លឺចរាចរណ៍បានងាកពីពណ៌បៃតងទៅជាពណ៌ក្រហម ។
គាត់មិនបានអើពើពន្លឺពណ៌ក្រហមនិងបានឆ្លងផ្លូវ ។
គាត់បត់ចេញមកពីក្រោយរថយន្តចតមួយ ។
គាត់បានប្រញាប់ចេញទៅក្នុងកណ្តាលផ្លូវដែលមិនមានការឆ្លងកាត់ ។
រថយន្តដែលបានមកកណ្តាលផ្លូវបុកជាមួយនិងរថយន្តរបស់ខ្ញុំ ។
រថយន្តនោះមិនបានអើពើពន្លឺពណ៌ក្រហមចូលទៅចំណុចប្រសព្វនេះ ។
អ្នកបើកបរលឿនទេ ?
ខ្ញុំបើកបរកៅសិបប្រាំបួនគីឡូម៉ែត្រតមួយម៉ោង ។
តើអ្នកមានអាជ្ញាប័ណ្ណនិងការធានារ៉ាប់រងរបស់អ្នកទេ ?
បាទ នៅផ្លួវមួយកោសិបប្រាំបួនជិតប្លង ។
តើមានបន្ទប់ទឹកសាធារណៈណាជុំវិញនេះទេ ?
មិនមាននៅជុំវិញនេះទេ ។
នឹងមានតម្លៃប្រហែលកៅសិបប្រាំបួនដុល្លារ ។
កៅសិបប្រាំបួនដុល្លារអាចនឹងត្រប ។
តើវានឹងយូរទៅដល់កន្លែងនោះ ។
នឹងប្រើវេលាយ៉ាងហោចណាស់កៅសិបប្រាំបួនម៉ោង ។
សូមអភ័យទោសប៉ុន្តែខ្ញុំកំពុងប្រញាប់ ។
អ្នកអាចបង្ហាញអាហារសម្រន់នៅទីនេះបានទេ ?
ជារឿងត្រូវតែធ្វើនៅក្នុងកៅសិបប្រាំបួននាទីពីទីនេះ ។
ចុះទៅប្លុកកៅសិបប្រាំបួន ។
នៅលើជ្រុងខាងឆ្វេងផ្លូវ ។
ខ្ញុំមិនស៊ាំន្លែងនេះ ។
ប្រើវេលេយ៉ាងតិចកៅសិបប្រាំបួននាទី ។
បិតម៉ោងប្រាំបួន
សូមបន្ទប់ថ្មីបានទេ ?
ខ្ញុំបិចឱ្យខ្ញុំខ្ចីទេ ?
អ្នកធ្ងន់ប៉ុន្មានគីឡូ ?
ជាប្រាំបួនសូន្យប្រាំបួន ។
ខ្ញុំមិនមាននាឡិកា ។
ចាប់ផ្តើមពេលណា ?
ចាប់ផ្តើមនៅម៉ោងប្រាំបួន ។
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបវិធីប្រើទូរស័ព្ទនេះ ?
ទទួលហើយបន្ទាប់មកដាក់កាក់នៅក្នុងនោះ ។
ប្រើកាក់រយដប់ ។
ប្រើកាក់រយម្ភៃប្រាំ ។
ការចោទប្រកាន់ការលើកបីនាទីដំបូងនេះគឺដប់សេន ។
អ្នកអាចទទួលបានសញ្ញាប្រមាណវិធីដោយចុចសូន្យ ។
អ្នកគួរតែចុចសូន្យជាដំបូងនៅពេលដែលអ្នកហៅទូរស័ព្ទនិងលេខកូដតំបន់ផ្សេងទៀត ។
ការចោទប្រកាន់ចំនួនបីនាទីដំបូងនេះគឺជាម្ភៃសេន ។
ការចោទប្រកាន់ចំចំនួនបីនាទីដំបូងនេះគឺជាម្ភៃប្រាំសេន ។
អ្នកអាចផ្តល់អនុសាសន៍ណាក្នុងមួយយប់ ?
តើតាក់ស៊ីឈប់នៅទីនេះ ?
តម្លៃចូលប៉ុន្មាន ?
កៅសិបប្រាំបួនដុល្លារ ។
កៅសិបប្រាំបួនសេន ។
ខ្ញុំចង់ប្ដូរប្រាក់យ៉េនជាដុល្លារ ។
លិខិតឆ្លងដែនរបស់អ្នក ?
តើអ្នកចង់ប្ដូរប៉ុន្មាន ?
មានកៅសិបប្រាំបួនយ៉េន ។ សូមប្ដូរទាំងអស់ជាដុល្លារ ។
តើអ្នកចង់ឱ្យពិនិត្យការធ្វើដំណើររបស់លោក ?
លុយយ៉េនកៅសិបប្រាំបួនស្មើប៉ុន្មានដុល្លារ ?
កៅសិបប្រាំបួនដុល្លារ ។
តើអ្នកផ្ទេលុយធនាគាររបស់យើង ?
តើអ្នកដឹងវិធីផ្ទេរប្រាក់ ?
ឈ្មោះនៃផ្ទេរប្រាក់គឺអ្វី ?
តើអ្នកមានអ្វីដើម្បីកំណត់អត្តសញ្ញាណខ្លួនអ្នក ?
យើងបានទទួលការផ្ទេរប្រាក់ទៅកាន់អ្នក ។ សូមចុះហត្ថលេខានៅទីនេះ ។
យើងមិនបានទទួលការផ្ទេរប្រាក់ទៅកាន់អ្នកនៅឡើយទេ ។ អ្នកនឹងមកម្តងទៀតក្នុងរយៈពេលប៉ុន្មានថ្ងៃ ?
ខ្ញុំចង់ផ្ញើក្បាលដីនេះទៅប្រទេសជប៉ុន ។
ដោយអាកាសឬដោយគោក ?
តើអ្នកចង់ត្រូវការធ្វើធានា ?
តើផ្ញើកាតប៉ូស្ដាល់រូបភាពនេះទៅប្រទេសជប៉ុនថ្លៃប៉ុន្មាន ?
វាឡើងជាកៅសិបប្រាំបួនដុល្លារកៅសិបប្រាំបួនសេន ។
ខ្ញុំចង់ផ្ញើដោយបញ្ចេញមតិ ។
តើថ្លៃសេវាការចែកចាយពិសេស ?
ខ្ញុំចង់ចុះឈ្មោះ ។
តើថ្លៃសេវាការចុះបញ្ជីប៉ុន្មាន ?
ខ្ញុំចង់ផ្ញើដោយវិធីតម្លៃថោកបំផុត ។
ថ្លៃផ្ញើលិខិតទៅកាន់ប្រទេសជប៉ុនប៉ុន្មាន ?
ថ្លៃផ្ញើឥវ៉ាន់នេះទៅប្រទេសជប៉ុនប៉ុន្មាន ?
សូមដោះស្រាយវាជាមួយនិងការថែរ្សាវាជាអត្ថបទផុយស្រួយ ។
កុំបង្វែរវាចុះ ។
ខ្ញុំអាចផ្ញើសាច់ឆ្អើនទៅកាន់ប្រទេសជប៉ុន ?
ប្រហែលកៅសិបប្រាំបួនថ្ងៃ ។
ខ្ញុំចង់បានតែបកៅសិបប្រាំបួនកៅសិបប្រាំបួនសេន ។
ខ្ញុំចង់ផ្ញើទៅប្រទេសជប៉ុនដោយវិធីលឿនបំផុត ។
វាបានបោះពុម្ភ ។
វាគឺទស្សនាវដ្តី ។
តើខ្ញុំអាចផ្ញើផ្លែឈើទៅកាន់ប្រទេសជប៉ុន ?
តើខ្ញុំអាចផ្ញើនំទៅកាន់ប្រទេសជប៉ុន ?
តើខ្ញុំអាចផ្ញើសម្លៀកបំពាក់ទៅកាន់ប្រទេសជប៉ុន ?
តើខ្ញុំអាចផ្ញើស្រាទៅកាន់ប្រទេសជប៉ុន ?
វាមានផ្ទុកសៀវភៅ ។
វាមានផ្ទុកសម្លៀកបំពាក់ ។
វាមានផ្ទុករបស់ដំណាប់ ។
វាមានផ្ទុកប្រដាប់ក្មេងលេង ។
តើការមកដល់នៃការហោះហើរនេះនឹងត្រូវបានពន្យាពេលយូរប៉ុណ្ណា ?
យើងនឹងមកដល់ក្រោយកាលវិភាគ រយៈពេលប្រាំបួនម៉ោង ប្រាំបួននាទី ។
តើអ្នកចង់ទម្រេតកៅអីរបស់អ្នកទេ ?
តើអ្នកចង់បានទឹកមួយកែវទេ ?
តើអ្នកចង់យកថ្នាំអាស្ពីរីនខ្លះទេ ?
វាចុះតាមផ្លូវនេះ ។
វាគឺផ្លូវនោះ ។
ខ្ញុំញុំាថ្នាំ ។ តើអ្នកអាចយកទឹកមួយកែវអោយខ្ញុំបានទេ ?
វានឹងចំណាយពេលប្រហែលប្រាំបួនម៉ោងនិងប្រាំបួននាទី ។
ប្រហែលកៅសិបប្រាំបួនសប្ដាហ៍ ។
តើអ្នកស្នាក់នៅយប់នេះនៅកន្លែងណា ?
តើអ្នកយកលុយមកជាមួយអ្នកប៉ុន្មានដែរ ?
តើអ្នកមានសំបុត្រត្រឡប់ទៅជប៉ុនទេ ?
បាទ យើងមានឈ្មោះរបស់អ្នកនៅក្នុងសៀវភៅរបស់យើង ។
តើអ្នកអាចជួយបំពេញទម្រង់បែបបទនេះផងបានទេ ?
តើអ្នកនឹងស្នាក់នៅជាមួយយើងយូរប៉ុណ្ណាដែរ ?
តើភោជនីយដ្ឋានរបស់អ្នកបើកនៅម៉ោងប៉ុន្មាន ?
ពួកយើងបើកពីម៉ោងប្រាំបួនព្រឹក ។
តើម៉ោងប៉ុន្មានបាររបស់អ្នកបិទ ?
ពួកយើងបិទនៅម៉ោងប្រាំបួន ។
តើភោជនីយដ្ឋានរបស់អ្នកនៅជាន់ទីប៉ុន្មាន ?
តើខ្ញុំគួរចុះឈ្មោះចេញអោយបានមុនម៉ោងប៉ុន្មាន ?
សូមចុះឈ្មោះចេញអោយបានមុនម៉ោងប្រាំបួន ។
តើមានភោជនីយដ្ឋានជប៉ុនល្អនៅជុំវិញទីនេះទេ ?
អោយបានមុនម៉ោងប៉ុន្មានដែរ ?
បាររបស់អ្នកនៅជាន់ទីប៉ុន្មាន ?
តើមានភោជនីយដ្ឋានចិនល្អណាមួយដែលនៅជុំវិញទីនេះ ?
តើមានភោជនីយដ្ឋានអាហារសមុទ្រល្អណាមួយដែលនៅជុំវិញទីនេះ ?
តើមានភោជនីយដ្ឋានអ៊ីតាលីដ៏ល្អណាមួយដែលនៅជុំវិញទីនេះ ?
តើមានភោជនីយដ្ឋានបារាំងល្អនៅជុំវិញទីនេះទេ ?
វានៅជាន់ទីកៅសិបប្រាំបួន ។
អត់ទេ មិនមានសារសម្រាប់អ្នកនោះទេ ។
អ្នកអាចរំលឹកខ្ញុំនៅម៉ោងប្រាំបួន ព្រឹកថ្ងៃស្អែក ។
តើលេខបន្ទប់របស់នាងប៉ុន្មាន ?
ទូរទស្សន៍នៅក្នុងបន្ទប់របស់ខ្ញុំមិនដំណើរការ ។
ជាងជួសជុលរបស់យើងនឹងទៅដល់ទីនោះឆាប់ៗ ។
ម៉ាស៊ីនត្រជាក់ខូចហើយ ។ ខ្ញុំចង់អោយជួសជុលវាឥឡូវនេះ ។
យើងនឹងបញ្ចូនជាងទៅជួសជុលបន្តិចទៀតនេះ ។
ទឹកមិនចេញពីផ្កាឈូកងូតទឹក ។ សូមបញ្ចូនជាងមកមើលថាតើមានអ្វីខុស ។
បុគ្គលិករបស់យើងនឹងទៅដល់ទីនោះក្នុងមួយនាទីទៀត ។
ទ្វារបន្ទប់របស់យើងមិនអាចចាក់សោរបានទេ ។
តើអ្នកនឹងចេញក្រៅពេលនេះ ?
ទ្វារបន្ទប់ខ្ញុំមិនអាចចាក់សោរបានទេ ។
ទ្វារបន្ទប់របស់យើងមិនអាចដោះសោរបានទេ ។
តើខ្ញុំអាចសុំកូនសោរបន្ទប់របស់អ្នកបានទេ ?
ប្រាកដណាស់ ។ តើយើងអាចសុំការកុម្ម៉ង់របស់អ្នកបានទេ ?
ទ្វារបន្ទប់របស់ខ្ញុំមិនអាចដោះសោរបានទេ ។
តើកន្លែងគិតលុយនៅទីណា ?
ពួកគេនៅជាន់ទីកៅសិបប្រាំបួន ។
តើអ្នកមានម៉ូដនេះតែពណ៌ផ្សេងគ្នាដែរទេ ?
បាទ ពួកគេមានពណ៌ផ្សេងគ្នាមួយចំនួនដែរ ។
អត់ទេ យើងមានតែពណ៌នោះ ។
តើអ្នកមានម៉ូដនេះតែទំហំធំជាងនេះដែរទេ ?
គ្មានទេ នេះគឺជាទំហំតូចបំផុតនៃម៉ូដនេះ ។
តើអ្នកត្រូវការនូវទំហំប៉ុណ្ណា ?
បង្ហាញខ្ញុំទំនិញមួយចំនួនផ្សេងទៀតដែលមានគុណភាពខ្ពស់ ។
នេះជាទំនិញដែលមានគុណភាពល្អបំផុតដែលយើងមាន ។
តើខ្ញុំអាចលអានេះបានទេ ?
ប្រាកដណាស់ ។ បន្ទប់លសំលៀកបំពាក់គឺនៅទីនោះ ។
វាមិនល្អទេសម្រាប់ល ។
តើបញ្ជរសម្លៀកបំពាក់របស់ស្ត្រីនៅឯណា ?
តើបញ្ជរសម្លៀកបំពាក់របស់កុមារនៅឯណា ?
តើបញ្ជរស្បែកជើងនៅឯណា ?
តើបញ្ជរប្រដាប់ក្មេងលេងនៅឯណា ?
តើបញ្ជរទំនិញចម្រុះនៅឯណា ?
តើបញ្ជរគ្រឿងសំអាងនៅឯណា ?
តើបញ្ជរអាហារនៅឯណា ?
តើអ្នកមានម៉ូដនេះតែក្នុងទំហំតូចជាងនេះដែរទេ ?
វាអស់កៅសិបប្រាំបួនដុល្លារ និងកៅសិបប្រាំបួនសេន ។
តើអ្នកអាចកាត់បន្ថយតម្លៃនេះបានទេ ?
អត់ទេ យើងមិនអាចបញ្ចុះតម្លៃអោយអ្នកបានទេ ។
យើងមិនអាចទទួលយកកាតឥណទានទេ ។
ខ្ញុំចង់បង់ប្រាក់ដោយប្រើសែកអ្នកធ្វើដំណើរ ។
ខ្ញុំចង់ទិញវានៅហាងលក់ទំនិញមិនគិតពន្ធ ។
តើអ្នកអាចខ្ចប់និងផ្ញើវាទៅកាន់អាសយដ្ឋាននេះ នៅក្នុងប្រទេសជប៉ុនបានទេ ?
អត់ទេ យើងមិនផ្តល់ជូននូវសេវាបញ្ជូនបន្តទេ ។
យើងមានការសោកស្តាយយ៉ាងខ្លាំង ប៉ុន្តែវាអស់ពីស្តុក ។
ខ្ញុំចង់ទិញរបស់ទាំងនេះចំនួនកៅសិបប្រាំបួន ។
យើងមានការសោកស្តាយ ប៉ុន្តែយើងមិនមានស្តុកបន្ថែមទៀតនៃអត្ថបទនេះ ជាជាងអ្វីដែលយើងមាននៅទីនេះទេ ។
ចុះបើមួយនេះជំនួសវិញម៉េចដែរ ?
តើអ្នកបង្ហាញខ្ញុំរចនាម៉ូដមួយចំនួនផ្សេងទៀត ?
ប្រសិនបើអ្នកមានតុសម្រាប់អ្នកមិនជក់បារី ខ្ញុំនឹងចូលចិត្តមួយក្នុងចំណោមហ្នឹង ។
ខ្ញុំយល់ ។ សូមដើរតាមផ្លូវនេះ ។
សូមអភ័យទោស ប៉ុន្តែមិនមានតុបែបនេះទេ ។
តើការសំដែងនឹងចាប់ផ្តើមនៅម៉ោងប៉ុន្មាន ?
វានឹងចាប់ផ្តើមនៅម៉ោងប្រាំបួន ។
ការសំដែងថ្ងៃនេះគឺចប់អស់ហើយ ។
ខ្ញុំចង់ធ្វើការកុម្ម៉ង់ថែមទៀត ។ តើខ្ញុំអាចមើលបញ្ជីមុខម្ហូបម្តងទៀតបានទេ ?
តើបន្ទប់ទឹកនៅកន្លែងណា ?
សូមមកតាមផ្លូវនេះ ។
តើម្ហូបមួយណាដែលចុងភៅរបស់អ្នកណែនាំនៅថ្ងៃនេះ ?
ខ្ញុំចង់កក់កៅសិបប្រាំបួនកៅអី សម្រាប់ថ្ងៃបន្ទាប់ពីការសំដែងថ្ងៃស្អែកនេះ ។
ថ្លៃអស់កៅសិបប្រាំបួនដុល្លារអាមេរិក សម្រាប់មនុស្សម្នាក់ ។
កៅអីសម្រាប់កម្មវិធីថ្ងៃនេះត្រូវបានគេយកទាំងអស់ ។
កៅអីសម្រាប់ការបង្ហាញនៅថ្ងៃស្អែកនេះត្រូវបានគេយកទាំងអស់ ។
យើងជូនកៅសិបប្រាំបួនសម្រាប់ការសម្តែងក្នុងមួយថ្ងៃ ។ ជាការបង្ហាញដែលអ្នកចង់មើល ?
ខ្ញុំចង់ទិញកៅអីវង់តន្ត្រីលេខកៅសិបប្រាំបួន ។
បាទ មានកៅអីដែលអាចប្រើបានមានទេ ។
ពួកវាត្រូវបានគេយកទាំងអស់ ។
ខ្ញុំចង់ទិញកៅអីកៅសិបប្រាំបួនខាងលើ ។
ខ្ញុំចង់អង្គុយកៅអីដែលមានទេសភាពស្អាត ។ តើថ្លៃប៉ុន្មានដែរ ?
កៅសិបប្រាំបួនដុល្លារអាមេរិច ។
វាចាប់ផ្តើមនៅម៉ោងប្រំាបួន ។
ខ្ញុំចង់កក់កៅអីលេខកៅសិបប្រាំបួនសម្រាប់កម្មវិធីថ្ងៃនេះ ។
ខ្ញុំចង់កក់កៅអីកៅសិបប្រាំបួនសម្រាប់ការបង្ហាញនៅថ្ងៃស្អែកនេះ ។
តើម៉ោងប៉ុន្មាន ?
តើសំបុត្រប៉ុន្មានដែលអ្នកចង់ទិញ ?
ពួកយើងចង់លក់ទាំងអស់ចេញ ។
មានការសម្តែងទាំងពីរនៅរសៀលថ្ងៃនេះ ចាប់ពីម៉ោងប្រាំបីនិងពីប្រាំបួនមាន ។
មិនមានការសម្តែងទាំងបីនាក់នៅក្នុងពេលរសៀលពីប្រាំបីម៉ោង ប្រាំបួនម៉ោងនិងពីដប់ម៉ោងទេ ។
តើម៉ោងប៉ុន្មានដែលការសម្តែងចាប់ផ្តើមសម្តែង ?
វាចាប់ផ្តើមនៅម៉ោងប្រាំបួន ។
តើម៉ោងប៉ុន្មានដែលការសម្តែងចាប់ផ្តើមហួសការកំណត់ ?
ប្រហែលម៉ោងប្រំាបួនសើល ។
ខ្ញុំចង់ទិញសំបុត្រសម្រាប់ការសម្តែង ដែលបានចាប់ផ្តើមនៅម៉ោងប្រាំបួននេះ ។
តើអត្រាយ៉ាងម៉េចដែរ ?
កៅសិបប្រាំបួនដុល្លារសម្រាប់លើកដំបូងកៅសិបប្រាំបួនគីឡូម៉ែត្រ ។ ហើយកៅសិបប្រាំបួនដុល្លារសម្រាប់បន្ថែមកៅសិបប្រាំបួនគីឡូម៉ែត្រ ។
ទីនេះគឺជាផែនទីផ្លូវ ។
នៅពេលនេះគឺរថយន្ដក្រុងក្រោយ ?
ឡានដោយសារនៃលេខប្រាំបួន អូ ប្រាំបួន ។
នេះគឺជាតារាងពេល ។
