ការផ្ទៀងផ្ទាត់ត្រូវបានទាមទារដើម្បីប្រមូលព័ត៌មានប្រព័ន្ធសម្រាប់របាយការណ៍បញ្ហានេះ
របាយការណ៍បញ្ហាប្រព័ន្ធ
សូមបញ្ចូលព័ត៌មានលម្អិតរបស់អ្នក ដើម្បីចូលដំណើរការរបាយការណ៍បញ្ហានៃកម្មវិធីប្រព័ន្ធ
រាយការណ៍កំហុសទៅកាន់អ្នកអភិវឌ្ឍន៍
ក្រោយពេលផ្ញើរបាយការណ៍អំពីបញ្ហា សូមបំពេញសំណុំបែបបទនៅក្នុង កម្មវិធីរុករកបណ្ដាញដែលបានបើកដោយស្វ័យប្រវត្តិ ។
ត្រួតពិនិត្យជាមូលដ្ឋាន
រក្សាទុកឯកសាររបាយការណ៍សម្រាប់ផ្ញើ ឬចម្លងទៅទីតាំងផ្សេងទៀត
បោះបង់ និងមិនអើពើការគាំងរបស់កំណែកម្មវិធីកម្មវិធី
ឯកសាររបាយការណ៍អំពីបញ្ហា ៖
ប្រមូលព័ត៌មានអំពីបញ្ហា
ព័ត៌មានដែលបានប្រមូលអាចត្រូវបានផ្ញើទៅអ្នកអភិវឌ្ឍន៍ ដើម្បីធ្វើឲ្យកម្មវិធីប្រសើរឡើង ។ វាអាចចំណាយពេលវេលាពីរបីនាទី ។
ព័ត៌មានដែលបានប្រមូលកំពុងត្រូវបានផ្ញើទៅកាន់ប្រព័ន្ធតាមដានកំហុស ។ វាអាចចំណាយពេលពីរបីនាទី ។
ផ្លូវទៅកាន់ឯកសារ (ចូលដើម្បីបោះបង់) ៖
ចាប់ផ្ដើមកម្មវិធីរុករកឥឡូវនេះ
គ្មានរបាយការណ៍គាំងឡើយ ។ សាកល្បងជំនួយសម្រាប់ព័ត៌មានបន្ថែម ។
កញ្ចប់នេះហាក់បីដូចជាដំឡើងមិនត្រឹមត្រូវទេ
មិនស្គាល់កម្មវិធី
កម្មវិធីកុំព្យូទ័ររបស់អ្នកមិនមានអង្គចងចាំគ្រប់គ្រាន់ ដើម្បីធ្វើវិភាគដោយស្វ័យប្រវត្តិ ហើយផ្ញើរបាយការណ៍ទៅអ្នកអភិវឌ្ឍន៍ ។
របាយការណ៍បញ្ហាមិនត្រឹមត្រូវ
អ្នកមិនត្រូវបានអនុញ្ញាតឲ្យចូលមើលរបាយការណ៍បញ្ហានេះ ។
មិនមានទំហំគ្រប់គ្រាន់ ដើម្បីដំណើរការរបាយការណ៍នេះទេ ។
គ្មានកញ្ចប់បានបញ្ជាក់ទេ
លេខសម្គាល់ដំណើរការដែលបានបញ្ជាក់ មិនមែនជារបស់កម្មវិធីនេះទេ ។
ស្គ្រីបសញ្ញា %s មិនបានកំណត់កញ្ចប់ដែលមានប្រសិទ្ធភាពឡើយ
មិនអាចធ្វើរបាយការណ៍បានឡើយ
ធ្វើបច្ចុប្បន្នភាពរបាយការណ៍អំពីបញ្ហា
គ្មានព័ត៌មានបន្ថែមដែលបានប្រមូលឡើយ ។
មិនស្គាល់សញ្ញា
បញ្ជាក់ឈ្មោះកញ្ចប់ ។
បន្ថែមស្លាកខាងក្រៅដើម្បីរាយការណ៍ ។ អាចត្រូវបានបញ្ជាក់ពេលវេលាច្រើន ។
ចុចលើបង្អួចដែលជាគោលដៅសម្រាប់បំពេញរបាយការណ៍អំពីបញ្ហា ។
ឯកសាររបាយការណ៍កំហុសអំពីសញ្ញា ។ (បានបញ្ជាក់ ប្រសិនបើឈ្មោះសញ្ញាត្រូវបានផ្ដល់ជាអាគុយម៉ង់តែមួយ ។)
របាយការណ៍អំពីបញ្ហានេះអនុវត្តកម្មវិធីដែលមិនត្រូវបានដំឡើងទៀតឡើយ ។
របាយការណ៍អំពីបង្ហាញនេះខូច ហើយមិនអាចធ្វើបន្តបានទេ ។
របាយការណ៍ស្ថិតនៅក្នុងកញ្ចប់ដែលមិនត្រូវបានដំឡើង ។
កំហុសមួយបានកើតឡើង នៅពេលព្យាយាមដំណើរការរបាយការណ៍បញ្ហានេះ ៖
មិនអាចចាប់ផ្ដើមកម្មវិធីរុករកបណ្ដាញបានទេ
សូមបញ្ចូលព័ត៌មានអំពីគណនីរបស់អ្នកសម្រាប់ប្រព័ន្ធតាមដានកំហុស %s
មិនអាចតភ្ជាប់ទៅកាន់មូលដ្ឋានទិន្នន័យគាំងបានទេ សូមពិនិត្យមើលការតភ្ជាប់អ៊ីនធឺណិតរបស់អ្នក ។
ប្រព័ន្ធរបស់អ្នកមិនមានអង្គចងចាំគ្រប់គ្រាន់ ដើម្បីដំណើរការរបាយការណ៍គាំងនេះទេ ។
បញ្ហានេះត្រូវបានរាយការណ៍នៅក្នុងរបាយការណ៍កំហុស ដែលបង្ហាញនៅក្នុងកម្មវិធីរុករកបណ្ដាញ ។ សូមពិនិត្យមើល ប្រសិនបើអ្នកអាចបន្ថែមព័ត៌មានបន្ថែម ដែលអាផ្ដល់ជាប្រយោជន៍សម្រាប់អ្នកអ្នកអភិវឌ្ឍន៍ ។
អំឡុងពេលដែលបានកើតឡើង សម្ងំមុន និងបានការពារពីការធ្វើបន្តយ៉ាងត្រឹមត្រូវ ។
សរសេររបាយការណ៍ដែលបានកែប្រែទៅកាន់ឯកសារដែលបានផ្ដល់ជំនួសការផ្លាស់ប្ដូររបាយការណ៍ដើម
បង្កើតព័ត៌មានកញ្ចប់របស់របាយការណ៍ឡើងវិញ
បង្ហាញដានជង់ដែលបានតាមដានឡើងវិញ សួររកការអះអាងមុនពេលផ្ញើវាទៅកាន់មូលដ្ឋានទិន្នន័យគាំង ។
អាគុយម៉ង់មិនត្រឹមត្រូវ ប្រើ --ជំនួយសម្រាប់ជំនួយខ្លី
មើលទំព័រសម្រាប់ព័ត៌មានលម្អិត។
កម្មវិធី %s បានបញ្ឈប់ការឆ្លើយតប។
កម្មវិធី %s មានបទពិសោធន៍កំហុសខាងក្រៅ។
មិនអើពើនឹងបញ្ហានាពេលអនាគតនៃប្រភេទនេះ
ប្រមូលព័ត៌មានអំពីបញ្ហា
ព័ត៌មានដែលបានប្រមូលអាចត្រូវបានផ្ញើទៅកាន់អ្នកអភិវឌ្ឍន៍ ដើម្បីធ្វើឲ្យកម្មវិធីប្រសើរឡើង ។ វាអាចចំណាយពេលវេលាពីរបីនាទី ។
ផ្ទុកព័ត៌មានអំពីបញ្ហា
អ្នកអាចរង់ចាំដើម្បីមើល ប្រសិនបើមានឡើងវិញ បិទ ឬចាប់ផ្ដើមវាឡើងវិញ។
រាយបញ្ជីសោរបស់ក្រុមហ៊ុនលក់ដែលជឿទុកចិត្ត
មើលបញ្ជីរបស់សោដែលជឿទុកចិត្ត អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
សម្អាតឯកសារកញ្ចប់ដែលបានទាញយក អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
ផ្លាស់ប្ដូរការកំណត់រចនាសម្ព័ន្ធផ្នែកទន់
ផ្លាស់ប្ដូរការកំណត់ផ្នែកទន់ អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
ផ្លាស់ប្ដូរឃ្លាំងផ្នែកទន់
ផ្លាស់ប្ដូរការកំណត់ឃ្លាំងផ្នែកទន់ អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
ដំឡើងឯកសារកញ្ចប់
ដំឡើងកញ្ចប់នេះ អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
ធ្វើបច្ចុប្បន្នភាពព័ត៌មានកញ្ចប់
ធ្វើបច្ចុប្បន្នភាពកាតាឡុកផ្នែកទន់ អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
ដំឡើង ឬយកកញ្ចប់ចេញ
ដំឡើងកម្មវិធីពីឃ្លាំងបានដាក់ក្នុងបញ្ជីសដែលទុកចិត្ត។
ដើម្បីដំឡើងកម្មវិធី ដែលអ្នកត្រូវការផ្ទៀងផ្ទាត់។
ដំឡើងផ្នែកទន់ពីប្រភពថ្មី អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
បន្ថែមឃ្លាំងថ្មីនៃផ្នែកទន់ដែលបានជាវ ហើយដំឡើងកញ្ចប់ពីវា
ដំឡើងផ្នែកទន់ដែលបានជាវ អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
ធ្វើឲ្យកញ្ចប់ប្រសើរឡើង
ដំឡើងផ្នែកទន់ដែលបានធ្វើបច្ចុប្បន្នភាព អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
បោះបង់កិច្ចការរបស់អ្នកប្រើផ្សេងទៀត
បោះបង់ការផ្លាស់ប្ដូរផ្នែកទន់ផ្សេងទៀត អ្នកចាំបាច់ផ្ទៀងផ្ទាត់ភាពត្រឹមត្រូវ ។
