«មាន ក្រុមហ៊ុន ជា ច្រើន ទៀត មក ពី ប្រទេស កូរ៉េ ខាង ត្បូង និង អឺរ៉ុប ដែល យើង កំពុង ពិភាក្សា ទាក់ ទង ថា តើ ក្រុម ហ៊ុន ណា ដែល មាន បំណង បង្កើត រោង ចក្រ ដំឡើង រថយន្ត នៅ ប្រទេស ប៉ាគីស្ថាន នេះ»៕
សន្ទស្សន៍ផលិតកម្មនៅចិនធ្លាក់ចុះក្នុងខែកក្កដា
សន្ទស្សន៍ នេះ ត្រូវ បាន ចាត់ ទុក ថា ជា ឧបករណ៍ វាស់ ស្ទង់ ស្ថាន ភាព សេដ្ឋកិច្ច ដ៏ សំខាន់ មួយ ក្នុង ប្រទេស ដែល ជា មហា អំណាច អាស៊ី នេះ ដែល ជា កត្តា ជំរុញ សំខាន់ មួយ នៃ កំណើន សេដ្ឋកិច្ច សកល ។
ក្រុម សេដ្ឋ វិទូទាំង នោះ បាន ព្យាករ ថា រដ្ឋាភិបាល ចិន នឹង បន្ត បន្ធូរ បន្ថយ ឥណទាន នៅ ឆមាស ទីពីរ ឆ្នាំ ២០១៥ នេះ ក្នុង គោល បំណង ជំរុញ កំណើន សេដ្ឋកិច្ច។
ទោះ ជា មាន ការ ទទួល ស្គាល់ ពី តម្រូវ ការ ក្នុង ការ បង្អាក់ សេដ្ឋកិច្ច ចិន មិន ឲ្យ លូត ឡើង ខ្ពស់ ដើម្បី រក្សា និរន្តរភាព កំណើន សេដ្ឋកិច្ច កាន់ តែ ខ្លាំង ក្តី ក៏ អាជ្ញាធរ នៅ តែ ចាត់ វិធាន ការ ជំរុញ សេដ្ឋកិច្ច ដើម្បី បញ្ចប់ ការ ធ្លាក់ ចុះ ផង ដែរ៕
ថៃ-មីយ៉ាន់ម៉ា ចុះកិច្ចព្រមព្រៀងមិនយកថ្លៃទិដ្ឋាការ
គណៈ រដ្ឋ មន្ត្រី ថៃ បាន អនុម័ត កិច្ច ព្រម ព្រៀង នេះ កាល ពី ថ្ងៃទី ២១ ខែ មិថុនា សម្រាប់ ចុះ ហត្ថលេខា នៅ សប្តាហ៍ មុន នេះ។
កិច្ច ព្រម ព្រៀង នេះ នឹង ផ្តល់ លទ្ធភាព ឲ្យ ពលរដ្ឋ ថៃ និង មីយ៉ាន់ម៉ា ដែល មាន លិខិត ឆ្លង ដែន ធម្មតា ដើម្បី ធ្វើ ដំណើរ តាម អាកាស យានដ្ឋាន អន្តរ ជាតិ និង ស្នាក់ នៅ រហូត ដល់ ១៤ ថ្ងៃ។
ក្រុមហ៊ុន អាកាស ចរណ៍ ថៃ និង មីយ៉ាន់ម៉ា ភាគ ច្រើន ដំណើរ ការ ជើង ហោះ ហើរ រវាង ប្រទេស ទាំង ពីរ តាម អាកាស យាន ដ្ឋាន សុវណ្ណ ភូមិ និង ឈៀងម៉ៃ។
« កិច្ច ព្រម ព្រៀង នេះ ឆ្លុះ បញ្ចាំង ពី កិច្ច សហ ប្រតិបត្តិការ រឹងមាំ រវាង ប្រទេស ទាំង ពីរ ហើយ កិច្ច ព្រម ព្រៀង នេះ នឹង ជំរុញ វិស័យ ទេសចរណ៍ ពាណិជ្ជ កម្ម ព្រម ទាំង កិច្ច សហប្រតិបត្តិ ការ សេដ្ឋ កិច្ច ផ្សេង ទៀត ផង ដែរ ។
តែ មាន តែ ការ ធ្វើ ដំណើរ តាម ផ្លូវ អាកាស ប៉ុណ្ណោះ ដែល ត្រូវ បាន អនុញ្ញាត ក្នុង ជំហាន បឋម នេះ នៃ កិច្ច ព្រម ព្រៀង នេះ៕
ប៉ុន្តែ ក្រុម ហ៊ុន នេះ នៅតែ ជម្នះ នៅ ក្នុង ពាណិជ្ជកម្ម អេឡិចត្រូនិច ស្នូល របស់ ខ្លួន ជា មួយ នឹង តម្រូវ ការ កាន់តែ ខ្សោយ សម្រាប់ ទូរទស្សន៍ LCD លំដាប់ កណ្ដាល និង ឧបករណ៍ ស្ដាប់ ភ្លេង តាម លំនៅឋាន ខណៈ ដែល ក្រុមហ៊ុន ផ្លាស់ ប្តូរ ការ ផ្តោត លើ ទូរទស្សន៍ មាន តម្លៃ ខ្ពស់ ។
តៃវ៉ាន់ ថៃ ចូលកិច្ចព្រមព្រៀងលើកលែងពន្ធលើ ផលិតផលបច្ចេកវិទ្យាព័ត៌មាន
អង្គការ ពាណិជ្ជកម្ម ដែល មាន មូលដ្ឋាន នៅ ទីក្រុង ហ្សឺណែវ មួយ នេះ បាន ឲ្យ ដឹងថា ប្រទេស អាស៊ី ទាំង ពីរ បាន បញ្ជាក់ កាល ពី ថ្ងៃ អង្គារ អំពី ការ យល់ ព្រម របស់ ខ្លួនចំពោះ កិច្ច ព្រម ព្រៀង លុប ចោល ពន្ធ លើក ដំបូង របស់ អង្គការ ពាណិជ្ជកម្ម ពិភព លោក ក្នុង រយៈ ពេល ១៨ ឆ្នាំ។
អង្គការ ពាណិជ្ជកម្ម ពិភព លោក បាន ឲ្យ ដឹងថា ពាណិជ្ជកម្ម ផលិតផល ចំនួន ២០១ មុខ ប្រចាំ ឆ្នាំ ដែល មាន នៅ ក្នុង កិច្ច ព្រមព្រៀង នេះ ដើម្បី ពង្រីក កិច្ច ព្រម ព្រៀង បច្ចេក វិទ្យា ព័ត៌មាន នៅ ឆ្នាំ ១៩៩៧ ត្រូវ បាន ផ្តល់ តម្លៃ ជាង ១,៣ ពាន់ ពាន់ លាន ដុល្លារ។
ប្រភេទ ផលិតផល ជា ច្រើន នេះ រួមមាន បន្ទះ ឈីប កុំព្យូទ័រ ទំនើប ឧបករណ៍ GPS សំបក ម៉ាស៊ីន បោះពុម្ព និង ម៉ាស៊ីន វីឌីអូហ្គេម៕
«ការ វិនិយោគ ឯកជន របស់ ជប៉ុន នៅ ព្រះ រាជា ណាចក្រ កម្ពុជា ជា បន្ត បន្ទាប់ ជា បរិបទ ថ្មី មួយ ដែល បង្ហាញ ឲ្យ ឃើញ នូវ ការ ផ្តល់ ជំនឿ ទុក ចិត្ត ដល់ រដ្ឋាភិបាល កម្ពុជា និង ឆ្លុះ បញ្ចាំង ឲ្យ ឃើញ ពី តថ ភាព ពិត គឺ ស្ថិរភាព នយោបាយ ស្ថិរភាព សេដ្ឋកិច្ច និង ការ អភិវឌ្ឍ របស់ ប្រទេស កម្ពុជា»។
«បើ និយាយ ទៅ ខ្ញុំ មើល ឃើញ ថា វិនិយោគិន ជប៉ុន គាត់ ធ្វើ អ្វី មួយ គឺ គាត់ មាន ការ សិក្សា ល្អិត ល្អន់ និង មាន ការ ប្រយ័ត្ន ប្រយែង ខ្ពស់ ខុស ពី វិនិយោគ កូរ៉េ។
ជប៉ុន ធ្វើ ការ សិក្សា យ៉ាង តិច ក៏ ១៥ ឆ្នាំ ដែរ មុន នឹង បោះទុន វិនិយោគ នៅ ក្នុង ប្រទេស កម្ពុជា»។
«ក្នុង ឱកាស នៃ ការ ធ្វើ សមាហរណ កម្ម អាស៊ាន ខ្ញុំ គិត ថា កម្ពុជា នឹង មាន ឱកាស ច្រើន ក្នុង ការ ចូល រួម ប្រកួត ប្រជែង ក្នុង សេដ្ឋកិច្ច ទីផ្សារ អន្តរជាតិ ហើយ ថែម ទាំង អាច បង្កើត ការ អភិវឌ្ឍ មួយ កម្រិត ថែម ទៀត»។
ចំណតបង់ប្រាក់តាមម៉ាស៊ីននឹងបានការគាំទ្រខ្លាំង
យើង ទទួល បាន ការ យល់ ព្រម ពី សាលា រាជធានី ភ្នំពេញ ប្រហែល ជា ២ ឆ្នាំ មក ហើយ ដើម្បី ដំណើរ ការ គម្រោង សាកល្បង នេះ។
គម្រោង នេះ គឺ ដើម្បី មាន ចំណត រថយន្ត ត្រឹម ត្រូវ មួយ នៅ តាម ទីកន្លែង សាធារណៈ និង ដើម្បី កាត់ បន្ថយ ការ កក ស្ទះ និង គ្រោះ ថ្នាក់ ចរាចរណ៍ នៅ ក្នុង ទីក្រុង។
បច្ចុប្បន្ន យើង មាន ម៉ាស៊ីន ៣១ គ្រឿង កំពុង ដំឡើង នៅ ជុំវិញ វត្ត ឧណ្ណាលោម និង ជា គម្រោង សាកល្បង លើក ដំបូង ដែល វិនិយោគ ទឹក ប្រាក់ ប្រហែល ១០ម៉ឺន ដុល្លារ។
វា ជា គម្រោង សាកល្បង លើក ដំបូង ដូច្នេះ អតិថិជន អាច បង់ប្រាក់ ជា ម៉ោង សម្រាប់ ការ ប្រើ ប្រាស់ សេវា ចំណត នេះ។
ខ្ញុំ គិត ថា វា គឺជា តម្លៃ សមរម្យ សម្រាប់ ប្រជាជន កម្ពុជា។
ម្យ៉ាង ទៀត អតិថិជន ទទួល បាន សុវត្ថិភាព និង សន្តិសុខ ក្នុង រយៈពេល ២៤ ម៉ោង ចំពោះ ទ្រព្យសម្បត្តិ របស់ ពួក គេ។
ប្រព័ន្ធ ចំណត រថយន្ត បង់ ប្រាក់ តាម ម៉ាស៊ីន គឺ ថ្មី សម្រាប់ ប្រទេស កម្ពុជា។
ប្រជាជន កម្ពុជា មិន ទាន់ យល់ ដឹង ឬ ទម្លាប់ ប្រើ ប្រាស់ សេវា នេះ នៅ ឡើយ ប៉ុន្តែ យើង ពិត ជា សង្ឃឹម ថា ប្រជាជន កម្ពុជា នឹង ត្រឡប់ មក រក ពួក យើង បន្ទាប់ ពី ពួក គេ យល់ ថា វា ពិបាក ក្នុង ការ ចត រថយន្ត របស់ ពួក គេ នៅ តាម ទីកន្លែង សាធារណៈ ដែល ធ្វើ ឲ្យ មាន ការ ខឹង សម្បា ដល់ អ្នក ដំណើរ ផ្សេង ទៀត ដែល ប្រើប្រាស់ ផ្លូវ នោះ។
សម្រាប់ គម្រោង សាកល្បង នេះ យើង មិន អាច និយាយ ថា ទទួល បាន ជោគជ័យ នោះ ទេ វា ត្រូវ ការ រយៈពេល ជា ច្រើន ឆ្នាំ។
អ្វី ដែល យើង អាច និយាយ បាន គឺ យើង ចង់ ឲ្យ មាន ទីកន្លែង ចត រថយន្ត ត្រឹម ត្រូវ នៅ ទីក្រុង ភ្នំពេញ និង ដើម្បី បង្កើន មុខ មាត់ ទីក្រុង នៅ ជុំវិញ ទីតាំង សាធារណៈ។
នៅ សប្ដាហ៍ ដំបូង នៃ ការ ចាប់ ផ្ដើម ដំណើរ ការ សេវា ប្រព័ន្ធ ចំណត រថយន្ត នេះ កាលពី ខែ កក្កដា ឆ្នាំ ២០១៥ យើង ទទួល បាន រថយន្ត ប្រហែល ៦០០ គ្រឿង។
ពេល នេះ យើង កំពុង នាំ ចូល ម៉ាស៊ីន បន្ថែម ទៀត ប្រហែល ៦០ គ្រឿង ដើម្បី ដំឡើង នៅ តាម ទីកន្លែង ៣០ ផ្សេង ទៀត នៅ ទីក្រុង ភ្នំពេញ។
ផែន ការ នៅ ពេល អនាគត យើង នឹង រង់ចាំ ការ យល់ ព្រម ពី សាលា រាជធានី ភ្នំពេញ ដើម្បី ដំឡើង នៅ ទីកន្លែង ផ្សេង ទៀត នៅ ទីក្រុង ភ្នំពេញ។
ទី ពីរ ប្រជាជន មួយ ចំនួន ប្រើ ប្រាស់ កន្លែង របស់ ពួក យើង ដើម្បី ចត រថយន្ត របស់ ពួក គេ ដែល ប៉ះពាល់ ដល់ អ្នក ដែល ប្រើប្រាស់ សេវាកម្ម របស់ យើង។
ទី បី សាលា រាជធានី ភ្នំពេញ មិន ទាន់ អនុញ្ញាត ឲ្យ យើង ដំឡើង តាម ទីកន្លែង បន្ថែម ទៀត នោះ ទេ។
យើង ពិតជា សង្ឃឹម ថា ប្រជាជន កម្ពុជា នឹង គាំទ្រ ដល់ គម្រោង របស់ យើង និង ប្រើ ប្រាស់ ប្រព័ន្ធ ចំណត រថយន្ត របស់ យើង។
ម្យ៉ាង យើង នឹង ស្នើ សុំ សាលា រាជធានី ភ្នំពេញ ឲ្យ ជួយ សម្រួល ដល់ ប្រព័ន្ធ ចំណត រថយន្ត នេះ និង ផ្ដល់ ទីកន្លែង កាន់ តែ ច្រើន ដើម្បី ដំឡើង ម៉ាស៊ីន បន្ថែម ដើម្បី ជួយ សម្រួល ដល់ ការ ចត នៅ តាម ទីកន្លែង សាធារណៈ៕
លោក បន្ថែម ថា ខណៈ ឧស្សាហកម្ម ហិរញ្ញ វត្ថុ កំពុង រីក ចម្រើន វា មាន អត្ថ ប្រយោជន៍ ដើម្បី ចៀស វាង ការ ផ្ដល់ ប្រាក់ កម្ចី ច្រើន ដែល អាច នាំ ឲ្យ មាន បន្ទុក បំណុល លើស កម្រិត ។
លោក ស្រី ខៀវ បុប្ផា ភួង ប្រធាន នាយក ដ្ឋាន អាជ្ញា ប័ណ្ណ នៃ ធនាគារ ជាតិ នៃ កម្ពុជា ក៏ បាន សម្តែង ការ គាំទ្រ ចំពោះ ការ ស្ម័គ្រចិត្ត នេះ ផង ដែរ លោក ស្រី ថា ប្រតិបត្តិករ ផ្សេងៗ ទៀត នឹង ធ្វើ ការ សម្រេច ចិត្ត ក្នុង ការ ចូល ជា សមាជិក បន្ត បន្ទាប់ ទៀត ដើម្បី ការ ពារ ការ រីក ចម្រើន និង រក្សា បាន នូវ ភាព រឹង មាំ នៃ វិស័យ ហិរញ្ញវត្ថុ របស់ កម្ពុជា ។
លោក ប៊ុន មុនី ប្រធាន ក្រុម ប្រឹក្សា ភិបាល សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា បាន ឲ្យ ដឹង ថា គិត ត្រឹម ដំណាច់ ខែ មិថុនា សមាគម មាន សមាជិក ទាំង អស់ ចំនួន ៤៥ ដែល មាន គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ចំនួន ៤០ និង មាន ប្រតិបត្តិករ ឥណទាន ជន បទ ចំនួន ៥។
លោក ក៏ បាន ស្វាគមន៍ ចំពោះ ការ ចូល ជា សមាជិក របស់ ប្រតិបត្តិករ ឥណទាន ជនបទ ក្នុង ការ កសាង ទំនុក ចិត្ត បន្ថែម ទៀត ដល់ អតិថិជន របស់ ខ្លួន និង ការ ចូល រួម ចំណែក អភិវឌ្ឍ វិស័យ ហិរញ្ញវត្ថុ៕
បណ្តាញ ចែក ចាយ ឧស្ម័ន ធម្មជាតិ ដែល ជា កិច្ច សន្យា ដែល ត្រូវ បាន ចុះ ហត្ថលេខា កាល ពី ខែ ធ្នូ នឹង ត្រូវ សាង សង់ ឆ្លង កាត់ ខេត្ត ស៊ីនជាំង។
ក្រុម ហ៊ុន បច្ចេកវិទ្យា ធំ នេះ បាន បន្ត ឲ្យ ដឹង ថា បច្ចុប្បន្ន កម្មវិធី ទូរស័ព្ទ ទំនើប នេះ អាច អាន ភាសា បាន ចំនួន ២៧ និង បក ប្រែ អត្ថ បទ បាន ភ្លាមៗ ដោយ គ្មាន ការ តភ្ជាប់ អុីនធឺណិត ។
ការ បក ប្រែ អត្ថបទ ភ្លាមៗ នេះ បាន ចាប់ ផ្តើម ដំបូង ដោយ មាន ៧ ភាសា អង់គ្លេស បារាំង អាល្លឺម៉ង់ អុីតាលី ព័រទុយហ្គាល់ រុស្ស៊ី និង អេស្ប៉ាញ។
ភាសា ថ្មី ដែល ត្រូវ ដាក់ បញ្ចូល បន្ថែម មាន ភាសាប៊ុលហ្គារី កាតាឡាន ក្រូអាត ឆែក ដាណឺម៉ាក ហូឡង់ ហ្វីលីពីន ហ្វាំងឡង់ ហុងគ្រី ឥណ្ឌូនេស៊ី លីទុយអានី ន័រវែស ប៉ូឡូញ រូម៉ានី ស្លូវ៉ាគី ស៊ុយអែត តួកគី និង ភាសា អ៊ុយក្រែន។
« មាតិកា ជាង ពាក់ កណ្តាល នៅ បណ្តាញ អុីនធឺណិត ជា ភាសា អង់គ្លេស មាន តែ ប្រមាណ ២០ ភាគរយ នៃ ចំនួន ប្រជាជន ពិភព លោក ប៉ុណ្ណោះ និយាយ ភាសា អង់គ្លេស។
ឥណ្ឌូនេស៊ីទទួលបានការសន្យាផ្តល់កម្ចីជាង ១ ពាន់លានដុល្លារ
លោក ប្រាប់ ក្រុម អ្នក យក ព័ត៌មាន នៅ ក្រុង ហ្សាការតា ពី ម្សិលមិញ ថា៖
ប្រទេស ឥណ្ឌូនេស៊ី នឹង រឹត បន្តឹង លំហូរ ចេញ មូលនិធិ និង បម្រែ បម្រួល ទីផ្សារ នៅ ពេល ដែល ធនាគារ កណ្តាល អាមេរិក ចាប់ ផ្តើម ដំឡើង អត្រា ការ ប្រាក់ មិន ថា នៅ ឆ្នាំ នេះ ឬ ដើម ឆ្នាំ ក្រោយ នោះ ទេ។
«នេះ គឺជា ផ្នែក មួយ នៃ មធ្យោបាយ របស់ ពួក គេ ក្នុង ការ ព្យាយាម ធ្វើ ពិពិធកម្ម ប្រភព មូលនិធិ ចេញ ពី ទីផ្សារ»៕
ក្រុម ហ៊ុន នេះ បាន បន្ត ថា៖
តម្លៃ ប្រេង បាន ធ្លាក់ ចុះ ប្រមាណ ពាក់ កណ្តាល មក នៅ ត្រឹម តម្លៃ ក្រោម ៥០ ដុល្លារ ក្នុង មួយ ធុង គិត ចាប់ តាំង ពី ខែ មិថុនា ឆ្នាំ មុន ដោយ សារ ការ ផ្គត់ ផ្គង់ ប្រេង ខ្ពស់ ជាង តម្រូវ ការ ទីផ្សារ។
លោក ឧបនាយក រដ្ឋ មន្ដ្រី ប្រចាំ ការ គាត ឈន់ បាន ថ្លែង កាលពី ថ្ងៃ អង្គារ ក្នុង អំឡុង ជំនួប ជាមួយ ប្រធាន តំបន់ នៃ ទីភ្នាក់ងារ បារាំង សម្រាប់ ការ អភិវឌ្ឍន៍ (AFD) ប្រចាំ នៅ កម្ពុជា និង ឡាវ បាន ថ្លែង ថា បច្ចុប្បន្ន ប្រទេស នេះ មាន ស្ថិរភាព នយោបាយ ស្ថិរភាព ម៉ាក្រូ សេដ្ឋកិច្ច និង ស្ថិរភាព ហិរញ្ញវត្ថុ។
លោក បន្ត ថា កម្ពុជា មាន មហិច្ឆតា ប្រែ ក្លាយ ខ្លួន ទៅ ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ក្នុង ឆ្នាំ ២០៣០ ដោយ ចៀស វាង ការ ធ្លាក់ ចូល ក្នុង អង្គប់ នៃ ប្រទេស មាន ចំណូល មធ្យម តាម រយៈ ការ ដាក់ ចេញ នូវ គោល នយោបាយ អភិវឌ្ឍន៍ វិស័យ ឧស្សាហកម្ម ឆ្នាំ ២០១៥-២០២៥ និង ឯកសារ គោល នយោបាយ គួប ផ្សំ ផ្សេង ទៀត ហើយ ឈាន ឡើង ទៅ ជា ប្រទេស មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០។
«គោល នយោបាយ អភិវឌ្ឍ វិស័យ ឧស្សាហកម្ម គឺជា ក្របខ័ណ្ឌ យ៉ាង សំខាន់ ក្នុង ការ បង្កើត តម្លៃ បន្ថែម លើ ផលិតផល របស់ កម្ពុជា ការ អភិវឌ្ឍ ឧស្សាហកម្ម ប្រកប ដោយ ចីរភាព ដោយ ផ្សារ ភ្ជាប់ ជាមួយ ចង្វាក់ នៃ ការ ផ្គត់ផ្គង់ តំបន់ និង ពិភពលោក និង ដោយ ផ្ដោត ការ យក ចិត្ត ទុក ដាក់ ជា ពិសេស ដល់ ការ អភិវឌ្ឍ កសិ-ឧស្សាហកម្ម»។
ប៉ុន្តែ លោក បាន និយាយ ថា ជា មួយ នឹង ការ អនុវត្ត បាន យ៉ាង ល្អ ក្នុង អំឡុង ពេល ឆមាស ទី១ ឆ្នាំ នេះ ចំណូល ក្នុង មនុស្ស ម្នាក់ របស់ ប្រទេស នេះ នឹង កើន ឡើង។
«ប្រសិន បើ ប្រាក់ ចំណូល ពិត ក្នុង មនុស្ស ម្នាក់ របស់ ប្រទេស នេះ បន្ត កើន ឡើង វា មាន ន័យ ថា ជា មធ្យម ប្រជាជន កម្ពុជា មាន ប្រាក់ កាន់ តែ ច្រើន ដើម្បី ចំណាយ (ប្រាក់ ចំណូល ពិត គឺជា ការ កែ តម្រូវ តាម កម្រិត អតិផរណា) និង កម្រិត ជីវភាព រស់ នៅ របស់ ប្រជា ពលរដ្ឋ។
ប៉ុន្តែ ប្រសិន បើ ការ កើន ឡើង នៅ ក្នុង ប្រាក់ ចំណូល បច្ចុប្បន្ន អ្នក គួរ តែ ត្រួត ពិនិត្យ អតិផរណា។
ប្រសិន បើ អតិផរណា ខ្ពស់ ការ កើន ឡើង នូវ ក្នុង ប្រាក់ ចំណូល បច្ចុប្បន្ន មិន ជួយ បាន នោះ ទេ»។
ប្រទេស កម្ពុជា ឈរ នៅ លំដាប់ ទី៥ ក្នុង ចំណោម ប្រទេស កំពុង អភិវឌ្ឍន៍ ដែល អាច សម្រេច បាន គោល ដៅ អភិវឌ្ឍន៍ សហស្សវត្សរ៍ លឿន ជាង ទិស ដៅ ឆ្នាំ ២០១៥ ដែល បាន ដាក់ ដោយ អង្គការ សហ ប្រជាជាតិ។
យោង តាម ចំណាត់ ថ្នាក់ របស់ ធនាគារ ពិភពលោក ប្រទេស មាន ប្រាក់ ចំណូល កណ្ដាល ខ្ពស់ ត្រូវ បាន កំណត់ ដោយ ចំណូល ក្នុង មនុស្ស ម្នាក់ នៅ ចន្លោះ ពី ៤ ០៣៦ ដុល្លារ អាមេរិក ទៅ ដល់ ១២ ៤៧៥ ដុល្លារ អាមេរិក ខណៈ ដែល ប្រទេស មាន ប្រាក់ ចំណូល ខ្ពស់ ត្រូវ បាន កំណត់ ដោយ GDP ក្នុង មនុស្ស ម្នាក់ៗ ចំនួន ១២ ៤៧៦ ដុល្លារ អាមេរិក ឬ ច្រើន ជាង នេះ។
«ប្រសិន បើ ប្រាក់ ចំណូល ពិត របស់ ប្រទេស កម្ពុជា កើន ឡើង កាន់ តែ លឿន វា មាន ន័យ ថា កម្ពុជា នឹង អាច បញ្ចប់ ចំណាត់ ថ្នាក់ ជា ប្រទេស មាន ប្រាក់ ចំណូល ទាប ទៅ ជា ចំណាត់ ថ្នាក់ ជា ប្រទេស មាន ប្រាក់ ចំណូល កណ្ដាល ទាប កាន់ តែ ឆាប់។
ក្នុង ចំណាត់ ថ្នាក់ ចុង ក្រោយ ប្រទេស កម្ពុជា នឹង នៅ តែ ទទួល បាន ការ យក ចិត្ត ទុក ដាក់ ដ៏ ល្អ ទាក់ទង នឹង ការ រៀបចំ ការ ធ្វើ ពាណិជ្ជកម្ម ប៉ុន្តែ វា អាច មើល ឃើញ ថា នឹង មាន ការ កាត់ បន្ថយ ជំនួយ ពី ម្ចាស់ ជំនួយ។
វិនិយោគិនជប៉ុន៖ កំណើនប្រាក់ឈ្នួលត្រូវស្ថិតក្នុងកម្រិតសមស្រប
ការ លើក ឡើង នេះ ធ្វើ ឡើង ក្នុង កិច្ច ប្រជុំ គណៈកម្មាធិការ ចម្រុះ កម្ពុជា-ជប៉ុន លើក ទី ១២ កាល ពី ថ្ងៃ ម្សិលមិញ នៅ ក្រុម ប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ដែល មាន ការ ចូល រួម ពី អគ្គលេខាធិការ ក្រុម ប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ថ្នាក់ ដឹក នាំ និង តំណាង ក្រសួង ស្ថាប័ន កម្ពុជា ដែល ពាក់ព័ន្ធ នឹង ការ វិនិយោគ ថ្នាក់ ដឹក នាំ JICA អង្គការ ពាណិជ្ជកម្ម ក្រៅ ប្រទេស ជប៉ុន សមាគម ធុរកិច្ច ជប៉ុន នៅ កម្ពុជា និង វិនិយោគិន ជប៉ុន ប្រមាណ ៨០ នាក់។
សេចក្តី ប្រកាស ព័ត៌មាន ចេញ ផ្សាយ ក្រោយ កិច្ច ប្រជុំ នេះ បាន លើក ឡើង ថា៖
«វិនិយោគ ជប៉ុន បាន សម្តែង នូវ ការ យល់ ស្រប នូវ តម្រូវ ការ នៃ ការ ដំឡើង ប្រាក់ ឈ្នួល គោល អប្បបរមា ប៉ុន្តែ បាន សំណូម ពរ ឲ្យ ស្ថិត នៅ អត្រា កំណើន ដ៏ សមរម្យ មួយ ក្នុង គោល បំណង ការពារ ភាព ប្រកួត ប្រជែង នៃ វិស័យ ផលិតកម្ម នៅ កម្ពុជា»។
ប្រាក់ ឈ្នូល អប្បបរមា របស់ កម្មករ ក្នុង វិស័យ កាត់ដេរ នៅ កម្ពុជា បច្ចុប្បន្ន បាន កើន ដល់ ១២៨ ដុល្លារ បន្ទាប់ មាន ការ តវ៉ា ជា ច្រើន លើក ច្រើន សា រហូត ដល់ មាន ការ ផ្ទុះ អំពើ ហិង្សា ស្លាប់ កម្មករ មួយ ចំនួន កាលពី ដើម ឆ្នាំ ២០១៤។
ក្រុម សហជីព កម្មករ នៅ មិន ពេញ ចិត្ត នឹង កម្រិត នៃ ប្រាក់ ឈ្នួល នេះ នៅ ឡើយ ទេ ខណៈ មេបក្ស ប្រឆាំង ទាមទារ ឲ្យ រាជរដ្ឋាភិបាល ពិចារណា ដំឡើង ប្រាក់ ខែ គោល ដល់ កម្មករ ឲ្យ ១៨០ ដុល្លារ ក្នុង មួយ ខែ គិត ពី ដើម ឆ្នាំ ២០១៦។
លោក សុក ចិន្តាសោភា អគ្គ លេខាធិការ ក្រុម ប្រឹក្សា អភិវឌ្ឍន៍ (CDC) កម្ពុជា បាន ថ្លែង នៅ ក្នុង កិច្ច ប្រជុំ នោះ ថា លោក មាន ការ កោត សរសើរ ដល់ ក្រុមហ៊ុន ជប៉ុន ដែល បាន លើក ឡើង ពី កង្វល់ នានា និង សំណូមពរ មួយ ចំនួន របស់ ក្រុម វិនិយោគ ជប៉ុន។
«សំណូមពរ និង កង្វល់ ដែល ពាក់ព័ន្ធ នឹង កិច្ចការ វិនិយោគ របស់ ភាគី ក្រុម វិនិយោគ ជប៉ុន និង ជួយ កម្ពុជា ឲ្យ រក្សា បាន នូវ ភាព ទាក់ទាញ របស់ ខ្លួន ចំពោះ វិនិយោគ ជប៉ុន»។
បច្ចុប្បន្ន នេះ វិនិយោគិន ជប៉ុន កំពុង បង្ហាញ ចំណាប់ អារម្មណ៍ កាន់ តែ ខ្លាំង ឡើង ក្នុង ការ វិនិយោគ នៅ កម្ពុជា ដោយ សារ តែ តម្លៃ ពលកម្ម ទាប។
វត្តមាន នៃ គម្រោង វិនិយោគ របស់ ជប៉ុន ទាំង នេះ បង្ហាញ ឲ្យ ឃើញ ពី ភាព ទាក់ទាញ របស់ កម្ពុជា ចំពោះ វិយោគិន ជប៉ុន ក្នុង ការ ធ្វើ ធុរកិច្ច និង ពង្រីក ផលិតកម្ម ព្រម ទាំង ឆ្លុះ បញ្ចាំង ពី ជំនឿ ទុក ចិត្ត របស់ វិនិយោគ ជប៉ុន មក លើ រដ្ឋាភិបាល កម្ពុជា។
នេះ បើ យោង តាម សេចក្តី ប្រកាស ព័ត៌មាន។
តាម សេចក្តី ប្រកាស ព័ត៌មាន ដដែល បាន បន្ត ទៀត ថា ការ វិនិយោគ របស់ ក្រុមហ៊ុន ជប៉ុន ក៏ បាន ចូល រួម ចំណែក ដល់ ការ ធ្វើ ពិពិធ កម្ម មូលដ្ឋាន សេដ្ឋកិច្ច កម្ពុជា បន្ថែម លើ វិស័យ ជា ប្រពៃណី ដែល រួម មាន ឧស្សាហកម្ម កាត់ ដេរ សម្លៀក បំពាក់ និង ស្បែក ជើង វិស័យ កសិកម្ម និង រោង ម៉ាស៊ីន កិន ស្រូវ វិស័យ សំណង់ និង វិស័យ ទេសចរណ៍ ដោយ បញ្ចូល ឧស្សាហកម្ម ថ្មីៗ ដូច ជា ការ ផ្គុំ ដំឡើង សម្ភារ បរិក្ខារ អេឡិច ត្រូនិក និង អគ្គិសនី ការផលិត គ្រឿង បន្លាស់ រថយន្ត និង ការ ផ្គុំ ដំឡើង មធ្យោបាយ ដឹក ជញ្ជូន ជាដើម។
លោក គូម៉ាម៉ារុ យូជិ ឯកអគ្គ រាជទូត ជប៉ុន ប្រចាំ កម្ពុជា បាន លើក ឡើង ក្នុង សេចក្តី ប្រកាស ព័ត៌មាន ថា ជប៉ុន អរគុណ ចំពោះ ការ សម្រួល និង ការ ឆ្លើយ តប ជា វិជ្ជមាន ដល់ CDC ដល់ វិនិយោគិន ជប៉ុន។
លោក ក៏ បាន ស្នើ ឲ្យ មាន ស្មារតី សហការ នេះ បន្ត ទៀត ដើម្បី ជួយ សម្រួល ដល់ វិនិយោគិន ជប៉ុន ទៅ ថ្ងៃ មុខ បន្ត ទៀត។
គិត ត្រឹម ខែ មិថុនា ឆ្នាំ ២០១៥ កម្ពុជា បាន ស្វាគមន៍ គម្រោង វិនិយោគ ជប៉ុន ធំៗ ចំនួន ៩៩ ដែល មាន ទុន វិនិយោគ ជិត ៧០០ លាន ដុល្លារ អាមេរិក ក្នុង នោះ គម្រោង ចំនួន ៦៧ ដែល មាន ទុនវិនិយោគ ប្រមាណ ២៨០ លាន ដុល្លារ អាមេរិក វិនិយោគ នៅ ក្នុង តំបន់ សេដ្ឋកិច្ច ពិសេស។
បន្ថែម លើ ការ វិនិយោគ ធំៗ ទាំង នេះ ក៏ មាន ការ កើន ឡើង នូវ ចំនួន ភោជនីយដ្ឋាន ជប៉ុន ជា ច្រើន ដែល បច្ចុប្បន្ន មាន ចំនួន ប្រមាណ ១៥០ កន្លែង នៅ ក្នុង ប្រទេស កម្ពុជា៕
ធនាគាររុស្ស៊ី ស្វះស្វែងរកទីផ្សារនៅហុងកុង
ក្រុមហ៊ុន របស់ ប្រទេស រុស្ស៊ី មាន លទ្ធភាព ទទួល បាន កម្ចី ពី ធនាគារ របស់ ប្រទេស ចិន ទោះ បី ជា ការ ដាក់ ទណ្ឌកម្ម របស់ អាមេរិក និង អឺរ៉ុប ក៏ ដោយ បាន បិទ ទីផ្សារ ជាច្រើន របស់ ពិភពលោក ចាប់ តាំង ពី ជម្លោះ បាន ផ្ទុះ ឡើង នៅ ក្នុង ប្រទេស អ៊ុយក្រែន កាលពី ឆ្នាំ ២០១៤ ក៏ ដោយ។
ប្រទេស ចិន កំពុង ជំរុញ ឲ្យ ក្រុមហ៊ុន អន្តរជាតិ ដើម្បី លក់ មូលបត្រ Dim Sum ដែល គិត ជា ប្រាក់ យាន់ ខណៈ ដែល ខ្លួន ស្វែងរក ក្នុង ការ ធ្វើ ឲ្យ ប្រាក់ យន់ ក្លាយ ជា ដៃគូ ប្រកួត ប្រជែង នឹង ប្រាក់ ដុល្លារ អាមេរិក ជា រូបិយប័ណ្ណ បម្រុង។
ប្រាក់ យន់ មាន ប្រែ ប្រួល ដល់ កម្រិត ទាប បំផុត លើក ទី២ នៅ ក្នុង ចំណោម រូបិយប័ណ្ណ សំខាន់ៗ ហើយ គឺជា រូបិយប័ណ្ណ ដែល ប្រើ ប្រាស់ ច្រើន បំផុត ទី២ របស់ ពិភព លោក សម្រាប់ ហិរញ្ញប្បទាន ពាណិជ្ជកម្ម។
«ក្រុមហ៊ុន របស់ ប្រទេស រុស្ស៊ី មាន ការ ពិបាក ក្នុង ចេញ មូលបត្រ បំណុល ប្រាក់ ដុល្លារ អាមេរិក ខណៈដែល ក្រុមហ៊ុន មួយ ចំនួន ត្រូវ បាន គេ ដក ចេញ ពី ទីផ្សារ ដ៏ សំខាន់ នេះ ដោយ សារ តែ ការ ដាក់ ទណ្ឌកម្ម របស់ អាមេរិក និង អឺរ៉ុប»។
«វា ធ្វើ ឲ្យ យល់ ថា ក្រុមហ៊ុន របស់ ប្រទេស រុស្ស៊ី កំពុង ស្វែងរក ប្រភព ជំនួស ការ ផ្ដល់ ហិរញ្ញប្បទាន សម្រាប់ ពាណិជ្ជកម្ម របស់ ពួក គេ។
«យើង កំពុង បន្ត ឃ្លាំ មើល យ៉ាង ដិត ដល់ បំផុត លើ និន្នាការ ម៉ាក្រូ សេដ្ឋកិច្ច ពិភពលោក ជា ពិសេស កន្លែង មាន ភាព មិន ច្បាស់ លាស់ ដូចជា នៅ ក្នុង ទីផ្សារ ប្រទេស ចិន ប្រេស៊ីល និង រុស្ស៊ី»។
ចំនួន នោះ ធៀប នឹង ប្រាក់ ចំណេញ ១៤ ភាគរយ តាម រយៈ សន្ទស្សន៍ តម្លៃ គោល ក្រុមហ៊ុន DAX របស់ ប្រទេស អាល្លឺម៉ង់។
យីហោ ដូច គ្នា នេះ បាន បង្កើន កម្រិត ប្រាក់ ចំណេញ ការ លក់ នៅ ឆមាស ទី១ របស់ ខ្លួន ពី ២,១ ភាគរយ ដល់ ២,៧ ភាគរយ ដែល បាន ជួយ ដោយ ឥទ្ធិពល វិជ្ជមាន ពី កម្មវិធី ប្រកប ដោយ ប្រសិទ្ធភាព របស់ ក្រុមហ៊ុន។
តែ ក្រុម ហ៊ុន នេះ បាន ព្យាករ ថា ក្រុមហ៊ុន របស់ ខ្លួន អាច នឹង ងើប ផុត ពីការ ខាត បង់ នៅ ត្រី មាស ទីបី ដោយ សារ ទំនិញ ដែល មាន លទ្ធភាព ប្រកួត ប្រជែង ថ្មី និង កិច្ច ផ្តួច ផ្តើម ទីផ្សារ កាន់ តែ មាន ប្រសិទ្ធភាព។
ក្រុម ហ៊ុន នេះ បាន បន្ត ឲ្យ ដឹង ថា នៅ ត្រី មាស ទីបី និង ក្នុង ពេល ខាង មុខ ទៀត ក្រុម ហ៊ុន នេះ នឹង អនុវត្ត យុទ្ធសាស្រ្ត របស់ ខ្លួន ទ្វេ ដង ដោយ ផ្តោត លើ គ្រឿង អេឡិច ត្រូនិក តម្លៃ ខ្ពស់ ក៏ ដូច ជា ទូរស័ព្ទ ទំនើប តម្លៃ មធ្យម ដោយ កំណត់ ទិសដៅ ទីផ្សារ កំពុង អភិវឌ្ឍន៍ ខ្លាំង។
