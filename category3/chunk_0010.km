«ក្រុមហ៊ុន មួយ ចំនួន បាន កែសម្រួល តម្លៃ សេវា ដឹកជញ្ជូន នៅ ខែ ធ្នូ ហើយ នេះ គឺជា ហេតុផល ដែល ធ្វើឲ្យ អត្រា អតិផរណា កើនឡើង ខ្ពស់»។
ការ ដំឡើង ថ្លៃប្រេង ម៉ាស៊ូត និង ប្រេងសាំង ៣០ ភាគរយ ត្រូវ បាន ប្រកាស កាលពី ខែ វិច្ឆិកា ហើយ ត្រូវ បាន ធ្វើ ឡើង ក្នុង គោលបំណង កាត់បន្ថយ ការ ឧបត្ថម្ភធន របស់ រដ្ឋាភិបាល ដែល បាន ធ្វើឲ្យ រដ្ឋាភិបាល ខាតបង់ ច្រើន និង បាន បង្ក ឲ្យ វិនិយោគិន ប្រកាស អាសន្ន។
តុល្យភាព ពាណិជ្ជកម្ម បាន រងគ្រោះ ខណៈ វា បាន ធ្លាក់ ចូល ក្នុង ឱនភាព ចំនួន ៤២៥,៧ លាន ដុល្លារ ធៀប នឹង អតិរេក ចំនួន ២០ លាន ដុល្លារ កាលពី ខែ តុលា ខណៈ តម្លៃ ទំនិញ ដែល ជា ប្រភព ដ៏ចម្បង របស់ ប្រទេស ដែល សម្បូរ ធនធាន មួយ នេះ បាន ធ្លាក់ ចុះ។
«ទិន្នន័យ ទាំងនេះ កំពុង កើនឡើង អតិផរណា មាន កម្រិត ខ្ពស់ ជាង ការ រំពឹងទុក របស់ យើង ខណៈ ឱនភាព ពាណិជ្ជកម្ម មាន ទំហំ ធំ ជាង ការ ប៉ាន់ប្រមាណ របស់ យើង»។
តួលេខ ក្រោម ៥០ បង្ហាញ ថា ផលិតកម្ម ធ្លាក់ ចុះ ខណៈ តួលេខ លើ ៥០ បង្ហាញ ថា មាន កំណើន។
ស្ថិត ក្រោម បទប្បញ្ញត្តិ ក្ស័យធន កម្មករ របស់ ទីក្រុង នេះ បាន ធ្វើ សម្បទាន ហើយ សេវា ថែរក្សា សុខភាព របស់ និវត្តជន ត្រូវ បាន កាត់បន្ថយ ប៉ុន្តែ ប្រាក់ សោធន និវត្តន៍ របស់ ពួកគេ ភាគច្រើន ត្រូវ ទុក ឲ្យ នៅ ដដែល ។
« ហើយ អ្នក អាច មើល ឃើញ ការ រីកចម្រើន យ៉ាង ច្បាស់ នៅក្នុង ការ ស្ដារ ឡើង វិញ នៃ ទីក្រុង មួយ នេះ សហគ្រិន ដែល កំពុង ធ្វើ ដំណើរ មក កាន់ ទី នេះ គម្រោង សាងសង់ អគារ ធំៗ កំពុង ចាប់ផ្ដើម ដំណើរការ ហើយ ការងារ កំពុង ធ្វើ ដើម្បី កែលម្អ ការអប់រំ អ្នក ជិត ខាង និង សេវា របស់ ទីក្រុង នេះ » ។
នៅពេល នេះ វិចិត្រសាល ជាច្រើន កំពុង បើក ដំណើរការ នៅក្នុង ទីក្រុង នេះ ។
លោកស្រី មកពី ប្រទេស រ៉ូម៉ានី ដែល បាន ធ្វើ ដំណើរ មក អាមេរិក លើក ឡើង ថា ៖
« មាន មនុស្ស កាន់តែ ច្រើន កំពុង ធ្វើ ដំណើរ នៅ ក្បែរ វិចិត្រសាល នេះ ។
ឥណ្ឌាពិចារណាលើភាគហ៊ុនរដ្ឋនៅក្នុងធនាគារ
« យើង នឹង សម្រេចចិត្ត ក្នុង ដំណាក់កាល មួយ នៅពេល ក្រោយ» ។
ធនាគារ គ្រប់គ្រង ដោយ រដ្ឋ ដែល មាន ចំនួន ជាង ៧០ ភាគរយ នៃ ប្រាក់កម្ចី របស់ ប្រទេស ឥណ្ឌា មាន ប្រាក់ ទុន តិច ជាង ដៃគូ គ្រប់គ្រង ដោយ ឯកជន ខណៈ ទុន បម្រុង កាតព្វកិច្ច គ្រប់គ្រង របស់ រដ្ឋាភិបាល ៥១ ភាគរយ កម្រិត ទំហំ របស់ ពួកគេ ក្នុង ការ លក់ ភាគហ៊ុន ។
ចំនួន នោះ គឺ រឹតបន្តឹង ដល់ សមត្ថភាព ពួកគេ ដើម្បី បង្កើន ការ ផ្ដល់ ប្រាក់កម្ចី ឬ តម្រូវ ឲ្យ រដ្ឋាភិបាល ចាក់ បញ្ចូល សាច់ប្រាក់ ។
« ឆន្ទៈ របស់ រដ្ឋាភិបាល យល់ព្រម ពិចារណា ពី តម្រូវការ ចេញ ពី ធនាគារ មាន ភាព វិជ្ជមាន »។
« រចនាសម្ព័ន្ធ ក្រុមហ៊ុន ភាគហ៊ុន នឹង ផ្ដល់ ការ កែលម្អ ដល់ កិច្ចខិតខំ ប្រឹងប្រែង ការ ដាក់ ដើមទុន របស់ ធនាគារ និង ដាក់ ធនាគារ ទាំងនោះ នៅក្នុង ស្ថានការ មួយ កាន់តែ ល្អ ប្រសើរ » ។
ការ ពង្រឹង កម្លាំង របស់ ឧស្សាហកម្ម ហិរញ្ញវត្ថុ អាច ជួយ គាំទ្រ ដល់ កិច្ចខិតខំប្រឹងប្រែង របស់ លោក Modi ដើម្បី បង្កើន សេដ្ឋកិច្ច បន្ទាប់ពី ការ ឈ្នះឆ្នោត កាលពី ខែ ឧសភា ។
តួលេខទេសចរខេត្ត ៣ កើនលើសពីការរំពឹងទុកនៅក្នុងពិធីឆ្លងឆ្នាំ
លោក ឆឺយ ឆន អនុប្រធាន មន្ទីរទេសចរណ៍ ខេត្ត សៀមរាប បាន ឲ្យ ដឹង កាលពី ម្សិលមិញ ថា ចាប់ តាំងពី ថ្ងៃ ទី ៣០ រហូត ដល់ ថ្ងៃ ម្សិលមិញ ខេត្ត សៀមរាប បាន ទទួល ភ្ញៀវ សរុប ជាង ១០ ម៉ឺន នាក់ កើន ១៥,២០ ភាគរយ ធៀប រយៈពេល បុណ្យ ឆ្លង ឆ្នាំ ដូច គ្នា កាលពី ឆ្នាំ ២០១៣ ។
ផាប់ស្ទ្រីត ផ្សាររាត្រី និង កន្លែង ប្រគំតន្ត្រី ប្រមូលផ្តុំ ទៅ ដោយ ភ្ញៀវ »។
ខេត្ត ព្រះសីហនុ ដែល ល្បី ដោយសារ ឆ្នេរសមុទ្រ ស្អាត នោះ ក៏ ទទួល បាន ភ្ញៀវ ប្រមាណ ១១ ម៉ឺន នាក់ ផង ដែរ ក្នុង រយៈពេល បី ថ្ងៃ នៃ ពិធីបុណ្យ ឆ្លងឆ្នាំ នេះ។
លោក នូ សុផល ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ព្រះសីហនុ បាន ឲ្យ ដឹង ថា ខណៈ ការ រំពឹងទុក ថា មាន ភ្ញៀវ ប្រមាណ តែ ៧ ម៉ឺន នាក់ ប៉ុណ្ណោះ ដែល ចូលរួម តែ តួលេខ បាន កើន ដល់ ១១ ម៉ឺន នាក់ នៅ យប់ ឆ្លង ឆ្នាំ តែ ម្តង។
« តួលេខ ភ្ញៀវ កើន ដល់ ១១ ម៉ឺន នាក់ ភាគច្រើន ជា ភ្ញៀវ ជាតិ ដែល មក ចូលរួម ទស្សនា ការ បាញ់ កាំជ្រួច និង ការ ប្រគំតន្ត្រី នៅ ឆ្នេរ អូរឈើទាល »។
លោក បន្ត ថា ការ រៀបចំ ឆ្នាំ នេះ មាន លក្ខណៈ ប្រសើរ និង ទទួល បាន ជោគជ័យ ជាង នៅក្នុង ឆ្នាំ មុន។
ជាមួយ នឹង ការ ព្យាយាម ក្នុង ការ ទាក់ទាញ ភ្ញៀវទេសចរ បរទេស ខេត្ត បាត់ដំបង ដែល ជា ទិសដៅ ទេសចរណ៍ កំពុង រីកចម្រើន ដោយសារ អគារ បេតិកភ័ណ បន្សល់ទុក ពី សម័យ អាណានិគម និយមបារាំង បាន បង្កើត ហាង តាម ដងផ្លូវ សាធារណៈ និង ផ្សាររាត្រី ជាដើម ។
ជា ការ ប្រារព្ធ ពិធី ចូល ឆ្នាំ សកល លើក ដំបូង ខេត្ត នេះ បាន មើលឃើញ មនុស្ស ជាច្រើន គួរ ឲ្យ កត់សម្គាល់ ចូលរួម ពិធីបុណ្យ នេះ ។
នេះ បើ តាម លោក អ៊ុច ឱមធីនី សារ៉ា ប្រធាន មន្ទីរទេសចរណ៍ ខេត្ត បាត់ដំបង ។
លោក ថ្លែង ថា ខណៈ ភាគច្រើន នៃ អ្នក មក ចូលរួម គឺជា ភ្ញៀវ ទេសចរ ក្នុង ស្រុក ៣០ ភាគរយ គឺជា ភ្ញៀវទេសចរ បរទេស មកពី ខេត្ត សៀមរាប និង ប្រទេស ថៃ ។
លោក បន្ថែម ថា ខេត្ត នេះ នឹង ប្រារព្ធ ពិធី នេះ កាន់តែ ធំ នៅ ឆ្នាំ ក្រោយ ដើម្បី ក្លាយ ជា ទិសដៅ ទេសចរណ៍ បន្ទាប់ពី ខេត្ត សៀមរាប និង ខេត្ត ព្រះសីហនុ ៕
សក្តានុពលនិងបញ្ហាប្រឈមក្នុងការធ្វើអាជីវកម្មនៅ កម្ពុជា
តើ អ្វីជា បញ្ហា ប្រឈម ដែល លោក ឃើញ សម្រាប់ ការ ចាប់ ផ្ដើម អាជីវ កម្ម នៅ កម្ពុជា ?
បញ្ហា ប្រឈម ធំ ៗ សម្រាប់ ការ ចាប់ ផ្ដើម អាជីវ កម្ម នៅ កម្ពុជា គឺ ៖
គេ ហទំព័រ លក់ សំបុត្រ រថ យន្ត ក្រុង គឺជា ការ ចាប់ ផ្ដើម ជា លើក ដំបូង ។
ពេលនេះយើង កំពុង ផ្ដោត លើ សំបុត្រ រថ យន្ត ក្រុង តែ ប៉ុណ្ណោះ និង កំពុង កំណត់ ទិសដៅ លើ ការ ធ្វើដំ ណើរ អន្តរ ជាតិ មក កាន់ ប្រទេស កម្ពុជា និង ក្នុង តំបន់ ផង ដែរ ។
តើ អ្នក មាន គំនិត ផ្សេង ដែល អ្នក អាច ចែក រំលែក ពី ទស្សនៈ នៅ ក្នុង ប្រទេស កម្ពុជា?
ប្រព័ន្ធអនុគ្រោះបានជួយជំរុញដល់ការនាំចេញ
ប្រទេស កម្ពុជា ក្នុង នាម ជា ប្រទេស មាន ការ អភិវឌ្ឍ តិចតួច (LDC) បាន ទទួល ការ លើកលែង ពន្ធ ក្នុង ការ នាំ ចេញ ទំនិញ ទៅ ប្រទេស អភិវឌ្ឍន៍ ជាច្រើន ដូចជា សហគមន៍ អឺរ៉ុប និង អាមេរិក ហើយ កត្តា នេះ បាន ក្លាយ ជា ឧត្តមភាព ប្រកួតប្រជែង មួយ របស់ កម្ពុជា ជាច្រើន ឆ្នាំ មក ហើយ ក្នុង ការ បង្កើន ប្រាក់ នាំ ចេញ ទំនិញ ប្រចាំ ឆ្នាំ ។
យ៉ាងណា ក៏ដោយ អ្នកជំនាញ ផ្នែក សេដ្ឋកិច្ច បាន ក្រើន រំឭក ថា ការ ទទួល បាន ប្រព័ន្ធ អនុគ្រោះ ពន្ធ ពាណិជ្ជកម្ម នឹង មិន អាច កើត មាន សម្រាប់ ប្រទេស កម្ពុជា ជា រៀងរហូត នោះ ទេ ដ្បិត ប្រព័ន្ធ នេះ គ្រាន់តែ ជា ជំនួយ ក្នុង អំឡុង ពេល បណ្តោះអាសន្ន មួយ សម្រាប់ ឲ្យ កម្ពុជា ត្រៀម ខ្លួន ក្នុង ការ ប្រកួតប្រជែង ពេញលេញ នៅលើ ទីផ្សារ អន្តរជាតិ នៅ ថ្ងៃ ខាង មុខ ។
លោកស្រី ចន្ធី អ្នកជំនាញ ផ្នែក សេដ្ឋកិច្ច ឯករាជ្យ បាន លើក ឡើង ថា ៖
« ប្រព័ន្ធ អនុគ្រោះ ពន្ធ ជា ជំនួយ ដ៏សំខាន់ ឲ្យ យើង បាន ដកដង្ហើម ដើម្បី ត្រៀម ខ្លួន ទៅ ថ្ងៃ ខាង មុខ ។
តាមពិត ទៅ យើង មាន សមត្ថភាព នាំ ចេញ គ្រាន់ បើ ជាង ឆ្នាំ មុនៗ ប៉ុន្តែ យ៉ាងណា ក៏ដោយ យើង ត្រូវ ព្យាយាម បន្ថែម ទៀត ដើម្បី អាច នាំ ចេញ ទំនិញ ដោយ មិន ចាំបាច់ ពឹងផ្អែក ខ្លាំង ពេក លើ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ»។
លោក បន្ត ថា ប្រសិនបើ កម្ពុជា អាច នាំចេញ ទំនិញ កាន់តែ ច្រើន ឡើង ទៅ ទីផ្សារ អន្តរជាតិ ដោយ ចាំបាច់ មាន ប្រព័ន្ធ អនុគ្រោះ ពន្ធ វា នឹង បង្ហាញ ថា កម្ពុជា មាន សមត្ថភាព កាន់តែ ខ្លាំង ក្នុង ការ ប្រកួតប្រជែង ជាមួយ ប្រទេស នានា។
គិត មក ទល់ ពេល នេះ កម្ពុជា នៅ មាន ប្រភេទ ទំនិញ នាំចេញ នៅ មាន កម្រិត នៅ ឡើយ ដែល ជា ផលិតផល សម្រេច ដូចជា សម្លៀកបំពាក់ ស្បែកជើង អង្ករ កង់ ខណៈ ដែល ផលិតផល ជា គ្រឿង អគ្គិសនី ឬ អេឡិចត្រូនិក ទើប ត្រូវ បាន ចាប់ផ្តើម មាន ការ នាំ ចេញ បន្តិច ម្តងៗ នៅ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ។
បើ ទោះបី សេដ្ឋកិច្ច ប្រទេស កម្ពុជា បាន ពឹងផ្អែក ខ្លាំង លើ វិស័យ កសិកម្ម តែ ភាគច្រើន នៃ ការ នាំចេញ ផលិតផល កសិផល គឺជា ផលិតផល មិន ទាន់ កែច្នៃ ហើយ ហូរ ចេញ ទៅ ប្រទេស ជិត ខាង ក្នុង តម្លៃ ទាប។
កាលពី ឆ្នាំ ២០១៤ កម្ពុជា បាន នាំ ចេញ ផលិតផល កសិកម្ម សរុប ទៅ ប្រទេស វៀតណាម ដោយ មិនទាន់ កែច្នៃ មាន ទឹកប្រាក់ ជិត ៥០ លាន ដុល្លារ ។
នេះ បើ តាម ទិន្នន័យ ក្រសួង ពាណិជ្ជកម្ម ។
ក្នុង នោះ ផលិតផល នាំ ចេញ សំខាន់ៗ រួមមាន គ្រាប់ ស្វាយចន្ទី ពោត សណ្តែកដី អង្ករ ដំឡូងមី ស្រស់ ចំណិត ដំឡូងមី កៅស៊ូ និង សណ្តែកសៀង ជាដើម ។
លោក កែន រដ្ឋា អ្នក នាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា បាន ឲ្យ ដឹង ថា តួលេខ នៃ ទឹកប្រាក់ ពី ការ នាំចេញ ទំនិញ របស់ កម្ពុជា ត្រូវ បាន រំពឹង ថា នឹង កើនឡើង នៅ ប៉ុន្មាន ឆ្នាំ ខាង មុខ។
« យើង ត្រូវការ ពេលវេលា ប៉ុន្តែ វា ជា ការ ប្ដេជ្ញាចិត្ត របស់ រដ្ឋាភិបាល ក្នុង ការ បង្កើន តួលេខ ការ នាំចេញ ។
លោក អាបេប្តេជ្ញាធ្វើកំណែទម្រង់ជំរុញសេដ្ឋកិច្ច
លោក បាន ឲ្យ ដឹង ក្នុង សេចក្តី ថ្លែង ការណ៍ អបអរ ឆ្នាំ ថ្មី របស់ លោក រយៈ ពេល ប៉ុន្មាន សប្តាហ៍ មុន ពេល ឈ្នះ ឆ្នោត យ៉ាង ភ្លូកទឹកភ្លូកដី ថា៖
ដោយ សំដៅ ដល់ កំណែ ទម្រង់ ដូច ជា ការ កាត់ បន្ថយ ការ គ្រប់គ្រង ក្នុង វិស័យ ថាមពល និង កសិកម្ម លោក បាន បញ្ជាក់ ថា៖
« យើង នឹង អនុវត្ត យុទ្ធសាស្រ្ត ជំរុញ កំណើន សេដ្ឋកិច្ច របស់ យើង ដោយ ម៉ឺងម៉ាត់ អនុវត្ត វិធានការ ជំរុញ សេដ្ឋកិច្ច ឲ្យ បាន ឆាប់ រហ័ស »។
« ឆ្នាំនេះ ខ្ញុំ នឹង បន្ត អនុវត្ត កំណែទម្រង់ ឲ្យ កាន់ តែ ស៊ីជម្រៅថែមទៀត ដោយ មាន ល្បឿន កាន់ តែ លឿន »។
មុខ ព្រួញ ទីបីនៅក្នុង គោល នយោ បាយ របស់ លោក គឺ ជា កំណែ ទម្រង់ រចនា សម្ព័ន្ធ ដែល ចាំ បាច់ បំផុត ។
សុន្ទរកថា របស់ លោក ក៏ បាន បញ្ជាក់ ផង ដែរថា ឆ្នាំ២០១៥ នេះ បង្ហាញពី ខួប លើកទី ៧០ នៃ ការ បញ្ចប់ សង្គ្រាម លោកលើកទីពីរ និង បង្ហាញ ថា ប្រទេស ជប៉ុនដែល មានការ សោក ស្តាយ បំផុត ចំពោះ ទង្វើ ដ៏ សាហាវ យង់ ឃ្នង ក្នុង អំឡុង ពេល សង្គ្រាម របស់ ខ្លួន បាន ធ្វើ ដំណើរ តាមមាគ៌ា នៃ ប្រទេស ប្រកាន់ លទ្ធិប្រជាធិបតេយ្យ និង សេរី និង ជា ប្រទេស ដែល ស្រឡាញ់ សន្តិ ភាព រហូត មក។
ការ អធិប្បាយ របស់លោក បាន ធ្វើ ឡើង ខណៈ លោក ព្យាយាម រឹតចំណង មិត្ត ភាព ជាមួយ នឹង ប្រទេស ចិន ដែល ជា គូបដិបក្ខ ចាស់ ដែល ប្រទេស ជប៉ុន ធ្លាប់មាន ពាក់ ព័ន្ធក្នុង ជម្លោះដែនដី ដ៏ ជូរចត់ ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំចុង ក្រោយ នេះ។
« នៅពេល យើង រំឭកពី អតីតកាល ខ្ញុំ សូម បួង សួង ឲ្យ ឆ្នាំនេះគឺ ជា ឆ្នាំមួយ ដែល យើង ផ្ញើសារ ទៅកាន់ ពិភពលោក អំពី ប្រទេស របស់ យើង។
យើង មានគោលបំណង បើកទំព័រ ថ្មី ឆ្ពោះទៅ កសាង ប្រទេស ជប៉ុន ទំនើបមួយ »។
លោក នាយក រដ្ឋ មន្ត្រី រូប នេះ ពុំ បាន ផ្តល់ ព័ត៌មានលម្អិត ថា តើ ប្រទេ ស ជប៉ុន ថ្មីនោះជា អ្វី ទេ ៕
ដោយ ពុំ បាន បញ្ជាក់ ពី ទំហំ វិនិយោគ ក្រុមហ៊ុន BAIC បាន បន្ត ឲ្យ ដឹងថា ទិន្នផល រថយន្ត ប្រចាំ ឆ្នាំ នឹង មាន ចំនួន៣០ម៉ឺនគ្រឿង នៅ តាម រោង ចក្រ នីមួយៗ។
ក្រុមហ៊ុនផលិត រថយន្ត របស់ កូរ៉េ ខា ង ត្បូងមួយនេះ មាន រោង ចក្រផលិត រថយន្ត ចំនួន ៣កន្លែង រួច ទៅ ហើយ នៅ ប្រទេស ចិន ដែល ក្រុម ហ៊ុន របស់ ខ្លួន កំពុង ប្រឈមនឹង ការ ប្រកួត ប្រជែង កាន់ តែ ខ្លាំង និង ជាប់ ចំណាត់ ថ្នាក់ ទីបួន ក្នុង ការ លក់ រថយន្ត ក្នុង ចំណោម ម៉ាក រថយន្ត បរទេស។
សមត្ថភាព ផលិត រថយន្ត នេះ ធៀបនឹង ផលិត រថយន្ត ប្រចាំ ឆ្នាំ ជាង៣,១ លានគ្រឿង របស់ ក្រុមហ៊ុន នេះ នៅ ឆ្នាំ២០១៣។
រីឯក្រុមហ៊ុន GM វិញ គ្រោង នឹង ចំណាយ ថវិកា ចំនួន១៤ លាន ដុល្លារ ចាប់ ពី ឆ្នាំ២០១៤ ដល់ ឆ្នាំ២០១៨ ដើម្បី បើក ដំណើរ ការ រោង ចក្រ ដំឡើង រថយន្ត ថ្មី ចំនួន ៥កន្លែង និង ជំរុញ ដល់ ការ លក់ រថយន្ត និង រថយន្ត ដឹក ទំនិញ ប្រចាំ ឆ្នាំ ប្រមាណ ៥ លាន គ្រឿង នៅ ប្រទេស ចិន នេះ បើយោង តាម ក្រុមហ៊ុន កាល ពី ខែ តុលា។
ក្រសួង ពាណិជ្ជកម្ម បាន បន្ត ឲ្យ ដឹងថា ជា លទ្ធផល អតិរេក ពាណិជ្ជកម្ម របស់ កូរ៉េ ខាង ត្បូង បាន កើនឡើង ដល់ កម្រិត ខ្ពស់ បំផុតគឺ ៤៧,៤១ ពាន់ លាន ដុល្លារ។
អតិរេក ពាណិជ្ជកម្ម បានកើនឡើង ដល់ ៥,៧៨ ពាន់ លាន ដុល្លារ នៅ ខែ ធ្នូ ធៀបនឹង ចំនួន ៥,៥១ ពាន់ លាន ដុល្លារ នៅ ខែ វិច្ឆិកា។
ក្រសួង ពាណិជ្ជកម្ម បាន ចាត់ ទុក ថា កំណើន នាំ ចេញ នៅ ឆ្នាំ ២០១៤ មួយផ្នែក ទទួល បាន ដោយ សារ កិច្ចព្រមព្រៀង ពាណិ ជ្ជ កម្ម សេរី របស់ ប្រទេស កូរ៉េ ខាង ត្បូង ដូចជា កិច្ចព្រមព្រៀង ពាណិ ជ្ជ កម្ម សេរី ជាមួយ នឹង សហរដ្ឋ អាមេរិក ជា ដើម។
ក្រសួង នេះ បានព្យាករ ថា ការ នាំ ចេញ សរុប របស់ កូរ៉េ ខាង ត្បូង អាច នឹង កើនឡើង៣,៧ ភាគ រយ ដល់៥៩៤ ពាន់ លាន ដុល្លារ នៅ ឆ្នាំ នេះ៕
ការលក់សំបុត្រកុននៅចិនកើន៣៦ភាគរយនៅឆ្នាំមុន
ប្រទេស ចិន អនុញ្ញាតឲ្យ ចាក់ បញ្ចាំង រឿង កុន បរទេស ត្រឹម តែ ៣៤ ភាគ រយ ប៉ុណ្ណោះ នៅ ក្នុង ប្រទេស នេះ រៀង រាល់ ឆ្នាំ ដោយ មានការ ត្រួត ពិនិត្យ ជាមុនពី មន្ត្រីផ្នែកវប្បធម៌ ។
កាល ពី ឆ្នាំមុន ប្រទេស ចិន បាន បង្កើត រោង កុន ជាង ១ ពាន់ កន្លែង ទៀត និង អេក្រង់ បញ្ចាំង កុន ជិត៥៤០០ ដោយ ធ្វើ ឲ្យ អេក្រង់ សរុប បានកើនឡើង ដល់ ជាង ២៣០០០ នៅទូទាំង ប្រទេស៕
នីហ្សេរីយ៉ានឹងរក្សាបានកំណើនសេដ្ឋកិច្ចដូច២០១៤
ក្រុមហ៊ុន ដែល មាន មូលដ្ឋាន នៅ ទី ក្រុង ស៊ូវ៉ុន មួយ នេះ បាន ឲ្យ ដឹង ក្នុង សេចក្តី ថ្លែង ការណ៍ មួយ កាល ពី ថ្ងៃ ម្សិលមិញ ថាទូរ ទស្សន៍ ស៊េរី ថ្មីនេះ អាច ប្រើ ប្រាស់ មាតិកា និង ប្រើ ប្រាស់ ជាមួយនឹង គ្រឿងអេឡិចត្រូនិក ចល័ត មួយ ចំនួន ដូចជា ទូរស័ព្ទ ទំនើបនិង កុំព្យូទ័រ ថេប្ល៊ិត បាន ដើម្បី បង្ហាញ រូបភាព នៅ លើ អេក្រង់ ជា ច្រើន ។
កម្មវិធី នេះ គឺ មាន គោល បំណង ដាក់ ឲ្យ ប្រើ ប្រាស់ ជា មួយ នឹង គ្រឿង អេឡិចត្រូនិក ចល័ត គ្រឿង អេឡិចត្រូនិក ប្រើ ប្រាស់ ក្នុង ផ្ទះ និង ប្រព័ន្ធ អេឡិច ត្រូនិក រថយន្ត ផង ដែរ។
លីទុយអានីចូលរួមតំបន់ប្រើប្រាស់ប្រាក់អឺរ៉ូ
បច្ចុប្បន្ន ជនជាតិ អឺរ៉ុប សរុប ចំនួន ៣៣៧ លាន នាក់ កំពុង ប្រើ ប្រាស់ ប្រាក់ អឺរ៉ូតែមួយ។
ប្រទេស ផ្សេង ទៀត ដែល ធ្លាប់ ស្ថិត នៅ ពីក្រោយ វាំងនន ដែក ដែល សហភាព សូវៀត បាន បង្កើត ឡើង ដើម្បី កាត់ ផ្តាច់ ទំនាក់ ទំនង របស់ ប្រទេស ក្រោម ចំណុះ ខ្លួន ពី ប្រទេស ផ្សេង ទៀត នោះ បច្ចុប្បន្ន បាន ផ្តល់ ឥស្សរជន នាំមុខ មួយ ចំនួន ក្នុង ការ ដឹក នាំ នៅ សហភាព អឺរ៉ុប។
ប្រទេសអេស្តូនី បាន ក្លាយ ជា សមាជិក ក្នុង តំបន់ ប្រើ ប្រាស់ ប្រាក់ អឺរ៉ូ នៅ ឆ្នាំ ២០១១ ហើយ ប្រទេសឡេតូនី បាន ក្លាយ ជា សមាជិក តំបន់ នេះ នៅ ឆ្នាំ ២០១៤។
« ក្នុង ការ ចូល រួម ប្រើ ប្រាស់ ប្រាក់ អឺរ៉ូ នេះ ប្រជាជនលីទុយអានី កំពុង សម្រេច ក្លាយ ជា ផ្នែកមួយ នៃ តំបន់មួយ ដែលមាន ស្ថិរភាព សន្តិសុខ និង វិបុលភាព »។
តែ ក្នុង ការ ប្រែ ប្រួល យ៉ាង លឿន ពី ការ ប្រើ ប្រាស់ រូបិយ ប័ណ្ណលីតាស មក ប្រើ ប្រាស់ ប្រាក់ អឺរ៉ូវិញ នោះ ការ គាំ ទ្រ របស់ សាធារណជន មាន ភាព ស្ទាក់ ស្ទើរ។
ប្រជាជន ចំនួន ៥៣ ភាគរយ នៃ ចំនួន ប្រជា ជន ៣ លាននាក់ របស់ ប្រទេស នេះ បានគាំ ទ្រ ការ ប្រើ ប្រាស់ ប្រាក់ អឺរ៉ូ ចំណែក ប្រជាជន ចំនួន ៣៩ ភាគ រយ បាន ប្រឆាំង នេះ បើយោង តាម ការ អង្កេត មួយ កាល ពីខែវិច្ឆិកា ដែល ចេញផ្សាយ ដោយ ធនាគារ កណ្តាល របស់ ប្រទេស នេះ។
ខ្ញុំពិត ជា គាំ ទ្រ ការ ប្រើ ប្រាស់ ប្រាក់ អឺរ៉ូ នេះ »។
«ខ្ញុំ បាន រក្សា ទុក កាស ខ្លះ ដូច្នេះ ខ្ញុំអាច បង្ហាញ កាស ទាំង នោះ ឲ្យ ចៅៗ ខ្ញុំ មើល»។
«ខ្ញុំ គិត ថា តម្លៃ សម្រាប់ សេវាកម្ម ដូច ជា ការ ទៅ ហាង អ៊ុតសក់ នឹង កើន ឡើង។
ប៉ុន្តែវា នឹង ងាយ ស្រួល ក្នុង ការ ធ្វើ ដំណើរ ផង ដែរ»៕
របាយការណ៍ សង្ខេប សកម្មភាព របស់ ក្រសួង ចាប់ពី ខែ កញ្ញា ឆ្នាំ ២០១៣ ដល់ ខែ ធ្នូ ឆ្នាំ ២០១៤ បាន ចេញ ផ្សាយ នៅលើ ទំព័រ ហ្វេសប៊ុក ផ្លូវការ របស់ ខ្លួន កាលពី ថ្ងៃ អង្គារ បង្ហាញ ថា តម្លៃ នាំ ចេញ របស់ កម្ពុជា កើនឡើង ៨០០ លាន ដុល្លារ ខណៈ តម្លៃ នាំ ចូល សរុប កើន ១,៤ ពាន់ លាន ដុល្លារ ។
លោក កែន រដ្ឋា អ្នកនាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម បាន ថ្លែង កាលពី ម្សិលមិញ ថា តួលេខ នេះ ឆ្លុះបញ្ចាំង ពី កំណើន សេដ្ឋកិច្ច របស់ កម្ពុជា និង ពី ការ កើនឡើង សកម្មភាព ពាណិជ្ជកម្ម ជាមួយ បណ្ដា ប្រទេស នៅក្នុង តំបន់ ។
« តួលេខ ដែល កើន នេះ គឺ ដោយសារ កំណើន នៃ ការ នាំ ចេញ ពី ប្រទេស កម្ពុជា ទៅកាន់ ទីផ្សារ អន្តរជាតិ ហើយ ទំហំ ពាណិជ្ជកម្ម ទ្វេភាគី រវាង កម្ពុជា និង ប្រទេស មួយ ចំនួន ក៏ មាន ការ កើនឡើង ដូចជា ប្រទេស ចិន ដែល បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង នាំ ចូល អង្ករ ពី ប្រទេស កម្ពុជា ១០០ ០០០ តោន កាលពី ខែ សីហា »។
ទំហំ ទឹកប្រាក់ នៃ ការ នាំ ចេញ របស់ កម្ពុជា នៅតែ ទាប ជាង ទំហំ ទឹកប្រាក់ នាំ ចេញ សរុប។
លោក កែន រដ្ឋា បាន ពន្យល់ ថា ការ កើនឡើង នៃ ទំហំ ទឹកប្រាក់ ក្នុង ការ នាំ ចូល គឺ ដោយសារ តែ ការ រីកចម្រើន ក្នុង វិស័យ សាងសង់ កសិកម្ម និង ឧស្សាហកម្ម នៅក្នុង ប្រទេស កម្ពុជា ។
« កម្ពុជា នាំ ចូល គ្រឿង ចក្រ ឧបករណ៍ អេឡិចត្រូនិក សម្ភារ សំណង់ និង វត្ថុ ធាតុដើម សម្រាប់ ឧស្សាហកម្ម ផលិតកម្ម រោងចក្រ ដោយសារ មិន មាន ការ ផលិត ក្នុង ស្រុក ។
អាស្រ័យ ហេតុនេះ ការ បង្កើន ការ នាំ ចេញ មាន ន័យ ថា បង្កើន ចំនួន នាំចូល ផង ដែរ ព្រោះ យើង ត្រូវការ វត្ថុធាតុដើម ដើម្បី ផ្គត់ផ្គង់ ការ ផលិត ក្នុង ស្រុក » ។
លោក ថ្លែង បន្ត ថា តួលេខ នាំ ចេញ ត្រូវ បាន រំពឹង ថា កើនឡើង នៅ ប៉ុន្មាន ឆ្នាំ ខាង មុខ នេះ តាមរយៈ ការ ធ្វើ ទស្សនកិច្ច របស់ លោករដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល ទៅកាន់ បណ្ដា ប្រទេស ជាច្រើន ទាំង នៅ អាមេរិក ហុងកុង និង ប្រទេស ក្នុង តំបន់ មជ្ឈិមបូព៌ា ដើម្បី លើកកម្ពស់ ឲ្យ មាន ការ នាំ ចូល ផលិតផល ពី កម្ពុជា ។
« វា នឹង ត្រូវការ ពេលវេលា ប៉ុន្តែ វា មាន ការ ប្ដេជ្ញាចិត្ត របស់ រដ្ឋាភិបាល ក្នុង ការ បង្កើន តួលេខ ការ នាំចេញ ។
លោកស្រី ចន្ធី អ្នកវិភាគ សេដ្ឋកិច្ច ឯករាជ្យ បាន ថ្លែង កាលពី ម្សិលមិញ ថា កម្ពុជា នៅ តែ អាច មាន កំណើន ទឹកប្រាក់ ពាណិជ្ជកម្ម ទាំង នាំ ចេញ និង នាំ ចូល ក្នុង ឆ្នាំ ២០១៤ បើ ទោះបី ជា មាន អស្ថិរភាព នយោបាយ និង បាតុកម្ម ហិង្សា ជាច្រើន ដែល ករណី នេះ ឆ្លុះបញ្ចាំង ឲ្យ ឃើញ ពី តម្រូវការ ខ្ពស់ នៃ ផលិតផល កម្ពុជា នៅ ទីផ្សារ អន្តរជាតិ ។
«នេះ បង្ហាញ ថា ទីផ្សារ អន្តរជាតិ ត្រូវការ ផលិតផល ពី កម្ពុជា ។
កំណើន នេះ ក៏ ព្រោះ តែ សេដ្ឋកិច្ច ល្អ នៅ ប្រទេស ដែល បញ្ជា ទិញ ពី កម្ពុជា ផង ដែរ ដែល មាន ដូចជា សហរដ្ឋអាមេរិក និង សហភាព អឺរ៉ុប ចិន និង ជប៉ុន ជាដើម»។
លោក បន្ត ថា កម្ពុជា នឹង អាច រក្សា បាន កំណើន សេដ្ឋកិច្ច ៧ ឬ៨ ភាគរយ នៅ ឆ្នាំ ២០១៥ ខណៈ សន្ទះ នៃ ការ ផលិត ក្នុង ស្រុក ទាំង ផ្នែក ឧស្សាហកម្ម និង កសិកម្ម បង្ហាញពី និន្នាការ នៃ ការ រីកចម្រើន ៕
ឥណ្ឌូនេស៊ីបញ្ចប់ការឧបត្ថម្ភធនលើប្រេង
លោក Djalil សង្ឃឹម ថា វិធានការ នេះ នឹង ជួយ ឲ្យ ប្រទេស ឥណ្ឌូនេស៊ី ស៊ាំ នឹង ការ ប្រែប្រួល តម្លៃ បន្ទាប់ពី ត្រូវ បាន ការពារ ជាច្រើន ទសវត្សរ៍ ដោយ ការ ឧបត្ថម្ភធន ប្រេង ដ៏ខ្លាំង ។
រដ្ឋាភិបាល ក៏ បាន កំណត់ តម្លៃ ការ ឧបត្ថម្ភ ប្រេង ម៉ាស៊ូត របស់ ខ្លួន ក្នុង តម្លៃ ១ ០០០ រូពៀរ ក្នុង មួយ លីត្រ សម្រាប់ ឆ្នាំ ២០១៥។
« ប្រេង ម៉ាស៊ូត នៅ តែ ឧបត្ថម្ភធន នៅ ឡើយ ដោយសារ តែ វា ត្រូវ ប្រើប្រាស់ សម្រាប់ សកម្មភាព សេដ្ឋកិច្ច ហើយ រដ្ឋាភិបាល ចាត់ទុក វា ថា ជា ការ ចាំបាច់ ត្រូវ ឧបត្ថម្ភធន » ។
ការ បញ្ចប់ ការ ឧបត្ថម្ភធន លើ តម្លៃប្រេង ត្រូវ បាន គេ មើល ឃើញ ថា ជា វិធាន ចាំបាច់ ដើម្បី ជំរុញ សេដ្ឋកិច្ច ដែល បាន កើនឡើង ក្នុង កម្រិត មួយ យឺត ក្នុង រយៈពេល ៥ ឆ្នាំ ដោយ មាន កំណើន ៥,០១ ភាគរយ នៅ ត្រីមាស ទី បី ៕
ព្រលានអន្តរជាតិ សៀមរាប ទទួលភ្ញៀវទេសចរ ៣ លាននាក់ក្នុងឆ្នាំ២០១៤
ក្រុមហ៊ុន គ្រប់គ្រង ដំណើរការ អាកាសយានដ្ឋាន កម្ពុជា អ៊ែរផត បាន ឲ្យ ដឹង តាម សេចក្តី ប្រកាស ព័ត៌មាន កាលពី ម្សិលមិញ ថា ការ ទទួល បាន ភ្ញៀវទេសចរ ឆ្លងកាត់ នៅ អាកាសយានដ្ឋាន សៀមរាប ៣ លាន នាក់ នា ឆ្នាំ នេះ ជា កំណើន ដ៏ គួរ ឲ្យ កត់សម្គាល់ ។
ការ ទទួល បាន កំណើន និង មាន ភ្ញៀវ ឆ្លងកាត់ រហូត ដល់ ទៅ ៣ លាន នាក់ នា ពេល នេះ គឺជា សមិទ្ធផល ដ៏ គួរ ឲ្យ ភ្ញាក់ផ្អើល និង រីករាយ។
ផែនការ បន្ទាប់ របស់ យើង គឺ ការ ពង្រីក ទំហំ ស្ថានីយ ទទួល អ្នក ដំណើរ ដើម្បី ឲ្យ អាកាសយានដ្ឋាន យើង អាច មាន លទ្ធភាព ទទួល បាន ភ្ញៀវ ឆ្លងកាត់ ៥ លាន នាក់ ក្នុង មួយ ឆ្នាំ »។
កាលពី ខែ មករា ឆ្នាំ ២០១៤ ក្រុមហ៊ុន កម្ពុជា អ៊ែរផត បាន ចាប់ផ្តើម គម្រោង ពង្រីក ស្ថានីយ ទទួល អ្នក ដំណើរ ដើម្បី មាន លទ្ធភាព ទទួល ភ្ញៀវ បាន ទ្វេដង ពី បរិមាណ បច្ចុប្បន្ន ជា ផ្នែក មួយ ដើម្បី ទទួល បាន កំណើន ភ្ញៀវ ប្រកប ដោយ ចីរភាព។
គម្រោង ពង្រីក ស្ថានីយ ទទួល អ្នក ដំណើរ គ្រោង នឹង បញ្ចប់ រួចរាល់ នៅ ដើម ឆ្នាំ ២០១៦។
លោក ខែក ណូរីនដា ប្រធាន ផ្នែក ទំនាក់ទំនង និង ទីផ្សារ ក្រុមហ៊ុន កម្ពុជា អ៊ែរផត បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ម្សិលមិញ ថា ការ កើនឡើង ចំនួន ភ្ញៀវ ឆ្លងកាត់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប នា ពេល នេះ ឆ្លុះ បញ្ចាំង ពី កំណើន នៃ ការ មក ដល់ របស់ ភ្ញៀវទេសចរ អន្តរជាតិ ចូល មក កម្ពុជា ដោយសារ មាន ការ រៀបចំ ល្អ ពី អាជ្ញាធរ ស្ថិរភាព សង្គម និង កំណើន ប្រជាប្រិយភាព តំបន់ ទេសចរណ៍ ដែល មាន សក្តានុពល នៅ កម្ពុជា ជាពិសេស ប្រាសាទ អង្គរវត្ត ដែល ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក របស់ អង្គការ យូណេស្កូ ។
« បើ យើង ប្រៀបធៀប អត្រា កំណើន របស់ យើង នា ឆ្នាំ នេះ ទៅ អត្រា កំណើន របស់ អាកាសយានដ្ឋាន ប្រទេស ផ្សេងៗ គឺ ថា យើង ទទួល បាន កំណើន ខ្ពស់ មែនទែន»។
លោក បន្ត ថា អត្រា កំណើន ដ៏ល្អ សម្រាប់ អាកាសយានដ្ឋាន អន្តរជាតិ នៃ ប្រទេស ផ្សេង ជាទូទៅ ត្រឹម ២ ទៅ ៣ ភាគរយ ។
គិត ចាប់ពី ខែ មករា ឆ្នាំ ២០១៤ រហូត ដល់ ខែ តុលា កម្ពុជា បាន ទទួល ភ្ញៀវទេសចរ អន្តរជាតិ សរុប ៣,៦ លាន នាក់ ក្នុង នោះ ភ្ញៀវទេសចរ ចិន មាន ចំនួន ច្រើន ជាង គេ គឺ ៤៥ ម៉ឺន នាក់ បន្ទាប់មក គឺ វៀតណាម ។
ខណៈ ទេសចរ ចិន មក ទស្សនា កម្ពុជា បច្ចុប្បន្ន ឈរ ស្ថិត ក្នុង ចំណោម ចំណាត់ថ្នាក់ លើ គេ កម្ពុជា នៅ តែ មាន ឱកាស ច្រើន ក្នុង ការ ទាក់ទាញ ភ្ញៀវទេសចរ បរទេស ពី ចិន ដោយសារ ថា ជីវភាព ប្រជាជន ចិន កាន់តែ ប្រសើរ ហើយ ចំនួន ទេសចរ ចិន ដែល ចេញ ដំណើរ កម្សាន្ត ទៅ ក្រៅ ប្រទេស បាន កើនឡើង ដល់ ១០០ លាន នាក់ កាលពី ឆ្នាំ ២០១៣ ដែល បាន ចំណាយ ប្រាក់ ប្រមាណ ១២៨ ពាន់ លាន ដុល្លារ ។
លោក ហូ វណ្ណឌី សហប្រធាន ក្រុម ការងារ ទេសចរណ៍ វិស័យ ឯកជន រំពឹង ថា ការ ទទួល បាន កំណើន ភ្ញៀវទេសចរ ឆ្លងកាត់ អាកាសយានដ្ឋាន អន្តរជាតិ ដ៏ខ្ពស់ នា ពេល នេះ គឺ សញ្ញា វិជ្ជមាន ឆ្លុះបញ្ចាំង ពី សក្តានុពល នៃ វិស័យ ទេសចរណ៍ កម្ពុជា និង ជា ឱកាស ក្នុង ការ បន្ថែម ប្រតិបត្តិការ ក្រុមហ៊ុន ហោះហើរ ក្នុង ស្រុក ដើម្បី ពង្រឹង គុណភាព និង តម្លៃ សេវាកម្ម ។
« វា ឆ្លុះបញ្ចាំង ពី ឱកាស ក្នុង ដំណើរការ ដឹកជញ្ជូន តាម ផ្លូវអាកាស ហើយ ខ្ញុំ រំពឹង ថា យើង នឹង មាន ការ ហោះហើរ ភ្ជាប់ ខេត្ត ភាគ ឦសាន កម្ពុជា ដូចជា រតនគិរី មណ្ឌល គិរី ក្នុង ពេល ឆាប់ៗ» ។
លោក បាន រំឭក ថា ភ្នាក់ងារ ដែល ទទួល បាន ប្រយោជន៍ ផ្ទាល់ ពី កំណើន វិស័យ ទេសចរណ៍ ដូចជា សណ្ឋាគារ ភោជនីយដ្ឋាន ក្រុមហ៊ុន ភ្នាក់ងារ ទេសចរណ៍ និង ក្រុមហ៊ុន ផ្តល់ សេវា ដឹកជញ្ជូន ផ្សេងៗ ត្រូវ ពង្រឹង ក្រមសីលធម៌ និង ដំណើរការ ប្រកប ដោយ វិជ្ជាជីវៈ ដើម្បី និរន្តរភាព នៃ កំណើន ភ្ញៀវទេសចរ មក កម្ពុជា ៕
ធនាគារកសិករថៃនឹងបើកនៅកម្ពុជា
ធនាគារ កសិករ នឹង ដាក់ ពាក្យ សុំ របស់ ខ្លួន ប៉ុន្តែ មាន បំណង បង្កើត នៅ ត្រីមាស ទី ពីរ ឆ្នាំ ២០១៥ ។
« ស្រប នឹង ពាណិជ្ជកម្ម ទ្វេភាគី សាខា នៅ កម្ពុជា របស់ ធនាគារ កសិករ ថៃ នឹង ផ្ដោត លើ អាជីវកម្ម ធុនតូច ដោយសារ តែ វា គឺជា វិស័យ មួយ ដែល មិន ទាន់ បាន ផ្ដោត ការ យក ចិត្ត» ។
លោក លី វិសាល ប្រធាន ការិយាល័យ សហព័ន្ធ សមាគម សម្រាប់ សហគ្រាស ធុនតូច និង មធ្យម របស់ កម្ពុជា បាន ថ្លែង ថា អាជីវកម្ម ធុនតូច កម្ពុជា បាន ទទួល រង ដោយសារ អត្រា ការប្រាក់ ខ្ពស់ ព្រោះ កង្វះ ទ្រព្យ ដាក់បញ្ចាំ និង ឯកសារ ត្រឹមត្រូវ ៕
កំណើនទេសចរបរទេសទៅគុយបាកើនឡើងមិនធ្លាប់មាន
ទូរទស្សន៍ រដ្ឋ បាន រាយការណ៍ ថា ៖
« បច្ចុប្បន្ន យើង បាន បំបែក កំណត់ត្រា ។
វិស័យ ទេសចរណ៍ ជា សសរស្ដម្ភ ប្រាក់ចំណូល ឈាន មុខ គេ ទី ៣ របស់ ប្រទេស គុយបា ដែល រក បាន ប្រាក់ ចំនួន ២,៥ ពាន់ លាន ដុល្លារ អាមេរិក កាលពី ឆ្នាំ មុន ។
ចំនួន នោះ ស្ថិត នៅ ឆ្ងាយ ពី ការ នាំចេញ ផលិតផល សេវាវេជ្ជសាស្ត្រ របស់ គុយបា ដែល មាន រហូត ដល់ ១០ ពាន់ លាន ដុល្លារ អាមេរិក ភាគច្រើន ទៅ ប្រទេស វ៉េណេស៊ុយអេឡា ។
ប៉ុន្តែ ដោយ មាន ការ ធ្លាក់ ចុះ តម្លៃ ប្រេង ហើយ សេដ្ឋកិច្ច របស់ ប្រទេស វ៉េណេស៊ុយអេឡា ស្ថិត ក្រោម ភាព តានតឹង ដែល ជា ប្រភព ធំ ដ៏សំខាន់ នៃ ប្រាក់ចំណូល សម្រាប់ ប្រទេស គុយបា អាច ជា បញ្ហា ប្រឈម ក្នុង ការ រក្សា ផ្នែក មួយ របស់ ទីក្រុង Caracas ។
ប្រាក់ ពលកម្ម ផ្ញើ ពី បរទេស មកពី ប្រជាជន គុយបាន ដែល កំពុង រស់នៅ ក្រៅ ប្រទេស មាន ចំនួន សរុប ២,៧ លាន ដុល្លារ អាមេរិក ក្នុង មួយ ឆ្នាំ ។
អាជ្ញាធរ គុយបា កំពុង សង្ឃឹម ដោយ គ្មាន ការ សង្ស័យ ថា ទំនាក់ទំនង ដែល ទើប បាន ធ្វើឲ្យ ប្រសើរ ឡើង ជាមួយ អាមេរិក នឹង អាច ជួយ បន្ថែម ដល់ ផ្នែក ដ៏សំខាន់ របស់ ឧស្សាហកម្ម នេះ ។
កាលពី ដើម ខែ នេះ អាមេរិក បាន ប្រកាស ថា ខ្លួន នឹង បញ្ចប់ ទំនាក់ទំនង ដែល ឃ្លាត ឆ្ងាយ រាប់ ទសវត្សរ៍ និង ធ្វើឲ្យ មាន ទំនាក់ទំនង ជា ប្រក្រតី ជាមួយ ប្រទេស គុយបា ឡើង វិញ ។
លោក ប្រធានាធិបតី អាមេរិក បារ៉ាក់ អូបាម៉ា បាន ចាប់ផ្ដើម ធ្វើឲ្យ ទំនាក់ទំនង ការទូត រស់ ឡើង វិញ និង បន្ធូរបន្ថយ ការ ហ៊ុមព័ទ្ធ ពាណិជ្ជកម្ម ដែល បញ្ចប់ ភាព ប្រទូស រ៉ាយ គ្នា រយៈពេល ៥០ ឆ្នាំ រវាង អតីត សត្រូវ សង្គ្រាម ត្រជាក់ មួយ នេះ ។
ប៉ុន្តែ នៅពេល បច្ចុប្បន្ន ភ្ញៀវទេសចរ អាមេរិក ប្រឈម នឹង ការ ហាមឃាត់ ក្នុង ការ ធ្វើ ដំណើរ ផ្ទាល់ ទៅ គុយបា លុះត្រាតែ ពួកគេ ធ្វើ ដំណើរ ទេសចរណ៍ ផ្លាស់ប្តូរ វប្បធម៌ ដែល មាន ការ រៀបចំ និង ការ អនុញ្ញាត ជាពិសេស ។
សភា សហរដ្ឋអាមេរិក នឹង លុប ចោល ការ រឹតបន្តឹង ក្នុង ការ ធ្វើ ដំណើរ របស់ ជនជាតិ អាមេរិក ជា លើក ដំបូង ដើម្បី ធ្វើ ដំណើរ ទៅកាន់ ប្រទេស នេះ៕
ទំហំ ជួញដូរ មាន កម្រិត ទាប ដោយ មាន ឈ្មួញ ជាច្រើន ធ្វើ ដំណើរ ចេញ មុន ពេល ថ្ងៃ សម្រាក ចូលឆ្នាំ ថ្មី នៅ ថ្ងៃ ព្រហស្បតិ៍ ។
ទីផ្សារ ហិរញ្ញវត្ថុ នៅក្នុង ប្រទេស ជប៉ុន ឥណ្ឌូនេស៊ី ហ្វីលីពីន កូរ៉េ ខាង ត្បូង និង ថៃ បាន បិទ ការ ជួញដូរ នៅ ថ្ងៃ ពុធ។
អ្នកវិភាគ បាន ថ្លែង ថា ជាមួយ នឹង សញ្ញា ការ ជួញដូរ បន្តិចបន្តួច ផ្សេង ទៀត ឈ្មួញ កំពុង ពិនិត្យ មើល ដោយ យក ចិត្ត ទុកដាក់ លើ របាយការណ៍ ស្តុក អាមេរិក ផ្លូវការ ចុងក្រោយ បំផុត ដែល បាន ចេញ ផ្សាយ នៅ ល្ងាច ថ្ងៃ ពុធ សម្រាប់ សញ្ញា តម្រូវការ ក្នុង ប្រទេស ប្រើប្រាស់ ប្រេងឆៅ ឈាន មុខ គេ របស់ ពិភពលោក ។
តម្លៃ ប្រេង បាន ធ្លាក់ ចុះ ចាប់ តាំងពី ខែ មិថុនា ដោយសារ តែ កំណើន សេដ្ឋកិច្ច ចិន និង ប្រទេស មាន សេដ្ឋកិច្ច ទីផ្សារ កំពុង រីកចម្រើន មាន ដំណើរការ យឺត ការ ធ្លាក់ ចុះ នៅ ជប៉ុន និង ការ ដំណើរការ ជិត នៅ ទ្រឹង នៅក្នុង តំបន់ អឺរ៉ូ ។
លោក បាន ថ្លែង នៅក្នុង ការ ធ្វើ អត្ថាធិប្បាយ មួយ ថា នៅ ខាង តម្រូវការ វិធានការ លើក ទឹកចិត្ត ដោយ សេដ្ឋកិច្ច សំខាន់ៗ អាច បង្កើន កំណើន និង ទទួល បាន តម្រូវការ ប្រេងឆៅ វិញ ។
« នៅក្នុង ឆ្នាំ ២០១៥ យើង ជឿជាក់ ថា តម្រូវការ ប្រេងឆៅ នឹង ត្រូវ ជាប់ ទាក់ទង ជាមួយ នឹង ថា តើ ដំណើរការ របស់ ប្រទេស ចិន ជប៉ុន និង តំបន់ អឺរ៉ុប យ៉ាង ណា ?
« បើ យើង ចាប់ផ្ដើម មើល ឃើញ ស្ថានភាព របស់ ប្រទេស ទាំងនេះ មាន ការ កែលម្អ តម្រូវការ ខ្លាំង អាច កើតឡើង បាន » ៕
ស្តុក ប្រេង ឆៅ អាមេរិក អា ច នឹង កើនឡើង ដល់ កម្រិត ខ្ពស់ បំផុត នៅក្នុង ឆ្នាំ នេះ ក្នុង រយៈ ពេល ៣ ទសវត្សរ៍។
ការ ធ្លាក់ ចុះ តម្លៃ ប្រេង បាន ប៉ះពាល់ ទីផ្សារ ជា ច្រើន រាប់ ចាប់ ពី ប្រាក់ រូបល របស់ រុស្ស៊ី រហូត ដល់ រូបិយប័ណ្ណ ណៃរ៉ា របស់ ប្រទេស នីហ្សេរីយ៉ា និង កាត់ បន្ថយ ថវិកា របស់ រដ្ឋា ភិបាលរបស់ ប្រទេស ផលិត ប្រេងនា នា ដូចជា ប្រទេស វ៉េណេ ស៊ុយអេឡា និង អេក្វាទ័រ ជា ដើម។
វាក៏ បាន បង្កើត ស្តុក ប្រេង ឆៅ បន្ទាន់ របស់ ចិន ផង ដែរ និង ជួយ កាត់ បន្ថយ ឧបត្ថ ម្ភធន ប្រេង នៅ ប្រទេស ឥណ្ឌា និង ឥណ្ឌូនេស៊ី។
ផលិតកម្មនៅប្រទេសចិនធ្លាក់ចុះ ខណៈសេដ្ឋកិច្ចកំពុងស្រអាប់
សន្ទស្សន៍ នេះ ក៏ បាន បង្ហាញពី ការ ធ្លាក់ ចុះ លើក ដំបូង ផង ដែរ គិត ចាប់ តាំង ពី សន្ទស្សន៍ ៤៩,៤ កាល ពីខែ ឧសភា មក។
គួរ បញ្ជាក់ ផង ដែរថា តួលេខ ខ្ពស់ ជាង ៥០ បង្ហាញ ពី កំណើន ផលិតកម្ម ខណៈ តួលេខ ទាប ជាង នេះ បង្ហាញពី ការ ធ្លាក់ ចុះ របស់ វិស័យផលិតកម្ម។
«ទិន្នន័យ កាល ពី ថ្ងៃ ម្សិលមិញ បញ្ជាក់ ពី ការ ធ្លាក់ ចុះ ជា បន្ត នៃ វិស័យ ផលិតកម្មនៅ ចុង ឆ្នាំ នេះ »។
ផ្ទុយ ទៅវិញ ការ នាំ ចេញ បាន កើន ឡើង ក្នុង រយៈ ពេល ៨ ខែ ជាប់គ្នា និង កើនឡើង ខ្ពស់ ជាង កំណើន នៅ ខែ វិច្ឆិកា បន្តិច ដោយ បង្ហាញពី តម្រូវ ការ បរទេស ខ្ពស់ ខណៈ ដែល កំណើន សេដ្ឋកិច្ច អាមេរិក កំពុង ស្ទុះ ងើប ឡើង វិញ។
នេះបើយោង តាម សេចក្តី ថ្លែង ការណ៍ ដដែល។
សេដ្ឋកិច្ច របស់ ប្រទេស ចិន កំពុង ប្រឈម នឹង បញ្ហា ជា ច្រើន ដូចជា ការ ធ្លាក់ ចុះ តម្លៃ អចលនទ្រព្យ កម្រិត បំណុល ខ្ពស់ និង អ្វី ដែល សេដ្ឋ វិទូមួយ ចំនួន មើល ឃើញពី ការ គំរាមកំហែង កាន់ តែ ខ្លាំង នៃ បរិត្តផរណា។
សេដ្ឋកិច្ច ក៏ បាន បង្ហាញពី ការ បន្ត ធ្លាក់ចុះ ផង ដែរ នៅ ត្រីមាស ចុង ក្រោយ នៃ ឆ្នាំ ២០១៤ ៕
កំណើន ផ.ស.ស បានកើនឡើង ៦,៩៦ ភាគ រយ នៅ ត្រីមាស ទីបួនឆ្នាំ ២០១៤ ធៀបនឹង រយៈពេល ដូច គ្នា កាល ពី ឆ្នាំមុន ដោយ បាន កើនឡើង ពី អត្រា កំណើន៦,០៧ ភាគ រយ នៅ ត្រីមាស ទីបី។
នេះ បើយោង តាមទិន្ន័យ ដែល បាន ចេញផ្សាយ ដោយ ការិយា ល័យ ស្ថិតិ វៀតណាមនៅក្រុង ហាណូយ កាល ពី ថ្ងៃ ម្សិលមិញ។
ធនាគារ កណ្តាល វៀតណាម បាន ទម្លាក់ អត្រា ការ ប្រាក់ បញ្ញើជា ប្រាក់ ដុងដោយ បញ្ចប់ លក្ខខណ្ឌមួយ ចំនួនកាល ពី ខែ តុលា និង បាន ទម្លាក់ អត្រា ការ ប្រាក់ ផ្សេង ទៀត រួមទាំងទម្លាក់ តម្លៃ ប្រាក់ ដុង នៅ ឆ្នាំ នេះ ក្នុង គោល បំណង ជួយ ដល់ ក្រុមហ៊ុន នា នា។
ទិន្នន័យបាន បង្ហាញ កាល ពី ថ្ងៃ អង្គារ ថា ការ នាំ ចេញ ពី សំណាក់ ក្រុមហ៊ុន បរទេស នៅ ប្រទេស វៀតណាមបានកើនឡើង១៥ ភាគ រយ នៅ ឆ្នាំនេះ ខណៈ ការ វិនិយោគ ផ្ទាល់ ពី បរទេស បាន កើន ឡើង៧ ភាគ រយ ។
« កំណើន សេដ្ឋកិច្ចកើនឡើង ដោយ សារ ការ នាំ ចេញ ជាពិសេស ការ នាំ ចេញពី សំណាក់ ក្រុមហ៊ុន បរទេស ។
សញ្ញា នៃ ភាព ល្អ ប្រសើរ ឡើងវិញ របស់ សេដ្ឋកិច្ច កំពុង តែ បង្ហាញ កាន់ តែ ច្បាស់ តែ កំណើន សេដ្ឋកិច្ច នៅ មានភាព ផុយ ស្រួយ នៅឡើយ»។
រដ្ឋាភិបាល វៀតណាម បាន ចាត់ វិធានការ ស្តារ ប្រព័ន្ធ ហិរញ្ញវត្ថុ និង បង្កើន ឥណទាន ដោយ កំណើន ឥណទាន បានកើនឡើង១២,៦ ភាគ រយគិត ត្រឹម ថ្ងៃ ទី ២២ ខែ ធ្នូកន្លង ទៅ នេះ។
ទន្ទឹមនឹង នោះ ដែរ ការ ធ្លាក់ ចុះ តម្លៃ ប្រេង បានជួយកាត់ បន្ថយ អត្រា អតិផរណា ហើយ ធនាគារ កណ្តាល របស់ ប្រទេស នេះ បាន ឲ្យ ដឹង ក្នុង សប្តាហ៍ នេះ ថា ខ្លួនមានបំណង រក្សា ស្ថិរភាព តម្លៃ ប្រាក់ ដុងនៅ ឆ្នាំ ក្រោយ និង បន្ត អនុវត្ត គោលនយោបាយ រូបិយ វត្ថុ ដែលមានលក្ខណៈ បត់ បែន ដើម្បី ជំរុញ កំណើន សេដ្ឋកិច្ច និង កាត់ បន្ថយ កំណើន តម្លៃ ទំនិញ។
កំណើននាំ ចេញ តាមធម្មតាប្រទេស វៀតណាម ប្រកាស ពី ទិន្នន័យ កំណើន ផ.ស.ស រយៈពេល ប៉ុន្មាន សប្តាហ៍ មុន ប្រទេស ផ្សេង ទៀត ។
នេះ បើយោង តាម ទីភ្នាក់ ងារ វិនិយោគ បរទេស កាល ពី ថ្ងៃ អង្គារ។
អត្រា អតិផរណា បានធ្លាក់ ចុះមក នៅ ត្រឹម ១,៤៨ ភាគ រយ នៅ ខែ ធ្នូ ធៀប នឹង រយៈពេល ដូចគ្នា កាល ពី ឆ្នាំមុន និង មានកម្រិត ទាប បំផុត យ៉ាង ហោច ណាស់ ចាប់ តាំ ងពី ឆ្នាំ២០០៦ មក។
រដ្ឋាភិបាល វៀតណាម បាន បញ្ជា ឲ្យ ក្រុមហ៊ុនលក់ ប្រេង រាយ កាត់ បន្ថយ តម្លៃ ប្រេង និង ស្នើ ឲ្យ ឧស្សា ហកម្ម នា នា រក្សា ស្ថិរភាព តម្លៃ មុន និង អំឡុង ពេល បុណ្យចូល ឆ្នាំ ប្រពៃណី វៀត ណាម ដែលនឹង មក ដល់ នៅ ខែ កុម្ភៈ ខាង មុខ នេះ៕
ទិន្នផលដូងប្រេងម៉ាឡេស៊ីអាចធ្លាក់ចុះ២០ភាគរយ
លោក បាន បន្តឲ្យ ដឹង តាមទូរស័ព្ទ នៅទីក្រុង គូឡាឡាំពួ ថា ទិន្ន ផល ដូង ប្រេង នឹង ធ្លាក់ ចុះ ខ្លាំង។
ទំនិញ ដែល ត្រូវ បាន ប្រើ ប្រាស់ ក្នុង ចំណីអាហារ និង ជីវឥន្ធនៈ នេះ អាច នឹង ឡើង ថ្លៃ ប្រចាំត្រីមាស លើក ដំបូង ក្នុង ឆ្នាំនេះ ខណៈ ប្រទេស ម៉ាឡេស៊ី កំពុង រង ផល ប៉ះពាល់ ដោយ សារ គ្រោះ ទឹកជំនន់ ដ៏ អាក្រក់ ក្នុង រយៈ ពេល ប៉ុន្មាន ទសវត្សរ៍ ចុង ក្រោយ នេះ ដោយ សារ ភ្លៀង ម៉ូសុង ធ្លាក់ ខ្លាំង ។
រដ្ឋជិតពាក់កណ្តាលដំឡើងប្រាក់ឈ្នួល
នៅ រដ្ឋ ចំនួន ៩ ក្នុង ចំណោម រដ្ឋ ទាំង នោះ ប្រាក់ ឈ្នួល អប្បបរមា នឹង កើនឡើង ដោយ សារ សន្ទស្សន៍ អតិផរណា។
«យើង នឹង បន្តឃើញ សកម្ម ភាព ថែម ទៀត នៅថ្នាក់ រដ្ឋ និង ថ្នាក់ មូលដ្ឋាន ។
វា គឺ ជា វិធានការ ដ៏មាន ប្រជា ប្រិយភាព បំផុត ផ្នែក នយោបាយ ហើយ ដូច្នេះ យើង រំពឹងថា នៅ ឆ្នាំ២០១៦ យើង នឹង ឃើញ កិច្ច ផ្តួចផ្តើម បោះ ឆ្នោត ស្តីពី ប្រាក់ ឈ្នួល អប្បបរមា នេះ ទៀត »។
យោង តាមសន្និសីទ ជាតិ នៃ ស្ថាប័ន នីតិប្បញ្ញតិ្ត បាន ឲ្យ ដឹងថា នៅ ត្រឹម ថ្ងៃ ទី ១ ខែមករា រដ្ឋ ចំនួន ២៩ និង រដ្ឋធានី វ៉ាស៊ីនតោន ឌីស៊ី នឹង មាន ប្រាក់ ឈ្នួល អប្បបរមា ខ្ពស់ ជា កម្រិត ប្រាក់ ឈ្នួល អប្បបរមា របស់ រដ្ឋ សហព័ន្ធ ដែល មិន ទាន់ បាន ដំឡើង គិត ចាប់ តាំង ពី ឆ្នាំ ២០ ០៩ មក។
រដ្ឋ វ៉ាស៊ីនតោន នឹង ក្លាយ ជា រដ្ឋ ដែល ផ្តល់ ប្រាក់ ឈ្នួល អប្បបរមា ខ្ពស់ ជាង គេបំផុត ដែល នឹង កើនឡើង ដល់ ៩,៤៧ ដុល្លារ។
ការ ដំឡើង ប្រាក់ ឈ្នួល នេះ ទទួល បាន ប្រជា ប្រិយ ភាព យ៉ាង ខ្លាំង ពី ម្ចាស់ ឆ្នោត។
យោង តាម NCSL ចាប់ពី ឆ្នាំ ១៩៩៨ មក រាល់ វិធានការ បោះ ឆ្នោត នៅ ទូ ទាំង រដ្ឋ ដើម្បី ដំឡើង ប្រាក់ ឈ្នួល អប្បបរមាត្រូវ បាន បោះ ឆ្នោត សម្រេច។
កាល ពី ខែ វិច្ឆិកាម្ចាស់ ឆ្នោត ក្នុង រដ្ឋ អាឡាស្កា អាកែនសាស់ ណេប្រាដា និង ដាកូតា ខាង ត្បូង បាន បោះឆ្នោត អនុម័ត វិធានការ ទាំង នេះ។
«ប្រាក់ ឈ្នួល អប្បបរមា គឺជា បញ្ហា ដែល កើត ឡើងជា ប្រចាំ។
នៅ ពេល ប្រាក់ ឈ្នួល អប្បបរមា សហព័ន្ធ ស្ថិត នៅ ទ្រឹង រយៈ ពេល ប៉ុន្មាន ឆ្នាំ មក នេះ រដ្ឋ នានា បាន លូកដៃអន្តរាគមន៍»៕
ការ អំពាវ នាវ ស្នើ សុំ កាត់ បន្ថយ បំណុល ឲ្យ ប្រទេស ហ្គីណេ លីបេ រីយ៉ា និង សៀរ៉ាឡេអូន នេះ មិន ត្រឹម តែ ចេញ មក ពី អង្គការ ប្រយុទ្ធ ប្រឆាំង ភាព ក្រីក្រ ប៉ុណ្ណោះទេ ។
ការនាំចូលមាសរបស់ចិនដីគោកពីហុងកុងនឹងរក្សាបានកំណើនដដែល
តួលេខ នេះ មិន បង្ហាញ ការ នាំចូល មាស ទាំងអស់ ដោយ ប្រទេស ចិន នោះ ទេ ។
តម្លៃ បាន ឆ្ពោះ ទៅ រក ការ ខាតបង់ ប្រចាំ ឆ្នាំ ជា លើក ទី ពីរ បន្ទាប់ពី ការ ធ្លាក់ ចុះ ខ្លាំង បំផុត នៅក្នុង រយៈពេល បី ទសវត្សរ៍ កាលពី ឆ្នាំ មុន ដោយសារ តែ ការ កើនឡើង តម្លៃ ប្រាក់ ដុល្លារ អាមេរិក និង ការ កើនឡើង តម្លៃ ភាគហ៊ុន បាន កាត់បន្ថយ តម្រូវការ លោហធាតុ មាន តម្លៃ ។
« តម្រូវការ មាស គឺ ពិតជា មាន ស្ថិរភាព និង មិន មាន ហេតុផល ដែល ធ្វើឲ្យ ប្រជាជន ចិន ទោះ ជា អ្នក មាន ឬ អ្នកក្រ នឹង ផ្លាស់ប្តូរ ចំណង់ចំណូល ចិត្ត របស់ ពួកគេ សម្រាប់ អំណោយ ជា មាស នោះ ទេ » ។
ចិន ត្រូវ បាន គេ និយាយ ថា នឹង ពិចារណា លើ ការ បន្ធូរបន្ថយ ការ រឹតបន្តឹង លើ ការ នាំចូល មាស ។
ប្រទេស នេះ បាន ចាប់ផ្ដើម អនុញ្ញាត ឲ្យ គ្រឹះស្ថាន អន្តរជាតិ ចូល ក្នុង កិច្ចព្រមព្រៀង មាស ជា ប្រាក់ យន់ នៅក្នុង តំបន់ ពាណិជ្ជកម្ម សេរី របស់ ទីក្រុង ស៊ាងហៃ កាលពី ខែ កញ្ញា នៅក្នុង វិធានការ មួយ ដែល ត្រូវ បាន គេ មើល ឃើញ ថា ជា កិច្ចខិតខំប្រឹងប្រែង ដើម្បី បង្កើន ឥទ្ធិពល របស់ ខ្លួន លើ តម្លៃ ៕
វិនិយោគសាធារណៈនឹងជំរុញសេដ្ឋកិច្ចថៃ
«បើ ទោះ ជា ទិសដៅ នៃ គោលនយោបាយ វិនិយោគ ច្បាស់ លាស់ ក្តី ក៏ ផ្នែក សារ ពើពន្ធ នឹង ជួយ ជំរុញ ការ លើក ទឹក ចិត្ត វិនិយោគ ឯកជន ឲ្យ កើត ឡើង ឆាប់ រហ័ស បើ ការ អនុវត្ត គម្រោង វិនិយោគ កើត ឡើង»។
លោក ស្រី បាន បន្ត ថា ការ ចំណាយ លើ ការ ប្រាក់ ទាបនឹង ជំរុញ ដល់ លទ្ធភាព ប្រើ ប្រាស់ សេវា ឥណទាន របស់ អតិថិជន។
« ដំណើរ ការ ស្ទុះ ងើប ឡើង វិញ នៃសេដ្ឋកិច្ច អាច នឹង មិនមាន ស្ថិរភាព ហើយ មាន ស្ថានភាព ផុយ ស្រួយ នៅ ដំណាក់ កាល ដំបូង។
តែ សន្ទុះ នៃ ការ ស្ទុះងើប ឡើង វិញ ខ្លាំង នៅពេល បន្ទាប់ អាច ជួយ កាត់ បន្ថយ ស្ថានភាព ដែល គ្មាន ស្ថិរភាព នេះ »។
ចាប់ តាំង ពីការ ទម្លាក់ អត្រា ការ ប្រាក់ គោល ០,២៥ ភាគ រយ កាល ពីខែមីនា មក ធនាគារ កណ្តាល ថៃ បាន រក្សា អត្រា ការ ប្រាក់ គោលនយោបាយ របស់ ខ្លួន នៅ អត្រា ២ ភាគ រយ ដដែល ក្នុង កិច្ច ប្រជុំ ៦ លើក ជាប់គ្នា ក្នុងគោល បំណងផ្តល់ ជំនួយផ្នែក ស្ថានភាព ហិរញ្ញវត្ថុ ដល់ ការ ស្ទុះ ងើប ឡើង វិញ នៃ សេដ្ឋកិច្ច ។
ធនាគារ កណ្តាលមួយនេះ ក៏ បាន ទម្លាក់ ការ ព្យាករ ពី កំណើន សេដ្ឋកិច្ច របស់ ខ្លួននៅ ឆ្នាំនេះ មកនៅ ត្រឹម០,៨ ភាគ រយ និង នៅ ឆ្នាំក្រោយមកនៅត្រឹម៤ ភាគរយ ផង ដែរ ទន្ទឹមនឹង នោះ ដែរ ធនាគារ នេះ បាន ព្យាករ ថា កំណើន នាំចេញ អាច ធ្លាក់ ចុះ ០,៥ ភាគ រយ នៅ ឆ្នាំ ២០១៤ និងអាច សម្រេច បានកំណើន ១ ភាគ រយ នៅ ឆ្នាំ២០ ១៥។
សេដ្ឋកិច្ច ថៃ បាន បន្ត ស្ទុះ ងើប ឡើង វិញ នៅ ខែ វិច្ឆិកា។
សន្ទស្សន៍ តម្រូវ ការ ប្រើ ប្រាស់ ឯកជន បានកើនឡើង០,៧ ភាគរយ ធៀប នឹង រយៈ ពេល ដូចគ្នាកាល ពី ឆ្នាំមុន ពោលគឺកើនឡើង ធៀបនឹង ការ ធ្លាក់ ចុះ ០,៣ ភាគ រយ កាល ពី ខែ តុលា។
« សូចនាករ សេដ្ឋកិច្ច ទូទៅនៃ វិស័យ នីមួយៗ ក្នុង ខែ តុលា និង ខែ វិច្ឆិកា បាន បង្ហាញពី សញ្ញា នៃ ការ ស្ទុះ ងើប ឡើងវិញ ខ្លាំង ធៀបនឹង ស្ថាន ភាព នៅ ត្រីមាស ទីបី »។
លោក ស្រី បាន បន្តថា ការ បាត់ បង់ អត្ថ ប្រយោជន៍ របស់ ប្រព័ន្ធ អនុគ្រោះពន្ធ ទូទៅ សម្រាប់ ក្រុមហ៊ុន នាំចេញ របស់ ថៃ ទៅកាន់ អឺរ៉ុប នៅ ឆ្នាំក្រោយ នេះ អាច ប៉ះពាល់ ដល់ ក្រុមហ៊ុនផលិត ផលិតផល កំប៉ុង តែ ក្រុម ហ៊ុននាំ ចេញមួយ ចំនួន កំពុង កាត់ បន្ថយ ផល ប៉ះពាល់ នេះ តាម រយៈ ការ ប្តូរ ទីតាំង មូលដ្ឋាន ផលិតកម្ម របស់ ខ្លួន ទៅកាន់ ប្រទេស ជិត ខាង វិញ ៕
ខេត្តទេសចរណ៍ត្រៀមសម្រាប់ឆ្លងឆ្នាំ
នេះ បើ តាម ការ ឲ្យ ដឹង ពី លោក ឃឹម ប៊ុនសុង អភិបាល ខេត្ត សៀមរាប។
«ការ ប្រារព្ធ ពិធី នៅ ឆ្នាំនេះ នឹង ធំ ជាង កាលពី ឆ្នាំមុន បន្តិច ដោយ សារ តែ យើង បាន ពង្រីក ការ តុបតែង ភ្លើង នៅ កន្លែង ជាច្រើន ក្នុង ទីក្រុង សៀមរាប។
សណ្ឋាគារ ផ្ទះសំណាក់ និង ភោជនីយដ្ឋាន ក៏ កំពុង រៀបចំ សកម្ម ភាព មួយ ចំនួន ផង ដែរ ក្នុង ការ ប្រារព្ធ ពិធី នេះ»។
«វិស័យ ឯកជន នៅ ឆ្នាំ នេះ ធ្វើ ការ បាន កាន់តែ ល្អប្រសើរ ចំពោះ ការ តុបតែង លម្អ ទីកន្លែង របស់ ពួកគេ ដើម្បី ស្វាគមន៍ បុណ្យ ចូល ឆ្នាំ ថ្មី។
លោក ប៊ុនសុង ថ្លែង ថា ការ តុប តែង ភាគ ច្រើន ផ្ដោត លើ ក្រុង សៀមរាប ហើយ តំបន់ ប្រាសាទ នឹង ត្រូវ ទុក ឲ្យ ស្ថិត នៅ ក្នុង សភាព ធម្មតា។
«មិន មាន ការ តុប តែង ពិសេស សម្រាប់ ទីតាំង ប្រាសាទ នោះ ទេ។
ហាង តាម ដងផ្លូវ និង ផ្សារ រាត្រី ក្រុង សៀមរាប នឹង ជាទី តាំង ផ្ដោត លើ ការ យក ចិត្ត ទុក ដាក់ ក្នុង ការ ប្រារព្ធ ពិធី បុណ្យ ចូល ឆ្នាំ។
កាំ ជ្រួច នឹង បាញ់ ចេញពី តំបន់ ស្ពានថ្ម ចាស់ របស់ ក្រុង សៀមរាប ក្នុង អំឡុង នៅ យប់ ថ្ងៃ ទី៣១ ឈាន ចូល ឆ្នាំ ២០១៥»។
លោក ប៊ុនសុង បាន ថ្លែង ថា អាជ្ញាធរ សៀមរាប បាន បង្កើន ការ យក ចិត្ត ទុក ដាក់ ដល់ សុវត្ថិភាព ភ្ញៀវ ទេសចរ មក កាន់ ខេត្ត នេះ ក្នុង រយៈ ពេល ពីរ ថ្ងៃ នេះ។
ទន្ទឹម នឹង នេះ ដែរ ខេត្ត បាត់ដំបង ដែល ល្បី ថា ជាទី ក្រុង បេតិកភណ្ឌ និង ពេញនិយម មួយ សម្រាប់ ស្ថាបត្យកម្ម អាណានិគម បារាំង និង ណូរី កំពុង រៀបចំ ការ ប្រារព្ធ ពិធី លើក ដំបូង របស់ ខ្លួន សម្រាប់ ថ្ងៃ បុណ្យ ចូល ឆ្នាំ សកល ផង ដែរ។
គួរ បញ្ជាក់ ថា ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ បរទេស ខេត្ត បាត់ដំបង បាន ព្យាយាម បង្កើត ហាង តាម ដង ផ្លូវ និង ផ្សារ រាត្រី ដូច ផ្សារ រាត្រី នៅ ក្រុង សៀមរាប កាល ពី ដើម ឆ្នាំ នេះ។
លោក អ៊ុច អ៊ុំពីនីស្សារ៉ា ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត បាត់ដំបង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្ដិ៍ កាល ពី ម្សិល មិញ ថា ភ្ញៀវទេសចរ បាន ចាប់ ផ្ដើម ធ្វើ ដំណើរ ចូលទៅ កាន់ ខេត្ត បាត់ដំបង ខណៈ ដែល ថ្ងៃ ឆ្លង ឆ្នាំ នឹង ចូល មក ដល់ អាជ្ញាធរ បាន រៀបចំ តុបតែង លម្អ ក្រុង បាត់ដំបង ដោយ ភ្លើង ពណ៌ ដើម្បី អបអរ ពិធី បុណ្យ ចូល ឆ្នាំ សកល។
នេះ ជា លើក ដំបូង ហើយ ដែល ខេត្ត នេះ រៀបចំ ការ ប្រគំ តន្ដ្រី ការ បង្ហោះ គោម និង ការ សម្ដែង សៀក ដើម្បី ស្វាគមន៍ ភ្ញៀវ ទេសចរ។
«ព្រឹត្តិ ការណ៍ ទាំង មូល នឹង ត្រូវ ប្រារព្ធ ឡើង ក្នុង តំបន់ ផ្សារ រាត្រី ចាប់ពី ម៉ោង ៦ ព្រឹក ដល់ ម៉ោង ១២ យប់។
នេះ គឺជា លើក ដំបូង ហើយ សម្រាប់ ខេត្ត នេះ ក្នុង ការ រៀបចំ ព្រឹត្តិការណ៍ ដូច នោះ ដើម្បី ទាក់ ទាញ ភ្ញៀវ ទេសចរ។
ខ្ញុំ រំពឹង ថា មនុស្ស ជាច្រើន ចូលរួម ក្នុង ឆ្នាំ នេះ។
យើង សង្កេត ឃើញ ភ្ញៀវ ទេសចរ បរទេស ច្រើន បាន ចាប់ ផ្ដើម ធ្វើ ដំណើរ កម្សាន្ត ខេត្ត នេះ នៅ ក្នុង រយៈ ពេល ពីរ បី ថ្ងៃ ចុង ក្រោយ នេះ»។
លោក សារ៉ា ថ្លែង ថា ព្រឹត្តិ ការណ៍ នេះ បាន រៀបចំ ដោយ ប្រើប្រាស់ ថវិកា បាន ពី សាលា ខេត្ត មាន បំណង លើក កម្ពស់ ទេសចរណ៍ ខេត្ត បាត់ដំបង ជា ទិសដៅ ទេសចរណ៍ ដែល កំពុង រីក ចម្រើន និង តាម ឲ្យ ទាន់ និន្នាការ ពិភពលោក។
មន្ទីរ បាន សហការ ជាមួយ សមាគម ទេសចរណ៍ ប្រទេស ថៃ ផង ដែរ ដើម្បី ផ្សព្វ ផ្សាយ ព្រឹត្តិ ការណ៍ ដល់ ភ្ញៀវ ទេសចរ បរទេស។
«ឆ្នាំ នេះ យើង រៀបចំ ពិធីបុណ្យ នេះ ជា ផ្នែក មួយ នៃ និន្នាការ ពិភពលោក។
ខ្ញុំ សង្ឃឹម ថា នឹង មាន មនុស្ស ជាច្រើន មក កាន់ ខេត្ត នេះ និង ជាការ ប្រារព្ធ ពិធី ដ៏ ធំ នៅ លើក នេះ។
ភ្ញៀវ ទេសចរ បរទេស ភាគ ច្រើន មក កាន់ ខេត្ត នេះ គឺ មកពី កោះ ឆាង ប៉ាតាយ៉ា និង តាម រយៈ ច្រក ព្រំដែន អន្តរជាតិ ប៉ោយប៉ែត ដែល ឆ្លង កាត់ ខេត្ត នេះ ទៅ កាន់ ទិសដៅ បន្ទាប់ នៅ ក្នុង ប្រទេស កម្ពុជា»។
លោក នូ សុផល ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ព្រះសីហនុ បាន ថ្លែង ថា ការ ប្រារព្ធ ពិធី សម្រាប់ បុណ្យ ចូល ឆ្នាំ សកល នេះ ទំនង ជា នឹង រក្សា បាន ដូច គ្នា នឹង ការ ប្រារព្ធ ពិធី កាល ពី ឆ្នាំ មុន ដែរ។
«យើង បាន ដាក់ បំភ្លឺ ក្រុង នេះ ជាមួយ នឹង អំពូល ភ្លើង នៅពេល តុបតែង។
យើង មាន ការ តាំង ពិព័រណ៍ និង ការ ប្រគំ តន្ដ្រី។
នោះ គឺជា ផ្នែក មួយ នៃ ការ រៀបចំ ពី អាជ្ញាធរ នៅ កណ្ដាល ក្រុង។
សម្រាប់ រមណីយដ្ឋាន និង កោះ ផ្សេង ទៀត ម្ចាស់ អាជីវកម្ម នឹង រៀបចំ សកម្មភាព របស់ ពួកគេ ជា ផ្នែក មួយ នៃ ការ ខោនដោន នេះ សម្រាប់ ឆ្នាំ សកល នេះ»។
លោក រំពឹង ថា នឹង មាន ភ្ញៀវទេសចរ សរុប ៧ ម៉ឺន នាក់ ក្នុង រយៈ ពេល ថ្ងៃ សម្រាក បី ថ្ងៃ នេះ ខណៈ ដែល ខេត្ត នេះ បាន រៀបចំ ការ តាំង ពិព័រណ៍ និង ការ ប្រគំ តន្ដ្រី នៅ លើ តំបន់ ឆ្នេរ អូរ ឈើទាល ដ៏ ពេញ និយម បំផុត សម្រាប់ ភ្ញៀវ ទេសចរ៕
សង្ខេបព្រឹត្តិការណ៍ សេដ្ឋកិច្ចកម្ពុជា ឆ្នាំ២០១៤
ក្នុង រយៈពេល ពេញ មួយ ឆ្នាំ ២០១៤ នេះ ភ្នំពេញ ប៉ុស្តិ៍ បាន ធ្វើ សេចក្តី រាយការណ៍ ជាច្រើន ពី បញ្ហា សេដ្ឋកិច្ច អាជីវកម្ម ពាណិជ្ជកម្ម ក្នុង ស្រុក និង ពាណិជ្ជកម្ម ជាមួយ បណ្តា ប្រទេស ក្នុង តំបន់ ជាច្រើន។
មករា ទីភ្នាក់ងារ អភិវឌ្ឍន៍ ជប៉ុន ប្រចាំ នៅ កម្ពុជា (JICA) បាន ផ្តល់ ជំនួយ ឥត សំណង ជា ទឹក ប្រាក់ សរុប ១១,៥ លាន ដុល្លារ ដល់ កម្ពុជា តាម រយៈ ក្រសួង រ៉ែ និង ថាមពល ដើម្បី សាងសង់ និង ស្តារ វារី អគ្គិសនី ខ្នាត តូច នៅ ខេត្ត រតនគិរី ដែល អាច ផ្តល់ កម្លាំង ថាមពល អគ្គិសនី សរុប ១ ២២៥ គីឡូវ៉ាត់៕
កុម្ភៈ អ្នក ជំនាញ ក្នុង ឧស្សាហកម្ម អង្ករ បាន ក្រើន រំឭក ថា អ្នក នាំ ចេញ ត្រូវ ត្រៀម ខ្លួន ទប់ ទល់ នឹង ការ គំរាម នានា ទាក់ទង នឹង ការ បញ្ចប់ អត្ថ ប្រយោជន៍ ពី ការ អនុគ្រោះ ពន្ធ នាំ ចេញ ទៅ សហភាព អឺរ៉ុប ខណៈ ប្រទេស អ៊ីតាលី បាន ដាក់ សំណើ ជា បន្ត បន្ទាប់ ទៅ សហភាព អឺរ៉ុប ឲ្យ បញ្ចប់ ការ អនុគ្រោះ ពន្ធ លើ ការ នាំ ចូល អង្ករ ពី កម្ពុជា៕
- រោងចក្រ អគ្គិសនី ដើរ ដោយ ថាមពល ធ្យូង ថ្ម ដំបូង នៅ កម្ពុជា ដែល មាន អានុភាព ផលិត ថាមពល ១០០ មេហ្គាវ៉ាត់ ត្រូវ បាន បើក សម្ពោធ ដំណើរការ ជា ផ្លូវ ការ។
រោងចក្រ នេះ មាន ទីតាំង នៅ ភូមិ ២ ឃុំ កំពេញ ស្រុក ស្ទឹងហាវ ខេត្ត ព្រះសីហនុ ត្រូវ បាន វិនិយោគ អស់ ទឹក ប្រាក់ ១៩៥ លាន ដុល្លារ។
- កន្លង មក មាន ក្រុមហ៊ុន មួយ ចំនួន បាន លួច ធ្វើ អាជីវកម្ម ដោយ យក ឈ្មោះ របៀប វិនិយោគ រួម គ្នា ដើម្បី ប្រមូល លុយ ពី សាធារណជន ដោយ អះអាង ថា ជា ក្រុមហ៊ុន សាខា ពី អន្តរជាតិ៕
- ទីភ្នាក់ងារ អភិវឌ្ឍន៍ បារាំង (AFD) ផ្តល់ ហិរញ្ញប្បទាន ប្រមាណ ជាង ២៤ លាន ដុល្លារ សម្រាប់ គម្រោង សេវា ទឹក ស្អាត និង អគ្គិសនី ដល់ ប្រជាជន នៅ ជនបទ។
- ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ADB បាន ផ្តល់ កម្ចី ៧៥ លាន ដុល្លារ ដល់ ធនាគារ អេស៊ីលីដា ដើម្បី ពង្រឹក លទ្ធភាព ផ្តល់ កម្ចី រយៈ ពេល វែង សម្រាប់ ម្ចាស់ អាជីវកម្ម ខ្នាត តូច បំផុត និង ខ្នាត មធ្យម។
កម្ចី នេះ មាន រយៈ ពេល សង ត្រឡប់ ៥ ឆ្នាំ។
- កម្ពុជា បាន ចុះ ហត្ថលេខា ទទួល ជំនួយ ឥត សំណង ៤៧,០៥ លាន អឺរ៉ូ (ប្រហែល ៦៤ លាន ដុល្លារ) ពី រដ្ឋាភិបាល នៃ ប្រទេស អាល្លឺម៉ង់ សម្រាប់ កញ្ចប់ ថវិកា ដើម្បី អនុវត្ត គម្រោង អាទិភាព បី គឺ វិស័យ សុខាភិបាល អភិវឌ្ឍន៍ ជនបទ និង ការ ពង្រឹង អភិបាល កិច្ច ល្អ ក្នុង រយៈ ពេល ពីរ ឆ្នាំ គឺ ពី ២០១៣ ដល់ ២០១៤៕
- លោក នាយក រដ្ឋ មន្ដ្រី ហ៊ុន សែន អះអាង សា ជា ថ្មី ពី គោល នយោបាយ ចិន តែ មួយ របស់ កម្ពុជា គឺ មិន អនុញ្ញាត ឲ្យ មាន ការ បង្កើន ការិយាល័យ ពាណិជ្ជកម្ម តៃវ៉ាន់ នៅ ភ្នំពេញ ឡើយ ខណៈ ដែល មន្ដ្រី ក្រុម ប្រឹក្សា អភិវឌ្ឍន៍ ពាណិជ្ជ កម្ម ក្រៅ ប្រទេស របស់ តៃវ៉ាន់ បាន អះអាង ថា កោះ តៃវ៉ាន់ នឹង បើក មជ្ឈមណ្ឌល ពាណិជ្ជ នៅ ទីក្រុង ភ្នំពេញ នៅ ឆ្នាំ ២០១៤៕
- ប្រទេស កម្ពុជា ត្រូវ បាន ជ្រើសរើស ធ្វើជា ម្ចាស់ ផ្ទះ ព្រឹត្តិការណ៍ សន្និសីទ ស្តីអំពី ស្រូវ អង្ករ ពិភពលោក ដែល បាន ធ្វើ ឡើង កាលពី កណ្តាល ខែ វិច្ឆិកា ២០១៤ បន្ទាប់ ពី កម្ពុជា ទទួល បាន ពាន រង្វាន់ អង្ករ ល្អ បំផុត របស់ ពិភពលោក ពីរ ឆ្នាំ ជាប់ៗ គ្នា៕
ទិន្នន័យ នេះ ត្រូវ បាន បង្ហាញ ជា ផ្លូវ ការ នៅ ក្នុង ផែនការ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ ជាតិ ឆ្នាំ ២០១៤-២០១៨៕
- ក្រុម មន្ត្រី ជំនាញ ផ្នែក អាកាសចរ កម្ពុជា និង ឡាវ បាន សម្រេច ឲ្យ ក្រុមហ៊ុន អាកាស ចរណ៍ វៀតណាម បើក ដំណើរការ ផ្លូវ ហោះ ហើរ ត្រង់ ថ្មី មួយ ភ្ជាប់ ពី ទីក្រុង ហាណូយ ទៅ ហូជីមិញ កាត់ តាម កម្ពុជា និង ឡាវ ដែល រំពឹង ថា ផ្លូវ ថ្មី នេះ មាន ចំណាយ ប្រតិបត្តិការ តិច ជាង មុន។
ប្រសិន បើ គ្មាន កិច្ច ព្រម ព្រៀង នេះ ការ ហោះ ហើរ ពី ហាណូយ ទៅ ហូជីមិញ ធ្វើ ឡើង តាម ជើង ហោះ ហើរ ក្នុង ស្រុក វៀតណាម ដែល ចំណាយ តម្លៃ ប្រតិបត្តិការ និង ពេល វេលា ច្រើន ជាង៕
វិច្ឆិកា - ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នឹង ក្លាយ ជា និយតករ ត្រួត ពិនិត្យ ដំណើរការ គ្រប់គ្រង មូលនិធិ របស់ ម្ចាស់ ជំនួយ ដែល ត្រូវ បាន អនុវត្ត ដោយ គ្រឹះស្ថាន ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ នៅ កម្ពុជា ក្នុង គោលដៅ ពង្រឹង ប្រសិទ្ធភាព ក្នុង ការ គ្រប់ គ្រង មូលនិធិ នេះ៕
- ក្រុមហ៊ុន ចិន និង ក្រុមហ៊ុន កម្ពុជា ចំនួន ៤ បាន ចុះ អនុស្សរណៈ នៃ ការ យោគ យល់ និង កិច្ចសន្យា ពាណិជ្ជ កម្ម ដោយ ផ្តោត លើ កិច្ច សហការ ពាណិជ្ជកម្ម និង ការ វិនិយោគ វិស័យ រ៉ែ វិស័យ សំណង់ និង កសិកម្ម ដែល មាន ទំហំ ទឹក ប្រាក់ ប្រមាណ ១,៥៦ ពាន់ លាន ដុល្លារ។
កិច្ច ព្រម ព្រៀង នេះ ត្រូវ បាន ចុះ ហត្ថលេខា នៅ ក្នុង ការ បើក ពិព័រណ៍ ពាណិជ្ជកម្ម «ផលិតផល នាំ ចេញ នាំ ចូល និង ខេត្ត ១ ផលិតផល ១ លើក ទី៩ កាល ពី ម្សិល មិញ៕
សង្ខេបព្រឹត្តិការណ៍ សេដ្ឋកិច្ចពិភពលោក ឆ្នាំ២០១៤
ជាមួយ នឹង ការ វិវត្ត ទៅ នៃ សេដ្ឋកិច្ច ក្នុង តំបន់ និង លើ សកលលោក ឆ្នាំ ២០១៤ គឺជា ឆ្នាំ មួយ នៃ ការ ផ្លាស់ ប្តូរ របត់ ថ្មី នៃ ទម្រង់ សេដ្ឋកិច្ច ពិភពលោក នៃ ប្រព័ន្ធ សេដ្ឋកិច្ច បែប ឌីជីថល ជា ពិសេស គឺ ការ រីក លូត លាស់ ប្រកប ដោយ ភាព រឹងមាំ នៃ សេដ្ឋកិច្ច របស់ បណ្តា ប្រទេស នៅ អាស៊ី។
ក្នុង ពេល នោះ ដែល ក្រុម ហ៊ុន នេះ ក៏ បាន ដាក់ បង្ហាញ ខ្សែ ដៃ ទំនើប ដែល អាច តាម ដាន សុខភាព សម្រាប់ អតិថិជន ដែល យក ចិត្ត ទុក ដាក់ ចំពោះ សុខភាព ផង ដែរ៕
មេសា - ជប៉ុន និង អូស្រ្តាលី បាន ឈាន ដល់ កិច្ច ព្រម ព្រៀង ធំ មួយ ស្តីពី ពាណិជ្ជ កម្ម ទ្វេ ភាគី បន្ទាប់ ពី ការ ពិភាក្សា គ្នា អស់ រយៈ ពេល ៧ ឆ្នាំ ដែល នឹង កាត់ បន្ថយ ឬ លើក លែង ពន្ធ លើ ទំនិញ សព្វ សារពើ រាប់ ចាប់ ពី រថយន្ត រហូត ដល់ ប៉េងប៉ោះ កំប៉ុង៕
ឧសភា - យោង តាម អង្គការ OECD ប្រទេស ចំនួន ៤៧ បាន ចុះ ហត្ថលេខា ចែក រំលែក ទិន្នន័យ ធនាគារ ដោយ ស្វ័យ ប្រវត្តិ រួម ទាំង សិង្ហបុរី និង ស្វ៊ីស ដែល ជា មជ្ឈមណ្ឌល ហិរញ្ញវត្ថុ សំខាន់ ផង ដែរ។
- ធនាគារ អភិវឌ្ឍន៍ អាស៊ី បាន ឲ្យ ដឹង ថា ការ វិនិយោគ នៅ តំបន់ អាស៊ាន លើ ការ អភិវឌ្ឍ ហេដ្ឋា រចនា សម្ព័ន្ធ មាន កម្រិត ទាប ជាង ពាក់ កណ្តាល នៃ ទំហំ ដែល ត្រូវ ការ ដើម្បី បម្រើ ឲ្យ តម្រូវ ការ ប្រចាំ តំបន់ នៅ ត្រឹម ឆ្នាំ ២០២០ ដោយ សារ ទីផ្សារ មូលធន មិន វិវឌ្ឍ ទៅ មុខ របស់ តំបន់ នេះ៕
- ប្រធាន សមាគម កសិករ ថៃ បាន សាទរ ចំពោះ សេចក្តី សម្រេច របស់ មេ ដឹកនាំ ធ្វើ រដ្ឋ ប្រហារ ស្តីពី ការ ទូទាត់ ប្រាក់ ឲ្យ បាន ឆាប់ រហ័ស ដល់ ក្រុម កសិករ ក្នុង គម្រោង សន្យា ទិញ ស្រូវ ដែល បាន អូស បន្លាយ ពេល យូរ មក ហើយ នោះ និង ព្យាយាម បន្ត គាំទ្រ ដល់ តម្លៃ ស្រូវ ផង ដែរ៕
មិថុនា - ចក្រភព អង់គ្លេស និង ចិន បាន ចុះ កិច្ច ព្រម ព្រៀង ពាណិជ្ជកម្ម មួយ ចំនួន ដែល មាន តម្លៃ ប្រហែល ២៨ ពាន់ លាន ដុល្លារ ក្នុង ដំណើរ ទស្សនកិច្ច ទៅ កាន់ ទីក្រុង ឡុងដ៍ របស់ លោក នាយក រដ្ឋ មន្ត្រី ចិន លី កេឈាង ក្នុង បំណង រឹត ចំណង សេដ្ឋកិច្ច និង ការ ទូត ឡើង វិញ៕
កក្កដា - ប្រទេស ជប៉ុន និង ម៉ុងហ្គោលី បាន ចុះ កិច្ច ព្រម ព្រៀង ពាណិជ្ជកម្ម មួយ នៅ ពេល ថ្នាក់ ដឹក នាំ របស់ ប្រទេស ទាំង ពីរ បាន ជួប ពិភាក្សា នៅ ទីក្រុង តូក្យូ ខណៈ ជប៉ុន សម្លឹង ទាញ យក ផល ប្រយោជន៍ ពី កំណើន សេដ្ឋកិច្ច ខ្ពស់ និង ធនធាន ធម្មជាតិ ជា ច្រើន របស់ ម៉ុងហ្គោលី៕
- ប្រទេស កូរ៉េ ខាង ត្បូង បាន ប្រកាស កញ្ចប់ ថវិកា ជំរុញ សេដ្ឋកិច្ច ចំនួន ៤០ ពាន់ លាន ដុល្លារ ខណៈ រដ្ឋ មន្ត្រី ក្រសួង ហិរញ្ញវត្ថុ របស់ ប្រទេស មួយ នេះ បាន រំឭក ពី ហានិភ័យ នៃការ ដើរ ថយ ក្រោយ នៃ សេដ្ឋកិច្ច បន្ទាប់ ពី សេដ្ឋកិច្ច របស់ ប្រទេស នេះ សម្រេច បាន កំណើន ទាប បំផុត ក្នុង រយៈ ពេល ជាង មួយ ឆ្នាំ នៅ ត្រីមាស ទីពីរ៕
ធនាគារ អភិវឌ្ឍន៍ នេះ នឹង មាន មូលធន ដំបូង ចំនួន ៥០ ពាន់ លាន ដុល្លារ ដែល អាច កើន ឡើង ដល់ ១០០ ពាន់ លាន ដុល្លារ ខណៈ មូលនិធិ បម្រុង នឹង មាន មូលធន ចំនួន ១០០ ពាន់ លាន ដុល្លារ៕
- សហរដ្ឋ អាមេរិក និង សហភាព អឺរ៉ុប បាន កំណត់ គោលដៅ លើ វិស័យ សំខាន់ៗ របស់ រុស្ស៊ី គឺ វិស័យ ហិរញ្ញវត្ថុ ការពារ ជាតិ និង ថាមពល ដោយ ដាក់ បន្ថែម ទណ្ឌកម្ម ថ្មី យ៉ាង តឹង រ៉ឹង ដើម្បី ឆ្លើយ តប នឹង អន្តរាគមន៍ របស់ រដ្ឋាភិបាល ក្រុង ម៉ូស្គូ ទៅ ក្នុង វិបត្តិ នៅ ប្រទេស អ៊ុយក្រែន៕
សីហា - រដ្ឋាភិបាល ក្រុង តូក្យូ និង ញូវដែលី បាន ចុះ ហត្ថលេខា លើ កិច្ច ព្រម ព្រៀង មួយ ដែល នឹង នាំ ចូល រ៉ែ កម្រ ពី ប្រទេស ឥណ្ឌា ចំនួន ប្រមាណ ២ ពាន់ តោន ខណៈ ប្រទេស ជប៉ុន ព្យាយាម ធ្វើ ពិពិធកម្ម ការ ផ្គត់ផ្គង់ រ៉ែ ដើម្បី ងាក ចេញ ពី ប្រទេស ចិន៕
- រដ្ឋាភិបាល ជប៉ុន បាន ប្រកាស កាល ព័ត៌មាន លម្អិត ស្តីពី ការ ទណ្ឌកម្ម ហិរញ្ញវត្ថុ ប្រឆាំង នឹង បុគ្គល ចំនួន ៤០ រូប និង ក្រុមហ៊ុន ចំនួន ពីរ ដែល ទាក់ ទង នឹង ការ ដណ្តើម យក តំបន់ គ្រីមា និង ការ បង្ក អស្ថិរភាព នៅ ភាគ ខាង កើត ប្រទេស អ៊ុយក្រែន៕
កញ្ញា - មេ ដឹក នាំ របស់ ប្រទេស កាណាដា និង សហភាព អឺរ៉ុប បាន ឈាន ដល់ កិច្ច ព្រម ព្រៀង ពាណិជ្ជកម្ម សេរី ជា ផ្លូវ ការ មួយ ដែល ត្រូវ បាន មើល ឃើញ ថា មូលដ្ឋាន មួយ សម្រាប់ កិច្ច ព្រម ព្រៀង កាន់ តែ ធំ មួយ ទៀត រវាង សហភាព អឺរ៉ុប និង អាមេរិក។
តុលា - ប្រទេស ជប៉ុន បាន ឲ្យ ដឹង ថា ខ្លួន បាន បន្ធូរ បន្ថយ លក្ខខណ្ឌ ទិដ្ឋាការ របស់ ខ្លួន យ៉ាង ខ្លាំង សម្រាប់ ក្រុម ភ្ញៀវ ទេសចរ មក ពី ប្រទេស ឥណ្ឌូនេស៊ី ហ្វីលីពីន និង វៀតណាម។
ការ សម្រេច ធ្វើ ដូចនេះ គឺជា ផ្នែក មួយ នៃ វិធានការ របស់ ជប៉ុន ក្នុង ការ បង្កើន ចំនួន ភ្ញៀវ ទេសចរ បរទេស ឲ្យ ដល់ ២០ លាន នាក់ ក្នុង មួយ ឆ្នាំ នៅ ឆ្នាំ ២០២០ បន្ទាប់ ពីបាន កើន ឡើង ដល់ ១០ លាន នាក់ នៅ ឆ្នាំ ២០១៣៕
- ធនាគារ កណ្ដាល រុស្ស៊ី និង ធនាគារ កណ្តាល ចិន បាន ចុះ ហត្ថលេខា លើ កិច្ច ព្រមព្រៀង មួយ ស្ដី ពី ការ ដោះ ដូរ ប្រាក់ យន់ របស់ ចិន និង ប្រាក់ រូបល របស់ រុស្ស៊ី ដើម្បី បង្កើន ពាណិជ្ជ កម្ម ទ្វេ ដង។
កិច្ច ព្រម ព្រៀង ដោះដូរ រយៈ ពេល ៣ ឆ្នាំ នេះ មាន តម្លៃ ២៤,៥ ពាន់ លាន ដុល្លារ និង ជា កិច្ច ព្រម ព្រៀង មួយ ក្នុង ចំណោម កិច្ច ព្រម ព្រៀង ចំនួន ៣៨ ដែល បាន ចុះ ហត្ថលេខា រវាង ចិន និង រុស្ស៊ី៕
- សហរដ្ឋ អាមេរិក និង ប្រទេស ចិន បាន ឈាន ដល់ ការ យោគ យល់ មួយ ដើម្បី កាត់ បន្ថយ ពន្ធ លើ ពាណិជ្ជកម្ម បច្ចេកវិទ្យា ព័ត៌មាន ជា អ្វី រដ្ឋាភិបាល ក្រុង វ៉ាស៊ីនតោន បាន អំពាវ នាវ ឲ្យ មាន ការ ជំរុញ ដល់ កិច្ច ខិត ខំ ប្រឹង ប្រែង របស់ អង្គការ ពាណិជ្ជកម្ម ពិភពលោក ដើម្បី កាត់ បន្ថយ ពន្ធ ពាណិជ្ជកម្ម៕
ធ្នូ - លោក បារ៉ាក់ អូបាម៉ា បាន ដាក់ ទណ្ឌកម្ម ទ្រង់ ទ្រាយ ធំ ទៅ លើ តំបន់ គ្រីមា ដែល ត្រូវ បាន ដណ្តើម យក ដោយ ប្រទេស រុស្ស៊ី ជាមួយ នឹង ការ ប្រើ ប្រាស់ បញ្ជា ប្រតិបត្តិ មួយ ហាម ឃាត់ ការ នាំ ចេញ ទំនិញ ឬ សេវាកម្ម របស់ អាមេរិក ទៅ ឧបទ្វីប នេះ និង ហាម ឃាត់ ការ នាំ ចូល ពី តំបន់ គ្រីមា ផង ដែរ៕
- ប្រទេស ថៃ និង ប្រទេស ចិន បាន ចុះ កិច្ច ព្រម ព្រៀង មួយ ដើម្បី សាង សង់ ផ្លូវ ដែក ថ្មី ដែល មាន រយៈ ចម្ងាយ ឆ្ងាយ មួយ ដើម្បី បំពេញ តាម មហិច្ឆតា របស់ ថៃ ក្នុង ការ កែ លម្អ ប្រព័ន្ធ ផ្លូវ រថភ្លើង មិន សូវ ល្អ របស់ ខ្លួន៕
តម្លៃ ប្រេង បាន ធ្លាក់ ថ្លៃ ប្រហែល ពាក់ កណ្តាល ក្នុង រយៈ ពេល ៦ ខែ ចុង ក្រោយ នេះ ពី តម្លៃ ប្រហែល ១១០ ដុល្លារ ក្នុង មួយ ធុង៕
ក្រុមហ៊ុនវៀតណាមដំណើរការរោងចក្រកែច្នៃកៅស៊ូក្រែបនៅកម្ពុជា
រោងចក្រ ដែល ចំណាយ ប្រាក់ ៥,២ លាន ដុល្លារ អាមេរិក បន្ទាប់ ពី ការ សាងសង់ រយៈ ពេល ពីរ ឆ្នាំ ត្រូវ បាន សម្ពោធ ឲ្យ ដំណើរការ នៅ ក្នុង ស្រុក អូរយ៉ាដាវ ខេត្ត រតនគិរី កាល ពី ថ្ងៃ ទី២៣ ខែ ធ្នូ។
លោក ម៉ែន សុភ័ក្ត្រ អគ្គ នាយក ចម្ការ កៅស៊ូ ជប់ ដែល ជា ក្រុមហ៊ុន មួយ ក្នុង ចំណោម ក្រុមហ៊ុន នាំ ចេញ កៅស៊ូ ដ៏ សំខាន់ របស់ ប្រទេស កម្ពុជា បាន ថ្លែង ថា៖
កាល ពី ខែ វិច្ឆិកា ការ ធ្វើ សវនកម្ម របស់ រដ្ឋាភិបាល បាន រក ឃើញ ថា ក្រុមហ៊ុន រដ្ឋ របស់ វៀតណាម មួយ នេះ បាន ខាតបង់ ជិត ៣៩១ លាន ដុល្លារ នៅ ក្នុង អំឡុង ពេល ៥ ឆ្នាំ ដែល រួម មាន ២២,៧៥ លាន ដុល្លារ បាន ពី ចម្ការ កៅស៊ូ កម្ពុជា នៅ ក្នុង ខេត្ត ក្រចេះ៕
ផ្សារទំនិញរួចពន្ធដំបូងបើកនៅសៀមរាប
«យើង មាន បំណង ផ្ដល់ ផលិតផល លំដាប់ ខ្ពស់ តាម រយៈ ការ ដាក់ បង្ហាញ យីហោ ល្បី ឈ្មោះ និង លំដាប់ ខ្ពស់ របស់ ពិភពលោក ជាមួយ នឹង ចំណាត់ ថ្នាក់ ផលិតផល ជាច្រើន ដូចជា គ្រឿង សម្អាង សម្លៀក បំពាក់ ពេញ និយម គ្រឿង អលង្ការ ថ្នាំ ជក់ ស្រា និង ទឹក អប់»។
«យើង រីករាយ ដែល មាន ហាង លក់ ទំនិញ រួច ពន្ធ នៅ ទីប្រជុំជន នៅ ក្នុង ខេត្ត សៀមរាប ហើយ យើង ជឿជាក់ ថា ហាង នេះ នឹង ជួយ ទាក់ទាញ ភ្ញៀវ ទេសចរ កាន់ តែ ច្រើន ជា ពិសេស ភ្ញៀវ ទេសចរ ជនជាតិ ចិន។
យើង មាន សេចក្ដី រីករាយ ដែល បាន ឮ ថា ក្រុមហ៊ុន នេះ នឹង បរិច្ចាគ ប្រាក់ ចំណេញ មួយ ចំនួន របស់ ខ្លួន ដល់ មន្ទីរពេទ្យ គន្ធបុប្ផា ដើម្បី ជួយ ដល់ ក្មេងៗ របស់ យើង»។
ក្រសួងឲ្យបញ្ចូលប្រាក់គ្រប់ប្រភេទក្នុងគណនីផ្ទាល់
សារាចរ ណែនាំ កាលពី ថ្ងៃ ទី២៩ ធ្នូ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ឲ្យ ដឹងថា ក្រសួង បាន ណែនាំ ដល់ គ្រឹះស្ថាន សាធារណៈ របស់ រដ្ឋ និង អង្គភាព ពាក់ព័ន្ធ ទាំង អស់ ឲ្យ ផ្តើម អនុវត្ត ការ ទូទាត់ ទឹក ប្រាក់ គ្រប់ ប្រភេទ ដល់ មន្ត្រី រាជការ ដោយ ផ្ទាល់ តាម ធនាគារ ដោយ បង្វែរ ត្រង់ ទៅ គណនី ប្រាក់ បៀវត្សរ៍ របស់ មន្ត្រី រាជការ ផ្ទាល់ តែ ម្តង។
ខណៈ ដែល ប្រាក់ បៀវត្សរ៍ មន្ត្រី រាជការ ត្រូវ បាន បើក តាម ប្រព័ន្ធ ធនាគារ ចាប់ តាំង ពី ដើម ឆ្នាំ ២០១៤ នេះ មក ការ បើក ប្រាក់ បុព្វលាភ ប្រាក់ បំណាច់ ប្រាក់ បេសកកម្ម ប្រាក់ សង្គមកិច្ច ប្រាក់ ថែម ម៉ោង និង ប្រាក់ ឧបត្ថម្ភ ផ្សេងៗ នៅ ធ្វើ ឡើង តាម រយៈ ការ បើក ជា សាច់ ប្រាក់ សុទ្ធ។
លោក ម៉ី វ៉ាន់ អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ឧស្សាហកម្ម ហិរញ្ញវត្ថុ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិល មិញ ថា ការ ដំណើរការ បើក ប្រាក់ បៀវត្សរ៍ ប្រាក់ ថែម ម៉ោង និង ប្រាក់ លើក ទឹក ចិត្ត ផ្សេងៗ តាម ប្រព័ន្ធ ធនាគារ នេះ គឺ ដើម្បី ធានា តម្លាភាព ក្នុង ការ ចែក ចាយ ប្រាក់ ចំណូល និង ដើម្បី ស្រាយ មន្ទិល ដែល ធ្លាប់ លើក ឡើង កន្លង មក ទាក់ ទង នឹង ការ បាត់ បង់ ឬ កិបកេង ប្រាក់ មន្ត្រី រាជការ។
លោក បន្ថែម ថា យន្តការ ថ្មី នេះ ក៏ ជា ចំណែក ធ្វើ ឲ្យ សាច់ ប្រាក់ នៅ ក្នុង ប្រព័ន្ធ ធនាគារ កើន ឡើង និង ដើម្បី បង្កើន លំហូរ សាច់ ប្រាក់ នៅ ក្នុង ប្រព័ន្ធ សេដ្ឋកិច្ច ផង ដែរ។
បន្ថែម ពីនេះ វា ក៏ សម្រួល ដល់ មន្ត្រី រាជការ ក្នុង ការ ប្រើ ប្រាស់ សាច់ ប្រាក់ របស់ ពួក គាត់ បាន ងាយ ស្រួល តាម រយៈ សេវាកម្ម នៅ ក្នុង ប្រព័ន្ធ ធនាគារ ផង ដែរ។
សារាចរ ណែនាំ របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ មិន បាន បញ្ជាក់ ពី ទឹក ប្រាក់ សរុប ប្រចាំ ខែ ឬ ឆ្នាំ ដែល ត្រូវ ចំណាយ សម្រាប់ បើក ជូន មន្ត្រី រាជការ ទាំង អស់ ទាក់ ទង នឹង ទឹក ប្រាក់ បេសកកម្ម ប្រាក់ ម៉ោង បន្ថែម ឬ ប្រាក់ ឧបត្ថម្ភ ផ្សេងៗ នោះ ទេ។
តំណាង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ក៏ មិន អាច ជួយ បញ្ជាក់ ពី ការ ប៉ាន់ ស្មាន នេះ បាន ដែរ កាល ពី ម្សិល មិញ។
រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច បើក ប្រាក់ បៀវត្សរ៍ មន្ត្រី រាជការ តាម ប្រព័ន្ធ ធនាគារ ចាប់ពី ដើម ឆ្នាំ ២០១៤ ហើយ ភាគ ច្រើន នៃ មន្ត្រី រាជការ បាន បើក គណនី នៅ ធនាគារ អេស៊ីលីដា។
លោក អ៊ិន ចាន់នី ប្រធាន អគ្គ នាយក ធនាគារ អេស៊ីលីដា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិល មិញ ថា ចំនួន មន្ត្រី រាជការ បម្រើ ការ នៅ ស្ថាប័ន សាធារណៈ ដែល មាន គណនី បើក ប្រាក់ បៀវត្សរ៍ តាម ធនាគារ មាន ចំនួន សរុប ប្រហែល ៣០ ម៉ឺន នាក់ ហើយ ក្នុង នោះ អ្នក ដែល បាន បើក គណនី ធនាគារ នៅ អេស៊ីលីដា មាន ជាង ២០ ម៉ឺន គណនី។
«ការ សម្រេច ថ្មី នេះ ជា ការ ប្រសើរ ថែម ទៀត សម្រាប់ មន្ត្រី រាជការ ក្នុង ការ ប្រើ ប្រាស់ លាភការ ផ្សេងៗ បាន ស្រួល ដោយ សារ ធនាគារ មាន ប្រព័ន្ធ មាន ហេដ្ឋា រចនា សម្ព័ន្ធ និង ធនធាន គ្រប់ គ្រាន់ ដើម្បី ធ្វើ ឲ្យ មន្ត្រី រាជការ របស់ យើង ប្រើប្រាស់ ការ ទូទាត់ បាន ងាយ ស្រួល»៕
តែ ពុំ មាន ព័ត៌មាន លម្អិត ស្តីពី ប្រតិបត្តិការ នេះ ទេ។
ការ ប្រកាស នេះ បាន ធ្វើ ឡើង នៅ ពេល មាន ទំនាក់ ទំនង មិន ល្អ រវាង ប្រទេស រុស្ស៊ី និង ក្រុម ប្រទេស លោក ខាង លិច ជុំ វិញ ការ លេប យក តំបន់ គ្រីមា ពី សំណាក់ រដ្ឋាភិបាល ក្រុង ម៉ូស្គូ និង ការ គាំទ្រ ដល់ ក្រុម ឧទ្ទាម នៅ ភាគ ខាង កើត ប្រទេស អ៊ុយក្រែន។
បំពង់ ចែក ចាយ ឧស្ម័ន នេះ បាន ឆ្លង កាត់ ប្រទេស អ៊ុយក្រែន និង ឆ្លង កាត់ ដែន ទឹក របស់ ប្រទេស តួកគី ក្នុង សមុទ្រ ខ្មៅ ហើយ ឆ្លង កាត់ តាម ប្រទេស ក្នុង តំបន់ Balkans កាត់ តាម ប្រទេស ប៊ុលហ្គារី ស៊ែប៊ី ហុងគ្រី និង ស្លូវេនី បន្ទាប់ មក កាត់ ប្រទេស អូទ្រីស តភ្ជាប់ ជាមួយ បណ្តាញ ចែក ចាយ ឧស្ម័ន សំខាន់ របស់ សហភាព អឺរ៉ុប។
វិបត្តិ បំពង់ ចែក ចាយ នេះ ត្រូវ បាន គេ មើល ឃើញ ថា ជា បញ្ហា សំខាន់ បើ ទោះ ជា ទំនាក់ ទំនង រវាង ប្រទេស ទាំង នោះ បាន ល្អក់ កករ ខ្លាំង គិត ចាប់ ពី សង្គ្រាម ត្រជាក់ មក ក្តី៕
កូរ៉េខាងត្បូងទទួលបានអតិរេកគណនីចរន្តខ្ពស់បំផុត
តួលេខ ជា បឋម នៃ អតិរេក ១១,៤ ពាន់ លាន ដុល្លារ មាន កម្រិត ខ្ពស់ ជាង អតិរេក ប្រចាំ ខែ ខ្ពស់ បំផុត ១១,១ ពាន់ លាន ដុល្លារ កាល ពី ខែ តុលា ឆ្នាំ មុន នេះ បើ តាម ទិន្នន័យ ធនាគារ កណ្តាល កូរ៉េ។
គណនី ចរន្ត ដែល ជា ការ វាស់ ស្ទង់ ពាណិជ្ជកម្ម បរទេស ផ្នែក ទំនិញ និង សេវាកម្ម ធំ ជាង គេ សម្រេច បាន អតិរេក រយៈ ពេល ២ ឆ្នាំ និង ៩ ខែ និង ជា អតិរេក ក្នុង រយៈ ពេល យូរ បំផុត គិត ចាប់ ពី ឆ្នាំ ១៩៨៩។
ប្រទេស កូរ៉េ ខាង ត្បូង នាំ ចូល ថាមពល ស្ទើរ តែ ទាំង ស្រុង ពី បរទេស។
គណនី ចំណូល ដែល តាម ដាន ប្រាក់ ឈ្នួល ក៏ ដូច ជា ប្រាក់ ចំណូល លើ ការ វិនិយោគ ហិរញ្ញវត្ថុ វិញ សម្រេច បាន អតិរេក ១,៧ ពាន់ លាន ដុល្លារ ដោយ សារ កំណើន ភាគ លាភ និង ចំណូល អត្រា ការ ប្រាក់៕
«ការ ពិភាក្សា ជាមួយ នឹង អាជ្ញាធរ ក្រិក ស្តីពី ការ បញ្ចប់ ការ វាយ តម្លៃ លើក ទី៦ នៃ កម្មវិធី ផ្តល់ ជំនួយ នេះ នឹង ចាប់ ផ្តើម ឡើង វិញ នៅ ពេល ដែល រដ្ឋាភិបាល ថ្មី ត្រូវ បាន បង្កើត ឡើង រួច រាល់ ដោយ មាន ការ ពិភាក្សា ជាមួយ នឹង គណៈកម្មាធិការ អឺរ៉ុប និង ធនាគារ កណ្តាល អឺរ៉ុប»។
ប្រទេស ក្រិក មិន ប្រឈម នឹង តម្រូវ ការ ហិរញ្ញវត្ថុ បន្ទាន់ នោះ ទេ»។
ការ បោះ ឆ្នោត បាន បង្ក ការ ងឿង ឆ្ងល់ ថា តើ រដ្ឋាភិបាល ក្រុង អាថែន អាច បន្ត ទទួល បាន ថវិកា សង្គ្រោះ ដ៏ ច្រើន សន្ធឹក សន្ធាប់ ឆ្នាំ ២០១២ នៅ ក្នុង ដំណាក់ កាល ថ្មី នេះ បាន ដោយ របៀប ណា ខណៈ ប្រទេស នេះ សង្ឃឹម ថា នឹង សម្រេច បាន កំណើន សេដ្ឋកិច្ច ឡើង វិញ នៅ ឆ្នាំ ក្រោយ៕
សេដ្ឋកិច្ចរុស្ស៊ីធ្លាក់លើកដំបូង
សេដ្ឋកិច្ច របស់ ប្រទេស នាំចេញ ថាមពល ធំ ជាង គេ របស់ ពិភពលោក មួយ នេះ កំពុង ប្រឈម នឹង ការ ធ្លាក់ ចុះ ជា លើក ដំបូង របស់ ខ្លួន នៅ ឆ្នាំ ក្រោយ គិត ចាប់ តាំង ពី ឆ្នាំ ២០០៩ ដោយសារ ប្រេង ដែល ការ ជួញ ដូរ ជិត ដល់ កម្រិត ទាប រយៈ ពេល ៥ឆ្នាំ និង ការ ដាក់ ទណ្ឌកម្ម បាន ជំរុញ ឲ្យ ប្រទេស រុស្ស៊ី ធ្លាក់ ចូល ក្នុង វិបត្តិ រូបិយប័ណ្ណ ធំ ជាង គេ របស់ ខ្លួន ចាប់ តាំង ពី ឆ្នាំ ១៩៩៨។
និន្នាការ អវិជ្ជមាន បាន បន្ត ក្នុង វិស័យ សំណង់ ការ លក់ ដុំ និង កសិកម្ម។
ការ បង្ហាញ ក្រោម ៥០ មាន ន័យ ថា ធ្លាក់ ចុះ៕
ការជួញដូរឧបករណ៍និស្សន្ទនឹងចាប់ផ្តើមឆាប់ៗ
លោក ស៊ូ សុជាតិ បាន ឲ្យ ដឹង កាលពី សប្តាហ៍ មុន ថា សេចក្តី ប្រកាស ថ្មី ស្ដីពី ការ ផ្តល់ អាជ្ញាប័ណ្ណ និង ការ គ្រប់គ្រង ការ ជួញដូរ ឧបករណ៍ និស្សន្ទ គឺ ត្រូវ បាន គណៈកម្មការ មូលបត្រ កម្ពុជា (ក.ម.ក) បាន រៀបចំ និង តាក់តែង សេចក្តី ព្រាង ប្រកាស នេះ អស់ រយៈពេល ជាង មួយ ឆ្នាំ មក ហើយ ហើយ នឹង គ្រោង រៀបចំ សិក្ខាសាលា ពិភាក្សា ជា សាធារណៈ មួយ ដើម្បី ស្វែងរក ធាតុ ចូល ពី សាធារណជន អ្នក ពាក់ព័ន្ធ និង អ្នក ជំនាញ ដែល នឹង ត្រូវ ធ្វើ នៅ ថ្ងៃ ទី ៨ ខែ មករា ។
លោក សុជាតិ សង្ឃឹម ថា វា នឹង ត្រួសត្រាយ ផ្លូវ សម្រាប់ ការ អនុម័ត ទៅលើ សេចក្តី ប្រកាស នេះ ក្នុង រយៈពេល ដ៏ខ្លី ខាង មុខ នេះ ។
«ឧបករណ៍ និស្សន្ទ ដែល ជា កិច្ចព្រមព្រៀង ខុស ប្លែក គ្នា នា ពេល អនាគត ជា ផលិតផល មួយ ក្នុង ចំណោម ផលិតផល ជាច្រើន សម្រាប់ ការ អភិវឌ្ឍ ទីផ្សារហ៊ុន របស់ យើង ហើយ យើង មើល ឃើញ ថា សាធារណជន និង ប្រតិបត្តិករ ជាច្រើន មាន ចំណាប់ អារម្មណ៍ ខ្លាំង ក្នុង ការ ជួញដូរ ផលិតផល ទាំងនេះ» ។
« នៅពេល យើង ប្រមូល បាន ធាតុ ចូល បន្ថែម ទៀត ពី ភាគី ពាក់ព័ន្ធ អ្នកជំនាញ និង យើង នឹង ដាក់ ប្រកាស នេះ ជូន ទៅ ប្រធាន ក្រុមប្រឹក្សា ភិបាល គណៈកម្មការ មូលបត្រ កម្ពុជា ដើម្បី ត្រួតពិនិត្យ និង អនុម័ត ចុងក្រោយ ។
ឧបករណ៍ និស្សន្ទ ផ្ដល់ ដល់ អ្នក ទិញ នូវ ឱកាស ក្នុង ការ ទាញ យក ប្រយោជន៍ ដែល ជាប់ ពាក់ព័ន្ធ ទៅ នឹង ហានិភ័យ ការ ប្រែប្រួល តម្លៃ នៃ ឧបករណ៍ ហិរញ្ញវត្ថុ មួយ នេះ នា ពេល អនាគត។
ឧបករណ៍ នេះ ជាប់ ទាក់ទង នឹង កិច្ចសន្យា ថ្លៃ មាន ដូចជា ការ ប្រែប្រួល នៃ ថ្លៃ សន្លឹកប័ណ្ណ បំណុល ការ ប្រែប្រួល នៃ រូបិយប័ណ្ណ ភាគហ៊ុន ឬ ទំនិញ ប្រើប្រាស់ ។
កិច្ចព្រមព្រៀង នេះ អនុញ្ញាត ឲ្យ ក្រុមហ៊ុន នាំ ចេញ ត្រូវ បញ្ចូល តម្លៃ ជួញដូរ ដែល ព្រមព្រៀង គ្នា ជាមួយ ធនាគារ ដើម្បី ការពារ ប្រឆាំង នឹង ហានិភ័យ នៃ ការ ធ្លាក់ ចុះ តម្លៃ ប្រេង នា ពេល អនាគត ។
លោក សុជាតិ បាន បដិសេធ មិន បង្ហាញ ពី ឧបករណ៍ និស្សន្ទ ប្រភេទ អ្វី នឹង ត្រូវ ជួញដូរ នៅលើ ក្រុមហ៊ុន ផ្សារមូលបត្រ កម្ពុជា (ផ.ស.ក) នោះ ទេ ដោយសារ តែ វា គឺ កំពុង ស្ថិត ក្នុង ដំណាក់កាល នៃ ការ កៀរគរ មតិ នានា ពី សាធារណជន ចំពោះ សេចក្តី ព្រាង នៃ ប្រកាស ថ្មី នេះ។
លោក ស្វាយ ហៃ នាយក ក្រុមហ៊ុន ជើងសា មូលបត្រ អេស៊ីលីដា បាន ថ្លែង ថា ការ ជួញដូរ ឧបករណ៍ និស្សន្ទ នឹង ទាក់ទាញ ចំណាប់ អារម្មណ៍ របស់ វិនិយោគិន ដែល ចូលចិត្ត ជម្រើស ការ ជួញដូរ រយៈពេល ខ្លី ។
«វា ល្អ ដោយសារ តែ វា គឺ ការ បំពេញ បន្ថែម សម្រាប់ ការ អភិវឌ្ឍ ផ្សារហ៊ុន របស់ យើង នេះ មាន ន័យ ថា វិនិយោគិន អាច មាន ជម្រើស ច្រើន ថា តើ ត្រូវ ទិញ ភាគហ៊ុន ពី ក្រុមហ៊ុន ចុះ បញ្ជី ឬ ទៅ ទិញ ផលិត ឧបករណ៍ និស្សន្ទ »។
កាលពី ឆ្នាំ ២០១១ គណៈកម្មការ ផ្សារ មូលបត្រ កម្ពុជា បាន ធ្វើការ ហាមឃាត់ លើ ក្រុមហ៊ុន ជួញដូរ ឧបករណ៍ និស្សន្ទ ដែល គ្មាន អាជ្ញាប័ណ្ណ ខណៈ និយតករ ជុំវិញ ពិភពលោក បាន ធ្វើការ ព្យាយាម កាន់តែ ធំ ដើម្បី ត្រួតពិនិត្យ លើ ឧបករណ៍ ដ៏ស្មុគស្មាញ មួយ នេះ ចាប់ តាំងពី កើត មាន ហានិភ័យ ដែល បាន នាំឲ្យ មាន វិបត្តិ ហិរញ្ញវត្ថុ ពិភពលោក ពី ឆ្នាំ ២០០៨ ៕
លោក កែវ ស៊ីវន ប្រធាន ផ្នែក ការ ហោះហើរ នៃ អាកាសចរ ស៊ីវិល បាន ប្រាប់ ភ្នំពេញ ប៉ុស្ដិ៍ កាលពី ម្សិលមិញ ថា យ៉ាង ហោច ណាស់ មាន ក្រុមហ៊ុន អាកាសចរណ៍ ច្រើន ជាង ៣ ត្រូវ រំពឹង ថា នឹង ដាក់ ពាក្យ ស្នើ សុំ AOC នៅ ដើម ឆ្នាំ ក្រោយ ។
លោក បាន បន្ត ថា ក្រុមហ៊ុន អាកាសចរណ៍ ផ្ដោតលើ ជើង ហោះហើរ អន្តរជាតិ ជា ជាង ជើង ហោះហើរ ក្នុង ស្រុក ដោយសារ តែ ទីផ្សារ មាន សក្ដានុពល ប៉ុន្តែ មិន បាន បង្ហាញ ទិសដៅ ពិតប្រាកដ នៅក្នុង ផែនការ ពី ក្រុមហ៊ុន អាកាសចរណ៍ ទាំងនេះ ទេ ។
លោក បាន បន្ថែម ថា ជាមួយ ក្រុមហ៊ុន អាកាសចរណ៍ ៥ ត្រូវ បាន ផ្ដល់ AOC រួច ហើយ នៅ ទីផ្សារ អាកាសចរណ៍ កម្ពុជា នៅ តែ មាន កន្លែង សម្រាប់ ក្រុមហ៊ុន អាកាសចរណ៍ ជាច្រើន ទៀត បើ សេដ្ឋកិច្ច ប្រទេស នេះ បន្ត កើនឡើង ។
យោងតាម លោក ស៊ិន ចាន់សិរីវុត្ថា អ្នក នាំពាក្យ រដ្ឋលេខាធិការដា្ឋន អាកាសចរ ស៊ីវិល វិនិយោគិន ក្រុមហ៊ុន អាកាសចរណ៍ មកពី ប្រទេស ចិន និង កោះ តៃវ៉ាន់ ។
« ក្រុមហ៊ុន អាកាសចរណ៍ ដែល ត្រូវ រំពឹង ថា នឹង ចូល មក គឺជា ក្រុមហ៊ុន អាកាសចរណ៍ ធុន តូច និង មធ្យម ។
ក្រុមហ៊ុន ទាំងនេះ យ៉ាង ហោច ណាស់ មាន យន្តហោះ ពីរ គ្រឿង » ។
ចំនួន នេះ ឆ្លុះបញ្ចាំង ពី ការ កើនឡើង ចំណាប់ អារម្មណ៍ មកលើ ទីផ្សារ អាកាសចរណ៍ របស់ កម្ពុជា មកពី វិនិយោគិន ជនជាតិ ចិន ។
« ទីផ្សារ អាកាសចរណ៍ នៅក្នុង ប្រទេស ចិន គឺ ធំ។
ការ កើនឡើង ក្រុមហ៊ុន អាកាសចរណ៍ ទំនង ជា មាន លទ្ធផល ច្រើន ដោយសារ មាន សហប្រតិបត្តិការ រវាង ប្រទេស កម្ពុជា និង ចិន លើ ទំនាក់ទំនង សេដ្ឋកិច្ច ជាពិសេស នៅក្នុង វិស័យ ទេសចរណ៍ » ។
លោក អាង គឹមអៀង ប្រធាន សមាគម ភ្នាក់ងារ ទេសចរណ៍ កម្ពុជា បាន ថ្លែង ថា ជើង ហោះហើរ កាន់តែ ច្រើន នឹង ផ្ដល់ អត្ថប្រយោជន៍ ដល់ ឧស្សាហកម្ម ទេសចរណ៍ កម្ពុជា កាន់តែ ច្រើន ។
ទោះបី ជា ខ្ញុំ សង្ឃឹម ថា នឹង មើល ឃើញ ជើង ហោះហើរ ចម្ងាយ វែង កាន់តែ ច្រើន ប៉ុន្តែ ជើង ហោះហើរ កាន់តែ ច្រើន ទៅកាន់ បណ្ដា ប្រទេស ក្នុង តំបន់ ក៏ ត្រូវការ សម្រាប់ កម្ពុជា ដើម្បី ចាប់ យក ភ្ញៀវទេសចរ កាន់តែ ច្រើន ផង ដែរ» ៕
កម្ពុជាកំពុងបង្កើនការទាក់ទាញទេសចរចិន
ខ្លឹមសារ សំខាន់ នៅក្នុង MoU នេះ គឺ ផ្តោត សំខាន់ លើ ការ កសាង នូវ កិច្ចសហប្រតិបត្តិការ និង ភាព ជា ដៃគូ ជា យុទ្ធសាស្រ្ត រវាង ក្រសួង ទេសចរណ៍ និង ក្រុមហ៊ុន (CITS) លើ ការ ជំរុញ និង ផ្សព្វផ្សាយ ទេសចរណ៍ កម្ពុជា នៅលើ ទីផ្សារ ចិន តាមរយៈ ការ សម្របសម្រួល រៀបចំ បង្កើត សាខា របស់ ក្រុមហ៊ុន CITS នៅ កម្ពុជា ការ បង្កើត ហាង លក់ ទំនិញ រួច ពន្ធ នៅ តាម គោលដៅ ទេសចរណ៍ សំខាន់ៗ របស់ កម្ពុជា និង ការ ជំរុញ ឲ្យ មាន ជើង ហោះហើរ ពី ទីផ្សារ ចិន កាន់តែ ច្រើន ជាង បច្ចុប្បន្ន ។
លោក ថោង ខុន លើក ឡើង ថា បើ ទោះបី ជា កម្ពុជា បាន ទទួល ចំនួន ភ្ញៀវទេសចរ ចិន កើនឡើង ជា បន្តបន្ទាប់ ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ចំនួន នេះ នៅ មាន គម្លាត ឆ្ងាយ នៅ ឡើយ បើ ធៀប នឹង ចំនួន ទេសចរ ចិន ចូល ទស្សនា ប្រទេស ជិតខាង កម្ពុជា និង កំណើន ចំនួន ទេសចរ ចិន ដើរ កម្សាន្ត នៅ ក្រៅ ប្រទេស។
«កត្តា នេះ បណ្តាល មកពី ការ តភ្ជាប់ ការ ហោះហើរ ពី ទីផ្សារ ធំៗ របស់ ចិន មក កាន់ កម្ពុជា នៅ មាន កម្រិត ការ ឃោសនា ផ្សព្វផ្សាយ របស់ កម្ពុជា នៅ ទីផ្សារ ចិន ក៏ មាន កម្រិត ផលិតផល ទេសចរណ៍ កម្ពុជា យើង នៅ មិន ទាន់ ឆ្លើយតប ទាំង ស្រុង និង ទាន់ ពេលវេលា ទៅ នឹង ទីផ្សារ ទេសចរណ៍ ចិន និង ការ ខ្វះខាត ធនធាន មនុស្ស ក្នុង វិស័យ ទេសចរណ៍» ។
លោក បន្ត ថា អនុស្សរណៈ យោគយល់ នេះ នឹង ក្លាយ ជា ឧបករណ៍ មួយ ដ៏ មាន ប្រសិទ្ធភាព បន្ថែម ទៀត ក្នុង ការ ជំរុញ កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា-ចិន ឲ្យ បាន កាន់តែ ជិតស្និទ្ធ ដែល នឹង ក្លាយ ជា ស្ពាន សម្រាប់ តភ្ជាប់ រវាង ប្រទេស ទាំង ពីរ ទាំង ទិដ្ឋភាព ទេសចរណ៍ សេដ្ឋកិច្ច សង្គម និង វប្បធម៌ ។
គិត ចាប់ពី ខែ មករា ឆ្នាំ ២០១៤ រហូត ដល់ ខែ តុលា កម្ពុជា បាន ទទួល ភ្ញៀវទេសចរ អន្តរជាតិ សរុប ៣,៦ លាន នាក់ ក្នុង នោះ ភ្ញៀវទេសចរ ចិន មាន ចំនួន ច្រើន ជាង គេ គឺ ៤៥ ម៉ឺន នាក់ ។
ខណៈ ទេសចរ ចិន មក ទស្សនា កម្ពុជា បច្ចុប្បន្ន ឈរ នៅ ចំណាត់ថ្នាក់ លើ គេ កម្ពុជា នៅ តែ មាន ឱកាស ច្រើន ក្នុង ការ ទាក់ទាញ ភ្ញៀវ ទេសចរ បរទេស ពី ចិន ដោយសារ ថា ជីវភាព ប្រជាជន ចិន កាន់តែ ប្រសើរ ។
កាលពី ឆ្នាំ ២០១៣ ចំនួន ភ្ញៀវទេសចរ ចិន ដែល ចេញ ទៅ ទស្សនា ក្រៅប្រទេស មាន ច្រើន ជាង គេ នៅលើ ពិភពលោក ស្មើ នឹង ចំនួន សរុប ១០០ លាន នាក់ ហើយ បាន ចំណាយ ទឹកប្រាក់ ប្រមាណ ជាង ១២៨ ពាន់ លាន ដុល្លារ ។
រហូត មក ដល់ ពេល នេះ ភាគី ចិន បាន ណែនាំ និង ទទួល ស្គាល់ ទីភ្នាក់ងារ ទេសចរណ៍ ចិន ចំនួន ៦៦ ដែល មាន សិទ្ធិ នាំ ភ្ញៀវទេសចរ ចិន មក កម្ពុជា ហើយ ភ្នាក់ងារ ទេសចរណ៍ កម្ពុជា ចំនួន ៤១ ដែល ត្រូវ បាន ទទួល ស្គាល់ ដោយ ក្រសួង ទេសចរណ៍ ហើយ អាច នាំ ភ្ញៀវទេសចរ ចិន មក ទស្សនា កម្ពុជា ។
លោក ហូ វណ្ណឌី សហប្រធាន ក្រុម ការងារ ទេសចរណ៍ វិស័យ ឯកជន រំពឹង ថា ការ ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា និង ក្រុមហ៊ុន CITS នឹង រួមចំណែក ទាក់ទាញ ភ្ញៀវទេសចរ ចិន មក កម្ពុជា ឲ្យ ច្រើន ថែម ទៀត ។
« យើង ដឹង ច្បាស់ ថា ភ្ញៀវទេសចរ ជនជាតិ ចិន ជា ឱកាស ដ៏ធំ មួយ សម្រាប់ ពួកយើង ។
ឥទ្ធិពល នៃ ចំនួន ភ្ញៀវទេសចរ ចិន មាន សក្ដានុពល ខ្លាំង បំផុត សម្រាប់ វិស័យ ទេសចរណ៍ នៅក្នុង ប្រទេស កម្ពុជា »។
ទោះបី យ៉ាង នេះ ក្តី លោក បាន រំឭក ថា ភ្នាក់ងារ ដែល ទទួល បាន ប្រយោជន៍ ផ្ទាល់ ពី កំណើន វិស័យ ទេសចរណ៍ ដូចជា សណ្ឋាគារ ភោជនីយដ្ឋាន ក្រុមហ៊ុន ភ្នាក់ងារ ទេសចរណ៍ និង ក្រុមហ៊ុន ផ្តល់ សេវា ដឹកជញ្ជូន ផ្សេងៗ ត្រូវ ពង្រឹង ក្រមសីលធម៌ និង ដំណើរការ ប្រកប ដោយ វិជ្ជាជីវៈ ដើម្បី និរន្តរភាព នៃ កំណើន ភ្ញៀវទេសចរ មក កម្ពុជា៕
ក្រុមហ៊ុន អភិវឌ្ឍន៍ ក្នុង ស្រុក ជាច្រើន កំពុង ធ្វើឲ្យ គម្រោង របស់ ខ្លួន រស់ ឡើង វិញ ខណៈ វិធានការ ដូចជា ការ កម្រិត កម្ចី ទិញ ផ្ទះ និង តម្លៃ ជួញដូរ កើនឡើង ពីរ ដង ជួយ ឲ្យ ទីផ្សារ នេះ មាន ស្ថិរភាព ។
យើង នឹង អាច លក់ គម្រោង នេះ បាន ដោយ ងាយស្រួល»៕
«ប្រតិកម្ម ទីផ្សារ គឺ ឆាប់ រហ័ស បែប នេះ ហើយ។
ខ្ញុំ មិន ភ្ញាក់ ផ្អើល ទេ»។
«ខ្ញុំ យល់ ថា ទំនុក ចិត្ត វិនិយោគិន នឹង វិល ត្រឡប់ មក រក ភាព ប្រក្រតី វិញ យ៉ាង ឆាប់ រហ័ស ដោយ សារ ក្រុមហ៊ុន អាកាស ចរណ៍ មួយ នេះ មាន គំរូ អាជីវកម្ម រឹង មាំ»។
ការ ស្វែង រក បាន បន្ត ធ្វើ ឡើង តាម ផ្លូវ ទឹក និង ផ្លូវ អាកាស កាល ពី ម្សិលមិញ៕
ប្រេងឡើងថ្លៃ ខណៈជម្លោះលីប៊ីប៉ះពាល់ប្រេង
នេះ បើ យោង តាម មន្ត្រី រដ្ឋាភិបាល មួយ រូប។
មាស បាន ដាំ ក្បាល ទៅ រក ការ ធ្លាក់ ថ្លៃ ប្រចាំ ត្រីមាស ជា លើក ទីពីរ ដោយ សារ ការ រំពឹង ថា ការ ដំឡើង អត្រា ការ ប្រាក់ ខ្ពស់ ពីសំណាក់ ធនាគារ កណ្តាល អាមេរិក នឹង ធ្វើ ឲ្យ ប្រាក់ ដុល្លារ ឡើង ថ្លៃ។
«កំណើន ថ្លៃ ប្រាក់ ដុល្លារ នៅ ពេល នេះ កំពុង បង្កើន សម្ពាធ ធ្វើ ឲ្យ តម្លៃ មាស ធ្លាក់ ចុះ។
ធនាគារ កណ្តាល អាមេរិក នឹង ដំឡើង អត្រា ការ ប្រាក់ ក្នុង ពេល ឆាប់ៗ នេះ ហើយ ស្ថានភាព បែប នេះ មិន មែន ជា បច្ច័យ ល្អ ចំពោះ មាស ទេ»។
«ខ្ញុំ ពិត ជា មាន ចំណាប់ អារម្មណ៍ ដោយ សារ ទំហំ កាលានុវត្តភាព នៅ ខាង មុខ ក្រុមហ៊ុន ទាំង នោះ។
ប្រេងដូង កៅស៊ូឡើងថ្លៃ ខណៈមានទឹកជំនន់
ប្រទេស ម៉ាឡេស៊ី បាន ជម្លៀស ប្រជាជន ជាង ២០ ម៉ឺន នាក់ និង បង្កើន កិច្ច ខិត ខំ ប្រឹង ប្រែង ផ្តល់ ជំនួយ សង្គ្រោះ ខណៈ គ្រោះ ទឹក ជំនន់ ដ៏ អាក្រក់ បំផុត ក្នុង រយៈ ពេល ប៉ុន្មាន ទសវត្សរ៍ ចុង ក្រោយ នេះ បាន ធ្វើ ឲ្យ មនុស្ស ស្លាប់ បាត់ បង់ ជីវិត យ៉ាង ហោច ណាស់ ១០ នាក់។
នេះ បើ យោង តាម នាយកដ្ឋាន បង្ការ និង កាត់ បន្ថយ គ្រោះ មហន្តរាយ ធម្មជាតិ នៅ លើ គេហទំព័រ របស់ ខ្លួន។
នាយកដ្ឋាន ព្យាករ របស់ រដ្ឋ មួយ នេះ បាន ឲ្យ ដឹង ទៀត ថា ភ្លៀង កាន់ តែ ច្រើន ត្រូវ បាន ព្យាករ ថា នឹង ធ្លាក់ នៅ តំបន់ ដាំ ដំណាំ ប្រេង ដូង ក្នុង ប្រទេស ម៉ាឡេស៊ី រហូត ដល់ ថ្ងៃ ទី៣១ ខែ ធ្នូ។
«ក្តី បារម្ភ ពី គ្រោះ ទឹក ជំនន់ អាច ជួយ ធ្វើ ឲ្យ តម្លៃ ទំនិញ បន្ត កើន ឡើង ខ្លាំង ជាង កត្តា ផ្សេងៗ ទៀត ដូចជា តម្លៃ ប្រេង ឆៅ ទាប និង ការ ធ្លាក់ ចុះ តម្រូវ ការ នៅ ប្រទេស ឥណ្ឌា ដោយ សារ ពន្ធ នាំ ចូល ខ្ពស់ ជាដើម។
ចំនួន នេះ រួម បញ្ចូល ទឹក ប្រាក់ ប្រហែល ១ លាន ដុល្លារ នៅ ថ្ងៃ បុណ្យ គ្រិស្ត ស្មាស់។
ការ លក់ នឹង ត្រូវ បាន ជួយ បន្ថែម ដោយ ក្រុមហ៊ុន Apple ដែល បាន ដាក់ ខ្សែ ភាពយន្ត នេះ លើ អ៊ីនធឺណិត សម្រាប់ អតិថិជន អាមេរិក និង កាណាដា នៅ ក្រុង ញ៉ូវយក ជួល ក្នុង តម្លៃ ៥,៩៩ ដុល្លារ អាមេរិក និង ទិញ ក្នុង តម្លៃ ១៤,៩៩ ដុល្លារ អាមេរិក៕
ក្រុមហ៊ុនថាមពលធំពីររបស់ចិនបានច្របាច់បញ្ចូលគ្នា
«នេះ គឺ ស្រប ជាមួយ នឹង ផែនការ ថ្នាក់ ជាតិ ក្នុង ការ ច្របាច់ បញ្ចូល ធ្យូង ថ្ម ថាមពល និង ធនធាន កម្ដៅ ដើម្បី បង្កើន ប្រសិទ្ធភាព ថាមពល និង កាត់ បន្ថយ ការ បំពុល បរិយាកាស»។
ចិន ជា ប្រទេស ប្រើ ប្រាស់ ថាមពល ធំ ជាង គេ របស់ ពិភពលោក បាន ឲ្យ ដឹង ថា ខ្លួន នឹង ប្រយុទ្ធ ប្រឆាំង នឹង ការ បំពុល បរិយាកាស ដោយ សារ តែ កម្រិត ផ្សែង ខ្ពស់ បំផុត នៅ ក្នុង ទីក្រុង ជាច្រើន ដែល រួមមាន ទីក្រុង ប៉េកាំង និង ទីក្រុង ស៊ាងហៃ ដែល ភាគច្រើន ចេញពី រោងចក្រ ថាមពល ដើរ ដោយ ធ្យូង ថ្ម។
ស៊ីនហួ បាន ឲ្យ ដឹង ថា ក្រុមហ៊ុន បាន ច្របាច់ បញ្ចូល គ្នា នេះ មាន ទ្រព្យ សកម្ម តម្លៃ ២០០ ពាន់ លាន យន់ ដែល ខ្លួន មាន បំណង បង្កើន ដល់ ៣០០ ពាន់ លាន យន់ នៅ ចុង ឆ្នាំ ២០២០។
កំណើន នេះ ឆ្លុះ បញ្ចាំង ពី ការ វិល ត្រឡប់ មក រក ភាព ប្រក្រតី វិញ នៃ កំណើន ចរាចរណ៍ ផ្លូវ អាកាស នៅ ទូ ទាំង ប្រទេស ដោយ សារ ស្ថិរភាព នយោ បាយ ក្រោយ រដ្ឋ ប្រហារ ដែល បាន និង កំពុង ស្តារ វិស័យ ទេសចរណ៍ ក្នុង ស្រុក ដែល ជា ចំណែក ដ៏ ល្អ មួយ នៃ ចរាចរណ៍ ផ្លូវ អាកាស ទាំង មូល របស់ ប្រទេស ថៃ។
អាកាស យានដ្ឋាន ចំនួន ៤ ក្នុង ចំណោម ៦ ដែល ដំណើរ ការ ដោយ ក្រុមហ៊ុន AoT នឹង សម្រេច បាន កំណើន ពីរ ខ្ទង់ នៅ រដូវ បុណ្យ ណូអែល នេះ ខណៈ អាកាស យានដ្ឋាន សុវណ្ណភូមិ និង អាកាស យានដ្ឋាន ភូកេត ប្រឈម នឹង ការ ធ្លាក់ ចុះ។
ការ ធ្លាក់ ចុះ នៅ អាកាស យានដ្ឋាន សុវណ្ណភូមិ នេះ គឺ មួយ ផ្នែក ដោយ សារ ការ រឹត បន្តឹង សមត្ថភាព របស់ អាកាស យានដ្ឋាន និង កំណើន ចំនួន ក្រុមហ៊ុន អាកាស ចរណ៍ ផ្តល់ សេវា ហោះហើរ ក្នុង តម្លៃ ទាប ដែល ផ្លាស់ ទៅ អាកាស យានដ្ឋាន ដនមឿង ដែល ជា អាកាស យានដ្ឋាន មួយ ទៀត នៅ ទីក្រុង បាងកក ដែល បាន ក្លាយ ជា មជ្ឈមណ្ឌល មួយ ក្នុង ចំណោម មជ្ឈមណ្ឌល របស់ ក្រុម ហ៊ុន អាកាស ចរណ៍ ផ្តល់ សេវា ហោះ ហើរ ក្នុង តម្លៃ ទាប ធំៗ នៅ តំបន់ អាស៊ី អាគ្នេយ៍ នេះ។
ការ រឹត បន្តឹង សមត្ថភាព នេះ កំពុង ធ្វើ ឲ្យ ចរាចរណ៍ តាម ផ្លូវ អាកាស ធ្លាក់ ចុះ នៅ អាកាស យានដ្ឋាន ភូកេត ដែល តម្រូវ ការ កំពុង កើន ឡើង ខ្ពស់ ជាង សមត្ថភាព របស់ អាកាស យានដ្ឋាន នេះ អស់ រយៈ ពេល ជា ច្រើន ឆ្នាំ ។
តំបន់អង្គរនឹងបង្កើនការទាក់ទាញទេសចរបន្ថែម
ភ្នាក់ងារ សហប្រតិបត្តិ ការ អន្តរជាតិ កូរ៉េ (KOICA) បាន សន្យា ផ្ដល់ ទឹក ប្រាក់ ៤ លាន ដុល្លារ ដើម្បី ជួសជុល ប្រាសាទ ព្រះពិធូរ ឡើង វិញ ដែលជា ប្រាសាទ មួយ ក្នុង បណ្តា ប្រាសាទ ទាំង ៥ ស្ថិត ក្នុង តំបន់ បេតិកភណ្ឌ នៃ ប្រាសាទ អង្គរវត្ត។
នេះ បើ យោង តាម លោក ប៊ុន ណារិទ្ធ។
«ប្រាសាទ ព្រះពិធូរ ត្រូវ បាន ទុក ចោល នៅ ក្នុង សភាព បែកបាក់ អស់ រយៈពេល ជាច្រើន ឆ្នាំ មក ហើយ។
រហូត មក ដល់ ពេល នេះ រដ្ឋាភិបាល បាន អំពាវនាវ រក ដៃគូ អភិវឌ្ឍន៍ ដើម្បី ជួយ ផ្ដល់ មូលនិធិ ក្នុងការ ជួសជុល ប្រាសាទ នេះ ឡើង វិញ ហើយ នៅ ពេល នេះ រដ្ឋាភិបាល កូរ៉េ តាម រយៈ KOICA បាន យល់ព្រម ផ្ដល់ មូលនិធិ ដល់ គម្រោង នេះ»។
ប្រទេស កូរ៉េ ខាង ត្បូង និង ប្រទេស កម្ពុជា បាន ពិភាក្សា ក្នុងការ ជួសជុល ប្រាសាទ បុរាណ នេះ ឡើង វិញ ចាប់ តាំង ពី ឆ្នាំ ២០១១។
«KOICA នឹង ចាប់ ផ្ដើម សិក្សា ពី ស្ថាន ការ ទូទៅ របស់ ប្រាសាទ នេះ ដើម្បី ស្វែងរក លទ្ធភាព និង សមត្ថភាព ក្នុង ការចំណាយ មូលនិធិ នេះ ឲ្យ មាន ប្រសិទ្ធភាព នៅ ក្នុង ការ អភិរក្ស ប្រាសាទ ស្រប គ្នា នឹង ការ បង្កើន កំណើន សេដ្ឋកិច្ច នៅ ក្នុង តំបន់»។
«ខ្ញុំ សង្ឃឹម ថា ការ ជួសជុល នេះ នឹងធ្វើ ឲ្យ ប្រាសាទ ពិធូរ ទាក់ទាញ ភ្ញៀវ ទេសចរ ច្រើន ទៀត ដូចជា ប្រាសាទ ដែលជា បេតិកភណ្ឌ ផ្សេង ទៀត ដូចជា ប្រាសាទ អង្គរវត្ត និង បាយ័ន ផង ដែរ»។
លោក អាង គឹម អៀង ប្រធាន សមាគម ភ្នាក់ងារ ទេសចរណ៍ កម្ពុជា បាន ថ្លែង ថា ប្រាសាទ នេះ គឺជា ទីកន្លែង ទេសចរណ៍ ដ៏ មាន សក្ដានុពល ដោយ សារ តែ ប្រាសាទ នេះ ហ៊ុមព័ទ្ធ ដោយ ព្រៃឈើ ប៉ុន្តែ ប្រាសាទ ត្រូវបាន គេ ទុក ចោល នៅក្នុង រូបរាង បែក បាក់ អស់ រយៈ ពេល រាប់ រយ ឆ្នាំ កន្លង មក ហើយ។
លោក បន្តថា បន្ទាប់ ពី ការ ជួសជុល ប្រាសាទ ព្រះពិធូរ ដែល មាន ទីតាំង ស្ថិតនៅ ផ្នែក ខាង ជើង ប្រាសាទ បាយ័ន នឹង ក្លាយជា ប្រាសាទ មួយ ទៀត ដើម្បី ស្វាគមន៍ ដល់ ភ្ញៀវ ទេសចរ។
