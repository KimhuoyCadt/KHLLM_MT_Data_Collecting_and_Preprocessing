ក្រសួងកសិកម្មព្រមានចាត់វិធានការលើក្រុមឈ្មួញក្រឡុកទីផ្សារ
យោង តាម សេចក្តី ប្រកាស ព័ត៌មាន របស់ ក្រសួង កសិកម្ម ក្រុម ឈ្មួញ ដែល ប្រមូល ផ្តុំ គ្នា បាន សហការ គ្នា បន្ទាប តម្លៃ កសិផល ហើយ កត្តា នេះ បាន ធ្វើ ឲ្យ ប្រជាជន បាត់ បង់ ឱកាស ក្នុង ការ លក់ កសិផល នានា របស់ ខ្លួន ទៅ តាម តម្លៃ ទីផ្សារ ពិតប្រាកដ ជា ពិសេស ដំណាំ ស្រូវ ។
« ចំពោះ ករណី នេះ ក្រសួង កសិកម្ម រុក្ខាប្រមាញ់ និង នេសាទ សូម ធ្វើ ការ ណែនាំ ដល់ គ្រប់ មន្ទីរ កសិកម្ម ទាំង អស់ ត្រូវ សហការ ជាមួយ គណៈ បញ្ជា ការ ឯក ភាព រដ្ឋបាល រាជធានី-ខេត្ត ធ្វើ ការ ចុះ ពិនិត្យ តាមដាន ស៊ើប អង្កេត ដោយ មនសិការ ទទួល ខុស ត្រូវ ខ្ពស់ បំផុត និង ចាត់ វិធានការ ឲ្យ បាន ម៉ឺងម៉ាត់ ស្រប តាម នីតិវិធី ជា ធរមាន»។
សេចក្តី ជូន ដំណឹង ដែល ចេញ ផ្សាយ កាល ពី ម្សិលមិញ មិន បាន បញ្ជាក់ ចំៗ ពី ក្រុមហ៊ុន ឈ្មួញ កណ្តាល ឬ ក្រុម ឈ្មួញ ណា មួយ ដែល សង្ស័យ ថា បាន កំពុង អនុវត្ត គម្រោង ឃុបឃិត គ្នា ឬ ដែល ក្រសួង ហៅថា ជា ឈ្មួញ ខិលខូច នោះ ទេ ។
ព័ត៌មាន ក៏ មិន បាន ពន្យល់ ពី របៀប ឬ ទម្រង់ ដែល ថា ឈ្មួញ បាន សហការ គ្នា ដើម្បី បន្ទាប តម្លៃ ឬ លម្អិត ពី ឥទ្ធិពល លើ ការ ធ្លាក់ ចុះ តម្លៃ កសិផល ជាក់ ស្តែង នោះ ដែរ។
កត្តា នេះ បាន ធ្វើ ឲ្យ ក្រុម ឈ្មួញ ទាំង នោះ អាច បន្ទាប ឬ ដំឡើង តម្លៃ បាន យ៉ាង ងាយ ស្រួល។
ខ្សែ ចង្វាក់ ផ្គត់ផ្គង់ ច្រើន ដំណាក់ កាល ទម្រាំ បញ្ជូន ពី កសិផល ដល់ អ្នក កែច្នៃ នាំ ចេញ គឺជា កត្តា សំខាន់ មួយ ដែល ធ្វើ ឲ្យ ក្រុម ឈ្មួញ កណ្តាល អាច មាន ឱកាស ច្រើន ពី ការ ទាញ យក ប្រយោជន៍ ពី ប្រជាកសិករ។
នេះ បើ យោង តាម តំណាង ក្រុមហ៊ុន នាំ ចេញ និង អ្នក ជំនាញ សេដ្ឋកិច្ច ។
លោក ស្រី ចន្ធី អ្នក ជំនាញ សេដ្ឋកិច្ច ឯក រាជ្យ បាន ឲ្យ ដឹង ថា វិស័យ កសិកម្ម កម្ពុជា នៅ មាន ចន្លោះ ខ្វះ ខាត ជាច្រើន ទៀត ដែល ត្រូវ កែ លម្អ ជា ប្រព័ន្ធ ដើម្បី ធ្វើ ឲ្យ ផលិតកម្ម របស់ កសិករ និង ការ ពឹង អាស្រ័យ លើ របរ កសិកម្ម អាច ល្អ ឡើង វិញ។
លោក បាន បន្ត ថា ជា ទូទៅ ផលិតកម្ម របស់ កសិករ តែង តែ ខាត ដោយ សារ ចំណាយ លើ កត្តា ផលិតកម្ម ខ្ពស់ និង តម្លៃ នៅ លើ ទីផ្សារ ទាប។
លោក សុង សារ៉ន អគ្គ នាយក ក្រុមហ៊ុន នាំ ចេញ អង្ករ អេមរូរ៉ាយស៍ បាន ឲ្យ ដឹង ថា ការ ពឹង លើ ដំណាក់ កាល ផ្គត់ផ្គង់ ច្រើន ទម្រាំ អាច ឲ្យ ផលិតផល មក ដល់ ទីតាំង កែច្នៃ នាំ ចេញ គឺជា បញ្ហា ប្រឈម ដែល ធ្វើ ឲ្យ កសិករ ខាត ប្រយោជន៍ ។
ដូច្នេះ ការ ផ្សារ ភ្ជាប់ ដោយ ផ្ទាល់ ពី ការ បញ្ជូន ផលិតផល ពី កសិករ មក ដល់ អ្នក នាំ ចេញ គឺជា ដំណោះស្រាយ ល្អ មួយ ហើយ ការណ៍ នេះ អាច ធ្វើ ទៅ បាន លុះ ត្រា កសិករ ចង ក្រង គ្នា ជា ក្រុម ដើម្បី ប្រមូល ផ្តុំ ទិន្នផល កសិផល។
លោក បាន បន្ត ថា ដំណោះស្រាយ ជា ចាំបាច់ គឺ កសិករ គួរ ត្រូវ ពង្រឹង អំណាច ខ្លួន ឯង តាម រយៈ ការ ចង ក្រង គ្នា ជា ក្រុម ការ ទទួល បាន ព័ត៌មាន ទីផ្សារ កសិផល ដើម្បី ចរចា តម្លៃ ជាមួយ ក្រុម ឈ្មួញ។
ក្រុមហ៊ុន ធំៗ មួយ ចំនួន ថ្មីៗ នេះ បាន ប្រកាស ពី ផែន ការ បង្កើន ប្រាក់ ឈ្នួល ដល់ កម្មករ ដែល មាន ប្រាក់ ខែ តិច បំផុត របស់ ពួក គេ។
