ក្រុម ហ៊ុន បាន ប្រកាស បើក ដំណើរការ ដោយ សហការ ជា ដៃគូ ជាមួយ ហាង លក់ ម៉ូតូ ជាច្រើន នៅ ភ្នំពេញ ដែល អតិថិជន អាច នឹង ទិញ ម៉ូតូ ជាច្រើន ប្រភេទ ម៉ូតូ ដូចជា ម៉ាក ហុងដា ស៊ុយ ហ្សា គិ យ៉ាម៉ាហា និង ម៉ាក ជាច្រើន ផ្សេង ទៀត។
ការ ទិញ តាម រយៈ ភតិសន្យា ហិរញ្ញវត្ថុ គឺ អតិថិជន ទិញ ម៉ូតូ ដោយ មិន ចាំ បាច់ មាន លុយ គ្រប់ ទាំង ស្រុង គឺ ទុក ឲ្យ ក្រុម ហ៊ុន ជា អ្នក បង់ ជំនួស តែ អតិថិជន ត្រូវ ចុះ កិច្ចសន្យា ជាមួយ ក្រុមហ៊ុន ដោយ បង់ រំលស់ ជា ប្រចាំខែ ព្រម ជាមួយ ការ ប្រាក់ ហើយ អតិថិជន នឹង ក្លាយ ជា កម្មសិទ្ធិ ស្រប ច្បាប់ នៃ ទោចក្រយាន នោះ លុះណា តែ នៅ ពេល កាលបរិច្ឆេទ ដែល ត្រូវ បង់ បាន បិទ បញ្ចប់។
អ្នក ស្រី ប៉ាត់ថាម៉ា ផនប្រៈផា ប្រធាន ក្រុមហ៊ុន សួស្តី ហ្វាយ នែន បាន ឲ្យ ដឹង ថា ក្រុម ហ៊ុន នេះ បាន បើក ដំណើរការ ដើម្បី សាក ល្បង ទីផ្សារ នៅ កម្ពុជា ដោយ មាន ដើម ទុន បង្វិល បឋម ១០ ម៉ឺន ដុល្លារ តែ នឹង បង្កើន ដើម ទុន ច្រើន ជាង នេះ ទៀត នៅ ពេល ដំណើរ ការ ល្អ និង ទំហំ ឥណទាន កាន់ តែ ធំ ឡើង។
បច្ចុប្បន្ន ក្រុមហ៊ុន នេះ មាន សាខា តែ មួយ ប៉ុណ្ណោះ នៅ ភ្នំពេញ ដោយ មាន បុគ្គលិក ១០ នាក់ (ថៃ ២ នាក់)។
«យើង គឺជា ក្រុមហ៊ុន ភតិសន្យា ហិរញ្ញវត្ថុ ផ្នែក ម៉ូតូ ដែល ឈាន មុខ គេ មួយ នៅ ថៃ ដូច្នេះ ហើយ យើង ជឿជាក់ ថា យើង មាន លទ្ធភាព គ្រ ប់គ្រាន់ និង ប្រព័ន្ធ គ្រប់ គ្រាន់ ដើម្បី ប្រជែង ក្នុង ទីផ្សារ កម្ពុជា»។
ប្រព័ន្ធ ធនាគា នៅ កម្ពុជា កំពុង មាន ការ វិវត្ត ជា លំដាប់ ទាំង ទំហំ ប្រតិបត្តិការ ផ្នែក ហិរញ្ញវត្ថុ ការ ពង្រីក ចំនួន អតិថិជន បច្ចេកទេស ក្នុង វិស័យ ហិរញ្ញវត្ថុ កាន់ តែ ទំនើប ខណៈ ផលិត ផល ក្នុង វិស័យ ហិរញ្ញវត្ថុ ក៏ កាន់ តែ មាន ភាព សម្បូរ បែប។
លោក គិម វ៉ាដា អគ្គ នាយក ត្រួត ពិនិត្យ ធនាគារ ជាតិ នៃ កម្ពុជា បាន លើក ឡើង ក្នុង ពិធី បើក សម្ពោធ ក្រុមហ៊ុន កាលពី ម្សិល មិញ ថា បច្ចុប្បន្ន អាជីវកម្ម ភតិសន្យា ហិរញ្ញវត្ថុ កំពុង ក្លាយ ជា ផលិតផល ហិរញ្ញវត្ថុ ថ្មី និង មាន ការ គាំទ្រ ក្នុង ទីផ្សារ កម្ពុជា ដែល បច្ចុប្បន្ន មាន ក្រុមហ៊ុន ៧ បាន ទទួល អាជ្ញាប័ណ្ណ ពី ធនាគារ ជាតិ នៃ កម្ពុជា (រាប់ ទាំង ក្រុមហ៊ុន សួស្តី ហ្វាយ នែន)។
លោក បន្ត ថា អាជីវកម្ម ភតិសន្យា ហិរញ្ញវត្ថុ នេះ បាន រួម ចំណែក ដល់ ម្ចាស់ សហគ្រាស ធុន តូច និង មធ្យម និង ប្រជាជន ជាច្រើន អាច ប្រើ ប្រាស់ ផលិត ផល ដែល ពួកគេ ត្រូវ ការ ដូចជា គ្រឿង ចក្រ និង ឧបករណ៍ ផ្សេងៗ ដើម្បី ពង្រឹង ផលិតកម្ម បើ ទោះ បី ជា ពួកគេ មិន ទាន់ មាន ប្រាក់ ទាំង ស្រុង ដើម្បី ទិញ ឧបករណ៍ នោះ ក៏ ដោយ៕
«ការ វិវត្ត គោលជំហរ គោល នយោបាយ រូបិយវត្ថុ គួរ តែ បន្ត ធ្វើជា ទិន្នន័យ បង្អែក ខណៈ មាន ការ ទទួល ស្គាល់ ពី ភាព មិន ច្បាស់ លាស់ ទាក់ទង នឹង ភាព ខ្លាំង និង ការ ខ្វះ ខាត ស្រប ជាមួយ នឹង យន្តការ បញ្ជូន រូបិយវត្ថុ»។
លោក បាន បង្កើត វិធានការ បន្ទាប់ ពឹង លើ ការ ប្រមូល ទិន្នន័យ ដែល ទុក ឲ្យ សេដ្ឋវិទូ បែង ចែក ពេល វេលា និង ទំហំ នៃ ការ បន្ធូរ បន្ថយ បន្ថែម ទៀត។
ជាមួយ នឹង ចាប់ ផ្តើម អនុវត្ត គោល នយោបាយ ផ្គត់ ផ្គង់ ថវិកា បន្ថែម របស់ ធនាគារ កណ្តាល អឺរ៉ុប ហើយ ធនាគារ កណ្តាល អាមេរិក អាច នឹង ដំឡើង អត្រា ការ ប្រាក់ នៅ ខែ មិថុនា នោះ ក្រុម អ្នក វិភាគ កំពុង ព្យាករ ថា ប្រាក់ ដុល្លារ និង ប្រាក់ អឺរ៉ូ អាច នឹង មាន តម្លៃ ស្មើ គ្នា នៅ ឆ្នាំ ក្រោយ នេះ ដែល រូបិយប័ណ្ណ ទាំង ពីរ នេះ មាន តម្លៃ ស្មើ គ្នា លើក ចុង ក្រោយ នៅ ឆ្នាំ ២០០២។
«កម្មវិធី ទិញ ទ្រព្យ សកម្ម ដែល កំពុង ចាប់ ផ្តើម នៅ ពេល នេះ នឹង ជំរុញ ឲ្យ ប្រាក់ អឺរ៉ូ ធ្លាក់ ថ្លៃ»។
«ប្រាក់ ដុល្លារ បាន ឡើង ថ្លៃ ខ្ពស់ ជាង រូបិយប័ណ្ណ ផ្សេង ទៀត ទាំង អស់»។
ប្រាក់ ដុល្លារ បាន ឡើង ថ្លៃ ដល់ ១ ១៣១,៥៥ វ៉ុន ធៀប នឹង តម្លៃ ១ ១២៦,៤០ វ៉ុន កាល ពី ថ្ងៃ ពុធ បន្ទាប់ ពី ធនាគារ កណ្តាល កូរ៉េ ខាង ត្បូង បាន ប្រកាស ពី ការ ទម្លាក់ អត្រា ការ ប្រាក់ ដ៏ គួរ ឲ្យ ភ្ញាក់ ផ្អើល ដល់ កម្រិត ទាប បំផុត ១,៧៥ ភាគ រយ ក្នុង គោល បំណង ទប់ ស្កាត់ បរិត្ត ផរណា និង ជំរុញ សេដ្ឋកិច្ច។
កូរ៉េ ខាង ត្បូង គឺជា ប្រទេស ចុង ក្រោយ គេ ដែល បាន ទម្លាក់ អត្រា ការ ប្រាក់ ក្នុង គ្រា ដែល តម្លៃ ទំនិញ និង សេដ្ឋកិច្ច កំពុង ធ្លាក់ ចុះ៕
បើកលម្ហអាស៊ានដើម្បីទីផ្សារអាកាសចរណ៍តែមួយ
ប្រទេស ភាគ ច្រើន នៅ ក្នុង តំបន់ នេះ មាន ការ រឹត ត្បិត លើ ភាព ជា ម្ចាស់ កម្មសិទ្ធិ របស់ ជន បរទេស ក្នុង កម្រិត ខុសៗ គ្នា។
ឧទាហរណ៍ ក្រុម ហ៊ុន អាកាស ចរណ៍ មួយ នៅ ប្រទេស ថៃ តម្រូវ ឲ្យ ជនជាតិ ថៃ មាន ភាគ ហ៊ុន យ៉ាង ហោច ណាស់ ៥១ ភាគរយ ដោយ ជន បរទេស មាន សិទ្ធិ កាន់ កាប់ ភាគ ហ៊ុន អតិបរមា ត្រឹម តែ ៤៩ ភាគរយ ប៉ុណ្ណោះ។
លោក មាន ប្រសាសន៍ ថា គំនិត បង្កើត នូវ អ្វី ដែល លោក ហៅ ថា អាកាស ចរណ៍ សហគមន៍ អាស៊ាន នេះ នឹង សម្រប សម្រួល ការ ផ្តល់ មូលនិធិ សម្រាប់ ក្រុមហ៊ុន អាកាស ចរណ៍ ដែល មាន បញ្ហា ដើម ទុន ខ្ពស់ និង ជា មធ្យោបាយ មួយ ដើម្បី ជំរុញ សមាហរណ កម្ម សេដ្ឋកិច្ច កាន់ តែ ខ្លាំង ផង ដែរ។
លោក បាន បន្ត ថា មាន ទំហំ នៃ ភាព ជា កម្មសិទ្ធិ ដ៏ ប្រសើរ មួយ សម្រាប់ ពលរដ្ឋ ក្នុង តំបន់ អាស៊ាន តែ បើ និយាយ ពី បច្ចេកទេស វិញ អាកាស ចរណ៍ សហគមន៍ អាច នឹង ត្រូវ កាន់ កាប់ ដោយ ពលរដ្ឋ នៅ តំបន់ អាស៊ាន នេះ ១០០ ភាគរយ។
លោក បាន ទទួល ស្គាល់ ថា បញ្ហា ប្រឈម ដ៏ ធំ មួយ ចំពោះ អាកាស ចរណ៍ សហគមន៍ អាស៊ាន នេះ គឺជា ការ ផ្លាស់ ប្តូរ ផ្តត់ គំនិត របស់ ប្រទេស ជា សមាជិក៕
សន្ទុះសេដ្ឋកិច្ចរបស់ម៉ាឡេស៊ីនឹងថមថយ
របាយ ការណ៍ ប្រចាំ ឆ្នាំ របស់ ធនាគារ កណ្តាល ម៉ាឡេស៊ី បាន បង្ហាញ ថា៖
«ទោះ ជា កំណើន សេដ្ឋកិច្ច ពិភពលោក មាន ភាព ប្រសើរ ក្តី ក៏ ហានិភ័យ នៃ ការ ធ្លាក់ ចុះ សេដ្ឋកិច្ច ចំពោះ ចក្ខុ វិស័យ កំណើន សេដ្ឋកិច្ច សកល នៅ តែ មាន ដោយ សារ ការ បន្ត ធ្លាក់ ចុះ សេដ្ឋកិច្ច នៅ តាម បណ្តា ប្រទេស ដែល មាន សេដ្ឋកិច្ច ធំៗ មួយ ចំនួន»។
ធនាគារ កណ្តាល មួយ នេះ ព្យាករ ថា សេដ្ឋកិច្ច អាច នឹង សម្រេច បាន កំណើន ក្នុង ចន្លោះ ៤,៥ ទៅ ៥,៥ ភាគរយ នៅ ឆ្នាំ ២០១៥ ដោយ សារ កំណើន តម្រូវ ការ ក្នុង ស្រុក។
ក្នុង នាម ជា ប្រទេស នាំ ចេញ ប្រេង មួយ ម៉ាឡេស៊ី បាន ទទួល រង នូវ ផល ប៉ះពាល់ យ៉ាង ខ្លាំង ពីការ ធ្លាក់ ចុះ តម្លៃ ប្រេង ឆៅ ក្នុង រយៈ ពេល ប៉ុន្មាន ខែ ចុង ក្រោយ នេះ ក៏ ដូចជា ការ ធ្លាក់ ចុះ តម្លៃ ទំនិញ នាំ ចេញ សំខាន់ៗ របស់ ខ្លួន ដូច ជា ប្រេង ដូង និង កៅស៊ូ ជាដើម។
ធនាគារ កណ្តាល ម៉ាឡេស៊ី ក៏ បាន ឲ្យ ដឹង ផង ដែរ ថា ប្រាក់ រីងហ្គីត ដែល ធ្លាក់ ថ្លៃ ១៤,៤ ភាគរយ ធៀប នឹង ប្រាក់ ដុល្លារ ចាប់ តាំង ពី ខែ កញ្ញា មក មាន តម្លៃ ទាប ខ្លាំង តែ ធនាគារ នេះ បាន បដិសេធ ដាក់ ចេញ ការ គ្រប់ គ្រង មូលធន។
ប្រាក់ រីងហ្គីត បាន ធ្លាក់ ថ្លៃ មក នៅ ត្រឹម ៣,៧០ រីងហ្គីត ធៀប នឹង ប្រាក់ ដុល្លារ ដោយ ធ្វើ ឲ្យ រូបិយប័ណ្ណ មួយ នេះ ធ្លាក់ ថ្លៃ ខ្លាំង ជាង គេ បំផុត ក្នុង តំបន់ អាស៊ី គិត ចាប់ តាំង ពី ដើម ឆ្នាំ រហូត មក ដល់ ពេល នេះ។
ការ រំពឹង ថា ធនាគារ កណ្តាល អាមេរិក នឹង ដំឡើង អត្រា ការ ប្រាក់ ជា លើក ដំបូង ក្នុង ឆ្នាំ នេះ គិត ចាប់ តាំង ពី វិបត្តិ ហិរញ្ញវត្ថុ ពិភពលោក មក នោះ បាន ជំរុញ ឲ្យ ប្រាក់ ដុល្លារ ឡើង ថ្លៃ ខ្ពស់ ជាង រូបិយប័ណ្ណ ភាគ ច្រើន។
ទេសាភិបាល រូប នេះ បាន មាន ប្រសាសន៍ បន្ត ថា ការ ធ្លាក់ ថ្លៃ ប្រាក់ រីងហ្គីត មិន មែន ជា រឿង គួរ ឲ្យ ភ្ញាក់ ផ្អើល នោះ ទេ។
វា គឺ ដោយ សារ វិបត្តិ ផ្ទួនៗ របស់ ធនាគារ កណ្តាល អាមេរិក ដែល បាន បញ្ចប់ កម្មវិធី ទិញ មូលបត្រ បំណុល របស់ ខ្លួន កាល ពី ឆ្នាំ មុន ដែល បង្ហាញ ពី ការ ដំឡើង អត្រា ការ ប្រាក់ នៅ អាមេរិក ក្នុង ឆ្នាំ នេះ និង ការ ធ្លាក់ ចុះ តម្លៃ ប្រេង។
ប្រទេស ម៉ាឡេស៊ី គឺជា ប្រទេស នាំ ចូល ប្រេង សុទ្ធ។
បើ ទោះ ជា រូបិយប័ណ្ណ រីងហ្គីត បាន បន្ត ធ្លាក់ ថ្លៃ ក្តី ក៏ លោក ស្រី Zeti បាន មាន ប្រសាសន៍ ថា ប្រទេស ម៉ាឡេស៊ី នឹង មិន ដំឡើង ថ្លៃ រូបិយប័ណ្ណ នេះ ធៀប នឹង ប្រាក់ ដុល្លារ ទេ ដោយ សារ វា អាច បង្ក ឲ្យ មាន ការ ផ្លាស់ ប្តូរ ទីតាំង ផលិតកម្ម និង ផល វិបាក ចំពោះ ប្រទេស ម៉ាឡេស៊ី៕
រដ្ឋាភិបាលចិនគ្រោងកែទម្រង់ក្រុមហ៊ុនឧស្សាហកម្មធំៗ
ប្រភព ដដែល នេះ បាន ដឹង បន្ត ថា គម្រោង នេះ រួម មាន ការ ច្របាច់ បញ្ចូល គ្នា និង កាត់ បន្ថយ តួនាទី របស់ រដ្ឋាភិបាល នៅ ក្នុង សហគ្រាស របស់ រដ្ឋ តាម រយៈ ការ កាត់ បន្ថយ ការ កាន់ កាប់ ភាគហ៊ុន ពី ទីភ្នាក់ងារ ដែល គ្រប់ គ្រង សហគ្រាស ទាំង នោះ។
ប្រភព ដដែល ដែល បាន ស្នើ សុំ មិន បង្ហាញ អត្ត សញ្ញាណ ដោយ សារ កិច្ច ពិភាក្សា នេះ គឺ ជា រឿង ឯកជន បាន បន្ត ឲ្យ ដឹង ថា ផែនការ ដែល នឹង ត្រូវ ចេញ ផ្សាយ នៅ ពេល ឆាប់ៗ ក្នុង ខែ នេះ អំពាវនាវ ឲ្យ មាន ការ ប្រមូល ផ្តុំ ក្រុមហ៊ុន ទាំង នោះ ជា ក្រុម ទៅ តាម ប្រភេទ ឧស្សាហកម្ម ហើយ ប្រគល់ ការ គ្រប់ គ្រង របស់ ខ្លួន ឲ្យ ទៅ ក្រុម ហ៊ុន គ្រប់ គ្រង ទ្រព្យ សម្បត្តិ រដ្ឋ។
«កំណែ ទម្រង់ សហគ្រាស រដ្ឋ គឺ ជា បញ្ហា ដែល អាច ទទួល ជោគជ័យ ឬ បរាជ័យ មួយ ចំពោះ សេដ្ឋកិច្ច ចិន។
គម្រោង នេះ នឹង អនុវត្ត តាម ផែនទី បង្ហាញ ផ្លូវ មួយ ដែល បង្កើត ឡើង ដោយ បក្ស កុម្មុយនីស្ត ចិន នៅ ឆ្នាំ ២០១៣ ដើម្បី ធ្វើ ឲ្យ សហគ្រាស រដ្ឋ មាន កាន់ តែ ប្រសិទ្ធ ភាព ថែម ទៀត ហើយ បំបែក អ្នក ត្រួត ពិនិត្យ ជា មន្ត្រី រដ្ឋាភិបាល របស់ ក្រុមហ៊ុន ទាំង នោះ ចេញ ពី អ្នក គ្រប់ គ្រង ប្រចាំ ថ្ងៃ របស់ ខ្លួន។
ផែនការ នេះ នឹង ត្រូវ ប្រកាស ក្នុង ពេល ឆាប់ៗ នេះ បន្ទាប់ ពី បញ្ចប់ កិច្ច ប្រជុំ ពេញ អង្គ របស់ សភា ប្រជាជន ចិន នៅ ទីក្រុង ប៉េកាំង។
ការ ផ្លាស់ ប្តូរ ស្រដៀង គ្នា នេះ ដែរ អាច នឹង ត្រូវ ពង្រីក ទៅ ដល់ ថ្នាក់ ខេត្ត និង មូលដ្ឋាន។
មូលបត្រ បំណុល ដែល មាន កាល បរិច្ឆេទ យូរ ជាង គេ គឺ មាន តម្លៃ ១,៥ ពាន់ លាន ដុល្លារ ដោយ ផ្តល់ អត្រា ការ ប្រាក់ ៤,៥ ភាគរយ មូលបត្រ បំណុល ដែល មាន អាយុ កាល ៣០ ឆ្នាំ មាន អត្រា ការ ប្រាក់ ១,៩ ភាគរយ ដែល ខ្ពស់ ជាង ប័ណ្ណ រតនាគារ របស់ អាមេរិក ដែល មាន អាយុ កាល ប្រហាក់ ប្រហែល គ្នា។
ក្រុម ហ៊ុន ថាមពល មួយ នេះ បាន ខ្ចី ប្រាក់ ដុល្លារ ក្នុង ពេល មួយ ដែល ក្រុមហ៊ុន បោះ ផ្សាយ មូលបត្រ របស់ ម៉ាឡេស៊ី ផ្សេងៗ ទៀត ដែល ខ្ចី ជា ប្រាក់ ដុល្លារ ដែរ នោះ ទទួល បាន លទ្ធផល អាក្រក់ បំផុត ក្នុង តំបន់ អាស៊ី ក្នុង ឆ្នាំ នេះ។
កូរ៉េខាងត្បូងទម្លាក់អត្រាការប្រាក់ដល់កម្រិតទាបបំផុត
ការ ទម្លាក់ នេះ ឆ្លុះ បញ្ចាំង ពី ក្តី បារម្ភ ជា បន្ត ជុំវិញ បញ្ហា បរិត្តផរណា និង កម្រិត កំណើន សេដ្ឋកិច្ច។
នេះ គឺជា ការ ទម្លាក់ អត្រា ការ ប្រាក់ លើក ដំបូង គិត ចាប់ តាំង ពី ខែ តុលា មក នៅ ពេល ដែល ធនាគារ កណ្តាល កូរ៉េ បាន ទម្លាក់ អត្រា ការ ប្រាក់ មក នៅ ត្រឹម អត្រា ទាប បំផុត ២ ភាគរយ ដែល ជា អត្រា ចុង ក្រោយ ដែល ធ្លាប់ មាន ក្នុង ឆ្នាំ ២០០៩-១០ នៅ ពេល សេដ្ឋកិច្ច ធំ ជាង គេ ទី បួន ក្នុង តំបន់ អាស៊ី នេះ ព្យាយាម ងើប ចេញ ពី វិបត្តិ ហិរញ្ញវត្ថុ សកល។
អត្រាគ្មានការងារធ្វើនៅអូស្ត្រាលីធ្លាក់ឥតរំពឹងទុក
ចំនួន ប្រជាជន មាន ការងារ ធ្វើ បាន កើន ឡើង ១៥ ៦០០ នាក់។
ធនាគារ កណ្តាល អូស្ត្រាលី បាន រក្សា អត្រា ការ ប្រាក់ របស់ ខ្លួន នៅ ដដែល ក្នុង អត្រា ទាប បំផុត គឺ ២,២៥ ភាគរយ កាល ពី សប្តាហ៍ មុន៕
ការប្រើប្រាស់អ៊ីនធឺណិតនៅកម្ពុជាកើនឡើងខ្ពស់
លោក សុខ ពុទ្ធីវុធ ប្រធាន សហព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន និង ទូរគមនាគមន៍ កម្ពុជា និយាយ ថា ការ ចាប់ ផ្តើម ពី ចំណុច ទាប នឹង បង្ហាញ ពី កំណើន យ៉ាង ខ្លាំង ក្នុង ការ ប្រើ ប្រាស់ អ៊ីនធឺណិត ហើយ ការ ធ្លាក់ ចុះ តម្លៃ ប្រើ ប្រាស់ និង ការ បង្កើន សេវា នឹង បន្ត កំណើន នេះ។
ការ ត ភ្ជាប់ បណ្ដាញ ទូរស័ព្ទ ចល័ត ដ៏ លើស លប់ ធៀប នឹង ចំនួន ប្រជាជន កម្ពុជា មាន ១៥៧ ភាគរយ ដែល មាន ចំនួន អ្នក ប្រើ ប្រាស់ ស៊ីម កាត ២៤,២០ លាន ស៊ីម កាត។
ពិត ណាស់ នៅ តែ មាន សក្ដានុពល ក្នុង បង្កើន ចំនួន នៃ ការ តភ្ជាប់ បណ្ដាញ»។
លោក ម៉ូវ ចរិយា ប្រធាន TRC បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិល មិញ ថា ការ ផ្ទេរ ចំណូល ខាង លើ ឲ្យ ស្ថិត ក្រោម ការ ចាត់ ចែង របស់ ក្រសួង គឺ ដើម្បី ចូល រួម ក្នុង កំណែ ទម្រង់ របស់ រដ្ឋាភិបាល ក្នុង ការ បង្កើន ចំណូល រដ្ឋ។
ប៉ុន្តែ លោក ចរិយា មិន អាច បង្ហាញ ពី បរិមាណ ចំណូល ជាក់ ស្តែង ដែល បាន ពី ប្រភព ចំណូល ទាំង បួន នោះ ទេ។
លោក ថ្លែង ដោយ ខ្លី ថា៖
យោង តាម សេចក្តី ជូន ដំណឹង របស់ TRC ដំណើរការ នៃ ការ ដាក់ ពាក្យ សុំ លិខិត អនុញ្ញាត ត្រូវ ដាក់ ពាក្យ សុំ នៅ បញ្ញត្តិ ករ ទូរគមនាគមន៍ ដដែល ដែល មាន ទីតាំង ក្នុង បរិវេណ ក្រសួង ប៉ុន្តែ សម្រាប់ ថ្លៃ ទូទាត់ វិញ គឺ ត្រូវ បង់ នៅ បេឡា ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ឬ បង្វែរ ទៅ គណនី ក្រសួង តាម រយៈ ធនាគារ ជាតិ នៃ កម្ពុជា។
លោក ស្រី សុខ ចិន្តា អគ្គ នាយក ក្រុមហ៊ុន ផ្តល់ សេវាកម្ម អ៊ីនធឺណិត មេគង្គ ណេត បាន លើក ឡើង ថា ការ ផ្លាស់ ប្តូរ នីតិវិធី គ្រប់ គ្រង ចំណូល ពី TRC ទៅ ក្រសួង នេះ មិន មាន ផល ប៉ះពាល់ អ្វី ដល់ ប្រតិបត្តិការ ក្រុមហ៊ុន អ្នក ស្រី ឡើយ ដោយ សារ អត្រា ដែល ត្រូវ បង់ និង ទីតាំង គឺ ស្ថិត នៅ កន្លែង ដដែល។
អ្នក ស្រី បាន បន្ត ទៀត ថា ក្នុង ចំណោម ប្រភព ចំណូល ទាំង បួន ចំណូល ពី ការ បែង ចែក ទំនង ជា បាន រួម ចំណែក ច្រើន ជាង គេ សម្រាប់ ចំណូល រដ្ឋាភិបាល ខណៈ ប្រភព ចំណូល មកពី ប្រភេទ ផ្សេងៗ បន្ទាប់ បន្សំ។
អ្នកស្រី បាន ឲ្យ ដឹង ថា ជា ទូទៅ ក្រុម ហ៊ុន មេគង្គ ណេត បាន បង់ថ្លៃ ទៅ លើ អាជ្ញាប័ណ្ណ ហ្វ្រេកង់ ប្រមាណ ជិត ២០០០ ដុល្លារ និង ទៅ លើ សេវា គេហទំព័រ តិចតួច ប៉ុណ្ណោះ។
យ៉ាង ណា ក៏ ដោយ អ្នក ស្រី មិន អាច បញ្ជាក់ ពី ចំនួន ជាក់ស្តែង ដែល បង់ សម្រាប់ ចំណូល បែងចែក នោះទេ ដោយ គ្រាន់ តែ លើក ឡើង ថា មាន ច្រើន គឺ ស្មើ នឹង ចំនួន ១០ ភាគរយ នៃ ចំណូល ក្នុង ក្រុមហ៊ុន សរុប។
លោក វេជ្ជបណ្ឌិត ឃុន បូរ័ត្ន មិន បាន នាំ យក ក្តី ស្រមៃ ក្នុង ការ ចាប់ យក វិជ្ជាជីវៈ ផ្នែក វេជ្ជសាស្ត្រ ភ្ជាប់ មកជា មួយ តាំង ពី កុមារភាព នោះ ទេ ប៉ុន្តែ ការ ឈាន ជើង ចូល ក្នុង អាជីព នេះ បាន កើត ឡើង នៅ ពេល ដែល លោក សង្កេត ឃើញ ពី ឱកាស ទីផ្សារ ការងារ ខ្ពស់ និង លទ្ធភាព រក ប្រាក់ ចំណូល ខ្ពស់ ប៉ុណ្ណោះ។
ការ ត្រៀម ខ្លួន បាន ចាប់ ផ្តើម ឡើង នៅ ឆ្នាំ ២០០៣ នៅ ពេល ដែល លោក បាន បញ្ចប់ ការ សិក្សា ថ្នាក់ ទី១២ ហើយ បាន បន្ត ការ សិក្សា នៅ សាកល វិទ្យាល័យ វិទ្យាសាស្ត្រ សុខាភិបាល ដែល ជា គ្រឹះស្ថាន បណ្តុះ បណ្តាល ជំនាញ ផ្នែក វេជ្ជសាស្ត្រ ដ៏ ធំ ជាង គេ មួយ នៅ កម្ពុជា។
ក្តី រំពឹង ពី ឱកាស ទីផ្សារ ការងារ ល្អ ក្នុង វិស័យ វេជ្ជសាស្ត្រ បាន កើត ឡើង ដូច ការ គ្រោង ទុក។
បន្ទាប់ ពី បាន បញ្ចប់ ការ សិក្សា នៅ ឆ្នាំ ២០១២ លោក បូរ័ត្ន ដែល បច្ចុប្បន្ន ជា វេជ្ជបណ្ឌិត ផ្នែក ទូទៅ ក៏ បាន ទទួល ការងារ ភ្លាមៗ ព្រម ជាមួយ នឹង ប្រាក់ ចំណូល ដ៏ សមរម្យ។
ក្តី ស្រមៃ និង បញ្ហា ប្រឈម អ្វីៗ បាន ប្រឈម នឹង ការ ផ្លាស់ ប្តូរ។
ទើប តែ នៅ ឆ្នាំ ២០១៤ នេះ ប៉ុណ្ណោះ ដែល លោក វេជ្ជបណ្ឌិត ឃុន បូរ័ត្ន បាន ដឹង ថា អ្នក ជំនាញ ផ្នែក សុខាភិបាល នៅ កម្ពុជា នឹង ត្រូវ ប្រកួត ប្រជែង ជាមួយ អ្នក ជំនាញ ផ្នែក វេជ្ជសាស្ត្រ ពី បណ្តា ប្រទេស ផ្សេង ទៀត ក្នុង តំបន់ ដែល ជា ផ្នែក មួយ នៃ ការ ព្រម ព្រៀង ក្នុង កម្មវិធី នៃ ការ ធ្វើ សមាហរណ កម្ម សេដ្ឋកិច្ច អាស៊ាន (AEC ២០១៥)។
វេជ្ជបណ្ឌិត បាន ថ្លែង ថា៖
កង្វះ ការ យល់ ដឹង ពី AEC បើ ទោះ បី ជា ការ ពិភាក្សា ពី ដំណើរ ការ បង្កើត សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន ត្រូវ បាន ធ្វើ ឡើង ជាច្រើន ឆ្នាំ ហើយ បាន ផ្សព្វ ផ្សាយ តាម បណ្តាញ សារ ព័ត៌មាន ជា ញឹក ញាប់ លោក បូរ័ត្ន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា លោក ទើប ចាប់ ផ្តើម យល់ ដឹង ពី ព័ត៌មាន នេះ ពី សាស្ត្រាចារ្យ និង គណៈ គ្រូពេទ្យ កម្ពុជា កាលពី ឆ្នាំ មុន ប៉ុណ្ណោះ។
ការ យល់ ដឹង យឺត ពី សមាហរណ កម្ម សេដ្ឋកិច្ច អាស៊ាន ក្នុង ចំណោម អ្នក ជំនាញ ផ្នែក សេវា វេជ្ជសាស្ត្រ មាន ន័យ ថា ការ ត្រៀម ខ្លួន សម្រាប់ ការ ប្រកួត ប្រជែង នៅ ពេល ឱកាស ទីផ្សារ ថ្នាក់ តំបន់ ចូល មក ដល់ នៅ មាន ភាព ខ្វះ ចន្លោះ។
រហូត មក ទល់ ពេល នេះ អ្នក ជំនាញ ផ្នែក សេវា វេជ្ជសាស្ត្រ នៅ កម្ពុជា នៅ មាន ការ យល់ ដឹង តិចតួច នៅ ឡើយ ពី ការ បើក ចំហ ទីផ្សារ សម្រាប់ កម្លាំង ពលកម្ម មាន ជំនាញ ស្រប ពេល ដែល សមត្ថភាព និង ក្រម សីលធម៌ ជាក់ស្តែង ក្នុង ការ ប្រតិបត្តិ ការងារ នេះ នៅ មាន កម្រិត នៅ ឡើយ។
នេះ បើ យោង តាម អ្នក បង្កើត គោល នយោបាយ នៅ កម្ពុជា និង បញ្ញត្តិករ ផ្នែក វិជ្ជាជីវៈ វេជ្ជសាស្ត្រ។
ការ ត្រៀម ខ្លួន ក្នុង ការ ប្រកួត ប្រជែង ដោយ បើកចំហ ទល់ នឹង អ្នក ជំនាញ ផ្នែក វេជ្ជសាស្ត្រ ពី បណ្តា ប្រទេស ជា សមាជិក AEC ក្នុង ចំណោម ប្រតិបត្តិ ករ និង ភាគី ពាក់ព័ន្ធ នៅ មាន កម្រិត នៅ ឡើយ។
ជំនាញ ៨ ដែល ជា ក្តី កង្វល់ លំហូរ ដោយ សេរី នៃ កម្លាំង ពលកម្ម មាន ជំនាញ គឺជា ផ្នែក មួយ នៃ ការ បង្កើត AEC ក្នុង គោលដៅ ធ្វើ សេរីភាវូប នីយកម្ម លើ វិស័យ សំខាន់ៗ ដូច ជា សម្រួល ចលនា ទំនិញ សេវាកម្ម មូលធន និង ពលករ មាន ជំនាញ។
លំហូរ ដោយ សេរី នៃ កម្លាំង ពលកម្ម មាន ជំនាញ ត្រូវ បាន ប្រទេស ជា សមាជិក ព្រម ព្រៀង ទៅ លើ មុខ ជំនាញ ប្រាំបី រួមមាន សេវា វិស្វកម្ម សេវា គិលា នុបដ្ឋាក ស្ថាបត្យកម្ម ការ ពិនិត្យ វាស់វែង ដីធ្លី ការ ប្រកប របរ ផ្នែក គណនេយ្យ អ្នក ជំនាញ ទេសចរណ៍ ការ ប្រកប របរ ផ្នែក ទន្តពេទ្យ និង អ្នក ជំនាញ ផ្នែក សេវា វេជ្ជសាស្ត្រ។
«សេវា គិលានុបដ្ឋាក និង សេវា ផ្នែក វេជ្ជសាស្ត្រ សេវា ទាំង នេះ នៅ តែ ជួប បញ្ហា ប្រឈម ដ៏ ធំ»។
លោក បាន លើក ឡើង ថា គុណភាព ផ្តល់ សេវា ផ្នែក វេជ្ជសាស្ត្រ និង គិលា នុបដ្ឋាករ នៅ កម្ពុជា គឺ នៅ មាន ភាព ខ្វះ ខាត និង ខុស ប្លែក គ្នា យ៉ាង ច្រើន ប្រៀប ធៀប នឹង ប្រទេស ផ្សេងៗ ក្នុង តំបន់ ដោយ សារ វិស័យ នេះ ត្រូវ ការ ការ ត្រៀម ខ្លួន រយៈ ពេល យូរ តែ កម្ពុជា ទើប បាន ចាប់ ផ្តើម កសាង លទ្ធភាព ប្រកួត ប្រជែង នៅ ក្នុង រយៈ ពេល ២០ ឆ្នាំ ចុង ក្រោយ នេះ ប៉ុណ្ណោះ បន្ទាប់ ពី សង្គ្រាម ផ្ទៃ ក្នុង ត្រូវ បាន បញ្ចប់។
«យើង ហាក់ ដូច ជា មិន ទាន់ មាន លទ្ធភាព គ្រប់ គ្រាន់ ក្នុង ការ ប្រកួត ប្រជែង ជាមួយ ប្រទេស ជា សមាជិក អាស៊ាន ផ្សេង ទៀត នៅ ឡើយ នោះ ទេ ទាក់ ទង នឹង លំហូរ ពលករ មាន ជំនាញ ខាង វិស័យ វេជ្ជសាស្ត្រ»។
សម្រាប់ ប្រទេស កម្ពុជា ការ បើក ទីផ្សារ ចេញ- ចូល នៃ ពលករ មាន ជំនាញ ផ្នែក សេវា វេជ្ជសាស្ត្រ ទំនង ជា នឹង ទទួល បាន ជន បរទេស ដែល មាន ជំនាញ ខ្ពស់ ជាង ចូល មក កម្ពុជា ជាជាង ឃើញ ពី ឱកាស ឬ បំណង អ្នក មាន ជំនាញ ក្នុង ស្រុក ដែល ចង់ ទៅ ធ្វើ ការ នៅ បរទេស។
ការ អនុវត្ត ច្បាប់ ក្នុង ស្រុក នឹង ជួយ ទប់ ស្កាត់ ការ បាត់ បង់ នេះ យ៉ាង ណា ក៏ ដោយ លំហូរ ដោយ សេរី នៃ កម្លាំង ពលកម្ម មាន ជំនាញ ជា លំហូរ មួយ ដែល ត្រូវ បាន គ្រប់ គ្រង ដោយ វិធានការ កម្រិត តំបន់ និង ស្ថិត ក្រោម អំណាច ច្បាប់ និង បទ ប្បញ្ញត្តិ តាម ប្រទេស។
នៅ កម្ពុជា បញ្ញត្តិ ករ ផ្នែក សេវាកម្ម វេជ្ជសាស្ត្រ គឺ ស្ថិត ក្រោម គណៈ គ្រូពេទ្យ កម្ពុជា គឺ តម្រូវ ឲ្យ រាល់ គ្រូពេទ្យ ទាំង អស់ រួម ទាំង គ្រូ ពេទ្យ ខ្មែរ និង បរទេស ដែល ធ្វើ ការ នៅ កម្ពុជា ត្រូវ តែ សុំ ចុះ បញ្ជិកា ជាមួយ គណៈ គ្រូ ពេទ្យ។
គិត មក ទល់ ពេល នេះ ចំនួន គ្រូពេទ្យ ដែល បាន ចុះ បញ្ជី នៅ គណៈ គ្រូពេទ្យ កម្ពុជា សរុប បញ្ចូល គ្នា តាម រាជធានី-ខេត្ត មាន ចំនួន ៣ ២១១ នាក់ ក្នុង នោះ រួម មាន វេជ្ជបណ្ឌិត ពេទ្យ មធ្យម និង ពេទ្យ ឯកទេស។
នេះ បើ យោង តាម ទិន្នន័យ លើ គេហទំព័រ ពី គណៈ គ្រូពេទ្យ កម្ពុជា។
រីឯ ចំនួន គ្រូ ពេទ្យ ដែល ចុះ បញ្ជី នេះ មាន ប្រមាណ ត្រឹម តែ ៣០ ភាគរយ ប៉ុណ្ណោះ នៃ ចំនួន អ្នក កំពុង អនុវត្ត ក្នុង វិស័យ វេជ្ជសាស្ត្រ ទាំង អស់ នៅ កម្ពុជា។
បើ ទោះ បី ជា កម្ពុជា មាន មន្ទីរពេទ្យ ដែល វិនិយោគ ពី បរទេស ដូចជា មន្ទីរពេទ្យ រ៉ូយ៉ាល់ ភ្នំពេញ របស់ ថៃ និង មន្ទីរពេទ្យ ជោរៃ ពី វៀតណាម ហើយ មាន គ្រូ ពេទ្យ ពី ប្រទេស ទាំង នោះ កំពុង ធ្វើ ការ នៅ កម្ពុជា ក៏ដោយ គិត មក ទល់ ពេល នេះ គណៈ គ្រូពេទ្យ កម្ពុជា មិន ទាន់ បាន ទទួល ពាក្យ សុំ ចុះ បញ្ជី ពី គ្រូពេទ្យ បរទេស ទាំង នោះ សូម្បី តែ ម្នាក់ នៅ ឡើយ នោះ ទេ។
នេះ បើ យោង តាម លោក សាស្ត្រាចារ្យ វេជ្ជបណ្ឌិត ឆេង កាន់ណារ៉ាត់ អគ្គ លេខាធិការ រង នៃ គណៈ គ្រូពេទ្យ កម្ពុជា។
លោក បន្ត ថា រហូត មក ទល់ ពេល នេះ អ្វី ដែល គណៈ គ្រូពេទ្យ កម្ពុជា បាន ត្រៀម ខ្លួន សម្រាប់ AEC ក្នុង វិស័យ វេជ្ជសាស្ត្រ មាន ដូច ជា ការ ផ្សព្វ ផ្សាយ ពី ការ ព្រម ព្រៀង នៃ លំហូរ ដោយ សេរី រវាង កម្លាំង ពលកម្ម មាន ជំនាញ ដល់ អ្នក ចាប់ អាជីព ក្នុង វិស័យ វេជ្ជសាស្ត្រ ការ ផ្តល់ ការ បណ្តុះ បណ្តាល បន្ត ដើម្បី ពង្រឹង គុណភាព គ្រូពេទ្យ និង ការ រៀបចំ ប្រព័ន្ធ ចុះ បញ្ជី គ្រូ ពេទ្យ ក្នុង ស្រុក និង បរទេស ដើម្បី ធានា បាន ឲ្យ មាន គុណភាព មាន សីលធម៌ ត្រឹម ត្រូវ។
បើ យោង តាម លោក កាន់ណារ៉ាត់ ការ ត្រៀម ខ្លួន ជា អាទិភាព របស់ កម្ពុជា ទាក់ ទង នឹង ការ អនុវត្ត វិជ្ជាជីវៈ វេជ្ជសាស្ត្រ សម្រាប់ AEC ២០១៥ គឺ ផ្តោត សំខាន់ តែ លើ ការ ធានា ឲ្យ បាន នូវ លំហូរ ចូល គ្រូពេទ្យ ពី បរទេស ប្រកប ដោយ គុណភាព និង សីលធម៌ ត្រឹម ត្រូវ ប៉ុណ្ណោះ ខណៈ ការ រំពឹង ពី លទ្ធភាព លំហូរ ចេញ នៃ គ្រូពេទ្យ កម្ពុជា ទៅ ធ្វើ ការ នៅ ក្រៅ ប្រទេស ហាក់ មិន បាន ត្រៀម នោះ ឡើយ។
លោក បាន បញ្ជាក់ ថា បច្ចុប្បន្ន គណៈ គ្រូពេទ្យ មាន ប្រព័ន្ធ ចុះ បញ្ជី គ្រូ ពេទ្យ រួច រាល់ ហើយ និង កំពុង រៀបចំ ប្រព័ន្ធ បញ្ជាក់ ពី គុណភាព សមត្ថភាព គ្រូពេទ្យ ដើម្បី ឲ្យ មាន លក្ខខណ្ឌ ស្រប តាម កិច្ច ព្រម ព្រៀង ទទួល ស្គាល់ ទៅ វិញ ទៅ មក (MRA) ដែល អនុ លោម តាម ស្តង់ដារ អាស៊ាន សម្រាប់ ផ្តល់ ភាព ងាយ ស្រួល ដល់ អ្នក ជំនាញ វេជ្ជសាស្ត្រ កម្ពុជា ក្នុង ការ ទទួល បាន ការ ទទួល ស្គាល់ ពី MRA ពី បណ្តា ប្រទេស ផ្សេង ទៀត ក្នុង តំបន់។
យោង តាម ការ សិក្សា មួយ របស់ CDRI ទាក់ទង នឹង លំហូរ ដោយ សេរី នៃ កម្លាំង ពលកម្ម មាន ជំនាញ នេះ ដែល បាន ចេញ ផ្សាយ កាលពី ចុង ឆ្នាំ ២០១៤ កម្ពុជា កំពុង ជួប កង្វះ ខាត ពលករ មាន ជំនាញ ដោយសារ កង្វះ ឆន្ទះ របស់ អ្នក អនុវត្តន៍ ការ ផ្លាស់ ប្តូរ ការងារ ញឹក ញាប់ ពេក និង កង្វះ ការ អប់រំ បណ្តុះ បណ្តាល ដែល មាន គុណភាព។
ការ សិក្សា ក៏ បាន បញ្ជាក់ បន្ត ផង ដែរ ថា ក្នុង រយៈ ពេល វែង កម្ពុជា គួរ ផ្តោត លើ ការ អភិវឌ្ឍ ជំនាញ ពលករ ក្នុង ស្រុក ដើម្បី កាត់ បន្ថយ ការ ពឹង ផ្អែក លើ ការ នាំ ចូល ពលករ ជំនាញ ក្នុង ស្រុក។
លោក សាស្ត្រាចារ្យ វេជ្ជបណ្ឌិត ឆេង កាន់ណារ៉ាត់ បាន លើក ឡើង ថា ការ បើក ចំហ ឲ្យ មាន លំហូរ ចូល ជំនាញ ផ្នែក វេជ្ជសាស្ត្រ ដែល មាន គុណភាព ពី បរទេស នឹង បង្ក ជា ផល ល្អ សម្រាប់ អ្នក ប្រើ ប្រាស់ បង្ក ជា ជម្រើស សម្រាប់ អ្នក មិន ទុក ចិត្ត គុណភាព គ្រូពេទ្យ នៅ ក្នុង ស្រុក។
«ក្នុង ផ្លូវ ល្អ ខ្ញុំ គិត ថា គុណភាព វា នឹង ពង្រឹង។
ប្រជាជន នឹង អាច ជ្រើស រើស សេវា ថែទាំ ដែល មាន គុណភាព ហើយ គ្រូពេទ្យ យើង នៅ ក្នុង បរិបទ ទីផ្សារ ប្រកួត ប្រជែង បែប នេះ នឹង ខំ រត់ ប្រណាំង តាម គេ ដែរ ទាំង ផ្នែក គុណភាព និង ក្រម សីលធម៌»។
ខុស ពី ប្រទេស ជឿន លឿន ក្នុង តំបន់ ដែល មាន កម្លាំង ពលកម្ម មាន ជំនាញ ស្រាប់ ហើយ បាន គេ រឹត ត្បិត មិន ចង់ ឲ្យ មាន ធនធាន ពី ប្រទេស ផ្សេង ចូល ប្រកួត ប្រជែង លោក សុក ស៊ីផាន់ណា លើក ឡើង ថា កម្ពុជា ជា ប្រទេស មាន ការ បើក ទូលាយ ស្រាប់ ហើយ អ្នក ជំនាញ វេជ្ជសាស្ត្រ ពី បរទេស មួយ ចំនួន ក៏ បាន ចូល មក កម្ពុជា ស្រាប់ ទៅ ហើយ។
ដូច្នេះ ការ បើក ចំហ ទីផ្សារ ដែល មាន បញ្ញត្តិ កម្ម ច្បាស់ លាស់ គឺជា ឱកាស ដើម្បី ឲ្យ ធនធាន មនុស្ស ជំនាន់ ក្រោយ អាច រៀន សូត្រ ពីបទ ពិសោធ ល្អៗ ដើម្បី ឲ្យ ពួក គេ អាច ខ្លាំង សម្រាប់ រយៈ ពេល ខាង មុខ។
លោក បាន លើក ឡើង បន្ត ថា នៅ ពេល ដែល មាន លំហូរ ដោយ សេរី នៃ ពលករ មាន ជំនាញ លោក ចង់ ជំរុញ ឲ្យ អ្នក ជំនាញ ផ្តល់ សេវា វេជ្ជសាស្ត្រ ពី បរទេស ចូល មក ឲ្យ បាន ច្រើន ដើម្បី បំពេញ ចន្លោះ ភាព ខ្វះ ខាត នៃ គុណភាព គ្រូពេទ្យ ក្នុង ស្រុក និង កម្សោយ ផ្នែក ក្រម សីលធម៌ វិជ្ជាជីវៈ។
«យើង ប្រហែល ជា មិន ទាន់ មាន លទ្ធភាព ក្នុង ការ ប្រកួត ប្រជែង ជាមួយ ពួកគេ នៅ ថ្ងៃ នេះ ប៉ុន្តែ ប្រសិន បើ យើង ស្វាគមន៍ ពួកគេ ហើយ យើង រៀន ពី ពួកគេ យើង សហការ ជាមួយ ពួកគេ យើង ធ្វើការ ជាមួយ ពួកគេ ប្រាំ ឆ្នាំ ទៀត ចាប់ ពី ពេល នេះ តទៅ យើង នឹង ខ្លាំង ដូច គេ ដែរ»។
«បទ ប្បញ្ញត្តិ ទីផ្សារ ត្រូវ បាន បើក ចំហ ប៉ុន្តែ យើង ត្រូវ យល់ ពី ស្ថានភាព សេដ្ឋកិច្ច ផង ដែរ។
ខ្ញុំ មិន ជឿ ថា វេជ្ជបណ្ឌិត មក ពី ប្រទេស សិង្ហបុរី គាត់ មក ធ្វើការ នៅ ស្រុក យើង ទេ ប្រាក់ ខែ គាត់ ច្រើន ណាស់»។
លោក បាន រំឭក ថា យុវជន កម្ពុជា ត្រូវ ខិតខំ ស្វែង យល់ និង អភិវឌ្ឍ ខ្លួន ដើម្បី ភាព រួចរាល់ ក្នុង ការ ប្រកួត ប្រជែង ជាជាង ការ ពឹង ផ្អែក លើ តែ ជំនួយ ពី រដ្ឋាភិបាល។
ត្រូវ សួរ ថា តើ អ្នក បាន ធ្វើ អ្វី សម្រាប់ កម្ពុជា?
យ៉ាង ណា ក៏ ដោយ លោក វេជ្ជបណ្ឌិត ឃុន បូរ័ត្ន បាន យល់ ឃើញ ផ្ទុយ ពីអ្វី ដែល អ្នក បង្កើត គោល នយោបាយ បាន លើក ឡើង។
ខណៈ ដែល ការ បើក ទីផ្សារ កម្លាំង ពលកម្ម មាន ជំនាញ បាន បង្ក ឲ្យ មាន លំហូរ ចូល នៃ ការ វិនិយោគ ផ្នែក វេជ្ជសាស្ត្រ ពី ប្រទេស នានា ក្នុង តំបន់ វត្តមាន មន្ទីរពេទ្យ បរទេស ទាំង នោះ នឹង ទាក់ទាញ វេជ្ជបណ្ឌិត ពី ប្រទេស គេ មក ប្រជែង ការងារ នៅ កម្ពុជា កាន់ តែ ខ្លាំង ឡើង។
សម្រាប់ គ្រូពេទ្យ ធម្មតា ឬក៏ គិលា នុបដ្ឋាករ អី ប្រហែល ជា ពួក គាត់ មាន ឱកាស ច្រើន ព្រោះ គេ អត់ មក ប្រជែង ទេ ប៉ុន្តែ សម្រាប់ វេជ្ជបណ្ឌិត ខ្ញុំ គិត ថា យើង នឹង ពិបាក ជាង មុន»៕
ក្រុមហ៊ុន នេះ នឹង ដាក់ បង្ហាញ សេវា ច្នៃ ប្រឌិត ផង ដែរ ដល់ អ្នកដំណើរ ដែល ស្វែង រក ការ រៀបចំ តម្លៃ បន្ថែម របស់ ព្រលាន យន្តហោះ ដែល រួមមាន សេវា ជួបជុំ និង ស្វាគមន៍ និង អគារ ស្ប៉ា និង ទឹក ផ្កា ឈូក ដែល រួម ចំណែក លើក កម្ពស់ បន្ថែម ដល់ ការ ធ្វើ ដំណើរ និង បទពិសោធ របស់ ព្រលាន យន្តហោះ។
គម្រោង នេះ នឹង ប្រតិបត្តិការ លើ ផ្ទៃដី ទំហំ ២ ២០០ ម៉ែត្រ ការ៉េ នៅ ក្នុង ព្រលាន យន្ត ទាំង ពីរ។
ស្ថានីយ បង់ ប្រាក់ នេះ នឹង ដាក់ ឲ្យ ដំណើរការ នៅ ឆ្នាំ នេះ។
«ដើម្បី រួម ចំណែក លើក កម្ពស់ បន្ថែម ដល់ ការ ធ្វើ ដំណើរ និង បទ ពិសោធ របស់ ព្រលាន យន្តហោះ សេវា នេះ ត្រូវ បាន គេ រំពឹង ថា នឹង ចាប់ ផ្ដើម ដំណើរការ នៅ ពាក់ កណ្ដាល ឆ្នាំ ២០១៥ នៅ ព្រលាន យន្តហោះ អន្តរជាតិ ភ្នំពេញ និង នៅ ចុង ឆ្នាំ នេះ នៅ ព្រលាន យន្ត ហោះ អន្តរជាតិ សៀមរាប»។
កាល ពី ខែ មករា ឆ្នាំ មុន ក្រុម ហ៊ុន ព្រលាន យន្តហោះ កម្ពុជា បាន ចាប់ ផ្ដើម កម្មវិធី ធ្វើ ឲ្យ ប្រសើរ ឡើង ដែល មាន ទឹក ប្រាក់ ១០០ លាន ដុល្លារ ដើម្បី ពង្រីក ស្ថានីយ អ្នក ដំណើរ នៅ ព្រលាន យន្តហោះ អន្តរជាតិ ភ្នំពេញ និង សៀមរាប និង ដើម្បី បង្កើន សមត្ថភាព ទទួល អ្នក ដំណើរ ទ្វេដង រហូត ដល់ ៥ លាន នាក់ នៅ ក្នុង ព្រលាន យន្តហោះ អន្តរជាតិ ទាំង ពីរ នេះ។
លោក ខែក នរិន្ទដា នាយក ទំនាក់ ទំនង និង ទីផ្សារ របស់ ព្រលាន យន្តហោះ កម្ពុជា បាន ថ្លែង ថា កម្មវិធី ពង្រីក ព្រលាន យន្តហោះ អន្តរជាតិ ទាំង ពីរ នេះ នឹង បង្កើន សមត្ថភាព ទ្វេ ដង ដល់ ៥ លាន នាក់ ក្នុង មួយ ឆ្នាំ ជាមួយ នឹង ការ ដាក់ បន្ថែម បញ្ជរ ត្រួត ពិនិត្យ ពេល ចូល និង បញ្ជរ អន្តោ ប្រវេសន៍ ដើម្បី បង្កើន នីតិវិធី ការ ធ្វើ ដំណើរ និង ធ្វើ ឲ្យ កាន់ តែ មាន ផាសុកភាព និង ផ្ដល់ សេវា ដល់ អ្នក ដំណើរ និង ទីកន្លែង កាន់ តែ ធំ ជាង មុន សម្រាប់ ហាង លក់ រាយ និង ហាង អាហារ និង ភេសជ្ជៈ។
ចំនួន អ្នក ដំណើរ ឆ្លង កាត់ ព្រលាន យន្តហោះ អន្តរជាតិ របស់ ប្រទេស កម្ពុជា មាន ចំនួន សរុប ៥,៧ លាន នាក់ កាល ពី ឆ្នាំ ២០១៤។
ព្រលាន យន្តហោះ អន្តរជាតិ ភ្នំពេញ និង សៀមរាប ផ្ដល់ ជើង ហោះ ហើរ ជិត ៥០០ ក្នុង មួយ សប្ដាហ៍ ដែល ត ភ្ជាប់ ទីក្រុង ទាំង ពីរ ទៅ កាន់ ទិសដៅ ៣០ នៅ ក្នុង តំបន់ អាស៊ី និង តំបន់ ឈូង សមុទ្រ។
លោក អាង គឹមអៀង ប្រធាន សមាគម ភ្នាក់ងារ ទេសចរណ៍ កម្ពុជា ថ្លែង ថា ការ បង្កើត ស្ថានីយ រង់ចាំ សម្រាប់ អ្នក ដំណើរ នេះ ឆ្លុះ បញ្ចាំង ពី ការ កែលម្អ បដិ សណ្ឋារកិច្ច របស់ កម្ពុជា។
«ស្ទើរ តែ គ្រប់ ព្រលាន យន្ត ហោះ នៅ ក្នុង ពិភពលោក មាន ស្ថានីយ រង់ចាំ បង់ ប្រាក់ សម្រាប់ អ្នក ដំណើរ។
ការ បង្កើត ស្ថានីយ ពាណិជ្ជកម្ម ថ្មី នេះ ឆ្លុះ បញ្ចាំង ថា បដិ សណ្ឋារកិច្ច នៅ កម្ពុជា កំពុង រីក ចម្រើន»៕
លោក បាន ថ្លែង ក្នុង សិក្ខាសាលា មួយ នៅ ទីក្រុង ហ្វ្រែងហ្វឺដ ថា ការ ទិញ មូលបត្រ បំណុល ដំបូង នេះ បាន ធ្វើ ឲ្យ កម្មវិធី QE ដើរ ឆ្ពោះ ទៅ រក គោលដៅ ប្រចាំ ខែ របស់ ខ្លួន ក្នុង ការ ទិញ ត្រឡប់ មក វិញ នូវ មូលបត្រ បំណុល វិស័យ សាធារណៈ និង ឯកជន ក្នុង ទឹក ប្រាក់ ចំនួន ៦០ ពាន់ លាន អឺរ៉ូ។
គម្រោង QE របស់ ធនាគារ កណ្តាល អឺរ៉ុប នេះ ត្រូវ បាន សហរដ្ឋ អាមេរិក និង អង់គ្លេស ប្រើ ប្រាស់ រួច មក ហើយ ដើម្បី ជំរុញ សេដ្ឋកិច្ច របស់ ខ្លួន។
តែ កម្មវិធី QE បាន មក ដល់ តំបន់ អឺរ៉ុប យូរ មក ហើយ និង ត្រូវ បាន ចាត់ ទុក ថា ជា អាវុធ ចុង ក្រោយ នៅ ក្នុង ឃ្លាំង អាវុធ ប្រយុទ្ធ ប្រឆាំង នឹង បរិត្តផរណា ដ៏ ធំ របស់ ធនាគារ កណ្តាល អឺរ៉ុប ដើម្បី ជំរុញ ការ ស្ទុះ ងើប ឡើង វិញ នៃ សេដ្ឋកិច្ច របស់ តំបន់ នេះ។
ធនាគារ កណ្តាល អឺរ៉ុប រំពឹង ថា តាម រយៈ ការ ទិញ មូលបត្រ បំណុល របស់ ក្រុម វិនិយោគ នេះ ពួកគេ នឹង វិនិយោគ នៅ កន្លែង ផ្សេង ទៀត ដូច្នេះ វា នឹង ជំរុញ កំណើន សេដ្ឋកិច្ច និង ទប់ស្កាត់ វដ្ត ប្រកប ដោយ គ្រោះថ្នាក់ នៃ ការ ធ្លាក់ ចុះ តម្លៃ ទំនិញ មិន ឲ្យ កើត ឡើង៕
រដ្ឋាភិបាលថៃនឹងលក់កៅស៊ូផ្ទាល់ឲ្យចិន
រដ្ឋាភិបាល ថៃ បាន ទិញ កៅស៊ូ ចំនួន ១៣ ម៉ឺន តោន រួច ហើយ គិត ចាប់ តាំង ពី កម្មវិធី ទិញ កៅស៊ូ នេះ បាន ចាប់ ផ្តើម កាល ពី ខែ វិច្ឆិកា មក។
«រដ្ឋាភិបាល បាន ធ្វើ អន្តរាគមន៍ ដោយ សារ យន្តការ ទីផ្សារ តែ មួយ មុខ មិន គ្រប់ គ្រាន់ ដើម្បី ជួយ កសិករ ឲ្យ មាន ប្រាក់ ចំណូល គ្រប់ គ្រាន់ ដើម្បី ទូទាត់ ចំណាយ ជីវភាព រស់នៅ ទេ។
រដ្ឋាភិបាល នឹង ដើរ តួនាទី ជា ពាណិជ្ជករ មួយ រូប ដោយ ទិញ និង លក់ កៅស៊ូ នេះ។
កម្មវិធី ទិញ កៅស៊ូ នេះ គឺជា ផ្នែក មួយ នៃ កិច្ច ខិតខំ ប្រឹង ប្រែង រួម ពី សំណាក់ ប្រទេស ដាំ ដំណាំ កៅស៊ូ ធំៗ ក្នុង ពិភពលោក ដើម្បី ទទួល បាន តម្លៃ ដែល បាន ធ្លាក់ ចុះ ខ្លាំង ជាង ៦០ ភាគរយ ធៀប នឹង តម្លៃ ខ្ពស់ បំផុត នៅ ឆ្នាំ ២០១១ ខណៈ ដើម កៅស៊ូ ដែល បាន ដាំ កាល ពី ១០ ឆ្នាំ មុន នៅ ទូទាំង តំបន់ អាស៊ី អាច ចៀរ យក ជ័រ បាន និង បាន ធ្វើ ឲ្យ ទីផ្សារ សម្បូរ ទៅ ដោយ ជ័រ កៅស៊ូ។
តម្រូវការ កៅស៊ូ ក៏បាន ធ្លាក់ ចុះ ដែរ នៅ ប្រទេស ចិន។
ប្រាក់អឺរ៉ូធ្លាក់ថ្លៃជិតស្មើនឹងប្រាក់ដុល្លារ
ទន្ទឹម នឹង នោះ ដែរ សេដ្ឋកិច្ច អាមេរិក កំពុង បន្ត កើន ឡើង ប្រកប ដោយ ស្ថិរភាព ដោយ មាន ការ រំពឹង ថា ធនាគារ កណ្តាល អាមេរិក នឹង ចាប់ ផ្តើម ដំឡើង អត្រា ការ ប្រាក់ នៅ អំឡុង ពាក់ កណ្តាល ឆ្នាំ នេះ។
ធនាគារ នេះ បាន បន្ត ឲ្យ ដឹង ថា លទ្ធផល នៃ ការ ផ្គត់ ផ្គង់ ប្រាក់ អឺរ៉ូ ខ្ពស់ ជាង តម្រូវ ការ ទីផ្សារ នឹង កើត មាន ឡើង កាន់ តែ ខ្លាំង ក្នុង គោល បំណង ស្វែង រក ប្រាក់ ចំណេញ ដែល ធ្វើ ឲ្យ ប្រាក់ អឺរ៉ូ ធ្លាក់ ថ្លៃ កាន់ តែ ខ្លាំង។
អតិរេក ថវិកា ចរន្ត របស់ តំបន់ ប្រើ ប្រាស់ ប្រាក់ អឺរ៉ូ គឺជា សញ្ញា មួយ ដែល បង្ហាញ ពី បរិមាណ ទឹក ប្រាក់ សន្សំ ដ៏ ច្រើន លើស លប់ ដែល កំពុង ស្វែង រក ទ្រព្យ សកម្ម ដែល អាច វិនិយោគ បាន នៅ ក្រៅ ប្រទេស។
អត្រា ការ ប្រាក់ ក្រោម សូន្យ និង គោល នយោបាយ ផ្គត់ ផ្គង់ ថវិកា បន្ថែម បញ្ចូល ទៅ ក្នុង សេដ្ឋកិច្ច របស់ ធនាគារ កណ្តាល របស់ សហភាព អឺរ៉ុប បាន កែ ប្រែ បញ្ហា ធ្ងន់ ធ្ងរ នៃ កង្វះ ទ្រព្យ សកម្ម នៅ តំបន់ អឺរ៉ុប ព្រម ទាំង បង្កើត ផ្តួច ផ្តើម ដំណើរការ នៃ លំហូរ មូលធន ក្នុង ទ្រង់ ទ្រាយ ធំ មួយ៕
