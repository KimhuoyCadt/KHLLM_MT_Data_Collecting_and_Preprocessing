( ភ្នំពេញ ) ៖ លោក វេជ្ជបណ្ឌិត ញឹប អង្គា បុស្ស នាយក មន្ទីរពេទ្យ កុមារ ជាតិ បាន ថ្លែង ឱ្យដឹង ថា គិត ចាប់ពី ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០១៩ រហូតមកដល់ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ មាន អ្នកជំងឺ បាន មក ទទួល សេវា ព្យាបាល ពី មន្ទីរពេទ្យ កុមារ ជាតិ ចំនួន រហូតដល់ ១២៨,០៤២ នាក់ បើ ធៀប ជាមួយនឹង រយៈពេល ដូចគ្នា ក្នុង ឆ្នាំ ២០១៨ គឺ មាន ការកើនឡើង យ៉ាង ច្រើន ។
លោក វេជ្ជបណ្ឌិត ញឹប អង្គា បុស្ស បាន លើកឡើង យ៉ាង ដូចនេះ នា ល្ងាច ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល លោក បាន ទទួល ជួប សំណោះ សំណាល ជាមួយនឹង លោក ផៃ ស៊ីផាន អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ដឹកនាំ សមាគម សិល្បក ខ្មែរ ចុះ មើល ពី ភាពខ្វះខាត នៃ មន្ទីរពេទ្យ កុមារ ជាតិ ដើម្បី ស្វែងរក ធនធាន តាមរយៈ មធ្យោបាយ ផ្សេង ៗ ដើម្បី យក ថវិកា មក ជួយ ទ្រទ្រង់ ដល់ មន្ទីរពេទ្យ កុមារ ជាតិ ។
លោក វេជ្ជបណ្ឌិត ញឹប អង្គា បុស្ស បាន លើកឡើង ទៀត ថា មន្ទីរពេទ្យ កុមារ ជាតិ នៅក្នុង ឆ្នាំ ២០១៩ នេះ គឺ មាន អ្នកជំងឺ បាន ចូលមក ទទួល សេវា ព្យាបាល យ៉ាង ច្រើន ខណៈ បើ ប្រៀបធៀប ជាមួយ នឹង ឆ្នាំ មុន នេះ គឺ មាន ការកើនឡើង ស្ទើរតែ ២ ដង ។
ដោយសារតែ កត្តា អ្នកជំងឺ មាន ការកើនឡើង ជាច្រើន ដូចនេះ បាន ធ្វើឱ្យ មន្ទីរពេទ្យ មាន ការខ្វះខាត ជាច្រើន ទាំង ថវិកា ទាំង អគារ និង គ្រែ សម្រាប់ អ្នកជំងឺ រូម ជាមួយ ឧបករណ៍ ក្នុង ការជួយសង្គ្រោះ អ្នកជំងឺ និង សេវា ផ្សេង ៗ ជាច្រើន ទៀត ។
នាយក មន្ទីរពេទ្យ កុមារ ជាតិ បាន បញ្ជាក់ ទៀត ថា ដោយសារតែ ប្រជាជន ភាគ ច្រើន នៅពេល ច្ចុប្បន្ន នេះ បាន ចាប់អារម្មណ៍ ក្នុង ប្រើប្រាស់ សេវា មន្ទីរពេទ្យ របស់ រដ្ឋ កាន់តែ ច្រើន បាន ធ្វើឱ្យ មន្ទីរពេទ្យ ជួយ បញ្ហា ចំបង ធំ បំផុត នោះ គឺ បញ្ហា អគារ សម្រាប់ អ្នក ជំងឺ ស្នាក់ នៅ រួមទាំង សំភារៈ ជួយសង្គ្រោះ ផ្សេង ៗ ខណៈ ដែល ថ្នាំ សង្កូវ សម្រាប់ ប្រើប្រាស់ ប្រចាំ ឆ្នាំ មួយចំនួន ធំ គឺ បាន គ្រប់គ្រង ដោយ ក្រសួង សុខាភិបាល រួចហើយ ។
លោក វេជ្ជបណ្ឌិត ញឹប អង្គា បុស្ស ក៏ បាន អំពាវនាវ ដល់ សាធារណជន ទាំងអស់ មេត្តា ចូលរួម បរិច្ចាគ ជួយ ដល់ មន្ទីរពេទ្យ កុមារ ជាតិ ដើម្បី ចូលរួមចំណែក ជួយ ទ្រទ្រង់ ដល់ ដំណើរការ របស់ មន្ទីរពេទ្យ ក្នុង ការជួយសង្គ្រោះ ជីវិត កុមារ កម្ពុជា និង ផ្តល់ សេវា ព្យាបាល ឱ្យ បាន គ្រប់គ្រាន់ ដល់ អ្នកជំងឺ ៕
គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ណុង ហឹប ហ្វាយ នែន បើក វគ្គ បណ្តុះបណ្តាល បច្ចេកទេស ចិញ្ចឹម សត្វ ដល់ ពលរដ្ឋ ប្រមាណ ១០០ នាក់ ក្នុង ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ
គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ណុង ហឹប ហ្វាយ នែន គឺជា គ្រឹះស្ថាន និង ជា ក្រុមហ៊ុន បុត្រ សម្ព័ន្ធ នៃ ធនាគារ ណុង ហឹប នៃ សាធារណរដ្ឋ កូរ៉េ ខាងត្បូង ។
ណុង ហឹប គឺជា ធនាគារ ដែល បាន បង្កើតឡើង នៅ ឆ្នាំ ១៩៦១ ដោយ ប្រើប្រាស់ ដើមទុន ក្នុង ស្រុក របស់ ប្រទេស កូរ៉េ ១០០ ភាគរយ ហើយ ធនាគារ នេះ គឺជា ធនាគារ ឯកទេស ដែល គ្រប់គ្រង ប្រាក់ បញ្ញើ ទាំង ថ្នាក់ មជ្ឈិម និង ថ្នាក់ តំបន់ របស់ រដ្ឋាភិបាល ប្រកបដោយ សុវត្ថិភាព ដោយ មាន បណ្តាញ សាខា ធំ ទូលាយ ជាង គេ ទូទាំង ប្រទេស ។
កេរិ៍ ត ឈ្មោះ របស់ ធនាគារ នេះ មិន ត្រឹមតែ លេចធ្លោ លើ សេវាកម្ម ផ្នែក ហិរញ្ញវត្ថុ ប៉ុណ្ណោះ ទេ ថែមទាំង មាន តួនាទី ក្នុង ការលើកតម្កើង សុខ មាលភាព សង្គម និង កសិកម្ម នៅ សាធារណរដ្ឋ កូរ៉េ ទៀតផង ។
ណុង ហឹប បាន ជ្រៀត ខ្លួន ចូលក្នុង ទីផ្សារ ក្រៅ ប្រទេស តាមរយៈ សាខា ធនាគារ នៅ បរទេស ដូចជា សហរដ្ឋ អាមេរិក វៀតណាម និង សាខា ជា គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ នៅ មីយ៉ាន់ម៉ា និង កម្ពុជា និង មាន ការិយាល័យ តំណាង នៅ ប្រទេស ចិន និង ឥណ្ឌា ។
ណុង ហឹប ហ្វាយ នែន បាន ទទួល អាជ្ញាប័ណ្ណ ពី ធនាគារ ជាតិ នៃ កម្ពុជា នៅ ថ្ងៃទី ០៨ ខែសីហា ឆ្នាំ ២០១៨ ដើម្បី ប្រកប អាជីវកម្ម ជា គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ បន្ទាប់ពី ធនាគារ ណុង ហឹប បាន ទិញ យក ភាគហ៊ុន ទាំងស្រុង ១០០ ភាគរយ ពី គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ សាមិក ភី អិល ស៊ី ។
បច្ចុប្បន្ន នេះ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ណុង ហឹប កំពុង ធ្វើ ប្រតិបត្តិការ នៅ រាជធានី ភ្នំពេញ និង ខេត្ត ចំនួន ៨ រួមមាន កណ្តាល កំពង់ស្ពឺ តាកែវ កំពត កែប ព្រះសីហនុ សៀមរាប និង កំពង់ធំ ។
មន្រ្តី យោធា ២ នាក់ កំពុង បើក ម៉ូតូ ទៅ ព្យាបាល ជំងឺ ស្រាប់តែ បាក់ ស្រុត ដីធ្លាក់ ចូល ទឹក ហូរ ទៅ បាត់
ហេតុការ ដ៏ រន្ធត់ នេះ ត្រូវបាន គេ ថត បាន និង ត្រូវបាន ចែកចាយ ត គ្នា ពេញ បណ្តាញ សង្គម បង្កើត ឲ្យ មាន អារម្មណ៍ សោកស្តាយ យ៉ាង ខ្លាំង ចំពោះ ក្រុមគ្រួសារ ជនរងគ្រោះ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ ក៏ បាន ស្នើ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម ដងទន្លេ សេកុង សហការ ជាមួយ នគរបាល របស់ លោក ជួយ ស្វែងរក ជនរងគ្រោះ ដែល បាន បាត់ខ្លួន នោះ ភ្លាម ៗ ផងដែរ ។
អ្នក ទាំង ពីរ បច្ចុប្បន្ន បម្រើ ការងារ ក្នុង អង្គភាព កង អនុ សេនា ធំ ទី ៣ វរសេនា តូច កាំភ្លើង ធំ បញ្ជាការស្រាល យោធ ភូមិភាគ ទី ១ ប្រចាំ ការ នៅ ភូមិសាស្ត្រ អូរ អាឡៃ ។
សមត្ថកិច្ច មូលដ្ឋាន បាន ឲ្យដឹង ថា នា ព្រឹក ថ្ងៃទី ២៤ ខែកក្ត ដា ឆ្នាំ ២០១៩ ម្សិលមិញ ពួកគេ ទាំង ពីរ នាក់ បាន ជិះ ម៉ូតូ ចេញ ទៅ ពិនិត្យ សុខភាព តែ ខណៈ ធ្វើដំណើរ ឆ្លងកាត់ នៅ ចំណុច ស្ពាន អូរ មា ក្នុង ភូមិសាស្ត្រ អូរ អាឡៃ ព្រំដែន កម្ពុជា - ឡាវ បាន បាក់ ធ្លាក់ ចូល ពេល ទឹក កំពុង ហូរ ខ្លាំង តែម្តង ។
យោង តាម មន្ត្រី យោធា នៅ យោធ ភូមិភាគ ទី ១ បាន ឱ្យដឹង ថា ជនរងគ្រោះ ទាំង ពីរ នាក់ កំពុងតែ ធ្វើដំណើរ ទៅកាន់ មន្ទីរពេទ្យ ដោយសារ មន្ត្រី យោធា ដែល ជិះ ពី ខាងក្រោយ កំពុង កើតមាន ជំងឺ គ្រុនចាញ់ និង ញ័រ ញាក់ ខ្លាំង ៕
រដ្ឋមន្ដ្រី កសិកម្ម បើក ការការពារ សារណា ថ្នាក់ បរិញ្ញា វិទ្យាសាស្រ្ត កសិកម្ម ឆ្នាំ ២០១៨ - ២០១៩ និង ផ្តល់ អនុសាសន៍ សំខាន់ ៗ មួយចំនួន
ពិធី នេះ ក៏ មាន ការចូលរួម ពីសំណាក់ លោក - លោកស្រី មន្ត្រីរាជការ និង និស្សិត យ៉ាង ច្រើន កុះករ ។
លោក បណ្ឌិត ធន់ វឌ្ឍនា នាយក សាលា ជាតិ កសិកម្ម ព្រែក លៀប បាន រាយការណ៍ ជូន អង្គ ពិធី ជ្រាប ថា បច្ចុប្បន្ន សាលា មាន និស្សិត កំពុង សិក្សា ចំនួន ៩៩៣ នាក់ បែងចែក ជា ០៩ ជំនាញ រួមមាន ៖ ជំនាញ វិទ្យាសាស្ត្រ កសិកម្ម វិទ្យាសាស្ត្រ និង វេជ្ជសាស្ត្រ សត្វ ព្រៃឈើ ជល ផល សាក វប្បកម្ម ផ្សព្វផ្សាយ និង អភិវឌ្ឍន៍ ជនបទ សេដ្ឋកិច្ច កសិកម្ម ក សិឧស្សាហកម្ម សុរិយោដី និង វិស្វកម្ម កសិកម្ម ។
មាន សាស្រ្តាចារ្យ លោកគ្រូ អ្នកគ្រូ និង មន្ត្រីរាជការ ចំនួន ១៥០ នាក់ ។
លោក ថា បច្ចុប្បន្ន សាលា បាន ធ្វើ សហប្រតិបត្តិការ ជាមួយ សាកលវិទ្យាល័យ នានា មួយចំនួន នៅលើ ពិភពលោក ក្នុង គោលបំណង ធ្វើ ការបណ្តុះបណ្តាល សិក្សា ស្រាវជ្រាវ ផ្លាស់ប្តូរ សាស្រ្តាចារ្យ លោកគ្រូ អ្នកគ្រូ និង និស្សិត ដើម្បី បង្កើន សមត្ថភាព ធនធាន មនុស្ស សម្រាប់ ការ អប់រំ បណ្តុះបណ្តាល នៅ ទីនេះ ឲ្យ កាន់តែ ល្អ ប្រសើរ ជាលំដាន់ ស្រប តាម ការវិវឌ្ឍន៍ រីកចម្រើន ទាំង ផ្នែក សេដ្ឋកិច្ច សង្គម វិទ្យាសាស្ត្រ និង បច្ចេកទេស ទាំង ក្នុង តំបន់ និង នៅលើ ពិភពលោក ។
ពាក់ព័ន្ធ នឹង ពិធី នា ព្រឹក នេះ មាន និស្សិត សរុប ចំនួន ១៧៥ នាក់ ដែល ត្រូវ ធ្វើ ការការពារ សារណា ថ្នាក់ បរិញ្ញា វិទ្យាសាស្ត្រ កសិកម្ម សម្រាប់ ឆ្នាំ ២០១៨ - ២០១៩ ។
លោក រដ្ឋមន្ត្រី វេង សា ខុន បាន ធ្វើ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ថ្នាក់ដឹកនាំ សាស្រ្តាចារ្យ លោកគ្រូ អ្នកគ្រូ និង មន្ត្រីរាជការ ទាំងអស់ ដែល បាន លះបង់ គ្រប់ បែបយ៉ាង ក្នុង ស្មារតី យកចិត្តទុកដាក់ ទទួលខុសត្រូវ ចំពោះ កាតព្វកិច្ច ចំបង របស់ ខ្លួន ក្នុង ការអប់រំ បណ្តុះបណ្តាល ទាំង ចំណេះដឹង ចំណេះ ធ្វើ សីលធម៌ សុជីវធម៌ ដល់ និស្សិត ក្នុង បំណង ជួយ លើក តម្កើន សមត្ថភាព ធនធាន មនុស្ស ក្នុង វិស័យ កសិកម្ម ដើម្បីឲ្យ ពួកគេ ចូលរួម អភិវឌ្ឍន៍ វិស័យ នេះ បន្ទាប់ពី បញ្ចប់ ការសិក្សា ។
លោក រដ្ឋមន្ដ្រី ក៏ បាន ថ្លែងអំណរគុណ ជូន ចំពោះ គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ទាំង ថ្នាក់ ជាតិ និង អន្តរជាតិ ដែល បាន ជួយ ជ្រោមជ្រែង ឧបត្ថម្ភ គាំទ្រ និង ផ្តល់ កិច្ចសហប្រតិបត្តិការ បាន យ៉ាង ល្អ ធ្វើឲ្យ សាលា សម្រេច បាន សមិទ្ធិផល ជាច្រើន មកដល់ ពេលនេះ ។
លោក បាន បន្ត ថា ការបណ្តុះបណ្តាល ធនធាន មនុស្ស ក្នុង វិស័យ កសិកម្ម មិន អាច ឈប់ ទ្រឹង បាន ទេ ផ្ទុយទៅវិញ ត្រូវតែ បន្ត ដំណើរ ទៅ មុខ ប្រកបដោយ ភាពចរឹងមាំ ច្បាស់លាស់ ក្នុង ទិសដៅ តែ មួយ គឺ ចូលរួម អនុវត្ត គោលនយោបាយ ចតុកោណ តំណាក់កាល ទី ៤ របស់ រាជ រដ្ឋាភិបាល និង អនុវត្ត គោលនយោបាយ អភិវឌ្ឍ វិស័យ កសិកម្ម ឲ្យ មាន ការរីកចម្រើន ប្រកបដោយ ចីរភាព និង និរន្តរភាព ។
លោក រដ្ឋមន្ត្រី បាន ផ្តល់ អនុសាសន៍ សំខាន់ ៗ មួយចំនួន ដល់ មន្រ្តី រាជការ សាស្រ្តាចារ្យ លោកគ្រូ អ្នកគ្រូ មន្ត្រី និង និសិ្សត ទាំងអស់ សម្រាប់ ជា ទិសដៅ អនុវត្ត បន្ត ដូចតទៅ ៖ ទី ១ ៖ គណៈកម្មការ រដ្ឋ និង ក្មួយ ៗ និស្សិត ត្រូវ យកចិត្តទុកដាក់ លើ ទម្រង់ សរសេរ លទ្ធផល ស្រាវជ្រាវ និង ការបកស្រាយ ខ្លឹមសារ ដែល អាច យក ជា ឯកសារ ផ្លូវការ បាន ទាំង បច្ចេកទេស និង វិទ្យាសាស្រ្ត និង ជាពិសេស អាច ដោះស្រាយ បញ្ហា ប្រឈម កើត ចេញ ពី ការវិវឌ្ឍ នៃ ប្រទេសជាតិ ក្នុង កម្រិត មួយ ដែល កើតឡើង ក្នុង វិស័យ កសិកម្ម នា ពេល បច្ចុប្បន្ន ។
ទី ២ ៖ និស្សិត ដែល ត្រូវ ឡើង ការពារ សារណា នា ពេលនេះ ត្រូវ បង្ហាញ នូវ សមត្ថភាព និង ចំណេះដឹង ឲ្យ អស់ លទ្ធភាព ដើម្បី ធ្វើ ការវាស់ស្ទង់ ចំណេះដឹង ផ្នែក ទ្រឹស្តី និង ការអនុវត្ត ជាក់ស្តែង តាមរយៈ លទ្ធផល ស្រាវជ្រាវ អស់ រយៈពេល ៦ ខែ ស្រប តាម យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម របស់ ក្រសួង គឺ ទំនើបកម្ម កសិកម្ម និង យន្តុ ពាណិជ្ជកម្ម កសិកម្ម ។
ទី ៣ ៖ សមាជិក សមាជិកា នៃ គណៈកម្មការ រដ្ឋ ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ក្នុង ការត្រួតពិនិត្យ វាយតម្លៃ ផ្តល់ ពិន្ទុ ឲ្យបាន សុក្រឹត្យ ប្រកបដោយ តម្លាភាព និង សច្ចភាព ។
ទី ៤ ៖ លើកទឹកចិត្ត ដល់ ក្មួយ ៗ និស្សិត គ្រប់ រូប ត្រូវ បន្ត យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការសិក្សា ស្រាវជ្រាវ បង្កើន សមត្ថភាព ទាំង ចំណេះដឹង និង ចំណេះ ធ្វើ ដើម្បី ចូលរួមចំណែក អភិវឌ្ឍន៍ វិស័យ កសិកម្ម ក្នុង បរិបទ នៃ បដិវត្តន៍ ឧស្សាហកម្ម ទី ៤ ឌីជីថល ភាវូបនីយកម្ម និង នា ពេល អនាគត ។
ទី ៥ ៖ ការធ្វើ បច្ចុប្បន្នភាព កម្មវិធី សិក្សា និង ការកសាង មន្ទីរពិសោធន៍ ឲ្យ ត្រូវ ទៅ តាម សេចក្តីត្រូវការ ទីផ្សារ ធនធាន មនុស្ស គឺជា កត្តា ចាំបាច់ បំផុត របស់ សាលា ជាតិ ។
ដូច្នេះ ត្រូវ បន្ត ពង្រឹង កិច្ចសហប្រតិបត្តិការ ជាមួយ សាកលវិទ្យាល័យ ល្បី ៗ ក្នុង តំបន់ និង លើ ពិភពលោក ដើម្បី ផ្លាស់ប្តូរ បទពិសោធន៍ និង បច្ចេកទេស វិទ្យាសាស្រ្ត សំដៅ ធ្វើ យ៉ាងណា ឲ្យ សាលា របស់ យើង ដើរ តាម ឲ្យ ទាន់ នូវ ការវិវឌ្ឍ ក្នុង បរិបទ នៃ សាកល ភាវូបនីយកម្ម ជាពិសេស សមាហរណកម្ម សហគមន៍ អាស៊ាន ៕
អភិបាល ខណ្ឌ ច្បារអំពៅ ចុះ សួរសុខទុក្ខ ចៅសង្កាត់ ព្រែក ប្រា ដែល កំពុង សម្រាក ពេទ្យ ដោយសារ ជំងឺ គ្រុន ឈាម
សូម បញ្ជាក់ ថា លោក ងិន ធី រ៉ូ ចៅសង្កាត់ ព្រែក ប្រា កំពុង សម្រាក ព្យាបាល ជំងឺ គ្រុន ឈាម នៅ មន្ទីរពេទ្យ បង្អែក មាន ជ័យ ៕
នាយក រដ្ឋមន្ត្រី ថៃ លោក ប្រាយុទ្ធ ចាន់ អូចា ប្រឈមមុខ សំនួរ ពី បក្ស ប្រឆាំង លើក ដំបូង នៅក្នុង សម័យ ប្រជុំ សភា
នៅក្នុង ការបើក សម័យ ប្រជុំ រដ្ឋសភា ថៃ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ លោក ប្រាយុទ្ធ ក្នុង នាម ជា នាយក រដ្ឋមន្ត្រី និង សមាជិក សភា ផងដែរ បាន ថ្លែង ស្វាគមន៍ អ្នកតំណាងរាស្ត្រ ទាំងអស់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ តែងតែ នឹក អ្នក ទាំងអស់ គ្នា ជានិច្ច ... » ។
ភ្លាម ៗ បន្ទាប់ពី លោក ប្រាយុទ្ធ បាន ណែនាំ ខ្លួន និង សម្តែង ការគួរសម នោះ លោក ត្រូវ ធ្វើតេស្ត ភ្លាម ៗ ដោយ សមាជិក សភា មកពី គណបក្ស ប្រឆាំង ភឿ ថៃ ដោយ បាន សួរនាំ លោក អំពី ឯកសារ គោលនយោបាយ ចំនួន ៦៦ ទំព័រ តែម្តង ។
គួរ បញ្ជាក់ ថា លោក ប្រាយុទ្ធ ចាន់ អូចា បាន ស្បថ ឡើង កាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ថៃ កាលពី ថ្ងៃទី ១៦ ខែកក្កដា ឆ្នាំ ២០១៩ ៕
ទេសរដ្ឋមន្ដ្រី គន់ គីម ដឹកនាំ កិច្ចប្រជុំ ត្រួតពិនិត្យ ការគ្រប់គ្រង គ្រោះមហន្ដរាយ នៅ ខេត្ត កំពង់ឆ្នាំង និង ប្រាប់ ឲ្យ មន្ដ្រី ត្រៀមលក្ខណៈ សង្គ្រោះ ពលរដ្ឋ ពេល មាន បញ្ហា
( កំពង់ឆ្នាំង ) ៖ នាយ ឧត្តមសេនី យ៏ គន់ គីម ទេសរដ្ឋមន្រ្តី ទទួលបន្ទុក បេសកកម្ម ពិសេស ជា អនុ ប្រធាន ទី ១ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ( គ.ជ. គ.ម ) នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង កិច្ចប្រជុំ ត្រួតពិនិត្យ លើ ការងារ គ្រប់គ្រង គ្រោះមហន្តរាយ របស់ ខេត្ត កំពង់ឆ្នាំង ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ពី លោក ឡាំ ហេង ហួត អនុ ប្រធាន គ.ជ. គ.ម និង លោក ឈួរ ច័ន្ទ ឌឿន អភិបាល ខេត្ត កំពង់ឆ្នាំង និង មន្រ្តី តាម មន្ទីរ ពាក់ព័ន្ធ កងកម្លាំងប្រដាប់អាវុធ អាជ្ញាធរ មូលដ្ឋាន និង អង្គការ ដៃគូរ អភិវឌ្ឍន៍ ទូទាំង ខេត្ត ចំនួន ៥០០ នាក់ ។
លោក អភិបាល ខេត្ត បាន បន្ថែម ថា គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ដោយ មាន ការគាំទ្រ ពី គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ សប្បុរសជន នានា ព្រម ទំាង មាន កិច្ចសហការ ជាមួយ សាខា កាកបាទ ក្រហម ខេត្ត និង កាកបាទ ក្រហម កម្ពុជា បាន រួមគ្នា ឆ្លើយតប បាន ទាន់ ពេលវេលា ដល់ គ្រួសារ រងគ្រោះ ។
បន្ទាប់ពី នាំ ការផ្តាំផ្ញើ ការសួរសុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន ដល់ អង្គ ពិធី រួច មក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ថ្លែង កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ដល់ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត និង មន្ត្រី ពាក់ព័ន្ធ គ្រប់ ថ្នាក់ ដែល បាន យកចិត្តទុកដាក់ ទាំង កម្លាំង កាយ ចិត្ត សហការ គ្នា បាន យ៉ាង ល្អ និង ឆ្លើយតប ទាន់ ពេលវេលា ក្នុង ការជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ក្នុង រយៈពេល កន្លងមក ស្រប តាម គោលនយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
អភិបាល ខេត្ត ពោធិ៍សាត់ ចុះ ដោះស្រាយ បញ្ហា បរិស្ថាន នៅ កសិដ្ឋាន ចិញ្ចឹម ទា និង ជ្រូក ជូន ប្រជាពលរដ្ឋ ក្នុង ស្រុក កណ្តៀង
( ពោធិ៍សាត់ ) ៖ អភិបាល ខេត្ត ពោធិ៍សាត់ លោក ម៉ៅ ធ និន នា ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ បាន ចុះសម្របសម្រួល ដោះស្រាយ បញ្ហា ប្រឈម ដោយ ជោគជ័យ ជូន ប្រជាពលរដ្ឋ ចំនួន ១៣ គ្រួសារ រស់ នៅ ភូមិ កំពង់ ក្រសាំង លើ ឃុំ កណ្តៀង ស្រុក កណ្តៀង ពាក់ព័ន្ធ នឹង បញ្ហា បរិស្ថាន ដែល មាន ក្លិន មិន ល្អ ចេញ ពី កសិដ្ឋាន ចិញ្ចឹម សត្វ ទា និង ជ្រូក របស់ លោកស្រី កែ ចាន់ រ៉ា ដែល បណ្តាលឲ្យ រង ផលប៉ះពាល់ ក្នុង ការរស់នៅ ប្រចាំ ថ្ងៃ របស់ ប្រជាពលរដ្ឋ ។
ក្រោយពី ចុះ សម្របសម្រួល ដោះស្រាយ ដោយ ផ្ទាល់ ពីសំណាក់ លោក អភិបាល ខេត្ត បាន ធ្វើឲ្យ ម្ចាស់ កសិដ្ឋាន យល់ព្រម ឯកភាព តាម សំណូមពរ របស់ ប្រជាពលរដ្ឋ ដោយ សុំ ពន្យា ពេល លក់ ទា ទាំង ១ ពាន់ ជាង ក្បាល នៅក្នុង កសិដ្ឋាន ឲ្យបាន មុន ១ ខែ កន្លះ ចៀសវាង ធ្វើឲ្យ មាន ក្លិន ស្អុយ ប៉ះពាល់ ដល់ អ្នកជិតខាង ។
ចំពោះ ករណី ទំនាស់ ប្តឹង ផ្តល់ នៃ ការធំ ក្លិន លាមក ទា នេះ បាន កើតមាន ជា យូរ ឆ្នាំ ណាស់ មកហើយ រហូត ទៅដល់ អំណាច ទី ៣ ឯណោះ ក៏ប៉ុន្តែ ក្រោម គោលការណ៍ ដឹកនាំ ជា លក្ខណៈ គ្រួសារ និង ក្រៅ ប្រព័ន្ធ តុលាការ របស់ លោក ម៉ៅ ធ និន បាន ធ្វើឲ្យ ភាគី ទំនាស់ ទាំង សង្ខាង យល់ស្រប បញ្ចប់ ទំនាស់ ដ៏ រ៉ាំរ៉ៃ ព្រមទាំង ដល់ ពាក្យបណ្តឹង ពី តុលាការ វិញ ចាប់ពី ពេលនេះ តទៅ ។
ក្នុង ករណី ដែល ពុំ បាន អនុវត្ត តាម កិច្ចសន្យា នៃ ការបញ្ឈប់ ការចិញ្ចឹម ទា នៅ ទីតាំង ទំនាស់ នោះ ភាគី ម្ចាស់ កសិដ្ឋាន ត្រូវ ទទួលទោស តាម ផ្លូវ ច្បាប់ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ម៉ៅ ធ និន ក៏ បាន ចែកជូន វត្ថុ កំដរ ដៃ ដល់ ប្រជាពលរដ្ឋ និង លោកគ្រូ អ្នកគ្រូ ដែល បាន ចូលរួម ក្នុង ម្នាក់ ៗ ទទួលបាន សារុង ១ និង បាន ផ្តាំផ្ញើ ឲ្យ លោកគ្រូ អ្នកគ្រូ ជាពិសេស លោក នាយក សាលា បឋមសិក្សា ហ៊ុន សែន អ៊ុម អៀប សូម ធ្វើ ការអំពាវ គៀង គរ រង ថវិកា ដើម្បី ចាក់ បំពេញ ដី ទីធ្លា សាលា ក្នុង នោះ លោក ក៏ មាន ការចូលរួមចំណែក លើ ការចាក់ ដី បំពេញ ផងដែរ ។
បន្ទាប់ពី បញ្ចប់ ការសម្របសម្រួល រួច មក លោក អភិបាល ខេត្ត បាន បន្ត ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យ ការដ្ឋាន ស្ថាបនា ស្ពាន ថ្ម ឆ្លងកាត់ ស្ទឹង មួយ កន្លែង តភ្ជាប់ ពី ភូមិ បឹង ក្រាញ់ ឃុំ ស្វាយ លួង មក ភូមិ កណ្តៀង ឃុំ កណ្តៀង ត្រូវ ចំណាយ ថវិកា ជាង ៨០ លាន រៀល ដែល ថវិកា ទាំងអស់ នោះ បាន មក តាមរយៈ ការរៀបចំ បុណ្យ ផ្កា សាមគ្គី របស់ រដ្ឋបាល ស្រុក កណ្តៀង ក្រុមការងារ ចុះ ជួយ ស្រុក ឃុំ និង ប្រជាពលរដ្ឋ នៅ ទីនោះ ៕
ក្រសួង មហាផ្ទៃ និង រដ្ឋបាល ខេត្ត ព្រះសីហនុ បើក កិច្ចប្រជុំ លើ ការងារ ពង្រឹង សន្តិសុខ សណ្តាប់ធ្នាប់ និង ការអភិវឌ្ឍ នៅក្នុង ខេត្ត
( ព្រះសីហនុ) ៖ នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ក្រសួង មហាផ្ទៃ និង រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន បើក កិច្ចប្រជុំ ស្តីពី ការផ្សព្វផ្សាយ សេចក្តីជូនដំណឹង របស់ ក្រសួង មហាផ្ទៃ ស្តីពី ការពង្រឹង សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ នៅ ខេត្ត ព្រះសីហនុ ក្រោម អធិបតីភាព លោក អ៊ុត សំអន អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ , លោក ជា ម ហ៊ីម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ ព្រមទាំង មន្រ្តី ពាក់ព័ន្ធ ជាច្រើន នាក់ ផ្សេង ទៀត ។
សេចក្តីជូនដំណឹង ក្រសួង មហាផ្ទៃ ដើម្បី គាំទ្រ ការអនុវត្ត កម្មវិធី នយោបាយ និង យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី ៤ ផែនការ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ ជាតិ គោលនយោបាយ និង កម្មវិធី កំណែទម្រង់ នានា របស់ រាជ រដ្ឋាភិបាល សម្រាប់ នីតិកាល ទី ៦ នៃ រដ្ឋសភា រាជ រដ្ឋាភិបាល សម្រេច បន្ត ចាត់តាំង ក្រុមការងារ ថ្នាក់ ជាតិ ដើម្បី ចុះ បំពេញ បេសកកម្ម តាម មូលដ្ឋាន រាជធានី - ខេត្ត សំដៅ បន្ត អនុវត្ត កម្មវិធី នយោបាយ ខាងលើ នេះ ប្រកបដោយ ប្រសិទ្ធភាព នៅ គ្រប់ មូលដ្ឋាន ទូទាំង ប្រទេស ។
សេចក្តីជូនដំណឹង ក៏ ត្រូវបាន បង្កើតឡើង ដើម្បី លើកកម្ពស់ ការផ្ដល់ សេវា ការអភិវឌ្ឍ មូលដ្ឋាន ការដោះស្រាយ បញ្ហា នានា ដើម្បី ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ។
លោក គួច ចំរើន បាន រៀបរាប់ ពី សភាពការណ៍ សន្តិសុខ សវត្ថិភាព ក្នុង ក្រុង ព្រះសីហនុ រដ្ឋបាល ខេត្ត បង្កើត ក្រុមការងារ ចុះល្បាត ជាប្រចាំ នៅពេលយប់ នៅ តាម ចំណុច ស្មុគស្មាញ មួយចំនួន ក្នុង ក្រុង ព្រះសីហនុ ដើម្បី ទប់ស្កាត់ បង្ការ បង្ក្រាប នូវ រាល់ បទល្មើស នានា កើតឡើង បាន ទាន់ ពេលវេលា ក្នុង ភូមិសាស្ត្រ ធានា សន្តិសុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ ជាតិ អន្តរជាតិ មក លេង កម្សាន្ត នៅ ខេត្ត ព្រះសីហនុ ។
ពិសេស លប់ បំបាត់ ការប្រើប្រាស់ គ្រឿងញៀន នៅ តាម ក្លិប កំសាន្ត និង កន្លែង សប្បាយ នានា និង លុបបំបាត់ ល្បែង ស៉ី សង គ្រប់ ប្រភេទ នៅ តាម មូលដ្ឋាន និង អនុវត្តន៍ នូវ គោលនយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ឱ្យ មាន ប្រសិទ្ធិភាព ខ្ពស់ ។
ជាក់ស្តែង នៅ វេលា ម៉ោង ៣ ទាប ភ្លឺ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខេត្ត ព្រះសីហនុ ដឹកនាំ ដោយ លោក គួច ចំរើន ក្រោម ការសម្របសម្រួល ពី តំណាង អយ្យការ អម សាលាដំបូង ខេត្ត បាន បើក ប្រតិបត្តិការ ចុះបង្ក្រាប ករណី ជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន នៅក្នុង ខារ៉ាអូខេ « អូប៉ា ម៉ា KTV » ។
លោក ឧត្តមសេនីយ៍ ស្នងការ បាន បញ្ជាក់ ថា មនុស្ស ទាំង ១៥០ នាក់ ដែ ល ត្រូវបាន ចាប់ខ្លួន នេះ រហូតមកដល់ ពេលនេះ សមត្ថកិច្ច ជំនាញ កំពុង ធ្វើ ការបែក ចែក ឲ្យបាន ច្បាស់លាស់ រវាង អ្នកធ្វើការ , អ្នកបម្រើ , អ្នក ចូល កម្សាន្ដ និង អ្នកប្រើប្រាស់ ចែកចាយ គ្រឿងញៀន ដើម្បី ចាត់ការបន្ដ តាម នីតិវិធី ច្បាប់ ៕
តំណាង ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ណែនាំឲ្យ សិស្សានុសិស្ស ត្រៀម ប្រឡង បាក់ឌុប ត្រូវ ខិតខំ រៀនសូត្រ ឲ្យ ចេះ ចាំ
( កណ្ដាល ) ៖ លោក កៅ ថា ច អគ្គ នាយក នៃ ធនាគារ អភិវឌ្ឍន៍ ជនបទ តំណាង លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ណែនាំឲ្យ សិស្សានុសិស្ស ថ្នាក់ ទី ១២ ដែល ត្រូវ ត្រៀម ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ( បាក់ឌុប ) ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា ត្រូវ ខិតខំ រៀនសូត្រ ស្រាវជ្រាវ នូវ មេរៀន និង រូបមន្ត សំខាន់ ៗ ដែល បាន រៀន រួចហើយ ឲ្យ ចេះ ចាំ និង យល់ បាន ល្អ ។
ការណែនាំ បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក អញ្ជើញ សំណេះសំណាល ជាមួយ សិស្សានុសិស្ស ថ្នាក់ ទី ១២ ត្រៀម ប្រឡង បាក់ឌុប នៅ វិទ្យាល័យ ហ៊ុន សែន ខ្សាច់ កណ្តាល និង វិទ្យាល័យ ហ៊ុន សែន រ៉ូតា ខ្សាច់ កណ្តាល សរុប ចំនួន ៥០៤ នាក់ និង លោកគ្រូ - អ្នកគ្រូ ទទួលបន្ទុក បំប៉ន សិស្ស ត្រៀម ចំនួន ២៨ នាក់ ។
លោក កៅ ថា ច ក៏ បាន ពាំនាំ ប្រសាសន៍ ផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ដល់ ប្អូន ៗ សិស្សានុសិស្ស និង លោកគ្រូ - អ្នកគ្រូ ពីសំណាក់ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ។
លោក កៅ ថា ច បាន ផ្តល់ អនុសាសន៍ ល្អ ៗ មួយចំនួន ដល់ ប្អូន ៗ ឲ្យ ខិតខំ រៀនសូត្រ ស្រាវជ្រាវ នូវ មេរៀន និង រូបមន្ត សំខាន់ ៗ ដែល បាន រៀន រួចហើយ ឲ្យ ចេះ ចាំ និង យល់ បាន ល្អ ដើម្បី ត្រៀមខ្លួន ប្រឡង យក សញ្ញាបត្រ ទុតិយភូមិ នៅ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០១៩ ខាងមុខ នេះ និង បាន ណែនាំ អំពី ព័ត៌មាន អាហារូបករណ៍ របស់ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន សម្រាប់ ផ្តល់ ជូន ប្អូន ៗ នៅ ស្រុក ខ្សាច់ កណ្តាល ដែល មាន សមត្ថភាព សម្រាប់ បន្ត ការសិក្សា នៅ ថ្នាក់ មហាវិទ្យាល័យ ផងដែរ ។
លោក កៅ ថា ច បាន ធ្វើ ការ ផ្តាំផ្ញើ ផងដែរ ដល់ ប្អូន ៗ ៖ * ត្រូវ ដាក់ ផែនការ និង គោលដៅ ដើម្បី ទទួលបាន ជោគជ័យ នៅ ថ្ងៃ អនាគត * បន្ត ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ និង ចៀសវាង ការប្រើប្រាស់ គ្រឿងញៀន ដែល នាំឲ្យ អន្តរាយ ដល់ ខ្លួន សង្គមជាតិ និង ក្រុមគ្រួសារ * បន្ត ចូលរួម ថែរក្សា សន្តិភាព ស្ថេរភាព និង សមិទ្ធិផល សង្គម ដែល សម្រេចបាន ដោយ ការខិតខំប្រឹងប្រែង រាជ រដ្ឋាភិបាល * ធ្វើ ខ្លួន ជា កូន ល្អ សិស្ស ល្អ និង ជា ពលរដ្ឋ ល្អ ក្នុង សង្គមជាតិ ។
ជាមួយគ្នា នេះ សម្រាប់ ស្រុក ខ្សាច់ កណ្តាល នៅ ឆ្នាំ ខាងមុខ ៗ លោក កៅ ថា ច នឹង រៀបចំ ឲ្យ មាន ការប្រកួត កីឡា មហាជន ដើម្បី ដណ្តើម ពានរង្វាន់ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន និង រៀបចំ ការប្រឡង យក សិស្ស ពូកែ ថ្នាក់ ទី ១២ ទូទាំង ស្រុក ខ្សាច់ កណ្តាល ផងដែរ ។
លោក កៅ ថា ច បាន នាំយក ប្រាក់ ឧបត្ថម្ភ របស់ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន សរុប ចំនួន ១៨,៩៨០,០០០ រៀល សម្រាប់ សិស្ស ៥០៤ នាក់ ក្នុង ម្នាក់ ចំនួន ១០,០០០ រៀល លោកគ្រូ - អ្នកគ្រូ ២៨ នាក់ ក្នុង ម្នាក់ ៗ ៨០,០០០ រៀល និង លុយ ឧបត្ថម្ភ សម្រាប់ លោកគ្រូ អ្នកគ្រូ ចូលរួម បំប៉ន សិស្ស ត្រៀម ប្រឡង មធ្យមសិក្សា ទុតិយភូមិ ចំណេះ ទូទៅ និង បំពេញ វិជ្ជា សម្រាប់ វិទ្យាល័យ ហ៊ុន សែន ខ្សាច់ កណ្តាល ៧,២០០,០០០ រៀល និង វិទ្យាល័យ ហ៊ុន សែន រ៉ូតា ខ្សាច់ កណ្តាល ៤,៥០០,០០០ រៀល ៕
អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ប្រកាស អំពាវនាវ ឱ្យ អ្នក ប្រឌិត ព័ត៌មាន អំពី មូលដ្ឋាន ទ័ព បរទេស នៅ កម្ពុជា ឱ្យ បញ្ឈប់ ជាបន្ទាន់ នូវ បំណង អាក្រក់ របស់ ពួកគេ
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ចេញ សេចក្តីប្រកាស មួយ ដោយ អំពាវនាវ ដល់ ក្រុម និង សារព័ត៌មាន ដែល ប្រឌិត ព័ត៌មាន អំពី មូលដ្ឋាន ទ័ព បរទេស នៅ កម្ពុជា ឱ្យ បញ្ឈប់ ជាបន្ទាន់ នូវ បំណង អាក្រក់ ណាមួយ ដែល មាន ចរិត បង្ក ភាពប្រទូសរ៉ាយ ចំពោះ ប្រទេស កម្ពុជា ទោះបីជា តាម រូបភាព ឬ មធ្យោបាយ ណាមួយ ក៏ដោយ ។
អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ថា ថ្មី ៗ នេះ មាន កាសែត បរទេស ខ្លះ បាន ចុះផ្សាយ អត្ថបទ បែប « ព័ត៌មាន ប្រឌិត ដ៏ អាក្រក់ បំផុត អំពី កម្ពុជា ដោយ គ្មាន មូលដ្ឋាន អ្វី ទាំងអស់ » ។
ចំណុច នេះ ត្រូវបាន ថ្នាក់ដឹកនាំ កំពូល ៗ នៃ កម្ពុជា មានប្រសាសន៍ ម្ដង ហើយ ម្ដង ទៀត ថា កម្ពុជា មិន បាន អនុញ្ញាតឱ្យ កម្លាំង បរទេស ណាមួយ បោះ ទីតាំង នៅក្នុង ទឹកដី ខ្លួន ឡើយ ។
ព័ត៌មាន បំភ្លៃ បែប អវិជ្ជមាន អំពី កម្ពុជា ដែល មាន ចរិត នយោបាយ មក លើ រាជ រដ្ឋាភិបាល កម្ពុជា មិន ទទួលយក បាន ទេ ពីសំណាក់ ថ្នាក់ដឹកនាំ និង ប្រជាជន កម្ពុជា ដែល ជា ម្ចាស់ ឆ្នោត និង ម្ចាស់ វាសនា របស់ ខ្លួន ។
ការចុះផ្សាយ ព័ត៌មាន ដែល មិន បាន ដកស្រង់ សម្ដី ពី ប្រភព ច្បាស់លាស់ មិន ត្រឹមតែ ធ្វើឱ្យ ប៉ះពាល់ ដល់ កេរ្តិ៍ឈ្មោះ ប្រទេស កម្ពុជា ប៉ុណ្ណោះ នោះ ទេ ប៉ុន្តែ វា បាន ធ្វើឱ្យ សាធារណមតិ មួយចំនួន យល់ ច្រឡំ ហើយ ថែមទាំង ធ្វើឱ្យ តម្លៃ វិជ្ជាជីវៈ និង ក្រមសីលធម៌ សារព័ត៌មាន ចុះ អន់ ថយ ផងដែរ ។
អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន រំលឹក ថា នៅ ដើម សប្តាហ៍ នេះ មាន កាសែត បរទេស បាន ចុះផ្សាយ ព័ត៌មាន ដោយ មិន ឆ្លុះបញ្ចាំង អំពី ស្ថានភាព ពិត ជាក់ស្ដែង នៅ កម្ពុជា បាន ធ្វើឱ្យ មន្រ្តី ទូត ខ្លះ មាន ការយល់ ច្រឡំ ។
អង្គភាព អ្នកនាំពាក្យ បាន បញ្ជាក់ នូវ ចំណុច មួយចំនួន ដូច ខាងក្រោម ៖ ១ ៖ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា មាន ការប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ក្នុង ការថែរក្សា សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍន៍ ។
ព្រះរាជាណាចក្រ កម្ពុជា ជា រដ្ឋ ដែល មាន អធិបតេយ្យ បូរណភាព ទឹកដី ពេញលេញ មាន រាជ រដ្ឋាភិបាល មាន អង្គ នីតិប្បញ្ញត្តិ .. . ក៏ ដូចជា ប្រជាជន ខ្លួន ដែល ជា ម្ចាស់ ជោគវាសនា ក្នុង ការថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍន៍ សម្រាប់ ប្រទេស ខ្លួន ។
កម្ពុជា គឺជា ម្ចាស់ ប្រទេស គ្រប់ ទម្រង់ ទាំងអស់ មាន នយោបាយ ជា មិត្ត ល្អ នឹង គ្នា ជាមួយ បណ្ដា ប្រទេស នានា ក្នុង ភាពជាដៃគូរ ស្មើ មុខ ស្មើ មាត់ តាមរយៈ កិច្ចសហប្រតិបត្តិការ ដើម្បី ផលប្រយោជន៍ សម្រាប់ ប្រជាជន និង ប្រទេស ខ្លួន ។
នៅក្នុង ន័យ នេះ គ្មាន ជន បរទេស ណាមួយ ត្រូវបាន អនុញ្ញាតឱ្យ ជ្រៀត ជ្រែក ឬ បង្គាប់បញ្ជា ទៅក្នុង កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា ជាដាច់ខាត ។
២ ៖ អង្គភាព អ្នកនាំពាក្យ សូម អំពាវនាវ រាល់ មិត្តភក្តិ របស់ អាស៊ាន ទាំងអស់ ក៏ ត្រូវតែ គោរព សមាជិក របស់ អាស៊ាន នីមួយ ៗ ផងដែរ តាមរយៈ កិច្ចព្រមព្រៀង ភាពជាដៃគូរ មិត្តភាព និង សហប្រតិបត្តិការ ដើម្បី ចៀសវាង ពី ការប៉ះទង្គិច ពាក្យសម្ដី ផ្នែក ការទូត ។
៣ ៖ អង្គភាព អ្នកនាំពាក្យ ក៏ សូម អះអាង និង បញ្ជាក់ សារជាថ្មី នូវ គោលជំហរ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ថា កម្ពុជា នៅតែ រក្សា សុឆន្ទៈ ក្នុង ការបន្ត និង ពង្រឹង បន្ថែម នូវ ទំនាក់ទំនង ល្អ ក្នុង ទិសដៅ កិច្ចសហប្រតិបត្តិការ ដ៏ ជិតស្និទ្ធ ជាមួយ បណ្ដា ប្រទេស នានា ក្រោម ស្មារតី រដ្ឋធម្មនុញ្ញ តែ មួយ របស់ ខ្លួន ក៏ ដូចជា ច្បាប់ ជាតិ និង អន្តរជាតិ ផ្សេង ៗ ទៀត ដើម្បី រួមចំណែក ក្នុង ការអភិវឌ្ឍន៍ និង ថែរក្សា សន្តិភាព ក្នុង តំបន់ និង ពិភពលោក សម្រាប់ មនុស្សជាតិ ទាំងមូល ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ៖
របាយការណ៍ គណៈកម្មការ ទន្លេ មេគង្គ ៖ កម្រិត កម្ពស់ ទឹក ទន្លេ មេគង្គ ឆ្នាំ នេះ ស្រកចុះ ទាប បំផុត មិន ធ្លាប់ មាន
( វៀង ច័ន្ទ ) ៖ កម្រិត កម្ពស់ ទឹក ទន្លេ មេគង្គ នៅ កំឡុង នៃ ការចាប់ផ្តើម រដូវ ជន់ លិច ដំបូង ពី ចន្លោះ ខែមិថុនា ដល់ ខែកក្កដា កំពុង ស្ថិត នៅក្នុង កម្រិត ទាប បំផុត មួយ បើ ធៀប នឹង កំណត់ត្រា នា ពេល កន្លងមក ប៉ុន្តែ ស្ថានភាព នេះ ត្រូវបាន ក្រុម អ្នកជំនាញ អះអាង ថា នឹង ប្រសើរឡើង នៅ ចុង ខែកក្កដា ។
ដោយឡែក ចំពោះ កម្រិត កម្ពស់ ទឹក នៅ តំបន់ ទន្លេ មេគង្គ ក្នុង ទីក្រុង វៀង ច័ន្ទ វិញ កម្ពស់ ទឹក នៅក្នុង ឆ្នាំ នេះ ពី ចន្លោះ ខែមិថុនា និង ខែកក្កដា ទាប ជាង កម្រិត មធ្យម រហូតដល់ទៅ ០.៧០ ម៉ែត្រ ហើយ វា ក៏ ទាប ជាង កម្រិត ដែល ទាប បំផុត នៅក្នុង កំណត់ត្រា ឆ្នាំ ១៩៩២ រហូតដល់ទៅ ១.៣៦ ម៉ែត្រ ផងដែរ បើ គិត ពី ថ្ងៃទី ១៦ ខែមិថុនា រហូតដល់ ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
នៅ ផ្នែក ខាងលើ នៃ អាង ទន្លេ មេគង្គ ក្រោម ក្នុង តំបន់ ទំនប់ ឈៀង សែន ដ៏ សំខាន់ សំខាន់ មួយ នោះ ភ្លៀង បាន ធ្លាក់ នៅ កម្រិត តិច បំផុត នៅ កំឡុង ខែមិថុនា បើ ប្រៀបធៀប ទៅនឹង តំបន់ ផ្សេង ទៀត នៅ ផ្នែក ខាងក្រោម ទន្លេ មេគង្គ ។
ប្រការ នេះ មាន ន័យ ថា វា នឹង គ្មាន ទឹក លើ ដី គ្រប់គ្រាន់ ដើម្បី ចូលរួមចំណែក ដល់ ខ្សែ ទឹក ទន្លេ មេគង្គ ឡើយ ។
ដោយ យោង តាម របាយការណ៍ របស់ MRC ដែល បង្ហាញ ពី ការខ្វះខាត ទឹក ច្រើន នៅក្នុង ឆ្នាំ នេះ , ឆ្លៀត ឱកាស នេះ អគ្គិសនី កម្ពុជា សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ មេត្តា ជួយ សន្សំ សំចៃ ក្នុង ប្រើប្រាស់ ថាមពល អគ្គិសនី ប្រចាំ ថ្ងៃ បើ ទោះបី ការកាត់ផ្តាច់ ថាមពល អគ្គិសនី មិន បាន ធ្វើឡើង ក៏ដោយ សូម បងប្អូន មេត្តា ចូលរួម ទាំងអស់ គ្នា ដើម្បី ជួយ ទប់ស្កាត់ លើ បញ្ហា ខ្វះខាត ថាមពល អគ្គិសនី នៅ ពេល ណាមួយ ៕
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ប្រាប់ អនុព័ន្ធ យោធា កូរ៉េ ខាងត្បូង ថា កម្ពុជា មិន ទទួលស្គាល់ រាល់ ការចោទប្រកាន់ ថា ផ្ដល់ ទឹកដី ឲ្យ កងទ័ព ចិន កសាង មូលដ្ឋាន កងទ័ព នោះ ឡើយ
ក្នុង ឱកាស នៃ ពិធី សំណេះសំណាល នេះ នាយ ឧត្តមសេនីយ៍ បាន គូសបញ្ជាក់ ថា ប្រទេស កម្ពុជា មាន សន្តិភាព និង មាន ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ។
ប្រទេស កម្ពុជា ប្រកាន់ របប ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស និង គោរព សិទ្ធិ មនុស្ស , អនុវត្ត ពេលវេលា បោះឆ្នោត បាន ទៀងទាត់ ហើយ កម្ពុជា ប្រកាស មិន ទទួលស្គាល់ រាល់ ការចោទប្រកាន់ ថា កម្ពុជា ផ្ដល់ ទឹកដី ឱ្យ កងទ័ព ចិន ក សាង មូលដ្ឋាន កងទ័ព នោះ គឺជា ការខុស ច្បាប់ រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន សំណូមពរ ឱ្យ មិត្ត កូរ៉េ បន្ត សហប្រតិបត្តិការ ល្អ លើ វិស័យ យោធា សហការ ល្អ ជាមួយ សាកលវិទ្យាល័យ ការពារ ជាតិ កម្ពុជា និង សាកលវិទ្យាល័យ ការពារ ជាតិ កូរ៉េ ជំរុញឱ្យ មាន ការផ្លាស់ប្ដូរ ទស្សនកិច្ច គណៈប្រតិភូ នៃ ប្រទេស យើង ទាំង ពីរ ដើម្បី ទំនាក់ទំនង ល្អ ជំរុញ ការបណ្ដុះបណ្ដាល ធនធាន មនុស្ស ដល់ កងយោធពល ខេមរភូមិន្ទ និង ជួយ ឧបត្ថម្ភ សម្ភារ បម្រើ ឱ្យ កងទ័ព ទាំង ក្នុង កិច្ច ប្រតិបត្តិការ សង្គ្រោះ និង ជំនួយ មនុស្សធម៌ ៕
ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង ចុះ សួរសុខទុក្ខ សមាជិក អាវុធហត្ថ រាជធានី ភ្នំពេញ នៅ មន្ទីរពេទ្យ កាល់ម៉ែត
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង នៅ រសៀល ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ បាន ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ សមាជិក អាវុធហត្ថ ម្នាក់ ផ្សេង ទៀត នៅ មន្ទីរពេទ្យ កាល់ម៉ែត បន្ទាប់ពី បាន ចុះ សួរសុខទុក្ខ លោក វរសេនីយ៍ ត្រី ញៀប សាផ ន មេបញ្ជាការ រង មូលដ្ឋាន អាវុធហត្ថ ខណ្ឌ ចំការ មន មុន គ្នា មួយ ថ្ងៃ នៅក្នុង ភូមិ ១ សង្កាត់ ចោម ចៅ ខណ្ឌ ពោធិ៍ សែន ជ័យ រាជធានី ភ្នំពេញ ។
សមាជិក អាវុធហត្ថ រាជធានី ភ្នំពេញ ដែល លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ គឺ អនុ សេនីយ៍ ត្រី មាស សំរាំង មេបញ្ជាការ រង កង អនុ សេនា តូច ទី ២ នៃ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ដែល បាន ជួប គ្រោះថ្នាក់ ចរាចរណ៍ របួស ធ្ងន់ធ្ងរ រហូត ផុង លលា ក្បាល កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ កាល់ម៉ែត ។
លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន សម្តែង ការថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោក សាស្ត្រាចារ្យ ឈាង រ៉ា ដែល បាន ចាត់ចែង ក្រុម គ្រូពេទ្យ យកចិត្តទុកដាក់ ព្យាបាល អ្នកជំងឺ យ៉ាង ដិតដល់ ព្រមទាំង បាន សម្រាល បន្ទុក ចំណាយ លើ ការសម្រាក ព្យាបាល ឲ្យ នៅ ត្រឹមតែ ៥០ ភាគរយ នេះ ។
( ភ្នំពេញ ) ៖ អាជ្ញាធរ និង មន្រ្តី ជំនាញ ខណ្ឌ ជ្រោយ ចង្វារ ក្រោម ការបញ្ជា របស់ លោក ឃ្លាំង ហួត អភិបាល ខណ្ឌ ជ្រោយ ចង្វារ នៅ រសៀល ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ បាន ចុះ ទៅ វាស់វែង បាញ់ ថ្នាំ កំណត់ ផ្លូវ ទំហំ ទទឹង ២០ ម៉ែត្រ ទៅ តាម ប្លង់ មេ របស់ សាលា រាជធានី ភ្នំពេញ នៅ ត្រង់ ចំណុច ដី ឧកញ៉ា ជា រិទ្ធី ដែល ត្រូវបាន អ្នកជិតខាង និង ប្រជាពលរដ្ឋ នៅ តំបន់ នោះ បាន ប្តឹង ថា ឧកញ៉ា រូប នេះ បាន ចាក់ ស៊ីម៉ង តិ៍ បណ្តុះ គ្រឹះ ធ្វើជា ព្រំ រំលោភ យក ដី ផ្លូវ សាធារណៈ ប្រមាណ ៣ ទៅ ៤ ម៉ែត្រ ធ្វើជា កម្មសិទ្ធិ ។
ការចុះ ទៅ វាស វែង កំណត់ ផ្លូវ នេះ ដឹកនាំ ដោយ លោក ឡេង រ៉ា វង្ស អភិបាល រង ខណ្ឌ ជ្រោយ ចង្វារ ហើយក៏ មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ផងដែរ ។
ដោយឡែក ឧកញ៉ា ជា រិទ្ធី ដែល រំលោភ យក ដី សាធារណៈ នោះ មិន មាន វត្តមាន នោះ ឡើយ គ្រាន់តែ បញ្ជូន មេធាវី ទៅ ចូលរួម និង ស្រែក ឡូឡា ដាក់ មន្រ្តី អាជ្ញាធរ និង មន្រ្តី ជំនាញ តែ ប៉ុណ្ណោះ ។
ចំណែក ប្រជាពលរដ្ឋ វិញ ពិតជា សប្បាយចិត្ត យ៉ាង ខ្លាំង ព្រោះ នេះ ជា គម្រោង ពង្រីក ផ្លូវ នៅពេល អនាគត ។
លោក ឡេង រ៉ា វង្ស បាន ឲ្យដឹង ថា ការចុះ មក វាស់វែង នៅ ពេល នេះ ធ្វើឡើង តាម ការណែនាំ របស់ លោក ឃ្លាំង ហួត អភិបាល ខណ្ឌ ជ្រោយ ចង្វារ ដើម្បី កំណត់ ព្រំ និង អក្សរ ផ្លូវ ទៅ តាម ប្លង់ មេ របស់ សាលា រាជធានី ភ្នំពេញ ។
ទោះបីជា យ៉ាងណា ក៏ដោយ ប្រជាពលរដ្ឋ ក៏ ទទូច សុំ អាជ្ញាធរ មេត្តា ជួយ អន្តរាគមន៍ ទៅ លោក ឧកញ៉ា យក ដុំ ថ្ម ចេញ ពី ទ្រូង ផង កុំ ទុក លើ ផ្លូវ បែប នេះ រាប់ ខែ អាច បង្កឲ្យ កើតមាន គ្រោះថ្នាក់ ព្រោះ ពេលនេះ ផ្លូវ បាន កំណត់ ហើយ ។
សូម បញ្ជាក់ ថា លោក ឧកញ៉ា ជា រិទ្ធី បន្ទាប់ពី យក ដុំ ថ្ម មក គរ តម្រៀប លើ ទ្រូងផ្លូវ សាធារណៈ របស់ រដ្ឋ ជាយូរ មកហើយ នោះ និង ក្រោយមក បាន ចាប់ផ្ដើម ចាក់ ស៊ីម៉ង់តិ៍ បណ្ដុះ បង្គោល ថ្ម លើ ទ្រូងផ្លូវ ធ្វើជា ព្រុំ កម្មសិទ្ធិ ផ្ទាល់ខ្លួន ហើយ ។
ដោយសារតែ ឃើញ ទង្វើ របស់ លោក ឧកញ៉ា ជា រិទ្ធី កំពុងតែ រំលោភ យក ផ្លូវ សាធារណៈ បែប នេះ បាន ធ្វើឲ្យ ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ ព្រែក តា គង់ ទាំងមូល កំពុង មាន ការព្រួយបារម្ភ យ៉ាង ខ្លាំង អំពី ការបាត់បង់ ផ្លូវ សាធារណៈ កាន់តែ តូច ចង្អៀត ជាង នេះ ទៀត ក្រោយ លោក ឧកញ៉ា រូប នោះ បាន ចាប់ផ្តើម វាទ ព្រុំ ដី ចេញមក ក្រៅ របង ដី របស់ ខ្លួន ប្រហែល ៤ ទៅ ៥ ម៉ែត្រ ចូលមក លើ ទ្រូង សាធារណៈ បែប នេះ នោះ ។
មិន តែ ប៉ុណ្ណោះ អាជ្ញាធរ ខណ្ឌ ជ្រោយ ចង្វារ ក៏ បាន ណាត់ ភាគី ទំនាស់ ទាំង សងខាង នោះ ទៅ សួរនាំ នៅ សាលា ខណ្ឌ ធ្វើជា កំណត់ហេតុ តម្កល់ ទុក ផងដែរ កាលពី ដើម ខែមេសា ឆ្នាំ ២០១៩ ។
បើ ទោះ ពី មាន ការហៅ ទៅ សួរនាំ និង ធ្វើ កំណត់ របស់ អាជ្ញាធរ ក៏ដោយ តែ ឧកញ៉ា ជា រិទ្ធី មិន ត្រឹមតែ ដក ចេញ វិញ នោះ ទេ គឺ ថែមទាំង យក ដែក ថ្នាំង អំពៅ មក បោះ ក្នុង គោលបំណង កំណត់ ព្រុំ ដី របស់ គាត់ ចេញ ខាងក្រៅ របង ដី របស់ គាត់ ប្រហែលជា ៤ ទៅ ៥ ម៉ែត្រ រហូតមកដល់ ពេលនេះ ស្រាប់តែ ឧកញ៉ា ចាប់ផ្តើម ចាក់ បេតុង បណ្តុះ បង្គោល ថ្ម ចេញ ខាងក្រៅ របង ដី របស់ គាត់ ក្នុង គោលបំណង វា ទ របង ចេញ ក្រៅ ធ្វើឲ្យ ប៉ះពាល់ ទ្រូងផ្លូវ សាធារណៈ កាន់តែ តូច ចង្អៀត ទៀត ។
ផ្លូវ មួយ ខ្សែ នោះ មុនដំបូង ត្រូវបាន ប្រជាពលរដ្ឋ និង អាជ្ញាធរ សង្កាត់ ដែល មាន លោក អឿ ស៊ី ផុន ជា ចៅសង្កាត់ បាន ផ្ដួច ផ្ដើម សម គំនិត បង្កើត បើក ផ្លូវ នោះ ឡើង ។
ក្រៅពី ការស្នើសុំ ទៅ អភិបាល ខណ្ឌ នោះ ប្រជាពលរដ្ឋ ក៏ ទទូច ស្នើ ទៅ លោក ឃួង ស្រេង អភិបាល នៃ គណៈអភិបាល រាជធានី ភ្នំពេញ ជួយ មាន វិធានការណ៍ ចំពោះ លោក ឧកញ៉ា រូប នោះ ផង ដើម្បី បញ្ឈប់ សកម្មភាព រំលោភ ដី របស់ រដ្ឋ តទៅទៀត ៕
ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី ២ រៀបចំ វេទិការ ថ្នាក់ ស្រុក ពង្រឹង ការអនុវត្ត តួនាទី ភារកិច្ច របស់ ក្រុមប្រឹក្សា ឃុំ សម្រាប់ បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ នៅ ខេត្ត ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី ២ បាន រៀបចំ វេទិកា ថ្នាក់ ស្រុក ស្តីពី ការឈ្វេងយល់ និង ប្រមូល ព័ត៌មាន លើ ការងារ អនុវត្ត តួនាទី ភារកិច្ច ក្រុមប្រឹក្សា ឃុំ និង ការផ្តល់ សេវា សាធាណៈ ជូន ប្រជាពលរដ្ឋ នៅ ខេត្ត ត្បូងឃ្មុំ ។
ពិធី នេះ ធ្វើឡើង ដោយ មាន ការចូលរួម ពី លោក អ៊ុក ប៊ុន ឈឿន ប្រធាន ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី ២ នៅ សាលា ស្រុក អូរ រាំង ឪ និង សាលា ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ និង ប្រធាន សមាគម ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ សមាជិក សមាជិកា ក្រុមប្រឹក្សា ឃុំ ស្មៀន ឃុំ នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ឃុំ មកពី ស្រុក អូរ រាំង ឪ និង ស្រុក ពញា ក្រែក សរុប ចំនួន ១៨៨ នាក់ ទៀត ។
ដោយឡែក នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី ២ ដដែល ដែល ដឹកនាំ ដោយ លោក អ៊ុក ប៊ុន ឈឿន ប្រធាន ក្រុម បាន ជួបប្រជុំ ពិភាក្សា ជាមួយ នឹង អាជ្ញាធរ ខេត្ត ត្បូងឃ្មុំ និង មន្ទីរ ពាក់ព័ន្ធ ទាំងអស់ ដើម្បី សិក្សា ឈ្វេងយល់ និង នាំយក នូវ មតិ យោបល់ និង សំណូមពរ របស់ ក្រុមប្រឹក្សា ឃុំ ក្នុង ស្រុក អូរ រាំង ឪ និង ស្រុក ពញា ក្រែក ដើម្បី ពិភាក្សា និង រក ដំណោះស្រាយ ដើម្បី ឆ្លើយតប នឹង សំណូមពរ និង សេចក្តីត្រូវការ របស់ ប្រជាពលរដ្ឋ ។
ជាមួយគ្នា នោះ លោក ជា ម ច័ន្ទ សោភ័ន អភិបាល ខេត្ត ត្បួង ឃ្មុំ បាន ស្វាគមន៍ និង ថ្លែងអំណរគុណ ដល់ ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូម ភាគ ទី ២ ដែល បាន ចុះ ជួប ពិភាក្សា និង ប្រមូល ព័ត៌មាន បញ្ហា ប្រឈម និង សំណូមពរ ដែល បាន លើកឡើង ក្នុង នាម តំណាង ប្រជាពលរដ្ឋ ដើម្បី ជា មូលដ្ឋាន ព័ត៌មាន បន្ថែម ទៀត ដើម្បី ខេត្ត ធ្វើ ការបន្ត ដោះស្រាយ ជូន ប្រជាពលរដ្ឋ ។
លោក បាន ជម្រាប ជូន គណៈប្រតិភូ ថា បញ្ហា ប្រឈម និង សំណូមពរ នានា ដែល អង្គ វេទិកា បាន រកឃើញ អាជ្ញាធរ ខេត្ត គ្រប់ លំដាប់ថ្នាក់ បាន ខិតខំ ប្រឹងប្រែង រួមគ្នា ដោះស្រាយ បាន មួយចំនួន ហើយ បញ្ហា ដែល នៅ សេសសល់ ខេត្ត នឹង បន្ត ខិតខំ ដោះស្រាយ បន្ថែម ទៀត ។
ចំពោះ បញ្ហា មួយចំនួន ដែល អាជ្ញាធរ ខេត្ត មិន អាច ដោះស្រាយ បាន លោក ជា ម ចន្ទ សោភ័ន បាន សំណូមពរ ដល់ គណៈប្រតិភូ ជួយ អន្តរាគមន៍ ទៅ ស្ថាប័ន ពាក់ព័ន្ធ ដើម្បី រួមគ្នា ដោះស្រាយ ។
ក្នុង នាម ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី ២ លោក អ៊ុក ប៊ុន ឈឿន បាន ផ្តល់ អនុសាសន៍ មួយចំនួន ដល់ អាជ្ញាធរ ខេត្ត ត្រូវ ចូលរួម ធ្វើ ការដោះស្រាយ បញ្ហា ប្រឈម នានា ទាំងឡាយ ដែល អាជ្ញាធរ ថ្នាក់ មូលដ្ឋាន បាន លើកឡើង និង ទាមទារ ឱ្យ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ និង ផ្នែក ពាក់ព័ន្ធ ត្រូវ ចូលរួម ដោះស្រាយ ជាមួយគ្នា ផងដែរ ដើម្បី ឆ្លើយតប តាម សំណូមពរ និង តំរូវការ របស់ ប្រជាពលរដ្ឋ និង ខេត្ត មាន ការអភិវឌ្ឍន៍ កាន់តែ ល្អ ប្រសើរឡើង ។
ចំពោះ បញ្ហា ប្រឈម និង សូម ណូមពរ នានា ដែល អាជ្ញាធរ ខេត្ត ពុំ អាច ដោះស្រាយ បាន ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី ២ នឹង រាយការណ៍ ជូន ថ្នាក់ដឹកនាំ ព្រឹទ្ធសភា និង គណៈកម្មាធិការ អចិន្រ្តៃយ៍ ព្រឹទ្ធសភា ដើម្បី លើក អនុសាសន៍ ជម្រាប ដល់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ រួមគ្នា ធ្វើ ការដោះស្រាយ ៕
ស្ថានភាព ជំងឺ គ្រុន ឈាម នេះ បើ ប្រៀបធៀប នឹង សប្ដាហ៍ កន្លងមក មាន ការធ្លាក់ចុះ បន្ដិច ជិត ៣០០ ករណី ។
តែ ទោះជា មាន ការធ្លាក់ចុះ ក៏ដោយ ក៏ មន្ដ្រី សុខាភិបាល ទាំងអស់ នៅតែ បន្ដ ខិតខំ ប្រឹងប្រែង បន្ថែម ទៀត ដើម្បី អង្កេត តាមដាន គ្រប់គ្រង ស្ថានភាព ជំងឺ ដោយ ការចុះ អប់រំ សុខភាព ប្រជាពលរដ្ឋ ជា បន្ដ បន្ទាប់ ទៀត » ។
ជាង នេះ ទៅ ទៀត លោក វេជ្ជបណ្ឌិត បន្ដ ថា « យើង បន្ដ ពង្រឹង ការធ្វើ សកម្មភាព លុបបំបាត់ ជម្រក ដង្កូវ ទឹក មូស ខ្លា ដែល មាន នៅ តាម កន្លែង ដក់ ទឹក ថ្លា ដោយ ត្រូវ បន្ដ ធ្វើ យុទ្ធនាការ លុបបំបាត់ ជម្រក ទឹក ដក់ ថ្លា ទាំងអស់ ជាពិសេស រាល់ វត្ថុ ដក់ ទឹក មិន ប្រើប្រាស់ ដែល ជា បញ្ហា ចម្បង ។
ប៉ុន្ដែ ពួកយើង បាន ដាក់ ថ្នាំ សម្លាប់ ដង្កូវ ទឹក និង បាញ់ ថ្នាំ មូស រួចរាល់ អស់ ហើយ » ។
ក៏ប៉ុន្ដែ ប្រសិនបើ រាល់ ប្រភព ដែល ជា កន្លែង ដក់ ទឹក ទាំងអស់ នោះ មិន កម្ទេចចោល វា នឹង អាច កើតឡើងវិញ ផងដែរ ។
ដូច្នេះ សូម អំពាវនាវ ដល់ អាជ្ញាធរ មូលដ្ឋាន ជួយ ជំរុញ ឱ្យ ប្រជាជន គ្រប់ រូប ចូលរួម ធ្វើ អនាម័យ ក្នុង និង ជុំវិញ គេហដ្ឋាន របស់ ខ្លួន និង លុបបំបាត់ រាល់ ប្រភព និង ជម្រក ដែល ដក់ ទឹក ថ្លា ដែល ជម្រក ទឹក មូស ខ្លា ពង បាន កើតឡើងវិញ ជាក់ ជា មិន ខាន ។
យើង រួមគ្នា លុបបំបាត់ ជម្រក មូស ខ្លា នៅក្នុង សហគមន៍ របស់ យើង ដើម្បី រួមចំណែក ទប់ស្កាត់ ការចម្លង ជំងឺ គ្រុនឈាម ។
( វ៉ាស៊ីនតោន ) ៖ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ នា ថ្ងៃពុធ សប្តាហ៍ នេះ បាន ប្រើ អំណាច វ៉េតូចំពោះ សេចក្តីសម្រេច ចំនួន ០៣ របស់ សភា អាមេរិក ដែល មាន គោលដៅ រាំង ខ្ទប់ កិច្ចប្រឹងប្រែង របស់ រដ្ឋបាល លោក ក្នុង ការលក់ សព្វាវុធ សរុប តម្លៃ ជាង ៨ ពាន់ លាន ដុល្លារ ទៅឲ្យ បណ្តា ប្រទេស អារ៉ាប់ ដែល ជា សម្ព័ន្ធមិត្ត របស់ ខ្លួន ។
យោង តាម សេតវិមាន ដែល បាន ប្រកាស ពី ការប្រើ អំណាច វ៉េតូ របស់ លោក ត្រាំ សេចក្តីសម្រេច ទាំង ០៣ នោះ នឹង ធ្វើឲ្យ ចុះខ្សោយ សមត្ថភាព ប្រកួតប្រជែង របស់ សហរដ្ឋ អាមេរិក នៅលើ ឆាក អន្តរជាតិ ព្រមទាំង បំផ្លាញ ទំនាក់ទំនង ជាមួយ សម្ព័ន្ធមិត្ត និង ដៃគូ របស់ ទីក្រុង វ៉ាស៊ីនតោន ថែម ទៀត ។
សេចក្តីសម្រេច ខាងលើ ត្រូវបាន អនុម័ត ដោយ សភា តំណាងរាស្រ្ត អាមេរិក កាលពី សប្តាហ៍ មុន បន្ទាប់ពី ព្រឹទ្ធសភា អាមេរិក បាន អនុម័ត ពួកវា កាលពី ខែមិថុនា ដែល មាន គោលដៅ រារាំង កញ្ចប់ ចំនួន ០៣ ក្នុង ចំណោម ការលក់ សព្វាវុធ សរុប ទាំង ២២ កញ្ចប់ ដែល អាមេរិក គ្រោង លក់ ឲ្យ អារ៉ាប៊ី សាអូឌីត អេមីរ៉ាត់ អារ៉ាប់ រួម និង ហ្សក ដានី ។
ចាប់តាំងពី ឡើង កាន់អំណាច មក វា គឺជា លើក ទី បី ហើយ ដែល លោក ដូណាល់ ត្រាំ បាន ប្រើ អំណាច វ៉េតូ របស់ ប្រធានាធិបតី អាមេរិក ។
ដោយឡែក ក្រោយពី ត្រូវបាន លោក ត្រាំ ទាត់ ចោល បែប នេះ សភា អាមេរិក ក៏ ពុំ មាន សង្ឃឹម ថា នឹង ទទួលបាន សំឡេង គាំទ្រ គ្រប់គ្រាន់ ដើម្បី លុបចោល អំណាច វ៉េតូវិញ ដែរ ។
ប៉ុន្តែ សេចក្តីសម្រេច ស្រដៀង គ្នា អាចនឹង កើតមាន ថែម ទៀត សម្រាប់ កញ្ចប់ លក់ សព្វាវុធ ដែល នៅ សេសសល់ ទាំង ប៉ុន្មាន ខណៈ លោក ត្រាំ ច្បាស់ជា នឹង បន្ត វ៉េតូដដែល ។
យ៉ាងណាមិញ កាលពី ខែឧសភា តាមរយៈ ការសំអាង លើ ហេតុផល ថា មាន ភាពតានតឹង បាន កើនឡើង កម្តៅ ខ្លាំង ជាមួយ អ៊ីរ៉ង់ លោក ត្រាំ បាន ប្រើ ចំណុច ចន្លោះប្រហោង មួយ នៅក្នុង ច្បាប់ គ្រប់គ្រង ការលក់ សព្វាវុធ របស់ អាមេរិក ដើម្បី សម្រេច ផែនការ លក់ អាវុធ ខាងលើ ដែល មាន តម្លៃ សរុប ៨. ‌ ១ ពាន់ លាន ដុល្លារ ដោយ មិន ចាំបាច់ មាន ការយល់ព្រម ពី សភា អាមេរិក ៕
បើ តាម លោក ផៃ ស៊ីផាន អាស៊ាន បាន រួមគ្នា មិន ឲ្យ ទ័ព បរទេស មក លុកលុយ នោះ ក្នុង តំបន់ នោះ ទេ ហើយ កម្ពុជា ខ្លួនឯង ផ្ទាល់ បាន អនុវត្ត តាម គោលការណ៍ នេះ បាន យ៉ាង ខ្ជាប់ខ្ជួន ៕
សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប និង សមាគម ចំនួន ៣ ផ្ដល់ សម្ភារៈ សិក្សា ដល់ សិស្ស ក្រីក្រ នៅ ស្រុក បសេដ្ឋ ខេត្ត កំពង់ស្ពឺ
( ភ្នំពេញ ) ៖ គណៈ គ្រប់គ្រង នៃ សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប រួម នឹង សមាគម ៣ ទៀត ដឹកនាំ ដោយ លោក សាស្ត្រាចារ្យ បណ្ឌិត ទ្រី ចាន់ ធុច ព្រឹទ្ធ បុរស សាលា ក្រោយ ឧត្តម នៃ សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប និង ជា ប្រធាន សមាគម អប់រំ អូវ៉ឺស៊ី កម្ពុជា ថ្មី ៗ នេះ បាន នាំយក អំណោយ សម្ភារៈ សិក្សា និង ថវិកា ១ ចំនួន ទៅ ចែកជូន សិស្សានុសិស្ស ក្រីក្រ ចំនួន ៦០៩ នាក់ នៃ សាលា បឋមសិក្សា អង្គ តា ផល និង សាលា បឋមសិក្សា ព្រៃ ត្បែង ស្ថិត ក្នុង ឃុំ កក់ ស្រុក បរសេដ្ឋ ខេត្ត កំពង់ស្ពឺ ។
លោក បាន ចាត់ទុក ថា ជំនួយ ឧបត្ថម្ភ នា ពេលនេះ ជា ការជួយ សម្រួល ការលំបាក ផង និង ជា ការលើកទឹកចិត្ត ដល់ សិស្សានុសិស្ស នៅ ទីនោះ ឲ្យ ខិតខំ ប្រឹងប្រែង រៀនសូត្រ បង្កើន ចំណេះដឹង ដើម្បី រួមចំណែក ក្នុង ការអភិវឌ្ឍ សង្គម ជាតិ ឆ្ពោះ ទៅ កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ ផងដែរ ។
សូមឲ្យ សិស្សានុស្សិស្ស ទាំងអស់ ត្រូវ ខិតខំ រៀនសូត្រ ចាប់ពី ថ្នាក់ ដំបូង រហូតដល់ វិទ្យាល័យ និង បន្ត ទៅ សាកលវិទ្យាល័យ ទៀត ឲ្យបាន គ្រប់ គ្នា ព្រោះថា ការអប់រំ មនុស្ស ត្រូវការ ពេលវេលា យូរអង្វែង ទើប សម្រេច គោលដៅ ។
លោក សាស្ត្រាចារ្យ បណ្ឌិត បាន ពន្យល់ ថា មាន តែ ការសិក្សា រៀនសូត្រ ប៉ុណ្ណោះ ដែល ជួយ ខ្លួន យើង ឲ្យ ចេញ ផុត ពី ភាពល្ងង់ខ្លៅ និង ទទួលបាន នូវ ភាពថ្កុំថ្កើង រុងរឿង ។
ដូចនេះ សូម ក្មួយ ៗ ខិតខំប្រឹងប្រែង រៀនសូត្រ ក្រេប យក ចំណេះដឹង ត្រូវ ហាត់ ពុត លត់ ដំខ្លួន ដើម្បី ក្លាយជា ពលរដ្ឋ ប្រកបដោយ សមត្ថភាព ជា សរសរ ទ្រូង ដ៏ រឹងមាំ របស់ ប្រទេសជាតិ នៅ ថ្ងៃ អនាគត ។
លោក សាស្ត្រាចារ្យ បណ្ឌិត ទ្រី ចាន់ ធុច ព្រឹទ្ធ បុរស សាលា ក្រោយ ឧត្តម នៃ សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប និង ជា ប្រធាន សមាគម អប់រំ អូវ៉ឺស៊ី កម្ពុជា បាន ថ្លែងអំណរគុណ ផងដែរ ចំពោះ គណៈប្រតិភូ សមាគម គីវ៉ានីស៍ តៃវ៉ាន់ និង សមាគម គីវ៉ានីស៍ កម្ពុជា ដែល បាន រួមគ្នា បង្កើត កម្មវិធី កម្លាំង មនុស្សធម៌ នេះ ឡើង ដើម្បី ចូលរួមចំណែក លើកកម្ពស់ ការអប់រំ នៅ កម្ពុជា ឱ្យ កាន់តែ ប្រសើរឡើង ជាពិសេស កម្រិត បឋមសិក្សា ស្រប តាម គោលនយោបាយ យុទ្ធសាស្ត្រ ចតុកោណ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ដោយឡែក គណៈ គ្រប់គ្រង សាលា លោកគ្រូ អ្នកគ្រូ ចំនួន ៤០ នាក់ ក្នុង ម្នាក់ ទទួលបាន ចំនួន ២ ម៉ឺន រៀល ។
ជាមួយនឹង អំណោយ សម្ភារៈ សិក្សា ក្មួយ ៗ សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ ក៏ ទទួលបាន នូវ អាហារ សាមគ្គី ១ ពេល ផងដែរ ៕
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ អនុញ្ញាតឲ្យ ក្រុម អ្នកសារព័ត៌មាន ពិនិត្យមើល មូលដ្ឋាន កងទ័ព ជើងទឹក រាម ដើម្បី បំភ្លឺ ភ្នែក សារព័ត៌មាន អាមេរិក
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ការពារ ជាតិ បាន អនុញ្ញាតឲ្យ ក្រុម អ្នកសារព័ត៌មាន ចុះ ពិនិត្យមើល មូលដ្ឋាន កងទ័ព ជើងទឹក រាម ក្នុង ខេត្ត ព្រះសីហនុ ដើម្បី បំភ្លឺ ចំពោះ ការប្រឌិត ព័ត៌មាន របស់ សារព័ត៌មាន បរទេស កន្លងមក ។
នេះ បើ តាម នាយ ឧត្តមសេនីយ៍ ឈុំ សុជាត អ្នកនាំពាក្យ ក្រសួង ការពារ ជាតិ កម្ពុជា ។
ការអះអាង នេះ បាន ធ្វើឡើង នៅក្នុង សន្និសីទ សារព័ត៌មាន នៅ ទីស្តីការ គណៈ រដ្ឋមន្រ្តី ដែល រៀបចំឡើង ដោយ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នា ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ឲ្យដឹង ថា សុខភាព របស់ សម្ដេច គឺ រឹងមាំ ធម្មតា ហើយ ស្អែក សម្ដេច នឹង ជួប ភ្ញៀវ មកពី មូលនិធិ អន្ដរជាតិ សម្រាប់ អភិវឌ្ឍន៍ កសិកម្ម នៅ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី ។
ស្អែក នេះ ខ្ញុំ ជួប ភ្ញៀវ មក ពី មូលនិធិ អន្ត ជាតិ សម្រាប់ អភិវឌ្ឍន៍ កសិកម្ម នៅ ទីស្តីការ ។
អរគុណ បងប្អូន ដែល បាន ជូន ពរ ខ្ញុំ ។
ខ្ញុំ សូម ជូនពរ និង អរគុណ បងប្អូន ដែល បាន ចូលរួម ថែរក្សា សន្តិភាព និង ចូលរួម អភិវឌ្ឍ ប្រទេសជាតិ យើង អោយ កាន់តែ រីកចម្រើន ទៅ មុខ »៕
ការបញ្ជាក់ របស់ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បញ្ជាក់ បែប នេះ នៅក្នុង សន្និសីទ សារព័ត៌មាន នៅ ទីស្តីការ គណៈ រដ្ឋមន្រ្តី ដែល រៀបចំឡើង ដោយ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នា ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
កិច្ចព្រមព្រៀង នោះ គឺ កម្ពុជា ផ្តល់ឲ្យ ភាគី ចិន នូវ សិទ្ធិ ផ្តាច់ មុខ ធ្វើជា មូលដ្ឋាន ទាហាន ជើង ទឹក ចិន ជា ផ្នែក មួយ នៅ ឈូង សមុទ្រ ខ្មែរ ហើយ នៅជិត ព្រលានយន្តហោះ ធំ មួយ ដែល កសាង ដោយ ចិន នឹង អនុញ្ញាតឲ្យ ចិន ប្រើ ជា មូលដ្ឋាន យោធា រយៈពេល ៣០ ឆ្នាំ ដាក់ ទ័ព ដាក់ គ្រឿង សព្វាវុធ កន្លែង ចត ជាដើម » ។
ការផ្សព្វផ្សាយ ព័ត៌មាន គ្មាន មូលដ្ឋាន នេះ ធ្វើឱ្យ មាន ប្រតិកម្ម យ៉ាង ខ្លាំង ពី ប្រមុខ រាជ រដ្ឋាភិបាល ប្រមុខ ក្រសួង ការពារ ជាតិ និង ក្រសួង ការពារ ជាតិ ចិន ៕
ប្រាសាក់បញ្ចុះ អត្រា ការប្រាក់ ឥណទាន ប្រាក់ រៀល ដើម្បី ចូលរួម ការរីកចម្រើន របស់ អតិថិជន
លោក សាយ សូនី នាយក ប្រតិបត្តិ របស់ ប្រាសាក់ បាន ថ្លែង ថា ប្រាសាក់ បាន នាំយក ដំណោះស្រាយ ហិរញ្ញវត្ថុ ដ៏ ល្អ ប្រពៃ សម្រាប់ អតិថិជន តាមរយៈ ការផ្តល់ ទំហំ ឥណទាន ជា ប្រាក់ រៀល កាន់តែ ធំ ជាង មុន រយៈពេល ខ្ចី កាន់តែ វែង ជាង មុន និង អត្រា ការប្រាក់ កាន់តែ ពិសេស ជាង មុន ដើម្បី ជួយ សម្រួល ដល់ អតិថិជន ក្នុង ការប្រើប្រាស់ ប្រាក់ រៀល សម្រាប់ ប្រកប អាជីវកម្ម កសិកម្ម និង មុខរបរ ផ្សេង ៗ ។
លោក សូនី បន្ត ទៀត ថា « ប្រាសាក់ នៅតែ បន្ត ពង្រីក វិសាលភាព និង លើកកម្ពស់ ប្រាក់ រៀល ខ្មែរ យើង ឱ្យ កាន់តែ ទូលំទូលាយ បន្ថែម ទៀត ជាមួយនឹង ទំហំ កម្ចី រហូតដល់ ២ ពាន់ លាន រៀល រយៈពេល កម្ចី រហូតដល់ ១២០ ខែ អត្រា ការប្រាក់ ទាប ជាង មុន និង របៀប សង ត្រលប់ សមស្រប តាម លំហូរ សាច់ប្រាក់ របស់ អតិថិជន ដើម្បី ចូលរួម ធ្វើឱ្យ ជីវភាព រស់ នៅ របស់ អតិថិជន ឱ្យ កាន់តែ ប្រសើរ និង តប តាម តម្រូវការ របស់ អតិថិជន » ។
ក្រៅពី សេវា ឥណទាន ប្រាសាក់ ផ្ដល់ សេវា ហិរញ្ញវត្ថុ យ៉ាង សម្បូរបែប ដូចជា ប្រាក់ បញ្ញើ សន្សំ ផ្ទេរ ប្រាក់ ផ្ទេរ ប្រាក់ ទៅ អ្នក គ្មាន គណនី ប្ដូរ ប្រាក់ សេវា ធនាគារ ចល័ត អេធី អឹម ទិញ កាត ទូរស័ព្ទ ទូទាត់ វិក្កយបត្រ ទឹក - ភ្លើង សេវា បើក ប្រាក់ បៀវត្ស និង សេវា ផ្សេង ៗ ជាច្រើន ទៀត ៕
រយៈពេល នៃ កិច្ចសហការ នេះ គឺ គិត ចាប់ពី ខែមិថុនា ឆ្នាំ នេះ រហូតដល់ ចុង ខែកញ្ញា ឆ្នាំ ២០២១ ។
ម៉ាឌូរ៉ូ៖ ករណី ដាច់ ភ្លើង នៅ វេណេស៊ុយអេឡា ជា ស្នាដៃ របស់ សហរដ្ឋ អាមេរិក ...
នេះ បើ យោង តាម សារព័ត៌មាន ស៊ិន ហួរ ចុះផ្សាយ នា ព្រឹក ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
លោក ម៉ាឌូរ៉ូ បាន ធ្វើការកត់សំគាល់ យ៉ាង ដូច្នេះ ថា « យើង បាន ទទួលរង ការវាយប្រហារ តាម ប្រព័ន្ធ បច្ចេកវិទ្យា កម្រិត ខ្ពស់ ហើយ ខ្ញុំ នឹង បង្ហាញ ជូន ដល់ សាធារណៈ ជន វ៉េណេស៊ុយអេឡា នៅ ប៉ុន្មាន ម៉ោង ក្រោយ ទៀត នេះ នូវ លទ្ធផល នៃ ការស៊ើបអង្កេត ទាំងស្រុង អំពី ប្រភេទ នៃ ការវាយប្រហារ ថា តើ ការវាយប្រហារ នេះ កើតឡើង របៀប ណា និង កើត ចេញ ពី ណា » ។
គួរ បញ្ជាក់ តាម លោក ម៉ាឌូរ៉ូ ថា វា មិន មែន ជា ការវាយប្រហារ លើក ដំបូង មក លើ ប្រព័ន្ធ ចរន្ត អគ្គិសនី ជាតិ វេណេស៊ុយអេឡា ដែល ទើបតែ កើតមាន ថ្មី ៗ នេះ ទេ ប៉ុន្តែ អ្វី ដែល ខុសប្លែក នៅ ពេល នេះ គឺ សត្រូវ របស់ វេណេស៊ុយអេឡា បាន ផ្តាច់ ប្រព័ន្ធ អគ្គិសនី ម្តង ទៀត ដែល យើង បាន និង កំពុង ស្តារ ស្ថិរភាព ឡើងវិញ នោះ ។
លោក ម៉ាឌូរ៉ូ ក៏ បាន ថ្លែងអំណរគុណ ដល់ ប្រជាជន វ៉េណេស៊ុយអេឡា ចំពោះ ការសហការ និង ការអត់ធ្មត់ របស់ ពួកគេ ដើម្បី ឆ្លើយតប ទៅ ការវាយប្រហារ នេះ ៕
លោក ផៃ ស៊ីផាន ច្រានចោល ការបំភ្លៃ ព័ត៌មាន អំពី ការលើក ពេល ប្រជុំ គណៈ រដ្ឋមន្រ្តី
( ភ្នំពេញ ) ៖ លោក ផៃ ស៊ីផាន អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ច្រានចោល នូវ ការបំភ្លៃ ព័ត៌មាន របស់ ក្រុម ប្រឆាំង ជ្រុល និយម មួយ ចំនួន ពាក់ព័ន្ធ នឹង ការលើក ពេល ប្រជុំ គណៈ គណៈ រដ្ឋមន្រ្តី នៅ ថ្ងៃសុក្រ សប្តាហ៍ នេះ ។
ការច្រានចោល នេះ បាន ធ្វើឡើង បន្ទាប់ពី ក្រុម ប្រឆាំង បាន ផ្សព្វផ្សាយ ថា ការលើក ពេល ប្រជុំ គណៈ រដ្ឋមន្រ្តី ដែល គ្រោង ធ្វើ នៅ ថ្ងៃសុក្រ សប្តាហ៍ នេះ ទៅ ពេល ក្រោយ នោះ គឺ ដោយសារ សុខភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ថ្លែង ក្នុង សន្និសីទ សារព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ លោក ផៃ ស៊ីផាន បាន អះអាង ថា ការលើក ពេលនេះ ជា រឿង ធម្មតា មួយ ប៉ុន្តែ មិន មាន ពាក់ព័ន្ធ ជាមួយ សុខភាព របស់ សម្តេច នាយក រដ្ឋមន្ត្រី នោះ ឡើយ ៕
អ្នកនាំពាក្យ ការពារ ជាតិ កម្ពុជា ៖ ការផ្សព្វផ្សាយ ថា កម្ពុជា ចុះ កិច្ចព្រមព្រៀង ឱ្យ ចិន តាំងមូលដ្ឋាន ទ័ព ជា ព័ត៌មាន ក្លែងក្លាយ គ្មាន វិជ្ជាជីវៈ និង បំផ្លាញ សន្តិសុខ ជាតិ
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ ក្រសួង ការពារ ជាតិ នាយ ឧត្តមសេនីយ៍ ឈុំ សុជាត បាន ប្រកាស ជាថ្មី ថា កម្ពុជា មិន មាន កិច្ចព្រមព្រៀង សម្ងាត់ ឬ ចំហរ ណាមួយ ជាមួយ ភាគី ចិន ឱ្យ មាន មូលដ្ឋាន កងទ័ព ចិន នៅលើ ទឹកដី កម្ពុជា ដូច ការចុះផ្សាយ របស់ សារព័ត៌មាន របស់ សហរដ្ឋ អាមេរិក ឡើយ ។
នាយ ឧត្តមសេនីយ៍ ឈុំ សុជាត បាន បញ្ជាក់ បែប នេះ នៅក្នុង សន្និសីទ សារព័ត៌មាន នៅ ទីស្តីការ គណៈ រដ្ឋមន្រ្តី ដែល រៀបចំឡើង ដោយ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នា ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
បើ តាម អ្នកនាំពាក្យ ក្រសួង ការពារ ជាតិ គឺ កម្ពុជា មិន ត្រូវការ វត្តមាន កងទ័ព បរទេស ណាមួយ មក លើ ដី របស់ ខ្លួន ឡើយ ហើយ កងទ័ព កម្ពុជា ពេលនេះ មាន សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការថែរក្សា ការពារ ទឹកដី របស់ ខ្លួន ។
កិច្ចព្រមព្រៀង នោះ គឺ កម្ពុជា ផ្តល់ឲ្យ ភាគី ចិន នូវ សិទ្ធិ ផ្តាច់ មុខ ធ្វើជា មូលដ្ឋាន ទាហាន ជើង ទឹក ចិន ជា ផ្នែក មួយ នៅ ឈូង សមុទ្រ ខ្មែរ ហើយ នៅជិត ព្រលានយន្តហោះ ធំ មួយ ដែល កសាង ដោយ ចិន នឹង អនុញ្ញាតឲ្យ ចិន ប្រើ ជា មូលដ្ឋាន យោធា រយៈពេល ៣០ ឆ្នាំ ដាក់ ទ័ព ដាក់ គ្រឿង សព្វាវុធ កន្លែង ចត ជាដើម » ។
ប៉ុន្តែ ទង្វើ នេះ ត្រូវ អ្នកវិភាគ យល់ ថា វា អាច ក្លាយជា ឧបសគ្គ រាំងស្ទះ យ៉ាង ធំ មួយ ចំពោះ ប្រសិទ្ធភាព និង គំនិត ច្នៃ បង្កើត ថ្មី នា សម័យ ទំនើប នេះ ។
នា ថ្ងៃអង្គារ សប្តាហ៍ នេះ ទីភ្នាក់ងារ ដែល មាន តួនាទី ពង្រឹង ការគោរព « ច្បាប់ ប្រកួតប្រជែង ក្នុង ទីផ្សារ » របស់ ក្រសួង យុត្តិធម៌ អាមេរិក បាន ឲ្យដឹង ថា ខ្លួន បាន បើក ការស៊ើបអង្កេត មួយ ដើម្បី វាយតម្លៃ មើលទៅ លើ ស្ថានភាព ការប្រកួតប្រជែង នៅលើ ទីផ្សារ អនឡាញ ក្រោម គោលដៅ ធានា ថា អាមេរិក មាន ទីផ្សារ ដែល ក្រុមហ៊ុន នានា ធ្វើ ការប្រកួតប្រជែង គ្នា ដោយ ឈរ លើ ឧត្តមភាព ត្រឹមត្រូវ ក្នុង ការផ្តល់ សេវាកម្ម ដែល អ្នកប្រើប្រាស់ ចង់បាន ។
គួរ ជម្រាប ថា យ៉ាងណាមិញ បើ តាម ការយល់ឃើញ របស់ សេដ្ឋវិទូ ជនជាតិ អូស្រ្តាលី លោក ស្ទេវ ឃីន ( Steve Keen ) រដ្ឋាភិបាល អាមេរិក គួរតែ ដោះស្រាយ បញ្ហា ជាមួយ ក្រុមហ៊ុន បច្ចេកវិទ្យា យក្ស ទាំងនេះ តាម មធ្យោយ បាយ ផ្សេង វិញ ជាង ការប្រើ ច្បាប់ ប្រឆាំង ការប្រកួតប្រជែង ដោយ មិន ស្មើភាព នេះ ព្រោះ វា អាចនឹង ប៉ះពាល់ ដល់ គំនិត បង្កើត ថ្មី និង ប្រសិទ្ធភាព ជាខ្លាំង ។
បើ តាម លោក Keen វា សំខាន់ ខ្លាំង ណាស់ ក្នុង ការបែងចែក ឲ្យ ដាច់ រវាង ក្រុមហ៊ុន ដែល លើកកម្ពស់ ន វានុវត្ដន៍ និង ក្រុមហ៊ុន ដែល ព្យាយាម ក្រសោប យក ទីផ្សារ មក គ្រប់គ្រង តែ ឯង ៕
ព័ត៌មាន បន្ថែម ៖ ប្រតិបត្តិការបង្ក្រាប ករណី ជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន នៅ ខារ៉ាអូខេ « អូប៉ា ម៉ា » ខេត្ត ព្រះសីហនុ ចាប់ខ្លួន មនុស្ស ១៥០ នាក់ ភាគ ច្រើន ជនជាតិ ចិន និង ដកហូត ថ្នាំ ញៀន មួយចំនួន ធំ
លោក ឧត្តមសេនីយ៍ ស្នងការ បាន បញ្ជាក់ ថា មនុស្ស ទាំង ១៥០ នាក់ ដែល ត្រូវបាន ចាប់ខ្លួន នេះ រហូតមកដល់ ពេលនេះ សមត្ថកិច្ច ជំនាញ កំពុង ធ្វើ ការបែក ចែក ឲ្យបាន ច្បាស់លាស់ រវាង អ្នកធ្វើការ , អ្នកបម្រើ , អ្នក ចូល កម្សាន្ដ និង អ្នកប្រើប្រាស់ ចែកចាយ គ្រឿងញៀន ដើម្បី ចាត់ការបន្ដ តាម នីតិវិធី ច្បាប់ ៕
សហរដ្ឋ អាមេរិក បញ្ជូន នាវា ចម្បាំង ទៅកាន់ ច្រក សមុទ្រ តៃវ៉ាន់ ក្រោយ ចិន ព្រមាន ពី សង្រ្គាម
( វ៉ាស៊ីនតោន ) ៖ សហរដ្ឋ អាមេរិក បាន បញ្ជូន នាវា ចម្បាំង មួយ គ្រឿង ឱ្យ ទៅ ធ្វើដំណើរ ឆ្លងកាត់ តាម ច្រក សមុទ្រ តៃវ៉ាន់ សាជាថ្មី បន្ទាប់ពី ទីក្រុង ប៉េកាំង ព្រមាន ពី លទ្ធភាព នៃ ការធ្វើ សង្រ្គាម ក្នុង ករណី ទីក្រុង តៃ ប៉ិ ប្រកាស ឯករាជ្យ ។
សេចក្ដីថ្លែងការណ៍ ដដែល បាន ឱ្យដឹង ដូច្នេះ ថា ៖ « នាវា ចម្បាំង អាមេរិក បាន ធ្វើដំណើរ ឆ្លង កាត់ ច្រក សមុទ្រ តៃវ៉ាន់ ដើម្បី បង្ហាញ ពី ការប្ដេជ្ញាចិត្ត ចំពោះ សេរីភាព និង ការបើកចំហរ តំបន់ ឥណ្ឌូ - ប៉ាស៊ីហ្វិក ... ហើយ សហរដ្ឋ អាមេរិក នឹង នៅតែ បន្ត ធ្វើ ការហោះហើរ និង នាវា ចរ ទៅកាន់ គ្រប់ ទីកន្លែង ដែល ច្បាប់ អន្តរជាតិ អនុញ្ញាត » ។
ជាក់ស្ដែង នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ ចិន បាន ព្រមាន ជាថ្មី ថា ខ្លួន នឹង ប្រើប្រាស់ កម្លាំង យោធា វាយ យក កោះ តៃវ៉ាន់ បើសិនជា ទីក្រុង តៃ ប៉ិក ហ៊ាន ប្រកាស ឯករាជ្យ ឬ កម្លាំង ខាងក្រៅ ណាមួយ ដូចជា សហរដ្ឋ អាមេរិក ចង់ បំបែក តៃវ៉ាន់ ចេញពី ចិន ដី គោក ៕
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កំពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ២៥ ខែកក្កដា នេះ !
រដ្ឋមន្ត្រី ម៉ៅ ហាវណ្ណាល់ ៖ កម្ពុជា ដឹក អ្នកដំណើរ តាម ផ្លូវ អាកាស ជាង ១០ លាន នាក់ រួមចំណែក សេដ្ឋកិច្ច ជាង ២,៧ លាន ដុល្លារ នៅ ឆ្នាំ ២០១៨
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្ត្រី ទទួលបន្ទុក រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល បាន ថ្លែង ថា នៅ ឆ្នាំ ២០១៨ កម្ពុជា បាន ដឹកជញ្ជូន អ្នកដំណើរ តាម ផ្លូវ អាកាស ប្រមាណ ១០ លាន នាក់ ជាមួយនឹង អត្រា កំណើន ២៣ % បាន ផ្តល់ ការងារ ធ្វើ ដោយ ផ្ទាល់ និង ប្រយោល ១,៧ លាន នាក់ និង បាន ចូលរួមចំណែក ចំណូល សេដ្ឋកិច្ច ជា ឌុល ប្រមាណ ២,៧ លាន ដុល្លារ សហរដ្ឋ អាមេរិក ។
ការបញ្ជាក់ របស់ បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ បាន ធ្វើឡើង នៅ យប់ ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ក្នុង ឱកាស ដែល ក្រុមហ៊ុន អាកាសចរណ៍ អង្គរ អ៊ែរ បាន ធ្វើ ពិធី រំលឹក ខួប លើក ទី ១០ នៃ ការបង្កើត ក្រុមហ៊ុន មួយ នេះ ។
រដ្ឋមន្ត្រី ទទួលបន្ទុក រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា ៖ « នៅ ឆ្នាំ ២០១៨ ព្រះរាជាណាចក្រ កម្ពុជា បាន ដឹកជញ្ជូន អ្នកដំណើរ តាម ផ្លូវ អាកាស ប្រមាណ ១០ លាន នាក់ ជាមួយនឹង អត្រា កំណើន ២៣ % បាន ផ្តល់ ការងារ ធ្វើ ដោយ ផ្ទាល់ និង ប្រយោល ១,៧ លាន នាក់ និង បាន ចូលរួមចំណែក ចំណូល សេដ្ឋកិច្ច ជា ឌុល ប្រមាណ ២,៧ លាន ដុល្លារ សហរដ្ឋ អាមេរិក ។
នាយ ឧត្តមសេនីយ៍ បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ បាន បន្ត ថា សមិទ្ធផល ដ៏ ប្រសើរ នេះ ពិតជា មិន អាច បំភ្លេច បាន ពី ការចូលរួមចំណែក យ៉ាង សកម្ម របស់ ក្រុមហ៊ុន អាកាសចរណ៍ អង្គរ អ៊ែរ បាន ឡើយ ។
ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ អង្គរ អ៊ែរ បាន ជួយ លើកកម្ពស់ មុខមាត់ ព្រះរាជាណាចក្រ កម្ពុជា តាមរយៈ ការបើក ជើងហោះហើរ ទៅកាន់ ទីផ្សារ អន្តរជាតិ និង ពង្រឹង សុវត្ថិភាព នៃ ការហោះហើរ តាមរយៈ ការទទួលបាន វិញ្ញាបនបត្រ កម្រិត ស្តង់ដារ អន្តរជាតិ និង គោរព យ៉ាង ខ្ជាប់ ខ្ជូន នូវ បទបញ្ញត្តិ និង សុវត្ថិភាព និង សន្តិសុខ អាកាសចរណ៍ ស៉ីវិល របស់ រដ្ឋលេខាធិការដ្ឋា អាកាសចរណ៍ ស៉ីវិល ជាដើម ។
ជាមួយគ្នា នេះ លោក តឹក រឹក សំរេច រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ក្រុមហ៊ុន អាកាសចរណ៍ អង្គរ អ៊ែរ បាន ថ្លែង ថា ក្រុមហ៊ុន អាកាសចរណ៍ អង្គរ អ៊ែរ ដែល ត្រូវបាន បង្កើតឡើង តាំងពី ១០ ឆ្នាំ មុន នោះ បាន និង កំពុង រីកចម្រើន យ៉ាង ខ្លាំង ។
លោក ថ្លែង បន្ត ថា ដំណើរ ប្រតិបត្តិការ ដ៏ ជោគជ័យ របស់ ក្រុមហ៊ុន មួយ នេះ ដោយសារតែ រាជ រដ្ឋាភិបាល ដែល មាន រដ្ឋលេខាធិការដ្ឋាន អាកាសចរណ៍ ស៉ីវិល តែងតែ យកចិត្តទុកដាក់ និង លើកស្ទួយ គ្រប់ កិច្ចការ ទាំងអស់ ។
លោក បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ក្នុង នាម ជា ប្រធាន អាកាសចរណ៍ ជាតិ អង្គរ អ៊ែរ ខ្ញុំ សូម ឆ្លៀត ឱកាស សម្តែង នូវ ការអរគុណ យ៉ាង ជ្រាលជ្រៅ ជា ទីបំផុត ក្នុង ការគាំទ្រ របស់ ឯកឧត្តម រដ្ឋមន្ត្រី លោកជំទាវ ក្នុង ដំណើរ អាជីវកម្ម របស់ ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ របស់ យើង ដែល យើង អាច ឈាន មកដល់ ឆ្នាំ ទី ១០ ហើយ ល្ងាច នេះ យើង ជួបជុំគ្នា ដើម្បី អបអរសាទរ ជោគជ័យ នៃ ការធ្វើ ប្រតិបត្តិការ របស់ យើង »៕
លោក គួច ចំរើន ចុះ ពិនិត្យ ផ្លូវ ស្ថានភាព ផ្លូវ ៥ ខ្សែ ក្នុង ចំណោម ផ្លូវ ២២ ខ្សែ ដែល គ្រោង ជួសជុល កែលំអ ឡើងវិញ បន្ទាប់ពី រង ការខូចខាត យ៉ាង ដំណំ រយៈពេល កន្លងមក
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ អម ដំណើរ ដោយ ប្រធាន មន្ទីរ សាធារណការ និង មន្ត្រី ក្រោម ឱវាទ ជាច្រើន រូប ទៀត រសៀល ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ បាន អញ្ជើញ ចុះ ពិនិត្យមើល ស្ថានភាព ផ្លូវ ដែល គ្រោង ធ្វើ ការជួសជុល កែលម្អ ឡើងវិញ ប្រមាណ ២២ ខ្សែ ដែល ត្រូវបាន កំណត់ ។
លោក អភិបាល ខេត្ត ក៏ បាន បញ្ជាក់ ដែរ ថា ត្រូវ ធ្វើ ផ្លូវ ណា ដែល អាទិភាព មុន ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ ចំពោះ មុខ ។
សេចក្តីរាយការណ៍ បាន បញ្ជាក់ ថា ក្នុង ប្រតិបត្តិការ ចុះបង្ក្រាប គ្រឿងញៀន នេះ សមត្ថកិច្ច បាន ធ្វើ ការឃាត់ខ្លួន មនុស្ស ចំនួន ជាង ១០០ នាក់ ៕
( សេអ៊ូល ) ៖ កូរ៉េ ខាងជើង បាន បាញ់ សាកល្បង មីស៊ីល រយៈចំងាយ ខ្លី ចំនួន ២ គ្រាប់ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ នេះ ចេញ ពី ឆ្នេរ ភាគ ខាងកើត របស់ ខ្លួន ហើយ នេះ ជា ការធ្វើតេស្ដ មីស៊ីល ជា លើក ដំបូង បំផុត ក្រោយ លោក ដូណាល់ ត្រាំ និង លោក គីម ជុង អ៊ុន ព្រមព្រៀង ចាប់ផ្ដើម កិច្ចចរចានុយក្លេអ៊ែរ ឡើងវិញ ។
តែ ភ្លាម ៗ ទីក្រុង វ៉ាស៊ីនតោន មិន ទាន់ អត្ថាធិប្បាយ អ្វី នៅឡើយ ទេ ខណៈ មន្ត្រី យោធា អាមេរិក បាន ទទួល ដំណឹង ពី ការធ្វើតេស្ដមីស៊ីល នេះ ហើយ ៕
ព្រឹក នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី « ព័ត៌មាន ក្លែងក្លាយ អន្តរាយ ដល់ សន្តិសុខ ជាតិ »
សម្រាប់ វាគ្មិន ដែល នឹង អញ្ជើញ ចូលរួម មាន ៖ ១ ៖ តំណាង ក្រសួង ការពារ ជាតិ ២ ៖ តំណាង ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ៣ ៖ តំណាង ក្រសួង ព័ត៌មាន ៕
បើកបរ មិន ត្រូវ ល្មើស ល្បឿន កំណត់ ជាដាច់ខាត ! ស្លាប់ ៤ នាក់ និង របួស ១០ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៤ ខែកក្កដា ម្សិលមិញ
សហរដ្ឋ អាមេរិក និង ចិន នឹង ចាប់ផ្តើម កិច្ចចរចា ពាណិជ្ជកម្ម ឡើងវិញ នៅ សប្តាហ៍ ក្រោយ
លោក Mnuchin និង អ្នកតំណាង ពាណិជ្ជកម្ម សហរដ្ឋ អាមេរិក នឹង ដឹកនាំ គណប្រតិភូ សហរដ្ឋ អាមេរិក ចូលរួម ក្នុង កិច្ចប្រជុំ នេះ ។
តួលេខ មនុស្ស ស្លាប់ ដោយសារ គ្រោះមហន្តរាយ ធម្មជាតិ ក្នុង រដូវ ភ្លៀង នៅឯ តំបន់ អាស៊ី ខាងត្បូង កើន ដល់ ៦៦៩ នាក់
ចាប់តាំងពី ដើម ខែកក្កដា នេះ មក នៅ ឥណ្ឌា មាន មនុស្ស យ៉ាងតិច ៤៦៧ នាក់ ស្លាប់ ។
នៅ ប្រទេស នេប៉ាល់ មាន ៩៨ នាក់ ស្លាប់ រីឯ នៅ បង់ក្លាដែស យ៉ាងហោចណាស់ ៧៨ នាក់ បាន បាត់បង់ជីវិត និង នៅ ប៉ាគីស្ថាន មាន ២៦ នាក់ ស្លាប់ ។
យោង តាម ការព្យាករណ៍ ភ្លៀង ទំនង នឹង បន្ត ធ្លាក់ ខ្លាំង រហូតដល់ ខែសីហា ជាពិសេស នៅ ប្រទេស ឥណ្ឌា តែម្តង ។
គួរ ជម្រាប ថា អំឡុង ឆ្នាំ ២០១៧ ការធ្លាក់ ភ្លៀង យ៉ាង ជោគជាំ ក្នុង រដូវ វស្សា បាន បង្ក ជា គ្រោះ ទឹក ជំនន់ បំណាក់ ដី និង រន្ទះ ដែល បាន សម្លាប់ ជីវិត មនុស្ស សរុប យ៉ាងហោចណាស់ ១,២០០ នាក់ នៅ ឥណ្ឌា នេប៉ាល់ ប៉ាគីស្ថាន និង បង់ ក្លាដែស ហើយ ប្រជាពលរដ្ឋ ខ្ទង់ ៤១ លាន នាក់ ដែល រស់ នៅ អាស៊ី ខាងត្បូង បាន រង ផលប៉ះពាល់ ជាខ្លាំង ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួមមាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។
ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម ៖ ១ ៖ ក្រសួង ការពារ ជាតិ ចិន បាន ព្រមាន ជាថ្មី ថា សង្រ្គាម នឹង ផ្ទុះឡើង បើសិនជា កោះ តៃវ៉ាន់ ហ៊ាន ប្រកាស ឯករាជ្យ ឬ ក៏ កម្លាំង ខាងក្រៅ ណាមួយ ចង់ ព្យាយាម យក ដែន កោះ មួយ នេះ ចេញពី ចិន ដី គោក ៕
៥ ៖ មនុស្ស សរុប ០៤ នាក់ បាន បាត់បង់ជីវិត ក្នុង ហេតុការណ៍ វាយប្រហារ ដោយ ពួក ឧទ្ទាម លើ បន្ទាយ យោធា មួយ កន្លែង នៅ ភាគ ខាងត្បូង ប្រទេស ថៃ ៕
៦ ៖ សហភាព អឺរ៉ុប បាន បង្ហើប ពី គម្រោង ឆ្លើយតប ទៅវិញ ប្រសិនបើ សហរដ្ឋ អាមេរិក សម្រេច យក ពន្ធ អត្រា ២៥ ភាគរយ លើ រថយន្ត ដែល នាំចូល ពី អឺរ៉ុប ដូច ផែនការ កន្លងមក ពិត មែន នោះ ៕
វារី អគ្គិសនី សេសាន ក្រោម ២ ៖ ទុក ផ្លូវ មួយ ខ្សែ ដើម្បីឱ្យ ត្រី ត្រឡប់ ទៅ ផ្ទះ វិញ
ខាងក្រោម នេះ ជា ខ្លឹមសារ ទាំងស្រុង ដែល បង្ហោះ ដោយ ស្ថានទូត ចិន ប្រចាំ ប្រទេស កម្ពុជា ៖ នៅ ដើម ខែមេសា ក្នុង ស្ថានីយ វារី អគ្គីសនី ទន្លេ សេសាន ក្រោម ២ ដែល ស្ថិត នៅ តាម ទន្លេ សេសាន ក្នុង ខេត្ត ស្ទឹងត្រែង នៃ ប្រទេស កម្ពុជា ទំនប់ ទឹក ធំ ទូលាយ មាន ទឹក ថ្លា ឆ្វង់ មើលទៅ ទេសភាព ស្អាត ណាស់ ។
នៅ ភាគ ខាងស្តាំ នៃ ទំបន់ ទឹក ស្ថានីយ វារី អគ្គិសនី មាន កូន ទន្លេ មួយ ខ្សែ ហូរ តាម កាំជណ្តើរ នៃ ស្ថានីយ វារី អគ្គិសនី បន្ទាប់បន្សំ និង ហូរ ចូលក្នុង ព្រៃ នេះ ជា ច្រក ផ្លូវ សម្រាប់ ឱ្យ ត្រី ហែល ទៅ មក ។
ច្រកផ្លូវ នេះ បាន ត្រូវ បង្កើតឡើង តាម របៀប ផ្លូវ ទឹក ធម្មជាតិ ។
ផ្លូវ ទឹក សម្រាប់ ត្រី នេះ បាន សង់ ឡើង តាម ប្រឡាយ ធម្មជាតិ ។
ត្រើយ ទាំង សងខាង ជា ព្រៃ ស្តុក ។
អំឡុង ពេល ពី ខែមេសា ដល់ ខែសីហា និង ពី ខែ វិច្ឆិកា ដល់ ខែធ្នូ ជារៀងរាល់ ឆ្នាំ ជា រដូវ ត្រី ធ្វើដំណើរ ពី កំណាត់ ខាងក្រោម ហែល ទៅ ខាងលើ តាម ទន្លេ ។
ស្ថានីយ វារី អគ្គិសនី ទន្លេ សេសាន ក្រោម ២ ជា ស្ថានីយ វារី អគ្គិសនី ធំ ជាង គេ ក្នុង ប្រទេស កម្ពុជា ដែល បាន ត្រូវ សម្ពោធ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ឆ្នាំ ២០១៨ និង សាងសង់ ដោយ ក្រុមហ៊ុន ហួនឹង ប្រទេស ចិន ។
មិន តែ ប៉ុណ្ណោះ ស្ថានីយ វារី អគ្គិសនី ទន្លេ សេសាន ក្រោម ២ មាន សមត្ថភាព ផលិត ថាមពល អគ្គិសនី ៤០ ម៉ឺន គីឡូវ៉ាត់ ដែល ត្រូវ ជា ២០ ភាគរយ នៃ សមត្ថភាព ផលិត ថាមពល អគ្គិសនី ទូទាំង ប្រទេស កម្ពុជា និង ជា គម្រោង អភិវឌ្ឍ ថាមពល សំខាន់ មួយ ដែល អនុវត្ត ក្រោម ក្របខណ្ឌ « ខ្សែក្រវាត់ មួយ និង ផ្លូវ មួយ » ។
លោក យាង សាន នាយក រង នៃ ក្រុមហ៊ុន វារី អគ្គិសនី ទន្លេ សេសាន ក្រោម ២ បាន ប្រាប់ អ្នកកាសែត ថា ក្នុង ដំណើរ នៃ ការសាងសង់ ស្ថានីយ វារី អគ្គិសទី ទន្លេ សេសាន ក្រោម ២ នេះ យើង ខិតខំ អនុវត្ត គម្រោង អភិវឌ្ឍន៍ ផង និង ការពារ បរិស្ថាន ផង ហើយ បាន យកចិត្តទុកដាក់ កម្រិត ខ្ពស់ ដល់ ការការពារ ថវិស្ថាន និង បន្ថយ ឥទ្ធិពល លើ បរិស្ថាន ព្រមទាំង ផ្តល់ ថាមពល បៃតង ដល់ ប្រជាជន កម្ពុជា និង កម្លាំង ជំរុញ បៃតង ដល់ ការសាងសង់ « ខ្សែក្រវាត់ មួយ និង ផ្លូវ មួយ » ។
និយាយ អំពី ផ្លូវ ទឹក សម្រាប់ ត្រី លោក នុង ជូក្វាំង អ្នកគ្រប់គ្រង ការសាងសង់ ផ្លូវ ទឹក សម្រាប់ ត្រី បាន ប្រាប់ អ្នកកាសែត ថា ផ្លូវ ទឹក សម្រាប់ ត្រី បាន សាងសង់ តាម ល័ក្ខខ័ណ្ឌ ផ្លូវ ទឹក ធម្មជាតិ និង អាស្រ័យ លើ បរិស្ថាន ធម្មជាតិ ជុំវិញ មើលទៅ ដូចជា កូន ទន្លេ ធម្មជាតិ មួយ ខ្សែ ។
ទន្លេ នេះ គឺជា ផ្លូវ ផ្តល់ឱ្យ ត្រី ត្រឡប់ ទៅ ផ្ទះ វិញ ។
ទឹក ផ្លូវ ត្រី នេះ មាន ប្រវែង ២៩០០ ម៉ែត្រ ពី កំណាត់ ខាងក្រោម ទៅ កំណាត់ ខាងលើ តាម ទន្លេ ។
ផ្លូវ ទឹក សម្រាប់ ត្រី នេះ ចាប់ផ្តើម សាងសង់ នៅ ខែ មេសា ឆ្នាំ ២០១៧ និង បាន ត្រូវ ប្រើប្រាស់ ជា ផ្លូវការ នៅក្នុង ឆ្នាំ ដដែល ។
លោក មូ វ៉ាង ភីង ប្រធាន ផ្នែក ថែរក្សា សុវត្ថិភាព និង ការពារ បរិស្ថាន នៃ ស្ថានីយ វារី អគ្គិសនី ទន្លេ សេសាន ក្រោម ២ បាន ប្រាប់ អ្នកកាសែត ថា គោលបំណង ដែល សាងសង់ ផ្លូវ ទឹក សម្រាប់ ត្រី នេះ ដើម្បី ការពារ ជីវ ចម្រុះ ក្នុង ទន្លេ សេសាន ក្រោម ។
មុននឹង សាងសង់ ស្ថានីយ វារី អគ្គិសនី នេះ យើង បាន ធ្វើ ការស្រាវជ្រាវ និង បាន លទ្ធផល ថា មាន ត្រី ៣៤ ប្រភេទ ត្រូវ ហែល ទៅ មក តាម ទន្លេ ដូច្នេះ យើង ផ្តល់ យោបល់ ដល់ រដ្ឋាភិបាល កម្ពុជា អំពី ការសាងសង់ ផ្លូវ ទឹក សម្រាប់ ត្រី ដើម្បី បំពេញ តម្រូវការ នៃ ការរស់នៅ របស់ ត្រី និង ថែរក្សា ជីវ ចម្រុះ ត្រី ក្នុង ទន្លេ សេសាន ក្រោម ។
លោក បន្ត ទៀត ថា ក្រោយពី ផ្លូវ ទឹក សម្រាប់ ត្រី នេះ ត្រូវ ប្រើប្រាស់ ជា ផ្លូវការ អ្នក ពិនិត្យ ត្រូវ ពិនិត្យ ច្រក ត្រី តាម ពេល កំណត់ គឺ ត្រូវ ពិទិត្យ ២ ដង ក្នុង មួយ ខែ ។
ជាង នេះ ទៅ ទៀត កំពុង ស្វែងរក ក្រុម ជំនាញ ការគ្រប់គ្រង ច្រក ត្រី និង សិក្សា ស្រាវ ជាវ លម្អិត ។
លោក មូ វាំង ភីង បាង បញ្ជាក់ ថា ការងារ ការពារ វិស្ថាន ជា រឿង សំខាន់ ណាស់ ក្នុង ដំណើរ នៃ ការសាងសង់ ស្ថានីយ វា វី អគ្គិសនី ។
ក្រុមហ៊ុន យកចិត្តទុកដាក់ កម្រិត ខ្ពស់ ចំពោះ ការការពារ បរិស្ថាន អាកាស ដោះស្រាយ ទឹក ស្អុយ និង សំរាម ពី ជីវភាព រស់ នៅ ដោយ យកចិត្តទុកដាក់ និង ថែរក្សា ទឹកដី ជាដើម ។
ក្នុង ចំណោម នោះ ការសាងសង់ ច្រក ត្រី ជា ផ្នែក សំខាន់ មួយ លើ វិស័យ ការពារ បរិស្ថាន ។
យើង បង្កើត ប្រព័ន្ធ ដេល មាន ប្រសិទ្ធភាព ដើម្បី ដោះស្រាយ ដោះស្រាយ ទឹក ស្អុយ និង សំរាម ពី ជីវភាព រស់ នៅ និង ការកែច្នៃ ឡើងវិញ នូវ ធនធាន ទឹក ដូចជា ប្រើ ទឹក ២ ដង សម្រាប់ ប្រព័ន្ធ ធារាសាស្រ្ត ជាដើម ។
លោក អ៊ឹន ភី រុន អ្នកទទួលខុសត្រូវ ផ្នែក ការពារ បរិស្ថាន ខេត្ត ស្មឹងត្រែង បាន ប្រាប់ អ្នកកាសែត ថា យើង ត្រូវ ប្រមូល យក តួយ៉ាង នៃ ទឹក ទន្លេ ទៅ ធ្វើ ការពិនិត្យ ក្នុង បន្ទប់ ពិសោធន៍ តាម ពេល កំណត់ ហើយ បាន លទ្ធផល ថា ទឹក នេះ មាន ភាពថ្លា និង ស្អាត គម្រោង ស្ថានីយ វារី អគ្គីសនី ទន្លេ សេសាន ក្រោម ២ យកចិត្តទុកដាក់ កម្រិត ខ្ពស់ ដល់ ការការពារ បរិស្ថាន និង បាន ចាត់ វិធានការ ផ្សេង ៗ ដែល មាន ប្រសិទ្ធភាព ខ្ពស់ ដើម្បី ការពារ បរិស្ថាន ឱ្យ កាន់តែ មាន ភាពល្អ ប្រសើរ ៕
អគ្គ នាយកដ្ឋាន ឧស្សាហកម្ម ហរិញ្ញវត្ថុ ប្រជុំ ពិភាក្សា លើ ការគ្រប់គ្រង និង ដោះស្រាយ បញ្ហា ប្រឈម លើ អាជីវកម្ម ទទួល បញ្ចាំ
( ភ្នំពេញ ) ៖ លោក ម៉ី វ៉ាន់ ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ឧស្សាហកម្ម ហិរញ្ញវត្ថុ នៅ ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ពិភាក្សា លើ ការគ្រប់គ្រង និង ដោះស្រាយ រាល់ បញ្ហា ប្រឈម ពាក់ព័ន្ធ អាជីវកម្ម ទទួល បញ្ចាំ និង ទទួល ប្រាតិ ភោគ ដោយ អនុប្បទាន ខ្នាត តូច ដែល ក្រសួង បាន ធ្វើ ប្រតិភូកម្ម ជូន មន្ទីរ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ រាជធានី - ខេត្ត ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ពី តំណាង ក្រសួង ពាណិជ្ជកម្ម តំណាង អគ្គ លេខាធិការដ្ឋាន នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ តំណាង អគ្គ នាយកដ្ឋាន ពន្ធដារ តំណាង អគ្គ នាយកដ្ឋារតនាគារ ជាតិ និង តំណាង មន្ទីរ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ រាជធានី - ខេត្ត ទូទាំង ប្រទេស ។
ជា លទ្ធផល នៃ កិច្ចប្រជុំ នា ថ្ងៃ នេះ គឺ បាន ដោះស្រាយ នូវ កិច្ចការ ប្រឈម មួយ ចំនួន ដែល ពាក់ព័ន្ធ នឹង អន្តរ ស្ថាប័ន ជាពិសេស លើ កិច្ចការ ចុះបញ្ជី ពាណិជ្ជកម្ម ការ កត់ត្រា ចំណូល លិខិត អនុញ្ញាត ប្រកប អាជីវកម្ម និង កាតព្វកិច្ច ពន្ធដារ ជាដើម ។
លោក ម៉ី វ៉ាន់ បាន បន្ថែម ថា បច្ចុប្បន្ន ទីផ្សារ បញ្ចាំ បាន រីកធំធាត់ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ដូចនេះ ទាមទា ឲ្យ យើង ដែល ជា បញ្ញត្តិករ និង ជា អាណាព្យាបាល ត្រូវតែ គ្រប់គ្រង ឲ្យបាន ច្បាស់លាស់ ជាពិសេស ទៅ ទៀត ត្រូវ បម្រើ សេវា សាធារណៈ ឲ្យបាន ល្អ ប្រសើរ ដោយ ទុក ប្រជាពលរដ្ឋ គឺជា ដៃគូ និង ជា មិត្តភ័ក្រល្អ ។
ជាមួយគ្នា នេះ ដែរ អគ្គ នាយកដ្ឋាន ឧស្សាហកម្ម ហរិញ្ញវត្ថុ បាន ដាក់ចេញ នូវ ទិសដៅ ជូន ដល់ អង្គប្រជុំ ឲ្យ យកចិត្តទុកដាក់ ចំពោះ អាជីវកម្ម ទាំងឡាយ ណា ដែល មិន ទាន់ មាន ច្បាប់ ត្រឹមត្រូវ និង ត្រូវ មាន វិធានការ បន្ទាន់ ដើម្បី ទប់ស្កាត់ លើ បញ្ហា នេះ ឲ្យ មាន ប្រសិទ្ធភាព ជាពិសេស បណ្តា ខេត្ត មួយចំនួន ដែល មិន ទាន់ មាន ភាពសកម្ម ក្នុង កិច្ចការងារ នេះ ។
ជា ទីបញ្ចប់ លោក សង្ឃឹម យ៉ាង មុតមាំ ថា បន្ទាប់ពី កិច្ចប្រជុំ ដ៏ មាន សារសំខាន់ នេះ ទៅ អង្គប្រជុំ ទាំងមូល នឹង នាំយក ការណែនាំ ដែល ដាក់ ចេញ ជា ទិសដៅ នេះ ទៅ អនុវត្ត ប្រកបដោយ សិក្កសិទ្ធភាព និង ប្រសិទ្ធភាព ខ្ពស់ ៕
សង្រ្គាម នឹង ផ្ទុះឡើង បើ តៃវ៉ាន់ ហ៊ាន ប្រកាស ឯករាជ្យ , នេះ ជា ការព្រមាន របស់ ក្រសួង ការពារ ជាតិ ចិន
តែ យ៉ាងណា ក៏ដោយ អ្នកនាំពាក្យ រូប នេះ ក៏ បាន អះអាង ដែរ ថា ចិន នឹង បង្កើន កិច្ចខិតខំប្រឹងប្រែង ក្នុង ការផ្សះផ្សារ និង បង្រួបបង្រួម ជាតិ ដោយ សន្តិវិធី ។
ការលក់ អាវុធ នេះ ត្រូវបាន ចិន ចាត់ទុក ថា ជា ទង្វើ បំផ្លាញ ស្ថេរភាព សកលលោក ៕
ឆមាស ទី ១ ឆ្នាំ ២០១៩ កម្ពុជា ប្រមូល ពន្ធ ពី ការនាំចូល ទំនិញ បាន ជាង ១ ពាន់ លាន ដុល្លារ
លទ្ធផល ចំណូល នេះ ត្រូវ ប្រមាណ ជា ៦៥ % នៃ ផែនការ ប្រចាំ ឆ្នាំ ដែល កំណត់ ដោយ ច្បាប់ ស្តីពី ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ប្រចាំ ឆ្នាំ ២០១៩ ។
របាយការណ៍ ស្តីពី ការប្រមូល ចំណូល ពី ពន្ធ និង អាករ លើ ទំនិញ នាំចូល នេះ ត្រូវបាន បង្ហាញ នៅ ថ្ងៃពុធ ០៨ រោច ខែ អាសាឍ ឆ្នាំ កុរ ឯកស័ក ព .ស.២៥៦៣ ត្រូវនឹង ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ក្នុង កិច្ចប្រជុំ បូកសរុប ការងារ គយ និង រដ្ឋាករ ប្រចាំ ឆមាស ទី ១ ឆ្នាំ ២០១៩ ក្រោម អធិបតីភាព លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ថ្នាក់ដឹកនាំ នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ ព្រមទាំង ថ្នាក់ដឹកនាំ គ្រប់ ជាន់ ថ្នាក់ នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ផងដែរ ។
របាយការណ៍ ចំណូល ពន្ធ គយ ដែល បង្ហាញ ដោយ លោក បណ្ឌិត គុណ ញឹម ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយ ដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន បង្ហាញ ថា បើ ប្រៀបធៀប នឹង រយៈពេល ដូចគ្នា ក្នុង ឆ្នាំ ២០១៨ លទ្ធផល ចំណូល តាម ប្រភេទ ពន្ធ និង អាករ សំខាន់ ៗ ដែល ប្រមូល ដោយ គយ មាន កំណើន គួរឲ្យ កត់សម្គាល់ ។
លោក អគ្គ នាយក បាន លើកឡើង ថា លទ្ធផល ដ៏ ល្អ ប្រសើរ នេះ បាន មកពី សុខ សន្តិភាព និង ស្ថេរិភាព នយោបាយ ដែល កំពុង គ្របដណ្តប់ លើ ផ្ទៃ ប្រទេស កម្ពុជា និង ការកែទម្រង់ មុត ស្រួច របស់ រាជ រដ្ឋាភិបាល ។
ជាពិសេស ការពង្រឹង នូវ អភិបាលកិច្ច ផ្ទៃក្នុង របស់ អង្គភាព គយ និង ការរីកចម្រើន ផ្នែក សមត្ថភាព ធនធាន មនុស្ស ។
ក្រៅពី បង្ហាញ នូវ ចំណូល ពន្ធ គយ និង អាករ ហើយ នោះ លោក បណ្ឌិត គុណ ញឹម ក៏ បាន បង្ហាញ សមិទ្ធផល ផ្សេង ទៀត ដែល អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ សម្រេចបាន ផងដែរ ។
ក្នុង ឱកាស នោះ លោក អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី បាន សំដែង ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចខិតខំប្រឹងប្រែង ប្រកបដោយ មនសិកា និង ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ របស់ មន្ត្រី គយ និង រដ្ឋាករ គ្រប់ រូប ចំពោះ លទ្ធផល ប្រកបដោយ សុទិដ្ឋិនិយម និង ក្ដីរំពឹង ខ្ពស់ និង បាន ណែនាំ សម្រាប់ ជា ទិសដៅ អនុវត្ត បន្ត សម្រាប់ ឆមាស ទី ២ ឆ្នាំ ២០១៩ ដោយ ជំរុញ ឱ្យ យកចិត្តទុកដាក់ ទៅលើ ការងារ សំខាន់ ៗ មួយចំនួន ទៀត ។
ការ ដែល អគ្គ បណ្ឌិត សភាចារ្យ ជំរុញ យកចិត្តទុកដាក់ នោះ រួមមាន ការបន្ត ពង្រឹង អភិបាលកិច្ច ល្អ ក្នុង អង្គភាព និង ក្រមសីលធម៌ វិជ្ជាជីវៈ របស់ មន្ត្រី គយ និង រដ្ឋាករ និង ត្រូវ ប្រកាន់ខ្ជាប់ អភិក្រម ៤ ប្រការ របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ព្រមទាំង អភិក្រម ៥ ប្រការ របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី គឺ ឆ្លុះ កញ្ចក់ ងូតទឹក ដុស ក្អែល ព្យាបាល និង វះកាត់ ។
លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ក៏ បាន ជំរុញឱ្យ មន្ត្រី អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ បន្ត យកចិត្តទុកដាក់ អនុវត្តន៍ លើ ងារងារ សំខាន់ មួយចំនួន ទៀត ដើម្បី ធ្វើឱ្យ ការប្រមូល ពន្ធ និង អាករ លើ ទំនិញ នាំចូល កាន់តែ មាន ភាពប្រសើរ ។
ក្នង កិច្ចប្រជុំ នៅ ថ្ងៃ នេះ ដើម្បី ជា ការលើកទឹកចិត្ត ឯកឧត្តម អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ក៏ បាន បំពាក់ គ្រឿង ឥស្សរិយយស និង បណ្ណ សរសើរ ជូន ដល់ មន្ត្រី គយ និង រដ្ឋាករ មាន ស្នាដៃ មួយចំនួន ៕
លោក ប៉ាន សូរស័ក្តិ ជំរុញ យុវជន បណ្តុះ គំនិត សេ្នហា ជាតិ និង ស្មារតី សហគ្រិន ភាព ដើម្បី ចូលរួម អភិវឌ្ឍ វិស័យ ពាណិជ្ជកម្ម
( ភ្នំពេញ ) ៖ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម លោក ប៉ាន សូរស័ក្តិ បាន ជំរុញ យុវជន ឱ្យ ខិតខំ បណ្តុះ ផ្នត់គំនិត ស្នេហាជាតិ ស្រលាញ់ ទឹកដី និង ប្រជាជន ហើយ ត្រូវ ព្យាយាម បំផុស ស្មារតី សហគ្រិន ភាព ជាមួយ គំនិត ផ្តួចផ្តើម ថ្មី ៗ ដើម្បី ចូលរួម អភិវឌ្ឍន៍ វិស័យ ពាណិជ្ជកម្ម ជាមួយ រាជ រដ្ឋាភិបាល សំដៅ ជំរុញ កំណើន សេដ្ឋកិច្ច និង កាត់បន្ថយ ភាពក្រីក្រ ស្រប តាម ផែនការ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ ជាតិ ។
ការលើកឡើង របស់ លោក រដ្ឋមន្ត្រី បាន ធ្វើឡើង នា ឱកាស អញ្ជើញ ជា គណៈអធិបតី ជាមួយ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស.ស .យ .ក ) ក្នុង ពិធី ប្រកាស ទទួលស្គាល់ ក្រុមការងារ សហភាព សហព័ន្ធ យុវជន កម្ពុជា វិស័យ ពាណិជ្ជកម្ម ដែល រៀបចំឡើង នៅ ទីស្តីការ ក្រសួង ពាណិជ្ជកម្ម កាលពី ព្រឹក ថ្ងៃពុធ ទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ ។
នៅក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន លើកឡើង ពី សារៈសំខាន់ នៃ ការចូលរួម របស់ យុវជន ក្នុង ការអភិវឌ្ឍ វិស័យ ពាណិជ្ជកម្ម និង បាន បង្ហាញ សុទិដ្ឋិនិយម ខ្ពស់ នៅពេល បាន ឃើញ យុវជន ដែល ជា សុទ្ធសឹង ជា ទំពាំង ស្នង ឫស្សី ទទួលបាន ឱកាស អប់រំ និង ការបណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ អាច ចូលរួម បំពេញ កិច្ចការ សំខាន់ ៗ ជូន ប្រជាជន និង ប្រទេស កម្ពុជា ។
បន្ថែម លើ នោះ លោក រដ្ឋមន្ត្រី ក៏ បាន ផ្តល់ អនុសាសន៍ មួយចំនួន ដោយ ផ្តោត សំខាន់ លើ ការរៀបចំ ផែនការ យុទ្ធសាស្ត្រ ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ការបង្កើត វេទិកា អប់រំ សម្រាប់ យុវជន ការលើកកម្ពស់ សហគ្រិន ភាព និង សមភាព យេនឌ័រ ការស្វែងយល់ ពី វប្បធម៌ ប្រពៃណី និង ការចូលរួម សកម្មភាព សង្គម ជាដើម ដើម្បី ធ្វើឱ្យ យុវជន ក្រសួង ពាណិជ្ជកម្ម ដែល ទទួលបាន សេចក្តីទុកចិត្ត ពី ស .ស .យ . ក ថ្នាក់ កណ្តាល ថ្ងៃ នេះ ក្លាយជា អ្នកដឹកនាំ ដ៏ ភ្លឺស្វាង នា ពេល អនាគត ។
ទន្ទឹម គ្នា នោះ ដែរ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធ ការងារ របស់ ស .ស .យ . ក វិស័យ ពាណិជ្ជកម្ម នា ពេល កន្លងមក និង បាន ស្នើសុំ ថ្នាក់ដឹកនាំ និង យុវជន ទាំងអស់ ខិតខំ អភិវឌ្ឍន៍ សមត្ថភាព និង ស្វែងយល់ ពី កិច្ចការ នៅក្នុង ស្ថាប័ន របស់ ខ្លួន ដើម្បី ចែករំលែក ដល់ យុវជន ដូចគ្នា នៅក្នុង វិស័យ ផ្សេង ទៀត នៃ គ្រួសារ ស .ស .យ .ក ។
លោក ប្រធាន ហ៊ុន ម៉ានី ក៏ បាន លើកទឹកចិត្ត ថ្នាក់ដឹកនាំ ស .ស .យ . ក វិស័យ ពាណិជ្ជកម្ម ខិតខំ បង្កើត កម្មវិធី លើកស្ទួយ សហគ្រិន ភាព និង សហការ ជាមួយ វិស័យ ឯកជន រៀបចំ ព្រឹត្តិការណ៍ ពិព័រណ៍ ផ្សេង ៗ បន្ត ទៀត ដើម្បី ផ្សព្វផ្សាយ អំពី ផលិតផល ខ្មែរ និង សក្តានុពល កម្ពុជា ទៅកាន់ ពិភពលោក ៕
សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩
ស្ត្រី រងគ្រោះ យាន ណាវី បាន បញ្ជាក់ ថា កាលពី ថ្ងៃទី ៣ ខែកុម្ភៈ ឆ្នាំ ២០១៨ ជនសង្ស័យ ដែល ជា មិត្តភ័ក្រ របស់ ប្តី អានិក ជន សាំងហ្គា ពួរ បាន ឆបោក រថយន្ត របស់ គាត់ ហើយ បាន ទារ យក សោរថយន្ត ថា យក ទៅ ចម្លង ហើយក៏ បាត់ ដំណឹង រហូត ។
ក្រោយមក ទំនាក់ទំនង តាម ទូរស័ព្ទ មិន ចូល ក៏ សំរេចចិត្ត បាន ដាក់ពាក្យបណ្ដឹង នៅ នគរបាល រដ្ឋបាល បឹងកេងកង ទី ១ ដើម្បី ស្រាវជ្រាវ ចាប់ ជន បង្ក មក ចាត់ការ តាម ផ្លូវ ច្បាប់ ។
សង្ឃឹម ថា អ្នក ដែល យក រថយន្ត មក ជួសជុល នៅ យានដ្ឋាន ចូលខ្លួន ប្រសិន មិន ពិត ៕
ថ្លែង ក្នុង ឱកាស នោះ លោក ផៃ ស៊ីផាន បាន លើកឡើង ថា គោលបំណង ដែល លោក បាន ដឹកនាំ សមាគម សិល្បក ខ្មែរ ដើម្បី ចុះ មក មើល ឱ្យ បាន ឃើញ ផ្ទាល់ នៃ ដំណើរការ នៃ ព្យាបាល របស់ មន្ទី ពេទ្យ កុមារ ជាតិ នេះ ដើម្បី ចង់ ឃើញ ពី សកម្មភាព ជាក់ស្តែង នៃ ការផ្តល់ សេវាកម្ម ផ្នែក សេវា សុខភាព ជូន ដល់ ប្រជាពលរដ្ឋ និង ចំនួន ដែល ប្រជាពលរដ្ឋ បាន មក ទទួល សេវា ព្យាបាល នេះ ដោយ ផ្ទាល់ ។
លោក វេជ្ជបណ្ឌិត ញឹប អង្គា បុស្ស បាន លើកឡើង ដែរ ថា មន្ទីរពេទ្យ កុមារ ជាតិ មាន អ្នកជំងឺ បាន ចូល ទទួល ការព្យាបាល យ៉ាង ច្រើន នៅ ឆ្នាំ នេះ ខណៈ បើ ប្រៀបធៀប ជាមួយនឹង ឆ្នាំ មុន នេះ គឺ មាន ការកើនឡើង ស្ទើរតែ ២ ដង ។
នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA នៅ ល្ងាច ថ្ងៃពុធ ទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៩ ។
ដោយឡែក Gapo វិញ កាលពី ថ្ងៃចន្ទ កន្លងទៅ បាន ក្លាយជា បណ្ដាញ ទំនាក់ទំនង សង្គម ចុងក្រោយ បំផុត ដែល ត្រូវបាន ដាក់ ឱ្យ ដំណើរការ នៅក្នុង ប្រទេស វៀតណាម ជាមួយ ក្ដីរំពឹង ថា នឹង មាន អ្នកប្រើប្រាស់ ២០ លាន នាក់ នៅ ត្រឹម ឆ្នាំ ២០២១ ៕
ក្រុមការងារ បច្ចេកទេស បាន ធ្វើ ការផ្លាស់ប្ដូរ ប្រភព ផ្គត់ផ្គង់ និង ភ្ជាប់ ចរន្ត ជូន អតិថិជន ឲ្យ មាន ចរន្ត អគ្គិសនី ប្រើប្រាស់ ឡើងវិញ នៅ វេលា ម៉ោង ១៦ ៖ ៣១ នាទី រសៀល ។
ពិធី នេះ បាន ប្រព្រឹត្តទៅ នៅ សាល សន្និសីទ សារព័ត៌មាន គ.ជ.ប ក្រោម អធិបតីភាព លោក ស៊ិក ប៊ុន ហុក ប្រធាន គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ។
ឆ្លៀត ក្នុង ឱកាស នេះ ដែរ លោក ស៊ិក ប៊ុន ហុក បាន គូសបញ្ជាក់ ថា ហេតុ ដែល នាំឱ្យ មាន ការផ្លាស់ប្តូរ ថ្នាក់ដឹកនាំ ប្រធាន នាយកដ្ឋាន ថ្ងៃ នេះ ព្រោះ ដោយសារ ច្បាប់ ហើយ មន្ត្រី បោះឆ្នោត ពីមុន សុទ្ធតែ ជា មន្រ្តី ជាប់ កិច្ចសន្យា ។
លោក បន្ថែម ថា ចាប់តាំងពី មាន កំណែទម្រង់ ការបោះឆ្នោត នៅ ឆ្នាំ ២០១៥ មក មន្ត្រី បោះឆ្នោត ដែល ជា ថ្នាក់ដឹកនាំ នាយកដ្ឋាន ទាំងនេះ ជា អ្នក រាជការ គ.ជ.ប ហើយ ឥឡូវ ដល់ អាយុ ចូលនិវត្តន៍ ត្រូវតែ ចូលនិវត្តន៍ ព្រោះ ច្បាប់ កំណត់ ។
ជាមួយគ្នា នេះ លោក ស៊ិក ប៊ុន ហុក បាន គូសបញ្ជាក់ ថា គ.ជ. ប នឹង បន្ត ការងារ រៀបចំ អ្នក បន្ត វេន ជាច្រើន ផ្សេង ទៀត ទាំង នៅ ថ្នាក់ ជាតិ និង នៅ ថ្នាក់ រាជធានី ខេត្ត ដោយសារ មន្ត្រី បោះឆ្នោត មួយចំនួន ទាំង នៅ ថ្នាក់ ជាតិ និង នៅ ថ្នាក់ រាជធានី ខេត្ត ដល់ អាយុ ចូលនិវត្តន៍ ដែល ត្រូវ បញ្ចប់ មុខតំណែង ។
ទាំងអស់ នេះ ជា ការពង្រឹង ស្ថាប័ន បោះឆ្នោត ឱ្យ ទៅជា ស្ថាប័ន មួយ ដែល ទទួលបាន ការគាំទ្រ និង ទទួលស្គាល់ ពី មជ្ឈដ្ឋាន ជាតិ និង អន្តរជាតិ ដូច ដែល ធ្លាប់ ធ្វើ នា ពេល កន្លងមក ៕
ជាមួយគ្នា នោះ ក៏ មាន ការតាំងពិព័រណ៌ ទំនិញ ពាណិជ្ជកម្ម ខ្មែរ - ថៃ ដែល មាន ទំនិញ ជាច្រើន រួមទាំង គ្រឿង ម្ហូប អាហារ ជាច្រើន មុខ លក់ សម្រាប់ ពលរដ្ឋ ហូប នៅក្នុង ពិធី នេះ ផងដែរ ។
លោក ផឹង និល បាន ឲ្យដឹង ថា ការចុះ ពិនិត្យ មុខ ទំនិញ នៅ ថ្ងៃ នេះ មាន គោលបំណង ធានា បាន សុវត្ថិភាព ម្ហូប អាហារ ព្រោះ វា មាន សារសំខាន់ ចាំបាច់ ណាស់ ក្នុង សង្គម និង ជីវភាព ប្រចាំ ថ្ងៃ ។
លោក បាន បន្ត ថា ការទទួលខុស ត្រូវ លើ សុវត្ថិភាព ម្ហូប អាហារ គឺជា ការទទួលខុសត្រូវ រួមគ្នា ទាំង ស្ថាប័ន ជំនាញ ទាំង អ្នកនាំចូល អ្នកផលិត អ្នកចែកចាយ និង អ្នក ទាំងអស់ គ្នា ជា អ្នកប្រើប្រាស់ ផងដែរ ព្រោះ សុខភាព គឺជា កត្តា ចំបង នៃ ភាពរស់រាន នៃ ជីវិត ។
ជាមួយគ្នា នេះ លោក បាន បញ្ជាក់ ថា មន្ត្រី ជំនាញ បាន ធ្វើ ការពិនិត្យ មុខ ទំនិញ ជាច្រើន មុខ និង ធ្វើតេស្ត ទៅ លើ មុខ ទំនិញ ដែល គ្រឿង ម្ហូប អាហារ ក្នុង នោះ ពុំ បាន រកឃើញ សារធាតុ គីមី នោះ ទេ ។
លោក ក៏ បាន ណែនាំ ដល់ អ្នកលក់ ទាំងអស់ នៅក្នុង ពិធី តាំង ពិព័រណ៌ ត្រូវ យក ទំនិញ ដែល មាន កាលបរិច្ឆេទ មុខ ទំនិញ ឲ្យបាន ត្រឹមត្រូវ ចៀសវាង លក់ ទំនិញ ដែល ផុត កំណត់ ប្រើប្រាស់ ។
