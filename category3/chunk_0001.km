( ភ្នំពេញ ) ៖ អគ្គ លេខាធិការ រដ្ឋសភា បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ កិច្ចប្រជុំ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ ដែល ត្រូវបាន ធ្វើឡើង នៅ វិមាន រដ្ឋសភា ក្រោម អធិបតីភាព សម្តេច ហេង សំរិន ប្រធាន រដ្ឋសភា នៅ ព្រឹក ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ដោយ បាន ពិនិត្យ របៀបវារៈ ចំនួន ៣ ។
របៀបវារៈ ទាំង ៣ នោះ រួមមាន ៖ ១ ៖ ការពិនិត្យ សំណើ សុំ អនុម័ត នូវ សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចការពារ អ្នកប្រើប្រាស់ ។
២ ៖ ការពិនិត្យ សំណើ សុំ អនុម័ត នូវ សេចក្តីព្រាង ច្បាប់ ស្តីពី ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិច ។
៣ ៖ ការពិនិត្យ សំណើ សុំ ជ្រើសតាំង សមាជិក ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ០១ រូប សម្រាប់ ជំនួស ឯកឧត្តម អ៊ុត រ៉ាឌី សមាជិក ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ដែល នឹង ត្រូវ បញ្ចប់ អាណត្តិ ។
ក្រោយពេល ពិនិត្យ សំណើ ទាំងនេះ ហើយ នោះ សំណើ ចំនួន ២ ត្រូវ គណៈកម្មាធិការ អចិន្រ្តៃយ៍ នៃ រដ្ឋសភា ប្រគល់ ជូន គណៈកម្មការ ជំនាញ និង ចំណែក របៀបវារៈ ចុងក្រោយ គឺ ប្រគល់ ជូន អគ្គ លេខាធិការ ជូនដំណឹង ផ្សព្វផ្សាយ ៕
ព័ត៌មាន លម្អិត សូម អាន សេចក្តីជូនដំណឹង ខាងក្រោម ៖
អគ្គ ស្នងការ រង នគរបាល ជាតិ ហ៊ឹម យ៉ាន ចុះ ផ្សព្វផ្សាយ ច្បាប់ ចរាចរណ៍ ដល់ អ្នកបើកបរ រថយន្ដ ដឹក កម្មករ នៅ ខេត្ត កំពង់ឆ្នាំង
( កំពង់ឆ្នាំង ) ៖ នាយ ឧត្តមសេនីយ៍ ហ៊ឹម យ៉ាន អគ្គ ស្នងការ រង នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ច្បាប់ ស្ដីពី ចរាចរណ៍ ផ្លូវគោក សុវត្ថិភាព ចរាចរណ៍ លើ មធ្យោបាយ ដឹកជញ្ជូន ជូន ដល់ អ្នកបើកបរ រថយន្ដ ដឹក កម្មករ និយោជិត ប្រមាណ ជិត ១០០ នាក់ នៅ រោងចក្រ កាត់ដេរ សំលៀកបំពាក់ ជីន យី ហ្គា មែន ( ខេមបូឌា ) ឃុំ សេដ្ឋី ស្រុក សាមគ្គី មាន ជ័យ ខេត្ត កំពង់ឆ្នាំង ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ ហ៊ឹម យ៉ាន បាន គូសបញ្ជាក់ ថា ការផ្សព្វផ្សាយ នៅ ថ្ងៃ នេះ គឺ អនុវត្ត ជំហ៊ាន ទី ១ ដើម្បី ពន្យល់ ឲ្យ អ្នកបើកបរ រថយន្ដ ដឹក កម្មករ ទាំងអស់ បើកបរ ឲ្យ មាន ការទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ហើយ ត្រូវ ចេះ ទទួលខុសត្រូវ លើ វាសនា ខ្លួនឯង និង ត្រូវ ចេះ ទទួលខុសត្រូវ លើ វាសនា អ្នកដទៃ ពោល អ្នក ដែល រួម ដំណើរ ។
បើ តាម អគ្គ ស្នងការ រង ហ៊ឹម យ៉ាន អ្នកបើកបរ ទាំងអស់ ក្រៅពី ចេះ ច្បាប់ ចេះ បើកបរ ក៏ ត្រូវ បើកបរ ដោយ មាន ការប្រុងប្រយ័ត្ន និង គោរព ច្បាប់ ទើប ការបើកបរ ប្រកបដោយ សុវត្ថិភាព ៕
ឈប់ បារម្ភ ពី បញ្ហា សាច់ ជ្រូក ! មន្រ្តី កសិកម្ម រៀបចំ ពិធី បរិភោគ សាច់ ជ្រូក ដើម្បី ក្តីសង្ឃឹម ដល់ អ្នក ចិញ្ចឹម ជ្រូក និង ដើម្បី យើង ទាំងអស់ គ្នា
( ព្រៃវែង ) ៖ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រៃវែង បាន រៀបចំ ពិធី បរិភោគ សាច់ ជ្រូក ក្រោម ប្រធានបទ « ដើម្បី ក្តីសង្ឃឹម ដល់ អ្នក ចិញ្ចឹម ជ្រូក និង ដើម្បី យើង ទាំងអស់ គ្នា » ក្រោម អធិបតីភាព លោក ជា សុមេធី អភិបាល ខេត្ត មន្ត្រីរាជការ កងកម្លាំង ទាំង បី មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត យ៉ាង ច្រើន កុះករ ។
លោក អ៊ុក សំណាង ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រៃវែង បាន លើក លើកឡើង ថា ក្រោយ អំពី លេច ឮ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម ហ្វេសប៊ុក និង ប្រព័ន្ធ ផ្សព្វផ្សាយ ផ្សេង ៗ នៃ ការផ្ទុះឡើង នូវ ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក មក ប្រទេស កម្ពុជា ធ្វើឲ្យ បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង ប្រទេស កម្ពុជា ក៏ ដូចជា នៅក្នុង ខេត្ត ព្រៃវែង ឈប់ បរិភោគ សាច់ ជ្រូក និង ទិញ សាច់ ជ្រូក នៅក្នុង ផ្សារ ដោយ ភ័យខ្លាច ពី ជំងឺ ទាំងអស់ នេះ ឆ្លង មក ខ្លួន ។
ដូច្នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ ដូចជា ពលរដ្ឋ នៅ ខេត្ត ព្រៃវែង នាំគ្នា ហូប សាច់ ជ្រូក ជាធម្មតា វិញ ចុះ ព្រោះ វា មិន ឆ្លង ដល់ មនុស្ស ទេ ដើម្បី លើកទឹកចិត្ត ដល់ ចិញ្ចឹម ក្នុង ស្រុក ម្យ៉ាងទៀត រាល់ ការទិញ ជ្រូក ទៅ ហូប ត្រូវ ពិនិត្យមើល សាច់ ជ្រូក ដែល មាន ត្រា ពេទ្យ សត្វ ត្រឹមត្រូវ ចៀសវាង ទិញ សាច់ ជ្រូក ដែល គ្មាន ត្រា ពី ពេទ្យ សត្វ ។
រាល់ ការលក់ សាច់ ជ្រូក នៅលើ ទីផ្សារ ត្រូវតែ មាន វាយ ត្រា ពី ពេទ្យ សត្វ ទើប បញ្ជាក់ ថា សាច់ សត្វ នោះ បាន ពិនិត្យ សុខភាព សត្វ យ៉ាង ត្រឹមត្រូវ ពី មន្ត្រី ជំនាញ ។
នៅក្នុង ឱកាស នោះ ដែរ លោក ជា សុមេធី ក៏ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ព្រៃវែង មេត្តា កុំ ព្រួយបារម្ភ ចំពោះ បញ្ហា ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក ដែល ថា មេរោគ នេះ អាច ឆ្លង មក មនុស្ស នោះ គឺ មិន ឆ្លង ទេ គឺ ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក នេះ ឆ្លង តែ ជ្រូក គ្នា វា តែ ប៉ុណ្ណោះ ។
លោក បន្ត ថា ចំពោះ សាច់ ជ្រូក ដែល លក់ នៅក្នុង ទីផ្សារ គឺ សុទ្ធតែ ពិនិត្យ ត្រឹមត្រូវ និង វ៉ៃ ត្រា ពី មន្ត្រី បសុពេទ្យ ទើប ឲ្យ ធ្វើការនាំចេញ មក លក់ ទីផ្សារ នានា បាន ។
លោក ក៏ បាន ណែនាំ ដល់ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ត្រូវ បន្ត ចុះ ពិនិត្យ រាល់ សាច់ ជ្រូក ដែល នាំចូល មក លក់ ក្នុង ទីផ្សារ ឲ្យបាន ហ្មត់ចត់ ដោយ មិន ត្រូវ ឲ្យ មាន ការនាំចូល ជ្រូក ពី ក្រៅ ប្រទេស មក ចូល នៅក្នុង ប្រទេស កម្ពុជា ក៏ ដូចជា ក្នុង ខេត្ត ព្រៃវែង នោះ ទេ ៕
មន្រ្តី កាំ កុងត្រូវ អាកាស យាដ្ឋាន អន្ដរជាតិ ភ្នំពេញ ចុះ ពិនិត្យ ទំនិញ នៅ ផ្សារ សេន ជូរី ផ្លាហ្សា តែ រក មិន ឃើញ មាន ទំនិញ ណា មាន សារធាតុ គីមី នោះ ទេ
( ភ្នំពេញ ) ៖ សាខា កាំ កុងត្រូល អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ព្រមទាំង មន្ត្រី ក្រោម ឱវា ទ ក្រោម ការដឹកនាំ ពី លោក ឃុន ស៊ីម៉ន នា ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០១៩ បាន សហការ ជាមួយ មន្រ្តី ពាណិជ្ជកម្ម និង មន្ត្រី មន្ទី ពិសោធន៍ ដើម្បី ចុះ ពិនិត្យមើល ទំនិញ នៅ ផ្សារ សេន ជូរី ផ្លាហ្សា ក្នុង ខណ្ឌ ពោធិ៍ សែន ជ័យ ។
លោក តែ អ៉ិត លាង អនុ ប្រធាន សាខា កាំ កុងត្រូល អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ បាន ឲ្យដឹង ថា ក្រុមការងារ បាន បន្ត អនុវត្ត សកម្មភាព ចុះ ត្រួតពិនិត្យ គុណភាព សុវត្ថិភាព ទំនិញ ម្ហូប អារ ហារ គ្រឿង ឧបភោគ បរិភោគ នៅ ផ្សារ សិន ជូរី ផ្លាហ្សា ខណ្ឌ ពោធិ៍ សែន ជ័យ ។
លោក បាន បន្ត ថា ក្រុមការងារ បាន ធ្វើ ពិសោធន៍ បឋម លើ ទំនិញ ជា គ្រឿង បរិភោគ ចំនួយ ១១ មុខ ដូចជា ៖ ជ្រក់ គ្រប់ ប្រភេទ ទឹកខ្មេះ គល់ ស្លឹក គ្រៃ ហាន់ ជាដើម ដើម្បី ស្វែងរក សារធាតុ គីមី ហាមឃាត់ ដែល អាច ប៉ះពាល់ ដល់ សុខភាព អ្នក បរិភាគ ។
បន្ថែម ពី នោះ ក្រុមការងារ មន្ត្រី បាន ពន្យល់ ណែនាំ ដល់ អាជីវករ ឲ្យ មាន ការយល់ដឹង និង យកចិត្តទុកដាក់ ខ្ពស់ លើ គុណភាព សុវត្ថិភាព ទំនិញ ម្ហូប អារ ហារ ដែល ខ្លួន ដាក់ លក់ និង ប្រឈមមុខ នឹង ច្បាប់ ផងដែរ ។
បើ តាម អនុ ប្រធាន សាខា កាំ កុងត្រូល អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ក្រុម មន្ត្រី បាន ធ្វើ ការពន្យល់ ណែនាំ ដល់ អ្នកលក់ និង ប្រជាពលរដ្ឋ អំពី ការទុកដាក់ ទំនិញ វិចខ្ចប់ និង ផលប៉ះពាល់ បណ្តាល មកពី ទំនិញ ខូច គុណភាព ផងដែរ ៕
ប្រធាន មន្ទីរ សាធារណការ ខេត្ត ព្រះវិហារ អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ កុំ ចាក់ ដី លុប ប្រឡាយ ទឹក ចាក់ ដី ខ្ពស់ ជាង ថ្នល់ និង កុំ រំលោភបំពាន យក ដី ចំណី ថ្នល់
លោក បាន បន្ត ថា ក្រុមការងារ ថែទាំ ផ្លូវ ជាតិ លេខ ៩៥ បាន ធ្វើ សកម្មភាព ស្តារ ប្រឡាយ រំដោះ ទឹក នៅ ចំនុច គីឡូម៉ែត្រ លេខ ៣៨ + ៤០០ ក្នុង ឃុំ ពុទ្រា ស្រុក ជ័យ សែន ខេត្ត ព្រះវិហារ បាន ប្រវែង ៣២០ ម៉ែត្រ ។
លោក ថ្លែង ថា នេះ ជា ហេតុផល មួយ ក្នុង ចំណោម ហេតុផល ជាច្រើន ទៀត ដែល បណ្តាលឲ្យ ផ្លូវថ្នល់ ឆាប់ ខូចខាត ។
នេះ បើ តាម ការបញ្ជាក់ ពី ប្រធាន មន្ទីរ សាធារណការ ខេត្ត ព្រះវិហារ ៕
( ប៉ារីស )៖ រដ្ឋមន្រ្តី ការពារ ជាតិ បារាំង នា ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ បាន ប្រកាស ឲ្យដឹង ពី គម្រោង អភិវឌ្ឍន៍ សព្វាវុធ សម្រាប់ កម្ទេច ផ្កាយ រណប ដោយ ប្រើ បច្ចេកវិទ្យា កាំរស្មីឡា ស៊ែរ តែ មាន គោលដៅ សម្រាប់ ការការពារ ខ្លួនឯង ពី ការគំរាមកំហែង តែ ប៉ុណ្ណោះ ។
នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន បារាំង AFP នៅ ព្រឹក ថ្ងៃសុក្រ ទី ២៦ ខែកក្កដា ឆ្នាំ ២០១៩ ។
កាលពី ថ្ងៃទី ១៣ ខែកក្កដា នេះ ប្រធានាធិបតី បារាំង លោក ម៉ាក្រុង ទើប តែ បាន ប្រកាស ពី ផែនការ របស់ លោក ក្នុង ការបង្កើត កង អង្គភាព យោធា មួយ ចំណុះ កងទ័ព អាកាស បារាំង ដែល នឹង ទទួលបន្ទុក ផ្នែក អវកាស ដោយ វា នឹង ចាប់ផ្តើម លេច រូបរាង ឡើង នៅ ខែកញ្ញា ឆ្នាំ ២០២០ ។
គួរ ជម្រាប ថា ប្រទេស ជា មហាអំណាច យោធា ធំ ៗ នៅលើ ពិភពលោក កំពុងតែ យកចិត្តទុកដាក់ លើ ការអភិវឌ្ឍ បច្ចេកវិទ្យា ថ្មី ៗ ពាក់ព័ន្ធ នឹង ផ្នែក អវកាស ហើយ អ្វី ដែល ត្រូវបាន ផ្តោត សំខាន់ ជាង គេ នោះ គឺ សមត្ថភាព កម្ទេច ឬ បង្អាក់ ដំណើរការ ផ្កាយ រណប ដែល ស្ថិត ក្នុង ទី អវកាស ។
សព្វ ថ្ងៃ មាន ផ្កាយ រណប ប្រមាណ ២,០០០ គ្រឿង ដែល កំពុង ធ្វើ សកម្មភាព នៅ ជុំវិញ ផែនដី ។
មុខងារ ភាគ ច្រើន នៃ ពួកវា គឺ សម្រាប់ ការទាក់ទង នៅលើ ផែនដី ប៉ុន្តែ ក៏ មាន ការតាមដាន អាកាសធាតុ និង ស៊ើបការណ៍ ផងដែរ ។
បើ តាម អ្នកជំនាញ សហរដ្ឋ អាមេរិក សហព័ន្ធ រុស្ស៊ី និង ប្រទេស ចិន សុទ្ធតែ មាន សមត្ថភាព កម្ទេច ផ្កាយ រណប របស់ សត្រូវ តាមរយៈ ការប្រើ មីស៊ីល បាញ់ ចេញ ពី ផ្ទៃ ផែនដី ឬក៏ ការប្រើ ផ្កាយ រណប នៅលើ ទី អវកាស ផ្ទាល់ ដើម្បី យក ទៅ បំបុក កម្ទេចចោល តែម្តង ។
កាលពី ខែមីនា កន្លងទៅ នេះ ឥណ្ឌា ក៏ បាន បង្ក ការព្រួយបារម្ភ កាន់តែ ខ្លាំង ថែម ទៀត តាមរយៈ ការធ្វើតេស្ត ប្រើ គ្រាប់ មីស៊ីល អាច បាញ់ ផ្កាយ រណប ខូច របស់ ខ្លួនឯង មួយ គ្រឿង ។
ជោគជ័យ នេះ បាន ធ្វើឲ្យ នាយក រដ្ឋមន្រ្តី ឥណ្ឌា លោក ណារិន ដ្រា ម៉ូឌី និយាយ ថា ប្រទេស លោក បាន ក្លាយជា ប្រទេស ទី ៤ បន្ទាប់ពី ប្រទស យក្ស ៗ ទាំង បី ខាងលើ ដែល មាន សមត្ថភាព បែប នេះ ៕
( វ៉ាស៊ីនតោន ) ៖ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក លោក ម៉ៃក៍ ប៉ុម ប៉េអូ បាន អំពាវនាវ ឱ្យ តួកគី កុំ ដាក់ ដំណើរការ ប្រព័ន្ធ មីស៊ីល ការពារ ដែន អាកាស រុស្ស៊ី S - 400 ខណៈ សភា អាមេរិក កំពុង ជំរុញឱ្យ មាន ការដាក់ទណ្ឌកម្ម ប្រឆាំង រដ្ឋាភិបាល ទីក្រុង អង់ការ៉ា ។
លោក ប៉ុម ប៉េអូ បាន គូសបញ្ជាក់ យ៉ាង ខ្លី ដូច្នេះ ថា « ទណ្ឌកម្ម ជាច្រើន នឹង ត្រូវបាន អនុវត្ត ប៉ុន្តែ តាមពិត ទៅ អ្វី ដែល យើង ចង់បាន នោះ គឺ ចង់ឱ្យ តួកគី កុំ ដំណើរការ ប្រព័ន្ធ មីស៊ីល រុស្ស៊ី » ។
សម្ដេច ក្រឡាហោម ស ខេង ស្នើ ប្រជាពលរដ្ឋ ត្រូវ រួមគ្នា ជាមួយ សមត្ថកិច្ច ដើម្បី ផ្ដាច់ការផ្គត់ផ្គង់ និង ផ្ដាច់ការប្រើប្រាស់ គ្រឿងញៀន នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ នៅ ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ស្នើ ដល់ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម សហការ ជាមួយ សមត្ថកិច្ច និង អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ដើម្បី ឈាន ទៅ កាត់ផ្ដាច់ការផ្គត់ផ្គង់ និង កាត់ផ្ដាច់ តម្រូវការ គ្រឿងញៀន នៅក្នុង ប្រទេស កម្ពុជា ។
