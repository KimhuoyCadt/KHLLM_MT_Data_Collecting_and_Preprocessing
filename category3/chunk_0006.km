យីហ៊ឺបីរសជាតិគ្រឿងក្លែមឆ្ងាញ់ជាប់ចិត្តមានវិធីធ្វើងាយៗពីកញ្ញា ឧត្តម
គ្រឿង ក្លែម នេះ មិន ពិបាក ធ្វើ ទេ ប៉ុន្តែ វា ទាមទារ ឲ្យ ចុងភៅ ចេះ លៃលក បរិមាណ គ្រឿង ផ្សំ រសជាតិ តាម ការ គួរ ទើប វា មាន រសជាតិ ឆ្ងាញ់។
គ្រឿង ផ្សំ ដែល យើង ត្រូវការ មាន យីហ៊ឺ បង្គាក្រៀម ខ្ទឹមស ខ្ទឹមក្រហម ជ្រក់ គល់ខ្ទឹម ម្ទេស ដៃនាង ជីររណារ ជីរនាងវង សាលាដ ការ៉ុត ក្រូចឆ្មារ គល់ ស្លឹកគ្រៃ ម្សៅស៊ុប និង ស្ករស។
វិធី ធ្វើ គឺ ដំបូង ត្រូវ ដុត យីហ៊ឺ ឲ្យ ក្រៀម ល្មម រួច ហែក បេះ ជា សរសៃៗ។
បង្គា ក្រៀម ត្រូវ ត្រាំ ទឹក ឲ្យ រីក រួច ពូត ឲ្យ ស្ងួត។
គល់ ស្លឹកគ្រៃ ខ្ទឹមស និង ខ្ទឹមក្រហម ត្រូវ ហាន់ ស្ដើងៗ។
បន្ទាប់ពី រៀបរយ គ្រឿង ផ្សំ រួច ត្រូវ ចាប់ផ្ដើម យក សរសៃ យីហ៊ឺ បង្គាក្រៀម គល់ ស្លឹកគ្រៃ ខ្ទឹមស ខ្ទឹមក្រហម ជីររណារ ជីរនាងវង និង ជ្រក់ គល់ ខ្ទឹម មក ច្របល់ ចូលគ្នា ដោយ បន្ថែម ស្ករស ម្សៅស៊ុប ហើយ ច្របាច់ ក្រូច ឆ្មារ ចូល បន្តិច។
ចុងក្រោយ គ្រាន់តែ រៀប សាលាដ និង ចំណិត ការ៉ុត ដាក់ ចាន រួច ដួស ញាំ ដាក់ ពី លើ ជា ការ ស្រេច។
មីគោកក្ដាមសកពីហាងផាកកាហ្វេ
មីគោក ក្ដាមសក ជា អាហារ ដែល មាន សាច់ រសជាតិ បំពង ស្រួយ និង សម្រួល បំពង់ ក ពេល ទទួលទាន ដោយ ទឹកស៊ុប ឆ្អឹង ជំនីរជ្រូក។
អាហារ នេះ មាន រសជាតិ ឆ្ងាញ់ ប្លែក ខណៈ វិធី ចម្អិន ក៏ មិន ស្មុគស្មាញ។
គ្រឿង ផ្សំ ដែល យើង ត្រូវការ មាន មីដុំ ក្ដាមសក ដើម គូឆាយ ស្លឹកខ្ទឹម ម្សៅបំពង ពងមាន់ ប្រេងឆា ស្ករស អំបិល ឆ្អឹង ជំនីរជ្រូក ឆៃថាវ ឆៃប៉ូវ ការ៉ុដ បង្គាក្រៀម និង យីហ៊ឺ។
ចំពោះ វិធី ចម្អិន វិញ គឺ ដំបូង ត្រូវ ដាំ ទឹក ស៊ុប ឲ្យ ពុះ រួច សឹម ដាក់ បង្គា ក្រៀម និង យីហ៊ឺ ចូល។
ក្រោយពី វា ពុះ បាន មួយ សន្ទុះ ចាប់ផ្ដើម ដាក់ ឆ្អឹង ជំនីរជ្រូក ចូល មុន នឹង បន្ថែម ឆៃប៉ូវ ឆៃថាវ និង ការ៉ុដ។
ទឹក ស៊ុប នេះ ត្រូវ បន្ត រម្ងាស់ ប្រមាណ ពីរ បី ម៉ោង ឲ្យ ចូលជាតិ ។
ក្ដាមសក មួយ ក្បាល ត្រូវ យក មក កាត់ ជា បួន ដុំ រួច ប្រឡាក់ ជាមួយ ម្សៅបំពង និង ពងមាន់ ក្រហម មុន នឹង យក ទៅ បំពង ជាមួយ ប្រេងឆា ឲ្យ ឆ្អិន ល្អ។
មី ដុំ ត្រូវ យក ទៅ ស្រុស ឲ្យ ទន់ រួច ប្រឡាក់ ប្រេង កុំ ឲ្យ សរសៃ មី ជាប់ គ្នា ហើយ សឹម ច្របល់ វា ជាមួយ ស្លឹកខ្ទឹម ចិញ្ច្រាំ។
ចាប់ផ្ដើម ដួស មី ដាក់ ចាន រួច រៀប ក្ដាមសក បំពង ពី លើ និង ដាក់ ដើម គូឆាយ។
មីគោក ក្ដាមសក នេះ ត្រូវ បាន បម្រើ ជាមួយ ទឹកស៊ុប ឆ្អឹង ជំនីរជ្រូក ដែល ចម្អិន ដូច ខាង លើ។
អាហារ នេះ មាន តម្លៃ ប្រមាណ ជាង ៥ ដុល្លារ នៅ ហាង ផាកកាហ្វេ ជិត ផ្សារ សុវណ្ណា៕
ហាងម្ហូបឥណ្ឌាបើកថ្មីនៅភ្នំពេញធានាផ្ទះបាយគ្មានគ្រឿងផ្សំពីសត្វ
លោក វ៉ាត សាយ៉ាន បាន ថ្លែង ថា៖
លោក កត់សម្គាល់ ឃើញ ថា សង្គម ខ្មែរ ដែល ប្រណិប័តន៍ នូវ ពុទ្ធសាសនា ហីនយាន ក៏ មាន អ្នក ជឿ លើ ការ ញ៉ាំ អាហារ បួស ដែរ ហើយ សព្វថ្ងៃ ហាង របស់ លោក មាន ម៉ូយ ប្រចាំ ដែល ជា អតិថិជន ខ្មែរ ហូរហែ ផង ដែរ។
ម្ចាស់ ភោជនីយដ្ឋាន ដែល ទទួល ស្គាល់ ថា ហាង របស់ ខ្លួន មិន សូវ មាន ការ តុបតែង ឆើតឆាយ តែ នៅតែ អាច ស្រូប ភ្ញៀវ ជាតិ និង បរទេស នោះ បាន ថ្លែង ថា ៖
«ពុទ្ធសាសនា ជា សាសនា គ្មាន ហិង្សា ដូច្នេះ ការ ហូប បួស គួរតែ មាន ក្នុង ប្រវត្តិសាស្ត្រ ខ្មែរ យូរយារ មក ហើយ »៕
ខ្យាដំរី និងដង្កូវដួងរស់រវើកក្នុងមាត់ជារសជាតិថ្មីប្លែកនៅភ្នំពេញ
ប៉ុន្ដែ ដើម្បី ឲ្យ គ្នា ផុត ទុក្ខ ផុត ភ័យ សូម បញ្ជូន ដួង ទាំង នេះ ទៅ ឋានសួគ៌ ដោយ គ្រាន់តែ ទំពា មួយ ម៉ាត់ ឲ្យ ហៀរ ទឹក ក្នុង មាត់ ជា ការស្រេច ។
ដោយ ចាត់ទុក ដង្កូវដួង ជា អាហារ សម្បូរ ប្រូតេអ៊ីន កាបូនអ៊ីដ្រាត វីតាមីនបេ និង វីតាមីនសេ លោក សុផល ជា ម្ចាស់ ហាង បាន ថ្លែង ថា ៖
« ខ្ញុំ សម្រេច បន្ថែម ដង្កូវ រស់ ទាំងនេះ ទៅក្នុង មុខម្ហូប ប្រចាំ ភោជនីយដ្ឋាន ពីព្រោះ ភ្ញៀវ តែងតែ ចង់ ភ្លក្ស ម្ហូប ដែល ផ្ដល់ ប្រយោជន៍ ចំពោះ សុខភាព ពួកគេ »។
ម្ចាស់ ភោជនីយដ្ឋាន រូប នេះ បាន លើក ឡើង ថា ៖
ដួង ដែល មាន ប្រភព មកពី ខេត្ដ កំពង់ធំ រស់ នៅក្នុង គល់ដូង និង ត្រូវ បាន រក្សា ទាំង រស់ នៅឯ ភោជនីយដ្ឋាន ។
ពួកវា មាន សណ្ឋាន ដូចជា ដង្កូវដួង យក្ស អូស្ដ្រាលី ។
ក្រៅពី ដង្កូវ ដួង ហាង របស់ លោក ក៏ រក្សា ខ្យាដំរី ទាំង រស់ ក្នុង ធុង លើ ធ្នើរ ដូចជា ការ ចិញ្ចឹម បង្កង ផង ដែរ ។
សត្វ ល្អិត អាសិរពិស រស់ នៅ តំបន់ ភ្នំ ក្នុង ប្រទេស កម្ពុជា ទាំងនេះ មាន រសជាតិ ស្រដៀង នឹង សាច់មាន់ និង បង្កង ទឹក សាប ។
ប៉ុន្ដែ លោក សុផល បាន ព្រមាន កុំ ឲ្យ ទទួលទាន ជាមួយ ទឹកដោះគោ ពីព្រោះ វា អាច បង្ក ឲ្យ ពុល ។
ភោជនីយដ្ឋាន ទីក្រុង សិង្ហបុរី ថ្មី មាន អាស័យដ្ឋាន ផ្លូវ លេខ ៣៦៨ ក្បែរ កែង ផ្លូវ ១១៣ ដែល ចាប់ បើក ទ្វារ ពី ម៉ោង ៣ រសៀល ទៅ ម៉ោង ១១ យប់ រៀងរាល់ ថ្ងៃ៕
នំបញ្ចុកនៅភោជនីយដ្ឋានដើមឫស្សី ឆ្ងាញ់រហូតដល់ញ៉ាំបោសពីចាន
នំបញ្ចុក ប្រមាណ ពីរ ចង្វាយ តូចៗ លាយ អន្លក់ ត្រយូងចេក ហាន់ ស្ដើងៗ ស្រោច សម្ល ប្រហើរ និង សម្ល ក្រហម ខ្មែរ ដែល មាន កម្ទេច សាច់ត្រី កករ លើ សាច់ នំបញ្ចុក គួរ ឲ្យ ស្រក់ ទឹកមាត់ ដែល អតិថិជន កំពុង អង្គុយ រង់ចាំ យូរ គួរសម ទ្រាំ មិន ចាប់ ចង្កិះ មក ផ្សំ គ្រឿង អន្លក់ ដូចជា ភ្លៅកង្កែប សណ្ដែកកួរ ជីរគ្រប់មុខ ព្រលឹត និង ត្រួយ ក្ទម្ពទេស មក លាយ ម្ទេស ម៉ដ្ឋ ហឹរ បែក ញើស ថ្ងាស កាយ ញាត់ តែ ពីរ បី ចង្កឹះ អស់ រលីង។
ផ្ដើម អាជីវកម្ម លក់ នំបញ្ចុក សម្ល ពីរ ប្រភេទ តាំងពី ផ្ទះ ខ្ទម តូច មួយ នំ បញ្ចុក ដើម ឫស្សី អភិវឌ្ឍ ខ្លួន បន្ដិច ម្ដងៗ ចាប់ពី មួយ ចាន តម្លៃ មិន ដល់ ១ ពាន់ រៀល។
ភោជនីយដ្ឋាន នំបញ្ចុក ដើម ឫស្សី ស្ថិត នៅ ជាប់ ផ្លូវជាតិ លេខ ៦ ក្នុង ឃុំ ព្រែកអញ្ចាញ ស្រុក មុខកំពូល នៃ ខេត្ត កណ្តាល៕
លៀសប្រឡាក់គ្រឿងឆាអម្ពិលទុំម្ហូបដ៏ពេញនិយមនៅហាងខ្ចៅកូនភ្លោះ
ហាង «ខ្ចៅ កូន ភ្លោះ» ខាង កើត ផ្សារ ទួលទំពូង ក្រៅពី ល្បី ដោយសារ អាហារ សម្រន់ ខ្ចៅ ចំហុយ ទឹក ជ្រលក់ អំបិល មី នោះ ហាង ដែល ផ្ដើម ចេញ ពី តូប ចិញ្ចើម ថ្នល់ ពង្រីក ដល់ ជួល ផ្ទះ ពីរ ល្វែង មួយ នេះ ក៏ ទទួល បាន ការ គាំទ្រ ដោយសារ មុខម្ហូប លៀស ប្រឡាក់ គ្រឿង ឆា អម្ពិល ទុំ ផង ដែរ។
ប៉ុន្តែ រូបមន្ត ចម្អិន វា គឺ មិន ខុស គ្នា ទេ។
គ្រឿង ផ្សំ មាន លៀស ម្សៅស៊ុប អម្ពិលទុំ ម្ទេស ដៃ នាង អំបិល ខ្ទឹមស ប្រេង ឆា និង ស្ករស។
បន្ទាប់មក ចាប់ផ្ដើម ចាក់ ប្រេងឆា ចូល ខ្ទះ ក្ដៅ រួច បង់ ខ្ទឹមស ចិញ្ច្រាំ ឲ្យ ប្រែ ពណ៌ ឈ្ងុយ សឹម ចាក់ ទឹក អំពិល ទុំ ចូល។
ម៉ាំត្រីរ៉ស់ចំហុយត្រប់ដុត បានភ្លក្សម្ដង ចង់នាំសម្លាញ់មកញ៉ាំម្ដងទៀត
នៅ ភោជនីយដ្ឋាន កញ្ញា ឧត្តម ដែល ស្ថិត នៅ ខាង កើត រង្វង់មូល ទួលគោក ម៉ាំ ត្រីរ៉ស់ ត្រូវ បាន គេ ចំហុយ ទទួលទាន ជាមួយ បន្លែ អន្លក់ និង ត្រប់ ដុត។
មុខ ម្ហូប នេះ មាន គ្រឿងផ្សំ ដូចជា ម៉ាំ ត្រីរ៉ស់ (ឬ ម៉ាំ ត្រីពោ ) ត្រប់ វែង សាច់ជ្រូក បីជាន់ ខ្ទឹមក្រហម ខ្ទឹមស ម្សៅស៊ុប ស្ករស និង ម្ទេស។
សម្រាប់ បន្លែ អន្លក់ រួមមាន ត្រប់ស្រួយ សណ្ដែក កួរ ពពាយ ត្រសក់ និង ការ៉ុត។
របៀប ចម្អិន គឺ ដំបូង ត្រូវ យក ម៉ាំ មក ចិញ្ច្រាំ ជាមួយ សាច់ជ្រូក បីជាន់ ឲ្យ ម៉ដ្ឋ។
ខ្ទឹម ស និង ខ្ទឹម ក្រហម ត្រូវ ចិញ្ច្រាំ ឲ្យ ម៉ដ្ឋ ដូច គ្នា មុន នឹង យក ទៅ ចិញ្ច្រាំ លាយ ជាមួយ ម៉ាំ និង សាច់ជ្រូក បី ជាន់។
ដួស ម៉ាំ ដាក់ ចាន រួច លាយ គ្រឿងផ្សំ រសជាតិ មាន ម្សៅស៊ុប និង ស្ករស បន្តិច។
ឆ្អឹងជំនីរជ្រូកខ្ចីឆាខ្ញីពីហាងម្ហូប
ថ្ងៃ នេះ យើង សូម បង្ហាញ នូវ ម្ហូប «ឆ្អឹង ជំនីរ ជ្រូក ខ្ចី ឆាខ្ញី» ដ៏ ឈ្ងុយ ឆ្ងាញ់ ដែល មាន គ្រឿងផ្សំ ងាយៗ។
ម្ហូប នេះ យើង ត្រូវការ គ្រឿង គ្រៅ ដូចជា ឆ្អឹង ជំនីរ ជ្រូក (ជាប់ ឆ្អឹង ខ្ចី) ខ្ញី ចាស់ ស្លឹក ក្រូចសើច ស្លឹក ខ្ទឹម ខ្ទឹមស ម្ទេស ទឹកត្រី កោះកុង ប្រេងឆា ម្សៅស៊ុប ស្ករស និង អំបិល។
ឆ្អឹង ជំនីរ ជ្រូក ត្រូវ កាត់ ជា កង់ៗ ហើយ ប្រឡាក់ ជាមួយ ខ្ទឹម ស ចិញ្ច្រាំ ព្រមទាំង គ្រឿងផ្សំ រសជាតិ មាន ម្សៅស៊ុប ស្ករស និង អំបិល តែ បន្តិចបន្តួច ប៉ុណ្ណោះ ហើយ ផ្អាប់ ទុក មួយ សន្ទុះ។
បន្ទាប់មក ដាក់ ខ្ទះ ឲ្យ ក្ដៅ រួច ចាក់ ប្រេងឆា ជាមួយ ខ្ទឹម ស ចិញ្ច្រាំ។
ឆា ឆ្អឹង ជំនីរជ្រូក ដោយ បន្ថែម ទឹក បន្តិច ដើម្បី កុំ ឲ្យ វា ខ្លោច។
ពេល ដែល ឆ្អឹង ជំនីរ ឆ្អិន ចាប់ផ្ដើម ដាក់ ខ្ញី បំពង ចូល រួច បន្ត រំលីង ឲ្យ ស្ងួត សឹម ដាក់ ស្លឹក ក្រូច សើច គល់ ខ្ទឹម និង ម្ទេស ហើយ ដួស ដាក់ ចាន។
ចំពោះ វិធី លាយ ទឹកត្រី កោះកុង នោះ គឺ ដំបូង ត្រូវ បុក ខ្ទឹម ស ឲ្យ ច្រើន ជាមួយ នឹង ម្ទេស ស្រស់ ហើយ ច្របាច់ ក្រូចឆ្មារ មុន នឹង ចាក់ ទឹកត្រី និង ស្ករស កូរ ឲ្យ សព្វ ជា ការស្រេច។
ឆ្អឹង ជំនីរ ជ្រូក ខ្ចី ឆា ខ្ញី នេះ អាច ទទួលទាន ជ្រលក់ ជាមួយ ទឹកត្រី កោះកុង។
ភោជនីយដ្ឋាន ម្ហូប ស្ថិត នៅ ផ្ទះ លេខ ១៣៧ ភូមិ ត្រាំង ក្រុម ៣ ម្ដុំ ផ្លូវ តំបន់ អភិរក្ស អង្គរ ខេត្ត សៀមរាម៕
អតីតអ្នកលក់ចល័តបើកហាងការ៉េមដូងខ្ចីស្រស់ច្រើនរសជាតិ
ដោយ បាន បើក សម្ពោធ កាលពី ពីរ ខែ មុន ហាង បង្អែម នេះ មាន លក់ ការ៉េម ដូង ដាក់ ក្នុង ត្រឡោក ដូង ដែល នៅ ជាប់ សាច់ ដូងខ្ចី ដ៏ឈ្ងុយឆ្ងាញ់ អម ដោយ ទឹកដូង ត្រជាក់ ។
លោក លី អ៊ូ មាន គំនិត បង្កើត ហាង នេះ ពី មិត្ដភក្ដិ ម្នាក់ នៅ ថៃ ដែល លក់ ការ៉េមដូង នៅ សាលារៀន។
កាលពី ៧ ខែ មុន លោក ចាប់ផ្ដើម លក់ ការ៉េម តាម រ៉ឺម៉ក ម៉ូតូ ឲ្យ សិស្ស មុខ សាលារៀន ដូច មិត្ដភក្ដិ ដែរ ហើយ អាជីព របស់ លោក ទទួល បាន ការ ចាប់ អារម្មណ៍ ខ្លាំង ។
« ខ្ញុំ ចូលចិត្ដ ញ៉ាំ ការ៉េម តាំងពី កុមារ ម្ល៉េះ ប៉ុន្ដែ ខ្ញុំ មិន ឃើញ មាន ភោជនីយដ្ឋាន លក់ ការ៉េម នៅ ភ្នំពេញ ច្រើន មុខ ដែល មាន អនាម័យ និង តម្លៃ សមរម្យ ទេ។
ដូច្នេះ ខ្ញុំ ក៏ សម្រេចចិត្ដ បើក ហាង នេះ ផ្ទាល់ ខ្លួន ទៅ »។
« ខ្ញុំ បាន ភ្លក្ស ការ៉េម សជាតិ ផ្សេងៗ ក្នុង ប្រទេស កម្ពុជា និង ប្រទេស ដទៃ ហើយ ខ្ញុំ ជឿ ថា ផ្លែ ដូង គឺជា គ្រឿង ដ៏ល្អ បំផុត សម្រាប់ ផ្សំ ជា ការ៉េម »។
ការ៉េម របស់ លោក មាន អនាម័យ ល្អ ពីព្រោះ វា ត្រូវ បាន ផលិត ឡើង ដោយ គ្មាន សារធាតុ បន្ថែម ក្លិន ឬ រសជាតិ ឡើយ។
ការ៉េម ដូង របស់ លោក គ្រាន់តែ ប្រើ ទឹកដូង ស្រស់ សាច់ដូង ទឹកដោះគោ ហើយ ជួន កាល ប្រើ ទឹកដោះគោ ខាប់ សម្រាប់ អ្នក ចូលចិត្ដ រសជាតិ ផ្អែម បន្តិច ប៉ុណ្ណោះ ។
អំពី ការ ជ្រើសរើស ផ្លែ ដូង តាម អាយុកាល លូតលាស់ របស់ វា នោះ លោក បាន ពន្យល់ ថា ៖
ការ៉េមដូង មាន តម្លៃ ១,៩០ ដុល្លារ នៅ ភោជនីយដ្ឋាន ហើយ ១,២៥ ដុល្លារ នៅលើ រ៉ឺម៉ក ម៉ូតូ ដែល ស្ថិត នៅ ផ្សារ រាត្រី និង សាកលវិទ្យាល័យ ភូមិន្ទភ្នំពេញ ។
ប៉ុន្ដែ លោក ថា អតិថិជន ភាគច្រើន ចូលចិត្ដ ការ៉េម ដូង បំផុត ។
ពិតជា គួរ ឲ្យ ភ្ញាក់ផ្អើល តាំងពី ហាង នេះ បើក ទ្វារ មក អតិថិជន ដ៏ច្រើន លើសលប់ សុទ្ធតែ ជា មនុស្ស ពេញវ័យ ។
« ខ្ញុំ គិត ថា អតិថិជន របស់ ខ្ញុំ គួរតែ ជា កុមារ ពីព្រោះ ពួកគេ ចូលចិត្ដ ការ៉េម ប៉ុន្ដែ បច្ចុប្បន្ន មនុស្ស ធំ ក៏ ចូលចិត្ដ ការ៉េម ដែរ ហើយ កុមារ ចូលចិត្ដ តែ ទឹកដោះគោ ឬ កាហ្វេ ទៅវិញ »។
ខ្យងអប់អំបិលម្ទេសឆ្ងាញ់នាំភ្ញៀវកកកុញនៅហាងបាយកុលាប
ផ្សែង ហុយ ទ្រលោម បាន ហោះហើរ កាត់ ម៉ូតូ ឡាន ដែល សំចត ជា ជួរៗ ខណៈ ដែល ម្ចាស់ យានជំនិះ ទាំងនេះ កំពុង អង្គុយ នៅ កៅអី ជ័រ ទាបៗ រង់ចាំ ចំណីចំណូល ចិត្ត រៀងៗ ខ្លួន។
តើ អ្វី ទៅ ដែល ធ្វើឲ្យ មនុស្សម្នា ជាពិសេស យុវវ័យ មក កកកុញ នៅ ចិញ្ចើម ផ្លូវ រាល់ៗ ល្ងាច ដូច្នេះ។
ឆ្អឹង ជំនីរ ជ្រូក អាំង សាច់ ជ្រូក បីជាន់ អាំង សាច់គោ បន្ទះអាំង ខ្យង អប់ទឹក ដូង ខ្យង អប់អំបិល ម្ទេស ងាវ អប់ ទឹកដូង និង ងាវ អប់ អំបិលម្ទេស ក្នុង មួយ ចាន មាន តម្លៃ ៦០០០ រៀល ដូចៗ គ្នា។
ក្នុង ទឹកមុខ រួសរាយ រាក់ទាក់ លោក សុធា សុវណ្ណៈ ដែល ជា ម្ចាស់ ហាង ដ៏មមាញឹក បាន ឲ្យ ដឹង ថា៖
ដើម្បី ចម្អិន ម្ហូប នេះ យើង ត្រូវការ សាច់គោ ចំឡក ផុយ ម្អម ខ្ទឹម ក្រហម ក្រូច ឆ្មារ ការ៉ុដ ប៉េងប៉ោះ ក្រហម (សម្រាប់ លម្អ ចាន ម្ហូប ប៉ុណ្ណោះ ) ទឹក ប្រហុក ម្ទេស ស្ករស អំបិល និង ម្សៅ ស៊ុប។
មុន ដំបូង ត្រូវ យក សាច់គោ ទៅ ចិញ្ច្រាំ ឲ្យ ម៉ដ្ឋ រួច យក ម្អម មក ច្របល់ ជាមួយ ដោយ បន្ថែម គ្រឿង ផ្សំ រសជាតិ ដូចជា អំបិល ស្ករស និង ម្សៅស៊ុប។
បន្ទាប់មក ទៀត ត្រូវ ហាន់ ម្ទេស និង ខ្ទឹមក្រហម ហើយ ច្របល់ ជាមួយ សាច់គោ និង ទឹក ប្រហុក។
ចុងក្រោយ ត្រូវ ច្របាច់ ក្រូច ឆ្មារ បន្ថែម ដើម្បី ឲ្យ ស្លោក សាច់គោ នោះ ជា ការ ស្រេច។
មាន់ដុតទឹកឃ្មុំប្រហុកពងអង្ក្រង
ថ្ងៃ នេះ ភ្នំពេញ ប៉ុស្ដិ៍ សូម នាំ យក មក នូវ រូបមន្ត ចម្អិន «មាន់ ដុត ទឹកឃ្មុំ ប្រហុក ពងអង្ក្រង » ពី ហាង កញ្ញាឧត្តម។
គ្រឿង ផ្សំ មុខ ម្ហូប នេះ រួមមាន មាន់ស្រែ ពងអង្ក្រង ឆៅ ខ្ទឹមស ខ្ទឹមក្រហម ទឹកឃ្មុំ ព្រៃ ប្រហុក គល់ ស្លឹកគ្រៃ ក្រូចឆ្មារ ម្ទេស ស្លឹក ក្រូចសើច ការ៉ុត ត្រយូងចេក ពពាយ ត្រសក់ ត្រប់ស្រួយ ស្ពៃក្ដោប អំបិល ស្ករស ប្រេងឆា ម្រេច ប្រេង ខ្យង ទឹកស៊ីអ៊ីវ និង ម្សៅស៊ុប។
ចំពោះ វិធី ធ្វើ ប្រហុក អង្ក្រង គឺ ត្រូវ យក ប្រហុក ចិញ្ច្រាំ ជាមួយ គល់ ស្លឹកគ្រៃ ដោយ បន្ថែម ម្ទេស ហឹរ បន្តិច។
នៅពេល ដែល ប្រហុក ចិញ្ច្រាំ ម៉ដ្ឋ ត្រូវ លាយ វា ជាមួយ ពងអង្ក្រង ឆៅ ហើយ ច្របាច់ ក្រូច ឆ្មារ ចូល បន្តិច ដោយ ច្របល់ ឲ្យ ចូល ជាតិ។
ចុងក្រោយ ត្រូវ កាប់ សាច់ មាន់ រៀប ដាក់ ចាន ដួស ប្រហុក ពងអង្ក្រង និង ហាន់ បន្លែ អន្លក់ ឲ្យ រៀបរយ ជា ការ ស្រេច។
ភោជនីយដ្ឋាន កញ្ញា ឧត្តម ស្ថិត នៅ ផ្ទះ លេខ ១៥ ផ្លូវ លេខ ៦០៨ ផ្លូវ ជួលជុល ឡាន ខាង កើត រង្វង់ មូល ទួលគោក រាជធានី ភ្នំពេញ ៕
នំខ្ញីចម្អិនថ្មីៗប្រើរូបមន្ត និងគ្រឿងផ្សំងាយៗនៅរមណីយដ្ឋានពិកនិក
គេ ច្រើន ប្រទះ ឃើញ នំខ្ញី លក់ នៅ តាម ស្រុក ភូមិ ទីជនបទ ក្បែរ តូប លក់ គ្រឿងទេស តូចៗ។
ទោះជា សព្វថ្ងៃ អ្នក ទីក្រុង កម្រ បាន ភ្លក្ស នំខ្ញី ក្ដី ក៏ យើង អាច រៀន ចម្អិន វា ជាមួយ គ្រឿង ផ្សំ ងាយៗ ដូចជា ម្សៅ ដំណើប ខ្មែរ ម្សៅមី ស្ករស អំបិល ពងមាន់ និង ប្រេង បន្លែ។
ដើម្បី កុំ ឲ្យ ម្សៅ ជាប់ដៃ ត្រូវ លាប បាត ដៃ ជាមួយ ប្រេងឆា បន្តិច។
ក្រោយពី លញ់ តម្រៀប ដាក់ ថាស រួច ប្រឡាក់ ជាមួយ នឹង ម្សៅមី សឹម យក ទៅ បំពង ជាមួយ ប្រេងឆា ក្ដៅ។
ពេល ដែល ម្សៅ នំ ឡើង ឆ្អិន ស្រួយ ត្រូវ ស្រង់ វា ហើយ ដាក់ ឲ្យ ស្រក់ ខ្លាញ់ នោះ ជា ការស្រេច៕
ស្បែកមាន់ជាប់សាច់អាំងអំបិលម្ទេសញ៉ាំអស់ច្រើនចង្កាក់មិនដឹងខ្លួន
ជាមួយ ប្រជាប្រិយភាព មាន ការកុម្ម៉ង់ ច្រើន នូវ ស្បែកមាន់ ជាប់ សាច់ ប្រឡាក់ អំបិល ម្ទេស អាំង ត្រូវ បាន គេ ប្រើ សាច់ ត្រង់ ស្លាប មក ចៀរ យក ឆ្អឹង ចេញ រួច ប្រឡាក់ ជាមួយ អំបិល ស្ករស ម្សៅស៊ុប និង ប្រេងខ្យង ផ្អាប់ទុក ។
នៅ ហាង តៅហ៊ូ អាំង ម្ដុំ ខាង ក្រោយ សណ្ឋាគារ ប្រេស៊ីដង់ ស្បែក មាន់ ជាប់សាច់ អាំង អំបិល ម្ទេស ដោត ចង្កាក់ នេះ អាច ញ៉ាំ វា ជាមួយ ទឹក ស៊ុប ឆ្អឹង មាន់ស្ពៃ កំប៉ុង គឺ រឹតតែ ឆ្ងាញ់ ៕
ស៊ុបឆ្នាំងភ្លើងទឹកស៊ុបព្រុយត្រីឆ្លាមល្បីប៉ូវសុខភាពសម្រស់
ប្រជាជន ចិន ភាគច្រើន ចម្អិន ព្រុយ ត្រីឆ្លាម ជា ទឹកស៊ុប អប់ ដោយ ថ្នាំ ប៉ូវ និង បន្លែ ផ្សេងៗ។
ទន្ទឹម នឹង នោះ គេ ក៏ អាច រម្ងាស់ ព្រុយ ត្រីឆ្លាម ធ្វើ ជា ទឹកស៊ុប ឆ្នាំងភ្លើង សម្រាប់ ទទួលទាន ជាមួយ ជម្រើស បន្លែ និង សាច់ ដ៏ច្រើន ស្រដៀង នឹង ស៊ូគីស៊ុប ដែរ។
បើទោះ ជា ភោជនីយដ្ឋាន បែប សិង្ហបុរី មួយ នេះ បម្រើ នូវ ស៊ុប ដ៏ល្បីល្បាញ របស់ ចិន ក៏ពិតមែន ប៉ុន្តែ បរិយាកាស ក្នុង ហាង មាន លក្ខណៈ បែប បស្ចិម ប្រទេស។
នៅក្នុង ហាង មាន រចនា នូវ គ្រឿង សង្ហារឹម ទំនើប សាឡុង និង តុ ពណ៌ ប្រផេះ មាន រន្ធ សម្រាប់ ដាក់ កូនឆ្នាំង ស៊ុប ឆ្នាំងភ្លើង ដាច់ ដោយឡែក សម្រាប់ ភ្ញៀវ ម្នាក់ៗ។
ជាមួយ នឹង ឆ្នាំង ទឹកស៊ុប ខុសៗ គ្នា ភ្ញៀវ នីមួយៗ ក៏ អាច ជ្រើសរើស រសជាតិ ទឹកស៊ុប ផ្សេង ទៀត ដូចជា ស៊ុប ឆ្អឹងជំនីរ ជ្រូក ស៊ុប ថ្នាំចិន សែ និង រសជាតិ តុមយ៉ាំ បន្ថែម រសជាតិ ដោយ ទឹកជ្រលក់ ជាច្រើន ប្រភេទ៕
ភ្លាសាច់គោក្រសាំងទាបឆ្ងាញ់ប្លែកមាត់ពីហាង ម្ហូប ទឹកដីអង្គរសៀមរាប
ដោយឡែក សណ្ដែកបណ្ដុះ សណ្ដែកកួរ គល់ស្លឹកគ្រៃ ហាន់ ម្ទេស ប្លោកហាន់ និង ម្រេច ខ្ចី មក ញាំ ជាមួយ ទឹកត្រី ភ្លា ជូរអែម។
ភោជនីយដ្ឋាន ម្ហូប ស្ថិត នៅ ផ្ទះ លេខ ១៣៧ ភូមិត្រាំង ខេត្ត សៀមរាប៕
ញាំសាលាដមឹកអាំងបង្អួតសម្រស់ និងរសជាតិឆ្ងាញ់ពីហាងប៉រឃ្វីហ្ស៊ីន
មឹក ត្រូវ យក ទៅ ប្រឡាក់ អំបិលម្រេច ប្រេងអូលីវ ស្រា ចិន ទឹកស៊ីអ៊ីវ រួច សឹម អាំង កុំ ឲ្យ ឆ្អិន ពេក ចៀសវាង សាច់ វា ស្វិត។
មឹក នោះ ត្រូវ យក មក កាត់ កង់ៗ កុំ ឲ្យ ដាច់ ពី គ្នា រួច តម្រៀប ដាក់ ចាន ជុំវិញ គល់ ខ្ទឹម និង សាលាដ រួច ស្រូប ទឹកត្រី ជូរអែម ពី លើ ជា ការស្រេច។
ញាំ សាលាដ មឹកអាំង នេះ មាន តម្លៃ ១០ ដុល្លារ និង អាច ទទួលទាន ជា អាហារ សម្រន់ ពេល រសៀល មាន បម្រើ នៅ ភោជនីយដ្ឋាន ប៉រ ឃ្វីហ្ស៊ីន ម្ដុំ ភូមិ វត្តបូរ ក្រុង សៀមរាប៕
