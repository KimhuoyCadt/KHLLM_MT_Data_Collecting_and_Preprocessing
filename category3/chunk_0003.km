អ្នក ស្រី ធីតា ឃឹះ នាយិកា អង្គការ សីលកា និង ជា ប្រធាន លេខាធិការដ្ឋាន គណៈ កម្មាធិការ លើក ស្ទួយ ស្រ្តី ក្នុង វិស័យ នយោបាយ (គ.ស.ន) បាន សម្ដែង ការ សោក ស្ដាយ នឹង ខក ចិត្ត ជា ខ្លាំង នឹង ចំណាត់ ការ បែប នេះ មក លើ ស្ត្រី។
អ្នក ស្រ្តី ថា ដើម ហេតុ នៃ ទំនាស់ អូស បន្លាយ ដ៏ រ៉ាំ រ៉ៃ យូរ ឆ្នាំ នេះ គឺ មក ពី អាជ្ញាធរ ខ្វះ ឆន្ទៈ ក្នុង ការ ដោះស្រាយ និង ធ្វើ មិន អើពើ ព្រោះ ខ្លាច បាត់បង់ នូវ ផល ប្រយោជន៍ ក្នុង ប្រការ ណា មួយ។
អ្នក ស្រី ង៉ែត ឃុន អាយុ ៧២ ឆ្នាំ នៅ សហគមន៍ បឹងកក់ ប្រាប់ ថា គាត់ ត្រូវ គេ បាញ់ ទឹក ឲ្យ ប៉ើង ដួល ច្រើន ត្រឡប់ ក្នុង ក្រុម ស្ត្រី ១០០ នាក់ ដែល មក សុំ ឲ្យ លោក អភិបាល រាជធានី ប៉ា សុជាតិវង្ស ដោះស្រាយ បញ្ហា ដី ធ្លី ឲ្យ បាន មុន ថ្ងៃ បោះឆ្នោត ព្រោះ ថា ជាង ៦ឆ្នាំ ហើយ ដែល គាត់ រង់ ចាំ ប៉ុន្តែ ជា លទ្ធផល បាន រង តែ ការ បង្ក្រាប ពី អាជ្ញាធរ និង ការ ចាប់ ដាក់ គុក ដោយ ចោទ ប្រកាន់ ពាក់ ព័ន្ធ បញ្ហា ផ្សេង ទាំង អយុត្តិធម៌ ទៅ វិញ៕
អ្នកទោសដឹកមកពីតាមខេត្តធ្វើឲ្យណែនពន្ធនាគារនៅភ្នំពេញ
អ្នក ទោស កាន់ តែ ច្រើន ឡើង បាន និង កំពុង ជាប់ ឃុំ នៅ ក្នុង ពន្ធនាគារ ក្នុង រាជធានី ភ្នំពេញ បន្ទាប់ ពី ត្រូវ បាន ដឹក មក ពី បណ្តា ពន្ធនាគារ ខេត្ត នានា សម្រាប់ សវនការ នៅ ឧទ្ធរណ៍។
នេះ បើ តាម របាយ ការណ៍ របស់ អង្គការ សិទ្ធិ មនុស្ស លីកាដូ។
អ្នក ជាប់ ពន្ធនាគារ ដែល នឹង ឡើង សវនាការ ឧទ្ធរណ៍ នា ពេល ខាង មុខ ត្រូវ បាន ដឹក ចុះ ឡើង ដោយ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ របស់ ក្រសួង មហា ផ្ទៃ មក ពន្ធនាគារ នៅ ទីក្រុង រួម ទាំង មណ្ឌល កែប្រែ ១ និង ២ និង ពន្ធនាគារ PJ ដើម្បី ឲ្យ ពួក គេ អាច ឡើង សវនាការ ឧទ្ធរណ៍ របស់ ខ្លួន បាន ដែល សាលា ឧទ្ធរណ៍ មាន ទីតាំង នៅ រាជធានី ភ្នំពេញ។
បញ្ហា គឺថា អ្នក ទោស តិច ជាង មុន ត្រូវ បាន ដឹក ត្រឡប់ ទៅ ពន្ធនាគារ ខេត្ត វិញ ជា បញ្ហា ធ្វើ ឲ្យ អ្នក ទោស កាន់ តែ ស្ថិត ក្នុង ស្ថានភាព ចង្អៀត ណែន នៅ ពន្ធនាគារ ក្នុង រាជធានី ហើយ បាន កាត់ ផ្តាច់ ពួក គេ ចេញ ពី ការ ឧបត្ថម្ភ ផ្សេងៗ ពី ក្រុម គ្រួសារ។
នេះ បើ តាម របាយ ការណ៍។
កម្មវិធី ដឹក ជញ្ជូន អ្នក ទោស គឺជា គម្រោង កម្មវិធី មួយ ដែល បាន ចាប់ ផ្តើម កាល ពី ឆ្នាំ មុន ដើម្បី ដោះស្រាយ បញ្ហា សវនាការ ឧទ្ធរណ៍ កំបាំង មុខ ហើយ ពី មុន នោះ អ្នក ទោស នៅ តាម ខេត្ត ត្រូវ បាន គេ រាយការណ៍ ថា បាន ផ្តល់ សំណូក ដើម្បី អាច មក ភ្នំពេញ ឡើង សវនាការ ឧទ្ធរណ៍។
នេះ បើ តាម របាយ ការណ៍ ប្រចាំ ឆ្នាំ របស់ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ ដែល ចេញ កាល ពី ខែ មីនា។
ក្រោម ក្រម នីតិវិធី ព្រហ្មទណ្ឌ កម្ពុជា អ្នក ជាប់ ពន្ធនាគារ ដែល នឹង ឡើង សវនាការ ឧទ្ធរណ៍ របស់ ខ្លួន ត្រូវ តែ ទទួល បាន ការ ដឹក ផ្ទេរ ដោយ មិន មាន ការ ពន្យារ ពេល ទៅ ពន្ធនាគារ ជិត បំផុត ឬ មណ្ឌល ឃុំ ខ្លួន ជិត សាលា ឧទ្ធរណ៍ បំផុត។
ផ្ទុយ ទៅ វិញ មន្រ្តី ស៊ើប អង្កេត លីកាដូ បាន រក ឃើញ ថា អ្នក ទោស ត្រូវ បាន ទុក នៅ រាជធានី ឬ ផ្ទេរ ទៅ មណ្ឌល កែប្រែ ៣ ក្នុង ខេត្ត កំពង់ចាម ដែល ជា មណ្ឌល កែ ប្រែ ចង្អៀត ណែន មួយ ក្នុង ចំណោម ពន្ធនាគារ ដែល មាន ភាព ចង្អៀត ណែន បំផុត ដែល ដាក់ អ្នក ទោស ក្នុង សមត្ថភាព ១៩១ ភាគរយ។
របាយ ការណ៍ នោះ បាន លើក ឡើង ពី អតីត ពន្ធនាគារ ខេត្ត បាត់ដំបង ដែល មាន អ្នក ជាប់ ពន្ធនាគារ កាន់ តែ ច្រើន ឡើងៗ កំពុង បោះ បង់ ឱកាស មិន ចូល រួម សវនាការ ឧទ្ធរណ៍ ដោយ សារ ថា ពួក គេ នឹង ត្រូវ បន្ត ជាប់ ឃុំ នៅ ភ្នំពេញ ឬ មណ្ឌល កែប្រែ ៣ ប្រសិន បើ ពួក គេ មិន អាច មាន ប្រាក់ សូក ដើម្បី ត្រឡប់ មក វិញ។
