សាស្ដ្រាចារ្យ ណែល ថូម៉ាស មកពី វិទ្យាស្ថាន ស្រាវជ្រាវ ស្ថិតិ សុខុមាល ភាព នៃ សាកលវិទ្យាល័យ ប៊ឺមីងហេម បាន ឲ្យ ដឹង ថា ៖
ក្នុង ផ្ទះ ក្រុម គ្រួសារ គួរតែ ចៀសវាង ការប្រើប្រាស់ ឧបករណ៍ បញ្ឆេះ ភ្លើង ជីវម៉ាស ដុត ធូប និង ដុត សំរាម ជាដើម ។
ចំពោះ បញ្ហា ចរាចរណ៍ ចូរ បិទ ប្រព័ន្ធ ស្រូបខ្យល់ ពី ក្រៅ ដែល អាច ហូរ ចូល តាម ចំហាយ ម៉ាស៊ីនត្រជាក់ រថយន្ដ ៕
បើ យោង តាម របាយការណ៍ របស់ អង្គការ ចិត្ត សង្គម អន្តរវប្បធម៌ កម្ពុជា (TPO) បាន បង្ហាញ ថា ក្នុង មួយឆ្នាំៗ អង្គការ បាន ព្យាបាល អ្នកជំងឺ ផ្លូវ ចិត្ត បាន ប្រហែល ១០ ០០០ នាក់ ទាំង អ្នក ជំងឺ ទទួល សេវា ផ្ទាល់ និង អ្នក ទទួល សេវា ដោយ ប្រយោល ។
អ្នក ដែល ទទួល សេវា ផ្ទាល់ គឺ អ្នក មក ទទួល ការប្រឹក្សា នៅ កន្លែង ផ្ទាល់ និង ទទួល ព្យាបាល ។
ការព្យាបាល ដោយ ប្រយោល គឺ រួមមាន តាមរយៈ គ្រួសារ មិត្តភក្តិ ដែល អង្គការ នេះ បាន បង្រៀន បណ្តុះបណ្តាល ហើយ ពួកគាត់ បាន អប់រំ និង ផ្សព្វផ្សាយ ទៅ កាន់ អ្នកដទៃ បន្ត ទៀត ។
បើ យោង តាម សិក្សា ស្រាវជ្រាវ បាន បង្ហាញ ថា ជំងឺ ផ្លូវចិត្ត មាន ច្រើន ប្រភេទ ដូចជា ជំងឺ បាក់ ទឹកចិត្ត ជំងឺ ខ្លាច ទីប្រជុំ ជំងឺ វិកលចរិត ជំងឺ បាក់ស្បាត និង ជំងឺ ជាច្រើន ទៀត ។
លោក វេជ្ជបណ្ឌិត ឯកទេស ជំងឺ ផ្លូវចិត្ត ឈឹម សុធារ៉ា និង ជា នាយកប្រតិបត្តិ អង្គការ TPO បាន ប្រាប់ ឲ្យ ភ្នំពេញ ប៉ុស្តិ៍ ដឹង ថា ៖
ហើយ ដល់ ពេល ដែល យើង បង្កើត សេវា ហ្នឹង ច្រើន ទើប យើង ដឹង ជំងឺ ហ្នឹង កើតមាន ឡើង ច្រើន ក្នុង សង្គម កម្ពុជា គឺ ដោយសារ តែ ប្រជាពលរដ្ឋ មក ជួប យើង និង ទទួល ការព្យាបាល » ។
ទន្ទឹម នឹង នេះ លោក វេជ្ជបណ្ឌិត បាន រំឭក ថា កាលពី មុន ប្រជាជន ខ្មែរ និយម ហៅ ជំងឺ ផ្លូវចិត្ត ថា ជា ជំងឺឆ្កួត ហើយ ហៅ អ្នក ជំងឺ ថា មនុស្ស ឆ្កួត និង ហៅ ក្រុមគ្រូពេទ្យ ថា ជា ពេទ្យ ឆ្កួត ។
កត្តា ទាំង នេះ ហើយ ដែល ជា ស្លាកស្នាម ធ្វើឲ្យ អ្នកជំងឺ កាលពី មុន មិន ហ៊ាន មក ជួប គ្រូពេទ្យ ដើម្បី ទទួល ការព្យាបាល ។
ប៉ុន្តែ បច្ចុប្បន្ន នេះ ដោយសារ តែ មាន ការយល់ ដឹង ច្រើន ពី បញ្ហា ជំងឺ ផ្លូវចិត្ត ដូចនេះ ការនិយាយ ពី បញ្ហា ជំងឺ ផ្លូវចិត្ត មិន សូវ មាន ការពិបាក ដូច មុន នោះ ឡើយ ។
លោក យល់ ថា អ្នកមាន ជំងឺ ផ្លូវចិត្ត ហ៊ាន បើក ចិត្ត ទូលាយ និង ព្យាយាម ស្វែងរក ការព្យាបាល ។
មនុស្ស ម្នាក់ៗ អាច កើត មាន ជំងឺ ផ្លូវចិត្ត ដោយសារ កត្តា ៣ ធំៗ រួមមាន ៖
ទី ១ កត្តា ជីវសាស្ត្រ ( ខួរក្បាល ) គឺ អតុល្យភាព នៃ ជាតិគីមី នៅក្នុង ខួរក្បាល ។
ឧទាហរណ៍ ដូច ជំងឺ ធ្លាក់ ទឹកចិត្ត មាន សារធាតុ គីមី អរម៉ូន មួយ ឈ្មោះ សេរ៉ូតូនីម ។
កាលណា ថយ ចុះ វា នឹង ធ្វើឲ្យ អារម្មណ៍ ប្រែប្រួល មនុស្ស ផ្លាស់ មក ក្រៀមក្រំ គិត អ្វី ពិបាក ។
ទី២ កត្តា ចិត្តសាស្ត្រ គឺ សំដៅ ទៅ លើ ខ្លួនឯង យល់ ដឹង អំពី ហេតុការណ៍ កើតឡើង មក លើ ខ្លួនឯង ។
ឧទាហរណ៍ បើ យើង ជា មនុស្ស ទុទ្ទិដ្ឋិនិយម គឺ ចូលចិត្ត គិត អាក្រក់ លើ គេ លើ ខ្លួនឯង និង ធ្វើឲ្យ មនុស្ស នោះ ងាយ នឹង មាន ជំងឺ ផ្លូវចិត្ត ដែល ខុសប្លែក ពី អ្នក ដែល គិត ល្អៗ ឬ សាទរ ចំពោះ អ្នក ដទៃ បុគ្គល នោះ នឹង មិន សូវ មាន កើត ជំងឺ ផ្លូវចិត្ត នោះ ឡើយ ។
ទី ៣ គឺ កត្តា សង្គម រួមមាន ការស្រឡាញ់ កូន មិន ស្មើ គ្នា អំពើ ហិង្សា ក្នុង គ្រួសារ បែកបាក់ ស្នេហា បាត់បង់ ការងារ និង ជម្លោះ សង្គ្រាម ជំនួញ ។
កត្តា ទាំងអស់ នឹងធ្វើ ឲ្យ មនុស្ស មាន បញ្ហា ជំងឺ ផ្លូវចិត្ត ។
លោក វេជ្ជបណ្ឌិត ឈឹម សុធារ៉ា បាន បញ្ជាក់ ថា ៖
« សង្គម កាន់តែ រីកចម្រើន កាន់តែ ប្រកួតប្រជែង មនុស្ស កាន់តែ រត់ ទៅ តាម សង្គម ។
អ៊ីចឹង ការរត់ ទៅ តាម សង្គម ហួស ពី សមត្ថភាព ហ្នឹង ហើយ អាច ធ្វើឲ្យ មនុស្ស មាន បញ្ហា ផ្លូវចិត្ត ឬ ជំងឺ ផ្លូវចិត្ត ច្រើន ឡើង នាពេល អនាគត » ។
បើ តាម ការស្រាវជ្រាវ កាលពី ឆ្នាំ ២០១០ របស់ អង្គការ សុខភាព ពិភពលោក ធនាគារពិភពលោក និង សាកលវិទ្យាល័យ ហាវើត បាន បង្ហាញ ថា នៅ ឆ្នាំ ២០២០ ខាង មុខ នេះ អត្រា ស្លាប់ ដោយសារ ជំងឺ ផ្លូវចិត្ត គឺ ស្ថិត នៅ ក្នុង កម្រិត ទី ២ បន្ទាប់ពី ជំងឺ សម្ពាធ ឈាម និង បេះដូង ខណៈ ដែល អត្រា ស្លាប់ ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ ឈរ នៅ លេខ រៀង ទី ៣៕
កុមាររស់នៅក្នុងបរិស្ថានបៃតង រងហានិភ័យជំងឺធ្លាក់ទឹកចិត្ដមិនដល់ ៥០%
ការសិក្សា លើ ជនជាតិ ដាណឺម៉ាក ជិត ១ លាន នាក់ បាន រកឃើញ ថា យុវវ័យ រស់នៅ ក្នុង តំបន់ បរិស្ថាន បៃតង មិន ទំនង ជា អាច អភិវឌ្ឍ ជំងឺ ផ្លូវចិត្ដ ដល់ ៥៥ ភាគរយ ទេ នៅពេល ពេញវ័យ ។
ការស្រាវជ្រាវ មាន ការជឿជាក់ ថា បរិស្ថាន បៃតង ជួយ បង្កើត សហគមន៍ សង្គម ព្រមទាំង លើក ទឹក ចិត្ដ មនុស្ស ឲ្យ ឧស្សាហ៍ ហាត់ប្រាណ ។
បរិស្ថាន និង សកម្មភាព ទាំងនេះ បង្កើន សមត្ថភាព យល់ ដឹង របស់ កុមារ ដែល ជះឥទ្ធិពល វិជ្ជមាន ដល់ សុខភាព ផ្លូវចិត្ដ ពួកគេ ។
ការស្រាវជ្រាវ នេះ ត្រូវ បាន ធ្វើឡើង ដោយ សាកលវិទ្យាល័យ អាហុស ក្នុង ប្រទេស ដាណឺម៉ាក និង ដឹកនាំ ដោយ វេជ្ជបណ្ឌិត គ្រីស្ទីន អេនហ្គេមេន មកពី នាយកដ្ឋាន ជីវសាស្ដ្រ ។
យោង តាម អង្គការ សុខភាព ពិភពលោក បាន បង្ហាញ ថា មនុស្ស ជាង ៤៥០ លាន នាក់ នៅលើ ពិភពលោក បាន កើត ជំងឺ ផ្លូវ ចិត្ដ ។
អ្នកស្រាវជ្រាវ បាន ប្រើ ទិន្នន័យ ផ្កាយរណប ប្រមូល បាន ចន្លោះ ពី ឆ្នាំ ១៩៨៥ ដល់ ឆ្នាំ ២០១៣ ដើម្បី វាយតម្លៃ បរិស្ថាន បៃតង នៅ ជុំវិញ ផ្ទះ កុមារ ដាណឺម៉ាក ហើយ ធ្វើការ ប្រៀបធៀប ទៅ នឹង ហានិភ័យ នៃ ការអភិវឌ្ឍ ជំងឺ ផ្លូវចិត្ដ រួមទាំង ជំងឺ វិកល ចរិត ធ្ងន់ធ្ងរ មិនដឹង ខុស ត្រូវ រោគ លែង ឃ្លាន បាយទឹក និង ធ្លាក់ ទឹកចិត្ដ ។
កុំភ័យពេក អាហារខ្លោចមិនផ្ទុកជាតិពុលបង្កជំងឺមហារីកដល់មនុស្សទេ
ប្រធាន ទីប្រឹក្សា វិទ្យាសាស្ដ្រ ទីភ្នាក់ងារ ស្ដង់ដារ ចំណីអាហារ (FSA) បាន និយាយ ថា គ្មាន ហេតុផល ណា ដែល ត្រូវ ភ័យ ស្លន់ស្លោ ចំពោះ ដំណឹង នេះ ឡើយ ហើយ អ្នក នៅ តែ អាច ទទួលទាន នំប៉័ង ខ្លោច បាន ។
ប៉ុន្តែ អ្នក ជំនាញ បាន ចាត់ទុក ការសិក្សា ស្ដីពី សារធាតុ បង្ក ជំងឺមហារីក ដែល ត្រូវ បាន ធ្វើឡើង តែ នៅ សត្វ កណ្ដុរ ខណៈ ផលប៉ះពាល់ លើ មនុស្ស នៅ មិន ទាន់ មាន ការរកឃើញ ពី ទំនាក់ទំនង ។
វិទ្យាស្ថាន ស្រាវជ្រាវ ជំងឺ មហារីក ចក្រភព អង់គ្លេស បាន ឲ្យ ដឹងថា ៖
ប៉ុន្ដែ ភ័ស្ដុតាង ការសិក្សា លើ មនុស្ស បាន បង្ហាញ ដែរ ថា ប្រភេទ មហារីក ភាគច្រើន គ្មាន ទំនាក់ទំនង រវាង ជាតិពុល អាក្រីឡាមីដ និង ហានិភ័យ ជំងឺ មហារីក នោះ ទេ »៕
ស្វែងយល់ពីអាការលិង្គរឹងយូរដ៏ឈឺចាប់ នាំឲ្យបុរសអសមត្ថភាព
លិង្គ ងើប រឹង ដ៏ឈឺចាប់ អាច កើតឡើង លើ បុរស គ្រប់ វ័យ រួមទាំង ទារក ទើប តែ ប្រសូត ផងដែរ ។
ស្ថានភាព នោះ បាន កើតឡើង ពេល ចរន្ដឈាម ក្នុង លិង្គ ស្ទះ និង មិន ហូរ ចេញ ចូល ដូច ប្រក្រតី ។
លិង្គ រឹង លំហូរ ទាប កើតឡើង ពី ការស្ទះ ចរន្ដឈាម ពេល លិង្គ កំពុង ងើប រឹង ពេញបន្ទុក ។
លិង្គ រឹង លំហូរ ខ្ពស់ ជា អាការ កម្រ កើតមាន និង រមែង មិន បង្ក ឲ្យ ឈឺចាប់ ។
វា ជា លទ្ធផល កើតឡើង ដោយសារ បែក សរសៃឈាម ពី ការរងរបួស លិង្គ ឬ បរិវេណ ចន្លោះ រន្ធ គូទ និង ពងស្វាស ដែល រារាំង ចរន្ដឈាម ប្រក្រតី ក្នុង លិង្គ ។
ព្យាយាម នោម ងូតទឹក ក្ដៅ ឧណ្ហៗ ផឹកទឹក ច្រើន ដើរលេងៗ ព្យាយាម ធ្វើ លំហាត់ ប្រាណ ដូចជា ឈរជើង ទា ឬ រត់ នៅ នឹង កន្លែង ទទួល ទាន ឱសថ បំបាត់ ការឈឺចាប់ ដូចជា ប៉ារ៉ាសេតាម៉ុល បើ ចាំបាច់ ។
កុំ ស្អំ ទឹកកក ឬ ទឹក ត្រជាក់ លើ តួ លិង្គ ដែល អាច បង្ក ហានិភ័យ កាន់តែ ធ្ងន់ធ្ងរ កុំ រួមភេទ ឬ សម្រេច កាម ខ្លួនឯង ដែល មិន អាច ឲ្យ លិង្គ ស្រក វិញ បាន ឡើយ ។
កុំ ផឹក គ្រឿង ស្រវឹង កុំ ជក់ ។
គោលបំណង នៃ ការព្យាបាល គឺ បន្ទន់ លិង្គ និង រារាំង ការ ងើប រឹង ដ៏ឈឺចាប់ ឡើងវិញ និង អាច រួមបញ្ចូល ទាំង ការវះកាត់ តសរសៃ ការចាក់ ម្ជុរ តាម សរសៃ និង វះកាត់ បង្ហូរឈាម ៕
ស្វែងយល់ពីជំងឺធ្លាក់ទឹកចិត្ដ ប៉ះពាល់ដល់ចំណង់លើគ្រែ និងវិធីកែខៃបញ្ហានេះ
ជំងឺ ធ្លាក់ទឹក ចិត្ដ និង ទំនាក់ ទំនង ផ្លូវភេទ វេជ្ជបណ្ឌិត ឡែសេល សារ៉ាប៊ី ជា ជំនួយការ សាស្ដ្រាចារ្យ ផ្នែក ទំនាក់ទំនង មកពី សាកលវិទ្យាល័យ វ៉េស វើជីនៀរ បាន ឲ្យ ដឹងថា ៖
ជំងឺ ធ្លាក់ទឹក ចិត្ដ ក៏ អាច ធ្វើឲ្យ បុរស មាន អារម្មណ៍ « ឯកា និង កណ្ដោចកណ្ដែង » ដែល អាច ជ្រៀត ដល់ ចំណង់ ផ្លូវភេទ ឬ សមត្ថភាព ប្រលោម ស្នេហា ជាមួយ ដៃគូ ។
វេជ្ជបណ្ឌិត អ៊ីយ៉ាន ឃេន័រ ជា ចិត្ដ វិទូ និង ជា អ្នក ប្រឹក្សា ផ្លូវភេទ បាន និយាយ ថា ៖
« ពេល បុរស កើត ជំងឺ ធ្លាក់ទឹក ចិត្ដ នោះ ជំនឿ ចិត្ដ ពួកគេ ធ្លាក់ ចុះ ហើយ ភាព ស្វាហាប់ ក៏ ថមថយ រួម ទាំង អារម្មណ៍ ស្រើបស្រាល ផង ដែរ ។
បញ្ហា ទាំងនេះ អាច រំខាន ដល់ ចំណង់ ផ្លូវភេទ ឬ សមត្ថភាព បង្កើត ថាមពល សិច » ។
តែ ទោះ មាន ភាព ស្រើបស្រាល ក្ដី ក៏ ពេល បុរស ម្នាក់ កើត ជំងឺ ធ្លាក់ ទឹកចិត្ដ គេ អាច មាន អារម្មណ៍ រំខាន ចិត្ដ ច្រើន ពី ដៃគូ ។
ការជួសជុល បញ្ហា ដ៏ ស្មុគស្មាញ នេះ មិនមែន ជា រឿង ងាយស្រួល ដូច ការកែកុន អារម្មណ៍ ត្រេកត្រអាល នឹង សិច នោះ ទេ ។
អ្វី គួរ ធ្វើ បើ ជំងឺ ធ្លាក់ ទឹកចិត្ដ ប៉ះពាល់ ដល់ ជីវិត សិច វេជ្ជបណ្ឌិត អាមី ដេឡានី ជំនួយការ សាស្ដ្រាចារ្យ មកពី សាកលវិទ្យាល័យ មីលីឃីន រដ្ឋ អ៊ីលីណយ និង ជា អ្នកនិពន្ធ ការសិក្សា ឆ្នាំ ២០១៨ មួយ ស្ដីពី ជំងឺ ធ្លាក់ ទឹកចិត្ដ និង ចំណង់ ផ្លូវភេទ បាន និយាយ ថា ចំពោះ បុរស ធ្លាក់ ទឹកចិត្ដ ខ្លះ ដំណោះស្រាយ ពិត ជា ងាយ ជាង ការផ្លាស់ប្ដូរ ឱសថ ទៅ ទៀត ។
អ្នកស្រី បន្ថែម ថា ចំពោះ អ្នក ខ្លះទៀត ការប្រឹក្សា ជំនាញ គឺជា វិធី ល្អ បំផុត ។
ប៉ុន្ដែ បើ អ្នក មាន សម្ព័ន្ធភាព ស្នេហា ការប្រឹក្សា គួរតែ បញ្ចូល ទាំង ដៃគូ ផងដែរ ។
ការដក ឃ្លា ពី សិច មួយរយៈ គឺជា ជម្រើស ដ៏ប្រសើរ ដើម្បី រំសាយ សម្ពាធ ផ្លូវចិត្ត ខ្លះ មុន នឹង បណ្ដុះ ចំណង់ ផ្លូវភេទ សាជាថ្មី ។
ផ្ទុយ ទៅ វិញ អ្នក និង ដៃគូ គួរតែ សាកល្បង បង្កើន ចំណង់ សិច តាម វិធី ផ្សេង ដូចជា ការកាន់ដៃ និង ឱបថើប វិញ ។
ប៉ុន្តែ វេជ្ជបណ្ឌិត បញ្ជាក់ ថា បើ នៅ តែ អត់ មាន អារម្មណ៍ ចំពោះ រឿង នេះ ចូរ សាកល្បង វិធាន បញ្ច្រាស មក វិញ ។
ចេះតែ ព្យាយាម ធ្វើ ទៅ ទោះ គ្មាន អារម្មណ៍ ក៏ដោយ ។
អ៊ីចឹង ចូរ សាកល្បង កម្លាំង នៅ លើ កម្រាល ភ្លាម ទៅ ដើម្បី បញ្ជាក់ ពី សមត្ថភាព បេះដូង ដោយ មិន ចាំបាច់ ទៅ ហ្វឹកហាត់ លើ ម៉ាស៊ីន រត់ អ្វី ឡើយ ។
« លទ្ធផល ស្រាវជ្រាវ បាន ផ្ដល់ ភ័ស្ដុតាង ថា សមត្ថភាព អាវ៉ង់ អាច ជា វិធី ដ៏ងាយស្រួល និង មិន ចំណាយ ប្រាក់ ក្នុង ការជួយ វាយតម្លៃ កត្ដា ហានិភ័យ ជំងឺ បេះដូង គ្រប់ ទម្រង់ » ។
« យើង ដឹង ថា គ្មាន ការសិក្សា ណា តាមដាន ពី ទំនាក់ទំនង សមត្ថភាព អាវ៉ង់ ជា វិធី ដ៏ ងាយស្រួល ឥត ចំណាយ ប្រាក់ តែ មាន អត្ថប្រយោជន៍ ទៅ នឹង សុខភាព បេះដូង ឡើយ ។
យើង បាន តាមដាន ពី គុណប្រយោជន៍ នៃ ការវាយតម្លៃ សមត្ថភាព រាងកាយ ដូចជា ការអាវ៉ង់ និង ការរត់ លើ ម៉ាស៊ីន ព្រម ទាំង ទំនាក់ ទំនង ជាមួយ ឧប្បត្ដិហេតុ គ្រោះថ្នាក់ ជំងឺ បេះដូង ចំពោះ បុរស រឹងមាំ » ។
វេជ្ជបណ្ឌិត បាន បង្ហាញ ឲ្យ ដឹងថា ៖
« ជា មូលដ្ឋានគ្រឹះ ក្នុង ការវាយតម្លៃ ការអាវ៉ង អាច ជួយ កាត់បន្ថយ ហានិភ័យ ជំងឺ បេះដូង រហូត ដល់ ១០ ឆ្នាំ ក្នុង ចំណោម បុរស អាយុ ពី ២១ ទៅ ៦៦ ឆ្នាំ »៕
អ្នកជំនាញឱសថម្នាក់ថា ការប្រើថ្នាំវីតាមីនប៉ូវសុខភាពបីដូចជាការដុតលុយ
វេជ្ជបណ្ឌិត ផូល ក្លេតុន ជា ឱសថ វិទូ បាន និយាយ ថា ក្រុមហ៊ុន ភាគច្រើន ដែល ផលិត ថ្នាំ ប៉ូវ សុខភាព ប្រើ គ្រឿងផ្សំ អន់ៗ ដោយ គ្មាន ប្រយោជន៍ ចំពោះ សុខភាព តាមបែប វិទ្យាសាស្ដ្រ ឡើយ ។
វីតាមីន និង សារធាតុ រ៉ែ ប្រាកដ ជា មាន សារៈសំខាន់ ចំពោះ សុខភាព របស់ យើង គ្រប់ រូប តែ វេជ្ជបណ្ឌិត ក្លេតុន បាន អះអាង ថា ការទទួលទាន សារធាតុ ទាំងនេះ ជា ប្រភេទ ឱសថ គ្មាន គុណប្រយោជន៍ បន្ថែម អ្វី ឡើយ ។
ក្នុងចំណោម វីតាមីន ទាំងនោះ ឱសថ វីតាមីន ចម្រុះ អូមេហ្គា ៣ និង វីតាមីនសេ វា គ្មាន ភ័ស្ដុតាង បែប វិទ្យាសាស្ដ្រ បញ្ជាក់ ពី គុណប្រយោជន៍ របស់ វា ឡើយ » ។
វេជ្ជបណ្ឌិត បាន បន្ដ ថា ៖
វា មិន ប៉ះពាល់ សុខភាព អ្វី ក្រៅពី ការ ខ្ជះខ្ជាយ លុយកាក់ ឡើយ » ។
ហាងម៉ាស្សាបុរសខោចែវ សាច់ដុំ មានការចាប់អារម្មណ៍ខ្លាំងពីសំណាក់បរទេស
ចំណែកឯ ការ ម៉ាស្សា គឺ បុគ្គលិក របស់ យើង មាន ឯកសណ្ឋាន ត្រឹមត្រូវ មាន ខោចែវ និង អាវ វាល ក្លៀក ។
« ដោយសារ តែ បុគ្គលិក សុទ្ធតែ ជា បុរស ដូចនេះ ខ្លាច មាន បញ្ហា អ្វី ។
ហាង ម៉ាស្សា បុរស នេះ ត្រូវ បាន បង្កើតឡើង ឲ្យ ខុសប្លែក ពី កន្លែង ម៉ាស្សា ដទៃទៀត ដែល មាន បុគ្គលិក ភាគច្រើន ជា នារី ដើម្បី ផ្ដល់ ឱកាស ការងារ ប្រាក់ខែ សមរម្យ ដល់ បុគ្គលិក ប្រុសៗ មកពី ខេត្ត និង ជនបទ ។
ស្ថិត នៅក្នុង ចំណោម បុគ្គលិក សាច់ដុំ ស្លៀក ខោចែវ លោក ចាន់ សាយ អាយុ ២៨ ឆ្នាំ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្ដិ៍ ថា ៖
« ពេល មក ធ្វើការ នៅ ទី នេះ ជីវិត ខ្ញុំ ផ្លាស់ប្តូរ ច្រើន ចេះ ពី របៀប ម៉ាស្សា ពី ធ្វើការ ធ្ងន់ មក ធ្វើការ ស្រាល ហើយ ផ្លាស់ប្តូរ ទម្លាប់ អាក្រក់ មក ល្អ ។
ខ្ញុំ អាច រៀន ភាសា អង់គ្លេស បាន ទៀត ពី ភ្ញៀវ បរទេស និង ទទួល បាន ប្រាក់ ចំណូល គួរសម ។
ហាង ម៉ាស្សា ដែល ទទួល អាជ្ញាប័ណ្ណ ឲ្យ បើក ដំណើរការ ពី ក្រសួង ពាណិជ្ជកម្ម ស្របច្បាប់ នេះ មាន ការតុបតែង មាន ប្រកប ដោយ ផាសុកភាព បំពាក់ ម៉ាស៊ីនត្រជាក់ គ្រឿង ក្រអូប បែប បុរាណ ខ្មែរ និង ផ្លែឈើ ដើម្បី ឲ្យ មាន ក្លិន បរិយាកាស បែប ធម្មជាតិ ។
ទន្ទឹម នឹង បុគ្គលិក មាន ជំនាញ ម៉ាស្សា ច្រើន ក្បាច់ និង ច្រើន ប្រភេទ ផលិតផល ដែល ប្រើប្រាស់ ត្រូវ បាន នាំចូល ពី ប្រទេស ថៃ ដោយ មាន ឈ្មោះ និង ការផលិត ត្រឹមត្រូវ ។
ការ លោត ហក់ លើដី ឬ លើ ប្រអប់ ជា ប្រភេទ កីឡា ដែល ក្រុម អ្នកវិទ្យាសាស្ដ្រ ថា វា មាន ថាមពល គ្រប់ ល្មម និង ពង្រឹង សមត្ថភាព ជើង ក៏ ដូចជា សាច់ដុំ ភ្លៅ ដើម្បី ការពារ បញ្ហា សឹក ឆ្អឹង ដែល រមែង កើតឡើង ពេល ចម្រើន វ័យចាស់ ។
វេជ្ជបណ្ឌិត ហ្គាល់លីន ម៉ុងហ្គូមេរី មកពី សាកលវិទ្យាល័យ ទីក្រុង មេនឆេស្ទ័រ ដែល ធ្វើ តេស្ដ លើ លំហាត់ ប្រាណ ចំពោះ ស្ដ្រី ១៤ នាក់ ក្នុង វ័យ ខ្ទង់ ៥០ ឆ្នាំ បាន និយាយ ថា ៖
ធម្មតា ការដើរ ហាត់ប្រាណ នៅ មិន ទាន់ គ្រប់គ្រាន់ ចំពោះ សុខភាព ឆ្អឹង នោះ ទេ ហើយ យើង រំពឹង ថា ចលនា នេះ លើក ទឹកចិត្ដ ដល់ ស្ដ្រី កាន់តែ ច្រើន ធ្វើ លំហាត់ប្រាណ ដ៏ត្រឹមត្រូវ » ។
ស្ដ្រី ក្នុង ការសិក្សា នេះ ទទួល បាន លទ្ធផល ដ៏ល្អ ពី ការធ្វើ ចលនា លោត ហក់ តិចៗ ដោយ ការ គ្រវី ដៃ ឡើងលើ និង លោត ចុះក្រោម ។
ពួកគេ ក៏ បាន លោត ចុះ ឡើងលើ ប្រអប់ កម្ពស់ ២ តឹក និង លោត លំនឹង កែងជើង ដែល ធ្វើ ចលនា លើ ចុងជើង ចំទើត ខ្ពស់ មុន ពេល ទម្លាក់ កែងជើង វិញ ។
ជាមួយ កម្លាំង សម្ពាធ លើ សាច់ដុំ ស្ដ្រី ដែល វាស់វែង ដោយ អគ្គិសនី វិភាគ គេ ជឿ ថា វា គ្រប់គ្រាន់ ក្នុង ការពង្រឹង ឆ្អឹង ។
វេជ្ជបណ្ឌិត ម៉ុងហ្គូមេរី បាន និយាយ ថា ប្រសិទ្ធភាព នៃ លំហាត់ ប្រាណ ស្មើនឹង ការទទួល កំហាប់ រ៉ែ ឆ្អឹង ប្រមាណ ២ ភាគរយ ក្នុង ១ ឆ្នាំ ដែល អាច គ្រប់គ្រាន់ ក្នុងការ ទប់ទល់ នឹង ជំងឺ ពុក ឆ្អឹង នៅ វ័យជ្រេ ៕
ការចេះស្រឡាញ់ខ្លួនឯងអាចលើកកម្ពស់ផ្លូវចិត្ត និងសម្រួលចង្វាក់បេះដូង
ការស្រឡាញ់ ខ្លួនឯង គឺជា ការចំណាយ ផ្គត់ផ្គង់ តម្រូវការ ផ្ទាល់ខ្លួន មាន ជំនឿ ចិត្ត លើ ខ្លួន និង ផ្ដល់ តម្លៃ ឲ្យ ខ្លួនឯង ដោយ មិន ខ្វាយខ្វល់ ពី ទស្សនៈ អ្នកដទៃ ។
« ការយល់ យើញ របស់ ខ្ញុំ គឺថា មនុស្ស ដែល ងាយ នឹង ប្រឈម ការបាក់ ទឹកចិត្ត តែងតែ រង ឥទ្ធិពល ពី គំនិត អវិជ្ជមាន និង មាន ការបារម្ភ គិតគូរ ពី អ្នកដទៃ ច្រើន មិន សូវ ខ្វល់ ពី ខ្លួនឯង » ។
ក្រុម ដែល ស្រឡាញ់ ខ្លួនឯង និង មិន សូវ ខ្វល់ ពី អ្នកដទៃ បាន បង្ហាញ សញ្ញា នឹងនរ ផ្នែក អារម្មណ៍ មាន ចង្វាក់ បេះដូង លោត ទាប ថេរ និង មិន សូវ បែកញើស ។
យ៉ាងណា មិញ សញ្ញា ទាំងនេះ មិន អាច បង្ហាញ ពី ទំនាក់ទំនង រវាង ការស្រឡាញ់ ខ្លួនឯង និង ស្ត្រេស ដែល ជា ផ្នែក មួយ នៃ ហានិភ័យ នៃ ជំងឺ បាក់ ទឹកចិត្ត នោះ ទេ ។
ការសិក្សា នេះ ក៏ តាមដាន តែ និស្សិត មាន សុខភាព ល្អ ។
ដូច្នេះ ហើយ ក្រុម អ្នកវិទ្យាសាស្ត្រ គ្រោង នឹង ធ្វើការ សិក្សា ទ្រង់ទ្រាយ ធំ និង ពិសោធ តាមដាន ឲ្យ ទូលំទូលាយ លើ មនុស្ស ច្រើន ជាង នេះ ដើម្បី បញ្ជាក់ ឲ្យ ដឹងថា តើ ការស្រឡាញ់ ខ្លួនឯង ពិតជា ជួយ ដល់ សុខភាព ផ្លូវកាយ និង ចិត្តខ្លាំង កម្រិត ណា ?
កុមាររស់ក្នុងបរិស្ថានខ្យល់កខ្វក់ ងាយកើតចំណង់អាហារខ្លាញ់ខ្ពស់
ក្រុម អ្នក ស្រាវជ្រាវ បាន និយាយ ថា កម្រិត ខ្យល់ ធូលី ច្រើន ក្នុង បរិយាកាស ដែល ចេញពី រោងចក្រ និង យានយន្ត មាន ទំនាក់ទំនង នឹង ការបង្កើន អត្រា ការទទួល ទាន អាហារ ខ្លាញ់ ចម្រាញ់ ខ្ពស់ រហូត ដល់ ទៅ ៣៤ ភាគរយ ។
មិន ច្បាស់ ថា តើ វា បណ្ដាល មកពី មូលហេតុ អ្វី ឡើយ ទោះបី ជា ក្រុម អ្នក ជំនាញ បាន និយាយ ថា វា អាច មកពី ការរំខាន នៃ បរិស្ថាន កខ្វក់ ទៅ លើ រាងកាយ ដែល ស្រូប ថាមពល ពី ចំណីអាហារ ធ្វើឲ្យ កម្រិត ជាតិ ស្ករ ធ្លាក់ចុះ និង បង្កើន ចំណង់ ឃ្លាន អាហារ ។
ក្រុម ការងារ មកពី សាកល វិទ្យាល័យ កាលីហ្វ័រនីញ៉ា ខាងត្បូង បាន ឲ្យ ដឹងថា ភ័ស្ដុតាង របស់ ពួកគេ បាន បង្ហាញ ថា ការ បន្ទាប កម្រិត ខ្យល់ កខ្វក់ អាច ជា វិធី ទប់ស្កាត់ បញ្ហា ធាត់ លើស ទម្ងន់ របស់ ពលរដ្ឋ សហរដ្ឋអាមេរិក ។
ចំពោះ ការសិក្សា ដែល ចុះផ្សាយ ក្នុង ព្រឹត្ដិបត្រ អាមេរិក សម្រាប់ ជីវជាតិ អាហារ សុខភាព ក្រុម ការងារ បាន តាមដាន កុមារ ៣១០០ នាក់ និង រកឃើញ ថា កុមារ ប៉ះពាល់ នឹង ខ្យល់ កខ្វក់ កាន់តែ ខ្លាំង ជាពិសេស ពី ចរាចរណ៍ តាម ដងផ្លូវ ពួកគេ មាន ចំណង់ ឃ្លាន អាហារ ខ្លាញ់ កាន់តែ ខ្លាំង ។
កម្រិត ខ្យល់ សុវត្ថិភាព នីត្រូឌីអុកស៊ីដ ត្រូវ បាន កំណត់ ដោយ ទីភ្នាក់ងារ ការពារ បរិស្ថាន ត្រឹម បរិមាណ ១០០ លើ ១ ពាន់ លាន ក្នុង ១ ម៉ោង ។
« ដោយ ការវិវត្ដ ខួរក្បាល ពី កុមារ ទៅ ពេញវ័យ វា ជា គម្លាត ពេលវេលា ដែល កត្ដា បរិស្ថាន អាច មាន ឥទ្ធិពល យូរអង្វែង លើ ខួរក្បាល និង អត្ដចរិត »៕
កើតជំងឺផ្ដាសាយ សាកល្បងបន្ដក់ស៊ីរ៉ូមប្រៃ និងខ្ពុរមាត់ទឹកអំបិល
អ្នកជំងឺ ដែល ប្រើ វិធី នេះ ទំនង ជា ត្រូវការ ឱសថ ក្រៅ វេជ្ជបញ្ជា តិចតួច និង មិន សូវ ចម្លង ដល់ សមាជិក គ្រួសារ ដទៃ ។
អ្នក ប្រើ វិធី បណ្ដក់ ច្រមុះ និង ខ្ពុរ ទឹកអំបិល អាការ ផ្ដាសាយ របស់ ពួកគេ ឆាប់ ជាសះស្បើយ មុន ជិត ២ ថ្ងៃ ដោយ ឈប់ តឹង ច្រមុះ ជិត ៣ ថ្ងៃ មុន ជាង អ្នក ដែល បណ្ដែតបណ្ដោយ ឲ្យ ជំងឺ ផ្ដាសាយ ញាំញី តាម យថាកម្ម ។
មេរោគ ផ្ដាសាយ បាន សាយភាយ តាម ខ្យល់ តាមរយៈ ការហាមាត់ និយាយ និង ដកដង្ហើម ហើយ លទ្ធភាព ដែល កើត អាច ត្រូវ បាន វាស់វែង ដោយសារ « កម្រិត បរិមាណ នៃ មេរោគ » លើ នរណា ម្នាក់ ។
ជាទូទៅ មនុស្ស ពេញវ័យ កើត ជំងឺ ផ្ដាសាយ ជា មធ្យម ៣ ដង ក្នុង ១ ឆ្នាំ ដែល វា គ្រប់គ្រាន់ ធ្វើឲ្យ អារម្មណ៍ មួហ្មង តែ ផ្ដាសាយ ក៏ មាន អានុភាព បង្ក ជា ជំងឺ ផ្លូវដង្ហើម ដូចជា រោគ រលាក សួត ផង ដែរ ៕
វេជ្ជបណ្ឌិតឲ្យប្រយ័ត្ន កុំឲ្យដាំទឹកថ្នាំរុក្ខជាតិងូតឲ្យកុមារជំងឺពងបែក
អាការ នេះ ក៏ អាច នឹង បាត់ ទៅវិញ ដោយសារ យើង ប្រើ ថ្នាំ បញ្ចុះ កម្តៅ និង ព្យាយាម ងូតទឹក ក្តៅ ឧណ្ហៗ ឲ្យ កុមារ ។
រីឯ រោគសញ្ញា ជំងឺ ពងបែក ប្រភេទ EV71 វេជ្ជបណ្ឌិត បម្រើការ នៅ មន្ទីរពេទ្យ កុមារ ជាតិ ក៏ បាន បញ្ជាក់ ដែរ ថា ៖
លោក ក៏ បាន ផ្តាំ ផង ដែរ ថា កុំ ដាំទឹក ជាមួយ ស្លឹកឈើ ឬ រុក្ខជាតិ ផ្សេងៗ ដែល ប្រជាជន គិត ថា ជា ថ្នាំ ឲ្យ កុមារ ងូត ឲ្យ សោះ ព្រោះ វា ប៉ះពាល់ ខ្លាំង ដល់ កុមារ អ្នកជំងឺ ពងបែក ។
កម្ទេចកម្ទី ឫស ឈើ អាច បណ្តាល ឲ្យ មាន បាក់តេរី ផ្សេងៗ ធ្វើ ឲ្យ សុខភាព កុមារ រឹតតែ យ៉ាប់ ។
« គ្រាន់តែ ប្រើ ថ្នាំ បញ្ចុះ កម្តៅ ធម្មតា កុំ ប្រើ ថ្នាំ ផ្សះ ប្រើ ថ្នាំ ស្វាយ ឬ បេតាឌីន ទៅ លើ ដំបៅ ពងបែក ងូតទឹក ឲ្យ កុមារ ឲ្យ បាន ញឹកញាប់ និង បរិភោគ ទឹក ឲ្យ បាន ច្រើន បន្ថែម អាហារ ដែល ទន់ ងាយ ញ៉ាំ ឲ្យ កុមារ ទទួលទាន ដើម្បី ជួយ សម្រួល ដល់ បំពង់ក កុមារ កំពុង តែ ឈឺ » ។
