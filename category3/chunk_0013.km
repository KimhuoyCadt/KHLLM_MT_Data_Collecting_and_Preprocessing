អ្នកវិទ្យាសាស្ត្ររំឭកថា គេងគ្រប់ ៧ ម៉ោង គ្មានន័យទេ បើដំណេកមិនទៀងទាត់
មនុស្ស ភាគច្រើន គិតថា ម៉ោង ដំណេក យកមក អនុវត្ដ តែ កុមារ ប៉ុណ្ណោះ ហើយ ពេល ឈាន ដល់ វ័យ ចូល រៀន សាកល វិទ្យាល័យ វា លែង ចាំបាច់ ទៀត ហើយ។
យ៉ាងណាមិញ ការស្រាវជ្រាវ ថ្មី ដែល ចុះផ្សាយ នាពេលថ្មីៗនេះ ក្នុង ព្រឹ ត្ដិ បត្រ របាយ ការណ៍ វិទ្យាសាស្ដ្រ បាន បង្ហាញ ថា មនុស្ស ពេញ វ័យ ដែល មិន ខ្វល់ ពី ម៉ោង ដំណេក ទៀង ទាត់ ហាក់ ចាប់ ឱកាស ឡើង ទម្ងន់ ខ្លាំង ជាង សុខភាព មិន សូវ ជាង កម្រិត ជាតិ ស្ករ ខ្ពស់ ជាង និង សម្ពាធ ឈាម ខ្ពស់ ជាង។
វេជ្ជបណ្ឌិត ចេស ស៊ីកា លុន ហ្វ ដ អា វើ រី ជំនួយការ សាស្ដ្រាចារ្យ ផ្នែក ចិ ត្ដ វិទ្យា និង វិទ្យាសាស្ដ្រ អត្ដចរិត បាន ផ្ដល់ ឲ្យ អ្នក ចូលរួម អាយុ ពី ៥៤ ទៅ ៩៣ ឆ្នាំ នូវ ឧបករណ៍ ដែល តាម ដាន កាល វិភាគ ដំណេក ដ៏ ជាក់ លាក់ រហូត ដល់ នាទី នៃ ម៉ោង។
ពួកគេ បាន រកឃើញថា អ្នកលើសឈាម ទំនង គេង ច្រើន ម៉ោង ហើយ អ្នក ធាត់ ជ្រុល ទំនង ជា នៅ ដល់ យប់ៗ ជ្រៅ មុន ពេល គេង។
ប៉ុន្ដែ សំខាន់ ពួកគេ បាន រក ឃើញ ថា ដំណេក ទៀង ទាត់ របស់ បុគ្គល ណា ម្នាក់ គឺជា វិធី វាស់ ស្ទង់ សុខភាព បេះដូង និង ហានិភ័យ ជំងឺ ប្រព័ន្ធ រំលាយ អាហារ ដ៏ ល្អ បំផុត។
អ្នក គេង មិន ទៀងទាត់ ក៏ ទំនងជា អាច កើត ជំងឺ ធ្លាក់ទឹកចិត្ដ និង ស្ដ្រេ ស ជាង អ្នក គេង ទៀង ទាត់ ដែល បញ្ហា ទាំង ២ នេះ មាន ទំនាក់ ទំនង ទៅ នឹង សុខភាព បេះដូង ផង ដែរ។
មិនស្មានថា ស្រាទំពាំងបាយជូរក្រហមជួយអ្នកជំងឺសន្លាក់ជង្គង់ដល់ម្លឹងសោះ
សារធាតុ ដ៏ មាន ឥទ្ធិពល សម្បូរ ក្នុង ស្រា ទំពាំង បាយ ជូរ ក្រហម អាច ជួយ អ្នក ជំងឺ សន្លាក់ ឆ្អឹង រាប់ លាន នាក់ ទប់ ទល់ នឹង ការ ឈឺ ចាប់ រៀង រាល់ ថ្ងៃ។
យោងតាម ក្រុម អ្នក វិទ្យាសាស្ដ្រ អ៊ី រ៉ា ក់ ដែល បាន សិក្សា លើ បញ្ហា នេះ បាន បង្ហាញថា ពួកគេ ក៏បាន កាត់ បន្ថយ ការ រលាក ឆ្អឹង សន្លាក់ ជង្គង់ ផង ដែរ។
មនុស្ស ៨ លាន នាក់ នៅ ចក្រភព អង់គ្លេស និង ៥៤ លាន នាក់ នៅ សហរដ្ឋអាមេរិក កើត ជំងឺ សន្លាក់ ឆ្អឹង ពេល សឹក ឆ្អឹង ខ្ចី ជា បន្ដ បន្ទាប់។
ក្រុម អ្នកវិទ្យាសាស្ដ្រ នៅ សាកលវិទ្យាល័យ អាល់រ៉ា ហ្វី ដែន ក្នុង ក្រុង បា កដាដ បាន ដឹកនាំ ការ សិក្សា រយៈពេល ៣ ខែ លើ អ្នក ជំងឺ ១១០ នាក់។
ពួកគេ ក៏បាន កាត់ បន្ថយ កម្រិត រលាក ដែល តែង តែ កើត ឡើង ចំពោះ អ្នក ជំងឺ សន្លាក់ ជង្គង់។
អ្នកជំនាញជំរុញប្ដីប្រពន្ធរួមភេទមួយរាត្រី ២ ដង ដើម្បីបង្កើនឱកាសមានកូន
ក្រុម អ្នក វិទ្យាសាស្ដ្រ បាន រក ឃើញ ថា មេជី វិត ប្រមូល ផ្ដុំ គ្នា រយៈពេល ៣ ម៉ោង ក្រោយ បុរស បាញ់ ទឹកកាម ធ្វើ ដំណើរ ឆ្លង កាត់ ដៃ ស្បូន យ៉ាង លឿន បំផុត និង ទំនង ជា អាច បង្ក កំណើត បាន ឆាប់។
លទ្ធផល រកឃើញ រប ស់ ចិន មាន លក្ខណៈ ខុសប្លែក ពី ជំនឿ ដែលថា បុរស ម្នាក់ ត្រូវ ចំណាយ ពេល ពី ២៤ ទៅ ៣៦ ម៉ោង ដើម្បី បង្កើត មេជី វិត ថ្មីៗ ក្រោយ ពី បាញ់ ទឹក កាម ម្ដង។
លទ្ធភាព គ្មាន កូន បានកើត ឡើងលើ ស្ដ្រី ប្រមាណ ១១ ភាគរយ និង បុរស ៩ ភាគរយ ក្នុង វ័យ ផលិត កូន នៅ សហរដ្ឋ អាមេរិក ហើយ នៅ អង់គ្លេស ប្ដី ប្រពន្ធ ១ គូ ក្នុង ចំណោម ៧ គូ ជួប នឹង បញ្ហា ពិបាក មាន កូន។
គំរូ ទឹកកាម ដែល យក ពី បុរស ២៥០ នាក់ និង ក្រោយ ការបាញ់ បញ្ចេញ ទឹកកាម រយៈពេល ប៉ុន្មាន ម៉ោង ក្រោយ។
ក្រុម អ្នក ស្រាវ ជ្រាវ ដែល ដឹកនាំ ដោយ វេជ្ជបណ្ឌិត ដា លី នៅ មន្ទីរពេទ្យ សេន ជិង បាន រក ឃើញ ថា មេជី វិត ដែល ត្រូវ បាន ផលិត ឡើង មិន យូរ ប៉ុន្មាន ក្រោយ ពី បុរស បាញ់ បញ្ចេញ ទឹកកាម មាន ប្រូតេអ៊ីន ល្អៗ ច្រើន និង ធ្វើ ចលនា លឿន បំផុត។
មេជី វិត ថ្មីៗ មាន កម្រិត ប្រូតេអ៊ីន ខ្ពស់ និង សក្ដានុ ពល ក្នុង ការ ចាប់ តោង ស៊ុត ញី។
ក្រុម អ្នកវិទ្យាសាស្ដ្រ បាន និយាយថា ងាវ អាច ត្រូវបាន ប្រើ សម្រាប់ ព្យាបាល កុមារ កើត ជំងឺ មហារីក ពី ព្រោះ វា អត់ បង្ក ការ ឈឺ ចាប់ និង ជះ ឥទ្ធិពល អវិជ្ជមាន តិច តួច បំផុត។
គ្រឿង សមុទ្រ នេះ មានតម្លៃ ថោក និង អាចមាន ប្រសិទ្ធភាព ស្មើនឹង ឱសថ គីមី មួយចំនួន។
ក្រុម អ្នក វិទ្យាសាស្ដ្រ បាន ធ្វើ តេស្ដ ការ ព្យាបាល ដ៏ ចម្លែក នេះ លើ ជំងឺ ឈាម សស៊ី ឈាម ក្រហម ជំងឺ មហារីក សុដន់ សួត និង ពោះវៀន និង បាន ប្រាប់ ថា លទ្ធផល របស់ ពួកគេ នឹង ក្លាយជា តម្រុយ ដ៏ ជោគ ជ័យ។
ប៉ុន្ដែ ការទទួល ទាន ងាវ នឹង មិនអាច ព្យាបាល មហារីក បានឡើយ ដែល ក្រុម អ្នក វិទ្យាសាស្ដ្រ បាន ឲ្យ ដឹង ថា ស្ករ ប្រភេទ ខ្លះ ត្រូវតែ ញែក ចេញ ដាច់ ដោយ ឡែក និង ផលិត ជា ឱសថ សម្រាប់ ចាក់ ចូល សព៌ាង្គ កាយ វិញ។
ការសិក្សា ពីសា កល វិទ្យាល័យ សាល់ ហ្វ ដ ក្នុង ក្រុង មេន ឆេ ស្ទើរ បានធ្វើការ ស្រាវ ជ្រាវ វែក ញែក កោសិកា មហារីក ក្នុង មន្ទីរ ពិសោធន៍។
ក្រុម អ្នក ជំនាញ អះអាង ថា ស្ករ ញែក ចេញ ពី ងាវ ទូទៅ អាច មាន ប្រសិទ្ធ ភាព បង្ក្រាប មហារីក ដូច នឹង ឱសថ គីមី ស្ដង់ដារ មួយ ចំនួន និង ប្រើ តែ ក្នុង កម្រិត តិច តួច ប៉ុណ្ណោះ។
ពេល ជាតិ ស្ករ ជ្រាបចូល កោសិកា ដុំ សាច់ វា បាន ផលិត នូវ អ្វីដែល ក្រុម អ្នកវិទ្យាសាស្ដ្រ បាន ហៅថា «សកម្មភាព ប្រឆាំង នឹង ការ រីក រាល ដាល» ឬ បញ្ឈប់ ការ ដុះ រីក ធំ នៃ ការ កោសិកា មហារីក។
ប្រមាញ់ ពី ព្រៃ នៅ ភាគ ខាងជើង ប្រទេស សាច់ ពស់ ត្រូវបាន ជនជាតិ វៀតណាម ខ្លះ ជឿថា វា បាន ជួយ បញ្ចុះ កម្ដៅ ក្នុង រាង កាយ កែ អាការ ឈឺ ក្បាល និង សម្រួល ដល់ ប្រព័ន្ធ រំលាយ អាហារ ថែម ទៀត។
«សត្វ ពស់ មានគុណ ប្រយោជន៍ ទាំងអស់ លើក លែង តែ ក្បាល និង ស្រកា របស់ វា តែ ប៉ុណ្ណោះ»។
ពលរដ្ឋ វៀតណាម ជឿថា សម្រាប់ ស្រា ពិសេស នេះ មានតែ បុរស អាយុ លើស ៥០ ប៉ុណ្ណោះ គួរ តែ ផឹក ស្រា ឈាម ពស់ ឬ យុវជន ស្ទាវៗ ដែល ជួប បទពិសោធ ឈឺ ឆ្អឹង ខ្នង ឬ អសមត្ថភាព ផ្លូវភេទ។
នេះ បើ យោង តាម ម្ចាស់ ភោជនីយដ្ឋាន លោក ដួង ឌុកដុក។
បន្ថែម លើ គុណប្រយោជន៍ ដែលម្នាក់ៗជឿថា វា ប៉ូវ សមត្ថភាព ផ្លូវភេទ នោះ អ្នក ប្រកបរ បរចាប់ ពស់ ៣ ទសវត្សរ៍ រូប នេះ បាន ប្រាប់ ផង ដែរ ថា៖
វា មាន រស ជាតិ ឆ្ងាញ់ ល្អ ចំពោះ សុខភាព និង ឆ្អឹង ឆ្អែង របស់ លោក អ្នក»។
អ្នកជំនាញ សត្វព្រៃ រូបនេះ ថ្លែងថា៖
កុំបារម្ភ! ញ៉ាំទឹកដោះគោ មិនធ្វើឲ្យស្លេស្ម៍ច្រើនបង្កើនអាការក្អកឡើយ
ប៉ុន្ដែ ក្រុម អ្នកវិទ្យាសាស្ដ្រ បានបង្ហាញ ថា ជំនឿតៗគ្នា នេះ ជា រឿង មិន ពិត ទេ ហើយ បាន និយាយ ថា កុមារ គួរ តែ ត្រូវ បាន ផ្ដល់ ទឹក ដោះ ដោយ សារ ជាតិ កាល់ ស្យូម មាន សារៈ សំខាន់ ចំពោះ សុខភាព ឆ្អឹង។
ជំនឿ សុខភាព នេះ មាន ដើម កំណើត មកពី មេដឹកនាំ អបិយ ជំនឿ ម្នាក់ កាលពី ឆ្នាំ ១២០៤ និង ត្រូវ បាន និយាយ តៗ គ្នា រាប់ រយ ឆ្នាំ ដោយ គ្មាន ភ័ស្ដុតាង វិទ្យាសាស្ដ្រ បញ្ជាក់។
ផ្ទុយទៅវិញ មនុស្ស ទូទៅ ទំនងជា គិតថា ទឹកដោះគោ ធ្វើ ឲ្យ រាងកាយ ផលិត ស្លេស្ម៍ និង ទឹក សម្បោរ កាន់ តែ ច្រើន ពេល វា លាយ ជាមួយ ទឹក មាត់ និង ធ្វើ ឲ្យ មាន អាការ ស្អិត ក្នុង មាត់។
តែ ក្រុម អ្នកស្រាវជ្រាវ បាន និយាយថា វា សំខាន់ សម្រាប់ ឪពុកម្ដាយ ដែល មិនគួរ បញ្ឈប់ ឲ្យ កូន ទទួល ទាន ទឹក ដោះ គោ ពីព្រោះ វា ជា ថាមពល ដ៏ ចាំបាច់ និង សម្បូរ វីតាមីន និង រ៉ែ។
ក្រុម អ្នកវិទ្យាសាស្ដ្រ មកពី សាកលវិទ្យាល័យ វ៉ារ វិក ដែល បាន ដឹកនាំ ការសិក្សា ចុះផ្សាយ ក្នុង ខែ មេសា បាន ឲ្យ ដឹង ថា វា មាន ទំនាក់ ទំនង បេះដូង មិន ដាច់ រវាង កង្វះ ដំណេក និង បញ្ហា ទម្ងន់។
តួលេខ បាន បង្ហាញថា កុមារ បឋមសិក្សា ចំនួន ជិត ពាក់កណ្ដាល ប្រឈម នឹង បញ្ហា ធាត់ លើស ទម្ងន់ នៅ តាម តំបន់ ខ្លះៗ នៃ ប្រទេស អង់គ្លេស។
«កម្ដៅ សំណើម ការ ប៉ះ ទង្គិច និង ពន្លឺ អាច ប៉ះពាល់ គុណភាព ស្រោម អនាម័យ និង កាត់ បន្ថយ ប្រសិទ្ធ ភាព របស់ វា»។
ទាំង កាបូប និង ហោប៉ៅ ជាទី តាំង ផ្ទុក កម្ដៅ ខ្លាំង សម្រាប់ ស្រោម ខណៈ វា តោង ភ្ជាប់ នឹង រាងកាយ របស់ អ្នក រួម ទាំង កម្ដៅ ផ្សេង។
ពេល ស្រោម អនាម័យ ទទួល កម្ដៅ ខ្លាំង ពេក ជាតិ ជ័រ កាន់ តែ ថយ គុណភាព និង ធ្វើ ឲ្យ ងាយ ដាច់ រហែក។
ពេល ប្រើប្រាស់ អ្នក ប្រាកដជា បន្ថែម កម្លាំង ប៉ះពាល់ កាន់តែខ្លាំង ដែល ធ្វើ ឲ្យ ស្រោម កាន់តែ ខ្សោយ គុណភាព។
ហោប៉ៅ ក្រោយ ជា ប្រភព កម្លាំង កកិត យ៉ាងខ្លាំង ពេល អ្នកដើរ អង្គុយ ឬ រត់ ជា ដើម។
កាបូប លុយ ដែល រមែង បើក បិទ ហូត លុយ ញឹកញយ នឹង បង្ក ការប៉ះទង្គិច ច្រើន ពិសេស ពេល ស្រោម ប៉ះពារ នឹង កាក់ ឬ ក្រដាស ប្រាក់ ជាដើម។
គេងស្រាតអាចជួយទាំងផ្លូវភេទ ទំនាក់ទំនងស្នេហា និងសុខភាព
អត្ថប្រយោជន៍ នៃ ដំណេក អាក្រាត មាន ច្រើន លើសពី ទំនាក់ទំនង ស្នេហា ស្អិតល្មួត ដោយ ភាព អាក្រាត ជួយ បង្កើន គុណភាព ដំណេក ជា ទូទៅ។
សម្រាត សម្លៀកបំពាក់ មុនពេល ចូល គេង កាត់បន្ថយ សីតុណ្ហភាព លើ ស្បែក កាត់ បន្ថយ ឱកាស ភ្ញាក់ ពី ដំណេក អំឡុង ពេល រាត្រី អនុញ្ញាត គេង ស្កប់ ស្កល់។
ដំណេក អាក្រាត ក៏ ជួយ កាត់ បន្ថយ ស្ដ្រេស និង សាច់ ដុំ រឹង ប៉ឹង ថែម ទៀត។
តាម ការស្រាវជ្រាវ ៧០ ភាគរយ នៃ កំណើន អ័រម៉ូន បុរស រមែង កកើតឡើង អំឡុង ពេលដេក។
ដូច្នេះ ការ រំខាន ដំណេក អាច កំហិត ការ កកើត អ័រម៉ូន។
ការបង្កើន គុណភាព ដំណេក ជួយ ដល់ ប្រព័ន្ធ រំលាយ អាហារ រហូតដល់ ២៩,៨ ភាគរយ ដុត បំផ្លាញ ខ្លាញ់ អវិជ្ជមាន ១៧,២ ភាគរយ លើ រយៈពេល សិក្សា ១២ សប្ដាហ៍។
ទម្លាប់ប្រើអុសធ្យូង ចម្អិនអាហារ បង្កើនហានិភ័យនៃជំងឺបេះដូង
ការ សិក្សា មួយ បាន បង្ហាញ ថា មនុស្ស ដែល ប្រើប្រាស់ អុស ឬ ធ្យូង ចម្អិន អាហារ អាច មាន ហានិភ័យ នៃ ការស្លា ប់ ដោយ ជំងឺ បេះដូង ឬ ជំងឺ ដាច់ សរសៃ ឈាម ក្នុង ខួរក្បាល រហូត ដល់ ១២ ភាគរយ។
ការសិក្សា ស្រាវជ្រាវ នេះ បាន បន្ថែម ទៅលើ ការអះអាង កាលពី ពេលថ្មីៗដែលថា សាច់ ដែល ចម្អិន ដោយ បាប៊ីយ្យូ បញ្ចេញ សារ ជាតិ គីមី ពុល ដែល ពាក់ ព័ន្ធ ទៅ នឹង មហារីក ស្បែក សួត និង តម្រង នោម ផង ដែរ។
ទោះបីជា អុស និង ធ្យូង មិនសូវ ប្រើ នៅ ប្រទេស លោកខាងលិច ក៏ដោយ ក៏ ការ ចម្អិន បែបនេះ តែ ម្តង ក្នុង មួយ សប្តាហ៍ គឺ អាច មាន ហានិភ័យ គ្រប់ គ្រាន់ ក្នុង ការ បំផ្លាញ សុខភាព។
នេះ បើ យោង តាម ការ សិក្សា។
តែ ផលប៉ះពាល់ អាច ស្រាល ទៅវិញ ប្រសិនបើ មនុស្ស ប្រើ ចង្ក្រានហ្គាស ឬ អេឡិចត្រូនិក ក្នុងការ អាំង សាច់។
អ្នកជំនាញ បាន រកឃើញថា ហានិភ័យ នេះ កើនឡើង ចំនួន ៣% ជា រៀងរាល់ ១០ ឆ្នាំ ហើយ អ្នក ដែល ចម្អិន ដោយ ដុត អុស ឬ ធ្យូង រយៈពេល ៣០ ឆ្នាំ ឬ ច្រើន ជាង នេះ មាន ហានិភ័យ នៃ ការ ស្លាប់ មុន អាយុ ចំនួន ១២ ភាគរយ។
១. ស្លាក ស្នាម លើ លិង្គ អ្នក មើល ឃើញ ស្នាមកន្ទួល ក្រហមរោល បន្ទះ ៗ ត្រង់ ស្បែក លើ តួ លិង្គក្រោម ក្បាល លិង្គ បន្ដិច។
បើ ស្លាក ស្នាម នោះ មិន ឈឺ ចាប់ ឬ រមាស់ ទេហើយ បើ អ្នក មិន បាន រួម ភេទ មុន នេះ ទេពីព្រោះ ជា ទូទៅការ រួម ភេទ អាច បង្ក ជា ការ ដាច់ រលាត់ បន្ដិច បន្ដួចស្នាម ក្រហម នោះ អាច ជា សញ្ញា មហារីក លិង្គ។
នេះ បើ យោងតាម វេជ្ជ បណ្ឌិត រីយ៉ានធេឡេគីជា បស្សាវ វិទូ នៅមជ្ឈមណ្ឌល វេជ្ជសាស្ដ្រគ្រឹស្ដ បរិស័ទ នៃ សាកលវិទ្យា ល័យ វេក ហ្វូរ៉េស។
អ្នក អាច ប្រទះ ឃើញ ស្នាម ផ្សិត សៗ លើ ស្បែក។
មិន ថាអ្នក មានអារម្មណ៍ ឈឺឬ យ៉ាង ណាវា អាច ជា អាការ ហៅ ថាលីឈេនស្លេរ៉ស៊ុសជា ជំងឺ ស្បែកដែល បង្ក មក ពី អ័រម៉ូន ឬ ប្រព័ន្ធ ស៊ាំង ជំងឺ មិន តុល្យភាព។
វេជ្ជ បណ្ឌិតធេឡេគីបាន បន្ដ ថាអ្នក គួរតែ បារម្ភ បើ អ្នក អត់ បាន កាត់ ស្បែក លិង្គ ឬ មាន អារម្មណ៍ ថាអ្នក ត្រូវ ព្រលាត់ វា ឡើង ពេល បត់ ជើង តូច។
បើ មិន ប្រញាប់ ព្យាបាល ទេបញ្ហា នេះ អាច បង្ក ជា កត្ដា ធ្វើ ឲ្យ ស្ទះ តម្រង់ នោម បើ មិន ដូច្នេះអ្នក នឹង ត្រូវ ចូល សង្គ្រោះ បន្ទាន់។
នេះ បើ យោងតាម វេជ្ជ បណ្ឌិតចូសេពសុនស្ទែនមក ពី សាកលវិទ្យា ល័យសាខា វេជ្ជ សាស្ដ្រ តិច សាស់។
ជម្រើស នៃ ការ ព្យាបាល អាស្រ័យ លើ ភាព ធ្ងន់ ធ្ងរតែ រួម ទាំងអង់ហ្ស៊ីម ឬ ចាក បញ្ចូល ជាតិ អំបិល ឬ ក៏វះ កាត់។
ក្នុង ពិភព វេជ្ជ សាស្ដ្រឈាម ក្នុង ទឹក នោម ក៏ ជា សញ្ញា អាសន្ន នៃ មហារីក ថ្លោក នោម ផង ដែរ។
វេជ្ជបណ្ឌិត បាន ណែនាំ ឪពុក ម្ដាយ នាំ កូន ប្រុស ទៅ ត្រួត ពិនិត្យ ពី ភាព មិន ប្រក្រតី ឲ្យ បាន ឆាប់។
ការ ងូតទឹក ក្ដៅ ឧណ្ឌៗ ពេល ពង ស្វាស យួរ តោក យោក ក្រៅខ្លួនជា វេលា ត្រួត ពិនិត្យ ដោយ ខ្លួន ឯង ដ៏ ស័ក្ដិ សម បំផុត។
រមាស់ ជា រោគ សញ្ញា នៃ ជំងឺ ឆ្លង ដូចជាច្រាំង ឬ ស្គាល់ ជាផ្សិត។
វាអាច ជា បញ្ហា កង្វះ អនាម័យ និង ជំងឺ ឆ្លង តាម ការ រួម ភេទ ដូចជារើម ជាដើម។
បញ្ហា បង្ក ចម្បង ចំពោះ ការ រលាក កើត ពី ជំងឺ ប្រមេះ។
វា កើត ឡើង ច្រើន លើ បុរស វ័យ ក្មេងជា ពិសេសបុរសដែល រួម ជាមួយ បុរស ដទៃ។
កត្ដា ជា ច្រើន អាច បង្ក ជា បញ្ហា អ សមត្ថភាព ផ្លូវភេទរួម ទាំងបញ្ហា ចរន្ដ ឈាមជំងឺ ទឹក នោម ផ្អែមនិង កង្វះ អ័រម៉ូន តេស្ដូស្ទើរ៉ុន។
ធាតុ បង្ក ផ្សេង ៗ ទៀតរួម មានការ ប្រើ ប្រាស់ គ្រឿង ស្រវឹង និង ថ្នាំញៀន ហូរ ឈាម ពី តួ លិង្គ ឬ ស្ដ្រេស និង ក្រេវ ក្រោត ខ្លាំង។
អាស្រ័យ លើ ធាតុ បង្ក ទាំង នេះវេជ្ជ បណ្ឌិត នឹង អាច រក វិធី ព្យាបាល ឲ្យ អ្នក បាន។
ប៉ុន្ដែ វេជ្ជបណ្ឌិត មីឆែល ហូលម៉េស មក ពី សាកល វិទ្យាល័យ ប្រូក ប្រទេស កាណាដា បាន លើក ឡើង ថា ឪពុក ម្ដាយ មិន ចាំ បាច់ ទិញ កាតាប ថ្លៃៗ ពេក នោះ ទេ ពី ព្រោះ វា គ្មាន ភ័ស្ដុតាង បង្ហាញ ថា សម្ពាយ អាច ធ្វើ ឲ្យ ឈឺ ខ្នង ឬ ប៉ះពាល់ ដល់ ឆ្អឹង កង ខ្នង ឡើយ។
លោក វេជ្ជបណ្ឌិត ជំនួយការ សាស្ដ្រាចារ្យ ផ្នែក ចលនា រាងកាយ និយាយថា៖
វេជ្ជបណ្ឌិត ហូល ម៉េ ស បាន ឲ្យ ដឹងថា គ្មាន លទ្ធផល ណា បង្ហាញថា កា តាប ស្ពាយ ក្រោយ ជាប់ ពាក់ព័ន្ធ នឹង បញ្ហា ឈឺ ឆ្អឹង ខ្នង នោះ ទេ។
ប៉ុន្ដែ លោក ក៏ មិន ណែនាំ ឲ្យ ប្រើ កាបូប ស្ពាយ ចំហៀង ដែរ។
គន្លឹះ មួយចំនួន ក្នុងការ ស្វែងរក កាបូប ស្ពាយ ក្រោយ គួរតែមាន ខ្សែក្រវាត់ ចង្កេះ ដែល ត្រគាក អាច ជួយ ទប់ ទម្ងន់ ខ្លះ ខ្សែ ក្រវាត់ ស្មា ខ្សែ ក្រវាត់ ខ្នង មាន ថត។
ដូច្នេះ ទម្ងន់ អាច ត្រូវ បាន កាត់ បន្ថយ ទៅ តាម ផ្នែក នីមួយៗ។
អ្នកវិទ្យាសាស្ដ្រថា បញ្ហាលិង្គមិនរឹងអាចជាសញ្ញានៃជំងឺបេះដូង
ប៉ុន្ដែ មនុស្ស ជាច្រើន មិន ដឹង ថា បញ្ហា សិច ក៏ អាច ជា សញ្ញា អាក្រក់ ចំពោះ សុខភាព បេះដូង ឡើយ។
វេជ្ជបណ្ឌិត មី ឆែ ល អូ ដូ ណូ ក អ្នកឯកទេស បេះដូង នៅ មន្ទីរ-ពេទ្យស្ដ្រី និង ប្រ៊ីកហាម សាខា ក្រុង ហាវើដ បាន និយាយ ថា៖
អសមត្ថភាព ផ្លូវភេទ ជា បញ្ហា ទាក់ទង នឹង លទ្ធភាព មិនអាច ដំឡើង ឬ ពង្រឹង អានុភាព លិង្គ ឲ្យ រឹង សម្រាប់ រួម ភេទ បាន ប៉ះពាល់ ដល់ បុរស ជិត ២០ ភាគរយ អាយុ ចាប់ ពី ២០ ឆ្នាំ ឡើង។
បញ្ហា នេះ កើត ឡើង ច្រើន ចំណោម បុរស ធាត់ ជ្រុល កើត ជំងឺ ទឹក នោម ផ្អែម និង កត្ដា សុខភាព មួយ ចំនួន ទាក់ ទង នឹង ជំងឺ បេះដូង។
ប៉ុន្ដែ ការ សិក្សា ថ្មី មួយ បាន លើក ឡើង ថា អ សមត្ថភាព ផ្លូវ ភេទ អាច ជា កត្ដា ចម្បង បំផុត ចំពោះ ជំងឺ បេះដូង។
ប្រេងអូលីវ ត្រូវបានអ្នកវិទ្យាសាស្ត្រជឿថា ជួយសមត្ថភាពផ្លូវភេទបុរស
ក្រុម អ្នកវិទ្យាសាស្ដ្រ បាន តាមដាន ទិន្នន័យ ពី បុរស ៦៦០ នាក់ អាយុ មធ្យម ៦៧ ឆ្នាំ និង បាន រក ឃើញ ថា អ្នក ដែល សង្វាត របប អាហារ ស្ទីល មេឌីទែរ៉ាណេ (ឬ ជា អាហារ សម្បូរ ជាតិ ខ្លាញ់ ចម្រើន សុខភាព បំផុត មួយ) បាន កាត់ បន្ថយ ហានិភ័យ បញ្ហា ជីវិត លើ គ្រែ បាន ច្រើន ជាង អ្នក អត់ អនុវត្ដ របប អាហារ សុខភាព។
ប្រេង អូ លីវ មិន ត្រឹមតែ ជួយ សម្រួល សរសៃឈាម ប៉ុណ្ណោះ ទេ ប៉ុន្ដែ វា ថែមទាំង បង្កើន ចរន្ដ ឈាម ពេញ សារ ពាង្គកាយ រួម ទាំង ចរន្ដ ឈាម នៅ បរិវេណ លិង្គ ទៀត។
វា ក៏បាន បង្កើន កម្រិត អ័រម៉ូន បុរស តេស្ដូស្ទើរ៉ុន ដែល ជួយ កាត់ បន្ថយ ហានិភ័យ ជំងឺ អ សមត្ថភាព ផ្លូវ ភេទ ផង ដែរ។
វេជ្ជបណ្ឌិត គ្រីស្ទី ណា ឈី សូ ហ៊ូ ជា អ្នកដឹកនាំ ក្រុម ស្រាវជ្រាវ បាន និយាយថា៖
«ទម្លាប់ ហូប ចុក ចម្រើន សុខភាព រយៈពេល យូរ និង លំហាត់ ប្រាណ ជា ប្រចាំ ទំនង ជា មាន ឥទ្ធិពល ខ្លាំង មិន ត្រឹម តែ បញ្ហា សរសៃ ឈាម ប៉ុណ្ណោះ ទេ ប៉ុន្ដែ ថែម ទាំង លើ គុណភាព ជីវិត យើង ទៀត រួម ទាំង សមត្ថភាព ផ្លូវភេទ ចាប់ ពី អាយុ វ័យ កណ្ដាល រហូត ដល់ ជ្រេ។
ការ ទទួល ទាន ប្រេង អូលីវ និង ប្រកាន់ ខ្ជាប់ របប អាហារ មេឌីទែរ៉ាណេ ជួយ បុរស រក្សា ថាមពល លើ គ្រែ រឹងមាំ ជានិច្ច»។
អង្គការ ដដែល បាន បន្ដថា ៖
កាល ពី សប្ដាហ៍ មុន ទីក្រុង លៀនយងហ្គាង ភាគ ខាង កើត បាន ប្រកាស ថា ខ្លួន បាន សម្លាប់ ជ្រូក ១៤៥០០ ក្បាល ក្នុង បំណង គ្រប់ គ្រង ការ រីក រាល ដាល នេះ ។
ជូន លូប្រុត ប្រធាន ពេទ្យ សត្វ បាន ពន្យល់ថា ៖
ជំងឺប៉េស្ដជ្រូក អាហ្វ្រិក មិន ប៉ះពាល់ ដល់ សុខភាព មនុស្ស ទេ តែ បង្ក ជា រោគ សញ្ញា បែក គ្រាប់ ឈាម ចំពោះ ជ្រូក ចិញ្ចឹម និង សត្វ ជ្រូក ព្រៃ ដែល តែងតែ ងាប់ ក្នុង រយៈ ពេល តែ ប៉ុន្មាន ថ្ងៃ ។
គ្មាន ឱសថ និង ថ្នាំ បង្ការ ហើយ មាន វិធី សាស្ដ្រ តែ មួយ គត់ ដែល អាច ទប់ ស្កាត់ ជំងឺ ឲ្យ រីករាល ដាល គឺ ការ សម្លាប់ សត្វ ចិញ្ចឹម ដែល ឆ្លង ជំងឺ ក្នុង ចំនួន ដ៏ ច្រើន សន្ធឹក ។
ក្នុង របាយ ការណ៍ ទៅកាន់ អង្គការ ពិភព លោក សម្រាប់ សុខុមាលភាព សត្វ ក្រុង ប៉េកាំង បាន ឲ្យ ដឹង ថា គម្រោង សង្គ្រោះ បន្ទាន់ មួយ នឹង ត្រូវបាន ធ្វើ ឡើង និង វិធាន ការ គ្រប់ គ្រង ដើម្បី បញ្ឈប់ ការ រីក រាល ដាល ។
ជ្រូក ប្រមាណ ពាក់ កណ្ដាល ជុំវិញ ពិភព លោក ត្រូវបាន ចិញ្ចឹម ក្នុង ប្រទេស ចិន ហើយ ពលរដ្ឋ ចិន ជា អតិថិជន សាច់ ជ្រូក ធំ បំផុត យោងតាម ចំនួន ប្រជាជន ។
មជ្ឈមណ្ឌល គ្រប់គ្រង និង បង្ការ ជំងឺ បាន ឲ្យ ដឹងថា ជំងឺ ជ្រាំង រមាស់ ប្រមេះ និង ជំងឺ ស្វាយ ជិត ២,៣ លាន ករណី ត្រូវ បាន រក ឃើញ នៅ សហរដ្ឋ អាមេរិក កាល ពី ឆ្នាំ ២០១៧។
របាយការណ៍ បាន បន្ដថា៖
នាយក មជ្ឈមណ្ឌល ជាតិ គ្រប់គ្រង ជំងឺអេដស៍ និង មេរោគ អេដស៍ ជំងឺ ឆ្លងតាម ការ រួម ភេទ និង ជំងឺ ថ្លើម លោក ចូណា ថាន់ មែ មីន ព្រមាន ថា៖
ជំងឺ ជ្រាំង រមាស់ ប្រមេះ និង ស្វាយ អាច ព្យាបាល បាន តាមរយៈ ថ្នាំ ផ្សះ។
ប៉ុន្ដែ បើ មិន យក ចិត្ត ទុក ដាក់ ព្យាបាល វា អាច បង្ក ឲ្យ ជួប បញ្ហា គ្មាន កូន គភ៌ មិន ប្រក្រតី កូន ស្លាប់ ក្នុង ផ្ទៃ និង ហានិភ័យ មេរោគ អេដស៍៕
ការសិក្សាបង្ហាញថាផឹកកាហ្វេ ៤ ពែងក្នុង ១ ថ្ងៃអាចជួយឲ្យបេះដូងរឹងមាំ
ការសិក្សា នេះ បាន អះអាងថា កម្រិត ជាតិ កាហ្វេ អ៊ីន ដែល ស្មើនឹង ការផឹក កាហ្វេ ៤ ពែង អាច ជួយ ការពារ សរសៃ ឈាម ឲ្យ មាន សុខភាព ល្អ និង ជួសជុ ល សាច់ ដុំ បេះដូង សម្រាប់ មនុស្ស វ័យ ជ្រេ។
សារជាតិ កាហ្វេ អ៊ីន ក៏ ត្រូវបាន គេ ដឹងថា អាចជួយ កាត់បន្ថយ ហានិភ័យ នៃ ជំងឺ មួយចំនួន ដូចជា ជំងឺ បេះដូង ជំងឺ ទឹក នោម ផ្អែម ប្រភេទ ទី ២ និង ជំងឺ ដាច់ សរសៃ ឈាម ខួរ ក្បាល ជា ដើម ប៉ុន្តែ មូល ហេតុ នៅ ពី ក្រោយ គុណ ប្រយោជន៍ ទាំង នេះ នៅ មិន ទាន់ ត្រូវ បាន អ្នក វិទ្យាសាស្ត្រ យល់ ច្បាស់ លាស់ នៅ ឡើយ ទេ។
ក្រុម អ្នកវិទ្យាសាស្ត្រ បាន ណែនាំ ថា ការរកឃើញ នេះ អាចឈាន ទៅរក ការចេញ វិធីសាស្ត្រ ល្អៗ ដើម្បី ការពារ សាច់ ដុំ បេះដូង។
អ្នកឯកទេស ផ្នែក សុខភាព ផ្សេងទៀត ក៏បាន ចាត់ទុក លទ្ធផល ពី ការ សិក្សា នេះ ថា គួរ ឲ្យ ចាប់ អារម្មណ៍ ណាស់។
អ្នកស្រី ពន្យល់ថា៖
«ទូរស័ព្ទ ស្មា ត ហ្វ៊ូ ន របស់ យើង ពិតជា ផ្ទុក នូវ ភាពកខ្វក់ ប៉ះពាល់ ដល់ ស្បែក ដ៏ ច្រើន សន្ធឹក ជា ពិសេស ជំងឺ រលាក និង ជំងឺ មុន»។
ចិនរកឃើញថា គ្រួសារចំណូលកាន់តែច្រើន សិចកាន់តែសកម្ម
កំពូលវេជ្ជបណ្ឌិតអាមេរិក ណែនាំឲ្យកុមារលេងសប្បាយច្រើន បង្កើនប្រាជ្ញា
នៅក្នុង របាយការណ៍ ចុះផ្សាយថ្មីៗនេះ ក្រោម ចំណងជើង ថា «ឥទ្ធិពល នៃ ការលេង សប្បាយ» វិទ្យាស្ថាន ពេទ្យ កុមារ អាមេរិក បាន ឲ្យ ដឹង ថា មាន ភ័ស្ដុតាង បញ្ជាក់ យ៉ាង ច្បាស់ ថា ការ លេង សប្បាយ ជា គន្លឹះ ដ៏ សំខាន់ មិន ថា វា ជា ការ លេង សើច ជាមួយ មិត្ដ ភក្ដិ ឬ ជាមួយ ឪពុកម្ដាយ នោះ ទេ។
ក្រុម អ្នកនិពន្ធ បាន និយាយថា របាយការណ៍ ពិត ជាមាន ប្រយោជន៍ ដោយសារ ពេលវេលា លេង សប្បាយ របស់ កុមារ បាន ធ្លាក់ ចុះ អំឡុង ពេល ២ ទសវត្សរ៍ ចុង ក្រោយ។
បើ ធៀប នឹង កុមារ ទសវត្សរ៍ ទី ៨០ កុមារ បច្ចុប្បន្ន អាយុ ក្រោម ១១ ឆ្នាំ មាន ពេលទំនេរ តិចតួច ខ្លាំង ជាមួយ វេលា តិច ជាង ១២ ម៉ោង ក្នុង ១ សប្ដាហ៍ ហើយ កុមារ ៣០ ភាគរយ មាន ឱកាស លេង តែ ក្នុង ផ្ទះ។
«នេះ ជា របាយ ការណ៍ លម្អិត របស់ យើង ដែល ជជែក អំពី សារៈ សំខាន់ នៃ ការ លេង សប្បាយ ក្នុង បរិវេណ សាលា មុន វ័យ ចូល រៀន និង ពី សារៈ សំខាន់ នៃ ការ ស្វែងរក តុល្យភាព នៃ ការរៀន តាមរយៈ ការ លេង សប្បាយ ជាមួយ កម្មវិធី បុរាណ»។
លោក បាន បន្ដទៀតថា៖
«អ្នកខ្លះ និយាយថា ការលេង សប្បាយ របស់ កុមារ ជាការ ខ្ជះខ្ជាយ ពេល វេលា។
ក្រុម អ្នកនិពន្ធ បាន ពន្យល់ថា កុមារ ភាពជា វេលា ដ៏ សំខាន់ ចំពោះ ការ អភិវឌ្ឍ ជំនាញ ដែល នឹង ជះ ឥទ្ធិពល ពេញ មួយ ឆាក ជីវិត មនុស្ស។
ទាំង នោះ រួម មាន ជំនាញ ទំនាក់ ទំនង សង្គម ការ អភិវឌ្ឍ ញាណ ដឹង ភាសា និង គោរព គោល ការណ៍ ច្បាប់ ដែល ជា គន្លឹះ ឈាន ឆ្ពោះ ទៅ រក ភាព វៃឆ្លាត និង រស់ នៅ ឯករាជ្យ។
ការលេង សប្បាយ ជាមួយ ឪពុកម្ដាយ អាច បន្ថែម អត្ថប្រយោជន៍ ផ្សេងទៀត ដូចជា គន្លឹះ កសាង ទំនាក់ ទំនង រវាង ឪពុក ម្ដាយ និង កូន ប្រកប ដោយ ជំនឿ ចិត្ដ ផង ដែរ។
ញ៉ាំទឹកដោះគោ ពេលព្រឹកល្អបំផុត ក្នុងការការពារជំងឺធាត់ និងទឹកនោមផ្អែម
ទឹកដោះ គោមួយ កែវ ចំណុះ ២៥០ មិ ល្លី លីត្រ ឬ បន្ថែម គ្រាប់ ធញ្ញជាតិ ក្នុង របប អាហារ ពេល ព្រឹក អាច កាត់ បន្ថយ ជាតិ ស្ករ ក្នុង ឈាម ពេញ មួយ ថ្ងៃ ដោយ បញ្ចុះ ហា និភ័យ នៃ ជំងឺ ទឹក នោម ផ្អែម ប្រភេទ ទី ២ ។
ប្រូ តេ អ៊ីន ក្នុង ទឹកដោះគោ មាន ឥទ្ធិពល គ្រប់គ្រង ជាតិ ស្ករ ជួយ សម្រួល ការរំលាយ អាហារ និង កាត់ បន្ថយ ការ ឃ្លាន។
«អ្នកឯកទេស ខាង ជីវជាតិ វិទ្យា តែងតែ សង្កត់ធ្ងន់ ពី សារៈសំខាន់ នៃ អាហារ ពេល ព្រឹក ប្រកប ដោយ សុខុមាល ភាព ហើយ ការ សិក្សា នេះ គួរតែ លើក ទឹក ចិត្ដ ដល់ អ្នក ទទួល ទាន ឲ្យ បន្ថែម ទឹក ដោះ គោ ផង ដែរ»។
ក្រុម អ្នកស្រាវជ្រាវ កាណាដា មកពី សាកលវិទ្យាល័យ ខាងលើ បានស្នើ ឡើង ថា វិធី នេះ អាច ត្រូវ បាន ប្រើ សម្រាប់ គ្រប់គ្រង របប អាហារ និង ទប់ ទល់ បញ្ហា ធាត់ ឡើង ទម្ងន់ ជ្រុល។
សាស្ដ្រាចារ្យ ដូ ហ្គាស បាន លើកឡើងថា៖
បុរសចង់មានកូន គួរស្លៀកខោខ្លីរលុង ចៀសវាងការគាបខ្ចប់ពងស្វាសខ្លាំង
មេជី វិត ក៏មាន ស ភាពរស់រវើក និង កម្រិត អ័រម៉ូន ជំរុញ ឲ្យ ឆាប់ មានកូន ផងដែរ។
កាលពីដើមឆ្នាំ ការស្រាវជ្រាវ ធ្វើការ សិក្សា ដូចគ្នា តែ ខុសគ្នា តិចតួច។
ការ ផលិត មេជី វិត ដោយ ជោគ ជ័យ តម្រូវ ក្នុង បរិស្ថាន សីតុណ្ហភាព ពី ៣ ទៅ ៤ អង្សាសេ ក្រោម សីតុណ្ហភាព រាងកាយ។
នេះ ស បញ្ជាក់ថា ធម្មជាតិ តាក់តែង ពងស្វាស បុរស នៅក្រៅ ខ្លួន ដើម្បី ឲ្យ មេជី វិត មានគុណ ភាព ដែល អាច ផលិត មនុស្ស ជំនាន់ ក្រោយ បន្ដ ទៀត។
បញ្ហា រាំង ស្ទះ តម្រូវការ ត្រជាក់រ បស់ ពងស្វាស នេះ វា ប៉ះពាល់ ដល់ មេជី វិត និង គុណភាព វា។
ការសិក្សា មិនបាន ពិសោធ លើ ការព្យាបាល ដែលជា ការស្រាវជ្រាវ ចំពោះ សុខភាព ដ៏ សំខាន់ ទេ តែ វា ជា ការ ស្រាវ ជ្រាវ មួយ ដ៏ សំខាន់ ដែល ចង្អុល បង្ហាញ ពី ធាតុ បង្ក។
ម្យ៉ាងវិញទៀត ការសិក្សា នេះ ក៏ មិនបាន វាស់ ស្ទង់ ពី លទ្ធភាព ពពោះ ពិតប្រាកដ ក្នុង កម្រិតណា ដែរ។
ដូច្នេះ វា មិន ច្បាស់ ថា តើ ភាព ខុស ប្លែក គ្នា ចំពោះ ចំនួន និង គុណភាព មេជី វិត បង្កើត ជា ភាព ខុសគ្នា រវាង លទ្ធភាព បង្ក កំណើត នោះ ទេ៕
អ្នកជំនាញបកស្រាយអំពីការមើលកុនសិចច្រើន បង្កបញ្ហាអសមត្ថភាពផ្លូវភេទ
យ៉ាងណាមិញ គ្មាន ភ័ស្ដុតាង បែប វិទ្យាសាស្ដ្រ ណា បញ្ជាក់ អំពី ទស្សនៈ នេះ ទេ។
វេជ្ជបណ្ឌិត នីកូល ប្រោស ស្ថាបនិក ក្រុមហ៊ុន ស្រាវជ្រាវ សិច និង ជីវ បច្ចេកវិទ្យា Liberos ក្នុង ក្រុង ឡូសអេនជឺលេស បាន និយាយ ថា៖
ដ្បិត មិន ប៉ះពាល់ ផ្ទាល់ ការមើល កុន សិច ច្រើន រង ឥទ្ធិពល ប្រយោល ពី ទម្លាប់ សម្រេច កាម ខ្លួន ឯង។
វេជ្ជបណ្ឌិត អ៊ីយ៉ាន ឃែន័រ ជា អ្នក ឯក ទេស ព្យាបាល រោគ ផ្លូវ ចិត្ដ និង ផ្លូវភេទ បន្ដ ថា៖
«បទ ពិសោធ ខ្ញុំ ខ្ញុំ មិន ដឹង ថា កុន សិច ប៉ះពាល់ ផ្ទាល់ សមត្ថភាព ផ្លូវ ភេទ ឡើយ»។
បញ្ហា អសមត្ថភាព ផ្លូវភេទ បង្ក ពី ការប្រើ ស្ទីល សម្រេច កាម ប្លែក ពេក ឬ ការ រឹត ប្រដាប់ ភេទ ខ្លាំងៗ ដែល ខុស ពី ការ រួមភេទ ធម្មតា។
យោង តាម វេជ្ជបណ្ឌិត ចេន្នីហ្វើរ វេនស៊ីល ជា អ្នក ឯកទេស ផ្លូវ ភេទ បើ ធ្លាប់ ប្រើ វិធី ធ្ងន់ សម្រេច កាម អ្នក ត្រូវ ទាមទារ វិធីសាស្ដ្រ រួម ភេទ ខ្លាំងៗ លើស ពី មាត់ និង ទ្វារ មាស។
នេះ អាច បង្ក ជា បញ្ហា ដើម្បី ឲ្យ លិង្គ ងើប រឹង ឬ ឈាន ដល់ ចំណុច កំពូល ជាមួយ ដៃគូ។
អ្នកស្រី ភឿន លក្ខណា ជា ម្ដាយ របស់ បុត្រ ប្រាប់ថា៖
«ពេល ឃើញ កូន ប្លែក បែបនេះ យើង ជា ឪពុក ម្ដាយ ខិតខំ ស្វែងរក ជួប ពេទ្យ ជួប អ្នក ជំនាញ ដើម្បី ពិគ្រោះ អំពី បញ្ហា កូន។
ប៉ុន្ដែ ដោយ ទទួល បាន ដំបូន្មាន ពី អ្នក ជំនាញ យើង មិន ភ្លេច នឹង ការ ជួយ កូន គ្រប់ វិធី សាស្ដ្រ ទេ»។
រហូតដល់ ពេល មួយ អ្នកស្រី ត្រូវបាន ណែនាំ ឲ្យ មក ចុះឈ្មោះ ចូលរៀន ឯ សាលា អប់រំ ពិសេស នៃ ការ លូត លាស់ (សអពក)។
ការ វិវត្ដ របស់ បុត្រ កាន់ តែ ប្រសើរ និង អាច បន្ដ ចូល រៀន ជាមួយ កុមារ ធម្មតា បាន។
នៅ សាលា អប់រំ ពិសេស នៃ ការ លូតលាស់ ដែល សម្ពោធ កាលពី ខែ កក្កដា ឆ្នាំ ២០១៧ ក្រោម គំនិត ផ្ដួច ផ្ដើម អ្នក ស្រី ភោគ ម៉ានី ជា អ្នក ម្ដាយ មាន កូន កើត អូទីសឹម ផ្ទាល់ លោកគ្រូ អ្នក គ្រូ បាន ជួយ បុត្រ ព្រម ទាំង កុមារា កុមារី ប្រមាណ ជាង ៤០ នាក់ ទៀត ឲ្យ មាន ការ ផ្ចង់ អារម្មណ៍ ជាង មុន ចេះ លេង ជាមួយ កុមារ ដទៃ និង អាច ប្រើ ភាសា ខ្លះៗ ក្នុង រយៈពេល ១ ឆ្នាំ មក នេះ។
អូ ទី សឹម ជា ពិការភាព នៃ ការអភិវឌ្ឍ មួយជីវិត ដែល ប៉ះពាល់ ចម្បង ទៅលើ ផ្នែក សង្គម ទំនាក់ ទំនង និង អាកប្ប កិរិយា។
រោគ សញ្ញា អាច ប្រែប្រួល ពី ស្រាល ទៅ ធ្ងន់ធ្ងរ និង អាច ដាក់ រោគ វិនិច្ឆ័យ ក្នុង រវាង អាយុ ២-៣ ឆ្នាំ។
ដំណើរ ឆ្ពោះទៅមុខ ដោយ ការបោះ ជំហានសន្សឹមៗលើ រយៈពេល ១ ឆ្នាំ របស់ សាលា អប់រំ ពិសេស ជួយ ដឹក ដៃ កុមារ ពិការ ភាព ខួរក្បាល ពី កំណើត សម្លឹង មើល ពន្លឺ ក្ដី សង្ឃឹម បណ្ដើរ។
នៅក្នុង ផ្ទះល្វែង ជួល មួយ ខ្នង ជាប់ របង ព្រះ សហគមន៍ កាតូលិក បឹងទំពុន ដែលមាន ការ រៀបចំ ធ្នើរ ដាក់ ស្បែក ជើង អម ដោយ រូបភាព បង្ហាញ ទូ ដាក់ សៀវភៅ ចម្រុះ បន្ទប់ ៣ រចនា ជា ថ្នាក់ រៀន កុមារ យ៉ាង ស្រស់ ស្អាត និង បន្ទប់ ហ្វឹកហាត់ រួម ខណៈ ផ្ទះបាយ ប្រែ ក្លាយ ជា ការិយាល័យ របស់ បុគ្គលិក សិក្សា អ្នក ម្ដាយ មាន កូន ប្រុស ទី ២ កើត អូទីសឹម អ្នកស្រី ភោគ ម៉ានី មាន ភារៈ ជា អ្នក សម្រប សម្រួល របស់ សាលា ប្រាប់ ថា៖
«ពេល នេះ យើង ទទួល បង្រៀន កុមារ អូទីសឹម សរុប ៤៣ នាក់។
អ្នកស្រី ប្រាប់ ភ្នំពេញ ប៉ុស្ដិ៍ ថា៖
«១ ឆ្នាំនេះ យើង ទទួលបាន សមិទ្ធផល លើ កុមារ ៣ នាក់ ដែល នឹង បន្ដ ចូល រៀន នៅ សាលា មតេយ្យ សន្ដីលូស៊ី ជា សាលា បង្រៀន កុមារ ធម្មតា បាន»។
យ៉ាងណាមិញ អ្នកស្រី លក្ខណា សម្ដែង ការ ត្រេកអរ បង្កប់ នូវ ក្ដី ព្រួយបារម្ភ ខណៈ កូន ប្រុស អាច បោះ ជំហាន ទៅ សិក្សា នៅ សាលា កុមារ ធម្មតា។
អ្នក ម្ដាយ អូន បុត្រ និយាយថា៖
«អារម្មណ៍ នៅតែ គិត និង នឹក គិតថា កូន មិន ដូច ក្មេង ធម្មតា។
ឥឡូវ នេះ ចូល រៀន សាលា ថ្មី មិន ដឹង ថា គាត់ ទទួល ការ សិក្សា ដូច ម្ដេច ទេ ពីព្រោះ សាលា ថ្មី នេះ គឺ ផ្លាស់ប្ដូរ ទាំង ស្រុង។
បន្ថែម លើ សមិទ្ធផល ល្អ របស់ កុមា រទាំង ៣ នាក់ នេះ អ្នកសម្របសម្រួល សាលា អប់រំ ពិសេស រូប នេះ បាន បន្ដ ថា កុមារ ដែល ធ្លាប់ តែ មាន អាកប្ប កិរិយា រពឹស និង មិន អាច នៅ ជា ក្រុម ពេល នេះ អាច ផ្ចង់ អារម្មណ៍ ល្អ ហើយ ក្មេង ខ្លះ ចាប់ផ្ដើម វិវត្ដ មាន ភាសា ជាមួយ ពាក្យ មួយ ព្យាង្គ។
ក្មេង ខ្លះ អត់ ធ្លាប់ ចេះ កាន់ ខ្មៅ ដៃ ឥឡូវ គាត់ អាច ចេះ កាន់ ហើយ ក្មេង ខ្លះ ទៀត អាច និយាយ ពាក្យ ៣ ព្យាង្គ។
អ្នកស្រី ភោគ ម៉ា នី បាន រៀបរាប់ អំពី ដំណើរ វិវត្ដន៍ ចំណោះ គ្រូបង្រៀន ដែរ ថា៖
ចំពោះ សម្ភារ សិក្សា អ្នកស្រី ប្រាប់ថា អ្នកគ្រូ លោកគ្រូ ជា អ្នក ច្នៃ បង្កើត សម្ភារ សិក្សា ដោយ ខ្លួន ឯង។
ទាក់ ទង គ្រឿង លើក ទឹក ចិត្ដ កុមារ ភាគ ច្រើន សាលា ទទួល បាន ពី ឪពុក ម្ដាយ ពួកគេ ផ្ទាល់ ដោយសារ តែ ឪពុក ម្ដាយ ដឹង ថា កូន គាត់ ចូល ចិត្ត អ្វី អ៊ីចឹង។
លោក ឆៃ សោ ភ័ ណ្ឌ រ័ត្ន ជា គ្រូ ម្នាក់ ប្រាប់ ពី ការបង្ហាត់បង្រៀន កុមារ មាន អាកប្បកិរិយា ពិបាក ថា ជា បទ ពិសោធ ថ្មី ក្នុង ឆាក ជីវិត តាមរយៈ ការ រិះរក វិធី សាស្ដ្រ ថ្មីៗ ដើម្បី ជួយ អភិវឌ្ឍ ពួកគេ។
«ខ្ញុំ សង្កេតឃើញថា កុមារ មានការ អភិវឌ្ឍ គួរ ឲ្យ កត់សម្គាល់ ដូចជា ក្មេង ដែល អត់ មាន ភាសា ប្រែ ទៅ ជា មាន ភាសា ចេះ ផ្ចង់ អារម្មណ៍ បាន ល្អ និង យល់ បាន នូវ អ្វី ដែល គ្រូ និយាយ ទៅ កាន់ គាត់»។
ចំពោះ ដំ ណេះ ដឹង បង្រៀន លោក រ័ត្ន លើកឡើងថា៖
«យើង អាច គ្រប់គ្រង ស្ថានការណ៍ អាកប្ប កិរិយា ក្មេង បត់ បែន តាម គាត់ និង អ្វី ដែល សំខាន់ នោះ គឺ បទពិសោធ អត់ធ្មត់ ចេះ រម្ងាប់ អារម្មណ៍ បែប នេះ ទើប អាច បង្រៀន ពួក គាត់ បាន។
គ្រូៗ ទាំង អស់ ស្រឡាញ់ និង អាណិត ហើយ ខិតខំ ព្យាយាម ឲ្យ កុមារ អាច ចូល រៀន ជាមួយ កុមារ ធម្មតា និង រីក ចម្រើន នៅ ថ្ងៃ អនាគត»។
ជាមួយនឹង ជំនួយ ពី ព្រះ សហគមន៍ កាតូលិក អ្នកស្រី ម៉ា នី បានស្នើ ប្រាក់ បដិភាគ ពី ឪពុកម្ដាយ ពី ៤០ ដុល្លារ ក្នុង ១ ខែ ឬ តាម លទ្ធភាព។
ទោះជា សាលា រំពឹង ជំនួយ ពី បរទេស ដើម្បី បន្ដ បេសកកម្ម របស់ខ្លួន ទៅមុខ ដោយ រលូន ក្ដី ក៏ អ្នកស្រី ម៉ានី ស្វាគមន៍ ជំនួយ ពី សប្បុរស ជន ក្នុង ស្រុក ដែរ។
ពេលនេះ លោក ស្ថិត ក្នុងចំណោម បុរស ចិន រាប់រយ នាក់ ដែល ចែករំលែក គន្លឹះ កែកុន សម្ផស្ស តាម អនឡាញ និង ទទួល បាន ប្រាក់ ចំណូល ខ្ពស់ ពី វិស័យ សម្ផស្ស បុរស នេះ។
បុរស អាយុ ២៤ ឆ្នាំ បាន និយាយប្រាប់ ពេល កំពុង ផាត់មុខ ថា៖
«ខ្ញុំ ទើប ដឹងថា ការ ផាត់មុខ ពិតជា ងាយ ស្រួល យ៉ាង នេះ សោះ។
ស្ដ្រី អាច មិន យល់ ច្បាស់ ពី ទំនោរ តុប តែង មុខ របស់ បុរស ទេ។
រៀងរាល់ ចុង សប្ដាហ៍ លោក ជៀង ចំណាយពេល ប៉ុន្មាន ម៉ោង នៅមុខ ទូរស័ព្ទ ដោយ ផ្សាយ ផ្ទាល់ ពី ទិចនិក ផាត់ មុខ បុរស ដែល អាច ទាក់ ទាញ បុរសៗ ទិញ ផលិតផល របស់ ខ្លួន។
ប៉ុន្ដែ ពេលនេះ ទីផ្សារ និង បញ្ហា យេនឌ័រ កំពុង ផ្លាស់ប្ដូរ ដោយ ក្រុមហ៊ុន លែង ផ្ដោត គោល ដៅ តែ លើ នារី ដូច មុន ទៀត ហើយ។
លោក ជៀង បាន បន្ដ ថា ក្រុមហ៊ុន មួយ ដែល គ្រប់គ្រង លើ ទំព័រ ប្លុក ជាច្រើន បាន ចំណាយ ប្រាក់ ឲ្យ លោក ១ ខែ ៧៣០ ដុល្លារ ដើម្បី ផ្សព្វផ្សាយ ផលិតផល ឲ្យ គេ។
ទីផ្សារ សម្ផស្ស បុរស រំពឹងថា នឹង កើនឡើង ១៥,២ ភាគរយ រយៈពេល ៥ ឆ្នាំ ទៀត ក្នុង ប្រទេស ចិន បើ ធៀប នឹង ១១ ភាគរយ ចំពោះ កំណើន លើ សកល លោក៕
ប្រពៃណីខាត់ស្បែកឲ្យស ជាទំនោរប្រឈមហានិភ័យ ចំពោះសុខភាពរបស់ស្ដ្រីនៅអាហ្វ្រិក
ការ ខាត់ ស្បែក ពិតជា ទំនោរ កែ សម្ផស្ស ពេញ និយម នៅ តាម បណ្ដា ប្រទេស នានា រួម ទាំង អាស៊ី ខាង ត្បូង និង មជ្ឈិម បូព៌ា ។
អ្នក ដែល ចាប់ផ្តើម ប្រើប្រាស់ ឡេ ខាត់ ស្បែក និយាយ ថា ពួកគេ ញៀន នឹង ទម្លាប់ នេះ។
ប៉ុន្តែ វា នឹង ត្រូវការ ការ ខិតខំ ប្រឹងប្រែង ខ្លាំង ដើម្បី ផ្លាស់ប្តូរ ផ្នត់ គំនិត នេះ »៕
ស្ដ្រីងាយស្លាប់ ដោយសារតែជំងឺគាំងបេះដូង បើគ្រូពេទ្យព្យាបាល ជាបុរស
